{"poems":[[112,"ماعاد انا مشتاق","https://www.poetsgate.com/ViewPoem.aspx?id=36759",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110022","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59484","الرجز"],[5690,"أن تعظم الأهوال حزمك أعظمُ","https://www.poetsgate.com/ViewPoem.aspx?id=172183",""],[5906,"سُكَّر","https://www.poetsgate.com/ViewPoem.aspx?id=188224",""]],"verses":[["بدق ولا انا ترى ما انيب داق","انا لو اني الي مزعلك دقيت",0,"ت",1,0],["بدقيقةٍ عقليَّةٍ","أُوجِدتَ لكن من سَوائِك",1,"ك",1,0],["بدقيق المذبحِ عاري الوج","هِ سليبِ النَّاهق معتدلِ",2,"ل",1,0],["بدقيق وقت والمخاطر جمةٌ","فالكون يرجف والمخاوف تعظمُ",3,"م",1,0],["بدقائق نعرف ما العلة","إن كان هناك ولن تخسر",4,"ر",1,0]]}