{"poems":[[72,"مسلسل الدمع أسير الفؤاد","https://www.aldiwan.net/poem18550.html","السريع"],[69,"النشو لا عدل ولا معرفه","https://www.aldiwan.net/poem28030.html","السريع"],[48,"أية نار قدح القادح","https://www.aldiwan.net/poem62540.html","السريع"],[46,"ما بالها ناوية شقة","https://www.aldiwan.net/poem23616.html","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39613","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[130,"ربع أسماء إذ هي الأنس آلا","https://www.aldiwan.net/poem54778.html","الطويل"],[359,"أنا في عرض آل بيت نبي","https://www.aldiwan.net/poem68104.html","الخفيف"],[400,"يا جيرة في القلب مأواهم","https://www.aldiwan.net/poem33406.html","السريع"],[400,"فاروعني يا صفي الدين ما","https://www.aldiwan.net/poem33983.html","الرمل"],[434,"كل يوم لي من صدودك حاله","https://www.aldiwan.net/poem2501.html","الخفيف"],[512,"غربت منكم شموس التلاقي","https://www.aldiwan.net/poem20786.html","الخفيف"],[556,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[556,"بين أهل الجحود والتكذيب","https://www.aldiwan.net/poem34966.html","الخفيف"],[557,"قد كساني لباس سقم وذله","https://www.aldiwan.net/poem69349.html","الخفيف"],[573,"عاد قلب الشوق إذ عدت عيده","https://www.aldiwan.net/poem3077.html","الخفيف"]],"verses":[["من اتقى الله اتقت بأسه","كواسر الأفق وغلبُ الوهاد",0,"د",1,0],["مَنْ أتلفَ الناسَ وأموالَهُمْ","يحقُّ للسلطانِ أَنْ يتلفَهْ",1,"ه",1,0],["مَنِ اتَّقى اللَهَ فَذاكَ الَّذي","سيقَ إِلَيهِ المَتجَرُ الرابِحُ",2,"ح",1,0],["مَنِ اِتَّقى اللَهَ فَأُسدُ الشَرى","لَدَيهِ مِثلُ الأَكلُبِ العاوِيَه",3,"و",3,0],["مَنْ أتى الصحراءَ في دَوِّها","بهذه الأسوارِ شُمِّ الحصونْ",4,"ن",1,0],["مَن أَتى بِمُشمِسِها","مَن أَتى بِمُقمِرِها",5,"ر",3,0],["مَن أتَانَا مُجَادِلاً فِيهِ ألقَمنَا","هُ صَخراً لَم يُبقِ فِيهِ جِدَالا",6,"ل",2,0],["من أَتاهُم مؤمّلا جدواهُم","عاد مُستَبشِراً بِهِم مَسرورا",7,"ر",2,0],["من اتصالي بعد طول النوى","بهم ومن فوزي بلقياهم",8,"م",1,0],["من أتانا بالهدى من ربنا","وأرانا الحق بالنص الصريح",9,"ح",1,0],["من أتاه يرجوه يحظ بجود","يرتجي العالمون منه نواله",10,"ل",2,0],["من أتى بالوليدِ بالرّوعِ قَسْراً","بعدَ عزِّ العُلا بذُلِّ الوَثاقِ",11,"ق",1,0],["من أتانا ألقى عصا السير عنْهُ","قلت من لي بها وأين السبيل",12,"ل",1,0],["من أتاهم بعلمهم جحدوه","كيف من جاءهم بعلم غريب",13,"ب",1,0],["من أتَى بَابنَا انَلنَاه فَضْلاَ","تلك عاداتُنا لِمَن شَاء قبْلَهْ",14,"ل",2,0],["من أَتَتْه الأَيَّامُ مُعْتذِرَات","فأَتى صَفْحُه وَرَاحَتْ حُقُودُه",15,"د",2,0]]}