{"poems":[[74,"مسلسل الدمع أسير الفؤاد","https://www.aldiwan.net/poem18550.html","السريع"],[71,"النشو لا عدل ولا معرفه","https://www.aldiwan.net/poem28030.html","السريع"],[50,"أية نار قدح القادح","https://www.aldiwan.net/poem62540.html","السريع"],[48,"ما بالها ناوية شقة","https://www.aldiwan.net/poem23616.html","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39613","السريع"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[102,"أسمار القرية","https://www.poetsgate.com/ViewPoem.aspx?id=50334",""],[102,"مسافرة بلا مهمة","https://www.poetsgate.com/ViewPoem.aspx?id=50437",""],[136,"ربع أسماء إذ هي الأنس آلا","https://www.aldiwan.net/poem54778.html","الطويل"],[366,"أنا في عرض آل بيت نبي","https://www.aldiwan.net/poem68104.html","الخفيف"],[409,"يا جيرة في القلب مأواهم","https://www.aldiwan.net/poem33406.html","السريع"],[409,"فاروعني يا صفي الدين ما","https://www.aldiwan.net/poem33983.html","الرمل"],[443,"كل يوم لي من صدودك حاله","https://www.aldiwan.net/poem2501.html","الخفيف"],[519,"غربت منكم شموس التلاقي","https://www.aldiwan.net/poem20786.html","الخفيف"],[563,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[563,"بين أهل الجحود والتكذيب","https://www.aldiwan.net/poem34966.html","الخفيف"],[564,"قد كساني لباس سقم وذله","https://www.aldiwan.net/poem69349.html","الخفيف"],[580,"عاد قلب الشوق إذ عدت عيده","https://www.aldiwan.net/poem3077.html","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38390","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38992","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59418","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59433","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136271","الخفيف"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6776","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49985","الطويل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82603","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108451","الرمل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109344","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27248","السريع"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93898","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93923","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94309","الرمل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118829","الخفيف"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118741","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114399","البسيط"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111042","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125868","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123526","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81282","الخفيف"],[4578,"يا غزالاً قد نسجت الغزلا","https://www.poetsgate.com/ViewPoem.aspx?id=49611",""],[5135,"تتابعت الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=206411",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5187,"ضحايا بين الألم","https://www.poetsgate.com/ViewPoem.aspx?id=29258",""],[5961,"ان ريح القرب نم","https://www.poetsgate.com/ViewPoem.aspx?id=199809",""],[6070,"يامنْ قَضَيْتَ سنينَ العُمْرِ في الضَّجرِ","https://www.poetsgate.com/ViewPoem.aspx?id=197522",""],[6124,"غنت بالحنين","https://www.poetsgate.com/ViewPoem.aspx?id=159608",""],[2220,"من اتقى الله فذاك الذي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11289&r=&rc=163",""]],"verses":[["من اتقى الله اتقت بأسه","كواسر الأفق وغلبُ الوهاد",0,"د",1,0],["مَنْ أتلفَ الناسَ وأموالَهُمْ","يحقُّ للسلطانِ أَنْ يتلفَهْ",1,"ه",1,0],["مَنِ اتَّقى اللَهَ فَذاكَ الَّذي","سيقَ إِلَيهِ المَتجَرُ الرابِحُ",2,"ح",1,0],["مَنِ اِتَّقى اللَهَ فَأُسدُ الشَرى","لَدَيهِ مِثلُ الأَكلُبِ العاوِيَه",3,"و",3,0],["مَنْ أتى الصحراءَ في دَوِّها","بهذه الأسوارِ شُمِّ الحصونْ",4,"ن",1,0],["مَن أَتى بِمُشمِسِها","مَن أَتى بِمُقمِرِها",5,"ر",3,0],["من أتته ؟ فلاحة مشطها الشّمس","عليها من الشروق قلائد",6,"د",1,0],["من أتى ..؟ عاصف من الترك طاغ","فلأمزق حلوقه وهديره",7,"ر",2,0],["مَن أتَانَا مُجَادِلاً فِيهِ ألقَمنَا","هُ صَخراً لَم يُبقِ فِيهِ جِدَالا",8,"ل",2,0],["من أَتاهُم مؤمّلا جدواهُم","عاد مُستَبشِراً بِهِم مَسرورا",9,"ر",2,0],["من اتصالي بعد طول النوى","بهم ومن فوزي بلقياهم",10,"م",1,0],["من أتانا بالهدى من ربنا","وأرانا الحق بالنص الصريح",11,"ح",1,0],["من أتاه يرجوه يحظ بجود","يرتجي العالمون منه نواله",12,"ل",2,0],["من أتى بالوليدِ بالرّوعِ قَسْراً","بعدَ عزِّ العُلا بذُلِّ الوَثاقِ",13,"ق",1,0],["من أتانا ألقى عصا السير عنْهُ","قلت من لي بها وأين السبيل",14,"ل",1,0],["من أتاهم بعلمهم جحدوه","كيف من جاءهم بعلم غريب",15,"ب",1,0],["من أتَى بَابنَا انَلنَاه فَضْلاَ","تلك عاداتُنا لِمَن شَاء قبْلَهْ",16,"ل",2,0],["من أَتَتْه الأَيَّامُ مُعْتذِرَات","فأَتى صَفْحُه وَرَاحَتْ حُقُودُه",17,"د",2,0],["مَن أَتانا بِالهُدى وَالبيِّنات","مِثلَما جاءَ بِآي السُّوَرِ",18,"ر",1,0],["مَن أَتى ساحِلَهُ خدنَ ظَما","عادَ بِالريِّ الهنيِّ السلسِ",19,"س",1,0],["من أتحفها بهجة وفرّط سرور","لما وضعته مطيبا حسن الحال",20,"ل",1,0],["من أتاه البعير يأنس بشرا","بعدما كان أشرس الشراد",21,"د",1,0],["من أتاه قتادة يشتكى","فقد عين فردها لمعاد",21,"د",1,0],["من أتته الظبي مسيرة شهر","لا امتثالا لأمره وانتظارا",22,"ر",2,0],["من أتاه البعير يشكو هلاكا","فحماه من الردى وأجارا",22,"ر",2,0],["من اتى الباب قاصداً ذات سلبي","فاز منها بعاليات المنال",23,"ل",1,0],["منا تَوَّجَ المُلكُ إِلّا بِاِبنِ سَلمانِ","وَلا يَشُدُّ سِواهُ أَزرَ سُلطانِ",24,"ن",1,1],["من اتخذ البرهانَ والفحص عُدَّةً","تبَيَّنَ ما حقَّ الأمور وزُورُها",25,"ر",3,0],["من أَتاني في حاجَة فَلَه ال","فَضل بتوصيلها إِلَيّ عَليّا",26,"ي",2,1],["من أتاها يشتكي داهية","لم تصبه بعد هذا دهيه",27,"ي",2,0],["من أتاكم طالب الهدى اهتدى","ومن ارتاد حماكم لن يضاما",28,"م",2,0],["من اتقى فذاك الذي","أساء ظناً بالذي أوجده",29,"ه",1,1],["مِنَّا تَعَلَّمتُم وَنَحنُ شُيُوخُكُم","لاَ تَجحَدُونَا مِنَّةَ الإِحسَانِ",30,"ن",1,0],["من أتى حيه ووافاه يوماً","بلغته يد الزمان مراده",31,"د",2,0],["من أتاه مستنصراً بحماه","عاد بالنصر بالغا ما تمنى",32,"ن",2,0],["من أتاهم في دياجي غيهب","نور الله لديهم قلبه",33,"ب",2,0],["من أتانا بنا قبلناه فضلا","تلك عاداتنا لمن جاء قبلَه",34,"ل",2,0],["من أتاه الحق في غار حِرا","فجلا عنه ظلام الغيهب",35,"ب",1,0],["من اتقى اللَه ما استطاع مدرعاً","بما يفل به لهاذم الدجمِ",36,"م",1,0],["مناً تصوب على الورى","الفكر فيك تحيرا",37,"ر",2,0],["منا تُودَّعُ بالبكاءِ","وأنت في الملا الرفيع",38,"ع",1,0],["من أتى باب عزه بانكسار","وخضوع حماه مما أهالا",39,"ل",2,0],["مَن أَتى صَخرة الوُجود فَفَرا","ها وَأَجرى مِنها الَّذي كانَ أَجرى",40,"ر",2,0],["من أتى ينقلُ أخباراً بها","للذي يأتي كما قد نقلا",41,"ل",2,0],["مَنِ اتَّخَذَ الأَيَّامَ مِنْهَا مَطِيَّةً","لِأُخْرَى تُرَجَّى يَوْمَ حَشْرٍ سُعُوْدُهَا",42,"د",3,0],["من اتقى الله فما أكرمه","لو أنه عاش ضعيفاً مزدرى",43,"ا",1,0],["مَن أتانا اليومَ يَبغي صَفقةً","مَن أتى يا أُختُ في ثَوبٍ رَتي",44,"ت",2,0],["من أتى الله سعد والردى عنه ابتعد","أيها الريح أعيد من نموم منك نم",45,"م",1,0],["منْ أتقنَ الفنَّ نامَ الليلَ في فَرَحٍ","يرى السّعادةَ في الأحلامِ والسَّحرِ",46,"ر",1,0],["مَنْ أتاها عازفًا لحنَ الأنينِ","سوف يغدو مثل ذرٍّ في السنينِ.",47,"ن",1,0],["من اتقى الله فذاك الذي","أساء ظناً بالذي أوجده",48,"ه",1,1]]}