","عموديه"],[464,"يا من تلون عهده وتغيرا","https://www.aldiwan.net/poem3198.html","عموديه"],[464,"قف بالمنازل أو كناس ظبائها","https://www.aldiwan.net/poem3275.html","عموديه"],[464,"ما لي بألحاظ الظباء يدان","https://www.aldiwan.net/poem3424.html","عموديه"],[464,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"],[464,"راح يستمطر الدموع الغزارا","https://www.aldiwan.net/poem3621.html","عموديه"],[468,"حجابي مرفوع لطار ونازل","https://www.aldiwan.net/poem59752.html","الطويل"],[477,"دمن حبسن على الغرام وأربع","https://www.aldiwan.net/poem15253.html","الكامل"],[479,"ظلموك يا جدي ولست ظلوما","https://www.aldiwan.net/poem37194.html","الكامل"],[493,"صحبت الدهر في سهل وحزن","https://www.aldiwan.net/poem67313.html","الوافر"],[500,"زاحمتنا بوهمها أسماء","https://www.aldiwan.net/poem37652.html","الخفيف"],[500,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[500,"دمعي كسيل تنمنم","https://www.aldiwan.net/poem37779.html","المجتث"],[500,"لا تشوش لك سرا","https://www.aldiwan.net/poem37924.html","مجزوء الرمل"],[500,"طيبوا بنا نحن طيب","https://www.aldiwan.net/poem38079.html","المجتث"],[500,"رغبنا بأسرار الشهود لوجهكم","https://www.aldiwan.net/poem38082.html","الطويل"],[513,"ما لي ألفت وجها غير ملتفت","https://www.aldiwan.net/poem67717.html","البسيط"],[513,"لئن كان الرقيب بلاء قوم","https://www.aldiwan.net/poem67777.html","الوافر"],[515,"ما هاج مزنة دمعه المترقرق","https://www.aldiwan.net/poem12188.html","الكامل"],[515,"خلعت عليك مواسم الأيام","https://www.aldiwan.net/poem12251.html","الكامل"],[529,"مولاي يا فرد العلى والملا","https://www.aldiwan.net/poem37525.html","السريع"],[538,"هو نصر قد جاء يعقب نصرا","https://www.aldiwan.net/poem48133.html","عموديه"],[538,"واسلك سبيل المفلسين ودار","https://www.aldiwan.net/poem48172.html","عموديه"],[538,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[538,"حججنا لعمري ابتغاء الثواب","https://www.aldiwan.net/poem48287.html","عموديه"],[553,"أأعلن ما بي أم أسر فأكتم","https://www.aldiwan.net/poem68411.html","الطويل"],[558,"حمائم شوق في الغصون تنوح","https://www.aldiwan.net/poem33554.html","الطويل"],[558,"ذات تبدت في بديع حلاها","https://www.aldiwan.net/poem33589.html","الكامل"],[558,"لمتى أنت في الضلال المبين","https://www.aldiwan.net/poem33722.html","الخفيف"],[558,"كل تحريك تراه وسكون","https://www.aldiwan.net/poem33843.html","الرمل"],[558,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[558,"إذا كان كلي دائما يشبه البرقا","https://www.aldiwan.net/poem34320.html","الطويل"],[558,"إن هذا بعض ما قد ظهرا","https://www.aldiwan.net/poem34511.html","الرمل"],[562,"خطرت وفي قلبي لذاك خفوق","https://www.aldiwan.net/poem52991.html","الكامل"],[564,"متى يرحم المشتاق والوامق المضنى","https://www.aldiwan.net/poem896.html",""],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"صبراً أبا عبد الإله عن التي","https://www.aldiwan.net/poem3656.html","الكامل"]],"verses":[["حَجَلَ الخَيلُ مِن دِماءِ الأَعادي","يَومَ يَبدو طَعنٌ وَتَخفى حُجولُ",0,"ل",1,0],["حِجَّةً ماشياً وَتَحريرَ ما أَم","لِكُ شُكراً وَما حَييتُ أَصومُ",1,"م",1,0],["حَجَجتُ وَقُلتُ قَد حَجَّت ظَلومٌ","فَيَجمَعُني وَإِيّاها المَسيرُ",2,"ر",1,0],["حَجَبتِ وَجهَكِ عَن عَينَيَّ مُذ زَمَنٍ","فَلَو مَنَنتِ عَلى عَينَيَّ بِالنَظَرِ",3,"ر",1,1],["حَجَبوا دُونَها الأَماني وَإِنّي","جاهِدٌ أُعمِلُ الرَجاءَ وَحيدا",4,"د",2,0],["حَجَرا رَمَاهُ الْمَنْجَنِيقُ فَشَأُنُهُ","مُتَطَأطِئ مُتَدَافِعٌ مَلْمُومُ",5,"م",1,0],["حُجِبْتُ بحُجْبِ الصّوْنِ عنْ كلِّ ناظِرٍ","وأُسْكِنْتُ للتّرْحيبِ أرْفَعَ نادي",6,"ي",1,0],["حُجّةُ اللهِ حكمةُ اللهِ نُورُ ال","لَّهِ في كلِّ غايَةٍ وافْتِتاح",7,"ح",1,0],["حَجَروا عَلى أَضيافِهِم وَشَوَوا لَهُم","مِن شَطِّ مُنقِيَةٍ وَمِن أَكبادِ",8,"د",1,0],["حَجونٌ تُظِلُّ الفَتى جاذِباً","عَلى واسِطِ الكورِ عِندَ الذَقَن",9,"ن",1,0],["حُجَجُ المُبطِلينَ تَمضي سِراعاً","مِثلَما تُطلِعُ الكُؤوسُ الحَبابا",10,"ب",2,0],["حَجَبَ المَوتُ مَطلَعَ الجودِ يا مِص","رُ فَجودي لَهُ بِدَمعٍ سَخِيِّ",11,"ي",1,0],["حَجَبتَ ضِياءَ الصُحفِ عَن ظُلُماتِهِ","وَلَم تَستَقِل حَتّى حَجَبتَ المُؤَيَّدا",12,"د",2,0],["حِجَازيَّة العَينَين مَكيَّةُ الحَشَ","عِرَاقِيَّةُ الأَطرَافِ رُومِيَّةُ الكَفَل",13,"ل",1,0],["حَجُّكَ أَرْضَى رَبِّكِ العِليَّا","وَسَرَّ فِي روضَةِ النَّبِيَّا",14,"ي",2,1],["حَجَجْتَ إِلَيْهِ وَالهَوَى يَشْغَلُ الَّذِي","يَحُجُّ إِلَيْهِ عَنْ مَشَقَّاتِ دَرْبِهِ",15,"ب",2,0],["حَجَجْتُهُ وَبِهِ مِنْ طُولِ مُدَّتِهِ","وَفَضْلِ جِدَّتِهِ لِلطَّرْفِ حُسْنَانِ",16,"ن",1,0],["حِجَارَتُهَا ضَحَّاكَةٌ عَنْ بَيَاضِهَا","وَآجُرُّهَا عَنْ حُمْرةٍ يَتَبَسَّمُ",17,"م",1,0],["حجبناهنّ عن طلب المعالي","فعِشن بجهلهنّ مهتّكات",18,"ت",1,0],["حُجّوا الصَليبَ وَقَرِّبوا قُربانَكُم","وَخُذوا نَصيبَكُمُ مِنَ الخِنزيرِ",19,"ر",1,0],["حجليّ إذا انتسبتَ ولكن","ألفُ عرفٍ له وألفُ ثناء",20,"ا",2,0],["حجبت ولم أحسب سنا البدرِ يحجب","ولا خلتهُ في باطنِ الأرضِ يغرب",21,"ب",1,1],["حجبة هذي لهذه خدمت","يا حسن هذا الوزير والحاجب",22,"ب",1,0],["حجبتني فازْدَدت عندي علاً","برغمِ من أقبل كالعاتب",23,"ب",1,1],["حجبت بالدَّمعِ أجفاني عن النظرِ","إلى سواكَ وقلبي الصبّ بالفكرِ",24,"ر",1,1],["حجرٌ من دراهمٍ","حطّه السيل من عل",25,"ل",1,0],["حجبت عزَّا وتوقيراً وما حجبت","عنَّا أياديك في سرٍّ ولا علن",26,"ن",1,0],["حجّ في المملوكِ يا من","عاشَ بين العلمين",27,"ن",1,0],["حجبت يراعته الخطوب فيا لها","من نعمةٍ عن فضلها لم نعمهِ",28,"ه",1,0],["حجبتني يد إسما","عيل عن كلِّ بليَّه",29,"ي",2,0],["حَجَبْت لما حجبت النوم عن بصري","وخانني في هواك الصبر والجلدُ",30,"د",1,0],["حجرُ الرجل وجههُ","خشن مثل شعرهِ",31,"ر",2,1],["حِجراً على الآسادِ حيثُ عَرَّسا","أذاكَ أم قِرنَ صِيالٍ أسْوَسا",32,"س",2,0],["حججت أبا الحسين وكان حجّي","إليه لا يُذمُّ ولا يُذامُ",33,"م",1,0],["حُجراتٌ متَيَّمَاتٌ بناها","من فضول المعروف أكرمُ باني",34,"ن",2,0],["حَجَبوهُ لكي أُرى سالياً عن","ه على نأيهِ فأُعقبتُ غَيَّا",35,"ي",2,0],["حَجَونا بَني النُعمانِ إِذ عَضَّ مُلكُهُم","وَقَبلَ بَني النُعمانِ حارَبَنا عَمروُ",36,"ر",2,0],["حَجَرٌ أَغبَرٌ أَنا وَحَقيرٌ","لا جَمالاً لا حِكمَةً لا مَضاءَ",37,"ا",2,0],["حَجَبَ الغَمامُ البَدرَ عِندَ مَسيرِهِ","فَكَأَنَّهُ أَسماءُ تَسري في الدُجى",38,"ا",1,0],["حَجَبَ السَماءَ عَنِ النَواظِرِ وَالثَرى","فَكَأَنَّهُ اللَيلُ البَهيمُ الأَليَلُ",39,"ل",1,0],["حَجَبتُ عَن كُلِّ مَعدومِ النُهى دُرَري","إِنّي أَضِنُّ عَلى الأَنعامِ بِالنِعَمِ",40,"م",1,0],["حَجَبوها عَساهُ يَسلو وَلَكِن","كانَ قَيساً وَكانَتِ العامِرِيَّه",41,"ي",2,0],["حِجَجا عَشراً وعشراً بَعدَها","وَثَلاثينَ وَعِشرينَ نَسَقْ",42,"ق",1,0],["حجروا العقل في الذين لهم عق","ل ولم يتركوا له تفكيرا",43,"ر",2,0],["حجرات في جوفها ظلمات","فهي في الليل والنهار سواءُ",44,"ا",2,0],["حجابك عند يلدزك الجلال","وأنت لها وللدنيا جمال",45,"ل",1,0],["حَجُّ الأَميرِ لَهُ الدُنيا قَدِ اِبتَهَجَت","وَالعَودُ وَالعيدُ أَفراحٌ وَأَعراسُ",46,"س",1,0],["حَجَبَت مِن رَبيعِهِ ما رَجَوتُم","وَطَوَت رِحلَةَ العُلا مِن هِلالِه",47,"ل",2,0],["حُجَرٌ مُمَرَّدَةُ المَعا","قِلِ في الثَرى شُمُّ الحُصون",48,"ن",1,0],["حُجُراتُها مَوطوءَةٌ وَسُتورُها","مَهتوكَةٌ بِيَدِ البِلى تَتَخَرَّقُ",49,"ق",1,0],["حَجَّنا في الزَمانِ سِحراً بِسِحرٍ","وَاِطمَأَنَّت إِلى العَصا السُعَداءُ",50,"ا",2,0],["حُجِبَ العاذِلونَ عنهُ فمَا يَل","حَونَ لولا البُكَا ولولا الأَنينُ",51,"ن",1,0],["حَجَّبتُها عَن أَهلِ إِنطاكِيَّةٍ","وَجَلَوتُها لَكَ فَاِجتَلَيتَ عَروسا",52,"س",2,0],["حَجَّبَ ذا البَحرَ بِحارٌ دونَهُ","يَذُمُّها الناسُ وَيَحمَدونَهُ",53,"ن",2,1],["حجر القوم واحد","والتدابير واحده",54,"د",2,1],["حجر واحد ونهج قديم","من رآه لم يستطع أن يجورا",55,"ر",2,0],["حجر تركيبنا فوق حجر","خالص ما فيه غش وكدر",56,"ر",1,1],["حجر يظهر في التد","بير منه حركات",57,"ت",1,1],["حَجَبوها حَتّى بَدَت لِفِراقٍ","كانَ داءً لِعاشِقٍ وَدَواءَ",58,"ا",2,0],["حُجَجٌ تُخرِسُ الأَلَدَّ بِأَلفا","ظٍ فُرادى كَالجَوهَرِ المَعدودِ",59,"د",1,0],["حَجَجنا البَنِيَّةَ شُكراً لِما","حَبانا بِهِ اللَهُ في المُنتَصِر",60,"ر",1,0],["حَجٌّ تَقَبَّلَهُ الإِلَهُ وَأَوبَةٌ","كانَت شِفاءَ جَوىً لَنا وَتَذَكُّرِ",61,"ر",1,0],["حُجِبُوا عَنِ الأحبابِ إلاّ زَورَةً","تجري بزُورِ لِقائِها الأحلامُ",62,"م",1,0],["حجَبتُ عن الأَسماعِ منه بَقيَّةً","مقيَّدةً عن كلِّ حَلٍّ وتَرحالِ",63,"ل",1,0],["حِجابٌ من الكَتَّانِ رَقَّ هَواؤُه","كأنَّ هجيرَ اليَومِ فيه أصيلُ",64,"ل",1,0],["حُجِبَتْ له شَمْسُ النَّهارِ وأشرَقَتْ","شَمْسُ الحديدِ بجانِبَيْهِ شُروقا",65,"ق",2,0],["حَجَبَت محاسنَها الخيامُ ولو بَدَتْ","كانَ العَفافُ لها أتمَّ حِجابِ",66,"ب",1,0],["حَجَبَتهُ الغُيوبُ عَن كُلِّ عَينٍ","وَهوَ فينا أَنيسُ كُلِّ وَحيدِ",67,"د",1,0],["حَجَبوها عَنِ الرِياحِ لِأَنّي","قُلتُ يا ريحُ بَلِّغيها السَلاما",68,"م",2,1],["حَجَبَ الحَبابُ شُعاعَها فَكَأَنَّهُ","شَفَقٌ تَلَهَّبَ تَحتَ ذَيلِ صَباحِ",69,"ح",1,0],["حَجَّت إِلَيكَ بَنو الرَحيلِ لِعِلمِهِم","حَقّاً بِأَنَّكَ كَعبَةُ المُدّاحِ",69,"ح",1,0],["حَجَبَتهُ عَنّا السَحائِبُ أَيّا","ماً وَبِالسُحبِ تُحجَبُ الأَقمارُ",70,"ر",1,0],["حجبت تأبى لعيني مأربا","غير عينيك ولا مطلبا",71,"ب",2,0],["حَجَبَ الغيمُ منه في الأفق بدراً","وانجلى عن ضيائه بسلامِ",72,"م",1,0],["حُجِرَ الصَبرُ وَالسُلُوُّ عَلى دَم","عي وَوَجدي فَاِذهَب فَأَنتَ الطَلاقُ",73,"ق",1,0],["حِجىً لِحِمى البَطالَةِ مُستَبيحُ","وَقَدرٌ لِلمَكارِمِ مُستَميحُ",74,"ح",1,1],["حجتِ البيتَ لترمي","في فؤادي جمراتِ",75,"ت",1,1],["حجارةُ سجيلٍ لها البدرُ خائفٌ","على نفسِهِ والنجمُ في الغربِ مائلُ",76,"ل",1,0],["حجَّتْ إليكَ بناتُ أفكاري وَقَدْ","رجعتْ بفضلِكَ كالحمائمِ تسجَعُ",77,"ع",1,0],["حُجَجٌ مَضَتْ، وأُعِيدُهُ في هَاشِمٍ","قَوْلاً نَبِيلاً، يَسْتَمِيحُ نَبِيلا",78,"ل",2,0],["حَجَجتُ وَلَم أَحجِج لِذَنبٍ جَنَيتُهُ","وَلَكِن لِتُعدي لي عَلى قاطِعِ الحَبلِ",79,"ل",1,1],["حَجَبَت غَواشي الجَهلِ بَعضَ قُضاتِها","وَالناسُ مِنهُم جاهِلٌ وَخَبيرُ",80,"ر",1,0],["حَجَبوا المَقاتِلَ بِالدُروعِ حَصينَةً","وَالحَتفُ يَهتِكُ حاسِراً وَمُحَجَّبا",81,"ب",2,0],["حَجَبَت صَديعَ الرُشدِ عَنها فَاِرتَمَت","تَجتابُ لَيلَ الغَيِّ أَسفَعَ داجِيا",82,"ي",2,0],["حجبتكَ الغيوبُ سِرّاً تجلى","يكشفُ الحُجْبَ كلَّها والسُّتورا",83,"ر",2,0],["حَجَرتَ أَبا بَكرٍ عَلى الدَهرِ جانِبي","وَوَطَّنتَني إِذ أَزعَجَتني زَلازِلُه",84,"ل",2,0],["حُجِبتُ بِهِمَّتي مِن أَن تَروني","أُراقِبُ مِنكُمُ رَفعَ الحِجابِ",85,"ب",1,0],["حِجازِيَّةُ السُّحْبِ الثِّقالِ يَسُوقُها","عَلَى عَجَلٍ سَوْقاً صَباً وَدَبُورُ",86,"ر",1,0],["حُجِب