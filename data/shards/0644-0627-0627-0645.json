{"poems":[[55,"قف موقف الشك لا يأس ولا طمع","https://www.aldiwan.net/poem30134.html","البسيط"],[3,"لا أملك السيف إلا قد ضربت به","https://www.aldiwan.net/poem98.html",""],[79,"انظر خضاب الشباب قد نصلا","https://www.aldiwan.net/poem35719.html","المنسرح"],[95,"وافى الحديث إلى غريب الدار","https://www.aldiwan.net/poem11068.html","الكامل"],[43,"دعاك من شوقك الدواعي","https://www.aldiwan.net/poem42371.html","مخلع البسيط"],[72,"قالوا النبيه فقلت أه","https://www.aldiwan.net/poem43002.html","مجزوء الكامل"],[87,"شيعت احلامي بقلب باك","https://www.aldiwan.net/poem24531.html","الكامل"],[47,"لا يبعد اللهو في أيامنا المودي","https://www.aldiwan.net/poem63451.html","البسيط"],[47,"قد فقدنا الوفاء فقد الحميم","https://www.aldiwan.net/poem65689.html","الخفيف"],[63,"صبابة منك لجت في تماديها","https://www.aldiwan.net/poem51400.html","البسيط"],[92,"‏كل ما في الكون حب وجمال","https://www.aldiwan.net/poem26553.html","الرمل"],[107,"ناد القبور وبشر كل مقبور","https://www.aldiwan.net/poem43053.html","البسيط"],[50,"ما لي بدار خلت من أهلها شغل","https://www.aldiwan.net/poem64514.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55303","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43747","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43748","الخفيف"],[108,"إلى مجلس الأمن","https://www.poetsgate.com/ViewPoem.aspx?id=179350",""],[111,"لا تكترث بالليالي إنها دول","https://www.poetsgate.com/ViewPoem.aspx?id=519",""],[102,"عيد الجلوس","https://www.poetsgate.com/ViewPoem.aspx?id=50116",""],[92,"غضبة","https://www.poetsgate.com/ViewPoem.aspx?id=179231",""],[119,"جانب زمانك ان اردت وواله","https://www.aldiwan.net/poem40616.html","عموديه"],[132,"أوصيكمو يا أيها العقلاء","https://www.aldiwan.net/poem50680.html","الكامل"],[146,"أى لبيب بك لم يخدع","https://www.aldiwan.net/poem58407.html","السريع"],[151,"لا أمل الحب إن كان يمل","https://www.aldiwan.net/poem47658.html","الرمل"],[201,"يا جارة الوادي طربت وعادني","https://www.aldiwan.net/poem39810.html","الكامل"],[266,"وشادن بي ظمأ ممض","https://www.aldiwan.net/poem38122.html","مخلع البسيط"],[286,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[303,"من فاته أن يرى الأشجان ماثلة","https://www.aldiwan.net/poem36307.html","عموديه"],[309,"يا آخذا مني بأذيالي","https://www.aldiwan.net/poem16757.html","السريع"],[354,"لولا سنى ربة الخدر بدا","https://www.aldiwan.net/poem15643.html","الرجز"],[422,"عفت المنازل رقة ونحولا","https://www.aldiwan.net/poem54062.html","الكامل"],[545,"يا دار سعدى بالجزع من ملل","https://www.aldiwan.net/poem56706.html","المنسرح"],[563,"هذا الطريق الأقرب","https://www.aldiwan.net/poem34925.html","مجزوء الكامل"],[629,"","https://poetry.dctabudhabi.ae/diwan/poem/100583","المجتث"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64403","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119979","الكامل"],[567,"","https://poetry.dctabudhabi.ae/diwan/poem/42989","البسيط"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/198736","البسيط"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56584","الخفيف"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49928","المنسرح"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110273","السريع"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48222","الكامل"],[2607,"","https://poetry.dctabudhabi.ae/diwan/poem/34892","السريع"],[345,"","https://poetry.dctabudhabi.ae/diwan/poem/124712","الكامل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100882","البسيط"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116506","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74181","الكامل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145067","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68030","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92378","البسيط"],[3771,"","https://poetry.dctabudhabi.ae/diwan/poem/67760","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77191","الخفيف"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44720","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36602","الدوبيت"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62137","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33276","المنسرح"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52127","الكامل"],[4702,"كارثة سيول جدة .. 30 / 1 / 2011م","https://www.poetsgate.com/ViewPoem.aspx?id=155464",""],[4755,"بفَمِي سُؤالٌ شاخَ دُونَ مُبَلِّغٍ","https://www.poetsgate.com/ViewPoem.aspx?id=188571",""],[4767,"صرح الفضيلة","https://www.poetsgate.com/ViewPoem.aspx?id=100459",""],[4778,"نهوى الرجوع إلى عهد الصِبا","https://www.poetsgate.com/ViewPoem.aspx?id=206337",""],[5187,"من وحي الوادي","https://www.poetsgate.com/ViewPoem.aspx?id=29701",""],[5452,"بلد الأخيار","https://www.poetsgate.com/ViewPoem.aspx?id=148454",""],[5736,"وجع الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=208185",""],[5842,"دمشق .. بكّاؤوك كاذبون كاذبون ! .","https://www.poetsgate.com/ViewPoem.aspx?id=146614",""],[5848,"فتنة الريم","https://www.poetsgate.com/ViewPoem.aspx?id=48955",""],[5956,"وتثور نفسي","https://www.poetsgate.com/ViewPoem.aspx?id=182639",""],[5963,"شاعرٌ في زمن الضَّياع","https://www.poetsgate.com/ViewPoem.aspx?id=187324",""],[5989,"حلمٌ كاذب","https://www.poetsgate.com/ViewPoem.aspx?id=182772",""],[6031,"عُجْ بالمَطِيِّ علَى مَعَالمِ بُورِي","https://www.poetsgate.com/ViewPoem.aspx?id=46320",""],[6093,"الثُّؤْلولُ","https://www.poetsgate.com/ViewPoem.aspx?id=205900",""],[6124,"أمسيات","https://www.poetsgate.com/ViewPoem.aspx?id=105842",""]],"verses":[["لا أَمتَري أَنَّني بُجرٍ إِلى أَمَدٍ","جَروا إِلَيهِ قُبَيلَ اليَومِ أَو نَزَعوا",0,"ع",3,0],["لا أَملِكُ السَيفَ إِلّا قَد ضَرَبتُ بِهِ","وَلا تَموتُ جِيادي وَهيَ أَغمارُ",1,"ر",1,1],["لا أملٌ مُسْعِفٌ ولا عمَلٌ","ونحْنُ في ذا والمَوْتُ قد وصَلا",2,"ل",2,0],["لا أملك الدينار إلا بائعاً","في صفقة مجموعة آثاري",3,"ر",2,0],["لاَ اَمنَعُ النَّفسَ عَن هَوَاها","وَكُلُّ شَيءٍ إِلَى انقِطَاعِ",4,"ع",1,0],["لاأُمَّ لي إِن كانَ ما","نَقَلَ الحَسودُ وَلا أَبا",5,"ب",2,0],["لا أَمسِ من عمرِ الزمان ولا غَد","جُمِع الزمانُ فكان يومَ رِضاكِ",6,"ك",1,0],["لا أَمدَحُ المَرءَ أَقصى ما يَجودُ بِهِ","نَيلٌ يُكَسَّرُ مِن حافاتِ جُلمودِ",7,"د",1,0],["لا أَمَلُّ الزَمانَ ذَمّاً وَحَسَبي","شُغُلاً أَن ذَمَمتُ كُلَّ ذَميمِ",8,"م",1,0],["لا أمِلكُ الصَّبرَ عنها إن نَأَيتُ ولَو","عُوِّضتُ من ظِلِّها الدُنيا بِما فِيها",9,"ي",3,0],["لا أمَّل العيش ما شئتم فكونوا","لسوى حبكم يحلو الملال",10,"ل",1,0],["لا أمّةٌ ذاتُ تاريخٍ ولا وَطَنٌ","كلٌّ هَباءٌ وشيءٌ غيرُ مذكورِ",11,"ر",1,0],["لا أَمدَحَنَّ وَلا أُخطي خَلائِقَهُ","مَن عِندَهُ لي إِذا ما جِئتُهُ نُزُلُ",12,"ل",1,0],["لا أَمْنَ لِلْبَلَدِ الأمِي","نِ وَفِي غَدٍ قَدْ يُهْتَضَمْ",13,"م",1,0],["لا أَمنَ إِلّا بِإيمانٍ غَداةَ غَدٍ","وَلا سَلامَةَ لي إِلّا بِإِسلامي",14,"م",2,0],["لا أَمانَ مِنَ المَنونِ لِمَن فَر","رَ وَلَو حازَهُ الأَشَمُّ شمامُ",15,"م",1,0],["لا أمْنَ في الأرض ما لم يَحْمِ حَوْزَته","جيشٌ يرد جِمَاحَ المعتدي، لَجب",16,"ب",1,0],["لا آمن الدهر في لين وفي شعث","وطبعه للوفا والغدر محتمل",17,"ل",1,0],["لا أمهل الموت الجبان ولا نجا","منه º وعاش الثائر المستشهد",18,"د",1,0],["لا أمرَ عندهَمُ فهمُ هَمَلٌ","غُفْلٌ وكل حياتِهم خَمْر",19,"ر",1,0],["لا امن للعقلاء من انكاده","مهما اعان بحاله وبماله",20,"ل",2,0],["لا آمُرَنَّ به فتىً ذا عُسْرة","إلا امرأً معه غِنىً وثرَاءُ",21,"ا",2,0],["لا أمدح اليأسَ ولكنه","أرْوحُ للنفس من المطمعِ",22,"ع",1,0],["لا أملّ الحب إن كان يملّ","لست أنساه بعيدا أو قريب",23,"ب",1,1],["لا أمس من عمر الزمان ولا غد","بنواك آه من النوى رحماك",24,"ك",1,0],["لا أملك الطرف ان بدا لي","من نظر فيه بين ناسه",25,"س",2,0],["لا أمنع الدمع أن يهمى وأن يكفا","ولا أزال ربع الحزن معتكفا",26,"ف",2,1],["لا أَملكُ الصمتَ إِنْ أَضحى عَلَى مضضٍ","وَلستُ آمنَ قولاً دونه الفزع",27,"ع",1,0],["لا آمن المكر ولكنني","أريد أن أخزيك يا غالي",28,"ل",2,0],["لا أَملِكُ السُلوانَ عَنها لا وَلا","أَلقى عَلى طولِ جَفاها مُسعِدا",29,"د",2,0],["لا آمن الحدثان إلاَّ أن أرى","بجوار ذيَّاك الجناب نزولا",30,"ل",2,0],["لا أُمتِعُ العوذَ بالفِصالِ وَلا","أَبتاعُ إِلّا قَريبَةَ الأَجَلِ",31,"ل",1,0],["لا أم لي من غيره","أمد الزمان ولا أب",32,"ب",1,0],["لا أملك السمع إما","لوائم اللهو لاموا",33,"م",3,0],["لا آمن الناس بعد هذا","ما الخوف إلا من الأمان",34,"ن",1,0],["لا أمضي عزما على","امل ولا أنضي الرَّواسِم",35,"م",1,0],["لا أمدَحُ المَرْءَ مَهْما عَزَّ جانِبهُ","إلا بما فيهِ كالقُسْطاسِ إذ يَزِنُ",36,"ن",1,0],["لَا أَملِكُ الدُّرَّ دُرَّ البَحرِ أُهديهِ","أليكِ دُرَّ مقالي في قوافيه",37,"ي",2,1],["لا أمان فننتهي بالأماني","لا نوال فنكتفي بالنوال",38,"ل",1,0],["لا أُمةٌ بالفَخار يسْبقُها","ولا قتيلٌ بالبأس يغلبُها",39,"ب",3,0],["لا أم لا اهل لا معين","إلا أبٌ شيخٌ شديد النكير",40,"ر",1,0],["لا أمَّ لِلاحي يبيتُ يلومُنى","إِنْ أشتكي حَرّاً لِبَرْدِ لمَاَكِ",41,"ك",1,0],["لا أُمّ تَحمي عَن حِماها وَلا","خال لَهُ يَحمي وَلا غَير خال",42,"ل",1,0],["لا أمطرت دِيَمُ بساحتي","إن لم أحلَّ بربعها الممطورِ",43,"ر",1,0],["لا أمطر اللهً بالفسطاط غادية","ولا سقى غير أحيائى وأمواتى",44,"ت",2,0],["لا ام رحم غير انى مولع","بسلع ألا هل يكون بها قبري",45,"ر",2,0],["لا أَمتري فيما وَعَدت وَلَم أَقُل","طالَ الوُقوف عَلى رُسوم المَنزل",46,"ل",1,0],["لا أمنح الناس ميثاقي ولا ثقتي","وإن أحاطت بي الأفواج والحلق",47,"ق",1,0],["لا أَمترِي ناقتِي بالساق من تعبٍ","إِذ لَمْ يَؤُدْها الوَنَى وَهْدٌ وقِيعان",48,"ن",1,0],["لا أَمسَ أَبكي وَلا أَخشى افتراقَ غد","والقَلب خالٍ من الأحزان والكَمدِ",49,"د",1,0],["لا أمدح المرءَ أَبغي فضل نائِلهِ","ولا أظل أداريه إذا غضبا",50,"ب",2,0],["لا أمد الإِله فاقَة حُر","أَقعَدَته عَن مَطلَبِ النجباء",51,"ا",2,0],["لا أُمَّ يَدفَعُها الحَنان وَلا أَبٌ","يَبدو إِذا حَلَت بِنا الأَغيارُ",52,"ر",1,0],["لا امتَدَّ إِلى نَتائِج الوَصلِ يَدي","إِن زدتُ عَلى مقدِّمات القُبَلِ",53,"ل",1,0],["لا أم لي إن لم أيمم مسلكاً","يهدي الحياة إلي فيه حمامي",54,"م",2,0],["لا أمل القلبُ عندَ سلوتهِ","ولا أرادَ السلوَّ ما قدرا",55,"ر",2,0],["لا أمدَح الرجلَ الكريمَ لبُغَيةٍ","قُطِع اللسانُ إذا نطقتُ الزُّورا",56,"ر",2,0],["لا أمين ولا وزير وكل منصب من يسدّه؟","دام ما فيها حسيب ولا رقيب ولا درايه",57,"ا",3,0],["لا أَمنَ في الوطنِ المُقَسَّمِ يُرتَجَى","فالرُّوحُ تَأنَفُ مَيِّتَ الأجسامِ",58,"م",1,0],["لا أمن يحفظهم فقد","ذهب المحامي والحمَى",59,"م",2,0],["لا أمرض الله عينا تبكِ مَنْ فَقََدَتْ","وتُرسل الدمعَ فوقَ الخدِّ مِدرارا",60,"ر",2,1],["لا أملكُ إلا خاتمةً","في دنيا الشِّعرِ ومغناهُ",61,"ا",2,0],["لا أمّة عن منكر تنهى وما","من هيئة تنهى عن الفحشاءِ",62,"ا",2,0],["لا أم تهدهد بي وجعا","لا أخت تلملم اشلائي",63,"ا",3,0],["لا أمةُ الإسلامُ تَسمعهُ ولا","عرباننا من أجله دقُّوا النفيرْ",64,"ر",1,0],["لا امتطت مهرة الأشواق فوق السحاب","تعسف الجامح اللي لا عشق ما يتوب !",65,"ب",1,0],["‏لا أملك الأسرار فالأسرار في","‏ ‏ قمم الجبال تبخرت وعلى الحجرْ",66,"ر",1,0],["لا أُمَّ تُلْقِيْهِ في يَمٍّ فَتَرْقُبُهُ ،","وأَلْفُ فِرْعَونَ خَلْفَ المَوجِ يَرْصُدُهُ",67,"د",2,0],["لا أملك اليومَ حتى في الهوى طمعا","وهل أعيش إذا ما مات وجداني",68,"ن",2,0],["لا أَمْطَرَتْ دِيَمُ الرَّبِيعِ بِسَاحتِي","إنْ لم أَحُلَّ بربعِها الممْطُورِ",69,"ر",1,0],["لا أمْنَ للشخصِ إنْ عاداهُ صاحبُهُ","لا وزنَ للمبتدا إنْ خانَهُ الخَبرُ",70,"ر",1,0],["لا أميل الميلَ كلاً أو مُجافي","بل أصافي قهرَ ليلِ الانشطارِ",71,"ر",1,0]]}