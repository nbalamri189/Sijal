{"poems":[[47,"لي حبيب قد لج في الهجر جدا","https://www.aldiwan.net/poem63498.html","الخفيف"],[50,"بمعودية الدين العتيقِ","https://www.aldiwan.net/poem66571.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[234,"إذا هب سلطان المريسي نافحا","https://www.aldiwan.net/poem51244.html","الطويل"],[309,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[353,"بك نور الدين أضحى","https://www.aldiwan.net/poem19838.html","مجزوء الرمل"],[443,"هي بشرى الإسلام والأيام","https://www.aldiwan.net/poem2569.html","الخفيف"],[454,"اللغة العربية","https://www.aldiwan.net/poem969.html","عموديه"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96676","الرمل"],[1073,"","https://poetry.dctabudhabi.ae/diwan/poem/105366","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136193","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136183","الرمل"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118122","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64586","الرجز"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114027","الرمل"],[1985,"","https://poetry.dctabudhabi.ae/diwan/poem/132431","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27447","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133939","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110110","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91089","المديد"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91068","الخفيف"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86510","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114050","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/136080","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77166","الوافر"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86449","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83569","الخفيف"],[4679,"يا محرقاً تلك النحيلة باللظى","https://www.poetsgate.com/ViewPoem.aspx?id=142765",""],[5226,"القدس .. في القلب","https://www.poetsgate.com/ViewPoem.aspx?id=24251",""],[5389,"عيد الجيش العراقي","https://www.poetsgate.com/ViewPoem.aspx?id=205377",""],[5720,"مَاذَا يُرِيْدُ الحَاقِدُونَ ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=200254",""],[6056,"كفيّ ، طوّ قت معصمه","https://www.poetsgate.com/ViewPoem.aspx?id=130137",""]],"verses":[["بِكَ نَستَعتِبُ اللَيالي وَنَستَع","دي عَلى دَهرِنا المُسيءِ فَنُعدى",0,"د",2,0],["بكنس الروم والشامات حتّى","وباللكامِ والدير الشهيقِ",1,"ق",1,0],["بِكِ نَزعَتِي نَحْوَ الْحِمَى","وَعَدَاكِ قَيْدِي فَانْزِعِي",2,"ع",2,0],["بِكنٍّ وكانونٍ وكَأسِ مُدَامةٍ","وكِيسٍ وكُسٍّ وافرٍ وكَباب",3,"ب",1,0],["بكنت له سمعاً إلى آخر النبا","عن اللَه في نص الرسول المثبت",4,"ت",1,0],["بِكَ نُور الدِّينِ أَضْحَى","مُشْرِقاً وَجْهُ رَجائي",5,"ا",3,1],["بك نهدى في كل أمر وآرا","ؤك تقضى في حلمنا والحرام",6,"م",1,0],["بك نحن الأمة المثلى التي","توجز القول وتزجي الجيدا",7,"د",2,0],["بكَ نَحسي صارَ سعداً وغَدت","بكَ أيّامي جميعاً جُمَعا",8,"ع",2,0],["بك ناظر الدهر الورى","فغدوت معدوم المناظر",9,"ر",1,0],["بك نلنا الخيرات والسر حقا","سركم في الوجود والكون ساري",10,"ر",2,0],["بك نستشفع يا خير الورى","في زوال الشر من بحر وبر",11,"ر",1,0],["بكني بظبي الرمل عنك مخافةً","من كاشح زاد الملام وما اختشى",12,"ش",2,0],["بكنه لا إله إلا اللّه","وكنه أسمائك عجل المدد",13,"د",1,0],["بِكَ نَرجو كَشفَ ما حَلّ بنا","مِن غلاءٍ وبَلاء وَنَكَد",14,"د",1,0],["بكن غضبا من قبلة نلته بها","فقلت له اقتصّ مني بها عشرا",15,"ر",2,1],["بكن وهو قول الله والأمر أمرُه","وقد جاء في القرآنِ معناه عنكمُ",16,"م",1,0],["بك نستجير ونستجيب وحبذا","أنت المجير لنا مجيب دعائه",17,"ا",3,0],["بكنيسةٍ وُصِفَت بوَحدةِ رأسِها","رأسِ الشُعوبِ بعيدِها والداني",18,"ن",2,0],["بِكَ نجّى اللَه أَهل الضلالا","ت وَأَهدى عابدي الأَصنامْ",19,"م",1,0],["بِكَ نام الأَنام تَحتَ أَمان","نَشرته الشَريعة الغَراء",20,"ا",2,0],["بكنه الأداني والأقاصي وأقبلت","على رمسه الأحياء في الموت ترغب",21,"ب",1,0],["بِكَ نُوحٌ نَجَا وَقَد طَمَّ يَمُّ","بِكَ سَامٌ سَما لِقَدرِهِ نَجمُ",22,"م",1,0],["بك نزلنا ما ترى من موضعِ","زدنا سروراً يا كريمُ مُبدعِ",23,"ع",1,1],["بكنه أَوصافِك حار الحَجا","فازَ الَّذي عَلق فيكَ الرَجا",24,"ج",2,0],["بك نهتدي لسبيل كل فضيلة","وعلى منالك نجتدي تعويلا",25,"ل",2,0],["بِكَ نَصري إِذا اِنتَصَرتُ وَحَسبي","رايَةُ النَصرِ رايَة نَبَوِيِّه",26,"ي",2,0],["بك نارَها أصلت ولا بدعٌ فقد","دل الدخان على وجود النارِ",27,"ر",1,0],["بِكِ نَحنُ نَمضي للسَّلامِ معاً","ودونَكِ لن يَسيرَ إلى السَّلامِ رِكابُ",28,"ب",1,0],["بك نالَ ابعدَ ذروةٍ للمجدِ بالنصر القريبِ","يا سيفَ عزتِهِ الذي مازَ الصدوقَ من الكَذوبِ",29,"ب",1,0],["بِكَ .. نورُ هذا الكونِ .. فيكَ محمدٌ","ذاكَ الذي .. أعطىٰ الحياةَ تفرُّدا",30,"د",2,0],["بكنترول الفكر قمت أجمعه وأرسمه","صورة ٍ في الخيال مطرّزه بالذهب",31,"ب",1,0]]}