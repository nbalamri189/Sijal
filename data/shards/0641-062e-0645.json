{"poems":[[9,"ما بكاء الكبير بالأطلال","https://www.aldiwan.net/poem21974.html","الخفيف"],[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[47,"رنو ذاك الغزال أو غيده","https://www.aldiwan.net/poem63505.html","المنسرح"],[47,"أترى الزمان يعيد لي أيامي","https://www.aldiwan.net/poem65674.html","الكامل"],[107,"أأفاق ظالم نفسه فأنابا","https://www.aldiwan.net/poem43091.html","الكامل"],[50,"دعني من الناس ومن لومهم","https://www.aldiwan.net/poem63425.html","السريع"],[52,"لا تحمدن أبا حرب بأسرته","https://www.aldiwan.net/poem64801.html","البسيط"],[52,"علليني يا عبد أنت الشفاء","https://www.aldiwan.net/poem64888.html","الخفيف"],[70,"شربنا على ذكر الحبيب مدامة","https://www.aldiwan.net/poem1525.html",""],[214,"أيا حسنا قد حاز كل فضيلة","https://www.aldiwan.net/poem13394.html","الطويل"],[264,"هذا كتاب أم بشير سعاد","https://www.aldiwan.net/poem35761.html","الكامل"],[280,"مرقوم الخد مورده","https://www.aldiwan.net/poem25586.html","المتدارك"],[371,"أنت العدو لأمر أنت جاهله","https://www.aldiwan.net/poem17801.html","البسيط"],[447,"عن المصطفى صلوا عليه وسلموا","https://www.aldiwan.net/poem14387.html","الطويل"],[447,"ألا إن كتب الأنبياء عليهم","https://www.aldiwan.net/poem14406.html","الطويل"],[591,"غنيت بالمحبوب عما يشتهى","https://www.aldiwan.net/poem17598.html","الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122598","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48754","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100998","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124744","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124721","الوافر"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124727","الطويل"],[2365,"","https://poetry.dctabudhabi.ae/diwan/poem/34713","الخفيف"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87325","الرجز"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65974","الطويل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103524","السريع"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112368","البسيط"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46034","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91315","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57952","الكامل"],[4550,"","https://poetry.dctabudhabi.ae/diwan/poem/107127","الكامل"],[5628,"الطرف الساهم","https://www.poetsgate.com/ViewPoem.aspx?id=178806",""],[5939,"غريبا أتيت","https://www.poetsgate.com/ViewPoem.aspx?id=204598",""],[5997,"جمر في ذاكرة الرماد","https://www.poetsgate.com/ViewPoem.aspx?id=214424",""]],"verses":[["فَخمَةً يَلجَأُ المُضافُ إِلَيها","وَرِعالاً مَوصولَةً بِرِعالِ",0,"ل",1,0],["فَخمَةً ذَفراءَ تُرتى بِالعُرى","قُردَمانِيّاً وَتَركاً كَالبَصَل",1,"ل",1,0],["فَخمٌ إِذا حَطَّتِ الوُفودُ إِلى","فِنائِهِ لَم يَضِق بِها بَلَدُه",2,"د",2,0],["فَخمٌ إِذا حَمَلَ السِلاحَ عَجِبتَ مِن","بَدرٍ تَأَلَّقَ في سَوادِ غَمامِ",3,"م",1,0],["فَخمِ المَواكِبِ ما يُبالي أَصبَحوا","راضينَ أَم باتوا عَلَيهِ غِضابا",4,"ب",2,0],["فَخَمرَةٌ أَنتَ لَهَ رابِحٌ","في حالَتَي يُسرٍ وَإِفلاسِ",5,"س",1,0],["فَخمٌ غَليظٌ يُطيفُ المُنعِظونَ بِهِ","إِذا تَجَمَّرَ مِن حادٍ وَمُنتابِ",6,"ب",1,0],["فَخمَةٌ فَعمَةٌ بَرودُ الثَنايا","صَعلَةُ الجيدِ غادَةٌ غَيداءُ",7,"ا",2,0],["فَخَمْر ولا كرْم وآدَمُ لي أب","وكَرْم ولا خَمْر ولي أُمُّها أُمّ",8,"م",1,0],["فخمر وان ما ذقت كوثر مائها","اميل كأني منه نشوان خمرة",9,"ه",1,0],["فخُمَت معانيه برقة لفظه","وقضى لمنشئه بطول أيادي",10,"د",2,0],["فَخَمائِلُه مُتَنزَّهُهُ","وجَدَاوِلُهُ مُتَوَرَّدُهُ",11,"د",2,0],["فخَمِّرِ الرَأيَ وَاِستَوضِح أَواخِرَهُ","فَالرَأيُ غَرّارَةٌ مِنهُ أَوائِلُهُ",12,"ل",2,0],["فخمس لعمري أسندت وهي بالقضا","وغير القضا ما ليس فيهن يحكم",13,"م",1,0],["فخمسون منها كتب شيث بن آدم","وإدريس منها بالثلاثين قد بُرّا",14,"ر",2,0],["فَخمْرهُ وَوَرْدُهُ وَآسهُ","مِنْ ريقِهِ وَخَدِّهِ وَصُدغِهِ",15,"ه",1,0],["فَخمِ الأصالةِ مَشهورِ البسالةِ مَر","ضيُّ العدالةِ مِثلَ البدرِ في النادي",16,"د",2,0],["فخم يمثل شعبه وبلاده","فوق الشعوب وحبذا التمثيل",17,"ل",1,0],["فخمُ الوقار يخِف عند أناته","رَضوى ويصغر ما أقل ثبير",18,"ر",1,0],["فخمسة أجزاءٍ زها كل نقطةٍ","دراهم من قدرِ البعير تنزلُ",19,"ل",1,0],["فخمسٌ بعد إحرامٍ وخمسٌ","وقد صليت ثم ركعتَ أخرى",20,"ر",2,0],["فخمسٌ وعشرون من أبٍ أخواته","وستٌّ من الجداتِ والخطبُ أشنعُ",21,"ع",1,0],["فَخمَةٌ عَبلَةٌ مَعَ العُنفِ وَال","رِقَّةِ زينَت بِبَهجَةٍ وَبَهاءِ",22,"ا",2,0],["فَخمسَةَ عَشَرَ أنتَ مُغزِرُ","والمُنجِيَ لا شكَّ فيه تُبصِرُ",23,"ر",1,0],["فخمس مئين تترك الحق معنقاً","وإلا ثلاث من رجال صعالك",24,"ك",1,0],["فخمرها من فوق أذقانها","وماؤها من فوق تيجانها",25,"ه",2,0],["فخمرَةُ اليأسِ لي وحدي أعاقرها","وخمرة الكأسِ بينَ النّاسِ للنّاسٍ",26,"س",1,0],["فَخم كَصَدرِ الرُّمحِ مُخضَلُّ الصبا","مَلَأَ الزَّمانَ مصابه استيحاشا",27,"ش",2,0],["فَخمش كفُّ النجمِ للَّيلِ وَجنةً","وَريعَ فَشابَت رَأسُه عِندَ صدعة",28,"ه",1,0],["فخميس العدى وإن قل عدا","ما استطاعوا إليه دفعاً وصدا",29,"د",2,0],["فخميسُ نجل مباركٍ","أهل السياسة والعطاء",30,"ا",2,0],["فخمول ذكري عاقني بالرغم عن","سيري إليك فسارت الأشعار",31,"ر",1,0],["فخمرتي من عالم ٍ آخر ٍ","تأمّلي في وجهك ِ الحالم ِ",32,"م",1,0],["فخمسونَ عامًا كخمسينَ يومًا","وأنت بحسٍّ نقيٍّ رزينْ",33,"ن",1,0],["فخمسةٌ لن يبيتوا دون سادسهم","وسابعٌ لم يجدْ مِنْ دونِهمْ دارا",34,"ر",2,0]]}