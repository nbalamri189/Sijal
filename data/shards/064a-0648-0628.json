{"poems":[[53,"يقول ابن عمار مقالة مخلص","https://www.aldiwan.net/poem9432.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85436","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54559","الكامل"],[147,"لصرف الليالي أن يصول ونخضعا","https://www.aldiwan.net/poem11777.html","الطويل"],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137341",""],[855,"","https://poetry.dctabudhabi.ae/diwan/poem/138858",""],[1183,"","https://poetry.dctabudhabi.ae/diwan/poem/18253","الوافر"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84488","الكامل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111275","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137095",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216818","الرمل"],[5413,"أسيرُ همومٍ","https://www.poetsgate.com/ViewPoem.aspx?id=201522",""],[5431,"رياض العاشقين ...","https://www.poetsgate.com/ViewPoem.aspx?id=207521",""],[5989,"خلي فؤادي ...","https://www.poetsgate.com/ViewPoem.aspx?id=181564",""]],"verses":[["يُوَبِّخُهُ إحسانه أو يُتِمُّهُ","وإن لم يكن في فعله بالمُوَبَّخِ",0,"خ",1,0],["يؤبنون حَكيماً في حفيرته","مغيَّباً زارها فاِختارها سكنا",1,"ن",2,0],["يُوبِيلُ شُكْرِي قَائِمٌ","وتَضِيقُ بِالْحَشْدِ الرِّحَابُ",2,"ب",1,0],["يُؤَبِّنُ مَن يُدلي بِأَدنى فَضيلَةٍ","فَكَيفَ بِمَن حازَ الفَضائِلَ أَجمَعا",3,"ع",2,0],["يوبيلُكِ الذهبُّي فاض شُعاعُهُ","في كل قلبٍ شاعرٍ بنداك",4,"ك",1,0],["يو به يالثارات ابن فاطمةٍ","شعار كل كَمِي طيّب العودِ",5,"د",1,0],["يَؤُبْنَ مع الركاب بكل مصر","ويأتين الأقاول بالسراتِ",6,"ت",1,0],["يوبُ المعاصي لا يزال مجدّداً","أبداً وثوب المكرمات مرقّعُ",7,"ع",1,0],["يوبخ أحياناً ويحلم تارة","ولا يضع التوبيخ في موضع الحلم",8,"م",1,0],["يوبيلك الذهبي اليوم قام له","جميع ابناء لبنان على قدم",9,"م",1,0],["يوبق السائل عن مسلكه","ويبيح الأمن من لا يسألون",10,"ن",1,0],["يُوبِّخُه من لمْ يُصبْه سهامُهُ","ويَحْسُدهُ من كانَ يهوى ويُكرمُ",11,"م",1,0],["يؤبّدُ في اقتصاص محرقيٍّ","فقد خان الأمانة منذ حين",12,"ن",1,0],["يؤبجد القول والأشعارُ تنطقه","في عشقك الشعرُ مزهووٌ بتفنيني",13,"ن",2,0]]}