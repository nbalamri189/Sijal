يونك / ساعة الشدة / نبيل",222,"ل",1,0],["وأن تركت حمى النقاش أرحني","اللّه حسبي وفيهِ حسن مختتمي",223,"م",2,0],["وأنت ربيع إن تسر سرت عاطرا","ورويت ظمآنا ونضرت زاويا",224,"ي",2,0],["وأنت رجاء الكل في كل مشكل","إذا ما دجا أمر تألقت هاديا",224,"ي",2,0],["وإنْ تريني طويلَ الصمتِ ذا فِكَرٍ","فليسَ ذلكَ بي عجزًا وتقصيرا",225,"ر",2,0],["وأنت ربي يحفظك عقب الكلام التالي","كان عندك صورتي قطّع عروق الصوره",226,"ر",2,0],["وإن ترفضْ رؤاي فلن تلاقي","سواها في فنونك مِن مفيدِ",227,"د",1,0],["وأنت ربُّ اختراعاتٍ ومنزلةٍ","تلهيك عن كسلٍ تقصيك عن حسدِ",228,"د",1,0],["وإنْ تَرَفَّعْتَ عَنْ هَذَا فَحَيِّ علَى","استِغْفَارِ رَبِّكَ تَلقَى اللَّهَ غَفَّارَا",229,"ر",2,0],["وإن تردد ذكرُ المصطفى سبَحتْ","حلاوة الذكر شهْدا في رياض فمي",230,"م",2,0],["وأنَّ ترنيمةً من صوتِها انسربتْ","ما وشوشتْ طائراً إلاّ وحنَّ لها",231,"ل",3,0],["وأن ترى ميسورة ٌ خبطاتها","منْ مرجٍ منشوطة ً أسيارها",232,"ر",3,0],["وأن تراحَ أذرعٌ وأسواقٌ","ناحلت العصيَّ من كلالها",233,"ل",3,0],["وأنت رقيقٌ فالمتينُ هو الله","وأنت خفي في ضنائن غيبه",234,"ه",1,0],["وإن تراقص في أحداقها شرر","أكون أول من يدنو فيكويني",235,"ن",2,0],["وإن تُرى قُطّعَتْ تلك الجُذُورُ فهلْ","تظلَّ تَعبقُ في ساحاتها الكُثُبُ",236,"ب",1,0]]}