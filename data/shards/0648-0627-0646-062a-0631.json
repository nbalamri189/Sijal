.ae/diwan/poem/58179","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58124","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72347","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120250","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120520","الطويل"],[4675,"المرجان في وصف الخلان","https://www.poetsgate.com/ViewPoem.aspx?id=201394",""],[4691,"تبارك قلبي حين تصفو منابعه","https://www.poetsgate.com/ViewPoem.aspx?id=211312",""],[4755,"بوسعِ الفوضويَّةِ أن تَشِيعا","https://www.poetsgate.com/ViewPoem.aspx?id=191361",""],[4767,"أعينيني","https://www.poetsgate.com/ViewPoem.aspx?id=87493",""],[4955,"دع الآثام واهجرها مليّا","https://www.poetsgate.com/ViewPoem.aspx?id=192490",""],[4955,"فقيرا كنت فيها أم غنيا","https://www.poetsgate.com/ViewPoem.aspx?id=200031",""],[4980,"حديث الطيف","https://www.poetsgate.com/ViewPoem.aspx?id=196794",""],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[5183,"حُلْو الهنا","https://www.poetsgate.com/ViewPoem.aspx?id=186422",""],[5183,"لفح الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=180226",""],[5183,"صفو الحب","https://www.poetsgate.com/ViewPoem.aspx?id=186608",""],[5198,"عيد العيد","https://www.poetsgate.com/ViewPoem.aspx?id=136235",""],[5216,"حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=187651",""],[5232,"قامة المجد","https://www.poetsgate.com/ViewPoem.aspx?id=213786",""],[5277,"مهدُ الورد","https://www.poetsgate.com/ViewPoem.aspx?id=185482",""],[5277,"صهيلُ الوتر","https://www.poetsgate.com/ViewPoem.aspx?id=186070",""],[5277,"أغنيتي","https://www.poetsgate.com/ViewPoem.aspx?id=188101",""],[5277,"فاطمة","https://www.poetsgate.com/ViewPoem.aspx?id=195091",""],[5277,"ربيعُ المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=211662",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5582,"هَذِي أُمَيْمٌ تَجَلَّى شَخْصُها وَبَدَا","https://www.poetsgate.com/ViewPoem.aspx?id=63503",""],[5596,"شمائل سمائل","https://www.poetsgate.com/ViewPoem.aspx?id=206377",""],[5596,"تقريض كتاب دالية المحقق الخليلي","https://www.poetsgate.com/ViewPoem.aspx?id=206711",""],[5606,"يالله إن الحكم بيديك والشكوى عليك","https://www.poetsgate.com/ViewPoem.aspx?id=194673",""],[5616,"حوت","https://www.poetsgate.com/ViewPoem.aspx?id=203472",""],[5616,"محمود","https://www.poetsgate.com/ViewPoem.aspx?id=203502",""],[5626,"يا زورق الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=189562",""],[5629,"صاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=184608",""],[5690,"ما بال نائحة الأغصان لم تنمِ","https://www.poetsgate.com/ViewPoem.aspx?id=172182",""],[5701,"ألا أيها النسر المحلق زرتنا","https://www.poetsgate.com/ViewPoem.aspx?id=164683",""],[5804,"لستُ مغرورًا ولكن","https://www.poetsgate.com/ViewPoem.aspx?id=214757",""],[5950,"شايف حالي ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128334",""],[5956,"وكنتُ أعي التوائي في الصعودِ","https://www.poetsgate.com/ViewPoem.aspx?id=186211",""],[5956,"الفخر بالابن فراس","https://www.poetsgate.com/ViewPoem.aspx?id=192387",""],[6031,"أوْفاتَّخِذْ لَكَ سِنداناً ومِطْرقَةً","https://www.poetsgate.com/ViewPoem.aspx?id=46347",""],[6148,"نبي الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=202058",""],[6190,"في موكب العطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87009&r=&rc=15",""],[463,"أولى لها أن يرعوي نفارها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60088&r=&rc=144",""],[463,"خفِّفْ بذات البان من أثقالها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60261&r=&rc=317",""],[2220,"إذا جاءتِ الأسماء يقدمُها الله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11859&r=&rc=728",""],[5164,"ذُلُّ الهَوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75663&r=&rc=17",""],[6318,"القدس في خطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66164&r=&rc=14",""]],"verses":[["وَإِن تَرَ لَيثاً لائِذاً لِفَريسَةٍ","يُراصِدُ غُرّاتِ المَقاديرِ مُطرِقا",0,"ق",2,0],["وَأَن تَرقُمَ الأَنواءُ تُربَكَ بَعدَها","بِكُلِّ جَديدِ النَورِ رَقمَ الكَواكِبِ",1,"ب",1,0],["وَإِن تَرَحَّلتِ عَن عَبسٍ فَلا تَقِفي","في دارِ ذُلٍّ وَلا تُصغي إِلى العَذَلِ",2,"ل",1,0],["وان ترك فالقاع بقيّا","فعلى راس نصُبّ",3,"ب",1,0],["وإن تربية الإنسان يرجعه","أكسيرها وهو من تربٍ إلى الذهب",4,"ب",1,0],["وأنت ربيعنا في كل محل","إذا المِهداة قيل لها العفيرُ",5,"ر",1,1],["وأنت ربيع الناس وابنُ ربيعهم","إذا لُقِّبت فيها السنون اللواحسا",6,"س",2,1],["وإن ترد وجنته المنيرة","فصغر النار على نويره",7,"ه",1,0],["وإن تُرفعْ جنوبُكُمُ ببُرءٍ","فما فيكم لفاحشةٍ رَكُوبُ",8,"ب",1,0],["وإن تركي حظاً من صحابته","لحاجة قرنت في النفس والأسف",9,"ف",1,0],["وأَنتَ رُوحٌ جميلٌ","بَيْنَ الهِضابِ الجديبهْ",10,"ه",1,0],["وَإِن تُرِد غَيّاً غَوى","أَو تَبغِ رُشداً رَشَدا",11,"د",2,0],["وَإِن تَرُمِ المَظاهِرَ في الحَياةِ","فَرُمها بِاِجتِهادِكَ وَالثَباتِ",12,"ت",1,0],["وَأَن تَرِدَ الماءَ الَّذي شَطرُهُ دَمٌ","فَتُسقى إِذا لَم يُسقَ مَن لَم يُزاحِمِ",13,"م",1,0],["وأنتَ رفعتَ الشَّعْرَ بعدَ انخِفاضِهِ","بجودكَ حتى صار في ذِروةِ الشِّعرى",14,"ا",1,0],["وَإِن تَراءَت في يَدي بَدرَةٌ","أَتلَفتُها في مَجلِسِ الأُنسِ",15,"س",1,0],["وأنت رضىً وتقبيلُ","وأنت ضنىً وحرمانُ",16,"ن",1,0],["وإن تَرَدّتْ من قبلنا أُمَمٌ","فهي نفوسٌ رُدّتْ عواريها",17,"ي",3,0],["وإنْ ترحلْ لنيلِ غنى فَسَهْلٌ","غناكَ هنا إذا أمسكتَ عاما",18,"م",2,0],["وإنْ ترحلْ تريدُ تمامَ جاهٍ","فمَهْ إني أحذرُكَ التماما",18,"م",2,0],["وإنْ ترحلْ رجاءً لاشتهارٍ","فكمْ منْ شهرةٍ توهي العظاما",18,"م",2,0],["وأنت ربيع الناس والجيش نازل","وأنت قريع الجيش والجيش راحل",19,"ل",1,0],["وأنْتَ رأيْتُكَ تُعطْى الألوفَ","فَتَنْهَبُ نَهْباً ولا تَقْتَسِم",20,"م",1,0],["وَأَنتَ رَبيعٌ يُنعِشُ الناسَ سَيبُهُ","وَسَيفٌ أُعيرَتهُ المَنِيَّةُ قاطِعُ",21,"ع",1,0],["وإنْ تُرِدْ ثانِيَهُ فهْوَ لا","يُذْكَرُ للسائِلِ كيْ يَفْهَمَهْ",22,"م",2,0],["وأن تراءت لك الحمراء عن كثب","فسائل الصرح أين المجد والجاه",23,"ا",2,0],["وأَنت ريحانه المهدي لنا أرجاً","جو العراقين من أرواحه عَطِرُ",24,"ر",1,0],["وَأَنْ تَرَوْهُمْ عَلَى الأَيَّامِ إِنَّكُمُ","بِالبِرِّ خلَّدْتُمُوهُمْ خَيْرَ تَخْلِيدِ",25,"د",1,0],["وإِن تَرَوا أمرَنا في رَأيكُمْ سَفَهاً","فَرَأيُ مَنْ خَالَفَ الإسْلاَمَ تَضليلُ",26,"ل",1,0],["وأن ترِدوا ما يمُجُّ القَذَى","وأنَ تَطْعموا منه ما يَجشُب",27,"ب",1,0],["وإنْ تَرَ مَصلحةً فاصدقنَّ","وإنْ لم تَجِدْ طائلاً فاكذب!",28,"ب",1,0],["وإن ترحلتِ منْ عبس فلاّ تقفي","في دارِ ذُلٍّ ولا تُصْغي إلى العَذَلِ",29,"ل",1,0],["وأنت روح جلت وهم العمى وعلت","قدراً وقد أسست للمجد تأسيسا",30,"س",2,0],["وأنت رتبة صدق دون رتبتها","كل المراتب حطت مثلما رفعت",31,"ت",1,0],["وإن تر البرق في الظلام مبترقاً","كأنه ثغرها في الليل يبترق",32,"ق",1,0],["وِإن تَرمِ المَكَارِمَ لَم تُصِبهَا","فَمِثلُكُ لِلمَكَارِمِ عَنهُ حَامِ",33,"م",1,0],["وان تر في بعض القضايا توقفا","فان نجاح السعي في ذلك الوقف",34,"ف",1,0],["وإن تره في فعله وصنيعه","تقل ليس بِدعا أن يسود عِصام",35,"م",1,0],["وإن ترسّلَ أدَى سحرُهُ خدَعاً","يُصفي إليهنَّ سمعُ الأعْصَم الوعِلِ",36,"ل",1,0],["وإن ترَ الهمَّ قاتلاً فرحي","فانظر كيف تبعثُ الفرحا",37,"ح",2,0],["وإن ترني فرداً وحيداً فإنما","تزيف إناثُ الطير للذكر الفرد",38,"د",1,0],["وَإِن تَرَي صَدرَكِ في خلجَةٍ","لَدى نِداءِ اللَذَّةِ الواجِده",39,"ه",1,0],["وَأَن تَرى عَيناهُ مِن فَوقِهِ","سِقفاً وَباباً دونَهُ موصَدا",40,"د",2,0],["وإن تُرخي النِّقاب عليه جاءت","إِليَّ الرِّيحُ بالأرجِ الشهي",41,"ي",1,0],["وإِن تُرِد عتابَهم","فَلا تُسئ خطابَهُم",42,"م",1,0],["وَإِن تَرى الهَجرَ سَهلاً","فَاللَهُ يوسِعُ سَهلِكَ",43,"ك",1,0],["وَإِن تُرِد دارَ البَقاءِ بِسِوى","بَني نُمَيرَ الفازِينَ لا تَدُر",44,"ر",1,0],["وَاِن تَرد منتهاها","أَعيتك وَالصَمت أَسلَم",45,"م",1,0],["وإن ترغب وصايا الله تَمدَحْ","وصيَّتَه على كل الوصايا",46,"ا",3,0],["وإن ترد صاح تحمد","في هذه الدار فازهد",47,"د",1,0],["وإن تُردْ أن تَرَى فؤادي","وما الَّذي فيهِ من ودادِكْ",48,"ك",1,1],["وإن تَرْوِ عني ما سمعت فاروه","بحدثنا الشيخ المشافه من فيه",49,"ي",2,0],["وإن ترد النصيحة بعد هذا","فألق دلاك في البحر العباب",50,"ب",1,0],["وإن ترم قنصة منها معجلةً","تمرُّ كالبرق إذ تنقض مرسلة",51,"ه",1,0],["وإنْ تَرَدَّتْهُما عِطْفاكَ يَوْمَ رِضاً","فَذَاكَ خَاتِمُكَ الأسنى وذَا قَلَمُكْ",52,"ك",1,0],["وأَنْتَ رَكزْتَ الملك فِي الأَرضِ مثلَما","يُثَبِّتُ فِيهَا ذُو الجلالِ وَمَا يمحُو",53,"ح",2,0],["وأنت رؤوف بالعباد مهيمن","وبالمذنب اللاجي إليك كريم",54,"م",1,0],["وأن تراحَ أذرعٌ وأسوُقٌ","ناحلت العِصيَّ من كَلالها",55,"ل",3,0],["وان تركب النجم ظهراً إلى","مناك ولي أمل راجلُ",56,"ل",1,0],["وأن تَرَى عينُك العليَّةُ من","تحت شَغافي نصيبَك الوافرْ",57,"ر",1,0],["وأن تُرى ميسورةً خبْطاتُها","من مَرَحٍ منشوطةً أسيارُها",58,"ر",3,0],["وإن تربت كفّ الديار من الحيا","وهبتُ مغانيها الغنى قبل وبلهِ",59,"ل",2,0],["وأنت رجائي إن دهمت ومقصدي","وركني إذا اغتالت قواطع نفسيه",60,"ي",2,0],["وإِنْ ترَ المُطيعَ فاقْبِضْ ذيلَهُ","وفارِقَنْ وجهاً وقلباً من عَصَى",61,"ا",1,0],["وإن ترد صبري إلى قابل","صبرت مختاراً إلى قابل",62,"ل",1,0],["وَأَنتَ رَؤوف وَالمَراحم تَقتَضي","إِغاثة مَن يَرجوك يا خَير مُرسلِ",63,"ل",1,0],["وإِنْ تَرَضَّى عَنِ الأَصْحابِ بَيْنَهُمُ","قَالُوا لَهُ باغِضٌ للآلِ مُجْتَهِدُ",64,"د",1,0],["وأنتَ رأسٌ يقيمُ الأنبياءُ بِهِ","ويحملونَ على أكتافِهِ، المِحَنَا",65,"ن",2,0],["وَإِن تَركَبوا أَثباجَ كلِّ منيفةٍ","فَكَم حُطّ مِن فَوقِ العَليّةِ راكبُ",66,"ب",1,0],["وإن ترحَّل لا شيء ترى معه","مثل الذي حاز في التجريد تمكينا",67,"ن",2,0],["وإن تركت لبه في قشره","فالقمر الأبيض بسام الفم",68,"م",1,0],["وأنت روض","وهم نسائم",69,"م",1,0],["وإن ترد تعرف الله الذي ظهرت","آياته فاتبع الأصحاب والرُفقا",70,"ق",2,0],["وإن ترد أوضح الأمثال أجمعها","فانظر إلى صفحة المرآة مستبقا",70,"ق",2,0],["وأنت رفيقي لا رفيق سواك لي","وإن أنا عن إيفاء حقك قاصر",71,"ر",1,0],["وإن تروا عصيانة موسعا","فقد نقضتم ما جعلتم أجمعا",72,"ع",2,0],["وأَن تُرى من فَرَقٍ شاحباً","فالسيفُ قد يصدأُ بَعْدَ الجِلاَ",73,"ل",2,0],["وإن ترد نهج هذا العلم تسلكه","أو رمت يوماً لم قد قلت برهانا",74,"ن",2,0],["وان ترم خيرَ برهان لقوليَ ها","مقطماً قد رسا طوداً ومقتطفا",75,"ف",2,0],["وإن تريد نقول لك الحق","تم شي آخر ما يوصف",76,"ف",1,0],["وأن تُرخي الحِجابَ وأن تَقَرِّي","ولا تَتَبَرَّجي للناظرِينا",77,"ن",2,0],["وإن ترع فلما وشكياً له نظرت","من حطها بصدور القوم واللبب",78,"ب",1,0],["وإن ترد نظرة تحظى بها أدباً","فانظر إلى وجهه واستحضر الأدبا",79,"ب",2,0],["وَأَنتَ رِياضٌ واحد العَصر في الذَكا","وَنجمُك في أُفق الفَراسة كَوكَب",80,"ب",1,0],["وإن تراها سددت أقوالها","كان على حمل العلى أقوى لها",81,"ل",3,0],["وإن تروا بدلاً منها محالفة","فمن لنا بضمانات المساوينا",82,"ن",2,0],["وإن تروا حلل الفولاذ سابغة","على الجنود فلا تبهركم الحلل",83,"ل",1,0],["وَأَنتَ رَفيقُ الصبِّ في حينِ وَصلهِ","وَحين الجَفا فَالحق فيكَ اِهتمامُهُ",84,"م",2,0],["وَأَنتَ رَسولُ اللّهِ أَكرمُ مُرسلٍ","وَأَنتَ حَبيب اللَّه رَبِّ السماءِ",85,"ا",2,0],["وَأَنتَ رَسول اللَّهِ طبَّ قُلوبنا","وَأَنتَ لَها مَولاي خَير دواءِ",85,"ا",2,0],["وَإِن تَرى الشابَةُ شَعراً أَبيَضا","يَرعى السَواد رَعي نيران الغَضى",86,"ض",2,0],["وَإِن تَرُم فَحوى المَعاني الجَزله","فَالعزُّ مَعقود بِعَين العُزله",87,"ه",1,0],["وَإِن تَرم لِلنُزول شَيئاً","عِندك دَلوٌ عَلَيهِ فَاركب",88,"ب",1,0],["وَإِن ترم خَيرَ امرئٍ لِيتبَعَك","فَاِفعل كَما يَفعَلُ بِالخَير مَعَك",89,"ك",1,0],["وإنْ تركتُ شراعي تائهاً فلقد","تركتُ ناصيتي في قبضةِ الحُتُفِ",90,"ف",1,0],["وأن ْترضى بداجيةٍ","تُطيل ُظلامها الفِتَن ُ",91,"ن",1,0],["وَأَن تَرَنا هَزلَى فَأَعراضُنا لَنَا","مُوَفَّرَةً مِمن يَجُودُ وَيَبخَلُ",92,"ل",1,1],["وَإن تروحُ وإن تغدو قساورهُ","فيه فرائس بينَ الضأنِ والغنمِ",93,"م",1,0],["وأنت رفيق الخيال رفيقي","رفيق المنى والجهاد الأشد",94,"د",1,0],["وان ترم أن تعتنى منها جُهُ","ادخر به من كلَّما تحتاجُهُ",95,"ه",1,0],["وإن ترى شياً كذا فالقطهُ","في ملقطٍ وخارجاً اسقطه",95,"ه",1,0],["وإِنْ تَراجَعْتُمْ إلى غَدْرِكمْ","عُدْتُ إِلى مَعْهودِ إِعْراضي",96,"ض",2,0],["وَإِنْ تَرَّجيْتُهُمْ لَمْ أَدْرِ مِنْ طَرَبي","رُوحُ الأَمانِيَ لِيْ أَوْ نَشْوَةُ الرَّاحِ",97,"ح",1,0],["وان ترد نيل ما نالوا فجد كما","جدوا ورابط وصابر ان ترد تصب",98,"ب",1,0],["وأنت روض الشباب إن نضبت","عيونه بالدموع أمطره",99,"ر",2,0],["وَأَنتَ رب قينة وزق","وَلَست للملك بمستحق",100,"ق",1,0],["وان ترم في الحال حبراً طيبا","وهو الذي يدعونه المركبا",101,"ب",2,0],["وان ترطب جَمعَها ذَيِّل كما","خسفتَه لذاتِ بَسطٍ عُلما",101,"م",2,0],["وإن تركب قس على قد قدِّما","من وضعها على اختلاف قسما",101,"م",2,0],["وان تركب اولا فانظر الى","ما كان بعد فال له تلا",101,"ل",2,0],["وَأَنْتَ رَعاكَ اللهُ فينا فَإِنَّما","مَدَحْتَ بِفَضْل ضِعْفُهُ فِيكَ يُوْجَدُ",102,"د",1,1],["وإن تَرِأسَ اولاني مباعدةً","وضنَّ عني بالتسليم والنَّظرِ",103,"ر",1,0],["وان تركب التيب مهزولة","وتوسعها في الترامي مغارا",104,"ر",2,0],["وإن تربت يداي بمدح قوم","به غلب القضاء على مرادي",105,"د",2,0],["وأنت رجاء جناحي المهيضِ","وأَنت الأماني مُدامُ العقولْ",106,"ل",1,0],["وإنْ تراءى لها السُّلوانُ طَالَعَها","ضَنْكٌ من العيشِ سلَّ الروحَ والجسدا",107,"د",2,0],["وإن تر شعباً بالجهالة سابحاً","فقل لعداه رمد الضأن ريق",108,"ق",1,0],["وإن ترمني الأقدار منها بحادث","تلقفه عني على الروح والجسم",109,"م",1,0],["وإن تربت كفي تجود بروح","مخافة مالم أحتمله من العدم",109,"م",1,0],["وإن ترسلٍ خلنا في مجاجته","أرى الجنى شيب من ماء العناقيد",110,"د",1,0],["وإن تركو صرعى فكم لهم علا","مقام على السبع السماوات شامخ",111,"خ",1,0],["وأنت ربيعي يا ربيع ومربعي","بمولودك الأسمى استدام لنا البشر",112,"ر",1,0],["وإن تركب النيب مهزولة","وتوسعها في الترامي مغارا",113,"ر",2,0],["وإن ترد نسبي للأم والدها","من آل بيت كسيرات ذوي الحسب",114,"ب",1,0],["وإن ترتد بعد ظهار زوجٍ","فتنكح غيره من أهل دين",115,"ن",1,0],["وان ترحل فلا اخطأت غنما","وشيعك المهيمن بالسلامز",116,"ز",1,0],["وإن تردَّت بتربٍ فيك أعظُمهُ","فكم لها في جنان الخُلد من رَدَن",117,"ن",1,0],["وَأَنتَ رَبيعُ الناسِ بِرُّكَ واصِلٌ","وَعِرضُكَ مَوفُورٌ وَمالُكَ مَوهُوبُ",118,"ب",1,0],["وإن تروا تلفي حتماً فدونكم","وحبّذا تلفي إذ كنتم السببا",119,"ب",2,0],["وإن ترد راحة لا تحسدن أحداً","والصمت فيه شفا من وصمة السقم",120,"م",1,0],["وإن ترد رفعة في منهج حسن","فبالتواضع ترقى هامة القمم",120,"م",1,0],["وأَنت رَخِىُّ البال بين مَعازفٍ","وخَمْرٍ وطِيبٍ فائِقٍ وقِيانِ",121,"ن",1,0],["وإِن ترنَّمَ قُمْرِيٌّ على فَنَنٍ","أبكى الحمامَ بأشتاتٍ من النغمِ",122,"م",1,0],["وإن تر في المذبوح في البطن ميتة","تحلّ وحبّ الروث حرّم بأوكد",123,"د",1,0],["وأن ترد موردا اصداء نهلته","مهلا ستشكو الصدى منه من الصدر",124,"ر",1,0],["وأن ترى منهدماً دعامه","وأن ترى منسلباً كرامه",125,"ه",1,0],["وَإِن ترمقوا الشرقيَّ شَزراً فَإِنَّهُ","لَذو أَعيُن خَزراء يرمقنكم شَزراه",126,"ر",3,0],["وَإِن تَرمِكَ الغُربَةُ في مَعشَرٍ","قَد جُبِلَ الطَبعُ عَلى بُغضِهِم",127,"م",1,1],["وان ترنح وماد وان تمايس ومال","كقدّك الفوفلي في اللين والاعتدال",128,"ل",1,0],["وَإن تُرِد أيَا أخي المَيَّان","أو راسَ عَمروٍ قَصدُهُ بَيَان",129,"ن",1,0],["وَإن تريدِ الغَوصَ فَالإكلِيل","جُزرُ قَطَر تاتيكَ بالتَّعدِيل",129,"ل",1,0],["وَإن تُرِد نَتخَاتِ رأسِ مَدوَرَا","أو رأسِ خَلفَ مَنتَخاً مُقَرَّرَا",130,"ر",2,0],["وَإن تُرِيد في مُنِير الحُجرَه","وَإسمُهَا الإكليلُ ثُمَّ القِدرَه",130,"ه",1,0],["وَإن تُرِد نَتخَةَ دَندَباشي","وَسَاجرٍ فَمَا عليكَ باسِ",130,"س",1,0],["وَإن تُرِد نَتخَةَ جَردَفُونِ","أوساطِهُ فالجاهُ يا مُعيني",130,"ي",1,0],["وَإن تُرِد جاهَ ثلاثٍ مَنتَخَا","مِن كُلِّ برٍّ يا خليلي فآنتَخَا",130,"خ",2,0],["وإن تَرَ المرماء والجديرَا","إجرِ على الناقَةِ كُن جديرَا",131,"ر",2,0],["وإن تَرَ القصيرَ والنُّعمانُ","كلُّهمُ بمصرَ لَم يبينوا",131,"ن",3,0],["وإن تُرِد منه إلى حافوني","في مطلعِ السُّهَيل باليقينِ",131,"ن",1,0],["وإن تَرَ فيهِ البرَّ فَهوَ مَصِيرَةٌ","فَكُم مَركَبٍ عدَّى وراح فحاذر",132,"ر",1,0],["وإن تَرَ الشَمسَ ببرجِ الثورِ","مايَه وَخَمسينَ فَإسمَع شوري",133,"ي",1,0],["وإن ترى نجمين إستَقلاَّ","عَن حِسبِةِ القياسِ لا تَخَلاَّ",134,"ل",2,0],["وإن تُرِد تفصيلَ قَلعِ المركبِ","فأتِ به في موضعٍ منسحبِ",134,"ب",1,0],["وإن تُرد تَعرِفَ جَريَ الماءِ","وكَونَهُ في الباحة الكبرء",134,"ر",2,0],["وإن تُرِد تَلزَمَ فَردَ مجرى","مِن حدِّ سَنجافُورَ أُخرُج بَحرَا",135,"ر",2,0],["وإن ترى شَمسَانَ نَحوَ الحجبَه","أُقرُب وخُذ جَوَاشكَ المُجَرَّبَه",136,"ه",1,0],["وإن تَرَ الشِّعرَى بجاهِ إصبَعِ","أَربَعَةً والنَّسرَ خَمساً كُن وَعَي",136,"ي",1,0],["وإن تَرَ الواقَع سَبعاً مُحتَكِم","فأنتَ على البرِّ على شَرعِ العَلَم",136,"م",1,0],["وَإن تُرِد نَتخَةَ جَردَفُونِ","جَاهَ أربَعٍ ورُبعِ بالتمكينِ",136,"ن",1,0],["وإن ترى للواقعِ سَبعَه","فالجاهُ والذراعُ أربَعَه",136,"ه",1,0],["وَإن تُرِد مِنهَا إلى الجزايِرِ","في القُطب أمَّا عَدَنٌ في الكاسِرِ",137,"ر",1,0],["وَإن تَرَ الأكدَافَ قَد إرتَفَعَا","أنتَ مِنَ المَسكَنِ زَيلَعَا",137,"ع",2,0],["وإن تُرِد أن تَعرِفَ الساعاتِ","على غروبِ البَدرِ والطلعاتِ",138,"ت",1,0],["وإن تُرِد تَعمَلَ بالمَنازلِ","في طالعٍ أو وَتدٍ أو آفِلِ",138,"ل",1,0],["وإن تَرى المندلَ بَعدَ الظُّهرِ","فأَّوَّلُ الرِّيح عِندَ أَهلِ الخُبرِ",138,"ر",1,0],["وإن تَرَ البرقَ بوجهِ اليمِّ","فحكمُهُ كَحُكمِ حرِّ النجمِ",138,"م",1,0],["وإن تُرِد أيا أخي ملاحَا","خُذِ المغيبَ تَلتقي الصلاحَا",139,"ح",2,0],["وإِن تُرِد معرفةَ الباشيِّ","فاسمَع حديثاً من ثِقَه ذكيِّ",140,"ي",1,1],["وإن تُرِد لِسَجدَ أرفُوري","تُسمَى بأرضِ إسمَع شَوري",141,"ي",1,0],["وَإن تُرِد تَدخُلَ مَنجَلُورَا","شَيِّع قليلاً لِتَرى السُّرُورَا",141,"ر",2,0],["وَإن ترى جُلنَارَ في العَيُّوقِ","أنتَ بِشُورَوَارَ يَا رفيقي",141,"ي",1,0],["وَإن تُرِد شُهُودَ ذي المَكَانِ","سُهَيلُ وَالظَّليمُ يا إخوانِي",142,"ي",1,0],["وَإِن تَرَى كُثرَ طُيُورِ المٌنجي","إحذَر مِنَ البَرِّ تَفُز بالفًَرَج",143,"ج",1,0],["وَإن تَرَاخَيتَ بِرِاسِ المَارِزَه","يَوماً بِيَومَينِ إلى المُجَاوَزَه",143,"ه",1,0],["وَإن تُرِد زِيَادَةً فَخُذهَا","على طَريقِِ البرّ وَاستَفِدهَا",143,"ه",2,0],["وإن تَرَ النَّعشَ أَصَابع خَمسَا","غَرَستَ ذَا يَانِعمَ هذا غَرسَا",143,"س",2,0],["وَإن تُرِد سُهَيلَ وَالظَّلِيمَا","هُنَّ كَمِثلِ الجَاهِ يا عَلِيمَا",143,"م",2,0],["وإن تُرِد شُهودَ في هذا الطَّرَف","هُنَا قِياسٌ لا يَخُونُ مُعتَرَف",143,"ف",1,0],["وَإِن تُرِد مِن كِلوَةٍ سُفَالَه","فَدِيرَةُ البَرَّ بِلاَ مَحَالَه",143,"ه",1,0],["وَإن تُرِد مِن كِلوَةِ الطَّرِيق","في البَاحَةِ الكُبرى على التَّحقيق",143,"ق",1,0],["وإن تَرَ النَّيروزَ مِنه قَد مَضَى","عشرونَ يوماً بَل أَقَلُّ وانقَضَا",144,"ض",2,1],["وإن ترى الواقعَ اصبعينِ","فالسلَّبارُ القطبُ رأيَ العينِ",144,"ن",1,0],["وإن ترى الآفاق غابت شمسها","فما لشمس أفقه مغيب",145,"ب",1,0],["وإن ترد دليل وحدانيته","فهاكه يزهو ببرهانيته",146,"ه",1,0],["وإن ترد أدلة الأحوال","في المعنويات على التوالي",146,"ي",1,0],["وأنت ربيعها في كل محل","إذا المهداة قيل لها العفير",147,"ر",1,1],["وإن ترحَّلت عن قومٍ وقد قدروا","أن لا تفارقهم فالرَّاحلون همُ",148,"م",1,0],["وإن ترم عالما رحبا تسوح به","أغناك عن أفسح الأكوان أفسحه",149,"ح",2,0],["وإن ترم عند انتزاع ثوبه","فاس عليه بيدي خزور",150,"ر",1,0],["وإن تركتهها فمكرة","أخاك حقا لا بطل",151,"ل",1,0],["وَإِن ترد مثاله في النَحو","في سيبويه الفَرد فانظر نحوي",152,"ي",1,0],["وان ترد حقيقةً للفظ جاز","فذاك وجه خلفها مع المجاز",153,"ز",1,0],["وَأَنتَ رَأسُ قُرَيشٍ وَاِبنُ سَيِّدِها","وَالرَأسُ يُجعَلُ فيهِ السَمعُ وَالبَصَرُ",154,"ر",1,0],["وإن تركتني سورة الكأس عابساً","أهاب لظاها سوغتها تبسما",155,"م",2,0],["وان ترم مسح نجو بالحجارة خذ","وامسح ثلاثا فان انقيته فقم",156,"م",1,0],["وان ترم لمنام قم بلا كسل","الى الطهارة واسبغها بماءهم",156,"م",1,0],["وان ترم لبس مصبوغ فلا حرج","في الحمر والخضر والمسكي وغيرهم",156,"م",1,0],["وان ترم عود وطىء او تنام فقم","الى الوضوء وعد عمد الى الحلم",156,"م",1,0],["وان تر الخير فانشر ذكره فإذا","ما خلت ضدا فلا تهتك لسترهم",156,"م",1,0],["وأنت رجاء القطر بل ذخر أهلهِ","فدُم لبلادٍ ترتجيك وتقصدُ",157,"د",1,0],["وأنت روحي بها احيا فواحرَبا","كيفَ المَسير بلا قَلبٍ وَلا روحِ",158,"ح",1,0],["وإن ترفع الوضعاء يوماً","على الرفعاء من إحدى الرزايا",159,"ا",3,0],["وإن ترد غير هذا","فللتجني تهيا",160,"ي",2,0],["وإن ترى حيوانا وسط زرعك فا","قصد صرفه عنه واتركه إذ قفلا",161,"ل",2,0],["وإن تردى بينهم قتيل","فذاك شيء أرشه قليل",162,"ل",1,0],["وَأَنتَ رَهينٌ بِالحِجازِ مُحالفُ","بِجَونٍ سَرى دَهمُ المَطِيِّ وَما يَسْري",163,"ر",2,0],["وإن ترْم سرور أمٍ أو أبِ","يوما فكسْبُ العلم خيرُ مكسبِ",164,"ب",1,0],["وإنْ تُرْقِيا ريبَ المنونِ وتُقْدِما","على جعفرٍ تَسْتوجِبا خيرَ مَقْدَمِ",165,"م",1,0],["وَان تَروي الحَديث عَلى اِناسٍ","فَراعِ الصِدقَ في تِلكَ الرِوايَه",166,"ا",3,0],["وَاِن تَرُم تَصحيف نِصفٍ لَهُ","فَيا لِمَكروه بِدون اِرتِياب",167,"ب",1,0],["وَاِن تَرُم مَوتَ عَذّالٍ بِلا سَبَبٍ","عَظم لَدَيهِم مِن المَحبوبِ اوصافا",168,"ف",2,0],["وأنت رويبة قد تعلمين","فَضلتِ النساءَ بضيق وحَر",169,"ر",1,1],["وَإن تُرِد بَعضَ الَّذِى مِنهُ بُنِى","تُضِف إليهِ مِثلَ بَعضٍ بَيِّنِ",170,"ن",1,0],["وَإن تُرِد جَعلَ الأقَلِّ مِثلَ مَا","فَوقَ فحُكمَ جَاعِلٍ لهُ احكَما",170,"م",2,0],["وَأَنتَ رَأسٌ لِأَهلِ الدينِ مُنتَخَبٌ","وَالرَأسُ فيهِ يَكونُ السَمعُ وَالبَصرُ",171,"ر",1,0],["وإن ترى في الشعر ما قاله ال","أول للتالي وقد بلّغه",172,"غ",2,0],["وإن تروا صفح ذنبي منكم كرماً","فذاك أحسبه من لذة النعم",173,"م",1,0],["وَإِن تَرد راحتي نَفسٍ وَجارحةٍ","فَليستوي السابيان الشَّينُ وَالحسن",174,"ن",1,0],["وَإِن تَرى بيَ حالاتٍ وَتُنكرُها","فاعرض وُقِيتَ النَوى إِيّاك من عَذَلي",175,"ل",2,0],["وَإِن تُرِد تَتَّقي مِن صَرفهِ نُوَباً","فَالجأ لِظل عِمادِ الدينِ تَستَترِ",176,"ر",1,0],["وإن ترد عتابهم","فلا تسيء خطابهم",177,"م",1,0],["وإن ترد الوعظ الذي إن عقلة","فإن دموع العين عنه جواب",178,"ب",1,0],["وإن ترى الممكنة المربوطة","مع الضرورية والمشروطة",179,"ه",1,0],["وإن تُردِ مثلهُ حُسناً وبهجته","بعصرِهِ في الحسانِ الغُرِّ لم تجدِ",180,"د",1,0],["وأنت ربي تهب","تأمينه إذ يرهب",181,"ب",1,0],["وإن ترد لكمال العز مرتفعاً","هِ كالسحاب هياه هوه هي هينا",182,"ن",2,0],["وَإِن تَرَرَصتُ وَزَفسُ الأَعظَمُ","بَدَّدَ قَومي فَمَصيري أَشأَمُ",183,"م",1,0],["وأنت رح وانظرح من فوق ركبته","وسله رفقاً عسى يصغي لما تسل",184,"ل",1,0],["وأنت رهين الحمام عسى","أصيبك مهما حشاك عسا",185,"س",2,0],["وإن ترُم ثانيَه فهو في","رأس الحِجى المطلوب والمستفاد",186,"د",1,0],["وإن ترُم ثالثَه تلفَه","أوائل المستمطرات العهاد",186,"د",1,0],["وإن ترم رابعه فهو قد","بدا لرائيه باقصى النجاد",186,"د",1,0],["وإن ترُم رُبعَيه دم قالباً","لنصفه تظفر بعين الرشاد",186,"د",1,0],["وأنت ربيع أفضال وفضل","لكل الناس قد لذ الجنى بك",187,"ك",1,0],["وإن ترى ركباً بوادي الحمى","فأنشدهم عني ومن لي بذاك",188,"ك",1,0],["وَإِن تَر ثمّ تَقصيراً أَتاهُ ال","مُقَصِّر قل له عجِّل بِأَوبك",189,"ك",1,0],["وإن تُرِدْ علامةَ الإدبار","فسوءُ تدبيرٍ بلا اعتبارِ",190,"ر",1,0],["وإنْ تَرَني للظالمين مكثِّرا","سوادَهمُ أسعَى بسيفٍ وذابلِ",191,"ل",1,0],["وأنت رن يجير المستجير به","وأنت حصن لمن من دهره فزعا",192,"ع",2,0],["وان ترك الحمام قميصه لي","فذاك قميص يوسف لا يؤوب",193,"ب",1,0],["وان ترتع الارآم ارام انسها","على بسط الزهر المنوع تشكيلا",194,"ل",2,0],["وإن ترد الحياة بغير بؤس","فكن عبدا لرب في السماء",195,"ا",2,0],["وأنتَ رعا