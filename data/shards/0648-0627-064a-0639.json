{"poems":[[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[53,"أيركب عمرو حوله من يحفه","https://www.aldiwan.net/poem64606.html","الطويل"],[63,"هم صرموا حبل الهوى فتصرما","https://www.aldiwan.net/poem51445.html","الطويل"],[51,"كأنني بالديار قد خربت","https://www.aldiwan.net/poem10390.html","المنسرح"],[52,"أأحزنك الألى ظعنوا فساروا","https://www.aldiwan.net/poem63810.html","الوافر"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16640","الطويل"],[148,"مالي باب سوى رحابك","https://www.aldiwan.net/poem4460.html","مخلع البسيط"],[190,"العقل معدوم فلا عقل","https://www.aldiwan.net/poem43475.html","السريع"],[257,"لنا التهنئات وفرط الجذل","https://www.aldiwan.net/poem1435.html",""],[285,"أظن الدهر جاءك مستثيرا","https://www.aldiwan.net/poem60698.html","الوافر"],[445,"أرحلي محمول على العتق النجب","https://www.aldiwan.net/poem34886.html","الطويل"],[449,"عوذت بالله إمام العصر","https://www.aldiwan.net/poem56033.html","عموديه"],[458,"أصار مثلي عارا أم غدا خطرا","https://www.aldiwan.net/poem61605.html","البسيط"],[466,"سل الحي عني هل أناخت خسيفة","https://www.aldiwan.net/poem15293.html","الطويل"],[520,"لو اطلعت على سري وإضماري","https://www.aldiwan.net/poem12126.html","البسيط"],[556,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"],[572,"بوسى الليالي عقيبة النعم","https://www.aldiwan.net/poem69515.html","المنسرح"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122560","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86758","الطويل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137635",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63836","المنسرح"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59779","الطويل"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/121069","الطويل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137866",""],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80015","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125408","المتقارب"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71053","الطويل"],[2705,"","https://poetry.dctabudhabi.ae/diwan/poem/128678","المجتث"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116515","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134001","الطويل"],[3092,"","https://poetry.dctabudhabi.ae/diwan/poem/216356","الكان كان"],[3266,"","https://poetry.dctabudhabi.ae/diwan/poem/198810","الطويل"],[3269,"","https://poetry.dctabudhabi.ae/diwan/poem/146408","البسيط"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112672","الرجز"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48442","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91699","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91772","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131030",""],[4425,"","https://poetry.dctabudhabi.ae/diwan/poem/22586","المنسرح"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139696",""],[4912,"ا تخطون إلى خطء ولا خطأ","https://www.poetsgate.com/ViewPoem.aspx?id=181776",""],[5328,"أغنية الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=212232",""],[5956,"أول بانيَيْن للكعبة إبراهيم وابنه إسماعيل","https://www.poetsgate.com/ViewPoem.aspx?id=192497",""],[5956,"مفاتيح الدخول إلى بلادي العربية","https://www.poetsgate.com/ViewPoem.aspx?id=192786",""],[4222,"أهدى النسيم لنا ريا الرياحين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52910&r=&rc=202",""]],"verses":[["وأيُّ عِمَارَة كَالحَيِّ بَكر","إِذَا مَا البِيضُ زَايلَتِ الجُفُونَا",0,"ن",2,0],["وإيعادُهُ إياي منه وقد صفتْ","ظلالي ولم تُذمم سَجاياه في غرسي",1,"س",2,0],["وأَيَّ عُقودٍ خُضْتُ سبعةَ أبحُرٍ","لجَوْهَرِها المَنْثورِ حتى تَنَظَّما",2,"م",2,0],["وَأَيُّ عَيشٍ وَالعَيشُ مُنقَطِعٌ","وَأَيُّ طَعمٍ لِلَذَّةٍ ذَهَبَت",3,"ت",1,0],["وَأَيُّ عَدُوِّنا نَأتيهِ إِلّا","تَهِمُّ بِحَربِهِ لا نُستَطارُ",4,"ر",1,0],["وأيُّ عَظيمٍ رابَ أهْلَ بلادِنا","فإنّا على تَغْيِيِرِهِ قُدَراء",5,"ر",3,0],["وأي عبد إليك يسعى","ولم يفز منك بالثواب",6,"ب",1,0],["وأي عقل صحّ من عاقل","يحتاج في فعل إلى عذل",7,"ل",1,0],["وَأَيُّ عَظيمٍ وَمُستَكبِرٍ","إِلى جَنبِ مَجدِك لا يُستَقل",8,"ل",1,0],["وَأَيُّ عَواصِفِ الأَرْواحِ يَوْماً","تَهُبُّ فَتُقْلِقُ الطُّوْدَ الْوَقُورا",9,"ر",2,0],["وأَيَّ عَرُوسٍ بالسِّيادَةِ لم يَسُقْ","سوي السيفِ من مَهرٍ إِليها وَلا خَطبِ",10,"ب",1,0],["وأي علم ليس فيه يجري","جرى كريم سابق في الكر",11,"ر",1,0],["وأى عذرٍ لشعبٍ لم يثر أنفاً","من راكبيه وهل في الذلِّ من غدرَ",12,"ر",1,0],["وأيُّ عُلاً لم أستفد بابن خالدٍ","سَنِيَّ نوالٍ أو كريمَ سَناءِ",13,"ا",2,0],["وأي عذر وقد أصبحت ذا قلم","يجري بطاعته صرف القضاء الجاري",14,"ر",2,0],["وأيُّ عَلْقَمَةٍ في كفّ حادثةٍ","أُجنى لها كي أُسقّاها وتُجنى لِي",15,"ل",2,0],["وَأَيُّ عُذْرٍ لِمُقْلَةٍ بَعْدَ","الطَّاوُوسُ عَنْهَا إِنْ لَمْ تَفِضْ بِدَمِ",16,"م",1,0],["وأي عجاجٍ ما تبلّجَ صبحُها","أتتك فلم تطلع صباح انبلاجِها",17,"ج",3,0],["وَأَي عَزيز حازَ في الكَون قَبلَه","لُغاتٍ قَد اِمتَازَت بِأَعذَب مَورد",18,"د",1,0],["وأي عويل وأي اضطراب","لنا إن قضى بشديد العقاب",19,"ب",1,0],["وأيّ عيرٍ لو كنت آلفُ أنْ","أجوبَ عرضَ الفلاةِ بالعير",20,"ر",1,0],["وأي عدو لج في الحرب إنه","ليخشى مجال الصافنات ويتقي",21,"ق",2,0],["وأي عذولٍ كان في الحبِ عاذري","فذاكَ الذي قد يسرَ اللَه لليسرى",22,"ر",2,0],["واي عزاء عندنا غير زعمنا","بأن الامير اليوم مولاه احياه",23,"ا",2,0],["وأيّ عليٍّ ساقَ للنزع نفسَه","لقد كابدت نفسُ المعاني نزاعه",24,"ع",2,0],["وأيُّ عليلٍ كمضنى الهوى","جريح الفؤادِ صريع المُقَل",25,"ل",1,0],["وأَيُّ عذابٍ مِثْل حَمْلَي مثقلا","على حمله منِّي الجوانحُ لا تَقْوَي",26,"و",2,0],["وأيُّ عزٍّ وفخرٍ","لمن له الذكرُ ذاكِر",27,"ر",1,0],["واى على الاسلام يسأل يعطه","ويعطى كمن يعطى ولا يخشى من فقر",28,"ر",1,0],["وأي علا غير التفاتك عطفه","شفاء لمشتاق المعالي من الوجد",29,"د",1,0],["وأي عقاب المظالم","القوس في التعقيب",30,"ب",1,0],["وأي عشايا قد حملنَ مواجعا","فحزن ربوع الشرق والغرب واحدُ",31,"د",1,0],["وأي عذرٍ لنا فحولٌ","تعدُّ في جملة العذارى",32,"ر",2,0],["وأيُّ عين تحبسُ الدموعا","وتغنمُ الراحةَ والهِجوعا",33,"ع",2,0],["وأيُّ عُهودٍ لا تَجودُ عِهادُها","وأيّ حُظوظٍ لا تَنالُ رِغابُها",34,"ب",3,0],["وَأَيّ عذر إِذا التقينا","يَقوم عَن سَلوَتي بعذري",35,"ر",2,0],["وَأَيّ عُيون بالسرورِ قَريرةٌ","إِذا يَئست مما تحب قُلوب",36,"ب",1,0],["وأيّ عار على القصر المنيف إذا","اتاه لص بسوء الفعل متهم",37,"م",1,0],["وَأَيَّ عَهدٍ خانوا الإِلَهَ بِهِ","شُدَّ بميثاق عَقدُهُ الكَذِبُ",38,"ب",1,0],["وأيُّ عرسٍ رياض الصفو مزهرةٌ","فيه ودوح الحبور الغضِّ قد ينعا",39,"ع",2,0],["وأي عذر لمن شابت ذوائبه","إذا سعى في ميادين الصبا وخطا؟",40,"ط",2,0],["وأي عطر فريد خلته نفسًا","من ثغرك الحلو يا ليلى تعطرت",41,"ت",1,0],["وأيُّ عبادة في الكونِ كانت","لغير الله أسماها حراما",42,"م",2,0],["وأي عواطفٍ بل أيُّ حظٍ","يغيّر من سلاطينٍ جَرادِ؟",43,"د",1,0],["وأي عين إليها غير ناظرة","وأي قلب عليها غير مفتون",44,"ن",1,0]]}