,"https://www.aldiwan.net/poem13887.html","البسيط"],[458,"أصب برأيي أصاب الحظ أو غلطا","https://www.aldiwan.net/poem56141.html","البسيط"],[458,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[458,"أصبت لو أحمدت أن أصيبا","https://www.aldiwan.net/poem56297.html","الرجز"],[514,"خطرت فمال الغصن وهو ممنطق","https://www.aldiwan.net/poem20823.html","الكامل"],[515,"صرف النسيب إلى اللوى وزرود","https://www.aldiwan.net/poem12082.html","الكامل"],[524,"الله أكبر كم وافت بشارات","https://www.aldiwan.net/poem13287.html","البسيط"],[536,"لما رأيت نبينا متحملاً","https://www.aldiwan.net/poem23867.html","الكامل"],[551,"ما قربوا إلا لبين نوقا","https://www.aldiwan.net/poem47365.html","الكامل"],[551,"قد زرت ليلة هومنا على العيس","https://www.aldiwan.net/poem47744.html","البسيط"],[561,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[562,"للموت يولد منا كل مولود","https://www.aldiwan.net/poem52755.html","البسيط"],[562,"قد قام رب الدار في أوطانه","https://www.aldiwan.net/poem52767.html","الكامل"],[562,"تنبهوا يا عباد الله واعتبروا","https://www.aldiwan.net/poem52799.html","البسيط"],[562,"إن لم لك يكن في نقد الرجال يد","https://www.aldiwan.net/poem52863.html","البسيط"],[562,"كادت تذوب ثغور البحر من حسد","https://www.aldiwan.net/poem52927.html","البسيط"],[567,"للمهرجان عليك حق سنه","https://www.aldiwan.net/poem69714.html","الكامل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[586,"للمنطقيين أشتكي أبدا","https://www.aldiwan.net/poem17589.html","المنسرح"]],"verses":[["لِلمَوتِ مَن قَعَدَت عَنهُ رَكائِبُهُ","وَمَن سَرى في ظُهورِ الأَينُقِ البُزُلِ",0,"ل",1,0],["لِلمَجدِ مِن عَلياكُمُ وَمَصابِكُم","أَنفٌ بِهِ شَمَمٌ وَآخَرُ أَجدَعُ",1,"ع",1,0],["لِلمُنذرينَ وَلِلمعَصوبِ لِمَّتُهُ","أَنتَ الضياءُ الَّذي يُجلى بِهِ الأُفُقُ",2,"ق",1,0],["لِلمَقصِدِ الأَسمى لَدى حَرَمِ النُهى","رَفَعا قِباباً حوجِزَت بِقِبابِ",3,"ب",1,0],["للمجتلي هي روض","وللشجى صحابه",4,"ب",2,0],["للمالكين السائدين بنى الأولى","ملكوا زمام العالمين وسادوا",5,"د",3,0],["لِلْمَالِ فِيهَا كُلُّ عَائِدَةٍ","تَزْكُو وَلِلأَوْطَانِ أَعْوَدُهَا",6,"د",3,0],["لِلْمُلْكِ فِي ذِمَمِ المَفَاخِرِ وَالعُلَى","عِوَضٌ كَفَالَتُهُ عَلَى الشُّجْعَانِ",7,"ن",1,0],["لِلْمُبَرَّاتِ جَنَّةٌ أَرَّخُوهَا","فِي ذُرَاهَا خُلُودُ قِسْطَنْطِينْ",8,"ن",1,0],["لِلمُشْتَرِي بِصِبَاه عِزَّ أُمَّتِهِ","ذِكْرٌ يُدِيمُ اسمَهُ بِالتِّبْرِ مَرْقُومَا",9,"م",2,0],["للمستعين خلافة نصريّةٌ","عرفت ملوكُ العالمين جَلالَها",10,"ل",3,0],["للمسلمين على نزورة وفرهم","كنز يفيض غنى من الأوقاف",11,"ف",1,1],["لَلمَوتُ أَروَحُ مِما تَفعَلينَ بِنا","وَمِن مَواعِدَ مِن خُلفٍ وَتَأثيمِ",12,"م",1,0],["لِلمُتَّقينَ مِنَ الدُنيا عَواقِبِها","وَإِن تَعَجَّلَ مِنها الظالِمُ الأَثِمُ",13,"م",1,0],["للملتجي لك فيه سعدُ أخبيةٍ","من الأذى ولباغي البعد ذبّاح",14,"ح",1,0],["للمالِ والجاهِ قد جاروا بها قصصاً","في طيها عبرٌ منهم وتعبير",15,"ر",1,0],["للماء والطِّين أصلُ المرء منتسبٌ","فكيف ننكر أن يرثى بأكدار",16,"ر",1,0],["للمالِ سرًّا وجهراً","لصاحبِ السرّ عطفه",17,"ف",2,0],["للمرء فيها منظرٌ أحبّه","يملأ من لحمٍ وشحمٍ قلبه",18,"ه",1,0],["للموز إحسانٌ بلا ذُنوبِ","ليس بمعدودٍ ولا محسوبِ",19,"ب",1,1],["للموتِ دينٌ من الخلَّانِ كُلِّهمِ","يُقْضاهُ من كل مذخورٍ ومَخْزون",20,"ن",1,0],["لَلمادحونَ اليومَ أهلَ زماننا","أوْلى من الهاجين بالحرمانِ",21,"ن",1,1],["لِلماءِ وَالنَارِ في قَلبي وَفي كَبِدي","مِن قِسمَةِ الشَوقِ ساعورٌ وَناعورُ",22,"ر",1,1],["لِلمَوتِ مَن مَلَكَ لبَسيطَةَ كُلُّها","أَو هازَ مِن دُنياهُ بِضعَةَ أَذرُعِ",23,"ع",1,0],["لِلمَرءِ مِن شَرَفِ العَشيرَةِ زاجِرٌ","وَمِنَ الخِلالِ الصالِحاتِ مُؤَدِّبُ",24,"ب",1,0],["للمساءِ المطلِّ للشَّفَقِ السَّا","جي لسِحْرِ الأَسى وسِحْرِ السُّكونِ",25,"ن",1,0],["للموتِ للشَّوكِ الممزَّقِ","للجداولِ للرِّياحْ",26,"ح",1,0],["للملك فيصل جاء قبل مؤسسا","يبني وغازي جاء للاصلاح",27,"ح",1,0],["للمصلين المؤمنين برب","هو للكافرين بالمرصاد",28,"د",1,0],["للمرء في الدنيا مقاصد جمة","جُمعت فكان النسل منها المقصدا",29,"د",2,0],["لِلمَرءِ في الدُنيا وَجَمِّ شُؤونِها","ما شاءَ مِن رِبحٍ وَمِن خُسرانِ",30,"ن",1,0],["لِلمَوتِ سِرٌّ تَحتَهُ وَجِدارُهُ","سورٌ عَلى السِرِّ الخَفِيِّ وَخَندَقُ",31,"ق",1,0],["للملكِ مأوى في ظِلالِ لوائهِ","يأوي إِليه النصرُ والتمكينُ",32,"ن",1,0],["للمجدِ فيه مواعِدٌ مضمونَةٌ","واللّه ناصرُهُ ونِعْمَ الناصِرُ",33,"ر",1,0],["لِلمَهرَجانِ بَشاشَةٌ فَالهَج بِهِ","وَدَعِ التَشاغُلَ بِالهُمومِ الهُجَّسِ",34,"س",1,0],["لِلمَهرَجانِ يَدٌ بِما أَولاهُ مِن","هَطلانِ وَسمِيَّ السَحابِ المُغدِقِ",35,"ق",1,0],["لِلمُرتَضى بنِ المُجتَبى","وَالمُنعِمِ بنِ المُنتَقِم",36,"م",1,0],["لِلمَوتِ فينا سِهامٌ غَيرُ خاطِئَةٍ","مَن فاتَهُ اليَومَ سَهمٌ لَم يَفُتهُ غَدا",37,"د",2,0],["لِلمَرءِ رِزقٌ لا يَموتُ وَإِن","جَهَدَ الخَلائِقُ دونَ أَن يَفنى",38,"ا",1,0],["لِلمَوتِ فينا سِهامٌ غَيرُ مُخطِئَةٍ","مَن فاتَهُ اليَومَ سَهمٌ لَم يَفُتهُ غَدا",39,"د",2,0],["لِلمَوتِ ما تَلِدُ الأَقوامُ كُلُّهُمُ","وَلِلبَلى كُلُّ ما بَنَوا وَما غَرَسوا",40,"س",3,0],["لِلمَرءِ يَومٌ يُحتَمى قُربُهُ","وَتَظهَرُ الوَحشَةُ مِن أُنسِهِ",41,"ه",1,1],["لِلمَرءِ فيما يُقيمُهُ سَعَةٌ","لَكِنَّهُ ما يُريدُ ما يَسَعُ",42,"ع",1,0],["لِلمَرءِ في كُلِّ طَرفَةٍ حَدَثٌ","يُذهِبُ مِنهُ ما لَيسَ يُرتَجَعُ",42,"ع",1,0],["لِلمَوتِ ذِكرٌ أَنتَ مُطَّرِحٌ لَهُ","حَتّى كَأَنَّكَ لا تَراهُ ذَريعاً",43,"ع",2,0],["لِلمَرءِ ما قَدَّمَت يَداهُ مِنَ ال","فَضلِ وَلِلوارِثينَ ما تَرَكا",44,"ك",2,0],["لِلمَوتِ داعٍ مُزعِجٌ وَكَأَنَّهُ","قَد قامَ بَينَ يَدَيكَ ثُمَّ دَعاكا",45,"ك",2,0],["لِلمَرءِ أَلوانُ دُنيا رَغبَةً وَهَوى","وَعَقلُهُ أَبَداً ما عاشَ مَدخولُ",46,"ل",1,0],["لِلمُتَّقينَ هُناكَ نُزلُ كَرامَةٍ","عَلَتِ الوُجوهَ بِنَضرَةٍ وَجَمالِ",47,"ل",1,0],["لِلمَوتِ غولٌ فَكُن ما عِشتَ مُلتَمِساً","مِن غولِهِ حيلَةً إِن كُنتَ مُحتالا",48,"ل",2,0],["لِلمَنايا وَلِاِبنِ آدَمَ أَيّا","مٌ وَيَومٌ لا بُدَّ مِنهُ خَؤونُ",49,"ن",1,0],["لِلمَنونِ دائِرا","تٌ يُدِرنَ صَرفَها",50,"ه",2,1],["لِلمَوتِ أَبناءٌ بِهِم","ما شِئتَ مِن صَلَفٍ وَتيهِ",51,"ه",1,1],["لِلمَنايا عِندَهُ أَلْسِنَةٌ","قَلَّما تَعْمُرُ أفْواهَ الغُمود",52,"د",1,0],["لِلمَرءِ في القُرآنِ أَربَعُ نُسوَةٍ","وَلِتِلكَ أَربَعَةٌ مِنَ الأَزواجِ",53,"ج",1,0],["لِلمَحلِ يَكشِفُهُ وَلَم يَبعَل بِهِ","وَالثِقلُ يَحمِلُهُ وَلَيسَ بِمُثقَلِ",54,"ل",1,0],["لِلمَجدِ مُستَشرِفٌ وَلِلأَدَبِ ال","مَجفُوِّ تِربٌ وَلِلنَدى حِلسُ",55,"س",1,0],["لِلْمَنْجَنُونِ بَيْنَهَا أَزَامِلُ","تَخَالُهَا مَحْزُونَةً تُسَائِلُ",56,"ل",1,0],["للمقدسيِّ بقلبي","حبٌّ جليُّ الدليلِ",57,"ل",1,1],["لِلمُلكِ أوتادٌ تُقامُ وأنتَ من","أوتادهِ إن جدَّ أمرٌ حازبُ",58,"ب",1,0],["للمُصلِّين إذا ما سَجَدوا","من حديثِ السُّوءِ ما للصّائِمينْ",59,"ن",1,0],["لِلمُسلِمينَ بِكُلِّ أَرضٍ رِنَّةٌ","زَجَلُ المَآذِنِ مِن صَداها العالي",60,"ل",2,0],["للمرءِ من نُورِ الحقائقِ ما يَرى","لا ما تُرِيهِ وساوِسٌ ومَزاعِمُ",61,"م",1,0],["للمسلمينَ أمورُهم وله على","مَن ضلَّ جِزيةُ عادلٍ لا يُجحِفُ",62,"ف",1,0],["لِلمُكتَفي دَولَةٌ مُبارَكَةٌ","عاشَ بِها الناسُ بَعدَ ما ماتوا",63,"ت",3,1],["لِلماءِ فيها كِتابَةٌ عَجَبٌ","كَمِثلِ نَقشٍ في فَصِّ ياقوتِ",64,"ت",1,0],["لِلمُقتِ سَطرانِ في خَدَّيهِ مِن شَعَرٍ","عُنوانُ ما غابَ عَن عَينَيكَ في بَدَنِه",65,"ه",1,1],["لِلمَوتِ أَسبابٌ وَحُبُّكُمُ","سَبَبٌ لِمَوتي مُحصَدُ الشَزرِ",66,"ر",1,0],["لِلمُلكِ عَبّاسٌ وَأَبناؤُهُ","قِدماً وَلِلحُشِّ الخَنازيرُ",67,"ر",1,0],["لِلمُحِبّينَ راحَةٌ في التَلاقي","وَاِشتِياقٌ يُبريهُما في الصُدودِ",68,"د",1,0],["لِلمَرءِ مِن أَفعالِهِ مُشبِهٌ","فَاِفعَل شَبيهاً بِكَ يَعقوبُ",69,"ب",1,0],["لِلمَليكِ المُذَكَّراتُ عَبيدٌ","وَكَذاكَ المُؤَنَّثاتُ إِماءُ",70,"م",3,0],["لِلمَنايا حَواطِبٌ لا تُبالي","أَهَشيماً جَرَّت لَها أَم رَطيبا",71,"ب",2,0],["لِلمَوتِ حَدٌّ لا يُقَرَّبُ حينُهُ","بِصُدورِ بيضٍ أَو صُدورِ مَداعِسِ",72,"س",1,0],["للمرأة الفضل في العمران نشهده","لولا تقدمها ما تم عمران",73,"ن",1,0],["للمرأة اليوم في مج","لس القضاء محل",74,"ل",1,0],["للمرأة اليوم في البر","لمان عقد وحل",74,"ل",1,0],["للمرأة اليوم في استك","شاف الحقائق شغل",74,"ل",1,0],["للمرأة اليوم في تح","سين الحضارة فضل",74,"ل",1,0],["للموت أجمل من عيش على مضض","إنّ الحياة بلا حريّة عدم",75,"م",1,0],["لِلْمُرُوءَاتِ ذِمَّةٌ وَحِفَاظٌ","بِهِمَا يُدْفَعُ البَلاءُ الْمُغِيرُ",76,"ر",1,0],["لِلمُفَدَّاة عَرُوسِ الحُسْنِ","وَالشِّعرِ فِي مِصرِ",77,"ر",1,0],[