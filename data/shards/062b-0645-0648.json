udhabi.ae/diwan/poem/86495","الخفيف"],[123,"","https://poetry.dctabudhabi.ae/diwan/poem/73081",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136638",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136499",""],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28650","الرمل"],[4434,"","https://poetry.dctabudhabi.ae/diwan/poem/130704","الرجز"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119546","الخفيف"],[4530,"","https://poetry.dctabudhabi.ae/diwan/poem/20958","الرمل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139562",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139491",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139516",""],[4679,"مرحباً بالكرام أهل الحمَّية","https://www.poetsgate.com/ViewPoem.aspx?id=142757",""],[4814,"نكهة الأشياء","https://www.poetsgate.com/ViewPoem.aspx?id=194101",""],[4869,"المقفص","https://www.poetsgate.com/ViewPoem.aspx?id=151534",""],[5101,"شموع ليلة الميلاد","https://www.poetsgate.com/ViewPoem.aspx?id=204585",""],[333,"الإنسان والمعرفة","https://www.poetsgate.com/ViewPoem.aspx?id=98236",""],[5431,"دون نعلك أقسى!!...","https://www.poetsgate.com/ViewPoem.aspx?id=202123",""],[5431,"الى حيّ الميدان الدمشقي...","https://www.poetsgate.com/ViewPoem.aspx?id=202358",""],[5596,"عودة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=205675",""],[5715,"هَيَّجَتْ قَلْبِي . .","https://www.poetsgate.com/ViewPoem.aspx?id=196753",""],[5953,"يا ألهي بأحمد وعلي","https://www.poetsgate.com/ViewPoem.aspx?id=93809",""]],"verses":[["ثُمَّ وَصَلتَ صِرَّةً بِرَبيعٍ","حينَ صَرَّفتَ حالَةً عَن حالِ",0,"ل",1,0],["ثُمَّ وَلّوا عِندَ الحَفيظَةِ وَالصَب","رِ كَما يَطحَرُ الجَنوبُ الجَهاما",1,"م",2,0],["ثُمَّ وَلَّت بَشاشَةُ العَيشِ عَنّا","حينَ ساروا فَوَسَّدوكَ التُرابا",2,"ب",2,0],["ثُمَّ وَلَّت فَوَجَدنا","أَرَجَ المِسكِ ثَناءَ",3,"ا",2,0],["ثم ولى ذاك الصناع وما في","نفسه حال دون التقصير",4,"ر",1,0],["ثم ويك نبك المجد والشرفا","ونعزّ طرف العين ما دمعا",5,"ع",2,0],["ثُمَّ والى بِسَمحَجٍ وَنَحوصٍ","وَبِعِلجٍ يَكُفُّهُ بِعِلاطِ",6,"ط",1,0],["ثُمَّ وَرَدنا وَلَم نُهدَد لِقَولِكُمُ","حَتّى شَرِبنا رِواءً غَيرَ تَصريدِ",7,"د",1,0],["ثمَّ ولَّى فليت أنا قدرنا","فاتَّخذنا مع الرسول سبيلا",8,"ل",2,0],["ثم وَلَّى مُتوَّجاً تاجَ فخرٍ","سوف يبقى لعَقْبهِ ميراثا",9,"ث",2,0],["ثم ولَّتْ كالشمسِ أعلى قضيبٍ","فوق دعصٍ رابٍ على الأوراكِ",10,"ك",1,0],["ثم ولاّها فتى من نسله","خالداً لا يتقي ريب الممات",11,"ت",1,0],["ثم ولَّت والقلب كالوتر الدا","مي يتيمُ الدموع واللحن مفرد",12,"د",1,0],["ثم وارتهُ غياباتُ الدّجى","كخيالٍ من أساطيرِ الخُرافه",13,"ه",1,0],["ثم وارت يده جنيةٌ","وطوته في أساطير الخرافه",14,"ه",1,0],["ثُمَّ وَجَّهتَ فارِسَ الأَزدِ وَالأَو","حَدَ في النُصحِ مَشهَداً وَمَغيبا",15,"ب",2,0],["ثُمَّ وَلَّوا وَما قَرابَةُ مَن حَلَّ","بِنَجدٍ مِمَّن يَحِلُّ العِراقا",16,"ق",2,0],["ثُمَّ وَلّى بَينَ عيطٍ بِها","تَلحَسُ الأَروى زِمارَ البِهام",17,"م",1,0],["ثُمَّ وَلّى وَلَن يَزالوا وُلاةً","رَبُّنا اللَهُ خَلقَهُ خُلفاها",18,"ا",3,0],["ثم وافَى يحدِّثُ الناسَ شُكْرَاً","إذ أتته من ربِّه النَّعْماءُ",19,"ا",2,0],["ثُمَّ وَسِّدهُ إِذا ما غَلَبَت","سَورَةُ الراحِ عَلَيهِ عَضُدَه",20,"د",2,0],["ثُمَّ والى بَينَ الجُشاءِ كَأَن قَد","بَلَغَ الشِبعَ مِن قَلِيَّةِ جُزرِ",21,"ر",1,0],["ثُمَّ وَافى بِالجوادِ المُجْتَبَى","سَاسَةٌ قَدْ أَلْبِسُوا خَزّاً وَشَذْرَا",22,"ر",2,0],["ثُمَّ وَلَّى ذَاكَ الصُّنَّاعُ وَمَا فِي","نَفْسِهِ حَالٌ دُونَهُ التَقْصِيرُ",23,"ر",1,0],["ثم ولت كأنها لم تكن تل","بث إلا عشيةً أو ضحاها",24,"ا",3,0],["ثُمَّ وَفّاهُ بِرُجعى يوسُفٍ","وَالأَخُ المَظلوم إِذ قيلَ سَرَق",25,"ق",1,0],["ثُمَّ وَلَّوا وَمَا قَرَابَة ُ مَنْ حَلَّ","لّ بنجدٍ ممنْ يحلُّ العراقا؟",26,"ق",2,0],["ثم واجهنا ظباءكم","فلقينا الهولَ والوَهَلا",27,"ل",2,0],["ثم وافاه حينه فمضى غير","مروع من المنايا الدواني",28,"ن",2,0],["ثُمَّ وَلَّى عَنْ نَاظِرَيَّ ضَحُوكًا","رَاضِيَ القَلْبِ، سَاحِرَ الأَنْغَامِ",29,"م",1,0],["ثم ولى فسرن في إثره مس","ترشدات بطيبه في القفار",30,"ر",1,0],["ثمّ وافيت بصابو","ن وأشنان وسقا",31,"ق",2,0],["ثمَّ ودَّعنهُ فقامَ حزيناً","ينثني بينَ ذلّةِ وانكسارِ",32,"ر",1,0],["ثم وجّهْتُ وَجَهَ الحادياتِ إلى","نجلِ الإمامِ رفيع النَّجرِ والرُّتَبِ",33,"ب",1,0],["ثم وصلناه بعد سير","أتعب أجسامنا وأجهد",34,"د",1,0],["ثمّ وحّد على المثانيَ آلا","تِ وجودِ الآلاء في آلاتك",35,"ك",1,0],["ثُمَّ وَلّى كَأَنَّهُ شَيخُ سوءٍ","أَخرَجوهُ مِن مَحبَسٍ بِكَفالَه",36,"ل",2,0],["ثم ولى فلا تسل كيف ولّى","وسل الدهر عن ضحايا اللئام",37,"م",1,0],["ثمّ ولى وانتهى","حلم هوانا فانتهينا",38,"ن",2,0],["ثم وليّت فماتت أغ","نياتي في بديّه",39,"ي",2,0],["ثم وافاك شباب شيبا","وأنا قلبك لا قلب سواك",40,"ك",1,0],["ثم ولوا يحسبون ال","بوم في القفر يماما",41,"م",2,0],["ثم ولى عنه وخلف دودا","مستكفاً حول الذبيح المصاب",42,"ب",1,0],["ثُمَّ ولّى كالغصْنِ في مَرَحٍ يَفْ","تِلُ منّي ومنه جِيداً وقَدّا",43,"د",2,0],["ثم وفق لماتحب وترضى","ناظم القول مع جميع ذويه",44,"ي",2,0],["ثم وافاني وقد أتلفني","فاتحاً باب عتاب وهو مُرّ",45,"ر",1,0],["ثم وليتم العدول رعايا","كم فكم قد وَلِيَهُمُ الأشرار",46,"ر",1,0],["ثم وكّلتم السهاد عليها","يمنع العين عن لذيذ الرقاد",47,"د",1,0],["ثُمَّ وافِ القصورَ من مُلْكِ بُصْرى","بالمَشِيدات من ذُرى شَدَّادِ",48,"د",1,0],["ثُمَّ وَلِّى جيلٌ وجيلٌ فسادت","ثورةُ الشعبِ وانقضى الصولجانُ",49,"ن",1,0],["ثم وهمت أن بدراً زارني","فبتّ لا أسألُ إلا الأفقا",50,"ق",2,0],["ثموداً كنت ام عادا!","عهِدتك دونهم شانا",51,"ن",2,0],["ثم وُهبْتِ كلّ الذي أعْطيَ","والعُلا فوقه نلتهِ خُلُقا",52,"ق",2,0],["ثُمّ وَلّى ممكِّناً مِن رَداه","فيه تلك الأنيابَ والأظفارا",53,"ر",2,0],["ثمَّ ولَّى كَما أَتى أَرِجَ الأخ","بارِ في النّاسِ طيّبَ الأثوابِ",54,"ب",1,0],["ثم ولّى وقال دوَنكُموهُ","إنّ ربّي مُصيبُهُ بشَهابِ",55,"ب",1,0],["ثم وافى عصر العلوم بفضل","أشرقت من سناه تلك البقاع",56,"ع",1,0],["ثم ولَّت من بعد ذك توالي","فاقد اللطف والنُهى والذكاءِ",57,"ا",2,0],["ثم وافانا وفي حوزته","ثمر السعي وغرس الهمم",58,"م",1,0],["ثمّ ولّت كي تودّعنا","كحلها بالدمع مغسول",59,"ل",1,0],["ثم وجهاً قِسْنَا القرودَ إليه","فوجدنا القرودَ كالأقمار",60,"ر",1,0],["ثُمَّ وَطِئناهُ بِأَقدامِنا","وَكانَ مِثلَ الحَيَّةِ الراصِدِ",61,"د",1,0],["ثُمَّ وَجَدنا في عُموم الناسِ","جُملَة أَحبابٍ بِهِم إِيناسي",62,"ي",1,0],["ثُمَّ وَلّى يَقولُ وَهوَ كَئيبٌ","لَهفَ نَفسي عَلى الرَغيفِ أُضيعا",63,"ع",2,0],["ثُمَّ وافى كانونُ وَاِسوَدَّ وَجهي","وَأَتاني ما كانَ مِنهُ حَذاري",64,"ر",2,0],["ثم ولَّي عني مُقِرًّا بفضل","لإمام الهدى وَرُحْتُ مُدِلا",65,"ل",2,0],["ثمَّ ولي وقال اسْتَودعُ الل","ه مُحبًّا ما شابَ باُلحبِّ حُبَّا",66,"ب",2,0],["ثم ودع كل ما مضى فإلى الآن","ثرى قبره وتربته",67,"ت",2,0],["ثم وفي معبرالحديثة سرا","يذهل العقل عند عبرته",67,"ت",2,0],["ثم ولّت وأعقبتني شجواً","وانقضت مثل هجعة الإغفاء",68,"ا",2,0],["ثُمَّ ولَّت تجُرُّ حبلَ شموسٍ","مُطعِماً مؤيِساً ووصلاً ظنونا",69,"ن",2,0],["ثم ولَى عنا فقيداً حميداً","فجزاه الجنان ربُّ العبادِ",70,"د",1,0],["ثم ولى وقد لقي ميسورا","بعد ما كان شاكياً معسورا",71,"ر",2,0],["ثُمَّ وَلّاكَ ناصِراً لَكَ مَولا","كَ فَنِعمَ المَولى وَنِعمَ النَصيرُ",72,"ر",1,0],["ثُمَّ ويلٌ لِمَن يُبارِزُ في الرَّو","عِ إذا ضَمَّتِ الحُسامَ يَمينُه",73,"ن",2,0],["ثم وافيت فاستلمت وجددت","متابا للغافر التواب",74,"ب",1,0],["ثم ودعت وانصرفت ترجي","عودة في تأسف واكتئاب",74,"ب",1,0],["ثُمَّ وَلّى الصِّبا فَوا أَسَفا","لَو يَرُدُّ الصِّبا لِيَ الأَسَفُ",75,"ف",1,0],["ثم وسمت خدها بعضة","تركتها وشما على سفرجل",76,"ل",1,0],["ثمّ وافى بساطعٍ مستطيلٍ","يترُكُ الليلَ في رداءِ النهار",77,"ر",1,0],["ثم وسدته اليمين إلى","أن دنا الصبح قال لي يكفيك",78,"ك",1,0],["ثم وافى دمياط ينشر فيها","من طوايا الخيرات أبهج أنماط",79,"ط",1,0],["ثم ولى وهو في ريعانه","وتوارت شمسه قبل الغروب",80,"ب",1,0],["ثم ودّعته وما كنت أدري","أنها فرقة لغير تدان",81,"ن",1,0],["ثم ولّيت فلم ألق الذي","يبعث السلوى لنفسي والعزاء",82,"ا",2,0],["ثم ولّيت فانطوى عهدي الما","ضي وأعقبْتُ حسرةَ الحرمان",83,"ن",1,0],["ثم ولي سليمُ نجلُ عترِ","وبعدَهُ السّائبُ نجلُ عمرو",84,"و",1,0],["ثمَّ وليه عابِسُ المرادي","وَبعَدهُ ابن النّضر في البلادِ",84,"د",1,0],["ثمَّ ولي من بعده النّجيبي","والعمريُّ أيّما نجيبِ",84,"ب",1,0],["ثمَّ ولي الأحكامَ نجلُ شداد","وبعده الحارثُ خيرُ من جاد",84,"د",1,0],["ثم ولي الحكمَ ابنُ عبد الحاكم","ثمَّ أُعيدَ بعدَهُ للقاسمِ",84,"م",1,0],["ثمَّ وليه بعدهُ اليازوري","وابن كدينةَ بِغَيرِ زورِ",84,"ر",1,0],["ثمَّ وليهِ ولدُ الميسَرِ","أعني سناءَ الملكِ ربَ المفخر",84,"ر",1,0],["ثمَّ وليهِ يوسفُ السنجاري","وجاءَ عزُ الدين في الآثار",84,"ر",1,0],["ثمَّ ولي الأحكام محي الدين","وابن رزين ذوالحجا الرزينِ",84,"ن",1,0],["ثمَّ ولي القضا التّقيُّ بنُ خلف","بعد الوجيه والشهاب المنصرفْ",84,"ف",1,0],["ثمَّ ولي التقيُّ عبد الرحمن","وبانَ بدر الدين لمّا أن بان",84,"ن",1,0],["ثم ولت كأنما هي جاءت","لي حتى أقول هذا الهجاءَ",85,"ا",2,0],["ثم ولت عوائد المعز والأغ","نام حتى نجت من الانقراض",86,"ض",1,0],["ثم وافى بنفسج في حداد","فرأينا السرور في الأحزان",87,"ن",1,0],["ثم وردن الحوض آمنات","من شر ليث الغاب ناجيات",88,"ت",1,0],["ثمَّ وافَى أُمَّ البِلادِ مُعيداً","بِنداهُ لعَهْدِها ريْحانَهْ",89,"ن",2,0],["ثُمَّ وَلّى مِن زَعقَةٍ وَمُحامو","هُ وَمِن خَلفِهم لَهُم تَضريطُ",90,"ط",1,0],["ثم وشا بصبغة لم يجدها","غيره فهي نكتة في الصباغه",91,"غ",2,0],["ثم وافت رحاب مكة تزهو","وبأسعاد جدها تتباهى",92,"ا",3,0],["ثم ولى علي بن يوسف","مهتدياً حكم أبيه يقتفي",93,"ي",1,0],["ثم ولي محمد الأمين","في طالع حل به التنين",94,"ن",1,0],["ثم وجود لمثال العقل","يعرف هذا ذو الحجى والنبل",95,"ل",1,0],["ثم وجود ثالث رفيع","فوق العلا علمه البديع",95,"ع",1,0],["ثم ولى للجسر يبغي انتحارا","حيث ألقى بالنفس في التيار",96,"ر",1,0],["ثم ولى الى المقابر وجها","مستدلا بضوء نجم السماء",97,"ا",2,0],["ثم وافى من بعد شهر أنيس","زائرا دارها يود لقاها",98,"ه",2,0],["ثم وافى لخادم البيت سراً","وببعض النقود قد أغراها",98,"ه",2,0],["ثم ولى للحرب يطلب منها","محو عار ولو بحد الحسام",98,"م",1,0],["ثم وافت سلمى بدميه حسن","شعرها كالسبائك العسجديه",99,"ه",1,0],["ثم وقفنا يومَنَا في مَتنَه","وجآءنا اللهُ بكلِّ مِنَّه",100,"ه",1,0],["ثم وليتم الامور رجالاً","لم يزنهم عدلٌ ولا عرفان",101,"ن",1,0],["ثُمَّ وَلّى مودِّعاً","حَزني مِن وداعِهِ",102,"ع",2,0],["ثُمَّ وَلّى فَأَقبَلَت","تَتَغَنّى مِنَ الأَسَف",103,"ف",1,0],["ثم ولوا بارتعاد وارتعاب","يا بنات الرب زفس من على",104,"ل",2,0],["ثمَّ ولّى كأَنه لم يكن إِلا","م كطيفٍ مضى معَ الأحلامِ",105,"م",1,0],["ثم وافى من بعد عامين في جيش","خضمٍّ يموجُ كالطوفانِ",106,"ن",1,0],["ثم