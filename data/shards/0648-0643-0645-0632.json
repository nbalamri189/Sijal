{"poems":[[53,"تناسيت إلا باقيات من الذكر","https://www.aldiwan.net/poem30441.html","الطويل"],[54,"إذا غزونا فمغزانا بأنقرة","https://www.aldiwan.net/poem27633.html","البسيط"],[91,"أبا الشعب إطلع من حجابك يلتقي","https://www.aldiwan.net/poem8986.html","عموديه"],[33,"أرى أهل ليلى أورثوني صبابة","https://www.aldiwan.net/poem26019.html","الطويل"],[67,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[46,"أيا شجر العرا أوسعت ريا","https://www.aldiwan.net/poem22995.html","الوافر"],[46,"مناطق غلمان وأحجال أنس","https://www.aldiwan.net/poem23366.html","الطويل"],[144,"لكم أن تجوروا معرِضين وتغضبوا","https://www.aldiwan.net/poem11720.html","الطويل"],[151,"توكل إذا نابتك يوما ملمة","https://www.aldiwan.net/poem68522.html","الطويل"],[190,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[190,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[200,"أيا ضيفا أطال المك","https://www.aldiwan.net/poem45506.html","الهزج"],[213,"وشمطاء بالخز الثمين تلفعت","https://www.aldiwan.net/poem37839.html","الطويل"],[236,"لك النهي بعد الله في الخلق والأمر","https://www.aldiwan.net/poem32009.html","الطويل"],[305,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[367,"لعينيه على العشاق إمره","https://www.aldiwan.net/poem17205.html","الوافر"],[404,"إلى كم أداري عاذلي ومفندي","https://www.aldiwan.net/poem33969.html","الطويل"],[433,"سعود سنيكما كملت سناء","https://www.aldiwan.net/poem12355.html","الوافر"],[433,"بك الإسلام قد لبس الشبابا","https://www.aldiwan.net/poem12461.html","الوافر"],[440,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[440,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[459,"لها كل يوم نشطة وعقال","https://www.aldiwan.net/poem55906.html","الطويل"],[459,"عجلت بحطك فيها الرحالا","https://www.aldiwan.net/poem56065.html","المتقارب"],[459,"إذا صاح وفد السحب بالريح أوحدا","https://www.aldiwan.net/poem56243.html","الطويل"],[462,"وفتيان صدق من تميم تناثلوا","https://www.aldiwan.net/poem15083.html","الطويل"],[462,"عفا ضارج من آل ليلى فعاقل","https://www.aldiwan.net/poem15298.html","الطويل"],[465,"سرت موهناً لا أبعد الله مسراها","https://www.aldiwan.net/poem3493.html","عموديه"],[530,"أود بأن أعيش لنشر علم","https://www.aldiwan.net/poem37509.html","الوافر"],[565,"ولما رأيت الدل في شرعة الهوى","https://www.aldiwan.net/poem877.html",""],[576,"أيا دمع عيني لا تكن بعد إخواني","https://www.aldiwan.net/poem2776.html","الطويل"]],"verses":[["وَكَم زادَني فيها الهَوى عَن جِمامِهِ","وَقارَعَني الغَيرانُ عَن بَيضَةِ الخِدرِ",0,"ر",1,0],["وَكَم زَحَمتُ طَريقَ المَوتِ مُعتَرِضاً","بِالسَيفِ صَلتاً فَأَدّاني إِلى السَعَةِ",1,"ه",1,0],["وَكَم زَوَّروا عَنهُ الأَراجيفَ وَاِدَّعوا","وَأَيّدَهُم ذَيّاكُمُ الزاهِدِ التَقي",2,"ق",2,0],["وَكَم زَفرَةٍ لي لَو عَلى البَحرِ أَشرَقَت","لَأَنشَفَهُ حَرٌّ لَها وَلَهيبُ",3,"ب",1,0],["وَكَم زُورِ قَولٍ قُلْتُمُ أَيُّ حُجَّةٍ","وَكَمْ حُجَجٍ لِلخائِنِينَ تُزَوَّرُ",4,"ر",1,0],["وَكَم زُفَّت إِلى جَدَثٍ عَروسٌ","وَقَد هَمَّت إِلى عُرُسٍ بِزَفِّ",5,"ف",1,0],["وَكَم زَلَّةٍ مُدَّت أَيادٍ لِدَفعِها","وَقَد عُلِّقَت مِن أَهلِها بِالعَراتِمِ",6,"م",1,0],["وَكَم زُرتَ أَحياءً فَلَم يُغنِ عَنهُمُ","طِعانٌ وَلا نَجّاهُمُ مِنكَ مَهرَبُ",7,"ب",1,0],["وكم زلَّة جددتها إثر زلَّة","تداركك الإمهال فيهن والحلم",8,"م",1,0],["وَكَم زارَ باريزاً ولُندرةً ولم","يَزُر مكّةً يَوماً ولا طيبةَ الغرّا",9,"ر",2,0],["وَكَم زوجةٍ منهم وزوجٍ تباغَضا","وكلٌّ قدِ اِستَغنى بأحبابهِ دهرا",10,"ر",2,0],["وَكَم زَوجةٍ حسناءَ لكنَّ زَوجها","تَضرّر مِنها حينَما عقرت عقرا",10,"ر",2,0],["وكم زلزلتَ دورهمُ","فخرَّ عليهم السقفُ",11,"ف",1,0],["وكم زحرةٍ تُبْدِينَها إثرَ زَحْرَةٍ","وجَرْجَرةٍ مخلوطةٍ بِسُعالِ",12,"ل",1,0],["وَكَم زَجَرَتهُم مِن سُطاكَ مَواعِظٌ","فَما نَفَعَ الوَعظُ المُنَهنِهُ وَالزَجرُ",13,"ر",1,0],["وكم زاهد في هذه الدار معرض","ومقتصر منها على حد بلغة",14,"ه",1,0],["وَكَم زَمَنٍ نُواصِلُهُ وَكُنّا","نَقولُ لِذاكَ كَيفَ قَطَعتَ عِشرَه",15,"ر",2,0],["وكم زارني عن غير وعد معذبي","وأحلى اللقا ما كان عن غير موعد",16,"د",1,0],["وكم زُرْنا من الأَملاكِ لكِنْ","تَلَتْ أَفْعالُهُم لَيْسوا سَواء",17,"ا",2,0],["وكم زهِرَتْ رياضُ دمٍ تغنّى","ذُبابُ حُسامه فيها ذُبابا",18,"ب",2,0],["وكم زَفْرَةٍ نَمَّتْ عَلَيْهِمْ بِحَسْرَةٍ","أَنَارَتْ بِنارِ السِّرِّ فِي عَلَمِ الجَهْرِ",19,"ر",1,0],["وكم زَجَروها بِاسْمِها وحُقُوقِهَا","فما صَدَقَتْهُمْ لا ثَرَاءً ولا ثَرْيا",20,"ي",2,0],["وكم زحَمتكم قبلَها من مُلِمَّةٍ","فطاحت رُفاتاً والجبالُ جبالُ",21,"ل",1,0],["وكم زاحمتْها صروفُ الزما","ن قبلُ فكانت عليها ثقالا",22,"ل",2,0],["وكم زائرٍ منّا حملتَ اقتراحَه","مضى ساحباً رِجْلاً وآب مقوَّدا",23,"د",2,0],["وكم زوْرة قابلتُّها بتجنُّبٍ","ومبذولِ وصلٍ رعتُه بالقطائعِ",24,"ع",1,0],["وكم زارني سَلْمَ اللقاءِ وأنهُ","من الحُسن شاكٍ في السلاح مقاتلُ",25,"ل",1,0],["وكم زارني في جنح ليلٍ خيالها","فأبصر منّي خاشعَ القلب أوّاها",26,"ا",3,0],["وكم زَيَّقْتُ أَقوالاً أراها","من الإنصاف ما أخذتْ نصيبا",27,"ب",2,0],["وكم زلة عظمى على اثر زلةٍ","سمحت وكم عيباً أرى فأطبق",28,"ق",1,0],["وكَمْ زرتُ منه قبرَه فرأَيتُه","بعَيْنِ ضميرِي قَائِماً يَتَلقَّاني",29,"ن",2,0]]}