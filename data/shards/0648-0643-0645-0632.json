{"poems":[[55,"تناسيت إلا باقيات من الذكر","https://www.aldiwan.net/poem30441.html","الطويل"],[56,"إذا غزونا فمغزانا بأنقرة","https://www.aldiwan.net/poem27633.html","البسيط"],[93,"أبا الشعب إطلع من حجابك يلتقي","https://www.aldiwan.net/poem8986.html","عموديه"],[35,"أرى أهل ليلى أورثوني صبابة","https://www.aldiwan.net/poem26019.html","الطويل"],[69,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[48,"أيا شجر العرا أوسعت ريا","https://www.aldiwan.net/poem22995.html","الوافر"],[48,"مناطق غلمان وأحجال أنس","https://www.aldiwan.net/poem23366.html","الطويل"],[147,"لكم أن تجوروا معرِضين وتغضبوا","https://www.aldiwan.net/poem11720.html","الطويل"],[154,"توكل إذا نابتك يوما ملمة","https://www.aldiwan.net/poem68522.html","الطويل"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[203,"أيا ضيفا أطال المك","https://www.aldiwan.net/poem45506.html","الهزج"],[216,"وشمطاء بالخز الثمين تلفعت","https://www.aldiwan.net/poem37839.html","الطويل"],[240,"لك النهي بعد الله في الخلق والأمر","https://www.aldiwan.net/poem32009.html","الطويل"],[309,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[371,"لعينيه على العشاق إمره","https://www.aldiwan.net/poem17205.html","الوافر"],[409,"إلى كم أداري عاذلي ومفندي","https://www.aldiwan.net/poem33969.html","الطويل"],[438,"سعود سنيكما كملت سناء","https://www.aldiwan.net/poem12355.html","الوافر"],[438,"بك الإسلام قد لبس الشبابا","https://www.aldiwan.net/poem12461.html","الوافر"],[445,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[445,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[463,"لها كل يوم نشطة وعقال","https://www.aldiwan.net/poem55906.html","الطويل"],[463,"عجلت بحطك فيها الرحالا","https://www.aldiwan.net/poem56065.html","المتقارب"],[463,"إذا صاح وفد السحب بالريح أوحدا","https://www.aldiwan.net/poem56243.html","الطويل"],[466,"وفتيان صدق من تميم تناثلوا","https://www.aldiwan.net/poem15083.html","الطويل"],[466,"عفا ضارج من آل ليلى فعاقل","https://www.aldiwan.net/poem15298.html","الطويل"],[469,"سرت موهناً لا أبعد الله مسراها","https://www.aldiwan.net/poem3493.html","عموديه"],[534,"أود بأن أعيش لنشر علم","https://www.aldiwan.net/poem37509.html","الوافر"],[569,"ولما رأيت الدل في شرعة الهوى","https://www.aldiwan.net/poem877.html",""],[580,"أيا دمع عيني لا تكن بعد إخواني","https://www.aldiwan.net/poem2776.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138215",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86670","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87092","الطويل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137697",""],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70762","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96727","الوافر"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96679","الطويل"],[1275,"","https://poetry.dctabudhabi.ae/diwan/poem/73504","الطويل"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144783","الطويل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87837","الطويل"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177823","الطويل"],[2231,"","https://poetry.dctabudhabi.ae/diwan/poem/124054","الطويل"],[2378,"","https://poetry.dctabudhabi.ae/diwan/poem/199544","الوافر"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137076",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200205","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100788","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48278","الوافر"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103569","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94556","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94365","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94325","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81706","الطويل"],[4767,"مخابز","https://www.poetsgate.com/ViewPoem.aspx?id=180939",""],[585,"أين القصائد أفوافاً توشيها","https://www.poetsgate.com/ViewPoem.aspx?id=161879",""],[5167,"قد شاب رأسي وقلبي ما يغيره","https://www.poetsgate.com/ViewPoem.aspx?id=181115",""],[5573,"أشعلت لي في داجر الليل مصباح","https://www.poetsgate.com/ViewPoem.aspx?id=200076",""],[5582,"أَلا هَلْ تَوَلَّتْ نَوارٌ نَوارا","https://www.poetsgate.com/ViewPoem.aspx?id=186999",""],[5582,"أَلا عُجْ بِالمَطِيِّ عَلَى المُقامِ","https://www.poetsgate.com/ViewPoem.aspx?id=63580",""],[5582,"أَأَوْجُهُ غِيدٍ زِلْنَ عَنْها البَراقِعُ","https://www.poetsgate.com/ViewPoem.aspx?id=63532",""],[5616,"صقر","https://www.poetsgate.com/ViewPoem.aspx?id=203326",""],[5616,"موال فلسطيني خاص جدًّا","https://www.poetsgate.com/ViewPoem.aspx?id=205045",""],[5790,"سلا خاطري عن زينبٍ ونوار","https://www.poetsgate.com/ViewPoem.aspx?id=111946",""],[5977,"ابتسامة رغم الألم","https://www.poetsgate.com/ViewPoem.aspx?id=213251",""],[6185,"أوصل سلامي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87028&r=&rc=14",""],[6290,"هَوَى الصِّبْيَانِ وَشْمٌ فِي قُلُوبٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85167&r=&rc=4",""],[6318,"الجمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66160&r=&rc=10",""]],"verses":[["وَكَم زادَني فيها الهَوى عَن جِمامِهِ","وَقارَعَني الغَيرانُ عَن بَيضَةِ الخِدرِ",0,"ر",1,0],["وَكَم زَحَمتُ طَريقَ المَوتِ مُعتَرِضاً","بِالسَيفِ صَلتاً فَأَدّاني إِلى السَعَةِ",1,"ه",1,0],["وَكَم زَوَّروا عَنهُ الأَراجيفَ وَاِدَّعوا","وَأَيّدَهُم ذَيّاكُمُ الزاهِدِ التَقي",2,"ق",2,0],["وَكَم زَفرَةٍ لي لَو عَلى البَحرِ أَشرَقَت","لَأَنشَفَهُ حَرٌّ لَها وَلَهيبُ",3,"ب",1,0],["وَكَم زُورِ قَولٍ قُلْتُمُ أَيُّ حُجَّةٍ","وَكَمْ حُجَجٍ لِلخائِنِينَ تُزَوَّرُ",4,"ر",1,0],["وَكَم زُفَّت إِلى جَدَثٍ عَروسٌ","وَقَد هَمَّت إِلى عُرُسٍ بِزَفِّ",5,"ف",1,0],["وَكَم زَلَّةٍ مُدَّت أَيادٍ لِدَفعِها","وَقَد عُلِّقَت مِن أَهلِها بِالعَراتِمِ",6,"م",1,0],["وَكَم زُرتَ أَحياءً فَلَم يُغنِ عَنهُمُ","طِعانٌ وَلا نَجّاهُمُ مِنكَ مَهرَبُ",7,"ب",1,0],["وكم زلَّة جددتها إثر زلَّة","تداركك الإمهال فيهن والحلم",8,"م",1,0],["وَكَم زارَ باريزاً ولُندرةً ولم","يَزُر مكّةً يَوماً ولا طيبةَ الغرّا",9,"ر",2,0],["وَكَم زوجةٍ منهم وزوجٍ تباغَضا","وكلٌّ قدِ اِستَغنى بأحبابهِ دهرا",10,"ر",2,0],["وَكَم زَوجةٍ حسناءَ لكنَّ زَوجها","تَضرّر مِنها حينَما عقرت عقرا",10,"ر",2,0],["وكم زلزلتَ دورهمُ","فخرَّ عليهم السقفُ",11,"ف",1,0],["وكم زحرةٍ تُبْدِينَها إثرَ زَحْرَةٍ","وجَرْجَرةٍ مخلوطةٍ بِسُعالِ",12,"ل",1,0],["وَكَم زَجَرَتهُم مِن سُطاكَ مَواعِظٌ","فَما نَفَعَ الوَعظُ المُنَهنِهُ وَالزَجرُ",13,"ر",1,0],["وكم زاهد في هذه الدار معرض","ومقتصر منها على حد بلغة",14,"ه",1,0],["وَكَم زَمَنٍ نُواصِلُهُ وَكُنّا","نَقولُ لِذاكَ كَيفَ قَطَعتَ عِشرَه",15,"ر",2,0],["وكم زارني عن غير وعد معذبي","وأحلى اللقا ما كان عن غير موعد",16,"د",1,0],["وكم زُرْنا من الأَملاكِ لكِنْ","تَلَتْ أَفْعالُهُم لَيْسوا سَواء",17,"ا",2,0],["وكم زهِرَتْ رياضُ دمٍ تغنّى","ذُبابُ حُسامه فيها ذُبابا",18,"ب",2,0],["وكم زَفْرَةٍ نَمَّتْ عَلَيْهِمْ بِحَسْرَةٍ","أَنَارَتْ بِنارِ السِّرِّ فِي عَلَمِ الجَهْرِ",19,"ر",1,0],["وكم زَجَروها بِاسْمِها وحُقُوقِهَا","فما صَدَقَتْهُمْ لا ثَرَاءً ولا ثَرْيا",20,"ي",2,0],["وكم زحَمتكم قبلَها من مُلِمَّةٍ","فطاحت رُفاتاً والجبالُ جبالُ",21,"ل",1,0],["وكم زاحمتْها صروفُ الزما","ن قبلُ فكانت عليها ثقالا",22,"ل",2,0],["وكم زائرٍ منّا حملتَ اقتراحَه","مضى ساحباً رِجْلاً وآب مقوَّدا",23,"د",2,0],["وكم زوْرة قابلتُّها بتجنُّبٍ","ومبذولِ وصلٍ رعتُه بالقطائعِ",24,"ع",1,0],["وكم زارني سَلْمَ اللقاءِ وأنهُ","من الحُسن شاكٍ في السلاح مقاتلُ",25,"ل",1,0],["وكم زارني في جنح ليلٍ خيالها","فأبصر منّي خاشعَ القلب أوّاها",26,"ا",3,0],["وكم زَيَّقْتُ أَقوالاً أراها","من الإنصاف ما أخذتْ نصيبا",27,"ب",2,0],["وكم زلة عظمى على اثر زلةٍ","سمحت وكم عيباً أرى فأطبق",28,"ق",1,0],["وكَمْ زرتُ منه قبرَه فرأَيتُه","بعَيْنِ ضميرِي قَائِماً يَتَلقَّاني",29,"ن",2,0],["وكم زعموا العلوم تسيء خلقا","وتفسد في الخدور مخدرات",30,"ت",1,0],["وَكَم زاغَ عَن خَط الشَتات محارب","أَحاطَت بِهِ الأَخطار في كُل خُطوة",31,"ه",1,0],["وَكَم زادَ بِالأَوقاف نُور مَساجد","يصلِّي بِها ما شاء في اللَيل صائم",32,"م",1,0],["وكم زمر تابعت زمرا","ميمة دانيات القرى",33,"ر",2,1],["وكم زريتُ على صَبٍّ يقول إذا","نَاءَاهُ محبوبه يا مهجتي داجي",34,"ج",2,0],["وَكَم زايلت في أعداك هاماً","فأصبحَ هامُهم أفراخ هامِ",35,"م",1,0],["وَكَم زفرةٍ في الحشا بعد زفرةٍ","يَكادُ لَها تقتضُّ منّي الأضالعُ",36,"ع",1,0],["وَكَم زَهرَةٍ فَتّحَتَ وَهِيَ كَمامَةٌ","وَلَم تَجنِ غَير البيضِ مِن فَتحِها زَهرا",37,"ر",2,0],["وكم زمهرير منك فت الجلامدا","أهل منك نرجو بعد ذاك فوائداً",38,"ا",1,0],["وَكَم زَوجَةٍ سَكرى العُيونِ حَزينَةٍ","تَوَزَّعَها التَرميلُ وَالثُكلُ وَالسقمُ",39,"م",1,0],["وكم زرتها شوقا على بعد شقة","على رحل من سرت نصا ولا وخدا",40,"د",2,0],["وكم زرتها في ملعب تلتقى به","عطابيل أمثال النجوم الصوابح",41,"ح",1,0],["وكم زمن أراه قد تعدى","علي وإنني فيه صبور",42,"ر",1,0],["وكم زان منك الجيد فضلاً ونائلاً","مليك له في عصره الحل والعقد",43,"د",1,0],["وكم زائرٍ ظام أتى نحو منهلي","فلمّا ارتوى منه عراه صدود",44,"د",1,1],["وكم زادهم معن بن زائدةٍ جدىً","وكان عليهم بحر حلم تدفقا",45,"ق",2,0],["وكم زمنٍ قطَعْنا في التَّصابِي","حَسِبنا غَيّنا فيهِ رشادَا",46,"د",2,0],["وكم زار مغناكِ المعظمَ مُجرِمٌ","فخطَّت به عنه الخطايا العظائمُ",47,"م",1,0],["وكم زهرٍ تألَّقَ جُلَّناراً","بقاني ورد هاتيكَ الخُدودِ",48,"د",1,0],["وكم زارَني بؤسٌ وخضتُ عُبابهُ","وذلَّلت في عَزمي سُدوفاً واجوفا",49,"ف",2,0],["وكم زمينٍ ذليل جاءَ ذا عظمٍ","يَخلو لهُ في رهان السَبق مِضمارُ",50,"ر",1,0],["وكم زُرتُ ربّاتِ الحجال وزُرنني","برأي مطاع في الهوى وحجاً معصي",51,"ص",2,0],["وكم زبونٍ رأينا في (المنار) وكم","في (العيد) كلٌّ على ما يبتغي حصلا",52,"ل",2,0],["وكم زعانف مأفونين تنصبهم","في الأوج تنفخهم كالزق تمويها",53,"ي",3,0],["وكم زماناً طويلاً ظلت أعذله","فقال قولاً صحيحاً صادق المثل",54,"ل",1,0],["وكم زرع اشوفه ماتعب فيه فلاح","واثمرلوانه ماجهد فيه عارق",55,"ق",1,0],["وَكَمْ زاجِرٍ طَيْرَ سَعْدٍ غَدا","عَلَيْهِ مِنَ الشُّؤْمِ يَحْكِي قَدارا",56,"ر",2,0],["وَكَمْ زايَلْتَ مِنْ أَعْداكَ هاماً","فأَصْبَحَ هامُهُمْ أَفراخَ هامِ",57,"م",1,0],["وَكَمْ زَفْرَةٍ لِي فِي الحَشا بَعْدَ زَفْرَةٍ","تَكادُ لَها تَنْقَضُّ مِنِّي الأَضالِعُ",58,"ع",1,0],["وكم زرت من \"واتس\" فكان مُشفّراً","ومن قبل كان \"الواتس\" يمنحني عطرا!!",59,"ر",2,0],["وَكَمْ زَارَ \"الْمُخَّيَمَ\" مِنْ فَقِيِهٍ","سِيَاسِيٍّ لَهُ وَجْهٌ صَبِيحُ",60,"ح",1,0],["وكم زعموا أن الخلاعة مذهبي","نعم فاتركوا لي مذهبي وشعاري",61,"ر",2,0],["‏وكم زرعت ورود الحب أنثرها","‏وسط القلوب فيؤذي شوكهم قدمي",62,"م",2,0],["وَكَمْ زُجِرْتُ مِنَ الأَصَحَابِ فَانْتَصَبَتْ","أَطْيَابُ جِيْدكَ تَنْهى كُلَّ مَنْ زَجَرُوْا",63,"ر",3,0],["وَ كَمْ زَهَرٍ قَطَفْنَا فِي أَوَانٍ","فَلَسَّعَ جِلْدَنَا نَحْلٌ طَنِينُ",64,"ن",1,0],["وكمْ زِينَةٍ رفَّ فيها الجَمّالُ","يُطَهِّرُ أَشْوَاقَنا والحَنِين",65,"ن",1,0]]}