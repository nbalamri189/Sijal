{"poems":[[95,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[74,"مبلبل الأصداغ والطره","https://www.aldiwan.net/poem18697.html","السريع"],[93,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[94,"إن الحياة صراع","https://www.aldiwan.net/poem38937.html","المجتث"],[87,"دع ما يضرك والتمس ما ينفع","https://www.aldiwan.net/poem7127.html","الكامل"],[47,"عند العقيق فماثلات دياره","https://www.aldiwan.net/poem63562.html","الكامل"],[63,"للخالديين جمال منظر","https://www.aldiwan.net/poem51665.html","الرجز"],[107,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[104,"إخواننا أهل الوفاء","https://www.aldiwan.net/poem32979.html","مجزوء الكامل"],[50,"يا أيها العاذل دع ملحاتي","https://www.aldiwan.net/poem62460.html","الرجز"],[48,"للخير منزلتان عند معاشر","https://www.aldiwan.net/poem23251.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55197","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54774","الكامل"],[108,"تحيّة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179608",""],[96,"لبنان والغوطتان","https://www.poetsgate.com/ViewPoem.aspx?id=15652",""],[53,"أقسمتُ والحنثُ له آثامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30408",""],[147,"ما لي مقال عن فعالك يعرب","https://www.aldiwan.net/poem11728.html","الكامل"],[190,"لا تحسنن إلى الشرير مطلبا","https://www.aldiwan.net/poem43966.html","البسيط"],[193,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[415,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[415,"إن خان عهدك من توده","https://www.aldiwan.net/poem32602.html","مجزوء الكامل"],[543,"قال البيان لمن أراد مديحه","https://www.aldiwan.net/poem48155.html","عموديه"],[567,"أعلمت ما بالقلب من نار الجوى","https://www.aldiwan.net/poem52852.html","الكامل"],[580,"أوحشني الأوانس","https://www.aldiwan.net/poem3056.html","مجزوء الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138363",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87205","الرجز"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87274","الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87102","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87272","الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86588","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48747","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96677","الكامل"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69189","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79868","السريع"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132225","المجتث"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96035","الكامل"],[2455,"","https://poetry.dctabudhabi.ae/diwan/poem/147733","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87326","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94121","الرمل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82823","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48279","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48292","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66473","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109976","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133297","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69919","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119633","الرجز"],[4166,"","https://poetry.dctabudhabi.ae/diwan/poem/203266","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94987","الكامل"],[4332,"","https://poetry.dctabudhabi.ae/diwan/poem/73641","البسيط"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117278","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83178","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72459","الكامل"],[3464,"بشرى سيوط لها المقام الأصعدُ","https://www.poetsgate.com/ViewPoem.aspx?id=158749",""],[4767,"الذكر الخالد","https://www.poetsgate.com/ViewPoem.aspx?id=179785",""],[4767,"بدور شعبان","https://www.poetsgate.com/ViewPoem.aspx?id=197676",""],[4578,"للموت حكمٌ نافذٌ في الناس","https://www.poetsgate.com/ViewPoem.aspx?id=49444",""],[4929,"الى أصحاب قمة اسطنبول","https://www.poetsgate.com/ViewPoem.aspx?id=199263",""],[4978,"عين سارة","https://www.poetsgate.com/ViewPoem.aspx?id=177199",""],[4988,"للخالدية جابني الشوق من غاد","https://www.poetsgate.com/ViewPoem.aspx?id=214086",""],[5376,"طار الفؤاد كأنَّ الطير ساكنه","https://www.poetsgate.com/ViewPoem.aspx?id=188319",""],[5376,"يا غزة هاشم قد جئنا","https://www.poetsgate.com/ViewPoem.aspx?id=198235",""],[5542,"شموخ اليتيم","https://www.poetsgate.com/ViewPoem.aspx?id=10072",""],[5545,"وَهَبتُكَ قَلبًا","https://www.poetsgate.com/ViewPoem.aspx?id=184929",""],[5690,"لما أعاد مليكنا","https://www.poetsgate.com/ViewPoem.aspx?id=172280",""],[402,"يا هند لم يخطيء أبوك","https://www.poetsgate.com/ViewPoem.aspx?id=35502",""],[5827,"وتسارعت أعمارنا","https://www.poetsgate.com/ViewPoem.aspx?id=207781",""],[5894,"لولا الهوى ما التوى سقم على رجل","https://www.poetsgate.com/ViewPoem.aspx?id=131432",""],[5969,"سِفرُ الخلاصْ","https://www.poetsgate.com/ViewPoem.aspx?id=198863",""],[5976,"الوقت والناس","https://www.poetsgate.com/ViewPoem.aspx?id=30351",""],[6102,"لا نامت أعين الجبناء ..","https://www.poetsgate.com/ViewPoem.aspx?id=184861",""]],"verses":[["لِلْخَصْمِ فِي ثَلبِهَا عذْرُ الحَنِيقِ عَلَى","مَنْ حَالَ بَيْنَ يَدِ السَّلاَّبِ والسَّلَبِ",0,"ب",1,0],["للخَلق والخُلق على وجهه","نوران ردا ناظر الأمرَه",1,"ر",2,0],["لِلخُبزِ طاعَتُهُ وَحُسنُ وَلائِهِ","هُوَ لاتُهُ الكُبرى وَبَرهَمُهُ",2,"ه",1,0],["للخِبِّ فيها شجونٌ","فكُنْ فتى الإحتراسْ",3,"س",1,0],["للخلق صبيان كما لك صبية","ولهم لباس فارقوه ومضجع",4,"ع",1,0],["لَلخِضرُ في شُبَهِ الخُطوبِ وَرَأيُهُ","كَالسَيفِ في حَمَسِ الوَغى وَغَرارِهِ",5,"ر",2,0],["للخالديَّينِ جَمالُ مَنْظَرِ","وبِزَّةٌ تَملأُ عينَ المُبصِرِ",6,"ر",1,1],["للخيلِ حَمحمةٌ تُراعُ لهولها","صِيدُ الفوارسِ والعِتاقُ القُرَّحُ",7,"ح",1,0],["للخاملين نباهة","فيها وللأغمارِ ذكرُ",8,"ر",1,0],["لِلخاطِبِ المُبتَكِرِ المُواتي","فَسَمُّها بِالشَيخِ لا الفَتاةِ",9,"ت",3,0],["لِلخَيرِ مَنزِلَتانِ عِندَ مَعاشِرٍ","وَلَهُ عَلى رَأيٍ ثَلاثُ مَنازِلِ",10,"ل",1,1],["لِلخِصْبِ والإِقبَالِ أَعْلَى دَوْلَةً","فِيها وَعفَّى دوْلَةً الإِمْحالِ",11,"ل",1,0],["لِلْخَيْرِ أَنْهَارٌ بِهَا","فَيَّاضَةٌ لَبَناً وَشَهْدَا",12,"د",2,0],["للخلد صِنوٌ: وصنو الخلد لُبنَانُ","قم سائل القوم: مَنْ في القوم رِضوانُ؟",13,"ن",1,1],["للخلف في الناس أنواع وأغربها","خلف الشقيقين من قومي بلا سبب",14,"ب",1,0],["للخير فعَّالٌ به هَمّامُ","تُورقُ من معروفهِ السّلامِ",15,"م",1,0],["لِلخَطبِ تَنفيهِ فَلَيسَ بِعائِدٍ","وَالأَمرِ تُمضيهِ فَلا يُتَعَقَّبُ",16,"ب",1,0],["للخير أهل إذا أوليتهم حسنا","أولوك شكرا وخير البر أوحده",17,"د",2,0],["للخيرِ والغرّ الكرامِ قائدُ","خازنُ مالِ اللَّه نعم الواجدُ",18,"د",1,0],["للخيرِ والشَّرِّ ما تَنفكُّ حافظةً","حتى تَشيعَ سماعاً أو ملاحظَةً",19,"ه",1,0],["للخَمرِ ريقَتُهُ ولل","وردِ الجنيِّ النّضْرِ خَدُّهْ",20,"د",2,0],["للخير والإصلاح سار بشعبه","وكذا بشعبهم الملوك تسير",21,"ر",1,0],["للخِضْرِ أخلاقٌ يكادُ ثناؤُها","يَخَضرُّ منهُ كلُّ عُودٍ قدْ ذَوَى",22,"و",2,0],["للخمسةِ الأَشباح في","تقواكَ أَنْتَ سادِسْ",23,"س",1,0],["للخير في العمل اشرعوا لا تأملوا","رؤساء دين وحدهم أن يعملوا",24,"ل",3,0],["لِلخُلد سارَت فَاِرتَقَت","فيها رَفيع الأَمكِنَهْ",25,"ن",2,0],["للخديوي وَأَبيهِ","وَابنه الشبل النَبيهِ",26,"ه",1,0],["للخديوي في مصر عيدُ إِمامِ","لَستُ أُحصي أَوصافه في إِمامِ",27,"م",1,1],["لِلخديويّ الكَريمِ","صاحب القَلب الرَحيمِ",28,"م",1,0],["لِلخَير مَناع عُتُلٌّ معتدٍ","بِنميمة بَينَ الوَرى مَشّاء",29,"ا",2,0],["للخصم أم لكم المستوزرون به","أقرَّ مَن ضرها يوماً ومن نفعا",30,"ع",2,0],["لِلخيرِ في الدنيا توابعُ مثل ما","للشرِّ فيها للمُصابِ توابعُ",31,"ع",1,0],["لِلخَير وَالشَرِّ أهلٌ وُكِّلوا بِهما","كُلٌّ لَه مِن دَواعي نفسه هادي",32,"د",2,0],["للخلف في تناسب والفرق في","ألفها مع غيره لا يختفي",33,"ي",1,0],["للخلف ابن الحسن القائم ال","مهديّ أتقى الخلق أهداها",34,"ا",3,0],["للخائفين دواما","حاء وراء وزاء",35,"ا",2,0],["للخطب ساعة طبق","الدنيا بداهية تآدي",36,"د",2,0],["للخبز أحسن شيء في الزنابيل","والزيت أجمل شيء في القناديل",37,"ل",1,1],["للخنِّ في الحُقَّةِ من هذا الدَّرَج","إحدى عَشَر وربعُ ما فيه حَرَج",38,"ج",1,0],["للخديوي الداوري كم منشآت","حسنها الباهي له بالفضل يشهد",39,"د",1,1],["لِلخَيرِ قد وُفِّقوا في كُلِّ ما عَمِلوا","بِنورِ أَفكارِهِم فاقوا الوَرى ذِهنا",40,"ن",2,0],["للخطّ والخَطّيِّ فيها آيةٌ","مَهْما أرَتْكَ جِلادَها وجدالَها",41,"ل",3,0],["للخَزْرَجيّينَ الألى لكَ نِسبةٌ","طاوِلْ بها ذُبْيانَها أو عبْسَها",42,"س",3,0],["للخشف مقلته وللغصن البه","ي قوامه مهما تأوّه أو مشى",43,"ش",2,0],["للخيرِ أَسلَم مصدرٍ ونظيرُهُ","ما قد يُصرَّف عن حِجاهُ ويَصدُرُ",44,"ر",1,0],["للخلوتية في الطريق موارد","لكنها عن ورد هذا صادره",45,"ر",2,0],["للخَيرِ شيدَها وَالرَب ايَّدها","وَالحُب وَطدها للدهرِ لا تَقع",46,"ع",1,0],["للخير والتقى غدت جماعة","وبددوا أعوانه في ساعة",47,"ه",1,0],["للخير والشر إيضاح به فبدا","أمر وعن ذاك فهي حسب نصحهم",48,"م",1,0],["للخلد مذ سارت بأرخٍ روحه","نال الصفا سمعان في حضن الصفا",49,"ف",2,0],["لِلخَلقِ في حُسنِهِ اِفتِتانٌ","فَهامَ ناسٌ وَهَمَّ ناسُ",50,"س",1,0],["للخلق أرسلَ شاهدا ومبشرا","ومُشفهاً في المذنبين ومنذرا",51,"ر",2,0],["لِلخُلقِ وَالعَقلِ نُورٌ في صَحائِفها","فَما يَحُومُ بِها غِلٌّ وَأَحقادُ",52,"د",1,0],["للخضر كنت بمجمع الب","حرين عش ما شئت خضرا",53,"ر",2,0],["للخضر ظاهرها وباطنها به","إسكندر عينَ الحياة يورِّد",54,"د",1,0],["للخطاب الذي يُدَوِّي صداه","إنه كان بالنوايا عليما",55,"م",2,0],["للخلد تاقت نفسُ زائرِه","ترنو إليه وفيه تنصهر",56,"ر",1,0],["للخلق وافت منه ليلةُ ثامن","بوفاة عبد القادر النحاس",57,"س",1,0],["للخاذلين الخزيُ في دنيا الورى","وعقابُ يومَئذٍ اشدُّ وأثقلُ",58,"ل",1,0],["للخصم منذ ادعوها ثورةً وجدوا","وما له غيرُهمْ في أمْرِنا بدلُ",59,"ل",1,0],["للخالدية جابني الشوق من غاد","يا حي اهلها وحي داعي دعاني",60,"ن",2,1],["للخالدية واهلها البوح ينقاد","ومحصنه ابأيات سبع المثاني",60,"ن",2,0],["للخالدية جابنا الشوق من غاد","ولأهلها الوافين سقنا التهاني",60,"ن",2,0],["للخلِّ طيبٌ يحاكي الوردَ أطيبَه","وفي هواه كأنَّ القلبَ آذنُه",61,"ن",2,0],["للخالق تركع غزتنا","والشعب لخالقها يركعْ",62,"ع",1,0],["للخير أغصانٌ تطيب ثمارُها","فامنحْ جَناها خائفاً وعَديما",63,"م",2,0],["للخَلقِ أفئدةٌ تَأوي لِمَن عَشقَتْ","وَ إنني مُستَميتٌ خافقاً وَحَشا",64,"ش",2,0],["للخارجيةِ راشداً","طفح السرور على البريَّةْ",65,"ي",2,0],["للخير أنهار بها","فيضاة لبنا وشهدا",66,"د",2,0],["للخيرِ فاعمل جاهداً","فبهِ سيرضى ذوالجلالْ",67,"ل",1,0],["للخل أشكو عذاب الوجد والهفى","فلم يجبني بشيء مبرئ العلل",68,"ل",1,0],["للخوفِ سَطوَتُهُ إذا ما عشتَهُ","وَكَذا التَأوهُ فِكرَةٌ وَشُعورُ",69,"ر",1,0],["للخير آذان ٍ وللشر مزمار","والقلب له ما طاب له بانقياده",70,"د",2,0],["لِلخائِنِينَ الذِينَ قَد جَبُنُوا","قُولُوا: (فَلا نَامَتْ أَعيُنُ الجُبَنا)",71,"ن",2,0]]}