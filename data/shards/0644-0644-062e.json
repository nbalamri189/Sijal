{"poems":[[93,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[72,"مبلبل الأصداغ والطره","https://www.aldiwan.net/poem18697.html","السريع"],[91,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[92,"إن الحياة صراع","https://www.aldiwan.net/poem38937.html","المجتث"],[85,"دع ما يضرك والتمس ما ينفع","https://www.aldiwan.net/poem7127.html","الكامل"],[45,"عند العقيق فماثلات دياره","https://www.aldiwan.net/poem63562.html","الكامل"],[61,"للخالديين جمال منظر","https://www.aldiwan.net/poem51665.html","الرجز"],[105,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[102,"إخواننا أهل الوفاء","https://www.aldiwan.net/poem32979.html","مجزوء الكامل"],[48,"يا أيها العاذل دع ملحاتي","https://www.aldiwan.net/poem62460.html","الرجز"],[46,"للخير منزلتان عند معاشر","https://www.aldiwan.net/poem23251.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55197","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54774","الكامل"],[106,"تحيّة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179608",""],[94,"لبنان والغوطتان","https://www.poetsgate.com/ViewPoem.aspx?id=15652",""],[51,"أقسمتُ والحنثُ له آثامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30408",""],[144,"ما لي مقال عن فعالك يعرب","https://www.aldiwan.net/poem11728.html","الكامل"],[187,"لا تحسنن إلى الشرير مطلبا","https://www.aldiwan.net/poem43966.html","البسيط"],[190,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[410,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[410,"إن خان عهدك من توده","https://www.aldiwan.net/poem32602.html","مجزوء الكامل"],[539,"قال البيان لمن أراد مديحه","https://www.aldiwan.net/poem48155.html","عموديه"],[563,"أعلمت ما بالقلب من نار الجوى","https://www.aldiwan.net/poem52852.html","الكامل"],[576,"أوحشني الأوانس","https://www.aldiwan.net/poem3056.html","مجزوء الرجز"]],"verses":[["لِلْخَصْمِ فِي ثَلبِهَا عذْرُ الحَنِيقِ عَلَى","مَنْ حَالَ بَيْنَ يَدِ السَّلاَّبِ والسَّلَبِ",0,"ب",1,0],["للخَلق والخُلق على وجهه","نوران ردا ناظر الأمرَه",1,"ر",2,0],["لِلخُبزِ طاعَتُهُ وَحُسنُ وَلائِهِ","هُوَ لاتُهُ الكُبرى وَبَرهَمُهُ",2,"ه",1,0],["للخِبِّ فيها شجونٌ","فكُنْ فتى الإحتراسْ",3,"س",1,0],["للخلق صبيان كما لك صبية","ولهم لباس فارقوه ومضجع",4,"ع",1,0],["لَلخِضرُ في شُبَهِ الخُطوبِ وَرَأيُهُ","كَالسَيفِ في حَمَسِ الوَغى وَغَرارِهِ",5,"ر",2,0],["للخالديَّينِ جَمالُ مَنْظَرِ","وبِزَّةٌ تَملأُ عينَ المُبصِرِ",6,"ر",1,1],["للخيلِ حَمحمةٌ تُراعُ لهولها","صِيدُ الفوارسِ والعِتاقُ القُرَّحُ",7,"ح",1,0],["للخاملين نباهة","فيها وللأغمارِ ذكرُ",8,"ر",1,0],["لِلخاطِبِ المُبتَكِرِ المُواتي","فَسَمُّها بِالشَيخِ لا الفَتاةِ",9,"ت",3,0],["لِلخَيرِ مَنزِلَتانِ عِندَ مَعاشِرٍ","وَلَهُ عَلى رَأيٍ ثَلاثُ مَنازِلِ",10,"ل",1,1],["لِلخِصْبِ والإِقبَالِ أَعْلَى دَوْلَةً","فِيها وَعفَّى دوْلَةً الإِمْحالِ",11,"ل",1,0],["لِلْخَيْرِ أَنْهَارٌ بِهَا","فَيَّاضَةٌ لَبَناً وَشَهْدَا",12,"د",2,0],["للخلد صِنوٌ: وصنو الخلد لُبنَانُ","قم سائل القوم: مَنْ في القوم رِضوانُ؟",13,"ن",1,1],["للخلف في الناس أنواع وأغربها","خلف الشقيقين من قومي بلا سبب",14,"ب",1,0],["للخير فعَّالٌ به هَمّامُ","تُورقُ من معروفهِ السّلامِ",15,"م",1,0],["لِلخَطبِ تَنفيهِ فَلَيسَ بِعائِدٍ","وَالأَمرِ تُمضيهِ فَلا يُتَعَقَّبُ",16,"ب",1,0],["للخير أهل إذا أوليتهم حسنا","أولوك شكرا وخير البر أوحده",17,"د",2,0],["للخيرِ والغرّ الكرامِ قائدُ","خازنُ مالِ اللَّه نعم الواجدُ",18,"د",1,0],["للخيرِ والشَّرِّ ما تَنفكُّ حافظةً","حتى تَشيعَ سماعاً أو ملاحظَةً",19,"ه",1,0],["للخَمرِ ريقَتُهُ ولل","وردِ الجنيِّ النّضْرِ خَدُّهْ",20,"د",2,0],["للخير والإصلاح سار بشعبه","وكذا بشعبهم الملوك تسير",21,"ر",1,0],["للخِضْرِ أخلاقٌ يكادُ ثناؤُها","يَخَضرُّ منهُ كلُّ عُودٍ قدْ ذَوَى",22,"و",2,0],["للخمسةِ الأَشباح في","تقواكَ أَنْتَ سادِسْ",23,"س",1,0]]}