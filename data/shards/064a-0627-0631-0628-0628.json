","https://www.poetsgate.com/ViewPoem.aspx?id=187696",""],[5338,"لي في هباتك حيرة لا توصف","https://www.poetsgate.com/ViewPoem.aspx?id=187913",""],[5338,"معارضة قصيدة بات سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=187941",""],[5413,"إنا بفراقكما لمحزونون","https://www.poetsgate.com/ViewPoem.aspx?id=208634",""],[5431,"الحب معجزة","https://www.poetsgate.com/ViewPoem.aspx?id=191865",""],[5458,"ألا بذكر الله تطمئن القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=72385",""],[5605,"رحلة عابر","https://www.poetsgate.com/ViewPoem.aspx?id=159458",""],[5781,"نَصْرٌ ووعد","https://www.poetsgate.com/ViewPoem.aspx?id=190950",""],[5829,"في مخيم الكشافة","https://www.poetsgate.com/ViewPoem.aspx?id=161989",""],[5829,"هل الهلال فهللوا","https://www.poetsgate.com/ViewPoem.aspx?id=180665",""],[5897,"وللأنس مجلس !","https://www.poetsgate.com/ViewPoem.aspx?id=157551",""],[5926,"شهر الصيام","https://www.poetsgate.com/ViewPoem.aspx?id=214310",""],[5953,"يا أيها الأول الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=93785",""],[5956,"عالم الأطفالِ","https://www.poetsgate.com/ViewPoem.aspx?id=193155",""],[5956,"هذا الحسامُ نموذج فعَّالُ","https://www.poetsgate.com/ViewPoem.aspx?id=204690",""],[5956,"يا أبا ثابت أرجوك قل لسميةَ الحسناءا","https://www.poetsgate.com/ViewPoem.aspx?id=205164",""],[5956,"ترعَى الصداقةَ كندةُ الحمدونُ","https://www.poetsgate.com/ViewPoem.aspx?id=207260",""],[6003,"عيد الاستقلال","https://www.poetsgate.com/ViewPoem.aspx?id=189045",""],[6068,"القلب بين محبة ووفاق -11-","https://www.poetsgate.com/ViewPoem.aspx?id=175851",""],[6093,"رمضانُ أقبل ( البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176206",""]],"verses":[["يَارَبِّ بَارِكْ لِمَنْ بَنَانِي","فِي الْفِكْرِ والْقَلْبِ والْبَيَانِ",0,"ن",1,0],["يا رُبَّ بشرٍ منه طائيَّ الندى","يلقى مدائحاً لقاء حبيب",1,"ب",1,0],["يا رُبَّ بصريٍّ رصاصيِّ الشَّمَطْ","عاندني فلو تنفَّستُ ضَرَطْ",2,"ط",1,1],["يا رب بالرسل الكرام بآلهم","باللوح والكرسى وهو المفزع",3,"ع",1,0],["يا رَبِّ بِعيسى وَالهادي","وَبِموسى خُذ بِيَدِ الوَطَنِ",4,"ن",1,0],["يا رُبَّ بَرقٍ شِمتُهُ","عادَت مَخيلَتُهُ عَجاجا",5,"ج",2,0],["يا رُبَّ باكٍ عَلى مَيتٍ وَباكِيَةٍ","لَم يَلبَثا بَعدَ ذاكَ المَيتِ أَن بُكِيا",6,"ي",2,0],["يا ربُّ بالهادي البشيرِ محمدٍ","وبدينِهِ العالي على الأديانِ",7,"ن",1,1],["يا ربُّ بالهادي النبيِّ المجتبى","أغمدْ عنِ الإسلامِ أسيافَ الوبا",8,"ب",2,1],["يا رُبَّ بَيتٍ زُرتُهُ فَكَأَنَّما","قَد ضَمَّني مِن ضيقِهِ سِجنُ",9,"ن",1,1],["يا رُبّ بِكْرٍ من ليالي حَرْبِهِ","فيهم يُعَدُّ مِثالُها من عُونه",10,"ن",2,0],["يا رُبَّ بَيتٍ بِفَضاءٍ سَبسَبِ","بَعيدِ بَينَ السَمكِ وَالمُطَنَّبِ",11,"ب",1,1],["يَا رَبِّ بِالْمُصْطَفَى هَبْ لِي وَإِنْ عَظُمَتْ","جَرائِمِي رَحْمَةً تُغْنِي عَنِ الْحُجَجِ",12,"ج",1,0],["يا رُبَّ باكِيَةٍ مَعي قَد رابَها","فِعلٌ مِنَ المُتَمَلِّقينَ خَسيسُ",13,"س",1,0],["يا رب بيت قد ضننت ببذله","ضناً على من ليس من سُكّانه",14,"ن",2,0],["يا رُبَّ بحثٍ مغلقٍ","بيديهِ عالج فتحَ بابه",15,"ب",2,0],["يا رُبَّ ببيتٍ قد ضَننْتُ ببذله","ضنًّا على من ليس من سُكَّانه",16,"ن",2,0],["يا رَب بَدري غابَ عَن طَرفي وَفي","سحب النَوى طول المَدى يَتحجب",17,"ب",1,1],["يا رب بالمختار فرج كربتي","يا واحدا للمستغيث غياث",18,"ث",1,0],["يا رب بالشيخ على الجمي","شيخ شيوخ القوم أهل الهمم",19,"م",1,0],["يا رب بالشيخ أبى الفضل الأسد","إمام أهل الزي صاحب المدد",19,"د",1,0],["يا رب بالشيخ على الواسطي","حائز نور القرب بالوسائط",19,"ط",1,0],["يا رب بالشيخ أبى بكر الأجل","قطب زمانه الرفاعي البطل",19,"ل",1,0],["يا رب بالمرخص المجاز","شيخ الورى محمد الحجازي",19,"ي",1,0],["يا رب بالشيخ أبى بكر الونى","كنز المعاني صاحب السر الجلي",19,"ي",1,0],["يا رب بالشيخ الجليل مصطفى","الورع الزاهد صاحب الوفا",19,"ف",2,0],["يا رب بالشيخ الهمام أحمد","سلالة العباس شيخي الأمجد",19,"د",1,0],["يا رب بالسلسلة اللطيفه","بالقوم أهل الحانة الشريفة",19,"ه",1,0],["يا رب بطه سر الوجود المختار","والرسل شموس الوجود أهل الأسرار",20,"ر",1,1],["يا رب بطه سلطان أهل العرفان","والرسل كرام الأنام أصحاب الشان",21,"ن",1,1],["يا رب بطه مولى ملوك الأكوان","والرسل صدور الوجود أهل البرهان",22,"ن",1,1],["يا رب باب لم أجد مفتاحه","ورب ستر رمت أن أباحه",23,"ح",2,1],["يا رب بالقوم الكرام أحبة","القدر العلى وحبه الأواب",24,"ب",1,0],["يا رب بلغهُ لما لا ينتهي","ملكٌ إليه لا يرامُ منالا",25,"ل",2,0],["يا رُبَّ بدرٍ بات يُرْشِف مِسْمَعي","وفمي شَهِيَّ رُضابِه وحَديثه",26,"ث",2,1],["يا رب بالهادي الشفيع محمد","أسعده في يوم المعاد بلا خفا",27,"ف",2,0],["يا رَبِّ باِبنِ البَتولِ حُطنى","وَزِن مقامي وطهِّرِ اسمى",28,"م",2,0],["يا رُبَّ بِكرٍ عاتِقٍ","حُطَّت إِلَينا مِن عَلِ",29,"ل",1,1],["يَا رَبِّ بِالْمُصْطَفَى الْهَادِي وَشِيعَتِهِ","إِغْفِرْ لَنَا وَتَجَاوَزْ عَنْ مَسَاوِينَا",30,"ن",2,0],["يَا رَبِّ بِالْمُصْطَفَى الْمُخْتَارِ سَيِّدِنَا","مُحَمَّدٍ مَنْ سَرَى لَيْلاً إِلَى الأُفُقِ",31,"ق",1,1],["يَا رَبِّ بِمَنْ حَفِظْتَ حُطْنَا","وَالْطُفْ أَبْدَانَنَا وَحُصْنَا",32,"ن",2,1],["يا ربّ بالمصطفى الشفيع أغث","من بات مستمطراً لرحمتكا",33,"ك",2,0],["يا رُبَّ بيضٍ سَلَلن البيضَ مِن حَدَقٍ","سودٍ وَمِسنَ بِأعطافِ القَنا الذُّبُلِ",34,"ل",1,0],["يا رَبّ بِالأَسماء نَدعوك وَبالص","صِفات وَالأَوصاف يا غَوث الوَرى",35,"ا",1,0],["يا رَب بِالمُصطَفى الهادي وَصاحِبُه","في الغارِ ثُم شَهيد الدار ثُم على",36,"ل",2,0],["يا ربّ بالعلماء أعلام الهُدى","العاملين بما تقول وتأمر",37,"ر",1,0],["يا رُبَّ بَيتٍ بِالجَزي","رَةِ بِتُّ أَعمُرُ بَيتَ عُمرِه",38,"ر",2,1],["يا رب بكل بارزٍ غيبي","يجلى وبكل مغلقٍ طمسي",39,"ي",1,1],["يا رب باك لي غدا","في النائبات وباكيه",40,"ي",2,0],["يا رُبَّ باكيةٍ عَليَّ","وَمُنشِدٍ لي في المَجالِس",41,"س",1,0],["يا رَب بالإِحسان عامل سائِلاً","يَرجو بِدار المتقين مَقاما",42,"م",2,1],["يا رب بلّغه جميع رجائه","لأبي الوليد وزده ما لم يرتج",43,"ج",1,0],["يا رب بالبيض الوجو","ه نجوم حضرتك الطوالع",44,"ع",1,0],["يا رب بابك بابه","ورجاي فيك وفيه طامع",44,"ع",1,0],["يا ربِّ بالحِمامِ","خُذهُم وَكُن أَنتَ المُبيرْ",45,"ر",1,0],["يا رَبِّ بِالأَسماءِ","يا مُوْلِيَ الآلاءِ",46,"ا",2,0],["يا ربِّ بالملائِكِ","بِالمُتّقي وَالناسكِ",46,"ك",1,0],["يا رَبِّ بَدِّدْ شَملَهُم","يا رَبِّ عَجِّل قَتلَهُم",46,"م",1,0],["يا رَبِّ بِالصّواعِقِ","وَبِالعَذابِ الساحِقِ",46,"ق",1,0],["يا رَبِّ بِالشّيخِ الشّهيدْ","عُثماننا 