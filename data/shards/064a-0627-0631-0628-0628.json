د بَيننا واردد عليّ","يَ بِأَوبةٍ نفساً تهيمُ وَتشحط",75,"ط",1,0],["يا رب بالهادي الرسول أبي الحسن","قُطبِ الورى والشاذلي أبي الحسن",76,"ن",1,1],["يا ربِّ بالهادي الشفيعِ الشافي","كهفِ الورى كنزِ البرايا الكافي",77,"ف",2,1],["يا رب بلغ جميع القوم طلبتهم","فأنت في الكل فعال ومختار",78,"ر",1,0],["يا رب بلغ رجال الشرع مطلبهم","فما لفضلك حد قط محدود",79,"د",1,0],["يا ربِّ بالأحد والاثنينِ","فاغفر ذنوبي ثاني الاثنينِ",80,"ن",1,1],["يا ربِّ بالقِدَم والبقاءِ","حُطنا عن الشرور والأعداءِ",81,"ا",2,0],["يا ربِّ بالأولِ مع بالآخرِ","حُطنا بحفظٍ عن جميع جائرِ",81,"ر",1,0],["يا ربِّ بالظاهرِ مع بالباطنِ","حُطنا بحفظٍ عن شرور الكائنِ",81,"ن",1,0],["يا ربِّ بالحفيظِ حفظك يدورْ","دنيا علينا معها يوم النشورْ",81,"ر",1,0],["يا ربِّ بالأذان والإقامهْ","بك فَوالِنا بك السلامهْ",82,"ه",1,1],["يا ربِّ بالنبيِّ والأسماءِ","وبالمجيبِ فأجبْ دعائي",83,"ي",1,0],["يا ربِّ بالزمانِ والمكانِ","وما تكوَّن من الأكوانِ",84,"ن",1,1],["يا ربِّ بالنور الذي به الفرجْ","فرِّجْ همومي وغمومي والحرجْ",85,"ج",1,0],["يا ربِّ باسم الله والرحمنِ","وبالرحيم بدئي للأمانِ",86,"ن",1,1],["يا ربِّ بالذات ونور الذاتِ","ونور وصفك وبالصفاتِ",86,"ت",1,0],["يا ربِّ بالذي من الأسماءِ","علمتَ في الأرض وفي السماءِ",87,"ا",2,0],["يا ربِّ بالترغيب والترهيب","وما يرى به من الترغيب",88,"ب",1,1],["يا ربِّ بالرحمنِ والرحيمِ","قابلْ بفضلك إلى النعيمِ",89,"م",1,1],["يا رب بارك للخلق في خلف","كي لا يعيش الورى بلا بركه",90,"ك",2,0],["يا رَبِّ بِالهادي الشَفيعِ مُحَمِّدٍ","وبِآلِهِ وَبِصَحبِهِ نَتَشَفَّعُ",91,"ع",1,0],["يا رَبّ بَيتُك مجلى كُلّ تَقديس","فَصُنهُ يا رَبَّنا من كلّ تدنيسِ",92,"س",1,1],["يا رب بالمختار أحمد خير من","حاز المكارم في ذرى عدنان",93,"ن",1,0],["يا ربّ بالمختار يسر زورة","تمحو بها الآثام والأوزارا",94,"ر",2,0],["يا رب بالمصطفى المختار سيدنا","محمدٍ سيد السادات من مضر",95,"ر",1,0],["يا رب بالمصطفى المختار هادينا","أصلح دنانا وأصلح ربنا الدينا",96,"ن",2,1],["يا رب بلغني مني خاطري","لينمحي الهجر ويحلو الورود",97,"د",1,0],["يا رب بالمصطفى المختار من مضرٍ","أهلك عدانا وطهرنا عن ادناس",98,"س",1,0],["يا ربِّ بِاسمِهِم