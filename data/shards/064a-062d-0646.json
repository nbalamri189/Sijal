"أنيخوا مطاياكم غداة نودع","https://www.poetsgate.com/ViewPoem.aspx?id=149422",""],[5136,"شوقي إلى دست الخلافة شيق","https://www.poetsgate.com/ViewPoem.aspx?id=121631",""],[5150,"لحظة يأس...! \\ رثاء امي","https://www.poetsgate.com/ViewPoem.aspx?id=203145",""],[5163,"نخيل","https://www.poetsgate.com/ViewPoem.aspx?id=34864",""],[5190,"إن تُتهمي أو تُنجدي","https://www.poetsgate.com/ViewPoem.aspx?id=153359",""],[5198,"رسالة مع البدر","https://www.poetsgate.com/ViewPoem.aspx?id=135394",""],[5213,"يا من برقة طبع","https://www.poetsgate.com/ViewPoem.aspx?id=170542",""],[5277,"معارضة قصيدة عبدالرزاق عبدالواحد","https://www.poetsgate.com/ViewPoem.aspx?id=205147",""],[592,"إلى الله نشكو إننا بمحلة","https://www.poetsgate.com/ViewPoem.aspx?id=128840",""],[592,"سلام عيلكم كلما ذر شارق","https://www.poetsgate.com/ViewPoem.aspx?id=128853",""],[592,"أما والذي لا يعلم الغيب غيره","https://www.poetsgate.com/ViewPoem.aspx?id=128850",""],[5431,"ودفء به طهرٌ جليٌ وملمسُ","https://www.poetsgate.com/ViewPoem.aspx?id=190446",""],[5431,"البردة -ريم","https://www.poetsgate.com/ViewPoem.aspx?id=190769",""],[5431,"بيني وبين بابلو نيرودا...","https://www.poetsgate.com/ViewPoem.aspx?id=200207",""],[5550,"لقد وعدتني","https://www.poetsgate.com/ViewPoem.aspx?id=211487",""],[5561,"طيفًا يزورُكَ ...","https://www.poetsgate.com/ViewPoem.aspx?id=203216",""],[5582,"تُلَوِّمُنِي فِي الحُبِّ وَالحِبُّ يُعْذَرُ","https://www.poetsgate.com/ViewPoem.aspx?id=187140",""],[243,"العش المهجور","https://www.poetsgate.com/ViewPoem.aspx?id=50479",""],[243,"ثورة 14 رمضان","https://www.poetsgate.com/ViewPoem.aspx?id=19625",""],[5693,"أين أنتم يا صفاتي ؟؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=35587",""],[5720,"البَصْمَة","https://www.poetsgate.com/ViewPoem.aspx?id=200696",""],[5725,"اما تستحي عيناك","https://www.poetsgate.com/ViewPoem.aspx?id=207331",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5873,"غيث الوصل","https://www.poetsgate.com/ViewPoem.aspx?id=215780",""],[5956,"شكراً لكرَم حفيدي فيصل","https://www.poetsgate.com/ViewPoem.aspx?id=193145",""],[5956,"هل يعرف التاريخ مثل فتايا؟","https://www.poetsgate.com/ViewPoem.aspx?id=193202",""],[5956,"مناجاةُ أبٍ موَسوَسٍ على ابنته العُزَّى","https://www.poetsgate.com/ViewPoem.aspx?id=207206",""],[5956,"مَن هي جانْسيت قازان (أمِّ خالد)؟","https://www.poetsgate.com/ViewPoem.aspx?id=207236",""],[5961,"مريد الحق","https://www.poetsgate.com/ViewPoem.aspx?id=199770",""],[6068,"لعارضة ذاك القوام -20-","https://www.poetsgate.com/ViewPoem.aspx?id=177500",""],[6120,"يَحِنُّ قَلبِي لِأيَّامٍ مِنَ الغَزَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=213518",""],[5309,"جذل وقلبي لا يزال عليلا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573525",""],[5377,"رثاء شعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79547&r=&rc=1",""]],"verses":[["يَحنو عَلى رَحِمٍ مَجفُوَّةٍ وَيَرى","قَطعَ الرِقابِ وَلا قَطعاً لِأَرحامِ",0,"م",1,0],["يَحِنُّ إِلى ما تَضمَنُ الخُمرُ وَالحِلى","وَيَصدُفُ عَمّا في ضَمانِ المَآزِرِ",1,"ر",1,0],["يَحِنُّ صَبابَةً وَيَهيمُ وَجد","إِلَيهِمُ كُلَّما ساقوا الحُمولا",2,"ل",2,0],["يَحنُنَّ بَعدَ كَرى العُيونِ","حَنينَ والِهَةٍ قَوامِح",3,"ح",1,0],["يَحِنُّ إِلى جاراتِهِ بَعدَ شِبعِهِ","وَجاراتُهُ غَرثى تَحِنُّ إِلى الخُبزِ",4,"ز",1,0],["يَحِنُّ لَهُ العِفاسُ إِذا أَفاقَت","وَتَعرِفُهُ الفِصالُ إِذا أَهابا",5,"ب",2,0],["يَحِنُّ فُؤادُهُ وَالعَينُ تَلقى","مِنَ العَبَراتِ جَولاً وَاِنحِدارا",6,"ر",2,0],["يحنّ اشتياقاً نحو رؤيته الصفا","ويملأ دمعاً بعد فرقته الحجر",7,"ر",1,0],["يحن لي قلبي فلله من رأى","حمًى يتبع الغادين رجع حنينه",8,"ن",2,0],["يَحِنٌّ إليه القلبُ وهو سَقامُهُ","ويألفُ ذكِراه الحشا وهو فارثُهْ",9,"ث",2,0],["يَحنو الهَزارُ عَلى أَليفَتِهِ","وَيُداعِبُ القَمَرِيَّةَ القُمري",10,"ر",2,0],["يَحِنَّ مِنَ المَعزاءِ تَحتَ أَظَلِّها","حَصىً أَوقَدَتهُ بِالحُزومِ الهَواجِرُ",11,"ر",1,0],["يَحنو عَلى العُشّاقِ","يَسمَعُ لِلمُشتاقِ",12,"ق",1,0],["يَحِنُّ إِلَيكَ ضُلوعٌ عَفَت","مِنَ البَينِ في جَسَدٍ ناحِلِ",13,"ل",1,0],["يحِنُّ إِذا الحَمامُ الوُرقُ حنَّتْ","ويطرَبُ كلّما هبّت قَبُولُ",14,"ل",1,0],["يحنو قَنَاهُ ويخبو نارُ شِرَّتهِ","من بعدما كان لَدْناً مُفْعمَ القَصَبِ",15,"ب",1,0],["يَحنونَهُ مِن أَعاليهِ عَلى أَوَدٍ","حَنوَ الثِقافِ جَرى فَوقَ الأَنابيبِ",16,"ب",1,0],["يَحِنُّ إِلى المَعروفِ حَتّى يُنيلَهُ","كَما حَنَّ إِلفٌ مُستَهامٌ إِلى إِلفِ",17,"ف",1,0],["يَحِنُّ إِلَيهِ فيهِ مُخَدَّماتٌ","وَدامٍ مِن مَناكِبِها كَليمِ",18,"م",1,0],["يَحِنُّ الطائرُ المُوفِي علَيها","وتُوسِعُ كلُّ ماشيةٍ خُطاها",19,"ا",3,0],["يَحِنُّ إلى وِرْدِ المَنيَّةِ حاسِراً","إذا حانَ عن وِرْدِ المَنيَّةِ دَارِعُه",20,"ع",2,0],["يَحِنَّ إِلى يَمينِكَ كُلُّ عَضبٍ","وَتَشتاقُ الأَعِنَّةُ لِلشَمالِ",21,"ل",1,0],["يَحِنُّ للحَرْبِ كَالأَوْطَانِ فَارِسُهُمْ","قد خَالَطَ الشَّوْقُ في إِقْدَامِهِ الحَرَدَا",22,"د",2,0],["يُحَنَّةُ إنْ تُؤمِنْ فَخيرٌ وإن تُرِدْ","سِوَى الحقِّ فَاعْلَمْ أنّ رأيكَ عَازِبُ",23,"ب",1,1],["يُحَنَّةُ هذا ما قضَى اللَّهُ فاعتبِرْ","وكيف اعتبارُ المرءِ والعقلُ ذاهِبُ",23,"ب",1,0],["يَحنو عَلى نُوّاره","كالمُرضِعات عَلى الفَطيم",24,"م",1,0],["يحن شوقاً فلولا أن رائحةً","تزوره في رياح الشرق ما عقلا",25,"ل",2,0],["يحن اذا شطت ويصبو اذا دنت","فيا ويح قلبى كم يحن وكم يصبو",26,"ب",2,0],["يحْنِي الضلوعَ على مِثلِ اللظى حُرَقاً","والوجْه غَمْرٌ بماءِ البِشْرِ ملآنُ",27,"ن",1,0],["يَحِنُّ صَبابَةً وَيَهيمُ وَجداً","إِلَيهِمُ كُلَّما ساقوا الحُمولا",28,"ل",2,0],["يَحُنُّ إِلَيْها قَلْبُ كلِّ مُثقفٍ","وَيَأْسَى لِمَا تَلقى مِن الْبؤْسِ والْفَقْرِ",29,"ر",1,0],["يَحنو عَلَيَّ إِذا أَقَمتُ كَأَنِّيَ ال","أَسرارُ في أَحشاءِ كُلِّ بِلادِ",30,"د",1,0],["يَحِنُّ إلَيْكِ حَنِينَ الْمَشِيبِ","إِلَى ضحكَاتِ الصبَا الْمُخْضِلِ",31,"ل",1,0],["يحنُّ منَ المعزاءِ تحتَ أظلّها","حصًى أوقدتهُ بالحزومِ الهزاجرُ",32,"ر",1,0],["يحن لارجاء الحبيب تلهفا","وخضر ربوع بالمحاسن مربعه",33,"ع",2,0],["يحن لنا الصخر الاصم ترحما","ويلحظنا بالرأفة الحر والعبد",34,"د",1,0],["يحنُّ إليكَ يومٌ غيرُ آتٍ","ويشكُو الذاهبُ الماضي الفِراقا",35,"ق",2,0],["يَحِنُّ فؤادي لِلوقوفِ بِرَبعِهِ","عَسى الضُرُّ مِن قَلبي يُزاحُ",36,"ح",1,0],["يحنو على الخلق في ذات الإِله كما","يحنو الكريم إذا استغنى على رحمه",37,"م",2,0],["يَحِنُّ إِذا هَبَّت شَمالٌ لِأَنَّها","تُؤَدّي إِلَيكُم أَو تَمُرُّ عَلَيكمُ",38,"م",1,0],["يَحِنُّ لَها العَودُ الرَّذِىُّ صَبَابَةً","وَيَجرِى قَرَارَ المَاءِ خَصراً بُطُونُهَا",39,"ن",3,0],["يَحِنُّ إِذَا الرَّكائِبُ باكرتهُ","ضُحَيًّا أَو هَبَبنَ لهُ أَصِيلا",40,"ل",2,0],["يَحِنُّ الأَرزُ في لُبنانَ شَجواً","وَتَندُبُ بَعدَ ذاكَ المَجد صُورُ",41,"ر",1,0],["يَحْنيهِ طولُ ضِرابِهِ هامَ العِدا","حتى يُرَى بيديه منه صَوْلَجُ",42,"ج",1,0],["يحنو فؤادي عليكم","وإن غضبتم فبنتم",43,"م",1,0],["يحِنُّ إلى عَصرٍ تَقَضّى وَأُسرَةٍ","أَفاضَت علَيهِ مثلَ عرفِ الأزاهرِ",44,"ر",1,0],["يحن نحو الحمى إذ تنزلون به","وليس بينهما لولاكم نسب",45,"ب",1,0],["يَحِنُّ إِلَيكَ لا طَرَباً وَشَوقاً","إِلى لُقياكَ ياوَجهَ الصَبوحِ",46,"ح",1,0],["يحِنُّ جَناني رِقَّةً لأجِنّةٍ","ثَوَتْ في بُطونِ المُنْشَآتِ السَوابِح",47,"ح",1,0],["يَحنو عَلى سائِلِهِ تَلَطُّفاً","بِهِ حُنُوَّ الوالِدِ البَرِّ الحَدِب",48,"ب",1,0],["يحنُّ إلى أَوطانِه ثمّ يَنثَني","على قَلبه كي لا يَذوبَ بكَربهِ",49,"ب",2,0],["يحنُّ إِلى أَحياءِ لَيلى بِذي الغَضا","وَأَينَ الغَضا وَيبَ المَشوق من الهِندِ",50,"د",1,0],["يحنّ لِتصريحي بِهِ القلب شائقاً","لَه وَمنَ التعظيم أصبو إلى السترِ",51,"ر",1,0],["يَحِنُّ نِضْوي إلى ماء العُذَيْبِ ضُحىً","وما بهِ البُعدُ لولا أَنّه أُبِضا",52,"ض",2,0],["يَحِنُّ للمجدِ يَستقصي مَداهُ إذا","حَنَّ الخليعُ إلى النَّدْمانِ والكاس",53,"س",1,0],["يحنُّ إِلى العَطاء حنين قَيسٍ","إِلى لَيلى لعرفان الرُبوعِ",54,"ع",1,0],["يَحن إِلى أَسمائِهِ كُلَّ مِنبَرٍ","فَلَو يَستَطيع اهتَزَّ واخضَرَّ عودُها",55,"د",3,0],["يَحِنُّ اشتياقاً بالأصائِلِ والضّحى","ويرتَاحُ في روْحاتهِ وغُدُوِّهِ",56,"و",2,0],["يحنُّ إلى أثلاثِ الغُوَير","حنينَ الغريب لأوطانه",57,"ن",2,0],["يحنُّ إلى يومٌ يُثير غبارَه","صليل كما تهوى العُلى وصهيل",58,"ل",1,0],["يحنو علينا كما يحنو على ولدٍ","أبٌ رؤوفٌ ويوفي بالذي يعِدُ",59,"د",1,0],["يحن إلى أترابه وشبابه","كما حن مخلوج الفصال المربط",60,"ط",1,0],["يحن إليها كل من ذكرت له","ويعنقها من رام منها ثوابها",61,"ب",3,0],["يحن حنين الهيم ذاد خ