{"poems":[[51,"وجاهل أعرضت عن جهله","https://www.aldiwan.net/poem7937.html","السريع"],[51,"نجاك يا ابن الحاجب الحاجب","https://www.aldiwan.net/poem8294.html","السريع"],[51,"في جلنار وأختها دبسية","https://www.aldiwan.net/poem8493.html","الكامل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5138","الكامل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116975","البسيط"],[144,"يا ديمتي نوء الثريا دوما","https://www.aldiwan.net/poem11820.html","الكامل"],[151,"نعم الإله بشكره تتقيد","https://www.aldiwan.net/poem68454.html","الكامل"],[151,"سبحان من في كل شيء شاهد","https://www.aldiwan.net/poem68495.html","الكامل"],[161,"لم أكثر الواشي المقال وزورا","https://www.aldiwan.net/poem58959.html","الكامل"],[198,"قومي اسمعي يا بنت جاري","https://www.aldiwan.net/poem39947.html","مجزوء الكامل"],[260,"حادي الركب سر وحث المطيه","https://www.aldiwan.net/poem35574.html","الخفيف"],[304,"إن غاب من أحببته عن مجلسي","https://www.aldiwan.net/poem58278.html","الكامل"],[365,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[469,"ومسمع مستبشع المنظر","https://www.aldiwan.net/poem60076.html","السريع"]],"verses":[["أحضرتُ نجوى النفسِ تمثالَهُ","مستَحيِياً من شاهِد النجوى",0,"و",2,0],["أحضِرْهُمُ البكْرَ التي ما اصطلت","ناراً فكلٌّ خاطبٌ راغبُ",1,"ب",1,0],["أحضرتموني جُلَّنَارَ وأُحضرتْ","دبسيَّةُ الكبرى لغيريَ تُجنَبُ",2,"ب",1,0],["أَحضَرتَهُم حُجَجاً لَوِ اِجتُلِبَت بِها","عُصمُ الجِبالِ لَأَقبَلَت تَتَنَزَّلُ",3,"ل",1,0],["أحضر طعامك وابذله لمن أكلا","واحلف على من أبى واشكُر لمن فعلا",4,"ل",2,1],["أُحضِرتُ مَجلِسَهُ فَجادَ بِنائِلٍ","بارى بِهِ التَقريبَ وَالتَكريما",5,"م",2,0],["أحضر فؤادك للقيام بشكره","إن كنت تعلم قدر ما تتقلد",6,"د",1,0],["احضر فؤادك إن أردتَ إجابة","وابسط يديك فللدعاء فوائد",7,"د",1,0],["أحضرتها عند الوزير محمد","فقرا وكرر ما قراه وفكرا",8,"ر",2,0],["أحضانهُ حرمي الشريفُ","وضوءُ مفرقهِ مناري",9,"ر",2,0],["أحضرت لي بلقيسَ أنسٍ بصرحٍ","من مراقي بهمّةٍ آصفيّه",10,"ي",2,0],["أحضرت لي ورداً وكأس مدامة","وشربت ريقته على وجناته",11,"ه",1,0],["أحضَر اللّيلُ منك عِقْداً وثَغْرا","حين وَلّى ليُعقِبَ الوَصْلَ هَجْرا",12,"ر",2,1],["أَحضَرَنيها رَجُلٌ سَفلَةٌ","فَلَيتَني غِبتُ وَلَم أَحضُرِ",13,"ر",1,0]]}