{"poems":[[53,"وجاهل أعرضت عن جهله","https://www.aldiwan.net/poem7937.html","السريع"],[53,"نجاك يا ابن الحاجب الحاجب","https://www.aldiwan.net/poem8294.html","السريع"],[53,"في جلنار وأختها دبسية","https://www.aldiwan.net/poem8493.html","الكامل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/5138","الكامل"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/116975","البسيط"],[147,"يا ديمتي نوء الثريا دوما","https://www.aldiwan.net/poem11820.html","الكامل"],[154,"نعم الإله بشكره تتقيد","https://www.aldiwan.net/poem68454.html","الكامل"],[154,"سبحان من في كل شيء شاهد","https://www.aldiwan.net/poem68495.html","الكامل"],[164,"لم أكثر الواشي المقال وزورا","https://www.aldiwan.net/poem58959.html","الكامل"],[201,"قومي اسمعي يا بنت جاري","https://www.aldiwan.net/poem39947.html","مجزوء الكامل"],[264,"حادي الركب سر وحث المطيه","https://www.aldiwan.net/poem35574.html","الخفيف"],[308,"إن غاب من أحببته عن مجلسي","https://www.aldiwan.net/poem58278.html","الكامل"],[369,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[473,"ومسمع مستبشع المنظر","https://www.aldiwan.net/poem60076.html","السريع"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63883","المجتث"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55935","الرجز"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49973","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77736","الكامل"],[1611,"","https://poetry.dctabudhabi.ae/diwan/poem/106713","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27428","الخفيف"],[2780,"","https://poetry.dctabudhabi.ae/diwan/poem/95908","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204833","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89111","المتدارك"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85279","الرجز"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95318","الطويل"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32413","الرمل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127273","الرمل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81697","البسيط"],[4691,"~ حَدِّثِينِي عَن ِ الْهَوَى فِي الْمَسَاْءِ ~","https://www.poetsgate.com/ViewPoem.aspx?id=61998",""],[4728,"راحت ملاك القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=176876",""],[4728,"يا ملهمة","https://www.poetsgate.com/ViewPoem.aspx?id=176874",""],[4748,"صورتك","https://www.poetsgate.com/ViewPoem.aspx?id=6664",""],[4788,"حبنا","https://www.poetsgate.com/ViewPoem.aspx?id=132249",""],[5026,"فيلسوف القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=210478",""],[5184,"داريْ صِغاركِ","https://www.poetsgate.com/ViewPoem.aspx?id=186356",""],[5277,"بقيةٌ من دمع","https://www.poetsgate.com/ViewPoem.aspx?id=191380",""],[5596,"نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=205465",""],[5628,"حديث العشق","https://www.poetsgate.com/ViewPoem.aspx?id=178443",""],[5648,"تعال قلي ياغلا من هقابك","https://www.poetsgate.com/ViewPoem.aspx?id=165169",""],[5652,"دُرتي","https://www.poetsgate.com/ViewPoem.aspx?id=192118",""],[5720,"قادةٌ وأثَر *","https://www.poetsgate.com/ViewPoem.aspx?id=199812",""],[5956,"قد ابتدا الموعد","https://www.poetsgate.com/ViewPoem.aspx?id=181953",""],[5956,"الزوجُ أهمُّ شُغل ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182373",""]],"verses":[["أحضرتُ نجوى النفسِ تمثالَهُ","مستَحيِياً من شاهِد النجوى",0,"و",2,0],["أحضِرْهُمُ البكْرَ التي ما اصطلت","ناراً فكلٌّ خاطبٌ راغبُ",1,"ب",1,0],["أحضرتموني جُلَّنَارَ وأُحضرتْ","دبسيَّةُ الكبرى لغيريَ تُجنَبُ",2,"ب",1,0],["أَحضَرتَهُم حُجَجاً لَوِ اِجتُلِبَت بِها","عُصمُ الجِبالِ لَأَقبَلَت تَتَنَزَّلُ",3,"ل",1,0],["أحضر طعامك وابذله لمن أكلا","واحلف على من أبى واشكُر لمن فعلا",4,"ل",2,1],["أُحضِرتُ مَجلِسَهُ فَجادَ بِنائِلٍ","بارى بِهِ التَقريبَ وَالتَكريما",5,"م",2,0],["أحضر فؤادك للقيام بشكره","إن كنت تعلم قدر ما تتقلد",6,"د",1,0],["احضر فؤادك إن أردتَ إجابة","وابسط يديك فللدعاء فوائد",7,"د",1,0],["أحضرتها عند الوزير محمد","فقرا وكرر ما قراه وفكرا",8,"ر",2,0],["أحضانهُ حرمي الشريفُ","وضوءُ مفرقهِ مناري",9,"ر",2,0],["أحضرت لي بلقيسَ أنسٍ بصرحٍ","من مراقي بهمّةٍ آصفيّه",10,"ي",2,0],["أحضرت لي ورداً وكأس مدامة","وشربت ريقته على وجناته",11,"ه",1,0],["أحضَر اللّيلُ منك عِقْداً وثَغْرا","حين وَلّى ليُعقِبَ الوَصْلَ هَجْرا",12,"ر",2,1],["أَحضَرَنيها رَجُلٌ سَفلَةٌ","فَلَيتَني غِبتُ وَلَم أَحضُرِ",13,"ر",1,0],["أحضُرْ فإنّا إلى أنْ","تهوى الحضورَ جلوسُ",14,"س",1,1],["احضر لديك الكل قبل القفلَهْ","اياك تستولي عليك الغفلَهْ",15,"ه",1,0],["أحضَانُهُ وامتَدَّ كِسرَاهُ غَطا","كأنَّها استِيقَت مِنَ الرَّكائِبِ",16,"ب",1,0],["أحضرتني نعمى أبي عمر فلم","أفقد سوى شخص له لم يحضرِ",17,"ر",1,0],["أحضر حَظائر قدسنا يا غائب","واطلع صوامع عزنا يا راهب",18,"ب",1,1],["أَحضى بِها فَلَكُ العَلاءِ مُدَبَّجاً","بسَما يَفوقُ كَواكِبَ الخَضراءِ",19,"ا",2,0],["أحضروه في كلِّ ما","يعلم الخلقُ أو يرى",20,"ر",2,0],["أُحَضِّضُ قومي باللقاء ومعشري","وما زالَ قومي يَخضِبونَ العَواليا",21,"ي",2,1],["أحضروا لي ما شئتمُ أي قيدٍ","إنني مولع بفك القيود",22,"د",1,0],["أحضرت النجم لأنظمه","شكراً والحاضر لا يشكر",23,"ر",1,0],["احَضرَتُكُم وَحَشَرتُكُم وَقَصَدتُكُم","وَكَسَرتُكُم كَسراً بِلا جُبرانِ",24,"ن",1,0],["أحضرنا واستنطق الخصم فما","راي لديه حجة واستعجما",25,"م",2,0],["أحَضرُهُما أم حَضرُ أَخرَجَ خاضِبٍ","وَذانِ هُما أم ناعِمُ الخدِّ مَخضُوبُ",26,"ب",1,0],["أَحضَرُ الناسِ بِما أَك","رَهُهُ مِنهُ جَوابا",27,"ب",2,0],["احضروا التتن مع القه","وة في ليل بهيم",28,"م",1,1],["أَحْضرتُ صدقَ رجائي إذ وثقتُ به","فغابَ يأْسي به من بعد إحضاري",29,"ر",2,0],["إحضني مقلتي بأنوار عيني_","ك وردي لي بسمتي وهنائي",30,"ا",3,0],["احضن مراسيلها لي واتصفحها","من وحشتي، والجروح الصامتة صاحت",31,"ت",1,0],["أحضن أطيافك بليلة حنينٍ مظلمة","جيت امرّرها ولكنّها عيّت تُمر",32,"ر",1,0],["أحضنه وآسامر اطيوفه","واحْبِسَهْ في نبض خَفَّاقي",33,"ق",2,0],["إحضنه إن كان تقدر تستطيع","في حنان الصدر من بين الذراع",34,"ع",1,0],["أحضرْ ليَ العرشَ القديمَ مُقَبِّلا","يدَ إبْنِ خَلدونٍ فأمْسُكَ حاضِرْ",35,"ر",1,0],["أحضانُ زوجاتهم قُدْسٌ ومأسدةٌ","داري صغاركِ فالأركانُ تنهدُّ",36,"د",1,0],["أحضانُكِ الخضراءُ هزهزها النوى","وتململتْ فيها حنايا الأضلعِ",37,"ع",1,0],["أحضن اللحظة اليتيمة حتى","يستوي عودها لديّ قواما",38,"م",2,0],["احضنيني ثُمَّ اتركيني لأغفو","مثل طفل يهفو إلى دفءِ حضْنِ",39,"ن",1,0],["احضر لجل لومك وخاطر عتابك","تامر امر واقول حاضر ولاغيب",40,"ب",1,0],["إحضنيني ي الغلا لو تسمحين ؟؟","شوقي المجنون قد ملْ الصبر ..!!!",41,"ر",1,0],["أحضروا المجدَ .. بفكرٍ ثاقبٍ","صيَّروا التغييرَ .. فينا ممكنا",42,"ن",2,0],["أحْضِِرْهُ يا أللهْ","حتى يدي ترعاهْ",43,"ا",2,0],["أحضانُك أطهرُ أحضانٍ","تُسْكنني الروعة في ليلَيْكْ",44,"ك",1,0]]}