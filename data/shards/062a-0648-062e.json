{"poems":[[32,"ألا حييا بالزرق دار مقام","https://www.aldiwan.net/poem29529.html","الطويل"],[32,"قف العيس في أطلال مية فاسأل","https://www.aldiwan.net/poem29540.html","الطويل"],[74,"تؤخرني سادات دهري وقد دروا","https://www.aldiwan.net/poem20129.html","الطويل"],[53,"بكاؤكما يشفي وإن كان لا يجدي","https://www.aldiwan.net/poem10863.html","الطويل"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[47,"تمادى اللائمون وفي فؤادي","https://www.aldiwan.net/poem63469.html","الوافر"],[47,"نشدتك الله من برق على إضم","https://www.aldiwan.net/poem65663.html","البسيط"],[77,"أنظلم أن شمنا بوارق لمحا","https://www.aldiwan.net/poem69094.html","الطويل"],[48,"توخ بهجر أم ليلى فإنها","https://www.aldiwan.net/poem22179.html","الطويل"],[48,"لا تقطع الحين مغتابا لغافلة","https://www.aldiwan.net/poem22670.html","البسيط"],[48,"ألم ترني مع الأيام أمسي","https://www.aldiwan.net/poem22684.html","الوافر"],[48,"توخي جميلا وافعليه لحسنه","https://www.aldiwan.net/poem22766.html","الطويل"],[48,"إذا ما غضوب غاضبت كل ريبة","https://www.aldiwan.net/poem22817.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54769","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54733","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55506","الطويل"],[108,"طوى الموت إبراهيم!","https://www.poetsgate.com/ViewPoem.aspx?id=179679",""],[147,"أرى الشرف الأعلى إليك مسلما","https://www.aldiwan.net/poem11811.html","الطويل"],[164,"لصومك شهر الصوم يكسى من الفجر","https://www.aldiwan.net/poem59111.html","الطويل"],[168,"بملتفتيه للمشيب طوالع","https://www.aldiwan.net/poem67832.html","الطويل"],[173,"سما لك من أم العبيد خيال","https://www.aldiwan.net/poem1660.html",""],[208,"وشمس خدور لو بدت من خدورها","https://www.aldiwan.net/poem53152.html","الطويل"],[310,"دليل اصطفاء الله للعبد علمه","https://www.aldiwan.net/poem56414.html","الطويل"],[371,"يموت كما مات العناة معناه","https://www.aldiwan.net/poem17141.html","الطويل"],[374,"توخ فعال الخير واجتنب الأذى","https://www.aldiwan.net/poem4280.html","الطويل"],[398,"لقد رحلت سعدى فهل لك مسعد","https://www.aldiwan.net/poem53688.html","الطويل"],[422,"دعوت فؤادي للسلو فما أجدى","https://www.aldiwan.net/poem54056.html","الطويل"],[466,"هنيئا لك الأيام يا ابن محمد","https://www.aldiwan.net/poem16067.html","الطويل"],[487,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83285","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46549","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64491","الطويل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113986","الطويل"],[1641,"","https://poetry.dctabudhabi.ae/diwan/poem/199400","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49584","المتقارب"],[1828,"","https://poetry.dctabudhabi.ae/diwan/poem/89638","الوافر"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118416","الوافر"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69394","المتقارب"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46745","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200178","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86262","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86250","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86255","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216787","الطويل"],[3826,"","https://poetry.dctabudhabi.ae/diwan/poem/84995","المتقارب"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120469","الوافر"],[4759,"البعد المتاح","https://www.poetsgate.com/ViewPoem.aspx?id=204929",""],[592,"ضلالٌُ ما يؤمله اللئام","https://www.poetsgate.com/ViewPoem.aspx?id=128813",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5533,"شَقَاءُ المَرْء","https://www.poetsgate.com/ViewPoem.aspx?id=177812",""],[5655,"تحيّةُ ربّي كلَّ يومٍ مجدَّدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=107216",""],[6031,"سَلاَمٌ إذَا استَعْبَقْتَ رَيَّاهُ أُجلِيَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=46402",""]],"verses":[["تَوَخى بِها العَينَينِ عَينَي غُمازَةٍ","أَقَبُ رَباعٍ أَو قُوَيرِحِ عامِ",0,"م",1,0],["تَوَخّاهُ بِالأَظلافِ حَتّى كَأَنَّما","يُثيرُ الكُبابَ الجَعدَ عَن مَتنِ مِحمَلِ",1,"ل",1,0],["تؤَخرني سادات دهري وقد دَرَوا","صفاتي وأنسابي التي هي أكرم",2,"م",1,1],["تَوَخَّى حِمَامُ الموتِ أوْسَطَ صبْيَتي","فلله كيفَ اخْتار وَاسطَةَ العِقْدِ",3,"د",1,0],["توخّى بنا المرعى المرِيءَ نباتُه","وجنَّبنَا المرعى الذي يُتَوَخَّمُ",4,"م",1,0],["تَوَخّى الرِفقَ غَيرَ مُضيعِ حَزمٍ","وَلا مُتَنَكِّبٍ قَصدَ السَدادِ",5,"د",1,0],["تَوَخِّياً لِاِصطِناعِ العُرفِ تَصنَعُهُ","في الصالِحينَ وَإِبقاءً عَلى النِعَمِ",6,"م",1,0],["تَوَخّاهُمُ قبلَ السؤالِ تبرّعاً","بمعروفِ ما يُولي وسِيلَ فأنجحا",7,"ح",2,0],["تَوَخَّ بِهَجرٍ أُمَّ لَيلى فَإِنَّها","عَجوزٌ أَضَلَّت حَيَّ طَسمٍ وَمارِبِ",8,"ب",1,1],["تَوَخَّ نَقلَ أَبي زَيدٍ وَكُتبَ أَبي","عَمرٍ وَخَلِّ كَلاماً في أَبي عُمَرِ",9,"ر",1,0],["تَوَخَّ الأَجرَ في وَحشٍ وَإِنسٍ","فَفي كُلِّ النُفوسِ مَرامُ أَجرِ",10,"ر",1,0],["تَوَخَّي جَميلاً وَاِفعَليهِ لِحُسنِهِ","وَلا تَحكُمي أَنَّ المَليكَ بِهِ يُجزي",11,"ز",2,1],["تَوَخَّت عَواريَّ المُلوكِ بِرَدِّها","جِهاراً وَآثارَ الأَكارِمِ بِالطَمسِ",12,"س",1,0],["تَوَخَّى مَالٍ حَرَامٍ حَلاَ","لٍ عَلَى كُلِّ حَالٍ بِلاَ مُنْتَقَدْ",13,"د",1,0],["تَوَخَّيْتَهَا غايَةً وَعْرَةً","فَأَدْرَكْتَهَا فَائِزاً أَيِّدا",14,"د",2,0],["تَوَخَّ عَظِيمَاتِ المُنَى وَانْحُ نَحْوَهَا","بِرَأْيٍ يُضِيءُ الدَّهْرَ وَرْيُ زِنَادِهِ",15,"د",2,0],["توخَّاك لما كان مثُلك نادرًا","بهذا الورى، والدُّرُّ أغلاء نادره",16,"ر",2,0],["تَوَخّى التُقى وَالعَدلَ فِعلُكَ كُلُّهُ","فَلَم تَقتَرِف إِثماً وَلَم تَجنِ مَحرَما",17,"م",2,0],["توخيت فيه فعل كل مثوبة","فراح بما أودعته مثقل الظهر",18,"ر",1,0],["تَوَخّى الهُدى فَاِستَنقَذَتهُ يَدُ التُقى","مِنَ الزَيغِ إِنَّ الزَيغَ لِلمَرءِ صارِعُ",19,"ع",1,0],["تَوَخّى شَكاياها الَّتي بَرَحَت بِها","فَأَبرَأَ مِنها الداءَ وَهوَ عُضالُ",20,"ل",1,0],["تُؤخِّر عن قلبي نصيبَ سرورِه","وقد عَجَّلت للعين بعضَ سرورِها",21,"ر",3,0],["توخّى رضا الرحمنِ فيك بِما اِصطفى","إِليك منَ الفضلِ الّذي دقّ فهمهُ",22,"م",2,0],["تَوَخّى رِضاكم أَو تَوَقّى جَفاكُمُ","فَماذا تَوَقّاهُ وَماذا تَوَخّاهُ",23,"ه",1,0],["توخَّ فِعالَ الخيرِ واجتنب الأذى","بعمرٍ بحالي غبطةٍ وأمانِ",24,"ن",1,1],["تَوَخّى اِبنُ عَبادٍ بِها آلَ أَحمدٍ","لِيَشفَع في يَوم القِيامَةِ أَحمَد",25,"د",1,0],["تُؤخِّرني الأَيَّام عمَّا أُريده","فلم تكتسب شكراً ولم تكتسب حمدا",26,"د",2,0],["توخَّى بهاء الدين مَسْعاةَ قومهِ","فنعْمَ عتيق المجدِ والمُتَقادمُ",27,"م",1,0],["توخي سبيلا ما عهدت طروقه","بالليل ليل في مطارق الوان",28,"ن",1,0],["توخيت عن إفشاء سري فلا أرى","أراني ولا يدري بمنزع إنسان",28,"ن",1,0],["توخيت أطنابا وملت مواليا","موارد إيجاز وقد يئس الشاني",28,"ن",2,0],["تَوَخّى طَريقُ الخَيرِ مَحَضّاً كَأَنَّهُ","مِنَ المَهدِ حَتّى اللَحدِ جاءَ لِيَنفَعا",29,"ع",2,0],["تَوخ أَوقات الفُرَص","فَرُبَّما عادَت غصص",30,"ص",1,0],["تؤخر إن أخرت عن زلف الرضا","لعلم قديم واقتضاء مشيئة",31,"ه",1,1],["تؤخر ما أخرت في مستقره","فما يقتضي التقديم فيه بحيلة",31,"ه",1,0],["توَخّى بها عيناً روىً قد تعَوَّدَت","بها الرَيَّ قِدماً بالمصايفِ مَعلما",32,"م",2,0],["توخ مناجاة العدو توقعاً","لفرصة إمكان يسوغها الحزم",33,"م",1,1],["تَوَخَّ العُلا في ظلالِ الرِّماحِ","فقد أعوزتْ في ظِلالِ الكِلل",34,"ل",1,0],["توخّاني بِقَدحٍ شَكَّ قَلبي","دَقيقٍ قد بَرَته الراحَتان",35,"ن",1,0],["توخي مسجد التنوى تحرى","مناخ محمد والصاحبين",36,"ن",1,0],["تَوَخَّينَ شَهرَينِ حَتّى أَتَينَ","إِلى الرَقَتَينِ رَذايا حِسارا",37,"ر",2,0],["تُؤَخِّرُ السَّرجَ تأَخيراً إِذا جَمَزَت","عَن مَتنِها وَحِزامُ السَّرجِ مَشدودُ",38,"د",1,0],["توّخى في الهوا سبحاً فأعيا","عليه فظلّ يسبح في التراب",39,"ب",1,0],["توخى اصطِناع المُكرَمات كَأَنَّهُ","بِها لِلملا في العالَمين ضَنين",40,"ن",1,0],["توخى سَبيلَ العَدل في الحُكمِ ديدَناً","فَفيهِ نَراهُ لا يَضيعُ دانِقاً",41,"ق",2,0],["تَوَخّى فعالَ الخَيرِ في الناسِ ديدناً","فَفازَ من المَولى الكَريم بِاجرِها",42,"ر",3,0],["توختك أسراب النفوس كأنما","على كل لحن ماردٌ لك يخدم",43,"م",1,0],["تَوَخَّ من الطرقِ أوساطَها","وعَدِّ عن الجانِبِ المُشتَبِه",44,"ب",2,1],["توخوا بابه الاعلى فآبوا","وقد فازوا بما راموه قصدا",45,"د",2,0],["تؤخر ما ابتدت وتدير بدءا","تعثر في مساربه السراح",46,"ح",1,0],["توخي نوره قوم فجاءوا","فبدد شملهم ووهى النظام",47,"م",1,0],["توخ الذي ينجيه يوم معاده","وفي هذه الدنيا يكون على وجل",48,"ل",1,0],["تَوِخَّ طَريقَ أَرْبابِ السَّجايا","وحَاذِرْ أَنْ تَكُونَ مَعَ اللِّئامِ",49,"م",1,0],["تَوخَّيْ كتابي وابْعَثي لي رسالةً","كتاباً بليغاً عن كتابك مُعْرِبا",50,"ب",2,0],["تَوَخَّى دِمَاغي لا يُزَايِلُ سَاعَةً","كَمَا عَكَفَتْ أُمُّ الفِرَاخِ علَى الوَكْرِ",51,"ر",1,0]]}