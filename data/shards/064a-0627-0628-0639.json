//www.poetsgate.com/ViewPoem.aspx?id=53458",""],[5848,"كسرة وسكون وضمة وفتحة","https://www.poetsgate.com/ViewPoem.aspx?id=49224",""],[5848,"ما أشجعك","https://www.poetsgate.com/ViewPoem.aspx?id=50624",""],[5848,"يادلعها","https://www.poetsgate.com/ViewPoem.aspx?id=48987",""],[5912,"مجاراة لقصيدة لي حبيب","https://www.poetsgate.com/ViewPoem.aspx?id=203791",""],[5952,"جمرٌ على الجمر","https://www.poetsgate.com/ViewPoem.aspx?id=202360",""],[5956,"يا بعيدين","https://www.poetsgate.com/ViewPoem.aspx?id=182132",""],[5970,"أيها الثاوي الذي ليس يزار","https://www.poetsgate.com/ViewPoem.aspx?id=130675",""],[5988,"يا بعيداً مزارهُ","https://www.poetsgate.com/ViewPoem.aspx?id=99711",""],[5997,"العنابه","https://www.poetsgate.com/ViewPoem.aspx?id=214232",""],[6001,"أبو ظبي","https://www.poetsgate.com/ViewPoem.aspx?id=375",""],[6031,"أسْتوهِبُ الأَيَّامَ قُرْبَكُمُ","https://www.poetsgate.com/ViewPoem.aspx?id=46377",""],[6056,"مجاريح الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=130501",""],[6068,"عاجلتها بالشوق حتى كرهتها -12-","https://www.poetsgate.com/ViewPoem.aspx?id=175881",""],[6113,"منال .........!!!","https://www.poetsgate.com/ViewPoem.aspx?id=26380",""],[2588,"يا بعلبك عروسة البلدان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83217&r=&rc=165",""]],"verses":[["يا بَعيدَ الدارِ مَوصو","لاً بِقَلبي وَلِساني",0,"ن",2,0],["يَا بَعْثَةَ الشَّرَفِ الَّتِي وَفَدَتْ وَفِي","كُلِّ القُلُوبِ لَهَا أَعَزُّ مَكَانِ",1,"ن",1,0],["يا بُعدَهُ مما افْتري","تَ من الفواحش واغترابَهْ",2,"ب",2,0],["يا بُعْد معناه من معنى اللئام إذا","شَحَوْا بلفظة لا أفواههم وشَحا",3,"ح",2,0],["يا بَعيداً وَإِن دَنا","كَم تَمَنَّيتُ قربكا",4,"ك",2,1],["يا بُعدَ مَن ماتَ مِمَّن كانَ يُلطِفُهُ","قامَت قِيامَتُهُ وَالناسُ أَحياءُ",5,"ا",2,0],["يا بَعيداً يَشتاقُهُ لِحظُ عَيني","وَقَريباً مَحَلُّهُ في فُؤادي",6,"د",2,1],["يا بُعدَ غايَةِ دَمعِ العَينِ إِن بَعُدوا","هِيَ الصَبابَةُ طولَ الدَهرِ وَالسُهُدُ",7,"د",1,1],["يا بعثةً لم تزلْ فينا مجددَّةً","هلا ونحن على عشرٍ من العشرِ",8,"ر",1,0],["يا بَعثَةَ الأَمَلِ المُخضَرِّ جانِبُهُ","يَحيا بها الراجِيانِ الشَعبُ وَالوَطَنُ",9,"ن",1,1],["يا بُعدَ قَلبي مِن مَوَدَّتِهِ","أَمسى بِصالِحَةٍ وَما صَلَحا",10,"ح",2,0],["يا بِعْثَةًُ قَدْ شُرَّفَتْ بِرِسَالَةٍ","سَتَظَلُّ ذِكْرَاهَا حَدِيثَ الأَعْصُرِ",11,"ر",1,1],["يا بعينيك طر الى بغداد","شفنا الوجد بالنوى والبعاد",12,"د",1,1],["يا بعيد المزار أنت قريب","من فؤادي وإن حللت بعيدا",13,"د",2,1],["يا بُعدَ مَنزِلِ مَن تَرجو مَوَدَّتَهُ","وَمَن أَتى دونَهُ الصَمّانُ فَالحَفَرُ",14,"ر",1,0],["يا بَعيداً عَن البَشَر","أَنتَ لا تَعرِفُ الشُرور",15,"ر",1,0],["يا بَعيدَ المِثالِ غادَرَني الشَو","قُ وَفي فيكَ تُضرَبُ الأَمثالُ",16,"ل",1,0],["يا بَعلَبَكُّ لَقَد قَهَرتِ المَشرِقَ ال","أَقصَى بِخَيرِ مُمَلَّكٍ وَالمَغرِبا",17,"ب",2,0],["يا بُعدَها غايَةً لِلشَوقِ غائِلَةً","مِن غَورِ مِصرَ إِلى عَلياءَ جَيرونِ",18,"ن",1,0],["يا بعيداً أحلّه الشْ","شَوقُ قَلبِي ونَاظِري",19,"ر",2,1],["يا بعيداً له القلوبُ ديارُ","عن مَشُوقٍ يهيجه التذكار",20,"ر",1,1],["يا بعدها أمداً وحمرُ دموعه","من عنسهِ وسهاده من زاده",21,"د",2,0],["يا بُعدَ ما بيني وبين حبائبي","والشّيبُ في فَوْدَيَّ غيرُ بعيدِ",22,"د",1,0],["يا بعيدَ المنالِ وهْو قَريبٌ","وقريبَ الإِحْسانِ وهْوَ بَعِيدُ",23,"د",1,0],["يا بعد صبرك أتهموا أم أنجدوا","هيهات منك تصبر وتجلّد",24,"د",1,1],["يا بعادَ الحب مَهلاً","حَسبي الهجرانُ بُعدا",25,"د",2,0],["يا بعيدا من غنى الن","نفس ولو ملكت عانَه",26,"ن",2,1],["يا بعيدا عن عيش دهر خصيب","يا فقير من الزمان العسير",27,"ر",1,0],["يا بُعْدَ ما تَقَوَّلوا مِنَ الِحجَى","وقُرْبَ ما دانوا به من الخَبَلْ",28,"ل",1,0],["يا بعده لَم يغنني","قَولي لَهُ لا تبعد",29,"د",1,0],["يا بُعْدَ ما بَيْنَ مُمْسانا وَمُصْبَحِنا","وَالعيِسُ قاطِعَةٌ مِيلَيْنِ في مِيلِ",30,"ل",1,1],["يا بعيداً أثمرنَ منه أعالي","غُصنِ القدِّ لي عِناقاً قريبا",31,"ب",2,0],["يا بعلبك اطوف فيك كأنني","شبحٌ يطوف بمدفن الأجيالِ",32,"ل",1,1],["يَا بُعدَ مَا بَينَ السِّبَابَ بِذَاكُمُ","وَسِبَابُكُم بِالكِذبِ وَالطُّغيَانِ",33,"ن",1,0],["يا بُعدُ جَمَّعتَ شَوقي","لَكِنَّ صَبري تَشَتَّت",34,"ت",1,0],["يا بعد أُنسي وقد فارقتُ بَهجتَه","يا عظم رزئي لفقداهُ وأكدارِي",35,"ر",2,0],["يا بعيدا مذ شط عنا نزفنا","أدع العين فيه نزف القليب",36,"ب",1,0],["يا بِعاداً طالَ حَتّى ملّ من","فرطِ آمالي لقاهُم من عذرْ",37,"ر",1,1],["يا بعدها عن بابل في الدجى","أسمعها شادية لاحنةْ",38,"ن",2,0],["يا بعد أن غطى حجابك عنهم","فالشوق يهتك ستر كل غطاء",39,"ا",2,0],["يا بُعولَ القِحاب غَرَّكُمُ كف","فِيَ كفّي عنكم وَحَبسي لِساني",40,"ن",2,0],["يا بعلبكَّ إِفرَحي وَاشدي مؤرّخةً","اليَوم فيكِ استهلَّت نجمة السحرِ",41,"ر",1,0],["يا بعيد المدا أذكى من المسك وأغلا","يالذي قوله بالزين لسفل ولعلا",42,"ل",2,0],["يا بعيدَ المزار دعوةَ صبٍ","تُلبس القلبَ بُردةً الأشجان",43,"ن",1,0],["يا بعيدَ الدارِ باليأ","سِ قريباً بالأماني",44,"ن",2,0],["يابعد هالكون كلّه باعتدالك او بميلك","تسوى راسي تسوى قلبي تسوى ذيّا وتسوى ذيّا",45,"ي",2,0],["يا بعدَ ياوجعَ التغربِ يا أسى","لا تسترقَّ مفارقاً متشوقا",46,"ق",2,0],["يا بعد عمري وشمعات السنين","يا ضيا هالدرب وضماد الجراح",47,"ح",1,0],["يا بعيدي كلّما فُتّني","صرتُ منّي ذاهبًا غائبا !",48,"ب",2,0],["يا بعيد الوصلِ صوتك شاحبٌ","والصدى غيمُ الحكايا المحرقُ",49,"ق",1,0],["يا بعيدًا طيفهُ يعلو معي","كلما أخفضتُ طيفًا رَفّعَكْ !",50,"ك",1,0],["يَا بَعِيْدًا عَنْ عُيُونِيْ","أنْتَ كُفْرٌ فِيْ لِسَانِيْ",51,"ن",2,1],["يَابِعِيْدًا عَنِ الْفُؤَادِ وَعَنِّيْ","شَغَفُ الرُّوحِ فِيْ سَرَابٍ وَظنِّي",52,"ن",2,1],["يا بعد سوّار وإن لم يكن","أصبح منا نازح الدار",53,"ر",1,0],["يا بعيدَ الدارِ..زرني مرّةً","مثل نحلٍ زارَ دنيا الميسمِ",54,"م",1,0],["يا بعضَ كلّي وكلّي كلُّهُ بعضُ","أنتِ النوافلُ للأشواقِ والفرضُ",55,"ض",1,1],["يابعيدَ الدَّار هل تشتاقُها","كاشتياقي إذ يُعنِّيني العنا",56,"ن",2,0],["يا بعيدا عصيت في التداني","وتماديت جائرا في جفاكا",57,"ك",2,0],["يا بعضَ الجرحِ وكلّ الفر","حِ وسرّ الدفء بمدفأتي",58,"ت",2,0],["يا بعد كل القصيد ونزوة حداه وانينه","لا ذكرتك لاح بيت .. وطاح ورد .. وفاح طيب",59,"ب",1,0],["يا بعد عمر الكتابة والقراية","يا الشمالي يابو الملح الجنوبي",60,"ب",2,0],["يابعد من كدّر غيابي مزاجه","ويابعد من مرّت حروفه شفاهي",61,"ا",3,0],["يابعد طول المسافة والكلافة والشقا","يابعد كل الحياة وكل م