wPoem.aspx?id=39918",""],[5431,"أبانا الروحي...","https://www.poetsgate.com/ViewPoem.aspx?id=210262",""],[5459,"بعثة الرحمة المهداة","https://www.poetsgate.com/ViewPoem.aspx?id=190905",""],[3912,"كفى حَزَنًا بالهائم الصبِّ أن يرى","https://www.poetsgate.com/ViewPoem.aspx?id=136749",""],[5596,"نهضة عمان","https://www.poetsgate.com/ViewPoem.aspx?id=206777",""],[5628,"بين بغداد والقاهرة","https://www.poetsgate.com/ViewPoem.aspx?id=179813",""],[5690,"حياة المرءِ في الدنيا منامُ","https://www.poetsgate.com/ViewPoem.aspx?id=172186",""],[5691,"المربد","https://www.poetsgate.com/ViewPoem.aspx?id=206353",""],[5691,"مأمن الله","https://www.poetsgate.com/ViewPoem.aspx?id=206667",""],[5693,"رحلت هنالك.","https://www.poetsgate.com/ViewPoem.aspx?id=34851",""],[402,"فاروق إنك ذخر الأمة الغالي","https://www.poetsgate.com/ViewPoem.aspx?id=36164",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5973,"سترحل كالأشجار صدام َ واقفاً","https://www.poetsgate.com/ViewPoem.aspx?id=13278",""],[6004,"شَكوَى الحَمَامِ","https://www.poetsgate.com/ViewPoem.aspx?id=71984",""],[161,"وَجهُ المرآة","https://www.poetsgate.com/ViewPoem.aspx?id=204621",""],[6104,"بعدَ الرِّيّ","https://www.poetsgate.com/ViewPoem.aspx?id=24195",""],[6164,"أطوار..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66060&r=&rc=69",""],[6164,"حب وعرفان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66047&r=&rc=56",""],[231,"الشاعر في وادي الموتى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79142&r=&rc=17",""],[6225,"إحياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78068&r=&rc=153",""],[6264,"طيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79107&r=&rc=29",""],[5490,"العمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81965&r=&rc=52",""]],"verses":[["فَقَد كانَ يَرجو أَن يَنالَ مُناهُ","فَخَلَّفَني فَرداً وَنالَ رَداهُ",0,"ه",1,0],["فَقَد كُنتُ حَصَّنتُ أَبكارَهُنَّ","وَعَوَّدتُهُنَّ عَنِ القَومِ عَضلا",1,"ل",2,0],["فَقَد كُنتُ أَستَسقي الدُموعَ لِمِثلِها","وَما جَمَّ دَمعُ العَينِ إِلّا لِيُهرَقا",2,"ق",2,0],["فَقَد كُنتُ لا أُعطي العَواذِلَ طاعَةً","وَأَعذِرُ نَفسي في التَصابي وَلا عُذرُ",3,"ر",1,0],["فَقَد كُنتُ أَبكي وَالنَوى مُطمَإِنَّةٌ","بِنا وَبِكُم مِن عِلمِ ما البَينُ صانِعُ",4,"ع",1,0],["فَقَدْ كُظِمَ الْغَيْظُ الشَّدِيدُ بِعَزْمَةٍ","سَرَتْ لَكَ مِنْ عَهْدِ الْعَقِيقِ وَكَاظِمَهْ",5,"م",2,0],["فَقَد كانَ في شُبّانِ قَومِكِ مَنكَحٌ","وَفِتيانِ هِزّانَ الطِوالِ الغَرانِقَه",6,"ق",2,0],["فَقَد كَمُلَت حُسناً فَلا شَيءَ فَوقَها","وَإِنّي لَذو قَولٍ بِها مُتَنَخَّلِ",7,"ل",1,0],["فَقَد كانَ يَعتادُهُ دائِباً","بَكوراً رَؤوحاً لِنَهبِ الدُرَر",8,"ر",1,0],["فَقَد كُنتَ عَوناً لِلضَعيفِ وَإِنَّني","ضَعيفٌ وَما لي في الحَياةِ نَصيرُ",9,"ر",1,0],["فقد كان من قبل عهد جميل","كعهدكم والآن شمس أصيل",10,"ل",1,0],["فقد كان منها الصدر يعلو ويرتمي","فيبعث بي شجواً يموج به صدري",11,"ر",2,0],["فَقَد كُنتِ إِذ لَيلى تَحُلُّكِ مَرَّةً","لَنا بِكِ شَوقٌ غَيرُ طَرقٍ وَلا رَنقِ",12,"ق",1,0],["فقد كنت نِسْياً لا تُحس ولا تُرى","زماناً طويلاً فاصبر الآن تُذكر",13,"ر",1,0],["فَقَد كِلتُموني بِالسَوابِقِ قَبلَها","فَبَرَّزتُ مِنها ثانِياً مِن عَنانِيا",14,"ي",2,0],["فَقَد كانَ يَحلو لي زَماناً حَديثُها","وَلَيسَ بِنَزرٍ كَاِختِلاسِ المُصارِمِ",15,"م",1,0],["فَقَد كُنتُ أَرجو أَن يَقومَ بِخُطَّةٍ","طَريفٌ وَإِخوانُ الصَفاءِ وَيَضرَحوا",16,"ح",3,0],["فقد كبَّلَتْهُ بَناتُ الظَّلامِ","وأَلقيْنَهُ في ظلامِ اللُّحودْ",17,"د",1,0],["فقد كان أنضج لحم رأيت","وقد كان كالمسك في نكهته",18,"ت",2,0],["فقد كشفنا لك ما","لم يبده قطّ أحد",19,"د",1,0],["فقد كان رَبْعِي آهِلاً بكِ مدَّة","أحِنُّ إليه حَنَّةَ الطيرِ للوَكْرِ",20,"ر",1,0],["فَقدُكَ المُرُّ يا اِبنَ عَمّي أَبكا","ني لافَقدُ زَينَبٍ وَلَميسِ",21,"س",1,0],["فَقَد كانَ أَنذَلَها طِعمَةً","وَأَهوَنَها حينَ ماتَت هَلاكا",22,"ك",2,0],["فَقَد كُنتُمُ في تَغلِبٍ بِنتِ وائِلٍ","عَبيداً لَهُم يُعطَونَ خَرجَ الدَراهِمِ",23,"م",1,0],["فَقَد كُنتَ تُحيي اللَيلَ بِالذِكرِ ضارِعاً","إِلى اللَهِ حَتّى صِرتَ بِالنُسكِ كَالشَنِّ",24,"ن",1,0],["فَقَد كَثَّرَ الرُزءُ قَدرَ الدُمو","عِ وَقَد عَظَّمَ الخَطبُ شَأنَ البُكاءِ",25,"ا",2,0],["فَقَد كادَ يَسلو القَلبُ عَنها وَمَن يَطُل","عَلَيهِ التَنائِي وَالتَباعُدُ يَذهَلِ",26,"ل",1,0],["فَقَد كانَ يَومَ الرَوعِ أَبيَضَ صارِماً","بِكَفّي وَيَومَ الفَخرِ تاجاً بِمَفرَقِ",27,"ق",1,0],["فَقَد كِدنَ يَلقَطنَ حَبَّ القُلوبِ","وَيَشرَبنَ ماءَ عُيونِ الكِرامِ",28,"م",1,0],["فَقَد كُنتَ ظَلّاعَ النِجادِ وَمُعطِيَ ال","جِيادِ وَسَيفاً لا تُثَلُّ مَضارِبُه",29,"ب",2,0],["فَقَد كانَ دَأبي جَنَّةَ اللَهوِ وَالصِبا","وَما زِلتُ بِاللَذاتِ وَالعَيشِ لَعّابا",30,"ب",2,0],["فَقَد كادَتِ الذِكرى تَكونُ كَأَنَّها","مُشاهَدَةٌ لَولا التَوَحُّشُ لِلفَقدِ",31,"د",1,0],["فَقَد كُنتَ دَهراً لا تَروقُ لِمُعجَبٍ","سِوايَ وَلا تُنمي إِخاءِ إِلى باسِ",32,"س",1,0],["فَقَد كانَ مِنّي ذاكَ فيها تَعَمَّداً","لِما قالَ في الأَمثالِ جَروَلُ مِن قَبلي",33,"ل",2,0],["فَقَد كُنتُ في ظِلِّ العَذارى مُرَفَّلاً","أُحَبُّ وَأُعطى حاجَتي حَيثُ حَلَّتِ",34,"ت",1,0],["فَقَد كَذَبَت عالى عيسى النَصارى","كَما كَذَبَت عَلى موسى اليَهودُ",35,"د",1,0],["فَقَدْ كُنْتُ أُحْذِي النَّابَ بِالسَّيْفِ ضَرْبَةً","فأُبْقِى ثَلاثاً والوَظِيفَ المُكَعْبَرَا",36,"ر",2,0],["فقد كانت الأفراح تفتح بابها","لمن كان حول الطبل والطبل يقرع",37,"ع",1,0],["فَقَدْ كُنْتِ فِينَا بَرَّةَ الْقَوْلِ سَرَّةً","سَلِيمَةَ قَلْبٍ فِي مَغِيبٍ وَمَحْضَرِ",38,"ر",1,0],["فَقْدُكَ سَلَّ الْعِظَامَ مِنِّي وَرَدْ","دَ الصَّبْرَ عَنِّي وَفَتَّ في عَضُدِي",39,"د",2,0],["فَقَدْ كَانَ فِي إِقْدَامِهِ وَثَبَاتِهِ","بِأَوْفَى المَعَانِي قُدْوَةً لِمَنِ اقْتَدَى",40,"د",2,0],["فَقْدُكِ الوَالِدَيْنِ حَالاً فَحَالاً","جَعَلَ البِيضَ مِنَ لَيَالِيكِ جُونَا",41,"ن",2,0],["فَقَدْ كَلَّم اللهُ النبيَّ محمَّداً","عَلَى المَوْضِعِ الأَعْلَى الرَّفِيعِ المُسوَّمِ",42,"م",1,0],["فَقَدْ كَانَ عِزّاً لأَيْتامِنَا","وَلَيْثَ المَلاَحِمِ في البِزَّةِ",43,"ز",2,0],["فَقَد كانا لَهُ نَفساً وَطيباً","يُنيفُهُما عَلى المِسكِ الذَكِيِّ",44,"ي",1,0],["فقد كان يحيى الليلَ فيه معشر","فتثاءبوا عند الغروب وهوّموا",45,"م",3,0],["فقد كنت غوثا تمطر الكون رحمة","بل الغوث في الابدال بل أنت أقدم",46,"م",1,0],["فقد كنتَ عن وحي الضرورةِ ناطقاً","وقد كنتَ عن محضِ الطبيعة صادراً",47,"ر",2,0],["فَقْدُكَ المُرُّ، يا بنَ عمّيَ، أبْكَا","نيَ، لا فَقْدُ زَيْنَبٍ وَلَمِيسِ",48,"س",1,0],["فقد كذَبَتْ على عيسى النّصارى","، كما كذَبتْ على موسى اليَهود",49,"د",1,0],["فقد كنَّا وما كنَّا","وأمسَينا وها إِنَّا",50,"ن",2,0],["فَقَد كُنتَ مَغنَاطِيسَ كُلِّ مَسَرَّةٍ","ومن كُلِّ مَا يَدعُو إِلَى كَدَرٍ حُصنَا",51,"ن",2,0],["فَقَد كَانَ أدرَى بِالمَذَاهِبِ إِنَّهُ","لَمُجتِهِدُ الإِطلاَقِ إِن لَم يَكُ انقَطَع",52,"ع",1,0],["فقد كان حُرًّا كاملاً قبل أن قضى","كذا كل حرٍ كاملٍ ناقصُ العمرِ",53,"ر",1,0],["فَقَد كُنتَ نوراً لَنا في البِلادِ","تَضيءُ فَقَد أَصبَحَت مُظلِمَه",54,"م",2,0],["فقد كدتُ في عَجزى عن الشكرِ إن أرى","لسانىَ مجروما وقلبي مُفحَما",55,"م",2,0],["فَقَد كانَ لي عَوناً عَلى الصَبرِ بُرهَةً","وَفارَقَني أَيّامَ فارَقتُمُ الحِما",56,"م",2,0],["فقد كنت بالإِعراض عنهم عززتهم","وما ينبغي رفع العصا عن قفا العبد",57,"د",1,0],["فقد كذبوا ضد الولي هو العدو","فما متق الأولى كما بتلا",58,"ل",2,0],["فَقد كَرِهت جَهلاً مَشيبي وَإِنَّني","أَرى ضَلَّةً أَن يَزدَهيني شَبابُها",59,"ب",3,0],["فَقَد كانَ مِنّي مِثلَ ما قالَ فَلتَةً","وَما اِعتَضتُ مِنهُ غَيرَ عَضِّ الرَواجِبِ",60,"ب",1,0],["فَقَد كُنتُ آبى الضَيمَ إِذ لَيسَ ناصرٌ","سِوى عَزمَتي وَالعيسِ وَالمَهمَهِ القَفرِ",61,"ر",1,0],["فَقَد كَلَّفتَني خُطَطاً أَشابَت","قَذالى قَبلَ خَطٍّ في عِذاري",62,"ر",2,0],["فَقَد كُنتُ قَد عِفتُ القَريضَ زَهادَةً","بِمُستامِهِ إِذ يُرخِصُ الدُرَّ جاهِلُه",63,"ل",2,0],["فَقَد كَفاكَ مُقاساةَ الأَذى مَلكٌ","مُتَوَّجٌ بَينَ فَضلِ ذِي النَدى وَعَلي",64,"ل",2,0],["فقد كنت مرعى للشباب ومرتعا","إذا جف منه جانب طاب جانب",65,"ب",1,0],["فَقد كانَ تنّوراً لطوفانِ غيّهم","وَلكن محلَّ الماءِ فارَ لَهُم جَمرا",66,"ر",2,0],["فقد كفّنت قيثاري","وكأسي مذ كبا الجدّ",67,"د",1,0],["فقدْ كانَ إن هزَّ اليراعَ رأيتهُ","يصولُ بأمضى من فرندِ القواضبِ",68,"ب",1,0],["فقد كانَ منهمْ مقرُّ العلوم","كما كان فيهم مقرُّ الأدب",69,"ب",1,0],["فقد كفى اللَه ما خافوا وما حذروا","فعاد مستبشراً مَن كان مهموما",70,"م",2,0],["فقد كان أيضاً مالكاً لعبتْ بهِ","خطوبٌ وأنت اليوم كهفُ الترحُّم",71,"م",1,0],["فقد كفاك أذى الأعداءِ كلّهم","نصرُ الإله وسيف الدهر والقَدَر",72,"ر",1,0],["فَقَدْ كُنْتَ تُولِينَا النَّدَى وَتُمِدُّنَا","إِذَا اصْطَرَّنَا خَطْبٌ لَكُمْ وَأَجَاءَنَا",73,"ن",2,0],["فَقَد كانَت لَنا وَلَهُنَّ حَتّى","زَوَتنا الحَربُ أَيّامٌ قِصارُ",74,"ر",1,0],["فَقَد كنت في ذابان اعثر مرة","وأسقط أخرى كل ذاكلغوب",75,"ب",1,0],["فقد كان ما قد أنذروا بوقوعه","فهل بعده للدهر صولةُ فاتك",76,"ك",1,0],["فَقَد كانَتِ الدُنيا تُجامِلُني بِهِ","وَتَرفَعُني مِنهُ إِلى المَنزِلِ الأَسنى",77,"ن",2,0],["فَقد كانَ في مَرضاتهِ جلّ سَعيها","وَعَن غيرِ ما يُرضيهِ كانَ اِحتِراسُها",78,"س",3,0],["فَقَد كانَ مِقداماً كَريماً مَكرَما","مُحِباً لِخَيرٍ مُحيِياً سَنَةَ الآلِ",79,"ل",1,0],["فَقَد كانَ زيناً للعشيرةِ كلّها","وَكانَ حَميداً حيثماً كان من حمدِ",80,"د",1,0],["فَقَد كُنّا نَعدّهمُ قَليلا","وَقَد صاروا أَقَلَّ مِن القَليلِ",81,"ل",1,0],["فقد كان كُلُّ مِن حَضيضٍ بوثْبةٍ","من الجهلِ يَبْغي أن يَنالَ سُكاكا",82,"ك",2,0],["فقد كنتَ قِدْماً تَرتَضِي ما أقولُه","وما تَرتَضيهِ أنت لا شَكّ مُرتَضى",83,"ض",2,0],["فَقُد كَيفَما شِئتَ السَعادَةَ تَتَّبِع","وَغَيرُكَ لا يَقتادُها بِالشَكائِمِ",84,"م",1,0],["فقَد كانَ بماءِ الوَص","لِ فيها ماؤها قائِم",85,"م",1,0],["فقد كثر يا ربنا ذنبنا","وقد تعرضنا به للعقاب",86,"ب",1,0],["فقد كنت مأوى الغواني التي","شموس الجمال بها تجتلي",87,"ل",2,0],["فقد كان أصناف العصاة ثلاثة","كما قد رواه المسندون ذوي النقد",88,"د",1,0],["فقد كفر الشيخ ابن تيمية ومن","سواه من الأعلام في السهل والنجد",88,"د",1,0],["فقد كان قنديل المساجد في الدجى","ينورها بالذكر والصلوات",89,"ت",1,0],["فَقَد كانَ شَكا شَوقاً","إِلَيكَ النَهيُ وَالأَمرُ",90,"ر",1,0],["فقد كنتَ للظمآن أعذبَ منهلٍ","وقد كنتَ غيثاً بالمكارم ممطرا",91,"ر",2,0],["فقد كنتُ لا أعطي الحوادث مقودي","وإنِّي لريب الدهر لا أتوجَّع",92,"ع",1,0],["فقد كفّ كفّ الخطب إذ فكّ بالندى","ذوي العسر لمّا اوثقتهم يد الأسر",93,"ر",1,0],["فقَد كادَ يَصدَعُ صُمَّ السِّلامِ","وَيُضرِمُ نارَ الأَسى فِي الهواءِ",94,"ا",2,0],["فقد كنت المقدم في النوادي","ملاثاً بالعلا غير الملاث",95,"ث"