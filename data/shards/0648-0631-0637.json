{"poems":[[63,"هم صرموا حبل الهوى فتصرما","https://www.aldiwan.net/poem51445.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85330","الخفيف"],[505,"ما عرفت الولي إلا بدلق","https://www.aldiwan.net/poem37938.html","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[2708,"","https://poetry.dctabudhabi.ae/diwan/poem/80426","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94314","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89397","الرجز"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119602","الرجز"],[6102,"معلمة الموسيقى ..","https://www.poetsgate.com/ViewPoem.aspx?id=185060",""],[6102,"مَيس ..","https://www.poetsgate.com/ViewPoem.aspx?id=185073",""]],"verses":[["ورَطْبَ لآلي الحَلْيِ لمَّا تَبَسَّمَتْ","إليه مَصابيحُ البُروقِ تَبسَّما",0,"م",2,0],["ورطتني وبعد ما ورطتني","أَخذت في مذمتي وَملامي",1,"م",2,0],["ورَطيبُ النَّخيلِ في الشَّرقِ يا من","راحَ يرجو الْتِقاطَهُ بفَرُوق",2,"ق",1,0],["ورطب النصبَ الذي فيها خَتَم","بستة كذلك الذيل المُتَم",3,"م",1,0],["وَرِطْبِ اليَدَيْنِ لِلجَوَارِي","بِشَحْمِهِ ذَاكَ مع القِشَار",4,"ر",1,0],["ورطبي أمه يبس","واما مدمعي فندى",5,"د",2,0],["ورطل صابون ونصف ليَّهْ","هدية حطَّتها في الدكان",6,"ن",1,0],["ورطنوا ما بينهم وحاصوا","وبالدِّلاص المسردات غاصوا",7,"ص",3,0],["وَرُطُوبَةَ العَرَقِ الشَّهِيِّ بِرَاحَتِي","لَمَّا ضَمَمتُكَ, وَالأمَانِي فِيَّ خَجلَى",8,"ل",2,0],["وَ رَطَّبَتِ الكَفَّينِ مِنْ طَلِّ نَرجِسٍ","وَ ضَوَّعَتِ الآقَاحَ فِي جِيدِها عِطرا",9,"ر",2,0]]}