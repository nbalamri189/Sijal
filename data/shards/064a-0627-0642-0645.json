41.html","مخلع البسيط"],[591,"يا قمرا رأيته في مأتم","https://www.aldiwan.net/poem17634.html","الرجز"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53818","السريع"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34433","الرجز"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34434","السريع"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39051","السريع"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63739","المنسرح"],[905,"","https://poetry.dctabudhabi.ae/diwan/poem/146462","السريع"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70691","السريع"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62450","السريع"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120076","السريع"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120085","السريع"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44984","البسيط"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111177","البسيط"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109143","السريع"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102297","المنسرح"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44834","السريع"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115966","الرجز"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115935","السريع"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/116012","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108965","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27161","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27196","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27158","الرجز"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105067","السريع"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93603","السريع"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45630","المنسرح"],[2552,"","https://poetry.dctabudhabi.ae/diwan/poem/144425","السريع"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100261","البسيط"],[3069,"","https://poetry.dctabudhabi.ae/diwan/poem/198297","السريع"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132776","السريع"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71307","السريع"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29297","السريع"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40060","المنسرح"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45078","السريع"],[4469,"","https://poetry.dctabudhabi.ae/diwan/poem/103136","الرجز"],[4470,"","https://poetry.dctabudhabi.ae/diwan/poem/125356","الرجز"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33482","المنسرح"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204176","السريع"],[4693,"يبكي الفؤاد","https://www.poetsgate.com/ViewPoem.aspx?id=29934",""],[4693,"الزمن العجيب","https://www.poetsgate.com/ViewPoem.aspx?id=29935",""],[4739,"الملهمة","https://www.poetsgate.com/ViewPoem.aspx?id=28035",""],[4764,"يا جروح(ن) ما شكتني","https://www.poetsgate.com/ViewPoem.aspx?id=32994",""],[4578,"من أطلع الريحان في الجلنار","https://www.poetsgate.com/ViewPoem.aspx?id=49426",""],[4869,"تقول يامجنوون","https://www.poetsgate.com/ViewPoem.aspx?id=151628",""],[5087,"يا قمراً جدار حين استوى","https://www.poetsgate.com/ViewPoem.aspx?id=96358",""],[5136,"يا قمراً دارت له هالة","https://www.poetsgate.com/ViewPoem.aspx?id=121582",""],[5431,"ياقمحة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=185535",""],[5542,"صرخة مرصعة بالإخلاص","https://www.poetsgate.com/ViewPoem.aspx?id=10073",""],[5606,"ياقمرنور بنورك","https://www.poetsgate.com/ViewPoem.aspx?id=194585",""],[5725,"ياقمر بالشفق الغاسق","https://www.poetsgate.com/ViewPoem.aspx?id=185751",""],[5725,"احجية الحب","https://www.poetsgate.com/ViewPoem.aspx?id=186471",""],[5956,"ندعو تفوز مثوبة الرحمن","https://www.poetsgate.com/ViewPoem.aspx?id=193715",""],[5975,"نظراتك","https://www.poetsgate.com/ViewPoem.aspx?id=52969",""],[5988,"يا قمر الكرخ ان عبدكم","https://www.poetsgate.com/ViewPoem.aspx?id=99725",""],[6001,"هلا وغلا","https://www.poetsgate.com/ViewPoem.aspx?id=694",""],[6032,"كم ليل العاشق ممتدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=181516",""],[6056,"غارس الورد","https://www.poetsgate.com/ViewPoem.aspx?id=130527",""],[6093,"خَالِد","https://www.poetsgate.com/ViewPoem.aspx?id=198602",""],[6099,"دندنات","https://www.poetsgate.com/ViewPoem.aspx?id=35797",""],[6345,"كم ليل العاشق ممتد !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78641&r=&rc=12",""]],"verses":[["يا قَمَراً عُطِّلَ الظَلامُ بِهِ","يا دُرَّةً لَم يُكِنَّها الصَدَفُ",0,"ف",1,0],["يا قَمَراً مَطلَعُهُ المَغرِبُ","قَد ضاقَ بي في حُبُّكَ المَذهَبُ",1,"ب",1,1],["يا قمراً قد سام عشَّاقه","خسفاً بهجرانٍ وإبعاد",2,"د",1,0],["يا قمراً وَكَّلَني بينُهُ","برِعْيَة الكوكب فالكوكبِ",3,"ب",1,0],["يا قمراً فوق رأسه تاجُ","يخجل من حسنِ لونه العاجُ",4,"ج",1,1],["يا قمر الموكب والمجلسِ","أفْطِر على القهوةِ والنرجسِ",5,"س",1,1],["يا قمراً كان إذا ما بدا","بين نجومِ الليل لم تشتبك",6,"ك",1,0],["يا قمراً أوْفى على سَرْوةٍ","وسرْوَةً أوفت على عانِك",7,"ك",1,0],["يا قَمَراً مُنذُ غابَ عَنّي","لَم يَتَّصِل بِالسُعودِ نَجمي",8,"م",2,0],["ياقَمَرَ السَعدِ الَّذي","لَدَيهِ نَجمي قَد سَقَط",9,"ط",1,0],["يا قَمَراً أفقُهُ فُؤادي","مقالةٌ لَم تُشَب بِإِفكِ",10,"ك",1,1],["يا قَمَراً قَلبي لَهُ مَطلَعُ","وَشادِناً في مُهجَتي يَرتَعُ",11,"ع",1,1],["يا قَمَراً أَصبَحَ لي مالِكا","لا تَترُكَنّي هَكَذا هالِكا",12,"ك",2,1],["يا قمارى الروض في أيك الهوى","جفّت الروضة من بعد النديم",13,"م",1,0],["يا قَمَراً أَبرَزَهُ مَأتَمٌ","يَندُبُ شَجواً بَينَ أَترابِ",14,"ب",1,1],["يا قَمَرَ اللَيلِ إِذا أَظلَما","هَل يَنقُصُ التَسليمُ مَن سَلَّما",15,"م",2,1],["يا قَمَراً في السَماءِ مَسكَنُهُ","وَنَرجِسُ الأَرضِ في البَساتينِ",16,"ن",1,1],["يا قمرَ الأرضِ إنْ تغبْ فلقد","أقمتَ للناس كوكباً يُزْهَرْ",17,"ر",1,0],["يا قَمَراً أَجْحَفَ الخُسُوفُ بِهِ","قَبْلَ بُلوغِ السَّواءِ في الْعَدَدِ",18,"د",1,0],["يا قَمَري مَن قَمرك","حسنَكَ حَتّى غَيَّرَك",19,"ك",1,1],["يا قمراً لا يعرف الأفولا","كل سنىً لا بد أن يحولا",20,"ل",2,1],["يا قَمَراً غَابَ عَنْ عِياني","بِاللَهِ قُلْ لي مَتى الطُّلوعُ",21,"ع",1,0],["يا قَمَراً مَطلَعُهُ فِي الحَشى","سُبحانَ مَن في خَلَدِي خَلّدَك",22,"ك",1,1],["يا قمراً في الفؤادِ مطلعهُ","ومن سُوَيدائِهِ لهُ غسقُ",23,"ق",1,0],["يا قمرَ الآفاقِ هل","سرقتَ حسنَ قمري",24,"ر",2,0],["يا قمراً صار حُسنُه عَلَما","قتلتَ خَلقاً وما سفكتَ دَما",25,"م",2,1],["يا قمر العليا وسعد بروجها","ومطلع شمس الجود يا واحد العصر",26,"ر",1,0],["يا قمراً لم يجُدْ لِعاشِقه","ببعضِ ما يشتهِيهِ مذ طلعا",27,"ع",2,0],["يا قَمَراً في القَلبِ أَضحَت لَهُ","دَقائِقٌ تَخفى عَلى كوسِيار",28,"ر",1,0],["يا قمة الطهر المصفّى في الدّنا","خير الورى...بمكارم الأخلاق",29,"ق",1,0],["يا قمراً في تمامه طلعا","هذا رسولي إليك قد رجعا",30,"ع",2,1],["يا قمرا فرعه الظلام على","غصن نقا باسماً بأنجمه",31,"م",2,0],["يا قمرا يشرق من فرعه","الزاهي على غصن نقا زاهر",32,"ر",1,0],["يا قَمَراً وَصلُهُ الحَياةُ","عِندي وَهِجرانُهُ الوَفاةُ",33,"ه",1,1],["يا قَمَراً طالِعاً عَلى غُصُنِ","سُبحانَ مَن أَودَع الجَبين سَنا",34,"ن",2,0],["يا قَمَراً مَطلَعُهُ مُطمِعي","في فَلَكٍ مِن فِكرِهِ دائِرِ",35,"ر",1,0],["يا قمرٌ يوعدُني طرفُه","بوصلهِ لو صَحَّ مَوعودُهُ",36,"د",2,0],["يا قَمَراً عارَضَني عَلى وَجل","وَصالُهُ يُشبِهُ تَأخيرَ الأَجَل",37,"ل",1,1],["يا قمراً حلّ عقد صبري","فَمَا لِسرّي بهِ انْكتامُ",38,"م",1,1],["يا قمراً في قباء أزرق","يغني عن الطالع والغارب",39,"ب",1,1],["يا قَمراً في الفُؤادِ حَلاّ","دَمي حَرامٌ فكيفَ حَلاّ",40,"ل",2,1],["يا قمرَ الأرض لا أراني","رَبِّي ورَبُّ الورى سِرارَكْ",41,"ك",1,0],["يا قمرٌ أعْجَبُ مَا فيهِ","دُرّ بديعُ النّظِم في فيهِ",42,"ه",1,1],["يا قمراً في غُصنِ بانٍ على","نَقاً مَهُولٍ غيرِ مُنهالِ",43,"ل",1,0],["يا قمرٌ دونهُ حجاب","عنّي سنا البدر لا حجب",44,"ب",1,0],["يا قمراً فارقه حبه","ومن حميا ثغره ما ارتوى",45,"و",2,0],["يا قمراً قلوبَنا قد قمَرا","ويا قضيباً لا يزال مُثمِرا",46,"ر",2,0],["يا قمراً قد قمَرا","قَلبي لما غَدرا",47,"ر",2,0],["يا قمراً أصبحت في حبه أعتب","من لا يرعوي المعتاب",48,"ب",1,1],["يا قمراً طالعاً علينا","بوجهه المشرق المطل",49,"ل",1,0],["يا قَمَراً رَأَيْتَهُ فِي مَأْتَمٍ","مِنْ حُزْنِهِ شَقَّ على شَقِيقِهِ",50,"ه",1,1],["يا قمرا قد صار مثل الهلال","من بعد ما صيرني كالخلالْ",51,"ل",1,1],["يا قَمَري قَلبي فَلَك","سِر فيهِ فَهوَ قَد سُر",52,"ر",1,0],["يا قمراً أَثمَرَهُ غصنُ بان","قاسي الجنان",53,"ن",1,0],["يا قَمراً مَغرِبُهُ مُهْجَتي","وأُفْقُهُ لَحْظي إذا يَنْجَلي",54,"ل",2,1],["يا قمراً في غَمامَةِ المِغْفَرْ","واسطةُ التاجِ أَنْتَ والمِغْفَرْ",55,"ر",1,1],["يا قمراً قلبي له منزلُ","قد رق لي في حبك العذلُ",56,"ل",1,1],["يا قمرَ الدهرِ ويا شمسه","لولاك لا شمس ولا بدرا",57,"ر",2,0],["يا قمراً معترضاً بينهم","ما أنت إلا فاصل أجنبي",58,"ب",2,0],["يا قمر الإحسان والجود","راجيك حقا غير مردودِ",59,"د",1,1],["يا قمرا راحته مزنة","وخلقه حمى معشبُ",60,"ب",1,0],["يا قَمَراً وافَقَ التَماما","اِقرَأ عَلى شَبهِكَ السَلاما",61,"م",2,1],["يا قمراً وجهه وعقلي","كلاهما في السنا تجنن",62,"ن",1,0],["يا قمراً أبصرت في حفلةٍ","يختال تيهاً بين نجمين",63,"ن",1,1],["يا قمراً أصبحت محاسنه","تنهب ألبابنا وتسترق",64,"ق",1,0],["يا قَمَراً مَطلَعُهُ أَضلُعِي","لَهُ سَوَادُ القَلبِ فِيهَا غَسَق",65,"ق",1,1],["يا قمَراً فى غُصُنٍ من بانةٍ","يميلُ عُجباً فى كثيب من نَقَا",66,"ق",2,0],["يا قمراً أقبل يسعى على","غصنٍ من الأغصان مهزوزِ",67,"ز",1,1],["يا قمراً فى غُصُنِ","هواكَ قد تَيَّمنِى",68,"ن",2,1],["يا قمراً أقبل من ديره","أسير للمعروف من سيره",69,"ر",2,1],["يا قَمَراً تَحتَ دُجىً","خُذ مِنهُ شَيئاً وَدَعِ",70,"ع",1,0],["يا قمرَ الأسرارِ يا مُلبسي","غِلالةً من أخضر السندسِ",71,"س",1,1],["يا قَمَراً في شَفَقٍ مِن خَفَرٍ","في خَدِّهِ لاحَ لَنا مُنتَقِبا",72,"ب",2,0],["يا قمراً بالوصل حياني","فبّت في شوق وريحان",73,"ن",1,1],["يا قَمَر التم إِلامَ السرار","ذابَ مَحبوك مِن الانتظار",74,"ر",1,1],["يا قَمَراً ثَوبَهُ وَرامقه","مِنهُ حذار البَلى عَلى خَطَر",75,"ر",1,0],["يا قمراً غادرَ عيني معاً","سُهداً ودهري كلَّه سهوا",76,"و",2,0],["يا قمر الأرض أين تغدو","قصدك نجدٌ وأين نجدُ",77,"د",1,1],["يا قمر المجد وبحر النّدى","ومن غدا محياه هلك العدى",78,"د",2,1],["يا قمر النادي وشمس العلا","وكوكب الساري ومأواه",79,"ا",2,0],["يَا قَمَراً في مُهْجَتِي لَمْ يَزَلْ","مَطْلَعُهُ المَّشْرقُ وَالمَغْرِبُ",80,"ب",1,0],["يا قَمَراً ساطِعاً","قَد لاحَ في صُغرَه",81,"ر",2,0],["يا قمراً أصْبَحَتْ محاسِنُهُ","تَنْهَبُ ألبابَنا وتقْتَسِمُ",82,"م",1,0],["يا قَمَراً أَبصَرتَ في مأتَمٍ","أَنتَ مِنَ الفِردَوسِ أَو أَنتَ مَن",83,"ن",1,1],["يا قمر الأرض ومن","علا سماء ورجح",84,"ح",1,0],["يا قمر الطوارق تاجا على المفارق","لاح من المشارق بدّل ليلتي ضحا",85,"ا",1,0],["يا قمراً دانتِ القلوبُ لهُ","يُشرِقُ في غصنِ بانةٍ خَضِلِ",86,"ل",1,0],["يا قمرا كالخشف في نظرته","وكالقضيب اللدن في خطرته",87,"ت",2,1],["يا قمة الأدب الرفيع ومشعلا","للنور في صمت الأحبة يسطع",88,"ع",1,0],["يا قمة الأدب الرفيع وغيمة","حُملت على امتانها الأمطار",89,"ر",1,0],["ياقمر .. كلّي عيون تسامره","ياأمل .. ما خلّق ياس يذوبه",90,"ب",2,0],["يا قمم ياما سمعنا / اجتماعات وخطابه","وما لقينا غير ظلمٍ ،، غير بهتان او تجني",91,"ن",2,0],["يا قمراً عيناه في حبه","قد لاعبت أهل الهوى بالقمار",92,"ر",1,0],["ياقمرتي شوفك كما عزف ولحون","والا نجوم الكون ماهن بيغرن",93,"ن",1,0],["يا قمراً جدار حين استوى","فزاد حسناً وزادت هموم",94,"م",1,1],["يا قمراً دارت له هالة","حمراء من جهل دعوها خمار",95,"ر",1,1],["ياقمحة الروح ياينبوع منهلها","اقطف سنابل عشق طاب مذْ ركعا",96,"ع",2,0],["يا قمة الإسلام تيهي","غردي لن تستباحي",97,"ح",2,0],["ياقمر نور بنورك ياقمر","يا قمرنا ماتغطيك المزون",98,"ن",1,1],["ياقمر ياحلو يانور البصر","طلعتك تجلى من القلب الحزون",98,"ن",1,0],["ياقمر يابدر ولا ياشهر","هي قريبه شوفتك ولا ظنون؟",98,"ن",1,0],["ياقمر بالشفق الغاسقِ","قد لاح لي كالذهب البارقِ",99,"ق",1,1],["ياقمراً فاصفِ لنا خلوة","لاتكثري من حجج الداحضِ",100,"ض",1,0],["يا قمة الأخلاق والإحسانِ","ندعو تفوز مثوبة الرحمنِ",101,"ن",1,1],["يا قمري طفله","يا بنت العوسج والدفله",102,"ل",2,1],["يا قمر الكرخ ان عبدكم","غريقُ شوقٍ صريعُ أسقام",103,"م",1,1],["ياقمر ليلي ومربوحي","نورك يضوِّي بكل الحي",104,"ي",1,0],["يا قمرا ما بالك ساه ٍ","تتركنا حينا وتردُ",105,"د",1,0],["ياقمر، وين نورك ليلي أطول غلاسه","غاب عني وأنا بالدرب ما امشي بدونه",106,"ن",2,0],["يَا قِمةَ الأخْلاقِ يا شمسَ الوَرَى","قَدْ سَار حبُّكَ في العُرُوق مع الدِّمَا",107,"م",2,0],["ياقمراً يحلمُ بالآتي","ودوربُ الآتي قدْ صُلِبَتْ",108,"ت",1,0],["يا قمرٌ ما بالك ساه ٍ","تتركنا حينا وتردُ",109,"د",1,0]]}