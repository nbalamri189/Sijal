{"poems":[[65,"نبأ تقاصر دونه الأنباء","https://www.aldiwan.net/poem46201.html","الكامل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101525","الرمل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109123","الكامل"],[2052,"","https://poetry.dctabudhabi.ae/diwan/poem/101426","الكامل"],[2696,"","https://poetry.dctabudhabi.ae/diwan/poem/10410","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130761","الطويل"],[240,"","https://poetry.dctabudhabi.ae/diwan/poem/13207","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48326","الكامل"],[3724,"","https://poetry.dctabudhabi.ae/diwan/poem/145220","المتقارب"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103005","الخفيف"],[5338,"إن لم تثر في نصر أهلك في اليمن","https://www.poetsgate.com/ViewPoem.aspx?id=187944",""],[6102,"بَراءَةُ الذِّئب !!","https://www.poetsgate.com/ViewPoem.aspx?id=183166",""]],"verses":[["فأذَلَّ أعناقاً خَضَعْنَ لفَقْدِهِ","وهْيَ التي طَمَحَتْ بها الخُيَلاءُ",0,"ا",2,0],["فاذ لامسهُ معصمها","كَهَربت انفاسهُ منها اليدُ",1,"د",1,0],["فاذله وأهانه بل سَبَّهُ","بل شكَّهُ في صدره بعصاه",2,"ا",2,0],["فَأَذِلْ مَصوناتِ الدُّموعِ فإنَّما","هِيَ سُنَّةٌ قد سَنَّها العُشّاقُ",3,"ق",1,0],["فَإِذ لَم يَكُن عَن غايَةِ المَوتِ مَدفَعٌ","فَأَهلاً بِها إِذ لَم تَزَل في المَراحِبِ",4,"ب",1,0],["فاذللتُ دمعي في هواها لعلها","ترق لصبري أو تعود عن الشط",5,"ط",1,0],["فَأَذِل عَلى قَبري الدُموعَ وَقُل","هَذا صَريعُ الأَعيُنِ النُجلِ",6,"ل",1,0],["فأذلّ عاصيَها بعزِّكَ بعْدَ ما","أضْحى رِضاكَ مؤمّناً مُنْقادَها",7,"د",3,0],["فإذ لم يروا نصرنا في الملم","ببذل اللهى واحتمال النصب",8,"ب",1,0],["فأذلنا بقيّة الدم والدم","ع لما طلّ من بقايا الطلول",9,"ل",1,0],["فَأَذَلَّهَا وَهْيَ العَزيزَةُ عِنْدَكُمْ","لَمْ تَعْلَموا مَا الذِّئْبُ يُضْمِرُ مِنْ دَخَنْ(٩)",10,"ن",1,0],["فَأَذَلُّوهُ فِي إِمارَةِ شِعرٍ","خَصخَصُوها لِشاطِئِ التَّشوِيقِ",11,"ق",1,0]]}