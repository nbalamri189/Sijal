{"poems":[[90,"حي هل يا أخا مصر","https://www.aldiwan.net/poem44435.html","مجزوء الخفيف"],[90,"هم يعدون بالمئات ذكورا","https://www.aldiwan.net/poem44829.html","الخفيف"],[93,"ليس يدري الهم غير المبتلي","https://www.aldiwan.net/poem9064.html","عموديه"],[93,"أعلى عيني من الدمع غشاء","https://www.aldiwan.net/poem62753.html","عموديه"],[87,"كزبك بطير الجمال اعترت أيكاته","https://www.aldiwan.net/poem7902.html","البسيط"],[87,"مال واحتجب","https://www.aldiwan.net/poem63725.html","مجزوء المتدارك"],[45,"إنما بدر بن عمار سحاب","https://www.aldiwan.net/poem9467.html","الرمل"],[99,"عش مديدا وجدد","https://www.aldiwan.net/poem24978.html","مجزوء الخفيف"],[107,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[48,"ساء بريا من البرايا","https://www.aldiwan.net/poem23609.html","مجزوء البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39569","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54889","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141916","الكامل"],[92,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""],[118,"إني بدهماء عز ما أجد","https://www.aldiwan.net/poem20955.html","المنسرح"],[147,"عاذ بالصفح من أَحب البقاء","https://www.aldiwan.net/poem11716.html","الخفيف"],[214,"يا بريقاً بالحمى قد لمعا","https://www.aldiwan.net/poem13314.html","الرمل"],[275,"هلا التفت لكي نحييك","https://www.aldiwan.net/poem35361.html","أحذ الكامل"],[280,"سما بأمرك إسعاد وإنجاد","https://www.aldiwan.net/poem25589.html","البسيط"],[309,"مرحباً بالشادن الغزل","https://www.aldiwan.net/poem16881.html","المديد"],[358,"قيل لي ما لعصبة","https://www.aldiwan.net/poem39969.html","مجزوء الخفيف"],[385,"أخلق الدار بالعقيق الدثور","https://www.aldiwan.net/poem49208.html","الخفيف"],[396,"من أراد لهم والغم الكبير","https://www.aldiwan.net/poem54561.html","عموديه"],[422,"إسأل الأرسم لو ردت جوابا","https://www.aldiwan.net/poem54032.html","الرمل"],[435,"يا خليلا لم أكن عنه خلي","https://www.aldiwan.net/poem41022.html","الرمل"],[529,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[534,"الزم الانقباض إن انبساط","https://www.aldiwan.net/poem37125.html","الخفيف"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54082","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38950","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62449","الرمل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56088","الرمل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56579","الخفيف"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82688","الخفيف"],[1616,"","https://poetry.dctabudhabi.ae/diwan/poem/206238",""],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106915","الرمل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93677","الرمل"],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131726",""],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132710","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109972","الرمل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110006","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91301","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85198","الرمل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128894","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114280","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114501","الرمل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44892","الرمل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81235","الخفيف"],[4691,"يئست نفسي بعد طول الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=61768",""],[4718,"ياصاح انا قلبي من الهم طاويه","https://www.poetsgate.com/ViewPoem.aspx?id=137214",""],[4737,"مثلها ليس يُنسى","https://www.poetsgate.com/ViewPoem.aspx?id=212160",""],[4767,"أمي","https://www.poetsgate.com/ViewPoem.aspx?id=179435",""],[4802,"الليره...والليره","https://www.poetsgate.com/ViewPoem.aspx?id=34357",""],[4849,"يا زايد !؟","https://www.poetsgate.com/ViewPoem.aspx?id=53504",""],[4869,"مضمار قضاعه","https://www.poetsgate.com/ViewPoem.aspx?id=137915",""],[5463,"نامي وزيدي المنام","https://www.poetsgate.com/ViewPoem.aspx?id=25790",""],[5463,"ودّي اضمّه ضمّة ٍ مثل الأحباب","https://www.poetsgate.com/ViewPoem.aspx?id=27047",""],[5652,"تعال نشرب في معيتك الاشواق","https://www.poetsgate.com/ViewPoem.aspx?id=157191",""],[5694,"من العايدين","https://www.poetsgate.com/ViewPoem.aspx?id=132100",""],[5919,"هبّ نشرُ المعنبرِ المخزونِ","https://www.poetsgate.com/ViewPoem.aspx?id=128683",""]],"verses":[["ما بهم غير حاسد","دائب في المكايد",0,"د",1,0],["ما بهم ما يَميزهم عن بني السُو","قة إلاّ رسوخهم في الجهاله",1,"ل",2,0],["ما بِها لا كانَ شَرّاً ما بِها","ما لَها مِن أَمرِها في خَبَلِ",2,"ل",1,0],["ما بِهِ عَجزٌ وَلا داءٌ عَياء","غَيرَ أَنَّ الجوعَ قَد هَدَّ العِظام",3,"م",1,0],["ما بهجة العصر إلا جركسياته","من كل هيفا لها عند الدلال إدلال",4,"ل",1,0],["ما بِهِم صَدىً","ما بِهِم سَغَب",5,"ب",1,0],["ما بِهِ قَتلُ أَعاديهِ وَلَكِن","يَتَّقي إِخلافَ ما تَرجو الذِئابُ",6,"ب",1,0],["ما به من تزلف","جل شعري ومقصدي",7,"د",2,0],["ما بِهِ نَفْسُه فيغضبُ يُرضي","ها وَتُرضيهِ ناعماً مسرورا",8,"ر",2,0],["ما بَهَشوا بِالسَلامِ نَحوي","وَلا أَراهُم مُحاوِرِيّا",9,"ر",3,0],["ما به مرفأ يَبينُ ولكنْ","نحن نمضي في لجِّه وهو يمضي",10,"ي",1,0],["مَا بِهَا نَبْوَةٌ عَلَى أَنَّهُ الوَا","دِعُ آناً وَآناً الضِّرْغَامُ",11,"م",1,0],["مَا بِهِ مِنْ نَبالةٍ وَأَناةٍ","وَمَضَاءٍ فِي الرَّأْيِ وَالتَّدْبِيرِ",12,"ر",1,0],["مَا بِهِ مِنْ نَزَاهَةٍ وَصَفَاءٍ","وَوَفَاءٍ وَمِنْ سَمَاحٍ وَخيْرِ",12,"ر",1,0],["مَا بِهَا حَوْلٌ وَلا طوْلٌ وَلا","تقْتنِي جَاهاً وَلا تمْلِكُ وَفْرَا",13,"ر",2,0],["ما بهجة الأعياد بعد كعهدها","في البيعتين ولا المرتل يسجع",14,"ع",1,0],["ما به من نحافةٍ يُستَشَفُّ العظمُ","منها ولا به من سَمانه",15,"ن",2,0],["ما به من نقيصةٍ وكأنّ الثوب","أضحى متمماً نُقصانه",15,"ن",2,0],["مَآبِهُ الرومُ أَو تَنوخُ أَو ال","آطامُ مِن صَوَّرانَ أَو زَبَدُ",16,"د",1,0],["ما بَهَرتَ العُقولَ يا مُعجِزَ الآ","ياتِ إِلّا لِتَجمَعَ الأَهواءَ",17,"ا",2,0],["ما به عيب اذا جاد سوى","انه يتلف ما قد جمعا",18,"ع",2,0],["ما بهجةُ الدنيا ونعمتُها","إلا ابتسامُكِ لي وحبيك",19,"ك",1,0],["ما بَهْجَةُ الفِطْرِ والأضْحَى وبَهجَته","لها شُفوفٌ عَلى العِيدَيْنِ مُعْتادُ",20,"د",1,0],["ما به خلف ولا ملل","بئس حال الخلف والملل",21,"ل",1,0],["ما بِهم غَير مدَّعٍ","وَخَسيس وَمن سَفل",22,"ل",1,0],["ما بِها غَير أَغبر أَشعَث الرَأ","س حَبيسٌ عَلى البَلى مَقصورُ",23,"ر",1,0],["ما بها خير فتيل أو نقير","مالها من جملة الشر نصير",24,"ر",1,0],["ما بهم عيب خلا أنَّهم","يَجِدون البخل والإمساك عابا",25,"ب",2,0],["ما بها عيب سوى من زارها","يسلو عن أوطانه والطلل",26,"ل",1,0],["ما بَهجَةُ الشَّمسِ في الآفاقِ مُسفِرَةً","يَوماً بِأَبهَجَ مِن لألاءِ حُسنِهِمِ",27,"م",1,0],["ما بِهَذا الزَّمانِ عِنْدِي فُلانٌ","كُلُّهُمْ إنْ فَطِنْتَ غَيْرُ الْفُلانِ",28,"ن",1,0],["ما به نفسي لبيعٍ سَمَحَتْ","ولَوَ اعْتَضْتُ به مُلْكَ اليَمَنْ",29,"ن",1,0],["ما بِهذا شاهِد قَد جرحا","فَهوَ عَدلٌ ما بِهِ مِن مطعنِ",30,"ن",1,0],["ما بهم جُبن ولكن خذلوا","إذ غدا البغي لديهم مذهبا",31,"ب",2,0],["ما بهم عيب سوى حسن الوفا","والخلوص المرتقي عن دنس",32,"س",1,0],["ما بها روضة ولا عندليب","غير أنّا بها سمعنا الغرابا",33,"ب",2,0],["ما بِها حاجَة إِلَيكَ وَلكِن","هي مَعقودَة بحبلِ الوَفاءِ",34,"ا",2,0],["ما به إلّا الله وزايد للفقير","انتظر فيهم عسى الله ينظره",35,"ر",2,0],["مابها غير مغرم مستهام","أشعلته من الهوى الصعداء",36,"ا",2,0],["ما به إلا فؤادي","هائمٌ فيه مسهد",37,"د",1,0],["ما بِهَذا الدَهر أَحرار تَفي","وَإِذا تَنعم نعما شكروكا",38,"ك",2,0],["ما به مع الترك راحه للعرب","فلا تظن أن فيهم فايده",39,"ه",1,1],["ما بهجة الريحان في رسم عفا","بعد الانيس وأوحشت اطلاله",40,"ل",2,0],["ما بِهِم إِلّا فتىً عاثٍ جَهُوم","مستبيحُ المنهياتِ بلا حَذَر",41,"ر",1,0],["ما بِهِم إِلّا جَهُولٌ قد فَقَد","رُشدَهُ حتى غدا أَعمى البَصَر",41,"ر",1,0],["ما بها من مُجاوبٍ لمُنادٍ","لا ولا من مُودِّعٍ أو مُلاقِ",42,"ق",1,0],["ما بها عيبٌ سوى أَن أَعجزت","عَن مَعالي شكرها دركَ المعان",43,"ن",1,0],["ما بها حر وبرد والصبا","كان فيها بين هذين قواما",44,"م",2,0],["ما بهم عالم هنالك يشقى","ما بهم عالم على الضيم صابر",45,"ر",1,0],["مَا بِهِ جِئتَ تَجَلَّى","مِثلَ بَدرٍ فِي الحَوَالِك",46,"ك",1,1],["ما بهِ جئتَ توفى","في النساءِ هُوَ ذائِع",47,"ع",1,0],["مابِهِ مِن شِرةٍ أو من غَرامٍ","وَادعٌ كَالحلُمِ الزاهي المحبَّبْ",48,"ب",1,0],["ما بِها إِن تَسام في الأَرض خَسفاً","أَو تعادي في رَأيها أَو تكفر",49,"ر",1,0],["ما بها نفسي في الحضيض ِ هوت ْ","بعدما عاشت ْ في جبال ِ الأمل ْ",50,"ل",1,0],["مابه مكاسب لو تبيعه وتشريه","وجرحٍ نزف بالقلب خلّه يولّي",51,"ل",2,0],["ما بها حلوتي قد قسا قلبُها","كيفَ تحيا بلا مبسمي وحدَها",52,"د",3,0],["ما به يقوى كياني","وبه تسمو حياتي",53,"ت",2,0],["مابه تعنصر,يعوج الحق ويديره","وصل الله أقرب من أقرب نبض من وصله",54,"ل",2,0],["مابه ولاشخص عاشر هالحزن قدّي","إلين صرت أعشقه وأبكي على وداعه",55,"ع",2,0],["مآبه قضآعي مآنزل وسط مضمآر","إلا خذآ النآموس وزوّد غلآته",56,"ت",2,0],["مابه في دستور قلبي لا قوايل أو ملام","سوي كل اللي تبينه يا يا بدري المستنير",57,"ر",1,0],["مابه ثقه يا ناس ما بين الأحباب","ولا الثقه معدومه اليوم فيّه",58,"ي",2,0],["مابه اماني حلم والحزن قد فاق","حرفي وهمي والغياب اختيارك",59,"ك",1,0],["مابه غريب ليا طلعنا فوق فوق","لكن غريب نطاوع الرأي الهزل",60,"ل",1,0],["ما بهذا عُرفتِ يا أختَ سعدٍ","فالجميلَ الجميلَ بالمفتون",61,"ن",1,0]]}