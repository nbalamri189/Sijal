x?id=34053",""],[4797,"وش عليك ان همت في وادي مرادي","https://www.poetsgate.com/ViewPoem.aspx?id=77100",""],[4862,"هجير الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=55375",""],[4984,"أمنية العهد البعيد","https://www.poetsgate.com/ViewPoem.aspx?id=175573",""],[5008,"ريح الورودي","https://www.poetsgate.com/ViewPoem.aspx?id=28399",""],[5465,"كيف بالعفو عنهم وقديماً","https://www.poetsgate.com/ViewPoem.aspx?id=98427",""],[243,"دجلة الغضبى","https://www.poetsgate.com/ViewPoem.aspx?id=50472",""],[5717,"يا حسرة من فؤاد محتدم","https://www.poetsgate.com/ViewPoem.aspx?id=170590",""],[5853,"تباريح الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=175697",""],[5906,"مَرَّ بي","https://www.poetsgate.com/ViewPoem.aspx?id=188228",""],[5908,"هل لقلب المتيم المتبول","https://www.poetsgate.com/ViewPoem.aspx?id=170976",""],[5948,"قلتُ ونفسي جَمُّ تأوُّهُها","https://www.poetsgate.com/ViewPoem.aspx?id=100621",""],[6102,"تحذير ..","https://www.poetsgate.com/ViewPoem.aspx?id=183311",""],[6102,"حطب الحقد","https://www.poetsgate.com/ViewPoem.aspx?id=183654",""],[6102,"قاومي","https://www.poetsgate.com/ViewPoem.aspx?id=184633",""],[6321,"نحن من علَّم الغرامَ الغراما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63419&r=&rc=2",""]],"verses":[["كيفَ بالكِتْمانِ يوْماً لامرئٍ","سرّهُ في خدّهِ قدْ نُقِشا",0,"ش",2,0],["كَيفَ بِصاحِبٍ إِن أَدنُ مِنهُ","يَزِدني في مُباعَدَةٍ ذِراعا",1,"ع",2,1],["كيف باللَّهِ برْدُ صِدقي على قل","بك أم كيف طعمُه في مُشاشِك",2,"ك",1,0],["كَيفَ بِهِ وَالزَمانُ يَهرُبُ بِه","ماضي شَبابٍ أَغذَذتَ في طَلَبِه",3,"ب",2,1],["كَيفَ بِبَيتٍ قَريبٍ مِنكَ مَطلَبُهُ","في ذاكَ مِنكَ كَنائي الدارِ مَهجورِ",4,"ر",1,1],["كَيفَ بِدَهرٍ لا يَزالُ يَرومُني","بِداهِيَةٍ فيها أَشَدُّ مِنَ القَتلِ",5,"ل",1,1],["كَيفَ بَقاءُ الفُروعِ يَوماً","وَقَد ذَوَت قَبلَها الأُصولُ",6,"ل",1,0],["كَيفَ بُعدي لا ذُقتُمُ البَينَ أَنتُم","خَبِّروني مُذ بِنتُ عَنكُم وَبِنتُم",7,"م",1,1],["كَيفَ بِأُمّي إِذا رَأَت شَفَتي","وَكَيفَ إِن شاعَ مِنكَ ذا الخَبَرُ",8,"ر",1,0],["كَيْف بِالثْرْوةِ ابتَنَاها لِرهطٍ","شُحُّهُم والخِدَاعُ والتَّطْفِيلُ",9,"ل",1,0],["كَيْفَ بِالْعِلَّةِ الدِّوِيَّةِ مِنْ فِتْ","نَةِ بَاغٍ جَمِّ النَّدَى كَيَّادِ",10,"د",1,0],["كيف بالكتمان يوما لامرىء","سره في خده قد نقشا",11,"ش",2,0],["كيف بعد الختمِ تقوى","أن تبوحَ الشفتان",12,"ن",1,0],["كيف به والجفاء يبعد به","وفرقة الصب منتهى أربه",13,"ب",2,1],["كيف بالفاقدِ المُضيفِ إلى الآ","باء فَقْدَ الإخوانِ والأبناء",14,"ا",2,0],["كَيفَ بِأخواله الصُدور وَهُم","يَرونَ في القَتلِ أَعظمَ الذِكرِ",15,"ر",1,0],["كَيْفَ بِالمَنْجى وأشْراكُ الهَوى","قَلّ مَنْ أَفْلَتَ مِنْها وَنَجا",16,"ج",2,0],["كيف بالصبر والحبيب","غدا اليوم هاجري",17,"ر",2,0],["كيف بالخانقاه ينقل عني","لا لذنب أو جنحة منقوله",18,"ل",2,0],["كيفَ بي إن وَجَدتُ نَقصاً من ال","عَيشِ فأحسَستُ عِندَه إتمامَه",19,"م",2,0],["كيف بأهل ودادهم وإخائهم","فتفضلوا وترحموا واستغفروا",20,"ر",3,0],["كيف بمعدوماته قد غدا","متصفاً والعقل فيها إمام",21,"م",1,0],["كيف بالإعتقاد نال المزايا","دون كل الكلاب والإتياس",22,"س",1,0],["كيف بانصافنا لديك وقد","شاركت آل النبي في نسبكْ",23,"ك",1,0],["كيف بالصبر في رزية ندب","طبق الري والعراق بكاءا",24,"ا",3,0],["كيف بالجُرْد الشماليل التي","مثلما شاهدتُ منها عَلَنا",25,"ن",2,0],["كَيفَ بِنا نَأكُل لَحم الغَنَم","وَنَترُك الذئب بِغَير لَحم",26,"م",1,0],["كَيْفَ بِالصَّائِمِ الّذي هَجَرَ النَّوْ","مَ وفِي قَلْبِهِ النَّوايا لَعِينَهْ",27,"ن",2,0],["كيف بالدّين القديم","لك من أم تميم",28,"م",1,1],["كَيفَ بَعدي كُنتَ يا يو","نسُ لا زِلتُ بِخَيرِ",29,"ر",1,1],["كيف بنت اليوم عن أهل وصحب","وديارٍ كم تقاسى الظُّلمَأ",30,"م",2,0],["كيف بناتُ الوحي أعداؤكم","تدخل بالخيلِ عَليها الخِبا",31,"ب",2,0],["كيف بان أن يبيد الورع إذ","لم يكونا ما ألم نداها",32,"ا",3,0],["كَيفَ بِى إِذ جاءَ رَكبُهُمُو","جائِزاً وَالحَادِ يَقدُمُهُم",33,"م",1,0],["كيف باعدت أو جفوت صديقاً","لا ملولا، لا لا ولا متجن",34,"ن",1,0],["كيف باللّه ما غدت كعيون","سابحات بانهر الاحداق",35,"ق",1,0],["كَيفَ بِالعَبرة أَن تُنجدني","وَالجَوى لَم يُبقِ في الجفن دُموع",36,"ع",1,0],["كيف باتت تهدد الشرق بحراً","بالاساطيل وازدرته طويلا",37,"ل",2,0],["كيف بالصبر بعده أتحلى","عند ما مر والمراشف حلوه",38,"و",2,0],["كيف بالشّاوش يُدعى","وهو في الحسن مليكُ",39,"ك",1,0],["كيف بحر الجور أحرقنا","وأنت ظل اللَه في الأرض",40,"ض",1,0],["كَيفَ بناهُ القوم الَّذين مضوا","ومن هُم يا تُرى من الدوَلِ",41,"ل",1,0],["كَيْفَ بتْنَا مِنَ الظَّمَأ نَتَشَاكَى","يَا لِقَوْمِي وَفى الرِّحَالِ المَاءُ",42,"ا",2,0],["كيف بي لو مضيت عنها شهورا","ثم جرّت تلك الشهور سنينا",43,"ن",2,0],["كيف بعد الصون سيقت حسرا","تتهادى من بلاد لبلاد",44,"د",1,0],["كيف برى الكريم عن جثته","وبلغ العدو فيه الماربا",45,"ب",2,0],["كيفَ بالقَسرِ قد هَوَت نحو أرضٍ","وَهيَ تسمو على الهَوا بالتراقي",46,"ق",2,0],["كيف بي أعذل إن أغنيتني","أنت حتى عن شرابي والطعامْ",47,"م",1,0],["كيف بَعدي لا ذُقْتمُ النومَ أنتمْ","خَبِّروني مذ بِنْتُ عنكم وبِنْتُم",48,"م",1,1],["كيف بها إذا أنت وشعرها","من فوق عينيها عناء مسبل",49,"ل",1,0],["كَيفَ بَعدَ المَهدِيِّ أَو بَعدَ إِبرا","هيمَ نَومي عَلى الفِراشِ الوَثيرِ",50,"ر",1,1],["كيف بنو آدمٍ وهو الذي","له على الفحشاءِ إصرارُ",51,"ر",1,0],["كيفَ بِمن تنتسبُ الش","شمسُ إلى جوهرهِ",52,"ر",2,0],["كَيفَ بِاستِقرارِ حُرٍّ شاحِطٍ","بِبِلادٍ لَيسَ فيها مُتَّسَع",53,"ع",1,0],["كيف بالله يندمل جرحٍ شقي","اعذب احساسك وروحك خنجره",54,"ر",2,0],["كيف باطرح من على شفي شدادي","واقتدي باعمى وتايه واعرج",55,"ج",1,0],["كيف بات القلب يصلى ناره","وشتاء الثلج يذري زمهريرا",56,"ر",2,0],["كيف بالله توارى نورها","كيف حُطَّ الستر عنها من حديد",57,"د",1,0],["كيف بيشوفك ويسلى ويتهنّى","وحال من بينك حرس ذيك الحدودي",58,"د",2,0],["كيف بالعفو عنهم وقديماً","قتلوكم وهتكوا الحرمات",59,"ت",1,1],["كيف بالله كيف تغفو عيون","في حمى كل ظالم غدار",60,"ر",1,0],["كيف بكائي ونار فرقته","جف بها ماء مقلتي وفمي",61,"م",2,0],["كيف بالتضليلِ ترقى أمةٌ؟؟","كيف يا فكرُ حقوقٌ لكَ تُنهبْ؟؟؟",62,"ب",1,0],["كَيفَ بَرقٌ واختَفي","بينَ حَبّاتِ المَطَرْ",63,"ر",1,0],["كيف بي والزمان لا زال يبري","حد قلبي بحد سيف صقيل",64,"ل",1,0],["كيف بها كيفَ وهي نازحةٌ","مشبَّه تيهُها ومَهمهُهَا",65,"ه",3,0],["كَيفَ - بِاللَّهِ - تَستَطِيعُونَ ؟ قُولُوا","أَنْ تُقِيمُوا أَعراسَكُمْ فِي المَقابِرْ !",66,"ر",1,0],["كَيفَ - بِاللَّهِ - يَستَطِيعُ غَرِيرٌ ؟","كَبحَ ضَوئِي بِشَمعَةِ العَجزِ جَهلَا !",67,"ل",2,0],["كَيفَ - بِاللَّهِ - يا حَذامِ ؛ أَجِيبِي","بِجُرُوحِي حِرابُهُمْ تَتَسَلَّى ؟",67,"ل",2,0],["كَيفَ بَعدِي عَشِقْتِ غَيرِي ؟ وَ رَبِّي","مُنذُ أَنْ خُنتِنِي ظَلَلْتُ شَرِيدا",68,"د",2,0],["كيف - بالله - هانَ عندكَ قلبي","كيف صار الهوى لديك اتهاما",69,"م",2,0],["كيف- بالله - ياأنيس حياتي-","صار حبي الكبير... صار حطاما!",69,"م",2,0]]}