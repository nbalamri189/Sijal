{"poems":[[53,"وذي نضد لا يقطع الطرف عرضه","https://www.aldiwan.net/poem30440.html","الطويل"],[53,"لنا كل يوم رنة خلف ذاهب","https://www.aldiwan.net/poem30738.html","الطويل"],[77,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[30,"أراح فريق جيرتك الجمالا","https://www.aldiwan.net/poem29550.html","الوافر"],[30,"ألا لا أرى كالدار بالزرق موقفا","https://www.aldiwan.net/poem29595.html","الطويل"],[27,"تعللنا أمامة بالعدات","https://www.aldiwan.net/poem5692.html","الوافر"],[27,"متى كان الخيام بذي طلوح","https://www.aldiwan.net/poem5991.html","الوافر"],[4,"ألم تلمم على الدمن الخوالي","https://www.aldiwan.net/poem21182.html","الوافر"],[72,"صرفت فعلي في الأسى وقولي","https://www.aldiwan.net/poem20616.html","الرجز"],[51,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8499.html","البسيط"],[51,"إذا أجاد الذي يشبهه","https://www.aldiwan.net/poem9207.html","المنسرح"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"يا ثلج ماء مالح آسن","https://www.aldiwan.net/poem66752.html","السريع"],[85,"تنقل ايها القمر المنير","https://www.aldiwan.net/poem7531.html","الوافر"],[85,"صغار بحلوان تستبشر","https://www.aldiwan.net/poem8065.html","المتقارب"],[45,"هذا كتابك فيه الجهل والعنف","https://www.aldiwan.net/poem65156.html","البسيط"],[45,"أجدك إن لمات الخيال","https://www.aldiwan.net/poem65568.html","الطويل"],[45,"نوائب دهر أيهن أنازل","https://www.aldiwan.net/poem65620.html","الطويل"],[28,"إليك من الصمان والرمل أقبلت","https://www.aldiwan.net/poem1293.html",""],[28,"لقد علم الأحياء في كل موطن","https://www.aldiwan.net/poem5025.html","الطويل"],[28,"إذا عرض المنام لنا بسلمى","https://www.aldiwan.net/poem5154.html","الوافر"],[28,"ولم تك تخشى جعفر أن يصيبها","https://www.aldiwan.net/poem5248.html","الطويل"],[28,"حملت من جرم مثاقيل حاجتي","https://www.aldiwan.net/poem5364.html","الطويل"],[28,"لعمري لقد نبهت يا هند ميتا","https://www.aldiwan.net/poem5649.html","الطويل"],[58,"إذا اجتمع الآفات فالبخل شرها","https://www.aldiwan.net/poem30910.html","الطويل"],[58,"إذا اجتمعت عليا معد ومذحج","https://www.aldiwan.net/poem31026.html","الطويل"],[66,"برق المشيب قد أضا","https://www.aldiwan.net/poem40981.html","مجزوء الرجز"],[44,"عسى وطن يدنو بهم ولعلما","https://www.aldiwan.net/poem30356.html","الطويل"],[31,"قد هاج قلبك بعد السلوة الوطن","https://www.aldiwan.net/poem41294.html","البسيط"],[39,"أساءك تقويض الخليط المباين","https://www.aldiwan.net/poem53738.html","الطويل"],[22,"أفيما خلا من سالف العيش تدكر","https://www.aldiwan.net/poem21656.html","الطويل"],[22,"ألا من لقلب عارم النظرات","https://www.aldiwan.net/poem21659.html","الطويل"],[48,"إذا أجرى أمين الله","https://www.aldiwan.net/poem63434.html","الهزج"],[46,"إذا اجتمع اثنان في منزل","https://www.aldiwan.net/poem22498.html","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16630","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30465","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54540","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54279","الطويل"],[22,"افي ما خلا من سالف العيش تدَّكّرْ","https://www.poetsgate.com/ViewPoem.aspx?id=19747",""],[9,"كَفَى بِالّذِي تُولِينَهُ لَوْ تَجَنّبَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17253&r=&rc=0",""],[132,"إذا اجتمعت يوماً قريش لمفخر","https://www.aldiwan.net/poem21033.html","الطويل"],[141,"أبا زنة لا زال جدك هابطا","https://www.aldiwan.net/poem11736.html","الطويل"],[162,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[162,"على أي رغم ظلت أغضي وأكظم","https://www.aldiwan.net/poem67840.html","الطويل"],[180,"رعى الله مغنى بالعذيب ومعهدا","https://www.aldiwan.net/poem67081.html","الطويل"],[184,"حياتك ليل كلها ونهار","https://www.aldiwan.net/poem43854.html","الطويل"],[184,"إذا اجتهد المنجم بعد علم","https://www.aldiwan.net/poem43919.html","الوافر"],[209,"تناسيتكم عمدا كأني سلوتكم","https://www.aldiwan.net/poem46783.html","الطويل"],[233,"إذا اجتمعت في مجلس الشرب سبعة","https://www.aldiwan.net/poem32157.html","الطويل"],[303,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[303,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[320,"أرقت وشر الداء هم مؤرق","https://www.aldiwan.net/poem56359.html","الطويل"],[335,"أمن دمنتين عرج الركب فيهما","https://www.aldiwan.net/poem45419.html","الطويل"],[362,"أحن إلى تلك الضحى والأصائل","https://www.aldiwan.net/poem60806.html","الطويل"],[362,"ألم تريا أن الحمول تسير","https://www.aldiwan.net/poem60891.html","الطويل"],[369,"خلا طرفه بالسقم دوني يلازمه","https://www.aldiwan.net/poem57103.html","الطويل"],[374,"نصحتك نصحا قل من شأنه النصح","https://www.aldiwan.net/poem66888.html","الطويل"],[377,"رويدا إن للضيق انفراجا","https://www.aldiwan.net/poem48757.html","الوافر"],[400,"هل في القلوب بيوم الحشر إذعان","https://www.aldiwan.net/poem33388.html","البسيط"],[406,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[436,"وفي سر من را من محلي مقاصر","https://www.aldiwan.net/poem34758.html","الطويل"],[441,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[456,"دعوها ترد بعد خمس شروعا","https://www.aldiwan.net/poem56122.html","المتقارب"],[456,"لعلك بالشعب تعلو اليفاعا","https://www.aldiwan.net/poem56128.html","المتقارب"],[456,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[456,"قالوا رضيت قلت ما أجدى الغضب","https://www.aldiwan.net/poem56298.html","الرجز"],[459,"فضلت التهاني بالمراتب والعلى","https://www.aldiwan.net/poem15150.html","الطويل"],[459,"أقوال له والزهو ينغض عطفه","https://www.aldiwan.net/poem15933.html","الطويل"],[462,"قوامك اللدن لا ما يزعم الغصن","https://www.aldiwan.net/poem3196.html","عموديه"],[466,"عندي لون طبخته بيدي","https://www.aldiwan.net/poem60228.html","المنسرح"],[468,"الأكرمون طوال الدهر إن نسبوا","https://www.aldiwan.net/poem4668.html","البسيط"],[477,"هذي العوائد أشعرت","https://www.aldiwan.net/poem36928.html","مجزوء الكامل"],[501,"لعمرك يا جرير لقول عمرو","https://www.aldiwan.net/poem21749.html","الوافر"],[527,"أجيء إليكم إن شاء ربي","https://www.aldiwan.net/poem37149.html","الوافر"],[527,"إذا أجبت دعائي","https://www.aldiwan.net/poem37241.html","المجتث"],[527,"إذا أجبت دعائي فأنت","https://www.aldiwan.net/poem37243.html","مجزوء الرجز"],[560,"فدى الجلابيب والأطمار من وبر","https://www.aldiwan.net/poem52941.html","البسيط"],[573,"نعم هي سعدي وهي لي قمر سعد","https://www.aldiwan.net/poem3086.html","الطويل"]],"verses":[["إِذا أَجَّ بِالإيماضِ قُلتَ اِبنُ كُفَّةٍ","يُضَرِّمُ بِالغابِ الأَباءَ المُسَعَّرا",0,"ر",2,0],["إِذا اِجتازَ رَكبٌ كانَ أَجوَدَ عِندَها","بِعَقرِ المَطايا مِن سُحَيمٍ وَغالِبِ",1,"ب",1,0],["إِذَا اجْتَمَعَ الإِقْدَامُ وَالرَّأيُ وَالتُّقَى","وَسَاعَدَ سَعْدٌ وَاسْتَقَلَّ بِهِ عَزْمُ",2,"م",1,0],["إِذا اِجتَلَدوا بِمُعتَرَكٍ قِياماً","عَلى الشُعثِ العَوابِسِ أَو نِزالا",3,"ل",2,0],["إِذا أَجدَبَت أَرضُ اِمرِئِ القَيسِ أَمسَكَت","قُراها وَكانَت عادَةً تَستَعيدُها",4,"د",3,0],["إِذا اِجتَمَعوا عَلَيَّ فَخَلِّ عَنهُم","وَعَن بازٍ يَصُكُّ حُبارَياتِ",5,"ت",1,0],["إِذا اِجتَمَعوا عَلى سَكَرٍ بِفَلسٍ","فَنَصوٌ عِندَ ذَلِكَ وَاِلتِطامُ",6,"م",1,0],["إِذا اِجتَمَعَت وَأَحوَذَ جانِبَيها","وَأَورَدَها عَلى عوجٍ طِوالِ",7,"ل",1,0],["إذا اجْتليت في العطا جبينهُ","أو اسْتشرت للرجا يمينه",8,"ه",1,0],["إذا أجاد فأوجِبْ قطع مقوله","فقد دهى شعراء الناس بالحَرَبِ",9,"ب",1,0],["إذا أجادَ الذي يُشبِّهُهُ","وأحكَم الوصفَ فيه بالنَّعْتِ",10,"ت",1,1],["إذا اجْتَازَ بَحْراً كَادَ يُنْزَحُ مَاؤُهُ","وإنْ ضَافَ بَرّاً كَادَتِ الأرْضُ تُجرَدُ",11,"د",1,0],["إذا أجابتْ شنطفٌ طَبْلَها","ناحَ عليه نوحَ مَعْنيَّهْ",12,"ي",2,0],["اذا اجتمع الصدور به تنحوا","كما نزلت عن الطغرى السطور",13,"ر",1,0],["إِذا اِجتَمَعَ الكُلُّ في بُقعَةٍ","حَسِبتَهُمو باقَةً تُزهِرُ",14,"ر",1,0],["إِذا اِجتَمَعنا عَلى يَومِ الشِتاءِ فَلي","هَمٌّ بِما أَنا لاقٍ حينَ أَنصَرِفُ",15,"ف",1,0],["إِذا اِجتَبنَ الحُلِيَّ رَأَيتَ بيضاً","أَوانِسَ كَاللَآلي في اللَآلي",16,"ي",1,0],["إِذا اِجتَمَعَت أَيديهُمُ في مُلِمَّةٍ","فَأَهوِن بِما تُطوى عَلَيهِ القَبائِلُ",17,"ل",1,0],["إِذا اِجتَمَعا في راحَتَيكَ كِلاهُما","دُوَينَ كُبَيداتِ السَماءِ غَوارِبُه",18,"ب",2,0],["إِذا اِجتَمَعَ الحَيّانِ قَيسٌ وَخِندِفٌ","فَثَمَّ مَعَدٌّ هامُها وَعَديدُها",19,"د",3,0],["إِذا اِجتَمَعَت عَصايِبُ كُلَّ حَيٍّ","مِنَ الآفاقِ مُختَلِفي النُجورِ",20,"ر",1,0],["إِذا اِجتَمَعَ الآفاقُ مِن كُلِّ جانِبٍ","إِلى مَنسِكٍ كانَت إِلَيها أُمورُها",21,"ر",3,0],["إِذا اِجتَمَعَ الأَقوامُ أُيِّهَ بِاِسمِهِ","أَمامَ النَواصي عِندَ بابِ السُرادِقِ",22,"ق",1,0],["إِذا اِجتَمَعا في حَوضِهِ فاضَ مِنهُما","عَلى الناسِ فَيضٌ يَعلُوانِ الرَوابِيا",23,"ي",2,0],["إِذا اِجتَمَعَ الآفاتُ فَالبُخلُ شَرّها","وَشَرٌّ مِنَ البُخلِ المَواعيدِ وَالمَطلُ",24,"ل",1,1],["إِذا اِجتَمَعَت عَليا مَعَدٍّ وَمُذحَجٍ","بِمَعرَكَةٍ كُبرى فَإِنّي أَميرُها",25,"ر",3,1],["إِذا اِجتَهَدتُ نَظَراً","في إِثرِهِ قُلتُ سَنا",26,"ا",1,0],["إِذا أَجرَموا قَنّا القَنا مِن دِمائِهِم","وَإِن لَم يَجِد جُرماً عَلَيهِم تَجَرَّما",27,"م",2,0],["إِذا اِجتَمَعنا هَجَرنا كُلَّ فاحِشَةٍ","عِندَ اللِقاءِ وَذاكُم مَجلِسٌ حَسَنُ",28,"ن",1,0],["إِذا اِجتابَها الخِرّيتُ قالَ لِنَفسِهِ","أَتاكَ بِرِجلَي حائِنٍ كُلُّ حائِنِ",29,"ن",1,0],["إِذا أَجحَفَت بِالناسِ شَهباءُ صَعبَةٌ","لَها حَرجَفٌ مِمّا يَقِلُّ بِهِ القُتُر",30,"ر",1,0],["إِذا أَجحَرَ الكَلبَ الصَقيعَ اِتَّقَينَهُ","بِأَثباجِ لا خورٍ وَلا قَفِراتِ",31,"ت",1,0],["إِذا أَجرى أَمينُ اللَ","هِ في الحَلبَةِ أَفراسا",32,"س",2,1],["إِذا اِجتَمَعَ اِثنانِ في مَنزِلٍ","عَلى خَربَةٍ فُضِحا لِلأَبَد",33,"د",1,1],["إذا أَجَأٌ وافى يجدد عهده","بنا أم تراها زورةً من مواسل",34,"ل",1,0],["إِذا اجْتازَ عُلْوِيُّ الرِّياحِ بأُفْقِهِ","أَجَدَّ لعِرْفانِ الصّبا يَتَنَفَّسُ",35,"س",1,1],["إِذا أجْرى يَرَاعَتَهُ أَسَالَتْ","مُهَارِقُهَا مَجَاجاً مِنْ ضياءِ",36,"ا",2,0],["إذا اجتمعَ القَلْبانِ فَالْكَوْنُ كُلُّهُ","مَانٌ وإِنْ شَقَّتْ وطالَتْ مَعَايره",37,"ر",2,0],["إذا أجحفتْ بالنّاس شهباء صعبة","ٌ لها حَرْجَفٌ ممّا يَقِلُّ بها القُتُرْ",38,"ر",1,0],["إذا اجتسهُ مفتاحهُ أخطأ الشَّبا","نَفى الأُسْدَ عَنْ أوْطانِهِ فَتُهُيّبَا",39,"ب",2,0],["إِذا اِجتَمَعَت يَوماً قُرَيشٌ لِمَفخَرٍ","فَعَبدُ مَنافٍ سِرُّها وَصَميمُها",40,"م",3,1],["إِذا اِجتابَ ثَوباً مِن عُلىً وَمَهابَةٍ","لَبِستَ مِنَ الفَحشاءِ وَالخِزيِ أَثوابا",41,"ب",2,0],["إِذا اِجتَهَدتَ نَظَراً في إِثرِهِ","قُلتَ سَناً أَومَضَ أَو بَرقٌ خَفا",42,"ا",1,0],["إِذا أَجشَمَت جَيّاشَةً مُصمَئِلَّةً","قَفَت إِثرَها دَهياءُ صَمّاءُ صَيلَمُ",43,"م",1,0],["إِذا اِجتَمَعَتْ أَهلُ المَعاني فَإِنَّما","لَهُ الرُّتبةُ الأُولى لَدى كُلِّ مُنتَدى",44,"د",2,0],["إذا أجدبت أرض فدعها لأهلها","ففي كل أرض للمحوّل دار",45,"ر",1,0],["إذا اجتهد المنجّمُ بعد علم","بحلّ الزيج وهو له مريد",46,"د",1,1],["إذا اجتمع السمار فيها رأيتهم","ملائك توصى بالوثيق من العقد",47,"د",1,0],["إِذا اِجتَمَعَت في مَجلِسِ الشُربِ سَبعَةٌ","فَما الرَأيُ في تَأخيرِ هِنَّ صَوابُ",48,"ب",1,1],["إِذا اِجترّتِ البارودَ غصّاً وكرّرت","عَلى أكر دهمٍ به القذفَ والسّرطا",49,"ط",2,0],["إذا اِجتلى من خدركم بكر منّةٍ","أغالي بمهر الشكرِ في سَومها خطبا",50,"ب",2,0],["إِذا أَجفَلَت جالَت كَأَنَّ مُتونَها","سُيوفٌ جَرى فيها مِنَ العِتقِ رَونَقُ",51,"ق",1,0],["إِذا اِجتَهَدا التَرويحِ مَدّا عَجاجَةً","أَعاصيرَ مِمّا يَستَثيرُ خُطاهُما",52,"م",2,0],["إذا اجْتمَعتْ نَفْسي وعَينُكِ والصَّبا","تَنازعتِ الشّكْوى ثَلاثُ علائل",53,"ل",1,0],["إذا اجتمعَتْ يوماً به ادَّخَرتْ سناً","إلى العودة الأُخْرَى بذاكَ تُنير",54,"ر",1,0],["إذا اجتَمعَت في المُلكِ كلُّ عَظيمةٍ","فأنهضُ من تُلقَى عَليه عَظائِمُه",55,"م",2,0],["إذا اجتمعت في المرء والمرء جاهلٌ","فكيف ترى من خمر آلامها يصحو",56,"ح",2,0],["إِذا اِجتَرَأَت عَلى اسد نعاج","وَنامَ لَها فَقَد حاكى النِعاجا",57,"ج",2,0],["إذا اجتمعتم على نصر الإِمام فما","يقوى عليكم من الأحياء إنسان",58,"ن",1,0],["إذا أجْفَلَتْ في البيدِ جُفْلَ نَعامِها","كأنَّ أفاعي الرّمْلِ ثِنْيُ زِمامِها",59,"ه",2,0],["إِذَا أَجْرَتِ الأَقلامُ عَنْهُمْ بِمَنْطِقٍ","أَرَتْكَ بُطُونَ الصُّحْفِ وَهْيَ أَزَاهِرُ",60,"ر",1,0],["إذا اجرى لها التأري","خ ذكرا قال قد اخنى",61,"ا",1,0],["إذا أجدبوا خصَّهم جدبهم","وإن أخصبوا كان خِصباً مَريعا",62,"ع",2,0],["إذا أجدبوا خصَّهم جدبُهم","وإن أخصبوا كان خِصباً جِماعا",63,"ع",2,0],["إذا أجدبتْ أرضي وسُدَّتْ مَواردي","فعندكُمُ لي روضةٌ وقليبُ",64,"ب",1,0],["إذا أجتهدتُ لم يَعبْني فعلُهُ","ما لم يَجِبْ وما قَضَيتُ ما وَجَبْ",65,"ب",1,0],["إذا أجلبت ضوضاء خطبٍ بسمعه","رأيت شروْري والنسيم إذا جرى",66,"ر",2,0],["اذا اجتمع البحرانُ خُبْرٌ وخضرم","غَدا بهما اِفْضالهُ وفَضائلُهْ",67,"ل",2,0],["إذا اجتنى ثمرَ الهامات مال بها","كما تمايل تحت البارح الغصن",68,"ن",1,0],["إِذا اِجتَمَعنا بِقُربِهِ أَمِنَت","نُفوسُنا مِن أَذِيَّةِ الكَمَدِ",69,"د",1,0],["إِذا اجتَهَدتُ ليُحصي مَجدَهُم مدحي","لَم أعشُر المَجدَ مِنهُم حينَ أجتَهِدُ",70,"د",1,0],["إذا أجشع الأقوام أع","جلها وأقذرها ردا",71,"د",2,0],["إذَا اجتَمَعُوا عَلَيَّ فَخَلِّ عَنهُم","وَعَن بَازٍ مَخَالِبُهُ دَوَامِي",72,"ي",1,0],["إذَا اجْتَمَعَ الصَّدِيقُ مَعْ صَدِيقٍ","فَذَاكَ هو الْمُدَامَةُ والنّديمُ",73,"م",1,0],["إذا أَجَبْتَ دُعائي","فَضْلاً فَظَنِّي جَمِيلُ",74,"ل",1,1],["إذا أجَبْتَ دُعائي","فَأَنْتَ لِلفَضْلِ أَهْلُ",75,"ل",1,1],["إذا اجتمعْنا فإنَّ البينَ غايتُنا","كالقَوسِ تَجمَعُ بينَ السَّهْمِ والوَتَرِ",76,"ر",1,0],["إِذا أَجْدبتْ آراؤهم من سُعودِها","فمِنه ومِنْ آرائِه ينْبُتُ السَّعْدُ",77,"د",1,0]]}