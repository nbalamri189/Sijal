06","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93599","الوافر"],[2615,"","https://poetry.dctabudhabi.ae/diwan/poem/124292","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87338","الطويل"],[2653,"","https://poetry.dctabudhabi.ae/diwan/poem/45350","الوافر"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58330","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201765","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205044","الوافر"],[2973,"","https://poetry.dctabudhabi.ae/diwan/poem/107026","المتقارب"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132612","الرجز"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104348","المتقارب"],[3497,"","https://poetry.dctabudhabi.ae/diwan/poem/204010","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205735","البسيط"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85240","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133267","الوافر"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17788","الطويل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119473","الطويل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136946",""],[4205,"","https://poetry.dctabudhabi.ae/diwan/poem/22096","البسيط"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45024","الوافر"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72738","الوافر"],[4717,"مرثية الدكتور أحمد زويل","https://www.poetsgate.com/ViewPoem.aspx?id=199624",""],[1901,"أما في الناس من رجلِ رشيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=160409",""],[5376,"من مبلغ الريم عن لهفي لما كانا","https://www.poetsgate.com/ViewPoem.aspx?id=188559",""],[5431,"من شعر الحكمة ...","https://www.poetsgate.com/ViewPoem.aspx?id=211087",""],[5953,"أرى ألف الحروف هي الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=93806",""],[186,"رعى الله مغنى بالعذيب ومعهدا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55751&r=&rc=14",""],[6189,"السابحون في منطقة انعدام الوزن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83549&r=&rc=16",""],[463,"نرقُّ وتقسو بالغوير قلوبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59978&r=&rc=34",""]],"verses":[["إِذا أَجَّ بِالإيماضِ قُلتَ اِبنُ كُفَّةٍ","يُضَرِّمُ بِالغابِ الأَباءَ المُسَعَّرا",0,"ر",2,0],["إِذا اِجتازَ رَكبٌ كانَ أَجوَدَ عِندَها","بِعَقرِ المَطايا مِن سُحَيمٍ وَغالِبِ",1,"ب",1,0],["إِذَا اجْتَمَعَ الإِقْدَامُ وَالرَّأيُ وَالتُّقَى","وَسَاعَدَ سَعْدٌ وَاسْتَقَلَّ بِهِ عَزْمُ",2,"م",1,0],["إِذا اِجتَلَدوا بِمُعتَرَكٍ قِياماً","عَلى الشُعثِ العَوابِسِ أَو نِزالا",3,"ل",2,0],["إِذا أَجدَبَت أَرضُ اِمرِئِ القَيسِ أَمسَكَت","قُراها وَكانَت عادَةً تَستَعيدُها",4,"د",3,0],["إِذا اِجتَمَعوا عَلَيَّ فَخَلِّ عَنهُم","وَعَن بازٍ يَصُكُّ حُبارَياتِ",5,"ت",1,0],["إِذا اِجتَمَعوا عَلى سَكَرٍ بِفَلسٍ","فَنَصوٌ عِندَ ذَلِكَ وَاِلتِطامُ",6,"م",1,0],["إِذا اِجتَمَعَت وَأَحوَذَ جانِبَيها","وَأَورَدَها عَلى عوجٍ طِوالِ",7,"ل",1,0],["إذا اجْتليت في العطا جبينهُ","أو اسْتشرت للرجا يمينه",8,"ه",1,0],["إذا أجاد فأوجِبْ قطع مقوله","فقد دهى شعراء الناس بالحَرَبِ",9,"ب",1,0],["إذا أجادَ الذي يُشبِّهُهُ","وأحكَم الوصفَ فيه بالنَّعْتِ",10,"ت",1,1],["إذا اجْتَازَ بَحْراً كَادَ يُنْزَحُ مَاؤُهُ","وإنْ ضَافَ بَرّاً كَادَتِ الأرْضُ تُجرَدُ",11,"د",1,0],["إذا أجابتْ شنطفٌ طَبْلَها","ناحَ عليه نوحَ مَعْنيَّهْ",12,"ي",2,0],["اذا اجتمع الصدور به تنحوا","كما نزلت عن الطغرى السطور",13,"ر",1,0],["إِذا اِجتَمَعَ الكُلُّ في بُقعَةٍ","حَسِبتَهُمو باقَةً تُزهِرُ",14,"ر",1,0],["إِذا اِجتَمَعنا عَلى يَومِ الشِتاءِ فَلي","هَمٌّ بِما أَنا لاقٍ حينَ أَنصَرِفُ",15,"ف",1,0],["إِذا اِجتَبنَ الحُلِيَّ رَأَيتَ بيضاً","أَوانِسَ كَاللَآلي في اللَآلي",16,"ل",2,0],["إِذا اِجتَمَعَت أَيديهُمُ في مُلِمَّةٍ","فَأَهوِن بِما تُطوى عَلَيهِ القَبائِلُ",17,"ل",1,0],["إِذا اِجتَمَعا في راحَتَيكَ كِلاهُما","دُوَينَ كُبَيداتِ السَماءِ غَوارِبُه",18,"ب",2,0],["إِذا اِجتَمَعَ الحَيّانِ قَيسٌ وَخِندِفٌ","فَثَمَّ مَعَدٌّ هامُها وَعَديدُها",19,"د",3,0],["إِذا اِجتَمَعَت عَصايِبُ كُلَّ حَيٍّ","مِنَ الآفاقِ مُختَلِفي النُجورِ",20,"ر",1,0],["إِذا اِجتَمَعَ الآفاقُ مِن كُلِّ جانِبٍ","إِلى مَنسِكٍ كانَت إِلَيها أُمورُها",21,"ر",3,0],["إِذا اِجتَمَعَ الأَقوامُ أُيِّهَ بِاِسمِهِ","أَمامَ النَواصي عِندَ بابِ السُرادِقِ",22,"ق",1,0],["إِذا اِجتَمَعا في حَوضِهِ فاضَ مِنهُما","عَلى الناسِ فَيضٌ يَعلُوانِ الرَوابِيا",23,"ي",2,0],["إِذا اِجتَمَعَ الآفاتُ فَالبُخلُ شَرّها","وَشَرٌّ مِنَ البُخلِ المَواعيدِ وَالمَطلُ",24,"ل",1,1],["إِذا اِجتَمَعَت عَليا مَعَدٍّ وَمُذحَجٍ","بِمَعرَكَةٍ كُبرى فَإِنّي أَميرُها",25,"ر",3,1],["إِذا اِجتَهَدتُ نَظَراً","في إِثرِهِ قُلتُ سَنا",26,"ا",1,0],["إِذا أَجرَموا قَنّا القَنا مِن دِمائِهِم","وَإِن لَم يَجِد جُرماً عَلَيهِم تَجَرَّما",27,"م",2,0],["إِذا اِجتَمَعنا هَجَرنا كُلَّ فاحِشَةٍ","عِندَ اللِقاءِ وَذاكُم مَجلِسٌ حَسَنُ",28,"ن",1,0],["إِذا اِجتابَها الخِرّيتُ قالَ لِنَفسِهِ","أَتاكَ بِرِجلَي حائِنٍ كُلُّ حائِنِ",29,"ن",1,0],["إِذا أَجحَفَت بِالناسِ شَهباءُ صَعبَةٌ","لَها حَرجَفٌ مِمّا يَقِلُّ بِهِ القُتُر",30,"ر",1,0],["إِذا أَجحَرَ الكَلبَ الصَقيعَ اِتَّقَينَهُ","بِأَثباجِ لا خورٍ وَلا قَفِراتِ",31,"ت",1,0],["إِذا أَجرى أَمينُ اللَ","هِ في الحَلبَةِ أَفراسا",32,"س",2,1],["إِذا اِجتَمَعَ اِثنانِ في مَنزِلٍ","عَلى خَربَةٍ فُضِحا لِلأَبَد",33,"د",1,1],["إذا أَجَأٌ وافى يجدد عهده","بنا أم تراها زورةً من مواسل",34,"ل",1,0],["إِذا اجْتازَ عُلْوِيُّ الرِّياحِ بأُفْقِهِ","أَجَدَّ لعِرْفانِ الصّبا يَتَنَفَّسُ",35,"س",1,1],["إِذا أجْرى يَرَاعَتَهُ أَسَالَتْ","مُهَارِقُهَا مَجَاجاً مِنْ ضياءِ",36,"ا",2,0],["إذا اجتمعَ القَلْبانِ فَالْكَوْنُ كُلُّهُ","مَانٌ وإِنْ شَقَّتْ وطالَتْ مَعَايره",37,"ر",2,0],["إذا أجفلت وطفاء حنت حنينها","على قنن الأوعار وطف روازم",38,"م",1,0],["إذا أجحفتْ بالنّاس شهباء صعبة","ٌ لها حَرْجَفٌ ممّا يَقِلُّ بها القُتُرْ",39,"ر",1,0],["إذا اجتسهُ مفتاحهُ أخطأ الشَّبا","نَفى الأُسْدَ عَنْ أوْطانِهِ فَتُهُيّبَا",40,"ب",2,0],["إِذا اِجتَمَعَت يَوماً قُرَيشٌ لِمَفخَرٍ","فَعَبدُ مَنافٍ سِرُّها وَصَميمُها",41,"م",3,1],["إِذا اِجتابَ ثَوباً مِن عُلىً وَمَهابَةٍ","لَبِستَ مِنَ الفَحشاءِ وَالخِزيِ أَثوابا",42,"ب",2,0],["إِذا اِجتَهَدتَ نَظَراً في إِثرِهِ","قُلتَ سَناً أَومَضَ أَو بَرقٌ خَفا",43,"ا",1,0],["إِذا أَجشَمَت جَيّاشَةً مُصمَئِلَّةً","قَفَت إِثرَها دَهياءُ صَمّاءُ صَيلَمُ",44,"م",1,0],["إِذا اِجتَمَعَتْ أَهلُ المَعاني فَإِنَّما","لَهُ الرُّتبةُ الأُولى لَدى كُلِّ مُنتَدى",45,"د",2,0],["إذا أجدبت أرض فدعها لأهلها","ففي كل أرض للمحوّل دار",46,"ر",1,0],["إذا اجتهد المنجّمُ بعد علم","بحلّ الزيج وهو له مريد",47,"د",1,1],["إذا اجتمع السمار فيها رأيتهم","ملائك توصى بالوثيق من العقد",48,"د",1,0],["إِذا اِجتَمَعَت في مَجلِسِ الشُربِ سَبعَةٌ","فَما الرَأيُ في تَأخيرِ هِنَّ صَوابُ",49,"ب",1,1],["إِذا اِجترّتِ البارودَ غصّاً وكرّرت","عَلى أكر دهمٍ به القذفَ والسّرطا",50,"ط",2,0],["إذا اِجتلى من خدركم بكر منّةٍ","أغالي بمهر الشكرِ في سَومها خطبا",51,"ب",2,0],["إِذا أَجفَلَت جالَت كَأَنَّ مُتونَها","سُيوفٌ جَرى فيها مِنَ العِتقِ رَونَقُ",52,"ق",1,0],["إِذا اِجتَهَدا التَرويحِ مَدّا عَجاجَةً","أَعاصيرَ مِمّا يَستَثيرُ خُطاهُما",53,"م",2,0],["إذا اجْتمَعتْ نَفْسي وعَينُكِ والصَّبا","تَنازعتِ الشّكْوى ثَلاثُ علائل",54,"ل",1,0],["إذا اجتمعَتْ يوماً به ادَّخَرتْ سناً","إلى العودة الأُخْرَى بذاكَ تُنير",55,"ر",1,0],["إذا اجتَمعَت في المُلكِ كلُّ عَظيمةٍ","فأنهضُ من تُلقَى عَليه عَظائِمُه",56,"م",2,0],["إذا اجتمعت في المرء والمرء جاهلٌ","فكيف ترى من خمر آلامها يصحو",57,"ح",2,0],["إِذا اِجتَرَأَت عَلى اسد نعاج","وَنامَ لَها فَقَد حاكى النِعاجا",58,"ج",2,0],["إذا اجتمعتم على نصر الإِمام فما","يقوى عليكم من الأحياء إنسان",59,"ن",1,0],["إذا أجْفَلَتْ في البيدِ جُفْلَ نَعامِها","كأنَّ أفاعي الرّمْلِ ثِنْيُ زِمامِها",60,"ه",2,0],["إِذَا أَجْرَتِ الأَقلامُ عَنْهُمْ بِمَنْطِقٍ","أَرَتْكَ بُطُونَ الصُّحْفِ وَهْيَ أَزَاهِرُ",61,"ر",1,0],["إذا اجرى لها التأري","خ ذكرا قال قد اخنى",62,"ا",1,0],["إذا أجدبوا خصَّهم جدبهم","وإن أخصبوا كان خِصباً مَريعا",63,"ع",2,0],["إذا أجدبوا خصَّهم جدبُهم","وإن أخصبوا كان خِصباً جِماعا",64,"ع",2,0],["إذا أجدبتْ أرضي وسُدَّتْ مَواردي","فعندكُمُ لي روضةٌ وقليبُ",65,"ب",1,0],["إذا أجتهدتُ لم يَعبْني فعلُهُ","ما لم يَجِبْ وما قَضَيتُ ما وَجَبْ",66,"ب",1,0],["إذا أجلبت ضوضاء خطبٍ بسمعه","رأيت شروْري والنسيم إذا جرى",67,"ر",2,0],["اذا اجتمع البحرانُ خُبْرٌ وخضرم","غَدا بهما اِفْضالهُ وفَضائلُهْ",68,"ل",2,0],["إذا اجتنى ثمرَ الهامات مال بها","كما تمايل تحت البارح الغصن",69,"ن",1,0],["إِذا اِجتَمَعنا بِقُربِهِ أَمِنَت","نُفوسُنا مِن أَذِيَّةِ الكَمَدِ",70,"د",1,0],["إِذا اجتَهَدتُ ليُحصي مَجدَهُم مدحي","لَم أعشُر المَجدَ مِنهُم حينَ أجتَهِدُ",71,"د",1,0],["إذا أجشع الأقوام أع","جلها وأقذرها ردا",72,"د",2,0],["إذَا اجتَمَعُوا عَلَيَّ فَخَلِّ عَنهُم","وَعَن بَازٍ مَخَالِبُهُ دَوَامِي",73,"م",2,0],["إذَا اجْتَمَعَ الصَّدِيقُ مَعْ صَدِيقٍ","فَذَاكَ هو الْمُدَامَةُ والنّديمُ",74,"م",1,0],["إذا أَجَبْتَ دُعائي","فَضْلاً فَظَنِّي جَمِيلُ",75,"ل",1,1],["إذا أجَبْتَ دُعائي","فَأَنْتَ لِلفَضْلِ أَهْلُ",76,"ل",1,1],["إذا اجتمعْنا فإنَّ البينَ غايتُنا","كالقَوسِ تَجمَعُ بينَ السَّهْمِ والوَتَرِ",77,"ر",1,0],["إِذا أَجْدبتْ آراؤهم من سُعودِها","فمِنه ومِنْ آرائِه ينْبُتُ السَّعْدُ",78,"د",1,0],["إذا اجتمعا نوعين قلتُ شقيقةٌ","أُضيف إليها نرجسٌ فتألفا",79,"ف",2,0],["إذا أجدبت أرض دعتك فعمها","سحاب ندى عن مثله تتقشع",80,"ع",1,0],["إذا أجمعتْ يوماً لقاءَ كتيبةٍ","تشتَّتُ من قبلِ اللقاءِ جموعها",81,"ع",3,0],["إذا اجتمعت لي في حياتيَ كلِّها","فلله ما أعلى حياتي وأنفَسَا",82,"س",2,0],["إذا أجراه فوق الطرس يوما","جرى قمنا بأَرزاق العبادِ",83,"د",1,0],["إِذَا اجْتَلَى رَأْسَ هِلالٍ مَحَقا","فَسَبَحَ الدَهْرُ بِهِ وَعَفَقا",84,"ق",2,0],["إذا أجْرَسَ الحليُ استُطيرَ وقلّما","مشى فيه إلا ريث يختال للزهر",85,"ر",1,0],["إذا أجلبوا فيها حسبت جنادباً","تجاوبن إيقاعاً على صوت نقنق",86,"ق",1,0],["إذا أجدبت أحساب قوم سمابنا","على الناس جياش الغوارب مرتج",87,"ج",1,0],["إِذا اِجتَمَعَ الآفاتُ فَالبُخلُ شَرُّها","وَشَرٌّ مِنَ البُخلِ المَواعِدُ وَالمَطلُ",88,"ل",1,1],["إِذا أَجاروا عَوى في بَيتِ جارِهِمُ","إِمّا حِرابٌ وَإِمّا مِثلَهُ قُتِلوا",89,"ل",3,0],["إِذا إِجتَمَعا قالَ القَديمُ غَلَبتُهُ","وَقالَ الَّذي مِن بَعدِهِ أَنا غالِبُه",90,"ب",2,0],["إذا أجل الظهار مضى فقالت","حليلته هنالك زوجني",91,"ن",2,0],["إذا أجرى الخطاب رأيت بحراً","وإن جرت الخطوب رأيت قرنا",92,"ن",2,0],["إذا اجنَّهمُ 