ctabudhabi.ae/diwan/poem/178149","المتقارب"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133063","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58179","الرجز"],[4499,"","https://poetry.dctabudhabi.ae/diwan/poem/122173","الوافر"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33658","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139524",""],[4762,"لماذا","https://www.poetsgate.com/ViewPoem.aspx?id=215337",""],[4767,"النهج الأصيل","https://www.poetsgate.com/ViewPoem.aspx?id=179919",""],[4926,"تحيّات إجلال عن الحصر جلَّت","https://www.poetsgate.com/ViewPoem.aspx?id=171107",""],[4984,"مرَّ قطار صحبك","https://www.poetsgate.com/ViewPoem.aspx?id=175538",""],[4984,"الْعِبْرَةُ","https://www.poetsgate.com/ViewPoem.aspx?id=206419",""],[5005,"حب زائف","https://www.poetsgate.com/ViewPoem.aspx?id=197386",""],[585,"سل الأرض كم خاضت قديم المآزق","https://www.poetsgate.com/ViewPoem.aspx?id=161964",""],[585,"أنرسف بالسلاسل والقيود","https://www.poetsgate.com/ViewPoem.aspx?id=161852",""],[5156,"ألا أيها الدهر الذي قد مللته","https://www.poetsgate.com/ViewPoem.aspx?id=99124",""],[5186,"قلب الدهر اختيارا","https://www.poetsgate.com/ViewPoem.aspx?id=156521",""],[5189,"ويغفر للجناةِ التائبينا","https://www.poetsgate.com/ViewPoem.aspx?id=216020",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"شكت فجشت مذ أعلنت بجشاها","https://www.poetsgate.com/ViewPoem.aspx?id=128712",""],[5362,"خلقت من الحديد أشد قلبا","https://www.poetsgate.com/ViewPoem.aspx?id=170342",""],[5431,"للدعابة ..كمجنون يفرّ من المصحة !","https://www.poetsgate.com/ViewPoem.aspx?id=202218",""],[5458,"كلاب مسعورة","https://www.poetsgate.com/ViewPoem.aspx?id=113373",""],[5703,"لن أنساه","https://www.poetsgate.com/ViewPoem.aspx?id=215194",""],[5829,"دعونا وشأننا","https://www.poetsgate.com/ViewPoem.aspx?id=178059",""],[6093,"تركة شيب","https://www.poetsgate.com/ViewPoem.aspx?id=206166",""],[6093,"تأملات في الكون","https://www.poetsgate.com/ViewPoem.aspx?id=215207",""],[6102,"خامِس الفُصُول !!","https://www.poetsgate.com/ViewPoem.aspx?id=183982",""],[6259,"وليَّ ولم يقض من أحبابه وطرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59376&r=&rc=24",""]],"verses":[["فَقَد وَعَدتك لَو أَقَبلتَ وُدًّا","فَلَجَّ بِكَ التَّدَلُّلُ في تعادِ",0,"د",1,0],["فَقَد وَدَّعتُ يَومَ فِراقِ صَخرٍ","أَبي حَسّانَ لَذّاتي وَأُنسي",1,"س",2,0],["فقد وعادوا ذا الصالحين","بشار أحلي من الضرب",2,"ب",1,0],["فَقَد وَجَدوا الخَليفَةَ هِبرِزِيّاً","أَلَفَّ العيصِ لَيسَ مِنَ النَواحي",3,"ح",2,0],["فَقَد وَلَدنا ماجِداً حَميدا","أَغَرَّ تُهراقُ يَداهُ جودا",4,"د",2,0],["فَقَدوا الأَبَ الحاني فكنتُ لضُعْفِ","هِمْ كهفاً يَصُدُّ غَوائلَ الأَيَّامِ",5,"م",1,0],["فقد وجدَ الواشون سوقاً ونفَّقُوا","بضائعَ زورٍ ما لهنَّ دوامُ",6,"م",1,0],["فقد وقى عرضَه بالبيدِ واعترضتْ","طولا على منكِبِ الشِّعرى مناكبُه",7,"ب",2,0],["فَقَد وَشّى الرَبيعُ لَنا رُبوعاً","فَوَشَّعَها كَتَوشيعِ الرِداءِ",8,"ا",2,0],["فَقَد وَحَياةِ الحُبِّ حُلتُم وَما حُلنا","فَلَستُ بِسالٍ جُرتُمُ أَو عَدَلتُمُ",9,"م",1,0],["فقدوا حجاهم حينما طربوا","ودووا دويّ البحر صخّابا",10,"ب",2,0],["فَقَد وَفَّيتُها سِتّينَ حَولاً","وَنادَتني وَرائي هَل أَمامُ",11,"م",1,0],["فقدُوا البأسَ فدبُّوا خِفيةً","وَانْتَضَوها أنفُساً لا تُفْقَدُ",12,"د",1,0],["فَقُدورُهُ بِفِنائِهِ","لِلضيفِ مُترَعَةٌ زَواخِر",13,"ر",1,0],["فَقَد وَعَدتِ مَواعي","دَ كَالسَرابِ بِبيدِ",14,"د",1,0],["فقد وحياةِ مَن أهوى وتهوى","أقامَ قيامتي شهرُ الصيام",15,"م",1,0],["فَقَد وَفَت وَلَها في وَفقِها عَلَمٌ","مِثلُ السَحابَةِ في أَقرابِها زَبَدُ",16,"د",1,0],["فَقَد وَقَّفَني الهَجرُ","مِنَ المَوتِ عَلى جَنبِ",17,"ب",1,0],["فَقَد وَجَبَت عَلَيكَ صَلاةُ ظُهرٍ","إِذا وافاكَ بِالماءِ السَقاءُ",18,"ق",3,0],["فقد وقفت حَياتي","لهم وأَفنيت عمري",19,"ر",2,0],["فقد وجدت ببغدا","د طعم عيشيَ مرا",20,"ر",2,0],["فَقَد وجدت نظاماً","وَما وجدت نظاما",21,"م",2,0],["فَقَدْ وَلَّى الصِّبَا إِلَّا قَلِيلاً","أُنَازِعُ سُؤْرَهُ بِفُضُولِ كَأْسِي",22,"س",2,0],["فقد وعَظَتْكُمُ سُودُ الليالي","ولم تعرفْ بما تعِظ الخِداعا",23,"ع",2,0],["فَقَد وَافَيتَ مِن بَلَدٍ بَعِيدٍ","تَقُودُ بِكَ الحَمَاقَةُ أو تَسُوقُ",24,"ق",1,0],["فَقَد وَرِثتَ مَعالِى","مختارِنَا في الأَنَاةِ",25,"ه",1,0],["فقد وهبَ الثأرَ ذاك الحريصُ","ونام على الحقدِ ذاك الطلوبُ",26,"ب",1,0],["فَقَد وَدَّ المُلوكُ عَلى التَنائي","لَوِ اِسطاعوا لِراحَتِهِ التِثاما",27,"م",2,0],["فقد وثقت بأنَّ الفت","ح في الأعداء منتظر",28,"ر",1,0],["فَقَد وَهَبَ الأَعلاقَ واصطَلمَ العِدى","وَفي كُلِّ خَيرٍ جُملَةً بَلَغَ المَدى",29,"د",2,0],["فقدوكَ لما غبتَ عن أَبصارهم","والمحسنون متى يغيبوا يُفقدوا",30,"د",3,0],["فقد وضعت غلب الرقاب رؤسها","وأبعد عنه التيه ذو التيه والكبرا",31,"ر",2,0],["فَقَدوا بِهِ ذُخراً لِكُلِّ مُهَمَةٍ","يُرجى وَسَيفاً في النَوائبِ مُنتَضى",32,"ض",2,0],["فَقَدوا بِهِ رُكناً عَزيزاً طالَما","أَنشَا لَهُم حَسَباً عَزيزَ المَغنَمِ",33,"م",1,0],["فقد وَدِدنا أنَّ أعمارنا","فيها صَبوحٌ دائم أو غَبوق",34,"ق",1,0],["فَقَد وَرِثوا الكذّابَ إِذ كان يدّعي","بأنَّ لهُ شَطراً وللمُصطفى شطرا",35,"ر",2,0],["فقدوا بعدَك القلوبَ اللّواتي","شَقًّها واجبٌ فشقّوا الجيوبا",36,"ب",2,0],["فَقَد وافاكَ مِن بَلَدٍ بَعيدٍ","وَقَد أَنضى الرَواحِلَ وَالرِكابا",37,"ب",2,0],["فَقَدْ وَصَلْتُ وصُلْتُ مِمَّا","بَرَيْتُمُ أسْهُمي وَرِشْتُمْ",38,"م",1,0],["فقد وهيت حتى توهمت انها","لرقتها اجفانها وخصورها",39,"ر",3,0],["فقد وافيت بحرك وَهو طام","وَغيري غره لمع السراب",40,"ب",1,0],["فقد وقفت بباب الجود معتذرا","وَالعَفو متسع وَالعذر أَبيات",41,"ت",1,0],["فقد وهبت لغزلان العذيب دمي","وَلَم أطالب عيون العين بالثار",42,"ر",1,0],["فقد وثِقت نفسي بوعدك سيدي","وقد علّقت منه الأذمة والعهدا",43,"د",2,0],["فقدَّوا قميص البدر بالبرق واجتلوا","أهلتها من بعد ما فقدوها",44,"و",3,0],["فَقَد وافاكَ ما أَبهى غُلام","سَيَبدو مِنهُ عَن أَصلٍ حَليمُ",45,"م",1,0],["فَقُدورِي تَنزَّلتْ بَعدَ ما كُنْ","تَ لها أَنتَ رافِعاً أَقْدارا",46,"ر",2,0],["فقد وجَبَ الذِّمامُ به قَديماً","وشَبَّ له الوغَى يَومَ النِّزال",47,"ل",1,0],["فقد وجدوك بحر ندى وعلم","يفيض جداً ومعروفاً وسيعا",48,"ع",2,0],["فَقَد وصلت بآمالي إِلى مَلِكٍ","تَعنو المُلوك لَهُ فَضلاً عَن الأَمرا",49,"ر",2,0],["فقد وجدت بغداد والناس راحةً","وقد أَتْعَبَتْها قبل ذاكَ المتاعبُ",50,"ب",1,0],["فقد وثقت بكم نثراً وقافية","فاستمطروها فسح الودق بالبرد",51,"د",1,0],["فقد ولدتْ نفسا كنفسي كرامةً","عليّ وإن حدَّتْ بجسمٍ سوى جسمي",52,"م",2,0],["فقد وثِقتُ آخراً","بما رُزِقتُ أوّلا",53,"ل",2,0],["فقد وثقت من عادة الضَّرْب بالغنى","إذا عَمَدَتْ للنَّاكثين جَحافِلُهْ",54,"ل",2,0],["فقدودٌ في نشوة وجفونٌ","في فتور وأوجهٌ في احمرار",55,"ر",1,0],["فقدْ وُشِّحتْ فيكُمْ قَديماً خِصَالُهُ","وقدْ رُصِّعَتْ بالطَّورِ منكُمْ خِلالُهُ",56,"ل",2,0],["فقد والذي عافاك مما أبتلي به","تندم لو أرضاك أن يتندما",57,"م",2,0],["فقد وهواك زادني اشتياقاً","على شوقي نواك وأنت قالي",58,"ل",2,0],["فقد والذي لو شاء غلب واحداً","فروح قلباً آمناً متهيبا",59,"ب",2,0],["فقد والذي لو شاء لم يخلق النوى","عرضت فما أدري إلى أين أذهب",60,"ب",1,0],["فقدوا عظيماً همة وعزيمة","عشق الوفاء وأبغض التسويفا",61,"ف",2,0],["فقد ولّت بَشاشتُه وأودى","فقم يا صاحِ نَبكِ على الشبابِ",62,"ب",1,0],["فَقَد وَلّوا أَبا بَكرٍ جَميعا","أُمورَهُمُ هَزيلاً أَو سَمينا",63,"ن",2,0],["فقد وعد الحسنى جزاءً محققاً","لمن كان في الدنيا له أحسن القرضا",64,"ض",2,0],["فقدوا شجاعتهم أما","م الموت وهو أعز غالبْ",65,"ب",1,0],["فقد، وربّ الرّكن","أوهى لي مشيي ركني",66,"ن",2,0],["فقد وقوا شر ما أتقوا","وصار عقابهم السرور",67,"ر",1,0],["فقد وجفت أكبادهم حين لفّهم","خضم من الديجور جاشت غواربه",68,"ب",2,0],["فَقَدْ وَسَطْتَ البَزَرَى الآبازِرا","أَشْرافَها وَالسادَةَ البَهازِرا",69,"ر",2,0],["فقدوا أباً براً رحيماً قلبه","لم يلق منه سواهما الأبناء",70,"ا",2,0],["فقدوا إماما مرشداً بفعاله","قبل المقال وهكذا الحكماء",70,"ا",2,0],["فقدوا عليماً عاملاً في سنة","عدمت له في نهجه الأكفاء",70,"ا",2,0],["فقدوا بفقد الشيخ نبراس الهدى","والكل كان لهم به أضواء",70,"ا",2,0],["فقدوا المهيم بالنبي وآله","من عمره مدح لهم وثناء",70,"ا",2,0],["فقدوا به سر التصوف صافياً","ما شابه ما ادخل الدخلاء",70,"ا",2,0],["فقدوا به من يستغاث بوجهه","لله بل تستمطر الآلاء",70,"ا",2,0],["فقدوا به حبراً تقياً عارفاً","في المخلصين له اليد البيضاء",70,"ا",2,0],["فقد وَردتم فَذوقوا غب مَصدَرِكُم","لا يَهنكُم بَعده ريُّ ولا شبعُ",71,"ع",1,0],["فقد وَضَحَ السَّبيلُ بنُورِ شَيْبٍ","أَضاءَ شِهابُهُ بَعْدَ الخُبوِّ",72,"و",1,0],["فقدوا نفس مُصلح فيك حُرٍّ","لم يَدِنْهُ الثّنا ولم يخشَ ذاما",73,"م",2,0],["فقَدوا العزيزةَ من بني حسن","فتبّلدوا بمصابِ من فقدوا",74,"د",3,0],["فقدوا رأسَهم وحسبُكَ فيه","السيّدُ المصطفى الرفيعُ العِماد",75,"د",1,0],["فقد وجبت لي في دمامك حاجة","وتعصى إذا قصرت عنها وعن شكر",76,"ر",1,0],["فقد وثقت بعفو","على الذنوب يعفي",77,"ف",2,0],["فقد وثقوا بأن لا علم عند","ولا اعددت نوقاً أو سفينا",78,"ن",2,0],["فقد ولعت خير الكرام إلى العدا","بنو شيبة الحمد السري وبنو فهر",79,"ر",1,0],["فَقَد وَقَفَ المَديحُ بِمُنتَهاهُ","وَغايَتِهِ وَصارَ إِلى المَصيرِ",80,"ر",1,0],["فقد وصل السرى بصباح يوم","أحلكمُ المقر الظاهريّا",81,"ي",2,0],["فقد وسم الحق اعتقاداتِ خلقه","وحسبك ما قد قلت في حقه وقد",82,"د",1,0],["فَقَد وُعِظوا لَو يَنفَعِ الوَعظُ فيهِمُ","وَهَيهاتَ ما صمَّ الجَنادِلُ وَالزَّجرُ",83,"ر",1,0],["فَقَد وَاللَه قشَّع مِن سماه","ضَحوك البَرق وَكَّاف سَكوب",84,"ب",1,0],["فقد والشفع والوتر","ومن أقسم بالفجر",85,"ر",1,0],["فقد وابيك الخير افتئ تاركاً","حياتي شراباً يشرب العقل بالسكر",86,"ر",1,0],["فقد وردت أحاديث صحاح","بفضل أو يسهم للكلّ طرّا",87,"ر",2,0],["فقد وقفت بباب الجود معتذراً","مستشفعاً بك كي تمحى الجنايات",88,"ت",1,0],["فقد وقف الانسان في الوسط حائراً","فليس بحيوان وليس إلها",89,"ه",2,0],["فقد ودت الأرض من فوقها","وأنك تحيي بها يقبر",90,"ر",1,0],["فَقَد وَهَواهُ أَلهَبَ الشَوقُ أَضلُعي","كَما أُلهِبَت نارُ الشَبابِ بِخَدِّهِ",91,"د",2,0],["فقدومهم تاريخُه","نعم البشارة للمنى",92,"ن",2,0],["فقد وهب اللَه السرور لأهله","وثبت في أيدي المعالي دعائمه",93,"م",2,0],["فقدوا سواد قلوبهم فتُخُيِّلَت","من وهمهم في خدِّك الآثار",94,"ر",1,0],["فقد وأدت رقيبي","وبات تحت الرخام",95,"م",1,0],["فقد وأدت رقيبي","وبات تحت التراب",95,"ب",1,0],["فقد وأدت رقيبي","وبات تحت الرموس",95,"س",1,0],["فَقد وَاللَه كُدّر كلُّ صَفوي","وقَد بلغت مبالغها خطوبي",96,"ب",2,0],["فقدوا التي كان في إمكانهم","منعوا الردى الفرّاس أن يصطادها",97,"د",3,0],["فقد ورث المجد المؤثل والندى","لنجل