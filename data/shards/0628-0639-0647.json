{"poems":[[59,"بموقف ذلي دون عزتك العظمى","https://www.aldiwan.net/poem24635.html","الطويل"],[95,"بنات الدهر عوجي لا تهابي","https://www.aldiwan.net/poem9824.html","عموديه"],[80,"هم أوقدوا بين جنبيك نارا","https://www.aldiwan.net/poem14207.html","المتقارب"],[9,"أصَرَمْتَ حَبْلَكَ مِنْ لَمِي س","https://www.poetsgate.com/ViewPoem.aspx?id=20020",""],[119,"لك هل من مسامت او موازي","https://www.aldiwan.net/poem40930.html","عموديه"],[267,"أبعد الخيل أركبها ورادا","https://www.aldiwan.net/poem68196.html","الوافر"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138271",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64024","الخفيف"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199603","المسحوب"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28489","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62808","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72844","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72496","الوافر"],[4778,"إن غدا لناظره قريب","https://www.poetsgate.com/ViewPoem.aspx?id=188201",""],[5414,"زيارة فوق العادة للخيول العربية","https://www.poetsgate.com/ViewPoem.aspx?id=12930",""],[5431,"تاج فوز....","https://www.poetsgate.com/ViewPoem.aspx?id=203359",""],[5813,"كان الغرام احيان يطري وتنسين","https://www.poetsgate.com/ViewPoem.aspx?id=176825",""],[5956,"إذا لم يزُرْني","https://www.poetsgate.com/ViewPoem.aspx?id=182018",""],[5956,"نجاحُ عملية حفيدي أرتين الجراحية","https://www.poetsgate.com/ViewPoem.aspx?id=202749",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[406,"إلى ياسر عرفات ( بعها )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=840&r=&rc=31",""]],"verses":[["بِعَهدٍ قَديمٍ مِن أَلَستُ بِرَبِّكُم","بِمَن كانَ مَجهولاً فَعُرِّفَ بِالأَسما",0,"م",2,0],["بِعَهْدِ الرِّفْقَةِ الأَبْرَارِ أَمْسَوْا","وَهُمْ فِي ذِمَّةِ الصُمِّ الصِّلاَبِ",1,"ب",1,0],["بِعَهدِ لُزومٍ لِسُبلِ الوَفاءِ","إِذا حادَ عَنها وَجارا",2,"ر",2,0],["بعها الّذي قد شقّ نابهْ","ولقدْ شهدتُ الجيشً تخ",3,"خ",1,0],["بعهود الوصال لا تنقض العه","د ودعنا من مغلق الالغاز",4,"ز",1,0],["بِعُهدَةِ سِلعَةٍ رُدَّت قَديماً","أطُمُّ بها على الدَّاءِ العُضَالِ",5,"ل",1,0],["بعهد فؤادنا الملك المفدى","ومن للنابغين يشد أزرا",6,"ر",2,0],["بِعْهُ يا سيدي بِفَلْسٍ فإني","ضامنٌ أن تكون أرْبَحَ بائع",7,"ع",1,0],["بعهودٍ واحلفايا","ومسايرة مرضاه",8,"ا",2,0],["بِعَهدِكَ كَيفَ دَنَّسَتِ اللَّيالي","بُروداً ما تُلاثُ عَلى مُعيبِ",9,"ب",1,0],["بعهدِ اللهِ هل أزَلُّ وعِرْضٌ","على مَتْنِ الطّريقِ المُستقيمِ",10,"م",1,0],["بعهودي لهم ووجديَ فيهم","أنا عبد الباقي على العهد فإني",11,"ن",2,0],["بعهد من أبيه رجال حلٍّ","وعقد حالفوه على العهود",12,"د",1,0],["بعهد محمدٍ قد كان مجدٌ","تمدد في ذرى الكون الرحيبِ",13,"ب",1,0],["بعهدٍ.. يغاير عهد الدعيِّ","نعيش به الانتصارَ الجليلا",14,"ل",2,0],["بعهدتك الأمانة فالتزمها","بمرتبة الهمام المستعزِّ",15,"ز",1,0],["بعهد الغلا ياهايمه مستعدين","نسقي وفانا بدمنا لو قضا المي",16,"ي",1,0],["بعهد الصبا نحن شخنا فماذا","تركنا لشيخوخة يا رفاهُ؟؟",17,"ا",2,0],["بعهد الطفولة نحن شبِعْنا","عناصرَها لعباً وسواهُ",17,"ا",2,0],["بعهد الصبا ما انتقلنا إليه","ولكن لشيخوخة وا أساهُ",17,"ا",2,0],["بعهد الرضاعة كان الأنانيَّ","لكنْ بعهد الصبا ماطرُ",18,"ر",1,0],["بعهدك الأشد بالوعد الأتم","بنورك المشرق كاشف الظلم",19,"م",1,0],["بعها فأنت لما سواها أبيع","لك عارها ولها المقام الأرفع",20,"ع",1,1]]}