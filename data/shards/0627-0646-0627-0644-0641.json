,238,"ق",2,0],["أنَّ الفُؤادَ لَئنْ عَراه تقلّبٌ","تلقاهُ من لَهَفٍ يَثورُ ويُحْجِمُ",239,"م",1,0],["إن الفراقَ وُقُيتَه لم يُبقِ لي","إلا غياهبَ حسرةٍ لا تنجلي",240,"ل",2,1],["إنّ الفُجَيْرةَ بالجفونِ تَسَرْبَلَتْ","والقلبُ في عجمانَ تاهَ وهاما",241,"م",2,0],["إنَّ الفتاةَ حياؤُها ميزانُ","فبهِ الأنوثةُ تزدهي وتُزَانُ",242,"ن",1,1],["ان الفتى من بدا منه الجميل بلا","وعد ومن انجز الميعاد نصف فتى",243,"ت",2,1],["إِنَّ الْفَرِيسَةَ قَبْلَ صَيْدٍ تَهْرَعُ","وَالْحَاكِمُ الْعَرَبِيُّ دَوْمَاً يَخْنَعُ",244,"ع",1,1],["إنا لفرسان البيان عبارة","في سلكها آيات مجدك تنسق",245,"ق",1,0],["إن الفتى يجهل النعما إذا اتصلت","حتى يلذع بالبلوى فيعرفها",246,"ه",2,0],["إن الفؤاد تَفاقمت آهاتهُ","في كُل آهٍ قد رنا وتجنّنا",247,"ن",2,0],["ان الفنغراف الذي ما قلت أقبله","فاختر لنفسك ما يحلو عنا وغنا",248,"ن",2,1],["إنَّ الفريسةَ لا تُراوِدُ ذئبَها","كي لا تُعانقَ خِلسةً أنيابَهْ",249,"ب",2,0],["إنَّا لفي زمنٍ ساءتْ مصائرُهُ","نبكي فلسطينَ إذْ نبكي بلايانا",250,"ن",2,0],["إن الفتى من دون آثاره","ما هو إلا حجر مهمل",251,"ل",1,0],["إن الفتاة جمالها بحيائها","حسن المحيا ما اكتسى بحياء",252,"ا",2,0],["إِنَّ الفُراتَينِ إِنْ جَادَا بِمَكْرُمةٍ","تَطْفُو العَلاءَ كأَسرَابِ الدَلافِينِ",253,"ن",1,0],["إن الفراشات التي قد أسكنت","في حقل قلبك تشتهيك لتعبرا",254,"ر",2,0],["إنَّ الفسادَ سمومه منفوثةٌ","في عالم الجهلوتِ ليسً مهدَّدَا",255,"د",2,0],["إن الفُراتَ كما ترى في حُمرةٍ","تُسقى بلونِ الحسرةِ الأقوامُ",256,"م",1,0],["إنا لفي زمنٍ باهت به شَجبَ","بكثرة الأخواتِ إنَّ أو كانا",257,"ن",2,0],["إن الفداء لغلى ما حمدت له","أخى وإن كان في أولاه مذموما",258,"م",2,0],["إنَّ الفعالَ عنِ المُرادِ شواهدٌ","فانظرْ لحالٍكَ واحْتَكمْ ماذا تَرى",259,"ر",2,0],["إن الفضيلة في الزمان تراد","حيث العلاء لربها ينقاد",260,"د",1,1],["إنَّ الفرات لَيوحي لي بحكمتِهِ","هذي التي هي أهدافي ومكتَسَبِي",261,"ب",2,0],["إن الفراقَ تعاسةٌ وقشورُها","فرَحٌ من التجديدِ مثل الجَونِ",262,"ن",1,0],["إنَّ الفجائع في الوجودِ كثيرة","فلمَ الوجود وكله هو مفجعُ",263,"ع",1,0],["إن الفراق معذبي عن موطني","مصرَ التي ملكتْ حِجاي تملُّكا",264,"ك",2,0],["إن الفؤادَ إذا تَمَلَّكّهُ الهوى","سيجيئُ فعلاً ماله تفسيرُ ..",265,"ر",1,0],["15- أَنَّ الفَسَادَ تَرَاجَعَ اسْتِدْرَاكُهُ","والعَدْلُ ضيَّعَ مَنْطِقَ الأرْقَامِ",266,"م",1,0],["أنا لفّيت بحر القاف من أقصاه ألين أدناه","معاني تحتضرمغتالها شخص ٍ سفيه الراي",267,"ا",2,0],["أن ألف الشرق أقيالاً متوجة","فانتم النقطة الأولى من الألف",268,"ف",1,0],["إنَّ الفؤادَ تُراكَ اليومَ حاكمهُ","رَصَّعْتَ بالحُبِّ ماساتٍ لتيجاني",269,"ن",2,0],["إنَّ الفريسةَ والصَّيادُ يتْبَعُها","في لَهْوِهِ بسهامِ الموتِ والنَّبْلِ",270,"ل",1,1],["إنَّ الفتى الشرقيَّ مهما يرتقي","يشتاقُ إذلالَ الإناثِ ويرهِبُ",271,"ب",1,0],["ان الفتى المقدام من يوم الوغى","خاص المعامع والعداة شهود",272,"د",1,0],["إنّا لفي زمنٍ يُغريكَ مظْهَرُهُ","لكنَّ مخْبرَهُ سُوءٌ وأغْلالُ",273,"ل",1,0],["إِنَّ الْفَتَاةَ إِذَا اسْتَطَالَ لِسَانُهَا","هَلَكَ الْعِبَادُ؛ وَ \"كَيْدُهُنَّ عَظِيمُ\"",274,"م",1,0],["إنَّ الفَنَاءَ لَحَتْمٌ غَيْرُ مَا كَذِبٍ","في حَيْثُما انْدَاحَ جَوٌّ ، أوْ سَرَى قَمَرُ",275,"ر",1,0]]}