87,"لولا مخافة ظالم من ظالم","https://www.aldiwan.net/poem43254.html","الكامل"],[187,"إني موصيك فاحفظ عن أخي ثقة","https://www.aldiwan.net/poem44158.html","البسيط"],[238,"يا خير من أم الركاب","https://www.aldiwan.net/poem18036.html","مجزوء الكامل"],[250,"إن الفؤاد بآل كبشة مدنف","https://www.aldiwan.net/poem2103.html","الكامل"],[262,"أأبحت يا هذي دم المهجور","https://www.aldiwan.net/poem38277.html","الكامل"],[271,"لهفي على أرض بها الطليان","https://www.aldiwan.net/poem34980.html","الكامل"],[271,"من كان في تاريخه بحاثا","https://www.aldiwan.net/poem35001.html","الكامل"],[271,"أنت المقيل المرتجى يا هتلر","https://www.aldiwan.net/poem35585.html","الكامل"],[272,"وجد تحرك في قلبي فما سكنا","https://www.aldiwan.net/poem52053.html","البسيط"],[272,"راح الزمان ولا علم عن العلم","https://www.aldiwan.net/poem52057.html","البسيط"],[272,"حياك يا ربع ليلى كل هطال","https://www.aldiwan.net/poem52075.html","البسيط"],[272,"لم يبق في الحي من ربع ولا طلل","https://www.aldiwan.net/poem52078.html","البسيط"],[283,"في خد من أهواه خير طراز","https://www.aldiwan.net/poem32740.html","الكامل"],[301,"قد بكرت عاذلتي بكرة","https://www.aldiwan.net/poem45491.html","السريع"],[306,"أهي الجبال رست بها الغبراء","https://www.aldiwan.net/poem56618.html","الكامل"],[354,"خذ في هوى الغيد عني أحسن الخبر","https://www.aldiwan.net/poem40343.html","البسيط"],[365,"يا من لصب بأطراف المنى علق","https://www.aldiwan.net/poem60832.html","البسيط"],[392,"يا من له الخلق الحسن والخلق والعقل ومن","https://www.aldiwan.net/poem54485.html","عموديه"],[392,"إن الفتن فيها المحن من كل فن","https://www.aldiwan.net/poem54509.html","عموديه"],[403,"أذن الندى عن نداء الشعر صماء","https://www.aldiwan.net/poem46909.html","البسيط"],[404,"هذا النسيم أتاك من نجد","https://www.aldiwan.net/poem33970.html","الكامل"],[411,"ما يلمع البرق إلا حن مغترب","https://www.aldiwan.net/poem67530.html","البسيط"],[442,"إن العداوة لم تزل","https://www.aldiwan.net/poem14397.html","مجزوء الكامل"],[453,"إني أرقت لبارق لماح","https://www.aldiwan.net/poem13690.html","الكامل"],[459,"أيوما مثل يوم الجزع","https://www.aldiwan.net/poem55890.html","مجزوء الوافر"],[465,"جزت حد المديح قولاً وفعلا","https://www.aldiwan.net/poem3134.html","عموديه"],[539,"بعد التطلع لي بعيد ندائي","https://www.aldiwan.net/poem48308.html","عموديه"],[552,"يا راكبا وصل الوجيف ذميله","https://www.aldiwan.net/poem47335.html","الكامل"],[552,"قدني إليك فقد أمنت شماسي","https://www.aldiwan.net/poem47745.html","الكامل"],[559,"إن الفناء طهارة الإنسان","https://www.aldiwan.net/poem33788.html","الكامل"],[559,"يا واصفي أنت في التحقيق موصوفي","https://www.aldiwan.net/poem34358.html","المواليا"],[559,"إن الفقير هو الغني بربه","https://www.aldiwan.net/poem34444.html","الكامل"],[559,"يا من يقول بأنه يدري الفنا","https://www.aldiwan.net/poem34465.html","الكامل"],[559,"إن السيادة والريا","https://www.aldiwan.net/poem34634.html","مجزوء الكامل"],[563,"غاب الأمير فما تمادى المرجع","https://www.aldiwan.net/poem52842.html","الكامل"]],"verses":[["إِنَّ الفَجائِعَ بِالرَجالِ كَثيرَةٌ","وَلَقَلَّ مَن يَرعى وَمَن يَتَفَجَّعُ",0,"ع",1,0],["إِنَّ الفَصاحَةَ ذَلَّلَت لَكَ عُنقُها","فَأَخَذتَ مِنها بِالعِنانِ الأَطوَعِ",1,"ع",1,0],["إِنَّ الفَقيهَ هُوَ الفَقيهُ بِفِعلِهِ","لَيسَ الفَقيهُ بِنُطقِهِ وَمَقالِهِ",2,"ل",2,1],["إنّ الفَضائِلَ في حِماكَ بَضائِعٌ","لمْ تَخْشَ منْ بعْدِ النِّفاقِ كَسادا",3,"د",2,0],["إِنَّ الفَتاةَ صَغيرَةٌ","غِرٌّ فَلا يُسدى بِها",4,"ب",3,0],["إِنَّ الْفَقِيرَ لَهُ فِي قَوْمِهِ ذِمَمٌ","وَالْبِرُّ ضَرْبٌ مِنَ الإِيفَاءِ بِالذِّمَمِ",5,"م",1,0],["إنَّ الفِدَاءَ لأَغْلَى مَا حَمِدْتَ لَهُ","أُخْرَى وَإِنْ كانَ فِي أُولاَهُ مَذْمُومَا",6,"م",2,0],["إِنَّ الفَوارِسَ مِن رَبيعَةَ كُلَّهُم","يَرضَونَ لَو بَلَغوا مَدى الضَحيانِ",7,"ن",1,0],["إِنَّ الفَرَزدَقَ أَخزَتهُ مَثالِبُهُ","عَبدُ النَهارِ وَزاني اللَيلِ دَبّابُ",8,"ب",1,1],["إِنَّ الفَرَزدَقَ حينَ يَدخُلُ مَسجِداً","رِجسٌ فَلَيسَ طَهورُهُ بِطَهورِ",9,"ر",1,0],["إِنَّ الفَرَزدَقَ لا يُبالي مَحرَماً","وَدَمَ الهَدِيِّ بِأَذرُعٍ وَنُحورُ",9,"ر",1,0],["إِنَّ الفَوادِرَ لَو سَمِعنَ كَلامَها","ظَلَّت وُعولُ عَمايَتَينِ تَحَدَّرُ",10,"ر",1,0],["إِنَّ الفَرَزدَقَ مَن يَعلَق زِيارَتَهُ","يوبَق بِرِجسٍ وَلِلسوآتِ زَوّارُ",11,"ر",1,0],["إِنَّ الفَرَزدَقَ يا مِقدادُ زائِرُكُم","يا وَيلَ قَدٍّ عَلى مَن تُغلَقُ الدارُ",11,"ر",1,0],["إِنَّ الفَضيحَةَ لَو بُليتِ بِقَينِهِم","وَمَعَ الفَضيحَةَ غُربَةٌ وَضِرارُ",12,"ر",1,0],["إِنَّ الفَرَزدَقَ لَن يُزاوِلَ لُؤمَهُ","حَتّى يَزولَ عَنِ الطَريقِ صِرارُ",12,"ر",1,0],["إِنَّ الفَرَزدَقَ لا يَزالُ مُقَنَّعاً","وَإِلَيهِ بِالعَمَلِ الخَبيثِ يُشارُ",12,"ر",1,0],["إِنَّ الفَرَزدَقَ يا مُجاشِعُ لَم يَجِد","بِالأَجرَعَينِ لِمُنكَرٍ إِنكارا",13,"ر",2,0],["إِنَّ الفُؤادَ مَعَ الظُعنِ الَّتي بَكَرَت","مِن ذي طُلوحٍ وَحالَت دونَها البُصَرُ",14,"ر",1,0],["إِنَّ الفَرَزدَقَ قَد أُصيبَ بِسَهمِهِ","فَضَغا وَأَسلَمَ تَغلِبَ الخِنزيرُ",15,"ر",1,0],["إِنَّ الفَرَزدَقَ وَالبَعيثَ وَأُمَّهُ","وَأَبا البَعيثِ لَشَرُّ ما إِستارِ",16,"ر",1,0],["إِنَّ الفَوارِسَ يا فَرَزدَقُ قَد حَمَوا","حَسَباً أَشَمَّ وَنَبعَةً لا تُقطَعُ",17,"ع",1,0],["إِنَّ الفَرَزدَقَ قَد تَبَيَّنَ لُؤمُهُ","حَيثُ اِلتَقَت حُشَشاؤُهُ وَالأَخدَعُ",17,"ع",1,0],["إِنَّ الفَرافِصَةَ بنَ الاَحوَصِ عِندَهُ","شَجنٌ لِأُمِّكَ مِن بَناتِ عُقابِ",18,"ب",1,0],["إنَّ الفقير الذي في أيّ زاويةٍ","آوى إلى ظلّكم يا آي أحراس",19,"س",1,0],["إِنَّ الفَوارِسَ يَعرِفونَ ظُهورَكُم","أَولادَ كُلِّ مُفَسَّحٍ أَكّارِ",20,"ر",1,0],["ان الفضاء انحناءات قد اتصلت","منها النهايات عودا بالبدايات",21,"ت",1,1],["ان الفضيلة في جميع شؤونها","بيضاء تأبى بالبياض سوادا",22,"د",2,0],["ان الفراق لحادث","صعب وانت به خبيره",23,"ر",2,0],["إن الفؤاد يصير فيهِ أدمعا","وتسيل فوق الخد مني الأدمع",24,"ع",1,0],["إِنّا لَفي زَمَنٍ سِفاهُ شُعوبِهِ","في مُلكِهِم كَالمَرءِ في بَيتِ الكِرا",25,"ر",2,0],["إِنّا لَفي زَمَنٍ تَركُ القَبيحِ بِهِ","مِن أَكثَرِ الناسِ إِحسانٌ وَإِجمالُ",26,"ل",1,0],["إِنَّ الفِراقَ جَلا لَنا عَن غادَةٍ","بَيضاءَ تَجلو عَن شَتيتٍ أَشنَبِ",27,"ب",1,0],["إِنَّ الفِراقَ كَما عَلِمتُ فَخَلِّني","وَمَدامِعاً تَسَعُ الفِراقَ وَتَفضُلُ",28,"ل",1,0],["إِنَّ الفَضيلَةَ لِلَّذي اِستَسقى بِهِ","عُمَرٌ وَشُفِّعَ إِذ غَدا يَستَشفِعُ",29,"ع",1,0],["إِنَّ الفَتى مَن يُقولُ ها أَنا ذا","لَيسَ الفَتى مَن يُقولُ كانَ أَبي",30,"ب",2,0],["إِنَّ الفَناءَ مِنَ البَقاءِ قَريبُ","إِنَّ الزَمانَ إِذا رَمى لَمُصيبُ",31,"ب",1,1],["إِنّا لَفي ظُلمَةٍ مِنَ الحُبِّ لِل","دُنيا وَأَهلُ التُقى كَواكِبُها",32,"ب",3,0],["إِنّا لَفي دارِ تَنغيصٍ وَتَنكيدِ","دارٌ تُنادي بِها أَيّامُها بيدي",33,"د",2,1],["إِنّا لَفي دارٍ نَرى الإِكثارَ لا","يَبقى لِصاحِبِهِ وَلا الإِقلالا",34,"ل",2,0],["إِنَّ الفَقيرَ وَإِن نَمَت","هُ مَكارِمٌ وَفَضائِلُ",35,"ل",1,1],["إنَّ الفتى في يَدَيهِ المالُ عاريَةٌ","كالثوب عُرّي منه غَيْرُهُ وَكُسي",36,"س",2,0],["إِنّ الفروعَ على الأصول شواهدٌ","تَقْضي بطيبِ مناقبٍ وعناصرِ",37,"ر",1,0],["أنا لفظي درُّ النحورِ ومثلي","لم يبعْ بالحطامِ درَّ النحورِ",38,"ر",1,0],["إِنَّ الفَقيرَ إِلى الحَياةِ لَمَن يَرى","أَنَّ الحَياةَ بِثَروَةٍ وَعَقارِ",39,"ر",1,0],["إِنّا لَفي غَمرَةٍ عَمياءَ لَيسَ لَها","فيما تَقَدَّمَها شِبهٌ وَلا مِثلُ",40,"ل",1,0],["إنّ الفسادَ جميعاً والضّلالَ معاً","إلى اليمامةِ في أجلادِهِ رَجَعا",41,"ع",2,0],["إِنَّ الفُؤادَ لِلبائِنِ الغَرِدِ","لَمّا تَذَيَّلَ خَلفَ العُنَّسِ الخُرُدِ",42,"د",1,1],["إِنَّ الفِراقَ دَعا الخَليطَ فَزالا","وَقَعَدتَ تَسأَلُ بَعدَهُ الأَطلالا",43,"ل",2,1],["إنَّ الفَنَاءَ لكلِّ حَيٍّ غايَةٌ","مَحْتُومَةٌ إنْ لَمْ يَكُنْ فكأَنْ قَدِ",44,"د",1,0],["إنَّ الفَتَى مَنْ سَوَّدَتْهُ نفْسُهُ","بالفضلِ لا مَنْ سادَ غيرَ مُسوَّدِ",45,"د",1,0],["إِنَّ الفَخارَ إِلى مَن قَد بَنى لَكُمو","مَجداً تَقاصَرَ عَن أَركانِهِ أُحُدُ",46,"د",1,0],["إِنّا لَفي وَقتِ الغُروبِ وَقَد مَضى","زَمَنُ الضَحاءِ وَساعَةُ الإِظهارِ",47,"ر",1,0],["إِنَّ الفَوارِسَ ما اِنفَكَّت عَقائِلُها","مَطلولَةٌ بَينَ آسادٍ وَأَشبالِ",48,"ل",1,0],["إِنَّ الفَتِيِّينَ بِالفِتيانِ في لَعِبٍ","كُلٌّ أُحِسَّ وَمُرّاً لا يُحِسّانِ",49,"ن",1,0],["إنَّ ألفاً منه صعودٌ وألفاً","ذو استواءٍ سمح وألفاً حدور",50,"ر",1,0],["إنّا لفي عصر به","يودى التوقف بالأنام",51,"م",1,0],["إنا لفي عصر به","يقصي القعود عن المرام",51,"م",1,0],["إن الفتى مسير","إذا نأى أو اقترب",52,"ب",1,0],["إنّا لَفي زمنٍ ما للشعوب به","يوماً عَن العلماء المصلحين غنى",53,"ن",2,0],["إِنَّ الفَجيعَةَ بِالرِياضِ نَواضِراً","لَأَجَلُّ مِنها بِالرِياضِ ذَوابِلا",54,"ل",2,0],["إنّا لفي زمنٍ حديثُ دُعاتِه","نُسْكٌ ولكنّ السياسةَ تأثّمُ",55,"م",1,0],["إِن الفتوة فاعْلمْ حَدُّ مطلبِها","عِرْض نَقِيٌّ ونطق فيه تِبْيانُ",56,"ن",1,0],["إِنَّ الْفَلاةَ لَهَا رِجَالٌ غَيْرُنَا","يَبْغُونَ نَيْلَ الْيُسْرِ بِالإِفْلاسِ",57,"س",1,0],["إِنَّ الْفَتَاةَ الَّتِي هَامَ الْفُؤَادُ بِهَا","أَخْفَتْ عَلَيَّ سَبِيلَ الْحَزْمِ والسَّدَدِ",58,"د",1,0],["إِنَّ الفِلاَحَةَ وَالفَلاَحَ تَسَلسَلا","لفْظاً وَمَعْنىً مِنْ نِجَارٍ جَامِعِ",59,"ع",1,0],["إنّ الفَتى ما فِيه من أخلاقهِ","فإذا ذَهبْنَ فكُلُّ شيءٍ مافي",60,"ف",2,0],["إنا لفي زمن يفيض دعايةً","كادت تدقّ به الشعوب طبولا",61,"ل",2,0],["إنَّا لفي زمنٍ فقدُ النقود به","يدمي العيون كفقد الصحب والآل",62,"ل",1,0],["إنا لفي زمن الطفولة والبراءة والطهور","نحيا كما تحيا البلابل والجداول والزهور",63,"ر",1,1],["إن الفحُولَ السالفينَ تعهَّدوا","عصرَ القريضِ وأُعجبوا بفحوله",64,"ل",2,0],["إنّ الفراخ على نعومة ريشها","ريعت ففارق سربها الأوداحا",65,"ح",2,0],["إنَّ الفؤادَ هفَا للبائنِ الغردِ","لَمَّا تَذَيَّلَ خَلْفَ العُنَّس الخُرُدِ",66,"د",1,1],["إِن الفَتى عِندَ الرعا","ع مِن الوَرى مَن حازَ رَفدا",67,"د",2,0],["انا لفظا سألتها وهو معنى","فكلانا في سوحها سائلان",68,"ن",1,0],["إن الفضولَ يميت أفئدةَ الورى","وبتركه تحيي الحياةَ وتشرُفُ",69,"ف",1,0],["إِنَّ الفَضَائِلَ إِن أتَينَ جَنَابَهُ","تَكُنِ المُنَى وَجهُنَّ عنهُ جَدَاوِلا",70,"ل",2,0],["إِنَّ الفَعالَ الَّذي ما شابَهُ كَدَرٌ","شادَ المَقالَ الَّذي ما شابَهُ كَذِبُ",71,"ب",1,0],["إِنَّ الفَريقَ مُذِ اِستَقَلَّ مُغَرِّبا","لَم يُبقِ لي في طيبِ عَيشٍ مَرغَبا",72,"ب",2,1],["إن الفراسة فيك اليوم قد صدقت","وكان حبك للإسلام تصديقا",73,"ق",2,0],["إِنَّ الفُؤَادَ لَيَهوَى أَن أُناقِلَها","رَجعَ الكلامِ وَإِن عارَت أَدَانِيهَا",74,"ي",3,0],["إن الفقيه له عليك تأوّل","ينجيه من عيب ولوم اللائم",75,"م",1,0],["إن الفقير إذا نالته موهبة","من يومه فله يوم يحاسبه",76,"ب",2,0],["إِنَّ الْفُؤَادَ وَحَقِّكُمْ","مِنْ أَجْلِ ذَلكَ فِي اكْتِئَابْ",77,"ب",1,0],["إِنَّ الفُؤادَ بِآلِ كَبشَةَ مُدنَفُ","قَطَعَ القَرينَةَ غَدوَةً مَن تَألَفُ",78,"ف",1,1],["إنا لفي زمن بنوه أساود","بأساور وقساور بقصور",79,"ر",1,0],["إن الفتى العربيَّ يذكر أهلَهُ","ولأجلِ سكّانٍ يُحَبُّ مكان",80,"ن",1,0],["إن الفرنجةَ دوَّخوا أوطاننا","وتَقاسموا الأسلابَ والميراثا",81,"ث",2,0],["إن الفضائلَ كالأزاهرِ حبُّها","من فضلِها وهو الأعمّ الأشهر",82,"ر",1,0],["ان الفَضائل في الاخطار مودعة","فاِبغ الفَضائل واجعل روحك الثمنا",83,"ن",2,0],["ان الفَقير الحرازي صاحبي عثرت","به كَبائرهفضلا عَن اللمم",84,"م",1,0],["ان الفقيه جَمال الدين مدلنا","من سر مَعناه ظلا غير زوال",85,"ل",1,0],["ان الفَضائِل حيث الشخص متحد","وَالناس اجمع في شخصين عَن رجل",86,"ل",1,0],["إِنَّ الفُتُوَّةَ مِنهُ باجِحَةٌ لَدى ال","هَيجا بِسَيفٍ كَالقَضاءِ جُرازِ",87,"ز",1,0],["إِنَّ الفَتى يُقتِرُ بَعدَ الغِنى","وَيَغتَني مِن بَعدِ ما يَفتَقِر",88,"ر",1,0],["إن الفرنج على تكاثف عدهم","كالرمل إذ لعبت به النكباءُ",89,"ا",2,0],["إِنّ الفُنون الَّتي أَنشأت في صغرٍ","كانَت هُدىً لِشيوخ العَصر في الكبرِ",90,"ر",1,0],["إنّا لفي زمَنٍ مَلآنَ من فِتَنٍ","فلا يُعابُ به مَلآنُ مِن فَرَق",91,"ق",1,0],["إن الفتى الحر الكريم لا يرتضي الفعل الذميم","والهون للنذل اللئيم",92,"م",1,0],["إن الفتن فيها المحن من كل فن","فتوقها يا صاحبي وخليلي",93,"ل",2,1],["إنّا لَفِي زَمنٍ ودّ الفَصيحُ به","لو أنّه ألْكَنٌ في القولِ فأفاءُ",94,"ا",2,0],["إنا لفي زمن شواغله","عدة فقد جلت عن العد",95,"د",1,0],["إِن الفَوارِسَ مِن شَيبانَ قَد عُرِفوا","بِالصِدقِ إِن نَزَلوا وَالمَوتِ إِن رَكِبوا",96,"ب",3,0],["إن الفشاكل للمجل","لي حسد مذ حاز شاوه",97,"ا",3,0],["أن الفؤاد إِذا استقل بدائه","يهفو لكل مغرد صدّاح",98,"ح",1,0],["أنال فكان مقموراً","وغار فكان محتشِما",99,"م",2,0],["أنَّ ألفاظيَ التي يشهد الفضل ل","ها أنَّها الكوامل فضلا",100,"ل",2,0],["إن الفَصاحةَ مَنطِقي لكنَّني","في الهجرِ قد لُقِّبتُ بالخَرساء",101,"ا",2,0],["إنّ الفتى ما إنْ تطيب فروعُه","لمجرّبٍ حتّى تطيب أُصولُهُ",102,"ل",2,0],["إنّ الفضائلَ بعد فقدِ محمّدٍ","دَرَسَتْ معالمُها مع الأدراسِ",103,"س",1,0],["إن الفناء طهارة الإنسانِ","لصلاة معرفة البعيد الداني",104,"ن",2,1],["إن الفناء طهارة مفروضة","لصلاةِ معرفةٍ على الإنسان",104,"ن",1,0],["إن الفتى من بعهدهْ في الأزل يوفي","صافى فصوفي لهذا سميَّ الصوفي",105,"ي",1,0],["إن الفقير هو الغني بربه","وكذا الغني هو الفقير البائس",106,"س",1,1],["إن الفنا حالٌ إذا دهم الفتى","لا يستفيق له الفتى من سكره",107,"ر",2,0],["إن الفروع من الأصو","ل صناعة المبدي المعيد",108,"د",1,0],["إنَّا لفي زَمَنٍ تَدِبُّ على العَصا","فيهِ العُلومُ وقد تَقومُ فتُصرعُ",109,"ع",1,0]]}