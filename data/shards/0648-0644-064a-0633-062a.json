iwan/poem/91720","البسيط"],[3707,"","https://poetry.dctabudhabi.ae/diwan/poem/124643","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216825","الطويل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132115","المتقارب"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131105",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131252",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114142","السريع"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135457","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40113","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86459","الطويل"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138723","البسيط"],[4362,"","https://poetry.dctabudhabi.ae/diwan/poem/146021","البسيط"],[4399,"","https://poetry.dctabudhabi.ae/diwan/poem/130869","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83188","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72471","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120367","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139559",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139516",""],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204369","الكامل"],[4690,"أمْنيات أسيرة","https://www.poetsgate.com/ViewPoem.aspx?id=120284",""],[4804,"فؤادي مشتاقٌ وقلبي تائقُ","https://www.poetsgate.com/ViewPoem.aspx?id=92099",""],[4578,"بماذا يوفي قدر علياك مادحُ","https://www.poetsgate.com/ViewPoem.aspx?id=49378",""],[4935,"يغور اللئيم قليل الوفا","https://www.poetsgate.com/ViewPoem.aspx?id=129373",""],[4935,"فخار الملوك بأعوانها","https://www.poetsgate.com/ViewPoem.aspx?id=129303",""],[4990,"كوكب العري","https://www.poetsgate.com/ViewPoem.aspx?id=176928",""],[4119,"كأن الذي آلى على بسط كفه","https://www.poetsgate.com/ViewPoem.aspx?id=16215",""],[5042,"ليذهبوا في ملامي أية ذهبوا","https://www.poetsgate.com/ViewPoem.aspx?id=211626",""],[5147,"أضر بجسمي عرق النسا","https://www.poetsgate.com/ViewPoem.aspx?id=166690",""],[4045,"أحاجيكم ماقوس لحم سهامها","https://www.poetsgate.com/ViewPoem.aspx?id=200267",""],[5318,"سيحلوّْ الوصلُ من بعدِ الغيابِ","https://www.poetsgate.com/ViewPoem.aspx?id=211114",""],[592,"شجتني وأبكتني خطوب فوادح","https://www.poetsgate.com/ViewPoem.aspx?id=128836",""],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""],[5431,"وقلبي مضغة ضخت هواه","https://www.poetsgate.com/ViewPoem.aspx?id=190612",""],[5431,"وعرّشت في الأعماق نبعا وماجفّا","https://www.poetsgate.com/ViewPoem.aspx?id=198714",""],[5550,"لعَمْرُكَ","https://www.poetsgate.com/ViewPoem.aspx?id=215476",""],[5642,"مُذكرات طفل سوري","https://www.poetsgate.com/ViewPoem.aspx?id=131268",""],[5642,"مِسكُ الختام","https://www.poetsgate.com/ViewPoem.aspx?id=123667",""],[5703,"الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=216044",""],[5722,"آذار","https://www.poetsgate.com/ViewPoem.aspx?id=12684",""],[5751,"العامليّة","https://www.poetsgate.com/ViewPoem.aspx?id=214762",""],[5762,"هو الإثمُ زلزل زلزالها","https://www.poetsgate.com/ViewPoem.aspx?id=177978",""],[5776,"بعيدون...","https://www.poetsgate.com/ViewPoem.aspx?id=199877",""],[5809,"نور الغار","https://www.poetsgate.com/ViewPoem.aspx?id=205940",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[469,"أعاذلتي كُفّي ثكلتِ عن العذلِ","https://www.poetsgate.com/ViewPoem.aspx?id=76855",""],[1920,"هروب بنكهة العودة","https://www.poetsgate.com/ViewPoem.aspx?id=191401",""],[5956,"شَعْبِيَّةُ المَرْتَبة *","https://www.poetsgate.com/ViewPoem.aspx?id=183665",""],[5956,"الرياضة أسباب الصحة والجمال","https://www.poetsgate.com/ViewPoem.aspx?id=193882",""],[6068,"تعاتبني فيقهرني العتاب","https://www.poetsgate.com/ViewPoem.aspx?id=179274",""],[5309,"على بابه لوحة باليه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573914",""],[5309,"دعني من الأطماع فالحياة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573951",""],[2220,"عجبتُ لموجودٍ حوى كلِّ صورة ٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11471&r=&rc=345",""]],"verses":[["وليسَ تُنْمَى عِندَهُمْ رَميّةٌ","فقُلْ لهُمْ لا شَلَلاً ولا عَمى",0,"ا",1,0],["وليْسَ تَرْوي غَليلاً أو تَعُلُّ صَدىً","ظِماءُ عزْمِكَ ما أوْرَدْتَها أمَلا",1,"ل",2,0],["وَلَيسَت بوَكباءِ الصِدارِ إِذا مَشَت","تَوَكَّنُ مَشيَ الكَودَنِ المُتَحَبِّسِ",2,"س",1,0],["وَلِيَستَفيدَنَّ السَناءَ مَعَ الغِنى","عَبدٌ يُفيدُ النُصحَ حينَ يُفادُ",3,"د",1,0],["وليست حياة الناس إلاّ تجِدّداً","مع الدهر في إيباسه واخضراره",4,"ر",2,0],["وليس تقيه الحرّ إلا تَعِلّةً","لنفس خلت من صبرها المتبدّد",5,"د",1,0],["وليس تندى من النكراء أوجههم","كأنما القوم منجورون من خشب",6,"ب",1,0],["وليست بأيديهم تُهَزُّ رماحُهُم","ولكن بأحْقِيهم تُهَزّ فَتُوعَبُ",7,"ب",1,0],["وليس تخطئ ذا الخرطوم واحدةٌ","من اثنتين إذا ما حُصحِص النظر",8,"ر",1,0],["وليست لأستاذٍ عليّ ملامةٌ","إذا غاب شخصي عنهُ والنفع حاضر",9,"ر",1,0],["وليس تجدي عليه مَوعِظتي","إن قدَّرَ اللَهُ حيْنَهُ وقضى",10,"ض",2,0],["وليست على ما يحفظ الله ضيعة","ولكن ما لا يحفظ الله ضائع",11,"ع",1,0],["وليست بأشباه الأفاعي عرامةً","متى لم يطل بالعيث فيكم ولوعها",12,"ع",3,0],["وليس تأويلُ أخي شبهةٍ","لكنّه نصٌّ وتنزيلُ",13,"ل",1,0],["وليستْ من الأيدي الحميد بلاؤها","يدٌ قسمتْ سُوءاً وإن سوّتِ القَسَمْ",14,"م",1,0],["وليستْ بسيِّدِنا خَلَّةٌ","تُخَوِّفُهُ العَذْمَ من عاذمِ",15,"م",1,0],["وليستْ بحاليَ من مُسْكةٍ","وإن جَمْجَمَتْ سكتةُ الكاظمِ",15,"م",1,0],["وليستْ خِسَّةُ الأجفانِ مِمَّا","يُخَسِّسُ قيمةَ النَّصْلِ اليماني",16,"ن",2,0],["وليْسَتْ إنْ نظرتِ بزائداتٍ","حُلى الأغماد في السَّيْفِ الدَّدانِ",16,"ن",1,0],["وليست بعاليةٍ حالُه","ولكنها جِيفة طافيه",17,"ف",3,0],["وَلَيسَت تَستَخِفُّ أَخا وَقارٍ","وَبِنتُ الدَنِّ بِالأَحلامِ تَزري",18,"ر",2,0],["وَليسَت نُجوماً ما تَرى وَسَحائِباً","وَلَكِنَّها مِنكُم وُجوهٌ وَئيمانُ",19,"ن",1,0],["وَلَيسَت تَراها العَينُ إِلّا عَباءَةً","يُشَدُّ عَلَيها سَرجُها وَحِزامُها",20,"م",3,0],["وليست عيون الأقربين إذا طمى","مصاب بأولى من عيون الأباعد",21,"د",1,0],["وَلَيسَت بِالمَجالِ لِنَقدِ باغٍ","وَراءَ يَراعِهِ حَسَدٌ وَغِلُّ",22,"ل",1,0],["وَلَيسَت كَالإِناثِ وَلا اللَواتي","تُعَدُّ لَها القُبورُ مِنَ الحِجالِ",23,"ل",1,0],["وَلَيسَت مِن مَواطِنِهِ وَلَكِن","يَمُرُّ بِها كَما مَرَّ الغَمامُ",24,"م",1,0],["وَلَيسَت مُداماً إِذا أَنتَ لَم","تُواصِل مَعَ الشَربِ إِدمانَها",25,"ن",3,0],["وَلَيسَت لَهُ إِلّا السَماحَ جِنايَةٌ","إِذا أُخِذَ الجاني بِبَعضِ الَّذي يَجني",26,"ن",2,0],["وَلَيسَت كُلَيبٌ كائِنَينَ كَدارِمٍ","وَوَدَّ جَريرٌ لَو عَطِيَّةَ غالِبِ",27,"ب",1,0],["وَلَيسَت وَإِن نَبَّأتُ أَنّي أُحِبُّها","إِلى دارِمِيّاتِ النِجارِ جِيادِ",28,"د",1,0],["وَلَيسَت مِنَ اللائي العَذانُ مَقيظُها","يَرُحنَ خِفافاً في المُلاءِ المُعَضَّدِ",29,"د",1,0],["وَلَيسَت كَما تَبني العُلوجُ وَحَوَّلَت","عَنِ الجِسرِ أَبدانُ السَفينِ المُقَيَّرا",30,"ر",2,0],["وَلَيسَت يَدٌ أَولَيتَها بِغَنيمَةٍ","إِذا كُنتَ تَبغي أَن تُعِدَّ لَها شُكرا",31,"ر",2,0],["وَلَيسَت أَيادي الناسِ عِندي غَنيمَةً","وَرُبَّ يَدٍ عِندي أَشَدُّ مِنَ الأَسرِ",32,"ر",1,1],["وَلَيسَت أَثافي القِدرِ إِلّا ثَلاثُها","وَلا الرُمحُ إِلّا لَهذَماهُ وَعامِلُه",33,"ل",2,0],["وَلَيسَت فَرحَةُ الأَوباتِ إِلّا","لِمَوقوفٍ عَلى تَرَحِ الوَداعِ",34,"ع",1,0],["وَلَيسَت دِياتٍ مِن دِماءٍ هَرَقتَها","حَراماً وَلَكِن مِن دِماءِ القَصائِدِ",35,"د",1,0],["وَلَيسَت رَغوَتي مِن فَوقِ مَذقٍ","وَلا جَمري كَمينٌ في الرَمادِ",36,"د",1,0],["وَلَيسَت بِالعَوانِ العَنسِ عِندي","وَلا هِيَ مِنكَ بِالبِكرِ الكَعابِ",37,"ب",1,0],["وَلَيسَت بِأَدنى غَيرَ أُنسِ حَديثِها","إِلى القَومِ مِن مُصطافِ عَصماءَ هاجِنِ",38,"ن",1,0],["وليس تلقاه من دون القلوب ولا ال","غيوب إلاّ سيورٌ كالعراقيّ",39,"ي",1,0],["وليسَ تَرضى اللّيالي في تصرّفِها","إلاّ إذا مَزجَتْ صاباً بقِنديد",40,"د",1,0],["وَلَيسَت تُريدُ عَلى ما أَقولُ","سِوى ما تَرى مِن نُحولي شُهودا",41,"د",2,0],["وَلَيسَت خُطاهُ حينَ يُزهى بِرِدفِهِ","إِذا ما مَشى في الأَرضِ أَكثَرَ مِن فِترِ",42,"ر",1,0],["وَلَيسَت بِالقَدائِمِ في ضَميري","لَعَمرُكَ بَل حَوادِثُ مُوجَداتُ",43,"ت",1,0],["وليْستْ تُحِسّ الأرضُ منها بوطْأةٍ","فتُفْزِعُ سِرْباً أو تَروعُ صِوارا",44,"ر",2,0],["وَلَيسَت بِشَوهاءَ مَقبوحَةٍ","تُوافي الدِيارَ بِوجهٍ غَبِر",45,"ر",1,1],["وَلَيسَ تعوقني عَن أَرض مصر","إذا يممتها الطرق الصعاب",46,"ب",1,0],["وليستْ ترى غير مَعبودها","على عرشهِ العبقريِّ الجلالْ",47,"ل",1,0],["وليست وإنْ جاءتْ بحَلْيٍ وزِينَةٍ","علَيّ كدِرْعي عِزّةً وصِيانَه",48,"ن",2,0],["وليستْ بالمِعَنّةِ في جِدالٍ","وإنْ جُدِلَتْ كما جُدِلَ الأعِنّه",49,"ن",2,0],["وَلْيَسْتَدِمْ بَيْنَكُمَا الْمَجْدُ الَّذِي","يَزْدَادُ مَا انْطَوتِ السُّنُونُ نُشُورَا",50,"ر",2,0],["وَلَيْسَتْ هَذِهِ الأَعْلاَمُ إِلاَّ","كَأَوَّلِ عَهْدِها أَعْلاَمَ نَصْرِ",51,"ر",1,0],["وليست بها شمسٌ فكل زمانهم","غدوٌّ وآصالٌ بغير هجير",52,"ر",1,0],["وليس ترابُ الأرضِ غَيْرَ تَرائبٍ","وغيرَ عُقولٍ حُطِّمتْ وقُلوبِ",53,"ب",1,0],["وليست شِباكُ العزِّ إلاَّ عزيمةً","وما المجدُ إلاَّ صَوْلةٌ وغِلاب",54,"ب",1,0],["وليست لعمر الله عند حدودها","بتاركه عيشا ولا يتصرم",55,"م",1,0],["وليس تروي غليلا أو تعل صدى","ظماء عزمك ما أودت هل أهلا",56,"ل",2,0],["وليستخفَّ البحرَ من أسطولِكم","عَلَمٌ كنجم المدلجِ الحيرانِ",57,"ن",1,0],["وَلَيْسَتْ من اللاّئي العَدانُ مَقيظُها،","يَرُحْنَ خِفافاً في المُلاءِ المُعَضَّدِ",58,"د",1,0],["وليس تخطىء ذا الخرطوم واحدة","ٌ من اثنتين إذا ما حُصحِص النظر",59,"ر",1,0],["وليس ترياقه يا سيدي وأَخي","في ناب صلى الله عليه وآله وسلم ولا في سن ثعبان",60,"ن",1,0],["وليستردّوا مجد أسلافهم","وليستعدوا للزمان الخصيب",61,"ب",1,0],["وَلَيسَ تَرضى العَوالي وَهيَ ما اِنحَطَمَت","أَن يَطرُدَ الأُسدَ عَن عِرّيسِها الشَبَبُ",62,"ب",1,0],["وَلَيسَت لِهَذا المُلكِ أُولى طَريدَةٍ","غَدا حَظَّها مِمَّن بَغَت نَصرَها الطَردُ",63,"د",1,0],["وَلَيسَت تَرُدُّ ما أَمَرتَ خُطوبُهُ","وَلا تَرِدُ الأَملاكُ مِن حَيثُ تَصدُرُ",64,"ر",1,0],["وليس تلافٍ بل ولا ردّ فائت","هناك ولا يجدي سوى الجبر للكسر",65,"ر",1,0],["ولْيسْترحْ من طعنِ لَبّاتِ العدا","بمُجاجِ لبَّةِ دَنِّهِ المطْعونِ",66,"ن",1,0],["وليستِ الدُّنيا سوى قَحبةٍ","تَبرُزُ في الزينةِ للزاني",67,"ن",2,0],["وليس تحسُّ منه العينُ عَيباً","سوى المحذورِ من عينِ الكَمالِ",68,"ل",1,0],["وَلَيسَ تَدفَعُ عَن حَيٍّ مَنِيَّتهُ","إِذا أَتَت عُوَذُ الراقي وَلا النُشرُ",69,"ر",1,0],["وَلَيسَت عَشِيّاتُ الحِمَى بِرَواجِعِ","عَلَيكَ وَلَكِن خَلِّ عَينَيكَ تَدمَعَا",70,"ع",2,0],["وليس تخافُ الغانياتُ رقيبَها","لِوَصْلي ولا تُصغي إلى قولِ قائِلِ",71,"ل",1,0],["وليسَتْ تُطيقُ الشينَ في حالِ نُطقِها","فمِنْ أجلِ بُعْدِ الشينِ بَاعَدهَا الشيْنُ",72,"ن",1,0],["وَلَيسَ تَلافي مُذ رُميتُ بِهَجرِكُم","عَجيبٌ وَلَكِنَّ العَجيبَ سَلامَتي",73,"ت",2,0],["وليسَت حياةُ المرءِ إلا أمانياً","إذا هي ضاعت فالحياة على الإِثر",74,"ر",1,0],["وليس تخلف ارضا جزت مجدبةً","بها سمي نبي اللَه وسمي",75,"ي",1,0],["وليست طيوراً في فروع غصونه","تمتعت الدنيا بطول حياته",76,"ت",2,0],["وَليستما من عبقري كَرامة","حلل الرضا لا العَبقَري المعلما",77,"م",2,0],["وَلَيْسَتْ لَهُ مَرَّاكشٌ بِقَرارَةٍ","وأَنَّى ومَازَالَتْ مُظَاهِرَةً حِمْصَا",78,"ص",2,0],["وليست كما أبقت ضبيعة اضخم","وليست كما سادت قبائل جرهم",79,"م",1,0],["وليست للغواني والأغاني","ولا للشهوات الدنيويه",80,"ي",2,0],["وَليسَت فنونُ العلمِ إلّا طرائق","يؤمُّ بِها كلّ اِمرئٍ ما يهمّهُ",81,"م",2,0],["وَلَيست أصولُ الشرعِ إلّا سياسةً","إِلهيّةً تًحذو من العلّة المجرى",82,"ر",2,0],["وليسَت توازي الشمّ حلم حليمهم","ولا علمَ إلّا قد أحاطوا به علما",83,"م",2,0],["وليستْ بفَتْلاء اليدَيْنِ لدى السُّرى","ولكنَّها من نَسْجِ مُسْتَحكم الفَتل",84,"ل",1,0],["وليستْ عطايا وَحْدَها ما تُنيلُه","ولكنْ عَطايا حَشْوَهُنّ مَعال",85,"ل",1,0],["وَلَيسَت يَدٌ أَودَعتَها عِندَ ناطِقٍ","كَمِثلِ يَدٍ أَودَعتَها عِندَ مُفحَمِ",86,"م",1,0],["وليسَت عَطاياهُ عَلى قَدرِ نَفسِه","وإِن عَظُمَت فالسُّحبُ أَدنى مِن السَّما",87,"م",2,0],["وليسَ تفي مثل الصوارم والقنا","إذا عبثت أيدي المودَّات بالغدر",88,"ر",1,0],["ولَيْسَتْ فَعْلَةٌ تشناكَ لكِنْ","تَمَلَّكَ أهلَها ضِدُّ المعادِ",89,"د",1,0],["وليست به خصت سدوس وآلها","جديلة بل عمت به البدو والحضر",90,"ر",1,0],["وليس تُبرى غصون","إِلا وعادت عوالي",91,"ل",2,0],["وليس تراثُ العبقرية نغمةً","ولكن صداها الخالقُ الغيبَ والكونا",92,"ن",2,0],["وليست دموعٌ تُبذل اليوم حوله","دموعكمو بل ِ من معانيه ما 