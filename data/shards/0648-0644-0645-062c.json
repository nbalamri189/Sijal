{"poems":[[53,"ألا قل لنحويك الأخفش","https://www.aldiwan.net/poem64923.html","المتقارب"],[47,"أنظر إلى العلياء كيف تضام","https://www.aldiwan.net/poem65657.html","الكامل"],[234,"شرى البرق فالتاع الفؤاد المعذب","https://www.aldiwan.net/poem51254.html","الطويل"],[240,"الدست من لألاء وجهك مشرق","https://www.aldiwan.net/poem31812.html","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86705","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87066","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86715","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59703","الكامل"],[1586,"","https://poetry.dctabudhabi.ae/diwan/poem/96343","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125483","الرمل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125359","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89058","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70163","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90893","الكامل"],[5111,"طُبْنَةُ","https://www.poetsgate.com/ViewPoem.aspx?id=212157",""],[5397,"أطربتني نغمات لحن المنشد","https://www.poetsgate.com/ViewPoem.aspx?id=157934",""],[5582,"أَنَوارُ هَلْ مِنْ زَوْرَةٍ أَنَوارُ","https://www.poetsgate.com/ViewPoem.aspx?id=63507",""]],"verses":[["ولمْ جئتَ أسودَ ذا حُلكةٍ","ولم تأتِ كالحية الأرقش",0,"ش",1,0],["وَلِمُجتَدٍ رَجَعَت يَداهُ بِلا جَداً","أَعيا عَلَيهِ البَذلُ وَالإِنعامُ",1,"م",1,0],["ولم جاء والطّيفَ المُعاوِد مَضْجَعي","معاً ومضى لمّا مضى المتأوِّب",2,"ب",1,0],["وَلِمَجدِكُم خيطَت مَلابِسُ فَخرِها","فَبِغَيرِ نِعمَةِ طيبِكُم لا تَعبَقُ",3,"ق",1,0],["وَلِمَجدي قالَت مَعاليه أَرخ","لِلتَرقي مَحمود باشا عَميد",4,"د",1,0],["وَلمجدي قالَت مَعاليك أَرخ","للخديوي بمصر حسن قدوم",5,"م",1,0],["وَلِمَجدي إَقبالها قال أَرخ","أَقبَلت عصمة بِوَجه سَعيد",6,"د",1,0],["ولمجمعِ البحرين منا مُشفقٌ","من فَوز رُومي بِنيل مَرامِه",7,"م",2,0],["ولمجد يشكر سورة عادية","وأب اذا ذكروه ليس بخامل",8,"ل",1,0],["ولمجد الشرقِ عِزّاً","ذكره دوماً يطيب",9,"ب",1,0],["ولمجدِ إيريس التي ظَنُّوا بها","سرَّ الحياةِ وصحةَ الأبدانِ",10,"ن",1,0],["ولمجده قال الهنا","أرِّخ فخير الرسل أحمد",11,"د",1,0],["وَلمجدهِ سورٌ مهابتهُ فلا","تغتالهُ ايدي الحسودِ الماكرِ",12,"ر",1,0],["ولمجلس البلدية الزاهي اجتبى","إنسان عين أفضل الأعيان",13,"ن",1,0],["وَلِمَجْدِ طَبْنْتِنَا الْفُؤادُ يُكَبِّرُ","وَالْحُبُّ يرْقُصُ فِِي الوجُودِ يُعَبِّرُ",14,"ر",1,1],["ولمجده صفتان يدعى فيهما","بين الخليقة بالطريف الأتلد",15,"د",1,0],["[ وَلِمَجْدِكَ المَسْقُوفِ سَمْكٌ بَعْدَهُ","سَمْكٌ وَفِي نادِي الفَخارِ مَنارُ ]",16,"ر",1,0]]}