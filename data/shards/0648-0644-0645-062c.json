{"poems":[[51,"ألا قل لنحويك الأخفش","https://www.aldiwan.net/poem64923.html","المتقارب"],[45,"أنظر إلى العلياء كيف تضام","https://www.aldiwan.net/poem65657.html","الكامل"],[229,"شرى البرق فالتاع الفؤاد المعذب","https://www.aldiwan.net/poem51254.html","الطويل"],[235,"الدست من لألاء وجهك مشرق","https://www.aldiwan.net/poem31812.html","الكامل"]],"verses":[["ولمْ جئتَ أسودَ ذا حُلكةٍ","ولم تأتِ كالحية الأرقش",0,"ش",1,0],["وَلِمُجتَدٍ رَجَعَت يَداهُ بِلا جَداً","أَعيا عَلَيهِ البَذلُ وَالإِنعامُ",1,"م",1,0],["ولم جاء والطّيفَ المُعاوِد مَضْجَعي","معاً ومضى لمّا مضى المتأوِّب",2,"ب",1,0],["وَلِمَجدِكُم خيطَت مَلابِسُ فَخرِها","فَبِغَيرِ نِعمَةِ طيبِكُم لا تَعبَقُ",3,"ق",1,0]]}