{"poems":[[55,"أما آن للدمع أن يستجم","https://www.aldiwan.net/poem29769.html","المتقارب"],[95,"عمر قطعت مداه قبل أوان","https://www.aldiwan.net/poem11222.html","الكامل"],[99,"سألتك يا صخرة الملتقى","https://www.aldiwan.net/poem24403.html","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54819","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55117","الكامل"],[484,"ناشدتك الله في فتاك","https://www.aldiwan.net/poem36919.html","مخلع البسيط"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112450","المنسرح"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52031","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27695","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89414","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132128","البسيط"],[6056,"بركان المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=130135",""],[6142,"بديع كون تحلى بالوجود طلى","https://www.poetsgate.com/ViewPoem.aspx?id=155673",""]],"verses":[["أَلِلطَعنِ تُهتَكُ هَذي النُحورُ","وَلِلضَربِ تُكشَفُ هَذي القِمَم",0,"م",1,0],["أَللُّطْفُ فِي تَأْلِيفِه وَالظَّرْفُ فِي","تَصْرِيفه صِفَتَانِ بَيِّنَتَانِ",1,"ن",1,0],["أللطائرِ المفردِ الروحِ يمضي","يرودُ المواردَ عن مستقَى",2,"ق",2,0],["آلُ لُطْفِ اللهِ مَا زَالُوا عَلَى","عَهْدِهِمْ أَهْلَ المَقَامَاتِ الكِبَارِ",3,"ر",1,0],["أَللُّطْفُ لِلسُّفَراءِ خَيْرُ مُوَسَّطٍ","وَبِهِ يُسَهَّلُ شَأْنُهُمْ تَسْهِيلاَ",4,"ل",2,0],["اللطف منك سبى فؤادي","والبابليان مقلتاك",5,"ك",1,0],["اللطف في معناه","لطف النسيم الساري",6,"ر",2,0],["اللَّطْفُ حَفَّ وَكُلُّ حِينٍ يُطْلَبُ","وَلِمَنْ بِهِ نَيلُ الْمَطالِبِ أوْجَبُ",7,"ب",1,1],["اللطف من كرمي والعطف من شيمي","والمنع منعي كما الإحسان إحساني",8,"ن",2,0],["اللطف أنت محله","والبأس قد هد القوى",9,"و",2,0],["اللطف عند أناس عن مصانعةٍ","واللطف عندك عن ذوق وإحساسِ",10,"س",1,0],["اللطافة في سماء طبعك ، تحلق بإتزان","وتنثر ، مزون المحبة ، نوّها ، رشّة عطور",11,"ر",1,0],["أللطبيعة أم للجاذبية أم","للشهب أم لظلام الليل وابن جلا",12,"ل",2,0]]}