3100",""],[5956,"وحيدة حتى الموت","https://www.poetsgate.com/ViewPoem.aspx?id=183438",""],[5956,"يا ناشر الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=192511",""],[5956,"سيغرد القلب الحنونُ بعودتكْ","https://www.poetsgate.com/ViewPoem.aspx?id=193305",""],[5956,"شوقي إليك أيا سمير شديدُ","https://www.poetsgate.com/ViewPoem.aspx?id=194268",""],[5956,"قصائدي عفوية","https://www.poetsgate.com/ViewPoem.aspx?id=201542",""],[5956,"لماذا سُمِّي الصِّهرُ صهرا؟","https://www.poetsgate.com/ViewPoem.aspx?id=204009",""],[5956,"أخَّرْتُ في أغلى الصحاب قصائدي","https://www.poetsgate.com/ViewPoem.aspx?id=214991",""],[5957,"ماء الود","https://www.poetsgate.com/ViewPoem.aspx?id=215529",""],[5973,"أشعل من حوليَ أقمارَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=13769",""],[5974,"مواقد العشق","https://www.poetsgate.com/ViewPoem.aspx?id=200441",""],[6004,"الخَطِيئة","https://www.poetsgate.com/ViewPoem.aspx?id=59138",""],[6031,"لي إنْ تَحَامَاني أَخٌ وحَميمُ","https://www.poetsgate.com/ViewPoem.aspx?id=46275",""],[6070,"ما أجملَ الشِّعرَ حِينَ الرُّوحُ تَسْكبُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=197535",""],[6082,"لن نفترق","https://www.poetsgate.com/ViewPoem.aspx?id=60654",""],[5309,"جن الورى وطغت عليه همومه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573674",""],[6225,"سميرُ الصمت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80929&r=&rc=198",""],[6318,"القدس في خطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66164&r=&rc=14",""],[6318,"صِدْقُ الوَفَاءِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66153&r=&rc=3",""],[5190,"أبهَى قصائدِ شِعرِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78287&r=&rc=1",""]],"verses":[["مَا أَجْمَلَ الأَثَرَ الَّذِي خَلَّفْتَهُ","فِيهَا وَأَبْقَاهُ عَلَى الْحِدْثَانِ",0,"ن",1,0],["مَا أَجْمَلَ الصُّوَرَ الَّتِي تُجْلَى بِهِ","فِي أَبْهَجِ الأَنْوَارِ وَالأَلْوَانِ",1,"ن",1,0],["مَا أَجْدَرَ الشَّرَقَ أَنْ يَرَى قَبَساً","لاحَ إِخْرَاجِهِ مِنَ الظُّلْمِ",2,"م",1,0],["ما أَجوَرَ الدَهرَ عَلى بَنيهِ","وَأَغدَرَ الدَهرَ بِمَن يُصفيهِ",3,"ه",1,0],["ما أجور الأيام في إهمالها","حقِّي وأعدّ لها عن الصناف",4,"ف",1,0],["ما أَجَدَرَ الجُهَلاءِ أَن يَتَعَلَّموا","فَالعِلمُ مَصدَرُ هَيبَةً وَجَلالِ",5,"ل",1,0],["ما اجهل الليل وقد","خيم بالعواقب",6,"ب",1,0],["ما اجمل الشمس بدت","مرخية الذوائب",6,"ب",1,0],["ما اجهل الانسان في","دنياه بالعواقب",7,"ب",1,0],["ما اجمل الفن قد ارخى ذوائبه","وكوكب الفن منه النور ينبثق",8,"ق",1,0],["ما اجمل النجم الذي في ليلتي","يرنو الي من السماء ويشرف",9,"ف",1,0],["ما اجمل الليمون يحكى غادة","جلبابها بلآلئ مزدان",10,"ن",1,0],["ما أَجمَلَ الإيمانَ لَولا ضَلَّةٌ","في كُلِّ دينٍ بِالهِدايَةِ تُلصَقُ",11,"ق",1,0],["ما أَجدَرَ الأَيّامَ وَاللَيالي","بِأَن تَقولَ ما لَهُ وَما لي",12,"ل",2,1],["ما اِجتَرَمنا إِلَيكِ جُرماً وَلَكِن","حُبُّ هَذا الزَمانِ لَيسَ يَدومُ",13,"م",1,0],["ما اِجتَلَتهُ عَينُ التَأَمُّلِ إِلّا","رَجَعَت مِنهُ عَن جَمالٍ بَديعِ",14,"ع",1,0],["ما أَجْدَرَ النّاسَ باسْتِعظَامِ أَنْفُسِهم","وأَجْمَلَ الصَّمْتَ بالقوم المهاذيرِ",15,"ر",1,0],["ما أجزَلَ اللّهُ ذُخري قبل رؤيتِهِ","ولا انتَفَعْتُ بإيمانٍ وتوحيد",16,"د",1,0],["ما أَجَلي في أَجَلى حاضِرٌ","مِن بَعدِ ما جَرَّبتُ أَهلَ الجَريب",17,"ب",1,1],["ما أَجهَلَ الأُمَمَ الَّذينَ عَرَفتُهُم","وَلَعَلَّ سالِفَهُم أَضَلُّ وَأَتبَرُ",18,"ر",1,0],["ما اِجتماع يَكون بعد اِفتراقٍ","كاِفتراق يَكون بعد اِجتماعِ",19,"ع",1,0],["ما أجمل الوعد هذا","لو أن للوعد أصلا",20,"ل",2,0],["ما أَجمل الروض ترنو","أَزهاره في الصباح",21,"ح",1,0],["ما أَجمل الزوج يرنو","على يديها رضيع",22,"ع",1,0],["ما أجمل الهجرة بالأحرار","إن ضنّت الأوطان بالقرار",23,"ر",1,0],["ما أَجَلَّ الْحَيَاةَ أَجْنَتْ فَأغْنَتْ","بِالمَسَاعِي وَزكِّيَتْ بِالأيَادِي",24,"د",2,0],["مَا اجْتِرَائِي عَلَى الْوزِيرِ المُعَلَّى","بِعِظاتِي وَهْوَ الْحَكِيمُ البَصِيرُ",25,"ر",1,0],["مَا أَجْمَلَ الدَّهْرَ إِذْ يأْتِي وَأَرْبُعُنَا","حَقِيقَةُ الْفِعْلِ وَالذِّكْرَى بِتَمْجِيدِ",26,"د",1,0],["مَا أَجْمَلَ الْمُتَعَاهِدَيْنِ عَلَى الْهَوَى","مُتَكَافِئَينِ كَرِيمِيَ الأَنْسَابِ",27,"ب",1,0],["مَا أَجْمَعَ الأَحْبَارُ فِي انْتِخَابِهِ","إِلاَّ عَلَى المُقَدَّمِ الخَلِيقِ",28,"ق",1,0],["ما أَجوَدَ شِعرِي في خَبَبٍ","والشعرُ قليلٌ جَيِّدهُ",29,"د",2,0],["ما أجهل الإنسان يضني بعضه","بعضا ويشكو كلّ ما يضنيه",30,"ي",2,0],["ما أَجْمَلَ التَّوْفيقَ في شَرْخِ الصبَا","والعُمْرُ فَيَّاضُ السنَى بفَتائه",31,"ا",3,0],["ما أجملَ الكونَ لو صحّتْ بصائرُنا","وكيف نُبْصِرُ حُسْنَ الشيءِ باكينا",32,"ن",2,0],["ما أجمل الرتبَ الرفيعةَ موقعًا","في النفس إذ تُهدى إلى الأنداد!",33,"د",1,0],["ما اجتاز شرقيُّ عجاجة موجه","إلا وَعَاد مزودًا «بمدام»",34,"م",1,0],["ما أجمل الأرضَ والمحراثُ ينظمها","قصيدةً ذاتَ تقطيع وأوزان!",35,"ن",1,0],["ما اجْتَنى تَرنِيمَةً إِلاَّ شَدَا","هاكَ عِيدُ \"النَّحرِ\" يا قَلبي و\"فِصحَك\"",36,"ك",1,0],["ما اجتوائي وانقلابي عن مقامِ","لي ذنوبٌ كالشماريخِ العظام",37,"م",1,0],["ما اجتاز بعضكُمُ بأسرابِ المها","إلا اعترفن عليه مقلةَ جُؤذُرِ",38,"ر",1,0],["ما أجر من ذكر الإِله لأَنه","لم يلق ما ألهي ولا ما أَعجبا",39,"ب",2,0],["ما أجذَبت أرضٌ ودمعي فَوقها","يهمي فيملأها نباتا أخضرا",40,"ر",2,0],["ما أجمع الناس مذ كانوا على ملك","اجماعهم لك بالأمر الذي حصلا",41,"ل",2,0],["ما اِجتَدى قطُّ مِن سِواكم نوالاً","سيّءٌ مِن سواكمُ الإجتداءُ",42,"ا",2,0],["ما أجحد القلب إن لم","يحيّها بالسجود",43,"د",1,0],["ما أجودَ النِسْرِينَ لكنَّه","ذكَّرني منتزِحا لا يجودْ",44,"د",1,0],["ما أَجدَبَت أَرضٌ وَصَو","بَ نَداهُ مِن أَنوائِها",45,"ا",3,0],["ما أَجدَبَت أَرضٌ سَقا","ها صَوبُ نائِلِهِ الهَطولِ",46,"ل",1,0],["ما أَجدَبَت أَرضٌ حَلَلتَ بِها وَلا","بَخِلَ الزَمانُ وَأَنتُمُ أَجوادُهُ",47,"د",2,0],["ما أجملَ التغريدَ والطيرانا","والحبُّ يفتحُ مقلةً وجنانا",48,"ن",2,1],["ما اجمل الدنيا","في نظر الشاعر",49,"ر",1,0],["ما أَجْدَرَ الصَّالِحَ بِالوَاجِبِ","وَمَا أَحَقَّ السَّيْفَ بالضَّارِبِ",50,"ب",1,1],["مَا أَجْدَرَ الفَرْعَ بِسِرِّ أَصْلِه","وَأَخْلِقْ الشِّبْلَ بِأَخلاقِ الأَسَدْ",51,"د",1,0],["ما أَجر من صَلّى وَصامَ كَأجرِ مَن","أَحيا قَتيل الهَجر بَعدَ مَماتِهِ",52,"ه",1,0],["ما أجَلُ الهاربِ عنه هارباً","لا بل يَزيدُ طَلباً إذا هَرب",53,"ب",1,0],["ما أجمل الدنيا وأحلاها إذ",".صفت الرؤى وتكاتف الإخوان",54,"ن",1,0],["ما أجهلَ الإنسانَ بالد","نيا وأعجبَ أمرَه",55,"ه",1,1],["ما اجتمعنا للعتب إلا وكان ال","دلّ منها يزيد نفسي بلاها",56,"ا",3,0],["ما اجمل الدنيا بمن أحببتهم","وطن تعز به وشهم غيدق",57,"ق",1,0],["ما اجدر الإنسان باستع","لائه فوق الرمم",58,"م",1,0],["ما أجلبَ الدهرُ عليَّ بالأذى","إلاّ أصابَ منهُمُ مُعينا",59,"ن",2,0],["ما اجتزن بالآذان كنَّ مفاتحا","وعلى قلوب عداكُمُ أقفالا",60,"ل",2,0],["ما أجملتْ جملٌ ولم تنعم إذاً","نعمٌ ولم يسعد فعال سعاده",61,"د",2,0],["ما اِجتُرَّ رِزقٌ بِحِرصٍ","سِيّان مَشيٌ وَوَثْبُ",62,"ب",1,0],["ما أجهَلَ المرْءَ في الدُّنيا وأغفَلَهُ","ولا نُحاشي سُليمانَ بنَ دَاودِ",63,"د",1,0],["ما أجملَ الصبرَ لولا عادةٌ حَكَمَت","أن لا يكونَ جميلُ الصَّبرِ مِن عادي",64,"د",2,0],["ما اجتَمَعت أمَّة عَلى فَضل إنسا","نٍ إلاَّ وَقالَت بِفَضلِكَ الفِرَق",65,"ق",1,0],["ما اجتازها جذلان حتى هاله","جيش مبيد للطغاة مجيح",66,"ح",1,0],["ما أجهل الأب لو ربَّى ابنه ترفاً","ولم يكله لأستاذ وأظلَمَهُ",67,"م",2,1],["ما أجل الانصاف في كل حالٍ","ثوبه ثوب بذلة وجماله",68,"ه",1,1],["ما أَجمَل الشَّمسَ لمّا لِلغُروبِ دَنَت","وَحَولها الشَّفقُ المُحمرُّ كالعَنَمِ",69,"م",1,1],["ما أَجمَل الحسنَ على خُدودهِ","لا حُسنَ يَبدو مثلَ حسنِ الخدِّ",70,"د",1,1],["ما أَجمَلهُ مِن زُمرّد يَتَلالى","مِن فَوقِ نَضارَتهِ الجمالُ قَدِ اِنساب",71,"ب",1,0],["ما أجملَ اللهَ في عيْنٍ ترَاهُ بهَا","نوراً فتحويهِ إشراقاً ويحويهَا",72,"ي",3,0],["ما أجمل ذاتا وما أتمّ بهاء","ما أحسن قولا وما أميلحض أفعال",73,"ل",1,0],["ما أجاب الإله عبدا ذليلا","قام يدعوه بكرة وأصيلا",74,"ل",2,0],["ما أجاب الإله عبدا ذليلا","قام يدعوه في المسا والبكور",75,"ر",1,0],["ما أجحد القلب إن لم","يحيّيها بالسجود",76,"د",1,0],["ما أجدَّ الفتورُ لحظَكَ إلاَّ","وبلبّ اللبيب كان لعوبا",77,"ب",2,0],["ما اِجتَمَعَ الشَطرَنجُ في مَجلِسٍ","وَالنَردُ ذاتُ القيلِ وَالقالِ",78,"ل",1,1],["ما اِجتَمَعَ الشِطرَنجُ في مَجلِسٍ","وَالنَردُ إِلّا بَرَدَ المَجلِسُ",79,"س",1,1],["ما أجمل الصبر في ذُلِّ الغرام وما","أحلى رضا شادنٍ قلبي يناجيه",80,"ي",2,0],["ما أَجمعَتْ إِلاّ على تفضيله","بينَ البريَّةِ أَلسنُ الإِجماعِ",81,"ع",1,0],["ما