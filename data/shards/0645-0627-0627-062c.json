{"poems":[[93,"ألغرس غرسك أيها البستاني","https://www.aldiwan.net/poem11219.html","الكامل"],[93,"عمر قطعت مداه قبل أوان","https://www.aldiwan.net/poem11222.html","الكامل"],[93,"علمتنا بالمثال والقلم","https://www.aldiwan.net/poem11355.html","المنسرح"],[47,"ما العمر ماطالت به الدهور","https://www.aldiwan.net/poem24771.html","الرجز"],[72,"قاسي الجوانح لين الأعطاف","https://www.aldiwan.net/poem19257.html","الكامل"],[91,"ما للهموم الطارقات ومالي","https://www.aldiwan.net/poem62625.html","عموديه"],[89,"انظر إلى الكواكب","https://www.aldiwan.net/poem44667.html","مجزوء الرجز"],[89,"قد تبع القوم هوى","https://www.aldiwan.net/poem44668.html","مجزوء الرجز"],[89,"الفن روض أنيق غير مسؤوم","https://www.aldiwan.net/poem44743.html","البسيط"],[89,"في الفن معنى حسنه لا يعرف","https://www.aldiwan.net/poem44754.html","الكامل"],[89,"جاء الربيع وورد الرمان","https://www.aldiwan.net/poem44908.html","الكامل"],[85,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[43,"ما أجدر الأيام والليالي","https://www.aldiwan.net/poem10139.html","الرجز"],[44,"لا تصدي فالصد أمر عظيم","https://www.aldiwan.net/poem30108.html","الخفيف"],[44,"وبديع الجمال يضحك عن أض","https://www.aldiwan.net/poem30218.html","السريع"],[105,"ناد القبور وبشر كل مقبور","https://www.aldiwan.net/poem43053.html","البسيط"],[75,"أقوى المحصب من هاد ومن هيد","https://www.aldiwan.net/poem69092.html","الطويل"],[46,"ما أجلي في أجلى حاضر","https://www.aldiwan.net/poem22375.html","السريع"],[46,"أنا بالليالي والحواده أخبر","https://www.aldiwan.net/poem22560.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85470","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85839","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85591","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85579","المجتث"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54755","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54844","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54697","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54605","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55082","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142332","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54281","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[106,"تهنئة بوسام","https://www.poetsgate.com/ViewPoem.aspx?id=179504",""],[106,"قومي بين الشرق والغرب","https://www.poetsgate.com/ViewPoem.aspx?id=179442",""],[106,"المحراث","https://www.poetsgate.com/ViewPoem.aspx?id=179461",""],[100,"بيتٌ مِن الرِّيح","https://www.poetsgate.com/ViewPoem.aspx?id=183581",""],[126,"لا تلومني فمثلى لا يلام","https://www.aldiwan.net/poem50529.html","الرمل"],[140,"هو منزل النجوى بخالي الأعصر","https://www.aldiwan.net/poem58442.html","الكامل"],[158,"أهلا بما أنسى الذنوب المذنب","https://www.aldiwan.net/poem58813.html","الكامل"],[158,"قد أوعدتني بالزيارة في الكرى","https://www.aldiwan.net/poem58874.html","الكامل"],[158,"ما لي ارى الغاب عن وجه الهزبر خلا","https://www.aldiwan.net/poem59005.html","البسيط"],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[209,"مقطعات حسان","https://www.aldiwan.net/poem46612.html","المجتث"],[227,"أذكرني النسرين لما أتى","https://www.aldiwan.net/poem51153.html","السريع"],[233,"أهلا بطلعة زائر","https://www.aldiwan.net/poem31608.html","مجزوء الكامل"],[233,"لمن الركائب تستقي","https://www.aldiwan.net/poem31796.html","مجزوء الكامل"],[233,"لك ذروة البيت العتيق عماده","https://www.aldiwan.net/poem32098.html","الكامل"],[268,"ما أجمل التغريد والطيرانا","https://www.aldiwan.net/poem35183.html","الكامل"],[340,"في هدأة الفكر","https://www.aldiwan.net/poem55319.html","منهوك المنسرح"],[346,"ما أجدر الصالح بالواجب","https://www.aldiwan.net/poem19858.html","السريع"],[346,"لو وجد اللائم بعض ماوجد","https://www.aldiwan.net/poem20074.html","مجزوء الرجز"],[351,"يا لائمي بهوى الذي في ذاته","https://www.aldiwan.net/poem40557.html","الكامل"],[362,"أنصر أخاك مسعدا في ما حزب","https://www.aldiwan.net/poem60999.html","الطويل"],[397,"للحب قلب نابض","https://www.aldiwan.net/poem6705.html","عموديه"],[402,"ما أجهل الإنسان بالدنبا","https://www.aldiwan.net/poem49414.html","مجزوء الكامل"],[441,"يا رسولي اذهبا فأبلغاها","https://www.aldiwan.net/poem56061.html","الخفيف"],[447,"يزهو القريض به","https://www.aldiwan.net/poem972.html",""],[451,"حييت يا يوم العلم","https://www.aldiwan.net/poem61271.html","مجزوء الكامل"],[456,"جرت لها ببابلٍ يمينا","https://www.aldiwan.net/poem55838.html","الرجز"],[456,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[462,"هل هز بالأعطاف سمر صعاده","https://www.aldiwan.net/poem3623.html","عموديه"],[549,"زعازع ثم نكب","https://www.aldiwan.net/poem48102.html","الطويل"],[560,"لا تبك ميتا ولا تفرح بمولود","https://www.aldiwan.net/poem52979.html","البسيط"]],"verses":[["مَا أَجْمَلَ الأَثَرَ الَّذِي خَلَّفْتَهُ","فِيهَا وَأَبْقَاهُ عَلَى الْحِدْثَانِ",0,"ن",1,0],["مَا أَجْمَلَ الصُّوَرَ الَّتِي تُجْلَى بِهِ","فِي أَبْهَجِ الأَنْوَارِ وَالأَلْوَانِ",1,"ن",1,0],["مَا أَجْدَرَ الشَّرَقَ أَنْ يَرَى قَبَساً","لاحَ إِخْرَاجِهِ مِنَ الظُّلْمِ",2,"م",1,0],["ما أَجوَرَ الدَهرَ عَلى بَنيهِ","وَأَغدَرَ الدَهرَ بِمَن يُصفيهِ",3,"ه",1,0],["ما أجور الأيام في إهمالها","حقِّي وأعدّ لها عن الصناف",4,"ف",1,0],["ما أَجَدَرَ الجُهَلاءِ أَن يَتَعَلَّموا","فَالعِلمُ مَصدَرُ هَيبَةً وَجَلالِ",5,"ل",1,0],["ما اجهل الليل وقد","خيم بالعواقب",6,"ب",1,0],["ما اجمل الشمس بدت","مرخية الذوائب",6,"ب",1,0],["ما اجهل الانسان في","دنياه بالعواقب",7,"ب",1,0],["ما اجمل الفن قد ارخى ذوائبه","وكوكب الفن منه النور ينبثق",8,"ق",1,0],["ما اجمل النجم الذي في ليلتي","يرنو الي من السماء ويشرف",9,"ف",1,0],["ما اجمل الليمون يحكى غادة","جلبابها بلآلئ مزدان",10,"ن",1,0],["ما أَجمَلَ الإيمانَ لَولا ضَلَّةٌ","في كُلِّ دينٍ بِالهِدايَةِ تُلصَقُ",11,"ق",1,0],["ما أَجدَرَ الأَيّامَ وَاللَيالي","بِأَن تَقولَ ما لَهُ وَما لي",12,"ل",2,1],["ما اِجتَرَمنا إِلَيكِ جُرماً وَلَكِن","حُبُّ هَذا الزَمانِ لَيسَ يَدومُ",13,"م",1,0],["ما اِجتَلَتهُ عَينُ التَأَمُّلِ إِلّا","رَجَعَت مِنهُ عَن جَمالٍ بَديعِ",14,"ع",1,0],["ما أَجْدَرَ النّاسَ باسْتِعظَامِ أَنْفُسِهم","وأَجْمَلَ الصَّمْتَ بالقوم المهاذيرِ",15,"ر",1,0],["ما أجزَلَ اللّهُ ذُخري قبل رؤيتِهِ","ولا انتَفَعْتُ بإيمانٍ وتوحيد",16,"د",1,0],["ما أَجَلي في أَجَلى حاضِرٌ","مِن بَعدِ ما جَرَّبتُ أَهلَ الجَريب",17,"ب",1,1],["ما أَجهَلَ الأُمَمَ الَّذينَ عَرَفتُهُم","وَلَعَلَّ سالِفَهُم أَضَلُّ وَأَتبَرُ",18,"ر",1,0],["ما اِجتماع يَكون بعد اِفتراقٍ","كاِفتراق يَكون بعد اِجتماعِ",19,"ع",1,0],["ما أجمل الوعد هذا","لو أن للوعد أصلا",20,"ل",2,0],["ما أَجمل الروض ترنو","أَزهاره في الصباح",21,"ح",1,0],["ما أَجمل الزوج يرنو","على يديها رضيع",22,"ع",1,0],["ما أجمل الهجرة بالأحرار","إن ضنّت الأوطان بالقرار",23,"ر",1,0],["ما أَجَلَّ الْحَيَاةَ أَجْنَتْ فَأغْنَتْ","بِالمَسَاعِي وَزكِّيَتْ بِالأيَادِي",24,"د",2,0],["مَا اجْتِرَائِي عَلَى الْوزِيرِ المُعَلَّى","بِعِظاتِي وَهْوَ الْحَكِيمُ البَصِيرُ",25,"ر",1,0],["مَا أَجْمَلَ الدَّهْرَ إِذْ يأْتِي وَأَرْبُعُنَا","حَقِيقَةُ الْفِعْلِ وَالذِّكْرَى بِتَمْجِيدِ",26,"د",1,0],["مَا أَجْمَلَ الْمُتَعَاهِدَيْنِ عَلَى الْهَوَى","مُتَكَافِئَينِ كَرِيمِيَ الأَنْسَابِ",27,"ب",1,0],["مَا أَجْمَعَ الأَحْبَارُ فِي انْتِخَابِهِ","إِلاَّ عَلَى المُقَدَّمِ الخَلِيقِ",28,"ق",1,0],["ما أَجوَدَ شِعرِي في خَبَبٍ","والشعرُ قليلٌ جَيِّدهُ",29,"د",2,0],["ما أجهل الإنسان يضني بعضه","بعضا ويشكو كلّ ما يضنيه",30,"ي",2,0],["ما أَجْمَلَ التَّوْفيقَ في شَرْخِ الصبَا","والعُمْرُ فَيَّاضُ السنَى بفَتائه",31,"ا",3,0],["ما أجملَ الكونَ لو صحّتْ بصائرُنا","وكيف نُبْصِرُ حُسْنَ الشيءِ باكينا",32,"ن",2,0],["ما أجمل الرتبَ الرفيعةَ موقعًا","في النفس إذ تُهدى إلى الأنداد!",33,"د",1,0],["ما اجتاز شرقيُّ عجاجة موجه","إلا وَعَاد مزودًا «بمدام»",34,"م",1,0],["ما أجمل الأرضَ والمحراثُ ينظمها","قصيدةً ذاتَ تقطيع وأوزان!",35,"ن",1,0],["ما اجْتَنى تَرنِيمَةً إِلاَّ شَدَا","هاكَ عِيدُ \"النَّحرِ\" يا قَلبي و\"فِصحَك\"",36,"ك",1,0],["ما اجتوائي وانقلابي عن مقامِ","لي ذنوبٌ كالشماريخِ العظام",37,"م",1,0],["ما اجتاز بعضكُمُ بأسرابِ المها","إلا اعترفن عليه مقلةَ جُؤذُرِ",38,"ر",1,0],["ما أجر من ذكر الإِله لأَنه","لم يلق ما ألهي ولا ما أَعجبا",39,"ب",2,0],["ما أجذَبت أرضٌ ودمعي فَوقها","يهمي فيملأها نباتا أخضرا",40,"ر",2,0],["ما أجمع الناس مذ كانوا على ملك","اجماعهم لك بالأمر الذي حصلا",41,"ل",2,0],["ما اِجتَدى قطُّ مِن سِواكم نوالاً","سيّءٌ مِن سواكمُ الإجتداءُ",42,"ا",2,0],["ما أجحد القلب إن لم","يحيّها بالسجود",43,"د",1,0],["ما أجودَ النِسْرِينَ لكنَّه","ذكَّرني منتزِحا لا يجودْ",44,"د",1,0],["ما أَجدَبَت أَرضٌ وَصَو","بَ نَداهُ مِن أَنوائِها",45,"ا",3,0],["ما أَجدَبَت أَرضٌ سَقا","ها صَوبُ نائِلِهِ الهَطولِ",46,"ل",1,0],["ما أَجدَبَت أَرضٌ حَلَلتَ بِها وَلا","بَخِلَ الزَمانُ وَأَنتُمُ أَجوادُهُ",47,"د",2,0],["ما أجملَ التغريدَ والطيرانا","والحبُّ يفتحُ مقلةً وجنانا",48,"ن",2,1],["ما اجمل الدنيا","في نظر الشاعر",49,"ر",1,0],["ما أَجْدَرَ الصَّالِحَ بِالوَاجِبِ","وَمَا أَحَقَّ السَّيْفَ بالضَّارِبِ",50,"ب",1,1],["مَا أَجْدَرَ الفَرْعَ بِسِرِّ أَصْلِه","وَأَخْلِقْ الشِّبْلَ بِأَخلاقِ الأَسَدْ",51,"د",1,0],["ما أَجر من صَلّى وَصامَ كَأجرِ مَن","أَحيا قَتيل الهَجر بَعدَ مَماتِهِ",52,"ه",1,0],["ما أجَلُ الهاربِ عنه هارباً","لا بل يَزيدُ طَلباً إذا هَرب",53,"ب",1,0],["ما أجمل الدنيا وأحلاها إذ",".صفت الرؤى وتكاتف الإخوان",54,"ن",1,0],["ما أجهلَ الإنسانَ بالد","نيا وأعجبَ أمرَه",55,"ه",1,1],["ما اجتمعنا للعتب إلا وكان ال","دلّ منها يزيد نفسي بلاها",56,"ا",3,0],["ما اجمل الدنيا بمن أحببتهم","وطن تعز به وشهم غيدق",57,"ق",1,0],["ما اجدر الإنسان باستع","لائه فوق الرمم",58,"م",1,0],["ما أجلبَ الدهرُ عليَّ بالأذى","إلاّ أصابَ منهُمُ مُعينا",59,"ن",2,0],["ما اجتزن بالآذان كنَّ مفاتحا","وعلى قلوب عداكُمُ أقفالا",60,"ل",2,0],["ما أجملتْ جملٌ ولم تنعم إذاً","نعمٌ ولم يسعد فعال سعاده",61,"د",2,0],["ما اِجتُرَّ رِزقٌ بِحِرصٍ","سِيّان مَشيٌ وَوَثْبُ",62,"ب",1,0],["ما أجهَلَ المرْءَ في الدُّنيا وأغفَلَهُ","ولا نُحاشي سُليمانَ بنَ دَاودِ",63,"د",1,0]]}