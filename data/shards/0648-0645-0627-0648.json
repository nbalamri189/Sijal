www.poetsgate.com/ViewPoem.aspx?id=185460",""],[5411,"الشَّوْكَ المُذرّى","https://www.poetsgate.com/ViewPoem.aspx?id=186955",""],[5431,"فالق الشعر ...","https://www.poetsgate.com/ViewPoem.aspx?id=202794",""],[5442,"أرحها فقد مل الظلام سراها","https://www.poetsgate.com/ViewPoem.aspx?id=114763",""],[5582,"حَلِيفُ جَوَىً ما ناحَ يَوْماً حَمامُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=187264",""],[5689,"كم بذا بعاصمة الأنوار من لهب","https://www.poetsgate.com/ViewPoem.aspx?id=143425",""],[5691,"جيل الحروب","https://www.poetsgate.com/ViewPoem.aspx?id=205892",""],[5725,"رحيق الروح","https://www.poetsgate.com/ViewPoem.aspx?id=180108",""],[5725,"شمس الصبيحة","https://www.poetsgate.com/ViewPoem.aspx?id=185895",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5943,"الشعر في قدري","https://www.poetsgate.com/ViewPoem.aspx?id=34715",""],[5943,"القاتلُ المجنونُ","https://www.poetsgate.com/ViewPoem.aspx?id=61843",""],[5956,"لقاؤك يا بدور","https://www.poetsgate.com/ViewPoem.aspx?id=182189",""],[5956,"أعِنّا يا إله الناس","https://www.poetsgate.com/ViewPoem.aspx?id=192567",""],[5956,"الضحيَّةُ والمنقذ","https://www.poetsgate.com/ViewPoem.aspx?id=194198",""],[5976,"طفلة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=34669",""],[6031,"أَلا تَسْتنطقُ الدِمَنَ الخَوَالي","https://www.poetsgate.com/ViewPoem.aspx?id=46291",""],[6069,"سرى طيف الأحبة من بعيد","https://www.poetsgate.com/ViewPoem.aspx?id=105657",""],[6102,"حَبو","https://www.poetsgate.com/ViewPoem.aspx?id=182762",""],[6162,"مَا لمْ تَقلهُ المرَايْا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69309&r=&rc=2",""],[159,"أَيَا رَبْعَ صبري كَيف طاوعَك البلى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26935&r=&rc=6",""],[6186,"الأساطير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82886&r=&rc=6",""],[6194,"تضايقنا الدنيا ونحن لها نهب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52928&r=&rc=6",""],[5555,"راقصة الجاز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87419&r=&rc=14",""]],"verses":[["وَما وَضَعَتكَ حاضِنَةٌ وَلَكِن","تَمَطَّقَ فوكَ مِن لَبَنٍ لَئيمِ",0,"م",1,0],["وَما واثِقٌ بِالدَهرِ إِلاّ كَراقِدٍ","عَلى فَضلِ ثَوبِ الظِلِّ وَالظِلُّ يُسرِعُ",1,"ع",1,0],["وَما والِدٌ مِثلُ اِبنِ موسى لِمَولِدٍ","قَريبٍ تَجافاهُ الرَجالُ الأَباعِدُ",2,"د",1,0],["وَما وَجدُ أَدماءِ الإِهابِ مَروعَةٍ","لِأَحشائِها تَحتَ الظَلامِ وَجيبُ",3,"ب",1,0],["وَما واصَلَت إِلّا النُّحورَ رِماحُهُم","وَلا فارَقَتْ أَسيافُهُم قِمَمَ العِدا",4,"د",2,0],["وما وَفى ابنُكَ عبدُ اللهِ أَيْنُقَه","لمّا اطَّلَعْتَ عليها في مَراعيها",5,"ي",3,0],["وَما وَقى اِبنُكَ عَبدُ اللَهِ أَينُقَهُ","لَمّا اِطَّلَعتَ عَلَيها في مَراعيها",6,"ي",3,1],["وَما وَلَعي بِالراحِ إِلّا تَوَهُّمٌ","لِظَلمٍ بِهِ كَالراحِ لَو يُتَرَشَّفُ",7,"ف",1,0],["ومَأوىً لِأَبكَارٍ حِسَانٍ أَوَانسٍ","ورُبَّ فَتىً كالليثِ مُشتَهَرِ بَطَل",8,"ل",1,0],["وَمَآوٍ هِيَ الحَظَائِرُ لَوْلاَ","أَنَّ قُطْعَانَهَا تُسَمَّى أنَامَا",9,"م",2,0],["وما واللّه هجرك بإختياري","ولكن هكذا جرت الخطوب",10,"ب",1,0],["وما وَجَدَت ريح وأن قدتَنا وَحت","مَهَبّاً به إلا قُرىً وضياعا",11,"ع",2,0],["وَما وَجَدَ المُلوكُ أَعَزَّ مِنّا","وَأَسرَعَ مِن فَوارِسِنا اِستِلابا",12,"ب",2,0],["وما وجدت نساء بني نزار","حلائل أسودين وأحمرينا",13,"ن",2,0],["وَمَا وُجدَت بَنَاتُ بَني نزَارٍ","حَلاَئلَ أَسوَدين وأحمَرينَا",14,"ن",2,0],["وَما وَلَدَت أَفناءُ زُهرَةَ مِنكُمُ","كَريماً وَلَم يَقرَب عَجائِزَكَ المَجدُ",15,"د",1,0],["وما وفتك لطول المسهبات ثنا","فكيف نبغي وفاء الوعد بالوجز",16,"ز",1,0],["وَما وَجدتُ لِقَلبي راحَةً أَبَداً","وَكَيفَ ذاكَ وَقَد هُيّيتُ لِلكَدَرِ",17,"ر",1,1],["وما وجهُ استقائي من غديرٍ","وأنت البحرُ ذوالموج الغضوبِ",18,"ب",1,0],["وما وضعْته همةٌ دون مَفْخرٍ","ولكنها أعلتْه فوق المفاخرِ",19,"ر",1,0],["وما واحدٌ جاء من أمه","بأعجب من ناقدٍ أخفش",20,"ش",1,0],["وما وفائي بمدخولٍ إذا كَلَحَتْ","دهياءُ تفتَرُّ للأقوامِ عن عُصُلِ",21,"ل",1,0],["وَما وَجَدَت فيها قُرَيشٌ لِأَمرِها","أَعَفَّ وَأَوفى مِن أَبيكَ وَأَمجَدا",22,"د",2,0],["وما ورثت له عندى حبال","ولا ضاقت له عني ثياب",23,"ب",1,0],["وما وجدوا لمفسدة مجالا","ولكن تنبح القمر الكلاب",23,"ب",1,0],["وَما وُجِدَ اِشتِياقٌ كَاِشتِياقي","وَلا عُرِفَ اِنكِماشٌ كَاِنكِماشي",24,"ش",2,0],["وما وردنا الأبيض ذاك الذي","منه يكون الزرع والفرسُ",25,"س",1,0],["وماؤها يزخر في جوفها","ولأرض في هاوية ترسبُ",26,"ب",1,0],["وَما وَعَدَت وَشيكاً مِن نَوالٍ","فَنَطلُبَ عِندَها نُجحَ العِداتِ",27,"ت",1,0],["وَما وَجَبَت عَلَيَّ زَكاةُ مالٍ","وَهَل تَجِبُ الزَكاةُ عَلى جَوادِ",28,"د",1,0],["وَما وَلِيَ المَكارِمَ مِثلُ خِرقٍ","أَغَرَّ يَرى المَواعِدَ كَالدُيونِ",29,"ن",1,0],["وَما وَصيفٌ يَومَ وَصفي لَهُ","بِخامِلِ الذِكرِ وَلا دونِهِ",30,"ن",2,0],["وَما وُجِعَت أَزدِيَّةٌ مِن خِتانَةٍ","وَلا شَرِبَت في جِلدِ حَوبٍ مُعَلَّبِ",31,"ب",1,0],["وَما وَلَدَت بَعدَ النَبِيِّ وَأَهلِهِ","كَمِثلي حِصانٌ في الرِجالِ يُقارِبُه",32,"ب",2,0],["وَما وَلَدَت أُنثى مِنَ الناسِ مِثلَهُ","وَلا لَفَّهُ أَظآرُهُ في اللَفائِفِ",33,"ف",1,0],["وَما وَجَدَ الإِسلامُ بَعدَ مُحَمَّدٍ","وَأَصحابِهِ لِلدينِ مِثلَكَ راعِيا",34,"ي",2,0],["وما وَجَدْتُ عليلاً عنده أملي","فهو الكريمُ على العلّات لا هرمُ",35,"م",1,0],["وما ولدتْ سودُ المنايا وَحُمْرُهَا","عَلى الكرهِ حَتَّى كانَ صارِمُكَ الفحلا",36,"ل",2,0],["وَما وَفَدَ المَشيبُ عَلَيكَ إِلّا","بِأَخلاقِ الدَناءَةِ وَالوَضاعَه",37,"ع",2,0],["وما وصفُ الهزيلةِ مِنْ مرادي","ولستُ أريدُ إلا ذاتَ شحمِ",38,"م",1,1],["وما وحدي فُجعْتُ بهِ ولكنْ","لقدْ عمَّ البريَّةَ أجمعينا",39,"ن",2,0],["وما وَجَدْتُ إلى لُقْياكِ مُنْعَطَفاً","إلاّ إليكِ،ولا أَلْفَيْتُ مُفْتَرَقا",40,"ق",2,0],["وَما وَجِدَت وَجدي بِها أُمُّ واجِدٍ","وَلا وَجِدَ النَهدِيُّ وَجدي عَلى هِندِ",41,"د",1,0],["وما وادي الجحيمِ بِمُستطاعٍ","وإن عَزُبَتْ حُلومُ الغافلينا",42,"ن",2,0],["وَما وَقفَةٌ مِنكُم وَإِن طالَ حينُها","بِشافِيَةٍ ما يُعقِبُ النَأيُ وَالبُعدُ",43,"د",1,0],["وَما وَصلُكُم بِالرَثِّ يا سَلمَ فَاِنعِمي","صَباحاً وَلا بِالمُستَعارِ المُمَنَّحِ",44,"ح",1,0],["وما وَفى شُكري ببعض الذي","كَسَيْتَني من مَفْخَرِ الصِّدق",45,"ق",1,0],["وَما واهِنُ البَزلاءِ مِثلُ مُشَيَّعٍ","إِذا قامَ بِالجُلّى عَلَت وَتَجَلَّتِ",46,"ت",1,0],["وَما وَلَدوا إِلّا أَغَرَّ مُتَوَّجاً","لَهُ راحَةٌ تُبكي وَأُخرى تَحَلَّبُ",47,"ب",1,0],["وَما وَعظَتَكُم لَيلَةٌ بَعدَ لَيلَةٍ","وَلا ضَوءُ أَقمارٍ بَدَت وَشُموسُ",48,"س",1,0],["وَما وَجَدتُ مَنايا القَومِ مُغفِلَةً","شِبلاً بِغابٍ وَلا غَفراً بِإِشبيلا",49,"ل",2,0],["وَما وَجَدتُ صُروفَ الدَهرِ ناكِبَةً","عَن قانِتينَ لِوَجهِ اللَهِ داعينا",50,"ن",2,0],["وَما وَفَت لِخَليلٍ في مُعاشِرَةٍ","وَلا طَمِعنا لِخِلٍّ في تَوافيها",51,"ي",3,0],["وما وراءَ العُباب تَبْغي","وأيُّ سرٍّ لها تَبدّى",52,"د",2,0],["وَما وَجَدَت وَجدي بِها أُمُّ واحِدٍ","وَلا وَجَدَ النَهدِيُّ وَجدي عَلى هِندِ",53,"د",1,0],["وما وردتها من صدًى غير أنها","تريد بورد الماء حفظ المساحل",54,"ل",1,0],["وَما وَجَدْتُ أَخاً في الدَّهْرِ يَذكُرُنِي","إِذا سَمَا وعلا يَوْماً به الشَّانُ",55,"ن",1,0],["وَما وَلّى شُجاعُ الحَربِ إِلّا","وَبَينَ يَدَيهِ شَخصٌ مِن مِثالي",56,"ل",2,0],["وَما وَجَدَ الأَعادي فِيَّ عَيباً","فَعابوني بِلَونٍ في العُيونِ",57,"ن",1,0],["وما وَرَّدَتْ مِن أدمُعِي بمُورَّدٍ","وما خَلخلتْ مِن أضلُعي بمُخَلْخلِ",58,"ل",1,0],["وما وَقْفَتي بَيْن الرِّياضِ وقَدْ عَفَتْ","سِوَى حَاجَةٍ يَقْضي بها الْحَقَّ ناذِرُه",59,"ر",2,0],["وما وحَّد الجمعَ مثْلُ اللسانِ","ولا اتحد الجمعُ إلا غلب",60,"ب",1,0],["وما ورِث السيادةَ عَنْ جدودٍ","ولا شهر اسمَهُ عَمُّ وخال",61,"ل",1,0],["وما وهب الله من مكنة","فتلك محركة جامده",62,"د",2,0],["وما ورق الدنيا مراعي عزيمتي","اذا أمرعت روض الدنايا العزائم",63,"م",1,0],["وَمَا وَلَدَتْ أُمِّي مِنَ الْقَوْمِ عَاجِزَاً","وَلاَ كَانَ رِيشِي مِنْ ذُنَابِي وَلاَ لَغْبِ",64,"ب",1,1],["وما وفى لي ممّن كنت أوثرهم","إلاّ القبور وإلاّ الأيك والنّهر",65,"ر",1,0],["ومَا وَلَدَتْ أُنْثَى مِنَ النّاسِ مِثْلَهُ،","وَلا لعفّهُ أظْآرُهُ في اللّفائِفِ",66,"ف",1,0],["وما وفاني بمدخولٍ إذا كَلَحَتْ","دهياءُ تفترُ للأقوامِ عن عُصُلِ",67,"ل",1,0],["وما وجهُ استقائي من غديرٍ","وأنت البحرُ والموج الغضوبِ",68,"ب",1,0],["وما وقوفي عند بان نبتت","غصونه بين الضلوع والحشا",69,"ا",1,0],["وَما وَلَدَتكُم حَيَّةُ بنَةُ مالِكٍ","سِفاحاً وما كانت أحاديثُ كاذِبِ",70,"ب",1,0],["وَما وَحَياة الحُبِّ حُلْتُ عَن الَّذي","عَهِدْتَ وَلكن كلُّ شيءٍ إِلى انْتها",71,"ا",1,0],["وَما وَجدُ أَعرابِيّةٍ قَذَفَت بِها","صُرُوفُ النَّوى مِن حَيثُ لَم تَكُ ظَنَّت",72,"ت",1,1],["وما وجدي به عشقا ولكن","لطول العهد أحنح للذمام",73,"م",1,0],["وَما وَصلَت أرجاسهُ غير قومهِ","بهِ وَبِهم أَرجاسهُ حُصِرت حَصرا",74,"ر",2,0],["وَما وَدّعُوا إِلّا أُناساً كَمِثلِهِم","وَوَدّعت مِنكَ الغُصنَ وَالقمرَ البَدرا",75,"ر",2,0],["وما وجدتْ مثلي لها اليومَ شاعراً","أياديكَ تمليها عليَّ فأكتبُ",76,"ب",1,0],["وما وقفة العيد فيما رأيت","سوى وقفة تنهب العافيه",77,"ي",2,1],["وَما وَلَهى بِالبَرقِ إِلّا لِأَنَّهُ","يَمُرُّ بِسُعدى وَمضُهُ المُتَأَلِّقُ",78,"ق",1,0],["وَمَا وُقُوفُكَ في أطلالِ مَنزِلَةٍ","لَولا الَّذي استحدثَت في قَلبِكَ الكَلِفِ",79,"ف",1,0],["وَما وقوفي مَع الركبان في دمن","بالغور لا ناقَتي فيها وَلا جَمَلي",80,"ل",2,0],["وَما وزر المَغرور إِلا سَحابَة","تَظَلُّ قَلِيلاً ثُمَّ يضحَى عَلَى وَقدِ",81,"د",1,0],["وَمَا وَضَعَتْ مِنِّي الْخُطُوبُ بِقَدْرِ مَا","رَفَعْنَ وَقَدْ هَذَّبْنَنِي بِالتَّجارِبِ",82,"ب",1,0],["وَما وَجَدَت يَوماً كَوَجدي حَمامَةٌ","تُظَلِّلُها بَينَ الأَراكِ فُروعُ",83,"ع",1,0],["وَما وَثِقَت نَفسي بخلٍّ من الوَرى","أَكانَ صَديقاً أَم عدوّاً مُداجيا",84,"ي",2,0],["وَما وجدُ صادٍ أنضجَ الحرُّ جوفَه","بممنوعِ وردٍ إنْ دنا نحوه صدَّا",85,"د",2,0],["وَما وَسعتها للنفاقِ سهولُها","وَلا عَصَمتها مِن سطاكَ ريودها",86,"د",3,0],["وما وصلت نفس إلى عالم الصفا","بما دون تحصيل العلوم الجلية",87,"ه",1,0],["وَما وَرا رَقمِ كِتا","بي جِهَةِ الخَلفِ اِنبَذا",88,"ذ",2,0],["وَما وادَعتُ دَهرِيَ مُذ جَرَينا","عَلى سلم فَتوحِشني الحُروبُ",89,"ب",1,1],["وما وجهٌ يُذالُ إِليكَ يوماً","فَيَعرفُهُ الوَرى إِلا مَصُونا",90,"ن",2,0],["وما وَلَدُ الإنسانِ إلّا مضاعفٌ","وما ضِعفُهُ إلّا من البطن والقبر",91,"ر",1,0],["وما وَجَدْتُ في الهوى على الهوى","غير بكائي للأَسى مُعينا",92,"ن",2,0],["وما ولدت أُمُّ اللَّيالي بمثله","وإنَّ اللَّيالي لو نَظَرْتَ حبالى",93,"ل",2,0],["وما وَهَمْتُ ففي التلميذِ مَعْرِفَتي","حقًّا لأَنَّكَ معروفٌ بأُسْتَاذي",94,"ذ",2,0],["وما ولّيتُه إلا ثناءً","هديّتُه لمن يُهْدى هديُّ",95,"ي",1,0],["وما وافقت منها المنية غرة","ولكن رأت أن التأهب أرفق",96,"ق",1,0],["وما وقت الآمال عني نزول ما","خشيت من الأسوا وما دفعت عني",97,"ن",2,0],["وماؤك من فيض السماء وإن جرى","بأرض جعلت الماء صهباء في دن",97,"ن",1,0],["وما وجدت بغير الدين معركة","للعرب فيها على أعدائها الغلب",98,"ب",1,0],["وما وهب الوجود لنا سرورا","سوى الأحزان في اثواب أنس",99,"س",1,0],["وما وَحىُ موسى على طور سينا","ولا لوعةُ العالِم الحائرِ",100,"ر",1,0],["وما وأبى زخارفها ثناني","لها ذلٌّ يشوقُ ولا تثنِّي",101,"ن",2,0],["وما والذي أحيا بك الجودَ بعدما","لها الناسُ عنه واطمأنّوا إلى الثُكل",102,"ل",1,0],["وما وَهَى إلا غدا ممسكاً","منهم بثني الأحصفِ الأوثقِ",103,"ق",1,0],["وما وقفتُ لبدرٍ غاب أطلبه","جهلاً ولكن شفَتْ عيني مطالعُهُ",104,"ع",2,0],["وما ونداك ما هو أن أمرَّتْ","مريرةُ جفوتي إلا الوداعا",105,"ع",2,0],["وما وهنتْ فيما تُقلِّبُ دولةٌ","وأنتم لها إلا وفيكم جُبورُها",106,"ر",3,0],["وما ورقُ الغنى المنفوضُ عنّي","بمُعرٍ من حُسام المجدِ غِمدي",107,"د",2,0],["وماؤكم استشفيتُ زمزمَ بعده","فما بَرَدَتْ لُوحِي ولا رفَدتْ جُرحي",108,"ح",2,0],["ومأوَى كلِّ مُطَّدرٍ تُرامِي","به الأخطارَ أيدي النائباتِ",109,"ت",1,0],["وما وادعتُهُ منذ احتربنا","على سلْمٍ فتوحشَني الحروبُ",110,"ب",1,0],["وما وقْعُ أطرافِ الأسِنَّة والظُّبى","بأوجعَ من تقديم جهلٍ على عِلْمِ",111,"م",1,0],["وما وجدتُ وقد خاطبتُ أرسمَها","بعدَ الأحبَّةِ غيرَ الأورَقِ الهابي",112,"ب",2,0],["وَماؤُها يَحْكِي الْهَوَاءَ رِقَّةً","كما حَكَى ذَوْبَ اللُّجَيْنِ في الصَّببْ",113,"ب",1,0],["وما وطِئت أقدامُك الرَّبعَ ما حِلاً","من اليُمنِ إلا أعشَبَ الرَّوضُ واخضَّرا",114,"ر",2,0],["وَما وَسَمتُ قِلاصاً وَهيَ راتِعَةٌ","حَتّى أَتَت رَغمَ الأَقيادِ وَالعُقُلِ",115,"ل",1,0],["وما وَعدُهُ إلّا اِختلاجةُ خُلَّبٍ","وَإِلّا سرابٌ بالفلاةِ خَفوقُ",116,"ق",1,0],["وما وُعدتَ به خذْ","ومن يد الدّهرِ نقْدا",117,"د",2,0],["وما وِرْدُ مطرودٍ عن الوِرْدِ خامسٍ","له كَبِدٌ من شهوةِ الماءِ تُقرحُ",118,"ح",1,0],["وما ورع إلا عن الورع اقتفوا","وما منهمو إلا عن القنع قانع",119,"ع",1,0],["ومَا وجْهُكِ الوَجْهُ الذي غابَ في الثَّرَى","ولكنَّهُ البَدْرُ الَّذِي غابَ في الغَرْبِ",120,"ب",1,0],["وَما وَعَدنَكَ مِن شَرٍّ وَفَينَ بِهِ","وَما وَعَدنَ مِنَ الخَيراتِ تَضليلُ",121,"ل",1,0],["وما وُضِعَت لِشُربِ القَوم إلاَّ","رأيتَهُم وما سَكِروا سُكارى",122,"ر",2,0],["وَما وُصِمَت شَمسُ النَّهارِ وَما لَها","وَحاشاكَ وَصمٌ ما نُسِبتَ إلَى وَصمِ",123,"م",1,0],["وَما وَقَفُوا عِندَ لُعسِ الشِّفاهِ","وَبيضِ الخُدُودِ وَسُودِ الحَدَق",124,"ق",1,0],["وما وجدتُ سوى شُكري مكافأةً","وهل تُكلّفُ نفسٌ فوقَ ما تجدُ",125,"د",1,0],["وما وجدوه بغير مسير","فما كان مثلا لشعرى العبور",126,"ر",1,1],["وما وقع النجم من هول ما","قضته ولا قامت الغاشيه",127,"ي",2,0],["وما وفيت بوعد","وما رعيت زماما",128,"م",2,0],["وما وصلوا الأسباب إلا ليقطعوا","بنا سبب العيش الذي بات واهيا",129,"ي",2,0],["وما وُفِّرتْ أكياسُ قومٍ من الجوى","جوى الحزن إِلا كنتُ أوفرهُمْ كيسا",130,"س",2,0],["وَما وَسمَ البارودُ للضرِّ وَجهَه","وَقَد كانَ لِلبارودِ فيهِ فراسةُ",131,"ه",1,1],["وَماؤُها مِن حُسنِها لَمّا حَلا","أَرَّخته وَطيبُها يَروي الظّما",132,"م",2,0],["وما وَعدتُ وقَصدي خُلفُ مَوعِدِكُم","حاشايَ من ذاكَ مَعقولاً ومنقولا",133,"ل",2,1],["وما وَجناتُ الغيدِ يَبدو شُعاعُها","وَيَظهرُ في الظّلماءِ إِلّا كَواكبُ",134,"ب",1,0],["وما وصَلتم مُحِبّاً","يَودُّ يوماً لِقاكُمْ",135,"م",1,0],["وماؤها قد علا ص","فوَه القذا والغبار",136,"ر",1,0],["وما وُضِعَتْ بأقواسٍ هِجَانٍ","وكانتْ رَمْيَةً من غير رَامي",137,"م",2,0],["وَما وجد ظام حلّ في القيظ عالجاً","يقلبه ما بين رمضائه اللفح",138,"ح",1,0],["وماؤه غاض من بعد فيض","وجمره صار كالرماد",139,"د",1,0],["وما وردة في الروض كللها الحيا","وصافحها دون الورد نسيم",140,"م",1,0],["وما واردٌ ماءً بفيفاء صادياً","بأخيبَ مني حين جئتُك طالبا",141,"ب",2,0],["وما والج في مسمعي نُصحُ ناصح","ولا قابل قلبي لما هو قائل",142,"ل",1,0],["وما وجه فعلكم ذا به","لقد غَرّكُم بالإله الغرور",143,"ر",1,0],["وَما وَرا السود إِلّا السُدَّ تَفتَحُهُ","بِجَيشِ نَصرٍ لَهُ الأَقدارُ مِن مَدَدِ",144,"د",1,0],["وَما وجدت لَذيذ النوم بعدكمُ","إِلّا جَنى حنظل في الطَعم أَوصابِ",145,"ب",1,0],["وما ولعي بها الا لأني","اسلي النفس فيها عند ضيقي",146,"ق",2,0],["وماؤه الكوثري من فوق مرمره","يرى الكواكب تجلى مع ثرياها",147,"ا",3,0],["وماؤها ينساب كالصلال","بين الصخور الشم والتلال",148,"ل",1,0],["وماؤُهُ بادِّكارِ الرِّيقِ من قمرٍ","في خدِّهِ أبداً وردٌ وتُفَّاحُ",149,"ح",1,0],["وما وجدته وما أعدمته","وكل ما تقديره أجراه",150,"ه",1,0],["وما واثق باللّه فيما ينوبه","على حرج من أمره ومضيعه",151,"ه",1,0],["وَمَا وَرَدُوا غَيْرَ الحِمَامِ مَشَارِعاً","عَزِيزاً عَلَيْنا أَنْ يُبَاحَ نِهَالُهَا",152,"ل",3,0],["وَما وَجَدَ المُدّاحُ حينَ تَخَيَّروا","لِمَدحِهِم إِلّا أَبا الفَضلِ مَوضِعا",153,"ع",2,0],["وما وجدوا ذنباً لهُ غير انهم","أثاروا عليهِ الدهر والدهر جائرُ",154,"ر",1,0],["وما وجوهها نحوه عن وفادة","ولا نهزة يرجى بها خير مطمع",155,"ع",1,1],["وَما وَفَت بِعُهودِ المُستَعينِ وَلا","بِما تَأَكَّدَ لِلمُعتَزِّ مِن مِرَرِ",156,"ر",1,0],["وماؤكما العذب الذي لو وردته","وبي نافض حمّى إذا لشفاني",157,"ن",2,0],["وما وردوا من عذبه غير لامع","من الآل في بيدائها متريق",158,"ق",1,0],["وما ورثت من أمها غير حرة","محجبة في الأمهات بتول",159,"ل",1,0],["وما وعدوا يومَ الرحيل بعودة","فيبقى لمشتاق إلى القرب مطمع",160,"ع",1,0],["وَما وَعَظَ المَغرورَ مِثلُ غُرورِهِ","وَلا هَذَّبَ المَذمومَ إِلّا مَثالِبُه",161,"ب",2,0],["وَمَا وَمَضتن بالغورِ للرَّكبِ مَوهِناً","بُرُوقٌ تلَظَّى فِي الضُّلوعِ لها جَمرُ",162,"ر",1,0],["وَما وَطِئَتْ رِجلِي عَلَى غَيرِ شَائِكٍ","ولاَ قَبَضَتْ كَفَّايَ إلاَّ عَلَى رُمْحِ",163,"ح",1,0],["وما وخط المشيب أجل خطباً","على الإنسان من خطب الشعوب",164,"ب",1,0],["وما وسدتهم في الثرى غير صخرها","وما زودتهم للفراق سوى الرجم",165,"م",1,0],["وما وطئوا بالملك فهو محرمٌ","عليهم إذا ما أسلموا وتنصحوا",166,"ح",3,0],["وما وقت المصانع ذا رياش","وبابٌ دون خندقه وسورُ",167,"ر",1,0],["وما ودتني ولا انقادت الى قود","ولم ترق كارباب الارقاء",168,"ا",2,0],["وَما وَجَدَت وَجدي بِها أُمُّ واحِدٍ","عَلى النَأيِ شَمطاءُ القَذالِ عَقيمُ",169,"م",1,0],["وَما وَلَدَت مِن عامِرٍ عامِرِيَّةٌ","أَشَدَّ جَناناً مِنكَ وَالخَيلُ تُسرَجُ",170,"ج",1,0],["وما وسادته يحمي به عنقا","اذا استراح وشاء النوم ترفيها؟",171,"ي",3,0],["وَمَأوى ضَريكٍ أَتعَسَ الدَهرُ جَدَّهُ","وَأَمنُ طَريدٍ قَد نَفاهُ قَبيلُ",172,"ل",1,0],["وما وسعَ الرحمنَ إلا وجودنا","كأنا على العرشِ العظيم بنانا",173,"ن",2,0],["وما وقع التقسيم فيها وإنه","لمعنى يراه الناظرون سديد",174,"د",1,0],["وما ورثوها من أبيها وأثبتوا","حديثا نفاه الله في محكم الصحف",175,"ف",1,0],["وَما وَجَدتَ سَبيلاً","فَقِف عَلى عَرَفاتِ",176,"ت",1,0],["وَما وقوف اِمرئ هاجَت صَبابَتَه","سُفعُ المَلاطم من تَلويحِ نيرانِ",177,"ن",1,0],["وَما وَجدُ مشتاقٍ أصيبَ فؤادُهُ","أَخي شَهَواتٍ بِالعِناقِ نَسيقُ",178,"ق",1,0],["وما ولَعي بالسُّوقِ إلا لِكَي أرى","بَديعَ جمالٍ وفقَ ما لَمَعَ البَرقُ",179,"ق",1,0],["وما وَجَد الفتيان وَجْدي بزينب","قديما ولاَ ضلاّ كمثل ضلالي",180,"ل",2,0],["ومَا وِسَادي إلاَّ دُمْلجّ ويَدٌ","منها وما افترقا منّا فَمٌ وفَمُ",181,"م",1,0],["وَما وَجد الحَمامة مثل وَجدي","فَنغمتها غناء لا نواح",182,"ح",1,0],["وَما وَجَد الحُساد فيكَ مَقالة","فَقالوا زَعيم الهاشميين مسرف",183,"ف",1,0],["وَما وَجَدَتْ حُرثانُ مَجداً تُعِدُّهُ","إِذا نافَروا الأَقوامَ غَيرَ الأَباعِرِ",184,"ر",1,0],["وَماؤُكِ وَهُوَ في الرضراض يَجري","لُجين قَد تَدفَّق في الحَدائق",185,"ق",1,0],["وماؤك لا ماء العذيب الذي هوى","وذي ظماءٍ منه على كبد برد",186,"د",1,0],["وَمَاؤُهَا يُشبِهُ مَا كَمبَايَه","فَإفهَمِ الدُّخول بِذي الحِكَايَه",187,"ه",1,0],["وما وردت يداكَ مُنًى ظماءً","لهم إِلاَّ وقد صدرت نِهالا",188,"ل",2,0],["وَما وَاحد في الناس يُبدي تَلَفاً","عَلَيكَ وَلَكن زودك بِأَسهُم",189,"م",1,0],["وَما وارِدُ البَحرِ المُحيطِ كَلاجئٍ","إِلى ثَمَدٍ نَزرِ البَلالَةِ غَيّاضِ",190,"ض",1,0],["وَماؤُهُ يُسَكِّنُ الحرَارَه","وَالغَشَيَانُ شَمُّه إطَارَه",191,"ه",1,0],["وما وَصلنا الاَّ اجتماع لفرقةٍ","نودع بدراً آفلاً إثر آفلِ",192,"ل",1,0],["وما وضعوا فرشا له فازدرى به","وقد نام في الغبرا على اثره فاجرى",193,"ر",2,0],["وما ولما ثم إما كلا","لولا ولوما ثم إلا هلا",194,"ل",2,0],["وما وصلكم الا الثمال لهالك","ولا هجركم الا السمام المثمَّلُ",195,"ل",1,0],["وماؤُها السَّلسَبيلُ العَذبُ باكَرَهُ","ريحٌ هُوَ المسكُ أنفاسٌ فأنفاسُ",196,"س",1,0],["وما وقّع الشعر إحساسهم","ولحن ملحنه فاتر",197,"ر",1,0],["ومأواكم خص العوازم ذو الأذى","كبير به كرب العيون القريرة",198,"ر",2,0],["وما وارتِ الأيّام نصلكَ في الثرى","وما زال بعد الموت يسطو ويقطعُ",199,"ع",1,0],["وما ودّعوا فرداً بفقدك إنّما","منار العلا والعزّ في مصر ودّعوا",199,"ع",3,0],["وما وعدهم إلا سراب بقيعة","وما عهدهم إلا مداد بقرطاس",200,"س",1,0],["وما وفى بما عليه اشترطا","عن قدرة معتمدا لا عن خطا",201,"ط",2,0],["وَما وَصلُها إِلّا كَشَيءٍ رُزيتَهُ","إِذا اِختَلَسَتهُ مِن يَدَيكَ الخَوالِسُ",202,"س",1,0],["وما ونت عزمة الجند الذين إذا","ما صاح باسمك فيهم غالب غلبوا",203,"ب",3,0],["وما وجه ذي الوجهين واللَه عالم","وما تعب الأجساد والقصد حائر",204,"ر",1,0],["وَما وَجدُ مَسجون بِصنعاءَ موثقٍ","بِساقيهِ مِن حبسِ الأمير كبولُ",205,"ل",1,0],["وما وردها والنرجس الغض نائباً","عن الوجنة الحمراء والمقلة الوسنى",206,"ن",2,0],["وَمَا وُدِّى لأول من تَرَاهُ","صقيل البشْر مَعْمُورَ النَّواحي",207,"ح",2,0],["وما وجدَ الأعْداءُ عهدَكَ خائِناً","وعقدَكَ إلاّ وهو يُعْقَدُ بالحَلِّ",208,"ل",1,0],["وما ورْدُها عذبٌ إذا لمْ يَبِنْ لها","على كثَبٍ بانُ العُذَيْبِ ورَنْدُهُ",209,"د",2,0],["وما وردت من سواه العطا","ش غبوقاً بلا رنق واصطباحا",210,"ح",2,0],["وما وجدت صفيةٌ من خطوبٍ","عدت تهمي كقطرٍ من غمام",211,"م",1,0],["وَما واكفاتُ السحبِ يَحملُها الهَوا","بِأَوكفَ من دَمعي عَلى دارِ صَبوتي",212,"ي",1,0],["وما وجدنا الإنسان إلا","مقيد الخطو لا يقرّ",213,"ر",1,0],["وَما وَشى الطِرسَ تَنميقُ اليَراع بِما","يُزري بِوَشي الرُبا بِسّامة الزَهرِ",214,"ر",1,0],["وما وصله الأحياتي وإنني","إذا ما جفا يوماً تواريت في لحدي",215,"د",2,0],["وَما وارِثُ الأَملاكِ غَيرُ أَخي وَغىً","أَفاضَ يَداً يَقوا الأَنامَ حُسامُهُ",216,"م",2,0],["وما ونت أمة عن درك طلبتها","ما بال مصر تقاسى الذل ألوانا",217,"ن",2,0],["وماؤها سلسبيل ساغ مورده","وعينها من صفاء الماء زرقاء",218,"ا",2,0],["وما وهى أحد في ملتقى أحد","ولا ثناه عن التجديل مجدول",219,"ل",1,0],["وما ونوا في امتثال الأمر أو وهنوا","يوما ولا أردوا في الأمر إروادا",220,"د",2,0],["وَما وَهَبَت إِلّا اِستَرَدّت هِباتها","وَجَدوى اللَّيالي إن تَحقَّقتها سَلبُ",221,"ب",1,0],["وَما وقي الرّدى بِطعانِ سُمرٍ","وَشَدِّ سَوابقٍ وَقِراعِ بيضِ",222,"ض",1,0],["وما ولدتني أم فتى","حشاك لفطرقل قد فتتا",223,"ت",2,0],["وما وقف التفتحُ لولا الشقاقُ","بصفين والمعركاتِ الأخر",224,"ر",1,0],["وما وجدت كوجدي من غرامي","لقد ناح الحمام على حمام",225,"م",1,0],["وما ونى واحد عن واحد فهما","كالفرقدين خلال الأنجم الزهر",226,"ر",1,0],["وما ورقاء أيك ذات نوح","على فرخ يلم به الحمام",227,"م",1,0],["وما وجدتُ الصِّبا في طُول صُحبتِه","إِلاّ كما لَبِس الجفنُ الكَرى ونَضَا",228,"ض",2,0],["وما وفى معهم من غيرهم أحد","ألفا وما خذلوا عنهم ولا نكبوا",229,"ب",3,0],["وَما وحدة الساعي بمجدية لَهُ","وَإِن لَم يُعاود ناظريه هجوع",230,"ع",1,0],["وَما وَهموا فيهِ الزَمان وَلَم يَزَل","يُقدس مِن رَحمانه العلم وَالجَهل",231,"ل",1,0],["وما وشت بنقشها الأقلام","محبر الأوراق والسلام",232,"م",1,0],["وما ولاتَ ولا للاسم رافعةٌ","وما يزال اسمُ لاتَ الدهرَ مكتتما",233,"م",2,0],["وما وقفوا له عن أثر","ما عدا الأماني تبدي الاتساع",234,"ع",1,0],["وَماؤُها سَرابُ","وَبَرقُها خَلّابُ",235,"ب",1,0],["وما وَجدُ أظَآرٍ ثلاث روائمٍ","أصبَنَ مجَراً من حوار ومَصرعَا",236,"ع",2,0],["وما وعت مهجة أفلاذ جذوته","إلا ومقابسها اثناءها لذعا",237,"ع",2,0],["وما ومى لمطمح الا رنت","إليه عين العز من حيث رنا",238,"ا",1,0],["وما واعظيها قيل بل موعظينها","ومن قال أدوّا دون ودّوا مكابر",239,"ر",1,0],["وما والله رنات المثاني","باطرب من ثناه للشجينا",240,"ن",2,0],["وگمْ أُؤَمِّلُ في إبقاء غَانِيَةٍ","على العُهُودِ فيأبى طَبْعُها الزَّاني",241,"ي",1,1],["وما واعدهما في الليل سرا","فتاج المرء في الدنيا الحياء",242,"ا",2,0],["وما وقوفي في صفوفي غدا","يمنع عن ذكر ولا شكر",243,"ر",1,0],["وما وعدت ليلى ومنت ولم يكن","لراجي المنى من ودهن نصيب",244,"ب",1,0],["وما وافت حنيفة مصطفاها","فقلت مؤرخاً بالخير تما",245,"م",2,0],["وماودّي اسمع عن المطيور","اللي سكن داخل اوزاني",246,"ن",2,0],["وما وضع الله من قدرها","(وأسمى قواعد أركانها)",247,"ن",3,0],["وما ولدتك الأم في الأرض حائرا","وها أنت ملتاع حزين وخائف",248,"ف",1,0],["ومأوى السحا فقد السحاء","خرابه وكم ذي دلى لم تغن عنه دلاء",249,"ا",2,0],["ومَا وجَدْتُ كطَعْمِ النَّصْرِ حنظلَةً","يشقَى بِهَا أهلُها إِنْ حفَّهُ الضَّرَرُ",250,"ر",1,0],["وما واصل الحسناء غير مقبلٍ","كأن عناق الخد قد كان موعدا",251,"د",2,0],["وما وجه باريسٍ وإن شاق حسنه","يعوّض عندي وجهه المتواريا",252,"ي",2,0],["وَمَاْ وَجَعَ الْأَمَاْجِدَ طَعْنُ رُمْحٍ","وَلَكِنْ رِدَّةَ التَّاْرِيْخِ فِيْنَاْ",253,"ن",2,0],["وَ مَا واللهِ مَا آتيتَ نُكْرًا","فَمَا سُؤلٌ لِمُنْكِرَ أَوْ نَكِيرِ",254,"ر",1,0],["وما وجعُ الأشعارِ إلا انتكاسةٌ","تُوَشْوِشُ في صمتٍ فيجري انذرافُها",255,"ف",3,1],["وما وردة في الروض كللها الحيا","وصافحها دون الورود- نسيمُ",256,"م",1,0],["وما وجدتُ سوى قلبِ الثرى عطِشاً","وفيه محضَ انتظارٍ أذهلَ البصرا",257,"ر",2,0],["وما وصلتُ إلى منفاكِ سيدتي","لكنني سأعيشَ العمرَ منتظرا",257,"ر",2,0],["وما وصل البطيء وفي خطاه","خمول ليس يشبهه خمول",258,"ل",1,0],["وما وهبْتَ لحقٍّ لسْتَ تملُكُه","وكان سفْكُ دمي في البَرِّ مشهودا",259,"د",2,0],["وما ورَقٌ عليكم فوقَ سوْءةْ","تُهانُُ القدسُ ما فيكم مروءةْ",260,"ا",2,1],["وما ولولتْ لكنْ دوائرُها غوتْ","فهمَّتْ وما همَّ القريبُ. دخولُ",261,"ل",1,0],["وما وردوا إلا على منهل الردى","أذيبت بحر الطعن أفئدة حسرا",262,"ر",2,0],["وَما وَسِعَتْ بِلادٌ سَيْلَ شِعْري","وَما وَسِع َالكَلامُ وَلا السُّطُورُ",263,"ر",1,0],["وَما وَجَع الأَحِبَّة غَيْر غَدْرٍ","كذلك قَدْ أحَطْتُ عَلَيْكَ خُبْرا",264,"ر",2,0],["وما ومضة الأفكار إلا تيقنٌ","بأجواء تغييرٍ -مع الودق- بارقُ",265,"ق",1,0],["وما وضحت شمس الضحى في نهارها","وما لاح بدر في الدجى وتلاها",266,"ا",3,0],["وَما وَعْدُها إِلاَّ كَظِلِّ كَنَهْوَرٍ","تَقَشَّعَ عَنْهُ غَيْمُهُ وَجَهامُهُ",267,"م",2,0],["وما وجدونا سوى لاهي بنعمته","ونحن نقضي ضحايا الجوع والسغب",268,"ب",1,0],["وما وَعى عُرُشَ الأعْنابِ شامِخَةً","بيْنَ الكُرومِ كُنوزاً رَوْقَةَ النَّضَدِ",269,"د",1,0],["وما وَعى سامِرَ الأجْدادِ يجْمَعُهُمْ","على البَيادِرِ حوْلَ الغَلَّةِ الحَصَدِ",269,"د",1,0],["وما وجدوا في الجسم غير نحوله","وفيح من الحمّى حرورا لعوّدي",270,"د",2,0],["وما واليت قلباً في غرام","سوى قلبٍ بحبك قد تولّى",271,"ل",2,0],["وما وصلت أفكارها لمقاصد","لديك ريت في التربيات لملتي",272,"ت",2,0],["وما وطىء الأفلاك إلا لتستفض","بأرواحها روح الترقي المديدتي",272,"ت",2,0],["ومَا وضعت ُ لهُ هاماً بما يَلقى","مِنْ مُحْدَثاتٍ بهَا الآلامُ تَخنقُني",273,"ن",2,0],["وما وجدتُ بجيبِ نفسي غيرَ حز","نٍ وامتعاضٍ، واشتعالٍ، واكتئابْ",274,"ب",1,0],["وما واصَلْتِني بمُهاتفاتٍ","تتيح إليَّ لو يوماً أزورُ",275,"ر",1,0],["وما وحشية فينا ستبقى","إذا أسقيتنا الماء المعَمَّدْ",276,"د",1,0],["وما وُسعي سوى وُسعٍ ضئيلٍ","وأعجز أن أفيد.. وأن أعيرا",277,"ر",2,0],["وما ودّي تبحث في خفانا الشياطين","وانّي عليك اخشى من الحاسديني .. !!",278,"ن",2,0],["وما واروهُ فيها من جَميلٍ","بهِ يُبْكَى عَلَيهِ ومن جَمَالِ",279,"ل",1,0],["وما وادٍ كأن يد الغوادي","كسته قلائد الدر النضيد",280,"د",1,0],["وَما وَجَدتُ- بِتَجدِيدِي- سِوَى زَمَنٍ","فِي الصُّبحِ أَنكَرَ, لَكِن فِي الدُّجَى استَلَبا",281,"ب",2,0],["وماؤنا آسنٌ .. إقذف به حجرًا","فربما يستجيب الغيث والديمُ",282,"م",1,0],["وَ ما وَ حياة ِ الحبَّ حلتُ عن الذي","عَهِدْتَ ولكنْ كُلُّ شَيْءٍ إلى کنْتها",283,"ا",1,0],["وما وطأتُ بها رملاً ولا حجراً","إلا تحول ألماساً بتعبيري",284,"ر",2,0],["وما وهبت إلا استسردت هباتها","وجدوي الليالي أن تحققتها سلب",285,"ب",1,0],["وما وشوشَ الطفلُ أغنيَّةً","لدُمْيتهِ بينَ ( دَا دَا ) و( غَا )",286,"غ",2,0]]}