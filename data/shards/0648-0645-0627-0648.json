{"poems":[[53,"أبا مطر وجذمك من معد","https://www.aldiwan.net/poem29789.html","الوافر"],[53,"يقولون ماش الدهر من حيث ما مشى","https://www.aldiwan.net/poem30087.html","الطويل"],[53,"نصافي المعالي والزمان معاند","https://www.aldiwan.net/poem30627.html","الطويل"],[53,"سما كبطون الأتن ريعان عارض","https://www.aldiwan.net/poem30703.html","الطويل"],[63,"أعد نظرا هل شارف الحي ثهمدا","https://www.aldiwan.net/poem45830.html","الطويل"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[86,"وما وقى ابنك عبد الله أينقه","https://www.aldiwan.net/poem68916.html","البسيط"],[73,"أما في نسيم الريح عرف معرف","https://www.aldiwan.net/poem11914.html","الطويل"],[0,"لمن طلل بين الجدية والجبل","https://www.aldiwan.net/poem84.html","الطويل"],[93,"أيها البالغ الثريا مقاماً","https://www.aldiwan.net/poem11412.html","الخفيف"],[88,"بدت كالشمس يحضنها الغروب","https://www.aldiwan.net/poem45008.html","الوافر"],[88,"لقد طوحتني في البلاد مضاعا","https://www.aldiwan.net/poem45009.html","الطويل"],[27,"أقلي اللوم عاذل والعتابا","https://www.aldiwan.net/poem5686.html","الوافر"],[37,"الا حييت عنا يا مدينا","https://www.aldiwan.net/poem7642.html","الوافر"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[23,"لقد علم الأقوام أن ابن هاشم","https://www.aldiwan.net/poem21487.html","الطويل"],[72,"قد أمكنت فرص اللذات فانتهز","https://www.aldiwan.net/poem18999.html","البسيط"],[64,"وما وجدت لقلبي راحة أبدا","https://www.aldiwan.net/poem67638.html","البسيط"],[51,"أسالم قد سلمت من العيوب","https://www.aldiwan.net/poem8313.html","الوافر"],[51,"يضن أبو عيسى علينا بقطنة","https://www.aldiwan.net/poem62850.html","الطويل"],[51,"ألا قل لنحويك الأخفش","https://www.aldiwan.net/poem64923.html","المتقارب"],[51,"لا زلت تبلغ أقصى السؤل والأمل","https://www.aldiwan.net/poem65993.html","البسيط"],[29,"صحا القلب إلا من ظعائن فاتني","https://www.aldiwan.net/poem6052.html","الطويل"],[85,"على قدر الهوى يأتي العتاب","https://www.aldiwan.net/poem6820.html","الوافر"],[43,"مبيتي من دمشق على فراش","https://www.aldiwan.net/poem9714.html","الوافر"],[62,"ميقات موسى يوم تدبيرنا","https://www.aldiwan.net/poem52172.html","السريع"],[62,"قد كانت الأفلاك في بدئها","https://www.aldiwan.net/poem52238.html","السريع"],[45,"نصيبي منك لوم العاذلات","https://www.aldiwan.net/poem62649.html","الوافر"],[45,"أقول له وقد أغرى بلومي","https://www.aldiwan.net/poem63540.html","الوافر"],[45,"بعينك لوعة القلب الرهين","https://www.aldiwan.net/poem66785.html","الوافر"],[45,"عند ظباء الرمل أو عينه","https://www.aldiwan.net/poem66816.html","السريع"],[28,"لولا يدا بشر بن مروان لم أبل","https://www.aldiwan.net/poem1236.html",""],[28,"أبوك وعمي يا معاوي أورثا","https://www.aldiwan.net/poem1269.html",""],[28,"بنات المهاري الصهب كل نجيبة","https://www.aldiwan.net/poem5323.html","الطويل"],[28,"لعمري لقد نبهت يا هند ميتا","https://www.aldiwan.net/poem5649.html","الطويل"],[80,"يمضي لك السيف ما تنويه والقلم","https://www.aldiwan.net/poem31288.html","البسيط"],[80,"أغمر الهوى كم ذا تقطعني عذلا","https://www.aldiwan.net/poem31329.html","الطويل"],[44,"أعتبة إن تطاولت الليالي","https://www.aldiwan.net/poem30024.html","الوافر"],[69,"وما وصف الهزيلة من مرادي","https://www.aldiwan.net/poem28200.html","الوافر"],[69,"دعاني بعدكم قوم وقالوا","https://www.aldiwan.net/poem28631.html","الوافر"],[90,"شممت تربك لا زلفى ولا ملقا","https://www.aldiwan.net/poem60156.html","عموديه"],[33,"تعلق روحي روحها قبل خلقنا","https://www.aldiwan.net/poem25949.html","الطويل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"قفوا ساعة إن المحب له عهد","https://www.aldiwan.net/poem43161.html","الطويل"],[39,"ألا أيها الليل الطويل ألا أصبحي","https://www.aldiwan.net/poem53802.html","الطويل"],[75,"أحين ولت أنجم الأفق","https://www.aldiwan.net/poem69057.html","السريع"],[50,"تخليت من صفراء لا بل تخلت","https://www.aldiwan.net/poem64748.html","الطويل"],[50,"أصفراء ما في العيش بعدك مرغب","https://www.aldiwan.net/poem64815.html","الطويل"],[46,"ترومون بالناموس كسبا فسعيكم","https://www.aldiwan.net/poem22826.html","الطويل"],[46,"دع آدما لا شفاه الله من هبل","https://www.aldiwan.net/poem23166.html","البسيط"],[46,"رب الجواد فرى عينا لمأكله","https://www.aldiwan.net/poem23480.html","البسيط"],[46,"إني لمن آل حواء الذين هم","https://www.aldiwan.net/poem23575.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[32,"","https://poetry.dctabudhabi.ae/diwan/poem/8238","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16630","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30497","البسيط"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9965","الوافر"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9991","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43881","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54279","الطويل"],[106,"تحيْة الرسالة","https://www.poetsgate.com/ViewPoem.aspx?id=179503",""],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[13,"وَمَا وَلَدَتْ أُمِّي مِنَ الْقَوْمِ عَاجِزَاً","https://www.poetsgate.com/ViewPoem.aspx?id=180803",""],[28,"لقد كنت أحيانا صبورا فهاجني","https://www.poetsgate.com/ViewPoem.aspx?id=16950",""],[51,"لازلتَ تبلغُ أقصى السُؤْلِ والأملِ","https://www.poetsgate.com/ViewPoem.aspx?id=30336",""],[51,"أسالمُ قد سلمتَ من العيوب","https://www.poetsgate.com/ViewPoem.aspx?id=27041",""]],"verses":[["وَما وَضَعَتكَ حاضِنَةٌ وَلَكِن","تَمَطَّقَ فوكَ مِن لَبَنٍ لَئيمِ",0,"م",1,0],["وَما واثِقٌ بِالدَهرِ إِلاّ كَراقِدٍ","عَلى فَضلِ ثَوبِ الظِلِّ وَالظِلُّ يُسرِعُ",1,"ع",1,0],["وَما والِدٌ مِثلُ اِبنِ موسى لِمَولِدٍ","قَريبٍ تَجافاهُ الرَجالُ الأَباعِدُ",2,"د",1,0],["وَما وَجدُ أَدماءِ الإِهابِ مَروعَةٍ","لِأَحشائِها تَحتَ الظَلامِ وَجيبُ",3,"ب",1,0],["وَما واصَلَت إِلّا النُّحورَ رِماحُهُم","وَلا فارَقَتْ أَسيافُهُم قِمَمَ العِدا",4,"د",2,0],["وما وَفى ابنُكَ عبدُ اللهِ أَيْنُقَه","لمّا اطَّلَعْتَ عليها في مَراعيها",5,"ي",3,0],["وَما وَقى اِبنُكَ عَبدُ اللَهِ أَينُقَهُ","لَمّا اِطَّلَعتَ عَلَيها في مَراعيها",6,"ي",3,1],["وَما وَلَعي بِالراحِ إِلّا تَوَهُّمٌ","لِظَلمٍ بِهِ كَالراحِ لَو يُتَرَشَّفُ",7,"ف",1,0],["ومَأوىً لِأَبكَارٍ حِسَانٍ أَوَانسٍ","ورُبَّ فَتىً كالليثِ مُشتَهَرِ بَطَل",8,"ل",1,0],["وَمَآوٍ هِيَ الحَظَائِرُ لَوْلاَ","أَنَّ قُطْعَانَهَا تُسَمَّى أنَامَا",9,"م",2,0],["وما واللّه هجرك بإختياري","ولكن هكذا جرت الخطوب",10,"ب",1,0],["وما وَجَدَت ريح وأن قدتَنا وَحت","مَهَبّاً به إلا قُرىً وضياعا",11,"ع",2,0],["وَما وَجَدَ المُلوكُ أَعَزَّ مِنّا","وَأَسرَعَ مِن فَوارِسِنا اِستِلابا",12,"ب",2,0],["وما وجدت نساء بني نزار","حلائل أسودين وأحمرينا",13,"ن",2,0],["وَمَا وُجدَت بَنَاتُ بَني نزَارٍ","حَلاَئلَ أَسوَدين وأحمَرينَا",14,"ن",2,0],["وَما وَلَدَت أَفناءُ زُهرَةَ مِنكُمُ","كَريماً وَلَم يَقرَب عَجائِزَكَ المَجدُ",15,"د",1,0],["وما وفتك لطول المسهبات ثنا","فكيف نبغي وفاء الوعد بالوجز",16,"ز",1,0],["وَما وَجدتُ لِقَلبي راحَةً أَبَداً","وَكَيفَ ذاكَ وَقَد هُيّيتُ لِلكَدَرِ",17,"ر",1,1],["وما وجهُ استقائي من غديرٍ","وأنت البحرُ ذوالموج الغضوبِ",18,"ب",1,0],["وما وضعْته همةٌ دون مَفْخرٍ","ولكنها أعلتْه فوق المفاخرِ",19,"ر",1,0],["وما واحدٌ جاء من أمه","بأعجب من ناقدٍ أخفش",20,"ش",1,0],["وما وفائي بمدخولٍ إذا كَلَحَتْ","دهياءُ تفتَرُّ للأقوامِ عن عُصُلِ",21,"ل",1,0],["وَما وَجَدَت فيها قُرَيشٌ لِأَمرِها","أَعَفَّ وَأَوفى مِن أَبيكَ وَأَمجَدا",22,"د",2,0],["وما ورثت له عندى حبال","ولا ضاقت له عني ثياب",23,"ب",1,0],["وما وجدوا لمفسدة مجالا","ولكن تنبح القمر الكلاب",23,"ب",1,0],["وَما وُجِدَ اِشتِياقٌ كَاِشتِياقي","وَلا عُرِفَ اِنكِماشٌ كَاِنكِماشي",24,"ش",2,0],["وما وردنا الأبيض ذاك الذي","منه يكون الزرع والفرسُ",25,"س",1,0],["وماؤها يزخر في جوفها","ولأرض في هاوية ترسبُ",26,"ب",1,0],["وَما وَعَدَت وَشيكاً مِن نَوالٍ","فَنَطلُبَ عِندَها نُجحَ العِداتِ",27,"ت",1,0],["وَما وَجَبَت عَلَيَّ زَكاةُ مالٍ","وَهَل تَجِبُ الزَكاةُ عَلى جَوادِ",28,"د",1,0],["وَما وَلِيَ المَكارِمَ مِثلُ خِرقٍ","أَغَرَّ يَرى المَواعِدَ كَالدُيونِ",29,"ن",1,0],["وَما وَصيفٌ يَومَ وَصفي لَهُ","بِخامِلِ الذِكرِ وَلا دونِهِ",30,"ن",2,0],["وَما وُجِعَت أَزدِيَّةٌ مِن خِتانَةٍ","وَلا شَرِبَت في جِلدِ حَوبٍ مُعَلَّبِ",31,"ب",1,0],["وَما وَلَدَت بَعدَ النَبِيِّ وَأَهلِهِ","كَمِثلي حِصانٌ في الرِجالِ يُقارِبُه",32,"ب",2,0],["وَما وَلَدَت أُنثى مِنَ الناسِ مِثلَهُ","وَلا لَفَّهُ أَظآرُهُ في اللَفائِفِ",33,"ف",1,0],["وَما وَجَدَ الإِسلامُ بَعدَ مُحَمَّدٍ","وَأَصحابِهِ لِلدينِ مِثلَكَ راعِيا",34,"ي",2,0],["وما وَجَدْتُ عليلاً عنده أملي","فهو الكريمُ على العلّات لا هرمُ",35,"م",1,0],["وما ولدتْ سودُ المنايا وَحُمْرُهَا","عَلى الكرهِ حَتَّى كانَ صارِمُكَ الفحلا",36,"ل",2,0],["وَما وَفَدَ المَشيبُ عَلَيكَ إِلّا","بِأَخلاقِ الدَناءَةِ وَالوَضاعَه",37,"ع",2,0],["وما وصفُ الهزيلةِ مِنْ مرادي","ولستُ أريدُ إلا ذاتَ شحمِ",38,"م",1,1],["وما وحدي فُجعْتُ بهِ ولكنْ","لقدْ عمَّ البريَّةَ أجمعينا",39,"ن",2,0],["وما وَجَدْتُ إلى لُقْياكِ مُنْعَطَفاً","إلاّ إليكِ،ولا أَلْفَيْتُ مُفْتَرَقا",40,"ق",2,0],["وَما وَجِدَت وَجدي بِها أُمُّ واجِدٍ","وَلا وَجِدَ النَهدِيُّ وَجدي عَلى هِندِ",41,"د",1,0],["وما وادي الجحيمِ بِمُستطاعٍ","وإن عَزُبَتْ حُلومُ الغافلينا",42,"ن",2,0],["وَما وَقفَةٌ مِنكُم وَإِن طالَ حينُها","بِشافِيَةٍ ما يُعقِبُ النَأيُ وَالبُعدُ",43,"د",1,0],["وَما وَصلُكُم بِالرَثِّ يا سَلمَ فَاِنعِمي","صَباحاً وَلا بِالمُستَعارِ المُمَنَّحِ",44,"ح",1,0],["وما وَفى شُكري ببعض الذي","كَسَيْتَني من مَفْخَرِ الصِّدق",45,"ق",1,0],["وَما واهِنُ البَزلاءِ مِثلُ مُشَيَّعٍ","إِذا قامَ بِالجُلّى عَلَت وَتَجَلَّتِ",46,"ت",1,0],["وَما وَلَدوا إِلّا أَغَرَّ مُتَوَّجاً","لَهُ راحَةٌ تُبكي وَأُخرى تَحَلَّبُ",47,"ب",1,0],["وَما وَعظَتَكُم لَيلَةٌ بَعدَ لَيلَةٍ","وَلا ضَوءُ أَقمارٍ بَدَت وَشُموسُ",48,"س",1,0],["وَما وَجَدتُ مَنايا القَومِ مُغفِلَةً","شِبلاً بِغابٍ وَلا غَفراً بِإِشبيلا",49,"ل",2,0],["وَما وَجَدتُ صُروفَ الدَهرِ ناكِبَةً","عَن قانِتينَ لِوَجهِ اللَهِ داعينا",50,"ن",2,0],["وَما وَفَت لِخَليلٍ في مُعاشِرَةٍ","وَلا طَمِعنا لِخِلٍّ في تَوافيها",51,"ي",3,0],["وما وراءَ العُباب تَبْغي","وأيُّ سرٍّ لها تَبدّى",52,"د",2,0],["وَما وَجَدَت وَجدي بِها أُمُّ واحِدٍ","وَلا وَجَدَ النَهدِيُّ وَجدي عَلى هِندِ",53,"د",1,0],["وما وردتها من صدًى غير أنها","تريد بورد الماء حفظ المساحل",54,"ل",1,0],["وَما وَجَدْتُ أَخاً في الدَّهْرِ يَذكُرُنِي","إِذا سَمَا وعلا يَوْماً به الشَّانُ",55,"ن",1,0],["وَما وَلّى شُجاعُ الحَربِ إِلّا","وَبَينَ يَدَيهِ شَخصٌ مِن مِثالي",56,"ي",1,0],["وَما وَجَدَ الأَعادي فِيَّ عَيباً","فَعابوني بِلَونٍ في العُيونِ",57,"ن",1,0],["وما وَرَّدَتْ مِن أدمُعِي بمُورَّدٍ","وما خَلخلتْ مِن أضلُعي بمُخَلْخلِ",58,"ل",1,0],["وما وَقْفَتي بَيْن الرِّياضِ وقَدْ عَفَتْ","سِوَى حَاجَةٍ يَقْضي بها الْحَقَّ ناذِرُه",59,"ر",2,0],["وما وحَّد الجمعَ مثْلُ اللسانِ","ولا اتحد الجمعُ إلا غلب",60,"ب",1,0],["وما ورِث السيادةَ عَنْ جدودٍ","ولا شهر اسمَهُ عَمُّ وخال",61,"ل",1,0],["وَمَا وَلَدَتْ أُمِّي مِنَ الْقَوْمِ عَاجِزَاً","وَلاَ كَانَ رِيشِي مِنْ ذُنَابِي وَلاَ لَغْبِ",62,"ب",1,1],["ومَا وَلَدَتْ أُنْثَى مِنَ النّاسِ مِثْلَهُ،","وَلا لعفّهُ أظْآرُهُ في اللّفائِفِ",63,"ف",1,0],["وما وفاني بمدخولٍ إذا كَلَحَتْ","دهياءُ تفترُ للأقوامِ عن عُصُلِ",64,"ل",1,0],["وما وجهُ استقائي من غديرٍ","وأنت البحرُ والموج الغضوبِ",65,"ب",1,0]]}