{"poems":[[92,"أرح ركابك من أين ومن عثر","https://www.aldiwan.net/poem60154.html","عموديه"],[107,"نهضت من كل أوب تلتقي","https://www.aldiwan.net/poem44200.html","الرمل"],[242,"جل من أنشأ ظبيا أهيفا","https://www.aldiwan.net/poem19786.html","الرمل"],[259,"ظالم يامن قلاني","https://www.aldiwan.net/poem36221.html","مجزوء الرمل"],[343,"اصطبح كأس شراب","https://www.aldiwan.net/poem68814.html","مجزوء الرمل"],[369,"قربا لي يا صاحبي بعيدا","https://www.aldiwan.net/poem60938.html","الخفيف"],[415,"اصطبر للزمان إن حاف حينا","https://www.aldiwan.net/poem31997.html","الخفيف"],[484,"هبت الصبا فصبا","https://www.aldiwan.net/poem37058.html","المقتضب"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64054","المنسرح"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145825","الخفيف"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101991","الخفيف"],[1358,"","https://poetry.dctabudhabi.ae/diwan/poem/143804","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79846","الرمل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52073","الطويل"],[2360,"","https://poetry.dctabudhabi.ae/diwan/poem/119180","الرجز"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205773","الخفيف"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112326","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89411","السريع"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91637","الرمل"],[4750,"يا شديد الخطب","https://www.poetsgate.com/ViewPoem.aspx?id=180418",""],[4785,"سفر","https://www.poetsgate.com/ViewPoem.aspx?id=129735",""],[5102,"عيوني","https://www.poetsgate.com/ViewPoem.aspx?id=12900",""],[5242,"هجر وشجن","https://www.poetsgate.com/ViewPoem.aspx?id=125967",""],[5829,"تعب السنونو","https://www.poetsgate.com/ViewPoem.aspx?id=189841",""],[5956,"جواب رفاه لخالد","https://www.poetsgate.com/ViewPoem.aspx?id=182389",""],[6004,"مثلما تمضي الثواني","https://www.poetsgate.com/ViewPoem.aspx?id=33701",""],[6262,"هل تَرْسُمينَ الآن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80110&r=&rc=8",""]],"verses":[["أصطادهنَّ بزعمي وهي لي شركٍ","يصطادُني بالسنا واللطِف والخفَرِ",0,"ر",1,0],["اصطفاكِ اللَّهُ فيمن يَصطَفي","وانتقَى بَيتَكِ فيما ينتقي",1,"ي",1,0],["اِصْطَفَاهُ الْحُسْنُ مِنْ أَهْلِ الصَّفَا","مَنْ عَذِيرِي مِنْ غَزَالٍ مُصْطَفَى",2,"ف",2,0],["اِصْطَبرْ، واصلْ، تجاوزْ","كلَّ ألوان الهوان",3,"ن",1,0],["اِصطَبِح كَأسَ شَرابِ","وَاِغتَبِق كَأسَ تَصابِ",4,"ب",1,1],["اصطفاهُ بيتُ النّبوّةِ كي ين","طِقَ عنه مُؤيَّداً تَأْيِيدا",5,"د",2,0],["اصطبِرْ للزَّمانِ إِن حافَ حِينَا","أو تَلقَّاكَ بالمَخاوِفِ حِينَا",6,"ن",2,1],["اصطفى له سنة","ذو الجلال وانتخبا",7,"ب",2,0],["اصطدتُ ظبيَ الفلاة في طَرفٍ","منه وظبيَ الأنيسِ في طرف",8,"ف",1,0],["أصطلي نارَها وأدني لظاها","وجفوني ممَّا تسهَدنَ قرحى",9,"ح",2,0],["اصطحبها ففيكما طب نفسي","هي أحلى وأنت أشهى وأشفى",10,"ف",2,0],["أصطاد بالدنيا وين","صب لي بها شرك الرجاء",11,"ا",2,0],["اصطفى المجدُ له مُنجِبةً","واصطفى منه لها كفواً نجيبا",12,"ب",2,0],["اصْطَتْ عَلَى مَنْ جاءَ يَخطبُ وَصلْهَا","وَقَالَتْ له ما بَعْدَ بَعلِيَ من بَعْلِ",13,"ل",1,0],["اصطلح السائل والمسؤول","ليس إلى مكرمة سبيل",14,"ل",1,1],["اصطفاق المجداف مثل جناح ال","طير آوى ليلا إلى الأوكار",15,"ر",1,0],["أصطاد كلّ خريدةٍ","فاقَت على الغِيد الحسان",16,"ن",1,0],["اصطبل خيل الآصفي بها","على البروج والنجوم ازدهى",17,"ه",2,1],["أَصطفي من ظَلمِه راحاً صَفا","حَيثُما قَد ظلّلتني الطُّرّتان",18,"ن",1,0],["أصطغيبك راقي الأسماع وأبهج بك عيوني","وارتقيبك في منصات الشهير العالمية",19,"ي",2,0],["أصطادُ أطيار السعادة","وهي من وجهي تفرْ",20,"ر",1,0],["اصطفتِ الآلاف ترقب طلعةً","للموكب الملكيِّ وهْو بهاءُ",21,"ا",2,0],["أصطاد فيها للأسو","دِ فصادني الظبيُ الأغن",22,"ن",1,0],["أصطاف ما بين الهداب وأنتشي","أتنسم العمر الرطيبْ",23,"ب",1,1],["أصطفي الموت ولا أسمعُ هذا","بل أرى السُمَّ على نفسي أحَبّْ",24,"ب",1,0],["إِصْطبارٌ وَاشتياق","ٌالْجفا مِنهُ سَقَانِي",25,"ن",2,0],["أصطادُ قافيةً وأحملُ عِبْأها","أبتاعُ وجهاً غير أوجهيَ العديده",26,"د",2,0]]}