البريا","https://www.poetsgate.com/ViewPoem.aspx?id=49617",""],[4578,"لبدرٍ زفاف الشمس والنجم شاهد","https://www.poetsgate.com/ViewPoem.aspx?id=49397",""],[4916,"ياليته يطير ويحلّق علشاني","https://www.poetsgate.com/ViewPoem.aspx?id=135651",""],[4927,"بلوى العشاق","https://www.poetsgate.com/ViewPoem.aspx?id=29608",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[307,"بذكر المصطفى","https://www.poetsgate.com/ViewPoem.aspx?id=215238",""],[5338,"لا تعذل العين أن أرخت عزاليها","https://www.poetsgate.com/ViewPoem.aspx?id=187832",""],[592,"لعمرك ما يدري الغبي بأنه","https://www.poetsgate.com/ViewPoem.aspx?id=128805",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5376,"أما في الدارِ أشواقٌ وشمسٌ","https://www.poetsgate.com/ViewPoem.aspx?id=188450",""],[5376,"قد عيل صبري وما ذا النزف من شيمي","https://www.poetsgate.com/ViewPoem.aspx?id=199003",""],[5431,"أحبك كيف لاأدري","https://www.poetsgate.com/ViewPoem.aspx?id=183071",""],[5431,"حبيبي ...","https://www.poetsgate.com/ViewPoem.aspx?id=189358",""],[5431,"الحمد لله من قلبِ به سكنا","https://www.poetsgate.com/ViewPoem.aspx?id=201907",""],[5493,"أسرار الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=197477",""],[5582,"أَلا هَلْ رأَتْ عَيْناكَ لِلْحَيِّ أَظْعانَا","https://www.poetsgate.com/ViewPoem.aspx?id=63594",""],[5587,"سيد الثقلين","https://www.poetsgate.com/ViewPoem.aspx?id=193801",""],[5612,"نَذَرْتُ لبَحْرِكَ اللُجِّيِّ رُوحي","https://www.poetsgate.com/ViewPoem.aspx?id=179731",""],[5943,"بهيُّ الشِّعرِ","https://www.poetsgate.com/ViewPoem.aspx?id=34291",""],[6117,"أَفْضَتْ إِلَيْهِ الْمُنَى","https://www.poetsgate.com/ViewPoem.aspx?id=182788",""],[6225,"قوسُ الحنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80920&r=&rc=189",""],[6251,"أتيتك بالبشر لا بالعزاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76474&r=&rc=14",""],[5126,"أعَاذلتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87835&r=&rc=49",""]],"verses":[["بَهيرُ الخُطا لا يكلِّمُ الأَرضَ وطْؤُهُ","وما حازَهُ منهُ الوِشاحُ هضيمُ",0,"م",1,0],["به يجمع الملك أشتاته","إذا ما عصا الناس طارت شقق",1,"ق",1,0],["به يهتدي الضُّلالُ عند ضلالهم","إلى سنَنَ القصدِ الذي هو أقومُ",2,"م",1,0],["بِهِ يَقتَضي الحاجاتِ مَن هُوَ طالِبٌ","وَيَستَعطِفُ الأَحبابَ مَن هُوَ عاشِقُ",3,"ق",1,0],["بَهيمَةٌ مِسكينُ","يَشكو فَلا يُبينُ",4,"ن",1,0],["به يشفى سقيمك وهو يعطي","غنى أبداً فيؤمنك افتقارك",5,"ك",1,0],["به يُشرِقُ المُلْكُ يومَ الفَخار","ويحتدمُ الحرب يومَ الضِرابْ",6,"ب",1,0],["بَهِيٌّ في حَمائِلِهِ جَميلٌ","وَفَخمٌ في مُفاضَتِهِ جَهيرُ",7,"ر",1,0],["بِهِ يَطمَئِنُّ الخائِفونَ وَغَيثُهُ","بِهِ مِن بِلادِ المَحلِ يَحيا تُرابُها",8,"ب",3,0],["بِهِ يُحيِ البِلادَ وَمَن عَلَيها","مِنَ النَعَمِ البَهائِمِ وَالرَنامِ",9,"م",1,0],["بِهِ يَكسِبُ الأَجرَ في بَعثِهِ","وَيَخلُصُ مِن هَولِ ما يَكتَسِب",10,"ب",1,0],["بِهَيكَلٍ قوبِلَ في أَنسابِهِ","مُرَدَّدُ الأَعوَجِ في أَصلابِهِ",11,"ب",2,0],["بهيكلِ أسقفٍ وبما يليه","ونشرِ البندِ والعلمِ الخفوقِ",12,"ق",1,0],["بهيتٍ وعاناتٍ وبنّي ودسكر","وقطربل ذات الرحيق المُفَلفَلِ",13,"ل",1,0],["به يقدم الهبَّابُ في ساحة الوغى","ويأنسُ من وحش المفاوزِ نافره",14,"ر",2,0],["بِهِ يُحْيِي البِلادَ وَمَنْ عَلَيْهَا","مِنَ النَّعَمِ البَهَائِمِ وَالأنَامِ",15,"م",1,0],["بَهِيمُ بِحُسْنِ صُورَتِهِ","فُؤَادِي، وَهْوَ يَظْلِمُهُ",16,"م",2,0],["بهيكل إنسان من النور صيغت","وما الشكل شيء حين تبدو والحقائق",17,"ق",1,0],["بِهِ يَحسُنُ الإِسرافُ لا بي وَبِالمُنى","وَيَقبُحُ بي مَع فِعلِهِ لا بِهِ الجَحدُ",18,"د",1,0],["بِهِ يُختَمُ الذِكرُ الجَميلُ وَيُبدأُ","لَهُ رُتبَةٌ فَوقَ السماكَينِ قَد سَمَت",19,"ت",1,0],["بِهِ يَرفَعُ الصَوتَ المُلَبّي وَبِاِسمِهِ","عَلى اللَهِ في دَفعِ المُلِمّاتِ يُقسِمُ",20,"م",1,0],["بهِ يطلعُ الشيطانُ ينطح قرنهُ","رُؤوسَ الهُدى واللَّهُ يَكسرهُ كسرا",21,"ر",2,0],["بهيّ الرمل تحسبه سجوفاً","مطرزةً بحبّاتِ العقيق",22,"ق",1,0],["به يَقْبَلُ الله فَرَضَ الصّيام","وحَجّ الحجيج وإهلالها",23,"ل",3,0],["به يَشتفي السّمعُ الأصمُّ بلفظه","وتُشْفَى برؤيا وجهه الأعين الرُّمدْ",24,"د",1,0],["بهيبته أردى الأعادي فحسبُهُم","نَبيُّ على بعد المدى يبعث الرعبا",25,"ب",2,0],["بهيم كيوم البين لولا وشاته","وما كل ليل مثله ببهيم",26,"م",1,0],["بِهِ يَهفو بُراقٌ في الوَغى أَو","قُدامى البَرقِ يَحفِزُهُ اِقتِحامُ",27,"م",1,0],["بهيمٌ يضلُّ النجمُ فيه سبيلَه","وَيزورُّ ذعراً بدرُه فيجانبه",28,"ب",2,0],["بَهِ يَنعَشُ الرَحمَنُ مِلَّةَ جَدِّهِ","وَيَحيى بِهِ دينِ الهُدى وَمَناسِكُه",29,"ك",2,0],["بهيج به وجد وشوق ولوعة","شجون لها تجرى على الخد دمعة",30,"ه",1,0],["بهية زانها مع زينها الشرفُ","مثل العذارى لدى البزدار سافرةٍ",31,"ه",1,0],["به يبحث الضرغام يحمي وروده","ومن حوله السيدان من ظمأ نشوى",32,"و",2,0],["به يشهد الدِّيباج والوشيُ شاهِدٌ","وحَلْيُ النُّضار والعِتاقُ الضَّوامر",33,"ر",1,0],["بهيج لي العهد القديم صبابة","أنوح بها نوح الحمام على أيك",34,"ك",1,1],["به يَدري الخميسُ إذا رآهُ","سيحشرُه بأحشاءِ الذّئابِ",35,"ب",1,0],["بَهيجةُ الحُسنِ بُستانيَّةٌ نَفَحتْ","زهراً ففيهِ لها بُستانُ بُستانِ",36,"ن",1,0],["به يقتدي من ساعدا لله جده","ويزور مرتاب شقي فيخذل",37,"ل",1,0],["به يستوي المعوج من بعد قولهم","متى يسْتوي هل يسْتوي الصَّابُ والشَّهدُ",38,"د",1,0],["به يَتَشَرَّفُ الشَّرفُ المُعَلاَّ","عَنِ العَليا وتَفتَخِرُ افتخارا",39,"ر",2,0],["بهِ يُنعشُ اللهُ جمعَ العبادِ","ويُجري البلاغةَ في النَّاطِقِ",40,"ق",1,0],["به يعتزُّ قُطرُ الشامِ تيهاً","ويفتخرُ البعيدُ معَ القريبِ",41,"ب",1,0],["به يتاح لقلبي ال","كسير قطف المعاني",42,"ي",1,0],["بَهيمٍ في بَهيم قَد","أَتى للذَّم كَالهُلب",43,"ب",1,0],["بِهِ يا مَصر فَاِبتَهجي وَتيهي","عَلى كُل المَمالك وَالبقاع",44,"ع",1,0],["بهِ يهتدي من ينتديكَ ميمماً","كذلك بالمهديِّ يُهدى المُيممُ",45,"م",1,0],["بِهِ يَرى الشّمسَ تَبدو وَهيَ مُزهِرَة","وَالبدرُ يَزهو وَلَم تَحتَطهُ هالاتُ",46,"ت",1,0],["بهيجٌ يَهيجُ السّامعين صهيلُهُ","ويُشعِرُ أنَّ العِزَّ خوضُ الفيالق",47,"ق",1,0],["بهيم كسَتْه السارياتُ مُلاءةً","وأرخَتْ عليه مِن قميصٍ ومِنْ رِدا",48,"د",2,0],["بِهِ يَرْتَجُونَ الْعَفْوَ مِنْ فَضْلِ سَيِّدِ","مَحَامِدُهُ مِنْ كَثْرَةٍ لَمْ تُعَدَّدِ",49,"د",1,0],["بِهِ يُدْرِكُ الْعاصِي طَريقَ نَجَاتهِ","خَطِيرٌ جَلِيلُ الْقَدْرِ هَامُ عِدَاتِهِ",50,"ه",1,0],["بهي زكي بادن متماسك","قويم سوي الصدر فخم مفخم",51,"م",1,0],["بهِ ينالُ المعالي كلّ ذي شطب","وكلُّ سرد من الماذي وموضونِ",52,"ن",1,0],["به يطمئن الآن بالي وخاطري","وقلبي الشجي كلٌّ لدى الصحب مرتمي",53,"م",2,0],["به ينعِرِف وضع الردي مِ السنافي","والشهْم بافعاله يتوّج معانيه",54,"ي",2,0],["به يعرف الانسان حق الهه","فيهدي به الغاوي ويروى به الصادي",55,"د",2,0],["به يا رب فامنحني متابا","كما ترضى وظفر بالوصال",56,"ل",1,0],["بهيّ وفيّ شافع ومشفع","أمين مبين بالهداية مرتد",57,"د",1,0],["بِهِ يَحظى النَزيل بِكُل أَمن","مِن الكُرسي أَعظَم نُور حَسَن",58,"ن",1,0],["بهيمةٌ لو تُوَفَّى كنه شِرَّتها","لفاتتِ الخيلَ بالأَحْجَالِ والغُرَرِ",59,"ر",1,0],["به يقطع اعناق الصعاب ولا","تغنيه اعناقها عن قطع احشاها",60,"ا",3,0],["بهى جميل الوجه بدر متمم","صباح رشاد للضلالة مذهب",61,"ب",1,0],["به يستنيرُ القلبُ من كلّ ظلمةٍ","وكم من رقيق الوزرِ صار به يعنى",62,"ن",2,0],["به يستغيث الناس طُراً إذا أتوا","وكل امرئ فيما اجتناه رهين",63,"ن",1,0],["بِهِ يَرتَجِى المَجذُوبُ يَنجُو بِصَحبهِ","بِغَيرِ امتِحانٍ يا شَفِيعُ وَيَسلَمُ",64,"م",1,0],["بهِ يَرتَجِى المَلهُوفُ أَيضاً مَرَامَهُ","وَيَأمَنُ مِمَّا قَد دَهاهُ وَضامَهُ",65,"ه",1,0],["به يا ربّ فارحمنا","بدُنيا وبالرَمس",66,"س",1,0],["بهيُّ اليد أوصلُها","منائي ليسَ إلى يوبى",67,"ب",2,0],["به يسمع العبدُ المطيعُ به يرى","به يظهر الأفعال في الفتقِ والرتق",68,"ق",1,0],["به يحققه منه يخلقه","فيه يعشقه له يشوقه",69,"ق",2,0],["به يرون وجودَ الكونِ فيه كما","يرون فيه وجودَ الحقِّ في البشر",70,"ر",1,0],["به يقول ابن طيفور وإنَّ له","وجها صحيحاً لمن يدريه بالمثل",71,"ل",1,0],["به يشربُ الإنسان ماء حياته","به تفتق الأسماع إنْ كُنَّ في رَتقِ",72,"ق",1,0],["بِهَيفاءَ غَيداءَ رُعبَوبَةٍ","فُؤادُ الشَجِيِّ لَها تائِقُ",73,"ق",1,0],["به يطمئن القلب غير مزعزع","ولا خائف بل آمن من تنكد",74,"د",1,0],["بَهيرٌ تَرى نضَح العَبيرِ بِجيبِها","كَما ضَرَّحَ الضاري النزيفَ المُكلَّما",75,"م",2,0],["به يغفر اللَه الذنوب ويرتجي","شفاعته في الحشر كل أنيم",76,"م",1,0],["به يأمنُ الثغرُ المخوفُ انفتاحُه","به ينظمُ السلكَ العرينَ انتظامُه",77,"م",2,0],["بِهِ يَرِّق المَرءُ وَهُوَ فَظّ","وَيُدرك الشأوَ بِلا سِباق",78,"ق",1,0],["بهية خدّ عطرة الريق غادة","رَشيقة قد تَزدَري بالقَواضِب",79,"ب",1,0],["بَهي مُشرق النور","وَلَولاه لضلينا",80,"ن",2,0],["بِهِ يَستَضيء السالِكون إِلى الهُدى","كَما يَستضيء الناس في طَلعة الشَمس",81,"س",1,0],["به يتجلى الحق ابلج واضحاً","سناه ببرق من شباه توقدا",82,"د",2,0],["بهيمة تحت بهيم تمشي","كأنه المخنوق فوق النعشِ",83,"ش",1,0],["به يَهْتدي سارٍ وينْجحُ مَقْصَدٌ","ويَقفو سَبيلَ الرُشْدِ فيه مُباحِثُ",84,"ث",1,0],["به يهتدي للقصد من كان حائراً","ويأمن مسلوب الفؤاد من الذعر",85,"ر",1,0],["به يلبس التاج خير الملو","ك عثمان رب الفخار الصميم",86,"م",1,0],["به يرحم الله العباد ويمطر ال","بلاد وتزوى طارقات وأهوال",87,"ل",1,0],["به يسر كل من","للَه مولنا شكر",88,"ر",1,0],["به يبْذُلُ الحسنَ المصُونَ لمن بِهِ","وفي غيره لو كان ما كان باذلاَ",89,"ل",2,0],["بِهِيلا لَهُ الصَّانِعُ الأَمهَرُ","تِخِيُّوسُ حَدَّفَ يَفتَخِرُ",90,"ر",1,0],["بهيئة إنس له اعترضا","وبالأنس راحته قبضا",91,"ض",2,0],["بِهَيئَتِهِ هذي وَتَصحيف قَلبه","سَنا تَهتَدي فيهِ الوُفودُ وَتُرشَدُ",92,"د",1,0],["بِهِ يتقى في البَأس عِندَ اِصطِدامِهِم","وَطارَ لِنيران الوَغى بِالقِنا وَقَد",93,"د",1,0],["بِهِ يَتَحَلّى جيدُ هَيفاءَ غادَة","فَيُدرِكُ مِنها الحُسنَ أَبعَدُ مَطلَبِ",94,"ب",1,0],["بهيم نضونا برده وهو مخلق","وكنا لبسناه قشيباً مسهما",95,"م",2,0],["به يحلو الزمان وطاب نشراً","تراه بجيده عقداً ثمينا",96,"ن",2,0],["به يهون شديد النائبات إذا","ما قام لله يجلوها على الأثر",97,"ر",1,0],["به يَرِدُّ خائباً عن وهن","وقيتَ يا كريم وعثاء السفر",98,"ر",1,0],["بهي أن تبدى في ظلام","محياه حسبت الليل أسفر",99,"ر",1,0],["بهيجني نئيج الريح فيها","فاحسبها اذاعت صون سرى",100,"ر",2,0],["به يتسرى كل همٍّ عن العلى","وفيه عن العليا تزول الفوادح",101,"ح",1,0],["بهيفائي أغسّل كل بوح","فياتي طاهرا مثل الغدير ِ",102,"ر",1,0],["بهيَّ الوجهِ أبيضَ فيه نورٌ","تَصُبُّ القطْرَ إنْ سألَ السَّماءُ",103,"ا",2,0],["بِهَيكَلٍ لا تُحِسُّ الرِّيحُ إِن عَبَرَت","بِهِ، أَكَانَ (عُزَيرًا) أَم (سُليمانا)!",104,"ن",2,0],["بهيجٌ، ورغمَ العذاباتِ غضٌّ"