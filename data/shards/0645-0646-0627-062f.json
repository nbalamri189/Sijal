{"poems":[[72,"من أدب النفس أن يوقر مو","https://www.aldiwan.net/poem19589.html","المنسرح"],[85,"ويوم من صبا آذار حلو","https://www.aldiwan.net/poem7044.html","الوافر"],[85,"قف على كنز بباريس دفين","https://www.aldiwan.net/poem63736.html","الرمل"],[61,"بلاني الحب فيك بما بلاني","https://www.aldiwan.net/poem51417.html","الوافر"],[58,"إذا رمت أن تعلى فزر متواترا","https://www.aldiwan.net/poem31167.html","الطويل"],[74,"الآن سح غمام النصر فانهملا","https://www.aldiwan.net/poem13228.html","البسيط"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[46,"من ادعى الخير من قوم فهم كذب","https://www.aldiwan.net/poem22539.html","البسيط"],[46,"ليس اغتنام الصديق شأني","https://www.aldiwan.net/poem23400.html","مجزوء البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147493","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[235,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[275,"ألما بأشلاء العلى والمكارم","https://www.aldiwan.net/poem25526.html","الطويل"],[282,"تب يا عذولي عن ملامي واتئب","https://www.aldiwan.net/poem32884.html","الرجز"],[348,"لا تأخذن عنها السروج واللجم","https://www.aldiwan.net/poem20682.html","الرجز"],[366,"كأنك مخلوق كما شاءت العلا","https://www.aldiwan.net/poem17169.html","الطويل"],[371,"لا بتماديك على هجري","https://www.aldiwan.net/poem57430.html","السريع"],[441,"عوجوا رقاب اليعملات الذلل","https://www.aldiwan.net/poem14338.html","الكامل"],[443,"نوابنا نوائب كلهم","https://www.aldiwan.net/poem55947.html","عموديه"],[453,"مهد الحضارة للعروبة كلها","https://www.aldiwan.net/poem61290.html","الكامل"],[458,"ما جد السعي أتاه ما سعى له","https://www.aldiwan.net/poem55933.html","الرمل"],[562,"لولا التفاوت في الأخلاق والأدب","https://www.aldiwan.net/poem52810.html","البسيط"],[567,"محاسن الدير تسبيحي ومساحي","https://www.aldiwan.net/poem69749.html","البسيط"],[575,"راح رسولي وجاءني عاشق","https://www.aldiwan.net/poem3045.html","المنسرح"]],"verses":[["من أدبِ النفس أن يوقَّر مو","لانا بتدبيرِهِ الجليل علا",0,"ل",2,1],["منادف عسجد ظفرت بقطن","فما تألوه ندفا وانتهابا",1,"ب",2,0],["مِن أَديمٍ يَهرَأُ الدُبَّ إِلى","فَلَواتٍ تُنضِجُ الضَبَّ الكَنين",2,"ن",1,0],["مُنادَمَةُ القَنا أحلى لدَيْهِ","وأعظمُ من مُنادَمَةِ القِيانِ",3,"ن",1,0],["مُنادَمَةُ الإِنسانِ تُحسِنُ مَرّةً","وَإِن أَكثَروا إِدمانَها أَفسَدوا الحُبّا",4,"ب",2,0],["مِن أَدهَمٍ أَخضَرِ الجِلبابِ تَحسِبُهُ","قَدِ اِستَعارَ رِداءَ اللَيلِ وَاِشتَمَلا",5,"ل",2,0],["مِنْ آدَمٍ ولِحِينِ الوَضْعِ جَوْهَرُهُ ال","مَكْنُونُ فِي أَنْفَسِ الأَصدافِ مَحمُولُ",6,"ل",1,0],["مَنِ اِدَّعى الخَيرَ مِن قَومٍ فَهُم كُذُبٌ","لا خَيرَ في هَذِهِ الدُنيا وَلا خِيَرُ",7,"ر",1,1],["مَنِ اِدَّعى أَنَّهُ وَفِيٌّ","فَليَنتَسِب في سِوى الأَنامِ",8,"م",1,0],["من ادعى النسك عَلَى غرة","فقل له ما صدق الخارص",9,"ص",1,1],["مَن أَدَلَّهُ بَشَراً","كامِلَ الحُلى فَرِها",10,"ر",3,0],["مِن أَدهَمٍ مُطَهَّمٍ","ذي غُرَّةٍ كَالفَلَقِ",11,"ق",1,0],["مُنادىً إلى دارِ السَّلام مُنادِمٍ","بِها الحُورُ واهاً لِلْمُنادِي المُنادِمِ",12,"م",1,0],["مَنِ اِدَّعى في دَهرِنا مِثلاً لَهُ","يَوماً فَقَد باءَ بِزُورٍ وَكَذِب",13,"ب",1,0],["من أَدْهَمٍ مُحَجَّلٍ أَغَرِّ","كاللَّيلِ خَاضَ في غَدِيرِ الفَجْرِ",14,"ر",1,0],["مَنادِحُ جودٍ لِلطلابِ وَسيعَةٌ","وَلَكِن بِها في المَدحِ ضاقَت مَنادِحي",15,"ي",1,0],["من أدمعٍ صدَّرنَ في وجنَتي","نسخة ما سطَّرتُ في صَدري",16,"ي",1,0],["من آدم من شيثه إدريسه","من نوح ولسامه المتكفل",17,"ل",1,0],["من ادعى فيهم حجى فليلم","نفسا له من جبنها منغص",18,"ص",1,0],["من أدهشت كسرى بحكمة عمروها","من أنجبت بلقيس صورة دلها",19,"ل",3,0],["من أديم الليل قُدّتْ هيبةً","لا ظلاماً ووقاراً لا ضلالَهْ",20,"ل",2,0],["مَنِ ادَّعى الدِّينَ والدُّنيا أقولُ لهُ","إن كُنتَ كابن عُبيدَ أقدِمْ ولا تَهَبِ",21,"ب",1,0],["مُنَادِماً في قَلاَلِيْهِ رَهابِنَةً","راحَتْ خَلاَئِفُهُمْ أَصْفَى مِن الرَّاحِ",22,"ح",1,0],["من ادّعى مجدَه مُسارَقَةً","فقل له قد مُسِكْت يا سارق",23,"ق",1,0]]}