{"poems":[[74,"من أدب النفس أن يوقر مو","https://www.aldiwan.net/poem19589.html","المنسرح"],[87,"ويوم من صبا آذار حلو","https://www.aldiwan.net/poem7044.html","الوافر"],[87,"قف على كنز بباريس دفين","https://www.aldiwan.net/poem63736.html","الرمل"],[63,"بلاني الحب فيك بما بلاني","https://www.aldiwan.net/poem51417.html","الوافر"],[60,"إذا رمت أن تعلى فزر متواترا","https://www.aldiwan.net/poem31167.html","الطويل"],[76,"الآن سح غمام النصر فانهملا","https://www.aldiwan.net/poem13228.html","البسيط"],[69,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[48,"من ادعى الخير من قوم فهم كذب","https://www.aldiwan.net/poem22539.html","البسيط"],[48,"ليس اغتنام الصديق شأني","https://www.aldiwan.net/poem23400.html","مجزوء البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147493","السريع"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[240,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[280,"ألما بأشلاء العلى والمكارم","https://www.aldiwan.net/poem25526.html","الطويل"],[287,"تب يا عذولي عن ملامي واتئب","https://www.aldiwan.net/poem32884.html","الرجز"],[353,"لا تأخذن عنها السروج واللجم","https://www.aldiwan.net/poem20682.html","الرجز"],[371,"كأنك مخلوق كما شاءت العلا","https://www.aldiwan.net/poem17169.html","الطويل"],[376,"لا بتماديك على هجري","https://www.aldiwan.net/poem57430.html","السريع"],[447,"عوجوا رقاب اليعملات الذلل","https://www.aldiwan.net/poem14338.html","الكامل"],[449,"نوابنا نوائب كلهم","https://www.aldiwan.net/poem55947.html","عموديه"],[458,"مهد الحضارة للعروبة كلها","https://www.aldiwan.net/poem61290.html","الكامل"],[463,"ما جد السعي أتاه ما سعى له","https://www.aldiwan.net/poem55933.html","الرمل"],[567,"لولا التفاوت في الأخلاق والأدب","https://www.aldiwan.net/poem52810.html","البسيط"],[572,"محاسن الدير تسبيحي ومساحي","https://www.aldiwan.net/poem69749.html","البسيط"],[580,"راح رسولي وجاءني عاشق","https://www.aldiwan.net/poem3045.html","المنسرح"],[1011,"","https://poetry.dctabudhabi.ae/diwan/poem/124609","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31577","البسيط"],[1319,"","https://poetry.dctabudhabi.ae/diwan/poem/128302","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49928","المنسرح"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118306","الرجز"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131337","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27597","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109368","البسيط"],[2365,"","https://poetry.dctabudhabi.ae/diwan/poem/34718","المجتث"],[2521,"","https://poetry.dctabudhabi.ae/diwan/poem/110668","البسيط"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/130023","البسيط"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129876","السريع"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129812","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93925","الوافر"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133967","الرجز"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132618","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89220","الكامل"],[3643,"","https://poetry.dctabudhabi.ae/diwan/poem/145185","الطويل"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46019","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36757","الوافر"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59511","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35492","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123494","السلسلة"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123515","البسيط"],[4217,"","https://poetry.dctabudhabi.ae/diwan/poem/123955","الوافر"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45104","السريع"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94401","الطويل"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62129","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58126","الوافر"],[4739,"أنا إنسان","https://www.poetsgate.com/ViewPoem.aspx?id=28153",""],[4984,"حيَّ على الصبح *","https://www.poetsgate.com/ViewPoem.aspx?id=175747",""],[5167,"قد شاب رأسي وقلبي ما يغيره","https://www.poetsgate.com/ViewPoem.aspx?id=181115",""],[5444,"راية الأمجاد","https://www.poetsgate.com/ViewPoem.aspx?id=209112",""],[5458,"رمضان","https://www.poetsgate.com/ViewPoem.aspx?id=72289",""],[5677,"بني عزيز ..!","https://www.poetsgate.com/ViewPoem.aspx?id=179980",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5829,"قم لرمضان","https://www.poetsgate.com/ViewPoem.aspx?id=212930",""],[6124,"الرسالة","https://www.poetsgate.com/ViewPoem.aspx?id=103197",""],[6142,"مذ صلصل الله من طين خليقته","https://www.poetsgate.com/ViewPoem.aspx?id=155709",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""]],"verses":[["من أدبِ النفس أن يوقَّر مو","لانا بتدبيرِهِ الجليل علا",0,"ل",2,1],["منادف عسجد ظفرت بقطن","فما تألوه ندفا وانتهابا",1,"ب",2,0],["مِن أَديمٍ يَهرَأُ الدُبَّ إِلى","فَلَواتٍ تُنضِجُ الضَبَّ الكَنين",2,"ن",1,0],["مُنادَمَةُ القَنا أحلى لدَيْهِ","وأعظمُ من مُنادَمَةِ القِيانِ",3,"ن",1,0],["مُنادَمَةُ الإِنسانِ تُحسِنُ مَرّةً","وَإِن أَكثَروا إِدمانَها أَفسَدوا الحُبّا",4,"ب",2,0],["مِن أَدهَمٍ أَخضَرِ الجِلبابِ تَحسِبُهُ","قَدِ اِستَعارَ رِداءَ اللَيلِ وَاِشتَمَلا",5,"ل",2,0],["مِنْ آدَمٍ ولِحِينِ الوَضْعِ جَوْهَرُهُ ال","مَكْنُونُ فِي أَنْفَسِ الأَصدافِ مَحمُولُ",6,"ل",1,0],["مَنِ اِدَّعى الخَيرَ مِن قَومٍ فَهُم كُذُبٌ","لا خَيرَ في هَذِهِ الدُنيا وَلا خِيَرُ",7,"ر",1,1],["مَنِ اِدَّعى أَنَّهُ وَفِيٌّ","فَليَنتَسِب في سِوى الأَنامِ",8,"م",1,0],["من ادعى النسك عَلَى غرة","فقل له ما صدق الخارص",9,"ص",1,1],["مَن أَدَلَّهُ بَشَراً","كامِلَ الحُلى فَرِها",10,"ر",3,0],["مِن أَدهَمٍ مُطَهَّمٍ","ذي غُرَّةٍ كَالفَلَقِ",11,"ق",1,0],["مُنادىً إلى دارِ السَّلام مُنادِمٍ","بِها الحُورُ واهاً لِلْمُنادِي المُنادِمِ",12,"م",1,0],["مَنِ اِدَّعى في دَهرِنا مِثلاً لَهُ","يَوماً فَقَد باءَ بِزُورٍ وَكَذِب",13,"ب",1,0],["من أَدْهَمٍ مُحَجَّلٍ أَغَرِّ","كاللَّيلِ خَاضَ في غَدِيرِ الفَجْرِ",14,"ر",1,0],["مَنادِحُ جودٍ لِلطلابِ وَسيعَةٌ","وَلَكِن بِها في المَدحِ ضاقَت مَنادِحي",15,"ح",2,0],["من أدمعٍ صدَّرنَ في وجنَتي","نسخة ما سطَّرتُ في صَدري",16,"ر",2,0],["من آدم من شيثه إدريسه","من نوح ولسامه المتكفل",17,"ل",1,0],["من ادعى فيهم حجى فليلم","نفسا له من جبنها منغص",18,"ص",1,0],["من أدهشت كسرى بحكمة عمروها","من أنجبت بلقيس صورة دلها",19,"ل",3,0],["من أديم الليل قُدّتْ هيبةً","لا ظلاماً ووقاراً لا ضلالَهْ",20,"ل",2,0],["مَنِ ادَّعى الدِّينَ والدُّنيا أقولُ لهُ","إن كُنتَ كابن عُبيدَ أقدِمْ ولا تَهَبِ",21,"ب",1,0],["مُنَادِماً في قَلاَلِيْهِ رَهابِنَةً","راحَتْ خَلاَئِفُهُمْ أَصْفَى مِن الرَّاحِ",22,"ح",1,0],["من ادّعى مجدَه مُسارَقَةً","فقل له قد مُسِكْت يا سارق",23,"ق",1,0],["منادي جموع زانها الفرد مفلحُ","وقارع أبواب الجحاجح ينجح",24,"ح",1,1],["من أدام القيام في الليل حتى","أورم الساق واشتكاه ضرارا",25,"ر",2,0],["مُنادِماً في قَلالِيهِ رَهابِنَةً","راحَتْ خَلائِقُهُمْ أَصْفى مِنَ الرَّاحِ",26,"ح",1,0],["منادي المنا كل المنا أنت لي مني","وأنت الغني كل الغنى عند إقصاري",27,"ر",2,0],["منْ أَدَبِ النّفس ضَلَّ مذْهبُها","تَلِجُّ في حبِّ من يُعذِّبُها",28,"ب",3,1],["من ادعى عنكم غنى في مذهب","اني الى مذهبه لم اذهب",29,"ب",1,0],["من أَدْهَمٍ سَوادهُ كالّليلِ","ذو غُرّةٍ تضيء كالقِنْدِيْلِ",30,"ل",1,0],["من آدمَ خمرت يداه طينته","بذاك سمِّي في ما قد روى بشرا",31,"ر",2,0],["من ادعى انه يحصي مناقبهُ","تلقاه للعجز فيما يدعي آبا",32,"ب",2,0],["مُنادِياً ساقَ حُرَّ","أَو حُرَّةٍ بِبَيانِ",33,"ن",1,0],["من ادعاها سواهم قد لا دبراً","قميصه في العلى بل قد من قبل",34,"ل",1,0],["منادلُ الشربِ أطرافُ الرياحين","لم يعلُها درنٌ بل مسكُ دارينِ",35,"ن",1,1],["من أدب إرسالها للعلا","لا عسلٌ فيها ولا زُبدُ",36,"د",1,0],["من أدهَم كاللّيل حُجّلَ بالضحى","فتُشَقُّ غُرّتهُ عنِ ابن ذُكاءِ",37,"ا",2,0],["منادي الحظ نادى بالأمان","وبشرى البشر جاءت بالأماني",38,"ن",2,1],["من أدب تحلو به السجايا","ومن علوم كلها مزايا",39,"ي",2,0],["منادمي اهيف مليح","اغن حلو القوام غرّ",40,"ر",1,0],["من آدمٍ حاشى ولدت ولو درى","إبيلس أنك من تناسله خصي",41,"ص",2,0],["منادي الشفا مما به الجسم مبتلى","تشفع فذو الآلام ينجو ويبرأ",42,"ا",1,0],["مَن أَدبتهُ النّائِباتُ سَما لَهُ","خُلُقٌ يَكيدُ النّائِباتِ حَميدُ",43,"د",1,0],["مُنادَمَةً أَلَذّ مِنَ النَدامى","وَبثُّ جَوى أَرَقُّ مِنَ النَسيم",44,"م",1,0],["من أدم يبرين أو رماح","قد راعها قانص مُليمُ",45,"م",1,0],["من أدب الأول أن يخدم ضيف","ويظهر الغنى له ولو بصيف",46,"ف",1,0],["مِن أَدهَم لِلحَيّ فَوقَ لبانه","شُهب تُضيء ظَلامه الغربيبا",47,"ب",2,0],["من آدم والرسل والخلائق طرّا","كل لولاه مع اللواء غدا غاد",48,"د",1,0],["مناديا بانكسار طامعا خجلا","يا خير مولى عن الجانى المسىء عفا",49,"ف",2,0],["منادى الصبح نادى للصبوح","وجنح الليل ولى للجنوح",50,"ح",1,1],["مِن أَدَبِ الكاتِبِ تَرجيعُ ما","طالَعَ قَبلَ طَلَبِ الطالِبِ",51,"ب",1,1],["مُنادمهُ ثملان لا من مُدامةٍ","بطيب المَعاني لا بهذر التفاتفِ",52,"ف",1,0],["من ادعى الشرك في أكرومة معه","فاغلظ عليه وقل للعاهر الحجر",53,"ر",1,0],["مُناديهمْ يناديهمْ ينادِي","هَلُمُّوا للفَرائِضِ والوسائِلْ",54,"ل",1,0],["منادي والندانابع من الوجدان للوجدان","اذاما ينطق احساسي حديثي يشبه سكاتي",55,"ت",2,0],["منادي الفلاح يرش العطور","ولمّ أتذوق من الشعر شيا",56,"ي",2,0],["من ادعى الحب لم تظهر دلائله","فحبه كذب قول بلا عمل",57,"ل",1,0],["مَنْ أدرَكَتْ كلُّ الكواكبِ أنه","نجمُ النجومِ ورائدُ الرواد",58,"د",1,0],["من أدَّى فيه فريضة ًفكأنَّها","سبعون فرضاً في سوى رمضان",59,"ن",1,0],["منادهه وقت اللقا يحسب لجيتهم حساب","وحضور هذا الوقت شاهدها على غيابها",60,"ب",3,0],["منادياً صوت صور في مسامعنا","لم يبق للموت خطوات سوى قدمِ",61,"م",1,0],["من اديار نبتها شيح وعرار","والشقارا والزهور اليانعات",62,"ت",1,0],["من ادركتْه فيا سعادةَ دارِهِ","دنيا وأخرى، والقلوبُ تفاؤل",63,"ل",1,0],["مُنادٍ على الأطيافِ طيفَ حبيبِها","لكي تختفي عنّي الغيومُ ومُرُّها",64,"ر",3,0],["من آدم لابنه شيث وهاك إلى","من قال باسمك مجريها ومرسيها",65,"ي",3,0],["منادر مثل ري السباع بيوتهم","ريف اليتامى وَالسنين غلاه",66,"ا",2,0],["مَنادر مَعاني لِلمَخاليق وَالمَلا","زبن المَجنا وَالطَنيب إِن حال",67,"ل",1,0]]}