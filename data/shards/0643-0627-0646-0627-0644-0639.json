,[5829,"صدع الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=177716",""],[5912,"ثنائيات","https://www.poetsgate.com/ViewPoem.aspx?id=203934",""],[5956,"أكمل صديق","https://www.poetsgate.com/ViewPoem.aspx?id=202393",""],[6052,"بستان جهدي","https://www.poetsgate.com/ViewPoem.aspx?id=50109",""],[6069,"وقفت مع العشاق في كل موقفٍ","https://www.poetsgate.com/ViewPoem.aspx?id=105709",""],[6124,"أراك اليوم يا قلب","https://www.poetsgate.com/ViewPoem.aspx?id=193252",""],[6147,"شهوة سريالية.. ليلة سقوط بغداد..","https://www.poetsgate.com/ViewPoem.aspx?id=151487",""],[6229,"شواظ جحيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65205&r=&rc=29",""],[572,"وَجَارِيَة ٍ تَنَالُ النَّفْسُ مِنْهَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9184&r=&rc=41",""]],"verses":[["كانَ العَظيمَ وَغَيرُ بَد","عٍ مِنهُ إِن رَكِبَ العَظيما",0,"م",2,0],["كَأَنَّ العَينَ بَعدَ اليَومَ جُرحٌ","إِذا طَبّوا لَهُ غَلَبَ العِلاجا",1,"ج",2,0],["كأنّ العِراقِيّينَ عنْدَ سَماعِها","وقدْ غصّ حفْلُ القَوْمِ نحْلٌ على شُهْدِ",2,"د",1,0],["كَأَنَّ العُداةَ إِذا ما بَدا","يَخافونَ وَرداً أَبا أَشبُلِ",3,"ل",1,0],["كأن العالم العُلوِيَّ سِفرٌ","نطالعهُ ولسنا مفصحينا",4,"ن",2,0],["كانَ العِنانُ عَلى أَبيكَ مُحَرَّماً","وَالكيرُ كانَ عَلَيهِ غَيرَ حَرامِ",5,"م",1,0],["كأن العلى شخصٌ لهم منه قد سعا","وفي الناسِ كعبٌ للعلى ودماغ",6,"غ",1,0],["كان العزيرُ زماناً","لا دَرَّ درُّ العُزيرِ",7,"ر",1,1],["كأن العناقيدَ الجِعادَ تهدَّلتْ","بهن على أعْجازهنَّ الفَرادس",8,"س",1,0],["كَأَنَّ العُيونَ المُرسِلاتِ عَشِيَّةً","شَآبيبَ دَمعٍ لَم تَجِد مُتَرَدَّدا",9,"د",2,0],["كَأَنَّ العِرمِسَ الوَجناءَ مِنها","عَجولٌ خَرَّقَت عَنها الصِدارا",10,"ر",2,0],["كانَ العَزيزُ سَدّة الفَضل الَّتي","اِنقَلَب الراجُون مِنها بِالحِبى",11,"ا",1,0],["كَأَنَّ العيسَ كانَت فَوقَ جَفني","مُناخاةٍ فَلَمّا ثُرنَ سالا",12,"ل",2,0],["كَأَنَّ العِدا في أَرضِهِم خُلَفاؤهُ","فَإِن شاءَ حازوها وَإِن شاءَ سَلَّموا",13,"م",3,0],["كَأَنَّ العُيونَ الفاتِناتِ تَعاوَنَت","عَلى تِرَةٍ عِندَ العُيونِ الذَوارِفِ",14,"ف",1,0],["كَأَنَّ العَذارى تَمَشّى بِها","إِذا هَزَّتِ الريحُ أَفنانَها",15,"ن",3,0],["كَأَنَّ العَنكَبوتَ تَبيتُ تَبني","عَلى الخَيشومِ مِن زَبَدِ اللُغامِ",16,"م",1,0],["كَأَنَّ العيسَ حينَ أُنِخنَ هَجراً","مُفَقَّأَةٌ نَواظِرُها سَوامي",16,"م",2,0],["كأن العقيق بكاساتها","تفيض السقاة عليه العبيرا",17,"ر",2,1],["كأنَّ العَقيقَ بكاساتِها","تَفُضُّ السُّقاةُ عليها العَبيرا",18,"ر",2,0],["كَأَنَّ العَينَ لَم تَرَ ما تَقَضّى","وَإِن بَقِيَ التَوَهُّمُ مِن خَيالِه",19,"ل",2,0],["كأنَّ العينَ تُسْقِطُ مِنهُ عيناً","فَلُؤلُؤهُ إِذا ذَرَفَت عَقيقُ",20,"ق",1,0],["كَأَنَّ العَهدَ عَن عُفرٍ لَدَينا","وَإِن كانَ التَلاقي عَن تَلاقِ",21,"ق",1,0],["كَأَنَّ العَنبَرَ الهِندِيَّ فيهِ","وَفَأرَ المِسكِ مَفضوضَ الرُضابِ",22,"ب",1,0],["كَأَنَّ الْعُصَيْفِيرَ اسْتُطِيرَ فُؤَادُهُ","سُرُوراً بِرَبِّ الْمَكْرُمَاتِ الْجَسَائِمِ",23,"م",1,0],["كَأَنَّ العُيونَ المُرسِلاتِ عَشِيَّةً","شَآبيبَ دَمعِ العَبرَةِ المُتَحاتِنِ",24,"ن",1,0],["كَأَنَّ العامَ لَيسَ بِعامِ حَجٍّ","تَغَيَّرَتِ المَواسِمُ وَالشُكُولُ",25,"ل",1,0],["كانا لَعَمري عالِيَينِ عَلى الوَرى","وَعَلَيهِما لا شَكَّ أَصبَحَ عالِيا",26,"ي",2,0],["كأنّ العِتاقَ الجُرْدَ مجْنوبَةً لَهُ","ظِباءٌ ثَنَتْ أجيادَها وهي تُتْلع",27,"ع",1,0],["كَأَنَّ العَذارى حينَ قَوَّمنَ حَولَها","قَلائِدَ بدلهُنَّ أُمَّ القَلائِدِ",28,"د",1,0],["كَأَنَّ العالَمينَ صُلوا هَجيراً","فَما يُلفي بِهِ أَحَدٌ مَقيلا",29,"ل",2,0],["كأن العيس كانت فوق جفني","مناخات فلما ثرن سالا",30,"ل",2,0],["كان العراقُ سواداً من مزارعه","على بنيهِ يفيءُ الظلُ والثَمَر",31,"ر",1,0],["كأنَّ العبيرَ بأردانهِ","على كلِّ \" خاطرةٍ \" يَنْفح",32,"ح",1,0],["كان العزاء لنا والصبر إن عبثت","حوادث الدهر عزّانا وسلانا",33,"ن",2,0],["كان العفافُ بها غراماً والتُّقَى","خُلقاً وكان لها الإباء ملاكا",34,"ك",2,0],["كَأَنَّ العَجاجَةَ عارِضٌ وَكَأَنَّما","بِهِ المَشرَفِيّاتُ المَواضي عَقائِقُ",35,"ق",1,0],["كان العزيز يخافني","فاليوم أخضع للحقير",36,"ر",1,0],["كَأَنَّ العُلى في مَضرَبِ النَجمِ رابِضٌ","يُخال إِلَيهِ هابِطاً بِقَلائِد",37,"د",1,0],["كأنّ العطايا والمنايا نوافلٌ","يجود بها مِنْ منُصُل وبنَان",38,"ن",1,0],["كأن العزيز له زاجر","بجدواه فهْو ذليل أسير",39,"ر",1,0],["كأنّ العطايا والمنايا نوافِلٌ","يجود بها في حين يَرْضَى ويَغْضَب",40,"ب",1,0],["كأنّ العَبير لها تُرْبَةٌ","تَضَوّع في صُبْحِها والمساء",41,"ا",2,0],["كأَنَّ الْعِيسَ خابِرَةٌ إِلى مَنْ","بِنا تَطْوِي الْمَخارِمَ وَالْفِجاجا",42,"ج",2,0],["كَأنّ العينِ خالَطها قَذاها","لِخزنٍ واقعٍ أفنى كراها",43,"ا",3,1],["كأنَّ العُلى مِيراثُه فَمُحمَّدٌ","أخوهُ عَليها كالشَّرِيكِ المُقاسِمِ",44,"م",1,0],["كأنَّ العُلى مَحمولةٌ يوم حَملهِ","يسيرُ بها فوقَ الرجال سَريرُ",45,"ر",1,0],["كانَ العزيزَ وقد بدا","وعليه للذل انكسار",46,"ر",1,0],["كأن العيس تشجيها المغاني","فتشجينا حنيناً أو رغاءا",47,"ا",3,0],["كأنّ العلى ملكٌ لماضي يمينه","تلبي بصدقٍ ما أرد ضميرهُ",48,"ه",1,0],["كأنّ العذارَ على خدّه","فذالكُ من مشقةِ الكاتبِ",49,"ب",1,0],["كأنَّ العُلا خُيِّرَت في الوُلاةِ","وأعطيَ سلطانُهُنَّ احتكامَهْ",50,"م",2,0],["كَأَنَّ العِدى لَمَّا اصْطَلَوا حرَّ نارِهِ","أَصابَ هواديهمْ مِنَ الجَوِّ حُسبانُ",51,"ن",1,0],["كأنَّ العِشارَ المُثْقلات أجاءَها","مخاضٌ فجاءت بين موفٍ وواضع",52,"ع",1,0],["كأنّ العهْرَ فينا منْ","ذُ ازمان يلاغينا",53,"ن",2,0],["كأن العلى من قبل ورد عقيمة","فليس لها يا ورد غيرك من بكر",54,"ر",1,0],["كأَنَّ العلمَ سَهلٌ ليس فيه","عَويصٌ فيه قد حارت عُقولُ",55,"ل",1,0],["كَأَنَّ العازِفَ الجِنِّي","يَ أَو أَصواتَ أَنواحِ",56,"ح",1,0],["كأنَّ العُودَ حين تَجُسُّ مِنْهُ","يعبِّرُ عَنْ سرائِرِ ما أجَنَّتْ",57,"ت",1,0],["كان العراق بعرضه وبطوله","والعرب في سور من الحدثان",58,"ن",1,0],["كأَنَ العاجَ مبتسماً عليها","شموسٌ يبتسمنَ إلى شموس",59,"س",1,0],["كأن العقيليينَ يومَ لقيتُهم","فراخُ القطا لاقينَ اجدَلَ بازيا",60,"ي",2,1],["كأن العلا والمجد قال لقطبها","فتى أحمد فاصعد فدونَك سُلّما",61,"م",2,0],["كانَ العَمَى أولَى بِهِ مِنَ الهُدَى","ما قَدَّرَ اللَّهُ الحَكيمُ في الأزَل",62,"ل",1,0],["كان العليم فكان من ايجاده","طرفاهما بعد الارادة والقدم",63,"م",1,0],["كَأنَّ العيونَ اللامحاتِ إذا بدا","تَمُجُّ عليهِ أُرجُوّاناً وعندَما",64,"م",2,0],["كان العذار بها فأنبت إذ نفرت","وإنما الذنب فيها للذي خأنا",65,"ن",2,0],["كأن العيون النجل صيغت بجلده","رأت رقباء فهي مشطورة خزرُ",66,"ر",1,0],["كأنَّ العُلى حلي كأنهمُ يد","كأنَّ الورى جيد كأنَّهم العقد",67,"د",1,0],["كان العزاء ولى العهد بعد أمي","ن الله، والملك وقف بين هذهين",68,"ن",1,1],["كأن العلا ألقى اليه زمامه","يصرفه في الخافقين كما يرى",69,"ر",2,0],["كَأَنَّ العُلا في راحَتَيكَ هي الجَنى","وَدَوحَتُها الكُبرى شَمائِلُكَ الزُهرُ",70,"ر",1,0],["كان العماد لنا في كل حادثة","تأتي بها نائبات الدهر والقدر",71,"ر",1,0],["كان العلم في الدنيا جوزا","وصار له بكفيه لجاما",72,"م",2,0],["كأنّ العيون الطافيات بدمعها","زوارق كادت ان تعوم وتغرقا",73,"ق",2,0],["كان العصام لها من كل طارقة","تطيش من عظمها الأحلام والفكر",74,"ر",1,0],["كان العراق لمثلها متشوقا","بشرى المشوق فقد اتاه الشائق",75,"ق",1,0],["كأنَّ العذرَ في الآذانِ خُرصُ","معاذَ اللهِ لا أختارُ عُذرا",76,"ر",2,0],["كأن العذول على ثغره","ذبابٌ يلوح له سُكَّر",77,"ر",1,0],["كأنَّ العُفاةَ على بابِهِ","عفاةُ المُحَصَّبِ ترمي الجِمارا",78,"ر",2,0],["كأن العذارى حول أهرامك التي","بنيت قرابين تساق لمعبد",79,"د",1,0],["كَأَنّ العلا درّ يطاه ذوو العَمى","وَيُخطئه بعد العنا كف لاقط",80,"ط",1,0],["كأن العلى مفتونةٌ بخصاله","فجافت سواها من خصالا الأماجد",81,"د",1,0],["كَأَنَّ العرسَ في قانا لشهمٍ","وقاهُ اللَه مِن عَينِ الحَسودِ",82,"د",1,0],["كان العظيم رماده فدياره","مأوى الضيوف، بكل خير عامره",83,"ر",2,0],["كانَ العِشقَ معشرٌ ما لهُمُ رَك","ضي إِذا ما تَناءتِ الأشواطُ",84,"ط",1,0],["كانَ العَتيقُ لَهُم مَثوىً وَمَعرَكَةً","فيهِ الفَرائِضُ وَالأَوصالُ وَاللَمَمُ",85,"م",1,0],["كأنّ العالمينَ رَضُوا بِذُلٍّ","فكلٌّ عينُه عيٰنٌ غَضوضُ",86,"ض",1,0],["كأنّ العُيُونَ الكُحل صيغت بِجلده","له رُقباً فهنّ مشطورةٌ خُزرُ",87,"ر",1,0],["كأنّ العوَادي الزُرقَ عنهُ مضاؤُها","وخُضرُ السحَابِ من نداهُ عُبَابُهَا",88,"ب",3,0],["كأن العمر نيرانٌ تلظَّت","وأودعت العواذل خافقينا",89,"ن",2,1],["كان العراقُ سماءً أرضها عزٌّ","على سَمَا العزِّ تمشي اليومَ أقزامُ",90,"م",1,0],["كَأنَّ العَُرفَ مِنْهُ المَِسْكُ نَشْرًا","وَلمْ يَكُ مَسَّ مِسْكًا أذْفَرِيَّا",91,"ي",2,0],["كانَ العراقُ وكانَ الطيبُ فيهِ صباً","على فراتيهِ جالتْ تَصطفي رفدا",92,"د",2,0],["كانَ العواذلُ يطلبونَ تحجُّجاً","واليومَ منْ فرطِ الفراقِ تجنَّبوا",93,"ب",3,0],["كَانَ العَدوُّ يعدُّ عُدتَهُ وَلا..","إِعدادَ بَينَ العُربِ إلا للخِصام",94,"م",1,0],["كأن العمر حلمٌ أو لقاءٌ","قصيرٌ في دجى الأحلام داما",95,"م",2,0],["كأنّ العمر إعصارٌ قويٌ","وعشقكم الربيعُ به اكتفاءُ",96,"ا",2,0],["كان العراقُ ومازال العراقُ ندىً","طَعْمُ الحضارةِ من أندائِهِ عَذُبا",97,"ب",2,0],["كان العراقُ وما زالَ العراق مُدى","في صدرِ من خانها واستقدمَ الغربا",97,"ب",2,0],["كأنّ العشقَ في وطني حرامُ","أيا ليلى، فهل حبّي يُضامُ",98,"م",1,0],["كأن العش حين خلا وأقوى","ومتا به صدى النغم الحنون",99,"ن",1,0],["كان العتب للوقت للهم لل آه ..!","للي رسم حلمه تحقق نكاده ..!!!",100,"د",2,0],["كَأَنَّ العَقْلَ زَالَ وَحُقَّ قَوْلٌ","أَلَيْسَ العِشْقُ إِلَّا لِلسَّكَارَى",101,"ر",2,0],["كأن العمرَ.. من غَدَقٍ تسامىٰ","يمدُّ الأرضَ . . بالماء الزلالِ",102,"ل",1,0],["كأن العرب في الانواء ريش","تقاذفه الرياح وتستريح",103,"ح",1,0],["كأنَّ العِشْقَ فِيْكَ دواءُ روحي","إِذا أَحْبَبْتُكَ اسْتَرْجَعْتُ ذاتي",104,"ي",1,0],["كان العظيمَ وما يزال مُعَظَماً","بعد التقاعد مالكاً ألبابنا",105,"ن",2,0],["كأن العمر صار له ملاذ","ويسكن في ربوع القلب وِردي",106,"د",2,0],["كأن العيون النجل قاسمنه الهوى","لأن عليها مسحةً من سقامه",107,"م",2,0],["كَأَنَّ العُمْرَ قَدْ شَاخَ","كَلَحْنٍ مِنْ أغَارِيْدكْ",108,"ك",1,0],["كأنّ العروبة قد حبّلوها","بِمَنْيٍ لَطيخٍ من البَغْي زورا",109,"ر",2,0],["كأنّ العروبةَ عندكِ صَرْحٌ","وما باسمها يُعلنون انهيار",110,"ر",1,0],["كأنَّ العودَ حينَ تحسُّ منهُ","يُعَبِّرُ عَنْ سَرَائِرِ مَا أَجَنَّتْ",111,"ت",1,0]]}