وَهُّما",104,"م",2,0],["فما نَجْمُ الهدى إِلّا سِناني","ولا فَلَقُ الضُّحى إِلّا حُسامِي",105,"م",2,0],["فما ناكر حكم المنية عاقل","ولا جازع من حكمة اللَه محنت",106,"ت",1,0],["فما نحن ممن عزّ إِذ هو موسرٌ","وهان على الأيام إِذ هو بائس",107,"س",1,0],["فما نَفَضْتُ يدي عن وصفِ طلْعَتِه","حتى أناخَ بنا للفضلِ عُنوانُ",108,"ن",1,0],["فما ندري أثرناها مطايا","نواحلَ أو بريناها قِسِيَّا",109,"ي",2,0],["فما نفرت من الغرباء إلا","أوت منه إلى ولدٍ وصهرِ",110,"ر",1,0],["فما نازحُ الدارِ قاصٍ عليكَ","وإنْ بعُدتْ عنك بُلْدانها",111,"ن",3,0],["فما نقسها إلا سوادُ عجاجةٍ","ولا شكيها إلا قناً ومناصل",112,"ل",1,0],["فما نلت حظّ العلم والوقت ممكنٌ","ولا عشتُ لما فاتني عيش جاهل",113,"ل",1,0],["فما نلت فيهِ الخبزَ إلاَّ بشافعٍ","ولا الماءَ إلاَّ أن يكون بحاجب",114,"ب",1,0],["فمانامَ يقظانٌ أثارَ مطيَّهُ","الى المجدِ تسري بالجَحاجِحِ كومُها",115,"م",3,0],["فما نفض الكفين من ترب قبره","لمثبوث دمع بل لموروث مارق",116,"ق",1,0],["فما نفْعُكَ يا عِلْمُ؟!","رضيت الجهلَ رُبّانا؟!",117,"ن",2,0],["فما نرسل اللحظ الا اختلاسا","ولا نرفَع الطّرف الاّ انكِسَارا",118,"ر",2,0],["فما ندافع بالهجران فهو على","أن لا يزول هوانا مشفق حدب",119,"ب",1,0],["فما نَكَدٌ مِثلُ الرُّعاةِ تَراهُمُ","غداً نَهيُهم نَهياَ وأمرُهمُ أمرا",120,"ر",2,0],["فَما نظَمُوا فيهِ القَوافِي لآلئاً","بَلَى نظَموا حبَّات قلبِهمُ عِقدَا",121,"د",2,0],["فَما نسيت فداكَ الناسُ كلُّهُمُ","وَما أَثمَرُ من أَهلٍ وَمِن مالِ",122,"ل",1,0],["فَما نَفعُكم إنْ نِلتُمُ منه غِيلَةً","وما ضرَّه أنْ زَلَّ في التُّرْبِ هاويا",123,"ي",2,0],["فَما نَلتقي إلّا عَلى نشوةِ الكرى","بكلّ خُدارِيٍّ من اللّيل حالِكِ",124,"ك",1,0],["فما نلاقِي منهُمُ","إِلّا رَميماً مُخْلَقا",125,"ق",2,0],["فَما نَفَقنا عَليهم من غَباوَتهمْ","وما علينا بشيءٍ منهُمُ نفقوا",126,"ق",3,0],["فَما نحنُ للأقدار إلّا رَمِيَّةٌ","يُصِبن صميماً أو يُصبن شَغافا",127,"ف",2,0],["فَما نَرجُو لِتيهَتِنا رشاداً","وَلا نَرجو لِضيقتنا اِنفِراجا",128,"ج",2,0],["فَما نالَ المُنى في العَيشِ إِلّا","غَبِيُّ القَومِ أَو فطنٌ تغابى",129,"ب",2,0],["فَما نَخشى الضَلالَ وَهُم نُجومٌ","تُرينا الهَديَ في اللَيلِ البَهيمِ",130,"م",1,0],["فَما نَجا مِنْك لا مَن كانَ في شَرفٍ","فوقَ السَّماءِ ولا مَن كانَ في نَفَقِ",131,"ق",1,0],["فَما نُطفَةٌ بِالطَودِ أَو بِضَرِيَّةٍ","بَقِيَّةُ سَيلٍ أَحرَزَتها الوَقائِعُ",132,"ع",1,0],["فَما نَسّى حَبيبَكَ مِثلُ نَأيٍ","وَلا بَلّى جَديدَكَ كَاِبتِذالِ",133,"ل",1,0],["فَما نَوَّمَت حَتّى اِرتَمى بِنقالِها","مِنَ اللَيلِ قُصوى لابَةٍ وَالمُكَسَّرُ",134,"ر",1,0],["فَما نَظروا القِرى وَرأوا وجُوهاً","قليلاً في تأَمُّلِهَا الوَسِيلُ",135,"ل",1,0]]}