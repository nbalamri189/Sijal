","الطويل"],[429,"يروع الذئب حيث سواك راع","https://www.aldiwan.net/poem12377.html","الوافر"],[429,"لأية حال فيض دمعك هتان","https://www.aldiwan.net/poem12754.html","الطويل"],[436,"أهنيكما ما يهنئ الدين منكما","https://www.aldiwan.net/poem34766.html","الطويل"],[436,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[438,"عزاء وصبرا كل حي فميت","https://www.aldiwan.net/poem14441.html","الطويل"],[450,"سواي استمالته الظباء الأوانس","https://www.aldiwan.net/poem13805.html","الطويل"],[450,"أرن في عذبات الأيك مرنان","https://www.aldiwan.net/poem13930.html","البسيط"],[456,"لعل الركب أن خلصوا نجيا","https://www.aldiwan.net/poem55813.html","الوافر"],[456,"لعمر الواشيات بأم عمرو","https://www.aldiwan.net/poem56176.html","الوافر"],[459,"تود الجحاجيح من خندف","https://www.aldiwan.net/poem15115.html","المتقارب"],[462,"نعم هذه آثارهم والمنازل","https://www.aldiwan.net/poem3164.html","عموديه"],[462,"أما وبنات الفكر حلفة فاضل","https://www.aldiwan.net/poem3336.html","عموديه"],[462,"لحمى الله بستاناً صبحت به الطوى","https://www.aldiwan.net/poem3363.html","عموديه"],[475,"مغاني الهوى لم يبق إلا رسومها","https://www.aldiwan.net/poem15188.html","الطويل"],[477,"على ضفة الوادي بقتة شاهق","https://www.aldiwan.net/poem37574.html","الطويل"],[503,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[504,"أقول وآنست بالليل نارا","https://www.aldiwan.net/poem2433.html","المتقارب"],[511,"لا تلزمني في رعي الهوى سرفا","https://www.aldiwan.net/poem67791.html","البسيط"],[536,"اسال من الأجفان عن صدره نهرا","https://www.aldiwan.net/poem48140.html","عموديه"],[536,"تأخرت عن صوغ القريض له قصدا","https://www.aldiwan.net/poem48216.html","عموديه"],[538,"أوصي غنيا فما أنفك أذمره","https://www.aldiwan.net/poem56708.html","الطويل"],[549,"ألا غاد دمع العين إن كنت غاديا","https://www.aldiwan.net/poem47140.html","الطويل"],[549,"ألا يا ابنة الحيين ما لي وما لك","https://www.aldiwan.net/poem47344.html","الطويل"],[549,"أرق عيني طارق","https://www.aldiwan.net/poem47360.html","مجزوء الرجز"],[549,"يهون عندكم أني بكم أرق","https://www.aldiwan.net/poem47381.html","البسيط"],[549,"رأيتكم تجنون ما قد غرستم","https://www.aldiwan.net/poem47392.html","الطويل"],[549,"أمنك الشوق أرقني فهاجا","https://www.aldiwan.net/poem47908.html","الوافر"],[549,"إذا لم تستطع للرزء دفعا","https://www.aldiwan.net/poem48080.html","الوافر"],[561,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[573,"ليل الحمى بات بدري فيك معتنقي","https://www.aldiwan.net/poem3047.html","البسيط"]],"verses":[["فَما نُلائِمُ إِلّا عادَ مُنصَدِعاً","وَلا نُثَقِّفُ إِلّا عادَ مَأطورا",0,"ر",2,0],["فَما نيلُ مِصرٍ إِذ تَسامى عُبابُهُ","وَلا بَحرُ بانِقيا إِذا راحَ مُفعَما",1,"م",2,0],["فَما نِعمَةٌ مَشكورَةٌ لا يَبُثُّها","وَما سيرَةٌ مَحمودَةٌ لا يَسيرُها",2,"ر",3,0],["فَما نَستَزيدُ اللَهَ بَعدَ نِهايَةٍ","لِنَفسِكَ غَيرَ الخُلدِ إِذ أَنتَ كامِلُ",3,"ل",1,0],["فَما نُسِيَ الإِلفُ الَّذي كانَ بَينَنا","لِطولِ تَنائينا وَلا ضُيِّعَ العَهدُ",4,"د",1,0],["فَما نَقَعَت نَفسي بِما أَمَروا بِهِ","وَلا عِجتُ مِن أَقوالِهِم بِفَتيلِ",5,"ل",1,0],["فَمَا نَوَّلَت حَتَّى تَضَرَّعَتُ عِندَها","وأَعلَمتُها مَا رَخَّصَ اللَّهُ في اللَّمَم",6,"م",1,0],["فما نحن إلا كالظماء وإنهم","كساقٍ يُرينا الماء عَذباً ولا يسقي",7,"ق",2,0],["فما نحن بعد اليوم مهما تنوّعت","عناصرنا من أمةٍ تَحمل الخَسفا",8,"ف",2,0],["فَما ناصَفَتنا في الحِفاظِ مُجاشِعٌ","وَلا قايَسَت بِالمَجدِ إِلّا نَضيمُها",9,"م",3,0],["فَما نَكَراهُ غَيرَ أَنَّ اِبنَ مِلقَطٍ","أَراهُ وَقَد أَعطى الظُلامَةَ أَوجَرا",10,"ر",2,0],["فَمَا نَفَعَ المُستأخِرِينَ نَكِيصُهم","ولا ضَرَّ أهلَ السَّابِقَاتِ التَّعَجُّلُ",11,"ل",1,0],["فَما نَطَقوا وَلَو نَطَقوا لَقالوا","صَدَقتَ وَكُنتَ ذا رَأيٍ مُصيبِ",12,"ب",1,0],["فما نيلتْ أنوفهُمُ بذمٍّ","ولا رِيمت رؤوسهُمُ بعَكس",13,"س",1,0],["فَما نَهِلَت حَتّى أَجاءَت جِمامَهُ","إِلى خَرِبٍ لاقى الخَسيفَةَ خارِقُه",14,"ق",2,0],["فَما نَفَعَ التَوبيخُ مِن ذي مَوَدَّةٍ","وَلا لَومُهُ يُغني وَلا عَتبُهُ يُجدي",15,"د",2,0],["فَما نَلتَقي إِلّا عَلى حُلمِ هاجِدٍ","يُحِلُّ لَنا جَدواكِ وَهيَ حَرامُ",16,"م",1,0],["فَما نَصَرَتني الأَزدُ مَرجُوَّ نَصرِها","وَلا رَجَعَت حَقّي إِلَيَّ تَميمُ",17,"م",1,0],["فَما نَأى المُستَقيمُ مِنهُ وَلا","عَلَيَّ أَعيَت جَهالَةً أُبَنُه",18,"ن",2,0],["فَما نَطَفَت كَأسٌ وَلا طابَ طَعمُها","ضَرَبتَ عَلى جَمّاتِها بِالمَشافِرِ",19,"ر",1,0],["فما نبهت جفنا من رقاد","ولا أطلقت دمعا من وثاق",20,"ق",1,0],["فمَا نُخاطِبُكم إلاّ بسادتِنا","ولا نُنادِيكُمُ إلا مَوالينا",21,"ن",2,0],["فما نبالي إذا فُزْنا بِديمَتِهِ","أن يُمْسَكَ الغَيْثُ أو أن تَهلِكَ الدِّيَمُ",22,"م",1,0],["فَما نُوَبُ الحَوادِثِ باقياتٌ","وَلا البُؤسى تَدومُ وَلا النَعيمُ",23,"م",1,1],["فَما نَرعَوي لَأَعاجيبِها","وَلا لِتَصَرُّفِ حالاتِها",24,"ت",3,0],["فَما نَفعي بِحُسنٍ في خَليلٍ","إِذا لَم يَصفُ لي مِنهُ الخِلالُ",25,"ل",1,0],["فَمَا نَكْبَةٌ إِلا وَأَنْتَ رَسُولُهَا","وَلا خَيْبَةٌ إِلا وَأَنْتَ لَهَا أَصْلُ",26,"ل",1,0],["فما نهاني مشيبي","عنها ولكنْ نهاها",27,"ه",2,0],["فما نعالجُ خرقاً من مهازلنا","إلا بأوسعَ منه في مآسينا",28,"ن",2,0],["فما نُصابح إلا مَن يُماسينا","ولا نُراوح إلا مَن يُغادينا",28,"ن",2,0],["فما نصدِّقُ أفواهاً بألسنةٍ","ما لم يُقمْنَ عليهنَّ البراهينا",28,"ن",2,0],["فَما نِلتَ مِنها مَحرَماً غَيرَ أَنَّنا","كِلانا مِنَ الثَوبِ المُوَرَّدِ لابِسُ",29,"س",1,0],["فَما نَلتَقي مِن بَعدِ يَأسٍ وَهِجرَةٍ","وَصَدعِ النَوى إِلّا وَجَدتُ لَها بَردا",30,"د",2,0],["فَما نابَ عَن خِلِّ الصِبا خِلُّ شَيبَةٍ","وَلا عاضَ مِن شَرخِ الشَبابِ خِضابُ",31,"ب",1,0],["فما نظرَ المُسالمُ أين تبغي","ولا عرفَ المُساوِمُ ما تُريدُ",32,"د",1,0],["فما نخشى الخُطوبَ وإن ألحّتْ","ولا يفنَى العتادُ وإن فنينا",33,"ن",2,0],["فَما نَنسَ مِن سوءٍ ذَكَرنا حُكومَةً","أَقامَت عَلى مِصرٍ مِنَ الظُلمِ قَيِّما",34,"م",2,0],["فَما نَعَمَت نَفسُ اِمرِئٍ ما نَعِمتُما","وَلا غَنِمَت ما نِلتُما مِن مُغانِمِ",35,"م",1,0],["فما نَجتِ النِّساءُ ولا الذراري","ولا سَلِمَ الشَّبابُ ولا الكُهولُ",36,"ل",1,0],["فَما نِلتَنا غَدراً وَلَكِن صَبَحتَنا","غَداةَ اِلتَقَينا بِالمَضيقِ بِأَخيُلِ",37,"ل",1,0],["فما نَظَمْتُ مدِيحاً فيهِ مُبْتَكراً","إِلَّا أَتانِيَ جُودٌ منه مُبْتَكرُ",38,"ر",1,0],["فما نَقَموا أنّ الصّنيعَةَ لم تكُنْ","ولكنّها منهم شَناشِنُ أخْزَمْ",39,"م",1,0],["فَما نَجَدَت بِالماءِ حَتّى رَأَيتُها","مَعَ الشَمسِ في عَينَي أَباغَ تَغورُ",40,"ر",1,0],["فَما نِلتَ اِبنَ أُختِكَ قَطُّ حَتّى","بَدَأتَ بِأُمِّهِ مِن قَبلِ ذاكا",41,"ك",2,0],["فَما نَفَعَ الخِنزيرَ ما قالَ كاذِباً","وَلا سَرَّني ضِغنُ الضَغائِنِ وَالحَسَد",42,"د",1,0],["فَما نَزَلَ اليُمنُ في شَربِها","وَلا في وِعاءِ سُلافٍ نَشَج",43,"ج",1,0],["فَما نَشِطتَ لِإِخباري بِفادِحَةٍ","أَوضَعَتَ فيها وَلم أَنشُط لِأَن أَسلَك",44,"ك",1,0],["فَما نُطفَةٌ كَانَت صَبِيَر غَمامَةٍ","عَلى مَتنِ صَفوانٍ تُزَعزِعُهُ الصَبا",45,"ب",2,1],["فَما ناظر إلا بَريق صواعق","وَلا سامع إلا هَزيم مدافع",46,"ع",1,0],["فَما نبسوا لي بالجَواب وإنما","أَعدوا جواسيساً لخطويَ تتبع",47,"ع",1,0],["فما نتَّقِيهِ بحيَّاتنا","إذا هو ألقى عصا الساحرِ",48,"ر",1,0],["فما ناح قمري ولا هب عاصف","من الريح إلا خاله صوت سائل",49,"ل",1,0],["فمَا نَسِيَتْ يَوْماً وَمَا نَسِيَ ابْنَهَا","ثَوابَ تَقِيٍّ صَالِحٍ آخِرَ الدَّهْرِ",50,"ر",1,0],["فَما نَفَعَتني تُقاتي عَلَيكِ","وَلا صَرَفَت عَنكِ صَرفَ النُوَب",51,"ب",1,0],["فَما نَظَرتُ بِعَينِ السوءِ مُعتَمِداً","إِلَيهِ إِلّا وَلِلأَحشاءِ إِطراقُ",52,"ق",1,0],["فما نلت منه نائلاً غير أنني","عرفت بشأو العبد كيف التخلف",53,"ف",1,0],["فما نوب الحوادث باقيات","ولا البؤس تدوم ولا النعيم",54,"م",1,1],["فما نحفل الدنيا إذا جل ظلمها","ونحن من الأيام والعيش تنصف",55,"ف",1,0],["فما نفعتهم رأفةٌ ولطافةٌ","وهل ينفع المقباسُ في ظلمةِ القبرِ",56,"ر",1,0],["فما نالَ قلبي مُناه","وما ذاقَ غيرَ الخُطوب",57,"ب",1,0],["فما نحنُ ألا أثر","على الرملِ في السَاحِلِ",57,"ل",1,0],["فما نَورُ الأقاحي يوم جفت","أعاليه وحاديه الغمام",58,"م",1,0],["فَمَا نِلتَ إِلاَّ شِقوَةً وَضَلاَلَةً","وَفِسقاً عَلَى جَهرٍ وسِحراً وسُغنِيَا",59,"ي",2,0],["فَما نَقَلتَ إِلى غَيرِ العُلى قَدَماً","وَلا شَدَدتَ عَلى غَيرِ الثَناءِ يَدا",60,"د",2,0],["فَما نِلتَها إِلّا عَنِ الحوبِ مُعرِضاً","وَفي الجَدبِ فَيّاضاً وَفي الحَربِ مُقدِما",61,"م",2,0],["فما نظرت إلى شيء بدا أبداً","إلا وأحباب قلبي دونه لا حوا",62,"ح",3,0],["فما نديمي بحان الأنس غير فتىً","له لأخبارهم نشر وإيضاح",62,"ح",1,0],["فما نسج داود كنسج عناكب","ولا الغادة الهيفاء تزهو بخلخال",63,"ل",1,0],["فما ندري الهموم ولا الرزايا","ولا نحصي الشهور ولا السنينا",64,"ن",2,0],["فما نال خيرا نازح عن جنابه","ولا خاف ضيرا نازل منه في سعد",65,"د",1,0],["فما نحصى ولا تحصى الأعادي","وقائعه وإن شئتم فعدوا",66,"د",3,0],["فَما نَرى كَعلِيٍّ في الأَنامِ فَتَىً","سِواهُ وَالشِّبهُ نَحوَ الشِّبهِ مُجتَذَبُ",67,"ب",1,0],["فمانعُ النفسِ من إدراكِ ما طَلَبَتْ","ميلٌ إلى سَوْفَ أو ميلٌ إلى ضَجَرِ",68,"ر",1,0],["فما نفس وإن عاشت","على العيش بمغبوطه",69,"ط",2,0],["فَما نَفَعَ التَحَسُّر إِذ دَهاني","وَقَد عَلِقَت حَبائِلُهُ حِبالي",70,"ي",1,0],["فما ندري أغرَّتُه تُرينا","بياض الصُّبح أم لون العقارِ",71,"ر",1,0],["فما نلت حظا من جداه سوى الذي","يمنّ به أهل الوشاية والكيد",72,"د",1,0],["فما نستوي في الحِجا والندى","وطيّ الأمور ومنشورِها",73,"ر",3,0],["فَما نَبتَغي في لَيلِنا وَنَهارِنا","مِنَ اللَهِ إِلّا أَن يُمَدَّ لَهُ العُمرُ",74,"ر",1,0],["فَمَا نَضَارَةُ أَقْوَالٍ مُزَخْرَفَةٍ","بِخَاطِرِ مُخْطَرٍ لِكُلِّ مَحْظُورِ",75,"ر",1,0],["فما نقود حُلَى تلك القدود سوى","بذل الوجود بفرط الوجد والشغف",76,"ف",1,0],["فما نجح آمال ثنت لسواكم","عناناً وألفاظٍ على غيركم تثنى",77,"ن",2,0],["فما ناظر إلا لعلياك ناظر","ولا راحة إلا لجدواك ترفع",78,"ع",1,0],["فما نفعُ الحياةِ بلا اغتباطٍ","ولا طرب وإيناسٍ وجود",79,"د",1,0],["فما نحنُ إِلا إخوةٌ فتشارَكوا","بأفراحِ أعراسٍ وأحزانِ مأتم",80,"م",1,0],["فَما نزلت عَلى مولى سواك وَلا","أَرجو وَراءَك بعد اللَه انسانا",81,"ن",2,0],["فَما نُصْحاً لِمَجْدِكَ بَلْ مُراداً","لِما قَدْ ساءَنِي قَعَدُوا وقامُوا",82,"م",3,0],["فَما نَقَلَتْ جَرْداءُ سابِحَةٌ لَهُ","شَبِيهاً وَلا وَجْناءُ يَقْلَقُ كُورُها",83,"ر",3,0],["فَما نُوِّخَتْ حَتّى أَسَوْنا بِجُودِهِ","جِراحَ الْخُطُوبِ الْمُنْهَراتِ فُتُوقُها",84,"ق",3,0],["فَما نَخْشى مُحَارَبَةَ اللَّيَالِي","وَلاَ نَرْجُو مُسَالَمَةَ الأَعَادِي",85,"ي",1,0],["فَما نَرى قارِئَهُ مُعمِلاً","هَزَّ حَواشي عَذَباتِ اللِّسان",86,"ن",1,0],["فَما نَيلُ مِصرٍ جارِياً غَيرُ كَفِّهِ","وَإِحسانُهُ إِن ضَنَّتِ السُّحبُ وابِلُ",87,"ل",1,0],["فَما نِلتُ مِنهُ غَير أَن صَدَّ مُعرِضاً","فَأَسمَعتُهُ الشَكوى فَأَوسَعَني هَجرا",88,"ر",2,0],["فما نهيتك عن تذكارها مللا","لها ولا سلوة عنها فلا تهل",89,"ل",1,0],["فَما نَفعٌ كَنَفعِ أَبي عَلِيٍّ","وَلا أَحَدٌ يَصيرُ كَما يَصيرُ",90,"ر",1,0],["فما نُهنِهتُ عن بطلٍ كَميٍّ","ولا عن مُقلَعِطّ الرأسِ جَعدِ",91,"د",1,0],["فما نرجسُ الألحاظِ أولى بمهجَتي","ولا الوجناتُ اللاتي زَهرتُها الوَردُ",92,"د",1,0],["فَما نَبَا سيفُ عَزمي حينَ أُعْمِلُهُ","ولا خَبَا زَندُ فِكري حين أُورِيهِ",93,"ي",2,0],["فَما نكرنا مِنَ الطَيفِ المُلِمِّ بِنا","ممن هَويناهُ إِلّا قِلَّةُ الخَفرِ",94,"ر",1,0],["فما نَهاكَ وَلُوعي عن مُبَاعَدتِي","ولا ثَنَاك خُضوعي عن تَعدّيكَا",95,"ك",2,0],["فما نِلْتَ ما حاولتَ إلاَّ ذاك مغوِراً","ولا حُزتَ ما أَمَّلْتَ إذ ذاك منجدا",96,"د",2,0],["فما نزلت والهمّ يوماً بمنزلٍ","وما أقْبَلَتْ إلاَّ لأجل فراره",97,"ر",2,0],["فما نلقَى به إِلاَّ بشيراً","كأَنَّ المَيْتَ لم يندُبْهُ ناعي",98,"ع",2,0],["فما نهدَتْ عن شرْعةِ الحبِّ ناهدٌ","ولا أوهنَ الشملَ المجمّعَ وهْنانُ",99,"ن",1,0],["فما نَأْتسِي إِلّا أَسىً وتَعَزِّياً","وَمَا نلتَقي إِلّا كَرىً وتَوَهُّما",100,"م",2,0],["فما نَجْمُ الهدى إِلّا سِناني","ولا فَلَقُ الضُّحى إِلّا حُسامِي",101,"م",2,0],["فما ناكر حكم المنية عاقل","ولا جازع من حكمة اللَه محنت",102,"ت",1,0],["فما نحن ممن عزّ إِذ هو موسرٌ","وهان على الأيام إِذ هو بائس",103,"س",1,0],["فما نَفَضْتُ يدي عن وصفِ طلْعَتِه","حتى أناخَ بنا للفضلِ عُنوانُ",104,"ن",1,0],["فما ندري أثرناها مطايا","نواحلَ أو بريناها قِسِيَّا",105,"ي",2,0],["فما نفرت من الغرباء إلا","أوت منه إلى ولدٍ وصهرِ",106,"ر",1,0],["فما نازحُ الدارِ قاصٍ عليكَ","وإنْ بعُدتْ عنك بُلْدانها",107,"ن",3,0],["فما نقسها إلا سوادُ عجاجةٍ","ولا شكيها إلا قناً ومناصل",108,"ل",1,0],["فما نلت حظّ العلم والوقت ممكنٌ","ولا عشتُ لما فاتني عيش جاهل",109,"ل",1,0],["فما نلت فيهِ الخبزَ إلاَّ بشافعٍ","ولا الماءَ إلاَّ أن يكون بحاجب",110,"ب",1,0],["فمانامَ يقظانٌ أثارَ مطيَّهُ","الى المجدِ تسري بالجَحاجِحِ كومُها",111,"م",3,0],["فما نفض الكفين من ترب قبره","لمثبوث دمع بل لموروث مارق",112,"ق",1,0],["فما نفْعُكَ يا عِلْمُ؟!","رضيت الجهلَ رُبّانا؟!",113,"ن",2,0],["فما نرسل اللحظ الا اختلاسا","ولا نرفَع الطّرف الاّ انكِسَارا",114,"ر",2,0],["فما ندافع بالهجران فهو على","أن لا يزول هوانا مشفق حدب",115,"ب",1,0],["فما نَكَدٌ مِثلُ الرُّعاةِ تَراهُمُ","غداً نَهيُهم نَهياَ وأمرُهمُ أمرا",116,"ر",2,0],["فَما نظَمُوا فيهِ القَوافِي لآلئاً","بَلَى نظَموا حبَّات قلبِهمُ عِقدَا",117,"د",2,0],["فَما نسيت فداكَ الناسُ كلُّهُمُ","وَما أَثمَرُ من أَهلٍ وَمِن مالِ",118,"ل",1,0],["فَما نَفعُكم إنْ نِلتُمُ منه غِيلَةً","وما ضرَّه أنْ زَلَّ في التُّرْبِ هاويا",119,"ي",2,0],["فَما نَلتقي إلّا عَلى نشوةِ الكرى","بكلّ خُدارِيٍّ من اللّيل حالِكِ",120,"ك",1,0],["فما نلاقِي منهُمُ","إِلّا رَميماً مُخْلَقا",121,"ق",2,0],["فَما نَفَقنا عَليهم من غَباوَتهمْ","وما علينا بشيءٍ منهُمُ نفقوا",122,"ق",3,0],["فَما نحنُ للأقدار إلّا رَمِيَّةٌ","يُصِبن صميماً أو يُصبن شَغافا",123,"ف",2,0],["فَما نَرجُو لِتيهَتِنا رشاداً","وَلا نَرجو لِضيقتنا اِنفِراجا",124,"ج",2,0],["فَما نالَ المُنى في العَيشِ إِلّا","غَبِيُّ القَومِ أَو فطنٌ تغابى",125,"ب",2,0],["فَما نَخشى الضَلالَ وَهُم نُجومٌ","تُرينا الهَديَ في اللَيلِ البَهيمِ",126,"م",1,0],["فَما نَجا مِنْك لا مَن كانَ في شَرفٍ","فوقَ السَّماءِ ولا مَن كانَ في نَفَقِ",127,"ق",1,0]]}