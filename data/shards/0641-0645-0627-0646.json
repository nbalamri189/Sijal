.html","البسيط"],[413,"عاديتني حين عاديت الورى فيكا","https://www.aldiwan.net/poem32554.html","البسيط"],[420,"أقول لعبد المحسن اليوم منشدا","https://www.aldiwan.net/poem53986.html","الطويل"],[420,"أدار على الندمان كأس عقاره","https://www.aldiwan.net/poem54057.html","الطويل"],[436,"يروع الذئب حيث سواك راع","https://www.aldiwan.net/poem12377.html","الوافر"],[436,"لأية حال فيض دمعك هتان","https://www.aldiwan.net/poem12754.html","الطويل"],[443,"أهنيكما ما يهنئ الدين منكما","https://www.aldiwan.net/poem34766.html","الطويل"],[443,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[445,"عزاء وصبرا كل حي فميت","https://www.aldiwan.net/poem14441.html","الطويل"],[455,"سواي استمالته الظباء الأوانس","https://www.aldiwan.net/poem13805.html","الطويل"],[455,"أرن في عذبات الأيك مرنان","https://www.aldiwan.net/poem13930.html","البسيط"],[461,"لعل الركب أن خلصوا نجيا","https://www.aldiwan.net/poem55813.html","الوافر"],[461,"لعمر الواشيات بأم عمرو","https://www.aldiwan.net/poem56176.html","الوافر"],[464,"تود الجحاجيح من خندف","https://www.aldiwan.net/poem15115.html","المتقارب"],[467,"نعم هذه آثارهم والمنازل","https://www.aldiwan.net/poem3164.html","عموديه"],[467,"أما وبنات الفكر حلفة فاضل","https://www.aldiwan.net/poem3336.html","عموديه"],[467,"لحمى الله بستاناً صبحت به الطوى","https://www.aldiwan.net/poem3363.html","عموديه"],[480,"مغاني الهوى لم يبق إلا رسومها","https://www.aldiwan.net/poem15188.html","الطويل"],[482,"على ضفة الوادي بقتة شاهق","https://www.aldiwan.net/poem37574.html","الطويل"],[508,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[509,"أقول وآنست بالليل نارا","https://www.aldiwan.net/poem2433.html","المتقارب"],[516,"لا تلزمني في رعي الهوى سرفا","https://www.aldiwan.net/poem67791.html","البسيط"],[541,"اسال من الأجفان عن صدره نهرا","https://www.aldiwan.net/poem48140.html","عموديه"],[541,"تأخرت عن صوغ القريض له قصدا","https://www.aldiwan.net/poem48216.html","عموديه"],[543,"أوصي غنيا فما أنفك أذمره","https://www.aldiwan.net/poem56708.html","الطويل"],[554,"ألا غاد دمع العين إن كنت غاديا","https://www.aldiwan.net/poem47140.html","الطويل"],[554,"ألا يا ابنة الحيين ما لي وما لك","https://www.aldiwan.net/poem47344.html","الطويل"],[554,"أرق عيني طارق","https://www.aldiwan.net/poem47360.html","مجزوء الرجز"],[554,"يهون عندكم أني بكم أرق","https://www.aldiwan.net/poem47381.html","البسيط"],[554,"رأيتكم تجنون ما قد غرستم","https://www.aldiwan.net/poem47392.html","الطويل"],[554,"أمنك الشوق أرقني فهاجا","https://www.aldiwan.net/poem47908.html","الوافر"],[554,"إذا لم تستطع للرزء دفعا","https://www.aldiwan.net/poem48080.html","الوافر"],[566,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[578,"ليل الحمى بات بدري فيك معتنقي","https://www.aldiwan.net/poem3047.html","البسيط"],[757,"","https://poetry.dctabudhabi.ae/diwan/poem/17654","الطويل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/20911","الوافر"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/28072","الطويل"],[967,"","https://poetry.dctabudhabi.ae/diwan/poem/29446","الوافر"]],"verses":[["فَما نُلائِمُ إِلّا عادَ مُنصَدِعاً","وَلا نُثَقِّفُ إِلّا عادَ مَأطورا",0,"ر",2,0],["فَما نيلُ مِصرٍ إِذ تَسامى عُبابُهُ","وَلا بَحرُ بانِقيا إِذا راحَ مُفعَما",1,"م",2,0],["فَما نِعمَةٌ مَشكورَةٌ لا يَبُثُّها","وَما سيرَةٌ مَحمودَةٌ لا يَسيرُها",2,"ر",3,0],["فَما نَستَزيدُ اللَهَ بَعدَ نِهايَةٍ","لِنَفسِكَ غَيرَ الخُلدِ إِذ أَنتَ كامِلُ",3,"ل",1,0],["فَما نُسِيَ الإِلفُ الَّذي كانَ بَينَنا","لِطولِ تَنائينا وَلا ضُيِّعَ العَهدُ",4,"د",1,0],["فَما نَقَعَت نَفسي بِما أَمَروا بِهِ","وَلا عِجتُ مِن أَقوالِهِم بِفَتيلِ",5,"ل",1,0],["فَمَا نَوَّلَت حَتَّى تَضَرَّعَتُ عِندَها","وأَعلَمتُها مَا رَخَّصَ اللَّهُ في اللَّمَم",6,"م",1,0],["فما نحن إلا كالظماء وإنهم","كساقٍ يُرينا الماء عَذباً ولا يسقي",7,"ق",2,0],["فما نحن بعد اليوم مهما تنوّعت","عناصرنا من أمةٍ تَحمل الخَسفا",8,"ف",2,0],["فَما ناصَفَتنا في الحِفاظِ مُجاشِعٌ","وَلا قايَسَت بِالمَجدِ إِلّا نَضيمُها",9,"م",3,0],["فَما نَكَراهُ غَيرَ أَنَّ اِبنَ مِلقَطٍ","أَراهُ وَقَد أَعطى الظُلامَةَ أَوجَرا",10,"ر",2,0],["فَمَا نَفَعَ المُستأخِرِينَ نَكِيصُهم","ولا ضَرَّ أهلَ السَّابِقَاتِ التَّعَجُّلُ",11,"ل",1,0],["فَما نَطَقوا وَلَو نَطَقوا لَقالوا","صَدَقتَ وَكُنتَ ذا رَأيٍ مُصيبِ",12,"ب",1,0],["فما نيلتْ أنوفهُمُ بذمٍّ","ولا رِيمت رؤوسهُمُ بعَكس",13,"س",1,0],["فَما نَهِلَت حَتّى أَجاءَت جِمامَهُ","إِلى خَرِبٍ لاقى الخَسيفَةَ خارِقُه",14,"ق",2,0],["فَما نَفَعَ التَوبيخُ مِن ذي مَوَدَّةٍ","وَلا لَومُهُ يُغني وَلا عَتبُهُ يُجدي",15,"د",2,0],["فَما نَلتَقي إِلّا عَلى حُلمِ هاجِدٍ","يُحِلُّ لَنا جَدواكِ وَهيَ حَرامُ",16,"م",1,0],["فَما نَصَرَتني الأَزدُ مَرجُوَّ نَصرِها","وَلا رَجَعَت حَقّي إِلَيَّ تَميمُ",17,"م",1,0],["فَما نَأى المُستَقيمُ مِنهُ وَلا","عَلَيَّ أَعيَت جَهالَةً أُبَنُه",18,"ن",2,0],["فَما نَطَفَت كَأسٌ وَلا طابَ طَعمُها","ضَرَبتَ عَلى جَمّاتِها بِالمَشافِرِ",19,"ر",1,0],["فما نبهت جفنا من رقاد","ولا أطلقت دمعا من وثاق",20,"ق",1,0],["فمَا نُخاطِبُكم إلاّ بسادتِنا","ولا نُنادِيكُمُ إلا مَوالينا",21,"ن",2,0],["فما نبالي إذا فُزْنا بِديمَتِهِ","أن يُمْسَكَ الغَيْثُ أو أن تَهلِكَ الدِّيَمُ",22,"م",1,0],["فَما نُوَبُ الحَوادِثِ باقياتٌ","وَلا البُؤسى تَدومُ وَلا النَعيمُ",23,"م",1,1],["فَما نَرعَوي لَأَعاجيبِها","وَلا لِتَصَرُّفِ حالاتِها",24,"ت",3,0],["فَما نَفعي بِحُسنٍ في خَليلٍ","إِذا لَم يَصفُ لي مِنهُ الخِلالُ",25,"ل",1,0],["فَمَا نَكْبَةٌ إِلا وَأَنْتَ رَسُولُهَا","وَلا خَيْبَةٌ إِلا وَأَنْتَ لَهَا أَصْلُ",26,"ل",1,0],["فما نهاني مشيبي","عنها ولكنْ نهاها",27,"ه",2,0],["فما نعالجُ خرقاً من مهازلنا","إلا بأوسعَ منه في مآسينا",28,"ن",2,0],["فما نُصابح إلا مَن يُماسينا","ولا نُراوح إلا مَن يُغادينا",28,"ن",2,0],["فما نصدِّقُ أفواهاً بألسنةٍ","ما لم يُقمْنَ عليهنَّ البراهينا",28,"ن",2,0],["فَما نِلتَ مِنها مَحرَماً غَيرَ أَنَّنا","كِلانا مِنَ الثَوبِ المُوَرَّدِ لابِسُ",29,"س",1,0],["فَما نَلتَقي مِن بَعدِ يَأسٍ وَهِجرَةٍ","وَصَدعِ النَوى إِلّا وَجَدتُ لَها بَردا",30,"د",2,0],["فَما نابَ عَن خِلِّ الصِبا خِلُّ شَيبَةٍ","وَلا عاضَ مِن شَرخِ الشَبابِ خِضابُ",31,"ب",1,0],["فما نظرَ المُسالمُ أين تبغي","ولا عرفَ المُساوِمُ ما تُريدُ",32,"د",1,0],["فما نخشى الخُطوبَ وإن ألحّتْ","ولا يفنَى العتادُ وإن فنينا",33,"ن",2,0],["فَما نَنسَ مِن سوءٍ ذَكَرنا حُكومَةً","أَقامَت عَلى مِصرٍ مِنَ الظُلمِ قَيِّما",34,"م",2,0],["فَما نَعَمَت نَفسُ اِمرِئٍ ما نَعِمتُما","وَلا غَنِمَت ما نِلتُما مِن مُغانِمِ",35,"م",1,0],["فما نَجتِ النِّساءُ ولا الذراري","ولا سَلِمَ الشَّبابُ ولا الكُهولُ",36,"ل",1,0],["فَما نِلتَنا غَدراً وَلَكِن صَبَحتَنا","غَداةَ اِلتَقَينا بِالمَضيقِ بِأَخيُلِ",37,"ل",1,0],["فما نَظَمْتُ مدِيحاً فيهِ مُبْتَكراً","إِلَّا أَتانِيَ جُودٌ منه مُبْتَكرُ",38,"ر",1,0],["فما نَقَموا أنّ الصّنيعَةَ لم تكُنْ","ولكنّها منهم شَناشِنُ أخْزَمْ",39,"م",1,0],["فَما نَجَدَت بِالماءِ حَتّى رَأَيتُها","مَعَ الشَمسِ في عَينَي أَباغَ تَغورُ",40,"ر",1,0],["فَما نِلتَ اِبنَ أُختِكَ قَطُّ حَتّى","بَدَأتَ بِأُمِّهِ مِن قَبلِ ذاكا",41,"ك",2,0],["فَما نَفَعَ الخِنزيرَ ما قالَ كاذِباً","وَلا سَرَّني ضِغنُ الضَغائِنِ وَالحَسَد",42,"د",1,0],["فَما نَزَلَ اليُمنُ في شَربِها","وَلا في وِعاءِ سُلافٍ نَشَج",43,"ج",1,0],["فَما نَشِطتَ لِإِخباري بِفادِحَةٍ","أَوضَعَتَ فيها وَلم أَنشُط لِأَن أَسلَك",44,"ك",1,0],["فَما نُطفَةٌ كَانَت صَبِيَر غَمامَةٍ","عَلى مَتنِ صَفوانٍ تُزَعزِعُهُ الصَبا",45,"ب",2,1],["فما نام ذاكيه وما زلت قاعدا","وما زال ينمي في طريق مسلّم",46,"م",1,0],["فما نمت حتى صاح بيني وبينهم","بذات التنانير الصدى والعوازف",47,"ف",1,0],["فَما ناظر إلا بَريق صواعق","وَلا سامع إلا هَزيم مدافع",48,"ع",1,0],["فَما نبسوا لي بالجَواب وإنما","أَعدوا جواسيساً لخطويَ تتبع",49,"ع",1,0],["فَمَا نَحْنُ إِلاَّ مِنْ قُرُونٍ تُنُقِّصَتْ","بأَصْغَرَ مِمَّا قَدْ لَقِيتُ وأَكْبَرَا",50,"ر",2,0],["فمَا نيل حَتَّى مَدَّ ضَبْعِي عِنَانَهُ","وقُلْتُ مَتَى مُسْتَكْرَهُ الكَفِّ نَائِلُهْ",51,"ل",2,0],["فما نتَّقِيهِ بحيَّاتنا","إذا هو ألقى عصا الساحرِ",52,"ر",1,0],["فما ناح قمري ولا هب عاصف","من الريح إلا خاله صوت سائل",53,"ل",1,0],["فمَا نَسِيَتْ يَوْماً وَمَا نَسِيَ ابْنَهَا","ثَوابَ تَقِيٍّ صَالِحٍ آخِرَ الدَّهْرِ",54,"ر",1,0],["فَما نَفَعَتني تُقاتي عَلَيكِ","وَلا صَرَفَت عَنكِ صَرفَ النُوَب",55,"ب",1,0],["فَما نَظَرتُ بِعَينِ السوءِ مُعتَمِداً","إِلَيهِ إِلّا وَلِلأَحشاءِ إِطراقُ",56,"ق",1,0],["فما نلت منه نائلاً غير أنني","عرفت بشأو العبد كيف التخلف",57,"ف",1,0],["فما نوب الحوادث باقيات","ولا البؤس تدوم ولا النعيم",58,"م",1,1],["فما نحفل الدنيا إذا جل ظلمها","ونحن من الأيام والعيش تنصف",59,"ف",1,0],["فما نفعتهم رأفةٌ ولطافةٌ","وهل ينفع المقباسُ في ظلمةِ القبرِ",60,"ر",1,0],["فما نالَ قلبي مُناه","وما ذاقَ غيرَ الخُطوب",61,"ب",1,0],["فما نحنُ ألا أثر","على الرملِ في السَاحِلِ",61,"ل",1,0],["فما نَورُ الأقاحي يوم جفت","أعاليه وحاديه الغمام",62,"م",1,0],["فَمَا نِلتَ إِلاَّ شِقوَةً وَضَلاَلَةً","وَفِسقاً عَلَى جَهرٍ وسِحراً وسُغنِيَا",63,"ي",2,0],["فَما نَقَلتَ إِلى غَيرِ العُلى قَدَماً","وَلا شَدَدتَ عَلى غَيرِ الثَناءِ يَدا",64,"د",2,0],["فَما نِلتَها إِلّا عَنِ الحوبِ مُعرِضاً","وَفي الجَدبِ فَيّاضاً وَفي الحَربِ مُقدِما",65,"م",2,0],["فما نظرت إلى شيء بدا أبداً","إلا وأحباب قلبي دونه لا حوا",66,"ح",3,0],["فما نديمي بحان الأنس غير فتىً","له لأخبارهم نشر وإيضاح",66,"ح",1,0],["فما نسج داود كنسج عناكب","ولا الغادة الهيفاء تزهو بخلخال",67,"ل",1,0],["فما ندري الهموم ولا الرزايا","ولا نحصي الشهور ولا السنينا",68,"ن",2,0],["فما نال خيرا نازح عن جنابه","ولا خاف ضيرا نازل منه في سعد",69,"د",1,0],["فما نحصى ولا تحصى الأعادي","وقائعه وإن شئتم فعدوا",70,"د",3,0],["فَما نَرى كَعلِيٍّ في الأَنامِ فَتَىً","سِواهُ وَالشِّبهُ نَحوَ الشِّبهِ مُجتَذَبُ",71,"ب",1,0],["فمانعُ النفسِ من إدراكِ ما طَلَبَتْ","ميلٌ إلى سَوْفَ أو ميلٌ إلى ضَجَرِ",72,"ر",1,0],["فما نفس وإن عاشت","على العيش بمغبوطه",73,"ط",2,0],["فَما نَفَعَ التَحَسُّر إِذ دَهاني","وَقَد عَلِقَت حَبائِلُهُ حِبالي",74,"ل",2,0],["فما ندري أغرَّتُه تُرينا","بياض الصُّبح أم لون العقارِ",75,"ر",1,0],["فما نلت حظا من جداه سوى الذي","يمنّ به أهل الوشاية والكيد",76,"د",1,0],["فما نستوي في الحِجا والندى","وطيّ الأمور ومنشورِها",77,"ر",3,0],["فَما نَبتَغي في لَيلِنا وَنَهارِنا","مِنَ اللَهِ إِلّا أَن يُمَدَّ لَهُ العُمرُ",78,"ر",1,0],["فَمَا نَضَارَةُ أَقْوَالٍ مُزَخْرَفَةٍ","بِخَاطِرِ مُخْطَرٍ لِكُلِّ مَحْظُورِ",79,"ر",1,0],["فما نقود حُلَى تلك القدود سوى","بذل الوجود بفرط ال