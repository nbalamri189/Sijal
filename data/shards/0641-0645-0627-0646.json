"],[351,"جَاءَ البَرِيدُ بِقرطاسٍ يَخبُّ بِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=4530",""],[5458,"حاسب نفسك","https://www.poetsgate.com/ViewPoem.aspx?id=72288",""],[5464,"شبيه الياسمين يدا وخدا","https://www.poetsgate.com/ViewPoem.aspx?id=26637",""],[5493,"أتيتُ أُناجِي","https://www.poetsgate.com/ViewPoem.aspx?id=196982",""],[5533,"حنين وشوق","https://www.poetsgate.com/ViewPoem.aspx?id=176383",""],[5595,"نعلّمُ جيلنا الكتبا","https://www.poetsgate.com/ViewPoem.aspx?id=158559",""],[5615,"إلى أمي","https://www.poetsgate.com/ViewPoem.aspx?id=199704",""],[5616,"يا مصر","https://www.poetsgate.com/ViewPoem.aspx?id=203490",""],[5652,"هآك الوعود وشمريّك ..!","https://www.poetsgate.com/ViewPoem.aspx?id=175027",""],[5691,"سجال(1)","https://www.poetsgate.com/ViewPoem.aspx?id=206392",""],[5725,"أنامل سمراء","https://www.poetsgate.com/ViewPoem.aspx?id=212994",""],[5751,"كذبةُ سيف","https://www.poetsgate.com/ViewPoem.aspx?id=214773",""],[5756,"قلوبنا معكم","https://www.poetsgate.com/ViewPoem.aspx?id=5379",""],[5829,"جددي حبي","https://www.poetsgate.com/ViewPoem.aspx?id=148339",""],[5829,"البنت اللعوب","https://www.poetsgate.com/ViewPoem.aspx?id=152563",""],[5838,"أحمد أنت للإنعام أهل","https://www.poetsgate.com/ViewPoem.aspx?id=200852",""],[5956,"أرجو أن يزيد الله وعيي","https://www.poetsgate.com/ViewPoem.aspx?id=185669",""],[5956,"يعود القديم","https://www.poetsgate.com/ViewPoem.aspx?id=192371",""],[5956,"تعالوا","https://www.poetsgate.com/ViewPoem.aspx?id=195019",""],[6096,"رافض النعمة","https://www.poetsgate.com/ViewPoem.aspx?id=177722",""],[6102,"مَيس ..","https://www.poetsgate.com/ViewPoem.aspx?id=185073",""],[6139,"نجوم الليل","https://www.poetsgate.com/ViewPoem.aspx?id=212336",""],[6142,"إذا غرب سيف أم هلال المحرم","https://www.poetsgate.com/ViewPoem.aspx?id=155752",""],[5309,"قفا نحمد الأيام ان كان يحمد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573526",""],[243,"يا ليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68157&r=&rc=149",""],[6198,"عباءة الصمت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79232&r=&rc=6",""],[5355,"غدر الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87118&r=&rc=13",""],[6327,"حكاية الأيام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86568&r=&rc=3",""],[5190,"الرزق الحلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78291&r=&rc=5",""]],"verses":[["فَما نُلائِمُ إِلّا عادَ مُنصَدِعاً","وَلا نُثَقِّفُ إِلّا عادَ مَأطورا",0,"ر",2,0],["فَما نيلُ مِصرٍ إِذ تَسامى عُبابُهُ","وَلا بَحرُ بانِقيا إِذا راحَ مُفعَما",1,"م",2,0],["فَما نِعمَةٌ مَشكورَةٌ لا يَبُثُّها","وَما سيرَةٌ مَحمودَةٌ لا يَسيرُها",2,"ر",3,0],["فَما نَستَزيدُ اللَهَ بَعدَ نِهايَةٍ","لِنَفسِكَ غَيرَ الخُلدِ إِذ أَنتَ كامِلُ",3,"ل",1,0],["فَما نُسِيَ الإِلفُ الَّذي كانَ بَينَنا","لِطولِ تَنائينا وَلا ضُيِّعَ العَهدُ",4,"د",1,0],["فَما نَقَعَت نَفسي بِما أَمَروا بِهِ","وَلا عِجتُ مِن أَقوالِهِم بِفَتيلِ",5,"ل",1,0],["فَمَا نَوَّلَت حَتَّى تَضَرَّعَتُ عِندَها","وأَعلَمتُها مَا رَخَّصَ اللَّهُ في اللَّمَم",6,"م",1,0],["فما نحن إلا كالظماء وإنهم","كساقٍ يُرينا الماء عَذباً ولا يسقي",7,"ق",2,0],["فما نحن بعد اليوم مهما تنوّعت","عناصرنا من أمةٍ تَحمل الخَسفا",8,"ف",2,0],["فَما ناصَفَتنا في الحِفاظِ مُجاشِعٌ","وَلا قايَسَت بِالمَجدِ إِلّا نَضيمُها",9,"م",3,0],["فَما نَكَراهُ غَيرَ أَنَّ اِبنَ مِلقَطٍ","أَراهُ وَقَد أَعطى الظُلامَةَ أَوجَرا",10,"ر",2,0],["فَمَا نَفَعَ المُستأخِرِينَ نَكِيصُهم","ولا ضَرَّ أهلَ السَّابِقَاتِ التَّعَجُّلُ",11,"ل",1,0],["فَما نَطَقوا وَلَو نَطَقوا لَقالوا","صَدَقتَ وَكُنتَ ذا رَأيٍ مُصيبِ",12,"ب",1,0],["فما نيلتْ أنوفهُمُ بذمٍّ","ولا رِيمت رؤوسهُمُ بعَكس",13,"س",1,0],["فَما نَهِلَت حَتّى أَجاءَت جِمامَهُ","إِلى خَرِبٍ لاقى الخَسيفَةَ خارِقُه",14,"ق",2,0],["فَما نَفَعَ التَوبيخُ مِن ذي مَوَدَّةٍ","وَلا لَومُهُ يُغني وَلا عَتبُهُ يُجدي",15,"د",2,0],["فَما نَلتَقي إِلّا عَلى حُلمِ هاجِدٍ","يُحِلُّ لَنا جَدواكِ وَهيَ حَرامُ",16,"م",1,0],["فَما نَصَرَتني الأَزدُ مَرجُوَّ نَصرِها","وَلا رَجَعَت حَقّي إِلَيَّ تَميمُ",17,"م",1,0],["فَما نَأى المُستَقيمُ مِنهُ وَلا","عَلَيَّ أَعيَت جَهالَةً أُبَنُه",18,"ن",2,0],["فَما نَطَفَت كَأسٌ وَلا طابَ طَعمُها","ضَرَبتَ عَلى جَمّاتِها بِالمَشافِرِ",19,"ر",1,0],["فما نبهت جفنا من رقاد","ولا أطلقت دمعا من وثاق",20,"ق",1,0],["فمَا نُخاطِبُكم إلاّ بسادتِنا","ولا نُنادِيكُمُ إلا مَوالينا",21,"ن",2,0],["فما نبالي إذا فُزْنا بِديمَتِهِ","أن يُمْسَكَ الغَيْثُ أو أن تَهلِكَ الدِّيَمُ",22,"م",1,0],["فَما نُوَبُ الحَوادِثِ باقياتٌ","وَلا البُؤسى تَدومُ وَلا النَعيمُ",23,"م",1,1],["فَما نَرعَوي لَأَعاجيبِها","وَلا لِتَصَرُّفِ حالاتِها",24,"ت",3,0],["فَما نَفعي بِحُسنٍ في خَليلٍ","إِذا لَم يَصفُ لي مِنهُ الخِلالُ",25,"ل",1,0],["فَمَا نَكْبَةٌ إِلا وَأَنْتَ رَسُولُهَا","وَلا خَيْبَةٌ إِلا وَأَنْتَ لَهَا أَصْلُ",26,"ل",1,0],["فما نهاني مشيبي","عنها ولكنْ نهاها",27,"ه",2,0],["فما نعالجُ خرقاً من مهازلنا","إلا بأوسعَ منه في مآسينا",28,"ن",2,0],["فما نُصابح إلا مَن يُماسينا","ولا نُراوح إلا مَن يُغادينا",28,"ن",2,0],["فما نصدِّقُ أفواهاً بألسنةٍ","ما لم يُقمْنَ عليهنَّ البراهينا",28,"ن",2,0],["فَما نِلتَ مِنها مَحرَماً غَيرَ أَنَّنا","كِلانا مِنَ الثَوبِ المُوَرَّدِ لابِسُ",29,"س",1,0],["فَما نَلتَقي مِن بَعدِ يَأسٍ وَهِجرَةٍ","وَصَدعِ النَوى إِلّا وَجَدتُ لَها بَردا",30,"د",2,0],["فَما نابَ عَن خِلِّ الصِبا خِلُّ شَيبَةٍ","وَلا عاضَ مِن شَرخِ الشَبابِ خِضابُ",31,"ب",1,0],["فما نظرَ المُسالمُ أين تبغي","ولا عرفَ المُساوِمُ ما تُريدُ",32,"د",1,0],["فما نخشى الخُطوبَ وإن ألحّتْ","ولا يفنَى العتادُ وإن فنينا",33,"ن",2,0],["فَما نَنسَ مِن سوءٍ ذَكَرنا حُكومَةً","أَقامَت عَلى مِصرٍ مِنَ الظُلمِ قَيِّما",34,"م",2,0],["فَما نَعَمَت نَفسُ اِمرِئٍ ما نَعِمتُما","وَلا غَنِمَت ما نِلتُما مِن مُغانِمِ",35,"م",1,0],["فما نَجتِ النِّساءُ ولا الذراري","ولا سَلِمَ الشَّبابُ ولا الكُهولُ",36,"ل",1,0],["فَما نِلتَنا غَدراً وَلَكِن صَبَحتَنا","غَداةَ اِلتَقَينا بِالمَضيقِ بِأَخيُلِ",37,"ل",1,0],["فما نَظَمْتُ مدِيحاً فيهِ مُبْتَكراً","إِلَّا أَتانِيَ جُودٌ منه مُبْتَكرُ",38,"ر",1,0],["فما نَقَموا أنّ الصّنيعَةَ لم تكُنْ","ولكنّها منهم شَناشِنُ أخْزَمْ",39,"م",1,0],["فَما نَجَدَت بِالماءِ حَتّى رَأَيتُها","مَعَ الشَمسِ في عَينَي أَباغَ تَغورُ",40,"ر",1,0],["فَما نِلتَ اِبنَ أُختِكَ قَطُّ حَتّى","بَدَأتَ بِأُمِّهِ مِن قَبلِ ذاكا",41,"ك",2,0],["فَما نَفَعَ الخِنزيرَ ما قالَ كاذِباً","وَلا سَرَّني ضِغنُ الضَغائِنِ وَالحَسَد",42,"د",1,0],["فَما نَزَلَ اليُمنُ في شَربِها","وَلا في وِعاءِ سُلافٍ نَشَج",43,"ج",1,0],["فَما نَشِطتَ لِإِخباري بِفادِحَةٍ","أَوضَعَتَ فيها وَلم أَنشُط لِأَن أَسلَك",44,"ك",1,0],["فَما نُطفَةٌ كَانَت صَبِيَر غَمامَةٍ","عَلى مَتنِ صَفوانٍ تُزَعزِعُهُ الصَبا",45,"ب",2,1],["فما نام ذاكيه وما زلت قاعدا","وما زال ينمي في طريق مسلّم",46,"م",1,0],["فما نمت حتى صاح بيني وبينهم","بذات التنانير الصدى والعوازف",47,"ف",1,0],["فَما ناظر إلا بَريق صواعق","وَلا سامع إلا هَزيم مدافع",48,"ع",1,0],["فَما نبسوا لي بالجَواب وإنما","أَعدوا جواسيساً لخطويَ تتبع",49,"ع",1,0],["فَمَا نَحْنُ إِلاَّ مِنْ قُرُونٍ تُنُقِّصَتْ","بأَصْغَرَ مِمَّا قَدْ لَقِيتُ وأَكْبَرَا",50,"ر",2,0],["فمَا نيل حَتَّى مَدَّ ضَبْعِي عِنَانَهُ","وقُلْتُ مَتَى مُسْتَكْرَهُ الكَفِّ نَائِلُهْ",51,"ل",2,0],["فما نتَّقِيهِ بحيَّاتنا","إذا هو ألقى عصا الساحرِ",52,"ر",1,0],["فما ناح قمري ولا هب عاصف","من الريح إلا خاله صوت سائل",53,"ل",1,0],["فمَا نَسِيَتْ يَوْماً وَمَا نَسِيَ ابْنَهَا","ثَوابَ تَقِيٍّ صَالِحٍ آخِرَ الدَّهْرِ",54,"ر",1,0],["فَما نَفَعَتني تُقاتي عَلَيكِ","وَلا صَرَفَت عَنكِ صَرفَ النُوَب",55,"ب",1,0],["فَما نَظَرتُ بِعَينِ السوءِ مُعتَمِداً","إِلَيهِ إِلّا وَلِلأَحشاءِ إِطراقُ",56,"ق",1,0],["فما نلت منه نائلاً غير أنني","عرفت بشأو العبد كيف التخلف",57,"ف",1,0],["فما نوب الحوادث باقيات","ولا البؤس تدوم ولا النعيم",58,"م",1,1],["فما نحفل الدنيا إذا جل ظلمها","ونحن من الأيام والعيش تنصف",59,"ف",1,0],["فما نفعتهم رأفةٌ ولطافةٌ","وهل ينفع المقباسُ في ظلمةِ القبرِ",60,"ر",1,0],["فما نالَ قلبي مُناه","وما ذاقَ غيرَ الخُطوب",61,"ب",1,0],["فما نحنُ ألا أثر","على الرملِ في السَاحِلِ",61,"ل",1,0],["فما نَورُ الأقاحي يوم جفت","أعاليه وحاديه الغمام",62,"م",1,0],["فَمَا نِلتَ إِلاَّ شِقوَةً وَضَلاَلَةً","وَفِسقاً عَلَى جَهرٍ وسِحراً وسُغنِيَا",63,"ي",2,0],["فَما نَقَلتَ إِلى غَيرِ العُلى قَدَماً","وَلا شَدَدتَ عَلى غَيرِ الثَناءِ يَدا",64,"د",2,0],["فَما نِلتَها إِلّا عَنِ الحوبِ مُعرِضاً","وَفي الجَدبِ فَيّاضاً وَفي الحَربِ مُقدِما",65,"م",2,0],["فما نظرت إلى شيء بدا أبداً","إلا وأحباب قلبي دونه لا حوا",66,"ح",3,0],["فما نديمي بحان الأنس غير فتىً","له لأخبارهم نشر وإيضاح",66,"ح",1,0],["فما نسج داود كنسج عناكب","ولا الغادة الهيفاء تزهو بخلخال",67,"ل",1,0],["فما ندري الهموم ولا الرزايا","ولا نحصي الشهور ولا السنينا",68,"ن",2,0],["فما نال خيرا نازح عن جنابه","ولا خاف ضيرا نازل منه في سعد",69,"د",1,0],["فما نحصى ولا تحصى الأعادي","وقائعه وإن شئتم فعدوا",70,"د",3,0],["فَما نَرى كَعلِيٍّ في الأَنامِ فَتَىً","سِواهُ وَالشِّبهُ نَحوَ الشِّبهِ مُجتَذَبُ",71,"ب",1,0],["فمانعُ النفسِ من إدراكِ ما طَلَبَتْ","ميلٌ إلى سَوْفَ أو ميلٌ إلى ضَجَرِ",72,"ر",1,0],["فما نفس وإن عاشت","على العيش بمغبوطه",73,"ط",2,0],["فَما نَفَعَ التَحَسُّر إِذ دَهاني","وَقَد عَلِقَت حَبائِلُهُ حِبالي",74,"ل",2,0],["فما ندري أغرَّتُه تُرينا","بياض الصُّبح أم لون العقارِ",75,"ر",1,0],["فما نلت حظا من جداه سوى الذي","يمنّ به أهل الوشاية والكيد",76,"د",1,0],["فما نستوي في الحِجا والندى","وطيّ الأمور ومنشورِها",77,"ر",3,0],["فَما نَبتَغي في لَيلِنا وَنَهارِنا","مِنَ اللَهِ إِلّا أَن يُمَدَّ لَهُ العُمرُ",78,"ر",1,0],["فَمَا نَضَارَةُ أَقْوَالٍ مُزَخْرَفَةٍ","بِخَاطِرِ مُخْطَرٍ لِكُلِّ مَحْظُورِ",79,"ر",1,0],["فما نقود حُلَى تلك القدود سوى","بذل الوجود بفرط الوجد والشغف",80,"ف",1,0],["فما نجح آمال ثنت لسواكم","عناناً وألفاظٍ على غيركم تثنى",81,"ن",2,0],["فما ناظر إلا لعلياك ناظر","ولا راحة إلا لجدواك ترفع",82,"ع",1,0],["فما نفعُ الحياةِ بلا اغتباطٍ","ولا طرب وإيناسٍ وجود",83,"د",1,0],["فما نحنُ إِلا إخوةٌ فتشارَكوا","بأفراحِ أعراسٍ وأحزانِ مأتم",84,"م",1,0],["فَما نزلت عَلى مولى سواك وَلا","أَرجو وَراءَك بعد اللَه انسانا",85,"ن",2,0],["فَما نُصْحاً لِمَجْدِكَ بَلْ مُراداً","لِما قَدْ ساءَنِي قَعَدُوا وقامُوا",86,"م",3,0],["فَما نَقَلَتْ جَرْداءُ سابِحَةٌ لَهُ","شَبِيهاً وَلا وَجْناءُ يَقْلَقُ كُورُها",87,"ر",3,0],["فَما نُوِّخَتْ حَتّى أَسَوْنا بِجُودِهِ","جِراحَ الْخُطُوبِ الْمُنْهَراتِ فُتُوقُها",88,"ق",3,0],["فَما نَخْشى مُح