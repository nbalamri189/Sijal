المثلا","https://www.aldiwan.net/poem61603.html","البسيط"],[459,"شوارد حظ لا يقر نفورها","https://www.aldiwan.net/poem56200.html","الطويل"],[462,"تعاظم حزني والرزية أعظم","https://www.aldiwan.net/poem15905.html","الطويل"],[462,"أسيف سل أم ذرب نطوق","https://www.aldiwan.net/poem16020.html","الوافر"],[465,"أيا ملكاً بات صرح العلى","https://www.aldiwan.net/poem3133.html","عموديه"],[465,"أعيا وقد عاينتم الآية العظمى","https://www.aldiwan.net/poem3135.html","عموديه"],[465,"لقد سل سيفا والغدار الحمائل","https://www.aldiwan.net/poem3189.html","عموديه"],[465,"أماط لثاماً فاجتلِ القمر الأدنى","https://www.aldiwan.net/poem3203.html","عموديه"],[465,"شهيدا غرامي ادمعي وسجومها","https://www.aldiwan.net/poem3217.html","عموديه"],[465,"أشاقك برق بالشآم يشام","https://www.aldiwan.net/poem3487.html","عموديه"],[465,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[465,"غصون الحمى شف المعنى قدودها","https://www.aldiwan.net/poem3618.html","عموديه"],[469,"لئن سقاني أخ له همم","https://www.aldiwan.net/poem59702.html","المنسرح"],[471,"لقد سلا كل صب أو قضى وطرا","https://www.aldiwan.net/poem4718.html","البسيط"],[478,"كفاك على وجدي دليلا مدامعي","https://www.aldiwan.net/poem15237.html","الطويل"],[501,"ما بال قوم ترى للغير مقدرة","https://www.aldiwan.net/poem38007.html","البسيط"],[505,"حلت حين ما حلت على المصايب","https://www.aldiwan.net/poem38413.html","الطويل"],[515,"بقيت بقاء الدهر يا بهجة الدهر","https://www.aldiwan.net/poem20808.html","الطويل"],[516,"سرت نفحة كالمسك أزهى وأعطر","https://www.aldiwan.net/poem12119.html","الطويل"],[516,"وقائلة مالي أرى الجو مظلماً","https://www.aldiwan.net/poem12300.html","الطويل"],[541,"أدار سليمى بين بين فمثعر","https://www.aldiwan.net/poem56822.html","الطويل"],[563,"أتى في أوان القطر أشهى من القطر","https://www.aldiwan.net/poem52777.html","الطويل"],[563,"أتتني بلا وعد وقد نضت الحجبا","https://www.aldiwan.net/poem52878.html","الكامل"],[568,"لقد ساء العدا وشجا الحسودا","https://www.aldiwan.net/poem69728.html","الوافر"],[574,"أجيرة بيتي ما لكم بكم السهو","https://www.aldiwan.net/poem3636.html","الطويل"],[576,"مضى معهم قلبي فلله درره","https://www.aldiwan.net/poem3060.html","الطويل"],[586,"لقد سمح الدهر بالمقترح","https://www.aldiwan.net/poem1571.html",""]],"verses":[["لَقَد سَقَوكَ بِأَطباءٍ مُلَعَّنَةٍ","كَأَنَّما كُنتَ تُسقى السُمَّ لا اللَبَنا",0,"ن",2,0],["لَقَد سَلَبَت ظِباءُ الدارِ لُبّي","أَلا ما لِلظِباءِ بِها وَما لي",1,"ل",2,0],["لَقَد سَلَّ هَذا الرُزءُ مِن عَينِيَ الكَرى","وَغَصَّصَ بِالماءِ الزُلالِ وَأَشرَقا",2,"ق",2,0],["لَقَد ساءَني أَنَّ البَلابِلَ رَوَّحَت","وَأَنَّ مَطالَ الداءِ بَعدَكَ أَقصَرا",3,"ر",2,0],["لَقَد ساءَني أَن يَموتَ السَماحُ","بِمَوتِ الكِرامِ وَلا يُعقِبُ",4,"ب",1,0],["لَقَد سَرَّكَ الدَهرُ في الغادِرينَ","بِعُذرٍ تَضاءَلُ فيهِ الذُنوبُ",5,"ب",1,0],["لَقَد سَعِدَ الحُجّاجُ إِذ كُنتِ فيهِمُ","وَحُقَّ لَهُم أَن يَسعَدوا وَيُوَفَّقوا",6,"ق",3,0],["لَقَد سَفَرَت بَنو عَبدانَ بَيناً","فَما شَكَروا بِلَأمي وَالقِداحِ",7,"ح",1,0],["لَقَد سَكَنَت بَيني وَبَينَكِ حِقبَةً","بِأَطلائِها العَينُ المُلَمَّعَةُ الشَوى",8,"ا",1,0],["لَقَد سَبَقَت لَكَ الحُسنى فَطوبى","لِمَوقِفِ شَيخِنا يَومَ الحِسابِ",9,"ب",1,0],["لَقَد سَعِدَت بِغَفلَتِنا فَراحَت","بِثَروَتِنا وَأَوَّلُها التِرامُ",10,"م",1,0],["لَقَد سَفَرَت بِعِلَّتِكَ اللَيالي","لَنا عَن وَجهِ حادِثَةٍ وَقاحِ",11,"ح",1,0],["لَقَد سَرَّنا أَنَّ النَعِيَّ مُوَكَّلٌ","بِطاغِيَةٍ قَد حُمَّ مِنهُ حِمامُ",12,"م",1,1],["لَقَد سِرتُ شَرقِيَّ البِلادِ وَغَربِها","وَقَد ضَرَبَتني شَمسُها وَظُلولُها",13,"ل",3,0],["لَقَدْ سُنَتْ سَجَايَاهُ وَزَادَتْ","مَحَاسِنَهَا المَعَارِيفُ وَالعُلُومُ",14,"م",1,0],["لَقَد سَبَقَت فيهِم بِفَضلِكَ آيَةٌ","لَدَيَّ وَلَكِن ما هُناكَ يَقينُ",15,"ن",1,0],["لقد سرني أنْ لُحْتَ في أُفُق العلا","على الطائر الميمون والطالع السعدِ",16,"د",1,0],["لقد سكتت مدافعها وجوماً","لجيش حلّ مَرصَفها الحصينا",17,"ن",2,0],["لقد سَقيت بفيض الدمع أربُعها","على جوانب وادٍ ليس يَسقيني",18,"ن",2,0],["لقد سلك الطريق إلى المعالي","إلى أن مات محمود السلوك",19,"ك",1,0],["لقد ستروا شينع الغدر منهم","بثوب من سياستهم محوك",19,"ك",1,0],["لَقَد سُلَّ أَسيافُ الهُذَيلِ عَلَيكُمُ","رِقاقَ النَواحي لَيسَ فيهِنَّ مُصفَحُ",20,"ح",1,0],["لَقَد سَرَّني أَن لا تَعُدُّ مُجاشِعٌ","مِنَ الفَخرِ إِلّا عَقرَ نابٍ بِصَوأَرِ",21,"ر",1,1],["لَقَد سَرَّني وَقعُ خَيلِ الهُذَيلِ","وَتَرغيمُ تَغلِبَ في دارِها",22,"ر",3,0],["لَقَد سَفِهَت حُلومُهُمُ وَأُجروا","مَعَ المَسبوقِ حَيثُ جَرى المَليمِ",23,"م",1,0],["لَقَد سَرَّني لَحبُ القَوافي بِأَنفِهِ","وَعَلَّبَ جِلدَ الحاجِبَينِ وُسومُها",24,"م",3,0],["لَقَد سَفَحَت مِن دَمعِ عَينَيكَ عَبرَةٌ","وَحُقَّ لِعَيني أَن تُفيضَ عَلى سَعدِ",25,"د",1,1],["لقد سُمعت للأوَّلين فضائلٌ","ولكنَّ هذا الفضلَ ما جازَ مسمعا",26,"ع",2,0],["لقد سيرت تلك النجوم يدُ النوى","فهلا كتسيار النجوم رجوعها",27,"ع",3,0],["لقد سُقي الماءَ بطنُ سوءٍ","شفاه ربي ولا شفاكا",28,"ك",2,0],["لقد سرَّت الدنيا وضرت جناتَها","فمجّاجها للقوم أرياً لَسوعها",29,"ع",3,0],["لقد ساءني أن تكون انهَزَمْ","ت قبل الوقاف وقبل الثقاف",30,"ف",1,0],["لَقَد سَرَّني إِذ سِرتُ في الناسِ أَنَّني","أَرى ذِكرَ زَيدِ اللَهِ أَصبَحَ خامِلا",31,"ل",2,0],["لَقَد ساءَني العَتبُ الَّذي جاءَ مِنكُمُ","وَإِنِّيَ عَنهُ لَو عَلِمتُم لَعاجِزُ",32,"ز",1,0],["لَقَد سَرَّني ما قَد سَمِعتُ مِنَ الرِضا","وَقَد هَزَّني ذاكَ الحَديثُ وَأَطرَبا",33,"ب",2,0],["لقدْ سَحَقَتْها أكفُّ الظَّلامِ","وقدْ رَشَفَتْها شِفاهُ السَّرابْ",34,"ب",1,0],["لقد سلا كل محروب كوارثه","وليس للعربي اليوم سلوان",35,"ن",1,0],["لقد ساءني ان العروبة اكأبت","وان لها قلباً من الحزن مفطورا",36,"ر",2,0],["لقد سفكت بجهلك شر سفك","لغير شهادة او رفع ملك",37,"ك",1,0],["لَقَد سَلَّ سَيفَ الدَولَةِ المَجدُ مُعلِماً","فَلا المَجدُ مُخفيهِ وَلا الضَربُ ثالِمُه",38,"م",2,0],["لقد سبقَ القضاءُ برغمِ أنفي","وليس على المقدَّرِ من محيصِ",39,"ص",1,0],["لَقَد سَرَّ الأَعادي فِيَّ أَنّي","بِرَأسِ العَينِ مَحزونٌ كَئيبُ",40,"ب",1,0],["لَقَد ساوَرَت خَيلَ المُساوِرِ عُصبَةً","أَفاءَت عَلَيهِ الطَعنَ غَضّاً مُجَدَّدا",41,"د",2,0],["لَقَد سَرَّني أَنَّ العَواقِبَ رَوَّعَت","عِداكُم بِرَأسَي تامِشٍ وَشُجاعِ",42,"ع",1,0],["لَقَد سَأَلتُ أَبا لَيلى بِما حَمَلَت","زَوامِلُ القَومِ مِن نُعمى أَبي دُلَفِ",43,"ف",1,1],["لَقَد سُستَنا بِالعَدلِ وَالبَذلِ مُنعِماً","وَعُدتَ عَلَينا بِالأَناةِ وَبِالرِفقِ",44,"ق",1,0],["لَقَد سَرَّني أَنَّ المَكارِمَ أَصبَحَت","تَحُطُّ إِلى أَرضِ العِراقِ حُمولُها",45,"ل",3,0],["لَقَد سَبَقَت مِنهُ إِلَيَّ صَنيعَةٌ","تَسَربَلتُ مِنها حِلَّةً لا أُذيلُها",45,"ل",3,0],["لَقَد سَرَّ العَدُوَّ وَساءَ سَعداً","عَلى القَعقاعِ قَبرِ فَتىً هِجانِ",46,"ن",1,1],["لقد سَوَّدَتْ عِرْسُ ابنِ حَمزَةَ وَجهَهُ","وكان مُضيئاً وَجهُهُ في المَحافِل",47,"ل",1,1],["لقد سرنا جود الزمان بقربكم","وقد ساءنا في القرب إعراضكم عنا",48,"ن",2,0],["لَقَد ساعَدَ الفِطرُ رَبَّ الصِيامِ","بَعيدٍ مُوافٍ وَعَيشٍ مُؤاتِ",49,"ت",1,0],["لقد سرتُ في سهب المديح هدايةً","ومثليَ فيه لا يسيرُ تعَسّفا",50,"ف",2,0],["لَقَد سَخَنَت عُيونُ الجودِ لَمّا","نَوَيتَ وَأُقصِدَت غُرَرُ القَصيدِ",51,"د",1,0],["لَقَد ساسَنا هَذا الزَمانُ سِياسَةً","سُدىً لَم يَسُسها قَطُّ عَبدٌ مُجَدَّعُ",52,"ع",1,0],["لَقَدْ سَامَنِي طَيَّ الْغَرَامِ وَمَا دَرَى","بِأَنَّ الْهَوَى الْعُذْرِيَّ يَكْبُرُ أَنْ يُطْوَى",53,"و",2,0],["لقدْ سبى بالنورِ شمسَ الضحى","فهلْ أتى مِنْ آلِ عمرانا",54,"ن",2,0],["لقدْ سرتَ فينا سيرةً عُمَرِيَّةً","تشرِّفُ أسماعَ العلى وتشنِّفُ",55,"ف",1,0],["لقدْ سمحَ الحبيبُ بطيبِ وصلٍ","فأورَقَ يابسي واخْضَرَّ عودي",56,"د",2,0],["لَقَد ساقَني حَينٌ إِلى الشادِنِ الَّذي","أَضَرَّ بِنَفسي أَهلُهُ حينَ هَجَّروا",57,"ر",3,0],["لَقَد ساقَ مِن رائِقِ المُجتَلى","شَهِيَّ الجَنى مُستَطابَ النَفَس",58,"س",1,0],["لَقَد سُوِّستِ أَمرَ بَنيكِ حَتّى","تَرَكتِهِمُ أَدَقَّ مِنَ الطَحينِ",59,"ن",1,0],["لَقَدْ سَرَّنا أَنَّ القُضاةَ ثَلاثَةٌ","وأنكَ تَاجَ الدِّينِ لِلْقَوْمِ رَابِعُ",60,"ع",1,0],["لقد سارتِ الرُّكْبانُ بالنّبَإِ الذي","يَشيبُ له طفلٌ وينصاتُ أجْلخ",61,"خ",1,0],["لَقَد سَرَّني أَنَّ الهِلالَ غُدَيَّةً","بَدا وَهوَ مَمشوقُ الخَيالِ دَقيقُ",62,"ق",1,1],["لَقَد سَرَّني فَألٌ جَرى مِن مُوَفَّقٍ","وَتَأويلُ ما قالَ الغُرابُ المُشَحِّجُ",63,"ج",1,0],["لَقَد سادَ أَشرافَ العِراقِ اِبنُ حاتِمٍ","كَما سادَ أَهلَ المَشرِقَينِ المُهَلَّبُ",64,"ب",1,0],["لَقَد سَنَحَت لي فِكرَةٌ بارِحِيَّةٌ","وَما زادَني إِلّا اِعتِباراً سُنوحُها",65,"ح",3,1],["لَقَد سَكَنَتُ نَفسي على الكُرهِ جِسمَها","فَأَلفَيتُها لا تَستَقِرُّ مِنَ النَفرِ",66,"ر",1,0],["لَقَد سَعِدوا إِن كانَ لَم يَجرِ عِندَهُم","مِنَ الوِزرِ إِلّا تَركُهُم لِلمَآزِرِ",67,"ر",1,0],["لَقَد ساسَ أَهلَ الأَرضِ قَومٌ تَفَتَّقَت","أُمورٌ فَما أَلفَت لَهُم يَدَ راتِقِ",68,"ق",1,1],["لقَدْ سَجَعَتْ في جُنْحِ لَيْلٍ حَمامةٌ","فَأَيَّ أسىً هَاجَتْ على الهائِمِ الصَّبِّ",69,"ب",1,1],["لَقَد سرت من بغداد يدفعني الوَجدُ","إلى حيث وكر الشعر طائره سعدُ",70,"د",1,1],["لَقَد ساءَني أني لبغداد بارح","وأني فيها لا أروح ولا أغدو",70,"د",2,0],["لَقَد ساءَلت لَو أَجدى سؤالي","وَقَد عاتبت لَو نفع العتاب",71,"ب",1,0],["لَقَد سر قَلبي أن في مصر أُمةً","تمتع باستقلالها فلها الأمر",72,"ر",1,0],["لَقَد سامني دَهري بِبَغداد ذلةً","وَماذا عَسى في مصر أَن يفعل الدهر",73,"ر",1,1],["لَقَد سمعت في ليلة مثل هذه","إلى الباب سُعدى أنه كان يقرع",74,"ع",1,0],["لَقَد سهدت وَناموا","وَما سهاد كنومِ",75,"م",1,1],["لَقَد سمعت هزاراً","في الروض يدعو هزارا",76,"ر",2,0],["لَقَد سمعتك في أن","نات الفؤاد الكسير",77,"ر",1,0],["لَقَد سَئمت دنياي نَفسي فإنها","لمنزلة لي دون منزلة القبر",78,"ر",1,1],["لقد سار آبائي جميعاً إلى الردى","وإني على آثارهم سأَسير",79,"ر",1,0],["لقد سئمت نفسي الحياةَ وما أرى","بديلاً عن الكأس التي أنا راشفُ",80,"ف",1,0],["لَقَد ساءَني في الدَهرِ مَن كانَ سَرَّني","وَأَغرَقَني في الدَمعِ مَن كانَ أَنقَذا",81,"ذ",2,0],["لَقَد سَقاني الرُعاف فيهِ","كُلَّ ذُعافٍ مِنَ السِمامِ",82,"م",1,1],["لَقَد سَلَبَ الزَمانُ يَدي","مِنَ الأَعلاقِ أَثمَنَها",83,"ن",3,0],["لقد سار نحو المجد قوم فأدلجوا","ولم يعلموا أين انتهى بهم الدرب؟",84,"ب",1,0],["لقد سَئِمَ العُرْبُ طولَ الجمام","وقد ملت البيض أغمادها",85,"د",3,0],["لقد سرّني أنَّ الزّمانَ الذي سطا","عليكَ بحربٍ عاد وَهْوَ مُسالم",86,"م",1,0],["لقد سرَّنا منها صفاها وطيبَها","ولكن بكيناه جمالاً مضيَّعا",87,"ع",2,0],["لقد ساءَني علمي بخُبثِ السرائرِ","وأنّي على تطهيرِها غيرُ قادرِ",88,"ر",1,1],["لقد ساءني غاد عليه ورائح","فمن كبدي فوق الثرى قطع حمر",89,"ر",1,0],["لقد سُقي الماءَ بطنُ سوء