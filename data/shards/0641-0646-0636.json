{"poems":[[55,"نظمنا نظام العقد ودا وألفة","https://www.aldiwan.net/poem29821.html","الطويل"],[3,"أشاقك من عبل الخيال المبهج","https://www.aldiwan.net/poem135.html","الطويل"],[90,"همم الرجال مقيسة بزمانها","https://www.aldiwan.net/poem45023.html","الكامل"],[93,"بت أرعى في الظلام الأنجما","https://www.aldiwan.net/poem8872.html","عموديه"],[87,"سألت حبيبي في قبلة","https://www.aldiwan.net/poem7041.html","المتقارب"],[63,"لنا من الدهر خصم لا نغالبه","https://www.aldiwan.net/poem51782.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54633","الكامل"],[2,"صَحا القَلبُ عن سلمى وأقصرَ باطِلُهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19479&r=&rc=5",""],[132,"عسى الله بعد البين يجمع بيننا","https://www.aldiwan.net/poem50504.html","الطويل"],[164,"بي من فتور المقلة الكحلاء","https://www.aldiwan.net/poem58775.html","الكامل"],[240,"من عذيري فيه وهل من عذير","https://www.aldiwan.net/poem32017.html","الخفيف"],[246,"إن أسماء في الورى خير أنثى","https://www.aldiwan.net/poem45753.html","الخفيف"],[333,"هذه دارها وتلك رباها","https://www.aldiwan.net/poem55027.html","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126736","الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25360","الرجز"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105436","الكامل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26511","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124738","الرمل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109291","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93610","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65104","الطويل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/141689","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111463","الرمل"],[4291,"","https://poetry.dctabudhabi.ae/diwan/poem/142467","الكامل"],[5186,"أي متى كنت مغرما بالملاح؟","https://www.poetsgate.com/ViewPoem.aspx?id=156552",""],[402,"ذكراك بالإكبار والإعجاب","https://www.poetsgate.com/ViewPoem.aspx?id=35310",""],[6031,"لَعِبتْ بعطفيهِ الشمولُ فَمَادَا","https://www.poetsgate.com/ViewPoem.aspx?id=46254",""]],"verses":[["فَنُضحي لَها طَربى بِغَيرِ تَرَنُّمٍ","وَنُمسي لَها سَكرى بِغَيرِ مُدامِ",0,"م",1,0],["فَنُضحي سُكارى وَالمُدامُ مُصَفَّفٌ","يُدارُ عَلَينا وَالطَعامُ المُطَبهَجُ",1,"ج",1,0],["فَنَضَت ملابس عزَها وتثاقلت","في الذُلّ راسفةً بقَيد هوانها",2,"ن",3,0],["فَنَضا الثَوبَ فَأَبصَرتُ الَّتي","كادَ جِسمِيَ في هَواها أَن يَغيب",3,"ب",1,0],["فنضّى عن الجفن ثوب الكرى","وعما جرى بيننا لا تسل",4,"ل",1,0],["فنضكبُوا عن طريقِ السَّيْلِ تمتنعُوا","من قبلِ أن تَتَهاداكُم غَوارِبُه",5,"ب",2,0],["فَنَضَا لَهَا الرأْيَ النَّزِيْهَ عَنْ الهَوَى","وَمَضَى بَيْنَ يَدَيْهِ نُورُ صَوَابِ",6,"ب",1,0],["فنضربهُ، حتّى اطمأنَّ قذالهُ","وَلم يَطْمَئِنّ قَلْبُهُ وخَصَائِلُهْ",7,"ل",2,0],["فنضحَى بلا صبرٍ جميلٍ كآبةً","عليك ونمسى والدموعُ سِجَامُ",8,"م",1,0],["فنضبتُ راياتي وجردت المدى","ودمغتُ قسراً هامةَ الأعداءِ",9,"ا",2,0],["فَنَضَوتُ الصِبى وَأَلقَيتُ لِلأَي","يامَ عَن عاتِقي رِداءَ السُرورِ",10,"ر",1,0],["فنضاها عَنهُ وفرَّ إلى الموتِ","بدرعٍ من الفخارِ منيعِ",11,"ع",1,0],["فنضَت ثوبها وقالت عجيبٌ","أمرُ هذا المتيّم المجهول",12,"ل",1,0],["فنَضا عليهم مُرهفاً من عزمهِ","ولهَ رُؤوس الدارعين نثارُ",13,"ر",1,0],["فَنَضَبَ العَهْدُ الَّذِي تَوَهَّمُهْ","وَكَلَّ مِنْ طُولِ النِضالِ أَسْهُمُهْ",14,"م",2,0],["فنضى ابن حيدرة حساماً ما قد أبى","إغماده إلا بهامة باغي",15,"غ",2,0],["فَنَضرَةُ وَجهٍ يَقصُرُ الطَرفُ دونَهُ","وَطَرفٌ وَإِن لَم يَألَفِ الكُحلَ أَكحَلُ",16,"ل",1,0],["فنضى ذلك عني كله","عقب الدهر وتصريف الأبد",17,"د",1,0],["فنضا شفارا ما أدق غرارها","تركت اعز العالمين ذليلا",18,"ل",2,0],["فَنضا اِبن حَيدر صارماً ما سلَّه","إلا وَسِلن مِن الدِماء بُحور",19,"ر",1,0],["فنضدُ صحاح الجوهري منه محكمّ","عباب غرامي فيه ما زال يزخرُ",20,"ر",1,0],["فنضْرَةُ البُرْجِ بالفِرْدَوس مُذْكِرَةٌ","مَنْ قاسَ ما غَابَ عنه بالّذي شَهِدا",21,"د",2,0],["فَنُضَحِّي لَكِ إِن تَحمِي الوَلَد","ونِسانا مِن تِباعٍ تُنتَقى",22,"ق",2,0],["فنضارةُ الغاف النضير","تبددت في الخالياتِ",23,"ت",1,0],["فنضال مبرح، فقتال","في بهيم الأمساء، والأصباح",24,"ح",1,0],["فنضالها الرأي النزيه عن الهوى","ومضى وبين يديه نور صواب",25,"ب",1,0],["فَنَضَا دُجاهُ بُغرَّةٍ أرْبَى بها","حُسناً على البدرِ المنير وزادا",26,"د",2,0]]}