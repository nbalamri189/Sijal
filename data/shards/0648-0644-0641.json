0776",""],[5732,"يا عاذلي","https://www.poetsgate.com/ViewPoem.aspx?id=177924",""],[5790,"تملكت من سيد أصيدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=111889",""],[5956,"أولادي والحمد لله وعقبال أولاد الجميع وأكثر","https://www.poetsgate.com/ViewPoem.aspx?id=192025",""],[5977,"حديث ورؤى","https://www.poetsgate.com/ViewPoem.aspx?id=213271",""],[6148,"أشواق القبة الخضراء","https://www.poetsgate.com/ViewPoem.aspx?id=202096",""],[5001,"همس الأهداب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80719&r=&rc=9",""],[572,"أخٌ لي كُنتُ أُغبَطُ باعتقادِه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9249&r=&rc=106",""]],"verses":[["وَلَفظُ فَمٍ إِذا ما جا","لَ لا تُخشى هَواجِرُه",0,"ر",2,0],["ولَفَّتْ على صَحْنِ العِراقِ عَجاجَها","يُقَدّمُها مِن آلِ إسْحاقَ باسِلُ",1,"ل",1,0],["ولفارِسِ الهَرّارِ فيهِ شَمائِلٌ","لَقِحَتْ بِها الحَرْبُ العَوانُ قديما",2,"م",2,0],["وَلَفِيفُ جُبَّانٍ إِذَا مَا اسْتُوقِفُوا","نَادَتْ بِهِمْ آجَالُهُمْ فَتَسَلَّلُوا",3,"ل",3,0],["ولَفْظُكَ البارِدُ يا سيّدي","منْ زَمْهَريرٍ هَبَّ في فَجِّ",4,"ج",1,0],["ولُفّ في ثوب له واحدٍ","ليس له رقم ولا ميدع",5,"ع",1,0],["ولفظٌ كأنَّ السحرَ فيه محللٌ","ألم ترَهُ في الذَّوقِ غيرَ معقَّد",6,"د",1,0],["ولفظهُ التبرِيّ أو جودهُ","جلته أسماعي وأجيادِي",7,"د",2,0],["ولفظك الحائز والإ","حسانُ لي بحرٌ وبرّ",8,"ر",1,0],["ولففت هاتيك الذَّوائب أجتلي","نعم العروس أو الأمير مشرْبشا",9,"ش",2,0],["ولفظٌ هو العذبُ الطهور وطالما","أدارَ على الأفهام صرف سلاف",10,"ف",1,0],["ولفضلهِ في كلِّ مقصد قاصدٍ","كم من يسارٍ واصلٍ ليمين",11,"ن",1,0],["ولفظ يقرِّط أسماعنا","بما لا رأت مثله ماريه",12,"ي",2,0],["ولفظناك كريهاً","غير مكروه الفراق",13,"ق",1,0],["ولفَّكَ اللَّهُ في لفائفِ غم","مائكَ حتى تُلفَّ في كفنك",14,"ك",1,0],["ولفوته عامانِ تُوبع فيهما","ولعجزِنا وسكوتنا التظليمُ",15,"م",1,0],["وِلفضلكم وقع القضا","ءُ بأن تسودونا ونَخْدُمْ",16,"م",1,0],["وَلَفظٍ يوجِبُ الغَسلَ","عَلى السامِعِ وَالحَدّا",17,"د",2,0],["ولففته في سُوسن","وحففته بقَرنفل",18,"ل",1,0],["وَلَفظُكَ بِنجٌ وَلَكِنَّهُ","لَطيفُ الصَبا في جُفونِ العَصَب",19,"ب",1,0],["وَلَفظَةٍ لا يَسُدُّ الغَيرُ مَوضِعَها","غَرّاءَ تُحسَبُ ماءً وَهيَ جُلمودُ",20,"د",1,0],["وَلَفَّ بِالجَيشِ حَيَّي قَينُقاعَ بِما","جَنَوا فَتَعساً لَهُم مِن مَعشَرٍ قَزَمِ",21,"م",1,0],["وَلَفَّهم بِخَمِيسٍ لَو يَشُدُّ عَلى","أَركانِ رَضوى لَأَضحى مائِلَ الدِّعَمِ",21,"م",1,0],["ولَفَّني شَبَحٌ ما كانَ أشبَههُ","بجَعْدِ شَعركِ حولَ الوجهِ يَنعْقد",22,"د",1,0],["ولفَّهُ وهجُ الأصواف يُوقِدها","عن صرِّ كانون تَنّوراً وكانونا",23,"ن",2,0],["وَلَفَّ عِشرينَ إِلى أَشراطِهِ","فَلَم نَزَل نَقرِنُ في رِباطِهِ",24,"ط",2,0],["وَلِفارِسِ الأَحرارِ أَنفَسُ أَنفُسٍ","وَفَخارُهُم في عِشرَةٍ مَعدومُ",25,"م",1,0],["ولفَّ النَّهْدَ في لينٍ","وضمَّ الجسدَ اللَّدْنا",26,"ن",2,0],["ولفَّتْ ذراعين كالحيّتينِ","عليَّ وبي نشوةٌ لم تطِرْ",27,"ر",1,0],["وَلفْظٌ لَعُوبٌ وَلَحْظٌ وَثُوبٌ","وَعَقْلٌ رَصِينٌ وَرَأْيٌ حَصِيفْ",28,"ف",1,0],["وَلِفَضلٍ فِي نُهَاهَا اسْتشْعَرَتْ","غِيلَةَ الوَغْدِ إِذِ الْبَارِقُ ذَرَّا",29,"ر",2,0],["ولفت وجهك يمنة، فترى","وجهاً متى تذكره ترتعد :",30,"د",1,0],["ولفكَّكْتُ من أساريرِكَ الكِبْ","رَ بقولٍ من وَخْزَةِ الموتِ أنْكَى",31,"ك",2,0],["وَلَفْظَةٍ سُجِنَتْ في جَوْفِ مُظْلِمَةٍ","لَمْ تَنْظُر الشَّمْسُ مِنْهَا عَيْنَ مُرْتَقِبِ",32,"ب",1,0],["ولَفْظٌ كَوَجهِ الرَّوْضِ في ميْعَةِ الضُّحى","وقَدْ صَدَحَتْ فوقَ الغُصونِ عَنَادِلُهْ",33,"ل",2,0],["ولفظه كالمرجان","لفظ عليّ التبيان",34,"ن",1,0],["ولفّهما ظلّ السكينه والهوى","يعاند أحيانا وحينا يمالي",35,"ي",1,0],["ولفَّ الغادةَ الحسناءَ ليلٌ","مُريبُ الخطوِ ليسَ به شِهاب",36,"ب",1,0],["ولفظٌ هجينٌ ثوَتْ تحتهُ","معانٍ لِقلَّتها تًحتكر",37,"ر",1,0],["ولفتني باو الغنج ولف ناقه","وأنا ولفتك ولف حاتم لضوّه",38,"و",2,0],["ولفَّكَ اللَّهُ في لفائفِ غما","ئكَ حتى تُلفَّ في كفنك",39,"ك",1,0],["وِلفضلكم وقع القضا","ءُ بأن تَسودونَ ونَخْدم",40,"م",1,0],["وَلَفْتَتِهَا الغَضْبَى وَمِشْيَتِهَا الخَزْلِ","فَمَا هِيَ مِنْهَا فِي الطَّهَارَةِ رَغْبَةٌ",41,"ه",1,0],["ولفّ الخفاء الحسن حتّى شكى الهوى","وغار حرير مترف ورقوم",42,"م",1,0],["ولفظه السحر إلا أنه كلم","ولحظه الخلد إلّا أنه جاني",43,"ن",2,0],["ولفظ كضوء الشمس في مثل سيرها","يسح بفيض العقل سح الغمائم",44,"م",1,0],["ولفؤادٍ بَعد هذا القدِر","ثلاثة واثنان للغضنفري",45,"ي",1,0],["ولفظُ الناسِ ليس له مسمّى","سوانا والمنى منّا ينال",46,"ل",1,0],["ولفق إقوالا يسبه ربها","إذا اسندت عنه بعمياء تحطب",47,"ب",1,0],["ولفَّ القُرْبُ بَيْتَيْنا جَميعاً","فنحنُ الآن من بابِ اللّفيفِ",48,"ف",1,0],["وَلَفَّ السَرايا بِالسَرايا وَقادَها","لِعَشرٍ وَرَدَّ الدُهمَ مِنهُنَّ كالشُقرِ",49,"ر",1,0],["وَلَفُّ السَرايا بِالسَرايا تَخالُها","حِرارَ الحِجازِ أَو بِحارَ اللَواطِمِ",50,"م",1,0],["ولفقد أحلاسي أضنّ وإنّما","حسن الأديب بجودة الأحلاس",51,"س",1,0],["وَلفّقه من كلِّ بدعة مارقٍ","منَ الدين لا يَدري الصوابَ ولا يُدرى",52,"ر",2,0],["ولَفَظتُ روحي فاطبعي","قبلَ الوداعِ على جَبيني",53,"ن",2,0],["وَلَفَاسُنَا أَوْلَى بِذَاكَ لِكَوْنِهِ","فِيهَا الْمَنَارَ مَنَارَ رُشْدٍ بَادِ",54,"د",1,0],["وَلِفرجِيني يدٌ مبسوطةٌ","بدعاءٍ حين لا يُجدي دُعاء",55,"ا",2,0],["ولفظنا في كل نوع فضل","والفضل في العشرة لا يمل",56,"ل",1,0],["ولفتح عموريّةِ اضطربَ الورى","والنارُ فيها المعتدون وقاد",57,"د",1,0],["وَلِفَتكِ ناظِرِهِ بِناظِرِهِ أَرى","أَني أُقَبِّلُ كُلَّ سَيفٍ مِخذَمِ",58,"م",1,0],["وَلَفظُكِ هَذا أَم جُمانٌ مُبَدَّدٌ","وَلَيسَ لَهُ إِلّا بِأَسماعِنا لَقطُ",59,"ط",1,0],["ولف في البردة أعطافه","حتى يطيب النشر من لفه",60,"ف",2,0],["ولفّت معالمها ظلمة","يصارعها النور حتى يغيب",61,"ب",1,0],["وَلَفظُكَ حينَ تَلفِظُ في جَميع","وَلا تَكذِب مُقَدِّمَةٌ لِفِعلِك",62,"ك",1,1],["ولفحة من نسيم","ام انت ريح الشمال",63,"ل",1,0],["ولفُرقةٍ الألافِ والشَمْلِ الّذي","ما زِلْتُ للتّشْتيتِ منهُ مُراقبا",64,"ب",2,0],["وَلَفحُهُمُ حَتفٌ وَنَفحُهُمُ غِنىً","وَوَثبُهُمُ عَدوٌ وَخَطوُهُمُ وَثبُ",65,"ب",1,0],["ولفظٍ مثلِ عَذب الماءِ يروَى","به الصَّادِي إذا الصَّادي رَآهُ",66,"ا",2,0],["ولفق في تكفيرهم كل حجة","تراها كبيت العنكبوت لذي النقد",67,"د",1,0],["ولفرط شدته وهول مصابه","دهشت به ابصارنا وعقول",68,"ل",1,0],["ولفّ الليلُ شملتَهُ بحاءٍ","وبلّ الصُبْحُ أذيالَ الرّوابي",69,"ب",2,0],["ولَفَّتْكَ دُونِي غصونُ النعِيمِ","وأُسْلِمْتُ ضاحِيَ مَرْعىً جَديبِ",70,"ب",1,0],["