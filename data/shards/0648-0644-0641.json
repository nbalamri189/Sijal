diwan.net/poem64372.html","البسيط"],[48,"راح الشقي على الربوع يهيم","https://www.aldiwan.net/poem65108.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39571","الهزج"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55025","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142016","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54301","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54231","الطويل"],[72,"وهارب من رضوان","https://www.poetsgate.com/ViewPoem.aspx?id=45465",""],[90,"يافا الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179202",""],[90,"احمد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179129",""],[51,"أنَّى تشاغلتَ عن أبي حَسَنِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=30025",""],[51,"عطفاً بني وهبٍ عليْ","https://www.poetsgate.com/ViewPoem.aspx?id=30452",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[118,"حثا شرابهما في ظل حسان","https://www.aldiwan.net/poem49285.html","البسيط"],[118,"يرى من ستور الغيب حتى كأنما","https://www.aldiwan.net/poem49290.html","الطويل"],[133,"لهذه الأسباب قد حكمنا","https://www.aldiwan.net/poem49101.html","الرجز"],[145,"لنا في كل مكرمة مجال","https://www.aldiwan.net/poem47692.html","الوافر"],[158,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[164,"وقلت وقد سمعت به لصحبي","https://www.aldiwan.net/poem47023.html","الوافر"],[167,"ذريني فضرباً بالمهندة البتر","https://www.aldiwan.net/poem1623.html",""],[167,"بسمر القنا والمرهفات الصوارم","https://www.aldiwan.net/poem1673.html",""],[184,"قد شفني حنف مع الإفلاس","https://www.aldiwan.net/poem43696.html","الكامل"],[187,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[195,"كفي الملام وعلليني","https://www.aldiwan.net/poem39948.html","مجزوء الكامل"],[235,"يا من ألح علي في الإنشاد","https://www.aldiwan.net/poem18166.html","الكامل"],[239,"يا بني الفقر سلاما عاطرا","https://www.aldiwan.net/poem45752.html","الرمل"],[259,"وروضة طاب بها المحل","https://www.aldiwan.net/poem38213.html","الرجز"],[268,"عودي الى ماضيك يا بغداد","https://www.aldiwan.net/poem35650.html","الكامل"],[280,"أنا لا أصيخ إلى مقال اللوم","https://www.aldiwan.net/poem32438.html","الكامل"],[280,"أريقك أم صهباء في الكأس إسفنط","https://www.aldiwan.net/poem32718.html","الطويل"],[301,"لا تعجبوا منه فما حسنه","https://www.aldiwan.net/poem58085.html","السريع"],[326,"أراقت عليها معاني الفناء","https://www.aldiwan.net/poem54979.html","المتقارب"],[336,"ولفظك حين تلفظ في جميع","https://www.aldiwan.net/poem68723.html","الوافر"],[340,"ما للجمال ومالي","https://www.aldiwan.net/poem55367.html","المجتث"],[362,"يا أهل بغداد سقى عهدي بكم","https://www.aldiwan.net/poem60985.html","الكامل"],[364,"يمينك أخت الغيث إن ضلت السحب","https://www.aldiwan.net/poem17163.html","الطويل"],[369,"أما بهواه تيمني هواه","https://www.aldiwan.net/poem56988.html","الخفيف"],[400,"رجعت عن النظم الذي قلت في النجدي","https://www.aldiwan.net/poem33948.html","الطويل"],[426,"هاجت رياح بالشمال تجول","https://www.aldiwan.net/poem41032.html","الكامل"],[429,"جرى في عوده ماء الشباب","https://www.aldiwan.net/poem12568.html","الوافر"],[436,"تسمع لدعوة ناء غريب","https://www.aldiwan.net/poem34789.html","المتقارب"],[456,"بعينيك يوم البين غيبي ومشهدي","https://www.aldiwan.net/poem56221.html","الطويل"],[493,"كذا من شام بارقة العذاب","https://www.aldiwan.net/poem9765.html","الوافر"],[498,"جرى دمعي السياح من جفني البالي","https://www.aldiwan.net/poem37821.html","الطويل"],[512,"سفرت فبرقعها حجاب جمال","https://www.aldiwan.net/poem20814.html","الكامل"],[549,"بربك أيها البرق اليماني","https://www.aldiwan.net/poem47166.html","الوافر"],[549,"هل مجير من غصة ما تقضى","https://www.aldiwan.net/poem47736.html","الخفيف"],[549,"أي فتى ووري في الترب","https://www.aldiwan.net/poem48059.html","السريع"],[573,"نال فمي من ذلك الريم","https://www.aldiwan.net/poem2868.html","السريع"],[573,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"]],"verses":[["وَلَفظُ فَمٍ إِذا ما جا","لَ لا تُخشى هَواجِرُه",0,"ر",2,0],["ولَفَّتْ على صَحْنِ العِراقِ عَجاجَها","يُقَدّمُها مِن آلِ إسْحاقَ باسِلُ",1,"ل",1,0],["ولفارِسِ الهَرّارِ فيهِ شَمائِلٌ","لَقِحَتْ بِها الحَرْبُ العَوانُ قديما",2,"م",2,0],["وَلَفِيفُ جُبَّانٍ إِذَا مَا اسْتُوقِفُوا","نَادَتْ بِهِمْ آجَالُهُمْ فَتَسَلَّلُوا",3,"ل",3,0],["ولَفْظُكَ البارِدُ يا سيّدي","منْ زَمْهَريرٍ هَبَّ في فَجِّ",4,"ج",1,0],["ولُفّ في ثوب له واحدٍ","ليس له رقم ولا ميدع",5,"ع",1,0],["ولفظٌ كأنَّ السحرَ فيه محللٌ","ألم ترَهُ في الذَّوقِ غيرَ معقَّد",6,"د",1,0],["ولفظهُ التبرِيّ أو جودهُ","جلته أسماعي وأجيادِي",7,"ي",1,0],["ولفظك الحائز والإ","حسانُ لي بحرٌ وبرّ",8,"ر",1,0],["ولففت هاتيك الذَّوائب أجتلي","نعم العروس أو الأمير مشرْبشا",9,"ش",2,0],["ولفظٌ هو العذبُ الطهور وطالما","أدارَ على الأفهام صرف سلاف",10,"ف",1,0],["ولفضلهِ في كلِّ مقصد قاصدٍ","كم من يسارٍ واصلٍ ليمين",11,"ن",1,0],["ولفظ يقرِّط أسماعنا","بما لا رأت مثله ماريه",12,"ي",2,0],["ولفظناك كريهاً","غير مكروه الفراق",13,"ق",1,0],["ولفَّكَ اللَّهُ في لفائفِ غم","مائكَ حتى تُلفَّ في كفنك",14,"ك",1,0],["ولفوته عامانِ تُوبع فيهما","ولعجزِنا وسكوتنا التظليمُ",15,"م",1,0],["وِلفضلكم وقع القضا","ءُ بأن تسودونا ونَخْدُمْ",16,"م",1,0],["وَلَفظٍ يوجِبُ الغَسلَ","عَلى السامِعِ وَالحَدّا",17,"د",2,0],["ولففته في سُوسن","وحففته بقَرنفل",18,"ل",1,0],["وَلَفظُكَ بِنجٌ وَلَكِنَّهُ","لَطيفُ الصَبا في جُفونِ العَصَب",19,"ب",1,0],["وَلَفظَةٍ لا يَسُدُّ الغَيرُ مَوضِعَها","غَرّاءَ تُحسَبُ ماءً وَهيَ جُلمودُ",20,"د",1,0],["وَلَفَّ بِالجَيشِ حَيَّي قَينُقاعَ بِما","جَنَوا فَتَعساً لَهُم مِن مَعشَرٍ قَزَمِ",21,"م",1,0],["وَلَفَّهم بِخَمِيسٍ لَو يَشُدُّ عَلى","أَركانِ رَضوى لَأَضحى مائِلَ الدِّعَمِ",21,"م",1,0],["ولَفَّني شَبَحٌ ما كانَ أشبَههُ","بجَعْدِ شَعركِ حولَ الوجهِ يَنعْقد",22,"د",1,0],["ولفَّهُ وهجُ الأصواف يُوقِدها","عن صرِّ كانون تَنّوراً وكانونا",23,"ن",2,0],["وَلَفَّ عِشرينَ إِلى أَشراطِهِ","فَلَم نَزَل نَقرِنُ في رِباطِهِ",24,"ط",2,0],["وَلِفارِسِ الأَحرارِ أَنفَسُ أَنفُسٍ","وَفَخارُهُم في عِشرَةٍ مَعدومُ",25,"م",1,0],["ولفَّ النَّهْدَ في لينٍ","وضمَّ الجسدَ اللَّدْنا",26,"ن",2,0],["ولفَّتْ ذراعين كالحيّتينِ","عليَّ وبي نشوةٌ لم تطِرْ",27,"ر",1,0],["وَلفْظٌ لَعُوبٌ وَلَحْظٌ وَثُوبٌ","وَعَقْلٌ رَصِينٌ وَرَأْيٌ حَصِيفْ",28,"ف",1,0],["وَلِفَضلٍ فِي نُهَاهَا اسْتشْعَرَتْ","غِيلَةَ الوَغْدِ إِذِ الْبَارِقُ ذَرَّا",29,"ر",2,0],["ولفت وجهك يمنة، فترى","وجهاً متى تذكره ترتعد :",30,"د",1,0],["ولفكَّكْتُ من أساريرِكَ الكِبْ","رَ بقولٍ من وَخْزَةِ الموتِ أنْكَى",31,"ك",2,0],["وَلَفْظَةٍ سُجِنَتْ في جَوْفِ مُظْلِمَةٍ","لَمْ تَنْظُر الشَّمْسُ مِنْهَا عَيْنَ مُرْتَقِبِ",32,"ب",1,0],["ولَفْظٌ كَوَجهِ الرَّوْضِ في ميْعَةِ الضُّحى","وقَدْ صَدَحَتْ فوقَ الغُصونِ عَنَادِلُهْ",33,"ل",2,0],["ولفظه كالمرجان","لفظ عليّ التبيان",34,"ن",1,0],["ولفَّ الغادةَ الحسناءَ ليلٌ","مُريبُ الخطوِ ليسَ به شِهاب",35,"ب",1,0],["ولفظٌ هجينٌ ثوَتْ تحتهُ","معانٍ لِقلَّتها تًحتكر",36,"ر",1,0],["ولفَّكَ اللَّهُ في لفائفِ غما","ئكَ حتى تُلفَّ في كفنك",37,"ك",1,0],["وِلفضلكم وقع القضا","ءُ بأن تَسودونَ ونَخْدم",38,"م",1,0],["وَلَفْتَتِهَا الغَضْبَى وَمِشْيَتِهَا الخَزْلِ","فَمَا هِيَ مِنْهَا فِي الطَّهَارَةِ رَغْبَةٌ",39,"ه",1,0],["ولفظه السحر إلا أنه كلم","ولحظه الخلد إلّا أنه جاني",40,"ي",1,0],["ولفظ كضوء الشمس في مثل سيرها","يسح بفيض العقل سح الغمائم",41,"م",1,0],["ولفؤادٍ بَعد هذا القدِر","ثلاثة واثنان للغضنفري",42,"ي",1,0],["ولفظُ الناسِ ليس له مسمّى","سوانا والمنى منّا ينال",43,"ل",1,0],["ولفق إقوالا يسبه ربها","إذا اسندت عنه بعمياء تحطب",44,"ب",1,0],["ولفَّ القُرْبُ بَيْتَيْنا جَميعاً","فنحنُ الآن من بابِ اللّفيفِ",45,"ف",1,0],["وَلَفَّ السَرايا بِالسَرايا وَقادَها","لِعَشرٍ وَرَدَّ الدُهمَ مِنهُنَّ كالشُقرِ",46,"ر",1,0],["وَلَفُّ السَرايا بِالسَرايا تَخالُها","حِرارَ الحِجازِ أَو بِحارَ اللَواطِمِ",47,"م",1,0],["ولفقد أحلاسي أضنّ وإنّما","حسن الأديب بجودة الأحلاس",48,"س",1,0],["وَلفّقه من كلِّ بدعة مارقٍ","منَ الدين لا يَدري الصوابَ ولا يُدرى",49,"ر",2,0],["ولَفَظتُ روحي فاطبعي","قبلَ الوداعِ على جَبيني",50,"ي",1,0],["وَلَفَاسُنَا أَوْلَى بِذَاكَ لِكَوْنِهِ","فِيهَا الْمَنَارَ مَنَارَ رُشْدٍ بَادِ",51,"د",1,0],["وَلِفرجِيني يدٌ مبسوطةٌ","بدعاءٍ حين لا يُجدي دُعاء",52,"ا",2,0],["ولفظنا في كل نوع فضل","والفضل في العشرة لا يمل",53,"ل",1,0],["ولفتح عموريّةِ اضطربَ الورى","والنارُ فيها المعتدون وقاد",54,"د",1,0],["وَلِفَتكِ ناظِرِهِ بِناظِرِهِ أَرى","أَني أُقَبِّلُ كُلَّ سَيفٍ مِخذَمِ",55,"م",1,0],["وَلَفظُكِ هَذا أَم جُمانٌ مُبَدَّدٌ","وَلَيسَ لَهُ إِلّا بِأَسماعِنا لَقطُ",56,"ط",1,0],["ولف في البردة أعطافه","حتى يطيب النشر من لفه",57,"ف",2,0],["ولفّت معالمها ظلمة","يصارعها النور حتى يغيب",58,"ب",1,0],["وَلَفظُكَ حينَ تَلفِظُ في جَميع","وَلا تَكذِب مُقَدِّمَةٌ لِفِعلِك",59,"ك",1,1],["ولفحة من نسيم","ام انت ريح الشمال",60,"ل",1,0],["ولفُرقةٍ الألافِ والشَمْلِ الّذي","ما زِلْتُ للتّشْتيتِ منهُ مُراقبا",61,"ب",2,0],["وَلَفحُهُمُ حَتفٌ وَنَفحُهُمُ غِنىً","وَوَثبُهُمُ عَدوٌ وَخَطوُهُمُ وَثبُ",62,"ب",1,0],["ولفظٍ مثلِ عَذب الماءِ يروَى","به الصَّادِي إذا الصَّادي رَآهُ",63,"ا",2,0],["ولفق في تكفيرهم كل حجة","تراها كبيت العنكبوت لذي النقد",64,"د",1,0],["ولفرط شدته وهول مصابه","دهشت به ابصارنا وعقول",65,"ل",1,0],["ولفّ الليلُ شملتَهُ بحاءٍ","وبلّ الصُبْحُ أذيالَ الرّوابي",66,"ي",1,0],["ولَفَّتْكَ دُونِي غصونُ النعِيمِ","وأُسْلِمْتُ ضاحِيَ مَرْعىً جَديبِ",67,"ب",1,0],["ولفَّ على خيشومِه الكلبُ مُقعِياً","يرى الموتَ إلا ما استغاث بمَوقدِ",68,"د",1,0],["ولفظاً كنت أحسبه شروداً","تحاوَلُ دونه عصم الهضاب",69,"ب",1,0],["وَلِفْتُ الظِّباءَ الغيدَ في بَرِّ لَعْلَعٍ","وهُدْبِ جُفونٍ جرَّدَتْ أَيَّ فَصَّالِ",70,"ل",1,0],["ولفظْتُ بعضاً من فرائِدِ لفظِه","فجعلْتُه وسَطاً لعقدِ مَقالي",71,"ي",1,0],["ولفّوا شملهمْ بالشّمْلِ منّي","وكنت مدا الزّمان بغير ثانِ",72,"ن",1,0],["وَلفكري فيمن يساق إلى المو","تِ مَدا الدّهر كيف يَطعَمُ غُمضا",73,"ض",2,0],["وَلفّهمُ لفّا بِأيدي القنا","لفَّ الصّبا للغُصُنِ الرَّطْبِ",74,"ب",1,0],["ولفظُه سكرانُ من رِيقه","فهْو لهذا غيرُ مفهوم",75,"م",1,0],["ولفظُه المنثورُ مث","لُ اللؤلؤِ المنظومِ",76,"م",1,0]]}