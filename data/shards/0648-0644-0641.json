{"poems":[[53,"بلاء القلب ناظره","https://www.aldiwan.net/poem30463.html","مجزوء الوافر"],[63,"لك المجد لا ما تدعيه الأوائل","https://www.aldiwan.net/poem46184.html","الطويل"],[63,"جهد الصبابة أن أكون ملوما","https://www.aldiwan.net/poem46195.html","الكامل"],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[77,"قل للأشوني ولا تحتشم","https://www.aldiwan.net/poem36657.html","السريع"],[88,"أقوى مصيف القوم والمربع","https://www.aldiwan.net/poem45066.html","السريع"],[72,"عذيري من ساجي اللواحظ أغيد","https://www.aldiwan.net/poem18545.html","الطويل"],[72,"لحظك في الفتك هو البادي","https://www.aldiwan.net/poem18557.html","السريع"],[72,"يا سيدي شكرا لها","https://www.aldiwan.net/poem18763.html","مجزوء الرجز"],[72,"مذ قيل فرعك بالذوائب عرشا","https://www.aldiwan.net/poem19056.html","الكامل"],[72,"بقيت لحمد مثل فضلك واف","https://www.aldiwan.net/poem19259.html","الطويل"],[72,"جسمي أبو ذر الضنا فذروني","https://www.aldiwan.net/poem20182.html","الكامل"],[72,"أوجهك أم جنة عالية","https://www.aldiwan.net/poem20561.html","المتقارب"],[51,"كان أناس يرون أني في","https://www.aldiwan.net/poem65695.html","المنسرح"],[51,"أنى تشاغلت عن أبي حسنك","https://www.aldiwan.net/poem65777.html","الخفيف"],[51,"لأمورك التكميل والتتميم","https://www.aldiwan.net/poem66061.html","الكامل"],[51,"عطفا بني وهب علي","https://www.aldiwan.net/poem66309.html","مجزوء الكامل"],[70,"حبيبي تائه جدا","https://www.aldiwan.net/poem42967.html","الهزج"],[85,"صداح يا ملك الكنار","https://www.aldiwan.net/poem7144.html","مجزوء الكامل"],[85,"يد الملك العلوي الكريم","https://www.aldiwan.net/poem8082.html","المتقارب"],[66,"حبل المنى بحبال اليأس معقود","https://www.aldiwan.net/poem40133.html","البسيط"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[90,"في ذمة الله ما ألقى وما أجد","https://www.aldiwan.net/poem47616.html","الكامل"],[90,"يا أم عوف عجيبات ليالينا","https://www.aldiwan.net/poem60157.html","عموديه"],[48,"أنعت كلبا جال في رباطه","https://www.aldiwan.net/poem64372.html","البسيط"],[48,"راح الشقي على الربوع يهيم","https://www.aldiwan.net/poem65108.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39571","الهزج"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55025","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142016","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54301","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54231","الطويل"],[72,"وهارب من رضوان","https://www.poetsgate.com/ViewPoem.aspx?id=45465",""],[90,"يافا الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179202",""],[90,"احمد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179129",""],[51,"أنَّى تشاغلتَ عن أبي حَسَنِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=30025",""],[51,"عطفاً بني وهبٍ عليْ","https://www.poetsgate.com/ViewPoem.aspx?id=30452",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"]],"verses":[["وَلَفظُ فَمٍ إِذا ما جا","لَ لا تُخشى هَواجِرُه",0,"ر",2,0],["ولَفَّتْ على صَحْنِ العِراقِ عَجاجَها","يُقَدّمُها مِن آلِ إسْحاقَ باسِلُ",1,"ل",1,0],["ولفارِسِ الهَرّارِ فيهِ شَمائِلٌ","لَقِحَتْ بِها الحَرْبُ العَوانُ قديما",2,"م",2,0],["وَلَفِيفُ جُبَّانٍ إِذَا مَا اسْتُوقِفُوا","نَادَتْ بِهِمْ آجَالُهُمْ فَتَسَلَّلُوا",3,"ل",3,0],["ولَفْظُكَ البارِدُ يا سيّدي","منْ زَمْهَريرٍ هَبَّ في فَجِّ",4,"ج",1,0],["ولُفّ في ثوب له واحدٍ","ليس له رقم ولا ميدع",5,"ع",1,0],["ولفظٌ كأنَّ السحرَ فيه محللٌ","ألم ترَهُ في الذَّوقِ غيرَ معقَّد",6,"د",1,0],["ولفظهُ التبرِيّ أو جودهُ","جلته أسماعي وأجيادِي",7,"ي",1,0],["ولفظك الحائز والإ","حسانُ لي بحرٌ وبرّ",8,"ر",1,0],["ولففت هاتيك الذَّوائب أجتلي","نعم العروس أو الأمير مشرْبشا",9,"ش",2,0],["ولفظٌ هو العذبُ الطهور وطالما","أدارَ على الأفهام صرف سلاف",10,"ف",1,0],["ولفضلهِ في كلِّ مقصد قاصدٍ","كم من يسارٍ واصلٍ ليمين",11,"ن",1,0],["ولفظ يقرِّط أسماعنا","بما لا رأت مثله ماريه",12,"ي",2,0],["ولفظناك كريهاً","غير مكروه الفراق",13,"ق",1,0],["ولفَّكَ اللَّهُ في لفائفِ غم","مائكَ حتى تُلفَّ في كفنك",14,"ك",1,0],["ولفوته عامانِ تُوبع فيهما","ولعجزِنا وسكوتنا التظليمُ",15,"م",1,0],["وِلفضلكم وقع القضا","ءُ بأن تسودونا ونَخْدُمْ",16,"م",1,0],["وَلَفظٍ يوجِبُ الغَسلَ","عَلى السامِعِ وَالحَدّا",17,"د",2,0],["ولففته في سُوسن","وحففته بقَرنفل",18,"ل",1,0],["وَلَفظُكَ بِنجٌ وَلَكِنَّهُ","لَطيفُ الصَبا في جُفونِ العَصَب",19,"ب",1,0],["وَلَفظَةٍ لا يَسُدُّ الغَيرُ مَوضِعَها","غَرّاءَ تُحسَبُ ماءً وَهيَ جُلمودُ",20,"د",1,0],["وَلَفَّ بِالجَيشِ حَيَّي قَينُقاعَ بِما","جَنَوا فَتَعساً لَهُم مِن مَعشَرٍ قَزَمِ",21,"م",1,0],["وَلَفَّهم بِخَمِيسٍ لَو يَشُدُّ عَلى","أَركانِ رَضوى لَأَضحى مائِلَ الدِّعَمِ",21,"م",1,0],["ولَفَّني شَبَحٌ ما كانَ أشبَههُ","بجَعْدِ شَعركِ حولَ الوجهِ يَنعْقد",22,"د",1,0],["ولفَّهُ وهجُ الأصواف يُوقِدها","عن صرِّ كانون تَنّوراً وكانونا",23,"ن",2,0],["وَلَفَّ عِشرينَ إِلى أَشراطِهِ","فَلَم نَزَل نَقرِنُ في رِباطِهِ",24,"ط",2,0],["وَلِفارِسِ الأَحرارِ أَنفَسُ أَنفُسٍ","وَفَخارُهُم في عِشرَةٍ مَعدومُ",25,"م",1,0],["ولفَّ النَّهْدَ في لينٍ","وضمَّ الجسدَ اللَّدْنا",26,"ن",2,0],["ولفَّتْ ذراعين كالحيّتينِ","عليَّ وبي نشوةٌ لم تطِرْ",27,"ر",1,0],["وَلفْظٌ لَعُوبٌ وَلَحْظٌ وَثُوبٌ","وَعَقْلٌ رَصِينٌ وَرَأْيٌ حَصِيفْ",28,"ف",1,0],["وَلِفَضلٍ فِي نُهَاهَا اسْتشْعَرَتْ","غِيلَةَ الوَغْدِ إِذِ الْبَارِقُ ذَرَّا",29,"ر",2,0],["ولفت وجهك يمنة، فترى","وجهاً متى تذكره ترتعد :",30,"د",1,0],["ولفكَّكْتُ من أساريرِكَ الكِبْ","رَ بقولٍ من وَخْزَةِ الموتِ أنْكَى",31,"ك",2,0],["وَلَفْظَةٍ سُجِنَتْ في جَوْفِ مُظْلِمَةٍ","لَمْ تَنْظُر الشَّمْسُ مِنْهَا عَيْنَ مُرْتَقِبِ",32,"ب",1,0],["ولَفْظٌ كَوَجهِ الرَّوْضِ في ميْعَةِ الضُّحى","وقَدْ صَدَحَتْ فوقَ الغُصونِ عَنَادِلُهْ",33,"ل",2,0],["ولفظه كالمرجان","لفظ عليّ التبيان",34,"ن",1,0],["ولفَّ الغادةَ الحسناءَ ليلٌ","مُريبُ الخطوِ ليسَ به شِهاب",35,"ب",1,0],["ولفظٌ هجينٌ ثوَتْ تحتهُ","معانٍ لِقلَّتها تًحتكر",36,"ر",1,0],["ولفَّكَ اللَّهُ في لفائفِ غما","ئكَ حتى تُلفَّ في كفنك",37,"ك",1,0],["وِلفضلكم وقع القضا","ءُ بأن تَسودونَ ونَخْدم",38,"م",1,0],["وَلَفْتَتِهَا الغَضْبَى وَمِشْيَتِهَا الخَزْلِ","فَمَا هِيَ مِنْهَا فِي الطَّهَارَةِ رَغْبَةٌ",39,"ه",1,0]]}