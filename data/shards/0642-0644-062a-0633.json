{"poems":[[90,"لا تأمنن دنياك في حالة","https://www.aldiwan.net/poem44805.html","السريع"],[94,"نحن نمشي وحولنا هاته الأك","https://www.aldiwan.net/poem38888.html","الخفيف"],[91,"إن في أوسع الفضاء نجوما","https://www.aldiwan.net/poem45105.html","الخفيف"],[68,"وغزال غازلته بعد بين","https://www.aldiwan.net/poem39511.html","الكامل"],[71,"لثغة من أهواه من حسنها","https://www.aldiwan.net/poem28457.html","السريع"],[69,"أهوى والمشيب قد حال دونه","https://www.aldiwan.net/poem18134.html","الخفيف"],[203,"قلت للشادن مل لي","https://www.aldiwan.net/poem45169.html","مجزوء الرمل"],[257,"وميض ثغر يفتر بالثغر","https://www.aldiwan.net/poem1447.html",""],[289,"ولقد قلت حين أجحرني البرد","https://www.aldiwan.net/poem44308.html","الخفيف"],[289,"ولقد قلت حين أقفر بيتي","https://www.aldiwan.net/poem44312.html","الخفيف"],[353,"ورقيع يأبى السلام علينا","https://www.aldiwan.net/poem20707.html","الخفيف"],[409,"فكرت من أهوى لمن لامني","https://www.aldiwan.net/poem33636.html","السريع"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130205","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38409","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62460","الرمل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56101","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58288","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200917","الخفيف"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59512","المتقارب"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76472","الرمل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81298","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81276","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136642",""],[4481,"","https://poetry.dctabudhabi.ae/diwan/poem/34004","الرمل"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119537","الخفيف"],[5409,"جمعوهم كحزمة من مفاتي","https://www.poetsgate.com/ViewPoem.aspx?id=155383",""]],"verses":[["قلت سلوا الكرخ فذو أمره","في تلكم الدائرة الماكره",0,"ر",2,0],["قلتُ سيري معَ الحَيَاةِ فقالتْ","مَا جنينا تُرى من السَّيْرِ أَمسِ",1,"س",1,0],["قلت سبحان هذه الزهر من آله","ة الكون وحدها والفساد",2,"د",1,0],["قُلتُ سَمعاً وَطاعَةً لَكَ مَولا","يَ وَلَكِن لُعبُنا في رُهَينِ",3,"ن",1,0],["قلتُ سهامُ الطرفِ منسولةٌ","لرميِ قلبي قال منثولَهْ",4,"ل",2,0],["قلتُ سيوفُ الصبرِ مسلولةٌ","عليكَ منّي قال مثلولَهْ",4,"ل",2,0],["قُلْتُ سِيري فَإنَّنِي لَكِ خَيْرٌ","مِنْ أَبٍ رَاحِمٍ وَأُمٍّ حَنُونَهْ",5,"ن",2,0],["قلتُ سل لي ذلكَ القل","بَ فقالَ القلبُ سالي",6,"ل",2,0],["قُلتُ سَنا البَدرِ كَي أُغالِطَهُم","وَلَيسَ من ثَمّ مَطلعُ البَدرِ",7,"ر",1,0],["قُلتُ سِر راشِداً فَخارَ لَكَ الل","ه وَلا تَعُد كَرَبَجِ البَقالَه",8,"ل",2,0],["قُلتُ سِر راشِداً إِلى بَيتِ جارٍ","مُخصِبٍ رَحلُهُ عَظيمُ التِجارَةِ",9,"ر",2,0],["قُلْتُ سَلِّمْ إذا مَرَرْتَ بِقَومٍ","فَهُوَ الشَّرعُ قالَ لي لا أُسلِّمُ",10,"م",1,0],["قلت سباني حبه جملة","فقال زدني أيها الواصف",11,"ف",1,0],["قلت سلمان بابه خير باب","وهو باب له صحيح مجرب",12,"ب",1,0],["قُلتُ سَمعاً وَاِمتِثالاً","تُبت مِنْ أَنّي أَتوبُ",13,"ب",1,0],["قلتُ سوقُ الشعراء كاسِدٌ","والأديب اليومَ ممضوض الكَبِدْ",14,"د",1,0],["قلت سمعاً وسرت حيث استشاروا","خايضاً في الظلام تلك الوحولا",15,"ل",2,0],["قُلتُ سرّحْ شَعْرَ الحبيبِ باحسا","نٍ وَخَلِّصْ خَبْلي بهذا الغلامِ",16,"م",1,0],["قلت سيروا للغرب سعيا لعلمٍ","وادرسوا وادرسوا عسى تفهموني",17,"ي",1,0],["قلتُ سقيم وفي فؤادي","همٌّ وفي القلب نار الضّرامْ",18,"م",1,0],["قلت سيف الموت في الش","عب مَسلولا",19,"ل",2,0],["قُلت سِيري عَلى أُسرة قَومي","وَاِستَحري عَلى مضاجع رَهطي",20,"ط",2,0],["قُلت سَيروا بِنَعشِهِ في هَوادي ا","لريح وَاِمشوا بِهِ عَلى نَكبائِهِ",21,"ا",3,0],["قلت سمعاً يا مُنية النفس إنيّ","فيك أصبحتُ هائماً مفتونا",22,"ن",2,0],["قُلتُ سَل قَلبَكَ يُخبِركَ بِهِ","فَتَحايا بَعدَما كانَ مَحَن",23,"ن",1,0],["قلت سيدي ولم تؤثر الل","يل على بهجة النهار المنير",24,"ر",1,0],["قلت سبحان من يسخر بعض الن","ناس منا لبعضهم كالدواب",25,"ب",1,0]]}