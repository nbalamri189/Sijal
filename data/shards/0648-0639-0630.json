وح","https://www.aldiwan.net/poem3149.html","عموديه"],[462,"شف قلبي دلاله","https://www.aldiwan.net/poem3358.html","عموديه"],[462,"أشرب على ورد الخدود وغنني","https://www.aldiwan.net/poem3431.html","عموديه"],[466,"وعذول كان من قولي له","https://www.aldiwan.net/poem59638.html","الرمل"],[481,"هجرت أمامة هجراً طويلا","https://www.aldiwan.net/poem2071.html","المتقارب"],[493,"أيا دمع إن لم ينجد الصبر أنجد","https://www.aldiwan.net/poem9817.html","الطويل"],[498,"قل لغزلان بقيعان النقا","https://www.aldiwan.net/poem37937.html","الرمل"],[503,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[512,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[513,"صرف النسيب إلى اللوى وزرود","https://www.aldiwan.net/poem12082.html","الكامل"],[532,"أزف لك التحية والسلاما","https://www.aldiwan.net/poem23815.html","الوافر"],[549,"ليس في العشق جناح","https://www.aldiwan.net/poem47901.html","مجزوء الرمل"],[549,"ماذا يضيرك هند من حبي","https://www.aldiwan.net/poem48051.html","أحذ الكامل"],[565,"بليت ولج بي وجدي بظبي","https://www.aldiwan.net/poem69762.html","الوافر"],[573,"شفاك الله من دائك","https://www.aldiwan.net/poem2699.html","الهزج"],[573,"أيا دمع عيني لا تكن بعد إخواني","https://www.aldiwan.net/poem2776.html","الطويل"],[573,"الشام للإسلام دار القرار","https://www.aldiwan.net/poem3069.html","السريع"],[581,"كبيشة عرسي تمنى الطلاقا","https://www.aldiwan.net/poem443.html",""]],"verses":[["وَعُذ بِإِغضائِيَ وَاِستَعِذني","وَاِحذَر عِداءَ قاطِعٍ في ضِمني",0,"ي",1,0],["وَعُذتُ بِجانِبَيكَ مِنَ الرَزايا","مَعاذي في الهَواجِرِ بِالظِلالِ",1,"ل",1,0],["وَعَذَرتُهُ بَعدَ الإِباءِ لِأَنَّهُ","ظَنَّ الَّذي يُطرى كَأَنتَ فَخافا",2,"ف",2,0],["وعَذَرْتُ كُلَّ مُكاشِحٍ أُبْلَى بِهِ","فبَليَّتي مِمَّنْ أُصاحِبُ أعْظَمُ",3,"م",1,0],["وَعَذَّبتُموني بِالجَفاءِ وَإِنَّني","لَراضٍ بِما تَرضَون لي وَهُوَ الغَبَن",4,"ن",1,0],["وَعَذَّبتُ قَلبي بِالتَجَلُّدِ صادِياً","إِلَيكِ وَإِن لَم يَصفُ لي مِنكِ مَنهَلي",5,"ل",2,0],["وَعَذَّبَهُ الهَوى حَتّى بَراهُ","كَبَريِ القَينِ بِالسَفَنِ القِداحا",6,"ح",2,0],["وعُذْنا بذاك المجْدِ فانْصَرَم الرّدى","ولُذْنا بذاكَ العزْمِ فانهزَمَ الذّعْرُ",7,"ر",1,0],["وَعُذافِرٍ سَدَسٍ تَخالُ مَحالَهُ","بُرجاً تُشَيِّدُهُ النَبيطُ القَرمَدا",8,"د",2,0],["وَعَذَرتُ طَيفَكَ في الجَفاءِ لِأَنَّه","يَسري فَيُصبِحُ دونَنا بِمَراحِلِ",9,"ل",1,0],["وعذر من الإعذار قرر حكمه","من الشرع أخبارٌ رُفعن عواليا",10,"ي",2,0],["وعذراً فإني إن أطلْتُ فإِنما","قصارايَ من بعد البيان قصورُ",11,"ر",1,0],["وَعُذتُ بِصارِمٍ وَيَدٍ وَقَلبٍ","حَماني أَن أُلامَ وَأَن أُضاما",12,"م",2,0],["وعذْ من الخوفِ والبؤسِ بذي هممٍ","للمدحِ مجتلبٍ للذمِّ مجتنِب",13,"ب",1,0],["وعذارٌ أظنُّه وهو خافٍ","حولَ خدَّيك زئبرَ الدِّيباج",14,"ج",1,0],["وعذولٌ في الحبِّ يجمع للمغ","رم بين الطاعون والحجَّاج",14,"ج",1,0],["وعذَّبني ذاك المليح بنارِهِ","فكانَ عذاب القلب فيهِ غراما",15,"م",2,0],["وعذري من التقصير في القول أنني","حسيرُ سقام عضَّ جسمي فأوجعا",16,"ع",2,0],["وعُذتُ به من كل شيء أخافُه","فألفيتُه بعضَ الجبال العواصمِ",17,"م",1,0],["وَعَذبُ الكَرى يَشفي الصَدى بَعدَ هَجعَةٍ","لَهُ مِن عُروقِ المُستَظِلَّةِ مائِحُ",18,"ح",1,0],["وَعُذِّبَ بِالعِلمِ طُلّابُهُ","وَغَصّوا بِمَنهَلِهِ الأَعذَبِ",19,"ب",1,0],["وَعَذَلتُ أَهلَ العِشقِ حَتّى ذُقتُهُ","فَعَجِبتُ كَيفَ يَموتُ مَن لا يَعشَقُ",20,"ق",1,0],["وَعَذَرتُهُم وَعَرَفتُ ذَنبِيَ أَنَّني","عَيَّرتُهُم فَلَقيتُ فيهِ ما لَقوا",20,"ق",3,0],["وَعَذَرتُ سَيفي في نُبُوِّ غِرارِهِ","أَنّي ضَرَبتُ فَلَم أَقَع بِالمَضرَبِ",21,"ب",1,0],["وَعَذَلتَني أَن أَدرَكَتني صَبوَةٌ","خَلَصَت إِلى داوُدَ في المِحرابِ",22,"ب",1,0],["وَعَذلُكِ عِندي مِثلُ عُذرٍ فَأَقصِري","وَلَومُ القَعودِ الفَحلَ إِحدى العَجائِبِ",23,"ب",1,0],["وعُذنا من مَساجِدِهم بدَيْرٍ","وبالناقوسِ من صَوْتِ الأذانِ",24,"ن",1,0],["وعَذارَى كأنَّهُنَّ مِنَ الحُس","نِ عَذارَى سَفَرْنَ للعُشَّاقِ",25,"ق",1,0],["وَعَذلُ الفَتى ما فيهِ فَضلٌ لِغَيرِهِ","إِذا ما الفَتى عَن نَفسِهِ ضاقَ عَذلُهُ",26,"ل",2,0],["وَعُذولٍ باتَ لي","عَنهُ زاجِر",27,"ر",1,0],["وعذابها من وحشة طالت","وحنين مجهولٍ لمجهولِ",28,"ل",1,0],["وعذراءَ كانت وردةً قبل مزجها","ومن بعده عَنّتْ لِمُبصرها شعلا",29,"ل",2,0],["وعذراء يغشاها ذكورُ أسِنّةٍ","وتُثْنَى لِجَمعٍ كُلَّما افتَرقَ الجمعُ",30,"ع",1,0],["وَعَذْبُ الدموعِ دليلٌ على","بُكاءِ تبَسُّمِ بَرْقٍ وَمَض",31,"ض",1,0],["وعَذَرتُ مِنكِ الخصرَ مَرْحَمَةً","ولِحَملِ ردفِكِ يُعْذَرُ الخصرُ",32,"ر",1,0],["وَعِذابٌ لَو اِنَّها أُطعِمَت زا","دَت عَلى الشَهدِ بَسطَةً في المَذاقِ",33,"ق",1,0],["وَعَذَّبوا أَهلَ دِينِ اللَّهِ وَاِنتَهَكوا","مَحارِماً أَعقَبَتهُم لَهفَةَ النَّدَمِ",34,"م",1,0],["وعذولُ سوءٍ زادَ قلبي وجعةً","ما ضرَّهُ لو أنهُ بيَ رافقُ",35,"ق",1,0],["وَعِذابَ الطَعمِ غُرّا","كَأَقاحي الرَملِ بيضا",36,"ض",2,0],["وَعَذَّبَ بالي نَعَّمَ اللَهُ بالَهُ","وَسَهَّدَني لا ذاقَ بَلوى التَسَهُّدِ",37,"د",1,0],["وَعُذِّرَ خَدّاهُ بِخَطَّينِ قُوِّما","كَما أَثَّرَ التَسطيرُ في رَقِّ كاتِبِ",38,"ب",1,0],["وَعِذارٍ زانَهُ مِن","زَغَبِ الشَعرِ لِجامُ",39,"م",1,0],["وَعَذراءَ لا تَجري بِلَحمٍ وَلا دَمٍ","بَعيدَةِ شَكوى الأَينِ مُلحَمَةِ الدَبرِ",40,"ر",1,0],["وَعُذتُ بِاللَهِ مِن عامٍ أَخي سَنَةٍ","نُجومُهُ في دُخانٍ ثائِرٍ شَرَُر",41,"ر",1,0],["وَعُذِّرَت حاجَةٌ بِعُسرٍ","عَلى عَليلٍ قَدِ اِشتَهاها",42,"ا",3,0],["وَعَذاريكُم مُقَلِّصَةٌ","في ذَعاعِ النَخلِ تَجتَرِمُه",43,"م",2,0],["وعذاباً للذي قد","شرب الخمر عظيما",44,"م",2,0],["وعذرُك أنت آلام ثِقالٌ","لهنَّ بعيشةِ الأدباء لَصْقُ",45,"ق",1,0],["وَعَذَلتَني أنْ أدْرَكَتني صَبْوَةٌ","خَلُصَتْ إلى داودَ المِحرَابِ",46,"ب",1,0],["وعذلك مثل غذر فاقصري،","ولوم القعود الفحل إحدى العجائب",47,"ب",1,0],["وعذب ذاب اللمى","مضناه كم عذبا",48,"ب",2,0],["وعذراء كالغصن الرطيب إذا انثنت","وكالشمس لاحت حين منتصف الطَّفل",49,"ل",1,0],["وعذابٌ لهم فيها مُقيمْ","أنتَ يا رب لمن تابَ رحيمْ",50,"م",1,0],["وعذتُ بمسعود أخي الجودِ والندَى","يُنِيلُ البرايَا والسنينُ مُحُولُ",51,"ل",1,0],["وعذاراهم عَدت بعد لُبس","الخز تختالُ في الثيابِ الحدادِ",52,"د",1,0],["وعذرُ الشمسِ لو حسدتكَ بادٍ","لأن سناكَ أشهرُ من سناها",53,"ا",3,0],["وَعَذراءَ لَمّا تَلِدها النِساءُ","وَلَكِنَّها مِن بَناتِ الفِكَر",54,"ر",1,0],["وعذل يهيج شدوى عذله","فبات يغرى وهو ليس يدري",55,"ي",1,0],["وعذرت جودك والوشات تصده","عني وبعد العذر مالي حجة",56,"ه",1,0],["وعذارٍ كأنَّما","مدَّ في الخَدِّ أرقَما",57,"م",2,0],["وعذرا أنْ تعثَّرَ خَطْوُ حَرْفي","فَهذا الشِّعْرُ مِنْ وَحْيِ اضْطِرابي",58,"ب",2,0],["وَعَذلتُ تَقصيري بِوَصفِكَ عاجِزاً","وَعلمتَهُ فَعَذَرتَني مُتفضِّلا",59,"ل",2,0],["وَعَذَرتُ نَفسي في هَواكِ لِأَنَّني","أَورَدتُها في الحُبِّ أَعذَبَ مَنهَلِ",60,"ل",1,0],["وعَذابُه عَذْبٌ ولكنْ لا تَفِى","لَذّاتُه بالنَّزْرِ من آفاته",61,"ت",2,0],["وَعُذرهمُ كالشَمسِ في تَركِهم له","وَمِن جَهلِهم باللَّه قَد عَبَدوا الدَهرا",62,"ر",2,0],["وعذراء زفتها المنونُ فلم تجدْ","سوى القبر من صهرٍ أعفَ وأكرما",63,"م",2,0],["وعذب المقبَّل والمبتسمْ","لذيذ المراشف والملتَثَمْ",64,"م",1,1],["وعذري في شكواي والله واضح","ولكن حالي اليوم اوضح من عذري",65,"ر",2,0],["وعذّلي فيه ولوا","مذ عاينوا الصدغ كالحا",66,"ح",2,0],["وَعَذابٍ قد فاحَ منهُ بَخورٌ","خالِدٌ في مَجابِرِ الأَحلامِ",67,"م",1,0],["وَعَذارى الفَضاءِ ماذا أَسَرَّت","لَكَ لَمّا أَضَفتَها في الفَضاءِ",68,"ا",2,0],["وعذبة الألفاظ معشوقةٍ","ساحرِة الأَوتار والشِعْر",69,"ر",1,0],["وَعَذبَةُ الريقِ أَودى بي تَأَوُّدُها","وَجداً وَساعَدَها خالٌ وَخلخالُ",70,"ل",1,0],["وَعَذارى القَريضِ بَعدَ كَسادٍ","عُدنَ مِنهُنَّ غالِياتِ المُهورِ",71,"ر",1,0],["وَعُذْرِي حَيْثُ لَيْسَ لِي اعْتِذَارٌ","دُخُولِي مِنْ رِضَاكَ عَلَيَّ بَابَا",72,"ب",2,0],["وَعَذُولِي عَذْلُهُ ضَائِعٌ","مِثْلَ مَا ضَاعَ سِرَاجُ الصَّباحْ",73,"ح",1,0],["وعذارٍ ما زال يُخلعُ في الحُ","بِّ عليه من كل صَبٍ عِذَارُه",74,"ر",2,0],["وعذرتُ خلّاً قد سقاني خَلَّهُ","وأرادَ حينَ الضعفِ أن نتآخى",75,"خ",2,0],["وَعذول لامى في الحب لَو","ذاق كاس الحب مثلي عذرا",76,"ر",2,0],["وَعَذاب تَرتَضون به","في فمي أَحلى من النعم",77,"م",1,0],["وَعِذَاراً إِذَا أَلَمَّ بِخَدٍّ","دَبَّ فيهِ كَما تَدِبُّ العَقَارِبْ",78,"ب",1,0],["وَعَذَرْتَ فِي أَنْ لا أُطِيقَ تَجَلُّداً","وَعَجِبْتَ مِنْ أَنْ لا أَذُوبَ تَحَرُّقا",79,"ق",2,0],["وَعَذولٍ رامَ نُصحي في الهَوى","كلَّما خاطَبَني قُلتُ سَلاما",80,"م",2,0],["وعَذولاً يُظهرُ النُصحَ بهم","فإِذا نَهنَهتُهُ زاد لجاجا",81,"ج",2,0],["وَعُذرُهُ كانَ إِن قَد فاتَ فِكرَتُهُ","أَمرُ السُؤالِ وَنِعمَ العُذرُ بِالهاءِ",82,"ا",2,0],["وعذارى فينوس يرقصن حولي","ويمجّدن فنّىَ الأبديّا",83,"ي",2,0],["وَعَذارٍ ثَنى عَذا","ري خَليعاً جَديدُهُ",84,"د",2,1],["وَعُذتُ بِكَهفِ الجِنِّ مِنهُم فَصارَ لي","مُجِيّا فَلا عَقلي يُحَسُّ وَلا حِسّي",85,"ي",1,0],["وَعَذبُ لَمى فيهِ لِما فيهِ شَفَّني","شِفاً وَلِبالي مِن صَدى صَدِّهِ وَبلُ",86,"ل",1,0],["وَعُذ بِها مِن غَفلَةٍ عَن أَمرِها","في سَترِها تُعقِبُ في الكَشفِ الخَجَل",87,"ل",1,0],["وَعذرى واضِح فيها لاني","لَدى الفُضَلاء ذوباع قَصير",88,"ر",1,0],["وَعَذولِهِ وَكَفاهُ هَمُّ عَذولِهِ","وَالمَوتُ مِنهُ وَمِن تَفَلسُفِ رائِهِ",89,"ا",3,0],["وَعَذولٍ هَبِلَتهُ أُمُّهُ","لَم يَقُل قَولاً فَلا يَعلُ هُبَل",90,"ل",1,0],["وَعَذابُ الغَرامِ أَعذَبُ في خا","طِرِ حُبّي مِن راحَةِ السُلوانِ",91,"ن",1,0],["وَعُذرُ غَدرِهِ في مِسمَعي","كَما طَنَّ في لَوحِ الهَجيرِ ذُبابُ",92,"ب",1,0],["وَعَذول قلَّ أَن يَحتَشِما","لَم يَنَل مِن عَذلِهِ إِلّا التَعَب",93,"ب",1,0],["وَعَذولي لا يَملّ الفَندا","كُلّ مَن لامَ مُحِباً أَثما",93,"م",2,0],["وَعَذابي ماء النَعيم الَّذي را","قَ عَلى جَمر وَجنَتَيهِ النَديِّ",94,"ي",1,0],["وعذاب الله لا انجي لنا","منه من ذكر المهيمن ذي الجلال",95,"ل",1,0],["وعُذراً فقد قابلتُ درّكَ بالحصَى","وساجلتُ بحراً زاخراً بثمادِ",96,"د",1,0],["وعذرك في ترك الملامةِ واضحٌ","وما ليَ في تركِ الصبَّابة مِن عُذرِ",97,"ر",1,0],["وعذرك ألف مقبول وعندي","بأنك في اعتذارك لا تلام",98,"م",1,0],["وعذراً إذا كان الجواب كما ترى","وإني بالحصباء أكافي عن الدُّرِّ",99,"ر",1,0],["وعذراً في الذي مني تراه","فليس كما تريد ولا أريد",100,"د",1,0],["وعذرك مقبول وحاشاك لم تكن","تعاملني ما عشت يوماً بجفوة",101,"ه",1,0],["وعذولاً يعذل الصب إذا","صار من نار الهوى ملتهباً",102,"ب",2,0],["وعذرُكَ في قضا شُغلِي قضاءٌ","يُصرِّفُهُ فَما عُذْرُ الجَوابِ",103,"ب",1,0],["وعُذْتُ بالرَّحم وهي عَوْذَةٌ","أخزَتْ به شيطانها اللَّعينا",104,"ن",2,0],["وعذارٍ مذ بدا أرَّخته","لاحَ كالمسك عذار لمحمَّد",105,"د",1,0],["وعذرتها وعذلت عاذلها","والعذل بيَّنَ بَيِّنَ العذر",106,"ر",1,0],["وعُذ بمُعجزِ آيات المُدامة من","نوافثِ السحر في أجفانِ حَوراء",107,"ا",2,0],["وَعَذْرَاءَ لَمْ يأَتِ الزمانُ بِكُفْئِهَا","ولا رامها بَعْلٌ وإِنْ عَزَّ جانِبُهْ",108,"ب",2,0],["وعذراء إن صدت فليس تبدلت","علي وإن زارت فليس تمانع",109,"ع",1,0],["وعذولي لجّ في عذلي اذ","لم ير الخال على الخد الاسيل",110,"ل",1,0],["وعذراً لما سطرت عذر مقصّر","ولولاكم ما ازدان نظماً ولا رَصفا",111,"ف",2,0],["وعذراءَ من سرّ الفصاحة بيتُها","طويل العمادِ متعِبٌ من يطاولُهْ",112,"ل",2,0],["وعذرتُ في فَرط العقوق أرقَّةً","لؤماءَ حتى عقّني الأشرافُ",113,"ف",1,0],["وعذراء سقتُ لكم بُضعَها","ولولا رجاؤك لم تُبضعِ",114,"ع",1,0],["وعذراءَ بكراً من عوارفِ ربّها","حُبيت بها ما كلّ عارفةٍ بِكرُ",115,"ر",1,0],["وعَذارَى من القوافي تعوّض","تُ بهنّ التعليلَ والتعذيرا",116,"ر",2,0],["وعذراء مما استنجبَ الفكرُ وارتضَى","معقَّلة في الخِدرِ وهي شرودُ",117,"د",1,0],["وعذلٌ فيك أوجعَ نازلٌ بي","أنا الملسوعُ والعذلُ العِدادُ",118,"د",1,0],["وعّذراءَ عندي من نداهُ وثيِّبٍ","إذا جُلِيَتْ زانَ العُقودَ تَريبُها",119,"ب",3,0],["وعذراءَ تُذْكِر نُعماك بي","وإن كنتُ لستُ بها مستريبا",120,"ب",2,0],["وعذرٌ لمن يخشاك كبشُ كتيبة","يعود كسيراً قرنهُ وهو منطوح",121,"ح",1,0],["وعذولي فيهِ وأضي","عُ شيء مقالهُ",122,"ل",2,0],["وعذلتي لمّاً ظننت فراقهم","هيناً وما خطبُ الفراق بهيّنِ",123,"ن",1,0],["وَعَذولٍ كانَ مِن قَولي لَهُ","لَستُ أَستَحسِنُ أَجفو الحَسَنا",124,"ن",2,1],["وَعِذرَتُها أَنَّ كُلَّ اِمرِئٍ","مُعِدٌّ لَهُ كُلَّ يَومٍ شُكولا",125,"ل",2,0],["وعذري عند اللّه فيك ممهد","وإن كان عند الناس غير ممهد",126,"د",1,0],["وعَذولي لم يزلْ يَروي بِكُمْ","كَذِباً يا ليتَ يوماً صَدَقَا",127,"ق",2,0],["وعذتُ بخالقي لمّا","تجلّى البعدُ خُسْرانا",128,"ن",2,0],["وعذَلْتُموني إذ خلَعْتُ بحُبِّكُم","عُذري فعُذري عندَكُم لا يُسمَعُ",129,"ع",1,0],["وعذرت من حسد الرجال على العلى","لما ظفرت بلذة المحسود",130,"د",1,0],["وعذرا إن أطلت القول إني","أردت الاختصار فما استقاما",131,"م",2,0],["وعذابٌ إنْ نأى عن","هُ وصالٌ وسماحُ",132,"ح",1,0],["وَعذلتِ منّي من له أُذُنٌ","صمّاءُ عن عَذْلٍ وعن عَتْبِ",133,"ب",1,0],["وعذَّبَني قَضيبٌ في كَثيبٍ","تَشَارَكَ فيه لِينٌ واندِمَاجُ",134,"ج",1,0],["وعُذْرِي إِنْ يَكُنْ ذَنْباً","فَقَابِلْهُ بإِغْضَائِك",135,"ك",1,0],["وعذرُ فؤادِي لا كعُذْرِك واضحٌ","فأَنت طليقٌ والفؤادُ هو العَانِي",136,"ي",1,0],["وعذرُهم إِذْ هربُوا واضِحٌ","هل يثبتُ اللَّيلُ أَمَام النَّهارْ",137,"ر",1,0],["وَعذبَ المَذاقَةِ كالأُقحوانِ","جادَ عليهِ الرَبيعُ البِراقا",138,"ق",2,0]]}