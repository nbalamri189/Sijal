"داء بقلبي وداء القلب يضنيه","https://www.poetsgate.com/ViewPoem.aspx?id=130644",""],[6031,"عَزيزٌ أَمرُنا لَكَ بالتعزِّي","https://www.poetsgate.com/ViewPoem.aspx?id=46290",""],[6031,"أكفُّ البَرَايَا مِنْ تُرَاثِهِمُ صُفْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=46279",""],[6033,"تَصَبَّرْ!","https://www.poetsgate.com/ViewPoem.aspx?id=215799",""],[6038,"غزوة رمش","https://www.poetsgate.com/ViewPoem.aspx?id=27051",""],[6127,"النذير","https://www.poetsgate.com/ViewPoem.aspx?id=215049",""],[6143,"عذرا رسول الله...","https://www.poetsgate.com/ViewPoem.aspx?id=175095",""],[572,"بُليتُ وَلَجّ بي وَجْدٌ بِظَبْيٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9196&r=&rc=53",""]],"verses":[["وعذت به في السبط من شر مُبغض","لتخطيئهِ في شق صفٍ تلوما",0,"م",2,0],["وَعُذ بِإِغضائِيَ وَاِستَعِذني","وَاِحذَر عِداءَ قاطِعٍ في ضِمني",1,"ن",2,0],["وَعُذتُ بِجانِبَيكَ مِنَ الرَزايا","مَعاذي في الهَواجِرِ بِالظِلالِ",2,"ل",1,0],["وَعَذَرتُهُ بَعدَ الإِباءِ لِأَنَّهُ","ظَنَّ الَّذي يُطرى كَأَنتَ فَخافا",3,"ف",2,0],["وعَذَرْتُ كُلَّ مُكاشِحٍ أُبْلَى بِهِ","فبَليَّتي مِمَّنْ أُصاحِبُ أعْظَمُ",4,"م",1,0],["وَعَذَّبتُموني بِالجَفاءِ وَإِنَّني","لَراضٍ بِما تَرضَون لي وَهُوَ الغَبَن",5,"ن",1,0],["وَعَذَّبتُ قَلبي بِالتَجَلُّدِ صادِياً","إِلَيكِ وَإِن لَم يَصفُ لي مِنكِ مَنهَلي",6,"ل",2,0],["وَعَذَّبَهُ الهَوى حَتّى بَراهُ","كَبَريِ القَينِ بِالسَفَنِ القِداحا",7,"ح",2,0],["وعُذْنا بذاك المجْدِ فانْصَرَم الرّدى","ولُذْنا بذاكَ العزْمِ فانهزَمَ الذّعْرُ",8,"ر",1,0],["وَعُذافِرٍ سَدَسٍ تَخالُ مَحالَهُ","بُرجاً تُشَيِّدُهُ النَبيطُ القَرمَدا",9,"د",2,0],["وَعَذَرتُ طَيفَكَ في الجَفاءِ لِأَنَّه","يَسري فَيُصبِحُ دونَنا بِمَراحِلِ",10,"ل",1,0],["وعذر من الإعذار قرر حكمه","من الشرع أخبارٌ رُفعن عواليا",11,"ي",2,0],["وعذراً فإني إن أطلْتُ فإِنما","قصارايَ من بعد البيان قصورُ",12,"ر",1,0],["وَعُذتُ بِصارِمٍ وَيَدٍ وَقَلبٍ","حَماني أَن أُلامَ وَأَن أُضاما",13,"م",2,0],["وعذْ من الخوفِ والبؤسِ بذي هممٍ","للمدحِ مجتلبٍ للذمِّ مجتنِب",14,"ب",1,0],["وعذارٌ أظنُّه وهو خافٍ","حولَ خدَّيك زئبرَ الدِّيباج",15,"ج",1,0],["وعذولٌ في الحبِّ يجمع للمغ","رم بين الطاعون والحجَّاج",15,"ج",1,0],["وعذَّبني ذاك المليح بنارِهِ","فكانَ عذاب القلب فيهِ غراما",16,"م",2,0],["وعذري من التقصير في القول أنني","حسيرُ سقام عضَّ جسمي فأوجعا",17,"ع",2,0],["وعُذتُ به من كل شيء أخافُه","فألفيتُه بعضَ الجبال العواصمِ",18,"م",1,0],["وَعَذبُ الكَرى يَشفي الصَدى بَعدَ هَجعَةٍ","لَهُ مِن عُروقِ المُستَظِلَّةِ مائِحُ",19,"ح",1,0],["وَعُذِّبَ بِالعِلمِ طُلّابُهُ","وَغَصّوا بِمَنهَلِهِ الأَعذَبِ",20,"ب",1,0],["وَعَذَلتُ أَهلَ العِشقِ حَتّى ذُقتُهُ","فَعَجِبتُ كَيفَ يَموتُ مَن لا يَعشَقُ",21,"ق",1,0],["وَعَذَرتُهُم وَعَرَفتُ ذَنبِيَ أَنَّني","عَيَّرتُهُم فَلَقيتُ فيهِ ما لَقوا",21,"ق",3,0],["وَعَذَرتُ سَيفي في نُبُوِّ غِرارِهِ","أَنّي ضَرَبتُ فَلَم أَقَع بِالمَضرَبِ",22,"ب",1,0],["وَعَذَلتَني أَن أَدرَكَتني صَبوَةٌ","خَلَصَت إِلى داوُدَ في المِحرابِ",23,"ب",1,0],["وَعَذلُكِ عِندي مِثلُ عُذرٍ فَأَقصِري","وَلَومُ القَعودِ الفَحلَ إِحدى العَجائِبِ",24,"ب",1,0],["وعُذنا من مَساجِدِهم بدَيْرٍ","وبالناقوسِ من صَوْتِ الأذانِ",25,"ن",1,0],["وعَذارَى كأنَّهُنَّ مِنَ الحُس","نِ عَذارَى سَفَرْنَ للعُشَّاقِ",26,"ق",1,0],["وَعَذلُ الفَتى ما فيهِ فَضلٌ لِغَيرِهِ","إِذا ما الفَتى عَن نَفسِهِ ضاقَ عَذلُهُ",27,"ل",2,0],["وَعُذولٍ باتَ لي","عَنهُ زاجِر",28,"ر",1,0],["وعذابها من وحشة طالت","وحنين مجهولٍ لمجهولِ",29,"ل",1,0],["وعذراءَ كانت وردةً قبل مزجها","ومن بعده عَنّتْ لِمُبصرها شعلا",30,"ل",2,0],["وعذراء يغشاها ذكورُ أسِنّةٍ","وتُثْنَى لِجَمعٍ كُلَّما افتَرقَ الجمعُ",31,"ع",1,0],["وَعَذْبُ الدموعِ دليلٌ على","بُكاءِ تبَسُّمِ بَرْقٍ وَمَض",32,"ض",1,0],["وعَذَرتُ مِنكِ الخصرَ مَرْحَمَةً","ولِحَملِ ردفِكِ يُعْذَرُ الخصرُ",33,"ر",1,0],["وَعِذابٌ لَو اِنَّها أُطعِمَت زا","دَت عَلى الشَهدِ بَسطَةً في المَذاقِ",34,"ق",1,0],["وَعَذَّبوا أَهلَ دِينِ اللَّهِ وَاِنتَهَكوا","مَحارِماً أَعقَبَتهُم لَهفَةَ النَّدَمِ",35,"م",1,0],["وعذولُ سوءٍ زادَ قلبي وجعةً","ما ضرَّهُ لو أنهُ بيَ رافقُ",36,"ق",1,0],["وَعِذابَ الطَعمِ غُرّا","كَأَقاحي الرَملِ بيضا",37,"ض",2,0],["وَعَذَّبَ بالي نَعَّمَ اللَهُ بالَهُ","وَسَهَّدَني لا ذاقَ بَلوى التَسَهُّدِ",38,"د",1,0],["وَعُذِّرَ خَدّاهُ بِخَطَّينِ قُوِّما","كَما أَثَّرَ التَسطيرُ في رَقِّ كاتِبِ",39,"ب",1,0],["وَعِذارٍ زانَهُ مِن","زَغَبِ الشَعرِ لِجامُ",40,"م",1,0],["وَعَذراءَ لا تَجري بِلَحمٍ وَلا دَمٍ","بَعيدَةِ شَكوى الأَينِ مُلحَمَةِ الدَبرِ",41,"ر",1,0],["وَعُذتُ بِاللَهِ مِن عامٍ أَخي سَنَةٍ","نُجومُهُ في دُخانٍ ثائِرٍ شَرَُر",42,"ر",1,0],["وَعُذِّرَت حاجَةٌ بِعُسرٍ","عَلى عَليلٍ قَدِ اِشتَهاها",43,"ا",3,0],["وَعَذاريكُم مُقَلِّصَةٌ","في ذَعاعِ النَخلِ تَجتَرِمُه",44,"م",2,0],["وعذاباً للذي قد","شرب الخمر عظيما",45,"م",2,0],["وعذير الزمان مما أقاسي","ه انفراد الكرام بالمعروف",46,"ف",1,0],["وعذرُك أنت آلام ثِقالٌ","لهنَّ بعيشةِ الأدباء لَصْقُ",47,"ق",1,0],["وَعَذَلتَني أنْ أدْرَكَتني صَبْوَةٌ","خَلُصَتْ إلى داودَ المِحرَابِ",48,"ب",1,0],["وعذلك مثل غذر فاقصري،","ولوم القعود الفحل إحدى العجائب",49,"ب",1,0],["وعذب ذاب اللمى","مضناه كم عذبا",50,"ب",2,0],["وعذراء كالغصن الرطيب إذا انثنت","وكالشمس لاحت حين منتصف الطَّفل",51,"ل",1,0],["وعذابٌ لهم فيها مُقيمْ","أنتَ يا رب لمن تابَ رحيمْ",52,"م",1,0],["وعذتُ بمسعود أخي الجودِ والندَى","يُنِيلُ البرايَا والسنينُ مُحُولُ",53,"ل",1,0],["وعذاراهم عَدت بعد لُبس","الخز تختالُ في الثيابِ الحدادِ",54,"د",1,0],["وعذرُ الشمسِ لو حسدتكَ بادٍ","لأن سناكَ أشهرُ من سناها",55,"ا",3,0],["وَعَذراءَ لَمّا تَلِدها النِساءُ","وَلَكِنَّها مِن بَناتِ الفِكَر",56,"ر",1,0],["وعذل يهيج شدوى عذله","فبات يغرى وهو ليس يدري",57,"ر",2,0],["وعذرت جودك والوشات تصده","عني وبعد العذر مالي حجة",58,"ه",1,0],["وعذارٍ كأنَّما","مدَّ في الخَدِّ أرقَما",59,"م",2,0],["وعذرا أنْ تعثَّرَ خَطْوُ حَرْفي","فَهذا الشِّعْرُ مِنْ وَحْيِ اضْطِرابي",60,"ب",2,0],["وَعَذلتُ تَقصيري بِوَصفِكَ عاجِزاً","وَعلمتَهُ فَعَذَرتَني مُتفضِّلا",61,"ل",2,0],["وَعَذَرتُ نَفسي في هَواكِ لِأَنَّني","أَورَدتُها في الحُبِّ أَعذَبَ مَنهَلِ",62,"ل",1,0],["وعَذابُه عَذْبٌ ولكنْ لا تَفِى","لَذّاتُه بالنَّزْرِ من آفاته",63,"ت",2,0],["وَعُذرهمُ كالشَمسِ في تَركِهم له","وَمِن جَهلِهم باللَّه قَد عَبَدوا الدَهرا",64,"ر",2,0],["وعذراء زفتها المنونُ فلم تجدْ","سوى القبر من صه