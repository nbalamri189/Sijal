َّرحت إِخائي",144,"ي",1,0],["وعذار مجعد","فوق خد مورد",145,"د",1,1],["وَعَذول وَجدي في عذارك معتد","لمّا بَدا ألفا بِخَدِّك لاما",146,"م",2,0],["وَعَذولَ طولِ مَدائحي","إِعدِل إِذا وُلّيتَ حكما",147,"م",2,0],["وعذار في ذلك الخدّ أبدى","ببها الحسن جنّةً وحريرا",148,"ر",2,0],["وعذراً من الشكوى فذو الوجدِ والجوى","بما باح من أسراره لا يفندُ",149,"د",1,0],["وعذراً لتقصيرٍ فصدق محبتي","إذا صح يكفي في قبول المعاذر",150,"ر",1,0],["وعُذْراً لأهلِ العلم إن أظْهروا الأسَى","ولا عُذْرَ منهمْ للذي أظهرَ الجَلْدَا",151,"د",2,0],["وعُذراً لِمَنْ رام الجوابَ ففاتَهُ","فجاء بنظمٍ ضعفُه ما له حدُّ",152,"د",1,0],["وعذراء امسى الغصن يحسد قدها","هضيم الحشا حسانة المتجرد",153,"د",1,0],["وعذري إليه في سكوتيَ علتي","وما عذر قومي في سكوتهم عني",154,"ن",2,0],["وَعَذولٍ غَشَّني في عَذْلِهِ","وَاِدَّعى في لَوْمِهِ أَن نَصَحا",155,"ح",2,0],["وَعَذَّبَ القَلبَ إِبعاداً بِلا سَبَبٍ","وَقَد كَسا الجسمَ ثَوبَ السّقمِ وَالحَزَنِ",156,"ن",1,0],["وَعِذارٍ كَأَنَّهُ النّملُ لَكِن","بِضُحى وَجنَتَيكَ كَاللَّيلِ لاحا",157,"ح",2,0],["وَعَذَابِي بِطَوْلٍ مِنْهُ فِي سَا","بِقِ أَيَّامِي الطِّوَالِ الْعِراضِ",158,"ض",1,0],["وعَذُبَتْ أنهارُه وأدركتْ","ثِمارُه وأبدَتِ المَكْنونا",159,"ن",2,0],["وعذوبةٌ فيه تفو","قُ على أفاويق السحابْ",160,"ب",1,0],["وعذول جاء يؤلمني","بملام عنه ما عدلا",161,"ل",2,0],["وعذْب ثنايا كالأقاحي تَخالها","تعلُّ حُمياَ الكأس أو هيَ جَوهر",162,"ر",1,0],["وعذراً معيد العدل غضاً فإن لي","رواحل عجفاً عذر الدهر مسراها",163,"ا",3,0],["وَعَذَّبْتُمُوني بِالصُّدُودِ وَجُرْتُمُ","وَلَوْ ذُقْتُمُ مَا ذُقْتُهُ لَعَذَرْتُمُ",164,"م",1,0],["وعذراً فمهما أصلح العبد فرضه","تلقاه حرب شاغل من زمانه",165,"ن",2,0],["وعذارك اللام الذي","مذ لاح لاح وقام عذري",166,"ر",2,0],["وَعَذَّبَنِي بِهِ فَاعجبْ لِخَدّ","يُعَذّبُ فِي لظَاهُ بِالنَّعِيمِ",167,"م",1,0],["وَعَذَّبَ قَلْبِي دَلُّهَا بِنَعِيمِهِ","وَلَمْ أدْرِ أنِّي بِالنَّعِيمِ أعَذَّبُ",168,"ب",1,0],["وَعذُولٍ فِيكَ يَلْحَى","وَلَعَمْرِي مَا أجَنَّهْ",169,"ن",2,0],["وَعَذُوِلي فِيكَ مَا أطْمَعَهُ","قُلْتُ سِرْ بِاللَّهِ وَاكْفُفْ طَمَعَكْ",170,"ك",1,0]