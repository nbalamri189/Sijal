{"poems":[[53,"ستعلمون ما يكون مني","https://www.aldiwan.net/poem29652.html","الرجز"],[53,"عصينا فيك أحداث الليالي","https://www.aldiwan.net/poem29864.html","الوافر"],[53,"جرعتني غصصا ورحت مسلما","https://www.aldiwan.net/poem29966.html","الكامل"],[63,"الورد يبسم والركائب حوم","https://www.aldiwan.net/poem46212.html","الكامل"],[55,"خلوتم بأنواع السرور هناكم","https://www.aldiwan.net/poem26064.html","الطويل"],[55,"وصلت فلما لم أر الوصل نافعي","https://www.aldiwan.net/poem26185.html","الطويل"],[34,"نباكر أم تروح غدا رواحا","https://www.aldiwan.net/poem4878.html","الوافر"],[77,"سلا هل لديها من مخبرة ذكر","https://www.aldiwan.net/poem36463.html","الطويل"],[9,"أثوى وقصر ليلة ليزودا","https://www.aldiwan.net/poem21927.html","الكامل"],[71,"سامحت كتبك في القطيعة عالماً","https://www.aldiwan.net/poem3997.html","الكامل"],[83,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[83,"ذروني فإني بالعلاء خبير","https://www.aldiwan.net/poem54303.html","الطويل"],[47,"ألا من مبلغ سروات قومي","https://www.aldiwan.net/poem25151.html","الوافر"],[72,"عوض بكأسك ما أتلفت من نشب","https://www.aldiwan.net/poem18227.html","البسيط"],[72,"كم عذول على هواك أداجي","https://www.aldiwan.net/poem18451.html","الخفيف"],[72,"تفهمه قلبي الشجي فهاما","https://www.aldiwan.net/poem19682.html","الطويل"],[51,"ليهنك حق رده الله منعما","https://www.aldiwan.net/poem65062.html","الطويل"],[51,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[38,"ألم تدر ما قال الظباء السوانح","https://www.aldiwan.net/poem7696.html","الطويل"],[85,"ألا حبذا صحبة المكتب","https://www.aldiwan.net/poem62987.html","المتقارب"],[43,"أرق على أرق ومثلي يأرق","https://www.aldiwan.net/poem9735.html","الكامل"],[45,"إما ألم فبعد فرط تجنب","https://www.aldiwan.net/poem11055.html","الكامل"],[45,"قد كان طيفك مرة يغرى بي","https://www.aldiwan.net/poem11429.html","الكامل"],[45,"وراءك عني يا عذول الأشايب","https://www.aldiwan.net/poem11493.html","الطويل"],[61,"ألم ترني سطوت على الزمان","https://www.aldiwan.net/poem51412.html","الوافر"],[61,"عش مدى الدهر يا أبا إسحاق","https://www.aldiwan.net/poem51505.html","الخفيف"],[49,"سل القصر أودى أهله أين أهله","https://www.aldiwan.net/poem63097.html","الطويل"],[66,"صاحب السيف الصقيل المحلا","https://www.aldiwan.net/poem39637.html","المديد"],[97,"أمسيت أشكو الضيق والأينا","https://www.aldiwan.net/poem24793.html","أحذ الكامل"],[80,"أغمر الهوى كم ذا تقطعني عذلا","https://www.aldiwan.net/poem31329.html","الطويل"],[80,"أيا جزعي بالدار إذ عن لي الجزع","https://www.aldiwan.net/poem31387.html","الطويل"],[80,"ومن سفن القفر سباحة","https://www.aldiwan.net/poem31398.html","المتقارب"],[80,"هن الحسان وحربها الهجر","https://www.aldiwan.net/poem31452.html","أحذ الكامل"],[44,"أيها البرق بت بأعلى البراق","https://www.aldiwan.net/poem30394.html","الخفيف"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[69,"كبد معذبة وقلب خافق","https://www.aldiwan.net/poem28903.html","الكامل"],[31,"أصبح القلب مريضا","https://www.aldiwan.net/poem42471.html","مجزوء الرمل"],[81,"أقلد وجدي فليبرهن مفندي","https://www.aldiwan.net/poem61539.html","الطويل"],[52,"له مقلة ترمي القلوب ووجنة","https://www.aldiwan.net/poem27290.html","الطويل"],[48,"يا أَبا القاسِمِ قلبي","https://www.aldiwan.net/poem65252.html","مجزوء الرمل"],[50,"تجاللت عن فهر وعن جارتي فهر","https://www.aldiwan.net/poem63803.html","الطويل"],[46,"أسيت إذا غابت الأحجال والغرر","https://www.aldiwan.net/poem22533.html","البسيط"],[46,"يا أمة ما لها عقول","https://www.aldiwan.net/poem23578.html","مجزوء البسيط"],[1,"أشجاك الربع أم قدمه","https://www.aldiwan.net/poem34014.html","المديد"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85833","الرمل"],[90,"الشاعرية","https://www.poetsgate.com/ViewPoem.aspx?id=650",""],[45,"قَدْ كَانَ طَيْفُكِ مَرّةً يُغرَى بي","https://www.poetsgate.com/ViewPoem.aspx?id=31420",""],[45,"وراءك عني يا عذول الأشايب","https://www.poetsgate.com/ViewPoem.aspx?id=33108",""]],"verses":[["وَعُذ بِإِغضائِيَ وَاِستَعِذني","وَاِحذَر عِداءَ قاطِعٍ في ضِمني",0,"ي",1,0],["وَعُذتُ بِجانِبَيكَ مِنَ الرَزايا","مَعاذي في الهَواجِرِ بِالظِلالِ",1,"ل",1,0],["وَعَذَرتُهُ بَعدَ الإِباءِ لِأَنَّهُ","ظَنَّ الَّذي يُطرى كَأَنتَ فَخافا",2,"ف",2,0],["وعَذَرْتُ كُلَّ مُكاشِحٍ أُبْلَى بِهِ","فبَليَّتي مِمَّنْ أُصاحِبُ أعْظَمُ",3,"م",1,0],["وَعَذَّبتُموني بِالجَفاءِ وَإِنَّني","لَراضٍ بِما تَرضَون لي وَهُوَ الغَبَن",4,"ن",1,0],["وَعَذَّبتُ قَلبي بِالتَجَلُّدِ صادِياً","إِلَيكِ وَإِن لَم يَصفُ لي مِنكِ مَنهَلي",5,"ل",2,0],["وَعَذَّبَهُ الهَوى حَتّى بَراهُ","كَبَريِ القَينِ بِالسَفَنِ القِداحا",6,"ح",2,0],["وعُذْنا بذاك المجْدِ فانْصَرَم الرّدى","ولُذْنا بذاكَ العزْمِ فانهزَمَ الذّعْرُ",7,"ر",1,0],["وَعُذافِرٍ سَدَسٍ تَخالُ مَحالَهُ","بُرجاً تُشَيِّدُهُ النَبيطُ القَرمَدا",8,"د",2,0],["وَعَذَرتُ طَيفَكَ في الجَفاءِ لِأَنَّه","يَسري فَيُصبِحُ دونَنا بِمَراحِلِ",9,"ل",1,0],["وعذر من الإعذار قرر حكمه","من الشرع أخبارٌ رُفعن عواليا",10,"ي",2,0],["وعذراً فإني إن أطلْتُ فإِنما","قصارايَ من بعد البيان قصورُ",11,"ر",1,0],["وَعُذتُ بِصارِمٍ وَيَدٍ وَقَلبٍ","حَماني أَن أُلامَ وَأَن أُضاما",12,"م",2,0],["وعذْ من الخوفِ والبؤسِ بذي هممٍ","للمدحِ مجتلبٍ للذمِّ مجتنِب",13,"ب",1,0],["وعذارٌ أظنُّه وهو خافٍ","حولَ خدَّيك زئبرَ الدِّيباج",14,"ج",1,0],["وعذولٌ في الحبِّ يجمع للمغ","رم بين الطاعون والحجَّاج",14,"ج",1,0],["وعذَّبني ذاك المليح بنارِهِ","فكانَ عذاب القلب فيهِ غراما",15,"م",2,0],["وعذري من التقصير في القول أنني","حسيرُ سقام عضَّ جسمي فأوجعا",16,"ع",2,0],["وعُذتُ به من كل شيء أخافُه","فألفيتُه بعضَ الجبال العواصمِ",17,"م",1,0],["وَعَذبُ الكَرى يَشفي الصَدى بَعدَ هَجعَةٍ","لَهُ مِن عُروقِ المُستَظِلَّةِ مائِحُ",18,"ح",1,0],["وَعُذِّبَ بِالعِلمِ طُلّابُهُ","وَغَصّوا بِمَنهَلِهِ الأَعذَبِ",19,"ب",1,0],["وَعَذَلتُ أَهلَ العِشقِ حَتّى ذُقتُهُ","فَعَجِبتُ كَيفَ يَموتُ مَن لا يَعشَقُ",20,"ق",1,0],["وَعَذَرتُهُم وَعَرَفتُ ذَنبِيَ أَنَّني","عَيَّرتُهُم فَلَقيتُ فيهِ ما لَقوا",20,"ق",3,0],["وَعَذَرتُ سَيفي في نُبُوِّ غِرارِهِ","أَنّي ضَرَبتُ فَلَم أَقَع بِالمَضرَبِ",21,"ب",1,0],["وَعَذَلتَني أَن أَدرَكَتني صَبوَةٌ","خَلَصَت إِلى داوُدَ في المِحرابِ",22,"ب",1,0],["وَعَذلُكِ عِندي مِثلُ عُذرٍ فَأَقصِري","وَلَومُ القَعودِ الفَحلَ إِحدى العَجائِبِ",23,"ب",1,0],["وعُذنا من مَساجِدِهم بدَيْرٍ","وبالناقوسِ من صَوْتِ الأذانِ",24,"ن",1,0],["وعَذارَى كأنَّهُنَّ مِنَ الحُس","نِ عَذارَى سَفَرْنَ للعُشَّاقِ",25,"ق",1,0],["وَعَذلُ الفَتى ما فيهِ فَضلٌ لِغَيرِهِ","إِذا ما الفَتى عَن نَفسِهِ ضاقَ عَذلُهُ",26,"ل",2,0],["وَعُذولٍ باتَ لي","عَنهُ زاجِر",27,"ر",1,0],["وعذابها من وحشة طالت","وحنين مجهولٍ لمجهولِ",28,"ل",1,0],["وعذراءَ كانت وردةً قبل مزجها","ومن بعده عَنّتْ لِمُبصرها شعلا",29,"ل",2,0],["وعذراء يغشاها ذكورُ أسِنّةٍ","وتُثْنَى لِجَمعٍ كُلَّما افتَرقَ الجمعُ",30,"ع",1,0],["وَعَذْبُ الدموعِ دليلٌ على","بُكاءِ تبَسُّمِ بَرْقٍ وَمَض",31,"ض",1,0],["وعَذَرتُ مِنكِ الخصرَ مَرْحَمَةً","ولِحَملِ ردفِكِ يُعْذَرُ الخصرُ",32,"ر",1,0],["وَعِذابٌ لَو اِنَّها أُطعِمَت زا","دَت عَلى الشَهدِ بَسطَةً في المَذاقِ",33,"ق",1,0],["وَعَذَّبوا أَهلَ دِينِ اللَّهِ وَاِنتَهَكوا","مَحارِماً أَعقَبَتهُم لَهفَةَ النَّدَمِ",34,"م",1,0],["وعذولُ سوءٍ زادَ قلبي وجعةً","ما ضرَّهُ لو أنهُ بيَ رافقُ",35,"ق",1,0],["وَعِذابَ الطَعمِ غُرّا","كَأَقاحي الرَملِ بيضا",36,"ض",2,0],["وَعَذَّبَ بالي نَعَّمَ اللَهُ بالَهُ","وَسَهَّدَني لا ذاقَ بَلوى التَسَهُّدِ",37,"د",1,0],["وَعُذِّرَ خَدّاهُ بِخَطَّينِ قُوِّما","كَما أَثَّرَ التَسطيرُ في رَقِّ كاتِبِ",38,"ب",1,0],["وَعِذارٍ زانَهُ مِن","زَغَبِ الشَعرِ لِجامُ",39,"م",1,0],["وَعَذراءَ لا تَجري بِلَحمٍ وَلا دَمٍ","بَعيدَةِ شَكوى الأَينِ مُلحَمَةِ الدَبرِ",40,"ر",1,0],["وَعُذتُ بِاللَهِ مِن عامٍ أَخي سَنَةٍ","نُجومُهُ في دُخانٍ ثائِرٍ شَرَُر",41,"ر",1,0],["وَعُذِّرَت حاجَةٌ بِعُسرٍ","عَلى عَليلٍ قَدِ اِشتَهاها",42,"ا",3,0],["وَعَذاريكُم مُقَلِّصَةٌ","في ذَعاعِ النَخلِ تَجتَرِمُه",43,"م",2,0],["وعذاباً للذي قد","شرب الخمر عظيما",44,"م",2,0],["وعذرُك أنت آلام ثِقالٌ","لهنَّ بعيشةِ الأدباء لَصْقُ",45,"ق",1,0],["وَعَذَلتَني أنْ أدْرَكَتني صَبْوَةٌ","خَلُصَتْ إلى داودَ المِحرَابِ",46,"ب",1,0],["وعذلك مثل غذر فاقصري،","ولوم القعود الفحل إحدى العجائب",47,"ب",1,0]]}