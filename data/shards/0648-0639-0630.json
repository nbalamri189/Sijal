[403,"أيا وجد أبقيت حتى على صبري","https://www.aldiwan.net/poem46745.html","الطويل"],[404,"إليكم يا صفي الدين مني","https://www.aldiwan.net/poem33431.html","الوافر"],[404,"خلعت ردا التشبيب عن منكب الفكر","https://www.aldiwan.net/poem33905.html","الطويل"],[404,"أجزتك يابن ودي ما تريد","https://www.aldiwan.net/poem33944.html","الوافر"],[404,"أتاني فأحياني وحيا أحبتي","https://www.aldiwan.net/poem34105.html","الطويل"],[404,"مرحبا يا مرحبا يا مرحبا","https://www.aldiwan.net/poem34127.html","الرمل"],[410,"أبا البركات لي مولى جواد","https://www.aldiwan.net/poem32323.html","الوافر"],[417,"يا أيها الركب قفوا بي ساعة","https://www.aldiwan.net/poem53976.html","الرجز"],[417,"أعد اللهو فإن اللهو أحمد","https://www.aldiwan.net/poem54100.html","الرمل"],[417,"يا ليلة في آخر الشهر","https://www.aldiwan.net/poem54175.html","أحذ الكامل"],[433,"كم مقلة للشقيق الغض رمداء","https://www.aldiwan.net/poem12548.html","البسيط"],[440,"فديناك سيفا لم تخنه مضاربه","https://www.aldiwan.net/poem34912.html","الطويل"],[442,"أسير الهوى قل لي فما أنت صانع","https://www.aldiwan.net/poem14332.html","الطويل"],[449,"هل إلى برد الثنايا من سبيل","https://www.aldiwan.net/poem53767.html","الرمل"],[453,"لنا المشرب الأهنا من المورد الأصفى","https://www.aldiwan.net/poem13841.html","الطويل"],[459,"ألا صاحب كالسيف حلو شمائله","https://www.aldiwan.net/poem55994.html","الطويل"],[459,"سأل اللوى وسؤاله إلحاف","https://www.aldiwan.net/poem56110.html","الكامل"],[459,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[459,"أفاق بها من طول سكرته الدهر","https://www.aldiwan.net/poem56161.html","الطويل"],[459,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[459,"أنا اليوم مما تعهدين بعيد","https://www.aldiwan.net/poem56239.html","البسيط"],[459,"إذا لم يرع عندكم الوداد","https://www.aldiwan.net/poem56241.html","المتقارب"],[459,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[459,"دواعي الهوى لك أن لا تجيبا","https://www.aldiwan.net/poem56305.html","المتقارب"],[465,"عيون المهى قلبي بنبلك مجروح","https://www.aldiwan.net/poem3149.html","عموديه"],[465,"شف قلبي دلاله","https://www.aldiwan.net/poem3358.html","عموديه"],[465,"أشرب على ورد الخدود وغنني","https://www.aldiwan.net/poem3431.html","عموديه"],[469,"وعذول كان من قولي له","https://www.aldiwan.net/poem59638.html","الرمل"],[484,"هجرت أمامة هجراً طويلا","https://www.aldiwan.net/poem2071.html","المتقارب"],[496,"أيا دمع إن لم ينجد الصبر أنجد","https://www.aldiwan.net/poem9817.html","الطويل"],[501,"قل لغزلان بقيعان النقا","https://www.aldiwan.net/poem37937.html","الرمل"],[506,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[515,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[516,"صرف النسيب إلى اللوى وزرود","https://www.aldiwan.net/poem12082.html","الكامل"],[535,"أزف لك التحية والسلاما","https://www.aldiwan.net/poem23815.html","الوافر"],[552,"ليس في العشق جناح","https://www.aldiwan.net/poem47901.html","مجزوء الرمل"],[552,"ماذا يضيرك هند من حبي","https://www.aldiwan.net/poem48051.html","أحذ الكامل"],[568,"بليت ولج بي وجدي بظبي","https://www.aldiwan.net/poem69762.html","الوافر"],[576,"شفاك الله من دائك","https://www.aldiwan.net/poem2699.html","الهزج"],[576,"أيا دمع عيني لا تكن بعد إخواني","https://www.aldiwan.net/poem2776.html","الطويل"],[576,"الشام للإسلام دار القرار","https://www.aldiwan.net/poem3069.html","السريع"],[584,"كبيشة عرسي تمنى الطلاقا","https://www.aldiwan.net/poem443.html",""]],"verses":[["وعذت به في السبط من شر مُبغض","لتخطيئهِ في شق صفٍ تلوما",0,"م",2,0],["وَعُذ بِإِغضائِيَ وَاِستَعِذني","وَاِحذَر عِداءَ قاطِعٍ في ضِمني",1,"ن",2,0],["وَعُذتُ بِجانِبَيكَ مِنَ الرَزايا","مَعاذي في الهَواجِرِ بِالظِلالِ",2,"ل",1,0],["وَعَذَرتُهُ بَعدَ الإِباءِ لِأَنَّهُ","ظَنَّ الَّذي يُطرى كَأَنتَ فَخافا",3,"ف",2,0],["وعَذَرْتُ كُلَّ مُكاشِحٍ أُبْلَى بِهِ","فبَليَّتي مِمَّنْ أُصاحِبُ أعْظَمُ",4,"م",1,0],["وَعَذَّبتُموني بِالجَفاءِ وَإِنَّني","لَراضٍ بِما تَرضَون لي وَهُوَ الغَبَن",5,"ن",1,0],["وَعَذَّبتُ قَلبي بِالتَجَلُّدِ صادِياً","إِلَيكِ وَإِن لَم يَصفُ لي مِنكِ مَنهَلي",6,"ل",2,0],["وَعَذَّبَهُ الهَوى حَتّى بَراهُ","كَبَريِ القَينِ بِالسَفَنِ القِداحا",7,"ح",2,0],["وعُذْنا بذاك المجْدِ فانْصَرَم الرّدى","ولُذْنا بذاكَ العزْمِ فانهزَمَ الذّعْرُ",8,"ر",1,0],["وَعُذافِرٍ سَدَسٍ تَخالُ مَحالَهُ","بُرجاً تُشَيِّدُهُ النَبيطُ القَرمَدا",9,"د",2,0],["وَعَذَرتُ طَيفَكَ في الجَفاءِ لِأَنَّه","يَسري فَيُصبِحُ دونَنا بِمَراحِلِ",10,"ل",1,0],["وعذر من الإعذار قرر حكمه","من الشرع أخبارٌ رُفعن عواليا",11,"ي",2,0],["وعذراً فإني إن أطلْتُ فإِنما","قصارايَ من بعد البيان قصورُ",12,"ر",1,0],["وَعُذتُ بِصارِمٍ وَيَدٍ وَقَلبٍ","حَماني أَن أُلامَ وَأَن أُضاما",13,"م",2,0],["وعذْ من الخوفِ والبؤسِ بذي هممٍ","للمدحِ مجتلبٍ للذمِّ مجتنِب",14,"ب",1,0],["وعذارٌ أظنُّه وهو خافٍ","حولَ خدَّيك زئبرَ الدِّيباج",15,"ج",1,0],["وعذولٌ في الحبِّ يجمع للمغ","رم بين الطاعون والحجَّاج",15,"ج",1,0],["وعذَّبني ذاك المليح بنارِهِ","فكانَ عذاب القلب فيهِ غراما",16,"م",2,0],["وعذري من التقصير في القول أنني","حسيرُ سقام عضَّ جسمي فأوجعا",17,"ع",2,0],["وعُذتُ به من كل شيء أخافُه","فألفيتُه بعضَ الجبال العواصمِ",18,"م",1,0],["وَعَذبُ الكَرى يَشفي الصَدى بَعدَ هَجعَةٍ","لَهُ مِن عُروقِ المُستَظِلَّةِ مائِحُ",19,"ح",1,0],["وَعُذِّبَ بِالعِلمِ طُلّابُهُ","وَغَصّوا بِمَنهَلِهِ الأَعذَبِ",20,"ب",1,0],["وَعَذَلتُ أَهلَ العِشقِ حَتّى ذُقتُهُ","فَعَجِبتُ كَيفَ يَموتُ مَن لا يَعشَقُ",21,"ق",1,0],["وَعَذَرتُهُم وَعَرَفتُ ذَنبِيَ أَنَّني","عَيَّرتُهُم فَلَقيتُ فيهِ ما لَقوا",21,"ق",3,0],["وَعَذَرتُ سَيفي في نُبُوِّ غِرارِهِ","أَنّي ضَرَبتُ فَلَم أَقَع بِالمَضرَبِ",22,"ب",1,0],["وَعَذَلتَني أَن أَدرَكَتني صَبوَةٌ","خَلَصَت إِلى داوُدَ في المِحرابِ",23,"ب",1,0],["وَعَذلُكِ عِندي مِثلُ عُذرٍ فَأَقصِري","وَلَومُ القَعودِ الفَحلَ إِحدى العَجائِبِ",24,"ب",1,0],["وعُذنا من مَساجِدِهم بدَيْرٍ","وبالناقوسِ من صَوْتِ الأذانِ",25,"ن",1,0],["وعَذارَى كأنَّهُنَّ مِنَ الحُس","نِ عَذارَى سَفَرْنَ للعُشَّاقِ",26,"ق",1,0],["وَعَذلُ الفَتى ما فيهِ فَضلٌ لِغَيرِهِ","إِذا ما الفَتى عَن نَفسِهِ ضاقَ عَذلُهُ",27,"ل",2,0],["وَعُذولٍ باتَ لي","عَنهُ زاجِر",28,"ر",1,0],["وعذابها من وحشة طالت","وحنين مجهولٍ لمجهولِ",29,"ل",1,0],["وعذراءَ كانت وردةً قبل مزجها","ومن بعده عَنّتْ لِمُبصرها شعلا",30,"ل",2,0],["وعذراء يغشاها ذكورُ أسِنّةٍ","وتُثْنَى لِجَمعٍ كُلَّما افتَرقَ الجمعُ",31,"ع",1,0],["وَعَذْبُ الدموعِ دليلٌ على","بُكاءِ تبَسُّمِ بَرْقٍ وَمَض",32,"ض",1,0],["وعَذَرتُ مِنكِ الخصرَ مَرْحَمَةً","ولِحَملِ ردفِكِ يُعْذَرُ الخصرُ",33,"ر",1,0],["وَعِذابٌ لَو اِنَّها أُطعِمَت زا","دَت عَلى الشَهدِ بَسطَةً في المَذاقِ",34,"ق",1,0],["وَعَذَّبوا أَهلَ دِينِ اللَّهِ وَاِنتَهَكوا","مَحارِماً أَعقَبَتهُم لَهفَةَ النَّدَمِ",35,"م",1,0],["وعذولُ سوءٍ زادَ قلبي وجعةً","ما ضرَّهُ لو أنهُ بيَ رافقُ",36,"ق",1,0],["وَعِذابَ الطَعمِ غُرّا","كَأَقاحي الرَملِ بيضا",37,"ض",2,0],["وَعَذَّبَ بالي نَعَّمَ اللَهُ بالَهُ","وَسَهَّدَني لا ذاقَ بَلوى التَسَهُّدِ",38,"د",1,0],["وَعُذِّرَ خَدّاهُ بِخَطَّينِ قُوِّما","كَما أَثَّرَ التَسطيرُ في رَقِّ كاتِبِ",39,"ب",1,0],["وَعِذارٍ زانَهُ مِن","زَغَبِ الشَعرِ لِجامُ",40,"م",1,0],["وَعَذراءَ لا تَجري بِلَحمٍ وَلا دَمٍ","بَعيدَةِ شَكوى الأَينِ مُلحَمَةِ الدَبرِ",41,"ر",1,0],["وَعُذتُ بِاللَهِ مِن عامٍ أَخي سَنَةٍ","نُجومُهُ في دُخانٍ ثائِرٍ شَرَُر",42,"ر",1,0],["وَعُذِّرَت حاجَةٌ بِعُسرٍ","عَلى عَليلٍ قَدِ اِشتَهاها",43,"ا",3,0],["وَعَذاريكُم مُقَلِّصَةٌ","في ذَعاعِ النَخلِ تَجتَرِمُه",44,"م",2,0],["وعذاباً للذي قد","شرب الخمر عظيما",45,"م",2,0],["وعذرُك أنت آلام ثِقالٌ","لهنَّ بعيشةِ الأدباء لَصْقُ",46,"ق",1,0],["وَعَذَلتَني أنْ أدْرَكَتني صَبْوَةٌ","خَلُصَتْ إلى داودَ المِحرَابِ",47,"ب",1,0],["وعذلك مثل غذر فاقصري،","ولوم القعود الفحل إحدى العجائب",48,"ب",1,0],["وعذب ذاب اللمى","مضناه كم عذبا",49,"ب",2,0],["وعذراء كالغصن الرطيب إذا انثنت","وكالشمس لاحت حين منتصف الطَّفل",50,"ل",1,0],["وعذابٌ لهم فيها مُقيمْ","أنتَ يا رب لمن تابَ رحيمْ",51,"م",1,0],["وعذتُ بمسعود أخي الجودِ والندَى","يُنِيلُ البرايَا والسنينُ مُحُولُ",52,"ل",1,0],["وعذاراهم عَدت بعد لُبس","الخز تختالُ في الثيابِ الحدادِ",53,"د",1,0],["وعذرُ الشمسِ لو حسدتكَ بادٍ","لأن سناكَ أشهرُ من سناها",54,"ا",3,0],["وَعَذراءَ لَمّا تَلِدها النِساءُ","وَلَكِنَّها مِن بَناتِ الفِكَر",55,"ر",1,0],["وعذل يهيج شدوى عذله","فبات يغرى وهو ليس يدري",56,"ر",2,0],["وعذرت جودك والوشات تصده","عني وبعد العذر مالي حجة",57,"ه",1,0],["وعذارٍ كأنَّما","مدَّ في الخَدِّ أرقَما",58,"م",2,0],["وعذرا أنْ تعثَّرَ خَطْوُ حَرْفي","فَهذا الشِّعْرُ مِنْ وَحْيِ اضْطِرابي",59,"ب",2,0],["وَعَذلتُ تَقصيري بِوَصفِكَ عاجِزاً","وَعلمتَهُ فَعَذَرتَني مُتفضِّلا",60,"ل",2,0],["وَعَذَرتُ نَفسي في هَواكِ لِأَنَّني","أَورَدتُها في الحُبِّ أَعذَبَ مَنهَلِ",61,"ل",1,0],["وعَذابُه عَذْبٌ ولكنْ لا تَفِى","لَذّاتُه بالنَّزْرِ من آفاته",62,"ت",2,0],["وَعُذرهمُ كالشَمسِ في تَركِهم له","وَمِن جَهلِهم باللَّه قَد عَبَدوا الدَهرا",63,"ر",2,0],["وعذراء زفتها المنونُ فلم تجدْ","سوى القبر من صهرٍ أعفَ وأكرما",64,"م",2,0],["وعذب المقبَّل والمبتسمْ","لذيذ المراشف والملتَثَمْ",65,"م",1,1],["وعذري في شكواي والله واضح","ولكن حالي اليوم اوضح من عذري",66,"ر",2,0],["وعذّلي فيه ولوا","مذ عاينوا الصدغ كالحا",67,"ح",2,0],["وَعَذابٍ قد فاحَ منهُ بَخورٌ","خالِدٌ في مَجابِرِ الأَحلامِ",68,"م",1,0],["وَعَذارى الفَضاءِ ماذا أَسَرَّت","لَكَ لَمّا أَضَفتَها في الفَضاءِ",69,"ا",2,0],["وعذبة الألفاظ معشوقةٍ","ساحرِة الأَوتار والشِعْر",70,"ر",1,0],["وَعَذبَةُ الريقِ أَودى بي تَأَوُّدُها","وَجداً وَساعَدَها خالٌ وَخلخالُ",71,"ل",1,0],["وَعَذارى القَريضِ بَعدَ كَسادٍ","عُدنَ مِنهُنَّ غالِياتِ المُهورِ",72,"ر",1,0],["وَعُذْرِي حَيْثُ لَيْسَ لِي اعْتِذَارٌ","دُخُولِي مِنْ رِضَاكَ عَلَيَّ بَابَا",73,"ب",2,0],["وَعَذُولِي عَذْلُهُ ضَائِعٌ","مِثْلَ مَا ضَاعَ سِرَاجُ الصَّباحْ",74,"ح",1,0],["وعذارٍ ما زال يُخلعُ في الحُ","بِّ عليه من كل صَبٍ عِذَارُه",75,"ر",2,0],["وعذرتُ خلّاً قد سقاني خَلَّهُ","وأرادَ حينَ الضعفِ أن نتآخى",76,"خ",2,0],["وَعذول لامى في الحب لَو","ذاق كاس الحب مثلي عذرا",77,"ر",2,0],["وَعَذاب تَرتَضون به","في فمي أَحلى من النعم",78,"م",1,0],["وَعِذَاراً إِذَا أَلَمَّ بِخَدٍّ","دَبَّ فيهِ كَما تَدِبُّ العَقَارِبْ",79,"ب",1,0],["وَعَذَرْتَ فِي أَنْ لا أُطِيقَ تَجَلُّداً","وَعَجِبْتَ مِنْ أَنْ لا أَذُوبَ تَحَرُّقا",80,"ق",2,0],["وَعَذولٍ رامَ نُصحي في الهَوى","كلَّما خاطَبَني قُلتُ سَلاما",81,"م",2,0],["وعَذولاً يُظهرُ النُصحَ بهم","فإِذا نَهنَهتُهُ زاد لجاجا",82,"ج",2,0],["وَعُذرُهُ كانَ إِن قَد فاتَ فِكرَتُهُ","أَمرُ السُؤالِ وَنِعمَ العُذرُ بِالهاءِ",83,"ا",2,0],["وعذارى فينوس يرقصن حولي","ويمجّدن فنّىَ الأبديّا",84,"ي",2,0],["وَعَذارٍ ثَنى عَذا","ري خَليعاً جَديدُهُ",85,"د",2,1],["وَعُذتُ بِكَهفِ الجِنِّ مِنهُم فَصارَ لي","مُجِيّا فَلا عَقلي يُحَسُّ وَلا حِسّي",86,"س",2,0],["وَعَذبُ لَمى فيهِ لِما فيهِ شَفَّني","شِفاً وَلِبالي مِن صَدى صَدِّهِ وَبلُ",87,"ل",1,0],["وَعُذ بِها مِن غَفلَةٍ عَن أَمرِها","في سَترِها تُعقِبُ في الكَشفِ الخَجَل",88,"ل",1,0],["وَعذرى واضِح فيها لاني","لَدى الفُضَلاء ذوباع قَصير",89,"ر",1,0],["وَعَذولِهِ وَكَفاهُ هَمُّ عَذولِهِ","وَالمَوتُ مِنهُ وَمِن تَفَلسُفِ رائِهِ",90,"ا",3,0],["وَعَذولٍ هَبِلَتهُ أُمُّهُ","لَم يَقُل قَولاً فَلا يَعلُ هُبَل",91,"ل",1,0],["وَعَذابُ الغَرامِ أَعذَبُ في خا","طِرِ حُبّي مِن راحَةِ السُلوانِ",92,"ن",1,0],["وَعُذرُ غَدرِهِ في مِسمَعي","كَما طَنَّ في لَوحِ الهَجيرِ ذُبابُ",93,"ب",1,0],["وَعَذول قلَّ أَن يَحتَشِما","لَم يَنَل مِن عَذلِهِ إِلّا التَعَب",94,"ب",1,0],["وَعَذولي لا يَملّ الفَندا","كُلّ مَن لامَ مُحِباً أَثما",94,"م",2,0],["وَعَذابي ماء النَعيم الَّذي را","قَ عَلى جَمر وَجنَتَيهِ النَديِّ",95,"ي",1,0],["وعذاب الله لا انجي لنا","منه من ذكر المهيمن ذي الجلال",96,"ل",1,0],["وعُذراً فقد قابلتُ درّكَ بالحصَى","وساجلتُ بحراً زاخراً بثمادِ",97,"د",1,0],["وعذرك في ترك الملامةِ واضحٌ","وما ليَ في تركِ الصبَّابة مِن عُذرِ",98,"ر",1,0],["وعذرك ألف مقبول وعندي","بأنك في اعتذارك لا تلام",99,"م",1,0],["وعذراً إذا كان الجواب كما ترى","وإني بالحصباء أكافي عن الدُّرِّ",100,"ر",1,0],["وعذراً في الذي مني تراه","فليس كما تريد ولا أريد",101,"د",1,0],["وعذرك مقبول وحاشاك لم تكن","تعاملني ما عشت يوماً بجفوة",102,"ه",1,0],["وعذولاً يعذل الصب إذا","صار من نار الهوى ملتهباً",103,"ب",2,0],["وعذرُكَ في قضا شُغلِي قضاءٌ","يُصرِّفُهُ فَما عُذْرُ الجَوابِ",104,"ب",1,0],["وعُذْتُ بالرَّحم وهي عَوْذَةٌ","أخزَتْ به شيطانها اللَّعينا",105,"ن",2,0],["وعذارٍ مذ بدا أرَّخته","لاحَ كالمسك عذار لمحمَّد",106,"د",1,0],["وعذرتها وعذلت عاذلها","والعذل بيَّنَ بَيِّنَ العذر",107,"ر",1,0],["وعُذ بمُعجزِ آيات المُدامة من","نوافثِ السحر في أجفانِ حَوراء",108,"ا",2,0],["وَعَذْرَاءَ لَمْ يأَتِ الزمانُ بِكُفْئِهَا","ولا رامها بَعْلٌ وإِنْ عَزَّ جانِبُهْ",109,"ب",2,0],["وعذراء إن صدت فليس تبدلت","علي وإن زارت فليس تمانع",110,"ع",1,0],["وعذولي لجّ في عذلي اذ","لم ير الخال على الخد الاسيل",111,"ل",1,0],["وعذراً لما سطرت عذر مقصّر","ولولاكم ما ازدان نظماً ولا رَصفا",112,"ف",2,0],["وعذراءَ من سرّ الفصاحة بيتُها","طويل العمادِ متعِبٌ من يطاولُهْ",113,"ل",2,0],["وعذرتُ في فَرط العقوق أرقَّةً","لؤماءَ حتى عقّني الأشرافُ",114,"ف",1,0],["وعذراء سقتُ لكم بُضعَها","ولولا رجاؤك لم تُبضعِ",115,"ع",1,0],["وعذراءَ بكراً من عوارفِ ربّها","حُبيت بها ما كلّ عارفةٍ بِكرُ",116,"ر",1,0],["وعَذارَى من القوافي تعوّض","تُ بهنّ التعليلَ والتعذيرا",117,"ر",2,0],["وعذراء مما استنجبَ الفكرُ وارتضَى","معقَّلة في الخِدرِ وهي شرودُ",118,"د",1,0],["وعذلٌ فيك أوجعَ نازلٌ بي","أنا الملسوعُ والعذلُ العِدادُ",119,"د",1,0],["وعّذراءَ عندي من نداهُ وثيِّبٍ","إذا جُلِيَتْ زانَ العُقودَ تَريبُها",120,"ب",3,0],["وعذراءَ تُذْكِر نُعماك بي","وإن كنتُ لستُ بها مستريبا",121,"ب",2,0],["وعذرٌ لمن يخشاك كبشُ كتيبة","يعود كسيراً قرنهُ وهو منطوح",122,"ح",1,0],["وعذولي فيهِ وأضي","عُ شيء مقالهُ",123,"ل",2,0],["وعذلتي لمّاً ظننت فراقهم","هيناً وما خطبُ الفراق بهيّنِ",124,"ن",1,0],["وَعَذولٍ كانَ مِن قَولي لَهُ","لَستُ أَستَحسِنُ أَجفو الحَسَنا",125,"ن",2,1],["وَعِذرَتُها أَنَّ كُلَّ اِمرِئٍ","مُعِدٌّ لَهُ كُلَّ يَومٍ شُكولا",126,"ل",2,0],["وعذري عند اللّه فيك ممهد","وإن كان عند الناس غير ممهد",127,"د",1,0],["وعَذولي لم يزلْ يَروي بِكُمْ","كَذِباً يا ليتَ يوماً صَدَقَا",128,"ق",2,0],["وعذتُ بخالقي لمّا","تجلّى البعدُ خُسْرانا",129,"ن",2,0],["وعذَلْتُموني إذ خلَعْتُ بحُبِّكُم","عُذري فعُذري عندَكُم لا يُسمَعُ",130,"ع",1,0],["وعذرت من حسد الرجال على العلى","لما ظفرت بلذة المحسود",131,"د",1,0],["وعذرا إن أطلت القول إني","أردت الاختصار فما استقاما",132,"م",2,0],["وعذابٌ إنْ نأى عن","هُ وصالٌ وسماحُ",133,"ح",1,0],["وَعذلتِ منّي من له أُذُنٌ","صمّاءُ عن عَذْلٍ وعن عَتْبِ",134,"ب",1,0],["وعذَّبَني قَضيبٌ في كَثيبٍ","تَشَارَكَ فيه لِينٌ واندِمَاجُ",135,"ج",1,0],["وعُذْرِي إِنْ يَكُنْ ذَنْباً","فَقَابِلْهُ بإِغْضَائِك",136,"ك",1,0],["وعذرُ فؤادِي لا كعُذْرِك واضحٌ","فأَنت طليقٌ والفؤادُ هو العَانِي",137,"ن",2,0],["وعذرُهم إِذْ هربُوا واضِحٌ","هل يثبتُ اللَّيلُ أَمَام النَّهارْ",138,"ر",1,0],["وَعذبَ المَذاقَةِ كالأُقحوانِ","جادَ عليهِ الرَبيعُ البِراقا",139,"ق",2,0]]}