833",""],[5449,"عن القصيدة الفاضلة","https://www.poetsgate.com/ViewPoem.aspx?id=188871",""],[5458,"دلال الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=72159",""],[5596,"وادي محرم","https://www.poetsgate.com/ViewPoem.aspx?id=206487",""],[5605,"رحلة عابر","https://www.poetsgate.com/ViewPoem.aspx?id=159458",""],[1547,"صدّ الحبيب، وذاك دون فراقهِ","https://www.poetsgate.com/ViewPoem.aspx?id=16804",""],[5651,"ألِفارطِ العيشِ الرّطيبِ معيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=107007",""],[5883,"اسامة","https://www.poetsgate.com/ViewPoem.aspx?id=17912",""],[5929,"وتكاد تمطرنا السماء...","https://www.poetsgate.com/ViewPoem.aspx?id=202655",""],[5956,"لمن تثور العاصفة","https://www.poetsgate.com/ViewPoem.aspx?id=181909",""],[5956,"لِمَ تقطعين الغاب؟","https://www.poetsgate.com/ViewPoem.aspx?id=182417",""],[6031,"حَتَّامَ أمطلُ سيِّدي شكرَ اليدِ","https://www.poetsgate.com/ViewPoem.aspx?id=46263",""],[6031,"جَذَّ الردَى سَبَبَ الإسلامِ فَانْجذَمَا","https://www.poetsgate.com/ViewPoem.aspx?id=46278",""],[6093,"أصورَ الجَرْحَ في القرطاسْ ( اللاحق )","https://www.poetsgate.com/ViewPoem.aspx?id=183886",""],[6097,"طيفٌ غابرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=191557",""],[6320,"أَجْرَاسُ السَّفَر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84361&r=&rc=58",""]],"verses":[["كَالغَيثِ يَخلُفُهُ الرَبيعُ وَبَعضُهُم","كَالنارِ يَخلُفُها الرَمادُ المُظلِمُ",0,"م",1,0],["كَالغَيثِ ضَوءٌ بارِقٌ","مِنهُ وَرَيٌّ وابِلُ",1,"ل",1,0],["كَالغُصنِ مَهزوزاً وَلَكِنَّهُ","يَفعَلُ فِعلَ الخَطِلِ المائِدِ",2,"د",1,0],["كَالغَيثِ ما اِستَمطَروهُ جادَ وابِلُهُ","وَعِندَ ذِمَّتِهِ المُستَأسِدُ الضاري",3,"ر",2,0],["كَالغُصنِ بَينا تَراهُ ناعِماً هَدِباً","إِذ هاجَ وَاِنحَتَّ عَن أَفنانِهِ الوَرَقُ",4,"ق",1,0],["كَالغانِياتِ تَقَنَّعَت","خَوفَ المُريبِ المُجتَري",5,"ر",2,0],["كالغصن يستحلى سنا أزهاره","ويجود بالثمر الجنيّ وينتشق",6,"ق",1,0],["كالغيث في الجود والتبرع وال","إطباق لكنَّ صَوبَهُ ذهَبُهْ",7,"ب",2,0],["كالغيث يصبح مغموراً بنائله","أفاضلُ القوم والأنعام والشجر",8,"ر",1,0],["كَالغُصنِ قامَتُها إِذا الغُصنُ اِنثَنى","وَجَبينُها يَحكي الصَباحَ إِذا اِنجَلى",9,"ا",1,0],["كَالغَيثِ يَسقي الخابِطينَ بِأَبيَضِ","مِن غَيمِهِ وَبِأَحمَرٍ وَبِأَسوَدِ",10,"د",1,0],["كَالغَيثِ ما عَينَهُ بِبالِغَةٍ","بَعضَ الَّذي راحَ بالِغاً أَثَرُه",11,"ر",2,0],["كَالغَوادي أَظهَرنَ كُلَّ جَنِيٍّ","مُستَسِرٍّ في زاهِراتِ الرِياضِ",12,"ض",1,0],["كَالغَيثِ مايَنفَكُّ يَعتَقِدو الثَرى","خَلفٌ لِمُعظَمِ مُزنِهِ وَتُجاهُ",13,"ا",2,0],["كالغَيثِ يُحيي إن هَمى والسيلُ يُر","دي إن طمَى والدهرُ يُصمي إنَ رمَى",14,"م",2,0],["كالغيثِ يَبسِمُ للرُّوَّادِ بارِقُه","وربّما عادَ في الأعداءِ أُلهُوبا",15,"ب",2,0],["كالغيثِ يلقَى الطالبين بوابلٍ","سحٍّ ويلقى الحاسدين بحاصبِ",16,"ب",1,0],["كَالغَيثِ يولي الناسَ جَوداً بَعدَما","بَهَرَ العُقولَ بِبَرقِهِ وَبِرَعدِهِ",17,"د",2,0],["كَالغَيثِ فيهِ لِلطُغاةِ زَلازِلٌ","وَلِمَن يُؤَمِّلُهُ الزُلالُ البارِدُ",18,"د",1,0],["كَالغَيثِ يَبعَثُ مِن عَطاهُ وابِلاً","سَبطاً وَيُرسِلُ مِن سَطاهُ حاصِبا",19,"ب",2,0],["كَالغَيثِ لَيسَ لَهُ أُريدَ غَمامُهُ","أَو لَم يُرَد بُدٌّ مِنَ التَهطالِ",20,"ل",1,0],["كَالغَيثِ إِن جِئتَهُ وافاكَ رَيِّقُهُ","وَإِن تَحَمَّلتَ عَنهُ كانَ في الطَلَبِ",21,"ب",1,0],["كَالغَيثِ لَكِنَّهُ رَيٌّ بِلا شَرَقٍ","وَالغَيثُ قَد يُشرِقُ الوُرّادَ مَشرَعُهُ",22,"ع",2,0],["كَالغَيثِ في البَلَدِ المُحيلِ أَتى عَلى","حُسنِ الدُعاءِ وَسارَ عَن حُسنِ الثَنا",23,"ن",2,0],["كَالغُصنِ في حَرَكاتِهِ وَقَوامِهِ","كَالظَبيِ في لَحَظاتِهِ وَنِفارِهِ",24,"ر",2,0],["كَالغُصنِ أَعلاهُ وَرا","بٍ ما تُوارى النُقُبُ",25,"ب",1,0],["كَالغُصنِ هَبَّت لَهُ رِيحٌ بِرابِيَةٍ","مِنَ العَماءِ أَتَت مِن وَجهةِ اليَمَنِ",26,"ن",1,0],["كَالغولِ غالَتكَ بِتَلوينِها","بَينَ تَقَدّيها وَتَبنيسِها",27,"س",3,0],["كالغُصْنِ قدّاً والصّباحِ صباحَة","واللّيْلِ فَرعاً منهُ حاذى الحاذا",28,"ذ",2,0],["كالغيث يلمعُ في الآفاق بارقُهُ","وفي الثَّرَى مِنه زهرٌ فوق أفنانِ",29,"ن",1,0],["كَالْغَيْثِ إِنْ وَهَبُوا وَاللَّيْثِ إِنْ وَثَبُوا","وَالْمَاءِ إِنْ عَدَلُوا وَالنَّارِ إِنْ قَسَطُوا",30,"ط",3,0],["كالغُصْنِ قدّاً، والصّباحِ صَباحَة","ً، والَّليلِ فرعاً منهُ حاذا الحاذا",31,"ذ",2,0],["كالْغَيْثِ ما يَنْفَكُّ يَعْتَقِدُ الثَّرَى","خَلْفٌ لمُعْظَمِ مُزْنِهِ وتُجَاهُ",32,"ا",2,0],["كالغَيثِ مُنَكِباً على إخْوَانِهِº","كَالنّارِ مُلْتَهِباً عَلى أعْدائِهِ",33,"ا",3,0],["كالغواني ، لكلّ عذراء لون","من جمال ونفحة وافتتان",34,"ن",1,0],["كالغصن لينا والنسيم لطافة","ولحاظه كلواحظ الغزلان",35,"ن",1,0],["كَالغَمامِ الرُكامِ يَمضي وَيُبقي","مَورِداً فائِضاً وَمَرعىً خَصيبا",36,"ب",2,0],["كَالغَمامِ الرُكامِ خَصَّ بِلاداً","بِغُيوثٍ فَعَمَّ أُخرى سُيولا",37,"ل",2,0],["كَالغُصنِ في لُبنان قَد عَصَفَت بِهِ","رِيحُ المَنونِ فَخرَّ وَهوَ هَشيمُ",38,"م",1,0],["كَالغُصنِ جَفَّ سَريعاً ماءَ نَضرتِهِ","فَباتَ يَسقيهِ ماءُ الدَمعِ إِذ ذَرَفا",39,"ف",2,0],["كالغيثِ من بعد مَحْلٍ كالوصال على ال","مهجور كالأمن من خوفٍ بإنذار",40,"ر",1,0],["كالغُصنِ هُزَّ على كثيبٍ أَهْيَلٍ","كالصبحِ أُطْلِعَ تحت ليلٍ دامس",41,"س",1,0],["كالغيث تلقاه اذا ما سخى","وان سطا كالاسد بالباسل",42,"ل",1,0],["كالغصن لا تنفك جاعلة","أعطافها لإرادتي طوعا",43,"ع",2,0],["كَالغُصنِ أَعداني النُحُو","لُ بِخَصرِهِ الواهي النَحيلِ",44,"ل",1,0],["كالغيث لا تجدب أرض بها","حلّ وإن حال فلا تخصب",45,"ب",1,0],["كالغَيْثِ كَفّاً إن حَبا كالليثِ قَلْ","باً إِن حَمَى كالبدْرِ وَجْهاً إن بَدا",46,"د",2,0],["كالغَيْث صَبّ على البَسيطة صَوْبَه","فَسَقى عَمائِرَها وجَاد قَواءَها",47,"ا",3,0],["كَالْغَيْثِ أَقْلَعَ مَحْمُوداً وَخَلَّفَ ما","يُرْضِيكَ مِنْ زَهَرٍ غَضٍّ وَنُوّارِ",48,"ر",1,0],["كَالْغَيْثِ جادَ فَعَمَّ أَرْضَ شَرِيفِهِ","وَدَنِيِّهِ وَصَرِيحِهِ وَهَجِينِهِ",49,"ن",2,0],["كالغيثِ لكنْ ذاك من أمواهِه","يُروَى الخليفةُ وهْو من أمواله",50,"ل",2,1],["كالغِمدِ رُدَّ على حُسامٍ صارمٍ","ما زال مَتْنُ العِرْضِ منه صقيلا",51,"ل",2,0],["كالغُصْنِ لكنْ حُسْنُه في ذَاته","والغُصنُ زانتْ قدَّهُ الأوراقُ",52,"ق",1,0],["كالغصن إلا أنها","لا تثمر الأغصان بدرا",53,"ر",2,0],["كالغَيث في إِسجامه وَاللَيث في","إِقدامه وَالسَيف في إِخذامِهِ",54,"م",2,0],["كالغَيث إِن جادَت يَداهُ بديمَةٍ","أَغنى بِها المَعروف وَالمَجهولا",55,"ل",2,0],["كالغصن قدًّا والبنفسج","عارِضاً والوردِ خدَّا",56,"د",2,0],["كالغيثِ لكنْ حَيا هذا لُهًى أبدا","فمِنْ هنا هوَ حقّاً فارقَ المَطَرا",57,"ر",2,0],["كالغُصنِ بل يُخجِلُه إذا مشى","كالشمسِ بل أربى على شمسِ الضُحى",58,"ا",1,0],["كالغيثِ فوق البرّ ثَرّانٌ هَمى","منه ووسْطَ البحرِ دُرٌّ أزهرُ",59,"ر",1,0],["كالغيثِ في إروائه ورَوائِه","والليثِ في وثَباتِه وثَباته",60,"ت",2,0],["كالغمام الركام يمضي ويبقي","مورداً صافيا على الوراد",61,"د",1,0],["كالغيث في أيّ مكانٍ حلّه","يرجى ويخشى منه ريّ وغرَق",62,"ق",1,0],["كالغيث إلا أن ذلك هاطل","زمنا وذا في الجود أضحى مسرفا",63,"ف",2,0],["كالغَيْثِ يَنْأَى وَمَا يَخْفى لَهُ أَثَرٌ","والمِسكُ يُوعى وَمَا يُوعى لَهُ فَنَعُ",64,"ع",1,0],["كالغَيْثِ والدُه الغَمامُ فنافِعٌ","بَرٌّ ومولودٌ أبَرُّ وأنْفَعُ",65,"ع",1,0],["كالغَيْثِ للحُرِّ وأسْباخِهِ","ساقٍ إذا ما ظَمِئَتْ ماطِرُ",66,"ر",1,0],["كالغصن لولا أن يقال له ذوا","والبدر لولا أن يقال له خبا",67,"ب",2,0],["كالغيث فوقَ منابرٍ وأسرةٍ","والليث بين أسنّةٍ ومذاكي",68,"ك",2,0],["كالغمام الوكّاف يتبع ظلّي","ظلهُ حيثُ كنتُ من كلّ ربع",69,"ع",1,0],["كالغصن في ورق الغلائل مائساً","والبدر أسفر في نجوم شفوفه",70,"ف",2,0],["كالغِمْدِ فارق نَصْلَه في معركٍ","والسِّلْكُ مُلْقىً ليس فيه نِظامُ",71,"م",1,0],["كالغصن ماس به طوراً نسيم صباً","وقام طوراً به والغصن مياس",72,"س",1,0],["كالغُصنِ قد مالَ نحوَ الأرضِ منخفِضاً","لِثْقلِ حَمْلٍ نَما في عُودِهِ الرَّطِبِ",73,"ب",1,0],["كَالْغُصْنِ فِي رَوْضَةٍ تَمِيْسُ","تَصْبُو إِلَى حُسْنِها النُّفُوسُ",74,"س",1,1],["كالغيثِ في السِّلمِ أَو كاللَّيث يَوْمَ وَغىً","والرمح كالنَّاب والصَّمصَامُ كالظُّفر",75,"ر",1,0],["كالغُصْنِ في هَيَفٍ والبَدْرِ في شَرفٍ","وَالشَّمْسِ في صَلَفٍ والظَّبْيِ في كَحَلِ",76,"ل",1,1],["كالغادة الحسناء في","قشب المطارف بين غيد",77,"د",1,0],["كالغيثِ كاللَّيثِ في البَسالَة كال","شَّمسِ ضياءً كالبَدرِ كالفَجر",78,"ر",1,0],["كالغيثِ يغشاكَ قَطراً وهو مُقترِبٌ","دانٍ ويأتيكَ سَيلاً وهو مُبتعد",79,"د",1,0],["كالغيث أنى هما فالأرض ضاحكة","تميس نوراً وأطياباً وأفنانا",80,"ن",2,0],["كالغصن بين حدائق","كالشمس تُشرق ضاحيه",81,"ي",2,0],["كالغصن منثنياً كالظبي ملتفتاً","كالشمس مبتسماً كالبدر منتقب