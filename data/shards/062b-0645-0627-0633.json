لْغِزَه رق265م","https://www.poetsgate.com/ViewPoem.aspx?id=186405",""],[5381,"رياح طيبة","https://www.poetsgate.com/ViewPoem.aspx?id=215670",""],[5431,"زندقة!..","https://www.poetsgate.com/ViewPoem.aspx?id=194763",""],[5442,"ما آذنته بينها أسماء","https://www.poetsgate.com/ViewPoem.aspx?id=114772",""],[5452,"غادة الطوارق","https://www.poetsgate.com/ViewPoem.aspx?id=112029",""],[351,"جَاءَتْ بِوَجْهٍ كَأَنَّ البَدْرَ بَرْقَعَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=4433",""],[5596,"بين السبحية والحمراء","https://www.poetsgate.com/ViewPoem.aspx?id=206360",""],[5628,"صور من الريف","https://www.poetsgate.com/ViewPoem.aspx?id=178449",""],[243,"تسديد الحساب","https://www.poetsgate.com/ViewPoem.aspx?id=50560",""],[5655,"عُوجا علي أرضهم غداً ولِجا","https://www.poetsgate.com/ViewPoem.aspx?id=107217",""],[5804,"لا تلم في الزمان حرا غريبا","https://www.poetsgate.com/ViewPoem.aspx?id=215193",""],[5866,"مجاراة لقصيدة الشاعر حسن عامر","https://www.poetsgate.com/ViewPoem.aspx?id=182812",""],[5885,"البئر قد جف","https://www.poetsgate.com/ViewPoem.aspx?id=203025",""],[5908,"هب الصبا إن هب أو تنفسا","https://www.poetsgate.com/ViewPoem.aspx?id=170974",""],[5961,"الدعاء في عرفات","https://www.poetsgate.com/ViewPoem.aspx?id=199815",""],[6124,"عودٌ","https://www.poetsgate.com/ViewPoem.aspx?id=120674",""],[6125,"تُدمِي بقلبي هِجرَةٌ وجَفَاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=208593",""],[572,"جَاءَتْ فاكَبَرَهَا طرفي فقمتُ لها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9494&r=&rc=351",""]],"verses":[["ثُمَّ اِستَقَرَّت بِهِ نَفسٌ مُشَيَّعَةٌ","لَها مِنَ القَدَرِ المَجلوبِ مِعوانُ",0,"ن",1,0],["ثمّ اسْتَرادَ جَنابَ اللهِ خزْرَجُهُ","حتّى أحلّ بأعْلى يثْرِبَ الحِلَلا",1,"ل",2,0],["ثُمَّ اسْتَحَثَّ إِلَى الإِلاَهِ رِكَابَهُ","وَغَدَا وَفِي دَارِ النَّعِيمِ حُلُولُهُ",2,"ل",2,0],["ثُمَّ اسْتَبَدَّ الْعَزْمُ فِيكَ وَمَا ارْتَأَى","وَالْعَزْمُ يُوهِنُ عَقْدَهُ تَأَجِيلُهُ",2,"ل",2,0],["ثُمَّ أَسقاهُمُ عَلى نَفَدِ العَي","شِ فَأَروى ذَنوبَ رِفدٍ مُحالِ",3,"ل",1,0],["ثُمَّ اِستَمَدّوا مِنهُ كُلَّ قِواكُمُ","إِنَّ القَوِيَّ بِكُلِّ أَرضٍ يُتَّقى",4,"ق",2,0],["ثُمَّ اِستَدارَ عَلى أَرجاء مُقلَتِها","مُبادِراً خَلَساتِ الطَرفِ يَستَبِقُ",5,"ق",1,0],["ثُمَّ اِستَباحوا الطاهِراتِ حَواسِرا","فَالشَملُ مِن بَعدِ الحُسَينِ مُبَدَّدُ",6,"د",1,0],["ثُمَّ اِستَقَلّوا فَبَتّوا البَينَ وَاِجتَذَبَت","حَبلَ الجِوارِ نَوىً عَوجآءُ فَاِنَبتَرا",7,"ر",2,0],["ثم أسلمت للمليحة قلباً","أوجب الحسن بالهوى إيمانه",8,"ن",2,0],["ثُمَّ اِستَبَحنا المَلِكَ المُتَوَّجا","كُنّا لِأَعداءِ تَميمٍ كَالشَجا",9,"ج",2,0],["ثم استمر كوقف العاج منكفتاً","يرمي به الحدب اللماعة الحدبُ",10,"ب",1,1],["ثم استمرَّ تغنيه الذباب كما","غنى المقلِّس بطريقاً بمزمارِ",11,"ر",1,1],["ثم استمر وللاشباه تذكرةً","كأنَّه الكوكبُ المريخُ أو زُحَلُ",12,"ل",1,1],["ثم استثيرت فثارت وهي مثقلةٌ","وقد أتته تباري الريح إحفافا",13,"ف",2,0],["ثم استهل على الدنيا بنائله","حتى غدت فلوات الأرض أريافا",13,"ف",2,0],["ثم استراضتْ فجاء مركَبُها","مُمْتَهَدَ الظهرِ مُردفَ الكَفَلِ",14,"ل",1,0],["ثم استمرّتْ فصارتْ في البلادِ له","كأنها أرسلتْ من دبرهِ مثلا",15,"ل",2,0],["ثم استقلَّ فكانَ نو","راً للسُّهولِ وللحُزوم",16,"م",1,0],["ثُمَّ اِستَمَرَّ يُجاريهِنَّ لا ضَرَعٌ","مُهرٌ وَلا ثَلِبٌ أَفناهُ تَعويدُ",17,"د",1,0],["ثُمَّ اِستَبَدَّ بِسَلمى نِيَّةٌ قَذَفٌ","وَسَيرُ مُنقَضِبِ الأَقرانِ مِغيارِ",18,"ر",1,0],["ثُمَّ اِستَفَقتَ وَلَيسَ في رَوضِ المُنى","إِلّا الضَبابُ وَغَيرُ شَوكِ الياسِ",19,"س",1,0],["ثُمَّ اِستَوى يَهمُسُ في نَفسِهِ","ذو جَنَّةٍ أَمسى بِلا جَنَّتِه",20,"ه",1,0],["ثُمَّ اِستَمَرَّت حالَتي","بِدَوامِ تِلكَ الحالَتَينِ",21,"ن",1,0],["ثُم استَدارَ عَلَى أَرجاءِ ساحَتِه","حَتَّى تَبادَرَ مِنها دَمعُها الهملُ",22,"ل",1,0],["ثُمَّ اسْتَمَرَّ على الصَّلاةِ إِمامُهم","فَتَخَرَّبُوا وَرَمَى الرِّجالُ رِجالا",23,"ل",2,0],["ثُمَّ اسْتَمَرّ كما غَنّى على طَرَبٍ","مُرَنّحٌ قَدْ عَلا تَطْرِيبُهُ وَصَفَا",24,"ف",2,0],["ثم اسلُكي بين بُرْدَيْهِ على عَجَلٍ","واستبضعي الطيب وأْتِيني على قَدَرِ",25,"ر",1,0],["ثُمَّ اِستَمَرّوا وَقالوا إِنَّ مَشرَبَكُم","ماءٌ بِشَرقِيِّ سَلمى فَيدُ أَو رَكَكُ",26,"ك",1,0],["ثُمَّ اِستَمَرَّت إِلى الوادي فَأَلجَأَها","مِنهُ وَقَد طَمِعَ الأَظفارُ وَالحَنَكُ",26,"ك",1,0],["ثُمَّ اِستَجابَت رِجالٌ دُونَ أُسرَتِهِ","وَفي الأَباعِدِ ما يُغني عَنِ الرَّحِمِ",27,"م",1,0],["ثُمَّ اِستَمَرَّ رَسُولُ اللَّهِ مُعتَزِماً","يَدعُو إلى رَبِّهِ في كُلِّ مُلتَأَمِ",27,"م",1,0],["ثُمَّ اِستَقَلَّ وَأَبقى في الزَّمانِ لَها","ذِكراً يَسيرُ عَلَى الآفاق كَالنَّسَمِ",27,"م",1,0],["ثُمَّ اِستَمَرَّت سَرايا الدِّينِ سابِحَةً","بِالخَيلِ جامِحَةً تَستَنُّ بِاللُّجُمِ",27,"م",1,0],["ثُمَّ اِستَدارَت رَحا الهَيجاءِ في أُحُدٍ","بِكُلِّ مُفتَرِسٍ لِلقِرنِ مُلتَهِمِ",27,"م",1,0],["ثُمَّ اِستَثارَت قُرَيشٌ وَهيَ ظالِمَةٌ","أَحلافَها وَأَتَت في جَحفَلٍ لَهِمِ",27,"م",1,0],["ثُمَّ اِستَقامَ لِبَيتِ اللَّهِ مُعتَمِراً","لِنَيلِ ما فاتَهُ بِالهَديِ لِلحَرَمِ",27,"م",1,0],["ثُمَّ اِستَهَلَّت وُفُودُ الناسِ قاطِبَةً","إِلى حِماهُ فَلاقَت وافِرَ الكَرَمِ",27,"م",1,0],["ثُمَّ اِستَقَلَّ اِبنُ حِصنٍ فَاِحتَوَت يَدُهُ","عَلى بَني العَنبَرِ الطُّرّارِ وَالشُّجُمِ",27,"م",1,0],["ثم استعدَّ وجاءَ قيصرَ وافدٌ","بصحيفةٍ منه تَصِرُّ وتَصْرُفُ",28,"ف",1,0],["ثم استقامَ على البيضَاءِ يَسْلكُها","مَن كان يضربُ في العمياءِ مُعْتَسِفا",29,"ف",2,0],["ثم استبدَّ بهم قضاءٌ غالبٌ","فمضوا وأدبرَ جمعُهُم مُتراميا",30,"ي",2,0],["ثُمَّ اِستَوَت مِن بَعدِهِ الخِلافَه","وَزالَتِ الرَهبَةُ وَالمَخافَه",31,"ه",1,0],["ثُمَّ اِسكُتوا عَن سِوى الاِس","تِحسانِ وَالأَفراحِ",32,"ح",1,0],["ثُمَّ اِستَدارَ بِهِ سُكرٌ فَمالَ بِهِ","فَقُمتُ أَسعى إِلَيهِ وَهوَ مُنجَدِلُ",33,"ل",1,0],["ثُمَّ اِستَهَشَّت إِلى صَوتٍ تُمَلِّحُهُ","إِنّا مُحَيّوكَ فَاِسلَم أَيُّها الطَلَلُ",33,"ل",1,0],["ثُمَّ اِستُبيحوا عَنوَةً فَكَأَنَّهُم","جاروا وَما كانوا الرَسولَ أَجاروا",34,"ر",3,0],["ثُمَّ اِستَقَلّا إِلى قُبورِهِما","وَالقَبرُ لِلنازِلينَ كَالحَرَمِ",35,"م",1,0],["ثُمَّ اِستَمَرَّ يُباري ظِلَّهُ جَذِلاً","كَأَنَّهُ مَرزُبانٌ فازَ مَحبورُ",36,"ر",1,0],["ثُمَّ استَمَرَّت شَمُوسُ الرِّيحِ سَاكِنَةً","تُزجِي رَباعاً ضِعافَ الوَطءِ أَطفالا",37,"ل",2,0],["ثمَّ استشارَ ذا النُّهى والحِجْرِ","من صَحْبه ومِن رجالِ الثَّغْر