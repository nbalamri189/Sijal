ry.dctabudhabi.ae/diwan/poem/73418","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73115","الخفيف"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77689","الرمل"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123866","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120394","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120386","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35092","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52165","الكامل"],[4859,"لحظة غمض!","https://www.poetsgate.com/ViewPoem.aspx?id=204321",""],[5055,"حسادي","https://www.poetsgate.com/ViewPoem.aspx?id=108268",""],[5121,"عَجَبِي","https://www.poetsgate.com/ViewPoem.aspx?id=33572",""],[5136,"هي تربة تسمو على كيوان","https://www.poetsgate.com/ViewPoem.aspx?id=121726",""],[5136,"يا لها روضة حسن أحسنت","https://www.poetsgate.com/ViewPoem.aspx?id=121755",""],[5136,"أول الحب في القلوب علوقا","https://www.poetsgate.com/ViewPoem.aspx?id=121626",""],[5136,"حبه بالروح ممتزج","https://www.poetsgate.com/ViewPoem.aspx?id=121535",""],[5136,"ما هز عطفي ملة الحنفاء","https://www.poetsgate.com/ViewPoem.aspx?id=121489",""],[5191,"الدّمُ الحرام","https://www.poetsgate.com/ViewPoem.aspx?id=212451",""],[5197,"تحية البطل..!","https://www.poetsgate.com/ViewPoem.aspx?id=102355",""],[5212,"صَمّاءٌ حَكَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=212063",""],[5219,"الرجولة موقف","https://www.poetsgate.com/ViewPoem.aspx?id=193709",""],[5273,"زوجتي","https://www.poetsgate.com/ViewPoem.aspx?id=28760",""],[5459,"مديح نبوي","https://www.poetsgate.com/ViewPoem.aspx?id=190900",""],[5493,"معراج الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=203377",""],[5504,"سطعت سيوف الهند باللّمعان","https://www.poetsgate.com/ViewPoem.aspx?id=124901",""],[5626,"عجبي عل كل المحاسن","https://www.poetsgate.com/ViewPoem.aspx?id=189694",""],[5628,"الى صاحب برج العذراء في ليلة زفافه","https://www.poetsgate.com/ViewPoem.aspx?id=178467",""],[5652,"عظيمه هالمشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=176982",""],[5674,"أصون عهد الحب","https://www.poetsgate.com/ViewPoem.aspx?id=189550",""],[5781,"طُيوفكَ المنى ...وحبق","https://www.poetsgate.com/ViewPoem.aspx?id=208930",""],[5790,"لا وعينيك ويكفى ذا القسم","https://www.poetsgate.com/ViewPoem.aspx?id=111869",""],[5909,"رُضِّيتُ من مضض الرضا بتزلّفك","https://www.poetsgate.com/ViewPoem.aspx?id=210233",""],[6056,"ملتقى الخطين","https://www.poetsgate.com/ViewPoem.aspx?id=130529",""],[6089,"عجبي للعقولِ","https://www.poetsgate.com/ViewPoem.aspx?id=212942",""],[6177,"لن أعود إليك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79464&r=&rc=24",""]],"verses":[["عجبي إلى تلك المصائب كيف قد","نسيت ولم تبرأ لهنّ جروح",0,"ح",1,0],["عجبي يا قوم كلَّ العجب","هذه الآثارَ لِمْ لا نقتفي",1,"ي",1,0],["عجبي منه ظالماً مستطيلاً","وهو إن ماسَ أعدل الناس شكلا",2,"ل",2,0],["عَجبي للشمس أَنَّى تَجَلّى","وعليها من سَحابٍ حجابُ",3,"ب",1,0],["عجبي من بذلها ما بذلَتْ","وسُراها وهي مِشماسٌ خَرُودُ",4,"د",1,0],["عجبي من نِفارهنَّ ولم تُهْ","د إليهنَّ بل إليَّ وعيدَكْ",5,"ك",1,0],["عجبي من مادح يمَّنَهُ","وهو المُعتقُ قِدماً يَمَنَه",6,"ن",2,0],["عجبي أطلتُ لك الرشاءَ ولم أجدْ","جَدواكَ غَوْراً بل مَعينا عائنا",7,"ن",2,0],["عجبي ممن قد رأى ان رأيي","غير ما يرتأى فسب حنيقا",8,"ق",2,1],["عجبي لنفسك لم تدع لك هيكلا","إن النفوس لآفة الأجساد",9,"د",1,0],["عَجَبي مِنها وَمِن قائِدِها","كَيفَ يَحمي الأَعزَلُ الشَيخُ حِماها",10,"ا",3,0],["عجبي من مجاور ضاق بالأز","هر واحيرة النفوس الكبارِ",11,"ر",1,0],["عجبي من ترقبي ما الذي أر","جو ولما يعد لقلبي رجاء",12,"ا",2,0],["عجبي كيفِ اهتدتْ مُهْدِيَةٌ","خَصَرَ الرِيِّ إلى حرّ الغليلِ",13,"ل",1,0],["عَجَبي لِلَفظٍ مِنكِ ذي نُسُكٍ","هَذا وَلَحظُكِ حاضِرُ الفَتكِ",14,"ك",1,0],["عَجَبي لأَضدادٍ عَلَيَّ تَناصَرَتْ","جَوْراً عَلَيَّ وَلَيس لي أنْصارُ",15,"ر",1,0],["عَجَبي من سكينتي وَوَقَاري","بعد صَيْدِ المها وَخَلْعِ العِذارِ",16,"ر",1,1],["عَجَبي لإصابةِ مُرْسَلِهَا","منْ جَوْفِ ضلوعي في الخَلَدِ",17,"د",1,0],["عجبي منهُ كيفَ يقطعُ قلبي","ويقدُّ الضلوعَ والصدرَ يشرحْ",18,"ح",1,0],["عجبي لإبليسَ ارتضى","بضلالِهِ عنْ رشدِهِ",19,"ه",1,1],["عجبي لنطقِ غزالةٍ للمصطفى","جعلَ الإلهَ لها بذلكَ مخرجا",20,"ج",2,0],["عجبي لشاربِ خمرةٍ ما خامرتْ","لبَّ امرئٍ إلاّ عرتْهُ بعارِ",21,"ر",1,0],["عَجَبي لِلطَبيبِ يُلحِدُ في الخا","لِقِ مِن بَعدِ دَرسِهِ التَشريحا",22,"ح",2,1],["عَجَبي مِن نسرينِ قد وقع الوا","حدُ والثاني طائرٌ في الفضاء",23,"ا",2,0],["عَجَبي من الإنسان يهججَ آمِناً","وَالمَوت للإِنسان بالمرصاد",24,"د",1,0],["عَجَبٌ يَا مُجَاجَةَ النَّفْسِ هَلْ أَجْ","رَاكَ مَجْرَى سُلاَفَةِ العُنْقُودِ",25,"د",1,0],["عجَبي له؛ كيف استطاعَ الصدقَ في","لغة السياسة وهْي من أعدائه؟",26,"ا",3,0],["عجبي له يخشى الزمانُ نزالَه","وعليه تبدو خشيةُ العُبَّاد!",27,"د",1,0],["عجبي عليه خمسةً في مثلها!","وأراه ملء الأرض عنديَ والسَّما",28,"م",2,0],["عَجبي عليها آلةً سحريةً","تصفُ الوجوهَ طلاقةً وتجهُّما!",28,"م",2,0],["عجبي عليكَ: يكرَّمُ الكلب الذي","خاصمتهُ، وتبيت غيرَ مكرَّم!!",29,"م",1,0],["عجبي على الذؤبانِ: كي","ف عَدَتْ على الأُسْدِ الكواسر؟!",30,"ر",1,0],["عجبي على باغ يقو","ل لمن بَغى: هذا حرام!",31,"م",1,0],["عَجَبي بزَهْوِ صُخوره وجباله","عَجَبي بمنحَدرَاته وسُهوله",32,"ل",2,0],["عُج بي عَلَيها وأذرِ في أطلاَلِهَا","ما صُنتَ مِن دَمعٍ عَنِ الأطلاَلِ",33,"ل",1,0],["عج بي فديتك في أباطح دمر","تزهو بها طربا بأبهى منظر",34,"ر",1,1],["عج بي فديتك في أباطح دمر","ذات الرياض الزاهرات النضر",35,"ر",1,1],["عُجْ بي فَدَيتُكَ نادِباً","ما بَينَ أَرسُمِها الطَوامِسْ",36,"س",1,0],["عَجَبي منه وإنْ أكْثَرْتُ في","كلِّ ما أبصرتُ منه عَجَبي",37,"ب",2,0],["عجبي بصرفك في الغنى","والفقر بل عجب الجماعه",38,"ع",2,0],["عجبي والناسُ إن فطنوا","وجدوا دهري أبا العجبِ",39,"ب",1,0],["عجبي للمدام في الجفن منه","كيف يبقى ودايماً تكسيره",40,"ر",2,0],["عجبي منك كيف تسألُ عما","حَلَّ بي في الهوى وأنت عليم",41,"م",1,0],["عجبي بالغ وحزني شديد","لا ناس اتراحهم افراح",42,"ح",1,0],["عَجَبي لِرِقَّةِ وَجهِ كَلَفي بِهِ","تُبدي أَسِرَّتُهُ لَنا أَسرارُهُ",43,"ه",1,1],["عَجَبي مِنهُ وَهوَ جَوهَرُ أَعراضِ","سَقامي يَفني وَما فيه باقِ",44,"ق",1,0],["عجَبي منكَ حيثُ إنّك في قَلْ","بي وقَلْبي إليك بالأشواق",45,"ق",1,0],["عجبي لطرة شعرها وجبينها","أنّى يكون مع الظلام نهار",46,"ر",1,0],["عجبي لهاتيك البدو","ر قد استقرّت في المقابر",47,"ر",1,0],["عجبي لرقة خصره وعجبت من","قاسي قساوة قلبه الصمصام",48,"م",1,0],["عجبي للجمال يهوى مع البخ","ل ويرضى بحكمهِ المظلوم",49,"م",1,0],["عجبي من هواهُ وهوَ ظلومٌ","كيف يلقى بطاعةٍ وبسمع",50,"ع",1,0],["عجبي من متجنَّ ظالمٍ","أبداً يهوى على ما يتجنّى",51,"ن",2,0],["عَجَبي يا حسينُ كيفَ هُنا","ليسَ يَحمَرُّ لَونُهُ السَّعَفُ!",52,"ف",1,0],["عَجَبي يا قَومُ إِذ عَبَرَت","بِعَبيرِ الصُدغُ مِنهُ يَدي",53,"د",2,0],["عَجَبي فِيَّ إِذ اَتَيتُ بِشَمسٍ","كَيفَ حَتّى أَطلَعتُها في ضَبابِ",54,"ب",1,0],["عَجَبي فيهِ كَيفَ يَخفى عَلَيهِ","عَجزُهُ عَن بُلوغِهِ ما يَشاءُ",55,"ا",2,0],["عَجَبِي منِ ابنِ يَهُودٍ يَعرِفُ قَدرَه","وَيُؤُم بيضَ الهندِ وهيَ رِقَاق",56,"ق",1,0],["عَجَبِي مِن الدُّتشِي يعرِفُ قَدرَه","ويؤُمُّ بيضَ الهِندِ وهى رِقَاقُ",57,"ق",1,0],["عجبي له وهو الكثير أضلنا","والواحد الهادي لنا استنقاذا",58,"ذ",2,0],["عجبي ممن تعالت حالُه","وكفاه اللَّهُ ذلاّت الطلبْ",59,"ب",1,1],["عَجَبِي مِنْ قَويمِ قامَتِكَ الهَيْ","فَاء قاسٍ وَقِيلَ عَنْهُ رَطِيبُ",60,"ب",1,0],["عَجبي لِطَرْفِكَ وَهْوَ ماضٍ لَمْ يَزَلْ","فَعلامَ يُكْسَرُ عِنْدَمَا تَتَكَلَّمُ",61,"م",1,0],["عَجَبي لِثُعبانٍ يَجُولُ عَلى نَقَا","أَرْدَافِهِ في الحُبِّ كَيْفَ حَوَانِي",62,"ن",2,0],["عجبي لِقَبرٍ حَواه إِنَّهُ عجب","إِذ بان منه اِتّساعُ الصدر لِلبحَرِ",63,"ر",1,0],["عجبي والخطوب","تبرح فينا وتسنح",64,"ح",1,0],["عجبي من الآلام كيف غزت","جسماً له من مجده حرم",65,"م",1,0],["عَجَبي مِن جُفونِها وَهيَ كَسْرى","كَيفَ تَقوى بِنَصرِها وَهيَ مَرضى",66,"ض",2,0],["عَجَبي لَهُ كَيْفَ أَوْجَبَ ذَنْباً","لَمْ يَكُنْ عَنْ تَسَلُّفٍ واقْتِراَضِ",67,"ض",1,0],["عجبي منكم لعين ظباء","ليس ينفك صيدها أسد غابِ",68,"ب",1,0],["عجبي لماذا ارتجت الأمم اضطرا","باً والشعوب هذت بهذيٍ باطلِ",69,"ل",1,1],["عَجَبي لامْرِئٍ يَرى الأَرْضَ مَثْوا","هُ وأقْصى مُناهُ كَسُبُ الثَّراءِ",70,"ا",2,0],["عُج بى على مَن سَقَّنى كمداً","وصبابةً بالتِّيه والعُجبِ",71,"ب",1,0],["عجّ بي على تلكَ الطلولِ ونادِ","انَّى تحمّل اهلُ هذا النادي",72,"د",2,1],["عج بى بلغت الرشد قد لاح السنى","وانخ ركابك بالمحصب من منى",73,"ن",2,1],["عُج بي عَلَيهِم فَعُجبي مِن جَفاءِ فَتىً","جازَ الدِّيارَ وَلَم يُلمِم بِرَبعِهِمِ",74,"م",1,0],["عُج بي عَلى الرَّبعِ حَيثُ الرَّندُ وَالبانُ","وَإِن نَأى عَنهُ أَحبابٌ وَجِيرانُ",75,"ن",1,1],["عجبي إذا جئت غربي الحمى وبدت","منه لمقلتك الاعلام والقبب",76,"ب",1,0],["عجبي لذُبَّله وقد سقيت","ماء الطُّلى ومتونها سُلُب",77,"ب",1,0],["عجبي لخديه ترقرق ماؤها","في نار حسن تحتها متوقد",78,"د",1,0],["عجبي من عقرب في صدغه","ما لها في غير أحشائي دبيب",79,"ب",1,0],["عج بي على دمن النقى فمغاني","نهى الغضاة فمرقب الصيران",80,"ن",1,1],["عُج بي على تلك الرُبوع","ننشق بها نشرَ الربيع",81,"ع",1,1],["عج بي عليه إن في سفحه","للصب ديناً يتقاضاه",82,"ا",2,0],["عجبي للمقلدين حكى","عجَبَ الكلّ بي كمبتكرِ",83,"ر",1,1],["عجبي يا قلب من وقت مضى","كنت في زهدك تبدو كركام",84,"م",1,1],["عجبي لكون كم به","سر وكم معنى جليل",85,"ل",1,1],["عجبي لقوم يحزنون لأنهم","ما أعقبوا نسلاً ليصبح جمهره",86,"ه",1,0],["عجبي ولا عجب يلين لك الصفا","والماء من صم الصفا لك ينبع",87,"ع",1,0],["عجبي للمسيح بين النصارى","والى أي والد نسبوه",88,"ب",3,0],["عجبي من مُغَمِّسٍ لكَ بِئْراً","طَمَعاً أَنْ تَزِلَّ فيها فَزَلاّ",89,"ل",2,0],["عَجبي من محاسنٍ رخَصت والرُّ","وح باتت لكل حسن ماله",90,"ل",2,0],["عَج بي عَلى دارهم عليّ أَنال يَدا","فَلِلعَطاء اِتِساع في ديارهم",91,"م",1,0],["عج بي الى قصر رفيع سما","مواطن الفتح بأعلا المصاد",92,"د",1,1],["عجبي عَلى نور تَجسَّمَ صُورةً","يَهدي البَرية وَالدَياجي تَغسق",93,"ق",1,0],["عجبي من زجاجة تنتقيها","فإذا الكون مشرق الصفحتين",94,"ن",1,0],["عجبي من عالم تجمعه","أذن. كم فيه من قلب نفور",95,"ر",1,0],["عجبي لشيء فيه منك ملامح","أن ليس يُسمع منه قول حاسم",96,"م",1,0],["عجبي لشيء فيه منك ملامح","أن ليس يخفق فيه قلب عالم",96,"م",1,0],["عجبي لوجهك كيف ذل لمعشر","رفعوك عن سرر لهم وأريك",97,"ك",1,0],["عجبي للحياة أَشْرفُ ما تحْ","وِيه وَقفٌ على الحقيرِ الطفيفِ",98,"ف",1,1],["عجبي من سقمٍ في طرفه","يورث الجسمَ ويشفي السَقَما",99,"م",2,0],["عجبي لجبهته وطرته","وضح الصباح وما انجلى الغسَقُ",100,"ق",1,0],["عَجَبِي وَمَجدُكَ طَيِّبُ الأَعراقِ","سارٍ كَسَيرِ الشَّمسِ في الأفاقِ",101,"ق",1,1],["عجبي لغيث نداك يا غوث الورى","يهمى وشمسك لم تغب عن مطلع",102,"ع",1,0],["عجَبي منه والتَّعجُّبُ منه","مثلُ وجدي في حبِّه ليس يفنَى",103,"ن",2,0],["عُج بي فلستَ إذا فَعلتَ بِأَوَّلِ ال","عُشَّاقِ تَعريجاً على الأطلالِ",104,"ل",1,0],["عَجَبي لجفنِكَ كيفَ يُنكرِ قَتلتي","وهُوَ السَّقيمُ فكيفَ منها يَبرأُ",105,"ا",1,0],["عجَبي لقدِّكَ كَيفَ أَصبحَ عَادِلاً","مِن تَحتِ طَرفِكَ وَهو أَقتلُ جَائرِ",106,"ر",1,0],["عجَبي من رُضابِه كيفَ يحوي","جوهرَ الثَّغرِ وهوَ عذبٌ زُلالُ",107,"ل",1,0],["عَجَبي وَاللَهِ مِن إِب","طانِ هَذا الشَنئانِ",108,"ن",1,0],["عجبي من تواجدي ومشيبي","زارني والشبابُ أيدي ازوراره",109,"ر",2,0],["عجبي من الايام اني بحتري","فيها اللئيم على الكريم الخير",110,"ر",1,0],["عجبي من الافاك يغضب ربه","عمدا وبهتانا ليرضى راهبا",111,"ب",2,0],["عَجَبي وَلكِن مِن سَفاهَةِ راحِلٍ","رامَ الرَشادَ فَراحَ عَنكَ أَوِ اِغتَدى",112,"د",2,0],["عجبي لحاملة الصليب إلى الهدى","إني حملت مع الصليب هلالا",113,"ل",2,0],["عجَبِي كيف صارَ لاسمكَ عرشٌ","في فؤادي من بعدِ صدٍّ ورفضِ",114,"ض",1,1],["عجب يا عبدي المضني شرينا بنفوس فلوس","مغير العرق يا صاحب غزير الكل غراسي",115,"س",2,0],["عَجَبِي مِنَ الْمَغْرُوزِ حَيّاً نَابِضَا","بَيْنَ الْحَنَايَا يَسْتَرِيِحُ مُرَابِضَا",116,"ض",2,1],["عَجَبي مِنَ الإِنْسَانِ إِنْ قَالَ الأَنَا","وَبِجَوْفِهِ مَاتَ الشُّعُورُ مُنَاقِضَا",116,"ض",2,0],["عجبي لرمس ما تجاوز سمكه","شبرين كيف ثوى به بحران",117,"ن",1,0],["عجبي ما بالها لي أحزنت","وهي صفراء تسر الناظرين",118,"ن",1,0],["عجبي طرفه يعربد شكراً","وهو لم يدر كيف طعم السلاف",119,"ف",1,0],["عجبي من نور حاجبه","كيف سوى حسنها العوج",120,"ج",1,0],["عجبي وملة أحمد ما بالها","ضحكت بثغر الغادة الغيداء",121,"ا",2,0],["عجبي على متجبرٍ","بالحُسنِ خالطَهُ الدّلالْ",122,"ل",1,0],["عجبي على ضعفِ الجفونِ","هوى به عزمُ الرّجالْ",122,"ل",1,0],["عجبي، أخوةٌ \"ليوسف\" قاموا","جمعوا كيدهم ، وعادوا نبيّا",123,"ي",2,0],["عَجبي لِصَمّاءٍ وَقُلْتُ لَها اخرَسي","دُنياي فيَّ نَصوحَةٌ كمُدرِّسي",124,"س",