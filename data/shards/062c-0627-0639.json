],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2468","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122559","الخفيف"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122376","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64251","المنسرح"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38202","الرمل"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100143","المديد"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216896","الخفيف"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35803","الخفيف"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113977","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110315","الكامل"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33857","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77227","الخفيف"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106893","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100205","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205074","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199935","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200125","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74070","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40123","الرمل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107501","الخفيف"],[3271,"فقراء","https://www.poetsgate.com/ViewPoem.aspx?id=128734",""],[5431,"من ذا يُجففُ أنهره","https://www.poetsgate.com/ViewPoem.aspx?id=199762",""],[5431,"وحده الموتُ مخْلصٌ بالحفاظِ!!","https://www.poetsgate.com/ViewPoem.aspx?id=200775",""],[5458,"الحمل المغفل","https://www.poetsgate.com/ViewPoem.aspx?id=72396",""],[5572,"العشق القديم","https://www.poetsgate.com/ViewPoem.aspx?id=53486",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5701,"يا سعد قم وانظر تجد ما نستحي","https://www.poetsgate.com/ViewPoem.aspx?id=164583",""],[6031,"إنَّ عَيْناً قُوْتُها مرْآكَ يا","https://www.poetsgate.com/ViewPoem.aspx?id=46393",""],[6056,"الصافنات المساريج","https://www.poetsgate.com/ViewPoem.aspx?id=130506",""],[572,"يَقِظٌ يَلمَحُ الخطوبَ بتدبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9215&r=&rc=72",""]],"verses":[["جاعِلٌ قَسوَةَ الوَعيدِ عَلى الأَي","يامِ عَبداً لِرِقَّةِ الميعادِ",0,"د",1,0],["جاعِلاتٍ جَوزَ اليَمامَةِ بِالأَش","مُلِ سَيراً يَحُثُّهُنَّ اِنطِلاقُ",1,"ق",1,0],["جاعلاً للتَّواضُعِ الحرِّ تصْوِي","بك طوْراً وللعُلا تصعيدَكْ",2,"ك",1,0],["جاع شاكٍ وكُظَّ شاكٍ وما ذا","كَ لخبث الغذاء والإرقالِ",3,"ل",1,0],["جاعَ حيناً فَكانَ كَاللَيثِ آبى","ما تُلاقيهِ يَومَ جوعٍ هَزيلا",4,"ل",2,0],["جاعِلٌ دِرعَهُ مَنِيَّتَهُ إِن","لَم يَكُن دونَها مِنَ العارِ واقِ",5,"ق",1,0],["جاع فما مَصَّ مصة","من ذَنَب بالدَّرِ مشكارِ",6,"ر",1,0],["جاعِلاً يُمناكَ لِلساقِ حِجلا","وَاليَدَ اليُسرى لِخَصري وِشاحا",7,"ح",2,0],["جاعِلٌ للقِرْنِ إنْ عانَقَهُ","سَيْفَهُ طوقاً وكفَّيْهِ وِشاح",8,"ح",1,0],["جاعَتْ لِقَحْطِ (مُفاداةٍ) بها وَعَدَتْ","واسْتَنْجَدَتْ صاعَها والمِئْزَرَ الخَلَقا",9,"ق",2,0],["جاعِلاً أَلحاظَهُ","بِالسَلامِ رُسُلا",10,"ل",2,0],["جَاعِلِينَ الشّامَ حَمّاً لَهُمُ","وَلَئِن هَمُّوا لَنِعمَ المُنتَقَل",11,"ل",1,0],["جاعلاً يومه من الدهر عيداً","ومن العيد للعلى معراجا",12,"ج",2,0],["جاعِلٌ هَمَّكَ التُّخومَ ولا أَح","فِلُ اقَولَ لوُشاةِ والأَنذالِ",13,"ل",1,0],["جَاعِلاً هَمَّهُ مُؤَالَفَةَ الأَنْفُسِ","إِذْ هَمُّ غَيْرِهِ التَّفْرِيقُ",14,"ق",1,0],["جاعت ومدت يديها","إلى الأكف المريبة",15,"ب",2,0],["جاعِلاً سِرَّكَ التُخومَ فَما أَح","فل قَولَ الوُشاةِ وَالأَنذالِ",16,"ل",1,0],["جَاعِلٍ الزَّيغَ نُصبَ عَينَيهِ دَا","باً صحةَ الدينِ فَارتَكَبتَ عَظِيمَا",17,"م",2,0],["جاعِلٍ مالَهُ طَرِيقاً إِلى الْحَمْ","دِ فما يَأْتَلِي يُنِيرُ وَيْسْدِي",18,"د",2,0],["جاعِلاتٌ قُطفاً مِنَ الخِزِّ وَالبا","غِزِ حَولَ الظِباءِ فَوقَ البِغالِ",19,"ل",1,0],["جاعِلاتٌ مِن الفِرِندِ دُروعاً","وَالجَلابيبُ مِن طَعامِ الشَمالِ",19,"ل",1,0],["جاعِلاتٌ كُلَّ بابٍ","ذي سُتورٍ مِن حَريرِ",20,"ر",1,0],["جاعِلٌ للوفودِ في الكَفّ يُسراً","يَتلقّاهمُ وفي الوجهِ بِشرا",21,"ر",2,0],["جاعِلاتٍ بَطْنَ الضِّباعِ شِمالاً","وبِراقَ النِّعافِ ذاتَ اليَمِينِ",22,"ن",1,0],["جاعلٌ ما بين طرفي والكرى","كمدى ما بين سمعي والعذل",23,"ل",1,0],["جاعِلٌ صدرَهُ إذا اسْتُكْتِمَ السِّرْ","رَ ضريحاً للسرِّ أَوْكالضَّرِيْحِ",24,"ح",1,0],["جاعِلاتٍ قَطائِفَ الباغِزِ الخُض","رَ عَلى الساهِكاتِ وَالأُرجُوانا",25,"ن",2,0],["جاعلٌ رمحَه إذا لَجَّ في المش","هَدِ خصمٌ دواءَ ذاك اللَّجاج",26,"ج",1,0],["جاعل لفظه الحبيب المفدى","فيه سمع المتيم المتبولا",27,"ل",2,0],["جاعلةٌ ريقَها مدامتنا","إذا سقتنا وكأسنا فاها",28,"ا",3,0],["جاعِلاً رَأسَ المَعالي سُلّماً","يَرتَقيهِ لَيسَ بِالمُنتَكِسِ",29,"س",1,0],["جاعلاً عبد الحسين لهم","شافعاً حسبي به وكفى",30,"ف",2,0],["جاعلاً قبرهُ تُخوماً وقدْ جرْ","رَ العذارى عليه وافي الشّكير",31,"ر",1,0],["جاعِلٌ مالَهُ بِرغمِ الأَعادي","جَنَّةً بَينَهُ وَبَينَ المَلامِ",32,"م",1,0],["جاعِلاتٍ عَن اليممينِ تمِزكينَ","ضُحَيّاً وتشلَ ذاتَ الشمالِ",33,"ل",1,0],["جاعوا فراموا رزقهم","من حيث يشبع كل جائع",34,"ع",1,0],["جاعِلاً جِلدَةَ خُصيَي","هِ مِنَ القَرِّ دِثارَه",35,"ر",2,0],["جاعِلِ الخِصبَ وَالرَخاءَ أَليفا","وَحَليفاً لِنيلِ مِصرَ السَعيدِ",36,"د",1,0],["جاعلاً ذلك الغرام أَمام","اللَه والناس واضحاً كالأضاة",37,"ه",1,0],["جاعل في القناة لين استواء","جاعل في سراة صلبي انحناء",38,"ا",2,0],["جاعلا أكمة من الأرض سهلا","ومقيما من الجماجم أكمه",39,"م",2,0],["جاعلا منهما جناحا ليسمو","لاحقا بي الى أعالي الأثير",40,"ر",1,0],["جاعلاً من ترابها لي فراشاً","وغطاء يلفنّي من غبار",41,"ر",1,0],["جاعوا إِلى أكل البلاد فَلا","شرهٌ يجاريهم وَلا نهمُ",42,"م",1,0],["جاعلاً مِن دونه سَيْ","فَكَ إنْ رِيع حِجابا",43,"ب",2,0],["جاعلاً نفسه كما تشتهي حراً فبرداً","على اختلافِ الزمانِ",44,"ن",1,0],["جاعتْ فردَّتْ ذاتَها قوتًا لها","وهمُ يُرَدُّ لهم هشيمُ سرابِهِمْ",45,"م",1,0],["جاعت طيور بلادهم","والبيد جوعى مقفره",46,"ر",2,0],["جاع قهرا صواعنا دون قمحٍ","من سنينٍ مريرة وغِلاظِ",47,"ظ",1,0],["جاع الكبير من الذئاب فأقسموا","لو كان يؤكل لحمنا أو يستطاب",48,"ب",1,0],["جا على متن الونى حادي يدق","قلبي اللي ضيعه عشق(ن)قديم",49,"م",1,0],["(جاعدٌ) إنه (لشيخ رئيس)","باركتها أنواره مذ رعاها",50,"ا",3,0],["جاعت وراحوا متخمين فقوتها","ما بين متجر به ومقامر",51,"ر",1,0],["جَاعَ مِمَّا مَرِضَتْ إنْسَانُها","فتداركْهُ بِبَعضِ الإثْمَدِ",52,"د",1,0],["جاعد شبيه ، امعرّجات الكراريج","فوق المتون ، امجدلين ٍ شعرها",53,"ر",3,0],["جاعِلٌ صَدْرَهُ إذا استكَتَمَ السِّ","رَّ ضَريحاً للسّرِّ أو كالضّريحِ",54,"ح",1,0]]}