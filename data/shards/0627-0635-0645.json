iewPoem.aspx?id=198716",""],[5013,"أصم ناعيك سمع الدهر حين نعى","https://www.poetsgate.com/ViewPoem.aspx?id=170964",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5219,"يا غصن بان ....","https://www.poetsgate.com/ViewPoem.aspx?id=198737",""],[5277,"شظايا الذاكرة","https://www.poetsgate.com/ViewPoem.aspx?id=185998",""],[5279,"أَنْقَاضٌ","https://www.poetsgate.com/ViewPoem.aspx?id=183666",""],[5324,"المرأة الحلم","https://www.poetsgate.com/ViewPoem.aspx?id=210925",""],[5397,"بكى الدين والدنيا عليك فأفجعا","https://www.poetsgate.com/ViewPoem.aspx?id=157901",""],[5408,"إحتفالية المقاتل في محراب الشهادة","https://www.poetsgate.com/ViewPoem.aspx?id=190866",""],[5431,"القلب الوطن ...قصيدة سوريالية","https://www.poetsgate.com/ViewPoem.aspx?id=202071",""],[5431,"منذا يُعيد قلوب الناس للصح؟","https://www.poetsgate.com/ViewPoem.aspx?id=211746",""],[3294,"قد بت طول الليل ساهر","https://www.poetsgate.com/ViewPoem.aspx?id=173268",""],[5582,"أَراكَ كَئِيباً أَراكَ أَراكَا","https://www.poetsgate.com/ViewPoem.aspx?id=187214",""],[5735,"نجوت من حلٍ ومن رحلةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=181491",""],[6158,"أصم عن الخنا ان قيل يوما","http://www.aldiwanalarabi.com/poemDescription.do?poemId=560638",""],[5190,"اصمد وقاوم أيها اللبناني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78289&r=&rc=3",""],[6359,"المجلس الطاريء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69093&r=&rc=7",""]],"verses":[["أَصْمَيْتَ ثُغْرَتَهَا بِسَهْمِ عَزِيمَةٍ","تَذَرُ الأبِيَّ الصَّعْبَ وَهْوَ ذَلُولُ",0,"ل",1,0],["أصمُّ حديث القرن يا روق مسمعي","بتأخيره يا حابسين الندَى عنِّي",1,"ي",1,1],["أُصِمُّ بها صداك وأنت فيه","وأمْنعُ مقلتيك من الهجودِ",2,"د",1,0],["أصمُّ صُمَيميتٌ إذا ما سألتَه","حسِبتك ساءلتَ الرسومَ الدوارسا",3,"س",2,0],["أصمُّ عن الفحشاءِ والعذلِ في الندى","طويلُ التمادي في شقاقِ العواذلِ",4,"ل",1,0],["أَصَمَّ عَن غَضَبٍ مِن حَولِهِ وَرِضىً","في ثَورَةٍ تَلِدُ الأَبطالَ أَو تَئِدُ",5,"د",1,0],["أَصَمٌّ يَسمَعُ سِرَّ الكائِدينَ لَهُ","وَلا يَضيقُ بِجَهرِ المُحنَقِ الصَخِبِ",6,"ب",1,0],["أَصَمَّ لا تَقرَبُ الحَيّاتُ هَضبَتَهُ","وَلَيسَ حَيٌّ لَهُ عاشٍ يَرى أَثَرا",7,"ر",2,0],["أَصَمَّ أَبى ما يُجيبُ الرُقى","وَلَم تَرَهُ الشَمسُ إِلّا قَليلا",8,"ل",2,0],["أَصَمُّ عَنِ الكَلِمِ المُحفِظاتِ","وَأَحلُمُ وَالحِلمُ بي أَشبَهُ",9,"ه",1,1],["أَصَمَّ اللَهُ أَسمَعَنا المَلاما","وَقَصَّرَ عُمرَ أَطوَلِنا مَطالا",10,"ل",2,1],["أَصمَت لَواحِظُكِ القُلوبَ بِأَسهُمٍ","لَم يُغنِ عَنها نَثرَةٌ وَدِلاصُ",11,"ص",1,0],["أَصَمُّ أَخرَسُ مَشقوقُ اللِسانِ إِذا","طارَحتَهُ سُمِعَت مِنهُ الأَغاريدُ",12,"د",1,0],["أَصَمٌّ ظَلَّ مُستَمِعاً دُعائي","فَها أَنا أُسمِعُ الصُمَّ الدُعاءَ",13,"ا",2,0],["أَصَمَّ بِكَ الناعي وَإِن كانَ أَسمَعا","وَأَصبَحَ مَغنى الجودِ بَعدَكَ بَلقَعا",14,"ع",2,1],["أَصَمَّني سِرُّهُم أَيّامَ فُرقَتِهِم","هَل كُنتَ تَعرِفُ سِرّاً يورِثُ الصَمَما",15,"م",2,0],["أصمُّ العَزْمِ ما وَجدوهُ إلا","كَرُكنِ الطَّودِ مُمتنِعاً ركينا",16,"ن",2,0],["أَصَمصامَ إِن تَشفَع لِأُمِّكَ تَلقَها","لَها شافِعٌ في الصَدرِ لَم يَتَبَرَّحِ",17,"ح",1,0],["أَصَمُّ قُطارِيٌّ يَكونُ خُروجُهُ","بُعَيدَ غُروبِ الشَمسِ مُختَلِفُ الرَمسِ",18,"س",1,1],["أصَمُّ أعْمى ولكنْي سهِرْتُ لهُ","حتى رددتُ إليهِ السمعَ والبصَرا",19,"ر",2,0],["أَصَمُّ إِذا نوديتُ بِاسمي وَإِنَّني","إِذا قيلَ لي يا عَبدَها لَسَميعُ",20,"ع",1,0],["أَصَمُّ لا يَسمَعُ صَوتَ الرَعدِ","حَبَيتَهُ بِحَتفِهِ المُعَدِّ",21,"د",1,0],["أَصُمتَ الشُهورَ فَهَلّا صَمَتَّ","وَلا صَومَ حَتّى تُطيلَ الصُموتا",22,"ت",2,1],["أُصمُت وَإِن تَأبَ فَاِنطُق شَطرَ ما سَمِعَت","أُذُناكَ فَالفَمُ نِصفُ اِثنَينِ في العَدَدِ",23,"د",1,1],["أَصمَت سُوَيداءَ قَلبٍ مِن تَلَهُّبِها","حَمراءُ وَالنارُ تَنضو حُلَّةَ الفَحَمِ",24,"م",1,1],["أَصَمَّ رُدَينِيّاً كَأَنَّ كُعوبَهُ","نَوى القَسبِ عَرّاصاً مُزَجّاً مُنَصَّلا",25,"ل",2,0],["أصَمَّمَ في الغوايَةِ أَمْ أَنَابا","وَشَيْبُ الرَّأسِ قَدْ خَلَسَ الشَّبَابَا",26,"ب",2,1],["أَصَمَّ لم يسمَعِ الشكوى وأبكَمَ لم","يُحِر جواباً وعن حالِ المَشوقِ عمي",27,"م",2,0],["أصمّ إذا ما هزّ مارت سراته","كما مار ثعبان الرمال الموائل",28,"ل",1,0],["أَصمَعِ الكَعبينِ مَهضُومِ الحشَا","سَرطَمِ اللَّحيَينِ مَعّاجٍ تَئِق",29,"ق",1,0],["أصمَّ وأصمَى ثُغرةَ الثَّغْرِ حادِثٌ","تحدِّثُنا عنه الثِّقاتُ فَنَمْتَرِي",30,"ر",2,0],["أصمَّ سَمعي حَديثُ حادثةٍ","فَلَّ السيوفَ الذكورَ مَن ذكَرَه",31,"ر",2,0],["أَصَمَّ نَعيهُ مِصري","وَأَسمَعَ مِصرَ مَع قَوصِ",32,"ص",1,1],["أصميْتَ بالتقوى صدورَ معاشرٍ","مسخوا محيّا الدين بالإِلحاد",33,"د",1,0],["أصمَتْ سهامُكمو، لكنها سَقَطَتْ","على فؤاد الحِمى أَنْدَى من البَرَدِ",34,"د",1,0],["أصمي الحَضارةَ من رماك فإِنها","منك استُعيرت مَنْ سواك أعارها؟",35,"ر",3,0],["أصمّ كالأحجار لكنّه","يدوي ، ولا صوت له ، لا شفه",36,"ف",2,0],["أَصَمَّ الهَوَى لَيْلَى وَأَعْمَى ذَكَاءَهَا","وَرَدَّ عَلَيْهَا كَيْدَهَا ودَهَاءَهَا",37,"ه",2,0],["أصمّ عن الداعي إذا ما دخلتها","وأعمشُ من ريح الكنيف وأرمدُ",38,"د",1,0],["أُصمت اليومَ دع زَميلك فكري","يَنصر العَدل فَالعَدالَة تَدمي",39,"ي",1,0],["أَصمَت لَواحِظُكَ المَقاتِلَ رامِياً","أَفَما يَدِقُّ عَلى سِهامِكَ مَقتَلُ",40,"ل",1,0],["أَصمَيتَني بِلَواحِظٍ يَومَ النَوى","صَحَّت وَأَجفانٍ لَهُنَّ مِراضِ",41,"ض",1,0],["أَصمى الكُماةَ بِمَقصَدٍ مِن كَفِّهِ","وَرَمى القُلوبَ مِنَ اللِحاظِ بِعائِرِ",42,"ر",1,0],["أصمَى قلوبَ العاشقين طَرفُهُ","ظُلماً بما فوقَ من سِهامِهِ",43,"م",2,0],["اصم على العينين من وجه لائم","وثقل في الاسماع من عذله وقرا",44,"ر",2,0],["أصْماهُ رَامٍ كَمْ ثَنَى عَنْهُ العِدَى","صَرْعَى يُنَاضلُ دُونَهُ ويُرامِي",45,"م",2,0],["أَصمَّت برُزءٍ عمَّ فادحُه الوَرى","وَخُصَّ به بيتُ النبوَّة والمُلكِ",46,"ك",1,0],["أَصمَّت بزين العابدين نُعاته","فَكَم ثَمَّ من سمع بمعناه مستكِّ",46,"ك",1,0],["أَصمى من الإسلام حبةَ قلبه","فانهدَّ منه كلُّ ركنِ أَمنع",47,"ع",1,0],["أَصَمَّ دُعاءُ عاذِلَتي تَحَجّى","بِآخِرِنا وَتَنسى أَوَّلينا",48,"ن",2,0],["أَصمّ أقذى أجرّ اللسنَ فتّ بأع","ضاءِ البريّةِ أشجى كلّ حنجورِ",49,"ر",1,0],["أصمى بها فأصمّ بِالمهجِ الحصى","وَبكلّ سامعة أَثار عجيجه",50,"ج",2,0],["أصمَّ وأصمى سمعه وفؤاده","فلا عَذلٌ يُنهي ولا سلوة تمحو",51,"ح",2,0],["أصم إذا في حبهم لام لائم","وكلي لمن يدعو إلى الحب مسمع",52,"ع",1,0],["أصم لكن إن أتاك طارق","ناداك إن أجبته أدخلته",53,"ت",2,0],["أَصَم منادي بينَهُم حينَ أَسمَعا","وَرَوَّعَ قَلباً بِالفِراقِ مُروَّعا",54,"ع",2,0],["أَصِمُّ عَن نصحِ من يُعنِّفُني","فيهِم وما بي لَولاَ الهَوى صَمَمُ",55,"م",1,0],["أصمت قلوباً وأبكت كل ناظرةٍ","وأسعرت بلهيب الحزن أفكارا",56,"ر",2,0],["اصموا الفؤاد بسهم من تباعدهِ","وأورث السمع من بعد النوى صمما",57,"م",2,0],["أصمّ إذا رقَوه عن وداد","عَصَى الحاوين والتقط الرُّقِيَّا",58,"ي",2,0],["أصمُّ بل يسمع لكنه","من البِلَى في شُغُل شاغلِ",59,"ل",1,0],["أصمّ عن الكلم المقذعات","إذا الغِمر كان إليها سميعا",60,"ع",2,0],["أصمُّ سميعٌ ناطقٌ وهو صامتٌ","لدى الخطب عضبُ الحدّ عذب المشارع",61,"ع",1,0],["أصمتْ فؤادي مقلتاه باسهمِ","فعلامَ في خديه آثار الدمِ",62,"م",1,1],["اصمى بسهم المقلة النجلاءِ","فنجاءِ من نجل العيون نجاءِ",63,"ا",2,1],["أُصَمُّ عَنِ النّاهينَ فيهِ وَتارَةً","ألُومُ عَلَى مَن حَلَّهُ وأُلامُ",64,"م",1,0],["أَصمى بِرُمح قَوامه الفَتّانِ","هَذا الرشا يَوم الوَداع جَفاني",65,"ن",2,1],["أَصمَّ ناعيه آذاناً وَقيَّدَ أذ","هاناً وأطلَقَ أَجفاناً لمنكسرِ",66,"ر",1,0],["أُصَمِّمُ في الصِّراطِ عَليهِ شَرّاً","كَأَنّي فَوقَهُ بَطَلٌ مُشيحُ",67,"ح",1,0],["أصَمُّ سميعٌ ساكنٌ متحَرّكٌ","ينالُ جَسيماتِ العُلى وهو أعجَفُ",68,"ف",1,0],["أصمعي المعي","علم حبر عليمِ",69,"م",1,0],["أصمَّ أذنيهِ ما يُبديهِ عاذلهُ","وَحالَ عن سمعِ ما يرويه حائلهُ",70,"ل",2,1],["أصمّكَ للبينِ سرّ الفري","قِ فاِستكّ سمعك منهُ اِستِكاكا",71,"ك",2,0],["أَصَم عَنِ الَّتي تَزري بِحِلمي","وَأَجعَلُ دونَها لِلسَمعِ وَقرا",72,"ر",2,0],["اصم عن العواذل ليس يجدي","عليه في الهوى قط الملام",73,"م",1,0],["أَصَمَّ مِجْذاماً عَلَى التَضْيِيِعِ","يَأْرِزُ عِنْد الأَمَةِ الرَضُوعِ",74,"ع",1,0],["أصَمَّكَ سُوءُ فَهْمِكَ عَنْ خِطابي","وَأَعْماكَ الضَّلالُ عَنِ اهتِدائي",75,"ي",1,0],["أصمَّ سمعي وأعمى ناظري وكذا","كلامُ أكثرِ من تلقى ومنظرُهُ",76,"ه",1,0],["اصم سكوت ان شدا مادح وان","شكا من جهول دق بالطبل والزمر",77,"ر",1,0],["أصمى فؤاد الدين فيك","وطبق الدنيا مصابا",78,"ب",2,0],["أصمَّ فيها النعيُ سمعي","مذ جاءَ من فارس يصيحُ",79,"ح",1,0],["أصمَت أخاكَ لو أنَّ ما فعلت بهِ","ساء لهُ من جرح