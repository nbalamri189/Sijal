{"poems":[[16,"هل ما علمت وما استودعت مكتوم","https://www.aldiwan.net/poem27694.html","البسيط"],[107,"قل ما أردت فما عليك جناح","https://www.aldiwan.net/poem42081.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[96,"نَغَمات عودي لا تُملُّ لأنها","https://www.poetsgate.com/ViewPoem.aspx?id=15592",""],[353,"قلم الوزير هو الشقيق لبيضه","https://www.aldiwan.net/poem20441.html","الكامل"],[385,"يا من تناءت داره","https://www.aldiwan.net/poem48797.html","مجزوء الكامل"],[458,"إن نالني السقم لم يبلغ بي الجزع","https://www.aldiwan.net/poem61292.html","البسيط"],[519,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[549,"أنّى التفتّ فثمّ إسمك","https://www.aldiwan.net/poem67251.html","عموديه"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101558","الكامل"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/44805","الكامل"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73951","الخفيف"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6761","البسيط"],[1713,"","https://poetry.dctabudhabi.ae/diwan/poem/123322","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100997","السريع"],[1901,"","https://poetry.dctabudhabi.ae/diwan/poem/216574","البسيط"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48259","الطويل"],[2203,"","https://poetry.dctabudhabi.ae/diwan/poem/104459","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106901","الطويل"],[2537,"","https://poetry.dctabudhabi.ae/diwan/poem/132206","الطويل"],[2575,"","https://poetry.dctabudhabi.ae/diwan/poem/142561","السريع"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130786",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200617","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204849","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204441","المتقارب"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101631","الكامل"],[3181,"","https://poetry.dctabudhabi.ae/diwan/poem/105093","الكامل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74043","الكامل"],[3640,"","https://poetry.dctabudhabi.ae/diwan/poem/141893","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216831","الكامل"],[3810,"","https://poetry.dctabudhabi.ae/diwan/poem/18723","الكامل"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99213","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86523","الكامل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136943",""],[286,"","https://poetry.dctabudhabi.ae/diwan/poem/47076","الكامل"],[4927,"إيمان القريبة البعيدة","https://www.poetsgate.com/ViewPoem.aspx?id=30177",""],[4978,"مع إباء العرب","https://www.poetsgate.com/ViewPoem.aspx?id=177290",""],[5106,"إعتذارٌ لعمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=137303",""],[5183,"إلى ربوع مصر","https://www.poetsgate.com/ViewPoem.aspx?id=180214",""],[5183,"إلى الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=180189",""],[5452,"بلادي الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=111448",""],[5573,"سلة ضروفي","https://www.poetsgate.com/ViewPoem.aspx?id=200317",""],[5616,"الراحلون","https://www.poetsgate.com/ViewPoem.aspx?id=204853",""],[5701,"أخي يا أخا الآيات في الشعر والنثر","https://www.poetsgate.com/ViewPoem.aspx?id=164601",""],[5770,"كم في الموت من عجبِ","https://www.poetsgate.com/ViewPoem.aspx?id=178685",""],[5724,"هتف الزمان مهللا ومكبرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55143&r=&rc=10",""]],"verses":[["يوحي إِلَيها بِإِنقاضٍ وَنَقنَقَةٍ","كَما تَراطَنُ في أَفدانِها الرومُ",0,"م",1,0],["يُوحي فتنطلق السِّهامُ وما رمى","أيدي الرُّماةِ سِهامُه والرّاحُ",1,"ح",1,0],["يوحى إِلَيكَ الفَوزُ في ظُلُماتِهِ","مُتَتابِعاً تُجلى بِهِ الظَلماءُ",2,"ا",2,0],["يوحي إليَّ من الخيال بدائعاً","ويهزُّ أعطافي هوىً وسرورا",3,"ر",2,0],["يُوحي إلينا عَن ضَمِيرِكَ سَامِعٌ","مِنهُ أَصَمُّ وآخَرٌ مِنطِيقُ",4,"ق",1,0],["يوحي إِلَيَّ غَرائِباً","مِن طَرفِهِ سِحاره",5,"ر",2,0],["يوحي لها القات والقناب غفلتها","فما تفيق وما يدنو لها الهلع",6,"ع",1,0],["يوحي الكلامَ إلى جَمادِ يَراعِه","سرّاً فيُفصحُ عن بَديعِ لُغاتِهِ",7,"ت",2,0],["يُوحَى إلَِيَّ الآنَ وحيَ نُبُوَّةٍ","وهواكِ يحضنُ رعشتي ويُدَثِّرُ",8,"ر",1,0],["يوحده التوحيد في كل وحدة","موحدة بل في رفيع محلها",9,"ه",2,0],["يُوحَى اليَّ وغالباً","في الليل بعد الثانيَه",10,"ي",2,0],["يُوحى وأعينُ كل حيٍّ","في المدينة غافيه",10,"ي",2,0],["يوحي إِلَيَّ الكَأسُ ما","يوحي فَعَزّوني بِثانِ",11,"ن",1,0],["يوحش الجاهل الإقامة في الأه","ل ولا يوحش اللبيب اغترابه",12,"ب",2,0],["يوحي إِلى مُمتَطي الحَشايا","مالَكَ مِن مَضجَعي عَميت",13,"ت",1,0],["يوحّدُ اللّه إخلاصاً وقد ظهرَت","بظهره كندوب الطل في الطّلَل",14,"ل",1,0],["يوحي إلى قلبي جواه وما","يَسطيعه قلبي ولا يَقدِر",15,"ر",1,0],["يوحي إليَّ بهِ من حسنكم مَلكٌ","لو بات يوحِي بهِ للناسِ شيطانُ",16,"ن",1,0],["يوحِّدُها الرائي بحسنٍ مجرَّدٍ","ويشركُ بل لو قال فيه مشاركُ",17,"ك",1,0],["يوحي إلى روادها تأريخها","أبداً ردوا منها مياه الكوثر",18,"ر",1,0],["يُوحِّدُها الوجه الوضيءُ كأنه","سنا الفجر منه تهرب الظلمات",19,"ت",1,0],["يوحد غايات الهداة ليدركوا","نعيما وملكا لا يزال كبيرا",20,"ر",2,0],["يوحي إلى الدنيا أهازيجه","مبتدعا في كل قلب وتر",21,"ر",1,0],["يوحي اليه الهدى وحي الضمير كما","يقوده لطريق الخير مستترا",22,"ر",2,0],["يوحّدنا في الروح دارٌ ومهجرٌ","ويجمعنا في الشعر فنٌ وحُسّدُ",23,"د",1,0],["يوحي إذا يذكر في مجلس","معانيا تعيى على الحاصر",24,"ر",1,0],["يوحد نفسك بالكائنات","من النفس آثار فكر غرر",25,"ر",1,0],["يوحي الغرام","وغنا الهزار على الشجر",26,"ر",1,0],["يوحي إلى نفس المريض كآبة","خرساء تخلع مهجة الضرغام",27,"م",1,0],["يوحى اليهم غرورا من وساوسه","يزجيهم قعر لجي بملتقم",28,"م",1,0],["يُوحي له وجدانُهُ","جُملاً تُزانُ بِها الكتب",29,"ب",1,0],["يوحي إلى أقلامه ألفاظه","من مونق معناه أو من موبق",30,"ق",1,0],["يوحى إليكم عزمه وثباته","إذ لا ثبات وتركه ما اعتادا",31,"د",2,0],["يوحونَ مالِكَهُم وَنوحي مالِكاً","كُلٌّ يَحُضُّ عَلى القِتالِ وَيَدمُرُ",32,"ر",1,0],["يُوحِشْنَ أفئدةً وهنَّ أَوانِسٌ","ويرُعْنَ آساداً وهنّ ظباء",33,"ا",2,0],["يوحي فم الإبريق من نزغاتها","سحراً يفك معاقد الإيمان",34,"ن",1,0],["يوحي الشباب لنا الهوى","وكلاهما للشعر موح",35,"ح",1,0],["يوحي له وحيَ الإله حكيما","صلوا عليه وسلموا تسليما",36,"م",2,0],["يُوْحِيْ إِلَيْنَاْ بِالتَّآلُفِ كُلَّمَاْ","أَحْيَا الْغَرَاْمَº الْعَاْشِقُ الْبَنَّاْءُ",37,"ا",2,0],["يوحدنا فليس لنا فراقٌ","إلى أن يقضي الرحمن أمرا",38,"ر",2,0],["يُوَحِّدُنَاْ عَلَىْ نَهْجٍ كَسَاْنَاْ","جِبَاْهَ الشَّمْسِ مُذْكَاْةً كُسِيْنَاْ",39,"ن",2,0],["يوحي إليها الحسن في أكمامها","إن الجلال لبرعم مجنون",40,"ن",1,0],["يوحد في الصفوف الناس خ","وف ويجمعهم ولو كانوا عزينا",41,"ن",2,0],["يوحدنا الإسلام والأرض واللغة","أحبوا بلادي فالرسول حبيبها",42,"ب",3,0],["يوحيك ماتجهل وله ماتوحيت","ظاهرك مخفي ماتضمن ضروفي",43,"ف",2,0],["يُوَّحدُّهم ويطلقُهم صقوراً","إلى حيثُ ((البحيرةُ)) والجليلُ",44,"ل",1,0],["يوحدنا الإخلاص للحق وحده","فلسنا بأذناب لزيد ولا عمرو",45,"ر",2,0],["يوَحدُ الموت أحوال العباد على","دمعٍ صبيبٍ غزير المد مُنسكب",46,"ب",1,0],["يُوحدُ الرزءُ أبناء الشعوب ولا","يفرق الرزء إلا شعبنا العربي",46,"ب",2,0],["يوحي بآلاف المباديء بيننا","ليعود ذياك الصفاء مكدرا",47,"ر",2,0]]}