ني بقده","أرى الشمس قد شعت على غصن الرند",208,"د",1,0],["وابلغ الضرغام في يوم الوغى","فارس الخيل وخصاب الأسل",209,"ل",1,0],["وابلغْ مرادَك في الزَّمانِ وأهلهِ","واخلدْ ودُمْ أبداً دَواماً سرمَدا",210,"د",2,0],["وأَبلِغ قَبَائِلَ لَم يَشهَدُوا","طَحا بِهِمُ الأَمرُ ثُمَّ استَدارا",211,"ر",2,0],["وَأَبلِغا أُمَّ سَعد أَنَّ عائِبَها","أَعيا عَلى شَعفاءَ الناسِ فَاِجتَنَبا",212,"ب",2,0],["وأبلغهم في الإرثِ منِّي مسائلا","لهُنَّ الأريبُ الألمعيُّ يُعانِقُ",213,"ق",1,0],["وأبلغ شيخنا عبود","عنا بعض ما كانا",214,"ن",2,0],["وآب لداره فأقرَّ عين ال","أحبةِ وازدهت غررٌ وضاح",215,"ح",1,0],["وابلغ من دنياي نفسي سؤلها","واضرب في كل العلى بسهام",216,"م",1,0],["وأبلغا المنحنى تحية مضني","قد كساها الهيام ثوب الهوان",217,"ن",1,0],["وأبلّ وجهك فيضه أنسيت ِ إذ","ساءلتُ مِمّ ينوعُهُ مبلول ُ ؟",218,"ل",1,0],["وأبلجت من حرفي على الزاج تدليس","وأفنيت من عقبه جميع الفهارس",219,"س",1,0],["وابلنا تارد على كل الاماهي","ولا تصدر وين ما تارد ضمانه",220,"ن",2,0],["وأبلاني الزّمانُ ، بكيتُ بعضي","كعانٍ لم تُفارقْهُ الكبولُ",221,"ل",1,0],["وإبليسُ الفراقِ إذا تدانى","بوسوسةٍ \"كفى الأيامَ عشقا\"",222,"ق",2,1],["وإبليس اللعين يخاف منها","فقد غلبته في سوء الفعالِ",223,"ل",1,0],["وابليسي الله يلعنه صعب يمضي","ومن وين ماوجّهت الافكار ... أبلقآه",224,"ا",2,0],["وأبلغ لو تحدثهم جفونا","وتندى بالتعانق مقتلينا",225,"ن",2,0],["وأبلى بلاء الخيرين شهادة","وأهدى إلى الأوطان من عمره وهبا",226,"ب",2,0],["وا بلائي من مفوقة","ليس ترمي القلب عن وتر",227,"ر",1,0],["وابلٍ صوت البشر شاف الهلال","كل ما حولي تزيّن واحتفلّ",228,"ل",1,0],["وأبلغا أمَّ سعد أنّ غائبها","أعيا على شفعاء الناس فاجتنبا",229,"ب",2,0],["وأب له قلب رؤوم خافق","والنصح دون تردد يسديه",230,"ي",2,0],["وأبلغ تحيات كأن أريجها","شذى المسك يهديه المجيد المماكس",231,"س",1,0],["وأبلغه تسليماً على العبد والنوى","بعد وميض البرق جنح الغياهب",232,"ب",1,0],["وأبلغه تسليماً وأوفى تحية","وأزكى ثناء أرجه فاح كالنشر",233,"ر",1,0],["وأبلغه أنا قد سلمنا وأننا","برحمة مولانا نجونا من القهر",233,"ر",1,0],["وأبلغ بني الشيخ الأمير محمد","علياً وعبد الله عنا بلا حصر",233,