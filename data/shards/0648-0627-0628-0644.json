[4478,"","https://poetry.dctabudhabi.ae/diwan/poem/18798","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58093","الطويل"],[4516,"","https://poetry.dctabudhabi.ae/diwan/poem/66857","الهزج"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139596",""],[4626,"","https://poetry.dctabudhabi.ae/diwan/poem/102852","الطويل"],[4645,"","https://poetry.dctabudhabi.ae/diwan/poem/105489","الخفيف"],[4691,"لا تحزني فحبكم موصول","https://www.poetsgate.com/ViewPoem.aspx?id=118479",""],[4728,"نوف والراهب","https://www.poetsgate.com/ViewPoem.aspx?id=176887",""],[4797,"حن بني مرة","https://www.poetsgate.com/ViewPoem.aspx?id=178127",""],[4818,"غول","https://www.poetsgate.com/ViewPoem.aspx?id=203564",""],[4852,"تقوى الحب","https://www.poetsgate.com/ViewPoem.aspx?id=214604",""],[4862,"عجوز النحس سيدة الضلالِ","https://www.poetsgate.com/ViewPoem.aspx?id=152395",""],[4869,"غربتي ودراستي","https://www.poetsgate.com/ViewPoem.aspx?id=151634",""],[4940,"سهام الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=210455",""],[4984,"الفاصلة .. ، ..","https://www.poetsgate.com/ViewPoem.aspx?id=197617",""],[4119,"كلما خالسته نظري","https://www.poetsgate.com/ViewPoem.aspx?id=16163",""],[5055,"صوت العيد","https://www.poetsgate.com/ViewPoem.aspx?id=101656",""],[4478,"لئنْ أقمتُ بحيثُ الفيضُ في رجبٍ","https://www.poetsgate.com/ViewPoem.aspx?id=15023",""],[5219,"إلى أرض الفرات","https://www.poetsgate.com/ViewPoem.aspx?id=194989",""],[592,"سلام عليكم أهل ودي وشيعتي","https://www.poetsgate.com/ViewPoem.aspx?id=128854",""],[592,"ألا أيها الغادي على ظهر ضامر","https://www.poetsgate.com/ViewPoem.aspx?id=128828",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5431,"وصال الأرواح...","https://www.poetsgate.com/ViewPoem.aspx?id=202616",""],[5431,"ولكن أداينه ....","https://www.poetsgate.com/ViewPoem.aspx?id=214829",""],[5442,"اعمل حساب النفس عن هفواتها","https://www.poetsgate.com/ViewPoem.aspx?id=114757",""],[5573,"سلة ضروفي","https://www.poetsgate.com/ViewPoem.aspx?id=200317",""],[5663,"فلينبت القمح","https://www.poetsgate.com/ViewPoem.aspx?id=200907",""],[5829,"يا تراب المجد","https://www.poetsgate.com/ViewPoem.aspx?id=192052",""],[5829,"وليس لعاشق عنها حياد","https://www.poetsgate.com/ViewPoem.aspx?id=204665",""],[5842,"إلى جيش الغطاريف .. الجيش السوري","https://www.poetsgate.com/ViewPoem.aspx?id=68315",""],[5969,"ذُنوبُ العَيش","https://www.poetsgate.com/ViewPoem.aspx?id=200147",""],[5975,"تبدّلتِ المدّة","https://www.poetsgate.com/ViewPoem.aspx?id=53250",""],[6031,"كَفُّ الحِمَامِ وَتَرْتِ أيَّ جَوَادِ","https://www.poetsgate.com/ViewPoem.aspx?id=46281",""],[6031,"يا خَلِيلَيَّ احْبِسَا الرَّكْبَ إذَا مَا","https://www.poetsgate.com/ViewPoem.aspx?id=46300",""],[6031,"قُلْ لِمَنْ فَاقَتِ البُدُورَ كَمَالا","https://www.poetsgate.com/ViewPoem.aspx?id=46311",""],[6102,"فرادة","https://www.poetsgate.com/ViewPoem.aspx?id=184552",""],[6102,"قاف قهر","https://www.poetsgate.com/ViewPoem.aspx?id=184627",""],[6115,"الذيب يأخذ صيدته بذراعه","https://www.poetsgate.com/ViewPoem.aspx?id=180785",""],[434,"عفا من آل ليلى السه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26724&r=&rc=12",""],[6318,"درّة الأقصى مُحمَّد الدرّة وأبوه جمال الدرّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66165&r=&rc=15",""]],"verses":[["وأبلغ من بلاغته سكوتٌ","غداة لإرثه وثبوا انتهابا",0,"ب",2,0],["وأبلى لباليها كأن رميمها","تواراه جثماني فضمّن هيكلي",1,"ل",2,0],["وَأَبلَجَ مِثلَ فَرقِ الرَأسِ نَهجٍ","قَطَعنَ وَما قَلِقنَ مِنَ السُؤومِ",2,"م",1,0],["وَأَبلَجَ لا يَرضى عَنِ العَجزِ رَأيُهُ","تُمَدُّ عَلى أَضوى مِنَ البَدرِ لُثمُهُ",3,"م",2,0],["وَاِبلُغ مِنَ النَيروزِ ما","يَبلُغُ مِنكَ الآمِلُ",4,"ل",1,0],["وَأَبلِغ عِمادَ الدينِ إِمّا بَلَغتَهُ","بِأَنَّ سِلاحَ اللَومِ عِندِيَ شاكُ",5,"ك",1,0],["وَأَبلَجَ أَعدَدتُهُ لِلخُطوبِ","طوداً إِلى ظِلِّهِ أَرجِعُ",6,"ع",1,0],["وَأَبلَجَ وَطّاءٍ عَلى خَدِّ لَيلِهِ","كَما فارَقَ النَصلَ المَضيَّ قِرابُ",7,"ب",1,0],["وأبْلَق شُغِفَتْ حُورُ العُيونِ بهِ","كأنّما عطَفَتْها نسبَةُ الحدَقِ",8,"ق",1,0],["وأبْلِغِ الأحْبابَ عنّي أنّنِي","فَجَأ البَيْنُ فؤادِي وفجَعْ",9,"ع",1,0],["وَأَبْلَغْتُ نَفسِي جُهْدَهَا غَيْرَ أَنَّنِي","طِلاَبِي مَا بَعْد النَّهَايَة أَعْيَانِي",10,"ن",2,0],["وابلُلّ بها رمق الأصيل عشيةً","والشمس من وعد الغروب على خطَرْ",11,"ر",1,0],["وأبْلَى جديد الغَيّ منهم برُشده","وجدّد رشداً عندهم كان باليا",12,"ي",2,0],["وَأَبلَيتُمُ في شَأنِ جِعثِنَ سَوأَةً","وَبانَ اِبنُ عَوّامٍ لَكُم غَيرَ حامِدِ",13,"د",1,0],["وَإِبلِيَ رَهنٌ أَن يَكونَ كَريمُه","عَقيراً أَمامَ البَيتِ حينَ أُثيرُها",14,"ر",3,0],["وأبلغ حارثاً عنا اعتذاراً","إليه بأن من قِبلي بجُهدِ",15,"د",1,0],["وَإِبلاً تُنزَعُ مِن رُعيانِها","حَتّى إِذا قَلَّ غَنا شُجعانِها",16,"ن",3,0],["وَأَبلِغ كُلَّ مُنتَخَبٍ هَواءٍ","رَحيبِ الجَوفِ مِن عَبدِ المَدانِ",17,"ن",1,0],["وَأَبلِغ أَبا سُفيانَ عَنّي رِسالَةً","فَما لَكَ مِن إِصدارِ عَزمٍ وَلا وَردُ",18,"د",1,0],["وإبليس لها يدعو","وللشيخ بتبريكِ",19,"ك",1,0],["وأَبلِغ لَدَيكَ مَعقِلَ بنَ خُوَيلِدٍ","مَلائِكَ يَهديها إِلَيكَ هُداتُها",20,"ت",3,1],["وَأَبلِغ بَني عَوذِ بنِ زَيدٍ رِسالَةً","بِآيَةِ ما إِن يَقصِبونِيَ يَكذِبوا",21,"ب",3,0],["وَأُبلغُ مِن دُنيايَ نَفسي سُؤلَها","وَأَضرِبُ في كُلِّ العُلا بِسِهام",22,"م",1,0],["وإبليس لا يأتي سوى ما أراده","لهم ربهم ذاك الذي دينه دين",23,"ن",1,0],["وأبلج في عنان الجود فرد","كمنزلة السموال لا يرام",24,"م",1,0],["وأبلغ عظيم الفرس أنى أصدّه","وأحمى على الأيام جارى وأمنع",25,"ع",1,0],["وابِلٌ سُقراطُ وَالشُجعانُ طَل","إِنَّما مَن يَنصُرُ الحَقَّ البَطَل",26,"ل",1,0],["وَأَبلَخَ يَعصي بِاِختِصاصي مُشيرَهُ","عَصَيتُ بِقَصديهِ مُشيري وَلوَّمي",27,"م",2,0],["وأبلغُ بالعُدمِ ما لا ينالُ","بفضلِ الثَّراءِ وحدِّ الحُسامِ",28,"م",1,0],["وأبلجُ أمّا وجهُه حين يُجْتَلى","فشمسٌ وأمّا كفُّه فغَمامُ",29,"م",1,0],["وأُبلِسُ حتى ما أبينُ كأنَّما","تدورُ بيَ الأرضُ الفضاءُ وأُصْعَقُ",30,"ق",1,0],["وأبْلَى بها الجُردُ العِتاقُ أجِلَّةً","عليهنَّ والصحبُ الكرامُ ثِيابَا",31,"ب",2,0],["وابَلائي مِن دَعاوى أَمَلٍ","كُلَّما قُلتُ تَدانى بَعُدا",32,"د",2,0],["وَأَبلَجُ قَد راعَ الزَمانَ سِياسَةً","وَشَنَّ عَلى أَموالِهِ غارَةً شَعوا",33,"و",2,0],["وَأَبلِغِ الرَملَةَ الأَنيقَةَ وَأَبلِغ","مَعشَراً لي بِرَبعِها وَأُهيلا",34,"ل",2,0],["وَأَبلِغِ المَلكَ ناصِرَ الدينِ شَوقي","ثُمَّ قَبِّل ثَراهُ بِالأَجفانِ",35,"ن",1,0],["وابلائي من لياليَّ التي","قرَّبَت حَيني وراحَت تبعدُك",36,"ك",1,0],["وَأَبلِغ سالِفاً حُلوى","إِلى قارِعَةِ النَخلِ",37,"ل",1,0],["وَأَبلَجَ مَنصورِ اللِواءِ إِذا سَرى","أَظَلَّت عُقابُ النَصرِ أَجنِحَةُ النَسرِ",38,"ر",1,0],["وَأَبلَقَ خَوّارِ العِنانِ مُطَهَّمٍ","طَويلِ الشَوى وَالساقِ أَقوَدَ أَتلَعا",39,"ع",2,0],["وَأَبلِغ قَطينَ الدارِ أَنّي أَُحِبُّهُ","عَلى النَأيِ حُبّاً لَو جَزاني بِهِ جَمّا",40,"م",2,0],["وَأَبلَيتُ آمالي بِوَصلٍ يَكُدُّها","وَلَيسَ بِذي ضَرٍّ وَلَيسَ بِذي نَفعِ",41,"ع",1,0],["وابَلائي مِن شادِنٍ","كَبَّرَ الحُبَّ إِذ كَبِر",42,"ر",1,0],["وابَلائي مِن مَحضَري وَمَغيبي","وَحَبيبي مِنّي بَعيدٌ قَريبُ",43,"ب",1,1],["وَاِبلُ لي مِن ذاكَ أَو لا تَلحَني","صَعِدَ الشَوقُ بِقَلبي وَاِنحَدَر",44,"ر",1,0],["وَأَبلى حُبُّهُ جِسمي","فَقَد ضِقتُ بهِ صَدرا",45,"ر",2,0],["وأَبلَجَ مِسهاءٍ كَأَنَّ لِسانَهُ","إِذا راحَ ذو النونَينِ بَل هُوَ أَقرَبُ",46,"ب",1,0],["وَأَبَلَّ يَلتَهِمُ الخُصومَ مُرَغَّمٍ","بِصَوابِ مَنطِقِهِ وَغَيرِ صَوابِهِ",47,"ب",2,0],["وَأَبْلَى النِّسَاءُ بَلاَءَ الرِّجَ","لِ لَدَى كُلِّ مُعْتَرَكٍ أَرْبَدِ",48,"د",1,0],["وَأَبْلَغَتْ كُلَّ ذِي أَنَاةٍ","تَطَلَّبَ الْحَقُّ مَا تَطَلَّبْ",49,"ب",1,0],["وَابْلُغِ الغَايَةَ التِي تَبتْغِيها","مِنْ فَخَارٍ حَقٍّ وَمِنْ عَلْيَاءِ",50,"ا",2,0],["وأَبْلِغْ أبا سفيانَ أنْ قَدْ بَدا لنا","بأحمدَ نورٌ من هُدَى اللهِ سَاطِعُ",51,"ع",1,0],["وإبِلي تأبَى صَرى الإخاذِ","فَرُعْ أساريبَ القَطا الشُّذاذِ",52,"ذ",1,0],["وَإِبلِيَ رَهنٌ أَن يَكونَ كَريمُها","عَقيراً أَمامَ البَيتِ حينَ أُثيرُها",53,"ر",3,0],["وأبلَغَه أنْ قد تَتَبَّع جهدَه","مواطنَ ضَعفِ الناقمين فخدَّرا",54,"ر",2,0],["وأبلغَ عنك الجَنوبُ الشَّمال","وعزَّى بك المُعرِقَ المُشئِم",55,"م",1,0],["وَابلّ الأُوام مِن رِيقِهِ العَذ","ب وَأَسقى مَن فيهِ راحاً شَهيّا",56,"ي",2,0],["وأبلقَ أعطى الليلَ نصفَ إهابِهِ","وغارَ عليه الصبحُ فاتحبسَ النصفا",57,"ف",2,0],["وَأَبلِغ لَدَيكَ بَني مازِنٍ","فَكَيفَ الوَعيدُ وَلَم تَقرِروا",58,"ر",3,0],["وَأَبلِغ نُمَيراً إِن مَرَرتَ بِدارِها","عَلى نَأيِها فَأَيُّ مَولىً وَطالِبِ",59,"ب",1,0],["وابلغ مشائخهم عنا السلام فما","تنسى مكانتهم منا مكارمنا",60,"ن",2,0],["وَأَبلغُ مِن قسٍّ وَسَحبانِ وائِلٍ","إِذا الشَّرُّ أَبدى كَالِحاً جُلَّ نابِهِ",61,"ب",2,0],["وابْلَجَّ فيها جَبينٌ مُبْهرٌ فَضَوى","كَفَجْرِ صُبْحٍ بُعيْدَ الدُّجْنَةِ انْبثقا",62,"ق",2,0],["وأبْلَجُ المْهْوِ مفتانٌ بِبَسْمَتِها","بَرَدٌ مُقيمٌ بِفيها فَرّ مِنْ خَفَرِ",63,"ر",1,0],["وأبليت جسمي في هواكم وأسهرت","جفوني أراعي الطيف في كل لحظة",64,"ه",1,0],["وَأبلغُ الناس إِذا تكلّما","محمّدُ الصاحبُ والصبيحُ",65,"ح",1,0],["وإبليس يعرف مَن رَبُّه","ولكنَّ طغيانه سرَّفه",66,"ف",2,0],["وَاِبلُغ بجدِّك ما تُريد نَوالَه","فَمُنى البَرِيَّة أن تَنال مُناكا",67,"ك",2,0],["وَاِبلِ جَديدَ البَقاءِ ضافِيَةً","عَلَيكَ مِنهُ مَلابِسُ النِعَمِ",68,"م",1,0],["وَأَبلَقٍ وَلَن يَرو","قَ العَينَ مِثلُ الأَبلَقِ",69,"ق",1,0],["وَأُبْ لِتُخْبِرَنَا فَتُحْبِرَنَا","بِمَا يُسِيمُ الْمُنَى فَيُمْجِدُهَا",70,"د",3,0],["وَأَبلَجَ مُشرِقِ الخَدَّينِ فَخمٍ","يُسَنُّ عَلى مَراغِمِهِ القَسامُ",71,"م",1,0],["وَأَبلج يَستَهينُ المَوتَ يَلقى","بِصَفحةِ وَجهِهِ حَدَّ الصِفاحِ",72,"ح",1,0],["وَأَبلَج مَعسولِ الشَمائِل ما جدٍ","خَلائِقُه تُسلي عَن المَنِّ وَالسَلوى",73,"و",2,0],["وَأَبلِغ أُنَيساً سَيِّدَ الحَيِّ أَنَّهُ","يَسوسُ أُموراً غَيرَها كانَ أَحزَما",74,"م",2,0],["وَأَبلِغ تَليداً إِن عَرَضتَ اِبنَ مالِكٍ","وَهَل يَنفَعَنَّ العِلمُ إِلّا المُعَلَّما",74,"م",2,0],["وأبلغ الكل منا","يا سَيدي ما يريد",75,"د",1,0],["وأَبلج يستسقى الغمامُ بوجههِ","كريم إذا ما الجدبُ ألقى المراسيا",76,"ي",2,0],["وإبليس لم يسجد فأسخط ربه","وحلت به من مقته شر لعنة",77,"ه",1,0],["وابلغي بي السماك","يا جمال الحياة",78,"ه",1,0],["وَابَلائي مِن قُدْرةٍ ليَ قَلَّتْ","فَلهذا قَدْ قَلَّ في النَّاسِ قَدْرِي",79,"ي",1,0],["وأَبْلَجُ لم تُخْلَقْ لشَيْئَيْنِ كَفُّه","لإحْسانِ إمْساكٍ وإمْساكِ إحْسان",80,"ن",1,0],["وأبلجُ من لغَطِ السّائلي","نَ لا بالمَلولِ ولا بالسَّؤوم",81,"م",1,0],["وابلُغْ به من يَفاعِ المَجدِ مُشتَرَفاً","واغضَبْ له من صُروفِ الدّهرِ مُمتَعِضا",82,"ض",2,0],["وأبلَجُ بالزُوّارِ غَصَّ فِناؤه","وهَيبتُه تُجَلِّي من الغابِ أُسده",83,"د",2,0],["وأبلَجُ أقْذَتْ خَلّتي عينَ فِكْرِه","فظَلَّ لرَيْبِ الدّهرِ فِيَّ يُعاتب",84,"ب",1,0],["وَأَبلى وَإِن لَم يَبلَ حُبّي فَإِنَّهُ","كَعَهدِكَ لَم يَشمَت بِهِ الدَهرُ بالِيا",85,"ي",2,0],["وَأَبلِغي قاتِلي برفقِ سَلامي","ثُمَّ حَيي عَني وَجوه الرِفاق",86,"ق",1,0],["وابليس صاحبه ماله منه ميل أوتباه","يلقيه في كل ورطه ذي تقطع عراه",87,"ا",2,0],["وَأَبلِغوا القَتلى بِأَرض الطفِّ","تَحيتي أَلفان بَعد أَلفِ",88,"ف",1,0],["وأبلغ السلاما","الملك الهماما",89,"م",2,0],["وأبلغ أخي عز الكمال ومن له","بقلبي محل لا يرى عنه خاليا",90,"ي",2,0],["وأبلغه عنا سلاماً واستمد لنا","منه الدعاء بتوفيق وغفران",91,"ن",1,0],["وأبلغ سيدي بدر المعالي","سلاماً لا يفارقه الدوام",92,"م",1,0],["وأبلغ المولى جمال الهدى","كذاك صِنْوَيْهِ وبَخْلَ العماد",93,"د",1,0],["وأبلغوا مولاي سامي الذرى","عز الهدى أسنى سلام يراد",93,"د",1,0],["وأبلهٍ وافى إلى حضرتي","ملتهباً من حره متقد",94,"د",1,1],["واُبلِغْ تَحيةَ نازحٍ قذَفَتْ به","أيدِي النّوَى في أسحَقِ الآفاقِ",95,"ق",1,0],["وأبلُغَ ما أنفَقْتُ في أمَلِي لَه","من العُمر عَشراً كلُّها لَي متُعِبُ",96,"ب",1,0],["وأبلجَ وضَّاح الدبين تخاله","تَبَلُّجَ صُبحٍ أو بصبحٍ تبرقعا",97,"ع",2,0],["وأبلجُ لولا شعره وجبينه","لما كنت أدري ما الضَّلال وما الهُدى",98,"د",2,0],["وأبلغ ما يكون به التَّمنِّي","دنوًّا من جنابك واقترابا",99,"ب",2,0],["وَأُبلِيٌّ إِلى الغَرّا","ءِ فَالمَأوان فَالحَجرُ",100,"ر",1,0],["وأبلجَ كالصباحِ أضاءَ منه","عمودٌ فاجتليناهُ عميدا",101,"د",2,0],["وا بلائي من مُخدّرةٍ","دونَها سورٌ وجُدْرانُ",102,"ن",1,0],["وأَبْلَيْتَهُ نُصْحَ جَيبٍ سَليمٍ","وفِيِّ الضَّمانِ بِنُصْحِ الجُيُوبِ",103,"ب",1,0],["وابلُغِ الغاياتِ مغبوطاً بِهَا","فِي ضمانِ الله بُقْيا واسْتَزِدْ",104,"د",1,0],["وأَبْلَجَ من قحطانَ قُربُكَ عِزُّهُ","ومُلكُكَ مَحْياهُ ونَصرُكَ مَجْدُهُ",105,"د",2,0],["وابلغ رجانا واتسجب لدعائنا","واقبل مناسكنا وعظم حجنا",106,"ن",2,0],["وأبلغ ما ألقى من الحب خلوةٌ","أرى الناس قلباً من فنون الهوى خلوى",107,"و",2,0],["وأبله لا تجد العينُ في","ه نهجاً يُقَصُّ بآثارهِ",108,"ر",2,0],["وأبلجُ سامي الطَّرف لا تستفزُّه ال","دَّنايا ولو زان الدَّنايا جمالُها",109,"ل",3,0],["وأبلج من عُليا عُقْيل يَسرُه","حميد المساعي والنَّدى والتكرُّم",110,"م",1,0],["وأبْلَجُ مِتلافٌ كأنَّ نوالَهُ","تحدر سيل من ذرى الطَّود مزبد",111,"د",1,0],["وأبلجُ جادتْ أصْفهانُ بفضلِه","رحيبُ الفِنا والخُلق أفضى وأرحب",112,"ب",1,0],["وأبْلَجُ فَيَّاضُ النَّوالِ مُمجدٌ","يُخالُ الحيَا من وجههِ ويُشامُ",113,"م",1,0],["وأبْلَجَ سَمْحٍ من ذؤابة خندفٍ","لهُ من عُلاهُ صَفْوهُ ولُبابُ",114,"ب",1,1],["وَأَبلِغ سَلامانَ إِن جِئتَها","فَلا يَكُ شِبهاً لَها المِغزَلُ",115,"ل",1,0],["وأبلج كالصبح الأغر جبينه","ضياء وكالليل البهيم عساكره",116,"ر",2,0],["وابْلُلْ بِوَبْلِ الفَضْلِ رِدْنَ عَفَافَتي","واسْبِلْ عَلَيَّ مِنَ السُّتُورِ ذُيولا",117,"ل",2,0],["وابلُغْ إلى الغَايَة فالجَمْع فال","مِعْيار أن تَفْهَمَ ما حَرِّرا",118,"ر",2,0],["وأبلجَ وضَّاحَ المُحَيَّا إذا بَدا","دُجى مُدلَهمَّاتِ الخُطوب يَلُح فَجرا",119,"ر",2,0],["وإبليس اللعين أبى سجوداً","لديه فلم يجد أحداً معينا",120,"ن",2,0],["وأَبلغِ ما تُقَلِّبُهُ قُلوبٌ","وأفَصَحِ ما تَفُوهُ بهِ الشِفاهُ",121,"ا",2,0],["وأَبلغُ القصدَ بِقَصْدِي لَه","وإِنَّه للقصدِ بيتُ القصيدْ",122,"د",1,0],["وأبلغه تسليماً على البعد والنوى","سلام بحب صادق الود حامد",123,"د",1,0],["وأبلغ هداك الله مني تحية","إلى الشيخ عبد الله من كان أوحدا",124,"د",2,0],["وأبلغه تسليماً على البعد والنوى","وإن كان لا يجيد لدى من توجدا",124,"د",2,0],["وأبلغ يا أخي سعداً جهاراً","تحيات مباركة جساما",125,"م",2,0],["وأبلَجُ ما مِن آلهِ وقَبيلِه","عَلى قِلَّةِ السّاداتِ مَن لَم يُسوَّد",126,"د",1,0],["وأبلَج هامي الكفِّ في كُلِّ بقعة","من الأرض مِنه رَوضةٌ وغديرها",127,"ر",3,0],["وأبلجُ ما لَهُ في النّاسِ كُفؤُ","يُماثِلَهُ وَلا لأَبَيهِ كُفؤ",128,"ف",2,0],["وأبلجُ كفُّه يَهمي نَضارا","عَلى العافي بِلا بَرقٍ ورَعد",129,"د",1,0],["وِأبلجُ ضَوءُ الشمسِ مِن نُورِ وجههِ","كَوجهِ السُّها في ضَوئها والفَراقِد",130,"د",1,0],["وأبلُجُ من بني يَعقوبَ أسُّ","لِمكرُمَةٍ لَها أهلُوهُ أسُّ",131,"س",1,0],["وأبلَجُ يَغشَى الوَفدَ عِندَ سِماطِه","سِماطُ مُطيبٍ لِلخَلائِق مُكثِر",132,"ر",1,0],["وأبلغ سرّي الخلال أنّي","جيت بما قد رأى وفاقه",133,"ق",2,0],["وَابلغ نِهاية ما تَروم ممتَّعاً","فيها بِحُسن ختامك المَأجور",134,"ر",1,0],["وَابلغوا شَأو الأَماني","تَحتَ أَعلام الأَمانِ",135,"ن",1,0],["وَأَبلغ ما أَمّلت فيك وَلم أَكُن","لَدَيك كَمَن ضاقَت عَلَيهِ مَذاهب",136,"ب",1,0],["وَإِبليس لَما هَلكت بَكى","عَلَيكَ وَضاقَ بِهِ الفدفد",137,"د",1,0],["وأُبْلغُ الخَدَّ من تَعفيرهِ وَطراً","شَوقاً لِمَوطئ نَعْلٍ طاهرٍ قُدُسي",138,"س",2,0],["وأبلغ روزفلت ما حدثا","بلاء دها الشيخ والحدثا",139,"ث",2,1],["وابلغ مكانك في السماء وفي النهى","ليراك بدراً من رآك هلالا",140,"ل",2,0],["وأبلغ الأم هذا الأمر يكبره","فاستعطفته فأخفى الغيظ والغضبا",141,"ب",2,0],["وابلٌ من تقى هزيمُ الشآبي","ب إذا الأتقياءُ كانوا طِشاشا",142,"ش",2,0],["وابلائي من طول هذا الكتاب","أسعدوني عليه يا أصحابي",143,"ب",2,1],["وأْبلوجاً بماء الوردِ","شِيبَ وبارد القطْر",144,"ر",1,0],["وَأَبْلِغْ سَلاَمِي سَكِنَ الْبَانِ وَالنَّقَا","سَلُوا عَنْ نُحُولي هَجْرَهَا فَهْوَ مُسْقِمِي",145,"ي",1,0],["وأبلق وضاح وأشهب ناصل","وأخضر داجي وأبيض ناصع",146,"ع",1,0],["وابلغاني لحي ليل فقلبي","من ركون الضلوع للحي طارا",147,"ر",2,0],["وأبلج مثل نصل السيف ضرب","حديد مضارب الرأي الزكي",148,"ي",1,0],["وَأَبلَيتُكُم مالاً يُضَيَّعُ مِثلُه","وَآسَيتُكُم وَالأَمرُ صَعبٌ مَراتِبُه",149,"ب",2,0],["وابلغ ونل كل المنا من كلما","تبغيه واغنم منه خير المغتنمْ",150,"م",1,0],["وابلغ الخمار عنا","من صلاة وسلام",151,"م",1,0],["وأبلغُ من عبدِ الحميدِ وجعفرٍ","ويحيى وإسماعيلَ أعني ابنَ عبادِ",152,"د",1,1],["وأبلج مخضرُّ الخوان يمينه","تزيل عن المسترفدين افتقارها",153,"ر",3,0],["وابْلُغْ أبا العَرَبِ المأمولَ شاملةً","لك السَّعادةُ بينَ الأهلِ والنَسَبِ",154,"ب",1,0],["وأبلجَ من بني عمرٍ جوادٍ","صَفت أخلاقه صفوَ اللُّجين",155,"ن",1,0],["وَابلائى من فاتن الطّرف أحوى","من كحيلٍ طبعاً بغيرِ اكتحالِ",156,"ل",1,0],["وَأَبلغ أَبا العاصي وَلا تَنسَ زَمعَةً","وَمطعم لا تَنسَ لِجامَ المُشاغِبِ",157,"ب",1,0],["وأبلغ سَلامي سيِّدي خيرَ سيِّدٍ","نَمتهُ إِلى العليا جَهابذَةٌ زُهرُ",158,"ر",1,0],["وَأُبَلِّغ المختارَ عَن فَرعٍ لَهُ","أَزكى السَلامَ تَضَوُّعاً وَتَعَطُّرا",159,"ر",2,0],["وأبلغ من أملى وأفصح من روى","وأصدق من آخى وأكرم من أولى",160,"ل",2,0],["وابلغ مناك فأوقات الصفا فرض","وأنت ناه لهذا الدهر آمره",161,"ر",2,0],["وابلغ أحبابنا النزاح","من حليفِ الوفا الأكيد",162,"د",1,0],["وَأَبلَجُ وَقّادُ الجَبين كَأَنَّما","عَلى وَجنَتيهِ للنُضار مَسيلُ",163,"ل",1,0],["وأبله بالمزَيّن حيث أهوى","ليقلم من جنان الحسن غصنا",164,"ن",2,0],["وأَبلَج يَلهُو بالمَعالِي برَاعَةً","فَتَدرِي المَعالي أَنَّ شِيمَتَهُ جدُّ",165,"د",1,0],["وَأَبلَجٌ مِثلُ الصَباحِ رُؤيَتُهُ","تَشفي حَليفَ السَقامِ مِن سَقَمِه",166,"م",2,0],["وابْلِغْ، هُدِيتَ، سلامي","شموسَه والأهِلَّهْ",167,"ل",2,0],["وأبليتُ التصبر فيك لما","بليتُ بسحرِ طرفٍ بابليِّ",168,"ي",1,0],["وأبل ما بي من أوار مطالب","نيرانها في الصبر ذات تضرم",169,"م",1,0],["وَأَبلَجَ مِن آلِ المُثَنّى تَأَلَّفَت","لِناسِبِهِ شُهبُ العُلى وَبُدورُها",170,"ر",3,0],["وَأَبلَجَ أَحيا دارِسَ العَدلِ بَعدَما","ثَوى وَشَقى المَعروفَ مِن بَعدِ ما أَشفى",171,"ف",2,0],["وَأَبلَجَ مِنهُم بَغوا شَأوه","وَقَد فاتَ شارِدَةَ الأَربَعِ",172,"ع",1,0],["وابِلُ الفَيضِ اللَدُنىّ تدانى","فَوقَ أحوالى فقاست فى نموّ",173,"و",1,0],["وأبلغ حدّ الجهد والجهد غاية","وما بعدها الا التماس المعاذر",174,"ر",1,0],["وأبلجُ من عدنان تُرْبُ بلاده","تُقبِّله سُكانُ كلِّ بلاد",175,"د",1,0],["وأبليت خيراً في الحياة وإنما","ثوابك عندي اليوم أن ينطق الشعر",176,"ر",1,0],["وأبلغونى أموراً ما اقتنعتُ بها","حتى اذا عثرت بى عدت مقتنعا",177,"ع",2,0],["وأبلغُ من ذُلِّ السؤال شكايةٌ","ترى العزَّ طيَّ الفقرِ فيها مجسَّدا",178,"د",2,0],["وأبلغه يا صاح ! من عبده","سلام محب تنائى ديارا",179,"ر",2,0],["وَأَبلِ بِوالِدَيكَ الدَهرَ صَفواً","وَعيشوا في السُرورِ وَفي الصِلاتِ",180,"ت",1,0],["وَأَبلى الجَديدَينِ رافَعَ حانٍ","مَهيضِ الحَنايا مِنَ المرهقِ",181,"ق",1,0],["وَأَبلَقَ مِن شَرطِ الكميِّ لزينةٍ","وَإِحراز ميدانٍ وَيَومِ ق