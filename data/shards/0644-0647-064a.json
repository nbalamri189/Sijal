{"poems":[[9,"عرفت اليوم من تيا مقاما","https://www.aldiwan.net/poem21982.html","الوافر"],[47,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[72,"صرفت فعلي في الأسى وقولي","https://www.aldiwan.net/poem20616.html","الرجز"],[29,"عفا ممن عهدت به حفير","https://www.aldiwan.net/poem6048.html","الوافر"],[78,"سكن فؤادك لا تذهب به الفكر","https://www.aldiwan.net/poem14154.html","البسيط"],[89,"فيك المدائح تحلو","https://www.aldiwan.net/poem44969.html","المجتث"],[45,"أجدك إن لمات الخيال","https://www.aldiwan.net/poem65568.html","الطويل"],[28,"فقلت للنفس هذي منية صدقت","https://www.aldiwan.net/poem5099.html","البسيط"],[28,"أهاج لك الشوق القديم خياله","https://www.aldiwan.net/poem5604.html","الطويل"],[66,"لم أدر أن نبال الغنج والكحل","https://www.aldiwan.net/poem38479.html","البسيط"],[66,"نم بسر الروض خفق الرياح","https://www.aldiwan.net/poem41356.html","الرجز"],[44,"أجل أيها الربع الذي خف آهله","https://www.aldiwan.net/poem30388.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85837","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85541","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54771","المتقارب"],[45,"قِفَا في مَغاني الدّارِ نَسألْ طُلُولَها","https://www.poetsgate.com/ViewPoem.aspx?id=32118",""],[28,"أهاج لك الشوق القديم خياله","https://www.poetsgate.com/ViewPoem.aspx?id=21005",""],[141,"ليهنك ما أنالتك الجدود","https://www.aldiwan.net/poem11748.html","الوافر"],[141,"ليهنك ما شادت لك الهمم العلا","https://www.aldiwan.net/poem11807.html","الطويل"],[148,"لعمري لقد ذقت الهوى فوجدته","https://www.aldiwan.net/poem68554.html","الطويل"],[148,"صبوت إلى الدنيا وذو اللب لا يصبوا","https://www.aldiwan.net/poem68604.html","الطويل"],[210,"ما بال قلبك لا ينفك من سقم","https://www.aldiwan.net/poem37833.html","البسيط"],[233,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[250,"يحملني مالا أطيق فأحمل","https://www.aldiwan.net/poem1422.html",""],[268,"هيجت من أبلغ اللذات أذكارا","https://www.aldiwan.net/poem35465.html","البسيط"],[268,"شربناها على ذكر الوليد","https://www.aldiwan.net/poem35590.html","الوافر"],[295,"سريرة شوق في الهوى من أذاعها","https://www.aldiwan.net/poem33229.html","الطويل"],[295,"يا حادي الظعن إن جزت المواقيتا","https://www.aldiwan.net/poem33317.html","البسيط"],[301,"له يراع متى هزته راحته","https://www.aldiwan.net/poem57709.html","البسيط"],[324,"وكيف تخاف من بؤس بدار","https://www.aldiwan.net/poem44276.html","الوافر"],[359,"هي الليالي فلا تغتر بالامل","https://www.aldiwan.net/poem68072.html","البسيط"],[362,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[362,"إذا لم تقدرا أن تسعداني","https://www.aldiwan.net/poem60633.html","الوافر"],[362,"ألحظ في جفونك أم صوارم","https://www.aldiwan.net/poem60650.html","الوافر"],[362,"أشاكر أنا للأيام أم شاك","https://www.aldiwan.net/poem60816.html","البسيط"],[362,"لولا طروق خيال منك منتظر","https://www.aldiwan.net/poem60919.html","البسيط"],[362,"ألم صبحا وجمر الحلي قد بردا","https://www.aldiwan.net/poem60940.html","البسيط"],[362,"دام علاء العماد","https://www.aldiwan.net/poem60952.html","مجزوء السريع"],[362,"أنصر أخاك مسعدا في ما حزب","https://www.aldiwan.net/poem60999.html","الطويل"],[369,"أتانا بها كالنار من قبل مزجها","https://www.aldiwan.net/poem57520.html","الطويل"],[390,"مشيب عراه لو يدوم مشيب","https://www.aldiwan.net/poem53654.html","الطويل"],[403,"ألم خاليها بعد الهجوع","https://www.aldiwan.net/poem50149.html","الوافر"],[429,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[429,"لمن ربوع مقفرات باللوى","https://www.aldiwan.net/poem12472.html","الرجز"],[429,"الحمد لله ليس لي نشب","https://www.aldiwan.net/poem12540.html","المنسرح"],[434,"لهيب جوى قد أضمرته ضلوعه","https://www.aldiwan.net/poem2540.html","الطويل"],[459,"خليلي من عليا تميم بن خندف","https://www.aldiwan.net/poem15305.html","الطويل"],[462,"أما الديار فتلك عين ظبائها","https://www.aldiwan.net/poem3213.html","عموديه"],[513,"لولا جفون ومقل","https://www.aldiwan.net/poem12209.html","مجزوء الكامل"],[560,"أتدري ما بقلبك من جراح","https://www.aldiwan.net/poem52911.html","الوافر"],[560,"قد أشرق النور أكناف لبنان","https://www.aldiwan.net/poem52928.html","البسيط"]],"verses":[["لَهُ يَومانِ يَومُ لِعابِ خَودٍ","وَيَومٌ يَستَمي القُحَمَ العِظاما",0,"م",2,0],["لَهُ يَومَ عَدلٍ مَوقِفٌ بَل مَواقِفٌ","رَدَدنا إِلَينا العِزَّ وَالعِزُّ نافِرُ",1,"ر",1,0],["له يراع كم له في خطرهِ","حماية منظومة مع درَّه",2,"ه",1,0],["لَهُ يَومانِ يَومُ قِراعِ كَبشٍ","وَيَومٌ يُستَظَلُّ بِهِ مَطيرُ",3,"ر",1,0],["لَهُ يَدٌ كُلُّ جَبّارٍ يُقَبِّلها","لَولا نَداها لَقُلنا إِنَّها الحَجَرُ",4,"ر",1,0],["له يدٌ ونوالٌ","هما سحاب ووبل",5,"ل",1,0],["لَهُ يَومُ الثَنِيَّةِ حينَ يَثني","بِكَرَّتِهِ مُسَدَّدَةَ العَوالي",6,"ي",1,0],["لَهُ يَدٌ يَغلِبُ المُعطينَ نائِلُها","إِذا تَرَوَّحَ لِلمَعروفِ أَو بَكَرا",7,"ر",2,0],["لَهُ يَومُ سَوءٍ لَيسَ يُخطِئُ حَظُّهُ","وَيَومٌ تَلاقى شَمسُهُ بِنَعيمِ",8,"م",1,0],["لَهُ يَراعٌ وَعَضبٌ ما جَرى وَبَرى","إِلّا قَضى وَمَضى بِالرِزقِ وَالأَجَلِ",9,"ل",1,0],["لَهُ يَدٌ إِن جادَ كانَت حَياً","وَهِمَّةٌ إِن جالَ كانَت سِلاح",10,"ح",1,0],["لُهىً تَستَثيرُ القَلبَ لَولا اِتِّصالُها","بِحُسنِ دِفاعِ اللَهِ وُسوِسَ سائِلُه",11,"ل",2,0],["له يدان ولكن","كلتا يديه يمين",12,"ن",1,0],["لَهي المساعي بعد أن","تلقى العناية تثمرُ",13,"ر",1,1],["لهيبٌ إذا الرُّوحُ مرَّتْ بهِ","تضاعفتِ الرُّوحُ في نارهِ",14,"ه",1,0],["لَهِيبُ الحُرُوبِ عَلَى وَجْنَتَيْ","هِ وَالنَّقْعُ فِي شَعْرَهِ الأَسْوَدِ",15,"د",1,0],["لُهًى سَوَّدْتْهُ دُونَ قَوْمٍ ،وَلَمْ يَدَعْ","جَوادُ الرِّجالِ أَنْ يَسُودَ بَخِيلَهَا",16,"ل",3,0],["لهُ يَوْمُ سَوْءٍ ليْسَ يُخطىءُ حظُّه،","وَيَوْمُ تَلاقَى شَمْسُهُ بِنَعِيمِ",17,"م",1,0],["لُهىً كادَت عَدُوَّهُمُ وَكادَت","تَضيقُ بِها التَهائِمُ وَالنُجودُ",18,"د",1,0],["لُهىً فَتَحَت بابَ المُنى فَدَخَلتُهُ","وَقَد كانَ باباً لَم أَجِد فيهِ مَدخَلا",19,"ل",2,0],["لَهِيبُ الأسَى بَينَ الجَوانحِ لائحٌ","فَدَمعِيَ لا يَرقَا وقَلبِيَ لا يَسلُو",20,"ل",2,0],["لَهُ يَقرُبُ المَرمى وَتَرتَفِعُ الحُجبُ","فأَعظِم بِرِفدٍ مِنهُ قَد صابَ عُرفُه",21,"ه",1,0],["له يَدٌ تَتْرُكُ الأقلامَ نابيةً","عن النَوَالِ وأمّا السَيْفُ لِلنِقَمِ",22,"م",1,0],["لَهُ يَدٌ لَو صافَحَت","أَراكَةً لَم تورِقِ",23,"ق",1,0],["لَهُ يَومَ انعامِ وَبؤسٍ كِلاهُما","أَغَرُّ إِذا الأَيّام عُدَّت مُحَجَّلُ",24,"ل",1,0],["لهيبُهُ لاحَ فيها فالتَظَت كبدي","لا بِدع إن أشكُ إحراقاً وإحرارا",25,"ر",2,0],["له يومٌ ولي أيامُ بؤسٍ","بها اشتُقّ الأشدُّ من الشَّديد",26,"د",1,0],["له يدُ فَضلٍ لا تُبارى سَماحةً","إِذا ما نَبا غيثٌ رجون اِندفاعَها",27,"ع",3,0],["له يَدٌ لا نُرجّي غيرَ نائِلها","وَقاصدُ البحر لا يَرجو الهراميتا",28,"ت",2,0],["له يراع متى هزته راحته","رقى إلى مجده من درجه درجا",29,"ج",2,1],["لَهُ يَومانِ يَومُ نَدىً وَبَأسٍ","كَأَنَّ الدَهرَ بَينَهُما أَسيرُ",30,"ر",1,0],["لَهُ يَد وردت بَحر الهُدو وَرَوَت","حَديثه عَن فُنون السادَة الاول",31,"ل",1,0],["لَهُ يَدٌ مِنها الأَيادي تَسجُمُ","يَصغَرُ عَنها البَحرُ وَهيَ تَعظُمُ",32,"م",1,0],["له يومان يومٌ للعَطايا","يُفَرِّقُها ويومٌ للطّعان",33,"ن",1,0],["له يدُ واهبٍ ومقالُ وافٍ","وَقلْبُ مُشيَّعٍ وفَعالُ حازم",34,"م",1,0],["له يَدٌ تُعمِلُ الأفلاكَ دائرةً","فلا اعْتَراها بسُوءٍ دَوُْر أفلاك",35,"ك",1,0],["له يدٌ خُلِقَتْ للجودِ فهْو لَها","طبعٌ كما خُلِقَ العينانِ للنَّظَر",36,"ر",1,0],["له يَراعٌ يُراعُ الدّارعون له","يَثْني مُتون الأعادي والقَنا قِصَدا",37,"د",2,0],["له يَدٌ لم تَزلْ","تَصْدُرُ منها أياد",38,"د",1,0],["له يَدٌ آثارُها عُلوّيةٌ","قَطْرٌ إذا جادَ وبَرْقٌ إن كتب",39,"ب",1,0],["لهيبُ قلوب الشّرب يطفى بشُربها","ويُخشى على أيديهُمُ من لَهيبِها",40,"ه",2,0],["لَهيبٌ بِقَلبي حينَ أَذكرُ كَربلا","فَيهلكني بَعد النَحيبِ نَحيبُ",41,"ب",1,0],["لَهُ يَدُ مُحسِنٍ وَحياء جانٍ","وجود مبَذِّرٍ وَعُلى جُموعِ",42,"ع",1,0],["لهيبُ صواعِقِ العَزَمَاتِ مِنْهُ","يكاد يُذيبُ أَفئِدَةَ الصُّخورِ",43,"ر",1,0],["له يدٌ طالت الى هام العُلى","إذا انثَنَتْ عن نيلها أيدي الورى",44,"ا",1,0],["له يدٌ تسكبُ النوالَ كما","تسكُب في الأرض ماءَها السحُب",45,"ب",1,0],["لهيب جوى قد أضمرته ضلوعهُ","وسرّ هوى تمت عليه دموعهُ",46,"ع",2,1],["لهيفاءَ مِقْلاقِ الوشاحِ قَوامُها","لعوبٌ كمتن الصَّعدةِ المُتناسقِ",47,"ق",1,0],["لهي السماء فرعت هضب سماكها","لا جاهداً ورفعت سمك بنائها",48,"ا",3,0],["له يد سلطانها","بحولها لا بالحيل",49,"ل",1,0],["لهَيبَتِهِ شكائمُ في الرَّعايا","تَرُدُّ الجامِحينَ عن الجِماحِ",50,"ح",1,0],["لهُ يليقُ بِساطُ الرِّيحِ في سَفَرٍ","لأنَّهُ ليسَ أدنى من سُليمانِ",51,"ن",1,0]]}