ttps://poetry.dctabudhabi.ae/diwan/poem/105176","الوافر"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136440",""],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204356","البسيط"],[4680,"لهيب الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=185088",""],[4767,"مولد الانتصار","https://www.poetsgate.com/ViewPoem.aspx?id=179794",""],[4578,"بروح العلا بالسعد أبدت سماؤها","https://www.poetsgate.com/ViewPoem.aspx?id=49341",""],[3591,"هي الحسان أراقت مهجة البطل","https://www.poetsgate.com/ViewPoem.aspx?id=149410",""],[5127,"مَرَّ الصبا فَتَحَرَّكَ الإلهامُ","https://www.poetsgate.com/ViewPoem.aspx?id=177447",""],[5273,"الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=28764",""],[5277,"سيدةُ المدائن","https://www.poetsgate.com/ViewPoem.aspx?id=200484",""],[5431,"الأنثى(الكلبة)...","https://www.poetsgate.com/ViewPoem.aspx?id=212495",""],[5436,"لهيب الثأر ماخمدا / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177642",""],[5626,"أنّاتُ عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=189718",""],[5690,"لهيكل الفضل أهدي النذر ملتمساً","https://www.poetsgate.com/ViewPoem.aspx?id=172220",""],[5704,"لهيبُ الروح","https://www.poetsgate.com/ViewPoem.aspx?id=192688",""],[5830,"أَسَاحِرَةَ العُيُونِ","https://www.poetsgate.com/ViewPoem.aspx?id=201193",""],[5910,"في وصفِ يومٍ حارٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=206236",""],[6004,"شَكوَى الحَمَامِ","https://www.poetsgate.com/ViewPoem.aspx?id=71984",""],[6031,"وحَالقٍ أَصْبَحَ في","https://www.poetsgate.com/ViewPoem.aspx?id=46360",""],[6147,"حنين إلى الفار المخلوع","https://www.poetsgate.com/ViewPoem.aspx?id=151693",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""],[6318,"القدس في خطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66164&r=&rc=14",""]],"verses":[["لَهُ يَومانِ يَومُ لِعابِ خَودٍ","وَيَومٌ يَستَمي القُحَمَ العِظاما",0,"م",2,0],["لَهُ يَومَ عَدلٍ مَوقِفٌ بَل مَواقِفٌ","رَدَدنا إِلَينا العِزَّ وَالعِزُّ نافِرُ",1,"ر",1,0],["له يراع كم له في خطرهِ","حماية منظومة مع درَّه",2,"ه",1,0],["لَهُ يَومانِ يَومُ قِراعِ كَبشٍ","وَيَومٌ يُستَظَلُّ بِهِ مَطيرُ",3,"ر",1,0],["لَهُ يَدٌ كُلُّ جَبّارٍ يُقَبِّلها","لَولا نَداها لَقُلنا إِنَّها الحَجَرُ",4,"ر",1,0],["له يدٌ ونوالٌ","هما سحاب ووبل",5,"ل",1,0],["لَهُ يَومُ الثَنِيَّةِ حينَ يَثني","بِكَرَّتِهِ مُسَدَّدَةَ العَوالي",6,"ل",2,0],["لَهُ يَدٌ يَغلِبُ المُعطينَ نائِلُها","إِذا تَرَوَّحَ لِلمَعروفِ أَو بَكَرا",7,"ر",2,0],["لَهُ يَومُ سَوءٍ لَيسَ يُخطِئُ حَظُّهُ","وَيَومٌ تَلاقى شَمسُهُ بِنَعيمِ",8,"م",1,0],["لَهُ يَراعٌ وَعَضبٌ ما جَرى وَبَرى","إِلّا قَضى وَمَضى بِالرِزقِ وَالأَجَلِ",9,"ل",1,0],["لَهُ يَدٌ إِن جادَ كانَت حَياً","وَهِمَّةٌ إِن جالَ كانَت سِلاح",10,"ح",1,0],["لُهىً تَستَثيرُ القَلبَ لَولا اِتِّصالُها","بِحُسنِ دِفاعِ اللَهِ وُسوِسَ سائِلُه",11,"ل",2,0],["له يدان ولكن","كلتا يديه يمين",12,"ن",1,0],["لَهي المساعي بعد أن","تلقى العناية تثمرُ",13,"ر",1,1],["لهيبٌ إذا الرُّوحُ مرَّتْ بهِ","تضاعفتِ الرُّوحُ في نارهِ",14,"ه",1,0],["لَهِيبُ الحُرُوبِ عَلَى وَجْنَتَيْ","هِ وَالنَّقْعُ فِي شَعْرَهِ الأَسْوَدِ",15,"د",1,0],["لُهًى سَوَّدْتْهُ دُونَ قَوْمٍ ،وَلَمْ يَدَعْ","جَوادُ الرِّجالِ أَنْ يَسُودَ بَخِيلَهَا",16,"ل",3,0],["لهيب من الذكرى وحقّك لا يخبو","متى يتلاقى بعد نأيهم الصحب",17,"ب",1,1],["لهُ يَوْمُ سَوْءٍ ليْسَ يُخطىءُ حظُّه،","وَيَوْمُ تَلاقَى شَمْسُهُ بِنَعِيمِ",18,"م",1,0],["لُهىً كادَت عَدُوَّهُمُ وَكادَت","تَضيقُ بِها التَهائِمُ وَالنُجودُ",19,"د",1,0],["لُهىً فَتَحَت بابَ المُنى فَدَخَلتُهُ","وَقَد كانَ باباً لَم أَجِد فيهِ مَدخَلا",20,"ل",2,0],["لَهِيبُ الأسَى بَينَ الجَوانحِ لائحٌ","فَدَمعِيَ لا يَرقَا وقَلبِيَ لا يَسلُو",21,"ل",2,0],["لَهُ يَقرُبُ المَرمى وَتَرتَفِعُ الحُجبُ","فأَعظِم بِرِفدٍ مِنهُ قَد صابَ عُرفُه",22,"ه",1,0],["له يَدٌ تَتْرُكُ الأقلامَ نابيةً","عن النَوَالِ وأمّا السَيْفُ لِلنِقَمِ",23,"م",1,0],["لَهُ يَدٌ لَو صافَحَت","أَراكَةً لَم تورِقِ",24,"ق",1,0],["لَهُ يَومَ انعامِ وَبؤسٍ كِلاهُما","أَغَرُّ إِذا الأَيّام عُدَّت مُحَجَّلُ",25,"ل",1,0],["لهيبُهُ لاحَ فيها فالتَظَت كبدي","لا بِدع إن أشكُ إحراقاً وإحرارا",26,"ر",2,0],["له يومٌ ولي أيامُ بؤسٍ","بها اشتُقّ الأشدُّ من الشَّديد",27,"د",1,0],["له يدُ فَضلٍ لا تُبارى سَماحةً","إِذا ما نَبا غيثٌ رجون اِندفاعَها",28,"ع",3,0],["له يَدٌ لا نُرجّي غيرَ نائِلها","وَقاصدُ البحر لا يَرجو الهراميتا",29,"ت",2,0],["له يراع متى هزته راحته","رقى إلى مجده من درجه درجا",30,"ج",2,1],["لَهُ يَومانِ يَومُ نَدىً وَبَأسٍ","كَأَنَّ الدَهرَ بَينَهُما أَسيرُ",31,"ر",1,0],["لَهُ يَد وردت بَحر الهُدو وَرَوَت","حَديثه عَن فُنون السادَة الاول",32,"ل",1,0],["لَهُ يَدٌ مِنها الأَيادي تَسجُمُ","يَصغَرُ عَنها البَحرُ وَهيَ تَعظُمُ",33,"م",1,0],["له يومان يومٌ للعَطايا","يُفَرِّقُها ويومٌ للطّعان",34,"ن",1,0],["له يدُ واهبٍ ومقالُ وافٍ","وَقلْبُ مُشيَّعٍ وفَعالُ حازم",35,"م",1,0],["له يَدٌ تُعمِلُ الأفلاكَ دائرةً","فلا اعْتَراها بسُوءٍ دَوُْر أفلاك",36,"ك",1,0],["له يدٌ خُلِقَتْ للجودِ فهْو لَها","طبعٌ كما خُلِقَ العينانِ للنَّظَر",37,"ر",1,0],["له يَراعٌ يُراعُ الدّارعون له","يَثْني مُتون الأعادي والقَنا قِصَدا",38,"د",2,0],["له يَدٌ لم تَزلْ","تَصْدُرُ منها أياد",39,"د",1,0],["له يَدٌ آثارُها عُلوّيةٌ","قَطْرٌ إذا جادَ وبَرْقٌ إن كتب",40,"ب",1,0],["لهيبُ قلوب الشّرب يطفى بشُربها","ويُخشى على أيديهُمُ من لَهيبِها",41,"ه",2,0],["لَهيبٌ بِقَلبي حينَ أَذكرُ كَربلا","فَيهلكني بَعد النَحيبِ نَحيبُ",42,"ب",1,0],["لَهُ يَدُ مُحسِنٍ وَحياء جانٍ","وجود مبَذِّرٍ وَعُلى جُموعِ",43,"ع",1,0],["لهيبُ صواعِقِ العَزَمَاتِ مِنْهُ","يكاد يُذيبُ أَفئِدَةَ الصُّخورِ",44,"ر",1,0],["له يدٌ طالت الى هام العُلى","إذا انثَنَتْ عن نيلها أيدي الورى",45,"ا",1,0],["له يدٌ تسكبُ النوالَ كما","تسكُب في الأرض ماءَها السحُب",46,"ب",1,0],["لهيب جوى قد أضمرته ضلوعهُ","وسرّ هوى تمت عليه دموعهُ",47,"ع",2,1],["لهيفاءَ مِقْلاقِ الوشاحِ قَوامُها","لعوبٌ كمتن الصَّعدةِ المُتناسقِ",48,"ق",1,0],["لهي السماء فرعت هضب سماكها","لا جاهداً ورفعت سمك بنائها",49,"ا",3,0],["له يد سلطانها","بحولها لا بالحيل",50,"ل",1,0],["لهَيبَتِهِ شكائمُ في الرَّعايا","تَرُدُّ الجامِحينَ عن الجِماحِ",51,"ح",1,0],["لهُ يليقُ بِساطُ الرِّيحِ في سَفَرٍ","لأنَّهُ ليسَ أدنى من سُليمانِ",52,"ن",1,0],["لَهُ يُبقيك رَبُّك في نَعيم","وَسَعد لا يُفارقه سَداد",53,"د",1,0],["لُهَىً يُلْهيننا عن أهلِ عصرٍ","تُناط لهاهُمُ بلهى السِّباع",54,"ع",1,0],["لَهُ يُحاكُ عَلى نَوْلِ العُلى شرفٌ","مِن جَوهَرِ المَجدِ مَنسوجٌ وموضونُ",55,"ن",1,0],["لهيب الخد حين بدا لعيني","هفا قلبي عليه كالفراش",56,"ش",1,1],["لَهِيبُ مَشُوقِ لَذَّ فِيهِمْ حِمَامُهُ","وَيَا حَبَّذَا إنْ كَانَ يُرْضِيهمُ قَتْلي",57,"ي",1,0],["لِهَيْبَتِهِ ذَلَّتْ رِقَابُ الْقَبَائِلِ","مِنَ الشِّرْكِ لَمَّا أنْ تَمَادَتْ عَلىَ الْجَهْلِ",57,"ل",1,0],["لهُ يَقَظاتٌ للتنبيه في العُلا","قليلُ الكرى والقلب ليس بنائمِ",58,"م",1,0],["لهُ يومَ الندى كرُّ الغوادي","وفي يوم الوغى كرُّ الهزبرِ",59,"ر",1,0],["له يد يابسة في الندى","ومقلة لا نظرت رطبَه",60,"ب",2,1],["لَهُ يَدٌ حَمْرَاءُ يَوْمَ الوَغَى","لكنّهَا بيضاءُ عِنْدَ السَّمَاحْ",61,"ح",1,0],["لَهيبُ قَلبي أَفاضَ الدَمعَ مِن بَصري","وَالعودُ يَقطُرُ ماءً حينَ يَحتَرِقُ",62,"ق",1,0],["لهيبُ الحميّا على شفتيه","وشبه التوقد في الأضلع",63,"ع",1,0],["لَهِيَ اللَيالي قَد جَلا أَحلاكَها","نورُ النُبوءَةِ مِن جَبينِكَ يُشرِقُ",64,"ق",1,0],["له يطيب اللبث في عشه","ولي يطيب اللبث في منزلي",65,"ي",1,0],["له يوم حشر الخلق والهول والعنا","شفاعة تخصيص علت كل رفعة",66,"ه",1,0],["له يدٌ في الشرّ مقبوضة","وأختُها في الخيرِ مبسوطَهْ",67,"ط",2,0],["لَهي بِشَهر الصَوم أَعتَق رِقابَنا","مِن النار وَاِجعَل عيدنا في تجمل",68,"ل",1,0],["له يدٌ تخجل الأبحار بالكرم ال","زخار والذابل الخطار بالقلم",69,"م",1,0],["لهيب الخد حين بدا لعيني","وخلنا أنه قصد انتعاشي",70,"ش",2,1],["لَهُ يَوْمُ بُؤْسٍ فِيهِ للنَّاسِ أَبْؤُسٌ","ويَوْمُ نَعِيمٍ فيهِ للنّاسِ أَنْعُمُ",71,"م",1,1],["لهيف الفؤاد وصاح بها","اذا الليل جن به الشوق زاد",72,"د",1,0],["له يبتغي زمرا زمزما","ومن كل فج عميق السواد",72,"د",1,0],["له يدان يد مبسوطة أبدا","على الورى ويد تزيل للمحن",73,"ن",1,0],["لَهيباً شَبَّ في قَلبي","كَجَمرِ المِرجَلِ الحامي",74,"ي",1,0],["لهيبُها في باطنِ الماءِ صَفا","جَلّ الذي بَيْنَهُما قد أَلّفا",75,"ف",2,0],["لهيف الحشى واري الفؤاد مقطع","ببيض الضبا ناء عن الأهل مهمل",76,"ل",1,0],["له يومان في كرم وبأس","كما يُرجى مُنىً يُخشى المنونا",77,"ن",2,0],["له يجب التقديس من حيث أنه","حرامٌ على من حلَّه غيرَ طاهر",78,"ر",1,0],["له يدٌ لا تفضل الأبحرُ ال","سبعُ على أنملها الخمسِ",79,"س",1,0],["له يومان غورو يوم بؤس","ويوم فيه تبتسم الثغور",80,"ر",1,0],["له يدان كتاب الأنام لها","إلا أناملها آلت أيالات",81,"ت",1,0],["له يدٌ للندى لو أنّها خُلقَتْ","قبلَ النّدى ما تَسَمّى غَيرَها الكرَمُ",82,"م",1,1],["له يُسلمُ الظبيُ إن ما رنا","وبدر الدجى ما بدا يكفر",83,"ر",1,0],["له يقلّ نظام الدر من كلمي","مدحاً ولو جاء بالآيات مثنيه",84,"ي",2,0],["لَهُ يَقينُ أَبي بَكرٍ وَعَدلُ أَبي","حَفصٍ وَجود أَبي عَمرو وَبَأسُ علي",85,"ل",2,0],["لهُ يومَ الطَّعانِ لواءُ نَصرٍ","يُؤَيِّدُهُ بِآرَا صالحاتِ",86,"ت",1,0],["لهيب الوجد للأحشاء صالٍ","ودمع العين يجري بانهمال",87,"ل",1,1],["لَهُ يَوم بُؤس حَينما صخ وَقعه","تصم لَهُ عِندَ السَماع الصَمايخ",88,"خ",1,0],["لَهُ يَراعٌ إِذا يَعلُو أَنامِلُهُ","شاهدتَ أَروع بِالخَطيَّةِ اِتَّشَحا",89,"ح",2,0],["له يرد السني من حزب أحمدٍ","وعنه ينحى محدث ومكذب",90,"ب",1,0],["لَهُ يَدٌ ظاهِرُها كَعْبَةُ","وَفِي نَدَى باطِنِها مَشْرَعُ",91,"ع",1,0],["لَهُ يَدٌ قَد قابَلَتْ باسْتِحَقاقْ","بِقَبْضِ أَرْواحٍ وَبَسْطِ أَرْزاقْ",92,"ق",1,0],["له يتهادى النَّسرُ في المشي حائناً","تهاديَ شيخٍ في نجادٍ مقنّعِ",93,"ع",1,0],["لهيبته ملوك الأرض خرّت","إلى الأذقان خوفا واحتراما",94,"م",2,0],["له يد ليس يصلى نارها رجل","وكأن من طرفيها الماء ينسكب",95,"ب",1,0],["لهيب نارٍ في محل اعتزال","يبصره الملاح فوق الجبال",96,"ل",1,0],["له يدٌ تسأل الرحمنَ رحمتهُ","بما به ويدٌ أخرى على كبده",97,"د",2,0],["لهيبٌ في لهيبٍ في لهيبٍ","وصبحٌ في صباحٍ في صباح",98,"ح",1,0],["له يوما ندىً ووغى عطاءٌ","وكسرٌ للألوفِ وللمئينِ",99,"ن",1,0],["لهيب الخد حين بدا لعيني","هَوى قلبي عليهِ كالفراشِ",100,"ش",1,1],["لهيبتهِ تجثو الشجاعة رهبةً","ولا غرو للمولى على عبده الأمر",101,"ر",1,0],["له يد قد علت بالجود مذ خلقت","سحابها هاطل بالسهل والجبل",102,"ل",1,0],["له يومُ بأسٍ مشرقُ الجو مظلم","ويومُ سماحٍ مشمسُ الأفقِ غائمه",103,"م",2,0],["له يد تسأل الرحمنَ راحته","مما به ويدٌ أخرى على كبده",104,"د",2,0],["له ينجو غدا من غير شك","سفير ولائهم في يو