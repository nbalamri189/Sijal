{"poems":[[53,"قل لنجح أخطأت باب النجاح","https://www.aldiwan.net/poem9402.html","الخفيف"],[53,"قولا لنحوينا أبي حسن","https://www.aldiwan.net/poem64969.html","المنسرح"],[87,"اسمعنا بارنج في صده","https://www.aldiwan.net/poem7265.html","السريع"],[87,"قال السلوقي مرة للجواد","https://www.aldiwan.net/poem8046.html","السريع"],[71,"هنيت عاما مقبلا مقبلا","https://www.aldiwan.net/poem28741.html","السريع"],[71,"قال حكت قامتها صعدة","https://www.aldiwan.net/poem29280.html","السريع"],[33,"راح صحبي ولم أحي النوارا","https://www.aldiwan.net/poem42529.html","الخفيف"],[107,"رحمة يا أبا بصير ونعمى","https://www.aldiwan.net/poem44063.html","الرمل"],[50,"وفاتن بالنظر الرطب","https://www.aldiwan.net/poem10809.html","السريع"],[50,"تبادل المرد بالأيورِ","https://www.aldiwan.net/poem66262.html","مخلع البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[92,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[53,"يا لائمي في الرَّاح غيرَ مُقَصِّرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=27408",""],[33,"رَاحَ صَحبي وَلَمْ أُحَيِّ النَّوارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18873&r=&rc=136",""],[156,"زائر","https://www.aldiwan.net/poem17106.html","عموديه"],[193,"فضل الله سيد الخلق قدما","https://www.aldiwan.net/poem35277.html","الخفيف"],[242,"أفدي رشا للوصال قالي","https://www.aldiwan.net/poem18859.html","مجزوء البسيط"],[261,"كيتي اصهل واضرط فقال نعم","https://www.aldiwan.net/poem48480.html","المنسرح"],[310,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[354,"أقبل صبحي وسفر","https://www.aldiwan.net/poem15721.html","مجزوء الرجز"],[371,"وسادة قد سقت مجالسهم","https://www.aldiwan.net/poem17736.html","المنسرح"],[409,"الحمد لله الذي لا يفي","https://www.aldiwan.net/poem33643.html","السريع"],[463,"سل بالغوير السائق المغلسا","https://www.aldiwan.net/poem56152.html","الرجز"],[463,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86727","الرمل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77671","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77659","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77651","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77495","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77672","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77640","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77616","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77560","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77552","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77669","الرجز"],[985,"","https://poetry.dctabudhabi.ae/diwan/poem/111240","الرمل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46526","الرجز"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66314","الرمل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124718","الرمل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100456","الرجز"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28517","الرمل"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82964","الرجز"],[2809,"","https://poetry.dctabudhabi.ae/diwan/poem/146637","المنسرح"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201001","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204649","الخفيف"],[3291,"","https://poetry.dctabudhabi.ae/diwan/poem/106684","السريع"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216535",""],[3638,"","https://poetry.dctabudhabi.ae/diwan/poem/203035","الهجيني"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110036","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110004","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216818","الرمل"],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103779","الخفيف"],[354,"","https://poetry.dctabudhabi.ae/diwan/poem/44074","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111389","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111450","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111431","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81234","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81252","الخفيف"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81938","السريع"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138724",""],[4283,"","https://poetry.dctabudhabi.ae/diwan/poem/203529","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136653",""],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133104","الرجز"],[4434,"","https://poetry.dctabudhabi.ae/diwan/poem/130704","الرجز"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104526","الخفيف"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104893","البسيط"],[4767,"حديث مع القلم","https://www.poetsgate.com/ViewPoem.aspx?id=124899",""],[4830,"مجرى دمي","https://www.poetsgate.com/ViewPoem.aspx?id=202615",""],[1420,"نزل اللاهوت في ناسوتها","https://www.poetsgate.com/ViewPoem.aspx?id=87622",""],[5183,"من طرائف المأمون","https://www.poetsgate.com/ViewPoem.aspx?id=180285",""],[5376,"طار صقر في السما ثم وقعْ","https://www.poetsgate.com/ViewPoem.aspx?id=191734",""],[5397,"ليلة ميلاد الزكي المجتبى","https://www.poetsgate.com/ViewPoem.aspx?id=157910",""],[5397,"غير بدع بأن يخون الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=157911",""],[5431,"بنٌ أفّاك!...","https://www.poetsgate.com/ViewPoem.aspx?id=208853",""],[5544,"موطني","https://www.poetsgate.com/ViewPoem.aspx?id=213413",""],[5763,"ِ شجيٌّ وخليٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=27066",""],[5939,"واقفٌ في يَدي الزهورُ","https://www.poetsgate.com/ViewPoem.aspx?id=178612",""],[6142,"يا نبي الهدى وأفضل خلق الل","https://www.poetsgate.com/ViewPoem.aspx?id=155703",""],[6212,"صوت القادم من سواد الأسئلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1628&r=&rc=9",""]],"verses":[["قال فيما يقول حين أجدَّتْ","جَبْهتا عانَتَيْهما في النِّطاحِ",0,"ح",1,0],["قال فقلنا ثم استقال فأع","فَيناهُ ثم استحال فانتقضا",1,"ض",2,0],["قال فريق لم يكن قصده","إلا المزاح المحض في ردّه",2,"د",2,0],["قالَ فَما بالُكَ يا صاحِبي","إِذا دَعا الصَيدُ وَجَدَّ الطِراد",3,"د",1,0],["قالَ فما سميتني بعدَها","واحذرْ عن التوجيهِ أنْ تذهلا",4,"ل",2,0],["قال فقل ريقتها شهدةٌ","قلت فكم تقصدُ تعسيلها",5,"ه",2,0],["قالَ فَاِفعَل لا يَمنَعَنكَ مَكاني","مِن حَديثٍ تَقضي بِهِ الأَوطارا",6,"ر",2,0],["قال فاذْهبْ فقد بَرِئْتَ وظُلمٌ","أن يُلامَ البريءُ أو أن يُذَمّا",7,"م",2,0],["قالَ فَتَصبو قُلتُ يا سَيِّدي","وَأَيُّ شَيءٍ فيكَ لا يُصبي",8,"ب",2,0],["قال فوثّق لنا برهنٍ","ونجعل الفضلَ للمُشيرِ",9,"ر",1,0],["قال في أيٍّ من ضروب الصناعا","ت تخصصت إنهن كثيرُ",10,"ر",1,0],["قال فلتقطع يمين الرجل","حبذا اليوم الذي كنت به",11,"ه",1,0],["قال فردٌ منهمْ لأخرى وقد","هَيَّجَ نفسيهما ربيعٌ خصيب",12,"ب",1,0],["قال فيما يقول حين أجدت","جبتها عانتيهما في النطح",13,"ح",1,0],["قَالَ: فکفْعَلْ لا يَمْنَعَنْكَ مَكاني","من حديثٍ تقضي به الاوطارا",14,"ر",2,0],["قَالَ: فَارْجِعْ إِنْ شِئْتَ، إِنَّ طَرِيقِي","شَائِكٌ، أَوْ فَاصْبِرْ عَلَى أَحْكَامِي",15,"م",2,0],["قَالَ: فَاجْرَعْ، فَقُلْتُ: سَمْعًا وَأَزْمَعْ","تُ وَأَوْمَأْتُ لِلدُّنَا بِالسَّلاَمِ",15,"م",1,0],["قالَ فاِركب فجاءَ يركبُ لكن","قَد تَبدّى منَ البراق إباءُ",16,"ا",2,0],["قَالَ فَأَضْرَمَ فِي فُؤَادِي","نَاراً لَظَاهَا حَشَايَ صَالِ",17,"ل",1,0],["قال فممّن فقلتُ من رجلٍ","قد صار في الجود حاتم الباعه",18,"ع",2,0],["قالَ فارفه ففي غدٍ سيوافي","قُلت تُدني غد قُطوفاً لجانِ",19,"ن",1,0],["قالَ فَهَل دارَ هَوا","هُ لِسِواكَ في الفِكر",20,"ر",1,0],["قالَ فَلِمَ قُلتُ لِيُبد","ي مِنهُ في القَدَر",20,"ر",1,0],["قالَ فَهَل غَيرُكَ مَن","يُعزى إِلَيهِ في البَشَر",20,"ر",1,0],["قالَ فَهَل تُعلِمُ مِن","هَذا الحَديثُ ما اِستَتَر",20,"ر",1,0],["قالَ فَما الخَمرُ في مَخادِعِهِم","فَقُلتُ في كَهفِهِم رَقيمُهُمُ",21,"م",1,0],["قالَ فَلِلمَزجِ فَوقَها حَنَشٌ","قُلتُ فَسَكرانُهُم سَليمُهُمُ",21,"م",1,0],["قال فهذا عز أهل الهدى","لكل ما يأتونه مقتفي",22,"ف",2,0],["قال فأعدى الخُرسَ بالنطق كما","حسَّنَ عند الناطقين الخَرَسا",23,"س",2,0],["قال فَرُدَّ صاغراً","أغزَلٌ مع الكِبَرْ",24,"ر",1,0],["قال فثمّ رجل قد اعتزل","يجتمع الناس إليه إن فعل",25,"ل",1,0],["قال فنَكني عنه عند ذكره","حتى نرى ماذا يرى في أمره",25,"ه",1,0],["قال فما ترون في الأطفال","وسائر النساء والعيال",25,"ل",1,0],["قالَ في الإِيماء وَيلي","إِنَّما اسمي حاسدْ",26,"د",1,0],["قالَ فَسَل القط ما اِستَطاعا","وَاِبتَلع القِرد لَهُ اِبتِلاعا",27,"ع",2,0],["قالَ فَأَدّى الشاعر المَديحا","وَأَظهَر اللَطيفَ وَالمَليحا",28,"ح",2,0],["قالَ فَقاما وَلجلدٍ أَحضَرا","طوقه الثَعلب جَهلاً وَجَرى",29,"ر",2,0],["قالَ فَلَما جاءَ رَبُّ الدار","وَفتح الباب عَلى الحِمار",30,"ر",1,0],["قالَ فَجاءَ اللصُّ ذاتَ لَيلَه","وَجَرَّ مِن بَعد العِشاءِ ذَيلَه",31,"ه",1,0],["قالَ فَما اِزدادَ الأَمير إِلّا","قَساوَةً وَجَفوَةً وَجَهلا",32,"ل",2,0],["قالَ فَلَما كَمُلَت لَهُ القوى","وَاِشتاقَ لِلصَيد وَإِطلاق الهَوا",33,"ه",3,0],["قالَ فسر السَبع لِلحِكايه","وَنسب الثَعلَب للدرايه",34,"ه",1,0],["قالَ فَرَدوا مَكره إِلَيه","وَهَلكوا مِن ضحك عَلَيه",35,"ه",1,0],["قالَ فَريق إِنَّما الحَواسُ","بِها الأُمور بَينَنا تُقاسُ",36,"س",1,0],["قال في الحلة لم يحصل لك","عل في بيتك ان يوجد لك",37,"ك",1,0],["قالَ فَلَما شاعَت الأَخبار","وَاِنتَشَرَت بِذَلِكَ الآثار",38,"ر",1,0],["قالَ فَكُلُّ ما جَرى وَيَجري","بِحكمة قدرها للأمر",38,"ر",1,0],["قال فانظرني بوسع","وغداً ضاعف بضيقي",39,"ق",2,0],["قال فرعونُ إنَّ هذا لَسِحرٌ","ثم طارت بالساحر الانباء",40,"ا",2,0],["قال فالخير من الله ومن","نفسك الشر أجبني وأحر",41,"ر",1,0],["قال فاسم اللهِ ما تفسيره","ونحا نحوي بوجهٍ مكفهر",41,"ر",1,0],["قال فالله تعالى وحده","كونَ الميتةَ خلقاً والقَذَر",41,"ر",1,0],["قال فالجعلُ هُوَ الخلقُ أم","الجعلُ شيءٌ غيرهُ فما ذكر",41,"ر",1,0],["قال فأعدى النطق بالخرس كما","حسن عند الناطقين الخرسا",42,"س",2,0],["قالَ في الرَّبع وَما أَحسَبَهُ","فارَقَ الأَظعانَ حَتّى انفَطَرا",43,"ر",2,0],["قال فُلانٌ ما فعل","قُلتُ أَبوه ما فَعَل",44,"ل",1,1],["قال: فما حليها وملبسها","وزيها كي تعود ريانه؟",45,"ن",2,0],["قال فيمَ الغرور قلت رويداً","إن لي فوق كل ملكك ملكا",46,"ك",2,0],["قال فاعشق أبناء نوعك طرا","فهو عشق سام بديع طريف",47,"ف",1,0],["قال فاختر ما شئت قلبا خليا","أو فؤاداً له الشقاء حليف",47,"ف",1,0],["قالَ فَوًَاوُ الصُّدغ عَاطِفَةٌ","لَكِن عَلَى التَّقِىِّ امتِنَاعُ السَّراح",48,"ح",1,0],["قال فِيْ نِعْمَه ومتسلّي","باتَوا الدايات يِحْظونه",49,"ن",2,0],["قال فالناس بشغافي معلقة","بت أناديها وتناديني",50,"ن",2,0],["قال فيها النبيُّ وَحيَ الهٍ","جئنَ في طيِّه النفوسُ القواتل",51,"ل",1,0],["قال فيها الفقيرُ صِرتُ غنياً","رافعاً فوق ذا الأنامِ سُجوفي",52,"ف",2,0],["قال فلتسلكه فيمن سلكوا","أيها المولى سبيل الشهداء",53,"ا",2,0],["قال فابدأ بنا وثن عليه","قلت كلا لقد دفعت قريبا",54,"ب",2,0],["قالَ فَلِمَ قُلتُ لِيب","دي الفضل مِنهُ في القَدَر",55,"ر",1,0],["قالَ فَرعَي أَترَا وَقَومَ أَخَايَا","من جُذِيتُم طُرًّا حِذَاءَ جميلا",56,"ل",2,0],["قَالَ فَاذهَب وَكُن بِصَدرِ الكُمَاةِ","وعلى القَومِ كُرَّ بالمركَباتِ",57,"ت",1,0],["قالَ فَطيري إيرِسُ الرَشيقَه","وَأبلِغي هَكطوراً الحقيقَه",58,"ه",1,0],["قالَ فَبَل قَد قُضِيَ الأَمرُ وَلا","مَناصَ وَاِنظُر تَلقَ خَيرَ النُبَلا",58,"ل",2,0],["قالَ فِريامُ مُومِئاً لأَياسٍ","وَأَخُو ذَا الحُسنِ ذَا القَوِيُّ الجَنانِ",59,"ن",1,1],["قالَ في رقة الصَوامع أَو لَو","عَة بيض المَساجد الغَراء",60,"ا",2,0],["قالَ فيما أَسر لي مِن حَديث","مُمتع لِلنُفوس في اِسترجاعه",61,"ع",2,0],["قال فهل تعشق غيري إذاً","أو تورد الظمآن من موردي",62,"د",2,0],["قال فيه هذا وليي وصيي","وارثي هكذا روى العلماء",63,"ا",2,0],["قال فيها البليغ ما قال ذو العي","ي وكل بوصفها منطيق",64,"ق",1,1],["قال فما تَبغي فقلت اللقا","قال مرامٌ دونه الحِين",65,"ن",1,0],["قال في الماضي إمامٌ فاضلٌ","آح لولا ألمي ما قلت آح",66,"ح",1,0],["قال فقير الله عبد الرحمان","ابن علي الديبع راجي الغفران",67,"ن",1,1],["قال فاركب فأنت درة ناجي","قلت فاغنم لكنني نجفي",68,"ي",1,0],["قال فذا الغصن قد حكاه","في حسن قدّ فقلت قصر",69,"ر",1,0],["قال: فاكت