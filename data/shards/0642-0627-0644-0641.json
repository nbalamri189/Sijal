{"poems":[[51,"قل لنجح أخطأت باب النجاح","https://www.aldiwan.net/poem9402.html","الخفيف"],[51,"قولا لنحوينا أبي حسن","https://www.aldiwan.net/poem64969.html","المنسرح"],[85,"اسمعنا بارنج في صده","https://www.aldiwan.net/poem7265.html","السريع"],[85,"قال السلوقي مرة للجواد","https://www.aldiwan.net/poem8046.html","السريع"],[69,"هنيت عاما مقبلا مقبلا","https://www.aldiwan.net/poem28741.html","السريع"],[69,"قال حكت قامتها صعدة","https://www.aldiwan.net/poem29280.html","السريع"],[31,"راح صحبي ولم أحي النوارا","https://www.aldiwan.net/poem42529.html","الخفيف"],[105,"رحمة يا أبا بصير ونعمى","https://www.aldiwan.net/poem44063.html","الرمل"],[48,"وفاتن بالنظر الرطب","https://www.aldiwan.net/poem10809.html","السريع"],[48,"تبادل المرد بالأيورِ","https://www.aldiwan.net/poem66262.html","مخلع البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[51,"يا لائمي في الرَّاح غيرَ مُقَصِّرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=27408",""],[31,"رَاحَ صَحبي وَلَمْ أُحَيِّ النَّوارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18873&r=&rc=136",""],[152,"زائر","https://www.aldiwan.net/poem17106.html","عموديه"],[189,"فضل الله سيد الخلق قدما","https://www.aldiwan.net/poem35277.html","الخفيف"],[237,"أفدي رشا للوصال قالي","https://www.aldiwan.net/poem18859.html","مجزوء البسيط"],[256,"كيتي اصهل واضرط فقال نعم","https://www.aldiwan.net/poem48480.html","المنسرح"],[305,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[349,"أقبل صبحي وسفر","https://www.aldiwan.net/poem15721.html","مجزوء الرجز"],[366,"وسادة قد سقت مجالسهم","https://www.aldiwan.net/poem17736.html","المنسرح"],[403,"الحمد لله الذي لا يفي","https://www.aldiwan.net/poem33643.html","السريع"],[458,"سل بالغوير السائق المغلسا","https://www.aldiwan.net/poem56152.html","الرجز"],[458,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["قال فيما يقول حين أجدَّتْ","جَبْهتا عانَتَيْهما في النِّطاحِ",0,"ح",1,0],["قال فقلنا ثم استقال فأع","فَيناهُ ثم استحال فانتقضا",1,"ض",2,0],["قال فريق لم يكن قصده","إلا المزاح المحض في ردّه",2,"د",2,0],["قالَ فَما بالُكَ يا صاحِبي","إِذا دَعا الصَيدُ وَجَدَّ الطِراد",3,"د",1,0],["قالَ فما سميتني بعدَها","واحذرْ عن التوجيهِ أنْ تذهلا",4,"ل",2,0],["قال فقل ريقتها شهدةٌ","قلت فكم تقصدُ تعسيلها",5,"ه",2,0],["قالَ فَاِفعَل لا يَمنَعَنكَ مَكاني","مِن حَديثٍ تَقضي بِهِ الأَوطارا",6,"ر",2,0],["قال فاذْهبْ فقد بَرِئْتَ وظُلمٌ","أن يُلامَ البريءُ أو أن يُذَمّا",7,"م",2,0],["قالَ فَتَصبو قُلتُ يا سَيِّدي","وَأَيُّ شَيءٍ فيكَ لا يُصبي",8,"ي",1,0],["قال فوثّق لنا برهنٍ","ونجعل الفضلَ للمُشيرِ",9,"ر",1,0],["قال في أيٍّ من ضروب الصناعا","ت تخصصت إنهن كثيرُ",10,"ر",1,0],["قال فلتقطع يمين الرجل","حبذا اليوم الذي كنت به",11,"ه",1,0],["قال فردٌ منهمْ لأخرى وقد","هَيَّجَ نفسيهما ربيعٌ خصيب",12,"ب",1,0],["قال فيما يقول حين أجدت","جبتها عانتيهما في النطح",13,"ح",1,0],["قَالَ: فکفْعَلْ لا يَمْنَعَنْكَ مَكاني","من حديثٍ تقضي به الاوطارا",14,"ر",2,0],["قَالَ: فَارْجِعْ إِنْ شِئْتَ، إِنَّ طَرِيقِي","شَائِكٌ، أَوْ فَاصْبِرْ عَلَى أَحْكَامِي",15,"م",2,0],["قَالَ: فَاجْرَعْ، فَقُلْتُ: سَمْعًا وَأَزْمَعْ","تُ وَأَوْمَأْتُ لِلدُّنَا بِالسَّلاَمِ",15,"م",1,0],["قالَ فاِركب فجاءَ يركبُ لكن","قَد تَبدّى منَ البراق إباءُ",16,"ا",2,0],["قَالَ فَأَضْرَمَ فِي فُؤَادِي","نَاراً لَظَاهَا حَشَايَ صَالِ",17,"ل",1,0],["قال فممّن فقلتُ من رجلٍ","قد صار في الجود حاتم الباعه",18,"ع",2,0],["قالَ فارفه ففي غدٍ سيوافي","قُلت تُدني غد قُطوفاً لجانِ",19,"ن",1,0],["قالَ فَهَل دارَ هَوا","هُ لِسِواكَ في الفِكر",20,"ر",1,0],["قالَ فَلِمَ قُلتُ لِيُبد","ي مِنهُ في القَدَر",20,"ر",1,0],["قالَ فَهَل غَيرُكَ مَن","يُعزى إِلَيهِ في البَشَر",20,"ر",1,0],["قالَ فَهَل تُعلِمُ مِن","هَذا الحَديثُ ما اِستَتَر",20,"ر",1,0],["قالَ فَما الخَمرُ في مَخادِعِهِم","فَقُلتُ في كَهفِهِم رَقيمُهُمُ",21,"م",1,0],["قالَ فَلِلمَزجِ فَوقَها حَنَشٌ","قُلتُ فَسَكرانُهُم سَليمُهُمُ",21,"م",1,0],["قال فهذا عز أهل الهدى","لكل ما يأتونه مقتفي",22,"ي",1,0],["قال فأعدى الخُرسَ بالنطق كما","حسَّنَ عند الناطقين الخَرَسا",23,"س",2,0],["قال فَرُدَّ صاغراً","أغزَلٌ مع الكِبَرْ",24,"ر",1,0],["قال فثمّ رجل قد اعتزل","يجتمع الناس إليه إن فعل",25,"ل",1,0],["قال فنَكني عنه عند ذكره","حتى نرى ماذا يرى في أمره",25,"ه",1,0],["قال فما ترون في الأطفال","وسائر النساء والعيال",25,"ل",1,0]]}