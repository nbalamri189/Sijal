{"poems":[[55,"يا بؤس مقتنص الغزال طماعة","https://www.aldiwan.net/poem30178.html","الكامل"],[3,"طال الثواء على رسوم المنزل","https://www.aldiwan.net/poem107.html",""],[85,"زار الخيال بأيمن الزوراء","https://www.aldiwan.net/poem54344.html","الطويل"],[53,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[53,"أرضى بصورته وصد فأغضبا","https://www.aldiwan.net/poem8652.html","الكامل"],[91,"الشعر ما قاله الكرخي عبود","https://www.aldiwan.net/poem44750.html","البسيط"],[87,"إن تسألي عن مصر حواء القرى","https://www.aldiwan.net/poem8089.html","الكامل"],[87,"سما يناغي الشهبا","https://www.aldiwan.net/poem8091.html","مجزوء الرجز"],[64,"وترى الثريا والهلال مظاهرا","https://www.aldiwan.net/poem52436.html","الكامل"],[64,"سعدت بطول بقائك الحقب","https://www.aldiwan.net/poem52479.html","أحذ الكامل"],[47,"سهر أصابك بعد طول نعاس","https://www.aldiwan.net/poem64605.html","الكامل"],[63,"ذممت زرعك خوفا من مطالبتي","https://www.aldiwan.net/poem51451.html","البسيط"],[68,"أبد سنا وجهك من حجابه","https://www.aldiwan.net/poem41551.html","الرجز"],[46,"ها إن هذا موقف الجازع","https://www.aldiwan.net/poem30459.html","السريع"],[46,"أرأيت أي سوالف وخدود","https://www.aldiwan.net/poem30556.html","الكامل"],[107,"لك يا شهيد الحق قام المأتم","https://www.aldiwan.net/poem42059.html","الكامل"],[52,"إن النساء مضيئات ظواهرها","https://www.aldiwan.net/poem24581.html","البسيط"],[48,"أصبحت غير مميز من عالم","https://www.aldiwan.net/poem22562.html","الكامل"],[48,"نفس الفتى وليست له جسدا","https://www.aldiwan.net/poem23148.html","الكامل"],[48,"روح تعدن قضي اليوم وانتظري","https://www.aldiwan.net/poem23472.html","البسيط"],[48,"لو كان جسمك متروكا بهيأته","https://www.aldiwan.net/poem23588.html","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147493","السريع"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16626","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55010","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[147,"دم بالصيام مهنأ ما داما","https://www.aldiwan.net/poem11821.html","الكامل"],[189,"يا خليلي الهوى برح بي","https://www.aldiwan.net/poem14115.html","الرمل"],[189,"إيه على تذكار ما سلفا","https://www.aldiwan.net/poem14591.html","أحذ الكامل"],[208,"والكأس فيه يديرها","https://www.aldiwan.net/poem53084.html","مجزوء الكامل"],[240,"يا معشر الشعراء قا","https://www.aldiwan.net/poem31911.html","مجزوء الكامل"],[261,"اسمع المدح الذي لو قيل في","https://www.aldiwan.net/poem48346.html","الرمل"],[280,"أحسنوا العطف عليها مهجا","https://www.aldiwan.net/poem25608.html","الرمل"],[303,"واها لأيام الشباب الغض","https://www.aldiwan.net/poem36825.html","عموديه"],[327,"آذن اليوم جيرتي بارتحال","https://www.aldiwan.net/poem56350.html","الخفيف"],[347,"قلبي يحدثني","https://www.aldiwan.net/poem55325.html","منهوك البسيط"],[369,"ذكر المعسكر صاحبي ذكرا","https://www.aldiwan.net/poem60913.html","أحذ الكامل"],[371,"أما ومنك على أعدائك الطلب","https://www.aldiwan.net/poem17155.html","البسيط"],[396,"يا من له الخلق الحسن والخلق والعقل ومن","https://www.aldiwan.net/poem54485.html","عموديه"],[412,"قولا له هل دار في حوبائه","https://www.aldiwan.net/poem50212.html","الكامل"],[469,"قوامك اللدن لا ما يزعم الغصن","https://www.aldiwan.net/poem3196.html","عموديه"],[469,"شم لأثيلات الحمى وضاله","https://www.aldiwan.net/poem3426.html","عموديه"],[469,"ما للمطايا تكثر الحنينا","https://www.aldiwan.net/poem3574.html","عموديه"],[498,"رقراقة في السراب تحسبها","https://www.aldiwan.net/poem67389.html","البسيط"],[545,"كالدهم والنعم الهجان يحوزها","https://www.aldiwan.net/poem56791.html","الكامل"],[558,"طيف الخيال حمدنا منك إلماما","https://www.aldiwan.net/poem68427.html","البسيط"],[563,"يا من غفلتم وجوهكم سود","https://www.aldiwan.net/poem34568.html","المنسرح"],[566,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[572,"داو خماري بكأس خمر","https://www.aldiwan.net/poem69458.html","مخلع البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138268",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83298","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63969","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63741","الرجز"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96629","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72312","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46569","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95551","البسيط"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77743","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[1986,"","https://poetry.dctabudhabi.ae/diwan/poem/203835","المجتث"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27262","السريع"],[2251,"","https://poetry.dctabudhabi.ae/diwan/poem/82123","البسيط"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111251","البسيط"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130808",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204474","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132709","الخفيف"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87392","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89118","الرجز"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206152","الكامل"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202349","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59440","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114497","البسيط"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35645","السريع"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70142","المتدارك"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125846","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119703","المجتث"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91046","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73250","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73246","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72750","البسيط"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204228","الكامل"],[4755,"مطر القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=200000",""],[4767,"الأمل المعلق","https://www.poetsgate.com/ViewPoem.aspx?id=215856",""],[4830,"حديث القافية","https://www.poetsgate.com/ViewPoem.aspx?id=202140",""],[4888,"في ظل وطن","https://www.poetsgate.com/ViewPoem.aspx?id=207742",""],[5032,"كمان اللّيل","https://www.poetsgate.com/ViewPoem.aspx?id=191770",""],[4119,"عن خاطري نبأ الخيال الخاطر","https://www.poetsgate.com/ViewPoem.aspx?id=16155",""],[5136,"وابأبي مبتسم بارد","https://www.poetsgate.com/ViewPoem.aspx?id=121606",""],[5145,"سفرت لنا عن سنة البدر","https://www.poetsgate.com/ViewPoem.aspx?id=108134",""],[5259,"داء الزمان وأهله","https://www.poetsgate.com/ViewPoem.aspx?id=186805",""],[327,"آذَنَ اليومَ جِيرتي بارتحالِ","https://www.poetsgate.com/ViewPoem.aspx?id=3928",""],[5956,"كم قلتُ: ساعدنا أيا جبار","https://www.poetsgate.com/ViewPoem.aspx?id=192698",""],[6093,"حِكْمَةُ دُودَة","https://www.poetsgate.com/ViewPoem.aspx?id=191092",""],[5190,"عودة بلفور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78348&r=&rc=61",""],[572,"يا راحُ قُمْ فأحْبِنَا بالراحِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9211&r=&rc=68",""]],"verses":[["كَالدَرَّةِ البَيضاءِ حانَ ضَياعُها","مِن بَعدِ ما مَلأَت يَمينَ الغائِصِ",0,"ص",1,0],["كَالدُرِّ أَو فَضَضِ الجُمانِ تَقَطَّعَت","مِنهُ عَقائِدُ سِلكِهِ لَم يوصَلِ",1,"ل",1,0],["كالدهر في سطواته وسماحه","تجري صَباه بزَعزعِ وَرُخاءِ",2,"ا",2,0],["كالدهر في النفع والمضرَّة وال","حنْكة لكن رَيْبَه غَضَبُهْ",3,"ب",2,0],["كالدرَّة الزهراء ألبِسَ لونُها","صَدفاً يُغَارُ عليه كي لا يَشْحَبَا",4,"ب",2,0],["كالدر يزداد حسنا في تألقه","اذا تحلت به اللبات والجيد",5,"د",1,0],["كَالدَهرِ لَو مَلَكَ القِيامَ لِفَتكَةٍ","أَو كانَ غَيرَ مُقَلَّمِ الأَظفارِ",6,"ر",1,0],["كَالدَيدَبانِ أَلزَمو","هُ في البِحارِ مَرقَبا",7,"ب",2,0],["كالدُّرِّ فُصِّلَ في وِشاحِ خَريدةٍ","حسناءَ تجلى من لثامٍ أسْوَدِ",8,"د",1,0],["كالدَّهرِ كلُّ صروفِه عِبَرٌ","والبحرِ كلُّ أمورِهِ عَجَبُ",9,"ب",1,0],["كَالدَهرِ صِرفُ ثَوابِهِ وَعِقابِهِ","في العالَمينَ لِجارِحٍ أَو آسِ",10,"س",1,0],["كالدُّرِّ يَجتَنِبُ المرزوقَ ما انتَثَرتْ","عُقودُهُ ويُعادي كلَّ مَحرومِ",11,"م",1,0],["كَالدُرِّ لا يُظهِرُ حُسنَ عِقدِهِ","إِلّا جَوازُ السَلكِ في أَثقابِهِ",12,"ب",2,0],["كَالدَلوِ وَالحوتِ وَأَشراطِهِ","وَالبَطنِ وَالنَجمِ إِلى البالِعِ",13,"ع",1,0],["كَالدُرِّ وَالمَرجانِ أُلِّفَ نَظمُهُ","بِالشَذرِ في عُنُقِ الفَتاةِ الرودِ",14,"د",1,0],["كالدّاءِ مُنْتَشِراً تَجَمَّعَ كُلُّه","في مَوضعٍ يُجْتَثُّ منه ويُحْسَمُ",15,"م",1,0],["كَالدَهرِ في صَرفِهِ سِقمٌ وَعافِيَةٌ","وَكَالزَمانِ لَهُ بُؤسٌ وَإِنعامُ",16,"م",1,0],["كَالدارِ صَبَّحَها سِوى قُطّانُها","فَثَوَوا بِها وَتَحَمَّلَ المُتَدَيِّرُ",17,"ر",1,0],["كَالدِنِّ ضاقَ بِما تَضَمَّنَهُ","حَتّى يَكونَ لِراحِهِ بَزلُ",18,"ل",1,0],["كَالدُرِّ يُمنَعُ مِنهُ الطِفلُ مُقتَسَراً","وَلَم يُجانِبهُ مِن زُهدٍ وَقَد شَدَنا",19,"ن",2,0],["كاّلدَنِّ عُطَّلَ مِن راحٍ تَكونُ بِهِ","وَلَم يُحَطَّم فَعادَت مَرَّةً فيهِ",20,"ف",3,0],["كالدرة العذراء ما نالها","إلا امروءٌ في بحرها غائص",21,"ص",1,0],["كالدُّرّ بَثّتْه آيادٍ بها","فهْوَ شَتيتُ الشمْل لا يُنْظَمُ",22,"م",1,0],["كَالدُّرِّ مُكِّنَ فِي العُقُو","دِ وَلِلشُّعَاعِ بِهِ وُثُوبُ",23,"ب",1,0],["كَالدَّوْحَةِ الكُبْرَى تَوَحَّدَ أَصْلُهَا","وَمَضَتْ مَذَاهِبَ فِي السَّمَاءِ الأَفْرُعُ",24,"ع",1,0],["كالدَّهْر أَجلُّ بَنِيهِ أبو","عَبْدِ الرَّحْمنِ مُحَمَّدهُ",25,"د",2,0],["كَالدُرِّ لَمّا فارَقَ الأَصدافَ لا","كَالنورِ لَمّا فارَقَ الأَكماما",26,"م",2,0],["كَالدَوقَسِ المَغرورِ ظَنَّ بِجَهلِهِ","أَنَّ الوِهادَ تُطاوِلُ الآكاما",26,"م",2,0],["كالدنانير بَدَتْ ألوانه","تُعدِم الإعدامَ كفَّ التَّرِب",27,"ب",1,0],["كالدُّرِّ لكنْ صاغ ناظمُه","بالمسكِ من لَعَسٍ به صَدَفا",28,"ف",2,0],["كالدرِّ والياقوت وال","مرجان في حَليِ العَذَاري",29,"ر",2,0],["كَالدِبنِ لَيسَ بِهِ إِذا","فَتَّشتَهُ إِلّا التُيوسُ",30,"س",1,0],["كالدجى تبصر من غرتهِ","فوق أطباق دجاه فلقا",31,"ق",2,0],["كالدُّمى غَيْرَ دَلال رُبَّما","رَقَّ مَعْنًى فاسْتَرَقَّ المُهَجا",32,"ج",2,0],["كالدرِّ لَمَّاحاً إذا الدرُّ اتَسقْ","أو كائتلاقِ البرق من خلفِ الشفقْ",33,"ق",1,0],["كَالدُمى حُسنُهُنَّ أَربى عَلى الحُس","نِ وَيُضعِفنَ في تُقىً وَجَمالِ",34,"ل",1,0],["كالدهر قد طمست","آثاره الحقب",35,"ب",1,0],["كالدُّرِّ زِيدَ كمالُ بَهجتِهِ","في العَينِ أنْ قد كُلِّلَ التِّبرا",36,"ر",2,0],["كَالدَهرِ إِن طَلَبوا وَالمَوتِ إِن غَضِبوا","وَالريحِ إِن رَكِبوا وَالبَرقِ إِن وَثَبوا",37,"ب",3,0],["كالدر في الأصداف تستزري","وتبخس في الثمن",38,"ن",1,0],["كالدُرِّ يَحسِنُ وَحدَه وَبَهاؤهُ","في لِبَّةِ الحَسناء ضِعفُ بَهائِهِ",39,"ا",3,0],["كالدّهر إن لان لانوا دون عقوتها","لطفاً وإن خشنت أحداثهُ خشنوا",40,"ن",3,0],["كالدهر يوماً نحن منه في هدىٍ","وتارةً في التيه من ضلاله",41,"ل",2,0],["كالدّعصِ ردفاً والأقاحي مبسماً","والشمسِ وجهاً والقضيبِ لينا",42,"ن",2,0],["كَالدِرعِ لكِنَّها مُعَوَّضَةٌ","عَنِ المَساميرِ كَثرَةَ العُقَدِ",43,"د",1,0],["كالدُهمِ وَالنعَمِ الهِجانِ يحوزُها","رَجُلانِ مِن نبهانَ أَو مِن ملقَطِ",44,"ط",1,1],["كَالدَهرِ لا يَنثَني عَمَّن يَهُمُّ بِهِ","قَد أَوسَعَ الناسَ إِنعاماً وَإِرغاما",45,"م",2,0],["كالدود أنتم ضعاف خلقتكم","عزم لكم في الرشاد مخمود",46,"د",1,0],["كَالدِعصِ أَعلى تُربِهِ مَثرِيُّ","إِني اِمرؤٌ عَن جارَتي كَفِيُّ",47,"ي",1,0],["كَالدَّمْعِ قَدْ حَارَ فِي رُبَاهُ","حُمْرٍ وَوَرْدِيَّةٍ وَصُفْرِ",48,"ر",1,0],["كالديمة الوكفاء يغدق نصحه","وسواه قد يعطيك بعض رذاذ",49,"ذ",1,0],["كَالدُرِّ في لَمَعاتِهِ وَالبَدرُ في","قَسَماتِهِ وَالصُبحُ في نَسَماتِهِ",50,"ت",2,0],["كالدرِّ منثوراً من الأصداف بل","كالدرِّ منشوراً من الأسْفاط",51,"ط",1,0],["كالدرهمِ المقرونِ بالدينار","يَفْتَح دُرْجَ العِطْرِ بالأسحار",52,"ر",1,0],["كالدرِّ إلّا أَنّها","ما ثقّبت بالمبردِ",53,"د",1,0],["كالدر والياقوت ما","سكن البحار ولا الجبالا",54,"ل",2,0],["كَالدر في السحاب","مُهَذب الآداب",55,"ب",1,0],["كالدين والدين بفتح الأول","وكسر ثان قبل ردف ينجلي",56,"ي",1,0],["كالدر مهما طواه أليمُّ مؤتلقاً","والزهر يذوى ويبقى عاطر النسم",57,"م",1,0],