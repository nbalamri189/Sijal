{"poems":[[65,"تلك الحدوج يراعيهن غيران","https://www.aldiwan.net/poem46159.html","البسيط"],[75,"قد بعثناه ينفع الأعضاء","https://www.aldiwan.net/poem11983.html","الخفيف"],[31,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[47,"ملامك إنه عهد قريب","https://www.aldiwan.net/poem11042.html","الوافر"],[46,"أزعمت أن الربع ليس يتيم","https://www.aldiwan.net/poem30360.html","الكامل"],[102,"جريح","https://www.poetsgate.com/ViewPoem.aspx?id=50196",""],[2708,"","https://poetry.dctabudhabi.ae/diwan/poem/80426","الرجز"],[5431,"العبودية الجديدة!(1)","https://www.poetsgate.com/ViewPoem.aspx?id=207437",""],[5619,"ملطشه الايام","https://www.poetsgate.com/ViewPoem.aspx?id=211365",""]],"verses":[["ملَطَّمونَ بأعْقار الحِياضِ لهُمْ","بكُلِّ منْزلَةٍ للّؤْمِ أوْطانُ",0,"ن",1,0],["مُلطِفٌ يُبرِدُ المَزاجَ إِذا","جاشَ اِلتِهاباً وَيَقمَعُ الصَفراءَ",1,"ا",2,0],["مُلَطَّمونَ بِأَعقارِ الحِياضِ فَما","يَنفَكُّ مِن دارِمِيٍّ فيهِمِ أَثَرُ",2,"ر",1,0],["مُلَطٌّ بِالطَريقِ وَلَيسَ يُصغي","لِأَنجِيَةِ الطَريقِ وَلا يُجيبُ",3,"ب",1,0],["مَلطومَةٌ بِالوَردِ أُطلِقَ طَرفُها","في الخَلقِ فَهوَ مَعَ المَنونِ مُحَكَّمُ",4,"م",1,0],["ملّ طول الحياة لا نال منها","ما يرجّي ولا دنا من حصاده",5,"د",2,0],["مُلَطِّفٌ مُبَرِّدُ الْحَرَاره","فِي حُمْياتٍ أصلُها المَرَارَه",6,"ه",1,0],["مُلَطِّفٌ مُبردُ الغِذَاءِ","وَمُشْرِقُ اللَّوْنِ عَلَى الأَعْضَاءِ",6,"ا",2,0],["ملطخةً عروقا راعشاتٍ","مغمسّة بطوقٍ من معاصِ",7,"ص",1,0],["ملطشه الأيام وجعانى بدورتها...","منتشه هدومى بقع وبتكفا....",8,"ا",1,1]]}