{"poems":[[63,"تلك الحدوج يراعيهن غيران","https://www.aldiwan.net/poem46159.html","البسيط"],[73,"قد بعثناه ينفع الأعضاء","https://www.aldiwan.net/poem11983.html","الخفيف"],[29,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[45,"ملامك إنه عهد قريب","https://www.aldiwan.net/poem11042.html","الوافر"],[44,"أزعمت أن الربع ليس يتيم","https://www.aldiwan.net/poem30360.html","الكامل"],[100,"جريح","https://www.poetsgate.com/ViewPoem.aspx?id=50196",""]],"verses":[["ملَطَّمونَ بأعْقار الحِياضِ لهُمْ","بكُلِّ منْزلَةٍ للّؤْمِ أوْطانُ",0,"ن",1,0],["مُلطِفٌ يُبرِدُ المَزاجَ إِذا","جاشَ اِلتِهاباً وَيَقمَعُ الصَفراءَ",1,"ا",2,0],["مُلَطَّمونَ بِأَعقارِ الحِياضِ فَما","يَنفَكُّ مِن دارِمِيٍّ فيهِمِ أَثَرُ",2,"ر",1,0],["مُلَطٌّ بِالطَريقِ وَلَيسَ يُصغي","لِأَنجِيَةِ الطَريقِ وَلا يُجيبُ",3,"ب",1,0],["مَلطومَةٌ بِالوَردِ أُطلِقَ طَرفُها","في الخَلقِ فَهوَ مَعَ المَنونِ مُحَكَّمُ",4,"م",1,0],["ملّ طول الحياة لا نال منها","ما يرجّي ولا دنا من حصاده",5,"د",2,0]]}