{"poems":[[90,"سمي المصطفى لا زلت تعلو","https://www.aldiwan.net/poem44816.html","الوافر"],[90,"من أين من أين يا ابتدائي","https://www.aldiwan.net/poem45073.html","مخلع البسيط"],[87,"معالي العهد قمت بها فطيما","https://www.aldiwan.net/poem8100.html","الوافر"],[64,"لك الله هل عهد الشبيبة يرجع","https://www.aldiwan.net/poem52358.html","الطويل"],[18,"أهاج قذاء عيني الإذكار","https://www.aldiwan.net/poem23953.html","الوافر"],[46,"من سجايا الطلول ألا تجيبا","https://www.aldiwan.net/poem30582.html","الخفيف"],[76,"نهر كما سال اللمى سلسال","https://www.aldiwan.net/poem13208.html","الكامل"],[48,"ما جدري أمات صاحبه","https://www.aldiwan.net/poem22597.html","المنسرح"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42613","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54656","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[164,"ارضيت ربك بالعدل الذي انتشرا","https://www.aldiwan.net/poem58894.html","البسيط"],[164,"لك في الملوك خوارق العادات","https://www.aldiwan.net/poem58905.html","الكامل"],[193,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[202,"زارتك من رقبة الواشي على فرق","https://www.aldiwan.net/poem51917.html","البسيط"],[226,"أنا أهوى الكمال في كل نفس","https://www.aldiwan.net/poem55289.html","الخفيف"],[234,"بأبي الزائر سرا","https://www.aldiwan.net/poem50990.html","مجزوء الرمل"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[275,"حييتها بقرنفل ممطور","https://www.aldiwan.net/poem35445.html","الكامل"],[303,"لمن وبمن عسى يرجى العزاء","https://www.aldiwan.net/poem36264.html","عموديه"],[303,"عذيري من حليف ذي خصال","https://www.aldiwan.net/poem36815.html","عموديه"],[350,"فقمت إلى بلهاء ذات علالة","https://www.aldiwan.net/poem4474.html","الكامل"],[435,"فدر التهاني أرانا طالعا حسنا","https://www.aldiwan.net/poem39857.html","البسيط"],[438,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[449,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[466,"اذا سل سيف الرأي من غمد حزمه","https://www.aldiwan.net/poem15436.html","الطويل"],[469,"نعم نفحة الوادي التي تتأرج","https://www.aldiwan.net/poem3143.html","عموديه"],[469,"لها من ظباء أسهرتك جفونها","https://www.aldiwan.net/poem3500.html","عموديه"],[473,"يا أيها الخل الذي","https://www.aldiwan.net/poem60128.html","مجزوء الكامل"],[505,"أبعد توكلي وصحيح عهدي","https://www.aldiwan.net/poem37626.html","الوافر"],[543,"ما لي أنادي يا عديل فؤادي","https://www.aldiwan.net/poem48211.html","عموديه"],[556,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[572,"أمسك ديف بالقهوة","https://www.aldiwan.net/poem69769.html","الهزج"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83337","البسيط"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126128","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46537","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109123","الكامل"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110273","السريع"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177826","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27389","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47158","الطويل"],[2274,"","https://poetry.dctabudhabi.ae/diwan/poem/144757","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2796,"","https://poetry.dctabudhabi.ae/diwan/poem/200309","الطويل"],[3092,"","https://poetry.dctabudhabi.ae/diwan/poem/216356","الكان كان"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102391","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127014","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85266","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111472","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77089","الطويل"],[3982,"","https://poetry.dctabudhabi.ae/diwan/poem/18400","الطويل"],[4083,"","https://poetry.dctabudhabi.ae/diwan/poem/147650","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123490","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95067","الطويل"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147302","الكامل"],[4634,"","https://poetry.dctabudhabi.ae/diwan/poem/200299","الوافر"],[4767,"ساعة الصفر","https://www.poetsgate.com/ViewPoem.aspx?id=179844",""],[4927,"معاقيل الشهادة","https://www.poetsgate.com/ViewPoem.aspx?id=79608",""],[4955,"رضاك غاية من للحق وجهتهم","https://www.poetsgate.com/ViewPoem.aspx?id=198367",""],[5363,"مفخرة الإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=144431",""],[5409,"فنُّ البيان رثاك قبل لساني","https://www.poetsgate.com/ViewPoem.aspx?id=155483",""],[5410,"رسالة خاصة","https://www.poetsgate.com/ViewPoem.aspx?id=140759",""],[5413,"سامحيني","https://www.poetsgate.com/ViewPoem.aspx?id=200567",""],[5442,"لعل حداة العيش أن يترفقوا","https://www.poetsgate.com/ViewPoem.aspx?id=114754",""],[402,"آية في تسلسل الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=35359",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5956,"أنا وشقيقي والحمامة","https://www.poetsgate.com/ViewPoem.aspx?id=184560",""],[5957,"حكاية حب","https://www.poetsgate.com/ViewPoem.aspx?id=177044",""],[5957,"طالما أنت أنا","https://www.poetsgate.com/ViewPoem.aspx?id=186316",""],[6318,"فلق الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66162&r=&rc=12",""]],"verses":[["فدُر كالشمس في فلك المعالي","وحُلّ من الكمال بكل برج",0,"ج",1,0],["فدُرنَ في الجوّ جاريات","كأنها السفن فوق ماء",1,"ا",2,0],["فَدُر مِن بَعدِنا لَهُمو يَمينا","وَكُن لِوُرودِكَ الماءَ الحَميما",2,"م",2,0],["فدرستَ شوقاً كاد لولاك يمَّحِي","ونبَّهتَ شوقاً كان لولاك يهجعُ",3,"ع",1,0],["فَدُرتُ وَقَد عَشِيَّ بَصَري عَلَيهِ","كَما دارَت بِشارِبِها العُقارُ",4,"ر",1,0],["فَدُروبُ الإِشراكِ صارَت فَضاءً","وَفَضاءُ الإِسلامِ يُدعى دُروبا",5,"ب",2,0],["فَدَرَأتُ بادِرَةَ الشُجاعِ بِأَخضَرٍ","في رَقشِهِ هُوَ لِلشُجاعِ مِثالُ",6,"ل",1,0],["فَدُرَّ جوداً فَدُرَّ زاخِرَةٍ","حَصىً تَساوى الأَنيسُ وَالفُدُرُ",7,"ر",1,0],["فَدُرْ بِعَيْنَيْكَ حَيْثُ شِئْتَ تَجِدْ","مُلْكَاً كَبِيراً وَجَنَّةً خَضِرَهْ",8,"ر",2,0],["فَدَرَى الغَرْبُ فَصْلَُهُمْ حِينَ كَانَتْ","فِيهِ أَعْلَمُهُمْ مِنَ النَّكِرَاتِ",9,"ت",1,0],["فدرى به \"هصرٌ\" وكان يسوؤه","من عروة ابن شقيقه يتمان",10,"ن",1,0],["فدرهم العدل تنميه مسالمة","من الخطوب إلى أن يملاء البدرا",11,"ر",2,0],["فدروا بأن لكم وراء جنودِكم","جندٌ من الأَمطار والبركاتِ",12,"ت",1,0],["فدُرُّه عادَ له مُنتظما","قلّبتها لمّا تبدّت جوهَرا",13,"ر",2,0],["فدرّعت ساريات المزنِ تُسعِدُني","عندَ الفراقِ بدمعٍ واكفٍ غَرِق",14,"ق",1,0],["فدرجنا على الصعيد حفاة","بين غبر من الجياع وشعس",15,"س",1,0],["فدَرى الواشِي وهل يُخ","فى الدُجَى مطلعَ شمسِ",16,"س",1,0],["فَدَرى النَبِيُّ بِها فَأَعلَمَ عَمَّهُ","وَالأَمرُ خافٍ مِن ذَوي الطُغيانِ",17,"ن",1,0],["فَدَرى النَبِيُّ فَظَلَّ يَحفِرُ خَندَقاً","بِإِشارَةٍ مِن ذي الحِجى سَلمانِ",17,"ن",1,0],["فدَرى بنا قسٌّ وجاءَ يقولُ لي","لا تعترف ما الذَّنبُ بالمغفور",18,"ر",1,0],["فَدرَّ عَلَى جبينِ الملكِ عرقٌ","تراءَى الحزنُ فيه والإِباءُ",19,"ا",2,0],["فدرّبني عَلى حملِ الرزايا","وَأوصاني بصبرٍ واحتمال",20,"ل",1,0],["فَدَرَّت مَرّياً حالِبَيها وَأَرزَمَت","إِلى حِسِّ مَعذومٍ عَنِ الضَرعِ فاتِرِ",21,"ر",1,0],["فدر التهاني أرانا طالعاً حسناً","في جيدهِ العلم والعليا قد اقترنا",22,"ن",2,1],["فَدَرْعَرعٍ فالقَحْمِ فالقَلى الذي","منه المجازُ فدجلةٍ فالطُّرَّةِ",23,"ه",1,0],["فدرى أن في قرى الحمام قر","بعد هذا قد احس المهر خاض",24,"ض",1,0],["فدرعُ الذي يلقاهُ مُهلهل","وصارمهُ وهو الجُرازُ كهامُ",25,"م",1,0],["فدرٌ بأجياد الغصون منظَّمٌ","ودرٌّ على بسطِ النبات مدحرج",26,"ج",1,0],["فدرٌّ وأصدافُ الخدود تصونهُ","وبحرُ سرابٍ والمطيُّ سفينها",27,"ن",3,0],["فَدُراهُمُ النِسرينِ قَد","بَهَرَت دَنانيرَ البَهارِ",28,"ر",1,0],["فدرعي حبُّ أحمد خير هادٍ","ولي بمتين سنَّته اعتصام",29,"م",1,0],["فَدرى الدَّخيلَ ولم يَكن يَدرِي بأن","نَ الدَّاخِليِ قد كانَ بالمِرصَاد",30,"د",1,0],["فدُرُّ قريضي بلا ناظمٍ","وغرُّ مقالي بلا قائلِ",31,"ل",1,0],["فَدَرّجْتُ إلى الوَصْلِ","رَشاً أَحْسَنْتُ تدريجَهْ",32,"ج",2,0],["فَدِر دَرَّكَ مِن خِلٍّ سَما خَلَقا","لِأَنتَ أَفضَلُ مَن في وُدِّهِ صَدَقا",33,"ق",2,0],["فدرب كل مؤمن تقي","الى جوار ربه العلي",34,"ي",1,0],["فَدَراهم وَقرب","فَالحُب بِالتحبب",35,"ب",1,1],["فدرت معانيه وسدت جوعها","يا ويله مما جنته يداه",36,"ا",2,0],["فُدرُ الأرَاوَى الفَارعَاتِ نِيقَهَا","الرَّاقِيَاتِ الصَّاعِدَاتِ شِيقَهَا",37,"ه",2,0],["فدرهم الاحسان مستقرضٌ","وخالقُ الدنيا هو المستدين",38,"ن",1,0],["فدراك معترك المنون فقد أتت","ودع المنى واهبب لأخذ الأهبة",39,"ه",1,0],["فدرى بها أن الذي بالهه","من منزل النكباء أصبح يعدل",40,"ل",1,0],["فدرّت عليها من مراحم جوده","سحائبُ للعفو الجميل حوامل",41,"ل",1,0],["فدرت بمرآها شئون مدامِعِي","وظَلتُ وإياها كَبَوِّ ورائمِ",42,"م",1,0],["فَدُر مِنَ الجَزِيرَةِ وَاطرَح بِهَا","والناسُ تَأتِي قَبلَ أن تأتِيهَا",43,"ه",2,0],["فدرنا ودارت غمرة الموت بيننا","نطاعن عن أصحابنا بالذوابل",44,"ل",1,0],["فدرب دينار تعبر","نسيت درب المقبره",45,"ه",1,0],["فدُرْنا عليهم ساعةً ثمَّ خبَّبوا","عباديدَ يعدُونَ الفِجاجَ الأقاصيا",46,"ي",2,0],["فدرن عليه صارخات حوائماً","ينادين والأحشاء منهن تخفق",47,"ق",1,0],["فدر حول قال اللَه قال رسوله","وأصحابه أيضاً فهذا هو العلم",48,"م",1,0],["فَدَرى بي أَبي وباللَّعنِ مالا","وَبَناتِ الرَّدى استغاثَ وقالا",49,"ا",1,0],["فدرداره باد من أصله","بصفصافه وكذا أثله",50,"ه",1,0],["فَدَرَّت مَواشيها وَبانَ نَعيمُها","وَبايَنَها المَحَل المُبرِح وَالكَد",51,"د",1,0],["فَدَرَّت عَلَينا جِزيَةُ القَومِ بَعدَ ما","ضَرَبناهُمُ ضَرباً يَعُطُّ الشَوابِرا",52,"ر",2,0],["فدرار تسري وما لحقته","ونجوم خلف القصور لوابث",53,"ث",1,0],["فدرت عجاف الشاء والعام ممحل","وأثرت وقبلا كان في عيشها شح",54,"ح",1,0],["فدَرنا ومن دنياكَ كن في قناعةٍ","ولا تبغِ أمراً لا يكون بقسمةِ",55,"ه",1,0],["فدرى بأنه كان يحيا كذبة","الحب الذي بسمومه مقتولُ",56,"ل",1,0],["فدرنا في عجاجتها جميعا","كما دارت على قطب رحاها",57,"ا",3,0],["فدَربُنَا هكذا اعوجَّت مسالكه","ودربُ صهيون بالغارات معتدلُ",58,"ل",1,0],["فَدَرْعَاْ تُصَحِّحُ سَيْرَ الزَّمَاْنِ","وَتَكْتَبُ بِالنَّصْرِ أَبْهَى السِّيَرْ",59,"ر",1,0],["فدربنا اليومَ إمَّا كانَ ذا عوجٍ","ننل بفعلِ ميولِ النَّفسِ خُسرانا",60,"ن",2,0],["فدَّرتْ ميرةً ورأتْ عجيباً","من البركات من بعد البلاءِ",61,"ا",2,0],["فدرستها درس الحكيم محللاً","ما جاء في الإنجيل والقرآن",62,"ن",1,0],["فدرب الصابرين لها سدادٌ","إذا بالله ما راموا اعتصاما",63,"م",2,0],["فدَرَى الحبُّ والمحبُّونَ أني","لأساطينِ الحب مسكُ الختام",64,"م",1,0],["فدرت إلي أن روت الركب كله","ومحلبها ما زال ملآن يفهق",65,"ق",1,0],["فدرى الغرب فصلهم حين كانت","فيه أعلامهم من النكرات",66,"ت",1,0],["فدرت لك الأمداد من ذاته التي","غدت رحمة للعلمين وسدرتي",67,"ت",2,0],["فدروسُ الخوف تستشري سريعاً","آه ما أجهلَ من يلقي ظَلامَهْ",68,"م",2,0],["فدرب الحيارى شديد الدجى","ضرير الأماني غزير الكدر",69,"ر",1,0],["فدروبي كلها تفضي إلى","نورُ مَنْ منهُ غموضي تستتب",70,"ب",1,0],["فَدُرُوبُها شَوْكٌ أَشَدُّ عليك مِنْ","خَرْط القَتَادِ ومِنْ مَذاَق العَلْقَمِ",71,"م",1,0]]}