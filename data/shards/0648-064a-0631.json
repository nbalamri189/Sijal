ِن حاضِريهِ","وَحشَةً وَالجَميعَ كَالوِحدانِ",1,"ن",1,0],["وَيَرضى إِذا قيلَ يا اِبنَ النِجادِ","وَيَدعو الجِيادَ بَناتِ الحُزُم",2,"م",1,0],["وَيَروحُ عَنهُ وَلِيُّهُ وَعَدُوُّهُ","هَذا يَزيدُ غِنىً وَهَذا يَعدَمُ",3,"م",1,0],["وَيَروعُهُ وَصفُ الشُجاعِ لِطَعنَةٍ","مِن ذابِلٍ أَو ضَربَةٍ مِن مِخذَمِ",4,"م",1,0],["وَيُرى عَزيزاً حَيثُ حَل","لَ وَلا يَرى إِلّا ذَليلا",5,"ل",2,0],["وَيَرِقُّ أَحياناً وَبَينَ ضُلوعِهِ","قَلبٌ عَلى مالِ المُثَمَّرِ قاسِ",6,"س",1,0],["وَيَرجِعُ شانيكُما شاحِباً","يُنَفِّضُ عَن مَنكِبَيهِ الغُبارا",7,"ر",2,0],["وَيَرومُ شَأوَكَ مَن غُبارُكَ دونَهُ","يَومَ الجَزاءِ غَياطِلٌ وَغَياهِبُ",8,"ب",1,0],["وَيَرتَمي بِكَ وَالأَرماحُ والِغَةٌ","طِماحَ كُلِّ أَسيلِ الخَدِّ يَعبوبِ",9,"ب",1,0],["وَيَرْوَى إِذا ما أَمْكَنَ الوِرْدُ جارُنا","وَأذْوادُنا صُعْرُ الخُدودِ ظِماءُ",10,"ا",2,0],["وَيَرْعَى حِمانَا مُطْمَئِناً جَنانُهُ","لَهُ مِنْ ظُبا أَسْيافِنا خُفَراءُ",10,"ا",2,0],["وَيَرْتَمينَ بِنَبْلٍ يَتِّخِذْنَ لَها ال","قُلوبَ عِنْدَ اسْتِراقِ اللَّحْظِ أَهْدافا",11,"ف",2,0],["وَيَرْتادُ مِنّي أَنْ أَضُمَّ على القذَى","جُفُوني وَهَلْ يَرْضَى الهَوانَ أرَيبُ",12,"ب",1,0],["ويَرْميهمُ واليومُ دامٍ عَجاجُهُ","بجُرْدٍ يُبارينَ الأعِنّةَ شُزَّبِ",13,"ب",1,0],["ويَرْجونَ منْ آلِ المُهَيّا غَطارفاً","عِظامَ المَقاري واللُّها والمآثِرِ",14,"ر",1,0],["ويُروي أنابيبَ الرِّماحِ بمأزِقٍ","يظلُّ غَداةَ الرَّوعِ بالدَّمِ مُتْرَعا",15,"ع",2,0],["ويَرْتَعُ في عِرْضي ويُقْبَلُ قَولُهُ","ولَوْ رُدَّ عنْهُ لمْ يَجِدْ فيهِ مَرْتَعا",15,"ع",2,0],["ويَروعُني لَغَطُ الوُشاةِ وقَبْلَنا","حَكَمَتْ قَبائِلُ خِنْدِفٍ في حِمْيَرِ",16,"ر",1,0],["ويَرومُ نَيلَ المَكْرُماتِ ودونَها","أمَدٌ بهِ انْتَعَلَ النَّجيعَ المَنْسِمُ",17,"م",1,0],["ويرتد ، حلم مضى","ويمضي ، بلا مرجع",18,"ع",1,0],["وَيُرجى الوَصلُ بَعدَ الهَجرِ حين","كَما يُرجى الدُنُوُّ مِنَ البِعادِ",19,"د",1,0],["ويرْغَبُ في نُعْماهُ كلَّ مؤمّلٍ","ويَرْهَبُ بؤساهُ أميرٌ ومأمورُ",20,"ر",1,0],["ويرى الحقائق من وراء حجابها","لا فرق بين شهادة ومغيب",21,"ب",1,0],["وَيُروي النَبيطُ الزُرقُ مِن حَجَراتِهِ","دِياراً تُرَوّى بِالأَتِيِّ المُعَمَّدِ",22,"د",1,0],["وَيَروضُهُ حَتّى يَرى أُسطولَهُ","خَشَباً تَناثَرَ فَوقَ ظَهرِ عُبابِ",23,"ب",1,0],["وَيَرى صُنوفاً مِن ذَكاءٍ صُفِّفَت","دونَ الحِمى تُعيي أُسودَ الغابِ",23,"ب",1,0],["وَيَرى الفَتحَ اِدِّعاءً باطِلاً","وَاِفتِراءً وَاِحتِجاجاً وَاِحتِكاما",24,"م",2,0],["ويُرْكِبُوكَ على البِرذَونِ تَقدمُهُ","خَيلٌ مُطَهَّمَةٌ تَحلُو مَرائيها",25,"ي",3,0],["وَيُرهِفُ مِن عَزائِمِ آلِ مِصرٍ","إِذا خارَت لَدى الخَطبِ الجَسيمِ",26,"م",1,0],["وَيُرى لابِساً صُنوفَ ثِيابٍ","وَهوَ ذو فاقَةٍ حَليفُ اِفتِقارِ",27,"ر",1,0],["وَيَرضى أَن تَضيعَ سُدىً حُقوقي","وَباعي في الهَوى باعٌ طَويلُ",28,"ل",1,0],["وَيُرخينَ أَذناباً كَأَنَّ فُروعَه","عُرا خِلَلٍ مَشهورَةٍ ضَفِراتِ",29,"ت",1,0],["وَيَرتاحُ لِلمَعروفِ في طَلَبِ العُلى","لِتُحمَدَ يَوماً عِندَ لَيلى شَمائِلُه",30,"ل",2,0],["وَيَرفَعُ نَصلَ السَيفِ عَن كَعبِ ساقِهِ","وَلَو أَطوَلَ القَينُ الحَمائِلَ عاتِقُه",31,"ق",2,0],["وَيَرُدَّ بادِرَةَ العَدُوِّ","وَنَخوَةَ الشَنِفِ المُكاشِح",32,"ح",1,0],["ويرسم بين أنوار","يهيئها وأظلال",33,"ل",1,0],["وَيَرَى صَحْبُكَ الأُولَى بِنْتَ عَنْهُمْ","رُوحَكَ الحَيَّ فِي حِلىً لا تَبينُ",34,"ن",1,0],["وَيَرُدُّ كَيْدَ خُصُومِهِمْ فِي نَحْرِهِمْ","بِلِسَانِ صِدْقٍ دَامِغِ البُرْهَانِ",35,"ن",1,0],["وَيَرْفَعُ الصَّوْتَ كُلٌّ","بِذِكْرِهَا تَأْبِينَا",36,"ن",2,0],["وَيَرُوحُ عَدْلِيَّ وَيَغْدُو سَاعِياً","لَيِقاً إلى الغَايَاتِ فِي اطْمِئْنَانِ",37,"ن",1,0],["وَيَرْفَعُ التَّسْيِيحُ فِيهَا بِمَا","يَلِيقُ مِنْ حَمْدِ وَشُكْرَانِ",38,"ن",1,0],["وَيُرْضِيهِ فِي الإِعْسَارِ مُوْفُورُ مَجْدِهِ","وَلَيْسَ إِذَا الإِيسَارُ فَاتَ بِنَاقِمِ",39,"م",1,0],["وَيَرَى النِشْءُ فِي مَنَاهِجِهِ البَيْضَاءَ","سُبُلَ العُلَى وَالاسْتِقْلاَلِ",40,"ل",1,0],["وَيَرّفضُّ لَهُ اللَّحنُ","فما تُفتَق أَرتَاقُه",41,"ق",2,0],["ويُرسلُ صوبَ القطر من فيض أدمعي","ويقدحُ زند البرق من نار أشجاني",42,"ن",2,0],["ويردّ الوجوه مستبشراتٍ","ويرد الثغور ذات ابتسام",43,"م",1,0],["ويَروم صبرك وهو يَسقيك الرَدى","ويُريد شكرك وهو لم يتفضل",44,"ل",1,0],["ويردَّ العدوّ عنكم ويحمي","عيشكم من شوائب التنكيد",45,"د",1,0],["ويرون الجُسام أمراً صغيراً","ويرون الصغير أمراً جساما",46,"م",2,0],["ويرجع عنه من يوافيك راجلاً","على لاحق الآطال من نسل لاحق",47,"ق",1,0],["ويرمي بها في قعر أظلم موحشٍ","به أين تسقطْ جذوة الروح تَخمَد",48,"د",1,0],["وَيَرمينَ القُلوبَ بِنَبلِ جِنٍّ","فَقَد أَقصَدنَ قَلبَكَ إِذ رَمَينا",49,"ن",2,0],["وَيَربوعٌ هُمُ أَخَذوا قَديماً","عَلَيكَ مِنَ المَكارِمِ كُلَّ بابِ",50,"ب",1,0],["وَيَربوعٌ فَوارِسُ غَيرُ مَيلٍ","إِذا وَقَفَ الجَبانُ عَنِ الطِرادِ",51,"د",1,0],["وَيَروي عَلَيَّ الشِعرَ ما أَنا قُلتُهُ","كَمُعتَرِضٍ لِلريحِ بَينَ الطَرائِدِ",52,"د",1,0],["وَيَريبُ مَن رَجَعَ الفَراسَةَ فيهِمُ","رَهَلُ الطَفاطِفِ وَالعِظامُ تَخَرَّعُ",53,"ع",1,0],["وَيَرجو أَميرَ المُؤمِنينَ وَسَيبَهُ","مَراضيعُ مِثلُ الريشِ سُفعُ المَدامِعِ",54,"ع",1,0],["وَيَرجوكَ مَن لَم تَستَطِعكَ رِكابُهُ","وَيَرجوكَ ذو حَقٍّ بِبابِكَ ضائِفُ",55,"ف",1,0],["وَيَربوعٌ تَحُلُّ ذُرى الرَوابي","وَتَبني فَوقَها عَمَداً طِوالا",56,"ل",2,0],["وَيَربوعٌ تُذَبِّبُ عَن تَميمٍ","وَيَقصُرَ دونَ غَلوِهِمُ المُغالي",57,"ل",2,0],["وَيَرضَعُ مَن لاقى وَإِن يَلقَ مُقعَداً","يَقودُ بِأَعمى فَالفَرَزدَقُ سائِلُه",58,"ل",2,0],["وَيَرى مُساعَدَةَ الكِرامِ مُروءَةً","ماسالَمَتهُ نَوائِبُ الحَدَثانِ",59,"ن",1,0],["ويراعةً تسطو فيقرَعُ سنها","خجلاً قوامَ الصعدة السمراء",60,"ا",2,0],["ويراع خيف مضربُه","فذكور البيض في طمث",61,"ث",1,0],["ويراعاً بصدرهِ يتلقَّى","كلّ راجٍ يسعى إليه ولاجي",62,"ج",2,0],["ويراعٌ من حدِّه ونداه","كادَ بينَ السيوف أن يتحدَّى",63,"د",2,0],["ويرجع بعد جهدٍ عن مداه","بلا حظٍّ خلا نفس نهير",64,"ر",1,0],["ويراعة حسد السلاح مضاءها","في كلِّ ما تنهى به أو تأمر",65,"ر",1,0],["ويروي أحاديث الثناءِ صحيحةً","عطاءٌ لنا من راحتيك وجابر",66,"ر",1,0],["ويرفع طرفي للصبابة قصةً","فتجرِي على عاداتهنَّ المدامع",67,"ع",1,0],["ويرى لي حقًّا عليه وهيها","ت له لا لحقيَ التحقيق",68,"ق",1,0],["ويراعة ألفاظها مشمولةٌ","تشفي وجمع فخارها مشمول",69,"ل",1,0],["ويراعة تذر الركائب والعدى","ما بين نزل مكارمٍ ونزال",70,"ل",1,0],["ويردني عن باب ساداتي امرؤ","مفتاح بابهمُ لمثليَ أمثل",71,"ل",1,0],["ويراعة حمر الإهاب كأنها","ألف