راني الناس روحاً طائراً","والجَوى يطحنني طحن الرحى",165,"ح",2,0],["ويرف مثل الزهر وهو ندي","ويخف مثل عرائس الحلم",166,"م",1,0],["وَيُرْسِلُهَا في مائِها فيُعِيدُهَا","إِلى رَاحَتي ساقٍ على حُكمِهِ تَجري",167,"ر",2,0],["وَيَرُدُّ سُمرَ الطعنِ عن أَرضِ العِدى","وكَأَنّها في صِبْغَةِ الفرصادِ",168,"د",1,0],["ويَرْمِ على الخوفِ عَزْماً بعَزْمٍ","وليلاً بليلٍ وبيداً ببيدِ",169,"د",1,0],["ويرْتَقِي حَرُّ أنْفاسي فَأَبْعَثُهُ","بَرداً وإن كان مُسْتبَقى من اللهبِ",170,"ب",1,0],["ويرشّ سيفي بالنجيعِ مصارِعاً","للأسْدِ يُسْكنها بذيل عسيبهِ",171,"ب",2,0],["وَيُريكَ ما اِلتَبَسَت عَلَيكَ وُجوهُهُ","حَتّى تُعانِيَهُ بِأَحسَنِ مَنظَرِ",172,"ر",1,0],["وَيَرشُفُ دوني لِثامٌ لَهُ","نَدى أُقحُوانٍ حَلا رَشفُهُ",173,"ف",2,0],["وَيَركَبُ مِن ريحِ الصَبا مَتنَ سابِحٍ","كَريمٍ وَمِن لَيلِ السُرى ظَهرَ أَبلَقِ",174,"ق",1,0],["وَيَرمي بِسَهمٍ لا يَطيشُ مُفَوَّقٍ","يُقَرطِسُ في يُمنى سَعيدٍ مُوَفَّقِ",174,"ق",1,0],["وَيَرمينَ أَكنافَ العَقيقِ بِنَظرَةٍ","تَرَدَّدُ في تِلكَ الرُبى وَالمَعالِمِ",175,"م",1,0],["ويرى النّاسَ إذا أعجبه","أن يَبيدوا كأقاطيعِ البَهَمْ",176,"م",1,0],["ويُرمَى ذو البراءةِ من ذوينا","بملءِ الأرضِ من إثمٍ وحُوبِ",177,"ب",1,0],["وَيُراعُ من ذِكرِ الحياةِ كأنّما","يَجِدُ الحياةَ من المخافةِ غُولا",178,"ل",2,0],["ويَرى عليه لنفسه","حقَّ الزّميلِ على الزّميلْ",179,"ل",1,0],["وَيَرَونَ غَمرَتَها وَمَوقِفَ أَهلِها","يَتَنازَعونَ سَبيلَها وَالمَذهَبا",180,"ب",2,0],["ويرى المحجَّةَ كلُّ غاوٍ مِنهمُ","فَيكفَّ عن طُغيانِهِ وعُرامِهِ",181,"م",2,0],["ويرتاح إلى النجوى","وفي النجوى يحييك",182,"ك",1,0],["ويرفُّ من شظف المعيشة لينها","ويسيل من وهج السَّراب الماءُ",183,"ا",2,0],["وَيَرى اللَئيمُ غَنيمَةً في مالِهِ","سَبَّ الكَريمِ إِذا الكَريمُ أَجابَهُ",184,"ب",2,0],["وَيَرضى بَصِيرٌ خَلقَهُ وَهوَ مُدبِرٌ","كَما هُوَ راضٍ خَلقَهُ وَهُوَ مُقبِلُ",185,"ل",1,0],["وَيَرفَعنَ نَقعاً كَالمُلاءِ مُهَلهَلاً","تَموجُ عَلى ظَهرِ البِلادِ مَوائِجُه",186,"ج",2,0],["وَيَرْمِي العِدا مِنْ كَفِّهِ بِصَواعِقٍ","وَأَنْمُلُها أنهارُ جُودٍ تَحَدَّرُ",187,"ر",1,0],["ويرضيك منه قلبُ الأمر حولٌ","فتوق لما يُعيي الأنامَ رَتُوق",188,"ق",1,0],["ويُرَدِّدُ الصُّعَداءَ من أنفْاسِهِ","حتى تكادَ النّارُ منها تُشْعَل",189,"ل",1,0],["وَيَرى الجُمعَةَ كَالسَب","تِ وَكَاللَيلِ النَهارا",190,"ر",2,0],["وَيَردُدنَ عُرى الأَمرِ","إِلى أَحوَرَ مُستَقضى",191,"ض",2,0],["وَيَروحُ أَطوَلَهُم يَداً","في فِعلِهِم وَعَلَيكَ شاهِد",192,"د",1,0],["وَيُريكَ خَيراً في غَدٍ","وَلِذَلِكَ الغَتَلِيِّ زائِد",192,"د",1,0],["وَيَرجِع إِلى غَسّانَ مُلكٌ وَسُؤدُدٌ","وَتِلكَ المُنى لَو أَنَّنا نَستَطيعُها",193,"ع",3,0],["وَيَرفَعُ شَربُها لَغطاً بِجَهلٍ","كَأَسرابٍ وَرَدنَ مُسَدَّماتِ",194,"ت",1,0],["وَيَرفَعنَ المَقالَ عَلَيكَ جَهلاً","وَيَنفِدنَ الذَخائِرَ مُغرِماتِ",194,"ت",1,0],["وَيُرسِلُ صَقراً لِلمَنونِ مُسَلَّطاً","فَيظفَرُ مِن أَبطالِنا بِخِشاشِ",195,"ش",1,0],["وَيَرزُقُني اللَهُ الَّذي قامَ حُكمُهُ","بِأَرزاقِنا في أَرضِهِ مُتَكَفِّلا",196,"ل",2,0],["وَيُرزَءُ جِسمُ المَرءِ حَتّى إِذا أَوى","إِلى العُنصُرِ التُربِيِّ لَم يُرزَإِ الجِسمُ",197,"م",1,0],["وَيَرجو أَن يُزيلَ الغُلَّ صادٍ","إِذا سَمِعَ الرَواعِدَ يَرتَجِسنَه",198,"ن",2,0],["وَيَرى الشَرائِعَ في عَظيمِ جَلالِها","سَيفَ المُغيرِ وَمِخلَبَ المُتَحَكِّمِ",199,"م",1,0],["وَيراع إن أحجمت في مكر","صافنات الأقلام فهو يجول",200,"ل",1,0],["ويرزي بفحل الشعر ناسٌ حسادةً","أولئك فحل الشعر أيضاً بهم يزرى",201,"ر",2,0],["ويريني الزمان وجهاً عبوساً","فأدارى عبوسهُ بابتسامي",202,"م",2,0],["ويروع عيني حسنه","ويبين فيه الجوهر",203,"ر",1,0],["وَيَرمين بالألحاظ من يبتدرنه","وإن الَّذي يَرمينه لصريع",204,"ع",1,0],["ويرسل من عينيه نظرة مُجهِشٍ","وما هو بالباكي ولا العين تدمع",205,"ع",1,0],["ويَرى ابنُ دَأْيَةَ أنَّها من غِرْقِئِ الطْ","طَيرِالعَكوفِ مُلوكِها وسِباعِها",206,"ع",3,0],["ويرى عروق نياطها في نحوها","والمخ في تلك العظام النحل",207,"ل",1,0],["وَيُرْفَعُ إعْصَارٌ من الطّيبِ لا يُرَى","عليه انتِصارٌ كلّما سُحِبَ المِرْط",208,"ط",1,0],["وَيُرجى الوَصلُ بَعدَ الهَجرِ حيناً","كَما يُرجى الدُنُوُّ مِنَ البِعادِ",209,"د",1,0],["وَيَرِقُّ مَشْحُوذاً بِهَا","فَإِذَا أَصَابَ فَقَدْ قَصَمْ",210,"م",1,0],["وَيَرَاعَةٌ تُلْقِي مُجَاجَتهَا","شهْداً فَيُحْدِثُ فِي النُّهَى سُكْرَا",211,"ر",2,0],["وَيَرَى مِنَ المُزْرِي تَكَلُّفَ سَيِّدٍ","فِي يَوْمِ صِدْقٍ أَنْ يَقُولَ كِذَابا",212,"ب",2,0],["ويَرَى الفَخْرَ أَنْ يَكُونَ طَلِيقاً","مِنْ قُيُودِ الظَّوَاهِرِ الْجَوْفَاءِ",213,"ا",2,0],["وَيَرى كَوَرْيِ الزَّنْدِ خَاطِرُهُ بِمَا","يَجرِي عَلَى قَلَمٍ لَهُ سَيَّالِ",214,"ل",1,0],["وَيَرْشُفُ كُلٌ مِن جَبِينِ حَبِيبِهِ","دُمُوعَ النَّدَى خَمراً رَحِيقاً فَيَثْملُ",215,"ل",1,0],["وَيرُوعُنِي شَجَنٌ بِهِ","كَشجىً بِحَلْقِ مُوَدِّعِ",216,"ع",1,0],["وَيُرضِيني أَزَمَّ الْعَيْشِ أَني","إِذَنْ فِي غَيْرِ مَحْمِدَةٍ صَبُورُ",217,"ر",1,0],["وَيَرْجِعُ مِنْهَا الْعَلِيلُ الْكلِيلُ","بِجِسْمٍ يَصِحُّ وَعَيْنٍ تَقَرْ",218,"ر",1,0],["وَيَرْعِى ذَوِي رِعَايَةَ وَالِدٍ","فَأَبْنَاؤُهُ كُثْرٌ وَمَا هُوَ وَالِدُ",219,"د",1,0],["وَيَرأَبُ الصُّدُوعَ فِي أُمَّتهِ","بِحِكْمَةٍ تَشْفِي مِنَ الأَحْقَادِ",220,"د",1,0],["وَيَرى الصَّعاب فَمَا يزالُ بِهَا","حَتَّى يُبَدِّل عُسرَهَا يُسْرَا",221,"ر",2,0],["وَيَرجونَ إِدراكَ العُلا بِنُفوسِهِم","وَلَم يَعلَموا أَنَّ المَعالي مَواهِبُ",222,"ب",1,0],["ويرضى صاحب السلطان","أن نفنى وأن يبقى",223,"ق",2,0],["ويرسلني في هبوب الرياح","وفي عاصفات الغبار",224,"ر",1,0],["وَيَرونَ الصُبحَ مِثلَ الدَياجي","وَالمَعاني غُيَّبٌ عَن غَبِيِّ",225,"ي",1,0],["وَيُرخينَ أَذناباً كَأَنَّ فُروعَها","عُرا خِلَلٍ مَشهورَةٍ ضَفِراتِ",226,"ت",1,0],["وَيَرْميكَ ذَمِّي بِالتي لا شَوَى لَها","وَلَيْسَ يَسُوءُ الوَغْدَ لَذْعُ القَوارِصِ",227,"ص",1,0],["ويرعد متنه من غير هزٍّ","كريعان السراب زهاه ريع",228,"ع",1,0],["وَيَرَى مِنْ وَرَائِهَا كُلَّ سِرٍ","جَلَّ مَكْنُونُهُ عَنِ الإفْشَاءِ",229,"ا",2,0],["ويَرى حبّه للدولةِ عثما","نَ شعاراً لصادقِ الإيمان",230,"ن",1,0],["ويَرْسُم أندُلُساً باليَرَاعِ","فتلمِسُ كفُّك أَسْوارها",231,"ر",3,0],["ويَروْنَ الأَمْوالَ تُنْثَرُ في اللّهْوِ","فلا يَجْزَعون لِلأَمْوَالِ",232,"ل",1,0],["ويَرَى الحقَّ في جَلالةِ معنا","هُ فيحيا في ضَوْءِ هذا الْجَلالِ",232,"ل",1,0],["ويرسُمُ الماضيَ المولِّي","كعهده باسماً سعيدا",233,"د",2,0],["ويَرْقب رَبَّ العَرْشِ فِيما يُريدُه","ويَنْصُرُ دِينَ الْحَقِّ والنُّورِ والهُدَى",234,"د",2,0],["ويَرْجُو لَوَ انّ الفَجْر عُوِّقَ خَطْوُه","وطاشَ به نَائي الطَّرِيقِ وجَائِرُهْ",235,"ر",2,0],["ويرقُمُ في الغديرِ سطورَ وَحْيٍ","وعاها الطيرُ حين شدا فأشْدى",236,"د",2,0],["وَيَرى الْحُتوفَ وَقَدْ مَلأْنَ طَرِيقَه","نَارَ الْحُبَاحِبِ أَوْ وَمِيضَ الآل",237,"ل",1,0],["ويرتجزُ الأعداءُ هذا برمحه","وهذا بسيفٍ حدّهُ ناقعُ الحبرِ",238,"ر",1,0],["ويرى كلُّ منصفٍ أنَّ مصرًا","وطنٌ للأحرار لا للعبيد",239,"د",1,0],["ويَرمُّ الجراحَ، وهي عصيَّا","تٌ، إذا مدَّ للجراح يمينا",240,"ن",2,0],["ويردُّ العدوانَ كيلاً بكيلِ","لو رماه الزمانُ، يرمي الزمانا",241,"ن",2,0],["ويراعُ الأديبِ ليس يراعًا","في يمين الأديب بل صَولَجانا",241,"ن",2,0],["ويرون جَوْف الرمل أجملَ فُنْدُق","وروائحَ البارُود تنفح عَنْبَرا",242,"ر",2,0],["ويرون قَصْف المِدْفعيَّة أُرْغُنًا","يَشجي، وقعقعةَ الحناجر مِزْهرا",242,"ر",2,0],["ويَروْن أن الجُرح يحكي مُقْلةً","حوراء، والدم كالشراب مُعَصْفرا",242,"ر",2,0],["ويَروْن أن من اسْتُبِيحَ له حِمًى","يلقى المنايا، أو يعيشُ مُحَرَّرا",242,"ر",2,0],["ويربط بيننا نَسَب، وصِهْرٌ","ويجمع بيننا فِيه اتَّجار",243,"ر",1,0],["ويُرْسَى للسَّلام به أساسٌ","ويُكتَبُ للحضارة الازدهار؟",243,"ر",1,0],["ويرن مذياع فيمسي مطربا","في زحمة التصفيق والأرهاف",244,"ف",1,0],["ويريق آلاف الكؤوس","أسى على الكأس المراقة",245,"ق",2,0],["ويرف الهم يبريني","ويَدْعُونِي الهَوَى بُكْرَهْ",246,"ر",2,0],["وَيَرُدُّ غُفْرَتَهُ إِلى يافوخِهِ","حَتّى تَصيرَ لِرَأسِهِ إِكليلا",247,"ل",2,0],["ويَرْهَبُ منْ هامِ الملُوك غَفيرُ","وَيَجْمعُ مِنْ أشْلاَئهِمْ مُتَفَرِّقاً",248,"ر",3,0],["ويُردفهُ صوبُ المعاني فيزدَهي","زَها الروضُ عن صوب الحيا المتدِّفق",249,"ق",1,0],["ويراجعانِ تَلاوُماً","نفْسَيهما ، صُنعَ المُريب",250,"ب",1,0],["ويرُد أنصبةً أليهم","ما حَبوه من نَصيب",250,"ب",1,0],["ويرهق بالتفكير نفساً عزيزةً","ليُعتِقَ رِقّاً او ليُرشدَ غاويا",251,"ي",2,0],["ويَرْفِدها الفكر الغزير كأنه","مصبُّ غدير طافحات ٌ مُتونه",252,"ن",2,0],["ويُرونَ ضيفَهُمُ الكرامةَ تُزدَرى","والحقَّ يُغصَب ، والديارَ تُضام",253,"م",1,0],["ويراني من ليس يدري كأني","بِيَ مسٌ وقد أكونُ كذالك",254,"ك",1,0],["ويَرَى تارة من اليأس من لُقياكِ","مستسلماً بغَير حرَاك",254,"ك",1,0],["ويرعَوْن في هذَرٍ يابسٍ","من القولِ ، رعيَ الجمالِ الكلا",255,"ا",1,0],["ويرى الطفلُ أنَّ حصتَّه إذْ","يُخصبُ الوالدان ثوبٌ قشيب",256,"ب",1,0],["ويَرُدُّ حلمَ الحالمين على","أعقابِهِ التفتيرُ والخَفَر",257,"ر",1,0],["ويريدُ العَدْل في أحكامه","والمساواةَ وان عزَّتْ مَنالا",258,"ل",2,0],["ويَرْخينَ أذْناباً كَأنّ فُرُعَهَا","عُرَى خِلَلٍ مَشهورَة ٍ ضَفِرَاتِ",259,"ت",1,0],["ويروي النّبطُ الرّزقُ من حجراتهِ","دِيَاراً تُرَوّى بِالأتّي المُعَمَّدِ",260,"د",1,0],["وَيَرْجْعُ اللّيلُ مُبيَضّاً إذا ابَتَسَمَتْ","عَنْ أبْيَضٍ خضلِ السِّمْطَينِ لَمّاحِ",261,"ح",1,0],["ويَرْمِ على الخوفِ عَزْماً بعَزْمٍ","وليلاً بليلٍ وبيداً بيد",262,"د",1,0],["ويراها لديه أشرف شيء","وهي أدنى من الأكور الدنيّة",263,"ي",2,0],["ويرفعْنَ المقالَ، عليك، جهلاً،","ويُنفِذن الذّخائر مغرِمات",264,"ت",1,0],["وَيَرْقِيني لَكَ الحَاوُونَ حَتَّى","أجابكَ حيَّة ٌ تحتَ الحجابِ",265,"ب",1,0],["ويروى وليس في السيئاتِ أكسبها","بعهدٍ أمرٍ إذا امرؤٌ فتكا",266,"ك",2,0],["ويروي وعلَّيْته لما حللت عقالَهُ","بأصفرَ من أقذار بطنك وارس",267,"س",1,0],["ويركب الجهلُ الطريق العاندا","واعلم وإنكنتَ صليباً ماردا",268,"د",2,0],["ويروى له يصف حمار الوحش: يُطَرِّدُ عاناتٍ بِرهبَى فبَطنُه","خَميصٌ كطَيِّ الرّازِقيَّة ِ مُحنِقُ",269,"ق",1,1],["ويَرْقب رَبَّ العَرْشِ فِما يُريدُه","ويَنْصُرُ دِينَ الْحَقِّ والنُّورِ والهُدَى",270,"د",2,0],["ويرمى ذو البراءة من ذوينا","بملء والأرض من إثم وحوب",271,"ب",1,0],["ويرون غمرتها وموقف أهلها","يتنازعون سبيلهم والمذهبا",272,"ب",2,0],["ويرمي سفينته للحريق","ةتنشد أهدابه : لا ارتداد",273,"د",1,0]]}