ttps://www.aldiwan.net/poem53972.html","الطويل"],[455,"حيا دمشق فكم فيها لذي وطر","https://www.aldiwan.net/poem13761.html","البسيط"],[455,"ما للرياض تنمنمت أدواحها","https://www.aldiwan.net/poem13951.html","الكامل"],[456,"ترفع عن معاداة الكريم","https://www.aldiwan.net/poem61339.html","الوافر"],[456,"حلمت ولم أعلم أحلمى يقظة","https://www.aldiwan.net/poem61799.html","الطويل"],[461,"أخوي والعشاق إخوه","https://www.aldiwan.net/poem55820.html","مجزوء الكامل"],[464,"إذا ما الجياد الجرد شدت لغاية","https://www.aldiwan.net/poem16225.html","الطويل"],[467,"لقد أهدت كتابك منك كف","https://www.aldiwan.net/poem3352.html","عموديه"],[467,"أشرب على ورد الخدود وغنني","https://www.aldiwan.net/poem3431.html","عموديه"],[482,"من للثكالى وللجرحى وأيتام","https://www.aldiwan.net/poem37205.html","البسيط"],[482,"الذكر أبقى لكم والمال عارية","https://www.aldiwan.net/poem37207.html","البسيط"],[496,"فليالي الصبا أسر ليال","https://www.aldiwan.net/poem67307.html","الخفيف"],[503,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[512,"هل عرفت الغداة رسماً محيلا","https://www.aldiwan.net/poem751.html",""],[517,"هذا الحمى فانزل على جرعائه","https://www.aldiwan.net/poem20799.html","الكامل"],[541,"السحر هذا ما أرى","https://www.aldiwan.net/poem48280.html","عموديه"],[546,"عجلا اليوم صاحبي رواحا","https://www.aldiwan.net/poem1764.html","الخفيف"],[554,"وحللت من قلبي وأنت بخيلة","https://www.aldiwan.net/poem47182.html","الكامل"],[570,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[570,"أمر عيش وحال خفض","https://www.aldiwan.net/poem69620.html","مخلع البسيط"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[731,"","https://poetry.dctabudhabi.ae/diwan/poem/199903","الطويل"]],"verses":[["وَأُسرَةِ عِزٍّ طِوالِ القَنا","إِذا نَزَلَ الذُلُّ قالوا اِرحَلِ",0,"ل",1,0],["وَأَسرَفتُ بِالبِشرِ حَتّى ظَنَن","تُ أَنَّكَ أَضجَعتَ فيهِ النِفاقا",1,"ق",2,0],["وَأَسري إِلَيها وَالهَوى يَستَفِزُّني","بِمُحمَرَّةِ الأَخفافِ فُتلِ المَرافِقِ",2,"ق",1,0],["وأسْري بعيسٍ كالأهِلّةِ فوقَها","وُجوهٌ منَ الأقْمارِ أبْهى وأنْوَرُ",3,"ر",1,0],["وَأَسرَفَ في حُبِّ الحَياةِ فَحاطَها","بِسورٍ مِنَ الأَهوالِ لَم يَنجُ راكِبُه",4,"ب",2,0],["وَأَسرَعَ في الفَواحِشِ كُلُّ طِملٍ","يَجُرُّ المُخزِياتِ وَلا يُبالي",5,"ل",2,0],["وَأَسرَعَ فيها قَبلَ ذَلِكَ حِقبَةً","رُكاحٌ فَجَنبا نُقدَةٍ فَالمَغاسِلُ",6,"ل",1,0],["وَأُسِرتُ في مَجرى خُيولي غازِياً","وَحُبِستُ فيما أَشعَلَت نيراني",7,"ن",2,0],["وَأَسرٌ أُقاسيهِ وَلَيلٌ نُجومُهُ","أَرى كُلَّ شَيءٍ غَيرَهُنَّ يَزولُ",8,"ل",1,0],["وَأَسَرنا مِنكُمُ أَعدادَهُم","فَاِنصَرَفتُم مِثلَ إِفلاتِ الحَجَل",9,"ل",1,0],["وأسرة جانسوا إذا حكموا","إكراه عدل القضا بإكرامه",10,"م",2,0],["وأسرِجِ المركبَ المعرَّى","قبلَ ورودِ الوغى وألجِمْ",11,"م",1,0],["وَأَسرَعَها إِلى الأَعداءِ سَيراً","إِذا ما اِستُبطِئَ الفَرَسُ الجَرورُ",12,"ر",1,0],["وَأَسرَعتَ إِلى السَيفِ أَوِ السُمِّ أَوِ النارِ","لِكَي تَخرُجَ مِنَ دُنيا ذَوُها غَيرُ أَحرارِ",13,"ر",1,0],["وأَسرابُ ذاكَ الفَراشِ الأَنيقِ","ونَحْلٌ يُغنِّي وغيمٌ يَمُرْ",14,"ر",1,0],["وأسرفت تبغى عريض الغنى","أقبلك من ناله بالسرف",15,"ف",1,0],["وَأَسرَعُ مَفعولٍ فَعَلتَ تَغَيُّراً","تَكَلُّفُ شَيءٍ في طِباعِكَ ضِدُّهُ",16,"د",2,0],["وَأَسري في ظَلامِ اللَيلِ وَحدي","كَأَنّي مِنهُ في قَمَرٍ مُنيرِ",17,"ر",1,0],["وَأَسرِجَتِ الكُمَيتُ فَناقَلَت بي","عَلى إِعقاقِها وَعَلى غِشاشي",18,"ش",2,0],["واسرقْ من الأيامِ حظ","ظَكَ من حَلالٍ أو حرامِ",19,"م",1,0],["وَأَسرَينَ لَيلاً فَخِلنا بِهِن","نَ مَثنى النُجومِ وَوُحدانَها",20,"ن",3,0],["وَأَسرارُ المَلاحِظِ لَيسَ تَخفى","وَقَد تُغري بِذي اللَحظِ الجُفونُ",21,"ن",1,0],["وأَسرفَ في الوَدادِ على التَّنائي","فحينَ دَنَوْتُ أسرفَ في الشِّقاقِ",22,"ق",1,0],["وَأَسرَعتُ في ديني وَلَم أَقضِ بُغيَتي","هَرَبتُ بِديني مِنكِ إِن نَفَعَ الهَرَب",23,"ب",1,0],["وَأَسَرُّ ما يُلقى الفَتى في نَفسِهِ","يَبتَزُّهُ نابُ الزَمانِ وَمَخلَبُه",24,"ب",2,0],["وَأَسرَعُ ما يَكونُ الشَيءُ نَقصاً","فَأَقرَبُ ما يَكونُ إِلى كَمالِه",25,"ل",2,0],["وَأُسرِحُ في حِمى جَيرونَ طَرفي","وَأَربَعُ في رِياضِ النَيِّرَينِ",26,"ن",1,0],["وأسرها بحكاية وقعت","ورواية من نسج أفكاري",27,"ي",1,0],["وَأَسرى تَحتَ نَجمٍ من سناني","إِذا نَجمٌ عنِ الأَبصارِ غابا",28,"ب",2,0],["وأسرقُ ما استطعتُ منَ المعاني","فإنْ فقتُ القديمَ حمدْتُ سيري",29,"ر",2,1],["وَأَسرِج لِيَ الدَهماءَ وَاِذهَب بِمِمطَري","وَلا تُعلِمَن حَيّاً مِنَ الناسِ مَذهَبي",30,"ب",2,0],["وَأَسري فَأَستَصفي مِنَ السَيفِ صاحِباً","وَأَركَبُ مِن ظَهرِ الدُجُنَّةِ أَدهَما",31,"م",2,0],["وَأَسرى إِذا ما ذُو الهَوى هالَهُ السُرى","وَأُعمِلُ لَيلَ الناجِياتِ اليَعامِلِ",32,"ل",1,0],["وَأَسرَفوا في لَكمِهِ وَدَفعِهِ","وَاِنطَلَقَت أَكُفُّهُم في صَفعِهِ",33,"ه",1,0],["وَأُسرَةُ ثابِتٍ وَجُموعُ كَلبٍ","سَرى بِحِمامِهِم مِنّا اِعتِكارُ",34,"ر",1,0],["وَأَسرَوا عَلى الخَيلِ العِتاقِ وَأَصمَتوا","نَواطِقَها إِلّا تَحَمحُمَ هائِبِ",35,"ب",1,0],["وَأَسرارُ بَعضِ الناسِ باتَت لِناظِرٍ","كَأَسرارِ كَفٍّ غَيرِهِنَّ خَوافي",36,"ف",2,0],["وَأَسرَعَ مِنّا إِن طُرِدنا اِنصِرَافةً","وأَكرَمَ مِنّا إِن طَرَدنا وأَظفَرا",37,"ر",2,0],["وَأَسرَعَ مَّنا إِن أَرَدنا اِنصِرافةً","وَأَكثَرَ مِنّا دَارِعينَ وحُسَّرا",38,"ر",2,0],["وأسرَّا في إذن رضوان شيئاً","فأباح الجواز وهو عسير",39,"ر",1,0],["وأسرجت الكميت فناقلت بي","على إعقاقها وعلى غشاش",40,"ش",1,0],["وَأَسْرَعُ مُنْجِدٍ إِنْ جَدَّ جَدٌّ","يُقِيلُ مِنَ العِثَارِ المُسْتَقِيلا",41,"ل",2,0],["وَأَسرَعَت في صَرعِهِ مِثلَما","تَأخُذُ كَفّك الحاسِد اللَقطا",42,"ط",2,0],["وأسراب الجحيمِ مُحلِّقاتٍ","إذا ما حوَمتْ قذفتْ ضِرامَا",43,"م",2,0],["وأسرَفَ الشيوخُ في الخصامِ","واحتدمتَ معركةُ الكلامِ",44,"م",1,0],["واسرحي في الرياض من ملكوت الله","ترعين فيضه في فضاها",45,"ا",3,0],["وإسراعها في الغي إسراع آمن","وناقد أعمال العباد بصير",46,"ر",1,0],["وأسرع ينضو ثوبها متنصلا","وربك يدري ما تكن الضمائر",47,"ر",1,0],["وأسرّت قدسا وأبدت شعارا","خلفه لو علمت ألف شعيره",48,"ر",2,0],["وأسرعت في خطاها فوق طاقتها","فأصبحت وهي تشكو الأيْنَ والسأما",49,"م",2,0],["وأسرح وفي بالي انّه في حدا . دربينه","ياقبل بيته ببيتين .. أو على دوّاااره",50,"ر",2,0],["وأسْرَيْنَ لَيْلاً، فخِلْنَا بهِ","نّ مَثنى النّجومِ ووُحْدانَهَا",51,"ن",3,0],["واسرق من الكنز المقدّس مغربا","حلو الأصيل ومشرقا لمّاحا",52,"ح",2,0],["وأسرّ الشكوى حياء وكبرا","ربّ شكوى إسرارها إعلان",53,"ن",1,0],["وأسرف في الذكرى لأنزح نبعها","ولكنّ نبع الذكريات جموم",54,"م",1,0],["واسرارهم طيارة الطور للعلا","مجردة عما سوى الحب يا خلي",55,"ل",2,0],["وأسرار بلب دمي أقامت","بلبي في القعود وفي القيام",56,"م",1,0],["واسَرحْ سَوامَك في رياضِ سعادةٍ","وعميمِ عُشْبٍ بالعلاء منوِّرِ",57,"ر",1,0],["وَأَسرَعُ في مَنعِ الذِمارِ إِجابَةً","إِذا نادَتِ الأَبطالُ هَل مِن مُقارِعِ",58,"ع",1,0],["وَأَسرى بِهِ إِذ كَمَّلَ اللَهُ سِنَّهُ","مَراقيهِ في الإِسراءِ تَقضي بِأَنَّهُ",59,"ه",1,0],["وَإِسراؤُهُ يَبدو بِهِ الفَضلُ وَالفَصلُ","وَلَمّا غَدا يَبغي الحَقيقَةَ جاهِداً",60,"د",2,0],["وَأَسرى بِهِ لَيلاً فَأَكملَ أَمرَهُ","ضَميرٌ تَوَلَّت كَفُّ جِبريلَ طُهرَهُ",61,"ه",1,0],["وَأَسرى بِهِ حالاً وَشَفَّعَهُ غَدا","جَرَت لَيلَةُ الإِسراءِ ذِكراً مُخَلَّدا",62,"د",2,0],["وأسرع من يعاجله رداه","ظلوم بالخيانة يستعين",63,"ن",1,0],["وَأَسرَعِها إِلى الغاياتِ سَعياً","عَلى قَدَمٍ وَأَرساها عِمادا",64,"د",2,0],["وَأَسرَعنا لَعَمرِو بَنِى زُبَيدٍ","فأَحرَزَهُ نَجاءُ الهارِبِينا",65,"ن",2,0],["واسرقْ بنا خُلَس الزمان مُبادرا","والدهرُ في غَفَلاته لم يشعر",66,"ر",1,0],["وأسرى في حبال الذل فيهم","على سغب ومعطشة كلوم",67,"م",1,0],["وأسرّ بالإنسان أبغضه","فإذا أمرّ أذقته شهدا",68,"د",2,0],["وَأَسرى بهِ للقُدسِ في بعض ليلةٍ","وَمِنها إلى السبعِ العُلا حبّذا المسرى",69,"ر",2,0],["وَأَسرارهُ في كلّ شيءٍ كثيرةٌ","وَقَد تَنجلي طوراً ولا تنجلي طورا",69,"ر",2,0],["وَأَسَرتُمُ أَنَساً فَما حاوَلتُمُ","بِإِسارٍ جارِكُمُ بَني الميقابِ",70,"ب",1,0],["وَأَسرى مُقدِماً عَمرو بنُ سَعدٍ","إِلَيهِ بِكُلِّ شَيطانٍ غَوِيِّ",71,"ي",1,0],["وَاِسرَح رِكابَكَ آمِناً","مِمّا يَريبُكَ مُخصِبا",72,"ب",2,0],["وَأَسْرَجَهَا بِسِرَاجِ الْهُدَى","وَكَمْ مَكَثَتْ قَبْلُ تَحْكِي قُبُورَا",73,"ر",2,0],["وَأَسْرِجِي يا قَبَسَ الْ","مُنَى لَهُ دُجُونَهْ",74,"ن",2,0],["واسرع من يدعى لكنف ملمة","ورفع عذاب عن سواه أليم",75,"م",1,0],["وأسرع من يجاب له دعاء","اذا رمق السماء بلا اِفتخار",76,"ر",1,0],["واسرك وَهنا من هناك إِلى هنا","يذكرني عهدا تقادم بيننا",77,"ن",2,0],["واسرعهم عَلى المَلهوف عطفا","واسمعهم لداعي الخير أذزا",78,"ز",2,0],["وَأَسْرَفَ أَهْلوهَا مَعَاصِيَ أَوْبَقَت","فَما زَادَ أَنْ أَغْضَى حَنَاناً وأَنْ أَبْقَى",79,"ق",2,0],["وأسِرّةٍ عَنْ بشْرِها ورُوائِها","نَروِي أحاديثَ السّماح صِحاحا",80,"ح",2,0],["وَأَسْرَعْتَ التَّرَحُّلَ عَنْ دِيارٍ","سَواءٌ هُنَّ بَعْدَكَ وَالطُّلُولُ",81,"ل",1,0],["وَأُسرَةٌ كَأُسودِ الغيلِ ضارِيَةٌ","هُمُ لَدى الرَّوعِ إِذ يُلقى بِهِم بُهَمُ",82,"م",1,0],["وأَسرَعوا إليهِ","وأَقبَلوا عليهِ",83,"ه",1,0],["وأسرَتي في الأَسرِ","يَشكونَ كلَّ عُسرِ",83,"ر",1,0],["وأَسرى به في لَيلةٍ لسَمائِهِ","فَعادَ وَجَيبُ اللَيل ما شُقَّ عن فَجرِ",84,"ر",1,0],["وأسرار أمر اللَه نوحاً وقَد دعا","على قومه أن يغرقوا بالسفينة",85,"ه",1,0],["وأسرى به الرب العظيم إلى العلا","فسبحان من أسرى وبورك من سرى",86,"ر",2,0],["وأسرّت إليّ أن حصحصَ الحقّ","وخابت شماتةُ اللوّام",87,"م",1,0],["وأسرى في سماء الروح","من أشواقه ركب",88,"ب",1,0],["وَأسرع مِنّا نَداك الَّذي","بَلَغناه مِن قَبل أَن نَسأَلَك",89,"ك",1,0],["وَأسري في الفَلاة بِلا أَنيس","سِوى وَحش السَباسب وَالوهادِ",90,"د",1,0],["وأسْرفَ في عَطِيَّةِ مُستَميحٍ","وأصْفَحَ عَن جِنايةِ مُستَقيل",91,"ل",1,0],["وَاِسرِق بِنا الأَيّامَ فَال","أَيامُ لِلأَعمارِ تَسرِق",92,"ق",1,0],["وأسرعَ الجودُ سَبقاً","فَليَلحقِ التَّقسيطُ",93,"ط",1,0],["وَأَسرق اللذات ما دا","م لَكَ الدَهر مُواتي",94,"ت",2,0],["واسرح ورح واصبر مع الصابرين","واطرد وراهم خب والهف",95,"ف",1,0],["وأسرى به نحو السموات ربه","وأركبه ظهر البراق وأكرما",96,"م",2,0],["واسرح من اللَّذات في مُتَنَزَّهٍ","خَلَطَ الغرامُ ظِباءه بأسوده",97,"د",2,0],["وأسْرَعْتَ إحراقَ القلوب صوادياً","وعاجَلْتَ إهراقَ الدموع سواقيا",98,"ي",2,0],["واسرح مدى الطرف من ألفاف دُمَّرها","بين الغياض لدى مستشرف خضر",99,"ر",1,0],["وأسرّة شرَقَتْ بكلِّ بشاشَةٍ","حتى تحقق في الأمورِ نجاحُها",100,"ح",3,0],["وأسراب السوائم وهي ترعى","كحاكمةعلى ملك عظيم",101,"م",1,0],["وأسرارها شتى ولكن تشرّبت","خوالجها أنداءُ عُشبٍ وآكامِ",102,"م",1,0],["وأُسَرُّ بالطيفِ الوَصو","لِ وفي وصال الطيف جفوَهْ",103,"و",2,0],["وأسرعُ منْ إِقدامهِ يومَ حرْبه","نَداهُ إلى العافين في الإِزَم الغُبْر",104,"ر",1,0],["وأسرعتِ المطيُّ بحامليهِ","ولا عقرٌ يخاف ولا عثار",105,"ر",1,0],["واسرح سوام اللحظ بين رياضها","وحذار من فتكات تلك الأعينِ",106,"ن",1,0],["وأسرعت اسد الأتراك ثائرة","تحمي طرابلسا من دوس أقدام",107,"م",1,0],["واسرع لبر ولا تمنن فتحبطه","وبالكرام إذا ما شئت فالتحق",108,"ق",1,0],["وَأَسَرُّ البِلاد ما حَمَدَ السا","كِنُ فيها خَلائِقَ الجيرانِ",109,"ن",1,0],["واسْرِ مع القومِ على آدابِهِمْ","عندَ الصَّباحِ يحمدُ القومُ السُّرَى",110,"ا",1,0],["وَأَسَرنا مُلوكَهُم يَومَ سِرنا","وَأَذَقنا الأَعداءَ طَعماً وَبيلا",111,"ل",2,0],["واِسْرُرْ هِلالَ العيدِ منكَ بنظرةٍ","تكفيهِ نقْصَ التِمِّ من لألائِهِ",112,"ا",3,0],["وأسرَجُوا وألجَمُوا","مَتنَ الهوَى في السُّحبِ",113,"ب",1,0],["وَأَسَرنا عَدِيَّها وَاِصطَنَعنا","بِيَدٍ لَو أَثابَ مِنّا نَجاحا",114,"ح",2,0],["وَأَسَرتِني وأنا الطّليقُ وطالما","أسَرَ الهوى وقَتَلْتِ مَنْ لا يُفتَنُ",115,"ن",1,0],["وَأَسْرَعَتْ سَلْوَتِي وَدَاعَاً","فَحَبَّذَا ذَلِكَ الوَدَاعُ",116,"ع",1,0],["وَأَسْرَعَتْ فِيْهِمُ المَنَايَا","وَسَيْرُ خَيْلِ المَنُونِ رَكْضُ",117,"ض",1,0],["وأسروا مروان فيمن قد اسر","وابن الزبير مع جميع من ذكر",118,"ر",1,0],["وأَسْرَى تَهَادَى في القِيَادِ ونِسْوَةٌ","قُعَيْنِيَّةٌ مثْلُ الظِّباءِ الخَوَاذِلِ",119,"ل",1,0]]}