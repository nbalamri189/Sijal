,"ب",2,0],["وَأَسرَعَ في الفَواحِشِ كُلُّ طِملٍ","يَجُرُّ المُخزِياتِ وَلا يُبالي",5,"ل",2,0],["وَأَسرَعَ فيها قَبلَ ذَلِكَ حِقبَةً","رُكاحٌ فَجَنبا نُقدَةٍ فَالمَغاسِلُ",6,"ل",1,0],["وَأُسِرتُ في مَجرى خُيولي غازِياً","وَحُبِستُ فيما أَشعَلَت نيراني",7,"ن",2,0],["وَأَسرٌ أُقاسيهِ وَلَيلٌ نُجومُهُ","أَرى كُلَّ شَيءٍ غَيرَهُنَّ يَزولُ",8,"ل",1,0],["وَأَسَرنا مِنكُمُ أَعدادَهُم","فَاِنصَرَفتُم مِثلَ إِفلاتِ الحَجَل",9,"ل",1,0],["وأسرة جانسوا إذا حكموا","إكراه عدل القضا بإكرامه",10,"م",2,0],["وأسرِجِ المركبَ المعرَّى","قبلَ ورودِ الوغى وألجِمْ",11,"م",1,0],["وَأَسرَعَها إِلى الأَعداءِ سَيراً","إِذا ما اِستُبطِئَ الفَرَسُ الجَرورُ",12,"ر",1,0],["وَأَسرَعتَ إِلى السَيفِ أَوِ السُمِّ أَوِ النارِ","لِكَي تَخرُجَ مِنَ دُنيا ذَوُها غَيرُ أَحرارِ",13,"ر",1,0],["وأَسرابُ ذاكَ الفَراشِ الأَنيقِ","ونَحْلٌ يُغنِّي وغيمٌ يَمُرْ",14,"ر",1,0],["وأسرفت تبغى عريض الغنى","أقبلك من ناله بالسرف",15,"ف",1,0],["وَأَسرَعُ مَفعولٍ فَعَلتَ تَغَيُّراً","تَكَلُّفُ شَيءٍ في طِباعِكَ ضِدُّهُ",16,"د",2,0],["وَأَسري في ظَلامِ اللَيلِ وَحدي","كَأَنّي مِنهُ في قَمَرٍ مُنيرِ",17,"ر",1,0],["وَأَسرِجَتِ الكُمَيتُ فَناقَلَت بي","عَلى إِعقاقِها وَعَلى غِشاشي",18,"ش",2,0],["واسرقْ من الأيامِ حظ","ظَكَ من حَلالٍ أو حرامِ",19,"م",1,0],["وَأَسرَينَ لَيلاً فَخِلنا بِهِن","نَ مَثنى النُجومِ وَوُحدانَها",20,"ن",3,0],["وَأَسرارُ المَلاحِظِ لَيسَ تَخفى","وَقَد تُغري بِذي اللَحظِ الجُفونُ",21,"ن",1,0],["وأَسرفَ في الوَدادِ على التَّنائي","فحينَ دَنَوْتُ أسرفَ في الشِّقاقِ",22,"ق",1,0],["وَأَسرَعتُ في ديني وَلَم أَقضِ بُغيَتي","هَرَبتُ بِديني مِنكِ إِن نَفَعَ الهَرَب",23,"ب",1,0],["وَأَسَرُّ ما يُلقى الفَتى في نَفسِهِ","يَبتَزُّهُ نابُ الزَمانِ وَمَخلَبُه",24,"ب",2,0],["وَأَسرَعُ ما يَكونُ الشَيءُ نَقصاً","فَأَقرَبُ ما يَكونُ إِلى كَمالِه",25,"ل",2,0],["وَأُسرِحُ في حِمى جَيرونَ طَرفي","وَأَربَعُ في رِياضِ النَيِّرَينِ",26,"ن",1,0],["وأسرها بحكاية وقعت","ورواية من نسج أفكاري",27,"ي",1,0],["وَأَسرى تَحتَ نَجمٍ من سناني","إِذا نَجمٌ عنِ الأَبصارِ غابا",28,"ب",2,0],["وأسرقُ ما استطعتُ منَ المعاني","فإنْ فقتُ القديمَ حمدْتُ سيري",29,"ر",2,1],["وَأَسرِج لِيَ الدَهماءَ وَاِذهَب بِمِمطَري","وَلا تُعلِمَن حَيّاً مِنَ الناسِ مَذهَبي",30,"ب",2,0],["وَأَسري فَأَستَصفي مِنَ السَيفِ صاحِباً","وَأَركَبُ مِن ظَهرِ الدُجُنَّةِ أَدهَما",31,"م",2,0],["وَأَسرى إِذا ما ذُو الهَوى هالَهُ السُرى","وَأُعمِلُ لَيلَ الناجِياتِ اليَعامِلِ",32,"ل",1,0],["وَأَسرَفوا في لَكمِهِ وَدَفعِهِ","وَاِنطَلَقَت أَكُفُّهُم في صَفعِهِ",33,"ه",1,0],["وَأُسرَةُ ثابِتٍ وَجُموعُ كَلبٍ","سَرى بِحِمامِهِم مِنّا اِعتِكارُ",34,"ر",1,0],["وَأَسرَوا عَلى الخَيلِ العِتاقِ وَأَصمَتوا","نَواطِقَها إِلّا تَحَمحُمَ هائِبِ",35,"ب",1,0],["وَأَسرارُ بَعضِ الناسِ باتَت لِناظِرٍ","كَأَسرارِ كَفٍّ غَيرِهِنَّ خَوافي",36,"ف",2,0],["وَأَسرَعَ مِنّا إِن طُرِدنا اِنصِرَافةً","وأَكرَمَ مِنّا إِن طَرَدنا وأَظفَرا",37,"ر",2,0],["وَأَسرَعَ مَّنا إِن أَرَدنا اِنصِرافةً","وَأَكثَرَ مِنّا دَارِعينَ وحُسَّرا",38,"ر",2,0],["وأسرَّا في إذن رضوان شيئاً","فأباح الجواز وهو عسير",39,"ر",1,0],["وأسرجت الكميت فناقلت بي","على إعقاقها وعلى غشاش",40,"ش",1,0],["وَأَسْرَعُ مُنْجِدٍ إِنْ جَدَّ جَدٌّ","يُقِيلُ مِنَ العِثَارِ المُسْتَقِيلا",41,"ل",2,0],["وَأَسرَعَت في صَرعِهِ مِثلَما","تَأخُذُ كَفّك الحاسِد اللَقطا",42,"ط",2,0],["وأسراب الجحيمِ مُحلِّقاتٍ","إذا ما حوَمتْ قذفتْ ضِرامَا",43,"م",2,0],["وأسرَفَ الشيوخُ في الخصامِ","واحتدمتَ معركةُ الكلامِ",44,"م",1,0],["واسرحي في الرياض من ملكوت الله","ترعين فيضه في فضاها",45,"ا",3,0],["وإسراعها في الغي إسراع آمن","وناقد أعمال العباد بصير",46,"ر",1,0],["وأسرع ينضو ثوبها متنصلا","وربك يدري ما تكن الضمائر",47,"ر",1,0],["وأسرّت قدسا وأبدت شعارا","خلفه لو علمت ألف شعيره",48,"ر",2,0],["وأسرعت في خطاها فوق طاقتها","فأصبحت وهي تشكو الأيْنَ والسأما",49,"م",2,0],["وأسرح وفي بالي انّه في حدا . دربينه","ياقبل بيته ببيتين .. أو على دوّاااره",50,"ر",2,0],["وأسْرَيْنَ لَيْلاً، فخِلْنَا بهِ","نّ مَثنى النّجومِ ووُحْدانَهَا",51,"ن",3,0],["واسرق من الكنز المقدّس مغربا","حلو الأصيل ومشرقا لمّاحا",52,"ح",2,0],["وأسرّ الشكوى حياء وكبرا","ربّ شكوى إسرارها إعلان",53,"ن",1,0],["وأسرف في الذكرى لأنزح نبعها","ولكنّ نبع الذكريات جموم",54,"م",1,0],["واسرارهم طيارة الطور للعلا","مجردة عما سوى الحب يا خلي",55,"ل",2,0],["وأسرار بلب دمي أقامت","بلبي في القعود وفي القيام",56,"م",1,0],["واسَرحْ سَوامَك في رياضِ سعادةٍ","وعميمِ عُشْبٍ بالعلاء منوِّرِ",57,"ر",1,0],["وَأَسرَعُ في مَنعِ الذِمارِ إِجابَةً","إِذا نادَتِ الأَبطالُ هَل مِن مُقارِعِ",58,"ع",1,0],["وَأَسرى بِهِ إِذ كَمَّلَ اللَهُ سِنَّهُ","مَراقيهِ في الإِسراءِ تَقضي بِأَنَّهُ",59,"ه",1,0],["وَإِسراؤُهُ يَبدو بِهِ الفَضلُ وَالفَصلُ","وَلَمّا غَدا يَبغي الحَقيقَةَ جاهِداً",60,"د",2,0],["وَأَسرى بِهِ لَيلاً فَأَكملَ أَمرَهُ","ضَميرٌ تَوَلَّت كَفُّ جِبريلَ طُهرَهُ",61,"ه",1,0],["وَأَسرى بِهِ حالاً وَشَفَّعَهُ غَدا","جَرَت لَيلَةُ الإِسراءِ ذِكراً مُخَلَّدا",62,"د",2,0],["وأسرع من يعاجله رداه","ظلوم بالخيانة يستعين",63,"ن",1,0],["وَأَسرَعِها إِلى الغاياتِ سَعياً","عَلى قَدَمٍ وَأَرساها عِمادا",64,"د",2,0],["وَأَسرَعنا لَعَمرِو بَنِى زُبَيدٍ","فأَحرَزَهُ نَجاءُ الهارِبِينا",65,"ن",2,0],["واسرقْ بنا خُلَس الزمان مُبادرا","والدهرُ في غَفَلاته لم يشعر",66,"ر",1,0],["وأسرى في حبال الذل فيهم","على سغب ومعطشة كلوم",67,"م",1,0],["وأسرّ بالإنسان أبغضه","فإذا أمرّ أذقته شهدا",68,"د",2,0],["وَأَسرى بهِ للقُدسِ في بعض ليلةٍ","وَمِنها إلى السبعِ العُلا حبّذا المسرى",69,"ر",2,0],["وَأَسرارهُ في كلّ شيءٍ كثيرةٌ","وَقَد تَنجلي طوراً ولا تنجلي طورا",69,"ر",2,0],["وَأَسَرتُمُ أَنَساً فَما حاوَلتُمُ","بِإِسارٍ جارِكُمُ بَني الميقابِ",70,"ب",1,0],["وَأَسرى مُقدِماً عَمرو بنُ سَعدٍ","إِلَيهِ بِكُلِّ شَيطانٍ غَوِيِّ",71,"ي",1,0],["وَاِسرَح رِكابَكَ آمِناً","مِمّا يَريبُكَ مُخصِبا",72,"ب",2,0],["وَأَسْرَجَهَا بِسِرَاجِ الْهُدَى","وَكَمْ مَكَثَتْ قَبْلُ تَحْكِي قُبُورَا",73,"ر",2,0],["وَأَسْرِجِي يا قَبَسَ الْ","مُنَى لَهُ دُجُونَهْ",74,"ن",2,0],["واسرع من يدعى لكنف ملمة","ورفع عذاب عن سواه أليم",75,"م",1,0],["وأسرع من يجاب له دعاء","اذا رمق السماء بلا اِفتخار",76,"ر",1,0],["واسرك وَهنا من هناك إِلى هنا","يذكرني عهدا تقادم بيننا",77,"ن",2,0],["واسرعهم عَلى المَلهوف عطفا","واسمعهم لداعي الخير أذزا",78,"ز",2,0],["وَأَسْرَفَ أَهْلوهَا مَعَاصِيَ أَوْبَقَت","فَما زَادَ أَنْ أَغْضَى حَنَاناً وأَنْ أَبْقَى",79,"ق",2,0],["وأسِرّةٍ عَنْ بشْرِها ورُوائِها","نَروِي أحاديثَ السّماح صِحاحا",80,"ح",2,0],["وَأَسْرَعْتَ التَّرَحُّلَ عَنْ دِيارٍ","سَواءٌ هُنَّ بَعْدَكَ وَالطُّلُولُ",81,"ل",1,0],["وَأُسرَةٌ كَأُسودِ الغيلِ ضارِيَةٌ","هُمُ لَدى الرَّوعِ إِذ يُلقى بِهِم بُهَمُ",82,"م",1,0],["وأَسرَعوا إليهِ","وأَقبَلوا عليهِ",83,"ه",1,0],["وأسرَتي في الأَسرِ","يَشكونَ كلَّ عُسرِ",83,"ر",1,0],["وأَسرى به في لَيلةٍ لسَمائِهِ","فَعادَ وَجَيبُ اللَيل ما شُقَّ عن فَجرِ",84,"ر",1,0],["وأسرار أمر اللَه نوحاً وقَد دعا","على قومه أن يغرقوا بالسفينة",85,"ه",1,0],["وأسرى به الرب العظيم إلى العلا","فسبحان من أسرى وبورك من سرى",86,"ر",2,0],["وأسرّت إليّ أن حصحصَ الحقّ","وخابت شماتةُ اللوّام",87,"م",1,0],["وأسرى في سماء الروح","من أشواقه ركب",88,"ب",1,0],["وَأسرع مِنّا نَداك الَّذي","بَلَغناه مِن قَبل أَن نَسأَلَك",89,"ك",1,0],["وَأسري في الفَلاة بِلا أَنيس","سِوى وَحش السَباسب وَالوهادِ",90,"د",1,0],["وأسْرفَ في عَطِيَّةِ مُستَميحٍ","وأصْفَحَ عَن جِنايةِ مُستَقيل",91,"ل",1,0],["وَاِسرِق بِنا الأَيّامَ فَال","أَيامُ لِلأَعمارِ تَسرِق",92,"ق",1,0],["وأسرعَ الجودُ سَبقاً","فَليَلحقِ التَّقسيطُ",93,"ط",1,0],["وَأَسرق اللذات ما دا","م لَكَ الدَهر مُواتي",94,"ت",2,0],["واسرح ورح واصبر مع الصابرين","واطرد وراهم خب والهف",95,"ف",1,0],["وأسرى به نحو السموات ربه","وأركبه ظهر البراق وأكرما",96,"م",2,0],["واسرح من اللَّذات في مُتَنَزَّهٍ","خَلَطَ الغرامُ ظِباءه بأسوده",97,"د",2,0],["وأسْرَعْتَ إحراقَ القلوب صوادياً","وعاجَلْتَ إهراقَ الدموع سواقيا",98,"ي",2,0],["واسرح مدى الطرف من ألفاف دُمَّرها","بين الغياض لدى مستشرف خضر",99,"ر",1,0],["وأسرّة شرَقَتْ بكلِّ بشاشَةٍ","حتى تحقق في الأمورِ نجاحُها",100,"ح",3,0],["وأسراب السوائم وهي ترعى","كحاكمةعلى ملك عظيم",101,"م",1,0],["وأسرارها شتى ولكن تشرّبت","خوالجها أنداءُ عُشبٍ وآكامِ",102,"م",1,0],["وأُسَرُّ بالطيفِ الوَصو","لِ وفي وصال الطيف جفوَهْ",103,"و",2,0],["وأسرعُ منْ إِقدامهِ يومَ حرْبه","نَداهُ إلى العافين في الإِزَم الغُبْر",104,"ر",1,0],["وأسرعتِ المطيُّ بحامليهِ","ولا عقرٌ يخاف ولا عثار",105,"ر",1,0],["واسرح سوام اللحظ بين رياضها","وحذار من فتكات تلك الأعينِ",106,"ن",1,0],["وأسرعت اسد الأتراك ثائرة","تحمي طرابلسا من دوس أقدام",107,"م",1,0],["واسرع لبر ولا تمنن فتحبطه","وبالكرام إذا ما شئت فالتحق",108,"ق",1,0],["وَأَسَرُّ البِلاد ما حَمَدَ السا","كِنُ فيها خَلائِقَ الجيرانِ",109,"ن",1,0],["واسْرِ مع القومِ على آدابِهِمْ","عندَ الصَّباحِ يحمدُ القومُ السُّرَى",110,"ا",1,0],["وَأَسَرنا مُلوكَهُم يَومَ سِرنا","وَأَذَقنا الأَعداءَ طَعماً وَبيلا",111,"ل",2,0],["واِسْرُرْ هِلالَ العيدِ منكَ بنظرةٍ","تكفيهِ نقْصَ التِمِّ من لألائِهِ",112,"ا",3,0],["وأسرَجُوا وألجَمُوا","مَتنَ الهوَى في السُّحبِ",113,"ب",1,0],["وَأَسَرنا عَدِيَّها وَاِصطَنَعنا","بِيَدٍ لَو أَثابَ مِنّا نَجاحا",114,"ح",2,0],["وَأَسَرتِني وأنا الطّليقُ وطالما","أسَرَ الهوى وقَتَلْتِ مَنْ لا يُفتَنُ",115,"ن",1,0],["وَأَسْرَعَتْ سَلْوَتِي وَدَاعَاً","فَحَبَّذَا ذَلِكَ الوَدَاعُ",116,"ع",1,0],["وَأَسْرَعَتْ فِيْهِمُ المَنَايَا","وَسَيْرُ خَيْلِ المَنُونِ رَكْضُ",117,"ض",1,0],["وأسروا مروان فيمن قد اسر","وابن الزبير مع جميع من ذكر",118,"ر",1,0],["وأسرفتَ في بذلِ التِّلاد ولم تزل","بِك الجودُ",119,"د",1,0],["وأسَرُّ مِن رِزقٍ أَتاكَ طَريقُهُ","رِزقٌ أتاكَ وَلَستَ عَنهُ بِعالِمِ",120,"م",1,0],["واسرَح سوامَ اللفظ بين حدائق","ما سائمٌ في مثلها بمريح",121,"ح",1,0],["وأسراره تسرى لتأنيس وحشه","هي السبعة الأعلام أنوار رشه",122,"ه",1,0],["وأسرار سر الذات فيه تحصلت","ففي كل مظهر ذوات تخيلت",122,"ت",1,0],["وأسرارها في كل ستر تسترت","كما أنها في كل طور تطورت",122,"ت",1,0],["وأسر سرا من خطاب نفوسنا","من حيث أعرب عن حروف المعجم",123,"م",1,0],["وَأَسري وَلَكِنَّ الظَلامَ مطيّتي","وَأَركَبُ لَكِن من ثُرَيّاه هودجا",124,"ج",2,0],["وأَسَرتَهُ وَحُجِبتَ عَنهُ فَيا له","وَهوَ الشَقيُّ مقرّباً مَطرودا",125,"د",2,0],["وَأَسرار اللّواحظِ ليسَ تَخفى","وَقد تغري بِذي الخَطأ الظنونُ",126,"ن",1,0],["وأسريتُ من بدرِ الظلامِ بألبَة","بصحبةِ مطفي الجمرِ أو مكفىءِ الظعن",127,"ن",1,0],["وأسركم عند الهداية شاكراً","وأَسُوؤُكُمْ عند الغواية زاجرا",128,"ر",2,0],["واسرح الطرف في برود مديح","لم يحكها غيري وانت خبير",129,"ر",1,0],["وأسرارُ المعاني دو","نها الأستارُ مَكْشُوفَه",130,"ف",2,0],["وأُسِرُّ ما تحت الضمير من الجوى","ولسانُ دمعي عن ضميريَ يَنطِق",131,"ق",1,0],["واسْرَحُوا في جوارِ خندفَ أو قَيْ","سٍ جوارِ الحصونِ والأرباض",132,"ض",1,0],["وأسرعها عندي من الشوقِ واقفٌ","وأطولُ مسراها لديَّ قصير",133,"ر",1,0],["وأسرع حتى أن ألم بكربلا","وثقل رسول الله فيها مخيم",134,"م",1,0],["وَاِسرُد بِهِ ذِكرَ الكرامِ وَجودِهم","فَعَسى بِذِكراهُم تَصيرُ كَريما",135,"م",2,0],["وَأَسرَعوا إِلى عَزاء السَبع","وَغَمَروا أَجفانَهُم بِالدَمع",136,"ع",1,0],["وَأَسرع شَنجة للعقد حِرصاً","وَأَظهَر فيهِ لِلمَولى اِرتِغابا",137,"ب",2,0],["واسرقْ كنوز المعاني منْ خزائنها","ولا تخفْ تهمةً من قائفٍ قافا",138,"ف",2,0],["وأسرّح الطرف المقرّح جفنه","من بعد مس البعد في جناته",139,"ت",2,0],["واسرَع في امرىءِ القيس بنِ تيمٍ","نوى قذفٌ وأبطأت السّعاةُ",140,"ه",1,0],["وأسرَع في البَين قيلُ الوشاة","ولا يقدُمُ الناسَ من يَشغَبُ",141,"ب",1,0],["وأسرني إذ ناب فضل عتابكم","عن وصلكم وعن الخيال الزائر",142,"ر",1,0],["وأسرّ أن تبقى إلى","يوم به تبلى السرائر",143,"ر",1,0],["وأسرى به ليلا من المسجد النقي","إلى المسجد الأقصى الشريف المهندس",144,"س",1,0],["وَأُسِرُّ حُبِّكِ وَالدمُوِعُ تُذِيعُهُ","أمَعَ المَدَامِعِ يَنْفَعُ الكِتْمَانُ",145,"ن",1,0],["وأسرت الألباب بالكلم العذ","ب وبالبشر والمحيا الوديع",146,"ع",1,0],["وَاِسرِع إِلى تِلكَ المَغاني الَّتي","غادَرنَني رَهنَ أَسىً لا أُفيق",147,"ق",1,0],["وأسرّ للينبوع كيف","يبث أشواق الهضاب",148,"ب",1,0],["واسرع إليه برغبة واقصده حبا","سر إليه ادم تلاوة قوله",149,"ل",2,0],["واسرع بالغوث وهب نعماً","تترى وقنا شر الحرج",150,"ج",1,0],["وَأَسْرَابُ غِزْلاَنٍ عَرَضْنَ سَوَانِحاً","وَلاَ بُدَّ مِنْ مَرْعَىً فَكَانَ مِنَ الصَّدْرِ",151,"ر",1,0],["وَأَسْرَى إِلَى الْحَرَّةِ الصَّبُّ يَطْوِي","عَلَى الوَجْدِ فِيهَا ضُلُوعاً حِرَارَا",152,"ر",2,0],["وَأَسْرَابُ غِرْبَانٍ بِكُحْلِ عُيُونِهَا","رَوَاقِعُ مَا تُبْدِي السُّيُوفُ مِنَ الكُوَى",153,"و",2,0],["وَأسرِي اللَّيلَ لا أَلوِي عِنَانا","وَلو نَيلُ الأمَانِي بِمَن أَصَابا",154,"ب",2,0],["وَأَسْرَ بَنِيهِ بَعدَهُ وَاحتِمَالَهُم","كَأنَّهُمُ مِن نسلِ كِسرَى تُغُنَّمُ",155,"م",1,0],["وأسرى به