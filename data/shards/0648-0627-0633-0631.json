ل"],[278,"سوى باكيك من ينهى العذول","https://www.aldiwan.net/poem60710.html","الوافر"],[280,"تظلموا وهم عقوا وهم ظلموا","https://www.aldiwan.net/poem32460.html","البسيط"],[295,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[295,"إذا ما امتطيت الفلك مقتحم البحر","https://www.aldiwan.net/poem33276.html","الطويل"],[302,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[302,"بنفس أفدي خير من وطئ الثرى","https://www.aldiwan.net/poem16863.html","الطويل"],[326,"هذه دارها وتلك رباها","https://www.aldiwan.net/poem55027.html","الطويل"],[326,"على نبعك يا حب","https://www.aldiwan.net/poem55032.html","الهزج"],[351,"فدى لك ذا العبد مع ما ملك","https://www.aldiwan.net/poem40009.html","المتقارب"],[351,"تنزه عن بني الدنيا وعاد","https://www.aldiwan.net/poem40384.html","الوافر"],[362,"أما تحية الطرف الكحيل","https://www.aldiwan.net/poem60801.html","الوافر"],[364,"قم فاسقني مما تروق","https://www.aldiwan.net/poem17235.html","مجزوء الكامل"],[369,"يا من له بيت مجد","https://www.aldiwan.net/poem57336.html","المجتث"],[377,"دعك من نهي النهاة","https://www.aldiwan.net/poem48799.html","مجزوء الرمل"],[388,"يقول طاهر عسى الله يعين","https://www.aldiwan.net/poem54553.html","عموديه"],[400,"تبين ثغر الفجر لما تبسما","https://www.aldiwan.net/poem33450.html","الطويل"],[413,"فتن الأنام بطرفه وبجيده","https://www.aldiwan.net/poem53963.html","الكامل"],[413,"سأبكي وأستبكي عليك المعاليا","https://www.aldiwan.net/poem53972.html","الطويل"],[450,"حيا دمشق فكم فيها لذي وطر","https://www.aldiwan.net/poem13761.html","البسيط"],[450,"ما للرياض تنمنمت أدواحها","https://www.aldiwan.net/poem13951.html","الكامل"],[451,"ترفع عن معاداة الكريم","https://www.aldiwan.net/poem61339.html","الوافر"],[451,"حلمت ولم أعلم أحلمى يقظة","https://www.aldiwan.net/poem61799.html","الطويل"],[456,"أخوي والعشاق إخوه","https://www.aldiwan.net/poem55820.html","مجزوء الكامل"],[459,"إذا ما الجياد الجرد شدت لغاية","https://www.aldiwan.net/poem16225.html","الطويل"],[462,"لقد أهدت كتابك منك كف","https://www.aldiwan.net/poem3352.html","عموديه"],[462,"أشرب على ورد الخدود وغنني","https://www.aldiwan.net/poem3431.html","عموديه"],[477,"من للثكالى وللجرحى وأيتام","https://www.aldiwan.net/poem37205.html","البسيط"],[477,"الذكر أبقى لكم والمال عارية","https://www.aldiwan.net/poem37207.html","البسيط"],[491,"فليالي الصبا أسر ليال","https://www.aldiwan.net/poem67307.html","الخفيف"],[498,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[507,"هل عرفت الغداة رسماً محيلا","https://www.aldiwan.net/poem751.html",""],[512,"هذا الحمى فانزل على جرعائه","https://www.aldiwan.net/poem20799.html","الكامل"],[536,"السحر هذا ما أرى","https://www.aldiwan.net/poem48280.html","عموديه"],[541,"عجلا اليوم صاحبي رواحا","https://www.aldiwan.net/poem1764.html","الخفيف"],[549,"وحللت من قلبي وأنت بخيلة","https://www.aldiwan.net/poem47182.html","الكامل"],[565,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[565,"أمر عيش وحال خفض","https://www.aldiwan.net/poem69620.html","مخلع البسيط"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["وَأُسرَةِ عِزٍّ طِوالِ القَنا","إِذا نَزَلَ الذُلُّ قالوا اِرحَلِ",0,"ل",1,0],["وَأَسرَفتُ بِالبِشرِ حَتّى ظَنَن","تُ أَنَّكَ أَضجَعتَ فيهِ النِفاقا",1,"ق",2,0],["وَأَسري إِلَيها وَالهَوى يَستَفِزُّني","بِمُحمَرَّةِ الأَخفافِ فُتلِ المَرافِقِ",2,"ق",1,0],["وأسْري بعيسٍ كالأهِلّةِ فوقَها","وُجوهٌ منَ الأقْمارِ أبْهى وأنْوَرُ",3,"ر",1,0],["وَأَسرَفَ في حُبِّ الحَياةِ فَحاطَها","بِسورٍ مِنَ الأَهوالِ لَم يَنجُ راكِبُه",4,"ب",2,0],["وَأَسرَعَ في الفَواحِشِ كُلُّ طِملٍ","يَجُرُّ المُخزِياتِ وَلا يُبالي",5,"ل",2,0],["وَأَسرَعَ فيها قَبلَ ذَلِكَ حِقبَةً","رُكاحٌ فَجَنبا نُقدَةٍ فَالمَغاسِلُ",6,"ل",1,0],["وَأُسِرتُ في مَجرى خُيولي غازِياً","وَحُبِستُ فيما أَشعَلَت نيراني",7,"ن",2,0],["وَأَسرٌ أُقاسيهِ وَلَيلٌ نُجومُهُ","أَرى كُلَّ شَيءٍ غَيرَهُنَّ يَزولُ",8,"ل",1,0],["وَأَسَرنا مِنكُمُ أَعدادَهُم","فَاِنصَرَفتُم مِثلَ إِفلاتِ الحَجَل",9,"ل",1,0],["وأسرة جانسوا إذا حكموا","إكراه عدل القضا بإكرامه",10,"م",2,0],["وأسرِجِ المركبَ المعرَّى","قبلَ ورودِ الوغى وألجِمْ",11,"م",1,0],["وَأَسرَعَها إِلى الأَعداءِ سَيراً","إِذا ما اِستُبطِئَ الفَرَسُ الجَرورُ",12,"ر",1,0],["وَأَسرَعتَ إِلى السَيفِ أَوِ السُمِّ أَوِ النارِ","لِكَي تَخرُجَ مِنَ دُنيا ذَوُها غَيرُ أَحرارِ",13,"ر",1,0],["وأَسرابُ ذاكَ الفَراشِ الأَنيقِ","ونَحْلٌ يُغنِّي وغيمٌ يَمُرْ",14,"ر",1,0],["وأسرفت تبغى عريض الغنى","أقبلك من ناله بالسرف",15,"ف",1,0],["وَأَسرَعُ مَفعولٍ فَعَلتَ تَغَيُّراً","تَكَلُّفُ شَيءٍ في طِباعِكَ ضِدُّهُ",16,"د",2,0],["وَأَسري في ظَلامِ اللَيلِ وَحدي","كَأَنّي مِنهُ في قَمَرٍ مُنيرِ",17,"ر",1,0],["وَأَسرِجَتِ الكُمَيتُ فَناقَلَت بي","عَلى إِعقاقِها وَعَلى غِشاشي",18,"ش",2,0],["واسرقْ من الأيامِ حظ","ظَكَ من حَلالٍ أو حرامِ",19,"م",1,0],["وَأَسرَينَ لَيلاً فَخِلنا بِهِن","نَ مَثنى النُجومِ وَوُحدانَها",20,"ن",3,0],["وَأَسرارُ المَلاحِظِ لَيسَ تَخفى","وَقَد تُغري بِذي اللَحظِ الجُفونُ",21,"ن",1,0],["وأَسرفَ في الوَدادِ على التَّنائي","فحينَ دَنَوْتُ أسرفَ في الشِّقاقِ",22,"ق",1,0],["وَأَسرَعتُ في ديني وَلَم أَقضِ بُغيَتي","هَرَبتُ بِديني مِنكِ إِن نَفَعَ الهَرَب",23,"ب",1,0],["وَأَسَرُّ ما يُلقى الفَتى في نَفسِهِ","يَبتَزُّهُ نابُ الزَمانِ وَمَخلَبُه",24,"ب",2,0],["وَأَسرَعُ ما يَكونُ الشَيءُ نَقصاً","فَأَقرَبُ ما يَكونُ إِلى كَمالِه",25,"ل",2,0],["وَأُسرِحُ في حِمى جَيرونَ طَرفي","وَأَربَعُ في رِياضِ النَيِّرَينِ",26,"ن",1,0],["وأسرها بحكاية وقعت","ورواية من نسج أفكاري",27,"ي",1,0],["وَأَسرى تَحتَ نَجمٍ من سناني","إِذا نَجمٌ عنِ الأَبصارِ غابا",28,"ب",2,0],["وأسرقُ ما استطعتُ منَ المعاني","فإنْ فقتُ القديمَ حمدْتُ سيري",29,"ر",2,1],["وَأَسرِج لِيَ الدَهماءَ وَاِذهَب بِمِمطَري","وَلا تُعلِمَن حَيّاً مِنَ الناسِ مَذهَبي",30,"ب",2,0],["وَأَسري فَأَستَصفي مِنَ السَيفِ صاحِباً","وَأَركَبُ مِن ظَهرِ الدُجُنَّةِ أَدهَما",31,"م",2,0],["وَأَسرى إِذا ما ذُو الهَوى هالَهُ السُرى","وَأُعمِلُ لَيلَ الناجِياتِ اليَعامِلِ",32,"ل",1,0],["وَأَسرَفوا في لَكمِهِ وَدَفعِهِ","وَاِنطَلَقَت أَكُفُّهُم في صَفعِهِ",33,"ه",1,0],["وَأُسرَةُ ثابِتٍ وَجُموعُ كَلبٍ","سَرى بِحِمامِهِم مِنّا اِعتِكارُ",34,"ر",1,0],["وَأَسرَوا عَلى الخَيلِ العِتاقِ وَأَصمَتوا","نَواطِقَها إِلّا تَحَمحُمَ هائِبِ",35,"ب",1,0],["وَأَسرارُ بَعضِ الناسِ باتَت لِناظِرٍ","كَأَسرارِ كَفٍّ غَيرِهِنَّ خَوافي",36,"ف",2,0],["وَأَسرَعَ مِنّا إِن طُرِدنا اِنصِرَافةً","وأَكرَمَ مِنّا إِن طَرَدنا وأَظفَرا",37,"ر",2,0],["وَأَسرَعَ مَّنا إِن أَرَدنا اِنصِرافةً","وَأَكثَرَ مِنّا دَارِعينَ وحُسَّرا",38,"ر",2,0],["وأسرَّا في إذن رضوان شيئاً","فأباح الجواز وهو عسير",39,"ر",1,0],["وأسرجت الكميت فناقلت بي","على إعقاقها وعلى غشاش",40,"ش",1,0],["وَأَسْرَعُ مُنْجِدٍ إِنْ جَدَّ جَدٌّ","يُقِيلُ مِنَ العِثَارِ المُسْتَقِيلا",41,"ل",2,0],["وَأَسرَعَت في صَرعِهِ مِثلَما","تَأخُذُ كَفّك الحاسِد اللَقطا",42,"ط",2,0],["وأسراب الجحيمِ مُحلِّقاتٍ","إذا ما حوَمتْ قذفتْ ضِرامَا",43,"م",2,0],["وأسرَفَ الشيوخُ في الخصامِ","واحتدمتَ معركةُ الكلامِ",44,"م",1,0],["وأسرع ينضو ثوبها متنصلا","وربك يدري ما تكن الضمائر",45,"ر",1,0],["وأسرعت في خطاها فوق طاقتها","فأصبحت وهي تشكو الأيْنَ والسأما",46,"م",2,0],["وأسْرَيْنَ لَيْلاً، فخِلْنَا بهِ","نّ مَثنى النّجومِ ووُحْدانَهَا",47,"ن",3,0],["واسرارهم طيارة الطور للعلا","مجردة عما سوى الحب يا خلي",48,"ل",2,0],["وأسرار بلب دمي أقامت","بلبي في القعود وفي القيام",49,"م",1,0],["واسَرحْ سَوامَك في رياضِ سعادةٍ","وعميمِ عُشْبٍ بالعلاء منوِّرِ",50,"ر",1,0],["وَأَسرَعُ في مَنعِ الذِمارِ إِجابَةً","إِذا نادَتِ الأَبطالُ هَل مِن مُقارِعِ",51,"ع",1,0],["وَأَسرى بِهِ إِذ كَمَّلَ اللَهُ سِنَّهُ","مَراقيهِ في الإِسراءِ تَقضي بِأَنَّهُ",52,"ه",1,0],["وَإِسراؤُهُ يَبدو بِهِ الفَضلُ وَالفَصلُ","وَلَمّا غَدا يَبغي الحَقيقَةَ جاهِداً",53,"د",2,0],["وَأَسرى بِهِ لَيلاً فَأَكملَ أَمرَهُ","ضَميرٌ تَوَلَّت كَفُّ جِبريلَ طُهرَهُ",54,"ه",1,0],["وَأَسرى بِهِ حالاً وَشَفَّعَهُ غَدا","جَرَت لَيلَةُ الإِسراءِ ذِكراً مُخَلَّدا",55,"د",2,0],["وأسرع من يعاجله رداه","ظلوم بالخيانة يستعين",56,"ن",1,0],["وَأَسرَعِها إِلى الغاياتِ سَعياً","عَلى قَدَمٍ وَأَرساها عِمادا",57,"د",2,0],["وَأَسرَعنا لَعَمرِو بَنِى زُبَيدٍ","فأَحرَزَهُ نَجاءُ الهارِبِينا",58,"ن",2,0],["واسرقْ بنا خُلَس الزمان مُبادرا","والدهرُ في غَفَلاته لم يشعر",59,"ر",1,0],["وأسرى في حبال الذل فيهم","على سغب ومعطشة كلوم",60,"م",1,0],["وأسرّ بالإنسان أبغضه","فإذا أمرّ أذقته شهدا",61,"د",2,0],["وَأَسرى بهِ للقُدسِ في بعض ليلةٍ","وَمِنها إلى السبعِ العُلا حبّذا المسرى",62,"ر",2,0],["وَأَسرارهُ في كلّ شيءٍ كثيرةٌ","وَقَد تَنجلي طوراً ولا تنجلي طورا",62,"ر",2,0],["وَأَسَرتُمُ أَنَساً فَما حاوَلتُمُ","بِإِسارٍ جارِكُمُ بَني الميقابِ",63,"ب",1,0],["وَأَسرى مُقدِماً عَمرو بنُ سَعدٍ","إِلَيهِ بِكُلِّ شَيطانٍ غَوِيِّ",64,"ي",1,0],["وَاِسرَح رِكابَكَ آمِناً","مِمّا يَريبُكَ مُخصِبا",65,"ب",2,0],["وَأَسْرَجَهَا بِسِرَاجِ الْهُدَى","وَكَمْ مَكَثَتْ قَبْلُ تَحْكِي قُبُورَا",66,"ر",2,0],["وَأَسْرِجِي يا قَبَسَ الْ","مُنَى لَهُ دُجُونَهْ",67,"ن",2,0],["واسرع من يدعى لكنف ملمة","ورفع عذاب عن سواه أليم",68,"م",1,0],["وأسرع من يجاب له دعاء","اذا رمق السماء بلا اِفتخار",69,"ر",1,0],["واسرك وَهنا من هناك إِلى هنا","يذكرني عهدا تقادم بيننا",70,"ن",2,0],["واسرعهم عَلى المَلهوف عطفا","واسمعهم لداعي الخير أذزا",71,"ز",2,0],["وَأَسْرَفَ أَهْلوهَا مَعَاصِيَ أَوْبَقَت","فَما زَادَ أَنْ أَغْضَى حَنَاناً وأَنْ أَبْقَى",72,"ق",2,0],["وأسِرّةٍ عَنْ بشْرِها ورُوائِها","نَروِي أحاديثَ السّماح صِحاحا",73,"ح",2,0],["وَأَسْرَعْتَ التَّرَحُّلَ عَنْ دِيارٍ","سَواءٌ هُنَّ بَعْدَكَ وَالطُّلُولُ",74,"ل",1,0],["وَأُسرَةٌ كَأُسودِ الغيلِ ضارِيَةٌ","هُمُ لَدى الرَّوعِ إِذ يُلقى بِهِم بُهَمُ",75,"م",1,0],["وأَسرَعوا إليهِ","وأَقبَلوا عليهِ",76,"ه",1,0],["وأسرَتي في الأَسرِ","يَشكونَ كلَّ عُسرِ",76,"ر",1,0],["وأَسرى به في لَيلةٍ لسَمائِهِ","فَعادَ وَجَيبُ اللَيل ما شُقَّ عن فَجرِ",77,"ر",1,0],["وأسرار أمر اللَه نوحاً وقَد دعا","على قومه أن يغرقوا بالسفينة",78,"ه",1,0],["وأسرى به الرب العظيم إلى العلا","فسبحان من أسرى وبورك من سرى",79,"ر",2,0],["وأسرّت إليّ أن حصحصَ الحقّ","وخابت شماتةُ اللوّام",80,"م",1,0],["وأسرى في سماء الروح","من أشواقه ركب",81,"ب",1,0],["وَأسرع مِنّا نَداك الَّذي","بَلَغناه مِن قَبل أَن نَسأَلَك",82,"ك",1,0],["وَأسري في الفَلاة بِلا أَنيس","سِوى وَحش السَباسب وَالوهادِ",83,"د",1,0],["وأسْرفَ في عَطِيَّةِ مُستَميحٍ","وأصْفَحَ عَن جِنايةِ مُستَقيل",84,"ل",1,0],["وَاِسرِق بِنا الأَيّامَ فَال","أَيامُ لِلأَعمارِ تَسرِق",85,"ق",1,0],["وأسرعَ الجودُ سَبقاً","فَليَلحقِ التَّقسيطُ",86,"ط",1,0],["وَأَسرق اللذات ما دا","م لَكَ الدَهر مُواتي",87,"ت",2,0],["واسرح ورح واصبر مع الصابرين","واطرد وراهم خب والهف",88,"ف",1,0],["وأسرى به نحو السموات ربه","وأركبه ظهر البراق وأكرما",89,"م",2,0],["واسرح من اللَّذات في مُتَنَزَّهٍ","خَلَطَ الغرامُ ظِباءه بأسوده",90,"د",2,0],["وأسْرَعْتَ إحراقَ القلوب صوادياً","وعاجَلْتَ إهراقَ الدموع سواقيا",91,"ي",2,0],["واسرح مدى الطرف من ألفاف دُمَّرها","بين الغياض لدى مستشرف خضر",92,"ر",1,0],["وأسرّة شرَقَتْ بكلِّ بشاشَةٍ","حتى تحقق في الأمورِ نجاحُها",93,"ح",3,0],["وأسراب السوائم وهي ترعى","كحاكمةعلى ملك عظيم",94,"م",1,0],["وأسرارها شتى ولكن تشرّبت","خوالجها أنداءُ عُشبٍ وآكامِ",95,"م",1,0],["وأُسَرُّ بالطيفِ الوَصو","لِ وفي وصال الطيف جفوَهْ",96,"و",2,0],["وأسرعُ منْ إِقدامهِ يومَ حرْبه","نَداهُ إلى العافين في الإِزَم الغُبْر",97,"ر",1,0],["وأسرعتِ المطيُّ بحامليهِ","ولا عقرٌ يخاف ولا عثار",98,"ر",1,0],["واسرح سوام اللحظ بين رياضها","وحذار من فتكات تلك الأعينِ",99,"ن",1,0],["وأسرعت اسد الأتراك ثائرة","تحمي طرابلسا من دوس أقدام",100,"م",1,0],["واسرع لبر ولا تمنن فتحبطه","وبالكرام إذا ما شئت فالتحق",101,"ق",1,0],["وَأَسَرُّ البِلاد ما حَمَدَ السا","كِنُ فيها خَلائِقَ الجيرانِ",102,"ن",1,0],["واسْرِ مع القومِ على آدابِهِمْ","عندَ الصَّباحِ يحمدُ القومُ السُّرَى",103,"ا",1,0],["وَأَسَرنا مُلوكَهُم يَومَ سِرنا","وَأَذَقنا الأَعداءَ طَعماً وَبيلا",104,"ل",2,0],["واِسْرُرْ هِلالَ العيدِ منكَ بنظرةٍ","تكفيهِ نقْصَ التِمِّ من لألائِهِ",105,"ا",3,0],["وأسرَجُوا وألجَمُوا","مَتنَ الهوَى في السُّحبِ",106,"ب",1,0],["وَأَسَرنا عَدِيَّها وَاِصطَنَعنا","بِيَدٍ لَو أَثابَ مِنّا نَجاحا",107,"ح",2,0],["وَأَسَرتِني وأنا الطّليقُ وطالما","أسَرَ الهوى وقَتَلْتِ مَنْ لا يُفتَنُ",108,"ن",1,0],["وَأَسْرَعَتْ سَلْوَتِي وَدَاعَاً","فَحَبَّذَا ذَلِكَ الوَدَاعُ",109,"ع",1,0],["وَأَسْرَعَتْ فِيْهِمُ المَنَايَا","وَسَيْرُ خَيْلِ المَنُونِ رَكْضُ",110,"ض",1,0],["وأسروا مروان فيمن قد اسر","وابن الزبير مع جميع من ذكر",111,"ر",1,0]]}