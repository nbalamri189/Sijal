,"https://www.aldiwan.net/poem52064.html","الوافر"],[272,"تطاول ليلي بعد ليلى بثهمد","https://www.aldiwan.net/poem52073.html","الطويل"],[272,"سمعت سويجع الاثلاث غنى","https://www.aldiwan.net/poem52085.html","الوافر"],[276,"لمن وقعة بالغرب ضعضعت الشرقا","https://www.aldiwan.net/poem25477.html","الطويل"],[276,"نور الهداية ما أضاء ولاحا","https://www.aldiwan.net/poem25603.html","الكامل"],[281,"سوى باكيك من ينهى العذول","https://www.aldiwan.net/poem60710.html","الوافر"],[283,"تظلموا وهم عقوا وهم ظلموا","https://www.aldiwan.net/poem32460.html","البسيط"],[298,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[298,"إذا ما امتطيت الفلك مقتحم البحر","https://www.aldiwan.net/poem33276.html","الطويل"],[305,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[305,"بنفس أفدي خير من وطئ الثرى","https://www.aldiwan.net/poem16863.html","الطويل"],[329,"هذه دارها وتلك رباها","https://www.aldiwan.net/poem55027.html","الطويل"],[329,"على نبعك يا حب","https://www.aldiwan.net/poem55032.html","الهزج"],[354,"فدى لك ذا العبد مع ما ملك","https://www.aldiwan.net/poem40009.html","المتقارب"],[354,"تنزه عن بني الدنيا وعاد","https://www.aldiwan.net/poem40384.html","الوافر"],[365,"أما تحية الطرف الكحيل","https://www.aldiwan.net/poem60801.html","الوافر"],[367,"قم فاسقني مما تروق","https://www.aldiwan.net/poem17235.html","مجزوء الكامل"],[372,"يا من له بيت مجد","https://www.aldiwan.net/poem57336.html","المجتث"],[381,"دعك من نهي النهاة","https://www.aldiwan.net/poem48799.html","مجزوء الرمل"],[392,"يقول طاهر عسى الله يعين","https://www.aldiwan.net/poem54553.html","عموديه"],[404,"تبين ثغر الفجر لما تبسما","https://www.aldiwan.net/poem33450.html","الطويل"],[417,"فتن الأنام بطرفه وبجيده","https://www.aldiwan.net/poem53963.html","الكامل"],[417,"سأبكي وأستبكي عليك المعاليا","https://www.aldiwan.net/poem53972.html","الطويل"],[453,"حيا دمشق فكم فيها لذي وطر","https://www.aldiwan.net/poem13761.html","البسيط"],[453,"ما للرياض تنمنمت أدواحها","https://www.aldiwan.net/poem13951.html","الكامل"],[454,"ترفع عن معاداة الكريم","https://www.aldiwan.net/poem61339.html","الوافر"],[454,"حلمت ولم أعلم أحلمى يقظة","https://www.aldiwan.net/poem61799.html","الطويل"],[459,"أخوي والعشاق إخوه","https://www.aldiwan.net/poem55820.html","مجزوء الكامل"],[462,"إذا ما الجياد الجرد شدت لغاية","https://www.aldiwan.net/poem16225.html","الطويل"],[465,"لقد أهدت كتابك منك كف","https://www.aldiwan.net/poem3352.html","عموديه"],[465,"أشرب على ورد الخدود وغنني","https://www.aldiwan.net/poem3431.html","عموديه"],[480,"من للثكالى وللجرحى وأيتام","https://www.aldiwan.net/poem37205.html","البسيط"],[480,"الذكر أبقى لكم والمال عارية","https://www.aldiwan.net/poem37207.html","البسيط"],[494,"فليالي الصبا أسر ليال","https://www.aldiwan.net/poem67307.html","الخفيف"],[501,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[510,"هل عرفت الغداة رسماً محيلا","https://www.aldiwan.net/poem751.html",""],[515,"هذا الحمى فانزل على جرعائه","https://www.aldiwan.net/poem20799.html","الكامل"],[539,"السحر هذا ما أرى","https://www.aldiwan.net/poem48280.html","عموديه"],[544,"عجلا اليوم صاحبي رواحا","https://www.aldiwan.net/poem1764.html","الخفيف"],[552,"وحللت من قلبي وأنت بخيلة","https://www.aldiwan.net/poem47182.html","الكامل"],[568,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[568,"أمر عيش وحال خفض","https://www.aldiwan.net/poem69620.html","مخلع البسيط"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["وَأُسرَةِ عِزٍّ طِوالِ القَنا","إِذا نَزَلَ الذُلُّ قالوا اِرحَلِ",0,"ل",1,0],["وَأَسرَفتُ بِالبِشرِ حَتّى ظَنَن","تُ أَنَّكَ أَضجَعتَ فيهِ النِفاقا",1,"ق",2,0],["وَأَسري إِلَيها وَالهَوى يَستَفِزُّني","بِمُحمَرَّةِ الأَخفافِ فُتلِ المَرافِقِ",2,"ق",1,0],["وأسْري بعيسٍ كالأهِلّةِ فوقَها","وُجوهٌ منَ الأقْمارِ أبْهى وأنْوَرُ",3,"ر",1,0],["وَأَسرَفَ في حُبِّ الحَياةِ فَحاطَها","بِسورٍ مِنَ الأَهوالِ لَم يَنجُ راكِبُه",4,"ب",2,0],["وَأَسرَعَ في الفَواحِشِ كُلُّ طِملٍ","يَجُرُّ المُخزِياتِ وَلا يُبالي",5,"ل",2,0],["وَأَسرَعَ فيها قَبلَ ذَلِكَ حِقبَةً","رُكاحٌ فَجَنبا نُقدَةٍ فَالمَغاسِلُ",6,"ل",1,0],["وَأُسِرتُ في مَجرى خُيولي غازِياً","وَحُبِستُ فيما أَشعَلَت نيراني",7,"ن",2,0],["وَأَسرٌ أُقاسيهِ وَلَيلٌ نُجومُهُ","أَرى كُلَّ شَيءٍ غَيرَهُنَّ يَزولُ",8,"ل",1,0],["وَأَسَرنا مِنكُمُ أَعدادَهُم","فَاِنصَرَفتُم مِثلَ إِفلاتِ الحَجَل",9,"ل",1,0],["وأسرة جانسوا إذا حكموا","إكراه عدل القضا بإكرامه",10,"م",2,0],["وأسرِجِ المركبَ المعرَّى","قبلَ ورودِ الوغى وألجِمْ",11,"م",1,0],["وَأَسرَعَها إِلى الأَعداءِ سَيراً","إِذا ما اِستُبطِئَ الفَرَسُ الجَرورُ",12,"ر",1,0],["وَأَسرَعتَ إِلى السَيفِ أَوِ السُمِّ أَوِ النارِ","لِكَي تَخرُجَ مِنَ دُنيا ذَوُها غَيرُ أَحرارِ",13,"ر",1,0],["وأَسرابُ ذاكَ الفَراشِ الأَنيقِ","ونَحْلٌ يُغنِّي وغيمٌ يَمُرْ",14,"ر",1,0],["وأسرفت تبغى عريض الغنى","أقبلك من ناله بالسرف",15,"ف",1,0],["وَأَسرَعُ مَفعولٍ فَعَلتَ تَغَيُّراً","تَكَلُّفُ شَيءٍ في طِباعِكَ ضِدُّهُ",16,"د",2,0],["وَأَسري في ظَلامِ اللَيلِ وَحدي","كَأَنّي مِنهُ في قَمَرٍ مُنيرِ",17,"ر",1,0],["وَأَسرِجَتِ الكُمَيتُ فَناقَلَت بي","عَلى إِعقاقِها وَعَلى غِشاشي",18,"ش",2,0],["واسرقْ من الأيامِ حظ","ظَكَ من حَلالٍ أو حرامِ",19,"م",1,0],["وَأَسرَينَ لَيلاً فَخِلنا بِهِن","نَ مَثنى النُجومِ وَوُحدانَها",20,"ن",3,0],["وَأَسرارُ المَلاحِظِ لَيسَ تَخفى","وَقَد تُغري بِذي اللَحظِ الجُفونُ",21,"ن",1,0],["وأَسرفَ في الوَدادِ على التَّنائي","فحينَ دَنَوْتُ أسرفَ في الشِّقاقِ",22,"ق",1,0],["وَأَسرَعتُ في ديني وَلَم أَقضِ بُغيَتي","هَرَبتُ بِديني مِنكِ إِن نَفَعَ الهَرَب",23,"ب",1,0],["وَأَسَرُّ ما يُلقى الفَتى في نَفسِهِ","يَبتَزُّهُ نابُ الزَمانِ وَمَخلَبُه",24,"ب",2,0],["وَأَسرَعُ ما يَكونُ الشَيءُ نَقصاً","فَأَقرَبُ ما يَكونُ إِلى كَمالِه",25,"ل",2,0],["وَأُسرِحُ في حِمى جَيرونَ طَرفي","وَأَربَعُ في رِياضِ النَيِّرَينِ",26,"ن",1,0],["وأسرها بحكاية وقعت","ورواية من نسج أفكاري",27,"ي",1,0],["وَأَسرى تَحتَ نَجمٍ من سناني","إِذا نَجمٌ عنِ الأَبصارِ غابا",28,"ب",2,0],["وأسرقُ ما استطعتُ منَ المعاني","فإنْ فقتُ القديمَ حمدْتُ سيري",29,"ر",2,1],["وَأَسرِج لِيَ الدَهماءَ وَاِذهَب بِمِمطَري","وَلا تُعلِمَن حَيّاً مِنَ الناسِ مَذهَبي",30,"ب",2,0],["وَأَسري فَأَستَصفي مِنَ السَيفِ صاحِباً","وَأَركَبُ مِن ظَهرِ الدُجُنَّةِ أَدهَما",31,"م",2,0],["وَأَسرى إِذا ما ذُو الهَوى هالَهُ السُرى","وَأُعمِلُ لَيلَ الناجِياتِ اليَعامِلِ",32,"ل",1,0],["وَأَسرَفوا في لَكمِهِ وَدَفعِهِ","وَاِنطَلَقَت أَكُفُّهُم في صَفعِهِ",33,"ه",1,0],["وَأُسرَةُ ثابِتٍ وَجُموعُ كَلبٍ","سَرى بِحِمامِهِم مِنّا اِعتِكارُ",34,"ر",1,0],["وَأَسرَوا عَلى الخَيلِ العِتاقِ وَأَصمَتوا","نَواطِقَها إِلّا تَحَمحُمَ هائِبِ",35,"ب",1,0],["وَأَسرارُ بَعضِ الناسِ باتَت لِناظِرٍ","كَأَسرارِ كَفٍّ غَيرِهِنَّ خَوافي",36,"ف",2,0],["وَأَسرَعَ مِنّا إِن طُرِدنا اِنصِرَافةً","وأَكرَمَ مِنّا إِن طَرَدنا وأَظفَرا",37,"ر",2,0],["وَأَسرَعَ مَّنا إِن أَرَدنا اِنصِرافةً","وَأَكثَرَ مِنّا دَارِعينَ وحُسَّرا",38,"ر",2,0],["وأسرَّا في إذن رضوان شيئاً","فأباح الجواز وهو عسير",39,"ر",1,0],["وأسرجت الكميت فناقلت بي","على إعقاقها وعلى غشاش",40,"ش",1,0],["وَأَسْرَعُ مُنْجِدٍ إِنْ جَدَّ جَدٌّ","يُقِيلُ مِنَ العِثَارِ المُسْتَقِيلا",41,"ل",2,0],["وَأَسرَعَت في صَرعِهِ مِثلَما","تَأخُذُ كَفّك الحاسِد اللَقطا",42,"ط",2,0],["وأسراب الجحيمِ مُحلِّقاتٍ","إذا ما حوَمتْ قذفتْ ضِرامَا",43,"م",2,0],["وأسرَفَ الشيوخُ في الخصامِ","واحتدمتَ معركةُ الكلامِ",44,"م",1,0],["وأسرع ينضو ثوبها متنصلا","وربك يدري ما تكن الضمائر",45,"ر",1,0],["وأسرّت قدسا وأبدت شعارا","خلفه لو علمت ألف شعيره",46,"ر",2,0],["وأسرعت في خطاها فوق طاقتها","فأصبحت وهي تشكو الأيْنَ والسأما",47,"م",2,0],["وأسرح وفي بالي انّه في حدا . دربينه","ياقبل بيته ببيتين .. أو على دوّاااره",48,"ر",2,0],["وأسْرَيْنَ لَيْلاً، فخِلْنَا بهِ","نّ مَثنى النّجومِ ووُحْدانَهَا",49,"ن",3,0],["واسرق من الكنز المقدّس مغربا","حلو الأصيل ومشرقا لمّاحا",50,"ح",2,0],["وأسرّ الشكوى حياء وكبرا","ربّ شكوى إسرارها إعلان",51,"ن",1,0],["وأسرف في الذكرى لأنزح نبعها","ولكنّ نبع الذكريات جموم",52,"م",1,0],["واسرارهم طيارة الطور للعلا","مجردة عما سوى الحب يا خلي",53,"ل",2,0],["وأسرار بلب دمي أقامت","بلبي في القعود وفي القيام",54,"م",1,0],["واسَرحْ سَوامَك في رياضِ سعادةٍ","وعميمِ عُشْبٍ بالعلاء منوِّرِ",55,"ر",1,0],["وَأَسرَعُ في مَنعِ الذِمارِ إِجابَةً","إِذا نادَتِ الأَبطالُ هَل مِن مُقارِعِ",56,"ع",1,0],["وَأَسرى بِهِ إِذ كَمَّلَ اللَهُ سِنَّهُ","مَراقيهِ في الإِسراءِ تَقضي بِأَنَّهُ",57,"ه",1,0],["وَإِسراؤُهُ يَبدو بِهِ الفَضلُ وَالفَصلُ","وَلَمّا غَدا يَبغي الحَقيقَةَ جاهِداً",58,"د",2,0],["وَأَسرى بِهِ لَيلاً فَأَكملَ أَمرَهُ","ضَميرٌ تَوَلَّت كَفُّ جِبريلَ طُهرَهُ",59,"ه",1,0],["وَأَسرى بِهِ حالاً وَشَفَّعَهُ غَدا","جَرَت لَيلَةُ الإِسراءِ ذِكراً مُخَلَّدا",60,"د",2,0],["وأسرع من يعاجله رداه","ظلوم بالخيانة يستعين",61,"ن",1,0],["وَأَسرَعِها إِلى الغاياتِ سَعياً","عَلى قَدَمٍ وَأَرساها عِمادا",62,"د",2,0],["وَأَسرَعنا لَعَمرِو بَنِى زُبَيدٍ","فأَحرَزَهُ نَجاءُ الهارِبِينا",63,"ن",2,0],["واسرقْ بنا خُلَس الزمان مُبادرا","والدهرُ في غَفَلاته لم يشعر",64,"ر",1,0],["وأسرى في حبال الذل فيهم","على سغب ومعطشة كلوم",65,"م",1,0],["وأسرّ بالإنسان أبغضه","فإذا أمرّ أذقته شهدا",66,"د",2,0],["وَأَسرى بهِ للقُدسِ في بعض ليلةٍ","وَمِنها إلى السبعِ العُلا حبّذا المسرى",67,"ر",2,0],["وَأَسرارهُ في كلّ شيءٍ كثيرةٌ","وَقَد تَنجلي طوراً ولا تنجلي طورا",67,"ر",2,0],["وَأَسَرتُمُ أَنَساً فَما حاوَلتُمُ","بِإِسارٍ جارِكُمُ بَني الميقابِ",68,"ب",1,0],["وَأَسرى مُقدِماً عَمرو بنُ سَعدٍ","إِلَيهِ بِكُلِّ شَيطانٍ غَوِيِّ",69,"ي",1,0],["وَاِسرَح رِكابَكَ آمِناً","مِمّا يَريبُكَ مُخصِبا",70,"ب",2,0],["وَأَسْرَجَهَا بِسِرَاجِ الْهُدَى","وَكَمْ مَكَثَتْ قَبْلُ تَحْكِي قُبُورَا",71,"ر",2,0],["وَأَسْرِجِي يا قَبَسَ الْ","مُنَى لَهُ دُجُونَهْ",72,"ن",2,0],["واسرع من يدعى لكنف ملمة","ورفع عذاب عن سواه أليم",73,"م",1,0],["وأسرع من يجاب له دعاء","اذا رمق السماء بلا اِفتخار",74,"ر",1,0],["واسرك وَهنا من هناك إِلى هنا","يذكرني عهدا تقادم بيننا",75,"ن",2,0],["واسرعهم عَلى المَلهوف عطفا","واسمعهم لداعي الخير أذزا",76,"ز",2,0],["وَأَسْرَفَ أَهْلوهَا مَعَاصِيَ أَوْبَقَت","فَما زَادَ أَنْ أَغْضَى حَنَاناً وأَنْ أَبْقَى",77,"ق",2,0],["وأسِرّةٍ عَنْ بشْرِها ورُوائِها","نَروِي أحاديثَ السّماح صِحاحا",78,"ح",2,0],["وَأَسْرَعْتَ التَّرَحُّلَ عَنْ دِيارٍ","سَواءٌ هُنَّ بَعْدَكَ وَالطُّلُولُ",79,"ل",1,0],["وَأُسرَةٌ كَأُسودِ الغيلِ ضارِيَةٌ","هُمُ لَدى الرَّوعِ إِذ يُلقى بِهِم بُهَمُ",80,"م",1,0],["وأَسرَعوا إليهِ","وأَقبَلوا عليهِ",81,"ه",1,0],["وأسرَتي في الأَسرِ","يَشكونَ كلَّ عُسرِ",81,"ر",1,0],["وأَسرى به في لَيلةٍ لسَمائِهِ","فَعادَ وَجَيبُ اللَيل ما شُقَّ عن فَجرِ",82,"ر",1,0],["وأسرار أمر اللَه نوحاً وقَد دعا","على قومه أن يغرقوا بالسفينة",83,"ه",1,0],["وأسرى به الرب العظيم إلى العلا","فسبحان من أسرى وبورك من سرى",84,"ر",2,0],["وأسرّت إليّ أن حصحصَ الحقّ","وخابت شماتةُ اللوّام",85,"م",1,0],["وأسرى في سماء الروح","من أشواقه ركب",86,"ب",1,0],["وَأسرع مِنّا نَداك الَّذي","بَلَغناه مِن قَبل أَن نَسأَلَك",87,"ك",1,0],["وَأسري في الفَلاة بِلا أَنيس","سِوى وَحش السَباسب وَالوهادِ",88,"د",1,0],["وأسْرفَ في عَطِيَّةِ مُستَميحٍ","وأصْفَحَ عَن جِنايةِ مُستَقيل",89,"ل",1,0],["وَاِسرِق بِنا الأَيّامَ فَال","أَيامُ لِلأَعمارِ تَسرِق",90,"ق",1,0],["وأسرعَ الجودُ سَبقاً","فَليَلحقِ التَّقسيطُ",91,"ط",1,0],["وَأَسرق اللذات ما دا","م لَكَ الدَهر مُواتي",92,"ت",2,0],["واسرح ورح واصبر مع الصابرين","واطرد وراهم خب والهف",93,"ف",1,0],["وأسرى به نحو السموات ربه","وأركبه ظهر البراق وأكرما",94,"م",2,0],["واسرح من اللَّذات في مُتَنَزَّهٍ","خَلَطَ الغرامُ ظِباءه بأسوده",95,"د",2,0],["وأسْرَعْتَ إحراقَ القلوب صوادياً","وعاجَلْتَ إهراقَ الدموع سواقيا",96,"ي",2,0],["واسرح مدى الطرف من ألفاف دُمَّرها","بين الغياض لدى مستشرف خضر",97,"ر",1,0],["وأسرّة شرَقَتْ بكلِّ بشاشَةٍ","حتى تحقق في الأمورِ نجاحُها",98,"ح",3,0],["وأسراب السوائم وهي ترعى","كحاكمةعلى ملك عظيم",99,"م",1,0],["وأسرارها شتى ولكن تشرّبت","خوالجها أنداءُ عُشبٍ وآكامِ",100,"م",1,0],["وأُسَرُّ بالطيفِ الوَصو","لِ وفي وصال الطيف جفوَهْ",101,"و",2,0],["وأسرعُ منْ إِقدامهِ يومَ حرْبه","نَداهُ إلى العافين في الإِزَم الغُبْر",102,"ر",1,0],["وأسرعتِ المطيُّ بحامليهِ","ولا عقرٌ يخاف ولا عثار",103,"ر",1,0],["واسرح سوام اللحظ بين رياضها","وحذار من فتكات تلك الأعينِ",104,"ن",1,0],["وأسرعت اسد الأتراك ثائرة","تحمي طرابلسا من دوس أقدام",105,"م",1,0],["واسرع لبر ولا تمنن فتحبطه","وبالكرام إذا ما شئت فالتحق",106,"ق",1,0],["وَأَسَرُّ البِلاد ما حَمَدَ السا","كِنُ فيها خَلائِقَ الجيرانِ",107,"ن",1,0],["واسْرِ مع القومِ على آدابِهِمْ","عندَ الصَّباحِ يحمدُ القومُ السُّرَى",108,"ا",1,0],["وَأَسَرنا مُلوكَهُم يَومَ سِرنا","وَأَذَقنا الأَعداءَ طَعماً وَبيلا",109,"ل",2,0],["واِسْرُرْ هِلالَ العيدِ منكَ بنظرةٍ","تكفيهِ نقْصَ التِمِّ من لألائِهِ",110,"ا",3,0],["وأسرَجُوا وألجَمُوا","مَتنَ الهوَى في السُّحبِ",111,"ب",1,0],["وَأَسَرنا عَدِيَّها وَاِصطَنَعنا","بِيَدٍ لَو أَثابَ مِنّا نَجاحا",112,"ح",2,0],["وَأَسَرتِني وأنا الطّليقُ وطالما","أسَرَ الهوى وقَتَلْتِ مَنْ لا يُفتَنُ",113,"ن",1,0],["وَأَسْرَعَتْ سَلْوَتِي وَدَاعَاً","فَحَبَّذَا ذَلِكَ الوَدَاعُ",114,"ع",1,0],["وَأَسْرَعَتْ فِيْهِمُ المَنَايَا","وَسَيْرُ خَيْلِ المَنُونِ رَكْضُ",115,"ض",1,0],["وأسروا مروان فيمن قد اسر","وابن الزبير مع جميع من ذكر",116,"ر",1,0]]}