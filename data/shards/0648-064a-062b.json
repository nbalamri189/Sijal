{"poems":[[53,"أراعي بلوغ الشيب والشيب دائيا","https://www.aldiwan.net/poem29567.html","الطويل"],[63,"ومشبلة شمطاء تبكي من النوى","https://www.aldiwan.net/poem46114.html","الطويل"],[63,"رماك بشوق فالمدامع ذرف","https://www.aldiwan.net/poem46173.html","الطويل"],[63,"أثرها وهي تنتعل الظلالا","https://www.aldiwan.net/poem46214.html","الوافر"],[86,"إليكن يهدي النيل ألف تحية","https://www.aldiwan.net/poem68894.html","الطويل"],[23,"ألم تذر العين تسهادها","https://www.aldiwan.net/poem21258.html","المتقارب"],[23,"لقد هاج نفسك أشجانها","https://www.aldiwan.net/poem21380.html","المتقارب"],[92,"بالأمس قد كانت حياتي","https://www.aldiwan.net/poem38891.html","المجتث"],[85,"اليوم ينتحر المقطم","https://www.aldiwan.net/poem7276.html","مجزوء الكامل"],[85,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[85,"إلى عرفات الله يا خير زائر","https://www.aldiwan.net/poem63776.html","الطويل"],[45,"أبى الليل إلا أن يعود بطوله","https://www.aldiwan.net/poem65540.html","الطويل"],[49,"لمن طلل أسائله","https://www.aldiwan.net/poem63087.html","مجزوء الوافر"],[97,"لمن العيون الفاترات ذبولا","https://www.aldiwan.net/poem24801.html","الكامل"],[80,"تغنت قيان الورق في الورق الخضر","https://www.aldiwan.net/poem31443.html","الطويل"],[105,"خلت المنازل منك والأوطان","https://www.aldiwan.net/poem41941.html","الكامل"],[105,"هذا إمام الدين في أعلامه","https://www.aldiwan.net/poem44206.html","الكامل"],[48,"وقهوة مرة باكرت صبحتها","https://www.aldiwan.net/poem62511.html","البسيط"],[46,"أشهد أني رجل ناقص","https://www.aldiwan.net/poem23271.html","السريع"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54855","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54523","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55024","الكامل"],[106,"أسطول معاوية","https://www.poetsgate.com/ViewPoem.aspx?id=179631",""],[113,"يا نعم حسبك ان عين زماني","https://www.aldiwan.net/poem40475.html","عموديه"],[133,"لتهن البلاد وسكانها","https://www.aldiwan.net/poem49123.html","المتقارب"],[158,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[158,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[164,"يذكرني الحمى عهد الوصال","https://www.aldiwan.net/poem46897.html","الوافر"],[187,"مقام أجل الرسل أعلى وأعظم","https://www.aldiwan.net/poem35106.html","الطويل"],[197,"اتتك القوافي ما لها عنك مذهب","https://www.aldiwan.net/poem45647.html","الطويل"],[219,"قد عشقناك لا لأنك أنثى","https://www.aldiwan.net/poem55278.html","الخفيف"],[223,"بعلاك يختال الزمان تبخترا","https://www.aldiwan.net/poem55221.html","الخفيف"],[273,"ألم ترها تسمو لأشرف غاية","https://www.aldiwan.net/poem25624.html","الطويل"],[280,"وأهيف لحظه بالسحر ناجا","https://www.aldiwan.net/poem32838.html","الوافر"],[369,"إذا ما عقد الكاتم","https://www.aldiwan.net/poem57155.html","الهزج"],[374,"وشاحك فخر في الأنام جليل","https://www.aldiwan.net/poem59286.html","الطويل"],[406,"لك أن أطيعك راضيا أو ساخطا","https://www.aldiwan.net/poem32575.html","الكامل"],[413,"من لصب مستطار القلب هائم","https://www.aldiwan.net/poem53954.html","الرمل"],[413,"إسأل الأرسم لو ردت جوابا","https://www.aldiwan.net/poem54032.html","الرمل"],[462,"سلا عنك قلبي بعد ما قيل لا يسلو","https://www.aldiwan.net/poem3165.html","عموديه"],[536,"أمري إلى المولى العلي الشان","https://www.aldiwan.net/poem47924.html","عموديه"],[549,"حلفت بمن لاذت قريش ببيته","https://www.aldiwan.net/poem47812.html","الطويل"]],"verses":[["وَيَثني جَواداً مِن دَمِ الطَعنِ ناعِلاً","وَيُزجي نَجيباً مِن وَجى السَيرِ حافِيا",0,"ي",2,0],["وَيَثْلِمُ عِرْضِي عِنْدَهُمْ كلُّ كاشِحٍ","وَأَدْفَعُ عَنْ أَعْراضِهِمُ أَلسُناً لُدّا",1,"د",2,0],["ويَثْني هَواديها إذا طَمِحَتْ بِها","منَ القِدِّ مَلْوِيُّ المَرائِرِ مُحْصَفُ",2,"ف",1,0],["ويَثْنونَ المُغيرَةَ عن هواها","إذا الوادي بِظَعْنِ الحَيِّ سالا",3,"ل",2,0],["وَيُثني عَلى أَعمالِكُنَّ مُوَكِّلي","بِإِطراءِ أَهلِ البِرِّ وَالحَسَناتِ",4,"ت",1,0],["وَيَثرِبُ تَعلَمُ أَنّا بِها","أُسودٌ تُنَفِّضُ أَلبادَها",5,"د",3,0],["وَيَثرِبُ تَعلَمُ أَنّا بِها","إِذا أَلبَسَ الحَقُّ ميزانُها",6,"ن",3,0],["وَيَثرِبُ تَعلَمُ أَنّا بِها","إِذا قَحَطَ القَطرُ نُوآنُها",6,"ن",3,0],["وَيَثرِبُ تَعلَمُ أَنّا بِها","إِذا خافَتِ الأَوسَ جيرانُها",6,"ن",3,0],["وَيَثرِبُ تَعلَمُ إِذ حارَبَت","بِأَنّا لَدى الحَربِ فُرسانُها",6,"ن",3,0],["وَيَثرِبُ تَعلَمُ أَنَّ النَبيتَ","عِندَ الهَزاهِزِ ذُلّانُها",6,"ن",3,0],["وَيَثرِبُ تَعلَمُ أَنَّ النَبيتَ","لَيسَت بِشَيءٍ وَأَعوانُها",6,"ن",3,0],["ويُثيرُ في قلبي","أَناشيدَ الخُلُودِ السَّاحِرَهْ",7,"ه",1,0],["ويثير من بين المشا","كل عثيرا بالشر أقثم",8,"م",1,0],["ويثبتون فيه","تهمة سارقيه",9,"ه",1,0],["وَيُثني عَلَيكَ الراشِدونَ بِصالِحٍ","وَرُبَّ ثَناءٍ مِن لِسانِ رُفاتِ",10,"ت",1,0],["وَيَثنيهِ عَنها شَوقُهُ وَنِزاعُهُ","إِلى عَرضِ صَحنِ الجَعفَرِيِّ وَطولِهِ",11,"ل",2,0],["وَيَثني عِطفَهُ مَرَحاً","وَتُعجِبُهُ شَمائِلُهُ",12,"ل",2,0],["ويثور بي حبي فإن لفظٌ جرى","بفمي تعثر بالشفاه خجولا",13,"ل",2,0],["ويثنى عنِ الضّرْبِ الوجيعِ سُيوفَهُ","منَ الدّمِ حُمْراً في عجاجاته الكُدْرِ",14,"ر",1,0],["ويُثيرُ سُخْطَكَ أن يضيعَ لِمُسلمٍ","حَقٌّ ويَغشاهُ أذىً وهَوانُ",15,"ن",1,0],["ويثوبَ جاهلُهُم إلى دينِ الهُدَى","والنّورِ من دينِ العَمى وظلامِهِ",16,"م",2,0],["وَيُثبِتُ الماءُ في حافاتِها حَبَباً","كَالقَطرِ يَثبُتُ في حافاتِ ضَحضاحِ",17,"ح",1,0],["وَيَثبُتُ اللَهُ وَسُلطانُهُ","وَكُلُّ أَمرٍ غَيرَهُ يَضمَحِل",18,"ل",1,0],["ويَثْبُتانِ أَيَّما ثَباتِ","وذاكَ من سَلامَةِ الأبياتِ",19,"ت",1,0],["ويُثَابُ بِالإِقْبَالِ عَزْمُ مُبَرِّزٍ","وَيُحَثُّ بِالآمَالِ عَزْمُ مُقَصِّرِ",20,"ر",1,0],["وَيُثْقلُهُ اهْتِمَامُ غَيْرُ مُجْدٍ","بِمَا فِي حُكْمِهِ الدُّنْيَا سَوَاءُ",21,"ا",2,0],["وَيُثِيرُ مِنْ غَضَبِ الغِضَابِ لِمَجْدِهِ","هِمَماً تُعِيدُ لَهُ المَقَامَ الأَشْرَفَا",22,"ف",2,0],["ويثِبْنَ -آونَةً- أسودَ عَرينةٍ","ويطِرْنَ -آونَةً- حَمامَ سلام",23,"م",1,0],["ويثير شقشقة ويملأ مرجفا","طرق الفضاء بعجة البهتان",24,"ن",1,0],["ويثني الشمالَ أفانينها","وتبسم تيهاً ثغورُ الزهورْ",25,"ر",1,0],["ويثنى بخير عن من الكفر دينه","ويستجلب الحمقى إليه ويجذب",26,"ب",1,0],["ويثني على الأصنام خيرا ولا يرى","لها عابداً ممن عصى أمر آمر",27,"ر",1,0],["ويثبتُ ركنُهُ في كلِّ خَطبٍ","تَزَلزلُ منهُ أركانُ الجِبالِ",28,"ل",1,0],["وَيثبتُ في كلّ البلاد ويرسخُ","وَربُّك يَهدي مَن يشاءُ ويمسخُ",29,"خ",1,0],["ويثربُ مما أدركتْ من رجائها","بمقدمكَ الميمون باتتْ ترحبُ",30,"ب",1,0],["ويثير اغتباط نفسي نفسا","ن بحبل الوداد تتصلان",31,"ن",1,0],["وَيُثيبُك الأَجرَ المُضاعفَ راحِلا","إِذ كنتَ أَفضَلَ من يُثاب وَأَجدَرا",32,"ر",2,0],["وَيَثْنِي مُلوُك الرّوم عمّا تَرُومُه","بِعَزْمة رَاض للدّيانة غَاضِبِ",33,"ب",1,0],["وَيَثني المُعتَفينَ وَهُم مِلاءُ ال","حَقائِبِ بَعدَ أَن مَلَأَ الفِجاجا",34,"ج",2,0],["ويَثنِيهِ ولو كانَ","عَلى ما سَرَّه عازِم",35,"م",1,0],["ويَثلبُنا أنّا نحبُّ عدوَّنا","وقد فاته أن الأمين فضيل",36,"ل",1,0],["ويُثِيرُ ذكراكُم زفيراً صَاعِداً","مُستَنبِطاً بلظَاهُ دمعاً سَاقطَا",37,"ط",2,0],["ويثير الوَجْد يوري زنده","فاحِمَ اللَّيل وفرع اللَّيل فاحم",38,"م",1,0],["ويثيب النَّاس جوداً وندىً","وهو لا يرجو من النَّاس ثوابا",39,"ب",2,0],["ويثني على عقل نماها جلاله","وحسك من شيء يجل به العقل",40,"ل",1,0],["وَيُثيبُ بِالحُسنى تهَامِيَّ العُلاَ","يَجزيهِ بِالإحسانِ عن إحسانِ",41,"ن",1,0],["ويثأرُ منكم ثائرٌ طال مطلُهُ","وقد تُظفر الأيّام من ليس يَظفرُ",42,"ر",1,0]]}