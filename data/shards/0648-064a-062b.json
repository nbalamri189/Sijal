{"poems":[[53,"أراعي بلوغ الشيب والشيب دائيا","https://www.aldiwan.net/poem29567.html","الطويل"],[63,"ومشبلة شمطاء تبكي من النوى","https://www.aldiwan.net/poem46114.html","الطويل"],[63,"رماك بشوق فالمدامع ذرف","https://www.aldiwan.net/poem46173.html","الطويل"],[63,"أثرها وهي تنتعل الظلالا","https://www.aldiwan.net/poem46214.html","الوافر"],[86,"إليكن يهدي النيل ألف تحية","https://www.aldiwan.net/poem68894.html","الطويل"],[23,"ألم تذر العين تسهادها","https://www.aldiwan.net/poem21258.html","المتقارب"],[23,"لقد هاج نفسك أشجانها","https://www.aldiwan.net/poem21380.html","المتقارب"],[92,"بالأمس قد كانت حياتي","https://www.aldiwan.net/poem38891.html","المجتث"],[85,"اليوم ينتحر المقطم","https://www.aldiwan.net/poem7276.html","مجزوء الكامل"],[85,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[85,"إلى عرفات الله يا خير زائر","https://www.aldiwan.net/poem63776.html","الطويل"],[45,"أبى الليل إلا أن يعود بطوله","https://www.aldiwan.net/poem65540.html","الطويل"],[49,"لمن طلل أسائله","https://www.aldiwan.net/poem63087.html","مجزوء الوافر"],[97,"لمن العيون الفاترات ذبولا","https://www.aldiwan.net/poem24801.html","الكامل"],[80,"تغنت قيان الورق في الورق الخضر","https://www.aldiwan.net/poem31443.html","الطويل"],[105,"خلت المنازل منك والأوطان","https://www.aldiwan.net/poem41941.html","الكامل"],[105,"هذا إمام الدين في أعلامه","https://www.aldiwan.net/poem44206.html","الكامل"],[48,"وقهوة مرة باكرت صبحتها","https://www.aldiwan.net/poem62511.html","البسيط"],[46,"أشهد أني رجل ناقص","https://www.aldiwan.net/poem23271.html","السريع"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54855","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54523","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55024","الكامل"],[106,"أسطول معاوية","https://www.poetsgate.com/ViewPoem.aspx?id=179631",""]],"verses":[["وَيَثني جَواداً مِن دَمِ الطَعنِ ناعِلاً","وَيُزجي نَجيباً مِن وَجى السَيرِ حافِيا",0,"ي",2,0],["وَيَثْلِمُ عِرْضِي عِنْدَهُمْ كلُّ كاشِحٍ","وَأَدْفَعُ عَنْ أَعْراضِهِمُ أَلسُناً لُدّا",1,"د",2,0],["ويَثْني هَواديها إذا طَمِحَتْ بِها","منَ القِدِّ مَلْوِيُّ المَرائِرِ مُحْصَفُ",2,"ف",1,0],["ويَثْنونَ المُغيرَةَ عن هواها","إذا الوادي بِظَعْنِ الحَيِّ سالا",3,"ل",2,0],["وَيُثني عَلى أَعمالِكُنَّ مُوَكِّلي","بِإِطراءِ أَهلِ البِرِّ وَالحَسَناتِ",4,"ت",1,0],["وَيَثرِبُ تَعلَمُ أَنّا بِها","أُسودٌ تُنَفِّضُ أَلبادَها",5,"د",3,0],["وَيَثرِبُ تَعلَمُ أَنّا بِها","إِذا أَلبَسَ الحَقُّ ميزانُها",6,"ن",3,0],["وَيَثرِبُ تَعلَمُ أَنّا بِها","إِذا قَحَطَ القَطرُ نُوآنُها",6,"ن",3,0],["وَيَثرِبُ تَعلَمُ أَنّا بِها","إِذا خافَتِ الأَوسَ جيرانُها",6,"ن",3,0],["وَيَثرِبُ تَعلَمُ إِذ حارَبَت","بِأَنّا لَدى الحَربِ فُرسانُها",6,"ن",3,0],["وَيَثرِبُ تَعلَمُ أَنَّ النَبيتَ","عِندَ الهَزاهِزِ ذُلّانُها",6,"ن",3,0],["وَيَثرِبُ تَعلَمُ أَنَّ النَبيتَ","لَيسَت بِشَيءٍ وَأَعوانُها",6,"ن",3,0],["ويُثيرُ في قلبي","أَناشيدَ الخُلُودِ السَّاحِرَهْ",7,"ه",1,0],["ويثير من بين المشا","كل عثيرا بالشر أقثم",8,"م",1,0],["ويثبتون فيه","تهمة سارقيه",9,"ه",1,0],["وَيُثني عَلَيكَ الراشِدونَ بِصالِحٍ","وَرُبَّ ثَناءٍ مِن لِسانِ رُفاتِ",10,"ت",1,0],["وَيَثنيهِ عَنها شَوقُهُ وَنِزاعُهُ","إِلى عَرضِ صَحنِ الجَعفَرِيِّ وَطولِهِ",11,"ل",2,0],["وَيَثني عِطفَهُ مَرَحاً","وَتُعجِبُهُ شَمائِلُهُ",12,"ل",2,0],["ويثور بي حبي فإن لفظٌ جرى","بفمي تعثر بالشفاه خجولا",13,"ل",2,0],["ويثنى عنِ الضّرْبِ الوجيعِ سُيوفَهُ","منَ الدّمِ حُمْراً في عجاجاته الكُدْرِ",14,"ر",1,0],["ويُثيرُ سُخْطَكَ أن يضيعَ لِمُسلمٍ","حَقٌّ ويَغشاهُ أذىً وهَوانُ",15,"ن",1,0],["ويثوبَ جاهلُهُم إلى دينِ الهُدَى","والنّورِ من دينِ العَمى وظلامِهِ",16,"م",2,0],["وَيُثبِتُ الماءُ في حافاتِها حَبَباً","كَالقَطرِ يَثبُتُ في حافاتِ ضَحضاحِ",17,"ح",1,0],["وَيَثبُتُ اللَهُ وَسُلطانُهُ","وَكُلُّ أَمرٍ غَيرَهُ يَضمَحِل",18,"ل",1,0],["ويَثْبُتانِ أَيَّما ثَباتِ","وذاكَ من سَلامَةِ الأبياتِ",19,"ت",1,0],["ويُثَابُ بِالإِقْبَالِ عَزْمُ مُبَرِّزٍ","وَيُحَثُّ بِالآمَالِ عَزْمُ مُقَصِّرِ",20,"ر",1,0],["وَيُثْقلُهُ اهْتِمَامُ غَيْرُ مُجْدٍ","بِمَا فِي حُكْمِهِ الدُّنْيَا سَوَاءُ",21,"ا",2,0],["وَيُثِيرُ مِنْ غَضَبِ الغِضَابِ لِمَجْدِهِ","هِمَماً تُعِيدُ لَهُ المَقَامَ الأَشْرَفَا",22,"ف",2,0],["ويثِبْنَ -آونَةً- أسودَ عَرينةٍ","ويطِرْنَ -آونَةً- حَمامَ سلام",23,"م",1,0]]}