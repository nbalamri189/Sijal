,[4144,"","https://poetry.dctabudhabi.ae/diwan/poem/178138","الوافر"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97082","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94574","الطويل"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33069","المنسرح"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58179","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120200","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139637",""],[4755,"مَتَى يَفْقَأُ اللهُ هذِي الكُرَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=200256",""],[2052,"ألا إن سلطان البسيطة كلها","https://www.poetsgate.com/ViewPoem.aspx?id=189618",""],[4791,"الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=36905",""],[4830,"القلبُ الجَموح","https://www.poetsgate.com/ViewPoem.aspx?id=200251",""],[5055,"وثقت سد","https://www.poetsgate.com/ViewPoem.aspx?id=101662",""],[5183,"هبة العليم","https://www.poetsgate.com/ViewPoem.aspx?id=180194",""],[5200,"أيا واحد الناس فى قوله","https://www.poetsgate.com/ViewPoem.aspx?id=200796",""],[5419,"الخاتم","https://www.poetsgate.com/ViewPoem.aspx?id=31450",""],[5493,"بحرُ العبور","https://www.poetsgate.com/ViewPoem.aspx?id=198115",""],[5596,"الى الشيخ الصوّافي","https://www.poetsgate.com/ViewPoem.aspx?id=206689",""],[5616,"قنديل","https://www.poetsgate.com/ViewPoem.aspx?id=205034",""],[5616,"أحوال","https://www.poetsgate.com/ViewPoem.aspx?id=205037",""],[5691,"فتنَةُ كربُلاء...!","https://www.poetsgate.com/ViewPoem.aspx?id=206635",""],[5717,"ومن شرائط النبي حمله","https://www.poetsgate.com/ViewPoem.aspx?id=170604",""],[5781,"قارئ كفّ","https://www.poetsgate.com/ViewPoem.aspx?id=208937",""],[5829,"البنت اللعوب","https://www.poetsgate.com/ViewPoem.aspx?id=152563",""],[5953,"لاح ضياء القمر الزاهر","https://www.poetsgate.com/ViewPoem.aspx?id=93849",""],[5309,"وحورية عند الأصيل عرفتها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573599",""],[5309,"ذلك البدر كنت ادري مصيره","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573542",""],[6302,"بَغدادْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86227&r=&rc=25",""],[6324,"نجوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87950&r=&rc=15",""]],"verses":[["وَيَثني جَواداً مِن دَمِ الطَعنِ ناعِلاً","وَيُزجي نَجيباً مِن وَجى السَيرِ حافِيا",0,"ي",2,0],["وَيَثْلِمُ عِرْضِي عِنْدَهُمْ كلُّ كاشِحٍ","وَأَدْفَعُ عَنْ أَعْراضِهِمُ أَلسُناً لُدّا",1,"د",2,0],["ويَثْني هَواديها إذا طَمِحَتْ بِها","منَ القِدِّ مَلْوِيُّ المَرائِرِ مُحْصَفُ",2,"ف",1,0],["ويَثْنونَ المُغيرَةَ عن هواها","إذا الوادي بِظَعْنِ الحَيِّ سالا",3,"ل",2,0],["وَيُثني عَلى أَعمالِكُنَّ مُوَكِّلي","بِإِطراءِ أَهلِ البِرِّ وَالحَسَناتِ",4,"ت",1,0],["وَيَثرِبُ تَعلَمُ أَنّا بِها","أُسودٌ تُنَفِّضُ أَلبادَها",5,"د",3,0],["وَيَثرِبُ تَعلَمُ أَنّا بِها","إِذا أَلبَسَ الحَقُّ ميزانُها",6,"ن",3,0],["وَيَثرِبُ تَعلَمُ أَنّا بِها","إِذا قَحَطَ القَطرُ نُوآنُها",6,"ن",3,0],["وَيَثرِبُ تَعلَمُ أَنّا بِها","إِذا خافَتِ الأَوسَ جيرانُها",6,"ن",3,0],["وَيَثرِبُ تَعلَمُ إِذ حارَبَت","بِأَنّا لَدى الحَربِ فُرسانُها",6,"ن",3,0],["وَيَثرِبُ تَعلَمُ أَنَّ النَبيتَ","عِندَ الهَزاهِزِ ذُلّانُها",6,"ن",3,0],["وَيَثرِبُ تَعلَمُ أَنَّ النَبيتَ","لَيسَت بِشَيءٍ وَأَعوانُها",6,"ن",3,0],["ويُثيرُ في قلبي","أَناشيدَ الخُلُودِ السَّاحِرَهْ",7,"ه",1,0],["ويثير من بين المشا","كل عثيرا بالشر أقثم",8,"م",1,0],["ويثبتون فيه","تهمة سارقيه",9,"ه",1,0],["وَيُثني عَلَيكَ الراشِدونَ بِصالِحٍ","وَرُبَّ ثَناءٍ مِن لِسانِ رُفاتِ",10,"ت",1,0],["وَيَثنيهِ عَنها شَوقُهُ وَنِزاعُهُ","إِلى عَرضِ صَحنِ الجَعفَرِيِّ وَطولِهِ",11,"ل",2,0],["وَيَثني عِطفَهُ مَرَحاً","وَتُعجِبُهُ شَمائِلُهُ",12,"ل",2,0],["ويثور بي حبي فإن لفظٌ جرى","بفمي تعثر بالشفاه خجولا",13,"ل",2,0],["ويثنى عنِ الضّرْبِ الوجيعِ سُيوفَهُ","منَ الدّمِ حُمْراً في عجاجاته الكُدْرِ",14,"ر",1,0],["ويُثيرُ سُخْطَكَ أن يضيعَ لِمُسلمٍ","حَقٌّ ويَغشاهُ أذىً وهَوانُ",15,"ن",1,0],["ويثوبَ جاهلُهُم إلى دينِ الهُدَى","والنّورِ من دينِ العَمى وظلامِهِ",16,"م",2,0],["وَيُثبِتُ الماءُ في حافاتِها حَبَباً","كَالقَطرِ يَثبُتُ في حافاتِ ضَحضاحِ",17,"ح",1,0],["وَيَثبُتُ اللَهُ وَسُلطانُهُ","وَكُلُّ أَمرٍ غَيرَهُ يَضمَحِل",18,"ل",1,0],["ويَثْبُتانِ أَيَّما ثَباتِ","وذاكَ من سَلامَةِ الأبياتِ",19,"ت",1,0],["ويُثَابُ بِالإِقْبَالِ عَزْمُ مُبَرِّزٍ","وَيُحَثُّ بِالآمَالِ عَزْمُ مُقَصِّرِ",20,"ر",1,0],["وَيُثْقلُهُ اهْتِمَامُ غَيْرُ مُجْدٍ","بِمَا فِي حُكْمِهِ الدُّنْيَا سَوَاءُ",21,"ا",2,0],["وَيُثِيرُ مِنْ غَضَبِ الغِضَابِ لِمَجْدِهِ","هِمَماً تُعِيدُ لَهُ المَقَامَ الأَشْرَفَا",22,"ف",2,0],["ويثِبْنَ -آونَةً- أسودَ عَرينةٍ","ويطِرْنَ -آونَةً- حَمامَ سلام",23,"م",1,0],["ويثير فيهنّ الحياة شهيّة","والحبّ أرعن والشباب منيلا",24,"ل",2,0],["ويثير شقشقة ويملأ مرجفا","طرق الفضاء بعجة البهتان",25,"ن",1,0],["ويثني الشمالَ أفانينها","وتبسم تيهاً ثغورُ الزهورْ",26,"ر",1,0],["ويثنى بخير عن من الكفر دينه","ويستجلب الحمقى إليه ويجذب",27,"ب",1,0],["ويثني على الأصنام خيرا ولا يرى","لها عابداً ممن عصى أمر آمر",28,"ر",1,0],["ويثبتُ ركنُهُ في كلِّ خَطبٍ","تَزَلزلُ منهُ أركانُ الجِبالِ",29,"ل",1,0],["وَيثبتُ في كلّ البلاد ويرسخُ","وَربُّك يَهدي مَن يشاءُ ويمسخُ",30,"خ",1,0],["ويثربُ مما أدركتْ من رجائها","بمقدمكَ الميمون باتتْ ترحبُ",31,"ب",1,0],["ويثير اغتباط نفسي نفسا","ن بحبل الوداد تتصلان",32,"ن",1,0],["وَيُثيبُك الأَجرَ المُضاعفَ راحِلا","إِذ كنتَ أَفضَلَ من يُثاب وَأَجدَرا",33,"ر",2,0],["وَيَثْنِي مُلوُك الرّوم عمّا تَرُومُه","بِعَزْمة رَاض للدّيانة غَاضِبِ",34,"ب",1,0],["وَيَثني المُعتَفينَ وَهُم مِلاءُ ال","حَقائِبِ بَعدَ أَن مَلَأَ الفِجاجا",35,"ج",2,0],["ويَثنِيهِ ولو كانَ","عَلى ما سَرَّه عازِم",36,"م",1,0],["ويَثلبُنا أنّا نحبُّ عدوَّنا","وقد فاته أن الأمين فضيل",37,"ل",1,0],["ويُثِيرُ ذكراكُم زفيراً صَاعِداً","مُستَنبِطاً بلظَاهُ دمعاً سَاقطَا",38,"ط",2,0],["ويثير الوَجْد يوري زنده","فاحِمَ اللَّيل وفرع اللَّيل فاحم",39,"م",1,0],["ويثيب النَّاس جوداً وندىً","وهو لا يرجو من النَّاس ثوابا",40,"ب",2,0],["ويثني على عقل نماها جلاله","وحسك من شيء يجل به العقل",41,"ل",1,0],["وَيُثيبُ بِالحُسنى تهَامِيَّ العُلاَ","يَجزيهِ بِالإحسانِ عن إحسانِ",42,"ن",1,0],["ويثأرُ منكم ثائرٌ طال مطلُهُ","وقد تُظفر الأيّام من ليس يَظفرُ",43,"ر",1,0],["ويثور ثائرهم إذا ماعضهم","ناب الشقاء وسخطهم قد ينفجر",44,"ر",1,0],["ويثبت عين الجمع في كل فرقة","يسير بسر اللَه في كل سيرة",45,"ه",1,0],["ويثنى على شيء بشين شئونه","فيلهى بها أهواء نفس مهينة",45,"ه",1,0],["ويثرى بإيثاري ثرى كل مفلس","بكاسات كيسي كل كاس وكيس",45,"س",1,0],["ويُثبت مهما شاءَ ربّي بأمرِهِ","ويمحو ويقضي في الأُمورِ ويَقدِرُ",46,"ر",1,0],["وَيُثني عَلى عَليائه فيهِ مُخلص","بِما يَزدَري في نَظمه بِالقَلائد",47,"د",1,0],["وَيثني بِإِخلاص عَلَيها فَإنها","بِنته لإحيا نَفس غادٍ ووافد",48,"د",1,0],["وَيُثني عَلَيهم لا لشيء يَرومه","مَدى الدَهر مِنهم غَير رَدّ المَظالم",49,"م",1,0],["وَيُثني عَلَيهِ بُلبلُ الرَوضة الَّذي","بِمَدح الوَرى فيهِ عَلى الأَيك دَندنا",50,"ن",2,0],["وَيثبت ما أَقول لَكُم عَروس","مخدَّرة لَها بعل صَغير",51,"ر",1,0],["ويِثني هَوانا على أَنَّه","شريفُ المَناسب ساعٍ وَضيعُ",52,"ع",1,0],["وَيثقله عند النهوضِ إذا نَوى","قياماً ركيم الردفِ حين يجاذبُه",53,"ب",2,0],["ويَثْني نَحْوَ زائِرِهِ لُهاهُ","ولا يَثْني على إِثْمٍ إزارَهْ",54,"ر",2,0],["ويُثني عليك الخيرُ في كلّ محفلٍ","وتنظمُ أَشعار المديح وتُنشَدُ",55,"د",1,0],["ويُثني عليك الرَّكبُ ما أنتَ أهلُه","وتُثني المطايا تَحتَهُم والحَقَائِب",56,"ب",1,0],["ويُثيبُ قلباً قد أَضاعَ رشادَهُ","من فوقِ غُصنٍ في الهوى ميّاد",57,"د",1,0],["ويُثمِر زهرُ العلم في الغرب بينما","نراه بأَرض الشرق أصبح ذاويا",58,"ي",2,0],["ويثبت المنع مع التوّلد","منها بلا شرط هنا مقيد",59,"د",1,0],["ويثبت الرضاع بالشهود","بكل ما فيه من الحدود",60,"د",1,1],["ويثنيها عن الحرب","وقد أعيت من الكَرِّ",61,"ر",1,0],["ويثلج صدرُ الغانيات تفكهاً","بمرأى خوافٍ لا يخفن لها وصما",62,"م",2,0],["ويُثنى على كتفي ذراعكِ ليِّناً","هو العاجُ لولم تجرِ فيه حياة",63,"ه",1,0],["وَيَثرِبُ تَعلَمُ أَنَّ النَبي","تَ راسٍ بِيَثرِبَ ميزانُها",64,"ن",3,0],["وَيُثَبِّتُ اللَهُ التقاةَ إِذا هُمُ","وَرَدوا السُؤالَ بِقَولِ حَقٍّ مُصدرِ",65,"ر",1,0],["ويثلَبُ بيت اللَه بين بيوتكم","وقادرهُ عن ردّ ذاك قعيد",66,"د",1,0],["ويثلج صدري أن أرى اليوم قادة","تكرم أهل العلم والبحث والفكر",67,"ر",1,0],["ويثني همّتي بالمكرِ حتّى","وأيم اللّه فضّلت الخمولا",68,"ل",2,0],["ويثلج نار القلب ما كنت بانيا","من النهج للخلف الرشيد المؤيد",69,"د",1,0],["ويثقل وهو مقيم بفاسٍ","على أمِّه وهي في ينبع",70,"ع",1,0],["ويثمر هذا الكفاح الطويل","سلاما طويلا يكون ختامه",71,"م",2,0],["ويثيب فيهم من اطاع برحمة","ويعاقب العاصي لهم بالنقمة",72,"ه",1,0],["ويَثوِي في الثَرَى نَوءُ الثُرَيَّا","ويُمسِي للثَراءِ بهِ ثواءُ",73,"ا",2,0],["ويُثْنِي على آثارك السَّيفُ والنّدَى","ويُفْضي إلى أفعالك الحمدُ والأَجر",74,"ر",1,0],["ويثير شجوي من عليل نسيمه","سقم أراه اليوم غير مفارقي",75,"ق",2,0],["ويثقله حمل الجناحين بعد ما","أقلاه وهو الكاسر المتقحم",76,"م",1,0],["ويثمر غصنه قمراً منيراً","قليل أن يقال له كمال",77,"ل",1,0],["وَيُثنيكَ خَوفُ الفَقرِ عَن كُلِّ بُغيةٍ","وَخَوفكَ حال الفَقرِ شَيء مِن الفقرِ",78,"ر",1,0],["ويثقل بالحديد الساق ظلماً","ويرجو أن تخف إلى المساعي",79,"ع",2,0],["ويثني الشَّوقَ حينَ أقولُ يخبو","بكاءُ حمامةٍ فيلجُّ حينا",80,"ن",2,1],["ويثور من غاباتكم وأجامكم","ليث سوى هام العدى لم يرتع",81,"ع",1,0],["ويثوى علاك السعد أرخ ببرجه","وتسمو بسامي القدر في كل ثانيه",82,"ن",3,0],["وَيُثيرُ رَونَقَهُ وَيُفزِعُهُ","وَقعٌ مِنَ الثُعبانِ يَسمَعُهُ",83,"ع",2,0],["ويثبِتُ الملك مع الخصالِ","فهذهِ كالدرِّ في المثالِ",84,"ل",1,0],["ويثل عرشهم ويجعل شملهم","ايا كان مشتتا مبتورا",85,"ر",2,0],["ويثمر للعافي ندى كفك الغنى","ويشكر جدوى جودك الحر والعبد",86,"د",1,0],["ويَثْوِي حَزينًا ثَقِيلَ الخُطى","كما يَرجِعُ المَوتُ مِن مَجزَرَةْ",87,"ر",2,0],["ويثبت والهيجاء حام وطيسها","ولما للقنا غير النحور مسالك",88,"ك",1,0],["ويثير مشغوفٍ على الدرع والطاس","دون الحلال ودون حرمة فريقه",89,"ق",2,0],["ويثخنُ في جِراحِكَ كلَّ يومٍ","وهل يصبو لذابحهِ ذبيحُ",90,"ح",1,0],["ويثخن حماة السور دم المعادين","لو فكروا في غلةٍ من غلالي",91,"ل",2,0],["ويثيبك الفردوس حيث المصطفى","والآل والصحب الكرام إزاؤه",92,"ا",3,0],["ويثني على نفسه بالذى","على من سواه به يطعن",93,"ن",1,0],["ويثورُ إبهامي ويغضب خنصري","وتحرض السبابةُ الوسطى: \"ادّعي",94,"ع",2,0],["ويثمرَ في الثرى وهَنا وكبرا","فتعسا للحقول وللبذورِ",95,"ر",1,0],["6- ويثلج صدره الافلاج تطفي","أجيج الشوق إمّا يستحم",96,"م",1,0],["ويثورُ الأطفالُ في القدسِ حتى","تتنزَّى جراحهُم والصَّليلُ؟!!",97,"ل",1,0],["ويَثقلُ في دروب النورِ خَطوي","وفي هذا الدُّجى بَصري حديدُ!",98,"د",1,0],["ويُثيرونَ بيْنَنا نَعَراتٍ","قدْ طَواها الإسْلامُ عِرْقاً وقوْما",99,"م",2,0],["ويثبت المعجز في رؤيته","بالعين أو تواتر مسلم",100,"م",1,0],["ويُثْقِلُ جفْني بِدَمْعاتِهِ","فَمثلي العَمِيُّ بِقلبي يَراهْ",101,"ا",2,0],["ويثلج صدرها غزل لطيف","ويبهجها القضاء على الجيوب",102,"ب",1,0],["ويثمر النبت جميعا وما","من مثمر يوفي على الوافر",103,"ر",1,0],["وَيُثمِرُ الفِكرِ من نور حُسنِها","فَمِنها غِناءُ الرُّوحِ وَالفَنُّ وَالشِّعر",104,"ر",1,0],["وَيُثيرُ الحَنانَ فيهِ غِناءٌ","يا لَروحٍ يَهوى الفُنونَ المُثيرَه",105,"ر",2,0],["ويثوبُ مغترٌّ .. يَصدُّ قرينَهْ","بيقين:ِ (قال اللهُ: قال رسولُ)",106,"ل",1,0],["ويثقلني شوقي لمن أحملُ اسمَه","كما يحملُ التّيجان -يزهو بها- الرأسُ",107,"س",1,0]]}