{"poems":[[53,"ليهنك لبس المهرجان وإن غدا","https://www.aldiwan.net/poem64568.html","الطويل"],[99,"بي نزوع إلى الدموع الهوامي","https://www.aldiwan.net/poem24764.html","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[111,"معاهدة تذكاري سقتك الغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=102",""],[96,"مصرع الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=12923",""],[189,"هذا الفراق وهذه الأظعان","https://www.aldiwan.net/poem14686.html","الكامل"],[202,"هم سرى في أضلعي وسرى بي","https://www.aldiwan.net/poem51978.html","الكامل"],[409,"عذرا على ما جرى مني من الزلل","https://www.aldiwan.net/poem33488.html","البسيط"],[422,"سطا بحسام مقلته وصالا","https://www.aldiwan.net/poem54125.html","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48721","الطويل"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105437","الطويل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88652","الخفيف"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100771","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81296","المنسرح"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83506","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83663","الخفيف"],[585,"إيه دمشق هنا الشهيد الأطهر","https://www.poetsgate.com/ViewPoem.aspx?id=161939",""],[5186,"من مغيثي، من منصفي، من مجيري؟","https://www.poetsgate.com/ViewPoem.aspx?id=156554",""],[5912,"ذكرى الأمس","https://www.poetsgate.com/ViewPoem.aspx?id=202553",""],[6212,"فيفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1620&r=&rc=1",""]],"verses":[["أيهدي إليك الشعرَ بعد سماعِه","بشعرِك إلا غافِلُ القلب ناعسه",0,"س",2,0],["إيه دانتي أأنت ذاك الذي قال","قديماً عن ذكريات الهناءِ",1,"ا",2,0],["إِيهِ دارَ العُلُوم كُنْتِ بِمصْرٍ","في ظَلامِ الدُّجَى ضِيَاءَ الشِّهَاب",2,"ب",1,0],["أيهدم ألف ما بنى الفرد منكم","وكيف بناء الفرد والألف هادم",3,"م",1,0],["إيه دنيا الرّشيد تفنى الحضارات","وتبقى ، كالدهر دنيا الرّشيد",4,"د",1,0],["إيه دنيا الرّشيد تفنى الحضارات","وتبقين من لدات الخلود",4,"د",1,0],["إيهٍ دموعَك إنما سُنَن الهوى","جسم يذوب ومَدْمَعٌ هَتّان",5,"ن",1,0],["إيهٍ دموعَكَ للفضائلِ أقلعتْ","والمجدُ صار إلى حصىً وتراب",6,"ب",1,0],["أيهدم الودَّ ألفاظ مزخرفة","هي الزجاج وذاك الود من جبل",7,"ل",1,0],["أيهديني عن الأَشواق لاحٍ","وما قد زادني إلاَّ ضلالا",8,"ل",2,0],["أيهدأ بالي أو تلين مضاجعي","وإن خطوب الترك أهون ما ألقى",9,"ق",2,0],["أيهدي إلى الشامات رأس ابن فاطم","ليشفي منه ضغنه المتحيف",10,"ف",1,0],["أي هدي يسوقه بالغ الكعبة","لو انَ هديه مقبولا",11,"ل",2,0],["إيه داود إيه يا ابن الكرام","ربَّ قولٍ أحد من صمصام",12,"م",1,1],["أَية دُنيا هاتيك ظَل شَبح","مِن كُل فَن يَحفها فِنَن",13,"ن",1,0],["إيهِ دارَ النَعيم جنّة خلدٍ","ماؤُها السَلسَبيلُ في الأَذواقِ",14,"ق",1,0],["إيه داراً طرقتُها في ظَلام ال","ليل أَبغي قرى أهيل الخِيامِ",15,"م",1,0],["إيه دارَ العَلِيّ وارِث جدٍّ","كانَ عزّاً لملَّة الإِسلامِ",15,"م",1,0],["إيه دمشق هنا الشهيد الأطهر","وعليه من دمه القميص الأحمر",16,"ر",1,1],["أيهدي الأحكام! إن شئت جوري","لا أبالي، سيان، أو لا تجوري",17,"ر",2,0],["أيهدأُ بالجفا قلبٌ","يماكرُ فجرَه السَّحَرُ؟",18,"ر",1,0],["أَيُهَدُّ بيتٌ من حُروفِ قلوبكمْ","شيَّدتُمُ؟ فلبئس بيتٌ شُيِّدا!",19,"د",2,0]]}