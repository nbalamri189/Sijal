""],[4935,"روض السرور أزهرت أغصانه","https://www.poetsgate.com/ViewPoem.aspx?id=129494",""],[4962,"ابتَسِمْ","https://www.poetsgate.com/ViewPoem.aspx?id=201737",""],[4978,"ما أشبه الجدّ في التحليق بالهزلِ","https://www.poetsgate.com/ViewPoem.aspx?id=177194",""],[4978,"من قال كالصيف لم يعرف سجاياك","https://www.poetsgate.com/ViewPoem.aspx?id=180129",""],[4988,"أحفاد الاجداد","https://www.poetsgate.com/ViewPoem.aspx?id=196636",""],[5072,"نجاة الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=52564",""],[5198,"نود الاشعار","https://www.poetsgate.com/ViewPoem.aspx?id=136094",""],[5220,"البارحه","https://www.poetsgate.com/ViewPoem.aspx?id=37049",""],[5277,"مخلب القِط","https://www.poetsgate.com/ViewPoem.aspx?id=197299",""],[5431,"حلب الشهباء","https://www.poetsgate.com/ViewPoem.aspx?id=183039",""],[3294,"خير لون لون البياض وأبهى","https://www.poetsgate.com/ViewPoem.aspx?id=173254",""],[5493,"في شِرعَتِي هذه البلدَان كالحرَم","https://www.poetsgate.com/ViewPoem.aspx?id=196991",""],[5573,"كل ماقلت هانت واحتكمها حكيم","https://www.poetsgate.com/ViewPoem.aspx?id=200089",""],[243,"مفضوحة لم تبق طي خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=50474",""],[5785,"هيّج الشوق قمري في الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=131569",""],[5794,"غرور الشعر ..","https://www.poetsgate.com/ViewPoem.aspx?id=122796",""],[6019,"ما لي أراني","https://www.poetsgate.com/ViewPoem.aspx?id=176718",""],[6106,"سيدتنا الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=6302",""],[6189,"ما تبقى من أحزان الرجال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83551&r=&rc=18",""],[6341,"أسئلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87275&r=&rc=4",""]],"verses":[["ما أَشلَقَ البُردَ فَلَم","بَدَّلَ لي وَجَدَّدا",0,"د",2,0],["مَا أَشْرَفَ الجودَ لا يُبْغَى بِهِ عَوَضٌ","كَمَا تَجُودِينَ عَنْ بُعْدٍ ومن أَمَمِ",1,"م",1,0],["ما أشرف القوم لو كانت مدامعهم","مطافئاً لك تجري الدمع غدرانا",2,"ن",2,0],["ما أشتهي بعدوٍّ","أن يُبتَلَى بِلثامِكْ",3,"ك",1,0],["ما أشبه العرفَ والإحسان بالحَسَنِ","أبي محمدٍ المحمود ذي المِنَنِ",4,"ن",1,1],["ما أَشفَقَت نَفسي عَلَيَّ وَإِنَّما","أَشفَقتُ أَن أَبكي الصَديقَ المُشفِقا",5,"ق",2,0],["ما أَشبَهَتكَ مَواسِمُ الوادي وَلا","أَعيادُهُ في الدَهرِ وَهيَ عِظامُ",6,"م",1,0],["ما أَشَدَّ المَوتَ جِدّاً وَلَكِن","ما وَراءَ المَوتِ حَقّاً أَشَدُّ",7,"د",1,1],["ما أَشَدَّ الحُبَّ يا سُب","حانَكَ اللَهُمَّ رَبّي",8,"ب",2,0],["ما أَشرَفَ العُذرَ لَو أَن الوَغى نثرت","أَشلاءَهم بَينَ مَطعون وَمَضروبِ",9,"ب",1,0],["ما أَشَدَّ اِفتِقارنا لسموّ ال","خلق في هَذِهِ اللَيالي السودِ",10,"د",1,0],["ما أشد الهوى وما أطولَ اللي","ل وما أبعدَ الكرى عن جفوني",11,"ن",2,0],["ما أَشبَهَ الناسَ بِالأَنعامِ ضَمَّهُمُ","إِلى البَسيطَةِ مُصطافٌ وَمُرتَبَعُ",12,"ع",1,0],["ما أشجن الأكواخ في","جنب القصور الشاهقاتِ",13,"ت",1,0],["ما أشبهَ اليومَ بالأمسِ الذي نَسَلوا","فيه على صعَقاتِ الحادثِ الجلَلِ",14,"ل",1,0],["مَا أَشبَهَ الفَاروقَ بِالفارُوقِ مِنْ","مُتَقَدِّمٍ عَهْداً وَمِنْ مُتأَخِّرِ",15,"ر",1,0],["ما اشرقُ الألوان إلا سُودُها","ولأجل ذا لونُ الشبيبة أسفعُ",16,"ع",1,0],["ما أَشرَفَ الأَقوامُ إِذلالاً عَلى","ذي قُدرَةٍ إِلّا جَنَوا إِذلالا",17,"ل",2,0],["ما أشبه الدهر في تلوين صنعته","بمعشر لم أزل منهم أرى عجبا",18,"ب",2,0],["ما أشبه الزنبور في خصره","حتى حكى العقرب في الصدغِ",19,"غ",1,0],["ما أشرف القلم المشرِّفَ أهله","ضخم المَريرة وهو نِضو هُزالِ",20,"ل",1,0],["ما اشرقت زهر النجوم وما علا","بدر الدجى أفلاكه بالمطلع",21,"ع",1,0],["ما أشبهَ الباكي بمُستَضحكٍ","وأشبَهَ الإنسان بالقِردِ",22,"د",1,0],["ما أشبهَ الفتَياتِ بالفِتيانِ يا","فَيحاءَ فيكِ إذا دَعا داعيك",23,"ك",1,0],["ما أَشرَعَ الرُمحَ إِلّا غاصَ ثَعلَبُهُ","يَومَ الوَغى والِغاً في مُهجَةِ البَطَلِ",24,"ل",1,0],["ما أَشرَقَت زُهرُ النُجومِ وَما بَدا","لِمُسافِرٍ وَجهُ الصَباحِ المُسفِرِ",25,"ر",1,0],["ما أَشجى إذْ تشكو البينا","ما أَلهف إذْ ترجو اللقيا",26,"ي",2,0],["ما أشرنا به لزيد ولا عم","رو ولا عينوا لنا تفصيله",27,"ل",2,0],["ما اشأم الدنيا وذكرك حافل","بفواجع الاشلاء والاسلاب",28,"ب",1,0],["ما أشبَهَ البُخَلاءَ بالفُقَراءِ في","ذلِّ اعتِذارِهمُ وطُولِ عَنايهِ",29,"ا",3,0],["ما أشرقَت بوَقودها إلا وفي","أحشاءِ كلبِ الروم منه وقودُ",30,"د",1,0],["ما أشرقت بعقولهم أسرارهم","إلّا وأمست في المشارق تغرب",31,"ب",1,0],["ما أشبَهُوني فعادُوني لنَقصِهِمُ","وليسَ يشبهُ تِبراً خالِصاً شَبَهُ",32,"ه",1,0],["ما أشعرُ الشُعراءِ إلا مادحٌ","طرزتَ باسمِكَ طُرّتَيْ ديوانِه",33,"ن",2,0],["مَا أشبَهَ الشّبلَ بِالضِّرغَامَةِ الدَّرِبِ","لا مَن سِوَاهُ وَليسَ الإسم كَاللَّقَبِ",34,"ب",1,1],["ما أشرفت من هضاب المجد منزلة","إلا تعالوا على هاماتها شرفا",35,"ف",2,0],["مَا أُشْرِعَتْ فِي النَّاكِثِينَ رِماحُهُمْ","إِلّا وبابُ النَّصْرِ منها شارِعُ",36,"ع",1,0],["ما أشوقني ولم أزل مقتربا","ما زادني الدنو الا طلبا",37,"ب",2,1],["ما أشوقني لجيرةٍ بالرملِ","ما أسرعَ ما شُتِّتَ فيهم شملي",38,"ي",1,1],["ما أشبه الناسَ بالزمان وما","أقلَّ فَرقاً بالغدر بينهمُ",39,"م",1,0],["ما أشرفَ الحلمَ لولا ثِقلُ محمِلِهِ","وأجملَ الصمتَ لولا قولهم حَصَرُ",40,"ر",1,0],["ما أشكلَتْ يومَ الجِدال قضيَّةٌ","إلاَّ وبَدَّلَ شكَّها بيَقينِ",41,"ن",1,0],["ما أَشتَهي غَيرَ أَلّا","يَنالُ ما يَشتَهيهِ",42,"ي",2,0],["ما اشتكى القريض به","علّة ولا نصبا",43,"ب",2,0],["ما اشتكى به أحد","شقة ولا وصبا",43,"ب",2,0],["ما أشبه المال بالأكمام في غصن","أيان ينفق عن الأزهار ينفتق",44,"ق",1,0],["ما اِشْتاقَ سمْعي ذِكرَ منزلِ طَيْبةٍ","إلّا وهِمْتُ بِساكِني ودْيانهِ",45,"ن",2,0],["ما أشغلَتْهُ طاعةٌ عن طاعةٍ","فصلاتُه مشفوعةٌ بصِلاتِهِ",46,"ت",2,0],["ما أشرَفَ العِلمَ في الدُّنيا وأجمَلَهُ","فذاكَ خيرٌ مِن الأملاكِ والخَوَلِ",47,"ل",1,0],["ما أَشْرَقَ المَجْدُ من قبورِهِمْ","إلا وسُكَّانُها مصابِحُهْ",48,"ح",2,0],["ما أَشْوق المهجورَ مِنِّي إِلى","قَتْلِي وَلكن بيدَ الْهَاجِر",49,"ر",1,0],["ما أَشْرَقُوا في ذُكاء مَعْرِفَةٍ","إلّا ذَكَا مِنْ ذُكائِهم غُرُبُ",50,"ب",1,0],["ما أشرك فيك القلب فلم","في نار الهجر تخلده",51,"د",2,0],["ما أشبَهَ الرّاحَ بالرّاحِ الشَّهيَّةِ مِن","فيهِ واشبَهَ أنفاساً بأنفاس",52,"س",1,0],["ما أَشرقت شَمس المَناصب بامرئٍ","مِن دُونه في الحلم يذكر أَحنف",53,"ف",1,0],["ما أَشرَقَت في مَصر طَلعتها الَّتي","تَزهو بِطالعه المُنيف الأَسعَد",54,"د",1,0],["ما اِشتاقَ يَوماً لِنَفح الطَيب ذو أَدب","أَجرى مَذاكيه في مضماره وَعدا",55,"د",2,0],["ما أَشرَقت شَمسُ نظمٍ في سَما أَدَبٍ","أَو أَزهَرَت في بُروج النَثر أَقمار",56,"ر",1,0],["ما أَشرَقَت إِستانةٌ بِزيارة","صَدرت بإِخلاص وَحُسن طَوية",57,"ه",1,0],["ما أَشتكي دهم أَيامي لِغَير فَتىً","وَلَّيتُهُ صدقَ أَحوالي وَأَطواري",58,"ر",2,0],["ما أَشرقت شَمس هَذا الشبل وَاِرتَفَعَت","في ثالث الحجة المحمودة الغبّ",59,"ب",1,0],["ما أَشرَقَت مَصر بِنَظم مَواكب","تَسعى إِلى جَبر الخَليج الناصري",60,"ر",2,0],["ما اشتاقَ قطُّ إلى مناهُ أخو منى","إلا وأنت إلى مناهُ اشوق",61,"ق",1,0],["ما اِشتَدَّ جورُ سُيوفِهِ في مَعركٍ","إِلّا وَمِنهُ قَد تَبدّى الأحنفُ",62,"ف",1,0],["ما أشرَفَ الحُزنَ إنْ كانتْ بَوَاعِثُهُ","هُوْجَاً تصَلبَ مِنهَا جِذعِيَ الصَّلبُ",63,"ب",1,0],["ما اشْتُرِطَتْ طاعَتُهُمْ بِالطّاعَهْ","لِكُلِّهِمْ لِتَحْصَلَ الشَّفاعَهْ",64,"ه",1,0],["ما اشتدّ في الأيام مبرم حادث","إلا وكان بحله وافي الهممْ",65,"م",1,0],["ما أشرقت شمسٌ وما بدرٌ بدا","ليلاً ولالى فرقدٌ وثريَّا",66,"ي",2,0],["ما أشرقت شمس الضحى وتغاربت","واضا النهار ولاح مطلع فجره",67,"ر",2,0],["ما أشرقت شمسٌ وضاءت انجمٌ","وشدا هزارٌ في الرياض غرودُ",68,"د",1,0],["ما اشتغالي عن السوى بشهودي","لك الا من سر معنى وجودي",69,"د",2,1],["ما أشرق البدرُ له إذ بدا","إلا ووجه البدرِ وجهٌ وقاح",70,"ح",1,0],["ما اشبه الطير منها بالظليم بما","نلقاه جمع في الاحشاء نيرانا",71,"ن",2,0],["ما أَشهد الهَوى عَلى مستهام","قلق القَلب في المحبة قالي",72,"ل",2,0],["ما أَشرف العشق ان آثرت عزّتَهُ","يسمو لحرٍ بمحض العشق طالعُهُ",73,"ه",1,0],["ما أشرف العشق في نفس يجمِّلها","وما أَذلَّهُ في الأَعضاء ينحصرُ",74,"ر",1,1],["ما أشبه ألماها الزهري","بشقيقٍ لاح على نهر",75,"ر",1,1],["ما أشبه الدنيا ببارقةٍ","وعليٌّ ابن العظم بالحد",76,"د",1,0],["ما اِشتَدَ بِي زَمَنِي وَلا ضاقَت يَدي","إِلّا وَوَسَّعَها أَبُو العُلوانِ",77,"ن",1,0],["ما أشاء السلو عن","ك فإن شئت شيته",78,"ت",2,0],["ما أشرف العبد الذي","لكل شيء قد وضع",79,"ع",1,0],["ما أَشرَقَت شَمس عَلى ذي نَجدة","إلا رَأَته لِبأسِكُم مُنقادا",80,"د",2,0],["ما أَشارَت أَنامل الركب إِلّا","لِمحل اللواء عَبد اللَطيف",81,"ف",1,0],["ما اشتَمَلت عَيِني عَلى رَقدَةٍ","مُذ غِبتِ عن عَيني الى النَومِ",82,"م",1,0],["ما أشق الحياة ما أتعب العيش","وأضناه للأديب اليماني",83,"ن",2,0],["ما أشاع المخلصان","من أفانين الدعاية",84,"ه",1,0],["ما أشغل الفكر عن رد السلام سوى","ما كان من سابق الإعراض والتيه",85,"ه",1,1],["ما اشتَكي البعد لَو أَني بُليتُ بِهِ","لم احيَ حتىّ تَراني شاكياً شاني",86,"ن",2,0],["ما اِشتَهيتُ المُتَمَنّي قطُّ الّا","حَرِجَت بي في تَسَنيِّهِ الجِهاتُ",87,"ت",1,0],["ما أشرق الصبح إلا وهي راسية","كأنها ليلة الإسراء لم تثب",88,"ب",1,0],["ما اشتدَّتِ النِيرانُ بال","إِحراقِ الَّا من ذَكائِك",89,"ك",1,0],["ما اشتد عسر، ولا انسدَّت مذاهبه","إلا تفتّح من مسروره بابُ",90,"ب",1,0],["مَا اشتَدَّ أمرٌ لَنَا إِلاَّ وكَانَ لَهُ","هَونٌ بِلُطفِكَ لَم يَلحَقهُ إعسَارُ",91,"ر",1,0],["ما اشتمل الفجر بثوب الجساد","من يمه يبرز فوق البلاد",92,"د",1,1],["ما اِشتاقَ بادٍ إِلى اِستِنشاقِه أَرجاً","مِنَ الخُزامى وَعُرفِ الشيح وَالنَقل",93,"ل",1,0],["ما اِشتاقَ وَلهانٌ إِلى قُربِكُم","فَعَلَّلَ النَفسَ بِما قَد كَتَب",94,"ب",1,0],["ما اشوس إلا وعاث به","من سهم فاتر لحظه الكحل",95,"ل",1,0],["ما أشرعوا الأرماح إلا أشرقو","ها من دم الأقران في الهيجاء",96,"ا",2,0],["ما أشرقت إلا ومنك منيرها","بدر سما بسمائه عن سوم",97,"م",1,0],["ما أشرنا إلى قرين سواه","حين حيا بالحاجب المقرون",98,"ن",1,0],["ما اشَتهوا من كل صنف حسنِ","كان في البيت فتىً فذُّ الخصالْ",99,"ل",1,0],["ما أَشقَى العاقِلَ في وَطَنٍ","أَعقَلُ مَن فِيهِ الغَيبُوبة",100,"ب",2,0],["ما أشرق البدر في جنح الظلام وما","قال المؤرخ ريحان العذار بدا",101,"د",2,0],["ما اشوف غير اللي مَلَت عينه احزان","كنك تقولي حالتك مو بحاله",102,"ل",2,0],["مَا أَشبَهَ الحَالَ مِنْ (عَادٍ )لَنَا مَثَلًا","بِعَارِض ٍ ذِيْ عَذَاب ٍ مَالَهُ حَدّْ",103,"د",1,0],["ما أشرقت انوار مدح جنابه","أو دام ركناً للضعيف ومنجدا",104,"د",2,0],["ما أشرقت منها معانيها لنا","إلا بفضل منك يا عالي المقال",105,"ل",1,0],["ما اشرقت شمس معاليك وما","أخوك راق بالهدى بيانه",106,"ن",2,0],["ما اشتد ظرفٌ عشته","حتى وإن أبكاك دمْ",107,"م",1,0],["ما أشبه الجدّ في التحليق بالهزلِ","وأجدرَ القوم لو أنصفت