{"poems":[[53,"يا قلب جدد كمدا","https://www.aldiwan.net/poem30611.html","مجزوء الرجز"],[93,"يا مصر لو تقدر الأقدار بالكرم","https://www.aldiwan.net/poem11289.html","البسيط"],[88,"أصبحت أعذل نوابا وأعيانا","https://www.aldiwan.net/poem44391.html","البسيط"],[51,"تكلمي في كمامك","https://www.aldiwan.net/poem65762.html","المجتث"],[51,"ما أشبه العرف والإحسان بالحسنِ","https://www.aldiwan.net/poem66441.html","البسيط"],[91,"إني سكت وما عدمت المنطقا","https://www.aldiwan.net/poem9046.html","عموديه"],[85,"تاج البلاد تحية وسلام","https://www.aldiwan.net/poem8106.html","الكامل"],[49,"ما أشد الموت جدا ولكن","https://www.aldiwan.net/poem62057.html","المنسرح"],[49,"آه من غمي وكربي","https://www.aldiwan.net/poem63231.html","مجزوء الرمل"],[102,"سل جنة الشعر ما ألوى بدوحتها","https://www.aldiwan.net/poem32925.html","البسيط"],[102,"أيها الموت أي مجلس أنس","https://www.aldiwan.net/poem32933.html","الخفيف"],[102,"أسعديني بزورة أو عديني","https://www.aldiwan.net/poem33118.html","الخفيف"],[46,"حيران أنت فأي الناس تتبع","https://www.aldiwan.net/poem22940.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85372","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39593","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54855","الكامل"],[142,"قد بان عذرك والخليط مودع","https://www.aldiwan.net/poem58436.html","الكامل"],[143,"النجم أقرب من مداك منالا","https://www.aldiwan.net/poem11792.html","الكامل"],[160,"ما فته حظه من أجل الطلبا","https://www.aldiwan.net/poem59115.html","البسيط"],[204,"وشادن بالكرخ ذي لثغة","https://www.aldiwan.net/poem53030.html","السريع"],[204,"إقبالهن بشارة الإقبال","https://www.aldiwan.net/poem53188.html","الكامل"],[261,"وان طيفا منك عاود مضجعي","https://www.aldiwan.net/poem38243.html","الكامل"],[270,"يا شارب الراح على ورد","https://www.aldiwan.net/poem35292.html","السريع"],[270,"أدمشق ما أمضى سيوف بنيك","https://www.aldiwan.net/poem35644.html","الكامل"],[282,"دع النسيب وقول اللهو والغزل","https://www.aldiwan.net/poem32673.html","البسيط"],[282,"بي غادة سمراء مثل الأسمر","https://www.aldiwan.net/poem32788.html","الكامل"],[298,"لله وللمثل الأعلى","https://www.aldiwan.net/poem36299.html","عموديه"],[310,"سيدي والظنون فيك جميلة","https://www.aldiwan.net/poem59510.html","الخفيف"],[342,"يوم الهوان وصيحة المرتاب","https://www.aldiwan.net/poem55365.html","الكامل"],[371,"أبلغ رجاء بن المطهر أنني","https://www.aldiwan.net/poem56961.html","الخفيف"],[371,"بركات مولانا عليك تعود","https://www.aldiwan.net/poem57476.html","الكامل"],[377,"سر عجيب فيه معنى أعجب","https://www.aldiwan.net/poem66932.html","الكامل"],[405,"لما رأوني فريدا حلس زاوية","https://www.aldiwan.net/poem49669.html","البسيط"],[432,"عزت ضمائره على كتمانه","https://www.aldiwan.net/poem12747.html","الكامل"],[434,"ما أشبه الشبل بالضرغامة الدرب","https://www.aldiwan.net/poem25672.html","البسيط"],[437,"لولا تذكر عهد بالحمى سلفا","https://www.aldiwan.net/poem2503.html","البسيط"],[439,"نور الوفاء بأرضنا لك ساطع","https://www.aldiwan.net/poem34838.html","الكامل"],[448,"ما أشوقني ولم أزل مقتربا","https://www.aldiwan.net/poem53804.html","الدوبيت"],[448,"ما أشوقني لجيرة بالرملِ","https://www.aldiwan.net/poem53810.html","الدوبيت"],[458,"انظر معي فهي نظرة أمم","https://www.aldiwan.net/poem55899.html","المنسرح"],[458,"هل عند ريح الصبا من رامة خبر","https://www.aldiwan.net/poem56197.html","البسيط"],[461,"قوم إذا أخذ المديح قصائدا","https://www.aldiwan.net/poem16447.html","الكامل"],[468,"خيرون مثل أبيه","https://www.aldiwan.net/poem59527.html","المجتث"],[479,"هبت الصبا فصبا","https://www.aldiwan.net/poem37058.html","المقتضب"],[479,"الذكر أبقى لكم والمال عارية","https://www.aldiwan.net/poem37207.html","البسيط"],[514,"هذا العقيق وتلك شم رعانه","https://www.aldiwan.net/poem20784.html","الكامل"],[514,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[562,"عليك بالعلم فاطلبه بلا كسل","https://www.aldiwan.net/poem52715.html","البسيط"],[567,"أجل هو الرزء جل فادحه","https://www.aldiwan.net/poem69740.html","مجزوء البسيط"],[575,"لهفي من العاذل والعاذر","https://www.aldiwan.net/poem3072.html","السريع"],[586,"أضحى له في اكتئابه سبب","https://www.aldiwan.net/poem17411.html","المنسرح"]],"verses":[["ما أَشلَقَ البُردَ فَلَم","بَدَّلَ لي وَجَدَّدا",0,"د",2,0],["مَا أَشْرَفَ الجودَ لا يُبْغَى بِهِ عَوَضٌ","كَمَا تَجُودِينَ عَنْ بُعْدٍ ومن أَمَمِ",1,"م",1,0],["ما أشرف القوم لو كانت مدامعهم","مطافئاً لك تجري الدمع غدرانا",2,"ن",2,0],["ما أشتهي بعدوٍّ","أن يُبتَلَى بِلثامِكْ",3,"ك",1,0],["ما أشبه العرفَ والإحسان بالحَسَنِ","أبي محمدٍ المحمود ذي المِنَنِ",4,"ن",1,1],["ما أَشفَقَت نَفسي عَلَيَّ وَإِنَّما","أَشفَقتُ أَن أَبكي الصَديقَ المُشفِقا",5,"ق",2,0],["ما أَشبَهَتكَ مَواسِمُ الوادي وَلا","أَعيادُهُ في الدَهرِ وَهيَ عِظامُ",6,"م",1,0],["ما أَشَدَّ المَوتَ جِدّاً وَلَكِن","ما وَراءَ المَوتِ حَقّاً أَشَدُّ",7,"د",1,1],["ما أَشَدَّ الحُبَّ يا سُب","حانَكَ اللَهُمَّ رَبّي",8,"ب",2,0],["ما أَشرَفَ العُذرَ لَو أَن الوَغى نثرت","أَشلاءَهم بَينَ مَطعون وَمَضروبِ",9,"ب",1,0],["ما أَشَدَّ اِفتِقارنا لسموّ ال","خلق في هَذِهِ اللَيالي السودِ",10,"د",1,0],["ما أشد الهوى وما أطولَ اللي","ل وما أبعدَ الكرى عن جفوني",11,"ي",1,0],["ما أَشبَهَ الناسَ بِالأَنعامِ ضَمَّهُمُ","إِلى البَسيطَةِ مُصطافٌ وَمُرتَبَعُ",12,"ع",1,0],["ما أشجن الأكواخ في","جنب القصور الشاهقاتِ",13,"ت",1,0],["ما أشبهَ اليومَ بالأمسِ الذي نَسَلوا","فيه على صعَقاتِ الحادثِ الجلَلِ",14,"ل",1,0],["مَا أَشبَهَ الفَاروقَ بِالفارُوقِ مِنْ","مُتَقَدِّمٍ عَهْداً وَمِنْ مُتأَخِّرِ",15,"ر",1,0],["ما اشرقُ الألوان إلا سُودُها","ولأجل ذا لونُ الشبيبة أسفعُ",16,"ع",1,0],["ما أَشرَفَ الأَقوامُ إِذلالاً عَلى","ذي قُدرَةٍ إِلّا جَنَوا إِذلالا",17,"ل",2,0],["ما أشبه الدهر في تلوين صنعته","بمعشر لم أزل منهم أرى عجبا",18,"ب",2,0],["ما أشبه الزنبور في خصره","حتى حكى العقرب في الصدغِ",19,"غ",1,0],["ما أشرف القلم المشرِّفَ أهله","ضخم المَريرة وهو نِضو هُزالِ",20,"ل",1,0],["ما اشرقت زهر النجوم وما علا","بدر الدجى أفلاكه بالمطلع",21,"ع",1,0],["ما أشبهَ الباكي بمُستَضحكٍ","وأشبَهَ الإنسان بالقِردِ",22,"د",1,0],["ما أشبهَ الفتَياتِ بالفِتيانِ يا","فَيحاءَ فيكِ إذا دَعا داعيك",23,"ك",1,0],["ما أَشرَعَ الرُمحَ إِلّا غاصَ ثَعلَبُهُ","يَومَ الوَغى والِغاً في مُهجَةِ البَطَلِ",24,"ل",1,0],["ما أَشرَقَت زُهرُ النُجومِ وَما بَدا","لِمُسافِرٍ وَجهُ الصَباحِ المُسفِرِ",25,"ر",1,0],["ما أَشجى إذْ تشكو البينا","ما أَلهف إذْ ترجو اللقيا",26,"ي",2,0],["ما أشرنا به لزيد ولا عم","رو ولا عينوا لنا تفصيله",27,"ل",2,0],["ما اشأم الدنيا وذكرك حافل","بفواجع الاشلاء والاسلاب",28,"ب",1,0],["ما أشبَهَ البُخَلاءَ بالفُقَراءِ في","ذلِّ اعتِذارِهمُ وطُولِ عَنايهِ",29,"ا",3,0],["ما أشرقَت بوَقودها إلا وفي","أحشاءِ كلبِ الروم منه وقودُ",30,"د",1,0],["ما أشرقت بعقولهم أسرارهم","إلّا وأمست في المشارق تغرب",31,"ب",1,0],["ما أشبَهُوني فعادُوني لنَقصِهِمُ","وليسَ يشبهُ تِبراً خالِصاً شَبَهُ",32,"ه",1,0],["ما أشعرُ الشُعراءِ إلا مادحٌ","طرزتَ باسمِكَ طُرّتَيْ ديوانِه",33,"ن",2,0],["مَا أشبَهَ الشّبلَ بِالضِّرغَامَةِ الدَّرِبِ","لا مَن سِوَاهُ وَليسَ الإسم كَاللَّقَبِ",34,"ب",1,1],["ما أشرفت من هضاب المجد منزلة","إلا تعالوا على هاماتها شرفا",35,"ف",2,0],["مَا أُشْرِعَتْ فِي النَّاكِثِينَ رِماحُهُمْ","إِلّا وبابُ النَّصْرِ منها شارِعُ",36,"ع",1,0],["ما أشوقني ولم أزل مقتربا","ما زادني الدنو الا طلبا",37,"ب",2,1],["ما أشوقني لجيرةٍ بالرملِ","ما أسرعَ ما شُتِّتَ فيهم شملي",38,"ي",1,1],["ما أشبه الناسَ بالزمان وما","أقلَّ فَرقاً بالغدر بينهمُ",39,"م",1,0],["ما أشرفَ الحلمَ لولا ثِقلُ محمِلِهِ","وأجملَ الصمتَ لولا قولهم حَصَرُ",40,"ر",1,0],["ما أشكلَتْ يومَ الجِدال قضيَّةٌ","إلاَّ وبَدَّلَ شكَّها بيَقينِ",41,"ن",1,0],["ما أَشتَهي غَيرَ أَلّا","يَنالُ ما يَشتَهيهِ",42,"ي",2,0],["ما اشتكى القريض به","علّة ولا نصبا",43,"ب",2,0],["ما اشتكى به أحد","شقة ولا وصبا",43,"ب",2,0],["ما أشبه المال بالأكمام في غصن","أيان ينفق عن الأزهار ينفتق",44,"ق",1,0],["ما اِشْتاقَ سمْعي ذِكرَ منزلِ طَيْبةٍ","إلّا وهِمْتُ بِساكِني ودْيانهِ",45,"ن",2,0],["ما أشغلَتْهُ طاعةٌ عن طاعةٍ","فصلاتُه مشفوعةٌ بصِلاتِهِ",46,"ت",2,0],["ما أشرَفَ العِلمَ في الدُّنيا وأجمَلَهُ","فذاكَ خيرٌ مِن الأملاكِ والخَوَلِ",47,"ل",1,0],["ما أَشْرَقَ المَجْدُ من قبورِهِمْ","إلا وسُكَّانُها مصابِحُهْ",48,"ح",2,0],["ما أَشْوق المهجورَ مِنِّي إِلى","قَتْلِي وَلكن بيدَ الْهَاجِر",49,"ر",1,0],["ما أَشْرَقُوا في ذُكاء مَعْرِفَةٍ","إلّا ذَكَا مِنْ ذُكائِهم غُرُبُ",50,"ب",1,0]]}