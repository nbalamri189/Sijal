,[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/198878","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69320","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27849","الكامل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104682","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54414","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136468",""],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58138","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120469","الوافر"],[4767,"سيف الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=215269",""],[1012,"السيل العرمرم","https://www.poetsgate.com/ViewPoem.aspx?id=186328",""],[4929,"رمال الثلج","https://www.poetsgate.com/ViewPoem.aspx?id=199317",""],[4119,"دار تغار الشمس في أفقها","https://www.poetsgate.com/ViewPoem.aspx?id=16143",""],[5080,"سعي الظمائر","https://www.poetsgate.com/ViewPoem.aspx?id=185455",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[223,"عابرة","https://www.poetsgate.com/ViewPoem.aspx?id=181152",""],[5703,"لمن أشكو","https://www.poetsgate.com/ViewPoem.aspx?id=207240",""],[6142,"يا مفعم البئر في بدر أشاوسة","https://www.poetsgate.com/ViewPoem.aspx?id=155712",""],[6277,"وحادث غدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64466&r=&rc=29",""]],"verses":[["لِسَيفِ الدَولَةِ العَرَبيِّ فيها","صَنيعُ القَينِ قامَ عَلى النِصالِ",0,"ل",1,0],["لس يجد أعظم شمنا","من مجي ذات الكريما",1,"م",2,0],["لِسَيفِ الدَولَةِ القِدحُ المُعَلّى","إِذا اِستَبَقَ المُلوكُ إِلى القِداحِ",2,"ح",1,0],["لِسَيِّئٍ مِنهُ نُصبَ مُقلَتِهِ","وَما بَعيدٌ عَن لَحظِها حَسَنُه",3,"ن",2,0],["لَسَيري في الفَلا وَاللَيلُ داجٍ","وَكَرّي في الوَغى وَالنَقعُ داجِن",4,"ن",1,1],["لسيِّدِ النيل وفاروقهِ","رفعتُها في موكبِ الخالدينْ",5,"ن",1,0],["لِسَيِّىءٍ مِنْهُ نُصْبَ مُقْلَتِهِ","ومَا بَعِيدٌ عَنْ لَحْظِهَا حَسَنُهْ",6,"ن",2,0],["لسيَّارةِ المعروف في صُلبِ مالِهِ","غنائمُ لم تُقسم عليها بأخماسِ",7,"س",1,0],["لسيفِ الأفضلِ ارْتعَب المنايا","وقد أودى بها الخوفُ المُمِض",8,"ض",1,0],["لسيادةٍ وقيادةٍ وهدايةٍ","قومي فقَومي السادةُ القدماء",9,"ا",2,0],["لسيدنا الهادي الشفيع محمد","حميد المساعي كلها والمآثر",10,"ر",1,0],["لَسَيرُ الناعِجاتِ أَظُنُّ أَشفى","لِما بي مِن طَبيبِ بَني الذَهوبِ",11,"ب",1,0],["لسيفٍ لا تَقِي حَدَّاهُ نَفْساً","تَرَاءى من وراءِ الصَّفْحَتَيْنِ",12,"ن",1,0],["لسيفِ مِقْولهِ في كلِّ مجْلبةٍ","غمدٌ من الحزم أو غمدٌ من الكَرم",13,"م",1,0],["لسيفِ سُلطانِ مصرٍ هَيبةٌ لقِيَ ال","بلادَ حيٌّ بها يا سَيفَ غازيها",14,"ي",3,0],["لسيّد من لهُ مِن هاشم نسب","أكرِم بآلِ رسول اللّه من آلِ",15,"ل",1,0],["لسيان من بعده مونثٌ","ومن بذكورتها تطفح",16,"ح",1,0],["لسيفِ الدولة السيفُ الذي لل","منايا في غِرَارَيْهِ زئير",17,"ر",1,0],["لسيدنا الإمام أبي المطهر","فضائل أربعٌ كالزهر تزهر",18,"ر",1,1],["لسيّد سادات العَتيك وحزبه","وافعالَه الازْدُ اكتَستِ وتَجَلّتِ",19,"ت",1,0],["لِسَيِّدِنَا ذلّ الزّمانُ وَأَذعَنَا","وكلُّ بعيدٍ عِندَ عَزمتِهِ دَنَا",20,"ن",2,0],["\"لسيفه المرهف\" يوم الوغى","\"أضحى الحمام كالحميم\" الموال",21,"ل",1,0],["لسيفِك والنارِ العدى ونفوسُهم","وملكِك والجيشِ المنازلُ والنفل",22,"ل",1,0],["لِسَيفِكَ دانَتِ الدُنيا وَشُدَّت","عُرى الإِسلامِ مِن بَعدِ اِنفِصامِ",23,"م",1,0],["لسيدها والعشر إن كان ميتاً","يقوم في أثمانها حين تبخلُ",24,"ل",1,0],["لسيد الأم يعطيه ويأخذهم","والأم للسيد المسلوب إذ سلبا",25,"ب",2,0],["لسيد سادات النبيين أحمد","له كان في نور الحجاب نزول",26,"ل",1,0],["لِسَيفكَ بَعدَ اللَهِ قَد وَجَبَ الحَمدُ","فَيا لَيتَ جَفني ما حَييتُ لَهُ غِمدُ",27,"د",1,1],["لسيوفهم قام الهدى وعلتْ بهم","أنواره في رأس كلِّ منارِ",28,"ر",1,0],["لسيفه أيقنت شمٌّ جحاجحةٌ","باللِه رَبّاً فما العز وما اللات",29,"ت",1,0],["لسَيْبٍ وسيفٍ كَفُّهُ حالتي ندىً","وبأْسٍ فما تخلو من البسط والقبضِ",30,"ض",1,0],["لسيف مظفر الدين إشمخرت","فحاذر أن يصافحها الأثير",31,"ر",1,0],["لسيدةٍ من آل قحطان غودرتْ","ببطنِ الثرى مثوى العظام الرمائِمِ",32,"م",1,0],["لسيدنا العزيز نجيد مدحا","وتهنئة بعيد الفطر تهدى",33,"د",2,0],["لسيفِ عينيكِ في الأحشاءِ إيلام","وللهوى فيكِ قانونٌ وأحكامُ",34,"م",1,1],["لسيل مجتاحا لمكة طالبا","فطهرها واجتاج منها الأباطيلا",35,"ل",2,1],["لَسَيْرٌِ في رمالِ الثلج حافِ","وبَوحٌ عن مَرايَا الحرفِ خافِ",36,"ف",1,1],["لسيفه الباتر من دهره الجائر","ما يهوى ويختار",37,"ر",1,0],["لسيناءَ الضمائر ِ كنتُ اسعى","وقبلَ منازلِ الرؤيا صُعِقتُ",38,"ت",1,0],["لسيده بالإذن أو كان غازياً","لأجل جهاد المارقين أولى الجحد",39,"د",1,0],["لسيدةٍ من شمالِ الشمالْ","يقولُ لها القلبُ ما لا يُقالْ",40,"ل",1,1],["لسيدةٍ لم تكنْ، إنما","سيخلقُها في الخيالِ الخيالْ",40,"ل",1,0],["لسيفِ الهجرِ يا أسَفي وَناري","جَعلْتَ فُؤادَ مَنْ تهواكَ غِمْدا",41,"د",2,0],["لسيفك النصف يعزى من ذبائحها","وللملائك والأنصار باقيها",42,"ي",3,0],["لسيف عراثي صقيل أجاده","فتسمع ما يرضيك والصدق واجبه",43,"ب",2,0]]}