{"poems":[[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[88,"أي رجال الدنيا الجديدة مهلاً","https://www.aldiwan.net/poem10706.html","الخفيف"],[53,"أشد بأيامنا لتشهرها","https://www.aldiwan.net/poem64036.html","المنسرح"],[53,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[91,"فقدت مصر فهي سكرى المآقي","https://www.aldiwan.net/poem44745.html","الخفيف"],[47,"أأراك الحبيب خاطر وهم","https://www.aldiwan.net/poem65655.html","الخفيف"],[68,"وغزال غازلته بعد بين","https://www.aldiwan.net/poem39511.html","الكامل"],[99,"ها هنا حفل وذكرى ووفاء","https://www.aldiwan.net/poem24983.html","الرمل"],[104,"هادئ القلب مطبق الأجفان","https://www.aldiwan.net/poem33126.html","الخفيف"],[42,"من لنفس عن الهوى لا تناهى","https://www.aldiwan.net/poem42329.html","الخفيف"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[54,"رأيت فيها برقها لما وثب","https://www.aldiwan.net/poem27297.html","الرجز"],[50,"نفر النوم واحتمى","https://www.aldiwan.net/poem65232.html","مجزوء الخفيف"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54734","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43827","الخفيف"],[147,"لا تجز في الذي بلغت الأنام","https://www.aldiwan.net/poem11812.html","الخفيف"],[189,"يا خليلي الهوى برح بي","https://www.aldiwan.net/poem14115.html","الرمل"],[226,"جاء للقصر يخطر","https://www.aldiwan.net/poem55281.html","مجزوء الخفيف"],[259,"اُعف عني","https://www.aldiwan.net/poem24945.html","مجزوء الرمل"],[333,"هتف البحر بالعذارى فلبين","https://www.aldiwan.net/poem54984.html","الخفيف"],[333,"رن في مسمعي نداء الحبيب","https://www.aldiwan.net/poem55028.html","الخفيف"],[366,"أيها السيد الشريف أتانا","https://www.aldiwan.net/poem68138.html","الخفيف"],[385,"زجر الرعد مثقلات الغمام","https://www.aldiwan.net/poem48762.html","الخفيف"],[409,"هات واسق الذهن من خمر العلوم","https://www.aldiwan.net/poem33343.html","مجزوء الرمل"],[438,"قد عصينا النهى فكيف النهاتا","https://www.aldiwan.net/poem12429.html","الخفيف"],[449,"بعد خلق الأكوان خلقا بديعا","https://www.aldiwan.net/poem56043.html","الخفيف"],[458,"سألوني لم ارتحلت كأني","https://www.aldiwan.net/poem61618.html","الخفيف"],[505,"دع وهم أهل الوحدة المطلقه","https://www.aldiwan.net/poem37935.html","السريع"],[563,"نفخ روح بالعز صار ذليلا","https://www.aldiwan.net/poem34209.html","الخفيف"],[692,"","https://poetry.dctabudhabi.ae/diwan/poem/203770","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71005","السريع"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70841","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70769","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62460","الرمل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17086","الخفيف"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101977","الرمل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55886","الرمل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46526","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21662","المديد"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80006","الخفيف"],[1789,"","https://poetry.dctabudhabi.ae/diwan/poem/122403","الخفيف"],[1883,"","https://poetry.dctabudhabi.ae/diwan/poem/98012","الخفيف"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52117","الخفيف"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109455","الرجز"],[2308,"","https://poetry.dctabudhabi.ae/diwan/poem/138926",""],[2448,"","https://poetry.dctabudhabi.ae/diwan/poem/33021","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87326","الرجز"],[563,"","https://poetry.dctabudhabi.ae/diwan/poem/68437","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93988","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93868","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94321","الرجز"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205853","الخفيف"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104671","الرمل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109841","الرجز"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74279","الخفيف"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105622","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62923","الرمل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110063","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110050","الخفيف"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118774","الرجز"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117923","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85012","المديد"],[3793,"","https://poetry.dctabudhabi.ae/diwan/poem/124786","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125871","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86359","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86351","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86353","الرمل"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93759","الرمل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83528","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52137","الخفيف"],[5136,"يا بروحي المدلل البتاه","https://www.poetsgate.com/ViewPoem.aspx?id=121772",""],[5409,"هكذا من حقه من نام ضاعا","https://www.poetsgate.com/ViewPoem.aspx?id=155288",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5818,"اطرقِ الأبواب","https://www.poetsgate.com/ViewPoem.aspx?id=196542",""],[5956,"أقصوصة أنثى سُحاقية","https://www.poetsgate.com/ViewPoem.aspx?id=182690",""],[6084,"يا نسيم الشمال بلغ سلامي","https://www.poetsgate.com/ViewPoem.aspx?id=170857",""]],"verses":[["ثُمَّ حُجراً أَعني اِبنَ أُمِّ قَطَامٍ","وَلَهُ فَارِسِيَّةٌ خَضراءُ",0,"ا",2,0],["ثُمَّ حاوَلتُمُ الكَلامَ مَعَ النَج","مِ فَحَمَّلتُمُ الشُعاعَ مَقالا",1,"ل",2,0],["ثم حدا نطقَها بفطنته","فساقها مُوشكاً وسيَّرها",2,"ر",3,0],["ثم حاولت بالمصيقل تصغي","ري فما زدْتني سوى تعْظيم",3,"م",1,0],["ثم حم الفراق فافترقا بعد","وداع برح وبعد عناق",4,"ق",1,0],["ثُمَّ حالَت حالٌ تُكَلِّفُني قِس","مَةَ حَمدي بَينَ الرِجالِ وَذَمّي",5,"م",2,0],["ثُمَّ حَصَّنتُ مِنهُ نَفسي عَنِ الشا","هِ بِعَقدِ الفِرزانِ بِالبَيدَقَينِ",6,"ن",1,0],["ثم حلق بجناحين إلى","عالم نحن له جد ظماء",7,"ا",2,0],["ثُمَ حَيّى ذاكَ الشَهيد وَنادى","أَيهذا الشَهيد لَستَ بِفانِ",8,"ن",1,0],["ثُمَّ حُجّابُ بَيتِهِ بَعدُ مِنهُم","وَحِياضَ الحَجيجِ قَد وَلّاها",9,"ا",3,0],["ثُمَّ حَوى مِن بَعدِ ذاكَ فارِسا","كَم نَهبِ مالٍ كانَ مِنهُ آيِسا",10,"س",2,0],["ثُمَّ حَدَت بِها الصَبا كَأَنَّها","فيها مِنَ البَرقِ كَأَمثالِ الشُهُب",11,"ب",1,0],["ثُمَّ حَمَّلتِني الثَقي","لَ وَأَبكَيتِني دَما",12,"م",2,0],["ثمّ حَباهُ وكَساهُ ووَصَلْ","بشاحجٍ وصاهلٍ لا يُمْتَثلْ",13,"ل",1,0],["ثم حياني أحمدُ المتنبي","والمعريُّ الشيخُ وهو ضرير",14,"ر",1,0],["ثمَّ حَولْ وِجهَةَ الطرْفِ تجِدْ","صُوَراً أَسْوَغ فِيِ النَّفْسِ وَأَمْرَى",15,"ر",2,0],["ثُمَّ حَيِّي الْعُزَّ الْمَيَامِينَ مِنْ أَعْوَانه","الأكْرَمِينَ شِيْباً وَمُرْدَا",16,"د",2,0],["ثُمَّ حَلَّ الهَوى لِكُلِّ حَبيبٍ","عَقدَ الدَهرُ وَصلَهُ ثُمَّ حَلّا",17,"ل",2,0],["ثُمَّ حَطَّت عَنها السُروجُ وَمِن عَز","مِكَ خَيلٌ ما حُلَّ عَنها حِزامُ",18,"م",1,0],["ثم حاكَى من أياديك نَدىً","فانْتَحَى الأرضَ بَجْرى مُغرِب",19,"ب",1,0],["ثم حيا مسلما","وهو ساهي يفكر",20,"ر",1,0],["ثم حاكِمْني بعدلٍ","وبنور الحق، مُرْني",21,"ن",2,0],["ثم حبّت بكفها وتوارت فأهاجت","لخافقي أشجانه",22,"ن",2,0],["ثم حيّا بكفّه وتوارى","فأراني الغروب قبل الغروب",23,"ب",1,0],["ثُمَّ حاشى يُلام يَوماً مُحِبّ","أَطنَب المَدح فيكُم أَو يُعاب",24,"ب",1,0],["ثُم حَيت عَني وُجوهاً تَضيءُ الل","يل مِن مَعشَر عَليَّ كِرام",25,"م",1,0],["ثم حث السير إن رمت الهدى","واطرح الأثقال",26,"ل",1,0],["ثم حَيَّيْتُ وجْهَهُ فتأَمل","تُ حياءً يُولِي الحَيَا والحياتا",27,"ت",2,0],["ثم حطّ النجمين والثلج والور","دة وامتدّ واستطلب الهجوعا",28,"ع",2,0],["ثم حالوا بين المثاليِّةِ العل","يا لفكري وبين سعيى وبيني",29,"ن",2,0],["ثمَّ حَنَتْهُ ثمَّ طاحَتْ به","تحتَ الثَّرى في حُفرةٍ مغلَقَهْ",30,"ق",2,0],["ثم حل الدين المؤجل حتى","جاء يبغيه منك لا تمهيلا",31,"ل",2,0],["ثم حزيران وتموز وآب","تبارك الرحمن يهدي من أحب",32,"ب",1,0],["ثم حذروا يوم التلاقي غداً","وأخلصوا التوبةَ قبلَ المنون",33,"ن",1,0],["ثم حيَّاك بالسلام فحَيِّي","ه بما فاه ويحَ منْ حيَّاك",34,"ك",1,0],["ثم حكَّمتَ في رؤوس العدا يو","مَ الوغي الهندوانةَ الفولاذا",35,"ذ",2,0],["ثم حاز الملكَ نبهان الذي","حلَّ في ملك عُمان وعَقَدْ",36,"د",1,0],["ثُمَّ حالَ النَجّارُ وَاِختَلَفَ الشَك","لُ فَلاحَت بِجَوهَرِ الأَلوانِ",37,"ن",1,0],["ثم حيوا من مغانيه الربى","فبه مرت لييلات الصبا",38,"ب",2,0],["ثم حيي حي صحبي الكرما","خير قومٍ فُديوا بالانفس",39,"س",1,0],["ثُم حَباه لَيلة بِأَلف","وَزادَ في إِكرامِه وَاللطف",40,"ف",1,0],["ثم حروف الجر أو نصب ومع","ليس وفعل المدح والذم امتنع",41,"ع",1,0],["ثم حواشي نسخهم منوعه","مائلة ليسرةٍ مقطّعه",42,"ه",1,0],["ثُمَّ حَلّوا حَلَّةً لَهُمُ","بَطنَ وادٍ قُنَّةَ السَلَمَة",43,"م",2,0],["ثمَّ حلاَّ معاً بأرفع مجدٍ","طلعا في سماه شمساً وبدرا",44,"ر",2,0],["ثم حامت عليه من سلفِ الخز","رج قومٌ كأنهم إكليلُ",45,"ل",1,0],["ثمّ حشو الخيام بيض كأمثا","لِ المَها في صرائمِ الكثبانِ",46,"ن",1,0],["ثم حنت لإلفها فهي نهبٌ","بين ذاك الندا وهذا المنادي",47,"د",2,0],["ثم حقوق الوالدين مطلقا","وما بهن أدباً تعلقا",48,"ق",2,0],["ثم حلت نفوسنا مشعر الام","ن ونالت من بعد ذاك مناها",49,"ا",3,0],["ثُمَّ حَذاهُم في الوَغى نِعالَهُ","حَتّى يَكونوا عِندَها أَمثالَهُ",50,"ل",2,0],["ثُمَّ حَمَاه وكذاكَ الشَّام","وخيبرٌ في السَّمتِ خُذِ الكلام",51,"م",1,0],["ثم حقق وقل له","هو أمر وكل أمر",52,"ر",1,0],["ثم حذو توجيه مجرى نفاذ","فارو عني وفز بها وتفهم",53,"م",1,0],["ثم حيت من نرجس وأقاح","بثغور وأعين ناعسات",54,"ت",1,0],["ثم حدوث العالم المقرر","فيما مضى دليله التغير",55,"ر",1,0],["ثم حلّ الخريف فانتثر الزه","ر وزالت نضارة الأفنان",56,"ن",1,0],["ثُمَّ حَيّوا ثاوِياً في حَيِّها","وَمُقيماً في رُباها سَكَنا",57,"ن",2,0],["ثم حرام ان اكون وحدي","ممتعاً منك بهذا المجد",58,"د",1,0],["ثم حمامك الأَنيق فأرخ","جاد في حَوضه بِماء طَهور",59,"ر",1,0],["ثم حططت الرحل عند ذي الحسب","شمس سما أفق المعالي والأدب",60,"ب",1,0],["ثم حَالَفْتُمْ علينا قومَنا","لتَعِزَّوا بهم والحِلفُ عَارُ",61,"ر",1,0],["ثم حيَّى الحَيا رُباهُ فأَحيَى","ما عَفَت رَسمَهُ يَدُ الأَيَّامِ",62,"م",1,0],["ثم حَنُّونَ مَلكَ عَمُّونَ حتى","حلَّ فيهِ من ابن يسىَّ النِكالُ",63,"ل",1,0],["ثم حروف تنصب المضارعا","قد عدها النحاة نوعاً رابعا",64,"ع",2,0],["ثم حي الساكنيها بالذي","عودوا مثلك من لثم الثرى",65,"ر",2,0],["ثُمَّ حَياتي بِخَمرَتِهِ","مُنتَهى الآمالِ وَالوَطَرِ",66,"ر",1,0],["ثم حططنا الرحل بعد العصر","وثم نمنا لِصلاةِ الفجرِ",67,"ر",1,0],["ثم حكت فينكس شيخاً أك","ملا تخاطب الشهم ميلا أولا",68,"ل",2,0],["ثم حَفّوا بالنعشِ يبكونَ حزناً","واعتذاراً لو يَقَبلُ الميتُ عُذرا",69,"ر",2,0],["ثم حاكته له من شعرها","وانجلت سافرة عن نحرها",70,"ه",2,0],["ثم حاكته تباهي اليمنا","هكذا صنعاء لا تنسجي",71,"ي",1,0],["ثم حاكته تباهي قعضبا","إذ أتت حسا بما لم يحدس",72,"س",1,0],["ثُم حَددت زَماناً للقا","قَبل أَن ينعق للبين غراب",73,"ب",1,0],["ثُمَّ حَلَّ الحمى وَخيرَ جوارٍ","لخيار الخَيار في الإنسانِ",74,"ن",1,0],["ثم حانت منه التفاتةُ عَينٍ","فرأى منزلاً وفيه ضياءُ",75,"ا",2,0],["ثم حسنا ولو بدا حسنه في","غيره ما شجا فؤادي هواه",76,"ا",2,0],["ثم حلوا بين شعب آمنٍ","يكرم الضيف عراةً وجياعا",77,"ع",2,0],["ثم (حيل الديار فالمحيبس فالرو","س) فأدنى (مصيرة) أدناها",78,"ا",3,0],["ثمّ حسن الظنّ بعد العسرِ يسرٌ","لا تخف فالغيث مِن رعدٍ وبرقِ",79,"ق",1,0],["ثم حاولت كثيرا","جذبه في كل جلسة",80,"س",2,0],["ثم حي اذا مررت بسلع","أهل ودي من مازن وهلال",81,"ل",1,0]]}