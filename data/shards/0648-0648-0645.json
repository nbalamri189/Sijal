{"poems":[[79,"وسواس حليك أم هم الرقباء","https://www.aldiwan.net/poem36791.html","الكامل"],[68,"كرر اللوم عليه إن تشا","https://www.aldiwan.net/poem40645.html","الرمل"],[228,"ملقيه بحسنك المأجور","https://www.aldiwan.net/poem41602.html","الخفيف"],[310,"ووميض ثغر إن قوما قد رأوا","https://www.aldiwan.net/poem56363.html","الكامل"],[371,"ووما كنتم تعرفون الجفا","https://www.aldiwan.net/poem17902.html","المتقارب"],[435,"نسمات البان من العلم","https://www.aldiwan.net/poem40851.html","المتدارك"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122019","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101071","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106828","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94361","الرمل"],[5408,"ظلان أنت","https://www.poetsgate.com/ViewPoem.aspx?id=190583",""],[5596,"الجمعة الممطرة","https://www.poetsgate.com/ViewPoem.aspx?id=205815",""]],"verses":[["وَوَمِيضُ ثَغْرِكِ أم تَأَلُّقُ بَارِقٍ","وَشِهَابُ شُنْفِكِ ذَا أَمِ الْجَوْزَاءُ",0,"ا",2,0],["وَوَميضٌ غادَرَت غُرَّتُهُ","أَدهَمَ اللَيلِ صَباحاً أَبرَشا",1,"ش",2,0],["وَوَميضُ اللَظى يُغلف عَينَيهِ","فَعَيناهُ فوهَتا تنّورِ",2,"ر",1,0],["وَوَميضِ ثغرٍ إنّ قوماً قَد رأوا","عَذلي لَفي ظلمِ الجهالةِ قد غووا",3,"و",3,1],["ووَما كُنتُمُ تَعرِفونَ الجَفا","فَبِاللَهِ مِمَّن تَعَلَّمتُم",4,"م",1,1],["ووميض البرق روىخبرا","عن ثغر حبيب مبتسم",5,"م",1,0],["وَوَمْضَةُ بَرْقٍ أَلْبَسَ الْخَدَّ فِضَّةً","مِنَ الدَّمْعِ كَمًّا أَلْبَسَ الأُفْقَ عَسْجَدَا",6,"د",2,0],["ووما شربوا كأس الهوان لو أنهم","أنابوا إلى الحق المبين وفاءوا",7,"ا",1,0],["ووما فهموا معنى الذي أبصروا كما","تزيغ عيونُ الشرب أثقلها السكر",8,"ر",1,0],["وَوَميض البرق من بسم الثغور","وَجلاءُ الغمِّ من بِشر البَشَر",9,"ر",1,0],["ووَمْضُ صَحْوي تمنّيني عرائِسُه","منْ أنْ يعودَ إلى ليلاتِه العَلُّ",10,"ل",1,0],["ووميض البرق يؤججه","والريح لواقح تُرشده",11,"د",2,0]]}