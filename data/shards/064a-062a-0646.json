333,"الإنسان والمعرفة","https://www.poetsgate.com/ViewPoem.aspx?id=98236",""],[5409,"صوني جمالك بالحياء","https://www.poetsgate.com/ViewPoem.aspx?id=155249",""],[5419,"هي وقطتها","https://www.poetsgate.com/ViewPoem.aspx?id=52033",""],[5431,"فيروس كورونا","https://www.poetsgate.com/ViewPoem.aspx?id=210258",""],[5517,"أشجار وراء السياج","https://www.poetsgate.com/ViewPoem.aspx?id=199054",""],[5596,"السحمية","https://www.poetsgate.com/ViewPoem.aspx?id=206361",""],[5651,"سفرَتْ فقال أدلّةُ السّفْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=107008",""],[5691,"لست مذنباً...!","https://www.poetsgate.com/ViewPoem.aspx?id=206356",""],[5776,"وجوه الأقفية المعطوبة","https://www.poetsgate.com/ViewPoem.aspx?id=199326",""],[5873,"المدلة بالجمال","https://www.poetsgate.com/ViewPoem.aspx?id=215918",""],[5880,"الوحيدة","https://www.poetsgate.com/ViewPoem.aspx?id=208578",""],[5956,"الشامُ فيها العشقُ والتَّرحامُ","https://www.poetsgate.com/ViewPoem.aspx?id=184921",""],[5956,"حسبي ذكاؤك سابراً لحقيقتي","https://www.poetsgate.com/ViewPoem.aspx?id=193504",""],[6093,"محمد سيد السادات","https://www.poetsgate.com/ViewPoem.aspx?id=193786",""],[6102,"خَيال ..","https://www.poetsgate.com/ViewPoem.aspx?id=183991",""],[6167,"حديث الغضب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85540&r=&rc=23",""],[6244,"ربيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=509&r=&rc=2",""],[454,"يزهو القريض به","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82684&r=&rc=48",""],[6288,"بستان الأدب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78521&r=&rc=34",""]],"verses":[["يَتَنَكَّبُ اللَحمَ الذَلي","لَ وَيَطلُبُ العُضوَ الرَئيسا",0,"س",2,0],["يَتَناوَلُ الضَبَّ الخَبيثَ مِنَ الكُدى","وَيَحُطُّ مِن عَليائِها الشُغواءَ",1,"ا",2,0],["يَتَنَاجَيْنَ بِعَذْلي إِذ غَدَتْ","بِزَّتي دِرْعي وَأَلْقَيْتُ عِطافي",2,"ف",2,0],["يَتَنازَعنَ الهَوى مِن ذي هَوىً","آمِناتٍ عَهدَهُ لا يَنتَكِث",3,"ث",1,0],["يَتَنازَعونَ كَأَنَّهُم قَد أَوثَقوا","خاقانَ أَو هَزَموا كَتائِبَ ناعِطِ",4,"ط",1,0],["يتنفّس الصُّعداء من كِظَّاتهِ","لا فارقَتْه زفرةُ المكروبِ",5,"ب",1,0],["يتناولون عدوهم ووليَّهم","عن قدرةٍ بمهالك ومعايش",6,"ش",1,0],["يتنفَّسون لكل ضرطةِ ضارطٍ","أسفاً لها ولكل ثلطةِ ثالط",7,"ط",1,0],["يتنازع الأرباب فيك نفاسة","كل يمنّ بأنه سّواكا",8,"ك",2,1],["يتنسمان الحب بينهما فما","لفمٍ على غصن النبات رطيب",9,"ب",1,0],["يَتَنَزَّلُ الأَجرانِ في صُبحَيهِما","جَزلَينِ عَن صَومٍ وَعَن إِنفاقِ",10,"ق",1,0],["يَتَنازَعانِ دُموعَ عَينِ مُسَهَّدٍ","هَذا يَجيءُ بِها وَهَذا يَرجِعُ",11,"ع",1,0],["يَتَناوَلُ الروحَ البَعيدَ مَنالُهُ","عَفَواً وَيَفتَحُ في القَضاءِ المُقفَلِ",12,"ل",1,0],["يتنازَعونَ على الرَّحيقِ غَرائِباً","يَحْسِبْنَ زاهرةً كؤوسَ رَحيقِ",13,"ق",1,0],["يَتَناهَبانِ لُحومَنا وَدِماءَنا","وَنُفوسَنا جَهراً وَنَحنُ نَراهُما",14,"م",2,0],["يتنازعانك غيرة وتغضباً","كل يراك حبيبه المعبودا",15,"د",2,0],["يَتَنَبّعُ ماءُ تألُّقِهَا","فيقالُ أفي سَكَنٍ سكنا",16,"ن",2,0],["يتنازعونَ حديثَ كلّ كريهةٍ","بِكْرٍ تَصَالوا حرّها وعوانِ",17,"ن",1,0],["يَتَنَفَّسونَ فَتَنثَني لَهَواتُهُم","مِن جَمرَةِ الحَسَدِ الَّتي لَم تَبرُدِ",18,"د",1,0],["يَتَناوَلونَ سُلافَةً عانِيَّةً","طابَت لِشارِبِها وَطابَ المَقعَدُ",19,"د",1,0],["يَتَنازَعونَ تُراثَنا فَإِذا رَضوا","عادَ الضَجيجُ هَوادَةً وَسُكونا",20,"ن",2,0],["يَتَنازَعونَ رِداءَ مُلكٍ مونِقٍ","خَضِلِ الحَواشي مُذهَبِ الأَردانِ",21,"ن",1,0],["يَتَنازَعونَ مَدى الفَخارِ وَغايَةً","مَن يَحوِها يَعظُم بِها وَيُسَوَّدِ",22,"د",1,0],["يتنافسُ الأنصارُ فِيك وما دروا","لِمنِ المفازُ وأيُّهُمْ هو أوّلُ",23,"ل",1,0],["يتنعَّمون مُكرَّمين كأنَّما","لنعيمهم عمَّ البلاد شقاؤها",24,"ا",3,0],["يَتَنَفَّسُ الصُعَداءَ عِندَ مُراسِلٍ","وَيَكادُ يَخلَعُ جِلدَةَ الكَعّابِ",25,"ب",1,0],["يتنازعون بها الطِّباقَ خَرائبا","دَمِيَتْ على أنقاضها الأظفارُ",26,"ر",1,0],["يتنظّرُ الحقلُ المنوّرُ خطوَهُ","والنهرُ والجبلُ العريضُ الأيهمُ",27,"م",1,0],["يَتَناوَلُ الظُّرَفاءُ فيه وشُرْبُهمْ","لسلافِهِ والأَكْلُ مِن خِنْزِيرِه",28,"ر",2,0],["يتنزّى ولا يطيق وثوبا","حسرة الشّمس لا تطيق الشروقا",29,"ق",2,0],["يَتَنَاذَرُ الرَّاقُونَ سُمَّ لُعَابِهِ","رُعْباً فَلَيْسَ لِمَسِّهِ دِرْيَاقُ",30,"ق",1,0],["يَتَنَاوَلُونَ مِنَ الصَّحَائِفِ وَحْيَهُ","فَتَكُونُ كُلُّ صَحِيفَةٍ كَلِوَاءِ",31,"ا",2,0],["يَتَنَاوَلُ الغَرَضَ البَعِي","دّ إِذا البَعِيدُ هُوَ القَرِيبُ",32,"ب",1,0],["يَتَنَفَّسُ الصُعَداء يَومَ خَميسِهِ","هَمّاً كَذلِكَ هِمَّةُ السُعَداءِ",33,"ا",2,0],["يتنافسُونَ على رضَاهُ، كأنَّه","رَشَأٌ يتيهُ عليهمو بدلالِهِ",34,"ل",2,0],["يتندرون ولا ابْتِذَالَ؛ وإنما","تُرعى الحقوق، وتُحفظ الأقدار",35,"ر",1,0],["يتنقلون على ضفاف «السين»، لم","ينقل ركابَهمو إليه قطار",35,"ر",1,0],["يتنهك الحرمة لا تريغه","ضريبة من كرم ولا تقى",36,"ا",1,0],["يتنزَّى طولَ الليالي ولا مِثلَ","تَنزيِّه إن جَرَت ذكراك",37,"ك",1,0],["يتنازعونَ كأنهمْ قدْ أوثقوا","فَلقانَ أو هَزموا كتائِب ناعِطِ",38,"ط",1,0],["يتناهَبْنَ شموسَ الرَّا","حِ في كأْسٍ وكُوبِ",39,"ب",1,0],["يتنازعون على الرحالِ حديثَهُمُ","كتنازعِ الندماءِ كأسَ رحيق",40,"ق",1,0],["يتَنازعونَ جَنَى الحديثِ ونَصَّه","بألدِّ تأدِيَةٍ وطيبِ كَلامِ",41,"م",1,0],["يتنقّلونَ كواكباً سيارةً","والأرضُ بالإسلامِ هالةُ أقمُر",42,"ر",1,0],["يتناهى الأنام والأيّامُ","ولك الخلد دولة ومقام",43,"م",1,1],["يتنزّى دما فلا يجد الدم","ع يعزّى به الغريب الغريبُ",44,"ب",1,0],["يتنزى شوقا إلى عشر بلقي","س فهبنى كالناسك الأواب",45,"ب",1,0],["يَتَناهَبانِ نُفوسَنا وِدِماءَنا","وَلُحومَنا عَمداً وَنَحنُ نَراهُما",46,"م",2,0],["يتناغمون تناغم القطط التي","صطك لما تدعس الأذناب",47,"ب",1,0],["يتناقَلُ الأُدباء دُرَّ قريضِهَ","فكأنّه التّهليل والتَّسبيحُ",48,"ح",1,0],["يتناجَين بإيلام فتًى","ضَيَّعَ الحزم فلم يشدد حزاما",49,"م",2,0],["يتنحَّى كلٌّ منا عن موضعه للجار الأقرب","لا عن أدب وحياء",50,"ا",2,0],["يتنقل الغريد بين رياضه","طرباً وتبهجه الربى فيحلق",51,"ق",1,0],["يتناول الغرضَ البعيدَ ولم يَرِمْ","وطناً ولم يقطع لسيرٍ منزلا",52,"ل",2,0],["يتناصعن بأوصافكُمُ","بين مصغ طرِبِ السمع وتالي",53,"ل",2,0],["يتنازعون على الحديث بها","يَقوَى مقلُّهُمُ على المُثري",54,"ر",2,0],["يتنقلون على مرا","كبها فما يضغون سَرْجا",55,"ج",2,0],["يتناكرون حقوقَها من بعد ما","عُلِطوا على أعراضهم بِسِماتِها",56,"ت",3,0],["يتناجيان بزفرة","رقت فكادت لا تبين",57,"ن",1,0],["يتنعمون به هنا وهناك لا","يخفى عليهم بالمليح القائم",58,"م",1,0],["يتنادمُون ومن نَدَا","مَتِهم يُقالُ لهم نُدامُ",59,"م",1,0],["يتنعمون هناك أي تنعم","ما مثله عيش يلذ رغيد",60,"د",1,0],["يتنادى فيها هتافاً ولولا","أنه للسلام عاد رعودا",61,"د",2,0],["يتنسَّمان معَ النسيمِ لطافةً","ويُنافِسَانِ المِسكَ في الأنفاس",62,"س",1,0],["يتناولُ الإِمصاصُ مُغْفِلَ ذكْرها","أوَ ما أقلُّ حقوقِه الإِمصاص",63,"ص",1,0],["يتنافى الجثمان والروح جمعاً","فهما منه ليس يجتمعانِ",64,"ن",1,0],["يتناشدون الشعرَ في مسراهمُ","وكذا التناشدُ ديدنُ الفتيانِ",65,"ن",1,0],["يتنافسن مسقط الضوء حتى","عمهن النهار بالتنويل",66,"ل",1,0],["يَتَناضَلنَ السُرى قُذُفاً","قَد كَساها المَيس مِن قَتَرِه",67,"ر",2,0],["يتناسخونَ أثيِلَ مجْدٍ قادِمٍ","وحديثَ مَجْدٍ ليسَ بالمُتردِّدِ",68,"د",1,0],["يتنادون بالعويل والوي","ل وراء الأبواب والجدران",69,"ن",1,0],["يتندى عليهمو بوقاء الضي","م أكرم برحب كهف حصينِ",70,"ن",1,0],["يتناجى مع العواطف طورا","ويناجى الطيور فى الأفق طورَا",71,"ر",2,0],["يتنادى فيضفر الجوُّ ثوباً","فيه نُعمى الهوى ولهوُ المغازل",72,"ل",1,0],["يتناقلون الفخرَ بينهم","ندبٌ لهم يرويه عن ندبِ",73,"ب",1,0],["يَتنازعن بينهم بَسيطاً","مسكراً للقلوب بالتَهتير",74,"ر",1,0],["يتنافس السحر الحلال، وتارةً","يتناثر العثيان حول نشيدي",75,"د",2,0],["يتنازعون الكاس فيما بينهم","جام تراق لهم وتملأ جام",76,"م",1,0],["يتنازعون على حطام زائل","ومتاع دنيا شيب فيه سمام",76,"م",1,0],["يتنازعون على حياة كلها","تعب وكل شؤونها آلام",76,"م",1,0],["يَتَناقَلنَ شِعرَهُ هَزِجاتٍ","هَزَجَ الوُرقِ في ظِلالِ الدَوالي",77,"ل",2,0],["يتنعمون ويمرحون غواية","لا جازع منهم ولا متوجع",78,"ع",1,0],["يتنازعان الكأس هذا مرة","والخود أخرى ثم يتكئان",79,"ن",1,0],["يتنافسُ الشّعراءُ فيكَ مفاخِراً","وسِباقُهُم يبقى على الأزمانِ",80,"ن",1,0],["يتنافر الصبيان بينهمُ كما","تتنافر الأطيار في الأفنان",81,"ن",1,0],["يتنادون على جردهم","البدار الكر يا جرد البدارا",82,"ر",2,0],["يتنزّى على خُطى عاصفات","تتهاوى به لجوف المخاطرْ",83,"ر",1,0],["يتناجون دون تحريك هام","حيث ولوا نحو الجيوش الهاما",84,"م",2,0],["يتنافسون الى الضلال كأنهم","يتسابقون الى الوراء مسيرا",85,"ر",2,0],["يتناسى الاحياء في الكون حتى","يتناسى أصحابه والقبيلا",86,"ل",2,0],["يتنازعون على امتلاكك بينهم","فلهم عليك تشاجرٌ وكفاح",87,"ح",1,0],["يتناقلانِ اللحظَ من جَفنَيهما","فكأنّما يتدارسانِ كتابا",88,"ب",2,0],["يتناثرون على الصريخِ كأنهم","يدعونَ نحو غنائمٍ ونهاب",89,"ب",1,0],["يتناوبون عَلَى الخلافة إِنْ خَفِي","بدرٌ تبدَّل منهمُ بسِوائه",90,"ا",3,0],["يَتناوبون عَلَى الخلافة سيداً","عن سيد حَتَّى اصطفَتْك الأَبْحَبا",91,"ب",2,0],["يَتناوبون بعرشِها حَتَّى انتهَتْ","فِي واحدٍ فهْو الجميعُ المُفْرَد",92,"د",1,0],["يتنازَعْنَ الهوى مِنْ ذي هوىً","آمناتٍ عُقدةً لا تُنْتَكَثْ",93,"ث",1,0],["يَتَناوَل الحاجات فيهِ من يَرى","حاجاته نيطت بهامِ الفرقدِ",94,"د",1,0],["يتنازعن به مرحولةً","فوقَها مختلفُ الطَّعْنِ شِجَارُ",95,"ر",1,0],["يتناذرونَ زئيرَ لي","ثٍ من سِوى القَصْباءِ غابُهْ",96,"ب",2,0],["يتنصلون بأَوجهٍ مَرضَتْ","حَسداً فليسَ يَعودها الخَجَلُ",97,"ل",1,0],["يتنقل الغريد في أرجائها","حرا طليقا هائما مترنما",98,"م",2,0],["يَتَنازَعانِ الكأسَ في أَيديهما","وَهُما بِلَذَّةِ شُربها فَرِحانِ",99,"ن",1,0],["يَتَنازَعُ الحَزَنُ المبرِّحُ والجَوى","في مُهجتي وكلاهما بي عاملُ",100,"ل",1,0],["يتنفَّسُ الصُعَداءَ من وَغرٍ بهِ","لا ينتهي عنهُ ولا بَرقَى صَعَد",101,"د",1,0],["يَتناول العَنقاءَ فارسُ سرجِه","إِذ سَرجُه يَعلو عَلى العَنقاء",102,"ا",2,0],["يتناجيان الحب فيه","مثل زقزقة الطيور",103,"ر",1,0],["يتنعمون بها وبين فئاتكم","فئةٌ تجوعُ ولا تنالُ طعامها",104,"م",3,0],["يتنوّع الموت الزؤام بطعنه","كتنوع الحرباء في أشكاله",105,"ل",2,0],["يَتَناذَرُ الأَعداء مِنه سَطوة","ملء الزّمان تغيُّظاً وَزَفيرا",106,"ر",2,0],["يَتنازعون العاريات وَخيرهم","مَن قامَ في الدُّنيا على استحياء",107,"ا",2,0],["يتنزى هوى على تلعاته","عاشق لا يفيق من سكراته",108,"ت",2,1],["يَتَنافَرُونَ الى العُلا ورِجالُنا","يَتَنافَرُونَ لِماثَمٍ اوْ عاب",109,"ب",1,0],["يتنفس الاصباح والريحان من","حركات معطفه وحسن روائه",110,"ا",3,0],["يتنافسون على الخنوع","لهاثهم ملأ الكتبْ",111,"ب",1,0],["يتناهشون بنا أحاديث الهوى","والكل منتظر سقوط سمائي",112,"ا",