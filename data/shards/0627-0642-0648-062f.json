{"poems":[[55,"ألا لله بادرة الطلاب","https://www.aldiwan.net/poem30747.html","الوافر"],[135,"يا ليتني فيها جذع","https://www.aldiwan.net/poem24002.html","مجزوء الرجز"],[556,"وسائلة لتعرف ما عراني","https://www.aldiwan.net/poem47165.html","الوافر"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71071","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59500","الوافر"],[4162,"","https://poetry.dctabudhabi.ae/diwan/poem/67784","المتقارب"]],"verses":[["أَقودُ إِلَيهِما نَفسي وَأُهدي","سَلاماً لا يَحيدُ عَنِ الجَوابِ",0,"ب",1,0],["أَقودُ وَطفاءَ الزَمَع","كَأَنَّها شاةٌ صَدَع",1,"ع",1,0],["أقود إلى المقابرِ كلَّ يومٍ","على رغمي خبيئاً في جَناني",2,"ن",2,0],["أَقودُ لهم من آل قحطان جَحْفَلا","يُبَيَّتُهم في أرضهم ويُصابِحُ",3,"ح",1,0],["أقودُ الخيلَ لاحقةَ كُلاها","نَقاذفُ بالغَطارفة الكرامِ",4,"م",1,0],["أقُودُ الكَتِيبَةَ مُسْتَلْئِماً","كَأنّي أخُو عرةٍ أجْرَبُ",5,"ب",1,0]]}