,"https://poetry.dctabudhabi.ae/diwan/poem/66499","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110211","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110207","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110188","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109928","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110210","الكامل"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125975","السريع"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70015","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127143","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127204","الكامل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35463","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139712",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139789",""],[4680,"سيُدبر الكرب","https://www.poetsgate.com/ViewPoem.aspx?id=186800",""],[4778,"مليون ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=198455",""],[4778,"العمر ينقص","https://www.poetsgate.com/ViewPoem.aspx?id=202926",""],[4830,"محرابُ الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=193900",""],[4578,"بغرةٍ تنقضى في حبها حججي","https://www.poetsgate.com/ViewPoem.aspx?id=49370",""],[4578,"تنفيذُ حكمك في فؤادي يا قمرُ","https://www.poetsgate.com/ViewPoem.aspx?id=49421",""],[4858,"كيف ننسى أسيرنا ؟","https://www.poetsgate.com/ViewPoem.aspx?id=138040",""],[4908,"إليها في غِيَابِها","https://www.poetsgate.com/ViewPoem.aspx?id=207383",""],[5008,"شوق","https://www.poetsgate.com/ViewPoem.aspx?id=27298",""],[5121,"رونق الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=36282",""],[5190,"الجوزاء والبحر","https://www.poetsgate.com/ViewPoem.aspx?id=68758",""],[5323,"أحتاج صوتك !","https://www.poetsgate.com/ViewPoem.aspx?id=209178",""],[5340,"يا من غدا وجهه روض العيون لما","https://www.poetsgate.com/ViewPoem.aspx?id=186105",""],[5425,"يَا طَاعِنَاً ... والمُستَحِيْلُ حِرَابُهُ (جيش العراق)","https://www.poetsgate.com/ViewPoem.aspx?id=198923",""],[5720,"قراري ..","https://www.poetsgate.com/ViewPoem.aspx?id=198925",""],[5809,"لم ارضَ","https://www.poetsgate.com/ViewPoem.aspx?id=205237",""],[5956,"شكراً لتلفاز الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=193473",""],[5956,"سحُبٌ تفيد حياتنا","https://www.poetsgate.com/ViewPoem.aspx?id=208561",""],[6093,"حَافِظ","https://www.poetsgate.com/ViewPoem.aspx?id=188245",""],[6096,"رجلٌ أنا","https://www.poetsgate.com/ViewPoem.aspx?id=177138",""]],"verses":[["يا مَن غَدَوتُ بِهِ في الناسِ مُشتَهِراً","قَلبي عَلَيكَ يُقاسي الهَمَّ وَالفِكَرا",0,"ر",2,1],["يا من غدت ألفاظه حلوةً","قد أبدعت معنى وإيضاحا",1,"ح",2,1],["يا من غَدا وعزيمُهُ ولسانُهُ","سيفان شتّى في الخُطوب وفي الخُطَبْ",2,"ب",1,0],["يا من غدا مالُه في الناس مُشتَركاً","ومن توحَّد بالمعروفِ وانفردا",3,"د",2,0],["يا من غدا ذُخري لنائبتي","إذ لا سواه من الورى ذخرُ",4,"ر",1,0],["يأمن غدْري أخو الصفا ولا","أعرف إلا الوفاءَ من أُنُس",5,"س",1,0],["يا من غدا بين تأميل وإشفاقِ","منّي ومن حسب نفسي أنه باقي",6,"ق",2,1],["يا مَنْ غدا يسلك في أهدى السُّبل","يا ذا الأيادي والسحابات الهُطُلْ",7,"ل",1,0],["يا من غدا والمشتري جَدٌّ له","والشمس رأيٌ والهلال جَبين",8,"ن",1,0],["يا مَن غَدا لِلأَنامِ غَيثاً","وَجودُهُ لِلوَرى غِياثا",9,"ث",2,1],["يا مَن غَدا لِلنَيِّرَينِ ثالِثاً","وَثانِيَ الغُصنِ إِذا تَثَنّى",10,"ن",2,0],["يا مَن غَدا كَهفَ الأَيا","مى وَاليَتامى وَالأَرامِل",11,"ل",1,0],["يا مَن غَدا ظِلُّ","حُسنِهِ حَرَماً يُخضَب",12,"ب",1,0],["يا من غَفَت والفجر من دارها","شعشع في الآفاق أبهى سناه",13,"ا",2,0],["يا مَنْ غدا في طلابِ العلمِ مجتهداً","لمْ يثنِهِ عنهُ لا مالٌ ولا ولدُ",14,"د",1,1],["يا مَن غَدا كُلُّ لَفظي فيهِ مِن طَمَعٍ","عَسى وَلَيتَ وَشِعري كُلُّهُ غَزَلا",15,"ل",2,0],["يَا مَنْ غَمَا الجَوْزَاءَ","أَحْسَنْتَ اخْتِيَارَكَ مَنْ تُصَاهِرْ",16,"ر",1,0],["يا من غدا وجودهُ موجودُ","من حقك الغبطة ُ والخلودُ",17,"د",1,0],["يا من غدت روحي","بالوجد ترعاه",18,"ا",2,0],["يا من غَدا ريبُ الزمانِ وصرفه","لم يقض شيئاً كالأسير العاني",19,"ن",2,0],["يا مَنْ غدا كاسمِهِ يُدْعَى فإن له","بِلا امْتِرَاءِ جميعَ الخلق أبناءُ",20,"ا",2,0],["يا مَن غَدا في الجَمعِ يُتعِبُ نَفسَهُ","كَيما يَزيدَ عَقارهُ وَضَياعَه",21,"ع",2,1],["يا مَن غدا لحسامِ البغي منتضياً","يستثبتُ الصَّرم حتى عادَ ذا رنق",22,"ق",1,0],["يا من غَدَتْ لعُلاهُ","زُهْرُ النّجومِ مَطايَا",23,"ا",3,1],["يا مَن غَنيتُ بِهِ عَنِ","جودِ الأَكُفِّ الشَحائِح",24,"ح",1,0],["يا من غدا بالوفا ضنينا","وسح دمعي ما فيه شح",25,"ح",1,1],["يا مَن غدا كلُّ لفظٍ فيه من طمع","نَعم وَمعناهُ في شرحِ الصبابةِ لا",26,"ل",2,0],["يا مَن غَدا في أَمره حائِراً","صَبراً فَقَد فازَ الصَبور الشَكور",27,"ر",1,1],["يا مَنْ غدا مُبدِياً شَكْوَى أحبَّته","لمّا رأَى حيثُ يُرجَى الوَصْلُ هِجْرانا",28,"ن",2,0],["يا مَن غدا الحَمدُ مُلْقىً في الثّرى دُرراً","ولم يُصادَفْ إلى أنْ جاء مُلْتَقِطا",29,"ط",2,0],["يا مَنْ غدَتْ أخلاقُهُ كُلُّها","عَدْلاً تُقيمُ الوَزْنَ بالقِسْط",30,"ط",1,0],["يا مَن غدا شاغِلي عن فَضْلِ خدمتِه","بفَضْلِ نعمتِه والصّدْقُ يَشْتَهِر",31,"ر",1,0],["يا مَن غدا فَرْط حُبّي وهْو يَحملُه","على البصيرة منّي أو على البَصَر",32,"ر",1,0],["يا مَنْ غَدا بينَ الأَنا","مِ بكلّ مكْرمةٍ خَليقَا",33,"ق",2,1],["يا مَن غدا طالباً بينَ الأنامِ أخاً","ثَبتَ المودَّةِ لا يُبغى به بَدَلُ",34,"ل",1,1],["يا مَنْ غدا حُسْناً لِوجهِ زمانِهِ","وأرى الوَرى شركاءَ في إحسانِهِ",35,"ه",1,1],["يا مَن غدا دينُهُ قَولاً بلا عَمَلٍ","مَطَلْتَ والمَطْلُ عَينُ المَنعِ والبُخْلِ",36,"ل",1,1],["يامَنْ غَدا سَبَبي حتَّى عُرِفْتُ بهِ","حَسْبي عُلاكَ إلى نَيلِ المُنى سَبَبا",37,"ب",2,1],["يا من غَدا كِنزُ المُقِلِّ","بأَرضِنا وَغِنى الفَقير",38,"ر",1,0],["يا من غدت ديمة إنعامه","كافلة بالسح والفيض",39,"ض",1,1],["يا من غدا ولسان المجد يشكرهُ","شرّفتَ بالمدحِ ألفاظي وأفكاري",40,"ر",2,0],["يا مَن غَدا رَوضي وَبُستاني","وَظِلُّ نَسريني وَرَيحاني",41,"ن",2,1],["يا مَن غَدا بِرِداءِ الحُسنِ مُشتَمِلاً","قُم نَصطَبِح فَخِضابُ اللَيلِ قَد نَصَلا",42,"ل",2,1],["يا من غدت تسبي بظل جمالها","مهلا فقد ذابت حشاشة فان",43,"ن",1,0],["يا من غدا ضبا بثائر لجَّةٍ","أو سمكةً راحت تفوح قفارا",44,"ر",2,0],["يا من غدا بالمجد مستأثرا","وليس بالنعمة يستأثر",45,"ر",1,0],["يا مَنْ غَدا بالعِرْضِ مِنْي لاَعِباً","مِنْ غَيْرِ ذَنْبٍ كَيْفَ حالُكَ في غَدِ",46,"د",1,0],["يا مَن غزا قلبَنَا بلحظٍ","وقامةٍ تُخجِلُ الرِّمَاحا",47,"ح",2,0],["يا من غفلتم وجوهكم سودُ","وربكم في الخيال مولودُ",48,"د",1,1],["يا من غدت تختال من خالِها","وخالُها يقضي بتهجينها",49,"ه",2,1],["يا مَنْ غَدا باهْتمامِهِ بَطَلا","بِغَيْرِ ما حَقٍّ مِنْهُ أو بَطَلا",50,"ل",2,0],["يَا مَنْ غَدَتِ القُلُوبُ في طَوْعِ يَدَيْه","ذَا صَبُّكَ كَمْ تَهْدِي تَجَنّيكَ إليهْ",51,"ه",1,1],["يا مَن غَدا بِعَوارِفٍ وَمَعارِفٍ","يُزري عَلى لَجَجِ العُبابِ الزاخِرِ",52,"ر",1,0],["يا مَن غَنيتُ بِفَضلِ نِعمَتِهِ","في الأَرضِ عَن عَرَبٍ وَعن عُجمِ",53,"م",1,0],["يا من غدا حامِلاً جثمانَ سَوَّار","مِن دارِه ظاعناً منها إلى النارِ",54,"ر",1,1],["يا مَن غَلا في وَصفِهِ","ثمنُ الفَضائِلِ فيهِ غالي",55,"ل",2,0],["يا مَنْ غَدا يُنفقُ العُمْرَ الثَّمِيْنَ بِلا","جَدْوَى سِوى جَمْعِ مالٍ خِيفَةَ العَدَمِ",56,"م",1,1],["يا من غَدَتْ تَخْتالُ مِنْ خالِها","وحالُها يقْضي بِتَبْهِيجِها",57,"ه",2,1],["يا من غدا للكرام الصيد مختَتما","لقد غدا لك باب المدح مفتَتَحا",58,"ح",2,0],["يا من غدا الإحسان منه مخيّما","في خير أعراق وأكرم خيمِ",59,"م",1,0],["يا مَنْ غدا دينهمُ واحداً","واختلف المَذهب والاعتقاد",60,"د",1,0],["يا مَن غَدا مؤمناً في سربه","تعجبه الآمال مغتراً بِه",61,"ب",2,1],["يا من غدا حالي لديهِ","اذا نعتُّ مؤكدا",62,"د",2,0],["يا من غدا لوداد أه","ل زمانه متعرّضا",63,"ض",2,1],["يا من غيوث الأفق تحسد بذلهُ","وتغار من طامي سخاه الأبحرُ",64,"ر",1,0],["يا مَنْ غدتْ خيرَ أَملاكِ الزَّمانِ لقدْ","وَلَدْتِ مَلْكَ البرايا خيرَ مولودِ",65,"د",1,0],["يا من غدا يبكي أميمة أن رأى","من ءايها خرب المعاهد محولا",66,"ل",2,0],["يا من غرستُ له المودَّة في الحشا","وعلى الصفاءِ نَمت له أغراسها",67,"س",3,0],["يا من غدا ربعهم وفيه","أمُّ الردى منتجٌ لقوحُ",68,"ح",1,0],["يا من غفرنا ذنوبَ الحادثات به","وكلها ليس لولاه بمغتفرِ",69,"ر",1,0],["يا من غنيتُ بوصفهِ عن ذكرهِ","افخر فمالكَ في الوفاءِ كفيحُ",70,"ح",1,0],["يا من غدا فرداً فقي","د المثل في آدابه",71,"ب",2,1],["يا من غدت من بعده ال","دنيا مولَّهةً عقيمه",72,"م",2,0],["يا من غدوتُ ولي منهم مقابلةٌ","بالقربِ بُعدٌ وبالتّذكارِ نسيانُ",73,"ن",1,0],["يا مَن غَدَوتُ مُقَيَّداً بِجَميلِهِ","يَفديكَ مَن قَيَّدتَهُ فَتَقَيَّدا",74,"د",2,0],["يا من غدت أخلاقه مثل اسمه","إني لروض علاك نعم البلبل",75,"ل",1,1],["يا من غدت نعمى يدي","ه لفارط الآمال وردا",76,"د",2,0],["يا من غدا القلب مشغولاً بصحبتكم","وحرمت نومها عيني بصبوتكم",77,"م",1,1],["يا من غدا واقفاً في باب صحبتنا","يبغي الدخول ولم يأذن له أحدُ",78,"د",1,1],["يا من غدا سابقاً في كل مكرمةٍ","ودون رتبته الغايات والرتب",79,"ب",1,1],["يا من غدا مبسم العلياء مبتسماً","بعدله وقوام الدهر معتدلا",80,"ل",2,0],["يا مَن غدا يَسعى لإدراكِ المُنى","مُجتدِياً الى المعارفِ هَفا",81,"ا",1,0],["يا مَن غدا على سُرادِقَاتِ","مشن عِزِّهِ مُحتَجِباً بذاتِ",82,"ت",1,0],["يا من غدت أوجه الأيام مشرقة","بجوده مستهلات منيرات",83,"ت",1,0],["يا مَن غَدا كَرَماً عَلى دَربٍ وَمَن","قَد أَخجَل السُحب الغَوادي جُودا",84,"د",2,0],["يا مَن غَدوا وَلَهُم في دارهم صَخَبٌ","أَضَعتُم الوَقت في شغبِ وَإِضجاج",85,"ج",1,0],["يا من غدت فيه أحوالي منشرةً","مختلةً غير مرجو تلافيها",86,"ه",2,1],["يا من غدا قلبه بالشوق مستلبا","كالغصن أمسى لعصف الريح مضطربا",87,"ب",2,1],["يا من غدت بالاسم رمز جهادنا","شخص الجميع إليك بالأحداق",88,"ق",1,0],["يا من غدت فضله الأنبا مترجمةً","يا من له الكوثر الفياض مكرمةً",89,"ه",1,0],["يا من غدا مُشابهي في أدبي","قد رمت ان تُخرج تبرا من تراب",90,"ب",1,1],["يا من غدا طالباً منّي الإجازة في","نظم القريضُ وتعظيما لطالبها",91,"ه",2,1],["يا من غدا كلُّ لفظي فيه من طمع","شكوى وأيّ شكاة ليّنت جبلا",92,"ل",2,0],["يا من غدا لعلوم الناس منتحلا","ويحتمي عن سؤال العلم بالشمم",93,"م",1,1],["يا من غدا متماديا في جهله","أيطيب عيشك والمنون وراكا",94,"ك",2,0],["يا مَن غدت شرفاً عندي محبتهُ","نعم محبتهُ عندي هي الشرفُ",95,"ف",1,0],["يا مَنْ غَدا أَقرانُ شَمْسِ الضَّحَى","يَشْهَدُ بِالفْضْلِ لَهُ وَالْقَمَرْ",96,"ر",1,1],["يا من غدا جبلُ الجوديَّ يحجبه","ليس التذكر عن قلبي بمحجوب",97,"ب",1,1],["يا من غدا ثوبه نظيفاً","وقلبه لم يفز بنور",98,"ر",1,1],["يا من غدا لفظ راجيه لمسمعه","كأنما هو بشرى بهجة وطرب",9