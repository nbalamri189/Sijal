{"poems":[[93,"لو رأى آدم فتاه لزال الحقد","https://www.aldiwan.net/poem8729.html","عموديه"],[8,"هل بالديار الغداة من صمم","https://www.aldiwan.net/poem21838.html","المنسرح"],[240,"يا عماد الدين يا من","https://www.aldiwan.net/poem31957.html","مجزوء الرمل"],[266,"ربع أسماء لا عداك عنان","https://www.aldiwan.net/poem38168.html","الخفيف"],[449,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[563,"إنما وحدة الوجود لدينا","https://www.aldiwan.net/poem34218.html","الخفيف"],[580,"أخبروني عن مرهف القد مطبو","https://www.aldiwan.net/poem2698.html","الخفيف"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96700","المتدارك"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93778","الخفيف"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95335","الرجز"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95337","الرجز"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69905","الرمل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94785","الرمل"],[4767,"ههنا كربلاء","https://www.poetsgate.com/ViewPoem.aspx?id=197295",""],[5582,"أَشَجاكَ لِعاتِكَةٍ طَلَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=63553",""]],"verses":[["وَهوَ طَوراً يَكونُ نِصفَ إِلَهٍ","وَهوَ طَوراً أَدنى مِنَ العَجماءِ",0,"ا",2,0],["وَهوَ طَوِيلُ الجِرانِ مُدَّ بِلَح","ييِه وَلَم يأزَما عَلى كَزَمِ",1,"م",1,0],["وَهوَ طيبٌ وَذَكاءٌ","مِن سَجاياكَ عَصيرُ",2,"ر",1,0],["وهو طوق يشق عن كل بدر","فوق غصن من تحته الكثبان",3,"ن",1,0],["وهو طورا يرتقي بعض الفلل","ثم يطوي تارة بعض البطاح",4,"ح",1,0],["وهو طهر الأرواح من نجس قد","حلَّ فيها من الكثيف يجول",5,"ل",1,0],["وهو طوراً مركَّب وَبَسيطٌ","وهُوَ طوراً مفارقٌ ومُجَسَّم",6,"م",1,0],["وهو طفل شَيْخُ وهذا عجيبٌ","وهو فردٌ زوجٌ وهذا مسلَّم",6,"م",1,0],["وَهو طودُ حجىً وهو بحر ندىً","وَهو شمسُ هدىً ما لها أصلُ",7,"ل",1,0],["وهو طه أجل آل لؤي","من به التاج يزدهي واللواء",8,"ا",2,0],["وهو طويل وطُوال جاءَ","وخالد أحذيته إحذاءَ",9,"ا",2,0],["وهو طعام جيد له نَزَل","موعده عَشرة من ذي قبَل",10,"ل",1,0],["وَهُوَ طلّاع الثَنايا","مخجلٌ بَدرَ الدُجى",11,"ج",2,0],["وهو طلّاعُ الثنايا عبقري","ناعمُ الأَخلاقِ هشُّ المكسَرِ",12,"ر",1,0],["وهو طوق النجاة ما ثارَ بحرٌ","بين مَن فيه يَندُرُ الأسوياء",13,"ا",2,0],["وَهوَ طَوْدُ حِجا وَهوَ بَحْرُ نَدَى","وَهوَ شَمْسُ هُدَى ما لَها أُصُلُ",14,"ل",1,0]]}