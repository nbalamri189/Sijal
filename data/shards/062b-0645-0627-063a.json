{"poems":[[79,"النصر نصك والحسام دليله","https://www.aldiwan.net/poem36377.html","الكامل"],[95,"جاء الكتاب وأصدق","https://www.aldiwan.net/poem11242.html","المجتث"],[53,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[45,"أجاب دمعي وما الداعي سوى طلل","https://www.aldiwan.net/poem9943.html","البسيط"],[68,"ثقتي بغير هواكم لا تحدث","https://www.aldiwan.net/poem38498.html","الكامل"],[46,"سلم على الربع من سلمى بذي سلم","https://www.aldiwan.net/poem30364.html","البسيط"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62279","البسيط"],[45,"أَجابَ دَمعي وَما الداعي سِوى طَلَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=137",""],[190,"في كل منقلب غيظ أساء به","https://www.aldiwan.net/poem43798.html","البسيط"],[208,"بات الحبيب منادمي","https://www.aldiwan.net/poem52994.html","مجزوء الكامل"],[254,"بان الخليط ولم يوفوا بما عهدوا","https://www.aldiwan.net/poem2122.html","البسيط"],[276,"طيف الخيال من النيابتين سرى","https://www.aldiwan.net/poem52115.html","البسيط"],[295,"بلبل في الرياض يلهمه الوحي","https://www.aldiwan.net/poem11715.html","الخفيف"],[302,"يا حادي الظعن إن جزت المواقيتا","https://www.aldiwan.net/poem33317.html","البسيط"],[333,"في طريق يحفه الزهر النضر","https://www.aldiwan.net/poem54972.html","الخفيف"],[396,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[449,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[545,"إني امرؤ من رعى عيني رعيت له","https://www.aldiwan.net/poem56645.html","الوافر"],[563,"هي قامت بنفسها لذويها","https://www.aldiwan.net/poem33637.html","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70754","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/20030","الكامل"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133871","السريع"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45455","البسيط"],[2744,"","https://poetry.dctabudhabi.ae/diwan/poem/130300","البسيط"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115688","المديد"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111494","الكامل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93302","السريع"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21584","الكامل"],[5885,"البئر قد جف","https://www.poetsgate.com/ViewPoem.aspx?id=203025",""],[5894,"ثبت الغرام وفي فؤادي يحدث","https://www.poetsgate.com/ViewPoem.aspx?id=131413",""]],"verses":[["ثُمَّ اغْتَدَيْتَ وَمُلْكُكَ السَّامِي الْعُلَى","مَجْمُوعُ شَمْلٍ بِالْمُنَى مَوْصُولُهُ",0,"ل",2,0],["ثُمَّ اغْتَدَى وَهْوَ خَالٍ","مِنْهَا لَدَى النَّاظِرِينَا",1,"ن",2,0],["ثم اغتدى مُتَبرِّئاً","من ذاك يَنْحَلُهُ صِحابهْ",2,"ب",2,0],["ثُمَّ اِغتَدى وَبِهِ مِن رَدعِها أَثَرٌ","عَلى ذُؤابَتِهِ وَالجَفنِ وَالخِلَلِ",3,"ل",1,0],["ثُمَّ اِغتَدَت أَيدي اِبنِ أَرتَقَ قِصَّتي","كُلٌّ بِها بَينَ الأَنامِ يُحَدَّثُ",4,"ث",1,0],["ثُمَّ اِغتَدى وَبِنا مِن ذِكرِهِ سَقَمٌ","باقٍ وَإِن كانَ مَشغولاً عَنِ السَقَمِ",5,"م",1,0],["ثُمَّ اغْتَرَزْتُ عَلَى نَضْوِي لأبْعَثَهُ","إِثْر الحُمُولِ الغَوَادِي وهْوَ مَعْقُولُ",6,"ل",1,0],["ثُمَّ اغتَدى وَبِهِ مِن دِرعِها أَثَرٌ","عَلى ذُؤابَتِهِ وَالجَفنِ وَالخِلَلِ",7,"ل",1,0],["ثم اغتدى بين هذا النشء أتبعهُ","جهّالهم وتأوى قلبه الحذر",8,"ر",1,0],["ثم اغتدى وقد ابتدا","صبغ الخمار بمقلتَيهِ",9,"ي",2,0],["ثُمَّ اِغتَرَرتُ عَلى عَنسٍ عُذافِرَةٍ","سِيٌّ عَلَيها خَبارُ الأَرضِ وَالجَدَدُ",10,"د",1,0],["ثم اِغتَسَلنا وأحرمنا وَساربنا","حادى المطى يَخوض الهَول وَالخَطرا",11,"ر",2,0],["ثم أغفى وودّعَ النايَ والشعر","وولّى الشبابُ في عنفوانه",12,"ن",2,0],["ثُمَّ اِغتَدى قاضياً من حجِّه تَفَثاً","يَرجو لتزكيةِ الأَعمالِ تَزكيتا",13,"ت",2,0],["ثم أغرى به رياح المقادي","ر فسوّت سهوله وحزونه",14,"ه",1,0],["ثم اغسل يديك وابلغ في العضد منتهاه","ثم امسح الرأس واحسن غسل رجلك وراه",15,"ا",2,0],["ثم أغفى لحظة فيها سرى","طيف من طبق أطراف البلاد",16,"د",1,0],["ثُمَّ اِغتَدَوا وهم دُسمٌ شواربُهُم","وَلَم يَبيتوا عَلى ضَيحٍ من اللَبَنِ",17,"ن",1,0],["ثم أغنى بحكمه الشرع عنه","حيث أن التوحيد بالعقل عيها",18,"ي",3,0],["ثم أغنيْتَ ذا الخَصاصةٍ بالما","لِ وفُقتَ الملوك جنداً وبَزَّا",19,"ز",2,0],["ثم اغلهِ بالرفقِ ثم صَفِّهِ","من مئزر أو ما ترى من صنفه",20,"ه",1,0],["ثُمَّ اِغتَدى وَرِداوُّهُ نعِمٌ","أَسدَيتُها وَرِدائِيَ الحَمدُ",21,"د",1,0],["ثم اغتسلوا شعر اللحى بعدها","غسل الدرابيك أو القطف",22,"ف",1,0],["ثُمَّ أَغَبَّت بَعدَهُ قَليلا","فَوَضَعَت مُتئِمَةً هابيلا",23,"ل",2,0],["ثُمَّ اِغتَدَت وَغَدا نِزُّ مُلازِمها","إِصعادُهُ كَهَواهُ راهِبٌ راجي",24,"ج",2,0],["ثم اغتنم فرصة من قبل أن ضعفت","قواك من سطوة الأمراض والعلل",25,"ل",1,0],["ثم أغفى وهو نعتقد","أنه من أعقل العقلا",26,"ل",2,0],["ثُمَّ اغتَدى لِطَعامِهِ وَهُنَاكَ ضا","في الدَّنِّ بالخَمرِ الشَّهِيَّةِ مُترَعُ",27,"ع",1,0],["ثم اغتدى يقنِصُني نافراً","يا عَجَباً لِلْقانص النّافر",28,"ر",1,0],["ثُمَ اغتَدى ورِداؤُهُ نِعَمٌ","أسأرتُها ورِدائي الحَمدُ",29,"د",1,0],["ثم اغرقوا فيها ومدوا يدا","حتى تثور الموجة الراكدة",30,"د",2,0],["ثم اغتنم للشكر من كل الورى","واترك عداك بسم سيفك تنفث",31,"ث",1,0]]}