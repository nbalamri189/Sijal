{"poems":[[87,"إلى عرفات الله يا خير زائر","https://www.aldiwan.net/poem63776.html","الطويل"],[48,"تجنب حانة الصهبا","https://www.aldiwan.net/poem23111.html","الهزج"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138439",""],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45027","الطويل"]],"verses":[["فَقُل رَبِّ وَفِّق لِلعَظائِمِ أُمَّتي","وَزَيِّن لَها الأَفعالَ وَالعَزَماتِ",0,"ت",1,0],["فَقُل رَوحَكَ مَّولانا","لِراجيكَ وَريحانَك",1,"ك",1,0],["فقل ربي غدا جرمي كوقر","ينوء به يقينا منكبايا",2,"ا",3,0],["فَقُل رَبِّ أَيِّد سَعيَهُ بإعانَة","تُسَرّ بِها أَجنادُهُ وَكَتائِبُه",3,"ب",2,0]]}