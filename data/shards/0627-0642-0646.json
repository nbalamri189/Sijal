{"poems":[[53,"أترى السحاب إذا سرت عشراؤه","https://www.aldiwan.net/poem30778.html","الكامل"],[47,"أقناعة من بعد طول جفاء","https://www.aldiwan.net/poem25382.html","الكامل"],[23,"إقني حياءك في عز وفي كرم","https://www.aldiwan.net/poem21637.html","البسيط"],[78,"اقنع بحظك في دنياك ما كانا","https://www.aldiwan.net/poem14235.html","البسيط"],[89,"ذهبت ايام الشباب سراعا","https://www.aldiwan.net/poem44894.html","الخفيف"],[31,"يا صاحبي قفا نستخبر الطللا","https://www.aldiwan.net/poem41850.html","البسيط"],[40,"إن الحبيب تروحت أجماله","https://www.aldiwan.net/poem42316.html","الكامل"],[48,"يا رب غيث آمن السروب","https://www.aldiwan.net/poem62457.html","الرجز"],[46,"إقنع بأيسر شيء فالزمان له","https://www.aldiwan.net/poem22244.html","البسيط"],[46,"إقنع بما رضي التقي لنفسه","https://www.aldiwan.net/poem22285.html","الكامل"],[100,"بيتٌ مِن الرِّيح","https://www.poetsgate.com/ViewPoem.aspx?id=183581",""],[46,"اقنعْ بما رضيَ التّقيُّ لنفسِهِ،","https://www.poetsgate.com/ViewPoem.aspx?id=18275",""],[51,"أجنتْ لك الوجدَ أغصانٌ وكثبانُ","https://www.poetsgate.com/ViewPoem.aspx?id=25836",""],[229,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[233,"هل أنت يا أخت القضيب الناضر","https://www.aldiwan.net/poem31983.html","الرجز"],[280,"في خد من أهواه خير طراز","https://www.aldiwan.net/poem32740.html","الكامل"],[391,"في أحضان الطبيعة","https://www.aldiwan.net/poem24309.html","عموديه"],[438,"أقنع بما أنا فيه منه أقاسي","https://www.aldiwan.net/poem14374.html","الكامل"],[438,"شهدت بإخلاصي عذول قرائحي","https://www.aldiwan.net/poem14422.html","الكامل"],[441,"اقنع من الدنيا بما","https://www.aldiwan.net/poem55983.html","عموديه"],[462,"بنحول خصرك والوشاح الجائل","https://www.aldiwan.net/poem3553.html","عموديه"],[565,"كلي إلى اللوم غيري ربة الكله","https://www.aldiwan.net/poem69555.html","البسيط"],[573,"قتلي لحبكم شهادة","https://www.aldiwan.net/poem3076.html","مجزوء الكامل"]],"verses":[["أَقني الحَياءَ تَجَمُّلاً لَو أَنَّهُ","يَبقى مَعَ الدَمعِ اللَجوجِ حَياؤُهُ",0,"ا",3,0],["أَقَناعَةً مِن بَعدِ طولِ جَفاءِ","بِدُنُوِّ طَيفٍ مِن حَبيبٍ ناءِ",1,"ا",2,1],["إِقنَي حَياءَكَ في عِزٍّ وَفي كَرَمٍ","فَإِنَّما كانَ شَمّاسٌ مِنَ الناسِ",2,"س",1,1],["اِقنَع بِحَظِك في دُنياكَ ما كانَا","وَعَزِّ نَفسِكَ إِن فارَقت أَوطانا",3,"ن",2,1],["اقنعت نفسي بالبقاء ضميري","ولعقلي لم تستطع اقناعا",4,"ع",2,0],["إِقني حَياءَكِ في سِترٍ وَفي كَرَمٍ","فَلَستَ أَوَّلَ أُنثى عُلِّقَت رَجُلا",5,"ل",2,0],["إِقنِ الحَياءَ فَقَد بَكَيتَ بِعَولَةٍ","إِن كانَ يَنفَعُ باكِياً إِعوالُهُ",6,"ل",2,0],["أَقنى إِلى سائِسَةٍ جَنيبِ","وَقَد جَرى مِنهُ عَلى تَأديبِ",7,"ب",1,0],["إِقنَع بِأَيسَرِ شَيءٍ فَالزَمانُ لَهُ","مَحيلَةٌ لا تُقَضّى عِندَها الحِوَجُ",8,"ج",1,1],["إِقنَع بِما رَضِيَ التَقِيُّ لِنَفسِهِ","وَأَباحَهُ في الحَياةِ مُبيحُ",9,"ح",1,1],["أَقنَصُ الطَّلْقاتِ عَنكَ احتَرَفَت","المَنايا كالمُنى يَعشَقنَ مُزحَك",10,"ك",1,0],["اقنعْ بما رضيَ التّقيُّ لنفسِهِ،","وأباحَهُ لك، في الحياةِ، مبيحُ",11,"ح",1,1],["أقْنَوْا عداهُمْ وأقنوا من يؤملهم","ففي الصدور لهمْ شكرٌ وأضغان",12,"ن",1,0],["أَقنى يَلوحُ النُّور مِن عرنينِهِ","حُلو المَياسِمِ أَشنَبُ الأَسنانِ",13,"ن",1,0],["أَقنَعُ مِن وَفائِهِ وَوُدِّهِ","أَن يَتَلَقّاني بِثَغرٍ كاشِرِ",14,"ر",1,0],["أَقنى وَأَفنى ما لَهُ لِعُفاتِهِ","وَسِواهُ رَبُّ مَخازِنٍ وَمَخازي",15,"ي",1,0],["اقنعوا باكتآبكم واعشقوا الفنّ","وعيشوا في عزلة الأنبياء",16,"ا",2,0],["اقنعوا من حياتكم بهوى الفنّ","وسحر الطبيعة المعبود",16,"د",1,0],["أقنع بما أنا فيه منه أقاسي","يا دهر أحداثاً بغير قياس",17,"س",1,1],["اقنع تجل وَإن طمعت تقل أَو","تخضع تذل ولا تكن بالشاجع",18,"ع",1,0],["اقنع من الدنيا بما","اعطت ودع عنك الطمع",19,"ع",1,1],["إقني حياءك إنَّ نشر معارفي","ما بين طيّ تنائفٍ ومجاهل",20,"ل",1,0],["أَقْنِي الحَيَاءَ فَأَسْتَغْنِي بِهِ وَإِذَا","أَغَلَّ قَوْمٌ فَحُسْنُ الصَّبْرِ لِي غَلَّهْ",21,"ل",2,0],["أَقْنَاه ذاك الجودَ ح","تى من يعانده وزاده",22,"د",2,0]]}