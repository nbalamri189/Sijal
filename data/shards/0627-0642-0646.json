{"poems":[[55,"أترى السحاب إذا سرت عشراؤه","https://www.aldiwan.net/poem30778.html","الكامل"],[49,"أقناعة من بعد طول جفاء","https://www.aldiwan.net/poem25382.html","الكامل"],[23,"إقني حياءك في عز وفي كرم","https://www.aldiwan.net/poem21637.html","البسيط"],[80,"اقنع بحظك في دنياك ما كانا","https://www.aldiwan.net/poem14235.html","البسيط"],[91,"ذهبت ايام الشباب سراعا","https://www.aldiwan.net/poem44894.html","الخفيف"],[33,"يا صاحبي قفا نستخبر الطللا","https://www.aldiwan.net/poem41850.html","البسيط"],[42,"إن الحبيب تروحت أجماله","https://www.aldiwan.net/poem42316.html","الكامل"],[50,"يا رب غيث آمن السروب","https://www.aldiwan.net/poem62457.html","الرجز"],[48,"إقنع بأيسر شيء فالزمان له","https://www.aldiwan.net/poem22244.html","البسيط"],[48,"إقنع بما رضي التقي لنفسه","https://www.aldiwan.net/poem22285.html","الكامل"],[102,"بيتٌ مِن الرِّيح","https://www.poetsgate.com/ViewPoem.aspx?id=183581",""],[48,"اقنعْ بما رضيَ التّقيُّ لنفسِهِ،","https://www.poetsgate.com/ViewPoem.aspx?id=18275",""],[53,"أجنتْ لك الوجدَ أغصانٌ وكثبانُ","https://www.poetsgate.com/ViewPoem.aspx?id=25836",""],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[240,"هل أنت يا أخت القضيب الناضر","https://www.aldiwan.net/poem31983.html","الرجز"],[287,"في خد من أهواه خير طراز","https://www.aldiwan.net/poem32740.html","الكامل"],[399,"في أحضان الطبيعة","https://www.aldiwan.net/poem24309.html","عموديه"],[447,"أقنع بما أنا فيه منه أقاسي","https://www.aldiwan.net/poem14374.html","الكامل"],[447,"شهدت بإخلاصي عذول قرائحي","https://www.aldiwan.net/poem14422.html","الكامل"],[449,"اقنع من الدنيا بما","https://www.aldiwan.net/poem55983.html","عموديه"],[469,"بنحول خصرك والوشاح الجائل","https://www.aldiwan.net/poem3553.html","عموديه"],[572,"كلي إلى اللوم غيري ربة الكله","https://www.aldiwan.net/poem69555.html","البسيط"],[580,"قتلي لحبكم شهادة","https://www.aldiwan.net/poem3076.html","مجزوء الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122658","الطويل"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123400","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120049","المنسرح"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65082","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46508","الرجز"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69348","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27714","المنسرح"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104987","الكامل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45698","السريع"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76027","الرجز"],[2744,"","https://poetry.dctabudhabi.ae/diwan/poem/130300","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202930","الرجز"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100790","الطويل"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99353","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108252","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110064","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91098","البسيط"],[3727,"","https://poetry.dctabudhabi.ae/diwan/poem/124073","الخفيف"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54391","المجتث"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54401","السريع"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54490","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94423","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73184","السريع"],[4697,"ودعتها","https://www.poetsgate.com/ViewPoem.aspx?id=22681",""],[4727,"السيف أقطعُ أحياناً مِن الخشبِ","https://www.poetsgate.com/ViewPoem.aspx?id=208920",""],[4797,"ذالليل كن نجومه شوي واشتات","https://www.poetsgate.com/ViewPoem.aspx?id=132228",""],[4978,"حوّلتها بعد حَوْزٍ عن مسمّاها","https://www.poetsgate.com/ViewPoem.aspx?id=177252",""],[4978,"تشطير مصر البهية","https://www.poetsgate.com/ViewPoem.aspx?id=177253",""],[4988,"مدرسة دنياي","https://www.poetsgate.com/ViewPoem.aspx?id=214087",""],[5122,"أصبر وأصابر","https://www.poetsgate.com/ViewPoem.aspx?id=31511",""],[5145,"اقنع تعزّ وخير القول أحكمه","https://www.poetsgate.com/ViewPoem.aspx?id=108249",""],[5436,"نصيحة صادقة ( أيمن أحمد رؤوف القادري )","https://www.poetsgate.com/ViewPoem.aspx?id=35264",""],[5616,"خريف","https://www.poetsgate.com/ViewPoem.aspx?id=203470",""],[5739,"عيون حظ ٍ مفلسه ..!","https://www.poetsgate.com/ViewPoem.aspx?id=127068",""],[5956,"شكراً لتلفاز الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=193473",""],[5956,"أرجوك لا تمرض","https://www.poetsgate.com/ViewPoem.aspx?id=193797",""],[5956,"كل تقصير لديهم بأداء الضَّخِ","https://www.poetsgate.com/ViewPoem.aspx?id=194199",""],[6056,"شمس حبي","https://www.poetsgate.com/ViewPoem.aspx?id=130140",""],[6124,"أقنعة","https://www.poetsgate.com/ViewPoem.aspx?id=159338",""],[572,"كِلي إلى اللّومِ غيري رَبّة َ الكِلّهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9439&r=&rc=296",""]],"verses":[["أَقني الحَياءَ تَجَمُّلاً لَو أَنَّهُ","يَبقى مَعَ الدَمعِ اللَجوجِ حَياؤُهُ",0,"ا",3,0],["أَقَناعَةً مِن بَعدِ طولِ جَفاءِ","بِدُنُوِّ طَيفٍ مِن حَبيبٍ ناءِ",1,"ا",2,1],["إِقنَي حَياءَكَ في عِزٍّ وَفي كَرَمٍ","فَإِنَّما كانَ شَمّاسٌ مِنَ الناسِ",2,"س",1,1],["اِقنَع بِحَظِك في دُنياكَ ما كانَا","وَعَزِّ نَفسِكَ إِن فارَقت أَوطانا",3,"ن",2,1],["اقنعت نفسي بالبقاء ضميري","ولعقلي لم تستطع اقناعا",4,"ع",2,0],["إِقني حَياءَكِ في سِترٍ وَفي كَرَمٍ","فَلَستَ أَوَّلَ أُنثى عُلِّقَت رَجُلا",5,"ل",2,0],["إِقنِ الحَياءَ فَقَد بَكَيتَ بِعَولَةٍ","إِن كانَ يَنفَعُ باكِياً إِعوالُهُ",6,"ل",2,0],["أَقنى إِلى سائِسَةٍ جَنيبِ","وَقَد جَرى مِنهُ عَلى تَأديبِ",7,"ب",1,0],["إِقنَع بِأَيسَرِ شَيءٍ فَالزَمانُ لَهُ","مَحيلَةٌ لا تُقَضّى عِندَها الحِوَجُ",8,"ج",1,1],["إِقنَع بِما رَضِيَ التَقِيُّ لِنَفسِهِ","وَأَباحَهُ في الحَياةِ مُبيحُ",9,"ح",1,1],["أَقنَصُ الطَّلْقاتِ عَنكَ احتَرَفَت","المَنايا كالمُنى يَعشَقنَ مُزحَك",10,"ك",1,0],["اقنعْ بما رضيَ التّقيُّ لنفسِهِ،","وأباحَهُ لك، في الحياةِ، مبيحُ",11,"ح",1,1],["أقْنَوْا عداهُمْ وأقنوا من يؤملهم","ففي الصدور لهمْ شكرٌ وأضغان",12,"ن",1,0],["أَقنى يَلوحُ النُّور مِن عرنينِهِ","حُلو المَياسِمِ أَشنَبُ الأَسنانِ",13,"ن",1,0],["أَقنَعُ مِن وَفائِهِ وَوُدِّهِ","أَن يَتَلَقّاني بِثَغرٍ كاشِرِ",14,"ر",1,0],["أَقنى وَأَفنى ما لَهُ لِعُفاتِهِ","وَسِواهُ رَبُّ مَخازِنٍ وَمَخازي",15,"ز",2,0],["اقنعوا باكتآبكم واعشقوا الفنّ","وعيشوا في عزلة الأنبياء",16,"ا",2,0],["اقنعوا من حياتكم بهوى الفنّ","وسحر الطبيعة المعبود",16,"د",1,0],["أقنع بما أنا فيه منه أقاسي","يا دهر أحداثاً بغير قياس",17,"س",1,1],["اقنع تجل وَإن طمعت تقل أَو","تخضع تذل ولا تكن بالشاجع",18,"ع",1,0],["اقنع من الدنيا بما","اعطت ودع عنك الطمع",19,"ع",1,1],["إقني حياءك إنَّ نشر معارفي","ما بين طيّ تنائفٍ ومجاهل",20,"ل",1,0],["أَقْنِي الحَيَاءَ فَأَسْتَغْنِي بِهِ وَإِذَا","أَغَلَّ قَوْمٌ فَحُسْنُ الصَّبْرِ لِي غَلَّهْ",21,"ل",2,0],["أَقْنَاه ذاك الجودَ ح","تى من يعانده وزاده",22,"د",2,0],["أقَنِّعُ عَنهُ النَّفسَ خَوفَ فِراقِهِ","عَلَى أنَّ وجهَ الصُّبحِ لا يَتَقَنَّع",23,"ع",1,0],["اِقْنَعْ بجِيدٍ عاطلٍ وانْظِم له","عِقْدَ الصَّلاحِ فكلُّ حالٍ حالمُ",24,"م",1,0],["أقنى لهي بعضها أقام لنا","ما في قناة الإعدام من عوجِ",25,"ج",1,0],["اقْنَعْ بأَيْسرِ مَيسورٍ مِنَ الزَّمنِ","واشْكرْ لربِّكَ ما أَولاكَ مِن مِنَنِ",26,"ن",1,1],["إقنع إِذا حارَبتَ بِالسلامة","وَاحذر فعالاً توجب الندامة",27,"ه",1,0],["أَقناهُمُ مالا يَبيدُ وَقابَلوا","ذاكَ الفَعالَ بِمِثلِهِ فَأَصابُوا",28,"ب",3,0],["أقنع بما قد جرى به تسلمي","فإنه ما استقرَّ بي قدمي",29,"م",2,1],["اقنع بلقيا ساعة","فالصب يرضيه القليل",30,"ل",1,0],["أَقنّب ما اِمتَدَ في اِصبَعي","أَم حَية في وسطها نائمه",31,"م",2,0],["أقنعُ مِن حَديثكُم","وَأنسِكُم بِما اِتَّفَق",32,"ق",1,0],["اقنع من العيش بالأدنى وكن ملكاً","إن القناعة كنز عنك لم يزل",33,"ل",1,0],["أقنعني السنّ بما","قد كنت منه أهرب",34,"ب",1,0],["اقنع بالتوحيد من كان مشركاً","فلولاه ساءت للعباد ظنون",35,"ن",1,0],["أقنطرة النوبندجان وديرها","وحور مهى لا تألف الحور غيرها",36,"ه",2,1],["أقنع ولكن بخذل المقنعين لهم","تكفلت فلسفات اللؤم والحكم",37,"م",1,0],["أُقنومُهُ فَذٌّ وليسَ بِتَوأَم","وكِلا الطبيعةِ والمشيئَةِ تَوأَمُ",38,"م",1,0],["أَقنَعتُ نَفسي بِحال لَيس تَنزل بي","أسّ الحَضيض وَلا تَعلو إِلى الشُهب",39,"ب",1,0],["أقنوطاً وللمهيمن رحمى","فيضها ما ان يعتريه السكون",40,"ن",1,0],["اقْنِ الثناءَ وأَقنِ الثَّ","راءَ وانفِ العارْ",41,"ر",1,0],["إقنعْ ولا تطمعْ فإنَّ الفتى","كمالهُ في عزَّةِ النّفسِ",42,"س",1,1],["أَقَنعْتَ من بَرْقِ الحِمَى سَحَراً","ونسيمهِ بالشّيمِ والشمِّ",43,"م",1,0],["أقناسها رهط آدابٍ وقد جَمَعت","أذهانهم كل أفنونٍ بأسفارِ",44,"ر",1,0],["أقنى بقَدَّ مثلِ سُمرِ القَنا","ليناً وخدِّ من دمِ الصَّب قان",45,"ن",1,0],["اقنب كما ذيبٍ تقفاه جوعي","لامن ذكرت فراق حلو الطباعي",46,"ع",2,0],["أقنِ الحَياْء فَشكوى كُلِّ مُرْتَهَنِ","إلى اللئامِ كوقعِ القَطْرِ في التُّرَبِ",47,"ب",1,0],["اقنعني العقل بكلام ودلالات","اني على درب الخطا والمهابيل",48,"ل",1,0],["أقنعتها أنها حلْمٌ تعيش له ؟","وأن عمرك صفرا كان لولاها",49,"ا",3,0],["( أقنعتنا أنا لآدم ننتمي )","( لا للأرانب فكرةً ونفوسا )",50,"س",2,0],["اقنع وحاسب من بلا كل خناس","درب الردى لاهله وب اهله رجاجه",51,"ج",2,0],["أقنعتني وأقتنعت بفنك الباهر","ونقضت جرح(ن)، قديم كان مدامل",52,"ل",1,0],["اقنع تعزّ وخير القول أحكمه","إن القناعة مال لست تعدمه",53,"ه",1,1],["أَقْنَعْتُهُمْ أَنّي جُنِنْتُ فَأَحْكَمُوا","بابي، وخَلْفَ البابِ رُكْنٌ ضَيِّقُ",54,"ق",1,0],["أقنص الفكرة المضيئة حتى","أتملى جمالها الموصوفا",55,"ف",2,0],["أقنعه بالحب ....... غطاها النقاب.","كم قناع ٍ .. شفت وجهه يلبسه.",56,"س",2,0],["أقنعتني أنْ لا لقا","وأنا بِهِ لن أقنعكْ..",57,"ك",1,0],["أقني لمملكتي هياماً صارخاً","وأعيش من شوقي لها بهياجِ",58,"ج",1,0],["أقنِعاتُ الوجه تَعْرَى ساعة الشدَّ","ةِ تُعْلي صادقاً لا مُسْتعارا",59,"ر",2,0],["أقنعيهم قولي عذر ٍ منطقي","قبل مااموت بغرامه ، مات فيني",60,"ن",2,0],["أقنعةٌ من وردٍ","تخفي أنسجةَ النارِ وخيطَ دما.",61,"م",2,0],["أقنى الحَيَاءَ فأستَغْنِي بهِ فإذا","أعلَّ قومٌ بِحُسْنِ الصّبرِ لي علّهْ",62,"ل",2,0]]}