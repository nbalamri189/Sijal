أدرك ما شاء غلام فطنا","https://www.aldiwan.net/poem55840.html","الرجز"],[459,"لمن الطلول كأنهن رقوم","https://www.aldiwan.net/poem55864.html","الكامل"],[459,"ذكر العيش بالحمى فبكى له","https://www.aldiwan.net/poem55940.html","الخفيف"],[459,"بالله ثم بالله","https://www.aldiwan.net/poem55953.html","مجزوء الرجز"],[459,"تمنى رجال أن تزل بي النعل","https://www.aldiwan.net/poem55997.html","الطويل"],[459,"أحقا يا أبا نصر فترجى","https://www.aldiwan.net/poem56074.html","الوافر"],[459,"إذا لم أحظ منك على التلاقي","https://www.aldiwan.net/poem56089.html","الوافر"],[459,"هبت ومنها الخلاب والخدع","https://www.aldiwan.net/poem56139.html","المنسرح"],[459,"لو كنت تبلو غداة السفح أخباري","https://www.aldiwan.net/poem56179.html","البسيط"],[459,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[459,"قل للزمان صلحا","https://www.aldiwan.net/poem56249.html","مجزوء الرجز"],[459,"من الغادي تحط به وتعلو","https://www.aldiwan.net/poem56250.html","الوافر"],[459,"أَستنجِد الصبر فيكم وهو مغلوب","https://www.aldiwan.net/poem56300.html","البسيط"],[462,"علقته والصبا غض الأديم","https://www.aldiwan.net/poem15087.html","الرمل"],[462,"يفر الخطب قد أمهي شباه","https://www.aldiwan.net/poem16107.html","الوافر"],[465,"وأغن ساجي الطرف أغيد","https://www.aldiwan.net/poem3324.html","عموديه"],[465,"أصمت فؤادي مقلتاه باسهم","https://www.aldiwan.net/poem3482.html","عموديه"],[465,"وقد أخضب الدمع فاكفف رائد النظر","https://www.aldiwan.net/poem3578.html","عموديه"],[465,"شاق الحمام برامتين فغردا","https://www.aldiwan.net/poem3584.html","عموديه"],[467,"يا ثور لا تشتمن عرضي فداك أبي","https://www.aldiwan.net/poem50422.html","البسيط"],[478,"هل بعد وصالك من وطر","https://www.aldiwan.net/poem15256.html","الوافر"],[478,"لما استحث حداة الجيرة الابلا","https://www.aldiwan.net/poem15257.html","البسيط"],[480,"أرقت وما غير الشجون سمير","https://www.aldiwan.net/poem37571.html","الكامل"],[496,"علقت ظبيا غنجا","https://www.aldiwan.net/poem9809.html","مجزوء الرجز"],[507,"لا وأعطاف الغصون الميس","https://www.aldiwan.net/poem2456.html","الوافر"],[507,"ألا هل نسيم للرصافي مبلغ","https://www.aldiwan.net/poem2464.html","الطويل"],[507,"علقته كالسيف راع بهاؤه","https://www.aldiwan.net/poem2466.html","الكامل"],[511,"يا ليلة حتى الصباح سهرتها","https://www.aldiwan.net/poem1575.html",""],[515,"سفرت فبرقعها حجاب جمال","https://www.aldiwan.net/poem20814.html","الكامل"],[515,"نظر البدر وجهها فتلاها","https://www.aldiwan.net/poem20822.html","الخفيف"],[515,"حيدري عم نائله","https://www.aldiwan.net/poem20843.html","المديد"],[515,"حيدري عم نائله","https://www.aldiwan.net/poem20849.html","المديد"],[516,"أمالي من عذولكم عذير","https://www.aldiwan.net/poem12131.html","الوافر"],[516,"من كان لا يعشق الأجياد والحدقا","https://www.aldiwan.net/poem12182.html","البسيط"],[516,"خلعت عليك مواسم الأيام","https://www.aldiwan.net/poem12251.html","الكامل"],[541,"عققت أباك ذا نشب ويسر","https://www.aldiwan.net/poem56724.html","الوافر"],[541,"علقها قلبي جويرية","https://www.aldiwan.net/poem56746.html","الطويل"],[552,"ما لي تطيح الدهر أخياري","https://www.aldiwan.net/poem47788.html","البسيط"],[552,"قرت عيون بني النبي محمد","https://www.aldiwan.net/poem47856.html","الكامل"],[559,"واحد وهو في الظهور ثلاثه","https://www.aldiwan.net/poem33515.html","الخفيف"],[563,"لو كان للدار نطق سبحت عجبا","https://www.aldiwan.net/poem52855.html","البسيط"],[568,"يا معرضا لا يلتفت","https://www.aldiwan.net/poem69781.html","مجزوء الرجز"],[576,"أوحشني الأوانس","https://www.aldiwan.net/poem3056.html","مجزوء الرجز"],[576,"باتت معانقتي ولكن في الكرى","https://www.aldiwan.net/poem3062.html","الكامل"],[576,"حسبي كما حكم الغرام وحسبها","https://www.aldiwan.net/poem3099.html","الكامل"],[587,"علق القلب بسما","https://www.aldiwan.net/poem17457.html","مجزوء الرمل"],[587,"علق الفؤاد بظبية عجانة","https://www.aldiwan.net/poem17545.html","الكامل"]],"verses":[["عَلِقَ القَلبُ مَن أَطالَ عَذابي","وَرَواحي عَلى الجَوى وَغُدُوّي",0,"و",2,1],["عَلِقناكَ يا ظَبيَ الصَريمِ طَماعَةً","أَعِندَكَ مِن نَيلٍ لَنا فَتُنيلُ",1,"ل",1,0],["عَلِقَت حِبالَكَ ثُمَّ أَقسَمَتِ المُنى","أَن لا لُوينَ بِغَيرِ حَبلِكَ أُنمُلي",2,"ل",2,0],["عَلِقنا جَمادَ النَبلِ ناقِصَةَ الجَدا","تَروحُ عَلَينا بِالغُرورِ وَتَغتَدي",3,"د",2,0],["عَلِقَتْ بِكِلْتا راحتَيْهِ أربَعٌ","نفَضَ الأنامِلَ دونَهُنَّ الباخِلُ",4,"ل",1,0],["عُلِّقتُها عَرَضاً وَأَقتُلُ قَومَه","زَعماً لَعَمرُ أَبيكَ لَيسَ بِمَزعَمِ",5,"م",1,0],["عَلِقْتَ بِحَبْلِ اللهِ كَفّاً تَمَكَّنَتْ","مِنَ الْعُرْوَةِ الْوُثْقَى الَّتِي مَا لَهَا فَصْمُ",6,"م",1,0],["عَلِقَ الْبَثَّ والصَّبَابَةَ فِيهَا","وَبَلاَ الْهَجْرَ عِنْدَهَا والْمَلاَلَهْ",7,"ل",2,0],["عَلقَمَ لا لَستَ إِلى عامِرٍ","الناقِضِ الأَوتارَ وَالواتِرِ",8,"ر",1,0],["عَلقَمَ لا تَسفَه وَلا تَجعَلَن","عِرضَكَ لِلوارِدِ وَالصادِرِ",8,"ر",1,0],["عُلَّقتُها عَرَضاً وَعُلَّقَت رَجُلاً","غَيري وَعُلَّقَ أُخرى غَيرَها الرَجُلُ",9,"ل",1,0],["عُلَّقتُها بِالشَيِّطَينِ فَقَد","شَقَّ عَلَينا حُبُّها وَشَغَل",10,"ل",1,0],["عَلِقَت مُخلِفاً جَنيناً وَكانَت","مُنِحَت قَبلَهُ الحِيالَ نَزورا",11,"ر",2,0],["عُلِّقَ قَلبِي رَبِيبَ بَيتِ مُلو","كِ ذَاتَ قُرطَينِ وَعثَةُ الكَفَلِ",12,"ل",1,0],["عُلِّقتُها عَرَضاً وَيُلفى سِرُّها","مَنمى الأَنوقِ بِبَيضِها أَو أَبعَدا",13,"د",2,0],["عُلِّقتُها إِنسِيَّةً وَحشِيَّةً","عَصماءَ لَو خُضِعَ الحَديثُ نَوارُ",14,"ر",1,0],["عُلِّقتُ جِنِّيَّةً ضَنَّت بِنائِلِها","مِن نِسوَةٍ زانَهُنَّ الدَلُّ وَالخَفَرُ",15,"ر",1,0],["عَلِقَ الأُخَيطِلُ في حِبالي بَعدَما","عَثَرَ الفَرَزدَقُ لا لَعاً لِلعاثِرِ",16,"ر",1,0],["علقت حبالي من حبا","لك ذمة الجار المجاور",17,"ر",1,0],["علق الموضعَّة التوا","ئم بين ذي زغب وبائرْ",18,"ر",1,0],["عَلَّقَها فَعَطعَطوا وَصاحوا","وَالصَيدُ مِن آلَتِهِ الصِياحُ",19,"ح",1,0],["عَلِقَت يَدي مِنهُ بِعِلقِ مَضَنَّةٍ","مِمّا يُصانُ عَلى الزَمانِ وَيُدخَرُ",20,"ر",1,0],["عَلِقَت بَناتُ الدَهرِ تَطرُقُ ساحَتي","لَمّا فَضَلتُ بَنيهِ في حالاتِهِ",21,"ت",2,0],["عَلِقَ الشَقاءُ بِقَلبِهِ فَأَرانَهُ","في الكُفرِ آخِرَ هَذِهِ الأَحقابِ",22,"ب",1,0],["علقته من بني الأتراكِ مقترِباً","من خاطري وهو منِّي غيرُ مقترب",23,"ب",1,0],["علقتها غيداءَ حاليةَ الطَّلا","تجني على عقلِ المحبِّ ولبّه",24,"ه",1,1],["علقتُ بحبلٍ من حبالِ محمدٍ","أمنتُ به من طارقِ الدهر أنْ يعدو",25,"د",2,0],["علقت بحبل من مودته التي","هيَ الذَّخر لا بيض الثراء وصفره",26,"ر",2,0],["علقَ الغرام بعروةٍ فتبعته","وبعامرٍ فبنيت فوق أساس",27,"س",1,0],["علقته ساجي اللواحظ أهيفا","وبليَّتي ساجي اللواحظ أهيف",28,"ف",1,1],["علَّق الله في عِذاريك مِخْلا","ةً ولكنها بغير شعيرِ",29,"ر",1,0],["عُلَّقتها قحبةً ضروطاً","جَوزية القَدِّ مستديره",30,"ر",2,0],["علقتني حبالة منه ما أَنْ","فكُّ فيها بنبله مرشوقا",31,"ق",2,0],["عَلِقتُ بِحَبلِكُم فَشَدَدتُموهُ","فَلا واهٍ قُواهُ وَلا قَصيرُ",32,"ر",1,0],["عَلَقَت أَخي كَفُّ المَنونِ وَكِدتُ أَن","أَسعى عَلى آثارِهِ لَولا التُقى",33,"ق",2,0],["عُلِّقتُ جائِلَةَ الوِشاحِ غَريرَةً","تَختالُ بَينَ أَسِنَّةٍ وَبَواتِرِ",34,"ر",1,1],["عَلَّقتِني بِهَوىً مُردٍ فَقَد جَعَلَت","مِنَ الفِراقِ حَصاةُ القَلبِ تَنصَدِعُ",35,"ع",1,0],["عَلَّقتُ مِن مَدحِهِ حَبلاً أُعَزُّ بِهِ","في يَومِ لا عِزَّ بِالأَنسابِ وَاللُحَمِ",36,"م",1,0],["عَلَّقَ اللَهُ فَوقَ خِصيَتَيكَ ما كا","نَ يُخاليكَ مِن حُلاقٍ وَخُبثِ",37,"ث",1,0],["عَلَقنا بِأَسبابِ الوَزيرِ وَلَم نَجدِ","لَنا صَدَراً دونَ الوَزيرِ وَلا وِردا",38,"د",2,1],["عَلِقوا مِن مُحَمَّدٍ خَيرَ حَبلٍ","لِرُواقِ الخِلافَةِ المَمديدِ",39,"د",1,0],["عَلِقَت كَفٌّ بِكَفٍّ بَينَنا","وَاِعتَنَقنا فَاِلتَقى خَدٌّ وَخَدّ",40,"د",1,0],["عَلِقَت أَعِنَّتُهُنَّ في مَجرومَةٍ","سُحُقٍ مُشَذَّبَةِ الجُذوعِ طِوالِ",41,"ل",1,0],["عَلِقْتُ فما وَهَتْ كَفِّي ولكنْ","وَهَى عن قَبْضِها حَبْلُ اعتلاقي",42,"ق",2,0],["عَلِقَ الفُؤادُ بِحُبِّها مِن شِقوَتي","وَالحُبُّ داعِيَةٌ لِكُلِّ بَلاءِ",43,"ا",2,0],["عَلِقَ الهَمُّ بِقَلبي كُلُّهُ","وَإِذا ما عَلِقَ الهَمُّ عَلِق",44,"ق",1,0],["عَلِقَت يَدي بِكَ يا أَبا الفَتحِ الَّذي","نَصرُ الأَنامِ عَلى عُلاهُ أَجمَعُ",45,"ع",1,0],["عَلِقَتْ حِبَالَةُ خَاطِرِي","مِنْهَا بِمَكْحُولٍ أَغَنِّ",46,"ن",1,0],["عَلِقْتُ بِهَا وَهْيَ الْمَعَالِي وَقَلمَا","يَهِيمُ بِهَا إِلَّا الشُّجَاعُ الْمُصَمِّمُ",47,"م",1,0],["عُلِّقتُها ناشِئً وَعُلِّقَت رَجُلاً","غَيرِيَ غَضَّ الشَبابِ كَالغُصُنِ",48,"ن",1,0],["عُ