{"poems":[[63,"سواي يكون عرضة مستريث","https://www.aldiwan.net/poem45946.html","الطويل"],[93,"ليلى اجمعي الناس إلى محفل","https://www.aldiwan.net/poem11104.html","السريع"],[51,"قولا لمن عاب شعر مادحه","https://www.aldiwan.net/poem62974.html","البسيط"],[80,"أمسك الصبا أهدت إلي صبا نجد","https://www.aldiwan.net/poem31482.html","الطويل"],[69,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55160","الكامل"],[136,"عفا الله عني ما الذي كان من أمري","https://www.aldiwan.net/poem49088.html","الطويل"],[136,"لماذا أهاب الضيم أو أرهب الدهرا","https://www.aldiwan.net/poem49089.html","الطويل"],[236,"أترى تعود لنا كما","https://www.aldiwan.net/poem31737.html","مجزوء الكامل"]],"verses":[["وَلي ذِمَمٌ إِذا شُدَّتْ عُراهَا","فَما تَفْتَرُّ عَنْ عَهْدٍ نَكيثِ",0,"ث",1,0],["وَليَذْكُرِ النَّاسُ غَراماً مَضَى","ولتَذْكُرِ العاشِقَةُ النَّاسِيهْ",1,"ي",2,0],["وليذكروا أنه يُكَدّ له ال","عقل وتُنضى في قرضه الفِكر",2,"ر",1,0],["وَلي ذِمَّةٌ مَرعيَّةٌ عِندَ عَبْرَةٍ","تُواصِلُ وُدّي في فراقِ ذَوي الودِّ",3,"د",1,0],["ولي ذنوبٌ متى أذكرْ سوالفَها","كأنني فوقَ روقِ الظبي مِنْ حذرِ",4,"ر",1,0],["وَلَيُذْكَرَنَّ الدَّهْرَ عَدْلُكَ بَاهِراً","وَلْتُحْمَدَنَّ خِلاَئِقاً وَفِعَالاَ",5,"ل",2,0],["ولي ذمة تأبى موافقةً على","ذميم فعالٍ واتحاد على الشرّ",6,"ر",1,0],["ولي ذمة منكم مؤكدةُ العرى","وقوة آمال بآلائك الغَرا",7,"ر",2,0],["وَلَيَذهَبَنَّ بِوَقدَةِ ال","شِعرى وَوَدقِ المِرزَمَينِ",8,"ن",1,0]]}