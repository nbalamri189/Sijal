{"poems":[[65,"سواي يكون عرضة مستريث","https://www.aldiwan.net/poem45946.html","الطويل"],[95,"ليلى اجمعي الناس إلى محفل","https://www.aldiwan.net/poem11104.html","السريع"],[53,"قولا لمن عاب شعر مادحه","https://www.aldiwan.net/poem62974.html","البسيط"],[82,"أمسك الصبا أهدت إلي صبا نجد","https://www.aldiwan.net/poem31482.html","الطويل"],[71,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55160","الكامل"],[139,"عفا الله عني ما الذي كان من أمري","https://www.aldiwan.net/poem49088.html","الطويل"],[139,"لماذا أهاب الضيم أو أرهب الدهرا","https://www.aldiwan.net/poem49089.html","الطويل"],[240,"أترى تعود لنا كما","https://www.aldiwan.net/poem31737.html","مجزوء الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55956","الرمل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108757","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74063","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66436","السريع"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102737","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33690","الكامل"],[4767,"البر والتقوى","https://www.poetsgate.com/ViewPoem.aspx?id=213423",""],[5246,"إذا افتخر العصر الذي قد صحبتُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=187044",""],[5474,"قلادة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=181669",""],[5638,"أمي (أنشودة للأطفال)","https://www.poetsgate.com/ViewPoem.aspx?id=199069",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""]],"verses":[["وَلي ذِمَمٌ إِذا شُدَّتْ عُراهَا","فَما تَفْتَرُّ عَنْ عَهْدٍ نَكيثِ",0,"ث",1,0],["وَليَذْكُرِ النَّاسُ غَراماً مَضَى","ولتَذْكُرِ العاشِقَةُ النَّاسِيهْ",1,"ي",2,0],["وليذكروا أنه يُكَدّ له ال","عقل وتُنضى في قرضه الفِكر",2,"ر",1,0],["وَلي ذِمَّةٌ مَرعيَّةٌ عِندَ عَبْرَةٍ","تُواصِلُ وُدّي في فراقِ ذَوي الودِّ",3,"د",1,0],["ولي ذنوبٌ متى أذكرْ سوالفَها","كأنني فوقَ روقِ الظبي مِنْ حذرِ",4,"ر",1,0],["وَلَيُذْكَرَنَّ الدَّهْرَ عَدْلُكَ بَاهِراً","وَلْتُحْمَدَنَّ خِلاَئِقاً وَفِعَالاَ",5,"ل",2,0],["ولي ذمة تأبى موافقةً على","ذميم فعالٍ واتحاد على الشرّ",6,"ر",1,0],["ولي ذمة منكم مؤكدةُ العرى","وقوة آمال بآلائك الغَرا",7,"ر",2,0],["وَلَيَذهَبَنَّ بِوَقدَةِ ال","شِعرى وَوَدقِ المِرزَمَينِ",8,"ن",1,0],["ولي ذمة بالاسم والحب والثنا","وأنت بها والله أوفى وأكرم",9,"م",1,0],["وليذلّ الله أعداه له","كل يوم ليروا منهُ العبرْ",10,"ر",1,0],["ولَّى ذياب وعادت الذئاب إذا","تحرك الليث ولت كلها جزعا",11,"ع",2,0],["وَليذهَبنَّ بكلّ من","يُمسي وَيصبح وَهوَ كلُّ",12,"ل",1,0],["ولي ذنوبٌ ذكرها فاضحُ","يا رب مالي عملٌ صالحُ",13,"ح",1,0],["ولي ذنوب على الأفلاك لو وضعت","من حمل أعبائها الأفلاك لم تدر",14,"ر",1,0],["وليذهَبنَّ زفيرهُ بعزائهِ","بالشوقِ حتَّى لا يُحسّ ولا يرَى",15,"ا",1,0],["وليذكرِ الجبارَ ما أمرتْ","هُ النَّفسُ جهلاً بالذي تهوى",16,"و",2,0],["ولي ذكرياتٌ في الزقاقِ وفي الرُّبا","ومن حول ميدان الحسين لي الذِكْر",17,"ر",1,0],["وليْ ذكريات فيه بالنّحْت رسِّخت","وسرُّ الهوى بالنّحْت جادتْ خلاله",18,"ل",2,0],["وَلِي ذُخْرٌ لِأَيَّامِي","وَدِرْعِي الضَّامِنُ الْحَامِي",19,"ي",1,0],["ولي ذنوبٌ إذا ما زنتها رجحت","على الجبال وفاقت عدة النُجُمِ",20,"م",1,0]]}