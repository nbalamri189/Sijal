tps://www.poetsgate.com/ViewPoem.aspx?id=108215",""],[5145,"أذر الدموع فلات حين مجاز","https://www.poetsgate.com/ViewPoem.aspx?id=108241",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5185,"القصيدة اليمانية","https://www.poetsgate.com/ViewPoem.aspx?id=74641",""],[592,"أأشجاك أم أبكاك رسم النمازل","https://www.poetsgate.com/ViewPoem.aspx?id=128860",""],[5387,"سد الكبرياء","https://www.poetsgate.com/ViewPoem.aspx?id=53806",""],[5431,"ويملكني جميل الروح سهلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=187535",""],[5436,"زفرات(على لسان العراق)للشاعر إسماعيل الصيّاح","https://www.poetsgate.com/ViewPoem.aspx?id=129741",""],[5442,"إذا البرق من تلقاء كاظمة عنا","https://www.poetsgate.com/ViewPoem.aspx?id=114776",""],[5452,"كوني لي","https://www.poetsgate.com/ViewPoem.aspx?id=112028",""],[5457,"ما معنى الوطن؟","https://www.poetsgate.com/ViewPoem.aspx?id=213236",""],[5463,"وأتأوه آآه تحكي عنها كل الألسنه","https://www.poetsgate.com/ViewPoem.aspx?id=33840",""],[5573,"ضحايا العيد","https://www.poetsgate.com/ViewPoem.aspx?id=200331",""],[5690,"لواؤك سيدي عبد الحميد","https://www.poetsgate.com/ViewPoem.aspx?id=172136",""],[5779,"وحزت بميدان الْعِبَادَة غَايَة","https://www.poetsgate.com/ViewPoem.aspx?id=189116",""],[5829,"أمل","https://www.poetsgate.com/ViewPoem.aspx?id=180643",""],[5897,"إلى حمامة فضولية","https://www.poetsgate.com/ViewPoem.aspx?id=176412",""],[5908,"بنا من بنات الماء للكوفة الغرا","https://www.poetsgate.com/ViewPoem.aspx?id=170972",""],[5956,"مناهل إلهامي","https://www.poetsgate.com/ViewPoem.aspx?id=185878",""],[5956,"أخلاقه","https://www.poetsgate.com/ViewPoem.aspx?id=194553",""],[6068,"إذا ذكر الأحباب آضت تهزّني -24-","https://www.poetsgate.com/ViewPoem.aspx?id=175862",""],[6093,"تَبْعِيْضٌ","https://www.poetsgate.com/ViewPoem.aspx?id=204801",""],[6263,"كما شئتَ يا شعر...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81062&r=&rc=13",""],[6310,"جمر الشتات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72001&r=&rc=5",""]],"verses":[["وَحُزنا طاعَةَ الدَهرِ","فَأَغضَبنا وَأَرضَينا",0,"ن",2,0],["وَحُز بِها ما بَقِيَ العُمرُ لي","صَفاءَ قَلبي وَصَفايا فَمي",1,"م",2,0],["وَحُزنا عَتيقاً وَهوَ غايَةُ فَخرِكُم","بِمَولِدِ بِنتِ القاسِمِ بنِ مُحَمَّدِ",2,"د",1,0],["وَحُزتَ جِمامَ نِعمَتِهِ وَكانَت","غِماراً لا تُكَدَّرُ بِالدِلاءِ",3,"ا",2,0],["وحُزْتُ ندىً ما شانَهُ بمِطالِهِ","وحازَ ثَناءً لمْ يَشِنْهُ مِطالي",4,"ل",2,0],["وحُزْتُمْ بكَعْبٍ في كِلابٍ مَناقِباً","تُنافي أنابيبَ الرِّماحِ الشّواجِرِ",5,"ر",1,0],["وَحَزيناً إِذا تَنَفَّسَ عادَت","فَحمَةُ اللَيلِ جَمرَةً مِن ضِرامِ",6,"م",1,0],["وحزَيت كل صنيعة بمثالها","إن الصنائع في الرجال قُروض",7,"ض",1,0],["وَحَزمٌ وجودٌ فِي عَفَافٍ وَنضائِلٍ","إلى مَنصِبٍ مَا مِثلُه كَانَ مَنصِبُ",8,"ب",1,0],["وحزن فلاةٍ يممته وإنما","ديارُ الظبا حزنُ الفلاة وموتها",9,"ت",3,0],["وحزن أخٍ قد جاورته كرامة","لها وإلى بيتِ الكرامات ينزع",10,"ع",1,0],["وحزن كبار أو صغار تتابعوا","أسوداً وغزلاناً تسير وتتبع",10,"ع",1,0],["وحزتَ معاني القول من كلِّ وجهةٍ","فأبق علينا نبذةً لثناكا",11,"ك",2,0],["وَحَزنٌ ثُمَّ سَهلٌ ثُمَّ قَفرٌ","وَنَهرٌ ثُمَّ بَحرٌ ثُمَّ يَبسُ",12,"س",1,0],["وحزن نفسي عليك من كرمٍ","وهو على من سواك من خَورِ",13,"ر",1,0],["وحزمُ منصورك المشادُ به","فيك ومن ثمَّ تحتذي لددَكْ",14,"ك",1,0],["وحزينِها وبهيجِها","وحقيرِها وعظيمِها",15,"ه",2,0],["وَحُزتَ أَخلاقَ شَمسِ الدينِ مُكتَسِباً","وَالشَمسُ مُكتَسِبٌ مِن نورِها القَمَرُ",16,"ر",1,0],["وَحَزمٌ يَبيتُ العَجزُ عَنهُ بمعزلٍ","ورأيٌ به في اللبس يُرْفَعُ إشكالُ",17,"ل",1,0],["وحُزْناً عليكَ بِحَبْسِ النفوس","على نَهْجِكَ النَّيِّرِ المَهْيَعِ",18,"ع",1,0],["وَحَزمٍ تَنثَني عَنهُ العَوادي","وَيُلقي عِندَهُ الدَهرُ القِيادا",19,"د",2,0],["وَحَزمَةٌ في الرَأيِ وَالمَشورَه","قَديمَةٌ مَعروفَةٌ مَشهورَه",20,"ه",1,0],["وَحُزنا الَّتي أَعيَتكُمُ قَد عَلِمتُمُ","فَما ذَنبُنا هَل قاتِلٌ مِثلُ سالِبِ",21,"ب",1,0],["وحزَّبها فهيَ في بعضها","تُحطِّمُ بعضاً وتلقي نَكالا",22,"ل",2,0],["وحُزت موسى جائلا وجائبا","يستقبل الآيات والعجائبا",23,"ب",2,0],["وحزبهم ممتنع الهدوّ","حثيثةٌ فيهم يد العدو",24,"و",1,0],["وَحُزنٌ لانَفادَ لَهُ وَدَمعٌ","يُلاحي في الصَبابَةِ كُلَّ لاحِ",25,"ح",1,0],["وحُزناً أنْ يجُرَّ الدهرُ حُزناً","على تلك الغَطارفةِ الوضاح",26,"ح",1,0],["وحزني عليك جزوعاً وقد","نعتني إِليك بنات المداد",27,"د",1,0],["وحزت العلم مَع فهم وحلم","وعقلٍ راجحٍ صافٍ جلىّ",28,"ا",1,0],["وَحُزتَ مَعَ الجَهلِ المُرَكَّبِ وَالخَنَا","وَسُوءَ الطِّبَاعِ العُجبَ والكِبرَ والرِّيَا",29,"ي",2,0],["وَحُزتَ كُلَّ نَفيسٍ مِن مَلابِسهِ","أَشبَهتَ لَألاءَهُ وَالشَبهُ مُنجَدِبُ",30,"ب",1,0],["وَحُز مِدَحاً إِن سِواها اِنطَوى","بَدَت غُرَراً في وُجوهِ الدُوَل",31,"ل",1,0],["وحزني مع الساعات يربو مجدّدا","وليلي طويل والمنام نفور",32,"ر",1,0],["وَحَزماً إِذا ما الحادِثاتُ اِعتَرَضنَهُ","تَصَدّعنَ عَنهُ مُقدِماً غَيرَ رائِثِ",33,"ث",1,0],["وَحُزتَ خِلالَ الفَضلِ مِن كُلِّ وجهَةٍ","فَما فاضِلٌ إِلّا وَأَنتَ المُفَضَّلُ",34,"ل",1,0],["وحزت من المجد الرفيع مكانة","بها في العلا جاوزت شهيا وانجما",35,"م",2,0],["وحزت في فلك العلياء منزلة","بالسعد ما نالها عرب ولا عجم",36,"م",1,0],["وحزت في فلك العلياء منزلة","من دونها المشتري والأنجم الزهر",37,"ر",1,0],["وحزمك لا ما احكمت حكماؤها","من الأمر ما يقمى الأعادي ويقمع",38,"ع",1,0],["وحزت آداباً إلى نيلها","الاك عجزٌ دأب من يدأب",39,"ب",1,0],["وحزت من الدهر ما أرتجيه","ورضت من العيش ما أصعبا",40,"ب",2,0],["وَحُزْنٌ تَساوى النَّاسُ فِيهِ وَإِنَّما","يَعُمُّ مِنَ الأَحْزانِ ما هُوَ أَبْرَحُ",41,"ح",1,0],["وَحزمٌ آخذٌ بعنانِ عزمٍ","إِذا أكبت مذاكي السبقِ جلّى",42,"ل",2,0],["وحزنِ كطول الدهر باق إذا مضَت","أوائلُه عادت إلينا الأواخر",43,"ر",1,1],["وَحُزِمَت أَصلابُهُ فَوقَ العُرى","فَقالَ أُنعيتُ فَقُلتُ قَد أَرى",44,"ا",1,0],["وَحَزَّني عَلى ما فاتَ مِن زَمَني بِها","يُقَطِّرُ أَجفاني بِتَصعيدِ زَفرَتي",45,"ي",1,0],["وَحزت به مجدا وَفخرا وَسوددا","فارّخته لِلسَّيد الماجِد الفَخر",46,"ر",1,0],["وحزت شفاعات البتول فمثلها","شفيعٌ وأنت بالشفاعة تُسعَف",47,"ف",1,0],["وحزت المنتهى درساً وبحثاً","وغايته وغايات الكلام",48,"م",1,0],["وحُزْتَ مكارم الأخلاق طرًّا","ومنها جئت بالعجب العجاب",49,"ب",1,0],["وحزب من العالين يهتف بالثنا","عليه بوحيٍ كدْتُ أسمعه جهرا",50,"ر",2,0],["وحزب من الله في عونها","وذلك أكبر أعوانها",51,"ن",3,0],["وحزتَ من سعد مسعود عظيم منى","تضحي الليالي لما قد نلتهُ خدما",52,"م",2,0],["وحُزتم شتيت الفخر حتى أتاكُمُ","بغايتهِ الغوْرُ المُباعِدُ والنَّجْدُ",53,"د",1,0],["وحزامةٍ أغنت عن الأشياع إذ","مثلت لديهِ فوارساً وسنوّرا",54,"ر",2,0],["وحزم وعزم واتقاء وعفة","وخلق وأخلاق وفرع ومحتد",55,"د",1,0],["وحُزْتَ مِنَ المناقِبِ باتّفاقٍ","نَصِيباً لا يُدانيهِ مُداني",56,"ن",2,0],["وَحزنُك اليوم عُقبى ما سُررتَ به","حيناً وعقبى الّذي تلتذّه الألمُ",57,"م",1,0],["وحزتُ كراماتِ الخلائق وادعاً","وشاطرني ضيقَ المكانِ الحُلاحِلُ",58,"ل",1,0],["وَحَزمٌ يَهُزُّ الراسِياتِ ثَباتُهُ","وَعَزمٌ يُحاكي الزَندَ ماضيُهُ قَدحا",59,"ح",2,0],["وحزنه عليه واهتمامه","بما دهاه منه واغتمامه",60,"ه",1,0],["وحزن البدر له فانكسفا","وناحت الجن عليه أسفا",60,"ف",2,0],["وَحُزْتَ أَفْصَحَ مَنْ يَهْدِي وَأَوْضَحَ مَنْ","يُبْدِي وأَرْجَحَ مَنْ يُعزى إلى نَسَبِ",61,"ب",1,0],["وَحُزْتَ جَمالاً لَيْسَ فِي الخَلْقِ مِثْلُهُ","بِهِ دَائِماً قَلْبِي يَهيمُ وَيُشْغَفُ",62,"ف",1,0],["وحزب الإله الخائطي حومة الوغى","ويحمونها بالمرهفات الصوارم",63,"م",1,0],["وحزبُ الله لا خوفٌ عليهم","ولا نَصَبٌ ولا هم يَحزنونا",64,"ن",2,0],["وحزت صدقا لو أن الخلق أحرزه","ما كان من آثم فيهم وفاك",65,"ك",1,0],["وَحزمك في كُل الأُمور مجرّب","وَمجدك يا كنز العَطاء أَثيل",66,"ل",1,0],["وَحَزمٍ بِهِ زادَت مَهابة دَولة","سَمَت بِمَليكٍ ثاقب الفكر داوري",67,"ر",2,0],["وَحَزم لِلمهندس مِنهُ رَشد","بِهِ يَنجو إِذا خيف الوَعيد",68,"د",1,0],["وحزمٌ تُسْتَرَقُّ به الليالي","إذا جَرَّتْ لنا حَبْلَ الشَّموس",69,"س",1,0],["وَحُزْتَ مِنَ الأَعْمَارِ أَقْصَى نِهَايَةٍ","تفُوتُ مَدَى الإِحْصَاءِ فِيهَا يَدُ الْمُحصِي",70,"ص",2,0],["وحزمٌ إذا أبرمْت أمراً وقسْتَه","فلم تقْضِ حتى تستبين العواقبا",71,"ب",2,0],["وحزت فخرا لم يحزه السوى","بالرؤية الغرا وإلقا الكلام",72,"م",1,0],["وَحَزْمٌ عَلَى سَمْكِ السَّمَاءِ مُسَامِرٌ","وَعَزْمٌ عَلَى نَجْمِ النُّجُومِ مُحَاوِرُ",73,"ر",1,0],["وَحَزماً قامَ يَدفَعُ كُل خَطبٍ","وَرَأَياً دونَهُ السَيف اليَماني",74,"ن",2,0],["وحزن يزيد القلب شجواً ولوعة","إذا ما حداة الركب جدر حيلها",75,"ل",3,0],["وحُزْتَ خصائصَ الرؤساءِ طُرًّا","وحَصَّلْتَ السعودَ لديكَ صَبْرَهْ",76,"ر",2,0],["وحزين قلب لو تكون نجاته","بالحزن قام فؤاده بنجاته",77,"ت",2,0],["وحزتَ ثواباً لو يقسَّم في الورى","لحطتْ به في الحشرِ منها الجرائمُ",78,"م",1,0],["وحزم وعزم \"بين بِكر\" وثيّبٍ","ب\"ه المرهف\" الماضي يُفلَّلُ حدُّه",79,"د",2,0],["وحزونه صارا حماك ومربعي","سرّي به فقد اغتدت ثمراته",80,"ه",1,0],["وحزب وأتباع وأنصاره همو","أهيل التقى والمجد والعز والفخر",81,"ر",1,0],["وَحُزْتَ بِلَيلَتَينِ عزِيزَ كَنزٍ","تُوَزّعهُ إلى الأبَدِ الأبيِدِ",82,"د",1,0],["وَحُزنا في النَقاوة كُلُ فَن","فَلَيسَ بِغَيرِنا تَصبو ذُبابه",83,"ب",2,0],["وحزينكم يا ناس يوم ولادتي","ما زغرط النسوان فيه قليلا",84,"ل",2,0],["وحُزني قد تمادى في ازدياد","فهل يا صبر قلبي من مَزيد",85,"د",1,0],["وحزني لا تغيره الليالي","ولو مهما استطال بي المطال",86,"ل",1,0],["وحزت من المفاخر منتهاها","فلم تترك لمرتاد بقايا",87,"ا",3,0],["وحزت العلم والافضال سبقاً","فمجدك مجد عز لا يباهي",88,"ا",3,0],["وحزت ما حازت الأيام من شرف","ففقت كل الورى حيا ومفقودا",89,"د",2,0],["وحزت به الأكوان شرقاً ومغربا","وما بينهن قبلةً وشمالا",90,"ل",2,0],["وحزبه الكافرين الخاسرين وقد","صاروا فريقين مأسور ومقتول",91,"ل",1,1],["وحزم كما شاء السداد مؤيد","تريه خفا يا الغيب من دون ما ستر",92,"ر",1,0],["وحزم مثل حد السيف ماضٍ","وعزم لا يشق له غبار",93,"ر",1,0],["وحزناً عليه قد بكاه بارزه","وحق السما تبكي بانجمها الزهر",94,"ر",1,0],["وحزم أثمرت أغصا","نه في روضة زهرا",95,"ر",2,0],["وحزنا الحصون ببذل المصو","ن من النفس والمال والمشتهى",96,"ه",2,0],["وحزم وعزم في الأمور كلاهما","يسابق بالإنجاز بادرة الوعد",97,"د",1,0],["وحزن كيره وسط قلبي رشين","ودموع تجري كالمعايين",98,"ن",1,0],["وحز من الفضل أخلاقاً مهذبةً","يزينها منك تنزيه وتطهير",99,"ر",1,0],["وحُزتُم قَصَبَ السَّبقِ","فَلَم يَعُد لَكُم حَصلُ",100,"ل",1,0],["وحزت بنسبتي في المهد مجدا","فما لي بعدما آنست رشدا",101,"د",2,0],["وحزينة القلب اكتست بحدادها","تشكو الشقاء وفي الشقا إخوانها",102,"ن",3,0],["وحزْبُكَ منصورٌ وعِزُّكَ قاهِرٌ","وجودُكَ مَبْذولٌ وحِلْمُكَ واسعُ",103,"