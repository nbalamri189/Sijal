{"poems":[[53,"أما كنت مع الحي","https://www.aldiwan.net/poem29741.html","الهزج"],[53,"يا من رأى البرق على الأنعم","https://www.aldiwan.net/poem29815.html","السريع"],[53,"يفاخرنا قوم بمن لم يلدهم","https://www.aldiwan.net/poem30608.html","الطويل"],[53,"بهاء الملك من هذا البهاء","https://www.aldiwan.net/poem30782.html","الوافر"],[63,"أتيحت لداء في الفؤاد عضال","https://www.aldiwan.net/poem46130.html","الطويل"],[63,"أبت إبلي والليل وحف الغدائر","https://www.aldiwan.net/poem46167.html","الطويل"],[86,"إن عضيك يا أخي بالملام","https://www.aldiwan.net/poem68843.html","الخفيف"],[88,"قد صح عزمك والزمان مريض","https://www.aldiwan.net/poem44822.html","الكامل"],[37,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[72,"أقيما فروض الحزن فالوقت وقتها","https://www.aldiwan.net/poem18388.html","الطويل"],[72,"أذات الحجى إن الحجاب ليمنع","https://www.aldiwan.net/poem19171.html","الطويل"],[72,"أمنزل سعدى بالعذيب سقاكا","https://www.aldiwan.net/poem19440.html","الطويل"],[64,"سكوت ثم صمت ثم خرس","https://www.aldiwan.net/poem67636.html","الوافر"],[51,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[51,"أصبحت عاديت للصبا رشدك","https://www.aldiwan.net/poem65760.html","المنسرح"],[92,"يا أيها الطفل الذي قد","https://www.aldiwan.net/poem38926.html","مجزوء الكامل"],[66,"يا ليت شعري وقد أودى بك القدر","https://www.aldiwan.net/poem40138.html","البسيط"],[80,"أجمل على بخل الغواني وإجمال","https://www.aldiwan.net/poem31339.html","الطويل"],[90,"فداء لمثواك","https://www.aldiwan.net/poem59036.html","عموديه"],[105,"أكل متوج يحمي البلادا","https://www.aldiwan.net/poem43373.html","الوافر"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"أبى الله إلا ما ترون فما لكم","https://www.aldiwan.net/poem27295.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39657","المتقارب"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/883","الوافر"],[90,"ذكرى وعد بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179206",""],[122,"لقد بت أمس كما بت أنت","https://www.aldiwan.net/poem23766.html","المتقارب"],[126,"بموتِ المرتضى الواكي الرضى","https://www.aldiwan.net/poem50216.html","الوافر"],[130,"خليلى لا لا تبديبا لى التلكيا","https://www.aldiwan.net/poem54683.html","الطويل"],[141,"لا فات ملكك ما أعيا به الطلب","https://www.aldiwan.net/poem11730.html","البسيط"],[141,"إباؤك للمجد أن يبتذل","https://www.aldiwan.net/poem11800.html","المتقارب"],[145,"إلام فؤادي بالحبيب هتور","https://www.aldiwan.net/poem47686.html","الطويل"],[162,"أماطت لثاما عن أقاح الدمائث","https://www.aldiwan.net/poem67812.html","الطويل"],[167,"بنانك من مغدودق المزن أهطل","https://www.aldiwan.net/poem1659.html",""],[208,"هناء به شمل المعاني تنظما","https://www.aldiwan.net/poem13324.html","الطويل"],[208,"الحمد لله قد سرت بك الأمم","https://www.aldiwan.net/poem13493.html","البسيط"],[208,"بك المناصب في العلياء تفتخر","https://www.aldiwan.net/poem13551.html","البسيط"],[259,"محلك من متن السماكين ارفع","https://www.aldiwan.net/poem38242.html","البسيط"],[259,"ما راعني الليل ولا السبسب","https://www.aldiwan.net/poem38366.html","السريع"],[259,"ذراني إذا ما فؤادي صبا","https://www.aldiwan.net/poem38370.html","المتقارب"],[278,"أحتى إلى العلياء يا خطب تطمح","https://www.aldiwan.net/poem60783.html","الطويل"],[303,"ربيع من جبينك قد أطلا","https://www.aldiwan.net/poem56437.html","الطويل"],[324,"وحزن كطول الدهر باق إذا مضت","https://www.aldiwan.net/poem44230.html","الطويل"],[335,"طاف خيال من سليمى فاعترى","https://www.aldiwan.net/poem45338.html","الرجز"],[347,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[359,"اذا لاح ذاك الوجه وابتسم الثغر","https://www.aldiwan.net/poem68110.html","الطويل"],[374,"خليلي أما هذه فديارهم","https://www.aldiwan.net/poem59330.html","الطويل"],[400,"لقد صدرت إلى أعلى مقام","https://www.aldiwan.net/poem33449.html","الوافر"],[413,"ذكرت على النوى عهد التصابي","https://www.aldiwan.net/poem54047.html","الوافر"],[413,"سرينا لنمحو الإثم أو نغنم الأجرا","https://www.aldiwan.net/poem54107.html","الطويل"],[413,"فخار الملوك بأعوانها","https://www.aldiwan.net/poem54168.html","المتقارب"],[434,"ظبي الصريم حبالي في الهوى صرما","https://www.aldiwan.net/poem2586.html","البسيط"],[459,"وقى الله أستار العلى من خزيمة","https://www.aldiwan.net/poem16368.html","الطويل"],[462,"يا من تلون عهده وتغيرا","https://www.aldiwan.net/poem3198.html","عموديه"],[513,"لك المجد والفضل الذي ليس يجحد","https://www.aldiwan.net/poem12072.html","الطويل"],[527,"إذا رضي الرحمن عني فكل من","https://www.aldiwan.net/poem37132.html","الوافر"],[549,"ما للقلوب غداة السبت مزعجة","https://www.aldiwan.net/poem47250.html","البسيط"],[549,"توق ديار الحي فهي المقاتل","https://www.aldiwan.net/poem47325.html","الطويل"],[561,"دع العيس والبيداء تذرعها شطحا","https://www.aldiwan.net/poem13597.html","الطويل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[584,"أرض الأحبة من سفح ومن كثب","https://www.aldiwan.net/poem17436.html","البسيط"],[584,"كفى شرفا أني بحبك أعرف","https://www.aldiwan.net/poem17599.html","الطويل"],[585,"بعزك يا ذا الكبرياء والمراحم","https://www.aldiwan.net/poem11517.html","عموديه"]],"verses":[["وَحُزنا طاعَةَ الدَهرِ","فَأَغضَبنا وَأَرضَينا",0,"ن",2,0],["وَحُز بِها ما بَقِيَ العُمرُ لي","صَفاءَ قَلبي وَصَفايا فَمي",1,"م",2,0],["وَحُزنا عَتيقاً وَهوَ غايَةُ فَخرِكُم","بِمَولِدِ بِنتِ القاسِمِ بنِ مُحَمَّدِ",2,"د",1,0],["وَحُزتَ جِمامَ نِعمَتِهِ وَكانَت","غِماراً لا تُكَدَّرُ بِالدِلاءِ",3,"ا",2,0],["وحُزْتُ ندىً ما شانَهُ بمِطالِهِ","وحازَ ثَناءً لمْ يَشِنْهُ مِطالي",4,"ي",1,0],["وحُزْتُمْ بكَعْبٍ في كِلابٍ مَناقِباً","تُنافي أنابيبَ الرِّماحِ الشّواجِرِ",5,"ر",1,0],["وَحَزيناً إِذا تَنَفَّسَ عادَت","فَحمَةُ اللَيلِ جَمرَةً مِن ضِرامِ",6,"م",1,0],["وحزَيت كل صنيعة بمثالها","إن الصنائع في الرجال قُروض",7,"ض",1,0],["وَحَزمٌ وجودٌ فِي عَفَافٍ وَنضائِلٍ","إلى مَنصِبٍ مَا مِثلُه كَانَ مَنصِبُ",8,"ب",1,0],["وحزن فلاةٍ يممته وإنما","ديارُ الظبا حزنُ الفلاة وموتها",9,"ت",3,0],["وحزن أخٍ قد جاورته كرامة","لها وإلى بيتِ الكرامات ينزع",10,"ع",1,0],["وحزن كبار أو صغار تتابعوا","أسوداً وغزلاناً تسير وتتبع",10,"ع",1,0],["وحزتَ معاني القول من كلِّ وجهةٍ","فأبق علينا نبذةً لثناكا",11,"ك",2,0],["وَحَزنٌ ثُمَّ سَهلٌ ثُمَّ قَفرٌ","وَنَهرٌ ثُمَّ بَحرٌ ثُمَّ يَبسُ",12,"س",1,0],["وحزن نفسي عليك من كرمٍ","وهو على من سواك من خَورِ",13,"ر",1,0],["وحزمُ منصورك المشادُ به","فيك ومن ثمَّ تحتذي لددَكْ",14,"ك",1,0],["وحزينِها وبهيجِها","وحقيرِها وعظيمِها",15,"ه",2,0],["وَحُزتَ أَخلاقَ شَمسِ الدينِ مُكتَسِباً","وَالشَمسُ مُكتَسِبٌ مِن نورِها القَمَرُ",16,"ر",1,0],["وَحَزمٌ يَبيتُ العَجزُ عَنهُ بمعزلٍ","ورأيٌ به في اللبس يُرْفَعُ إشكالُ",17,"ل",1,0],["وحُزْناً عليكَ بِحَبْسِ النفوس","على نَهْجِكَ النَّيِّرِ المَهْيَعِ",18,"ع",1,0],["وَحَزمٍ تَنثَني عَنهُ العَوادي","وَيُلقي عِندَهُ الدَهرُ القِيادا",19,"د",2,0],["وَحَزمَةٌ في الرَأيِ وَالمَشورَه","قَديمَةٌ مَعروفَةٌ مَشهورَه",20,"ه",1,0],["وَحُزنا الَّتي أَعيَتكُمُ قَد عَلِمتُمُ","فَما ذَنبُنا هَل قاتِلٌ مِثلُ سالِبِ",21,"ب",1,0],["وحزَّبها فهيَ في بعضها","تُحطِّمُ بعضاً وتلقي نَكالا",22,"ل",2,0],["وحُزت موسى جائلا وجائبا","يستقبل الآيات والعجائبا",23,"ب",2,0],["وحزبهم ممتنع الهدوّ","حثيثةٌ فيهم يد العدو",24,"و",1,0],["وَحُزنٌ لانَفادَ لَهُ وَدَمعٌ","يُلاحي في الصَبابَةِ كُلَّ لاحِ",25,"ح",1,0],["وحُزناً أنْ يجُرَّ الدهرُ حُزناً","على تلك الغَطارفةِ الوضاح",26,"ح",1,0],["وحزني عليك جزوعاً وقد","نعتني إِليك بنات المداد",27,"د",1,0],["وحزت العلم مَع فهم وحلم","وعقلٍ راجحٍ صافٍ جلىّ",28,"ا",1,0],["وَحُزتَ مَعَ الجَهلِ المُرَكَّبِ وَالخَنَا","وَسُوءَ الطِّبَاعِ العُجبَ والكِبرَ والرِّيَا",29,"ي",2,0],["وَحُزتَ كُلَّ نَفيسٍ مِن مَلابِسهِ","أَشبَهتَ لَألاءَهُ وَالشَبهُ مُنجَدِبُ",30,"ب",1,0],["وَحُز مِدَحاً إِن سِواها اِنطَوى","بَدَت غُرَراً في وُجوهِ الدُوَل",31,"ل",1,0],["وحزني مع الساعات يربو مجدّدا","وليلي طويل والمنام نفور",32,"ر",1,0],["وَحَزماً إِذا ما الحادِثاتُ اِعتَرَضنَهُ","تَصَدّعنَ عَنهُ مُقدِماً غَيرَ رائِثِ",33,"ث",1,0],["وَحُزتَ خِلالَ الفَضلِ مِن كُلِّ وجهَةٍ","فَما فاضِلٌ إِلّا وَأَنتَ المُفَضَّلُ",34,"ل",1,0],["وحزت من المجد الرفيع مكانة","بها في العلا جاوزت شهيا وانجما",35,"م",2,0],["وحزت في فلك العلياء منزلة","بالسعد ما نالها عرب ولا عجم",36,"م",1,0],["وحزت في فلك العلياء منزلة","من دونها المشتري والأنجم الزهر",37,"ر",1,0],["وحزمك لا ما احكمت حكماؤها","من الأمر ما يقمى الأعادي ويقمع",38,"ع",1,0],["وحزت آداباً إلى نيلها","الاك عجزٌ دأب من يدأب",39,"ب",1,0],["وحزت من الدهر ما أرتجيه","ورضت من العيش ما أصعبا",40,"ب",2,0],["وَحُزْنٌ تَساوى النَّاسُ فِيهِ وَإِنَّما","يَعُمُّ مِنَ الأَحْزانِ ما هُوَ أَبْرَحُ",41,"ح",1,0],["وَحزمٌ آخذٌ بعنانِ عزمٍ","إِذا أكبت مذاكي السبقِ جلّى",42,"ل",2,0],["وحزنِ كطول الدهر باق إذا مضَت","أوائلُه عادت إلينا الأواخر",43,"ر",1,1],["وَحُزِمَت أَصلابُهُ فَوقَ العُرى","فَقالَ أُنعيتُ فَقُلتُ قَد أَرى",44,"ا",1,0],["وَحَزَّني عَلى ما فاتَ مِن زَمَني بِها","يُقَطِّرُ أَجفاني بِتَصعيدِ زَفرَتي",45,"ي",1,0],["وَحزت به مجدا وَفخرا وَسوددا","فارّخته لِلسَّيد الماجِد الفَخر",46,"ر",1,0],["وحزت شفاعات البتول فمثلها","شفيعٌ وأنت بالشفاعة تُسعَف",47,"ف",1,0],["وحزت المنتهى درساً وبحثاً","وغايته وغايات الكلام",48,"م",1,0],["وحُزْتَ مكارم الأخلاق طرًّا","ومنها جئت بالعجب العجاب",49,"ب",1,0],["وحزب من العالين يهتف بالثنا","عليه بوحيٍ كدْتُ أسمعه جهرا",50,"ر",2,0],["وحزب من الله في عونها","وذلك أكبر أعوانها",51,"ن",3,0],["وحزتَ من سعد مسعود عظيم منى","تضحي الليالي لما قد نلتهُ خدما",52,"م",2,0],["وحُزتم شتيت الفخر حتى أتاكُمُ","بغايتهِ الغوْرُ المُباعِدُ والنَّجْدُ",53,"د",1,0],["وحزامةٍ أغنت عن الأشياع إذ","مثلت لديهِ فوارساً وسنوّرا",54,"ر",2,0],["وحزم وعزم واتقاء وعفة","وخلق وأخلاق وفرع ومحتد",55,"د",1,0],["وحُزْتَ مِنَ المناقِبِ باتّفاقٍ","نَصِيباً لا يُدانيهِ مُداني",56,"ي",1,0],["وَحزنُك اليوم عُقبى ما سُررتَ به","حيناً وعقبى الّذي تلتذّه الألمُ",57,"م",1,0],["وحزتُ كراماتِ الخلائق وادعاً","وشاطرني ضيقَ المكانِ الحُلاحِلُ",58,"ل",1,0],["وَحَزمٌ يَهُزُّ الراسِياتِ ثَباتُهُ","وَعَزمٌ يُحاكي الزَندَ ماضيُهُ قَدحا",59,"ح",2,0],["وحزنه عليه واهتمامه","بما دهاه منه واغتمامه",60,"ه",1,0],["وحزن البدر له فانكسفا","وناحت الجن عليه أسفا",60,"ف",2,0],["وَحُزْتَ أَفْصَحَ مَنْ يَهْدِي وَأَوْضَحَ مَنْ","يُبْدِي وأَرْجَحَ مَنْ يُعزى إلى نَسَبِ",61,"ب",1,0],["وَحُزْتَ جَمالاً لَيْسَ فِي الخَلْقِ مِثْلُهُ","بِهِ دَائِماً قَلْبِي يَهيمُ وَيُشْغَفُ",62,"ف",1,0],["وحزب الإله الخائطي حومة الوغى","ويحمونها بالمرهفات الصوارم",63,"م",1,0]]}