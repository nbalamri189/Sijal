://www.aldiwan.net/poem33429.html","مجزوء الكامل"],[400,"مولاي يا علم المعالي","https://www.aldiwan.net/poem33483.html","مجزوء الكامل"],[400,"وافى نظامك يا سعيد","https://www.aldiwan.net/poem33945.html","مجزوء الكامل"],[400,"إلام أرى عاذلي في تعب","https://www.aldiwan.net/poem34155.html","المتقارب"],[400,"القلب أعلم يا عذول بدائه","https://www.aldiwan.net/poem34180.html","الكامل"],[413,"أسفا على تلك المحاسن","https://www.aldiwan.net/poem53829.html","مجزوء الكامل"],[429,"هل في قطار النصر نسر واقع","https://www.aldiwan.net/poem12385.html","الكامل"],[434,"بين العذيب فبانه المتناوح","https://www.aldiwan.net/poem2620.html","الكامل"],[436,"إلى أي ذكر غير ذكرك أرتاح","https://www.aldiwan.net/poem34787.html","الطويل"],[438,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[446,"أترى لداء صبابتي ابلال","https://www.aldiwan.net/poem53722.html","الكامل"],[450,"خطرنا بحكم اللهو للسفح خطرة","https://www.aldiwan.net/poem13693.html","الطويل"],[450,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[451,"ألقاك في وطني الحبيب الأول","https://www.aldiwan.net/poem61630.html","الكامل"],[456,"نديمي وما الناس إلا السكارى","https://www.aldiwan.net/poem56204.html","المتقارب"],[456,"دعها تكن كالسلف من أخواتها","https://www.aldiwan.net/poem56263.html","البسيط"],[459,"بني عمنا كفوا العضيهة أنها","https://www.aldiwan.net/poem15099.html","الطويل"],[459,"يظل الدين مبتهجا طروبا","https://www.aldiwan.net/poem15414.html","الوافر"],[459,"يا للصوارم والرماح الذبل","https://www.aldiwan.net/poem15925.html","الكامل"],[459,"أسيف سل أم ذرب نطوق","https://www.aldiwan.net/poem16020.html","الوافر"],[459,"يسيل دماء الدارعين ودمعه","https://www.aldiwan.net/poem16165.html","الطويل"],[462,"قلبي بذاك الخال ليس بخال","https://www.aldiwan.net/poem3230.html","عموديه"],[462,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[462,"ما أنس لا أنس الجزيرة ملعباً","https://www.aldiwan.net/poem3356.html","عموديه"],[462,"يا طارداً بالهجر لهوي","https://www.aldiwan.net/poem3408.html","عموديه"],[462,"أعجبت من خد صفا وتلهبا","https://www.aldiwan.net/poem3445.html","عموديه"],[462,"عيون المها مالي بسحرك من يد","https://www.aldiwan.net/poem3556.html","عموديه"],[462,"لتذكري ظبيات سلع والنقا","https://www.aldiwan.net/poem3619.html","عموديه"],[475,"قلب كما شاء التفرق موجع","https://www.aldiwan.net/poem15245.html","الكامل"],[498,"طيبوا بنا نحن طيب","https://www.aldiwan.net/poem38079.html","المجتث"],[504,"اطلت على افقك الزاهر","https://www.aldiwan.net/poem2425.html","المتقارب"],[513,"لك أن تقول إذا أردت وتفعلا","https://www.aldiwan.net/poem12207.html","الكامل"],[549,"توق ديار الحي فهي المقاتل","https://www.aldiwan.net/poem47325.html","الطويل"],[556,"أنت قيد الوجود إن غبت غابا","https://www.aldiwan.net/poem34952.html","الخفيف"],[561,"أثار الهوى سجع الحمام المغرد","https://www.aldiwan.net/poem13598.html","الطويل"],[573,"نفس تحن إلى مها","https://www.aldiwan.net/poem3017.html","مجزوء الكامل"],[573,"كحل العيون بمرود من عسجد","https://www.aldiwan.net/poem3085.html","الكامل"]],"verses":[["وَيُزيغُني عَمّا أُجِنُّ مُخاتِلاً","وَالأَورَقُ العاديُّ لا يَتَزَلزَلُ",0,"ل",1,0],["ويزْعُمُ أنّ الحُبَّ عارٌ على الفتى","أما علِموا أني رَضيتُ بِعارِهِ",1,"ر",2,0],["ويَزْجُرُها مني أُشَيْعِثُ يرْتَدي","بأبيضَ يُلقي عنهُ أعْباءَ ثارِهِ",1,"ر",2,0],["ويَزْأَرُ في حافاتِها كُلُّ ضَيْغَمٍ","إذا كَلَّ فيها نابُهُ خَدَشَ الظُّفْرُ",2,"ر",1,0],["ويُزِيرُها أرْضَ العَدوِّ صَوافِنا","تَخْتالُ زَهْواً في الوَغى ومَراحا",3,"ح",2,0],["وَيَزْدَحِمُوا مُسْتِبْسِلِينَ وَيَصْطَلُوا","عَلَى الكَرِّ نِيرَاناً تَلِيهِنَّ نِيرَانُ",4,"ن",1,0],["وَيَزيدُهُ كَلَفاً بِهَا عُذَّالُهُ","فِيها فَمَا يَثْنِيهِ عَنْهَا ثَانِ",5,"ن",1,0],["وَيَزِيدُ تَوْكِيدَ الهَوَى تَقْدِيرُهُ","مَا أَنْتَ مُسْتَامٌ وَمَا سَتْسَامُ",6,"م",1,0],["ويزبد أعلى الموج حتى كأنه","هضاب إلى أطرافها الثلج يخلص",7,"ص",1,0],["وَيَزيدُ قَد عَلِمَت قُرَيشٌ أَنَّهُ","غَمرُ البُحورِ إِلى العُلى سَوّارُ",8,"ر",1,0],["وَيَزيدُ فِيَّ إِذا رَأَي","تُكَ في النَدى خُلُقٌ جَديدُ",9,"د",1,0],["ويزين رفعة بيته بجلالهِ","فكأنَّما هي في السماء مصابح",10,"ح",1,0],["ويزيدني من غيثِه","وغياثِه الهَزِم السِّقاءِ",11,"ق",3,0],["ويزعُمُ أنني رجلٌ مُلِحٌّ","وما ألححتُ إلا باكتسابِهْ",12,"ب",2,0],["ويزْعُمُني صحَّفْتُ في الشعر كاذباً","مُلِطَّاً وكم نكَّلتُ من كاذب مُلطّْ",13,"ط",1,0],["وَيُزاحُ الخَتمُ عَنها مِثلَما يَنشَقُّ عَنّي","وَهيَ لا تَفقَهُ مَعناها وَإِنّي لَستُ أَدري",14,"ي",1,0],["وَيَزرَعُ أَولادَهُ الوالِدُ","لِتَحصِدَهُم شَفَراتُ السُيوف",15,"ف",1,0],["وَيَزيدُ في شَوقي إِلَيها أَنَّها","كَالصَوتِ لَم يُسفِر وَلَم يَتَقَنَّعِ",16,"ع",1,0],["وَيَزيدُني تَلَفاً فَأَذكُرُ فِعلَهُ","كَالمِسكِ تَسحَقُهُ الأَكُفُّ فَيَعبَقُ",17,"ق",1,0],["ويُزحزِحونَ صُخورَهُ","ويعابِثونَ زُهورَهُ",18,"ه",1,0],["ويزيد إشراقاً على","إشراقهِ مهما يقارب",19,"ب",1,0],["ويزدهى بخداع","وقول زُورِومَين",20,"ن",1,0],["ويزدهى الركن والبيت الحرام به","والقدس والهند قاصيها ودانيها",21,"ي",3,0],["وَيُزَوِّرونَ قُبورَهُم كَقُصورِهُم","وَالأَرضُ تَضحَكُ وَالرُفاتُ السافي",22,"ي",1,0],["وَيَزينُ كُلَّ يَتيمَةٍ","فَمُهُ وَتَحسَبُها تَزينُهُ",23,"ن",2,0],["وَيَزيدُني غَضَبُ الأَعادي قَسوَةً","وَيُلِمُّ بي عَتبُ الصَديقِ فَأَجزَعُ",24,"ع",1,0],["ويزيفُ نحو القِرنِ خَطْرُ مَصاعبٍ","تُطوَى لهن على الأوامِ مشارعُ",25,"ع",1,0],["وَيَزيدُهُ وَحشاً تَقارُضُ وَحشِها","وَصلَينِ بَينَ أَحِبَّةٍ وَحَبائِبِ",26,"ب",1,0],["ويَزيدُهُ ضُعْفُ الخُصورِ إذا انثَنَتْ","للوَجْدِ أَضعافاً على أضعافِ",27,"ف",1,0],["وَيَزورُنا جَبريلُ في أَبياتِنا","بِفَرائِضِ الإِسلامِ وَالأَحكامِ",28,"م",1,0],["وَيُزري بالفَتى الإِعدامَ حَتّى","مَتى يُصِبِ المَقالَ يُقَل أَساءَ",29,"ا",2,0],["وَيَزورُني في غَيبَتي وَيَحوطُني","في أَوبَتي وَيَعودُني في مَوطِني",30,"ي",1,0],["ويزيد فتنتها باغرابِ","حزنٌ وراءَ الحسن مخبوءُ",31,"ب",3,0],["وَيُزهى لَهُ قَومٌ وَلَم يُمدَحوا بِهِ","إِذا مَثَلَ الراوي بِهِ أَو تَمَثَّلا",32,"ل",2,0],["وَيَزيدُها مَرُّ اللَيالي جِدَّةً","وَتَقادُمُ الأَيّامِ حُسنَ شَبابِ",33,"ب",1,0],["ويزيدُهُم ناراً وقودُ قريحتي","وبلوغُ أخباري إلى الأقطارِ",34,"ر",1,0],["وَيَزعُمُ تارَةً أَن لَيسَ شَيءٌ","سِوى الأَمرِ الَّذي عَزَمَ العَميدُ",35,"د",1,0],["وَيَزيدُ وَاِبنُ يَزيدَ نالا مُهلَةً","في المَجدِ وَاِقتَدَحا بِزَندٍ واري",36,"ر",2,0],["وَيَزجُرُ الناسَ إِذا تَكَلَّما","مُفَخَّماً مُجَهوَراً مُغَلصِما",37,"م",2,0],["وَيَزعَمُ أَنّي لَهُ حافِظٌ","وَأَينَ خَليلٌ تَراهُ وَفى",38,"ا",1,0],["ويُزِيحُ مُلْكَ اللَّهِ منكم عَنوَةً","لِيُبيحَهُ أهلَ التُّقَى ويُنيلا",39,"ل",2,0],["وَيَزيدُهُ عُذراً لَدَينا أَنَّهُ","سَدرانُ لَيسَ بِعالِمٍ ما تَعلَمُ",40,"م",1,0],["وَيزيدها دلاً على الأسماع ما","تبدي لَها الأسماع من إعزاز",41,"ز",1,0],["ويزحف الكون على خاطري","كأنه في مقلة الساهر",42,"ر",1,0],["ويزيح عن ماضي العصور ستارها","فترى بها الغادين والرواحا",43,"ح",2,0],["ويَزُورُني أسَدُ العَرينِ وقد هَمَى","أسَدُ النّجوم على الرُّبى بهَمائم",44,"م",1,0],["وَيَزِيدُ عَيْشَهُمَا رِضًى","قَلْبَاهُمَا الْمُتَآلِفَانِ",45,"ن",1,0],["وَيَزيِدُ مُرْهِقَةَ الفُرُوضِ نَوَافِلاً","مِنْ سَدِّ خَلاَّتٍ وَنَفْعِ خَلاَئِقِ",46,"ق",1,0],["وَيَزِيدُ فَضْلَكَ فِي التقَدُّمِ مَا بِهِ","مِنْ قُدْوَةٍ لِلقَادِرِ المُتَأَخِّرِ",47,"ر",1,0],["ويزرعني في السحاب الثقال","وراء المدار",48,"ر",1,0],["ويزدري شعري.. ويزدريني","يال شقاء البلبل السجين",49,"ن",1,0],["ويُزْهي العُيونَ الدُّعْجَ أَنّ سَوادَها","شَبِيهٌ بما ضُمَّت عليه مَحابِرُهْ",50,"ر",2,0],["ويزيدُ فيهِ بالجمال تَدَلُّهي","إنِّي امرؤٌ، حبُّ الجمال: شعاري",51,"ر",2,0],["وَيُزْرِي بِعَقْل المَرْءِ قِلَّة ُ مَالِهِ","يحمقه الأقوام وهو لبيبُ",52,"ب",1,0],["ويزعم برهانا من الغيب قائما","له مثلنا ان الكذوب لفي خسر",53,"ر",1,0],["ويزيد كالمجهود حتى كأنما","أشابته أحداث الليالي الظوالم",54,"م",1,0],["ويزرى بنشرِ رياحِ الشَّذَى","وأعذبُ طعماً من السَّلسبيلْ",55,"ل",1,0],["وَيُزْرِى بالشمُوسٍ إذا تبدَّتْ","وبالأقمارِ إن كَشفتْ سُتورَا",56,"ر",2,0],["ويَزعُمني مِثلَ الأُلَى أَحدَ قُوابِه","وَخَالُوهُ في شَأوِ القَرِيضِ مُحَلِّيَا",57,"ي",2,0],["وَيُزجي الظَعائِنَ صَوبُ البُروقِ","وَبِشرُكَ ذا بارِقٌ لا يَغُرّ",58,"ر",1,0],["ويزهد في قلب تقسمن لبه","وما خلت منهوبا تقسم راجعا",59,"ع",2,0],["ويزيد في مدح المليك تهذبا","تهذى به الفصحاء في تهذيبه",60,"ب",2,0],["ويزيد عيدك من رضاك فإنه","من يعط كنز رضاك يغن ويغنم",61,"م",1,0],["وَيُزري بِهِ في الناسِ قِلَّةُ عَقلِهِ","وَإِن كَرُمَت أَعراقُهُ وَمَناسِبُه",62,"ب",2,0],["ويزعمُ أنّه في العلم باب","ويأتي مثل أخلاق الجهول",63,"ل",1,0],["ويزيد الملاح في ثورة اليم","نشاطا مهارة الربّان",64,"ن",1,0],["ويزدهيني الخبال","في غافيات النواظر",65,"ر",1,0],["ويزهو بخديهِ عِذارٌ وحولَه","عققاربُ من تَلْسَبْهُ ما فيه مَخْرَجا",66,"ج",2,0],["ويزِيدني ذلّ الخطوبِ تعظُّماً","وتسلُّطُ الأيّامِ عِزَّ مكانِ",67,"ن",1,0],["ويَزيدها حسناً على تَحْسينها","مُلْك العزيز لها أبي المنصور",68,"ر",1,0],["ويَزْدَهِي الدِّين بالمُعِزّ لدي","ن الله والمُرْهَفَاتُ واليَلَبُ",69,"ب",1,0],["ويزيد فيك رجاء قلبي قوةً","أن صار بي نسب إلى الأنصار",70,"ر",1,0],["وَيَزيدُ طول صَلاتِهِ فَيخِفُّها","لِسَماعِ صَوتِ الطِّفلِ ذي الأَشجانِ",71,"ن",1,0],["وَيَزُفُّهُ سَبعونَ أَلفَ مُقَرَّبٍ","وَالناسُ مِن مَثنى وَمِن وحدانِ",71,"ن",1,0],["وَيَزينُ عِطفَيهِ وَقا","رُ الشَيبِ في عَطفِ الصِبا",72,"ب",2,0],["وَيَزْدَهِيهِ ابْتِهَاجٌ","كَالْخَرْقِ يَحْظَى بِضَيْفِ",73,"ف",1,0],["وَيَزيدُني شَوقاً إِلَيهِ أَن أَرى","أَهلَ الفَضائِلِ عادِمي متَفضِّل",74,"ل",1,0],["وَيَزيدني ولعاً بها تَذكيرُها","وَطَني وشمسَ صُبوَّتي وسمائي",75,"ا",2,0],["وَيُزْوَى لَهُ شَرْقُ البِلادِ وَغَرْبُها","لِيَبْلُغَ مِنْهَا مُلْكُهُ كُلَّ ما يُزوَى",76,"و",2,0],["وَيُزجي سَحاباً مِن سَنابِكِ خَيلِهِ","بِلَمعِ الظُبى وَالبيض تَجلو الحَناديسا",77,"س",2,0],["ويزيد الفؤاد جرحاً على جرح","أنين النساء والأطفال",78,"ل",1,0],["وَيَزيدُ غَليَ الماءِ ما ذُكرَت","وَالماءُ يُثلجُ غلَّةَ الصَدرِ",79,"ر",1,0],["ويزهو بين عطفيها","هناك النيهُ والقعس",80,"س",1,0],["وَيَزعُمُ أَنَّهُ نازٍ عَلَينا","بِشِرَّتِهِ فَتارِكُنا تَبارا",81,"ر",2,0],["ويزده علماً ومعرفة به","وسعادة لا تنتهي لقصارا",82,"ر",2,0],["ويزرى اتكاء الوجه في رأس ساعد","واسناده في غيرها نوع نقصان",83,"ن",1,0],["ويزيدني جزعا لفقدك صادح","في منزل دان الي لصيق",84,"ق",1,0],["وَيُزجُرُني الإِسلامُ وَالشَيبُ وَالتُقى","وَفي الشَيبِ وَالإِسلامِ لِلمَرءِ زاجِرُ",85,"ر",1,0],["وَيَزِيدُ إبراهيمُ نَا","رِي عِنْدَ بَثِّ الوَجْ