{"poems":[[53,"ما ابيض من لون العوارض أفضل","https://www.aldiwan.net/poem29902.html","الكامل"],[63,"ألا بأبي من حيل دون مزاره","https://www.aldiwan.net/poem46137.html","الطويل"],[63,"بَدَتْ عَقِداتُ الرّمْلِ والجَرَعُ العُفْرُ","https://www.aldiwan.net/poem46213.html","الطويل"],[77,"خذها فقد وضح الصباح ولاحا","https://www.aldiwan.net/poem36645.html","الكامل"],[93,"لذكراك يا حفني في النفس أشجان","https://www.aldiwan.net/poem11210.html","الطويل"],[93,"باعوا المخلد بالحطام الفاني","https://www.aldiwan.net/poem11248.html","الكامل"],[93,"ملك العراق تجلة وسلام","https://www.aldiwan.net/poem11313.html","الكامل"],[88,"وقفت على البسفور والريح عاصف","https://www.aldiwan.net/poem44421.html","الطويل"],[27,"أرق العيون فنومهن غرار","https://www.aldiwan.net/poem5743.html","الكامل"],[47,"هل للفصاحة والسماحة","https://www.aldiwan.net/poem25328.html","مجزوء الكامل"],[72,"إنسان عيني ساهر بك سافح","https://www.aldiwan.net/poem18483.html","الكامل"],[51,"ما أستزيد لقاسم من ربه غير البقاء","https://www.aldiwan.net/poem7960.html","مجزوء الكامل"],[51,"صديق ليس يمكن من خطابه","https://www.aldiwan.net/poem8653.html","الوافر"],[51,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[91,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[91,"جلست وقد هجع الغافلون","https://www.aldiwan.net/poem8802.html","عموديه"],[91,"أنا لست بالحسناء أول مولع","https://www.aldiwan.net/poem8980.html","عموديه"],[70,"وعد الزيارة طرفه المتملق","https://www.aldiwan.net/poem42802.html","الكامل"],[92,"يا أيها الطفل الذي قد","https://www.aldiwan.net/poem38926.html","مجزوء الكامل"],[89,"ماذا برقراق السحائب","https://www.aldiwan.net/poem44965.html","مجزوء الكامل"],[85,"روحي ولذة عيني","https://www.aldiwan.net/poem7101.html","المجتث"],[85,"عش للخلافة ترضاها وترضيها","https://www.aldiwan.net/poem7528.html","البسيط"],[85,"أجل وإن طال الزمان موافي","https://www.aldiwan.net/poem62840.html","الكامل"],[85,"يا ناعما رقدت جفونه","https://www.aldiwan.net/poem63004.html","مجزوء الكامل"],[43,"الحزن يقلق والتجمل يردع","https://www.aldiwan.net/poem9724.html","الكامل"],[62,"إن العيون إذا نطقت تخاوصت","https://www.aldiwan.net/poem52341.html","الكامل"],[45,"ما أنت للكلف المشوق بصاحب","https://www.aldiwan.net/poem10671.html","الكامل"],[61,"عاف الوقوف على المحل العافي","https://www.aldiwan.net/poem51546.html","الكامل"],[58,"الله أكرمنا بنصر نبيه","https://www.aldiwan.net/poem30867.html","الكامل"],[58,"وكم ساع ليثري لم ينله","https://www.aldiwan.net/poem31206.html","الوافر"],[66,"إني ليطربني العذول فأنثني","https://www.aldiwan.net/poem41355.html","الكامل"],[97,"أمسيت أشكو الضيق والأينا","https://www.aldiwan.net/poem24793.html","أحذ الكامل"],[44,"لهان علينا أن نقول وتفعلا","https://www.aldiwan.net/poem30373.html","الطويل"],[44,"لو أن دهرا رد رجع جواب","https://www.aldiwan.net/poem30590.html","الكامل"],[69,"ما للزمان عن المروءة عار","https://www.aldiwan.net/poem28776.html","الكامل"],[105,"يقول البرق شر مستطير","https://www.aldiwan.net/poem43067.html","الوافر"],[39,"هل يدنيك من أجارع واسط","https://www.aldiwan.net/poem53778.html","الكامل"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"جفاني النميري فيمن جفا","https://www.aldiwan.net/poem27311.html","المتقارب"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[46,"وعظ الزمان فما فهمت عظاته","https://www.aldiwan.net/poem23321.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85626","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39684","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16670","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55384","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55048","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54882","الكامل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199474","المتقارب"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199472","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54279","الطويل"],[106,"موكب الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=179775",""],[58,"يُغطي عيوب المرء كثرة ُ ماله","https://www.poetsgate.com/ViewPoem.aspx?id=22551",""]],"verses":[["وَيُزيغُني عَمّا أُجِنُّ مُخاتِلاً","وَالأَورَقُ العاديُّ لا يَتَزَلزَلُ",0,"ل",1,0],["ويزْعُمُ أنّ الحُبَّ عارٌ على الفتى","أما علِموا أني رَضيتُ بِعارِهِ",1,"ر",2,0],["ويَزْجُرُها مني أُشَيْعِثُ يرْتَدي","بأبيضَ يُلقي عنهُ أعْباءَ ثارِهِ",1,"ر",2,0],["ويَزْأَرُ في حافاتِها كُلُّ ضَيْغَمٍ","إذا كَلَّ فيها نابُهُ خَدَشَ الظُّفْرُ",2,"ر",1,0],["ويُزِيرُها أرْضَ العَدوِّ صَوافِنا","تَخْتالُ زَهْواً في الوَغى ومَراحا",3,"ح",2,0],["وَيَزْدَحِمُوا مُسْتِبْسِلِينَ وَيَصْطَلُوا","عَلَى الكَرِّ نِيرَاناً تَلِيهِنَّ نِيرَانُ",4,"ن",1,0],["وَيَزيدُهُ كَلَفاً بِهَا عُذَّالُهُ","فِيها فَمَا يَثْنِيهِ عَنْهَا ثَانِ",5,"ن",1,0],["وَيَزِيدُ تَوْكِيدَ الهَوَى تَقْدِيرُهُ","مَا أَنْتَ مُسْتَامٌ وَمَا سَتْسَامُ",6,"م",1,0],["ويزبد أعلى الموج حتى كأنه","هضاب إلى أطرافها الثلج يخلص",7,"ص",1,0],["وَيَزيدُ قَد عَلِمَت قُرَيشٌ أَنَّهُ","غَمرُ البُحورِ إِلى العُلى سَوّارُ",8,"ر",1,0],["وَيَزيدُ فِيَّ إِذا رَأَي","تُكَ في النَدى خُلُقٌ جَديدُ",9,"د",1,0],["ويزين رفعة بيته بجلالهِ","فكأنَّما هي في السماء مصابح",10,"ح",1,0],["ويزيدني من غيثِه","وغياثِه الهَزِم السِّقاءِ",11,"ق",3,0],["ويزعُمُ أنني رجلٌ مُلِحٌّ","وما ألححتُ إلا باكتسابِهْ",12,"ب",2,0],["ويزْعُمُني صحَّفْتُ في الشعر كاذباً","مُلِطَّاً وكم نكَّلتُ من كاذب مُلطّْ",13,"ط",1,0],["وَيُزاحُ الخَتمُ عَنها مِثلَما يَنشَقُّ عَنّي","وَهيَ لا تَفقَهُ مَعناها وَإِنّي لَستُ أَدري",14,"ي",1,0],["وَيَزرَعُ أَولادَهُ الوالِدُ","لِتَحصِدَهُم شَفَراتُ السُيوف",15,"ف",1,0],["وَيَزيدُ في شَوقي إِلَيها أَنَّها","كَالصَوتِ لَم يُسفِر وَلَم يَتَقَنَّعِ",16,"ع",1,0],["وَيَزيدُني تَلَفاً فَأَذكُرُ فِعلَهُ","كَالمِسكِ تَسحَقُهُ الأَكُفُّ فَيَعبَقُ",17,"ق",1,0],["ويُزحزِحونَ صُخورَهُ","ويعابِثونَ زُهورَهُ",18,"ه",1,0],["ويزيد إشراقاً على","إشراقهِ مهما يقارب",19,"ب",1,0],["ويزدهى بخداع","وقول زُورِومَين",20,"ن",1,0],["ويزدهى الركن والبيت الحرام به","والقدس والهند قاصيها ودانيها",21,"ي",3,0],["وَيُزَوِّرونَ قُبورَهُم كَقُصورِهُم","وَالأَرضُ تَضحَكُ وَالرُفاتُ السافي",22,"ي",1,0],["وَيَزينُ كُلَّ يَتيمَةٍ","فَمُهُ وَتَحسَبُها تَزينُهُ",23,"ن",2,0],["وَيَزيدُني غَضَبُ الأَعادي قَسوَةً","وَيُلِمُّ بي عَتبُ الصَديقِ فَأَجزَعُ",24,"ع",1,0],["ويزيفُ نحو القِرنِ خَطْرُ مَصاعبٍ","تُطوَى لهن على الأوامِ مشارعُ",25,"ع",1,0],["وَيَزيدُهُ وَحشاً تَقارُضُ وَحشِها","وَصلَينِ بَينَ أَحِبَّةٍ وَحَبائِبِ",26,"ب",1,0],["ويَزيدُهُ ضُعْفُ الخُصورِ إذا انثَنَتْ","للوَجْدِ أَضعافاً على أضعافِ",27,"ف",1,0],["وَيَزورُنا جَبريلُ في أَبياتِنا","بِفَرائِضِ الإِسلامِ وَالأَحكامِ",28,"م",1,0],["وَيُزري بالفَتى الإِعدامَ حَتّى","مَتى يُصِبِ المَقالَ يُقَل أَساءَ",29,"ا",2,0],["وَيَزورُني في غَيبَتي وَيَحوطُني","في أَوبَتي وَيَعودُني في مَوطِني",30,"ي",1,0],["ويزيد فتنتها باغرابِ","حزنٌ وراءَ الحسن مخبوءُ",31,"ب",3,0],["وَيُزهى لَهُ قَومٌ وَلَم يُمدَحوا بِهِ","إِذا مَثَلَ الراوي بِهِ أَو تَمَثَّلا",32,"ل",2,0],["وَيَزيدُها مَرُّ اللَيالي جِدَّةً","وَتَقادُمُ الأَيّامِ حُسنَ شَبابِ",33,"ب",1,0],["ويزيدُهُم ناراً وقودُ قريحتي","وبلوغُ أخباري إلى الأقطارِ",34,"ر",1,0],["وَيَزعُمُ تارَةً أَن لَيسَ شَيءٌ","سِوى الأَمرِ الَّذي عَزَمَ العَميدُ",35,"د",1,0],["وَيَزيدُ وَاِبنُ يَزيدَ نالا مُهلَةً","في المَجدِ وَاِقتَدَحا بِزَندٍ واري",36,"ر",2,0],["وَيَزجُرُ الناسَ إِذا تَكَلَّما","مُفَخَّماً مُجَهوَراً مُغَلصِما",37,"م",2,0],["وَيَزعَمُ أَنّي لَهُ حافِظٌ","وَأَينَ خَليلٌ تَراهُ وَفى",38,"ا",1,0],["ويُزِيحُ مُلْكَ اللَّهِ منكم عَنوَةً","لِيُبيحَهُ أهلَ التُّقَى ويُنيلا",39,"ل",2,0],["وَيَزيدُهُ عُذراً لَدَينا أَنَّهُ","سَدرانُ لَيسَ بِعالِمٍ ما تَعلَمُ",40,"م",1,0],["وَيزيدها دلاً على الأسماع ما","تبدي لَها الأسماع من إعزاز",41,"ز",1,0],["ويزحف الكون على خاطري","كأنه في مقلة الساهر",42,"ر",1,0],["ويزيح عن ماضي العصور ستارها","فترى بها الغادين والرواحا",43,"ح",2,0],["ويَزُورُني أسَدُ العَرينِ وقد هَمَى","أسَدُ النّجوم على الرُّبى بهَمائم",44,"م",1,0],["وَيَزِيدُ عَيْشَهُمَا رِضًى","قَلْبَاهُمَا الْمُتَآلِفَانِ",45,"ن",1,0],["وَيَزيِدُ مُرْهِقَةَ الفُرُوضِ نَوَافِلاً","مِنْ سَدِّ خَلاَّتٍ وَنَفْعِ خَلاَئِقِ",46,"ق",1,0],["وَيَزِيدُ فَضْلَكَ فِي التقَدُّمِ مَا بِهِ","مِنْ قُدْوَةٍ لِلقَادِرِ المُتَأَخِّرِ",47,"ر",1,0],["ويزرعني في السحاب الثقال","وراء المدار",48,"ر",1,0],["ويزدري شعري.. ويزدريني","يال شقاء البلبل السجين",49,"ن",1,0],["ويُزْهي العُيونَ الدُّعْجَ أَنّ سَوادَها","شَبِيهٌ بما ضُمَّت عليه مَحابِرُهْ",50,"ر",2,0],["ويزيدُ فيهِ بالجمال تَدَلُّهي","إنِّي امرؤٌ، حبُّ الجمال: شعاري",51,"ر",2,0],["وَيُزْرِي بِعَقْل المَرْءِ قِلَّة ُ مَالِهِ","يحمقه الأقوام وهو لبيبُ",52,"ب",1,0]]}