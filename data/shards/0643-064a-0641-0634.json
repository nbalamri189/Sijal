{"poems":[[61,"","https://poetry.dctabudhabi.ae/diwan/poem/116971","البسيط"],[102,"لحبل العقيم","https://www.poetsgate.com/ViewPoem.aspx?id=183580",""],[214,"راح يرنو مرنح الاعطاف","https://www.aldiwan.net/poem13327.html","الخفيف"],[556,"من لداع لا يجاب","https://www.aldiwan.net/poem48097.html","مجزوء الرمل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71047","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27246","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93812","الخفيف"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87378","الخفيف"],[3709,"","https://poetry.dctabudhabi.ae/diwan/poem/36052","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128914","الخفيف"],[4682,"خبز الشعير","https://www.poetsgate.com/ViewPoem.aspx?id=64804",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[6102,"جيهان ..","https://www.poetsgate.com/ViewPoem.aspx?id=183612",""],[6218,"آن للصبر يغضب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65868&r=&rc=22",""]],"verses":[["كيفَ شهودكَ والأنباءُ واقعةٌ","عمّا قليل ولا تدري بما يقعُ",0,"ع",1,0],["كيف شئنا زهراً فأعشب شوكاً؟","كان فينا غش البذور دفينا",1,"ن",2,0],["كيف شيطان سلوتي فيه اخشى","مع شهاب لدى العلا خطاف",2,"ف",1,0],["كَيفَ شَكواي زَماناً","كانَ لي فيهِ الشّبابُ",3,"ب",1,0],["كيف شُكْري ومِنْ أَياديك بَعْثي","بعد لَبْثي من بين أَطباق قَبْري",4,"ر",2,0],["كيف شاءتْ مشيئةُ المتلاشي","ولها الحكم ان تشا والقضاء",5,"ا",2,0],["كيف شكوى الأسى وفي الجيد طوق","وخضاب الكفين ليس بخافي",6,"ف",2,0],["كيفَ شاءَت تَدورُ بَضعةُ لحمٍ","في فمٍ للكَلام يَبغي شُيوعا",7,"ع",2,0],["كَيفَ شُكري بَني عَلِيّ بن يَحيى","وَهُمُ فَوقَ كُلِّ شُكرٍ وَحَمدِ",8,"د",1,1],["كيف شقت جدرانه وتداعت","شرفات منه الى الانهدام",9,"م",1,0],["كيف شيخ ولابس ثوب قصير","والتشهد ما يفارق إصبعه",10,"ع",2,0],["كيف شاد الأجداد حصناً حصيناً","صدّ عنها عدوها فحماها",11,"ا",3,0],["كَيفَ شَلَّتْ بِغُنجِها كَلِماتِي","فَإِذا الصَّمتُ بَينَنا تُرجُمانُ ؟ )",12,"ن",1,0],["كيف شِعْرٌ يجيء دون قتالٍ","أجملُ الشعر بالأظافر يُكتبْ",13,"ب",1,0]]}