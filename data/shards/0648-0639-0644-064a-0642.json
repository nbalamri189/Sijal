{"poems":[[47,"أتراك تسمع للحمام الهتف","https://www.aldiwan.net/poem65160.html","الكامل"],[69,"حي بلبيس منزلا في العماره","https://www.aldiwan.net/poem18062.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54948","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142018","المديد"],[47,"أتَرَاكَ تَسْمَعُ، للحَمَامِ الهُتَّفِ","https://www.poetsgate.com/ViewPoem.aspx?id=32843",""],[133,"يا نفس مالك والانين","https://www.aldiwan.net/poem67456.html","مجزوء الكامل"],[228,"هذه القصة لا شأن لها","https://www.aldiwan.net/poem41916.html","الرمل"],[242,"نلنا ولولا الحب ما نلناها","https://www.aldiwan.net/poem19725.html","الكامل"],[275,"هبط الليل ولما أن دجا","https://www.aldiwan.net/poem35240.html","الرمل"],[333,"لا أنا خالد ولا أمنياتي","https://www.aldiwan.net/poem54952.html","الخفيف"],[333,"فوق هذي الربا أقمت وحيدا","https://www.aldiwan.net/poem54989.html","الخفيف"],[333,"هتف الشاطىء بالمدح","https://www.aldiwan.net/poem55007.html","مجزوء الرمل"],[371,"لا كمثل القضيب والحق","https://www.aldiwan.net/poem17073.html","الخفيف"],[438,"أنجد الصب وغاروا","https://www.aldiwan.net/poem12645.html","مجزوء الرمل"],[500,"اذهب الكاس فعرف الفجر","https://www.aldiwan.net/poem9813.html","مجزوء الرمل"],[543,"قد بدا لما بدا","https://www.aldiwan.net/poem47448.html","عموديه"],[563,"يا من أرومهم بكل مرام","https://www.aldiwan.net/poem35091.html","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87165","الخفيف"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34397","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38207","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77545","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62723","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79852","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124730","الرمل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108476","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77296","الرمل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93610","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94299","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204703","الخفيف"],[3135,"","https://poetry.dctabudhabi.ae/diwan/poem/105701","الكامل"],[3493,"","https://poetry.dctabudhabi.ae/diwan/poem/100577","الكامل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101227","الكامل"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/132067","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111399","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102752","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102751","الكامل"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105526","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136672",""],[4759,"وجهتي أنت","https://www.poetsgate.com/ViewPoem.aspx?id=204033",""],[5064,"ليلٌ حاتِميٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=199087",""],[5414,"لحن الوفاء …","https://www.poetsgate.com/ViewPoem.aspx?id=180859",""],[5725,"سوف أبكيك","https://www.poetsgate.com/ViewPoem.aspx?id=213664",""],[402,"عاد عهد المدير في اعين الناس","https://www.poetsgate.com/ViewPoem.aspx?id=36831",""],[6068,"سحّتْ دموعي لجّها تهيّيجا -17-","https://www.poetsgate.com/ViewPoem.aspx?id=175813",""]],"verses":[["وَعَلى قُذاذِيَةَ اِنحَطَطنَ بِرايَةٍ","أَوفَت بِقادِمَتي عُقابٍ مُنكَفِ",0,"ف",1,0],["وعَلِيقِي عليه أَرْخَصُ مِنْ ما","لِ المَوارِيثِ في شِرَا ابنِ جُبَارَهْ",1,"ر",2,0],["وَعَلَى قَدرِ مَا تُجَدِّدُهَا الأَقْ","وامُ تَقْوَى وَتَمْجُدُ الأقْوَامُ",2,"م",1,0],["وَعَلَى قَدْرٍ مَا تَعِسْتَ تَنَاهَى","مِنْكَ رِفْقُ بِالتاعِسِينَ وَبِر",3,"ر",1,0],["وعلى قلبي يداك ورضاك","هكذا أهل الغزل",4,"ل",1,0],["وَعلى قَذاذِيَةَ انْحَطَطْنَ بِرَايَةٍ،","أوْفَتْ بقادِمتي عُقابٍ مُنْكَشفِ",5,"ف",1,0],["وعلى قميصك من دِما","قلبي فماذا تصنعين",6,"ن",1,0],["وَعلى قيثار فينوس شَدَت","ربةُ الحِكمَةِ ميزفا النَشيدا",7,"د",2,0],["وَعَلَى قَرَابَتِهِ مَصَابِيحِ الْوَرَى","وَعَلَى صَحَابَتِهِ الْعَمِيمِ هُدَاهَا",8,"ا",3,0],["وعلى قلبي سرَت أنفاسُها","كهبوبِ الريحِ ناراً أجَّجا",9,"ج",2,0],["وعلى قبرك الأشمّ دموعٌ","وسلامٌ مبارك الرحمات",10,"ت",1,0],["وعلى قدر ما يطيقون خافو","ه وراحوا يستمطرون رضاه",11,"ه",1,0],["وعلى قربك منّى","آه ما أبعدني",12,"ي",1,0],["وَعَلى قاتِلي لِباسٌ مِنَ الحُس","نِ تَعالى عَنِ الطِرازِ العالي",13,"ل",2,0],["وعلى قطبِ فَتاوي","هِ منَ الشرعِ المَدارُ",14,"ر",1,0],["وعلى قدر سنا المم","دوح يأتيك المديح",15,"ح",1,0],["وعلى قَصدِه أربى","نِعمَ مولانا المُؤَيَّد",16,"د",1,0],["وعلي قد جادوا بما فوق المنى","والغير ينتظر انكشاف لثام",17,"م",1,0],["وَعَلى قَدر طاقَتي جادَ فكري","فيكَ يا مالِكي بِبَعض المَعاني",18,"ن",2,0],["وَعَلى قَرابتِكَ المقرّرِ فَضلُهُم","وَعلى صَحابَتكَ الَّذينَ همُ همُ",19,"م",1,0],["وَعَليِّ قَدرٍ ما العُلى إِلا لَهُ","إِذ لَم تَكُ العَلياءُ إِلّا في عَلي",20,"ل",2,0],["وَعَلى قبح ذاته","سَكَتَت ما تَكَلَّمت",21,"ت",1,0],["وعليَّ قلبك ليسَ يحنو مُشفِقا","أنا خادم لجمال وجهك مشرقا",22,"ق",2,0],["وعلى قُطب دارة المجد زهواً","فلكُ اليمن بالسعود استنارا",23,"ر",2,0],["وعليٌّ قال يمضي عتقهم","وهو كالتدبير إن كان صلق",24,"ق",1,0],["وعلى قبرك الكريم سلام","ما نشقنا من ذكر فضلك طيبا",25,"ب",2,0],["وَعَلى قُدرَتِهِ سُبحانَهُ","إِن يُرِد خَيراً عَلى تَعجيلِهِ",26,"ل",2,0],["وَعَلى قُلوبهم قَد اِنطَبَع الشَقا","لا الوَعظ يبلغها وَلا التَحذير",27,"ر",1,0],["وعلى قبره عنان امتنان","ما لتسامه الترحم منات",28,"ت",1,0],["وعلى قدر نكبتي جاد شعري","سل عن الشعر إن حلا الآلاما",29,"م",2,0],["وعلى قوائمه وجبهته غدا","متوزعا بدر السما بتمامه",30,"م",2,0],["وعلى قبور جاورته بقربها","منه جميل تحيتي وسلامي",31,"م",2,0],["وعلى قريضة والنضير وسلعم","والوادين وخثعم وزبيدها",32,"د",3,0],["وعلى قدر عقله فاعتب المرء","وحاذر براً يصير عقوقا",33,"ق",2,1],["وعلى قَنَاطِرَةِ الجِبالِ سَطوا ولم","يَدَرُوا لَهُم أًثَراً يُرى مأمُونا",34,"ن",2,0],["وعلى قرابته الرفع جنابهم","الوارثين لعلمه المخزون",35,"ن",1,0],["وعلى قرايتك الذين إذا انتموا","فلهم جدود في العلاء كرام",36,"م",1,0],["وعليَّ قدر من ذؤابة هاشم","عبقت شمائله بطيب المحتد",37,"د",1,0],["وعليُ قدرٍ قد افاضَ على الورى","علماً فجاوزَ قدرهُ جَوزاءها",38,"ا",3,0],["وعلى قربها البعيد لعيني","رهبة العطر خلتني لا أفيق.",39,"ق",1,0],["وعلَى قَلْبٍ طَافَ شَيْخٌ مِنَ الحُزْ","نِ ينُادِي للدَّمْعِ ظَمْأَى القَبِيلَهْ",40,"ل",2,0],["وعلى قمة الجبال تموت ال","ريحُ ، والسحْبُ والسيولُ العواتي",41,"ت",2,0],["وعلى قصره المقابل يهفو","نابض القلب بالغرام إدّلاكِ",42,"ك",1,0],["وعلى قدر ما تجددها الأقوام","تقوى وتمجد الاقفوام",43,"م",1,0],["وعليّ قد مالت فمال لها الهوى","منّ يكما مالت يريد حجيجا",44,"ج",2,0]]}