{"poems":[[88,"صفحة البرق أومضت في الغمام","https://www.aldiwan.net/poem10914.html","الخفيف"],[87,"يا فرنسا نلت أسباب السماء","https://www.aldiwan.net/poem63728.html","الكامل"],[47,"إن شعري سار في كل بلد","https://www.aldiwan.net/poem63530.html","البسيط"],[82,"أعليت بين النجم والدبران","https://www.aldiwan.net/poem31266.html","الكامل"],[146,"قد طال للماطل أن يقتضى","https://www.aldiwan.net/poem58443.html","السريع"],[197,"ما صور أبدع في","https://www.aldiwan.net/poem13150.html","مجزوء الرجز"],[259,"جنون","https://www.aldiwan.net/poem24955.html","مجزوء الرمل"],[319,"أضحى فؤادك نهب الأعين النجل","https://www.aldiwan.net/poem4124.html","البسيط"],[376,"لا يفجعنك غصن البان إن بانا","https://www.aldiwan.net/poem57003.html","الطويل"],[463,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101487","الرمل"],[930,"","https://poetry.dctabudhabi.ae/diwan/poem/132400","الكامل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16910","السريع"],[1065,"","https://poetry.dctabudhabi.ae/diwan/poem/177918","السريع"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112831","المديد"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131328","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27684","الطويل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132322","الخفيف"],[2714,"","https://poetry.dctabudhabi.ae/diwan/poem/199883","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93870","الخفيف"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104675","الرمل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109827","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199925",""],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133954","الرجز"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67999","الخفيف"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99323","الخفيف"],[3484,"","https://poetry.dctabudhabi.ae/diwan/poem/216401",""],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52985","الرمل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62943","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62929","الطويل"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125933","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77182","الخفيف"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97087","المتدارك"],[4185,"","https://poetry.dctabudhabi.ae/diwan/poem/204352","الكامل"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105533","الخفيف"],[4260,"","https://poetry.dctabudhabi.ae/diwan/poem/200368","البسيط"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147272","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139590",""],[4767,"مركز الماجد","https://www.poetsgate.com/ViewPoem.aspx?id=97448",""],[4883,"اصدق قصيده على الاطلاق","https://www.poetsgate.com/ViewPoem.aspx?id=48357",""],[5136,"ريحاننا لا إله إلا الله","https://www.poetsgate.com/ViewPoem.aspx?id=121768",""],[5356,"جنّيةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=204487",""],[5377,"تحية الخروج من العزلة","https://www.poetsgate.com/ViewPoem.aspx?id=61892",""],[5431,"ومضةٌ من تجلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=215817",""],[5648,"برهانه اليا حارت عقول الالباب","https://www.poetsgate.com/ViewPoem.aspx?id=164273",""],[5952,"مَوْسِقِ ال آهَ","https://www.poetsgate.com/ViewPoem.aspx?id=213572",""],[5956,"الحب الجسدي","https://www.poetsgate.com/ViewPoem.aspx?id=182495",""],[5957,"وأنا جئتُ إليكم","https://www.poetsgate.com/ViewPoem.aspx?id=180652",""],[6056,"نصيحة في زمن لايقبل النصيحة","https://www.poetsgate.com/ViewPoem.aspx?id=130520",""],[6201,"تشكّلٌ أولي لزهرة ..على شاهد قبر!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87488&r=&rc=12",""],[6256,"المضيفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65930&r=&rc=18",""]],"verses":[["مَرَّ كَاللَمحِ لَم تَكَد تَقِفُ العَي","نُ عَلى ظِلِّ جِرمِهِ المُتَرامي",0,"م",2,0],["مَرَّ كَالسَهمِ بَينَ تِلكَ الحَنايا","قَد رَماهُ مِنَ المَقاديرِ رامي",0,"م",2,0],["مَركَبٌ لَو سَلَفَ الدَهرُ بِهِ","كانَ إِحدى مُعجِزاتِ القُدَماء",1,"ا",2,0],["مَركَبُ الكَعثَبِ فيهِ لَذَّةٌ","وَشَفاءٌ لِلفَتى مِمّا يَجِد",2,"د",1,0],["مركوزة كالرمح حيثُ ترى له","من طعنه الحلق انعطاف سنانِ",3,"ن",1,0],["مرَّ كما مرَّ نسيمُ الصبا","مزعِزعا بالرِّفقِ ماءَ الأضى",4,"ض",2,0],["مَركَبُها الأَيدي وَفي","هاماتِها أَذنابُها",5,"ه",2,0],["مركبي حِصْنٌ تعاليْ","فاقبلي غدر الجنوحِ!",6,"ح",1,0],["مَركّبُ الجِسم مِن غُصنٍ وَمِن قَمَرٍ","مُقَسَّمُ اللَحظِ بَين الغُنجِ وَالكَحَلِ",7,"ل",1,0],["مركَّبٌ من كَثِيبٍ في نَقىً عَسِرٌ","أن يُرتَقَى خَشِنُ المَسعَى وإن لانا",8,"ن",2,0],["مركوبةٍ جَوْبُ المهاري جوَّها","غَرَرُ المقامِرِ فيه أخسَتْ أو زَكتْ",9,"ت",1,0],["مركباتٌ بسموطٍ الكهربا","اياتٌ رائحاتٌ في حشاه",10,"ه",1,0],["مركوب لهو لجاجة وركاكة","وأراك من ذاك اللجاج البارك",11,"ك",1,0],["مَركِبٌ تَعجَبُ مِن حُسنِهِ","قَد كَنَزَ الفِضَّةَ في تِبرِهِ",12,"ه",1,1],["مرّ كأِيّام الصِّبا وانقضى","وكان أشهى من بلوغ المراد",13,"د",1,0],["مركز الايمان ناشره","شاهر الاسلام والعلم",14,"م",1,0],["مركب له ثلاث نوّعت","اولى ووسطى ثم اخرى فرعت",15,"ت",1,0],["مُرَكّب من سَائِر العَناصِرِ","حقَّ عليه العَقْدُ للخَناصِرِ",16,"ر",1,0],["مركبنا يبغيه برهانُ وجدكم","وأفراده بالذاتِ يطلبها الحدّ",17,"د",1,0],["مركزُ المَجدِ شيخُنَا الشَّيخُ ما العَي","نينِ بَل صاحِبُ الصَّراطِ الصُّراحِ",18,"ح",1,0],["مرك ما ضلت تميم ولا جرت","على إثر أشياخ عن المجد ضلت",19,"ت",1,1],["مركز الفضل من غدا كل قطر","مستمداً من خطه المستقيم",20,"م",1,0],["مَركَزُ المَجدِ الذي مَولى العُلا","ظاهِرُ الفَضلِ وَمَحمودُ السَما",21,"م",2,0],["مركبة في جسم اروع ماجد","يرى قبة الافلاك ظهر كثيب",22,"ب",1,0],["مركبيَ البحرُ في هياج","لا مركبي الشعر والبحورُ",23,"ر",1,0],["مركب القول إذا ما استعملا","في غير ماله بوضع أصلا",24,"ل",2,1],["مركزُ الطبعِ فِي النفوس عَريقٌ","كجبالٍ كثيفةٍ راسياتِ",25,"ت",1,0],["مركبي مثل لمتى ادهم جو","ن ويحكيهما نديمي وراحي",26,"ح",2,0],["مرْكَبٍ لَوّث على حِدّي","وانكسر والموج غَفّى به",27,"ب",2,0],["مركزُ الدنيا جميعاً","منذُ أدوارٍ وأزمن",28,"ن",1,0],["مُرْ كما مَرَّ في الرميةِ سَهْمٌ","مارقاً فيه نَصْلُه والفُوقُ",29,"ق",1,0],["مركبةٌ زرقُ النِّصالِ كأَنّها","اذا هي دُست في الدروعِ قَتِيرُ",30,"ر",1,0],["مر كالسهم ووافى غيره","فشربنا الصاب بعد العسل",31,"ل",1,0],["مركبٌ فيه جاء أفرطسيلا","س بلا عودةٍ عليه هنيه",32,"ه",1,0],["مَركِب لِلكِرامِ إِبنا كِرام","مِن أَبوهُم يُدعى لَدى المَدحِ نصفا",33,"ف",2,0],["مركز الحرب أن سل عضبا","فالضبا دانيات القطوف",34,"ف",1,0],["مركوبك البحر الجواد وما له","من كبوة فلعاً لماذا تعثر",35,"ر",1,0],["مركب لا كفلك نوح ومهد","لا كمهد المسيح عيسى بن مريم",36,"م",1,0],["مركبات بأرساغ لها عجر","لم يفنها من يد البيطار تقليب",37,"ب",1,0],["مركب العشق مبحرٌ في هواها","أبد الدهر مخلصا وأبيَّا",38,"ي",2,0],["مرَّ كفيه على رأس الندى","وعلى عين العلا قد مسحا",39,"ح",2,0],["مركزه للعلم يُغنِى الذي","يسأل عن قول امرىء شاهد",40,"د",1,0],["مركاك قلبيْ وروحيْ رْواق","عن حاسد ٍ مالك وماله",41,"ل",2,0],["مركزنا ليس مثله أحد","سبحانه لا إله إلا الله",42,"ل",2,0],["مُرَكّبُ اللحظِ من سحرٍ ومن خجلٍ","قد قسِّمُ الحسنَ بين النهدِ والخصر",43,"ر",1,0],["مر كالخاطر السريع إذا ما","استيقطت عنه مقلةٌ وسنانه",44,"ن",2,0],["مركبُ النطق أحْرُفٌ دون فكرٍ","لغة الضاد في المحافل خرسا",45,"س",2,0],["مركي على عرفٍ له العرق دساس","علمٍ ورث عرفه على طيب الانساب",46,"ب",1,0],["مُرَّ كالنهر يقطع الأرض سكْرَاً","إذ سيشقى إنِ استفاق الماءُ",47,"ا",2,0],["‏ ‏مَرْكبات الحب إنْ لاقت معيقاً","‏ ‏ تُزْمرُ النهدَ فلا تُخْطي المراما",48,"م",2,0],["مركبٌ للودّ روضي","والأحاسيسُ عطور",49,"ر",1,0],["مركي ٍعلى ضوه أباريق ودلال","ناره لهبها في السماء له وقايد",50,"د",1,0],["مرَّ كالأنسامِ .. غايتُهُ","أنْ يواسي كلَّ مَنْ مَرّهْ",51,"ر",2,0],["مر كالحلم في غلالة عطر","كملاك يزهو بثوب قشيب",52,"ب",1,0]]}