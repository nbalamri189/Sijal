{"poems":[[52,"يا صاحبي أعيناني على طرب","https://www.aldiwan.net/poem64828.html","البسيط"],[106,"","https://poetry.dctabudhabi.ae/diwan/poem/142172","الطويل"],[208,"أحب فمن ذا الذي أخلفه","https://www.aldiwan.net/poem53251.html","المتقارب"],[215,"لم أقض منك مرادى","https://www.aldiwan.net/poem46339.html","المجتث"],[228,"أشعة من مقلتيك ملهبه","https://www.aldiwan.net/poem39698.html","الرجز"],[308,"تداهى عذولي في هواه ولم تكن","https://www.aldiwan.net/poem58117.html","الطويل"],[447,"وقفت ببابك اللهم","https://www.aldiwan.net/poem14363.html","الهزج"],[447,"قد خان سمعي وعيني خانها بصري","https://www.aldiwan.net/poem14370.html","البسيط"],[556,"يا طائر الأيك غرد لي على الفنن","https://www.aldiwan.net/poem47158.html","البسيط"],[1273,"","https://poetry.dctabudhabi.ae/diwan/poem/199224","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204464","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202993","الطويل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145035","المجتث"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138680",""],[3857,"","https://poetry.dctabudhabi.ae/diwan/poem/142321","الوافر"],[4791,"خمر الأرياق","https://www.poetsgate.com/ViewPoem.aspx?id=28419",""],[4902,"أموت من فرقاك","https://www.poetsgate.com/ViewPoem.aspx?id=6530",""],[5064,"رقصة هدب على إيقاع رحيل","https://www.poetsgate.com/ViewPoem.aspx?id=199160",""],[5189,"ترفّق أيها البدرُ","https://www.poetsgate.com/ViewPoem.aspx?id=197057",""],[5970,"يقولون لي ساير زمانك ساعة","https://www.poetsgate.com/ViewPoem.aspx?id=130655",""],[6300,"الأعْيُنُ النُجُل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81627&r=&rc=4",""]],"verses":[["أُحِبُّ فاها وَعَينَيها وَما عَهِدَت","إِلَيَّ مِن عَجَبٍ وَيلي مِنَ العَجَبِ",0,"ب",1,0],["أحب فجازته الخلائق بالأسى","وفى فأجابته الخلائق بالغدر",1,"ر",1,0],["أحَبَّ فمَن ذا الذي أخلَفَهْ","ومَلَّ فمن ذا الذي استعطَفَهْ",2,"ف",2,1],["أحبّ فيك عذابي","يا هاجري وذبولي",3,"ل",2,0],["أُحبُّ فيكِ صورَةً عَذراءَ","وَإِن تَكُن أَصباغُها شَوهاء",4,"ا",2,0],["أحب فلما غار مني وخاف أن","أفاتحه في ذاك سابق بالعذل",5,"ل",1,0],["أحب فعال أهل الفض","ل لك الطبع محدود",6,"د",1,0],["أحب في اللَه فعل الصالحين ولم","أزل عليه وعنهم قد هفا قدري",7,"ر",2,0],["أُحبُّ فيه عَسوفاً ليس يرأفُ بِي","وقاسِيَ القلبِ فَظّاً ليس يرحمني",8,"ن",2,0],["أُحِبُّ فأقتلُ نفسي فلا","أَفوزُ من الحُبِّ بالطائلِ",9,"ل",1,0],["أحب فأهوى أكل شخص أحبه","واني متى أبغضت شيئا سحقته",10,"ت",2,1],["أحب فنائي فيك يا أيها البحر","فحسبي لفهم السر أن ضمّني السر",11,"ر",1,1],["أحب فيك ثباتا","على الخطوب وصبرا",12,"ر",2,0],["أحب فيك هزوءا","بالأقوياء وسخرا",12,"ر",2,0],["أحب فيك جمالا","من الطبيعة نضرا",12,"ر",2,0],["أحب فيك أديما","صفا وأشرق بشرا",12,"ر",2,0],["أحب فعلها وإن","تحط بآنات الزمن",13,"ن",1,0],["أحب فيغضب الواشون أني","إذا أرضيتهم غضب الحبيب",14,"ب",1,1],["أحب فيك الأصل مع حسن الاخلاق","وأحب فيك العطف والستر والزين",15,"ن",1,0],["أحب فيك إحساسي إني بلاماك","في عز خوفي منك أحس بأمانك",16,"ك",1,0],["أَحِبُّ فِيكِ الزَّمَانَ العَذبَ يَا امرأةً","سكَنتِ فِي رُوحهِ حِينًا مِنَ الدَّهْرِ",17,"ر",1,0],["أَحُبٌّ فيك أم هذا انفصامُ","فقلبي تاهَ وانحبسَ الكَلامُ",18,"م",1,1],["أحب فلا أرجو سوى ما أحبه","وأني لما قد شئته لفعول",19,"ل",1,0],["أحب فعال الخير والصدق شيمتي","وفي حكمتي لي قائد ودليل",19,"ل",1,0],["أحبّ فيكِ كوابيسًا تُراودني","وتملأ القلب بالآلام والعلل ِ",20,"ل",1,0],["أحبّ فيكِ ابتساماتٍ تُخبّرني","أنَّ الصبابَة كانت أوّلَ المِلل ِ",20,"ل",1,0]]}