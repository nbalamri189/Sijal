{"poems":[[55,"بقلبي للنوائب جانحات","https://www.aldiwan.net/poem30186.html","الوافر"],[9,"لعمرك ما طول هذا الزمن","https://www.aldiwan.net/poem21986.html","المتقارب"],[88,"أما أمين فقد ذقنا لمصرعه","https://www.aldiwan.net/poem10377.html","البسيط"],[75,"تنشق من عرف الصبا ما تنشقا","https://www.aldiwan.net/poem11855.html","الطويل"],[37,"خليلي هذا ربع عزة فاعقلا","https://www.aldiwan.net/poem39177.html","الطويل"],[39,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[26,"وما حمل البختي عام غياره","https://www.aldiwan.net/poem24080.html","الطويل"],[47,"مع الدهر ظلم ليس يقلع راتبه","https://www.aldiwan.net/poem10905.html","الطويل"],[30,"رأيت بني مروان يرفع ملكهم","https://www.aldiwan.net/poem1276.html",""],[35,"أنا الوامق المشغوف والله ناصري","https://www.aldiwan.net/poem25825.html","الطويل"],[48,"ألا ترحم الأشياخ لما تأودوا","https://www.aldiwan.net/poem22425.html","الطويل"],[48,"أواني هم فألقى أواني","https://www.aldiwan.net/poem23545.html","المتقارب"],[90,"","https://poetry.dctabudhabi.ae/diwan/poem/55693","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16704","الطويل"],[108,"عدل السماء","https://www.poetsgate.com/ViewPoem.aspx?id=179777",""],[48,"ألا ترحمُ الأشياخَ لمّا تأوّدوا،","https://www.poetsgate.com/ViewPoem.aspx?id=18528",""],[139,"المرء بالفكر لا باللحية الطولي","https://www.aldiwan.net/poem49189.html","البسيط"],[190,"سلوا عن مبيتي الليل كيف أبيته","https://www.aldiwan.net/poem43948.html","الطويل"],[234,"أأظهر أم أخفي الذي بي من السقم","https://www.aldiwan.net/poem50791.html","الطويل"],[287,"إلمام طيف شنيب الثغر ألماه","https://www.aldiwan.net/poem32309.html","البسيط"],[385,"لمن طلل بعد القطين تغيرا","https://www.aldiwan.net/poem49255.html","الطويل"],[435,"شجا القلب تذكار الأحبة والحمى","https://www.aldiwan.net/poem40503.html","الطويل"],[443,"أأستجبر عليهم دمعي الجاري","https://www.aldiwan.net/poem2595.html","البسيط"],[445,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[556,"أبالبارق النجدي طرفك مولع","https://www.aldiwan.net/poem47725.html","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53918","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145801","المتقارب"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59749","الوافر"],[1017,"","https://poetry.dctabudhabi.ae/diwan/poem/45204","المتقارب"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59438","الطويل"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96579","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55927","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122022","الطويل"],[1459,"","https://poetry.dctabudhabi.ae/diwan/poem/138019",""],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35800","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100980","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71071","الطويل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48238","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27839","الطويل"],[2224,"","https://poetry.dctabudhabi.ae/diwan/poem/126381","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109411","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109373","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93721","البسيط"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111261","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65958","الطويل"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113839","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134204","الطويل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145046","الطويل"],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28875","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89048","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86250","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109925","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117844","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127074","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127240","السريع"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123511","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123516","الطويل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/46003","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90825","الطويل"],[4236,"","https://poetry.dctabudhabi.ae/diwan/poem/76595","الخفيف"],[4270,"","https://poetry.dctabudhabi.ae/diwan/poem/124283","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81728","البسيط"],[4498,"","https://poetry.dctabudhabi.ae/diwan/poem/116583","الطويل"],[4767,"إلى المنسوب","https://www.poetsgate.com/ViewPoem.aspx?id=179875",""],[4862,"في رثاء أبي رحمه الله وغفر له","https://www.poetsgate.com/ViewPoem.aspx?id=152722",""],[4984,"فيا سائلا لا تلمني *","https://www.poetsgate.com/ViewPoem.aspx?id=175582",""],[3591,"على الله أجر المسّهام المتيّم","https://www.poetsgate.com/ViewPoem.aspx?id=149475",""],[5120,"مِنْ بَعْدِهَا،لَا يَنْتَهِي السَّفَرُ","https://www.poetsgate.com/ViewPoem.aspx?id=181582",""],[5206,"حَيَاةُ المُهَج","https://www.poetsgate.com/ViewPoem.aspx?id=187392",""],[5431,"تاء الأنوثة !","https://www.poetsgate.com/ViewPoem.aspx?id=207717",""],[5582,"سَبانِي بِتَكْسِيرِ أَجْفانِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63597",""],[5689,"ذروني أقل أن الوجود ظلام","https://www.poetsgate.com/ViewPoem.aspx?id=143424",""],[5829,"الا المساجد","https://www.poetsgate.com/ViewPoem.aspx?id=211699",""],[5855,"ألم تر أني إذا ما روى","https://www.poetsgate.com/ViewPoem.aspx?id=186574",""]],"verses":[["وَلَم يَلبِثنَ غِربانُ اللَيالي","نَغيقاً أَن أَطَرنَ غُرابَ راسي",0,"س",2,0],["وَلَم يَلحَقوهُ عَلى شَوطِهِ","وَراجَعَ مِن ذِلَّةٍ فَاِطمَأَنّ",1,"ن",1,0],["وَلَم يَلِن عودُهُ لِلخَطبِ يُرهِقُهُ","قَسا عَلَيهِ شَديدُ العَيشِ أَم لانا",2,"ن",2,0],["وَلَم يَلتَئِم شَعبي خِلالَ شِعابِكِ","وَلَم يَكُ خَلقي بَدؤُهُ مِن تُرابِكِ",3,"ك",1,0],["وَلَم يَلقَ إِنسانٌ مِنَ الحُبَّ مَيعَةً","تَعُمُّ وَلا عَمياءَ إِلّا تَجَلَّتِ",4,"ت",1,0],["ولم يُلهِنِي دارٌ ولا رَسمُ مَنزِلٍ","ولم يَتَطَرَّبنِي بَنضانٌ مُخَضَّبُ",5,"ب",1,0],["ولم يلقَ بين الضيق والضيق فُسْحَةً","أبى ذاك أن الله بالعبد أرحمُ",6,"م",1,0],["وَلَم يُلفَ جَلداً حازِماً ذا عَزيمَةٍ","وَذا قُوَّةٍ يَنفي بِها مَن يَزورُها",7,"ر",3,0],["وَلَم يُلفَ عُضوٌ مِنهُ إِلّا ضَريبَةً","لِأَبيَضَ ماثورٍ تُهابُ مَضارِبُه",8,"ب",2,0],["وَلَم يَلقَ ما لاقَيتُ إِلّا صَحابَتي","وَإِلّا رِكابٌ لا يُراحُ لُغوبُها",9,"ب",3,0],["وَلَم يَلقَ قابوسٌ وَقَيسٌ وَعُروَةٌ","وَلَم يَلقَهُ قَبلي فَصيحٌ وَأَعجَمُ",10,"م",1,0],["وَلَم يُلفِ مِنها فارِدُ القُمرِ مَخلَصاً","وَقَد بَلَغَت أَحداثُها القَمَرا الفَردا",11,"د",2,0],["وَلَم يَلقَ في دَهرِهِ أَجرَبِيٌّ","هَوانِيَ فَليَنأَ عَنّي هَواني",12,"ن",2,0],["ولم يَلبَث المقدور أن غال زوجها","سعيداً فأودى وهي إذ ذاك مُرضِع",13,"ع",1,0],["ولم يُلْقَ في رُوعٍ لها خوْفُ صارِم","ففازَ بطُهْرٍ مِن تُقَى الموْتِ رُوعُها",14,"ع",3,0],["ولم يلتمس من سواها علاجًا","فكانت هي الداءَ وهْي الدواء",15,"ا",2,0],["ولم يُلفِ منها فاردُ القُمْرِ مَخلَصاً،","وقد بلغتْ أحداثُها القَمرَ الفردا",16,"د",2,0],["ولم يُلمّ بأخبار العلا رجل","يُمِلّ لمته دَهناً وترجيلا",17,"ل",2,0],["ولم يلق خلق في الهوى ما لقته","من الوجد لا قبلي أراه ولا بعدي",18,"د",2,0],["ولم يَلق مخلوقٌ من الدهر مِثل ما","لقيتُ من الأرْزاء والجورِ في الحكم",19,"م",1,0],["وَلَم يَلُذ خامِلٌ إِلّا بِعَقوَتِهِ","إِلّا وَعافاهُ مِمّا كانَ عَفّاهُ",20,"ا",2,0],["وَلَم يَلهِني عِنهُم وَقَد ذُبتُ حَسرَة","سِواهُم وَعَهدي بِعدَهُم ما تَغَيرا",21,"ر",2,0],["ولم يلفَ في غير الثغور كشبهه","فبادر وخذها يا سميا بنبههِ",22,"ه",1,0],["ولم يلن عودك الجافي لعاجمة","ولا أمرّ جنى منكم لمشتار",23,"ر",1,0],["ولم يلهني قُربُ الحبيب الَّذِي دنا","وَلَمْ يُصبني طيفُ الخيالِ الَّذِي يسري",24,"ر",2,0],["وَلم يَلحُني في نُصحِكمْ غير كاشِحٍ","وإِلّا اِمرؤٌ في الغِشّ بالغيب مولَعُ",25,"ع",1,0],["ولم يلتفت أمرَ الإمامِ وحُكمَه","وردَّ حُسامَ العزّ منه قَليلا",26,"ل",2,0],["ولم ْيَلتفِتْ وَجَعي والمَسَار","له ُمن حَوَافر ِخيلي اكتِوَاءُ",27,"ا",2,0],["ولم يُلف بمُستتر","يُقطع قلبَ مَن عشقه",28,"ق",2,0],["وَلَم يَلقَحِ الأَمرَ خَيرَ الزُبيرِ","وَطَلحَةَ في الفِئَةِ القاتِلَةْ",29,"ل",2,0],["ولم يله علياه تزخرف حسنها","وهل هي إلا جيفة تتجسم",30,"م",1,0],["ولم يُلتَمَسَ فحلاً أَبوها وإنما","بنات أَبيها كلُّ أرقطَ مُحثَل",31,"ل",1,0],["ولم يلهني عن حبه غير مدح مَن","مديحي له فرض عليّ مقرَّرُ",32,"ر",1,0],["وَلَمْ يُلْهِهِ نَهْدٌ عَلَى الصَّدْرِ عِنْدَمَا","تَحَمَّلَ مِنْهُ الطِّرْفُ صَدْرَاً عَلَى نَهْدِ",33,"د",1,0],["وَلم يَلعَن يَزيداً بَعدَ مَوتٍ","سِوى المكثَارِ فِي الإغراء غَالي",34,"ل",2,0],["وَلَم يَلقَ العَدُوُّ بِمُقرَباتِ","يَهيمُ أَمامَها جَيشٌ لهامُ",35,"م",1,0],["ولم يلهني عن آجن الورد دونه","عذاب الثنايا من ثغور الخرائد",36,"د",1,0],["ولم يُلْهِني عمّا أَرُومُ مَطاعِمٌ","لِذاذٌ ولا مشروبةٌ ومناكِحُ",37,"ح",1,0],["ولم يُلْفِني إلا محبّاً مُشَبِّباً","عدوّاً لمَنْ قدْ عَقَّني مِنْ سبابهِ",38,"ب",2,0],["ولم يلهني عنه حميمٌ وصاحبٌ","فإن لم يكن بالقولِ بالحال قد ألهى",39,"ه",2,0],["ولم يلقه الأعداء إلا لعلمهم","بما يقتضيه حلمه وهو قادر",40,"ر",1,0],["ولم يله بالدنيا ولا مال راغباً","لمالٍ ولكن التقى كان كسبه",41,"ب",2,0],["ولم يلهني عنها سوى مدح سيدٍ","عليهِ من المجد المؤثل رونق",42,"ق",1,0],["وَلَم يَلمه بِإدعام الجدار وَلا","قَتلِ الغُلام وَلا في خرقِه السُفُنا",43,"ن",2,0],["ولم يلق هاتيك اللئالي بساحل","ولكن بغوص غيره لا يغوصه",44,"ص",2,0],["ولَم يَلِج مَن سارَ في التِّسعِينَا","إن لَم يَكُن في نَادِرِ السِّنِينَا",45,"ن",2,0],["ولم يلق من حرب العدا عشر عشر ما","لقي المصطفى الهادي النذير المبشر",46,"ر",1,0],["ولم يلتفت بالبغض يوما لمبغض","ولم يخف مكرا للمصر على المكر",47,"ر",1,0],["ولم يلهه عن بث جدواه منصب","فكم درسه بالعلم احيى المساجدا",48,"د",2,0],["ولم يلبث الأشرار حتى تآمروا","عليه فلم يألوه من شرهم خبلا",49,"ل",2,0],["وَلَم يَلقوا وَسائِدَ غَير أَرضٍ","زِيادَتُهُنَّ سوطٌ أَو جَديلُ",50,"ل",1,0],["ولم يلهه من دهره عن مرامه","كنوزٌ ومحبوبٌ وصرحٌ ممرَّد",51,"د",1,0],["وَلَم يُلهِني عَنهُم سَوى مَدح احمَد","اميرُ لَهُ في الفَضلِ ما شَمت سابِقاً",52,"ق",2,0],["ولم يلف بطالاً ولو عمر ساعةٍ","ولكنه الجسم والروح كادح",53,"ح",1,0],["ولم يلتفت إذ ناحت الأوز دونه","ليمضي أمراً في الكتاب مقدرا",54,"ر",2,0],["ولم يلبث سوى يومين حتى","دعاه إليه رب العالمينا",55,"ن",2,0],["ولم يلح في شهر صوم لنا","حذار ان نفتح قفل الصيام",56,"م",1,0],["ولم يلوه لهو وهول البعاد عن","هواكم وما عنكم نوى سلوة قط",57,"ط",1,0],["ولم يلوه عن حبكم لوم لائم","وما خان فيكم عهد ودّ وموثقا",58,"ق",2,0],["وَلَم يَلفَ إِلفاً يَأوي أَليفَهُ","إِلَيهِ وَيَلفيهِ حَميماً وَمُنجِدا",59,"د",2,0],["ولم يلهني عن حبها شاغل سوى","ثنائي على طه وابنائه الغر",60,"ر",1,0],["وَلَمى لُؤلُؤٍ جَرى","فِيهِ دَرياقُ شَهدِهِ",61,"د",2,0],["ولم يلقني في ودهن مكدّر","وكل هوى أرعَنَني روضهُ غضا",62,"ض",2,0],["ولم يلج منذ همنا في مسامعنا","عذلٌ ولو ولج الآذان آذانا",63,"ن",2,0],["ولم يلبث الواشون أن يَصدَعُوا العَصَا","إذا لم يكُن صلبا على البَري عُودُها",64,"د",3,0],["ولم يلبس تُقًى يوماً ولكن","من التقوى الجميل بدا فقيرا",65,"ر",2,0],["ولم يلههِ داءٌ من الضر مسهُ","فقد فاق من غيبوبةٍ يتشهّدُ",66,"د",1,0],["ولم يلتبس عن رؤاها بعيد","فتعرفه دون أي ارتياب",67,"ب",1,0],["ولم يلف إلاّ الله في الناس معصما","وما زال عند الناس آخر معصم",68,"م",1,0],["وَ لَمْ يَلُحْ بَعْدُ نُورٌ أَسْتَضِيءُ بِهِ","وَ لَا بَصِيصٌ مِنَ الْآمَالِ يَنْحَسِرُ",69,"ر",1,0],["وَلَمْ يَلْتَفِتْ يَوْمًا إلَيْهِ وَلَمْ يَكُنْ","عَلَى مَضِّهِ مِنْ عَضِّهِ يَعْرِفُ الكُرْبَا",70,"ب",2,0],["ولم يلمس شروح النبض يحكي","بما قد تمّ من عزم الأمور !!",71,"ر",1,0],["وَلَمْ يَلْقَن السَّمْعُ مِنْ نَبْأَةٍ","بِهِ غَيْرَ أَصْواتِ جِنَّانِهِ",72,"ن",2,0],["ولم يلق بثي منهم غير جفوة","تسابق منها للكبود سهام",73,"م",1,0],["ولم يلجِ المنابرً في صلاةٍ","ولا الجمعاتِ معتكفٌ وعابدْ",74,"د",1,0],["ولم يلفني أبداً ذاكراً","بسوء له لا ولا عاتبا",75,"ب",2,0]]}