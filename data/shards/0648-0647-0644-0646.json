.com/ViewPoem.aspx?id=189361",""],[5299,"مكابرةُ امرأة","https://www.poetsgate.com/ViewPoem.aspx?id=210536",""],[5431,"تاء الأنوثة !","https://www.poetsgate.com/ViewPoem.aspx?id=207717",""],[5459,"عام يودعنا","https://www.poetsgate.com/ViewPoem.aspx?id=195045",""],[5491,"أنت القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=215088",""],[5544,"عبري","https://www.poetsgate.com/ViewPoem.aspx?id=213406",""],[5577,"هجرة","https://www.poetsgate.com/ViewPoem.aspx?id=176246",""],[5582,"حَلِيفُ جَوَىً ما ناحَ يَوْماً حَمامُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=187264",""],[5582,"سَبانِي بِتَكْسِيرِ أَجْفانِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63597",""],[5690,"حياة المرءِ في الدنيا منامُ","https://www.poetsgate.com/ViewPoem.aspx?id=172186",""],[5803,"أنت الهيام وصبر العاشقين أنا","https://www.poetsgate.com/ViewPoem.aspx?id=104035",""],[5956,"مفاتيح الدخول إلى بلادي العربية","https://www.poetsgate.com/ViewPoem.aspx?id=192786",""],[243,"يا ليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68157&r=&rc=149",""]],"verses":[["وَهَل نافِعٌ أَن يَملَأَ العَينَ حُسنُها","إِذا هِيَ لَم تُحسِن إِلَينا حِسانُها",0,"ن",3,0],["وَهَل نالَ في العَيشِ الفَتى فَوقَ عُمرِهِ","وَهَل بُلَّ مِن داءِ الحِمامِ غَليلُ",1,"ل",1,0],["وَهَل نافِعٌ يَوماً وَجَدُّكَ راجِلٌ","إِذا قَيلَ يَومَ الرَوعِ إِنَّكَ فارِسُ",2,"س",1,0],["وَهَل نافِعي يَومَ أَقضي صَدىً","إِذا صابَ وادي قَومِيَ المَطَر",3,"ر",1,0],["وَهَل ناقِعٌ قَولُ ذي غُلَّةٍ","وَقَد بَعِدَ الرَكبُ لا يَبعَدوا",4,"د",3,0],["وَهَل نافِعي ظاهِرٌ باسِمٌ","وَمِن خَلفِهِ باطِنٌ يَقطِبُ",5,"ب",1,0],["وَهَل نافِعِ ذِكرُ الأَخِلاّءِ بَعدَهُ","جَرى بَينَنا مَورُ النَقا وَالسَباسِبِ",6,"ب",1,0],["وَهَل نَحنُ إِلّا مَرامي السِهامِ","يَحفِزُها نابِلٌ دائِبُ",7,"ب",1,0],["وَهَل نافِعي أَن يَكثُرَ الماءُ بِالدُنا","وَلَمّا يُجِرني إِن ظَمِئتُ شَرابُ",8,"ب",1,0],["وهلْ نَحنُ إلا عُصْبَةٌ خِندِفِيّةٌ","تَرادَفَ غاياتِ العُلا سَرَواتُها",9,"ت",3,0],["وَهَل نافِعي أَنَّ البِلادَ كَثيرَةٌ","أَطوفُ بِها وَالقَلبُ بِالشامِ مُرتَهَن",10,"ن",1,0],["وَهَل نافِعي إِن عَضَّني الدَهرُ مُفرَداً","إِذا كانَ لي قَومٌ طِوالُ السَواعِدِ",11,"د",1,0],["وهل نِعمة حتى تكونَ مَودَّة","وهل رَوْضة حتى يكونَ غدير",12,"ر",1,0],["وَهَل نَسيمٌ سَرى يُبَلِّغُهُ","رِسالَةً مِن فَمي إِلى فَمِهِ",13,"م",2,0],["وهل نظم الكهول الصِّيد صفا","وألف من تجاربهم رداحا",14,"ح",2,0],["وَهَل نافِعٌ جَريُ القَوافي لِغايَةٍ","وَقَد فَتَكَت دُهمُ المَنايا بِأَدهَمِ",15,"م",1,0],["وَهَل نِلنا كِلانا اليَومَ إِلّا","عَراقيبَ المَواعِدِ وَالمِطالا",16,"ل",2,0],["وَهَل نالَ ما نالوا مِنَ الفَخرِ حاضِرٌ","وَهَل حُبِيَ الخالونَ مِنهُ الَّذي حُبوا",17,"ب",3,0],["وهل نافعي أنّي أمُتُّ بحُرْمةٍ","إِذا لم يكنْ من حُسْنِ رأيكَ شافعُ",18,"ع",1,0],["وهل نُغْبَةُ الماءِ التي يرِدُونَها","عن الحائمِ الحَيرانِ ممنوعةُ الوِرْدِ",19,"د",1,0],["وهل نظرةٌ عجلَى يُريكَ اختلاسُها","غليلَ مُعَنَّى لا يذوقُ شَرابَا",20,"ب",2,0],["وهل نطفةٌ زرقاءُ ينقشها الصَّبَا","هنالك سَلسالُ المذاق شَروبُ",21,"ب",1,0],["وَهَلْ نَحْنُ إِلَّا مِثْلُ مَنْ كَانَ قَبْلَنَا","فَسَلْ عَنْ جَدِيسٍ أَيْنَ وَلَّتْ وَعَنْ طَسْمِ",22,"م",1,0],["وهل نَفذتْ قُوى الطَّاغين فيه","ونالت منه أيدي الماكرينا",23,"ن",2,0],["وهل نَظَرَ ابْنَهُ لمّا تَرَدَّى","وَعَايَنَ روعةَ الموتِ الذُّعاقِ",24,"ق",1,0],["وَهَل نافِعٌ في المَوتِ أَنَّ اِختِيارَنا","يُنافِرُه وَالطَبعُ مِمّا يُشاكِلُه",25,"ل",2,0],["وهل نحنُ إلاّ مَعشَرٌ من عُفاتِهِ","لنا الصافناتُ الجُردُ والعَكَرُ الدَّثْر",26,"ر",1,0],["وَهَل نَدِمتَ عَلى طِفلٍ فَجِعتَ بِهِ","أُماً وَمِثلُكَ لا يَستَشعِرُ النَدَما",27,"م",2,0],["وهل نَزَلَ الرّكبُ العِراقي مُعَرِّفاً","وهل شُرِعَت نحو الخِيام شرائع",28,"ع",1,0],["وَهَل نافعي تشييعه في رحيله","إذا كنت فيما بعد ذلك أرجع",29,"ع",1,0],["وهل نافعي أن ترفع الحجب بيننا","ودون الّذي أمّلت منك حجاب",30,"ب",1,0],["وهل نسيتَ مصرُ يومَ القناةِ","وما يومُها غيرُ يومٍ أَغَرّ؟",31,"ر",1,0],["وهل نفذت شهابا والخطوب دجى","وعندي الصارمان القول والعمل",32,"ل",1,0],["وهل نقضي سوى عيش قصير","اجب الظهر مقبوب الوضين",33,"ن",1,0],["وهل ننتشي ريحَ العراقِ وهل لنا","سبيلٌ الى ماء الفرات المصفَّق",34,"ق",1,0],["وهْل نضَبتْ تلك العواطفُ ثَرَّةً","لِطافاً مجاريها ، غِرارَ المنابع",35,"ع",1,0],["وَهَلْ نَحْنُ إِلاَّ مِثْلُ مَنْ كَانَ قَبْلَنَا؟","فَسَوْفَ تُعَانِي الْجَدْبَ يَا رَاعِي الْوَسْمِي",36,"م",2,0],["وهل نافعي أني كتومٌ وأنني","عيوف وأني صابرٌ متجلد",37,"د",1,0],["وهل نافعي أن الرياض حليةٌ","منورة النوار هادلة الطير",38,"ر",1,0],["وهل نافعٌ لك طولُ الجِماحِ","وفي يدِ صَرف الزمانِ الزّمامُ",39,"م",1,0],["وهل نجمه الهاوى سوى دَبَرانها","وهل ريحُه الهوجاءُ إلا دَبورُها",40,"ر",3,0],["وَهَل نَذُمُّ زَماناً ما أَساءَ بِنا","إِلّا لِيُحسِنَ في إِنجازِ ما وَعَدا",41,"د",2,0],["وَهَل نَافِعي رِيّ الجفونِ بِدَمعِها","إذا كانَ ما بَينَ الجَوانِحِ لا يَروى",42,"و",2,0],["وهل نَجا الهدهدُ من نَتنِهِ","بلُبْسِهِ الديباجَ والتّاجا",43,"ج",2,0],["وهل نسيتَ الهوى وما بعدتْ","أيامُ ذاكَ الودادِ والملقِ",44,"ق",1,0],["وَهَل نافِعٌ قَولي جَوىً وَصَبابَةً","لَيالي الهَوى إِن عادَ عَصرُ الصِبى عودي",45,"د",2,0],["وهل نافعي والبعدُ بيني وبينَها","إِجالةُ دمع المُقلة المترقرقِ",46,"ق",1,0],["وَهَلْ نَافِعي شَيْمٌ مِنَ الْعَزْمِ صَادِقٌ","إِذا كنْتُ ذَا بَرْقٍ مِنَ الْحَظِّ كاذِبِ",47,"ب",1,0],["وَهل ندافعُ عن حقٍ هريقَ له","سيلٌ من الدمِ حتى الآن ما ركدا",48,"د",2,0],["وَهَل نَمتَري في أنّ عفوكَ منّةٌ","وَمِن مددٍ وافاكَ غصّ وَصيدها",49,"د",3,0],["وهل نافع شق الفؤاد ندامة","لذي قدمٍ زلت ولم تتشبت",50,"ت",1,0],["وهل نستاف يا وطني","نسائم زهرك العطر",51,"ر",1,0],["وهل نحنُ إلاّ رُفقةٌ قد تَسايَرتْ","إلى مَنْزلٍ دانٍ كأنْ قد تَلاحَقْنا",52,"ن",2,0],["وَهَل نَهَضتُ أَمامَ اليُسرِ مِن مَرَحٍ","وَهَل جَثَمتُ وَراءَ العُسرِ مِن لَغَبِ",53,"ب",1,0],["وهل نافِعي أنِّي أبَيتُ اعتِراضَها","إِذا لَم تَكُن تأباهُ لي نِوبُ الزَّمَن",54,"ن",1,0],["وهل نلقى التآمر بالتغاضي","ونخلص بالعيوب من العيوب؟!",55,"ب",1,0],["وهل نافعى أن لا أراه بناظري","وقد رُسِمَتْ تلك المحاسن في قلبي",56,"ب",2,0],["وهل نسى أحد بيت الفقيه وقد","صكت بأخبار يام فيه آذان",57,"ن",1,0],["وهل نافع دمع يسيل ومهجة","تذوب وعضي حسرة لشفاتي",58,"ت",2,0],["وَهَل نافِعي أَن تَجمع الدارَ بَينَنا","بِكُلِّ مَكانٍ وَهيَ صَعبٌ مَرامُها",59,"م",3,0],["وَهَل نافِعي أَنّي أَرثيك بَعدَما","رأَيتُكَ تَزجي لي وَتحكم بِالقِسطِ",60,"ط",1,0],["وهل نَافِعي قربٌ ومِن دُون قلبِه","نَوىً قُذُفٌ أَعيَت ظُهورَ الرَكائِبِ",61,"ب",1,0],["وهل نزل الحيا بالوبل ليلاً","بها واعشوشب الروض الأنيق",62,"ق",1,0],["وهل نَبَتَ الثّمام أو الخزامى","فَعَطَّر فيه أنفاس الرياح",63,"ح",1,0],["وهل نافعٌ ما قال من بعد ما رمى","بعَيْنَيْه ريم الجزع سهم الرَّدى عمدا",64,"د",2,0],["وهل ناشقٌ من رندها وعرارها","على أنَّها مع قربها من مزارها",65,"ه",2,0],["وهل نال أسباب العُلا مثلُ راحةٍ","لها عضُدٌ في المكرُمات وساعدُ",66,"د",1,0],["وهل نافع اسمٍ إذا من أخيره","وأوله من كل فعلٍ مضى حرف",67,"ف",1,0],["وهل نسيتم جنايات لهم قصمت","ظهورنا أم حسبتم وهمكم شورى",68,"ر",2,0],["وهل نافعي ظلُّ أفيائها","وظلّ علائي بها زائلُ",69,"ل",1,0],["وهل نافعي يوما وحظّيَ قاعدٌ","إذا نهضتْ بي همّتي أو سعت رجلي",70,"ل",2,0],["وهل نافعي ذاك بل ليت لا","يضرّ إذا هو لم ينفعِ",71,"ع",1,0],["وهل نافعي خدٌّ من الدمعِ مخصبٌ","وقد أجدبتْ مني الحشا والجوانح",72,"ح",1,0],["وهل نفحتْ عن منحنى البانِ نفحةٌ","ففزتَ بما فيها للمياءَ مَنْ رَدْعِ",73,"ع",1,0],["وهل نقط زادت معاني لم تكن","لها قبل نقط للحروف الرقوميه",74,"ي",2,0],["وَهَلْ نَوَّرَ زَهْرُ الرَّو","ضِ والرَّوْضَةُ مخْضَلّهْ",75,"ل",2,0],["وَهَلْ نَحن في الأيّامِ إلّا معاشرٌ","نُقضّي ديوناً أوْ نردّ عواريا",76,"ي",2,0],["وَهَل نافِعٌ أَنْ فَرّقتنا أصولُكمْ","أصولٌ لنا نأوي إليها وعنصرُ",77,"ر",1,0],["وَهِلْنا عليهِ مِن جَوانبِ قبرِهِ","ثَرىً طابَ لمّا مسَّ طِيبَ الضّرائِبِ",78,"ب",1,0],["وَهَل نَحنُ إِلّا أَنفُسٌ مُستَعارَةٌ","تَمُرُّ بِها الرَوحاتُ وَالغُدَواتُ",79,"ت",1,0],["وهل نور النجوم يلوح إلا","على مقدار إدراك المآقي",80,"ق",2,0],["وهل نَرَى ذلكَ الوجهَ الذي نَسَخَتْ","أنوارَهُ تحتَ أطباقِ البِلَى الظُلَمُ",81,"م",1,0],["وهل نخاف على الوادي وفيه لنا","آراء أحمد تجلو المعضلات دجت",82,"ت",1,0],["وَهَل نَرتَضي ذا اليَومَ ذُلّاً بِتَركِهِ","إِذا سادَ فيهِ جيلُنا المُتَقادِمُ",83,"م",1,0],["وَهَل ناجَحَ بِالأَمرِ إِلّا رِجالُهُ","وَهَل ساجَعَ بِالأَيكِ إِلّا الحَمائِمُ",83,"م",1,0],["وَهَل نَظَروا مِن نَحوِ بُرقَةِ موهِنا","فَلاحَت لَهُم مِنها بُروقُ الصَوارِمِ",84,"م",1,0],["وهل نَشَجنَ قلوب الهيمِ عَلَّتَها","مِن طَلِّها الطّلقِ أو مِن مائها الخَصِر",85,"ر",1,0],["وهل نعاينُ ذاكَ الوجهَ مُبتسماً","وهل يُشنّف ذك اللفظ آذانا",86,"ن",2,0],["وهل نهاب البيض أو حزبها","أو القنا ونحن في ساحتك",87,"ك",1,0],["وهل نسيتِ نكبة الهنودِ","وأخذك الأرمن في القيودِ",88,"د",1,0],["وَهَل نَظَمت مِنهنَّ عقداً لِنَحرها","وَهَل أخَذَت مِنها لَهُ الدرّ وَالسّمطا",89,"ط",2,0],["وهل نفعت به عمْ","مَك الشفيقَ وخالَكْ",90,"ك",1,0],["وهل نَعم التنعيم بعد بعادنا","وحلى الحيا منها بطاحاً عواطلا",91,"ل",2,0],["وهل نسيم من شذا روضة","تطفئ من أحشايَ حرّ اللهيبْ",92,"ب",1,0],["وَهَلْ نَافِعٌ دَمْعٌ جَرَى وَبِمُهْجَتِي","لَهِيبٌ لَهُ بَيْنَ الضُّلُوعِ وُقُودُ",93,"د",1,0],["وهل نافعي كتم الدموع لما جري","وقلبي بما سن الأسى بتكلم",94,"م",1,0],["وَهل نعمة اللّه من حاسدٍ","يغير فيها ونبهانهِ",95,"ن",2,0],["وهل نال منهم آل حرب وغيرهم","من الناس فوق القتل والسبي والنهب",96,"ب",1,0],["وهل نافعي صَمْتي عن النُّطْقِ باسْمِها","إِذا نَطَقَ الدُّمْعُ الصُّموتُ عن الهَوَى",97,"و",2,0],["وهَل نحن إلاَّ البَحرُ إِن رِيمَ سَيبُنَا","وَهل سَيبُنَا لَم يَزرِ بالقَطرِ والبَحرِ",98,"ر",1,0],["وهَل نَحنُ إلاّ الأُسدُ فِي حَومَةِ الوَغَى","تُرَبِّبُ في عِرِّيسِ أجمَتِهَا أُجرِ",98,"ر",1,0],["وهل نعود كما كنا ويجمعنا","دار وتقضى لنا منكم لبانات",99,"ت",1,0],["وهل نشرت للعيد أعظم زينة","لمولد خير الخلق تقراه أخيار",100,"ر",1,0],["وهل نافعي أَنّي أَطعتُ عواذلي","إذا ما وجدتُ القلبَ غيرَ مُطيع",101,"ع",1,0],["وهل نُداوَى من كُلوم النَّوى","بلَفِّ أَعناقٍ بأعناق",102,"ق",1,0],["وهل نظم السلوك اليك يعزى","ولا تدري السريع من الطويل",103,"ل",1,0],["وهل نَصَرَت من قبل شكواك فاضلاً","لِتأمَل منهنَّ الَمعُونَةَ والنَّصرا",104,"ر",2,0],["وهل نظرة في وجه سلمى لأهتدي","فقلبي في تيه المحبة واقع",105,"ع",1,0],["وَهَل نَزَلَت أَظعانُها الخيفَ مِن مِنىً","وَحَطّوا عَلى حِجرِ الحَطيمِ وَزَمزَما",106,"م",2,0],["وهل نظروا له من بعد بعد","وهل بوصالهم أبورا سقاما",107,"م",2,0],["وهل نام قبلي في دجى الليل ذو جوىً","تبيت له أحشاؤه تتوهج",108,"ج",1,0],["وهل نعمت دارٌ تحمل أهلها","على نجب نحو الردى عجلات",109,"ت",1,0],["وهل نَسِيَ الرمان للنيل أنعماً","بما ورثوا منها سما لهمُ الفخر",110,"ر",1,0],["وهل ندم يجدي على فوت نصركم","كما نصركم في العالمين مشفعا",111,"ع",2,0],["وهل نحن الا كالدعاميص أعصفت","بها الريح هيفا حين نشّت ثغابها",112,"ب",3,0],["وَهَل نَحنُ في اِستِغلالِنا غَيرَ دَولَةٍ","خَزائِنُها وَقفٌ عَلَى السَلبِ وَالنَهبِ",113,"ب",1,0],["وَهَل نَشَقَت ريح العَرارِ فَلَم تَزَل","حَقائِبُها مِن شِدَّةِ النَّزَوانِ",114,"ن",1,0],["وهل نافع قول يا ليتني","إذا ما دهى فادح أو ألما",115,"م",2,0],["وهَلْ نَجعوا صوبَ الربيع بحاجر","واسْتوطنوا بالبان ذي القُضُب المُلْد",116,"د",1,0],["وهل نحن إلا للفناء مصيرنا","ومنا قلوب قد تميل إلى الزهو",117,"و",1,0],["وَهَل نافِعي صَوبٌ مِن الدَمع هاطل","وَقَلب تَلظّيه لَوافح زَفرَتي",118,"ي",1,0],["وَهَل نَلتَقي تَحتَ الصُنوبر ساعَةً","فَنَشكو الَّذي نَلقي مِن البَرحِ وَالأَين",119,"ن",1,0],["وهل نافعي أَنني شاعر","تضرّ وتنفع اشعاريه",120,"ي",2,0],["وهل نهلة يروى بها عاطش الحشا","لمعتلِّ قلب لا يعلُّ وينهل",121,"ل",1,0],["وهل نَصَف أمسي فراشي عوسجا","جعلت له الشوك القتاد وسادا",122,"د",2,0],["وهل نافعي عض الأباهم بعد ما","بادرد ناب قد قطعت الرواجبا",123,"ب",2,0],["وهل نسب مثل التشرد جامع","تجمع فيه كل شمل مبدّد",124,"د",1,0],["وَهل نَسَماتٌ عِند صِنّينَ لم تَزَل","مهينمَةً تدري بحالي وما بِيَا",125,"ي",2,0],["وَهَل نافع لي اِدّكار الصِبا","وَقَد زالَ عهد الصبا واِنصَرَم",126,"م",1,0],["وهل نافعي بعدَ النّوى قُربُ دارِها","إذا كان مسْدولاً عليْها حِجابُها",127,"ب",3,0],["وهل نرتجي من بعد تفريق شملنا","التئاماً وننسى بالمسرة ما جرى",128,"ر",2,0],["وهل نؤَمل في مجد البيان فهل","يجدي إذا ما بنانٌ لابنه تربا",129,"ب",2,0],["وهل ننسى أيام الحصار وبؤسها","وقد كادت الأرزاء أن تتنزلا",130,"ل",2,0],["وهل ناجيت في تلك الروابي","بنات الشعر أم عفت النظاما",131,"م",2,0],["وَهَل نُواحُك من بَينِ الأَليف جَوىً","أَم قَد ذكرتَ الصِبا وَالجارَ وَالسكنا",132,"ن",2,0],["وَهَل نُمَلَّكُ إِلا ملكَ من سلفوا","وَلو بقي الأَمر ما نالته أيدينا",133,"ن",2,0],["وَهل نارها يعشو لها ضاربُ الفلا","وَهَل سهلُها رحبٌ لمزجي المطية",134,"ه",1,0],["وهل نما قط في غصن على شجر","آس وورد ونسرين وسوسان",135,"ن",1,0],["وهل نظرت بعين السوء حتى","لأغنام الرعية والعبيد",136,"د",1,0],["وهل نشروا بين الأنام جرائدا","ليهدى بها الضليل والنزق الغور",137,"ر",1,0],["وهل نسبي الموروث يكسبني العلى","إذا لم يحش مني بحب العلى 2صدر",138,"ر",1,0],["وهل نقَضت عهوداً بيننا عُقدت","بالكرخ بين حديقاتٍ وأزهار",139,"ر",1,0],["وهل نسيت ليلا وقد دار بيننا","حديث كمثل الدر سمعي له سقط",140,"ط",1,0],["وهل نافعي عذلٌ ونصحٌ على الهوى","وعذليَ يُغري بي ونصحيَ لا يسلي",141,"ل",2,0],["وهل نكرٌ يلي هطلاً بجودِ","أليس الكون في هذا شهودي",142,"د",2,0],["وَهل نَصيبي فوقَ ما أَرتَجي","مِنكَ وَلي في الحُبّ أَوفي نَصيب",143,"ب",1,0],["وَهَل نائِبٌ زَكَّيتُمُوه كَنائِبٍ","يُزَكِّيهِ صَوتُ اللَهِ أَعدَلُ ناخِبِ",144,"ب",1,0],["وهل نبقى على صهواتِ ريحٍ","نمدُّ الخطوَ نمتدُّ اغترابا",145,"ب",2,0],["وهل نَخَافُ على ما سَوف نَفقِدُهُ","وقد سُلِبناهُ -قَبلَ الفَقدِ- حِرمانا!",146,"ن",2,0],["وهل ننسى صلاح الدين سيفاً","يعلم غاصباً كيف الجوابُ",147,"ب",1,0],["وهل ندرت تلك السجية أو عفت","فتذكر في التاريخ ضربةَ لازب",148,"ب",1,0],["وهل نَرى بِضياءِ الهَدْيِ بُغْيَتَنا","وهل لِدُمَّلِنا بالسَّيفِ مُبْتَسِرُ؟",149,"ر",1,0],["وهل ناقد الشكل الصحيح إذا العمى","أطل على الأبواب واستفحل الجهل",150,"ل",1,0],["وهل نسيتم عشيات معطرة","تندى رواءَ واشذاءَ وافنانا؟",151,"ن",2,0],["وهَلْ نَصونُ لها فينا كَرَامَتَها","نُشْفي نُفُوسًا بِها حَرَّى ونَشْفيها؟!",152,"ي",3,0],["وهل نحن نخشى غيره قلت هوّني","فللصبر إن لم يسعد الجد أنجح",153,"ح",1,0],["وهل ننسى خرير الماء","في الناعور يشجينا ؟",154,"ن",2,0],["وَهل نسمَة الأسحار جرت ذيولها","على زهر روض طيب النشر مَمْطُور",155,"ر",1,0],["وهل نسيتَ جراحاتٍ بُليتَ بها","حتى تُجرّبَ شوطا في مُجاراتِي؟!",156,"ت",2,0],["وهل نجم المجرة خاف جذبا","إلى ثقبٍ حرور مستطير؟!",157,"ر",1,0],["وهل نهلل للعام الجديد ولم","نمسحْ دموعَ يتيمٍ بات مُنتحِبا ..?",158,"ب",2,0],["وهل نسيتَ الهوى أم صرت تجحدُهُ","وأنت من لم يزل قلبي يخلِّدُهُ",159,"د",2,0],["وهل نسماتك الولهى سوى قبل","تنبه الورد من إغفاءة الكسل",160,"ل",1,0],["وهل نحيا بلا ماضٍ نراهُ","كأجمل ما تراه النفس أُنسا",161,"س",2,0],["وَهَلْ نَكَّرَتْ مِنْهُ اللَّيالِي مَعارِفاً","وَأَضْحَى كَمِثْلِ الزَّنْدِ لاحَ وِشامُهُ",162,"م",2,0],["وَهَلْ نِعْمَةُ اللهِ مِنْ حاسِدٍ","يُغَيِّرُ فِيها بِبُهْتانِهِ",163,"ن",2,0],["وهل نرجو سلامة من فقدنا","إذا ما شُق جيبٌ أو لثامُ",164,"م",1,0],["وهل نسيت بجفن البدر موعدنا","يصحو على همسنا الغافي وينطبق",165,"ق",1,0],["وهل نبقى نُعَلّبُ في المآسي","كسردينٍ يُشعشَعُ بالجرادِ؟",166,"د",1,0],["وهل نعمت من الدنيا برؤيتها","أما احترقت فأفزعت النجوم أما",167,"م",2,0]]}