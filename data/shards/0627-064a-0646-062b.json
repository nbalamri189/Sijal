{"poems":[[79,"سيدي أنت عمدتي فاحتملني","https://www.aldiwan.net/poem36788.html","الخفيف"],[1026,"","https://poetry.dctabudhabi.ae/diwan/poem/73563","البسيط"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35513","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94785","الرمل"]],"verses":[["أَيْنَ ثِقْلِي إِذَا فُرِضْت ثَقِيلاً","وَكَثِيرَ الْجَفَاءِ مِنْ هَؤُلاءِ",0,"ا",2,0],["أَينَ ثَوَى آدَمٌ وَنُوحٌ","وَالمُصطَفَى صاحِبُ البُراقِ",1,"ق",1,0],["أَينَ ثَمدٌ مِن غامِرٍ وَنضوبٌ","مِن جموم وَراشِحٌ مِن نُضوخِ",2,"خ",1,0],["أين ثأري من عدوٍّ لن ينام","ظالمٍ هصّارِ أعمارِ الأنام",3,"م",1,0]]}