 أَوْطانُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=63586",""],[5596,"الحب الضائع","https://www.poetsgate.com/ViewPoem.aspx?id=205603",""],[5628,"اقرعي الطبول","https://www.poetsgate.com/ViewPoem.aspx?id=178532",""],[5701,"أين المعز الفاطمي وجوهر","https://www.poetsgate.com/ViewPoem.aspx?id=164689",""],[5720,"ابتهال","https://www.poetsgate.com/ViewPoem.aspx?id=200685",""],[5725,"انوار محمد","https://www.poetsgate.com/ViewPoem.aspx?id=177543",""],[5756,"الذيب والراعي","https://www.poetsgate.com/ViewPoem.aspx?id=5419",""],[5790,"أهواه أسمر في اعتدال الأسمر","https://www.poetsgate.com/ViewPoem.aspx?id=112056",""],[5956,"أرجوك لا تَدْنَي","https://www.poetsgate.com/ViewPoem.aspx?id=182483",""],[5956,"فانوسُ أبي و(جلّ)* الصَّبي","https://www.poetsgate.com/ViewPoem.aspx?id=184561",""],[5956,"المضحوك عليهم.!","https://www.poetsgate.com/ViewPoem.aspx?id=192182",""],[5973,"أشعل من حوليَ أقمارَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=13769",""],[6031,"لَعِبتْ بعطفيهِ الشمولُ فَمَادَا","https://www.poetsgate.com/ViewPoem.aspx?id=46254",""],[658,"لَوَّمتَهُ وَعَنَفتَ في تَعنيفِه","https://www.poetsgate.com/ViewPoem.aspx?id=45927",""],[6093,"أنَسيتَ عهداً في الغرام جميلا","https://www.poetsgate.com/ViewPoem.aspx?id=176446",""],[6102,"رِقَّةٌ وَحشِيَّة !!","https://www.poetsgate.com/ViewPoem.aspx?id=184163",""],[2436,"هلا سألت منازِلاً بالأبرَقِ","https://www.poetsgate.com/ViewPoem.aspx?id=79429",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[6198,"الموجةُ الطروبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79239&r=&rc=13",""],[6290,"هَوَى الصِّبْيَانِ وَشْمٌ فِي قُلُوبٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85167&r=&rc=4",""],[6354,"منابر موبوءة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87923&r=&rc=0",""]],"verses":[["لَعِبَت بِكَ الدُنيا وَسَع","يُكَ في فَمِ الجَدِّ العَثورِ",0,"ر",1,0],["لَعِبَت بِها الأَنواءُ بَعدَ أَنيسِه","وَالرامِساتُ وَكُلُّ جَونٍ مُسبَلِ",1,"ل",1,0],["لَعَبْدُ اللّهِ في الوِزارَةِ مهْما","تُذوكِرَ خيْرُ مَنْ ركَضَ العِتاقَا",2,"ق",2,0],["لَعِبَت بِهِ الحُمّى سِني","نَ وَكانَ مِن أَصحابِها",3,"ب",3,0],["لَعَبَرتُهُ سَبحاً وَلَو","غُمِرَت مَعَ الطَرفاءِ غابُه",4,"ب",2,0],["لَعَبدانَ اِبنِ عاهِرَةٍ وَخِلطٍ","رَجوفِ الأَصلِ مَدخولِ النَواحي",5,"ح",2,0],["لَعِبَ البِلى بِمُلاعِبِ الأَلبابِ","وَمَحا بَشاشَةَ فَمِّكَ الخَلّابِ",6,"ب",1,1],["لَعِبَت يَمينُكَ بِاليَراعِ فَأَعجَزَت","لَعِبَ الفَوارِسِ بِالقَنا الخَطّارِ",7,"ر",1,0],["لَعِبَ الجَوادُ أَقَلَّ لَي","ثاً مِن قُضاعَةَ أَو نِزار",8,"ر",1,0],["لَعِبوا بِهِ في صورَةٍ قَد أَسفَرَت","عَن عَزلِهِ فَأَقامَ حِلسَ الدارِ",9,"ر",1,0],["لَعِبَ الرِياحُ بِرَسمِهِ فَأَجَدَّهُ","جونٌ عَواكِفُ في الرَمادِ جُثومُ",10,"م",1,0],["لَعِبٌ تَلاعَبُهُ الهَيُولَى جَائِحاً","بِالنَّارِ أَوْ بِالمَاءِ أَوْ بِالطِّينِ",11,"ن",1,0],["لِعَبلَةَ فَرعُ الحَيِّ قَد تَعلَمونَهُ","وَأَطيَبُ عِرقٍ في الثَرى المُتَدارِكِ",12,"ك",1,0],["لَعِبتُ عَلى أَكتافِهِم وَحُجورِهِم","وَليداً وَسَمَّوني مُفيداً وَعاصِما",13,"م",2,0],["لعبت بها ريحان ريح عجاجة","بالسافيات من التراب المعتقِ",14,"ق",1,0],["لعبتُ بأولى الدهر فاغْتَال شِرَّتي","بأخرى حَقُودٍ والجرائمُ تُحْقَدُ",15,"د",1,0],["لعبدك حقٌّ بالتَّحَرُّم واجبٌ","أبى لك طيبُ الخِيم لؤمَ جحودِهِ",16,"د",2,0],["لعبة عُدِّلت فدقَّت وجلَّت","وإذا ما لمستَها فحريرا",17,"ر",2,0],["لَعِبَت بِها صِفَةُ النَعامَةِ بَعدَما","زُوّارُها مِن شَمأَلٍ وَدَبورِ",18,"ر",1,0],["لُعَبٌ تُحرِّكُها المَطامعُ واللّهى","وصَغائرُ الأحقادِ والآرابِ",19,"ب",1,0],["لِعَبدِكَ هِمَّةٌ هامَت","بِرَكضِ الضُمَّرِ الجردِ",20,"د",1,0],["لَعِبَت بِجِدَّتِها الشَّمالُ وَصابَها","نَوءُ السماكِ بِمُسبِلٍ هَطَّالِ",21,"ل",1,0],["لُعبة الناظر في غرفته","أم أفاد العلم أم أجدى الثراء",22,"ا",2,0],["لَعِبَ الدَهرُ في ثَراهُ صَبِيّاً","وَاللَيالي كَواعِباً غَيرَ عُنسِ",23,"س",1,0],["لَعِبَت بِمِشيَتِهِ الشُمولُ وَغادَرَت","صَنَماً مِنَ الأَصنامِ لَولا الروحُ",24,"ح",1,0],["لَعِباً يَستَدِرُّ خِلفَ شَبابي","حَلَبَ الدَهرَ زَينَباً وَلَعوبُ",25,"ب",1,0],["لَعِب ما أَتَيتِ مِن ذَلِكَ الصَد","دِ فَنَرضاهُ أَم صَريمَةُ عَزمِ",26,"م",1,0],["لَعِبوا وَلَجَّ بِهِم لَجوجٌ ماحِكٌ","في الحَربِ يُرخِصُها عَلى المُستامِ",27,"م",1,0],["لَعِبَ العَجاجُ بِكُلِّ مَعرِفَةٍ لَها","وَمُلِثَّةٌ غَبَياتُها مِدرارُ",28,"ر",1,0],["لَعِبَتْ أيدٍ لها أَقْ","فِيَةُ القَوْمِ طُبولُ",29,"ل",1,0],["لَعِبَ الزَمانُ بِها وَغَيَّرَها","بَعدي سَوافي المورِ وَالقَطرِ",30,"ر",1,0],["لَعِبَ الشَيبُ بِالمَفارِقِ بَل جَد","دَ فَأَبكى تُماضِراً وَلَعوبا",31,"ب",2,0],["لَعِبَ الزَّمَانُ بِهَا فَغَادَرَ جِسْمَهَا","شَبَحَاً تَهَافَتُ دُونَهُ الأَوْهَامُ",32,"م",1,0],["لَعِبَ الزَّمَانُ بِهَا فَغَادَرَ جِسْمَهَا","شَبَحاً تَحَارُ لِدَرْكِهِ الأَفْهَامُ",33,"م",1,0],["لَعِبَت بِجَدَّتِها الرِياحُ وَتارَةً","تَعتادُها دِيَمٌ بِأَسحَمَ مُرهِمِ",34,"م",1,0],["لَعِبَت بِها الأَرواحُ بَعدَ أَنيسِها","نَكباءُ تَطَّرِدُ السَفا وَدَبورُ",35,"ر",1,0],["لَعبدُ اللاتِ أكرمُ فيكِ عهداً","وعبدُ يغوثَ ممّن تحملينا",36,"ن",2,0],["لَعِبَ الغُرورُ بِهِ فَضَيَّعَ مُلكَهُ","وَاِعتاضَ عَنهُ مَذَلَّةً وَخَبالا",37,"ل",2,0],["لَعِبَ القِلى بِوُعودِهِ","فَكَأَنَّما كانَت حُطَم",38,"م",1,0],["لَعِبَتْ به الدّنيا ولولا جَهْلُه","ما كان في الدنيا يخوضُ ويَلعبُ",39,"ب",1,0],["لَعِبَت بِهِ ريحٌ يَمانِيَةٌ","وَحَواصِبٌ تَرَكَتهُ كَالطَرسِ",40,"س",1,0],["لِعَبدَةَ دارٌ ما تُكَلِّمُنا الدارُ","تَلوحُ مَغانيها كَما لاحَ أَسطارُ",41,"ر",1,1],["لَعِبوا في الحُروبِ حَتّى اِستَكانَت","ثُمَّ راحوا في المِسكِ أَو في العَبيرِ",42,"ر",1,0],["لِعَبدَةَ إِنّ عَبدَةَ تَيَّمَتني","وَحَلَّت مِن فُؤادي في السَوادِ",43,"د",1,0],["لَعِبَت بِهِ أَيّامُهُ فَكَأَنَّهُ","حَرفٌ يُلَيَّنُ في الكَلامِ وَيُنبَرُ",44,"ر",1,0],["لَعِبَ الوَلائِدُ بِالسَبا","ئِكِ وَاِطَّرَحنَ بَناتِ عَنبَر",45,"ر",1,0],["لعِبْتَ بسِحْرِنَا والشّعْرُ سِحْرٌ","فتُبْنا منه تَوْبَتَنا النّصوحا",46,"ح",2,0],["لَعِبَت بَعدي السُيولُ بِهِ","وَجَرى في رَيِّقٍ رِهَمُه",47,"م",2,0],["لعبت بلبك من سلافة حبه","كأس كَما شاء الغَرام دهاق",48,"ق",1,0],["لعبت بمشيته الشمول وجردت","صنماً من الأصنام لولا الروح",49,"ح",1,0],["لَعِبَت بِها الأَنواءُ بَعدَ أَنيسِها","وَالرامِساتُ وَكُلُّ جَونٍ مُسبَلِ",50,"ل",1,0],["لَعِبَ الزَّمَانُ بِجَمْعِهِمْ","وَرَمَى بِهِمْ في كُلِّ وَادِي",51,"د",2,0],["لَعَبَّاسٌ خَيْرٌ لِلْمَعَالِي مُقَلِّداً","فَكُنْ بِالنُّهَى خَيْراً لَهَا مُتَقَلِّدَا",52,"د",2,0],["لعبت بالعقول إلا قليلاً","بين تأويبها وبين سراها",53,"ا",3,0],["لعبت به هوج العواصف فالتوى","متقصفاً وأصيب بالرجفان",54,"ن",1,0],["لعبها بين ازرقاقِ الجدول","والسما الزرقاء",55,"ا",2,0],["لَعِبَتْ بِكَ الْحَسْناءُ تَدْنُو ساعةً","فَتُثِيرُ ما بِكَ ثُمَّ تَهْجُرُ عَاما",56,"م",2,0],["لعِبتْ بالنهَى فأصبح غَيَّا","كلُّ رُشْدٍ وأصبح الغَيُّ رُشدا",57,"د",2,0],["لعَبْدانَ ابنِ عَاهِرَة ٍ وَخِلْطٍ،","رجوفِ الأصلِ مذخولِ النّواحي",58,"ح",2,0],["لعباً يستدر خف شبابي","حلب الدهر زينب ولعوب",59,"ب",1,0],["لعبت به من ريم حاجر لوعة","كشفت لارباب الهوى سر الهوى",60,"و",2,0],["لعبت به ايدي الغرام فسار من","آلامه ابدا بقيد مطلق",61,"ق",1,0],["لعبت بها نسماتها فالقلب في","ارجائها شغفا بها مطروح",62,"ح",1,0],["لعبت مهاة الأخضرين بمهجة","تلفت بها ونأت عن الأغيار",63,"ر",1,1],["لعبٌ ما أرقت من ذلك الدم","ع ودل أم أنت جد حزين",64,"ن",1,0],["لعب الأسَى بقلوبنا وعُقُولِنا","لما سمعنا أنّك المتألّمُ",65,"م",1,0],["لَعِبَت بَعدَ ما انقَضَى الرَّيعَانُ","مِن شَبَابي بِحِلمِىِّ الأظعَانِ",66,"ن",1,1],["لَعِبَت بِإرعِوَائِهِ ذكَرَاتٌ","مَلاَتهُ زَوَافِراً وهُمُومَا",67,"م",2,0],["لَعِبنَ بِنَا وقُلنَ لَنَا خَسِرتُم","أجَبتُم دَاعِىَ الغَىِّ السَّمِيعَا",68,"ع",2,0],["لَعِبتِ بِلبِّهِ وطَوَيتِ عَنهُ","بِسَاطَ الوَصلِ وَاختَنتِ العُهُودا",69,"د",2,0],["لَعِبَت قُومُ الرياحِ بِها","وَعَفَتهَا كُلُّ نَكبَاءِ",70,"ا",2,0],["لعبٌ مفاتيحُ الهوى","والحرب أوّلُها طِرادُ",71,"د",1,0],["لَعِبَتْ بِهِ أَيْدي البِلى فِي مَلْعَبٍ","لَوْ أَنَّنَا مُتْنا بِهِ لَحَيينا",72,"ن",2,0],["لعبتْ بمشيتِهِ الشما","لُ فجنبتهُ إلى الجنوبِ",73,"ب",1,0],["لعبتُ بالزمنِ الماضي فخَلَّفني","من بعده في زمانٍ ظلَّ يلعب بي",74,"ب",2,0],["لِعَبْدِك في ميسورِ فضِلك حاجةٌ","نَتيجتُها منه ثَناً وَثَواب",75,"ب",1,0],["لعبت بهم أيدي المنو","ن فعانقوا ظلم الحفائر",76,"ر",1,0],["لَعِبَت بِضاحيها الرِياحُ فَأَصبَحَت","لَأياً تَأَمَّلَها شِفا المُتَأَمِّلِ",77,"ل",1,0],["لعبت بطلعته الرُّشا لعب الرَّشا","بفؤادِ خفَّاقِ الجوانحِ مُدنف",78,"ف",1,0],["لعب الهوى بجوارحي فَأَذابَها","فالقلب بين حشا الضلوع مُعَارُ",79,"ر",1,0],["لعب الحبُّ بقلبي","لَعبَ شوقي باصطباري",80,"ر",2,0],["لعبت بقلبي والحشا اهواه","اترى لداء في هواي دواء",81,"ا",2,1],["لعبدك عجل بالعطاء تكرما","فقد قيل خير البر والله عاجله",82,"ل",2,0],["لِعبارَةٍ أَو نَظرَةٍ من أَجلِها","عَبدَ الرجالُ الطهرَ مُذ عَبَدوكِ",83,"ك",1,0],["لَعبَت فِتيانُهُ فيهِ دداً","ما اَرادَت مهنَةً غيرَ الدَدِ",84,"د",1,0],["لَعِبَت مِراضُ جُفونِهِ","مِنّا بِأَفإِدَةٍ صِحاحِ",85,"ح",1,0],["لِعَبْدِ اللهِ وَجَّهْتُ الْخِطَابَا","لِمَنْ فَاتَتْ مَعالِيهِ الْحِسابَا",86,"ب",2,1],["لَعِبَت بِها ريحُ الصَبا فَتَنَكَّرَت","إِلّا بَقِيَّةَ نُؤيِها المُتَهَدِّمِ",87,"م",1,0],["لعبدِ القادرِ اضطَرَبَت فرَنسا","وكان الإنتِصارُ لها انكِسارا",88,"ر",2,0],["لعب الفراق بها وَبي فَلَها وَلي","خبر كوى كبدي بغير زناد",89,"د",1,0],["لَعِبَت بِها هوجٌ يَمانِيَةٌ","فَتَرى مَعارِفَها وَله تَدري",90,"ر",2,0],["لعبتْ بها ريحُ الهوى فتمايلتْ","ميناؤها المنشودُ باتَ مُضّيَّعَا",91,"ع",2,0],["لَعِبَت بها هُوجُ الرياحِ وَبُدِّلَت","بعد الأَنيسِ مَكَانِسَ الثيرانِ",92,"ن",1,0],["لَعِبَت جُفونُكَ بِالقُلوبِ وَحَبِّها","وَالخَدُّ مَيدانٌ وَصُدغُكَ صَولَجا",93,"ج",2,0],["لعبَت لُعَيبةُ بِالعُيو","نِ وبِالقُلوبِ وغَير ذلِك",94,"ك",1,1],["لَعِبَت بِهِم أَيدي سَبا فتَفرَّقوا","فِرَقاً يَضُمُّ قريبُها البُعداءَ",95,"ا",2,0],["لَعِبَت بِها هَوج الرِياح فَأَصبَحَت","تَبدو مَعالِمُها كَلَون الأَرقم",96,"م",1,0],["لَعِبَت بِصَبري فَاِنطَوى","فَفَزعت لِلدَمع السَكوب",97,"ب",1,0],["لَعِبَ الشَّوق بأحشائي وما","جَدَّ جِدُّ الوَجْد حتَّى لعبا",98,"ب",2,0],["لعبد القادر الجيلي يُنمى","وقطب الغوث والنبأ العظيم",99,"م",1,0],["لعب الهوى بقوامه فتخاصمت","عند الوشاح ذوائبٌ ومعاطفُ",100,"ف",1,0],["لعبت به أيدي الصبا","فلوى النحور على الخصور",101,"ر",1,0],["لعبت بهم أيدي النوى فكأنّهم","ركبوا على متن الرياح الأربع",102,"ع",1,0],["لعب وضحك مثلما نبتغي","مع الف خود دون لوم وعاب",103,"ب",1,0],["لعبتْ ب