//www.poetsgate.com/ViewPoem.aspx?id=179541",""],[4767,"الغدير","https://www.poetsgate.com/ViewPoem.aspx?id=179578",""],[4883,"تعب راحة","https://www.poetsgate.com/ViewPoem.aspx?id=48437",""],[5135,"تتابعت الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=206411",""],[5147,"روح النفس فهي ضيف بمغناك","https://www.poetsgate.com/ViewPoem.aspx?id=166733",""],[5183,"البدوي والوهم","https://www.poetsgate.com/ViewPoem.aspx?id=180279",""],[5187,"عيد الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=33005",""],[5338,"في رثاء أستاذي الأول قدس الله سره","https://www.poetsgate.com/ViewPoem.aspx?id=187778",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5353,"ملحمة فجر الصابرين","https://www.poetsgate.com/ViewPoem.aspx?id=212649",""],[5377,"إلى الغاضبين علينا","https://www.poetsgate.com/ViewPoem.aspx?id=61899",""],[5497,"قد توقد لاهبه","https://www.poetsgate.com/ViewPoem.aspx?id=205951",""],[5582,"أَتَجْحَدُ داءَ الحُبِّ عِنْدَ المُشاهِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186906",""],[5582,"لائِمِي فِي الحُبِّ مَهْلاً فَلَقَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=63495",""],[5628,"الكأس والدموع","https://www.poetsgate.com/ViewPoem.aspx?id=178704",""],[5630,"الحمدُ للَّه ربَّ العالمين على","https://www.poetsgate.com/ViewPoem.aspx?id=15412",""],[243,"دجلة الغضبى","https://www.poetsgate.com/ViewPoem.aspx?id=50472",""],[5691,"يوم يُبعثون","https://www.poetsgate.com/ViewPoem.aspx?id=206744",""],[5783,"إنما \"هند\"إسم كل جميل","https://www.poetsgate.com/ViewPoem.aspx?id=53716",""],[5970,"أيها الثاوي الذي ليس يزار","https://www.poetsgate.com/ViewPoem.aspx?id=130675",""],[5997,"العنابه","https://www.poetsgate.com/ViewPoem.aspx?id=214232",""],[6056,"دلعهن عالي المستوى","https://www.poetsgate.com/ViewPoem.aspx?id=130337",""],[6056,"الجرح القديم","https://www.poetsgate.com/ViewPoem.aspx?id=130355",""],[6069,"بعزمك أيها الملك العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=105705",""]],"verses":[["يَومٌ لِذا وَغَدٌ لِذاكَ وَهَذِهِ","شِيَمٌ مُقَطِّعَةٌ قُوى الأَقرانِ",0,"ن",1,0],["يَومَ لِلشِعبِ دِهانٌ مِن دَمٍ","وَالمَواضي لِلمَقاديمِ فَوالي",1,"ل",2,0],["يَومَ لا غَيرَ زَفرَةٍ مِن فُؤادٍ","ذي قُروحٍ وَرَشَّةٍ مِن مَآقِ",2,"ق",1,0],["يُؤَمِّلُ الناسُ أَن يَبقَوا وَما عَلِموا","أَنَّ الفَتى لِيَدِ الأَقدارِ مَولودُ",3,"د",1,0],["يَومَ لا يَثبُتُ وَجهٌ","مِن كُلومٍ وَنُدوبِ",4,"ب",1,0],["يَومَ لا كِسرَ حِجابٍ مانِعٌ","بِذلَةَ العَينِ وَلا ظِلَّ خِبا",5,"ا",1,0],["يؤمِّلُ تقْبيلَ البِساط ومَنْ له","بهِ وبروقُ الهِندِ عيْنَيْهِ تخْطِفُ",6,"ف",1,0],["يؤَمِّلُ بالسِّلْمِ انتِظامَ شَتاتِهِ","وهيْهاتَ يُرْجى وصْلُ ما اللهُ قاطِعُ",7,"ع",1,0],["يؤمِّلُ نيْلَ القُرْبِ والذّنْبُ مبْعِدٌ","وقد سدّ من طُرْق التخلُّصِ ما سَدّا",8,"د",2,0],["يُؤَمِّلُ أَن تَكونَ لَهُ ثَراءً","فَأَغلَقَ دونَها وَعَلا سِواما",9,"م",2,0],["يَومَ لا يُدخِلُ المُدارِسَ في الرَح","مَةِ إِلّا بَراءَةٌ وَاِعتِذارُ",10,"ر",1,0],["يَومَ لَقَيناكَ تَرمينا السَمومُ وَقَد","كادَ المُلاءُ مِنَ الكَتّانِ يَحتَرِقُ",11,"ق",1,0],["يَومَ لا تُنبِتُ السُهولُ سِوى النا","سِ وَغَيرَ الأَسِنَّةِ السَمراءِ",12,"ا",2,0],["يُؤَمِّلُ مِن صَدرها ضَمَّةً","تُبَوِّئُهُ صَدر كُفء مُعينِ",13,"ن",1,0],["يؤمل المهضوم ان","يرحم من لا يرحم",14,"م",1,0],["يؤملون زعيما فيه تسرية","وهل يسري عن المصفود مصفود",15,"د",1,0],["يوم لم يبق في العراق لصرح","المجد مجد الآباء الا طلول",16,"ل",1,0],["يوم لا نبصر الربيع ولا نصغى","لانغام البلبل الغريد",17,"د",1,0],["يوم لا تطلع النجوم علينا","باسمات من السماء كخود",17,"د",1,0],["يوم لا يسفر الصباح لنا من","جانب الشرق قائما كعمود",17,"د",1,0],["يوم للغيد كنت اصبو ومن ذا","ليس يصبو الى الحسان الغيد",17,"د",1,0],["يؤمل بعد الموت عود حياته","فقد وعدوه بعد طي له نشرا",18,"ر",2,0],["يَومٌ لَكُم يَبقى كَبَدرٍ عَلى","أَنصارِ سَعدٍ وَعَلى صَحبِهِ",19,"ب",2,0],["يُؤَمَّلُ في لينِ اللُبوسِ وَيُرتَجى","لِطولٍ وَيُخشى في السِلاحِ وَيُرهَبُ",20,"ب",1,0],["يُؤَمَّلُ جَدواهُ وَمَرجُوُّ نَيلِهِ","كَما غَنِيَت مِصرٌ تُؤَمِّلُ نيلَها",21,"ل",3,0],["يُؤَمَّلُ لِلخَيرِ الكَثيرِ إِذا نَبَت","خَلائِقُ أَصحابِ الخُيورِ القَلائِلِ",22,"ل",1,0],["يُؤَمِّلُ أَكثَرَ مِن عُمرِهِ","وَيَزدادُ يَوماً بِيَومٍ أَشَر",23,"ر",1,0],["يَومٌ لَنا كانَت رِئاسَةٌ أَهلِهِ","دونَ القَبائِلِ مِن بَني عَدنانِ",24,"ن",1,0],["يَومَ لا طارقُ عادَ القهقري","لا وَلا آباؤنا أُسدُ العَرين",25,"ن",1,0],["يَومَ لا عَزمُ الجِبالِ الراسيات","مُشبهٌ عَزمَ شَبابِ المَغربِ",25,"ب",1,0],["يَومَ لا يَنفَعُ المُخَوَّلَ ذا الثَر","وَةِ خُلّانُهُ وَلا وَلَدُه",26,"د",2,0],["يَومَ لَهَونا وَالهَوى مَستورُ","في فِتيَةٍ لَم يَلقَنا تَكديرُ",27,"ر",1,0],["يَومَ لا تَحسَبي يَميني خِلاباً","بِيَميني تُوَقَّرُ الأَحشاءُ",28,"ا",2,0],["يُؤَمِّلُ كُلٌّ أَن يَعيشَ وَإِنَّما","تُمارِسُ أَهوالَ الزَمانِ إِذا عِشتا",29,"ت",2,1],["يُؤَمَّلُ القَومُ عِندي شيمَةً حَسُنَت","وَشيمَةُ الدَهرِ أَن لا تَحسُنَ الشِيَمُ",30,"م",1,0],["يؤمل فيك إسعاف الليالي","وينتظر العواقب أن تديلا",31,"ل",2,0],["يومَ لا أَتَّقي بكفِّي طَوالَ الدَّ","هرِ أنصارَهُ بغيرِ أحتِيالِ",32,"ل",1,0],["يوم لو عين علينا وقعت","لرأت روحين جالا في جسد",33,"د",1,0],["يومٌ لَوَى لَيانُهُ لم يَبْق للإسلام","حدٌّ مُهندٍ إلا نَبا",34,"ب",2,0],["يَومَ لا يَنفَعُ الرَواغُ وَلا يُق","دم إِلّا المُشَيَّعُ النِحريرُ",35,"ر",1,0],["يؤمل انني اعطيه سمعا","وعنه رصصت في اذني فراغا",36,"غ",2,0],["يؤمل ان الله يحسن بالرضا","ويصرف هما كل ما بات يرهب",37,"ب",1,0],["يومَ لا ينفع مالٌ وبنونْ","يوم يَبْدُو كل ما تُخْفِى الظُنونْ",38,"ن",1,0],["يُؤمِّلُ أن سَيبلغُها","فيحظى أو إذَن يَفنى",39,"ن",2,0],["يَومٌ لَعَمرُكَ لَم تَزَل أَخبارُهُ","مَسموعَةً مِن مُنجِدٍ أَو مُتهِمِ",40,"م",1,0],["يُؤَمَّلُ مِنهُ النَفعُ يُؤمَنُ ضَيرُهُ","يَعُمُّ الوَرى إِن أَخلَفَ الغَيثُ مَيرُهُ",41,"ه",1,0],["يوم لها عندك خير لها","من ألف شهر من القرون التي",42,"ي",1,0],["يَومَ لا يَنفَعُ اِتِّصالٌ بِقُربى","يَومَ لا العُذرُ عِندَهُ مَقبولُ",43,"ل",1,0],["يومٌ له زَفَّت الدنيا عرائسَها","لهنَّ من سندسٍ خُضرٍ سرابيلُ",44,"ل",1,0],["يوم لا يظلمون شيئاً وتجزى","كل نفس وتشهد الأعضاء",45,"ا",2,0],["يوم لا ينفع التكاثر والما","ل ولا تنتمي لك الأبناء",45,"ا",2,0],["يومٌ لنا بالنيل مختصرُ","ولكل يوم مسرّةٍ قِصَرُ",46,"ر",1,1],["يوم لا ينطِقون فيه ولا يؤ","ذَن في هُوْلِه لَهمْ باعتذار",47,"ر",1,0],["يَومَ لا تَحبَطُ أَعمالُ فَتىً","حُبُّكُم في كَفَّتي ميزانِها",48,"ن",3,0],["يَوْمَ لاَ يَجْزِي وَالِدٌ عَنْ وَلِيدٍ","لاَ وَلاَ هُوَ عَنْهُ قِيدَ نَوَاةِ",49,"ه",1,0],["يومَ لاَ يُغْنِي عَنْ خَليلٍ خَليلٌ","كَانَ بَرًّا بِهِ زَمانَ الْحَيَاةِ",49,"ه",1,0],["يومَ لاَ ظِلَّ غَيْرُ ظِلِّكَ رَبِّي","يَا غَنِيّاً عَنّيِ وَعَنْ حَسَنَاتِي",49,"ت",2,0],["يُؤَمِّلُ شِرباً مِن ثَميلٍ وَمأسِلٍ","وَما المَوتُ إِلّا حَيثُ أَرَّكَ مأسَلُ",50,"ل",1,0],["يؤملن عودى بما ينتظرن","كما يرتجى آئب من سفر",51,"ر",1,0],["يُؤَمِّلُ في الأَيّامِ ما لَيسَ مُدرِكاً","وَلَيسَ لَهُ مِن أَن يُنالَ خَفيرُ",52,"ر",1,0],["يوم لا ينفع الأفاعي فحيح","ويكون الفضاء زأر الأسود",53,"د",1,0],["يَومَ لا نَفَعُ إيمانُ اِمرِئٍ","بِيَ لَم يَستَجلِني في جَلوَتَي",54,"ي",1,0],["يومٌ لهُ فضلٌ على الأيّامِ","مزجَ السَّحابُ ضياءَهُ بظَلامِ",55,"م",1,1],["يوم لاح الحمى فقلت لصحبي","هذه دارهم وتلك الخيام",56,"م",1,0],["يوم لا تُشْرِقُ إلاَّ بدمٍ","مرهفاتٌ تَتَشكَّاه فلولا",57,"ل",2,0],["يُؤَمِّلنا المنى فيك المنايا","ويُوقعُنا غرامك في المهالك",58,"ك",1,0],["يُؤَمِّلهم من جود كفِّك نائل","ويزجرهم من حد سيفك زاجر",59,"ر",1,0],["يؤمّل من مكارمك الأَماني","ويرقبُ منك صادقة البروق",60,"ق",1,0],["يومٌ لَكَ اكتُتِبَتْ شهادَاتُ النَّدى","بالمِسْكِ فِي صُحُفِ الوجوهِ سُطُورا",61,"ر",2,0],["يوم للرحلة مرتهن","ذو الروح فلاحيّ مخلد",62,"د",1,0],["يؤمِّل كبتَ أعاديكُمُ","وقد حقّق الله ذاك الأملْ",63,"ل",1,0],["يومٌ لآبائك في حفظه","عهدٌ يُراعَى حقُّهُ الواجبُ",64,"ب",1,0],["يوم لا حسن الغواني شافعٌ","عند ذي الطعن ولا ودُّ الحميم",65,"م",1,0],["يَومَ لا تَستُرُ أُنثى وَجَهَها","وَنُفوسُ القَومِ تَنزو في الحُلوقِ",66,"ق",1,0],["يومَ لا يحفلُ لِي سَمْ","عٌ بعذلٍ من عذولِ",67,"ل",1,0],["يومٌ لغيركَ ترجوهُ وليسَ لهُ","كُلٌّ ليومٍ غَدَاةَ البينِ مشهودِ",68,"د",1,0],["يُؤَمِّلُ جَنَّةَ الفِرْدَوْسِ قَوْمٌ","وَآمُلُ مِنْهُ شَمَّا أَوْ عِضَاضَا",69,"ض",2,0],["يَومَ لَم يَترُكوا عَلى ماءِ عَمقٍ","لِلرِجالِ المُشَيِّعينَ قُلوبا",70,"ب",2,0],["يؤمّل شعبكم منكم قياماً","لنصرتهِ ببيض ماضياتِ",71,"ت",1,0],["يوم لا مال نافع وبنون","غير عفوٍ من الغفور الودودِ",72,"د",1,0],["يومَ لا خُلّةٌ ولا بيعَ فيه","لا ولا ألفةٌ ولا أنسابا",73,"ب",2,0],["يَومَ لاقَيتُ بِالبَلاطِ بِجاداً","لَيتَ أَنّي هَلَكتُ قَبلَ بِجادِ",74,"د",1,0],["يُؤَمِّلُ أَن يُعَمَّرَ عُمرَ نوحٍ","وَأَمرُ اللَهِ يَحدُثُ كُلَّ لَيلَه",75,"ه",1,0],["يوم لا تملك النفوس خلاصا","لنفوس تسام بالأبعاد",76,"د",1,0],["يَومَ لا ينفعني مطرفٌ","كنتُ قَد جمّعته ومتّلَد",77,"د",1,0],["يوم لبست المجد كان ثناؤه","بين الخلائق في المحافل يذكر",78,"ر",1,0],["يؤمل هذا العبد والجود شامل","وما ظن يوماً أن يخيب آمل",79,"ل",1,0],["يومَ لا بشرَ لأبناءِ بني","عامرٍ والضيفِ والجارِ الأذَل",80,"ل",1,0],["يُؤَمَّلُ أهْلُ الشَّامِ عَمْراً وإنَّنِي","لآمُلُ عَبْدَ اللَّهِ عِنْدَ الْحَقائِقِ",81,"ق",1,1],["يؤمل أن أوافقه وأنَّى","يوافق عبد نعمتك الهوانا",82,"ن",2,0],["يُؤَمِّلُ ما يُؤَمِّلُ مِن","صُنوفِ المالِ وَالوَلَدِ",83,"د",1,0],["يوم لم تلف ذره عنه إلا","تجد الرعب آخذاً بقواها",84,"ا",3,0],["يوم لا تنثني لرشد ولكن","عام فيها حسامه ففناها",84,"ا",3,0],["يوم لا ريّ والأنام صواد","غير نفس تنال منهم رواها",84,"ا",3,0],["يوم لا تملكُ النفوسُ انتصاراً","وله الأمر وحدَهُ كلَّ آنِ",85,"ن",1,0],["يَومَ لا تملك النفوسُ فِدَاء","أو فِراراً مما ترى وتُعاني",85,"ن",2,0],["يوم لا ينفعُ ابن آدم إلا","حسناتٌ تقدّمَت ووفاء",86,"ا",2,0],["يوم لا ينفعُ المسيء اعتذارٌ","عن ذُنُوبٍ ويدلهمُّ البلاء",86,"ا",2,0],["يومَ لا تملكُ النفوس انتصاراً","وله الأمرُ وحدَهُ والقضاء",86,"ا",2,0],["يَومَ لم تخشَ غيرَ ربِّكَ قَهَّا","راً ولم ينتقصكَ طينٌ وماء",86,"ا",2,0],["يوم لا دُقَّ بالحديد تراب","لا ولا شُقَّ بالبخار الماء",87,"ا",1,0],["يُؤمل كُلٌّ بِما يَشتَهي","وَإِمّا يَنالُ غَدا في حنق",88,"ق",1,0],["يوم لاحوا على الجياد المذاكي","تنهب الأرض بالمسير انتهابا",89,"ب",2,0],["يوم لنوى معترك العُشَّاقِ","بني يد التوديع والفراق",90,"ق",1,0],["يوم لا ينفع البنون ولا الما","ل سوى من أتى بقلب صافي",91,"ف",2,0],["يوم لا سؤدد إلا وانقضى","وحسام للعلى إلا وفلا",92,"ل",2,0],["يوم له والمنايا السود شاهدة","بأنه بدرها الوقاد في الظلم",93,"م",1