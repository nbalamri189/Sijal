,["إنِّي مِنَ القَوْمِ الَّذِينَ عَرَفْتَهُمْ","لا تُخْمِدُ الأَيامُ ما هُمْ أَوْقَدُوا",208,"د",3,0],["إِنْ يَمُتِ المَرْءُ فَمَوْتٌ واحِدٌ","اوْيَحْيَ بالهُونِ فالفٌ قَدْ نَما",209,"ا",1,0],["إني محضتك بالمودة ناصحاً","فاسمع أخيَّ نصيحتي ونظامي",210,"م",2,1],["إن يمنع الرحمن عبداً حاجَةً","فقيل هذا من فلانِ الأبْلسِ",211,"س",1,1],["إن يمش قلتُ الشمس طالعةٌ","لما بدا للعين أو قمرُ",212,"ر",1,0],["اني من القوم الذين يرونه","ادبا وليس توهما وتخيلا",213,"ل",2,0],["ان يمض منها هزيع","قالت ستأتي التتمه",214,"ه",1,0],["إن يمض هذا العيد أنت الذي","يبقى لنا عيداً وترعانا",215,"ن",2,0],["إنْ يَمدحوك فإنَّ فضلَكَ لم يَزَلْ","في الناسِ يُنطِقُ ألْسُناً وصُخُورا",216,"ر",2,0],["إنَّي مُنِيتُ بقلبٍ ذابَ أكثرُه","هَلَّا رَحِمْتِ بَقَايَا ذَلِكَ الْقَلْبِ",217,"ب",1,0],["إن يمدح الشعراء سلطانا فما","مدحي سوى حمدي لمولاي الولي",218,"ل",2,0],["إني مع الليل طول الدهر أصحبه","سواده شجنٌ في النفس موجود",219,"د",1,0],["إني مدين ماحييت لها بما","كانت تساندني فعاد عطاء",220,"ا",2,0],["أن يمسحَ الدمعَ عن خدِّ اليتيم وأن","يكون عونا وإسنادا لمن نُكِبَا",221,"ب",2,0],["إنِّي مَددتُ يدَ التَّسامحِ صَافِحاً","فاصفحْ فتلكَ أُخوُّةُ الإيِمانِ",222,"ن",1,0],["إنّي مُنعتُ رُضاب الحبِّ ألثمهُ","حتّى بطيفِ خيالٍ غابَ وامتنعا",223,"ع",2,0],["إِنِّي مِنَ الشِّعْرِ شَطْرٌ لا التِحَامَ لَهُ","إلاَّ بعَينَيكِ يَا بحبُوحَةَ الصَّدْرِ",224,"ر",1,0],["إني مفارقُ أحبابٍ سُعدت بهم","فكيف لي بعد ذاك السعدِ أحتفلُ",225,"ل",1,0],["إنّي مكثتُ على دروبِ ربيعها","وبدأتُ منها رحلتي وعتادي",226,"د",2,0],["إني مللت من المديح لأنني","ألفيت أن أخا الحذاقة بأقل",227,"ل",1,0],["إني ملبٍّ دعوةً مِن عارفٍ","بالشعر لاقاني أتيهُ بلا رصيدْ",228,"د",1,0],["إني مع الأنثى تعودُ طفولتي","وأعيش فيها من حياتي الراغدهْ",229,"د",2,0],["إني محبٌ رغمَ هذا كّله","ولئنْ قصدتُ الحربَ خير مُبارِ",230,"ر",1,0],["آني من كثر السوالف ايست","كل دقيقه يجيني واحد يقترح",231,"ح",1,0],["آني ما لومك لمت بيك الكلب","شكد نصحته وما نفع بيه النصح",231,"ح",1,0],["آني مكسور بحياتي","واليطيبني هواك",232,"ك",1,0],["آني متوطن عليهه","وعابر حدود الندم",233,"م",1,0],["إنِّي مَعَ الخمسينَ فانتظري","لا تمنعي الينبوعَ واسقيني",234,"ن",2,0],["إنّي مع الحزنِ ﻻ أنفكُّ مرتحلاً","والحزنُ يعرفني ﻻ زلتُ أهواهُ",235,"ا",2,0],["إني مللتُ النوى..داراً ومرتحلاً","فهل إليكِ سبيلٌ وارفُ الظُللِ",236,"ل",1,0],["إني مللتُ من الأشعارِ والكذبِ","ومِن قوافيَ لا تشفي لمكتَئبِ",237,"ب",1,1],["إني مرضتُ بحبِّ من منها الدوا","إني عشقتُ لكي أصيرَ عليلا",238,"ل",2,0],["أن يمنعنّك عن هواي وعنفه","ويصون خطوك من شراك ضلاله",239,"ل",2,0],["إني منحتكِ عرشَ قلبي دائما","وعليه يا بنتَ الخلود تربعي",240,"ع",2,0],["إنّي مسلوبٌ من ذاتي","سبقتني شوقا كلماتي",241,"ي",1,0],["إنّي ملكت من الزمانِ زمانَه","وبلغت أقصى ما أحبّ وأعشقُ",242,"ق",1,0],["أنّى مشيْتُ ورانا ألفُ قافلةٍ","على الطريقِ بهم يسْتأسِدُ النّذلُ",243,"ل",1,0],["إني متيم حبكم","يادرة بين البشرْ",244,"ر",1,1],["إني مضيتُ هزبرا في بسالته","أجابه الوحش في غابات من تاهوا",245,"ا",1,0],["إني مددت إليك أشرعتي","لأطير فوق البحر غرّيدا",246,"د",2,0],["إني مللتُ هواءَه بتنفسي!","مللي من الأشواقِ والزفراتِ!",247,"ت",1,0],["إني مدحتك مدحا لا أريد به","شكر الأنام ولا قرب السلاطين",248,"ن",1,0],["إني مللت وصاياتٍ تكبلني",": تجارة الدين شِركٌ غير مرغوب",249,"ب",1,0],["إنْ يمتْ فالجنان درب رحيلٍ","أو يعشْ فالحياة بالحق تسطعْ",250,"ع",1,0],["إنى مدائن حب كدت تدخلها","كالفاتحين بأبواقٍ وإطراءِ",251,"ا",2,0],["إن يمكن الله يوماً من هزيمتكم","يورث نساءكم داءً بتقراح",252,"ح",1,0],["أَن يمْسِي الثَّائِرُ مَنْبُوذاً","والحُرُّ الماجِدُ خَوَّانا",253,"ن",2,0],["إنّي مللت من الحكايات التي","نُسِجَت بأخيلةِ النفوسِ الواهمهْ",254,"م",2,0],["إني ملأتُ القلبَ حباً غامراً","لجلالِ وجهِكَ صادقاً يترعرعُ",255,"ع",1,0],["إن يمنعوا عنا اللقاء نكايةً","فتسلّق الجدران يا لبلابُ",256,"ب",1,0],["إن يمل بالردف في السر","ج فما ذاك عجيب",257,"ب",1,1],["إني مددت يدي لجودك طالبا","بالله جد لي بالذي أنا طالب",258,"ب",1,0],["إن يمسِ حبلكَ بعدَ طولِ تواصلٍ","خَلقَاً وأصْبَحَ بيتُكُمْ مَهْجورا",259,"ر",2,1],["إِنِّي « مُحَمَّدُ » بِالدَّيرِ مَعَارِفُهُ","لا تَرتَضِي إلاّ أن تَسكُنَ القِمَمَا",260,"م",2,0],["إني مثيلك معْ سواك لذا نرى","ثأرَ العدالة دائماً قوّامَا",261,"م",2,0],["إني مزحتُ أيا \"بريهمُ\" مزحةً","قَلَبَتْ عُلاك أمام صحبك أسفلا",262,"ل",2,0],["إني منحازٌ للحقِ","لو كان الحق على نفسي",263,"ي",1,0],["إني منحازٌ للصدقِ","لو أدّى الصدق إلى محقي",263,"ي",1,0],["إني مضيئُ الحبِّ حيث يَظُنُّهُ","بعضُ الأنامِ كمظلمٍ وَعَبوسِ",264,"س",1,0],["إني مؤيّدُ كلِّ منحىً آمنٍ","وعدوُّ كلِّ مُخَوِّفٍ للجيلِ",265,"ل",1,0],["إني من دونك كيتيمٍ","فأدِمْني في العزِّ المَلْكي",266,"ي",1,0],["إني مدينٌ للكريمِ ونخبة","أمثال عمرو والصديقِ أبو العلا*",267,"ل",2,0],["إني مَدينٌ للإله وبعدِهِ","للقنصلية حيث كنتُ مبَجَّلا",267,"ل",2,0],["إنْ يمنحِ الرحمن عزماً لي لكي","أُبْدي الذي بي، سوف غيري يفرحُ",268,"ح",1,0],["إني مزيجٌ من وفا وتنكر","متناقضَين كزارع وكَبَيْكِ",269,"ك",1,0],["إني مُذكرُكم فهل مِن مُدَّكرْ","أن لا تلينوا للوساوس يا بشرْ؟",270,"ر",1,0],["إِنِّيْ مَلَلْتُ الكَأْسَ فَارِغَةً إِذَا","مَا الشَّوقُ يَا حَسنَاءُ فِيَّ مُعَتَّقُ",271,"ق",1,0],["إن يمس هتانا له دمعنا","فجوده قد كان هتانا",272,"ن",2,0],["إنّي مَلَكْتُ منَ الدجى أقمارَهُ","حينَ ارتَضْيتِ بأنْ أكون فَتاكِ",273,"ك",1,0],["إني محدثكم حديثا رائعا","عن خير ألسنة الخلائق مكتبا",274,"ب",2,0],["إني مُتَيّمك الذي لازال يش","قى في هواك فلا جفاك ولا نبا",275,"ب",2,0],["إِني من اللي صاني غاب راشدي","وَأَضحيت سكراناً بغير مدام",276,"م",1,0],["إنِّي مُحبٌ وَمَحبُوبٌ وَلَو زَعَموا","أَنَّ المَحبَّةَ بالأَنسابِ نوالرَّحِمِ",277,"م",1,0],["إِن يَمدَحوكَ بِأَبياتٍ مُنَمقَّةٍ","فَأَنتَ تَفرُقُ قلبي عَن قُلُوبِهِمِ",277,"م",1,0],["أنْ يَمُدَّ يداً الى","القيثارِ ينتفضُ النحيبُ",278,"ب",1,0],["إنّيَ من جَرّاه محمومةٌ","فاجعلْ مداواتَكَ لي بالشفاه",279,"ا",2,0],["إنِّي منحتُكَ حباً أنت تعرفه","فكن لقلبي مثل الوالد الحاني",280,"ن",2,0],["إني معَ الرحمنِ إنْ حققتُ ما","جئنا بهِ عندَ التحققِ في نظرْ",281,"ر",1,0],["أني مازلتُ كمَنْ وقفتْ","في الريح كما شجرٌ وَقَفَا",282,"ف",2,0],["إِنِّي مَتَى أخبِرْ بحبّكَ إِخوتي","حسَدُوا عليكِ وضَيَّعوا أسرَارِي",283,"ر",2,0]]}