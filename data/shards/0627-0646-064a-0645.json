{"poems":[[53,"بيني وبين الصوارم الهمم","https://www.aldiwan.net/poem29775.html","المنسرح"],[53,"أكذا المنون تقنطر الأبطالا","https://www.aldiwan.net/poem29888.html","الكامل"],[9,"أصرمت حبلك من لمي","https://www.aldiwan.net/poem21911.html","مجزوء الكامل"],[86,"حيا بكور الحيا أرباع لبنان","https://www.aldiwan.net/poem68892.html","البسيط"],[35,"كأن فاها لمن توسنها","https://www.aldiwan.net/poem38827.html","المنسرح"],[54,"أيسومني المأمون خطة عاجز","https://www.aldiwan.net/poem27601.html","الطويل"],[83,"زار الخيال بأيمن الزوراء","https://www.aldiwan.net/poem54344.html","الطويل"],[27,"حي الديار بعاقل فالأنعم","https://www.aldiwan.net/poem5982.html","الكامل"],[47,"إني منعت من المسير إليكم","https://www.aldiwan.net/poem25327.html","الكامل"],[72,"أطلق دموعك إن القلب معذور","https://www.aldiwan.net/poem18717.html","البسيط"],[72,"يفدي كرام الحمى منكم كرائمه","https://www.aldiwan.net/poem19686.html","البسيط"],[72,"أأحبابنا داركم والعيش نعمان","https://www.aldiwan.net/poem20196.html","البسيط"],[51,"تأمل العيب عيب","https://www.aldiwan.net/poem8150.html","المجتث"],[51,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[91,"وتينة غضة الأفنان باسقة","https://www.aldiwan.net/poem8825.html","عموديه"],[91,"أبصرتها والشمس عند شروقها","https://www.aldiwan.net/poem8848.html","عموديه"],[91,"ماذا جنيت عليهم أيها القلم","https://www.aldiwan.net/poem62702.html","عموديه"],[91,"إني مررت على الرياض الحاليه","https://www.aldiwan.net/poem62822.html","عموديه"],[89,"أين القصيد التي أبياتها خزف","https://www.aldiwan.net/poem44782.html","البسيط"],[89,"جو السياسة مكفهر","https://www.aldiwan.net/poem44852.html","مجزوء الكامل"],[89,"ماذا برقراق السحائب","https://www.aldiwan.net/poem44965.html","مجزوء الكامل"],[45,"بات نديما لي حتى الصباح","https://www.aldiwan.net/poem62685.html","السريع"],[45,"أناشد الغيث كي تهمي غواديه","https://www.aldiwan.net/poem66852.html","البسيط"],[28,"أنا ابن خندف والحامي حقيقتها","https://www.aldiwan.net/poem5096.html","البسيط"],[28,"إني من القوم الرقاق نعالهم","https://www.aldiwan.net/poem5137.html","الطويل"],[61,"وهواك لو كان الملام صلاحا","https://www.aldiwan.net/poem51737.html","الكامل"],[49,"من لم يذق لصبابة طعما","https://www.aldiwan.net/poem64898.html","الكامل"],[69,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[69,"مربع من أنس سلمى أوحشا","https://www.aldiwan.net/poem28911.html","الرمل"],[105,"قصوا الحديث عن الفريق النائي","https://www.aldiwan.net/poem42116.html","الكامل"],[105,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[52,"عتبت عليك مليحة العتب","https://www.aldiwan.net/poem27304.html","الكامل"],[75,"كفي فأيسر من مرد عناني","https://www.aldiwan.net/poem69028.html","الكامل"],[48,"يا من يبادلني عشقا بسلوان","https://www.aldiwan.net/poem66139.html","البسيط"],[48,"إني من شهرينِ في منزل","https://www.aldiwan.net/poem66234.html","السريع"],[50,"إني مدحتك كاذبا فأثبتني","https://www.aldiwan.net/poem64779.html","الكامل"],[1,"إني من القوم الذين إذا","https://www.aldiwan.net/poem34001.html","الكامل"],[76,"لا غرو إن نال منك السقم والضرر","https://www.aldiwan.net/poem39315.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85835","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54563","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54917","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142012","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141992","الرمل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13469","الكامل"],[91,"رسم سياسي","https://www.poetsgate.com/ViewPoem.aspx?id=53140",""],[35,"كأنَّ فاها لمن توسَّنها","https://www.poetsgate.com/ViewPoem.aspx?id=22162",""],[28,"إني من القوم الرقاق نعالهم","https://www.poetsgate.com/ViewPoem.aspx?id=21073",""],[99,"إلى بيروت الأنثى مع الإعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=215333",""],[51,"أجنتْ لك الوجدَ أغصانٌ وكثبانُ","https://www.poetsgate.com/ViewPoem.aspx?id=25836",""],[100,"لافتة على طريق العيد العاشر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67689&r=&rc=176",""],[132,"يا من جعلتم رضا المولى تجارتكم","https://www.aldiwan.net/poem54756.html","البسيط"],[169,"صدت فجذت حبل وصلك زينب","https://www.aldiwan.net/poem1606.html",""],[169,"أميم لا تنكري حلي ومرتحلي","https://www.aldiwan.net/poem1651.html",""],[186,"إني موصيك فاحفظ عن أخي ثقة","https://www.aldiwan.net/poem44158.html","البسيط"],[225,"يا مصر سيري على آثارهم وقفي","https://www.aldiwan.net/poem55115.html","البسيط"],[225,"لا والهوى العذري والوجد","https://www.aldiwan.net/poem55247.html","السريع"],[229,"لا تعذل الصب المشوقا","https://www.aldiwan.net/poem50928.html","مجزوء الكامل"],[229,"يا من حوى الفضل وحاز الفخرا","https://www.aldiwan.net/poem51069.html","الرجز"],[235,"سقاك سار من الوسمي هتان","https://www.aldiwan.net/poem31744.html","البسيط"],[235,"آنسن في الفودين وخط بياض","https://www.aldiwan.net/poem31901.html","الكامل"],[235,"حتام أرضى في هواك وتغضب","https://www.aldiwan.net/poem32181.html","الكامل"],[246,"إن يمكن الدهر فسوف أنتقم","https://www.aldiwan.net/poem56321.html","الرجز"],[270,"أنت المقيل المرتجى يا هتلر","https://www.aldiwan.net/poem35585.html","الكامل"],[270,"قد أبهجتك بنورها وصباها","https://www.aldiwan.net/poem35687.html","الكامل"],[282,"هذي الرياض وأنفاس الرياحين","https://www.aldiwan.net/poem32365.html","البسيط"],[282,"أنى يسوغ لعاشق كتمانه","https://www.aldiwan.net/poem32399.html","الكامل"],[306,"صرمت ظليمة خلتي ومراسلي","https://www.aldiwan.net/poem25.html","الكامل"],[353,"نجلا بني البربير والفرقدان","https://www.aldiwan.net/poem39766.html","البسيط"],[364,"وجهك عند الشموس أضوؤها","https://www.aldiwan.net/poem61008.html","المنسرح"],[366,"صبرا على نكد الحبيب ومطله","https://www.aldiwan.net/poem17069.html","الكامل"],[402,"قالوا إلام تحب آل محمد","https://www.aldiwan.net/poem46964.html","الكامل"],[416,"هل تعلمون بني الآداب لا كتبت","https://www.aldiwan.net/poem53828.html","الوافر"],[429,"زارت فكان بأمر الله اسراها","https://www.aldiwan.net/poem41037.html","البسيط"],[429,"إني مدحت أكابرا وأسابرا","https://www.aldiwan.net/poem41423.html","الكامل"],[441,"ليت الكفان الذي إن مت لي صنعا","https://www.aldiwan.net/poem14333.html","البسيط"],[441,"أرزى المصائب والخسران في الدين","https://www.aldiwan.net/poem14487.html","البسيط"],[453,"من أنبأ الغيد الحمائم أنه","https://www.aldiwan.net/poem61724.html","الكامل"],[458,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[461,"أبا شجاع كمال الدين دعوة ذي","https://www.aldiwan.net/poem15161.html","البسيط"],[475,"هل تعرف المنزل بالأهيل","https://www.aldiwan.net/poem1825.html","السريع"],[477,"حي عني منحني الوادي وأثله","https://www.aldiwan.net/poem15200.html","الخفيف"],[510,"حيا الحيا وطناً بإربل دارساً","https://www.aldiwan.net/poem1592.html",""],[551,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[551,"لا تلم الدهر ولا تعذل","https://www.aldiwan.net/poem47269.html","السريع"],[551,"عل البخيلة أن تجود لعاشق","https://www.aldiwan.net/poem47359.html","الكامل"],[551,"من ذا الطبيب لأدوائي وأوجاعي","https://www.aldiwan.net/poem47698.html","البسيط"],[551,"إني مررت على جنادل","https://www.aldiwan.net/poem47747.html","مجزوء الكامل"],[551,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[551,"ما في السلو لنا نصيب يطلب","https://www.aldiwan.net/poem48091.html","الكامل"],[554,"بكر العواذل بالسواد يلمنني","https://www.aldiwan.net/poem1850.html","الكامل"],[562,"قف بالديار إذا الليل البهيم سجا","https://www.aldiwan.net/poem52900.html","البسيط"],[564,"أعيدوا لنا التاريخ احيوا لنا الذكرى","https://www.aldiwan.net/poem854.html",""],[567,"كم من أخ لي كنت أجعل عنده","https://www.aldiwan.net/poem69685.html","الكامل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"عوضني بالبعد من قربه","https://www.aldiwan.net/poem2938.html","السريع"]],"verses":[["إِنَّ يَمينَ الحُسَينِ تُنصِفُني","إِن جارَ أَعداؤُها وَإِن ظَلَموا",0,"م",3,0],["إِن يُمسِ مَوعِظَةَ الرِجالِ فَطالَما","أَمسى مُهاباً لِلوَرى وَمُهالا",1,"ل",2,0],["إِنّي مَتى ما آتِهِ","لا يَجفُ راحِلَتي ثَوابُه",2,"ب",2,0],["إِنّي مَلِلتُ وُقوفي كُلَّ آوِنَةٍ","أَبكي وَأَنظِمُ أَحزاناً بِأَحزانِ",3,"ن",1,0],["إِنّي مَتى لا يَكُن نَوالُها","عِندي بِما قَد فَعَلتُ أَحتَشِمِ",4,"م",1,0],["إِنّي مِنَ القَومِ الَّذينَ سُيوفُهُم","قَتَلَت أَخاكَ وَشَرَّفَتكَ بِمَقعَدِ",5,"د",1,0],["إني مددتُ يَدِي إليكَ تَضَرُّعاً","حاشا وكلاَّ أن يخيبَ رجائي",6,"ا",2,0],["إِنّي مِنَ المُتَنَصِّفينَ سِجالَكُم","يَنفَحنَ مِن ثَبَجِ الفُراتِ الأَعظَمِ",7,"م",1,0],["إِنّي مُنِعتُ مِنَ المَسيرِ إِلَيكُمُ","وَلَوِ اِستَطَعتُ لَكُنتُ أَوَّلَ وارِدِ",8,"د",1,1],["إن يمس شخصك مطوياً بملحدِه","فإن ذكرك بالإحسانِ منشور",9,"ر",1,0],["إن يمس ربعك قد راعت نواعيه","فطالما صدحت أنساً حمائمه",10,"م",2,0],["إن يمضِ كسرى فكم إيوان معدلة","لديك قد زانه يمن وإيمان",11,"ن",1,0],["إنْ يُمسكِ الناسُ عنّي","سَيْباً فللَّه سيبُ",12,"ب",1,0],["إني مُلكتُ فلي بالرقِّ مَسْكَنةٌ","ومُلِّكَتْ فلها بالمُلْك طُغيان",13,"ن",1,0],["إِنّي مُفَصِلَةٌ ظِلّي عَلى جَسَدي","فَلا يَكونُ بِهِ طول وَلا قِصَرُ",14,"ر",1,0],["أَنّى مَشَيتَ نَشَقتَ مِسكاً أَزفَراً","في أَرضِها وَسَمِعتَ صَوتَ هَزارِ",15,"ر",1,0],["إِن يَمنَعوا الصُحُفَ فينا بَثَّ لَوعَتِنا","فَكُلُّنا صُحُفٌ في مِصرَ تَرتَسِمُ",16,"م",1,0],["إِنّي مَرَرتُ عَلى الرِياضِ الحالِيَه","وَسَمِعتُ أَنغامَ الطُيورِ الشادِيَه",17,"ه",1,1],["اني ملم باخبار الحياة وما","عندي سوى الظن عما بعدها خبر",18,"ر",1,0],["اني من اكفهراره","مترقب خطرا سيعرو",19,"ر",2,0],["إني مخاطبكم فلا","تلووا الوجوه عن المخاطب",20,"ب",1,0],["إِنِّيَ مِن صَدِّكَ في لَوعَةٍ","تَغَوَّلَت لُبّي وَهاضَت جَناح",21,"ح",1,0],["إِن يَمنَعونا فَإِنَّ البَذلَ مِن يَدِهِ","أَو يَكذِبونا فَإِنَّ الصِدقَ مِن فيهِ",22,"ي",2,0],["إِنّي مَتى أَهجُ قَوماً لا أَدَع لَهُمُ","سَمعاً إِذا اِستَمَعوا صَوتي وَلا بَصَرا",23,"ر",2,0],["إِنّي مِنَ القَومِ الرِقاقِ نِعالُهُم","وَلَستُ بِحَمدِ اللَهِ والِدِيَ الفِرزُ",24,"ز",1,1],["إني مَنَحتُ ذوي الصَّلاحِ مِنَ الوَرَى","بُغضاً فلستُ إليهِمُ مُرتاحا",25,"ح",2,0],["إِنّي مَنَحتُ مَوَدَّتي سَكَناً","فَرَأَيتُهُ قَد عَدَّها جُرما",26,"م",2,0],["إني مدحتُكَ قصداً للشفاعةِ لا","بناتِ أعوجَ بالأحجالِ والغُرَرِ",27,"ر",1,0],["إنْ يملْ قلبي لعذلٍ لا لعاً","أو أطاعَ السمعَ لوماً طرشا",28,"ش",2,0],["إن يَمْضِ أعلامُ الجِهادِ فما مَضتْ","بيضُ الظُبى ومساقطُ الأشلاءِ",29,"ا",2,0],["إن يَملكِ الماءَ العدوُّ فقد هَمَى","سَيْلٌ جرى شُؤبوبُهُ يتبطَّحُ",30,"ح",1,0],["إِنّي مِنَ القَومِ الَّذينَ بِهِم","فَخَرَت قُرَيشُ عَلى بَني كَعبِ",31,"ب",1,0],["إنّي مدَحتُك إذ مدَحتُك مُخلِصاً","حتى إذا ما ضاقَ ذَرْعُ بَياني",32,"ن",2,0],["إِن يُمسِكِ القَطرُ لا تُمسِك مَواهِبُهُ","وَلِيُّ عَهدٍ يَداهُ تَستَهِلّانِ",33,"ن",1,0],["إنّي من شهرينِ في منزلٍ","أجاهرُ اللَه بأمرٍ عظيم",34,"م",1,1],["إِنّي مَدَحتُكَ كاذِباً فَأَثَبتَني","لَمّا مَدَحتُكَ ما يُثابُ الكاذِبُ",35,"ب",1,1],["إِنّي مِنَ القَومِ الَّذينَ إِذا","أَزِمَ الشِتاءُ وَدوخِلَت حُجَرُه",36,"ر",2,1],["إن يُمسِ جِسْمُكَ مَوْعوكاً بصالِيةٍ","فهكَذا يُوعكُ الضِّرغامَةُ الهَصِرُ",37,"ر",1,0],["إني من إنكارك الأصل","بقيت في عجب",38,"ب",1,0],["إِني مُنِيتُ بأُمَّةٍ مَخْمُورَةٍ","مِنْ ذُلِّهَا وَلَهَا الْقَنَاعَةُ مَشْرَبُ",39,"ب",1,0],["إِنْ يُمَجِّدْهُ قَوْمُهُ فَلَهُمْ مَجْدٌ","بِه جَازَ كُلَّ بَحْرٍ وَبَرِّ",40,"ر",1,0],["إني مفارقة ابنتي أو عفتي","فعلى كلا الحالين مرّ فراق",41,"ق",1,0],["إن يمُرّ الغيمَ أسراباً عليها","يتخذ شكلا ليغري ناظريها",42,"ه",2,0],["إِنّي مَتى اِستَنجَدتُ سِربَ مَدامِعٍ","خَذَلَتهُ أَسرابُ الفِراقِ العادي",43,"ي",1,0],["إني محضتكم نصح الصّديق عسى","خيرا يفيدكم فالنّصح كم نفعا",44,"ع",2,0],["إنّي متى لا يكنْ نوالُهُما","عندي بما قد فعلتُ أحتشمِ",45,"م",1,0],["إني مِنَ القَوْمِ الرِّقَاقِ نِعَالُهُمْ،","وَلَسْتُ بحَمدِ الله وَالديَ الفِزْرُ",46,"ر",1,1],["إِن يَمُتْ لُبنَانُ … مِتُّم مَعَهُ","كُلُّ مَن يَقتُلُهُ … كَانَ القَتِيلاَ",47,"ل",2,0],["إني مُلكتُ فلي بالرهق مَسْكَنة ٌ","ومُلِّكَتْ فلها بالمُلْك طُغيان",48,"ن",1,0],["أنّى مهما نرتدي أسماءنا","من أعادينا ومحسوب علينا",49,"ن",2,0],["إني مُحِبُّكُمُ قِدماً ومَادِحُكُم","وسَامِعٌ إِن أشَرتُم لِى إشَارَتَكُم",50,"م",1,0],["إِن يُمدَحوا غَضِبُوا عَلى مُدّاحِهِم","خَوفَ الجَزاءِ وَإِن هُجُوا لَم يَغضَبوا",51,"ب",3,0],["إِن يُمسِ مَقتُكُمُ حَظّي فَحُقَّ لَكُم","الوَردُ مِن قُربِهِ يُغمى عَلى الجُعَلِ",52,"ل",1,0],["إني موصيك فاحفظ عن أخي ثقة","راض الزمان وراضته تجاربه",53,"ب",2,1],["إن يَمنَعوا الناسَ من قَولٍ فما مَنعوا","أن يَنطِقَ الحقُّ بِالشَكوى وَيُبديها",54,"ي",3,0],["إِنّي مع الصَدِّ وَطولِ الجَفا","باقٍ على الميثاقِ وَالعهد",55,"د",1,0],["إني مزجت مدامِعي","بدمِ الحشا فجرت خَلوقا",56,"ق",2,0],["إن يملِك العالمَ أوْ ذا العصرا","كم طال بالمجد النجومَ الزُهْرا",57,"ر",2,0],["إِن يُمسِ رَيّانَ مِن ماءِ الشَبابِ فَلي","قَلبٌ إِلى ريقِهِ المَعسولِ ظَمآنُ",58,"ن",1,0],["إِن يُمسِ طَيعَ قِيادَةٍ فَلَرُبَّما","أَعيَت رِياضَتُهُ عَلى الرُوّاضِ",59,"ض",1,0],["إِن يُمسِ عَدلاً في قَضِيَّتِهِ فَقَد","أَمسى عَلى الأَموالِ أَجوَرَ قاضي",59,"ي",1,0],["إِن يُمسِ مِن نَظَرِ العُيونِ مُحَجَّباً","فَلَهُ جَزيلُ مَواهِبٍ لا تُحجَبُ",60,"ب",1,0],["إنْ يمكنِ الدهرُ فسوفَ أنتقمْ","أولاً فإنَّ العفوَ أدنى للكرمْ",61,"م",1,1],["إن يملكِ العربُ الحديدَ كغيرِهم","يرجع لهم عهدُ الفتوحِ الأزهر",62,"ر",1,0],["إني محبٌّ ناصحٌ إكرامُه","يزدادُ مع إعجابه ويكرّر",62,"ر",1,0],["إني مُحِبٌّ للطّبيعةِ عابدٌ","أبداً أدينُ بحُسنِها وهواها",63,"ا",3,0],["إِنّي مِنَ الراحِ مَيتٌ لا حَراكَ لَهُ","فَهاتِ بِالراحِ حَيِّيني لِتُحييني",64,"ي",1,0],["إِنّي مُعيدِيٌّ فَمَن يَسمَع بِهِ","خَيرٌ لَهُ مِن أَن يَراهُ عَيانُهُ",65,"ن",2,0],["إِنّي مِنَ القومِ الذين إذا انتَدو","بدأوا بِبِرّ اللَهِ ثمَّ النائلِ",66,"ل",1,0],["إنّي مهنٍّ لَكُما إِنَّما","أَحقُّ بِالتَهنئة الوالدان",67,"ن",1,0],["إنْ يَمضِ منْ قَبلَه فكم فُقدتْ","نَفْسُ كريم وساءَ مَرْزؤها",68,"ا",3,0],["إِن يمكُرِ الأَعداءُ مَكراً سَيِّئاً","فَالوَعدُ حَقٌّ أَن يَحيقَ بِأَهلِهِ",69,"ل",2,0],["إنّي ملكتُ ذَخائراً أَحْرَزْتُها","مِنْ كيمياء ودَادهمْ فَغَنِيتُ",70,"ت",1,0],["أنِّي مَدَحْتُ بخيلاً لست أذكره","لا خيفةً منه بل حرصاً على الشرف",71,"ف",1,0],["اني متميها اني المشوق لها","اني المعنى بها اني لمضناها",72,"ا",3,0],["إني مدحت أكابرا وأسابرا","شهبا تفوق على الاكاسرة الأول",73,"ل",1,1],["أنى مديحي له والمدح صار له","مفرقاً في كتاب اللَه مجتمعا",74,"ع",2,0],["إني من الذنب في خوف ولي طمع","في رحمة منك يا مولاي توليني",75,"ي",1,0],["أنَّى مشيت بها لمستَ جلالها","متواضعاً حتى لدى جُهّالهِ",76,"ل",2,0],["إن يُمسكوا فيضَ الدموع فربّما","فاضت عيونٌ في الصدور غِزارُ",77,"ر",1,0],["إني مدحتكَ والآمالُ يُنغِضُها","إلى مكارمك المشهورة الطَّربُ",78,"ب",1,0],["إِن يُمسِ نَشوانَ بِمَصروفَةٍ","مِنها بِرِىٍّ وَعَلى مِرجَلِ",79,"ل",1,0],["اِنْ يمتْ مِن فرطِ وجدٍ وهوىً","هذه سنَّةُ أهلِ الحبَّ قبلَه",80,"ل",2,0],["إن يُمسِ قد لعبت به أيدي البِلى","عافي المعاهد دارسَ الاعلام",81,"م",1,0],["إنْ يمضِ منكمْ شيخُكمْ فلَفَحلكم","باقٍ لكمْ ولنا على الأعوامِ",82,"م",1,0],["إنِّيَ منكمْ بودادي لكمْ","ووسط أبياتكمُ منزلي",83,"ل",2,0],["إنّي مَرَيْتُكُمُ فكنتُ كمن مَرى","جَدّاء لا تسخو بدَرّةِ حالِقِ",84,"ق",1,0],["إنّي مُقيمٌ على كُرهٍ بناحيةٍ","غرثَى المسالك من طِيبٍ وإمتاعِ",85,"ع",1,0],["إنّي مررتُ على جنا","دِلَ فوق أَرْماسٍ دُروسِ",86,"س",1,1],["إنِّيَ من معشرٍ إذا نُسِبوا","طابوا فروعاً وأَنجبوا حَسَبا",87,"ب",2,0],["إِن يَمضِ مقتبِل الشّباب فإنّه","نالَ الفَضائلَ لَم يَنلْها الأَشيبُ",88,"ب",1,0],["إِنّي مُقَسِّمُ ما مَلَكتُ فَجاعِلٌ","أَجراً لِآخِرَةٍ وَدُنيا تَنفَعُ",89,"ع",1,0],["إن يَمنَعِ القومُ إلمامي فما مَنَعوا","أنْ أنظُرَ الحيَّ أو استَنشِقَ الأرَجا",90,"ج",2,0],["إني من قومي الكرام وان نئا","بي الحظ عنهم لست أنسى لهم ذكرا",91,"ر",2,0],["إني متى أُخْبِرْ بِحُبِّكَ إِخْوَتي","حَسَدُوا عَلَيْكِ فَضَيّعُوا أسْرَاري",92,"ر",2,0],["أن يمنحوا من ذاك ما قد طلبوا","وذاك في الحق لهم قد يجب",93,"ب",1,0],["إِنِّي من ذِكراهُ في جَنَّةٍ","ومِنْ دُمُوعِي بعده في نَهَرْ",94,"ر",1,0]]}