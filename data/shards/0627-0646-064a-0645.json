d=194037",""],[5956,"أنا عائش لك بعد رب الناس","https://www.poetsgate.com/ViewPoem.aspx?id=194398",""],[5956,"الجنة العظمَى","https://www.poetsgate.com/ViewPoem.aspx?id=194703",""],[5956,"قصائدي عفوية","https://www.poetsgate.com/ViewPoem.aspx?id=201542",""],[5956,"عندي وعند كل شاب طباع الهر","https://www.poetsgate.com/ViewPoem.aspx?id=209041",""],[5956,"الوهم والوسواس.. أعداءُ البشرْ","https://www.poetsgate.com/ViewPoem.aspx?id=215380",""],[6019,"إبحار في عينيكِ","https://www.poetsgate.com/ViewPoem.aspx?id=53055",""],[6034,"الدهر لا يبرح خوانا","https://www.poetsgate.com/ViewPoem.aspx?id=169609",""],[6035,"لاتردّي قلبي ! .","https://www.poetsgate.com/ViewPoem.aspx?id=151971",""],[6068,"خير اللغات جلالة وفخامة -16-","https://www.poetsgate.com/ViewPoem.aspx?id=175972",""],[6127,"عذبٌ لَمَاك","https://www.poetsgate.com/ViewPoem.aspx?id=188486",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577061",""],[5309,"أنوار هادي الورى في كعبة الحرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573517",""],[5464,"نسيب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66708&r=&rc=9",""],[6229,"تفاحة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82506&r=&rc=41",""],[6242,"يا أيها الشعر قد جددت أحزاني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87555&r=&rc=2",""],[2220,"إنَّ الإلهَ لهُ تجلٍّ في الصور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11470&r=&rc=344",""],[5567,"يانفس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81771&r=&rc=39",""],[572,"كم من أخٍ لي كنتُ أجعل عندهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9271&r=&rc=128",""]],"verses":[["إِنَّ يَمينَ الحُسَينِ تُنصِفُني","إِن جارَ أَعداؤُها وَإِن ظَلَموا",0,"م",3,0],["إِن يُمسِ مَوعِظَةَ الرِجالِ فَطالَما","أَمسى مُهاباً لِلوَرى وَمُهالا",1,"ل",2,0],["إِنّي مَتى ما آتِهِ","لا يَجفُ راحِلَتي ثَوابُه",2,"ب",2,0],["إِنّي مَلِلتُ وُقوفي كُلَّ آوِنَةٍ","أَبكي وَأَنظِمُ أَحزاناً بِأَحزانِ",3,"ن",1,0],["إِنّي مَتى لا يَكُن نَوالُها","عِندي بِما قَد فَعَلتُ أَحتَشِمِ",4,"م",1,0],["إِنّي مِنَ القَومِ الَّذينَ سُيوفُهُم","قَتَلَت أَخاكَ وَشَرَّفَتكَ بِمَقعَدِ",5,"د",1,0],["إني مددتُ يَدِي إليكَ تَضَرُّعاً","حاشا وكلاَّ أن يخيبَ رجائي",6,"ا",2,0],["إِنّي مِنَ المُتَنَصِّفينَ سِجالَكُم","يَنفَحنَ مِن ثَبَجِ الفُراتِ الأَعظَمِ",7,"م",1,0],["إِنّي مُنِعتُ مِنَ المَسيرِ إِلَيكُمُ","وَلَوِ اِستَطَعتُ لَكُنتُ أَوَّلَ وارِدِ",8,"د",1,1],["إن يمس شخصك مطوياً بملحدِه","فإن ذكرك بالإحسانِ منشور",9,"ر",1,0],["إن يمس ربعك قد راعت نواعيه","فطالما صدحت أنساً حمائمه",10,"م",2,0],["إن يمضِ كسرى فكم إيوان معدلة","لديك قد زانه يمن وإيمان",11,"ن",1,0],["إنْ يُمسكِ الناسُ عنّي","سَيْباً فللَّه سيبُ",12,"ب",1,0],["إني مُلكتُ فلي بالرقِّ مَسْكَنةٌ","ومُلِّكَتْ فلها بالمُلْك طُغيان",13,"ن",1,0],["إِنّي مُفَصِلَةٌ ظِلّي عَلى جَسَدي","فَلا يَكونُ بِهِ طول وَلا قِصَرُ",14,"ر",1,0],["أَنّى مَشَيتَ نَشَقتَ مِسكاً أَزفَراً","في أَرضِها وَسَمِعتَ صَوتَ هَزارِ",15,"ر",1,0],["إِن يَمنَعوا الصُحُفَ فينا بَثَّ لَوعَتِنا","فَكُلُّنا صُحُفٌ في مِصرَ تَرتَسِمُ",16,"م",1,0],["إِنّي مَرَرتُ عَلى الرِياضِ الحالِيَه","وَسَمِعتُ أَنغامَ الطُيورِ الشادِيَه",17,"ه",1,1],["اني ملم باخبار الحياة وما","عندي سوى الظن عما بعدها خبر",18,"ر",1,0],["اني من اكفهراره","مترقب خطرا سيعرو",19,"ر",2,0],["إني مخاطبكم فلا","تلووا الوجوه عن المخاطب",20,"ب",1,0],["إِنِّيَ مِن صَدِّكَ في لَوعَةٍ","تَغَوَّلَت لُبّي وَهاضَت جَناح",21,"ح",1,0],["إِن يَمنَعونا فَإِنَّ البَذلَ مِن يَدِهِ","أَو يَكذِبونا فَإِنَّ الصِدقَ مِن فيهِ",22,"ي",2,0],["إِنّي مَتى أَهجُ قَوماً لا أَدَع لَهُمُ","سَمعاً إِذا اِستَمَعوا صَوتي وَلا بَصَرا",23,"ر",2,0],["إِنّي مِنَ القَومِ الرِقاقِ نِعالُهُم","وَلَستُ بِحَمدِ اللَهِ والِدِيَ الفِرزُ",24,"ز",1,1],["إني مَنَحتُ ذوي الصَّلاحِ مِنَ الوَرَى","بُغضاً فلستُ إليهِمُ مُرتاحا",25,"ح",2,0],["إِنّي مَنَحتُ مَوَدَّتي سَكَناً","فَرَأَيتُهُ قَد عَدَّها جُرما",26,"م",2,0],["إني مدحتُكَ قصداً للشفاعةِ لا","بناتِ أعوجَ بالأحجالِ والغُرَرِ",27,"ر",1,0],["إنْ يملْ قلبي لعذلٍ لا لعاً","أو أطاعَ السمعَ لوماً طرشا",28,"ش",2,0],["إن يَمْضِ أعلامُ الجِهادِ فما مَضتْ","بيضُ الظُبى ومساقطُ الأشلاءِ",29,"ا",2,0],["إن يَملكِ الماءَ العدوُّ فقد هَمَى","سَيْلٌ جرى شُؤبوبُهُ يتبطَّحُ",30,"ح",1,0],["إِنّي مِنَ القَومِ الَّذينَ بِهِم","فَخَرَت قُرَيشُ عَلى بَني كَعبِ",31,"ب",1,0],["إنّي مدَحتُك إذ مدَحتُك مُخلِصاً","حتى إذا ما ضاقَ ذَرْعُ بَياني",32,"ن",2,0],["إِن يُمسِكِ القَطرُ لا تُمسِك مَواهِبُهُ","وَلِيُّ عَهدٍ يَداهُ تَستَهِلّانِ",33,"ن",1,0],["إنّي من شهرينِ في منزلٍ","أجاهرُ اللَه بأمرٍ عظيم",34,"م",1,1],["إِنّي مَدَحتُكَ كاذِباً فَأَثَبتَني","لَمّا مَدَحتُكَ ما يُثابُ الكاذِبُ",35,"ب",1,1],["إِنّي مِنَ القَومِ الَّذينَ إِذا","أَزِمَ الشِتاءُ وَدوخِلَت حُجَرُه",36,"ر",2,1],["إن يُمسِ جِسْمُكَ مَوْعوكاً بصالِيةٍ","فهكَذا يُوعكُ الضِّرغامَةُ الهَصِرُ",37,"ر",1,0],["إني من إنكارك الأصل","بقيت في عجب",38,"ب",1,0],["إِني مُنِيتُ بأُمَّةٍ مَخْمُورَةٍ","مِنْ ذُلِّهَا وَلَهَا الْقَنَاعَةُ مَشْرَبُ",39,"ب",1,0],["إِنْ يُمَجِّدْهُ قَوْمُهُ فَلَهُمْ مَجْدٌ","بِه جَازَ كُلَّ بَحْرٍ وَبَرِّ",40,"ر",1,0],["إني مفارقة ابنتي أو عفتي","فعلى كلا الحالين مرّ فراق",41,"ق",1,0],["إن يمُرّ الغيمَ أسراباً عليها","يتخذ شكلا ليغري ناظريها",42,"ه",2,0],["إِنّي مَتى اِستَنجَدتُ سِربَ مَدامِعٍ","خَذَلَتهُ أَسرابُ الفِراقِ العادي",43,"د",2,0],["إني محضتكم نصح الصّديق عسى","خيرا يفيدكم فالنّصح كم نفعا",44,"ع",2,0],["إنّي متى لا يكنْ نوالُهُما","عندي بما قد فعلتُ أحتشمِ",45,"م",1,0],["إني مِنَ القَوْمِ الرِّقَاقِ نِعَالُهُمْ،","وَلَسْتُ بحَمدِ الله وَالديَ الفِزْرُ",46,"ر",1,1],["إِن يَمُتْ لُبنَانُ … مِتُّم مَعَهُ","كُلُّ مَن يَقتُلُهُ … كَانَ القَتِيلاَ",47,"ل",2,0],["إني مُلكتُ فلي بالرهق مَسْكَنة ٌ","ومُلِّكَتْ فلها بالمُلْك طُغيان",48,"ن",1,0],["أنّى مهما نرتدي أسماءنا","من أعادينا ومحسوب علينا",49,"ن",2,0],["إني مُحِبُّكُمُ قِدماً ومَادِحُكُم","وسَامِعٌ إِن أشَرتُم لِى إشَارَتَكُم",50,"م",1,0],["إِن يُمدَحوا غَضِبُوا عَلى مُدّاحِهِم","خَوفَ الجَزاءِ وَإِن هُجُوا لَم يَغضَبوا",51,"ب",3,0],["إِن يُمسِ مَقتُكُمُ حَظّي فَحُقَّ لَكُم","الوَردُ مِن قُربِهِ يُغمى عَلى الجُعَلِ",52,"ل",1,0],["إني موصيك فاحفظ عن أخي ثقة","راض الزمان وراضته تجاربه",53,"ب",2,1],["إن يَمنَعوا الناسَ من قَولٍ فما مَنعوا","أن يَنطِقَ الحقُّ بِالشَكوى وَيُبديها",54,"ي",3,0],["إِنّي مع الصَدِّ وَطولِ الجَفا","باقٍ على الميثاقِ وَالعهد",55,"د",1,0],["إني مزجت مدامِعي","بدمِ الحشا فجرت خَلوقا",56,"ق",2,0],["إن يملِك العالمَ أوْ ذا العصرا","كم طال بالمجد النجومَ الزُهْرا",57,"ر",2,0],["إِن يُمسِ رَيّانَ مِن ماءِ الشَبابِ فَلي","قَلبٌ إِلى ريقِهِ المَعسولِ ظَمآنُ",58,"ن",1,0],["إِن يُمسِ طَيعَ قِيادَةٍ فَلَرُبَّما","أَعيَت رِياضَتُهُ عَلى الرُوّاضِ",59,"ض",1,0],["إِن يُمسِ عَدلاً في قَضِيَّتِهِ فَقَد","أَمسى عَلى الأَموالِ أَجوَرَ قاضي",59,"ض",2,0],["إِن يُمسِ مِن نَظَرِ العُيونِ مُحَجَّباً","فَلَهُ جَزيلُ مَواهِبٍ لا تُحجَبُ",60,"ب",1,0],["إنْ يمكنِ الدهرُ فسوفَ أنتقمْ","أولاً فإنَّ العفوَ أدنى للكرمْ",61,"م",1,1],["إن يملكِ العربُ الحديدَ كغيرِهم","يرجع لهم عهدُ الفتوحِ الأزهر",62,"ر",1,0],["إني محبٌّ ناصحٌ إكرامُه","يزدادُ مع إعجابه ويكرّر",62,"ر",1,0],["إني مُحِبٌّ للطّبيعةِ عابدٌ","أبداً أدينُ بحُسنِها وهواها",63,"ا",3,0],["إِنّي مِنَ الراحِ مَيتٌ لا حَراكَ لَهُ","فَهاتِ بِالراحِ حَيِّيني لِتُحييني",64,"ن",2,0],["إِنّي مُعيدِيٌّ فَمَن يَسمَع بِهِ","خَيرٌ لَهُ مِن أَن يَراهُ عَيانُهُ",65,"ن",2,0],["إِنّي مِنَ القومِ الذين إذا انتَدو","بدأوا بِبِرّ اللَهِ ثمَّ النائلِ",66,"ل",1,0],["إنّي مهنٍّ لَكُما إِنَّما","أَحقُّ بِالتَهنئة الوالدان",67,"ن",1,0],["إنْ يَمضِ منْ قَبلَه فكم فُقدتْ","نَفْسُ كريم وساءَ مَرْزؤها",68,"ا",3,0],["إِن يمكُرِ الأَعداءُ مَكراً سَيِّئاً","فَالوَعدُ حَقٌّ أَن يَحيقَ بِأَهلِهِ",69,"ل",2,0],["إنّي ملكتُ ذَخائراً أَحْرَزْتُها","مِنْ كيمياء ودَادهمْ فَغَنِيتُ",70,"ت",1,0],["أنِّي مَدَحْتُ بخيلاً لست أذكره","لا خيفةً منه بل حرصاً على الشرف",71,"ف",1,0],["اني متميها اني المشوق لها","اني المعنى بها اني لمضناها",72,"ا",3,0],["إني مدحت أكابرا وأسابرا","شهبا تفوق على الاكاسرة الأول",73,"ل",1,1],["أنى مديحي له والمدح صار له","مفرقاً في كتاب اللَه مجتمعا",74,"ع",2,0],["إني من الذنب في خوف ولي طمع","في رحمة منك يا مولاي توليني",75,"ن",2,0],["أنَّى مشيت بها لمستَ جلالها","متواضعاً حتى لدى جُهّالهِ",76,"ل",2,0],["إن يُمسكوا فيضَ الدموع فربّما","فاضت عيونٌ في الصدور غِزارُ",77,"ر",1,0],["إني مدحتكَ والآمالُ يُنغِضُها","إلى مكارمك المشهورة الطَّربُ",78,"ب",1,0],["إِن يُمسِ نَشوانَ بِمَصروفَةٍ","مِنها بِرِىٍّ وَعَلى مِرجَلِ",79,"ل",1,0],["اِنْ يمتْ مِن فرطِ وجدٍ وهوىً","هذه سنَّةُ أهلِ الحبَّ قبلَه",80,"ل",2,0],["إن يُمسِ قد لعبت به أيدي البِلى","عافي المعاهد دارسَ الاعلام",81,"م",1,0],["إنْ يمضِ منكمْ شيخُكمْ فلَفَحلكم","باقٍ لكمْ ولنا على الأعوامِ",82,"م",1,0],["إنِّيَ منكمْ بودادي لكمْ","ووسط أبياتكمُ منزلي",83,"ل",2,0],["إنّي مَرَيْتُكُمُ فكنتُ كمن مَرى","جَدّاء لا تسخو بدَرّةِ حالِقِ",84,"ق",1,0],["إنّي مُقيمٌ على كُرهٍ بناحيةٍ","غرثَى المسالك من طِيبٍ وإمتاعِ",85,"ع",1,0],["إنّي مررتُ على جنا","دِلَ فوق أَرْماسٍ دُروسِ",86,"س",1,1],["إنِّيَ من معشرٍ إذا نُسِبوا","طابوا فروعاً وأَنجبوا حَسَبا",87,"ب",2,0],["إِن يَمضِ مقتبِل الشّباب فإنّه","نالَ الفَضائلَ لَم يَنلْها الأَشيبُ",88,"ب",1,0],["إِنّي مُقَسِّمُ ما مَلَكتُ فَجاعِلٌ","أَجراً لِآخِرَةٍ وَدُنيا تَنفَعُ",89,"ع",1,0],["إن يَمنَعِ القومُ إلمامي فما مَنَعوا","أنْ أنظُرَ الحيَّ أو استَنشِقَ الأرَجا",90,"ج",2,0],["إني من قومي الكرام وان نئا","بي الحظ عنهم لست أنسى لهم ذكرا",91,"ر",2,0],["إني متى أُخْبِرْ بِحُبِّكَ إِخْوَتي","حَسَدُوا عَلَيْكِ فَضَيّعُوا أسْرَاري",92,"ر",2,0],["أن يمنحوا من ذاك ما قد طلبوا","وذاك في الحق لهم قد يجب",93,"ب",1,0],["إِنِّي من ذِكراهُ في جَنَّةٍ","ومِنْ دُمُوعِي بعده في نَهَرْ",94,"ر",1,0],["إن يمضِ عنهم شخصهُ بَقِيَت","ما بينهم أمثاله الغرُّ",95,"ر",1,0],["إنَّ يمناهُ ان تطر يبقَ فيه","قلبُ ليثٍ على الليوث يُغير",96,"ر",1,0],["إن يمس ملك بني ساسان أفرطهم","فإنما الدهر أفراط دهارير",97,"ر",1,0],["إني مودِّعك المشوق إلى غد","ولتحمدن عواقب التيار",98,"ر",1,0],["إن يملكوا أعناقنا لا يملكوا","مهجاً وإن سالت على الأسلات",99,"ت",1,0],["أنيَ مَيْتُ الضرِّ مقبورُهُ","إن كان ميتٌ غيرَ مقبور",100,"ر",1,0],["أَنّى مَديحي فَوا عَجزي وَوا خَرسي","وَإِنْ تَكُنْ دونَنا في المَدحِ خَنْساءُ",101,"ا",2,0],["إِنّي مَشوقٌ إِلى رُؤيا الحَبيبِ وَقَد","طالَ البِعادُ فَزَادَت فيهِ أَشجاني",102,"ن",2,1],["إِنّي مهدٍ لَكَ مِنَ المَديحِ قَصيدا","بِالأَعذَبِ نَظماً مِنَ القَريضِ وَبِالحال",103,"ل",1,0],["إِني مِن المَوت عَلى يَقين","فَأَجهَدُ الآنَ لما يَقيني",104,"ي",1,0],["إني موال من تولاكم","ومن يعاديكم فمنه بري",105,"ر",2,0],["إن يمس شخصك في اللحود مغيباً","فالعلم فينا منك غير دفين",106,"ن",1,0],["أَن يمنَحَ العَبد الفَقير باعا","في جُملَة العُلومِ وَاِتِّساعا",107,"ع",2,0],["إني من الأَزْد والأُّمُّ الكريمة من","بكرِ بِن وائل خيرِ السادة الصِّيد",108,"د",1,0],["إن يمتدح غيري سواك ويرتكب","نهج الغلو فقد أصبت وضيعا",109,"ع",2,0],["إِنّي مِنَ الناسِ وَلكِنَّني","في رِقَّتي عَنهُمُ بَعيدٌ جَنيبْ",110,"ب",1,0],["إن يمين الرَّبيب ما برحت","بمن عفاةٍ ويسر طلابِ",111,"ب",1,0],["إني مدحتك كي أرجو التخلص من","إشراك ديني وآثامي وزلّاتي",112,"ت",2,0],["إنّي مدحتُكَ عن ودادٍ لم يكن","مَدحي لما ضاعفت من تثمينهِ",113,"ن",2,0],["إني من البلد الأمي","ن وركني الركن اليماني",114,"ن",2,0],["إني مُذْ زِلْت عن فَنائكم","عُرْضَةُ سَهْمِ الفَنَاءِ لا جَرَمَا",115,"م",2,0],["إنِّى مِنَ الأَزدِ الَّذينَ أنُوفُهُم","عِندَ السَّمَاءِ وَجَارُهُم فِى مَعقِلِ",116,"ل",1,0],["إني معزيك يا دير العطية من","قلب شجي غدا بالحزن ملآنا",117,"ن",2,0],["إن يمس بيتك يا حبيبة بذلة","لبما تحجب مرة وتصان",118,"ن",1,1],["إن يُمسِ رَأسي أَشمَطَ العُناصِ","كَأَنَّما فَرَّقَهُ مُناصِ",119,"ص",1,1],["إني مررت بشاهينٍ وقد نفحت","ريح العشي وبرد الثلج يؤذيني",120,"ن",2,1],["إنّي مرضت مرضةً","أسقط منها في يدي",121,"د",2,1],["إن يمنعوا ما حوت منا أكفّهمُ","فلن يضرّ أبا الحجناء ما منعوا",122,"ع",3,0],["إِنَّ يُمنَ الإِمامِ لَمّا أَتانا","حَلَبَ الغَيثَ مِن مُتونِ الغِمامِ",123,"م",1,1],["إِنّي مَتى أَحقِد لِحِق","دِكَ أَضُرّ بِهِ سِواكا",124,"ك",2,0],["إن يمُت فالفِرند ذاك الفرند","المُجتلي والشباةُ تلك الشباةُ",125,"ه",1,0],["إني متى احسرْ لثام عواطفي","تتبيني مل تحتَه من رقَّةِ",126,"ه",1,0],["إني مع التسليم جئت لحاجة","فما أنت فيها يا فتى الناس صانع",127,"ع",1,1],["إني مذ كنت منفرداً","كذاك ليث العرين منفرد",128,"د",1,0],["أَنّى مَشوقٌ مُوَلَّعٌ","بِالشَهمِ فَتّاحُ المَغالِقِ",129,"ق",1,0],["اني من السلف المقصر دونه","شرف الا