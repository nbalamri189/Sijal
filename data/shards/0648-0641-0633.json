{"poems":[[51,"نحمد الله حين من وأبقى","https://www.aldiwan.net/poem65511.html","الخفيف"],[70,"أضنى الفؤاد فمن يريحه","https://www.aldiwan.net/poem42980.html","مجزوء الكامل"],[89,"ما حياة قديمها غير باد","https://www.aldiwan.net/poem44747.html","الخفيف"],[89,"ألا إنما هذا الذي لك أنقل","https://www.aldiwan.net/poem44963.html","الطويل"],[43,"هينا فقدت من الرجال بليدا","https://www.aldiwan.net/poem10621.html","الكامل"],[45,"شوق إليك تفيض منه الأدمع","https://www.aldiwan.net/poem64712.html","الكامل"],[69,"وفستق زاد حسنا","https://www.aldiwan.net/poem28743.html","المجتث"],[52,"إن الفراق دعا الخليط فزالا","https://www.aldiwan.net/poem26731.html","الكامل"],[45,"شوق اليك تفيض منه الادمع","https://www.poetsgate.com/ViewPoem.aspx?id=12941",""],[211,"يا متهمي بالسلو مهلا","https://www.aldiwan.net/poem13319.html","مخلع البسيط"],[253,"وفستقة شبهتها إذ رأيتها","https://www.aldiwan.net/poem1481.html",""],[257,"ضرطت ونحن بعكبرا","https://www.aldiwan.net/poem48440.html","مجزوء الكامل"],[263,"أبعد الخيل أركبها ورادا","https://www.aldiwan.net/poem68196.html","الوافر"],[271,"لا يقل أحمق النساء بلاء","https://www.aldiwan.net/poem35182.html","الخفيف"],[298,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[299,"ما له في عظم الشأن قري","https://www.aldiwan.net/poem36860.html","عموديه"],[378,"بمولد مريم العذراء تمت","https://www.aldiwan.net/poem66963.html","الوافر"],[433,"عارض الصفح في يديك الصفاحا","https://www.aldiwan.net/poem12583.html","الخفيف"],[433,"حمل الريح بالأصيل سلامه","https://www.aldiwan.net/poem12719.html","الخفيف"],[459,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[459,"شوارد حظ لا يقر نفورها","https://www.aldiwan.net/poem56200.html","الطويل"],[469,"يا سيدا أركان عليائه","https://www.aldiwan.net/poem59522.html","السريع"],[478,"وكناس كل غزالة انسية","https://www.aldiwan.net/poem15222.html","الكامل"],[480,"الموت درس وعزرائيل ملقيه","https://www.aldiwan.net/poem36869.html","البسيط"],[559,"يا أهل أسفل سافلين","https://www.aldiwan.net/poem33729.html","مجزوء الكامل"]],"verses":[["وفساد أصلحته بتأني","ك ولو لم تكن لأصبح فتقا",0,"ق",2,0],["وَفَسيحُ باعِ الجودِ مُن","طَلِقُ اللِسانِ بِهِ فَصيحُه",1,"ح",2,0],["وفساد يجيء من بعد كون","ثم كون يجيئ بعد فساد",2,"د",1,0],["وفسّح لها في العمر وارحم شبابها","فإنك إن أرجأتها أنت مفضل",3,"ل",1,0],["وفسادُ عقلكَ نالَ جسمَك معدِياً","وليُفسِدَنَّ ضريحَه والدودا",4,"د",2,0],["وَفَسيحَةُ الأَكنافِ ضاعَفَ حُسنَها","بَرٌّ لَها مُفضاً وَبَحرٌ مُترَعُ",5,"ع",1,0],["وفستقٍ زادَ حسنا","أتاكَ مِنْ كفِّ ريمِ",6,"م",1,1],["وَفَسادَ قَومٍ قَد تَمَزَّقَ وُدُّهُم","فِعلاً وَضاعوا مِن يَدَيَّ ضِلالا",7,"ل",2,0],["وَفَسيحَةُ الأكْنَافِ ضَاعَفَ","حُسنَها بَرٌّ لَهَا مُفْضًى، وَبَحْرٌ مُتْرَعُ",8,"ع",1,0],["وفسر المهملات كشفا","واوضح المشكلات حلا",9,"ل",2,0],["وَفستقة شبهتُها إِذ رأَيتُها","وَقَد عايَنتَها مُقلَتي بِنَعيمِ",10,"م",1,1],["وفست على ريح الشما","ل فألحقتها بالجنوبِ",11,"ب",1,0],["وَفَسلٌ إن أرَدتَ بها بُكُوراً","خَذُولٌ عِندَ حاجاتِ الرِّحالِ",12,"ل",1,0],["وفسادُ النساءِ منكم فلولا","غدرُكم دامَ للجمالِ الحياء",13,"ا",2,0],["وَفسَّروا الصَداقَة","بالحب حَسبَ الطاقَه",14,"ه",1,0],["وفسيحاتُ المنى مخضرّةٌ","وشديدُ البأْسِ والعزمِ المتينْ",15,"ن",1,0],["وفُسِّرت الرموز لواضعيها","وبان الحق من بعد الخفاء",16,"ا",2,0],["وفسادُ البَنين عُرّةُ جهلٍ","لا يَزيدُ الآباءَ إلا صَلاحا",17,"ح",2,0],["وفسيحِ الخُطا جرى وجرى البر","قُ الى غايةٍ فكان إمامَهْ",18,"م",2,0],["وفسحتَ فانفسحت مضيَّقةٌ","مجموعةُ الطرَفين في عَقْلِ",19,"ل",1,0],["وفَسِّحْ لها في زينة الفِصحِ موضعاً","تقوم به تُتْلَى عليك عُشورُها",20,"ر",3,0],["وَفُستُقٌ نَنثُرُهُ بَينَنا","إِن لَم نَجِد في الوَقتِ نُقلِيَّه",21,"ي",2,0],["وفسيحُ أنديةٍ يروقُ رُواؤها","وصهيلُ مُقْرَبَةٍ وفَيْحُ رِحابِ",22,"ب",1,0],["وفسحة العمر أنفاس مقدرة","كأنما هي دين نحن نقضيه",23,"ي",2,0],["وفسادكم هو موقع","لقلوبكم في الصالحين",24,"ن",1,0]]}