{"poems":[[53,"نحمد الله حين من وأبقى","https://www.aldiwan.net/poem65511.html","الخفيف"],[72,"أضنى الفؤاد فمن يريحه","https://www.aldiwan.net/poem42980.html","مجزوء الكامل"],[91,"ما حياة قديمها غير باد","https://www.aldiwan.net/poem44747.html","الخفيف"],[91,"ألا إنما هذا الذي لك أنقل","https://www.aldiwan.net/poem44963.html","الطويل"],[45,"هينا فقدت من الرجال بليدا","https://www.aldiwan.net/poem10621.html","الكامل"],[47,"شوق إليك تفيض منه الأدمع","https://www.aldiwan.net/poem64712.html","الكامل"],[71,"وفستق زاد حسنا","https://www.aldiwan.net/poem28743.html","المجتث"],[54,"إن الفراق دعا الخليط فزالا","https://www.aldiwan.net/poem26731.html","الكامل"],[47,"شوق اليك تفيض منه الادمع","https://www.poetsgate.com/ViewPoem.aspx?id=12941",""],[214,"يا متهمي بالسلو مهلا","https://www.aldiwan.net/poem13319.html","مخلع البسيط"],[257,"وفستقة شبهتها إذ رأيتها","https://www.aldiwan.net/poem1481.html",""],[261,"ضرطت ونحن بعكبرا","https://www.aldiwan.net/poem48440.html","مجزوء الكامل"],[267,"أبعد الخيل أركبها ورادا","https://www.aldiwan.net/poem68196.html","الوافر"],[275,"لا يقل أحمق النساء بلاء","https://www.aldiwan.net/poem35182.html","الخفيف"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[303,"ما له في عظم الشأن قري","https://www.aldiwan.net/poem36860.html","عموديه"],[382,"بمولد مريم العذراء تمت","https://www.aldiwan.net/poem66963.html","الوافر"],[438,"عارض الصفح في يديك الصفاحا","https://www.aldiwan.net/poem12583.html","الخفيف"],[438,"حمل الريح بالأصيل سلامه","https://www.aldiwan.net/poem12719.html","الخفيف"],[463,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[463,"شوارد حظ لا يقر نفورها","https://www.aldiwan.net/poem56200.html","الطويل"],[473,"يا سيدا أركان عليائه","https://www.aldiwan.net/poem59522.html","السريع"],[482,"وكناس كل غزالة انسية","https://www.aldiwan.net/poem15222.html","الكامل"],[484,"الموت درس وعزرائيل ملقيه","https://www.aldiwan.net/poem36869.html","البسيط"],[563,"يا أهل أسفل سافلين","https://www.aldiwan.net/poem33729.html","مجزوء الكامل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34404","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63844","الكامل"],[1965,"","https://poetry.dctabudhabi.ae/diwan/poem/102726","المتدارك"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26168","المنسرح"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75881","الطويل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115436","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65110","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133226","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83664","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141676","الطويل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52135","الخفيف"],[4908,"وجع (هنا عدن )","https://www.poetsgate.com/ViewPoem.aspx?id=212779",""],[5409,"أيار شهرك بالكوارث مفعم","https://www.poetsgate.com/ViewPoem.aspx?id=155316",""],[5818,"دموع وحنين","https://www.poetsgate.com/ViewPoem.aspx?id=193070",""],[6093,"دَعِ التماسَ الهوى مِنْ ظبية الآس (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176196",""]],"verses":[["وفساد أصلحته بتأني","ك ولو لم تكن لأصبح فتقا",0,"ق",2,0],["وَفَسيحُ باعِ الجودِ مُن","طَلِقُ اللِسانِ بِهِ فَصيحُه",1,"ح",2,0],["وفساد يجيء من بعد كون","ثم كون يجيئ بعد فساد",2,"د",1,0],["وفسّح لها في العمر وارحم شبابها","فإنك إن أرجأتها أنت مفضل",3,"ل",1,0],["وفسادُ عقلكَ نالَ جسمَك معدِياً","وليُفسِدَنَّ ضريحَه والدودا",4,"د",2,0],["وَفَسيحَةُ الأَكنافِ ضاعَفَ حُسنَها","بَرٌّ لَها مُفضاً وَبَحرٌ مُترَعُ",5,"ع",1,0],["وفستقٍ زادَ حسنا","أتاكَ مِنْ كفِّ ريمِ",6,"م",1,1],["وَفَسادَ قَومٍ قَد تَمَزَّقَ وُدُّهُم","فِعلاً وَضاعوا مِن يَدَيَّ ضِلالا",7,"ل",2,0],["وَفَسيحَةُ الأكْنَافِ ضَاعَفَ","حُسنَها بَرٌّ لَهَا مُفْضًى، وَبَحْرٌ مُتْرَعُ",8,"ع",1,0],["وفسر المهملات كشفا","واوضح المشكلات حلا",9,"ل",2,0],["وَفستقة شبهتُها إِذ رأَيتُها","وَقَد عايَنتَها مُقلَتي بِنَعيمِ",10,"م",1,1],["وفست على ريح الشما","ل فألحقتها بالجنوبِ",11,"ب",1,0],["وَفَسلٌ إن أرَدتَ بها بُكُوراً","خَذُولٌ عِندَ حاجاتِ الرِّحالِ",12,"ل",1,0],["وفسادُ النساءِ منكم فلولا","غدرُكم دامَ للجمالِ الحياء",13,"ا",2,0],["وَفسَّروا الصَداقَة","بالحب حَسبَ الطاقَه",14,"ه",1,0],["وفسيحاتُ المنى مخضرّةٌ","وشديدُ البأْسِ والعزمِ المتينْ",15,"ن",1,0],["وفُسِّرت الرموز لواضعيها","وبان الحق من بعد الخفاء",16,"ا",2,0],["وفسادُ البَنين عُرّةُ جهلٍ","لا يَزيدُ الآباءَ إلا صَلاحا",17,"ح",2,0],["وفسيحِ الخُطا جرى وجرى البر","قُ الى غايةٍ فكان إمامَهْ",18,"م",2,0],["وفسحتَ فانفسحت مضيَّقةٌ","مجموعةُ الطرَفين في عَقْلِ",19,"ل",1,0],["وفَسِّحْ لها في زينة الفِصحِ موضعاً","تقوم به تُتْلَى عليك عُشورُها",20,"ر",3,0],["وَفُستُقٌ نَنثُرُهُ بَينَنا","إِن لَم نَجِد في الوَقتِ نُقلِيَّه",21,"ي",2,0],["وفسيحُ أنديةٍ يروقُ رُواؤها","وصهيلُ مُقْرَبَةٍ وفَيْحُ رِحابِ",22,"ب",1,0],["وفسحة العمر أنفاس مقدرة","كأنما هي دين نحن نقضيه",23,"ي",2,0],["وفسادكم هو موقع","لقلوبكم في الصالحين",24,"ن",1,0],["وَفسَّرَت لأمانينا مَكارِمه","وَلاِبن عَبّاسَ في التَفسير تَجويدُ",25,"د",1,0],["وفستْ عليه الليلَ أج","معَ عِرْسُه حتى تَمَرْمَر",26,"ر",1,0],["وفسادُكَ قلبي أحرَمني","طعمَ الإيمان فأنتَ عمى",27,"م",2,0],["وَفَسَادُ لاَزِمِ قَولِهِ هُوَ مُقتضٍ","لِفَسَادِ ذَاك القَولِ بِالبُرهَانِ",28,"ن",1,0],["وَفَسوَةُ الكَلبِ صارَ قاضينا","فَكَيفَ لَو كانَ ضَرطَةَ الأَسَدِ",29,"د",1,0],["وفسر عليٍّ وَابنِ عَبّاسٍ اغتدى","لَدَيهِ لَقى فَشراً مَع الريح طامِحا",30,"ح",2,0],["وفساد الحراس مع خلل الفهم يقي","ناً من أعظم الأسباب",31,"ب",1,0],["وفسطاطُك الميمونُ حين نصبتهُ","ظننّا رياض الزّهر في أخضر العشب",32,"ب",1,0],["وفسروا الصداقه","الحب حسب الطاقه",33,"ه",1,0],["وفسيل سلمان وآية غرسه","فيها لرفعة قدره إيماء",34,"ا",2,0],["وفسدت نعمة من كفرها","وثبتت نعمة من شكرها",35,"ه",2,0],["وَفَساد من عالم وَأَمير","أَفسَدَ الأَمرَ عالِمٌ وَأَميرُ",36,"ر",1,0],["وفسق وعليون فيها فواجر","على سرر مرصوعة وتناجيس",37,"س",1,0],["وفسادٌ في الرأي أن لا يُرينا","الوهمُ إلاّ سعادةً ويسارا",38,"ر",2,0],["وفَسَادُ منْ ولُّوهُ ظُلْمَاً أمْرَهَا","وحَكُومَةٌ أعْضَاؤهَا أثْوَارُ",39,"ر",1,0],["وفساد هذا الناس رؤية بعضهم","للآثمين كأنهم لم يأثموا",40,"م",3,0],["وفسلٍ يرجمُ النخلاتِ غيظًا","وكلبٍ قد تنكّرَ بالكساءِ",41,"ا",2,0],["20. وفسَّرَ الحُبَّ أخيارٌ وقوْلَتُهمْ","أضْحتْ دليلي بدربِ الحُبِّ نبراسي",42,"س",2,0]]}