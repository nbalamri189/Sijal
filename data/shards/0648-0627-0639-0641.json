 الأنبياء","https://www.poetsgate.com/ViewPoem.aspx?id=131027",""],[5219,"أيام الله","https://www.poetsgate.com/ViewPoem.aspx?id=194555",""],[592,"يا عين فابكي على الإخوان لو بدم","https://www.poetsgate.com/ViewPoem.aspx?id=128812",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5690,"هل نور وجهك ضاءَ في لبنانِ","https://www.poetsgate.com/ViewPoem.aspx?id=172190",""],[5951,"رحلت أميمة للفراق فأصبحت","https://www.poetsgate.com/ViewPoem.aspx?id=52755",""],[5975,"يا إله الخلق..","https://www.poetsgate.com/ViewPoem.aspx?id=58780",""],[5988,"سأبكيك حياً لا بكيتك ميتاً","https://www.poetsgate.com/ViewPoem.aspx?id=99719",""],[6320,"كِتَابُ الله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84340&r=&rc=37",""]],"verses":[["وَأَعفَيتُ مِن لَومي اِمرَأً ما وَجَدتُهُ","مُليماً وَلا باباً عَنِ الجودِ مُقفَلا",0,"ل",2,0],["وَاِعفِف عَنِ الجاراتِ وَاِمنَح","هُنَّ مَيسِرَكَ السَمينا",1,"ن",2,0],["وأعفِ حِتارك واستبقِه","فقد وسعتْه ضِخامُ الكمر",2,"ر",1,0],["واعفُ آثاركَ القِباحَ بآثا","رٍ حِسانٍ تحكي وجُوهَ الرياضِ",3,"ض",1,0],["وأعفيتُ نفسي من أناسٍ أراهمُ","يعدُّونني رَذْلاً وما أنا بالرذلِ",4,"ل",1,0],["وأعفى بالتي أهوى","وباعَ الجهل بالحلمِ",5,"م",1,0],["وأعفيتُ من عزمي على الصرم حرةً","إذا هي خافت فاجعَ البينِ أنَّتِ",6,"ت",1,0],["وَأَعَفُّ مَن لاقَيتَ يَل","قاهُ فَلا يَتَكَرَّمُ",7,"م",1,0],["وَأَعفِ مَسامِعِ مِن صَوتِ رِجسٍ","ثَقيلٍ شَخصُهُ يُدعى سَعيدا",8,"د",2,0],["وأعفجُ فقحةٌ غبرت زماناً","قلَنسُوَة لأيرِ أبي نواسِ",9,"س",1,0],["واعفجِ الجارَ ولا تنسَ أباكا","وابنّ عمّ السوءِ أيضاً فكذاكا",10,"ك",2,0],["وَأَعفَى إذا مَا أَطلَقُوا عَن أَسِيرِهِم","وَأَكرَمَ مِنّا مُطلِقِينَ وَأَشكَرا",11,"ر",2,0],["وأعفيتُ من عزمي على الصرم حرة","ً إذا هي خافت فاجعَ البينِ أصنت",12,"ت",1,0],["واعفُ واصفحْ وقلْ وسُدْ وتجاوز","وابنِ لي مُرْتَقَى المعالي لأَرْقَى",13,"ق",2,0],["وَأَعفو عَن سَفيهِهُمُ وَأُرضي","مَقالَةَ مَن أَرى مِنهُم خَليلا",14,"ل",2,0],["وَأَعفَيتَ المَسامِع مِن حَديثٍ","يَعِنُّ فَتَقشَعِرُّ لَهُ الجُلودُ",15,"د",1,0],["وَاِعفِ النَجائِبَ مِن نَصٍّ وَمِن عَنقٍ","فَقَد بَلَغتَ مُلُوكَ العُربِ وَالعَجَمِ",16,"م",1,0],["وأعفيت نفسيَ من لذّة","فإن متّ متُّ على حسرَتي",17,"ت",2,0],["وَاِعفُ عنّي بهِ وبارِك بعمري","وَاِجعلِ الختمَ فيه مِسكاً ذكيّا",18,"ي",2,0],["وَاعْفُ عَنِّي فَإِنِّي ذُو ذُنُوبٍ","زَحْزَحَتْنِي عَنْ مَهْيَعِ الْغَرَفَاتِ",19,"ت",1,0],["وَاعفُ بِفَضلِكَ سَيِّدي وَاصفَح عَنِ ال","عَبدِ المُسيءِ المُذنِبِ المُتَذَلِّلِ",20,"ل",1,1],["وَاِعفِنا في دينِنا","مِن كُلِّ حُسرٍ وَغُبُن",21,"ن",1,0],["واعف عني إما فقدت رشادى","وحرمت المرجو من يقظاتي",22,"ت",2,0],["وَاِعف عما جَنيت فَضلا وَاِحسا","نا فَاِنّي قَد صِرتُ من مادِحيهِم",23,"م",1,0],["وَاِعف عَن ذا الاِمام ما دامَ عَبدَ اللَ","ه يَجري الدموع وَالاِشعارا",24,"ر",2,0],["واعف عنا ونق القلب من كل الأدران","طهر القلب من شك وغش ومن ران",25,"ن",1,0],["واعف واغفر ذنبنا","واكفنا كل مهول",26,"ل",1,0],["واعف عني وعافني واقض عني","ما على وقل أنابه كفيل",27,"ل",1,0],["واعف عن عبدك الذليل واكفني ما أهمني","واكسني سترك الجميل",28,"ل",1,0],["واعف عنا وعافنا وأنلنا","حللاً في الجنان من رضوانك",29,"ك",1,0],["واعفِ العذولَ عن المَلامِ فلومُه","غيرُ الملمِّ بسمعِ من لم يَجهلِ",30,"ل",1,0],["وَأَعفي عَن قَومي وَلَو شِئتُ نَوَّلوا","إِذا ماتَشَكّى المُلحِفُ المُتَضارِعُ",31,"ع",1,0],["وَأعفر المَسكِ تَلقاهُ فَتَحسَبُهُ","مِن أَدكَنِ الحَزِّ مَخبوءٍ بِخَيفانِ",32,"ن",1,1],["واعْفُ عنِّي واشْفِ الغَليلَ بصفْحٍ","من فُؤادي رَبِّ القُروحِ العَليلِ",33,"ل",1,0],["وَاعفُ عَن الَّذي جَنيت وَمَضى","إِني خَشيتُ مِن وُقوعي في القَضا",34,"ض",2,0],["واعف عنه وعافه وأنله","ما يرجيه واكفه التعطيلا",35,"ل",2,0],["وأعفر الوجنات في عرصاتها","وأرشّ تربتها بدمعي المرسل",36,"ل",1,0],["واعفر له والطف به وتوله","في حالتيه بالحنان المقبل",36,"ل",1,0],["واعف عن والدي واحسن قواهم","بجميل مواصل الإمداد",37,"د",1,0],["واعف عنه وعافه وأنله","ما يرجيه وأكفه الأكدارا",38,"ر",2,0],["وَأَعفيتها مِن كُل سَير وَرحلة","وَأَطلَقتُها تَرعى الكَلا حَيث حَلَت",39,"ت",1,0],["وأَعفْى ابْنَ عَوْفِ بِإِحسانِهِ","وأَلْحفَ مُبْغِضَهُ بِالعَفاءِ",40,"ا",2,0],["واعفُ عن كلِّ الوَرَى إِنْ","أَحْسَنُوا أَوْ إِنْ أَساؤوا",41,"ا",1,0],["وأَعْفِني مِنْ بِعادٍ عَنْ ناديكَ أشْعَرَني","لولا نَداكَ لَما نَظَّمْتُ أشعارَا",42,"ر",2,0],["واعف عني وهب رضاء دواما","وامنح القرب واكفني شر وزرى",43,"ر",2,0],["واعف عني رحمة واجبر لكسري","بمن فاق الكليم والخليل",44,"ل",1,0],["واعف عني وعن احبّاي طرا","وأجرنا من الخطوب العوادي",45,"د",2,0],["واعفُّ عن فضلٍ فتخبث عن دها","واذلُ عن شان يجل فتشمخُ",46,"خ",1,0],["وَأعْفَى من الفُرْقَةِ الفَرْقَدينِ","وسام السمّاكين بَيْناً فَبانا",47,"ن",2,0],["واعف عن عبدِ اللطيف المذ حجى","الطُّويرِ القيرواني البَلَد",48,"د",1,0],["واعف وارحم راحم وانصر وانتصر","وانتقم من كل ذي بغي وغفى",49,"ف",2,0],["واعف عني ان تجدني مذنباً","فاجل الناس قدراً من عفا",50,"ف",2,0],["واعف عن التقصير إذ","لم أك من أهل الوفا",51,"ف",2,0],["واعف عني وارحم وسامح وأعتق","ني من النار يوم فك الرقاب",52,"ب",1,0],["واعف عني عفو مقتدر","أنا عبد مذنب وكفى",53,"ف",2,0],["وأعفهم في هذه الدنيا هو ال","أقوى هناك لزهده الفاني",54,"ن",2,0],["وَأَعفي عَن قَومي وَلضو شئتَ نَوَّلوا","إِذا ما تَشكّى المُلحِفُ المُتَضارِعُ",55,"ع",1,0],["وإعفا اللحا ندب وقيل خذنّ ما","يلي الحلق عما زاد عن قبضة اليد",56,"د",1,0],["واعف عما جناه عفوا كريما","فالكريم الحليم بالعفو احرى",57,"ر",2,0],["وأعف من الذنب وامح الخطايا","وعامل بعفوك دون اقتصاص",58,"ص",1,0],["واعفر من ظباء القاع خشف","يشير إليَّ بالعنم الرطيب",59,"ب",1,0],["وأعفو وما أسلَفتُ ذنباً ولا خَناً","سوى هفواتٍ لا تضُرُّ بجُلّاسي",60,"س",2,0],["وَاعفُ عَمّا جَنَيتُ وَاستُر عُيوبي","بِالنَبِيِّ الأَمينِ خَيرِ الأَنامِ",61,"م",1,0],["وأعفيتَ من تدبيرها متكلِّفاً","تُحَلُّ به يومَ الحفاظِ عقودُها",62,"د",3,0],["وأُعفيتِ السَّوابقُ فاستَراحَت","ونامتْ بعدَ يَقْظَتِهَا الحُروبُ",63,"ب",1,0],["واعفيراً بعد حجر المصطفى","في ثرى الطف قد اختار اضطجاعا",64,"ع",2,0],["واعفهم جيباً وانداهم يداً","واشمهم أنفاً وأشرف مولدا",65,"د",2,0],["واعفُ عن زَلَّتي بفضلِكَ واسمَح","عن ذُنوبِ تطولُ فيها الحكايا",66,"ا",3,0],["وَأَعفّ عَن مَدح العظام صيانة","للنفس عَن هَون وَعَن إِذلال",67,"ل",1,0],["واعفُ بعين اسم العفوِّ عنَّا","ولا يضرُّنا الذي قد عن