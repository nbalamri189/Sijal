ldiwan.net/poem44848.html","مجزوء المديد"],[89,"إن تأييد نهضة العلم مجد","https://www.aldiwan.net/poem44933.html","الكامل"],[89,"إن دين الخلف","https://www.aldiwan.net/poem45134.html","مجزوء الرمل"],[85,"حبذا الساحة والظل الظليل","https://www.aldiwan.net/poem7103.html","الرمل"],[85,"جريدة للوكالة","https://www.aldiwan.net/poem7278.html","المجتث"],[85,"لمن المساكن كالمقابر","https://www.aldiwan.net/poem7768.html","مجزوء الكامل"],[85,"يا ابن زيدون مرحبا","https://www.aldiwan.net/poem8080.html","مجزوء الخفيف"],[85,"مال أحبابه خليلا خليلا","https://www.aldiwan.net/poem62832.html","الخفيف"],[43,"ذي المعالي فليعلون من تعالى","https://www.aldiwan.net/poem9979.html","الخفيف"],[45,"أمواهب هاتيك أم أنواء","https://www.aldiwan.net/poem10197.html","الكامل"],[45,"أن دعاه داعي الصبا فأجابه","https://www.aldiwan.net/poem10667.html","الخفيف"],[45,"يا فضل فيما الصدود والغضب","https://www.aldiwan.net/poem11496.html","المنسرح"],[45,"لا أرى بالعقيق رسما يجيب","https://www.aldiwan.net/poem62639.html","الخفيف"],[45,"إن رق لي قلبك مما ألاقي","https://www.aldiwan.net/poem65188.html","السريع"],[61,"عش مدى الدهر يا أبا إسحاق","https://www.aldiwan.net/poem51505.html","الخفيف"],[58,"الأزد سيفي على الأعداء كلهم","https://www.aldiwan.net/poem31152.html","البسيط"],[49,"إن دارا نحن فيها لدار","https://www.aldiwan.net/poem62089.html","المديد"],[49,"أين من كان قبلنا أين أينا","https://www.aldiwan.net/poem63128.html","الخفيف"],[49,"مرت اليوم شاطرة","https://www.aldiwan.net/poem64188.html","مجزوء الخفيف"],[80,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[80,"خلعت على بنيات الكروم","https://www.aldiwan.net/poem31295.html","الوافر"],[80,"الهجر يضحك والهوى يبكي","https://www.aldiwan.net/poem31352.html","أحذ الكامل"],[69,"طول المقام بدار الحرث برح بي","https://www.aldiwan.net/poem29268.html","البسيط"],[31,"إنني اليوم عادني أحزاني","https://www.aldiwan.net/poem41287.html","الخفيف"],[39,"هل يدنيك من أجارع واسط","https://www.aldiwan.net/poem53778.html","الكامل"],[75,"طلب المجد من طريق السيوف","https://www.aldiwan.net/poem69060.html","الخفيف"],[48,"إن دام إفلاسي على ما أرى","https://www.aldiwan.net/poem62446.html","السريع"],[48,"ما رعى الدهر آل برمك حقا","https://www.aldiwan.net/poem64389.html","الخفيف"],[48,"آنست نفسي بالتوحد","https://www.aldiwan.net/poem64992.html","مجزوء الكامل"],[48,"وغرير الشباب محتبك الحسن","https://www.aldiwan.net/poem65103.html","الخفيف"],[50,"إن دهراً يضم شملي بسلمى","https://www.aldiwan.net/poem24516.html","الخفيف"],[50,"اشفعي لي صريم عند الكنود","https://www.aldiwan.net/poem63937.html","الخفيف"],[46,"فقدت في أيامك العلماء","https://www.aldiwan.net/poem22013.html","الخفيف"],[46,"المشيدات التي رفعت","https://www.aldiwan.net/poem22788.html","المديد"],[46,"إن دمعي نبع وما العود نبع","https://www.aldiwan.net/poem22948.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85853","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85428","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42644","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54935","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54917","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54750","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141933","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43725","المنسرح"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142334","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[106,"زمزم طليعة الأسطول المصري","https://www.poetsgate.com/ViewPoem.aspx?id=179646",""],[77,"حيى ربوع الحي من نعمان","https://www.poetsgate.com/ViewPoem.aspx?id=34207",""],[45,"إنْ دَعَاهُ داعي الصبَى، فأجابَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31576",""],[45,"لا أرى بالعقيق رسما يجيب","https://www.poetsgate.com/ViewPoem.aspx?id=33099",""],[51,"قل للأمير أدام الله غبطَته","https://www.poetsgate.com/ViewPoem.aspx?id=27700",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"]],"verses":[["إِن دَفَعوا ظِمئي فَيا رُبَّما","ذادَت عَنِ الماءِ الحِقاقُ القُروم",0,"م",1,0],["إِن دامَ ما بي يا مُحَمَّدُ هَكَذا","فَلَأَهلَكَنَّ وَقاتِلي لا يَعلَمُ",1,"م",1,0],["أَندُبُ وَصَلَ الحَبيبِ أَن صَرَما","كَأَنَّما كانَ وَصلُهُ حُلُما",2,"م",2,1],["إِن دَعا يَبتَغي سِواكَ مِنَ النا","سِ عَصاهُ لِسانُهُ فَدَعاكا",3,"ك",2,0],["أُندُبِ العُشّاقَ لا غَيرَهُمُ","إِنَّما الهالِكُ مَن قَد عَشِقا",4,"ق",2,0],["إِن دَخَلتُ البُستانَ أَذكَرَني ري","حَكِ ريحُ النَسرينِ وَالتُفّاحِ",5,"ح",1,0],["إِن دامَ ذا الهَجرُ يا ظَلومُ وَلا","دامَ فَما لي في العَيشِ مِن أَرَبِ",6,"ب",1,0],["إِنْ دَوَّنَ الْفُضَلاَءُ فَضْلاً مُعْلَماً","فَلَقَدْ أَتَيْتَ عَلَيْهِ بِالإِكْمَالِ",7,"ل",1,0],["إِن دامَ ما نَحنُ فيهِ مِن مُدابَرَةٍ","وَفِتنَةٍ بَينَ أَجناسٍ وَأَديانِ",8,"ن",1,0],["أَندى المُلوكِ نَدىً وَأَطولُهُم يَداً","وَأَعَزُّهُم خالاً وَأَكرَمُهُم أَبا",9,"ب",2,0],["إِنَّ دَارَ السَّلامِ وَالمَلِكِ إلا","رَوْعِ فِيهَا دَارٌ عَلَيْهَا السَّلامُ",10,"م",1,0],["إن دام هذا في البلاد فإنه","بدوامه لسيوفنا مُسترعِف",11,"ف",1,0],["إن ديك الدهر قد با","ض ببغداد وزاره",12,"ر",2,0],["إِنَّ دَهراً يَلُفُّ شَملي بِجُملٍ","لَزَمانٌ يَهُمُّ بِالإِحسانِ",13,"ن",1,1],["إن داراً كمسجد بصفيِّ الد","ين يقضي بأن دمعي خلوق",14,"ق",1,0],["إن دامَ حالي وإسهالي استحلت خراً","ما بين مندفعِ يجري ومندفق",15,"ق",1,1],["أندى البرية والأنواء باخلة","وأسبق الخلق والسادات تزدحم",16,"م",1,0],["إن دعوناكَ للِّواط فلا بِدْ","عاً وإن كان باطلاً ما زَعَمتا",17,"ت",2,0],["إن دام جودُك أنْزَفْنا قَرائحنا","بعد الجُمُوم وآذَنّا بإنفادِ",18,"د",1,0],["أندرْ لها ضِرساً إذا أبذرت","بل لا تدع في فمها ضرسا",19,"س",2,0],["إن دنياً ملكته رغيفاً","لمباح ما لها بل مضاع",20,"ع",1,0],["إِنَّ دائِيَ جاءَ مِن صاد وَدال","وَدَواءُ القَلبِ في ضاد وَميم",21,"م",1,0],["إِن دَجَت لَيلَةٌ أَراكَ ضُحاها","أَو ذَوَت زَهرَةٌ أَراكَ شَذاها",22,"ا",3,0],["اندبي يا قريش سيدك الصقر","فقد غاله من الليل غول",23,"ل",1,0],["اند الماضي","ثم ابكين مستقبلك",24,"ك",1,0],["إن دهراً أعطى العراق رقياً","ثم رد الرُقيَّ منه لوغد",25,"د",1,0],["إن دين الخلف","من تراث السلف",26,"ف",1,1],["إن دارا حُطتموها بالندى","أخذت عهد الندى ألا تميل",27,"ل",1,0],["إن دام فيها رشيد","فان تدوم رشيدة",28,"ه",1,0],["إن دام هذا فالسلا","م على الَمَحارب والمنائر",29,"ر",1,0],["إِنَّ ديوانَكَ الَّذي","ظَلَّ سِرّاً مُحَجَّبا",30,"ب",2,0],["إِنَّ دَمعاً تَذرِفنَ إِثرَ رِفاقي","سَوفَ يَبكي بِهِ الخَليلُ الخَليلا",31,"ل",2,0],["إِنَّ دونَ الَّتي عَلى الدَربِ وَالأَح","دَبِ وَالنَهرِ مِخلَطاً مِزيالا",32,"ل",2,0],["إِن دامَ ذا أَو بَعضُ ذا مِن فِعلِ ذا","فَنِيَ السَخاءُ فَلا يُحَسُّ سَخاءُ",33,"ا",2,0],["أَن دَعاهُ داعي الصِبا فَأَجابَهُ","وَرَمى قَلبَهُ الهَوى فَأَصابَه",34,"ب",2,1],["أَندَبُ حَيّاً ماتَت مَوَدَّتُهُ","طَوراً وَطَوراً عَلَيهِ أَنتَحِبُ",35,"ب",1,0],["إِن دَنا مُبعِدٌ أَو اِنقادَ آبٍ","بِتَأَتّيكَ أَو أَجابَ مُجيبُ",36,"ب",1,0],["إِنَّ دِمَشقاً أَصبَحَت جَنَّةً","مُخضَرَّةَ الرَوضِ عَذاةَ البِراق",37,"ق",1,0],["إنَّ داراً تَضُمُّ أخلاقَكَ الغُرَّ","لَدارُ الجِنانِ غيرَ اختلاقِ",38,"ق",1,0],["أَندى الأَنامِ أَكُفّاً حينَ تَسأَلُهُم","وَأَربَطُ الناسِ جَأشاً إِن هُمُ نُدِبوا",39,"ب",3,0],["إِنَّ داراً نَحنُ فيها لَدارُ","لَيسَ فيها لِمُقيمٍ قَرارُ",40,"ر",1,1],["إِنَّ دَهراً أَتى عَلَيهِم فَأَفنى","مِنهُمُ الجَمعَ سَوفَ يَأتي عَلَينا",41,"ن",2,0],["إِنَّ دُنيا هِيَ الَّتي","مَرَّتِ اليَومَ سافِرَه",42,"ر",2,0],["إن دعاهُمْ مُثَوِّبُ الموْتِ خاضوا","في حشا الحرب بالخميس اللهامِ",43,"م",1,0],["أندىً في الزهرٍ أم ماءُ الهوى","حارَ في أعينِ حُورٍ لم تنم",44,"م",1,0],["إِن دامَ هَجْرُكِ لي بلا سَبَبٍ","فَلأنتِ قاتِلَتِي بِلا شكِّ",45,"ك",1,0],["إنْ دامَ هذا وحاشاهُ يدومُ بنا","فارقْتُ زيي إلى ما ليسَ يجملُ بي",46,"ب",2,0],["إِنَّ دَهراً يُلُفُّ شَملي بِسُعدى","لَزَمانٌ يَهِمُّ بِالإِحسانِ",47,"ن",1,0],["أَندى يَداً لِعَشيرَةٍ مِن مالِهِ","في غَيرِ تَعتَعَةٍ وَلا اِقذِحرارِ",48,"ر",1,0],["إنّ دَهْراً سَمَوْتَ فِهِ عُلُوّاً","لَوَضِيعُ الخطوبِ وغْدُ الصُّرُوفِ",49,"ف",1,0],["إِن دامَ إِفلاسي عَلى ما أَرى","هَجَرتُ إِخواني وَأَصحابي",50,"ي",1,1],["إِنَّ دَهراً لَم يَرعَ حَقّاً لِيَحيى","غَيرُ راعٍ ذِمامَ آلِ الرَبيعِ",51,"ع",1,0],["إِن دامَ ذا كانَ البَقا","ءُ وَلا بَقيتُ لَهُ قَليلا",52,"ل",2,0],["أَندَبَت كَفُّهُ الزُجاجَةُ وَهناً","فَهيَ فيها جِراحُ تِلكَ الكُلومِ",53,"م",1,0],["إِنَّ دَهراً يَضُمُّ شَملي بِسَلمى","لَزَمانٌ قَد هَمَّ بِالإِحسانِ",54,"ن",1,1],["إِنَّ دائي طَغى وَإِنَّ شِفائي","غُبرَةٌ مِن رُضابِ فيكِ البَرودِ",55,"د",1,0],["إِنَّ دُنياكَ مِن نَهارٍ وَلَيلٍ","وَهيَ في ذاكَ حَيَّةٌ عَرماءُ",56,"م",3,0],["إِن دَنا مِن فارِسٍ أَجَلٌ","حارَ لا يَجري بِهِ الفَرَسُ",57,"س",1,0],["إِنَّ دَمعي نَبعٌ وَما العودُ نَبعُ","وَحَواني مِن مَنزِلِ الهَمِّ رَبعُ",58,"ع",1,1],["إن دين اللَه ديني","ليس أعلى منه دين",59,"ن",1,1],["إن دفع الأثير شد عراها","بذكاء فظن جذب ذكاء",60,"ا",2,0],["إن دهراً قد هدَّ منك بناءً","لَم يَكن عمَّا قَد أَتى مَسؤولا",61,"ل",2,0],["إِنْ دَامَ هَذَا أَضَاعَ الرُّشْدَ كَافِلُهُ","فِي مَا أَرَى وَأَطاعَ الْغَيَّ زَاجِرُهُ",62,"ر",2,0],["إِنْ دَنَا الْهَمُّ مِنْهُ أَقْصَاهُ عَنْهُ","ضَحِكُ النَّبْتِ أَوْ تَنَاغِي الطيُورِ",63,"ر",1,0],["إِنْ دَعَاهُ الحِفَاظُ أَقْبَلَ غِلْما","ن سِرَاعٌ مِنَ القُرَى وَالبَوَادِي",64,"د",2,0],["إِنَّ دِيوَانَ حَافِظٍ لهْوَ تَارِيخُ","زَمَانٍ يَحْوِيه دِيوَانُ شِعْرِ",65,"ر",1,0],["إِنْ دَعَا الخُلفُ فَهْوَ غَيْرُ قَرِيبٍ","أَوْ دَعَا الإِلْفُ فَهْوَ غَيْرُ بَعِيد",66,"د",1,0],["أندى على جفنٍ يساوِرهُ الأسى","وأخفُّ من مرحِ الهزارش الشادي",67,"ي",1,0],["إِنَّ دِياراً حَلَلتها لِفَلا","وَإِنّ سِرباً بَكى مَعي لَقطا",68,"ط",2,0],["إن داري كغربتي في المنافي","احتراقي كذكريات رمادي",69,"د",2,0],["إِنْ دَعَانا الهَوَى لغَيْرِ سَدِيدٍ","سَدَّدَتْنا كَرَائمُ الأَحْسَاب",70,"ب",1,0],["إنّ دارَ العُلُومِ بِنْيَةَ إِسما","عِيلَ تُزْهَى بِه عَلَى كلِّ بانِ",71,"ن",1,0],["إنْ داعبَتْها ريُحه، خَفَقَتْ","خفقانَ قلب الصَّبِّ في الصَّدر",72,"ر",1,0],["أندرت قبل النضج لما جئتها","ملكا وكان البرء في البحران",73,"ن",1,0],["إنْ دَعَاهُ داعي الصبَى، فأجابَهْ","وَرَمَى قَلْبَهُ الهوَى، فأصَابَهْ",74,"ب",2,1],["إن دنا معبد أو انقاد آب","بتأتيك أو أجاب مجيب",75,"ب",1,0],["إن دام جودُك أنزَفنا قرائحنا","بعد الجحوم وآذنّا بإنفادِ",76,"د",1,0],["إن داء به تموت الصعالي","ك كداء به يموت الهمام",77,"م",1,0]]}