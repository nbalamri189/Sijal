دك الله بهجة ووقارا","https://www.aldiwan.net/poem53883.html","الخفيف"],[417,"ما زلت أول مغرم مفتون","https://www.aldiwan.net/poem54126.html","الكامل"],[430,"أقبلت تنجلى وفي الخد شامه","https://www.aldiwan.net/poem40043.html","الخفيف"],[430,"هذي الديار ديار بيت الدين","https://www.aldiwan.net/poem40289.html","الكامل"],[433,"أندى وجه وسيم","https://www.aldiwan.net/poem12425.html","مجزوء الرمل"],[438,"إن دمعا طلعا وقلبا أسيرا","https://www.aldiwan.net/poem2527.html","الخفيف"],[438,"إن داراً بين اللوى والعفيق","https://www.aldiwan.net/poem2547.html","الخفيف"],[438,"بما بجفنيك من غنجٍ ومن كحلِ","https://www.aldiwan.net/poem2610.html","البسيط"],[444,"نقل الطرف في ربوع الأمان","https://www.aldiwan.net/poem55974.html","عموديه"],[459,"سل بسلع شجنا كان وكنا","https://www.aldiwan.net/poem55822.html","الرمل"],[459,"علمتها الأيام أن تتجنى","https://www.aldiwan.net/poem55839.html","الخفيف"],[459,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[469,"ما قيمة السكر عندي ما أكابده","https://www.aldiwan.net/poem60010.html","الطويل"],[469,"أنداؤنا يقق ودر","https://www.aldiwan.net/poem60137.html","مجزوء الكامل"],[480,"مجلس الشورى هل أتاك النذير","https://www.aldiwan.net/poem37602.html","الخفيف"],[496,"يا حريصا على الغنى","https://www.aldiwan.net/poem9822.html","مجزوء الخفيف"],[501,"كم نشرنا من طامس وطوينا","https://www.aldiwan.net/poem37722.html","الخفيف"],[515,"حتام أسألها الدنو فتنزح","https://www.aldiwan.net/poem20804.html","الكامل"],[515,"خطرت فمال الغصن وهو ممنطق","https://www.aldiwan.net/poem20823.html","الكامل"],[516,"فرض على الشعر أن يبدا بما يجب","https://www.aldiwan.net/poem12013.html","البسيط"],[516,"فقت الملوك مهابة وجلالاً","https://www.aldiwan.net/poem12204.html","الكامل"],[537,"عين جودي فإن ذاك شفائي","https://www.aldiwan.net/poem23865.html","الخفيف"],[541,"إن دافعوا لم يعب دفاعهم","https://www.aldiwan.net/poem56709.html","البسيط"],[552,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[559,"إن ديني وملتي واعتقادي","https://www.aldiwan.net/poem34642.html","الخفيف"],[576,"لست أدري بأي فتح تهنا","https://www.aldiwan.net/poem3001.html","الخفيف"],[587,"إن دام هذا التجني منك والغضب","https://www.aldiwan.net/poem17415.html","البسيط"]],"verses":[["إِن دَفَعوا ظِمئي فَيا رُبَّما","ذادَت عَنِ الماءِ الحِقاقُ القُروم",0,"م",1,0],["إِن دامَ ما بي يا مُحَمَّدُ هَكَذا","فَلَأَهلَكَنَّ وَقاتِلي لا يَعلَمُ",1,"م",1,0],["أَندُبُ وَصَلَ الحَبيبِ أَن صَرَما","كَأَنَّما كانَ وَصلُهُ حُلُما",2,"م",2,1],["إِن دَعا يَبتَغي سِواكَ مِنَ النا","سِ عَصاهُ لِسانُهُ فَدَعاكا",3,"ك",2,0],["أُندُبِ العُشّاقَ لا غَيرَهُمُ","إِنَّما الهالِكُ مَن قَد عَشِقا",4,"ق",2,0],["إِن دَخَلتُ البُستانَ أَذكَرَني ري","حَكِ ريحُ النَسرينِ وَالتُفّاحِ",5,"ح",1,0],["إِن دامَ ذا الهَجرُ يا ظَلومُ وَلا","دامَ فَما لي في العَيشِ مِن أَرَبِ",6,"ب",1,0],["إِنْ دَوَّنَ الْفُضَلاَءُ فَضْلاً مُعْلَماً","فَلَقَدْ أَتَيْتَ عَلَيْهِ بِالإِكْمَالِ",7,"ل",1,0],["إِن دامَ ما نَحنُ فيهِ مِن مُدابَرَةٍ","وَفِتنَةٍ بَينَ أَجناسٍ وَأَديانِ",8,"ن",1,0],["أَندى المُلوكِ نَدىً وَأَطولُهُم يَداً","وَأَعَزُّهُم خالاً وَأَكرَمُهُم أَبا",9,"ب",2,0],["إِنَّ دَارَ السَّلامِ وَالمَلِكِ إلا","رَوْعِ فِيهَا دَارٌ عَلَيْهَا السَّلامُ",10,"م",1,0],["إن دام هذا في البلاد فإنه","بدوامه لسيوفنا مُسترعِف",11,"ف",1,0],["إن ديك الدهر قد با","ض ببغداد وزاره",12,"ر",2,0],["إِنَّ دَهراً يَلُفُّ شَملي بِجُملٍ","لَزَمانٌ يَهُمُّ بِالإِحسانِ",13,"ن",1,1],["إن داراً كمسجد بصفيِّ الد","ين يقضي بأن دمعي خلوق",14,"ق",1,0],["إن دامَ حالي وإسهالي استحلت خراً","ما بين مندفعِ يجري ومندفق",15,"ق",1,1],["أندى البرية والأنواء باخلة","وأسبق الخلق والسادات تزدحم",16,"م",1,0],["إن دعوناكَ للِّواط فلا بِدْ","عاً وإن كان باطلاً ما زَعَمتا",17,"ت",2,0],["إن دام جودُك أنْزَفْنا قَرائحنا","بعد الجُمُوم وآذَنّا بإنفادِ",18,"د",1,0],["أندرْ لها ضِرساً إذا أبذرت","بل لا تدع في فمها ضرسا",19,"س",2,0],["إن دنياً ملكته رغيفاً","لمباح ما لها بل مضاع",20,"ع",1,0],["إِنَّ دائِيَ جاءَ مِن صاد وَدال","وَدَواءُ القَلبِ في ضاد وَميم",21,"م",1,0],["إِن دَجَت لَيلَةٌ أَراكَ ضُحاها","أَو ذَوَت زَهرَةٌ أَراكَ شَذاها",22,"ا",3,0],["اندبي يا قريش سيدك الصقر","فقد غاله من الليل غول",23,"ل",1,0],["اند الماضي","ثم ابكين مستقبلك",24,"ك",1,0],["إن دهراً أعطى العراق رقياً","ثم رد الرُقيَّ منه لوغد",25,"د",1,0],["إن دين الخلف","من تراث السلف",26,"ف",1,1],["إن دارا حُطتموها بالندى","أخذت عهد الندى ألا تميل",27,"ل",1,0],["إن دام فيها رشيد","فان تدوم رشيدة",28,"ه",1,0],["إن دام هذا فالسلا","م على الَمَحارب والمنائر",29,"ر",1,0],["إِنَّ ديوانَكَ الَّذي","ظَلَّ سِرّاً مُحَجَّبا",30,"ب",2,0],["إِنَّ دَمعاً تَذرِفنَ إِثرَ رِفاقي","سَوفَ يَبكي بِهِ الخَليلُ الخَليلا",31,"ل",2,0],["إِنَّ دونَ الَّتي عَلى الدَربِ وَالأَح","دَبِ وَالنَهرِ مِخلَطاً مِزيالا",32,"ل",2,0],["إِن دامَ ذا أَو بَعضُ ذا مِن فِعلِ ذا","فَنِيَ السَخاءُ فَلا يُحَسُّ سَخاءُ",33,"ا",2,0],["أَن دَعاهُ داعي الصِبا فَأَجابَهُ","وَرَمى قَلبَهُ الهَوى فَأَصابَه",34,"ب",2,1],["أَندَبُ حَيّاً ماتَت مَوَدَّتُهُ","طَوراً وَطَوراً عَلَيهِ أَنتَحِبُ",35,"ب",1,0],["إِن دَنا مُبعِدٌ أَو اِنقادَ آبٍ","بِتَأَتّيكَ أَو أَجابَ مُجيبُ",36,"ب",1,0],["إِنَّ دِمَشقاً أَصبَحَت جَنَّةً","مُخضَرَّةَ الرَوضِ عَذاةَ البِراق",37,"ق",1,0],["إنَّ داراً تَضُمُّ أخلاقَكَ الغُرَّ","لَدارُ الجِنانِ غيرَ اختلاقِ",38,"ق",1,0],["أَندى الأَنامِ أَكُفّاً حينَ تَسأَلُهُم","وَأَربَطُ الناسِ جَأشاً إِن هُمُ نُدِبوا",39,"ب",3,0],["إِنَّ داراً نَحنُ فيها لَدارُ","لَيسَ فيها لِمُقيمٍ قَرارُ",40,"ر",1,1],["إِنَّ دَهراً أَتى عَلَيهِم فَأَفنى","مِنهُمُ الجَمعَ سَوفَ يَأتي عَلَينا",41,"ن",2,0],["إِنَّ دُنيا هِيَ الَّتي","مَرَّتِ اليَومَ سافِرَه",42,"ر",2,0],["إن دعاهُمْ مُثَوِّبُ الموْتِ خاضوا","في حشا الحرب بالخميس اللهامِ",43,"م",1,0],["أندىً في الزهرٍ أم ماءُ الهوى","حارَ في أعينِ حُورٍ لم تنم",44,"م",1,0],["إِن دامَ هَجْرُكِ لي بلا سَبَبٍ","فَلأنتِ قاتِلَتِي بِلا شكِّ",45,"ك",1,0],["إنْ دامَ هذا وحاشاهُ يدومُ بنا","فارقْتُ زيي إلى ما ليسَ يجملُ بي",46,"ب",2,0],["إِنَّ دَهراً يُلُفُّ شَملي بِسُعدى","لَزَمانٌ يَهِمُّ بِالإِحسانِ",47,"ن",1,0],["أَندى يَداً لِعَشيرَةٍ مِن مالِهِ","في غَيرِ تَعتَعَةٍ وَلا اِقذِحرارِ",48,"ر",1,0],["إنّ دَهْراً سَمَوْتَ فِهِ عُلُوّاً","لَوَضِيعُ الخطوبِ وغْدُ الصُّرُوفِ",49,"ف",1,0],["إِن دامَ إِفلاسي عَلى ما أَرى","هَجَرتُ إِخواني وَأَصحابي",50,"ي",1,1],["إِنَّ دَهراً لَم يَرعَ حَقّاً لِيَحيى","غَيرُ راعٍ ذِمامَ آلِ الرَبيعِ",51,"ع",1,0],["إِن دامَ ذا كانَ البَقا","ءُ وَلا بَقيتُ لَهُ قَليلا",52,"ل",2,0],["أَندَبَت كَفُّهُ الزُجاجَةُ وَهناً","فَهيَ فيها جِراحُ تِلكَ الكُلومِ",53,"م",1,0],["إِنَّ دَهراً يَضُمُّ شَملي بِسَلمى","لَزَمانٌ قَد هَمَّ بِالإِحسانِ",54,"ن",1,1],["إِنَّ دائي طَغى وَإِنَّ شِفائي","غُبرَةٌ مِن رُضابِ فيكِ البَرودِ",55,"د",1,0],["إِنَّ دُنياكَ مِن نَهارٍ وَلَيلٍ","وَهيَ في ذاكَ حَيَّةٌ عَرماءُ",56,"م",3,0],["إِن دَنا مِن فارِسٍ أَجَلٌ","حارَ لا يَجري بِهِ الفَرَسُ",57,"س",1,0],["إِنَّ دَمعي نَبعٌ وَما العودُ نَبعُ","وَحَواني مِن مَنزِلِ الهَمِّ رَبعُ",58,"ع",1,1],["إن دين اللَه ديني","ليس أعلى منه دين",59,"ن",1,1],["إن دفع الأثير شد عراها","بذكاء فظن جذب ذكاء",60,"ا",2,0],["إن دهراً قد هدَّ منك بناءً","لَم يَكن عمَّا قَد أَتى مَسؤولا",61,"ل",2,0],["إِنْ دَامَ هَذَا أَضَاعَ الرُّشْدَ كَافِلُهُ","فِي مَا أَرَى وَأَطاعَ الْغَيَّ زَاجِرُهُ",62,"ر",2,0],["إِنْ دَنَا الْهَمُّ مِنْهُ أَقْصَاهُ عَنْهُ","ضَحِكُ النَّبْتِ أَوْ تَنَاغِي الطيُورِ",63,"ر",1,0],["إِنْ دَعَاهُ الحِفَاظُ أَقْبَلَ غِلْما","ن سِرَاعٌ مِنَ القُرَى وَالبَوَادِي",64,"د",2,0],["إِنَّ دِيوَانَ حَافِظٍ لهْوَ تَارِيخُ","زَمَانٍ يَحْوِيه دِيوَانُ شِعْرِ",65,"ر",1,0],["إِنْ دَعَا الخُلفُ فَهْوَ غَيْرُ قَرِيبٍ","أَوْ دَعَا الإِلْفُ فَهْوَ غَيْرُ بَعِيد",66,"د",1,0],["أندى على جفنٍ يساوِرهُ الأسى","وأخفُّ من مرحِ الهزارش الشادي",67,"د",2,0],["إِنَّ دِياراً حَلَلتها لِفَلا","وَإِنّ سِرباً بَكى مَعي لَقطا",68,"ط",2,0],["إن داري كغربتي في المنافي","احتراقي كذكريات رمادي",69,"د",2,0],["إِنْ دَعَانا الهَوَى لغَيْرِ سَدِيدٍ","سَدَّدَتْنا كَرَائمُ الأَحْسَاب",70,"ب",1,0],["إنّ دارَ العُلُومِ بِنْيَةَ إِسما","عِيلَ تُزْهَى بِه عَلَى كلِّ بانِ",71,"ن",1,0],["إنْ داعبَتْها ريُحه، خَفَقَتْ","خفقانَ قلب الصَّبِّ في الصَّدر",72,"ر",1,0],["أندرت قبل النضج لما جئتها","ملكا وكان البرء في البحران",73,"ن",1,0],["إن داري كغربتي في المنافي","واحتراقي كذكريات رمادي",74,"د",2,0],["إنْ دَعَاهُ داعي الصبَى، فأجابَهْ","وَرَمَى قَلْبَهُ الهوَى، فأصَابَهْ",75,"ب",2,1],["إن دنا معبد أو انقاد آب","بتأتيك أو أجاب مجيب",76,"ب",1,0],["إن دام جودُك أنزَفنا قرائحنا","بعد الجحوم وآذنّا بإنفادِ",77,"د",1,0],["إن داء به تموت الصعالي","ك كداء به يموت الهمام",78,"م",1,0],["إنّ دين العظيم في كلّ شعب","لا يوفّى وحقّه لا يؤدّى ...",79,"د",2,0],["اندب الاطلال وحدي","والنوى اقصى مداها",80,"ا",3,0],["إن دائي الهوى وإن دوائي","نظر منك ليس بالمردود",81,"د",1,0],["إن داء القلوب داءٌ عياء","مثل داء المنون للأحياء",82,"ا",2,0],["إن دائى وعلَّتى ودوائِى","وسَقامِى مما حَواه خمارُهْ",83,"ر",2,0],["إنّ دائى قَوَامُه والمحيَّا","ولَماهُ وخدُّه وعِذَارُه",83,"ر",2,0],["إن دائي هِجرانُها بعد مَطْلٍ","والتجنِّي والبعدُ بعدَ التمادِي",84,"د",2,0],["إنَّ دَارَ القُدُوسِ دَارُ نَعِيمٍ","وَسَلاَمٍ وقُرَّةٍ وقَرَارِ",85,"ر",1,0],["إنَّ دَعداً لم يُسلني العَذلُ عَنها","ومَلامِى في حبها إرَائِى",86,"ا",2,0],["أندى يداً في الجودِ من حاتمٍ","أصدق في أقوالهِ من حَذامْ",87,"م",1,0],["إِن دَعاهُم إِلى الكَريهَةِ داعٍ","جَعَلوا الطَعنَ وَالضِرابَ جَوابا",88,"ب",2,0],["أَنداهُمُ في عامِ مَس","غَبَةٍ وَأَكرَمُهُم قَبيلَه",89,"ل",2,0],["إِنَّ دُمُوعي فيكَ يا سَيِّدي","تَكَلَّمَتْ عَنْ أَلْسُنٍ خُرْسِ",90,"س",1,0],["إِن دون الذي حلفتَ عليه","مرهفاتُ مخيبات الظنون",91,"ن",1,0],["إن دما طائفة ابن عربي","بأمر رب العالمين تسفك",92,"ك",1,0],["إِنَّ دَهراً فَلَّ حَدَّهُمُ","حَدُّهُ لا بُدَّ مَفلولُ",93,"ل",1,0],["إن دعا فارسٌ إلى الموتِ قرنا","سبقَ الموتُ نحوهُ أقرانهْ",94,"ن",2,0],["اندى من الغيث يدا كفه","وجوده اوفى من البحر",95,"ر",1,0],["إنَّ دينَ المَسيحِ يَأمُرُ بِالعُر","فِ وَيَنهى عن خُطَّةِ الجُهلاءِ",96,"ا",2,0],["إن دعتْها الأُنوفُ فاحت عَبِيراً","أو رمتْها العيونُ لاحت ضياء",97,"ا",2,0],["أَنْدَاهُمُ كَفّاً أَكَفُّهُمُ","عَنْ فِعْلِ مَحْظُورٍ وَمَلْقُوسِ",98,"س",1,0],["إنَّ دمعي جدُّ غالِ","قد تلاشى بالسُّهادِ",99,"د",1,0],["إن دام هجرانكم على ذا","طمتُ من بعنكم حصري",100,"ر",2,0],["ان دجى حرب مشكلات جلاه","برق فهم منه سناه سنان",101,"ن",1,0],["إِن دَعاني الأَميرُ عايَنَ مِنّي","شَمَّرِيّاً لا كَالجُلجُلِ الصَيَّاحِ",102,"ح",1,0],["إِن دَعج العيون من غير عيب","آلفته الضنا قَليلا قَليلا",103,"ل",2,0],["إنْ دَوَّخَ العُرْب الصّعابَ مَقَادَةً","وأبى عليها أن تُطيع إبَاءها",104,"ا",3,0],["إِن دَقَّ خَطاً جَلَّ خَطباً فَهوَ في","يُمنى يَدَيكَ الأَرقَمُ الرَقّامُ",105,"م",1,0],["إِن دامَ طِبُّكَ هَذا","يا نَصرُ في كَفرِ عامِر",106,"ر",1,1],["أَندى مِنَ النَسيمِ مَط","لولَ الحَواشي سَحَرا",107,"ر",2,0],["إن دعانا إلى المكارم داعٍ","كنت في القوم سابقا أترابي",108,"ب",2,0],["إن دغدغته الصَبا آبَتْ بعبْستِهِ","لكنّها عَبْسَةُ السكّيرِ للراح",109,"ح",1,0],["إن دين الرسول فيك مقيم","أو يزيل الرسول عنه دجونه",110,"ن",2,0],["إن دعى غالب هماما","أنكرت منه شعراً تواما",111,"م",2,1],["أَندُبُ سَيْفاً مُغْمداً","في لَحْدِهِ مُجَرَّدا",112,"د",2,0],["أندى دعاة البكا داع بكاهُ يرى","دينا فكم ضارع يبكي ومختبط",113,"ط",1,0],["اِن دَعوا في الخطوب يَوماً أَجابوا","أَو سعوا كان سَعيَهُم مَشكورا",114,"ر",2,0],["اِنّ دَهرا أَفادَنا مِنكَ قُربا","بَعد بعد دَهر عَلَينا لَهُ النيد",115,"د",1,0],["أَنْدَى الرَّبيعَيْنِ للرَّاجي بنانُ يَدٍ","مليئةٍ بسِجالِ الجُودِ والباس",116,"س",1,0],["إن دَهراً نأَى بشَخْصِك عنّا","لَمُسِرٌّ عداوةَ الأغمار",117,"ر",1,0],["إِن دارَ القَرارِ فيما سِواها","فَاِستَعِدّوا لِجَنَّةٍ أَو نارِ",118,"ر",1,0],["إن دينَ الحُب حَقٌ","وسلوّي عنه باطِلْ",119,"ل",1,0],["إن دُعُوا خِلْتَهم غيوثَ نوالِ","أَودَعَوْا خِلتَهم ليوثَ صدامِ",120,"م",1,0],["إنّ دِيني واعْتقادي حُبُّه","ونَجَاني يومَ حَشْري وأماني",121,"ن",2,0],["إِن دامَ هَجرك لي وَعَزَّ تَصَبُّري","رَغماً وَطال تَشَوُّقي وَسِقامي",122,"م",2,0],["إِن دامَ دَمعكِ فاحذَري غرقاً به","وَإِذا تَوالى القَطرُ كان سُيولا",123,"ل",2,0],["إنَّ داعيك والشواغل شتّى","لك في خالص الدعاء اشتغاله",124,"ل",2,0],["إنْ دوَّنوا فيك المديح فإنَّما","مدح الكرام أحقُّ بالتدوين",125,"ن",1,0],["إن دهرا شكوته هو دهرٌ","ليس يدري كرامه اسقامه",126,"م",2,0],["إن دنست عيني برؤية غيرها","وطهرتها بصبيب ماء جفوني",127,"ن",2,0],["أَندَى وجهٍ وَسِيمِ","وشذا عرف نسيمِ",128,"م",1,1],["إن دمعا طلعا وقلبا أسيرا","راح عذب الحياة منها مريرا",129,"ر",2,1],["إن داراً بين اللوى والعفيق","هاجت الشوق للفؤاد المشوق",130,"ق",1,1],["إن دام هجرك لي يا من أؤمّله","أصار ما قد بقي مني إلى الأجل",131,"ل",1,0],["ان دعاك امروء إلى السكر فاعلم","انها دعوة إلى الخسران",132,"ن",1,0],["إنْ دَجا الليلُ فعمَّى طُرْقَها","نصبَتْ حَرْسا مكانَ العين أُذْنا",133,"ن",2,0],["إن دعا في مواقف الفضل لم تُب","رِزْ إليه جحافلُ الفضل قِرْنا",134,"ن",2,0],["إنْ دار دار فَلَكاً أو حلَّ حل","لَ جبلا أو سار سار مثلا",135,"ل",2,0],["إِن دامَ ذا مِنهُ خَلَّيتُ المُدامَ وَلا","أَضحى حَزيناً إِذا أَمسَيتُ مَسرورا",136,"ر",2,0],["أَنداؤُنا يَقَقٌ وَدُرُّ","وَنَباتُنا ميناً وَتِبرُ",137,"ر",1,1],["إن دين الإسلام كالشمس فينا","كل عصر بهديه مستنير",138,"ر",1,0],["إن دنياك هذه","لستَ فيها بخالد",139,"د",1,0],["إنْ دَهاكَ الزَّمانُ يوماً بخَطْبٍ","مِلْ إلَيْنَا والْقِ الحُمولَ عَلَيْنَا",140,"ن",2,0],["أندى المُلوكِ يداً وأشرفُهُم أباً","وأبرُّهُم للمُذنِبين وأصفحُ",141,"ح",1,0],["أندى الملوكِ يَداً وأكرمُهُم أباً","وأبرُّهُم للمُسلمينَ وأرفَقُ",142,"ق",1,0],["أندى الملوك وجوهاً غير أنهم","ترضى المواضي بأيدهم إذا غضبوا",143,"ب",3,0],["أندى الملوك يداً وأكرم دوحة","وأتم أغصاناً وأشرف آلا",144,"ل",2,0],["اِندُبي خَيرَ مَن بَرا اللَهُ في الدُن","يا وَمَن خَصَّهُ بِوَحيِ السَماءِ",145,"ا",2,0],["إِن دافَعوا لَم يُعَب دفاعُهُمُ","أَو سابَقوا نَحوَ غايَةٍ أُولَوا",146,"ل",3,1],["إنّ داءً أودى بمن كان للعا","لَمِ داءً لسَيِّدُ الأوجاعِ",147,"ع",1,0],["إن ديني وملتي واعتقادي","حب سلمى وزينب وسعاد",148,"د",1,1],["إِنّ دِينَ الإِسلام مَنَّ على الخل","ق وأَنتَ الذي على الدِّين منَّا",149,"ن",2,0],["إِنْ دَامَ هَذا التَّجنِّي مِنْكَ والغَضَبُ","فَلا تَسَلْ عَنْ فُؤَادِي كَيْفَ يَلْتَهِبُ",150,"ب",1,1]]}