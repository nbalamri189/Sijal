به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[231,"قبلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79171&r=&rc=45",""]],"verses":[["بَلَّت مَفارِقَهُم دَماً وَلَطالَما","عَرَفوا بِمِسكٍ فَوقَهُنَّ بَليلِ",0,"ل",1,0],["بَل تُهَنّا مَلابِسُ العِزِّ أَن أَب","قَيتَ فيها نَشراً وَأَعبَقتَ عَرفا",1,"ف",2,0],["بل تلك أرواح تضن بها","ومعاهد درست تشيدها",2,"د",3,0],["بِلَتْ مِنْكَ الوِزَارَةُ لَوْذَعِيّاً","حَكِيماً فِي الصَّلابَةِ وَاللِّيَانِ",3,"ن",1,0],["بَلْ تَعَالَيْ نَنْشُدُ كِلانَا وَكُونِي","خيْرَ عَوْنٍ لَصَبَّكِ المُسْتَهَامِ",4,"م",1,0],["بَلَّت بِهِ غَيرَ طَيّاشٍ وَلا رَعِشٍ","إِذ جُلنَ في مَعرَكٍ يُخشى بِهِ العَطَبُ",5,"ب",1,0],["بل ترى العين فيه كل جدار","تكره العين أن تراه جدارا",6,"ر",2,0],["بل تراها وأنتَ مُستدبرُ الظَّه","ر بقلبٍ مُصوَّرٍ من ذكاءِ",7,"ا",2,0],["بل تعامَيْتَ غير أعمى عن الحق","قِ نهاراً في ضَحوةٍ غرّاءِ",7,"ا",2,0],["بل تَصبَّرتُ وانتظرت من اللَّ","ه نآداً تُصيبه دَهْياءَ",8,"ا",2,0],["بل تَرُدُّ السَهام مُنكفئاتٍ","فتصيبُ القلوبَ غيرَ نوابِ",9,"ب",1,0],["بل تَنَاهٍ وهل صِبىً بعد قَوْل","جاء عن أمِّ عَمْرةٍ وسُعادِهْ",10,"د",2,0],["بل تستخف بما أعطاك قبضتُه","حتى يرى ألف قنطار كدينار",11,"ر",1,0],["بل ترقَّى إلى العلا طالبوها","وتدلَّى على العلا من معالي",12,"ل",2,0],["بل ترقَّى إلى العلا طالبوها","وتدلَّى إلى العلا من معالِ",13,"ل",1,0],["بل تناهيتُ مُكرهاً بتناهي ال","بيضِ عنِّي وما انتهتْ أعرامي",14,"م",2,0],["بل تغاضيتَ فيه عن حُرم اللَّ","ه فلم ترمِها بطرف شَفون",15,"ن",1,0],["بل تأوَّلتُ أن كل شريفَيْ","نِ بعيدي قَرابةٍ أخوان",16,"ن",1,0],["بل تدلَّيتَ عليها","من شماريخ قُدَيْدِ",17,"د",1,0],["بل تلك رقدة ميت لا انتباه له","الا اذا انكصت في الدور اكوان",18,"ن",1,0],["بَل تِلكَ سُبحَةُ لُؤلُؤٍ","تُحصى عَلَيكَ بِها الذُنوب",19,"ب",1,0],["بَل تَراهُم خُلِقوا مِن طينَةٍ","هَل سِوى لَحمٍ وَعَظمٍ وَعَصَب",20,"ب",1,0],["بَل تَعامَيتُ عَن ذُنوبِكَ خَوفاً","أَن أَرى فيكَ ذِلَّةَ الإِعتِذارِ",21,"ر",1,0],["بَل تَعَوَّدتُ أَن أُصَغَّرَ قَدري","لِصَديقي وَلا أُصَعَّرَ خَدّي",22,"د",2,0],["بَل تَوَهَّمتُ أَن تَعودَ إِلى الشا","مِ فَوافَيتُها عَلى سيواسِ",23,"س",1,0],["بَلَتْهُ المقاديرُ تلهو بهِ","وجرَّبَهُ الزَّمنُ الهازلُ",24,"ل",1,0],["بل تلك منزلةُ الصَّفِيِّ بَلَغتَها","فَوَفَى الرجاءُ وصَحَّ مِنكَ المَطمعُ",25,"ع",1,0],["بَلْ تَمَادَتْ عَلَى التَّجَاهُلِ آبَا","ءٌ تَقَفَّتْ آثَارِهَا الأَبناءُ",26,"ا",2,0],["بلتَ على ما فاتَها النّواظِرُ","إذْ جَعلتْ تَدُقُّها الحوافِرُ",27,"ر",1,0],["بل تاه جامد جرمها","أَو صادفت في السير ضدا",28,"د",2,0],["بل تَحْسَبُ العَنقاءَ أوْ بِنْتاً لها","نَبَذَتْ بها في الوَكْنِ يوْمَ رِجاعها",29,"ع",3,0],["بَلَتْ أَوْطَانُهُ مِنْهُ هُمَاماً","وَفِيَّ العَهْدِ مِسْمَاحاً نَبِيلاَ",30,"ل",2,0],["بل تلك أنثى من سلالةِ «مُصْطَفى»","هل بعد ذلك رِفْعةٌ وفَخَار؟",31,"ر",1,0],["بل تلك غرفتها أو تلك أيهما ؟","أو هذه ، وارتدت أزياءها الغرف",32,"ف",1,0],["بلْ ترى برقاً على ال","جَبَلَينِ يُعْجِبُني انجِيابُهْ",33,"ب",2,0],["بل تَنَاهٍ وهل صَبى ً بعد قَوْل","جاء من أمِّ عَمْرة ٍ وسُعادِهْ",34,"د",2,0],["بل تراها وأنت مستدبر الظ","ر بقلبٍ مُصوَّر من ذكاءِ",35,"ا",2,0],["بلت أياديه مغارسَ مجده","بالبذَل منه وهنَّ غير ظماءِ",36,"ا",2,0],["بلّت أياديه مغارس ملكه","حتى جرت بالماء في الأغصان",37,"ن",1,0],["بَلَّت قُتَيبَةُ في النِواءِ بِفارِسٍ","لا طائِشٍ رَعِشٍ وَلا وَقّافِ",38,"ف",1,0],["بَلَتْ دمشقُ بنيها يومَ محنتِها","فلمْ تجدْ غير مَنْ صحّتْ عقائده",39,"د",2,0],["بل تلفه عمد المحارب قوماً","للَه أكرم بالسجود الركع",40,"ع",1,0],["بل تقلدتها شغوراً بمرسو","م شريف وخلعة مسدوله",41,"ل",2,0],["بَلَّت بِسَيفٍ صارِمٍ يَداكا","ما لِمُلوكِ الأَرضِ مِثلُ ذاكا",42,"ك",2,0],["بل تأذىَّ من أن يدنس نعلي","ه بها ياله شرَّ جَانِ",43,"ن",1,0],["بلتْهُ فاصطفتهُ على يقينٍ","كما أنْبا عن السيفِ المَضاءُ",44,"ا",2,0],["بل تشكَّت ممَّا تدلُّ إليك الأ","رض ضعفاً فليس تسطيع حملا",45,"ل",2,0],["بل تزدهي بك كل مرتبة سمت","وبكل بغيتها تفوز وتظفر",46,"ر",1,0],["بَل تِلكَ عاطِفَةُ النَ