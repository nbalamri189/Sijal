{"poems":[[55,"أترى ديار الحي بال","https://www.aldiwan.net/poem29794.html","مجزوء الكامل"],[55,"لو صح أن البين يعشقه","https://www.aldiwan.net/poem29955.html","السريع"],[65,"ومكاشح نهنهته عن غاية","https://www.aldiwan.net/poem46081.html","الكامل"],[79,"هب النسيم معطر الأراج","https://www.aldiwan.net/poem36664.html","الكامل"],[9,"ودع هريرة إن الركب مرتحل","https://www.aldiwan.net/poem21969.html","البسيط"],[95,"سما مرامي وشطت","https://www.aldiwan.net/poem9151.html","المجتث"],[95,"طوقتموني بأطواق من المنن","https://www.aldiwan.net/poem9166.html","البسيط"],[95,"ما باله ما أصابه","https://www.aldiwan.net/poem11149.html","المجتث"],[32,"يا دار مية بالخلصاء فالجرد","https://www.aldiwan.net/poem29598.html","البسيط"],[74,"جسم سقيم لا يرام شفاؤه","https://www.aldiwan.net/poem18173.html","الكامل"],[74,"أذكى سنا البرق في أحشائه لهبا","https://www.aldiwan.net/poem18234.html","البسيط"],[74,"صيرت نومي مثل عطفك نافرا","https://www.aldiwan.net/poem18698.html","الكامل"],[87,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[87,"قف حي شبان الحمى","https://www.aldiwan.net/poem8085.html","مجزوء الكامل"],[87,"ظلم الرجال نساءهم وتعسفوا","https://www.aldiwan.net/poem63768.html","الكامل"],[30,"من كل ذات حبائك ومفاضة","https://www.aldiwan.net/poem5179.html","الكامل"],[82,"أإن بكت ورقاء في غضن بان","https://www.aldiwan.net/poem31262.html","السريع"],[82,"ملاعب البيض بين البيض والأسل","https://www.aldiwan.net/poem31322.html","البسيط"],[82,"الآن أفرخ روع كل مهيد","https://www.aldiwan.net/poem31473.html","الكامل"],[82,"جلا محياك عن أبصارنا الرمدا","https://www.aldiwan.net/poem31474.html","البسيط"],[82,"تفشي يداك سرائر الأغماد","https://www.aldiwan.net/poem31483.html","الكامل"],[46,"أصغى إلى البين مغترا فلا جرما","https://www.aldiwan.net/poem30366.html","البسيط"],[107,"ردوا بني قينقاع الأمر إذ نزلا","https://www.aldiwan.net/poem44215.html","البسيط"],[41,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[41,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[69,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54837","الكامل"],[105,"قف في ربوع المجد وابك الأزهرا","https://www.poetsgate.com/ViewPoem.aspx?id=1337",""],[98,"البحر والقمر","https://www.poetsgate.com/ViewPoem.aspx?id=17485",""],[41,"بانَ الخليطُ بسحرة ِ فتبدَّدوا","https://www.poetsgate.com/ViewPoem.aspx?id=4250",""],[119,"هذا كتاب منزل وزبور","https://www.aldiwan.net/poem41746.html","الكامل"],[137,"فتح مبين جل أن يتخيلا","https://www.aldiwan.net/poem4220.html","الكامل"],[147,"النجم أقرب من مداك منالا","https://www.aldiwan.net/poem11792.html","الكامل"],[154,"يهن الجزيرة منك أي حسام","https://www.aldiwan.net/poem68464.html","الكامل"],[190,"ومسائل حدب علي يقول لي","https://www.aldiwan.net/poem43564.html","الكامل"],[193,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[280,"سما بأمرك إسعاد وإنجاد","https://www.aldiwan.net/poem25589.html","البسيط"],[343,"ركبوا المراكب واغتدوا","https://www.aldiwan.net/poem68729.html","مجزوء الكامل"],[358,"لا تعتب الوغد اللئيم إذا أسا","https://www.aldiwan.net/poem40167.html","الكامل"],[358,"جلت لنا هذه الآداب والصور","https://www.aldiwan.net/poem40190.html","البسيط"],[369,"خفض عليك وإن أطلت تأملا","https://www.aldiwan.net/poem60805.html","الكامل"],[371,"شوقا إلى ذاك الجلال ومجتنى","https://www.aldiwan.net/poem17166.html","الكامل"],[438,"تنفس الروض عن نواره الأرج","https://www.aldiwan.net/poem12315.html","البسيط"],[445,"كسيت بدولتك اليالي نورا","https://www.aldiwan.net/poem34851.html","الكامل"],[469,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[469,"وأغن ساجي الطرف أغيد","https://www.aldiwan.net/poem3324.html","عموديه"],[482,"قد خان أهل الهوى قل لي بمن أثق","https://www.aldiwan.net/poem15254.html","البسيط"],[520,"قد كان حبي محض","https://www.aldiwan.net/poem12302.html","المجتث"],[543,"عفوا إذا أكثرت من إنشادي","https://www.aldiwan.net/poem48209.html","عموديه"],[543,"لله أيام مع الأحباب","https://www.aldiwan.net/poem48291.html","عموديه"],[549,"بايعت ذكراك","https://www.aldiwan.net/poem67252.html","عموديه"],[563,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[591,"أرح يمينك مما أنت معتقل","https://www.aldiwan.net/poem17644.html","البسيط"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88624","الكامل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/67015","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38278","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37998","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70905","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70681","البسيط"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202076","الكامل"],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/126597","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109123","الكامل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137861",""],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108958","الكامل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141280","البسيط"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141332","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49558","البسيط"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118430","البسيط"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67203","البسيط"],[2441,"","https://poetry.dctabudhabi.ae/diwan/poem/73687","الكامل"],[2521,"","https://poetry.dctabudhabi.ae/diwan/poem/110668","البسيط"],[2521,"","https://poetry.dctabudhabi.ae/diwan/poem/110658","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93819","الرجز"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100368","الكامل"],[2934,"","https://poetry.dctabudhabi.ae/diwan/poem/205198","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100804","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87479","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89152","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110110","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216748","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117947","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102983","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102929","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102986","الكامل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29307","البسيط"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75714","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119633","الرجز"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136935",""],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102753","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90822","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90863","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73169","الكامل"],[4330,"","https://poetry.dctabudhabi.ae/diwan/poem/122967","البسيط"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28618","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141664","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141652","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120219","السريع"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35139","الكامل"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102017","البسيط"],[4927,"عودة العيد","https://www.poetsgate.com/ViewPoem.aspx?id=4584",""],[4119,"يا سعد ما أحسنها شمائلا","https://www.poetsgate.com/ViewPoem.aspx?id=16208",""],[5205,"غزاة عينيك حاربت كبدي","https://www.poetsgate.com/ViewPoem.aspx?id=120992",""],[5267,"من كل ذات روادف","https://www.poetsgate.com/ViewPoem.aspx?id=109427",""],[5970,"خدعوا الزمان لياليا فما بهم","https://www.poetsgate.com/ViewPoem.aspx?id=130662",""],[4442,"يبدو الشباب بشكل الخرد العين","https://www.poetsgate.com/ViewPoem.aspx?id=171001",""]],"verses":[["مِن كُلِّ ذي خُصَلٍ مُرا","حِ السَوطِ مَكدودِ اللِجامِ",0,"م",1,0],["مِن كُلِّ ذَيّالِ السَبيبِ رَمى","بِيَدَيهِ أُولى النَقعِ أَولَقُهُ",1,"ق",2,0],["مِنْ كُلِّ ذي حَسَبٍ نَمَتْهُ حُرَّةٌ","غَرَّاءُ لاحَ العِتْقُ فَوْقَ جَبينِها",2,"ن",3,0],["منْ كلِّ ذي طِمْرَينِ أشْعَثَ أغْبَرٍ","عبِثَت بشَمْلَتِهِ يَدُ الإنْهاجِ",3,"ج",1,0],["مِن كُلِّ ذَلِكَ يَومٌ قَد لَهَوتُ بِهِ","وَفي التَجارِبِ طولُ اللَهوِ وَالغَزَلُ",4,"ل",1,0],["من كل ذات غراس","فتانةٍ خلابه",5,"ب",2,0],["من كل ذي نسبٍ أو كل ذي حسبٍ","ما في مصادره من مصدرٍ أسن",6,"ن",1,0],["مِنْ كُلِّ ذَاتِ غِرَاسٍ","وَكُلِّ ذَاتِ عِشَابَهْ",7,"ب",2,0],["مِن كُلِّ ذي لَجَب باتَت بَوارِقُهُ","تَجلو أَغَرَّ المَعالِي حالِكَ النَضَدِ",8,"د",1,0],["من كلِّ ذي نسبٍ سمت أعراقه","يوم العلا واستبطحت بطحاؤه",9,"ا",3,0],["من كلِّ ذي قلمٍ أمست مضارِبهُ","سيفاً لدولةِ ملكٍ يدفعُ النوبا",10,"ب",2,0],["من كل ذي عرض يصفى جوهراً","فاعجب لأعراض تكون جواهرا",11,"ر",2,0],["من كل ذي قلب بطل","لجّنة الأرض وصل",12,"ل",1,0],["مِن كُلِّ ذاتِ إِشارَةٍ","لَيسَت عَلَيهِم خافِيَه",13,"ي",2,0],["مِن كُلِّ ذي سَبعينَ يَكتُمُ شَيبَهُ","وَالشَيبُ في فَودَيهِ ضَوءُ نَهارِ",14,"ر",1,0],["مِن كُلِّ ذاتِ حَبائِكٍ وَمُفاضَةٍ","بَيضاءَ سابِغَةٍ عَلى الأَظفارِ",15,"ر",1,1],["من كلّ ذئبٍ أو عُقابٍ له","كلَّ مكرٍّ فيه شلوٌ خِوَان",16,"ن",1,0],["مِن كلِّ ذي ميعةٍ كالبحرِ تَحسبُ منْ","أزبادِهِ سُرِدَتْ ماذيَّةُ البطلِ",17,"ل",1,0],["مِنْ كُلِّ ذي سَكَرينِ مِن خَمرٍ ومِن","حَدٍّ لِذي فَتكٍ عَلَيهِ مُعَربِدِ",18,"د",1,0],["مِن كُلِّ ذِمْرٍ منَ الفولاذِ غاصَ به","يُجَمّدُ القَرُّ مِنهُ فَوقَهُ زَبَدا",19,"د",2,0],["مِن كلّ ذِمْرٍ في الكَريهَةِ مُقْدِمٍ","صَالٍ لِحَرّ سَعيرها الوقّادِ",20,"د",1,0],["مِن كُلِّ ذي زَبَدٍ عَلَتهُ سُفْنُهُ","يَخْرُجْنَ من جَسَدٍ بِغَيرِ فُؤادِ",20,"د",1,0],["مِن كُلِّ ذي لِمَّةٍ غَطَّت ضَفائِرُها","صَدرَ القَناةِ فَقَد كادَت تُرى عَلَما",21,"م",2,0],["مِن كل ذي سَغَبٍ لو قال واجدُه","كُلْنِي ليعلمَ ما في نفسهِ أُكلا",22,"ل",2,0],["مِن كُلِّ ذي ذَنَبٍ يُرى","بِخُدودِهِ وَشمُ الأَنامِل",23,"ل",1,0],["مِن كُلِّ ذاقِنَةٍ يَقومُ زِمامُها","عَومَ الخِشاشِ عَلى الصَفا يَتَرَأَّدُ",24,"د",1,0],["مِنْ كلِّ ذِمْرٍ كالصَّبَاحِ جَبِينُه","ذَرِبٌ بِخَوْضِ المُعْضِلاتِ مُعَوَّدِ",25,"د",1,0],["مِنْ كُل ذِي نُبلٍ وَذِي فَضْلٍ وَذِي","أَدَبٍ بِهِ تَتَنَادَمُ السُّمَّارُ",26,"ر",1,0],["من كل ذي حجرٍ لخير بلاده","رسم المكيدة للدخيل ودبَّرَا",27,"ر",2,0],["من كلذ حواء مثلما خلقت","يعجب منها الحرير والوبر",28,"ر",1,0],["منْ كلِّ ذاقنة ، يعومُ زمامُها","عومَ الخشاشِ علَى الصَّفا يترأَّدُ",29,"د",1,0],["من كل ذمر في العرمرم صائل","مثل العقاب جناحه منشور",30,"ر",1,0],["من كل ذمرٍ يمتطي من طرفِهِ","بحراً ويحملُ في الحمائلِ جدولا",31,"ل",2,0],["مِن كُلِّ ذي سَيفٍ يَقِلُّ نِجادُهُ","عَن أَن يَكونَ لِما اِحتَذَيتَ قِبالا",32,"ل",2,0],["من كلِّ ذمر حنكته يد الوغى","فرأيت رأى الكهل سنَّ غلام",33,"م",1,0],["من كل ذي أدب عليم فاضل","حسن الخلائق طاهر الأعراق",34,"ق",1,0],["مِن كلِّ ذاتِ نسبةٍ علياءَ","شَريفة الجدّين ذات مجدِ",35,"د",1,0],["من كُلِّ ذي لَجبٍ في صَوْلِ ذي غضَبٍ","كالبحرِ يُغريهِ بالإزْبادِ إِزْبادُ",36,"د",1,0],["مِن كُلِّ ذي أَدَبٍ وَمَع","رِفَة وَآراءٍ حَصيفَه",37,"ف",2,0],["مِن كُلّ ذي جسم تَراهُ جرافسا","وَتَخالهُ عِندَ الوُثوب حبرقسا",38,"س",2,0],["مِن كُلِّ ذاتٍ وَمَعنىً قَد حَوى حكما","مَن فاتَهُ العين مِنها نالَهُ الأَثَرُ",39,"ر",1,0],["من كلِّ ذي مَرَحٍ يُلاعِبُ عِطْفَهُ","ويَهُمُّ من جَنْبَيْهِ أن يَتَسَلّلا",40,"ل",2,0],["مِن كُلِّ ذي وَجهٍ كَقِدْرٍ فَوقَهُ","شَفَةٌ كَأُذنِ القِدرَةِ المَكبوبَةِ",41,"ه",1,0],["من كُلِّ ذي جَوْهَرٍ ما زالَ مُنْتَظِماً","لِلْقِرْنِ في لَبَّةٍ منه وفي وَدَجِ",42,"ج",1,0],["من كل ذِي مُلْكٍ نَمَوْكَ فأَنْجَبُوا","بدراً لفخْرِهِمُ المنيرِ مُنِيرا",43,"ر",2,0],["من كلِّ ذمرٍ لا يباح ذمارهُ","بذلوه وهو معفَّر في بيدها",44,"د",3,0],["من كلّ ذمرٍ فوق سابقه","الهزبر على الخفيدد",45,"د",1,0],["مِن كلَّ ذي غَبَنٍ منهمْ وذي قِحَةٍ","يُلقيهما المُرديانِالجهلُ والحَنَقُ",46,"ق",1,0],["من كل ذات قوام","مجدولة كالعنان",47,"ن",1,0],["مِن كلِّ ذي أدبٍ تفَتَّقَ نُورُه","فأتَى كنظمِ الدُّرِّ في الأجيَاد",48,"د",1,0],["مِن كُلِّ ذي أدَبٍ يَدلُّ جبينُه","عمَّالَهُ مِن رقَّةِ الآدابِ",49,"ب",1,0],["مِنْ كلِّ ذاكَ الدُّج