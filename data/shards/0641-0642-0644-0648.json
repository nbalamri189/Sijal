{"poems":[[77,"بلد قد غزاه صرف الليالي","https://www.aldiwan.net/poem36639.html","الخفيف"],[44,"قلبت أمري في بدء وفي عقب","https://www.aldiwan.net/poem30054.html","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54286","الطويل"],[109,"مولاي زر متفضلا","https://www.aldiwan.net/poem16315.html","مجزوء الكامل"],[128,"أيها العاقل الذي شاء تزو","https://www.aldiwan.net/poem50678.html","الخفيف"],[197,"حي الأساتذة الكرام تحية","https://www.aldiwan.net/poem39949.html","الكامل"],[225,"إذا فتح العداة عليك حربا","https://www.aldiwan.net/poem55187.html","الوافر"],[270,"أدمشق ما أمضى سيوف بنيك","https://www.aldiwan.net/poem35644.html","الكامل"],[271,"إذا عهدوا فليس لهم وفاء","https://www.aldiwan.net/poem52095.html","البسيط"],[377,"ألا إحذر ملاقاة الرزايا","https://www.aldiwan.net/poem59170.html","الوافر"],[458,"ليتها إذ منعت ماعونها","https://www.aldiwan.net/poem55830.html","الرمل"],[458,"يذنب دهر ويستقيل","https://www.aldiwan.net/poem55932.html","مخلع البسيط"],[538,"في ذمة المولى العلى الشان","https://www.aldiwan.net/poem47921.html","عموديه"],[551,"من رأى الأظعان فوق","https://www.aldiwan.net/poem47903.html","مجزوء الرمل"]],"verses":[["فَقُلوبُ النّجومِ تَخْفِقُ وَجْداً","وعُيونُ السّحابِ حُزْناً تَفوحُ",0,"ح",1,0],["فَقُل وَراءَكَ في سُحقٍ وَفي بُعُدٍ","فَإِنَّني فيكَ أَهلُ السُحقِ وَالبُعُدِ",1,"د",1,0],["فقلْ وانثُرِ الأزهارَ فوق مناقبٍ","تماثلُها حُسناً وتشبهُها شَمّا",2,"م",2,0],["فَقُلوبُنا وَعُيونُنا","في الطُرق قَد فَرَشَت لِوَعدك",3,"ك",1,0],["فقُلوب الورَى تُقِّلبُها الآراء","حيناً كَريشَةٍ في الفضاءِ",4,"ا",2,0],["فقلوبُنا للَهِ والأجسامُ","للغَبراِْ والأرواحُ للأوطانِ",5,"ن",1,0],["فَقُل وَاِرفَع عَقيرَةَ من يُنادي","فلا يجِدُ المؤازِرَ وَالمُعينا",6,"ن",2,0],["فقُلُوبهم وقلوبُهنَّ كبيرةٌ","تلكَ القلوبُ من الخُطوبِ تقيك",7,"ك",1,0],["فقل واشفع تَرى كرما وَمجدا","وَسل تعطى فَشيمَتنا العطاء",8,"ا",2,0],["فقل وثناك يُسفرُ عن كمال","أنا ابن جلا وطلّاع الثنايا",9,"ا",3,0],["فقلوبٌ حزتَ لي شَنْآنها","ولحاظٌ قُدتَ لي مشفونَها",10,"ن",3,0],["فقلْ وإن نال من أناس","في حسد المجد ما تقولُ",11,"ل",1,0],["فَقُلوبُنا مُلِئَت عليه كَآبةً","وعُيُونُنا رَيَّانَةُ الأَجفانِ",12,"ن",1,0],["فقلوبٌ حَرِجاتٌ","هنَّ في ذا اليومِ فِيحُ",13,"ح",1,0]]}