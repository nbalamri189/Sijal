{"poems":[[79,"بلد قد غزاه صرف الليالي","https://www.aldiwan.net/poem36639.html","الخفيف"],[46,"قلبت أمري في بدء وفي عقب","https://www.aldiwan.net/poem30054.html","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54286","الطويل"],[113,"مولاي زر متفضلا","https://www.aldiwan.net/poem16315.html","مجزوء الكامل"],[132,"أيها العاقل الذي شاء تزو","https://www.aldiwan.net/poem50678.html","الخفيف"],[201,"حي الأساتذة الكرام تحية","https://www.aldiwan.net/poem39949.html","الكامل"],[230,"إذا فتح العداة عليك حربا","https://www.aldiwan.net/poem55187.html","الوافر"],[275,"أدمشق ما أمضى سيوف بنيك","https://www.aldiwan.net/poem35644.html","الكامل"],[276,"إذا عهدوا فليس لهم وفاء","https://www.aldiwan.net/poem52095.html","البسيط"],[382,"ألا إحذر ملاقاة الرزايا","https://www.aldiwan.net/poem59170.html","الوافر"],[463,"ليتها إذ منعت ماعونها","https://www.aldiwan.net/poem55830.html","الرمل"],[463,"يذنب دهر ويستقيل","https://www.aldiwan.net/poem55932.html","مخلع البسيط"],[543,"في ذمة المولى العلى الشان","https://www.aldiwan.net/poem47921.html","عموديه"],[556,"من رأى الأظعان فوق","https://www.aldiwan.net/poem47903.html","مجزوء الرمل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138253",""],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137348",""],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54051","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63723","الهزج"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115988","الخفيف"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77766","الكامل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102509","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94321","الرجز"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104674","الوافر"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132541","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48292","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48305","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91799","الكامل"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111043","الكامل"],[4142,"","https://poetry.dctabudhabi.ae/diwan/poem/101332","الطويل"],[5111,"أنتنَّ","https://www.poetsgate.com/ViewPoem.aspx?id=212051",""],[5561,"المجد","https://www.poetsgate.com/ViewPoem.aspx?id=205111",""],[5650,"ما غيره نحب","https://www.poetsgate.com/ViewPoem.aspx?id=131225",""],[5701,"أهلا بمقدمك العظيم وأكرم","https://www.poetsgate.com/ViewPoem.aspx?id=164676",""],[5701,"أشرق الليل بنور العرس","https://www.poetsgate.com/ViewPoem.aspx?id=164688",""],[5957,"الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=56335",""],[5975,"أهلاً بأمير الشهور","https://www.poetsgate.com/ViewPoem.aspx?id=53263",""]],"verses":[["فَقُلوبُ النّجومِ تَخْفِقُ وَجْداً","وعُيونُ السّحابِ حُزْناً تَفوحُ",0,"ح",1,0],["فَقُل وَراءَكَ في سُحقٍ وَفي بُعُدٍ","فَإِنَّني فيكَ أَهلُ السُحقِ وَالبُعُدِ",1,"د",1,0],["فقلْ وانثُرِ الأزهارَ فوق مناقبٍ","تماثلُها حُسناً وتشبهُها شَمّا",2,"م",2,0],["فَقُلوبُنا وَعُيونُنا","في الطُرق قَد فَرَشَت لِوَعدك",3,"ك",1,0],["فقُلوب الورَى تُقِّلبُها الآراء","حيناً كَريشَةٍ في الفضاءِ",4,"ا",2,0],["فقلوبُنا للَهِ والأجسامُ","للغَبراِْ والأرواحُ للأوطانِ",5,"ن",1,0],["فَقُل وَاِرفَع عَقيرَةَ من يُنادي","فلا يجِدُ المؤازِرَ وَالمُعينا",6,"ن",2,0],["فقُلُوبهم وقلوبُهنَّ كبيرةٌ","تلكَ القلوبُ من الخُطوبِ تقيك",7,"ك",1,0],["فقل واشفع تَرى كرما وَمجدا","وَسل تعطى فَشيمَتنا العطاء",8,"ا",2,0],["فقل وثناك يُسفرُ عن كمال","أنا ابن جلا وطلّاع الثنايا",9,"ا",3,0],["فقلوبٌ حزتَ لي شَنْآنها","ولحاظٌ قُدتَ لي مشفونَها",10,"ن",3,0],["فقلْ وإن نال من أناس","في حسد المجد ما تقولُ",11,"ل",1,0],["فَقُلوبُنا مُلِئَت عليه كَآبةً","وعُيُونُنا رَيَّانَةُ الأَجفانِ",12,"ن",1,0],["فقلوبٌ حَرِجاتٌ","هنَّ في ذا اليومِ فِيحُ",13,"ح",1,0],["فقلوبنا ظمئت إليه ولا ظما","أحشا العطاش إلى الزلال وورده",14,"د",2,0],["فقلوبُ الورى إلى السلمِ ظمأَى","وهي تصبو إلى وئامِ اكيد",15,"د",1,0],["فقلوبنا للخوف جم خفقها","وجفوننا للدمع ما إن تطرف",16,"ف",1,0],["فقلْ وانشرْ فَنشْرُ القو","لِ نَشْرٌ ليس كالنَّشْرِ",17,"ر",1,0],["فقلُوبُ الأنامِ فى كلِّ يومٍ","من لِحاظ العيونِ فى أوجالِ",18,"ل",1,0],["فَقلوبنا ما بين مفتون بها","أَو واله بجمالها مبهوت",19,"ت",1,0],["فقلوبنا قد أسقيت","نهل للذنوب وعلها",20,"ل",3,0],["فقل وجود الله يا ابن آدم","دليله حدوث هذا العالم",21,"م",1,0],["فَقُل وَاِشفَع تَرى كَرَماً وَمَجداً","لَدَينا لَم يَكُن لَهُما اِنتِهاءُ",22,"ا",2,0],["فقلوبهم زبر الحديد","ومجدهم سبك الذهب",23,"ب",1,0],["فقلوبُنا لوْلا التعلّلُ بالمُنى","لأحَلّها طولُ التسوُّفِ رَمْسَها",24,"س",3,0],["فقلوبُ أهْليها يُقلِّبُها الجَوى","لمّا تحامَى بالبِعادِ حِماها",25,"ا",3,0],["فَقلوبهم غلفٌ ودينُهم الخنا","وَوِدادُهم أَمرٌ يغرُّ وَينسخ",26,"خ",1,0],["فقلوب أهل الود شب بها الجوى","ولهم كمفصول الفصيل رغاء",27,"ا",2,0],["فقل ويك للارزاء كفي عن الورى","فقد بلغت بالرغم منها مرامها",28,"م",3,0],["فَقُلُوبُنَا نَحْنُ النِّسَا عِشْقُ الْمُنَى","رِفْقًا بِنَا يَا أيُّهَا الشُّعَراءُ",29,"ا",2,0],["فقلوبُنا ملآنةٌ كسمائنا","دفءً يَعُمُّ وطيبةٌ تتجسّدُ",30,"د",1,0],["فَقُلُوبُنا فُطِرَتْ عَلى حُبٍّ سَما","حُبِّ النُّفُوسِ وَفَوقَها حُبُّ النَّبِي",31,"ي",1,0],["فقلوبنا من حولكم خفاقة","رفافة مثل الطيور الحوم",32,"م",1,0],["فقلوب الناس أنى سرتم","أو حللتم حولكم كالحرس",33,"س",1,0],["فَقلوبنا اشتدت مواجعها","ومراكب الأشواق كالحممِ",34,"م",2,0],["فقلوبنا .. أرواحُنا .. ونفوسُنا","سكرى بكأس ٍ منكَ دنِّ خمورِ",35,"ر",1,0]]}