{"poems":[[24,"كأن امرأ لم يلق عيشا بنعمة","https://www.aldiwan.net/poem21899.html","الطويل"],[90,"سأبدي لدهري ناج المتضحك","https://www.aldiwan.net/poem45011.html","الطويل"],[90,"من أين من أين يا ابتدائي","https://www.aldiwan.net/poem45073.html","مخلع البسيط"],[91,"فجع المشرقين خطب جليل","https://www.aldiwan.net/poem44704.html","الخفيف"],[63,"وبيت خلا من كل خير فناؤه","https://www.aldiwan.net/poem51323.html","الطويل"],[60,"أمن بعد تكفين النبي ودفنه","https://www.aldiwan.net/poem31202.html","الطويل"],[51,"لشتان ما بين المخافة والأمن","https://www.aldiwan.net/poem63156.html","الطويل"],[46,"فحواك عين على نجواك يا مذل","https://www.aldiwan.net/poem30389.html","البسيط"],[76,"أنعم فقد هبت النعامى","https://www.aldiwan.net/poem13233.html","مجزوء البسيط"],[52,"لحى الله حماد بن نهيا فإنه","https://www.aldiwan.net/poem63895.html","الطويل"],[52,"ألا من لمطروب الفؤاد عميد","https://www.aldiwan.net/poem63957.html","الطويل"],[48,"حياتي بعد الأربعين منية","https://www.aldiwan.net/poem22323.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54862","المنسرح"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54223","البسيط"],[215,"أين قلبي وأين آثار قلبي","https://www.aldiwan.net/poem46575.html","الخفيف"],[266,"أراحمة قلبي وقد شفني الصبر","https://www.aldiwan.net/poem38281.html","الطويل"],[280,"طنب قبابك هذا العز والشرف","https://www.aldiwan.net/poem25479.html","البسيط"],[280,"ما للهوى إلا الرصافة مأرب","https://www.aldiwan.net/poem25635.html","الكامل"],[308,"أفي كل يوم منك عتب يسوءني","https://www.aldiwan.net/poem58314.html","الطويل"],[310,"أمولاي والآمال تستعبد الحرا","https://www.aldiwan.net/poem56546.html","الكامل"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[353,"ولم ير في مجلس شاعران","https://www.aldiwan.net/poem20427.html","المتقارب"],[369,"قسما لقد رجع النسيم عليلا","https://www.aldiwan.net/poem60803.html","الكامل"],[416,"صحا بعد جهل فاستراحت عواذله","https://www.aldiwan.net/poem67474.html","الطويل"],[416,"أعادك من ذكر الأحبة عائد","https://www.aldiwan.net/poem67515.html","الطويل"],[422,"رمينا بأدهى المعضلات النوائب","https://www.aldiwan.net/poem54172.html","الطويل"],[438,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[457,"لعينيك في الأحشاء ما نفث السحر","https://www.aldiwan.net/poem13762.html","الطويل"],[503,"يا راكضاً في طلاب دنيا","https://www.aldiwan.net/poem3693.html","مخلع البسيط"],[519,"لا بر في الحب يا أهل الهوى قسمي","https://www.aldiwan.net/poem20785.html","البسيط"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104111","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63874","المنسرح"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129518","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16795","الهزج"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95559","الرمل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35796","البسيط"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48936","الخفيف"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126639","الرمل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69435","الوافر"],[2165,"","https://poetry.dctabudhabi.ae/diwan/poem/20437","الطويل"],[2215,"","https://poetry.dctabudhabi.ae/diwan/poem/121498","الطويل"],[2336,"","https://poetry.dctabudhabi.ae/diwan/poem/202319","الوافر"],[2405,"","https://poetry.dctabudhabi.ae/diwan/poem/27107","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93657","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205009","الخفيف"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66416","الكامل"],[3687,"","https://poetry.dctabudhabi.ae/diwan/poem/200314","الوافر"],[3708,"","https://poetry.dctabudhabi.ae/diwan/poem/123835","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[4030,"","https://poetry.dctabudhabi.ae/diwan/poem/20879","المنسرح"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117209","الوافر"],[4488,"","https://poetry.dctabudhabi.ae/diwan/poem/131004","الرجز"],[4692,"يبيع الأرض منحط وواطي","https://www.poetsgate.com/ViewPoem.aspx?id=210624",""],[4802,"طفولة","https://www.poetsgate.com/ViewPoem.aspx?id=34304",""],[5145,"أنّى اهتديت لنا يا طيفها الساري","https://www.poetsgate.com/ViewPoem.aspx?id=108208",""],[5190,"الناعقون","https://www.poetsgate.com/ViewPoem.aspx?id=153357",""],[5770,"هذي الملايين حقًا أمة العربِ","https://www.poetsgate.com/ViewPoem.aspx?id=178708",""],[5815,"عَلمْ","https://www.poetsgate.com/ViewPoem.aspx?id=192033",""],[5823,"دثريني بالود","https://www.poetsgate.com/ViewPoem.aspx?id=61382",""],[5829,"ونرجوا في أماسينا سرورا","https://www.poetsgate.com/ViewPoem.aspx?id=165997",""],[5969,"يُسَلينا التَفَكُرُ في المُحالِ","https://www.poetsgate.com/ViewPoem.aspx?id=198976",""],[6052,"نحتُّ الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=50324",""],[6144,"سي المجلس البلدي","https://www.poetsgate.com/ViewPoem.aspx?id=21836",""],[2336,"جلست غديَّة وأَبو عقيل","https://www.poetsgate.com/ViewPoem.aspx?id=52746",""],[6277,"إبراهيم طوقان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64464&r=&rc=27",""]],"verses":[["كَأَنَّ اِمرِأً لَم يَلقَ عَيشاً بِنِعمَةٍ","إِذا نَزَلَت بِالمَرءِ قاصِمَةُ الظَهرِ",0,"ر",1,1],["كأنا من الدنيا ببيت تقامر","حَوى من سهام القَمر كلّ مُدَمْلَك",1,"ك",1,0],["كأن أم النجوم سيف","سلّ على الليل ذو مضاء",2,"ا",2,0],["كان اما رفعت طرفاً اليه","يرجع الطرف عنه وهو كليل",3,"ل",1,0],["كأنا مع الجدران في جنباته","دمى في انقطاع الرزق لا في المحاسن",4,"ن",1,0],["كَأَنَّ أُمورَ الناسِ بَعدَكَ ضُمِّنَت","سَفينَةُ مَوجٍ حينَ في البَحرِ قَد سَما",5,"ا",1,0],["كَأَنَّ امرَأً لَم يَغنَ في الناسِ ساعَةً","إِذا نُفِضَت عَنهُ الأَكُفُّ مِنَ الدَفنِ",6,"ن",1,0],["كَأَنَّ أَموالَهُ وَالبَذلُ يَمحَقُها","نَهبٌ تَعَسَّفَهُ التَبذيرُ أَو نَفَلُ",7,"ل",1,0],["كَأَنَّ أُمّاً بِها رَؤوماً","تَحضُنُ مِن شَربِها يَتامى",8,"م",2,0],["كَأَنَّ أَميراً قَد سَطا بِاِبنِ سالِمٍ","فَقولا لِمَصّانِ اِمسَح اِستَكَ وَاِنجَرِد",9,"د",1,0],["كَأَنَّ أَميراً جالِساً في حِجابِها","تُؤَمِّلُ رُؤياهُ عُيونُ وُفودِ",10,"د",1,0],["كَأَنّا مِنَ الأَيّامِ فَوقَ رَكائِبٍ","إِذا قيدَت الأَنضاءُ فَهِيَ تَقودُ",11,"د",1,0],["كَانَ أَمْرُ الأَوْقَافِ نُكْراً وَبِالأوْ","قَافِ دَاءٌ مِنَ الجُمُودِ عُقَامُ",12,"م",1,0],["كَانَ إِمْراً شَأْنُهُمُ مِنْ جَهْلِهِمْ","وَقدِيماً كَانَ شَأْنُ الْجَهْلِ إِمْرَا",13,"ر",2,0],["كَأَنَّ أَمْوَاجَهُمْ بِجُهْرَتِهَا","هَزِيزَ مهدٍ لِذلِكَ الْفِكْرِ",14,"ر",1,0],["كَأَنَّ أمْدَاحَهُ في أُذْنِ سَامِعِهَا","مَسَاقِطُ الشَّهْدِ مِنْ أعْوَادِ مُشْتَارِ",15,"ر",1,0],["كان أمر الهوى غيوماً وصحواً","أين صحوى وأين أين غيومي",16,"ي",1,0],["كان امتداد الأفق ارض لقايس","بكف الثريا مد في درعها شبر",17,"ر",1,0],["كأن امتداد النسر فيها جناحه","يروم به عوناً لواقعه جسر",17,"ر",1,0],["كأن اماني معتفيها على ظما","وانعامها الارض الجديبة والقطر",17,"ر",1,0],["كَأَنَّ أَمْواجَهُ الأَبْطَالُ دَارِعَةً","كَرَّت تُلاقِي وَلا بِيضٌ وَلا جُحَفُ",18,"ف",1,0],["كانا مراداً للنّعيم وَمَوْرِداً","إذْ كُنْت بَيْنَهُما أجيءُ وأذهَبُ",19,"ب",1,0],["كأن أمانيها كؤوس مدامة","غدا ونمير الماء غير محلل",20,"ل",1,0],["كأنّ أماني العالَمين تَزاحَمَت","عَلى نطقِهِ لُطفاً وفي وَجههِ بشرا",21,"ر",2,0],["كَأَنَّ أَمعاءَهُم لَفَتَ عَلى حَربِ","وَلَم تَزَل رَغمَهُم في الدَهرِ وَالحِقَبِ",22,"ب",1,0],["كَأَنَّا مَصَادرُ عِندَ الوَرَى","فَليسَ تُثنَّى ولا تُجمَعُ",23,"ع",1,0],["كانا معاً في وَجْهِ دينِ مُحمّدٍ","والدّهرُ يُصبِحُ للعُهودِ مُحيلا",24,"ل",2,0],["كَأَنَّ أَميرَ المُؤمِنينَ مُحَمَّداً","أَبو جَعفَرٍ في كُلِّ أَمرٍ يُحاوِلُه",25,"ل",2,0],["كَأَنَّ أَميرَ المُؤمِنينَ مُحَمَّداً","لِرَأفَتِهِ بِالناسِ لِلناسِ والِدُ",26,"د",1,0],["كأنَّا من الآجال وهي كواسر","من الأسد الضرغام بين المخالب",27,"ب",1,0],["كَأَنَّا من تَسَحُّبِنَا عليها","روادِفُ تستطيلُ على خُضورِ",28,"ر",1,0],["كأنَّ امتدادَ الأفق فوق نجومه","قَساطل حرب زُغْف فرسانها نُضر",29,"ر",1,0],["كَأَنَّ آمالنا ظِباءٌ","وَنَحنُ مِن حيرَة خِراشُ",30,"ش",1,0],["كأنّ أمَّ نُجومِ الأفقِ ما وَلدَتْ","أُنثى ولا ذَكراً إلّا بحيّهمِ",31,"م",1,0],["كأنّا من الإجلال تحتَ عمايةٍ","نُطاطي لها بالرُّعبِ كُلّ الأحاينِ",32,"ن",1,1],["كأَنَّ أَمواجَهُ إذا ارتكضَتْ","في حافتيه خيلٌ كراديسُ",33,"س",1,0],["كأن أماليه الرياض ثمارها","الدراري وللأقلام صوت المغرد",34,"د",1,0],["كَأَنّا مِنهُ في هَرجٍ","وَلَسنا مِنهُ في هَرجِ",35,"ج",1,0],["كان آمالا لأَهل أنفقوا","كل غالٍ كي يصونوا الجوهَرا",36,"ر",2,0],["كَأَنَّ أَمطارَهُ تَوالَت","مِن عابِرِ العَيرَةِ السُجومِ",37,"م",1,0],["كان أمراً دون الحَياء يسيراً","فغدا بالظّنون أمراً عسيرا",38,"ر",2,0],["كان أمر الموت جداً","وغدا اليوم مجونا",39,"ن",2,0],["كَأَنَّ أُمامَةً حَلَفَت يَمِيناً","لَنا أَن لا يَصِحَّ لَها يَمينُ",40,"ن",1,0],["كَأَنَّ اِمرِءاً في الناسِ كُنتُ اِبنَ أُمِّهِ","عَلى فَلجٍ مِن بَطنِ دَجلَةَ مُطنِبِ",41,"ب",1,0],["كأنَّ أميرَ النوم يهوى جفونه","إذا همَّ رفعاً خالفته المحاجرُ",42,"ر",1,0],["كأنا مضرحيات برضوى","ينؤن إذا ينؤن بلا جناح",43,"ح",1,0],["كَأَنَّ أَمامَ الرَحلِ مِنها وَخَلفَهُ","صَفيحاً لَدى صَفقَي قَراها مُسَنَّدا",44,"د",2,0],["كَأَن إمام العَصر ألهمك الَّذي","تَقول فَلا يَبقى نِزاع وَلا خلف",45,"ف",1,0],["كان إما رأى بثوبي شقوقا","راح يبدي سامي الحنو عليا",46,"ي",2,0],["كان إماما مرشدا مسلكا","قد راق مشربا وطاب مسلكا",47,"ك",2,0],["كأنامل خُضبت فبعض عالق","لون الخضاب به وبعض ناصل",48,"ل",1,0],["كأنا مدين كفرت شعيبا","فيوم الظلتين لهم مبيد",49,"د",1,0],["كأن أمواج بحر الهند من زرَدٍ","تفيض ما بين موضون ومسرود",50,"د",1,0],["كأن امرءاً بنظير الغياض","سقى بدفاق العيون الرياض",51,"ض",1,0],["كان أمام الجياد يقدمُها","يهزّ لدنا وجؤجؤا تلِعا",52,"ع",2,0],["كأنّا من بشاشتِنا ظلَلنا","بيَومٍ ليسَ من هذا الزمانِ",53,"ن",1,0],["كان أميرٌ من صغار السن","في روضة تحكي جمال عدن",54,"ن",1,0],["كأنّا ما جعلنا قبل كسرى","بحد السيف يجثوا على البلاط",55,"ط",1,0],["كان امس فيه اطول من الصبر والعن","الله يذاك الوقت يا زين طوله !",56,"ل",2,0],["كأنّ أمواهها بيض يمانيةٌ","غدت تزعزع في أيمان أذمار",57,"ر",1,0],["كَانَ أَمناً لِلخَائِفِينَ ، فَسِرتُمْ","فِي طَرِيقِ الشُّرُورِ ، بِئسَ الطَّرِيقُ",58,"ق",1,0],["كأن أمتنا من طول رقدتها","عروقها نضبت من دمّها العربي",59,"ب",2,0],["كأنّا مِنْ بنيْ جَهْلٍ","ولَسْنا خِيرة الأممِ",60,"م",1,0],["كان أمضى من كلِّ سيفٍ, وأشبا","ثمّ أبكيْتُ الخلْقَ عُجْماً, وعُرْبا",61,"ا",1,0],["كأنا ما قرأنا في كتاب","ولا كان الفؤاد لنا بصيرا",62,"ر",2,0],["كأَنا ما بَلَغنا أَي شَيءٍ","لِكَثرَةِ ما احتَكمنا للخَيالِ",63,"ل",1,0],["كأنَّا ما حملنا النور يوما","وسدنا الأرض نكسوها سلاما",64,"م",2,0],["كأنَّا ما سقينا الأرض امناً","ولا رفلت بها تزهو وئاما",64,"م",2,0],["كَأنَّ أٌمّي بَلَّ اللهُ تُربتها","أوصَتْ فقالت : أخوك المجلس البلدي",65,"د",2,0],["كأنَّا مضرحيَّات برضوى","ينأَونَ إِذا ينأَونَ بلا جناح",66,"ح",1,0],["كأنّا ما عرفناه","ولا سبقت لنا صحبه",67,"ب",2,0]]}