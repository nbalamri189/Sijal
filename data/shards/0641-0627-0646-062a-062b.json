{"poems":[[71,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[234,"وشادن شرط الصبا مرهف","https://www.aldiwan.net/poem51273.html","السريع"],[409,"الحمد لله على كل حال","https://www.aldiwan.net/poem33479.html","السريع"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49580","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93571","الخفيف"],[3326,"","https://poetry.dctabudhabi.ae/diwan/poem/84949","الوافر"],[3508,"","https://poetry.dctabudhabi.ae/diwan/poem/20535","الطويل"],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140261",""],[4042,"","https://poetry.dctabudhabi.ae/diwan/poem/69281","الطويل"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136843",""]],"verses":[["فأنتَ ثاني الذبيحينِ العلى خطبتْ","فحزتها وَهْيَ بينَ النابِ والظفرِ",0,"ر",1,0],["فانتثرت بالغُنْجِ ألفاظُه","وانكسرت باللّحظ جفناه",1,"ن",3,0],["فإن تثبت بالجواب الذي","عن ربه عز وما قال",2,"ل",1,0],["فإنْ تثُبْ أو تُقارِبْ والنَّوى أمَمٌ","فقد خَلَتْ قَبْلها الأمْثَالُ والمُثلُ",3,"ل",1,0],["فَانتثرتم كَما اِنتَثَرن دراري ال","عقد شَتى وَالكُل مِنكُم فَريد",4,"د",1,0],["فَإِن تثقَف أَسنتنا زهيراً","يكفّ شَريدهم أخرى اللَيالي",5,"ل",2,0],["فإِن تَثوِلا تُملَل وإِن تضحِ غادياً","تُزَوَّد وَتَرجِع عَن عُمَيرَةَ راضيا",6,"ي",2,0],["فإن تثرِّب على خل الجفا فلكم","عرضي المصون مباح في حمى الحرم",7,"م",1,0],["فان تَثلِثوا نَربَع وان يَكُ خامِسٌ","يَكُن سادِسٌ حَتّى يُبيركُمُ القَتلُ",8,"ل",1,0],["فإن تثنيت وأعطيت الذي قده مدنف","فإنك أولى بها وإلا قل الله يخلف",9,"ف",1,0]]}