{"poems":[[24,"أمن أم شداد رسوم المنازل","https://www.aldiwan.net/poem21878.html","الطويل"],[84,"سرى والحب أمر لا يرام","https://www.aldiwan.net/poem29415.html","الطويل"],[10,"أعين ألا فابكي لصخر بدرة","https://www.aldiwan.net/poem21061.html","الطويل"],[47,"أناة أيها الفلك المدار","https://www.aldiwan.net/poem63597.html","الوافر"],[2,"أرادت جوازاً بالرسيس فصدها","https://www.aldiwan.net/poem25010.html","الطويل"],[19,"صحا قلبه عن سُكره فتأملا","https://www.aldiwan.net/poem356.html",""],[108,"تحية العميد","https://www.poetsgate.com/ViewPoem.aspx?id=179696",""],[47,"أنَاةً أيّهَا الفَلَكُ المُدارُ،","https://www.poetsgate.com/ViewPoem.aspx?id=31279",""],[132,"من لصب دموعه ليس ترفا","https://www.aldiwan.net/poem50563.html","الخفيف"],[185,"شفى النفس أسياف بأيمان فتية","https://www.aldiwan.net/poem59076.html","الطويل"],[214,"وحقك ما للبدر حسنك في التم","https://www.aldiwan.net/poem13310.html","الطويل"],[234,"وناطقة كلما حركت","https://www.aldiwan.net/poem50770.html","المتقارب"],[254,"كفى بالنأي من أسماء كافي","https://www.aldiwan.net/poem2105.html","الوافر"],[327,"لقد واصلت سلمى في ليال","https://www.aldiwan.net/poem56357.html","الوافر"],[369,"سواء تدان منهم وتناء","https://www.aldiwan.net/poem61015.html","الطويل"],[422,"إذا نبت الديار بحر قوم","https://www.aldiwan.net/poem54189.html","الوافر"],[445,"وأهد بها في الفلا والسرى","https://www.aldiwan.net/poem34834.html","المتقارب"],[466,"يقر بعيني أن أراها مغيرة","https://www.aldiwan.net/poem15105.html","الطويل"],[466,"اذا كنت جارا للفرات وهاطل","https://www.aldiwan.net/poem15587.html","الطويل"],[471,"كأن مدامة من خمر دن","https://www.aldiwan.net/poem50393.html","الوافر"],[475,"كأن مدامة مما","https://www.aldiwan.net/poem4674.html","مجزوء الوافر"],[558,"أديري على الراح ساقية الخمر","https://www.aldiwan.net/poem68421.html","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66717","الوافر"],[2165,"","https://poetry.dctabudhabi.ae/diwan/poem/20456","الوافر"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67880","البسيط"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46761","الوافر"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136992",""],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132527","الوافر"],[3250,"","https://poetry.dctabudhabi.ae/diwan/poem/144406","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85091","الوافر"],[4830,"سَبايا الرسالة","https://www.poetsgate.com/ViewPoem.aspx?id=200021",""],[669,"تباشر أهل تدمر إذ اتاهم","https://www.poetsgate.com/ViewPoem.aspx?id=18436",""]],"verses":[["كَأَنَّ مُدَهدى حَنظَلٍ حَيثُ سَوَّفَت","بِأَعطانِها مِن لَسِّها بِالجَحافِلِ",0,"ل",1,0],["كأن مدار قطب بنات نعش","نديّ والنجوم به ندام",1,"م",1,0],["كَأَنَّ مُدِلّاً مِن أُسودٍ تَبالَةٍ","يَكونُ لَها حَيثُ اِستَدارَت وَكَرَّتِ",2,"ت",1,0],["كَأَنَّ مُدارَ دِجلَةَ إِذ تَوافَت","بِأَجمَعِها هِلالٌ أَو سِوارُ",3,"ر",1,0],["كَأَنَّ مُدَهدى حَنظَلٍ حَيثُ سَوَّفَت","بِأَعطانِها مِن جَزِّها بِالجَحافِلِ",4,"ل",1,0],["كَأَنَّ مَدَبَّ النَملِ يَتَّبِعُ الرُبى","وَمَدرَجَ ذَرٍّ خافَ بَرداً فَأَسهَلا",5,"ل",2,0],["كأنَّ مدادَه شهدٌ مصَفٍّى","كأنَّ سطورَه بَسَمَاتُ غيد",6,"د",1,0],["كأنّ مَدارَ دِجلَةَ، دجلة إذ توافت","بأجْمَعِها، هِلالٌ، أوْ سِوَارُ",7,"ر",1,0],["كان مدح الأئمةِ العدلِ دينا","وامتداح الضلال ظلماً وفسقَا",8,"ق",2,0],["كأنَّ مَدَبَّ النَّملِ فوقَ مُتونِها","إذا لم تُصَبَّغ من دماءٍ نُميرُها",9,"ر",3,0],["كأن مديحي من نداه وقد زها","حديقة روض راضها وابل الوسم",10,"م",1,0],["كأنّ مَدامِعَها فِضّةٌ","مذوّبةٌ لونُها أَسْمجُوني",11,"ن",2,0],["كَأَنَّ مُدامَةً مِن أَذرِعاتٍ","كُمَيتاً لَونُها لَونُ الرُعافِ",12,"ف",1,0],["كَأَنَّ مُدامَةً وَرُضابَ مِسكٍ","وَكافوراً ذَكِيّاً لَم يَغَشِّ",13,"ش",1,0],["كأنّ مديحي فيك عِقْدُ مليحةٍ","يَزيدُ بها حُسناً لدى البُصَراء",14,"ا",2,0],["كأَنَّ مديحُهم عندي عقارٌ","به كانَ اغتباقي واصطباحي",15,"ح",2,0],["كَأَنَّ مَدَاهُنَّ فِي صَحْنِ خَدِّي","ركابيَ فِي صَحْصَحَانِ الفَضاءِ",16,"ا",2,0],["كأن مداف الورس فوق وجوهم","إذا قيلَ هذا معْركٌ وغِمار",17,"ر",1,0],["كأنَّ مُداماً أو سِماماً قَواتِلاً","سجاياهُ في حالَيْ رِضاً وتَبَرُّمِ",18,"م",1,0],["كَأَنَّ مَدامَةً مِن خَمرِ دَنٍّ","تُصَبُّ عَلى ثَناياها طُروقا",19,"ق",2,1],["كَأَنَّ مُدامَةً مِمّا","حَوى الحانوتُ مِن مَقَدِ",20,"د",1,1],["كَأَنَّ مَدَبَّ المَوجِ في جَنَباتِها","مَدَبُّ الصَبا بَينَ الوِعاثِ مِنَ العُفرِ",21,"ر",1,0],["كأنَّ مَدامعي وجفونَ عَيني","تُوخَّزُ بالقَتاد فهنَّ عُورُ",22,"ر",1,0],["كَأَنَّ مُدامَةً مِن أَذرِعاتٍ","وَماءَ المُزنِ وَالعِنَبِ القَطيفا",23,"ف",2,1],["كأنَّ مدمَعَهُ تجري أوائلُهُ","كما يَفيضُ على أُخراهُ مَردودُ",24,"د",1,0],["كَأَنَّ مُدامَةً صَهباءَ صِرفاً","تَرَقرَقُ بَينَ راووقٍ وَدَنِّ",25,"ن",1,1],["كان مدحي فيك مختصرا","ووفائي غير مختتم",26,"م",1,0],["كأن مدامع الباكين مدت","بنائله فعم بها الرواء",27,"ا",2,0],["كأن مدب النمل فوق غراره","إذا صح منه للعقول التأمل",28,"ل",1,0],["كأن مدامعي ربح","يؤجج نشره وجدي",29,"د",2,0],["كانَّ مدارَ الشمسِ ليس بأُفقهِ","غُدُوٌّ على نَصْلِ القنا ورَواحُ",30,"ح",1,0],["كأن مدامعي وجفون عيني","توخر بالقتاد فهن عور",31,"ر",1,0]]}