{"poems":[[53,"رأت عيني لمنكرة قواما","https://www.aldiwan.net/poem66359.html","الوافر"],[246,"جرى الدمع حتى ليس في الجفن مدمع","https://www.aldiwan.net/poem45765.html","الطويل"],[369,"وصال الشمس يهدي الاحتراقا","https://www.aldiwan.net/poem60836.html","الوافر"],[447,"دعاها كيفما صنعت دعاها","https://www.aldiwan.net/poem14432.html","السريع"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146763","الطويل"]],"verses":[["فقلتُ ثلاثةٌ كلٌّ جَناهُ","أقام بِكمْ بلاؤكُمُ وداما",0,"م",2,0],["فقلتُ ثِقي بالله يا فوزُ إِنَّها","سحابةُ صَيفٍ عن قَليل تَقشَّع",1,"ع",1,0],["فقلتُ ثِقي فمِن أَثمانِ نُطْقي","غداً أَكسوكِ مِن دُرٍّ نطاقا",2,"ق",2,0],["فقلت ثقي بذمر عنقفير","متى اغتصّته حادثة شجاها",3,"ا",3,0],["فقلت ثقي بالله يا أُمَّ معمر","فبعض الصدى ريّ وبعض النوى قرب",4,"ب",1,0]]}