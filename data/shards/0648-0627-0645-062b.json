{"poems":[[32,"أحادرة دموعك دار مي","https://www.aldiwan.net/poem29531.html","الوافر"],[32,"ألا لا أرى كالدار بالزرق موقفا","https://www.aldiwan.net/poem29595.html","الطويل"],[49,"أتعجب أن ملكنا الأرض قسرا","https://www.aldiwan.net/poem25350.html","الوافر"],[30,"إمام منهم للناس فيهم","https://www.aldiwan.net/poem5416.html","الوافر"],[30,"لو جمعوا من الخلان ألفا","https://www.aldiwan.net/poem5634.html","الوافر"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67312","الطويل"],[164,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[170,"معاد معاديه مهما طوى","https://www.aldiwan.net/poem46353.html","المتقارب"],[519,"تصاحى وهو مخمور الجنان","https://www.aldiwan.net/poem20821.html","الوافر"],[563,"خذوا علمكم بالله لا تتأخروا","https://www.aldiwan.net/poem34489.html","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77600","الرجز"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124716","الطويل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114707","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87347","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87383","الطويل"],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[5150,"السلام المر ..!","https://www.poetsgate.com/ViewPoem.aspx?id=203767",""],[5302,"تطاول ليلي","https://www.poetsgate.com/ViewPoem.aspx?id=201153",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""]],"verses":[["وَأَمثالُ النِعاجِ مِنَ الغَواني","تُزَيِّنُها المَلاحَةُ وَالنَعيمُ",0,"م",1,0],["وَأَمثَلُ أَخلاقِ اِمرِئِ القَيسِ أَنَّها","صِلابٌ عَلى طولِ الهَوانِ جُلودُها",1,"د",3,0],["وَأَمثالُ القَسِيِّ مِنَ المَطايا","يَجُبُّ غِراسَها الخَيلُ العِرابُ",2,"ب",1,0],["وَأُمِّ ثَلاثَةٍ مَعَها ثَلاثٌ","كَأَنَّ بِأُمِّهِم وَبِهِم سُلالا",3,"ل",2,0],["وَأُمِّ ثَلاثَةٍ جاءَت إِلَيكُم","بِها وَهمٌ مُحاذِرَةً زَمانا",4,"ن",2,0],["وأمثالُ عمرٍو وامرىء القيسِ مِنْهمُ","وأمثالُ محمودٍ وَمِثْلُ أبي عَمْرِو",5,"ر",2,0],["وأمثال هذا عندكم من كلامه","كثير مكني في الفصوص ملقب",6,"ب",1,0],["وأمثلُ أحوالِ أعدائهِ","وكلُّهمُ نهبُ داءٍ دوِيّ",7,"ي",1,0],["وأمثالٍ تلذُّ بكلِّ سمعٍ","كأنّ بضرْبِها ضرْبَ المثاني",8,"ن",2,0],["وأمثاله مخلوقة كبعوضة","فما فوقها يدري بها المتدبر",9,"ر",1,0],["وَأَمثَلوه عِندَهُ فَسَأَله","وَالشَيخ أَبدى لِلأَمير مَسأَله",10,"ه",1,0],["وأمثاله فهي الصفات لجوده","وإن قصرت عنه الصفات فلم ترم",11,"م",1,0],["وأمثَلُ ما قالُوهُ فَرَّ لوجههِ","وأَجفَلَ مذعوراً كما تجفلُ الرُّبدُ",12,"د",1,0],["وأمثالُهُ الضِّلعُ السحابيُّ غَايِرُ","فهنَّ نُجُومُ كُلُّهُنَّ أشايرُ",13,"ر",1,0],["وأمثالُهُ النَّسرُ الكبيرُ مصانع","وإن قِستَ للشامي على الحدِّ لامع",13,"ع",1,0],["وامثالِها من كُلّ خُلقٍ مكمَّلٍ","فما هو شَخصٌ واحِدٌ بل تعدَّدا",14,"د",2,0],["وأمثل عند المصطفى ذائب","الحشا بروضته للروح والذات مسلما",15,"م",2,0],["وأمثالٍ لهُ كانوا علينا","وتحدوهُ المهانةُ والنعيقُ",16,"ق",1,0],["وأمثاله حاولوا وانتهوا","حيارى بدرك الهوى الأسود",17,"د",1,0],["وأمثال هذا في الشريعة قد أتى","إذا كنت عن فهم الحقائق في بعدِ",18,"د",1,0]]}