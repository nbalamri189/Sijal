{"poems":[[53,"أودع في كل يوم حبيبا","https://www.aldiwan.net/poem30733.html","المتقارب"],[63,"سقى الله رملي كوفن صيب الحيا","https://www.aldiwan.net/poem45877.html","الطويل"],[77,"وجودك حي الملك والدين والدنيا","https://www.aldiwan.net/poem35717.html","الطويل"],[93,"تعجبني رؤية حوليكم","https://www.aldiwan.net/poem11070.html","السريع"],[88,"بدا وجه العروبة في حلوك","https://www.aldiwan.net/poem45038.html","الوافر"],[51,"جفتني أن صددت ولي لديها","https://www.aldiwan.net/poem64587.html","الوافر"],[51,"أبا الصقر لا تدعني للبراز","https://www.aldiwan.net/poem65769.html","المتقارب"],[51,"لعمري لقد سهلت ما ليس بالسهل","https://www.aldiwan.net/poem65942.html","الطويل"],[89,"متى تحضر تطب يا عذل بالا","https://www.aldiwan.net/poem44966.html","الوافر"],[43,"أهلا بدار سباك أغيدها","https://www.aldiwan.net/poem9531.html","المنسرح"],[62,"يا حادي الظعن رفقا إنك الجاني","https://www.aldiwan.net/poem52253.html","البسيط"],[45,"يكاد يبدي لسعدى غيب ما أجد","https://www.aldiwan.net/poem63477.html","البسيط"],[61,"أإن دنا الشوق بعد ما شسعا","https://www.aldiwan.net/poem51574.html","المنسرح"],[61,"أرى همة تختال بين الكواكب","https://www.aldiwan.net/poem51785.html","الطويل"],[66,"أمن حجر فؤادك أم حديد","https://www.aldiwan.net/poem41547.html","الوافر"],[31,"هيهات من أمة الوهاب منزلنا","https://www.aldiwan.net/poem41292.html","البسيط"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"إشرب بكأس من كف طاووس","https://www.aldiwan.net/poem26915.html","المنسرح"],[67,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[46,"سرت بقوام يسرق اللب ناعم","https://www.aldiwan.net/poem22256.html","الطويل"],[46,"أهاب منيتي وأحب ستري","https://www.aldiwan.net/poem22679.html","الوافر"],[46,"أبا القدر المتاح ردين جن","https://www.aldiwan.net/poem23407.html","الوافر"],[46,"مطيتي الوقت الذي ما امتطيته","https://www.aldiwan.net/poem23497.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85602","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19708","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54197","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[77,"وجودك حيى الملك والدين والدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=34199",""],[90,"عُدنا وقودا","https://www.poetsgate.com/ViewPoem.aspx?id=179221",""],[45,"يكادُ يُبْدي لسعدى غَيْبَ ما أجِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=31630",""],[46,"سرتْ بقوامٍ، يسرِقُ اللُّبَّ، ناعمٍ،","https://www.poetsgate.com/ViewPoem.aspx?id=18248",""],[51,"أبا الصَّقْرِ لا تَدْعُني للبِرا","https://www.poetsgate.com/ViewPoem.aspx?id=30022",""],[32,"لقد اورثت قلبي وكان مصححا","https://www.poetsgate.com/ViewPoem.aspx?id=107",""],[120,"دعوت بنات الليل في أخرياته","https://www.aldiwan.net/poem49310.html","الطويل"],[132,"سرى الطيف من لبنى فهاج الضنى وهنا","https://www.aldiwan.net/poem54730.html","الطويل"],[150,"توكل إذا نابتك يوما ملمة","https://www.aldiwan.net/poem68522.html","الطويل"],[150,"ألا فاشكروا نعمى الإله يزدكم","https://www.aldiwan.net/poem68580.html","الطويل"],[169,"إلى م أرجي ضر عيش منكدا","https://www.aldiwan.net/poem1615.html",""],[186,"أبا طالب لله در مناقب","https://www.aldiwan.net/poem43271.html","الطويل"],[210,"فؤاد بذكر العامرية مغرم","https://www.aldiwan.net/poem13295.html","الطويل"],[223,"قيثارتي لم ألطخها بأقذار","https://www.aldiwan.net/poem41588.html","البسيط"],[223,"ألا تبصر الأغصان بللها القطر","https://www.aldiwan.net/poem41891.html","الطويل"],[252,"طوى دارها طي الكتاب المنمنم","https://www.aldiwan.net/poem1431.html",""],[271,"أفق هديت من التبريح والكمد","https://www.aldiwan.net/poem52105.html","البسيط"],[297,"تذكر بالحمى رشأ أغنا","https://www.aldiwan.net/poem33152.html","الوافر"],[303,"جلوت فيك على الأسماع أسمارا","https://www.aldiwan.net/poem58113.html","الطويل"],[328,"ملأت بالدمع كأسي","https://www.aldiwan.net/poem54927.html","المجتث"],[328,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[337,"وكم وزعنا من خميس جحفل","https://www.aldiwan.net/poem45301.html","الرجز"],[364,"ألا ليت قلبي يوم أعلن وجده","https://www.aldiwan.net/poem60955.html","الطويل"],[377,"خليلي مرا بي على ربع ناسك","https://www.aldiwan.net/poem59305.html","الطويل"],[403,"لله در الجلال من علم","https://www.aldiwan.net/poem33433.html","المنسرح"],[403,"ما آن للعاذل أن يغلقا","https://www.aldiwan.net/poem33627.html","السريع"],[416,"تذكر بالخيف عهدا قديما","https://www.aldiwan.net/poem53932.html","المتقارب"],[416,"هنيئا لكم هذا الهناء المجدد","https://www.aldiwan.net/poem54042.html","الطويل"],[432,"يروع الذئب حيث سواك راع","https://www.aldiwan.net/poem12377.html","الوافر"],[437,"إذا اهتز للجدوى اهتزاز مهند","https://www.aldiwan.net/poem2498.html","الطويل"],[439,"نداك حبيب لا يشط مزاره","https://www.aldiwan.net/poem34778.html","الطويل"],[439,"بحكم العدل من قاضي السماء","https://www.aldiwan.net/poem34836.html","الوافر"],[439,"قد الخيل والخير بأسا وجودا","https://www.aldiwan.net/poem34850.html","المتقارب"],[439,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[439,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[441,"ألق العصي فهذا مقتضى الأرب","https://www.aldiwan.net/poem14330.html","البسيط"],[441,"صب صبته إلى ليلى صبابته","https://www.aldiwan.net/poem14340.html","البسيط"],[443,"بالله يا نسمات الرند والبان","https://www.aldiwan.net/poem55955.html","عموديه"],[458,"أمن أسماء والمسرى بعيد","https://www.aldiwan.net/poem56226.html","الوافر"],[461,"ظل الأسنة لا جيران بغداد","https://www.aldiwan.net/poem15126.html","البسيط"],[461,"إذا مدحت معز الدين آونة","https://www.aldiwan.net/poem15133.html","البسيط"],[464,"أيا ملكاً بات صرح العلى","https://www.aldiwan.net/poem3133.html","عموديه"],[464,"كيف السكون من الدنيا إلى سكن","https://www.aldiwan.net/poem3393.html","عموديه"],[477,"هل في المنازل بعد القوم آثار","https://www.aldiwan.net/poem15240.html","البسيط"],[500,"أهلا بليلى قد جلت هلالها","https://www.aldiwan.net/poem37710.html","الرجز"],[514,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"],[515,"لك الحسب الباقي على عقب الدهر","https://www.aldiwan.net/poem12142.html","الطويل"],[536,"عرفت دياراً بالحمى فشرائث","https://www.aldiwan.net/poem23857.html","الطويل"],[538,"السحر هذا ما أرى","https://www.aldiwan.net/poem48280.html","عموديه"],[551,"كتمت من أسماء ما كان علن","https://www.aldiwan.net/poem47149.html","الرجز"],[551,"ما للقلوب غداة السبت مزعجة","https://www.aldiwan.net/poem47250.html","البسيط"],[551,"أظنك من جدوى الأحبة قانطا","https://www.aldiwan.net/poem47729.html","الطويل"],[551,"في مثلها يستثار الصبر والجلد","https://www.aldiwan.net/poem47882.html","البسيط"],[551,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[551,"لقد ضل من يسترق الهوى","https://www.aldiwan.net/poem48120.html","المتقارب"],[562,"سلام وما يغني السلام على البعد","https://www.aldiwan.net/poem52946.html","الطويل"],[575,"لا كانت الشمس فكم أصدأت","https://www.aldiwan.net/poem2808.html","السريع"]],"verses":[["وَكَم واضِحٍ مِنكُمُ كَالهِلا","لِ هالَت يَدايَ عَلَيهِ الكَثيبا",0,"ب",2,0],["وَكَمْ وَلَدا مِنْ صَائِبِ الرَّأْيِ حَازِمٍ","وَمِنْ أَرْيَحِيٍّ وافِرِ العِرْضِ ماجِدِ",1,"د",1,0],["وكمْ وثِقَتْ بالنّصْرِ منْكَ كَثيبةٌ","بعثْتَ بِها لا تعرِفُ الجَهْدَ والوَنْيا",2,"ي",2,0],["وكم وكم لوناً مضى عهده","وطعمه في ذوقنا لم يزل",3,"ل",1,0],["وكم وعدوا بني قحطان وعداً","به انقلب اليقين إلى شكوك",4,"ك",1,0],["وكم واشٍ وشى بكِ غير آلٍ","فآب وحظُه تَعْس ونكس",5,"س",1,0],["وكم واهن الركن أنهضتَه","إليك بقوة أركانكا",6,"ك",2,0],["وكم واعدٍ عدلاً على خلطائه","إذا قُلّد الأحكامَ تاب من العدلِ",7,"ل",1,0],["وكم واعدتنا يا عدل وصلاً","وجوناه فلم تنل الوصالا",8,"ل",2,0],["وَكَم وَكَم حاجَةٍ سَمَحتَ بِها","أَقرَبُ مِنّي إِلَيَّ مَوعِدُها",9,"د",3,0],["وكم وراءَ لآلِي الثغرِ من كُرَعٍ","عذبِ المشارعِ فيه ريُّ ظمآنِ",10,"ن",1,0],["وَكَم وَعَدتَ وَأَنتَ الغَيثُ نَعرِفُهُ","مُذ حالَفَ الجودَ يُعطي فَوقَ ما يَعِدُ",11,"د",1,0],["وكم وَصَلْتُ الوَجيفَ مُنْتَجِعاً","جَدْوى ابنِ فَهدٍ فرُحْتُ مُنتَجِعا",12,"ع",2,0],["وكَم ومَضَتْ أسيافُهُ بمشارقٍ","فراعَ العِدا إيماضُها بمَغاربِ",13,"ب",1,0],["وَكَم وانٍ يَعُدُّ العَجزَ حِلماً","فَيَندَمُ وَالنَدامَةُ لا تُفيدُ",14,"د",1,0],["وَكَم وَكَم مِن دَلالٍ قَد شُغِفتُ بِهِ","مِنكُم مَتى يَرَهُ ذو العَقلِ يُفتَتَنُ",15,"ن",1,0],["وَكَم وَكَم مِن حُرَّةٍ حَواها","سَبِيَّةٍ وَزَوجُها يَراها",16,"ه",2,0],["وَكَم وَحَتّى أَهيمُ مِن وَلَهٍ","كَذي جُنونِ الخَبالِ مَمسوسِ",17,"س",1,0],["وَكَمْ وَقَفُوا بِأَبْوَاب النَّصارَى","عَلَى أسْيَافِهِمْ مُتَوَكِّلِينا",18,"ن",2,0],["وَكَم وَطِأَت أَقدامُنا في تُرابِها","جَبينَ أَخي كِبرٍ وَهامَةَ أَبلَجِ",19,"ج",1,0],["وَكَم وَتَرَت لِيَ النَّكَباتُ قَوساً","كَأَنَّ الدَهرَ يَطلُبُني بِوَترِ",20,"ر",1,0],["وَكَم وَجَم الفَتى مِن بَعدِ ضِحكٍ","وَأُضحِكَ بَعدَ إِفراطِ الوُجومِ",21,"م",1,0],["وَكَم واسِعِ الأَعطانِ تَجزَعُ نَفسُهُ","وَرَحبِ فُؤادٍ آلِفٍ ضيقَ أَعطانِ",22,"ن",1,0],["وَكَم وعدوا أن ينصفوني فما وفوا","وكم حلفوا أن يصدقوني فما بروا",23,"ر",3,0],["وكم وكم زوّج أو","طلق من حرائر",24,"ر",1,0],["وكم وضَعت مِنْ إصْبع فوقَ أنفها","وكم غمزَتْ أسوارُهَا بالحواجبِ",25,"ب",1,0],["وكم وكم ملَّ حادينا لجاجتنا","وما علينا إذا ما ملَّ حادينا",26,"ن",2,0],["وكم وثقت بالنصر منك كتيبة","بعثت بها لا تعرف الجهد والونيا",27,"ي",2,0],["وكمْ وكمْ ، والشَّباب يَدري","رُوَِّعَ ظبيٌ فَنُصَّ جيد",28,"د",1,0],["وَكمْ وَعدْتَ، وأنتَ الغيْثُ تعرِفُهُ،","مُذْ حالَفَ الجُودَ يُعْطي فوْقَ ما يعدُ",29,"د",1,0],["وكم وطِئَتْ أقدامُنا، في تُرابِها","، جبينَ أخي كِبْرٍ، وهامةَ أبلج",30,"ج",1,0],["وكم واهنِ الركن أنضتَه","إليك بقوة أركانكا",31,"ك",2,0],["وكم وَعَدَتْنا من مواعد لو وفت","بوأيٍ- فلم تنجَزْ قليلٍ غناؤها",32,"ا",3,0],["وكم وادع وثبته وتركته","حشاشته للحادثات نهاب",33,"ب",1,0],["وكًم وَهَبَت يُمنَاكَ ألفاً مُصَتَّماً","وكَم أعمَلتَ لُدناً وكَم نَحَرتَ بُدنَا",34,"ن",2,0],["وكم واهم في قصد عمرو وخالد","فإيَّاك لا يذهب بخاطرك الوهم",35,"م",1,0],["وَكَم وَحُضوري بِالمُنى مِثلُ غَيبَةٍ","هَمَمت بِإِعمالِ المَطيِّ لطَيبَةٍ",36,"ه",1,0],["وَكَم واتَنَ الأَوطانَ مِن ذي جَلادَةٍ","فَأَضحى بِها مِن غَيرِ سُقمٍ مُسَخَّدا",37,"د",2,0],["وكم وافد أغنيته وأعنته","فأصبح في عز بعزك دائم",38,"م",1,0],["وكم وردوا بحرا على كل سابح","وما صدروا الا وبحر الوى دم",39,"م",1,0],["وَكَم وَليّ رَعى شَعباً فَأَهلَكَه","تَرغي عَلى زُهدِهِ أَرياقُ عشّارِ",40,"ر",1,0],["وَكم وَقفَةٍ في رُبعِ زَحلَةَ أَطلَعَت","عَلَيكَ قَريضاً دونَهُ الماسُ وَالتبرُ",41,"ر",1,0],["وَكَم وَقفَةٍ فيها أَقَلَّ مُساعِدي","عَلى الدَمعِ اسعادي وَأَكثَر لومّي",42,"م",2,0],["وَكَم وَكَم بينَنا من مجهل درس","ومن فراسخ لا تحصى ومن برد",43,"د",1,0],["وَكَم وافاهُ ذو كربٍ وحُزنٍ","ففرَّج كربَه وأَزال حُزنا",44,"ن",2,0],["وكم وصفتك ما بين الأنام إلى","أن صار فيك العدى في الحال أنصارا",45,"ر",2,0],["وكم وهبتك قلبي","وقلت روحي فداك",46,"ك",1,0],["وكم وحّدوك وكم عدّدوك","فكان هداهم ضلال الهدى",47,"د",2,0],["وكم واقفٍ عند باب الصباح","وفي عَينهِ لهفةٌ للمساء",47,"ا",2,0],["وَكَم وَزَعنا مِن خَميسٍ جَحفَلِ","وَكَم حَبَونا مِن رَئيسٍ مِسحَلِ",48,"ل",1,1],["وكم وَدَّ قلبي أن يَرى المجدَ رُؤيةً","إلى أن بَلغْتُ اليوم بالقلبِ وُدّه",49,"د",2,0],["وكم وزنت ميلاتُه من دقائقٍ","نُميِّز فيها بين سالٍ وسالك",50,"ك",1,0],["وكم وكم قلد القلائد من","أنظاره والغريب من حكمه",51,"م",2,0],["وكم وكم أسرد من ذا الذي","ليس له من سامع ملتقا",52,"ق",2,0],["وكم وقفة لي بتلك الدِّيار","أُداري بهنَّ الأَسى والهموما",53,"م",2,0],["وكم وقعةٍ شبَّت وشبَّ ضرامها","وشابَ لها نصل الظُّبا وهو أَمرد",54,"د",1,0],["وكم وَطِئَتْ مساعِيكَ السَّوامي","بأَخْمَصِها على لِمَمِ المساعي",55,"ع",2,0],["وكم وقفة للّه ينجاب ليلها","وقد اسلم الكفار للقتل والأسر",56,"ر",1,0],["وكَمْ وَصَلَتْهُ بالكواكِبِ هِمَّةٌ","تُجَلّي إلى الآفاقِ أينَ مَغارُهُ",57,"ر",2,0],["وكم وُقِيَتْ رِكابٌ يَمَّمَتْهُ","سِهامَ النائِباتِ بلا وِقاءِ",58,"ا",2,0],["وكم وَصَلُوا بك قلباً كريماً","وكم شَرَحُوا لَكَ صدراً وَدُودا",59,"د",2,0],["وكم وَجَّهُوا وَجْهاً لبارِقَةِ الظُّبى","وكم وَطَّنُوا نَحْراً لِنافِذَةِ النَّحْرِ",60,"ر",1,0],["وكم وَفى ليَ فِيهِ من حبيبِ هوىً","خَلَعتُ فِيهِ عِذاري فَهو خالِعُهُ",61,"ع",2,0],["وكم وردت على عقبى الظما حرضا","وللسراب يلاميع على الشهب",62,"ب",1,0],["وكم وردت وأصحابي من الشعرا","ماء أمر من الدفلي والصبرا",62,"ر",2,0],["وكم وردنا قبا بالأنيق الشنف","وماء مران تجري غير ذي وطف",62,"ف",1,0],["وكم وردنا على عقبى نوى قدف","عرقاً وردناه للإحرام في عصب",62,"ب",1,0],["وكم وكم أبلست في يوم ذي جذل","أهل الفصاحة نهش فصاحته",63,"ت",2,0],["وكم وكم دول من بعدها درجى","هامت بليلاي في سر وإعلان",64,"ن",1,0],["وكم وعَدتْ بك الآمالُ نفسي","ويقضي الدهر أن تُلْوىَ الوُعودُ",65,"د",1,0],["وكم وراء رحيلي من مُحبَّرةٍ","روعَاءَ بارقةٍ بالشرِّ مِرْعادِ",66,"د",1,0],["وكم وردت دياراً تُرْبها فُرشٌ","ثم أنثنيت وأعلى تُربها رِمَمُ",67,"م",1,0],["وكم وفرَ الجودُ عرض أمرئ","شراه وأمواله تنهك",68,"ك",1,0],["وكم وقفتُ على عافٍ فأطربني","منه فصاحة ذاك العيّ واللّكن",69,"ن",1,0],["وكم وقفتُ به مِنْ وقفةٍ صدعتْ","قلبي وقد أزمعَ الحبابُ أو ساروا",70,"ر",3,0],["وكم وراء سترها لاحت لهم","فذهلوا حين زأوا خيالها",71,"ل",3,0],["وكم وَقفةٍ معروفةٍ في العِدا له","لها مثَلٌ في سائِرِ النّاس سائِرُ",72,"ر",1,0],["وكم وقعة عذراء لما فضضتها","بسيفك لم تترك لغيرك من عذر",73,"ر",1,0],["وَكَم وَعَدَ الأَقوامَ موسى بِبَعثِهِ","وَكَم قالَ عيسى إِنَّهُ غَيرُ لابِثِ",74,"ث",1,0],["وكَم وكَم وكَم وكَم","مِن مُعجِزاتِ الأدبِ",75,"ب",1,0],["وكم وَرَدْتُمْ صَفْوَنا ولم نَرِدْ","مِن صَفوكمْ إلّا أُجاجاً قد أَسِنْ",76,"ن",1,0],["وكم وَلَجتَ وما شاورتَ صاحبَه","قصْراً على بابه الحرّاسُ والخدمُ",77,"م",1,0],["وَكَم ولدوا من لابسٍ مِيسَمَ العُلا","يَبُذُّ وليداً في الجهاتِ الأشامطا",78,"ط",2,0],["وَكَم وَرَدْنا وَما تُغْنِي ورادَتنا","إنّا وردنا وأُعْفُوا مُرَّ ما وردوا",79,"د",3,0],["وكمْ ولَجْنَ شديداتٍ صَبَرْنَ بها","حَتّى نَجونَ كِراماً بالحُشاشاتِ",80,"ت",1,0],["وَكَم وَردتهُ رِكابُ العُفاةِ","فَأَصدرتها بِبلوغِ المُنى",81,"ا",1,0],["وكم واجدٍ ما لم يكن طالباً لهُ","وكم طالبٍ ما ليسَ يُدرِكُ بالجَهدِ",82,"د",1,0],["وكَمْ وكَمْ صدَّت بِوادِي الكَرى","طيفَ خَيَالٍ جاءَني من خَلِيلْ",83,"ل",1,0]]}