187310",""],[5704,"على موانىء الرحيل ٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=204262",""],[5785,"متى متى يا قرة النواظر","https://www.poetsgate.com/ViewPoem.aspx?id=131564",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5829,"اليرموك في ذكرى بدء التحرير","https://www.poetsgate.com/ViewPoem.aspx?id=204254",""],[6024,"قوس الحاجب","https://www.poetsgate.com/ViewPoem.aspx?id=186344",""],[6093,"هبوا إلى السيف ( البسيط )","https://www.poetsgate.com/ViewPoem.aspx?id=176038",""],[6115,"زلة الرفيق","https://www.poetsgate.com/ViewPoem.aspx?id=180512",""],[6115,"رجل كما الصقر يطلع فوق","https://www.poetsgate.com/ViewPoem.aspx?id=181733",""],[5309,"عشقنا وللعشاق في حبهم سر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573541",""],[520,"لك الحسب الباقي في عقب الدهر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577546",""],[520,"أيا اذن الأيام ان قلت فاسمعي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577575",""],[6225,"معركة الكرسي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80900&r=&rc=169",""],[6261,"الأستاذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82131&r=&rc=3",""],[572,"لستُ على عذلِكَ صَبَّارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9316&r=&rc=173",""]],"verses":[["وَكَم واضِحٍ مِنكُمُ كَالهِلا","لِ هالَت يَدايَ عَلَيهِ الكَثيبا",0,"ب",2,0],["وَكَمْ وَلَدا مِنْ صَائِبِ الرَّأْيِ حَازِمٍ","وَمِنْ أَرْيَحِيٍّ وافِرِ العِرْضِ ماجِدِ",1,"د",1,0],["وكمْ وثِقَتْ بالنّصْرِ منْكَ كَثيبةٌ","بعثْتَ بِها لا تعرِفُ الجَهْدَ والوَنْيا",2,"ي",2,0],["وكم وكم لوناً مضى عهده","وطعمه في ذوقنا لم يزل",3,"ل",1,0],["وكم وعدوا بني قحطان وعداً","به انقلب اليقين إلى شكوك",4,"ك",1,0],["وكم واشٍ وشى بكِ غير آلٍ","فآب وحظُه تَعْس ونكس",5,"س",1,0],["وكم واهن الركن أنهضتَه","إليك بقوة أركانكا",6,"ك",2,0],["وكم واعدٍ عدلاً على خلطائه","إذا قُلّد الأحكامَ تاب من العدلِ",7,"ل",1,0],["وكم واعدتنا يا عدل وصلاً","وجوناه فلم تنل الوصالا",8,"ل",2,0],["وَكَم وَكَم حاجَةٍ سَمَحتَ بِها","أَقرَبُ مِنّي إِلَيَّ مَوعِدُها",9,"د",3,0],["وكم وراءَ لآلِي الثغرِ من كُرَعٍ","عذبِ المشارعِ فيه ريُّ ظمآنِ",10,"ن",1,0],["وَكَم وَعَدتَ وَأَنتَ الغَيثُ نَعرِفُهُ","مُذ حالَفَ الجودَ يُعطي فَوقَ ما يَعِدُ",11,"د",1,0],["وكم وَصَلْتُ الوَجيفَ مُنْتَجِعاً","جَدْوى ابنِ فَهدٍ فرُحْتُ مُنتَجِعا",12,"ع",2,0],["وكَم ومَضَتْ أسيافُهُ بمشارقٍ","فراعَ العِدا إيماضُها بمَغاربِ",13,"ب",1,0],["وَكَم وانٍ يَعُدُّ العَجزَ حِلماً","فَيَندَمُ وَالنَدامَةُ لا تُفيدُ",14,"د",1,0],["وَكَم وَكَم مِن دَلالٍ قَد شُغِفتُ بِهِ","مِنكُم مَتى يَرَهُ ذو العَقلِ يُفتَتَنُ",15,"ن",1,0],["وَكَم وَكَم مِن حُرَّةٍ حَواها","سَبِيَّةٍ وَزَوجُها يَراها",16,"ه",2,0],["وَكَم وَحَتّى أَهيمُ مِن وَلَهٍ","كَذي جُنونِ الخَبالِ مَمسوسِ",17,"س",1,0],["وَكَمْ وَقَفُوا بِأَبْوَاب النَّصارَى","عَلَى أسْيَافِهِمْ مُتَوَكِّلِينا",18,"ن",2,0],["وَكَم وَطِأَت أَقدامُنا في تُرابِها","جَبينَ أَخي كِبرٍ وَهامَةَ أَبلَجِ",19,"ج",1,0],["وَكَم وَتَرَت لِيَ النَّكَباتُ قَوساً","كَأَنَّ الدَهرَ يَطلُبُني بِوَترِ",20,"ر",1,0],["وَكَم وَجَم الفَتى مِن بَعدِ ضِحكٍ","وَأُضحِكَ بَعدَ إِفراطِ الوُجومِ",21,"م",1,0],["وَكَم واسِعِ الأَعطانِ تَجزَعُ نَفسُهُ","وَرَحبِ فُؤادٍ آلِفٍ ضيقَ أَعطانِ",22,"ن",1,0],["وَكَم وعدوا أن ينصفوني فما وفوا","وكم حلفوا أن يصدقوني فما بروا",23,"ر",3,0],["وكم وكم زوّج أو","طلق من حرائر",24,"ر",1,0],["وكم وضَعت مِنْ إصْبع فوقَ أنفها","وكم غمزَتْ أسوارُهَا بالحواجبِ",25,"ب",1,0],["وكم وكم ملَّ حادينا لجاجتنا","وما علينا إذا ما ملَّ حادينا",26,"ن",2,0],["وكم وثقت بالنصر منك كتيبة","بعثت بها لا تعرف الجهد والونيا",27,"ي",2,0],["وكمْ وكمْ ، والشَّباب يَدري","رُوَِّعَ ظبيٌ فَنُصَّ جيد",28,"د",1,0],["وَكمْ وَعدْتَ، وأنتَ الغيْثُ تعرِفُهُ،","مُذْ حالَفَ الجُودَ يُعْطي فوْقَ ما يعدُ",29,"د",1,0],["وكم وطِئَتْ أقدامُنا، في تُرابِها","، جبينَ أخي كِبْرٍ، وهامةَ أبلج",30,"ج",1,0],["وكم واهنِ الركن أنضتَه","إليك بقوة أركانكا",31,"ك",2,0],["وكم وَعَدَتْنا من مواعد لو وفت","بوأيٍ- فلم تنجَزْ قليلٍ غناؤها",32,"ا",3,0],["وكم وادع وثبته وتركته","حشاشته للحادثات نهاب",33,"ب",1,0],["وكًم وَهَبَت يُمنَاكَ ألفاً مُصَتَّماً","وكَم أعمَلتَ لُدناً وكَم نَحَرتَ بُدنَا",34,"ن",2,0],["وكم واهم في قصد عمرو وخالد","فإيَّاك لا يذهب بخاطرك الوهم",35,"م",1,0],["وَكَم وَحُضوري بِالمُنى مِثلُ غَيبَةٍ","هَمَمت بِإِعمالِ المَطيِّ لطَيبَةٍ",36,"ه",1,0],["وَكَم واتَنَ الأَوطانَ مِن ذي جَلادَةٍ","فَأَضحى بِها مِن غَيرِ سُقمٍ مُسَخَّدا",37,"د",2,0],["وكم وافد أغنيته وأعنته","فأصبح في عز بعزك دائم",38,"م",1,0],["وكم وردوا بحرا على كل سابح","وما صدروا الا وبحر الوى دم",39,"م",1,0],["وَكَم وَليّ رَعى شَعباً فَأَهلَكَه","تَرغي عَلى زُهدِهِ أَرياقُ عشّارِ",40,"ر",1,0],["وَكم وَقفَةٍ في رُبعِ زَحلَةَ أَطلَعَت","عَلَيكَ قَريضاً دونَهُ الماسُ وَالتبرُ",41,"ر",1,0],["وَكَم وَقفَةٍ فيها أَقَلَّ مُساعِدي","عَلى الدَمعِ اسعادي وَأَكثَر لومّي",42,"م",2,0],["وَكَم وَكَم بينَنا من مجهل درس","ومن فراسخ لا تحصى ومن برد",43,"د",1,0],["وَكَم وافاهُ ذو كربٍ وحُزنٍ","ففرَّج كربَه وأَزال حُزنا",44,"ن",2,0],["وكم وصفتك ما بين الأنام إلى","أن صار فيك العدى في الحال أنصارا",45,"ر",2,0],["وكم وهبتك قلبي","وقلت روحي فداك",46,"ك",1,0],["وكم وحّدوك وكم عدّدوك","فكان هداهم ضلال الهدى",47,"د",2,0],["وكم واقفٍ عند باب الصباح","وفي عَينهِ لهفةٌ للمساء",47,"ا",2,0],["وَكَم وَزَعنا مِن خَميسٍ جَحفَلِ","وَكَم حَبَونا مِن رَئيسٍ مِسحَلِ",48,"ل",1,1],["وكم وَدَّ قلبي أن يَرى المجدَ رُؤيةً","إلى أن بَلغْتُ اليوم بالقلبِ وُدّه",49,"د",2,0],["وكم وزنت ميلاتُه من دقائقٍ","نُميِّز فيها بين سالٍ وسالك",50,"ك",1,0],["وكم وكم قلد القلائد من","أنظاره والغريب من حكمه",51,"م",2,0],["وكم وكم أسرد من ذا الذي","ليس له من سامع ملتقا",52,"ق",2,0],["وكم وقفة لي بتلك الدِّيار","أُداري بهنَّ الأَسى والهموما",53,"م",2,0],["وكم وقعةٍ شبَّت وشبَّ ضرامها","وشابَ لها نصل الظُّبا وهو أَمرد",54,"د",1,0],["وكم وَطِئَتْ مساعِيكَ السَّوامي","بأَخْمَصِها على لِمَمِ المساعي",55,"ع",2,0],["وكم وقفة للّه ينجاب ليلها","وقد اسلم الكفار للقتل والأسر",56,"ر",1,0],["وكَمْ وَصَلَتْهُ بالكواكِبِ هِمَّةٌ","تُجَلّي إلى الآفاقِ أينَ مَغارُهُ",57,"ر",2,0],["وكم وُقِيَتْ رِكابٌ يَمَّمَتْهُ","سِهامَ النائِباتِ بلا وِقاءِ",58,"ا",2,0],["وكم وَصَلُوا بك قلباً كريماً","وكم شَرَحُوا لَكَ صدراً وَدُودا",59,"د",2,0],["وكم وَجَّهُوا وَجْهاً لبارِقَةِ الظُّبى","وكم وَطَّنُوا نَحْراً لِنافِذَةِ النَّحْرِ",60,"ر",1,0],["وكم وَفى ليَ فِيهِ من حبيبِ هوىً","خَلَعتُ فِيهِ عِذاري فَهو خالِعُهُ",61,"ع",2,0],["وكم وردت على عقبى الظما حرضا","وللسراب يلاميع على الشهب",62,"ب",1,0],["وكم وردت وأصحابي من الشعرا","ماء أمر من الدفلي والصبرا",62,"ر",2,0],["وكم وردنا قبا بالأنيق الشنف","وماء مران تجري غير ذي وطف",62,"ف",1,0],["وكم وردنا على عقبى نوى قدف","عرقاً وردناه للإحرام في عصب",62,"ب",1,0],["وكم وكم أبلست في يوم ذي جذل","أهل الفصاحة نهش فصاحته",63,"ت",2,0],["وكم وكم دول من بعدها درجى","هامت بليلاي في سر وإعلان",64,"ن",1,0],["وكم وعَدتْ بك الآمالُ نفسي","ويقضي الدهر أن تُلْوىَ الوُعودُ",65,"د",1,0],["وكم وراء رحيلي من مُحبَّرةٍ","روعَاءَ بارقةٍ بالشرِّ مِرْعادِ",66,"د",1,0],["وكم وردت دياراً تُرْبها فُرشٌ","ثم أنثنيت وأعلى تُربها رِمَمُ",67,"م",1,0],["وكم وفرَ الجودُ عرض أمرئ","شراه وأمواله تنهك",68,"ك",1,0],["وكم وقفتُ على عافٍ فأطربني","منه فصاحة ذاك العيّ واللّكن",69,"ن",1,0],["وكم وقفتُ به مِنْ وقفةٍ صدعتْ","قلبي وقد أزمعَ الحبابُ أو ساروا",70,"ر",3,0],["وكم وراء سترها لاحت لهم","فذهلوا حين زأوا خيالها",71,"ل",3,0],["وكم وَقفةٍ معروفةٍ في العِدا له","لها مثَلٌ في سائِرِ النّاس سائِرُ",72,"ر",1,0],["وكم وقعة عذراء لما فضضتها","بسيفك لم تترك لغيرك من عذر",73,"ر",1,0],["وَكَم وَعَدَ الأَقوامَ موسى بِبَعثِهِ","وَكَم قالَ عيسى إِنَّهُ غَيرُ لابِثِ",74,"ث",1,0],["وكَم وكَم وكَم وكَم","مِن مُعجِزاتِ الأدبِ",75,"ب",1,0],["وكم وَرَدْتُمْ صَفْوَنا ولم نَرِدْ","مِن صَفوكمْ إلّا أُجاجاً قد أَسِنْ",76,"ن",1,0],["وكم وَلَجتَ وما شاورتَ صاحبَه","قصْراً على بابه الحرّاسُ والخدمُ",77,"م",1,0],["وَكَم ولدوا من لابسٍ مِيسَمَ العُلا","يَبُذُّ وليداً في الجهاتِ الأشامطا",78,"ط",2,0],["وَكَم وَرَدْنا وَما تُغْنِي ورادَتنا","إنّا وردنا وأُعْفُوا مُرَّ ما وردوا",79,"د",3,0],["وكمْ ولَجْنَ شديداتٍ صَبَرْنَ بها","حَتّى نَجونَ كِراماً بالحُشاشاتِ",80,"ت",1,0],["وَكَم وَردتهُ رِكابُ العُفاةِ","فَأَصدرتها بِبلوغِ المُنى",81,"ا",1,0],["وكم واجدٍ ما لم يكن طالباً لهُ","وكم طالبٍ ما ليسَ يُدرِكُ بالجَهدِ",82,"د",1,0],["وكَمْ وكَمْ صدَّت بِوادِي الكَرى","طيفَ خَيَالٍ جاءَني من خَلِيلْ",83,"ل",1,0],["وكم وكم نبغت فيها فلاسفة","قد نافسوا علماء الغرب بالكتب",84,"ب",1,0],["وكم وكم في بلاد القطر قد رفعت","يداك للعدل والأنصاف بنيانا",85,"ن",2,0],["وَكَم وَقَفوا يَستَنصِفونَ عَدُوَّهُم","وَهَزّوا مِنَ الأَملاكِ جَذعَ المَراحِمِ",86,"م",1,0],["وَكمَ وَقفَةٍ لِلِصَّبرِ عِندي وَلَيتَني","بِها والتَّأسّي والسُّلو قَتيل",87,"ل",1,0],["وَكَم وَرَدَ الهيمُ المياهَ خَوامِساً","فَيُشرَبُ أصفاها وَيَؤبى مَعُوفَها",88,"ف",3,0],["وكم وضعوا سكرجة بقية","فما منعته عن صحن الشعير",89,"ر",1,0],["وكم وقعتَ على صدري تدغدغه","وكم رشفتَ دموعاً رحتُ اذريها",90,"ي",3,0],["وكم وَافاكَ ويحك من نذيرٍ","وأخلصَ في نصيحتك المقاله",91,"ل",2,0],["وَكَم والَت مَكارِمُه كِراماً","وَأَولاهُم بِمَعروفٍ وَأَسدى",92,"د",2,0],["وَكَم وَجنَةٍ بِالخالِ كانَ جَمالُها","وَلَولا سَوادُ العَينِ لَم تحسن العينُ",93,"ن",1,0],["وكم وكم مُملقِ نال الغنى ولقد","أتاه خيرٌ ويسر بعد تعسير",94,"ر",1,0],["وكم واصلوا مطمعاً حرصاً وكم حرموا","وصارموا رحم المحروم والحرم",95,"م",1,0],["وكم وفي خضتها بنهد","عبل كسيد الفلاة سلهب",96,"ب",1,0],["وكم وردت بمعناه على ظما","من مورد ربه قد أورت اللهفا",97,"ف",2,0],["وكم وقته هجير الشمس سائرة","لها حنوّ وإتحاف وتضليل",98,"ل",1,0],["وكم وكم أبرأ من علة","وكم وكم كفى أمورا عظام",99,"م",1,0],["وكم وكم أظهر من معجز","أعجز والله جميع الأنام",99,"م",1,0],["وكم وكم لرسول الله معجزة","إعجازها في محيا الدهر قد رسما",100,"م",2,0],["وَكَم وكم فيه أقوام قدِ اِجتمعوا","بِه هنالك من نحوٍ ونعمانِ",101,"ن",1,0],["وَكم وطر قضيت بها وكم قد","لهوت بخرّد لدن القدودِ",102,"د",1,0],["وكم وليد سواه في حروبهم","قد ظل يسبق منه الشيب بالأجل",103,"ل",1,0],["وكم وكم منقبة سواها","على مدى الأيام لا ننساها",104,"ه",2,0],["وكم ولاه أحاط مولى","أصدره همه وأورد",105,"د",1,0],["وكمْ وَشَتْ بِي وبِها عُصْبَةٌ","كاذبةٌ خافِضَةٌ رافِعَهْ",106,"ع",2,0],["وَكَم وَعَدتِني بِتَوبٍ وَكَم","وَما أَنجَزَت وَعدَها في المَتابِ",107,"ب",1,0],["وَكَم وَقَفَت لِي بِالمَعَاتِبِ مِثلُهَا","عَلَى حِين لا شَيء عَلَى الصَّبرِ بَاعِثُ",108,"ث",1,0],["وكم وافى القيامة من مسىء","عميد القلب ملتاثِ اللسان",109,"ن",1,0],["وكم ورَّش الواشون بيني وبينها","وما نقصوا من حبها وزن حبة",110,"ه",1,0],["وكم وكم بعثت شمساً لترشيه","وردَّها بهلال من مواضيه",111,"ي",2,0],["وكم واقد جاءه يبتغي","رجاه ففاز بقصد وعاد",112,"د",1,0],["وكم وكم ثم من صنوف","في العد جلت عن انحصار",113,"ر",1,0],["وكم وردا له رأياً نجيحاً","وكم سلكا به سبلاً قواما",114,"م",2,0],["وكم وكم له مناقب ماضيه","فمن مراده عليها الإطلاع",115,"ع",1,0],["وكم وكم لغضبة قد وقط","لا مثله صاعقة العذاب قط",116,"ط",1,0],["وكم وَكَفَت من كَفِّ يُمناكَ دِيمةٌ","ففاضَت بُحُورُ العُرفِ مِن هَطَلاَنِهَا",117,"ن",3,0],["وكم وَشَتِ العُذَّالُ بيني وبينها","فقلت دعوني إنني لستُ أسمَعُ",118,"ع",1,0],["وكم ولد من والديه أخذته","وكم من وليد قد تركت يتيم",119,"م",1,0],["وكم وكم راحةٍ نيلت براحتهِ","وراح عن ذي السقامِ السُقمُ والضَررُ",120,"ر",1,0],["وكم وكم راحةٍ براحتهِ","نيلت وأذهَبَ لمسُها ضَرَرا",121,"ر",2,0],["وكم وكم لك في الأحكام من حكم","بذكرها يتناغى الشام واليمن",122,"ن",1,0],["وكم وقف أبادوه وشادوا","بغلته كما شاؤوا عماره",123,"ر",2,0],["وكم ود بدر النم حين حجبتها","رجال حفاة ان يكون نعالها",124,"ل",3,0],["وَكَم وَلَع الزَمان بِهَضم حُرٍّ","يُطاولُ همَّةً هامَ السِماك",125,"ك",1,0],["وكم ولي الاحكام من متصرف","حكيم له من حزمه والنهى جند",126,"د",1,0],["وكم وكم من صفات جل بارئها","تزرى بشمس الضحى حسنا فتسبينا",127,"ن",2,0],["وكم وكم من أمور ليس يحصرها","عدو لو رحت تحصيها لما نفذت",128,"ت",1,0],["وكم واشٍ لحاه اللَه يسعى","ليقطع من مودتنا حبالا",129,"ل",2,0],["وكم وكم حط الهجا من ماجد","ذي رتبة قعسا وقدر سمق",130,"ق",1,0],["وَكمْ وَكمْ أسهرُ في خدمة ال","عُشّاقِ في الليلِ إلى بُكْرَه",131,"ر",2,0],["وكم وكم منكم صباح مسا","للشر داع للخير مناع",132,"ع",1,0],["وكم وجمة بالعاصفات تبطنت","وكم بسمة فيها دموع الحشا تهمي",133,"م",2,0],["وكم وصلت اهل الصلاح بخيرها","كما فصلت أهل المفاسد والشر",134,"ر",1,0],["وكم وقيت الردى من بت مضطربا","في اسرة المر لم أظفر بإطلاقي",135,"ق",2,0],["وكم ودوا الشقاء لاهل مصر","كما شقيت بظلمهم الهنود",136,"د",1,0],["وكم وكم حوت ا