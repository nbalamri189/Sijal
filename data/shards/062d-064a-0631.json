oetsgate.com/ViewPoem.aspx?id=181523",""],[6068,"حيرانُ -05-","https://www.poetsgate.com/ViewPoem.aspx?id=175951",""],[6124,"نكتب الأوتار","https://www.poetsgate.com/ViewPoem.aspx?id=121830",""],[6127,"يا ماشياً نحو الطفوف","https://www.poetsgate.com/ViewPoem.aspx?id=192767",""],[6131,"عَينايَ زرقاءُ اليَمامةْ","https://www.poetsgate.com/ViewPoem.aspx?id=189287",""],[4115,"حير عقلي ذا الكتاب الأنيق","http://www.aldiwanalarabi.com/poemDescription.do?poemId=607583",""],[243,"يا نهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68172&r=&rc=164",""],[5355,"لولا المحبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87120&r=&rc=15",""],[6242,"التِّمثال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87561&r=&rc=8",""],[6275,"سنوات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83611&r=&rc=3",""],[6341,"من أي السماء؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87278&r=&rc=7",""],[6345,"أنشودة للناي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78652&r=&rc=23",""],[6345,"ارحل ....","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78651&r=&rc=22",""],[6346,"يحنو الهجير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83390&r=&rc=6",""],[572,"وليلة ٍ فيها قَصُرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9293&r=&rc=150",""]],"verses":[["حيرى يُعَنِّفُها بالسَّوطِ بعدَكَ من","بالأمسِ دون حُدودِ الله قد جُلِدا",0,"د",2,0],["حَيرى يُضِلّونَها ما بَينَنا وَلَهاً","مِنّا عَلى عُدَواءِ الدارِ نِشدانُ",1,"ن",1,0],["حَيرَةُ المِصباحِ تَزهوهُ الصَبا","خَلَلَ الظَلماءِ يَخبو وَيَقِد",2,"د",1,0],["حيّرتنا لما أرتنا عجيباً","فعجيباً من رقصها فعجيبا",3,"ب",2,0],["حيران منبجس الكلى عصفت","بعد الهدوء عليه زَعزعه",4,"ع",2,0],["حَيرانُ لا يَدري أَيَقتُلُ نَفسَهُ","عَمداً فَيَخلُصَ مِن أَذى الدُنياءِ",5,"ا",2,0],["حَيرانُ يُقعِدُهُ الهَوى وَيُقيمُهُ","فَكَأَنَّهُ عَلَمٌ يُداعِبُهُ الهَوا",6,"ا",1,0],["حَيرَةٌ لَيسَ لَها مَثَلٌ سِوى","حَيرَةِ الزَورَقِ في طاغي العُبابِ",7,"ب",1,0],["حَيرانُ مُضطَرِبُ اخُطى فَكَأَنَّما","قَد راحَ يَمشي فَوقَ جَمرٍ صالِ",8,"ل",1,0],["حَيرانُ لا أَعرِفُ ما","أَقصِدُهُ مِن طُرُقي",9,"ق",2,0],["حيرتك الحياة وهي لعمري","ليس الا تطوراً في الجماد",10,"د",1,0],["حَيرانُ مَشبوبُ المَضاجِعِ لَيلُهُ","حَربٌ وَلَيلُ النائِمينَ سَلامُ",11,"م",1,0],["حَيرانُ القَلبِ مُعَذَّبُهُ","مَقروحُ الجَفنِ مُسَهَّدُهُ",12,"د",2,0],["حيرانُ نطفة خِّدهِ فكأنهُ","ماءٌ يُذَمُّ على قِراهُ وقائعُ",13,"ع",1,0],["حَيَّ ربعاً لهنَّ يَزدادُ حُسْناً","وَمَحَلاً منهن يزدادُ طِيبا",14,"ب",2,0],["حيران من مرضٍ إلى بؤس إلى","كربٍ تمر به بلا تعدادِ",15,"د",1,0],["حَيرانَ يَحسَبُ سَجفَ النَقعِ مِن دَهَشٍ","طَوداً يُحاذِرُ أَن يَنقَضَّ أَو جُرُفا",16,"ف",2,0],["حَيِّ رَبعاً أَقوى وَرَسماً مُحيلا","وَعِراصاً أَمسَت لِهِندٍ مُثولا",17,"ل",2,1],["حَيرى بِمُضطَرِبِ الحَياةِ يَروقُها","أَلا تَزالَ عَلى الشُعوبِ عِيالا",18,"ل",2,0],["حَيرانُ يُضني ثِقلُهُ","هَوجَ الرِياحِ العُصَّفا",19,"ف",2,0],["حَيِّ رَبعَ الغِنى وَأَطلالَ حُسنِ ال","حالِ أَقوَينَ مِن زَمانٍ وَدَهرِ",20,"ر",1,1],["حيرِيَّةٌ كَشُعاعِ الشَمسِ صافِيَةٌ","يُحيطُ بِالكَأسِ مِن لَألائِها شُعَلُ",21,"ل",1,0],["حيرِيَّةُ الحُسنِ كَيانِيَّةُ ال","أَردافِ في أَلِيَّةٍ عاجِيَّه",22,"ي",2,0],["حَيرانُ أَنتَ فَأَيَّ الناسِ تَتَّبِعُ","تَجري الحُظوظُ وَكُلٌّ جاهِلٌ طَبِعُ",23,"ع",1,1],["حَيرانُ لا تلْقَاهُ إلاّ قلتَ مِنْ","كُلّ الجهاتِ أرى بِه جَبّاذا",24,"ذ",2,0],["حَيِّ رَبْعِيّ الحَيا رَبْعَ الحَيا","بأبي جِيرَتنا فيه وَبَي",25,"ي",1,0],["حيرَتي بينَ قضاءِ جيرَتي","من ورائي وهوى بينَ يَدَيْ",25,"ي",1,0],["حيرة في الحياة قد صدفتني","عَن بُلوغي من الحَياة مَرامي",26,"م",2,0],["حيرانَ يتبعُ حيرةَ الأرضِ","ومصارعَ الأيامِ والأُمَمِ",27,"م",1,0],["حيرى تحوم الليلَ كالمستهامْ","أسهرهُ الثائرُ من شوقهِ",28,"ه",1,0],["حيران يذهب في السماء ويبحث","ويثير وجه الأرض عنك ويبحث",29,"ث",1,0],["حيران ليس لدائه إبراء","عن هذه الأنوار يعشى يوشع",29,"ع",1,0],["حيران! من أيّ الكنوز","يلمُ حبّات الجمانْ!",30,"ن",1,0],["حيرَى تلوذُ بآمالٍ محطَّمةٍ","كما يلوذُ غريمٌ بالمواعيد",31,"د",1,0],["حيرانَ أضرِبُ كفي","أسىً وأقرَعُ سِنّي",32,"ن",2,0],["حَيْرَانُ يعثُرُ بالأعِنَّةِ مثلَما"