{"poems":[[74,"عجبت خلتي لوخط مشيبي","https://www.aldiwan.net/poem18228.html","الخفيف"],[91,"مات سعد فما عسى أن تقولا","https://www.aldiwan.net/poem44613.html","الخفيف"],[87,"بين سمع الله والبصر","https://www.aldiwan.net/poem7590.html","المديد"],[63,"عش مدى الدهر يا أبا إسحاق","https://www.aldiwan.net/poem51505.html","الخفيف"],[99,"بين سهد وعذاب وضنى","https://www.aldiwan.net/poem24860.html","الرمل"],[108,"معجزة السد","https://www.poetsgate.com/ViewPoem.aspx?id=179335",""],[119,"يا بويرق الحمى","https://www.aldiwan.net/poem41233.html","عموديه"],[159,"وحديث كأنه","https://www.aldiwan.net/poem55700.html","مجزوء الخفيف"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[261,"كأنما باب استها","https://www.aldiwan.net/poem48363.html","مجزوء الرجز"],[369,"قربا لي يا صاحبي بعيدا","https://www.aldiwan.net/poem60938.html","الخفيف"],[385,"يا رياح الفجر من نحو الحمى","https://www.aldiwan.net/poem48786.html","الرمل"],[386,"هاج رسم دارس طرباً","https://www.aldiwan.net/poem400.html",""],[457,"قم بنا يا نديم فالطير غرد","https://www.aldiwan.net/poem13736.html","الخفيف"],[473,"نحن في روض نضير","https://www.aldiwan.net/poem60132.html","مجزوء الرمل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104556","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63743","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64038","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59644","الرمل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120047","المديد"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136235","الخفيف"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49940","الخفيف"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49995","المنسرح"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49578","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77211","الخفيف"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132322","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130781",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216576","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131256",""],[3984,"","https://poetry.dctabudhabi.ae/diwan/poem/147201","الخفيف"],[5111,"جلالُ الرُّوحِ","https://www.poetsgate.com/ViewPoem.aspx?id=212313",""],[5213,"أشبه البدر طلعة وجمالا","https://www.poetsgate.com/ViewPoem.aspx?id=170532",""],[5302,"فؤاد شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=200489",""],[5409,"نكص الخصم عنك نكص الطريد","https://www.poetsgate.com/ViewPoem.aspx?id=155265",""],[5480,"سبعة قوافي","https://www.poetsgate.com/ViewPoem.aspx?id=35173",""],[5596,"إلى ابن مكتوم","https://www.poetsgate.com/ViewPoem.aspx?id=206174",""],[5976,"قصّة غَرَق .. !!","https://www.poetsgate.com/ViewPoem.aspx?id=30528",""]],"verses":[["بين سجادةٍ وبين كتاب","وسواه ما بين كأسٍ وكوب",0,"ب",1,0],["بين سعد ومصر جد الفراق","ليس هذا الفراق مما يطاق",1,"ق",1,0],["بين سمع الله والبصر","أنتِ يا محروسة النفر",2,"ر",1,1],["بينَ ساجٍ كأنَّه ذائبُ التَّبْ","رِ على مِثلِ ذائبِ الأوراقِ",3,"ق",1,0],["بين سهدٍ وعذابٍ وضنى","مرّ ليلي ذاك حالي وأنا",4,"ن",2,1],["بين سدٍّ على العُبَاب مُقَام","وقُصُور في جوفهِ غارقات",5,"ت",1,0],["بين سلم من الهوى","وهوان بحربه",6,"ب",2,0],["بَيْنَ ساقٍ وسامِرٍ","ومُغَنٍّ وزامِرِ",7,"ر",1,0],["بينَ سحرٍ لها ونحرٍ وفاةٌ","لكَ كانَت يا نعمَ هذا الوفاءُ",8,"ا",2,0],["بين سطور كاتبِ","حروفه محققه",9,"ق",2,0],["بين سُمْرٍ في الرَّوعِ يَحشِين أَحشا","ءً وبِيضٍ منهم يَرِدْن الوَريدا",10,"د",2,0],["بَينَ سَقم الجسم وَاللَحظ نَسب","أَفلا تَرعى لِذاكَ الذِمما",11,"م",2,0],["بَينَ سيلِ الواديَينِ كَما","نَمنَمَ ابنا مُنذِرٍ كُتُبا",12,"ب",2,0],["بين سوقٍ عُوجِ الرقاب لِطافٍ","أَثْقَلَتْها أهلّةٌ من زبرجدْ",13,"د",1,0],["بَينَ سُحبٍ مِن كُؤوسٍ","وَبُروقٍ مِن خُمورِ",14,"ر",1,0],["بين ساقٍ ومطربٍ ونديمٍ","وأقاحٍ ونرجسٍ وبهارِ",15,"ر",1,0],["بين ساداتِنا من العَقَبيّ","ينَ الأولى همُ شُموسُنا والبدور",16,"ر",1,0],["بينَ سروٍ مكلَّلٍ","بالحمام الهواتف",17,"ف",1,0],["بين سَلع والغضا حِقفُ نقىً","بدرُ تَمٍّ غُصنُ دَوْح مُثمر",18,"ر",1,0],["بين سر الوجد والعلن","ضاع صبري في الهوى وفني",19,"ن",2,1],["بين سر العيان معنى تجلى","في فواد قد زال مانع لبسه",20,"س",2,0],["بين سِربٍ من المَهى يَطَّبيني","سِحْرُ أَجفانها المراضِ الصِّحاحِ",21,"ح",1,0],["بين سَراياهُم يُرى لهمُ","ألويةُ المُلكِ وهيَ تَخْتَفقُ",22,"ق",1,0],["بَيْنَ سُمْرِ القَنَا وبَيضِ النّصَالِ","طُرَقُ المُهْتَدينَ والضُلاَّلِ",23,"ل",1,1],["بَينَ سَطرٍ مِنَ الحِسانِ بَدَت","قَدُّها مِن حُروفِهِ الأَلِفُ",24,"ف",1,0],["بينَ سُمرِ القَنَا وبيضِ الصِّفَاحِ","مُنيَةُ النَّفسِ نُزهَةُ الأَرواحِ",25,"ح",1,1],["بين ساعات فترةٍ من حياتي","هي منها وغيرها محسوب",26,"ب",1,0],["بين سخطين من صحابٍ غضاب","أين يمضي وعيلم تيهور",27,"ر",1,0],["بين سيفٍ ومدفعٍ ورصاصٍ","ما ترى العين غير جرحى وقتلى",28,"ل",2,0],["بين سُكْرٍ على الحروفِ وَصَحوٍ","لصداها في محفلِ الشيطانِ",29,"ن",1,0],["بَيْنَ \"سَعْدٍ \"وَطُيُوْفٍ","يَتَهَادَى كَوْكَبَانِ",30,"ن",1,0],["بين سلسال مرشفيه شفائي","لو يذوق الفؤاد منه الزلالا",31,"ل",2,0],["بين سحر البيان والقلب عشق","زاغ عنه مع الحداثة خاسر",32,"ر",1,0],["بين ساقٍ مقبوضة في فناء","وذراعٍ مبسوطة بوصيد",33,"د",1,0],["بين ساعة يختلف وضع المُنى","وايتردى يعل غيره ما يزيد",34,"د",1,0],["بين سبعٍ من الإمارات أعلت","راية الإتحاد فهو عَلاء",35,"ا",2,0],["بين سكرة هاجسي بك .. واشتياقي .. مفترق ..","للدروب اللي تقرّب .. والدروب اللي تعوق",36,"ق",1,0]]}