495,"أيا دمع إن لم ينجد الصبر أنجد","https://www.aldiwan.net/poem9817.html","الطويل"],[500,"كثر الصنوف وأنت أنت الواحد","https://www.aldiwan.net/poem37565.html","الكامل"],[500,"تركونا أي قوم تركوا","https://www.aldiwan.net/poem37930.html","الرمل"],[505,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[514,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"],[514,"إلى الله نشكو فادحات النوائب","https://www.aldiwan.net/poem20840.html","الطويل"],[551,"ما رأتني عيناك يوم الفراق","https://www.aldiwan.net/poem47357.html","الخفيف"],[551,"حييت يا ربع اللوى من مربع","https://www.aldiwan.net/poem47702.html","الكامل"],[558,"يا مرحبا يا مرحبا يا","https://www.aldiwan.net/poem34742.html","الكامل"],[563,"هو الموت عضب لا تخون مضاربه","https://www.aldiwan.net/poem13604.html","الطويل"],[564,"سرور المعالي عاد والعود اجمل","https://www.aldiwan.net/poem884.html",""],[564,"سقاك الله كاسات الغرام","https://www.aldiwan.net/poem886.html",""],[585,"لقد سمح الدهر بالمقترح","https://www.aldiwan.net/poem1571.html",""],[586,"طرف تعرض بعدكم لهجوع","https://www.aldiwan.net/poem17592.html","الكامل"]],"verses":[["فَتَبَرُّضُ الأَطماعِ مِث","لُ تَبَرُّضِ الثَمَد الجَرورِ",0,"ر",1,0],["فتَبَصرتُ فَلَم تؤْنِسْهما","مُقلَةٌ في وَشَلِ الدَّمعِ سَبوحُ",1,"ح",1,0],["فَتَبّاً لِدَهرٍ قَدَّمَتهُم صُروفُهُ","وَما خَيرُ دُنيا هَؤلاءِ مُلوكُها",2,"ه",2,0],["فتبَرُّضُ العافي عُفافَةَ مِنْحَةٍ","يَحْبو بِها اللّؤَماءُ شَرُّ مَعاشِ",3,"ش",1,0],["فَتَباكَينَ ثُمَّ قُلنَ وَأَخلَص","نَ لَها في الدُعاءِ غَيرَ هَوازي",4,"ي",1,0],["فَتَبَلَّجَتْ لَهُمُ حِلاكَ وَعِنْدَهُمْ","أَنَّ السَّمَاحَ بِنَظْرَةٍ إِنْعَامُ",5,"م",1,0],["فَتَبدُّلْ مِنْ شِقْوَةٍ قَدْ تَقَضَّتْ","مَا سَيَبْقَى مِنْ نَضْرَةٍ وَنَعِيمِ",6,"م",1,0],["فَتَبَادَرَ الخَدَمُ الوُقوفَ وَأَحْضَرُوا","لَبَناً زَكِيّاً نَاصِعَ المُتَوَسمِ",7,"م",1,0],["فَتَبَيَّنُوا أَنَّ الحياة حَقَائِقٌ","لاَ نَضْرَةٌ مَوْهُومَةٌ وَنَعِيمُ",8,"م",1,0],["فتبوّءوا جنّاتهنّ أنيقةً","وابنوا بهنّ كأكرم البنيان",9,"ن",1,0],["فتُبكي هزاهزنا المغربا","وتُضحك أسيافنا المشرقا",10,"ق",2,0],["فتُبصِرَ أيقاظاً يُطيعون هُجَّداً","وتبصرَ أحراراً يخافون أعُبدا",11,"د",2,0],["فتبقى عندك الأرواحُ منَّا","تُصان فلا ترى جَنَفًا وهُونًا",12,"ن",2,0],["فَتُب قَبلَ المَماتِ وَقَبلَ يَومٍ","يُلاقي العَبدُ ما كَسَبَت يَداهُ",13,"ا",2,0],["فتبسمتُ لها فابتسمتْ","وأجالتْ فيَّ ألحاظًا كُسالى",14,"ل",2,0],["فتباشرنَ بي وأشرفنَ نحوي","بشهيقٍ وزَفرةٍ وانتحابِ",15,"ب",1,0],["فتبيتان في فضائح شُنعٍ","لم يكن ليلُها عليك ليغطو",16,"ط",2,0],["فتبركُ فوق صفحتِها بُروكاً","كما برك البعير على الخبيط",17,"ط",1,0],["فتبرَّئي من واشيَيْ","كِ فليس تركُهما بلوم",18,"م",1,0],["فتبسمت علماً بصد","قك وانقطعْتَ إلى الوُجوم",18,"م",1,0],["فُتْ بلذَّاتك العواذل والعَذْ","لَ وإلا فاتَتْ بها الأيام",19,"م",1,0],["فَتَبَسَّمَت وَبَدا الرِضى في وَجهِها","إِذ راقَها التَمثيل وَالصَويرُ",20,"ر",1,0],["فتبكي بكاءَ الغريب الوحيدِ","بشجْوٍ كَظيمٍ ونَوْحٍ ضَعيفْ",21,"ف",1,0],["فَتَبَسَّمَ الثُّعبانُ بَسْمةَ هازئٍ","وأجابَ في سَمْتٍ وفَرْطِ كِذابِ",22,"ب",1,0],["فَتَبكي بِدَمعٍ لَيسَ للقطرِ مِثلُهُ","وَتَزجُرُها التَقوى فَتُصغي إِلى الزَجرِ",23,"ر",1,0],["فتبصّروا يا قوم في أحوالكم","وتنبَّهوا من غفلة ورقود",24,"د",1,0],["فَتَبَسّمَتْ فبكيتُ قالتْ لا تُرَعْ","فلَعَلَّ مثلَ هواكَ بالمُتَبَسِّمِ",25,"م",1,0],["فَتَبيتُ تُسئِدُ مُسئِداً في نَيِّها","إِسآدَها في المَهمَهِ الإِنضاءُ",26,"ا",2,0],["فَتَبّاً لِدينِ عَبيدِ النُجومِ","وَمَن يَدَّعي أَنَّها تَعقِلُ",27,"ل",1,0],["فتبِعتُهُمْ أنا والرفيقُ ومقلةٌ","تَذري النجيعَ وأريحيٌّ بازلُ",28,"ل",1,0],["فَتَبلُغُ فيهِ أَقصى كُلِّ حالٍ","تُقَدِّرُ نَيلَهُ في الإِنتِهاءِ",29,"ا",2,0],["فَتَبّاً لَهُ أَيَّما رَفعَةٍ","رَآها لِمَن نيكَ حَتّى بَذَخ",30,"خ",1,0],["فتبّاً لها إذ تابَ من نَقْرِ دُفِّهِ","ولا سُقِيَت صَوبَ الغُيوثِ الرَّواجِسِ",31,"س",1,0],["فتُبعثوا وتكونوا في اللِّقاءِ يداً","إنَّ الحِمامَ إلى أرواحكم سَغِبُ",32,"ب",1,0],["فَتَبَدَّلَت مِن بَعدِنا أَو بُدِّلَت","وَوَشى وُشاةٌ بَينَنا أَعداءُ",33,"ا",2,0],["فَتَبَّعَ آثارَ الشِياهِ وَليدُنا","كَشُؤبوبِ غَيثٍ يَحفِشُ الأُكمَ وابِلُه",34,"ل",2,0],["فَتَبارَكَ اللَهُ الَّذي هُوَ لَم يَزَل","مَلِكاً بِما تُخفي الصُدورُ عَليما",35,"م",2,0],["فَتَباطا بِها فَقُلتُ أَدِرها","لَستَ ساقي وَلا قُلامَةَ ظِفري",36,"ي",1,0],["فتبينوا إذن الحقيقة واعلموا","أن الطبيعة هكذا من عادِ",37,"د",1,0],["فَتُب إِلى اللَهِ مِن تَحقيقِ باطِلِهِ","فَأَنتَ إِن تُبتَ عِندَ اللَهِ مَعذورُ",38,"ر",1,0],["فتبَسَّمَتْ وتَنَسَّمَتْ أرجاؤُها","أرجاً فما الغصنُ النضيرُ نظيرُها",39,"ر",3,0],["فَتَبَسَّمَت عَجَباً وَقالَت حَقُّهُ","أَن لا يُعَلِّمُنا بِما لَم نَعلَمِ",40,"م",1,0],["فَتَبِعتُهُم وَمَعي فُؤادٌ موجَعٌ","صَبٌّ بِقُربِهِمِ وَعَينٌ تَدمَعُ",41,"ع",1,0],["فَتَبسِمُ في حالَةٍ عَن رِضاً","وَتَنظُرُ آوِنَةً عَن غَضَب",42,"ب",1,0],["فَتَبِعتُهُنَّ لِنِيَّةٍ شَحَطَت بِهِم","كَالنخلِ حانَ لِمُجتَنٍ أَرطابُهُ",43,"ب",2,0],["فَتَبِعتُهُم وَلَنِعمَ صاحِبُ واحِدٍ","في الوَحشِ يَبدُرُ قَبلَهُ أَصحابُهُ",43,"ب",2,0],["فَتَبادَرَت عَيناكَ إِذ فارَقتَها","دِرَراً وَأَنتَ عَلى الفِراقِ صَبورُ",44,"ر",1,0],["فَتَبَّعتُهُم عَينَيَّ حَتّى تَفَرَّقَت","مَعَ اللَيلِ عَن ساقِ الفَريدِ الحَمائِلُ",45,"ل",1,0],["فَتَبَدّى لَهُنَّ بِالنَجَفِ المَقفِي","يُ ماءٌ صافي الجِمامِ غَرِيُّ",46,"ي",1,0],["فَتَبقَيانِ جَميعاً","وَيَنفَدُ الثُقلانِ",47,"ن",1,0],["فَتَبَرّا مِن مَحَبَّتِنا","وَأُراهُ كانَ كَذّابا",48,"ب",2,0],["فَتَبقى أَسهُمٌ سِتٌّ","تُجَزّا بَينَ عُشّاقِ",49,"ق",1,0],["فَتَبارَيا ما خيمَ بَرقُكُما","فَكِلاكُما مُتَدارِكُ السَجمِ",50,"م",1,0],["فَتَبادَروا طُرَفَ الثَناءِ بِفَضلِهِ","فَكَأَنَّما نَشَروا الثَناءَ بُرودا",51,"د",2,1],["فَتَبِعتُ الفُؤادَ حينَ تَأَلّى","في هَواهُ فَلَم أُوافِق سُعودا",52,"د",2,0],["فَتَبَدَّلَت سُعدى بِشيمَتِها","شِيَماً لِتَكدَحَ غَيرَ ما كَدَحا",53,"ح",2,0],["فَتَبارَكَ اللَهُ الَّذي هُوَ قادِرٌ","تَعيا وَتَقصُرُ دونَهُ الأَوصافُ",54,"ف",1,0],["فتبوأت جدثاً به نامَت سقى","جدثاً به نامَت سعاد سحاب",55,"ب",1,0],["فتبسمت يوم كنت صَحيحاً","وَتبسمت يوم كنت عَليلا",56,"ل",2,0],["فَتبلى لحومك في جوفها","وَتبلى جلودك والأعظم",57,"م",1,0],["فتبيَّنتُ في الشواطىء حولي","أثراً من غرامنا المأثورِ",58,"ر",1,0],["فَتَبَادَرَ الفِتْيَانُ مِن","جَنَبَاتِهِ أَشْهَى المَطَاعِمْ",59,"م",1,0],["فتبرّمتُ بالسَّكينةِ والضَّجَّةِ","بل قَدْ كَرِهْتُ فيها نصيبي",60,"ب",2,0],["فَتَبَّاً لَهُمْ مِنْ مَعْشَرٍ لَيْسَ فِيهِمُ","رَشِيدٌ وَلا مِنْهُمْ خَلِيلٌ مُصَادِقُ",61,"ق",1,0],["فَتُبْ إِلى اللهِ قَبْلَ مَنْدَمَةٍ","تَكْثُرُ فِيها الْهُمُومُ والْكُرَبُ",62,"ب",1,0],["فَتَبَّاً لَهُمْ مِنْ مَعْشَرٍ نَزَعَتْ بِهِمْ","إِلَى الْغَيِّ أَخْلاقٌ نَبَتْنَ عَلَى غِمْرِ",63,"ر",1,0],["فَتَبِعْتُ مَسْرَاها عَلَى عَجَلٍ","حَتَّى ظَفِرْتُ بِنَظْرَةٍ خَلْسِ",64,"س",1,0],["فَتَبِيتُ صِفْرَ يَدٍ وَكُنْتَ مَلِيَّهَا","وَتَذُوقُ كُلَّ مَرَارَةِ الإِقْتَارِ",65,"ر",1,0],["فَتَبْلُغُ التَّأَدِيبَ مُسْتَوْفِياً","تَمَامَهُ بِالأَدَبِ الْوَافِرْ",66,"ر",1,0],["فَتَبَدَّلَتْ أَفْرَاحُهُمْ فِي لَحْظَةٍ","بِمَنَاحَةٍ وَسُرُورُهُمْ بِبُكَاءِ",67,"ا",2,0],["فَتَبِعْتُهَا مُتَضَائِلاً","أَمْشِي وَيَثْنِينِي الْحَيَاءْ",68,"ا",2,0],["فتبَاكَى خُدْعَةً لَكِنَّهَا","لمْ يَفُتْهَا مَا وَرَاءَ الْعَيْنِ عَبْرَى",69,"ر",2,0],["فَتَبَيَّنُوا الْعِبَرَ الْكِبَارَ بِهَا","لاَ تقْرَؤُنَّ كِتَابَهَا عَبْرَا",70,"ر",2,0],["فَتَبَوَّأ في الخُلدِ حَيثُ تَرى اللَ","هَ وَتَلقى نَبِيَّكَ المَحبوبا",71,"ب",2,0],["فتبارت عصائب الطير ما بين","شرود من الأذى ونفور",72,"ر",1,0],["فتبخرت تلك الوعو","دُ؛ كما تبخرت المياه",73,"ا",2,0],["فتَّبعتهمْ عينيَّ حتى تفرّقت","مع الليل عن سَاقِ الفَرِيدِ الجمايِلُ",74,"ل",1,0],["فتبادرت عيناك إذْ فارقتها","يوماً وأنت على الفراقِ صبورُ",75,"ر",1,0],["فتبنّى الصياع طفلا كسيحا","وأنا ، والأسى وأمّا فقيره",76,"ر",2,0],["فتبتدى الأشتات في أحرفي","ولادة فرحى ، وحملا وجيع",77,"ع",1,0],["فتبارت أذناب \" لندن \" تزري","باسمة فازدهى اسمه وتلالا",78,"ل",2,0],["فتبعت بالفؤاد حين تألى","في هواه فلم أوافق سعودا",79,"د",2,0],["فتبيَّنتُ في الشواطئ حولي","أثرًا من غرامنا المأثورِ",80,"ر",1,0],["فتبسّمت وبدا الرضى في وجهها","إذ راقها التمثيل والتصوير",81,"ر",1,0],["فتبصقه الريح ، من كل فج","وتمضغ في مقلتيه .. العتاد",82,"د",1,0],["فَتَبارك الرَحمَن ما أَحلاهُ مِن","رَشاء غَدا يَرعاهُ في الأَحشاءِ",83,"ا",2,0],["فَتُب إِلى اللَهِ وَاحذَر مِن ع