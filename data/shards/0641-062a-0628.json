ةٌ مَوْهُومَةٌ وَنَعِيمُ",9,"م",1,0],["فتبوّءوا جنّاتهنّ أنيقةً","وابنوا بهنّ كأكرم البنيان",10,"ن",1,0],["فتُبكي هزاهزنا المغربا","وتُضحك أسيافنا المشرقا",11,"ق",2,0],["فتُبصِرَ أيقاظاً يُطيعون هُجَّداً","وتبصرَ أحراراً يخافون أعُبدا",12,"د",2,0],["فتبقى عندك الأرواحُ منَّا","تُصان فلا ترى جَنَفًا وهُونًا",13,"ن",2,0],["فَتُب قَبلَ المَماتِ وَقَبلَ يَومٍ","يُلاقي العَبدُ ما كَسَبَت يَداهُ",14,"ا",2,0],["فتبسمتُ لها فابتسمتْ","وأجالتْ فيَّ ألحاظًا كُسالى",15,"ل",2,0],["فتباشرنَ بي وأشرفنَ نحوي","بشهيقٍ وزَفرةٍ وانتحابِ",16,"ب",1,0],["فتبيتان في فضائح شُنعٍ","لم يكن ليلُها عليك ليغطو",17,"ط",2,0],["فتبركُ فوق صفحتِها بُروكاً","كما برك البعير على الخبيط",18,"ط",1,0],["فتبرَّئي من واشيَيْ","كِ فليس تركُهما بلوم",19,"م",1,0],["فتبسمت علماً بصد","قك وانقطعْتَ إلى الوُجوم",19,"م",1,0],["فُتْ بلذَّاتك العواذل والعَذْ","لَ وإلا فاتَتْ بها الأيام",20,"م",1,0],["فَتَبَسَّمَت وَبَدا الرِضى في وَجهِها","إِذ راقَها التَمثيل وَالصَويرُ",21,"ر",1,0],["فتبكي بكاءَ الغريب الوحيدِ","بشجْوٍ كَظيمٍ ونَوْحٍ ضَعيفْ",22,"ف",1,0],["فَتَبَسَّمَ الثُّعبانُ بَسْمةَ هازئٍ","وأجابَ في سَمْتٍ وفَرْطِ كِذابِ",23,"ب",1,0],["فَتَبكي بِدَمعٍ لَيسَ للقطرِ مِثلُهُ","وَتَزجُرُها التَقوى فَتُصغي إِلى الزَجرِ",24,"ر",1,0],["فتبصّروا يا قوم في أحوالكم","وتنبَّهوا من غفلة ورقود",25,"د",1,0],["فَتَبَسّمَتْ فبكيتُ قالتْ لا تُرَعْ","فلَعَلَّ مثلَ هواكَ بالمُتَبَسِّمِ",26,"م",1,0],["فَتَبيتُ تُسئِدُ مُسئِداً في نَيِّها","إِسآدَها في المَهمَهِ الإِنضاءُ",27,"ا",2,0],["فَتَبّاً لِدينِ عَبيدِ النُجومِ","وَمَن يَدَّعي أَنَّها تَعقِلُ",28,"ل",1,0],["فتبِعتُهُمْ أنا والرفيقُ ومقلةٌ","تَذري النجيعَ وأريحيٌّ بازلُ",29,"ل",1,0],["فَتَبلُغُ فيهِ أَقصى كُلِّ حالٍ","تُقَدِّرُ نَيلَهُ في الإِنتِهاءِ",30,"ا",2,0],["فَتَبّاً لَهُ أَيَّما رَفعَةٍ","رَآها لِمَن نيكَ حَتّى بَذَخ",31,"خ",1,0],["فتبّاً لها إذ تابَ من نَقْرِ دُفِّهِ","ولا سُقِيَت صَوبَ الغُيوثِ الرَّواجِسِ",32,"س",1,0],["فتُبعثوا وتكونوا في اللِّقاءِ يداً","إنَّ الحِمامَ إلى أرواحكم سَغِبُ",33,"ب",1,0],["فَتَبَدَّلَت مِن بَعدِنا أَو بُدِّلَت","وَوَشى وُشاةٌ بَينَنا أَعداءُ",34,"ا",2,0],["فَتَبَّعَ آثارَ الشِياهِ وَليدُنا","كَشُؤبوبِ غَيثٍ يَحفِشُ الأُكمَ وابِلُه",35,"ل",2,0],["فَتَبارَكَ اللَهُ الَّذي هُوَ لَم يَزَل","مَلِكاً بِما تُخفي الصُدورُ عَليما",36,"م",2,0],["فَتَباطا بِها فَقُلتُ أَدِرها","لَستَ ساقي وَلا قُلامَةَ ظِفري",37,"ر",2,0],["فتبينوا إذن الحقيقة واعلموا","أن الطبيعة هكذا من عادِ",38,"د",1,0],["فَتُب إِلى اللَهِ مِن تَحقيقِ باطِلِهِ","فَأَنتَ إِن تُبتَ عِندَ اللَهِ مَعذورُ",39,"ر",1,0],["فتبَسَّمَتْ وتَنَسَّمَتْ أرجاؤُها","أرجاً فما الغصنُ النضيرُ نظيرُها",40,"ر",3,0],["فَتَبَسَّمَت عَجَباً وَقالَت حَقُّهُ","أَن لا يُعَلِّمُنا بِما لَم نَعلَمِ",41,"م",1,0],["فَتَبِعتُهُم وَمَعي فُؤادٌ موجَعٌ","صَبٌّ بِقُربِهِمِ وَعَينٌ تَدمَعُ",42,"ع",1,0],["فَتَبسِمُ في حالَةٍ عَن رِضاً","وَتَنظُرُ آوِنَةً عَن غَضَب",43,"ب",1,0],["فَتَبِعتُهُنَّ لِنِيَّةٍ شَحَطَت بِهِم","كَالنخلِ حانَ لِمُجتَنٍ أَرطابُهُ",44,"ب",2,0],["فَتَبِعتُهُم وَلَنِعمَ صاحِبُ واحِدٍ","في الوَحشِ يَبدُرُ قَبلَهُ أَصحابُهُ",44,"ب",2,0],["فَتَبادَرَت عَيناكَ إِذ فارَقتَها","دِرَراً وَأَنتَ عَلى الفِراقِ صَبورُ",45,"ر",1,0],["فَتَبَّعتُهُم عَينَيَّ حَتّى تَفَرَّقَت","مَعَ اللَيلِ عَن ساقِ الفَريدِ الحَمائِلُ",46,"ل",1,0],["فَتَبَدّى لَهُنَّ بِالنَجَفِ المَقفِي","يُ ماءٌ صافي الجِمامِ غَرِيُّ",47,"ي",1,0],["فَتَبقَيانِ جَميعاً","وَيَنفَدُ الثُقلانِ",48,"ن",1,0],["فَتَبَرّا مِن مَحَبَّتِنا","وَأُراهُ كانَ كَذّابا",49,"ب",2,0],["فَتَبقى أَسهُمٌ سِتٌّ","تُجَزّا بَينَ عُشّاقِ",50,"ق",1,0],["فَتَبارَيا ما خيمَ بَرقُكُما","فَكِلاكُما مُتَدارِكُ السَجمِ",51,"م",1,0],["فَتَبادَروا طُرَفَ الثَناءِ بِفَضلِهِ","فَكَأَنَّما نَشَروا الثَناءَ بُرودا",52,"د",2,1],["فَتَبِعتُ الفُؤادَ حينَ تَأَلّى","في هَواهُ فَلَم أُوافِق سُعودا",53,"د",2,0],["فَتَبَدَّلَت سُعدى بِشيمَتِها","شِيَماً لِتَكدَحَ غَيرَ ما كَدَحا",54,"ح",2,0],["فَتَبارَكَ اللَهُ الَّذي هُوَ قادِرٌ","تَعيا وَتَقصُرُ دونَهُ الأَوصافُ",55,"ف",1,0],["فتبوأت جدثاً به نامَت سقى","جدثاً به نامَت سعاد سحاب",56,"ب",1,0],["فتبسمت يوم كنت صَحيحاً","وَتبسمت يوم كنت عَليلا",57,"ل",2,0],["فَتبلى لحومك في جوفها","وَتبلى جلودك والأعظم",58,"م",1,0],["فتبيَّنتُ في الشواطىء حولي","أثراً من غرامنا المأثورِ",59,"ر",1,0],["فَتَبَادَرَ الفِتْيَانُ مِن","جَنَبَاتِهِ أَشْهَى المَطَاعِمْ",60,"م",1,0],["فتبرّمتُ بالسَّكينةِ والضَّجَّةِ","بل قَدْ كَرِهْتُ فيها نصيبي",61,"ب",2,0],["فَتَبَّاً لَهُمْ مِنْ مَعْشَرٍ لَيْسَ فِيهِمُ","رَشِيدٌ وَلا مِنْهُمْ خَلِيلٌ مُصَادِقُ",62,"ق",1,0],["فَتُبْ إِلى اللهِ قَبْلَ مَنْدَمَةٍ","تَكْثُرُ فِيها الْهُمُومُ والْكُرَبُ",63,"ب",1,0],["فَتَبَّاً لَهُمْ مِنْ مَعْشَرٍ نَزَعَتْ بِهِمْ","إِلَى الْغَيِّ أَخْلاقٌ نَبَتْنَ عَلَى غِمْرِ",64,"ر",1,0],["فَتَبِعْتُ مَسْرَاها عَلَى عَجَلٍ","حَتَّى ظَفِرْتُ بِنَظْرَةٍ خَلْسِ",65,"س",1,0],["فَتَبِيتُ صِفْرَ يَدٍ وَكُنْتَ مَلِيَّهَا","وَتَذُوقُ كُلَّ مَرَارَةِ الإِقْتَارِ",66,"ر",1,0],["فَتَبْلُغُ التَّأَدِيبَ مُسْتَوْفِياً","تَمَامَهُ بِالأَدَبِ الْوَافِرْ",67,"ر",1,0],["فَتَبَدَّلَتْ أَفْرَاحُهُمْ فِي لَحْظَةٍ","بِمَنَاحَةٍ وَسُرُورُهُمْ بِبُكَاءِ",68,"ا",2,0],["فَتَبِعْتُهَا مُتَضَائِلاً","أَمْشِي وَيَثْنِينِي الْحَيَاءْ",69,"ا",2,0],["فتبَاكَى خُدْعَةً لَكِنَّهَا","لمْ يَفُتْهَا مَا وَرَاءَ الْعَيْنِ عَبْرَى",70,"ر",2,0],["فَتَبَيَّنُوا الْعِبَرَ الْكِبَارَ بِهَا","لاَ تقْرَؤُنَّ كِتَابَهَا عَبْرَا",71,"ر",2,0],["فَتَبَوَّأ في الخُلدِ حَيثُ تَرى اللَ","هَ وَتَلقى نَبِيَّكَ المَحبوبا",72,"ب",2,0],["فتبارت عصائب الطير ما بين","شرود من الأذى ونفور",73,"ر",1,0],["فتبخرت تلك الوعو","دُ؛ كما تبخرت المياه",74,"ا",2,0],["فتَّبعتهمْ عينيَّ حتى تفرّقت","مع الليل عن سَاقِ الفَرِيدِ الجمايِلُ",75,"ل",1,0],["فتبادرت عيناك إذْ فارقتها","يوماً وأنت على الفراقِ صبورُ",76,"ر",1,0],["فتبنّى الصياع طفلا كسيحا","وأنا ، والأسى وأمّا فقيره",77,"ر",2,0],["فتبتدى الأشتات في أحرفي","ولادة فرحى ، وحملا وجيع",78,"ع",1,0],["فتبارت أذناب \" لندن \" تزري","باسمة فازدهى اسمه وتلالا",79,"ل",2,0],["فتبعت بالفؤاد حين تألى","في هواه فلم أوافق سعودا",80,"د",2,0],["فتبيَّنتُ في الشواطئ حولي","أثرًا من غرامنا المأثورِ",81,"ر",1,0],["فتبسّمت وبدا الرضى في وجهها","إذ راقها التمثيل والتصوير",82,"ر",1,0],["فتبصقه الريح ، من كل فج","وتمضغ في مقلتيه .. العتاد",83,"د"