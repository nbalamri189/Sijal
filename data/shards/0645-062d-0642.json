{"poems":[[75,"هذا الصباح على سراك رقيبا","https://www.aldiwan.net/poem11919.html","الكامل"],[93,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[91,"قد أسمعتك أنينها الأوطان","https://www.aldiwan.net/poem44941.html","الكامل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42494","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54250","الرمل"],[119,"قتل الاعداء يا هند الحسد","https://www.aldiwan.net/poem41154.html","عموديه"],[119,"أيجحد من جلالتك السناء","https://www.aldiwan.net/poem41473.html","عموديه"],[124,"إن وجها رأيته ليلة السب","https://www.aldiwan.net/poem49368.html","الخفيف"],[164,"عاملت ربك وانتدبت خصالا","https://www.aldiwan.net/poem58816.html","الكامل"],[164,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[228,"ملقيه بحسنك المأجور","https://www.aldiwan.net/poem41602.html","الخفيف"],[236,"بين العقيق وبين سلع مربع","https://www.aldiwan.net/poem44569.html","الكامل"],[302,"حسن ابتدائي بذكري جيرة الحرم","https://www.aldiwan.net/poem33180.html","البسيط"],[385,"الحمد لله الذي حمده","https://www.aldiwan.net/poem48751.html","السريع"],[422,"لا تلم مغرما رآك فهاما","https://www.aldiwan.net/poem53984.html","الخفيف"],[466,"خذ ما تشاء من الأيام أو فذر","https://www.aldiwan.net/poem15097.html","البسيط"],[505,"رفع البدر علينا سجفا","https://www.aldiwan.net/poem37954.html","الرمل"],[505,"ها أين يا ريح الصبا","https://www.aldiwan.net/poem38086.html","مجزوء الرجز"],[520,"دنا العيد هنيت أمثاله","https://www.aldiwan.net/poem12240.html","المتقارب"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103112","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/39009","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37978","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37875","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120004","المنسرح"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55919","الكامل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6756","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1848,"","https://poetry.dctabudhabi.ae/diwan/poem/105685","البسيط"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126194","الرجز"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132384","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74325","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132752","السريع"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114493","السريع"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119482","الطويل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81948","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28699","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120482","الخفيف"],[4935,"رفاعه نك سليلى عالي ذي شان","https://www.poetsgate.com/ViewPoem.aspx?id=129525",""],[4966,"فى تيهِ بُعْدِك..","https://www.poetsgate.com/ViewPoem.aspx?id=196796",""],[5956,"محقُ السلاح أكبر ضامن للسلام","https://www.poetsgate.com/ViewPoem.aspx?id=194890",""],[5956,"أ وَلم تضِق ذرعاً بعَون الناس؟","https://www.poetsgate.com/ViewPoem.aspx?id=215974",""],[6149,"سبحان من صاغه وكون","https://www.poetsgate.com/ViewPoem.aspx?id=169628",""]],"verses":[["مَحَقَت هِلالَ السِنِّ قَبلَ تَمامِهِ","وَذَوى بِها غُصنُ الشَبابِ رَطيبا",0,"ب",2,0],["مَحَقَ الضَنى جَسَدي فَبِت","تُ مِنَ الهَلاكِ عَلى شَفيرِ",1,"ر",1,0],["محقورة في عينهم لا أهلها","أهل ولا إنسانها إنسان",2,"ن",1,0],["محقّق الآمال أو واعدٌ","بفرحةٍ يوم لقاء وعيد",3,"د",1,0],["مَحَقَ الْفَنَاءُ وُجُودَها فَتَزَايَلَتْ","إِلاَّ نَسِيماً شَفَّ عَنْ حَوْباءِ",4,"ا",2,0],["مَحَقَ اللَهُ أبَا لُؤْلُؤَةٍ","وَوَقَى مِصْراً فَأَبْقَى عُمَرَا",5,"ر",2,0],["محقوا غيظا وراحوا شيعا","كلهم في جيده حبل مسد",6,"د",1,0],["محقت الظلم والاهواء عنهم","وقام عن الغشاء بهم صفاء",7,"ا",2,0],["محقباً خمرةً لنطرب كالبح","ر ونغدو لصحبه البحر أهلا",8,"ل",2,0],["محّقتهم محقَ الربا وأبدتهم","قتلاً ونفياً لم تدع مُختالا",9,"ل",2,0],["محقتهم محق الربا فتلاحقوا","كما أنبت سلك فيه نظم مركب",10,"ب",1,0],["محق اللَهُ فيَّ شرَّ ظَلامي","فَلتُضىء في الحَياةِ حِكمَةُ نوري",11,"ر",2,0],["محقت طغاة الترك أطراف القرى","فالمال نهب والمنازل بلقع",12,"ع",1,0],["محقِّقون لتوهيم العِدى أَبَداً","كأَنَّهم يعشقون البيض في القِمَمِ",13,"م",1,0],["مُحقق ما زاغَ عَن نَهجِهِ","في الحَق مِن لَومَة غاوٍ يَلوم",14,"م",1,0],["مَحَقتْ ظلمة الضلالة والغيّ","كما بمحق الضياءُ الظلاما",15,"م",2,0],["مُحْقَوْقِفينَ على الأكوار تغلبُهم","على الأزمَّة أيدي النَّوم والفِكرِ",16,"ر",1,0],["مُحِقَتْ وَجداً وذابَتْ لَوْعةً","واعْتَراها بعدَ هذا الشَّغَفُ",17,"ف",1,0],["مُحَقَّقاً مُؤنِّقاً","مُثَوِّباً مُئوِّبَا",18,"ب",2,0],["محقرة القدر في جنب ما","ينادى إليه ويدعى له",19,"ل",2,0],["محقنا وفي حق اليقين محاقنا","وجدنا بقاء الحق في فيئه الفاني",20,"ن",2,0],["محق بتحقيق الحقائق صادق","تجلت بأمر للحقائق فائق",21,"ق",1,0],["مُحِق بظن مثل أحلام حالم","ومَن كشف الأمثال في كل عالم",21,"م",1,0],["محقِّقٌ دقّة التّدقيقِ مِنهُ غَدَت","تَبدو عَلى جَبهَةِ التّحقيقِ قَد كتبت",22,"ت",1,0],["مُحقِّقُ هذا الوقت برهانُ فضلهِ","إِذا كانَ قَد يَخفى يَفوقُ على الفجرِ",23,"ر",1,0],["مُحقّقُ الوقتِ أَضحى سهمُ فِطْنَتهِ","لا شكّ عن غَرضِ التحقيقِ لم يطِشِ",24,"ش",1,0],["محققات لديه ظنون آمله","مخففات لديه أثقالُه",25,"ل",2,0],["محقت ظلام الظلم عند بزوغها","ومحت ضباب غيوم جور الجايرِ",26,"ر",1,0],["مَحَقَ الزَمانُ هِلالَهُ فَكَأَنَّما","أَبقى لَهُ مِنهُ عَلى قَدرِ السُها",27,"ه",2,0],["محقق وبعده منقولُ","لانه من بعضها معمول",28,"ل",1,0],["محقق مرتضى مفيد","علامة فخره المؤبد",29,"د",1,0],["مَحَقتَ يا إلَهى الآثارَ","ثمّ مَحَوتَ بَعدَها الأغيارَ",30,"ر",1,0],["محقَ الجهل والضلالَ سناهُ","مثل محقِ الفقدان للوجدان",31,"ن",1,0],["محق الكُفر بالقنا وَالمَواضي","فَهدانا بِها طَريقاً قَويما",32,"م",2,0],["محقق تلقى به المرتضى","حيا مفيداً ظاهرا بالعيان",33,"ن",1,0],["مُحققاً قولَ الذي قال لا","للشمسِ من حركةٍ رائِعَه",34,"ع",2,0],["محققة ملء الكفوف كأنها","من الجزع كبرى لم ترض بنظام",35,"م",1,1],["محق ومن ينكر إلى الحق يظلم","فجاءت بحمد اللّه قولة صادق",36,"ق",1,0],["مُحقِبات صور الظِّباءِ فَكَم صَك","ك طَلاقٍ يَحمِلنَهُ وَعِتاقِ",37,"ق",1,0],["محق الظلم عدله فتملى","بالامان الانام وهو مرامه",38,"م",2,0],["محقق عز تيكه كادي فرمان","بالاستتحقاق أكابردى عطيه",39,"ي",2,0],["محقتْ هلال العمر قبل تمامه","أفٍ لها وجهٌ زنيمٌ مقرفُ",40,"ف",1,0],["مَحْقُ السلاح ضمانُ خير سلامةٍ","فالسلم بعد المحق غيرُ مُهَدَّدِ",41,"د",1,0],["محَقَ المهيمنُ مَن لديه خباثةٌ","ومصائدٌ محبوكة لفراسِ..",42,"س",1,0],["محقق ظن مرتجيه","لا مبطلا بالأذى ولا المن",43,"ن",1,0]]}