{"poems":[[63,"صدت أميمة حين لاح بمفرقي","https://www.aldiwan.net/poem45875.html","الكامل"],[3,"هل غادر الشعراء من متردم","https://www.aldiwan.net/poem85.html","الكامل"],[83,"أللمحة من بارق متبسم","https://www.aldiwan.net/poem54240.html","الكامل"],[27,"قال الأمير لعبد تيم بئس ما","https://www.aldiwan.net/poem5683.html","الكامل"],[51,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[29,"بئس الفوارس عند معترك القنا","https://www.aldiwan.net/poem6062.html","الكامل"],[70,"عرف الحبيب مكانه فتدللا","https://www.aldiwan.net/poem42731.html","الكامل"],[89,"خرت لعزة شعرك الشعراء","https://www.aldiwan.net/poem43674.html","الكامل"],[43,"لا الحلم جاد به ولا بمثاله","https://www.aldiwan.net/poem9931.html","الكامل"],[45,"سهر أصابك بعد طول نعاس","https://www.aldiwan.net/poem64605.html","الكامل"],[45,"لو كان يعتب هاجر في واصل","https://www.aldiwan.net/poem65544.html","الكامل"],[45,"لاجديد الصبا ولا ريعانه","https://www.aldiwan.net/poem66799.html","البسيط"],[28,"تبعوا رسولهم بسنته","https://www.aldiwan.net/poem5130.html","الكامل"],[66,"يا قضيبا ذوى وكان نضيرا","https://www.aldiwan.net/poem40295.html","الخفيف"],[80,"عذبتني بالعنصرين","https://www.aldiwan.net/poem31270.html","مجزوء الكامل"],[44,"أما وقد ألحقتني بالموكب","https://www.aldiwan.net/poem30575.html","الكامل"],[31,"أضحى فؤادك غير ذات أوان","https://www.aldiwan.net/poem41285.html","الكامل"],[31,"ذكر القلب ذكرة","https://www.aldiwan.net/poem41865.html","مجزوء الخفيف"],[31,"أبت البخيلة أن تنولني","https://www.aldiwan.net/poem42478.html","الكامل"],[74,"حدر القناع عن الصباح المسفر","https://www.aldiwan.net/poem12956.html","الكامل"],[67,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[50,"طال ليلي من حب","https://www.aldiwan.net/poem64867.html","مجزوء الخفيف"],[46,"تيمم فجا واحدا كل راكب","https://www.aldiwan.net/poem22248.html","الطويل"],[68,"زدني بفرط الحب فيك تحيرا","https://www.aldiwan.net/poem1498.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142017","الخفيف"],[18,"أثبت مرة والسيوف شواهر","https://www.poetsgate.com/ViewPoem.aspx?id=27779",""],[98,"شاعر يترك الخيال كسيحا","https://www.poetsgate.com/ViewPoem.aspx?id=55333",""],[90,"بم أستهل","https://www.poetsgate.com/ViewPoem.aspx?id=179014",""],[45,"سَهَرٌ أَصَابَك بَعْدَ طُولِ نُعَاسِ","https://www.poetsgate.com/ViewPoem.aspx?id=31226",""],[31,"أَبَتِ البَخِيلَة ُ أَنْ تُنَوِّلَني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18920&r=&rc=183",""],[18,"أثبتُّ مرة َ وَ السيوفُ شواهرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26464&r=&rc=30",""],[190,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[190,"فضل الله سيد الخلق قدما","https://www.aldiwan.net/poem35277.html","الخفيف"],[205,"شاقني الأهل لم تشقني الديار","https://www.aldiwan.net/poem53085.html","الخفيف"],[232,"سلوان مثلك للمحب عزيز","https://www.aldiwan.net/poem44589.html","الكامل"],[250,"لمن الديار غشيتها بالأنعم","https://www.aldiwan.net/poem2093.html","الكامل"],[251,"مولاي هب نظرا لعبدك","https://www.aldiwan.net/poem15004.html","مجزوء الكامل"],[262,"يا ابن السرى والليل والبيداء","https://www.aldiwan.net/poem38377.html","الكامل"],[365,"هل في عتاب الحادثات غناء","https://www.aldiwan.net/poem61013.html","الكامل"],[367,"حلوم التعتب والدلال","https://www.aldiwan.net/poem17059.html","مجزوء الكامل"],[367,"ولقد خلوت بعبرة متفردا","https://www.aldiwan.net/poem17358.html","الكامل"],[378,"قلبي بمدحك يربأ","https://www.aldiwan.net/poem66974.html","مجزوء الكامل"],[404,"مثلي يغر بنقش كف الغيد","https://www.aldiwan.net/poem33972.html","الكامل"],[417,"جئت يا ابن الفاروق من معجز","https://www.aldiwan.net/poem53865.html","الخفيف"],[417,"زادك الله بهجة ووقارا","https://www.aldiwan.net/poem53883.html","الخفيف"],[417,"لك بالمعالي رتبة تختارها","https://www.aldiwan.net/poem54015.html","الكامل"],[438,"يا حادياً هلا وقفت قليلا","https://www.aldiwan.net/poem2575.html","الكامل"],[440,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[516,"هي سلوة حلت عقود وفائها","https://www.aldiwan.net/poem11999.html","الكامل"],[559,"أتعبتني بقر الشام","https://www.aldiwan.net/poem34182.html","المديد"],[576,"صح من دهرنا وفاة الحياء","https://www.aldiwan.net/poem2790.html","الخفيف"]],"verses":[["ولقد خَلَعْتُ عَلَيْكِ ما اسْتَحْسَنْتُهُ","وَهُوَ الشَّبابُ وَذاكَ جُهْدُ العاشِقِ",0,"ق",1,0],["وَلَقَد خَشيتُ بِأَن أَموتَ وَلَم تَدُر","لِلحَربِ دائِرَةٌ عَلى اِبنَي ضَمضَمِ",1,"م",1,0],["ولقد خشيتِ بأن يقادَ بجرحه","فوهبت لحظك ما أحلَّك من دمي",2,"م",2,0],["وَلَقَد خَرَجتَ مِنَ المَدينَةِ آفِلاً","خَرِعَ القَناةِ مُدَنَّسَ الأَثوابِ",3,"ب",1,0],["ولقد خِفْتُ والبريءُ مُلَقّىً","كلُّ ذنبٍ برأْسهِ مَعْصوبُ",4,"ب",1,0],["وَلَقَد خَصَيتُ مُحارِباً بِخِصايَةٍ","وَاِبنُ المَراغَةِ عَنهُمُ مَشغولُ",5,"ل",1,0],["وَلَقَد خَشيتُ بِأَن يَكونَ أَمالَهُ","غَيري وَطَبعُ الغُصنِ أَن يَتَمَيَّلا",6,"ل",2,0],["ولقد خفيت على ظهورك مدة","عن أعيني ومن الظهور خفاء",7,"ا",2,0],["وَلَقَد خَبَأتُ مِنَ الكَلامِ سُلافُهُ","وَسَقَيتُ مَن نادَمتُ مِن جِريالِهِ",8,"ل",2,0],["وَلَقَد خَدَمتُكَ بِالرُصافَةِ بُرهَةً","وَخَدَمتُ شَيخَكَ في قُرى بِطياسِ",9,"س",1,0],["وَلقَد خَلَعتُ لَكِ العِذارَ فَلَم أَكُن","مُحظي الوُشاةِ وَلا مُطاعَ العاذِلِ",10,"ل",1,0],["وَلَقَد خِفتُ أَو تَوَهَّمتُ ظَنّاً","بِأَبي الفَتحِ أَن يَطولَ زَمانُه",11,"ن",2,0],["وَلَقَد خَصَمتُ بِها مُخاصِمَكُم","وَشَفَيتُ أَنفُسَكُم مِنَ الخُبرِ",12,"ر",1,0],["وَلَقَد خِفتُ مِن فِراقِكَ يَوماً","باكِياً بِالثَبورِ يَنعى ثَبيرا",13,"ر",2,0],["ولقد خَفِيتُ من الضّنا","وأمِنْتُ لَحْظَ الكاشحينِ",14,"ن",1,0],["وَلَقَد خَشيتُ بِأَن تَكونَ غَنيمَتي","حَرَّ الزَمانِ بِها وَبَردَ المَطلَبِ",15,"ب",1,0],["وَلَقَد خَشيتُ بِأَن أَلُجَّ بِهَجرِكُم","إِنَّ الحَبيبَ مُذَهِّلُ الإِنسانِ",16,"ن",1,0],["وَلَقَد خِفتُ خُلَّةً","لَستُ مِنها بِوائِلِ",17,"ل",1,0],["وَلَقَد خَشيتُ بِأَن يَكونُ بِهِ","مِن حُبَّكُم طَرَفٌ مِنَ المَسِّ",18,"س",1,0],["وَلَقَد خَلَوتُ بِهِ أُقَسِّمُ نَظرَتي","ما بَينَ جُؤذِرِ كِلَّةٍ وَغَضَنفَرِ",19,"ر",1,0],["وَلَقَد خَبَطتُ الغابَ أَسأَلُ لَيلَةً","عَن سِرِّ صُبحٍ في حَشاهُ مُضمَرِ",19,"ر",1,0],["وَلقد خَلَوْتُ بِذِكْرِكُمْ وَلِعَبْرَتي","بِتَسَهُّدِ في الجَفنِ أَيُّ زِحامِ",20,"م",1,0],["وَلَقَد خِفتُ أَن يَرو","حَ بِنَعشي أَقارِبي",21,"ب",2,0],["وَلَقَد خُلِقَت عَوجاءَ مِثلَ هِلالِها","يَكونُ وَإِيّاها القِيامَةَ مُعَوِّجا",22,"ج",2,0],["ولقد خَلَوْتُ مع الحَبيب وبَيْنَنَا","سِرٌّ أرَقّ منَ النسيمِ إذا سرى",23,"ر",2,0],["ولقد خيم السكون","ونجوم السما عيون",24,"ن",1,0],["ولقد خبطت بيوت يشكر خبطة","أخوالنا وهم بنو الأعام",25,"م",1,0],["ولقد خاله النخيل على","البعد رسول الدهور من كهانه",26,"ن",2,0],["ولقد خشِيتُ عليه من نَفسَ الصَّبا","أسفاً لواهُ الموت في نكبائه",27,"ا",3,0],["ولقد خشِيتُ عليه قبلَ حِمامه","أن سوف يُحرِقُه لهيبُ ذكائه",27,"ا",3,0],["ولقد خدمتك بالرصافة برهة","وخدمت سنحك في قرى بطياس",28,"س",1,0],["ولقد خشيتُ بأن يكون بهش","مِنْ حُبِّكُمْ طَرَفٌ مِنَ کلْمَسِّ",29,"س",1,0],["وَ لقدْ خبطتُّ بيوتَ يشكرَ خبطة ً","أَخْوَالُنَا وَهُمُ بَنُو الأَعْمَامِ",30,"م",1,0],["وَلَقد خرّتِ الطوغيتُ إذ أو","ما إِليها كأنّها عقلاءُ",31,"ا",2,0],["وَلَقد خصّه بِأعلى المَزايا ال","غرّ مِنها المعراج والإسراءُ",32,"ا",2,0],["ولقد خيلوا سَراباً من القو","ل وبرهانُ ما ادَّعوه قَفَارُ",33,"ر",1,0],["ولقد خشيت الله أعظم خشية","فلصدرك العطر الرحيب أزيز",34,"ز",1,0],["وَلَقَد خَبَطنَ بَني كِلابٍ خَبطَةً","أَلصَقنَهُم بِدَعائِمِ المُتَخَيِّمِ",35,"م",1,0],["ولقد ختمت صيامَ ه","ذا الشهرِ مَقبُولا بحَمدك",36,"ك",1,0],["ولقد خبرت بنى الزمان وخسة ال","آباء تنتج خسة الأبناء",37,"ا",2,0],["ولقد خلا فِكْري بدَهْري عاذلاً","يَلْحاهُ كيف طغَتْ به الغُلواء",38,"ا",2,0],["وَلَقَد خَفيتُ كَما خَفي","تَ وَكُلُّنا طَيفُ الخَيالِ",39,"ل",1,0],["وَلَقَد خَلَوتُ بِعَبرَةٍ مُتَفَرِّداً","وَخَلَت بِقَلبي عِندَها أَحزاني",40,"ن",2,1],["وَلَقَد خبأتكِ في فُؤا","دٍ ظَلَّ فيكِ يَهجَأُ",41,"ا",1,0],["ولقد خَبَرْتُ الغانيات فماكها","عهدٌ فَلِمْ نقضت سعاد عهودي",42,"د",2,0],["ولقد خضتَ في الحقيقة بحراً","وقفت عند حدّه الشعراء",43,"ا",2,0],["ولقد خصّنا بنيلك مذ كنتَ","مُنيلاً لنا فَعَمَّ نواله",44,"ل",2,0],["ولقد خَلَقْتَ سماء كلّ فضيلةٍ","طَلَعَتْ على آفاقها أقمارها",45,"ر",3,0],["ولقد خلقن ولا وفاء يرتجى","من ودّهنّ ولا منحن عقولا",46,"ل",2,0],["ولقد خَلَعْتَ عَلَيْهِ قَبْلَ دُنُوِّهِ","بُرْداً تَفِيضُ عَلَى الفَضَاءِ فُضُولُهُ",47,"ل",2,0],["ولقد خرجت إلى الجليس مهاجراً","عصباً يضيم الدهر جار فنائها",48,"ا",3,0],["ولقد خاضوا ولم يَخَفوا","غرقاً في بحريَ الطامي",49,"م",2,0],["ولقد خلَّفت أَحاديثَ تُغْني ال","أَنْفَ عن نَشْرِ رَوضةٍ غنَّاءِ",50,"ا",2,0]]}