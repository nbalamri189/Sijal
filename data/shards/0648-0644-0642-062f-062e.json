{"poems":[[65,"صدت أميمة حين لاح بمفرقي","https://www.aldiwan.net/poem45875.html","الكامل"],[3,"هل غادر الشعراء من متردم","https://www.aldiwan.net/poem85.html","الكامل"],[85,"أللمحة من بارق متبسم","https://www.aldiwan.net/poem54240.html","الكامل"],[29,"قال الأمير لعبد تيم بئس ما","https://www.aldiwan.net/poem5683.html","الكامل"],[53,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[31,"بئس الفوارس عند معترك القنا","https://www.aldiwan.net/poem6062.html","الكامل"],[72,"عرف الحبيب مكانه فتدللا","https://www.aldiwan.net/poem42731.html","الكامل"],[91,"خرت لعزة شعرك الشعراء","https://www.aldiwan.net/poem43674.html","الكامل"],[45,"لا الحلم جاد به ولا بمثاله","https://www.aldiwan.net/poem9931.html","الكامل"],[47,"سهر أصابك بعد طول نعاس","https://www.aldiwan.net/poem64605.html","الكامل"],[47,"لو كان يعتب هاجر في واصل","https://www.aldiwan.net/poem65544.html","الكامل"],[47,"لاجديد الصبا ولا ريعانه","https://www.aldiwan.net/poem66799.html","البسيط"],[30,"تبعوا رسولهم بسنته","https://www.aldiwan.net/poem5130.html","الكامل"],[68,"يا قضيبا ذوى وكان نضيرا","https://www.aldiwan.net/poem40295.html","الخفيف"],[18,"أثبت مرة والسيوف شواهر","https://www.aldiwan.net/poem23929.html","الكامل"],[82,"عذبتني بالعنصرين","https://www.aldiwan.net/poem31270.html","مجزوء الكامل"],[46,"أما وقد ألحقتني بالموكب","https://www.aldiwan.net/poem30575.html","الكامل"],[33,"أضحى فؤادك غير ذات أوان","https://www.aldiwan.net/poem41285.html","الكامل"],[33,"ذكر القلب ذكرة","https://www.aldiwan.net/poem41865.html","مجزوء الخفيف"],[33,"أبت البخيلة أن تنولني","https://www.aldiwan.net/poem42478.html","الكامل"],[76,"حدر القناع عن الصباح المسفر","https://www.aldiwan.net/poem12956.html","الكامل"],[69,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[52,"طال ليلي من حب","https://www.aldiwan.net/poem64867.html","مجزوء الخفيف"],[48,"تيمم فجا واحدا كل راكب","https://www.aldiwan.net/poem22248.html","الطويل"],[70,"زدني بفرط الحب فيك تحيرا","https://www.aldiwan.net/poem1498.html","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142017","الخفيف"],[18,"أثبت مرة والسيوف شواهر","https://www.poetsgate.com/ViewPoem.aspx?id=27779",""],[100,"شاعر يترك الخيال كسيحا","https://www.poetsgate.com/ViewPoem.aspx?id=55333",""],[92,"بم أستهل","https://www.poetsgate.com/ViewPoem.aspx?id=179014",""],[47,"سَهَرٌ أَصَابَك بَعْدَ طُولِ نُعَاسِ","https://www.poetsgate.com/ViewPoem.aspx?id=31226",""],[33,"أَبَتِ البَخِيلَة ُ أَنْ تُنَوِّلَني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18920&r=&rc=183",""],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[193,"فضل الله سيد الخلق قدما","https://www.aldiwan.net/poem35277.html","الخفيف"],[208,"شاقني الأهل لم تشقني الديار","https://www.aldiwan.net/poem53085.html","الخفيف"],[236,"سلوان مثلك للمحب عزيز","https://www.aldiwan.net/poem44589.html","الكامل"],[254,"لمن الديار غشيتها بالأنعم","https://www.aldiwan.net/poem2093.html","الكامل"],[255,"مولاي هب نظرا لعبدك","https://www.aldiwan.net/poem15004.html","مجزوء الكامل"],[266,"يا ابن السرى والليل والبيداء","https://www.aldiwan.net/poem38377.html","الكامل"],[369,"هل في عتاب الحادثات غناء","https://www.aldiwan.net/poem61013.html","الكامل"],[371,"حلوم التعتب والدلال","https://www.aldiwan.net/poem17059.html","مجزوء الكامل"],[371,"ولقد خلوت بعبرة متفردا","https://www.aldiwan.net/poem17358.html","الكامل"],[382,"قلبي بمدحك يربأ","https://www.aldiwan.net/poem66974.html","مجزوء الكامل"],[409,"مثلي يغر بنقش كف الغيد","https://www.aldiwan.net/poem33972.html","الكامل"],[422,"جئت يا ابن الفاروق من معجز","https://www.aldiwan.net/poem53865.html","الخفيف"],[422,"زادك الله بهجة ووقارا","https://www.aldiwan.net/poem53883.html","الخفيف"],[422,"لك بالمعالي رتبة تختارها","https://www.aldiwan.net/poem54015.html","الكامل"],[443,"يا حادياً هلا وقفت قليلا","https://www.aldiwan.net/poem2575.html","الكامل"],[445,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[520,"هي سلوة حلت عقود وفائها","https://www.aldiwan.net/poem11999.html","الكامل"],[563,"أتعبتني بقر الشام","https://www.aldiwan.net/poem34182.html","المديد"],[580,"صح من دهرنا وفاة الحياء","https://www.aldiwan.net/poem2790.html","الخفيف"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104083","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37888","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38019","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37999","الكامل"],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/126573","الكامل"],[1155,"","https://poetry.dctabudhabi.ae/diwan/poem/203276",""],[1394,"","https://poetry.dctabudhabi.ae/diwan/poem/199966","الكامل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115867","الكامل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111854","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69402","الكامل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123092","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71065","الكامل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108473","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/61013","الكامل"],[2753,"","https://poetry.dctabudhabi.ae/diwan/poem/20053","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100246","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100236","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58404","الكامل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109808","الكامل"],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103806","الكامل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44913","الخفيف"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102728","الكامل"],[4568,"","https://poetry.dctabudhabi.ae/diwan/poem/143589","الكامل"],[5050,"ما لي وللأنذال والغوغاء","https://www.poetsgate.com/ViewPoem.aspx?id=38216",""],[585,"لمن الضارب في ظلال الوادي","https://www.poetsgate.com/ViewPoem.aspx?id=161910",""],[585,"أنا في الطائف أستوحي الشعور","https://www.poetsgate.com/ViewPoem.aspx?id=161867",""],[5451,"لكم مزماركم ولي مزماري","https://www.poetsgate.com/ViewPoem.aspx?id=155932",""],[5881,"يا حامل المصباح","https://www.poetsgate.com/ViewPoem.aspx?id=183774",""]],"verses":[["ولقد خَلَعْتُ عَلَيْكِ ما اسْتَحْسَنْتُهُ","وَهُوَ الشَّبابُ وَذاكَ جُهْدُ العاشِقِ",0,"ق",1,0],["وَلَقَد خَشيتُ بِأَن أَموتَ وَلَم تَدُر","لِلحَربِ دائِرَةٌ عَلى اِبنَي ضَمضَمِ",1,"م",1,0],["ولقد خشيتِ بأن يقادَ بجرحه","فوهبت لحظك ما أحلَّك من دمي",2,"م",2,0],["وَلَقَد خَرَجتَ مِنَ المَدينَةِ آفِلاً","خَرِعَ القَناةِ مُدَنَّسَ الأَثوابِ",3,"ب",1,0],["ولقد خِفْتُ والبريءُ مُلَقّىً","كلُّ ذنبٍ برأْسهِ مَعْصوبُ",4,"ب",1,0],["وَلَقَد خَصَيتُ مُحارِباً بِخِصايَةٍ","وَاِبنُ المَراغَةِ عَنهُمُ مَشغولُ",5,"ل",1,0],["وَلَقَد خَشيتُ بِأَن يَكونَ أَمالَهُ","غَيري وَطَبعُ الغُصنِ أَن يَتَمَيَّلا",6,"ل",2,0],["ولقد خفيت على ظهورك مدة","عن أعيني ومن الظهور خفاء",7,"ا",2,0],["وَلَقَد خَبَأتُ مِنَ الكَلامِ سُلافُهُ","وَسَقَيتُ مَن نادَمتُ مِن جِريالِهِ",8,"ل",2,0],["وَلَقَد خَدَمتُكَ بِالرُصافَةِ بُرهَةً","وَخَدَمتُ شَيخَكَ في قُرى بِطياسِ",9,"س",1,0],["وَلقَد خَلَعتُ لَكِ العِذارَ فَلَم أَكُن","مُحظي الوُشاةِ وَلا مُطاعَ العاذِلِ",10,"ل",1,0],["وَلَقَد خِفتُ أَو تَوَهَّمتُ ظَنّاً","بِأَبي الفَتحِ أَن يَطولَ زَمانُه",11,"ن",2,0],["وَلَقَد خَصَمتُ بِها مُخاصِمَكُم","وَشَفَيتُ أَنفُسَكُم مِنَ الخُبرِ",12,"ر",1,0],["وَلَقَد خِفتُ مِن فِراقِكَ يَوماً","باكِياً بِالثَبورِ يَنعى ثَبيرا",13,"ر",2,0],["وَلَقَد خَبَطتُّ بُيوتَ يَشكُرَ خَبطَةً","أَخوالُنا وَهُمُ بَنو الأَعمامِ",14,"م",1,0],["ولقد خَفِيتُ من الضّنا","وأمِنْتُ لَحْظَ الكاشحينِ",15,"ن",1,0],["وَلَقَد خَشيتُ بِأَن تَكونَ غَنيمَتي","حَرَّ الزَمانِ بِها وَبَردَ المَطلَبِ",16,"ب",1,0],["وَلَقَد خَشيتُ بِأَن أَلُجَّ بِهَجرِكُم","إِنَّ الحَبيبَ مُذَهِّلُ الإِنسانِ",17,"ن",1,0],["وَلَقَد خِفتُ خُلَّةً","لَستُ مِنها بِوائِلِ",18,"ل",1,0],["وَلَقَد خَشيتُ بِأَن يَكونُ بِهِ","مِن حُبَّكُم طَرَفٌ مِنَ المَسِّ",19,"س",1,0],["وَلَقَد خَلَوتُ بِهِ أُقَسِّمُ نَظرَتي","ما بَينَ جُؤذِرِ كِلَّةٍ وَغَضَنفَرِ",20,"ر",1,0],["وَلَقَد خَبَطتُ الغابَ أَسأَلُ لَيلَةً","عَن سِرِّ صُبحٍ في حَشاهُ مُضمَرِ",20,"ر",1,0],["وَلقد خَلَوْتُ بِذِكْرِكُمْ وَلِعَبْرَتي","بِتَسَهُّدِ في الجَفنِ أَيُّ زِحامِ",21,"م",1,0],["وَلَقَد خِفتُ أَن يَرو","حَ بِنَعشي أَقارِبي",22,"ب",2,0],["وَلَقَد خُلِقَت عَوجاءَ مِثلَ هِلالِها","يَكونُ وَإِيّاها القِيامَةَ مُعَوِّجا",23,"ج",2,0],["ولقد خَلَوْتُ مع الحَبيب وبَيْنَنَا","سِرٌّ أرَقّ منَ النسيمِ إذا سرى",24,"ر",2,0],["ولقد خيم السكون","ونجوم السما عيون",25,"ن",1,0],["ولقد خبطت بيوت يشكر خبطة","أخوالنا وهم بنو الأعام",26,"م",1,0],["ولقد خاله النخيل على","البعد رسول الدهور من كهانه",27,"ن",2,0],["ولقد خشِيتُ عليه من نَفسَ الصَّبا","أسفاً لواهُ الموت في نكبائه",28,"ا",3,0],["ولقد خشِيتُ عليه قبلَ حِمامه","أن سوف يُحرِقُه لهيبُ ذكائه",28,"ا",3,0],["ولقد خدمتك بالرصافة برهة","وخدمت سنحك في قرى بطياس",29,"س",1,0],["ولقد خشيتُ بأن يكون بهش","مِنْ حُبِّكُمْ طَرَفٌ مِنَ کلْمَسِّ",30,"س",1,0],["وَلَقد خرّتِ الطوغيتُ إذ أو","ما إِليها كأنّها عقلاءُ",31,"ا",2,0],["وَلَقد خصّه بِأعلى المَزايا ال","غرّ مِنها المعراج والإسراءُ",32,"ا",2,0],["ولقد خيلوا سَراباً من القو","ل وبرهانُ ما ادَّعوه قَفَارُ",33,"ر",1,0],["ولقد خشيت الله أعظم خشية","فلصدرك العطر الرحيب أزيز",34,"ز",1,0],["وَلَقَد خَبَطنَ بَني كِلابٍ خَبطَةً","أَلصَقنَهُم بِدَعائِمِ المُتَخَيِّمِ",35,"م",1,0],["ولقد ختمت صيامَ ه","ذا الشهرِ مَقبُولا بحَمدك",36,"ك",1,0],["ولقد خبرت بنى الزمان وخسة ال","آباء تنتج خسة الأبناء",37,"ا",2,0],["ولقد خلا فِكْري بدَهْري عاذلاً","يَلْحاهُ كيف طغَتْ به الغُلواء",38,"ا",2,0],["وَلَقَد خَفيتُ كَما خَفي","تَ وَكُلُّنا طَيفُ الخَيالِ",39,"ل",1,0],["وَلَقَد خَلَوتُ بِعَبرَةٍ مُتَفَرِّداً","وَخَلَت بِقَلبي عِندَها أَحزاني",40,"ن",2,1],["وَلَقَد خبأتكِ في فُؤا","دٍ ظَلَّ فيكِ يَهجَأُ",41,"ا",1,0],["ولقد خَبَرْتُ الغانيات فماكها","عهدٌ فَلِمْ نقضت سعاد عهودي",42,"د",2,0],["ولقد خضتَ في الحقيقة بحراً","وقفت عند حدّه الشعراء",43,"ا",2,0],["ولقد خصّنا بنيلك مذ كنتَ","مُنيلاً لنا فَعَمَّ نواله",44,"ل",2,0],["ولقد خَلَقْتَ سماء كلّ فضيلةٍ","طَلَعَتْ على آفاقها أقمارها",45,"ر",3,0],["ولقد خلقن ولا وفاء يرتجى","من ودّهنّ ولا منحن عقولا",46,"ل",2,0],["ولقد خَلَعْتَ عَلَيْهِ قَبْلَ دُنُوِّهِ","بُرْداً تَفِيضُ عَلَى الفَضَاءِ فُضُولُهُ",47,"ل",2,0],["ولقد خرجت إلى الجليس مهاجراً","عصباً يضيم الدهر جار فنائها",48,"ا",3,0],["ولقد خاضوا ولم يَخَفوا","غرقاً في بحريَ الطامي",49,"م",2,0],["ولقد خلَّفت أَحاديثَ تُغْني ال","أَنْفَ عن نَشْرِ رَوضةٍ غنَّاءِ",50,"ا",2,0],["ولقد خلتُ أن بينهما عِش","قا فصارا للضمِّ والتّقبيلِ",51,"ل",1,0],["وَلَقَد خَدَمتُ جَنابَهُ بِقَصيدَةٍ","تُزري بعَقدِ الدُّرِّ في كَلِماتِها",52,"ت",3,0],["وَلَقَد خَطَفت حِجى الكئيبِ بِما","أودِعتَ مِن سِحرٍ وَمِن غنجِ",53,"ج",1,0],["وَلَقَد خَدَمتُكَ مادِحاً بِقَصيدَةٍ","وَمَديحُ مِثلك في الأنامِ رَشادُ",54,"د",1,0],["ولقد خلوت بها وأب","عدت العذارى والعجائز",55,"ز",1,0],["ولقد خدمت الصاحب اب","ن وداعة دهراً طويلا",56,"ل",2,1],["ولقد خدمت مقامكم من قبلها","بفرايد حسناً يعز نظيرها",57,"ر",3,0],["ولقد خلوتُ بهِ أُسا","ئِلُهُ وأسألُه الجوابا",58,"ب",2,0],["ولقد خبرتُ بني زماني طالباً","من يرتجي فاخترت زيداً منهمُ",59,"م",1,0],["وَلَقَد خَفِيتُ عَنِ العُيونِ وَزارَني","طَيفُ الكَرى فَعَجِبتُ كَيفَ رَآني",60,"ن",2,0],["ولقد خانني حُسن الصبر بعد وفائه","وغير اكتئابي لا أراه يقين",61,"ن",1,0],["ولقد خَلَتْ من عكّ أَكثرُ دارِها","خَوْفاً وأَجْفَلَ أَهْلُها بفِرارِ",62,"ر",1,0],["ولقد خلقنا للشقاء وكلنا","يبقى لاحكام المنية خاضعا",63,"ع",2,0],["ولقد خصَصْتك بالذي لم أختصص","أحداً به فليدكره من أدكر",64,"ر",1,0],["وَلَقَد خَبَطنَ بَني كِلابٍ خَبطَةً","أَلصَقَتهُم بِدَعائِمِ المُتَخَيَّمِ",65,"م",1,0],["ولقد خلعت على المشيب رداء ذي","وصب تعذب في الصبا والتاحا",66,"ح",2,0],["ولقد خلوت بها بعف سريرة","لم أقترف بالذنب في خلواتها",67,"ت",3,0],["ولقد خَرَجَنا هاربينَ معَ الرَّدى","أو قيلَ عنّا أخرَجَتْ أَثقالها",68,"ل",3,0],["ولقد خبرت هوى الصبى فوجدته","ما بين حب مدامه وملاحه",69,"ح",2,0],["ولقد خشيت على الثرى وعلى الورى","لما دنوا من كفه تقبيلا",70,"ل",2,0],["وَلَقَد خَلَّدتَ في البِلادِ وَأَسَّس","تَ مِثالاً لِلعزةِ القَعساءِ",71,"ا",2,0],["ولقد خبرت الحلق علي ان أرى","من اصطفيه لصحبتي وإخائي",72,"ا",2,0],["ولقد خلعتُ خَلاعتي ورفضْتُها","وعِقالُ