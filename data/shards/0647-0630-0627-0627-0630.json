{"poems":[[90,"إليك ما شاهدت عيني من العجب","https://www.aldiwan.net/poem44424.html","البسيط"],[80,"يا ليت حربا ذاق الأعادي","https://www.aldiwan.net/poem14077.html","مخلع البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43747","البسيط"],[164,"لو يستطيع تخطي الأيام","https://www.aldiwan.net/poem58849.html","الطويل"],[264,"نحمد مولانا الذي قد اصطفى","https://www.aldiwan.net/poem35821.html","الرجز"],[376,"طالت لجاجة آيس متقاضي","https://www.aldiwan.net/poem57349.html","الكامل"],[411,"إني أرى صاحب السلطان في ظلم","https://www.aldiwan.net/poem49736.html","البسيط"],[500,"هنة كدور عمامتي شكلا","https://www.aldiwan.net/poem10266.html","أحذ الكامل"],[505,"من رام جمع الناس في مذهب","https://www.aldiwan.net/poem38005.html","السريع"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62666","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115892","البسيط"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52031","الكامل"],[2053,"","https://poetry.dctabudhabi.ae/diwan/poem/132441","الرجز"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109769","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87327","الرجز"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147356","البسيط"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3334,"","https://poetry.dctabudhabi.ae/diwan/poem/31454",""],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123881","الرجز"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123529","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135651","الرجز"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62128","الكامل"],[4578,"النهر يبقى على ما كان من قدمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=49429",""],[4929,"الى الذين يطلبون من صنعاء أن تنتفض","https://www.poetsgate.com/ViewPoem.aspx?id=199409",""],[5145,"ردّ المدامة عني أيها الساقي","https://www.poetsgate.com/ViewPoem.aspx?id=108137",""],[5183,"جلوة الحق","https://www.poetsgate.com/ViewPoem.aspx?id=186442",""],[5442,"حتام أبطائي بيوم متابي","https://www.poetsgate.com/ViewPoem.aspx?id=114775",""],[5442,"هل نازح الدار بعد البين مقترب","https://www.poetsgate.com/ViewPoem.aspx?id=114788",""],[4623,"للحب تبدو وان تخفى علامات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146688",""],[5902,"وَفقه الله لما يرتضي","https://www.poetsgate.com/ViewPoem.aspx?id=189173",""],[5933,"قال النبي مقالةً","https://www.poetsgate.com/ViewPoem.aspx?id=40707",""]],"verses":[["هذا إذا حسنت أما إذا قبحت","فالمندليّ بها يمسي من الحطب",0,"ب",1,0],["هَذا إِذا ما ناشبوهُ حَرباً","وَذا إِذا اِستَوهبوهُ سِلما",1,"م",2,0],["هذا إِذا أَنعَمَ المَولى فَأَسعَدَني","في القَنيَتَينِ بِتَثبيتٍ وَإِلهامِ",2,"م",1,0],["هذا إِذاً يدعو وهذا معلنٌ ض","يثني وذا لا يرعوي لكلامِ",3,"م",1,0],["هذا إذا رمتم طريقَ الاهتدا","ليحسن النهج لكم والاقتدا",4,"د",2,0],["هذا إذا قَضتِ الخُطوب لنفسِها","أو كانَ غيرَ أبي الحُسينِ القاضي",5,"ض",2,0],["هَذا إذا أشرقَتْ أيّامُ دَولِتهِ","والصَّيْلَمُ الإدُّ إنْ زَلَّتْ بهِ القَدَمُ",6,"م",1,0],["هذا إذا ما نونها انقلبت","مأوى الطيور وبيتها الأعلى",7,"ل",2,0],["هذا إذا عرَّفْتَهُ مسلِمٌ","وذا إذا عرَّفتَهُ كافِرُ",8,"ر",1,0],["هذا إذا لم يقض","باستغراقها مُحيي السُنَنْ",9,"ن",1,0],["هذا إذا أو ترت أما الشفع","فلين فيه للعروضي منع",10,"ع",1,0],["هذا إذا أخرت مجموع الوتد","عن سببي جزء عليه تعتمد",10,"د",1,0],["هذا اذا رأيتَها تقدمت","وحكمُها كحكمِ راءٍ كُرِّرَت",11,"ت",1,0],["هذا إذا تمَّ لى جميعاً","تمَّ سُرورى ودانَ سَعدِى",12,"د",2,0],["هَذا إذاً خَلقٌ جَديدٌ وكلُّ مَن","يَمشِي عَلَى رِجْلَينِ فِيهَا ثَعْلَبُ",13,"ب",1,0],["هذا إذا ما كان ذا مروَّه","ومُعرقاً في طيب الأبوَّه",14,"ه",1,0],["هذا إذا غاب أو هذا إذا حضرا","فانه قوت نفسي في تقربه",15,"ه",1,0],["هَذَا إِذَا مَا كَانَ ثَمَّ وَسَاطَةٌ","كَقِرَاءَةِ المخلُوقِ لِلقُرآنِ",16,"ن",1,0],["هَذَا إذَا مَا حَصَّلَ المَعنَى الذِي","قُلتُم هُوَ النَّفسِيُّ فِي البُرهَانِ",16,"ن",1,0],["هذا اذا لم يحرق الزرع الذي","بجوارها بالنار أو بدخان",16,"ن",1,0],["هَذا إذا مَا جُزتَهُ بالليلِ","أمَّا النَّهارِ أبيَضٌ فَخَيِّلِ",17,"ل",1,0],["هَذَا إِذَاً ظِلُّ شُطْآنِيْ مُبَرقَشَةٌ","بِهِ البِحَارُ ثُرَيَّاتٍ مِنَ المَدَرِ",18,"ر",1,0],["هذا اذا لم يطل وقت الجلوس فان","يطل فسامح لذي الاعذار والسقم",19,"م",1,0],["هذا إذا أخذوا الأموال كلهم","أو صاحب الأمر لا إن كانت السفلا",20,"ل",2,0],["هذا إذا راحوا فإن أقاموا","واقتصدوا الصبوح ثم ناموا",21,"م",3,0],["هَذَا إِذَا نَوَيتَ مَعنَى مِن وَإنَّ","لَم تَنوِ فَهوَ طِبقُ مَا بِهِ قُرِن",22,"ن",1,0],["هذا إذا كانَا عسى وعَلَّما","وما أظنُّ الدهرَ يسْخو بِهِمَا",23,"م",2,0],["هذا إذا يكون طالب اليمينْ","يلقى اليمين بالشمال واليمينْ",24,"ن",1,0],["هذا إذا زحف الزمان بجمعه","رفض الجميع وحل في أفذاذه",25,"ذ",2,0],["هذا إذا كان كلٌ فيه ذا قدمٍ","فكيف بالحادث الماشي على غررِ",26,"ر",1,0],["هذا إذا صدقتْ فيكم عروبتكم","واستيقظ الشرفُ الغافي من الخَدَرِ",27,"ر",1,0],["هذا إذا زلّت الأقدام داحضة","والفّت الساق يا مغرور بالساق",28,"ق",1,0],["هذا إذا كنت بالإيمان مدّرعا","وفي رداء رسول الله مرتديا",29,"ي",2,0],["هذا إذا قدرت جهلاً أنه","يقع العتاب ولات حين عتاب",30,"ب",1,0],["هذاإذا كنت أقوى أن أقوم به","فرداً ولم ينثني عن موقفي الرغب",31,"ب",1,0],["هذا إذا لم يواصله الحبيب ولم","تكن له عنده منه مودات",32,"ت",1,0],["هَذَا إِذا من الَّذِي ترتجي","رحماه بالصفح وبالغفر",33,"ر",1,0],["هذا إذا شهدوا الرضا","ع به توقف واجتنب",34,"ب",1,0]]}