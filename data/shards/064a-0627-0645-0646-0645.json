{"poems":[[95,"لانت صلاب العزائم","https://www.aldiwan.net/poem11341.html","المجتث"],[56,"يا ركبتي خزر وساق نعامة","https://www.aldiwan.net/poem29357.html","الكامل"],[85,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[74,"وعدت بطيف خيالها هيفاء","https://www.aldiwan.net/poem18174.html","الكامل"],[74,"قاسي الجوانح لين الأعطاف","https://www.aldiwan.net/poem19257.html","الكامل"],[74,"في خده وعذاره الفتان","https://www.aldiwan.net/poem20288.html","الكامل"],[53,"لا زلت غوثا إذا ناداك ملهوف","https://www.aldiwan.net/poem65444.html","البسيط"],[72,"عرف الحبيب مكانه فتدللا","https://www.aldiwan.net/poem42731.html","الكامل"],[99,"فيم الغدو غداً وأين رواحي","https://www.aldiwan.net/poem24401.html","الكامل"],[99,"بأي معجزة في الحب نتفق","https://www.aldiwan.net/poem24989.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55147","الكامل"],[147,"دل على المجد من إليه سعى","https://www.aldiwan.net/poem11778.html","المنسرح"],[164,"مقعد صدق لمليك مقتدر","https://www.aldiwan.net/poem58936.html","الرجز"],[189,"لا غرو أن رحل الشباب وبانا","https://www.aldiwan.net/poem14688.html","الكامل"],[214,"ودي لكم صدق بغير تملق","https://www.aldiwan.net/poem13520.html","الكامل"],[237,"يا من ملكني وعن طرف الوفا عرج","https://www.aldiwan.net/poem14909.html","المواليا"],[242,"يا من مآثره عديده","https://www.aldiwan.net/poem18137.html","مجزوء الكامل"],[261,"قالت وقد كشف الوداع","https://www.aldiwan.net/poem48368.html","مجزوء الكامل"],[276,"رياض نجد بكم جنان","https://www.aldiwan.net/poem52050.html","مخلع البسيط"],[354,"لا رحت للآمال منك مبلغا","https://www.aldiwan.net/poem15782.html","الكامل"],[358,"حمدا لك اللهم يا من قد قضى","https://www.aldiwan.net/poem40828.html","الرجز"],[369,"هل أنت بطولك مسعده","https://www.aldiwan.net/poem60943.html","المتدارك"],[385,"يا من مواطر فضله","https://www.aldiwan.net/poem48775.html","مجزوء الكامل"],[406,"لله در بلادنا","https://www.aldiwan.net/poem6709.html","عموديه"],[408,"يا عادلا في حكمه لا يظلم","https://www.aldiwan.net/poem47008.html","الكامل"],[409,"العلم في قول لا إله إلا الله","https://www.aldiwan.net/poem33366.html","البسيط"],[415,"يا من مودته سحاب زائل","https://www.aldiwan.net/poem32578.html","الكامل"],[435,"أرج الصبابة من ثنائك عارف","https://www.aldiwan.net/poem40081.html","الكامل"],[443,"رب السماء يزيد من عمري","https://www.aldiwan.net/poem2567.html","مجزوء الكامل"],[458,"أمودعي من قبل أن يلقاني","https://www.aldiwan.net/poem61317.html","الكامل"],[463,"صدت بنعمان على طول الصدى","https://www.aldiwan.net/poem56213.html","الرجز"],[473,"يا من مساعيه تغدو","https://www.aldiwan.net/poem60286.html","المجتث"],[473,"يا من مباضع دسته بشباتها","https://www.aldiwan.net/poem60393.html","الكامل"],[519,"يا من موارده من مره علي عذاب","https://www.aldiwan.net/poem20889.html","المواليا"],[543,"إن كان في كل أرض ما تشان به","https://www.aldiwan.net/poem48233.html","عموديه"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138350",""],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110452","البسيط"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110396","البسيط"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110403","البسيط"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88602","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120075","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96606","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72329","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64980","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65025","المتدارك"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79859","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77886","الكامل"],[1942,"","https://poetry.dctabudhabi.ae/diwan/poem/76824","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69370","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69396","المنسرح"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104767","الكامل"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42485","المواليا"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53059","البسيط"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137239",""],[345,"","https://poetry.dctabudhabi.ae/diwan/poem/124714","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65137","الكامل"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123899","المنسرح"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/133040","المنسرح"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127031","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108273","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108291","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45819","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110007","البسيط"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81930","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28755","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133193","الكامل"],[4476,"","https://poetry.dctabudhabi.ae/diwan/poem/95757","المجتث"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33573","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139658",""],[4702,"مديت كفي وكفيت مدي","https://www.poetsgate.com/ViewPoem.aspx?id=155466",""],[4753,"بين يدي حديث الليل","https://www.poetsgate.com/ViewPoem.aspx?id=28907",""],[4578,"عُرب اللوى عن عهود الود قد حالوا","https://www.poetsgate.com/ViewPoem.aspx?id=49505",""],[4852,"أبشر","https://www.poetsgate.com/ViewPoem.aspx?id=214273",""],[4852,"رُبَّان","https://www.poetsgate.com/ViewPoem.aspx?id=215211",""],[4869,"خذني","https://www.poetsgate.com/ViewPoem.aspx?id=151532",""],[4955,"ألا يا ويح من ظلموا","https://www.poetsgate.com/ViewPoem.aspx?id=188778",""],[4968,"أقسمت","https://www.poetsgate.com/ViewPoem.aspx?id=208091",""],[5074,"خَرِيْفُ العُمر","https://www.poetsgate.com/ViewPoem.aspx?id=155797",""],[5189,"أحببتُ أن أبدي لكِ الإعجابا","https://www.poetsgate.com/ViewPoem.aspx?id=207657",""],[5190,"هتلر العربي","https://www.poetsgate.com/ViewPoem.aspx?id=61839",""],[5190,"بيني وبينكِ في الهوى ميثاقُ","https://www.poetsgate.com/ViewPoem.aspx?id=35125",""],[5212,"قبرُ الرسول(ص)","https://www.poetsgate.com/ViewPoem.aspx?id=212054",""],[5277,"رفقاً ..فديتكِ","https://www.poetsgate.com/ViewPoem.aspx?id=185761",""],[5327,"سَجَنُوك ! إلى سَجينِ السَّكَر","https://www.poetsgate.com/ViewPoem.aspx?id=156015",""],[5358,"طيرُ المَجَرّةِ","https://www.poetsgate.com/ViewPoem.aspx?id=48735",""],[5545,"ذَنبٌ يُفترى","https://www.poetsgate.com/ViewPoem.aspx?id=185000",""],[5582,"عَبَثَ الهَوَى بِكَ حَيْثُ كُنْتَ العابِثَا","https://www.poetsgate.com/ViewPoem.aspx?id=186766",""],[5582,"ما لِلْحَمائِمِ لا يَنْفَكُّ نائِحُها","https://www.poetsgate.com/ViewPoem.aspx?id=186834",""],[5609,"كم أشتاق لك","https://www.poetsgate.com/ViewPoem.aspx?id=214103",""],[5612,"ماذا جَرى لكْ !!","https://www.poetsgate.com/ViewPoem.aspx?id=179543",""],[5759,"كيف الخلاص","https://www.poetsgate.com/ViewPoem.aspx?id=213994",""],[5943,"ياصحبة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=34332",""],[5956,"يا صفحة من خدِّها","https://www.poetsgate.com/ViewPoem.aspx?id=182297",""],[5956,"أنا معجب بك‎ ‎","https://www.poetsgate.com/ViewPoem.aspx?id=182448",""],[5974,"لله هذا القلب","https://www.poetsgate.com/ViewPoem.aspx?id=207119",""]],"verses":[["يَا مَنْ مَضَى عَنْ ثَنَاءٍ","مِلْءَ النفوسِ الكَرَائِمْ",0,"م",1,0],["يا مَن مُعانِقُها يَبيتُ كَأَنَّهُ","في مَحبِسٍ قَمِلٍ وَفي ساجورِ",1,"ر",1,0],["يا من مآثره وفضل جهاده","تُحدي القطار بها إلى الأقطارِ",2,"ر",1,0],["يا من مللت من المعادِ لهُ وما","ملَّت لديَّ معادَها النعماء",3,"ا",2,0],["يا من مقام فخاره المحمود لم","تحتج دلائله إلى كشَّاف",4,"ف",1,0],["يا من مباديه نهاية معشرٍ","في العلم والحسنات كالإحسان",5,"ن",1,0],["يا من معاطفه لا الصمُّ حاش له","ولا مكاسره الخوارة الجوف",6,"ف",1,0],["يا مَن مَديحي فيهِ صِدقٌ كُلُّهُ","فَكَأَنَّما أَتلو كِتاباً مُنزَلا",7,"ل",2,0],["يا من مضيتَ خلال أناتِ الصبا","وذهبتَ بين تناوحِ الأدواحِ",8,"ح",1,0],["يا من منحت الأماني البيض معذرة","إني بهذي الأماني البيض أختنقُ",9,"ق",1,0],["يَا مَنْ مَدَحْتُهُمَا فَلَمْ تَفِ مِدْحَتِي","بِلُبَانَةٍ وَالْعُذْرِ مِنْ إِقْلاَلِي",10,"ل",2,0],["يا مَن مُلوكُ الزَمانِ قاطِبَةً","قَد أَصبَحوا حَولَ قَصرِهِ دُفَعا",11,"ع",2,0],["يأمن من صنفه من قول لو","ويستحق الشكر إِن عبدٌ شكر",12,"ر",1,0],["يا من مضى فاعتضْتُ عن أيامه","أَوْفى نظامِ المدحِ في مولانا",13,"ن",2,0],["يا من محاسنه تشوق لناظري","رفقا فديتك بالفؤاد الشيق",14,"ق",1,0],["يا مَن مَلَكَني وَعَن طَرفِ الوَفا عَرَّج","وَأَطلَقَ رُقادي وَجَفني بِالسَهر زَوَّج",15,"ج",1,1],["يَا مَنْ مَآثرُهُ عَديدَهْ","وشَبَاةُ فِطْنَتِهِ حَدِيدَهْ",16,"د",2,1],["يا من مُحنت بفقده","حوشيتُ فيك من المحن",17,"ن",1,0],["يا من ملابره النواحي","لَم يخل من بره مكان",18,"ن",1,0],["يا مَن مُلِئتُ بِحُبِّهِ وَجداً بِهِ","أَمسَيتُ مِن شُغلِ الأَنامِ مُفَرَّغا",19,"غ",2,0],["يا مَن مِن الصَيحة نَجّى صالِحاً","فَضلاً وَأَردى مِن ثَمودٍ من عَتا",20,"ا",1,0],["يا مَن ما زال تَكرُّمه","يتَملّكُني وتَودُّده",21,"د",2,0],["يا مَن مَواطر فَضلِهِ","تَربى عَلى وَكَف الديم",22,"م",1,1],["يامن منحت العلم همَّةَ مصلحٍ","حتَّى يطيب لأرضنا استقرارُها",23,"ر",3,0],["يا مَنْ مقاليدُ الأمورِ بكفِّه","عَطفاً فأنتَ بحالِ عَبدِك أعلمُ",24,"م",1,0],["يأمن من كل آفة أبداً","من كان في حصن لا إله إلا اللّه",25,"ل",2,0],["يا مَن مودّتُه سحابٌ زائلٌ","وعهُودُهُ في الحُبِّ ظلٌ قَالِصُ",26,"ص",1,1],["يا من محاسن وجهه قد افتنت","كل الأنام وكل عنها الواصفُ",27,"ف",1,0],["يا من من البحر الخض","م نوالهُ قد راح أغزر",28,"ر",1,0],["يا من مآثر نبله وشموخه","كمآثر الأضواء في لبنان",29,"ن",1,0],["يا من مخضتُ الناسَ فاستخلصتهُ","بعدَ اجتهادي فالياً منتقدا",30,"د",2,0],["يا مَن مَساعيهِ تَغدو","إِلى العُلا وَتَروحُ",31,"ح",1,1],["يا مَن مَباضِعُ دَستِهِ بِشَباتِها","تُدمى العَروقَ وَتَخرُجُ الأَعصابا",32,"ب",2,1],["يا من مواردهُ من مرّه عليَّ عذاب","حتّامَ أنتم بفوز وصيّكم بعذاب",33,"ب",1,1],["يا من مُناه المكانُ الرَّحبُ في سَفَرٍ","كالقَبر في الضِّيقِ بيتُ المطعم البلدي",34,"د",2,0],["يا من مديحهما المعطر عنه قد","عجز البليغ اللوذعيّ المقول",35,"ل",1,0],["يا مَن مَضَى وَجميلُ الصبر يتبعُهُ","هل من سبيلٍ إلى لقياك مُنتَظرِ",36,"ر",1,0],["يا مَن مضت وهي عني غيرُ غائبةٍ","وشخصُها لم يَفُت سَمعي ولا بَصَرِي",37,"ر",2,0],["يا من مضى وفؤَادي قد مضى مَعَهُ","هل عودةٌ يا ترى تُرجَى لمرتحل",38,"ل",1,0],["يا من معانيه جلت عن مديح فتى","نامي المقال بمنثور ومنتظم",39,"م",1,0],["يا من مساعيه التي حمت الورى","مثل النجوم مقيمة تنجمُ",40,"م",1,0],["يا مَن مراتِبُه سَمَت","حتّى سَمَت فوقَ الشهُب",41,"ب",1,0],["يا من مكان جلاله عند","الاله يرى مكينا",42,"ن",2,0],["يا مَنْ منَاقبُهُ مُضيفاتٌ إِلى","خَلْقِ الأَمينِ خلائقَ المأَمونِ",43,"ن",1,0],["يا مَنْ مالي عَنْهُ مَغْنَىً","زَوِّدْ نَفْسي زادَ التَّقْوى",44,"ق",3,0],["يا مَن مكارم شيبةِ الحمدِ انتهت","إرثاً إليه وزادَها إضعافَها",45,"ف",3,0],["يا من ملابسهم بها إِستبرق","إِنَّ الصبابة في هَواكم ملبسي",46,"س",2,0],["يا من مُجاجةُ فيه الخَمرُ أبرزَها","كالمسك تاجرها من دونِه وسبا",47,"ب",2,0],["يا مَن مَكارِمُهُ اللّاتي عُرِفتُ بِها","مَكارِمٌ أَنبَتَت شَعرِي عَلى راسي",48,"س",2,0],["يا مَن مُلُوكُ الدُنيا لَهُ تَبَعُ","مِثلَكَ ما أَبصَرُوا وَما سَمِعُوا",49,"ع",3,1],["يا مَن مَلَكتم عَبدَكُم بِجَمالِكُم","وَبِلُطفِكُم دُومُوا كَذَاكَ تَكَرُّما",50,"م",2,1],["يا منْ منَ البدرِ أمسى بالبها أشكلْ","ومَن على الصَّب وردُه يا فتى أشكلْ",51,"ل",1,1],["يا من مواسم أيام الزمان لها","وفد غدا فوهم في قصد كعبته",52,"ت",2,0],["يا من ملكت عقولنا وقلوبنا","برقيق لفظ من بيانك ساحر",53,"ر",1,0],["يا من مضى وبقينا بعده هملا","لو أنصف الدهر أفنانا وخلدكا",54,"ك",2,0],["يا من مفاتيحُ الكنوز مديحهُ","ولو أنّهُ بالرّصد كان مُطلسما",55,"م",2,0],["يأمَنُ ممّا يخافُ راكبُه","لأنّه عصمةٌ لمن ركِبهْ",56,"ب",2,0],["يا مَن مُحَيَّاه كاسمه حسنُ","إن نِمتَ عنِّي فليس لي وسَنُ",57,"ن",1,1],["يا من مآثره بأفاق","الهدى طلعت نجوما",58,"م",2,1],["يا من مروءَتنا به ذهبت سدى","وبنات خاطرنا السخي المرشد",59,"د",1,0],["يا من مرضتِ وما علاك بمشتك","مرضا ولا كرمُ البنان المنعم",60,"م",1,0],["يا مَن مَراتبه تَسمو بِعرفان","عزاً وَيَبلغ أَسماها بعرفان",61,"ن",1,1],["يا مَن مَضَوا ونَجَوا من لُجِّ عالَمِهِم","لكن إلى أرض مُحيي الرُوحِ ما انطَلَقوا",62,"ق",3,1],["يا من محنت به فأصبح حبه","مني ممازج للحشا وضمائري",63,"ر",2,0],["يا مَن مَحاسِنُ وَجهِهِ","تعدى وَيَحسدُهُ الحَسَن",64,"ن",1,0],["يا من ملكتم مهجتي وسوادها","بل كل أمري شدتي ورخائي",65,"ي",1,0],["يا من مَضى وَتَسَمّى","ولم يَخُنه زمانُه",66,"ن",2,1],["يا مَن مَحاسِنُ وجههِ علَمٌ","ومحبُّهُ في حبهِ عَلَمُ",67,"م",1,0],["يا من معاليه ابت إلا العلى","من دون بيض بنى الزمان وسوده",68,"د",2,0],["يا من ملكت القلب نسمع ونسفه","عذال وانته لا تجيك الهواجيس",69,"س",1,0],["يا من مَلكت َمنَ الليّالي صَفوَها","والشّمسُ أهدتْك الشُعاع َالمُلتهبْ",70,"ب",1,0],["يا من مأثره حلى الزمان وقد","أحيا الورى من نداه شنفٌ وخلخال",71,"ل",1,0],["‏يا من ملأتَ السبعَ \"آهٍ\" تائباً","أبشر؛ ففي الأيامِ تخفى المغفرهْ",72,"ه",1,1],["يا من ملكتَ رياح العدن في رئةٍ","أنا اليمامةُ في كفيك عَشْعَشَتي",73,"ت",2,0],["يامن مشيت بعروق القلب بعثرني","حُبك يرتب قوافي الشعر واوزانه",74,"ن",2,1],["يامن مزجتم بغدرٍ كأسَ مُرِّكمُ","ستشربونَ الأسى فاللهُ منتقمُ",75,"م",1,0],["يا من مددت الملك للاشواق في","عمق الحشا ضمن اعتراف ليّن",76,"ن",1,0],["يَا مَنْ مَلَكْتَ فُؤَادِيْ والهَوَى قَدَرُ","أَبَعْدَ فُرْقَةِ دَهْرٍ جِئْتَ تَعْتَذِرُ ؟",77,"ر",1,1],["يا من ملكت الحسن في أوصافهِ","فاق الحدود وحيّرَ الكتّابا",78,"ب",2,0],["يا من ملأتَ \" الأربعينَ \" خديعةً","كذباً توارى خلفَ كلِّ هتافِ",79,"ف",1,0],["يا من مَلَكتِ القلبَ منذ أسرتِهِ","واستَسلَمَت لبهائِكِ الأحداقُ",80,"ق",1,0],["يا مَنْ مَلَئتَ ديارَنا أ هجرتَها؟","أ يُقال لي ماتَ المُلقَّبُ صادِقُكْ؟",81,"ك",1,0],["يا من مهرتك أحرفاً من عسجدٍ","والبوحُ قطراً من نداوتِها هَما",82,"م",2,0],["يا مَن مُنِيتَ بِسِجنِهِم قُم فانطلِق","بالسِّجنِ نافِذَةٌ تُنَبِّهُ مَن يَرَى",83,"ر",2,0],["يا مَنْ مَلأتَ العاصِفاتِ موائداً","وبنيْتَ للإسلامِ داراً تُشْرِقُ",84,"ق",1,0],["يامنْ ملكتَ جوارحي رفقاً بها","فلطالما فيكَ الفؤادُ تَرَفق",85,"ق",1,0],["يا مَنْ مَلاهِيهِ الرَّغائِبُ وَالنَّدَى","أَبَداً وَلَيْسَ مَثانِياَ وَمَثالِثَا",86,"ث",2,0],["يا مَنْ مَواهِبُهُ لِلنَّازِلِينَ بِهِ","أَفْواجُ كُومٍ تُبارِيها قَوارِحُها",87,"ح",3,0],["(يا من متيمه هلك)","أوااااه كم أشتاق لك",88,"ك",1,1],["يا من ملكت صبابتي","وتركتني ما أعدلك",88,"ك",1,0],["يا من ملَكْتَ على الدوامِ مشاعري","أجَزايَ مِنْكَ تجاهُلٌ ومَلامُ",89,"م",1,0],["يامَن مَلكتِ فؤادي غيرَ مالكةٍ","وغادرَتني فَئيدا غيرَ مَفؤودِ ١",90,"د",1,0],["يَامَنْ مَرَرْتُمْ علَى صَحْرَائِنا مَطَرَاًَ","سَلام ُربِّيْ بكُمْ قدْ جاءَ ريَّاناَا",91,"ن",3,0],["‏يا مَن مشاعرُها الرهيفةُ تحتمي","‏ ‏ بالله ثم بساعدي الحاني السّوِي",92,"و",2,0],["يا مَن ملأت الأرض أجمعَها إلى","قلبِ الفضاءِ مع الكواكب والقمرْ",93,"ر",1,0],["يا من ملأتِ الكون عشقا ضَمَّنِي","بين الجوانح وَامْتَطَتْهُ رُؤاكِ",94,"ك",1,0]]}