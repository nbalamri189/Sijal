ww.poetsgate.com/ViewPoem.aspx?id=179050",""],[90,"شدة لندن!..","https://www.poetsgate.com/ViewPoem.aspx?id=179068",""],[90,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[90,"قتل العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179140",""],[90,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[45,"يَا خَلِيلَيَّ والأُيُورُ أَمَانَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32005",""],[45,"لامت ملامة مشفق متعتب","https://www.poetsgate.com/ViewPoem.aspx?id=33096",""],[99,"الى ضفيرتي ماس","https://www.poetsgate.com/ViewPoem.aspx?id=36371",""],[51,"كَأسكَ قد آذَنَكَ العُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=27811",""],[32,"رسمِ دارٍ وقفتُ في طَلَلِهْ،","https://www.poetsgate.com/ViewPoem.aspx?id=15982",""],[39,"هلْ يدنينَّكَ منْ أجارعِ واسطٍ","https://www.poetsgate.com/ViewPoem.aspx?id=4254",""],[78,"يا خير من يلحظه ناظري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86651&r=&rc=146",""],[63,"خاض الدُّجى -وَرِواقُ اللَّيل مَسدولِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=25938&r=&rc=0",""],[31,"يا خيليلّ، إذا لمْ تنفعا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18949&r=&rc=212",""],[31,"يا خَلِيلَيَّ، سَائِلا الأَطْلاَلا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19024&r=&rc=287",""],[31,"رَاحَ صَحبي وَلَمْ أُحَيِّ النَّوارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18873&r=&rc=136",""],[18,"أن في الصدر من كُلَيْب شجونا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26436&r=&rc=2",""],[18,"هَلْ عَرَفْتَ الْغَدَاة َ مِنْ أَطْلاَلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26460&r=&rc=26",""]],"verses":[["يا خَليلَيَّ اِنظُرا عَنّي الحِمى","إِنَّ طَرفَ العَينِ بِالدَمعِ أَغاما",0,"م",2,0],["يا خَليلَيَّ اِسقِياني","زَمَنُ الوَجدِ سَقامُ",1,"م",1,0],["يا خَيرَ مَن قالَ بَلِّغ خَيرَ مُستَمِعٍ","عَنّي وَحَسبُكَ مِن وَصفٍ وَتَقليبِ",2,"ب",1,0],["يا خَليليَّ قِفا تَحْ","تَ ظِلالِ السَمُراتِ",3,"ت",1,1],["يا خَيْرَ مَنْ بُشِّرَتْ بعدَ النّبيِّ بهِ","عَدْنانُ وادّرَعَتْ عِزّاً بهِ مُضَرُ",4,"ر",1,0],["يا خَيْرَ مَنْ تَفترُّ كلَّ شارِقٍ","عَنْ ذِكْرِهِ ضَمائِرُ المَحافِلِ",5,"ل",1,0],["يا خَيرَهُمْ حَيثُ السّيوفُ تَزيدُها","طولاً وقَد قَصُرَتْ عليكَ حَمائِلُ",6,"ل",1,0],["يا خَيرَ مَن خَضَبَتْ أخْفافَها بدَمٍ","حتّى أُنيخَتْ إِلى أبوابِهِ الإبِلُ",7,"ل",1,0],["يا خَيْرَ مَنْ وَخَدَت أيدي المَطِيِّ بهِ","مِن فرْعِ خِنْدِفَ آباءً وأجْدادا",8,"د",2,0],["يا خيرَ مَن ألقَحَ الآمالَ نائِلُهُ","بموعدٍ يَلِدُ النَّعماءَ مَضمونِ",9,"ن",1,0],["يا خاتَمَ الرُّسْلِ إنْ لَم تُخشَ بادِرَتي","على أعادِيكَ غالَتْني إذنْ غولُ",10,"ل",1,0],["يا خيْرَ منْ خفَقَتْ علَيْهِ سَحابةً","للنّصْرِ تُمْطِرُهُ أجشَّ بَجيسا",11,"س",2,0],["يَا خَاتِمَ الفَضْلِ أَوْ يَا حَاتِمَ الزَّمَنِ","وَمُشْتَرِي الْحَمْدِ بِالْغَالِي مِنَ الثَّمَنِ",12,"ن",1,1],["يا خامِلاً جاهُهُ الفُروجُ يَرى","صِهْرَ أولي الجاهِ فخْرَ مُفْتَخِرِ",13,"ر",1,0],["يا خَيْرَ مَشْروحٍ وفَى واكْتَفَى","منْهُ ابْنُ مَرْزوقٍ بخَيْرِ الشُّروحْ",14,"ح",1,0],["يَا خَيْرَ مَنْ وَطِئَ الْعِتَاقَ رِكَابُهُ","وَأَعَزَّ مَنْ حَمَلَتْ عَلَى صَهَوَاتِهَا",15,"ت",3,0],["يَا خَجْلَةً مِنْ ضَارِطٍ فِي مَحْفِلٍ","تَبْقَى غَضَاضَتُهَا عَلَى أَعْقَابِهِ",16,"ب",2,0],["يا خَيرَ مَن يَركَبُ المَطِيِّ وَلا","يَشرَبُ كَأساً بِكَفِّ مَن بَخِلا",17,"ل",2,0],["يا خَيرَ مَن حَمَلت نَعلاً لَهُ قَدَمٌ","بَعدَ النَبِيِّ لَديهِ البَغيُ مَهجورُ",18,"ر",1,0],["يا خَليطاً بِالدبسِ أَقصر عَنِ ال","شَرِّ فَقَد قيلَ رابِحُ الشَرِّ خاسِر",19,"ر",1,1],["يا خَليلَيَّ لا تُطيلا سُؤالي","سِرُّ مِثلي في الحُبِّ لا يُبديهِ",20,"ي",2,1],["ياخَيرَ مَن رَكِبَ الجِيا","دَ وَسارَ في ظِلِّ اللِواءِ",21,"ا",2,0],["يا خَليلَيَّ وَواحِدي وَالمُعَلّى","مِن قِداحي وَالمُستَبِدُّ بِبِرّي",22,"ر",2,0],["يا خَيرَ مُعتَضِدٍ بِمَن أَقدارُهُ","في كُلِّ مُعضِلَةٍ لَهُ أَعضادُ",23,"د",1,0],["يا خَليلي الغَداةَ إِنَّ دُموعي","سَبَقَت لَمحَ طَرفِها بِاِنهِمالِ",24,"ل",1,0],["يا خطيب النادي أيوفي ثنائي","منه للمعربس الحلال",25,"ل",1,0],["يا خليلي صناجة الشعر والحا","فظ فيما أجد عهد الوالي",25,"ي",1,0],["يا خير من ولته أمته فما","ضلت وكان موفقاً ورشيدا",26,"د",2,0],["يا خير منجيةٍ لأسنى من نمى","في النبعتين أعزةٌ أمجاد",27,"د",1,0],["يَا خَطِيباً يُقَوِّمُ الدَّهْرَ مْنْآ","داً وَيَثْنِي شَكِيمَةَ الحِدْثَانِ",28,"ن",1,0],["يَا خَيْرَ مَنْ رَبَّى فَأَتْحَفَ قَوْمَهُ","بِنَوَابِغِ الأَدَابِ وَالعِرْفَانِ",29,"ن",1,0],["يَا خَلِيلَ الخَلِيلِ يُهْنِئُكَ العَيْشُ","طَرَايفَ الأَنْوَارِ وَالأَلْوَانِ",30,"ن",1,0],["يَا خَارِجِينَ كِرَاماً مِنْ مَحَابِسِهِمْ","وَمُبْهِجِي كُلِّ قَلْبٍ كَانَ مَغْمُومَا",31,"م",2,0],["يَا خَيْرَ فَرْعٍ فِي الفُرُوعِ","وَخَيْرَ أَصْلٍ فِي الأُصُولِ",32,"ل",1,0],["يا خَيرَ مَن قَد حَجَّ لِل","بَيتِ الحَرامِ وَعَرَّفا",33,"ف",2,0],["يا خَيرَ مَن لَبِسَ النِعا","لَ بِسَعيِهِ وَمَن اِحتَفى",33,"ف",2,0],["يا خالِقي أَنتَ الرَقيبُ عَلَيهِمُ","في فِعلِهِم ظُلماً وَإِنَّكَ تَشهَدُ",34,"د",1,0],["يا خليليّ قَد صفا كدر العي","ش وقد أسعد الزمان الخريفُ",35,"ف",1,1],["يا خير من ورث السماحَ عن الألى","نصروا الألى وتبوّأوا الإيمانا",36,"ن",2,1],["يا خير من ملك الملوك بجوده","ولفضله قد أشبهَ الأملاكا",37,"ك",2,1],["يا خيرَ من ملك الملوكْ","أهديتني حبَّ الملوكْ",38,"ك",1,1],["يأخذ الراتب إمّاً","بلغ الشهر سراره",39,"ر",2,0],["يا خليليّ والخليل المواسي","منكما من يقوم في أسعادي",40,"د",2,0],["يا خُزرَ تَغلِبَ ماذا بالُ نِسوَتِكُم","لا يَستَفِقنَ إِلى الدَيرَينِ تَحنانا",41,"ن",2,0],["يا خُزرَ تَغلِبَ إِنَّ اللُؤمَ حالَفَكُم","ما دامَ في مارِدينَ الزَيتُ يَعتَصَرُ",42,"ر",1,0],["يا خُزرَ تَغلِبَ إِنّي قَد وَسَمتُكُمُ","عَلى الأُنوفِ وُسوماً ذاتَ أَحبارِ",43,"ر",1,0],["يا خيرَ من ذَلَّتِ المَطِيُّ لهُ","أنتُم فُروعُ العِضَاهِ لا الشَّذَبُ",44,"ب",1,0],["ياخَليلَيَّ خَلِّياني وَدَمعي","إِنَّ في الدَمعِ راحَةَ المَكروبِ",45,"ب",1,0],["يا خاتمَ الوزرا عدلاً ومعرفةً","يا مرْبعَ الغُربَا يا منجعَ الأدَبا",46,"ب",2,0],["يا خيلَ كتَّابٍ مضوا لبيوتهم","بأبي الشموسَ الجانحاتِ غوارِبا",47,"ب",2,1],["يا خليلاً جعلتهُ العينَ والقل","ب وأصفَيته سرائرَ حبِّي",48,"ي",1,1],["يا خيرَ من علقت يدي بولائهِ","أقسمت ما سدت الأكارم عن سدى",49,"د",2,0],["يا خاتمَ الوزراءِ الأكرمين ويا","أوفى ذوي الفخر في العلياء توكيدا",50,"د",2,1],["يا خير من تبسط المساعي","له ومن تعقد الخناصر",51,"ر",1,1],["يا خليلين من جواي ودمعي","لا لقيتم من العنا ما ألاقي",52,"ق",2,0],["يا خير من لولائنا وثنائنا","في بابه التقييد والإطلاق",53,"ق",1,0],["يا خاتم الرسل لي في المذنبين غداً","على شفاعتك الغراء تعويل",54,"ل",1,0],["يا خافضاً بجواره عيشي فقد","نصبت على التمييز صورة حالي",55,"ل",2,0],["يا خضوعي هلاَّ سوى الحب حتَّى","كان جود الوزير يدفع عني",56,"ي",1,0],["يا خاتم الوزراء الأكرمين ويا","عزيز مصرٍ ويا سارٍ على السنن",57,"ن",1,0],["يا خير من ينبي على جوده","كفٌّ ومن يثني عليه لسان",58,"ن",1,1],["يا خليليّ عندها خلِّياني","أنا أولى بوجنتيه صليّا",59,"ي",2,0],["يا خالد بن الخالداتِ مَخازياً","ما دام فوقَ الأرضِ ظلُّ سماءِ",60,"ا",2,1],["يا خصيماً عن الهدى","مُسْكتاً كلَّ مُسْكِتِ",61,"ت",1,0],["يا خَيْرَهُمْ نَفْساً وأنداهُمُ يداً","وأجَمَّهُمْ علماً وأرْسَاهُم رَحَى",62,"ح",2,0],["يا خالد السَّوْءات لا تَهْجُني","فأنت في شِعْرِك مكدودُ",63,"د",1,0],["يا خلاص الأسير يا صحَّة المدْ","نفِ يا زَوْرَةً على غير وعْدِ",64,"د",1,1],["يا خَلِيلَيَّ تَيَّمَتْني وَحيدُ","فَفُؤادي بها مُعَنَّىً عَمِيدُ",65,"د",1,1],["يا خائفاً بدآتٍ منه مشرِفةً","على عوائدِ سيْب منه ثرثار",66,"ر",1,0],["يأخذُ من لِيانه لِما قَسَا","تَفْري الغراميلَ إذا الليل غسا",67,"س",2,0],["يأخذ بالعينين أخذَ العمى","ويَعقِل الرجْلَين كالنِقرس",68,"س",1,0],["يا خالدَ اللؤمِ غيرَ مُؤتشبٍ","سبقْتَ باللؤم من يُجاريكا",69,"ك",2,0],["يا خالدَ ابن الخالدا","ت مخازياً لا درَّ مَحْضُكْ",70,"ك",1,1],["يا خيرَ مُعتضدٍ باللَّهِ معتمدٍ","عليه معتقدٍ ما استودَعَ المِللا",71,"ل",2,0],["يا خائفَ الطوفان إنَّ لنا أخاً","يعلو قَصيرُ قرونه الطوفانا",72,"ن",2,0],["يا خالدَ ابنَ أبيهِ","لَيْسَ الذي يَدَّعيهِ",73,"ي",2,1],["يا خَليلي هَيهاتَ يَنفَعُ نُصحُ","بَعدَما ضَيَّعَ الحَزينُ الرَشادا",74,"ا",1,0],["يا خَمرُ كَم ذا تَدَّعينَ الفَضلا","وَبِالمِياهِ تَقتُلينَ قَتلا",75,"ل",2,0],["يا خَليلَيَّ أَعينا","مَن عَصاهُ مُسعِداه",76,"ه",1,0],["يا خَصرَهُ يا رِدفَهُ","مَن لي بِنَجدٍ أَو تِهامَه",77,"م",2,0],["يا خَيرَ مَأتى أَخي هَمٍّ وَناقَتِهِ","إِذا اِلتَقى حَقَبٌ مِنها وَتَصديرُ",78,"ر",1,0],["يا خضَمَّ الحَيَاةِ يَزْخَرُ في الآ","فاق في التُّرْبِ في قرارِ المياهِ",79,"ه",1,0],["يا خَبَر مَن يَلحَظَه ناظِري","شَهادَةٌ ما شابَها زُورُ",80,"ر",1,1],["يا خَليلَيَّ إِنَّ بَثنَةَ بانَت","يَومَ وَرقانَ بِالفُؤادِ سَبِيّا",81,"ي",2,1],["يا خَليلَيَّ إِنَّ أُمَّ حُسَينٍ","حينَ يَدنو الضَجيعُ مِن عَلَلِه",82,"ل",2,0],["يأخذ من هذا وذاك بالربا","يعطى نحاسا ليرد ذهبا",83,"ب",2,1],["يأخذ الله وإن طال المدى","ويُدان المرء ما كان يدين",84,"ن",1,0],["يا خارجا من عُلبه","يا حادثا من لُعبه",85,"ه",1,0],["يَأخُذُ ما عَوَّدتِهِ","وَالمَرءُ ما تَعَوَّدا",86,"د",2,0],["يَأخُذُ العيشَةَ فيهِ","مُرَّةً آناً وَحُلوَه",87,"و",2,0],["يا خادِمَ الإِسلامِ أَجرُ مُجاهِدٍ","في اللَهِ مِن خُلدٍ وَمِن رِضوانِ",88,"ن",1,0],["يا خَيرَ مَن جاءَ الوُجودَ تَحِيَّةً","مِن مُرسَلينَ إِلى الهُدى بِكَ جاؤوا",89,"ا",1,0],["يا خَليلَيَّ صِفا لي حيلَةً","وَأَرى الحيلَةَ أَن لا تَصِفا",90,"ف",2,0],["يا خَطيبَ الدَهرِ هَل مالَ البِلى","بِلِسانٍ كانَ ميزانَ الشُؤون",91,"ن",1,0],["يَأخُذُ المالَ مِن مَواعيدَ ما كا","نوا لَها مُنجِزينَ فَهيَ هَباءُ",92,"ا",2,0],["يا خَجْلَتي منهُ ومِنْ قولِهِ","ما ضَرَّكَ الفَقْدُ لَنَا شَيّا",93,"ي",2,0],["يا خَيرَ مَن أَوجَفَت لِطاعَتِهِ العُج","مُ وَسارَت في حَوزَةِ العَرَبُ",94,"ب",1,0],["ياخِضرُ أَنتَ مُسَوَّدٌ في سادَةٍ","مِن كُلِّ مُحتَضَرِ الرُواقِ مُحَجَّبِ",95,"ب",1,0],["يا خَليلَيَّ نِمتُما عَن مَبيتٍ","بِتُّهُ آنِفاً وَنَومي مُطارُ",96,"ر",1,0],["يا خَليلي بَل لَستَ لي بِخَليلِ","جِدَّ عَن كُلِّ ما عَهَدتَ رَحيلي",97,"ل",2,1],["يا خَليلَيَّ باكِرا الراحَ صُبحاً","وَإِسقِياني مِن صِرفِ ما تَمزُجانِه",98,"ن",2,0],["يا خَليلَيَّ وَأُيورُ أَمانَه","وَالبُظورُ المُبَقَّياتُ دِيانَه",99,"ن",2,1],["يا خَيرَ حَيٍّ وَقَت نَعلٌ لَهُ قَدَماً","وَمَيِّتٍ بَعدَ رُسلِ اللَهِ مَقبورِ",100,"ر",1,0],["يا خَيرَ مَن رَفَعَت إِلَيهِ مَطِيَّةٌ","بِمُطَرَّدٍ جَهَدَ المَطِيَّةَ مُضمَرِ",101,"ر",1,0],["يا خَيرَ مَن خَبَطَت إِلَيهِ مَطِيَّةٌ","ما عَنكَ لي وَلِصاحِبي مِن مِزحَلِ",102,"ل",1,0],["يا خالديُّ وكلُّ خِزْيِكَ خالدٌ","لا يَنْقَضي للناظرِ المُتأمّ