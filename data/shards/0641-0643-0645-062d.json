",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139500",""],[4683,"عصر شبابي في الهوى عذبا صفا","https://www.poetsgate.com/ViewPoem.aspx?id=166757",""],[4767,"دعوة صادقة","https://www.poetsgate.com/ViewPoem.aspx?id=178387",""],[4767,"مهوى القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=178758",""],[463,"أجدك بعد أن ضمَّ الكثيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=17990",""],[4830,"سجيّةُ الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=194089",""],[4908,"حقوق العشق","https://www.poetsgate.com/ViewPoem.aspx?id=207333",""],[4927,"خاتمة","https://www.poetsgate.com/ViewPoem.aspx?id=29602",""],[4943,"القطرة الغيثية والوسيلة الالهية","https://www.poetsgate.com/ViewPoem.aspx?id=125974",""],[5090,"سوادُ الليل","https://www.poetsgate.com/ViewPoem.aspx?id=184961",""],[5216,"إهداء لأبي القاسم الشابي","https://www.poetsgate.com/ViewPoem.aspx?id=186824",""],[5232,"تأمُّلات","https://www.poetsgate.com/ViewPoem.aspx?id=212284",""],[308,"هَل الْبَرْق قد وشى مطارف ديجور","https://www.poetsgate.com/ViewPoem.aspx?id=189361",""],[307,"صراخ الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=213646",""],[5680,"قريب على بعد أنا منك","https://www.poetsgate.com/ViewPoem.aspx?id=204357",""],[5972,"متى مضر الحمراء تطلب ثارها","https://www.poetsgate.com/ViewPoem.aspx?id=170786",""],[5309,"أنوار هادي الورى في كعبة الحرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573517",""],[6242,"كذّابة الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87565&r=&rc=12",""],[463,"أجدك بعد أن ضمَّ الكثيبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59969&r=&rc=25",""]],"verses":[["فَكَم حَمضَةٍ مِنكُم لَنا بِقَرارَةٍ","يَعودُ إِلَيها ناشِطٌ بَعدَ قاطِفِ",0,"ف",1,0],["فَكَم حادَ عَنّي الحَينُ وَالسَيفُ مُصلَتٌ","وَهانَ عَلَيَّ الأَمرُ وَهوَ عَسيرُ",1,"ر",1,0],["فَكَم حَطمَةٍ حَطَمَ الشِعرُ فيهِ","وَكَم عَيثَةٍ عاثَها",2,"ث",3,0],["فكم حرثوا في أرض مستعمراتهم","مظالم سوداً كنّ من أسوأ الحرث",3,"ث",1,0],["فكم حَمَل في مجمع القوم يُتّقى","به ثعلب عند الخلاء وذيب",4,"ب",1,0],["فَكَم حَثا قَبرَكَ مِن راغِبٍ","وَكَم حَشا تُربَكَ مِن آمِلِ",5,"ل",1,0],["فكم حَطْمةٍ حَطَمَ الشعر في","هِ ثَمَّ وكم عَيْثةٍ عاثَها",6,"ث",3,0],["فكم حُقنتْ بصفحكَ من دماءٍ","محللةٍ وقد كادتْ تشيطُ",7,"ط",1,0],["فَكَم حَقَنَت في تَغلِبِ الغُلبِ مِن دَمٍ","مُباحٍ وَأَدنَت مِن شَتيتٍ مُفَرَّقِ",8,"ق",1,0],["فكم حلَّتْ بساحتِكَ الأماني","فلم يَصْدُرْنَ عن وِرْدٍ ثِمادِ",9,"د",1,0],["فَكَم حُقوقٍ لَكُمُ سَوابِقٍ","وَمِنَّةٍ سالِفَةٍ لَم تُجحَدِ",10,"د",1,0],["فَكَم حاوَلتَها سَراةٌ لَكُمُ","فَرُدَّت عَلى نَكصِ أَعتاِبِها",11,"ب",3,0],["فكم حَسَدَتْها بَيْعَةٌ وكنيسةٌ","وقد فُكَّ من أيدي اليهودِ لها أَسْرُ",12,"ر",1,0],["فَكَم حِرزِ عِزٍّ قَد غَشيتَ بِبَطشَةٍ","تُصِمُّ العِدى رَجّاتُها حينَ تُسمَعُ",13,"ع",1,0],["فَكَم حَلَّ في أَحشائِهِم مِنكَ مِن جَوىً","وَكَم حَلَّ في أَيديهِمُ لَكَ مِن نُعمى",14,"م",2,0],["فكَمْ حَسَدَتْها في العُلُوِّ كواكبٌ","وغارَتْ عليها في الكمالِ بُدُورُ",15,"ر",1,0],["فَكَم حَطَّمَت مِن جَندَلٍ بِمَفازَةٍ","وَخاضَت كَتَيّارِ الفُراتِ بِوادِ",16,"د",1,0],["فَكَم حَلَّت عُقودُ النَظمِ وَهناً","عُقوداً لِلرَشادِ مُنَظَّماتِ",17,"ت",1,0],["فَكَم حَلَّها مِن ضَيغَمٍ في عَرينِهِ","وَكَم سَكَنَتها ظَبيَّةٌ في كِناسِها",18,"ه",2,0],["فكَمْ حلّهُ مِن أصْمَعِ القلْبِ آيسٍ","يطولُ ابنَ أوْسٍ فَضْلُه وابنَ أصْمَع",19,"ع",1,0],["فَكَم حَسَراتٍ هاجَها بِمُحَسِّرٍ","وَقوفِيَ يَومَ الجَمعِ مِن عَرَفاتِ",20,"ت",1,0],["فكم حامل علما في الجهل لو درى","سلامته مما إليه يصير",21,"ر",1,0],["فكم حامل علماً وفي الجهل لو درى","سلامته مما إليه يصير",22,"ر",1,0],["فَكَم حاوَلتَ مُعجِزَةً فَكانَت","وَقَد حَكَمَ الوَرى أَن لا تَكونا",23,"ن",2,0],["فَكَم حازَ مِن فَضلٍ وَكَم مِن مَزيَّةٍ","وَمِن شِيمٍ عُلويَّةٍ قُدُسيَّةٍ",24,"ه",1,0],["فكم حادث وافا دعوتكم له","ولانت خطوب منه وهي صعاب",25,"ب",1,0],["فكم حامل أحييت ميت ذكره","فراح وأعلام النباهة ترفع",26,"ع",1,0],["فكم حيلةٍ لِيَ في الغانيا","تِ تُعْيي مِن الناس محتالها",27,"ل",3,0],["فَكَم حَولَها مِن مُستَجيرِ وَعائِذٍ","وَكائِن لَدَيها مِن وُفودٍ وَسُؤالِ",28,"ل",1,0],["فكم حديثٍ قد أتى محذّرا","من شرّها وصحّ عن خير الورى",29,"ر",2,0],["فكم حنّت خمائلُ وارجَحَنَّت","ونَفحُ نَسيمها مشيُ الوئيد",30,"د",1,0],["فَكَم حولها من هائمين بحبها","وَبين يديها من ركوع وَسجد",31,"د",1,0],["فَكَم حاسِدٍ لِرُؤوسِ الكُؤوسِ","إِذا هُنَّ شافَهنَ تِلكَ الشِفاها",32,"ا",3,0],["فَكَم حُسامٍ عَلى مَنابِرِ شا","ذَروانِها لِلمِياهِ مَشهورِ",33,"ر",1,0],["فكم حملتْ عن العربِ الرزايا","كذاك الأُمُّ تدفعُ عن حماها",34,"ا",3,0],["فكم حسرات في نفوس يثيرها","بعادي إذا ما العيس للبين ذمت",35,"ت",1,0],["فكم حائدٍ عن طاعةِ الحقِّ حائنٍ","أُحيطَ به والبَغْيُ صارِعُ مَنْ بَغَى",36,"غ",2,0],["فكم حاد بي أن لم أنل منهم مُنى","وكم عاد بي أن لم أجِدْ منهمُ بُدّا",37,"د",2,0],["فكم حاجة منك طلبنا فانجزت","وزدت عليها فوق أضعافها يربي",38,"ب",2,0],["فكَمْ حَمَلَتْ مِنْ حُرِّ قَلْبٍ مُولَّهٍ","يُبَلِّغُ عَنْهُ النَّجْمُ قَلْباً مُوَلَّها",39,"ل",3,0],["فكم حرة حُزنا عليك تبلهت","وقد كانَ واقيها عن الأَعين الخدر",40,"ر",1,0],["فكم حشاً قرّت على أمنها","بعد افتراشِ الحذرِ المقلقِ",41,"ق",1,0],["فكم حازت قدود قناك منها","قدوداً كالقنا لوناً ولينا",42,"ن",2,0],["فكم حلبة للغيث دمعي جوادها","وملحمة للوجد صبري هزيمها",43,"م",3,0],["فكم حط الوظائف من خسيس","وكم رفع السجون فتى عفيف",44,"ف",1,0],["فكمْ حوْلَها ليثٌ بحُلّة أرقَمٍ","يطوفُ وكم خِشفٍ بعينيهِ ضيغَمُ",45,"م",1,0],["فكمْ حاجةٍ لي ضاع مِنِّي نَجاحُها","وكم أَمَلٍ لي طالَ مِنِّي ارْتِقَابُه",46,"ب",2,0],["فكم حَاجبٍ يَلْقَاكَ مِنْ دونِ أَعْيُنٍ","وكَمْ أَعْيُنٍ تَلْقاكَ من دُون حَاجبِ",47,"ب",1,0],["فكم حوت حكما أبناؤها افتخروا","على الأنام بها من سالف الحب",48,"ب",1,0],["فَكَم حَربٍ أهابَ بِها فَعَفَّت","عَلى ذي قار أو حَربِ الفِجار",49,"ر",1,0],["فكم حسرةٍ للشيب عنديَ ليتَني","وَردتُ غِمارَ الموتِ قَبلَ ورُودِها",50,"د",3,0],["فكم حكم فضوا بعلك شكيمها","جماحا ومروا اليوم بالغلواء",51,"ا",2,0],["فَكَم حازم في الخطب يبدي تجلداً","وَزند الجوى عن نار مهجته واري",52,"ر",2,0],["فَكَم حمدَت مِنهُ الفَوارِسُ صولَةً","وَعاد فَكانَ العود أَحمى وَأَحمَدا",53,"د",2,0],["فكمْ حكمةٍ أبْدى وكم صِرْفةٍ جَلَّى","وعلمٍ رفيعٍ ظاهرِ الفضلِ مُحْكَمِ",54,"م",1,0],["فَكَم حَكَموا بِالقتلِ في نُطقِ ناطِقٍ","وما نَسَبوا في الشّرعِ حُكماً لِساكتِ",55,"ت",1,0],["فَكَم حالَةٍ تَأتي وَيَكرَهُها الفَتى","وَخيرَتُهُ فيها عَلى رَغمِ أنفِهِ",56,"ه",1,0],["فَكَم حَرَّكَ القَومَ يَبغي الذّهاب","فَقَاموا وَما آنَ وَقتُ القِيام",57,"م",1,0],["فَكَم حازَت هَوادِجُهُنَّ رِدفاً","ثَقيلاً جاذَبَ الخَصرَ النَحيلا",58,"ل",2,0],["فَكم حيت من بيدبيها ودكادك","ومن تلع موصولة بالأباطحِ",59,"ح",1,0],["فكم حاقنا من بعدك الحزن والبكا","عليكَ وكم اورثتنا كل حسرةِ",60,"ه",1,0],["فكَمْ حَسَّنْتَ بالإِحْسانِ نَدْياً","وكمْ أَرغَمْتَ بالإِيمانِ نِدَّا",61,"د",2,0],["فكم حاجةٍ حال الحيا دون بثّها","ودمع نهته زفرةٌ فَتَحَيّرا",62,"ر",2,0],["فكم حاكى سهل جبين ليلى","برونقه وما مات العذول",63,"ل",1,0],["فكم حلم أفاد المرء عزاً","ومن جهل أفاد المرء هونا",64,"ن",2,0],["فكم حلا بك نادٍ","فيها وطاب جوار",65,"ر",1,0],["فَكَم حملت عتاق الخيل منهم","أسودا تدهش الاسد الشَجيعا",66,"ع",2,0],["فكم حامد كم ذاكر ومسبح","وكم مذنب يشكو لمولاه بلواه",67,"ه",1,0],["فكمْ حكتْ خبراً عنها فحاكَ بهِ","مطارفَ الشَّغَفِ المستفهم الحاكي",68,"ك",2,0],["فكم حلالي بالتصابي بها","لبسُ الخلاعات وخلع العِذار",69,"ر",1,0],["فكم حرب نحاها فاستدارت","رحاها تطحن الهام الحصيدا",70,"د",2,0],["فكم حملوا جداول في بحور","أو اعتقلوا إلى أسد عرينا",71,"ن",2,0],["فكم حكمةٍ من جيب فكرته بدت","لنا فاستقلت بالنجوم الثواقب",72,"ب",1,0],["فكم حكم في طي أحكامه له","يدبّرها تجلو القلوب فتهتدي",73,"د",2,0],["فكم حديث حديث الفضل منه فشا","فساد فيه على من ساد في القدم",74,"م",1,0],["فَكَم حَدَث العلم الشَريف بِفَضلِهِ","وَكَم فازَ مِن أَسرارِهِ بِمَعاني",75,"ن",2,0],["فكَم حالَةٍ بالعَبدِ ظُنَّت خَسارَةً","فلَمَّا تَعَدَّتهُ إِذا هِيَ مَغنَمُ",76,"م",1,0],["فكم حسدٍ أرغمتُ فيه أنوفهم","وما زلت طول الدهر أرغم حسَّدا",77,"د",2,0],["فكم حطَمَت لواءً من لوي ال","على عدوا وكم نطحت مُعدا",78,"د",2,0],["فكم حاولت تيسيرا لأمر","به فغدا يعسّر لي الأمورا",79,"ر",2,0],["فكم حن لكم قلبي","بالآصال والبكره",80,"ر",2,0],["فكم حشدوا على ورد المنايا","كما حشد الظماء علىالنمير",81,"ر",1,0],["فكم حل إبراهيم إبرام أمرهم","وإبرام ما حلّوه فهو معقد",82,"د",1,0],["فكم حاسدٍ بالنقل عنك أساءني","أكان صدوقا أو تراه كذوبا",83,"ب",2,0],["فكم حاز وصفاً زكياً وكم","زها في المعاني بطبع حميد",84,"د",1,0],["فكم حمدت على حكم وكم شهدت","بأنك الليث في الحرب الشهادات",85,"ت",1,0],["فَكَم حسوت مِن لما","هُ كلّ بارِدٍ عذب",86,"ب",1,0],["فكم حلا منكم لعيني رشا","مزمع السرب عشياً بنا",87,"ن",2,0],["فكم حية لين مسها","وكم عمر حي بها قد زهق",88,"ق",1,0],["فكَم حُظْوةٍ تُفيدُها أو لحْظِ","للفَوْز منَ الدّنيا بأوفَى حَظِّ",89,"ظ",1,0],["فكم حصانٍ من الاستار قد برزت","حسرى غداةَ عليها خدرها ولجا",90,"ج",2,0],["فكم حنت لكم من فرط شوق","وكم هزت أصابعها تشير",91,"ر",1,0],["فكم حملت ثقلاً من الضيم آدها","وقد كان حملاً في فظاعته إدَّا",92,"د",2,0],["فَكم حرّم السهلَ الحَلالَ عَلى العِدا","وَكَم حلَّل الصَعبَ المَنيعَ المحرّما",93,"م",2,0],["فكم حكمةٍ أبدت بدائعُ نظمِه","يدوم عَلى مر الجديدين زينها",94,"ن",3,0],["فكم حرصنا عَلى مشهودِ زاهرةٍ","ولو بدا الغيب لم نغرر بمزهوده",95,"د",2,0],["فكم حوّلوا من نعمةٍ بعد نعمةٍ","وَكَم حوّلوا من نقمةٍ بعد نقمة",96,"ه",1,0],["فَكم حفظوا لدين اللَه حقاً","وَكم عدلوا عَلى دَهرٍ ظَلوم",97,"م",1,0],["فكم حسرةٍ منهم قد جَرَت","علي وكم أدمعٍ سَحَّتِ",98,"ت",1,0],["فكم حميت بالاستدراك ذا أسف","لكن عن المشتهي والبراء من سقمي",99,"م",2,0],["فكم حمق تلقاه يضحك من غنى","وكم ذي حجى نلقاه يبكي من العدم",100,"م",1,0],["فكم حكم الشوق المبرح فيهم","ولا حكمَ إلا ما به الشوق يحكم",101,"م",1,0],["فَكَمْ حَفَّها رُزْءٌ جَلِيلٌ ونابَها","شُجُونٌ إِذا عُدَّتْ شَجاك عَديدُها",102,"د",3,0],["فكم حشري أحمق متشرِّع","بشرعة أهل الظن ضلّ كحجَاج",103,"ج",1,1],["فكم حررت سفتجة","عليها منهما شارة",104,"ر",2,0],["فكم حاجة عظمى ترجّى بقربكم","وكم من مدى في الدين دون مداكم",105,"م",1,0],["فكم حمد الوجود جداك حتى","وفي حمداً وفاء إلى الوفاء",106,"ا",2,0],["فكم حزنٍ يرادفه سرور","وراحاتٍ يرادفها عناء",107,"ا",2,0],["فكم حمام الهجر فيهم هتفت","مذ بهم القمري شوقا هتفا",108,"ف",2,0],["فكم حلَّقت حيثما حلَّقتْ","رؤاه فصارت بِها سامقة",109,"ق",2,0],["فكم حول الضريح لهم نباحٌ","وكم جالوا بسطوتهم وصالوا",110,"ل",3,0],["فكم حقًّ به وجدَ انت