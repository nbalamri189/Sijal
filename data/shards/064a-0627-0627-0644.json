"https://www.aldiwan.net/poem33402.html","الخفيف"],[403,"قال عبد مسه طول الضرر","https://www.aldiwan.net/poem33934.html","الرمل"],[409,"يا آلف الهم لا تقنط فأيأس ما","https://www.aldiwan.net/poem32050.html","البسيط"],[416,"ما غاب بدر دجى منكم ولا غربا","https://www.aldiwan.net/poem53990.html","البسيط"],[429,"هناء لديكم والهناء بكم لنا","https://www.aldiwan.net/poem40500.html","الطويل"],[429,"يا من له روض الفؤاد مكان","https://www.aldiwan.net/poem41036.html","الكامل"],[429,"يرق بدا ام ثغرك الجوهر","https://www.aldiwan.net/poem41418.html","السريع"],[429,"ماست فازرت غصون البان بالميل","https://www.aldiwan.net/poem41419.html","البسيط"],[432,"هل في قطار النصر نسر واقع","https://www.aldiwan.net/poem12385.html","الكامل"],[432,"حمد السرى من كنت وجه صباحه","https://www.aldiwan.net/poem12584.html","الكامل"],[437,"سل دار هند بالكثيب الفرد","https://www.aldiwan.net/poem2579.html","الرجز"],[437,"أين الديار فهذه الجرعاء","https://www.aldiwan.net/poem2589.html","الكامل"],[437,"خف القطين وبان الرائح الغادي","https://www.aldiwan.net/poem2619.html","البسيط"],[441,"الرزء أفجع أن نسح دموعا","https://www.aldiwan.net/poem14461.html","الكامل"],[441,"رزء بنا حل حتى صار محلولا","https://www.aldiwan.net/poem14473.html","البسيط"],[458,"أنشد من عهد ليلى غير موجود","https://www.aldiwan.net/poem56215.html","البسيط"],[458,"أفلح قوم إذا دعوا وثبوا","https://www.aldiwan.net/poem56299.html","المنسرح"],[461,"يا آل جعفر الفياض جودكم","https://www.aldiwan.net/poem16418.html","البسيط"],[468,"يا كثير الإنخلاع","https://www.aldiwan.net/poem59886.html","مجزوء الرمل"],[479,"سعيا لأجلك في الرعيل المهتدي","https://www.aldiwan.net/poem36956.html","الكامل"],[479,"يا ثابت الراي في الأعمال تجريها","https://www.aldiwan.net/poem37595.html","البسيط"],[482,"طريقتنا قطع العلائق والخطو","https://www.aldiwan.net/poem24360.html","عموديه"],[495,"يا آل عصم أنتم أولو العصم","https://www.aldiwan.net/poem10276.html","مشطور الرجز"],[500,"يا إلهي يا معين العاجزين","https://www.aldiwan.net/poem37550.html","الرمل"],[500,"يا آلهي بدولة الأسماء","https://www.aldiwan.net/poem37720.html","الخفيف"],[500,"يا إلهي بمحكم القرآن","https://www.aldiwan.net/poem37748.html","الخفيف"],[500,"آه من وزري الجسيم الثقيل","https://www.aldiwan.net/poem37926.html","الخفيف"],[515,"المدح يدري أنكم أكبر","https://www.aldiwan.net/poem12115.html","السريع"],[515,"لله من يوم أغر مجمل","https://www.aldiwan.net/poem12208.html","الكامل"],[529,"لست أسوى قط شيئا","https://www.aldiwan.net/poem37387.html","مجزوء الرمل"],[529,"إن لله في العباد رجالا","https://www.aldiwan.net/poem37393.html","الخفيف"],[551,"يا آل خير عباد الله كلهم","https://www.aldiwan.net/poem47180.html","البسيط"],[551,"يا دار دار الصوم القوم","https://www.aldiwan.net/poem47200.html","السريع"],[551,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[551,"ليت أنا لما فقدنا الهجوعا","https://www.aldiwan.net/poem47716.html","الخفيف"],[551,"هل أنت لصب القلب معمود","https://www.aldiwan.net/poem47841.html","البسيط"],[551,"قف بالديار المقفرات","https://www.aldiwan.net/poem48026.html","مجزوء الكامل"],[562,"يا آل ثابت بعد فقد كريمكم","https://www.aldiwan.net/poem52663.html","الكامل"],[562,"ثار الدخان فلم يظهر له لهب","https://www.aldiwan.net/poem52769.html","البسيط"],[575,"يا حيرة الحق لما غيب الهادي","https://www.aldiwan.net/poem2786.html","البسيط"],[576,"يا آل بكر ألا لله أمكم","https://www.aldiwan.net/poem1798.html","البسيط"],[586,"أأخاف صرف الدهر أم حدثانه","https://www.aldiwan.net/poem17502.html","الكامل"]],"verses":[["يا آلَ عَدنانَ الَّذينَ تَبَوَّأوا","في المَجدِ كُلَّ مُمَنَّعِ الأَركانِ",0,"ن",1,0],["يا آلَ زَيدِ مَناةَ هَل مِن زاجِرٍ","لَكُمُ فَيَنهى الجَهلَ عَن هَمّامِ",1,"م",1,1],["يا آلَ بَيتِ رَسولِ اللَهِ حُبَّكُمُ","فَرضٌ مِنَ اللَهِ في القُرآنِ أَنزَلَهُ",2,"ه",1,1],["يَا إِلاَهِي أَدْرِكْ بِلُطْفِكَ ضَعْفِي","إِنَّ مَا أَشْتَكِيهِ لَيْسَ بِهَيْنِ",3,"ن",1,0],["يَا آلَ نَصرٍ إِنْ تُذُوكِرَ مَفْخَرٌ","لاَتَفْضَحُوا مَنْ دُونكُمْ وَتَرَسَّلُوا",4,"ل",3,0],["يا آلَ زَغلولٍ ذَوى","مِن رَوضِكُم غُصنٌ رَطيب",5,"ب",1,0],["يا آلَ زَغلولٍ وُعو","دُكُمُ عَلى الجُلّى صَليب",5,"ب",1,0],["يا آلَ عُثمانَ ما هَذا الجَفاءُ لَنا","وَنَحنُ في اللَهِ إِخوانٌ وَفي الكُتُبِ",6,"ب",1,0],["يا أَليَنَ الناسِ أَعطافاً وَأَفتَنَهُم","لَحظاً وَأَعطَرَ أَنفاساً وَأَردانا",7,"ن",2,0],["يَا أَلِيفِي مِنَ الصِّبَا هَلْ تَلَتْ أَفْ","رَاحَنَا الذَّاهِبَاتِ إِلاَّ الشُّجُونُ",8,"ن",1,0],["يَا آلَ بَرْنُوطِي تَحِيَّةَ صَاحِبٍ","فِي وِدِّهِّ لَكُمُ المَكَانُ العَالِي",9,"ل",2,1],["يا آلَ بَيتِ المُصطَفى","يا أَهلَ مَكَّةَ وَالصَفا",10,"ف",2,1],["يا آلَ أَحمَدَ ما لَقيتُم بَعدَهُ","مِن عُصبَةٍ هُم في القِياسِ مَجوسُ",11,"س",1,0],["يا آلَ بَسّامِ في المَخازي","وَعابِسي الوَجهَ في السُؤالِ",12,"ل",1,1],["يا آل نصر أنتم سُرُجُ الهدى","في كلّ خطب قد تجهم مظلم",13,"م",1,0],["يا آل مطران لكم ندرة","وأكرم الناس هو النادر",14,"ر",1,0],["يا آلَ بارِقَ لَو تَقَدَّمَ ناصِحٌ","لِلبارِقيِّ فَإِنَّهُ مَغرورُ",15,"ر",1,0],["يا آلَ مَروانَ إِنَّ اللَهَ فَضَّلَكُم","فَضلاً عَظيماً عَلى مَن دينُهُ البِدَعُ",16,"ع",1,0],["يا آلَ مَروانَ إِنَّ اللَهَ فَضَّلَكُم","فَضلاً قَديماً وَفي المَسعاةِ تَقويمُ",17,"م",1,0],["يا آلَ بَكرٍ أَلا تَنهَونَ جاهِلَكُم","عَبدَ بنِ رَخصَةَ عَنزاً بَينَ أَتياسِ",18,"س",1,1],["يا آلَ سَهمٍ فَإِنّي قَد نَصَحتُ لَكُم","لا أَبعَثَنَّ عَلى الأَحياءِ مِن قُبِرا",19,"ر",2,0],["يا آلَ تَيمَ أَلا يُنهى سَفيهُكُمُ","قَبلَ القِذافِ بِأَمثالِ الجَلاميدِ",20,"د",1,0],["يا آلَ فضلِ اللهِ مدحكمو","إلفي القديمُ وشعبُكمْ شعبي",21,"ب",2,0],["يا آل أيوب بشراكم بوجه فتًى","مظفر الحد طلاعٌ على نجد",22,"د",1,0],["يا آل حماد الكرام بذكركم","نعش الزمان كأن ذكركمو غذا",23,"ذ",2,0],["يا آل فضل الله دمتم في الثنا","والأجر كنزاً للعفاة مشاعا",24,"ع",2,0],["يا آل أيوب سقتكُم","سحبُ الرضا تحت الضرائح وَبْلها",25,"ل",3,1],["يا آل سبك الخلاص مجدهم","نطقتم الشعر بعد إفحامه",26,"م",2,0],["يا آل تغلب لا يغلب تصبّركم","صرف الزمان ولا تذهب عظائمه",27,"م",2,0],["يا آل أيوب صبراً إنَّ إرثكمو","من اسم أيوب صبر كانَ ينجيه",28,"ي",2,0],["يا آل بِشرٍ أبشروا كلّكُمْ","فقد وَلَدْتُمْ مَطلباً مهرَبا",29,"ب",2,0],["يا آل وهبٍ شهدتْ ضرطَةٌ","سارتْ بها الأمثالُ في وَهْبِ",30,"ب",1,1],["يا آل حمَّاد تَقَاعَسَ أمركم","عن خَتْمِهِ وتجدَّد استفتاحُهُ",31,"ح",2,0],["يَا آلَ وَهْبٍ باتَ أعْداؤكم","من بين مذبوحٍ ومَشْبُوحِ",32,"ح",1,0],["يا آل طاهرٍ الأعلين مَرْتبةً","لازلتُمُ رغم أعداءٍ وحسّادِ",33,"د",1,0],["يا آل نُوبَخْتَ كفُّوا من غزالكُم","عنِّي فلم يتَّرِكْ قلباً ولا جسدا",34,"د",2,1],["يا آل بلبلٍ الكرا","م بيمنكمُ صلح العذيرُ",35,"ر",1,0],["يا آل وهبٍ حدِّثوني عنكُمُ","لمْ لا تَروْنَ العدلَ والإقساطا",36,"ط",2,0],["يا آل طاهرٍ المطهَّر كاسمه","كم فيكُمُ للخير من يَنبوع",37,"ع",1,0],["يا آل وهب ألا ينهى سماحكم","إلحاح كل ملث الودق وكَّافِ",38,"ف",1,1],["يا آل وهب أدام الله دولتَكم","لقد رعيتم فلا خوف ولا عجف",39,"ف",1,0],["يا آل وهب سمت بكم رتبٌ","يقصِّر السؤل عن سوامقها",40,"ق",3,0],["يا آل طاهر المطهر كاسمه","إن اللسان بمدحكم لطليق",41,"ق",1,0],["يا آلَ نوبختَ لا عدمتُكمُ","ولا تبدَّلتُ منكُمُ بدلا",42,"ل",2,0],["يا آلَ هَمّامِهِ يا آلَ مُرَّتِهِ","يا آلَ شيبانه يا آلَ وائلِهِ",43,"ل",2,0],["يا آلَ وهبٍ أعينوني على رجلٍ","أعلى وأثقل في الميزان من جبلِ",44,"ل",1,0],["يا آل طاهر المُطهَّر كاسمه","لا تعدموا نعماً ترفُّ نواعما",45,"م",2,0],["يا آل حماد العلا ما فيكمُ","إلا كريمٌ ماجدٌ وحكيمُ",46,"م",1,0],["يا آل وهب حماةَ حَوزَتِنا","نكَّبَ عنكُم بسهمهِ الرَّامي",47,"م",2,0],["يا أَلِفاً مِن قَدِّهِ أَقبَلَت","بِاللَهِ كوني أَلِفَ الوَصلِ",48,"ل",1,0],["يا أَلفَ مَولايَ مَهلاً","يا أَلفَ مَولايَ رِفقا",49,"ق",2,0],["يا إلهَ الوُجُودِ هذي جِراحٌ","في فُؤادي تَشْكو إليكَ الدَّواهي",50,"ي",1,1],["يا إله الوُجُود مَا لَكَ لا ترثي","لحُزْنِ المُعَذَّبِ الأَوَّاهِ",50,"ه",1,0],["يا إلهي قَدْ أَنْطَقَ الهمُّ قلبي","بالذي كانَ فاغتفر يا إِلهي",50,"ي",1,0],["يا إِلهي أما تحسُّ أَما تشدو","أَما تشتكي أَما تتكلَّمْ",51,"م",1,0],["يا آلَ عُثمانَ أَبناءَ العُمومَةِ هَل","تَشكونَ جُرحاً وَلا نَشكو لَهُ أَلَما",52,"م",2,0],["يا آلَ حِمْصَ تَوَقّعوا مِنْ عارِهَا","خِزْياً يَحِلُّ عَليكُمُ وَوَبَالا",53,"ل",2,0],["يا آل حيدَرَةَ المعفّر خدُّهم","عبد المسيح على اسمِ عبد منافِ",54,"ف",1,1],["يا آلَ تَميمٍ أَلا لِلَّهِ أُمُّكُمُ","لَقَد ر