{"poems":[[79,"مقامك مرفوع على عمد السعد","https://www.aldiwan.net/poem36604.html","الطويل"],[95,"وارحمتا لي من صروف زماني","https://www.aldiwan.net/poem11180.html","الكامل"],[32,"بكيت وما يبكيك من رسم منزل","https://www.aldiwan.net/poem29575.html","الطويل"],[85,"لمن قبة حمراء مد نضارها","https://www.aldiwan.net/poem54346.html","الطويل"],[53,"تفاءلت والفأل لي معجب","https://www.aldiwan.net/poem9220.html","المتقارب"],[53,"عيدان مجموعان في عيد","https://www.aldiwan.net/poem11441.html","السريع"],[63,"بودي لو ملكت ثني قيادي","https://www.aldiwan.net/poem51727.html","الطويل"],[107,"كذب الوشاة وأخطأ اللوام","https://www.aldiwan.net/poem43167.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16701","الطويل"],[96,"البلبل الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=12827",""],[119,"امن نفحات ازهار العراق","https://www.aldiwan.net/poem40869.html","عموديه"],[139,"ماذا ترى فيمن أتى يستنجد","https://www.aldiwan.net/poem49136.html","الكامل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[201,"حب تغلغل في الصميم","https://www.aldiwan.net/poem39893.html","مجزوء الكامل"],[242,"ألا إن السيادات","https://www.aldiwan.net/poem18093.html","الهزج"],[243,"لن نفترق","https://www.aldiwan.net/poem24809.html","عموديه"],[280,"أوائل فتح ما لهن أواخر","https://www.aldiwan.net/poem25552.html","الطويل"],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[333,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[358,"بقدر النهى بين الورى يشرف القدر","https://www.aldiwan.net/poem40345.html","الطويل"],[358,"هناء وإسعاد وعز مؤبد","https://www.aldiwan.net/poem40402.html","الطويل"],[358,"مطالع سعد قد تجلت كواكبه","https://www.aldiwan.net/poem40814.html","الطويل"],[369,"قربا لي يا صاحبي بعيدا","https://www.aldiwan.net/poem60938.html","الخفيف"],[382,"قفا نبك نفسا طال منها بسورها","https://www.aldiwan.net/poem59433.html","الطويل"],[463,"أخوي والعشاق إخوه","https://www.aldiwan.net/poem55820.html","مجزوء الكامل"],[469,"ألمت نع الظلماء يهدى سلامها","https://www.aldiwan.net/poem3195.html","عموديه"],[469,"أرى الغيث في الآفاق خرقاء كفه","https://www.aldiwan.net/poem3347.html","عموديه"],[469,"أما وابتسام البرق في عابس الدجن","https://www.aldiwan.net/poem3514.html","عموديه"],[498,"وقوراء كالفلك المستدير","https://www.aldiwan.net/poem67424.html","المتقارب"],[520,"ولاؤك دين في الرقاب ودين","https://www.aldiwan.net/poem12276.html","الطويل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137586",""],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62588","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64829","المتقارب"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136325","الكامل"],[1296,"","https://poetry.dctabudhabi.ae/diwan/poem/178089","الكامل"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31589","المجتث"],[1416,"","https://poetry.dctabudhabi.ae/diwan/poem/199187","البسيط"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125453","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125482","الرمل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28525","المتقارب"],[2380,"","https://poetry.dctabudhabi.ae/diwan/poem/29480","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106864","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83226","الكامل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205435","الكامل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109798","الوافر"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87362","السريع"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91546","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117897","الطويل"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103544","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111505","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111448","الوافر"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78194","الكامل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93310","الوافر"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104904","السريع"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102012","الطويل"],[4640,"","https://poetry.dctabudhabi.ae/diwan/poem/142831","الكامل"],[4831,"الطبيعة والجمال","https://www.poetsgate.com/ViewPoem.aspx?id=208020",""],[4832,"حيث الهزار شدا وغرد","https://www.poetsgate.com/ViewPoem.aspx?id=166698",""],[4859,"ريح الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=186716",""],[4984,"الْجَزَاءُ - جدارية 07 -","https://www.poetsgate.com/ViewPoem.aspx?id=187272",""],[5081,"حُبٌّ عَنِيدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=185579",""],[5397,"هلال دجى وشمس ضحى وفرقد","https://www.poetsgate.com/ViewPoem.aspx?id=157966",""],[5401,"الشيطنه والشقاوه","https://www.poetsgate.com/ViewPoem.aspx?id=85139",""],[5431,"احتواء","https://www.poetsgate.com/ViewPoem.aspx?id=185243",""],[5431,"ماروته شهرذاد...","https://www.poetsgate.com/ViewPoem.aspx?id=202447",""],[5431,"واعتصموا بحبل الله ...","https://www.poetsgate.com/ViewPoem.aspx?id=206863",""],[5463,"سلوى عنوان المودّه","https://www.poetsgate.com/ViewPoem.aspx?id=30881",""],[5491,"قلبٌ تعلّقَ بالهوى","https://www.poetsgate.com/ViewPoem.aspx?id=196673",""],[5545,"ذَنبٌ يُفترى","https://www.poetsgate.com/ViewPoem.aspx?id=185000",""],[5717,"حبتك طالعة بحسن المطلع","https://www.poetsgate.com/ViewPoem.aspx?id=170588",""],[5732,"ياغزال الريم ياظبي الفلا","https://www.poetsgate.com/ViewPoem.aspx?id=177889",""],[5943,"ياصحبة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=34332",""],[6068,"لرضا الأحبَّة شاغل ومعدد -18-","https://www.poetsgate.com/ViewPoem.aspx?id=175859",""],[6068,"أستودع الرحمن حبا طاهرا -03-","https://www.poetsgate.com/ViewPoem.aspx?id=175927",""],[6093,"أذكي الغرامَ بموْعدٍ وتلاقِ ( الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=176202",""],[6202,"هوى وشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86757&r=&rc=58",""]],"verses":[["حبَتْها دمَشْقُ الشّامِ كلَّ زُجاجَة","أرَقّ منَ الشّكْوى وأصْفى منَ الوُدِّ",0,"د",1,0],["حُبَّتْ مَلامِحُهُ بِمَسْحَةِ أُدْمَةٍ","هِيَ مِنْ مِنَا إِنْ شِئْتَ أَوْ عَدْنَانِ",1,"ن",1,0],["حَبَتكَ بِأَعلاقِ المَكارِمِ وَالعُلى","خِصالُ المَعالي قَضُّها وَقَضيضُها",2,"ض",3,0],["حبتني بها دون العبيد خلافةٌ","على الله في يوم الجزاء جزاؤها",3,"ا",3,0],["حَبتْك الأوائلُ من وائلٍ","بمجدٍ قديمٍ لهم ماكثِ",4,"ث",1,0],["حَبَتْكَ بالنَّرجِسِ أيامُه","والراحِ فاشرب غيرَ تصريدِ",5,"د",1,0],["حَبَتْكَ برَيحانِ الكلامِ وإنما","تَجودُ بريَّاهُ لكلِّ جَوادِ",6,"د",1,0],["حُبٌّ تُجِدُّ الحادِثاتُ عُهودَهُ","وَتزيدُ في حُرُماتِهِ الأَيّامُ",7,"م",1,0],["حَبَتهُ الطبيعةُ أسرارَها","ولاقى الحقيقةَ فيهِ الخيالْ",8,"ل",1,0],["حَبَتهُ الألوهةُ روحاً يَرَى","وينطِقُ عنها بوحي السماء",8,"ا",2,0],["حَبَتْها مُلوكُ الفُرْسِ نَصْراً وقوْمَه","ونالَتْ بها العَلياءُ لَخْمٌ وفارِس",9,"س",1,0],["حبت كلّ ذي روح كريم عطائها","فلم تنس آراما ولم تنس أذؤبا",10,"ب",2,0],["حبته من المفاخر ثوب عز","بحال الغيب زين الانتساق",11,"ق",1,0],["حبِّ تَقسمهُ الغرامُ فجسمُه","دنف وأمّا طرفهُ فمنهد",12,"د",1,0],["حَبَت لِمُحبّيها المكارمَ كلّها","بِكلّ اِرتياحٍ وهيَ تُبدي لهُم شكرا",13,"ر",2,0],["حبّ تغلغل في الصميم","فقضى على الحب القديم",14,"م",1,1],["حَبَتْهُ الشَّرْحَ وَالإِيضَا","حَ إِيضَاحَ الُخَفِيَّاتِ",15,"ت",1,0],["حب ترقرق في الوعود سنا","منه ورف على الخطى عبق",16,"ق",1,0],["حَبَتْ وَسْمَها دُونَ الأئِمة واسمَها","إمَاماً إذا سَمّتْهُ تُزْهَى المَنابِرُ",17,"ر",1,0],["حبتك نسيجاً عبقريّاً طرازه","حلاك ولولاها تقاصر أن يجبى",18,"ب",2,0],["حبَته المقادير ملك الثرى","وألقت إليه أمور العباد",19,"د",1,0],["حَبَتنا بِدَفتردارِها غاية المُنى","فَلا دَفتَر يحصي ثَناها وَلا سفرُ",20,"ر",1,0],["حبتك بِنيشان المَعالي فَلَم يَزَل","عَلامة مجدٍ بِالصَداقةِ تَشهدُ",21,"د",1,0],["حبت غَيرَهُ مِمّا حَبَت ذاتهُ بِهِ","وَبِالضدّ يَمتازُ العلا وَمَراتبُه",22,"ب",2,0],["حُبُّ تلك الخدودِ عَفَّرَ منّا","حين ساروا وسْطَ الطُّلولِ الخُدودا",23,"د",2,0],["حبتني أياديها الأياديَ جمَّةً","وتلك أيادٍ ليس يخفى عبيرها",24,"ر",3,0],["حبٌّ تناصفناه نك","رَعُ حُسوةً فيه وحُسوَهْ",25,"و",2,0],["حبتني بأمثال الرياض بنانهُ","وما الروض إلاّ ما يحوك غمامها",26,"م",3,0],["حبتها بأمثال العقود بنانهُ","فمن بين منظومِ وبين مبدَّد",27,"د",1,0],["حبتني جزافاً بالنضار بنابهُ","وما شأنَ نعماهُ بعدٍّ ولا وزن",28,"ن",1,0],["حَبَتها البِحارُ بِأَموجِها","وَسُحُبُ السَماءِ بِأَنوائِها",29,"ا",3,0],["حبتك الليالي بيعة عاضدية","لك الله فيها عاضد ومعين",30,"ن",1,0],["حبتها الطبيعة أبهى جمال","عجيب به مثل الحسن سارا",31,"ر",2,0],["حبت السعد كل آتٍ إليهَا","داخلاً في أبوابها اليَمنّيهْ",32,"ي",2,0],["حَبَتْهُ نُجومُ سُعودِ السَّما","بِما زيَّنَ الأَرْضَ مِنْ فَرْشِها",33,"ش",3,0],["حب تمكن في الحشا فلناره","بين الاضالع والجنوب ضرام",34,"م",1,0],["حبٌ تمَّكن في الأحشاء يكوينا","حبٌ يصارع شوقاً في تلاقينا",35,"ن",2,0],["حَبَتْ فعالاً وأَمْسَتْ","تُحَل ليناً وتُعْقَدْ",36,"د",1,0],["حبتها أفاعي الرمل بطنا وأنعمت","عليها جياد الخيل بالرأس والفم",37,"م",1,0],["حبٌّ تحوَّل بغضا","لا تعجبي فانقلابي",38,"ي",1,0],["حُبٌّ تَرَبَّى في دمي فسرى به","حتى تملَّكَ مُهجتي وقيادي",39,"د",2,0],["حبتك المواهبُ أسرارَها","ومنكَ تقرَّبَ أهلُ الأدَب",40,"ب",1,0],["حَبَتكَ السَّماء بِأَمطارِها","وَكَيفَ تَضِنُّ عَلَى جارِها",41,"ر",3,1],["حَبَت دونَهُم بَكرٌ فَلَم نَستَطِعهُم","كَأَنَّهُمُ بِالمَشرَفِيَّةِ سامِرُ",42,"ر",1,0],["حبتك المنى أسرارَها وتواطأَت","لخدمتك الأيامُ وانقطع الغدر",43,"ر",1,0],["حُبٌّ تَجَسَّدَ بِالفُؤادِ وَفُصِّلَت","في الجيدِ مِنهُ قَلائِدٌ وَوِسامُ",44,"م",1,0],["حب تضرم في حنايا أضلعي","فأصابه يأسٌ بطول قرار",45,"ر",1,0],["حبته مع الضيا حراً فاعطى","ضياءَ نعم ما ادى الخؤون",46,"ن",1,0],["حبٌّ تصافَينا عليهِ لِما","أَنّا عرفنا نفسنا باختبار",47,"ر",1,0],["حبٌّ تغيّرت اللَيالي وَانطوَت","جُددُ السنين بعزّةٍ وَهَوان",48,"ن",1,0],["حبته المعالي أن يكون لها أباً","وبعلاً ففازت من مساعيه بالنجح",49,"ح",1,0],["حبتك العلا حقاً بمثنى رياسة","بها اعترفت ساداتها ومسودها",50,"د",3,0],["حبته غادةً بنو الآخاء","جزاء حسن الذود والإبلاء",51,"ا",2,0],["حَبَت فالاسُ ذاكَ اليَومَ عَزماً","وَبَأساً لاِبنِ تِيذِيُسٍ مَنِيعا",52,"ع",2,1],["حُب تَمكن في الفُؤاد وَقَد بَدَت","آثاه في سائِرِ الأَعضاء",53,"ا",2,0],["حَبَتْه سُنّةُ الإِسلام طُهراً","تكفَّل غَيْرَةَ الماءِ الزُّلال",54,"ل",1,0],["حبتك من مرشفها خمرة","ما دنستها الكف بالعصر",55,"ر",1,0],["حبتني من بين المحبين بينها","وحين رأت نفسي تكابد حسنها",56,"ه",2,0],["حُبٌّ تمكن في الفؤاد فلا أرى","حتى المَعاد لدائِه مِن شافِ",57,"ف",1,0],["حَبَتْهُ الطّبيعَةُ سِرّاً بِها","فجاءَ شبَِيهاً بزيْدٍ وزينِ",58,"ن",1,0],["حب تقادم عهده","لولا الشواهد كان يجحد",59,"د",1,0],["حب تناثر بالجفاءِ مضت به","ريحُ الحقيقةِ فاستحالَ هباءَ",60,"ا",2,0],["حَبَتْهُ مَدِينَةُ \"آفْلُو\" الذِي","تَمَنَّى حَدِيثاً وَمِنْ أَوَّلِ",61,"ل",1,0],["حُبٌّ تَمَلَّكَ ذَا الفُؤَادَ أَذَابَنِى","وَأَذَابَ مَنْ أَحْبَبْتُهُ فَأَحَبَّنِى",62,"ن",2,1],["حبتك سيادة في الدهر عظمى","ونلت بقربها شرفا وسؤدد",63,"د",1,0],["حبّتك هذي حشا ماأظن تقصدني","ارسلتها للحبيب وطف لمباتك",64,"ك",1,0],["حب تأجج في عميق صبابتي","وضرام نارك في الهوى تُحييني",65,"ن",2,0],["حبٌ تنهنه نازفا","بين التوّله والبُطاح",66,"ح",1,0],["( حبٌ تمزّق وانتهى","ليلا وفي الإشراق لاح !",66,"ح",1,0],["حبٌ تفتّلَ لم نحسن درايته","ولا اعتصامَ بذات الحب إنْ فُتلا",67,"ل",2,0],["{ حُبْ } توّه طفل يكبر .. / مابه أي شيّ ٍ يهدّه","{ حُبْ } باقي لو تجير أيامي وتصبح صعيبه",68,"ب",2,0],["حبٌّ تألَّقَ بالهوى متوسِّدا","أحلامَهُ في ظلِّها يَتَلَهَّفُ",69,"ف",1,0],["حُبٌ تنامى في رياض حشاشتي","فاخضوضرت روحي وحرفي أشرقا",70,"ق",2,0],["حبتك طالعة بحسن المطلع","ومن اللطافة خلتهاه لم تطلع",71,"ع",1,1],["حبتك تغني عن الما والكلا","من رحبق شفاك جرعتني مدام",72,"م",1,0],["حُبٌّ تألَّقَ لمْ تُطْفَأْ كواكبُهُ","وقدْ شَبَبنا بذاكَ الحُبِّ فرسَانَا",73,"ن",2,0],["7-حب تحوطه المروءة والحجا","حبّ يُرَجِّعه الصدى ويردد",74,"د",1,0],["حب تضوع مسكه فكأنني","ألقاه حتى لو رحلت مسافرا",75,"ر",2,0],["حبٌّ تَجَذَّرَ في الفؤادِ لطفلةٍ","تنمو وينمو الشوقُ في خفاقي",76,"ق",2,0],["حب تعيش حياله","دنيا الأماني والغِيَر",77,"ر",1,0]]}