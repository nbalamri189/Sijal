{"poems":[[88,"يرزت تميس كخطرة النشوان","https://www.aldiwan.net/poem44446.html","الكامل"],[48,"يا من رآني في الكرى زعما","https://www.aldiwan.net/poem66263.html","أحذ الكامل"],[107,"بان الخليط ضحى من الجرعاء","https://www.aldiwan.net/poem16224.html","الكامل"],[107,"قد زارني وكأنه ريحانة","https://www.aldiwan.net/poem16318.html","الكامل"],[462,"في القلب منزلة الغزال الشامس","https://www.aldiwan.net/poem3577.html","عموديه"]],"verses":[["فهصرت أغصان الأمان ولم يكن","غير السرور بهنّ قطف دان",0,"ن",1,0],["فهصرتهُ والبُهرُ كان بهِ","حتى إذا سكنتُ من بُهرِه",1,"ر",2,0],["فَهصرت غُصن مَعارف وَمَحاسن","وَجَنيت نور مَحامد وَثَناءِ",2,"ا",2,0],["فَهَصرتُهُ هَصر النَسيم أَراكَةً","مُتَلَطِفاً حَتّى كَأَن لَم يَشعُرِ",3,"ر",1,0],["فهصرتُ غصن القدِّ غيرَ مراقبٍ","ولثمتُ ورد الخدِّ غير مخالس",4,"س",1,0]]}