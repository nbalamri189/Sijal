{"poems":[[90,"يرزت تميس كخطرة النشوان","https://www.aldiwan.net/poem44446.html","الكامل"],[50,"يا من رآني في الكرى زعما","https://www.aldiwan.net/poem66263.html","أحذ الكامل"],[113,"بان الخليط ضحى من الجرعاء","https://www.aldiwan.net/poem16224.html","الكامل"],[113,"قد زارني وكأنه ريحانة","https://www.aldiwan.net/poem16318.html","الكامل"],[469,"في القلب منزلة الغزال الشامس","https://www.aldiwan.net/poem3577.html","عموديه"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120046","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49973","الكامل"],[4578,"خطرت لأعطاف المحاسن ثانية","https://www.poetsgate.com/ViewPoem.aspx?id=49618",""],[6068,"إن الغرام غرابة -05-","https://www.poetsgate.com/ViewPoem.aspx?id=175910",""]],"verses":[["فهصرت أغصان الأمان ولم يكن","غير السرور بهنّ قطف دان",0,"ن",1,0],["فهصرتهُ والبُهرُ كان بهِ","حتى إذا سكنتُ من بُهرِه",1,"ر",2,0],["فَهصرت غُصن مَعارف وَمَحاسن","وَجَنيت نور مَحامد وَثَناءِ",2,"ا",2,0],["فَهَصرتُهُ هَصر النَسيم أَراكَةً","مُتَلَطِفاً حَتّى كَأَن لَم يَشعُرِ",3,"ر",1,0],["فهصرتُ غصن القدِّ غيرَ مراقبٍ","ولثمتُ ورد الخدِّ غير مخالس",4,"س",1,0],["فهصرت شمس ضحى وخوط أراكةٍ","وهلال داجية وظبي صريمِ",5,"م",1,0],["فهصرت غصنا أو عصرت سلافةً","من ظلمَ أشنبَ في نبات منوّرِ",6,"ر",1,0],["فهصرت أعطافاً يؤكد عطفها","شوقي على أهل المحبة جانية",7,"ي",2,0],["فهصرتها فتمايلت","في ثغرها قبّلْتها",8,"ت",3,0]]}