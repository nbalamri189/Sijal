id=157965",""],[5397,"بكيت شجواً على الأطلال والدمن","https://www.poetsgate.com/ViewPoem.aspx?id=157909",""],[5403,"حيتك يا مرقداً وأرى هلال هدى","https://www.poetsgate.com/ViewPoem.aspx?id=187606",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5582,"لَمْ أَسْتَمِعْ يا هِنْدُ نَوْحَ حَمامِ","https://www.poetsgate.com/ViewPoem.aspx?id=187299",""],[5705,"إنَّكِ عَيْنٌ حَذِلَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=4537",""],[5803,"لو لا العراق لما ترنم خافقي","https://www.poetsgate.com/ViewPoem.aspx?id=101216",""],[5888,"رؤيا وواقع مرير","https://www.poetsgate.com/ViewPoem.aspx?id=214508",""],[6084,"حيت تزف سلافة الصهباء","https://www.poetsgate.com/ViewPoem.aspx?id=170811",""],[520,"في مثل مدحك شرح القول مختصر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577521",""]],"verses":[["حَيَّتكَ بَل حَيَّت طُلولَكَ ديمَةٌ","يَشفي سَقيمَ الرَبعِ نَفثُ عِهادِها",0,"د",3,0],["حَيَّ تِلِمْسَانَ الْحَيَا فَرُبُوعُهَا","صَدَفٌ يَجُودُ بِدُرِّهِ الْمَكْنُونِ",1,"ن",1,1],["حَيَّتكَ عَزَّةُ بَعدَ الهَجرِ وَاِنصَرَفَت","فَحَيِّ وَيَحَكَ مَن حَيّاكَ يا جَمَلُ",2,"ل",1,1],["حَيَّتْكَ مِصْرُ فَحَيَّتِ الأمَلَ الَّذِي","عَنْ نُورِهِ تَتَفَتَّحُ الأَكْمَامُ",3,"م",1,0],["حَيَّت صباحاً فَأحْيَتْ ساكني القَصَبَهْ","واسترجعَت أنفساً بالسوقِ مُغتَصبَهْ",4,"ب",2,1],["حيت سفرتي من نداك المديد","وخيل البريد منى المستزيد",5,"د",1,1],["حيّت حمى حلب أنفاس غادية","مشّاءةٍ بنميم الروض غماز",6,"ز",1,1],["حيَّتك قاضي القضاة من مدحٍ","نجوم حمدٍ سعيدة الطالع",7,"ع",1,0],["حيتك غادية الحيا يا دار من","أهوى وحوّامٌ عليك المرزم",8,"م",1,1],["حَيَّتْكَ عنّي السُّعودُ والفَلكُ","واللَّهُ والصالحون والمَلَكُ",9,"ك",1,1],["حَيَّتك عنَّا شمالٌ طاف طائفُها","بجنة فَجَّرَتْ رَوحاً ورَيْحانا",10,"ن",2,1],["حيَّتك عنا شمْأَلٌ سهْوةٌ","تسري إذا ما عرَّس الساري",11,"ر",2,0],["حيتك واكفة الحيا","تهمي فتنسكب انسكابا",12,"ب",2,0],["حيته عاصمة الرشيد فشيبها","وشبابها للعبقرية تهتف",13,"ف",1,0],["حيته بالنغم الهواتفُ في الضحى","وترنمت بثنائه الأوتار",14,"ر",1,0],["حيت محياك الكريم شبيبة","مما غرست كريمة زهراء",15,"ا",2,0],["حُيِّتِ بَل سُقّيتِ مِن مَعحودَةٍ","عَهدي غَدَت مَهجورَةً ماتُعهَدُ",16,"د",1,0],["حَيَّت بِآسٍ إِثرَ كاسٍ تُديرُها","فَقَبَّلتُ جيداً مِنهُما وَعِذارا",17,"ر",2,0],["حيَّتْكَ مِصرُ مشوقةً وتلفَّتتْ","لِتَرى جَلالَ شَهيدِها في المصرعِ",18,"ع",1,0],["حيَّتكمُ الرُّسُلُ الكِرامُ وجَاءَكم","وَفدُ الملائكِ يَحملُ الأقمارا",19,"ر",2,0],["حَيَّت وُفودُ النيلِ مِنكَ مُوَقَّراً","يُزري بِأُبَّهَةِ المُلوكِ جَليلا",20,"ل",2,0],["حيّت جُموعَ الغانيا","ت عُيونُ نَرجسك النَواعس",21,"س",1,0],["حَيّتُ لَمّا بَدا لي","وَمِتُّ حينَ تَكَلَّم",22,"م",1,0],["حَيٌّ تَنَوَّعَ مِن نامٍ وَمِن جَمَدٍ","فَالنَبتُ وَالوَحشُ وَالإِنسِيُّ نامونا",23,"ن",2,0],["حَيَّتكَ مِصرُ عَلى البِعادِ فَحَيِّها","وَدَعَت مُسَلِّمَةً عَلَيكَ فَسَلِّمِ",24,"م",1,0],["حَيَّتكَ في المَلَأِ العَلِيِّ وَأَزلَفَت","حورُ الجِنانِ إِلَيكَ شَعرَ مُحَرَّمِ",24,"م",1,0],["حَيَّتْكَ في الشرق آمالٌ وأحلامُ","وقبّلتكَ جراحاتٌ وآلامُ",25,"م",1,1],["حَيَّتِ الكَوْنَ حِيْنَ لاَحَتْ فَأَحْيَتْ","كُلَّ عَوْدٍ لَهَا جَدِيدُ نُشُورِ",26,"ر",1,0],["حَيتْ مُمَثِّلَهُ وَأَعْ","لَتْ فِي مَهَاجِرِهَا بُنُودَهْ",27,"د",2,0],["حيّتك عني وجوهُ لو هي احتجبت","دل الشذا أنها بعض الرياحين",28,"ن",1,1],["حَيَّتكَ ولدانَها وَقالَت","بُشراكَ روحٌ بِها وَراحُ",29,"ح",1,0],["حيَّتْ طلائِعَكَ القوافِي هُتّفاً","وشَدَتْ لمَقْدَمِكَ الكريمِ الأَشكُر",30,"ر",1,0],["حيَّتْك جامعةٌ وضعتَ أساسها","ومنَحتها اسمَك زينةَ الأسماء",31,"ا",2,0],["حَيتهُ أَرواح الرضى مِن رَبِهِ","وَهمى عَلَيهِ مِن الهبات غَمام",32,"م",1,0],["حيت بغلغلة الكرى انواره","فبيقظتي خلت الضياء امامي",33,"م",2,0],["حيَّتْ فأحيت مهجةَ المشتاقِ","مِن بعد ما أورى من الأشواقِ",34,"ق",1,1],["حيتك السنة الحيا من دار","وكستك حلتها يد الأزهار",35,"ر",1,1],["حيت جنابك نفحة قدسية","في كل يوم أين حلت عطرت",36,"ت",1,0],["حَيّتْ أبَا يَحيى الأمِيرَ وإنّما","حَيّتْ بِه الأنْسامَ والأَرواحا",37,"ح",2,0],["حيتّكِ يا شبهَ الجزيرة مزنةٌ","تدع المفاوزَ والملاع قراحا",38,"ح",2,0],["حيتّك باسمةً ثغورُ الزنبقِ","مُفَْتَرَّةً عن طيِّبٍ متألَقِ",39,"ق",1,1],["حيّته من عَذَباتِ البانِ ألويةٌ","وَمن هواتِفها ترجيعُ صدّاح",40,"ح",1,0],["حي تلك المجامع","حي تلك الوفود",41,"د",1,0],["حيٌّ تجرّد عَن علاقةِ جسمهِ","كتجرّد الحيّات سلخاً تنزعُ",42,"ع",1,0],["حيت الكرام ينوب عن نار القرى","عرف الكباء بحيهم والمندل",43,"ل",1,0],["حيتك من وادي الجرا","ح نسائم فيها سعار",44,"ر",1,0],["حيّتْكَ من بُعْدٍ وقُرْبٍ معاً","شاقا فؤادي واسْتَحثّاه",45,"ا",2,0],["حَيّتْكَ غاديةُ الحَيا من مَرْبَع","رجَعتْ عهودي فيك أم لم تَرجِعِ",46,"ع",1,1],["حَيتك عَني نَسمة مَكية","وَسَقى دِيارك عارض يَتَدَفَقُ",47,"ق",1,0],["حَيتك أَنفاس النَسيم","عَن المُحب المُستَهام",48,"م",1,0],["حيتك يا وفد البيان خواطر","نشوى تطوف حول ركبك حوما",49,"م",2,0],["حيتك ذات خصائص لا تنكر","عصماء تعبث بالعقول وتسحر",50,"ر",1,1],["حيت الأمير بما","يبتغيه مطلبا",51,"ب",2,0],["حيتك تونس فلتقبل تحيتها","عن روض شعري بباقات من الأدب",52,"ب",1,0],["حَيَّتْكَ في العُمْقِ من أصلابِنا نُطَفٌ","جذلَى تَرَنَّحَ فيها الماءُ والعَلَقُ",53,"ق",1,0],["حَيَّت مُحَيّاهُ المَواسِمُ وَالتَقَت","مِنهُ العُيونُ عَلى أَغَرَّ وَسيمِ",54,"م",1,0],["حيتك عاصمة بصدر مفعم","حباً وقلب بالولا ملآن",55,"ن",1,0],["حيتك قاهرة البلاد وقبلت","منك الانامل للدعا تتلمس",56,"س",1,0],["حَيَّتْكَ ريحُ الصَّبا يا مَعدِن الظَّرَف","ويا محلَّ العُلى والمَجْدِ والشَّرفِ",57,"ف",1,1],["حَيَّتْكَ بِكْرٌ من بَنا","تِ الروْضِ أعْجَلَها ابْتِكارُ",58,"ر",1,1],["حيتك ألوية السلام منيفة","وسقتك طهر روائح وغوادي",59,"د",2,0],["حيَّتكَ دجلةُ لمْ تسمعْ تحيتَها","رذاذُها أنتَ تدري بللَ الكبدا",60,"د",2,0],["حَيَّتكَ بِالرامِشن رامِشنَةٌ","أَحسَنُ مِن رامِشنَةِ الآسِ",61,"س",1,1],["حيّت غيوث مراحم المولى ثرى","فيهِ توسّد جسمك المدفونُ",62,"ن",1,0],["حَيَّتْ بِآنفِ وَجْنةٍ","بالَّلحظِ نقطُفُ وَرْدَهَا",63,"د",3,0],["حَيَّتْ بِلَوْنٍ واحدٍ مِنْ زَهْرِهَا","لكنَّها وَعَدَتْ بأَلونٍ أُخَرْ",64,"ر",1,0],["حَيَّتْ فأَطْمَعَني فيها وأَيْأسَني","مِنْها التَّبَسُّمُ مَقْطوباً بِتَقْطِيبِ",65,"ب",1,0],["حيت الوفد بالهدير ونادت","حي أهلا بالبائس المسكين",66,"ن",1,0],["حيّتْك يا زايد بخير التحيّات","واهدتْك من فيض المشاعر ثَناها",67,"ا",3,0],["حيتك آثار النبي محمد","وغدت تهلل باسمه وتكبر",68,"ر",1,0],["حَيّتكَ نَفسٌ صَبّةٌ بِتَحيّةٍ","وَرَدَت عَلَيكَ نَفيسَةَ الأَنفاسِ",69,"س",1,0],["حيَّتكِ يا دار الهوى بالأبرقِ","وطفاء من نوء السِّماك المغدقِ",70,"ق",1,1],["حَيَّتكَ ضاحِكَةً بُنَيَّةُ أَيكَةٍ","تَهفُو تَحِيَّتُها بِعِطفِ النادِي",71,"د",2,1],["حيَّتك من نَور الثُريَّا حُفَّلٌ","حلبت عليك يدُ الصبا أخلافَها",72,"ف",3,0],["حيتْكَ بكرُ النظم غدوه","تجلو الثنا شغفاً وصبوه",73,"و",2,1],["حيتكُمُ بدويَّةٌ","هي عن سواكم ذاتُ نبوه",73,"و",2,0],["حيَّتك من وَجَناتها بشقيقها","وجلت عليكَ مُدامةً من رِيقها",74,"ق",3,1],["حيّ تحتَ الدجى مُحيًّا أنارا","فأحالَ الليلَ البهيمَ نهارا",75,"ر",2,1],["حيتكَ سارقةُ اللحاظ من الظِبا","تجلو المدامَ فحيّ ناعمةَ الصِبا",76,"ب",2,1],["حيَّتك تنهمِلُ انهمالا","وطفاءُ مُرخيَةُ العُزالى",77,"ل",2,1],["حيّت أغرّ كأن طلع","ةَ وجهه قمرٌ منيرُ",78,"ر",1,0],["حيَّت ثراكِ فلاطفتهُ سحابةٌ","من كوثرِ الفردوسِ تَحمل ماءها",79,"ا",3,0],["حيَّتك تبدي جميلَ العذر","فحيّ منها أَلوفَ الخدر",80,"ر",1,0],["حيّتهُ أقطار السما","والأرض وابتسمت ثغورا",81,"ر",2,0],["حيت فأحيتك ابنة الإسكافي","بالسين ملحقةً عقيب الكاف",82,"ف",1,1],["حيتك يا دار من لبنان عاطرةٌ","أرزية صدرت عن قلب ولهالن",83,"ن",1,0],["حيتك يا انطونُ اطهرُ نفحة","أرزية يسري بها نفس الصبا",84,"ب",2,0],["حيٌّ تنزه أن يباح حريمه","فكأنَّ حاميه المبارز سَنْقَر",85,"ر",1,0],["حَيٌّ تَناسَبَ في العُلا فَأُصولُهُ","أَغصانُهُ وَالوالِدُ المَولودُ",86,"د",1,0],["حيت ضريحا به سبط الرضاء ثوى","وطفاء سحب الرضا سحابها مرها",87,"ر",3,0],["حيَّته وَهيَ لَهُ بِالإِرث وَهوَ لَها","لا تَبتَغي بَدَلاً عَنهُ وَلا حِولا",88,"ل",2,0],["حَيت رباك ديمة تَراكَمَت","تَكاد تَنتاش الرُبى طباقها",89,"ق",3,0],["حَيتك باسمة فردَّ تَحية","مِن غادة بِكَ حارَبت نصاحها",90,"ح",3,0],["حيت بملتف الأراك دارها","وطفاء بشر صوبت أمطارها",91,"ر",3,1],["حَيَّتكِ مِن صَيداءَ قَلعتها","فَتَشوَّفت وَبجيدها تَلَع",92,"ع",1,0],["حيتك يوغوسلافيا وتكاد من","شغف تطير اليك منها الاضلع",93,"ع",1,0],["حيت بها بيض الصبا فكأنما","حيتّ من البيض الظباء ترائبا",94,"ب",2