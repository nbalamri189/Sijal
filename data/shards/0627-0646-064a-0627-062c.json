{"poems":[[57,"إني أجل ظلوما أن يكون لها","https://www.aldiwan.net/poem26080.html","البسيط"],[56,"إني أجالس معشرا","https://www.aldiwan.net/poem27383.html","مجزوء الكامل"],[49,"أوصيك بالحزن لا أوصيك بالجلد","https://www.aldiwan.net/poem25330.html","البسيط"],[53,"قل للمسمى بما تكنى الكلاب به","https://www.aldiwan.net/poem65713.html","البسيط"],[93,"سكت خوفا وقلت الصفح من خلقي","https://www.aldiwan.net/poem62725.html","عموديه"],[87,"رمضان ولى هاتها يا ساقي","https://www.aldiwan.net/poem63705.html","الكامل"],[60,"ما غاض دمعي عند نازلة","https://www.aldiwan.net/poem31191.html","أحذ الكامل"],[60,"ما غاض دمعي عند نازلة","https://www.poetsgate.com/ViewPoem.aspx?id=11531",""],[139,"غيري إذا أغبر وجه الدهر يحذره","https://www.aldiwan.net/poem49094.html","البسيط"],[273,"أشمال ويحك بلغي تسليمي","https://www.aldiwan.net/poem69117.html","عموديه"],[275,"أدمشق أين بنو أمية قولي","https://www.aldiwan.net/poem35651.html","الكامل"],[341,"بنيت طاعتي باتباع","https://www.aldiwan.net/poem67803.html","عموديه"],[347,"بنت الدلال اما كفاك دلالا","https://www.aldiwan.net/poem55333.html","الكامل"],[482,"ألم الفراق نفى الرقاد ونفرا","https://www.aldiwan.net/poem15259.html","الكامل"],[505,"ما الفخر إلا للذين تواضعوا","https://www.aldiwan.net/poem38013.html","الكامل"],[532,"وإذا ابتدهت بديهة يا سيدي","https://www.aldiwan.net/poem46006.html","الكامل"],[1247,"","https://poetry.dctabudhabi.ae/diwan/poem/178057",""],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66279","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53175","الكامل"],[208,"","https://poetry.dctabudhabi.ae/diwan/poem/34116","الكامل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104679","البسيط"],[124,"","https://poetry.dctabudhabi.ae/diwan/poem/110536","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87439","المجتث"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88989","البسيط"],[3523,"","https://poetry.dctabudhabi.ae/diwan/poem/131356","الكامل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86282","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109994","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91098","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91088","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94624","البسيط"],[4545,"","https://poetry.dctabudhabi.ae/diwan/poem/216344",""],[5431,"نفخت طينك نفخ الحب والقبل","https://www.poetsgate.com/ViewPoem.aspx?id=191357",""],[5674,"قلبك معبدي","https://www.poetsgate.com/ViewPoem.aspx?id=197554",""],[5956,"لمّا أصاحب نُخبةً من موطني","https://www.poetsgate.com/ViewPoem.aspx?id=192651",""],[6264,"الذكرى العطره","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79131&r=&rc=39",""],[6266,"الحب والسور العالي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82752&r=&rc=0",""]],"verses":[["إِنّي أُجِلُّ ظَلوماً أَن يَكونَ لَها","بَينَ الجَواري إِذا قَوَّمتَها ثَمَنُ",0,"ن",1,1],["إِنّي أُجالِسُ مَعشَراً","نَوكى أَخَفُّهُمُ ثَقيلُ",1,"ل",1,1],["إِنّي أُجِلُّكَ أَن تُكفى بِتَعزِيَةٍ","عَن خَيرِ مُفتَقِدٍ ياخَيرَ مُفتَقِدِ",2,"د",1,0],["أنَّى اجتبيت أبا حفص وصحبته","حتى غدوت تؤاخيه فتصدقه",3,"ق",2,0],["إِنّي أُجِلُّهُمُ عَن أَن يُغَيِّرُهُم","كَلامُ ذي حَسَدٍ أَو قَولُ مُتَّهِمِ",4,"م",1,0],["إِنّي أُجِلُّ عَنِ القِتالِ سَرائِري","إِلّا قِتالَ البُؤسِ وَالإِملاقِ",5,"ق",1,0],["إِنّي أَجِلُّ ثَرىً حَلَلتَ بِهِ","عَن أَن أُرى لِسِواهُ مُكتَئِبا",6,"ب",2,0],["إني أجل ثريَ حللت يهِ","عَنْ أَنْ أُرى لِسِوَاهُ مُكْتَئِبا",7,"ب",2,0],["إني أجلّ لساني عن محاورة","معْ غير عارفٍ مقداري وأكبرهُ",8,"ر",2,0],["إني أجلك أن أقول ظلمتني","والله يعلم أنني مظلوم",9,"م",1,0],["إني أجلُّ وفاءَهم وبلاءَهم","فلهم على الأحرارِ كلُّ جميل",10,"ل",1,0],["إني أجاهد بالعلوم وبالتقى","عبدا خديما والمهيمن شاهد",11,"د",1,0],["اني اجتهدت فنلتُ عطفك منيتي","وتركت باقي العاشقين كسالى",12,"ل",2,0],["اِنّي أُجِلُّ ترابكنَّ بأنْ يُرى","يوماً بغيرِ ملثهِّنَّ مُغرفَرا",13,"ر",2,0],["أنَّى أُجانبُ حُبَّهُمْ وهو الَّذي","أعْدَدْتُهُ زادي لِعُقْبى الدَّارِ",14,"ر",1,0],["إني أجيز على البديهة مثلما","تريانه وإذا نطقت أصدّق",15,"ق",1,0],["إني أجل ثرى حللت به","من أن أرى بسراه مكتئبا",16,"ب",2,1],["إني أُجلُّ علاك أن تغتاظ عن","ذنبٍ وأنت لكل غيظ كاظم",17,"م",1,0],["إني أجيد كما تجود وإنما","غمر الندى فلجودك التفضيل",18,"ل",1,0],["إني أُجلُّك عن توهُّمك الخَنى","وأُجلُّ فاك بأن يفوه بذكرِهِ",19,"ر",2,0],["إني أجزتك من نيابتي برعٍ","نشائدً في ثنا علياك أبديها",20,"ي",3,0],["إني اجتويت مذاق العيش وانتفخت","مساحري منه إن العيش ذيفان",21,"ن",1,0],["إني أُجِلُّكِ عَمّا","يَقول أهل الودادِ",22,"د",1,1],["إني أجلك أن تشمت عدوَّك بي","إن الكريم على خزل المحب أبي",23,"ب",2,0],["إني أجل جبينها عن شبهه","بالصبح والقمرين والنبراس",24,"س",1,0],["انّي أُجلك عَن وَعظ وَتَعزِيَة","فَاِنتَ لا شَكَّ رَب الوَعظ وَالحِكَم",25,"م",1,0],["أَني اجتَنِب اهلَ الشِقاقِ وما أَتَوا","بهِ في انبِثاقِ الروحِ واحسَبهُم صَرعى",26,"ع",2,0],["إِني أَجبتك لَو تَدعو لصالحة","إِلا المحرّم إِني عَنهُ في رَجَب",27,"ب",1,0],["إِني أُجدد وَجدي كُلَّما قَدمت","تِلكَ العُصور وَأَزكى في الحَشا ضرما",28,"م",2,0],["إني أجدت بتشبيهٍ يماثلنا","فيما أتيتُ بإهداء أجاهرهُ",29,"ر",2,0],["إن يا جِوابٍ مِنك أهلاً وسَهلاً","أهلاً عِدَد مَ البيت تِعتَق رِقايبَه",30,"ب",2,0],["إني اجتبيتك للإلهام كوكبة","شمس لها القلب في حلٍ ومرتحلِ",31,"ل",1,0],["إني أجبتُ ندا لقائكِ راغباً","كفّاً مددتُ إلى وصالكِ فامدُدي",32,"د",2,0],["إني اجتمعت بإخوةٍ من دولتي","من أخلصِ الخلصاءِ حباً لا ادّعا",33,"ع",2,1],["أنى أجيل الطرف في صحرائنا","نورٌ جديدٌ .. رائعٌ بسامُ",34,"م",1,0],["إني أجادل مثلهم، فتدرّعي","بالصبر، إن يوماً أردتِ جدالي",35,"ل",2,0]]}