"],[6089,"نهر السعادة","https://www.poetsgate.com/ViewPoem.aspx?id=213038",""],[6089,"شغفُ القصائدِ","https://www.poetsgate.com/ViewPoem.aspx?id=214246",""],[6093,"أذكي الغرامَ بموْعدٍ وتلاقِ ( الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=176202",""],[6124,"يا بهي الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=174963",""],[6152,"استودع الله قلبك","https://www.poetsgate.com/ViewPoem.aspx?id=203393",""],[5190,"أبهَى قصائدِ شِعرِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78287&r=&rc=1",""]],"verses":[["يا بَهجَةَ الدَهرِ حَيّاً وَهُوَ إِن فَنِيَت","حَياتُهُ زينَةُ الآثارِ وَالسِيَرِ",0,"ر",1,0],["يا بَهيجَ الخُلُقِ العَذبِ اِبتَسِم","يا مُهيجَ الأَنِفِ الصَعبِ اِعبِسِ",1,"س",1,0],["يا بهجةَ العليا ونسر صيفها","وملاذ عاديها وغيظ حسودها",2,"د",3,0],["يا بهجة الدهر إن تبدى","هلال شعبان في ربيع",3,"ع",1,0],["يا بَهجَةَ الدُنيا الَّتي","كانَت بِهِ الدُنيا تَحَلَّت",4,"ت",1,1],["يَا بُهْرَةَ الْمُلْكِ الْفَسِيحِ","وَصَخْرَةَ الْمُلْكِ الْوَطِيدِ",5,"د",1,0],["يا بهجة الأيام فينا ويا","زين سرير الملكِ والكرسي",6,"س",2,0],["يابَهجَةَ المَجدِ الَّتي","نَدعو بِطولِ بَقائِها",7,"ا",3,0],["يا بهجة الدنيا وَعصمة أَهلها","من كل خطب عابس متنكر",8,"ر",1,0],["يا بهجة الحسن هل أراك","وهل سبيل إلى لقاك",9,"ك",1,1],["يا بهاءَ الدهْرِ والدِّي","نِ ومجموعَ المعالي",10,"ل",2,1],["يَا بَهجَةَ العَرُوسِ","يَهنيكَ أني فانِ",11,"ن",1,0],["يا بهجة الاوراح والابصار في","اشراق وجهك خيرنا نتفرس",12,"س",1,0],["يا بَهجَةَ الأيّامِ بَل يا مُصلِحَ ال","إسلامِ بَل يا مُفسِدَ الإشراكِ",13,"ك",1,0],["يا بهجة الوادي وراحة أهله","بعد اطِّراد حوادث وعوادي",14,"د",2,0],["يا بهاء الدين المرجى نداه","والذكي الضرب الزكي النجار",15,"ر",1,1],["يا بهجة المختارة العليا التي","قد فاخرت في دار عز تبهرُ",16,"ر",1,1],["يا بهجة المختارة العلي التي","فيك استقر بها الفخار الأكبرُ",17,"ر",1,1],["يا بها الذخر المؤمل يا رسو","ل اللَه ان القصد حوز هداكا",18,"ك",2,0],["يا بهوتَ الخير أحيى ذكرهُ","أو فكونى الدهر قاعاً بلقعاَ",19,"ع",2,0],["يا بهجة العمر ما للعمر بعدك من","عيشٍ ألذ به سرّاً وأعلانا",20,"ن",2,0],["يا بهجَة للناظرينَ سناكمو","يا فوّةً للطالبينَ دواكمو",21,"و",1,1],["يا بَهجَةَ الدُنيا وَزَهرَة أَهلِها","وَسَواد مُقلَةِ عَينِها الحَوراء",22,"ا",2,0],["يا بهجة النفس إذ تجلى مناقبه","وبهجة العين إذ يجلى محياه",23,"ا",2,0],["يا بَهجَةَ الدُنيا وَتاجَ جَلالِها","أَيّامُنا بِكِ أَسعَدُ الأَعيادِ",24,"د",1,1],["يا بهجة الايام يا من قد غدت","اعلامه في كل صقع تخفق",25,"ق",1,0],["يا بَها دُرٍّ سُدتَ إِذ كُنتَ مَولىً","لإِمامٍ أَضاءَ للدينِ بَدرا",26,"ر",2,1],["يا بهائي اتخذ قلباً سواه","فهو ما معبوده إلا هواه",27,"ه",1,0],["يا بهي الحلى تهنا وابشر","بنجيبين عززا بنجيبه",28,"ب",2,1],["يا بهجة الناظرين يا من","بسره يظهر الكمين",29,"ن",1,0],["يا بهجة القلب ما للقلب عنك هوىً","وسلوة النفس لو تسطيع سلوانا",30,"ن",2,1],["يا بهجة القلب وريحانه","وفرحة المحزون أوصافها",31,"ف",3,1],["يا بهجة من بهجة المعالي","ودرة المعصومة المجيده",32,"د",2,0],["يا بَهاءَ العُلا اذا غِبتَ لا غِب","تَ فمنْ للقيادِ والتَّشْميرِ",33,"ر",1,0],["يَا بهاءَ العُلا متى كنتَ للَّوْ","عَةِ خِلاً وللصَّبابةِ خِدنَا",34,"ن",2,0],["يا بَهَاءَ العلا ويا رَحْمَةَ النَّ","سِ ومن وجهُهُ الضيّاءُ المُنِيرُ",35,"ر",1,0],["يا بهاءَ العلا ويا طَلْعَةَ الشم","سِ ضياءً ويا غِيَاثَ العِبَادِ",36,"د",1,0],["يا بهْجةَ الحُسْنِ التي طالَما","دعَوْكِ بالسّحْرِ وحلَّوْكِ",37,"ك",1,0],["يا بهجة الدنيا وقوى روحها","للّه درك من أستاذ وزر",38,"ر",1,0],["يا بهجةَ العيدين كَم فرحتِنا","بُشرى لَكُم وَعدَ الزَمانُ وَقَد وَفى",39,"ف",2,0],["يا بَهجَةَ الأَيّام يا شَمس الوَرى","يا مُفرَدَ العَليا وَأَنتَ السَيِّدُ",40,"د",1,0],["يا بهار الرياض أنت بهارٌ","باهر الأنوار والريحان",41,"ن",1,0],["يا بهجة زَفَّها للرُّوحِ حين شَدَا","أني وَهُوْ تحت عنوانٍ سَنَنْدَرِجْ",42,"ج",1,0],["يا بهيَّ الصمتِ غنِّ للهوى","نبضُ قلبي آبهٌ كي يسمعَكْ",43,"ك",1,0],["يا بهجةَ القلبِ عند الرب يفرحُها","البشْرِ تُؤتى وباليمنى قسائمُها",44,"م",3,0],["يا بهجةَ القلبِ عند الرب يفرحُه","بالبشْرِ تُؤتى وباليمنى قسائمُها",45,"م",3,0],["يا بهجة الحسن الخرافي الذي","روى خريفي الباهت المعطوب ِ",46,"ب",1,0],["يا بهيه وخبرينى ... ع اللى قتل القتيل","قتلوه السود عيونك ... واللا الهَم التقيل",47,"ل",1,0],["يابهجة النفس يا أحلى حكاياتي","يا أنت ملهمتي يا أنت آياتي",48,"ت",2,1],["يابهجة النفس يا أحلى حكاياتي","مَن كنتِ ملهمتي أضحيتِ أياتي",49,"ت",2,1],["يا بهجتي في دنيتي ومسرّتي","يا من سباني نورها البرّاقُ",50,"ق",1,0],["يا بهجة القلب يا جذابة لصقت","تأثيرها في نُهانا كم تواسينا",51,"ن",2,0],["يا بهجة في مهجتي يا ساميا","يحييك ربي دون أي جوائحِ",52,"ح",1,0],["يا بهجة العمر قد طوقت أوردتي","والنفس ُ يا سكني لم تهو َ إلاكا",53,"ك",2,0],["يا بهجةً يستلني بخريرها","من كل جدب نهرها متدفقا",54,"ق",2,0],["يا بهجةَ القلبِ الذي لم يتخذْ","نبضًا سواكَ ولا تعشّقَ آخَرا",55,"ر",2,0],["يا بهجةَ الدُّنيا وأحْسَنَ أهلها","ومُنَى النُّفُوسِ ومُنْتَهى الأشواقِ",56,"ق",1,0],["يا بهيَّ الحرفِ مِلْ لي","مثل نوَّارِ الشموسِ",57,"س",1,1],["يا بهجة الروح إن البعد عذبني","وكم بعيد إذا ناديته يصل",58,"ل",1,0],["يا بهجةَ العُمرِ ، إنَّ العمرَ مُرتَحِلٌ","صَوْبَ النِّهايةِ إنْ تُمسِك غواديكِ",59,"ك",1,0]]}