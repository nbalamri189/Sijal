{"poems":[[55,"ردي يا جيادي وأذني برحيل","https://www.aldiwan.net/poem29903.html","الطويل"],[85,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[90,"إن رمت عيشا ناعما ورقيقا","https://www.aldiwan.net/poem44987.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[139,"مطران ما حققت أمرك","https://www.aldiwan.net/poem49133.html","مجزوء الكامل"],[310,"أم الوزير الشهم إسماعيلا","https://www.aldiwan.net/poem56433.html","الكامل"],[333,"كذبت هند حين قالت لك القل","https://www.aldiwan.net/poem54941.html","الخفيف"],[385,"أترى أراك بلا رقيب","https://www.aldiwan.net/poem49250.html","مجزوء الكامل"],[438,"إليك من ملك سام ومن ملك","https://www.aldiwan.net/poem12357.html","البسيط"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112434","الكامل"],[806,"","https://poetry.dctabudhabi.ae/diwan/poem/110732","الكامل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130628","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65054","الكامل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87835","الكامل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67192","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/61013","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74037","الكامل"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32934","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73168","البسيط"],[5363,"همّتي","https://www.poetsgate.com/ViewPoem.aspx?id=147146",""],[5612,"أدَبُ الفَتَى","https://www.poetsgate.com/ViewPoem.aspx?id=204167",""],[243,"أعاصير","https://www.poetsgate.com/ViewPoem.aspx?id=50473",""],[5725,"الى رحمة","https://www.poetsgate.com/ViewPoem.aspx?id=177499",""],[6300,"عروس أنتِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82838&r=&rc=9",""]],"verses":[["وَأَحطِمَ سِرّي في الضُلوعِ مَخافَةً","أَلَم يَأنِ يَوماً أَن أُذيعَ دَخيلي",0,"ل",2,0],["وأَحُطُّ في مثوى الرسول ركائبي","وبيت للحرم الشريف نزيلا",1,"ل",2,0],["وأحَطُّهم من أن سمعت غناءهم","فمن الضفادع قد سمعت نقيقا",2,"ق",2,0],["وَأَحطُّ الشُّعُوبِ ذَاكَ الَّذِي","يُعْذَرُ فِيهِ المُقَتِّرُ المَرْذُولُ",3,"ل",1,0],["وأحطط رحالك في رحا","بِ ديارنا لتحُطّ إصركْ",4,"ك",1,0],["وَاِحطُط رِحالَك في حِماه توسّلاً","سَتَرى لما أمّلت منهُ كَفيلا",5,"ل",2,0],["وأحطت الجو الذي هو فيه","بضباب الفناء والنسيان",6,"ن",1,0],["وَاحطط رِحالَك بِالفَنا","ءِ الرَحب وَالرَوض القَشيب",7,"ب",1,0],["واحْطُطْ سُرادِقَكَ المضروب عن قَمَرِ","فإِنَّما هو مَحْبُوكٌ منَ الحُبُكِ",8,"ك",1,0],["وأحط صدري فوق صدرك مصغياً","لنحيبه وزفيره المتقطع",9,"ع",1,0],["وأحطت خبراً بالمسائل كلها","وكشفت عن وجه العلوم نقابها",10,"ب",3,0],["واحطم معاطسها بسنبك قودها","واحلق لحاها بالسرى لا الموسى",11,"س",2,0],["واحْطُطْ ذُنوبكَ في رحيبِ جَنابِهِ","وادْخُل وأَيْقِنْ أَنَّها لم نَرْحَلِ",12,"ل",1,0],["وَأَحَطنَ أَجفُنَها بِأَمثالِ القَنا","فَإِذا القُلوبُ دَرِيئَةٌ لِغُرابِها",13,"ب",3,0],["وأحطتْ من غرّ الصِفات بمالها","بل بعضها شُبَهُ الغُلاة تُشيَّد",14,"د",1,0],["واحطط حشاك على جوانبه وقل","مني السَلام عليك يا خير البَشر",15,"ر",1,0],["وَأِحطتُ بالستّ الجهات من العلا","وَجمعت شملَ نظامها المتبدّدِ",16,"د",1,0],["واحطُط بِهِ وِزري وَأَخلِص نِيَّتي","واِشدُد به أَزري وأصلح شاني",17,"ن",2,0],["وَاِحطُطا لي الشِراعِ بِالدَيرِ بِالعَل","ثِ لَعَلّي أُعاشِرُ الرُهبانا",18,"ن",2,0],["واحطُط بساحةٍ يوحنَّا وصاحبهِ","تُوما ولُوقا وكُركا ثُمَّ كركيسِ",19,"س",1,0],["وأحطّم الأغلال أعدو مشعلاً","قبس الضياء وصارخاً حرّيّتي",20,"ت",2,0],["وأحِطْهُ دوْماً بالصَّلاحِ وبالتُّقَى","ليَطيبَ بيْن النّاسِ ذِكْرُ أبيهِ",21,"ي",2,0],["واحطمي القيد فوق هام الطواغيت","وثوري فالفائز الثوار",22,"ر",1,0],["واحطُّ في ليلِ الرصافةِ باكياً","قمرا بداجِ الكرخِ حلو المطلعِ",23,"ع",1,0],["وأحْطِمُ في هواها كلّ قيد ٍ","فتَحْطِمُنِي بِعَيْنيْهَا السُّجون ُ",24,"ن",1,0]]}