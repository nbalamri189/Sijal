{"poems":[[75,"أثرت هزبر الشرى إذ ربض","https://www.aldiwan.net/poem11911.html","المتقارب"],[85,"أعلامك الحمر فوق السفن خافقة","https://www.aldiwan.net/poem54302.html","البسيط"],[47,"بعينك لوعة القلب الرهين","https://www.aldiwan.net/poem66785.html","الوافر"],[68,"كذا فليصبر الرجل النجيب","https://www.aldiwan.net/poem40117.html","الوافر"],[107,"بكيت فأبكيت الطلول البواليا","https://www.aldiwan.net/poem43394.html","الطويل"],[52,"يا مالك الناس في مسيرهم","https://www.aldiwan.net/poem64869.html","المنسرح"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85530","الطويل"],[92,"أمان الله","https://www.poetsgate.com/ViewPoem.aspx?id=179030",""],[62,"لا تعذليه فإن العذل يولعه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67171&r=&rc=0",""],[119,"لباب ابن الوليد شكوت خصمي","https://www.aldiwan.net/poem41781.html","الوافر"],[136,"أدينك أن تذمى الخيزرانا","https://www.aldiwan.net/poem54721.html","الوافر"],[164,"إذا كان من عاداك يصبح نادما","https://www.aldiwan.net/poem58900.html","الطويل"],[308,"يا رحمة الله زوري","https://www.aldiwan.net/poem16858.html","المجتث"],[346,"وليلة قضيتها في الاسى","https://www.aldiwan.net/poem55332.html","السريع"],[368,"بدا في فرعك الوخط","https://www.aldiwan.net/poem60858.html","الهزج"],[443,"وفيهن أضحيت يوم الأضاحي","https://www.aldiwan.net/poem34845.html","المتقارب"],[461,"سل الركب إن أعطاك حاجتك الركب","https://www.aldiwan.net/poem56270.html","الطويل"],[508,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[554,"عرج على الدارسة القفر","https://www.aldiwan.net/poem47777.html","الرجز"],[561,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[562,"أيا سعد قل للقس من داخل الدير","https://www.aldiwan.net/poem69361.html","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/31366","الطويل"],[1094,"","https://poetry.dctabudhabi.ae/diwan/poem/75823","الطويل"]],"verses":[["وَإِنَّ يَدَ البَينِ مَشكورَةٌ","لِعارٍ أَماطَ وَوَصمٍ رَحَض",0,"ض",1,0],["وأن يُدافع عن ذات بحُرمتها","تعوّد الخلقُ لطف الله في القدرِ",1,"ر",1,0],["وَإِنَّ يَدي وَقَد أَسنَدتَ أَمري","إِلَيهِ اليَومَ في يَدِكَ اليَمينِ",2,"ن",1,0],["وَإِنَّ يَدَ الرَدى وَوُقيتَ مِنها","سِهامُ خُطوبِها أَبَداً تُصيبُ",3,"ب",1,0],["وَإِن يَدعُهُ داعي الغِوايَةِ يَستَجِب","وَيَغشَ الدَنايا طائِعاً وَالمَخازِيا",4,"ي",2,0],["وَإِن يُدافِع بِكَ الخُطوبَ فَما","دافَعتَ خَطباً بِمِثلِهِ مَلَبِه",5,"ب",2,0],["وإني دريت الحال ثم ذممته","فهل أَنتَ يا من جاء يحمده داري",6,"ر",2,0],["وإنَّ يداً طوتكَ طوتْ قلوباً","مرفرفِةً وأحلاماً وِساعا",7,"ع",2,0],["وإن يدم أبداً هذا الفراق لنا","فَما الَّذي بِقَضاءِ اللَهِ يَصنَعُهُ",8,"ع",2,0],["وإني داخل بصفاء قلب","عليه وهو غياث الدخيل",9,"ل",1,0],["وإن يُدعَوا إِلَى الجُلَّى تَرَاهُم","بِطَاءً طُولَ دَهرهُمُ بِطَانَا",10,"ن",2,0],["وان يدفع الجلي ويوسع أهله","ميامن لا يبقى لديهم مشاوما",11,"م",2,0],["وأن يديل ويبدل","غمومنا بالسرور",12,"ر",1,0],["وان يد مسته من الاذى","تناثرت اوراقه من عل",13,"ل",1,0],["وإن يُدْعَوا إلى تَفْري","جَةِ الغَمّاء لا يُبْطوا",14,"ط",3,0],["وأَنِّيَ دِنْتُ إِلهي بِدينٍ","من الصَّبْرِ جَلَّ عَنِ الإِرْتِدادِ",15,"د",1,0],["وأنَّ يَدَ اللّهِ البسيطةَ جُنَّةٌ","تقيكم وأحزاب السعودِ لكم حزبُ",16,"ب",1,0],["وإنّي دون غيري وا","رثُ القدس وكنْعانا",17,"ن",2,0],["وَإِنْ يَدُمْ ما نَحنُ في أَسرِهِ","فاللّهُ أَولى فيهِ بِالعذرِ",18,"ر",1,0],["وإني دعوتك لما الدهر جار على","ضعفي وقاسيت منه بأس منتقمِ",19,"م",1,0],["وأن يد التجريد ترفعُ سترها","وتبدو ذواتُ الحسن من داخلِ الستر",20,"ر",1,0],["وَإِنَّ يَدَ النُعمانِ لَيسَت بِكَزَّةٍ","وَلَكِن سَماءٌ تُمطِرُ الوَبلَ وَالدِيَم",21,"م",1,0],["وإني دليلٌ غيْرُ مُخْفٍ دَلالتي","على ألف بَيْتٍ جَدُّهُمْ غيرُ خاشِعِ",22,"ع",1,0]]}