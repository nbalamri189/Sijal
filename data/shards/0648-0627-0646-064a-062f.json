{"poems":[[75,"أثرت هزبر الشرى إذ ربض","https://www.aldiwan.net/poem11911.html","المتقارب"],[85,"أعلامك الحمر فوق السفن خافقة","https://www.aldiwan.net/poem54302.html","البسيط"],[47,"بعينك لوعة القلب الرهين","https://www.aldiwan.net/poem66785.html","الوافر"],[68,"كذا فليصبر الرجل النجيب","https://www.aldiwan.net/poem40117.html","الوافر"],[107,"بكيت فأبكيت الطلول البواليا","https://www.aldiwan.net/poem43394.html","الطويل"],[52,"يا مالك الناس في مسيرهم","https://www.aldiwan.net/poem64869.html","المنسرح"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85530","الطويل"],[92,"أمان الله","https://www.poetsgate.com/ViewPoem.aspx?id=179030",""],[62,"لا تعذليه فإن العذل يولعه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67171&r=&rc=0",""],[119,"لباب ابن الوليد شكوت خصمي","https://www.aldiwan.net/poem41781.html","الوافر"],[136,"أدينك أن تذمى الخيزرانا","https://www.aldiwan.net/poem54721.html","الوافر"],[164,"إذا كان من عاداك يصبح نادما","https://www.aldiwan.net/poem58900.html","الطويل"],[309,"يا رحمة الله زوري","https://www.aldiwan.net/poem16858.html","المجتث"],[347,"وليلة قضيتها في الاسى","https://www.aldiwan.net/poem55332.html","السريع"],[369,"بدا في فرعك الوخط","https://www.aldiwan.net/poem60858.html","الهزج"],[445,"وفيهن أضحيت يوم الأضاحي","https://www.aldiwan.net/poem34845.html","المتقارب"],[463,"سل الركب إن أعطاك حاجتك الركب","https://www.aldiwan.net/poem56270.html","الطويل"],[510,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[556,"عرج على الدارسة القفر","https://www.aldiwan.net/poem47777.html","الرجز"],[563,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[564,"أيا سعد قل للقس من داخل الدير","https://www.aldiwan.net/poem69361.html","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66851","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38334","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38445","البسيط"],[1116,"","https://poetry.dctabudhabi.ae/diwan/poem/117085","الرجز"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136194","البسيط"],[1993,"","https://poetry.dctabudhabi.ae/diwan/poem/199033","الطويل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137963",""],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109455","الرجز"],[2347,"","https://poetry.dctabudhabi.ae/diwan/poem/89516","الطويل"],[2367,"","https://poetry.dctabudhabi.ae/diwan/poem/31366","الطويل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121188","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83230","البسيط"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203551","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62745","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62830","المتقارب"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131027",""],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86519","الطويل"],[3975,"","https://poetry.dctabudhabi.ae/diwan/poem/75823","الطويل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107487","المتقارب"],[5102,"حنين..","https://www.poetsgate.com/ViewPoem.aspx?id=12883",""],[5102,"ضربة شمس في شاطئ الراحة","https://www.poetsgate.com/ViewPoem.aspx?id=15691",""],[5376,"كأنِّي أنا والبحرُ والطيرُ في هوى","https://www.poetsgate.com/ViewPoem.aspx?id=188428",""],[5431,"أمنية ..تمنيتُ لو أني حروف قصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=198616",""],[5899,"تخيل , إنها تسأل","https://www.poetsgate.com/ViewPoem.aspx?id=31109",""],[6031,"وإنّ يداً أسْدَيتُهَا لحَقيقةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=46371",""],[5922,"أَمامَ يديْ ألمانيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88227&r=&rc=2",""]],"verses":[["وَإِنَّ يَدَ البَينِ مَشكورَةٌ","لِعارٍ أَماطَ وَوَصمٍ رَحَض",0,"ض",1,0],["وأن يُدافع عن ذات بحُرمتها","تعوّد الخلقُ لطف الله في القدرِ",1,"ر",1,0],["وَإِنَّ يَدي وَقَد أَسنَدتَ أَمري","إِلَيهِ اليَومَ في يَدِكَ اليَمينِ",2,"ن",1,0],["وَإِنَّ يَدَ الرَدى وَوُقيتَ مِنها","سِهامُ خُطوبِها أَبَداً تُصيبُ",3,"ب",1,0],["وَإِن يَدعُهُ داعي الغِوايَةِ يَستَجِب","وَيَغشَ الدَنايا طائِعاً وَالمَخازِيا",4,"ي",2,0],["وَإِن يُدافِع بِكَ الخُطوبَ فَما","دافَعتَ خَطباً بِمِثلِهِ مَلَبِه",5,"ب",2,0],["وإني دريت الحال ثم ذممته","فهل أَنتَ يا من جاء يحمده داري",6,"ر",2,0],["وإنَّ يداً طوتكَ طوتْ قلوباً","مرفرفِةً وأحلاماً وِساعا",7,"ع",2,0],["وإن يدم أبداً هذا الفراق لنا","فَما الَّذي بِقَضاءِ اللَهِ يَصنَعُهُ",8,"ع",2,0],["وإني داخل بصفاء قلب","عليه وهو غياث الدخيل",9,"ل",1,0],["وإن يُدعَوا إِلَى الجُلَّى تَرَاهُم","بِطَاءً طُولَ دَهرهُمُ بِطَانَا",10,"ن",2,0],["وان يدفع الجلي ويوسع أهله","ميامن لا يبقى لديهم مشاوما",11,"م",2,0],["وأن يديل ويبدل","غمومنا بالسرور",12,"ر",1,0],["وان يد مسته من الاذى","تناثرت اوراقه من عل",13,"ل",1,0],["وإن يُدْعَوا إلى تَفْري","جَةِ الغَمّاء لا يُبْطوا",14,"ط",3,0],["وأَنِّيَ دِنْتُ إِلهي بِدينٍ","من الصَّبْرِ جَلَّ عَنِ الإِرْتِدادِ",15,"د",1,0],["وأنَّ يَدَ اللّهِ البسيطةَ جُنَّةٌ","تقيكم وأحزاب السعودِ لكم حزبُ",16,"ب",1,0],["وإنّي دون غيري وا","رثُ القدس وكنْعانا",17,"ن",2,0],["وَإِنْ يَدُمْ ما نَحنُ في أَسرِهِ","فاللّهُ أَولى فيهِ بِالعذرِ",18,"ر",1,0],["وإني دعوتك لما الدهر جار على","ضعفي وقاسيت منه بأس منتقمِ",19,"م",1,0],["وأن يد التجريد ترفعُ سترها","وتبدو ذواتُ الحسن من داخلِ الستر",20,"ر",1,0],["وإن يدنُ منه عدوٌّ له","يَذُدْه عليٌّ مكاناً قصيّا",21,"ي",2,0],["وَإِنّيَ دار الكزبريّ الّذي خَلا","بِذا الدَّهرِ عَن شبهٍ وَمثلٍ وَأَضرابِ",22,"ب",1,0],["وَأَن يديرَ لِظَهري حينَ يَقطَعُهُ","وَجهي وَأَنّي أَراهُ مِنهُ بِالدّاني",23,"ن",2,0],["وأن يَدُقّ طِينَه المُخَتَّمَا","صَمصَامُه ماضٍ إذا ما صمَّمَا",24,"م",2,0],["وان يدم زمن الهجران فابك على","حشاشتي فلقد ذقت الهوى صبرا",25,"ر",2,0],["وإن يدعي بالبعض والبعض فليقل","لنا من أولاك البعض إن هو قائل",26,"ل",1,0],["وان يدَ البغي التي امتد شرُّها","وطالت عراها القصر بل كسِرت كسرا",27,"ر",2,0],["وأن يد من طاهرات الذيل","من دنس يجلب كل ويل",28,"ل",1,0],["وإن يدعني الحيان من فرع يقدم","ويذكر يظهر ودي المتحدب",29,"ب",1,0],["وَإِنَّ يَدَ النُعمانِ لَيسَت بِكَزَّةٍ","وَلَكِن سَماءٌ تُمطِرُ الوَبلَ وَالدِيَم",30,"م",1,0],["وان يد الاقسام الوت اعنتي","كقوداء نحّاها من السرب جاذب",31,"ب",1,0],["وَأَن يُديمَكَ مَغبوطاً بِصِحَّتِهِ","كَما يَدومُ لَكُم عِزٌّ وَإِجلالُ",32,"ل",1,0],["وإن يدا بالنطق في الحقائق","دقق حتى تعجم الدقائق",33,"ق",1,0],["وإنّ يدي مبسوطةٌ من نَوالِهِ","تَجُرُّ العَطايا والعَطايا جَوامِعُ",34,"ع",1,0],["وإنْ يُدْرِك السَّبْقَ أقرانُهُ","إذا بادرَ الجَرْيَةَ الأسْرَعُ",35,"ع",1,0],["وأنّ يد الخلاق في الكون أوجدت","لأجلهما ما طلب مرأى ومسمعا",36,"ع",2,0],["وأن يدنف المثري بأعقاب بطنة","غداة خفيف الحاذ بالجوع يدنف",37,"ف",1,0],["وإني دليلٌ غيْرُ مُخْفٍ دَلالتي","على ألف بَيْتٍ جَدُّهُمْ غيرُ خاشِعِ",38,"ع",1,0],["وإِنَّ يداً تجمعُ الأَشرفينِ","جليلَ العطاءِ وغض الأدب",39,"ب",1,0],["وإني دليلك فاتبع خطاي","تعلّم وبالشيخ لا تستهينْ",40,"ن",1,0],["وأنْ يدرُسَ اللغاتِ بِالهايْدِ(ساحهْ)","لعلّهُ ينظُمُ بغيرِ المُعَرَّبِ",41,"ب",1,0],["وإني دنوت لا حياةَ لأنسنا","وفيها هرمْنا والختامُ نضاجعُ‎'",42,"ع",1,0],["وأنّ يديكَ الراسماتِ خبيرةٌ","تضمُ لها حسا ويخلو من البخسِ",43,"س",1,0],["وأني دون عينيها","ضياع ضائع أعزلْ",44,"ل",1,0],["وإنّ يداً أسْدَيتُهَا لحَقيقةٌ","بوقَفِ ثَنائِي ما حَييتُ عَلَيها",45,"ه",2,1],["وأَن يُدَرِّسَ فَنَّ الحُبِّ حَيْثُ طَغَى","دَرْسُ الحُرُوبِ وأَنَّ السَّيْفَ لاَ جَدْوَى",46,"و",2,0]]}