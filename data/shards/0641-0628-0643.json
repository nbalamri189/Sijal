"كل العراق على الصليب مسيح.","https://www.poetsgate.com/ViewPoem.aspx?id=211291",""],[5376,"بانتْ بليلى امةٌ وديارُ","https://www.poetsgate.com/ViewPoem.aspx?id=197712",""],[5376,"يا ربُّ سلِّمْ أرضَ غزَّةَ أنَّها","https://www.poetsgate.com/ViewPoem.aspx?id=198985",""],[5397,"عذبت لنظرة عينك الأرياف","https://www.poetsgate.com/ViewPoem.aspx?id=157965",""],[5409,"ذكرت صباً لها كان وفياً","https://www.poetsgate.com/ViewPoem.aspx?id=155366",""],[5413,"الحب","https://www.poetsgate.com/ViewPoem.aspx?id=208710",""],[5431,"رحمة الله في لظى العشاق","https://www.poetsgate.com/ViewPoem.aspx?id=196812",""],[709,"هَلَّ الْمُحَرَّمُ فَاسْتَهِلَّ مُكَبِّرَا","https://www.poetsgate.com/ViewPoem.aspx?id=2961",""],[5458,"رحم الله أم ديبو","https://www.poetsgate.com/ViewPoem.aspx?id=72164",""],[5459,"مديح نبوي","https://www.poetsgate.com/ViewPoem.aspx?id=190900",""],[5545,"ذَنبٌ يُفترى","https://www.poetsgate.com/ViewPoem.aspx?id=185000",""],[5563,"كَلَّ منِّي الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=212143",""],[5582,"سَرَتْ الحُدُوجُ يَزِينُها الأَفْزازُ","https://www.poetsgate.com/ViewPoem.aspx?id=187152",""],[5595,"عيد المعلم","https://www.poetsgate.com/ViewPoem.aspx?id=144648",""],[5615,"شعرور!","https://www.poetsgate.com/ViewPoem.aspx?id=187950",""],[5618,"وردة في محراب عقبة","https://www.poetsgate.com/ViewPoem.aspx?id=208918",""],[5628,"الحب الدائم","https://www.poetsgate.com/ViewPoem.aspx?id=178530",""],[5642,"الغروب","https://www.poetsgate.com/ViewPoem.aspx?id=123668",""],[5672,"يوم النوى","https://www.poetsgate.com/ViewPoem.aspx?id=206403",""],[5691,"فقير...!","https://www.poetsgate.com/ViewPoem.aspx?id=207554",""],[5704,"عشق٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=204261",""],[5725,"انوار محمد","https://www.poetsgate.com/ViewPoem.aspx?id=177543",""],[5829,"وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=157230",""],[5842,"رسالة .. إلى الجيش العربي السوري","https://www.poetsgate.com/ViewPoem.aspx?id=67970",""],[5906,"غدا يشيّعنا التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=193749",""],[5956,"وحيدة حتى الموت","https://www.poetsgate.com/ViewPoem.aspx?id=183438",""],[5956,"الشعر يبكي فقدنا لِحُنُوِّكا","https://www.poetsgate.com/ViewPoem.aspx?id=193975",""],[5957,"العيد أنتَ","https://www.poetsgate.com/ViewPoem.aspx?id=181834",""],[5974,"غربة يتيم","https://www.poetsgate.com/ViewPoem.aspx?id=200259",""],[5997,"قالت وقلت","https://www.poetsgate.com/ViewPoem.aspx?id=214209",""],[2096,"ذكر الأحباب والوطنا","https://www.poetsgate.com/ViewPoem.aspx?id=106662",""],[5309,"من اعد العيش فوق السحب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573523",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[6344,"تَجاعيدُ المَرايا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87963&r=&rc=3",""]],"verses":[["فبَكِّرْ علَيهِ بالأراقِمِ لُسَّعاً","وأسْرِ إليهِ بالعَقارِبِ لُدَّغا",0,"غ",2,0],["فَبكى ولَم أرَ عَبْرَةً مَسْفوحَةً","أكذاكَ يَبْخَلُ بالدُّموعِ المُغْرَمُ",1,"م",1,0],["فَبِكُلِّ بَحْرٍ رَايَةٌ مَنْشُورَةٌ","وَبِكُلِّ غَوْرٍ مقْنَبٌ وَرَعِيلُ",2,"ل",1,0],["فبِكُلِّ أفْقٍ رائِدٌ لا يلْتَقي","لَفَظَتْهُ عنْ ساحاتِها أغْوارُهُ",3,"ر",2,0],["فَبِكُلِّ أَرضٍ مِن رِجالِكَ عُصبَةٌ","وَبِكُلِّ بَحرٍ مِن لَدُنكَ سَفينُ",4,"ن",1,0],["فَبَكى وَرَقَّ لَهُ وَقالَ مُسَلِّياً","لَكَ في مُصابِكَ أُسوَةٌ بِأَبيكا",5,"ك",2,0],["فَبَكّوا عَلى صَخرِ بنِ عَمروٍ فَإِنَّهُ","يَسيرٌ إِذا ما الدَهرُ بِالناسِ أَعسَرا",6,"ر",2,0],["فَبَكّي لِصَخرٍ وَلا تَندُبي","سِواهُ فَإِنَّ الفَتى مِصقَعُ",7,"ع",1,0],["فَبَكّيهِ فَقَد وَلّى حَميداً","أَصيلَ الرَأيِ مَحمودَ الصَديقِ",8,"ق",1,0],["فَبَكّي أُمَّ عَمروٍ كُلَّ يَومٍ","أَخا ثِقَةٍ مُحَيّاهُ جَميلُ",9,"ل",1,0],["فبكلِّ ملتفت صقالٌ مشهرٌ","قدّاح زندٍ للحفيظة واري",10,"ر",2,0],["فبك اليوم بعد طول اضطراب","أصبح الأمر ثابتاً مستقرّا",11,"ر",2,0],["فبكاه من بغداد منتجا","في جانبيها كل ذي أدب",12,"ب",1,0],["فَبَكّي رَسولَ اللَهِ يا عَينُ عَبرَةً","وَلا أَعرِفَنكِ الدَهرَ دَمعَكِ يَجمَدُ",13,"د",1,0],["فبكى أحمد وما كان من يبكي","ولكنها دموع الإباء",14,"ا",2,0],["فبكوا على الجبل الذي كان الذَّرى","من هيج كل ملمَّةٍ زُعْزُوع",15,"ع",1,0],["فبكل قاعٍ منهمُ","بطلٌ لجبهتِه يُتَلُّ",16,"ل",1,0],["فبكى مُعولاً لذلك ومحقو","قٌ بطول البكاءِ والإعوالِ",17,"ل",1,0],["فبكفّيك من الل","ه إذا خِيف ارتطامُ",18,"م",1,0],["فبكتْ بدمعٍ لا يُجادُ به","إلا لذي قَدْرٍ من الألمِ",19,"م",1,0],["فبكَّيته حيّاً كَمَيْتٍ فقدتُهُ","وما الميْتُ إلا من تموتُ مكارمه",20,"م",2,0],["فبكته مصر وكل فلسطين","وسورية أسى والعراق",21,"ق",1,0],["فبكاه الفرقان حزنا عليه","وبكاه التوراة والانجيل",22,"ل",1,0],["فبكى عليه الشعب من كبد له","حرى بكاء الثاكل الملواح",23,"ح",1,0],["فبكت لتمنَعه الرحيل وأعولت","لكن نجيبٌ بالقطيعة مزمع",24,"ع",1,0],["فَبَكَت لِذاكَ تَنَدُّماً","هَيهاتَ لا تُجدي النَدامَه",25,"م",2,0],["فَبَكَت يَأساً وَصاحَت","قَبلَ جَريِ الماءِ في الفَم",26,"م",1,0],["فَبَكى المَغرورُ مِن حالِ الخَبيث","وَدَنا يَسأَلُ عَن شَرحِ الحَديث",27,"ث",1,0],["فَبَكى رَحمَةً وَما كانَ مَن يَب","كي وَلَكِنَّما أَرادَ الوَفاءُ",28,"ا",2,0],["فبكلِ أرضٍ رايةٌ وعصابةٌ","جُمعتْ وحربٌ لا تُطاقُ زبونُ",29,"ن",1,0],["فَبِكُم قَدَّمَت قُصَيّاً قُرَيشٌ","وَبِها قَدَّمَت قُرَيشاً نِزارُ",30,"ر",1,0],["فَبَكَرْنَ يَحجُبنَ الصبَّ","حَ بقَسطَلٍ في الجوِّ ثائِر",31,"ر",1,0],["فَبَكَّتَت مِن جَسمِهِ عِظامَه","وَبَيَّنَت مِن أَنفِهِ أَرغامَه",32,"م",2,0],["فَبَكى الطَيرُ بِنَوحٍ","أَجمَلَ القَولَ وَفَصَّل",33,"ل",1,0],["فبكت وتلكَ دموعها","هذي تسيلُ وذي تلي",34,"ل",2,0],["فَبِكُلِّ أُفْقٍ مُزْنَةٌ فَيَّاضَةٌ","وَبِكُلِّ أَرْضٍ جَدْوَلٌ كَالأَرْقَمِ",35,"م",1,0],["فَبَكَت ثُمَّ أَعرَضَت ثُمَّ قالَت","مَن بِهَذا أَتاكَ في اليَومِ عَنّا",36,"ن",2,0],["فَبَكاكَ مِن قَبرٍ كَريمٍ عارِضٌ","زَجِلٌ لَهُ مِن رَنَّةٍ إِرعادُ",37,"د",1,0],["فَبَكَى ذَنْبَهُ بِقَسْوَةِ قَلْبٍ","نَهَتِ الدَّمْعَ فالبُكاءُ مُكاءُ",38,"ا",2,0],["فَبَكَت هِندٌ وَقالَت","حِبِّ لا تُنكِر خِطابي",39,"ب",2,0],["فَبَكَت بِكيَةَ الحَزينِ وَقالَت","كُلُّ عَيشٍ مُوَدَّعٌ عَن قَريبِ",40,"ب",1,0],["فَبِكُلّ منه والألحاظِ لي","سَكْرَةٌ وَاَطَرَبَا من سَكْرَتَي",41,"ي",1,0],["فَبَكَت في بَغداد حقي عيونٌ","كانَ حقي منها مكانَ السواد",42,"د",1,0],["فَبَكينا شبابه وَبَكينا","جلداً فيه راسخ الأوتاد",42,"د",1,0],["فَبَكى عليه سيفُه وَجوادُه","وَبَكى عليه صلاحه وَالمسجد",43,"د",1,0],["فَبَكَيْتُ مِن زَمَنٍ قَطَعْتُ مَراحِلاً","وشَبيبَةٍ أَخْلَقْتُ مِن رَيْعَانِهَا",44,"ن",3,0],["فَبَكَيْنَ قيساً ترْحَة","وَحَبِبْنَهُ مِلءَ الضمَائِرْ",45,"ر",1,0],["فبكى لي النهرُ الحنونُ توجعا","لما رأى هذا الشحوب البادي",46,"د",2,0],["فَبَكى الرَكبُ لِخَطبِ المَعالي","وَبَكَت لِلرَّكب بُزلُ المَطِيِّ",47,"ي",1,0],["فبكاهُ النجمُ ورقَّ له","ممّا يرعاه ويرْصُدهُ",48,"د",2,0],["فبكتْ بِنَرجِسَتينِ خفتُ عليهما","نَفسِي فلم ألثم بغيرِ ضَميري",49,"ر",2,0],["فبكلِّ ثغرٍ من حليبكِ قطرةٌ","وقَرابةٌ في كلِّ عِرْقٍ أو رِئَهْ",50,"ا",2,0],["فَبَكت فأذرَت أَدمُعاً","في صفحةِ الخَدّ الأنِيق",51,"ق",1,0],["فَبَكاهُ ثَغرٌ كانَ عِصمَةَ أَهلِهِ","وَمَعاذَ قاصِدِهِ وَعِزَّ وُلاتِهِ",52,"ت",2,0],["فَبَكى وَأَضحَكَهُ الرَجاءُ فَما رَأَت","عَينٌ سِواهُ ضاحِكاً مُستَعبِرا",53,"ر",2,0],["فبكى وما يغنى البكاء وإنما","هي روحه تَنْهلُّ في تسْكابِه",54,"ب",2,0],["فبِكَ استقرَّ الحقُّ واتضح الهدى","وأبان للثَّقَلين وجهُ دليلِهِ",55,"ل",2,0],["فبكى الحصان الأعوجيُّ تحمحماً","والهندوانيُّ الجُرازُ صليلا",56,"ل",2,0],["فبكتء على شجنٍ ورجَّعتِ البكا","وتمايلتْ جزعاً لها الأعوادُ",57,"د",1,0],["فبكت عليه الأنس حزناً بعدما","هتفت به الجنّ المنيعة في العرا",58,"ر",2,0],["فَبَكِّ بَني هارونَ وَاِذكُر فَعالَهُم","وَقَتلَهُمُ لِلجوعِ إِذ كُنتَ مُجدِبا",59,"ب",2,0],["فَبَكى ذاكِراً عُذوبَةَ ماضيهِ","وَحبّا مَضى مَعَ الاِورادِ",60,"د",1,0],["فَبِكُلِّ صَقعٍ مِن ضُلوعِك قِسمَة","خِلَعٌ عَلى لَهَب الشَبابِ موزَّعَه",61,"ع",2,0],["فَبكتني عروسَةُ الشِعر لكِن","لا تَروّي الفُؤادَ تِلكَ الدُموعُ",62,"ع",1,0],["فَبَكى اليَوم لِلسَّلام وَلكِن","ما بكاهُ بِالأَمسِ كان خِصاما",63,"م",2,0],["فَبكى الزَمانُ وقال فيه مؤرِّخا","الفَضلُ زالَ بِفَق