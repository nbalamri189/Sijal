/www.aldiwan.net/poem48777.html","الطويل"],[403,"أحسن ما يبدي به الكلام","https://www.aldiwan.net/poem33344.html","الرجز"],[403,"له الحمد حمدا لا يلم به الحصر","https://www.aldiwan.net/poem33919.html","الطويل"],[405,"نصيبك من سفيه أو فقيه","https://www.aldiwan.net/poem49714.html","الوافر"],[409,"لو استطعت ولو ملكت أمري في","https://www.aldiwan.net/poem32204.html","البسيط"],[416,"وعدتن طرفي بالخيال وصالا","https://www.aldiwan.net/poem54037.html","الطويل"],[416,"أدار على الندمان كأس عقاره","https://www.aldiwan.net/poem54057.html","الطويل"],[439,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[441,"يموت الصحيح ويحيا المصاب","https://www.aldiwan.net/poem14346.html","المتقارب"],[449,"يئس الصغار من الكبار","https://www.aldiwan.net/poem995.html",""],[452,"أحن إلى تلك الربى والمعاهد","https://www.aldiwan.net/poem13715.html","الطويل"],[452,"ويح قلبي كم ذا يطيق احتمالا","https://www.aldiwan.net/poem13962.html","الخفيف"],[458,"متى وصلت تحية مستهامِ","https://www.aldiwan.net/poem55870.html","الوافر"],[458,"بالله ثم بالله","https://www.aldiwan.net/poem55953.html","مجزوء الرجز"],[458,"دعوها ترد بعد خمس شروعا","https://www.aldiwan.net/poem56122.html","المتقارب"],[458,"على كل حال جانب الحق أمنع","https://www.aldiwan.net/poem56131.html","الطويل"],[458,"أصب برأيي أصاب الحظ أو غلطا","https://www.aldiwan.net/poem56141.html","البسيط"],[458,"تظن ليالينا عودا","https://www.aldiwan.net/poem56231.html","المتقارب"],[458,"لمن صاغيات في الحبل طلائح","https://www.aldiwan.net/poem56246.html","الطويل"],[479,"لست الإله ولست بالشيطان","https://www.aldiwan.net/poem36946.html","الكامل"],[482,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[500,"أجل نظرا في الكائنات ترى العجب","https://www.aldiwan.net/poem37679.html","الطويل"],[500,"أسعفيني يا نياقي","https://www.aldiwan.net/poem37940.html","مجزوء الرمل"],[505,"الجرّافة","https://www.aldiwan.net/poem56764.html","الوافر"],[509,"سا ئل سدوس التي أفنى كتائبها","https://www.aldiwan.net/poem747.html",""],[515,"أيا أذن الأيام إن قلت فاسمعي","https://www.aldiwan.net/poem12176.html","الطويل"],[529,"أقول بعد الحمد","https://www.aldiwan.net/poem37446.html","مجزوء الرجز"],[538,"بربك هل أبصرت أسخف من عقلي","https://www.aldiwan.net/poem47995.html","عموديه"],[540,"قفا فهريقا الدمع بالمنزل الدرس","https://www.aldiwan.net/poem56802.html","الطويل"],[540,"صرمت حبائلا من حب سلمى","https://www.aldiwan.net/poem56867.html","الوافر"],[551,"رماك فأصماك امرؤ لم تكن له","https://www.aldiwan.net/poem47183.html","الطويل"],[551,"توق ديار الحي فهي المقاتل","https://www.aldiwan.net/poem47325.html","الطويل"],[558,"نقطة النفس فوق عين الإله","https://www.aldiwan.net/poem33618.html","الخفيف"],[558,"سلام عظيم من عظيم تفردا","https://www.aldiwan.net/poem34594.html","الطويل"],[575,"علي وعثمان أبوه وجده","https://www.aldiwan.net/poem2797.html","الطويل"],[587,"على دارس الأطلال بالمتحلب","https://www.aldiwan.net/poem11503.html","عموديه"]],"verses":[["فَإِن سارَ لِلأَعداءِ غَيرُكَ فَاِربَعي","وَإِن قامَ لِلعَلياءِ غَيرُكَ فَاِقعُدِ",0,"د",1,0],["فإنَّ سُيوفاً أغْمَدَتْها حلومُهُمْ","لَتَفْري طُلى يَلْوي أخادِعَها الكِبْرُ",1,"ر",1,0],["فَإِن ساءَكُم ما بي مِنَ الضُرِّ فَاِرحَموا","وَإِن سَرَّكُم هَذا العَذابُ فَعَذِّبوا",2,"ب",3,0],["فإنْ سَكِرَتْ واستشْرَفَتْ عندَ سُكْرِها","لماهيّةِ السُّقْيا ومعْرِفَةِ السّاقي",3,"ي",1,0],["فَإِنَّ سُمُومَ الْقَيْظِ عِنْدِيَ نَسْمَةٌ","وَإِنَّ هَشِيمَ الْفَقْرِ عِنْدِيَ بُستَانُ",4,"ن",1,0],["فَإِنْ سَجَعَ الرُّكْبَانُ فِيَّ بِمِدْحَةٍ","حَثَتْ في وُجُوهِ الْمَادِحِينَ تُرَابِي",5,"ي",1,0],["فَإِنَّ سُكونَ الشُجاعِ النَهوسِ","لَيسَ بِمانِعِهِ أَن يَعَضّ",6,"ض",1,0],["فَإِن سُتِرَت أَخلاقُهُم بِتَخَلُّقٍ","فَكُلُّ خَضيبٍ لا مَحالَةَ ناصِلُ",7,"ل",1,0],["فَإِنَ سَأَلَ الواشُونَ فِيمَ صَرَمتُها","فَقُل نَفس حُر ّسُلِّيَت فَتَسَلَّتِ",8,"ت",1,0],["فَآنِسَن مِن ساعَةٍ فارِساً","يَخُبُّ أَدنى بُقَعِ المَنظَرِ",9,"ر",1,0],["فَإِن سَمِعتَ لَهُ نَعتَ القَنا عَبَثاً","فَقَد أَرادَ قَناً لَيسَت لَهُ عُقَدُ",10,"د",1,0],["فآنس من تلقائك الملكُ رشدَه","ونال بك الإسلام ما كان راجيا",11,"ي",2,0],["فآنست حتى ما شكوتُ بغربةٍ","وواليتَ حتَّى لَمْ أَجدْ مَضَضَ الفقدِ",12,"د",1,0],["فإن سعدون دانى الشمس منزلةً","وإن سعدا بمصر قارن القمرا",13,"ر",2,0],["فَإِنَّ سُراكِ تَقصُرُ عَن سُرانا","وَعَن وَخدِ المُخَدَّمَةِ العِجالِ",14,"ل",1,0],["فَإِن سَأَلوكَ عَنها فَاِجلُ عَنها","بِما لا شَكَّ فيهِ وَلا خِصاما",15,"م",2,0],["فَإِن سَأَلنا سِواكَ عارِفَةً","فَبَعدَ قَطعِ الرَجاءِ نَسأَلُها",16,"ل",3,0],["فإن سَألتْنِي عنك يوماً عصابةٌ","شهدتُ على نفسي بسوء المناقبِ",17,"ب",1,0],["فإن سقَّينَني صَرَّدْن شُربي","ولم يكُ عن هوىً بل عن خلابِ",18,"ب",1,0],["فإن سمعنا لِمزهر وتراً","حنّ فهاتيك عَوْلة الوترِ",19,"ر",1,0],["فانسَ الحُقود فإنها منسيةٌ","إلا لدى اللؤماء والأشرارِ",20,"ر",1,0],["فانسَ ذكري فإن قلبيَ ناسٍ","لك ما عاقب الغروبُ الشروقا",21,"ق",2,0],["فإنْ سدَّ بابَ العذر فيما نَقِمتَه","هواكَ فلي بالرأي فيه مخارمُ",22,"م",1,0],["فَاِنسَلَّ مِن أَصحابِهِ","سِرّاً وَأَغضَت جارَتاها",23,"ا",3,0],["فَآنَستَني في البُعدِ حَتّى تَرَكتَني","كَأَنِّيَ في أَهلي مُقيمٌ وَمَنزِلي",24,"ي",1,0],["فإنْ سئِمتْ حملَ الرؤوسِ رقابُها","فبالبيضِ شوقٌ نحوَها وغليلُ",25,"ل",1,0],["فإنْ سلمتُ فمَنْ مثلي وإن تكنِ ال","أُخرى فقد نِلْتُ من إِلمامِها وطَرا",26,"ر",2,0],["فانْ سكنتْ نفسي إِلى سكَنٍ لها","سواكِ مدى عُمْري فقد بُؤْتُ بالكُفْرِ",27,"ر",1,0],["فَإِن سَحَبَ اللَيلُ مِن ذَيلِهِ","رَأَيتَهُمُ عُقبَةً عُقبَه",28,"ب",2,0],["فَإِن سِتٌّ وَسُتّونَ اِستَقَلَّت","فَلا كَرَّت بِرَجعَتِها الخُطوبُ",29,"ب",1,0],["فَإِن سَأَلَت عَنّي سُلَيمى فَقُل لَها","بِهِ غُبَّرٌ مِن دائِهِ وَهوَ صالِحُ",30,"ح",1,0],["فإنّ سِجالَ الدهرِ في الناس قبلَكم","ولا عَارَ نقصٌ مؤلِمٌ وتمَامُ",31,"م",1,0],["فَإِن سَمَحَت كُنتَ الغَنيَّ وَإِن أَبَت","فَكُلُّ مَمنوعٍ بَعدَها واسِعُ العُذرِ",32,"ر",1,0],["فَإِنَّ سُكونَها حَرَكٌ يُناجي","كَأَنَّ بُطونَ غائِبِها ظُهورُ",33,"ر",1,0],["فَإِن سَعِدتُ فَمَدحي فيكَ موجِبُهُ","وَإِن شَقَيتُ فَذَنبي موجِبُ النَقَمِ",34,"م",1,0],["فَإِنَّ سُلَيمانَ في مُلكِهِ","وَكُلٌّ بِآرائِهِ يَهتَدي",35,"د",2,0],["فَإِن سَمَحَ الدَهرُ المُشِتُّ بِقُربِكُم","وَأَصلَحَ ما قَد أَفسَدَتهُ يَدُ الهَجرِ",36,"ر",1,0],["فإن سَلِمَ الشطرُ الَّذي لا سلامةٌ","له من ظُبا الهيجا فقد عطِبَ الشطرُ",37,"ر",1,0],["فَإِن سَمِعتَ لَهُ نَعتَ القَنا عَبَثاً","فَقَد أَرادَ قَناً لَيسَت لَها عُقَدُ",38,"د",1,0],["فَإِنْ سَادَ غَيْرِي بِالْجُدُودِ فَإِنَّنِي","بِهِمْ وَبِفَضْلِي رِشْتُ سَهْمِي فَمَا أَشْوَى",39,"و",2,0],["فإنْ سالمتهم سلموا وساموا","وإن حاربْتَهم أضحَوا أضاحي",40,"ح",2,0],["فإنْ ساوَقْتَهُمْ حَرْفاً بحَرْفٍ","فكُلُّ اسْم يَحُطُّوا مِنْهُ سِينا",41,"ن",2,0],["فَإِن سَلِمتُ وَما قَلبي عَلى ثِقَةٍ","مِنَ السَلامَةِ لَم أَسلَم بِبَغذاذا",42,"ذ",2,0],["فَإِنَّ سُكونَها حَرَكٌ تَنادى","كَأَنَّ بُطونَ غائِبِها ظُهورُ",43,"ر",1,0],["فَاِنسَلَّ عَن سُكارِهِ المَمحوصِ","وَاِنقَضَّ يَهوي وَهوَ كَالوَبيصِ",44,"ص",1,0],["فَإِنَّ سُراءَ اللَيالي رَمى","أَوانَ شَبيبَتِنا فَاِنسَرى",45,"ر",2,0],["فَإِن سَكِرَت فَالراحُ فيها كَثيرَةٌ","ذَوارِعُها وَالمُخرَزاتُ الحَتائِمُ",46,"م",1,0],["فَإِن سُمّوا بِأَرقَمَ أَو بِلَيثٍ","فَذِئبِيٌّ أَتاكَ وَعَقرَبِيُّ",47,"ب",2,0],["فَانسابَ ناصِرُ دينِ اللَّهِ يَقْدُمُهُمْ","وحَوْلَه مِنْ جُنُودِ اللَّهِ أَنصارُ",48,"ر",1,0],["فانسَيْ مواعيدَ الهوى واذكري","أيَّ فتىً في الحبِّ لم يُخْدَعِ",49,"ع",1,0],["فآنَسْتُ خَيْلاً بالرُّقَيِّ مُغِيرَةً","سَوابِقُها مِثْلُ القَطا المُتَواتِرِ",50,"ر",1,0],["فانساحت الكتائب انسياحا","أرسلها من يرسل الرياحا",51,"ح",2,0],["فَإِنْ سَمِعْتَ رَنِيناً كُلُّهُ عَجَبٌ","فَالْعُودُ عُودِي وَالأَوْتَار أَوْتَارِي",52,"ر",2,0],["فأنسى عذارى، وأنسى وقاري","و؛سب أَنِّيَ عدت صبيا",53,"ي",2,0],["فإِنَّ سَرَاة َ القَوْمِ منهم عَبيدُهمْ","وإن حروف النطق منها الزوائد",54,"د",1,0],["فَإِن سَطا فَبِإِحكام تنفّذها","وَإِن سَخى فَبفضل مِن مَساعيكا",55,"ك",2,0],["فانساني الفراق لذيذ انسي","وصادم جمعتي بالانفضاض",56,"ض",1,0],["فأنساني اللائي أُباهي بذكرهم","وكانوا كأن لم يجسلوا في الشوارع",57,"ع",1,0],["فإنّ سلاحَ المؤمنينَ دعاؤُهم","إذا جن ليلٌ وادْلهم ظلامُ",58,"م",1,0],["فإن سار فالعلياء والمجد مركب","وإن حل فالافراج والبشر منزل",59,"ل",1,0],["فَإِن سَمِعت بِرَحىً مَنصوبَة","لِلحَربِ فَاِعلَم أَنَّني قُطبُ الرَحى",60,"ا",1,0],["فإن ساءلتني مَن ذاكَ أنشد","وذاكَ محمدٌ تَفديهِ نَفْسي",61,"ي",1,0],["فإن سُدَّ منه مِنخَرٌ جاشَ منخرٌ","وإن سرَّ منهُ جانبٌ ساءَ جانب",62,"ب",1,0],["فَإِن سَلِمَت نَفسي لَهُنَّ هَنيئَةً","مِنَ الدَهرِ جاوَرنَ النُّجومَ الثَواقِبا",63,"ب",2,0],["فَإِن ساءَني مِنهُم عَلى القُربِ مَعشَرٌ","وَأَصبَحَ مِن تِلقائِهِم ما أُكابِدُ",64,"د",1,0],["فَإِن سَاءَني القَومُ الكِرامُ وَضَيَّعُوا","حُقوقي وَهَديُ المَجدِ فيهِم وَكاهِلُه",65,"ل",2,0],["فإن سهلت فالحمد لله وحده","وإن لجلجت فالزاد أفضلُ حاصل",66,"ل",1,0],["فإن سكنا بيوتا فهيَ مقفرةٌ","أو في المساجد أو في غامض الغرف",67,"ف",1,0],["فانسل عنه وخلّه","فهي العلامة في الشصوص",68,"ص",1,0],["فَإِنَّ سَراةَ الحَيِّ إِن كُنتَ سائِلاً","سُلَيمٌ وَفيهِم مِنهُم مَن تَسَلَّما",69,"م",2,0],["فإن سمحوا بعد القلا لي باللقا","فيا عيش ما احلى ويا قلب ما اهنا",70,"ن",2,0],["فان سمحت يوما به النفس فالمنى","والا فإني واثق منك بالوفا",71,"ف",2,0],["فإن سألوا عني ففي مصر مرقدي","وفوق ثرى بغداد تمرح أهوائي",72,"ي",1,0],["فإن سالموه تصدى لهم","وإن نظموا شملهم بعثرا",73,"ر",2,0],["فَإِن سَلَّت صَوارِمَها الغَوادي","أَفاضَ عَلَيها جَوشَنَها الغَديرُ",74,"ر",1,0],["فإن سَجعتْ هاجتْ لعينيكَ عبرةً","وإنْ زفرتْ هاجَ الهوى قر قريرها",75,"ر",3,0],["فَإِنَّ سِقاطَ الخَمرِ كانَت خَبالَهُ","قَديماً فَلوموا شارِبَ الخَمرِ أَو دَعوا",76,"ع",3,0],["فإن سعت الحساد بي لست جاهلاً","إذاها ومن طبع العقارب لسعها",77,"ع",3,0],["فإن سرتِ يوماً مثلَ زينب تدمُرٍ","فقولي لهم هذا الفتى قائدُ الجند",78,"د",1,0],["فآنس غريبا لابليت بغربة","وأسعده بالتَدريس يا خير مسعد",79,"د",1,0],["فإِن سَرَّكُم أَن لا تَؤوبَ لِقاحُكُم","غِزاراً فَقولوا لِلمُسَيِّبِ يَلحَقِ",80,"ق",1,1],["فاِنسِل إذا رُمت الأدب","إِليه من كُلِّ حَدَب",81,"ب",1,0],["فَإِنَّ سُدورَهُ أَمسى غُروراً","وَحَلَّ بِهِ مُلِمّاتُ الزَوالِ",82,"ل",1,1],["فَأَنِسَ بِها وَاِرقُب لَها مُستَقبَلاً","حَسَناً يَدومُ بِعيشَةٍ مَرضِيَّه",83,"ي",2,0],["فإن ساءلتني عفوا","سأعفوا دون إصرار",84,"ر",1,0],["فإن سألونيَ عمّن أحبّ","أجاب صدىً غائر النبوة",85,"ه",1,0],["فإنْ سَلَكْتَ سَبيلاً كُ