{"poems":[[53,"أعامر لا لليوم أنت ولا الغد","https://www.aldiwan.net/poem30603.html","الطويل"],[63,"بَدَتْ عَقِداتُ الرّمْلِ والجَرَعُ العُفْرُ","https://www.aldiwan.net/poem46213.html","الطويل"],[55,"ألم تعلمي يا فوز أني معذب","https://www.aldiwan.net/poem26544.html","الطويل"],[77,"أعشاق غير الواحد الأحد الباقي","https://www.aldiwan.net/poem35913.html","الطويل"],[77,"إذا كان فوقي من نداك غمامة","https://www.aldiwan.net/poem36018.html","الطويل"],[77,"جهاد هوى لكن بغيري ثوابي","https://www.aldiwan.net/poem36716.html","الطويل"],[73,"أثرت هزبر الشرى إذ ربض","https://www.aldiwan.net/poem11911.html","المتقارب"],[73,"مرادهم حيث السلاح خمائل","https://www.aldiwan.net/poem11930.html","الطويل"],[35,"خليلي هذا ربع عزة فاعقلا","https://www.aldiwan.net/poem39177.html","الطويل"],[10,"إن كنت عن وجدك لم تقصري","https://www.aldiwan.net/poem21081.html","السريع"],[54,"ما كنت أحسب أن الدهر يمهلني","https://www.aldiwan.net/poem27408.html","البسيط"],[83,"معاذ الهوى أن أصحب القلب ساليا","https://www.aldiwan.net/poem54225.html","الطويل"],[83,"سلو البارق النجدي من علمي نجد","https://www.aldiwan.net/poem54324.html","الطويل"],[88,"شب الأسى في قلوب الشعب مستعرا","https://www.aldiwan.net/poem45044.html","البسيط"],[27,"لقد نادى أميرك باحتمال","https://www.aldiwan.net/poem5957.html","الوافر"],[27,"ألا حي المنازل والخياما","https://www.aldiwan.net/poem6017.html","الوافر"],[47,"يا حسرة ما أكاد أحملها","https://www.aldiwan.net/poem25170.html","المنسرح"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[51,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[51,"يا ضارب المثل المزخرف مطريا","https://www.aldiwan.net/poem62844.html","الكامل"],[51,"أنا راع لما صفا منك قدما","https://www.aldiwan.net/poem65699.html","الخفيف"],[51,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[91,"الحشد ملء الدار لكن","https://www.aldiwan.net/poem62804.html","عموديه"],[70,"بدأت ولم أسأل ولم أتوسل","https://www.aldiwan.net/poem42735.html","الطويل"],[62,"إذا لم يعن قول النصيح قبول","https://www.aldiwan.net/poem52321.html","الطويل"],[62,"أفدي التي طرقتني في ولائدها","https://www.aldiwan.net/poem52409.html","البسيط"],[62,"أقول وقد غال الردى من أحبه","https://www.aldiwan.net/poem52429.html","الطويل"],[45,"عدمت مخاريق عبد الرحيم","https://www.aldiwan.net/poem10900.html","المتقارب"],[45,"ملامك إنه عهد قريب","https://www.aldiwan.net/poem11042.html","الوافر"],[45,"ألا ياهبوب الريح بلغ رسالتي","https://www.aldiwan.net/poem62699.html","الطويل"],[61,"محلك مثل الغاب ليس يرام","https://www.aldiwan.net/poem51457.html","الطويل"],[58,"إذا شئت أن تستقرض المال منفقا","https://www.aldiwan.net/poem31072.html","الطويل"],[49,"لأمر ما خلقت فما الغرور","https://www.aldiwan.net/poem62092.html","الوافر"],[66,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[66,"نصحتك فاصغ إلى منطقي","https://www.aldiwan.net/poem38562.html","المتقارب"],[66,"إذا ما تراءت لي محاسن شخصكم","https://www.aldiwan.net/poem40317.html","الطويل"],[80,"أبى الله إلا أن يكون لك النصر","https://www.aldiwan.net/poem31432.html","الطويل"],[44,"نبئت عتبة يعوي كي أشاتمه","https://www.aldiwan.net/poem30053.html","البسيط"],[87,"أقلا ملامي في هوى الشادن الأحوى","https://www.aldiwan.net/poem8196.html","الطويل"],[69,"أأقتل بين جدك والمزاح","https://www.aldiwan.net/poem28551.html","الوافر"],[67,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[48,"قالوا تنسك بعد الحج قلت لهم","https://www.aldiwan.net/poem63255.html","البسيط"],[48,"ألا تأتي القبور صباح يوم","https://www.aldiwan.net/poem63404.html","الوافر"],[48,"آلف ما صدت من القنيص","https://www.aldiwan.net/poem64361.html","الرجز"],[46,"سرينا وطالبنا هاجع","https://www.aldiwan.net/poem22047.html","المتقارب"],[46,"أيا ديك عدت من أياديك صيحة","https://www.aldiwan.net/poem23291.html","الطويل"],[46,"أرادوا الشر وانتظروا إماما","https://www.aldiwan.net/poem23606.html","الوافر"],[76,"كم ألحم السيف في أبناء ملحمة","https://www.aldiwan.net/poem39314.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39606","السريع"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72206","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202534","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54223","البسيط"],[106,"أنا وابناي","https://www.poetsgate.com/ViewPoem.aspx?id=179447",""],[67,"جَنابكِ منه تُسْتَفَادُ الفَوائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13730&r=&rc=6",""]],"verses":[["فَإِن سارَ لِلأَعداءِ غَيرُكَ فَاِربَعي","وَإِن قامَ لِلعَلياءِ غَيرُكَ فَاِقعُدِ",0,"د",1,0],["فإنَّ سُيوفاً أغْمَدَتْها حلومُهُمْ","لَتَفْري طُلى يَلْوي أخادِعَها الكِبْرُ",1,"ر",1,0],["فَإِن ساءَكُم ما بي مِنَ الضُرِّ فَاِرحَموا","وَإِن سَرَّكُم هَذا العَذابُ فَعَذِّبوا",2,"ب",3,0],["فإنْ سَكِرَتْ واستشْرَفَتْ عندَ سُكْرِها","لماهيّةِ السُّقْيا ومعْرِفَةِ السّاقي",3,"ي",1,0],["فَإِنَّ سُمُومَ الْقَيْظِ عِنْدِيَ نَسْمَةٌ","وَإِنَّ هَشِيمَ الْفَقْرِ عِنْدِيَ بُستَانُ",4,"ن",1,0],["فَإِنْ سَجَعَ الرُّكْبَانُ فِيَّ بِمِدْحَةٍ","حَثَتْ في وُجُوهِ الْمَادِحِينَ تُرَابِي",5,"ي",1,0],["فَإِنَّ سُكونَ الشُجاعِ النَهوسِ","لَيسَ بِمانِعِهِ أَن يَعَضّ",6,"ض",1,0],["فَإِن سُتِرَت أَخلاقُهُم بِتَخَلُّقٍ","فَكُلُّ خَضيبٍ لا مَحالَةَ ناصِلُ",7,"ل",1,0],["فَإِنَ سَأَلَ الواشُونَ فِيمَ صَرَمتُها","فَقُل نَفس حُر ّسُلِّيَت فَتَسَلَّتِ",8,"ت",1,0],["فَآنِسَن مِن ساعَةٍ فارِساً","يَخُبُّ أَدنى بُقَعِ المَنظَرِ",9,"ر",1,0],["فَإِن سَمِعتَ لَهُ نَعتَ القَنا عَبَثاً","فَقَد أَرادَ قَناً لَيسَت لَهُ عُقَدُ",10,"د",1,0],["فآنس من تلقائك الملكُ رشدَه","ونال بك الإسلام ما كان راجيا",11,"ي",2,0],["فآنست حتى ما شكوتُ بغربةٍ","وواليتَ حتَّى لَمْ أَجدْ مَضَضَ الفقدِ",12,"د",1,0],["فإن سعدون دانى الشمس منزلةً","وإن سعدا بمصر قارن القمرا",13,"ر",2,0],["فَإِنَّ سُراكِ تَقصُرُ عَن سُرانا","وَعَن وَخدِ المُخَدَّمَةِ العِجالِ",14,"ل",1,0],["فَإِن سَأَلوكَ عَنها فَاِجلُ عَنها","بِما لا شَكَّ فيهِ وَلا خِصاما",15,"م",2,0],["فَإِن سَأَلنا سِواكَ عارِفَةً","فَبَعدَ قَطعِ الرَجاءِ نَسأَلُها",16,"ل",3,0],["فإن سَألتْنِي عنك يوماً عصابةٌ","شهدتُ على نفسي بسوء المناقبِ",17,"ب",1,0],["فإن سقَّينَني صَرَّدْن شُربي","ولم يكُ عن هوىً بل عن خلابِ",18,"ب",1,0],["فإن سمعنا لِمزهر وتراً","حنّ فهاتيك عَوْلة الوترِ",19,"ر",1,0],["فانسَ الحُقود فإنها منسيةٌ","إلا لدى اللؤماء والأشرارِ",20,"ر",1,0],["فانسَ ذكري فإن قلبيَ ناسٍ","لك ما عاقب الغروبُ الشروقا",21,"ق",2,0],["فإنْ سدَّ بابَ العذر فيما نَقِمتَه","هواكَ فلي بالرأي فيه مخارمُ",22,"م",1,0],["فَاِنسَلَّ مِن أَصحابِهِ","سِرّاً وَأَغضَت جارَتاها",23,"ا",3,0],["فَآنَستَني في البُعدِ حَتّى تَرَكتَني","كَأَنِّيَ في أَهلي مُقيمٌ وَمَنزِلي",24,"ي",1,0],["فإنْ سئِمتْ حملَ الرؤوسِ رقابُها","فبالبيضِ شوقٌ نحوَها وغليلُ",25,"ل",1,0],["فإنْ سلمتُ فمَنْ مثلي وإن تكنِ ال","أُخرى فقد نِلْتُ من إِلمامِها وطَرا",26,"ر",2,0],["فانْ سكنتْ نفسي إِلى سكَنٍ لها","سواكِ مدى عُمْري فقد بُؤْتُ بالكُفْرِ",27,"ر",1,0],["فَإِن سَحَبَ اللَيلُ مِن ذَيلِهِ","رَأَيتَهُمُ عُقبَةً عُقبَه",28,"ب",2,0],["فَإِن سِتٌّ وَسُتّونَ اِستَقَلَّت","فَلا كَرَّت بِرَجعَتِها الخُطوبُ",29,"ب",1,0],["فَإِن سَأَلَت عَنّي سُلَيمى فَقُل لَها","بِهِ غُبَّرٌ مِن دائِهِ وَهوَ صالِحُ",30,"ح",1,0],["فإنّ سِجالَ الدهرِ في الناس قبلَكم","ولا عَارَ نقصٌ مؤلِمٌ وتمَامُ",31,"م",1,0],["فَإِن سَمَحَت كُنتَ الغَنيَّ وَإِن أَبَت","فَكُلُّ مَمنوعٍ بَعدَها واسِعُ العُذرِ",32,"ر",1,0],["فَإِنَّ سُكونَها حَرَكٌ يُناجي","كَأَنَّ بُطونَ غائِبِها ظُهورُ",33,"ر",1,0],["فَإِن سَعِدتُ فَمَدحي فيكَ موجِبُهُ","وَإِن شَقَيتُ فَذَنبي موجِبُ النَقَمِ",34,"م",1,0],["فَإِنَّ سُلَيمانَ في مُلكِهِ","وَكُلٌّ بِآرائِهِ يَهتَدي",35,"د",2,0],["فَإِن سَمَحَ الدَهرُ المُشِتُّ بِقُربِكُم","وَأَصلَحَ ما قَد أَفسَدَتهُ يَدُ الهَجرِ",36,"ر",1,0],["فإن سَلِمَ الشطرُ الَّذي لا سلامةٌ","له من ظُبا الهيجا فقد عطِبَ الشطرُ",37,"ر",1,0],["فَإِن سَمِعتَ لَهُ نَعتَ القَنا عَبَثاً","فَقَد أَرادَ قَناً لَيسَت لَها عُقَدُ",38,"د",1,0],["فَإِنْ سَادَ غَيْرِي بِالْجُدُودِ فَإِنَّنِي","بِهِمْ وَبِفَضْلِي رِشْتُ سَهْمِي فَمَا أَشْوَى",39,"و",2,0],["فإنْ سالمتهم سلموا وساموا","وإن حاربْتَهم أضحَوا أضاحي",40,"ح",2,0],["فإنْ ساوَقْتَهُمْ حَرْفاً بحَرْفٍ","فكُلُّ اسْم يَحُطُّوا مِنْهُ سِينا",41,"ن",2,0],["فَإِن سَلِمتُ وَما قَلبي عَلى ثِقَةٍ","مِنَ السَلامَةِ لَم أَسلَم بِبَغذاذا",42,"ذ",2,0],["فَإِنَّ سُكونَها حَرَكٌ تَنادى","كَأَنَّ بُطونَ غائِبِها ظُهورُ",43,"ر",1,0],["فَاِنسَلَّ عَن سُكارِهِ المَمحوصِ","وَاِنقَضَّ يَهوي وَهوَ كَالوَبيصِ",44,"ص",1,0],["فَإِنَّ سُراءَ اللَيالي رَمى","أَوانَ شَبيبَتِنا فَاِنسَرى",45,"ر",2,0],["فَإِن سَكِرَت فَالراحُ فيها كَثيرَةٌ","ذَوارِعُها وَالمُخرَزاتُ الحَتائِمُ",46,"م",1,0],["فَإِن سُمّوا بِأَرقَمَ أَو بِلَيثٍ","فَذِئبِيٌّ أَتاكَ وَعَقرَبِيُّ",47,"ب",2,0],["فَانسابَ ناصِرُ دينِ اللَّهِ يَقْدُمُهُمْ","وحَوْلَه مِنْ جُنُودِ اللَّهِ أَنصارُ",48,"ر",1,0],["فانسَيْ مواعيدَ الهوى واذكري","أيَّ فتىً في الحبِّ لم يُخْدَعِ",49,"ع",1,0],["فآنَسْتُ خَيْلاً بالرُّقَيِّ مُغِيرَةً","سَوابِقُها مِثْلُ القَطا المُتَواتِرِ",50,"ر",1,0],["فانساحت الكتائب انسياحا","أرسلها من يرسل الرياحا",51,"ح",2,0],["فَإِنْ سَمِعْتَ رَنِيناً كُلُّهُ عَجَبٌ","فَالْعُودُ عُودِي وَالأَوْتَار أَوْتَارِي",52,"ر",2,0],["فأنسى عذارى، وأنسى وقاري","و؛سب أَنِّيَ عدت صبيا",53,"ي",2,0],["فإِنَّ سَرَاة َ القَوْمِ منهم عَبيدُهمْ","وإن حروف النطق منها الزوائد",54,"د",1,0]]}