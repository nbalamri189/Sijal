","https://www.poetsgate.com/ViewPoem.aspx?id=203479",""],[5616,"أنا","https://www.poetsgate.com/ViewPoem.aspx?id=205028",""],[5740,"تندغ الخير","https://www.poetsgate.com/ViewPoem.aspx?id=211474",""],[5749,"في رثاء فويتح","https://www.poetsgate.com/ViewPoem.aspx?id=203743",""],[5756,"الاسطورة","https://www.poetsgate.com/ViewPoem.aspx?id=5416",""],[5770,"ليلة العيد","https://www.poetsgate.com/ViewPoem.aspx?id=178358",""],[5845,"خلِّ الغرامَ يصبٍّ دمعهُ دمهُ","https://www.poetsgate.com/ViewPoem.aspx?id=198429",""],[5853,"قطوف الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=175683",""],[5897,"منصة العرفان","https://www.poetsgate.com/ViewPoem.aspx?id=157484",""],[5934,"من وسط لندن لين حي السويدي","https://www.poetsgate.com/ViewPoem.aspx?id=35633",""],[5937,"كي لايحزن الفلاح","https://www.poetsgate.com/ViewPoem.aspx?id=211882",""],[5309,"جذل وقلبي لا يزال عليلا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573525",""],[6170,"دمشق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86030&r=&rc=1",""],[6177,"يُوجِع الموتُ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79068&r=&rc=15",""],[231,"خريف الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79120&r=&rc=6",""],[6204,"إلى صديق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69140&r=&rc=12",""],[6213,"شفرة الذباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76306&r=&rc=54",""],[6238,"أمشي معي...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86774&r=&rc=3",""],[6249,"أفّ !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85663&r=&rc=6",""],[557,"كأن العمر ماكان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69242&r=&rc=148",""]],"verses":[["هانَ عَلى الواجِدِ طَعمُ الكَرى","إِنَّ الفَتى الساهِرَ ما غَمَّضا",0,"ض",2,0],["هانَ ما تَلقاهُ إِلّا خَطبُها","في تُرابٍ مِن بَنيها مُدَّخَر",1,"ر",1,0],["هانَ ما لاقَت عَلَيها","أَن غَدَت مِنكَ فِداءَ",2,"ا",2,0],["هَانَتْ مَعَالِمُ مَاتَ سَيِّدُهَا","وَوَهَتْ دَعَائِمُ مَادَ أَيِّدُهَا",3,"د",3,1],["هَانَتْ نُفُوسُ أُنَاسٍ دُونَ مَا جَمَعَتْ","وَأَيُّ عِزٍّ لَهَا بِالمَالِ إِنْ تَهُنِ",4,"ن",1,0],["هَانَتْ عَلَيْنَا وَإِنْ جَلَّتْ مُصِيبَتُهَا","لَوْ أَنَّ خُطَّابَ ذَاكَ الفَخْرَ غَيْرُهُمُ",5,"م",1,0],["هانَ عَلى ذاتِ الحَشا الخَفّاقِ","ما لَقِيَت نَفسي مِنَ الإِشفاقِ",6,"ق",1,0],["هانَ حماها منذ فارقته","ما أهون الغاب بلا أسده",7,"د",2,0],["هانت عليك اللهى فأضحت","تباع في الناس بالكلام",8,"م",1,0],["هان ذاك الرُّزءُ فيها مثلما","هانَ ما غرَّك من مَطْلَبِها",9,"ب",3,0],["هانتْ على عاذلاتي حسرةٌ صَعَداً","كأنما بفؤادي عندها عَلَز",10,"ز",1,0],["هانَ عَصرُ النِياقِ وَالراكِبيها","عِندَ عَصرِ البُخارِ وَالكَهرُباءِ",11,"ا",2,0],["هانَت مَعاذيري وَضاعَت حِكمَتي","لَمّا سَمِعتُ حِكايَةَ القَلبِ الشَقي",12,"ق",2,0],["هانوا عَلى الدُنيا فَلا نِعَماً","عَرَفَتهُمُ الدُنيا وَلا نِقَما",13,"م",2,0],["هانَت عَلى الصَمصامِ كُلُّ يَراعَةٍ","ما لِليَراعَةِ في الحُروبِ يَدانِ",14,"ن",1,0],["هانَ اليوَراعُ عَلى البَواتِرِ وَالقَنا","ما تَصنَعُ الأَقلامُ بِالمُرّانِ",15,"ن",1,0],["ةانكروا فيك الحادا وزندقة","وعل ما انكروه فيك بهتان",16,"ن",1,0],["هانت عليهم في سبيل رقيهم","مهج مضت مظلومة ودماء",17,"ا",2,0],["هانوا وَكانوا الأَكرَمينَ وَغودِروا","بِالقَفرِ بَعدَ مَنازِلٍ وَدِيارِ",18,"ر",1,0],["هانَ عَلى قَلبِهِ الزَمانُ فَما","يَبينُ فيهِ غَمٌّ وَلا جَذَلُ",19,"ل",1,0],["هان الردى لو أن قلبك دارِ","أأموت مغترباً وصدرُك داري",20,"ي",1,0],["هانَ عَلى تَغلِبَ بِما لَقِيَت","أُختُ بَني المالِكينَ مِن جُشَمِ",21,"م",1,0],["هانَت عَلى كُلِّ شَيءٍ فَهوَ يَسفِكُها","حَتّى المَنازِلُ وَالأَحداجُ وَالإِبِلُ",22,"ل",1,0],["هأنذا أرفعُ آلامَهُ","إلى سماءِ المنقذِ الأعظمِ",23,"م",1,0],["هَانَتْ لِمَيْتَتِهِ الدُّنْيَا وَزَهَّدَنَا","فَرْطُ الأَسَى بَعْدَهُ فِي الْمَاءِ والزَّادِ",24,"د",1,0],["هَانَ قَدْراً فِي النَّاسِ إِنْ عَاشَ أَوْ مَا","تَ وَسَاءَتْ عُقْبَاه يَوْمَ التَّنَادِي",25,"د",2,0],["هانَت عَلَيَّ الحَياةُ لَمّا","فارَقَني مَن بِهِ أباهي",26,"ه",2,0],["هانَ الأَحِبّاءُ عِندي","فَمَن وَصَلتُ صَدَدتُه",27,"ت",2,0],["هانت الخيل على فرسانها","وانطوت تلك السيوف القطع",28,"ع",1,0],["هانت عليكم تراث الكفر واشتعلت","فيكم على بعضكم للبعض أضغان",29,"ن",1,0],["هانت عليك جباه ظلت ترضخها","لطالما رضختها سجدة السحر",30,"ر",1,0],["ها نحن نبني فوق هامة مأرب","وطنا ونبني ألف صرح مرمري",31,"ر",2,0],["ها نحن ثرنا على إذعاننا وعلى","نفوسنا واستثارت أمنا \" اليمن \"",32,"ن",1,0],["هان على تغلب بما لقيت","أخت بني الملكين من جشم",33,"م",1,0],["هان اليراع على البواتر والقنا","ما تصنع الأقلام بالمرّان",34,"ن",1,0],["هان عن شكواي عبدان العصا","أنا أشكو من عهود الحلفاء",35,"ا",2,0],["هان ومحنتي العصماء دامية","راو ومن لوعتي الشمّاء سقياه",36,"ا",2,0],["هانوا وكانوا الأكرمين ، وعودروا","بالقَفْر بعدَ منازلٍ وديار",37,"ر",1,0],["هانَت وَكانَ العز في عَتباتِها","وَتَذَلَلت لِلناس بَعد دَلالِها",38,"ل",3,0],["ها نحن في زمن شؤن رجاله","حرباؤُها ضحكت لها الاكوان",39,"ن",1,0],["هانذير الشيب وافى","اخلص النصح وابلغ",40,"غ",1,0],["ها نحن من اغصانكم عطفا عد","صعب وطوة العيم عن وهن عقد",41,"د",1,0],["ها نحن جيرانه في كل زاوية","من الوجود وإن تبعد أراضينا",42,"ن",2,0],["هانت فلم تحفظ لغير","صغائر الدنيا ذمام",43,"م",1,0],["هَانَ العَوِيصُ لَدَيهُم إِذ تُرِيهِ لَهُم","شَمساً مَصَابِيحُ أفهَامٍ وأذهَانِ",44,"ن",1,0],["هَانَ مَن أُشرِبَ الهَوَى إِنَّ كَأسَ ال","حُبِّ فِيهَا لِشارِبيها إمتِهَانُ",45,"ن",1,0],["هَا نَحْنُ أَبْناءُ الغَرامِ وَهذِهِ","أَجْسامُنا بِرُسُومِها نَتَرَسَّمُ",46,"م",1,0],["هان عليها كلما ابصرت","قبلك من ملك ومن سيرة",47,"ه",1,0],["هأنذا ثاوياً بمضْيعةٍ","ووالدي في ضريحهِ ثاوِ",48,"و",1,1],["هان خطب الموت عند فتى","عقله لا شك يعذله",49,"ل",2,0],["هانَت دُموعُ العَينِ أَن نُقِلَت إلى","تِلكَ السَواكِبُ مِن غُروبِ مَآقِ",50,"ق",1,0],["هان ما فتناه من أيامنا","إنما العيش نعيمٌ يقبل",51,"ل",1,0],["هان خطبُ الجوى عليه فهانت","فاجعات الخطوب بعد الخطوب",52,"ب",1,0],["هان والله في الإقامة والظع","ن وصدق الهوى وفرط الحنان",53,"ن",1,0],["هان لو كان يفتدى بطل","بروح من دونه أو النقد",54,"د",1,0],["هَا نَجْلُكَ الْمُضْطَرُّ حَطَّ بِكُمْ","حِمْلَ الذُُّنُوبِ الْقَاصِمِ الظَّهْرِ",55,"ر",1,0],["هانت صِفاتَ عَظيم القربتين وَما","يأتيه جهل أَبي جهل وَيزعمه",56,"م",2,0],["هانَ الَّذِي عَزَّ وَنِلْتَ الَّذِي","حاوَلْتَهُ مِنْ دَرَكِ الْمَطْلَبِ",57,"ب",1,0],["هانتِ الدنيا عَلَى شارِبها","لا تساوي عنده شروى نقيرِ",58,"ر",1,0],["هانت عليه الحياه","وأرهقته الخطوب",59,"ب",1,1],["هانَتْ مَنِيَّتُه عليه لعزِّه","فأبَى لضَيْمِ الدَّهْرِ أن يتَحَمّلا",60,"ل",2,0],["هانَ الفراقُ عليَّ بعدَ فِراقِكم","والصَّعبُ يسهُلُ عند حَمْلِ الأصعَب",61,"ب",1,0],["هانَ عَلى أَهلِه فَأَمسى","مُدافِعاً بَينَهم معارَك",62,"ك",1,1],["هانَ ياناقَتي عَلَيَّ فَسيري","أَن تَموتي إِذا لَقيتُ الوَليدا",63,"د",2,0],["هأنَذا كما تراني حائرُ","وإن جهِلْتَ ما الأقلُّ فسَلِ",64,"ل",1,0],["ها نحن في هذه الدنيا نرود بها","ريادة العين فيما دق في النظر",65,"ر",1,0],["ها نحن والدُنيا كركب أَيغلت","في منهج منها إِلى الاحراء",66,"ا",2,0],["هان دم لي يعزّ فيكم","يا لِعزيز المرام هَيْنِ",67,"ن",1,0],["هانَ عندي الزمانُ بؤسي ونُعْمى","وتساوي نحسٌ لديَّ وسَعدُ",68,"د",1,0],["هانمٌ قلبه عن البيض والسُّمر","ببيض الظبي وسمر الرماح",69,"ح",1,0],["هان عندي هوانَ شأني من يق","عدُ عني من بعده أو يقوم",70,"م",1,0],["ها نحن مثلك في انتظا","ره يا اخ القلب الخفوق",71,"ق",1,0],["ها نحن آياتُ الإله بخلقه","قدما أرنَّ لمجدنا جلجالا",72,"ل",2,0],["هانت بوادر دمع العين في ملك","يا طال في جوده ما هانت البدر",73,"ر",1,0],["هانت عليه النفس حتى إنه","باع الحياة فلم يجد من يشتري",74,"ر",2,0],["هانت جنايات الزمان بعدما","تمرن الجنب على حباله",75,"ل",2,0],["هانَ السُّهادُ غَراماً فيهِ أَقلَقَني","شَوقاً وَعَزّ الكَرى وَجداً فَلم أَنَمِ",76,"م",1,0],["هانَت عليَّ مَخوفاتُ الخطوبِ فما","أَثْنِي يمينيَ عن قُصْوى مَراقيها",77,"ي",3,0],["هان فلا قَدْرٌ له","مثلُ لفيظٍ من عَجَمْ",78,"م",1,0],["هانَ في مُقلَتي الّذي راقَ فيهِ","فَكَأنَّ الشّباب فيه مشيبُ",79,"ب",1,0],["هانت على قلبهِ الأيَّامُ صاغِرةً","إذ كانَ يعرِف ما في طَيّها دُرِجا",80,"ج",2,0],["هانتْ مَوَدَّةُ مَن أحبَّكَ أوَّلاً","حَتَّى تَراهُ ثابتاً في الآخِرِ",81,"ر",1,0],["هانَ الزمانُ عليهِ لا مُتعَجِبٌ","مما يَرَى فيهِ وليسَ بمُعجَبِ",82,"ب",1,0],["هانَ المَعادُ فما نفسٌ به شُغِلَتْ","عن رَبَّة العُودِ أو عن رَنَّةِ العُودِ",83,"د",1,0],["هانئاً، ينعَمُ في أُملود