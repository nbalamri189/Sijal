{"poems":[[93,"أباعثة المطايا من حديد","https://www.aldiwan.net/poem62788.html","عموديه"],[51,"ألا إنما الإخوان عند الحقائق","https://www.aldiwan.net/poem62188.html","الكامل"],[107,"على الجمر سر فهو السبيل الذي مضى","https://www.aldiwan.net/poem41939.html","الطويل"],[107,"سبيلك في مرضاة ربك يا بشر","https://www.aldiwan.net/poem43572.html","الطويل"],[31,"أحِبُّوا الخيلَ واصطَبروا عليها","https://www.poetsgate.com/ViewPoem.aspx?id=180964",""],[93,"مستشفى تل شيحا","https://www.poetsgate.com/ViewPoem.aspx?id=53339",""],[136,"إلى كم استهيم إلى سعاد","https://www.aldiwan.net/poem54850.html","الطويل"],[164,"عيون مها يجلو ظبا لحظها السحر","https://www.aldiwan.net/poem58953.html","الطويل"],[214,"ألا بالحمى إن جزت يا راكب الوجنا","https://www.aldiwan.net/poem13296.html","الطويل"],[280,"بلنسية يا عذبة الماء والجنى","https://www.aldiwan.net/poem25468.html","الطويل"],[463,"تركتك يا زمان قلى فدعني","https://www.aldiwan.net/poem55826.html","الوافر"],[463,"أعلل فيكِ ببرد النسيمِ","https://www.aldiwan.net/poem55876.html","المتقارب"],[463,"لمن طالعات في السراب أفول","https://www.aldiwan.net/poem55924.html","الطويل"],[463,"دعوها ترد بعد خمس شروعا","https://www.aldiwan.net/poem56122.html","المتقارب"],[463,"بكى النار سترا على الموقد","https://www.aldiwan.net/poem56223.html","المتقارب"],[463,"تظن ليالينا عودا","https://www.aldiwan.net/poem56231.html","المتقارب"],[463,"لمن الحمول بجو ضاحي","https://www.aldiwan.net/poem56255.html","مجزوء الكامل"],[463,"رعى الله في الحاجات كل نجيب","https://www.aldiwan.net/poem56301.html","الطويل"],[591,"رأى الحسن في العشاق ممتثل الأمر","https://www.aldiwan.net/poem17532.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138441",""],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39024","الطويل"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216666",""],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109098","الطويل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111258","الطويل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100885","الوافر"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75975","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199997","المجتث"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204433","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93747","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83631","الطويل"],[4785,"فتى الهيجاء","https://www.poetsgate.com/ViewPoem.aspx?id=129738",""],[3591,"ألم تزالوا على الحسن الذي سلفا","https://www.poetsgate.com/ViewPoem.aspx?id=149466",""],[5121,"لُغَةُ الرَّبِيِع","https://www.poetsgate.com/ViewPoem.aspx?id=68726",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5511,"خطاب لن يصل","https://www.poetsgate.com/ViewPoem.aspx?id=151403",""],[3976,"نعى ناعياً ليلى عشياً فراعني","https://www.poetsgate.com/ViewPoem.aspx?id=186543",""],[5956,"أحبو بلا قدمين نحو حديقتي","https://www.poetsgate.com/ViewPoem.aspx?id=215920",""],[6315,"قَبائلُ النِّسْرِين !! هامشٌ على قرطاسِ المُتَنَبّي ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87575&r=&rc=0",""]],"verses":[["أَحِبّونا كَأَنَّهُمُ ذَوُنا","وَطَنسونا بِلُطفِهِمِ ذَوينا",0,"ن",2,0],["أُحِبّو أَخي في اللَهِ ما صَحَّ دينُهُ","وَأَفرِشُهُ ما يَشتَهي مِن خَلائِقِ",1,"ق",1,0],["أَحَبُّوا الذي أحببتَ من نُورِ ربِّهم","فخاضوا إليه النّار واقتحموا الدَّما",2,"م",2,0],["أحِبُّوا رسولَ اللهِ يا قومُ إنّه","مَحبَّتُه غُنْمٌ ومَرضاتُه ذُخْرُ",3,"ر",1,0],["أحِبُّوا الخيلَ واصطَبروا عليها","فإن العز فيها والجَمَالا",4,"ل",2,1],["أحبّونا كأنّهم ذوونا","وأنسونا بلطفهم ذوينا",5,"ن",2,0],["أُحِبَّ وَصلَها فَتُحِبُّ صَرمِى","وأهوَى قُربَها فَتَرى بِعَادِي",6,"د",2,0],["أحبوك حب العين للعين أختها","وقالوا وقلت الحمد لله الشكر",7,"ر",1,0],["احب وميض البرق من نحو بارق","وعرف الصبا منه اذا ما سرى وهنا",8,"ن",2,0],["أحبُّ وأَقْلَى مِنْكِ حَالاً ومَاضِياً","بِمُوحِشَةٍ أَلوت بِعَهدِ الأَوَانِسِ",9,"س",1,0],["أحبُّوا المالَ فاعتبدوا ملوكا","وما كل العبيد عبيد قِنِّ",10,"ن",1,0],["أحبُّوها وما طلعوا بنوءٍ","يبلِّلها ولا سنحوا بيُمنِ",10,"ن",1,0],["أُحِبُّ ولم يك لي موطنا","لحبِّك نازِحَ تلك الرسومِ",11,"م",1,0],["أحبّوك حب العين مستَرَق الكرى","وللعين عهدٌ بالرقاد طويل",12,"ل",1,0],["أحبُّوا فُرادى ولكنَّهم","على صيحة البين ماتوا جميعا",13,"ع",2,0],["أحبَّ وصان فَورَّى هوىً","أضلَّ وخاف فلم يَنشُد",14,"د",1,0],["أُحبّ وإن أخصبَ الحاضرون","بباديةِ الرمل أن أَخلُدا",15,"د",2,0],["أحبُوك منها كلَّ عي","د بالخريدةِ والرَّداحِ",16,"ح",1,0],["أحبُّوا المعالي وهي مُنِصبةٌ لهم","فما قَنَعوا من وصلها بنصيبِ",17,"ب",1,0],["أُحِبُّ ورُودَ الماءِ يُحْرَسُ بالظُّبَى","وَأَهْوَى ازْدِيارِ الحَيِّ يُمْنَعُ بالسُّمْرِ",18,"ر",1,0],["أحبوا في الفضا الفقر اختيارا","ولو كانوا من الأسر الغنيه",19,"ي",2,0],["أُحِبُّ وَميضَ البرقِ قصْدَ جِهاتِه","وأهْوى نَسِيْمَ الرِّيحِ مِن أجل مَسراهُ",20,"ا",2,0],["أحِبّ وادّي للمحبين طاعه","لكن في حدود العقل والعقل زين",21,"ن",1,0],["أُحبُّ ولكن لا احبُّ أميرة","ولا ذات مجدٍ باذخ يرفع الشانا",22,"ن",2,0],["أحبوا تعاطيها فدانوا نجلها","تبرأ دين الله منهم قد ارتدوا",23,"د",3,0],["أحبُ ولا أهابُ ملامَ واشٍ","ومن ضمنَ العفافَ فلن يَهابا",24,"ب",2,0],["أَحَبُّوا دَناياها فَصارُوا عَبيدَها","وَإِنّي حُرٌّ في اِتِّراكٍ وَإِبغاضِ",25,"ض",1,0],["أحبوهمُ كل عطفي","أنساً ولطفاً وبشرا",26,"ر",2,0],["أحب وأبغض كلا ففي","هواي وبغضي أرى لذتي",27,"ي",1,0],["أحبوه نصف الغنم مني أجرا","وهو قريني شرفاً وقدرا",28,"ر",2,0],["أَحبوا تَقاليد الرِّجال عماية","وَبَعض تَقاليد الرِّجال مَعيب",29,"ب",1,0],["أَحبّ وَأشهى ما يكون ليَ المَدى","أَحبّ إلى نفسي وَأشفى لبلواها",30,"ا",3,0],["أحبوا بعضكم بعضًا وُعظنا","بها ذئبًا فما نجَّت قطيعا",31,"ع",2,0],["أحبّ وقتاً به فارقت طلعتكم","وإن يكن فيه دمعي اخجل الوطفا",32,"ف",2,0],["أَحْبُو بِحِضْنِ الْغُصْنِ كَيْ أَشْتَفَّهُ","فَتَشِفَّ طِفْلِيَ رِقَّةُ الأَرْحَامِ",33,"م",1,0],["أحبوا وقوف الشرع عند أولي التقى","ليخلص من أهل الفساد ويسلما",34,"م",2,0],["أحب... ولكن مَنْ أحِبُّ يصدني","يكلمني.. والشك في فيه يزهر",35,"ر",1,0],["أحب وما بي أن أكون رأيتها","فتؤنقني منها قرى وحدائق",36,"ق",1,0],["أحبو بلا قدمين نحو حديقتي","وكأنني قُمِّصتُ جسمَ حيايا",37,"ا",3,0],["أَحْبُو إلى ضِيقِ السُّؤالِ كَأَنَّني","قَبلَ الحِمَامِ أُنَاكِفُ الأَهدَابَا",38,"ب",2,0]]}