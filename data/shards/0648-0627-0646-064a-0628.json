{"poems":[[65,"أرقت لشوق أضمرته الأضالع","https://www.aldiwan.net/poem45690.html","الطويل"],[65,"سل الدهر عني أي خطب أمارس","https://www.aldiwan.net/poem46145.html","الطويل"],[65,"سرت وظلام الليل ستر على الساري","https://www.aldiwan.net/poem46202.html","الطويل"],[79,"ألا عد عن ذكر الرحيق المفدم","https://www.aldiwan.net/poem36092.html","الطويل"],[79,"إذا أنا لم أوثر هواي على عزمي","https://www.aldiwan.net/poem36126.html","الطويل"],[5,"ألم تر أنني رجل صبور","https://www.aldiwan.net/poem299.html",""],[37,"ويوم الوغى يوم الطعان إذا اكتسى","https://www.aldiwan.net/poem39084.html","الطويل"],[37,"خليلي إن أم الحكيم تحملت","https://www.aldiwan.net/poem39117.html","الطويل"],[95,"يراد من الشباب اليوم جهد","https://www.aldiwan.net/poem11293.html","الوافر"],[95,"برغم المعالي أنك اليوم نائم","https://www.aldiwan.net/poem11390.html","الطويل"],[85,"سلو البارق النجدي من علمي نجد","https://www.aldiwan.net/poem54324.html","الطويل"],[53,"أرى العصفور يعبث بالفخاخ","https://www.aldiwan.net/poem9440.html","الوافر"],[72,"علي وعندي ما تريد من الرضا","https://www.aldiwan.net/poem42844.html","الطويل"],[34,"لا تصرمي يا جمل حبلي","https://www.aldiwan.net/poem27708.html","الطويل"],[91,"وإني أرى بيني وبين جماعة","https://www.aldiwan.net/poem45084.html","الطويل"],[58,"وإني بريء من أخي وانتسابه","https://www.aldiwan.net/poem58533.html","الطويل"],[64,"عليك أقمت أرسال الكلام","https://www.aldiwan.net/poem52266.html","الوافر"],[47,"أفق إن ظلم الدهر غير مفيق","https://www.aldiwan.net/poem65189.html","الطويل"],[30,"أبيت أمني النفس أن سوف نلتقي","https://www.aldiwan.net/poem1234.html",""],[30,"على المتردفات بكل خرق","https://www.aldiwan.net/poem5155.html","الوافر"],[99,"أجل يعلم الحبُّ أني لظاهُ","https://www.aldiwan.net/poem24758.html","المتقارب"],[82,"كفى سيفك الإسلام عادية الكفر","https://www.aldiwan.net/poem31440.html","الطويل"],[46,"أجل أيها الربع الذي خف آهله","https://www.aldiwan.net/poem30388.html","الطويل"],[21,"وإني بليلي والديار التي أرى","https://www.aldiwan.net/poem36181.html","الطويل"],[77,"تقول بنو العباس هل فتحت مصر","https://www.aldiwan.net/poem69083.html","الطويل"],[50,"لقد سرني أن الهلال غدية","https://www.aldiwan.net/poem64429.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85590","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85599","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85592","الطويل"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39493","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54631","الطويل"],[108,"كلب بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179351",""],[111,"معاهدة تذكاري سقتك الغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=102",""],[92,"عاشوراء","https://www.poetsgate.com/ViewPoem.aspx?id=179150",""],[92,"ثورة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=179144",""],[82,"كفى سيفك الإسلام عادية الكُفر","https://www.poetsgate.com/ViewPoem.aspx?id=3242",""],[111,"ألا هل لداعي الله في الأرض سامع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545618",""],[113,"تناهى عنده الأمل","https://www.aldiwan.net/poem16299.html","مجزوء الوافر"],[119,"تركت حبيبي القلب لا عن ملالة","https://www.aldiwan.net/poem40865.html","عموديه"],[119,"هل هداك الله ففاضت عيوننا","https://www.aldiwan.net/poem41255.html","عموديه"],[119,"لقد أكثر الباغي التعدي بقوله","https://www.aldiwan.net/poem42162.html","الطويل"],[119,"لجأت بأعتاب الحبيب ابن هاشم","https://www.aldiwan.net/poem42165.html","الطويل"],[132,"أأحبابنا منكم حياة لنا الوصل","https://www.aldiwan.net/poem50554.html","الطويل"],[139,"سواي بهذه الدنيا يبالي","https://www.aldiwan.net/poem48852.html","الوافر"],[146,"أبى الله إلا أن تجود وتنعما","https://www.aldiwan.net/poem58433.html","الطويل"],[147,"كفى الدين عزا ما قضاه لك الدهر","https://www.aldiwan.net/poem11758.html","الطويل"],[164,"إليك وإلا ضيع الحزم أَهله","https://www.aldiwan.net/poem58774.html","الطويل"],[164,"ما الفخر في الطعن بالعسالة الذبل","https://www.aldiwan.net/poem58998.html","البسيط"],[164,"إذا ابطات عنا من المحسن الحسنى","https://www.aldiwan.net/poem59008.html","الطويل"],[173,"أأسكت عن مولى الورى أم أعاتبه","https://www.aldiwan.net/poem1603.html",""],[190,"ليالي الصبا درت عليك السحائب","https://www.aldiwan.net/poem44142.html","الطويل"],[233,"طوى البين عهد الوصل فهو قصير","https://www.aldiwan.net/poem51114.html","الطويل"],[241,"وقرر ما تحويه منك الأضالع","https://www.aldiwan.net/poem19493.html","الطويل"],[260,"فداؤك نفس عبد أنت مولى","https://www.aldiwan.net/poem48500.html","الوافر"],[263,"لك السعد أسعد يا صبا ما المشام","https://www.aldiwan.net/poem35738.html","الطويل"],[263,"سلام على الملحوظ في القرب والبعد","https://www.aldiwan.net/poem35745.html","الطويل"],[265,"لكل من الدنيا مرام يحده","https://www.aldiwan.net/poem38188.html","الطويل"],[265,"هلما نحييها ربى وربوعا","https://www.aldiwan.net/poem38241.html","الطويل"],[275,"مقيل العاثرين أقل عثارى","https://www.aldiwan.net/poem52134.html","الوافر"],[286,"كفى حزنا أني من الشوق لم أنم","https://www.aldiwan.net/poem32426.html","الطويل"],[301,"لقد آن أن تثني أبي زمامها","https://www.aldiwan.net/poem33176.html","الطويل"],[309,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[309,"إلهي ذنوبي ما علمت وإنني","https://www.aldiwan.net/poem56602.html","الطويل"],[309,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[353,"سواي لميل الحب عنه يفاسخ","https://www.aldiwan.net/poem15565.html","الطويل"],[357,"أشاقك صوت غنا الأورق","https://www.aldiwan.net/poem40020.html","المتقارب"],[357,"تنزه عن بني الدنيا وعاد","https://www.aldiwan.net/poem40384.html","الوافر"],[361,"أنوماً وقد بان الخليط تذوق","https://www.aldiwan.net/poem4159.html","الطويل"],[384,"إذا هب علوي تنفس عن جمر","https://www.aldiwan.net/poem49254.html","الطويل"],[407,"لقد صدرت إلى أعلى مقام","https://www.aldiwan.net/poem33449.html","الوافر"],[407,"أتت وخيول الهم في القلب ترتكض","https://www.aldiwan.net/poem33699.html","الطويل"],[407,"أتسأل عن رحيلي يا بن ودي","https://www.aldiwan.net/poem33966.html","الوافر"],[420,"أينكر معروفنا المنكر","https://www.aldiwan.net/poem54039.html","المتقارب"],[420,"يمينا برب النجم والنجم إذ يسري","https://www.aldiwan.net/poem54085.html","الطويل"],[420,"إذا المجد شادته القنا والصوارم","https://www.aldiwan.net/poem54162.html","الطويل"],[420,"أعادك يا سعد عيد الهوى","https://www.aldiwan.net/poem54181.html","المتقارب"],[443,"أهنيكما ما يهنئ الدين منكما","https://www.aldiwan.net/poem34766.html","الطويل"],[443,"دعي عزمات المستضام تسير","https://www.aldiwan.net/poem34841.html","الطويل"],[445,"عذاب الهوى في قلب من رامه عذب","https://www.aldiwan.net/poem14329.html","الطويل"],[445,"هو الحزن حتى ما يماثله حزن","https://www.aldiwan.net/poem14388.html","الطويل"],[456,"أبا البلاد الذي تسمو البلاد به","https://www.aldiwan.net/poem61352.html","البسيط"],[461,"دعاها معقلة بالعراق","https://www.aldiwan.net/poem56092.html","المتقارب"],[461,"لكل هوى من رائد الحزم رادع","https://www.aldiwan.net/poem56130.html","الطويل"],[461,"من الغادي تحط به وتعلو","https://www.aldiwan.net/poem56250.html","الوافر"],[461,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[464,"إذا المرء لم يستخلص الحزم جنة","https://www.aldiwan.net/poem15140.html","الطويل"],[464,"كأن عقارا خندريسا تضوعت","https://www.aldiwan.net/poem16114.html","الطويل"],[482,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[485,"تبدت معاني الجمع حشو ردائها","https://www.aldiwan.net/poem24496.html","عموديه"],[503,"وآيات ألواح رقمن مع العما","https://www.aldiwan.net/poem37957.html","الطويل"],[516,"إلى الله أشكو عبرة قد أظلت","https://www.aldiwan.net/poem67776.html","الطويل"],[554,"كتمت من أسماء ما كان علن","https://www.aldiwan.net/poem47149.html","الرجز"],[554,"أهاجك ذكر منهم ووساوس","https://www.aldiwan.net/poem47756.html","الطويل"],[554,"أود بأنني أبقى ويبقى","https://www.aldiwan.net/poem47880.html","الوافر"],[554,"ناد امرءا غيب خلف النقا","https://www.aldiwan.net/poem48119.html","السريع"],[578,"أيدفعني الدهر عن مطلبي","https://www.aldiwan.net/poem2750.html","المتقارب"],[578,"تنزه طرفي بين زاه وزاهر","https://www.aldiwan.net/poem3073.html","الطويل"],[590,"أضرب السحر الذي أنت ناظمه","https://www.aldiwan.net/poem11506.html","عموديه"],[861,"","https://poetry.dctabudhabi.ae/diwan/poem/17740","الطويل"],[1062,"","https://poetry.dctabudhabi.ae/diwan/poem/21414","الطويل"]],"verses":[["وإِنّي بما قَرّتْ بِهِ العَينُ مَرَّةً","وإنْ لم يَكُن يُجدي عليَّ لَقانعُ",0,"ع",1,0],["وإني بطَرْفٍ صيغَ للعِزِّ طامِحٌ","إليها وأنْفٍ أُودِعَ الكِبْرَ عاطِسُ",1,"س",1,0],["وإني بِما مَنَّى الخَيالُ لَقانِعٌ","وإنْ لَم يَكُنْ في ذاكَ حَظٌّ لمُخْتارِ",2,"ر",1,0],["وَإِنِّي بِمَا أَوْلَيْتَ بَدْءاً وَعَوْدَةً","وَلاَ مِثْلَ إِهْدَاء الْجَوَادِ الْمُطَهَّمِ",3,"م",1,0],["وَإِنِّي بِنُعْمَاكَ الَّتِي مَلأَتْ يَدِي","فَأَصْبَحْتُ مِنْ إِحْسَانِهَا وَافِرَ الْقَسْمِ",4,"م",1,0],["وَأَنّي بِالذَنائِبِ يَومَ خَوٍّ","مَنَنتُ عَلى حُذَيفَةَ بَعدَ أَسرِ",5,"ر",1,0],["وَإِنّي بِخَيرٍ ما بَقيتَ وَما وَلِي","قَناةَ الهُدى مِنكُم إِمامٌ يُقيمُها",6,"م",3,0],["وَإَنّى بِذي دَورانَ تَلَقَى بِك النَوى","عَلى بَرَدي تَظعانَها فَاِحتِمالَها",7,"ل",3,0],["وَإِنِّي بِاسْمِ إِخْوَانٍ كِرَامٍ","يُفَارِقُهُمْ وَذِكْرَاهُ تُقِيمُ",8,"م",1,0],["وَأَنِّي بلا سَلوَى سِوَى مَا يُعِيدُهُ","لِيَ الفِكْرُ يَقَظَاناً كَأَنِّي حَالِمُ",9,"م",1,0],["وإنِّي بباب الملك حيث عهدتني","مديدُ ظِلالِ الجاه مستحصَف العقدِ",10,"د",1,0],["وأنِّى بالسُّموِّ لذي سَفالٍ","مَسِيخِ الطَّعم من نَفَرٍ مِسَاخِ",11,"خ",1,0],["وَإِنّي بِحُسنِ الظَنِّ فيكَ لَواثِقٌ","وَإِن جَهِدَ الواشي فَقالَ وَحَرَّضا",12,"ض",2,0],["وَإِني بنارٍ أَوقَدَتها بِذي الغَضا","عَلى ما بِعَيني مِن قَذَىً لَبَصِيرُ",13,"ر",1,0],["وإني بهذا إن تأمل منصف","لأسلُكُ نهجاً في الطبيعة قد سُنّا",14,"ن",2,0],["وإِنِّي بَرِيءٌ مِنْ أَخِي وانْتِسَابِهِ","إِلَيَّ إذا أَلْفَيْتُ في طَبْعِهِ بُخْلا",15,"ل",2,1],["وأنّى بالجليَّةِ عن مَرامٍ","ترفَّع صدقُ ذلك عن عِصامِ",16,"م",1,0],["وَإِنّي بَريءٌ مِن وِدادِ أَصادِقٍ","وِدادُهُمُ بِالغَيبِ غَيرُ صَدوقِ",17,"ق",1,0],["وَإِن يَبعَثوها بِالنَجاحِ فَقَد مَشَت","إِلَيكُم عَلى حَوبٍ وَطالَ ثَواؤُها",18,"ا",3,0],["وَأَنّى بِالدَراهِمِ وَهيَ مِنّا","كَرافِعِ راحَتَيهِ إِلى العَبورِ",19,"ر",1,0],["وأني بدوتُ لها في الظلام","فرفّت بأجنحةٍ تضطرب",20,"ب",1,0],["وَإِنِّي بما فَوقَ المُنى مُوقِنٌ","وكم شَرَقٍ لِلَّيثٍ مِن وابِل القطرِ",21,"ر",1,0],["وَإِن يَبنِ حيطاناً عَلَيهِ فَإِنَّما","أُولَئِكَ عُقّالاتُهُ لا مَعاقِلُه",22,"ل",2,0],["وَإِني بِليلي وَالديارُ الَّتي أَرى","لَكالمُبتَلى المُعَنّي بِشَوقٍ موَكَّلِ",23,"ل",1,1],["وأنّى بهذا وهي أعْدَتْ برِقِّهَا","أباكم فإياكم ودعوىً هي الكُفر",24,"ر",1,0],["وَإِنّي بِشَهرِ الصَومِ إِذ بانَ شامِتٌ","وَإِنَّكَ يا شَوّالُ لي لَصَديقُ",25,"ق",1,0],["وإِني بليلى مغرم وهي موطني","وَعلِّي أُقضِّي في غَرامي بها نحبي",26,"ب",2,0],["وإني بشدو العندليب لمغرم","فماذا يثير العندليب إذا شدا",27,"د",2,0],["وإني بمعروفٍ لأَعتز أنه","أَخو ثقة والحر يعتز بالحر",28,"ر",1,0],["وإِنّي بحمد اللَّهِ راجٍ لفضلهِ","ولي من ضمانِ اللَّه خَيرُ ضمانِ",29,"ن",1,0],["وَأَنْ يُبْكِمَ المَوْتُ الأَصَمُّ أَشدَّهُمْ","عَلَى مَنْ عَتَا فِي الأَرْضِ فَصْلَ خِطَابِ",30,"ب",1,0],["وإن يَبُلْ في سرير من أسرَّتكم","شَممْتُو بولَه: مِسْكًا، وكافورا",31,"ر",2,0],["واني بحمد الله فيك لمخلص","ولو خاصمتني في الولاء الخواصم",32,"م",1,0],["وأن يُبتَلى بالأمرِ والنهيِ مُكرَها","وان يَجمع الضِدَّين سُكراً ومِنبَرا",33,"ر",2,0],["وإنّي بَعْدَ اليومِ بالطيش آخذُّ","وإني على حكمٍ الجهالةِ نازل",34,"ل",1,0],["وإني بما فوق المنى منك مُوقِنٌ","وكم شَرَقٍ لليث من وابل القطر",35,"ر",1,0],["وإني بني الانسان في الأرض طائر","على شرك عز الجناحين واقع",36,"ع",1,0],["وَإِني بِالدُعاءِ لَكُم","بِظَهر الغَيب اِبتَهَل",37,"ل",1,0],["واني بفضل الله عد موحد","وايمان قلبي لا يميل الى الشرك",38,"ك",1,0],["واني بحمد الله فرع اصوله","لقد تخذوا بيد الوطيس ملاعبا",39,"ب",2,0],["وإني بأعتاب الرسول محمد","وقوفي وقد أحسنت ظني بفضله",40,"ل",2,0],["وإني بجاه المصطفى لذت في الورى","وأسندت ظهراً قد تواهى بحمله",40,"ل",2,0],["وأني به أحسنت ظني وبحره","بساحله العالي حصول المغانم",41,"م",1,0],["وإنّي بصيرٌ بالزمانِ وأهلهِ","ولستُ أخَا جهلٍ على طُول ما أَبْلُوا",42,"ل",3,0],["وإني باجتياز البيد مغرىً","ولكن عن وصالِ البيضِ سالي",43,"ل",2,0],["وإني بمنثورِ الكلام لعالِمٌ","ولكنَّ الدرّ في أن يُنظَّما",44,"م",2,0],["وَإِنّي بِآمالي لَدَيكَ مُخَيِّمٌ","وَكَم في الوَرى ثاوٍ وَآمالُهُ سُفرُ",45,"ر",1,0],["وأني به أسطو وأرمي وأتقى","فمن ذا يناديني وحبلي حبلهُ",46,"ل",2,0],["وإن يبدل بالاغلال ينزعها","أطواق من بجيد الفارس البطل",47,"ل",1,0],["وإني بحمد الله من جعلت له","يمين ابن إسمعيل من جودها حصنا",48,"ن",2,0],["وَإِنّي بِمَدحي عَن سِواكَ لَراغِبٌ","وَلَو باكَرتني كُلَّ يَومٍ رَغائِبُهْ",49,"ب",2,0],["وإني بحمد الله أنظر عن مدى","بعيد أنثني للخير والخير عازب",50,"ب",1,0],["وإني بتقبيلي لك الأرض والثرى","على كل من فاخرته لفخور",51,"ر",1,0],["وَأَنْ يُبْدِلَ الْفِرْكَ الذِي قَادَ طَبْعَهَا","دَلاَلاُ لِجَيْشِ الْهَمِّ مِنْهُ مَصَارِعُ",52,"ع",1,0],["وأني بين قومٍ ليس فيهم","فتى ينهى إلى الملك اختلالي",53,"ل",2,0],["وإنّي بهذا البحر في المدح سابحٌ","وإن عذل العذّال فيه ولاموا",54,"م",3,0],["وإنّي به كالشمس في الكون أشرقت","وكالسيف ذي الحدّين سلّ من الغمد",55,"د",1,0],["وإني بسم اللَه في طلب العلا","أجد ورائي تارة وأمامي",56,"م",2,0],["واني بحمد اللَه للسر لم اكن","مذيعا وللعهد القديم مضيعا",57,"ع",2,0],["واني بدهر عفت الاك أهله","وان كنت لن أعرى به وأجوعا",57,"ع",2,0],["واني بعت حين عرفت دَهري","خيار بَني الزَمان بلا خيار",58,"ر",1,0],["وَأَنِّيَ بِالشاغورِ ثاوٍ وَمَنزِلُ ال","أَحِبَّةِ قُدّامي لَدى مَسجِدِ القَدَم",59,"م",1,0],["وأَنّي بعد الوصل أَرجو لقاءَها","لِماماً ولكن كَيفَ لي بلمامِها",60,"م",3,0],["وَأن يبلّغهُ من كلّ مكرمةٍ","مَكانةً ما خَطَتها قَبلهُ قدمُ",61,"م",1,0],["وَإِنّي بدار لا أذمّ كبارها","ولكن في الأطفال من لا يهذّبُ",62,"ب",1,0],["وَإِنّي بحمدِ اللّه حسّان مدحكم","وحلفُ مراضيكم وشيعيكم حبّا",63,"ب",2,0],["وَإِنّي بِتَنزيلِ المَحَبّةِ عالِمٌ","وَفي سِرِّ تَأويلِ المَحَبَّةِ راسِخُ",64,"خ",1,0],["وَإِن يَبغِ يَوماً علَيك الجَهولُ","وَيسفَه بِخلقٍ لَه ضيّقِ",65,"ق",1,0],["وَإِن يَبغي الجهول عَليك فاِصبر","فَإِنّ البَغيَ مَصرع كُلّ عادي",66,"د",2,0],["وََإنِّي بِشَيمِ البَرقِ مِن جَانِبِ الحِمَى","وشمّ الصّبا مِن حَرِّه لَخَلِيقُ",67,"ق",1,0],["وَإِني بِحال لَيسَ يُمكن شَرحَها","وَكيفَ تَرى حال المُخَلد في الأَسرِ",68,"ر",1,0],["وإني بالقضا راض وإني","أعد الحبس في المنن الجسام",69,"م",1,0],["وإني بادٍ إن حضرت وإن أنا","بدوت فلا أبدي ولا أتعرض",70,"ض",1,0],["وإني بالضياء أيا لمعالي","ونجل أمامها لحليف وجد",71,"د",1,0],["وإني بالضياء أبي المعالي","ونجل أمامها لحليف وجد",71,"د",1,0],["وإنِّي بأيديكم صارمٌ","يُقَدُّ به الدِّرع والمغْفَرُ",72,"ر",1,0],["وإنِّي بتذكاريك آناً فمثله","صريع مدام لا يفيق من السكر",73,"ر",1,0],["وإنِّي بكم يا آل سعدون شاعر","وها أنا في وادي ثنائك هائم",74,"م",1,0],["وإنِّي بنظمي مديحي له","كمن شرب الرَّاح حتَّى انتشى",75,"ا",1,0],["وأنَّى بِهَا عن كُفْرِها ومَلِيكِها","وبالهائِمِ المُشْتاقِ عَنْها وعَنْكُما",76,"م",2,0],["وأَنِّي بذكراهُ لِهَمِّيَ زاجِرٌ","وأَنِّيَ منهُ للخطوبِ نذِيرُ",77,"ر",1,0],["وإني بحبل المصطفى متمسك","فحشا رسول اللَه أن يقع الجدب",78,"ب",1,0],["وإني بذنبي قد علقت رهانه","عسى عفوك اللَه يفدي به الرهن",79,"ن",1,0],["وأن يبدد عريا لا مجال له","والقطن ينشر أثوابا وأعلاما",80,"م",2,0],["وأني بمضيعةٍ مثلُكم","على الفضل من مثلها يُشفِقُ",81,"ق",1,0],["وإني بعنقي من يد المنِّ مفلتٌ","وما المنُّ في الأعناق إلا جوامعُ",82,"ع",1,0],["وأنِّي بعده بمُنىً ولحظٍ","ينازعني إلى جذلٍ طِماحُ",83,"ح",1,0],["وإني بحبلٍ غيرِ أطنابِ بيته","على بيتِ شِعرٍ ناصح لا أطنِّبُ",84,"ب",1,0],["وإني بشكر العُرف مغري كريمة","لديَّ كثيراتُ النَّدى وقلائلهْ",85,"ل",2,0],["وأن يبذُلَ المعروفِ إِلا تبرُّعاً","إذا اقْتَسرتْ مالَ البخيلِ المسائل",86,"ل",1,0],["وإني باعث الموتى نشورا","بإذن الله تنهض في ازدحام",87,"م",1,0],["وإني بما ترضاه راض لأنني","أسير وشرع الحب يفني أسيرها",88,"ر",3,0],["وإنِّي بكَ اسْتَغْنَيْتُ عن كلِّ حادثٍ","وقُمْتُ إماماً في جَميعِ الطَّوائفِ",89,"ف",1,0],["وإني بها لو لا أماني تغرها","وقد أرجفت هوج المطايا وكلت",90,"ت",1,0],["وَإِنْ يَبِتْ أَديمكمْ ذا لَخَنٍ","فلم يكنْ فينا أديمٌ ذا لَخَنْ",91,"ن",1,0],["وإنّي ببرْحِ الأمر في القوِم ناهضٌ","وأنتَ عن الأمر المُبرِّحِ خانِسُ",92,"س",1,0],["وأنِّي بين أثناءِ الّليالِي","صلاحٌ لا يخالطه فسادُ",93,"د",1,0],["وَإِنْ يَبِتْ في غَيِر ما رَبوةٍ","فَهوَ لَدَى الرّحمَنِ أَعلى الرُّبى",94,"ا",1,0],["وأَنِّي بِه قَد فَخرْتُ الأَنامَ","بفضلِ النِّصابِ مَعَ المَنْصِبِ",95,"ب",1,0],["وإِنِّي بَعْد المدحِ أَنْشُد دَائِباً","خليليَّ إِنِّي لا أَرَى غَيرَ شَاعِر",96,"ر",1,0],["وإني بربع الحب مازلت بارحاً","مقيماً على العهد الذي أنت عالمه",97,"م",2,0],["وإِنّي بَعيدٌ مَحتِدي مِن مَوَدَّتي","وَبَعدَ المَدى في المُحفِظاتِ غَضوبُ",98,"ب",1,0],["وَإِنّي بِما بَينَ الضُلوعِ مِن امرىءٍ","إِذا ما تَنازَعنا الحَديثَ لعارِفُ",99,"ف",1,0]]}