","الطويل"],[4516,"","https://poetry.dctabudhabi.ae/diwan/poem/66912","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139699",""],[4740,"قصة بلا أبطال","https://www.poetsgate.com/ViewPoem.aspx?id=198271",""],[4755,"شاطِئُ الرِّيح","https://www.poetsgate.com/ViewPoem.aspx?id=184069",""],[4859,"جبُّ الغدر","https://www.poetsgate.com/ViewPoem.aspx?id=186772",""],[5005,"مرادي..","https://www.poetsgate.com/ViewPoem.aspx?id=208155",""],[5064,"مقدّمة منسية لشاعر قديم","https://www.poetsgate.com/ViewPoem.aspx?id=199161",""],[5072,"كفى هوساً","https://www.poetsgate.com/ViewPoem.aspx?id=52569",""],[5085,"هواجس شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=188448",""],[5096,"هل ...؟","https://www.poetsgate.com/ViewPoem.aspx?id=206638",""],[5135,"ليالي الشتاء","https://www.poetsgate.com/ViewPoem.aspx?id=208792",""],[5168,"حجتلي شكد عليك","https://www.poetsgate.com/ViewPoem.aspx?id=33617",""],[5191,"جسدًا واحدًا","https://www.poetsgate.com/ViewPoem.aspx?id=211978",""],[5206,"نور العلم","https://www.poetsgate.com/ViewPoem.aspx?id=187397",""],[5232,"ناسِكُ الغزل","https://www.poetsgate.com/ViewPoem.aspx?id=213020",""],[5246,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=187037",""],[5246,"في ربوع العراص المقدسة","https://www.poetsgate.com/ViewPoem.aspx?id=187039",""],[5251,"مع التعايش","https://www.poetsgate.com/ViewPoem.aspx?id=214845",""],[5277,"أوانس الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=185297",""],[5302,"كن لي رفيق الروح","https://www.poetsgate.com/ViewPoem.aspx?id=200552",""],[5302,"تسائلني هيفا","https://www.poetsgate.com/ViewPoem.aspx?id=201269",""],[5338,"أرى أدمعي منها السحائب تستجدي","https://www.poetsgate.com/ViewPoem.aspx?id=187912",""],[592,"فليس بنظم مستقم ولم يكن","https://www.poetsgate.com/ViewPoem.aspx?id=128801",""],[5376,"أناختْ على هجرِ المطايا نجائبي........يا قدس","https://www.poetsgate.com/ViewPoem.aspx?id=188567",""],[5408,"لأنك إنّي","https://www.poetsgate.com/ViewPoem.aspx?id=190763",""],[5431,"يطلُ العيدُ والأوجاعُ حبلى","https://www.poetsgate.com/ViewPoem.aspx?id=189673",""],[5431,"بكل اختلاجات القلوب لعالم ...","https://www.poetsgate.com/ViewPoem.aspx?id=191588",""],[5442,"تقدم قبل الركب دمعي ليبقا","https://www.poetsgate.com/ViewPoem.aspx?id=114760",""],[5491,"أعاتب قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=196727",""],[5616,"صقر","https://www.poetsgate.com/ViewPoem.aspx?id=203326",""],[5628,"رثاء العملاق","https://www.poetsgate.com/ViewPoem.aspx?id=178489",""],[5930,"أراها بكل وجوه المكان","https://www.poetsgate.com/ViewPoem.aspx?id=77443",""],[5956,"شكراً لمن رعى","https://www.poetsgate.com/ViewPoem.aspx?id=183592",""],[5975,"نفى الشوقُ","https://www.poetsgate.com/ViewPoem.aspx?id=53295",""],[5977,"حب طويل الأجل","https://www.poetsgate.com/ViewPoem.aspx?id=213082",""],[5393,"لماذا أتيتَ بهذا الزمانْ ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85467&r=&rc=34",""],[402,"يراد من الشباب اليوم جهد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54080&r=&rc=932",""],[6367,"أشواق حجازية الإيقاع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80598&r=&rc=1",""],[6368,"","https://www.linga.org/varities-articles/NDEwMQ","المضارع"]],"verses":[["وإِنّي بما قَرّتْ بِهِ العَينُ مَرَّةً","وإنْ لم يَكُن يُجدي عليَّ لَقانعُ",0,"ع",1,0],["وإني بطَرْفٍ صيغَ للعِزِّ طامِحٌ","إليها وأنْفٍ أُودِعَ الكِبْرَ عاطِسُ",1,"س",1,0],["وإني بِما مَنَّى الخَيالُ لَقانِعٌ","وإنْ لَم يَكُنْ في ذاكَ حَظٌّ لمُخْتارِ",2,"ر",1,0],["وَإِنِّي بِمَا أَوْلَيْتَ بَدْءاً وَعَوْدَةً","وَلاَ مِثْلَ إِهْدَاء الْجَوَادِ الْمُطَهَّمِ",3,"م",1,0],["وَإِنِّي بِنُعْمَاكَ الَّتِي مَلأَتْ يَدِي","فَأَصْبَحْتُ مِنْ إِحْسَانِهَا وَافِرَ الْقَسْمِ",4,"م",1,0],["وَأَنّي بِالذَنائِبِ يَومَ خَوٍّ","مَنَنتُ عَلى حُذَيفَةَ بَعدَ أَسرِ",5,"ر",1,0],["وَإِنّي بِخَيرٍ ما بَقيتَ وَما وَلِي","قَناةَ الهُدى مِنكُم إِمامٌ يُقيمُها",6,"م",3,0],["وَإَنّى بِذي دَورانَ تَلَقَى بِك النَوى","عَلى بَرَدي تَظعانَها فَاِحتِمالَها",7,"ل",3,0],["وَإِنِّي بِاسْمِ إِخْوَانٍ كِرَامٍ","يُفَارِقُهُمْ وَذِكْرَاهُ تُقِيمُ",8,"م",1,0],["وَأَنِّي بلا سَلوَى سِوَى مَا يُعِيدُهُ","لِيَ الفِكْرُ يَقَظَاناً كَأَنِّي حَالِمُ",9,"م",1,0],["وإنِّي بباب الملك حيث عهدتني","مديدُ ظِلالِ الجاه مستحصَف العقدِ",10,"د",1,0],["وأنِّى بالسُّموِّ لذي سَفالٍ","مَسِيخِ الطَّعم من نَفَرٍ مِسَاخِ",11,"خ",1,0],["وَإِنّي بِحُسنِ الظَنِّ فيكَ لَواثِقٌ","وَإِن جَهِدَ الواشي فَقالَ وَحَرَّضا",12,"ض",2,0],["وَإِني بنارٍ أَوقَدَتها بِذي الغَضا","عَلى ما بِعَيني مِن قَذَىً لَبَصِيرُ",13,"ر",1,0],["وإني بهذا إن تأمل منصف","لأسلُكُ نهجاً في الطبيعة قد سُنّا",14,"ن",2,0],["وإِنِّي بَرِيءٌ مِنْ أَخِي وانْتِسَابِهِ","إِلَيَّ إذا أَلْفَيْتُ في طَبْعِهِ بُخْلا",15,"ل",2,1],["وأنّى بالجليَّةِ عن مَرامٍ","ترفَّع صدقُ ذلك عن عِصامِ",16,"م",1,0],["وَإِنّي بَريءٌ مِن وِدادِ أَصادِقٍ","وِدادُهُمُ بِالغَيبِ غَيرُ صَدوقِ",17,"ق",1,0],["وَإِن يَبعَثوها بِالنَجاحِ فَقَد مَشَت","إِلَيكُم عَلى حَوبٍ وَطالَ ثَواؤُها",18,"ا",3,0],["وَأَنّى بِالدَراهِمِ وَهيَ مِنّا","كَرافِعِ راحَتَيهِ إِلى العَبورِ",19,"ر",1,0],["وأني بدوتُ لها في الظلام","فرفّت بأجنحةٍ تضطرب",20,"ب",1,0],["وَإِنِّي بما فَوقَ المُنى مُوقِنٌ","وكم شَرَقٍ لِلَّيثٍ مِن وابِل القطرِ",21,"ر",1,0],["وَإِن يَبنِ حيطاناً عَلَيهِ فَإِنَّما","أُولَئِكَ عُقّالاتُهُ لا مَعاقِلُه",22,"ل",2,0],["وَإِني بِليلي وَالديارُ الَّتي أَرى","لَكالمُبتَلى المُعَنّي بِشَوقٍ موَكَّلِ",23,"ل",1,1],["وأنّى بهذا وهي أعْدَتْ برِقِّهَا","أباكم فإياكم ودعوىً هي الكُفر",24,"ر",1,0],["وَإِنّي بِشَهرِ الصَومِ إِذ بانَ شامِتٌ","وَإِنَّكَ يا شَوّالُ لي لَصَديقُ",25,"ق",1,0],["وإِني بليلى مغرم وهي موطني","وَعلِّي أُقضِّي في غَرامي بها نحبي",26,"ب",2,0],["وإني بشدو العندليب لمغرم","فماذا يثير العندليب إذا شدا",27,"د",2,0],["وإني بمعروفٍ لأَعتز أنه","أَخو ثقة والحر يعتز بالحر",28,"ر",1,0],["وإِنّي بحمد اللَّهِ راجٍ لفضلهِ","ولي من ضمانِ اللَّه خَيرُ ضمانِ",29,"ن",1,0],["وَأَنْ يُبْكِمَ المَوْتُ الأَصَمُّ أَشدَّهُمْ","عَلَى مَنْ عَتَا فِي الأَرْضِ فَصْلَ خِطَابِ",30,"ب",1,0],["وإن يَبُلْ في سرير من أسرَّتكم","شَممْتُو بولَه: مِسْكًا، وكافورا",31,"ر",2,0],["واني بحمد الله فيك لمخلص","ولو خاصمتني في الولاء الخواصم",32,"م",1,0],["وأن يُبتَلى بالأمرِ والنهيِ مُكرَها","وان يَجمع الضِدَّين سُكراً ومِنبَرا",33,"ر",2,0],["وإنّي بَعْدَ اليومِ بالطيش آخذُّ","وإني على حكمٍ الجهالةِ نازل",34,"ل",1,0],["وإني بما فوق المنى منك مُوقِنٌ","وكم شَرَقٍ لليث من وابل القطر",35,"ر",1,0],["وإني بني الانسان في الأرض طائر","على شرك عز الجناحين واقع",36,"ع",1,0],["وَإِني بِالدُعاءِ لَكُم","بِظَهر الغَيب اِبتَهَل",37,"ل",1,0],["واني بفضل الله عد موحد","وايمان قلبي لا يميل الى الشرك",38,"ك",1,0],["واني بحمد الله فرع اصوله","لقد تخذوا بيد الوطيس ملاعبا",39,"ب",2,0],["وإني بأعتاب الرسول محمد","وقوفي وقد أحسنت ظني بفضله",40,"ل",2,0],["وإني بجاه المصطفى لذت في الورى","وأسندت ظهراً قد تواهى بحمله",40,"ل",2,0],["وأني به أحسنت ظني وبحره","بساحله العالي حصول المغانم",41,"م",1,0],["وإنّي بصيرٌ بالزمانِ وأهلهِ","ولستُ أخَا جهلٍ على طُول ما أَبْلُوا",42,"ل",3,0],["وإني باجتياز البيد مغرىً","ولكن عن وصالِ البيضِ سالي",43,"ل",2,0],["وإني بمنثورِ الكلام لعالِمٌ","ولكنَّ الدرّ في أن يُنظَّما",44,"م",2,0],["وَإِنّي بِآمالي لَدَيكَ مُخَيِّمٌ","وَكَم في الوَرى ثاوٍ وَآمالُهُ سُفرُ",45,"ر",1,0],["وأني به أسطو وأرمي وأتقى","فمن ذا يناديني وحبلي حبلهُ",46,"ل",2,0],["وإن يبدل بالاغلال ينزعها","أطواق من بجيد الفارس البطل",47,"ل",1,0],["وإني بحمد الله من جعلت له","يمين ابن إسمعيل من جودها حصنا",48,"ن",2,0],["وَإِنّي بِمَدحي عَن سِواكَ لَراغِبٌ","وَلَو باكَرتني كُلَّ يَومٍ رَغائِبُهْ",49,"ب",2,0],["وإني بحمد الله أنظر عن مدى","بعيد أنثني للخير والخير عازب",50,"ب",1,0],["وإني بتقبيلي لك الأرض والثرى","على كل من فاخرته لفخور",51,"ر",1,0],["وَأَنْ يُبْدِلَ الْفِرْكَ الذِي قَادَ طَبْعَهَا","دَلاَلاُ لِجَيْشِ الْهَمِّ مِنْهُ مَصَارِعُ",52,"ع",1,0],["وأني بين قومٍ ليس فيهم","فتى ينهى إلى الملك اختلالي",53,"ل",2,0],["وإنّي بهذا البحر في المدح سابحٌ","وإن عذل العذّال فيه ولاموا",54,"م",3,0],["وإنّي به كالشمس في الكون أشرقت","وكالسيف ذي الحدّين سلّ من الغمد",55,"د",1,0],["وإني بسم اللَه في طلب العلا","أجد ورائي تارة وأمامي",56,"م",2,0],["واني بحمد اللَه للسر لم اكن","مذيعا وللعهد القديم مضيعا",57,"ع",2,0],["واني بدهر عفت الاك أهله","وان كنت لن أعرى به وأجوعا",57,"ع",2,0],["واني بعت حين عرفت دَهري","خيار بَني الزَمان بلا خيار",58,"ر",1,0],["وَأَنِّيَ بِالشاغورِ ثاوٍ وَمَنزِلُ ال","أَحِبَّةِ قُدّامي لَدى مَسجِدِ القَدَم",59,"م",1,0],["وأَنّي بعد الوصل أَرجو لقاءَها","لِماماً ولكن كَيفَ لي بلمامِها",60,"م",3,0],["وَأن يبلّغهُ من كلّ مكرمةٍ","مَكانةً ما خَطَتها قَبلهُ قدمُ",61,"م",1,0],["وَإِنّي بدار لا أذمّ كبارها","ولكن في الأطفال من لا يهذّبُ",62,"ب",1,0],["وَإِنّي بحمدِ اللّه حسّان مدحكم","وحلفُ مراضيكم وشيعيكم حبّا",63,"ب",2,0],["وَإِنّي بِتَنزيلِ المَحَبّةِ عالِمٌ","وَفي سِرِّ تَأويلِ المَحَبَّةِ راسِخُ",64,"خ",1,0],["وَإِن يَبغِ يَوماً علَيك الجَهولُ","وَيسفَه بِخلقٍ لَه ضيّقِ",65,"ق",1,0],["وَإِن يَبغي الجهول عَليك فاِصبر","فَإِنّ البَغيَ مَصرع كُلّ عادي",66,"د",2,0],["وََإنِّي بِشَيمِ البَرقِ مِن جَانِبِ الحِمَى","وشمّ الصّبا مِن حَرِّه لَخَلِيقُ",67,"ق",1,0],["وَإِني بِحال لَيسَ يُمكن شَرحَها","وَكيفَ تَرى حال المُخَلد في الأَسرِ",68,"ر",1,0],["وإني بالقضا راض وإني","أعد الحبس في المنن الجسام",69,"م",1,0],["وإني بادٍ إن حضرت وإن أنا","بدوت فلا أبدي ولا أتعرض",70,"ض",1,0],["وإني بالضياء أيا لمعالي","ونجل أمامها لحليف وجد",71,"د",1,0],["وإني بالضياء أبي المعالي","ونجل أمامها لحليف وجد",71,"د",1,0],["وإنِّي بأيديكم صارمٌ","يُقَدُّ به الدِّرع والمغْفَرُ",72,"ر",1,0],["وإنِّي بتذكاريك آناً فمثله","صريع مدام لا يفيق من السكر",73,"ر",1,0],["وإنِّي بكم يا آل سعدون شاعر","وها أنا في وادي ثنائك هائم",74,"م",1,0],["وإنِّي بنظمي مديحي له","كمن شرب الرَّاح حتَّى انتشى",75,"ا",1,0],["وأنَّى بِهَا عن كُفْرِها ومَلِيكِها","وبالهائِمِ المُشْتاقِ عَنْها وعَنْكُما",76,"م",2,0],["وأَنِّي بذكراهُ لِهَمِّيَ زاجِرٌ","وأَنِّيَ منهُ للخطوبِ نذِيرُ",77,"ر",1,0],["وإني بحبل المصطفى متمسك","فحشا رسول اللَه أن يقع الجدب",78,"ب",1,0],["وإني بذنبي قد علقت رهانه","عسى عفوك اللَه يفدي به الرهن",79,"ن",1,0],["وأن يبدد عريا لا مجال له","والقطن ينشر أثوابا وأعلاما",80,"م",2,0],["وأني بمضيعةٍ مثلُكم","على الفضل من مثلها يُشفِقُ",81,"ق",1,0],["وإني بعنقي من يد المنِّ مفلتٌ","وما المنُّ في الأعناق إلا جوامعُ",82,"ع",1,0],["وأنِّي ب