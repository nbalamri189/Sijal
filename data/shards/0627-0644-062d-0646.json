{"poems":[[969,"","https://poetry.dctabudhabi.ae/diwan/poem/145607","الرجز"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75741","الخفيف"],[1470,"","https://poetry.dctabudhabi.ae/diwan/poem/216504","الخفيف"],[1616,"","https://poetry.dctabudhabi.ae/diwan/poem/206238",""],[3830,"","https://poetry.dctabudhabi.ae/diwan/poem/122284","الرجز"],[4875,"جريح الوقت","https://www.poetsgate.com/ViewPoem.aspx?id=135639",""],[1470,"سنرجع يوماً","https://www.poetsgate.com/ViewPoem.aspx?id=12964",""],[5913,"الحنين المكتَّمُ المفضوحُ","https://www.poetsgate.com/ViewPoem.aspx?id=183248",""],[6318,"درّة الأقصى مُحمَّد الدرّة وأبوه جمال الدرّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66165&r=&rc=15",""],[6320,"سَهْمُ العَنَاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84366&r=&rc=63",""]],"verses":[["ألحن في أشعاره من تيس","أعجز في البيت من الضريس",0,"س",1,0],["آل حنّاش الكِرام جواراً","ساحبين الرماح لدناً طوالا",1,"ل",2,0],["الحنين الحنين يضرم فيه","لهبا سعرته نار البعاد",2,"د",1,0],["الحنون الطّيّب البدر المنير","عاش زايد عاش غيثه ومْطره",3,"ر",2,0],["الحنبلي القادري","عبد السلام الشطي",4,"ي",1,0],["الحنظله من دون فلّك وشيحك","كنّي لعسرات المقادير مديون",5,"ن",1,0],["الحنين وما زال بين تلال","وناس الحنين مكان لنا",6,"ن",2,0],["الحنين المكتَّمُ المفضوحُ","والتناهيد كبَّلتها الروحُ",7,"ح",1,1],["الحنانُ الندي ! والأمَلُ الضا","ئعُ ! تيهٌ أمامه ممدودُ",8,"د",1,0],["الحُنْقُ كَانَ لَهُمْ سِمْتاً وَحَيَّرَهُمْ","تَشَبُّثِي فِي حِمَى لَحْدِي بِأَكْفَانِي",9,"ن",2,0]]}