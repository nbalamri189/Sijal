{"poems":[[190,"وليلة حسبت فيها نفسي","https://www.aldiwan.net/poem43726.html","الرجز"],[376,"كيف يطول الدجى علي وقد","https://www.aldiwan.net/poem57438.html","البسيط"],[463,"ذكرت وما وفاي بحيث أنسى","https://www.aldiwan.net/poem56157.html","الوافر"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123168","البسيط"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81289","المنسرح"],[4852,"سؤال الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=214359",""],[5101,"أنثى الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=199686",""]],"verses":[["أدسّه في البندق كل دسي","لسا وفي اللس فناء النفس",0,"س",1,0],["أدسُّ تحتَ الظلام منزلةً","في أختِها من مَنازِلِ القَمَرِ",1,"ر",1,0],["أَدُسْ جبلاً وراء الرزق قالت","وتتركنا فؤادُك منه أقسَى",2,"س",2,0],["أدسّ في فيّ ما أصطاده خشية أن","يزلفط الصيد من كفي إلى جاري",3,"ر",2,0],["أَدس وَجهي مِنهُم وَأَحسَبَني","أَني مشف مِنهُم عَلى الهَرَب",4,"ب",1,0],["أدسُّ الرأس ..-غرساً- في وسادي","وحُلْمي أنْ أُفرّغَ مِن سؤالي ..",5,"ل",2,0],["أدسّ بجيبي جراحَ الثّكالى","فتخرج بُرءا كما الياسمين",6,"ن",1,0]]}