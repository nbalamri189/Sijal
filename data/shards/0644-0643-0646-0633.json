,"","https://poetry.dctabudhabi.ae/diwan/poem/139542",""],[4767,"جرح في مسرح الفن","https://www.poetsgate.com/ViewPoem.aspx?id=190963",""],[4858,"مصر الحبيبة شيعي قتلاك","https://www.poetsgate.com/ViewPoem.aspx?id=144475",""],[4875,"أبغى الإجابة","https://www.poetsgate.com/ViewPoem.aspx?id=132226",""],[4929,"هجاء (لصوص النصوص) مع اعتذاري من القارئ","https://www.poetsgate.com/ViewPoem.aspx?id=202433",""],[4955,"أهلا أخي قد قالها متمسكا","https://www.poetsgate.com/ViewPoem.aspx?id=203744",""],[4999,"ثورةٌ سُرقت","https://www.poetsgate.com/ViewPoem.aspx?id=184279",""],[5032,"كمان اللّيل","https://www.poetsgate.com/ViewPoem.aspx?id=191770",""],[5038,"موطن الأديان","https://www.poetsgate.com/ViewPoem.aspx?id=190108",""],[3591,"لم يبرح الفتك من جفنيك مشتغلا","https://www.poetsgate.com/ViewPoem.aspx?id=149457",""],[5145,"ويح المعالي فقد شالت نعامتها","https://www.poetsgate.com/ViewPoem.aspx?id=108050",""],[5296,"لك السلام","https://www.poetsgate.com/ViewPoem.aspx?id=154776",""],[5365,"أشواق","https://www.poetsgate.com/ViewPoem.aspx?id=191264",""],[5431,"نسخة!!....","https://www.poetsgate.com/ViewPoem.aspx?id=203154",""],[5431,"قلبٌ من الحلوى ..لحبيبي رسول الله (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=206463",""],[5457,"يا رب نوِّرْ لي الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=213115",""],[5493,". القربان .","https://www.poetsgate.com/ViewPoem.aspx?id=197410",""],[5512,"خلف السواتر ..قمحانة","https://www.poetsgate.com/ViewPoem.aspx?id=204501",""],[5582,"كَلِفٌ شَجَتْهُ عَشِيَّةً أَوْطانُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=63586",""],[5628,"رثاء صديق","https://www.poetsgate.com/ViewPoem.aspx?id=178672",""],[5685,"في رثاء زايد الخير","https://www.poetsgate.com/ViewPoem.aspx?id=34735",""],[5691,"أنَا والدجى","https://www.poetsgate.com/ViewPoem.aspx?id=206743",""],[5739,"عظم ومفاصل","https://www.poetsgate.com/ViewPoem.aspx?id=126711",""],[5842,"إشراقات الأمل / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=105051",""],[5956,"سمراء خلف وقارِها","https://www.poetsgate.com/ViewPoem.aspx?id=182456",""],[5956,"أَمَرَ البصيرُ نبيَّه","https://www.poetsgate.com/ViewPoem.aspx?id=192631",""],[5956,"أصدقاء خالد مظلوم يسائلونه:","https://www.poetsgate.com/ViewPoem.aspx?id=201899",""],[6004,"الخَطِيئة","https://www.poetsgate.com/ViewPoem.aspx?id=59138",""],[6093,"وجه فكري","https://www.poetsgate.com/ViewPoem.aspx?id=180535",""],[6327,"لامية الهمج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86571&r=&rc=6",""]],"verses":[["لَكِنَّ سُلطانَ اللَيالي غالِبٌ","عَزمي وَقَطّاعٌ عَلَيَّ سَبيلي",0,"ل",2,0],["لَكِن سَيَخلُفُ عَقرَها وَدِماءَها","أَبَدَ اللَيالي مَدمَعي وَبُكاؤُهُ",1,"ا",3,0],["لَكِن سَيَأتيكَ ما يُجَوِّزُهُ","سَروُكَ دَأبَ المُسامِحِ اليَسَرِ",2,"ر",1,0],["لَكِن سِهامُ المَنايا مَن تُصِبهُ بِها","لا يَشفِهِ رِفقُ ذي طِبٍّ وَلا راقِ",3,"ق",1,0],["لكن سلكت طريق العلم مجتهداً","تهدي به من جميع الناس ضّلالا",4,"ل",2,0],["لَكِن سَوادَةُ يَجلو مُقلَتَي لَحمٍ","بازٍ يُصَرصِرُ فَوقَ المَرقَبِ العالي",5,"ل",2,0],["لَكِنَّ سَيفَ الدَولَةِ المَولى الَّذي","لَم أَنسَهُ وَأَراهُ لايَنساني",6,"ن",2,0],["لَكِن سَأَصرِفُها جُهدي وَأَعدِلُها","عَنكُم بِقَولٍ رَصينٍ غَيرِ تَهديدِ",7,"د",1,0],["لَكِن سَبَقتَ وَكُلُّ طولِ سَلامَةٍ","قَدَرٌ وَكُلُّ مَنِيَّةٍ بِقَضاءِ",8,"ا",2,0],["لَكِن سَبقت بِها فَما لمقصّرٍ","سَبَب لمعذرة به يتعلّق",9,"ق",1,0],["لكِنّ سيّدَنَا الأعلى وسيّدكم","على المُلوكِ إذا قِيستْ به سُوَق",10,"ق",1,0],["لكن سكتَّ فقيلَ إنَّك عاجزٌ","عن ردِّ عادية ودفعِ بلاءِ",11,"ا",2,0],["لكن سهرتَ على السَّلا","م، وبات ينعم في كراه",12,"ا",2,0],["لكن سر العلم في نفسه","كالعسل الصافي خبيث الوعا",13,"ع",2,0],["لكن سيخلف عقرها ودماؤها","أبَدَ اللّيَالي، مَدْمَعي وَبُكاؤهُ",14,"ا",3,0],["لكن سقم الفهم لم تنكشف","أربابه عن وصفها الكاشف",15,"ف",1,0],["لكن سنصبر للبلوى على مضضٍ","ونستعيذُ من الأرزاء والنُوَبِ",16,"ب",1,0],["لكنّ سمعِى قاء ما قاله","كأنه بالصاب قد مُضمِضا",17,"ض",2,0],["لكنّ سرّك أَن يفرَّ بنفسه","حتى تطاردَه الخيولُ كما ترى",18,"ر",2,0],["لَكِنْ سَلَكْتَ سَبِيلَ مَنْ","نَبَذَ الْوَفَاءَ وَمَا احْتَفَلْ",19,"ل",1,0],["لَكِن سَجَدتُ عَلى آثارِ أَخمصِهِ","أُقَبِّلُ النَعلَ إِكراماً لِما فيها",20,"ي",3,0],["لكن سيف اللحظ من جفنه","أمضى من الصمصام في فتكته",21,"ت",2,0],["لَكِن سَيِّدَنا بِالنَفسِ حازَ غِنى","وَكَيفَ تَدعو إِلى الدُنيا ضَرورَةَ مِنِ",22,"ن",1,0],["لكنْ سوانحُ وحْشٍ من بَوارحِها","مَيّزْتُها فجلتْ لي يُمْنَ مُرتَحَل",23,"ل",1,0],["لكنْ سلوا عنها الذين تحمَّلوا","عبئاً ولم يستوعبوا الإنذارا",24,"ر",2,0],["لكنْ سلوا مَنْ يغسلون ثيابهم","بالعطر، كيف تجاوزوا المقدارا",24,"ر",2,0],["لكنَّ سقبَ المنايا وسطَ جمعِهِمُ","رَغا فخَرُّوا على الأذْقان إِذْعانا",25,"ن",2,0],["لكنْ سديدُك منّاني فأخْلفَني","فأسهُمي نحوَهُ لم تأتِ تسديدا",26,"د",2,0],["لكن سهامٌ من الأقدارِ ما بَرِحَتْ","على مَراصِدِ ذاك الماء تَرْميني",27,"ن",2,0],["لكن سميت بنقض ما اسّته","فعليك سعيك بالضرة عادا",28,"د",2,0],["لكن سأستغفر التاريخ إن جرحت","أوجاعنا فيه جرحا ليس يندمل",29,"ل",1,0],["لكن سَبَقَتُ به الثراءَ ففاتَني","وعَجِلَتُ قَبْلَ المالِ بالأوْلادِ",30,"د",1,0],["لَكِن سَأَشكرُهُم عَلى طُولِ البَقا","حتَّى يُغَيَّبَ في الثَّرى جُثمانِي",31,"ن",2,0],["لَكِن سَطَوتُ عَلى القَريضِ بِأَسرِهِ","وَغَدَوتُ أَعذَبَ مَنهَلٍ لِلخاطِرِ",32,"ر",1,0],["لكنّ سبطَ محمّد","قد باتَ محزوزَ الوريدِ",33,"د",1,0],["لكن سيبقى وجه","هذي الأرض غالي",34,"ل",2,0],["لَكن سَأَسلو عاجِلاً","وَأَسدّ هَذا الباب بَعدَك",35,"ك",1,0],["لكنْ سمعتُ عن السّديدِ وفعلِه","فأتيتُه لأريهِ كيفَ أقولُ",36,"ل",1,0],["لكن سمع اسمه العزيز إذا","ما غاب عني يغني عن النظر",37,"ر",1,0],["لكِن سَأَبنيها فَلا تَشمَتي","نَعَم سَأَبنيها وَأُعلي البِناءْ",38,"ا",2,0],["لكن سعى الواشي ففرق بيننا","فعليه دائرة دائرة البوار تدور",39,"ر",1,0],["لكن ستر القبر لا يرفعُ","وأنت من مثواك لا تطلعُ",40,"ع",1,0],["لكن سهم القرب خاط طائش","ولقد تنال العين إلا المحجرا",41,"ر",2,0],["لَكِنْ سُلَيمَانُ المُعّوَّذُ بِاسْمِهِ","سَبَقَ النِّداء إلى النِّزَالِ سَرِيرَا",42,"ر",2,0],["لكن سواء لمتني او لم","تلم فلا تلم اذا او لم",43,"م",1,0],["لكن سقى عبساً وأشجع بعدها","بالرمث والأرطى مجاج الأرقم",44,"م",1,0],["لَكِن سوقَتَهُم يَسُبُّ ال","مَرءُ إِمَّ غَريمِهِ",45,"م",2,0],["لكن سأرفع أمري لامرء ضربت","له مساعيه روق العز لا النمطا",46,"ط",2,0],["لكن سفيان لم يكن وكلا","لما أتتنا صلاته سلسه",47,"س",2,0],["لكن سَمِعنا خَبَراً ظريفَا","من خَابرٍ ذي فطنةٍ ظريفا",48,"ف",2,0],["لكن سطح الماء غر رجالنا","من دون أن غاصوا إلى الأعماق",49,"ق",1,0],["لكِنَّ سُهَيَّةَ تَدري أَنَّني رَجُلٌ","عَلى عُرَيجاءَ لَمّا اِحتُلَّت الأَزُرُ",50,"ر",1,1],["لكن سأعييها ولا أرثي لها","فكأنّ في إعيائها إحياءَها",51,"ه",2,0],["لكن سعيك في المكارم عادة","لاحت عليه دلائل الخيرات",52,"ت",1,0],["لكن سجيّةُ نفس منك قد كرُمت","لتغنم الشّكر والمحظوظ من شكرا",53,"ر",2,0],["لكن سماحاً فماذا","شاءته ذات الخضاب",54,"ب",1,0],["لَكِن سهامُ المَنايا مَن نصبنَ له","لَم ينجهِ طبّ ذي طبٍّ ولا راقِ",55,"ق",1,0],["لكن سابح فكرتي","في زاخر التأريخ يغرق",56,"ق",1,0],["لكن سعد الدين مد يداً لنا","فالقلب فاز مظفراً بنجاته",57,"ت",2,0],["لَكَ نسبة علوية نَبَوية","غَراء فَالعَلياء مِن أَحجالها",58,"ا",1,0],["لَكِن سَتَرتَ مَعايبي وَمَثالي","وَحَلمتَ عَن سَقَطي وَعَن طُغياني",59,"ن",2,0],["لكن سُرعَةَ بُرءِها سَهلٌ على ال","نَدبِ الحَزومِ وذا قياسٌ جارِ",60,"ر",1,0],["لَكن سُعود الحَظ عَبد مَليكنا","وَلذاك أَسعد طالع وَظروف",61,"ف",1,0],["لكن سليمانُ لم يشعر بهدهدِه","حتى على جسدٍ واعتز ملك سبا",62,"ب",2,0],["لكن سيمنعك العدو","المستبد إذا قدر",63,"ر",1,0],["لكن سليمان أفضاها إلى عمر","أكرم به من إمام تابع السلفا",64,"ف",2,0],["لكن سلي اللَه مغيث الورى","أن يحيي الأرض بوبل الغمام",65,"م",1,0],["لكن سبقناه إلى المقصودِ","وجاء بعدنا مع الوفودِ",66,"د",1,0],["لَكِنَّ سِيمَتَهُم عَلَيهِ بَادِيَةٌ","تُبِينُ أنَّهُ فَرعٌ مِنهُمُ نَاءَ",67,"ا",2,0],["لَكِنَّ سَاقَهُ لَم يَكُن بِهَا تَرَف","فَقُلتُ الآنَ كَمَالُ الشِّبهِ قَد ثَبَتَا",68,"ت",2,0],["لكن سيكسوك الرَبيع من الزهور اذا اتى","اما انا واحرقتني فَجَميع ايامي شتا",69,"ت",2,0],["لكنْ سُوَيْدَاء قلبِ عاشقِهِ","طَفَتْ على نارِ ورْدَةِ الخَجَلِ",70,"ل",1,0],["لكن سأروي غلة الحداد","حين بعيد العود للبلاد",71,"د",1,0],["لكن سلاح سرفدون نهدي","إلى كليهما شعار مجد",72,"د",1,0],["لكِنَّ سابِقَة الأَيدي عَلي لَكُم","تَستَوجِب الشُكرَ أَعظَمُ لي بِها سَبَبا",73,"ب",2,0],["لَكِن سَأَلتَكِ بِالحُب الَّذي وَشَجت","عُروقُهُ في حَنايا قَلب مَفتونِكْ",74,"ك",1,0],["لكن سلمى لاح بارقه...","فكان من سحب جفني عارض يدق",75,"ق",1,0],["لكن سررنا مذ أتى تاريخه","قد خلد الحسين في الجنان",76,"ن",1,0],["لكن سيرجعنا ويجمعنا غداً","رب إليه كل شيء آيب",77,"ب",1,0],["لَكِن سَباني مِنكُمُ شادِنٌ","مُرَبَّبٌ ذو غُنَّةٍ أَدعَجُ",78,"ج",1,0],["لكن سكرت براح من لواحظه","فما أفقت بغير الراح من فيه",79,"ف",3,0],["لكِن سَهَوت فَشِمتُ في سنة الكرى","بَرقَ الحمى العالي أجلّ مكانِ",80,"ن",1,0],["لكن سحاب الدمع قد أمطرت","عليه في كلِّ ثرىً صٍّيبا",81,"ب",2,0],["لكنَّ سهمَ الموت فينا صائبٌ","ما رُدَّ عن نفس دنَت ما أقبلا",82,"ل",2,0],["لكنّ سيسيَّ \" الخيانة قد أبى","وجهاً لمصرَ مجدّداً لعلاك",83,"ك",1,0],["لكن سؤال بداخلي يوقد النار","ضمن أسئله قامت بصدري تشاجر",84,"ر",1,0],["لكنَّ سرْقَ الفكر ِ جرمٌ فعلُهُ","في خانة ِ التبريرِ غيرُ مُصَنّفِ",85,"ف",1,0],["لكنَّ سفَّاحَ المساجدِ لم يكن","يرضى بإحسانٍ على الإحسانِ",86,"ن",1,0],["لكن سنكملُ والذي رفعَ السماء","وسَنستعيدُ النصر والأمجادِ.",87,"د",1,0],["لكنّ سُكّاني جراحٌ كُلّها","إلاّ أنا مِنْ بَينها الإنسانُ",88,"ن",1,0],["لكنْ سؤالاً كانَ حيّرَني","هلّا أجابتْ قالةُ الْفطَنِ",89,"ن",1,0],["لكن سيحويك عن قربٍ جوٍ حدث","في حبّ عينيك ما أبلى أقلّ بلا",90,"ل",2,0],["لكن سقته من الرحمن مغفرة","سحّ هواطلها، رخو عز إليها",91,"ي",3,0],["لكنْ سِلاحكَ ما تَرَكْتَ ليعلموا","أنَّ الرصاصةَ للحروبِ نداءُ",92,"ا",2,0],["لكنّ سَهماً رمى من لحظهِ عَجِلاً","فسال َبوحي على خدّيّ فيضَ ندى",93,"د",2,0],["لكنْ سيبقى الروض مزدهرا","وتضيعُ كلّ فسيلةٍ نُسخة!",94,"خ",2,0],["لكنْ ستمحقُ هذا الليل صحوتنا","إنّ الصحائف رغم الجهل لن تُطوى",95,"و",2,0],["لكن سأسعى رغم حزني جاهدًا","حتى وإن أملي هناك َ تبخرا!",96,"ر",2,0],["لكنَّ سيفَ الغدرِ ثاوٍ بينهمْ","عقروا القطيعَ لأنّهُ قرْبانُ",97,"ن",1,0],["لكنَّ ساترَها منيعٌ مُحْكَمٌ","فَبِرُوحِ حَيْدَرَ والدِّما مسكونُ",98,"ن",1,0],["لكِنْ سَحابُ نَداكَ يَهْمَعُ وَدْقُهُ","ساماً وَيَمْزُجُ سامَهُ عِقْيانُهُ",99,"ن",2,0],["لكنَّ سهْما رماني قدْ أضافَ إلى","تلكَ الجراحاتِ جرحا فوقَ ما أسَعُ",100,"ع",1,0],["لكن َّ سَلْوَتها \" خليفة ٌ \" علمتْ","أنْ آلَ نهيان فوق النجم مشيُهُم",101,"م",1,0],["لكن سأبقى ساهراً مَعَكمْ","حتى يبدِّدَ ظلْمتي السَّحَرُ",102,"ر",1,0],["لكن سؤالي أنت بالله وين أنت.؟","ماعاد اشوفك للوصل صرت واصل.!",103,"ل",1,0],["لكنّ سيف العدل كان مكبلاً","ومضيّعاً تلهو به الأقدار",104,"ر",1,0],["لكنْ سأبقى أنزوي","مع طيفها بجوارِها",105,"ر",3,0],["لكنَّ سيدنا المفدىَ لم يكنْ","ذا خيفةٍ منهم، وفيه مضاءُ",106,"ا",2,0],["لكن سيف الفصلِ عاد يجزنا","عن بعضنا بالرغمِ من كل العُرى",107,"ر",2,0],["لَكِنْ سَقَاهَا البَينُ منْ غَوَائِلٍ","وَالحُزْنُ أَدمَى العُودَ خَرَّ وَاهِيَا",108,"ي",2,0],["لكنْ سأسعى في طريق نَبَاهَةٍ","فالشِّعْرُ للتَّخْلِيْدِ_حَقَّاً_ قَدْ خُلِقْ",109,"ق",1,0],["لكنَّ سَيِّدَها - والكأسُ مُترعَةٌ -","ضَحَّى بِألفٍ من الزُّعرانِ والهَمَلِ",110,"ل",1,0]]}