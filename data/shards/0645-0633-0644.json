spx?id=201748",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5431,"قنطار شوق زرعت الروح ياحمص","https://www.poetsgate.com/ViewPoem.aspx?id=192391",""],[5431,"سنة الله نصره والتلاقي","https://www.poetsgate.com/ViewPoem.aspx?id=198541",""],[5431,"واعتصموا بحبل الله ...","https://www.poetsgate.com/ViewPoem.aspx?id=206863",""],[5436,"فجّر الثورة ( أيمن أحمد رؤوف القادري )","https://www.poetsgate.com/ViewPoem.aspx?id=35273",""],[5464,"كُتِبَ الوفاءُ عليَّ دون إرادتي","https://www.poetsgate.com/ViewPoem.aspx?id=125405",""],[5616,"نحنُ إِسْلامُنَا عَظِيمٌ عَظِيمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=205223",""],[5847,"ألم وأمل","https://www.poetsgate.com/ViewPoem.aspx?id=6444",""],[6019,"حروفٌ أسكرها الألمُ","https://www.poetsgate.com/ViewPoem.aspx?id=180144",""],[6290,"فَأَيّامُنَا تَغْدُو جَمِيعًا نُفَمْبَرًا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85153&r=&rc=18",""],[6318,"القدس في خطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66164&r=&rc=14",""]],"verses":[["مُسَلسَلَةً حافاتُهُ في لَطافَةٍ","وَفي نَقشِهِ يا أُذنَ فَوزٍ تَسَمَّعي",0,"ع",2,0],["مَسلَمُ جَرّارُ الجُيوشِ إِلى العِدى","كَما قادَ أَصحابَ السَفينَةِ نوحُ",1,"ح",1,1],["مسلسل الدمع أسير الفؤاد","يهيم بالتذكار في ألف واد",2,"د",1,1],["مسلسلٌ من حديث الدمع مذروف","ينبيك أنَّ حديث الصبر مصروف",3,"ف",1,1],["مُسلِّطين على الأحرار فُحشَهمُ","وناكلين عن القوم المفاحيش",4,"ش",1,0],["مُسَلَّمَ النفسِ والأحبابِ من مِحنٍ","تكدِّرُ العيشَ أحياناً ومن فِتنِ",5,"ن",1,0],["مُسلي الحَزينِ يَفُكُّهُ مِن حُزنِهِ","وَيَرُدُّهُ لِلَّهِ وَهوَ قَريرُ",6,"ر",1,0],["مُسَلَّطَةٌ لَم يَتَّإِر لِوُقُوعِها","بِساعٍ وَلَم يُنجَد عَلَيها بِناصِرِ",7,"ر",1,0],["مُسَلِّمٌ وسباعُ الطَّيرِ حائمةٌ","يخطَفْن ما طارَ في الآفاقِ أو سَرَبا",8,"ب",2,0],["مُسلِمَةً أَكفالَ خَيلي في الوَغى","وَمَكلومَةً لِبانُها وَنُحورُها",9,"ر",3,0],["مُسَلَّطٌ حَيثُ لا سُلطانَ لي وَيَدي","مَغلولَةُ النَفعِ وَالسُلطانُ سُلطاني",10,"ن",2,0],["مُسَلَّطٌ لا أَذُمُّ قُدرَتَهُ","وَظالِمٌ أَشكُرُ الَّذي فَعَلا",11,"ل",2,0],["مُسَلِّمِينَ إِليهِ عِندَ حَجِّهِمِ","لَم يَبتَغوا بِثَوابِ اللَهِ أَثمانا",12,"ن",2,0],["مُسلِمِيٌّ تَنجابُ عَن وَجهِهِ الحَر","بُ نَصيراً كَالهِبرِزِيِّ النَصيرِ",13,"ر",1,0],["مُسْلِماً رأسكَ الحزينَ إلى الفك","رِ وللسهدِ ذابلاتِ جفونِكْ",14,"ك",1,0],["مُسَلَّطٌ في الْوَرَى فَلا عَجَمٌ","يَبْقَى عَلَى فَتْكِهِ وَلا عَرَبُ",15,"ب",1,0],["مُسَلَّطُ البأسِ على أعدائِه","ومُؤثِرُ الجُودِ على الأمرِ المُهِمّ",16,"م",1,0],["مُسَلَّطَةٌ لمْ يتئر لوُقُوعِها","بِساعٍ، وَلَمْ يُنْجَدْ عَلَيْها بِنَاصِرِ",17,"ر",1,0],["مسلوب كل بكم واله","يحق للولهان ان يسلبا",18,"ب",2,0],["مُسلَّمُ للراجينَ يُمناهُ جَنَّة","ونار على أعدائِه تَتَسَعَّرُ",19,"ر",1,1],["مُسَلَّطٌ عَلى القُلو","بِ ما يُبالي ما اِجتَرَح",20,"ح",1,0],["مسلّماً ما فاح معطارُ القبولْ","وما بدت شمول ألطاف الشمولْ",21,"ل",1,0],["مسلماً في اعتقاده عالميّا","في هواه المجنّح العاطفات",22,"ت",1,0],["مسلَّمةٌ من عيب لولا قمشترٍ","يحصلها بالروح منه مصيب",23,"ب",1,0],["مَسلَكاً لا يَزالُ صَعباً على السا","لِكِ لكنَّهُ لكُم مُستَقِيمُ",24,"م",1,0],["مسلح بالراي ليس يفوته","في كل معضلة جواب سؤالها",25,"ل",3,0],["مُسلَّطة العيون على قُلوب","مؤَيَّدة الفُتون على حُلوم",26,"م",1,0],["مسلسل من صلب آدم نوره","أكرم بنور واضح متسلسل",27,"ل",1,0],["مسلَّمةٍ مِن كلَّ عيبٍ يَشينُها","مبرّأةٍ مِن وصمةِ المنطقِ البذي",28,"ذ",2,0],["مسلم الأمر تفويضا لخالقه","يرجو النجاة لأن الدهر ذو عبر",29,"ر",1,0],["مسلم أتحمس","في اعتقادي مكين",30,"ن",1,0],["مُسلِّمٍ مُحَوْقِلٍ","مُحَمْدِلٍ مُبَسْمِلِ",31,"ل",1,0],["مُسَلْسَلٌ من صَميمِ الآلِ أنْجَبَهُ","من عترةِ الهاشميِّ الطُّهْرِ أطهارُ",32,"ر",1,0],["مُسَلِّماً مُصَلِّيا","عَلَى رَئيسِ الأَنْبِيا",33,"ي",2,0],["مُسَلَّبِينَ كأنّ البعثَ أعَجَلهمْ","فَاِستَصحبوا من بطونِ الأرضِ أكفانا",34,"ن",2,0],["مسلسل دائر في كل ناهية","من حيث أبداه كشفا غير محتشم",35,"م",1,0],["مَسلمَ يا مسلحة الحروبِ","انت المصفىّ من اذى العيوب",36,"ب",1,1],["مسلماً عشت لا لإسلام أمي","وأبي والأمير والسلطان",37,"ن",1,0],["مُسَلِّينا ووامقِنا الخفِيْ","يِ الواسع الصدرِ",38,"ر",1,0],["مسلولةٌ بالدقِّ قد اسرَفَت","في عِشقِ مَن يُسرِفُ في دَقّها",39,"ق",3,0],["مُسَلَّمٌ لكِنْ أَتانا النَّصُّبِا","لاِذْنِ لِلنّائِبِ فِي ما خُصُّوْا",40,"ص",3,0],["مَسْلَمَةُ القائِدُ وَهوَ سامِ","كَالبَدْر أَجْلَى عَنْ دُجَى الغِيامِ",41,"م",1,0],["مسلسة منهم اسانيد اخذهم","إلى خير محمود واشرف حماد",42,"د",1,0],["مسلسلة عن كل شيخ لقيتمو","وفي كل ذكر قد حوته حزوب",43,"ب",1,0],["مسلم للعقل ما يدعي","تسليم من أمعن فيها النظر",44,"ر",1,0],["مسلولة يا صاحبي رحلي يرد","كضربها والخلف في شطر عهد",45,"د",1,0],["مسلماً عليهم في كل حين","اعداد معلومات رب العالمين",46,"ن",1,0],["مَسْلَكٌ نَهْجُه على الناس وَعْرٌ","هو، إلاّ عليكَ وَحْدَكَ، صَعْبُ",47,"ب",1,0],["مسلماً وائماً ما لاح بدر سما","وما سرى البرق في الظلماء من إضم",48,"م",1,0],["مسل شطيبة في المتن منه","الى تسديد شارته اشارا",49,"ر",2,0],["مُسلسلاً قد جرى يا صاح مُنطلقاً","فاعجب لمَن جمع الضدين في حين",50,"ن",1,0],["مسلوبة الاطمار لم تر ساتراً","في الناس إلا كفها والمعصبا",51,"ب",2,0],["مَسلُوبُ أوصَافِ الكَمَالِ جَمِيعهَا","لَكِن وُجُودٌ حَسبُ لَيسَ بِفَانِ",52,"ن",1,0],["مسلوبةُ الأمْنِ ممحو محاسنُها","عيونُ سكانِها ممنوعَةُ الوسنِ",53,"ن",1,0],["مسلسلا مسندا تروى مآثره","بين الملا السن الاشعار والصحف",54,"ف",1,0],["مسلطة أَسيافكم فَكأَنَّها","صَواعق مُزن كُل شَيء تدّمر",55,"ر",1,0],["مسلهَمّا رفيق صرعى توافوا","قبل ايدي المنا لهم آجالا",56,"ل",2,0],["مَسلُوبَةُ الأطرافِ إذ تَرَاهَا","في البُعدِ إقصِدهَا ولا تَعدَاهَا",57,"ه",2,0],["مسلسل أدمعي يروى","حديث الوجد بالسند",58,"د",1,0],["مسلِّماً ما فاح عطر الحمى","من طيبةٍ واستاقه الشمألُ",59,"ل",1,0],["مسلسٌ للورى قيادي ولكن","دون وعي يقودهم تفكيري",60,"ر",2,0],["مُسلسلة بِالمَكرمات عَبيرها","تَضوع نَشراً لِلقُلوب وَغالى",61,"ل",2,0],["مسلبة البرود وقد كستها","سوافي الريح ضافية البرود",62,"د",1,0],["مسلبة البراقع سافرات","ولم تر ساترا إلا الأيادي",63,"د",2,0],["مسلّماً ما لاح برق وما","ودقٌ همى أينما وجهة",64,"ه",1,0],["مُسَلَّبةٌ تنادي يا لَقيْسٍ","وقيْسٌ بئْسَ فتيانِ الضِّراب",65,"ب"