etry.dctabudhabi.ae/diwan/poem/60031","الرمل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74092","الخفيف"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/132941","الكامل"],[3536,"","https://poetry.dctabudhabi.ae/diwan/poem/20613","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108359",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109983","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110228","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91611","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205563","الرمل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117996","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59514","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40104","الكامل"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32411","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90975","الكامل"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93748","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81685","الكامل"],[4332,"","https://poetry.dctabudhabi.ae/diwan/poem/73633","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83131","الكامل"],[4490,"","https://poetry.dctabudhabi.ae/diwan/poem/145773","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120502","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120496","الكامل"],[4797,"تالي عصير","https://www.poetsgate.com/ViewPoem.aspx?id=29435",""],[4818,"ثاني الجنتين","https://www.poetsgate.com/ViewPoem.aspx?id=203511",""],[4978,"أنشدت شِعرك فالسنا يتجدد","https://www.poetsgate.com/ViewPoem.aspx?id=177533",""],[5185,"الدرع","https://www.poetsgate.com/ViewPoem.aspx?id=117928",""],[5216,"مع سيرة الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=187130",""],[4045,"أيزيد إنك نائم فاستيقظ","https://www.poetsgate.com/ViewPoem.aspx?id=200286",""],[5327,"طِفلٌ عَلَى حَيْدِ الطَّريق","https://www.poetsgate.com/ViewPoem.aspx?id=156128",""],[5556,"لاتنس من لم ينس ذكرك أحمدا","https://www.poetsgate.com/ViewPoem.aspx?id=181204",""],[5725,"أهون الطعنات","https://www.poetsgate.com/ViewPoem.aspx?id=211094",""],[5970,"كم صديق أنا أحسنت إليه","https://www.poetsgate.com/ViewPoem.aspx?id=130608",""],[242,"لي في هوى المحبوب اعظم نشوة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563720",""],[5001,"الرسم بالحروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80718&r=&rc=8",""]],"verses":[["وَإِذا أَمِنتَ مِنَ الزَمانِ فَلا تَكُن","إِلّا عَلى حَذَرٍ مِنَ الإِخوانِ",0,"ن",1,0],["وَإِذا أَميرُ المُؤمِنينَ أَضافَ لي","أَمَلي نَزَلتُ عَلى الجَوادِ المُفضِلِ",1,"ل",1,0],["وَإِذَا امْرُؤَ جَعَلَ الصَّلِيبَ نَصِيرهُ","دُونَ الإِلاَهِ فَإِنَّهُ مَخْذُولُ",2,"ل",1,0],["وإذا امْرؤٌ وافَى بِما في وُسْعِهِ","سقَطَ المَلامُ وروعِيَتْ أقْدارُهُ",3,"ر",2,0],["وَإِذَا امْرُؤٌ أَلْقَى إِلَيْكَ قِيَادَهُ","وَرَجَاكَ أَدْرَكَ حِلْمَكَ المَوْهُوبَا",4,"ب",2,0],["وَإِذا أُمَيَّةُ حُصِّلَت أَنسابُها","كُنتَ المَجانَ مِنَ الصَريحِ الأَمخَضِ",5,"ض",1,0],["وإذا امرؤٌ أسدى إليك صنيعة","من جاهِهِ فكأنها من ماله",6,"ه",1,0],["وإذا امرؤ عاداهُمُ","أصفرتُ من وُدّي وِطابهْ",7,"ب",2,0],["وإذا امرؤٌ وصل الفلاحَ بسعيكم","فهو الخليق لأن يَتمَّ فلاحُه",8,"ح",2,0],["وإذا امتاحه ولي رآه","عارضاً واهي الكُلى معقوقا",9,"ق",2,0],["وإذا امرؤٌ مُنح الشجاعة لم يجدْ","عنه السماحُ لرحلهِ تحويلا",10,"ل",2,0],["وَإِذا اِمرُؤٌ نادى نَداهُ فَإِنَّما","نادى فَلَبّاهُ السَحابَ المُمطِرا",11,"ر",2,0],["واذا امرؤ ظن الكمال لنفسه","فالظن برهان على نقصانه",12,"ن",2,0],["وَإِذا اِمتَحَنتَ تَكَشَّفَت عَزَماتُهُ","عَن أَوحَدِيِّ النَقضِ وَالإِبرامِ",13,"م",1,0],["وإذا امرؤٌ أعيَتْ عليكَ سُهولُه","فاغضُضْ جفونَك عن ذُرَى أطوادِه",14,"د",2,0],["وَإِذا اِمرُؤٌ لَبِسَ الشُكوكَ بِعَزمِهِ","سَلَكَ الطَريقَ عَلى قَعودِ ضَلالِ",15,"ل",1,0],["وَإِذا اِمرُؤٌ كَمَلَت لَهُ شُعَبُ ال","تَقوى فَقَد كَمَلَت مَكارِمُهُ",16,"م",2,0],["وَإذا إِماءٌ جِئنَ بَعدَ هُنَيهَةٍ","فَإِذا العِلابُ تَفيضُ وَالأَقداحُ",17,"ح",1,0],["وَإِذا أَمِنَت عَلى الظَعينَةِ زِلَّةً","فَاِصفَح إِن اِطَّلَعَت مِنَ الإِجّارِ",18,"ر",1,0],["وَإِذَا امْتَطَى ظَهْرَ الْبَنَانِ لِغَايَةٍ","خَضَعتْ إِلَيْهِ قَوَارِحٌ وَمِهارُ",19,"ر",1,0],["واذا امتنعتِ عليّ فاقتنعي","أنَّ \" الكمنجةَ \" خيرُ مُعْتَصَر",20,"ر",1,0],["وإذا أمرؤٌ أقْوتْ محلّتُه ولم","يسألْ نداكَ فأنتَ عنه مُسائِلُ",21,"ل",1,0],["وإذا امرؤ في الناس طال به الأذى","قطعوا زيارتَه له وتخلَّقُوا",22,"ق",3,0],["وإذا امرؤ قعدت به همَّاتُه","خلىَّ سبيلَ رجائِه المسجونِ",23,"ن",1,0],["وَإِذا اِمتَطَوها في نِزالٍ خِلتَهُم","آسادَ غابٍ في ظُهورِ رِئالِ",24,"ل",1,0],["وَإِذا اِمتَطى سَيفُ الخِلافَةِ عَزمَهُ","فَلِدَولَةٍ تُبنى وَأُخرى تُهدَمُ",25,"م",1,0],["وإذا أمرؤ عزاك كان كاكمه","قد رام يهدى مبصراً بعيونه",26,"ن",2,0],["وإذا أمطتَ نقابها","فالشمسُ تحتَ نقابها",27,"ب",3,0],["وَإِذَا امْتَرَيْتَ فَإِنَّ سُبْحَانَ الذِي","أَسْرَى بِه لَبْلاً كَفَاكَ وَطَهَ",28,"ه",1,0],["وإذا امرؤ نبذ الوقا","ر فقد تلبّس بالسفاهه",29,"ا",3,0],["وَإِذا اِمتَطى مَهداً فَلَيسَ يُنيمُهُ","نَغمَ الحَنينَ بِغَيرِ ذِكرِ جَوادِ",30,"د",1,0],["وَإِذا اِمرؤ لَحظته عَين عِناية","مَنعت عُيون ذَكائه أَن تغفلا",31,"ل",2,0],["وإذا امرؤٌ مدح امرءاً لنواله","وأطال فيه فقد اراد به الهجا",32,"ج",2,0],["وإذا أمات المالَ أصبحَ وارثاً","من آمِلٍ أحياهُ حُسْنَ ثَنائه",33,"ا",3,0],["وإذا امتطى قَلَماً أنامِلُهُ","سحرَ العُقولَ بهِ وما سَحَرا",34,"ر",2,0],["وإذا أمْلَقْتُ أيْقَنْتُ الغنى","ثقةً بالجود منكم واعتمادا",35,"د",2,0],["وإذا أمْعَنْتَ فيهم نظراً","لم تجد إلاَّ شهاباً ثاقب الزند",36,"د",1,0],["وإذا امرؤ فقد الشباب فما له","في اللهو بعد مشيبة من عاذر",37,"ر",1,0],["وإِذا امُرُؤٌ أّسْدَى إِليكَ بشافِعٍ","خيراً فذاكَ الخَيْرُ خَيْرُ الشَّافِع",38,"ع",1,0],["وإذا امارفا الحبيب بطرف","أورث القلب سكرةً وانتاء",39,"ا",2,0],["وإذا امرؤ طالت به أيامه","ولقى الحوادث ذل منه العاسي",40,"س",2,0],["وإذا امرؤ أفنى الليالِيَ حسرةً","وأمانياً أفنيتُهنَّ توكُّلا",41,"ل",2,0],["وإذا امتطتْ ظهرَ اليراع بنابهُ","صاغتْ حلى جيد الرّمان العاطل",42,"ل",1,0],["وإذا أمّك الحِمامُ فما يُغْ","نِي من الطّيرِ بارحٌ وسَنيحُ",43,"ح",1,0],["وإذا أمنتَ وأنتَ في","طُرُقِ الحِمامِ فما أمِنْتا",44,"ت",2,0],["وإذا أمرتُهُمُ كأن","ني إذ أمرتُهُمُ نَهيتُ",45,"ت",1,0],["وإذا آمنك المو","دع سراً لا تخنه",46,"ن",2,0],["وَإِذَا امْرُؤٌ حَسُنَتْ مُرُوءَتُهُ","كَمَنَ التَّأَلُمُ فِي مَحَاسِنِهَا",47,"ن",3,0],["وَإِذَا امْرُؤٌ شِيْبَتْ خَلاَئِقُهُ","غَدْراً فَمَا فِي وُدِّهِ خَلْطُ",48,"ط",1,0],["وإذا أمت الخدر شمس الفلك","وعم البسيطة ثوب الحلك",49,"ك",1,1],["وإذا أمنتَهُمُ ملكتَ جلاءهم","ولمصر عندهم ذمام الصاحب",50,"ب",1,0],["وإذا امتطيت الدهر فيما تمتطي","فعلى الغداة المأرب الموعود",51,"د",1,0],["وإذا امتلكت من القويِّ سريرة","فقد امتلكت أعنة الأقدار",52,"ر",1,0],["وإذَا أَمالَ إليْهِ سَمْعاً صاعَدَتْ","أَنْفَاسُهُ أَسَفاً عَلَيْهِ واَبْغَضَا",53,"ض",2,0],["وإذا امْتُحنْتَ بمن يسوءك قربه","فالحر ممتَحَنٌ بأولاد الحرام",54,"م",1,0],["وإذا أمهلهم نقمته","لم يكُ الإِمهال إهمالَ الأُممْ",55,"م",1,0],["وَإِذا اِمتحنت وجدت منّي مذوداً","ذلفاً أذودُ به وقلباً قلّبا",56,"ب",2,0],["وإِذا أَمِنْتُ بيوسفَ بنِ محمدٍ","جُوْرَ الزَّمانِ فخِيْفَتي مِمَّاذا",57,"ذ",2,0],["وإذا امرؤ كانت ربوعك حظه","من سائر الأمصار فهو موفق",58,"ق",1,0],["وإِذا امروءٌ حُرم النَّجاحَ لِحَاجَةٍ","أَزْجى حوائِجَهُ إليه فأنْجَحا",59,"ح",2,0],["وإذا امرؤ صادفتُ علّة بغضِهِ","حَسَداً فلَستُ مزيلَها بِعلاجِ",60,"ج",1,0],["وإذا امرؤٌ رزقَ الغِنى في طاعةٍ","لله فهو على سبيل ثوابهِ",61,"ب",2,0],["وإِذا امرؤٌ في الحق أتعبَ نفسَهُ","فالراحةُ الكبرى مَدى أتعابهِ",61,"ب",2,0],["وَإِذا امرؤ كَنَفَت بِه آباؤُه","كَنَفتك وَاكتَنَفت بِكَ الآباء",62,"ا",2,1],["وَإِذا اِمرُؤٌ سَكَتَ النَوائِحُ بَعدَهُ","فَكَأَنَّ قابِلَةً بِهِ لَم تَقبَلِ",63,"ل",1,0],["وإذا امتحتَه اللَمى","رحت من عنده بلم",64,"م",1,0],["وإذا امرؤٌ ملك القلوب فقد بنى","ملكاً على العز المقيم يشاد",65,"د",1,0],["واذا أمَّهُ عليلُ اللَّيالي","أبرأت راحةٌ له أوصابَه",66,"ب",2,0],["وَإِذا اِمرُؤ لَسَعَتهُ أَفعى مَرَّة","تَرَكَتهُ حينَ يَجر حَبل يفرق",67,"ق",1,0],["وَإِذا اِمرؤُ مِنّا جَنى فَكَأَنَّهُ","مِمّا يَخافُ عَلى مَناكِبِ يَذبُلِ",68,"ل",1,0],["وإذا امتسكت بصاحب لك فاستبن","بولا زهير في علا ابن سنان",69,"ن",1,0],["وإذا امرؤٌ نسى لأحبةَ لم أخُن","عهداً ولم أسمع وقوعَ ملام",70,"م",1,0],["وإذا امتزجت مع الحبيبِ وجدتهُ","أدنى من التجريحِ والتبريحِ",71,"ح",1,0],["واذا امتطى متن السحابة فارس","طارت لتدركه على عاداتها",72,"ت",3,0],["وإذا امتطى يومَ الجلاد طمرّةً","بارى خيولَ العُجم والأعراب",73,"ب",1,0],["وإذا أمهل عزرائيل في","قبضه الروح فذا لم يمهل",74,"ل",1,0],["وإذا أم بيتَ أهليه ضيفٌ","راح فيه محدّقا بارتياب",75,"ب",1,0],["وإذا أمام القلب جاء مشمراً","أودى العثار به وخرّ مجدلا",76,"ل",2,0],["وإِذا اِمتَطى يوماً جياد كتابَةٍ","فظهورهنَّ على الرجال حرامُ",77,"م",1,0],["وإذا أملت قرباً منكم","قال إن البعد منهم لقريب",78,"ب",1,0],["وَإِذا أمّك الضنيك من الكَر","بِ فَقَد أَمّ فارج الكرباتِ",79,"ت",1,0],["وإذا امتَطَى مَهداً فليس يُنيمُهُ","إلا نشيدُ مدائحِ الأجداد",80,"د",1,0],["وَإِذا اِمرُؤٌ في الناسِ لَم يَكُ عارِفاً","بِالعُرفِ لَم يَكُ مُنكراً لِلمُنكَرُ",81,"ر",1,0],["واذا امتطى سرح السوابح سابحاً","في بحر ميدان بدا كغضنفر",82,"ر",1,0],["واذا أَمَتنا النَفسَ نُحيِها فوا","عجباً لنفسٍ بالإِماتةِ عاشتِ",83,"ت",1,0],["واذا امتطَوا متنَ الخُيولِ كانهم","أُحُدٌ ورَضوَى يَذيلٌ وثبيرُ",84,"ر",1,0],["وَإِذا أَموتُ فَنادني","يا نَفسُ رَجعي أَرجع",85,"ع",1,0],["وإذا أمتعك الري بها","بدأ الشوق إليها والحنينْ",86,"ن",1,0],["وإذا امرؤ لا عقل يرشده ولا","أدب فكيف نعدّه إنسانا",87,"ن",2,0],["وإذا أماتوا في الوغى أصواتهم","لم يفشلوا وبذا أتى القرآنُ",88,"ن",1,0],["وإِذا اِمرُؤٌ طَلَبَ الدّلِي","لَ وَردَّ قَولي واِستَمرّ",89,"ر",1,0],["وَإِذا أُمَيَّةُ حُصِّلَت","كانَ المُهَذَّبَ في اِنتِمائِهِ",90,"ا",3,0],["وإذا امرؤرب السماء أحبه","في الكائنات أحبه الجمهور",91,"ر",1,0],["وَإِذا امرؤ وَهب البِلاد حَياته","وَجب الثَناء عَلَيهِ وَالإِطراء",92,"ا",2,0],["وإذا امرؤٌ أضحى مُطيعاً سامعاً","لكَ لم يَضِرهُ مُكايد ومُناصِب",93,"ب",1,0],["وَإِذا أَمِيرُ المُؤمِنينَ اِختارَهُ","فَكَفاهُ مِن شَرَفٍ بِذاكَ مُخَلَّدِ",94,"د",1,0],["وَإِذا امرُؤٌ حَذَق الصِناعَة منكمو","غالَى بِسلعَتِهِ غلوَ الباخِلِ",95,"ل",1,0],["وإذا امتطى العشّاق غارِبَ أرضهم","تركوا لُجين المشرفيّ معصفرا",96,"ر",2,0],["واذا امرء خطب الرئاسة فليكن","منه لجلوتها مجد كادح",97,"ح",1,0],["واذا امرء متفلسف الف الخمو","ل رآه يأنف ان يسام خمولا",98,"ل",2,0],["واذا امتلى جوف الشجر بالعصافير ..",".. طلبت من رب العباد يهديني",99,"ن",2,0],["وإذا أموتُ فدىً لعينكِ يا أنا","فالفوزُ يكمنُ في الحياةِ الآجِلة",100,"ل",2,0],["وإذا امّحا منهاجه من فكرنا","ونظن يكفينا نصوم ونسجدُ",101,"د",1,0],["وإذا أمنتَ ، طعمتَ ، نمتَ مسالماً","فالخبزُ حقٌ ، والحقوقُ تُصان",102,"ن",1,0],["وإذا أَمرْتَ فأنتَ أفضلُ قدوةٍ","وإذا نهيتَ فلسْتَ تقربُ مُطْلَقا",103,"ق",2,0],["وإذا امرؤ بالوعظ خلل سمعه","فغصى النّهى فكأنه لم يوعظ",104,"ظ",1,0],["وَإذا امَّحَى وَهَنُ القُلُوبِ فَإنَّما","حُبُّ الشَّهادَةِ نَبْضُها المُتَجَدِّدُ",105,"د",1,0],["وإذا امرؤ أسدى لحر نعمة","بدءا تملكه بها واستبعدا",106,"د",2,0],["وإذا آمنتها من نظرةٍ","باغتتْ عجلى كحد الفيصلِ",107,"ل",1,0],["وإذا أمعنت في حبي له","ظن في حبي تمليقاً لديه",108,"ي",2,0],["وَإِذا اِمتَرَيتَ فَإِنَّ سُبحانَ الَّذي","أَسرى بِهِ لَيلاً كَفاكَ وَطَهَ",109,"ه",1,0],["واذا أمانينا التي رقصت بنا","تغفو.. ويسكُننا الغداة مَلال",110,"ل",1,0]]}