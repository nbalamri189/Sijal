"ب",2,0],["واذا دنا من شاهقٍ في جَريهِ","زَلَّت فراحَ محطَّماً قدَماهُ",139,"ا",2,0],["واذا دجا لَيلُ الكروب انرتَهُ","بزناد فكرٍ منك فاق ثُقوبا",140,"ب",2,0],["واذا دعيت لها فبادر مسرعا","ففساد عقلك نازح بصلاحها",141,"ح",3,0],["وإذا دنانير امرئ رقصت على","أظفاره خجلت فلوس المفلس",142,"س",1,0],["وإذا دَعَوتُ عليه عندَ تَعَتُّبِي","فأشدُّ ما أدعو به أن أَفدِيَه",143,"ه",1,0],["واذا دعا النِطْلِيسُ خُرْسَ نِصاله","رَدَّتْ جوابَ الأَلثَغِ التَّمتَامِ",144,"م",1,0],["وإذا دارت رحى الهيجاء في","موقف كان لها القطب الوحيدا",145,"د",2,0],["وَإِذا دُعيتَ إِلى أَداءِ فَريضةٍ","فاِنشَط وَلا تَكُ في الإِجابَةِ واني",146,"ن",2,0],["وإذا دجى ليل الوغى","وأدير كأس ردى وحين",147,"ن",1,0],["وإذا دفعت دفعت في متضايق","ملا المآزر يستفيض عن اليد",148,"د",1,0],["وإذا دُعِيتَ إلى السلوّ فكن اخا ال","خَنساءِ عن شَيطانِها الخنَّاسِ",149,"س",1,0],["واذا دنا الليل البهي","م وجاء يعثر بالكرى",150,"ر",2,0],["وإذا دعاكم للمكارم مصلح","جافيتموه وكلكم يتبرم",151,"م",1,0],["وَإِذا دُعيتَ لدفع نا","ئبة فَلا تَخشى النقم",152,"م",1,0],["وِإِذا دَجى لَيلُ الخُطوبِ فَرَأيُهُ","فيها كَضوءِ الشَمس في لَمَعانِهِ",153,"ن",2,0],["وإذا دعا داعيكم مستنبحا","لبّته عنكم ألسن النيران",154,"ن",1,0],["وإذا دعيت إليه قلت لمن دعا","ذهب الصبى فعلى القريض سلام",155,"م",1,0],["وإذا دكت العوادي جبالاً","افتبقى الآكام والكثبان",156,"ن",1,0],["وإذا دَعاني المُستثي","بُ رأيتَ لي عَنقاً وشدا",157,"د",2,0],["وإذا دياجي الخطْب أسدل ثوُبها","أطلعت فجراً منه ليس يرانُ",158,"ن",1,0],["وَإذا دَجَا لَيْلُ الوِصالِ فَنَادِهِ","يَا كافِراً حَلَّلْتَ قَتْلَ المُسلِمِ",159,"م",1,0],["وَإِذَا دَخَلتُ عَلَيكِ خِفتُ تَغَيُّراً","لَكِ عَن سَنَاكِ فَلَم أكُن بِالوَاصِلِ",160,"ل",1,0],["وإذا دجا ليل الخطوب فلم يكن","عندى سوى خير الأنام رجاء",161,"ا",2,0],["وإذا دعاك إلى الإغاثة غيثه","فاذهب مخافة فيضه بسلام",162,"م",1,0],["وإذا دعاك إلى المزاح فم امرىء","فلقد دعاك إلى أشد خصام",163,"م",1,0],["وإذا دعيت إلى النهوض بحاجة","فأحجج لها عجلا ولا تتحجج",164,"ج",1,0],["وإذا دحى سندانه المهيلا","ففي يدٍ مطرقه الثقيلا",165,"ل",2,0],["وَإِذا دَجا لَيلُ الخُطوبِ أَنارَهُ","بِصَباحٍ رَأي بِالصَواب مُشَدَّد",166,"د",1,0],["وإِذا دعوتَ إلى النزالِ رأَيتهُ","فوق المطَهَّمِ فارسَ الهيجاءِ",167,"ا",2,0],["وإذا دَعَاك إِلَى الرجوع مُجاملاً","فارجع لَهُ وليلف سربك واسعا",168,"ع",2,0],["وإذا دارت الكؤوس بها","أبصرت خلد النعيم ثم مباحا",169,"ح",2,0],["وإذا دعيت إلى المه","م فكن لفادحه حمولا",170,"ل",2,0],["وإِذا دنت يمناه من مُسْترفِدٍ","لم تَدْرِ أَيُّهما يمينُ الرّافدِ",171,"د",1,0],["وإذا دجا ليل الفراق فناده","يا كافرا حللت قتل المسلم",172,"م",1,0],["وإذا دعوتهم ليوم كريهة","والخيل بين مقعص ومدعس",173,"س",1,0],["وإذا دنا هانتْ لطلعتِه الدُّنا","وأقام رؤيتَه مقامَ الإثْمِد",174,"د",1,0],["وإذا درات رحى أكرومةٍ","للندى كان لها قطبُ رحاها",175,"ا",3,0],["وإذا دعونا لم تجب عكس الذي","عوَّدتنا بل لم تفه بكلام",176,"م",1,0],["وإذا دعتك لحاجة عنّت لها","لتكون قاضيها فرجّ ما.....",177,"م",2,0],["واذا دعا ياللنزال فما ترى","من للنزال تشوقه الاهوال",178,"ل",1,0],["واذا دجا ليل المشا","كل وهو غفل الفدفد",179,"د",1,0],["وإذا دهت دهم المشاكل فلَّها","من راية الماضي الصقيل مهندُ",180,"د",1,0],["وإذا دخلت لروضة قد طهرت","قولي حسين لإذنكم مترقبا",181,"ب",2,0],["وإذا دعاه لحاجة","شخص أتى وتكرما",182,"م",2,0],["وإذا دهتني النّائبات وأخفتت","صوتي فإنّ بنّي بعدي تنطق",183,"ق",1,0],["واذا داعبَهُ طيفُ الكرى","ضمَّهُ لَهْفاً وفي العينِ انحَبَسْ",184,"س",1,0],["وإذا دَنَتْ سَبْعُونَ مِن مُتَأَمِّلٍ","دانى وَلَمْ يَرَ فِي اللَّذاذَةِ مَرْكَضا",185,"ض",2,0],["وإذا دنتْ صَدَّتْ وإنْ وَعدتْ فأنّ","الغدرَ قد غَطَّى عليه الظاهرُ",186,"ر",1,0],["وإذا دعاكَ إلى المروءَةِ فِعلُها","فانهضْ بهِ : لا يَصرفنَّكَ ثقْلُهَا",187,"ل",3,1],["وإذا دنا المحتوم لست بواصل","حبل القضاء ولو ضفرت جدائله",188,"ل",2,0],["وإذا دخلتَ الفصلَ في غيبوبةِ","قل للتلاميذ : اخرُجوا ، أنا صائِمُ",189,"م",1,0],["وإذا دُعِيتَ لواجبٍ مستعجلٍ","فأجبْ رئيسَك صارخا : أنا صائِمُ",189,"م",1,0],["وإذا دهاكَ ببعضِ شاردِ لحْنهِ","نابَ الجَنانَ بلوثةِ الغثَيانِ",190,"ن",1,0],["وإذا دَنَتْ مني دروبُ لقائنا","وكآنها الأشياء حولي طائرهْ",191,"ر",2,0],["وإذا دخلت فإنني سلمانه","وإذا خرجت فإنني عماره",192,"ر",2,0],["وإذا دعا داعي الجهاد تراهمو","أسداً تزمجرُ لا تهابُ الظالمينْ",193,"ن",1,0],["وإذا دهتك من الليالي شدة","فارفع إليه كف عانٍ تائه",194,"ا",3,0],["وإذا دعى داعي الجهاد تقدمت","بينا الخلائق في السفاسف غارقه",195,"ق",2,0],["وإذا دلفتَ إلى المفوّض عاصمٍ","لعجبتَ كيف لمسلم أن يغضبا",196,"ب",2,0],["وَأذَادَهَا عَنْ كُلِّ شَيءٍ دُونَهُ","وَالدَّمعُ خَوفَ المَنعِ هَامٍ هَاطِلُ",197,"ل",1,0],["وإذا دخلت على الربيع مسلماً","فاخصص شبابة منك بالتسليم",198,"م",1,0],["وإذا دنا يومُ الحسينِ ولم نَجِدْ","أعداءَهُ سنُغَيِّرُ التَعْبيرا",199,"ر",2,0],["وإذا دخلت فؤاده لوجدته","لا يحمل المعروف حيث تعبدا",200,"د",2,0],["وإذا دعاها الخطْبُ لا ترجو المنى","ووجدتها دون النساء تحيضُ",201,"ض",1,0],["واذا دعاني حبي الذات عييت","احبك اكثر ياعذابٍ ملكني",202,"ن",2,0],["وإذا دار الوقت لحظه وأنا بتذكر وصوفك","أطيب فلحظة إحساسي وجوي رايق ٍ راقي",203,"ق",2,0],["وإذا دَقَّ بابَك الهمُّ يوْمًا","فتَجاهلْه كيْ يشدَّ الرّحيلا",204,"ل",2,0],["وإذا دعوتَ إلى الصلاحِ كأنَّما","غاليتَ في قولٍ وفي عُدوانِ",205,"ن",1,0],["وإذا دُعيتَ إلى القَصيدِ فغَنِّهِ","واصْدحْ لعَبْلةَ في الليالي المُقْمِرةْ",206,"ر",2,0],["وَ إِذا دَعَتكَ أَميرَةٌ مِنهُم فَلا","تُجِبِ النِّداءَ وَ غادِرَنَّ هَلوعا",207,"ع",2,0],["وإذا دَجَتْ حربٌ أضاء بوجهه","صُبح من التوفيق والتسديد",208,"د",1,0],["وإذا درستهم وجدتهم","كمردة بخوادع الصور",209,"ر",1,0],["وإذا دنا أجلي فكنْ","عوني إلى درب النجاةْ",210,"ه",1,0],["واذا دعوتك للنزال فجربي","وأمضي بما حكم الهوى للأصعبِ",211,"ب",1,1],["وإذا دُعيتَ إلى المَفَاخِرِ لا تَقَفْ","كَالصُّمِّ مِنْ أَحْجَارِها ورُباهَا",212,"ا",3,0],["وإذا دعاها الضيم منتظراً","إحسانها قالت له مهلا",213,"ل",2,0],["وإذا دُكَّت القلاع ستهوي","كل أعلامِها ، وتعلو الجدائِلْ",214,"ل",1,0],["وإذا دفعتم عن قليل عطائهم","فهو الذي عن فضله لا يدفع",215,"ع",1,0],["وإذا دعونا أو سجدنا سَجْدةً","حتى ذهلنا ثم غارت أضلعُ",216,"ع",1,0],["وإذا دمعةُ عصتْكَ فسالتْ","فأنا خلفَ شجوها يا حبيبي",217,"ب",2,0]]}