[1901,"خدعتك من سودِ العيونِ نواظرُ","https://www.poetsgate.com/ViewPoem.aspx?id=160381",""],[4929,"المروءة (1)","https://www.poetsgate.com/ViewPoem.aspx?id=211964",""],[4984,"معركة \" الشوابير\"","https://www.poetsgate.com/ViewPoem.aspx?id=191622",""],[5036,"أنا صائِمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=151402",""],[5038,"لغتي الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=190166",""],[5092,"العيش في ذكرى الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=153631",""],[5145,"متبحبح في بيت عزٍّ سقفه","https://www.poetsgate.com/ViewPoem.aspx?id=108103",""],[5160,"رحلوا","https://www.poetsgate.com/ViewPoem.aspx?id=175257",""],[5183,"بين الهيمنة والهينمة","https://www.poetsgate.com/ViewPoem.aspx?id=180155",""],[5185,"شمس العماد","https://www.poetsgate.com/ViewPoem.aspx?id=118566",""],[5185,"قرطبة قلعة العلم","https://www.poetsgate.com/ViewPoem.aspx?id=203224",""],[5206,"مناهج الله","https://www.poetsgate.com/ViewPoem.aspx?id=187391",""],[5229,"شمر ثيابك واستعد لقائل","https://www.poetsgate.com/ViewPoem.aspx?id=99988",""],[5358,"نطق العراق","https://www.poetsgate.com/ViewPoem.aspx?id=194832",""],[5376,"الحبُّ نفحٌ للاله بخلقه","https://www.poetsgate.com/ViewPoem.aspx?id=202174",""],[5376,"نشجتْ بها الحسراتُ حيثُ تفيضُ","https://www.poetsgate.com/ViewPoem.aspx?id=204766",""],[5461,"من كثر حبي","https://www.poetsgate.com/ViewPoem.aspx?id=5296",""],[5480,"احساسي","https://www.poetsgate.com/ViewPoem.aspx?id=10894",""],[5550,"عاملِ الناسَ","https://www.poetsgate.com/ViewPoem.aspx?id=214056",""],[5561,"خذني إليك ...","https://www.poetsgate.com/ViewPoem.aspx?id=206453",""],[5612,"رسالة إلى عنترة","https://www.poetsgate.com/ViewPoem.aspx?id=197096",""],[5660,"دَع عَنكَ ذُلُّ هَوى النِّساءِ جَميعا","https://www.poetsgate.com/ViewPoem.aspx?id=25121",""],[5665,"ليثٌ إذا أَبكى شبا أسيافهِ","https://www.poetsgate.com/ViewPoem.aspx?id=190433",""],[5689,"ذره يرن بضوء ذا السحر","https://www.poetsgate.com/ViewPoem.aspx?id=143405",""],[5720,"دعاء","https://www.poetsgate.com/ViewPoem.aspx?id=200194",""],[5725,"واذا دعوتك","https://www.poetsgate.com/ViewPoem.aspx?id=211535",""],[5815,"وصية الرحيل الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=200044",""],[5897,"يا عيد .. ماذا عن غزة ؟","https://www.poetsgate.com/ViewPoem.aspx?id=174865",""],[5937,"قهوةُ البلابِلْ","https://www.poetsgate.com/ViewPoem.aspx?id=211802",""],[6024,"الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=186351",""],[6167,"القلب الذاكر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85479&r=&rc=8",""],[6336,"لقاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73564&r=&rc=25",""]],"verses":[["وَإِذا دَعَوتُ أَجَبنَ غَيرَ شَوامِسٍ","خَفَفَ النِياقِ إِلى رُغاءِ المُصعَبِ",0,"ب",1,0],["وَإِذا دَعَوا وَالخَيلُ في الإِج","فالِ ثابوا أَو أَجابوا",1,"ب",3,0],["وإذا دُعوا لكَريهَةٍ لم ينظُروا ال","إسْراجَ واقْتَصَروا على الإلْجامِ",2,"م",1,0],["وَإِذَا دَعَاهُ الْمُلْكُ مِنْهُ لِلَذَّةٍ","نَاجَاهُ مِنْ تَقْوَى الإِلاَهِ عَذُولُهُ",3,"ل",2,0],["وَإِذا دَعَوتَ وَليدَهُم لِعَظيمَةٍ","لَبّاكَ رَقراقَ السَماحِ أَديبا",4,"ب",2,0],["وَإِذَا دَخَلَتَ فَأُغلِقَت أَبوَابُها","غَرَمَ الغيورُ حِجَابَها فَاعتَلَّتِ",5,"ت",1,0],["وإذا دجا ليل القتام رأيته","وكأنه فيه ذبالٌ مشعلُ",6,"ل",1,0],["وإذا دعا داعي البلاد إلى الوغى","أتظنّ أن هناك مَن يتخلَّف",7,"ف",1,0],["وَإِذا دَفَنتَ أَباكَ فَاِج","عَل فَوقَهُ خَشَباً وَطينا",8,"ن",2,0],["وَإِذا دَعَوتُ الحارِثَينِ أَجابَني","كِندِيُّهُم وَالحارِثُ بنُ الخَزرَجِ",9,"ج",1,1],["وإذا دنَا من لثمِ نعلِك تربهُ","ودّ الموَحدُ لو يكونُ ترَابا",10,"ب",2,0],["وإذا دعوت بنان أَحمدَ جاوبت","سُحب الندى من قبلِ ما سمعَ النَّدا",11,"د",2,0],["وإذا دعى الداعي نزال وجدتهُ","بالرأيِ يطعن واليراع فيهزم",12,"م",1,0],["وإذا دوفِعتْ بهم حُججُ البا","طل كانت رهائن الإدحاض",13,"ض",1,0],["وَإِذا دَعَونَكَ عَمَّهُنَّ فَإِنَّهُ","نَسَبٌ يَزيدُكَ عِندَهُنَّ خَبالا",14,"ل",2,0],["وَإِذاً دُفِعتُ إِلى زَناءٍ بابُها","غَبراءَ مُظلِمَةٍ مِنَ الأَجفارِ",15,"ر",1,0],["وَإِذا داعَبَ النَسيمُ رِدائِيَ","قُلتُ قَد عَلَّمَتهُ هَذا يَداها",16,"ا",3,0],["وَإِذا دارَت كُؤوسي","فَهيَ مِنّي وَإِلَيَّه",17,"ي",2,0],["وَإِذا دَعا بِاِسمي لِيَركَبَ مَركَباً","صَعباً قَعَدتُ لَهُ عَلى سيسائِهِ",18,"ا",3,0],["وإذا دخلتُ إلى البلادِ فإنَّ أَف","كاري تُرَفْرِفُ في سُفوحِ الطُّورِ",19,"ر",1,0],["وَإِذا دامَت قَليلاً","قَتَلَتني شَرَّ قتلَه",20,"ل",2,0],["وَإِذا دَعاكَ إِلى الهَوى","داعي الصِبا لَم تَحفِلِ",21,"ل",1,0],["وَإِذا دَعَوتُ إِلى الوِئامِ فَشاعِرٌ","أَقصى مُناهُ مَحَبَّةٌ وَوِئامُ",22,"م",1,0],["وَإِذا دَجَت أَقلامُهُ ثُمَّ اِنتَحَت","بَرَقَت مَصابيحُ الدُجى في كُتبِهِ",23,"ب",2,0],["وَإِذا دِجلَةُ مَدَّت شَأوَها","وَجَرَت جَريَ اللُجَينِ المُنسَبِك",24,"ك",1,0],["وَإِذا دَعَوتُ بَني فُقَيمٍ جاءَني","مَجرٌ لَهُ العَدَدُ الَّذي لا يُعدَلُ",25,"ل",1,0],["وَإِذا دَعَت خُدَعُ الحَوادِثِ دَعوَةً","شَهِدَت لَهُنَّ مَصارِعُ الأَبطالِ",26,"ل",1,0],["وَإِذا دُعوا يَوماً لِدَفعِ مُلِمَّةٍ","بَسَموا وَفي وَجهِ الزَمانِ قُطوبُ",27,"ب",1,0],["وَإِذا دَعَبتُ وَلا دُعابَةَ غَيبَةٍ","فَاِغضُض هُناكَ مِنَ العَنانِ قَليلا",28,"ل",2,0],["وَإِذا دجلةُ عَذبٌ وِردُها","وَإِذا النَخلُ كَريمُ المَأكِلِ",29,"ل",1,0],["وَإِذا دَعَوتَهُم لِكُلِّ مُلِمَّةٍ","ظَسدّوا شُعاعَ الشَمسِ بِالفُرسانِ",30,"ن",1,0],["وَإِذا دَخَلنا فَاِدخُلي","في الحُمرِ إِنَّ الحُسنَ أَحمَر",31,"ر",1,0],["وَإِذا دَفَعنا لِلحِراجِ فَنَهبُها","أَدنى سَوامِ الجامِلِ المَحلوسِ",32,"س",1,0],["وإذا دعَوْنَكَ عمَّهُنَّ فإنَّهُ","نَسَبٌ يَزيدُكَ عِنْدَهُنَّ خَيالا",33,"ل",2,0],["وإذا دُعيت إلى تناسي عهدِكُمْ","ألْفَيتُ أحشائي بذاكَ شِحاحا",34,"ح",2,0],["وإِذَا دَعَوْتَ بَنيِ حَنِيفَةَ رَاغِباً","أَوْ رَاهِباً جَاءُوا إلَيْكَ فَأَوْشَكُوا",35,"ك",3,0],["وإذا دعتكَ الحادثاتُ فلبِّها","بحميَّةِ المستقتلِ المتفاني",36,"ن",2,0],["وإذا دهتهُ الحادثاتُ بفادحٍ","لم تلق إلاّ هَزّةَ استخفافِ",37,"ف",1,0],["وإذا دعتْه عمامة","خضراءُ، لم يتردَّد",38,"د",1,0],["وإذا دعاه الملك منه للذة","ناجاه من تقوى الإله عذوله",39,"ل",2,0],["وإذا دخلتُ إلى البلاد فإنَّ أفكا","كاري تُرَفْرِفُ في سُفوح الطُّورِ",40,"ر",1,0],["واذا دهاك من الوساوس طارق","فاطرحه فهو الظلم والعدوان",41,"ن",1,0],["وإذا دعوت أجابني بعزيمة","كالسيف حين تسله من غمده",42,"د",2,0],["وإذا دنانيرُ الفَتى رقصَتْ على","أَظفارِهِ خَجلتُ فلوسُ المُفْلسِ",43,"س",1,0],["وإذا دَجا ليلُ الهمومِ فسُل عن","دَنِّ المُدامةِ فالقَ الاصباحِ",44,"ح",1,0],["وإذا دَنوتَ من الوَغَى","فالموتُ أَجْزعُ من تُحارب",45,"ب",1,0],["وإذا دهت طخياء قد نزلت بنا","نهنهتا وكشفتها نقدا",46,"د",2,0],["وإذا دُفِنتُ فَبلّلي","بالدمعِ قَبري واذكُريني",47,"ن",2,0],["وإذا دجا ليلُ الحياةِ فدع","يا ليلُ مصباحاً على قبري",48,"ر",2,0],["وَإِذا دَعاهُ المَرءُ كانَ جَوابُهُ","لَبَّيكَ لِلأَصحابِ وَالغِلمانِ",49,"ن",1,0],["وَإِذا دَجى خَطبٌ فَرَأيُكَ سافِرٌ","وَإِذا عَرى جَدبٌ فَبَحرُكَ طامِ",50,"م",1,0],["وَإِذا دُعوا لِمُلِمَّةٍ","وَثَبو وَإِن سُئِلوا أَجابوا",51,"ب",3,0],["وإذا دَجَت ظُلَمُ الخطوبِ أنارَها","برويّةٍ تحكي ذكاءَ إياسِ",52,"س",1,0],["وإذا دَعا الوطنُ المقدَّسُ لم أكن","إِلا لأطلُبَ في القِتالِ شَفائي",53,"ا",2,0],["وإذا دُعيتَ الى الكَرِيهةِ كَن لها","بطلاً فأحقِر بالجبانِ القاعد",54,"د",1,0],["واذا دَعوتك للملمه فاِستَجِب","واذا انتصرت بجاه وَجهك فانصر",55,"ر",1,0],["وَإِذا دُعِيتُ إِلى النِّزالِ فَإِنَّنِي","في القَومِ أَولُ مَن يُجِيبُ وَيَنزِلُ",56,"ل",1,0],["وإِذا دَعاكَ لبيع نفسِكَ سائِمٌ","في حبِّها يَوماً فبِعه وَبارِكِ",57,"ك",1,0],["وَإِذا دَعاكَ إلى الصبا نفسُ الصبا","فَأجِب رَسولَ نسيمهِ الخفّاقِ",58,"ق",1,0],["وَإِذا دُعيتُ لِأَن تُبَشِّرَ ثانِياً","اِرخِ نِعَمٌ وافَت نَجيبَ الثانِيَه",59,"ي",2,0],["وإذا دعوتهم ليوم كريهة","سدّوا شعاع الشمس بالفرسان",60,"ن",1,0],["وَإِذا دَعاك إِلى الثَنا","ذكر الصَديق وَهيَّما",61,"م",2,0],["وَإِذا دارَت كؤوس الأنسِ كُن","بَينَ أَكواب الطلا قطب الرَحى",62,"ح",2,0],["وإذا دَعَوْتُ إلى المُهمِّ أجابنَي","فكَفاهُ لا وانٍ ولا مُتَوان",63,"ن",1,0],["وإذا دبّروا الممالك بالرأْ","يِ وقد همَّ كائدٌ أَن يكيدا",64,"د",2,0],["وَإِذا دُعيتُ بِعَبدِهِ","لَبَّيتُ دَعوَةَ مَن دَعاني",65,"ن",2,0],["وإذا دجا ليل الرذيلة حدَّقت","حدقاته ويقول نحوي هاتها",66,"ت",3,0],["وإذا دعوت بطول عمر لامرئ","فاعلم بأنك قد دعوت عليه",67,"ه",1,0],["وَإِذا دَجا اللَّيْلُ البَهيمُ رَأَيْتَهُمْ","مُتَبَتِّلينَ تَبَتَّلَ الرُّهْبانِ",68,"ن",1,0],["واذا دَجا ليلُ الخُطوبِ","وساورَ الأحْياءَ ضُرُّ",69,"ر",1,0],["وإذا دجا الخطب البهيمُ وأغْدفتْ","شمس الرَّجاء نِقابَ ليلٍ ألْيَل",70,"ل",1,0],["وإذا دجا ليل العجاج سلكته","منه بغرّة كوكبٍ متوقد",71,"د",1,0],["وإذا دعيت إلى المبرة لا تقل","إن العطاء يجر للإفلاس",72,"س",1,0],["وإذا دَعا الباري بنا وبأَهلِنا","ذو نِيَّةٍ صافي السَّريرَةِ يُقْبَلُ",73,"ل",1,0],["وإذا دعوت لها فقد وفيتها","بل زدتها شرفاً على استحقاقها",74,"ق",3,0],["وَإذا دَهَتْكَ وَسَاوِسٌ أَوْ حِيرَةٌ","فَاحْزِمْ بِنَفْسِكَ أَحْزَمَ الطّرَفَيْنِ",75,"ن",1,1],["وأُذادُ حين أُذادُ عن أمواهكمْ","وأُصدّ عن باب اللّقاءِ وأُحْرَمُ",76,"م",1,0],["وإذا دخلتَ إلى رباعك كان ذي","ياك الدّخولُ لديك خيرَ دخولِ",77,"ل",1,0],["وإذْ أُدْمُ المطيِّ معقّلاتٌ","على وادي مِنىً بيد الكلالِ",78,"ل",1,0],["وإذا دعوتَ سوى الإلهِ فإنّما","صَيّرتَ للرحمنِ فيك شريكا",79,"ك",2,0],["وإذا دنا الأجل المقدَّرُ للفتى","لم أُنْجِهِ منه وضاع دِفاعي",80,"ع",2,0],["وَإِذا دَعوتهُمُ لنازلةٍ","حشدوا عليك بقُرَّحٍ ضُمْرِ",81,"ر",1,0],["وإذا دموعِي يومَ سِلنَ شهدن بال","وجدِ المبرّح لم يُفدْكَ جُحودِي",82,"د",2,0],["وَأُذادُ عن وِرْدِي وَبي صدأٌ وكمْ","ظمآنِ قومٍ كان غيرَ مَذودِ",82,"د",1,0],["وإذا دُعوا لِمُلِمّةٍ فكأنّما","فُجرتْ لها دُفَعُ الغمام المُزْبدِ",83,"د",1,0],["وَإِذا دَنوتُ إلى الرِّواقِ مسلِّماً","أقذيتَ بِي فيه نواظرَ حُسّدِي",83,"د",2,0],["وَإِذا دعا وجْداً يُدِلُّ بهِ","عند المنيّةِ خانَهُ الوُجْدُ",84,"د",1,0],["وإذا دَعوتَهُمُ لنصرك من ردىً","جاءتْ إليك بهمْ جِيادٌ قُرَّحُ",85,"ح",1,0],["وإذا دعيت إلى تناسي عهدكم","لا أستطيع وأنثني ملتاحا",86,"ح",2,0],["وَإِذَا دَعَاهُ الْبًَازِيَارُ رَأَيْتَهُ","أَدْنَى وَأَطْوَعَ مِنْ مُحِبَّ وَامِقِ",87,"ق",1,0],["وإِذَا دُمْتَ لي تَعَجَّلت أَجْرِي","أَنْتَ لي جَنَّةٌ وجُودكَ كَوْثَرْ",88,"ر",1,0],["وإذا دنت آجالنا هل ساعة","يستأخر الانسان او يستقدم",89,"م",1,0],["وَإذا دَعَى لَكَ آخَرُونَ مُضاهياً","بِالجَهلٍِ عِجلَ السّامِرِيِّ إلاها",90,"ا",3,0],["وَإِذا دَعاكَ إِلى ارتِكاب خَطيئة","إِياكَ تُبدي في الحَرام توقُّفا",91,"ف",2,0],["وَإِذا دَعَى لملمةٍ أَلفيتَه","ماضي العَزيمة ثابتَ الأَقوال",92,"ل",1,0],["وإِذا دَنَتْ لغروبِهَا","كَان الأَصيلُ عليَّ صُفْره",93,"ر",2,0],["وإذا دَعَا داعٍ بِطُوْلِ بَقَائِهِ","خَرَقَتْ له سَمْعَ السَمَا آمِيْنُ",94,"ن",1,0],["وإذا دولة المساواة عادت","تقسم الناس سادة وعبيدا",95,"د",2,0],["وإذا دعوت إلى السلام فقبله","مكِّن لحرصك حول أرضك سورا",96,"ر",2,0],["وإذا دعا فإلى الذنوب وإن سطا","فعلى الأرامل واليتيم مبيدا",97,"د",2,0],["وإذا دخلتُ على سِواكَ فلا أرى","في المُسندِ المنصوبِ الا المُسندا",98,"د",2,0],["وَإِذا دَعا لِعَظيمَةٍ حُشِدَت لَهُ","هَمدانُ تَحتَ لِوائِهِ المَعقودِ",99,"د",1,0],["وَإِذا دَعَوتَ بِآلَ كِندَةَ أَجفَلوا","بِكُهولِ صِدقٍ سَيِّدٍ وَمَسودِ",99,"د",1,0],["وإذا دَنَتْ سَبْعُونَ مِنء مُتَأَمِّلٍ","دانى وَلَمْ يَرَ فِي اللَّذاذَةِ مَرْكَضا",100,"ض",2,0],["وإذا دجى النقعُ المثار فيومنا","لم يُرجئ المدعي إلى صبح الغد",101,"د",1,0],["وإذا دَعَونَك عَمَّهُنَّ فلا تُجب","فهناك لا تجدُ الصَّفاءَ مكانا",102,"ن",2,0],["واذا دنوت لها وجدت أديمها","يحكي الصقيل صقالة وصفاء",103,"ا",2,0],["وَإذَا دَبَّرَ الأمُورَ شَهِدْنَا","عَزْمَةَ الصّيدِ فِي مَضَاءِ الحَديِدِ",104,"د",1,0],["وإذا دعا داعي الهوى","قامت اليه ترحب",105,"ب",1,0],["وإذا دَعَوْتُ مُحَارباً أو حارثاً","دَفَعا بكُلّ خميلةٍ أو فَدْفَدِ",106,"د",1,0],["وإذا دجا ليلُ الخَطوبِ فإنّما","بضيائهم في اهتدَاءٌ المُدْلجِ",107,"ج",1,0],["وَإِذَا دَعَوتَ لِخِدْمَةٍ فَأَنَا الَّذِي","آتِي عَلَى وَجْهِي إِلَيْكَ وَرَاسِي",108,"س",2,0],["وإذا دعوت اللّه خشية زلّة","فأجب دعائي منك بالتأمين",109,"ن",1,0],["وَإِذا دَعَوت أَخا يَزي","نُك عِند نائِبَة تَنوب",110,"ب",1,1],["وإذا دعوا حيذي حياد","دعى بحيَّ على الكفاح",111,"ح",1,0],["وإذا دهتك ملمّةٌ","رزحت بكلكلها قُواك",112,"ك",1,0],["واذا دنا مترنّماً ومسلّما","ان الرفاقَةَ في الطريق تُريحُ",113,"ح",1,0],["وإذا دعا داعي المنون أباك لا","تجزع فروح أبيك في مأواها",114,"ا",3,0],["وإذا داعي الأماني هتفا","فصغير القوم بالقوم يصيح",115,"ح",1,0],["وإذا دخلتُ أكونُ آخرَ داخِلٍ","مَرْمَى القَصِيّة بالمكان الأوْعرِ",116,"ر",1,0],["وإذا دبرها ثم مضى","في سبيل الفقد لم تنكح أحد",117,"د",1,0],["و