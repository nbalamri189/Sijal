{"poems":[[53,"ولقد أكون من الغواني مرة","https://www.aldiwan.net/poem30713.html","الكامل"],[53,"إنا نعيب ولانعاب","https://www.aldiwan.net/poem30746.html","مجزوء الكامل"],[63,"خدع المنى وخواطر الأوهام","https://www.aldiwan.net/poem46123.html","الكامل"],[77,"النصر نصك والحسام دليله","https://www.aldiwan.net/poem36377.html","الكامل"],[73,"هذا الصباح على سراك رقيبا","https://www.aldiwan.net/poem11919.html","الكامل"],[41,"حي التي أقصى فؤادك حلت","https://www.aldiwan.net/poem42379.html","الكامل"],[83,"بشرى كما وضح الزمان وأجمل","https://www.aldiwan.net/poem54256.html","الكامل"],[88,"أنا بالحكومة والسياسة أعرف","https://www.aldiwan.net/poem44808.html","الكامل"],[4,"أنبئت أن أبا حنيف","https://www.aldiwan.net/poem21209.html","مجزوء الكامل"],[23,"وإذا دعوت الحارثين أجابني","https://www.aldiwan.net/poem21541.html","الكامل"],[72,"أهلا بمقدمك السعيد فإنه","https://www.aldiwan.net/poem18299.html","الكامل"],[72,"قمرا نراه أم مليحا أمردا","https://www.aldiwan.net/poem18555.html","الكامل"],[72,"ربع لعزة صامت لا يفهم","https://www.aldiwan.net/poem19680.html","الكامل"],[51,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[29,"كذبتك عينك أم رأيت بواسط","https://www.aldiwan.net/poem6031.html","الكامل"],[29,"صدع الخليط فشاقني أجواري","https://www.aldiwan.net/poem6065.html","الكامل"],[91,"رب ليل نجومه ضاحكات","https://www.aldiwan.net/poem62801.html","عموديه"],[70,"أنا في البستان وحدي","https://www.aldiwan.net/poem42401.html","مجزوء الرمل"],[38,"إني وإن كان ابن عمي كاشحا","https://www.aldiwan.net/poem7824.html","الكامل"],[92,"يا أيها الشادي المغرد ههنا","https://www.aldiwan.net/poem38941.html","الكامل"],[85,"وقف الهدهد في باب","https://www.aldiwan.net/poem8030.html","مجزوء الرمل"],[85,"ما بين دمعي المسبل","https://www.aldiwan.net/poem62836.html","مجزوء الكامل"],[85,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[45,"من سائل لمعذر عن خطبه","https://www.aldiwan.net/poem10888.html","الكامل"],[45,"هبل الواشي بها أنى أفك","https://www.aldiwan.net/poem65215.html","الرمل"],[28,"ولنا قراسية تظل خواضعا","https://www.aldiwan.net/poem5475.html","الكامل"],[49,"قطعت منك حبائل الآمال","https://www.aldiwan.net/poem63049.html","الكامل"],[66,"سفها إذا شقت عليك جيوب","https://www.aldiwan.net/poem40296.html","الكامل"],[74,"خذها يرن لها الجواد صهيلا","https://www.aldiwan.net/poem13220.html","الكامل"],[102,"شيعي الليل وقومي استقبلي","https://www.aldiwan.net/poem32992.html","الرمل"],[21,"قومي ثقيف إن سألت وأسرتي","https://www.aldiwan.net/poem36139.html","الكامل"],[50,"وخذي ملابس زينة","https://www.aldiwan.net/poem62403.html","مجزوء الكامل"],[15,"لمن الديار بصاحة فحروس","https://www.aldiwan.net/poem45265.html","الكامل"],[76,"حال الزمان فبدل الآمالا","https://www.aldiwan.net/poem39239.html","الكامل"],[68,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem1489.html",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39550","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54283","الكامل"],[106,"حفل المولد","https://www.poetsgate.com/ViewPoem.aspx?id=179555",""],[77,"النصر نصك والحسام دليله","https://www.poetsgate.com/ViewPoem.aspx?id=34198",""],[92,"يَا أيُّها الشَّادِي المغرِّدُ ههُنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14581&r=&rc=26",""],[113,"ما للقلوب من العيون امان","https://www.aldiwan.net/poem40440.html","عموديه"],[158,"أترى النسيم إذا سرى من نجده","https://www.aldiwan.net/poem58724.html","الكامل"],[164,"ولقد تمنيت الجواب فقيل مه","https://www.aldiwan.net/poem47047.html","الكامل"],[164,"ارغب بسمعك عن مقال اللاحى","https://www.aldiwan.net/poem47103.html","الكامل"],[183,"ماذا يقول المادحو","https://www.aldiwan.net/poem14113.html","مجزوء الكامل"],[184,"رحل الفريق فأسرعوا الوخدا","https://www.aldiwan.net/poem43881.html","الكامل"],[195,"كفي الملام وعلليني","https://www.aldiwan.net/poem39948.html","مجزوء الكامل"],[197,"هذا الدجى والهم في صدري","https://www.aldiwan.net/poem45622.html","أحذ الكامل"],[229,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[233,"يا خير منتصر لخير إمام","https://www.aldiwan.net/poem31765.html","الكامل"],[233,"طرقت ودون طروقها","https://www.aldiwan.net/poem32143.html","مجزوء الكامل"],[239,"يا أخت غصن البانة المياس","https://www.aldiwan.net/poem45768.html","الكامل"],[268,"أغنى التقى عن برقع وخباء","https://www.aldiwan.net/poem35588.html","الكامل"],[268,"لأبي عبيدة في دمشق وخالد","https://www.aldiwan.net/poem35645.html","الكامل"],[269,"ضربوا الخيام على الكثيب الاخضر","https://www.aldiwan.net/poem52100.html","الكامل"],[289,"ولقد شهدت الخيل تحمل شكتي","https://www.aldiwan.net/poem552.html",""],[295,"بين العذيب وبين برقة ضاحك","https://www.aldiwan.net/poem33203.html","الكامل"],[303,"لذ بالغرام ولذة الأشواق","https://www.aldiwan.net/poem56443.html","الكامل"],[318,"يا داعي الإيناس قد أبهجتنا","https://www.aldiwan.net/poem67181.html","الكامل"],[324,"قوم إذا نزل الغريب بدارهم","https://www.aldiwan.net/poem43670.html","الكامل"],[351,"وتذكرت عهد الهوى","https://www.aldiwan.net/poem39954.html","مجزوء الكامل"],[351,"راح ساقي الراح يجلو القدحا","https://www.aldiwan.net/poem40540.html","الرمل"],[362,"أهواكم وخيالكم يهواني","https://www.aldiwan.net/poem60621.html","الكامل"],[362,"قربا لي يا صاحبي بعيدا","https://www.aldiwan.net/poem60938.html","الخفيف"],[364,"أجرى على يدي العطا","https://www.aldiwan.net/poem17297.html","مجزوء الكامل"],[374,"قف نبك نفسا عجبها بمماتها","https://www.aldiwan.net/poem66907.html","الكامل"],[406,"لا تحسدن على البقاء معمرا","https://www.aldiwan.net/poem31509.html","عموديه"],[431,"كم كان فيها من كرام سادة","https://www.aldiwan.net/poem25692.html","الكامل"],[459,"ويحل منه نديه","https://www.aldiwan.net/poem15377.html","مجزوء الكامل"],[459,"يا لامحا شبح المسف الأكحل","https://www.aldiwan.net/poem16270.html","الكامل"],[462,"يا من لابيض كل جفن اسود","https://www.aldiwan.net/poem3536.html","عموديه"],[477,"يا أمة شهد الكتاب بفضلها","https://www.aldiwan.net/poem37623.html","الكامل"],[498,"وحي السماء منزل ببيوتنا","https://www.aldiwan.net/poem37804.html","الكامل"],[513,"إن قلت قد خرست خلاخل ساقها","https://www.aldiwan.net/poem12193.html","الكامل"],[527,"وإذا دهتك وساوس أو حيرة","https://www.aldiwan.net/poem37123.html","الكامل"],[549,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[549,"اسعد سعدت بساعة التحويل","https://www.aldiwan.net/poem47276.html","الكامل"],[549,"رضينا من عدانك بالمطال","https://www.aldiwan.net/poem47296.html","الوافر"],[549,"ما ضر من رهب الملوك لو انه","https://www.aldiwan.net/poem47347.html","الكامل"],[549,"إني الشجاع وقد جزعت كما ترى","https://www.aldiwan.net/poem47701.html","الكامل"],[549,"شطت عليك لبانة الصدر","https://www.aldiwan.net/poem47783.html","أحذ الكامل"],[549,"بالله يا أيام يثرب عودي","https://www.aldiwan.net/poem47844.html","الكامل"],[549,"قرت عيون بني النبي محمد","https://www.aldiwan.net/poem47856.html","الكامل"],[549,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[549,"خل المدامع في المنازل تسفح","https://www.aldiwan.net/poem47902.html","الكامل"],[556,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem34658.html","الكامل"],[565,"يا ابن الخلائف من ذؤابة هاشم","https://www.aldiwan.net/poem69573.html","الكامل"],[573,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"]],"verses":[["وَإِذا دَعَوتُ أَجَبنَ غَيرَ شَوامِسٍ","خَفَفَ النِياقِ إِلى رُغاءِ المُصعَبِ",0,"ب",1,0],["وَإِذا دَعَوا وَالخَيلُ في الإِج","فالِ ثابوا أَو أَجابوا",1,"ب",3,0],["وإذا دُعوا لكَريهَةٍ لم ينظُروا ال","إسْراجَ واقْتَصَروا على الإلْجامِ",2,"م",1,0],["وَإِذَا دَعَاهُ الْمُلْكُ مِنْهُ لِلَذَّةٍ","نَاجَاهُ مِنْ تَقْوَى الإِلاَهِ عَذُولُهُ",3,"ل",2,0],["وَإِذا دَعَوتَ وَليدَهُم لِعَظيمَةٍ","لَبّاكَ رَقراقَ السَماحِ أَديبا",4,"ب",2,0],["وَإِذَا دَخَلَتَ فَأُغلِقَت أَبوَابُها","غَرَمَ الغيورُ حِجَابَها فَاعتَلَّتِ",5,"ت",1,0],["وإذا دجا ليل القتام رأيته","وكأنه فيه ذبالٌ مشعلُ",6,"ل",1,0],["وإذا دعا داعي البلاد إلى الوغى","أتظنّ أن هناك مَن يتخلَّف",7,"ف",1,0],["وَإِذا دَفَنتَ أَباكَ فَاِج","عَل فَوقَهُ خَشَباً وَطينا",8,"ن",2,0],["وَإِذا دَعَوتُ الحارِثَينِ أَجابَني","كِندِيُّهُم وَالحارِثُ بنُ الخَزرَجِ",9,"ج",1,1],["وإذا دنَا من لثمِ نعلِك تربهُ","ودّ الموَحدُ لو يكونُ ترَابا",10,"ب",2,0],["وإذا دعوت بنان أَحمدَ جاوبت","سُحب الندى من قبلِ ما سمعَ النَّدا",11,"د",2,0],["وإذا دعى الداعي نزال وجدتهُ","بالرأيِ يطعن واليراع فيهزم",12,"م",1,0],["وإذا دوفِعتْ بهم حُججُ البا","طل كانت رهائن الإدحاض",13,"ض",1,0],["وَإِذا دَعَونَكَ عَمَّهُنَّ فَإِنَّهُ","نَسَبٌ يَزيدُكَ عِندَهُنَّ خَبالا",14,"ل",2,0],["وَإِذاً دُفِعتُ إِلى زَناءٍ بابُها","غَبراءَ مُظلِمَةٍ مِنَ الأَجفارِ",15,"ر",1,0],["وَإِذا داعَبَ النَسيمُ رِدائِيَ","قُلتُ قَد عَلَّمَتهُ هَذا يَداها",16,"ا",3,0],["وَإِذا دارَت كُؤوسي","فَهيَ مِنّي وَإِلَيَّه",17,"ي",2,0],["وَإِذا دَعا بِاِسمي لِيَركَبَ مَركَباً","صَعباً قَعَدتُ لَهُ عَلى سيسائِهِ",18,"ا",3,0],["وإذا دخلتُ إلى البلادِ فإنَّ أَف","كاري تُرَفْرِفُ في سُفوحِ الطُّورِ",19,"ر",1,0],["وَإِذا دامَت قَليلاً","قَتَلَتني شَرَّ قتلَه",20,"ل",2,0],["وَإِذا دَعاكَ إِلى الهَوى","داعي الصِبا لَم تَحفِلِ",21,"ل",1,0],["وَإِذا دَعَوتُ إِلى الوِئامِ فَشاعِرٌ","أَقصى مُناهُ مَحَبَّةٌ وَوِئامُ",22,"م",1,0],["وَإِذا دَجَت أَقلامُهُ ثُمَّ اِنتَحَت","بَرَقَت مَصابيحُ الدُجى في كُتبِهِ",23,"ب",2,0],["وَإِذا دِجلَةُ مَدَّت شَأوَها","وَجَرَت جَريَ اللُجَينِ المُنسَبِك",24,"ك",1,0],["وَإِذا دَعَوتُ بَني فُقَيمٍ جاءَني","مَجرٌ لَهُ العَدَدُ الَّذي لا يُعدَلُ",25,"ل",1,0],["وَإِذا دَعَت خُدَعُ الحَوادِثِ دَعوَةً","شَهِدَت لَهُنَّ مَصارِعُ الأَبطالِ",26,"ل",1,0],["وَإِذا دُعوا يَوماً لِدَفعِ مُلِمَّةٍ","بَسَموا وَفي وَجهِ الزَمانِ قُطوبُ",27,"ب",1,0],["وَإِذا دَعَبتُ وَلا دُعابَةَ غَيبَةٍ","فَاِغضُض هُناكَ مِنَ العَنانِ قَليلا",28,"ل",2,0],["وَإِذا دجلةُ عَذبٌ وِردُها","وَإِذا النَخلُ كَريمُ المَأكِلِ",29,"ل",1,0],["وَإِذا دَعَوتَهُم لِكُلِّ مُلِمَّةٍ","ظَسدّوا شُعاعَ الشَمسِ بِالفُرسانِ",30,"ن",1,0],["وَإِذا دَخَلنا فَاِدخُلي","في الحُمرِ إِنَّ الحُسنَ أَحمَر",31,"ر",1,0],["وَإِذا دَفَعنا لِلحِراجِ فَنَهبُها","أَدنى سَوامِ الجامِلِ المَحلوسِ",32,"س",1,0],["وإذا دعَوْنَكَ عمَّهُنَّ فإنَّهُ","نَسَبٌ يَزيدُكَ عِنْدَهُنَّ خَيالا",33,"ل",2,0],["وإذا دُعيت إلى تناسي عهدِكُمْ","ألْفَيتُ أحشائي بذاكَ شِحاحا",34,"ح",2,0],["وإذا دعتكَ الحادثاتُ فلبِّها","بحميَّةِ المستقتلِ المتفاني",35,"ن",2,0],["وإذا دهتهُ الحادثاتُ بفادحٍ","لم تلق إلاّ هَزّةَ استخفافِ",36,"ف",1,0],["وإذا دعتْه عمامة","خضراءُ، لم يتردَّد",37,"د",1,0],["وإذا دعاه الملك منه للذة","ناجاه من تقوى الإله عذوله",38,"ل",2,0],["وإذا دخلتُ إلى البلاد فإنَّ أفكا","كاري تُرَفْرِفُ في سُفوح الطُّورِ",39,"ر",1,0],["واذا دهاك من الوساوس طارق","فاطرحه فهو الظلم والعدوان",40,"ن",1,0],["وإذا دعوت أجابني بعزيمة","كالسيف حين تسله من غمده",41,"د",2,0],["وإذا دنانيرُ الفَتى رقصَتْ على","أَظفارِهِ خَجلتُ فلوسُ المُفْلسِ",42,"س",1,0],["وإذا دَجا ليلُ الهمومِ فسُل عن","دَنِّ المُدامةِ فالقَ الاصباحِ",43,"ح",1,0],["وإذا دَنوتَ من الوَغَى","فالموتُ أَجْزعُ من تُحارب",44,"ب",1,0],["وإذا دهت طخياء قد نزلت بنا","نهنهتا وكشفتها نقدا",45,"د",2,0],["وإذا دُفِنتُ فَبلّلي","بالدمعِ قَبري واذكُريني",46,"ي",1,0],["وإذا دجا ليلُ الحياةِ فدع","يا ليلُ مصباحاً على قبري",47,"ر",2,0],["وَإِذا دَعاهُ المَرءُ كانَ جَوابُهُ","لَبَّيكَ لِلأَصحابِ وَالغِلمانِ",48,"ن",1,0],["وَإِذا دَجى خَطبٌ فَرَأيُكَ سافِرٌ","وَإِذا عَرى جَدبٌ فَبَحرُكَ طامِ",49,"م",1,0],["وَإِذا دُعوا لِمُلِمَّةٍ","وَثَبو وَإِن سُئِلوا أَجابوا",50,"ب",3,0],["وإذا دَجَت ظُلَمُ الخطوبِ أنارَها","برويّةٍ تحكي ذكاءَ إياسِ",51,"س",1,0],["وإذا دَعا الوطنُ المقدَّسُ لم أكن","إِلا لأطلُبَ في القِتالِ شَفائي",52,"ا",2,0],["وإذا دُعيتَ الى الكَرِيهةِ كَن لها","بطلاً فأحقِر بالجبانِ القاعد",53,"د",1,0],["واذا دَعوتك للملمه فاِستَجِب","واذا انتصرت بجاه وَجهك فانصر",54,"ر",1,0],["وَإِذا دُعِيتُ إِلى النِّزالِ فَإِنَّنِي","في القَومِ أَولُ مَن يُجِيبُ وَيَنزِلُ",55,"ل",1,0],["وإِذا دَعاكَ لبيع نفسِكَ سائِمٌ","في حبِّها يَوماً فبِعه وَبارِكِ",56,"ك",1,0],["وَإِذا دَعاكَ إلى الصبا نفسُ الصبا","فَأجِب رَسولَ نسيمهِ الخفّاقِ",57,"ق",1,0],["وَإِذا دُعيتُ لِأَن تُبَشِّرَ ثانِياً","اِرخِ نِعَمٌ وافَت نَجيبَ الثانِيَه",58,"ي",2,0],["وإذا دعوتهم ليوم كريهة","سدّوا شعاع الشمس بالفرسان",59,"ن",1,0],["وَإِذا دَعاك إِلى الثَنا","ذكر الصَديق وَهيَّما",60,"م",2,0],["وَإِذا دارَت كؤوس الأنسِ كُن","بَينَ أَكواب الطلا قطب الرَحى",61,"ح",2,0],["وإذا دَعَوْتُ إلى المُهمِّ أجابنَي","فكَفاهُ لا وانٍ ولا مُتَوان",62,"ن",1,0],["وإذا دبّروا الممالك بالرأْ","يِ وقد همَّ كائدٌ أَن يكيدا",63,"د",2,0],["وَإِذا دُعيتُ بِعَبدِهِ","لَبَّيتُ دَعوَةَ مَن دَعاني",64,"ن",2,0],["وإذا دجا ليل الرذيلة حدَّقت","حدقاته ويقول نحوي هاتها",65,"ت",3,0],["وإذا دعوت بطول عمر لامرئ","فاعلم بأنك قد دعوت عليه",66,"ه",1,0],["وَإِذا دَجا اللَّيْلُ البَهيمُ رَأَيْتَهُمْ","مُتَبَتِّلينَ تَبَتَّلَ الرُّهْبانِ",67,"ن",1,0],["واذا دَجا ليلُ الخُطوبِ","وساورَ الأحْياءَ ضُرُّ",68,"ر",1,0],["وإذا دجا الخطب البهيمُ وأغْدفتْ","شمس الرَّجاء نِقابَ ليلٍ ألْيَل",69,"ل",1,0],["وإذا دجا ليل العجاج سلكته","منه بغرّة كوكبٍ متوقد",70,"د",1,0],["وإذا دعيت إلى المبرة لا تقل","إن العطاء يجر للإفلاس",71,"س",1,0],["وإذا دَعا الباري بنا وبأَهلِنا","ذو نِيَّةٍ صافي السَّريرَةِ يُقْبَلُ",72,"ل",1,0],["وإذا دعوت لها فقد وفيتها","بل زدتها شرفاً على استحقاقها",73,"ق",3,0],["وَإذا دَهَتْكَ وَسَاوِسٌ أَوْ حِيرَةٌ","فَاحْزِمْ بِنَفْسِكَ أَحْزَمَ الطّرَفَيْنِ",74,"ن",1,1],["وأُذادُ حين أُذادُ عن أمواهكمْ","وأُصدّ عن باب اللّقاءِ وأُحْرَمُ",75,"م",1,0],["وإذا دخلتَ إلى رباعك كان ذي","ياك الدّخولُ لديك خيرَ دخولِ",76,"ل",1,0],["وإذْ أُدْمُ المطيِّ معقّلاتٌ","على وادي مِنىً بيد الكلالِ",77,"ل",1,0],["وإذا دعوتَ سوى الإلهِ فإنّما","صَيّرتَ للرحمنِ فيك شريكا",78,"ك",2,0],["وإذا دنا الأجل المقدَّرُ للفتى","لم أُنْجِهِ منه وضاع دِفاعي",79,"ي",1,0],["وَإِذا دَعوتهُمُ لنازلةٍ","حشدوا عليك بقُرَّحٍ ضُمْرِ",80,"ر",1,0],["وإذا دموعِي يومَ سِلنَ شهدن بال","وجدِ المبرّح لم يُفدْكَ جُحودِي",81,"د",2,0],["وَأُذادُ عن وِرْدِي وَبي صدأٌ وكمْ","ظمآنِ قومٍ كان غيرَ مَذودِ",81,"د",1,0],["وإذا دُعوا لِمُلِمّةٍ فكأنّما","فُجرتْ لها دُفَعُ الغمام المُزْبدِ",82,"د",1,0],["وَإِذا دَنوتُ إلى الرِّواقِ مسلِّماً","أقذيتَ بِي فيه نواظرَ حُسّدِي",82,"د",2,0],["وَإِذا دعا وجْداً يُدِلُّ بهِ","عند المنيّةِ خانَهُ الوُجْدُ",83,"د",1,0],["وإذا دَعوتَهُمُ لنصرك من ردىً","جاءتْ إليك بهمْ جِيادٌ قُرَّحُ",84,"ح",1,0],["وإذا دعيت إلى تناسي عهدكم","لا أستطيع وأنثني ملتاحا",85,"ح",2,0],["وَإِذَا دَعَاهُ الْبًَازِيَارُ رَأَيْتَهُ","أَدْنَى وَأَطْوَعَ مِنْ مُحِبَّ وَامِقِ",86,"ق",1,0],["وإِذَا دُمْتَ لي تَعَجَّلت أَجْرِي","أَنْتَ لي جَنَّةٌ وجُودكَ كَوْثَرْ",87,"ر",1,0]]}