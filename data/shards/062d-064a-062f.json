{"poems":[[107,"هم سادة الحرب من شيب وشبان","https://www.aldiwan.net/poem43573.html","البسيط"],[107,"لمن الجموع كثيرة تتألب","https://www.aldiwan.net/poem44040.html","الكامل"],[21,"اصبر النفس عند كل ملم","https://www.aldiwan.net/poem36167.html","الخفيف"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62293","الرمل"],[370,"أبني زياد أنتم في قومكم","https://www.aldiwan.net/poem44533.html","الكامل"],[435,"حي دارا للمعالي","https://www.aldiwan.net/poem40800.html","مجزوء الرمل"],[505,"ته غراما فللغرام رجال","https://www.aldiwan.net/poem37808.html","الخفيف"],[519,"شرف الوجه في تراب زرود","https://www.aldiwan.net/poem20806.html","الخفيف"],[519,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[519,"حيدري عم نائله","https://www.aldiwan.net/poem20843.html","المديد"],[519,"حيدري عم نائله","https://www.aldiwan.net/poem20849.html","المديد"],[563,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122640","المديد"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56069","الرمل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109125","الكامل"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/20016","الكامل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93125","الرمل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132227","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66299","الرمل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100180","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205923","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114050","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90814","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72414","الرمل"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102016","الرمل"],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101933","الرمل"],[5183,"عواطف الإخاء","https://www.poetsgate.com/ViewPoem.aspx?id=180212",""],[5652,"لاهو ب رجالٍ ولاهو رجيجيل","https://www.poetsgate.com/ViewPoem.aspx?id=198328",""]],"verses":[["حِيدي جُهَيْنَةُ أو بِيدي مُذَمَّمةً","حُمَّ القضاءُ وخَفَّتْ أُسْدُ خفّانِ",0,"ن",1,0],["حِيدُوا جُنودَ اللّهِ ثمّ تَقَدَّمُوا","فالحربُ في أطوارِهَا تَتقلَّبُ",1,"ب",1,0],["حَيِّ داودَ وَاِبنَ عادٍ وَموسى","وَفُرَيعٌ بُنيانُهُ بِالثِقالِ",2,"ل",1,0],["حَيِّ دَارَ الحَيِّ لاَ دَارَ بِهَا","بِسِخَالٍ فَأُثَالٍ فَحَرِمْ",3,"م",1,1],["حُيُدٌ عن المعروفِ سَعيُ أبيهِمُ","طَلَبُ الوُعولِ بوَفضَةٍ وَبأكلُبِ",4,"ب",1,0],["حيّ داراً للمعالي","أصبحت خير مقام",5,"م",1,1],["حَيْدَرِيُّ الأَسرارِ سَبَّارُ غايا","تِ المَعالي قَوَّالُها الفَعَّالُ",6,"ل",1,0],["حيدَريٌّ إذا الأكارِمُ عُدّوا","كان منها مكان بيتِ القَصيدِ",7,"د",1,0],["حيدريٌّ أوشكَتْ راحاتُه","تلتَظي نيرانُها لولا نَداها",8,"ا",3,0],["حَيدَرِيٌّ عَمَّ نَائِلُهُ","ذُو المَعَالِي البَاهِرَاتِ عَلِي",9,"ل",2,1],["حَيدَرِيٌّ عَمَّ نَائِلُهُ","فَلَكِيَّاتٌ مَرَاتِبهُ",10,"ب",2,1],["حيدَ عنه وقيل صبر جميل","حرم نحن فيه والغير في الحلّْ",11,"ل",1,0],["حَيدَرىيُّ البَأسِ إن خَنَسَت","فيه أفراسٌ وإفراسُ",12,"س",1,0],["حيدر الباس الشهابيّ الذي","أشرقت أنواره كالقبسِ",13,"س",1,0],["حيدي إذا أغضبته من دربه","وإذا هي احتدمت فخذ من دربها",14,"ب",3,0],["حيدى حَيادِ فَإِنَّ غَزوَةَ جَيشِهِ","ضَمنَت لِجائِلَةِ السِباعِ عِيالَها",15,"ل",3,1],["حيدرٌ لو أن عينيك تراه","دامياً قد رَّضت الخيل قراه",16,"ه",1,0],["حيدريّ إذا الأكارم عدوا","كنت منهم بيت القصد العلاء",17,"ا",2,0],["حيدر سيّر نوحاً حين","أودى الفلكَ نوح",18,"ح",1,0],["حيدر نجى خليل","الله والنار لموح",18,"ح",1,0],["حيدر أنطقه في الم","هد طفلاً وهو روح",18,"ح",1,0],["حيدر للمصطفى الم","ختار بالنفس سموح",18,"ح",1,0],["حيدر قد ردَّ يوحاً","مذ هوت للغرب يوح",18,"ح",1,0],["حيدري يروي العلي عن وصي","عن نبي هادٍ بشير نذير",19,"ر",1,0],["حيِّ دار العمال بالإقبال","وتَرَقَّب لها بلوغ الكمالِ",20,"ل",1,1],["حِيدِ وهوَ المحجَّةُ البَيضَاءُ","لَهُ فِي كُلِّ الخَافِقَينِ استَبَانَت",21,"ت",1,0],["حيدريون مهدوبون من كل","فتى حازم بعزم الأمور",22,"ر",1,0],["حيدر الكرَّار جدي لي في عقد ولاه","يد جبار سموات المعالي شكت",23,"ت",1,1],["حيدر الكرار حامي الجار وال","قاسم للجنة والنار سهاما",24,"م",2,0],["حيدر فهو زيري في الوغى","ووصي فيكم بعد الممات",25,"ت",1,0],["حيّ دمشق ومن ربته منهمر","يهمي على غوطتيها الحين فالحينا",26,"ن",2,0],["حيدآ تسابِق له جموع الرجاجيل","ثابت على الوقفات ماله زحايا",27,"ا",3,0]]}