{"poems":[[79,"لنا في الفخر أسنمة مطلة","https://www.aldiwan.net/poem36334.html","الوافر"],[39,"تحجى أبوها من أبوهم فصادفوا","https://www.aldiwan.net/poem7597.html","مجزوء الكامل"],[74,"أخا اللوم لا تتعب لسانا ولا ذهنا","https://www.aldiwan.net/poem20176.html","الطويل"],[74,"تعشقته غصنا ناضرا","https://www.aldiwan.net/poem20572.html","المتقارب"],[87,"أعرني النجم أوهب لي يراعا","https://www.aldiwan.net/poem7102.html","الوافر"],[45,"نعد المشرفية والعوالي","https://www.aldiwan.net/poem9758.html","الوافر"],[47,"يا فضل فيما الصدود والغضب","https://www.aldiwan.net/poem11496.html","المنسرح"],[47,"أريتك الآن ألمع البروق","https://www.aldiwan.net/poem65178.html","السريع"],[68,"تحجر فيك طبع الشح يبسا","https://www.aldiwan.net/poem38616.html","الوافر"],[68,"وحق الهوى ما حلت يوما عن الهوى","https://www.aldiwan.net/poem39641.html","الطويل"],[48,"لعمري لقد طال هذا السفر","https://www.aldiwan.net/poem22748.html","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54565","الوافر"],[113,"تحجب عني الطيف حتى كأنه","https://www.aldiwan.net/poem16587.html","الطويل"],[119,"سلام من فؤاد مستهام","https://www.aldiwan.net/poem41683.html","الوافر"],[136,"ما للشجى على برح الغرام يد","https://www.aldiwan.net/poem54853.html","الطويل"],[164,"قوامك مثل معتدل القناة","https://www.aldiwan.net/poem59052.html","الوافر"],[203,"رحيق كماء الشباب","https://www.aldiwan.net/poem45360.html","مجزوء المتقارب"],[226,"ظهرت والفريق في دعة","https://www.aldiwan.net/poem55271.html","المنسرح"],[240,"قفوا تعجبوا من سوء حالي ومن ضري","https://www.aldiwan.net/poem31944.html","الطويل"],[266,"ألم بنا يختال غير ملوم","https://www.aldiwan.net/poem38190.html","الطويل"],[280,"ولا ودعوا يوم النوى جارة الحمى","https://www.aldiwan.net/poem25412.html","الطويل"],[280,"تخيرت مختار الخليفة للعهد","https://www.aldiwan.net/poem25584.html","الطويل"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[333,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[385,"تحجبت يا ناظري","https://www.aldiwan.net/poem48790.html","مجزوء المتقارب"],[406,"أيها القانون","https://www.aldiwan.net/poem6781.html","عموديه"],[466,"ذريني وأهوالي نفر ونلتقي","https://www.aldiwan.net/poem15283.html","الطويل"],[505,"عليك سلام الله أفرطت يا مي","https://www.aldiwan.net/poem37725.html","الطويل"],[509,"سروري وذوقي من جمالك صادر","https://www.aldiwan.net/poem38406.html","الطويل"],[563,"لحرب نفوسنا قد جاء فارس","https://www.aldiwan.net/poem34448.html","الوافر"],[567,"شكا من أذهب البلوى وزالت","https://www.aldiwan.net/poem52835.html","الوافر"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126704","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38880","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67835","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67829","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59421","البسيط"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80227","الوافر"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25326","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56029","الطويل"],[1318,"","https://poetry.dctabudhabi.ae/diwan/poem/145332","الطويل"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132883","الطويل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95545","البسيط"],[1993,"","https://poetry.dctabudhabi.ae/diwan/poem/199034","الطويل"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76797","البسيط"],[2029,"","https://poetry.dctabudhabi.ae/diwan/poem/123722","الوافر"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87687","الوافر"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140053",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204791","المتقارب"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147354","الطويل"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140310",""],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87381","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138702",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216738","السريع"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85116","المجتث"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44672","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72823","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72788","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139622",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52139","الطويل"],[4578,"تذكرت شرقيّ الحمى من أحبه","https://www.poetsgate.com/ViewPoem.aspx?id=49354",""],[5002,"حقّ الحبِّ...","https://www.poetsgate.com/ViewPoem.aspx?id=202378",""],[5152,"رجع الصدى","https://www.poetsgate.com/ViewPoem.aspx?id=184335",""],[5431,"فتطوى له الأكوان طيّ الشرائح","https://www.poetsgate.com/ViewPoem.aspx?id=192308",""],[5691,"تحجر العُرْبُ","https://www.poetsgate.com/ViewPoem.aspx?id=206096",""],[5691,"خمسون عاماً...!","https://www.poetsgate.com/ViewPoem.aspx?id=206746",""],[5957,"أمل الدُنيا","https://www.poetsgate.com/ViewPoem.aspx?id=22805",""],[5991,"لقد كنا حروفاً عاليات","https://www.poetsgate.com/ViewPoem.aspx?id=116383",""],[6032,"نجم العشاق","https://www.poetsgate.com/ViewPoem.aspx?id=181517",""],[6093,"تحج نوايا لا مطايا تقلها","https://www.poetsgate.com/ViewPoem.aspx?id=205931",""],[6259,"أبان لنا من دره يوم ودّعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59387&r=&rc=35",""]],"verses":[["تَحُجُّ بُيُوتَنَا الْقُصَّادُ دَأباً","فَلاَ تَنْفَكُّ طَائِفةً مُهِلَّهْ",0,"ل",2,0],["تحجى أبوها من أبوهم فصادفوا","سواه ومن يجْهَل أباه فقد جهِلْ",1,"ل",1,1],["تحجبه عنا الأسنَّة والظبا","وأفتك منها لحظ من حجبت عنَّا",2,"ن",2,0],["تحجب دون القنا شخصه","فصفرة لونيَ شوقاً إليه",3,"ي",2,0],["تَحَجَّبُ عن بحار الله حتى","إذا خطرت به نضت القناعا",4,"ع",2,0],["تُحَجَّبُ عَنكِ رائِحَةُ الخُزامى","وَتُمنَعُ مِنكِ أَنداءُ الطِلالِ",5,"ل",1,0],["تَحجِزُني عَنكَ حُرمَةٌ قَدُمَت","وَخُلَّةٌ ما يَشينُها كَذِبُ",6,"ب",1,0],["تَحُجُّهُ الأَركُبُ مَخشوشَةً","رُكبانُها مِن كُلِّ فَجٍّ عَميق",7,"ق",1,0],["تَحَجَّرَ فيكَ طَبعُ الشُحِّ يَبساً","وَذاكَ لِأَنَّ كَفَّكَ فيهِ قَبضُ",8,"ض",1,1],["تَحَجَّبتِ عَن عَيني فَأَيقَنتُ بِالشَقا","وَآيَسَني فَرطُ الحِجابِ مِنَ البَقا",9,"ق",2,0],["تَحَجُّبُ دُنياكَ عَن طالِبٍ","وَلَيسَ تَحَجُّبُها مِن خَفَر",10,"ر",1,0],["تُحَجِّبُكِ الجَلاَلَةُ فِي سُفُورٍ","وَتَجْلُوكِ النَّبَالَةُ فِي الحِجَابِ",11,"ب",1,0],["تَحجب عَني الطَيف حَتّى كَأَنَّهُ","تَخيل إِنساني عَلَيهِ رَقيبا",12,"ب",2,1],["تحجب بالشهامة وهو كهل","وقام بدرها قبل الفطام",13,"م",1,0],["تحجب وهو بدر عن حياء","وغيب تحت خدر الاحتشام",13,"م",1,0],["تَحجُو العواذِل ما يَلقَى العمِيدُ دَداً","مِنهُ وما فِآ الذي يَلقى العميدُ دَدُ",14,"د",1,0],["تحج لك الورى من كل أرض","فقد أدموا ظهور اليعملات",15,"ت",1,0],["تحجبها كفهُ","وفي خدِّهِ تظهرُ",16,"ر",1,0],["تحجب في الجو عنك أنجمه","فلا ترى نسره ولا زحله",17,"ل",2,0],["تَحَجَّبتِ عَن مَرأى العُيونِ جَلالَةً","وَعِزّاً فَمِن خِدرٍ نُقِلتِ إِلى خِدرِ",18,"ر",1,0],["تحجب عني الصبح فيها كأنه","سريرة حب في فؤاد كتوم",19,"م",1,0],["تَحَجَّبَ فِي بَيتِ الحُكومَةِ قاسِط","وَوَاكف عَدل فِي القَضا هاتِن الرعدِ",20,"د",1,0],["تَحُجُّ مَعالِيهِ المُلوكُ فَتَنْثَنِي","صُمُوتاً وَإن كانَت أُلِي أَلْسُنٍ لُدِّ",21,"د",1,0],["تَحجو حقيقَتُها الوجودَ وَلَو دَرَت","مَعنى الوجودِ لكانَ فيه المقنعُ",22,"ع",1,0],["تحجّ إليك بآهاتها","لتنقذها من أفاعي الظلام",23,"م",1,0],["تَحجبت يا ناظِري","عَن الناظر الساهر",24,"ر",1,1],["تَحْجِبُ العَالِمَ والشَّيخ وتُبقي","واهِماً منطقه ضَربُ مُحال",25,"ل",1,0],["تُحجِّبهُ عند المقام سُتورُهُ","وفي الحرب أستار العجاجِ المروَّقِ",26,"ق",1,0],["تَحَجَّبْتِ عنهمْ بالذَّوائِبِ فانْبَروا","وقد عَمَّهُمْ من لَيلِ سابِحِها غَيُّ",27,"ي",1,0],["تحجب من تعظيمه هو الخطا","مراعاة تعظيم سواه كباير",28,"ر",1,0],["تحجب فالعقول عليه ضلت","ولا يدريه إلا من يمارس",29,"س",1,0],["تحَجَّبَ كالسَّرارِ فعادَ بَدْراً","وكانَ لِقاهُ أشهَى في المَعادِ",30,"د",1,0],["تحجّب بدرُ التمّ في بقعة الثرى","ومنهُ المحيّا عاد وهو مترّبُ",31,"ب",1,0],["تحج قلوب للأحبة حنت","بنى اللَه بيتا في غيابة تيهه",32,"ه",1,0],["تحجبت في اكوان كون تكويني","وفي غيبة غابت عيون تعيني",32,"ي",1,0],["تَحَجَّب عَن عَيني فَزادَ بِيَ الجَوى","وَضاقَت بِيَ الدُّنيا وَزادَ التحيُّرُ",33,"ر",1,1],["تَحُجُّ لَهَ الرُّكْبَانُ شَوْقاً عَلىَ الْقَصِّ","نَبيٌّ لَهَ جُودٌ رَحِيبٌ فِنَاؤُهُ",34,"ه",1,0],["تَحُجُّ لَهُ الرُّكْبَانُ مِنْ كُلِّ وِجْهَةٍ","وَلَوْلاَهُ لَمْ نَعْْرِفْ سُجُوداً لِقِبْلَةٍ",35,"ه",1,0],["تحجبت بسنا الأرواح صورتها","عن العقول فأبدتها اللطافات",36,"ت",1,0],["تَحجَّب في السَماءِ البَدرُ لَما","بَدا القَمران في هَذا المَكانِ",37,"ن",1,0],["تَحْجُرُ مِنْهُ الطَيْرُ كَلَّ مِحجَرِ","يُولِجْن أَعْناقاً كَسُوق الهَيْشَرِ",38,"ر",1,0],["تحجّبت يا صوصا بترب تعمّمت","بعفوٍ ورضوانٍ ولطفٍ ورحمةِ",39,"ه",1,1],["تحجب في وقت الحجاب فلا ترى","وتنبت في وقت اللقاء من الأرض",40,"ض",1,1],["تحُجُّ لها الآمالُ من كُلَّ وجهةٍ","وينحَرُ في حافاتها البخلُ والمحلُ",41,"ل",1,0],["تحج دارهُمُ الطراق صاديةً","لعذب منهلهم والفضل رّيانُ",42,"ن",1,0],["تحج إليها العيس في كل بلدة","مقام جلال بات شاهده الحجر",43,"ر",1,0],["تحجب الشعر عن قوم وقد جهدوا","وعندما جئته أبدى محياه",44,"ا",2,0],["تحجبتم دلالاً في جمال","أما لشموس حسنكم طلوع",45,"ع",1,0],["تَحجَّب ثُم أَسفَر لا يُبالي","وَفي الحالين كان عَليَّ جاني",46,"ن",2,0],["تحجب طيفه عني دلالا","وذاك لعلمه أني مشوق",47,"ق",1,0],["تحجرن مثل حجار القصور","وإن رحبت في اللقا تسخر",48,"ر",1,0],["تَحُجُّ إِلَى أَزْهَارِ نَفْسِي رَطِيْبَةً","بِأَنْغَامِيَ اللاتِيْ هَتَفْنَ بِمَقدَمِيْ",49,"م",2,0],["تحجبي يا ابنة الفرس الذين رأوا","إن السفور رقي الخرد العين",50,"ن",1,1],["تحجَّبُ فيها الشمس عن اعين المَهى","وَقَد رقَبتها عينُ حرباءِ تَنضُبِ",51,"ب",1,0],["تحجبا عن الأنام والقضا","إذا جرى على امرئ لن يحجبا",52,"ب",2,0],["تحجبني حيناً ولكنني","أزجيك للخيرات والنال",53,"ل",1,0],["تحجب البدر لما","أراد يحكي كماله",54,"ل",2,0],["تَحجُّ إِلى البَيتِ الحَرامِ تَنسُّكاً","وَلِلشَعبِ مِن ضَغطِ العَدوِّ أَنينُ",55,"ن",1,0],["تحجبَ فيها الفجر حتى كأنه","سريرةُ صب اضفرتها الغلائِلُ",56,"ل",1,0],["تحجّبَ فيها الفجر حتى كأنهُ","سريرةُ صبٍّ لم يذعها كتومهُ",57,"م",2,0],["تحجُّ إليها الناس تقطع سبسباً","ومهمةَ قفرٍ لا يُجاز وفدفدا",58,"د",2,0],["تحجّبْ كما تَهْوَى وصُلْ واحتكم ولا","تحاذرْ بَلاءً واغنَمِ العيشَ منعَما",59,"م",2,0],["تحجبه عن أعين الناس هيبةٌ","وما حال يوماً دون راجيه حجبه",60,"ب",2,0],["تحْجُبُ الأعمارَ التي صارَ فيها","جَمُّ ذكريات وكانت لمَذهبْ",61,"ب",1,0],["تَحَجَّرَتْ رقتي في سُحبِ قافيتي","وَغَصَّ صوتُ الصفا في قَطْرِيَ النائي",62,"ا",3,0],["تحجُّ إلى عينيك كلّ جوارحي","وتسكن عمق الروح تغزو ملامحي!",63,"ح",2,1],["تحَجَّرَ العُرْبُ ألْباباً وأفْئِدَةً","ولا بَقاءَ لمَيْتِ اللبِّ والقلْبِ !",64,"ب",1,0],["تحجَّرَ الوجهُ مذ ضاعتْ بشاشتُهُ","بين الهموم وأعْياني تحجُّرُهُ",65,"ر",2,0],["تحجب الأوجاعَ تبدو كالسنا","يتراءى الداء في الشدو كعيدْ",66,"د",1,0],["تحجبنا بنا إنا لدينا","وقعنا بعده في المشكلات",67,"ت",1,0],["تحجّرت ِ المآقي َ عن هطول","وقد كانتْ بأدمُعها تَجود",68,"د",1,0],["تحجُّ نَوايا لا مَطَايا تُقِلُّهَا","لها الشوقُ سَرْجٌ والتَّشَوُّفُ خَيْلُهَا",69,"ل",3,1],["تحجّبنَ ما يطلعنَ إلا لنيّة ٍ","بنفسي شموسٌ تجعلُ الغرب مطلعا",70,"ع",2,0]]}