{"poems":[[55,"ألا لله بادرة الطلاب","https://www.aldiwan.net/poem30747.html","الوافر"],[65,"ومتيم زهرت بواقصة له","https://www.aldiwan.net/poem46148.html","الكامل"],[65,"سرت والليل يرمز بالصباح","https://www.aldiwan.net/poem46156.html","الوافر"],[65,"إذا استلب النوم العنان من اليد","https://www.aldiwan.net/poem46176.html","الطويل"],[90,"لنا ملك وليس له رعايا","https://www.aldiwan.net/poem44793.html","الوافر"],[66,"قلوب العاشقين لها عيون","https://www.aldiwan.net/poem67541.html","الوافر"],[80,"لقد حصلت يا رنده","https://www.aldiwan.net/poem14257.html","مجزوء الوافر"],[82,"رعى ورق البيض الذي زهره دم","https://www.aldiwan.net/poem31308.html","الطويل"],[48,"أم الكتاب إذا قومت محكمها","https://www.aldiwan.net/poem23089.html","البسيط"],[48,"أمالي الزمان على بنيه","https://www.aldiwan.net/poem23236.html","الوافر"],[78,"شبابي كيف صرت إلى نفاد","https://www.aldiwan.net/poem39439.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85329","الكامل"],[92,"أطِل مكثاً","https://www.poetsgate.com/ViewPoem.aspx?id=179234",""],[124,"أمطروا الدمع عليه لا الندى","https://www.aldiwan.net/poem49303.html","الرمل"],[164,"خذوا لي من سعدى أمانا من الهجر","https://www.aldiwan.net/poem59078.html","الطويل"],[202,"الجيش يملي نصره الملوان","https://www.aldiwan.net/poem51881.html","الكامل"],[242,"أهاجك بينهم إذ نأوا","https://www.aldiwan.net/poem19741.html","المتقارب"],[255,"ضحك الروض من بكاء السحاب","https://www.aldiwan.net/poem14925.html","الخفيف"],[259,"أقبلي","https://www.aldiwan.net/poem25015.html","مجزوء الرمل"],[275,"يا مي أفنى مهجتي التعليل","https://www.aldiwan.net/poem35580.html","الكامل"],[276,"لي في نوالك يا مولاي آمال","https://www.aldiwan.net/poem52046.html","البسيط"],[290,"فغدت رياض العلم مزهرة فيا","https://www.aldiwan.net/poem39340.html","الكامل"],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[382,"قد حاز يوحنا الجنين كماله","https://www.aldiwan.net/poem59246.html","الكامل"],[398,"يا زائرا قد قصد المشاهدا","https://www.aldiwan.net/poem53586.html","الرجز"],[412,"حازك البين حين أصبحت بدرا","https://www.aldiwan.net/poem50175.html","الخفيف"],[445,"عزاء وأنت عزاء الجميع","https://www.aldiwan.net/poem34774.html","المتقارب"],[445,"إذا سقيت أرض فقد بشرت أرض","https://www.aldiwan.net/poem34784.html","الطويل"],[445,"قل للربيع اسحب ملاء سحائب","https://www.aldiwan.net/poem34876.html","الكامل"],[445,"جهادك حكم الله من ذا يرده","https://www.aldiwan.net/poem34888.html","الطويل"],[457,"اعمل لنفسك ما استطعت","https://www.aldiwan.net/poem13666.html","مجزوء الكامل"],[466,"أما اذا سلم الامام الأعظم","https://www.aldiwan.net/poem16018.html","الكامل"],[484,"القول كالبرق والأعمال كالمطر","https://www.aldiwan.net/poem37185.html","البسيط"],[498,"ونرجس لم يعد مبيضه","https://www.aldiwan.net/poem67401.html","السريع"],[549,"ثمالة الأمل","https://www.aldiwan.net/poem67253.html","عموديه"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87185","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86818","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64038","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38131","الطويل"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119343","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59414","السريع"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64928","الخفيف"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93100","الوافر"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82600","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26415","الكامل"],[1946,"","https://poetry.dctabudhabi.ae/diwan/poem/203922","المنسرح"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114701","الكامل"],[1965,"","https://poetry.dctabudhabi.ae/diwan/poem/102726","المتدارك"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130845",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94274","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93866","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65137","الكامل"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48285","الكامل"],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21381","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86527","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77180","الطويل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78358","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90957","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94482","الوافر"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33069","المنسرح"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73265","الطويل"],[4428,"","https://poetry.dctabudhabi.ae/diwan/poem/124623","الطويل"],[5089,"عرِّجْ على هذا الجمال الأقدسِ","https://www.poetsgate.com/ViewPoem.aspx?id=128710",""],[5149,"إسمَعْ حَديثي","https://www.poetsgate.com/ViewPoem.aspx?id=211187",""],[5149,"أيها القدرُ","https://www.poetsgate.com/ViewPoem.aspx?id=212221",""],[5285,"سموم الأفاعي","https://www.poetsgate.com/ViewPoem.aspx?id=203536",""],[5302,"سأمضي","https://www.poetsgate.com/ViewPoem.aspx?id=200676",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5363,"بالعلم يرقى الناس","https://www.poetsgate.com/ViewPoem.aspx?id=200047",""],[5459,"عَابُوكَ ..","https://www.poetsgate.com/ViewPoem.aspx?id=212859",""],[5818,"البنات كالنبات","https://www.poetsgate.com/ViewPoem.aspx?id=181760",""],[5956,"كبرياء","https://www.poetsgate.com/ViewPoem.aspx?id=182491",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6004,"جَنَّةٌ للنِّسَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=59595",""],[6102,"قافية خضراء","https://www.poetsgate.com/ViewPoem.aspx?id=184629",""],[6160,"في سُقُوطِ الظِّلِّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87083&r=&rc=0",""],[6259,"حازكِ البينُ حين أصبحت بدراً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59372&r=&rc=20",""]],"verses":[["وَأَجنُبُ بَينَها خُرقَ المَذاكي","فَأَملي بِاللُغامِ عَلى اللُغابِ",0,"ب",1,0],["واجْنُبْ أخاكَ كُلَّ حادِثِ نِعْمَةٍ","آنَسْتَهُ فَجَزاكَ بالإيحاشِ",1,"ش",1,0],["وأجنحَةُ النّجومِ يَمِلْنَ زُوراً","لهُنَّ تَخاوُصُ الحَدَقِ المِلاحِ",2,"ح",1,0],["وأَجْنُبُهُ الرِّيَّ الذّليلَ وقد جَلَتْ","على الوِرْدِ أنْفاسُ الصَّبا مَتْنَ مِبْرَدِ",3,"د",1,0],["وأجناد وليس لهم سلاح","ومملكة وليس بها نقود",4,"د",1,0],["وَأَجنِحَةٌ تَطيرُ بغَيرِ ريشٍ","إِلى مَلَكوتِ رِبِّ العالِمينا",5,"ن",2,0],["وَأَجنادٌ أَشِدَّاءٌ","إِلَيهِم تَنتَهي الشِدَّهْ",6,"د",2,0],["وَأَجنِحَةُ الراياتِ فينا خوافقٌ","كأنّ دَمَ الأبطال فيهنّ عَنْدَمُ",7,"م",1,0],["وَآجِنٌ حَوضُكَ المَلآنُ مِن أَسَنٍ","وَقَد تَشَهَّرَ بِالإِشراقِ صافيكا",8,"ك",2,0],["وَأَجنِحَةُ النُسورِ إِذا أَتَتها","مَناياها كَأَجنِحَةِ النِمالِ",9,"ل",1,0],["وَأَجْنُبُهُ فَيُعْطيني قِياداً","وَيَجْنُبُني فَأُعْطيهِ قِيادِي",10,"د",2,0],["وأجنَّه والهم ليل أليلٌ","قد شَفَّ عن أزمات يوم أيوم",11,"م",1,0],["وأجنِحةً وإن طُويَتْ ففيها","على الأجيالِ ، قادِمةً ، رفيف",12,"ف",1,0],["وأجنوه وإن كان صدى","فسحة الآباد لا ضيق القبور",13,"ر",1,0],["وأجني ثمار الوصل منها وقد دنت","سوالف بحر من مشوق إلى بحر",14,"ر",1,0],["واجنبْ إلى الهيجاءِ كلَّ كتيبةٍ","واخفضْ إلى الهيجاءِ كلَّ عنان",15,"ن",1,0],["وَأَجْنَوْكَ رَوْضَةَ وَصْلِهِمُ","بِمَا مِنْ ثِمَارِ الْمُنَى قَدْ جَنَوْا",16,"و",2,0],["واجنِ باكورة الزمان بشُرب ال","رَّاح فالدهرُ آيلٌ للذهابِ",17,"ب",1,0],["واجْنَحي للسِّلْمِ دَوْماً","وانْعَمي حيناً بقربي.",18,"ب",2,0],["واجني الأزاهرَ وانشُقي منها الشَّذا","ما دامَ غصنُ القدِّ منكِ يميل",19,"ل",1,0],["واجنبني العجب وَالشح المطاع وَمر","نَفسي تخالف هواها فهو قنال",20,"ل",1,0],["واجن الهدى برياض مكتبة بها","كتب برونية عماد الطالب",21,"ب",1,0],["وأجن ثِمارَ النجح كفّ رجائِها","ليعلمَ واعٍ أنّه رائدٌ خصبا",22,"ب",2,0],["وأَجَنَّ روحَ القدس حين أَجنَّه","رَحِمٌ جَنَتْهُ مكبَّلاً في رحْمِهِ",23,"م",2,0],["وَاِجنَب إِلى الصَحراءِ بِالبَقيعِ","فَثَمَّ أَرضُ الشرفِ الرَفيعِ",24,"ع",1,0],["وَاِجنَب إِلى بَغداد بَعدُ العيسا","مُسَلِّما عَلى الزَكِيِّ موسى",24,"س",2,0],["واجنُبِ الخَيلَ فَوقَ كُلِّ نجاةٍ","تَكتَسي بِالسَرابِ طوراً وَتعرى",25,"ر",2,0],["وأجنادِهِ فِي فضاءِ الثُّغورِ","تَرُوعُ الأعادِيَ مِنْ كُلِّ ريعِ",26,"ع",1,0],["وأجنادُ شُكرِي لَمْ تَفُتكَ بِعَرضِها","ولا فاتها فِي الأرضِ طُولٌ ولا عَرضُ",27,"ض",1,0],["واجْنَحْ لِقُرْطُبَةٍ فَعانِقْ تُرْبَها","عَنِّي بِمِثْلِ جَوانِحي وتَرَائِبي",28,"ب",2,0],["وأجنادُهُ فِي موقِفِ الرَّوْعِ رَوْضُهُ","وَأَعلامُهُ فِي مَوْرِدِ المَوْتِ وِرْدُهُ",29,"د",2,0],["واجنح إلى تعديل شأن","ك قبل ميزان الحساب",30,"ب",1,0],["وأجَنَّ غَرَّته الثَّرى من بعدما","عادَ الصَّباحَ بها البَهيمُ المُظْلمُ",31,"م",1,0],["واجنح إلى عمل حسنا مغبته","من كن من الشر في الدنيا على حذر",32,"ر",1,0],["وَاِجنِ بِأَلحاظِكِ مِن وَجنَتي","مُديرِها وَرداً وَتُفّاحا",33,"ح",2,0],["وأجنّة الأحلام حين تهزّها","نجواك يرعش روحها المتكهرِب",34,"ب",1,0],["وأجناده شم الأنوف بحزمه","تُفَرّق في الهَيجا جُموع السَلاطين",35,"ن",1,0],["وَأَجنادها في البَر وَالبَحر قَد نَمَت","وَنالَت كَما رامَت بِصَولَتِها نَصرا",36,"ر",2,0],["واجن صفوَ المدام من","ريقِ صافي السوالف",37,"ف",1,0],["وَأَجني ثِمارَ الوَصلِ والأنس مفرداً","وَأَنشقُ عِطرَ القُربِ مِن كلِّ جانِبِ",38,"ب",1,0],["وأجني بجسم قلب السقم قلبه","ملابس بؤس سابغات الغلائل",39,"ل",1,1],["واجنح إلى العجز ففي طيه","سر به تكفى أليم الملام",40,"م",1,0],["واجْنيا لي مِنْ وَرْدةِ الرَّاح روحي","فهو حكمٌ قامتْ عليهِ الأَدِلَّهْ",41,"ل",2,0],["وأجنح للهياج على أغرٍ","فيغدو القلب منخفض الجناح",42,"ح",1,0],["وَأَجني عَلى قَومي وَأَحمِل عَنهُم","وَسَيّد قَوم مَن جَنى وَتَحَمّلا",43,"ل",2,1],["وَاِجنَح إِلى السَمُراتِ أَو","لِلسَّفحِ مِن جَمّائِها",44,"ا",3,0],["واجنح إلينا فإنَّ ألفتنا","تدفع باليمن حرفة الأدب",45,"ب",1,0],["واجنِ القَطِيعةَ إِنَّهَا","ثمراتُ كُلِّ مَنِ اعتَدى",46,"د",2,0],["واجنَح للعلمِ معَ العملِ","فحليفُ العلمِ حمى الشمَمِ",47,"م",1,0],["واجنح إلى من شئت من أهل الدني","وابذل له ماء الحياء تكن أسيره",48,"ر",2,0],["واجنب قرين السؤ أن يدعو إلى","ما فيه كيدك دَعوة الملظاظ",49,"ظ",1,0],["واجنح لترك اللوم حيث جوانحي","فيها جوى عن صرف لومك صارف",50,"ف",1,0],["واجْن الفوَاكهَ منْه ما تخْتاره","واجعلْ إثابته الرضا فلربَّما",51,"م",2,0],["وأجنحة الأرواح سر هممها","وإن علت الهمة صارت عالية",52,"ه",1,0],["واجْنَحْ إليْها منْعِماً مُتفضّلاً","لا زِلْتَ أكرمَ واهِبٍ متعطّفِ",53,"ف",1,0],["وأَجنَفَ مأَطور القَرى كانَ جُنَّةً","مِنَ السَيلِ عالتَهُ الوَليدَةُ أَحدَبا",54,"ب",2,0],["وأجنادنا من فيهم كل باسلٍ","يحاكي يزيداً في المعارك أو معنا",55,"ن",2,0],["وَاِجناحَ أورِستَ تُسقى الأَرضُ مِن دَمِهِ","وَالقَرمَ يا مينَ ثُمَّ اِستَقبَلَ السَلبا",56,"ب",2,0],["وَأَجني المُنى مِن كُلِّ مثمرة الهَنا","وَيَغبطني فيما مَضى كُل ذي سَعد",57,"د",1,0],["وَأَجنح لِلظَّلامِ جنوح صب","دَنا لِحَبيبِه بِالرقمَتَين",58,"ن",1,0],["واجنح إلى حب النبي وآله","تنجح وتب فاخو النجاة التائب",59,"ب",1,0],["وأَجنِ لنا من الأزهار عرفاً","ولا تبدِ اعتذاراً ما جنينا",60,"ن",2,0],["وَأَجَنَّ قَلبُكَ مِن فِراقِهِمُ","شَوقاً فَكادَ الوَجهُ يَصدَعُهُ",61,"ع",2,0],["وَأجني جَنِيَّ الوَردِ في وردِ ريقَةٍ","تراءَى لِمُخضَرِّ السَّوالِفِ أَحمَرا",62,"ر",2,0],["واجنب محمود النقيبة بارعا","نهوا عن المنكور ندبا معمما",63,"م",2,0],["واجنِ جنَى الطاعات من تلك الربا","واجلسْ على شرط الوفا في مجلس",64,"س",1,0],["وَاجْنَحْ الى حَيْثُ المَكارِمُ والنَّدَى","هذا الفَضَاءُ بذِي المَكارِمِ أرْحَبُ",65,"ب",1,0],["وَاجْنَحْ الى الرِّفْقِ لا ألْقَاكَ مُضْطَرِباً","يَسْتَرْوِحُ(5) الغُصْنُ إذْ يَصْطَادُهُ الحَجَرُ",66,"ر",1,0],["وأجني من الصخرِ حقداً دفيناً","لعلِّي أُزيِّنُ جيدَ الحروبْ",67,"ب",1,0],["وأجني ما يطيب ولا أعاني","بما ألقى وتنتعش الحقول",68,"ل",1,0],["وأجناس أوباش طغاة ذوي خنا","كثيرين لا يحصون من أمة المقل",69,"ل",1,0],["واجْنِ الثمارَ وإنْ شُكِكْتَ بشوكةٍ","فاصْبرْ فبَعدَ الأيِّ ما أحلاهُ",70,"ا",2,0],["واجْنَحْ لِلخَيرِ وَ زُمْرَتِهِ ..","واصْدَعْ بِالحِكْمَةِ يَا قَلَمِي !",71,"م",2,0],["وأجناسُ الحياةِ تظلُّ رهْنًا","ب أشجارٍ على بادٍ وخافِ",72,"ف",1,0],["وأجني المحبة من كل حقل","كنحل يمص الشذى والغصونا",73,"ن",2,0],["وَاجْنحْ إلَى الحُبِّ وَفِطرَتِهِ","تَصُنْ بهِ الدُّروبَ منْ هَدَمِ",74,"م",1,0],["واجْن منْها ليْل الْمنى حين يشْدو","كيف تنْأى عنْ وصْلها بالْجفاء؟!",75,"ا",2,0],["وَ أَجْنِحَةٍ كَمْ حَلَّقَتْ - رَاؤُها - بِها","تَرِفُّ بِها لَمَّا تَبَدَّى فِرارُها",76,"ر",3,0],["وأجِنَّةُ الأقمارِ لمَّا أبصرَتْ ...","خانَتْهُ عندَ غيابِهِ مع شَمسِهِ",77,"س",2,0],["واجنب الخيل فوق كل نجاة ٍ","تكتسي بالسراب طوراً وتعرا",78,"ر",2,0]]}