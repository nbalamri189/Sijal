لتها مذاقٌ في فمي","https://www.poetsgate.com/ViewPoem.aspx?id=198991",""],[5419,"بين الشعراء أنا عجبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=31465",""],[5431,"للشاعر الإنسان عبد الحميد الجمال -جريدة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=190263",""],[5431,"فيك الحسُ يُختزلُ...","https://www.poetsgate.com/ViewPoem.aspx?id=198568",""],[5444,"حيث لهيب الجمر","https://www.poetsgate.com/ViewPoem.aspx?id=205073",""],[5490,"من أغضب البحر","https://www.poetsgate.com/ViewPoem.aspx?id=176263",""],[5510,"بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=215370",""],[5609,"نزوة عشق","https://www.poetsgate.com/ViewPoem.aspx?id=215571",""],[5628,"حديث مع البحر","https://www.poetsgate.com/ViewPoem.aspx?id=178548",""],[5703,"أمي","https://www.poetsgate.com/ViewPoem.aspx?id=207891",""],[5736,"يا بحر","https://www.poetsgate.com/ViewPoem.aspx?id=208182",""],[5848,"شاطي الدمام","https://www.poetsgate.com/ViewPoem.aspx?id=48953",""],[5943,"يابحور الشعر غني واهتفي","https://www.poetsgate.com/ViewPoem.aspx?id=37260",""],[6075,"عرفتك عشفا","https://www.poetsgate.com/ViewPoem.aspx?id=193315",""],[6093,"إليْكَ يا بَحْرُ طِفْلُ الشَّامِ قَدْ هَرَبَا","https://www.poetsgate.com/ViewPoem.aspx?id=177749",""],[6131,"عَينايَ زرقاءُ اليَمامةْ","https://www.poetsgate.com/ViewPoem.aspx?id=189287",""],[6152,"يابحر","https://www.poetsgate.com/ViewPoem.aspx?id=202893",""],[6152,"بحر السكون","https://www.poetsgate.com/ViewPoem.aspx?id=206729",""],[6203,"يابحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88029&r=&rc=6",""],[6213,"نهر الأحلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76256&r=&rc=13",""],[6213,"هدوء الموج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85502&r=&rc=105",""],[6224,"سبحانه البحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88237&r=&rc=16",""],[5567,"حيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81760&r=&rc=28",""]],"verses":[["يا بحر علم وجود فاخرن بهما","فكلّ آل فخار بعد كالآل",0,"ل",1,0],["يا بُحتريُّ لقد أقبلتَ مُنقلباً","يوم اكتسبتَ هجائي شرَّ منقلبِ",1,"ب",1,0],["يا بحر كم اغرقت من","فلك مغذ في عبابك",2,"ك",1,0],["يا بحر خذني الى من انت آخذه","فانني لألى لقياه ظمآن",3,"ن",1,0],["يا بحرُ أرخصتَ غير مكترثٍ","مَنْ كنتُ لا للبياع أغليها",4,"ي",3,0],["يا بَحرُ جاوَرتَ البِحارَ لِعِلَّةٍ","حازَت لَها الفَخرَ المِياهُ عَلى الثَرى",5,"ر",2,0],["يا بحرُ ما بكَ هل مَسَّتكَ عاصفةٌ","أم استخفَّكَ إِزبادٌ وإِرغاءُ",6,"ا",2,0],["يا بحرُ ما بكَ ما بي مصرُ ما بَعُدَتْ","ولي إليها بهذا الشعر إِسراءُ",6,"ا",2,0],["يا بَحْرُ يَا مِرْآةَ فَخْرٍ خَالِدٍ","أَبْقَوْهُ فِي الأَبْصَارِ وَالأَخْلاَدِ",7,"د",1,0],["يَا بُحَّةً بُحِحْتهَا فَأَصْبَحَتْ","فصَاحَتِي مَذْبُوحَةَ المَقاطِعِ",8,"ع",1,0],["يا بحرُ، فوقك درةٌ، هيهات أن","تلقى لها في حويتَ مثيلا!",9,"ل",2,0],["يا بحرُ ما فعلتْ مياهُك ويحَها","بُرفاتِ قوم يسكنون قرارها؟",10,"ر",3,0],["يا بحر، قد سِئمَتْ نفسي الحياةَ على","وتيرة، فأرحْ نفسي في السأم",11,"م",1,0],["يا بحرُ، أنت ملتَقَّى الأحباب","وباعثُ النَّشْوة في الأعصاب",12,"ب",1,0],["يا بحر، دقَّتُ ساعةُ الإِيَاب","وهكذا العمرُ إلى ذَهَاب",12,"ب",1,0],["يا بحرُ إن شئتَ أن تحِكى مواهَبهُ","فدع مَخُوفَيْكَ من هَيْج وإزبادِ",13,"د",1,0],["يا بحر قلدت أخاك البحرا","صنيعة ليست تحد شكرا",14,"ر",2,1],["يا بحر علم يزخر","يغرق فيه الأبحر",15,"ر",1,1],["يا بحرَ علمٍ كالبحارِ جميعِها","لك من فنونِ الفضلِ عِدَّةُ رَمْلِها",16,"ل",3,0],["يا بحر بالبر قد جدت لي","تفضلا من برك الواصل",17,"ل",1,1],["يا بحر ما سمكات","شويتها فاشتويت",18,"ت",1,0],["يا بحر ما هذه الأجسام سابحة","كأنها النور في أحشاء ديجور",19,"ر",1,0],["يا بحر حسن نبت عا","رِضِهِ المَديدِ عَلَيهِ شاطي",20,"ط",2,0],["يا بَحرُ كَيفَ طَلَبتَ شَأوَ مُحَمَّدٍ","مَهلاً فَلَستَ اليَومَ مِن نُظَرائِهِ",21,"ا",3,0],["يَا بَحْرَ عِلْمٍ طَمَى فِِي","بُرُودِ حِلْمٍ كَثِيفَهْ",22,"ف",2,0],["يا بَحْرَ عِلْم وجُودٍ لا كِفاءَ له","مَرْجَانُهُ مِلْءُ أيْدينا ولُؤْلُؤُهُ",23,"ا",2,0],["يابحر ذنب كلما","نجوت منه يشدني",24,"ن",2,0],["يا بُحور الكمال يا آل طه","كَم مَنَنتُم وَكَم جَبَرتُم كَسيرا",25,"ر",2,0],["يا بحرَ علمٍ نَماهُ الحَبْرُ والدُه","مَجْداً ويا بَدْرَ تِمّ يَمطُرُ الدُّررا",26,"ر",2,0],["يا بَحرُ إِنّا وَقَد جَدَّ الغَليلُ بِنا","مِن يَومِ بَينِكَ مَقذوفونَ في اللجَجِ",27,"ج",1,1],["يا بحرَ فضل زاخرٍ","والكونُ منهُ يُملَأُ",28,"ا",1,0],["يا بحر!! هذه الليلة الليلاءُ","ظلاماؤها لملدّلجين تضاؤء",29,"ا",2,1],["يا بحر !! كم شرفٍ عظيمٍ حزته","لما التقى بعبابك الشرفاء",29,"ا",2,0],["يا بحر !! أنت الآن راويةُ لم","ستر الظلام وقارف الأعداء",29,"ا",2,0],["يا بحر !! أنت وكائناتك والمدى","بعد المدى والموجة الزرقاء",29,"ا",2,0],["يا بحر أغرقت بحراً لم يزل أَبدا","عذباً وأنت الاجاج الملح والصرد",30,"د",1,0],["يا بحر يا دهر يا غيث الأَنام ويا","بدر التمام الذي قد سر مذ بدرا",31,"ر",2,0],["يا بحرَ فيضٍ والبحارُ جداولٌ","يا بدرَ تمٍّ والبُدورُ نجومُ",32,"م",1,0],["يا بحر علم زاخر متدفق","يا طود رضوى حلمه فيلملم",33,"م",1,0],["يا بحر لآل ويا غمام نوال","طوبى لموال اتى اليك ووالاك",34,"ك",1,0],["يا بَحرَ عِلمٍ لَهُ في فَضلِهِ اِعتَرَفَت","كُلُّ الأَفاضِلِ مَع إِذعانِ مُعترفِ",35,"ف",1,1],["يا بَحرَ جودٍ لَم يُماثل جُودُهُ","أَنسى بِهِ مَن قَد مَضى وَتَقَدَّما",36,"م",2,0],["يا بَحرَ سَخاءٍ عَليَّ جادَ بِدُرٍّ","وَالبحرُ جوّادٌ بِلُؤلُؤٍ وَبِمرجان",37,"ن",1,0],["يا بحر علم غاض لكن بعدوما","كل البحور أمدها من بحرهِ",38,"ر",2,0],["يا بحرَ عِلمٍ حِفظُه شاهِدُ","ولَفظُه العَذبُ له عاضِدُ",39,"د",1,1],["يا بحار الأرض الزواخر غوري","قضي الأمر ثم غيض الماء",40,"ا",2,0],["يا بحر جود ما له ساحل","لكل عاف في لهاه نصيب",41,"ب",1,0],["يا بحر علم لم يزل طافحا","كم سالم منه روى واغترف",42,"ف",1,0],["يا بحر فضلٍ عميمٍ","قد زانه الأمدادُ",43,"د",1,0],["يا بحار الندا وقيتم ضياً","ولقيتم جزا العطاء نعيما",44,"م",2,1],["يا بحر سخاً إن سحّت أنا","مله تحسدها السحبانُ",45,"ن",1,0],["يا بحراً للرجوى طامي","وسحاباً بالجدوى هامي",46,"م",2,1],["يا بحر غوثٍ لم يلذه لا يذٌ","الا انثنى في حمده مثنياَّ",47,"ي",2,0],["يا بحر حلمٍ حايطٍ كل الورى","كم مفتنٍ من درّه الغالي الثمنْ",48,"ن",1,0],["يا بحر فضلٍ إذا ما أمَّ سايله","عميم طامي نداه يرهب الغرقا",49,"ق",2,0],["يا بحر لو تنطق أخبرتنا","ما قال من غيبت إذ غيبوا",50,"ب",3,0],["يا بحر امداد الكرامة والصفا","يا مركز الألا ويا أهل الوفا",51,"ف",2,0],["يا بُحتُرِيُّ حَذارِ وَي","حَكَ مِن قُضاقِضَةٍ ضُغُم",52,"م",1,0],["يا بحر قد قذف الجوا","هر للنواظر ثم غابا",53,"ب",2,0],["يا بحر علم غدت تزهو جواهره","مطبوعة فهي في وجه السماء حلي",54,"ل",2,0],["يا بحر علمٍ أهال الدهر عيلمه","فانبث عن لؤلؤ رطب وعن درر",55,"ر",1,0],["يا بحرَ جودٍ قد طغى لججاً","أفضى الحمامُ به إلى القبرِ",56,"ر",1,0],["يا بحر أَفئدة في الحب تغرقها","يا بر بر قلوب تَستَبريها",57,"ي",3,0],["يا بحر علم ما ولجت علومه","إلا ولجت مدى الزمان عبابا",58,"ب",2,0],["يا بَحرَ جُودٍ إِذا جادَت غَوارِبُهُ","فَكُلُّ بَحرٍ سِواهُ في النَدى ثَمَدُ",59,"د",1,0],["يا بحر من فيضك ارتوى البر","والفاجر لما أبحتهم نعمك",60,"ك",1,0],["يا بحر والأمواج فيك تدفَّعت","قلبي كهمِّك دائم الخفقان",61,"ن",1,0],["يا بحر قد جاءَ المساءُ مجرراً","أذياله ينبثُّ في الأكوان",61,"ن",1,0],["يا بحر إن العمر همٌّ دائم","بتعارف وتباعد وتداني",61,"ن",2,0],["يا بحر زد وانقص فإنك مثلها","فانٍ ومثلك كل شيءٍ فاني",61,"ن",2,0],["يا بحر علم في فضائله","قد أخجلت آياته البحرا",62,"ر",2,0],["يا بحر فضل ورده","تحلو مناهله الشهيه",63,"ي",2,0],["يا بحر ما أحلاك يا بحر","لا تنتهي أنت ولا الدهر",64,"ر",1,1],["يا بحر أنت الفضاء الطلق للنظر","فأنت حر طليق من أذى البشر",65,"ر",1,0],["يا بحرُ ما لك تولى القذفَ للدُّرر","وما تشاهد للرائين من أثر",66,"ر",1,1],["يا بحر ماذا تقول","لأنت عندي رسول",67,"ل",1,1],["يا بحرَ وهمٍ يولد الشعرا","فيه أغوص فأجمع الدّرا",68,"ر",2,0],["يا بحر أفديك بحرا","ملكت قلبي سحرا",69,"ر",2,1],["يا بحر أنت أنيسي","إن ضقت بالهم صدرا",69,"ر",2,0],["يا بحر إن ضاق أمر","قد يحدث الله أمرا",69,"ر",2,0],["يا بحر ما هذي الشكا","ة ألست توصف بالعظم",70,"م",1,0],["يا بحر علم قد طمى إن صنّفا","يا طود حلم فيه فاق الأحنفا",71,"ف",2,0],["يا بحورَ الظُلمِ يا شوكَ القَتاد","يا أَهيلَ الكُفرِ يا آل العِناد",72,"د",1,0],["يا بحر أذكرتني بحر الحياة وما","يجيش ما بين ماضيه وآتيه",73,"ي",2,0],["يا بَحرَ حُسنٍ بِمَوجِ الرِدفِ مُضَّطَرِباً","بِاللُؤلُؤِ الرَطبِ كَم أَزرَت ثَناياكِ",74,"ك",1,0],["يا بحر جود اللَه يا كنز الغنى","يا رحمة يا ملجأ الدخلاء",75,"ا",2,0],["يا بحر علم قد علته سفينة","ركب النواوي فوقها والرافعي",76,"ع",2,0],["يا بحرُ لا خلق تدّعي شبَهاً","فات المدى ما حَوَيْتَ من خُلُقِ",77,"ق",1,0],["يا بحر جود عمنا بنواله","أمسك فقد خفنا من الطوفان",78,"ن",1,0],["يا بحر جود دافق","يطفي من الصادي أوامه",79,"م",2,0],["يا بحارا في عرصة الطف جفت","بعدما أروت الورى بالعطاء",80,"ا",2,0],["يا بحر فيض فضائل كم مغرق","ببديع وصفك في بيان معاني",81,"ن",2,0],["يا بحر فضلٍ قد طما بمواردٍ","شهداً ويسقينا النمير الكوثرا",82,"ر",2,0],["يا بحر علم جاد في","درِ البيان منضَّدا",83,"د",2,0],["يا بحر أهل العلم يا حبرهم","وذا الندى والمورد العذب",84,"ب",1,1],["يا بحرنا المأسور من خذلانهم","أرسل عبيرك للقلوب القاحلة",85,"ل",2,0],["يا بحورَ الشّعر هيمي","في سَما الوَجْدِ مَليّا",86,"ي",2,1],["يا بحورَ الشّعر هيمي","في سَما البوْحِ مَليّا",87,"ي",2,1],["يا بحرَ \"يافا\"بحرُ \"غزّة\" لم يصلْ","في موجتي شغفٍ \"لحيفا\" الناهِدةْ",88,"د",2,0],["يا بحر فضلٍ قد سرت سفن الرَّجا","فيه غداة به الندى متموج",89,"ج",1,0],["يا بحر علم مزاج الدهر صح به","غداة كل يعاني منه بحرانا",90,"ن",2,0],["يا بحر فضل قد غدا جيدُ العلي","متحلياً منه بأنواع الدرر",91,"ر",1,0],["يا بحرَ أشواقٍ غرقتُ فضمّني","قل لي متى يابحرُ سوف تفيضُ؟!",92,"ض",1,0],["يابحرُ لاتصمتْ فصمتكَ موجعٌ","وسكون موجك يا سخيّ بغيضُ",92,"ض",1,0],["يا بحرُ طِبْتَ ، فهل في الماءِ مِنْ فَرَجٍ ؟","فقالَ : رُبَّ ، أَلَا ارْمِ الطُّعمَ والشّبكَا",93,"ك",2,0],["يابحرَ حُبٍّ من العلياءِ مَنْبعُهُ","يصبُّ فينا من التِّحنانِ قد فاضَا",94,"ض",2,1],["يا بحرَ موسى هل تشقُّ بخافقي","طَوْداً عظيماً، فالرجاءُ مُهدّمُ؟",95,"م",1,0],["يا بَحْرَ أشْوَاقٍ إليْكِ يَشِيْلنُي","مَوْجٌ وَتَهْفُو الأُغنِيَاتُ ثَكَالى",96,"ل",2,0],["يا بحر كيف دربي مشرقٍ او غروب","الشرق هو صحاري والغرب مستهيب",97,"ب",1,0],["يا بحر ُ هل خانتك َ أمواج ُ الهوى ؟","أم أن َّ ماءَك َ في التّأمُّل ِ راكد ُ ؟",98,"د",1,0],["يا بحرَ أشواقٍ يموج بداخلي","يا ليتني موجًا ثَوَى بغُثائهِ!!",99,"ا",3,0],["يا بحر جود له سفن الرجا رقلت","مواخراً فاستوت جريا على الجود",100,"د",1,0],["يا بُحَّة ً بالصوت ُترقصني","يا رَعْشَة الحركاتِ تُصبيني",101,"ن",2,0],["يا 