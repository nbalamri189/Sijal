{"poems":[[55,"هذي الرماح عصي الضال والسلم","https://www.aldiwan.net/poem29765.html","البسيط"],[55,"لأغنتك عن وصلي الهموم القواطع","https://www.aldiwan.net/poem30154.html","الطويل"],[55,"نزوت نزاء الجندب الجون ضلة","https://www.aldiwan.net/poem30696.html","الطويل"],[79,"أهاجتك ذكرى من خليط ومعهد","https://www.aldiwan.net/poem36601.html","الطويل"],[87,"الفن روض يمر القاطفون به","https://www.aldiwan.net/poem7052.html","البسيط"],[47,"نصيب عينيك من سح وتسجام","https://www.aldiwan.net/poem66640.html","البسيط"],[48,"سرينا وطالبنا هاجع","https://www.aldiwan.net/poem22047.html","المتقارب"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20986","البسيط"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67335","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43778","المنسرح"],[119,"يا ساكن القلب لقد","https://www.aldiwan.net/poem40425.html","عموديه"],[159,"لو مر لي نفس بالنار أحرقها","https://www.aldiwan.net/poem55710.html","البسيط"],[203,"أتاني بعد فرقتنا سلام","https://www.aldiwan.net/poem45214.html","الوافر"],[275,"رأيت الشرق ملكا للنبي","https://www.aldiwan.net/poem35655.html","الوافر"],[303,"برزت بزينتها إليك الشام","https://www.aldiwan.net/poem36300.html","عموديه"],[318,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[369,"جوانح واجد وجفون سال","https://www.aldiwan.net/poem60683.html","الوافر"],[484,"فتحت بنظمك المنثور بابا","https://www.aldiwan.net/poem37171.html","الوافر"],[487,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[505,"غرامي عن ضميري ترجماني","https://www.aldiwan.net/poem37754.html","الوافر"],[534,"إلى الدرعية الغراء تسري","https://www.aldiwan.net/poem37443.html","الوافر"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96990","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63836","المنسرح"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38766","الطويل"],[997,"","https://poetry.dctabudhabi.ae/diwan/poem/132404","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202069","الرجز"],[1476,"","https://poetry.dctabudhabi.ae/diwan/poem/72991","الرجز"],[1534,"","https://poetry.dctabudhabi.ae/diwan/poem/206187",""],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108627","الوافر"],[2515,"","https://poetry.dctabudhabi.ae/diwan/poem/198791","الطويل"],[345,"","https://poetry.dctabudhabi.ae/diwan/poem/124711","الطويل"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140299",""],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117986","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117973","الطويل"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103552","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94466","الوافر"],[4755,"لَنا ما بَينَ نائِحةٍ وثَكْلَى","https://www.poetsgate.com/ViewPoem.aspx?id=204480",""],[4829,"الملحمة اليعربيّة","https://www.poetsgate.com/ViewPoem.aspx?id=36397",""],[4869,"موقف لآ اكثر","https://www.poetsgate.com/ViewPoem.aspx?id=139691",""],[3271,"التائهة","https://www.poetsgate.com/ViewPoem.aspx?id=131013",""],[585,"يا من تأنق في التصوير يحكينا","https://www.poetsgate.com/ViewPoem.aspx?id=161919",""],[585,"هو الصوت دوّى من فلسطين عالياً","https://www.poetsgate.com/ViewPoem.aspx?id=161906",""],[5431,"على لسان نازح سوري...","https://www.poetsgate.com/ViewPoem.aspx?id=209152",""],[5525,"صوت العظام","https://www.poetsgate.com/ViewPoem.aspx?id=992",""],[5615,"رسالة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=187951",""],[5956,"نبع الحب","https://www.poetsgate.com/ViewPoem.aspx?id=182080",""],[5956,"بداية الصلوات لجلال الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=194045",""],[5956,"السجين برضائه","https://www.poetsgate.com/ViewPoem.aspx?id=207195",""],[2575,"فمان الله","https://www.poetsgate.com/ViewPoem.aspx?id=24770",""]],"verses":[["وَلَو هَتَكتُ حِجابَ الغَيبِ لَاِفتَضَحَت","أَجفانُ كُلِّ مُريبِ اللَحظِ مُتَّهَمِ",0,"م",1,0],["وَلَو هَزَّ أَسماعَ المُلوكِ نَشيدُهُ","دَروا أَنَّ كُلَّ المَجدِ ما أَنا صانِعُ",1,"ع",1,0],["وَلَو هيجَ لِلهيجاءِ طارَ بِسَرجِهِ","جَوادٌ كَذِئبِ الرَدهَةِ المُتَأَوِبِ",2,"ب",1,0],["ولوْ هاجَ عزْمي منْ سِواكَ وصاحَ بي","لآثَرْتُ سِيما العاجِزِ المُتَبَلِّدِ",3,"د",1,0],["ولو هتفت ببتهوفان ما انصرفت","لك القلوب وإن صادفت آذانا",4,"ن",2,0],["وَلَو هُدوا لِصَوابِ الرَأيِ أَقنَعَهُم","مِن وابِلي في غَداةِ الشَرِّ إِرهامي",5,"م",2,0],["وَلَو هَبَّ صَدَّقَهُ مَعشَرٌ","وَقَالَ أُناسٌ طَغى وَاِفتَرى",6,"ر",2,0],["ولَو هَلَكتُ تركتُ النَّاسَ في وَهَل","بعدَ الَجميعِ وصارَ العَيشُ إكسارا",7,"ر",2,0],["وَلَو هَبَطْتُمْ بِبَطْنِ السّيلِ كَافَحَكُمْ","ضَرْبٌ بِشَاكِلَةِ البَطْحَاءِ تَرْعِيلُ",8,"ل",1,0],["وَلَو هَدى اللّه قلتُ إِذ سَأَلوا","سِنوهُ تَمَّت وَرِزقهُ فَرغا",9,"غ",2,0],["ولو هواك كله","بجمرة الوجد كوى",10,"و",2,0],["وَلَوْ هَوِيتُ حِمامي فيهِ فارقني","من قبلِ فُرقتِهِ روحي من الجَسَدِ",11,"د",1,0],["ولو هبَّ النسيمُ عليَّ يوماً","لزحزحني وربكِ عن مكاني",12,"ن",2,0],["ولو هملت دموعُ الحرِّ حيناً","على البلوى لكانت كالولي",13,"ي",1,0],["وَلَوه وَجْهَكمُ وحيّوا قبلةً","كَرُمَتْ وأَنتمْ للسلام قيام",14,"م",1,0],["ولو هم مني خاطر بالتفاتة","لم كان لي إلا ألي تلفتي",15,"ي",1,0],["ولو هابَ المَشيبُ جلالَ قَوْمٍ","جَنَوهُ على المَفارقِ بالنِّصال",16,"ل",1,0],["ولو هي سولت لأخيك قبلا","لخاف من الملائكة الشهابا",17,"ب",2,0],["ولو هطلت من بحرها نقطة كفت","خلائقها فابسط أياد امتنان",18,"ن",1,0],["وَلوهٌ مُسْتَهامٌ ذو حَنينٍ","تمكَّنَ من فُؤادِيَ بل حَناني",19,"ن",2,0],["ولَوْ هَبَّتْ لَهَبَّ لَها أُناسٌ","يَضِيقُ بها المنافِذُ والنُّجودُ",20,"د",1,0],["ولو هبطت وهو الصعود لبيتهم","ذكاء وما منها الأشعة كاسب",21,"ب",1,0],["ولو هفا الليثُ هفوةً فُدِيَتْ","بألفِ كلبٍ وألفِ خنزير",22,"ر",1,0],["وَلَو هَزَّ في وَجهِ العداةِ حُسامَهُ","لَذابوا بِهِ رُعباً وَلَو كانَ في الغمدِ",23,"د",1,0],["ولو هددت رضوي بتبريج هجرها","لأمسى من التهديد وهو مهدد",24,"د",1,0],["ولو هُدُوا لذلك التحقيق","لما بَقوا للكُفْرِ في مضيق",25,"ق",1,0],["ولو هلكتُ مزقَت خِمارها","واتخذَت من شعرٍ صِدارها",26,"ه",2,0],["ولو هو طلب مِنّي سوى الروح سِقْتها","أراها معي له من عِطِيّات الازهادِ",27,"د",1,0],["ولو هزت على ورق وكانت","يراعاً أمطرت ورقاً وتبرا",28,"ر",2,0],["ولو هبت النكباء نحوك مرة","تغير مجراها وطاب هبوبها",29,"ب",3,0],["ولو هَمَّ غير الحوت بي لَتَواثَبَت","رجالٌ يخوضون الحِمامَ إلى نصري",30,"ر",2,0],["ولو هوى حسنه ثبير","وصد عنه هوى وهده",31,"د",2,0],["ولو هتفت أنباء دعوته بمن","بما دان دانوا للذمار وللذمم",32,"م",1,0],["ولو هاج من طعن الأسنّة دونها","عباب على مثلي يهون اقتحامه",33,"م",2,0],["ولوة وجد ما تفيق وظمأة","لا شنب معسول اللمى طيب النشر",34,"ر",1,0],["وَلَو هَزَمناهُمُ لَن يَرجِعَنَّ بِنا ال","أَجنادُ مِن حَيثُ كَرّوا بِاِنتِظامِهِمِ",35,"م",1,0],["ولو هزَّت قوام الكشح عُجباً","لبات بكل جارحةٍ بليّه",36,"ي",2,0],["ولو هي أَنصَتت لَدَرَت بأنَّا","بَنُوها الجائِعُونَ.. نُريد أَكلا",37,"ل",2,0],["ولوهي وافقت بالعيد الاضحى","ترانا فيه حنّا مضحيينا",38,"ن",2,0],["ولو هي على الفزعه تراني خويك","امشي ولو تبغى دروب المنيّه",39,"ي",2,0],["ولو هفت يومًا على تائبٍ","غنّى له الإثمُ بقيثارِ",40,"ر",1,0],["ولو هممت بنجواهم تصورها","هجت الزلازل منهم والبراكينا",41,"ن",2,0],["ولو هو ألقى الدين عنه تمرداً","وبات يهودي العقيدة راضيا",42,"ي",2,0],["ولو هبت رياح عاتيات","لخنّقت البسيطة من حروقي",43,"ق",2,0],["ولو هو الم ما طال عندك وقوفي","ولا جيت أبا اسمع قصة الذيب والحمل",44,"ل",1,0],["ولو هو ندم كسرت .. باقي سيوفي","على دروب الوصل ومفارق الشمل",44,"ل",1,0],["ولُو هُوَ سايَرَ الظَّبيَ المُرَجَّى","لِنَيلِ الوَصلِ مَسرورًا ، لَنَالَهْ",45,"ل",2,0],["ولو هيكلين من العظم صرنا","نظل لصيقَين لا نُبترُ",46,"ر",1,0],["ولوهلة نرنو ونغلق عيننا","وكأننا أسبابُ ما قد أمرعا",47,"ع",2,0],["ولو هو ضاقَ بالأشجار ذرعاً","فليس تضيق، مهما الناس ضاقوا",48,"ق",3,0],["ولو هو في حلى يوسف .. كسف لي بنت نور اضياه","وختم القول رب بك ... تبلاني ... يقويني",49,"ن",2,0]]}