{"poems":[[53,"هذي الرماح عصي الضال والسلم","https://www.aldiwan.net/poem29765.html","البسيط"],[53,"لأغنتك عن وصلي الهموم القواطع","https://www.aldiwan.net/poem30154.html","الطويل"],[53,"نزوت نزاء الجندب الجون ضلة","https://www.aldiwan.net/poem30696.html","الطويل"],[77,"أهاجتك ذكرى من خليط ومعهد","https://www.aldiwan.net/poem36601.html","الطويل"],[85,"الفن روض يمر القاطفون به","https://www.aldiwan.net/poem7052.html","البسيط"],[45,"نصيب عينيك من سح وتسجام","https://www.aldiwan.net/poem66640.html","البسيط"],[46,"سرينا وطالبنا هاجع","https://www.aldiwan.net/poem22047.html","المتقارب"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20986","البسيط"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67335","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43778","المنسرح"],[116,"يا ساكن القلب لقد","https://www.aldiwan.net/poem40425.html","عموديه"],[156,"لو مر لي نفس بالنار أحرقها","https://www.aldiwan.net/poem55710.html","البسيط"],[200,"أتاني بعد فرقتنا سلام","https://www.aldiwan.net/poem45214.html","الوافر"],[271,"رأيت الشرق ملكا للنبي","https://www.aldiwan.net/poem35655.html","الوافر"],[299,"برزت بزينتها إليك الشام","https://www.aldiwan.net/poem36300.html","عموديه"],[314,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[365,"جوانح واجد وجفون سال","https://www.aldiwan.net/poem60683.html","الوافر"],[480,"فتحت بنظمك المنثور بابا","https://www.aldiwan.net/poem37171.html","الوافر"],[483,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[501,"غرامي عن ضميري ترجماني","https://www.aldiwan.net/poem37754.html","الوافر"],[530,"إلى الدرعية الغراء تسري","https://www.aldiwan.net/poem37443.html","الوافر"]],"verses":[["وَلَو هَتَكتُ حِجابَ الغَيبِ لَاِفتَضَحَت","أَجفانُ كُلِّ مُريبِ اللَحظِ مُتَّهَمِ",0,"م",1,0],["وَلَو هَزَّ أَسماعَ المُلوكِ نَشيدُهُ","دَروا أَنَّ كُلَّ المَجدِ ما أَنا صانِعُ",1,"ع",1,0],["وَلَو هيجَ لِلهيجاءِ طارَ بِسَرجِهِ","جَوادٌ كَذِئبِ الرَدهَةِ المُتَأَوِبِ",2,"ب",1,0],["ولوْ هاجَ عزْمي منْ سِواكَ وصاحَ بي","لآثَرْتُ سِيما العاجِزِ المُتَبَلِّدِ",3,"د",1,0],["ولو هتفت ببتهوفان ما انصرفت","لك القلوب وإن صادفت آذانا",4,"ن",2,0],["وَلَو هُدوا لِصَوابِ الرَأيِ أَقنَعَهُم","مِن وابِلي في غَداةِ الشَرِّ إِرهامي",5,"م",2,0],["وَلَو هَبَّ صَدَّقَهُ مَعشَرٌ","وَقَالَ أُناسٌ طَغى وَاِفتَرى",6,"ر",2,0],["ولَو هَلَكتُ تركتُ النَّاسَ في وَهَل","بعدَ الَجميعِ وصارَ العَيشُ إكسارا",7,"ر",2,0],["وَلَو هَبَطْتُمْ بِبَطْنِ السّيلِ كَافَحَكُمْ","ضَرْبٌ بِشَاكِلَةِ البَطْحَاءِ تَرْعِيلُ",8,"ل",1,0],["وَلَو هَدى اللّه قلتُ إِذ سَأَلوا","سِنوهُ تَمَّت وَرِزقهُ فَرغا",9,"غ",2,0],["ولو هواك كله","بجمرة الوجد كوى",10,"و",2,0],["وَلَوْ هَوِيتُ حِمامي فيهِ فارقني","من قبلِ فُرقتِهِ روحي من الجَسَدِ",11,"د",1,0],["ولو هبَّ النسيمُ عليَّ يوماً","لزحزحني وربكِ عن مكاني",12,"ن",2,0],["ولو هملت دموعُ الحرِّ حيناً","على البلوى لكانت كالولي",13,"ي",1,0],["وَلَوه وَجْهَكمُ وحيّوا قبلةً","كَرُمَتْ وأَنتمْ للسلام قيام",14,"م",1,0],["ولو هم مني خاطر بالتفاتة","لم كان لي إلا ألي تلفتي",15,"ي",1,0],["ولو هابَ المَشيبُ جلالَ قَوْمٍ","جَنَوهُ على المَفارقِ بالنِّصال",16,"ل",1,0],["ولو هي سولت لأخيك قبلا","لخاف من الملائكة الشهابا",17,"ب",2,0],["ولو هطلت من بحرها نقطة كفت","خلائقها فابسط أياد امتنان",18,"ن",1,0],["وَلوهٌ مُسْتَهامٌ ذو حَنينٍ","تمكَّنَ من فُؤادِيَ بل حَناني",19,"ن",2,0],["ولَوْ هَبَّتْ لَهَبَّ لَها أُناسٌ","يَضِيقُ بها المنافِذُ والنُّجودُ",20,"د",1,0]]}