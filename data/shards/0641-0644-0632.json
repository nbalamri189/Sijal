{"poems":[[74,"يا سيدي أهلتني وأمرتني","https://www.aldiwan.net/poem20130.html","الكامل"],[45,"طوال قنا تطاعنها قصار","https://www.aldiwan.net/poem9568.html","الوافر"],[47,"أجدر وأخلق أن ترن عوائدي","https://www.aldiwan.net/poem63548.html","الكامل"],[33,"نعق الغراب ببين ذات الدملج","https://www.aldiwan.net/poem42592.html","الكامل"],[466,"خذوا من ذمامي عدة للعواقب","https://www.aldiwan.net/poem15082.html","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53041","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106879","الطويل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107008","الكامل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97934","الكامل"],[3423,"","https://poetry.dctabudhabi.ae/diwan/poem/198782","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111471","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141687","الكامل"],[5688,"لو كان يملك...","https://www.poetsgate.com/ViewPoem.aspx?id=200776",""]],"verses":[["فلزمت مع نسب الوَلاء فلا تقل","هذا كتاب لزوم ما لا يلزم",0,"م",1,0],["فَلَزَّهُمُ الطِرادُ إِلى قِتالٍ","أَحَدُّ سِلاحِهِم فيهِ الفِرارُ",1,"ر",1,0],["فَلَزِمتُ نَفسي لا أُكَشِّفُ غَيبَهُم","وَكَفَفتُ عَنهُم ناصِحي وَمُعاضِدي",2,"د",2,0],["فَلَزِمتُها فَلَثِمتُها فَتَفَزَّعَت","مِنّي وَقالَت مَن فَلَم أَتَلَجلَج",3,"ج",1,0],["فلزَّهم طولُ الطِّراد وحرُّهُ","إلى وطءِ أعجازِ البيوت العوازبِ",4,"ب",1,0],["فَلَزِمَت مَكَّةَ وَالبَوادِيا","وَحَلَّت الأَريافَ وَالحَواشِيا",5,"ي",2,0],["فلزومها أسباب طاعته","بين الإلَه وبينه سبب",6,"ب",1,0],["فلزَّ إلى أضلاعه النصل خارقاً","وغيَّب في العظم الحديد وأغمدا",7,"د",2,0],["فلزمتها ضما لصدري آخذاً","بعناقها شفتي على شفتيها",8,"ي",3,0],["فلزمت أهل البيت أخطب ودهم أسلو","به سلمى وحسن رخاصي",9,"ص",2,0],["فلزايد شكري على الدُّر الذي","ليَ نطقهُ ولهُ اللآلئ أنْظمٌ",10,"م",1,0],["فلزم الملازمه","للأنس والمنادمه",11,"ه",1,0],["فِلِزَفسٍ وسائِرِ الأَربابِ","سأُضَحِّي غَداً قُبَيلَ المَآبِ",12,"ب",1,0],["فلزوره منه أحبُّ إليّ من","لذّات وصلٍ من سواك يطول",13,"ل",1,0],["فلزمتُ نصحهم الذي","يقضي بكفّي والعدول",14,"ل",1,0]]}