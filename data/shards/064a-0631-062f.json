,1,0],["يَرِدُ المَقالي وَهوَ أَبيَضُ ساطِعٌ","وَيَعودُ مِنها وَهوَ أَحمَرُ قانِ",157,"ن",1,0],["يردد في المحافل صوت شعري","وتنصب في نواديهم خيامي",158,"م",2,0],["يرد عونه إن بدا في الناس يا عفور","والكل في جذل ما دام في بكم",159,"م",1,0],["يَرُدُّ وهْمَ الأماني عن مَطالِعهِ","إِلاَّ بِمولاهُ نِعْمَ السَّعيُ مَحْمودُ",160,"د",1,0],["يُرْدى بحيِّكُمُ الهزَبْرُ مسَربَلاً","ويمرّ فيه الظّبيُ وهْو موشّحُ",161,"ح",1,0],["يردُّ حُسامَ جَوْزاها كَهاماً","ويطعنُ في عُطاردِها اِحتِقارا",162,"ر",2,0],["يرد ظلام النقع فجراً كأنما","أسنته مطبوعة من سنا الفجر",163,"ر",1,0],["يرد صدور الخيل عند ورودها","ويورد في الخطب المهم ويصدر",164,"ر",1,0],["يردي العطايا ويسمو قدر همته","على الخطايا ويعفو وهو مقتدر",165,"ر",1,0],["يَردي بِهِ مُشرِفُ الأَقطارِ مُعتَرِضاً","كَالسيدِ ذي اللِبدَةِ المُستَأسِدِ الضاري",166,"ر",2,0],["يُردْنَ نجداً وما اِشتا","قَ مَن عليهنَّ نجدا",167,"د",2,0],["يُرْدُون مَنْ شاؤوا بِغَيرِ منيّةٍ","فَهُمُ وَإِنْ غَلَبوا الأسودَ أُسودُ",168,"د",1,0],["يُردنَ بيتاً به الأملاكُ ساكنةٌ","بنيّة فَضَلَتْ كلَّ البِنيّاتِ",169,"ت",1,0],["يردّ قسراً ويضمن دونه الدركا","إني رضيت فلم أحفل بمسئلة",170,"ه",1,0],["يَرُدُّ ضياؤُهُ الأبصارَ عنهُ","فليسَ يخافُ من عينٍ تُصِيبُ",171,"ب",1,0],["يَرُدُّ العارُ أوجُهَها حيَاءً","وليسَ تَرُدُّ أوجُهَها الحِرابُ",172,"ب",1,0],["يَرِدُ الرَّدَى من كُلِّ بابٍ سالِكاً","كلَّ الفِجاجِ حَذِرتَ أم لم تَحذَرِ",173,"ر",1,0],["يَرِدُ الشَّقاءُ منَ النَعيمِ وإنَّما","ليسَ الشَّقاءُ ولا النعيمُ بخالدِ",174,"د",1,0],["يَرِدُ البُؤْسُ والنعيمُ على المَرْ","ءِ وكلٌّ يروحُ من حيثُ جاءَ",175,"ا",2,0],["يَرِدُ الضَّحَاضِحَ غَيْرَ ثاني سُنْبُكِ","ويَرُودُ طَرْفُكَ خلفَهُ فَيَحَارُ",176,"ر",1,0],["يَرِدُ المشْهَدُ الوُفُودُ وَيَاْتي","وحدَهُ من بيانِهِ في وُفُودِ",177,"د",1,0],["يَرُدُّ على الشَّخْصِ تِمْثَالَهُ","فإنْ تَتَّخِذْهُ مِرْآةً صَلَحْ",178,"ح",1,0],["يُردِي أَعادِيَه بأَسْودِ نَقْشِه","أَوَما سمِعْت بنفْثِ سَمِّ الأُسْودِ",179,"د",1,0],["يَرْدِي على سبطاتٍ غير فائرةٍ","خُضرِ السَّنابُكِ لم تُقلبْ ولم تُرَبِ",180,"ب",1,1],["يَرُدُّ عَلَيها العَيرَ