w.aldiwan.net/poem52890.html","الوافر"],[564,"سلام الله أيتها القباب","https://www.aldiwan.net/poem52930.html","الوافر"],[564,"أسفا على أسف وليس بمنكر","https://www.aldiwan.net/poem52942.html","الكامل"],[564,"القلب بين الصحب أعدل شاهد","https://www.aldiwan.net/poem52952.html","البسيط"],[564,"أفراقا حسبتها أم لقاء","https://www.aldiwan.net/poem52986.html","الخفيف"],[569,"من شك في فضل الكميت فبينه","https://www.aldiwan.net/poem69699.html","الكامل"],[569,"عجبت من قناعتي وقعودي","https://www.aldiwan.net/poem69730.html","الكامل"],[569,"عراني الزمان بأحداثه","https://www.aldiwan.net/poem69758.html","المتقارب"],[577,"كحل العيون بمرود من عسجد","https://www.aldiwan.net/poem3085.html","الكامل"],[651,"","https://poetry.dctabudhabi.ae/diwan/poem/216854","البسيط"],[817,"","https://poetry.dctabudhabi.ae/diwan/poem/20460","الطويل"],[958,"","https://poetry.dctabudhabi.ae/diwan/poem/22544","الوافر"],[1026,"","https://poetry.dctabudhabi.ae/diwan/poem/20541","الطويل"]],"verses":[["يرددها المحب إذا تغنى","ويحييها الحسود إذا أعابا",0,"ب",2,0],["يَرُدُّ الزَمانُ عَلَيَّ الهَوى","وَيَطمَعُ في هَفوَةٍ مِن جَناني",1,"ن",2,0],["يَرُدُّني بِقَنيصٍ ما نَصَبتُ لَهُ","عَلى المَطامِعِ أَشراكاً مِنَ الأَمَلِ",2,"ل",1,0],["يَرُدُّ الشَمسَ مَطروفاً سَناها","وَقَد حُجِبَت بِأَجنِحَةِ النُسورِ",3,"ر",1,0],["يَرُدُّ جَوابَهُ قَولاً وَفِعل","بِبيضِ الهِندِ وَالسُمرِ الصِعادِ",4,"د",1,0],["يُرَدِّدُها كيْ يكْسِبَ الطّبْعَ دُرْبَةً","بهِنّ ولكِنْ ليسَ يُفْصِحُ في النُّطْقِ",5,"ق",1,0],["يَرِدُ الْحَوْضَ حَوْلَهُ كُلُّ أَشْقَى","كُلَّ حَوْلٍ يُلْقِي عَلَيْهِ مَسَالَهْ",6,"ل",2,0],["يُرَدِّدُ في الآذانِ لكُلِّ واعٍ","على الآذانِ حيَّ على الفَلاحِ",7,"ح",1,0],["يَرِدونَ منْهُ علَى مَشابَةِ راحِمٍ","جَمِّ الهِباتِ عنِ الذّنوبِ صَفوحِ",8,"ح",1,0],["يردُّهُ الخَوْفُ ويَدْعو بِهِ","إذا أطاعَ الخَوفَ داعِي الرَّجا",9,"ج",2,0],["يَرِدُ الواغِلُ الغَريبُ فَيَروى","وَبَنوكَ الكِرامُ تَشكو الأَواما",10,"م",2,0],["يَرِدُ الحَقائِقَ وَهيَ بيضٌ نُصَّعٌ","قُدسِيَّةٌ عُلوِيَّةُ الإِشراقِ",11,"ق",1,0],["يَرُدُّ الخَيلَ دامِيَةً كُلاها","جَديرٌ يَومَ هيجا أَن يَصيدا",12,"د",2,0],["يَردي بِهِ في نَقعِها سابِحٌ","أَجرَدُ كَالسِرحانِ ثَبتُ الحِضار",13,"ر",1,0],["يردُ الطرادَ على أغرَّ محجّل","في سرجه بطلٌ أغرُّ محجِّلُ",14,"ل",1,0],["يَرُدّ عنك يد الأعداء خاسرةً","ويكشف الغَمّ عن أُفقَيك والمِحنا",15,"ن",2,0],["يرُدّ كل عزوم عن مواقفه","ولا يُرَدّ له عز إذا اعتزما",16,"م",2,0],["يَردُدنَ إِذ لَحِقَ الثَمايِلَ مَرَّةً","وَيَخِدنَ وَخدَ زَمائِمِ الحِزباءِ",17,"ا",2,0],["يَرُدُّ عَلَينا لَيلَةً بَعدَ يَومِه","فَلا نَحنُ ما نَبقى وَلا الدَهرُ يَنفُدُ",18,"د",1,0],["يردي الفوارس منه ملتقى رشاءٍ","باللحظ والقدّ سياف ورماح",19,"ح",1,0],["يرد عنه عيون الحاسدين له","وكل سحرٍ ووسواس وخنَّاس",20,"س",1,0],["يَرُدن خلال الروض واليومُ داجنٌ","على أن يوم الدَّجن مِنهن شَامس",21,"س",1,0],["يُردي بِمِرْدى من الحِجاج له","دمّاغ رأس الضلالِ هضّاضه",22,"ض",2,0],["يردُّهمُ انهيالك بالعطايا","وما ينهالُ منك هناكُ جولُ",23,"ل",1,0],["يَرِدنَ الفَلاةَ حينَ لا يَستَطيعُها","ذَوُو الشاءِ مِن عَوفِ بنِ بَكرٍ وَأَهوَدا",24,"د",2,0],["يُرِدنَ ثَراءَ المالِ حَيثُ عَلِمنَهُ","وَشَرخُ الشَبابِ عِندَهُنَّ عَجيبُ",25,"ب",1,0],["يُرَدِّدُهُ حُزْنُنا في سكونٍ","على قَبْرِنا الصَّامتِ المطمئنْ",26,"ن",1,0],["يردى الصديق وتبقى","من بعده الذكريات",27,"ت",1,0],["يَرُدُّ يَداً عَن ثَوبِها وَهوَ قادِرٌ","وَيَعصي الهَوى في طَيفِها وَهوَ راقِدُ",28,"د",1,0],["يَرُدُّ أَبو الشِبلِ الخَميسَ عَنِ اِبنِهِ","وَيُسلِمُهُ عِندَ الوِلادَةِ لِلنَملِ",29,"ل",1,0],["يَرُدُّ على وَجْهِ الصَّبَاحِ لِثَامَهُ","إِذا حانَ من صبغِ الظلام نُصُولُ",30,"ل",1,0],["يُردّدُ طرفا في صَرى الدمع سابحاً","ويَرقِي فُؤاداً بالعَزاء مُصَابَا",31,"ب",2,0],["يَرُدُّ دبيبَ المارقين بوثبةٍ","وهل يتساوى وثبةٌ ودَبيبُ",32,"ب",1,0],["يَرُدُّ أَيَّ يَدٍ مُدَّت لِتَنقُصَها","مَجذوذَةَ الزَندِ أَو مَهذوذَةَ العَضُدِ",33,"د",1,0],["يَرُدُّ بَني الآمالِ بيضاً وُجوهُهُم","بِنائِلِهِ جَمُّ العَطايا جَزيلُها",34,"ل",3,0],["يُرَدِّدُني بَينَ المَدينَةِ وَالَّتي","إِلَيها قُلوبُ الناسِ يَهوي مُنيبُها",35,"ه",2,1],["يَرُدّونَ الحُلومَ إِلى جِبالٍ","وَإِن شاغَبتَهُم وَجَدوا شِغابا",36,"ب",2,0],["يَرُدُّ عَلى خَيشومِها مِن ضَجاجِها","لَها بَعدَ جَذبٍ بِالخَشاشِ جَريرُها",37,"ر",3,1],["يُرِدنَ الَّذي لا تُبتَغى مِن وَرائِهِ","وَلا دونَهُ الحاجاتُ ذاتُ الصَرائِمِ",38,"م",1,0],["يَرُدُّ على الصَهَّباءِ بَرْدَ فُؤادِها","إذا زارَها منه أخٌ وخَليلُ",39,"ل",1,0],["يُرَدِّدُ في غَرْسِ البَطالَةِ بعدَه","عيوناً تَراه مُقشَعِرَّ المَغارسِ",40,"س",1,0],["يُرْدي العِدا بالضَّرْبِ أبيضُه","ويُبيدُهُم بالطَّعْنِ أسمرُه",41,"ر",2,0],["يَرِدُ النَّدى وِرْدَ الظَّلماءِ على","نَهَلٍ يُبَرِّدُ منهمُ الحرَّا",42,"ر",2,0],["يرُدُّ إليها حيَّةَ الماءِ ما انكفَتْ","عن القصدِ أو صَدَّت صدودَ المُجانبِ",43,"ب",1,0],["يَرُدُّ الشُكوكَ المُشكِلاتِ إِذا اِلتَوَت","عَلَيهِ إِلى شَزرٍ مِنَ الرَأيِ مُحصَدِ",44,"د",1,0],["يَرِدُ الرُكبُ مِنُه بَحرَ سَماحٍ","مِن وِلا الجودِ بَحرٍ رَوِيِّ",45,"ي",1,0],["يَرُدُّ البَردَ وَالأَهواءَ عَنّا","وَيَأذَنُ لِلأَشِعَّةِ وَالضِياءِ",46,"ا",2,0],["يُردي الكُماةَ بِنَبلِهِ وَحُسامِهِ","ذا في كِنانَتِهِ وَذا في غِمدِهِ",47,"د",2,0],["يردّ عن الضرب الحديدَ مُثَلَّماً","ويثني عن الطّعنِ الوشيجَ مُقَصَّفا",48,"ف",2,0],["يُرْدي المدجَّجَ وهوَ غَيرُ مدجَّجٍ","كم دارِعٍ أرداه رمحُ الحاسِرِ",49,"ر",1,0],["يردّ لِسانُ العضبِ عندَ سُكوتِه","إِلى هامَةِ المِقدامِ عنه خِطابا",50,"ب",2,0],["يَرُدُّ أَنفاسَهُ كَرهاً وَتَعطِفُها","يَدُ المَنِيَّةِ عَطفَ الريحِ لِلغُصُنِ",51,"ن",1,0],["يَردي وَيُرقِلُ نَحوَ المَروَتَينِ كَما","يَردي وَيُرقِلُ نَحوَ الفارِسِ البَطَلِ",52,"ل",1,0],["يَردي بِأَروَعَ يَغتَدي وَيَروحُ مِن","زُوّارِهِ وَضُيوفِهِ في جَحفَلِ",53,"ل",1,0],["يُرِدنَ اِحتِيازَ السِرِّ مِنكَ فَلا تَبُح","بِما لَم تَكُن عَنهُ لَدَينا مُجَمجِما",54,"م",2,0],["يَرِدُ الدّماءَ مُطهَّراً ويخوضها","بَرَّ الوقائعِ والفتوحِ عَفيفا",55,"ف",2,0],["يَرِدُ الدّماءَ بَريئةً ويخوضُها","وَلْهَى ولم تَكُ مَطْمَحَ الوُرَّادِ",56,"د",1,0],["يَردُّونَ السّيوفَ بِلا قتالٍ","ويَلْوُونَ الأعِنَّةَ مُعرِضينا",57,"ن",2,0],["يُردِّدْنَ الصّهيلَ مُبشِّراتٍ","ويتلون الكتابَ مُبشِّرينا",57,"ن",2,0],["يردُّ الذّاهلين إلى نُهاهم","ويكشِفُ حَيرْةَ المُتعسِّفينا",57,"ن",2,0],[