{"poems":[[309,"حي حياليا الوصل في وادي الغيد","https://www.aldiwan.net/poem16898.html","عموديه"],[315,"هل غير بابك للغريب مؤمل","https://www.aldiwan.net/poem59512.html","الكامل"],[422,"إن جئت آل سلمى أو مغانيها","https://www.aldiwan.net/poem54145.html","البسيط"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82606","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201700","الخفيف"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/198890","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123503","المديد"],[5651,"ألِفارطِ العيشِ الرّطيبِ معيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=107007",""],[5690,"سر أريحَّ الشمال سرْ بسلام","https://www.poetsgate.com/ViewPoem.aspx?id=172187",""]],"verses":[["حي حياليا الوصل في وادي الغيد","وادي الخير والرحمة وكم جيد من جيد",0,"د",1,1],["حي حلول بالعراء ودونهم","قذف النوى إن يظعنوا أو يقبلوا",1,"ل",3,0],["حيِّ حياة المعنَّى في مواصلهم","كانوا منى النفس لو نالت أمانيها",2,"ي",3,0],["حَيِّ حانوتَه بِناحِيَة الكَر","خِ وَأَرطالَه عَلى كُلِّ باب",3,"ب",1,0],["حيِّ حرباً نموت فيها رجالاً","ان نمت في حمى الحياد نساء",4,"ا",2,0],["حي حلاحل من قحطان مسكنه","في منبت الذروة العليا لكهلان",5,"ن",1,0],["حيّ حيا قد حوى لعسا","عله يشقى الغليل عسى",6,"س",2,1],["حيٌّ حمت شهُبُ الرماحِ شموسَه","فشموسُهنّ أسنّةٌ وبُرودُ",7,"د",1,0],["حيِّ حيّ القيراط عني وقل أن","فؤادي موكلٌ بالخيامِ",8,"م",1,0]]}