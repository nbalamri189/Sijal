{"poems":[[65,"النائبات كثيرة الإنذار","https://www.aldiwan.net/poem46177.html","الكامل"],[23,"إن النضيرة ربة الخدر","https://www.aldiwan.net/poem21240.html","الكامل"],[53,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[53,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[87,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[102,"حزبية.. ومخبرون","https://www.poetsgate.com/ViewPoem.aspx?id=183586",""],[2,"إنَّ الرزية َ، لا رزية َ مثلها،","https://www.poetsgate.com/ViewPoem.aspx?id=5317",""],[197,"وما المرء في دنياه إلا كهاجع","https://www.aldiwan.net/poem13069.html","الطويل"],[199,"غدا ولم يقض من سلومة الوطرا","https://www.aldiwan.net/poem54407.html","البسيط"],[242,"خلوا سبيل الحوض","https://www.aldiwan.net/poem19301.html","مجزوء الرجز"],[286,"دعوني وتسكاب الدموع السوافك","https://www.aldiwan.net/poem1379.html",""],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[302,"أليلة الحشر لا بل يوم عاشور","https://www.aldiwan.net/poem33262.html","البسيط"],[385,"لا واِختلاس النظر","https://www.aldiwan.net/poem49232.html","مجزوء الرجز"],[403,"يا جارَ نَضلَةَ قد أنى لكَ","https://www.aldiwan.net/poem702.html",""],[422,"هاتها حمراء تحكي العندما","https://www.aldiwan.net/poem54068.html","الرمل"],[438,"مالك قلبي عن يد","https://www.aldiwan.net/poem12587.html","مجزوء الرجز"],[469,"هذه دولة الندى والسماح","https://www.aldiwan.net/poem3162.html","عموديه"],[484,"بالله أيكما الميت فنبكيه","https://www.aldiwan.net/poem36867.html","البسيط"],[490,"إني أتتني لسان لا أسر بها","https://www.aldiwan.net/poem1121.html",""],[498,"وداية ترضع عبر درها","https://www.aldiwan.net/poem67294.html","عموديه"],[580,"نسيت في أسماء حتى اسمي","https://www.aldiwan.net/poem3012.html","السريع"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2446","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126735","الكامل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137735",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48782","الكامل"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99981","السريع"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100133","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56081","الكامل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130625","الكامل"],[1235,"","https://poetry.dctabudhabi.ae/diwan/poem/105214","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46533","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80068","السريع"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124739","الكامل"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143011","الخفيف"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88644","البسيط"],[2551,"","https://poetry.dctabudhabi.ae/diwan/poem/204422","الوافر"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132306","البسيط"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137446",""],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130752","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130850",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100294","البسيط"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112626","الرجز"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127040","الكامل"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46020","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205922","البسيط"],[3822,"","https://poetry.dctabudhabi.ae/diwan/poem/147717","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135858","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136910",""],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97098","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81685","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120482","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52142","المتقارب"],[4750,"ون ابن جدلان","https://www.poetsgate.com/ViewPoem.aspx?id=180423",""],[4767,"استجارة","https://www.poetsgate.com/ViewPoem.aspx?id=184946",""],[4830,"حَوالِكُ النأي","https://www.poetsgate.com/ViewPoem.aspx?id=211128",""],[4929,"ازهري كالربيع","https://www.poetsgate.com/ViewPoem.aspx?id=206681",""],[5277,"نميرُ الحب","https://www.poetsgate.com/ViewPoem.aspx?id=191162",""],[5285,"قلق.. قلق","https://www.poetsgate.com/ViewPoem.aspx?id=203538",""],[5307,"وجه باسم","https://www.poetsgate.com/ViewPoem.aspx?id=10531",""],[5725,"شعر كالليل","https://www.poetsgate.com/ViewPoem.aspx?id=177518",""],[5725,"رثاء الشيخ نوري صالح الاوحيد","https://www.poetsgate.com/ViewPoem.aspx?id=215669",""],[5823,"بكائية لياسمين دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=59163",""],[5842,"حلب 2013 / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=137040",""],[6056,"كفيّ ، طوّ قت معصمه","https://www.poetsgate.com/ViewPoem.aspx?id=130137",""],[6102,"بَراءَةُ الذِّئب !!","https://www.poetsgate.com/ViewPoem.aspx?id=183166",""]],"verses":[["ينعَوْنَ فَرْعاً من ذَوائِبِ دَوْحَةٍ","خَضِلَتْ حَواشِيها عَلَيْهِ نُضارِ",0,"ر",1,0],["يَنعى الصَدى فيها أَخاهُ كَما","يَنعى المُفَجَّعُ صاحِبَ القَبرِ",1,"ر",1,0],["ينعت لألاؤُهُ عذوبتَهُ","وليس يُخفى نسيمُه خَصره",2,"ر",2,0],["يَنْعَشُ بالرأي والسَّماحِ إذا ارْ","تاحَ ويُغْرَى فيصرع البُهَما",3,"م",2,0],["يَنعى إِلَينا المَلِكَ ناعٍ لَم يَطَأ","أَرضاً وَلا اِنتَقَلَت بِهِ أَقدامُ",4,"م",1,0],["ينعقون إن رأوا بكفّي كتاباً","ويقولون لي: أغضُّ نعيقي",5,"ق",2,0],["يَنْعَوْنَ خَيرَ النّاسِ عندَ شَديدة","ٍ عَظُمَتْ مُصِيبتُهُ هناكَ وجلّتِ",6,"ت",1,0],["ينعِّمُهُ طَيفٌ مِنَ اللَهوِ باطِلٌ","وَيُوقِظُهُ نَومٌ مِنَ الدَهرِ فاجِعُ",7,"ع",1,0],["يَنعَونَ صَدعاً بِظُنبوبي كَأَنَّهُمُ","يَنعَونَ سَيِّدَ قَومٍ صادَفَ القَدَرا",8,"ر",2,0],["يَنْعَشُ كُلُّ عِرْضِ","فِي طُولِهَا وَالْعَرْضِ",9,"ض",1,0],["ينعّم في روض الرضا وتجوده","سحائب في كثبان مسكٍ عوانك",10,"ك",1,0],["يُنعمُ بالفِكاكِ","من رِبقةِ الشِباكِ",11,"ك",1,0],["يَنعَينَ يا جدُّ نال القَوم وِترَهُم","منّا وأوقع فينا كُلُّ محذورِ",12,"ر",1,0],["يُنعِشُني قَول الوَرى","فُؤادَهُ كَالحَجَر",13,"ر",1,0],["ينعونَ نَضلة بالرِّماحِ على","جُردٍ تَكَدَّس مِشيَةَ العُصمِ",14,"م",1,0],["ينعم الدهر علينا مرَّةً","فنرى شمل المنى منتظما",15,"م",2,0],["ينعَمُ بالطيفِ على","ناظريَ المسهَّدِ",16,"د",1,0],["ينعُ أغصانها الأسنةُ فانظر","كم جن ى زهرها من الأرواح",17,"ح",1,0],["ينعيه في الحسن الاخلاص ما نعيت","فيه الصداقة وارتاعت لأهليه",18,"ي",2,0],["ينعى امرأ لا تغب الحي جفنته","إذا الكواكب أخطا نوءها المطر",19,"ر",1,0],["ينعي إلى الطير امتداد عمرها","كأنما البندق بعد جرها",20,"ر",3,0],["ينعمُ بي من ظِلْتُ أَشْقَى به","كأَنَّني النَّفس معَ الْجِسْم",21,"م",1,0],["يَنعى بَني عَبدٍ وَإِخوَتَهُم","حَلَّ الهَلاكُ عَلى أَقارِبِيَه",22,"ي",2,0],["ينعى أبا بلقيس أكرم مَن له","شَهِدَ الفخار بفعله المحمودِ",23,"د",1,0],["ينعتم ببستان نبل ثمارا","وكنتم بحسن المآتي منارا",24,"ر",2,1],["ينعون فيه فرصة السوق التي","فيها الضمائر للغنى أثمان",25,"ن",1,0],["يَنْعَمُ مِنْهُ جِسْمُهُ تَارَةً","ثُمَّ تَرَاهُ جَاسِيَ الْجَسِّ",26,"س",1,0],["ينعاك منبرك الذي استبدلت عن","أعواده من نعشك الأعوادا",27,"د",2,0],["ينعيه من قلب له متعطشٍ","لفراقه قد ذاب من فرط الظما",28,"م",2,0],["ينعى هلالا في الطفوف طلوعه","قد حف في فلك الوغى بالأنجم",29,"م",1,0],["ينعى المكارم يا ليت النعي غدا","بفيه وجه الثرى من كاذب أشر",30,"ر",1,0],["يَنعم زيد بِالَّذي","بِمثله عَمرو أَذى",31,"ذ",2,0],["ينعي قتيل الطفِّ عند ابنه","المهديّ مولى الأنس والجن",32,"ن",1,0],["ينعمُ الجسمُ بالحياة قليلاً","ثم يدعوهُ بعد ذاك الفَنَاء",33,"ا",2,0],["ينعى إليك محافل الجهلاء","وأزافلَ الأوباشِ والغوغاءِ",34,"ا",2,0],["ينعق البوم حيث","كان يرن العود شوقا ويستحث الوصالا",35,"ل",2,0],["يَنعاه شبلاه لذاك الليث تصرعه","يد الردى يا رماها اللَه بالشلل",36,"ل",1,0],["ينعّم بال عيني أن أراه","أمام البيت محجره أسيل",37,"ل",1,0],["يُنَعِّمُ القلبَ تشويقٌ بها طرباً","فكُلُّ أَدهُرِهِ التَّنعيمُ والطَّرَبُ",38,"ب",1,0],["ينعت ثمار العلم منه بروضها","فدنت لذى قرب ومن لم يقرب",39,"ب",1,0],["ينعشُ الارض والسماء جميعاً","وله افترت الثغور احتفالا",40,"ل",2,0],["ينعش الأرض والخلائق طراً","وله افتر ثغرها استقبالا",41,"ل",2,0],["ينعاك نعي ذباب السيف قائمه","والكف ساعدها والساعد الظفرا",42,"ر",2,0],["ينعاك نعي قناة الخظ فقرتها","والقوس حنوتها والمعجس الوترا",42,"ر",2,0],["ينعاك نعي فتاة الحي واحدها","ولهي عليه تذيل الدمع منهمرا",42,"ر",2,0],["ينعاك لليل إذ تحييه مبتهلا","حتى تميت به آناءه سهرا",42,"ر",2,0],["ينعاك للصبح ردّ الليل حاجبه","حتى تمنطق بالظلماء واتزرا",42,"ر",2,0],["يَنعى إليها نَفسَهُ الحُسَينُ","يقولُ قَد دنا إليّ الحَينُ",43,"ن",1,0],["ينعى إمام هدى قد اندرست","من بعده الأحكام والسنن",44,"ن",1,0],["يَنعَقِد بِاللّينِ لُطفاً","عُقدَةَ العِقدِ الوَثيقَه",45,"ق",2,0],["ينعى على الشرف العالي مفاخره","وينثني وهو بالآثام مفتخرُ",46,"ر",1,0],["ينعشنا بدمعه المنسكب","يوقن من أبصره بالسلب",47,"ب",1,0],["ينعِّم الأرواحَ بالشهودِ","لذاتِ ذاتِك بلا جحودِ",48,"د",1,0],["ينعشه النسيم والزهور","بيضاء في فروعه تمور",49,"ر",1,0],["ينعم الناس بالحياة طويلا","ونصيبي من الحياة اللمام",50,"م",1,0],["ينعى هزبر عرينةٍ في عولة","هدت من الشمس الجبال رعانها",51,"ن",3,0],["ينعَى الصليبَ وحامليه وكلّ من","والاه حتَّى نفسَهُ وهو نادِب",52,"ب",1,0],["ينعش الروح قربه واذا ما","فاه حبي ميت الاماني كلامه",53,"م",2,0],["ينعَّم رهبنها بالثراء","ويحرَمُ كلُّ فتىً أصيدِ",54,"د",1,0],["ينعش القلب الحزين أبتهملاعه","لا مشا قام يتهملع تهملاعي",55,"ع",2,0],["ينعق الناعقون في الليل حتى","يأتي الرد من فحيح الأفاعي",56,"ع",2,0],["ينعشُ الروحَ طائفٌ منكَ يسري","كُلَّ حينٍ كما يدبُّ الجنينُ",57,"ن",1,0],["ينْعَمُ العقلُ في ثراه جنونا","ويصير الصواب صعبا عصيا",58,"ي",2,0],["يُنعشُ الوجدانَ عذبٌ بوحُهُ","إنْ عَناني أزهرتْ كلّ الدُّنا",59,"ن",2,0],["ينعي الأيامَ ورونقَها","ويقولُ وداعاً يا حبُّ",60,"ب",1,0],["ينعش نفس سجيمة","ويشفى من لانضراح",61,"ح",1,0],["ينعاه النجم بظلمته","وسواد المقلة يندبهُ",62,"ب",2,0],["ينعاك من درر الكلام نفيسه","إن حشرجتْ بالمادحين حروفُ",63,"ف",1,0],["ينعي الجمالُ مُغرّداً نسج الهوى","فغدا السّفيرَ, وشعرُه نُوّارُ",64,"ر",1,0],["ينعي حديقةَ أعلامٍº وأغنيةً","صارت لُهَاثَ جِمَارٍ تَنفثُ اللهبا",65,"ب",2,0],["يَنعي بِطاحَ بني حَمدانَ كيف بَدَتْ","بينَ الخَرابِ تُواسي أهلَها النُجبا",65,"ب",2,0],["ينعرف لاحوى ، جوف الفتى ينهمه","يآكل الجسم مثل النار، لأكل الحطب",66,"ب",1,0],["يَنعُمُ الجاهِلُونَ فِيهِ! وَيَشقَى","صاحِبُ العَقلِ وَالحِجا بِالحَرِيقِ!",67,"ق",1,0]]}