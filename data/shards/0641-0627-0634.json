ح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10667&r=&rc=21",""],[18,"هَلْ عَرَفْتَ الْغَدَاة َ مِنْ أَطْلاَلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26460&r=&rc=26",""]],"verses":[["فَأَشهَدُ أَن ما عَرَّقَت فيهِ هاشِمٌ","وَلا عُلَّ يَوماً مِن لَبانِ حَصانِ",0,"ن",1,0],["فَاِشدُد يَدَيكَ بِهِ يَدُم لَكَ ناقِضٌ","فيما يَؤُدُّ مِنَ الأُمورِ وَمُبرَمُ",1,"م",1,0],["فَأَشجَعُهُم إِذا فَزِعوا جَبانٌ","وَأَذكاهُم إِذا نَطَقوا حِمارُ",2,"ر",1,0],["فَأَشرَقَ خَدٌّ لاحَ مَوقِعُ لَثمِهِ","وَقَد كِدتُ لَولا خَشيَةُ اللَهِ أَلثِمُ",3,"م",1,0],["فأشْرَقَ العَدْلُ والأيامُ داجِيةٌ","بَثّتْ يَدُ الظُّلْمِ في أرجائِها الظُّلَما",4,"م",2,0],["فَأَشرَعتُ راياتٍ وَتَحتَ ظِلالِه","مِنَ القَومِ أَبناءُ الحُروبِ المَراجِحُ",5,"ح",1,0],["فَاِشفَعوا لي عِندَ فَوزٍ","فَلَقَد طالَ اِشتِياقي",6,"ي",1,0],["فَأَشرَقَت الدُنيا جَميعاً بِوَجهِها","بِلَيلَةِ سَعدٍ لا يَضِلُّ سُراتُها",7,"ت",3,0],["فَاشْمُلْ بِعَفْوِكَ مَنْ تَجَنَّى أَوْ جَنَى","واسْلُكْ طَرِيقَتَكَ الَّتِي هِيَ أَمْثَلُ",8,"ل",1,0],["فَاشْكُرِ اللَّهَ مَا اسْتَطَعْتَ بِفِعْلٍ","وَبِقَوْلٍ مُطّوَّلٍ أَوْ وَجِيزِ",9,"ز",1,0],["فاشْرَبْ علَى ذِكْرِ الحَبيبِ وسَقِّني","صَهْباءَ تُشْرِقُ في الظّلامِ الدّاجِي",10,"ي",1,0],["فاشْرَبْ وبُحْ باسْمي جِهاراً لا تَخَفْ","في الدّيْرِ منْ نَصَبٍ ولا إحْراجِ",10,"ج",1,0],["فَاِشرَع يَراعَكَ يا مُحَمَّدُ إِنَّهُ","نارُ اللِئامِ وَجَنَّةُ الأَحرارِ",11,"ر",1,0],["فَأَشارَت فَتاةُ مِصرَ وَقالَت","قَدكِ لَم تَترُكي لِمِصرَ كَلاما",12,"م",2,0],["فَأَشرِق عَلى تِلكَ النُفوسِ لَعَلَّها","تَرِقُّ إِذا أَشرَقتَ فيها وَتَلطُفُ",13,"ف",1,0],["فَاِشحَذ بِحُسنِ الرَأيِ عَزمي يُرَع","مِنّي العِدا أَلَيسَ شاكي السِلاح",14,"ح",1,0],["فَأَشْتَاتُ أَلْوَانٍ بِرِفْقِ مِزَاجِهَا","تَرِفُّ وَتَزْهُو أَوْ تَحُولُ وَتَقْتِمُ",15,"م",1,0],["فَاِشدُد أَميرَ المُؤمِنينَ وِثاقَهُ","فَأَصَحُّ مِنهُ بَقِيَّةَ الحَدّادِ",16,"د",1,0],["فَأَشرَفتُ الغُزالَةَ رَأسَ حَوضى","أُراقِبهُمُ وَما أَغنى قِبالا",17,"ل",2,0],["فاشم تعمل واشم تنشي","فالسعود هوت بديها",18,"ه",2,0],["فأشهبُ كالإصباح راق أديمه","وغالت به شهبَ السماء الغوائلُ",19,"ل",1,0],["فأشدُّ ما قد الجهول إلى الردى","عَمَهُ البصائر لا عمى الأبصارِ",20,"ر",1,0],["فاشكر صنيع الله فيك فإنه","سبحانه ضمن المزيد لمن شكرْ",21,"ر",1,0],["فاشرَأبَ الورى إليه وظنَوا","أنهم سوف يَبلغون المراما",22,"م",2,0],["فأشرق نور العلم من حَجَراته","على وجه عصر بالجهالة مظلم",23,"م",1,0],["فاشتك خصبيبه إيغالاً بنافذة","كأنما فجَّرت من قرو عصَّارِ",24,"ر",1,1],["فَأَشكو وَيَشكو مابِقَلبي وَقَلبِهِ","كِلانا عَلى نَجوى أَخيهِ أَمينُ",25,"ن",1,0],["فَأَشبَعَ مِن أَبطالِهِم كُلَّ طائِرٍ","وَذِئبٍ غَدا يَطوي البَسيطَةَ أَعفَرا",26,"ر",2,0],["فَأَشفي مِن طِعانِ الخَيلِ صَدراً","وَأُدرِكُ مِن صُروفِ الدَهرِ ثارا",27,"ر",2,0],["فَأَشكَرُ ماكُنتُ في ضَجرَتي","وَأَحلَمُ ماكُنتُ عِندَ الغَضَب",28,"ب",1,0],["فَاِشرَب مِنَ الخَمرِ ما آتاكَ مَشرَبُهُ","وَاِعلَم بِأَن كُلُّ عَيشٍ صالِحٍ فانِ",29,"ن",1,0],["فَأَشهَدُ أَنَّ أُمَّكَ مِلبَغايا","وَأَنَّ أَباكَ مِن شَرِّ العِبادِ",30,"د",1,0],["فَاِشكُروا اللَهَ الَّذي خَلَّصَنا","وَبَنى لي في المَعالي مَسكَنا",31,"ن",2,0],["فاشتدَّ إسكارها إيايَ إذ مُزِجَتْ","ومزجُك الكأسَ ينفي عنك طغياها",32,"ه",2,0],["فأشرنا به عليها فقالت","أيُّ أيرٍ يَهَشُّ للطَنْبَلَنْبِ",33,"ب",1,0],["فاشددْ أبا العباس كفّاً بهِ","فقد ثَقفتَ المخْطَبَ المِخرَبا",34,"ب",2,0],["فاشغل قريضك بالنسي","ب وبالفكاهة والمزاحِ",35,"ح",1,0],["فاشربِ الراح واقترحْ أن تُغَّنى","قُلْ ليوميك في ذرا النخل عودا",36,"د",2,0],["فاشْدُدْ بنيتك الجميلةِ قبضةً","فَلَيُنْجَزَنَّ وعيشِك الميعادُ",37,"د",1,0],["فاشكره إن خلَّاك تشكر منعماً","سُدٌّ أمامك منه بل أسدادُ",38,"د",1,0],["فإشفاقُها من أن يموتوا من الغنى","كإشفاقها من أن يموتوا من الفقر",39,"ر",1,0],["فاشكر وهيهات أن تُهدى لشكر يدٍ","وكيف يُهدَى غَويٌّ قَصْرُهُ سَقَر",40,"ر",1,0],["فاشكر إلهك لا تشرِك به أحداً","إن كان يُشكَر شيء كلّه شُهَر",40,"ر",1,0],["فاشكر شريكك إذ جزى","عُرفاً وقد أسديتَ نكرا",41,"ر",2,0],["فاشدُد يديك بنفعي","ولا تَعرَّض لضَيري",42,"ي",1,0],["فاشربْ على الحسْنين كأساً حسنها","شكل لحسنهما وتمّ المجلس",43,"س",1,0],["فأشبِعْ وأوجِعْ بالبِعادِ مؤدِّباً","فقد يُعْدم التقريبُ والبِرُّ دائمُ",44,"م",1,0],["فاشتروا الباقيات بالعرَضِ الأد","نى وبِيعوا انقطاعه بالدَّوام",45,"م",1,0],["فاشتريتَ السهاد بالنومِ جَهلاً","ورئمتَ الهوان بعدَ الكرامه",46,"م",2,0],["فَأَشرَفَ اللَهُ مِن عُلاهُ","يَشهَدُ لُبنانَ في المَساء",47,"ا",2,0],["فَاِشرَب بِروحِكَ خَمراً كُلُّها أَرَجٌ","وَاِنشُق بِروحِكَ عِطراً كُلُّهُ طَرَبُ",48,"ب",1,0],["فَأَشارَت فَإِذا لِلدودِ عَيثٌ في المَحاجِر","ثُمَّ قالَت أَيُّها السائِلُ إِنّي لَستُ أَدري",49,"ي",1,0],["فَأَشارَت لِيَ قَد حانَ الفُراق","فَاِنقَطَعنا وَاِرتَدَت ثَوبَ الطَبيب",50,"ب",1,0],["فَأَشَرتُ إِلَيهِ مَن أَنتا","فَأَجابَ أَنا ذاكَ الطِفلُ",51,"ل",1,0],["فَاِشتَغَلَ القَلبُ بِهِ بَلِ اِشتَعَل","وَسَفرَةٍ كَما يُقالُ في المَثَل",52,"ل",1,0],["فَأَشِر لي أَو فَاِدعُني أَو فَمُرني","أَنا في الكُلِّ سامِعٌ وَمُطيعُ",53,"ع",1,0],["فأَشاحوا عنها ومرُّوا غضاباً","واستخفُّوا به وقالوا بيأْسِ",54,"س",1,0],["فاشفوا الممالك من قضاة صُيَّد","قعدوا لصيد ولاية أو زاد",55,"د",1,0],["فَأَشَرتُ فَاِلتَفَتَت فَقُل","تُ لَها مَقالَةَ مُشفِق",56,"ق",1,0],["فَأَشارَ السَيِّدُ العالي","إِلى مَن كانَ حَولَه",57,"ل",2,0],["فَاِشتَغَلَ الراعي عَنِ الجِدارِ","وَنَزَلَ القِطُّ عَلى بِدارِ",58,"ر",1,0],["فَاِشتَهَت مِن لَحمِهِ نَفسُ الرَئيس","وَكَذا الأَنفُسُ يُصيبُها النَفيس",59,"س",1,0],["فَاِشتَغَلَ القَلبُ عَلَيهِ وَاِشتَعَل","وَسارَتِ الأُمُّ لَهُ عَلى عَجَل",60,"ل",1,0],["فَاِشدُد بِأَربابِ النُهى سُكّانَها","وَاِجعَل مِلاكَ شِراعِها الأَكفاءَ",61,"ا",2,0],["فأشر إِليه إِشارةً يرعى بها","حقي ويغمد ما انتضى من نصله",62,"ل",2,0],["فَاِشرَب عَلى زَهرِ الرِياضِ يَشوبُهُ","زَهرُ الخُدودِ وَزَهرَةُ الصَهباءِ",63,"ا",2,0],["فَأَشهَدُ أَنّي في اِختِيارِكَ دونَهُم","مُؤَدّاً إِلى حَظّي وَمُتَّبِعٌ رُشدي",64,"ي",1,0],["فَاُشكُر يَدَ الأَيّامِ في حَسَنٍ فَقَد","عَفّى إِساءَتَها بِهِ إِحسانُها",65,"ن",3,0],["فَاشدُد أَبا العَبّاسِ كَفَّكَ بِالعُلا","إِنَّ العُلا مِن أَشرَفِ التيجانِ",66,"ن",1,0],["فَأَشْرَبُ مِن يُمْنَاهُ ما فَوْقَ خَدِّهِ","وأَلْثِمُ مِنْ خَدَّيْهِ مَا في يَمينِهِ",67,"ن",2,0],["فاشرَبْ على الوَرْدِ قبلَ فُرقَتِه","فالوردُ 