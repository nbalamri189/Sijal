لمديد"],[562,"قل للوزير إذا وقفت ببابه","https://www.aldiwan.net/poem52800.html","الكامل"],[562,"هذه رسالة صب دائم القلق","https://www.aldiwan.net/poem52904.html","البسيط"],[562,"فدى الجلابيب والأطمار من وبر","https://www.aldiwan.net/poem52941.html","البسيط"],[562,"لمن الدمع بعد هذا تصون","https://www.aldiwan.net/poem52978.html","الخفيف"],[562,"أي ذنب ترى وأية زله","https://www.aldiwan.net/poem52985.html","الخفيف"],[567,"يا ريم كم أدنو وأنت تريم","https://www.aldiwan.net/poem69526.html","الكامل"],[567,"الثلج يسقط أم لجين يسبك","https://www.aldiwan.net/poem69558.html","الكامل"],[567,"عرش العلا منهدم مؤتفك","https://www.aldiwan.net/poem69561.html","الرجز"],[567,"راح وتفاحة من كف جارية","https://www.aldiwan.net/poem69707.html","البسيط"],[575,"من يشتري لي أشجان","https://www.aldiwan.net/poem2842.html","منهوك المنسرح"],[575,"يا من تجنيه جنايات","https://www.aldiwan.net/poem2981.html","السريع"],[575,"راح رسولي وجاءني عاشق","https://www.aldiwan.net/poem3045.html","المنسرح"],[575,"عاد قلب الشوق إذ عدت عيده","https://www.aldiwan.net/poem3077.html","الخفيف"],[575,"راحت وحق الله روحي","https://www.aldiwan.net/poem3090.html","مجزوء الكامل"],[585,"الصفو من ماء العنب","https://www.aldiwan.net/poem1563.html",""],[586,"وافي الربيع فسر إلى السراء","https://www.aldiwan.net/poem17406.html","الكامل"]],"verses":[["راحَت مَعَ الغِزلانِ قَد","لَعِبَت بِقَلبي ما كَفاها",0,"ا",3,0],["راحَ عَلى بَيتي الثَناءُ وَالكَرَم","لا سَلِمَ المالُ إِذا العِرضُ سَلِم",1,"م",1,0],["راحٌ يَحولُ شُعاعُها","بَينَ الضَمائِرِ وَالعُقولِ",2,"ل",1,1],["راحِلٌ أَنتَ وَاللَيالي نُزولُ","وَمُضِرٌّ بِكَ البَقاءُ الطَويلُ",3,"ل",1,1],["راحَت تَعَجَّبُ مِن شَيبٍ أَلَمَّ بِهِ","وَعاذِرٌ شَيبَهُ التَهمامُ وَالأَسَفُ",4,"ف",1,0],["راحَت تُريحُ عَليكَ الهَمَّ صاحِيَةً","وَعِندَ قَلبِكَ مَن غَيِّ الهَوى سَكَرُ",5,"ر",1,0],["راحَت نَوازِعُ مِن قَلبي تُتَبِّعُهُ","عَلى بَقايا لُباناتٍ وَأوطارِ",6,"ر",1,0],["راحِلٌ عَنكَ وَهوَ يَرقُبُ لُقيا","كَ إِلى الحَولِ عَن عَلاقَةِ صَبِّ",7,"ب",1,0],["راحَتي في الكَلامِ حَتّى أَراكِ","إِنَّ بي مِنكِ شاغِلاً عَن سِواكِ",8,"ك",1,1],["رَاحَ يَسْقِي فَصَبَّ فِي الْكَأْسِ نَزْراً","ثِقَة مِنْهُ بِالَّذِي فِي الْعُيُونِ",9,"ن",1,0],["راحَتْ تُذكِّرُني كُؤوسَ الرّاحِ","والقُرْبُ يخْفِضُ للجُنوحِ جَناحي",10,"ي",1,0],["راحَت فَصَحَّ بِها السَقيم","ريحٌ مُعَطَّرَةُ النَسيم",11,"م",1,1],["راحَ تُمرِيهِ الصَبا ثُمَّ اِنتَحى","فيهِ شُؤبوبُ جُنوبٍ مُنفَجِر",12,"ر",1,0],["راحَت يَشُجُّ بِها الآكامَ مُنصَلِتاً","فَالصُمُّ تُجرَحُ وَالكَذّانُ مَحطومُ",13,"م",1,0],["راحَت مِنَ الخُرجِ تَهجيراً فَما وَقَفَت","حَتّى اِنفَأَى الفَأَو عَن أَعناقِها سَحَرا",14,"ر",2,0],["راحَت يُقَحَّمُها ذو أَزمَلٍ وَسَقَت","لَهُ الفَرائِشُ وَالسُلبُ القَياديدُ",15,"د",1,0],["راحوا وقد أعقبوا من بعدهم عَقِباً","ناموا عن الأمر تفويضاً إلى القَدَر",16,"ر",1,0],["راحوا مِنَ اجلِكِ مُقصَدينَ وَقَد رَأوا","خَلَلَ الحِجالِ سَوالِفاً وَخُدودا",17,"د",2,0],["راحَ الرِفاقُ وَلَم يَرُح مَرّارُ","وَأَقامَ بَعدَ الظاعِنينَ وَساروا",18,"ر",3,1],["راحَت خُزَيمَةُ بِالجِيادِ كَأَنَّها","عِقبانُ مُدجِنَةٍ نَفَضنَ طِلالا",19,"ل",2,0],["راحوا يُحَيّونَ مَحموداً شَمائِلُهُ","صَلتَ الجَبينِ وَفي عِرنَينِهِ شَمَمُ",20,"م",1,0],["راحَ القَطينُ بِهَجرٍ بَعدَما اِبتَكَروا","فَما تُواصِلُهُ سَلمى وَما تَذَرُ",21,"ر",1,1],["راحت له من جنوح الليل نافجة","لا الضبَ ممتنع منها ولا الوَرَلُ",22,"ل",1,1],["راحَت وَصاحِبُها بِعُرسٍ حاضِرٌ","يُرضي الإِلَهَ وَأَهلُها في مَأتَمِ",23,"م",1,0],["راحاً غريتُ بريَّاها ومشربها","حتَّى انتصبت إليها نصب إغراء",24,"ا",2,0],["راحٌ زحفت على جيشِ الهموم بها","حتَّى كأنَّ سنا الأكوابِ رايات",25,"ت",1,0],["راحةُ النفس والصِّيانةُ والعف","فَةُ والأمنُ في حياء رَواءِ",26,"ا",2,0],["راحَ شَيْبي عليَّ مثلَ الثَّغامِ","وغدا عاذلي ألدَّ الخصامِ",27,"م",1,1],["راحَ القَطينُ مِنَ الثَغراءِ أَو بَكَروا","وَصَدَّقوا مِن نَهارِ الأَمسِ ما ذَكَروا",28,"ر",3,1],["راحٌ تَعارَفَ فيها مَعشَرٌ شُطُرٌ","ما بَينَهُم غَيرَها إِلٌّ وَلا نَسَبُ",29,"ب",1,1],["راحوا وَهُم يَحسِبونَ الأَرضَ في فَلَكٍ","إِن صُرِّعوا وَقَتِ الراحاتُ وَالرُكَبُ",29,"ب",1,0],["راحَت تُقَعقِعُ حَولي","فَكادَ عَقلي يَطيرُ",30,"ر",1,0],["راحَت تُناصِبُنا العِداءَ كَأَنَّما","جِئنا فَرِيّاً أَو رَكِبنا موبِقا",31,"ق",2,0],["راحَ غَضباناً فَما كَل","لَمَني مُذ لَيلَتَينِ",32,"ن",1,0],["راحَ يَدعونا التَصابي","فَسَمِعنا وَأَطَعنا",33,"ن",2,0],["راحَت كَما راحَ أَو تَغدو كَغَدوَتِهِ","عَنسٌ تَجودُ عَلَيها راكِبٌ أَفِدُ",34,"د",1,0],["راحَ لا يَملِكُ إِلّا دَعوَةً","جبرَ اللَهُ العُفاةَ الضُيَّعا",35,"ع",2,0],["راحة في افكاره في حشاه","في هواه في قلبه في الضمير",36,"ر",1,0],["راحَةُ النُفوسِ وَهَل","عِندَ راحَةٍ تَعَبُ",37,"ب",1,0],["راحَ دينٌ وَجاءَ دينٌ وَوَلّى","مُلكُ قَومٍ وَحَلَّ مَلِكٌ مَكانَه",38,"ن",2,0],["راحِلاً في مِثلِ أَعمارِ المُنى","ذاهِباً في مِثلِ آجالِ الزَهَر",39,"ر",1,0],["راحَت لِأَربُعِكِ الرِياحُ مَريضَةً","وَأَصابَ مَغناكِ الغَمامُ الصَيِّبُ",40,"ب",1,0],["راحَ عَنهُ الزَيتونُ مُتَّسِعَ الأَف","ياءِ وَالنَخلُ باسِقاً جُمّارُه",41,"ر",2,0],["راحَ بنُ رَوحٍ بِسوءِ اللَفظِ يَحشِمُني","وَالغَيظُ يَبرُقُ في عَينَيهِ وَالحَنَقُ",42,"ق",1,0],["راحَ أَهلُ الآدابِ فيها قَليلاً","وَحُظوظُ الأَقسامِ فيها قَليلَه",43,"ل",2,0],["راحَت تُسِرُّ دُموعاً غَيرَ مُعلَنَةٍ","وَرُحتُ أُعلِنُ دَمعاً غَيرَ مُكتَتَمِ",44,"م",1,0],["راحَ فيمَن يُشَيِّعُ الأَظعانا","رَبِّ فَإِحفَظهُ وَالهَوى حَيثُ كانا",45,"ن",2,1],["راحوا بِأَبيَضَ مِثلِ البَدرِ يَحمِلُهُ","غُتمُ العُلوجِ بَأَقيادٍ مُذِلّاتِ",46,"ت",1,0],["رَاحُوا به واللّحظُ يقدَحُ جُرأةً","فَيكُرُّ بين حُجولِه وحِجالِه",47,"ل",2,0],["راحَ المُغِيرةُ وهو من أجوادِه","وغَدا قُبَيصةُ وهو من أبطالِه",47,"ل",2,0],["راحٌ تولَّى سبكَها التَّعتيقُ","عَتَّقَها من عُمْرٍ الزَّرنوقُ",48,"ق",1,0],["راحَ الغمامُ به صَفيقاً ثوبُه","وغدا به ثوبُ النَّسيمِ رَقيقا",49,"ق",2,0],["راحُوا رِياحاً تُزجِّى كلَّ ساريةٍ","من النَّدى وغدَوا لِلحِلْمِ أطوادا",50,"د",2,0],["راحوا عن الراح وقد بدَّلوا","مشيَ الفرازينِ بمشي الرِّخاخ",51,"خ",1,0],["راحَ يُحيِّيكَ بها شادنٌ","زَيَّنَه ظَرْفٌ وتأديبُ",52,"ب",1,0],["راحَ الصِّيامُ فولَّى عنك مُنقَضِباً","ورحتَ عنه بأجرٍ غيرِ مُنقضِبِ",53,"ب",1,0],["راحَ يُبْدي لمن أتى مُستجيراً","من صُروفِ الزَّمانِ أو مُستَثنيا",54,"ي",2,0],["راحوا بمثلِ الرِّيمِ لولا ما أرى","من وَشْيِه وشُنوفِه وخِضابِه",55,"ب",2,0],["راحاتُهُ مُذ نَشا في المُلكِ قَد عَهِدَت","يَومَ النَدى وَالرَدى بِالنَفعِ وَالضَرَرِ",56,"ر",1,0],["راحَت إِلى جَنَّةٍ حَلَّ العُفاةُ بِها","في الخُلدِ وَاِتَّكَأوا فيها عَلى سُرُرِ",56,"ر",1,0],["راحٌ مُعَتَّقَةٌ وَشادٍ مُطرِبٌ","طَلقٌ مُحَيّاهُ وَساقٍ أَغيَدُ",57,"د",1,0],["راحٌ حَكَت ثَغرَ الحَبيبِ وَخَدَّه","بِحَبابِها وَصَفائِها وَصِفاتِها",58,"ت",3,0],["راحاً إِذا مَلَأَ الساقي بِها قَدَحاً","ظَنَنتَ جُذوَةَ نارٍ في الدُجى قَدَحا",59,"ح",2,0],["راحوا بأرواحٍ ظماء","يتهافتون على الفناء",60,"ا",2,1],["راحت الأيام","بابتسام الثغور",61,"ر",1,0],["راحتْ من الشحْم فوق القار لابسةً","فيه تأزُّرَ أنوارٍ على ظُلَمِ",62,"م",1,0],["راحٌ أضافتْ إلى دَمي دَمَها","طبائعٌ في المزاج تَتّفِقُ",63,"ق",1,0],["راحَتي في البُكاءِ حَتّى أَراكا","إِنَّ لي مِنكَ شاغِلاً عَن سِواكا",64,"ك",2,1],["راحَت وُفودُ الأَرضِ عَن قَبرِهِ","فارِغَةَ الأَيدي مِلاءَ القُلوبِ",65,"ب",1,0],["راحَ التَنَصُّلُ مَعقوداً بِأَلسُنِهِم","لَمّا غَدا السَيفُ في أَعناقِهِم حَكَما",66,"م",2,0],["راحَتي في الثَناءِ ما بَقِيَت لي","فَضلَةٌ مِن لِسانِيَ المَفتوقِ",67,"ق",1,0],["راحَت غَواني الحَيِّ عَنكَ غَوانِياً","يَلبَسنَ نَأياً تارَةً وَصُدودا",68,"د",2,0],["راحٌ إِذا ما الراحُ كُنَّ مَطِيَّها","كانَت مَطايا الشَوقِ في الأَحشاءِ",69,"ا",2,0],["راحَتْ تُمَزِّقُ كُلّ الهازِئينَ بها","وحَوْلَكِ اسَّاقَطَتْ مَهْزوزَةً مِزَقا",70,"ق",2,0],["راحَ صَحبي وَلَم أُحَيِّ النَوارا","وَقَليلٌ لَو عَرَّجوا أَن تُزارا",71,"ر",2,1],["راحَ صَحبي وَعاوَدَ القَلبَ داءُ","مِن حَبيبٍ طِلابُهُ لي عَناءُ",72,"ا",2,1],["راحوا يَصيدونَ الظِباءَ وَإِنَّني","لَأَرى تَصَيُّدُها عَلَيَّ حَراما",73,"م",2,1],["راح السّلامُ مَصوناً في كِلاءتِه","وبات كلُّ فتىً بالأمنِ مُدَّرعا",74,"ع",2,0],["راحوا به صَيِّباً مِن حِكمةٍ وَهُدىً","في صَيِّبٍ من دُموعِ الرُّسْلِ رَجَّاسِ",75,"س",1,0],["راحت تُخادعُ منهم كُلَّ مُختَبِلٍ","فما تَريعُ ولا يَنْأَى بها السَّأَمُ",76,"م",1,0],["راحوا سِماناً في المواكبِ بُدَّناً","وأراه يُوشكُ أن يموتَ هُزالا",77,"ل",2,0],["راحوا يُ