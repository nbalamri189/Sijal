{"poems":[[53,"نطق اللسان عن الضمير","https://www.aldiwan.net/poem30476.html","مجزوء الكامل"],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[86,"قد غفونا وانتبهنا فإذا","https://www.aldiwan.net/poem10358.html","الرمل"],[10,"إن كنت عن وجدك لم تقصري","https://www.aldiwan.net/poem21081.html","السريع"],[93,"في حيكم لي قلب جد مرتهن","https://www.aldiwan.net/poem11218.html","البسيط"],[88,"يا قوم إن العدى قد هاجموا الوطنا","https://www.aldiwan.net/poem44462.html","البسيط"],[88,"شكاية قلب بالأسى نابض العرق","https://www.aldiwan.net/poem44834.html","الطويل"],[88,"تيقظ فما أنت بالخالد","https://www.aldiwan.net/poem44977.html","المتقارب"],[88,"أشر فعل البرايا فعل منتحر","https://www.aldiwan.net/poem44985.html","البسيط"],[27,"بان الخليط فما له من مطلب","https://www.aldiwan.net/poem5661.html","الكامل"],[27,"لمن الديار رسومهن خوالي","https://www.aldiwan.net/poem5974.html","الكامل"],[23,"إن الذوائب من فهر وإخوتهم","https://www.aldiwan.net/poem21254.html","البسيط"],[72,"على اليمن والنعمى قدوم أحبة","https://www.aldiwan.net/poem19177.html","الطويل"],[72,"برغمي أن غاض الندى بكماله","https://www.aldiwan.net/poem19530.html","الطويل"],[64,"أجريت فيك دموعي","https://www.aldiwan.net/poem67536.html","المجتث"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"أراك أشفقت من الفالج","https://www.aldiwan.net/poem9247.html","السريع"],[51,"تركنا لكم دنياكم وتخاضعت","https://www.aldiwan.net/poem61913.html","الطويل"],[51,"تكلمي في كمامك","https://www.aldiwan.net/poem65762.html","المجتث"],[51,"أقرِن إلى حسنِ وجهك الحسنِ","https://www.aldiwan.net/poem66526.html","المنسرح"],[14,"أقلي علي اللوم يا بنت منذر","https://www.aldiwan.net/poem38304.html","الطويل"],[92,"يا لاابتسامة قلب","https://www.aldiwan.net/poem38892.html","مجزوء الكامل"],[92,"يا رفيقي وأين أنت فقد","https://www.aldiwan.net/poem38907.html","الخفيف"],[85,"جلوسك أم سلام العالمينا","https://www.aldiwan.net/poem7798.html","الوافر"],[85,"إلى حسين حاكم القنال","https://www.aldiwan.net/poem63688.html","الرجز"],[85,"يا قوم عثمان والدنيا مداولة","https://www.aldiwan.net/poem63738.html","البسيط"],[43,"أحلما نرى أم زمانا جديدا","https://www.aldiwan.net/poem9540.html","المتقارب"],[62,"إذا لم يعن قول النصيح قبول","https://www.aldiwan.net/poem52321.html","الطويل"],[62,"يقولون تاج الملك بعد خموله","https://www.aldiwan.net/poem52393.html","الطويل"],[62,"يقولون أبق المال واجمعه ممسكا","https://www.aldiwan.net/poem52509.html","الطويل"],[45,"أبقاك ربك في عز وتأييد","https://www.aldiwan.net/poem63547.html","البسيط"],[45,"أفي كل دار منك عين ترقرق","https://www.aldiwan.net/poem65183.html","الطويل"],[66,"وفى لي فيك الدمع إذ خانني الصبر","https://www.aldiwan.net/poem40123.html","الطويل"],[66,"سلوا بعد تسآل الورى عنكم عني","https://www.aldiwan.net/poem41581.html","الطويل"],[87,"أعد على السمع ذكر البان والعلم","https://www.aldiwan.net/poem8243.html","البسيط"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"سل بالصبوح غبوقا","https://www.aldiwan.net/poem26792.html","المجتث"],[52,"ألا من لعين وتسكابها","https://www.aldiwan.net/poem27305.html","المتقارب"],[67,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[75,"ألا طرقتنا والنجوم ركود","https://www.aldiwan.net/poem69091.html","الطويل"],[48,"طاب الزمان وأورق الأشجار","https://www.aldiwan.net/poem63309.html","الكامل"],[48,"فداؤك نفسي قد طربت إلى الكأس","https://www.aldiwan.net/poem63432.html","الطويل"],[50,"وقد كنت في ذاك الزمان الذي مضى","https://www.aldiwan.net/poem62378.html","الكامل"],[50,"من المفتون بشار بن برد","https://www.aldiwan.net/poem63854.html","الوافر"],[46,"يا ملوك البلاد فزتم بنسء ال","https://www.aldiwan.net/poem22029.html","الخفيف"],[46,"قد أسرف الإنس في الدعوى بجهلهم","https://www.aldiwan.net/poem22087.html","البسيط"],[46,"فوارس الدهر جاءت تسبق النذرا","https://www.aldiwan.net/poem22617.html","البسيط"],[46,"ثلاث مراتب ملك رفيع","https://www.aldiwan.net/poem22836.html","الوافر"],[46,"سترعى إذا ألفيت للفظ خازنا","https://www.aldiwan.net/poem23468.html","الطويل"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42491","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42696","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54733","المتقارب"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116955","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142337","الخفيف"],[100,"نار وقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=50445",""],[18,"جَارَتْ بَنُو بَكْرٍ وَلَمْ يَعْدِلُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26453&r=&rc=19",""]],"verses":[["فَاِنفَح لَنا مِن راحَتَي","كَ بِلا القَليلِ وَلا النَزورِ",0,"ر",1,0],["فَأَنِفْتَ لِلدِّينِ الْحَنِيفِ وَأَهْلِهِ","مِنْ خُطَّةِ الْخَسْفِ الَّتِي قَدْ حُمِّلُوا",1,"ل",3,0],["فَاِنفُضوا النَومَ وَجِدّوا لِلعُلا","فَالعُلا وَقفٌ عَلى مَن لَم يَنَم",2,"م",1,0],["فَإِنَّ في العُقدَةِ مِن يَلبَنٍ","عُبرَ السُرى في القُلُصِ الضُمَّرِ",3,"ر",1,0],["فَأَنْفَعُ النَّاسِ هُمْ أَهْلُ السَّمَاحِ بِمَا","يُنْمِي نُفُوساً عَلَى الأَخْلاقِ وَالفِطَنِ",4,"ن",1,0],["فإن فيه رجالاً من بني مضر","إذا تحارب لا تستشفع الهُدَنا",5,"ن",2,0],["فإن فعلوا هذا فيا مرحباً بهم","وإلا فيا سُحق المعاند مِن سحق",6,"ق",1,0],["فإن فتى الدهر من يَدّعي","فتأتي أعاديه بالشاهد",7,"د",1,0],["فإن في البشر الراقي بخلقته","من قد أنِفت به أنّي من البشر",8,"ر",1,0],["فَانفَح لَنا بِسِجالِ فَضلٍ مِنكُمُ","وَاِسمَع ثَنائي في تَلاقي الأَركُبِ",9,"ب",1,0],["فَاِنفُخ بِكيرِكَ يا فَرَزدَقُ إِنَّني","في باذِخٍ لِمَحَلِّ بَيتِكَ عالي",10,"ي",1,0],["فَاِنفُخ بِكيرِكَ يا فَرَزدَقُ وَاِنتَظِر","في كَرنَباءَ هَدِيَّةَ القُفّالِ",10,"ل",1,0],["فَإِنَّ في حَربِهِم فَاِترُك عَداوَتُهُم","شَرّاً يُخاضُ عَلَيهِ الصابُ وَالسَلَعُ",11,"ع",1,0],["فإن فازَ مولانا بحجٍّ أتمه","فها نحن في نعمائه نتمتّع",12,"ع",1,0],["فأنفقت ما أحرزت بالبذل ذخره","وما ذخر مال المرء غير ابتذاله",13,"ل",2,0],["فَإِن فَنى فيكَ بَعضي","حُفِظتُ منكَ لَدَيكَ",14,"ك",1,0],["فإن فاته قَطْرٌ وثلج فإنه","رَهين بسافٍ تارةً أو بحاصبِ",15,"ب",1,0],["فإن في دِجْلة حِيتانَها","عديدُ ضعْفَيْ موجها المائجِ",16,"ج",1,0],["فإن فخرتْ بالجُود ألْسُنُ معْشرٍ","عَضَضْتُمْ على صُغْرٍ بِصُمّ الجلامدِ",17,"د",1,0],["فإنَّ في فيك حُشّاً","يفوح عند كلامِكْ",18,"ك",1,0],["فانفعْ أو امنعْ ولا تكن رجلاً","ميعادُهُ محنةٌ من المِحَنِ",19,"ن",1,0],["فَإِن فازَ سَهمٌ لِلمَنِيَّةِ لَم أَكُن","جَزوعاً وَهَل عَن ذاكَ مِن مُتَأَخِّرِ",20,"ر",1,0],["فانفخْ بها من لهيبِ","السَّماءِ رُوحاً خَضيبهْ",21,"ه",1,0],["فانْفُخِ النَّايَ إنَّهُ هِبَةُ","الأَملاكِ للمستعيذِ بالإِلهامِ",22,"م",1,0],["فإن فتشت عن بيت القصيد","قرأت الفتح والنصر المبينا",23,"ن",2,0],["فَإِن فَعَلتَ فَالقَوافي تَفعَلُ","ما هُوَ مِن فِعلِ الزُهورِ أَجمَلُ",24,"ل",1,0],["فانٍ فَفيهِ مِنَ الجَرحى مُشاكَلَةٌ","حَتّى إِذا قيلَ ماتوا اِخضَرَّ رَيحانا",25,"ن",2,0],["فَأَنفَدتَ مِن عَيشِهِنَّ البَقاءَ","وَأَبقَيتَ مِمّا مَلَكتَ النُفودا",26,"د",2,0],["فإنْ فرَّ لم يَعْدَمْ شِفاءً وإن ثَوى","فأمُّ الذي يبغي الثَّواءَ ثكُولُ",27,"ل",1,0],["فإنْ فاتَهُ واللّهُ بالغُ أمرِه","فأعمَى يُكَدِّي في المساجدِ أو يُقْرِي",28,"ر",2,0],["فأَنفِقْ فإِن العينَ يركُدُ ماؤُها","فيأسَنُ والمنزوحُ يعذُبُ ماؤهُ",29,"ا",3,0],["فَإِن فَعَلتَ وَإِلّا لَستُ أَطلُبُهُ","ما عِشتُ مِنكَ وَحَسبي بَذلُ مَجهودي",30,"ي",1,0],["فَأَنفَقَ في العَلياءِ حَتّى حَسِبتَهُ","مِنَ الدَهرِ يُعطى أَو مِنَ الدَهرِ يُنفِقُ",31,"ق",1,0],["فَإِن فَلَّتِ الأَيّامُ حَدَّ مُحَمَّدٍ","فَقَد جَرَّدَت سَيفاً بِهِ يُدرَكُ الوِترُ",32,"ر",1,0],["فَإِن فَلَّتِ الأَيّامُ في الحَربِ حَدَّهُ","فَما زالَتِ الأَيّامُ في أَهلِها تَجني",33,"ي",1,0],["فَانْفُضْ يَدَيْكَ مِنَ الدُّنْيَا فَلَسْتَ تَرَى","خِلاً وَفِيّاً وَعَهْدَاً غَيْرَ مُنْصَرِمِ",34,"م",1,0],["فَأَنفَذَت مِصرُ إِلَيهِ مالَها","فَأَصلَحَت حَصراً إِلَيهِ حالَها",35,"ه",2,0],["فَإِنَّ في ذاكَ عِندي","رَأياً مُضيئاً وَثيقا",36,"ق",2,0],["فَإِن فُرصَةٌ أَمكَنَت في العَدُو","وِ فَلا تَبدِ فِعلَكَ إِلّا بِها",37,"ب",3,0],["فإنْ فَوَّضَ السُّلْطانُ أَمْرَ بِلادِهِ","إليه فما خَلْقٌ بِهِ منه أَجْدَرُ",38,"ر",1,0],["فإنَّ فَضْلَ رسولِ الله ليسَ لهُ","حَدُّ فيُعْرِبَ عنه ناطِقٌ بِفَمِ",39,"م",1,0],["فأنفاسُهُنّ الحامياتُ صَواعقٌ","وأفواهُهُنّ الزافراتُ حَديد",40,"د",1,0],["فَاِنفِ الوِقارَ عَنِ المُجونِ بِقَهوَةٍ","حَمراءَ خالَطَ لَونَها إِقمارُ",41,"ر",1,0],["فَإِن فَطِنوا قُلنا نَصارى وَعيدُهُم","وَلَيسَ لِشُربِ الراحِ في العيدِ مِن باسِ",42,"س",1,0],["فَإِن فاتَني إِلفٌ ظَلَلتُ كَأَنَّما","يُديرُ حَياتي في يَدَيهِ مُديرُ",43,"ر",1,0],["فَإِنَّ فَتاتَكُمُ سَلَبَت فُؤادي","فَنِصفٌ عِندَها وَالنِصفُ عِندي",44,"ي",1,0],["فَاِنفَرِد ما اِستَطَعتَ فَالقائِلُ الصا","دِقُ يُضحي ثِقَلاً عَلى الجُلَساءِ",45,"س",3,0],["فَاِنفَع أَخاكَ عَلى ضُعفٍ تُحِسُّ بِهِ","إِنَّ النَسيمَ بِنَفعِ الروحِ هَبّابُ",46,"ب",1,0],["فَإِنَّ في الطَيرِ ذا ريشٍ بِهِ ضَرَعٌ","إِذا أَفاقَ أَطالَ النَطقَ وَالهَذَرا",47,"ر",2,0],["فَإِن فَعَلَ الفَتى خَيراً تَعالى","إلى قِنسِ المَلائِكِ خَيرِ قِنسِ",48,"س",1,0],["فَأَنفِق بِميزانٍ مَقالَكَ وَاِبتَعِث","يَدَيكَ بِما أوتيتَ وَزناً وَلا وَزنا",49,"ن",2,0],["فإِنَّ في المَجازِ والتَّأويلِ","ضَلَّتْ أساطيرُ ذَوي العُقُولِ",50,"ل",1,0],["فانْفُضْ يَدَيْكَ مِنَ الزَّمانِ وأَهْلِهِ","فالسَّعْيُ في طَلَبِ الصَّديِقِ هَبَاءُ",51,"ا",2,0],["فَإِنَّ فِي مِصْرَ إِخْوَاناً يَسُرُّهُمُ","قُرْبِي وَيُعْجِبُهُمْ نَظْمِي وَإِبْدَاعِي",52,"ي",1,0],["فَإِنْ فَعَلُواوَهَمُ فَاعِلُونَ","وَلِلْمَرْءِ فِي الدَّهْرِ مَا عُوِّدَا",53,"د",2,0],["فإنّ في القلب منها عقدَةً عقِدَت","وليسَ يفتحُها راقٍ إلى الأبدِ",54,"د",1,0],["فانفحيني تحيّة وتلقّي","ما من جوانح الحبّ مرسل",55,"ل",1,0],["فانفحيني تحيّةً وتَلَقَّيْ","نغماً من جوانح الحب مرسل",56,"ل",1,0],["فانفرجتْ عنْ وجههِ مسفراً","مُنْبَلِجاً مِثْلِ انْبِلاَجِ الشُّرُوقْ",57,"ق",1,0]]}