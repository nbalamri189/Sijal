79.html","البسيط"],[456,"أما وهواها عذرة وتنصلا","https://www.aldiwan.net/poem55919.html","الطويل"],[456,"حبست وأيام الملوك كذاكا","https://www.aldiwan.net/poem56082.html","الطويل"],[456,"حملت ركاب الغرب شمس شروق","https://www.aldiwan.net/poem56100.html","الكامل"],[456,"سل بالغوير السائق المغلسا","https://www.aldiwan.net/poem56152.html","الرجز"],[456,"طوى الليل راكب أخطاره","https://www.aldiwan.net/poem56164.html","المتقارب"],[459,"إذا مدحت معز الدين آونة","https://www.aldiwan.net/poem15133.html","البسيط"],[459,"إذا ما شكت بيض السيوف ظماءة","https://www.aldiwan.net/poem15172.html","الطويل"],[462,"تلقاك يا سعد بالنجح سعد","https://www.aldiwan.net/poem3152.html","عموديه"],[462,"في لأذني عن كل لاح صمم","https://www.aldiwan.net/poem3159.html","عموديه"],[462,"شجنك رسوم بالعقيق وأطلال","https://www.aldiwan.net/poem3543.html","عموديه"],[477,"على ضفة الوادي بقتة شاهق","https://www.aldiwan.net/poem37574.html","الطويل"],[498,"يا منشد الغيب أذكر من نيهم به","https://www.aldiwan.net/poem37632.html","البسيط"],[503,"حبيبي","https://www.aldiwan.net/poem56769.html","الطويل"],[505,"أبلغ لديك أبا خليد وائلاً","https://www.aldiwan.net/poem2135.html","الكامل"],[512,"هذا الحمى يا فتى فانزل بحومته","https://www.aldiwan.net/poem20832.html","البسيط"],[513,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"],[513,"رأيتك في المنام بعثت نحوي","https://www.aldiwan.net/poem12273.html","الوافر"],[549,"إن على رمل العقيق خيما","https://www.aldiwan.net/poem47229.html","الرجز"],[549,"هل الدار تدري ما أثارت من الوجد","https://www.aldiwan.net/poem47846.html","الطويل"],[549,"إذا سارت بنا خوص الركاب","https://www.aldiwan.net/poem48058.html","الوافر"],[556,"هلا غنيتم بما غنى به الوتر","https://www.aldiwan.net/poem34534.html","البسيط"],[556,"حرارة عشقه تعطي بروده","https://www.aldiwan.net/poem34565.html","الوافر"],[556,"هما إحاطتان بالأشياء","https://www.aldiwan.net/poem35075.html","الرجز"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["فَاِنفَح لَنا مِن راحَتَي","كَ بِلا القَليلِ وَلا النَزورِ",0,"ر",1,0],["فَأَنِفْتَ لِلدِّينِ الْحَنِيفِ وَأَهْلِهِ","مِنْ خُطَّةِ الْخَسْفِ الَّتِي قَدْ حُمِّلُوا",1,"ل",3,0],["فَاِنفُضوا النَومَ وَجِدّوا لِلعُلا","فَالعُلا وَقفٌ عَلى مَن لَم يَنَم",2,"م",1,0],["فَإِنَّ في العُقدَةِ مِن يَلبَنٍ","عُبرَ السُرى في القُلُصِ الضُمَّرِ",3,"ر",1,0],["فَأَنْفَعُ النَّاسِ هُمْ أَهْلُ السَّمَاحِ بِمَا","يُنْمِي نُفُوساً عَلَى الأَخْلاقِ وَالفِطَنِ",4,"ن",1,0],["فإن فيه رجالاً من بني مضر","إذا تحارب لا تستشفع الهُدَنا",5,"ن",2,0],["فإن فعلوا هذا فيا مرحباً بهم","وإلا فيا سُحق المعاند مِن سحق",6,"ق",1,0],["فإن فتى الدهر من يَدّعي","فتأتي أعاديه بالشاهد",7,"د",1,0],["فإن في البشر الراقي بخلقته","من قد أنِفت به أنّي من البشر",8,"ر",1,0],["فَانفَح لَنا بِسِجالِ فَضلٍ مِنكُمُ","وَاِسمَع ثَنائي في تَلاقي الأَركُبِ",9,"ب",1,0],["فَاِنفُخ بِكيرِكَ يا فَرَزدَقُ إِنَّني","في باذِخٍ لِمَحَلِّ بَيتِكَ عالي",10,"ي",1,0],["فَاِنفُخ بِكيرِكَ يا فَرَزدَقُ وَاِنتَظِر","في كَرنَباءَ هَدِيَّةَ القُفّالِ",10,"ل",1,0],["فَإِنَّ في حَربِهِم فَاِترُك عَداوَتُهُم","شَرّاً يُخاضُ عَلَيهِ الصابُ وَالسَلَعُ",11,"ع",1,0],["فإن فازَ مولانا بحجٍّ أتمه","فها نحن في نعمائه نتمتّع",12,"ع",1,0],["فأنفقت ما أحرزت بالبذل ذخره","وما ذخر مال المرء غير ابتذاله",13,"ل",2,0],["فَإِن فَنى فيكَ بَعضي","حُفِظتُ منكَ لَدَيكَ",14,"ك",1,0],["فإن فاته قَطْرٌ وثلج فإنه","رَهين بسافٍ تارةً أو بحاصبِ",15,"ب",1,0],["فإن في دِجْلة حِيتانَها","عديدُ ضعْفَيْ موجها المائجِ",16,"ج",1,0],["فإن فخرتْ بالجُود ألْسُنُ معْشرٍ","عَضَضْتُمْ على صُغْرٍ بِصُمّ الجلامدِ",17,"د",1,0],["فإنَّ في فيك حُشّاً","يفوح عند كلامِكْ",18,"ك",1,0],["فانفعْ أو امنعْ ولا تكن رجلاً","ميعادُهُ محنةٌ من المِحَنِ",19,"ن",1,0],["فَإِن فازَ سَهمٌ لِلمَنِيَّةِ لَم أَكُن","جَزوعاً وَهَل عَن ذاكَ مِن مُتَأَخِّرِ",20,"ر",1,0],["فانفخْ بها من لهيبِ","السَّماءِ رُوحاً خَضيبهْ",21,"ه",1,0],["فانْفُخِ النَّايَ إنَّهُ هِبَةُ","الأَملاكِ للمستعيذِ بالإِلهامِ",22,"م",1,0],["فإن فتشت عن بيت القصيد","قرأت الفتح والنصر المبينا",23,"ن",2,0],["فَإِن فَعَلتَ فَالقَوافي تَفعَلُ","ما هُوَ مِن فِعلِ الزُهورِ أَجمَلُ",24,"ل",1,0],["فانٍ فَفيهِ مِنَ الجَرحى مُشاكَلَةٌ","حَتّى إِذا قيلَ ماتوا اِخضَرَّ رَيحانا",25,"ن",2,0],["فَأَنفَدتَ مِن عَيشِهِنَّ البَقاءَ","وَأَبقَيتَ مِمّا مَلَكتَ النُفودا",26,"د",2,0],["فإنْ فرَّ لم يَعْدَمْ شِفاءً وإن ثَوى","فأمُّ الذي يبغي الثَّواءَ ثكُولُ",27,"ل",1,0],["فإنْ فاتَهُ واللّهُ بالغُ أمرِه","فأعمَى يُكَدِّي في المساجدِ أو يُقْرِي",28,"ر",2,0],["فأَنفِقْ فإِن العينَ يركُدُ ماؤُها","فيأسَنُ والمنزوحُ يعذُبُ ماؤهُ",29,"ا",3,0],["فَإِن فَعَلتَ وَإِلّا لَستُ أَطلُبُهُ","ما عِشتُ مِنكَ وَحَسبي بَذلُ مَجهودي",30,"ي",1,0],["فَأَنفَقَ في العَلياءِ حَتّى حَسِبتَهُ","مِنَ الدَهرِ يُعطى أَو مِنَ الدَهرِ يُنفِقُ",31,"ق",1,0],["فَإِن فَلَّتِ الأَيّامُ حَدَّ مُحَمَّدٍ","فَقَد جَرَّدَت سَيفاً بِهِ يُدرَكُ الوِترُ",32,"ر",1,0],["فَإِن فَلَّتِ الأَيّامُ في الحَربِ حَدَّهُ","فَما زالَتِ الأَيّامُ في أَهلِها تَجني",33,"ي",1,0],["فَانْفُضْ يَدَيْكَ مِنَ الدُّنْيَا فَلَسْتَ تَرَى","خِلاً وَفِيّاً وَعَهْدَاً غَيْرَ مُنْصَرِمِ",34,"م",1,0],["فَأَنفَذَت مِصرُ إِلَيهِ مالَها","فَأَصلَحَت حَصراً إِلَيهِ حالَها",35,"ه",2,0],["فَإِنَّ في ذاكَ عِندي","رَأياً مُضيئاً وَثيقا",36,"ق",2,0],["فَإِن فُرصَةٌ أَمكَنَت في العَدُو","وِ فَلا تَبدِ فِعلَكَ إِلّا بِها",37,"ب",3,0],["فإنْ فَوَّضَ السُّلْطانُ أَمْرَ بِلادِهِ","إليه فما خَلْقٌ بِهِ منه أَجْدَرُ",38,"ر",1,0],["فإنَّ فَضْلَ رسولِ الله ليسَ لهُ","حَدُّ فيُعْرِبَ عنه ناطِقٌ بِفَمِ",39,"م",1,0],["فأنفاسُهُنّ الحامياتُ صَواعقٌ","وأفواهُهُنّ الزافراتُ حَديد",40,"د",1,0],["فَاِنفِ الوِقارَ عَنِ المُجونِ بِقَهوَةٍ","حَمراءَ خالَطَ لَونَها إِقمارُ",41,"ر",1,0],["فَإِن فَطِنوا قُلنا نَصارى وَعيدُهُم","وَلَيسَ لِشُربِ الراحِ في العيدِ مِن باسِ",42,"س",1,0],["فَإِن فاتَني إِلفٌ ظَلَلتُ كَأَنَّما","يُديرُ حَياتي في يَدَيهِ مُديرُ",43,"ر",1,0],["فَإِنَّ فَتاتَكُمُ سَلَبَت فُؤادي","فَنِصفٌ عِندَها وَالنِصفُ عِندي",44,"ي",1,0],["فَاِنفَرِد ما اِستَطَعتَ فَالقائِلُ الصا","دِقُ يُضحي ثِقَلاً عَلى الجُلَساءِ",45,"س",3,0],["فَاِنفَع أَخاكَ عَلى ضُعفٍ تُحِسُّ بِهِ","إِنَّ النَسيمَ بِنَفعِ الروحِ هَبّابُ",46,"ب",1,0],["فَإِنَّ في الطَيرِ ذا ريشٍ بِهِ ضَرَعٌ","إِذا أَفاقَ أَطالَ النَطقَ وَالهَذَرا",47,"ر",2,0],["فَإِن فَعَلَ الفَتى خَيراً تَعالى","إلى قِنسِ المَلائِكِ خَيرِ قِنسِ",48,"س",1,0],["فَأَنفِق بِميزانٍ مَقالَكَ وَاِبتَعِث","يَدَيكَ بِما أوتيتَ وَزناً وَلا وَزنا",49,"ن",2,0],["فإِنَّ في المَجازِ والتَّأويلِ","ضَلَّتْ أساطيرُ ذَوي العُقُولِ",50,"ل",1,0],["فانْفُضْ يَدَيْكَ مِنَ الزَّمانِ وأَهْلِهِ","فالسَّعْيُ في طَلَبِ الصَّديِقِ هَبَاءُ",51,"ا",2,0],["فَإِنَّ فِي مِصْرَ إِخْوَاناً يَسُرُّهُمُ","قُرْبِي وَيُعْجِبُهُمْ نَظْمِي وَإِبْدَاعِي",52,"ي",1,0],["فَإِنْ فَعَلُواوَهَمُ فَاعِلُونَ","وَلِلْمَرْءِ فِي الدَّهْرِ مَا عُوِّدَا",53,"د",2,0],["فإنّ في القلب منها عقدَةً عقِدَت","وليسَ يفتحُها راقٍ إلى الأبدِ",54,"د",1,0],["فانفحيني تحيّة وتلقّي","ما من جوانح الحبّ مرسل",55,"ل",1,0],["فانفحيني تحيّةً وتَلَقَّيْ","نغماً من جوانح الحب مرسل",56,"ل",1,0],["فانفرجتْ عنْ وجههِ مسفراً","مُنْبَلِجاً مِثْلِ انْبِلاَجِ الشُّرُوقْ",57,"ق",1,0],["فَإِن فَسَد الزَمان فَغَير بدع","وَإِن هَلَكَ الجَميع فَلا عَجيب",58,"ب",1,0],["فإن فتى تقلبه الايادي","بعيد عن محافظة الوداد",59,"د",1,0],["فان فزت بالتقبيل والشرب منهما","ملكت مكانا دونه الشرق والغرب",60,"ب",1,0],["فانفض غبار الذل عنك","وعن قضيتك المبينة",61,"ن",2,0],["فإِنَّ في لَمسِكِ تَهويدَةً","تُغري شَياطينَ الأسى بالهُجوع",62,"ع",1,0],["فإن في النفس شيئا هو بالغُه","دون الورى لم تصل منهم إليه يد",63,"د",1,0],["فَإنَّ فتًى تَيَمُّمَهُ وتُملَى","عَلَيهِ وهوَ مُختَضِعٌ جِرَانَا",64,"ن",2,0],["فَانفُضُوا في الدُّعَا له بامتداد ال","عُمرِ في خدمة الكتابِ العِيَابا",65,"ب",2,0],["فَإِن فَخرت يَوماً فَإِنَّ مُحَمَّداً","هُوَ المُصطَفى من سِرّها وَكَريمُها",66,"م",3,0],["فَإِن فاخَرَت يَوماً فَأَنتَ جَلالُها","وَصَمصامُها في كُلِّ نائِبَةٍ تَعرو",67,"ر",2,0],["فَاِنفَرِد بِالعَلاءِ يا اِبنَ أَبي يَع","لى اِنفِرادَ السَماءِ بِالإِشرافِ",68,"ف",1,0],["فَإِنَّ فُؤادي مُدنَفٌ لَيسَ يَنقَهُ","بِنَفسي وَالمُشتاق يُبدي فُنونَهُ",69,"ه",1,0],["فانفر بخيلك واعتضد برجالها","يوم النزال فقومك الفرسان",70,"ن",1,0],["فانفِ الحَلاوةَ عن مجاجَةِ ريقِه