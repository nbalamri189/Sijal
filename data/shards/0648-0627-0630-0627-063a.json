ewPoem.aspx?id=177475",""],[5747,"موعد غيابك","https://www.poetsgate.com/ViewPoem.aspx?id=61668",""],[5838,"يا من بمقتله زها الدّهر","https://www.poetsgate.com/ViewPoem.aspx?id=200850",""],[5950,"دع الشعر ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128339",""],[6031,"يا خَلِيلَيَّ احْبِسَا الرَّكْبَ إذَا مَا","https://www.poetsgate.com/ViewPoem.aspx?id=46300",""],[199,"عَرَفَ الدِّيَارَ تَوَهُّماً فاعْتَادَهَا","https://www.poetsgate.com/ViewPoem.aspx?id=20775",""],[6125,"وإذا خلوتُ رأيتُ وجهكِ في السَّما","https://www.poetsgate.com/ViewPoem.aspx?id=210956",""],[6230,"مِنْ أجْلِهَا ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67163&r=&rc=37",""],[6251,"وجه الهلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76470&r=&rc=10",""],[6355,"تلد الأرض العجائب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66595&r=&rc=55",""]],"verses":[["وَإِذا غُبارُ الخَيلِ مَدَّ رُواقَهُ","سُكري بِهِ لا ما جَنى العُنقودُ",0,"د",1,0],["وَإِذا غَزَوتُ تَحومُ عِقبانُ الفَل","حَولي فَتَطعُمُ كَبدَ كُلِّ غَضَنفَرِ",1,"ر",1,0],["وَإِذا غَضِبتَ تَصَدَّعَت فَرَقاً","مِنكَ الجِبالُ وَخافَكَ الذُعرُ",2,"ر",1,0],["وَإِذا غَزالٌ أَحوَرُ ال","عَينَينِ يُعجِبُني لِعابُه",3,"ب",2,0],["وَإِذا غاضَت رَفَعنا زِقَّنا","طُلُقَ الأَوداجِ فيها فَاِنسَفَح",4,"ح",1,0],["وَإِذا غازَلَتهُ مُقلَةُ طَرفٍ","كادَ مِن رِقَّةٍ يَذوبُ فَيَجري",5,"ر",2,0],["وَإِذا غَمامُ السَعدِ أَصبَحَ صَوبُهُ","دَركَ المَطالِبِ فَليَصِل سُقياكا",6,"ك",2,0],["وَإِذا غُصونِ المُكرَماتِ تَهَدَّلَت","كانَ الثَناءَ هَديلُها المُتَرَنِّمُ",7,"م",1,0],["وإذا غزوت فإن سعدك ضامنٌ","ألاَّ تخيبَ وأنّ قصدك يكملُ",8,"ل",1,0],["وَإِذا غَدَوتِ فَباكَرَتكِ تَحِيَّةٌ","سَبَقَت سُروحَ الشاحِجاتِ الحُجَّلِ",9,"ل",1,0],["وَإِذا غَضِبتُ رَمى وَرائِيَ بِالحَصى","أَبناءُ جَندَلَتي كَخَيرِ الجَندَلِ",9,"ل",1,0],["وإذا غدا حسَّاده وعُداته","ظُلِم العُداة وأنُصف الحسادُ",10,"د",1,0],["وإذا غدوتُ وجمعُهم حَشدي","لم تُستَطعْ خَيْلي ولا رَجلي",11,"ل",2,0],["وإذا غدونَ يمِسْن في","تلك الغلائِل والمراسلْ",12,"ل",1,0],["وَإِذا غالَني الحَما","م وَأَصبَحتُ في غَدِ",13,"د",1,0],["وَإِذا غابَتِ النُجومُ اِهتَدَينا","بِالرُأى بِالرَجاءِ بِالإيمانِ",14,"ن",1,0],["وَإِذا غَنّى تَموجُ ال","أَرضُ مِنهُ وَتَمورُ",15,"ر",1,0],["وَإِذا غَضِبتَ فَإِنَّما هِيَ غَضبَةٌ","في الحَقِّ لا ضِغنٌ وَلا بَغضاءُ",16,"ا",2,0],["وَإِذا غَنوا بِعَطائِهِ عَن هَزِّهِ","والى فَأَغنى أَن يَقولوا والِهِ",17,"ل",2,0],["وَإِذا غابَ وَجهُهُ عَن مَكانٍ","فَبِهِ مِن ثَناهُ وَجهٌ جَميلُ",18,"ل",1,0],["وَإِذا غِبتَ عَنهُم أَبرَحَ الوَج","دُ وَأَربى ضَرامُهُ المَشبوبُ",19,"ب",1,0],["وَإِذا غُيومُكَ أَبرَقَت لَم تَكتَرِث","لِلخَطبِ ذي الإِرعادِ وَالإِبراقِ",20,"ق",1,0],["وَإِذا غَزا أَرضَ العَدوِّ فَوَحشُها","مِن وَفدِهِ وَنُسورُها مِن ضَيفِهِ",21,"ف",2,0],["وَإِذا غَدا المَعروفُ مَجهولاً غَدا","مَعروفُ كَفِّكَ عِندَهُ مَعروفا",22,"ف",2,0],["وَإِذا غَشيتَ دِيارَ لَيلى بِاللِوى","فَاِسأَل رِياحَ الطيبِ عَنها تُخبَرِ",23,"ر",1,0],["وَإِذا غَدَت شُفَعاءُ جودٍ مُبطِئٍ","قَد كَدَّ صاحِبَ حاجَةٍ مَمنوعا",24,"ع",2,0],["وَإِذا غَدَوتَ ذَكَرتَهُ","وَبَدا لِعَينِكَ في المَجاسِد",25,"د",1,0],["وَإِذا غَلا البُرُّ النَقِيُّ فَشارِكِ ال","فَرَسَ الكَريمَ وَساوِ طِرفَكَ تَمجُدِ",26,"د",1,0],["وَإِذا غَلَبتَ مُناضِلاً عَن دينِهِ","أَلقى مَقالِدَهُ إِلى الأَخبارِ",27,"ر",1,0],["وَإِذا غَدَوتَ عَلى القَضاءِ مُغالِباً","فَأَذاكَ تَستَمري وَأَنفُكَ تَرغَمُ",28,"م",1,0],["وإذا غرَّدَ طيرٌ","كانَ في الشَّدوِ صَدَاهْ",29,"ا",2,0],["وَإِذا غَزَوتُ تَحومُ عِقبانُ الفَلا","حَولي فَتَطعُمُ كَبدَ كُلِّ غَضَنفَرِ",30,"ر",1,0],["وَإِذَا غَنِيتَ بِهِ تَفَكَّهَ بِالْعُلاَ","وَإِذَا افْتَقَرْتَ بِهِ اكْتَفَى بِقَفَارِ",31,"ر",1,0],["وَإِذَا غَايَةُ مَا فِي","وُسْعِهِ أَنْ أَنْشَدَا",32,"د",2,0],["وإذا غز الأعدا فأَكل سُيوفهِ","تلك اللحومِ ومن دِماها الموردُ",33,"د",1,0],["وَإِذا غَدا يَوماً بِنَفخَةِ نائِلٍ","عَرَضَت لَهُ الغَدَ مِثلُها فَأَعادَها",34,"د",3,0],["وإذا غضبنَ جعلنَ أسبابَ التَّوا","صلِ إصبعاً أو معصماً أو جيدا",35,"د",2,0],["واذا غريب الدار حل بها غدا","من اهلها في رفعة وتأهلا",36,"ل",2,0],["وَإِذا غَضبتُ تشاوَروا","فيما يُعيدُ ليَ السَلاما",37,"م",2,0],["وإذا غنّت القِيانُ فإنّي","سِتْرُ ألحاظها على النُّدَماء",38,"ا",2,0],["وإذا غزا قادَ الجحافلَ ظافراً","والرومُ حليةُ جيشِها الأصفاد",39,"د",1,0],["وَإِذا غصبناهُ فَلا مُستنبتٌ","فيما نظنُّ لَنا إِليه مرجعُ",40,"ع",1,0],["وَإِذا غَلا شَيءٌ عَلَيَّ تَرَكتُهُ","فَيَكونُ أَرخَصَ ما يَكونُ إِذا غَلا",41,"ل",2,0],["واذا غنيت شيئاً","فادني مني واسمعيني",42,"ي",1,0],["وَإِذا غَدَوتُ مُصَلِّياً أَستَقبِلُ ال","بَيتَ الحَرامَ مُسَبحِلاً وَمُصَلِّبا",43,"ب",2,0],["وإذا غنِيتَ فلا تكُنْ بَطِراً","فوراءَ أيَّامِ الغِنى فَقْرُ",44,"ر",1,1],["وَإِذا غدوا في مَجلسٍ","لمطاع أَمر أَو أَمير",45,"ر",1,0],["وإذا غنِيتَ ولم تصل رحماً ولا","جاراً فلا سلمتْ من البَرّاض",46,"ض",1,0],["وإذا غدت لك شافعاً في حاجة","أغنتك نخوته عن استقضائها",47,"ا",3,0],["وَإِذا غايَةُ الفتى كانتِ المو","تَ فماذا التَعميمُ والتّمليحُ",48,"ح",1,0],["وإذا غابَتِ الصحائفُ عنهُ","حَضَرَتْهُ صَفائحٌ تقتفيهِ",49,"ي",2,0],["وإذا غردن سمعت صوت بلابل","يحلو به الترنيم والتغريد",50,"د",1,0],["وإذا غصَّ شاربُ الماءِ بالما","ءِ فأحرى بغيرِهِ أَنْ يَغَصَّا",51,"ص",2,0],["وَإِذا غَلَوت بِمدحِهِ لم أَبتَدِعْ","بَل لَستُ بِالغالي وَلا بِالمَغرِبِ",52,"ب",1,0],["وإذا غر في التصور صفو ال","عيش فاسعف طلابه بطبيب",53,"ب",1,0],["وإذا غدوتُ غدوتُ في هَمٍّ وإن","أمسيتَ صرتُ مع النجوم مسهَّدا",54,"د",2,0],["وَإِذا غازلتُ غازلتُ رَشاً","وإِذا عانَقتُهُ عانَقتُ غُصنا",55,"ن",2,0],["وإذا غشا الهيجاء فوق مضمّرٍ","وانقضّ تشهد في سراهُ البيدُ",56,"د",1,0],["وإذا غيرُه أبى المجدَ كسلا","ناً أتاهُ جذلانَ وهْو نشيطُ",57,"ط",1,0],["وإذا غَدا يوُلي الجَدى","يوم النّدى كالبحر زاخِرْ",58,"ر",1,0],["وإذا غرّدَ الحَمَامُ ضَحاءً","خَفَقَ القلبُ كاختِفاقِ الجناحِ",59,"ح",1,0],["وإذا غنيت بمدحه عن كل ما","في الكائنات بفضله يغنيني",60,"ن",2,0],["وإذا غايةٌ من المجدِ عنَّت","لم يعقهُ عن نيلها العيُّوق",61,"ق",1,0],["وإذا غزوا دار العِدى","أَلفيتَ رسم الدارِ دائر",62,"ر",1,0],["وإذا غلطت من البنان بواحدٍ","صح البيان وأقبل التبشير",63,"ر",1,0],["وإذا غضبت فلم يكن غضبي سوى","ثورات هذا الحب حال نموّه",64,"و",2,0],["وَإِذا غَضِبتَ فَلَم تُكَلِّمني","ضاقَت عَلَيَّ الأَرضُ وَالأُفقُ",65,"ق",1,0],["واذا غدرت فانفض من كان حولها","وفينا فلم نغدر ولم نخلف الوعدا",66,"د",2,0],["وإذا غازلتْ مُحبّاً بلحظٍ","فضحتْ موقَ مُقْلَةِ الغزْلانِ",67,"ن",1,0],["واذا غاب فالسماءُ تجَّلى","بالدراري كالروض في نيسانِ",68,"ن",1,0],["وإذا غاظكَ خطب فاصطبر","واكظم الغيظ ولا تبدي الضجر",69,"ر",1,0],["وإذا غفِلْتَ فإنّه لك مُوتِرٌ","قَوْساً متى تَدْعُ الفناءَ أجابا",70,"ب",2,0],["وإذا غَنَّت السيوف وطافت","أكؤوس الموت وانتشى كل صاح",71,"ح",1,0],["وإِذا غَضِبنا غَضبةً يَمنّيةً","قَطَرت صوارمُنا بموْتٍ أَحمرِ",72,"ر",1,0],["وإذا غزا فمَن الطُفيل وعامرٌ","وإذا أحتبى فمن العزيز ويُوسفُ",73,"ف",1,0],["وَإِذا غَنيت فاذكر عَهدَنا","بِاللوى ما بَين سَعدي وَالرباب",74,"ب",1,0],["وَإِذا غَنيت فَلتذكر لَنا","عَهد لَهو بَين آرام الرصافة",75,"ف",2,0],["واذا غداً في مصر بات محجباً","عنا فوابل جوده لا يحجب",76,"ب",1,0],["وإذا غدا المرء بين اثنين منقسما","هما محلان ما للمرء غيرهما",77,"م",2,0],["وإذا غاب عن مدارك يا لب","نان نجم تلاه نجم ثان",78,"ن",1,0],["وإذا غيرة تشب بقلبي","وبجمع العشاق قد عيل صبري",79,"ر",2,0],["واذا غدوت الى العروبة انتمى","فعروبتي مجد يروع وشانُ",80,"ن",1,0],["وإذا غطت بلا عمه","واستحر الزأر عن دمنه",81,"ن",2,0],["وَإِذ أَغارَ شُمَيطٌ نَحوَ نِسوَتِنا","غِرنا عَلَيهنَّ إِنّا مَعشَرٌ غُيُرُ",82,"ر",1,0],["واذا غبتَ فالخصيبُ من الار","ضِ حديثٌ والرحب منها مَضيقُ",83,"ق",1,0],["واذا غَدَتْ أَفواجها عُصَباً","فانهضْ اِليها نهضةَ الصَّقْرِ",84,"ر",1,0],["واذا غِبْنَ عن سَقَامِكَ والبُرْ","ءِ فمن للدلالِ والتَّعليلِ",85,"ل",1,0],["وإذا غدا قسم الشفاه محرماً","فاسمح وخل الحزن غير محرم",86,"م",1,0],["وَإِذا غَلَبتَ الخَصمَ لا تَهزأ بِهِ","فالعُجبُ يُخمِدُ جَمرَةَ الإِحسانِ",87,"ن",1,0],["وَإِذا غدرتم فاعذروني في الَّذي","يُجريه دَمعي أَو يَصونُ وَفائي",88,"ا",2,0],["وَإِذا غَنَّت لَهُ عَنَّت لَهُ","ذِكرَةٌ لِلشامِ زادَتهُ نُزوعا",89,"ع",2,0],["وإذا غاصت الحبيبة في الأر","ض جرى خلفها المحب عجولا",90,"ل",2,0],["وإذا غضبت نفخت في قصب القنا","فأحلتها في الحال جمرا مسعرا",91,"ر",2,0],["وإذا غاضت ينابيع الندى","أخذت تمتاح من أنمله",92,"ه",1,0],["واذا غدت راياته منشورة","فالخافقان لهن في خفقان",93,"ن",1,0],["وإذا غدوت بغيرها متغزلا","فهي المسمى والسوى أسماء",94,"ا",2,0],["واذا غمرت بنعمة وبلذة","لا تنسينك حوادثا ستكون",95,"ن",1,0],["واذا غَفَتْ بعضُ الجراح بليلتي","بين الحشاشةِ تستفيقُ جراحُ",96,"ح",1,0],["واذا غفيتي امانة حيل غطيني","برموشك اللي من الأشواق رويانه",97,"ن",2,0],["وإذا غضِبتَ ، وقلتَ كُلَّ قبيحةٍ","فينا ، فخيرُ العُذر أنك صائِمُ",98,"م",1,0],["وإذا غضبْنَا زلزلتْ آسَادُنا","مِنْ تحْتِ جُندِ الغاصبين الدَّارا",99,"ر",2,0],["وإذا غشيت بهول غاشية فعذ","بالله منه تنج من غشيانه",100,"ن",2,0],["وإذا غابَ هلالٌ فاصطبرْ","إنما البدرُ إذا غابَ طلعْ",101,"ع",1,0],["وإذا غفوتُ لكي أراكمْ مرةً","تأبى اللقاءَ إذا وددتُ عيونُ",102,"ن",1,0],["وإذا غدا الحبّ النقيّ مُعلّباً","فعلاجه بعد الوداع...طلاق",103,"ق",1,0],["وإذا غفرتُ فكلّ شئ ممكنٌ","إلا الرجوعُ إليكِ فهْوَ مُحالُ",104,"ل",1,0],["وإذا غدا الأسدُ المُدلّ معبّساً","عن غابِ أشبُلِه توارى السّيدُ",105,"د",1,0],["واذا غضبْت زأرْتٓ ليثاً غاضباً","خلع القلوبٓ وتدّريه الاضلعُ",106,"ع",1,0],["واذا غبتي عن عيوني بعيش العمر في ذكراك","اعيش بحسرتي وآموت إذا ماشافتك عيني",107,"ن",2,0],["وإذا غضبت تصدّعت فرقا","منك الجبال وهابك الوعر",108,"ر",1,0],["وإذا غرّك وصول التافهين وذكرهم لا شاع","فصدّق لو عرفت شلون وصلوا تشكر أقدامي",109,"م",2,0],["وإذَا غَنَّتْ حَمَاماتُ الحِمَى","حَمَتِ النَّومَ وأَهْدتْهُ الحِمَامَا",110,"م",2,0],["وَإذَا غَدَا يَوماً بِنَفْحَة ِ نَائِلٍ","عرضتْ لهُ الغدَ مثلها فأعادها",111,"د",3,0],["وإذا غفوتُ تمثَّلتْ في غفوتي","حورًا يزلزلُ لحظُها أرجائي",112,"ي",1,0],["وإذا غَضَضْتُ الطَّرْفَ يَحْمِلُنِي","بَحْرُ الخَيَالِ ويَبْدَأُ المَدُّ",113,"د",1,0],["وإِذا غَامَتِ السَّمَاءُ تَخَيَّلْتُكَ","فِي غَيْمَةٍ تُغَطِّي تِلالي",114,"ل",2,0],["وإذا غابَتِ الفضيلةُ عَنَّا","تلِدُ الأرضُ للحياةِ العجائب",115,"ب",1,0]]}