{"poems":[[3,"فخر الرجال سلاسل وقيود","https://www.aldiwan.net/poem149.html",""],[3,"يا عبل خلي عنك قول المفتري","https://www.aldiwan.net/poem164.html",""],[42,"يا من بمقتله دهى الدهر","https://www.aldiwan.net/poem50234.html","أحذ الكامل"],[9,"أصرمت حبلك من لمي","https://www.aldiwan.net/poem21911.html","مجزوء الكامل"],[9,"ما تعيف اليوم في الطير الروح","https://www.aldiwan.net/poem21921.html","الرمل"],[73,"عذري إن عذلت في خلع عذري","https://www.aldiwan.net/poem11944.html","الخفيف"],[73,"اخطب فملكك يفقد الإملاكا","https://www.aldiwan.net/poem11973.html","الكامل"],[73,"الدهر إن أملى فصيح أعجم","https://www.aldiwan.net/poem11979.html","الكامل"],[83,"بشرى كما وضح الزمان وأجمل","https://www.aldiwan.net/poem54256.html","الكامل"],[27,"لمن الديار كأنها لم تحلل","https://www.aldiwan.net/poem5967.html","الكامل"],[51,"أنى تماطلني وأنت جواد","https://www.aldiwan.net/poem61868.html","الكامل"],[51,"قومي بنو العباس حلمهم","https://www.aldiwan.net/poem65919.html","أحذ الكامل"],[51,"حي المعاهد والمنازل","https://www.aldiwan.net/poem65977.html","مجزوء الكامل"],[91,"أنت والكأس في يدي فلمن أنت في غد","https://www.aldiwan.net/poem8801.html","عموديه"],[91,"ما لقلبي يلج من الخفقان","https://www.aldiwan.net/poem62761.html","عموديه"],[70,"يومنا يوم مطير","https://www.aldiwan.net/poem42877.html","مجزوء الرمل"],[85,"ولد الهدى فالكائنات ضياء","https://www.aldiwan.net/poem20977.html","الكامل"],[43,"لا الحلم جاد به ولا بمثاله","https://www.aldiwan.net/poem9931.html","الكامل"],[43,"مالنا كلنا جو يا رسول","https://www.aldiwan.net/poem9980.html","الخفيف"],[45,"لا أرى بالعقيق رسما يجيب","https://www.aldiwan.net/poem62639.html","الخفيف"],[45,"يا بن المدبر يا أبا إسحاق","https://www.aldiwan.net/poem65205.html","الكامل"],[66,"لاقيتنا ملقى الكريم لضيفه","https://www.aldiwan.net/poem41368.html","الكامل"],[44,"أطلالهم سلبت دماها الهيفا","https://www.aldiwan.net/poem30403.html","الكامل"],[74,"حدر القناع عن الصباح المسفر","https://www.aldiwan.net/poem12956.html","الكامل"],[52,"الدار أعرفها ربى وربوعا","https://www.aldiwan.net/poem26866.html","الكامل"],[50,"وردت همومك يوم صاعد","https://www.aldiwan.net/poem63918.html","مجزوء الكامل"],[46,"إركع لربك في نهارك واسجد","https://www.aldiwan.net/poem22482.html","الكامل"],[46,"المرء يأبر خسة في طبعه","https://www.aldiwan.net/poem22716.html","الكامل"],[46,"لفعالك المذموم ريح حوابس","https://www.aldiwan.net/poem23322.html","الكامل"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/66077","الرمل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9932","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54778","الرمل"],[160,"قالت سليمى ابشر فموعدنا الغد","https://www.aldiwan.net/poem58811.html","الكامل"],[195,"عرف الديار توهما فاعتادها","https://www.aldiwan.net/poem54421.html","الكامل"],[199,"رأت الملاح على السماء كواكبا","https://www.aldiwan.net/poem45379.html","الكامل"],[210,"نقل الغرام حديث دمعي مرسلا","https://www.aldiwan.net/poem13420.html","الكامل"],[223,"في ذمة الماضي انطوت","https://www.aldiwan.net/poem41918.html","مجزوء الكامل"],[229,"أنا من رقة الهوى والهواء","https://www.aldiwan.net/poem51268.html","الخفيف"],[270,"عودي الى ماضيك يا بغداد","https://www.aldiwan.net/poem35650.html","الكامل"],[305,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[338,"إني رأيت الصبر خير معول","https://www.aldiwan.net/poem68712.html","الكامل"],[342,"يا عروسا في ثياب الرقص","https://www.aldiwan.net/poem55341.html","مجزوء الرمل"],[349,"أصبحت من عنقاء مغرب أعجبا","https://www.aldiwan.net/poem15532.html","الكامل"],[405,"وإذا غنيت فلا تكن بطرا","https://www.aldiwan.net/poem49586.html","أحذ الكامل"],[406,"شهر غدا مشتهرا","https://www.aldiwan.net/poem50163.html","مجزوء الكامل"],[495,"راض كلا أو ساخط كالراضي","https://www.aldiwan.net/poem10225.html","الكامل"],[515,"هي سلوة حلت عقود وفائها","https://www.aldiwan.net/poem11999.html","الكامل"],[551,"يا ابن عبد العزيز إن فؤادي","https://www.aldiwan.net/poem47900.html","الخفيف"],[562,"لا تلوميه في الهوى واعذريه","https://www.aldiwan.net/poem52968.html","الخفيف"]],"verses":[["وَإِذا غُبارُ الخَيلِ مَدَّ رُواقَهُ","سُكري بِهِ لا ما جَنى العُنقودُ",0,"د",1,0],["وَإِذا غَزَوتُ تَحومُ عِقبانُ الفَل","حَولي فَتَطعُمُ كَبدَ كُلِّ غَضَنفَرِ",1,"ر",1,0],["وَإِذا غَضِبتَ تَصَدَّعَت فَرَقاً","مِنكَ الجِبالُ وَخافَكَ الذُعرُ",2,"ر",1,0],["وَإِذا غَزالٌ أَحوَرُ ال","عَينَينِ يُعجِبُني لِعابُه",3,"ب",2,0],["وَإِذا غاضَت رَفَعنا زِقَّنا","طُلُقَ الأَوداجِ فيها فَاِنسَفَح",4,"ح",1,0],["وَإِذا غازَلَتهُ مُقلَةُ طَرفٍ","كادَ مِن رِقَّةٍ يَذوبُ فَيَجري",5,"ر",2,0],["وَإِذا غَمامُ السَعدِ أَصبَحَ صَوبُهُ","دَركَ المَطالِبِ فَليَصِل سُقياكا",6,"ك",2,0],["وَإِذا غُصونِ المُكرَماتِ تَهَدَّلَت","كانَ الثَناءَ هَديلُها المُتَرَنِّمُ",7,"م",1,0],["وإذا غزوت فإن سعدك ضامنٌ","ألاَّ تخيبَ وأنّ قصدك يكملُ",8,"ل",1,0],["وَإِذا غَدَوتِ فَباكَرَتكِ تَحِيَّةٌ","سَبَقَت سُروحَ الشاحِجاتِ الحُجَّلِ",9,"ل",1,0],["وَإِذا غَضِبتُ رَمى وَرائِيَ بِالحَصى","أَبناءُ جَندَلَتي كَخَيرِ الجَندَلِ",9,"ل",1,0],["وإذا غدا حسَّاده وعُداته","ظُلِم العُداة وأنُصف الحسادُ",10,"د",1,0],["وإذا غدوتُ وجمعُهم حَشدي","لم تُستَطعْ خَيْلي ولا رَجلي",11,"ل",2,0],["وإذا غدونَ يمِسْن في","تلك الغلائِل والمراسلْ",12,"ل",1,0],["وَإِذا غالَني الحَما","م وَأَصبَحتُ في غَدِ",13,"د",1,0],["وَإِذا غابَتِ النُجومُ اِهتَدَينا","بِالرُأى بِالرَجاءِ بِالإيمانِ",14,"ن",1,0],["وَإِذا غَنّى تَموجُ ال","أَرضُ مِنهُ وَتَمورُ",15,"ر",1,0],["وَإِذا غَضِبتَ فَإِنَّما هِيَ غَضبَةٌ","في الحَقِّ لا ضِغنٌ وَلا بَغضاءُ",16,"ا",2,0],["وَإِذا غَنوا بِعَطائِهِ عَن هَزِّهِ","والى فَأَغنى أَن يَقولوا والِهِ",17,"ل",2,0],["وَإِذا غابَ وَجهُهُ عَن مَكانٍ","فَبِهِ مِن ثَناهُ وَجهٌ جَميلُ",18,"ل",1,0],["وَإِذا غِبتَ عَنهُم أَبرَحَ الوَج","دُ وَأَربى ضَرامُهُ المَشبوبُ",19,"ب",1,0],["وَإِذا غُيومُكَ أَبرَقَت لَم تَكتَرِث","لِلخَطبِ ذي الإِرعادِ وَالإِبراقِ",20,"ق",1,0],["وَإِذا غَزا أَرضَ العَدوِّ فَوَحشُها","مِن وَفدِهِ وَنُسورُها مِن ضَيفِهِ",21,"ف",2,0],["وَإِذا غَدا المَعروفُ مَجهولاً غَدا","مَعروفُ كَفِّكَ عِندَهُ مَعروفا",22,"ف",2,0],["وَإِذا غَشيتَ دِيارَ لَيلى بِاللِوى","فَاِسأَل رِياحَ الطيبِ عَنها تُخبَرِ",23,"ر",1,0],["وَإِذا غَدَت شُفَعاءُ جودٍ مُبطِئٍ","قَد كَدَّ صاحِبَ حاجَةٍ مَمنوعا",24,"ع",2,0],["وَإِذا غَدَوتَ ذَكَرتَهُ","وَبَدا لِعَينِكَ في المَجاسِد",25,"د",1,0],["وَإِذا غَلا البُرُّ النَقِيُّ فَشارِكِ ال","فَرَسَ الكَريمَ وَساوِ طِرفَكَ تَمجُدِ",26,"د",1,0],["وَإِذا غَلَبتَ مُناضِلاً عَن دينِهِ","أَلقى مَقالِدَهُ إِلى الأَخبارِ",27,"ر",1,0],["وَإِذا غَدَوتَ عَلى القَضاءِ مُغالِباً","فَأَذاكَ تَستَمري وَأَنفُكَ تَرغَمُ",28,"م",1,0],["وإذا غرَّدَ طيرٌ","كانَ في الشَّدوِ صَدَاهْ",29,"ا",2,0],["وَإِذا غَزَوتُ تَحومُ عِقبانُ الفَلا","حَولي فَتَطعُمُ كَبدَ كُلِّ غَضَنفَرِ",30,"ر",1,0],["وَإِذَا غَنِيتَ بِهِ تَفَكَّهَ بِالْعُلاَ","وَإِذَا افْتَقَرْتَ بِهِ اكْتَفَى بِقَفَارِ",31,"ر",1,0],["وَإِذَا غَايَةُ مَا فِي","وُسْعِهِ أَنْ أَنْشَدَا",32,"د",2,0],["وإذا غز الأعدا فأَكل سُيوفهِ","تلك اللحومِ ومن دِماها الموردُ",33,"د",1,0],["وَإِذا غَدا يَوماً بِنَفخَةِ نائِلٍ","عَرَضَت لَهُ الغَدَ مِثلُها فَأَعادَها",34,"د",3,0],["وإذا غضبنَ جعلنَ أسبابَ التَّوا","صلِ إصبعاً أو معصماً أو جيدا",35,"د",2,0],["واذا غريب الدار حل بها غدا","من اهلها في رفعة وتأهلا",36,"ل",2,0],["وَإِذا غَضبتُ تشاوَروا","فيما يُعيدُ ليَ السَلاما",37,"م",2,0],["وإذا غنّت القِيانُ فإنّي","سِتْرُ ألحاظها على النُّدَماء",38,"ا",2,0],["وإذا غزا قادَ الجحافلَ ظافراً","والرومُ حليةُ جيشِها الأصفاد",39,"د",1,0],["وَإِذا غصبناهُ فَلا مُستنبتٌ","فيما نظنُّ لَنا إِليه مرجعُ",40,"ع",1,0],["وَإِذا غَلا شَيءٌ عَلَيَّ تَرَكتُهُ","فَيَكونُ أَرخَصَ ما يَكونُ إِذا غَلا",41,"ل",2,0],["واذا غنيت شيئاً","فادني مني واسمعيني",42,"ي",1,0],["وَإِذا غَدَوتُ مُصَلِّياً أَستَقبِلُ ال","بَيتَ الحَرامَ مُسَبحِلاً وَمُصَلِّبا",43,"ب",2,0],["وإذا غنِيتَ فلا تكُنْ بَطِراً","فوراءَ أيَّامِ الغِنى فَقْرُ",44,"ر",1,1],["وَإِذا غدوا في مَجلسٍ","لمطاع أَمر أَو أَمير",45,"ر",1,0],["وإذا غنِيتَ ولم تصل رحماً ولا","جاراً فلا سلمتْ من البَرّاض",46,"ض",1,0],["وإذا غدت لك شافعاً في حاجة","أغنتك نخوته عن استقضائها",47,"ا",3,0],["وَإِذا غايَةُ الفتى كانتِ المو","تَ فماذا التَعميمُ والتّمليحُ",48,"ح",1,0],["وإذا غابَتِ الصحائفُ عنهُ","حَضَرَتْهُ صَفائحٌ تقتفيهِ",49,"ي",2,0]]}