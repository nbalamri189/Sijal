{"poems":[[53,"المرء يعجز لا المحالة تعجز","https://www.aldiwan.net/poem64541.html","الكامل"],[201,"نوحي بعقر السجن نوحي","https://www.aldiwan.net/poem39896.html","مجزوء الكامل"],[202,"ومهفهف غنج تقسمت الظبا","https://www.aldiwan.net/poem51866.html","الكامل"],[435,"يا من له روض الفؤاد مكان","https://www.aldiwan.net/poem41036.html","الكامل"],[469,"ألمت سليمى والنسيم عليل","https://www.aldiwan.net/poem3634.html","عموديه"],[519,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"],[563,"حق عيني رؤية الوجه المليح","https://www.aldiwan.net/poem34666.html","الرمل"],[569,"أمن هجر من تهواه قلبك واجد","https://www.aldiwan.net/poem838.html",""],[580,"الجن قد طرقت بأعينها","https://www.aldiwan.net/poem2703.html","أحذ الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119904","المجتث"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64830","الكامل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113982","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77957","الوافر"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118306","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202515","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110050","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91534","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117878","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131234",""],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54501","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52195","المتقارب"],[4680,"حتى يذهب الزبدُ","https://www.poetsgate.com/ViewPoem.aspx?id=185028",""],[4680,"منابت العز","https://www.poetsgate.com/ViewPoem.aspx?id=185030",""],[4852,"رضاب العشق","https://www.poetsgate.com/ViewPoem.aspx?id=214270",""],[4888,"دعوني أحلق","https://www.poetsgate.com/ViewPoem.aspx?id=207763",""],[5174,"لغة الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=199065",""],[5338,"« يا رسول الله خذ بيدي »","https://www.poetsgate.com/ViewPoem.aspx?id=187760",""],[5376,"همسات القلب أقاطعها","https://www.poetsgate.com/ViewPoem.aspx?id=202162",""],[5493,"نساء الأمازيغ","https://www.poetsgate.com/ViewPoem.aspx?id=197013",""],[5691,"تحجر العُرْبُ","https://www.poetsgate.com/ViewPoem.aspx?id=206096",""],[5956,"إخلاص حبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=182457",""]],"verses":[["فلْيوجزِ الشعراءُ فيك لعلّهم","إن قَصَّروا قال المشبِّه أوجِزوا",0,"ز",3,0],["فليوصدوا سحقا لهم","بيني وبينك ألف باب",1,"ب",1,0],["فليومه زرق المهند تنتضي","ولمقلتيه حَدُّهُ ومضاؤهُ",2,"ه",1,0],["فليوهبنكما العلوم وحفظها","وليفتحن عليكما المنان",3,"ن",1,0],["فلي وله حزنٌ وحسنٌ ممنّع","ومنه ومنّي قاتل وقتيل",4,"ل",1,0],["فلي وَعْظٌ أشدُّ من الرّواسي","ولي غزَلٌ أرقُّ من الشَّمالِ",5,"ل",1,0],["فليؤد كل ذي حق هنا","حقه الوارد في النصح الصريح",6,"ح",1,0],["فلي وله جسمان أضناهما الجوى","لفرط النوى فالحكم في الحب واحد",7,"د",1,0],["فليؤمِن العُشَّاق بي فَلَقَدْ","كُشِفَ الغِطَاءُ وكُشِفَ اللبس",8,"س",1,0],["فلي وفاء أمين ال","دين الكريم النجارِ",9,"ر",1,0],["فلِيُوسُفٍ أَصْلٌ منابتُهُ","تَجْني الفخارَ ونَورُهُ يُعشي",10,"ش",2,0],["فلَيومُ أحمدَ أيُّ يومٍ أيوَمٍ","ولليلُ أحمدَ أيُّ ليلٍ لائلِ",11,"ل",1,0],["فَلي وَجهان مَكنون وَبادٍ","وَلي علمان جزئي وَكُلي",12,"ل",2,0],["فليومن الحسود او يكذب","ما طرق الحق كطرق الكذب",13,"ب",1,0],["فلي واقعٌ قزمٌ يسوء نواظراً","وقولي عملاقٌ يروع المسامعا",14,"ع",2,0],["فليُؤَاخِ الحِجَى بأَعمال بِر","رُبَّ عِلمٍ تَزينُهُ الأَعمالُ",15,"ل",1,0],["فَلي وَجدٌ عَلَيها أَيّ وَجدٍ","أَكاد بذكره أستبكي الغَماما",16,"م",2,0],["فلي ولهم ولي معهم إخاءٌ","وكاس هوى شربناها ضريبا",17,"ب",2,0],["فليولك الرحمن خير مثوبةٍ","وليسق رمسك وابل الرحمات",18,"ت",1,0],["فلي ولها وللأنضاءِ شجو","حنين في حنين في حنينِ",19,"ن",1,0],["فلي والدٌ أعجزته الليالي","وأمٌّ ستقضي أسىً بعدما",20,"م",2,0],["فليوقدوا ما ادلهمّت كلَّ ضاريةٍ","تُحيي الّذين على مأساتهم رَقدوا",21,"د",3,0],["فليوغلوا في دجاها حيثما رغبوا","لنا البطولة والتاريخ ملعبنا",22,"ن",2,0],["فلِي وَحدِي تَجَلّى مِلءَ رُوحٍ ..","مَلاكٌ يَستحِيلُ الوَصفَ نُطْقَا",23,"ق",2,0],["فلي وِجهتي ولكم وِجهةٌ","ولي الأفقُ يَجذبُ حبلي المُوَثَّقْ",24,"ق",1,0],["فَلْيُؤَذِّنْ: لَنْ تَرَى الدُّنْيَا سَنًا","أَوْ جَمَالاً مِثْلَ إِحْسَانِ الْبَيَانِ",25,"ن",1,0],["فَلْيُوَالِ مَنْ عَلاَ شَرَفَاً","يَوْمَ خُمٍّ مَجْدُهُ الأَبَدِي",26,"د",2,0],["فليوسف عادت قصته","ما بين الأهل فضائعها",27,"ع",3,0],["فَلَيوقَفُنَّ ويُسْأَلُنَّ عنِ الخَنا","لمَّا سرى بالقلبِ إذْ أَدْمانَا",28,"ن",2,0],["فلْيوقِفوا أوَّلاً مأْساةَ أمَّتِنا","ولْيَغْرَقوا بعْدَها في اللَّهْوِ والشُّرْبِ !",29,"ب",1,0],["‏فلي وعدٌ مع الأسمرْ","‏ ‏ غداً آتيك يا أشقرْ",30,"ر",1,0]]}