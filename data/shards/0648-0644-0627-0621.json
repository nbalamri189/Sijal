{"poems":[[92,"يا أم عوف عجيبات ليالينا","https://www.aldiwan.net/poem60157.html","عموديه"],[445,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110423","الوافر"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95517","المتقارب"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71037","السريع"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109376","الرمل"],[2345,"","https://poetry.dctabudhabi.ae/diwan/poem/31536","الوافر"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104362","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72460","الرجز"]],"verses":[["ولاءَمتنا شِعابٌ منكِ طاهرةٌ","كما تضمُّ المحاريبُ المصلّينا",0,"ن",2,0],["وَلاءٌ لمن أَعْتَقْتَ من مُوبِقِ الرَّدى","ورِقٌّ لمن أَطلقْتَ من مُوثِقِ الأَسْرِ",1,"ر",1,0],["ولآءُ كريمةٍ من خير قومٍ","سموا شرفاً على عُجمٍ وعُربِ",2,"ب",1,0],["ولاءُ الفواقى إلى ناهضٍ","عليه لواء العلا عاقدُ",3,"د",1,0],["ولاءُ أَهل البيت ديني الذي","به مَسحْتُ الكَفَّ للماسِحِ",4,"ح",1,0],["ولاء سماعيل قد أهديته","وبه اجو الجزاء الأفضلا",5,"ل",2,0],["وَلاءً عِندَ جَنبِهِما أُنَيسٍ","وَلَم أَجزَع مِنَ المَوتِ الزؤامِ",6,"م",1,0],["ولاء على منهج الرشد والولا","وبغض علي نهج ما كان ضللا",7,"ل",2,1],["ولاءهم أحسن شيء يقتني","وأنفس الاذخار من بعد التقى",8,"ا",1,0]]}