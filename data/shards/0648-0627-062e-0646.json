{"poems":[[422,"بكيت الديار وأطلالها","https://www.aldiwan.net/poem53946.html","الطويل"],[473,"وأخ نداه ندى لذيذ المشرب","https://www.aldiwan.net/poem60390.html","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87130","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87112","الطويل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199568","المسحوب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38615","الكامل"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/121092","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101018","الطويل"],[1829,"","https://poetry.dctabudhabi.ae/diwan/poem/130587","الطويل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100460","المتقارب"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199812","المسحوب"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120767","الكامل"],[2751,"","https://poetry.dctabudhabi.ae/diwan/poem/138886",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131009",""],[4815,"فلسفة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=210511",""],[6102,"دانا ..","https://www.poetsgate.com/ViewPoem.aspx?id=183992",""]],"verses":[["وأخنى عليها خطوبُ الزمان","فما خالَها تلم من خالِها",0,"ل",3,0],["وَأَخٍ نَداهُ نَدىً لَذيذُ المَشرَبِ","إِن فاضَ فاضَ بِنائِلٍ مُستَعذِبِ",1,"ب",1,1],["وَأَخ ناجب حَسيب يُجاري","في ذَكاه بِثاقب الفكر عَمّا",2,"م",2,0],["وَأَخنى عَلى المَغرور يَوم نِزاله","بِوَخزِ عوالٍ أَو بِطَعنِ حسام",3,"م",1,0],["واخن مْن اللى ينعين فى ملاله","ويقدّرونه فى صغار الفناجيل",4,"ل",1,0],["وَأَخنّ جواظ عُتُلّ بارِدٍ","وَثَقيل ذاتٍ لَيسَ بِالمَحمودِ",5,"د",1,1],["وأخنى عليَّ الدهرُ من ثقل وقره","وأخنى بلاهُ كاهلي ثم غاربي",6,"ب",2,0],["وأخنس ممحوق الحجاجين ينتحي","لأصمع معروق العذارين أشنق",7,"ق",1,0],["وأخنع بالعتبي إذا كنت مذنباً","وإن أذنبت كنت الذي أتنصَّلُ",8,"ل",1,0],["وأخنى عليه الزمان الخؤون","وحكمفي رسمهن السيولا",9,"ل",2,0],["واخنّ من شمّ العطر في المناديل","تذكار شوقٍ ضمّخه طيب لخدود",10,"د",1,0],["وأخ نسبت الحبّ أحظى من أخ","في نسبة الصلصال والفخار",11,"ر",1,1],["وأخنى علي الدهر في من رجوته","كفيلاً لأيتامي وذخر العواقب",12,"ب",1,0],["وأخنى عليها حر نار لسانها","ينث به في الخافقين لك الحمد",13,"د",1,0],["وأَخنقُ الحرفَ في قوسينِ أُنكرُهُ","والحرفُ مِنِّي ومِنْ رُوحِي وخَفَّاقِي",14,"ق",2,0],["وَ أَخنُقُ الوَجدَ - وَيحَ الوَجدِ يَسكُنُنِي -","تَحتَ الشِّغافِ , فَتُردِينِي أَيادِيهِ",15,"ي",2,0]]}