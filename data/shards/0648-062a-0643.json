,"دع وهم أهل الوحدة المطلقه","https://www.aldiwan.net/poem37935.html","السريع"],[545,"هدهد لظاك","https://www.aldiwan.net/poem67254.html","عموديه"],[552,"ألا يا أيها الحادي","https://www.aldiwan.net/poem47850.html","الهزج"],[552,"يا قلب قل لي أين صادفك الهوى","https://www.aldiwan.net/poem47896.html","الكامل"],[559,"كل شيء لا يرى الرحمن به","https://www.aldiwan.net/poem33521.html","الرمل"],[559,"شعورك والإدراك فعل الذي خلق","https://www.aldiwan.net/poem34308.html","الطويل"],[559,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[559,"سلام عظيم من عظيم تفردا","https://www.aldiwan.net/poem34594.html","الطويل"],[559,"كواكب جرت من السماء","https://www.aldiwan.net/poem35083.html","الرجز"],[563,"واحد في الحمى فدته ألوف","https://www.aldiwan.net/poem52775.html","الخفيف"],[563,"مضى زمن الصبى فدع التصابي","https://www.aldiwan.net/poem52876.html","البسيط"],[563,"عتبت سعاد ولم أكن بالمذنب","https://www.aldiwan.net/poem52964.html","الكامل"],[564,"فالأولياء رحمة للخلق","https://www.aldiwan.net/poem13620.html","الرجز"],[565,"إسق يا غيث بكرة وعشية","https://www.aldiwan.net/poem910.html",""],[576,"إن كنت ترغب أن ترانا فالقنا","https://www.aldiwan.net/poem3003.html","الكامل"],[576,"يا ثالث العمرين علماً","https://www.aldiwan.net/poem3011.html","مجزوء الكامل"],[577,"من مبلغ الشعراء عن أخويهم","https://www.aldiwan.net/poem1773.html","الكامل"],[588,"أعلى المنازل إذ عفت أعلامها","https://www.aldiwan.net/poem11516.html","عموديه"],[588,"ألا مال نيران الأسى تتضرم","https://www.aldiwan.net/poem11519.html","عموديه"]],"verses":[["وَتُكثِرُ بِالأَمرِ العَظيمِ تَهَدُّدي","وَمِنِّيَ تَنفَضُّ الأُمورُ العَظائِمُ",0,"م",1,0],["وَتَكَلَّفَت مِن صَوبِ ماطِرِها","فَوقَ الَّذي يَرجو مُكَلِّفُها",1,"ف",3,0],["وَتَكونُ طَلقاً ثُمَّ يُؤ","نِسُ ذِلَّةً فَيُرى عَبوسا",2,"س",2,0],["وَتَكونُ صَوتاً لِلحَرونِ إِذا وَنى","وَعِنانَ عُنقِ الجامِحِ المُتَمادي",3,"د",2,0],["وتَكْسِرُ جَفْنَيْها علي نَجَلٍ بِها","كما أطْبَقَ العَيْنَ الكَحيلَةَ جُؤْذَرُ",4,"ر",1,0],["وتكاثَرَتْ دُفَعُ الدّموعِ كأنّها","نَفَحاتُ سَيْبِكَ يا قِوامَ الدّينِ",5,"ن",1,0],["وتَكْرَعُ في مثْلِ السّماءِ تألّقَتْ","منَ الحَبَبِ الطّافي بحِضْنَيْهِ أنْجُمُ",6,"م",1,0],["وَتَكَنَّفَ الإْسْلاَمَ مِنْكَ وَأَهْلَهُ","نَظَرٌ يَدِقَّ عَنِ النَّهَى تَأوِيلُهُ",7,"ل",2,0],["وَتَكونُ في السَلَفِ المُوَا","زي مِنقَراً وَبَني زُرارَه",8,"ر",2,0],["وَتَكونُ شَكواها إِذا هِيَ أَنجَدَت","بَعدَ الكِلالِ تَلَمُّكٌ وَصَريفُ",9,"ف",1,0],["وَتَكَشَّفَت تِلكَ الغَياهِبُ وَاِنطَوَت","وَبَدَت شُموسُ الحَقِّ وَهيَ ضَواحي",10,"ح",2,0],["وَتَكادُ تَقدَحُ في الأَثي","رِ فَيَستَحيلُ إِلى شَرار",11,"ر",1,0],["وَتَكتُمُنا حَديثَ هَواكَ حَتّى","أَذاعَ الصَمتُ ما أَخفى الكَلامُ",12,"م",1,0],["وَتَكُونَ بَدْرَ التَّمِّ بَيْنَ نُجُومِهَا","وَالفَرْدَ إِنْ عَدَّ الفَخَارُ عَدِيدَهَا",13,"د",3,0],["وَتَكْلأُهُ العِنَايَةُ وَهْيَ تَرْنُو","بِعَيْنِ أَبٍ عَلَى وَلَدَيْهِ حَانِ",14,"ن",1,0],["وَتَكَاثَرَاً نُعماً فَفِيما نَشْتَهِي","لَكُما كَثيرُ الطَّيِّبَاتِ قَلِيلُ",15,"ل",1,0],["وَتَكسو المِجَنَّ الرَخوَ خَصراً كَأَنَّهُ","إِهانٌ ذَوى عَن صُفرَةٍ فَهوَ أَخلَقُ",16,"ق",1,0],["وتكثُر للتعاوُن والتفادي","على الأيام بينهم الدواعي",17,"ع",2,0],["وتكسو العَراء الرَحب مسْح عجاجة","يَمُجّ بها السيفُ الرَدى وهو عُريان",18,"ن",1,0],["وتَكره نفسي أن أكون مخادعاً","لأدرك نفعاً أو لأدفع ضائراً",19,"ر",2,0],["وتكريم ربّ العشر ليس بمفخر","لمن كان عن حرّية الفِكر جائرا",19,"ر",2,0],["وتكرهُ نفسي كل عبد مُذَلَّل","فقد كرِهت حتى الطريق المُعبَّدا",20,"د",2,0],["وَتَكليفي المَطِيَّ أُوارَ نَجمٍ","لِلَيلِ الخامِساتِ بِهِ أُوامُ",21,"م",1,0],["وتكون ريقتها إذا نبهتها","كالشهد أو كسُلاف الجريالِ",22,"ل",1,0],["وَتَكنُفُهُ بِطارِقَةٌ تُيوسٌ","تُبارى بِالعَثانينِ الضِخامِ",23,"م",1,0],["وَتَكادُ تَكسَلُ أَن تَجيءَ فِراشَها","في لينِ خَرعَبَةٍ وَحُسنِ قَوامِ",24,"م",1,0],["وَتَكَلُّفي اليَومَ الطَويلَ وَقَد","صَرَّت جَنادِبُهُ مِنَ الظُهرِ",25,"ر",1,0],["وتكتب في حالي نداها وسطوها","بدرياقها طوراً وطوراً بسمِّها",26,"م",3,0],["وتكوّنتَ من سوادِ أبي الأس","ود شخصاً يُكنى أبا السوداءِ",27,"ا",2,0],["وتكذَّبْتَ في اعتذَا","رك فاصدُقْ أوِ اصْمتِ",28,"ت",1,0],["وتكميل معروف الكريم بِحشده","وأسديْتَ معروفاً وقد بقي الحشْدُ",29,"د",1,0],["وَتَكليفُناها كُلَّ نازِحَةِ الصُوى","شَطونٍ تَرى حَرباءَها يَتَمَلمَلُ",30,"ل",1,0],["وَتَكادُ مِن فَرطِ الصَبابَةِ وَالجَوى","أَن تَهجِرَ المَشروبَ وَالمَأكولا",31,"ل",2,0],["وَتَكادُ لَولا الخَوفُ تَل","مُسُ وَجنَتَيهِ وَجنَتاها",32,"ا",3,0],["وتكونَ عزماً في دمي وتوهُّجاً","في ناظِريَّ وحدّةً في نابي",33,"ب",2,0],["وتكون الجنان من كسل في","اهلها المترفين شر جحيم",34,"م",1,0],["وتكون غير الأرض خا","لية كأمثال الخرائب",35,"ب",1,0],["وتكاد تحيى مؤنسا بصريرها","وتقول أيام ابن مقلة عودى",36,"د",2,0],["وتكذب بالصلاة على إله","ولما بتلغ الروح التراقي",37,"ي",1,0],["وَتُكسَرُ في مَراكِزِها العَوالي","وَتُدفَنُ في التُرابِ المُرهَفاتُ",38,"ت",1,0],["وَتَكادُ الطَيرُ مِن خِفَّتِهِ","تَتَعالى فيهِ مِن غَيرِ جَناح",39,"ح",1,0],["وَتَكسِرُ فيهِم غُرورَ الثَرا","ءِ وَزَهوَ الوِلادَةِ وَالمَنصِبِ",40,"ب",1,0],["وَتَكادُ مِن نورِ الإِلَهِ حِيالَهُ","تَبيَضُّ أَثناءُ الهِلالِ الأَحمَرِ",41,"ر",1,0],["وَتُكثِرُ ذِكرَ الباسِلينَ وَتَنثَني","بِعِزٍّ عَلى عِزِّ الجَمالِ وَتُعجَبُ",42,"ب",1,0],["وَتَكثيرِ قَومٍ وَتَقليلِهِم","وَتَقريبِهِم بَينَنا وَالخَبَب",43,"ب",1,0],["وَتَكَرَّمَت رُكَباتُها عَن مَبرَكٍ","تَقَعانِ فيهِ وَلَيسَ مِسكاً أَذفَرا",44,"ر",2,0],["وَتَكادُ الظُبا لِما عَوَّدوها","تَنتَضي نَفسَها إِلى الأَعناقِ",45,"ق",1,0],["وَتَكمِلَةُ العَيشِ الصَبا وَعَقيبُهُ","وَغائِبُ لَونِ العارِضينِ وَقادِمُه",46,"م",2,0],["وتكلِّفُ القُبَّ الشوازبَ غايةً","تُهدِي الكلالَ إِلى البُروق اللُّمَّعِ",47,"ع",1,0],["وَتَكادُ تَنتَقِصُ السُيوفُ مِنَ الأَسى","فَتَخورُ أَنفُسُهُم وَلَم تَتَخَيَّرِ",48,"ر",1,0],["وَتَكمي زِجاجَ الرَأيِ حَتّى أَوانَها","لَدَيهِ كَما يَكمي الزِجاجَ جَفيرُها",49,"ر",3,0],["وَتَكرارَنا ذاكَ العِناقَ إِذا اِنقَضَت","لَنا عَبرَةٌ عادَت لَنا عَبرَةٌ تَجري",50,"ر",2,0],["وتَكْشِفُ أسرارَ الأخِلاَّءِ مازِحاً","ويا رُبَّ مَزْحٍ عادَ وهو ضَغائِنُ",51,"ن",1,0],["وتَكَشَّفْتَ فالعَوارُ الذي ما","زِلْتَ تُخفيهِ ظاهِرٌ مَكشوفُ",52,"ف",1,0],["وَتَكَلَّمَت لَك بِالبِلى","مِنهُنَّ أَلسِنَةُ صُمُت",53,"ت",1,0],["وَتُكثِرُ مِنها المُسلِمونَ لِسُكرِها","وَتَترُكُ نَفعاً لِلقَليلِ مُحَرَّما",54,"م",2,0],["وتكونُ النجاةُ في القمر السا","ري على زورقٍ من النورِ حالم",55,"م",1,0],["وتكللت بالطهر مؤتلق السنا","وجلت لنا معنى الجمال رفيعا",56,"ع",2,0],["وتكادُ تُرْدي في الغمودِ سيوفُهُ","وتبيدُ أسهُمُهُ وإن لم تُرْسَلِ",57,"ل",1,0],["وتكفّ عن فَلَقٍ دُجى غَسَقٍ","بِمُضرَّجاتٍ من دَمِ البَطَلِ",58,"ل",1,0],["وتكَلَّمْ بما يَزينُكَ في الحَف","ل وَتَقْنَى به عَلاءً ومَفخَرْ",59,"ر",1,0],["وَتَكبيرُهُ خَمساً عَلَيهِ مُعالِناً","وَإِن كانَ تَكبيرَ المُصَلّينَ أَربَعُ",60,"ع",1,0],["وَتَكَفَّلَ الأَيتامَ عَن آبائِهِم","حَتّى وَدِدنا أَنَّنا أَيتامُ",61,"م",1,0],["وَتَكَنَّفنَها كَواعِبُ بيضٌ","واضِحاتُ الخُدودِ وَالأَقرابِ",62,"ب",1,0],["وَتَكُن لَدَيهِ حِبالُهُ أُنشوطَةً","في غَيرِ شَيءٍ يَقطَعِ الأَسبابا",63,"ب",2,0],["وَتَكَنَّفَت شَكواكَ عَن خَطبٍ دَهى","هَدَّت لَهُ أَركانَها الأَطوادُ",64,"د",1,0],["وَتَكَشَّفَت لَكَ حالَةٌ عَن غادِرٍ","مَلِقٍ وَمرعى الغادِرينَ وَبيلُ",65,"ل",1,0],["وتكنَّفوهُ لِيفتنُوه فزادَ في","إيمانِهِ ما جَرّعوهُ من الأذَى",66,"ذ",2,0],["وَتَكنَّفوهُ يُعَظِّمُونَ مَكَانَهُ","وَذوُو قرابَتِهِ تَصُدُّ وَتَصدِفُ",67,"ف",1,0],["وتكرهُ أن تراه وَيشتهيها","لها من حَدّهِ والٍ يليها",68,"ه",2,0],["وتُكرِمُ سيفَكَ العفَّ النزيها","تُولوِلُ للمنيّةِ تتّقيها",68,"ه",2,0],["وَتَكادُ تَسبُقُ قَبلَ وَقتِ حُلولِها","وَتَكادُ في أَثَرِ الرَحيلِ تَعودُ",69,"د",1,0],["وَتَكَلَّمَ الأطفالُ والمَوْتَى لَهُ","بِعجائِبٍ فليَعجَب المُتعجِّبُ",70,"ب",1,0],["وتكادُ تُعشِبُ أرْضُكم بكلامِكم","لو أنّ أرضاً أعشَبَتْ بكلام",71,"م",1,0],["وتكادُ يُمناهُ لفَرطِ بِلالِهَا","بينَ المواهبِ واللُّهى تَتَسَلْسَل",72,"ل",1,0],["وتكنّفاني يَنفُضانِ ليَ الدّجَى","فإذا أمِنْتُ ترصَّدا فتخوّفَا",73,"ف",2,0],["وتكادُ تذهَلُ عن مَطالِعها","مما تراوحها وتبتكر",74,"ر",1,0],["وَتَكتَسي لُؤلُؤاتٍ مِن تَعَطُّفِها","عِندَ المِزاجِ شَبيهاتٍ بِواواتِ",75,"ت",1,0],["وَتَكَسُّرٌ في مُقلَتَيكَ هُوَ الَّذي","عَطَفَ الفُؤادَ عَلَيكَ بَعدَ جِماحِ",76,"ح",1,0],["وَتَكَشَّفُ الغَمراتُ عَن رَجُلٍ","وَهوَ الجَهولُ بِشَأنِهِ الغُمرُ",77,"ر",1,0],["وَتَكذِبُ إِنَّ المَينَ في آلِ آدَمٍ","غَرائِزُ جاءَت بِالنِفاقِ وَبِالعِهرِ",78,"ر",1,0],["وتكونُ كالوَرَقِ الذّنوبُ على الفتى","ومُصابُهُ ريحٌ تهُبّ لِحَتّها",79,"ت",3,0],["وتكْتُمُ فيهِ العاصِفاتُ نُفُوسَها","فلو عَصَفَتْ بالنّبْتِ لم يَتَأوّدِ",80,"د",1,0],["وَتَكاد الأرض الَّتي قد جثمنا","فوقها من هول الهَزيم تَزول",81,"ل",1,0],["وتكاد الظبَى لما عودوها","تنتضي نفسها إلى الأعناق",82,"ق",1,0],["وتكرم الدار على الحر الأبي","كرامة الأم عليه والأب",83,"ب",1,0],["وتكَفُّري برداءِ وَصْلِ مُقَرْطَقٍ","كَتَبُوا بِنقْسِ المِسْكِ في كافُورِه",84,"ر",2,0],["وتَكاوستْ فيها الأَبا","رِقُ وهْي فاهِقةُ الحلاقِمْ",85,"م",1,0],["وَتَكَادُ بَارِقَةُ المُنَى لاَ تَنْجلي","لِعُيُونِنَا إلاَّ وَهُنَّ هَوَامِي",86,"م",2,0],["وَتَكَادُ أَسْطُرُهَا تَهُبُّ نَوَاطِقاً","وَيَكَادُ يَعْزِفُ كُلُّ حَرْفٍ مَعْزِفا",87,"ف",2,0],["وَتَكَادُ رِقَّتُهُ تَسِيلُ بِلَفْظِهِ","فِي المُهْجَةِ الظَّمْأَى مَسِيلَ المَاءِ",88,"ا",2,0],["وَتَكَادُ لاَ تَخْفى عَلَيْكَ خَفِيَّةٌ","قَرُبَتْ بِهَا أَوْ شَطَّتِ الأَقْطَارُ",89,"ر",1,0],["وتَكادُ عِزّاً لاَ تَرَى فَوْقَ الثَّرَى","حَظّاً عَلَى مَا نِلْتَهُ يُخْتَارُ",89,"ر",1,0],["وَتَكادُ تَمسَحُ مِن دِماءِ جِراحِها","آثارَ ما نَقَشَت عَلى الأَطوادِ",90,"د",1,0],["وتكلّمت أحجارَك ال","صمّاء مشرقة البيانْ!",91,"ن",1,0],["وتكاد تنقل ظلّها","وتسير مطلقة العنانْ!!",91,"ن",1,0],["وتكادُ تَلْتَهبُ المَنَابرُ حَسْرةً","لمّا رَحَلْتَ على خَطِيب إِياد",92,"د",1,0],["وتكادُ الأشواقُ تدفعُ بالفُل","كِ وتَحتلُّ موضع الرُّبَّان",93,"ن",1,0],["وتكدَّسُوا في غرفتين تكدُّسًا","فكأنهم عقدٌ بغيرِ نظام",94,"م",1,0],["وتكنف الإسلام منك وأهله","نظير يعز عن النهى تأويله",95,"ل",2,0],["وَ تكلموا في أمرِ كلَّ عظيمة","ٍ لوْ كنتَ شاهدهمْ بها لمْ ينبسوا",96,"س",3,0],["وتكفُرُ أنَ السما لم تعد","تُغيثُ حَريباً ، ولا تَرْحَم",97,"م",1,0],["وتكمي زجاج الرأى حتى أوانها","لديه كما يكنز الزجاج جفيرها",98,"ر",3,0],["وتكبيرة في الفجر سالت مع الصّبا","نعيم فياف واخضلال سهوب",99,"ب",1,0],["وتكاد تقطف كالرّياحين المجانة والدعاب","أه