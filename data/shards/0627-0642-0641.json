""],[402,"قد تلوى رفاقنا وبقينا","https://www.poetsgate.com/ViewPoem.aspx?id=36482",""],[469,"أنَّةُ الحبِّ زفرةٌ وعويلُ","https://www.poetsgate.com/ViewPoem.aspx?id=76545",""],[5977,"وجعي","https://www.poetsgate.com/ViewPoem.aspx?id=212756",""],[5982,"يا مصر","https://www.poetsgate.com/ViewPoem.aspx?id=152889",""],[6045,"أملٌ ممتنع !","https://www.poetsgate.com/ViewPoem.aspx?id=125350",""],[6056,"وطفاء الحجاجين","https://www.poetsgate.com/ViewPoem.aspx?id=130183",""],[6056,"نصيحة في زمن لايقبل النصيحة","https://www.poetsgate.com/ViewPoem.aspx?id=130520",""],[6093,"بِكَ لا بغيرِكَ تَنْجَحُ الآمَالُ ( الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=181650",""],[6100,"اقفيت لكن دمعك سال","https://www.poetsgate.com/ViewPoem.aspx?id=52553",""],[6102,"هذه ليلتي","https://www.poetsgate.com/ViewPoem.aspx?id=182769",""],[6125,"يَجتاحني حبٌّ تَملَّكَ في دمي","https://www.poetsgate.com/ViewPoem.aspx?id=210970",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""],[6256,"أقفر الساح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65925&r=&rc=13",""]],"verses":[["أَقْفَرْتَ رَبْعَ الْكُفْرِ مِنْ سُكَّانِهِ","بِهَلاَكِهِمْ وَعَمَرْتَ رَبْعَ جَهَنَّمِ",0,"م",1,0],["أَقفَرَت بَعدَكَ الأَساليبُ وَاِستَر","خى عِنانُ الرَسائِلِ المُمتِعاتِ",1,"ت",1,0],["أقفر من ساهره مثلما","يخلو من الضوء منارٌ خبا",2,"ا",1,0],["أقفرت أرضها وحاق بها الجه","ل فجاشت دواهياً وخطوبا",3,"ب",2,0],["أَقُفَيرَ قَد عَلِمَ الزُبَيرُ وَرَهطُهُ","أَن لَيسَ حَبلُ مُجاشِعٍ بِالأَوثَقِ",4,"ق",1,0],["أقفرت ساحة العلى فبيوت الش","عر من بعدِ بُعده أطلاله",5,"ل",2,0],["أَقفَرَتِ البُلخُ مِن عَيلانَ فَالرُحَبُ","فَالمَحلَبِيّاتُ فَالخابورُ فَالشُعَبُ",6,"ب",1,1],["أقفرت منك بعد أن كنت تشدو","في ذراها منازل وربوع",7,"ع",1,0],["أقفُ العشيةَ بالرفاق مقصراً","حيران قد عقد الجميل لساني",8,"ن",2,0],["أَقفَرتُ مِن جِهَتَينِ قَفرِ مَعازَةٍ","وَطَعامِ لَيلٍ جاءَ وَهوَ قِفارُ",9,"ر",1,0],["أَقفَرَ في المَطعَمِ رُكبانُها","وَالقَومُ بِالدَوِّيَّةِ المُقفِرَه",10,"ر",2,0],["أَقفَرَ مِن مَيَّةَ الدَوافِعَ مِن","خَبتٍ فَلُبنى فَيحانَ فَالرِجَلُ",11,"ل",1,1],["أَقفَرَ مِن أَهلِهِ مَلحوبُ","فَالقُطَبِيّاتُ فَالذَنوبُ",12,"ب",1,1],["أقفَرَت مِنهُمُ الأَجارِبُ فالنَهيُ","وَحَوضَى فَرَوضَةُ الأَدحالِ",13,"ل",1,0],["أَقفَرَ الحضرُ مِن نَضيَرةَ فالمر","باعُ مِنها فجانِبُ الثَّرثارِ",14,"ر",1,1],["أَقْفَرَ البَيْتُ أَيْنَ نَادِيكِ يَا مَيُّ","إِلَيْهِ الوُفُودُ يَخْتَلِفُونَا",15,"ن",2,0],["أَقفَرَت وَكُلُّ حِمىً","آنِسٌ كَمقفرِها",16,"ر",3,0],["أَقفرْت أرضها وحاق بها الجه","فجاشت دواهيا وخطوبا",17,"ب",2,0],["أقْفو الملاحَ لكي أسلو هواك بهم","فيرجعُ الحسن منهم فيكِ يغريني",18,"ن",2,0],["أقْفَرَتْ مِنْ رغْد الحياةِ دياري","ومقاديري قَدْ سَقَتني أُوامِي",19,"م",2,0],["أقفع نفسي إن أردت استراحة","وأحبو إذا رمت القعود واسند",20,"د",1,0],["أقفرت بعدك الديار وسبحا","ن من اختص بالبقاء الطويل",21,"ل",1,0],["أَقفَرَت بَعدَهُ رُبوعُ الأَحادي","ثِ وَأَقوت مَعالِمُ الأَنباءِ",22,"ا",2,0],["أقفرت واحتي وصوّح كرمى","وطغت علّتي ومات أُساتي",23,"ت",2,0],["أقف اليوم والخطوب جسام","لأرى الركب قد أضلوا السفينه",24,"ن",2,0],["أَقفَرَ من سَلمى يَناضيبُ","فَبَطنُ ذي قارٍ فَعُرقُوبُ",25,"ب",1,1],["أَقفَرتَ مِن أَحيائِهِم وادي القُرى","وَعَمَرتَ مِن أَمواتِهِم وادي الكَرى",26,"ر",2,1],["أقفلت باب الرضا بعد الرحيل فهل","علمت أن حصان الشوق قد جفلا",27,"ل",2,0],["أَقفَلَ الحُلمُ سَمعَهُ عَن قَبيحٍ","إِنَّ في أَكثَر الوِقار لوقرا",28,"ر",2,0],["أقفرت دورا منك كن عمارة","وعمرت دوراً سوحهن رضيعا",29,"ع",2,0],["اقفرتْ ساحة المصلّى من الح","ي وسارت عن العذيب الخمولُ",30,"ل",1,0],["أقفرَ مِن سكانِه المعهدُ","فهل لقربٍ منهمُ موعدُ",31,"د",1,1],["اِقفِر مِن آلِ سُعدى الكَثيب","فَالسَفح من ذاتِ السَنا فَالطَلوبُ",32,"ب",1,1],["أَقفَرَت بَعدَ عَبدِ شَمسٍ كَداءُ","فَكُدَيٌّ فَالرُكنُ فَالبَطحاءُ",33,"ا",2,1],["أَقفَرَت مِنهُمُ الفَراديسُ فَالغو","طَةُ ذاتُ القُرى وَذاتُ الظِلالِ",34,"ل",1,0],["أَقفَرَتِ الرَقَّتانِ فَالقَلَسُ","فَهوَ كَأَن لَم يَكُن بِهِ أَنَسُ",35,"س",1,1],["أقفرتِ بعدَ تأهُّلٍ","يا جنةَ الصّبِّ الكئيبِ",36,"ب",1,0],["أَقفَر المَيدانُ مِن فُرسانِهِ","وَخَلا مِن أَهلِهِ غابَ الأُسودِ",37,"د",1,0],["أقفرَ الدّيرُ فالأجارعُ مِن قو","مي فعوقٌ فرامحٌ فخفيّه",38,"ي",2,0],["أقْفرَ الخَبُّ من مَنازلِ أسما","ء فَجَنْبا مُقلِّصٍ فظَليمُ",39,"م",1,0],["أَقفوكِ في القفر في الوديان مُنسَلِباً","في البر في البَحر في الأَسفار في الحَضَرِ",40,"ر",1,0],["أَقْفَرَتِ الوَعْساءُ وَالعَثاعِثُ","مِن أَهْلِها وَالبُرَق البَرَارِثُ",41,"ث",1,1],["أَقَفوريا قَريَةٌ مُبارَكَة","يُنقِل فَخّارُها إِلى الذَهَبِ",42,"ب",1,1],["اقفرت اطلال الاحبة عنهم","فقتك غادية السحاب حياها",43,"ا",3,0],["إقفِر قِوافينا وتَنبيك عَنّا","نِلْحَظك بِالنّاظِر ونَحميك بِلسان",44,"ن",1,0],["أَقفَرَ بَعدَ الرَبابِ مَلحوبُ","خودٌ عَلَيها الجَمالُ مَصبوبُ",45,"ب",1,1],["أَقفَرتَهُ من حُسن وَصلكَ بَعدَمَا","جَادَت عَلَيكَ دُمُوعُهُ وَنسِيبُهُ",46,"ب",2,0],["أقفَرَت من أنيسِها البَطحاءُ","فَاللَوى فالذنوبُ فَالحَوّاءُ",47,"ا",2,1],["أقفَرَ اليومَ من سعادَ وسُعدى","لجَّ يا قلبُ في جوىً واكتِئابِ",48,"ب",1,0],["أَقفَرَ إِلّا مِن نَباتٍ مَنزِلُهْ","وَدَرَسَت آياتُهُ وَطَلَلُهْ",49,"ل",2,1],["أقفرت بعدك الربى والبطاح","غير شبر حدت عليه الحوادى",50,"د",2,0],["اقفرت فهي للغراب مطار","بئس نعب الغراب في الأرض فألا",51,"ل",2,0],["اقفو مساعيك اللاتي خصصت بها","حذو الشراك على مثل من الأدم",52,"م",1,0],["أَقفرَ مِن رَيطَةَ جَنبا مِنّي","فالجِزعُ مِن مَكَّةَ فالساحِلُ",53,"ل",1,0],["أقف المطية إن وصلت إلى منى","ومن المحصب فانتشق ريح المنى",54,"ن",2,1],["أَقفَرَت مِن آلِ لَيلى الهِضابُ","وَعَفا بَعدَ الأَنيسِ الجَنابُ",55,"ب",1,1],["أقفرَ بعدَ الأحبةِ البلدُ","فهو كأن لم يكن بهِ أحدُ",56,"د",1,1],["أقفوه عند تَيمٍ مَوقفاً","ماجَ قبرُ المصطفى منه نِياحا",57,"ح",2,0],["أَقفر مِن أَهلِه الجريب إِلَى الز","زُجين إِلا الظباء والبَقرا",58,"ر",2,1],["أقفرَ من ميةَ الجَريب إلى الز","زجين إلا الظباء والبقرا",59,"ر",2,1],["أَقفرتُ من أَهلي وحَاربني","من ليس لي بقتاله قِبَلُ",60,"ل",1,0],["أقفَرْتَ من أهْلِ الضّلالةِ أرْضَها","وملأتَ آفاقَ السّماءِ بُنودا",61,"د",2,0],["أَقفَرَ مِمَّن يَحُلُّهُ السَنَدُ","فَالمُنحَنى فَالعَقيقُ فَالجُمُدُ",62,"د",1,1],["أقفرت أربعهم من بعد أن","كانت الوفد بها تلقي الرحالا",63,"ل",2,0],["اقفرَ الدهر من كريم فعوَّض","ت كراماً تبكيهم الأيام",64,"م",1,0],["أقفو نويرة في جميع فعاله","أرث المكارم والعزائم من أب",65,"ب",1,0],["أَقفُ المُطِيَّ عَلى الطلولِ رَواسِماً","أَبكي رُسوماً في مَحلّ مُحولِ",66,"ل",1,0],["أقفز فوق كتفيك قفزة","أنجو بها بطالع سعيد",67,"د",1,0],["أقفرت الأرض من محاسنها","فابك عليها بكاء يعقوب",68,"ب",1,0],["أقفرتِ منه قبيسَ الدار أنت إذاً","وقاطنوكِ فأنت أَوْلُ إقفارِ",69,"ر",1,0],["أقفرَ إلا منْ بناتَ منزلُهْ","ودرستْ آياتُهُ وطللُهْ",70,"ل",2,0],["أقفروا أربعاً وحلوا بأخرى","فسقوها عذباً وتلك عذابا",71,"ب",2,0],["أَقفلت بابَ مسرَّتي وفتحتَ من","دمعي وحُزني كلَّ بابٍ مقفلِ",72,"ل",1,0],["أقفرت ممَّن همُ في الق","لبِ والطَّرفِ حُلولُ",73,"ل",1,0],["أَقفَرَ مَغنى الدِيارِ بِالنَجِفِ","وَحُلتُ عَمّا عَهِدتُ مِن لَطَفِ",74,"ف",1,1],["أُقفِي الرَقيبَ أُداويهِ وَأَصنَعُهُ","عارِي النَواهِقِ لا جافٍ وَلا قَفِرُ",75,"ر",1,1],["أقفاصها كمحبس الحجاب","مدورات الشكل كالقباب",76,"ب",1,0],["اقفي عن العينين ياخل زليت","بنت العرب مابا تجي علمزاجي",77,"ج",2,0],["اقفااا وخلفه ( كفوف الراحه ) تلوحي","قالت تريّث حظوظ الوقت بيّاعه",78,"ع",2,0],["اقفوا على مايشتهون الاجاويد","وانا بعد اقفيت عن من هو اقفى",79,"ف",2,1],["آقف وأحيّي بالرجاجيل ملزوم","حزّة مواجيبٍ تنادي ولدها",80,"د",3,0],["أُقَفِّيْ قَصِيْدَ الْحُبِّ وَالشَّوْقِ وَالرِّضَاْ","وَأَكْتُبُ فِيْ حُبِّ الشَّآمِ الْقَوَاْفِيَاْ",81,"ي",2,0],["اقفاعلى رايه ولافيه مرجاع","مثل السحاب اللي قفته الهبايب",82,"ب",1,0],["أقْفَلْتُ بَابِيَ قَال الصَّبْرُ وَا عَجَبا","لِمَنْ هَوَاهُ هَوَى بَيْنَ الثَّعَابِين !",83,"ن",1,0],["أَقْفَرَ الْحَقْلُ فاهْدَئي يا رياحُ","قَتَلَ النَّاسُ ناسَهُ، واسْتَراحوا",84,"ح",3,1],["أقفرَتْ دوننا الدُّروبُ وَ لَمَّا","شرَّدَتنا تعذَّرَ المَطْلُوْبُ",85,"ب",1,0],["إقفل لباريس وابسم بين أربعها","فقد تصبّى جنان الأربع الوهر",86,"ر",1,0],["إقفل ْ فلنْ تَجري الدماءُ حُرّةٌ","الحبُ قدْ ولّى وأمسى كالسَهمْ",87,"م",1,0],["آقف على درب المحبين وأذكرك","لا بالله أتعب بالمشاوير ذكراك",88,"ك",1,1],["أقفي بحملٍ يكسر متون وإرقاب","مايقدره حيد الصفا المستقلّي",89,"ل",2,0],["أقفت توّدع عمرها اللي معي راح","وأقبلت أودّع عقبها عمري الجاي",90,"ا",2,0],["أقفى مع المقفين .. وجل(ن) ومرتاب","على عقوق الوقت ، بالحيل عايب",91,"ب",1,0],["أقفلتَ قلبي بقفلٍ لا حلولَ لهُ","بل صارَ حِجْراً عن التَّهيامِ محجورا",92,"ر",2,0],["أقفى ربيع الحب .. وأدهر وطنا","وشوك الثرى دسناه في درب الأحزان",93,"ن",1,0],["اقفي عن الضيق لكن داخل غلافه","يطويني القيد وابقى داخل غلافي",94,"ف",2,0],["اقفى وخلاني بلا درب وخوي","وحيد ووصاله محال",95,"ل",1,0],["اقفى وفي الخاطر ترى شي ماجاك","شيٍ عظيمٍ ساكنن مايروحي",96,"ح",2,0],["اقفيت يوم ان القدر خان لقياك","والشوق في صدري حصانه جموحي",96,"ح",2,0],["اقفا .. بفهوم الخطا والتوابه","يقطع طريق الطيب منظر علابيه",97,"ي",2,0],["اقفا قوي العين مع ثايرٍ هاج","وانا الوحيد اللي يهده ويبنيه",98,"ي",2,0],["اقفا وانا في داخلي كون وازعاج","ثارت براكينه وثارت معانيه",98,"ي",2,0],["اقفت وخلتني بعد ما احرمتني","وانا على شوق الوصل حيل توّاق !!",99,"ق",1,0],["أقفت بروس الأنبيا والسلاطين","لاجاملت معهم ولاهيب تاوي",100,"ا",3,0],["اقفا يهز الجسم والجسم ممشوق","مثل الرطيب اللي على جال ساقي",101,"ق",2,0],["اقفا وقلبي شاح له تقل مسيوق","ونهيت قلبي مرتين وتاقي",101,"ق",2,0],["اقفا وانا ما ادرك من الهرج منطوق","وما ادري متى يرجع نهار التلاقي",101,"ق",2,0],["اقفا ود مع العين يمطر من الموق","دمع جرى من نونها باندفاقي",101,"ق",2,0],["اقفا مع الغالين قطاعة الروس","اللي على القاسين بالفعل قاسين",102,"ن",1,0],["اقفو على قب تخافق مع الوطا","تنازا بطوعات الرقاب حذاه",103,"ا",2,0],["أقفا مثل ماجا وهو يشكي العمى","اقفا من الذله يحر قناه",103,"ا",2,0],["اقفوا كما غيم تقفاه نسناس","ولا حدن بها الدنيا مقيم مديمي",104,"م",2,0],["أقفل هدب تسهر على شعري أهداب","كني حبست رقادهم في جفوني",105,"ن",2,0],["أقفر البيت أين ناديك يا مي","غليه الوفود يختلفونا",106,"ن",2,0],["اقفرتْ ساحة المصلّى من الحي","ي وسارت عن العذيب الخمولُ",107,"ل",1,0],["أقفلت دوني الباب يا (وجعي)","ومضيتَ لم تأبه بما فِيّا",108,"ي",2,0],["أقفلوا صدري على الم تكدّس,","من صدى الموت, واهات النحيب.",109,"ب",1,0],["أقفيتَ لا خفي (حنين) نلتها","(فحنين) أشفق بالمحبّ وأنفعُ !",110,"ع",1,0],["أقفا وقلبي منشطر، منه نصفين","أتلف سراجيفي ، بجور إنشطاره",111,"ر",2,0],["أقفت سنين ٍ إنقضت مالها أمثال","يوم الصقرله في الحبارى طرايد",112,"د",1,0],["أقْفَالُ غَيبٍ والمفاتِحُ كُلُّها","بيدِ الحكيمِ ويُحْكُمُ الفَعَّالُ",113,"ل",1,0],["اقفيت لكّن دمعك سال","امانتك ليه وش حرّك",114,"ك",1,0],["أَقفَرَ العُمرُ مُذْ هَجَرتَ, فَما عُد","تُ أَرَى فِي رُبُوعِهِ دَيَّارا",115,"ر",2,0],["اقفو سبيلَ الحبِّ حينَ رأيتها","ورأيتُ حينَ قَفَيتُ أكبرَ مَغنَمي",116,"م",2,0],["اقفوا بنا بالخون عامورد البلا","وَبذوا شظانا بساير البلدان",117,"ن",1,0],["اقفوا بِهم من غَير جادي عَلى الهَفا","وَالكل منا العج عاد غَشاه",118,"ا",2,0],["أقفز الساح واستطال الرياء","ومشى اليأس صامتا والفناء",119,"ا",2,1]]}