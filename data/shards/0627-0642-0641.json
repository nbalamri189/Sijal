{"poems":[[79,"فتحت سعودك كل باب مبهم","https://www.aldiwan.net/poem36122.html","الكامل"],[88,"رحم الله صاحب النظرات","https://www.aldiwan.net/poem10351.html","الخفيف"],[95,"ألقى الدجى الستر فقم طائفا","https://www.aldiwan.net/poem11062.html","السريع"],[90,"طرب الشعر أن يكون نسيبا","https://www.aldiwan.net/poem44453.html","الخفيف"],[29,"طرقت لميس وليتها لم تطرق","https://www.aldiwan.net/poem5942.html","الكامل"],[74,"كل حي قاض عليه زواله","https://www.aldiwan.net/poem19528.html","الخفيف"],[31,"أقفرت البلخ من عيلان فالرحب","https://www.aldiwan.net/poem6028.html","البسيط"],[91,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[99,"يا صفوة الأحباب والخلانِ","https://www.aldiwan.net/poem24739.html","الكامل"],[48,"بين الغريزة والرشاد نفار","https://www.aldiwan.net/poem22580.html","الكامل"],[48,"إياك والأيمان تلقي بها","https://www.aldiwan.net/poem22636.html","السريع"],[15,"أقفر من مية الدوافع من","https://www.aldiwan.net/poem45255.html","المنسرح"],[15,"أقفر من أهله ملحوب","https://www.aldiwan.net/poem45286.html","مخلع البسيط"],[8,"دار حي كانت لهم زمن التو","https://www.aldiwan.net/poem21824.html","الخفيف"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21047","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55437","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[90,"طرب الشعر أن يكون نسيبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19532&r=&rc=35",""],[90,"شوقي إليك قريب لا ينائيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19557&r=&rc=60",""],[181,"سرادق","https://www.aldiwan.net/poem50691.html","الخفيف"],[189,"سهرت وما مثلي ينام ويرقد","https://www.aldiwan.net/poem43910.html","الطويل"],[224,"يا خليلا أجل كل خليل","https://www.aldiwan.net/poem55251.html","الخفيف"],[285,"أي ركن وهى من العلماء","https://www.aldiwan.net/poem32295.html","الخفيف"],[331,"لا أنا خالد ولا أمنياتي","https://www.aldiwan.net/poem54952.html","الخفيف"],[331,"رتل البلبل الطروب لحونه","https://www.aldiwan.net/poem55066.html","الخفيف"],[353,"أقفر من سلمى يناضيبُ","https://www.aldiwan.net/poem641.html",""],[369,"أقفرت من أحيائهم وادي القرى","https://www.aldiwan.net/poem17340.html","الكامل"],[403,"عندما يرتحل القلب","https://www.aldiwan.net/poem6749.html","عموديه"],[409,"حازك البين حين أصبحت بدرا","https://www.aldiwan.net/poem50175.html","الخفيف"],[444,"الرزء أفجع أن نسح دموعا","https://www.aldiwan.net/poem14461.html","الكامل"],[466,"أنة الحب زفرة وعويل","https://www.aldiwan.net/poem3412.html","عموديه"],[479,"أقفر من سكانه المعهد","https://www.aldiwan.net/poem15224.html","السريع"],[518,"اقفر من آل سعدى الكثيب","https://www.aldiwan.net/poem48722.html","السريع"],[651,"","https://poetry.dctabudhabi.ae/diwan/poem/216944","الخفيف"],[651,"","https://poetry.dctabudhabi.ae/diwan/poem/216932","الخفيف"],[989,"","https://poetry.dctabudhabi.ae/diwan/poem/20060","المنسرح"],[989,"","https://poetry.dctabudhabi.ae/diwan/poem/20068","المنسرح"],[1050,"","https://poetry.dctabudhabi.ae/diwan/poem/200312","الكامل"],[1164,"","https://poetry.dctabudhabi.ae/diwan/poem/20651","البسيط"]],"verses":[["أَقْفَرْتَ رَبْعَ الْكُفْرِ مِنْ سُكَّانِهِ","بِهَلاَكِهِمْ وَعَمَرْتَ رَبْعَ جَهَنَّمِ",0,"م",1,0],["أَقفَرَت بَعدَكَ الأَساليبُ وَاِستَر","خى عِنانُ الرَسائِلِ المُمتِعاتِ",1,"ت",1,0],["أقفر من ساهره مثلما","يخلو من الضوء منارٌ خبا",2,"ا",1,0],["أقفرت أرضها وحاق بها الجه","ل فجاشت دواهياً وخطوبا",3,"ب",2,0],["أَقُفَيرَ قَد عَلِمَ الزُبَيرُ وَرَهطُهُ","أَن لَيسَ حَبلُ مُجاشِعٍ بِالأَوثَقِ",4,"ق",1,0],["أقفرت ساحة العلى فبيوت الش","عر من بعدِ بُعده أطلاله",5,"ل",2,0],["أَقفَرَتِ البُلخُ مِن عَيلانَ فَالرُحَبُ","فَالمَحلَبِيّاتُ فَالخابورُ فَالشُعَبُ",6,"ب",1,1],["أقفرت منك بعد أن كنت تشدو","في ذراها منازل وربوع",7,"ع",1,0],["أقفُ العشيةَ بالرفاق مقصراً","حيران قد عقد الجميل لساني",8,"ن",2,0],["أَقفَرتُ مِن جِهَتَينِ قَفرِ مَعازَةٍ","وَطَعامِ لَيلٍ جاءَ وَهوَ قِفارُ",9,"ر",1,0],["أَقفَرَ في المَطعَمِ رُكبانُها","وَالقَومُ بِالدَوِّيَّةِ المُقفِرَه",10,"ر",2,0],["أَقفَرَ مِن مَيَّةَ الدَوافِعَ مِن","خَبتٍ فَلُبنى فَيحانَ فَالرِجَلُ",11,"ل",1,1],["أَقفَرَ مِن أَهلِهِ مَلحوبُ","فَالقُطَبِيّاتُ فَالذَنوبُ",12,"ب",1,1],["أقفَرَت مِنهُمُ الأَجارِبُ فالنَهيُ","وَحَوضَى فَرَوضَةُ الأَدحالِ",13,"ل",1,0],["أَقفَرَ الحضرُ مِن نَضيَرةَ فالمر","باعُ مِنها فجانِبُ الثَّرثارِ",14,"ر",1,1],["أَقْفَرَ البَيْتُ أَيْنَ نَادِيكِ يَا مَيُّ","إِلَيْهِ الوُفُودُ يَخْتَلِفُونَا",15,"ن",2,0],["أَقفَرَت وَكُلُّ حِمىً","آنِسٌ كَمقفرِها",16,"ر",3,0],["أَقفرْت أرضها وحاق بها الجه","فجاشت دواهيا وخطوبا",17,"ب",2,0],["أقْفو الملاحَ لكي أسلو هواك بهم","فيرجعُ الحسن منهم فيكِ يغريني",18,"ن",2,0],["أقْفَرَتْ مِنْ رغْد الحياةِ دياري","ومقاديري قَدْ سَقَتني أُوامِي",19,"م",2,0],["أقفع نفسي إن أردت استراحة","وأحبو إذا رمت القعود واسند",20,"د",1,0],["أقفرت بعدك الديار وسبحا","ن من اختص بالبقاء الطويل",21,"ل",1,0],["أَقفَرَت بَعدَهُ رُبوعُ الأَحادي","ثِ وَأَقوت مَعالِمُ الأَنباءِ",22,"ا",2,0],["أقفرت واحتي وصوّح كرمى","وطغت علّتي ومات أُساتي",23,"ت",2,0],["أقف اليوم والخطوب جسام","لأرى الركب قد أضلوا السفينه",24,"ن",2,0],["أَقفَرَ من سَلمى يَناضيبُ","فَبَطنُ ذي قارٍ فَعُرقُوبُ",25,"ب",1,1],["أَقفَرتَ مِن أَحيائِهِم وادي القُرى","وَعَمَرتَ مِن أَمواتِهِم وادي الكَرى",26,"ر",2,1],["أقفلت باب الرضا بعد الرحيل فهل","علمت أن حصان الشوق قد جفلا",27,"ل",2,0],["أَقفَلَ الحُلمُ سَمعَهُ عَن قَبيحٍ","إِنَّ في أَكثَر الوِقار لوقرا",28,"ر",2,0],["أقفرت دورا منك كن عمارة","وعمرت دوراً سوحهن رضيعا",29,"ع",2,0],["اقفرتْ ساحة المصلّى من الح","ي وسارت عن العذيب الخمولُ",30,"ل",1,0],["أقفرَ مِن سكانِه المعهدُ","فهل لقربٍ منهمُ موعدُ",31,"د",1,1],["اِقفِر مِن آلِ سُعدى الكَثيب","فَالسَفح من ذاتِ السَنا فَالطَلوبُ",32,"ب",1,1],["أقفرَ الدّيرُ فالأجارعُ مِن قو","مي فعوقٌ فرامحٌ فخفيّه",33,"ي",2,0],["أقْفرَ الخَبُّ من مَنازلِ أسما","ء فَجَنْبا مُقلِّصٍ فظَليمُ",34,"م",1,0],["أَقفر مِن أَهلِه الجريب إِلَى الز","زُجين إِلا الظباء والبَقرا",35,"ر",2,1],["أقفرَ من ميةَ الجَريب إلى الز","زجين إلا الظباء والبقرا",36,"ر",2,1],["أقفو نويرة في جميع فعاله","أرث المكارم والعزائم من أب",37,"ب",1,0],["أُقفِي الرَقيبَ أُداويهِ وَأَصنَعُهُ","عارِي النَواهِقِ لا جافٍ وَلا قَفِرُ",38,"ر",1,1]]}