{"poems":[[87,"ضربوا القباب على اليباب","https://www.aldiwan.net/poem62925.html","مجزوء الكامل"],[30,"وأطلس عسال وما كان صاحبا","https://www.aldiwan.net/poem5628.html","الطويل"],[107,"اشهدي يا مصر أعمال البنين","https://www.aldiwan.net/poem43070.html","الرمل"],[107,"هو وفدهم وهم الفريق الطيب","https://www.aldiwan.net/poem44002.html","الكامل"],[83,"تنازعني الآمال كهلا ويافعا","https://www.aldiwan.net/poem61463.html","البسيط"],[104,"يا حسرتا ماذا دهى أهل الحمى","https://www.aldiwan.net/poem32944.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39635","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54933","الخفيف"],[108,"تكلمي يا كتائب","https://www.poetsgate.com/ViewPoem.aspx?id=179636",""],[96,"مصرع الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=12923",""],[164,"كانت أحادا عند غيرك لا ثنا","https://www.aldiwan.net/poem58919.html","الكامل"],[240,"يا رب أشكو إليك من نفر","https://www.aldiwan.net/poem32127.html","المنسرح"],[280,"حسب الوجود على التأييد برهانا","https://www.aldiwan.net/poem25507.html","البسيط"],[434,"ألا ثكلتك أمك عبد عمرٍو","https://www.aldiwan.net/poem775.html",""],[458,"في الشتاء العويل والأشجان","https://www.aldiwan.net/poem61727.html","الخفيف"],[463,"رد عليها النوم بعد ما شرد","https://www.aldiwan.net/poem56212.html","الرجز"],[466,"تتبارى أقلامه وقناه","https://www.aldiwan.net/poem16166.html","الخفيف"],[466,"يا لامحا شبح المسف الأكحل","https://www.aldiwan.net/poem16270.html","الكامل"],[484,"من للثكالى وللجرحى وأيتام","https://www.aldiwan.net/poem37205.html","البسيط"],[484,"في الجد أو في اللعب","https://www.aldiwan.net/poem37612.html","مجزوء الرجز"],[519,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[556,"حلفت بمعشر عسفوا المطايا","https://www.aldiwan.net/poem47223.html","الطويل"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82791","الطويل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34397","الكامل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104576","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70724","البسيط"],[1215,"","https://poetry.dctabudhabi.ae/diwan/poem/22585","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49926","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49951","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120826","الكامل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101218","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91465","البسيط"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88526","الوافر"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40115","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111408","الخفيف"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69920","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125812","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120468","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139527",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139480",""],[5145,"نعم حلب العين اعتراف الضمائر","https://www.poetsgate.com/ViewPoem.aspx?id=108071",""],[5431,"بيد أني أحبهم مثل أهلي","https://www.poetsgate.com/ViewPoem.aspx?id=197224",""],[5829,"عوراتكم ظهرت","https://www.poetsgate.com/ViewPoem.aspx?id=195347",""]],"verses":[["هَمَدوا وَكُلُّ مُحَرَّكٍ","يَوماً سَيَسكُنُ في التُرابِ",0,"ب",1,0],["هُمُ دونَ مَن أَخشى وَإِنّي لَدونَهُم","إِذا نَبَحَ العاوي يَدي وَلِساني",1,"ن",2,0],["هَمَدَت في جانِبٍ مِن بَطنِها","يَسَعُ الأَحياءَ مِنّا أَجمَعينْ",2,"ن",1,0],["همدان أهلٌ للجميلِ وعِندهم","غَوْثُ الصَّريخِ ونَجدةٌ ما تكذبُ",3,"ب",1,0],["هُمُ دَخَلوا بابَ القَبولِ بِقَرعِهِم","وَحَسبِيَ أَن أَبقى لِسِنِّيَ قارِعا",4,"ع",2,0],["همدتْ عزائُمهم فلو شبَّت لظى","لتثيرَها فيهم فليس تُثارُ",5,"ر",1,0],["همدَ الهواءُ بها فجهدُ حَراكهِ","هَبَواتُ نارٍ في نفيثِ قَتامِ",6,"م",1,0],["هُمْ دُعَاةُ الفَلاَحِ فِي ذلِكَ","العَصْرِ وَأَهْلُ العُمْرَانِ فِي الأَمْصَارِ",7,"ر",1,0],["هم دنَّسوا بشهِيقهِم وزفيرِهِم","جوَّ الكنانة، وهْو مثلُ البَلْسَم",8,"م",1,0],["همدت ثورة الشهيد وقرّت","يا دويّا مجلجلا في الهمود",9,"د",1,0],["هم دون ذا لا عددت اسماؤهم","قدرُ البعوض اقلُّ من أن يوزنا",10,"ن",2,0],["هُم داءُ قَلبي وَأَنتَ أَقدَرُ أَن","إِمسي وَصَدري الحَرّانُ مَثلوجُ",11,"ج",1,0],["هُمْ دَوْحَةُ الشَّرَفِ العِدِّ التِي جَعَلَت","تَطُولُ عَن طُولِهَا المُفْتَنِّ أَفْنَانا",12,"ن",2,0],["هُمُ دَحُّوكَ لِلوَرِكَين دَماً","وَلَو سَأَلوا لأَعطَيت البُروكا",13,"ك",2,0],["هم دَمىِ من بهم أعُّز ومنهم","يُستُّمد الإلهام والإيمان",14,"ن",1,0],["هم دبَّروا الأرضَ فلم يُعيِهِمُ","بثقلها تدبيرُها ولم يَؤُدْ",15,"د",1,0],["هَمَدَ الفَضْلُ ثُمَّ أنْشَرَ موْتاهُ","أبو جعفرٍ ربيبُ المَعالي",16,"ل",2,0],["همدتْ نضارتهُ وأشْعَب هَمُّهُ","فغَدا يَعُجُّ عَجيج نِضْوٍ مُثْقَل",17,"ل",1,0],["هم داهمتهم صعاليك صقلية","شأن اللصوص تفاجي دون إعلام",18,"م",1,0],["هم دوننا في منعة","هم فوقنا في المنصب",19,"ب",1,0],["همدَتْ مرابعُه فليس به سوى","مَغنى عليٍّ روضةٌ تتأرّجُ",20,"ج",1,0],["هُمُ دعموا قِبابَ المجد فينا","ولولاهمْ لكان بلا دِعامَهْ",21,"م",2,0],["هُم دُونَنا أَهل الفَخار وَلَم يَكُن","عُلو أَب في حطة الوَلَد يَشفَع",22,"ع",1,0],["هُم دَوَّنوا السُنَنَ الكِرامَ فَنَوَّعوا","أَبوابها لِلطالِبينَ وَقَسَمّوا",23,"م",3,0],["هم دوّخوا قممَ الممالكِ فاغتدت","منقادةً ولغيرِهم لم تَنقدِ",24,"د",1,0],["همُ دوائي ودائِي في محبتهم","همُ حياتي وألبابُ العقولِ هُمُ",25,"م",1,0],["هَمدانُ خَيرُ سوقَةٍ وَأَقيال","لَيسَ لَها في العالَمينَ أَمثال",26,"ل",1,1],["هُم دوّخُّوا عُربَ المُلوكِ وعُجْمها","وفازوا بملْك الأرض شرقاً ومغرباً",27,"ب",2,0],["هُمُ دَوّخوا الأملاك قِدْمَاً وثَبّتوا","عمادَ العلى بالبيض والسُّمر والجُردِ",28,"د",1,0],["هم دمّروا التثليث بالعزم الذي","بمضائه قد أيّد التوحيد",29,"د",1,0],["هم دعاة الحق في آثارهم","قد سعى من قال بالحق صوابا",30,"ب",2,0],["هم دساتي وَأَنا العَبدُ المحب وَلَو","لَم يَرتضوا تَرَحي ما لذَّ لي الفرح",31,"ح",1,0],["همُ دُعج ونسل أبيك زُرق","كأنَّ عيونَهم فلقُ الزجاج",32,"ج",1,0],["هَمَدوا كَما هَمَدَت ثَمود وَقادَهم","لِخسارِهم مِمّا أَتوه قدارُ",33,"ر",1,0],["هَمِدِّي الرَّوعَ كُلَّما اشتَدَّ إِنّي","مُشفِقٌ أَن يَسُومَكِ استِذلالا",34,"ل",2,0],["هُم دَوحة الفَضل ما اشهى ثِمارهُم","سَقياً وَرعياً لِمَن في ظلهم رتعوا",35,"ع",3,0],["هم دوخوا مدنَ الملوك وطوعوا","أبطالها من حاضر أو باد",36,"د",1,0],["همدت قوافينا واقوت سبة","فشببتها ورفعت اس منارها",37,"ر",3,0],["هُمُ دوحة المجد الأثيل محمد","وغر ذويه آل غر المناقب",38,"ب",1,0],["هم درارٍ من أفقه مذ أضاءت","عمَّ منها أفق السما لألاء",39,"ا",2,0],["هم درجوا خير الدروج وخلفوا","مكارمهم إرثاً لأبيض زاهر",40,"ر",1,0],["هم دموعٌ وسحّها ملءُ قلبي","في مآقيه مجرمٌ وظلومُ",41,"م",1,0],["هم دمروا سلفا من كان ذا أمل","بالنصر لو رُفعت رمْح وقرآنُ",42,"ن",1,0]]}