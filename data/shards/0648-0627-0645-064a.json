","https://www.poetsgate.com/ViewPoem.aspx?id=176409",""],[5092,"حبٌ يورقُ في الفراغ","https://www.poetsgate.com/ViewPoem.aspx?id=175329",""],[5186,"هون عليك ولا تضق صدرا","https://www.poetsgate.com/ViewPoem.aspx?id=156443",""],[5199,"قبيلة (بنى رشيد) عبس","https://www.poetsgate.com/ViewPoem.aspx?id=146780",""],[2365,"أدرك الدّهر الذي طلبا","https://www.poetsgate.com/ViewPoem.aspx?id=200641",""],[5363,"رسالة إلى طبل","https://www.poetsgate.com/ViewPoem.aspx?id=199949",""],[5387,"وقفة مع الذات","https://www.poetsgate.com/ViewPoem.aspx?id=53778",""],[5409,"فقد الناس فيك ثبتاً إماماً","https://www.poetsgate.com/ViewPoem.aspx?id=155481",""],[5465,"وأميرٍ من بني جمح","https://www.poetsgate.com/ViewPoem.aspx?id=98428",""],[5465,"أمستْ أمية قد أظلَ فَناؤها","https://www.poetsgate.com/ViewPoem.aspx?id=98425",""],[5533,"حِقْدُ المَجُوس","https://www.poetsgate.com/ViewPoem.aspx?id=176589",""],[5596,"تحت قدمي والدتي","https://www.poetsgate.com/ViewPoem.aspx?id=206782",""],[5691,"تناقضات","https://www.poetsgate.com/ViewPoem.aspx?id=206156",""],[5837,"كسر الزجاج","https://www.poetsgate.com/ViewPoem.aspx?id=191880",""],[289,"قالَ لي الناسُ زرْ سعيدَ بنَ سلمٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22130&r=&rc=9",""]],"verses":[["وأُميلُ مِنْ طَرَبٍ إلَيهِ مَسامِعاً","يَشكو لَجاجَتَها إليَّ اللُّوَّمُ",0,"م",1,0],["وأمِيلُ عنْ ظِلِّ الأراكَةِ ضاحِياً","ورِواقُها رَحْبُ الجَنابِ مَديدُ",1,"د",1,0],["وَأَميلُ مِن طَرَبٍ إِذا مالَت بِهِم","فَاِعجَب لِنَشوانِ الجَوانِحِ صاحي",2,"ح",2,0],["وَأَمِّيَ صَعباتِ الأُمورِ أَروضُها","وَقَد أَمكَنَتني يَومَ ذاكَ ذَلولُها",3,"ل",3,0],["وَ إِمِيلُ زَيْنُ الشَّبَابِ إِذَا","مَا ازْدَهَى مَوْطِنٌ بِشُبَّانِ",4,"ن",1,0],["وَأَمينٍ حَديثُهُ سِرُّ نَفسي","فَوَعاهُ حِفظَ الأَمينِ الأَمينا",5,"ن",2,0],["وامينة ابكت عيون شهودها","وامينة هي بالعواطف اعرف",6,"ف",1,0],["وأميري في غد ساعده","ومن الأشبال لليث معين",7,"ن",1,0],["وأمية راياتها مرفوعة","وجيادها موصولة بجياد",8,"د",1,0],["وَأَمَّ يَدِبُّ دَبيبَ الكَرى","وَيَمشي الضَراءَ بِذاكَ الحَرَم",9,"م",1,0],["وَأَمى الغُرابُ يَضرِبُ الأَرضَ كُلَّها","عَتيقاً وَأَضحى الديكُ في القِدِ عانِيا",10,"ي",2,0],["وأُمَيّةٌ تُحفْي السّؤالَ وما لِمَنْ","أودى به الطُّوفانُ يذكرُ نُوحا",11,"ح",2,0],["وَأَميرٌ سادَةُ الناسِ لَهُ","خَوَلٌ يَنفُذُ فيهِم ما أَمَر",12,"ر",1,0],["وَأَميلُ في أُنسِ النَدي","مِ مِنَ الحَياءِ وَما اِشتَهَيتُه",13,"ت",2,0],["وَأَميرِ خَيلٍ قَد عَصَيتُ بِنَهدَةٍ","جَرداءَ خاظِيَةِ السَراةِ جَلوسِ",14,"س",1,0],["وَأميراً بِهَواهُ","قاهِراً كُلّ أميرْ",15,"ر",1,0],["وام يبق عند الدهر خطب أخافه","فكيف اعتذار الدّهر إن رحت شاكيا",16,"ي",2,0],["وام يحسدون الناس فيها رقائق","كشفن قناع المشكلات لسائل",17,"ل",1,0],["وأمير جيش الصالحين وصاحب ال","متين الهيكل الصمداني",18,"ن",2,0],["وأمينٌ على خزائنه طرا","وراعيه سيد الرعيان",19,"ن",1,0],["وَأَميلُ طَوعَ نَوائِبٍ لَم يَستَطِع","عَضُّ الثِقافِ لِمَيلِها تَقويما",20,"م",2,0],["وَأَميطي عن الحَقيقَة ما يَح","جبُ عَنّا جَمالَها من شُكوكِ",21,"ك",1,0],["وأُمِّيَ الْبَرّةُ البَتولُ ومَنْ","كُلُّ نِساءِ الورى لَها خَوَل",22,"ل",1,0],["وأُمّي تُقبِّلُ خدِّي وشَعري","وتحنُو عليَّ وتذرفُ دَمعا",23,"ع",2,0],["وَأَميري فَتى خُزاعَةَ بِالبَصرَةِ","قَد عَمَّها سَماحاً وَجودا",24,"د",2,0],["وأميت الحياة في قلبي الح","ي وأرثيه قبل حين الرثاء",25,"ا",2,0],["وَأمين المَجد واهبه","ذو المَعالي سَيّد النجبا",26,"ب",2,0],["وأميرُ المؤمنين اختَصَّه","من بنى الدّهرِ بقُرْبٍ واجتِباء",27,"ا",2,0],["وَأَميرُ الملاح يَأتيهِ عزلٌ","حينَ تَلَقّاهُ لابِساً لِلسّوادِ",28,"د",1,0],["وأميناً كُنْ إذا ما لامني","إنَّ في أُذني عن اللّوّام وقرا",29,"ر",2,0],["وأمير ذو إياد","من نداها جاد قطر",30,"ر",1,0],["وأمين المجد فيه","من أبيه لاح سر",30,"ر",1,0],["وأمين العلياء أحسن شهم","قد تبدى به الهناء الوفيرُ",31,"ر",1,0],["وأميرٍ كلما أكرمتُه","قصدَ الهون فجازاني بهْ",32,"ب",2,1],["وأميرٍ ممنطقٍ بنداما","ه وكأس الطِّلا لديهم مُداره",33,"ر",2,0],["وأُمٍّ يفوزُ بإعلانها","بنوها ويُدْهَوْنَ من سرِّها",34,"ر",3,1],["وأمير قومٍ لا يسرُّ أخاً","في خلوةٍ منهُ ولا حفلِ",35,"ل",1,1],["وأميرٍ وحقيرٍ","وظُهوريٍّ وخاملْ",36,"ل",1,0],["وأميركا تدعمه جهر","وتمدُّ النار ببنزينِ",37,"ن",1,0],["وأميرنا ذاك الهمام أبو الندى","والمنتمي شرفاً لأكرم محتد",38,"د",1,0],["وأميرٌ على الجيوش وإن أب","صَرتَه وهو كاتبٌ ومِشَدُّ",39,"د",1,0],["وأمينَ اللهِ والوا","رثَ علمَ الأوّلينا",40,"ن",2,0],["وأمين الإله في الأرض بعداً","لسبط أضحى مقيداً مستضاما",41,"م",2,0],["وَأَمير اللوا رَأى الأَمر صَعباً","فَاِشتَكى لِلعَزيز ما قَد دَهاه",42,"ا",2,0],["وَأَمير اللوا تَخلَّص مِمّا","كانَ فيهِ مِن بُؤسه وَشقاه",42,"ا",2,0],["وَأَميراً رَأيُه يَهدي إِلى","كُل ما فيهِ صَلاحٌ للدّيار",43,"ر",1,0],["وأميل نحو محدثي لحديثه","فكأنه ماء وفي غليل",44,"ل",1,0],["وامير الكلام فينا أمير الحج","مخدومنا الامير الكبير",45,"ر",1,0],["وَأَميرٍ مفردٍ في كلِّ جيل","يَتَحاشى عَن نَظيرٍ وَشَبيه",46,"ه",1,0],["وأميرها الشهم الهمام محمد","حسن اللقاء مبارك الطلعاتِ",47,"ت",1,0],["وأمير حمير وارد بجنوده","حرباً كأسعد ذي الجيوش الكاملِ",48,"ل",1,0],["وأميرها الوالي سليمان","الفتى الحامي الذمارْ",49,"ر",1,0],["وأمير الكماة والكبش فيهم","ومجير من كل خطب مخوف",50,"ف",1,0],["وأمين الدين من ضعفت","منتي عن حمل منتهِ",51,"ت",2,0],["وَامَيْلَ أعْطَافِ مُضْنَاهُ لِمَعْطِفِهِ","شَوْقاً وَوَا ظَمَأ الأحْشَا لِرِيقَتِهِ",52,"ت",2,0],["وأميط برقعها وألثم خالها","وأقول ويل للشجي من الخلي",53,"ل",2,0],["وأميل أعناق المطي موجها","لمخيم الإحسان والحسن الجلي",53,"ل",2,0],["وأم يجنف أملاك السما شرقا","لجانب لحناب المالك اهتضما",54,"م",2,0],["وَأميمُ تَلقاني بحسنِ خلائقٍ","في اللينِ تَحكي الرملة الميعاسا",55,"س",2,0],["وَأَمينُها المَأمونُ عَضبُ سَمائِها","عَلَمٌ أَنافَ عَلى الهِضابِ سَناما",56,"م",2,0],["وَأمَيَّةَ البَحرَ الَّذِى فِى شِعرِهِ","حِكمٌ كَوَحىٍ فِى الزَّبُورِ مُفَصَّلِ",57,"ل",1,0],["وأميرنا أثر الثواب به فقل","في نظم تاريخي عظيمٌ أجرُهُ",58,"ه",1,0],["وأمين على الشريعةِ آلَى","قَدْرَ ما اسْتطاعَ أن يقيها السِّهاما",59,"م",2,0],["وأميني سري عليها واني","صرت فيها كالعالم المفقود",60,"د",1,0],["وأميناً كاظماً إن أغضبا","وجواداً جعفراً كلاًّ هُماما",61,"م",2,0],["وأمينٍ ذي النهى مَن لم يزل","سالكاً نهجاً من التقوى قويما",62,"م",2,0],["وأمين التقى وهل ضمَّ مثلاً","لأمينٍ في عصرنا المشرقان",63,"ن",1,0],["وأمية كانت ولكن رأيها","لدى معضلات المر فوق ذوي العلم",64,"م",1,0],["وَأَمينٍ عَلى عُهودِ التَصابي","وَعَبيثٍ بِالوُدِّ غَيرِ أَمينِ",65,"ن",1,0],["وأمِيطُ عِندَ المِشعَرَينش كِلَيهِمَا","شَعرِي وَمِيطَ عن القُلُوبِ هُمُومُهَا",66,"م",3,0],["وأمين اللَه جبريل به","في السما يَطوي من اللَيل الحلل",67,"ل",1,0],["وأمي بالجكارة حين أبكي","تزغرط من بهذا قد أشارا",68,"ر",2,0],["وأميرها وجد الحياةَ ذميمةً","فاختار عندَ اليأسِ قطع حبالها",69,"ل",3,0],["وأمين على الودائع والسر","ر إذا ما هويت أن تأتمني",70,"ن",2,0],["وأميِّ التي ما زلتُ أذكرها لكم","من النفس العالي النزيه المكمل",71,"ل",1,0],["وامين شرع محمد","وَلنعم محتفظ الودايع",72,"ع",1,0],["وأمير المؤمنين به","نؤثر الأخبار والكتبا",73,"ب",2,0],["وأميرٍ إذا أرادَ طَعاما","قالَ غِلمانُهُ أتى الحَمَّاما",74,"م",2,1],["واميل بعد مماتها قد عاف ورد","الماء واتخذ المدامع موردا",75,"د",2,0],["وأمّ يوسف والدنيا له تبع","ولم يقم عند رسم للوفاء عفا",76,"ف",2,1],["وَأُمَيَّةُ الكَذّابُ قالَ مَقالَةً","كانَت مُنىً مِنهُ وَما تُعني المُنى",77,"ا",1,0],["وأمير الورى المليك عليهم","وأمير المليك ذو التدريس",78,"س",1,0],["وأميل للإخلاص حتى للأسى","وأعاف رغد العيش غير لزام",79,"م",1,0],["وأمير حسنٍ بات تحجبه","ملد المعاطف لا القنا الملد",80,"د",1,0],["وأميرٍ رام أن أمدحه","قلت أحتاجُ لمن يمدحني",81,"ي",1,1],["وأمي بالنجوم إليك حتى","تفرّى الليل عن وضح النهار",82,"ر",1,0],["وأمير من شأنه كل رفق","شمل العفو منه غير الظلوم",83,"م",1,0],["وأميراً على البرايا تولى","يا سراجاً بكل برجٍ تجلى",84,"ل",2,0],["وَأُمّي قَينَةٌ إِن لَم تَرَوني","بِعَورَشَ تَحتَ عَرعَرِها الطِوالِ",85,"ل",1,0],["وأَميطِي قَذاءَ عينيك من بَيْ","نِ زواياهُ تُدرِكيه رُكاما",86,"م",2,0],["وَأَميرٌ أَعجَمِيٌّ","كَحِمارِ اِبنِ حِمارَه",87,"ر",2,0],["وأمين وحي الله موضع سره","يمسي بهاتيك السجون ينقل",88,"ل",1,0],["وامين وحي الله طه لم يدع","أبداً إلى متعللٍ من علة",89,"ه",1,0],["وأمير قد عاد غير أمير","وعميد قد صار غير عميد",90,"د",1,0],["وأميت النفس في طي الخفاء","فهي تحيا كالرفات الملحد",91,"د",1,0],["وأمير حسن ناظري والقلب من","أعوانه أبداً علي وجنده",92,"د",2,0],["وأمين النبي في كل سرّ","كان للمخبر الإلهي أهلا",93,"ل",2,0],["وأمي من الخالدات العظام","وما كل ذا ليقيني الحمام",94,"م",1,0],["وأمير حضرة رقة وخلاعة","تسعى لطاعة أمره الأدباء",95,"ا",2,0],["وأمير جيش أمره","يحكي القضاء المنزلا",96,"ل",2,0],["وأمير كل المؤمنين أمامهم","نعم الإمام وهكذا الأمراء",97,"ا",2,0],["وَأَمينُ مَجلسِهِ وَغَرسُ نَباتِهِ","وَيَمينُهُ وَحُسامُهُ المَسنون",98,"ن",1,0],["وَأَميرُ المُؤمِنينَ المُرَجّي","فَضلَهُ مُثريهِمُ وَالمُقِلُّ",99,"ل",1,0],["وأَمينُ سرِّ مقام حضرته إذا","ناجى النصيحة مخلصاً فهو النَّج",100,"ج",1,0],["وَأَميري قَد بَرى جِس","مِي حذاراً أَن يَخونا",101,"ن",2,0],["وَأَميراً عَلى الظِّبا","ءِ بِما نيطَ خَلفَهُ",102,"ف",2,0],["وَأَميناً عَلى الهَوى دُونَ ما يَط","ويهِ تَعيا الوشاةُ وَالسِرُّ باقِ",103,"ق",1,0],["وأميزُ في جسمي وطاقةِ شعرهِ","فَأصيبهُ منها أدَقُّ وأضعَفا",104,"ف",2,0],["وأميطُ عن ودي لثامَ تشوّق","يغشى سويد القلبِ منهُ برقعُ",105,"ع",1,0],["وأمي رأتني بجسمٍ نحيلٍ","وقالت صغيري كنجمٍ هوى",106,"و",2,1],["و(أمينُ) ليس (كحاتمٍ) كلَّا ولا","أمرُ البلادِ مشاهدَ التصويرِ",107,"ر",1,0],["وأُمِّي وما رَأيُهُ عِندَها","سِوى حَرفِ جَرٍّ لِمَجرُورِهِ",108,"ر",2,0],["وأميلي رأسَكِ العالي عسى","يرتوي اليبسُ بفرط البلل",109,"ل",1,0],["وأمي ربيع الوقت الاغبر وريفه","لامن نشد عن كايد الجرح بلسم",110,"م",1,0],["وأميرةٌ الشوقِ التي في عينها","موجُ الصبابةِ هائجٌ يتدفّقُ",111,"ق",1,0],["وأميركا جاءت تخبرنا","ما لم نحط بعجابه خبرا",112,"ر",2,0],["وامين سر المصطفى لالنامى","ابن اليمان حذيفه ولاابها لبس",113,"س",1,0],["وأمير المؤمنين به","نأثر الأخبار والكتبا",114,"ب",2,0],["وأميل بالأشجان نحو أئمتي","وأقلّبُ الصفحاتِ من كرّاسي",115,"س",2,0],["وأمي عذبة الإشراق باسمةٌ","تداعب شعري المنكوش في رأسي",116,"س",2,0],["وأمين على الشريعة آلى","قدر ما اسطاع أن يقيها السهاما",117,"م",2,0],["وأميرٍ من بني جمح","طيب الأعراق ممتدح",118,"ح",1,1],["وأمية الكف المصرد نيلها","وأمية القول البعيد وفاؤها",119,"ا",3,0],["وأمية القدم المقدم شرّها","وأمية القدم المقصر شأوها",119,"ا",1,0],["وأُميَّةٌ أَجْدَادُنا سادُوا الدُّنَى","وبآلِ عَبَّاسٍ جَمِيعاً نَقْتدي",120,"د",2,0],["وأميرة لأمير سحر بيانه","ما بين ختم رويّه والمطلع",121,"ع",1,0],["وأميرٍ تَراهُ بالجُبْنِ قِزْماً","وخَفيرٍ تَراهُ بالعَزْمِ قِرْما",122,"م",2,0],["وأميل للعزلة ولا لي بالمخاليق احتياج","والعظم عفته يوم شفت إنّه كثر عرّاشته",123,"ت",2,0],["وأميري فتى خزاعة َ بالصرة ِ","قد عمها سماحاً وجودا",124,"د",2,0]]}