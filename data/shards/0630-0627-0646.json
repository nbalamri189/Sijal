{"poems":[[53,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[53,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[443,"أجل قد تمادى الأمر وانصرم العمر","https://www.aldiwan.net/poem2542.html","الطويل"],[463,"لو حملت عتبي الليالي","https://www.aldiwan.net/poem56006.html","مخلع البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38155","البسيط"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102663","الرجز"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102571","الرمل"],[3080,"","https://poetry.dctabudhabi.ae/diwan/poem/96129","الرجز"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139905","الدوبيت"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85221","الكامل"],[3830,"","https://poetry.dctabudhabi.ae/diwan/poem/122300","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119615","السريع"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139726",""],[4858,"قلبٌ بين نارَين","https://www.poetsgate.com/ViewPoem.aspx?id=138782",""],[4935,"حسن المطالع في صفاء براعة","https://www.poetsgate.com/ViewPoem.aspx?id=129288",""],[5121,"سحر الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=36283",""],[5186,"تالله ما أنا واقف في الباب","https://www.poetsgate.com/ViewPoem.aspx?id=156550",""],[5762,"إقرأ كتابك","https://www.poetsgate.com/ViewPoem.aspx?id=13131",""],[5861,"لكم الحسنى آل البيت","https://www.poetsgate.com/ViewPoem.aspx?id=191772",""],[159,"ِذا نَظَرَتْ نَحْوَنا جَرَّدَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=6898",""],[463,"أما والنقا لولا هوى ظيبة َ النقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60160&r=&rc=216",""]],"verses":[["ذا نوالٍ مُيمَّمٍ نَعْتفيه","في طريقٍ مُذَلَّل مُرتاض",0,"ض",1,0],["ذانِكَ الحسنُ والجمالُ حقيقا","نِ بكُنه الإحسان والإجمالِ",1,"ل",1,0],["ذا نعمة منكم أتتني فإنّني","حقيق بها أهل وعادتك البر",2,"ر",1,0],["ذا نعمة لا أخاف فيها","عليك إلا من الكمال",3,"ل",1,0],["ذا نِعمَةٍ عَظُمَت مَنَّ الكريمُ بِها","فَحَقَّ مِنَّا لَهُ شُكرٌ وَتَحميدُ",4,"د",1,0],["ذا نصه غزالي المعاني","محمد بن محمد بن حامد",5,"د",1,0],["ذا نسيم القرب نسنس","وشفا سقم المحبين",6,"ن",1,1],["ذا نهجة في المصمئلات الكبر","أبذي اذاً بوذيت من كلب ذكر",7,"ر",1,0],["ذا نازل كمثل ظبي","يشقي بلحظه المنازل",8,"ل",1,0],["ذانور نور الشمس ذا قمر ال","أقمار ذا مستودع الأمر",9,"ر",1,0],["ذا نجل شهم فاضل","محمد الشطي الودود",10,"د",1,0],["ذا نجدة غوث صريخ أخا ال","جودة حسانا وحسانا",11,"ن",2,0],["ذا نفَسُ الرحمن في تاريخه","فاه لسلمان بفضلٍ أجملِ",12,"ل",1,0],["ذانِ الجناحانِ ،فاجمع ،ربِّ، شملَهما","في ظلّ أمنٍ وعيشِ طاب مُنقلَبا",13,"ب",2,0],["ذا نعمة المولى هديته لنا","والعروة الوثقى لأقوم سنة",14,"ه",1,0],["ذَا نَشِيِدٌ بِهِ الطُّيُورُ اسْتَرَاحَتْ","فاسْتَفَاقَ الْهَوَى لَهُ وَالْغِنَاءُ",15,"ا",2,0],["ذا نائب، وكفى نيابة مجلس","في الخلط يدعى مجلس النواب",16,"ب",1,0],["ذا (نوفمبرُ).. قمْ وحيّ المِدفعا","واذكرْ جهادَكَ.. والسنينَ الأربعا!",17,"ع",2,1],["ذا نهجُكُمْ سرْنا بهِ وحسينُ يبقى..","في نفوسِ المؤمنينَ يجاهدُ",18,"د",1,0],["ِذا نَظَرَتْ نَحْوَنا جَرَّدَتْ","سُيُوفَ الهَوى بِأَكُفِّ المَنْونِ",19,"ن",1,1],["ذا ناهزَ الضيفُ البيوتَ تبادروا","لهُ فاستوفوا فيهِ غنيّاً ومخفقا",20,"ق",2,0]]}