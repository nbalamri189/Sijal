{"poems":[[73,"أفدتني من نفائس الدرر","https://www.aldiwan.net/poem11981.html","المنسرح"],[10,"كل امرئ بأثافي الدهر مرجوم","https://www.aldiwan.net/poem21132.html","البسيط"],[27,"حي الهدملة والأنقاء والجردا","https://www.aldiwan.net/poem5730.html","البسيط"],[27,"بان الخليط برامتين فودعوا","https://www.aldiwan.net/poem5799.html","الكامل"],[51,"أمسى الشباب رداء عنك مستلبا","https://www.aldiwan.net/poem8649.html","البسيط"],[29,"بانت سعاد ففي العينين تسهيد","https://www.aldiwan.net/poem6030.html","البسيط"],[91,"قل للحمائم في ضفاف الوادي","https://www.aldiwan.net/poem8798.html","عموديه"],[70,"ركد الرجاء فما يهزك مأرب","https://www.aldiwan.net/poem43107.html","الكامل"],[85,"بين الملامة فيكم والهوى الجلل","https://www.aldiwan.net/poem6819.html","البسيط"],[85,"هو مأتم الأخلاق فاتل رثاءها","https://www.aldiwan.net/poem7109.html","الكامل"],[85,"دع ما يضرك والتمس ما ينفع","https://www.aldiwan.net/poem7127.html","الكامل"],[85,"أوحت لطرفك فاستهل شؤونا","https://www.aldiwan.net/poem8112.html","الكامل"],[85,"قم للمعلم وفه التبجيلا","https://www.aldiwan.net/poem15422.html","الكامل"],[85,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[85,"اجعل رثاءك للرجال جزاء","https://www.aldiwan.net/poem62936.html","الكامل"],[85,"سر يا صليب الرفق في ساح الوغى","https://www.aldiwan.net/poem63731.html","الطويل"],[85,"أقدم فليس على الإقدام ممتنع","https://www.aldiwan.net/poem63762.html","البسيط"],[28,"نظر الدلهمس نظرة ما ردها","https://www.aldiwan.net/poem5252.html","الكامل"],[49,"إن الفناء من البقاء قريب","https://www.aldiwan.net/poem10333.html","الكامل"],[66,"من نفخة الصور أم من نفحة الصور","https://www.aldiwan.net/poem41361.html","البسيط"],[80,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[80,"ملك جديد مثل طبع المنصل","https://www.aldiwan.net/poem31324.html","الكامل"],[80,"وأشم من بيت الرئاسة أكبر","https://www.aldiwan.net/poem31446.html","الكامل"],[44,"قولا لإبراهيم والفضل الذي","https://www.aldiwan.net/poem30402.html","الكامل"],[31,"هل تعرف اليوم رسم الدار والطللا","https://www.aldiwan.net/poem41847.html","البسيط"],[33,"إن الغواني قتلت عشاقها","https://www.aldiwan.net/poem25856.html","الكامل"],[105,"من كان يؤثر أن يجيب فقد دعا","https://www.aldiwan.net/poem43048.html","الكامل"],[105,"هفت العروش وزلزلت زلزالا","https://www.aldiwan.net/poem43155.html","الكامل"],[105,"ديار مكة هذا خالد دلفا","https://www.aldiwan.net/poem44044.html","الكامل"],[40,"قد رابه ولمثل ذلك رابه","https://www.aldiwan.net/poem42339.html","الكامل"],[52,"قل لمشيبي إذ بدا","https://www.aldiwan.net/poem26784.html","مجزوء الرجز"],[46,"أكفئ سوامك في الدنيا مياسرة","https://www.aldiwan.net/poem21998.html","البسيط"],[46,"مر الزمان فأضحى في الثرى جسد","https://www.aldiwan.net/poem22210.html","البسيط"],[46,"يا أيها المغرور لب من الحجى","https://www.aldiwan.net/poem22367.html","الكامل"],[46,"إن كنت ذارع أرض لم ألمك بها","https://www.aldiwan.net/poem23104.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85546","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85334","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85527","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85572","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54639","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54772","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54198","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54196","الكامل"],[106,"أسماؤهم رتب","https://www.poetsgate.com/ViewPoem.aspx?id=179697",""],[106,"من وحي الكأس","https://www.poetsgate.com/ViewPoem.aspx?id=179738",""],[106,"صوت الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179642",""],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[90,"تحرك اللحد !","https://www.poetsgate.com/ViewPoem.aspx?id=179160",""],[90,"إلى الشباب السوري","https://www.poetsgate.com/ViewPoem.aspx?id=179164",""],[33,"إن الغواني قتلت عشاقها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14074&r=&rc=10",""],[115,"مهفهف هيمني","https://www.aldiwan.net/poem40606.html","عموديه"],[119,"إن الشدائد قد تغشى الكريم لأن","https://www.aldiwan.net/poem4359.html","البسيط"],[120,"أبليت فيك العمر وهو جديد","https://www.aldiwan.net/poem49351.html","الكامل"],[128,"أوصيكمو يا أيها العقلاء","https://www.aldiwan.net/poem50680.html","الكامل"],[132,"أني على هيمى مى تلحاني","https://www.aldiwan.net/poem54712.html","البسيط"],[142,"إحدى الكواعب من بنى نصر","https://www.aldiwan.net/poem58404.html","أحذ الكامل"],[160,"لي منكم يا كهف الملوك والدول","https://www.aldiwan.net/poem58757.html","الرجز"],[160,"ما في شجاعة ذى السخا من شك","https://www.aldiwan.net/poem58845.html","الكامل"],[160,"قد صرت منا واحدا يا جعفر","https://www.aldiwan.net/poem59018.html","الكامل"],[160,"من قلد العلما واقدم أعذرا","https://www.aldiwan.net/poem59178.html","الكامل"],[164,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[185,"من حط أثقال الغرا","https://www.aldiwan.net/poem14143.html","مجزوء الكامل"],[197,"حي الأساتذة الكرام تحية","https://www.aldiwan.net/poem39949.html","الكامل"],[223,"أشعة من مقلتيك ملهبه","https://www.aldiwan.net/poem39698.html","الرجز"],[223,"في ذمة الماضي انطوت","https://www.aldiwan.net/poem41918.html","مجزوء الكامل"],[237,"إن الشمائل أزهار وأنوار","https://www.aldiwan.net/poem18809.html","البسيط"],[261,"أكناس ريم أم عرين غضنفر","https://www.aldiwan.net/poem38278.html","الكامل"],[270,"يا مي أفنى مهجتي التعليل","https://www.aldiwan.net/poem35580.html","الكامل"],[270,"أنت المقيل المرتجى يا هتلر","https://www.aldiwan.net/poem35585.html","الكامل"],[270,"أبدا أرى والغدر طبع فيك","https://www.aldiwan.net/poem35643.html","الكامل"],[298,"هل في البكاء على ما فات من حرج","https://www.aldiwan.net/poem36286.html","عموديه"],[298,"ماذا عليه إذا عصاه لسانه","https://www.aldiwan.net/poem36821.html","عموديه"],[322,"بان السفاء وأودى الجهل والسرف","https://www.aldiwan.net/poem56340.html","البسيط"],[366,"هذا غريمي في الغرام","https://www.aldiwan.net/poem17097.html","مجزوء الكامل"],[366,"إن الشجاعة وهي من أوصافه","https://www.aldiwan.net/poem17145.html","الكامل"],[366,"ليس الشجاعة في مصافحة الفتى","https://www.aldiwan.net/poem17771.html","الكامل"],[393,"لاح لعينيك الطلل","https://www.aldiwan.net/poem53681.html","مجزوء الرجز"],[402,"حتام عن جهل تلوم","https://www.aldiwan.net/poem46981.html","مجزوء الكامل"],[416,"يا قدوة العلماء يا من علمه","https://www.aldiwan.net/poem53857.html","الكامل"],[416,"عاد الفؤاد من الجوى ما عادا","https://www.aldiwan.net/poem54072.html","الكامل"],[416,"طهر فؤادك بالراحات تطهيرا","https://www.aldiwan.net/poem54094.html","البسيط"],[416,"حييت من قادم حل السرور به","https://www.aldiwan.net/poem54138.html","البسيط"],[416,"هاج القرام وهيجا بلبالي","https://www.aldiwan.net/poem54163.html","الكامل"],[453,"يا قاصدا مصر في زهو وفي جذل","https://www.aldiwan.net/poem61255.html","البسيط"],[453,"رمضان يا حلو الشمائل","https://www.aldiwan.net/poem61335.html","مجزوء الكامل"],[461,"لا تشمتن بمن أسا وهوى","https://www.aldiwan.net/poem16071.html","أحذ الكامل"],[464,"أركض جياد الصبي في حلبة اللعب","https://www.aldiwan.net/poem3615.html","عموديه"],[470,"أمسى شبابك عنا الغض قد حسرا","https://www.aldiwan.net/poem4685.html","البسيط"],[470,"يا بيت عاتكة الذي أتعزل","https://www.aldiwan.net/poem4779.html","الكامل"],[479,"من للثكالى وللجرحى وأيتام","https://www.aldiwan.net/poem37205.html","البسيط"],[538,"ما لي أنادي يا عديل فؤادي","https://www.aldiwan.net/poem48211.html","عموديه"],[558,"إن قلت لم أقدر ولم أستطع","https://www.aldiwan.net/poem33824.html","السريع"],[558,"إنا فهمنا عنه أمثالا لنا","https://www.aldiwan.net/poem34234.html","الكامل"],[561,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"]],"verses":[["إِنَّ الشَفيعَ الهُمامَ سَوَّغَهُ اللَ","هُ اِتّصالَ التَأييدِ بِالظَفَرِ",0,"ر",1,0],["إِنَّ الشَجاةَ الَّتي حَدَّثتُمُ اِعتَرَضَت","خَلفَ اللَها لَم تُسَوِّغها البَلاعيمُ",1,"م",1,0],["إِنَّ الشِفاءَ الَّذي ضَنَّت بِنائِلِهِ","فَرعُ البَشامِ الَّذي تَجلو بِهِ البَرَدا",2,"د",2,0],["إِنَّ الشَواحِجَ بِالضُحى هَيَّجنَني","في دارِ زَينَبَ وَالحَمامُ الوُقَّعُ",3,"ع",1,0],["إن الشباب لمَألوفٌ لصُحْبَتِهِ","تلك القديمة مَبْكيٌّ إذا ذهبا",4,"ب",2,0],["إِنَّ الشَبابَ لَمَحمودٌ بَشاشَتُهُ","وَالشَيبُ مُنصَرَفٌ عَنهُ وَمَصدودُ",5,"د",1,0],["إِنَّ الشَبابَ هُوَ الغِنى فَإِذا مَضى","وَأَقَمتَ لا يَنفَكُّ فَقرَكَ بادي",6,"ي",1,0],["إِنَّ الشُعوبَ إِذا اِستَمَرَّ جُثومُها","جَثَمَ الرَدى مِن حَولِها يَتَرَقَّبُ",7,"ب",1,0],["إن الشعوب إذا ما أدبرت حبست","مالا عن البر أو علما عن العمل",8,"ل",1,0],["إن الشعوب كيانها حرية","تحيا عليها أو تموت فداءها",9,"ا",3,0],["إن الشعوب إذا أرادوا نهضة","بذرائع العلم الصحيح تذرّعوا",10,"ع",3,0],["إِنَّ الشِفاءَ مِنَ الحَياةِ وَعَونِها","ما كانَ آسَ بِالشِفاءِ ضَمينا",11,"ن",2,0],["إِنَّ الشَجاعَةَ في القُلوبِ كَثيرَةٌ","وَوَجَدتُ شُجعانَ العُقولِ قَليلا",12,"ل",2,0],["إِنَّ الشَمائِلَ إِن رَقَّت يَكادُ بِها","يُغرى الجَمادُ وَيُغرى كُلُّ ذي نَسَمِ",13,"م",1,0],["إِنَّ الشَبابَ يُحَبُّ جَمّاً حافِلاً","وَتُحَبُّ أَيّامُ الشَبابِ مِلاءَ",14,"ا",2,0],["إِنَّ الشُجاعَ هُوَ الجَبانُ عَنِ الأَذى","وَأَرى الجَريءَ عَلى الشُرورِ جَبانا",15,"ن",2,0],["إِنَّ الشَبابَ غَدٌ فَليَهدِهِم لِغَدٍ","وَلِلمَسالِكِ فيهِ الناصِحُ الوَرِعُ",16,"ع",1,0],["إِنَّ الشَبابَ لَرابِحٌ مَن باعَهُ","وَالشَيبُ لَيسَ لِبائِعيهِ تِجارُ",17,"ر",1,0],["إِنَّ الشَبابَ لَنافِقٌ عِندَ النِسا","ما لِلمَشيبِ مِنَ النِساءِ حَبيبُ",18,"ب",1,0],["إِنَّ الشَبابَ شَفيعٌ نَشرُ بُردَتِهِ","مِن عِطرِ دارينَ لا مِن عِطرِ فَنصورِ",19,"ر",1,0],["إن الشبيبةَ في كفَّيك عاريةٌ","فإن وجدت لها رَدّاً فلا جَرَما",20,"م",2,0],["إِنَّ الشريعةَ مِنهُ تُشْرِعُ عاملاً","من كلِّ باغٍ عامِلاً في المقتَلِ",21,"ل",1,0],["إنّ الشجاعةَ في الحُماة وإنها","لأشدّ منها في الأبيِّ الصابِرِ",22,"ر",1,0],["إِنَّ الشِتاءَ عَلى جَهامَةِ وَجهِهِ","لَهُوَ المُفيدُ طَلاقَةَ المُصطافِ",23,"ف",1,0],["إِنَّ الشَبابَ الَّذي كُنّا نَزُنُّ بِهِ","وَلّى وَلَم نَقضِ مِن لَذّاتِهِ أَمَلا",24,"ل",2,0],["إِنَّ الشِفاءَ عِناقُ كُلِّ خَريدَةٍ","كَالخَيزُرانَةِ لا نَمَلُّ عِناقَها",25,"ق",3,0],["إن الشُّعوبَ إذا استقام سبيلُها","أمِنَتْ غَداةَ الجِدّ كلَّ عِثارِ",26,"ر",1,0],["إِنَّ الشُعوبَ حَياتَها وَمَماتَها","بِيَدِ المُلوكِ هِدايَةً وَضَلالا",27,"ل",2,0],["إنّ الشريدَ الذي قد كان يظلمه","ذَوُو قَرَابتِهِ قد عادَ فانْتَصَفا",28,"ف",2,0],["إِنَّ الشَباب عَسا وَأَدبَرَ خَيرُهُ","فَمَتى تَقُولُ وَلاتَ حِينَ إِيابُهُ",29,"ب",2,0],["إِنَّ الشَبابَ خانَني","فَالرَأسُ مِنّي أَبلَقُ",30,"ق",1,0],["إِنَّ الشَبيبَةَ نارٌ إِن أَرَدتَ بِها","أَمراً فَبادِرهُ إِنَّ الدَهرَ مُطفِئُها",31,"ا",3,0],["إِنَّ الشَرائِعَ أَلقَت بَينَنا إَِحناً","وَأَودَعَتنا أَفانينَ العَداواتِ",32,"ت",1,0],["إِنَّ الشُرورَ لَكَالسَحابَةِ أَثجَمَت","لاكِ السُرورُ كَأَنَّهُ بَرقٌ خَلَب",33,"ب",1,0],["إِنَّ الشُمولَ رِياحٌ شَمأَلٌ عَصَفَت","بِاللُبِّ وَالسُكرُ غَيٌّ فادِحٌ شَمَلَك",34,"ك",1,0],["إن الشعوب إذا هاجَت عواطفها","كالبحر يضرب أمواجاً بأمواج",35,"ج",1,0],["إِنَّ الشعوب لتستحق تساوياً","لَولا اختلاف بينها وَفروق",36,"ق",1,0],["إن الشعر لم ينهض بآداب أُمة","إذاً خابَت الآمال في الشعر والظن",37,"ن",1,0],["إن الشرق بعد اليوم لم يرع نفسه","أَلمَّت به الجلّى وعاجله المحق",38,"ق",1,0],["إِنَّ الشَجاعَةَ في الرِجالِ غَلاظَةٌ","ما لَم تَزِنها رَأفَةٌ وَسَخاءُ",39,"ا",2,0],["إِنَّ الشُّيُوخَ إِذَا بَكَوْهُ فَرُزْءُهُ","أَبْكَى كُهُولاً بَعْدَهُ وَشَبَابَا",40,"ب",2,0],["إَنَّ الشَّجَاعَةَ وَالنَّصْرَ الْخَلِيقَ بِهَا","مَا يَفْعَلُ الْبَأْسُ لاَ مَا يَفْعَلُ الْعَدَدُ",41,"د",1,0],["إِنَّ الشَّبَابَ وَدِيعَةٌ مَرْدُودَةٌ","والزُّهْدُ فِيه تَزَمُّتُ النُّسَّاكِ",42,"ك",1,0],["إنَّ الشَّبَابَ رَحِيقُ أَزْهَارِ الرُّبا","وَحَفِيفُ غُصْنِ الْبَانَةِ الأُمْلُودِ",43,"د",1,0],["إِنَّ الشباب ومَا أُحَيْلَى عَهْدَه","كالواحَةِ الْخَضْرَاءِ في الصَّيْهُودِ",43,"د",1,0],["إنَّ الشَّجَاعَةَ أنْ تُنَاضِلَ مُصْحِراً","لاَ أن تَدِبَّ كَفَاتِكِ الأَصْلاَلِ",44,"ل",1,0],["إِنَّ الشُّعُوبَ تُصَابُ في أَبْطَالِها","وحَياتُها في سِيرَةِ الأبْطَالِ",44,"ل",1,0],["إن الشعوب إذا أدلت بحجَّتها","فأبلغَتْ، كان طهَ حُجَّةَ العرب",45,"ب",1,0],["إنَّ الشيوخ تقومَ الليلَ في حرمٍ","لكن عليٌّ يقوم الليل في «بار»",46,"ر",1,0],["إنّ الشبابَ تحضُّرٌ وتوثُّبٌ","ليس الشبابُ بلذَّةٍ ومَتاع",47,"ع",1,0],["إن الشجاع يَفرُّ في سَاح الوَغَى","لِيَكِرَّ من بعد الفرار مُظَفَّرا",48,"ر",2,0],["إنَّ الشبابَ سِنادُ المُلْكِ يَعضُدُهُ","أيّامَ تُوحِدُهُ الأرزَاءُ والغِيَر",49,"ر",1,0],["إنَّ الشبابَ جنودَ اللهِ ألَّفهمْ","في \" الشامِ \" داعٍ من الأوطانِ مُتَّبع",50,"ع",1,0],["إن الشقاء عناق كل خريدة","كَالْخيْزُرَانة ِ لا نمَلُّ عِناقَهَا",51,"ق",3,0],["ان الشخوص تنطوي","واي ظل ما انتقل",52,"ل",1,0],["إن الشدائدَ قد تَغشى الكريمَ لأَن","تُبِينُ فَضلَ سجاياهُ وتُوضِحَهُ",53,"ه",1,1],["إن الشتاء وإن تطاول عهده","للأرض بعد ذهابه تجديد",54,"د",1,0],["إن الشَّقاءَ لفي الزراعة مطلقاً","إن أجْدَبَت أرضٌ وقَلَّ الماءُ",55,"ا",2,0],["إِنَّ الشِّفَافي شِفَاهِ الخَودِ لَو رَشَفَت","لَكِن سَقَتني وَصدَّت كَأسَ ذُؤفَانِ",56,"ن",1,0],["إنّ الشَّدائدَ مذعُنينَ به","قارعنَ جُلمودا من الصخرِ",57,"ر",1,0],["إن الشهاب جوهر عنصره","مهذب الأصلين مافيه دخل",58,"ل",1,0],["إن الشجاعة من يقين كالسخا","والذل والبخل نتيجا الشك",59,"ك",1,0],["إن الشجاعة عنده معدودة","من جملة النعم التي لا تكفر",60,"ر",1,0],["إن الشهود الملجئين إلى القضا","تبعتهم التبعات والقاضي برا",61,"ر",2,0],["إِنَّ الشَقاءَ بِالشَقِيِّ مولَعٌ","لا يَملِكُ الرَدَّ لَهُ إِذا أَتى",62,"ا",1,0],["إن الشجاعة في الهوى","كَملتْ لمن أَلْقى السلاحا",63,"ح",2,0],["إنّ الشباب إذا زكَت أخلاقهُ","والنفسَ طهّرَها من الأدرانِ",64,"ن",1,0],["إِنَّ الشَقاء سُلَّمٌ إِلى السَما","فَعَدنُ ميراثٌ لِمَن تَأَلَّما",65,"م",2,0],["إِن الشَباب ملاعِبُ ال","أَيّامِ فَاِحذَر أَن تُضاما",66,"م",2,0],["إَنَّ الشَّمَائِلَ أَزْهَارٌ وَأَنْوَارُ","أَرِيجُهَا فِي أُنُوفِ الذَّوْقِ مِعْطَارُ",67,"ر",1,1],["ان الشدائد جمة واشدها","حكم الهوى وعقاب من لم يغفر",68,"ر",1,0],["إنّ الشبابَ لهازلٌ متقلِّبٌ","ولهُ غناءٌ في الهوى وعويل",69,"ل",1,0],["إن الشعوبَ من العبودةِ أُرهِقت","إن لم تحررها فلا تتحرَر",70,"ر",1,0],["إنَّ الشَّهيداتِ الثَّواكِلَ صارخٌ","دَمُهُنَّ يومَ الحَشرِ من أيديك",71,"ك",1,0],["إنَّ الشَّيبةَ نارٌ إ