.aspx?id=203546",""],[5160,"عبق الشهادة","https://www.poetsgate.com/ViewPoem.aspx?id=175204",""],[5226,"للقدس .. كلام آخر","https://www.poetsgate.com/ViewPoem.aspx?id=27720",""],[5305,"الاستسعاد بمدح سيد الأسياد","https://www.poetsgate.com/ViewPoem.aspx?id=187378",""],[5376,"الدهرُ أمتعنا بالرود والغيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=188404",""],[5376,"قصيدة من ملحمة سقوط بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=188511",""],[5376,"ذياك جرحي الذي في القلب يبتسمُ","https://www.poetsgate.com/ViewPoem.aspx?id=192170",""],[5376,"طوبى لمن ترك العرين جسورا","https://www.poetsgate.com/ViewPoem.aspx?id=198238",""],[5413,"فقد الأحبة غربةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=201389",""],[1149,"تطاوَلَ ليلِي واعترتْنِي وساوسِي","https://www.poetsgate.com/ViewPoem.aspx?id=22286",""],[475,"يَا بَيْتَ عَاتِكَة َ الَّذِي أَتَعزَّلُ","https://www.poetsgate.com/ViewPoem.aspx?id=20634",""],[5431,"الشريعة","https://www.poetsgate.com/ViewPoem.aspx?id=183194",""],[5431,"كثائر ماارتضى للحب اذعانا","https://www.poetsgate.com/ViewPoem.aspx?id=185768",""],[5500,"يقين","https://www.poetsgate.com/ViewPoem.aspx?id=188513",""],[5533,"شَمْسُ الحرِّية","https://www.poetsgate.com/ViewPoem.aspx?id=179733",""],[5561,"يوم ذي قار","https://www.poetsgate.com/ViewPoem.aspx?id=208542",""],[5582,"أَبُدُورُ تَمٍّ كالبُدُورِ طَوالِعُ","https://www.poetsgate.com/ViewPoem.aspx?id=63530",""],[5660,"أَنتَ الشَريفُ شَريفٌ في مُحَيّاكَ","https://www.poetsgate.com/ViewPoem.aspx?id=23714",""],[5717,"صب تسامره بدور","https://www.poetsgate.com/ViewPoem.aspx?id=170584",""],[5781,"نَصْرٌ ووعد","https://www.poetsgate.com/ViewPoem.aspx?id=190950",""],[402,"عز المعالي مات يوسف سابا","https://www.poetsgate.com/ViewPoem.aspx?id=35358",""],[5804,"حوار معا الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=191224",""],[5829,"شهيد المحراب","https://www.poetsgate.com/ViewPoem.aspx?id=160316",""],[5829,"جحود العرب","https://www.poetsgate.com/ViewPoem.aspx?id=187393",""],[5829,"شاب الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=213964",""],[5836,"مكارم الأخلاق","https://www.poetsgate.com/ViewPoem.aspx?id=195085",""],[5887,"شعبي المغوار","https://www.poetsgate.com/ViewPoem.aspx?id=35364",""],[5910,"رمضان أقبل","https://www.poetsgate.com/ViewPoem.aspx?id=212047",""],[5956,"الرَّدَى الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=184256",""],[5957,"العيد أنتَ","https://www.poetsgate.com/ViewPoem.aspx?id=181834",""],[6035,"ياابن الوليد وياسعد وياعمرو","https://www.poetsgate.com/ViewPoem.aspx?id=175127",""],[6102,"الشهيد ..","https://www.poetsgate.com/ViewPoem.aspx?id=182893",""],[243,"صحيفة الأحرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68182&r=&rc=174",""],[5393,"وقمامة من لم يجاهد مرةً ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85460&r=&rc=27",""],[2220,"لبسُ التقى للنفس خيرُ لباس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11490&r=&rc=364",""]],"verses":[["إِنَّ الشَفيعَ الهُمامَ سَوَّغَهُ اللَ","هُ اِتّصالَ التَأييدِ بِالظَفَرِ",0,"ر",1,0],["إِنَّ الشَجاةَ الَّتي حَدَّثتُمُ اِعتَرَضَت","خَلفَ اللَها لَم تُسَوِّغها البَلاعيمُ",1,"م",1,0],["إِنَّ الشِفاءَ الَّذي ضَنَّت بِنائِلِهِ","فَرعُ البَشامِ الَّذي تَجلو بِهِ البَرَدا",2,"د",2,0],["إِنَّ الشَواحِجَ بِالضُحى هَيَّجنَني","في دارِ زَينَبَ وَالحَمامُ الوُقَّعُ",3,"ع",1,0],["إن الشباب لمَألوفٌ لصُحْبَتِهِ","تلك القديمة مَبْكيٌّ إذا ذهبا",4,"ب",2,0],["إِنَّ الشَبابَ لَمَحمودٌ بَشاشَتُهُ","وَالشَيبُ مُنصَرَفٌ عَنهُ وَمَصدودُ",5,"د",1,0],["إِنَّ الشَبابَ هُوَ الغِنى فَإِذا مَضى","وَأَقَمتَ لا يَنفَكُّ فَقرَكَ بادي",6,"د",2,0],["إِنَّ الشُعوبَ إِذا اِستَمَرَّ جُثومُها","جَثَمَ الرَدى مِن حَولِها يَتَرَقَّبُ",7,"ب",1,0],["إن الشعوب إذا ما أدبرت حبست","مالا عن البر أو علما عن العمل",8,"ل",1,0],["إن الشعوب كيانها حرية","تحيا عليها أو تموت فداءها",9,"ا",3,0],["إن الشعوب إذا أرادوا نهضة","بذرائع العلم الصحيح تذرّعوا",10,"ع",3,0],["إِنَّ الشِفاءَ مِنَ الحَياةِ وَعَونِها","ما كانَ آسَ بِالشِفاءِ ضَمينا",11,"ن",2,0],["إِنَّ الشَجاعَةَ في القُلوبِ كَثيرَةٌ","وَوَجَدتُ شُجعانَ العُقولِ قَليلا",12,"ل",2,0],["إِنَّ الشَمائِلَ إِن رَقَّت يَكادُ بِها","يُغرى الجَمادُ وَيُغرى كُلُّ ذي نَسَمِ",13,"م",1,0],["إِنَّ الشَبابَ يُحَبُّ جَمّاً حافِلاً","وَتُحَبُّ أَيّامُ الشَبابِ مِلاءَ",14,"ا",2,0],["إِنَّ الشُجاعَ هُوَ الجَبانُ عَنِ الأَذى","وَأَرى الجَريءَ عَلى الشُرورِ جَبانا",15,"ن",2,0],["إِنَّ الشَبابَ غَدٌ فَليَهدِهِم لِغَدٍ","وَلِلمَسالِكِ فيهِ الناصِحُ الوَرِعُ",16,"ع",1,0],["إِنَّ الشَبابَ لَرابِحٌ مَن باعَهُ","وَالشَيبُ لَيسَ لِبائِعيهِ تِجارُ",17,"ر",1,0],["إِنَّ الشَبابَ لَنافِقٌ عِندَ النِسا","ما لِلمَشيبِ مِنَ النِساءِ حَبيبُ",18,"ب",1,0],["إِنَّ الشَبابَ شَفيعٌ نَشرُ بُردَتِهِ","مِن عِطرِ دارينَ لا مِن عِطرِ فَنصورِ",19,"ر",1,0],["إن الشبيبةَ في كفَّيك عاريةٌ","فإن وجدت لها رَدّاً فلا جَرَما",20,"م",2,0],["إِنَّ الشريعةَ مِنهُ تُشْرِعُ عاملاً","من كلِّ باغٍ عامِلاً في المقتَلِ",21,"ل",1,0],["إنّ الشجاعةَ في الحُماة وإنها","لأشدّ منها في الأبيِّ الصابِرِ",22,"ر",1,0],["إِنَّ الشِتاءَ عَلى جَهامَةِ وَجهِهِ","لَهُوَ المُفيدُ طَلاقَةَ المُصطافِ",23,"ف",1,0],["إِنَّ الشَبابَ الَّذي كُنّا نَزُنُّ بِهِ","وَلّى وَلَم نَقضِ مِن لَذّاتِهِ أَمَلا",24,"ل",2,0],["إِنَّ الشِفاءَ عِناقُ كُلِّ خَريدَةٍ","كَالخَيزُرانَةِ لا نَمَلُّ عِناقَها",25,"ق",3,0],["إن الشُّعوبَ إذا استقام سبيلُها","أمِنَتْ غَداةَ الجِدّ كلَّ عِثارِ",26,"ر",1,0],["إِنَّ الشُعوبَ حَياتَها وَمَماتَها","بِيَدِ المُلوكِ هِدايَةً وَضَلالا",27,"ل",2,0],["إنّ الشريدَ الذي قد كان يظلمه","ذَوُو قَرَابتِهِ قد عادَ فانْتَصَفا",28,"ف",2,0],["إِنَّ الشَباب عَسا وَأَدبَرَ خَيرُهُ","فَمَتى تَقُولُ وَلاتَ حِينَ إِيابُهُ",29,"ب",2,0],["إِنَّ الشَبابَ خانَني","فَالرَأسُ مِنّي أَبلَقُ",30,"ق",1,0],["إِنَّ الشَبيبَةَ نارٌ إِن أَرَدتَ بِها","أَمراً فَبادِرهُ إِنَّ الدَهرَ مُطفِئُها",31,"ا",3,0],["إِنَّ الشَرائِعَ أَلقَت بَينَنا إَِحناً","وَأَودَعَتنا أَفانينَ العَداواتِ",32,"ت",1,0],["إِنَّ الشُرورَ لَكَالسَحابَةِ أَثجَمَت","لاكِ السُرورُ كَأَنَّهُ بَرقٌ خَلَب",33,"ب",1,0],["إِنَّ الشُمولَ رِياحٌ شَمأَلٌ عَصَفَت","بِاللُبِّ وَالسُكرُ غَيٌّ فادِحٌ شَمَلَك",34,"ك",1,0],["إن الشعوب إذا هاجَت عواطفها","كالبحر يضرب أمواجاً بأمواج",35,"ج",1,0],["إِنَّ الشعوب لتستحق تساوياً","لَولا اختلاف بينها وَفروق",36,"ق",1,0],["إن الشعر لم ينهض بآداب أُمة","إذاً خابَت الآمال في الشعر والظن",37,"ن",1,0],["إن الشرق بعد اليوم لم يرع نفسه","أَلمَّت به الجلّى وعاجله المحق",38,"ق",1,0],["إِنَّ الشَجاعَةَ في الرِجالِ غَلاظَةٌ","ما لَم تَزِنها رَأفَةٌ وَسَخاءُ",39,"ا",2,0],["إِنَّ الشُّيُوخَ إِذَا بَكَوْهُ فَرُزْءُهُ","أَبْكَى كُهُولاً بَعْدَهُ وَشَبَابَا",40,"ب",2,0],["إَنَّ الشَّجَاعَةَ وَالنَّصْرَ الْخَلِيقَ بِهَا","مَا يَفْعَلُ الْبَأْسُ لاَ مَا يَفْعَلُ الْعَدَدُ",41,"د",1,0],["إِنَّ الشَّبَابَ وَدِيعَةٌ مَرْدُودَةٌ","والزُّهْدُ فِيه تَزَمُّتُ النُّسَّاكِ",42,"ك",1,0],["إنَّ الشَّبَابَ رَحِيقُ أَزْهَارِ الرُّبا","وَحَفِيفُ غُصْنِ الْبَانَةِ الأُمْلُودِ",43,"د",1,0],["إِنَّ الشباب ومَا أُحَيْلَى عَهْدَه","كالواحَةِ الْخَضْرَاءِ في الصَّيْهُودِ",43,"د",1,0],["إنَّ الشَّجَاعَةَ أنْ تُنَاضِلَ مُصْحِراً","لاَ أن تَدِبَّ كَفَاتِكِ الأَصْلاَلِ",44,"ل",1,0],["إِنَّ الشُّعُوبَ تُصَابُ في أَبْطَالِها","وحَياتُها في سِيرَةِ الأبْطَالِ",44,"ل",1,0],["إن الشعوب إذا أدلت بحجَّتها","فأبلغَتْ، كان طهَ حُجَّةَ العرب",45,"ب",1,0],["إنَّ الشيوخ تقومَ الليلَ في حرمٍ","لكن عليٌّ يقوم الليل في «بار»",46,"ر",1,0],["إنّ الشبابَ تحضُّرٌ وتوثُّبٌ","ليس الشبابُ بلذَّةٍ ومَتاع",47,"ع",1,0],["إن الشجاع يَفرُّ في سَاح الوَغَى","لِيَكِرَّ من بعد الفرار مُظَفَّرا",48,"ر",2,0],["إنَّ الشبابَ سِنادُ المُلْكِ يَعضُدُهُ","أيّامَ تُوحِدُهُ الأرزَاءُ والغِيَر",49,"ر",1,0],["إنَّ الشبابَ جنودَ اللهِ ألَّفهمْ","في \" الشامِ \" داعٍ من الأوطانِ مُتَّبع",50,"ع",1,0],["إن الشقاء عناق كل خريدة","كَالْخيْزُرَانة ِ لا نمَلُّ عِناقَهَا",51,"ق",3,0],["ان الشخوص تنطوي","واي ظل ما انتقل",52,"ل",1,0],["إن الشدائدَ قد تَغشى الكريمَ لأَن","تُبِينُ فَضلَ سجاياهُ وتُوضِحَهُ",53,"ه",1,1],["إن الشتاء وإن تطاول عهده","للأرض بعد ذهابه تجديد",54,"د",1,0],["إن الشَّقاءَ لفي الزراعة مطلقاً","إن أجْدَبَت أرضٌ وقَلَّ الماءُ",55,"ا",2,0],["إِنَّ الشِّفَافي شِفَاهِ الخَودِ لَو رَشَفَت","لَكِن سَقَتني وَصدَّت كَأسَ ذُؤفَانِ",56,"ن",1,0],["إنّ الشَّ