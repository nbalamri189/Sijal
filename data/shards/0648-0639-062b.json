{"poems":[[79,"إذا فاتني ظل الحمى ونعيمه","https://www.aldiwan.net/poem36117.html","الطويل"],[85,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62225","البسيط"],[128,"سكر الدهر فقل لي كيف أَصحو","https://www.aldiwan.net/poem23736.html","الرمل"],[138,"خليلي ما أذني لأول عاذل","https://www.aldiwan.net/poem21027.html","الطويل"],[156,"القادمون الخضر","https://www.aldiwan.net/poem17107.html","عموديه"],[164,"يزورك العيد والأشواق تحمله","https://www.aldiwan.net/poem58897.html","البسيط"],[276,"أتأمرني بالصبر والطبع أغلب","https://www.aldiwan.net/poem52082.html","الطويل"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[309,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[371,"لعينيه على العشاق إمره","https://www.aldiwan.net/poem17205.html","الوافر"],[470,"عَثرَة ُ العُمر","https://www.aldiwan.net/poem36439.html","عموديه"],[592,"أرى كل ما قد قدر الله يكتب","https://www.aldiwan.net/poem11510.html","عموديه"],[592,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86889","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87168","الطويل"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129537","الرمل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67825","الطويل"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44948","المتقارب"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126132","الرجز"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114038","الوافر"],[2197,"","https://poetry.dctabudhabi.ae/diwan/poem/205996","الوافر"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47112","الطويل"],[2271,"","https://poetry.dctabudhabi.ae/diwan/poem/216324","الوافر"],[2570,"","https://poetry.dctabudhabi.ae/diwan/poem/122835","الخفيف"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83224","الطويل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116511","الطويل"],[2825,"","https://poetry.dctabudhabi.ae/diwan/poem/130729","الخفيف"],[3009,"","https://poetry.dctabudhabi.ae/diwan/poem/102379","الوافر"],[3524,"","https://poetry.dctabudhabi.ae/diwan/poem/124598","الطويل"],[3619,"","https://poetry.dctabudhabi.ae/diwan/poem/33115","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135742","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77149","الرجز"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136575",""],[4968,"تعويذة العشق ٢","https://www.poetsgate.com/ViewPoem.aspx?id=208097",""],[5324,"فغزة باتت صدى كربلاء.","https://www.poetsgate.com/ViewPoem.aspx?id=211300",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5541,"الشيبانية .. سأحمد ربي طاعة وتعبدا","https://www.poetsgate.com/ViewPoem.aspx?id=119906",""],[5954,"أسطورتي","https://www.poetsgate.com/ViewPoem.aspx?id=195113",""]],"verses":[["وَعُثْمَانُ غَيْثُ الْجُودِ أَكْرَمُ وَاهِبٍ","إِذَا مَا الْغَمَامُ الْجَوْنُ ضَنَّتْ سُجُومُهُ",0,"م",2,0],["وعثرتُ في طلب المفاز جهالةً","لكن وجدتُك للعثار مُقيلا",1,"ل",2,0],["وُعْثُ الرَّوَادِف مَا تَعْيَا بِلِبْسَتِهَا","هَيْلَ الدَّهَاسِ وفي أَوْرَاكِهَا ظَلَعُ",2,"ع",1,0],["وعثار الجد قد صيرها","عبرة خرساء هيهات تسح",3,"ح",1,0],["وَعُثمانُ لَم يَربَع عَلَينا وَقُنفُذٌ","وَلَكِن أَطاعا أَمرَ تِلكَ القَبائِلِ",4,"ل",1,0],["وعِثارٍ في دربهم ، وانطلاقٍ","وسرابٍ يلوح خلف سرابِ",5,"ب",1,0],["وعثيرَ الخيلِ مهما ثار ثائِرُه","جلاه من وجهك الآسنى تهلُلُه",6,"ل",2,0],["وَعثمان ذو النورين من سبح الحصى","بكفيه وارى الزند وَالبرق خلب",7,"ب",1,0],["وعثرةُ اللِسانِ","توقع بالإِنسانِ",8,"ن",1,0],["وعثمان ذي النورين مع كل من حوى","بقيع الندى من سادة وأكابر",9,"ر",1,0],["وَعَثرُ السَمحِ لَمحٌ فَاِرتَقِبها","حُظوظاً أَبطَأَت لِتَجي بِكَثرَه",10,"ر",2,0],["وَعَثَرْنا.. لِفَرْطِ نَخوَةِ حادينا","وَغَدْ ر ِ الأعمام ِ والأخوال ِ",11,"ل",1,0],["وعثمان بعد الحل للعين قد رأى","وأبصر منها ما رأى حين يضرب",12,"ب",1,0],["وعثمان بعد الضرب وجهه","وكفاً له يسمو بها ويصوب",13,"ب",1,0],["وَعثرة بِلِسان لا دواء لَها","إِلا المَنون إِذا لَم يَلطف الباري",14,"ر",2,0],["وَعُثمان ذي النورين وَالسَيد الولي","أَبي الحَسنِ البحرِ الخضمِّ إمامنا",15,"ن",2,0],["وعثار قد أقالته النهى","فإن استأنفت فيه لا لعا",16,"ع",2,0],["وَعُثَمانَ ثُمَّ المُرْتَضى نِعْمَ مَنْ هُدِي","دَوَامُ سُرُورِي فِي مَدِيحي لأحْمَدِ",17,"د",1,0],["وَعُثعَث تَأتي إِذا جِئتَنا","فَتَسمَعُ مِنها غِناءً يَصور",18,"ر",1,0],["وعثرة في رجله تقال","وعثرة اللسان لا تقال",19,"ل",1,0],["وعثمانَ السري أدِم عُلاه","بحق الذكر والسبع المَثَاني",20,"ن",2,0],["وعثمان بن عفان شهيد","نقي لم يكن دنس الثياب",21,"ب",1,0],["وعثمان ذي النّورين مَن حَيِيَت له","ملائك فاسْتَحْيَيْتَ من وجهه الوردي",22,"د",2,0],["وعثمان الرّضيّ أخيه أيضاً","وكالطّوسيّ ركن الابتهال",23,"ل",1,0],["وعثاري اذا أردت قياما","وقعودا في مثقلات الكبول",24,"ل",1,0],["وَعُثمانُ وَاِبنُ العاصِ عَمرٌ وَرَهطُهُ","تَسامى إِلَينا نَبعُهُم مِن أُمَيَّةِ",25,"ه",1,0],["وعثمان عفان آتيه بأكلة","فطابت وطاب الأكل من ناعم البر",26,"ر",1,0],["وعثَت في البلاد بالسوء والفحشِ","وقامت بالمكر كلّ مقام",27,"م",1,0],["وعثمان بن عنبسة بن صخر","إليه ينتهي كرم النجار",28,"ر",1,0],["وعثمانها ذو النور والنور خنصر","إذا عدّ محمود الفعال سديدها",29,"د",3,0],["وَعُثمانُ وَالصِدّيقُ مِنَا وَأَنَّنا","لَنَعلَمُ أَنَّ الحَقَّ ما يَعِدانِ",30,"ن",1,0],["وعثراتي إلهي أقِلْ","عند رواحي أو صباحي أو مقيل",31,"ل",1,0],["وعثرة الرجل تزل القدما","وعثرة اللسان زالت نعما",32,"م",2,0],["وَعَثرَةُ الرِجلِ لَها إِقالَة","وَعَثرَة الرَأيِ فَلا تُقال",33,"ل",1,0],["وعثرتَ في كبدي وحينَ أذبتها","بلَظى هواكَ أرقتها بدمُوعي",34,"ع",2,0],["وَعْثَاؤُهُ فيّ لا أنثى تعطّره","إلاّي يهتف إنّ البوح في عطل",35,"ل",1,0],["وعثمان يسعى إليها فداء","ليدرك فيها الرّسول الأمين",36,"ن",1,0],["وعثمان والعيسى وحماد الذي","يسمى ابن زيد من سما وتقدما",37,"م",2,0],["وعثمان ذو النورين قد مات صائما","قتيلا شهيد الدار نعى له الغدا",38,"د",2,0],["وعثت باحثةً عن سر أوردتي","لم أشتم الحظ بل جرَّته آهاتي",39,"ت",2,0]]}