{"poems":[[77,"إذا فاتني ظل الحمى ونعيمه","https://www.aldiwan.net/poem36117.html","الطويل"],[83,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[124,"سكر الدهر فقل لي كيف أَصحو","https://www.aldiwan.net/poem23736.html","الرمل"],[134,"خليلي ما أذني لأول عاذل","https://www.aldiwan.net/poem21027.html","الطويل"],[152,"القادمون الخضر","https://www.aldiwan.net/poem17107.html","عموديه"],[160,"يزورك العيد والأشواق تحمله","https://www.aldiwan.net/poem58897.html","البسيط"],[271,"أتأمرني بالصبر والطبع أغلب","https://www.aldiwan.net/poem52082.html","الطويل"],[297,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[304,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[366,"لعينيه على العشاق إمره","https://www.aldiwan.net/poem17205.html","الوافر"],[465,"عَثرَة ُ العُمر","https://www.aldiwan.net/poem36439.html","عموديه"],[587,"أرى كل ما قد قدر الله يكتب","https://www.aldiwan.net/poem11510.html","عموديه"],[587,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"]],"verses":[["وَعُثْمَانُ غَيْثُ الْجُودِ أَكْرَمُ وَاهِبٍ","إِذَا مَا الْغَمَامُ الْجَوْنُ ضَنَّتْ سُجُومُهُ",0,"م",2,0],["وعثرتُ في طلب المفاز جهالةً","لكن وجدتُك للعثار مُقيلا",1,"ل",2,0],["وعثار الجد قد صيرها","عبرة خرساء هيهات تسح",2,"ح",1,0],["وَعُثمانُ لَم يَربَع عَلَينا وَقُنفُذٌ","وَلَكِن أَطاعا أَمرَ تِلكَ القَبائِلِ",3,"ل",1,0],["وعِثارٍ في دربهم ، وانطلاقٍ","وسرابٍ يلوح خلف سرابِ",4,"ب",1,0],["وعثيرَ الخيلِ مهما ثار ثائِرُه","جلاه من وجهك الآسنى تهلُلُه",5,"ل",2,0],["وَعثمان ذو النورين من سبح الحصى","بكفيه وارى الزند وَالبرق خلب",6,"ب",1,0],["وعثرةُ اللِسانِ","توقع بالإِنسانِ",7,"ن",1,0],["وعثمان ذي النورين مع كل من حوى","بقيع الندى من سادة وأكابر",8,"ر",1,0],["وَعَثرُ السَمحِ لَمحٌ فَاِرتَقِبها","حُظوظاً أَبطَأَت لِتَجي بِكَثرَه",9,"ر",2,0],["وَعَثَرْنا.. لِفَرْطِ نَخوَةِ حادينا","وَغَدْ ر ِ الأعمام ِ والأخوال ِ",10,"ل",1,0],["وعثمان بعد الحل للعين قد رأى","وأبصر منها ما رأى حين يضرب",11,"ب",1,0],["وعثمان بعد الضرب وجهه","وكفاً له يسمو بها ويصوب",12,"ب",1,0]]}