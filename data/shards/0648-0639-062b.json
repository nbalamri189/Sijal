{"poems":[[79,"إذا فاتني ظل الحمى ونعيمه","https://www.aldiwan.net/poem36117.html","الطويل"],[85,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62225","البسيط"],[127,"سكر الدهر فقل لي كيف أَصحو","https://www.aldiwan.net/poem23736.html","الرمل"],[137,"خليلي ما أذني لأول عاذل","https://www.aldiwan.net/poem21027.html","الطويل"],[155,"القادمون الخضر","https://www.aldiwan.net/poem17107.html","عموديه"],[163,"يزورك العيد والأشواق تحمله","https://www.aldiwan.net/poem58897.html","البسيط"],[274,"أتأمرني بالصبر والطبع أغلب","https://www.aldiwan.net/poem52082.html","الطويل"],[300,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[307,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[369,"لعينيه على العشاق إمره","https://www.aldiwan.net/poem17205.html","الوافر"],[467,"عَثرَة ُ العُمر","https://www.aldiwan.net/poem36439.html","عموديه"],[589,"أرى كل ما قد قدر الله يكتب","https://www.aldiwan.net/poem11510.html","عموديه"],[589,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"]],"verses":[["وَعُثْمَانُ غَيْثُ الْجُودِ أَكْرَمُ وَاهِبٍ","إِذَا مَا الْغَمَامُ الْجَوْنُ ضَنَّتْ سُجُومُهُ",0,"م",2,0],["وعثرتُ في طلب المفاز جهالةً","لكن وجدتُك للعثار مُقيلا",1,"ل",2,0],["وُعْثُ الرَّوَادِف مَا تَعْيَا بِلِبْسَتِهَا","هَيْلَ الدَّهَاسِ وفي أَوْرَاكِهَا ظَلَعُ",2,"ع",1,0],["وعثار الجد قد صيرها","عبرة خرساء هيهات تسح",3,"ح",1,0],["وَعُثمانُ لَم يَربَع عَلَينا وَقُنفُذٌ","وَلَكِن أَطاعا أَمرَ تِلكَ القَبائِلِ",4,"ل",1,0],["وعِثارٍ في دربهم ، وانطلاقٍ","وسرابٍ يلوح خلف سرابِ",5,"ب",1,0],["وعثيرَ الخيلِ مهما ثار ثائِرُه","جلاه من وجهك الآسنى تهلُلُه",6,"ل",2,0],["وَعثمان ذو النورين من سبح الحصى","بكفيه وارى الزند وَالبرق خلب",7,"ب",1,0],["وعثرةُ اللِسانِ","توقع بالإِنسانِ",8,"ن",1,0],["وعثمان ذي النورين مع كل من حوى","بقيع الندى من سادة وأكابر",9,"ر",1,0],["وَعَثرُ السَمحِ لَمحٌ فَاِرتَقِبها","حُظوظاً أَبطَأَت لِتَجي بِكَثرَه",10,"ر",2,0],["وَعَثَرْنا.. لِفَرْطِ نَخوَةِ حادينا","وَغَدْ ر ِ الأعمام ِ والأخوال ِ",11,"ل",1,0],["وعثمان بعد الحل للعين قد رأى","وأبصر منها ما رأى حين يضرب",12,"ب",1,0],["وعثمان بعد الضرب وجهه","وكفاً له يسمو بها ويصوب",13,"ب",1,0]]}