 غضبان","https://www.aldiwan.net/poem55858.html","المنسرح"],[459,"أمن كل حظ قل قسمي أقله","https://www.aldiwan.net/poem56071.html","الطويل"],[459,"عاتبت دهري في الجناية لو وعى","https://www.aldiwan.net/poem56132.html","الكامل"],[459,"بعينيك يوم البين غيبي ومشهدي","https://www.aldiwan.net/poem56221.html","الطويل"],[462,"اعيذ قريشا أن تصيخ لكاشح","https://www.aldiwan.net/poem15463.html","الطويل"],[462,"أقول لصحبي والمقال تكعه","https://www.aldiwan.net/poem16163.html","الطويل"],[465,"يا من تلون عهده وتغيرا","https://www.aldiwan.net/poem3198.html","عموديه"],[469,"ألا رب فتيان كأن وجوههم","https://www.aldiwan.net/poem59742.html","الطويل"],[469,"وقوم إن دجا للنقع ليل","https://www.aldiwan.net/poem59870.html","الوافر"],[483,"أنخت مطايا الذل نحوك ملقيا","https://www.aldiwan.net/poem24461.html","عموديه"],[496,"كم حسرات لي وكم وجد","https://www.aldiwan.net/poem9818.html","السريع"],[501,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[515,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[516,"هذي مناجاة عبد رق حاسده","https://www.aldiwan.net/poem12097.html","البسيط"],[539,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"],[539,"ألحمد لله زال الخوف والوجل","https://www.aldiwan.net/poem47987.html","عموديه"],[539,"إن يكن غيري تابا","https://www.aldiwan.net/poem48275.html","عموديه"],[544,"ليس يغني القول إلا لامرئ","https://www.aldiwan.net/poem1759.html","الرمل"],[552,"يا دار دار الصوم القوم","https://www.aldiwan.net/poem47200.html","السريع"],[552,"لي منزل ولمن سلاكم منزل","https://www.aldiwan.net/poem47334.html","الكامل"],[552,"عجبت لقلبي كيف يصبو ويكلف","https://www.aldiwan.net/poem47405.html","البسيط"],[552,"أيا حادي الأظعان لم لا تعرس","https://www.aldiwan.net/poem47754.html","الطويل"],[552,"سل الجزع أين المنزل المتنازح","https://www.aldiwan.net/poem47904.html","الطويل"],[554,"تعز فقد مات الهوى وانتهى الجهل","https://www.aldiwan.net/poem68388.html","الطويل"],[560,"أنخ هديت الاينقا","https://www.aldiwan.net/poem69351.html","مجزوء الرجز"],[560,"أنخ الركائب في فناء الدار","https://www.aldiwan.net/poem69364.html","الكامل"],[576,"لقد لقيت نصباً","https://www.aldiwan.net/poem2747.html","مجزوء الرجز"],[576,"نفس تحن إلى مها","https://www.aldiwan.net/poem3017.html","مجزوء الكامل"]],"verses":[["إِن خَيَّمَت هَذِهِ بِأَرضي","تَحَمَّلَت تِلكَ عَن دِياري",0,"ر",2,0],["إِنَّ خَيرَ الرِماحِ ما شَرِقَت بِال","طَعنِ مِنها مَعاقِدُ الأَكبادِ",1,"د",1,0],["إِن خارَ مِنها عودُهُ","فالمَشرَفِيُّ يُطبَعُ",2,"ع",1,0],["أنِخْها طَليحاتِ المآقي لَواغِباً","بِما اعْتَسَفَتْ من صَحْصَحٍ ومِتانِ",3,"ن",1,0],["إن خانَ سِرَّكِ طَرْفي فالهَوى عَلِقٌ","منّي بقَلْبٍ على الأسرارِ مُؤْتَمَنِ",4,"ن",1,0],["أُنِخْنَ وقَد دانى خُطاها كَلالُها","إليكَ فأدْنَتْها البَشاشةُ والبِشْرُ",5,"ر",1,0],["إِن خِفتِ أَن يَفطُنَ بي","مِنكُم رَقيبٌ فَاِكتُبي",6,"ب",2,0],["أَنَختُ قَلوصي وَاِكتَلَأتُ بِعَينِها","وَآمَرتُ نَفسي أَيَّ أَمرَيَّ أَفعَلُ",7,"ل",1,0],["إِن خانَني فيما فَجِعتُ بِهِ","شِعري فَهَذا الدَمعُ يَشفَعُ لي",8,"ل",2,0],["إِن خانَ وُدّي صَديقٌ كُنتُ أَصحَبُهُ","أَو خانَ عَهدي حَبيبٌ كُنتُ أَهواهُ",9,"ا",2,0],["أَنَختَ إِلى مَظلومَةٍ غَيرِ مَسكِنٍ","حَوامِلُها عوجٌ وَأَفنانُها رَطبُ",10,"ب",1,0],["إن خالطك الأملاك لم ينكروا","محله من رفعةٍ القدر",11,"ر",1,0],["إِنَّ خَطْباً أَدْمَى أَخَاكَ لَخَطْبٌ","بِتَجَنِّيهِ فَوْقَ حِلْمِ الْحَلِيمِ",12,"م",1,0],["أَنَخنَ فَمُغفٍ عِندَ دَفِّ شِمِلَّةٍ","شَمَردَلَةِ الأَلواحِ فانٍ سَنامُها",13,"م",3,0],["أَنَخنا بِها خوصاً بَرى النَصُّ بدُنَها","وَأَلصَقَ مِنها باقِياتِ العَرائِكِ",14,"ك",1,0],["أَنَخنَ لِتَعريسٍ فَمِنهُنَّ صارِفٌ","يُغَنّي بِنابَيهِ مُطَلّحَةً صُعرا",15,"ر",2,0],["إن خاض في ليل العجاج رأيته","يجلو دجُنَّته بوجه نهارِ",16,"ر",1,1],["إن خدمنا فلا تريد جزاء","ومن الأم هل يراد جزاء",17,"ا",2,0],["أَنَخنَ لِتَغويرٍ وَقَد وَقَدَ الحَصى","وَذابَ لُعابُ الشَمسِ فَوقَ الجَماجِمِ",18,"م",1,0],["أَنَخنا فَسَبَّحنا وَنَوَّرَتِ السُرى","بِأَعرافِ وَردِ اللَونِ بُلقٍ شَواكِلُه",19,"ل",2,0],["أَنِخها فَأَردِفهُ فَإِن حَمَلَتكُم","فَذاكَ وَإِن كانَ العِقابُ فَعاقِبِ",20,"ب",1,0],["أُنِخنَ أُدمَاً فَصِرنَ دُهماً وما","غَيَّرَهُنَّ الهِنَاءُ والجَرَبُ",21,"ب",1,0],["أنخن أوما فصرن دهما وما","غيّرهن الهناء والجرب",22,"ب",1,1],["أَنَختُ فيهِنَّ يَعمَلاتٍ","ما عَهدُ إِرقالِها ذَميمُ",23,"م",1,0],["أَنَختُ وَصاحِبايَ بِذي طُلوحٍ","طَلائِحَ شَفَّها وَخدُ القِفارِ",24,"ر",1,0],["إِنَّ خالي خَطيبُ جابِيَةِ الجَو","لانِ عِندَ النُعمانِ حينَ يَقومُ",25,"م",1,0],["إن خابَ سائل أدمعي في حبِّه","فلكثرة الإلحاح والإلحاف",26,"ف",1,0],["إن خانني الزمن المعروف في سببٍ","وخانني زمنٌ في الحلّ والقطن",27,"ن",1,0],["إن خيراً من التَّقَصِّي على الخِل","لِ سَماحٌ في الأخذ والإعطاءِ",28,"ا",2,0],["إن خيراً من أن ترى فيَّ أن قد","فسدتْ نيتي فحقي البوارُ",29,"ر",1,1],["إن خيراً من الشباب بنو الفي","ياض للمُشْتري أوِ المعتاض",30,"ض",1,0],["إن خلف الفضاءِ سَيْباً فضاءً","من عليٍّ يُلْقى إليه مُفاضي",30,"ض",2,0],["إنَّ خُلف الوعيد ليس بعارٍ","لكن العارُ كلُّه خلفُ وعدك",31,"ك",1,0],["إنّ خيراً من ارتفاقِكَ بالْبغ","لِ إذا عُدَّتِ الأمور ارتفاقُك",32,"ك",1,0],["إن خيرَ الثمار ما ردّه الأكْ","لُ مردّاً أُنيطَ ذكراه عنكا",33,"ك",2,0],["أنختُ بحيث تبيضُّ الأيادي","وتسودُّ المطابخُ والبِرامُ",34,"م",1,0],["إِن خِفتَ شَرَّ طَوارِقِ الحَدَثانِ فَ","اِقسِدهُم تُخِفكَ طَوارِقُ الحَدَثانِ",35,"ن",1,0],["إِنَّ خَطبَ البُعدِ عَنكُم","لَيسَ بِالخَطبِ اليَسيرِ",36,"ر",1,0],["أُنِخنَ وَهُنَّ أَغفالٌ عَلَيها","فَقَد تَرَكَ الصِلاءُ بِهِنَّ نارا",37,"ر",2,0],["أَنَخنَ جِمالَهُنَّ بِذاتِ غِسلٍ","سَراةَ اليَومِ يَمهَدنَ الكُدونا",38,"ن",2,0],["أَنَختُ جَديلاً عِندَ بَثنَةَ لَيلَةً","وَيَوماً أَطالَ اللَهُ رَغمَ جَديلِ",39,"ل",1,1],["ان خطبا هز الشآم ومصرا","والعراقين والحجاز جليل",40,"ل",1,0],["ان خير الغناء ما كان يأتي","عن شعور في غفلة الافكار",41,"ر",1,0],["ان خط سطراً فان السطر مكتبة","او قال بيتا فان البيت ديوان",42,"ن",1,0],["إن خيراً به اقتنت مصر قبلاً","غير ما تقتني بهِ مصر بعد",43,"د",1,0],["إِن خَفِيَ النافِعُ فَالنَفعُ ظَهَر","يا سَعدَ مَن صافى وَصوفي وَاِستَتَر",44,"ر",1,0],["إِنَّ خَيرَ الدُموعِ عَوناً لَدَمعٌ","بَعَثَتهُ رِعايَةٌ فَاِستَهَلّا",45,"ل",2,0],["إِن خُلِّيَت رُبِطَت بِآدابِ الوَغى","فَدُعاؤُها يُغني عَنِ الأَرسانِ",46,"ن",1,0],["إنْ خُصَّ حُسْنٌ بالصِّوا","نِ فحسنُه أولَى وأحْرَى",47,"ر",2,0],["أَنَخيلٌ بِعالِجٍ أَم سَفينٌ","عائِماتٌ أَم أُلَياتُ خُدورِ",48,"ر",1,0],["إِنَّ خِلالَ المُعتَزِّ لَيسَ لَها","مُقارِبٌ في السَحابِ يَعشُرُها",49,"ر",3,0],["إِن خاتَلَتهُ الرِجالُ في خَمرٍ","فَسِرُّهُ المُستَشارُ لا عَلَنُه",50,"ن",2,0],["أَنَخنا بِها صُهبَ المَهاري فَجُرِّدَت","مِنَ المَيسِ تَجريدَ السُيوفِ القَواطِعِ",51,"ع",1,0],["أَنَخنا فَأَقبَلنا الرِماحَ وَراءَها","رِماحاً تُساقي بِالمَنايا نِهالُها",52,"ل",3,0],["أَنَخنا ثَلاثاً تَحتَ ضامِنَةِ القِرى","مِنَ الغَليِ يَسمو بِالمُحالِ هَزيمُها",53,"م",3,0],["أُنِخنَ إِلى خَيرِ البَرِيَّةِ ضُمَّراً","دَوامِيَ مِن أَصلابِها وَالمَناسِمِ",54,"م",1,0],["أَنَخنا بِهَجرٍ بَعدَما وَقَدَ الحَصى","وَذابَ لِعابُ الشَمسِ فَوقَ العَمائِمِ",55,"م",1,0],["أَنَخنا إِلَيها مِن حَضيضِ عُنَيزَةٍ","ثَلاثاً كَذَودِ الهاجِرِيِّ رَواسِيا",56,"ي",2,0],["إنْ خالفُوا المجدَ لم يَعْدِلْ مُخالفَةً","أو أخَلفُوا الوَعْدَ لم يُتْبِعْهُ إخلافا",57,"ف",2,0],["أنخْتُ في حانةِ أُترُجَّةٍ","وحبّذا حانتُها من مُنَاخْ",58,"خ",1,1],["إِن خَطَّ طَرساً فَالدُرَّ مُنتَظِمٌ","أَو قالَ لَفظاً فَجَوهَرٌ بَدَدُ",59,"د",1,0],["إِنَّ خُيولَ الدَهرِ إِن طارَدَت","أَتبَعَتِ الأَوَّلَ بِالأَخِرِ",60,"ر",1,0],["إِن خوطِبوا فَحَديثُهُم وَخِطابُهُم","يَومَ الجِلادِ حَوادِثٌ وَخُطوبُ",61,"ب",1,0],["إِن خاطَبَتها الريحُ رَدَّ لِسانُها","هَمساً كَلَجلَجَةِ اللِسانِ الأَخرَسِ",62,"س",1,0],["إِن خلتِها استمعت إِليكِ وقاربت","ألفيتِهَا صارت كلحدٍ ضيِّقِ",63,"ق",1,0],["إن خانني اليومُ فيك قلتُ غداً","وأين منّي ومن لقاك غَدُ",64,"د",1,0],["أَنَخنا في دِيارِ بَني حَبيبٍ","بَناتِ السَيرِ تَحتَ بَني العَزيمِ",65,"م",1,0],["إِنَّ خَيراً مِمّا رَأَيتُ مِنَ الصَف","حِ عَنِ النائِباتِ وَالإِغماضِ",66,"ض",1,0],["أَنَختُ إِلى ساحاتِهِم وَجَنابِهِم","رِكابي وَأَضحى في دِيارِهِم وَفدي",67,"د",2,0],["إِنَّ خَيرَ النِساءِ عِندي وِصالاً","مَن تُؤاتي بِوَصلِها ما هَوينا",68,"ن",2,0],["إِنَّ خَطباً عَلَيَّ حَقّاً يَسيراً","أَن أَرى مِنكُما بَعيراً حَسيرا",69,"ر",2,0],["أَنَختُ بِهِ وَالبَرقُ يَهفو جَناحَهُ","وَلِلدَيمَةِ الهَطلاءِ حَنَّةُ عاطِفِ",70,"ف",1,0],["أنخونُ النّيل في آمالهِ","ليس هذا إن فعلناه بِزَيْنْ",71,"ن",1,0],["أَنَخونُ أَنفُسَنا وَنُفسِدُ أَمرَنا","أَن قالَ واشٍ أَو أَرادَ حَسودُ",72,"د",1,0],["أَنَخونُ مِصرَ وَما تَحَوَّلَ نيلُها","سُمّاً وَما اِنقَلَبَ الضِياءُ ظَلاما",73,"م",2,0],["أَنَخذِلُها وَنَحنُ لَها حُماةٌ","فَمَن عَنها يُناضِلُ أَو يُحامي",74,"م",2,0],["أنِخِ البعيرَ فقد بلغتَ المسجدا","واخشع ضمامُ فأنتَ في حَرَمِ الهُدَى",75,"د",2,1],["إنّ خيراً من ذلكم جَنَّةُ اللَ","هِ فلا تَعْدِلوا بِتَقواهُ زَادا",76,"د",2,0],["إِنَّ خَصمي لَدى الشَجى","في هَواهُ قَلبٌ وَعَين",77,"ن",1,0],["إِن خابَ غَيرُكَ وَهُوَ أَكثَرُ ناصِراً","وَبَقيتَ لِلإِسلامِ وَحدَكَ مَظَهَرا",78,"ر",2,0],["أَنَختُ بِها مُستَبطِناً ذا كَريهَةٍ","عَلى عَجَلٍ وَالنَومُ بي غَيرُ رائِنِ",79,"ن",1,0],["أَنَخنا بِبَيتِ الزِبرِقانِ وَلَيتَنا","مَضَينَ فَقِلنا وَسطَ بَيتِ المُخَبَّلِ",80,"ل",1,1],["إنَّ خُلْقَ الشُّهودِ وًَالعُمَّالِ","مِثْلَ خُلْقِ العُشَّاقِ والعُذَّالِ",81,"ل",1,1],["إِن خَلا البَيتُ ساعَةً","مَجمَجَ الميمَ بِالقَلَم",82,"م",1,0],["أَنَختُم لَنا ما بَينَ شَربَةِ جيدَةٍ","إِلى الصينِ تُروونَ القَنا وَالمُهَنَّدا",83,"د",2,0],["إِن خُطَّ قَبري نائِياً عَن بَيتِهِ","فَاِجعَل حَنوطي مِن دُقاقِ تُرابِهِ",84,"ب",2,0],["إِنَّ خَيراً مِن اِختِراشِ ضِبابِ الأَر","ضِ لِلناشِئِ اِتِّخاذُ ضَبيبَه",85,"ب",2,0],["إِن خالَفوكَ وَلَم يَجرُر خِلافُهُمُ","شَرّاً فَلا بَأسَ أَنَّ الناسَ أَخيافُ",86,"ف",1,0],["إِن خَتَمَ اللَهُ بِغُفرانِهِ","فَكُلُّ ما لاقَيتُهُ سَهلُ",87,"ل",1,0],["إِن خَيَّمَت أَو ظَعَنَت لِلسُرى","فَهوَ عَلى أَسرارِها خَيَّما",88,"م",2,0],["إِن خَرِفَ الدَهرُ فَهوَ شَيخٌ","يُحَقُّ بِالهَترِ وَالزَمانَه",89,"ن",2,1],["إن خضعتم فما لكم من نصيبٍ","في طوال الدهور إلا السعير",90,"ر",1,0],["إن خفق البارق في عارض","فالقلب من روعته يخفق",91,"ق",1,1],["أَنَخْذُل مَن كُنَّا نَرود بأَرْضِهِ","ونَكْرَع منه في إِناءِ علُومِ",92,"م",1,0],["إنَّ خَمْرَ الحياةِ وَرْدِيَّةُ اللَّو","نِ ولكنَّها سِمامُ القُلوبِ",93,"ب",1,0],["إِن خَفِرَ الْقَلْبُ فَذَاكَ التُّقَى","مَا الثَّوْبُ إِلاَّ ذِمَّةٌ تُخْفَرُ",94,"ر",1,0],["إِنَّ خَطْبَ الفَضْلِ فِي الأُسْتَاذِ لَمْ","يُكْرِ فِي الشِّدَّةِ عَنْ خَطْبِ الأَدَبْ",95,"ب",1,0],["إِنَّ خَيرَ القُصورِ أَصبَحَ مَوهو","باً بِكُرهِ العِدى لِخَيرِ الأَنامِ",96,"م",1,0],["أَنِخها فَأَردِفهُ فَإِن حَمَلَتكُما","فَذاكَ وَإِن كانَ العِقابُ فَعاقِبِ",97,"ب",1,0],["إن خانه ضعف المشيب فطالما","قهر المنابر وهو في ريعانه",98,"ن",2,0],["إنَّ خَمسِينَ حِجَّةً قد كَفَتْ مِنْكِ","لِمَلْءِ الدُنْيا بكلِّ عُجاب",99,"ب",1,0],["إن خمرًا كأسُها من خزف","غيرُ خمر كأسها من ذهب",100,"ب",1,0],["إن خاض نارَ الحرب فهْ","وَ أَهَبُّ من هُوجِ الرياح",101,"ح",1,0],["إن خطَّ أو سوَّد التاريخُ سيرته","تهتزُّ من روعة الذكرى مشاعره",102,"ر",2,0],["أَنَخْنَا بِبَيْتِ الزِّبْرِقَانِ ولَيْتَنَا","مضينا فقلنا وسط بيت المخبَّلِ",103,"ل",1,1],["إنّ خلف اللّيل فجرا نائما","وغدا يصحو فيجتاح الظلاما",104,"م",2,0],["أنِخْها، فأرْدِفْهُ، فإنْ حملَتكُما","فذاك، وإن كان العقاب فماقبِ",105,"ب",1,0],["إنَّ خيراً من أن تعيشَ فتاةٌ","قبضةَ الجهلِ أن تموتَ انتحارا",106,"ر",2,0],["إنَّ خيرَ الشُهورِ إرثاً لشهرٍ","ما تَلقَّى \" أيلولُ \" من شهرِ \" آب\"",107,"ب",1,0],["أن خيرَ الآدابِ ما انهض الشعبَ","وما فكَّ من إسارِ قيود",108,"د",1,0],["أنَخِيلٌ بعالِجٍ، أمْ سَفينٌ","عائِماتٌ، أمْ أُولياتُ خُدُورِ",109,"ر",1,0],["إنْ خاتَلَتْهُ الرّجالُ مِنْ خَمَرٍ،","فَسِرُّه المُسْتَشَارُ لا عَلَنُهْ",110,"ن",2,0],["إنّ خيراً من اختراشِ ضِباب الأر","ضِ، للناشىء، اتخاذُ ضبيبه",111,"ب",2,0],["أنخن على طول السماء وعرضها","يزاحم منها المنكب الضخم منكبا",112,"ب",2,0],["إن خيراً من الشباب بنو الف","ياض للمُشْتري أو المقتاض",113,"ض",1,0],["إن خيرَ الفتوحِ ما جاء عفواً","مثلما يخطبُ الخطيبُ ارتِجالا",114,"ل",2,1],["إن خيراً من التصنع في القر","ب بعادٌ على جفاء وصد",115,"د",1,0],["إن خانك الدهر لا ترجو مساعدة","فالناس للدهر أتباع وأعوان",116,"ن",1,0],["إن خيرَ الزاد تقوى الله والجه","لُ مردودٌ عَلَى مَنْ قد جَهِلْ",117,"ل",1,0],["إنّ خيرَ الأوصافِ في مدح خ","يرِ الخلقِ طُرّاً كفَاكَ عني اختيارُه",118,"ر",2,0],["إن خان صاحبَه الحظُّ استكان له","وقال أمرٌ قضاه ربُّنا فينا",119,"ن",2,0],["إِن خافَتِ الأَزَماتِ كُنتَ غِياثَها","أَو خافَتِ النَكَباتِ كُنتَ المَفزَعا",120,"ع",2,0],["أَنَختَ بِصَنهاجَةَ النائِباتِ","فَفاتَ زَعيمَهُمُ ما أَمَل",121,"ل",1,0],["أَنَختُ لَدَيكَ مَطايا المُنى","وَهَل يَتَعَدّى زُهَيرٌ هَرِم",122,"م",1,0],["إن خص عفوا الهي المحسنين فمن","يرجو المسيء ويدعو كلما عثرا",123,"ر",2,0],["ان خير الرسل خير لكم","من مشى في طرقه البيض أمن",124,"ن",1,0],["إن خط خاطَ على قرطاسهِ حُللاً","يُهدي بهِ الوشيَ للأحياءِ والحِللِ",125,"ل",1,0],["أَنِخ فَهَذِي قِبابُ العِزِّ وَالكَرَمِ","وَقِل فَكُلُّ العُلا في هَذِهِ الخِيَمِ",126,"م",1,1],["إِنْ خُنْتَ بِالْغَيْبِ عَهْدِي","فأَنَّنِي لَمْ أَخُنْكا",127,"ك",2,0],["أَنَخنَا قَلُوصَينا وَأَرسَلتُ صاحِبى","عَلَى الهَولِ يَخفَى مَرَّةً وَيَزولُ",128,"ل",1,1],["إن خالفتْ تلك المحاسنُ فعله","فالسيفُ يُطبَعُ منْ سِواه رئاسه",129,"س",2,0],["إن خطبَ الصدود منكَ وإن طا","لَ على عاشقكَ غيرُ عسيرِ",130,"ر",1,0],["إن خبا نجمك عن هذا الورى","فله في أفق الخلد ذرور",131,"ر",1,0],["أنخ به الآمال فهو الذي","لديه ما خاب رجا آمل",132,"ل",1,0],["إن خلت دنياك من أمثالهم","عاش كل الناس في ظل الصفاء",133,"ا",2,0],["إِن خَفَّتِ الأَحلامُ فَهوَ الراسي","أَو مَرِضَ الزَمانُ فَهوَ الآسي",134,"س",2,0],["أَنِخ بِأَبي نَصرٍ تُنِخ بِمُعَدَّلٍ","يَغَصُّ مَغانيهِ وُفوداً وَطُرّاقا",135,"ق",2,0],["أَنِخ بِالوَزيرِ تَلقَ مِن دونِ بابِهِ","مَوارِدَ بَحرٍ مِن عَطاياهُ مُزبِدِ",136,"د",1,0],["أَنَخْتُ آمَالِي بِهِ فَانْثَنَتْ","عَاطِرَةَ الأَنْفَاسِ من نَفْحَتِهِ",137,"ت",2,0],["أَنَخْتُ هُمُومِي عِنْدَ بَابِ أَبِي زَيْدِ","فَقَدْ أَثْقَلْتُ ظَهْرِي وَزَادَتْ عَلَى الأَيْدِي",138,"ي",1,1],["أَنِخْ عَنَسَ الرَّجَاءِ عَلَى يَقِينٍ","بِأَنْ يَلْقَاكَ بِالْوَجْهِ السَّنِيِّ",139,"ي",1,0],["أَنَخناهُ بِحَيٍّ ذي حِلالِ","إِذا ما ريعَ سَربُهُمُ أَقاموا",140,"م",3,0],["إِنِّ خَلَعْتُ عَلَيْك بُرْدَ مَدائِحي","وَلَوِ اسْتَطَعْتُ خَلَعْتُ بُرْدَ شَبابِي",141,"ب",2,0],["إِنَّ خَيْرَ الْمَعْرُوفِ ما جاءَ لا سِي","نُ سُؤالٍ فِيهِ وَلا واوُ وَعْدِ",142,"د",1,0],["إن خصَّ قَلبي بالغَرام فربُّه","بالحسن من فَرط الملاحَة عمَّه",143,"م",2,0],["أنخ العيسَ بها واِقرأ على","من به طابَت صَلاةً وَسَلاما",144,"م",2,0],["أنخ قبل أن يقضى المنوّخ بغتة","ومت قبل أن تقضى المنون بروحاني",145,"ن",2,0],["أَنِخ راشِداً فِاِنزِل فَما دونَ ضَيفَنا","حِجابٌ سِوى حِصنِ النِساءِ الحَرائِرِ",146,"ر",1,0],["أنخ أَيُّها الراجي عَلى باب فَضلِهِ","مَطايا الرَجا وَاِنزل بِنادي نَدى العينِ",147,"ن",1,0],["أَنخنا لَدَيك مَطايا الرَجا","وَآمالنا وَرَدت مَنهلك",148,"ك",1,0],["أَنَخنا فَسُمناها النِطافَ فَشارِبٌ","قَليلاً وَآبٍ صَدَّ عَن كُلِّ مَشرَبِ",149,"ب",1,0],["إنَّ خيالاً زارَنا وَهنا","مِن عِندكُم هاجَ لنا حُزنا",150,"ن",2,1],["إن خاتلوا أو خادعوا أو نافقوا","فكأنهم بومٌ بذيلِ ظلام",151,"م",1,0],["اِنَّ خَيرَ المدّاحَ مَن مدحَتهُ","شُعراءُ البِلاد في كُل نادي",152,"د",2,0],["أنخوض اللجة اليوم ونمضي","أم ترى نبقى على الناس عيالا ؟",153,"ل",2,0],["إن خسرنا، والكنزُ فينا، فبُعداً","ثم بعداً لنا، ولا تعذلوني",154,"ن",2,0],["أنِخْها فَهَذا مربعُ المجدِ والفَضْلِ","وقِفْ نُملِ أَخبار المعالي ونَسْتَملي",155,"ي",1,1],["إن خضعت في دمعي فدعني وَقُلْ","هذا الذي في خوضه يلعب",156,"ب",1,0],["إِنَّ خَلفَ الميعادِ مِنكَ طِباعٌ","فعدينا إِذا تَفَضَّلتَ هَجرا",157,"ر",2,0],["أَنخنا بِهِ وَنَسيمُ الصَبا","يُناغي ذَوائِبَنا وَالعَذَب",158,"ب",1,0],["إن خانَ عهدَك من تَودُّهْ","ونأَى فلا يَحزُنْك فَقدُهْ",159,"د",2,1],["إِن خُلِّدَت بَعدَ الإِمامِ مُحَمَّدٍ","نَفسي لَما فَرِحَت بِطولِ بَقائِها",160,"ه",2,1],["إن خفّ دوحٌ للمكارمِ أو ذَوى","فالآنَ أورقَ إذ شُفيتَ وأيْنَعا",161,"ع",2,0],["أنخ أيّها الحادي المطيّ وسلّم","فقد نلت أقصى غاية لميمّم",162,"م",1,1],["إن خانني زمني فيكم فليس له","بدع إذا ما رمى حرّا بحرمان",163,"ن",1,0],["ان خانني الدهر فيمن كنت آلفهُ","فالدهر بالبين للإخوان خوان",164,"ن",1,0],["إِنْ خَطَّ فِي جَوِّ السَّماءِ مِثَالَهُ","بَدْراً فَبَيْنَ جَوَانِحِي تَمْثِيلُهُ",165,"ل",2,0],["أنخت ركابي في حماها وغرني","غداة التقينا في الوداع ركوبي",166,"ب",2,0],["أنخنا فأحسنا الظنون وفائز","بنيل نداك الجم من أحسن الظنا",167,"ن",2,0],["أنخت ببابك اللهم","م مهديني لكم حبي",168,"ب",2,0],["أنخ ركابك وامرح في مرابعه","ففي صدور بنيها الملتقى الرحب",169,"ب",1,0],["إن خَبتْ نارٌ فها ذي كبدي","أو جفا الغيثُ فها ذلك جفني",170,"ن",2,0],["إن خار عودُ الآراء شدَّ ال","حزمُ بآرائه المِتانِ",171,"ن",1,0],["إن خَدَعتني حسناء أوصادني","بعد ظباءِ الصَّريم غِزلانُ",172,"ن",1,0],["أنختُ به والظلُّ عني محوَّلٌ","ونوءُ السماءِ قد تقلَّص حبلُهُ",173,"ل",2,0],["إن خان منك الدهرُ عهدي إنما","في نقضه وعلى محاسنه سعى",174,"ع",2,0],["أنخها تُفرِّجْ همَّها بمفرِّجٍ","وطلِّق شقاءَ العيش من بعدُ واسعدِ",175,"د",1,0],["أنخْها على الزوراء شرقيَّ دجلةٍ","بحيث تُقَضَّى للمعالي أمورها",176,"ر",3,0],["أنِخْها ونَمْ إنَّ الرفيق ابنُ همَّةٍ","تُقَضُّ لحاجات الرجال مضاجعُهْ",177,"ع",2,0],["إن خاب ظنّي في الزمان وأعله","فالطِرْف ليس ببدعةٍ أن يعثرا",178,"ر",2,0],["أَنخَت رَجائي في فِناءِ إِخائِهِم","فَما زالَ مَمدوداً عَلَيهِ ظِلالُهُ",179,"ل",2,0],["أَنختُ بِهِم رَجاءً مُضمَحِلّا","مِنَ الإِرقالِ وَالوَخدِ العَنيفِ",180,"ف",1,0],["أنخت مطايا الذل نحوك ملقيا","أكفّ الرجا بين الخيام أؤمّل",181,"ل",1,1],["إن خلصت فروته من يدي","فلا اجتدت ناراً من الزند",182,"د",1,0],["إِن خادَعَتْكَ رُحْ بها معتبِراً","ما صَنَعَتْ بغشِّها فيمَنْ مَضَى",183,"ا",1,0],["أنخونُكُم بالعَهدِ وهْو أمانةٌ","قبضَتْ خَواطِرُنا عليهِ أرهُنا",184,"ن",2,0],["إن خلصتني من البلوى عواطفي","فتلك في كل ملهوف عوائده",185,"د",2,0],["إِن خُصَّ مَدحُهم بطِيبِ ألسُنٍ","فمدحُهُ خُصَّ بِطِيبٍ عَبِقِ",186,"ق",1,0],["إن خَطبُوا فَسُيولُ القولِ دافِقَةٌ","أو حارَبوا فَلَظى الهَيجَاءِ تَشتَعلُ",187,"ل",1,0],["إنَّ خيرَ الناس مَن أذ","نبَ ذنبا ثُم تَابا",188,"ب",2,0],["إِن خَذَلنا اليَومَ ذُهلاً لَهُم","فَغَداً نَحمِلُ عَنهُم ما نُطيقُ",189,"ق",1,0],["إنْ خاف فقراً لم يجُدْ بالنّدى","أو هاب وَشْكَ الموتِ لم يُقْدِمِ",190,"م",1,0],["إنْ خَوّلوا من غير أن يعنوا بما","قَد خوّلوا فكأنّهمْ ما خوّلوا",191,"ل",3,0],["أنخْ في ذُرا الشيخ الرئيس فإِنّما","إلى مثله في المجد كنتَ تَشَوَّفُ",192,"ف",1,0],["أَنِخْ وَاِنضُ أَحلاساً أَكَلنْ جلودَها","فَصِرنَ جُلوداً طالَما أنتَ مُحلِسُ",193,"س",1,0],["أنِخْنَ بمنْ لا نبتغِي بَدَلاً بهِ","فما ضرّ شيئاً أنّكنَّ طَلائحُ",194,"ح",1,0],["أَنَختُ بِها وَالشَمسُ تَنعِقُ بِالضُحى","وَما صاحِبي إِلّا المُدامَةُ وَالجَحلُ",195,"ل",1,0],["أنِخْ هُديتَ الايْنُقا","فَقَدْ وصَلْتَ الأبْرقَا",196,"ق",2,1],["أنخ الركائب في فِناء الدارِ","وَانزْلَ بساحتها نزول الجارِ",197,"ر",1,1],["أُنْخَسُ بالشَّوكِ وقد","أُطعَنُ فيها بالشَّبا",198,"ب",2,0],["إِن خطَّ حطَّم رُمْحَها","أَوصَالَ فلَّ حُسَامَها",199,"م",3,0]]}