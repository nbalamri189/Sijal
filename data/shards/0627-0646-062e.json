.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[106,"شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=179472",""],[106,"انتصار الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179290",""],[106,"شعب واحد ورب واحد","https://www.poetsgate.com/ViewPoem.aspx?id=179304",""],[22,"أَنَخْنَا بِبَيْتِ الزِّبْرِقَانِ ولَيْتَنَا","https://www.poetsgate.com/ViewPoem.aspx?id=19806",""],[100,"حين يصحو الشعب","https://www.poetsgate.com/ViewPoem.aspx?id=50112",""],[11,"ومَرْقَبَة ٍ دونَ السّماءِ عَلَوْتُها","https://www.poetsgate.com/ViewPoem.aspx?id=16831",""],[90,"علموها!","https://www.poetsgate.com/ViewPoem.aspx?id=179031",""],[90,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[90,"أكلة الثريد","https://www.poetsgate.com/ViewPoem.aspx?id=179172",""],[45,"ما بِعَيْنَيْ هذا الغَزَالِ الغَرِيرِ","https://www.poetsgate.com/ViewPoem.aspx?id=31251",""],[45,"ما جَوُّ خَبْتٍ، وَإنْ نأتْ ظُعُنُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31881",""],[46,"لا تُطيعي هواكِ، أيّتُها النف س","https://www.poetsgate.com/ViewPoem.aspx?id=17995",""],[51,"لهف نفسي على العيون المِراضِ","https://www.poetsgate.com/ViewPoem.aspx?id=29407",""]],"verses":[["إِن خَيَّمَت هَذِهِ بِأَرضي","تَحَمَّلَت تِلكَ عَن دِياري",0,"ي",1,0],["إِنَّ خَيرَ الرِماحِ ما شَرِقَت بِال","طَعنِ مِنها مَعاقِدُ الأَكبادِ",1,"د",1,0],["إِن خارَ مِنها عودُهُ","فالمَشرَفِيُّ يُطبَعُ",2,"ع",1,0],["أنِخْها طَليحاتِ المآقي لَواغِباً","بِما اعْتَسَفَتْ من صَحْصَحٍ ومِتانِ",3,"ن",1,0],["إن خانَ سِرَّكِ طَرْفي فالهَوى عَلِقٌ","منّي بقَلْبٍ على الأسرارِ مُؤْتَمَنِ",4,"ن",1,0],["أُنِخْنَ وقَد دانى خُطاها كَلالُها","إليكَ فأدْنَتْها البَشاشةُ والبِشْرُ",5,"ر",1,0],["إِن خِفتِ أَن يَفطُنَ بي","مِنكُم رَقيبٌ فَاِكتُبي",6,"ي",1,0],["أَنَختُ قَلوصي وَاِكتَلَأتُ بِعَينِها","وَآمَرتُ نَفسي أَيَّ أَمرَيَّ أَفعَلُ",7,"ل",1,0],["إِن خانَني فيما فَجِعتُ بِهِ","شِعري فَهَذا الدَمعُ يَشفَعُ لي",8,"ل",2,0],["إِن خانَ وُدّي صَديقٌ كُنتُ أَصحَبُهُ","أَو خانَ عَهدي حَبيبٌ كُنتُ أَهواهُ",9,"ا",2,0],["أَنَختَ إِلى مَظلومَةٍ غَيرِ مَسكِنٍ","حَوامِلُها عوجٌ وَأَفنانُها رَطبُ",10,"ب",1,0],["إن خالطك الأملاك لم ينكروا","محله من رفعةٍ القدر",11,"ر",1,0],["إِنَّ خَطْباً أَدْمَى أَخَاكَ لَخَطْبٌ","بِتَجَنِّيهِ فَوْقَ حِلْمِ الْحَلِيمِ",12,"م",1,0],["أَنَخنَ فَمُغفٍ عِندَ دَفِّ شِمِلَّةٍ","شَمَردَلَةِ الأَلواحِ فانٍ سَنامُها",13,"م",3,0],["أَنَخنا بِها خوصاً بَرى النَصُّ بدُنَها","وَأَلصَقَ مِنها باقِياتِ العَرائِكِ",14,"ك",1,0],["أَنَخنَ لِتَعريسٍ فَمِنهُنَّ صارِفٌ","يُغَنّي بِنابَيهِ مُطَلّحَةً صُعرا",15,"ر",2,0],["إن خاض في ليل العجاج رأيته","يجلو دجُنَّته بوجه نهارِ",16,"ر",1,1],["إن خدمنا فلا تريد جزاء","ومن الأم هل يراد جزاء",17,"ا",2,0],["أَنَخنَ لِتَغويرٍ وَقَد وَقَدَ الحَصى","وَذابَ لُعابُ الشَمسِ فَوقَ الجَماجِمِ",18,"م",1,0],["أَنَخنا فَسَبَّحنا وَنَوَّرَتِ السُرى","بِأَعرافِ وَردِ اللَونِ بُلقٍ شَواكِلُه",19,"ل",2,0],["أَنِخها فَأَردِفهُ فَإِن حَمَلَتكُم","فَذاكَ وَإِن كانَ العِقابُ فَعاقِبِ",20,"ب",1,0],["أُنِخنَ أُدمَاً فَصِرنَ دُهماً وما","غَيَّرَهُنَّ الهِنَاءُ والجَرَبُ",21,"ب",1,0],["أنخن أوما فصرن دهما وما","غيّرهن الهناء والجرب",22,"ب",1,1],["أَنَختُ فيهِنَّ يَعمَلاتٍ","ما عَهدُ إِرقالِها ذَميمُ",23,"م",1,0],["أَنَختُ وَصاحِبايَ بِذي طُلوحٍ","طَلائِحَ شَفَّها وَخدُ القِفارِ",24,"ر",1,0],["إِنَّ خالي خَطيبُ جابِيَةِ الجَو","لانِ عِندَ النُعمانِ حينَ يَقومُ",25,"م",1,0],["إن خابَ سائل أدمعي في حبِّه","فلكثرة الإلحاح والإلحاف",26,"ف",1,0],["إن خانني الزمن المعروف في سببٍ","وخانني زمنٌ في الحلّ والقطن",27,"ن",1,0],["إن خيراً من التَّقَصِّي على الخِل","لِ سَماحٌ في الأخذ والإعطاءِ",28,"ا",2,0],["إن خيراً من أن ترى فيَّ أن قد","فسدتْ نيتي فحقي البوارُ",29,"ر",1,1],["إن خيراً من الشباب بنو الفي","ياض للمُشْتري أوِ المعتاض",30,"ض",1,0],["إن خلف الفضاءِ سَيْباً فضاءً","من عليٍّ يُلْقى إليه مُفاضي",30,"ض",2,0],["إنَّ خُلف الوعيد ليس بعارٍ","لكن العارُ كلُّه خلفُ وعدك",31,"ك",1,0],["إنّ خيراً من ارتفاقِكَ بالْبغ","لِ إذا عُدَّتِ الأمور ارتفاقُك",32,"ك",1,0],["إن خيرَ الثمار ما ردّه الأكْ","لُ مردّاً أُنيطَ ذكراه عنكا",33,"ك",2,0],["أنختُ بحيث تبيضُّ الأيادي","وتسودُّ المطابخُ والبِرامُ",34,"م",1,0],["إِن خِفتَ شَرَّ طَوارِقِ الحَدَثانِ فَ","اِقسِدهُم تُخِفكَ طَوارِقُ الحَدَثانِ",35,"ن",1,0],["إِنَّ خَطبَ البُعدِ عَنكُم","لَيسَ بِالخَطبِ اليَسيرِ",36,"ر",1,0],["أُنِخنَ وَهُنَّ أَغفالٌ عَلَيها","فَقَد تَرَكَ الصِلاءُ بِهِنَّ نارا",37,"ر",2,0],["أَنَخنَ جِمالَهُنَّ بِذاتِ غِسلٍ","سَراةَ اليَومِ يَمهَدنَ الكُدونا",38,"ن",2,0],["أَنَختُ جَديلاً عِندَ بَثنَةَ لَيلَةً","وَيَوماً أَطالَ اللَهُ رَغمَ جَديلِ",39,"ل",1,1],["ان خطبا هز الشآم ومصرا","والعراقين والحجاز جليل",40,"ل",1,0],["ان خير الغناء ما كان يأتي","عن شعور في غفلة الافكار",41,"ر",1,0],["ان خط سطراً فان السطر مكتبة","او قال بيتا فان البيت ديوان",42,"ن",1,0],["إن خيراً به اقتنت مصر قبلاً","غير ما تقتني بهِ مصر بعد",43,"د",1,0],["إِن خَفِيَ النافِعُ فَالنَفعُ ظَهَر","يا سَعدَ مَن صافى وَصوفي وَاِستَتَر",44,"ر",1,0],["إِنَّ خَيرَ الدُموعِ عَوناً لَدَمعٌ","بَعَثَتهُ رِعايَةٌ فَاِستَهَلّا",45,"ل",2,0],["إِن خُلِّيَت رُبِطَت بِآدابِ الوَغى","فَدُعاؤُها يُغني عَنِ الأَرسانِ",46,"ن",1,0],["إنْ خُصَّ حُسْنٌ بالصِّوا","نِ فحسنُه أولَى وأحْرَى",47,"ر",2,0],["أَنَخيلٌ بِعالِجٍ أَم سَفينٌ","عائِماتٌ أَم أُلَياتُ خُدورِ",48,"ر",1,0],["إِنَّ خِلالَ المُعتَزِّ لَيسَ لَها","مُقارِبٌ في السَحابِ يَعشُرُها",49,"ر",3,0],["إِن خاتَلَتهُ الرِجالُ في خَمرٍ","فَسِرُّهُ المُستَشارُ لا عَلَنُه",50,"ن",2,0],["أَنَخنا بِها صُهبَ المَهاري فَجُرِّدَت","مِنَ المَيسِ تَجريدَ السُيوفِ القَواطِعِ",51,"ع",1,0],["أَنَخنا فَأَقبَلنا الرِماحَ وَراءَها","رِماحاً تُساقي بِالمَنايا نِهالُها",52,"ل",3,0],["أَنَخنا ثَلاثاً تَحتَ ضامِنَةِ القِرى","مِنَ الغَليِ يَسمو بِالمُحالِ هَزيمُها",53,"م",3,0],["أُنِخنَ إِلى خَيرِ البَرِيَّةِ ضُمَّراً","دَوامِيَ مِن أَصلابِها وَالمَناسِمِ",54,"م",1,0],["أَنَخنا بِهَجرٍ بَعدَما وَقَدَ الحَصى","وَذابَ لِعابُ الشَمسِ فَوقَ العَمائِمِ",55,"م",1,0],["أَنَخنا إِلَيها مِن حَضيضِ عُنَيزَةٍ","ثَلاثاً كَذَودِ الهاجِرِيِّ رَواسِيا",56,"ي",2,0],["إنْ خالفُوا المجدَ لم يَعْدِلْ مُخالفَةً","أو أخَلفُوا الوَعْدَ لم يُتْبِعْهُ إخلافا",57,"ف",2,0],["أنخْتُ في حانةِ أُترُجَّةٍ","وحبّذا حانتُها من مُنَاخْ",58,"خ",1,1],["إِن خَطَّ طَرساً فَالدُرَّ مُنتَظِمٌ","أَو قالَ لَفظاً فَجَوهَرٌ بَدَدُ",59,"د",1,0],["إِنَّ خُيولَ الدَهرِ إِن طارَدَت","أَتبَعَتِ الأَوَّلَ بِالأَخِرِ",60,"ر",1,0],["إِن خوطِبوا فَحَديثُهُم وَخِطابُهُم","يَومَ الجِلادِ حَوادِثٌ وَخُطوبُ",61,"ب",1,0],["إِن خاطَبَتها الريحُ رَدَّ لِسانُها","هَمساً كَلَجلَجَةِ اللِسانِ الأَخرَسِ",62,"س",1,0],["إِن خلتِها استمعت إِليكِ وقاربت","ألفيتِهَا صارت كلحدٍ ضيِّقِ",63,"ق",1,0],["إن خانني اليومُ فيك قلتُ غداً","وأين منّي ومن لقاك غَدُ",64,"د",1,0],["أَنَخنا في دِيارِ بَني حَبيبٍ","بَناتِ السَيرِ تَحتَ بَني العَزيمِ",65,"م",1,0],["إِنَّ خَيراً مِمّا رَأَيتُ مِنَ الصَف","حِ عَنِ النائِباتِ وَالإِغماضِ",66,"ض",1,0],["أَنَختُ إِلى ساحاتِهِم وَجَنابِهِم","رِكابي وَأَضحى في دِيارِهِم وَفدي",67,"د",2,0],["إِنَّ خَيرَ النِساءِ عِندي وِصالاً","مَن تُؤاتي بِوَصلِها ما هَوينا",68,"ن",2,0],["إِنَّ خَطباً عَلَيَّ حَقّاً يَسيراً","أَن أَرى مِنكُما بَعيراً حَسيرا",69,"ر",2,0],["أَنَختُ بِهِ وَالبَرقُ يَهفو جَناحَهُ","وَلِلدَيمَةِ الهَطلاءِ حَنَّةُ عاطِفِ",70,"ف",1,0],["أنخونُ النّيل في آمالهِ","ليس هذا إن فعلناه بِزَيْنْ",71,"ن",1,0],["أَنَخونُ أَنفُسَنا وَنُفسِدُ أَمرَنا","أَن قالَ واشٍ أَو أَرادَ حَسودُ",72,"د",1,0],["أَنَخونُ مِصرَ وَما تَحَوَّلَ نيلُها","سُمّاً وَما اِنقَلَبَ الضِياءُ ظَلاما",73,"م",2,0],["أَنَخذِلُها وَنَحنُ لَها حُماةٌ","فَمَن عَنها يُناضِلُ أَو يُحامي",74,"م",2,0],["أنِخِ البعيرَ فقد بلغتَ المسجدا","واخشع ضمامُ فأنتَ في حَرَمِ الهُدَى",75,"د",2,1],["إنّ خيراً من ذلكم جَنَّةُ اللَ","هِ فلا تَعْدِلوا بِتَقواهُ زَادا",76,"د",2,0],["إِنَّ خَصمي لَدى الشَجى","في هَواهُ قَلبٌ وَعَين",77,"ن",1,0],["إِن خابَ غَيرُكَ وَهُوَ أَكثَرُ ناصِراً","وَبَقيتَ لِلإِسلامِ وَحدَكَ مَظَهَرا",78,"ر",2,0],["أَنَختُ بِها مُستَبطِناً ذا كَريهَةٍ","عَلى عَجَلٍ وَالنَومُ بي غَيرُ رائِنِ",79,"ن",1,0],["أَنَخنا بِبَيتِ الزِبرِقانِ وَلَيتَنا","مَضَينَ فَقِلنا وَسطَ بَيتِ المُخَبَّلِ",80,"ل",1,1],["إنَّ خُلْقَ الشُّهودِ وًَالعُمَّالِ","مِثْلَ خُلْقِ العُشَّاقِ والعُذَّالِ",81,"ل",1,1],["إِن خَلا البَيتُ ساعَةً","مَجمَجَ الميمَ بِالقَلَم",82,"م",1,0],["أَنَختُم لَنا ما بَينَ شَربَةِ جيدَةٍ","إِلى الصينِ تُروونَ القَنا وَالمُهَنَّدا",83,"د",2,0],["إِن خُطَّ قَبري نائِياً عَن بَيتِهِ","فَاِجعَل حَنوطي مِن دُقاقِ تُرابِهِ",84,"ب",2,0],["إِنَّ خَيراً مِن اِختِراشِ ضِبابِ الأَر","ضِ لِلناشِئِ اِتِّخاذُ ضَبيبَه",85,"ب",2,0],["إِن خالَفوكَ وَلَم يَجرُر خِلافُهُمُ","شَرّاً فَلا بَأسَ أَنَّ الناسَ أَخيافُ",86,"ف",1,0],["إِن خَتَمَ اللَهُ بِغُفرانِهِ","فَكُلُّ ما لاقَيتُهُ سَهلُ",87,"ل",1,0],["إِن خَيَّمَت أَو ظَعَنَت لِلسُرى","فَهوَ عَلى أَسرارِها خَيَّما",88,"م",2,0],["إِن خَرِفَ الدَهرُ فَهوَ شَيخٌ","يُحَقُّ بِالهَترِ وَالزَمانَه",89,"ن",2,1],["إن خضعتم فما لكم من نصيبٍ","في طوال الدهور إلا السعير",90,"ر",1,0],["إن خفق البارق في عارض","فالقلب من روعته يخفق",91,"ق",1,1],["أَنَخْذُل مَن كُنَّا نَرود بأَرْضِهِ","ونَكْرَع منه في إِناءِ علُومِ",92,"م",1,0],["إنَّ خَمْرَ الحياةِ وَرْدِيَّةُ اللَّو","نِ ولكنَّها سِمامُ القُلوبِ",93,"ب",1,0],["إِن خَفِرَ الْقَلْبُ فَذَاكَ التُّقَى","مَا الثَّوْبُ إِلاَّ ذِمَّةٌ تُخْفَرُ",94,"ر",1,0],["إِنَّ خَطْبَ الفَضْلِ فِي الأُسْتَاذِ لَمْ","يُكْرِ فِي الشِّدَّةِ عَنْ خَطْبِ الأَدَبْ",95,"ب",1,0],["إِنَّ خَيرَ القُصورِ أَصبَحَ مَوهو","باً بِكُرهِ العِدى لِخَيرِ الأَنامِ",96,"م",1,0],["أَنِخها فَأَردِفهُ فَإِن حَمَلَتكُما","فَذاكَ وَإِن كانَ العِقابُ فَعاقِبِ",97,"ب",1,0],["إن خانه ضعف المشيب فطالما","قهر المنابر وهو في ريعانه",98,"ن",2,0],["إنَّ خَمسِينَ حِجَّةً قد كَفَتْ مِنْكِ","لِمَلْءِ الدُنْيا بكلِّ عُجاب",99,"ب",1,0],["إن خمرًا كأسُها من خزف","غيرُ خمر كأسها من ذهب",100,"ب",1,0],["إن خاض نارَ الحرب فهْ","وَ أَهَبُّ من هُوجِ الرياح",101,"ح",1,0],["إن خطَّ أو سوَّد التاريخُ سيرته","تهتزُّ من روعة الذكرى مشاعره",102,"ر",2,0],["أَنَخْنَا بِبَيْتِ الزِّبْرِقَانِ ولَيْتَنَا","مضينا فقلنا وسط بيت المخبَّلِ",103,"ل",1,1],["إنّ خلف اللّيل فجرا نائما","وغدا يصحو فيجتاح الظلاما",104,"م",2,0],["أنِخْها، فأرْدِفْهُ، فإنْ حملَتكُما","فذاك، وإن كان العقاب فماقبِ",105,"ب",1,0],["إنَّ خيراً من أن تعيشَ فتاةٌ","قبضةَ الجهلِ أن تموتَ انتحارا",106,"ر",2,0],["إنَّ خيرَ الشُهورِ إرثاً لشهرٍ","ما تَلقَّى \" أيلولُ \" من شهرِ \" آب\"",107,"ب",1,0],["أن خيرَ الآدابِ ما انهض الشعبَ","وما فكَّ من إسارِ قيود",108,"د",1,0],["أنَخِيلٌ بعالِجٍ، أمْ سَفينٌ","عائِماتٌ، أمْ أُولياتُ خُدُورِ",109,"ر",1,0],["إنْ خاتَلَتْهُ الرّجالُ مِنْ خَمَرٍ،","فَسِرُّه المُسْتَشَارُ لا عَلَنُهْ",110,"ن",2,0],["إنّ خيراً من اختراشِ ضِباب الأر","ضِ، للناشىء، اتخاذُ ضبيبه",111,"ب",2,0],["إن خيراً من الشباب بنو الف","ياض للمُشْتري أو المقتاض",112,"ض",1,0]]}