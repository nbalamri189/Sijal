"],[6102,"يَفعَلُ البُعدُ ..","https://www.poetsgate.com/ViewPoem.aspx?id=185335",""],[6125,"في ضَيِّ عينيكِ القصيدُ تَبَعثَرا","https://www.poetsgate.com/ViewPoem.aspx?id=210971",""],[5309,"سلام على ذكر العلى سالف العهد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573521",""],[6164,"ماض وحاضر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66043&r=&rc=52",""],[6204,"إلى صديق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69140&r=&rc=12",""],[4983,"ارتعاشات الهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82964&r=&rc=4",""],[6333,"دمى فوق منضدة الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7088&r=&rc=9",""]],"verses":[["في ضُمَّرٍ يَخرُجنَ مِن حُلَلِ الدُجى","كَالغُضفِ خارِجَةً مِنَ الأَرسانِ",0,"ن",1,0],["فَيَضْحَكُ أَحْيَاناً وَيَعْبِسُ تَارَةً","فَمِنْ ضَحِكٍ يَأَتِي وَمِنْ عَبْرَةٍ تَمْضِي",1,"ض",2,0],["فَيضاً كَما فاضَت غُروبُ","المُترَعاتِ مِنَ النَواضِح",2,"ح",1,0],["فَيضاً كَما اِنخَرَقَ الجُمانُ","وَجالَ في سِلكِ النَواظِم",3,"م",1,0],["فِي ضِفَّتَيْهِ وَفِي تَغْرِيدِ صَادِحِهِ","مَا فِي نَظِيمِكَ بَيْنَ الْوَحْيِ وَالكَلمِ",4,"م",1,0],["فَيْضُ مَوْسُوعَةٍ مِنْ العِلْمِ وَالآ","دَابِ فِيهَا جَوَابُ كُلِّ سُؤَالِ",5,"ل",1,0],["في ضُمُّرٍ مِن مَهارى قَد أَضَرَّ بِها","سَيرُ النَهارِ وَإِسآدٌ وَإِسآدُ",6,"د",1,0],["فَيضْؤُل من حيث فَخَّمته","لِفَضْل المغيب على المشهدِ",7,"د",1,0],["في ضمنيَ النجح من قب","لِ أن يُشير مشير",8,"ر",1,0],["فيضرط هذا على رجله","ويضرط هذا على أربعه",9,"ع",2,0],["في ضَحوَةٍ وَقَفَ النَسيمُ بِها","مُتَرَدِّداً في صَفحَةِ النَهرِ",10,"ر",1,0],["في ضفَّتَيْهِ مُردِّداتٍ","نَغْمَةَ الحُلْمِ الوَديعْ",11,"ع",1,0],["في ضفَّتيه عرائسُ","الأَشْعارِ تنصُبُ مأتما",11,"م",2,0],["في ضجَّةِ البَحر المجلجِل","في هَدير العاصفهْ",12,"ه",1,0],["فيضي كَأَمسِ عَلى العُلومِ مِنَ النُهى","وَعَلى الفُنونِ مِنَ الجَمالِ السَرمَدي",13,"د",2,0],["فيضا عَلى الأَوطانِ مِن حُرِيَّةٍ","فَكِلاكُما المُفتَكُّ مِن أَغلالِهِ",14,"ل",2,0],["في ضُروبٍ مِن حُسنِ نَرجِسِهِ الغَضِّ","وَمِن آسِهِ وَمِن زَعفَرانِه",15,"ن",2,0],