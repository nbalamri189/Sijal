 قد لاذ بالغمض","https://www.poetsgate.com/ViewPoem.aspx?id=34170",""],[100,"منها وإليها","https://www.poetsgate.com/ViewPoem.aspx?id=50159",""],[51,"يبيع الكماة الذائدون دماءهُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=27702",""],[10,"يا عَينِ جُودي بالدّموع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10485&r=&rc=10",""]],"verses":[["في ضُمَّرٍ يَخرُجنَ مِن حُلَلِ الدُجى","كَالغُضفِ خارِجَةً مِنَ الأَرسانِ",0,"ن",1,0],["فَيَضْحَكُ أَحْيَاناً وَيَعْبِسُ تَارَةً","فَمِنْ ضَحِكٍ يَأَتِي وَمِنْ عَبْرَةٍ تَمْضِي",1,"ي",1,0],["فَيضاً كَما فاضَت غُروبُ","المُترَعاتِ مِنَ النَواضِح",2,"ح",1,0],["فَيضاً كَما اِنخَرَقَ الجُمانُ","وَجالَ في سِلكِ النَواظِم",3,"م",1,0],["فِي ضِفَّتَيْهِ وَفِي تَغْرِيدِ صَادِحِهِ","مَا فِي نَظِيمِكَ بَيْنَ الْوَحْيِ وَالكَلمِ",4,"م",1,0],["فَيْضُ مَوْسُوعَةٍ مِنْ العِلْمِ وَالآ","دَابِ فِيهَا جَوَابُ كُلِّ سُؤَالِ",5,"ل",1,0],["في ضُمُّرٍ مِن مَهارى قَد أَضَرَّ بِها","سَيرُ النَهارِ وَإِسآدٌ وَإِسآدُ",6,"د",1,0],["فَيضْؤُل من حيث فَخَّمته","لِفَضْل المغيب على المشهدِ",7,"د",1,0],["في ضمنيَ النجح من قب","لِ أن يُشير مشير",8,"ر",1,0],["فيضرط هذا على رجله","ويضرط هذا على أربعه",9,"ع",2,0],["في ضَحوَةٍ وَقَفَ النَسيمُ بِها","مُتَرَدِّداً في صَفحَةِ النَهرِ",10,"ر",1,0],["في ضفَّتَيْهِ مُردِّداتٍ","نَغْمَةَ الحُلْمِ الوَديعْ",11,"ع",1,0],["في ضفَّتيه عرائسُ","الأَشْعارِ تنصُبُ مأتما",11,"م",2,0],["في ضجَّةِ البَحر المجلجِل","في هَدير العاصفهْ",12,"ه",1,0],["فيضي كَأَمسِ عَلى العُلومِ مِنَ النُهى","وَعَلى الفُنونِ مِنَ الجَمالِ السَرمَدي",13,"د",2,0],["فيضا عَلى الأَوطانِ مِن حُرِيَّةٍ","فَكِلاكُما المُفتَكُّ مِن أَغلالِهِ",14,"ل",2,0],["في ضُروبٍ مِن حُسنِ نَرجِسِهِ الغَضِّ","وَمِن آسِهِ وَمِن زَعفَرانِه",15,"ن",2,0],["فَيَضحَكُ حينَ أوهِمُهُ وَيَبكي","فَيوهِمُني الخَديعَةَ وَالوَدادا",16,"د",2,0],["فيض من النسيان يغمرني","إني لأحمد سيله العرما",17,"م",2,0],["في ضِرامٍ مِنَ الوَغى وَاِشتِعالٍ","تَحسَبُ الجَوَّ مِنهُما مَهموما",18,"م",2,0],["في ضَمانِ المَشرَفِيِّ بِهِ","وَقعَةٌ لِلعُربِ في العَجَمِ",19,"م",1,0],["فيضحك الرضى","وَتبسم المنى",20,"ن",2,0],["في ضفتيهِ باسقاتُ النخيلْ","ترعى الشياهُ تحتها ثاغيهْ",21,"ه",1,0],["في ضفافٍ كلُّ ما فيها جميلْ","تُنبِتُ الحبّ وتُنمي وتُنيلْ",22,"ل",1,0],["فَيَضْحَكُ وَالآفَاقُ تَبْكِي حِيَالَهُ","وَفِي غَيْرِهِ بُؤْسٌ وَفِيهِ حُبُورُ",23,"ر",1,0],["في ضوءِ خافقةٍ في الريف شعلتها","كالسِّر ما بينَ إعلانٍ وكِتْمَانِ",24,"ن",1,0],["فيضحك أحيانا ويعبث تارة","فمن ضحك يأتي ومن عبرة تمضي",25,"ض",2,0],["في ضلوعي إليك شوق وقلب","شاعر يعزف الصبابات شدوا",26,"و",2,0],["فَيضْؤُل من حيث فَحَّمَته","لفضْل المغيب على المشهد",27,"د",1,0],["فَيْضاً كما فاضَتْ غُرُوبُ","بُ المترعاتِ منَ النَّواضحْ",28,"ح",1,0]]}