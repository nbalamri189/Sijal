ى","فأومت بإقبال فجُدنا بأنفس",78,"س",1,0],["وفُكَّ أَغْلالا طبيعيَّةً","عليه مكبولا بها مُوثَقا",79,"ق",2,0],["وفَكْيَ من أَغلال جسميَ شَهْوَةً","لَقيِتُ بها في الذِّلِّ كلَّ لِقاءِ",80,"ا",2,0],["وَفُكَّ لأَسرِ عُبَيدٍ لَكُم","غَدَا خائِفاً مِن أُمُورٍ عِظَام",81,"م",1,0],["وفكري إذا فكَّرتُهُ في جمالهم","فهم بَصَري في العالَمين وهم سَمعي",82,"ع",2,0],["وفكرة يثقب وقادها","كنه المعاني قبل إمعانها",83,"ن",3,0],["وفكرة كالزناد الواري","تقدح بالفقه والمرفان",84,"ن",1,0],["وَفكّكَ لحَييهِ فَلمّا تَعادَيا","صَأَى ثُمَ أَقعى والبِلادُ بلاقِعُ",85,"ع",1,0],["وفكري قد حار في حسنه","ووجدي بإحسانه قد كمل",86,"ل",1,0],["وفكر له من نصرة الحق مذهب","إذا اختلفت طوع الزمام النجائب",87,"ب",1,0],["وفكر له من نصرة الحق مذهب","إذا اختلفت في العالمين المذاهب",87,"ب",1,0],["وَفِكري مَقسُومٌ وعَقليَ مُولَهٌ","ودَمعِيَ مسفوحٌ وَدَاري بَلاقِعُ",88,"ع",1,0],["وفكرة عم البرايا رشدها","والشمس لا تختص فيها بلد",89,"د",1,0],["وفكر يفوق الشمس في ضؤ حسنه","وعزة قدر لا يماثلها السها",90,"ه",2,0],["وفكرة من بحار العلم قد رشفت","فانهل منها بسحب الفضل اغداق",91,"ق",1,0],["وفكر بالذكا في كل خطب","غدا يزرى اياس ومادحيه",92,"ي",2,0],["وفكرة اطلعت شمس الذكا فغدا","بضؤها لخفاء الأمر تبيان",93,"ن",1,0],["وفكرة باسمها السارى ينال هدى","والليل منسدل الجلباب عاكره",94,"ر",2,0],["وفك طلسم ما في الكنز من درر","فاِعجَب لدر ثمين دون مَكنون",95,"ن",1,0],["وفكره الجوهر الشفاف إن بخلت","أفكار أهل النهى جادت قرائحه",96,"ح",2,0],["وفك طلسم قولي","تومي إليه الرموز",97,"ز",1,0],["وفكرتُ ما معنى غِناه إذا به","يخاطبني أن عِش كما أنا عائش",98,"ش",1,0],["وفكر بعقلك في جرأةٍ","وقل دون دور ولا لفلفه",99,"ف",2,0],["وفكّ إسارى حسبة لقصائدي","وإطلاق ورقائي من المحل والجدب",100,"ب",1,0],["وفككتّ أسرَ المذنبين بأسرهم","في ذا الختان فلست تترك مجرما",101,"م",2,0],["وَفِكرٍ طَلُّهُ وَبلُ","لنَدبٍ فَضلُه أصلُ",102,"ل",1,1],["وفَكِّر زماناً فِي النتيجة إنه","مَا ضل فِيهَا ساعياً يتفكَّرُ",103,"ر",1,0],["وفكرَةٍ تنظمُ القَريضَ وَلَو","سَطَت عَلَيها الهُمومُ والكرَبُ",104,"ب",1,0],["وفكرٌ في ليالي مشكلاتٍ","محتها من مشارقه البدور",105