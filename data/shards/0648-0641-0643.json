ان الطفوله","https://www.poetsgate.com/ViewPoem.aspx?id=139692",""],[4875,"سلامتك","https://www.poetsgate.com/ViewPoem.aspx?id=133837",""],[4929,"تصادم الأزمنة.","https://www.poetsgate.com/ViewPoem.aspx?id=199354",""],[4929,"رنين الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=210844",""],[4984,"أفكارنا","https://www.poetsgate.com/ViewPoem.aspx?id=180121",""],[4119,"لكم من فؤادي ما اباحكم الوجد","https://www.poetsgate.com/ViewPoem.aspx?id=16112",""],[5096,"هل ...؟","https://www.poetsgate.com/ViewPoem.aspx?id=206638",""],[5122,"(( لا حرزت راحه ولا مربح أحرزت ))","https://www.poetsgate.com/ViewPoem.aspx?id=26734",""],[5136,"قمر أهل على الغصون من البكور","https://www.poetsgate.com/ViewPoem.aspx?id=121576",""],[5150,"المسرح الحر","https://www.poetsgate.com/ViewPoem.aspx?id=202875",""],[5150,"بمن تفكرين ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203780",""],[5186,"حي المشيد للعمران تكريما","https://www.poetsgate.com/ViewPoem.aspx?id=156456",""],[5213,"أعرّست على العذيب العرب","https://www.poetsgate.com/ViewPoem.aspx?id=170410",""],[5323,"أهون ما القى !","https://www.poetsgate.com/ViewPoem.aspx?id=209176",""],[592,"شكت فجشت مذ أعلنت بجشاها","https://www.poetsgate.com/ViewPoem.aspx?id=128712",""],[5486,"الدهشة الكبرى.","https://www.poetsgate.com/ViewPoem.aspx?id=210725",""],[5674,"دير الزور ( افتقدتك بشدة )","https://www.poetsgate.com/ViewPoem.aspx?id=187633",""],[5703,"الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=216044",""],[5720,"سَكْرَة الجَوَىٰ","https://www.poetsgate.com/ViewPoem.aspx?id=198975",""],[5732,"غنيت ما قصدي طرب","https://www.poetsgate.com/ViewPoem.aspx?id=177854",""],[5953,"قد مسني الشيطان يا سيدي","https://www.poetsgate.com/ViewPoem.aspx?id=93882",""],[6070,"إذا ما كنتَ تَرغَبُ في النَّجاحِ","https://www.poetsgate.com/ViewPoem.aspx?id=191615",""],[4442,"الدر في التاج غير الدر السدف","https://www.poetsgate.com/ViewPoem.aspx?id=171197",""],[5001,"ماذا أريد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80713&r=&rc=3",""]],"verses":[["وَفَكَكنا غُلَّ اِمرِئِ القَيسِ عَنهُ","بَعدَ ما طالَ حَبسُهُ وَالعَناءُ",0,"ا",2,0],["وَفِكرُكَ في خِصبِهِ ثَروَةٌ","لِفِكرِ الأَديبِ إِذا ما اِفتَقَر",1,"ر",1,0],["وفَكّ أسار القوم حتى تحفّزوا","نهوضاً إلى العلياء من كل مَجْثَم",2,"م",1,0],["وَفَكَّ أَبا الجَوّابِ عَمروُ بنُ خالِدٍ","وَما كانَ عَنهُ ناكِلاً حَيثُ يَمَّما",3,"م",2,0],["وفكرة ذات ألفاظ منوّرة","يكاد سامعها يجني البساتينا",4,"ن",2,0],["وفُكِّه معشرٌ ضعفاءُ مثلي","ولكن كلُّهم طبِنٌ حيولُ",5,"ل",1,0],["وفُكاهاتِ فتيةٍ هُمْ إذا شِئْ","تُ إدامٌ للْعيشِ خيرُ إدام",6,"م",1,0],["وفكرة بمساعي","ها المشكلات تحل",7,"ل",1,0],["وَفِكرٌ وَإِن عَقَلَتهُ الحَياةُ","يَظَلُّ بِوادي المَنايا يَرود",8,"د",1,0],["وفِكْرٍ خواطِرُهُ أَلبسَتْ","عُلاكَ من المَجْدِ ثوباً خَطيرا",9,"ر",2,0],["وَفِكري في حَياةٍ أَو وَفاةٍ","لِأُرضي كُلَّ فاتِنَةٍ وَفاتِن",10,"ن",1,0],["وفكَّهني في جنِي غرسِهِ","ولا سيَّما بيتُ ما النافيَهْ",11,"ي",2,0],["وَفَكٍّ إِذا غَنّى يُحَرِّكُ لِحيَةً","كَمِثلِ ذُنابى صَعوَةٍ لَيسَ بِالواني",12,"ي",1,0],["وَفِكري سَلَّ حُبَّ المالِ مِنّي","وَوَجدي بِالحَياةِ أَطالَ شَعفي",13,"ف",2,0],["وَفكر طول الدرب في السبب الَّذي","دعاه إِلى الوالي وَلا شيء يقنع",14,"ع",1,0],["وفكرة في العلى والفكر دائبة","ليست على أمدٍ في الفضل مقتصره",15,"ر",2,0],["وَفَكَّ عُرى صَبري وَهاجَت صَبابَتي","رُسومُ دِيارٍ قَد عَفَت وَعِراتِ",16,"ت",1,0],["وفكرةٍ صُوِّرت نُضاراً","وحكمةٍ نُظِّمت عقودا",17,"د",2,0],["وفكرةٌ لو تمشّت نحوَ معضلةٍ","صفت مواردُها من كلِّ تعقيد",18,"د",1,0],["وفكرٌ يلمَحُ الأقدارَ حتى","يكاد يردُّها للغيْبِ رَدّا",19,"د",2,0],["وَفَكَّ رُموزَ السحرِ من أرضِ بابلٍ","لأجلكَ حتى استنْجَدَتْ بكَ بَابِلُهْ",20,"ل",2,0],["وَفِكْرٍ لهُ مِنْ فطْرَةِ الرُّومِ دِقَّةٌ","ومِنْ نَفَحاتِ العُرْبِ حُسْنُ تَأَلُقِ",21,"ق",1,0],["وفكرك في قدر فائت","وفي مقبل رتبة واحده",22,"د",2,0],["وفككنا غل امرىء القيس عن","ه بعدما طال حبسه والعناء",23,"ا",2,0],["وفكُّوا شِدْقَ مُؤتذِبٍ خبيث","وسُلُّوا حَقَّكم منه انتزِاعا",24,"ع",2,0],["وفُكاهاتٌ عِذابٌ","تَتَمَنّاها النُّفُوسُ",25,"س",1,0],["وفكرْ في مداخلها لئلا","ترى أعقابها خَطْبا فَظيعَا",26,"ع",2,0],["وَفَكَّ الرِجالَ وَكُلُّ اِمرِئٍ","إِذا أَصلَحَ اللَهُ يَوماً صَلَح",27,"ح",1,0],["وفكرٍ يكادُ اليومُ من صدقِ حدسهِ","يُخَبِّرهُ عما سيحصل في غدِ",28,"د",1,0],["وفكرتي ليس يعنيها سوى طلبً","للمجد أو أثرٍ في الكون مشهودِ",29,"د",1,0],["وَفِكرٌ يُريهِ الأَمرَ أَبلَجَ واضِحاً","وَمِن دونِهِ لَيلٌ مِنَ الغَيبِ مُسوَدُّ",30,"د",1,0],["وفككتَ عنه فكم فصولٍ تنتقى","ونظرتَ فيه فكم فصوصٍ تُنتقد",31,"د",1,0],["وفكّر فيما رأى خاطرِي","فقلتُ البحارُ مكان الشَّبَك",32,"ك",1,0],["وَفَكِّرْ فيِ انْتِهَاءٍ فيِ ابْتِدَاءٍ","وَشَاوِرْ ذَا الدَّهَاءِ لَدَى الْتِخَاخِ",33,"خ",1,0],["وفكر ثم قال له إذا لم","توفق للصواب فما احتيالي",34,"ل",2,0],["وَفُكَّ صَليبُ الشِركِ مِن قَيدِ أَسرِهِ","وَزُلزِلَ عَرشُ المُلكِ مِن بَعدِ ما اِستَقَر",35,"ر",1,0],["وَفَكّاكُ العُناةِ أَبو ثُبَيتٍ","يَزيدٌ بَعدَهُ مِنّا يَزيدُ",36,"د",1,0],["وفكر ملؤه ثقة","بعدل اللَه والقدر",37,"ر",1,0],["وَفِكري في غَيبي لِعَينِيَ مَشهَدٌ","لِصُبحِ الرِضى لي مِن دُجى اللَيلِ سالِخُ",38,"خ",1,0],["وفكر في ذنوبك","واخلاق قبيحات",39,"ت",1,0],["وفكوا عن الأفكار قياد شغلها","لتسبح في عمرانها وخلاها",40,"ا",3,0],["وفُكَّ إسار لَذاتٍ عَوانٍ","ببِكْرٍ مِن كُؤوسِكَ أوْ عَوانِ",41,"ن",1,0],["وَفُكَّت بِكَ الأَسرى الَّتي شُيِّدَت لَها","مَحابِسُ ما فيها حَميمٌ يَزورُها",42,"ه",2,1],["وفكاهات إذا أوْرَدَها","نُظِمَتْ فوق الحميَّا حببا",43,"ب",2,0],["وفُكَّ من الشِّرك أسِري وكا","ن غُلّاً على مَنكِبي مُقفَلا",44,"ل",2,0],["وفكَّرَ العقْلُ في الدنيا وشيمَتِها","وأنَّها ما لها بُقْيا على أحَدِ",45,"د",1,0],["وفكَّاكُ العُناةِ بكُلِّ أرْضٍ","إذا ما حَبَّبَ الموْتَ الإِسارُ",46,"ر",1,0],["وفكري صحيحٌ على ما عهدتَ","وأن مني الجسم مني بوهن",47,"ن",1,0],["وفكِّر رويداً هل يعدون سالماً","إلى آدم أم هل يرون ابن سالم",48,"م",1,0],["وفكْرةٌ علِمتْ معْناكَ حين رَوَتْ","عنكَ المَعاني وأسْنادَ الهَوَى نقَلتْ",49,"ت",1,0],["وفكرٌ عندكُمْ ما فيه إِلاَّ","حديثُكُمُ المُسَلْسَلُ والوَفاءُ",50,"ا",2,0],["وفكّ عن المُلْكِ الوِثاقَ فأصبحَتْ","شَياطينُه من قَهرِه في سَلاسِلِ",51,"ل",1,0],["وفكّ الجودُ أغلالَ العَطايا","وأمسى البُخل