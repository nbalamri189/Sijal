{"poems":[[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[86,"نعاك النعاة وحم القدر","https://www.aldiwan.net/poem10471.html","المتقارب"],[88,"يقولون في الإسلام ظلما بأنه","https://www.aldiwan.net/poem45024.html","الطويل"],[4,"عفا الرسم أم لا بعد حول تجرما","https://www.aldiwan.net/poem21202.html","الطويل"],[72,"أعدى بغيركم دمع المحبينا","https://www.aldiwan.net/poem20172.html","البسيط"],[51,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[89,"فيك المدائح تحلو","https://www.aldiwan.net/poem44969.html","المجتث"],[85,"أصاب المجاهد عقبى الشهيد","https://www.aldiwan.net/poem62887.html","المتقارب"],[61,"ثنت لك أعطافها والخصورا","https://www.aldiwan.net/poem51673.html","المتقارب"],[66,"لسيري في الفلا والليل داج","https://www.aldiwan.net/poem41557.html","الوافر"],[69,"سلام على نفسك الزاكيه","https://www.aldiwan.net/poem29245.html","المتقارب"],[52,"وكم جولة لا يحسن البغل مثلها","https://www.aldiwan.net/poem26615.html","الطويل"],[46,"غدونا مثقلين بما اكتسبنا","https://www.aldiwan.net/poem22996.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85386","الطويل"],[72,"","https://poetry.dctabudhabi.ae/diwan/poem/40678","البسيط"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10234","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54274","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54218","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54235","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54231","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54228","الطويل"],[6,"معلقة الحارث بن حلزة اليشكري","https://www.poetsgate.com/ViewPoem.aspx?id=11409",""],[90,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[86,"يارَئيسَ الشِّعرِ قُل لي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13059&r=&rc=14",""],[126,"وإن شئت استباحة كل أمر","https://www.aldiwan.net/poem50575.html","الوافر"],[129,"مدحت يزيد بن عبد المدان","https://www.aldiwan.net/poem24165.html","المتقارب"],[133,"بعيد اللقا وافى وأنجز موعدي","https://www.aldiwan.net/poem49122.html","الطويل"],[133,"لا للقدود ولا للأعين السود","https://www.aldiwan.net/poem49190.html","البسيط"],[141,"هواكم وإن لم تسعفونا ولم تجدوا","https://www.aldiwan.net/poem11744.html","الطويل"],[164,"أعلي قد وافى كتابك فانطفا","https://www.aldiwan.net/poem47091.html","الكامل"],[183,"رأيت ببابك هذا المنيف","https://www.aldiwan.net/poem14718.html","المتقارب"],[235,"أقول لمن يصيخ إلى اصطراخي","https://www.aldiwan.net/poem18130.html","الوافر"],[254,"سرى متعرضا طيف الخيال","https://www.aldiwan.net/poem48456.html","الوافر"],[280,"أتى نعي ملك أظلم الشمس والقمر","https://www.aldiwan.net/poem32742.html","الطويل"],[320,"أتصرم أم تواصلك النجود","https://www.aldiwan.net/poem56354.html","الوافر"],[340,"إليك إليك يا وطني","https://www.aldiwan.net/poem55317.html","مجزوء الوافر"],[347,"سواي لميل الحب عنه يفاسخ","https://www.aldiwan.net/poem15565.html","الطويل"],[388,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[400,"شكت بلسان الحال طول جفاها","https://www.aldiwan.net/poem33365.html","الطويل"],[402,"تعال إلى الصواني مترعات","https://www.aldiwan.net/poem49698.html","الوافر"],[407,"وفكت بك الأسرى التي شيدت لها","https://www.aldiwan.net/poem67494.html","الطويل"],[413,"سكب الدمع لها فانسكبا","https://www.aldiwan.net/poem54052.html","الرمل"],[456,"سلا من سلا من بنا استبدلا","https://www.aldiwan.net/poem56005.html","المتقارب"],[459,"من شاء يعلم ما خص الوزير به","https://www.aldiwan.net/poem16132.html","البسيط"],[459,"له بالمجد أنس مطمئن","https://www.aldiwan.net/poem16135.html","الوافر"],[462,"متى لمتني في الغوزال الأغنِ","https://www.aldiwan.net/poem3326.html","عموديه"],[493,"أقول لإحدى المعضلات العظائم","https://www.aldiwan.net/poem10271.html","الطويل"],[498,"شرافة الشوق لا زالت تطول إلى","https://www.aldiwan.net/poem38058.html","البسيط"],[498,"علامة حبكم قلب لهيف","https://www.aldiwan.net/poem38104.html","الوافر"],[512,"أما ومواضي مقلتيها الفواصل","https://www.aldiwan.net/poem20797.html","الطويل"],[512,"هلم بنا إلى أرض الحجون","https://www.aldiwan.net/poem20805.html","الوافر"],[536,"وحقك يا منيتي ما أحب","https://www.aldiwan.net/poem48284.html","عموديه"],[561,"غرام سقى قلبي مدامته صرفا","https://www.aldiwan.net/poem13596.html","الطويل"]],"verses":[["وَفَكَكنا غُلَّ اِمرِئِ القَيسِ عَنهُ","بَعدَ ما طالَ حَبسُهُ وَالعَناءُ",0,"ا",2,0],["وَفِكرُكَ في خِصبِهِ ثَروَةٌ","لِفِكرِ الأَديبِ إِذا ما اِفتَقَر",1,"ر",1,0],["وفَكّ أسار القوم حتى تحفّزوا","نهوضاً إلى العلياء من كل مَجْثَم",2,"م",1,0],["وَفَكَّ أَبا الجَوّابِ عَمروُ بنُ خالِدٍ","وَما كانَ عَنهُ ناكِلاً حَيثُ يَمَّما",3,"م",2,0],["وفكرة ذات ألفاظ منوّرة","يكاد سامعها يجني البساتينا",4,"ن",2,0],["وفُكِّه معشرٌ ضعفاءُ مثلي","ولكن كلُّهم طبِنٌ حيولُ",5,"ل",1,0],["وفُكاهاتِ فتيةٍ هُمْ إذا شِئْ","تُ إدامٌ للْعيشِ خيرُ إدام",6,"م",1,0],["وفكرة بمساعي","ها المشكلات تحل",7,"ل",1,0],["وَفِكرٌ وَإِن عَقَلَتهُ الحَياةُ","يَظَلُّ بِوادي المَنايا يَرود",8,"د",1,0],["وفِكْرٍ خواطِرُهُ أَلبسَتْ","عُلاكَ من المَجْدِ ثوباً خَطيرا",9,"ر",2,0],["وَفِكري في حَياةٍ أَو وَفاةٍ","لِأُرضي كُلَّ فاتِنَةٍ وَفاتِن",10,"ن",1,0],["وفكَّهني في جنِي غرسِهِ","ولا سيَّما بيتُ ما النافيَهْ",11,"ي",2,0],["وَفَكٍّ إِذا غَنّى يُحَرِّكُ لِحيَةً","كَمِثلِ ذُنابى صَعوَةٍ لَيسَ بِالواني",12,"ي",1,0],["وَفِكري سَلَّ حُبَّ المالِ مِنّي","وَوَجدي بِالحَياةِ أَطالَ شَعفي",13,"ف",2,0],["وَفكر طول الدرب في السبب الَّذي","دعاه إِلى الوالي وَلا شيء يقنع",14,"ع",1,0],["وفكرة في العلى والفكر دائبة","ليست على أمدٍ في الفضل مقتصره",15,"ر",2,0],["وَفَكَّ عُرى صَبري وَهاجَت صَبابَتي","رُسومُ دِيارٍ قَد عَفَت وَعِراتِ",16,"ت",1,0],["وفكرةٍ صُوِّرت نُضاراً","وحكمةٍ نُظِّمت عقودا",17,"د",2,0],["وفكرةٌ لو تمشّت نحوَ معضلةٍ","صفت مواردُها من كلِّ تعقيد",18,"د",1,0],["وفكرٌ يلمَحُ الأقدارَ حتى","يكاد يردُّها للغيْبِ رَدّا",19,"د",2,0],["وَفَكَّ رُموزَ السحرِ من أرضِ بابلٍ","لأجلكَ حتى استنْجَدَتْ بكَ بَابِلُهْ",20,"ل",2,0],["وَفِكْرٍ لهُ مِنْ فطْرَةِ الرُّومِ دِقَّةٌ","ومِنْ نَفَحاتِ العُرْبِ حُسْنُ تَأَلُقِ",21,"ق",1,0],["وفككنا غل امرىء القيس عن","ه بعدما طال حبسه والعناء",22,"ا",2,0],["وفكُّوا شِدْقَ مُؤتذِبٍ خبيث","وسُلُّوا حَقَّكم منه انتزِاعا",23,"ع",2,0],["وفُكاهاتٌ عِذابٌ","تَتَمَنّاها النُّفُوسُ",24,"س",1,0],["وفكرْ في مداخلها لئلا","ترى أعقابها خَطْبا فَظيعَا",25,"ع",2,0],["وَفَكَّ الرِجالَ وَكُلُّ اِمرِئٍ","إِذا أَصلَحَ اللَهُ يَوماً صَلَح",26,"ح",1,0],["وفكرٍ يكادُ اليومُ من صدقِ حدسهِ","يُخَبِّرهُ عما سيحصل في غدِ",27,"د",1,0],["وفكرتي ليس يعنيها سوى طلبً","للمجد أو أثرٍ في الكون مشهودِ",28,"د",1,0],["وَفِكرٌ يُريهِ الأَمرَ أَبلَجَ واضِحاً","وَمِن دونِهِ لَيلٌ مِنَ الغَيبِ مُسوَدُّ",29,"د",1,0],["وفككتَ عنه فكم فصولٍ تنتقى","ونظرتَ فيه فكم فصوصٍ تُنتقد",30,"د",1,0],["وفكّر فيما رأى خاطرِي","فقلتُ البحارُ مكان الشَّبَك",31,"ك",1,0],["وَفَكِّرْ فيِ انْتِهَاءٍ فيِ ابْتِدَاءٍ","وَشَاوِرْ ذَا الدَّهَاءِ لَدَى الْتِخَاخِ",32,"خ",1,0],["وفكر ثم قال له إذا لم","توفق للصواب فما احتيالي",33,"ي",1,0],["وَفُكَّ صَليبُ الشِركِ مِن قَيدِ أَسرِهِ","وَزُلزِلَ عَرشُ المُلكِ مِن بَعدِ ما اِستَقَر",34,"ر",1,0],["وَفَكّاكُ العُناةِ أَبو ثُبَيتٍ","يَزيدٌ بَعدَهُ مِنّا يَزيدُ",35,"د",1,0],["وفكر ملؤه ثقة","بعدل اللَه والقدر",36,"ر",1,0],["وَفِكري في غَيبي لِعَينِيَ مَشهَدٌ","لِصُبحِ الرِضى لي مِن دُجى اللَيلِ سالِخُ",37,"خ",1,0],["وفكر في ذنوبك","واخلاق قبيحات",38,"ت",1,0],["وفكوا عن الأفكار قياد شغلها","لتسبح في عمرانها وخلاها",39,"ا",3,0],["وفُكَّ إسار لَذاتٍ عَوانٍ","ببِكْرٍ مِن كُؤوسِكَ أوْ عَوانِ",40,"ن",1,0],["وَفُكَّت بِكَ الأَسرى الَّتي شُيِّدَت لَها","مَحابِسُ ما فيها حَميمٌ يَزورُها",41,"ه",2,1],["وفكاهات إذا أوْرَدَها","نُظِمَتْ فوق الحميَّا حببا",42,"ب",2,0],["وفُكَّ من الشِّرك أسِري وكا","ن غُلّاً على مَنكِبي مُقفَلا",43,"ل",2,0],["وفكَّرَ العقْلُ في الدنيا وشيمَتِها","وأنَّها ما لها بُقْيا على أحَدِ",44,"د",1,0],["وفكَّاكُ العُناةِ بكُلِّ أرْضٍ","إذا ما حَبَّبَ الموْتَ الإِسارُ",45,"ر",1,0],["وفكري صحيحٌ على ما عهدتَ","وأن مني الجسم مني بوهن",46,"ن",1,0],["وفكِّر رويداً هل يعدون سالماً","إلى آدم أم هل يرون ابن سالم",47,"م",1,0],["وفكْرةٌ علِمتْ معْناكَ حين رَوَتْ","عنكَ المَعاني وأسْنادَ الهَوَى نقَلتْ",48,"ت",1,0],["وفكرٌ عندكُمْ ما فيه إِلاَّ","حديثُكُمُ المُسَلْسَلُ والوَفاءُ",49,"ا",2,0],["وفكّ عن المُلْكِ الوِثاقَ فأصبحَتْ","شَياطينُه من قَهرِه في سَلاسِلِ",50,"ل",1,0],["وفكّ الجودُ أغلالَ العَطايا","وأمسى البُخلُ في قَيدِ الرّهينِ",51,"ن",1,0],["وفِكرا إذا طَار بِي في الفَضَا","وعَاد يَعِي ما رَأى ورَقَب",52,"ب",1,0],["وَفِكرَةُ حَيرانِ الحِجا قَذَفَت بِهِ","نَوىً شُطُرٌ مِن حَيثُ لَم يَحتَسِب قَذفا",53,"ف",2,0]]}