{"poems":[[55,"نطق اللسان عن الضمير","https://www.aldiwan.net/poem30476.html","مجزوء الكامل"],[93,"أعلى عيني من الدمع غشاء","https://www.aldiwan.net/poem62753.html","عموديه"],[99,"جددي الحب واذكري لي الربيعا","https://www.aldiwan.net/poem24854.html","الخفيف"],[77,"قامت تميس كما تدافع جدول","https://www.aldiwan.net/poem69047.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54850","الرمل"],[230,"إنني أستغفر الله لكم","https://www.aldiwan.net/poem55137.html","الرمل"],[463,"ما كان سهما غار بل ظبي سنح","https://www.aldiwan.net/poem56256.html","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126188","الكامل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35781","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53238","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89119","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66372","الخفيف"],[4978,"تشطير من الكفيل","https://www.poetsgate.com/ViewPoem.aspx?id=178201",""],[4984,"لغزة الوجدان شد رحاله","https://www.poetsgate.com/ViewPoem.aspx?id=175532",""],[5186,"قلب الدهر اختيارا","https://www.poetsgate.com/ViewPoem.aspx?id=156521",""],[5751,"حزنٌ بلون الفَرَح","https://www.poetsgate.com/ViewPoem.aspx?id=214719",""],[6068,"أقسام قلبي...-15-","https://www.poetsgate.com/ViewPoem.aspx?id=175861",""]],"verses":[["فَلَغَيرُ قَلبِكَ مَن يُعَد","دِلُ هَمَّهُ نُطَفُ الخُمورِ",0,"ر",1,0],["فَلَّ غَربي سالِبُ السَيفِ المَضاء","وَالشَذى الزَهرَةُ وَالعِقدِ النِظام",1,"م",1,0],["فلغيري الدنيا وما في حماها","إنني أعشق الجمال الرفيعا",2,"ع",2,0],["فلغايتي مُسْتَقْصِرٌ ولمِقوَلي","مُستعجِزٌ ولهاجسي مُستجهِل",3,"ل",1,0],["فَلِغَيْرِ الحُبِّ ذَابَتْ ذَهَباً","حِينَ تَأْسَى أَوْ تَذَكَّتْ مَجْمَرَا",4,"ر",2,0],["فَلَّ غربي أرى من نَومِكُم","وَرِضاكُم بِوجودِ الاِحتِلال",5,"ل",1,0],["فلغيرك المتسهَّلُ المبذولُ في اس","ترخاصه ولك الغرائبُ والمُلَحْ",6,"ح",1,0],["فلغيره يُجبى الملام فإنه","دهرٌ يُمِرُّ الحلوَ من ثمراتهِ",7,"ت",2,0],["فَلِغَيرِهِ الأَموالُ صامِتَةً","وَلَنا التَوَسُّعُ وَالنَدى الجَزلُ",8,"ل",1,0],["فلغازي بن يوسف الم","لك الظاهر نفس بالآملين خفيّه",9,"ي",2,0],["فلغرب رودسَ سار بدرُ كماله","ولشرق مصر غدا شروق البدر",10,"ر",1,0],["فلغات القانون يا صاح أشهى","من لغات أبانها القاموس",11,"س",1,0],["(فلغيرهم آي الكتاب ونهجه)","والرُّمحُ والَأقلامُ والسَّيفُ الصَقيلْ",12,"ل",1,0],["فلغزة الوجدان شد رحاله","يهديه غُمْر نحوها ولبيب",13,"ب",1,0],["فلغير الفول ما أو","قد أهل البيت نارا",14,"ر",2,0],["فَلِغيرِهِ الرُّجعى ، وغَيْرُ جراحِهِ","تَشكو ، فَكُلُّ العاذِلاتِ وَراءَهُ",15,"ا",3,0],["14-فلغزتي عزٌّ يلفُّ تحيتي","لولا البعاد إليك كنت الباديا",16,"ي",2,0]]}