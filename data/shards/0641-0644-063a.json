{"poems":[[53,"نطق اللسان عن الضمير","https://www.aldiwan.net/poem30476.html","مجزوء الكامل"],[91,"أعلى عيني من الدمع غشاء","https://www.aldiwan.net/poem62753.html","عموديه"],[97,"جددي الحب واذكري لي الربيعا","https://www.aldiwan.net/poem24854.html","الخفيف"],[75,"قامت تميس كما تدافع جدول","https://www.aldiwan.net/poem69047.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54850","الرمل"],[223,"إنني أستغفر الله لكم","https://www.aldiwan.net/poem55137.html","الرمل"],[456,"ما كان سهما غار بل ظبي سنح","https://www.aldiwan.net/poem56256.html","الكامل"]],"verses":[["فَلَغَيرُ قَلبِكَ مَن يُعَد","دِلُ هَمَّهُ نُطَفُ الخُمورِ",0,"ر",1,0],["فَلَّ غَربي سالِبُ السَيفِ المَضاء","وَالشَذى الزَهرَةُ وَالعِقدِ النِظام",1,"م",1,0],["فلغيري الدنيا وما في حماها","إنني أعشق الجمال الرفيعا",2,"ع",2,0],["فلغايتي مُسْتَقْصِرٌ ولمِقوَلي","مُستعجِزٌ ولهاجسي مُستجهِل",3,"ل",1,0],["فَلِغَيْرِ الحُبِّ ذَابَتْ ذَهَباً","حِينَ تَأْسَى أَوْ تَذَكَّتْ مَجْمَرَا",4,"ر",2,0],["فَلَّ غربي أرى من نَومِكُم","وَرِضاكُم بِوجودِ الاِحتِلال",5,"ل",1,0],["فلغيرك المتسهَّلُ المبذولُ في اس","ترخاصه ولك الغرائبُ والمُلَحْ",6,"ح",1,0]]}