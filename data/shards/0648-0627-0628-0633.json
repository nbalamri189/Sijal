{"poems":[[79,"مولاي يا خير ملوك الورى","https://www.aldiwan.net/poem36766.html","السريع"],[95,"أبو حسن أصفى الرفاق سريرة","https://www.aldiwan.net/poem11102.html","الطويل"],[53,"أين حظي من العدات المواضي","https://www.aldiwan.net/poem64978.html","الخفيف"],[53,"قل لمن ألبس الجمال جمالا","https://www.aldiwan.net/poem65878.html","الخفيف"],[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[93,"أعلى عيني من الدمع غشاء","https://www.aldiwan.net/poem62753.html","عموديه"],[63,"إذا المجرة مالت بعد تعديل","https://www.aldiwan.net/poem51485.html","البسيط"],[51,"إنقطاع الأيام عني سريع","https://www.aldiwan.net/poem62164.html","الخفيف"],[99,"ملكي ومحرابي وقد","https://www.aldiwan.net/poem24866.html","مجزوء الكامل"],[46,"أصب بحميا كأسها مقتل العذل","https://www.aldiwan.net/poem29689.html","الطويل"],[69,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[52,"وهبت لنا يا فتى منقر","https://www.aldiwan.net/poem62288.html","المتقارب"],[94,"","https://poetry.dctabudhabi.ae/diwan/poem/65998","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54294","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54243","الرمل"],[108,"قالوا أحيل","https://www.poetsgate.com/ViewPoem.aspx?id=179396",""],[96,"حنين الغريب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66297&r=&rc=15",""],[147,"قفوا في القلى حيث انتهيتم تذمما","https://www.aldiwan.net/poem11819.html","الطويل"],[151,"الحمد لله تعظيما وإجلالا","https://www.aldiwan.net/poem47640.html","البسيط"],[173,"بيني فما أنت من جدي ولا لعبي","https://www.aldiwan.net/poem1605.html",""],[173,"طما بحر الهموم به فمادا","https://www.aldiwan.net/poem1620.html",""],[208,"يقولون صف حرب الرعية والجند","https://www.aldiwan.net/poem53322.html","الطويل"],[228,"أرقدي أرقدي فغير الرقاد","https://www.aldiwan.net/poem41895.html","الخفيف"],[230,"يا لواء الحسن أحزاب الهوى","https://www.aldiwan.net/poem55176.html","الرمل"],[264,"سائل الفيض من بحور المسائل","https://www.aldiwan.net/poem35940.html","الخفيف"],[302,"نفحتنا بنشرها المستطاب","https://www.aldiwan.net/poem33332.html","الخفيف"],[310,"قد أكثبت فرص الجميل فبادر","https://www.aldiwan.net/poem56514.html","الكامل"],[369,"حيث انتهيت من الهجران بي فقف","https://www.aldiwan.net/poem60841.html","البسيط"],[402,"أبو حسن أصفى الرفاق سريرة","https://www.aldiwan.net/poem10966.html","عموديه"],[408,"وافاك يصحبه الإسعاد والظفر","https://www.aldiwan.net/poem46940.html","البسيط"],[449,"بحق من يا منيتي","https://www.aldiwan.net/poem56010.html","عموديه"],[466,"أود ولي من شيمة المجد عاصم","https://www.aldiwan.net/poem15146.html","الطويل"],[469,"باحت بنجد وهوى غزلانها","https://www.aldiwan.net/poem3273.html","عموديه"],[505,"أبكي وبدري بالجمال توارى","https://www.aldiwan.net/poem37625.html","الكامل"],[543,"فتحت في روضها زهرة","https://www.aldiwan.net/poem47421.html","عموديه"],[556,"ما قربوا إلا لبين نوقا","https://www.aldiwan.net/poem47365.html","الكامل"],[563,"لنا أتت منك أبيات محسنة","https://www.aldiwan.net/poem33522.html","البسيط"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34424","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37736","الكامل"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123400","الكامل"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/44797","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62585","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59420","الطويل"],[1177,"","https://poetry.dctabudhabi.ae/diwan/poem/28354","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112866","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112738","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1367,"","https://poetry.dctabudhabi.ae/diwan/poem/205627","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108983","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49581","البسيط"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132298","البسيط"],[1965,"","https://poetry.dctabudhabi.ae/diwan/poem/102723","الكامل"],[2052,"","https://poetry.dctabudhabi.ae/diwan/poem/101433","المجتث"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177826","الكامل"],[2380,"","https://poetry.dctabudhabi.ae/diwan/poem/29477","الوافر"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130059","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130051","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67989","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108256","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110079","الطويل"],[3655,"","https://poetry.dctabudhabi.ae/diwan/poem/205635","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91674","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216779","السريع"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216714","الوافر"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36800","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114147","المتقارب"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133244","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135717","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135766","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135867","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135735","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135772","الرجز"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29330","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111465","المتقارب"],[4030,"","https://poetry.dctabudhabi.ae/diwan/poem/20885","الكامل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78358","الوافر"],[4122,"","https://poetry.dctabudhabi.ae/diwan/poem/111118","الرمل"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93774","المنسرح"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204304",""],[4767,"صباح الحفظ","https://www.poetsgate.com/ViewPoem.aspx?id=178736",""],[5183,"بين الهيمنة والهينمة","https://www.poetsgate.com/ViewPoem.aspx?id=180155",""],[592,"لله عيش تقضى بالمسرات","https://www.poetsgate.com/ViewPoem.aspx?id=128833",""],[5397,"أيرمي سواد الليل عيني بالغمض","https://www.poetsgate.com/ViewPoem.aspx?id=157930",""],[5442,"أيها السائل الذي رزق التوفيق","https://www.poetsgate.com/ViewPoem.aspx?id=114767",""],[5442,"عسى وقفة بالركب يا حادي الركب","https://www.poetsgate.com/ViewPoem.aspx?id=114759",""],[5652,"سلام ياهامة بعيدات الاذهان","https://www.poetsgate.com/ViewPoem.aspx?id=181104",""],[5685,"قبلة الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=36763",""],[5848,"الزمن غافي","https://www.poetsgate.com/ViewPoem.aspx?id=48983",""],[5956,"خيبة الآمال","https://www.poetsgate.com/ViewPoem.aspx?id=194110",""],[6290,"خُلِقْتُ كَبِيرًا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85162&r=&rc=8",""]],"verses":[["وَابْسُطْ عَلَى الْخَلَقِ مِنَ الْعَدْلِ مَا","يَسْتَتِرُ الْخَلْقُ بِجِلْبَابِهِ",0,"ب",2,0],["وَأَبْسلُهُمْ ذَوْداً عَنِ العِرْضِ وَالحِمَى","وَأَثْبَتُهُمْ رَأْياً عَلَى صَالِحِ الرًّأْيِ",1,"ي",1,0],["وابسط العُذر في التخلُّفِ فالرج","لة عونُ الحياءِ والانقباض",2,"ض",1,0],["وابْسُط العُذرَ في اختصارِ وليٍّ","لم يخف من إطالةٍ إملالا",3,"ل",2,0],["وابسُطِ العذرَ في ارتخاص القوافي","واتِّباعي سهولةَ الأوزان",4,"ن",1,0],["وَاِبسُطوا أَيدِيَكُم يا أَغنِياء","أَبغَضُ السُحبِ إِلى الصادي الجَهام",5,"م",1,0],["وابسُط يمينَك في تَخمِيشِ كِدَّتهِ","وفي قَفاه فما سمحٌ بمغلولِ",6,"ل",1,0],["وَاِبسِطِ الوَجهَ لِلشَفيعِ وَإِلّا","كانَ أَولى بِالفَضلِ مِنكَ الشَفيعُ",7,"ع",1,0],["وابسط جناحك فوق قل","بينا الغداةَ وظلل",8,"ل",1,0],["وَأَبسُطَ مِن وَجهي الَّذي لَو بَذَلتُهُ","إِلى الأَرضِ مِن نَعلي لَما نَقَبَت نَعلي",9,"ل",2,0],["وَأَبْسُطُ وَجْهِي حينَ يَقْطُبُ وَجههُ","فيَحْسَبُ أنِّي موسِرٌ وهْوَ مُعْسِرُ",10,"ر",1,0],["وَأَبسَطَهُم راحَةً في النَدى","وَأَرفَعَهُم ذِروَةً في العُلا",11,"ل",2,0],["وابسطْ جَناحَكَ في الوُجودِ","فإنَّهُ عَذْبٌ خَلُوبْ",12,"ب",1,0],["وأبسطُ كفّي نحوه غيرَ جافلٍ","ويبسُط نحوي كفَّه غيرَ جافل",13,"ل",1,0],["وابسمِي من كان هذا ثغره","فتن الزهرَ أريجاً وبهاء",14,"ا",2,0],["وابْسُطْ يمينَك بالعطا","ءِ لِشاعِرٍ مثلي مُجِيد",15,"د",1,0],["وأبسط كفّي أقطف الماء عابثا","كأنّ المويجات الصّغار جميم",16,"م",1,0],["وَأَبسُطُ فيما قَلَّدَ بنُ مُقَلَّدٍ","لِساناً إِذا لاقى الضَريبَةَ صَمَّما",17,"م",2,0],["وابسط يديه على الغبراء قاطبة","وذلّلن كل من في الأرض إذلالا",18,"ل",2,0],["وَاِبسُط يَدَي فاضِلٍ في الأَمرِ تُكفَ بِهِ","ما نابَ واِرمِ العِدى عَن قَوسِهِ تُصِبِ",19,"ب",1,0],["وَأبسطها يَداً وَأَمَدّ باعاً","إِلى العَليا وَأَطوَلِها نِجادا",20,"د",2,0],["وأبسط أُنسي في الملاح ممازحاً","فإن تسطو بي صار مزحي إلى حدِّ",21,"د",1,0],["وَاِبسَمي فَالحَياةُ تبسمُ في المَهدِ","وَيَغفو السَلامُ تَحتَ الوِسادِ",22,"د",1,0],["وَاِبسمي من كان هذا ثغرُهُ","يَملا الدُنيا ابتِساما وازدهاء",23,"ا",2,0],["وابسط الكفّ والبيان عن الشك","ر فقد أغدقت عليك المسائل",24,"ل",1,0],["واِبسط العذرَ في الجَواب فقد قا","بلتُ شَمسَ الضحى بِضَوءِ التُرابِ",25,"ب",1,0],["وَاِبسط يَد الإحسانِ مُغتنماً بِها","غَرس الصنائعِ في فؤاد شاكرِ",26,"ر",1,0],["وابسُطْ يميناً كصَوْبِ المُزْنِ ماطرةً","واسمَعْ ثَناءً كنَشْرِ الرَّوضَةِ الأُنُف",27,"ف",1,0],["وأبسلهم ذودا عن العرض والحمى","اثبتهم رأيا على صالح الرأي",28,"ي",1,0],["وابْسُطْ لي العُذرَ في تركي إطالتَها","لأنّ كلَّ طويلٍ فيكَ مُخْتَصَرُ",29,"ر",1,0],["وابسط على عيني من","جودك أهنى نعسة",30,"ه",1,0],["وأبسم للمبكي نُهىً وحزامةً","وقد يستهلُّ القلب والثغرُ باسِمُ",31,"م",1,0],["وأبسط له العذر وخذ طائية","أنسابها تنمي إلى عدنانها",32,"ن",3,0],["وابسط له كفيك وابرز داعياً","لا ترتجى من غيره استظهارا",33,"ر",2,0],["وابسمي لي دائماً","واصبحيني واغبقي",34,"ي",1,0],["وَاِبسطْ إلى الإعطاءِ راحةَ واهبٍ","لا يعرف التّقتيرَ والتَّرنيقا",35,"ق",2,0],["وابسط جوابك في معناه منبسطاً","فإنه لم يزل في الخلق مشتبها",36,"ب",3,0],["وَأَبسِمُ لكن لَو بَدا لَكَ باطِني","ظهرتَ عَلى نارٍ بِهِ ذاتِ إِعصارِ",37,"ر",1,0],["وَاِبْسِمْ لَها ثَغرَ السّرورِ تَفضُّلاً","وَاِكْحَلْ لَها عَينَ القَبولِ بِأَغمَدا",38,"د",2,0],["وابْسُط يَدَيْك فإنّ قابض كَفِّه","في بَسْطَةِ الإثْراءِ عادٍ عادِمُ",39,"م",1,0],["وَاِبسِمي لي يا حَياتي","فَالمُنى في بَسَماتِكْ",40,"ك",1,0],["وأبسطْ ومُدَّ فإن دهرك صالح","واربع وجد فإِنَّ عمرك سَالمُ",41,"م",1,0],["وأبسط ثغري ثم خدّي لنعله","وقل له أن أبسط الخد والثغرا",42,"ر",2,0],["وَأَبسَلَ أَهلُ المَأقِطين نُفوسَهُم","مُضاربَةً إِذ طارَ كُلُّ شرودِ",43,"د",1,0],["وابسط يديك ووالنا يا عدتي","كل الزمان بوصلة وصلاة",44,"ه",1,0],["وابسط لنا يا باسط من فيضكم","حسن الصِلات بوابل الافعال",45,"ل",1,0],["وابسط كباءٍ ثم بالسن اقتفي","ختما وفي تعدّدٍ خسفٌ يقي",46,"ي",1,0],["وابسط لعقدةٍ كبسط ما نُقِل","وصدرن كسبع نصبٍ قد قُبِل",46,"ل",1,0],["وابسط بترطيب كقدرِ الاولِ","من بعد فتل سابق في العمل",46,"ل",1,0],["وابسط وقف على مدار قد سلف","وكثرنها وامنع الذي انخسف",46,"ف",1,0],["وابسط لجمع او لبسط مثل ما","رأيته في القاف قد تقدما",46,"م",2,0],["وابسط كما بسطته للمفرد","محدداً كالدال من محمّد",46,"د",1,0],["وابسم بها بعد العبوس فربما","صنع ابتسامك بالرجاء البالي",47,"ل",2,0],["وابسم لها وافتخر بالرونق الماسي","ذاك الذي كان حولي صابحاً ماسي",48,"س",2,0],["وأبسط لنا يدك العليا تقبلها","فإننا لم نرد براً ولا وشلا",49,"ل",2,0],["وابسط علينا من الأرزاق أكثرها","من كل ناحية بسطا من الله",50,"ل",2,0],["وابسُط لنا الأرزاق وارفع ذكرَنا","مع راحةٍ وسماحةٍ وتسيد",51,"د",1,0],["وابسِمْ لَعلَيِّ أَحيَا","إذا رأَيْتُ ابتِسَامَكْ",52,"ك",1,0],["وأبسط له كف السؤال فإنه","جم النوال ببسط ظل النعمة",53,"ه",1,0],["وإبْسالي بَنِيَّ بِغَيْرِ جُرْمٍ","بَعَوْناهُ ولا بِدَمٍ مُراقِ",54,"ق",1,0],["وابسط يديك توجه قبلة وسلن","مولاك فضلاً عظيما واكف الديم",55,"م",1,0],["وأُب سالماً يا سعد علّ بلادنا","بِمقدمك الميمون أن تتقدّما",56,"م",2,0],["واِبسط يدَ التِرحاب في تشريفهِ","لمعاهدٍ منهنَّ ملأى تزهرُ",57,"ر",1,0],["وابسط لنا نعمة نجنِي بغبطتها","من فيصلٍ باسطِ النعماءِ والكرم",58,"م",1,0],["وابسم إذا بلغتك أشواقي وقل","قد كان يرغب ذا المشوق عناقي",59,"ي",1,0],["وابسم عن ثغرِ الهِدايةِ مُسفِراً","فأَجلَت دياجيرَ الضَلالِ مباسمُه",60,"م",2,0],["وابسط يديك متى غنيت ولا تكن","فيما يكون به المديح ذميما",61,"م",2,0],["وَأبسمُ للبلوى وَتلكَ تبيدني",