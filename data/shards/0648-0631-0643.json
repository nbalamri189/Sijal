ّق فذا قلب على العذل لا يقوى","https://www.aldiwan.net/poem2504.html","الطويل"],[438,"عدتنا عواد من تناء ومن هجر","https://www.aldiwan.net/poem2588.html","الطويل"],[438,"تبسم برق الحيا فانتحب","https://www.aldiwan.net/poem2604.html","المتقارب"],[438,"لهم حب قلبي إن تدانوا وإن صدوا","https://www.aldiwan.net/poem2622.html","الطويل"],[442,"تسر النوى ما الحب أبداه معلنا","https://www.aldiwan.net/poem14322.html","الطويل"],[442,"قرعت على ليلى الشريفة بابها","https://www.aldiwan.net/poem14323.html","الطويل"],[453,"سعدت مطالعنا بأكرم وافد","https://www.aldiwan.net/poem13710.html","الكامل"],[459,"سافر بطرفك واشترف هل تعرف","https://www.aldiwan.net/poem56112.html","الكامل"],[462,"خذوا من ذمامي عدة للعواقب","https://www.aldiwan.net/poem15082.html","الطويل"],[462,"طوت ما طوت في سهل أرض ووعرها","https://www.aldiwan.net/poem15314.html","الطويل"],[462,"وركب كالصقور سروا بليل","https://www.aldiwan.net/poem16269.html","الوافر"],[483,"بكعبة أنوار أنخت مطيتي","https://www.aldiwan.net/poem24323.html","عموديه"],[491,"إن ترى رأسي فيه قزعٌ","https://www.aldiwan.net/poem655.html",""],[501,"ما بال قوم ترى للغير مقدرة","https://www.aldiwan.net/poem38007.html","البسيط"],[515,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[515,"يلوح فتستدعي الفراش وتبسم","https://www.aldiwan.net/poem20798.html","الطويل"],[515,"ميلوا بنا نحو الحجون ونكبوا","https://www.aldiwan.net/poem20800.html","الكامل"],[516,"ردا أحاديث المنى وأعيدا","https://www.aldiwan.net/poem12092.html","الكامل"],[516,"لما أدار مدامة الأحداق","https://www.aldiwan.net/poem12187.html","الكامل"],[552,"في العناء الطويل كيف وقعتم","https://www.aldiwan.net/poem47151.html","الخفيف"],[552,"أطواد عزك لا ترام","https://www.aldiwan.net/poem47240.html","مجزوء الكامل"],[552,"كم للنواظر من دم مطلول","https://www.aldiwan.net/poem47277.html","الكامل"],[552,"أأبا الحسين كفيت ما بعد الردى","https://www.aldiwan.net/poem47742.html","الكامل"],[552,"من رأى الأظعان فوق","https://www.aldiwan.net/poem47903.html","مجزوء الرمل"],[552,"ما في السلو لنا نصيب يطلب","https://www.aldiwan.net/poem48091.html","الكامل"],[559,"يا طالبا للحجر المكرم","https://www.aldiwan.net/poem34086.html","الرجز"],[576,"حاشا لمجدك أن يضاما","https://www.aldiwan.net/poem3008.html","مجزوء الكامل"],[576,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"]],"verses":[["وَرَكبٍ سَروا وَاللَيلُ مُلقٍ جِرانَهُ","عَلى كُلِّ مُغبَرِّ المَطالِعِ قاتِمِ",0,"م",1,0],["وَرَكبٍ أَغَذّوا بِالرِكابِ فَنَشَّفوا","ثَمائِلَها بِالجَوبِ غَرباً وَمَشرِقا",1,"ق",2,0],["وَرَكبٍ أَناخوا ساعَةً فَتَناهَبوا","ثَرى البيدِ في أَعضادِهِم وَالمَرافِقِ",2,"ق",1,0],["وَرَكبٍ عَلى الأَكوارِ يَثني رِقابَهُم","لِداعي الصِبا عَهدٌ قَديمٌ وَمَألَفُ",3,"ف",1,0],["وَرَكبٍ كَأَنَّ التُربَ يَنهَضُ نَحوَهُ","يُعانِقُهُ في سَيرِهِ وَيُصارِعُ",4,"ع",1,0],["وَرَكبٍ تَفادى النَومُ أَن يَستَخِفَّهُ","إِذا ما الكَرى أَلقى يَداً في المَحاجِرِ",5,"ر",1,0],["وَرَكبٍ تَفَرّى بَينَهُم قِطَعُ الدُجى","يَسيرُ عَلى البَيداءِ يَنتَهِبُ التُربا",6,"ب",2,1],["وَرَكِبتَ أَعجازَ النُجومِ وَفِتيَة","مِثلَ النُجومِ طَوالِعٌ وَغَوارِبُ",7,"ب",1,0],["وَرَكبٍ يَزجُرونَ عَلى وَجاها","بِقارِعَةِ النَّقا قُلُصاً عِجالا",8,"ل",2,1],["ورَكْبٍ على الأكْوارِ غيدٍ منَ الكَرى","تَداوَلَهُمْ سَيْرٌ حَثيثٌ ونَفْنَفُ",9,"ف",1,0],["ورَكْبٍ يَزُجُّونَ المَطايا كأنّهُمْ","أثاروا بِها رُبْدَ النَّعامِ وحَثْحَثوا",10,"ث",3,0],["ورَكْبٍ كخيطانِ الأراكِ هَدَيْتُهُمْ","وقد شغَلَ التّهْويمُ مِنهُمْ مآقِيا",11,"ي",2,0],["وَرُكْنُ صَبْرِي تَخَلَّى فِي الْغَرَامِ وَقَدْ","تَمَكَّنَ الحُبّ مِنِّي أَيّ تَمْكِينِ",12,"ن",1,0],["وَرُكْنِي الَّذِي لَمَا نَبَا بِي مَنْزِلِي","أَجَابَ نِدَائِي بِالْقَبُولِ وَآوَانِي",13,"ن",2,0],["وَرَكَائِبٌ جَعَلُوا الدَّلَيِلَ أَمَامَهُمْ","وَسَرَوْا فَفَازُوا بِالَّذِي قَدْ أَمَّلُوا",14,"ل",3,0],["وَرَكِبْتَ فِيهَا كُلَّ صَعْبٍ لَمْ يَكُنْ","لَوْلاَ الإِلاَهُ وَعِزَّ نَصْرِكَ يَسْهُل",15,"ل",1,0],["وركضْتُ طِرْفَ اللّهْوِ في شأْوِ الصِّبا","مَرَحاً فجُزْتُ مَدى النّعيمِ بَعيدا",16,"د",2,0],["ورِكابٍ سَرَوْا وقد سَمَل اللّي","لُ بمِسْحِ الدُّجى جَميعَ النّواحي",17,"ح",2,0],["وَرَكبٍ كَأَطرافِ الأَسِنَّةِ عَرَّسوا","قَلائِصَ في أَصلابِهِنَّ نُحولُ",18,"ل",1,0],["وركابُهما مزمومةٌ","وراءها حادٍ مُشمّرْ",19,"ر",1,0],["وركبِ قنيصٍ قد شهدتُ جيادهم","تُحمْحِمُ في ثيرانِ وحشٍ تَغَمْغمُ",20,"م",1,0],["وَرَكضُكَ غَيرَ مُلتَفِتٍ إِلَينا","كَأَنَّكَ مُمسِكٌ بِجَناحِ بازي",21,"ز",2,0],["وَرَكضُكَ غَيرَ مُلتَفِتٍ إِلَينا","بِخَوّارٍ إِذا عَرِقَ العِذارُ",22,"ر",1,0],["وَرَكبٍ كَالنُجومِ عَلى نُجومٍ","مَرَقنَ مِنَ الفَلاةِ بِهِم مُروقا",23,"ق",2,1],["وَرَكضٌ عَن يَمينٍ أَو شِمالٍ","لِنَظمِ الجَيشِ إِن رُفِعَ اللِواءُ",24,"ا",2,0],["وركوبة الشرق الهجي","ن أو الحمار أو البعير",25,"ر",1,0],["وركوبي يا صديقي","وذهابي وإيابي",26,"ي",1,1],["وركني الذي للنائبات أعدّه","وذخرَي في الماضي وعوني على الحال",27,"ل",1,0],["وَرُكوبِ اللِجاجِ وَهيَ طَواغٍ","وَالسَمَواتِ وَهيَ هوجُ الشَكائِم",28,"م",1,0],["وَرَكِبَ كَإِقبالِ الزَمانِ مُحَجَّلٍ","كَريمِ الحَواشي كابِرِ الخُطُواتِ",29,"ت",1,0],["وركبٍ سرَوا والصبحُ في حِجْرِ أمِّهِ","على شُعَبِ الأكوارِ ميلَ العمائمِ",30,"م",1,0],["وَرَكِبنَ اللَفظَ القَريبَ فَأَدرَك","نَ بِهِ غايَةَ المُرادِ البَعيدِ",31,"د",1,0],["وَرَكبٍ كَأَنَّ الريحَ تَطلُبُ عِندَهُم","لَها تِرَةً مِن جَذبِها بِالعَصائِبِ",32,"ب",1,1],["وَرَكبٍ قَدِ اِستَرخَت طُلاهُم مِنَ السُرى","مُقيمٍ بِلَحيَيهِ النِخاعُ وَأَميَلُ",33,"ل",1,1],["ورَكائبٌ يَخرُجْنَ مِنْ غَلَسِ الدُّجى","مثلَ السِّهامِ مَرَقْنَ منه مُروقا",34,"ق",2,0],["ورَكْبٍ أَممَّوا قَحطا","نَ والَّليلُ بِهِمْ يَسطُو",35,"و",1,1],["وَرَكضي أَدهَمَ الجِلبابِ صافٍ","خَفيفَ الجَريِ يَومَ السَلمِ صافِن",36,"ن",1,0],["وَرَكبٍ كَأَطرافِ الأَسِنَّةِ عَرَّسوا","عَلى مِثلِها وَاللَيلُ تَسطو غَياهِبُه",37,"ب",2,0],["وَرَكبٍ يُساقونَ الرِكابَ زُجاجَةً","مِنَ السَيرِ لَم تَقصِد لَها كَفُّ قاطِبِ",38,"ب",1,0],["وَرُكَّدٌ حَولَ كابٍ قَد عَكَفنَ بِهِ","وَزَينَةٌ ماثِلٌ مِنهُ وَمُنعَفِرُ",39,"ر",1,0],["وَرَكِبتُ دِجلَتَهُ يُضاحِكُني بِها","فَرِحاً حَبيبٌ شاقَني وَحَبابُ",40,"ب",1,0],["وركعن حتى شمأز ركوعٌ","ورجون حتى ستغث لرجءُ",41,"ا",1,0],["وَرَكبٍ دَعَتهُم نَحوَ يَثرِبَ نِيَّةٌ","فَما وَجَدَت إِلاّ مُطيعاً وَسامِعا",42,"ع",2,0],["وَرَكبٍ قَد بَعَثتُ إِلى رَذايا","طَلائِحَ مِثلِ أَخلاقِ الجُفونِ",43,"ن",1,0],["وَرُكُوبٌ إِذا الجَبانُ تَطَوّى","فَرَقاً عِندَ عِرسِهِ في الثِيابِ",44,"ب",1,0],["وَرُكِّبَ القُبحُ فَوقَ حُسنُهُمُ","فَفي سَماجاتِهِم مَلاحاتُ",45,"ت",1,0],["وَرَكِبتُ ما أَهوى وَكَم","أَجفو مَقالَةَ مَن نَهاني",46,"ن",2,0],["وَرَكّابَ أَفراسِ الصَبابَةِ وَالصِبا","جَرَت حِجَجاً ثُمَّ اِستَقَرَّت فَما تَجري",47,"ر",2,0],["وَرَكّابُ أَعوادِ المَنابِرِ لا يَني","خَليفَةَ مُلكٍ لِلصَّعاليكِ أَو حَدّا",48,"د",2,0],["وَرَكِبتُ مِنها أَربَعينَ مَطيَّةً","لَم تَخلو مِن عَنَتٍ وَسوءِ نِفارِ",49,"ر",1,0],["وَرَكبٌ وارِدٌ لِيُقيمَ عَصراً","وَآخَرُ قَد أَجَدَّ بِهِ الرَحيلُ",50,"ل",1,0],["وَرَكوبٍ تَعزِفُ الجِنُّ بِهِ","قَبلَ هَذا الجيلِ مِن عَهدٍ أَبَد",51,"د",1,1],["وَرَكضُكَ لَولاهُ لَقَيتَ الَّذي لَقوا","فَذاكَ الَّذي أَنجاكَ مِمّا هُنالِكا",52,"ك",2,0],["وركبت متن هواها هاشم","وجال غاويها وصال الغاشم",53,"م",1,0],["وركب العلج العصا بمن معهْ","إلا قليلا غودروا في المعمعهْ",54,"ه",1,0],["وركنها كأمس في أم القرى","تطوى القباب والقصور والقرى",55,"ر",2,0],["وَرَكِبْتُمْ مِنْهُ جَوَاداً حَرُوناً","قَلِقاً بِالمُمَرَّسِ المِغْوَارِ",56,"ر",1,0],["وَرَكِبْتَ حِينَ الأَرْضُ وَاجفةٌ","بِالدَّسْتِ ذاكَ المَرْكَبَ الْوَعْرَا",57,"ر",2,0],["وركعنا حتى اشمأزّ ركوعٌ","ورجونا حتى استغاث الرجاء",58,"ا",2,0],["وَرَكِبنا حالاً لِنُكذِبَ عَنّا","قَولَ مَن كانَ بِالبَنانِ أَشارا",59,"ر",2,0],["وركبتم متن الأثير سراعًا","وكشفتم عن النجوم الحجابا؟",60,"ب",2,0],["وركضت طرف اللهوي في شأو الصبا","مرحا فجرت مدى النعيم بعيدا",61,"د",2,0],["وركاب سروا وقد شمل الليل","بمسح الدجى جميع النواحي",62,"ح",2,0],["وركام من التّلاوين ، حتى","لا يبقّي ، لأي (حرباء) لبسا",63,"س",2,0],["وركِبْتُ منها أربَعينَ مَطيّةً،","لم تَخْلُ مِن عَنَتٍ وسوءِ نِفار",64,"ر",1,0],["وركب عليها ، وسم أخفاق عيسهم","وهام تهاوت للكرى وجنوب",65,"ب",1,0],["وركابُها مزمومة ٌ","وراءها حاد مُشمّر",66,"ر",1,0],["وركب في التاج صومالها","ركابُك يا بن المُعِزِّ الغُيوثُ",67,"ث",1,0],["وركب سرى يطوي الفيافي تظنه","سحابة صيف غيمها طيلس الفلا",68,"ل",2,0],["وركناً إذا ضاق الخناق ومنجداً","وذخراً ومفتاحاً لكل مزية",69,"ي",2,0],["ورَكِبْتُ مِنْ هَوْلِ الجَحيمِ خَنادقًا","وغَدَوْتُ مِنْ أَتباعِ (عَبْدِ القادِرِ)",70,"ر",1,0],["ورَكَعْتُ في نَهْديك مُبْتَهِلًا","أُلامِسُ كلَّ نجمٍ في سَماك",71,"ك",1,0],["وَرَكبٌ فَوقَ أنضَاءٍ عِجَافٍ","بَرَاهَا النَّىَّ إدمَانُ التَّغَالِي",72,"ل",2,0],["وَرَكائِبٌ تَهوي بِنا","بِينَ الدُروبِ فَدابِقِ",73,"ق",1,0],["وركبتُ حتى فوق أنفاس العدى","وزحمت حتى منكب الخضراءَ",74,"ا",2,0],["وركبت من خيل النهى","طرفا جموحا زائغا",75,"غ",2,0],["وركب فيّ خلاف الذي","يردن ويهوينمن كل شر",76,"ر",1,0],["وركبٍ تَساقَوْا كؤوسَ الكرى","وقد طلب النومَ طولُ السرى",77,"ر",2,1],["وركنتم بعد التظا","هر للفرار مرافقين",78,"ن",1,0],["وَرَكائِبٌ شَطَّت بِكُم لَو حُمِّلَت","وَجدي لَما مَدَّت لِرَحّالٍ يَدا",79,"د",2,0],["وَرَكَضْتُ أَفْرَاسَ الْبِطَالَةِ لاَهِياً","مَا بَيْنَ أَزَاهِرِ الْهَوَى وَصِلاَلِهَا",80,"ل",3,0],["وركن الهدى واهي الدعائم واهن","إذا لم تشده بالأكف سيوف",81,"ف",1,0],["وَرَكْباً أفادَتْني الليالي وَلاءهُم","لهم بالعُلى وَجدٌ وفي سُبلِها وَخدُ",82,"د",1,0],["وَرَكْبٍ أَمَاطُوا الْهَمَّ عَنْهُمْ بِهِمَّةٍ","سَواءٌ بِها أَقْصى الْمَرامِ وأَدْناهُ",83,"ا",2,0],["وَرَكبٍ عَلى أَكوارِهِنَّ كَأَنَّهُم","سِهامٌ بِأَكبادِ القِسِيِّ تَشَدَّدُ",84,"د",1,0],["وركتك أوراق المصاحف وانتهى","إلى الله منها طول درسك والدكر",85,"ر",1,0],["وَركب سروا وَالعيس أَمَّت طويلعا","فَكانوا بُدوراً لِلدياجر طُلَّعا",86,"ع",2,0],["وركْبٍ آنسوا أمَداً فحَثّوا","إليه العِيسَ تَمرَحُ في المَثاني",87,"ن",2,0],["وَرْكبٍ كالكواكبِ ليس يَخْشَى","ضَلالاً في الظّلامِ ولا كَلالا",88,"ل",2,0],["ورَكِبْتُ أجنحةَ الرّياحِ حَثيثةً","أَبْغي بِهنَّ إلى ذُراكَ رَحيلا",89,"ل",2,0],["وركَضْتُ خيلَ القَوْلِ بي","ن يَديهِ واسعةَ المَجال",90,"ل",1,0],["ورِكاب الغرامِ في كلِّ خَبتٍ","ووِهادٍ تُضِلُّها الأعداءُ",91,"ا",2,0],["وَرَكب أَدلَجوا وَاللَيل مَرس","بِكلكلةٍ عَلى قَلب رقود",92,"د",1,0],["ورَكبتُ مِنْ عَزْمي إليكَ مَطيِّةً","وجعلتُ ذكركَ في المفاوزِ زادي",93,"د",2,0],["وَرَكائِبٍ يخرجنَ من غَلس ا