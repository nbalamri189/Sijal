{"poems":[[53,"ألا ليت أذيال الغيوث السواجم","https://www.aldiwan.net/poem29766.html","الطويل"],[53,"سننت لهذا الرمح غربا مذلقا","https://www.aldiwan.net/poem29931.html","الطويل"],[53,"بود الرذايا أنها في السوابق","https://www.aldiwan.net/poem29954.html","الطويل"],[53,"وفى بمواعيد الخليط وأخلفوا","https://www.aldiwan.net/poem29968.html","الطويل"],[53,"لأغنتك عن وصلي الهموم القواطع","https://www.aldiwan.net/poem30154.html","الطويل"],[53,"بغير شفيع نال عفو المقادر","https://www.aldiwan.net/poem30465.html","الطويل"],[53,"وركب تفرى بينهم قطع الدجى","https://www.aldiwan.net/poem30690.html","الطويل"],[53,"مثواي إما صهوة أو غارب","https://www.aldiwan.net/poem30756.html","الكامل"],[63,"وركب يزجرون على وجاها","https://www.aldiwan.net/poem45719.html","الوافر"],[63,"رماك بشوق فالمدامع ذرف","https://www.aldiwan.net/poem46173.html","الطويل"],[63,"سرى والنسيم الرطب بالروض يعبث","https://www.aldiwan.net/poem46206.html","الطويل"],[63,"بعيشكما يا صاحبي دعانيا","https://www.aldiwan.net/poem46218.html","الكامل"],[77,"سل ما لسلمى بنار الهجر تكويني","https://www.aldiwan.net/poem36040.html","البسيط"],[77,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[77,"نهضوا وقد جن االدجى وتخالفت","https://www.aldiwan.net/poem36353.html","الكامل"],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[77,"هاجتك إذ جئت اللوى فزرودا","https://www.aldiwan.net/poem36535.html","الكامل"],[77,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[35,"أهاجك من سعدى الغداة طلول","https://www.aldiwan.net/poem39109.html","الطويل"],[51,"وضعت كقضبان اللجين","https://www.aldiwan.net/poem64035.html","مجزوء الكامل"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[29,"لعمر أبيك يا زفر ابن عمر","https://www.aldiwan.net/poem6066.html","الوافر"],[29,"أعاذل نعم قوم الحرب قومي","https://www.aldiwan.net/poem6078.html","الوافر"],[70,"وركب كالنجوم على نجوم","https://www.aldiwan.net/poem42795.html","الوافر"],[78,"وطرد الناس بين يدي ممري","https://www.aldiwan.net/poem14218.html","الوافر"],[89,"الغرب مركبه البخار","https://www.aldiwan.net/poem44884.html","مجزوء الكامل"],[85,"وركوبي يا صديقي وذهابي وإيابي","https://www.aldiwan.net/poem6956.html","مجزوء الرمل"],[85,"يقولون رشدي مات","https://www.aldiwan.net/poem7790.html","الطويل"],[85,"لك في الأرض والسماء مآتم","https://www.aldiwan.net/poem11330.html","الخفيف"],[85,"إلى عرفات الله يا خير زائر","https://www.aldiwan.net/poem63776.html","الطويل"],[62,"لقد هاجني والصبح طلق المباسم","https://www.aldiwan.net/poem52267.html","الطويل"],[45,"بعض هذا العتاب والتفنيد","https://www.aldiwan.net/poem63476.html","الخفيف"],[28,"وركب كأن الريح تطلب عندهم","https://www.aldiwan.net/poem1244.html",""],[28,"وركب قد استرخت طلاهم من السرى","https://www.aldiwan.net/poem5467.html","الطويل"],[61,"أما الخيال فما يغب طروقا","https://www.aldiwan.net/poem51534.html","الكامل"],[61,"وركب أمموا قحطا","https://www.aldiwan.net/poem51576.html","الهزج"],[66,"لسيري في الفلا والليل داج","https://www.aldiwan.net/poem41557.html","الوافر"],[44,"أهن عوادي يوسف وصواحبه","https://www.aldiwan.net/poem30578.html","الطويل"],[44,"على مثلها من أربع وملاعب","https://www.aldiwan.net/poem30579.html","الطويل"],[31,"قف بالديار عفا من أهلها الأثر","https://www.aldiwan.net/poem42547.html","البسيط"],[74,"وصقيل إفرند الشباب بطرفه","https://www.aldiwan.net/poem12854.html","الكامل"],[104,"شهداء","https://www.aldiwan.net/poem26158.html","عموديه"],[81,"تنازعني الآمال كهلا ويافعا","https://www.aldiwan.net/poem61463.html","البسيط"],[39,"أمن دمن بشاجنة الحجون","https://www.aldiwan.net/poem53733.html","الوافر"],[40,"تلك عرسي تلومني في التصابي","https://www.aldiwan.net/poem42300.html","الخفيف"],[52,"لي في التصابي واللهو حاجات","https://www.aldiwan.net/poem27187.html","المنسرح"],[48,"لولا حذاري من جنان","https://www.aldiwan.net/poem66095.html","مجزوء الكامل"],[50,"تجاللت عن فهر وعن جارتي فهر","https://www.aldiwan.net/poem63803.html","الطويل"],[50,"خليلي غضا ساعة وارحلا بردا","https://www.aldiwan.net/poem63877.html","الطويل"],[46,"يا أم دفر إنما أكرمت عن","https://www.aldiwan.net/poem22714.html","الكامل"],[46,"سمعتك مخبرا فنظرت فيما","https://www.aldiwan.net/poem23140.html","الوافر"],[1,"وركوب تعزف الجن به","https://www.aldiwan.net/poem20974.html","الرمل"],[15,"تعفت رسوم من سليمى دكادكا","https://www.aldiwan.net/poem45257.html","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202531","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54933","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54858","الكامل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/142164","الخفيف"],[31,"","https://poetry.dctabudhabi.ae/diwan/poem/6095","الخفيف"],[106,"زورق في الفضاء","https://www.poetsgate.com/ViewPoem.aspx?id=179453",""],[77,"هاجتك إذ جئت اللوى فزرودا","https://www.poetsgate.com/ViewPoem.aspx?id=34092",""],[77,"ما على القلب بعدكم من جناح","https://www.poetsgate.com/ViewPoem.aspx?id=33823",""],[46,"يا أُمّ دَفرٍ! إنّما أُكرِمتِ عَنْ","https://www.poetsgate.com/ViewPoem.aspx?id=20289",""],[51,"وضعتْ كقُضبان اللُّجيْ","https://www.poetsgate.com/ViewPoem.aspx?id=29166",""],[85,"جعلتُ حُلاها وتمثالها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9586&r=&rc=76",""]],"verses":[["وَرَكبٍ سَروا وَاللَيلُ مُلقٍ جِرانَهُ","عَلى كُلِّ مُغبَرِّ المَطالِعِ قاتِمِ",0,"م",1,0],["وَرَكبٍ أَغَذّوا بِالرِكابِ فَنَشَّفوا","ثَمائِلَها بِالجَوبِ غَرباً وَمَشرِقا",1,"ق",2,0],["وَرَكبٍ أَناخوا ساعَةً فَتَناهَبوا","ثَرى البيدِ في أَعضادِهِم وَالمَرافِقِ",2,"ق",1,0],["وَرَكبٍ عَلى الأَكوارِ يَثني رِقابَهُم","لِداعي الصِبا عَهدٌ قَديمٌ وَمَألَفُ",3,"ف",1,0],["وَرَكبٍ كَأَنَّ التُربَ يَنهَضُ نَحوَهُ","يُعانِقُهُ في سَيرِهِ وَيُصارِعُ",4,"ع",1,0],["وَرَكبٍ تَفادى النَومُ أَن يَستَخِفَّهُ","إِذا ما الكَرى أَلقى يَداً في المَحاجِرِ",5,"ر",1,0],["وَرَكبٍ تَفَرّى بَينَهُم قِطَعُ الدُجى","يَسيرُ عَلى البَيداءِ يَنتَهِبُ التُربا",6,"ب",2,1],["وَرَكِبتَ أَعجازَ النُجومِ وَفِتيَة","مِثلَ النُجومِ طَوالِعٌ وَغَوارِبُ",7,"ب",1,0],["وَرَكبٍ يَزجُرونَ عَلى وَجاها","بِقارِعَةِ النَّقا قُلُصاً عِجالا",8,"ل",2,1],["ورَكْبٍ على الأكْوارِ غيدٍ منَ الكَرى","تَداوَلَهُمْ سَيْرٌ حَثيثٌ ونَفْنَفُ",9,"ف",1,0],["ورَكْبٍ يَزُجُّونَ المَطايا كأنّهُمْ","أثاروا بِها رُبْدَ النَّعامِ وحَثْحَثوا",10,"ث",3,0],["ورَكْبٍ كخيطانِ الأراكِ هَدَيْتُهُمْ","وقد شغَلَ التّهْويمُ مِنهُمْ مآقِيا",11,"ي",2,0],["وَرُكْنُ صَبْرِي تَخَلَّى فِي الْغَرَامِ وَقَدْ","تَمَكَّنَ الحُبّ مِنِّي أَيّ تَمْكِينِ",12,"ن",1,0],["وَرُكْنِي الَّذِي لَمَا نَبَا بِي مَنْزِلِي","أَجَابَ نِدَائِي بِالْقَبُولِ وَآوَانِي",13,"ي",1,0],["وَرَكَائِبٌ جَعَلُوا الدَّلَيِلَ أَمَامَهُمْ","وَسَرَوْا فَفَازُوا بِالَّذِي قَدْ أَمَّلُوا",14,"ل",3,0],["وَرَكِبْتَ فِيهَا كُلَّ صَعْبٍ لَمْ يَكُنْ","لَوْلاَ الإِلاَهُ وَعِزَّ نَصْرِكَ يَسْهُل",15,"ل",1,0],["وركضْتُ طِرْفَ اللّهْوِ في شأْوِ الصِّبا","مَرَحاً فجُزْتُ مَدى النّعيمِ بَعيدا",16,"د",2,0],["ورِكابٍ سَرَوْا وقد سَمَل اللّي","لُ بمِسْحِ الدُّجى جَميعَ النّواحي",17,"ح",2,0],["وَرَكبٍ كَأَطرافِ الأَسِنَّةِ عَرَّسوا","قَلائِصَ في أَصلابِهِنَّ نُحولُ",18,"ل",1,0],["وركابُهما مزمومةٌ","وراءها حادٍ مُشمّرْ",19,"ر",1,0],["وركبِ قنيصٍ قد شهدتُ جيادهم","تُحمْحِمُ في ثيرانِ وحشٍ تَغَمْغمُ",20,"م",1,0],["وَرَكضُكَ غَيرَ مُلتَفِتٍ إِلَينا","كَأَنَّكَ مُمسِكٌ بِجَناحِ بازي",21,"ي",1,0],["وَرَكضُكَ غَيرَ مُلتَفِتٍ إِلَينا","بِخَوّارٍ إِذا عَرِقَ العِذارُ",22,"ر",1,0],["وَرَكبٍ كَالنُجومِ عَلى نُجومٍ","مَرَقنَ مِنَ الفَلاةِ بِهِم مُروقا",23,"ق",2,1],["وَرَكضٌ عَن يَمينٍ أَو شِمالٍ","لِنَظمِ الجَيشِ إِن رُفِعَ اللِواءُ",24,"ا",2,0],["وركوبة الشرق الهجي","ن أو الحمار أو البعير",25,"ر",1,0],["وركوبي يا صديقي","وذهابي وإيابي",26,"ي",1,1],["وركني الذي للنائبات أعدّه","وذخرَي في الماضي وعوني على الحال",27,"ل",1,0],["وَرُكوبِ اللِجاجِ وَهيَ طَواغٍ","وَالسَمَواتِ وَهيَ هوجُ الشَكائِم",28,"م",1,0],["وَرَكِبَ كَإِقبالِ الزَمانِ مُحَجَّلٍ","كَريمِ الحَواشي كابِرِ الخُطُواتِ",29,"ت",1,0],["وركبٍ سرَوا والصبحُ في حِجْرِ أمِّهِ","على شُعَبِ الأكوارِ ميلَ العمائمِ",30,"م",1,0],["وَرَكِبنَ اللَفظَ القَريبَ فَأَدرَك","نَ بِهِ غايَةَ المُرادِ البَعيدِ",31,"د",1,0],["وَرَكبٍ كَأَنَّ الريحَ تَطلُبُ عِندَهُم","لَها تِرَةً مِن جَذبِها بِالعَصائِبِ",32,"ب",1,1],["وَرَكبٍ قَدِ اِستَرخَت طُلاهُم مِنَ السُرى","مُقيمٍ بِلَحيَيهِ النِخاعُ وَأَميَلُ",33,"ل",1,1],["ورَكائبٌ يَخرُجْنَ مِنْ غَلَسِ الدُّجى","مثلَ السِّهامِ مَرَقْنَ منه مُروقا",34,"ق",2,0],["ورَكْبٍ أَممَّوا قَحطا","نَ والَّليلُ بِهِمْ يَسطُو",35,"و",1,1],["وَرَكضي أَدهَمَ الجِلبابِ صافٍ","خَفيفَ الجَريِ يَومَ السَلمِ صافِن",36,"ن",1,0],["وَرَكبٍ كَأَطرافِ الأَسِنَّةِ عَرَّسوا","عَلى مِثلِها وَاللَيلُ تَسطو غَياهِبُه",37,"ب",2,0],["وَرَكبٍ يُساقونَ الرِكابَ زُجاجَةً","مِنَ السَيرِ لَم تَقصِد لَها كَفُّ قاطِبِ",38,"ب",1,0],["وَرُكَّدٌ حَولَ كابٍ قَد عَكَفنَ بِهِ","وَزَينَةٌ ماثِلٌ مِنهُ وَمُنعَفِرُ",39,"ر",1,0],["وَرَكِبتُ دِجلَتَهُ يُضاحِكُني بِها","فَرِحاً حَبيبٌ شاقَني وَحَبابُ",40,"ب",1,0],["وركعن حتى شمأز ركوعٌ","ورجون حتى ستغث لرجءُ",41,"ا",1,0],["وَرَكبٍ دَعَتهُم نَحوَ يَثرِبَ نِيَّةٌ","فَما وَجَدَت إِلاّ مُطيعاً وَسامِعا",42,"ع",2,0],["وَرَكبٍ قَد بَعَثتُ إِلى رَذايا","طَلائِحَ مِثلِ أَخلاقِ الجُفونِ",43,"ن",1,0],["وَرُكُوبٌ إِذا الجَبانُ تَطَوّى","فَرَقاً عِندَ عِرسِهِ في الثِيابِ",44,"ب",1,0],["وَرُكِّبَ القُبحُ فَوقَ حُسنُهُمُ","فَفي سَماجاتِهِم مَلاحاتُ",45,"ت",1,0],["وَرَكِبتُ ما أَهوى وَكَم","أَجفو مَقالَةَ مَن نَهاني",46,"ي",1,0],["وَرَكّابَ أَفراسِ الصَبابَةِ وَالصِبا","جَرَت حِجَجاً ثُمَّ اِستَقَرَّت فَما تَجري",47,"ي",1,0],["وَرَكّابُ أَعوادِ المَنابِرِ لا يَني","خَليفَةَ مُلكٍ لِلصَّعاليكِ أَو حَدّا",48,"د",2,0],["وَرَكِبتُ مِنها أَربَعينَ مَطيَّةً","لَم تَخلو مِن عَنَتٍ وَسوءِ نِفارِ",49,"ر",1,0],["وَرَكبٌ وارِدٌ لِيُقيمَ عَصراً","وَآخَرُ قَد أَجَدَّ بِهِ الرَحيلُ",50,"ل",1,0],["وَرَكوبٍ تَعزِفُ الجِنُّ بِهِ","قَبلَ هَذا الجيلِ مِن عَهدٍ أَبَد",51,"د",1,1],["وَرَكضُكَ لَولاهُ لَقَيتَ الَّذي لَقوا","فَذاكَ الَّذي أَنجاكَ مِمّا هُنالِكا",52,"ك",2,0],["وركبت متن هواها هاشم","وجال غاويها وصال الغاشم",53,"م",1,0],["وركب العلج العصا بمن معهْ","إلا قليلا غودروا في المعمعهْ",54,"ه",1,0],["وركنها كأمس في أم القرى","تطوى القباب والقصور والقرى",55,"ر",2,0],["وَرَكِبْتُمْ مِنْهُ جَوَاداً حَرُوناً","قَلِقاً بِالمُمَرَّسِ المِغْوَارِ",56,"ر",1,0],["وَرَكِبْتَ حِينَ الأَرْضُ وَاجفةٌ","بِالدَّسْتِ ذاكَ المَرْكَبَ الْوَعْرَا",57,"ر",2,0],["وركعنا حتى اشمأزّ ركوعٌ","ورجونا حتى استغاث الرجاء",58,"ا",2,0],["وَرَكِبنا حالاً لِنُكذِبَ عَنّا","قَولَ مَن كانَ بِالبَنانِ أَشارا",59,"ر",2,0],["وركبتم متن الأثير سراعًا","وكشفتم عن النجوم الحجابا؟",60,"ب",2,0],["وركضت طرف اللهوي في شأو الصبا","مرحا فجرت مدى النعيم بعيدا",61,"د",2,0],["وركاب سروا وقد شمل الليل","بمسح الدجى جميع النواحي",62,"ح",2,0],["وركِبْتُ منها أربَعينَ مَطيّةً،","لم تَخْلُ مِن عَنَتٍ وسوءِ نِفار",63,"ر",1,0],["وركابُها مزمومة ٌ","وراءها حاد مُشمّر",64,"ر",1,0],["وركب في التاج صومالها","ركابُك يا بن المُعِزِّ الغُيوثُ",65,"ث",1,0]]}