,"https://www.poetsgate.com/ViewPoem.aspx?id=183837",""],[4767,"نور الكون","https://www.poetsgate.com/ViewPoem.aspx?id=179802",""],[4791,"سلطان حبك","https://www.poetsgate.com/ViewPoem.aspx?id=36952",""],[4849,"فيراري","https://www.poetsgate.com/ViewPoem.aspx?id=53514",""],[4884,"ملامح إبني","https://www.poetsgate.com/ViewPoem.aspx?id=210387",""],[5127,"حديثُ النفس","https://www.poetsgate.com/ViewPoem.aspx?id=177309",""],[5145,"من كان يصبو إلى الأوصاف والغزل","https://www.poetsgate.com/ViewPoem.aspx?id=108227",""],[5183,"الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=186490",""],[5219,"أضنيت قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=193839",""],[5219,"يا زمان الوصل","https://www.poetsgate.com/ViewPoem.aspx?id=194938",""],[5219,"كن عاقلا ....","https://www.poetsgate.com/ViewPoem.aspx?id=195013",""],[5264,"نفسه","https://www.poetsgate.com/ViewPoem.aspx?id=207529",""],[5277,"أحلامُ اليقظة..في معارضة بيت لقائله","https://www.poetsgate.com/ViewPoem.aspx?id=211242",""],[5281,"رحلة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=199222",""],[5397,"تدلت لأفنان النقا عذباتها","https://www.poetsgate.com/ViewPoem.aspx?id=157920",""],[5408,"إحتفالية المقاتل في محراب الشهادة","https://www.poetsgate.com/ViewPoem.aspx?id=190866",""],[5425,"أَوفَيتَ عَهْدَكَ ، يا حَقٌّ بِمَقْتَلِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=207514",""],[5431,"وعلمت أنك بالجياع مُسائَل","https://www.poetsgate.com/ViewPoem.aspx?id=187833",""],[5437,"ذكرى وديوان","https://www.poetsgate.com/ViewPoem.aspx?id=144644",""],[5451,"لكم مزماركم ولي مزماري","https://www.poetsgate.com/ViewPoem.aspx?id=155932",""],[5614,"صرخة القدس","https://www.poetsgate.com/ViewPoem.aspx?id=1356",""],[5691,"قمرٌ باهتٌ...وأرضٌ يبابُ !","https://www.poetsgate.com/ViewPoem.aspx?id=206523",""],[5770,"هذي الملايين حقًا أمة العربِ","https://www.poetsgate.com/ViewPoem.aspx?id=178708",""],[5809,"سياحة","https://www.poetsgate.com/ViewPoem.aspx?id=205334",""],[5861,"شكوى أم","https://www.poetsgate.com/ViewPoem.aspx?id=188057",""],[5883,"ثلة الحق","https://www.poetsgate.com/ViewPoem.aspx?id=22793",""],[5913,"تغنى الكون","https://www.poetsgate.com/ViewPoem.aspx?id=177072",""],[5963,"آخر ُ الأَلحان","https://www.poetsgate.com/ViewPoem.aspx?id=187414",""],[6102,"عَصرُ الخِيانات ..","https://www.poetsgate.com/ViewPoem.aspx?id=184450",""],[6102,"على !!","https://www.poetsgate.com/ViewPoem.aspx?id=184455",""],[6145,"ياسين يا شيخ الجهاد","https://www.poetsgate.com/ViewPoem.aspx?id=7799",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[242,"كم ذا تقرطسني بسمر نبالها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563704",""],[6181,"مسافر ومسافرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87686&r=&rc=1",""],[6202,"أي يوم يكون للشعراء ..؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86712&r=&rc=13",""],[6237,"جبل فيفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77861&r=&rc=3",""],[6238,"لُباب الحُب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86777&r=&rc=6",""],[406,"إلى أين يا قومي ؟؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63654&r=&rc=84",""]],"verses":[["وَرَكبٍ سَروا وَاللَيلُ مُلقٍ جِرانَهُ","عَلى كُلِّ مُغبَرِّ المَطالِعِ قاتِمِ",0,"م",1,0],["وَرَكبٍ أَغَذّوا بِالرِكابِ فَنَشَّفوا","ثَمائِلَها بِالجَوبِ غَرباً وَمَشرِقا",1,"ق",2,0],["وَرَكبٍ أَناخوا ساعَةً فَتَناهَبوا","ثَرى البيدِ في أَعضادِهِم وَالمَرافِقِ",2,"ق",1,0],["وَرَكبٍ عَلى الأَكوارِ يَثني رِقابَهُم","لِداعي الصِبا عَهدٌ قَديمٌ وَمَألَفُ",3,"ف",1,0],["وَرَكبٍ كَأَنَّ التُربَ يَنهَضُ نَحوَهُ","يُعانِقُهُ في سَيرِهِ وَيُصارِعُ",4,"ع",1,0],["وَرَكبٍ تَفادى النَومُ أَن يَستَخِفَّهُ","إِذا ما الكَرى أَلقى يَداً في المَحاجِرِ",5,"ر",1,0],["وَرَكبٍ تَفَرّى بَينَهُم قِطَعُ الدُجى","يَسيرُ عَلى البَيداءِ يَنتَهِبُ التُربا",6,"ب",2,1],["وَرَكِبتَ أَعجازَ النُجومِ وَفِتيَة","مِثلَ النُجومِ طَوالِعٌ وَغَوارِبُ",7,"ب",1,0],["وَرَكبٍ يَزجُرونَ عَلى وَجاها","بِقارِعَةِ النَّقا قُلُصاً عِجالا",8,"ل",2,1],["ورَكْبٍ على الأكْوارِ غيدٍ منَ الكَرى","تَداوَلَهُمْ سَيْرٌ حَثيثٌ ونَفْنَفُ",9,"ف",1,0],["ورَكْبٍ يَزُجُّونَ المَطايا كأنّهُمْ","أثاروا بِها رُبْدَ النَّعامِ وحَثْحَثوا",10,"ث",3,0],["ورَكْبٍ كخيطانِ الأراكِ هَدَيْتُهُمْ","وقد شغَلَ التّهْويمُ مِنهُمْ مآقِيا",11,"ي",2,0],["وَرُكْنُ صَبْرِي تَخَلَّى فِي الْغَرَامِ وَقَدْ","تَمَكَّنَ الحُبّ مِنِّي أَيّ تَمْكِينِ",12,"ن",1,0],["وَرُكْنِي الَّذِي لَمَا نَبَا بِي مَنْزِلِي","أَجَابَ نِدَائِي بِالْقَبُولِ وَآوَانِي",13,"ن",2,0],["وَرَكَائِبٌ جَعَلُوا الدَّلَيِلَ أَمَامَهُمْ","وَسَرَوْا فَفَازُوا بِالَّذِي قَدْ أَمَّلُوا",14,"ل",3,0],["وَرَكِبْتَ فِيهَا كُلَّ صَعْبٍ لَمْ يَكُنْ","لَوْلاَ الإِلاَهُ وَعِزَّ نَصْرِكَ يَسْهُل",15,"ل",1,0],["وركضْتُ طِرْفَ اللّهْوِ في شأْوِ الصِّبا","مَرَحاً فجُزْتُ مَدى النّعيمِ بَعيدا",16,"د",2,0],["ورِكابٍ سَرَوْا وقد سَمَل اللّي","لُ بمِسْحِ الدُّجى جَميعَ النّواحي",17,"ح",2,0],["وَرَكبٍ كَأَطرافِ الأَسِنَّةِ عَرَّسوا","قَلائِصَ في أَصلابِهِنَّ نُحولُ",18,"ل",1,0],["وركابُهما مزمومةٌ","وراءها حادٍ مُشمّرْ",19,"ر",1,0],["وركبِ قنيصٍ قد شهدتُ جيادهم","تُحمْحِمُ في ثيرانِ وحشٍ تَغَمْغمُ",20,"م",1,0],["وَرَكضُكَ غَيرَ مُلتَفِتٍ إِلَينا","كَأَنَّكَ مُمسِكٌ بِجَناحِ بازي",21,"ز",2,0],["وَرَكضُكَ غَيرَ مُلتَفِتٍ إِلَينا","بِخَوّارٍ إِذا عَرِقَ العِذارُ",22,"ر",1,0],["وَرَكبٍ كَالنُجومِ عَلى نُجومٍ","مَرَقنَ مِنَ الفَلاةِ بِهِم مُروقا",23,"ق",2,1],["وَرَكضٌ عَن يَمينٍ أَو شِمالٍ","لِنَظمِ الجَيشِ إِن رُفِعَ اللِواءُ",24,"ا",2,0],["وركوبة الشرق الهجي","ن أو الحمار أو البعير",25,"ر",1,0],["وركوبي يا صديقي","وذهابي وإيابي",26,"ي",1,1],["وركني الذي للنائبات أعدّه","وذخرَي في الماضي وعوني على الحال",27,"ل",1,0],["وَرُكوبِ اللِجاجِ وَهيَ طَواغٍ","وَالسَمَواتِ وَهيَ هوجُ الشَكائِم",28,"م",1,0],["وَرَكِبَ كَإِقبالِ الزَمانِ مُحَجَّلٍ","كَريمِ الحَواشي كابِرِ الخُطُواتِ",29,"ت",1,0],["وركبٍ سرَوا والصبحُ في حِجْرِ أمِّهِ","على شُعَبِ الأكوارِ ميلَ العمائمِ",30,"م",1,0],["وَرَكِبنَ اللَفظَ القَريبَ فَأَدرَك","نَ بِهِ غايَةَ المُرادِ البَعيدِ",31,"د",1,0],["وَرَكبٍ كَأَنَّ الريحَ تَطلُبُ عِندَهُم","لَها تِرَةً مِن جَذبِها بِالعَصائِبِ",32,"ب",1,1],["وَرَكبٍ قَدِ اِستَرخَت طُلاهُم مِنَ السُرى","مُقيمٍ بِلَحيَيهِ النِخاعُ وَأَميَلُ",33,"ل",1,1],["ورَكائبٌ يَخرُجْنَ مِنْ غَلَسِ الدُّجى","مثلَ السِّهامِ مَرَقْنَ منه مُروقا",34,"ق",2,0],["ورَكْبٍ أَممَّوا قَحطا","نَ والَّليلُ بِهِمْ يَسطُو",35,"و",1,1],["وَرَكضي أَدهَمَ الجِلبابِ صافٍ","خَفيفَ الجَريِ يَومَ السَلمِ صافِن",36,"ن",1,0],["وَرَكبٍ كَأَطرافِ الأَسِنَّةِ عَرَّسوا","عَلى مِثلِها وَاللَيلُ تَسطو غَياهِبُه",37,"ب",2,0],["وَرَكبٍ يُساقونَ الرِكابَ زُجاجَةً","مِنَ السَيرِ لَم تَقصِد لَها كَفُّ قاطِبِ",38,"ب",1,0],["وَرُكَّدٌ حَولَ كابٍ قَد عَكَفنَ بِهِ","وَزَينَةٌ ماثِلٌ مِنهُ وَمُنعَفِرُ",39,"ر",1,0],["وَرَكِبتُ دِجلَتَهُ يُضاحِكُني بِها","فَرِحاً حَبيبٌ شاقَني وَحَبابُ",40,"ب",1,0],["وركعن حتى شمأز ركوعٌ","ورجون حتى ستغث لرجءُ",41,"ا",1,0],["وَرَكبٍ دَعَتهُم نَحوَ يَثرِبَ نِيَّةٌ","فَما وَجَدَت إِلاّ مُطيعاً وَسامِعا",42,"ع",2,0],["وَرَكبٍ قَد بَعَثتُ إِلى رَذايا","طَلائِحَ مِثلِ أَخلاقِ الجُفونِ",43,"ن",1,0],["وَرُكُوبٌ إِذا الجَبانُ تَطَوّى","فَرَقاً عِندَ عِرسِهِ في الثِيابِ",44,"ب",1,0],["وَرُكِّبَ القُبحُ فَوقَ حُسنُهُمُ","فَفي سَماجاتِهِم مَلاحاتُ",45,"ت",1,0],["وَرَكِبتُ ما أَهوى وَكَم","أَجفو مَقالَةَ مَن نَهاني",46,"ن",2,0],["وَرَكّابَ أَفراسِ الصَبابَةِ وَالصِبا","جَرَت حِجَجاً ثُمَّ اِستَقَرَّت فَما تَجري",47,"ر",2,0],["وَرَكّابُ أَعوادِ المَنابِرِ لا يَني","خَليفَةَ مُلكٍ لِلصَّعاليكِ أَو حَدّا",48,"د",2,0],["وَرَكِبتُ مِنها أَربَعينَ مَطيَّةً","لَم تَخلو مِن عَنَتٍ وَسوءِ نِفارِ",49,"ر",1,0],["وَرَكبٌ وارِدٌ لِيُقيمَ عَصراً","وَآخَرُ قَد أَجَدَّ بِهِ الرَحيلُ",50,"ل",1,0],["وَرَكوبٍ تَعزِفُ الجِنُّ بِهِ","قَبلَ هَذا الجيلِ مِن عَهدٍ أَبَد",51,"د",1,1],["وَرَكضُكَ لَولاهُ لَقَيتَ الَّذي لَقوا","فَذاكَ الَّذي أَنجاكَ مِمّا هُنالِكا",52,"ك",2,0],["وركبت متن هواها هاشم","وجال غاويها وصال الغاشم",53,"م",1,0],["وركب العلج العصا بمن معهْ","إلا قليلا غودروا في المعمعهْ",54,"ه",1,0],["وركنها كأمس في أم القرى","تطوى القباب والقصور والقرى",55,"ر",2,0],["وَرَكِبْتُمْ مِنْهُ جَوَاداً حَرُوناً","قَلِقاً بِالمُمَرَّسِ المِغْوَارِ",56,"ر",1,0],["وَرَكِبْتَ حِينَ الأَرْضُ وَاجفةٌ","بِالدَّسْتِ ذاكَ المَرْكَبَ الْوَعْرَا",57,"ر",2,0],["وركعنا حتى اشمأزّ ركوعٌ","ورجونا حتى استغاث الرجاء",58,"ا",2,0],["وَرَكِبنا حالاً لِنُكذِبَ عَنّا","قَولَ مَن كانَ بِالبَنانِ أَشارا",59,"ر",2,0],["وركبتم متن الأثير سراعًا","وكشفتم عن النجوم الحجابا؟",60,"ب",2,0],["وركضت طرف اللهوي في شأو الصبا","مرحا فجرت مدى النعيم بعيدا",61,"د",2,0],["وركاب سروا وقد شمل الليل","بمسح الدجى جميع النواحي",62,"ح",2,0],["وركام من التّلاوين ، حتى","لا يبقّي ، لأي (حرباء) لبسا",63,"س",2,0],["وركِبْتُ منها أربَعينَ مَطيّةً،","لم تَخْلُ مِن عَنَتٍ وسوءِ نِفار",64,"ر",1,0],["وركب عليها ، وسم أخفاق عيسهم","وهام تهاوت للكرى وجنوب",65,"ب",1,0],["وركابُها مزمومة ٌ","وراءها حاد مُشمّر",66,"ر",1,0],["وركب في التاج صومالها","ركابُك يا بن المُعِزِّ الغُيوثُ",67,"ث",1,0],["وركب سرى يطوي الفيافي تظنه","سحابة صيف غيمها طيلس الفلا",68,"ل",2,0],["وركناً إذا ضاق الخناق ومنجداً","وذخراً ومفتاحاً لكل مزية",69,"ي",2,0],["ورَكِبْتُ مِنْ هَوْلِ الجَحيمِ خَنادقًا","وغَدَوْتُ مِنْ أَتباعِ (عَبْدِ القادِرِ)",70,"ر",1,0],["ورَكَعْتُ في نَهْديك مُبْتَهِلًا","أُلامِسُ كلَّ نجمٍ في سَماك",71,"ك",1,0],["وَرَكبٌ فَوقَ أنضَاءٍ عِجَافٍ","بَرَاهَا النَّىَّ إدمَانُ التَّغَالِي",72,"ل",2,0],["وَرَكائِبٌ تَهوي بِنا","بِينَ الدُروبِ فَدابِقِ",73,"ق",1,0],["وركبتُ حتى فوق أنفاس العدى","وزحمت حتى منكب الخضراءَ",74,"ا",2,0],["وركبت من خيل النهى","طرفا جموحا زائغا",75,"غ",2,0],["وركب فيّ خلاف الذي","يردن ويهوينمن كل شر",76,"ر",1,0],["وركبٍ تَساقَوْا كؤوسَ الكرى","وقد طلب النومَ طولُ السرى",77,"ر",2,1],["وركنتم بعد التظا","هر للفرار مرافقين",78,"ن",1,0],["وَرَكائِبٌ شَطَّت بِكُم لَو حُمِّلَت","وَجدي لَما مَدَّت لِرَحّالٍ يَدا",79,"د",2,0],["وَرَكَضْتُ أَفْرَاسَ الْبِطَالَةِ لاَهِياً","مَا بَيْنَ أَزَاهِرِ الْهَوَى وَصِلاَلِهَا",80,"ل",3,0],["وركن الهدى واهي الدعائم واهن","إذا لم تشده بالأكف سيوف",81,"ف",1,0],["وَرَكْباً أفادَتْني الليالي وَلاءهُم","لهم بالعُلى وَجدٌ وفي سُبلِها وَخدُ",82,"د",1,0],["وَرَكْبٍ أَمَاطُوا الْهَمَّ عَنْهُمْ بِهِمَّةٍ","سَواءٌ بِها أَقْصى الْمَرامِ وأَدْناهُ",83,"ا",2,0],["وَرَكبٍ عَلى أَكوارِهِنَّ كَأَنَّهُم","سِهامٌ بِأَكبادِ القِسِيِّ تَشَدَّدُ",84,"د",1,0],["وركتك أوراق المصاحف وانتهى","إلى الله منها طول درسك والدكر",85,"ر",1,0],["وَركب سروا وَالعيس أَمَّت طويلعا","فَكانوا بُدوراً لِلدياجر طُلَّعا",86,"ع",2,0],["وركْبٍ آنسوا أمَداً فحَثّوا","إليه العِيسَ تَمرَحُ في المَثاني",87,"ن",2,0],["وَرْكبٍ كالكواكبِ ليس يَخْشَى","ضَلالاً في الظّلامِ ولا كَلالا",88,"ل",2,0],["ورَكِبْتُ أجنحةَ الرّياحِ حَثيثةً","أَبْغي بِهنَّ إلى ذُراكَ رَحيلا",89,"ل",2,0],["وركَضْتُ خيلَ القَوْلِ بي","ن يَديهِ واسعةَ المَجال",90,"ل",1,0],["ورِكاب الغرامِ في كلِّ خَبتٍ","ووِهادٍ تُضِلُّها الأعداءُ",91,"ا",2,0],["وَرَكب أَدلَجوا وَاللَيل مَرس","بِكلكلةٍ عَلى قَلب رقود",92,"د",1,0],["ورَكبتُ مِنْ عَزْمي إليكَ مَطيِّةً","وجعلتُ ذكركَ في المفاوزِ زادي",93,"د",2,0],["وَرَكائِبٍ يخرجنَ من غَلس الدُجى","مثل السِهام مرقن فيهِ مُروقا",94,"ق",2,0],["وركض الغرام بأحشائها","ونحن ركوبٌ على ظهرها",95,"ر",3,0],["وركِبْنَا على عذابٍ بِحارًا","أَنْزَلَتْنَا على عذابِ بِحارِ",96,"ر",1,0],["وركضتُ في المدْحِ الخطيرِ بخاطرٍ","يُقْضى له بالسَبْقِ في مَيدانِه",97,"ن",2,0],["وركبٍ سرى والليل مرخ سدوله","يخوض الدجى والهم يحدوهم حدوا",98,"و",2,0],["وركناك بدر الدين من سيف عزمه","يفلّ شبا الأيام إن خيف من ضرّ",99,"ر",1,0],["وركب تساقوا بكاس السرى","وكاسِ الكرى والندامى النجُب",100,"ب",1,0],["وركب تداعوا للسرى ثمتّ انبرى","ليبقي القرى بعد الهدى ذلك الوفد",101,"د",1,0],["وركب طوت سحل الربار مشيحة","على سنشف مثل الحنايا أو القنا",102,"ن",2,0],["وركب طوت سجل الزيازي لوصلها","حدت بمديحي أو نسيبي ركابها",103,"ب",3,0],["وركاب سعد في الفلا متنقل","لمقرّ عزّ بالمفاخر شاهد",104,"د",1,0],["وركبت كلَّ مقطِّر بسواك من","ظهر الكفاية متنُه لا يُردَفُ",105,"ف",1,0],["وركبٍ كأَنَّ العيس أَيَّانَ ثوروا","تساوقُ أَعناق الصَّبا والجنائبِ",106,"ب",1,0],["وركبٍ كأمثالِ القِداح تعاقروا","كؤوس السرى والليلُ مُرخى الذلاذل",107,"ل",1,0],["وركْبٍ كالصُّقور سَروْا بليلٍ","لهُمْ