{"poems":[[64,"نعم الإعانة رمزا في خفا لطف","https://www.aldiwan.net/poem67616.html","البسيط"],[51,"قل للأمير إذا مثلت له","https://www.aldiwan.net/poem64651.html","أحذ الكامل"],[66,"كفى البدر حسنا أن يقال نظيرها","https://www.aldiwan.net/poem41546.html","الطويل"],[80,"حرر لمعناك لفظا كي تزان به","https://www.aldiwan.net/poem31319.html","البسيط"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[67,"حي بلبيس منزلا في العماره","https://www.aldiwan.net/poem18062.html","الخفيف"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[1,"أشجاك الربع أم قدمه","https://www.aldiwan.net/poem34014.html","المديد"],[113,"صحف الفضاء لما نقول دفاتر","https://www.aldiwan.net/poem40935.html","عموديه"],[113,"الله قل واترك سواه فما السوى","https://www.aldiwan.net/poem42200.html","الكامل"],[119,"بالواسعات أرى الأشواق تنهمر","https://www.aldiwan.net/poem23811.html","البسيط"],[122,"إن الزمان ولا أقول زماني","https://www.aldiwan.net/poem23705.html","الكامل"],[127,"سيان أن تصغي","https://www.aldiwan.net/poem67455.html","مجزوء الرجز"],[133,"الراح يحسن في الصفا مسعاها","https://www.aldiwan.net/poem49131.html","الكامل"],[155,"تقبل الله منا ومنكم","https://www.aldiwan.net/poem23649.html","مجزوء الرجز"],[158,"من قلد العلما واقدم أعذرا","https://www.aldiwan.net/poem59178.html","الكامل"],[183,"هل لي إلى الثغر من عود ومنقلب","https://www.aldiwan.net/poem14106.html","البسيط"],[187,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[193,"شطت بجارتك النوى فتحمل","https://www.aldiwan.net/poem54423.html","الكامل"],[196,"رق النسيم وراق الروض بالزهر","https://www.aldiwan.net/poem51946.html","البسيط"],[233,"بأبي من ذبت في الح","https://www.aldiwan.net/poem31630.html","مجزوء الرمل"],[233,"أولعت بالغدر في أيمانها","https://www.aldiwan.net/poem31728.html","الرمل"],[257,"يا سالك بالهدى طريق البكري","https://www.aldiwan.net/poem35429.html","الدوبيت"],[269,"وجد تحرك في قلبي فما سكنا","https://www.aldiwan.net/poem52053.html","البسيط"],[269,"راح الزمان ولا علم عن العلم","https://www.aldiwan.net/poem52057.html","البسيط"],[269,"بمحمد خطر المحامد يعظم","https://www.aldiwan.net/poem52125.html","الكامل"],[351,"خذ حل إشكال أشكال أشرت لها","https://www.aldiwan.net/poem39586.html","البسيط"],[362,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[374,"عيني تلت ما سطرته يميني","https://www.aldiwan.net/poem59232.html","الكامل"],[374,"إحذر فديتك كبريا نفس سمت","https://www.aldiwan.net/poem59404.html","الكامل"],[374,"بشراك بشراك قد أدناكم النائي","https://www.aldiwan.net/poem66985.html","البسيط"],[400,"هتف القمري في الروض وغنى","https://www.aldiwan.net/poem33384.html","الرمل"],[400,"أسواك إن حلت بنا اللوآء","https://www.aldiwan.net/poem34179.html","الكامل"],[418,"الله قل وذر الوجود وما حوى","https://www.aldiwan.net/poem46406.html","الكامل"],[438,"أنا الغريب فلولا المجد والحسب","https://www.aldiwan.net/poem14420.html","البسيط"],[450,"للفيجة الغناء عين لم تزل","https://www.aldiwan.net/poem13741.html","الكامل"],[459,"أحببته غمر الرداء والشيم","https://www.aldiwan.net/poem16104.html","الرجز"],[513,"أثمت يا من هجا السادات والخلفا","https://www.aldiwan.net/poem12178.html","البسيط"],[551,"فالكلب إن جاع لم يعدمك بصبصة","https://www.aldiwan.net/poem68306.html","البسيط"],[556,"خذها إليك لها هدى وبيان","https://www.aldiwan.net/poem33803.html","الكامل"],[556,"الفعل معدوم لا يظهر بلا فاعل","https://www.aldiwan.net/poem34203.html","المواليا"],[556,"انهض بربك لا بنفسك","https://www.aldiwan.net/poem34286.html","مجزوء الكامل"],[556,"إن القناعة في الدنيا هي الشرف","https://www.aldiwan.net/poem34345.html","البسيط"],[556,"إن الوجود الحق بي يتلفظ","https://www.aldiwan.net/poem34399.html","الكامل"],[556,"حروف أرواح سقط","https://www.aldiwan.net/poem34411.html","مجزوء الرجز"],[556,"أول منامك هذا","https://www.aldiwan.net/poem34557.html","المجتث"],[561,"يا عاصمي يا سالمي يا قاسمي","https://www.aldiwan.net/poem13606.html","الكامل"],[565,"نعم المعين على الآداب والحكم","https://www.aldiwan.net/poem69506.html","البسيط"]],"verses":[["فَالكُلُّ يَشهَدُهُ كُلّاً وَأَشهَدُهُ","مَعَ الحَقيقَةِ لا بِالشَخصِ مِن طَلَبِه",0,"ل",3,0],["فالكَفُّ عن أمثاله غبَنٌ","ومِراسُهُ من أعظم الوكس",1,"س",1,0],["فَآلُكَ خَيرُ الآلِ وَالعِترَةُ الَّتي","مَحَبَّتُها نُعمى قَليلٌ شَكورُها",2,"ر",3,0],["فالكحلُ لا يفتنُ الأبصارَ منظرُهُ","حتى يُصَيَّرَ حَشْوَ الأعينِ النُّجُلِ",3,"ل",1,0],["فَالكُفرُ مِن بَأسِهِ المَشهورِ في حَرَبٍ","وَالدِّينُ مِن عَدلِهِ المَأثُورِ في حَرَمِ",4,"م",1,0],["فالكوانينُ ما تُعابُ مِنَ البَرْ","دِ بَطَبَّاخَةٍ وَلا شَكَّارَهْ",5,"ر",2,0],["فالكُتبُ والرُّسلُ من عِندَ الإلهِ أَتَت","ومنهم فاضِلٌ حَقّاً ومَفضولُ",6,"ل",1,0],["فالكُتْبُ لولا أنّها لكَ شُهَّدٌ","ما فُصِّلَتْ آياتُهَا تفصيلا",7,"ل",2,0],["فَالكَثيبُ مُعشِبٌ أُنُفٌ","فَتَناهيهِ فَمُرتَكَمُه",8,"م",2,0],["فالكون بين العالمين صحيفة","وكلامنا فيها اليها صائر",9,"ر",1,0],["فالكل ظل والزمان حكاية","وبداية تسعى إلى الإتمام",10,"م",1,0],["فالكون أجمعه من سرِّ نقطته","وسرُّ خلقته في الخلق منتشرُ",11,"ر",1,0],["فالكأس لولا اليأس ما هشت له","كبد ولا حدبت عليه يدان",12,"ن",1,0],["فالكأسُ ان تَطفَح","كالكأس في النَقصِ",13,"ص",1,0],["فالكعبة ابتهجت ومكة أشرقت","وسمت معالمُ أرضها وسماها",14,"ا",3,0],["فالكائِنَاتُ سُجَّدٌ","على المَدَى مُذْ اُمِرَتْ",15,"ت",1,0],["فالكفر إن يظهر على ما قاله","فلقد خبا الإسلام فيه واضمرا",16,"ر",2,0],["فالكلُّ في بعضِ جزءٍ من محاسنه","بغير عيبٍ فقد شابوا ولم يَشِبِ",17,"ب",1,0],["فالكونُ فرعٌ والنبيُّ أصل","ليسَ لهُ في العالمين مثلُ",18,"ل",1,0],["فَالكلُّ مِنهم في جنانِ الخلدِ","حتَّى أَتى خيرُ الورى مُهذّباً",18,"ب",2,0],["فَالكَعبُ أَصمَعُ وَالقَطاةُ يَزينُها","هادٍ لَهُ قَرواً شَديدَ المَوصِلِ",19,"ل",1,0],["فالكأَسُ في كفِّه بالراحِ مُتْرَعَةٌ","كهالةٍ أَحْدَقَتْ في الأُفْق بالقمر",20,"ر",1,0],["فَالكَريمِ الخيمِ مَن وُجِّ","هَتِ الآمالِ نَحوَه",21,"و",2,0],["فَالكُماةُ الصِيِّدُ في يَومِ الوَغى","كومُها وَالوَحشُ مِن ضيفانِها",22,"ن",3,0],["فالكون بأسره ظلام حالك","قد نار بلا إله إلّا الله",23,"ه",1,0],["فالكَون مسترق منهم محاسنه","وَالدين يَلبس منهم بهجة وَسنا",24,"ن",2,0],["فالكائنات لديه غير غائبة","والارض بين يديه خطوة القدم",25,"م",1,0],["فالكل فير بركاته يتنعم","فَبحقه صَلوا عليه وَسلموا",26,"م",3,0],["فَالكاف لِلموجب الكلّي وَسالبه","لامٌ وَسينٌ لِسَلب الجُزء قَد جعلا",27,"ل",2,0],["فَالكَتفُ مِنها بِالشَقيقِ تَدمى","وَالرُعبُ أَضحى لِلشِتاءِ هَزما",28,"م",2,0],["فالكفر والتنِّينُ والخَودُ اقتضت","إثماً وشيطاناً ونفسَ أمين",29,"ن",1,0],["فالكِبر أهبط كوكب الصبح البهي","والكفر زج سَكَندراً في النار",30,"ر",1,0],["فالكُفر في حَرَبٍ والكذْبُ في كُرَبٍ","والصِدقُ في طَربٍ والحاءُ في الياءِ",31,"ا",2,0],["فالكنى مبتدعات لم يكن","سيد الأشراف في الإِسلام يكنى",32,"ن",2,0],["فالكل يعجز عن ثنا ما ناله","بل شكرهم فيه لك النعماء",33,"ا",2,0],["فالكل مختلف كذاك صفاتهم","فيهم غدا الشوهاء والحسناء",33,"ا",2,0],["فالكلُّ دون اللَهِ إن حقّقتهُ","عدمٌ على التفصيل والإجمال",34,"ل",1,0],["فالكلب أَفضل ممن لا له أَدب","ولا عفاف ولا علم ولا نشب",35,"ب",1,0],["فالكنز يطلب بالعناء وهذه","كنز تسيل من لجين بارد",36,"د",1,0],["فالكلُّ صرْعى من حجاهُ والفَهَمْ","عاش مُطاعاً ما هدى السَّفْر علَمْ",37,"م",1,0],["فالكلب يا كلب أسنى منك مكرمة","لأن فيه حفاظاً دائماً ووفا",38,"ف",2,0],["فَالكَلبُ إِن جاعَ لَم يَعدُمَكَ بَصَبصَةً","وَإِن يَنَل شَبعَةً يَنبَح عَلى الأَثَرِ",39,"ر",1,1],["فالكل موجودون منه به له","لولاه كان وجودهم ما كانوا",40,"ن",3,0],["فالكل مجعول فاني خلقة الجاعلْ","نور الوجود به قنديلنا شاعلْ",41,"ل",1,0],["فالكل أنت وأنت هو","والهو غداً فلكاً لشمسك",42,"ك",1,0],["فالكل فانٍ وكل الناس عن كثبٍ","هم التراب وأقوام هم الجيف",43,"ف",1,0],["فالكائنات كلامه عن أمره","ناش له الروح الشريفة ملحظ",44,"ظ",1,0],["فالكل للذنب التَقَطْ","من ذا الذي ما ساء قطّْ",45,"ط",1,0],["فالكل فانٍ ولكن","أما الإله فهذا",46,"ذ",2,0],["فَالكُفرُ في التَقليدِ في الأُخرى فَقَط","يَختَصُّ بِالإِجماعِ عِندَ الجازِمِ",47,"م",1,0],["فَالْكُمُّ يَعْبَقُ مِنْهَا حِيْنَ تُودِعُهُ","عَرْفَاً تَنَسَّمُ فِيْهَا أَطْيَبَ النَّسَمِ",48,"م",1,0]]}