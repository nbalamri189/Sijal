{"poems":[[108,"حتام يا قلب","https://www.shoaraa.com/p11133",""],[64,"نعم الإعانة رمزا في خفا لطف","https://www.aldiwan.net/poem67616.html","البسيط"],[51,"قل للأمير إذا مثلت له","https://www.aldiwan.net/poem64651.html","أحذ الكامل"],[66,"كفى البدر حسنا أن يقال نظيرها","https://www.aldiwan.net/poem41546.html","الطويل"],[80,"حرر لمعناك لفظا كي تزان به","https://www.aldiwan.net/poem31319.html","البسيط"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[67,"حي بلبيس منزلا في العماره","https://www.aldiwan.net/poem18062.html","الخفيف"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[1,"أشجاك الربع أم قدمه","https://www.aldiwan.net/poem34014.html","المديد"],[116,"صحف الفضاء لما نقول دفاتر","https://www.aldiwan.net/poem40935.html","عموديه"],[116,"الله قل واترك سواه فما السوى","https://www.aldiwan.net/poem42200.html","الكامل"],[122,"بالواسعات أرى الأشواق تنهمر","https://www.aldiwan.net/poem23811.html","البسيط"],[125,"إن الزمان ولا أقول زماني","https://www.aldiwan.net/poem23705.html","الكامل"],[130,"سيان أن تصغي","https://www.aldiwan.net/poem67455.html","مجزوء الرجز"],[136,"الراح يحسن في الصفا مسعاها","https://www.aldiwan.net/poem49131.html","الكامل"],[158,"تقبل الله منا ومنكم","https://www.aldiwan.net/poem23649.html","مجزوء الرجز"],[161,"من قلد العلما واقدم أعذرا","https://www.aldiwan.net/poem59178.html","الكامل"],[186,"هل لي إلى الثغر من عود ومنقلب","https://www.aldiwan.net/poem14106.html","البسيط"],[190,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[196,"شطت بجارتك النوى فتحمل","https://www.aldiwan.net/poem54423.html","الكامل"],[199,"رق النسيم وراق الروض بالزهر","https://www.aldiwan.net/poem51946.html","البسيط"],[236,"بأبي من ذبت في الح","https://www.aldiwan.net/poem31630.html","مجزوء الرمل"],[236,"أولعت بالغدر في أيمانها","https://www.aldiwan.net/poem31728.html","الرمل"],[260,"يا سالك بالهدى طريق البكري","https://www.aldiwan.net/poem35429.html","الدوبيت"],[272,"وجد تحرك في قلبي فما سكنا","https://www.aldiwan.net/poem52053.html","البسيط"],[272,"راح الزمان ولا علم عن العلم","https://www.aldiwan.net/poem52057.html","البسيط"],[272,"بمحمد خطر المحامد يعظم","https://www.aldiwan.net/poem52125.html","الكامل"],[354,"خذ حل إشكال أشكال أشرت لها","https://www.aldiwan.net/poem39586.html","البسيط"],[365,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[378,"عيني تلت ما سطرته يميني","https://www.aldiwan.net/poem59232.html","الكامل"],[378,"إحذر فديتك كبريا نفس سمت","https://www.aldiwan.net/poem59404.html","الكامل"],[378,"بشراك بشراك قد أدناكم النائي","https://www.aldiwan.net/poem66985.html","البسيط"],[404,"هتف القمري في الروض وغنى","https://www.aldiwan.net/poem33384.html","الرمل"],[404,"أسواك إن حلت بنا اللوآء","https://www.aldiwan.net/poem34179.html","الكامل"],[422,"الله قل وذر الوجود وما حوى","https://www.aldiwan.net/poem46406.html","الكامل"],[442,"أنا الغريب فلولا المجد والحسب","https://www.aldiwan.net/poem14420.html","البسيط"],[453,"للفيجة الغناء عين لم تزل","https://www.aldiwan.net/poem13741.html","الكامل"],[462,"أحببته غمر الرداء والشيم","https://www.aldiwan.net/poem16104.html","الرجز"],[516,"أثمت يا من هجا السادات والخلفا","https://www.aldiwan.net/poem12178.html","البسيط"],[554,"فالكلب إن جاع لم يعدمك بصبصة","https://www.aldiwan.net/poem68306.html","البسيط"],[559,"خذها إليك لها هدى وبيان","https://www.aldiwan.net/poem33803.html","الكامل"],[559,"الفعل معدوم لا يظهر بلا فاعل","https://www.aldiwan.net/poem34203.html","المواليا"],[559,"انهض بربك لا بنفسك","https://www.aldiwan.net/poem34286.html","مجزوء الكامل"],[559,"إن القناعة في الدنيا هي الشرف","https://www.aldiwan.net/poem34345.html","البسيط"],[559,"إن الوجود الحق بي يتلفظ","https://www.aldiwan.net/poem34399.html","الكامل"],[559,"حروف أرواح سقط","https://www.aldiwan.net/poem34411.html","مجزوء الرجز"],[559,"أول منامك هذا","https://www.aldiwan.net/poem34557.html","المجتث"],[564,"يا عاصمي يا سالمي يا قاسمي","https://www.aldiwan.net/poem13606.html","الكامل"],[568,"نعم المعين على الآداب والحكم","https://www.aldiwan.net/poem69506.html","البسيط"]],"verses":[["فالكل جان وإن لم يأت فاحشة","سيان في الجرم من أموا ومن أمموا",0,"م",3,0],["فَالكُلُّ يَشهَدُهُ كُلّاً وَأَشهَدُهُ","مَعَ الحَقيقَةِ لا بِالشَخصِ مِن طَلَبِه",1,"ل",3,0],["فالكَفُّ عن أمثاله غبَنٌ","ومِراسُهُ من أعظم الوكس",2,"س",1,0],["فَآلُكَ خَيرُ الآلِ وَالعِترَةُ الَّتي","مَحَبَّتُها نُعمى قَليلٌ شَكورُها",3,"ر",3,0],["فالكحلُ لا يفتنُ الأبصارَ منظرُهُ","حتى يُصَيَّرَ حَشْوَ الأعينِ النُّجُلِ",4,"ل",1,0],["فَالكُفرُ مِن بَأسِهِ المَشهورِ في حَرَبٍ","وَالدِّينُ مِن عَدلِهِ المَأثُورِ في حَرَمِ",5,"م",1,0],["فالكوانينُ ما تُعابُ مِنَ البَرْ","دِ بَطَبَّاخَةٍ وَلا شَكَّارَهْ",6,"ر",2,0],["فالكُتبُ والرُّسلُ من عِندَ الإلهِ أَتَت","ومنهم فاضِلٌ حَقّاً ومَفضولُ",7,"ل",1,0],["فالكُتْبُ لولا أنّها لكَ شُهَّدٌ","ما فُصِّلَتْ آياتُهَا تفصيلا",8,"ل",2,0],["فَالكَثيبُ مُعشِبٌ أُنُفٌ","فَتَناهيهِ فَمُرتَكَمُه",9,"م",2,0],["فالكون بين العالمين صحيفة","وكلامنا فيها اليها صائر",10,"ر",1,0],["فالكل ظل والزمان حكاية","وبداية تسعى إلى الإتمام",11,"م",1,0],["فالكون أجمعه من سرِّ نقطته","وسرُّ خلقته في الخلق منتشرُ",12,"ر",1,0],["فالكأس لولا اليأس ما هشت له","كبد ولا حدبت عليه يدان",13,"ن",1,0],["فالكأسُ ان تَطفَح","كالكأس في النَقصِ",14,"ص",1,0],["فالكعبة ابتهجت ومكة أشرقت","وسمت معالمُ أرضها وسماها",15,"ا",3,0],["فالكائِنَاتُ سُجَّدٌ","على المَدَى مُذْ اُمِرَتْ",16,"ت",1,0],["فالكفر إن يظهر على ما قاله","فلقد خبا الإسلام فيه واضمرا",17,"ر",2,0],["فالكلُّ في بعضِ جزءٍ من محاسنه","بغير عيبٍ فقد شابوا ولم يَشِبِ",18,"ب",1,0],["فالكونُ فرعٌ والنبيُّ أصل","ليسَ لهُ في العالمين مثلُ",19,"ل",1,0],["فَالكلُّ مِنهم في جنانِ الخلدِ","حتَّى أَتى خيرُ الورى مُهذّباً",19,"ب",2,0],["فَالكَعبُ أَصمَعُ وَالقَطاةُ يَزينُها","هادٍ لَهُ قَرواً شَديدَ المَوصِلِ",20,"ل",1,0],["فالكأَسُ في كفِّه بالراحِ مُتْرَعَةٌ","كهالةٍ أَحْدَقَتْ في الأُفْق بالقمر",21,"ر",1,0],["فَالكَريمِ الخيمِ مَن وُجِّ","هَتِ الآمالِ نَحوَه",22,"و",2,0],["فَالكُماةُ الصِيِّدُ في يَومِ الوَغى","كومُها وَالوَحشُ مِن ضيفانِها",23,"ن",3,0],["فالكون بأسره ظلام حالك","قد نار بلا إله إلّا الله",24,"ه",1,0],["فالكَون مسترق منهم محاسنه","وَالدين يَلبس منهم بهجة وَسنا",25,"ن",2,0],["فالكائنات لديه غير غائبة","والارض بين يديه خطوة القدم",26,"م",1,0],["فالكل فير بركاته يتنعم","فَبحقه صَلوا عليه وَسلموا",27,"م",3,0],["فَالكاف لِلموجب الكلّي وَسالبه","لامٌ وَسينٌ لِسَلب الجُزء قَد جعلا",28,"ل",2,0],["فَالكَتفُ مِنها بِالشَقيقِ تَدمى","وَالرُعبُ أَضحى لِلشِتاءِ هَزما",29,"م",2,0],["فالكفر والتنِّينُ والخَودُ اقتضت","إثماً وشيطاناً ونفسَ أمين",30,"ن",1,0],["فالكِبر أهبط كوكب الصبح البهي","والكفر زج سَكَندراً في النار",31,"ر",1,0],["فالكُفر في حَرَبٍ والكذْبُ في كُرَبٍ","والصِدقُ في طَربٍ والحاءُ في الياءِ",32,"ا",2,0],["فالكنى مبتدعات لم يكن","سيد الأشراف في الإِسلام يكنى",33,"ن",2,0],["فالكل يعجز عن ثنا ما ناله","بل شكرهم فيه لك النعماء",34,"ا",2,0],["فالكل مختلف كذاك صفاتهم","فيهم غدا الشوهاء والحسناء",34,"ا",2,0],["فالكلُّ دون اللَهِ إن حقّقتهُ","عدمٌ على التفصيل والإجمال",35,"ل",1,0],["فالكلب أَفضل ممن لا له أَدب","ولا عفاف ولا علم ولا نشب",36,"ب",1,0],["فالكنز يطلب بالعناء وهذه","كنز تسيل من لجين بارد",37,"د",1,0],["فالكلُّ صرْعى من حجاهُ والفَهَمْ","عاش مُطاعاً ما هدى السَّفْر علَمْ",38,"م",1,0],["فالكلب يا كلب أسنى منك مكرمة","لأن فيه حفاظاً دائماً ووفا",39,"ف",2,0],["فَالكَلبُ إِن جاعَ لَم يَعدُمَكَ بَصَبصَةً","وَإِن يَنَل شَبعَةً يَنبَح عَلى الأَثَرِ",40,"ر",1,1],["فالكل موجودون منه به له","لولاه كان وجودهم ما كانوا",41,"ن",3,0],["فالكل مجعول فاني خلقة الجاعلْ","نور الوجود به قنديلنا شاعلْ",42,"ل",1,0],["فالكل أنت وأنت هو","والهو غداً فلكاً لشمسك",43,"ك",1,0],["فالكل فانٍ وكل الناس عن كثبٍ","هم التراب وأقوام هم الجيف",44,"ف",1,0],["فالكائنات كلامه عن أمره","ناش له الروح الشريفة ملحظ",45,"ظ",1,0],["فالكل للذنب التَقَطْ","من ذا الذي ما ساء قطّْ",46,"ط",1,0],["فالكل فانٍ ولكن","أما الإله فهذا",47,"ذ",2,0],["فَالكُفرُ في التَقليدِ في الأُخرى فَقَط","يَختَصُّ بِالإِجماعِ عِندَ الجازِمِ",48,"م",1,0],["فَالْكُمُّ يَعْبَقُ مِنْهَا حِيْنَ تُودِعُهُ","عَرْفَاً تَنَسَّمُ فِيْهَا أَطْيَبَ النَّسَمِ",49,"م",1,0]]}