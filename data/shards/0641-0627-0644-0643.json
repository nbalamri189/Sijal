لأفراح صادحة","https://www.poetsgate.com/ViewPoem.aspx?id=202642",""],[5973,"وعصرت َفي شفتيَّّ جِلدك َ كلَّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=13750",""],[6031,"إنْ تُبعدِ الأيَّامُ ذَاتِي عَنكُمُ","https://www.poetsgate.com/ViewPoem.aspx?id=46380",""],[161,"بيْنَ السَّجؤينِ وخُطَّةِ السَّجَّانِ","https://www.poetsgate.com/ViewPoem.aspx?id=175319",""],[6070,"سُبْحانَ مَنْ جَمَعَ الضدّينِ في بَدَنِ","https://www.poetsgate.com/ViewPoem.aspx?id=189127",""],[6102,"ماخُور !!","https://www.poetsgate.com/ViewPoem.aspx?id=185041",""],[6102,"كُرَةُ النَّدَم !!","https://www.poetsgate.com/ViewPoem.aspx?id=186288",""],[6115,"كيف حالك يايميني","https://www.poetsgate.com/ViewPoem.aspx?id=180460",""],[6120,"‏إِنْهَضْ فَأَنْتَ مَشَاْرِقُ الإِصْبَاْحِ","https://www.poetsgate.com/ViewPoem.aspx?id=215467",""],[6124,"معارضة المتنبي","https://www.poetsgate.com/ViewPoem.aspx?id=121833",""],[6142,"سل كربلا والوغى والبيض والأسلا","https://www.poetsgate.com/ViewPoem.aspx?id=155747",""],[520,"أثمت يا من هجا السادات والخلفا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577576",""],[2220,"الجودُ أولى بهِ والفقرُ أولى بنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11811&r=&rc=681",""],[572,"نِعْمَ المعينُ على الآدابِ والحكَمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9468&r=&rc=325",""]],"verses":[["فالكل جان وإن لم يأت فاحشة","سيان في الجرم من أموا ومن أمموا",0,"م",3,0],["فَالكُلُّ يَشهَدُهُ كُلّاً وَأَشهَدُهُ","مَعَ الحَقيقَةِ لا بِالشَخصِ مِن طَلَبِه",1,"ل",3,0],["فالكَفُّ عن أمثاله غبَنٌ","ومِراسُهُ من أعظم الوكس",2,"س",1,0],["فَآلُكَ خَيرُ الآلِ وَالعِترَةُ الَّتي","مَحَبَّتُها نُعمى قَليلٌ شَكورُها",3,"ر",3,0],["فالكحلُ لا يفتنُ الأبصارَ منظرُهُ","حتى يُصَيَّرَ حَشْوَ الأعينِ النُّجُلِ",4,"ل",1,0],["فَالكُفرُ مِن بَأسِهِ المَشهورِ في حَرَبٍ","وَالدِّينُ مِن عَدلِهِ المَأثُورِ في حَرَمِ",5,"م",1,0],["فالكوانينُ ما تُعابُ مِنَ البَرْ","دِ بَطَبَّاخَةٍ وَلا شَكَّارَهْ",6,"ر",2,0],["فالكُتبُ والرُّسلُ من عِندَ الإلهِ أَتَت","ومنهم فاضِلٌ حَقّاً ومَفضولُ",7,"ل",1,0],["فالكُتْبُ لولا أنّها لكَ شُهَّدٌ","ما فُصِّلَتْ آياتُهَا تفصيلا",8,"ل",2,0],["فَالكَثيبُ مُعشِبٌ أُنُفٌ","فَتَناهيهِ فَمُرتَكَمُه",9,"م",2,0],["فالكون بين العالمين صحيفة","وكلامنا فيها اليها صائر",10,"ر",1,0],["فالكل ظل والزمان حكاية","وبداية تسعى إلى الإتمام",11,"م",1,0],["فالكون أجمعه من سرِّ نقطته","وسرُّ خلقته في الخلق منتشرُ",12,"ر",1,0],["فالكأس لولا اليأس ما هشت له","كبد ولا حدبت عليه يدان",13,"ن",1,0],["فالكأسُ ان تَطفَح","كالكأس في النَقصِ",14,"ص",1,0],["فالكعبة ابتهجت ومكة أشرقت","وسمت معالمُ أرضها وسماها",15,"ا",3,0],["فالكائِنَاتُ سُجَّدٌ","على المَدَى مُذْ اُمِرَتْ",16,"ت",1,0],["فالكفر إن يظهر على ما قاله","فلقد خبا الإسلام فيه واضمرا",17,"ر",2,0],["فالكلُّ في بعضِ جزءٍ من محاسنه","بغير عيبٍ فقد شابوا ولم يَشِبِ",18,"ب",1,0],["فالكونُ فرعٌ والنبيُّ أصل","ليسَ لهُ في العالمين مثلُ",19,"ل",1,0],["فَالكلُّ مِنهم في جنانِ الخلدِ","حتَّى أَتى خيرُ الورى مُهذّباً",19,"ب",2,0],["فَالكَعبُ أَصمَعُ وَالقَطاةُ يَزينُها","هادٍ لَهُ قَرواً شَديدَ المَوصِلِ",20,"ل",1,0],["فالكأَسُ في كفِّه بالراحِ مُتْرَعَةٌ","كهالةٍ أَحْدَقَتْ في الأُفْق بالقمر",21,"ر",1,0],["فَالكَريمِ الخيمِ مَن وُجِّ","هَتِ الآمالِ نَحوَه",22,"و",2,0],["فَالكُماةُ الصِيِّدُ في يَومِ الوَغى","كومُها وَالوَحشُ مِن ضيفانِها",23,"ن",3,0],["فالكون بأسره ظلام حالك","قد نار بلا إله إلّا الله",24,"ه",1,0],["فالكَون مسترق منهم محاسنه","وَالدين يَلبس منهم بهجة وَسنا",25,"ن",2,0],["فالكائنات لديه غير غائبة","والارض بين يديه خطوة القدم",26,"م",1,0],["فالكل فير بركاته يتنعم","فَبحقه صَلوا عليه وَسلموا",27,"م",3,0],["فَالكاف لِلموجب الكلّي وَسالبه","لامٌ وَسينٌ لِسَلب الجُزء قَد جعلا",28,"ل",2,0],["فَالكَتفُ مِنها بِالشَقيقِ تَدمى","وَالرُعبُ أَضحى لِلشِتاءِ هَزما",29,"م",2,0],["فالكفر والتنِّينُ والخَودُ اقتضت","إثماً وشيطاناً ونفسَ أمين",30,"ن",1,0],["فالكِبر أهبط كوكب الصبح البهي","والكفر زج سَكَندراً في النار",31,"ر",1,0],["فالكُفر في حَرَبٍ والكذْبُ في كُرَبٍ","والصِدقُ في طَربٍ والحاءُ في الياءِ",32,"ا",2,0],["فالكنى مبتدعات لم يكن","سيد الأشراف في الإِسلام يكنى",33,"ن",2,0],["فالك