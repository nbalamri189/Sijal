{"poems":[[48,"قد أصبحت ونعاتها نعاتها","https://www.aldiwan.net/poem22158.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55012","الوافر"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/116981","المتقارب"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56569","الطويل"],[1491,"","https://poetry.dctabudhabi.ae/diwan/poem/107310","الطويل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111806","الوافر"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108466","الوافر"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106869","الوافر"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106879","الطويل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109787","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86337","الطويل"],[6268,"مرثية الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82926&r=&rc=12",""]],"verses":[["وَتَرِثُّ أَغراضُ الشَبابِ وَيَنطَوي","إِبّانُها فَتَنيبُ مُرتَدَعاتُها",0,"ت",3,0],["وَتَرْثِي لِلأَنَامِ مِنَ اللَّيَالِي","وَلاَ يَلْقَاكَ حَادِثُهَا هَلُوعَا",1,"ع",2,0],["وترثي لصبٍّ بكُم مغرَمٌ","أقام على هجركم مأتما",2,"م",2,0],["وترثي لبلواك المدائن رحمة","وقد حسدت فيك السرور العواصم",3,"م",1,0],["وتَرثِي لِمَن قد أنحلَ البُعدُ جسمَهُ","وترحمُ قلباً في هواكَ عميدُ",4,"د",1,0],["وترثيكَ المعارفُ والمعالي","وتبكيكَ المحافلُ والجموعُ",5,"ع",1,0],["وترثيه نضارة كلّ غصن","وأيام الصبا تبكي صباه",6,"ا",2,0],["وترثي العقل وهو أغرُّ زاهٍ","أُصيب فما استفاد ولا أفادا",7,"د",2,0],["وترثي شباباً كان نوراً وقد خبا","وتندب قلباً كان جمراً فأُخمدا",8,"د",2,0],["وترثيه المروءة وهي تروي","حديث صبائه الغض الرطيب",9,"ب",1,0],["وَتَرثي اِلَيهِ بِالوِصالِ وَتَعطِفي","فَقالَت نَعم ارثي اِلَيهِ وَاِنَّما",10,"م",2,0],["وترثيك ألسنةُ الشعراء","وتهفو إليك حُروفُ القصيدْ",11,"د",1,0]]}