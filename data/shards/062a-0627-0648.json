,""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5351,"ماذا هناك","https://www.poetsgate.com/ViewPoem.aspx?id=202284",""],[5431,"لقد تعب الجواد من الرُقادِ","https://www.poetsgate.com/ViewPoem.aspx?id=183034",""],[5736,"تأوه","https://www.poetsgate.com/ViewPoem.aspx?id=208446",""],[5956,"أ نَسِيتَ يا قيسٌ مُحِبك خالدا؟","https://www.poetsgate.com/ViewPoem.aspx?id=215382",""],[5957,"الرحيل الخالد","https://www.poetsgate.com/ViewPoem.aspx?id=179589",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""],[1907,"تأوبني داء دخيل فلم ان","http://www.aldiwanalarabi.com/poemDescription.do?poemId=605639",""],[6167,"بحرُ الكِذَاب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85575&r=&rc=58",""],[6198,"الأفق المحترق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79279&r=&rc=53",""],[4478,"لئن عانسُ قد شاب ما بين قرنها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59430&r=&rc=4",""]],"verses":[["تَأَوَّبَ مِن نَحوِ الأَحِبَّةِ طارِداً","رُقادي وَما أَسدى إِلَيَّ نَوالا",0,"ل",2,0],["تَأوي لَهُ قُلُصُ النَعامِ كَما أَوَت","حِزَقٌ يَمانِيَةٌ لِأَعجَمَ طِمطِمِ",1,"م",1,0],["تَأوي طَوائِفُها إِلى مُخضَرَّةٍ","مَكروهَةٍ يَخشى الكُماةُ نِزالَها",2,"ل",3,0],["تَأوي الظِباءُ إِلَيهِ وَهيَ أَوانِسٌ","وَتَحيدُ عَنهُ الأُسدُ وَهيَ ضَواري",3,"ر",2,0],["تَأَوَّبَني دائي القَديمُ فَغَلَّس","أُحاذِرُ أَن يَرتَدَّ دائي فَأُنكَسا",4,"س",2,0],["تأوّبني والليل يُذكي عيونه","ويسحب من ذيل الدُّجُنَّةِ ضافيا",5,"ي",2,0],["تأوّهت آهة حمراء داميةً","تشفّ عن كبِد بالهمَ مَجروح",6,"ح",1,0],["تَأوي إِلى الأَطنابِ كُلُّ رَذِيَّةٍ","مِثلُ البَلِيَّةِ قالِصٌ أَهدامُها",7,"م",3,0],["تَأَوَّبَني لَيلٌ بِيَثرِبَ أَعسَرُ","وَهَمٌّ إِذا ما نَوَّمَ الناسُ مُسهِرُ",8,"ر",1,1],["تأوَّب كالبدر في جنحه","وأين العواصم من سفحه",9,"ح",2,1],["تَأَوَّبَ زُغباً بِالفَلاةِ تَرَكنَها","بِأَغبَرَ مَجهولِ المَخارِمِ أَقتَما",10,"م",2,0],["تَأَوَّبَ جَنبَي مَنعِجٍ وَمَقيلُها","بِحَزمِ قِرَورى خِلفَةٌ وَوَشيجُ",11,"ج",1,0],["تَأوي إِلى بَيتِها دُهمٌ مُعَوَّدَةٌ","أَن لا تَرَوَّحَ إِن لَم تَغشَها الحِلَلُ",12,"ل",1,0],["تَأوي إِلَيها الروحُ مِن رَمضائِها","فَتُصيبُ ظِلّاً أَو تُصادِفُ ماءَ",13,"ا",2,0],["تَأوي الحَقيقَةُ مِنهُ وَالحُقوقُ إِلى","رُكنٍ بَناهُ مِنَ الأَخلاقِ بَنّاءُ",14,"ا",2,0],["تَأوي إِلَيها الأَيامى فَهيَ تَعزِيَةٌ","وَيَستَريحُ اليَتامى فَهيَ تَأساءُ",14,"ا",2,0],["تَأَوَّبَ مِن حَمّوصَ أَبوابَ بالِسٍ","مَسيراً بِفَرطِ الذُعرِ تُطوى مَراحِلُه",15,"ل",2,0],["تَأَوَّهَ مِن طولِ الكَلالِ وَتَشتَكي","تَأَوُّهَ مَفجوعٍ بِثُكلِ عَلى ثُكلِ",16,"ل",1,0],["تَأَوَّبَني ذِكرُ الأَحِبَّةِ بَعدَما","هَجَعتُ وَدوني قُلَّةُ الحَزنِ فَالرَملُ",17,"ل",1,0],["تَأوَّهَ منه شَيِّقُ الركبِ نائحاً","فَطَرّبَ فيه مُلْغِطُ الطّيْرِ ساجعا",18,"ع",2,0],["تَأَوَّبَني داءٌ مِنَ الهَمِّ لَم يَزَل","بِقَلبِيَ حَتّى عادَني مِنهُ عائِدي",19,"د",2,0],["تَأَوَّبَ عَينَهُ وَهناً قَذاها","وَداواها الطَبيبُ فَما شَفاها",20,"ا",3,1],["تَأَوَّلتُ فيهِ الذُلَّ قُلتُ تَواضُعٌ","وَحَسَّنتُ تَركَ الصَونِ سَمَّيتُهُ ظَرفا",21,"ف",2,0],["تَأَوَّبَني فيها عَلى غَيرِ مَوعِدٍ","أَخو قَفرَةٍ يَضحى بِها وَيَجوعُ",22,"ع",1,0],["تَأَوَّبني طَيفٌ بَعِيدُ التَأَوُّبِ","هُدُوّاً وَلَم يَشعُر بِذَلِكَ صاحِبي",23,"ب",2,1],["تأوّهَ إنْسِيٌّ منَ الخِدْرِ ناشِجٌ","فأسْعَدَ وَحْشيٌّ من السِّدْرِ باغم",24,"م",1,0],["تأوَّبَ مُرخَاةً عليه سُتُورُهُ","هُدُوءاً وقد نَامتْ عيونُ العَواذل",25,"ل",1,0],["تَأَوَّبَني بِعَمَّلَةَ اللَواتي","مَنَعنَ النَومَ إِذ هَدَأَت عُيونُ",26,"ن",1,0],["تَأوي إِلى ذي جُدَّتَينِ كَأَنَّهُ","كَرٌّ شَديدُ العَصبِ غَيرُ مَنينِ",27,"ن",1,0],["تأوه شيخ قاعد وعجوزه","حربين بالصفعاء ذات الأوساد",28,"د",1,0],["تَأَوَّبَنِي الدَّاءُ الَّذِي أَنَا حَاذِرُهْ","كَمَا اعْتَادَ مَكْمُوناً مِنَ الليْله عَائِرُهْ",29,"ر",2,1],["تَأَوَّبَ دَائِي مَنْ يَعِفُّ مُشَاشُهُ","عَن الجَارِ لاَ يَشْقَى بِهِ مَنْ يُعَاشِرُهْ",29,"ر",2,0],["تَأَوُّدَ مَظْلُومِ النَّقَا خَضِلَتْ بِهِ","أَهَالِيلُ يَوْمٍ مَاطِرٍ فَتَلَبَّدَا",30,"د",2,0],["تَأوَّبني بعارمَة الهُمومُ","كما يَعْتادُ ذا الدَّيْنَ الغريمُ",31,"م",1,1],["تَأَوَّبَ طَيْفٌ مِنْ سَمِيرَةَ زَائِرٌ","وَمَا الطَّيْفُ إِلَّا مَا تُريهِ الْخَوَاطِرُ",32,"ر",1,1],["تأوي الطيور إلى أظلتها","ويظل يلثم كفها الغصُن",33,"ن",1,0],["تأوي الأغاريد منه حين ترسله","إلى وريف نديّ الظلّ مدّاد",34,"د",1,0],["تَأَوَّبَ وَالظَلماءُ تَضرِبُ وَجهَهُ","إِلَينا بِأَذيالِ الرِياحِ الزَعازِعِ",35,"ع",1,0],["تَأَوَّبَني دائي القَديمُ فَغَلَّسا","أُحاذِرُ أَن يَرتَدَّ دائي فَأُنكَسا",36,"س",2,0],["تَاَوَّبَ مِنْ حَمُّصَ أَبْوابَ بالِسٍ","مَسِيراَ بِفَرطِ الذُّعْرِ تُطْوَى مَرَاحِلُهْ",37,"ل",2,0],["تأوِّدُ منك عقلاً في سكونٍ،","غصونُ خواطرٍ، متأوِّدات",38,"ت",1,0],["تأود هداك الله يا من يرومنا","بسوء ابحر الهند يجرع بالفكر",39,"ر",1,0],["تَأوَّبَهُ الخَيَالُ ولَيسَ يَألو","بُكًى صَبُّ تَأَوبُّهُ الخَيَالُ",40,"ل",1,1],["تَأَوَّلَ أَعداءُ المُلوكِ عَلَيهِمُ","فَوالَيتَ إِحساناً كَفاكَ التَأَوُّلا",41,"ل",2,0],["تأوي المعارف من نداه إلى","بعد المدى في الطول والعرض",42,"ض",1,0],["تأوي إلى حُفرةِ الكُدْريِّ آونةً","وتارةً تَرتقي في سُلّم الحِيَلِ",43,"ل",1,0],["تَأوَّبَنِي طَارِقُ الْهَمِّ نَصْبَا","وَأَبْدَلَ سِلْمَي للدَّهْرِ حَرْباً",44,"ب",2,1],["تَأَوَّبَني الهَمَّ وَاِعتادَني","كَما يَعتَري الوَصِبُ المُدنَفُ",45,"ف",1,0],["تأوَّبني منهنَّ سُهْدٌ وعَبْرَةٌ","فلا أدمعي تَرْقا ولا النومُ آيب",46,"ب",1,0],["تأوّل أقوام كلامي وأسرفوا","على وزرهم ذاك الكلام المؤول",47,"ل",1,0],["تأويلُ ما أنا مُهديه ومُرْسلُه","ودّي وشكريّ منظوماً ومنثورا",48,"ر",2,0],["تأوّلن أن لباس الحِداد","أحقُّ بمن صيَّر الحزن زادا",49,"د",2,0],["تَأوَّبَني فَأَرَّقَني خَيالٌ","سَرى لِلمالِكِيَّةِ بَعدَ وَهنِ",50,"ن",1,1],["تَأوي إِلَيكَ العُلَماءُ مِثلَ ما","تَأوي إِلى بَحرٍ طَما حيتانُهُ",51,"ن",2,0],["تأوَّبه من حب (لمياء) طائفٌ","فبات على حالٍ من الخبْلِ لا ترضي",52,"ض",2,0],["تأَوّدَ قدَّها وَحنا عليها","كدميةِ مرمرٍ حملت إطارا",53,"ر",2,0],["تأول إذ تأخر عنه خيري","فهل ألقاه يوما توسط",54,"ط",1,0],["تَأوي مَعَ المَلَأِ الأَعلى وَتَكرَعُ مِن","حِياضِ أَنسَ كَما تَجني مِنَ الثَمَرِ",55,"ر",1,0],["تأوي إِلى طودِ عزٍّ دون غايته","يرتدّ ناظرُ صرفِ الدهرِ من كللِ",56,"ل",1,0],["تأوبني والليل بيني وبينه","وميض بأطراف الثنايا تضرما",57,"م",2,0],["تأوب عيني طيف ألم","لظالمة طرقت في الظلم",58,"م",1,1],["تَأَوَّبَني هَمٌّ مَعَ اللَيلِ مُنصِبُ","وَجاءَ مِنَ الأَخبارِ ما لا أُكَذِّبُ",59,"ب",1,1],["تَأَوَّبنَ قَصراً مِن أَريكٍ وَوائِلٍ","وَماوانَ مِن كُلٍّ تَثوبُ وتَحلُبُ",59,"ب",1,0],["تأوَّبني ذِكْرُ الأحبّةِ طارقاً","وللَّيْلِ في الآفاقِ وَقْفةُ حَيْران",60,"ن",1,0],["تَأوّبَني خيالٌ من هُمومٍ","وإن كاثَرْنَ بالعددِ الرِّمالا",61,"ل",2,0],["تَأوَّبَني هَمٌّ كما خالَط الحَشا","من البيضِ مَطْرورُ الغِرارِ صَقيل",62,"ل",1,0],["تأوَّبني خيالٌ من هُمومٍ","وإن كاثَرْنَ في العَدَدِ الرِّمالا",63,"ل",2,0],["تأويل هذا الاقتصاص بأنه","مثل وليس يراد غير الأمثل",64,"ل",1,0],["تأوِي إليه معَ الظّلامِ همُومُه","وتَذودُهُ عن نَومهِ أَشجَانُهُ",65,"ن",2,0],["تَأَوَّهُ مِمّا مَسَّها مِن كَرِيهَةٍ","وتُصغِىِ الخُدُودَ وَالرِّمَاحُ تَصُورُها",66,"ر",3,0],["تأوي إليهم بنو الحاجات راغبة","والمنهل العذب بين النَّاس مورود",67,"د",1,0],["تأوي بنو الأغلب منهُ الى","مَنْ في حَنانيه لَعيّ العاثر",68,"ر",1,0],["تأويبُهم وسُراهمْ من عَزائمهمْ","أغْناهُمُ عنْ شَهيِّ الماءِ والزَّاد",69,"د",1,0],["تأوي الوزارة من جوا","نبها إلى وزر ممهَّد",70,"د",1,0],["تأوي لها قود المطيِّ رقة","حيَّا حيا دمعي المطيّ القودا",71,"د",2,0],["تأوى القلوبَ وشبَّت نار لوعتها","بهجرها فالسويداوات كالحممِ",72,"م",1,0],["تأوي العلى منهم إلى","بيضٍ وجوههمُ صباح",73,"ح",1,0],["تأوب من صدرٍ تخبُّ به الكرى","فما زال حتى بات منزله صدري",74,"ر",2,0],["تأوي لكوخ بلا رجل ولا بصر","ملتفة في اشتداد البرق بالخرق",75,"ق",1,0],["تأَوَّد فيا كم طاش قبلك عصبةٌ","بظلمٍ فما أبقى له الله باقيه",76,"ي",2,0],["تأوي أسنّتُه الصّدورَ كأنّما","خلطَ القُيون حديدَها بحُقودِ",77,"د",1,0],["تَأوني طيف الخَيالِ المؤرِق","هدوا فَهب الآلف المتشَوِّق",78,"ق",1,1],["تَأَوينَني هَمّي فَبِتُّ كَأَنَّني","عَلى مُستَقِلّاتِ النُجومِ رَقيبُ",79,"ب",1,0],["تأوَّينى همُّ كثيرٌ بلابلُه","طروقا فغَال النَّومَ عَنِّي غَوَائِلُه",80,"ل",2,1],["تأوبني الحن