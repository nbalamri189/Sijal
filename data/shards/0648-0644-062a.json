{"poems":[[57,"ماذا يخبر ضيف بيتك أهله","https://www.aldiwan.net/poem24714.html","الكامل"],[77,"خدع الشوق فؤادي فانخدع","https://www.aldiwan.net/poem35986.html","الرمل"],[77,"لا تعجبن لطالب نال العلا","https://www.aldiwan.net/poem36129.html","الخفيف"],[77,"مولاي ياذا الجلال الباهر العالي","https://www.aldiwan.net/poem36349.html","البسيط"],[77,"يا رسول الصبا فديتك بلغ","https://www.aldiwan.net/poem36566.html","الخفيف"],[77,"هذي ثمان قد قطعن الدجى","https://www.aldiwan.net/poem36662.html","السريع"],[9,"يا جارتي ما كنت جاره","https://www.aldiwan.net/poem21939.html","مجزوء الكامل"],[86,"حبس اللسان وأطلق الدمعا","https://www.aldiwan.net/poem10350.html","الكامل"],[86,"ولت بشاشة دنيانا ودنياك","https://www.aldiwan.net/poem10363.html","البسيط"],[86,"ما لي أرى الأكمام لا تفتح","https://www.aldiwan.net/poem10674.html","الرجز"],[73,"لو كان قولك مت ما كان ردي لا","https://www.aldiwan.net/poem11895.html","البسيط"],[73,"اخطب فملكك يفقد الإملاكا","https://www.aldiwan.net/poem11973.html","الكامل"],[10,"يا عين جودي بالدموع الغزار","https://www.aldiwan.net/poem21090.html","السريع"],[93,"وافى الحديث إلى غريب الدار","https://www.aldiwan.net/poem11068.html","الكامل"],[93,"يا مسهد القوم أطلت السنه","https://www.aldiwan.net/poem11117.html","السريع"],[93,"وارحمتاه لقوم فارقوا النعما","https://www.aldiwan.net/poem11304.html","البسيط"],[54,"علم وتحكيم وشيب مفارق","https://www.aldiwan.net/poem27519.html","الكامل"],[83,"يا من يحن إلى نجد وناديها","https://www.aldiwan.net/poem54234.html","البسيط"],[83,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[4,"راح القطين بهجر بعدما ابتكروا","https://www.aldiwan.net/poem21160.html","البسيط"],[23,"يا راكبا إما عرضت فبلغن","https://www.aldiwan.net/poem21451.html","الكامل"],[72,"قاسي الجوانح لين الأعطاف","https://www.aldiwan.net/poem19257.html","الكامل"],[72,"رمى حشاي ويا شوقي إلى الرامي","https://www.aldiwan.net/poem19676.html","البسيط"],[51,"ما مدمعي حذر النوى بقريح","https://www.aldiwan.net/poem9403.html","الكامل"],[51,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[51,"أنى تماطلني وأنت جواد","https://www.aldiwan.net/poem61868.html","الكامل"],[51,"يا ابن المدبر غرني الرواد","https://www.aldiwan.net/poem61893.html","الكامل"],[51,"يا أبا أحمد ومثلك لا يغفل","https://www.aldiwan.net/poem61894.html","الخفيف"],[51,"أبا علي طلبت عيبك ما اسطعت","https://www.aldiwan.net/poem65452.html","المنسرح"],[51,"يا من سكون النفس في تأميله","https://www.aldiwan.net/poem66004.html","الكامل"],[51,"أنا صب مستهام","https://www.aldiwan.net/poem66023.html","مجزوء الرمل"],[51,"ضحك الربيع إلى بكا الديم","https://www.aldiwan.net/poem66296.html","أحذ الكامل"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[51,"يا من قسا لما شكوت","https://www.aldiwan.net/poem66509.html","مجزوء الكامل"],[91,"سئمت نفسي الحياة مع الناس","https://www.aldiwan.net/poem8747.html","عموديه"],[91,"يا نفس هذا منزل الأحباب","https://www.aldiwan.net/poem8750.html","عموديه"],[91,"طوي العام كما يطوى الرقيم","https://www.aldiwan.net/poem8820.html","عموديه"],[91,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[91,"إن تر زهرة ورد فوقها للطل قطره","https://www.aldiwan.net/poem8876.html","عموديه"],[91,"نسي الكنار نشيده","https://www.aldiwan.net/poem8878.html","عموديه"],[38,"عاد الهموم وما يدري الخلي بها","https://www.aldiwan.net/poem7725.html","البسيط"],[92,"كان الربيع الحي روحا حالما","https://www.aldiwan.net/poem38969.html","الكامل"],[89,"إن فعل الرجال غير الكلام","https://www.aldiwan.net/poem44616.html","الخفيف"],[89,"أجد الحياة من الطبيعة تنبع","https://www.aldiwan.net/poem44867.html","الكامل"],[85,"عادت أغاني العرس رجع نواح","https://www.aldiwan.net/poem21008.html","الكامل"],[43,"ذي المعالي فليعلون من تعالى","https://www.aldiwan.net/poem9979.html","الخفيف"],[45,"بين الشقيقة فاللوى فالأجرع","https://www.aldiwan.net/poem64692.html","الكامل"],[28,"قال الملائكة الذين تخيروا","https://www.aldiwan.net/poem5254.html","الكامل"],[28,"أبلغ معاوية الذي بيمينه","https://www.aldiwan.net/poem5603.html","الكامل"],[61,"أؤنب الشوق فيهم وهو يضطرم","https://www.aldiwan.net/poem51449.html","البسيط"],[61,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[49,"لله عاقبة الأمور جميعا","https://www.aldiwan.net/poem62165.html","الكامل"],[49,"أبنيت دون الموت حصنا","https://www.aldiwan.net/poem63147.html","مجزوء الكامل"],[49,"يا نفس إن الحق ديني","https://www.aldiwan.net/poem63161.html","مجزوء الكامل"],[97,"من شاطئ لشواطئ جدد","https://www.aldiwan.net/poem24763.html","أحذ الكامل"],[80,"زارت على الخوف من رقيب","https://www.aldiwan.net/poem31574.html","مخلع البسيط"],[44,"أفدت ركاب أبي سعيد للنوى","https://www.aldiwan.net/poem30330.html","الكامل"],[44,"نثرت فريد مدامع لم ينظم","https://www.aldiwan.net/poem30353.html","الكامل"],[44,"أصغى إلى البين مغترا فلا جرما","https://www.aldiwan.net/poem30366.html","البسيط"],[81,"هي طلعة السعد الأغر فمرحبا","https://www.aldiwan.net/poem61549.html","الكامل"],[75,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[46,"إركع لربك في نهارك واسجد","https://www.aldiwan.net/poem22482.html","الكامل"],[46,"أما الزمان فأوقات مواصلة","https://www.aldiwan.net/poem22941.html","البسيط"],[46,"نفس الفتى وليست له جسدا","https://www.aldiwan.net/poem23148.html","الكامل"],[15,"ولتأتين بعدي قرون جمة","https://www.aldiwan.net/poem45271.html","الكامل"],[76,"كآبة الذل في كتابي","https://www.aldiwan.net/poem39485.html","مخلع البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39651","المنسرح"],[32,"","https://poetry.dctabudhabi.ae/diwan/poem/8240","الكامل"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39411","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42611","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54855","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54563","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55104","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54865","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55014","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54930","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54710","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54296","الخفيف"],[106,"حول الامتيازات","https://www.poetsgate.com/ViewPoem.aspx?id=179640",""],[106,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[75,"دونها سيف الله","https://www.poetsgate.com/ViewPoem.aspx?id=12775",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[38,"عادَ الهمومُ وما يدري الخليُّ بها","https://www.poetsgate.com/ViewPoem.aspx?id=21204",""],[99,"الى صديقة جديدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=347&r=&rc=53",""],[99,"إمرأة مِنْ دُخَان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68837&r=&rc=389",""]],"verses":[["وَلَتُخبِرَنَّ خَصاصَتي بِتَمَلُّقي","وَالماءُ يُخبِرُ عَن قَذاهُ زُجاجُهُ",0,"ج",2,0],["ولْتَصِفْ شَقْرونَ بالسّعْدِ وإن","قيلَ أيُّ السّعْدِ قُلْ سعْدُ بُلَعْ",1,"ع",1,0],["وَلْتَقُلْ إنْ أَتَتْكَ تَسْأَلُ عَنْ حَا","لِي تَعَوَّضْتُهَا بِحَالِكِ حَالَهْ",2,"ل",2,0],["وَلْتَجْتَنِبْ كُلَّ مَنْقُودٍ عَلَيْكَ لَهُمْ","يَسْلَمْ جَنَابُكَ مِنْ قِيلٍ وَمِنْ قاَلِي",3,"ي",1,0],["ولْتُشاهِدْ ذاكَ الجَمالَ بطَرْفي","ولْتَطَأْ ذالِكَ التُّرابَ بخَدّي",4,"ي",1,0],["ولتَقْرَأ النُّسْخَةَ واتْرُكْ الى","سِرِّ المَعاني خَطَّها المُدْمَجا",5,"ج",2,0],["وَلَتَصبَحَنَّكَ كَأسُ سُم","مٍ في عَواقِبِها مَرارَه",6,"ر",2,0],["وَلتَحمِلِ الأَيّامُ حَملَتَها","غاضَ المَعينُ وَأَجدَبَ المَرعى",7,"ع",2,0],["وَلَّت بَشاشَةُ دُنيانا وَدُنياكِ","وَفارَقَ الأُنسُ مَغنانا وَمَغناكِ",8,"ك",1,1],["وَلتَذكُرِ الأُمَّةِ ميثاقَها","أَلّا تَرى عِزَّتَها تُجرَحُ",9,"ح",1,0],["وَلَتَقضِ ما شِئتَ مِن هَجرٍ وَمِن صِلَةٍ","لا أَقضِ ما عِشتُ سُلواناً وَلا مَلَلا",10,"ل",2,0],["وَلِتَدعُني وَعَدُوَّكَ الشاني فَإِن","يَرُمِ القِراعَ يَجِد سِلاحِيَ شاكا",11,"ك",2,0],["وَلتَبكِهِ الخَيلُ إِذا غودِرَت","بِساحَةِ المَوتِ غَداةَ العِثار",12,"ر",1,0],["ولتقو حيلة عقلهم فتقلهم","كالفلك في بحر بعيد قرار",13,"ر",1,0],["وَلَتَكْسُ مَثْوَاكَ غَوَادِي الحَيَا","مِنْ كُلِّ نَاضِرٍ أَزْيَنَهْ",14,"ن",2,0],["وَلْتَحْيَ مِصْرُ فَمَا زَالَتْ كَمَا عُهِدَتْ","كَهْفاً لِقَاصِدِهَا غَوْثاً لِمَنْ أُزِمَا",15,"م",2,0],["وَلتَصلُحَن مِن بَعدِ ذاكَ لَزُلزُلٍ","وَلتَصلُحَن مِن بَعدِهِ لِلمارِقِ",16,"ق",1,0],["وَلْتَسْأَلِ السِّيَرَ المرفوعَ مسندُها","فعن مواقفهم تُرْوى مغازيها",17,"ي",3,0],["ولتُبعدِ الغارات في أرض العدا","واللهُ حسبُك ناصراً ووكيلا",18,"ل",2,0],["وَلَّت فَأَدرَكَها أولى سَوابِقِها","فَأَقبَلَت ما بِها رَوعٌ وَلا بَهَرُ",19,"ر",1,0],["وَلَتَعرِفُنَّ قَلائِدي بِرِقابِكُم","كَالوَشمِ لا تَبلى عَلى الحَدَثانِ",20,"ن",1,0],["ولتاركي في حبِّه وكأنَّما","إنسان عيني مُبتلى برعاف",21,"ف",1,0],["ولّت كأنيَ منها كنت في سنةٍ","ثمّ انبرت ليَ أيامٌ كأعوام",22,"م",1,0],["ولتخبرنَّك عن نضال مُطَمَّح","باليَثْربيَّة أيَّما تطميحِ",23,"ح",1,0],["وَلَتَدْبِيرُه أحَدُّ من السَّيْ","فِ وأمضى في بدئه وَعِوَادِهْ",24,"د",2,0],["ولتشهدن بأنني بك واثق","ولتشهدن بفضلك الأشهادُ",25,"د",1,0],["ولتخْزَيَنَّ بها إذا ما أنشدتْ","أضعافَ ما يُزْهَى بها الإنشادُ",26,"د",1,0],["ولْتجدْهُ نوائبُ العرف شهماً","ناهضاً بالثقيل منهنّ جلدا",27,"د",2,0],["ولتك أنفاسه تشاكل ذك","راك وحسبي بطيبها وكفى",28,"ف",2,0],["ولتبلغنَّ به الغنى لكنّه","لا بدّ قبلَ غناه من تعليلِهِ",29,"ل",2,0],["ولتُمتَّع بأبي إس","حاق ما غنَّى الحمامُ",30,"م",1,0],["ولتُذْعنننَّ لك الأمورُ به","حتى تُقادَ إليك بالرُمَمِ",31,"م",1,0],["ولتجريم أربعين قديماً","يتناهى الرضاعُ بابن المُدام",32,"م",1,0],["ولتغْذُوَنّي بالكرا","مةِ إنه قدْماً غَذاني",33,"ن",2,0],["وَلتُكَحِّل يَدُ المَساءِ جُفوني","وَلتُعانِق أَحلامُهُ أَهدابي",34,"ي",1,0],["وَلتَمسَحِ البُشرى دُموعَكِ مِثلَما","يَمحو الصَباحُ نَدىً عَنِ الأَعشابِ",35,"ب",1,0],["وَلتَعِش رايَتُها ذاتُ النُجوم","أَجمَلُ الراياتِ أَولى بِالخُلو",36,"و",1,0],["وَلَّت شُهورٌ كُنتُ أَر","جو أَن تُخَلَّدَ الدُهورِ",37,"ر",1,0],["وَلتَكُن عَينُكَ كَفّاً وَليَكُن لَمسُكَ نَظرَه","لَيسَتِ الحَمراءُ جَمرَه لا وَلا البَيضاءُ دَرَّه",38,"ر",2,0],["وَلتَرمِيَنَّ بِريشِهِ","لِلأَرضِ عاصِفَةُ النِفار",39,"ر",1,0],["وَلَّت حِثاثاً تُواليها وَأَتبَعَها","مِن لابَةٍ أَسفَعُ الخَدَّينِ مُختَضِعُ",40,"ع",1,0],["ولْتَشْهَدِ الدُّنيا التي غنَّيْتُها","حُلْمَ الشَّبابِ وروعةَ الإعجابِ",41,"ب",1,0],["ولتلك التطورات ظهور","في جنين يعيش في الأرحام",42,"م",1,0],["ولتلك مؤنستي ولست بعالم","أهي التي بي ام بها انا افجع",43,"ع",1,0],["وَلَّت سُيوفُهُما وَبانَ قَناهُما","وَشَبا يَراعي غَيرُ ذاتِ بَراحِ",44,"ح",1,0],["وَلتَشهَدُنَّ بِكُلِّ أَرضٍ فِتنَةً","فيها يُباعُ الدينُ بَيعَ سَماحِ",44,"ح",1,0],["وَلَتَمضِنَّ حَيثُ لا يَجِدُ الرُم","حُ مَداراً وَلا الحِصانُ مَجالا",45,"ل",2,0],["وَلتَهنِكَ الآنَ الوِلايَةُ إِنَّها","طَلَبَتكَ مِن بَلَدٍ بَعيدِ المَنزَعِ",46,"ع",1,0],["وَلَتَكفِيَنَّكَ فَقدَ زَوجَتِكَ الَّتي","هَلَكَت مُوَقَّعَةُ الظُهورِ قِصارُ",47,"ر",1,0],["وَلَتَعلَمَنَّ مَنِ الكَذوبُ إِذا اِلتَقى","عِندَ الإِمامِ كَلامُهُم وَكَلامي",48,"م",2,0],["وَلَّتْ وبِيضُ ابنِ عبدِ اللهِ تَنشُدُها","كالطَّيْرِ رَوَّعَها من بارقٍ ضَرَمُ",49,"م",1,0],["ولْتَسريَنَّ مع الجَنوبِ إليكما","مغموسةً في الشَّرْي أو في الصَّابِ",50,"ب",1,0],["ولْتَطْلْعَنَّ من الفِجاجِ كأنها","غُرَرُ الجيادِ لواحِقُ الأقرابِ",50,"ب",1,0],["وَلَتَفتَنَنَّ عَنِ الهُدى إِن لَم تَكُن","لِأَعِنَّةِ الدُنيا إِلَيهِ خَليعا",51,"ع",2,0],["وَلَتَنزِلَنَّ بِمَنزِلٍ","أَغلِق بِرَهنِكَ فيهِ رَهنا",52,"ن",2,0],["وَلَتُعوِلَنَّ المُعوِلا","تُ هُناكَ حَولي بِالرَنينِ",53,"ن",1,0],["وَلَتَجعَلَنّي بَعدَ خَل","قي طينَةً لَحِقَت بِطينِ",53,"ن",1,0],["ولتبق يا هذي البحيرة في","حاليك ثائرة وهادئة",54,"ه",1,0],["ولّتْ فَقُلْ في طلوع شمس","قد أخذت عنه في الغروبِ",55,"ب",1,0],["وَلَتَعلَمَنَّ بِأَنَّ ذِكرَكَ أَو تُرى","جَذلانَ مُنصَرِفاً نَديمُ لِساني",56,"ي",1,0],["وَلتَعلَمِ الأَيّامُ أَنّي فُتُّها","بِأَبي الحُسَينِ مُحَمَّدِ بنِ الهَيثَمِ",57,"م",1,0],["وَلَّت شَياطينُهُم عَن حَدِّ مَلحَمَةٍ","كانَت نُجومُ القَنا فيها لَهُم رُجُما",58,"م",2,0],["وَلتَفطِموهُ عَنِ اللَبانِ فَإِنَّهُ","لَيَرى دَمَ الأَبطالِ أَحلى مَشرَبا",59,"ب",2,0],["ولتُدرِكَنّ المَشْرَفِيَّةُ فيهِمُ","ما يَنْثَني عن دَركِهِ التّأميل",60,"ل",1,0],["وَلِتَحلَ عِرسُكَ بِالتُقى فَنِظامُهُ","أَسنى لَها مِن لُؤلُؤٍ وَزَبَرجَدِ",61,"د",1,0],["وَلِتَركَبِ الجِنحَ لا عَوداً وَلا فَرَساً","كَأَنَّما الشُهُبُ فيهِ الأَينَقُ الظُلُعُ",62,"ع",1,0],["وَلتَغدُ هَوناتُ المَناكِبِ أَمثا","لَ العَناكِبِ شَأنُها الغَزلُ",63,"ل",1,0],["وَلَتَأتِيَن بَعدي قُرونٌ جَمَّةٌ","تَرعى مَخارِمَ أَيكَةٍ وَلَدودا",64,"د",2,1],["وَلَّتْ حُمَيَّا الْشَّبابِ عَنِّي","فَلْهفَ نَفْسي على الشَّبابِ",65,"ب",1,0],["ولتعصفِ الريحُ فوق مائجه","ولينبجسْ من غمامه المطَرُ",66,"ر",1,0],["وَلَتَبكِيَنّي الباكِياتُ وَإِن أَبُح","يَوماً بِسِرِّكِ مُعلِناً لَم أُعذَرِ",67,"ر",1,0],["ولَّتْ ليالي الصِّبا مَحمودةً","لو أَنَّها رجعتْ تلكَ اللَّيالْ",68,"ل",1,0],["وَلَّتْ فَلَمْ يَبْقَ مِنْهَا غَيْرُ فَذْلَكَةٍ","تَلُوحُ فِي دَفْتَرِ الأَوْهَامِ وَالذُّكَرِ",69,"ر",1,0],["وَلْتهْنَإِ الدُّنْيَا بِنَسْلِكَ وَلَيَدُمْ","يُمْنُ التَّسلْسُلِ فِي شَرِيفِ العُنْصُرِ",70,"ر",1,0],["وَلَتُصْنَعَنَّ نَوَاسَفٌ تُثْفَى الرُّبَى","بِدُخَانِهَا مَنْثُورَةً تَتَلَهَّبُ",71,"ب",1,0],["وَلَتَنْفُذَنَّ إِلَى بَكِينَ خَلاَئِقٌ","بَيْضَاءُ تَغْنَمُ مَا تَشَاءُ وَتَنْهَبُ",71,"ب",1,0],["وَلْتَغدُوَنَّ عَتَادَكَ","الشِّيَمُ الَّتِي كَانَتْ حُلاَكْ",72,"ك",1,0],["وَلْتَشْهَدِ الأَوْطَانُ مَا حَسَنَاتُهُمْ","فِي المَنَصِبِ الْعَالِي وَفِي الإِثْرَاءِ",73,"ا",2,0],["وَلْتَعْلَمِ الأَيَّامُ مَا هُوَ شأْنُهُمْ","فِي كُلِّ مَوْقِفِ عِزَّةٍ وَإِبَاءِ",73,"ا",2,0],["وَلْتُنْبِيءِ الزِّيناتُ عَنْ بَهَجَاتِنا","وَلْترْوِ عَنْ مُهُجَاتِنا الأَزْهَارُ",74,"ر",1,0],["وَلْتَطِبْ رُوحُهُ إِذَا هِيَ حَيَّتْ","مِنْ سَمَاءِ الْخُلُودِ رَمْزُ الْخُلُودِ",75,"د",1,0],["وَلتَزْدَهِرْ أَيَّامُ صَاحِبِ عَهْدِهِ","فِي ظِلِّهِ كَالمَوْسِمِ المُتَتَابِعِ",76,"ع",1,0],["وَلْتَتَّصِلْ أَفْرَاحُكُمْ","تَتْلُو أَوَائِلُهَا الأَوَاخِرْ",77,"ر",1,0],["ولْتَجْهَرِ الأَصْوَارُ مُوقِعَةً","طَرَباً عَلَى رَنَّاتِ أَعْوَادِ",78,"د",1,0],["ولْتعِشْ قُرَّةُ البَصائِرِ فِرْياَ","لُ حياةُ النُّفوسِ والأرْوَاح",79,"ح",1,0],["ولتُجمعوا عند الشدائد أمركم","فالخيرُ كلُّ الخير في إجماعِهِ",80,"ع",2,0],["ولتُظْهروا وثباتِكم وثباتَكم","ليس الجبانُ القلب مثلَ شجاعِهِ",80,"ع",2,0],["ولتُنْقذَنَّ تُراثَنَا","من قبضة الشَّعب اللعين",81,"ن",1,0],["ولتدركن المشرفية فيهم ... ماينثنى عن دركه التأميل","نامت ملوك فى الحشايا وانثنت ... كسلى وطرفك بالسهاد كحيل",82,"ل",1,0],["ولَتلك مَدعاة سيُنصَرُ عندها","عارُ النُكوص ويُخذَلُ الإِقدام",83,"م",1,0],["ولّتْ حثاثاً توالها وأتبعها","مِنْ لاَبَة ٍ أسْفَعُ الخَدَّيْنِ مُخْتَضِعُ",84,"ع",1,0],["ولتْثقي مهما يكنْ بحُبِّي","فإنَّه أكبر ُ من كبيرِ",85,"ر",1,0],["ولْتَعيشي تَخَيُّلاً في جبيني","ولْتكوني خُرافةً لا تكونُ",86,"ن",1,0]]}