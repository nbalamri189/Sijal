.net/poem56139.html","المنسرح"],[456,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[459,"جرد سيوفك للجلاد وأشهر","https://www.aldiwan.net/poem15128.html","الكامل"],[459,"نبأ عاد له الصبح دجى","https://www.aldiwan.net/poem16016.html","الرمل"],[462,"قوامك اللدن لا ما يزعم الغصن","https://www.aldiwan.net/poem3196.html","عموديه"],[462,"رفقاً بها يا سائق الأظعان","https://www.aldiwan.net/poem3197.html","عموديه"],[462,"قف بالمنازل أو كناس ظبائها","https://www.aldiwan.net/poem3275.html","عموديه"],[477,"هب لي بيانك في ممدوحك الهادي","https://www.aldiwan.net/poem36957.html","البسيط"],[477,"كل يهرول نحوها وييمم","https://www.aldiwan.net/poem37573.html","الكامل"],[484,"يشتاق قلبي إلى مليكة","https://www.aldiwan.net/poem455.html",""],[493,"حديقة الجو غضي هذه الحدقا","https://www.aldiwan.net/poem10251.html","البسيط"],[496,"أيها المغتر بالزمن","https://www.aldiwan.net/poem3701.html","المديد"],[503,"تائية القافلة","https://www.aldiwan.net/poem27889.html","البسيط"],[503,"التّرِكة","https://www.aldiwan.net/poem42458.html","الرمل"],[513,"قل لمن يرتجي طنين الرباب","https://www.aldiwan.net/poem12023.html","الخفيف"],[513,"سارت حشاشة مهجتي إذ ساروا","https://www.aldiwan.net/poem12127.html","الكامل"],[536,"أى سهم راشه الدهر إلى","https://www.aldiwan.net/poem47499.html","عموديه"],[536,"مقدم القائد الأعز نظيرا","https://www.aldiwan.net/poem48180.html","عموديه"],[536,"نظرت بلحظ بالقلوب لعوب","https://www.aldiwan.net/poem48277.html","عموديه"],[536,"طال مني لذا النهار ارتقابي","https://www.aldiwan.net/poem48296.html","عموديه"],[549,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[549,"قدني إليك فقد أمنت شماسي","https://www.aldiwan.net/poem47745.html","الكامل"],[551,"قد اطلعت على سري وإعلاني","https://www.aldiwan.net/poem68419.html","البسيط"],[556,"جسد في هوى المليح عليل","https://www.aldiwan.net/poem34252.html","الخفيف"],[556,"أيها الطالب النجاة أتاكا","https://www.aldiwan.net/poem34266.html","الخفيف"],[556,"اغسلوا بي نجاسة الوسواس","https://www.aldiwan.net/poem34440.html","الخفيف"],[560,"جاد الزمان بنعمة متصدقا","https://www.aldiwan.net/poem52797.html","الكامل"],[571,"بشراي دالت دولة المعصوم","https://www.aldiwan.net/poem3641.html","الكامل"],[573,"سافر فوجه العيد سافر","https://www.aldiwan.net/poem3070.html","مجزوء الكامل"],[573,"فرقت بين بنانها وخضابها","https://www.aldiwan.net/poem3101.html","الكامل"],[584,"جادت عليك من السحاب سواري","https://www.aldiwan.net/poem17533.html","الكامل"]],"verses":[["وَلَتُخبِرَنَّ خَصاصَتي بِتَمَلُّقي","وَالماءُ يُخبِرُ عَن قَذاهُ زُجاجُهُ",0,"ج",2,0],["ولْتَصِفْ شَقْرونَ بالسّعْدِ وإن","قيلَ أيُّ السّعْدِ قُلْ سعْدُ بُلَعْ",1,"ع",1,0],["وَلْتَقُلْ إنْ أَتَتْكَ تَسْأَلُ عَنْ حَا","لِي تَعَوَّضْتُهَا بِحَالِكِ حَالَهْ",2,"ل",2,0],["وَلْتَجْتَنِبْ كُلَّ مَنْقُودٍ عَلَيْكَ لَهُمْ","يَسْلَمْ جَنَابُكَ مِنْ قِيلٍ وَمِنْ قاَلِي",3,"ي",1,0],["ولْتُشاهِدْ ذاكَ الجَمالَ بطَرْفي","ولْتَطَأْ ذالِكَ التُّرابَ بخَدّي",4,"ي",1,0],["ولتَقْرَأ النُّسْخَةَ واتْرُكْ الى","سِرِّ المَعاني خَطَّها المُدْمَجا",5,"ج",2,0],["وَلَتَصبَحَنَّكَ كَأسُ سُم","مٍ في عَواقِبِها مَرارَه",6,"ر",2,0],["وَلتَحمِلِ الأَيّامُ حَملَتَها","غاضَ المَعينُ وَأَجدَبَ المَرعى",7,"ع",2,0],["وَلَّت بَشاشَةُ دُنيانا وَدُنياكِ","وَفارَقَ الأُنسُ مَغنانا وَمَغناكِ",8,"ك",1,1],["وَلتَذكُرِ الأُمَّةِ ميثاقَها","أَلّا تَرى عِزَّتَها تُجرَحُ",9,"ح",1,0],["وَلَتَقضِ ما شِئتَ مِن هَجرٍ وَمِن صِلَةٍ","لا أَقضِ ما عِشتُ سُلواناً وَلا مَلَلا",10,"ل",2,0],["وَلِتَدعُني وَعَدُوَّكَ الشاني فَإِن","يَرُمِ القِراعَ يَجِد سِلاحِيَ شاكا",11,"ك",2,0],["وَلتَبكِهِ الخَيلُ إِذا غودِرَت","بِساحَةِ المَوتِ غَداةَ العِثار",12,"ر",1,0],["ولتقو حيلة عقلهم فتقلهم","كالفلك في بحر بعيد قرار",13,"ر",1,0],["وَلَتَكْسُ مَثْوَاكَ غَوَادِي الحَيَا","مِنْ كُلِّ نَاضِرٍ أَزْيَنَهْ",14,"ن",2,0],["وَلْتَحْيَ مِصْرُ فَمَا زَالَتْ كَمَا عُهِدَتْ","كَهْفاً لِقَاصِدِهَا غَوْثاً لِمَنْ أُزِمَا",15,"م",2,0],["وَلتَصلُحَن مِن بَعدِ ذاكَ لَزُلزُلٍ","وَلتَصلُحَن مِن بَعدِهِ لِلمارِقِ",16,"ق",1,0],["وَلْتَسْأَلِ السِّيَرَ المرفوعَ مسندُها","فعن مواقفهم تُرْوى مغازيها",17,"ي",3,0],["ولتُبعدِ الغارات في أرض العدا","واللهُ حسبُك ناصراً ووكيلا",18,"ل",2,0],["وَلَّت فَأَدرَكَها أولى سَوابِقِها","فَأَقبَلَت ما بِها رَوعٌ وَلا بَهَرُ",19,"ر",1,0],["وَلَتَعرِفُنَّ قَلائِدي بِرِقابِكُم","كَالوَشمِ لا تَبلى عَلى الحَدَثانِ",20,"ن",1,0],["ولتاركي في حبِّه وكأنَّما","إنسان عيني مُبتلى برعاف",21,"ف",1,0],["ولّت كأنيَ منها كنت في سنةٍ","ثمّ انبرت ليَ أيامٌ كأعوام",22,"م",1,0],["ولتخبرنَّك عن نضال مُطَمَّح","باليَثْربيَّة أيَّما تطميحِ",23,"ح",1,0],["وَلَتَدْبِيرُه أحَدُّ من السَّيْ","فِ وأمضى في بدئه وَعِوَادِهْ",24,"د",2,0],["ولتشهدن بأنني بك واثق","ولتشهدن بفضلك الأشهادُ",25,"د",1,0],["ولتخْزَيَنَّ بها إذا ما أنشدتْ","أضعافَ ما يُزْهَى بها الإنشادُ",26,"د",1,0],["ولْتجدْهُ نوائبُ العرف شهماً","ناهضاً بالثقيل منهنّ جلدا",27,"د",2,0],["ولتك أنفاسه تشاكل ذك","راك وحسبي بطيبها وكفى",28,"ف",2,0],["ولتبلغنَّ به الغنى لكنّه","لا بدّ قبلَ غناه من تعليلِهِ",29,"ل",2,0],["ولتُمتَّع بأبي إس","حاق ما غنَّى الحمامُ",30,"م",1,0],["ولتُذْعنننَّ لك الأمورُ به","حتى تُقادَ إليك بالرُمَمِ",31,"م",1,0],["ولتجريم أربعين قديماً","يتناهى الرضاعُ بابن المُدام",32,"م",1,0],["ولتغْذُوَنّي بالكرا","مةِ إنه قدْماً غَذاني",33,"ن",2,0],["وَلتُكَحِّل يَدُ المَساءِ جُفوني","وَلتُعانِق أَحلامُهُ أَهدابي",34,"ي",1,0],["وَلتَمسَحِ البُشرى دُموعَكِ مِثلَما","يَمحو الصَباحُ نَدىً عَنِ الأَعشابِ",35,"ب",1,0],["وَلتَعِش رايَتُها ذاتُ النُجوم","أَجمَلُ الراياتِ أَولى بِالخُلو",36,"و",1,0],["وَلَّت شُهورٌ كُنتُ أَر","جو أَن تُخَلَّدَ الدُهورِ",37,"ر",1,0],["وَلتَكُن عَينُكَ كَفّاً وَليَكُن لَمسُكَ نَظرَه","لَيسَتِ الحَمراءُ جَمرَه لا وَلا البَيضاءُ دَرَّه",38,"ر",2,0],["وَلتَرمِيَنَّ بِريشِهِ","لِلأَرضِ عاصِفَةُ النِفار",39,"ر",1,0],["وَلَّت حِثاثاً تُواليها وَأَتبَعَها","مِن لابَةٍ أَسفَعُ الخَدَّينِ مُختَضِعُ",40,"ع",1,0],["ولْتَشْهَدِ الدُّنيا التي غنَّيْتُها","حُلْمَ الشَّبابِ وروعةَ الإعجابِ",41,"ب",1,0],["ولتلك التطورات ظهور","في جنين يعيش في الأرحام",42,"م",1,0],["ولتلك مؤنستي ولست بعالم","أهي التي بي ام بها انا افجع",43,"ع",1,0],["وَلَّت سُيوفُهُما وَبانَ قَناهُما","وَشَبا يَراعي غَيرُ ذاتِ بَراحِ",44,"ح",1,0],["وَلتَشهَدُنَّ بِكُلِّ أَرضٍ فِتنَةً","فيها يُباعُ الدينُ بَيعَ سَماحِ",44,"ح",1,0],["وَلَتَمضِنَّ حَيثُ لا يَجِدُ الرُم","حُ مَداراً وَلا الحِصانُ مَجالا",45,"ل",2,0],["وَلتَهنِكَ الآنَ الوِلايَةُ إِنَّها","طَلَبَتكَ مِن بَلَدٍ بَعيدِ المَنزَعِ",46,"ع",1,0],["وَلَتَكفِيَنَّكَ فَقدَ زَوجَتِكَ الَّتي","هَلَكَت مُوَقَّعَةُ الظُهورِ قِصارُ",47,"ر",1,0],["وَلَتَعلَمَنَّ مَنِ الكَذوبُ إِذا اِلتَقى","عِندَ الإِمامِ كَلامُهُم وَكَلامي",48,"م",2,0],["وَلَّتْ وبِيضُ ابنِ عبدِ اللهِ تَنشُدُها","كالطَّيْرِ رَوَّعَها من بارقٍ ضَرَمُ",49,"م",1,0],["ولْتَسريَنَّ مع الجَنوبِ إليكما","مغموسةً في الشَّرْي أو في الصَّابِ",50,"ب",1,0],["ولْتَطْلْعَنَّ من الفِجاجِ كأنها","غُرَرُ الجيادِ لواحِقُ الأقرابِ",50,"ب",1,0],["وَلَتَفتَنَنَّ عَنِ الهُدى إِن لَم تَكُن","لِأَعِنَّةِ الدُنيا إِلَيهِ خَليعا",51,"ع",2,0],["وَلَتَنزِلَنَّ بِمَنزِلٍ","أَغلِق بِرَهنِكَ فيهِ رَهنا",52,"ن",2,0],["وَلَتُعوِلَنَّ المُعوِلا","تُ هُناكَ حَولي بِالرَنينِ",53,"ن",1,0],["وَلَتَجعَلَنّي بَعدَ خَل","قي طينَةً لَحِقَت بِطينِ",53,"ن",1,0],["ولتبق يا هذي البحيرة في","حاليك ثائرة وهادئة",54,"ه",1,0],["ولّتْ فَقُلْ في طلوع شمس","قد أخذت عنه في الغروبِ",55,"ب",1,0],["وَلَتَعلَمَنَّ بِأَنَّ ذِكرَكَ أَو تُرى","جَذلانَ مُنصَرِفاً نَديمُ لِساني",56,"ي",1,0],["وَلتَعلَمِ الأَيّامُ أَنّي فُتُّها","بِأَبي الحُسَينِ مُحَمَّدِ بنِ الهَيثَمِ",57,"م",1,0],["وَلَّت شَياطينُهُم عَن حَدِّ مَلحَمَةٍ","كانَت نُجومُ القَنا فيها لَهُم رُجُما",58,"م",2,0],["وَلتَفطِموهُ عَنِ اللَبانِ فَإِنَّهُ","لَيَرى دَمَ الأَبطالِ أَحلى مَشرَبا",59,"ب",2,0],["ولتُدرِكَنّ المَشْرَفِيَّةُ فيهِمُ","ما يَنْثَني عن دَركِهِ التّأميل",60,"ل",1,0],["وَلِتَحلَ عِرسُكَ بِالتُقى فَنِظامُهُ","أَسنى لَها مِن لُؤلُؤٍ وَزَبَرجَدِ",61,"د",1,0],["وَلِتَركَبِ الجِنحَ لا عَوداً وَلا فَرَساً","كَأَنَّما الشُهُبُ فيهِ الأَينَقُ الظُلُعُ",62,"ع",1,0],["وَلتَغدُ هَوناتُ المَناكِبِ أَمثا","لَ العَناكِبِ شَأنُها الغَزلُ",63,"ل",1,0],["وَلَتَأتِيَن بَعدي قُرونٌ جَمَّةٌ","تَرعى مَخارِمَ أَيكَةٍ وَلَدودا",64,"د",2,1],["وَلَّتْ حُمَيَّا الْشَّبابِ عَنِّي","فَلْهفَ نَفْسي على الشَّبابِ",65,"ب",1,0],["ولتعصفِ الريحُ فوق مائجه","ولينبجسْ من غمامه المطَرُ",66,"ر",1,0],["وَلَتَبكِيَنّي الباكِياتُ وَإِن أَبُح","يَوماً بِسِرِّكِ مُعلِناً لَم أُعذَرِ",67,"ر",1,0],["ولَّتْ ليالي الصِّبا مَحمودةً","لو أَنَّها رجعتْ تلكَ اللَّيالْ",68,"ل",1,0],["وَلَّتْ فَلَمْ يَبْقَ مِنْهَا غَيْرُ فَذْلَكَةٍ","تَلُوحُ فِي دَفْتَرِ الأَوْهَامِ وَالذُّكَرِ",69,"ر",1,0],["وَلْتهْنَإِ الدُّنْيَا بِنَسْلِكَ وَلَيَدُمْ","يُمْنُ التَّسلْسُلِ فِي شَرِيفِ العُنْصُرِ",70,"ر",1,0],["وَلَتُصْنَعَنَّ نَوَاسَفٌ تُثْفَى الرُّبَى","بِدُخَانِهَا مَنْثُورَةً تَتَلَهَّبُ",71,"ب",1,0],["وَلَتَنْفُذَنَّ إِلَى بَكِينَ خَلاَئِقٌ","بَيْضَاءُ تَغْنَمُ مَا تَشَاءُ وَتَنْهَبُ",71,"ب",1,0],["وَلْتَغدُوَنَّ عَتَادَكَ","الشِّيَمُ الَّتِي كَانَتْ حُلاَكْ",72,"ك",1,0],["وَلْتَشْهَدِ الأَوْطَانُ مَا حَسَنَاتُهُمْ","فِي المَنَصِبِ الْعَالِي وَفِي الإِثْرَاءِ",73,"ا",2,0],["وَلْتَعْلَمِ الأَيَّامُ مَا هُوَ شأْنُهُمْ","فِي كُلِّ مَوْقِفِ عِزَّةٍ وَإِبَاءِ",73,"ا",2,0],["وَلْتُنْبِيءِ الزِّيناتُ عَنْ بَهَجَاتِنا","وَلْترْوِ عَنْ مُهُجَاتِنا الأَزْهَارُ",74,"ر",1,0],["وَلْتَطِبْ رُوحُهُ إِذَا هِيَ حَيَّتْ","مِنْ سَمَاءِ الْخُلُودِ رَمْزُ الْخُلُودِ",75,"د",1,0],["وَلتَزْدَهِرْ أَيَّامُ صَاحِبِ عَهْدِهِ","فِي ظِلِّهِ كَالمَوْسِمِ المُتَتَابِعِ",76,"ع",1,0],["وَلْتَتَّصِلْ أَفْرَاحُكُمْ","تَتْلُو أَوَائِلُهَا الأَوَاخِرْ",77,"ر",1,0],["ولْتَجْهَرِ الأَصْوَارُ مُوقِعَةً","طَرَباً عَلَى رَنَّاتِ أَعْوَادِ",78,"د",1,0],["ولْتعِشْ قُرَّةُ البَصائِرِ فِرْياَ","لُ حياةُ النُّفوسِ والأرْوَاح",79,"ح",1,0],["ولتُجمعوا عند الشدائد أمركم","فالخيرُ كلُّ الخير في إجماعِهِ",80,"ع",2,0],["ولتُظْهروا وثباتِكم وثباتَكم","ليس الجبانُ القلب مثلَ شجاعِهِ",80,"ع",2,0],["ولتُنْقذَنَّ تُراثَنَا","من قبضة الشَّعب اللعين",81,"ن",1,0],["ولتدركن المشرفية فيهم ... ماينثنى عن دركه التأميل","نامت ملوك فى الحشايا وانثنت ... كسلى وطرفك بالسهاد كحيل",82,"ل",1,0],["ولَتلك مَدعاة سيُنصَرُ عندها","عارُ النُكوص ويُخذَلُ الإِقدام",83,"م",1,0],["ولّتْ حثاثاً توالها وأتبعها","مِنْ لاَبَة ٍ أسْفَعُ الخَدَّيْنِ مُخْتَضِعُ",84,"ع",1,0],["ولتْثقي مهما يكنْ بحُبِّي","فإنَّه أكبر ُ من كبيرِ",85,"ر",1,0],["ولْتَعيشي تَخَيُّلاً في جبيني","ولْتكوني خُرافةً لا تكونُ",86,"ن",1,0],["وَلتَسآليَ الرُبوع وَلوعاً","بِالأَماني مِن غَير رَد جَواب",87,"ب",1,0],["ولتلك الذوائب السود منها","كم قلوب وحقها ذائبات",88,"ت",1,0],["ولَتَنْدَمَنَّ ندامةَ ما فوقها","أو مثلُها الكُسَعِيُّ أو حَوَّاءُ",89,"ا",2,0],["ولْتَسْخُوَنَّ بما مَلَكْتَ فإنه","فَانٍ ويبْقَى فيكَ حُسنُ ثَنائي",90,"ا",2,0],["ولتَسقِهَا مِن حَوضِ نِبرَاسِ الهُدَى","بَدرِ الدُّجَى قُطبِ الوُجُودِ العَالِى",91,"ل",2,0],["وَلتَخصُصَنَّ إِذَا مَا جِئتَ نَادِيَهُم","مُحَمداً فَالاً النَّدبَ الذي عُرِفا",92,"ف",2,0],["ولتَجعَلُوا مَعكُمُ إني مَعِيَّتُكُم","بالذَّاتِ والنَّصرِ في بَدوٍ وفي حَضَرِ",93,"ر",1,0],["ولتنشد الأفراح في تاريخهِ","بالبشر والتوفيق هلّ أمينُ",94,"ن",1,0],["ولتْذوُبي تحسراً يا عظامي","فالرازيا أضحت لديّ عظاما",95,"م",2,0],["ولتَعَلَمنَّ البيدُ أنَّ جِباهَها","موسومةٌ بالنَّصِّ والوخَدانِ",96,"ن",1,0],["وَلتَجتَنِب بَطشَ أَلوى حَدُّ سَطوَتِهِ","أَلوى بِمَن رَدَّها مَنكوسَةَ الصُلُبِ",97,"ب",1,0],["وَلِتَسأَلِ الخَيلُ الَّتي خيدَت ضُحىً","بِالطَعنِ عَن سَعَةِ المَكَرِّ وَضيقِهِ",98,"ق",2,0],["وَلتُمهِلَنَّ اللَيالي حاسِديكَ فَقَد","سَقَتهُمُ المُهلَ وَالغِسلينَ في مَهَلِ",99,"ل",1,0],["وَلتَدرِ أَملاكُ البِلادِ بِأَنَّها","كُلٌّ عَلى مَلِكٍ يَحُلُّ الشاما",100,"م",2,0],["وَلتَعلُ دَولَتُهُ بِأَنَّكَ مَجدُها","وَليَعتَصِم بِأَنِ اِنتَضاكَ حُساما",101,"م",2,0],["ولتعطنا من زكاة العلم واجبة","أنت المشيد دار العلم بانيها",102,"ي",3,0],["ولتَسِر ولتَؤُوب مَرقَى","تسمع الخير دائباً وتراه",103,"ا",2,0],["ولتاخذنّض بعون ربكَّ كل ذى","بغيٍ طغى أخذ العزيزِ المقتدرْ",104,"ر",1,0],["ولتَبقَ دَوحةُ عزِّهِ مُلتفّةً","في خُضرِ أوراقٍ ومُلدِ غُصونِ",105,"ن",1,0],["ولتخْفِضِي الجَفنَ مراتٍ لِتَغْمِزَني","عينٌ سبَتني بلحظٍ زادَ من أرقي",106,"ي",1,0],["ولْتهْمسي نغماتٍ كَيْ يُرتِّلَها","قلبي الذي قد هوى من رعْشةِ الخفَقِ",106,"ق",1,0],["وَلَّت عَلى عَجَلٍ وَأَبقَت بَعدَها","حُرَقاً تؤجِّجُها الدُموعُ الساجِمةْ",107,"م",2,0],["وَلَّت وَبالتأريخِ وَلَّى مُسرِعاً","كَالشَمسِ قَد أَفلَ الهِلالُ بِإِثرِها",108,"ر",3,0],["وَلّت وَقَد تَرَكَت لَنا مِن بَعدِها","ذِكراً جَميلاً بِالمَراحِمِ رُدَّدا",109,"د",2,0],["وَلتَهنِكَ الرُتبةُ الأُولَى حَباكَ بِها","مِن جودِ كَفّيهِ في الآفاقِ مِدرارُ",110,"ر",1,0],["وَلتَسألُوا الرَكبَ اليَمانِيّ الأَلى","ظَعَنُوا بِميَّة أَينَ مِنها المَوعِدُ",111,"د",1,0],["ولتدفنوه في الجوانحِ والحشا","إن كان يُرضيه هناك مَقام",112,"م",1,0],["ولتحذرِ الرشقَ من سهمٍ عرضتَ له","منْ يزحمِ البحرَ لا يأمنْ مِنَ الغرق",113,"ق",1,0],["ولترعَ فيَّ وسيلةَ القبر الذي","أفعالُ ساكنِ قَعْرِهِ لم تُقْبر",114,"ر",1,0],["ولتوسعنّي عذرَ تقصيرٍ فما","بَرِحَتْ خلالُكَ عارَ كلِّ مقصّر",114,"ر",1,0],["ولترقَ في فَلَكِ السماءِ بحيثُ لا","يسطيع أَنْ يَرْقَى شهابٌ نيِّر",115,"ر",1,0],["ولتبكِ من جزعٍ فإنَّ بكاءَنا","لمصارعِ الأحلام والأحساب",116,"ب",1,0],["ولّت تَسحُّ دموعاً من محاجِرِها","كجودِ بدرِ العُلا للخلق مطراح",117,"ح",1,0],["ولتحذفن الواو من نحو العده","وقل وجهة له من أورده",118,"ه",1,0],["وَلتَكُن خَيمَةً لَنا تُك","رَمُ الأَحلامُ فيها وَلِلهَوى مِحرابا",119,"ب",2,0],["وَلتَكُن بَينَنا مِن الحُبِّ ميثا","قاً يَكونُ الوَفا لَهُ آدابا",119,"ب",2,0],["وَلتَكُن هذِهِ الإِشارَة رَمزاً","لِاِصفِرارٍ عَلى المَلَذّات مرّا",120,"ر",2,0],["ولتك من رب السماء صلاته","وأتاك منه على المدى تسلميه",121,"م",3,0],["ولّت على عجل فكم قلب سها","بوداع جيرتها وكم عين جرت",122,"ت",1,0],["وَلَّت فَما لي طالِباً","أَثَراً لَها مِن بَعدِ عَينِ",123,"ن",1,0],["وَلَتَحكُمُنَّ عَلى أَقاصي الرومِ عَن","كَثَبٍ فَتُنفَذُ بِالظُبى أَحكامُها",124,"م",3,0],["وَلَتَشكُرَنَّكَ أُمَّةٌ أَولَيتَها","نَعماءَ ما خَطَرَت بِها أَوهامُها",124,"م",3,0],["وَلَّت تُشيرُ بِأَطرافٍ مُخَضَّبَةٍ","يَظُنُّ مَن فَتَنَتهُ أَنَّها عَنَمُ",125,"م",1,0],["وَلَّت سَحابَةُ ذاكَ الشَرِّ مُقلِعَةً","عَنّا وَعادَ رَماداً ذَلِكَ الشَرَرُ",126,"ر",1,0],["وَلْتَقُلْ سَيِّدِي عَرَتْنِي هُمومٌ","أَحْرَقَتْنِي من أَجْلِهَا الضََّّراءُ",127,"ا",2,0],["وَلْتُطْفِ مِنْ نَارِ الصُّدُودِ فَقَدْ","أَفْنَى أُوَارُ لَهِيبِهَا قَلْبِي",128,"ب",2,0],["وَلْتُجِرْنِي مِنَ الشِّفَاءِ فَذَنْبِي","قَدْ رَمَانيِ مِنْ ذَاكَ في الدَّرَكَاتِ",129,"ت",1,0],["وَلْتُحِطْنِي مِنَ الْخَنَى وَبَنِيهِ","بِالذِي حُزْتَهُ منَ الْبَرَكاتِ",129,"ت",1,0],["وَلْتُفِدْنَا مِنَ الْمَوَاهِبِ مَا بَغْ","لِبُ فَيْضُ زُلاَلِهِ الْقَامُوسَا",130,"س",2,0],["ولْتَكُنْ في العشقِ نهراً","دافقاً، يجري، يغنّي",131,"ن",2,0],["وَلْتَزْرَعِ الخَيْرَ تَحْصِدْ غِبْطَةً أَبَداً","فإِنَّما يَحْصِدُ الإنْسَانُ مَا زَرَعا",132,"ع",2,0],["وَلْتَبْتَنِ الْعَلْياءُ شُمَّ قِبابِها","بِذُرى رُباهُ أَوْ سُفُوحِ مُتُونِهِ",133,"ن",2,0],["وَلْتَخْلَعِ الأَفْكارُ عُذْرَ جَماحِها","بِنَظامِ أَبْكارِ الْقَرِيضِ وَعُونِهِ",133,"ن",2,0],["ولتصفح الصفح الجميل إذا أتت","وبصفحها خَجل عليه تراه",134,"ا",2,0],["وَلِتِلكَ الدُموعُ كانَت نَجيعاً","قَصَرَتهُ حَرارَةُ الأَحشاءِ",135,"ا",2,0],["وَلَّت لُيَيلاتٌ وَأَيّامٌ مَضَت","نِعمَ اللَيالي كُنَّ وَالأَيّامُ",136,"م",1,0],["وَلَّت لَيالي الوَصلِ محمودَةً","بِها فَيا لَهفي لَها مِن لَيال",137,"ل",1,0],["وَلَّت فَمَن لي بَعدها أَن أَرى","أَينَ أَمَدَّ اليَومَ طَيفُ الخَيال",137,"ل",1,0],["وَلَّت لذاذاتُ عَيشي وَالشَبابُ وَهَل","مَعَ المَشيبِ تُرى اللذّاتُ لذّاتُ",138,"ت",1,0],["وَلَّت لَيالينا حميداتٍ فَكَم","طَوَت مِنَ اللَذاتِ عَنّا وَالأَرَب",139,"ب",1,0],["ولتمدد الأيدي لها","حتى يتيح لها الطلب",140,"ب",1,0],["ولتهن مدرسة الكمال بحزبها","ورئيسها الشهم الغيور الباسل",141,"ل",1,0],["ولتجديف آنف العهد وتأكي","د محكم العقد والوفا بالذمام",142,"م",1,0],["وَلتَحفظوه فإنّكم في حفظهِ","مُستأمنون بأوثق اِستئمانِ",143,"ن",1,0],["وَلتعلموا أنّ الوفيّ لنفسه","يوفي وَمن ينكث عليها جانِ",143,"ن",1,0],["وَلتَعتَبِر في ذا الضريحِ وَمن ثوى","في لَحدهِ بَعدَ القصورِ الشاهقه",144,"ق",2,0],["ولتكن في فراقها مثل هند","يوم كان الزمان من أخداني",145,"ي",1,0],["ولتسرع الأيام في سيرها","أو فلتسر وهنا وفي رفق",146,"ق",1,0],["وَلِتفْرِيطِىَّ ما أَبقَيْ","تُ شَيْئاً لِلمَعادِ",147,"د",1,0],["وَلِتَعليقِها المُنى بِالمَنايا","صِرتُ أَهوى مَنِيَّتي لِمُنائي",148,"ي",1,0],["ولتأْخُذَنَّ كما أَخذْتَ سَويّةً","لا إثْمَ في هذا ولا عُدْوانا",149,"ن",2,0],["ولْتُبْعِدَنَّ ذوي مُعانَدَتي","بحياةِ حُسْنِ مديحِكَ القَسَم",150,"م",1,0],["وَلَتُنجِدَنِّي في ثَنائِكَ أَلسُنٌ","إِن كانَ يُنجِدُ مَن يَقولُ لِسانُ",151,"ن",1,0],["وَلَتَحلَمَنَّ عَلى لَيا","لي عَتبِكُم أَبَداً كَراها",152,"ا",3,0],["وَلتَصدُرِ اللَعناتُ غَيرَ مزالةٍ","لِعِداهُ من ماضٍ وَمن مُستَقبَل",153,"ل",1,0],["وَلَتِلكَ الحُروبِ شَأنٌ عَظيم","فَتَرَكنا الاِكثارَ لِلايجازِ",154,"ز",1,0],["وَلْتَصْعدِي بالنظم نحو ماجد","في قصيدي هو بيت القصد",155,"د",1,0],["ولتسمُ فيك المسلمون كما سمتْ","في جدّه عدنانُها ونزارها",156,"ر",3,0],["وَلْتكُ من ريقك ممزوجة","لا أشرب الراح بماء قراح",157,"ح",1,0],["ولتحظ فيها كل عامٍ ما انجلى","صبحٌ وهبَّ صبا وفاح شذاء",158,"ا",2,0],["ولتعلموا أَنِّي لَدَى ملِكٍ","فاتَ المولكَ بأَسرِهِمْ فضلا",159,"ل",2,0],["ولتَفْدِ نفسَكَ يَا مُظَفَّرُ أَنفُسٌ","مِنَّا متى تَغْلِقْ بِرَهْنٍ تفدِنا",160,"ن",2,0],["ولْتَعْلَمِ الآفاقُ أَنَّكَ مُنْعِمٌ","حقّاً وأَنِّيَ شاكِرُ الإِنْعامِ",161,"م",1,0],["وَلتَهْنِنا أَيَّامُ عِزٍّ كُلُّها","عِيدٌ وأنتَ لِمن أَطاعكَ عِيدُها",162,"د",3,0],["ولتحي جمهورية أحرزتها","كالبعث بعد تبدد وفناء",163,"ا",2,0],["ولتباركهم كما با","رك عيسى من أضروا",164,"ر",3,0],["ولتعصفي يا سمائي","ولتمعنى في أَذاتي",165,"ي",1,0],["ولتجعلوا العيدَ المرَّجب دائماً","فتحاً جديداً يستحُّث جديدا",166,"د",2,0],["ولتأتينّك بالثناء خوابطٌ","في الأرض تخبِط أظهرا ببطونِ",167,"ن",1,0],["ولتدعونّي ثائراً مستيقظاً","إن كنتَ أمسِ دعوتني في النوَّمِ",168,"م",1,0],["ولتتَحرّشْ بحاسديكم","تحرُّشَ النار بالذُّبالِ",169,"ل",1,0],["ولتنظرنَّ إلى عليٍّ رافعا","ضَبْعيك يومَ البعث ينظرُ من علِ",170,"ل",1,0],["ولتيأس الآمالُ منّي بعدها","رؤياك كانت منتهى آمالي",171,"ي",1,0],["ولتُهتُ في وادي الجليدِ فكيف بي","ما خضت لولا أنّه لمعالي",171,"ي",1,0],["ولتجتنب ربعَك الخطوبُ وفي","قومٍ مَصِيفٌ لها ومُرتَبعُ",172,"ع",1,0],["ولتُرضِينَّك ما سمعتَ نواهضٌ","بالشكر لم تَخَفِ اللُّغوبَ ولا وَنتْ",173,"ت",1,0],["ولتَظْفِرنَّ فكل حافرِ سابقٍ","من بعد غرب السيف موضعُ مغفر",174,"ر",1,0],["ولتْريلِ كِتابِ اللّهِ في","ظُلَمِ الليل اذا لم يَتْلُ تالِ",175,"ل",1,0],["ولّتْ ببدرِ دجىً في القلبِ منزلهُ","ودرّةٍ في بحار الدمع تختزن",176,"ن",1,0],["ولتلك أثبتُ في العلى من شبهها","قدماً أجلْ وأشفُّ وجهَ بيان",177,"ن",1,0],["ولتأتينك على بكر طفلة","محجت بفضل وليها وولائها",178,"ا",3,0],["ولتبسطوا الراح داعين الكريم معي","للانتصار مصلين على الهادي",179,"ي",1,0],["ولتفهموا معنى الحياة فإنها","سر التعاضد سعيكم فلتفهموا",180,"م",3,0],["وَلتَبكِني ناقَةٌ إِذا رَحَلَت","وَغابَ في سَردَحٍ مَناكِبُها",181,"ب",3,0],["وَلتَبكِني عُصبَةٌ إِذا إِجتَمَعَت","لَم يَعلَمِ الناسُ ما عَواقِبُها",181,"ب",3,0],["ولتهنني الحضرة الشماء أخدُمها","فقد سريت إليها الوخد والعنقا",182,"ق",2,0],["ولتهن شمس المعالي أنك ابنُ أب","ورثته خَرَزاتِ الملك والخِرقا",182,"ق",2,0],["وَلتُقَدِّم ما تُسَرُّ بِهِ","قَبلَ طُول البَثّ وَالحَزنِ",183,"ن",1,0],["ولتحمد اللهَ أنْ جُعلتَ فيْ ركبٍ","بالرّغم من كيدِها يقودُهُ الموتُ",184,"ت",1,0],["ولتقل للأجنبي إنْ يسَلك","لسْت كُفءَ ما ترَى مهْما فعَلتا",185,"ت",2,0],["ولتجدني متى عزمت رفيقاً","سائراً مسرعاً أمام الركاب",186,"ب",1,0],["ولتسمعن بكيمياء فصاحة","مكنوزة قيراطها قنطار",187,"ر",1,0],["ولتَدُم فى حِفظِه أنجالُكُم","وأراكُم مَن مَضَى فيمَن بَقِي",188,"ي",1,0],["ولتَدُم للأنجالِ كَنزاً وذُخراً","جابِراً مِنهمُ الجَناحَ الكَسيرا",189,"ر",2,0],["ولتَفخَرِ الحَمرَا ويَفخَرَ أهلُهَا","مِن كلِّ ناءٍ منهمُ وقَريبِ",190,"ب",1,0],["ولتَدُم قُرَّةً نعَم وقذَاةً","لِعُيونِ الأعداءِ والأحباَابِ",191,"ب",1,0],["ولْتَبْكِ فيه غُدْوَةً وعشيّةً","في كلِّ يومٍ عينُ كلِّ غمامِ",192,"م",1,0],["ولَتُرْبُ قبرِكَ ما حوى من مُنْتَحٍ","جوّابِ أرضٍ في عُلاً دَوّاسِ",193,"س",1,0],["وَلَّت كَما اِنسابَ ثُعبانٌ وَقَد نَهَضَت","إِلّا وَقيذَةَ أَردافٍ وَأَركانِ",194,"ن",1,0],["ولتفصيلها بهم إجمالٌ","ولإجمالِها بهم تفصيل",195,"ل",1,0],["ولِتَبقى به له ولِتَفنى","عن سواه ولا تراه سواكا",196,"ك",2,0],["ولتلك القلوب أجسام نور","أشرقت بن ظلمة الأجناس",197,"س",1,0],["ولتَرْقصِ اللّججُ العظيمةُ حولها","طرباً ويطفحْ نهرُها متدفِّقا",198,"ق",2,0],["ولتلَبسِ الأرض الأريضةُ سُندُساً","خَضْراً ويلبَسْ زَهرُها الإسْتبرَقا",198,"ق",2,0],["وَلتُنذِرِ الرومَ الطُغاةَ بِعاصِفٍ","مِن باسِهِ مِثلَ الدَبورِ عَقيمِ",199,"م",1,0],["ولْتَظهَرنَّ على عدوِّ","كَ إِنَّ حِزْبَ اللهِ ظَاهِرْ",200,"ر",1,0],["ولتَظْفَرَنَّ بِما يَسُ","رُّ مُوَحِّداً ويَسُوءُ كَافِرْ",200,"ر",1,0],["ولتَمْلِكَنَّ الأَرضَ وح","دَك عامِراً مِنْها وغَامِرْ",200,"ر",1,0],["ولْتَكُبُرَنَّ ويَصْغُرنَّ","بِكَ الأَصَاغِرُ وَالأَكَابِرْ",200,"ر",1,0],["ولتَقْصرنَّ بِك الْقَيا","صِرُ حِينَ تَكْسِرُ والأَكَاسِر",200,"ر",1,0],["ولَتَخضَعَنَّ لك الأَسِرّ","ةُ حينَ تَخْطبُكَ المنَابِرْ",200,"ر",1,0],["ولْتُهننيِ منكَ الكرامةُ إِنَّني","أَخْطُو وأَخْطُر مِنْك في جِلْبابها",201,"ب",3,0],["وَلَّتْ فَلَيْسَ سِوى الشَّبابِ مُصَاحِبي","مِنْهَا وَلَيْسَ سِوَى الرَّجَاءِ بِجَارِي",202,"ر",2,0]]}