{"poems":[[53,"بادر غروس يديك بالسقيا","https://www.aldiwan.net/poem66710.html","أحذ الكامل"],[111,"بصائرنا في القضا خامدة","https://www.poetsgate.com/ViewPoem.aspx?id=522",""],[242,"أزف الرحيل فخانني صبري","https://www.aldiwan.net/poem18190.html","الكامل"],[369,"شفته تحيات العيون العلائل","https://www.aldiwan.net/poem60810.html","الطويل"],[396,"ياطالبا للوصيه","https://www.aldiwan.net/poem54448.html","عموديه"],[411,"ضللت عن المقاصد في معاشي","https://www.aldiwan.net/poem49896.html","الوافر"],[463,"نبهت سعدا والأفق","https://www.aldiwan.net/poem56086.html","مجزوء الرجز"],[580,"باتت معانقتي ولكن في الكرى","https://www.aldiwan.net/poem3062.html","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87092","الطويل"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119263","الطويل"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144760","الكامل"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76793","البسيط"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103520","الرجز"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131018",""],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78357","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119632","الوافر"],[4091,"","https://poetry.dctabudhabi.ae/diwan/poem/141850","الوافر"],[4578,"خبا نور مصباح العلى والمكارم","https://www.poetsgate.com/ViewPoem.aspx?id=49523",""],[4869,"انتي صباح الخير","https://www.poetsgate.com/ViewPoem.aspx?id=151552",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5536,"عربدة فكر!!","https://www.poetsgate.com/ViewPoem.aspx?id=22597",""],[5843,"\" تيب \" اضحي بحرف \" الطاء\" علشانها واللغيه","https://www.poetsgate.com/ViewPoem.aspx?id=51301",""],[5848,"فرحة حزين","https://www.poetsgate.com/ViewPoem.aspx?id=50617",""],[5943,"لاتعجبني ياسيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=37263",""]],"verses":[["وافكك من البلوى وثاقَ فتىً","سلبتْهُ ثوبَ يَسارِه البلوى",0,"و",2,0],["وأفكارنا وسياساتنا","وتدبيرنا شرر خامده",1,"د",2,0],["وَافْكُكْ رَسُولَ اللهِ نَاظِمَهُ","لِسَلِيلِكُمْ مِنْ رِبْقَةِ الْخُسْرِ",2,"ر",1,0],["وأفْكَرْتَ في حِصْنٍ تَمنَّعَ مُشْكِلٍ","وَثيقٍ له في الاِمتناعِ مُشاكِل",3,"ل",1,0],["وافكر وقويقينك","وكن من الأشعر به",4,"ه",1,0],["وأفكارٍ تَمْضُّ بَناتِ قلبي","وأسفارٍ يقَضُّ لها فِراشي",5,"ش",2,0],["وافكك من العار بها","عُنْقَك وخداً وعَنَق",6,"ق",1,0],["وأَفُكُّ عنها القيد وهو ذوائب","أعيت بكثرة شعرها أن تضفرا",7,"ر",2,0],["وَأَفكارُ عَبد اللَه وَهوَ رَئيسه","عَلى رَوض تحسين البِلاد حَوائم",8,"م",1,0],["وافكر في شد الاران وأزدرى","أبا حنف يرضى الملام نصيبا",9,"ب",2,0],["وأفك من ربق الاساءة مهجة","ملأت جوانحها شرار لهيب",10,"ب",1,0],["وافٍ كَريمٌ رَحيمٌ قَد وَفى وَوَقى","وَعَمَّ نَفعاً فَكَم ضُرٍّ شَفى وَكَمِ",11,"م",1,0],["وافٍ كشطر الحاجب المقرون","منعطفٍ مثل انعطاف نون",12,"ن",1,0],["وأفكارنا اخدار غيد بلاغة","متى ما تمس يلق الخلي بها الوجدا",13,"د",2,0],["وَأَفكاري تَسوح لفرط شَوقي","فَأَطوى لَوعَتي وَأَقولُ سوحى",14,"ح",2,0],["وأفكار تضيئ بها الدياجي","لو اتخذ الدجى منها لفاعا",15,"ع",2,0],["وأفكار تترجم عن مرداي","فما يحتاج للمرموز كشفاً",16,"ف",2,0],["وأفكاره تبدى دقائق يرتقي","بها درجات للحجا كل ناظم",17,"م",1,0],["وافكار قلبي لاجل عينك طوابير","وازريت ألملمها من كتاب لكتاب",18,"ب",1,0],["وإفكاً وبهتاناً لأجل انتقاصه","وذلك لا يجيد فقد عز واستما",19,"م",2,0],["وافكاري اللي تتسع للكون والدنيا تضيق","بافكاري اللي ضيقة الدنيا تزيد ابها اتساع",20,"ع",1,0],["وافكر..وافكر. كيف يالشاعر الضرغام","وقرر بعد تفكير ساعه واقول: أكليه",21,"ي",2,0],["وافكر اني أقص القلب ب احساسه","من خوفي انه على حبك ينافسني !",22,"ن",2,0],["وأفكِّرُ فيما يُسعدُنا","ونعزُّ بهِ أرضًا وهدى",23,"د",2,0]]}