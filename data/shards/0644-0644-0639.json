iewPoem.aspx?id=193849",""],[5652,"شمري'ن لا كتب كله عطا","https://www.poetsgate.com/ViewPoem.aspx?id=181644",""],[5671,"ضل الطريق وضلت العفر","https://www.poetsgate.com/ViewPoem.aspx?id=169350",""],[5690,"للعدل والإصلاح أنت كفيلُ","https://www.poetsgate.com/ViewPoem.aspx?id=172177",""],[5717,"يهدي الى الدين وناهيك به","https://www.poetsgate.com/ViewPoem.aspx?id=170594",""],[5720,"للعُمْرِ أحكامٌ","https://www.poetsgate.com/ViewPoem.aspx?id=206367",""],[5815,"ألوان الطيف","https://www.poetsgate.com/ViewPoem.aspx?id=197798",""],[5842,"ويحكِ يادمشق .. ! / غسان عبد الفتاح","https://www.poetsgate.com/ViewPoem.aspx?id=174873",""],[5848,"تصطفل يا قلب","https://www.poetsgate.com/ViewPoem.aspx?id=50599",""],[5897,"منصة العرفان","https://www.poetsgate.com/ViewPoem.aspx?id=157484",""],[5909,"النفس أخصب رهوَها الإفناءُ","https://www.poetsgate.com/ViewPoem.aspx?id=210697",""],[5912,"ساروت في القلب","https://www.poetsgate.com/ViewPoem.aspx?id=205007",""],[5939,"ليلى وأخواتها","https://www.poetsgate.com/ViewPoem.aspx?id=190078",""],[5956,"الحب للجميع","https://www.poetsgate.com/ViewPoem.aspx?id=192191",""],[5956,"تركيبة معظم حكامنا","https://www.poetsgate.com/ViewPoem.aspx?id=192217",""],[5969,"ما وشوشت به الروح","https://www.poetsgate.com/ViewPoem.aspx?id=198633",""],[5974,"الياسمين","https://www.poetsgate.com/ViewPoem.aspx?id=215159",""],[6056,"الخيل مسرج","https://www.poetsgate.com/ViewPoem.aspx?id=156711",""],[6082,"للعشق معان","https://www.poetsgate.com/ViewPoem.aspx?id=60254",""],[6124,"فاضت على الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=201227",""],[6124,"أقسمت بالليل","https://www.poetsgate.com/ViewPoem.aspx?id=201258",""],[6134,"للعاشقين بأحكام الغرام رضا","https://www.poetsgate.com/ViewPoem.aspx?id=169530",""],[6142,"القسط والعدل هزا يوم بيعته","https://www.poetsgate.com/ViewPoem.aspx?id=155720",""],[6142,"مدينة العلم طه والوصي لها","https://www.poetsgate.com/ViewPoem.aspx?id=155719",""],[6145,"دَيْن","https://www.poetsgate.com/ViewPoem.aspx?id=7797",""],[2588,"شاخصة (قياسٌ شاذ)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65607&r=&rc=39",""],[6259,"لو جادهنَّ غداة رمنَ رواحا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59361&r=&rc=9",""]],"verses":[["للعَيْنِ مِنْ عِمّة البُنّيِّ مُعْتَبَرٌ","إنْ لَفّها فوقَ قرْنٍ مَنْ يُخَفّيهِ",0,"ه",1,1],["لِلْعِلْمِ لُحْمَتُهُ وَلِلْفَنِّ السَّدَي","فَاظْنُنْ بِوَشْيٍ فِيهِ يَلْتَقِيَانِ",1,"ن",1,0],["للعلم والآداب في كل الورى","دار محرّمة أجافة بابها",2,"ب",3,0],["للعلم وجه بالحسن مُنتقِب","وسافرٌ منه مثل منتقبه",3,"ب",2,0],["للعلم والنَّعماءِ في أبوابِهِ","للطالبينَ مطالبٌ لا تحجب",4,"ب",1,0],["للعلم والجود تاج إن أصغ مدحاً","فكم هداني إلى درٍّ وهاداني",5,"ن",2,0],["للعبدِ عندكمُ رسوم مكارم","إن أقصيت فنداكمُ يدنيها",6,"ه",2,1],["لِلعِلمِ أَهلٌ وَلِلإيمانِ تَرتيبُ","وَلِلعُلومِ وَأَهليها تَجاريبُ",7,"ب",1,1],["لِلْعُرف نحو أُناسٍ مسلك صَبَبٌ","ومسلكُ العرف نحوي مسلك صَعَدُ",8,"د",1,0],["للعين في وجه عمرو مقبِلاً طِيَرٌ","وفي قَفاه لها مستدبراً عبر",9,"ر",1,0],["لِلعالَمِ الأَسمى الطُهورُ وَمِن مُجا","وَرَةِ الأَنامِ إِلى جِوارِ المُبدِعِ",10,"ع",1,0],["للعشبِ أثقلَه النّدى ،","للغُصنِ أثقلَه الجَنَى",11,"ن",2,0],["للعبيرِ الَّذي يرفرفُ في الأفْ","قِ ويفنى مِثْلَ المنى في سكونِ",12,"ن",1,0],["للعلم منه وللثقافة حائط","يؤوَى إليه وللفنون جدار",13,"ر",1,0],["للعز والأنس فيها","مظاهر ومجالي",14,"ل",2,0],["لِلعِلمِ وَالعَدلِ وَالتَمدينِ ما عَزَموا","مِنَ الأُمورِ وَما شَدّوا مِنَ الحُزُمِ",15,"م",1,0],["لِلعاشِقينَ رِضاكَ وَال","حُسنى وَلي هَجرٌ وَصَدُّ",16,"د",1,1],["لِلعَلاءِ اِبنِ صاعِدٍ فِيَّ مَدحٌ","وَثَناءٌ مُجاوِزُ المِقدارِ",17,"ر",1,1],["لِلعَوهَجِيَّةِ مِن نَجائِبِها","وَالداعِرِيِّ لِأَفحُلٍ صُحرِ",18,"ر",1,0],["للعَيْنِ فيه أيَّ وَجهٍ تُصْرَفُ","بِساطُ منثورٍ نَداه يَنطِفُ",19,"ف",1,0],["لِلعِشقِ سُكرٌ كَالمُدا","مِ إِذا تَمَكَّنَ في العُقولِ",20,"ل",1,1],["للعبقريّةِ فيهِ مَظْهَرٌ أنِقٌ","يا حُسْنَهُ مَظهراً لو كان يُقدَرُ لي",21,"ل",2,0],["لِلعالَمِ العُلوِيِّ فيما خَبَّروا","شِيَمٌ بِها قَدرُ الكَواكِبِ نازِلُ",22,"ل",1,0],["لِلعَبقَرِيِّ عَلَيها إِذ غَدَوا صَبَحٌ","كَأَنَّها مِن نَجيعِ الجَوفِ مَدمومَه",23,"م",2,0],["للعلم في الغرب مدّ","للعلم في الشرق جزرُ",24,"ر",1,0],["للعلم ينمون عند الفخر أنفسهم","وهم من العلم لا نبع ولا غرب",25,"ب",1,0],["للعَندَليب على الأطيار قاطبة","رئاسة عند ما يشدو وسلطان",26,"ن",1,0],["لِلْعَبْقَرِيِّةِ قُوَّةٌ عُلوِيَّةٌ","في نَجْوَةٍ مِنْ نَفْسِهِ عَصْمَاءِ",27,"ا",2,0],["لِلْعِلْمِ وَالآدَابِ مِنْكَ رِعَايَةٌ","أَكَّدْتَهَا بِمآثِرَ لا تُمْتَرَى",28,"ر",2,0],["لِلْعِلْمِ فِيهِ خَبِيئَةٌ مَظنُونَةٌ","حالَتْ مَهَامِهُ دُونَهَا وَقِفارُ",29,"ر",1,0],["لِلعَبْقَرِيِّ المُحرِزِ الفَضْلَيْنِ مِنْ","حَسَبٍ رَفيعٍ فِي البِلاَدِ وَمَحْتَدِ",30,"د",1,0],["للعِلْم والأخْلاَقِ كانَ مُعَاضِداً","فطَوَى الْحَياةَ وفَتَّ في الأعْضَادِ",31,"د",1,0],["للعرب بالضادِ إيمانٌ يوحّدهم","كانوا لعدنانِ أو كانُوا لغسّانِ",32,"ن",1,0],["لِلعلا للفضلِ للدينِ وللأَ","دبِ الجمّ جميعاً والإِباء",33,"ا",2,0],["للعلم كرَّس ما تَصَرَّ","مَ أو تبقَّى من شبابه",34,"ب",2,0],["للعلم والوطن الغالي مواهبهم","تُهدي. ولو سُئلوا أرواحهم، وهبوا",35,"ب",3,0],["للعُربْ أجمعَ قد تحقَّ","ق ذلك النصرُ المتاح",36,"ح",1,0],["للعُرْب دين على التوحيد مرتكزٌ","إليه باطنُه يدعو، وظاهره",37,"ر",2,0],["للعُربُ أنت، وأنورٌ","ومعمَّرٌ، إن غابَ ناصر",38,"ر",1,0],["للعُرْبِ سفرُ نقاباتٍ مُضيَّعةٍ","باقٍ لديكم عليه خيرُ عُنوان",39,"ن",1,0],["للعلاء بن صاعد في مدح","وثناء مجاوز المقدار",40,"ر",1,1],["للعبقريّة قسوة لولا الهوى","عصفت بكلّ عقيدة وصلاح",41,"ح",1,0],["للعارفين نواظر وبصائر","هذي المكارم في رحابك غرسها",42,"ه",2,0],["للعارفين إذا تعاظم كربهم","ودهتهم الدنيا برهص بلاء",43,"ا",2,0],["لِلعبِ قُصَيٍّ بِأَحلامِها","وَهَل يَرجِعُ الحلمُ بَعدَ اللَعِب",44,"ب",1,0],["للعَودُ والناب في وعثاءِ وَخْدِهِما","خيرٌ لمعلوِّطٍ يبغي ترحُّلَهُ",45,"ل",2,0],["للعلم في عصر الضياء شروقُ","يزهو لقابس نوره ويروقُ",46,"ق",1,1],["لِلعِزِّ سارَ مُحَمَّدٌ عَن أَهلِهِ","ثُمَّ اِستَعانَ بِنُصرَةِ الغُرَباءِ",47,"ا",2,0],["للعيد عندك مثلما لك عنده","عيد كعيدك في جميع صفاتهِ",48,"ت",2,0],["للعيش مهما يممتكم خطا","تنبئ عني الفهم واللعثمه",49,"م",2,0],["للعيد أوعدني من لم يزل عيدا","طوباي إن أنجز العيدَ المواعيدا",50,"د",2,1],["للعقل عندي فنون","وللجنون مذاهب",51,"ب",1,0],["للعَلَويَّين فوقَكُمْ شَرَفٌ","لولاه لم تَبْلُغوا ولم تَصلوا",52,"ل",3,0],["للعِيدِ في كلِّ عامٍ","يومٌ يُعيدُ سَنَاه",53,"ا",2,1],["للعِلجِ ثمَّتَ فتكةٌ أو غدرَةٌ","وحُسامُهُ لحبالِهم صرّام",54,"م",1,0],["لِلعاقِب الماحي الَّذي ملا الوَرى","كَرما وَمرحمة وعم وأَنعما",55,"م",2,0],["للعب ما أَبقى فراق أَحِبتي","مني وَما لَم يَبقَ للأحباب",56,"ب",1,0],["لِلْعُود محْتدُه وَمِلْءُ ضُلوعه","لإغاثَة الشّجَر اللّهيف رَبَابُ",57,"ب",1,0],["لِلعيدِ رَسمٌ وافاكَ نَطلُبُهُ","فَجُد بِهِ يا يَتيمَةَ الدَّهرِ",58,"ر",1,0],["للعربِ والإسلامِ في آلامِهمْ","كنتَ اللسانَ مترجماً والساعدا",59,"د",2,0],["للعبقرية في قريضِك طابعٌ","وعليه من آي النبوغِ وسام",60,"م",1,0],["لِلعهدِ وَالوعدِ منهُ بالوفاءِ صدى","طودُ إجابتهِ الأفعالُ لا الكلمُ",61,"م",1,0],["لِلعلمِ أَفردَ همّه فَاِعجب له","مِن فاردٍ في جامع الأعمالِ",62,"ل",1,0],["لِلعيدِ أَحَسَنُ عادَةٍ عاهَدتُها","يَأتي الأَفاضِلَ وَهوَ رَحبٌ باسِمُ",63,"م",1,1],["للعلم من قلبه مكان","وخطبه عنده جسيم",64,"م",1,0],["للعُفاةِ اللائِذِينَ بِها","وَذَوي الأحقادِ والضَّغنِ",65,"ن",1,0],["للعز جاء رعاتُها ورعاعُها","وسُراتُها والذل أمسى هالكا",66,"ك",2,0],["للعمر إذ حان انصرامه","واغفر لنا كل اجترام",67,"م",1,0],["للعلم أهَّلنِي فلا","أهوى سواه ولا أريد",68,"د",1,0],["لِلعُرف عَرف نَشرِهِ في سَيرِهِ","كالمِسكِ مَهما ازدادَ صَوناً فاحا",69,"ح",2,0],["للعلم والآداب شيَّد داره","ولكل ذي فضل من الفضلاء",70,"ا",2,0],["للعلم انشاها الذي عمّ الورى","بمراحمٍ هيهات يدرك جمعها",71,"ع",3,1],["للعين من ألم الأحشاءِ عبراتُ","وللفواد من الأشجان أنات",72,"ت",1,1],["للعلم إنك لم تقدر تضمنه","فاخترت أنك من حوباه تبتعد",73,"د",1,0],["للعارضات من الاطماع معترض","حدوا وللصالحات غير معترض",74,"ض",1,0],["للعيد ما للنيروز منها","في الحظّ منكم والمهرجانِ",75,"ن",1,0],["للعزّ ما منعَ الحسينُ فلم تَنل","كفُّ الزمان وللمكارم ما منحْ",76,"ح",1,0],["للعزِّ حَشْدٌ دون أبوابهم","يُشعِرك الخوفَ ولمَّا يُرَى",77,"ا",1,0],["للعود في راحتيك شدو","كالطير في غصن الإراك",78