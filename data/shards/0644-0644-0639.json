{"poems":[[77,"للعين من عمة البني معتبر","https://www.aldiwan.net/poem35848.html","البسيط"],[93,"ألغرس غرسك أيها البستاني","https://www.aldiwan.net/poem11219.html","الكامل"],[88,"من جور مصر على العروبة أنها","https://www.aldiwan.net/poem44419.html","الكامل"],[88,"لا يبلغ المرء منتهى أربه","https://www.aldiwan.net/poem45001.html","المنسرح"],[72,"تجني لواحظه علي وتعتب","https://www.aldiwan.net/poem18229.html","الكامل"],[72,"تعجب الناس في صمتي وقد ذكرت","https://www.aldiwan.net/poem20229.html","البسيط"],[72,"للعبد عندكم رسوم مكارم","https://www.aldiwan.net/poem20599.html","الكامل"],[64,"للعلم أهل وللإيمان ترتيب","https://www.aldiwan.net/poem67665.html","البسيط"],[51,"الحمد لله حتى ينفد العدد","https://www.aldiwan.net/poem61833.html","البسيط"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[91,"يا نفس قد ذهب الرفيق الألمعي","https://www.aldiwan.net/poem8979.html","عموديه"],[91,"وطن النجوم أنا هنا","https://www.aldiwan.net/poem62783.html","عموديه"],[92,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[85,"نزل المناهل والربى آذار","https://www.aldiwan.net/poem7051.html","الكامل"],[85,"على منازل غالي","https://www.aldiwan.net/poem7249.html","المجتث"],[85,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[85,"للعاشقين رضاك والحسني","https://www.aldiwan.net/poem63670.html","مجزوء الكامل"],[45,"للعلاء ابن صاعد في مدح","https://www.aldiwan.net/poem63607.html","الخفيف"],[28,"طرقت نوار ودون مطرقها","https://www.aldiwan.net/poem5126.html","الكامل"],[61,"صب بغرات الصبا مكلف","https://www.aldiwan.net/poem51549.html","الرجز"],[66,"للعشق سكر كالمدا","https://www.aldiwan.net/poem38550.html","مجزوء الكامل"],[105,"ودع ذويك وسر في شأنك الجلل","https://www.aldiwan.net/poem44046.html","البسيط"],[46,"أجمل فعالك إن وليت ولا تجر","https://www.aldiwan.net/poem23145.html","الكامل"],[15,"لمن جمال قبيل الصبح مزمومه","https://www.aldiwan.net/poem45246.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85703","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85575","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85600","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54898","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54870","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54722","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54297","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54323","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54320","الرمل"],[106,"تحية وتقدير","https://www.poetsgate.com/ViewPoem.aspx?id=179700",""],[106,"في مهرجان العلم","https://www.poetsgate.com/ViewPoem.aspx?id=179765",""],[106,"انتصار الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179290",""],[106,"شعب واحد ورب واحد","https://www.poetsgate.com/ViewPoem.aspx?id=179304",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[90,"تحية الحلة","https://www.poetsgate.com/ViewPoem.aspx?id=179146",""],[45,"للعلاء بن صاعد في مدح","https://www.poetsgate.com/ViewPoem.aspx?id=31286",""],[113,"لك عند عبدك موطن في قلبه","https://www.aldiwan.net/poem40937.html","عموديه"],[113,"أواه من ألم الفراق لأنه","https://www.aldiwan.net/poem42152.html","الكامل"],[132,"تطاول ليلي بهم وصب","https://www.aldiwan.net/poem20978.html","المتقارب"],[133,"يا أيذا الفيصل المزجي زواجره","https://www.aldiwan.net/poem48866.html","البسيط"],[133,"للعلم في عصر الضياء شروق","https://www.aldiwan.net/poem49040.html","الكامل"],[141,"محض الإباء وسؤدد الآباء","https://www.aldiwan.net/poem11717.html","الكامل"],[158,"عيد اعاد الله من بركاته","https://www.aldiwan.net/poem58913.html","الكامل"],[158,"سم سمة تحمد آثارها","https://www.aldiwan.net/poem59021.html","السريع"],[202,"للعيد أوعدني من لم يزل عيدا","https://www.aldiwan.net/poem53320.html","البسيط"],[209,"يا قلب هذا نعيم","https://www.aldiwan.net/poem46564.html","المجتث"],[227,"جرحي بعينيك ليس يندمل","https://www.aldiwan.net/poem50867.html","المنسرح"],[227,"للعيد في كل عام","https://www.aldiwan.net/poem51272.html","المجتث"],[268,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[269,"ضحك تبروق الابرقين تبسما","https://www.aldiwan.net/poem52106.html","الكامل"],[269,"أتحب مسئلة بغير جواب","https://www.aldiwan.net/poem52114.html","الكامل"],[273,"يا حبذا بحديقة دولاب","https://www.aldiwan.net/poem25633.html","الكامل"],[280,"يا ذا العذار الذي به عذري","https://www.aldiwan.net/poem32766.html","المنسرح"],[296,"أنا لست أدري كيف أرثي واحدا","https://www.aldiwan.net/poem36266.html","عموديه"],[296,"برزت بزينتها إليك الشام","https://www.aldiwan.net/poem36300.html","عموديه"],[303,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[303,"يا طيب الكلم الرفيع ويا أبا","https://www.aldiwan.net/poem56429.html","الكامل"],[318,"للعيد أحسن عادة عاهدتها","https://www.aldiwan.net/poem67153.html","الكامل"],[367,"روض الهوى مرتع وخيم","https://www.aldiwan.net/poem4324.html","مخلع البسيط"],[369,"من لطول الهم والحزن","https://www.aldiwan.net/poem57098.html","المديد"],[374,"أذكرت مسكا من مديحك صائكا","https://www.aldiwan.net/poem59303.html","الكامل"],[388,"يا سالم إن شئت السلامه","https://www.aldiwan.net/poem54500.html","عموديه"],[400,"وافى نظامك يا سعيد","https://www.aldiwan.net/poem33945.html","مجزوء الكامل"],[403,"لو جادهن غداة رمن رواحا","https://www.aldiwan.net/poem50194.html","الكامل"],[413,"هذا محل العلم والإفتاء","https://www.aldiwan.net/poem53983.html","الكامل"],[426,"للعلم انشاها الذي عم الورى","https://www.aldiwan.net/poem39823.html","الكامل"],[426,"للعين من ألم الأحشاءِ عبرات","https://www.aldiwan.net/poem40534.html","البسيط"],[438,"لا يمنع الموت حجاب ولا زرد","https://www.aldiwan.net/poem14449.html","البسيط"],[438,"المرء لا زال في دنياه كالعرض","https://www.aldiwan.net/poem14456.html","البسيط"],[456,"خذ من يدي صفقة الأماني","https://www.aldiwan.net/poem55855.html","مخلع البسيط"],[456,"ما كان سهما غار بل ظبي سنح","https://www.aldiwan.net/poem56256.html","الكامل"],[456,"يا عينِ لو أغضيتِ يوم النوى","https://www.aldiwan.net/poem56312.html","السريع"],[477,"ناشدتك الله في فتاك","https://www.aldiwan.net/poem36919.html","مخلع البسيط"],[477,"طال السبات فشأننا استلقاء","https://www.aldiwan.net/poem37618.html","الكامل"],[498,"للروح من روح ريح الحب ريحان","https://www.aldiwan.net/poem37759.html","البسيط"],[556,"ذات تبدت في بديع حلاها","https://www.aldiwan.net/poem33589.html","الكامل"],[557,"للعيس شوق قادها نحو السري","https://www.aldiwan.net/poem69355.html","الكامل"],[560,"لولا التفاوت في الأخلاق والأدب","https://www.aldiwan.net/poem52810.html","البسيط"],[584,"لا غرو إن هز عطفي نحوك الطرب","https://www.aldiwan.net/poem17413.html","البسيط"],[584,"للعاشقين بأحكام الغرام رضا","https://www.aldiwan.net/poem17576.html","البسيط"]],"verses":[["للعَيْنِ مِنْ عِمّة البُنّيِّ مُعْتَبَرٌ","إنْ لَفّها فوقَ قرْنٍ مَنْ يُخَفّيهِ",0,"ه",1,1],["لِلْعِلْمِ لُحْمَتُهُ وَلِلْفَنِّ السَّدَي","فَاظْنُنْ بِوَشْيٍ فِيهِ يَلْتَقِيَانِ",1,"ن",1,0],["للعلم والآداب في كل الورى","دار محرّمة أجافة بابها",2,"ب",3,0],["للعلم وجه بالحسن مُنتقِب","وسافرٌ منه مثل منتقبه",3,"ب",2,0],["للعلم والنَّعماءِ في أبوابِهِ","للطالبينَ مطالبٌ لا تحجب",4,"ب",1,0],["للعلم والجود تاج إن أصغ مدحاً","فكم هداني إلى درٍّ وهاداني",5,"ي",1,0],["للعبدِ عندكمُ رسوم مكارم","إن أقصيت فنداكمُ يدنيها",6,"ه",2,1],["لِلعِلمِ أَهلٌ وَلِلإيمانِ تَرتيبُ","وَلِلعُلومِ وَأَهليها تَجاريبُ",7,"ب",1,1],["لِلْعُرف نحو أُناسٍ مسلك صَبَبٌ","ومسلكُ العرف نحوي مسلك صَعَدُ",8,"د",1,0],["للعين في وجه عمرو مقبِلاً طِيَرٌ","وفي قَفاه لها مستدبراً عبر",9,"ر",1,0],["لِلعالَمِ الأَسمى الطُهورُ وَمِن مُجا","وَرَةِ الأَنامِ إِلى جِوارِ المُبدِعِ",10,"ع",1,0],["لِلعُشبِ أَثقَلَهُ النَدى","لِلغُصنِ أَثقَلَهُ الجَنى",11,"ن",2,0],["للعبيرِ الَّذي يرفرفُ في الأفْ","قِ ويفنى مِثْلَ المنى في سكونِ",12,"ن",1,0],["للعلم منه وللثقافة حائط","يؤوَى إليه وللفنون جدار",13,"ر",1,0],["للعز والأنس فيها","مظاهر ومجالي",14,"ي",1,0],["لِلعِلمِ وَالعَدلِ وَالتَمدينِ ما عَزَموا","مِنَ الأُمورِ وَما شَدّوا مِنَ الحُزُمِ",15,"م",1,0],["لِلعاشِقينَ رِضاكَ وَال","حُسنى وَلي هَجرٌ وَصَدُّ",16,"د",1,1],["لِلعَلاءِ اِبنِ صاعِدٍ فِيَّ مَدحٌ","وَثَناءٌ مُجاوِزُ المِقدارِ",17,"ر",1,1],["لِلعَوهَجِيَّةِ مِن نَجائِبِها","وَالداعِرِيِّ لِأَفحُلٍ صُحرِ",18,"ر",1,0],["للعَيْنِ فيه أيَّ وَجهٍ تُصْرَفُ","بِساطُ منثورٍ نَداه يَنطِفُ",19,"ف",1,0],["لِلعِشقِ سُكرٌ كَالمُدا","مِ إِذا تَمَكَّنَ في العُقولِ",20,"ل",1,1],["للعبقريّةِ فيهِ مَظْهَرٌ أنِقٌ","يا حُسْنَهُ مَظهراً لو كان يُقدَرُ لي",21,"ل",2,0],["لِلعالَمِ العُلوِيِّ فيما خَبَّروا","شِيَمٌ بِها قَدرُ الكَواكِبِ نازِلُ",22,"ل",1,0],["لِلعَبقَرِيِّ عَلَيها إِذ غَدَوا صَبَحٌ","كَأَنَّها مِن نَجيعِ الجَوفِ مَدمومَه",23,"م",2,0],["للعلم في الغرب مدّ","للعلم في الشرق جزرُ",24,"ر",1,0],["للعلم ينمون عند الفخر أنفسهم","وهم من العلم لا نبع ولا غرب",25,"ب",1,0],["للعَندَليب على الأطيار قاطبة","رئاسة عند ما يشدو وسلطان",26,"ن",1,0],["لِلْعَبْقَرِيِّةِ قُوَّةٌ عُلوِيَّةٌ","في نَجْوَةٍ مِنْ نَفْسِهِ عَصْمَاءِ",27,"ا",2,0],["لِلْعِلْمِ وَالآدَابِ مِنْكَ رِعَايَةٌ","أَكَّدْتَهَا بِمآثِرَ لا تُمْتَرَى",28,"ر",2,0],["لِلْعِلْمِ فِيهِ خَبِيئَةٌ مَظنُونَةٌ","حالَتْ مَهَامِهُ دُونَهَا وَقِفارُ",29,"ر",1,0],["لِلعَبْقَرِيِّ المُحرِزِ الفَضْلَيْنِ مِنْ","حَسَبٍ رَفيعٍ فِي البِلاَدِ وَمَحْتَدِ",30,"د",1,0],["للعِلْم والأخْلاَقِ كانَ مُعَاضِداً","فطَوَى الْحَياةَ وفَتَّ في الأعْضَادِ",31,"د",1,0],["للعرب بالضادِ إيمانٌ يوحّدهم","كانوا لعدنانِ أو كانُوا لغسّانِ",32,"ن",1,0],["لِلعلا للفضلِ للدينِ وللأَ","دبِ الجمّ جميعاً والإِباء",33,"ا",2,0],["للعلم كرَّس ما تَصَرَّ","مَ أو تبقَّى من شبابه",34,"ب",2,0],["للعلم والوطن الغالي مواهبهم","تُهدي. ولو سُئلوا أرواحهم، وهبوا",35,"ب",3,0],["للعُربْ أجمعَ قد تحقَّ","ق ذلك النصرُ المتاح",36,"ح",1,0],["للعُرْب دين على التوحيد مرتكزٌ","إليه باطنُه يدعو، وظاهره",37,"ر",2,0],["للعُربُ أنت، وأنورٌ","ومعمَّرٌ، إن غابَ ناصر",38,"ر",1,0],["للعُرْبِ سفرُ نقاباتٍ مُضيَّعةٍ","باقٍ لديكم عليه خيرُ عُنوان",39,"ن",1,0],["للعلاء بن صاعد في مدح","وثناء مجاوز المقدار",40,"ر",1,1],["للعارفين نواظر وبصائر","هذي المكارم في رحابك غرسها",41,"ه",2,0],["للعارفين إذا تعاظم كربهم","ودهتهم الدنيا برهص بلاء",42,"ا",2,0],["لِلعبِ قُصَيٍّ بِأَحلامِها","وَهَل يَرجِعُ الحلمُ بَعدَ اللَعِب",43,"ب",1,0],["للعَودُ والناب في وعثاءِ وَخْدِهِما","خيرٌ لمعلوِّطٍ يبغي ترحُّلَهُ",44,"ل",2,0],["للعلم في عصر الضياء شروقُ","يزهو لقابس نوره ويروقُ",45,"ق",1,1],["لِلعِزِّ سارَ مُحَمَّدٌ عَن أَهلِهِ","ثُمَّ اِستَعانَ بِنُصرَةِ الغُرَباءِ",46,"ا",2,0],["للعيد عندك مثلما لك عنده","عيد كعيدك في جميع صفاتهِ",47,"ت",2,0],["للعيش مهما يممتكم خطا","تنبئ عني الفهم واللعثمه",48,"م",2,0],["للعيد أوعدني من لم يزل عيدا","طوباي إن أنجز العيدَ المواعيدا",49,"د",2,1],["للعقل عندي فنون","وللجنون مذاهب",50,"ب",1,0],["للعَلَويَّين فوقَكُمْ شَرَفٌ","لولاه لم تَبْلُغوا ولم تَصلوا",51,"ل",3,0],["للعِيدِ في كلِّ عامٍ","يومٌ يُعيدُ سَنَاه",52,"ا",2,1],["للعِلجِ ثمَّتَ فتكةٌ أو غدرَةٌ","وحُسامُهُ لحبالِهم صرّام",53,"م",1,0],["لِلعاقِب الماحي الَّذي ملا الوَرى","كَرما وَمرحمة وعم وأَنعما",54,"م",2,0],["للعب ما أَبقى فراق أَحِبتي","مني وَما لَم يَبقَ للأحباب",55,"ب",1,0],["لِلْعُود محْتدُه وَمِلْءُ ضُلوعه","لإغاثَة الشّجَر اللّهيف رَبَابُ",56,"ب",1,0],["لِلعيدِ رَسمٌ وافاكَ نَطلُبُهُ","فَجُد بِهِ يا يَتيمَةَ الدَّهرِ",57,"ر",1,0],["للعربِ والإسلامِ في آلامِهمْ","كنتَ اللسانَ مترجماً والساعدا",58,"د",2,0],["للعبقرية في قريضِك طابعٌ","وعليه من آي النبوغِ وسام",59,"م",1,0],["لِلعهدِ وَالوعدِ منهُ بالوفاءِ صدى","طودُ إجابتهِ الأفعالُ لا الكلمُ",60,"م",1,0],["لِلعلمِ أَفردَ همّه فَاِعجب له","مِن فاردٍ في جامع الأعمالِ",61,"ل",1,0],["لِلعيدِ أَحَسَنُ عادَةٍ عاهَدتُها","يَأتي الأَفاضِلَ وَهوَ رَحبٌ باسِمُ",62,"م",1,1],["للعلم من قلبه مكان","وخطبه عنده جسيم",63,"م",1,0],["للعُفاةِ اللائِذِينَ بِها","وَذَوي الأحقادِ والضَّغنِ",64,"ن",1,0],["للعز جاء رعاتُها ورعاعُها","وسُراتُها والذل أمسى هالكا",65,"ك",2,0],["للعمر إذ حان انصرامه","واغفر لنا كل اجترام",66,"م",1,0],["للعلم أهَّلنِي فلا","أهوى سواه ولا أريد",67,"د",1,0],["لِلعُرف عَرف نَشرِهِ في سَيرِهِ","كالمِسكِ مَهما ازدادَ صَوناً فاحا",68,"ح",2,0],["للعلم والآداب شيَّد د