{"poems":[[65,"لحى الله من يرنو إلى أمد العلا","https://www.aldiwan.net/poem45865.html","الطويل"],[75,"ألم يأن أن يبكي الغمام على مثلي","https://www.aldiwan.net/poem11932.html","الطويل"],[47,"أريتك الآن ألمع البروق","https://www.aldiwan.net/poem65178.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54893","الوافر"],[119,"ما احتيالي في ذا الفؤاد الموله","https://www.aldiwan.net/poem40614.html","عموديه"],[173,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[276,"أفي نيابتي برع تقيم","https://www.aldiwan.net/poem52116.html","الوافر"],[347,"وليلة قضيتها في الاسى","https://www.aldiwan.net/poem55332.html","السريع"],[354,"إليك أنسي بناسي زاد إيحاشي","https://www.aldiwan.net/poem15744.html","البسيط"],[366,"هل ذاك ثغر تبسم","https://www.aldiwan.net/poem68065.html","المجتث"],[466,"إذا شرفت قدر الرجال مراتب","https://www.aldiwan.net/poem15277.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83321","الطويل"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129519","المنسرح"],[1001,"","https://poetry.dctabudhabi.ae/diwan/poem/100567","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123141","البسيط"],[2360,"","https://poetry.dctabudhabi.ae/diwan/poem/119151","المجتث"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94317","الرجز"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129381","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76687","المتقارب"],[5459,"رقصنا","https://www.poetsgate.com/ViewPoem.aspx?id=190907",""],[5650,"غوايةُ الموجِ الغَدور","https://www.poetsgate.com/ViewPoem.aspx?id=177956",""],[5781,"حينَ يصيرُ الغيمُ أبيضَ","https://www.poetsgate.com/ViewPoem.aspx?id=202845",""],[6075,"بين الذكرى والأمنيات","https://www.poetsgate.com/ViewPoem.aspx?id=213327",""]],"verses":[["وَفِي أُمِّ رَأْسِي نَخْوَةٌ أُمَويَّةٌ","ضَمِنْتُ لَها أَنْ يَلْثِمَ النَّجْمُ أَخْمَصي",0,"ص",2,0],["وَفي أُمِّ موسى عِبرَةٌ أَن رَمَت بِهِ","إِلى اليَمِّ في التابوتِ فَاِعتَبِري وَاِسلي",1,"ل",2,0],["وَفي أَمينِ اللَهِ لي مُنصِفٌ","إِن حادَ خَصمي عَن سَواءِ الطَريق",2,"ق",1,0],["وفِي إِملِي حُلى مَلَكٍ كَرِيمٍ","فَما وُسْع النظِيمِ أَوِ النَّثِيرِ",3,"ر",1,0],["وفئام من العواذل طيشا","لا يرون الغرام الا لعله",4,"ل",2,0],["وَفي أَمِيرٍ وَسُلطانٍ لَنا شَرَفٌ","نَسمو بِهِ وَاِبنُ بَدرِ اللَيثُ بَعدَهُما",5,"م",2,0],["وَفي أم القرى قرت عيون","عشية لاح زمزم وَالحَطيم",6,"م",1,0],["وفي امان ذاويات الجنى","اذا اقبلت كاهنة الهيكل",7,"ل",1,0],["وَفي اِمتِحانِكَ لي أَخلَصتُ مُتَّبِعاً","أَهلَ اِختِصاصِكَ في نَفسي لِإِنعاشي",8,"ش",2,0],["وَفي اِمتِداح سِواه","لُزوم ما لَيسَ يَلزَم",9,"م",1,0],["وَفي أمِّ راسي من هَواهُ بقيَّة","يقل الهوى العُذري عنها وَيضعف",10,"ف",1,0],["وَفي أَمَلٍ أَنّى لَدى فِعلِ واجِبٍ","أَسكُنُ قَلباً دونَهُ باتَ يَخفِقُ",11,"ق",1,0],["وفي امتداحي ليث العرين غنا","عن الغنا بالغزال والغزل",12,"ل",1,0],["وفي أمم ترى فيه فلم ذا","يتيه متى نحاك نهى النبيه",13,"ي",2,0],["وفي أم القرى خلى أخاه","على وجدٍ به يشكوا الأواما",14,"م",2,0],["وفي أمانك عند الخوف لي طمع","يا واسع الجود إن ضاقت بي الحيل",15,"ل",1,0],["وفي امي وإن","كنت سيد الشعراء",16,"ا",2,0],["وفي امرىء قال امرؤ أتي امرأ","إتباعها للراء كل قد رأى",17,"ا",2,0],["وفيا مليا في صيانة ملكه","تكنف ذاك الملك سور من الباري",18,"ر",2,0],["وفي امره عجب انه","بمشرقه جاءه المغرب",19,"ب",1,0],["وفي أمنية سكرى","وفي أحلام مرتاب..",20,"ب",1,0],["وفي أمواجهِ أملٌ تَوارى","عنِ العينينِ وارتَحلَ الصّغيرُ",21,"ر",1,0],["وَفي أُمَّتي تُسْبى وتُشْرى نِساؤنا","وَيَأتي حِمانا مِنْ فُتوحِهِ غازِيا",22,"ي",2,0],["وَفِي أَمْوَاجِ غُرْبَتِنَا","هَوَىً بِالْقَلْبِ يُنْجِينَا",23,"ن",2,0]]}