مَهُ","فَكُلُّ جُرحٍ يُصيبُنا جَلَلُ",2,"ل",1,0],["ما صالَ إِلّا اِنجابَ غَيٌّ مُظلِمٌ","وَاِندَقَّ مِن عَمَدِ الضَلالِ عَمودُ",3,"د",1,0],["ما صَلاحُ الزَوجَينِ عاشا جَميعاً","بَعدَ أَن يَصرِمَ الكَبيرُ الكَبيرا",4,"ر",2,0],["ما صَحَّ عِندَ الناسِ شَيءٌ سِوى","أَنَّكَ مِن كَلبٍ بِلا شَكِّ",5,"ك",1,0],["ما صَحَّ وُدِّيَ إِلّا اعتَلَّ وُدُّكَ لي","وَلا أَطَعتُكَ إِلّا زِدتَ عِصيانا",6,"ن",2,0],["ما صدّقوا مَتْنَ الحديث بفتحها","حتى رأوه في متون شِفارِ",7,"ر",1,0],["ما صاحَ مِن حَيَّةٍ يَنمي إِلى جَبَلٍ","إِلّا صَدَعتَ صَفاةَ الحَيَّةِ الذَكَرِ",8,"ر",1,0],["ماصاحِبي إِلّا الَّذي مِن بِشرِهِ","عُنوانُهُ في وَجهِهِ وَلِسانِهِ",9,"ه",1,1],["ما صرّ إلا ولنا نطقُهُ","بالشكر أو يحسر أو نحسر",10,"ر",1,0],["ما صانَ مُهجَتَهُ الَّتي في صَدرِهِ","إِلّا لِيَبذُلَها بِيَومِ طِعانِ",11,"ن",1,0],["ما صح في عقلى وقد","فكرت للتفهم",12,"م",1,0],["ما صاحِبُ الديوانِ بِالمُرتَضى","وَلا الحَميدِ الفِعلِ في أَمري",13,"ر",2,0],["ما صاحَبَ الأَقوامَ في حاجاتِهِم","مَن ناءَ عِندَ شُروعِهِنَّ وَأَعرَضا",14,"ض",2,0],["ما صانَ قُرْبَ العيشِ فيه مَدامعي","حتى أُزيلَ مَصُونُها لبِعادِه",15,"د",2,0],["ما صدّ عنّي بوجهِهِ ولَها","إلا لأزدادَ في الهوى وَلهَا",16,"ل",3,1],["ما صَوْنُ دينِ مُحَمَّدٍ من ضَيمِهِ","إلّا بسيفكَ يومَ كلّ جِلادِ",17,"د",1,0],["مَا صَوَّرَ اللَّهُ لِلأَبْدَانِ أَفْئِدَةً","إِلَّا لِيَرْفَعَ أَهْلَ الْجِدِّ وَالْفَهَمِ",18,"م",1,0],["ما صاحبي مَنْ ودَّني حاضراً","بل صاحبي مَنْ ودَّني غائبا",19,"ب",2,0],["ما صحبةُ السجّانِ محمودةٌ","فاحذرْ منَ السجانِ في الجملَهْ",20,"ه",1,1],["ما صُوِّرَت لِسِوى التَنويلِ راحَتُهُ","وَلا لِغَيرِ اِستِماعِ الحَمدِ مَهيَعُهُ",21,"ع",2,0],["ما صائِداتٌ لَيسَ بارِهاتِ","وَراكِباتٌ غَيرُ سائِراتِ",22,"ت",1,1],["ما صِرْتَ تَأْتينا بِفلس وَلا","بِدِرْهَمٍ وَرِقٍ وَلا نُقرَه",23,"ر",2,0],["ما صانَها نَقْصُ الكمال وَلَمْ تَفْتْ","في الحُسْنِ بَسْمَلَةُ الكِتابِ الحَمْدْلَهْ",24,"ل",2,0],["ما صانَكُنَّ سِوى الأَزواجِ مِن أَحَدٍ","وَأَوَّل الدَهرِ أَعيَيتُنَّ هَمّاما",25,"م",2,0],["ما صَحَّ عِندي أنَّ لحظَكَ صارمٌ","حتّى لَبِسْتَ بِعارِضَيكَ حَمائلا",26,"ل",2,0],["ما صاحِبُ السّيْفِ سَعى نَمْلُه","مِن رَبّةِ الدُّمْلُجِ ذاتِ النُّمَيْل",27,"ل",1,0],["مَا صَوْنُهُ لِلنُّهَى","إِذَا لَمْ يَصُنْ أَدْمُعَك",28,"ك",1,0],["ما صُبْحُ يومٍ والسَّماءُ مَريضةٌ","كصَبَاحِ يَوْمٍ والنهَّارُ نَهار",29,"ر",1,0],["ما صاح صائحهم بملء لهاتِهِ","إلا سمعنا صوتك المعهودا",30,"د",2,0],["ما صال في المَيْدان منَّا صائلٌ","وأصيبَ، إلا قال: يا مصرُ، اسلمي!",31,"م",2,0],["ما صاغَ ربك من نضار خالص","شعبًا، وشعبًا من حصى ورغام",32,"م",1,0],["ما صدع ايوان كسرى في تزلزله","الا لنازلة من معجز القدر",33,"ر",1,0],["ما صاغ مدحك يا مولاي ذو ادب","الا تنظم في الفاظه الدرر",34,"ر",1,0],["ما صحبة الناس أن فارقتهم وطري","ولا المواطن أن ضيعتهم وطني",35,"ن",2,0],["ما صوَّر اللَه هذا الحُسن في بَشَر","وكان يُمكن ألّا تُعبَدَ الصُور",36,"ر",1,0],["ما صدفنا عن ودها علم اللَ","ه ولسنا لهجرها في ارتياح",37,"ح",1,0],["ما صام في رمضان قط وما انثنى","عن ذات حَيضٍ فيه شَدَّ نهار",38,"ر",1,0],["ما صادَفوا بَرقَ التَهَدُّدِ خُلَّباً","كَلّا وَلا غَيمَ الوَعيدِ جَهاما",39,"م",2,0],["ما صالحت داعي الهوى مقلتي","يومئذ إلا على محنتي",40,"ي",1,1],["ما صدقت آمال باغ عنده","كلا ولا ثم رجا من مرجا",41,"ج",2,0],["ما صَدَّهُ وَعظُ النَصيحِ عَنِ الصِبا","لَكِن نَهاهُ مَشيبُهُ الوَعّاظُ",42,"ظ",1,0],["ما صَبَّحَت داراً هَوادي خَيلِهِ","إِلّا وَقامَ المَوتُ فيها يَخطُبُ",43,"ب",1,0],["ما صَبَّحَت داراً سَنابِكُ خَيلها","إِلّا وَوارَت جَوَّها بِالعِثيرِ",44,"ر",1,0],["ما صُورٌ أَبدَعَ في","تَركيبِها أَصحابُها",45,"ه",2,1],["ما صوَّرَ الناس في الأنوارِ أجنحةً","إلا غداةَ بدا منها الجناحانِ",46,"ن",1,0],["ما صبا خيمت بنجد وفكت","عن عراها مزرات الشقيق",47,"ق",1,0],["ما صاح هزار ربا طربا","وحلا في الروض تغرده",48,"د",2,0],["ما صوتها آه ما شداه","إن افتتال به يزيد",49,"د",1,0],["ما صافح النوم أجفاني ولا احتملت","جوانحي ما أثار البن من شجن",50,"ن",1,0],["ما صافح النوم أجفاني ولا احتملت","جوانحي ما أثار البين من شجَنِ",51,"ن",1,0],["ما صفا قلبه من الحب لا","وله نسبة إلى الصفوان",52,"ن",1,0],["ما صافَحَت كَفُّ بُؤسٍ كَفَّ آمِلِها","وَلا أَرى وَجهَ بَأسٍ مَن يُرَجّيها",53,"ي",3,0],["مَا صَبَا نَازِحٌ إِلَى أَرْضِ فَاسِ","وَأَغَذَّ الْيَرَاعُ فِي الْقِرْطَاسِ",54,"س",1,0],["ما صاح هزارُ الأنس على","فننٍ برُبى روضٍ بهج",55,"ج",1,0],["ما صلاتي لها سوى ما تصلّي","ه إلينا من وصفها الوصليّ",56,"ي",1,0],["ما صينَ وجهٌ من كريمٍ حيثُما","وَجهُ الكريمة حُطَّ عَنهُ لثام",57,"م",1,0],["ما صبر صب له في كل جارحة","جرح أَعاد عليه صبره صَبرا",58,"ر",2,0],["ما صاح في عذب العَذيب مغرد","أَولاح برق الابرقين سناه",59,"ا",2,0],["مَا صَابَ لِلْمَلْك مُذْ قَامَتْ صَوائِبُهُ","سَهمٌ ولا صَامَ خَطِّيٌّ وقُصَّالُ",60,"ل",1,0],["ما صَنَعتُم بِقَرنِهِ قالَ لي القَو","مُ اِستَمِع لا رَأَت عُلاكَ اِنحِطاطا",61,"ط",2,0],["ما صانَ لي نسباً يوماً ولا نشباً","ولا رَعى لي عهوداً نقضُها يَصِمُ",62,"م",1,0],["ماصانَ أحمدُ مالَهُ عَنْ سَائلٍ","فَيَصُونُ مافي جَفْنِه مِن ماءِ",63,"ا",2,0],["ما صبا الرَوض نَشرهُ فاح لَمّا","بِيَديهِ اِستَمال عَطف الغُصونِ",64,"ن",1,0],["ما صُنتُ دَمعي مائِلاً لِسِواكُمُ","لَكن جَرى فَتَحدّثوا بِجَفاكُمُ",65,"م",1,0],["ما صورَةُ الحُسنِ إِلّا سورَةٌ نَزَلَت","فَكَيفَ لا يَقبَلُ التَقبيلَ مُصحَفُهُ",66,"ف",2,0],["ما صَحَّ عَن إِسنادِ سُقمِ قُلوبِنا","إِلّا الَّذي يُروى عَنِ الأَجفانِ",67,"ن",1,0],["ما صحَّ لي إِلا لِساني فاعرِضي","عنِّي ولا تتعرَّضي لِلِساني",68,"ن",2,0],["ما صَبَرتُم لقَد بخِلتُم عَلى المُد","نفِ حَقاً حتَّى بطولِ السِّياقِ",69,"ق",1,0],["ما صاحِبي بَعدَ الفِرا","ق سِوى التَوجع وَالنَدَم",70,"م",1,0],["ما صَبر مَقتول اللَوا","حظ عَن حَياة الأَنفُس",71,"س",1,0],["ما صَبر يَعقوب الهَوى","وَسَلوّه عَن يوسف",72,"ف",1,0],["ما صفت مثل جِسمِهِ أَو حكتهُ","فَوقَ ثَغر الأَقاح قَطرة مُزن",73,"ن",1,0],["ما صافحت نسات نج","د في الرُّبَى وَرْداً ونَرْدا",74,"د",2,0],["ما صَرَّ إِلّا وصلَّت بيض أَنصله","في الهام أَو أطَّتِ الأَرماح في الثَغرِ",75,"ر",1,0],["ما صُحا فيكم لعمري ثَمِلٌ","لَمْ يَذُقْ راحاً ولا طاف بحان",76,"ن",1,0],["ما صديغٌ على خديدٍ بازهى","من رقيمٍ بطرسه الفضي",77,"ي",1,0],["ما صانَها بِكراً بخاتَمَها","إِلا لِيَطْلُبَ مِثْلَها بَعْلا",78,"ل",2,0],["ما صحّ علمُ الكيمياءِ لغيرِ مُد","احِ الإمام الأريحيّ الحافظِ",79,"ظ",1,0],["ما صحّ كت