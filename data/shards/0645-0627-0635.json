{"poems":[[53,"ما ابيض من لون العوارض أفضل","https://www.aldiwan.net/poem29902.html","الكامل"],[53,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[53,"أنظر إلى الأيام كيف تعود","https://www.aldiwan.net/poem30626.html","الكامل"],[24,"إن عرسي قد آذنتني أخيرا","https://www.aldiwan.net/poem21863.html","الخفيف"],[71,"دحية لم يعقب فكم تنتمي","https://www.aldiwan.net/poem3762.html","السريع"],[73,"جازيتني عن تمادي الوصل هجرانا","https://www.aldiwan.net/poem11891.html","البسيط"],[83,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[27,"لجت أمامة في لومي وما علمت","https://www.aldiwan.net/poem5769.html","البسيط"],[47,"ماصاحبي إلا الذي من بشره","https://www.aldiwan.net/poem25110.html","الكامل"],[51,"نعال كنباية والعنبر","https://www.aldiwan.net/poem62886.html","الطويل"],[91,"هذي الوغى مشبوبة النيران","https://www.aldiwan.net/poem62764.html","عموديه"],[89,"ما قلت شيئا بفمي","https://www.aldiwan.net/poem45093.html","الرجز"],[45,"برح بي الطيف الذي يسري","https://www.aldiwan.net/poem63614.html","السريع"],[45,"ترك السواد للابسيه وبيضا","https://www.aldiwan.net/poem64626.html","الكامل"],[61,"فرقت بين جفونه ورقاده","https://www.aldiwan.net/poem51712.html","الكامل"],[80,"ما صد عني بوجهه ولها","https://www.aldiwan.net/poem31338.html","المنسرح"],[80,"تفشي يداك سرائر الأغماد","https://www.aldiwan.net/poem31483.html","الكامل"],[87,"بقوة العلم تقوى شوكة الأمم","https://www.aldiwan.net/poem8340.html","البسيط"],[69,"يا صاحبا إن غبت عن عينيه","https://www.aldiwan.net/poem28513.html","السريع"],[69,"ما صحبة السجان محمودة","https://www.aldiwan.net/poem28755.html","السريع"],[81,"لله سر جمال أنت موضعه","https://www.aldiwan.net/poem61462.html","البسيط"],[52,"ما صائدات ليس بارهات","https://www.aldiwan.net/poem27190.html","الرجز"],[67,"يا أيها المولى الوزير الذي","https://www.aldiwan.net/poem18071.html","السريع"],[67,"اليوم قد حكم الهوى بالمعدله","https://www.aldiwan.net/poem18087.html","الكامل"],[46,"إن شئت أن تحفظي من أنت صاحبة","https://www.aldiwan.net/poem23351.html","البسيط"],[76,"يا ذا الذي خط الجمال بخده","https://www.aldiwan.net/poem39030.html","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16699","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55097","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[106,"ذكرى فريد !","https://www.poetsgate.com/ViewPoem.aspx?id=179479",""],[106,"تكلمي يا كتائب","https://www.poetsgate.com/ViewPoem.aspx?id=179636",""],[106,"قومي بين الشرق والغرب","https://www.poetsgate.com/ViewPoem.aspx?id=179442",""]],"verses":[["ما صارِمٌ كَدِرُ الذُبابِ كَصارِمٍ","خَلَعَ الجَلاءَ عَلى ظُباهُ الصَيقَلُ",0,"ل",1,0],["ما صَرَفَ الدَهرُ عَنكَ أَسهُمَهُ","فَكُلُّ جُرحٍ يُصيبُنا جَلَلُ",1,"ل",1,0],["ما صالَ إِلّا اِنجابَ غَيٌّ مُظلِمٌ","وَاِندَقَّ مِن عَمَدِ الضَلالِ عَمودُ",2,"د",1,0],["ما صَلاحُ الزَوجَينِ عاشا جَميعاً","بَعدَ أَن يَصرِمَ الكَبيرُ الكَبيرا",3,"ر",2,0],["ما صَحَّ عِندَ الناسِ شَيءٌ سِوى","أَنَّكَ مِن كَلبٍ بِلا شَكِّ",4,"ك",1,0],["ما صَحَّ وُدِّيَ إِلّا اعتَلَّ وُدُّكَ لي","وَلا أَطَعتُكَ إِلّا زِدتَ عِصيانا",5,"ن",2,0],["ما صدّقوا مَتْنَ الحديث بفتحها","حتى رأوه في متون شِفارِ",6,"ر",1,0],["ما صاحَ مِن حَيَّةٍ يَنمي إِلى جَبَلٍ","إِلّا صَدَعتَ صَفاةَ الحَيَّةِ الذَكَرِ",7,"ر",1,0],["ماصاحِبي إِلّا الَّذي مِن بِشرِهِ","عُنوانُهُ في وَجهِهِ وَلِسانِهِ",8,"ه",1,1],["ما صرّ إلا ولنا نطقُهُ","بالشكر أو يحسر أو نحسر",9,"ر",1,0],["ما صانَ مُهجَتَهُ الَّتي في صَدرِهِ","إِلّا لِيَبذُلَها بِيَومِ طِعانِ",10,"ن",1,0],["ما صح في عقلى وقد","فكرت للتفهم",11,"م",1,0],["ما صاحِبُ الديوانِ بِالمُرتَضى","وَلا الحَميدِ الفِعلِ في أَمري",12,"ي",1,0],["ما صاحَبَ الأَقوامَ في حاجاتِهِم","مَن ناءَ عِندَ شُروعِهِنَّ وَأَعرَضا",13,"ض",2,0],["ما صانَ قُرْبَ العيشِ فيه مَدامعي","حتى أُزيلَ مَصُونُها لبِعادِه",14,"د",2,0],["ما صدّ عنّي بوجهِهِ ولَها","إلا لأزدادَ في الهوى وَلهَا",15,"ل",3,1],["ما صَوْنُ دينِ مُحَمَّدٍ من ضَيمِهِ","إلّا بسيفكَ يومَ كلّ جِلادِ",16,"د",1,0],["مَا صَوَّرَ اللَّهُ لِلأَبْدَانِ أَفْئِدَةً","إِلَّا لِيَرْفَعَ أَهْلَ الْجِدِّ وَالْفَهَمِ",17,"م",1,0],["ما صاحبي مَنْ ودَّني حاضراً","بل صاحبي مَنْ ودَّني غائبا",18,"ب",2,0],["ما صحبةُ السجّانِ محمودةٌ","فاحذرْ منَ السجانِ في الجملَهْ",19,"ه",1,1],["ما صُوِّرَت لِسِوى التَنويلِ راحَتُهُ","وَلا لِغَيرِ اِستِماعِ الحَمدِ مَهيَعُهُ",20,"ع",2,0],["ما صائِداتٌ لَيسَ بارِهاتِ","وَراكِباتٌ غَيرُ سائِراتِ",21,"ت",1,1],["ما صِرْتَ تَأْتينا بِفلس وَلا","بِدِرْهَمٍ وَرِقٍ وَلا نُقرَه",22,"ر",2,0],["ما صانَها نَقْصُ الكمال وَلَمْ تَفْتْ","في الحُسْنِ بَسْمَلَةُ الكِتابِ الحَمْدْلَهْ",23,"ل",2,0],["ما صانَكُنَّ سِوى الأَزواجِ مِن أَحَدٍ","وَأَوَّل الدَهرِ أَعيَيتُنَّ هَمّاما",24,"م",2,0],["ما صَحَّ عِندي أنَّ لحظَكَ صارمٌ","حتّى لَبِسْتَ بِعارِضَيكَ حَمائلا",25,"ل",2,0],["ما صاحِبُ السّيْفِ سَعى نَمْلُه","مِن رَبّةِ الدُّمْلُجِ ذاتِ النُّمَيْل",26,"ل",1,0],["مَا صَوْنُهُ لِلنُّهَى","إِذَا لَمْ يَصُنْ أَدْمُعَك",27,"ك",1,0],["ما صُبْحُ يومٍ والسَّماءُ مَريضةٌ","كصَبَاحِ يَوْمٍ والنهَّارُ نَهار",28,"ر",1,0],["ما صاح صائحهم بملء لهاتِهِ","إلا سمعنا صوتك المعهودا",29,"د",2,0],["ما صال في المَيْدان منَّا صائلٌ","وأصيبَ، إلا قال: يا مصرُ، اسلمي!",30,"م",2,0],["ما صاغَ ربك من نضار خالص","شعبًا، وشعبًا من حصى ورغام",31,"م",1,0]]}