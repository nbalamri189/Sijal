{"poems":[[108,"ما انفكت الناس في أديانها قددا","https://www.shoaraa.com/p11352",""],[53,"ما ابيض من لون العوارض أفضل","https://www.aldiwan.net/poem29902.html","الكامل"],[53,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[53,"أنظر إلى الأيام كيف تعود","https://www.aldiwan.net/poem30626.html","الكامل"],[24,"إن عرسي قد آذنتني أخيرا","https://www.aldiwan.net/poem21863.html","الخفيف"],[71,"دحية لم يعقب فكم تنتمي","https://www.aldiwan.net/poem3762.html","السريع"],[73,"جازيتني عن تمادي الوصل هجرانا","https://www.aldiwan.net/poem11891.html","البسيط"],[83,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[27,"لجت أمامة في لومي وما علمت","https://www.aldiwan.net/poem5769.html","البسيط"],[47,"ماصاحبي إلا الذي من بشره","https://www.aldiwan.net/poem25110.html","الكامل"],[51,"نعال كنباية والعنبر","https://www.aldiwan.net/poem62886.html","الطويل"],[91,"هذي الوغى مشبوبة النيران","https://www.aldiwan.net/poem62764.html","عموديه"],[89,"ما قلت شيئا بفمي","https://www.aldiwan.net/poem45093.html","الرجز"],[45,"برح بي الطيف الذي يسري","https://www.aldiwan.net/poem63614.html","السريع"],[45,"ترك السواد للابسيه وبيضا","https://www.aldiwan.net/poem64626.html","الكامل"],[61,"فرقت بين جفونه ورقاده","https://www.aldiwan.net/poem51712.html","الكامل"],[80,"ما صد عني بوجهه ولها","https://www.aldiwan.net/poem31338.html","المنسرح"],[80,"تفشي يداك سرائر الأغماد","https://www.aldiwan.net/poem31483.html","الكامل"],[87,"بقوة العلم تقوى شوكة الأمم","https://www.aldiwan.net/poem8340.html","البسيط"],[69,"يا صاحبا إن غبت عن عينيه","https://www.aldiwan.net/poem28513.html","السريع"],[69,"ما صحبة السجان محمودة","https://www.aldiwan.net/poem28755.html","السريع"],[81,"لله سر جمال أنت موضعه","https://www.aldiwan.net/poem61462.html","البسيط"],[52,"ما صائدات ليس بارهات","https://www.aldiwan.net/poem27190.html","الرجز"],[67,"يا أيها المولى الوزير الذي","https://www.aldiwan.net/poem18071.html","السريع"],[67,"اليوم قد حكم الهوى بالمعدله","https://www.aldiwan.net/poem18087.html","الكامل"],[46,"إن شئت أن تحفظي من أنت صاحبة","https://www.aldiwan.net/poem23351.html","البسيط"],[76,"يا ذا الذي خط الجمال بخده","https://www.aldiwan.net/poem39030.html","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16699","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55097","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[106,"ذكرى فريد !","https://www.poetsgate.com/ViewPoem.aspx?id=179479",""],[106,"تكلمي يا كتائب","https://www.poetsgate.com/ViewPoem.aspx?id=179636",""],[106,"قومي بين الشرق والغرب","https://www.poetsgate.com/ViewPoem.aspx?id=179442",""],[116,"عليك دهراً سلام الله يا عمر","https://www.aldiwan.net/poem41099.html","عموديه"],[116,"يا بارقا شب بين الشام واليمن","https://www.aldiwan.net/poem41684.html","البسيط"],[117,"يا ساحر الطرف ليلى ما له سحر","https://www.aldiwan.net/poem2362.html","البسيط"],[121,"لا تدرها فإنني غير صاح","https://www.aldiwan.net/poem49342.html","الخفيف"],[133,"كثر الملام ولم أك لأواري","https://www.aldiwan.net/poem54647.html","الكامل"],[144,"خير الأنام لشرهم إحكاما","https://www.aldiwan.net/poem11817.html","الكامل"],[161,"ما صالحت داعي الهوى مقلتي","https://www.aldiwan.net/poem58927.html","السريع"],[161,"لا تيأسن فالرجا كم فرجا","https://www.aldiwan.net/poem59113.html","الرجز"],[165,"مقل الجآذر نبلها الألحاظ","https://www.aldiwan.net/poem67839.html","البسيط"],[170,"صدت فجذت حبل وصلك زينب","https://www.aldiwan.net/poem1606.html",""],[170,"قسماً بأعراف الجياد الضمر","https://www.aldiwan.net/poem1628.html",""],[194,"ما صور أبدع في","https://www.aldiwan.net/poem13150.html","مجزوء الرجز"],[200,"أيك العصافير والدنيا علي أسى","https://www.aldiwan.net/poem45344.html","البسيط"],[211,"يا أهيل الحمى وعرب الفريق","https://www.aldiwan.net/poem13300.html","الخفيف"],[211,"لحظ يسبيك مقلده","https://www.aldiwan.net/poem13325.html","المتدارك"],[212,"يا قلب هذا هوى جديد","https://www.aldiwan.net/poem46563.html","مخلع البسيط"],[212,"لم تنسني فتنة الدنيا وزينتها","https://www.aldiwan.net/poem46640.html","البسيط"],[212,"لم تنسني فتنة الدنيا وزينتها ما في","https://www.aldiwan.net/poem46822.html","البسيط"],[223,"رق لما هواك عقلي فما يقدر","https://www.aldiwan.net/poem55469.html","الخفيف"],[236,"أحق دار وأولى أن نهنئها","https://www.aldiwan.net/poem31632.html","البسيط"],[238,"قد شممنا نفائس الأنفاس","https://www.aldiwan.net/poem19709.html","الخفيف"],[260,"قم واستنشق نفح الفرج","https://www.aldiwan.net/poem35830.html","المتدارك"],[260,"موقع النجم في الحمى الشرقي","https://www.aldiwan.net/poem35936.html","الخفيف"],[271,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[272,"طيف الخيال من النيابتين سرى","https://www.aldiwan.net/poem52115.html","البسيط"],[272,"قف بالخضوع ونادربك يا هو","https://www.aldiwan.net/poem52132.html","الكامل"],[276,"طلت نجيعي أطلاء وأطلال","https://www.aldiwan.net/poem25537.html","البسيط"],[283,"لعن الله جرجس القنياطا","https://www.aldiwan.net/poem32717.html","الخفيف"],[298,"دع الندامة لا يذهب بك الندم","https://www.aldiwan.net/poem33172.html","البسيط"],[349,"مارث لا وأبيك عهد زنادي","https://www.aldiwan.net/poem19816.html","الكامل"],[354,"خلياني وصبوتي وشجوني","https://www.aldiwan.net/poem39775.html","الخفيف"],[354,"كتم الهوى جلدي فليس بذائع","https://www.aldiwan.net/poem40223.html","الكامل"],[367,"عذاره قد سبى طرفي تطرفه","https://www.aldiwan.net/poem17035.html","البسيط"],[367,"اقرا الدموع فإنها عنواني","https://www.aldiwan.net/poem17127.html","الكامل"],[372,"صلة العذولة لي من الهجران","https://www.aldiwan.net/poem57031.html","الكامل"],[372,"أصبحوا يفرقون من إفراقي","https://www.aldiwan.net/poem57285.html","الخفيف"],[381,"يا من مواطر فضله","https://www.aldiwan.net/poem48775.html","مجزوء الكامل"],[381,"قد رق برق الحندس","https://www.aldiwan.net/poem48809.html","مجزوء الكامل"],[381,"طيف ألم بمدنف","https://www.aldiwan.net/poem48811.html","مجزوء الكامل"],[381,"مسني الضر من صدودك عني","https://www.aldiwan.net/poem49257.html","الخفيف"],[404,"شكرا لربي دائما","https://www.aldiwan.net/poem33982.html","مجزوء الكامل"],[407,"صددت أن عاد روض الرأس ذا زهر","https://www.aldiwan.net/poem50174.html","البسيط"],[417,"هذه الدار وهاتيك المغاني","https://www.aldiwan.net/poem54073.html","الرمل"],[430,"من مجيري من قده السمهري","https://www.aldiwan.net/poem40092.html","الخفيف"],[433,"آيات جدك لم تزل تتلى","https://www.aldiwan.net/poem12379.html","الكامل"],[433,"للمرء قبل سماع وعظ الواعظ","https://www.aldiwan.net/poem12545.html","الكامل"],[438,"قد أعرب الدمع عن وجدي وكتماني","https://www.aldiwan.net/poem2565.html","البسيط"],[438,"سل دار هند بالكثيب الفرد","https://www.aldiwan.net/poem2579.html","الرجز"],[438,"نصر من الله وافانا به الخبر","https://www.aldiwan.net/poem2611.html","البسيط"],[440,"سعي شفى بالمنى قبل انتها أمده","https://www.aldiwan.net/poem34879.html","البسيط"],[450,"الحكم للعمل","https://www.aldiwan.net/poem1013.html",""],[453,"يا أسعد الله المساء وأنعما","https://www.aldiwan.net/poem13902.html","الكامل"],[459,"ضنا بأن يعلم الناس الهوى لمن","https://www.aldiwan.net/poem55861.html","البسيط"],[465,"أهلك والليل منضيا جملك","https://www.aldiwan.net/poem3286.html","عموديه"],[465,"أجنها الفكر وأبداها العبق","https://www.aldiwan.net/poem3442.html","عموديه"],[465,"أضاء ثغر سليمى ليلة العلم","https://www.aldiwan.net/poem3473.html","عموديه"],[469,"أعطافه فتنة الفتون","https://www.aldiwan.net/poem59629.html","مخلع البسيط"],[469,"ما صاحب المرء من إن زل عاقبه","https://www.aldiwan.net/poem60062.html","البسيط"],[469,"ما صار للقطر انسكاب","https://www.aldiwan.net/poem60448.html","مجزوء الكامل"],[480,"من بطن أمك للجدث","https://www.aldiwan.net/poem37180.html","مجزوء الكامل"],[480,"القول كالبرق والأعمال كالمطر","https://www.aldiwan.net/poem37185.html","البسيط"],[505,"ما لي إلى وصل الحبيب سبيل","https://www.aldiwan.net/poem38410.html","الكامل"],[515,"لا بر في الحب يا أهل الهوى قسمي","https://www.aldiwan.net/poem20785.html","البسيط"],[539,"عبد العزيز أنا فداك","https://www.aldiwan.net/poem48004.html","عموديه"],[552,"ما صيد قلبك إلا بابنة الكلل","https://www.aldiwan.net/poem47265.html","البسيط"],[552,"صدت أسيماء عن شيبي فقلت لها","https://www.aldiwan.net/poem47871.html","البسيط"],[559,"حق عيني رؤية الوجه المليح","https://www.aldiwan.net/poem34666.html","الرمل"],[568,"أجل هو الرزء جل فادحه","https://www.aldiwan.net/poem69740.html","مجزوء البسيط"],[587,"ما كنت أندب رامة وطويلعا","https://www.aldiwan.net/poem17588.html","الكامل"]],"verses":[["ما صدَّعَ الدارَ إلا مَن سواعِدُهُ","قد سَمَّرَت في بقيعِ الغَرْقَدِ الوَتَدا",0,"د",2,0],["ما صارِمٌ كَدِرُ الذُبابِ كَصارِمٍ","خَلَعَ الجَلاءَ عَلى ظُباهُ الصَيقَلُ",1,"ل",1,0],["ما صَرَفَ الدَهرُ عَنكَ أَسهُمَهُ","فَكُلُّ جُرحٍ يُصيبُنا جَلَلُ",2,"ل",1,0],["ما صالَ إِلّا اِنجابَ غَيٌّ مُظلِمٌ","وَاِندَقَّ مِن عَمَدِ الضَلالِ عَمودُ",3,"د",1,0],["ما صَلاحُ الزَوجَينِ عاشا جَميعاً","بَعدَ أَن يَصرِمَ الكَبيرُ الكَبيرا",4,"ر",2,0],["ما صَحَّ عِندَ الناسِ شَيءٌ سِوى","أَنَّكَ مِن كَلبٍ بِلا شَكِّ",5,"ك",1,0],["ما صَحَّ وُدِّيَ إِلّا اعتَلَّ وُدُّكَ لي","وَلا أَطَعتُكَ إِلّا زِدتَ عِصيانا",6,"ن",2,0],["ما صدّقوا مَتْنَ الحديث بفتحها","حتى رأوه في متون شِفارِ",7,"ر",1,0],["ما صاحَ مِن حَيَّةٍ يَنمي إِلى جَبَلٍ","إِلّا صَدَعتَ صَفاةَ الحَيَّةِ الذَكَرِ",8,"ر",1,0],["ماصاحِبي إِلّا الَّذي مِن بِشرِهِ","عُنوانُهُ في وَجهِهِ وَلِسانِهِ",9,"ه",1,1],["ما صرّ إلا ولنا نطقُهُ","بالشكر أو يحسر أو نحسر",10,"ر",1,0],["ما صانَ مُهجَتَهُ الَّتي في صَدرِهِ","إِلّا لِيَبذُلَها بِيَومِ طِعانِ",11,"ن",1,0],["ما صح في عقلى وقد","فكرت للتفهم",12,"م",1,0],["ما صاحِبُ الديوانِ بِالمُرتَضى","وَلا الحَميدِ الفِعلِ في أَمري",13,"ر",2,0],["ما صاحَبَ الأَقوامَ في حاجاتِهِم","مَن ناءَ عِندَ شُروعِهِنَّ وَأَعرَضا",14,"ض",2,0],["ما صانَ قُرْبَ العيشِ فيه مَدامعي","حتى أُزيلَ مَصُونُها لبِعادِه",15,"د",2,0],["ما صدّ عنّي بوجهِهِ ولَها","إلا لأزدادَ في الهوى وَلهَا",16,"ل",3,1],["ما صَوْنُ دينِ مُحَمَّدٍ من ضَيمِهِ","إلّا بسيفكَ يومَ كلّ جِلادِ",17,"د",1,0],["مَا صَوَّرَ اللَّهُ لِلأَبْدَانِ أَفْئِدَةً","إِلَّا لِيَرْفَعَ أَهْلَ الْجِدِّ وَالْفَهَمِ",18,"م",1,0],["ما صاحبي مَنْ ودَّني حاضراً","بل صاحبي مَنْ ودَّني غائبا",19,"ب",2,0],["ما صحبةُ السجّانِ محمودةٌ","فاحذرْ منَ السجانِ في الجملَهْ",20,"ه",1,1],["ما صُوِّرَت لِسِوى التَنويلِ راحَتُهُ","وَلا لِغَيرِ اِستِماعِ الحَمدِ مَهيَعُهُ",21,"ع",2,0],["ما صائِداتٌ لَيسَ بارِهاتِ","وَراكِباتٌ غَيرُ سائِراتِ",22,"ت",1,1],["ما صِرْتَ تَأْتينا بِفلس وَلا","بِدِرْهَمٍ وَرِقٍ وَلا نُقرَه",23,"ر",2,0],["ما صانَها نَقْصُ الكمال وَلَمْ تَفْتْ","في الحُسْنِ بَسْمَلَةُ الكِتابِ الحَمْدْلَهْ",24,"ل",2,0],["ما صانَكُنَّ سِوى الأَزواجِ مِن أَحَدٍ","وَأَوَّل الدَهرِ أَعيَيتُنَّ هَمّاما",25,"م",2,0],["ما صَحَّ عِندي أنَّ لحظَكَ صارمٌ","حتّى لَبِسْتَ بِعارِضَيكَ حَمائلا",26,"ل",2,0],["ما صاحِبُ السّيْفِ سَعى نَمْلُه","مِن رَبّةِ الدُّمْلُجِ ذاتِ النُّمَيْل",27,"ل",1,0],["مَا صَوْنُهُ لِلنُّهَى","إِذَا لَمْ يَصُنْ أَدْمُعَك",28,"ك",1,0],["ما صُبْحُ يومٍ والسَّماءُ مَريضةٌ","كصَبَاحِ يَوْمٍ والنهَّارُ نَهار",29,"ر",1,0],["ما صاح صائحهم بملء لهاتِهِ","إلا سمعنا صوتك المعهودا",30,"د",2,0],["ما صال في المَيْدان منَّا صائلٌ","وأصيبَ، إلا قال: يا مصرُ، اسلمي!",31,"م",2,0],["ما صاغَ ربك من نضار خالص","شعبًا، وشعبًا من حصى ورغام",32,"م",1,0],["ما صاغ مدحك يا مولاي ذو ادب","الا تنظم في الفاظه الدرر",33,"ر",1,0],["ما صحبة الناس أن فارقتهم وطري","ولا المواطن أن ضيعتهم وطني",34,"ن",2,0],["ما صوَّر اللَه هذا الحُسن في بَشَر","وكان يُمكن ألّا تُعبَدَ الصُور",35,"ر",1,0],["ما صدفنا عن ودها علم اللَ","ه ولسنا لهجرها في ارتياح",36,"ح",1,0],["ما صام في رمضان قط وما انثنى","عن ذات حَيضٍ فيه شَدَّ نهار",37,"ر",1,0],["ما صادَفوا بَرقَ التَهَدُّدِ خُلَّباً","كَلّا وَلا غَيمَ الوَعيدِ جَهاما",38,"م",2,0],["ما صالحت داعي الهوى مقلتي","يومئذ إلا على محنتي",39,"ي",1,1],["ما صدقت آمال باغ عنده","كلا ولا ثم رجا من مرجا",40,"ج",2,0],["ما صَدَّهُ وَعظُ النَصيحِ عَنِ الصِبا","لَكِن نَهاهُ مَشيبُهُ الوَعّاظُ",41,"ظ",1,0],["ما صَبَّحَت داراً هَوادي خَيلِهِ","إِلّا وَقامَ المَوتُ فيها يَخطُبُ",42,"ب",1,0],["ما صَبَّحَت داراً سَنابِكُ خَيلها","إِلّا وَوارَت جَوَّها بِالعِثيرِ",43,"ر",1,0],["ما صُورٌ أَبدَعَ في","تَركيبِها أَصحابُها",44,"ه",2,1],["ما صوَّرَ الناس في الأنوارِ أجنحةً","إلا غداةَ بدا منها الجناحانِ",45,"ن",1,0],["ما صبا خيمت بنجد وفكت","عن عراها مزرات الشقيق",46,"ق",1,0],["ما صاح هزار ربا طربا","وحلا في الروض تغرده",47,"د",2,0],["ما صوتها آه ما شداه","إن افتتال به يزيد",48,"د",1,0],["ما صافح النوم أجفاني ولا احتملت","جوانحي ما أثار البن من شجن",49,"ن",1,0],["ما صافح النوم أجفاني ولا احتملت","جوانحي ما أثار البين من شجَنِ",50,"ن",1,0],["ما صفا قلبه من الحب لا","وله نسبة إلى الصفوان",51,"ن",1,0],["ما صافَحَت كَفُّ بُؤسٍ كَفَّ آمِلِها","وَلا أَرى وَجهَ بَأسٍ مَن يُرَجّيها",52,"ي",3,0],["مَا صَبَا نَازِحٌ إِلَى أَرْضِ فَاسِ","وَأَغَذَّ الْيَرَاعُ فِي الْقِرْطَاسِ",53,"س",1,0],["ما صاح هزارُ الأنس على","فننٍ برُبى روضٍ بهج",54,"ج",1,0],["ما صلاتي لها سوى ما تصلّي","ه إلينا من وصفها الوصليّ",55,"ي",1,0],["ما صينَ وجهٌ من كريمٍ حيثُما","وَجهُ الكريمة حُطَّ عَنهُ لثام",56,"م",1,0],["ما صبر صب له في كل جارحة","جرح أَعاد عليه صبره صَبرا",57,"ر",2,0],["ما صاح في عذب العَذيب مغرد","أَولاح برق الابرقين سناه",58,"ا",2,0],["مَا صَابَ لِلْمَلْك مُذْ قَامَتْ صَوائِبُهُ","سَهمٌ ولا صَامَ خَطِّيٌّ وقُصَّالُ",59,"ل",1,0],["ما صَنَعتُم بِقَرنِهِ قالَ لي القَو","مُ اِستَمِع لا رَأَت عُلاكَ اِنحِطاطا",60,"ط",2,0],["ما صانَ لي نسباً يوماً ولا نشباً","ولا رَعى لي عهوداً نقضُها يَصِمُ",61,"م",1,0],["ماصانَ أحمدُ مالَهُ عَنْ سَائلٍ","فَيَصُونُ مافي جَفْنِه مِن ماءِ",62,"ا",2,0],["ما صبا الرَوض نَشرهُ فاح لَمّا","بِيَديهِ اِستَمال عَطف الغُصونِ",63,"ن",1,0],["ما صُنتُ دَمعي مائِلاً لِسِواكُمُ","لَكن جَرى فَتَحدّثوا بِجَفاكُمُ",64,"م",1,0],["ما صورَةُ الحُسنِ إِلّا سورَةٌ نَزَلَت","فَكَيفَ لا يَقبَلُ التَقبيلَ مُصحَفُهُ",65,"ف",2,0],["ما صَحَّ عَن إِسنادِ سُقمِ قُلوبِنا","إِلّا الَّذي يُروى عَنِ الأَجفانِ",66,"ن",1,0],["ما صحَّ لي إِلا لِساني فاعرِضي","عنِّي ولا تتعرَّضي لِلِساني",67,"ن",2,0],["ما صَبَرتُم لقَد بخِلتُم عَلى المُد","نفِ حَقاً حتَّى بطولِ السِّياقِ",68,"ق",1,0],["ما صاحِبي بَعدَ الفِرا","ق سِوى التَوجع وَالنَدَم",69,"م",1,0],["ما صَبر مَقتول اللَوا","حظ عَن حَياة الأَنفُس",70,"س",1,0],["ما صَبر يَعقوب الهَوى","وَسَلوّه عَن يوسف",71,"ف",1,0],["ما صفت مثل جِسمِهِ أَو حكتهُ","فَوقَ ثَغر الأَقاح قَطرة مُزن",72,"ن",1,0],["ما صافحت نسات نج","د في الرُّبَى وَرْداً ونَرْدا",73,"د",2,0],["ما صَرَّ إِلّا وصلَّت بيض أَنصله","في الهام أَو أطَّتِ الأَرماح في الثَغرِ",74,"ر",1,0],["ما صُحا فيكم لعمري ثَمِلٌ","لَمْ يَذُقْ راحاً ولا طاف بحان",75,"ن",1,0],["ما صديغٌ على خديدٍ بازهى","من رقيمٍ بطرسه الفضي",76,"ي",1,0],["ما صانَها بِكراً بخاتَمَها","إِلا لِيَطْلُبَ مِثْلَها بَعْلا",77,"ل",2,0],["ما صحّ علمُ الكيمياءِ لغيرِ مُد","احِ الإمام الأريحيّ الحافظِ",78,"ظ",1,0],["ما صحّ كتمان سرّي إذ جفيت وقد","أصبحت ما بين أحشاء وأجفان",79,"ن",1,0],["ما صاح بي يا صاحبي منها الأسى","إلا أجبتُ بضروب الوجد",80,"د",1,0],["ما صل سيفك في يمناك يوم وغى","الا وفي طبيه الموت يبتدر",81,"ر",1,0],["ما صُبحُ مصطَبحٍ فِي روضةٍ أُنفٍ","من صُبْحِ من يَنعمُ الإِسلامُ فِي كَبِدِهْ",82,"د",2,0],["ما صوح الشعر يا ليلى ولا ذبل","لكنه بأريج الحب قد ثملا",83,"ل",2,1],["ما صاحَ قُمريُّ الرياضِ مُغرِّدا","أوْ راحَ عن سرِّ الغرامِ مُتَرْجِما",84,"م",2,0],["ما صِينَ عن ألسن الواشين ينقضه","حبٌّ قواعدُه في الصدر لم تُصَنِ",85,"ن",1,0],["ما صاغك الله للمكارم أن خال","فت أمر الحجى فلا جبلك",86,"ك",1,0],["ما صفو ودّي نهزةٌ يرصدها","شوبُ القذى فيه ولا غشُّ الملقْ",87,"ق",1,0],["ما صبوتي صبوةٌ يرجى السلو لها","كأنها نشوة الكندي بالكرمِ",88,"م",1,0],["ما صَدَّ بَعدَ الوَصالِ إِلّا","أَجرى عُيوناً مِنَ العُيونِ",89,"ن",1,0],["ما صاحِبُ المَرءِ مِن إِن زَلَّ عاقِبَهُ","بَل صاحِبُ المَرءِ مَن يَعفو إِذا قَدَرا",90,"ر",2,1],["ما صارَ لِلقَطرِ اِنسِكابُ","إِلّا وَلِلبَرقِ التِهابُ",91,"ب",1,1],["ما صده شيء على","أمر نواه إذا انبعث",92,"ث",1,0],["ما صوتت في طريق الرتل مزجية","إلا وشقت فيافيها على الأثر",93,"ر",1,0],["ما صاب راي في اصابه مقصدي","رأى الأمور من العليل عليل",94,"ل",1,0],["ما صِرْتُ في الحبّ بين الناس معرفةً","حتى تنكّر فيكمْ بالضّنى علَمي",95,"م",2,0],["مَا صَاحَ مِن مُستَنجِدٍ","إلاَّ ولَبَّتهُ خَطَاك",96,"ك",1,0],["ما صِيدَ قلبُك إلّا باِبنةِ الكِلَلِ","وكم نجا النَّبلَ مَن لم ينجُ من مُقَلِ",97,"ل",1,1],["ما صَدّني شيبُ رأسي عن تُقىً وعُلاً","لكنّنِي عن قذى الأخلاقِ مصدودُ",98,"د",1,0],["ما صبا قلبي ولكن هام في","مجتلى وجه كريم لا شحيح",99,"ح",1,0],["ماصفَحَ القومُ عندما قَدَرُوا","لما جَنَتْ فيهِمُ صفائحُهْ",100,"ح",2,0],["مَا صَدَّ عَنِّي في الغَرامِ فَديْتُهُ","لَمّا بَذلْتُ لَهُ دَمِي فَتَمَنَّعا",101,"ع",2,0]]}