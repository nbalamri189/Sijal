{"poems":[[53,"أرى نفسي تتوق إلى النجوم","https://www.aldiwan.net/poem29756.html","الوافر"],[72,"أبكيك للحسنين الخلق والخلق","https://www.aldiwan.net/poem19356.html","البسيط"],[51,"تخذتكم درعا وترسا لتدفعوا","https://www.aldiwan.net/poem65877.html","الطويل"],[44,"عزاء فلم يخلد حوي ولا عمرو","https://www.aldiwan.net/poem30312.html","الطويل"],[50,"إن يحسدوني فإني غير لائمهم","https://www.aldiwan.net/poem63897.html","البسيط"],[46,"الملك لله لا ننفك في تعب","https://www.aldiwan.net/poem22400.html","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16664","الطويل"],[142,"وددت التصابى فيك إذ كان عاذرى","https://www.aldiwan.net/poem58434.html","الطويل"],[160,"من عاش حدث عن أيامه العجبا","https://www.aldiwan.net/poem58910.html","البسيط"],[204,"أحب فمن ذا الذي أخلفه","https://www.aldiwan.net/poem53251.html","المتقارب"],[204,"طباعك فالزمها وخل التكلفا","https://www.aldiwan.net/poem53252.html","الطويل"],[249,"كفى بالنأي من أسماء كافي","https://www.aldiwan.net/poem2105.html","الوافر"],[249,"تغيرت المنازل بالكثيب","https://www.aldiwan.net/poem2130.html","الوافر"],[338,"فما أهل الحياة لنا بأهل","https://www.aldiwan.net/poem68761.html","الوافر"],[441,"لا جدد الله فيما بينكم حزنا","https://www.aldiwan.net/poem14483.html","البسيط"]],"verses":[["وَما أَوفَت عَلى العِشرينَ سِنّي","وَقَد أَوفى عَلى الدُنيا غَريمي",0,"م",2,0],["وما أوفيك يا عبد الرَّحيم وإن","بكت لك العين بعد الماء بالعُلق",1,"ق",1,0],["وما أوْحشتْني وِحدةٌ معْ مذلَّةٍ","إذا الحربُ صفَّتْ خيلَها ورجالَها",2,"ل",3,0],["وَما أَوحَشَ الرَحمَنُ ساحَةَ عَبدِهِ","إِذا عايَنَ الجُلّى وَمُؤنِسُهُ الأَجرُ",3,"ر",1,0],["وَما أُؤَمِّلُ مِن أَمرٍ يَسوؤُهُمُ","إِلّا وَعِندي لَهُم مِن مِثلِهِ مَدَدُ",4,"د",1,0],["وَما أُؤَمِّلُ عِندَ الدَهرِ مَصلَحَةً","وَإِنَّما هُوَ إِتلافٌ وَإِفسادُ",5,"د",1,0],["وما أوْرَقَتْ أوْتادُ دارِكَ باللِّوَى","ودارَةَ حتى أُسْقِيَتْ سَبَلَ الدمْع",6,"ع",1,0],["وما أوقدوا النيرانَ إلا ليفضَحوا","بها الليلَ إن أخفى مسالكَ زائرِ",7,"ر",1,0],["وما أوفيه شكراً حيثُ أمهلني","حتى قضيت من الدنيا بك الأربا",8,"ب",2,0],["وما أولَعَ المرء بالموبقات","وعند الحقائق ما أضعفَه",9,"ف",2,0],["وما أوحش الإلفين حنَّا","اذا افترقا من بعد ما قد تألفا",10,"ف",2,0],["وَما أَوسُ بنُ حارِثَةَ بنِ لَأمٍ","بِغُمرٍ في الأُمورِ وَلا مُضافِ",11,"ف",1,0],["وَما أَوسٌ وَلَو سَوَّدتُموهُ","بِمَخشِيِّ العُرامِ وَلا أَريبِ",12,"ب",1,0],["وَما أَولادُنا وَالأَهلُ فيها","وَلا أَموالُنا إِلّا عَوارِ",13,"ر",1,0],["وما أويس على حسني عقائده","بالموت عاش وبا جده قرنا",14,"ن",2,0]]}