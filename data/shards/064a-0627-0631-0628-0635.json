://www.poetsgate.com/ViewPoem.aspx?id=202058",""],[6152,"دعاء صباحي للأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=208533",""],[5616,"أمي ..!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1926&r=&rc=1",""],[6290,"الْعَدْلُ مَفْقُودٌ فَكَيْفَ رُقِيُّنَا؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85160&r=&rc=11",""]],"verses":[["يا رَبِّ صفحَك يرجو كلُّ مُقترفٍ","فأنت أكرمُ من يعفو ومن صَفَحا",0,"ح",2,0],["يا رَبِّ صَلِّ وَسَلِّم ما أَرَدتَ عَلى","نَزيلِ عَرشِكَ خَيرِ الرُسلِ كُلِّهِمِ",1,"م",1,0],["يا رَبِّ صَلِّ عَلى النَبِيِّ وَآلِهِ","عَدَدَ الخَلائِقِ حَصرُها لا يُحسَبُ",2,"ب",1,0],["يا ربِّ صَفحاً تلك آلهةُ الهوى","فلها عليَّ عبادةٌ وصلاةُ",3,"ه",1,0],["يا ربِّ صاعٌ واحدٌ وشويهةٌ","دَبِّرْ وداوِ فقد دَعوتُ حكيما",4,"م",2,0],["يا رَبِّ صَلِّ عَلَى المُخْتَارِ مِنْ مُضَرٍ","وَالأَنْبِيا وَجَميعِ الرُّسْلِ مَا ذُكِرُوا",5,"ر",3,1],["يا رُبَّ صاحِبِ حانَةٍ قَد رُعتُهُ","فَبَعَثتُهُ مِن نَومِهِ المُتَزَمِّلِ",6,"ل",1,1],["يا رُبَّ صوتٍ يصوغُه عَصَبٌ","نِيطتْ بساقٍ مِن فَوقها قَدَمُ",7,"م",1,1],["يا رَبِّ صُنعُكَ كلُّه فتنٌ","أين الفرارُ وكيف مُطَّرحي",8,"ح",2,0],["يَا رَبِّ صُنْ فاروقَ وَاكلأْ بَيْنَهُ","تَدْعُوكَ مِصْرُ وأَنتَ خَيْرُ مُجِيبِ",9,"ب",1,0],["يا رُب صخر أحمرٍ","من جرح غانية طِلاؤه",10,"ا",3,0],["يا رب صل وسلم عد ما وهبت","يداك من نعمة في السر والجهر",11,"ر",1,0],["يا رب صل مسلماً أبداً عليه","وآله وعلى الملائك والرسل",12,"ل",1,0],["يا ربِّ صلّ عليهِ والآلِ الأُلى","حازوا بِنسبتهِ المقامَ الأفضلا",13,"ل",2,0],["يا ربِّ صَيِّرني له واقياً","من كلّ ما يَكرههُ أو رَدَى",14,"د",2,0],["يا رب صل عَلى النَبي المجتبى","ما غردت في الايك ساجعة الربا",15,"ب",2,1],["يا رب صل عَلى النبي وآله","ما اِهتَزَت الاثلاث من نفس الصبا",15,"ب",2,0],["يا رب صل عَلى النَبي وآله","ما لاحَ برق في الاباطح أَو حبا",15,"ب",2,0],["يا رب صل عَلى النَبي وآله","ما أَمت الزوّار نحوك يثربا",15,"ب",2,0],["يا رب صل عَلى النَبي وآله","ما قالَ ذو كرم لضيف مرحبا",15,"ب",2,0],["يا رب صل عَلى النَبي وآله","ما كوكب في الجوّ قابل كوكبا",15,"ب",2,0],["يا رب صل عَلى الَّذي أدنيته","من قاب قَوسين الجناب الاقربا",15,"ب",2,0],["يا رب صل على النبي","ي وآله ما البدر بان",16,"ن",1,1],["يَارَبّ صُنْ وجهِي عَنِ الكُرَماءِ","فَضْلاً عَنِ الحاجاتِ لِلْؤُماءِ",17,"ا",2,1],["يا ربَّ صَوت مِن الآخور في غَسَق","غَطّى عَلى الناي وَالقانون وَالعودِ",18,"د",1,0],["يا ربِّ صبراً إن قولك صادقٌ","فمن انتهى بالصبر يَنجُ كموسى",19,"س",2,0],["يا رب صل وسلم في الأصل والبكر","على النبي والصحابه النجوم الغرر",20,"ر",1,0],["يا رب صلى وسلم عد كل الشهور","وعد الأنفاس واللحظات طول الدهور",21,"ر",1,0],["يا رَبِّ صَيِّر حَياتي في مَحَبَّتِهِم","وَمَحشَري مَعَهُم آمين آمينا",22,"ن",2,0],["يا رب صل على النبي محمد","والصاحبيه وحبذا من أمنا",23,"ن",2,0],["يا رب صل عليه كلما جزعت","نوق لليلى روابي الجزع والجزعا",24,"ع",2,0],["يا رب صل على المختار سيدنا","ما نار نور صباح نار مبتلج",25,"ج",1,0],["يا رب صل على المختار سيدنا","وآله وعلى العبد المطيع علي",26,"ل",2,0],["يا رب صبر فؤادي بعد فرقته","أنت الإله وأنت الواحد الصمد",27,"د",1,0],["يا رَبّ صَدِّقْ ما جَرَى مِنْ فَالي","يا وَاهِبَ الْخَيْرِ عَلَى الْكَمالِ",28,"ل",1,0],["يا رَبِّ صَلِّ عَلى سَيِّدِنا أَبَداً","أَفضَلُ مَن حَجَّ بَيتَ اللَهِ وَاِعتَمَرا",29,"ر",2,0],["يا رب صبراً لي جميلا انني","تلقاء رزءهما اصم وابكم",30,"م",1,0],["يا رَبِّ صَبِّرْ مُهجَتي","يا رَبِّ فَرِّج كُربَتي",31,"ي",1,0],["يا ربِّ صلِّ عليه","ماهَبَّ ورْقٌ وغرَّد",32,"د",1,0],["يا رب صُبّ عليهْم سوطَ جائحةٍ","لها بأعمارهم هدم وهَدّاتُ",33,"ت",1,0],["يا رب صن لبشيرنا المنصور مَنْ","ما مثله بصفاته مخلوقُ",34,"ق",1,0],["يا رب صل على النبي وآله","واختم لنا بالأمن والإيمان",35,"ن",1,1],["يا رب صل على خير البرية من","قد جاء باليمن والايمان والسنن",36,"ن",1,1],["يا رب صل على النبي محمد","خير البرية والمفيض لها المدد",37,"د",1,1],["يا رب صل على النبي وآله","خير الوجود وصاحب العهد الوفي",38,"ف",2,1],["يا رب صل على طه وشيعته","بحق مقدارك الأسنى ومقداره",39,"ر",2,0],["يا رب صل على النبي","محمد بحر العطا",40,"ط",2,1],["يا رب صل على المختار سيدنا","والآل والصحب من لا يحصى فضلهم",41,"م",1,1],["يا رب صلّ على المختار من مضر","من قد أتانا بهديٍ طيب الخبر",42,"ر",1,1],["يا رب صل على المختار ذي المثل","زين الكيان وخير الرسل من أزل",43,"ل",1,1],["يا رب صل على المشفع","محمد المصطفى الحليم",44,"م",1,1],["يا ربّ صوماً عن سواكَ مؤبّداً","وامنحنِ فطراً بالوِصالِ أعيد",45,"د",1,0],["يا رَبِّ صَلِّ علَى المُختَارِ ما بَرَقَت","سَحابَةٌ جادَ مِنها المَا علَى عَجَلِ",46,"ل",1,1],["يا رَبِّ صَلِّ علَى النَّبِىِّ","ما اهتَزَّ غُصنٌ بهِ خَطِيبُ",47,"ب",1,0],["يا رَبِّ صَلِّ علَى المُختارِ مِن مُضَرٍ","مُحَمّدٌ مَن سَرَى لِلقُدس ثُمَّ رَقا",48,"ق",2,1],["يا رَبِّ صَلِّ علَى النَّبِىِّ وَآلِهِ","ما سارَ رَكبٌ بالحَجيجِ وَرَاحا",49,"ح",2,1],["يا ربِّ صَلِّ علَى النَّبِى","أَلهَاشِمِىِّ العَرَبِى",50,"ب",2,0],["يا رُبَّ صائِحَةٍ بِالوَيلِ حينَ رَأَت","ما بَينَ فَخذَيَّ مِن حُزنٍ وَمِن عِبَرِ",51,"ر",1,0],["يا رب صل على النبي وآله","وصحابهِ بدوام ملك الباري",52,"ر",2,0],["يا ربّ صل عليه من مترحمٍ","متحنن داع إليك مُقرّب",53,"ب",1,0],["يا رب صيّرتني بالروح منشغلاً","فأنت عن أمر جسمي اليوم مسؤول",54,"ل",1,1],["يا رَب صَل عَلى مُحَمد","المُصطَفى زاكي الجُدود",55,"د",1,1],["يا رب صلّ على الهادي وعترتهِ","وصحبه الأتقياءِ السادة النجبا",56,"ب",2,0],["يا رب صل على خير الورى وعلى","من قال ممتثلا يا رب صلّ على",57,"ل",2,0],["يا ربِّ صفحاً عن جَهالةِ آثِمٍ","وغدٍ تريمٍ جامعِ الآصارِ",58,"ر",1,0],["يا رب صلّ عليه","من فضلك المرجحن",59,"ن",1,0],["يا رب صل على هذا الحبيب كذا","سلم على آله والصحب كلهم",60,"م",1,0],["يا رب صل على هذا النبي كذا","سلم على آله والصحب كلهم",60,"م",1,0],["يا رب صل على النبي وآله","من للنبوة والرسالة قد ختم",61,"م",1,0],["يا رب صل على المختار من مضر","واجعل مقامى بجنات العلا جاره",62,"ر",2,0],["يا رب صنهُ ملاذاً نستجبرُ بِهِ","عِندَ الخُطوبِ فَيوقينا مِن الخَطَرِ",63,"ر",1,0],["يا ربُّ صنهُ وَخَلِّد مجد دَولَتِهِ","وَاقرن بِسعديهِ سَعدَ العجمِ وَالعَربِ",64,"ب",1,0],["يا رَب صنهُ وَايّد عزَّ غبطتِهِ","مَع مَن عَلَيهُم يَديهِ بِالرضا يَضعُ",65,"ع",1,0],["يا رَبُّ صنهُ وَخَلِد مجدَ دَولَتِهِ","ما لاحَ نجمٌ ينيرُ البدوَ وَالحضرا",66,"ر",2,0],["يا ربُّ صنهُ وَاحفظن سُلطاننا","عَبد الحَميد وَاحينا بَأمانهِ",67,"ن",2,0],["يا ربِّ صلِّ عَلى 