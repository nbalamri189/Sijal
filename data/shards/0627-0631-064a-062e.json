{"poems":[[55,"خطوب لا يقاومها البقاء","https://www.aldiwan.net/poem30775.html","الوافر"],[75,"مرادهم حيث السلاح خمائل","https://www.aldiwan.net/poem11930.html","الطويل"],[53,"أرى خالدا يرمي صفاتي عداوة","https://www.aldiwan.net/poem64627.html","الطويل"],[53,"بدا الشيب إلا ما تداوي المواشط","https://www.aldiwan.net/poem65000.html","البسيط"],[47,"بودي لو يهوى العذول ويعشق","https://www.aldiwan.net/poem65199.html","الطويل"],[47,"لأية حال أعلن الوجد كاتمه","https://www.aldiwan.net/poem65658.html","الطويل"],[63,"أيا شاغل الشكر عن غيره","https://www.aldiwan.net/poem51658.html","المتقارب"],[76,"وموقد نار حتى كأنما","https://www.aldiwan.net/poem12893.html","الطويل"],[52,"ذكرت شبابي اللذ غير قريب","https://www.aldiwan.net/poem64805.html","الكامل"],[48,"لا خير في المال أعطاه وأجمعه","https://www.aldiwan.net/poem22149.html","البسيط"],[48,"تعالي قدرة وخفوت جرس","https://www.aldiwan.net/poem22835.html","الوافر"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/117010","الطويل"],[47,"لأَيَّةِ حالٍ أَعْلَنَ الوَجْدَ كاتِمُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32082",""],[47,"بوُدّيَ لَوْ يَهْوَى العَذولُ، وَيَعْشَقُ","https://www.poetsgate.com/ViewPoem.aspx?id=32173",""],[147,"هل العدل إلا دون ما أنت مظهر","https://www.aldiwan.net/poem11762.html","الطويل"],[147,"ليهنك ما شادت لك الهمم العلا","https://www.aldiwan.net/poem11807.html","الطويل"],[255,"قضى حبه ألا تطاع عواذله","https://www.aldiwan.net/poem15013.html","الطويل"],[347,"يا ظبية البان ما رددت ذكراك","https://www.aldiwan.net/poem55313.html","البسيط"],[358,"قضى تذكار أبكار الليالي","https://www.aldiwan.net/poem40000.html","الوافر"],[358,"مطالع سعد قد تجلت كواكبه","https://www.aldiwan.net/poem40814.html","الطويل"],[371,"وحوشي أن يقال لها عتابي","https://www.aldiwan.net/poem17143.html","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63771","المتقارب"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18502","الطويل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80198","الوافر"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56299","الطويل"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33841","الطويل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122474","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204479","الطويل"],[3457,"","https://poetry.dctabudhabi.ae/diwan/poem/144549","الوافر"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102389","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108374",""],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129423","البسيط"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129349","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77178","الطويل"],[4578,"رنا جفنه للأسد بالسحر يقنص","https://www.poetsgate.com/ViewPoem.aspx?id=49452",""],[5018,"إلى الله أشكو لا إلى الناس أَنني","https://www.poetsgate.com/ViewPoem.aspx?id=96336",""],[5135,"خَيلُ البشائر","https://www.poetsgate.com/ViewPoem.aspx?id=201871",""],[5135,"هلال السعد","https://www.poetsgate.com/ViewPoem.aspx?id=204492",""],[5644,"خيل البشائر","https://www.poetsgate.com/ViewPoem.aspx?id=199970",""],[5939,"شعورُ الحبِّ لا يكفي!","https://www.poetsgate.com/ViewPoem.aspx?id=178603",""]],"verses":[["أَرى خَلقاً سَواسِيَةً وَلَكِن","لِغَيرِ العَقلِ ما تَلِدُ النِساءُ",0,"ا",2,0],["أَرى خاطِري كَالصارِمِ العَضبِ لَم يَزَل","لَهُ شاحِذٌ مِن حُسنِ رَأيِكَ صاقِلُ",1,"ل",1,0],["أرى خالداً يرمي صَفاتي عَداوةً","ويشتِمُ عرضي سادراً في المجالس",2,"س",1,1],["أرى خُطَّتَيْ كرهٍ يُحيطان بالفتى","إذا ما تخطَّتْهُ الحتوفُ العوابطُ",3,"ط",1,0],["أَرى خُلُقاً هُبِّي لِعَلوَةَ دَأماً","إِذا لَم يَدُم بِالعاشِقينَ التَخَلُّقُ",4,"ق",1,0],["أَرى خَصماً يا وَهبُ أَصبَحَ حاكِماً","عَلَينا فَما نَدري إِلى مَن نُحاكِمُه",5,"م",2,0],["أرى خِلعةَ العيدِ قد أُغفِلَتْ","وكانت تَجئُ على إثْرِه",6,"ر",2,0],["أَرى خَيرَ نارٍ حَولَها خَيرُ فِتيَةٍ","أَنافَت لَهُم جيداً وَحَفّوا بِها عِقدا",7,"د",2,0],["أَرى خَلقاً قَد شابَ قَبلَ جِنايَةٍ","فَهَلّا وَهَبتُم قَلبَهُ لِمَشيبِ",8,"ب",1,0],["أَرى خَيالَ إِزارٍ حَمَّهُ قَدَرٌ","ظَهَرتُ مِنهُ قَليلاً ثُمَّ وُرّيتُ",9,"ت",1,0],["أَرى خُرساً مِنَ الأَيّامِ وافَت","بِكُرٍّ لَم يَكُن مِن ذاتِ خُرسِ",10,"س",1,0],["أرى خلّةً في أخوةٍ وعشيرَةٍ","وذي رحمٍ ما كنتُ ممن يضيعُها",11,"ع",3,0],["أرَى خَصْمَنا يا وَهْبُ أصْبحَ حاكماً","علَينا، فَما نَدرِي إلى مَن نُحاكمُهْ",12,"م",2,0],["أرَى خُلُقاً حُبّي لعَلْوَةَ دائِماً،","إذا لمْ يَدُمْ بالعَاشِقِينَ التّخَلُّقُ",13,"ق",1,0],["أَرى خَبَرَ البُخّالِ يَهلِكُ عَبطَةً","فَيُنسى وَأَخبارُ الكِرامِ تُعَمَّرُ",14,"ر",1,0],["أَرى خَجَلاً يَعتادُني في مَواقِفي","وَما كُنتُ أَخشى أَن أَقولَ فَأَخجَلا",15,"ل",2,0],["أرى خصره أهدى لجسمي تحولَه","فها أنا فيه مدنف الجسم ناحِلُه",16,"ل",2,0],["أرى خيالك والاحلام ساجية","والعين ساهرة تهفو لمرآك",17,"ك",1,0],["أَرى خلع العذار بِهِ حَلا لي","فَعرَّفني حَرامي مِن حَلالي",18,"ل",2,0],["أَرى خاطِبَ العَلياءِ حاطِبَ لَيلِها","إِذا فقد المِصباح فَاللَيل حاطِبُه",19,"ب",2,0],["أَرى خُرقَ العَطايا مِنكَ حَزماً","وَغاياتِ التَواضُعِ كِبرِياءَ",20,"ا",2,0],["أرى خِنصري هَجَرَتْ خاتَمي","فما تصلُ الخاتمَ الخنصر",21,"ر",1,0],["أَرى خالِداً يَختالُ مَشياً كَأَنَّهُ","مِنَ الكِبرِياءِ نَهشَلٌ أَو عُطارِدُ",22,"د",1,0],["أَرى خَيري بِخَيري فاضَ يَزهو","وَسَعدي في حِماهُ لَهُ حُلولُ",23,"ل",1,0],["أرى خيلكم في رقعة اللعب قصرت","عن السير إذ جاءت مع الجاه تلعبُ",24,"ب",1,1],["أَرى خَطَراتِ الشَوقِ يُبكينَ ذا الهَوى","وَيُصبينَ عَقلَ المَرءِ وَهوَ لَبيبُ",25,"ب",1,0],["أرَى خلِّي المحَكَّمَ فِي النِّزاعِ","رَمَى وُدِّي ومالَ إِلَى الخدَاعِ",26,"ع",1,1],["أرى خللا في الكون للعقل بيناً","فإما به نقص أو النقص في عقلي",27,"ل",2,1],["أرى خَمراً تُشاكِلُها دُموعي","كأنَّ ظُروفها كانَت شُؤؤني",28,"ي",1,0],["أرى خيرَ يومَيَّ الخَسيسَ وإنْ غلا","بيَ اللؤمُ لم أحفِلْ ملامةَ لائمِ",29,"م",1,0],["أرى خلقةً لما الفؤاد يميل","إليك شكيبٌ حيث أنت مميلُ",30,"ل",1,1],["أرى خميسين قام الحرب بينهما","يسعى على ساق جد كره هزل",31,"ل",1,1],["أرى خير يومي الذي سمحت به","يد الدهر يوما فزت منه بموعد",32,"د",1,0],["أرى خطباً فظيعاً","داهياً أبناء فريام",33,"م",1,0],["أَرى خَيري الدارين يَجمَع كُله","بِخمس خِصال يا لَها مِن لَطائِف",34,"ف",1,1],["أرى خالهُ لصاً تقيد حينما","غدا نحو كنز الثغر منه تلصص",35,"ص",1,0],["أَرى خَلَّةً في إخوة وقرابة","وذي رحم ما كان مثلي يضيعها",36,"ع",3,0],["أرى خيْلَ الْبَشائِرِ قادماتٍ","تُبَسِّرُنا بما وعدَ الْإلٰهُ",37,"ا",3,0],["أرى خَلْفَ الظَّلامِ هِلَالَ سَعْدٍ","سَتَلْمعُ عَنْ قَرِيْبٍ في سَمَانا",38,"ن",2,1],["أرى خيل البشائر قادماتِ","تبشرني بأن الفجر آتِ",39,"ت",1,1],["أرَى خَديّكِ بُستانًا","تُذيقُ قُطوفُهُ نَحْلا",40,"ل",2,0]]}