ترحال","https://www.poetsgate.com/ViewPoem.aspx?id=61605",""],[402,"ذلك كالرزء في الصديق الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=36332",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5854,"إلى من ابتلي بمشاهدة الأفلام الفاضحة","https://www.poetsgate.com/ViewPoem.aspx?id=191818",""],[5890,"درب الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=192584",""],[5950,"شايف حالي ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128334",""],[6031,"لا أَلَمَّتْ بِجِسْمِكَ الآلاَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=46359",""],[6031,"يا سَاكِنِيْ الخَطِّ في قَلْبي لَكُمْ خِطَطٌ","https://www.poetsgate.com/ViewPoem.aspx?id=46308",""],[6089,"بلاء العاشقين","https://www.poetsgate.com/ViewPoem.aspx?id=212926",""],[6089,"الكلماتُ البالغاتُ","https://www.poetsgate.com/ViewPoem.aspx?id=213394",""],[6115,"الا يازمان قام يلوي ذراعي لي","https://www.poetsgate.com/ViewPoem.aspx?id=196459",""],[463,"اتمنَّى والمنى جهدُ المقلُّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60222&r=&rc=278",""],[6256,"الجلاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65927&r=&rc=15",""],[6290,"الْقَنْطَرَةُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85654&r=&rc=43",""]],"verses":[["تَبَلَّجَ فيهِ وَسمُكَ وَالمَطايا","تُغَلغِلُ في حَوارِكِها الوُسومُ",0,"م",1,0],["تَبلى بِدَولَتِكَ الدُنيا وَحاشَ لَها","أَن لا يَكونَ عَلَينا أَبرَكُ الدُوَلِ",1,"ل",1,0],["تُبَلِّغُهُ أَقصى الأَماني رِماحُهُ","وَآرائُهُ وَالرَأيُ أَمضى مُرافِقِ",2,"ق",1,0],["تَبَلَّجَ العِيدُ عنْ سَعدٍ يُصافِحُهُ","جَدٌّ عَواقِبُهُ تُفْضي إِلى الجَذَلِ",3,"ل",1,0],["تَبلَّجَ مَيمونَ النّقِيبةِ سابِقاً","يُراقبُ مِن عِرْقِ النُّبوَّةِ تالِيا",4,"ي",2,0],["تَبَلّجَ بالشّبيبةِ صُبْحُ شَيْبي","فأدْبَرَ لَيْلَها وولّى",5,"ل",2,1],["تَبْلَى اللَّيَالِي وَهْوَ يَنْدَى جِدَّةً","وَيَجِفُّ زَهْرُ الزَّهْرِ وَهْوَ بَلِيلُهُ",6,"ل",2,0],["تَبَلَتكَ ثُمَّتَ لَم تُنِل","كَ عَلى التَجَمُّلِ وَالوَقارَه",7,"ر",2,0],["تَبَلَّجَ لَمّا جِئتُ وَاِخضَرَّ عودُهُ","وَبَلَّ وَسيلاتي إِلَيهِ بِلالَها",8,"ل",3,0],["تَبْلُوهُ عَنْ كَثَبٍ فَتُلْفِي النُّبْلَ فِي","إِسْرَارِه وَالنُّبْلُ فِي الإِعْلانِ",9,"ن",1,0],["تَبَلَت حَبَابَةُ قَلبَهُ","بالدَّلِ والشَّكلِ الأَنِيق",10,"ق",1,0],["تَبَلَّغَ بارِحِيٌّ كَراهُ فيهِ","وَآخَرُ قَبلَهُ فَلَهُ نَئيمُ",11,"م",1,0],["تَبُلُّ غليلَ الرمح من مُهج العدا","إذا ما كَسَتْ منها الرَماحُ غلائلُ",12,"ل",1,0],["تبلَج أفق الشرق من بعدما اغبرّا","وكشّر عن صبح الأمانيَ مفتّرا",13,"ر",2,1],["تُبَلِّغ بَني نَبهانَ مِنّي قَصائِداً","تَطالَعُ مِن سَلمى وَهُنَّ وُعورُ",14,"ر",1,0],["تَبُلُّ خُموشَ الوَجهِ كُلُّ كَريمَةٍ","عَوانٍ وَبِكرٍ تَحتَ قَرٍّ مُخَدَّرِ",15,"ر",1,0],["تَبَلَت فُؤادَكَ في المَنامِ خَريدَةٌ","تَشفي الضَجيعَ بِبارِدٍ بَسّامِ",16,"م",1,1],["تَبلى عِظامُهُمُ إِمّا هُمُ دُفِنوا","تَحتَ التُرابِ وَلا تَبلى مَخازيها",17,"ي",3,0],["تبلغني قمامة كلّ يوم","وتجعل فيه بيتي بيت لحم",18,"م",1,0],["تبلَّجتْ غُرَّةٌ غَرَّاءُ واضحةٌ","مثلُ الشهاب إذا ما ضَوْؤُه ثَقَبَا",19,"ب",2,0],["تبلج عند الموت وابيضّ وجهُهُ","تبلُجَ ضوء الفجر عند انفجاره",20,"ر",2,0],["تبلو به محنةُ الدنيا وفتنتُها","طوداً كهمِّك إرساءً وإشرافا",21,"ف",2,0],["تَبلى ثِيابُ بَني سَعدٍ إِذا دُفِنوا","تَحتَ التُرابِ وَلا تَبلى مَخازيها",22,"ي",3,0],["تبلُو الحَيَاةَ فتبلِيها وتخلَعُها","وتستجدُّ حياةً مَا لها قِدمُ",23,"م",1,0],["تبلى الرياح خطوطها","ويزيد في البلوى حذاك",24,"ك",1,0],["تَبَلَّجَ في مِصرَ إِكليلُهُ","فَلَم يَعدُ في المُلكِ عُمرَ الزَهَر",25,"ر",1,0],["تَبُلُّ الثَرى سوداً مِنَ المِسكِ وَحدَهُ","وَقَد قَطَرَت حُمراً عَلى الشَعَرِ الجَثلِ",26,"ل",1,0],["تَبُلُّ خَدَّيَّ كُلَّما اِبتَسَمَت","مِن مَطَرٍ بَرقُهُ ثَناياها",27,"ا",3,0],["تبلُغُ أَوطارُها وَتَعلَمُهُ","مُجتَمِعاً في صَلاحِها وَطَرُه",28,"ر",2,0],["تَبلى الخُطوبُ وَأَحداثُ الزَمانِ وَلا","تَبلى القَوافي مُثولاً وَالأَعاريضُ",29,"ض",1,0],["تَبَلَّجَ عَن بَعضِ الرِضا وَاِنطَوى عَلى","بَقِيَّةِ عَتبٍ شارَفَت أَن تَصَرَّما",30,"م",2,0],["تُبِلُّ مِن مَحلِها البِلادُ بِهِم","كَما يُبِلُّ المَريضُ مِن سَقَمِه",31,"م",2,0],["تَبَلَّعُ حيتانَ الفَضاءِ وَتَنتَحي","بِأَعناقَها في ساكِنٍ غَيرِ أَكدَرا",32,"ر",2,0],["تبلَّدَ هذا الدهرُ فيما نرومُه","على أنَّه فيما نحاذرُه نَدْبُ",33,"ب",1,0],["تَبَلَّغ بِاليَسيرِ فَكُلُّ شَيءٍ","مِنَ الدُنيا يَكونُ لَهُ اِنتِهاءُ",34,"ا",2,0],["تَبَلَّغ مِنَ الدُنيا وَنَل مِن كَفافِها","وَلا تَعتَقِدها في ضَميرٍ وَلا يَدِ",35,"د",1,0],["تَبْلَى الْعِظَامُ وَيَبْقَى ذِكْرُهُ أَبَدَاً","فِي كُلِّ عَصْرٍ لَهُ سَجْعٌ وَتَرْنَامُ",36,"م",1,0],["تَبَلَتكَ مِصرُ وَمِصرُ في حَرَمِ الهَوى","دارٌ تَضُمُّ العاشِقينَ وَتَجمَعُ",37,"ع",1,0],["تَبَلَّدَ مُغبَرّاً وَأَرعَدَ خائِفاً","وَأَحجَمَ مُزوَرّاً وَأَعرَضَ نائِيا",38,"ي",2,0],["تُب لا تَلُم ذا غَرامٍ","إِن لَم تَتُب سَوفَ تُبلى",39,"ل",2,0],["تَبلى الكرامُ وآثارُ الكرامِ وما","تَزدادُ في كلّ عَصرٍ غيرَ تجديدِ",40,"د",1,0],["تَبلى الدِيارُ وَيَبلى مَن يَحِلُّ بِها","وَدورُكُم وَمَغاني دورِكُم جُدُدُ",41,"د",1,0],["تَبْلُغُ مَا تَبْلُغُ مِنْ قَصْدِهَا","بِالعَقْلِ وَالحِكْمَةِ وَالرِّفْقِ",42,"ق",1,0],["تَبُلُّ ثَرَاهُ نَاضِبَاتُ مَدَامِعِي","وَقَلْبِيَ بَعْدَ اليَوْمِ فِي إِثْرِهِ صَدِي",43,"د",2,0],["تبلغُ الغايةَ القصيّةَ ما أدْ","مَيتَ جُرحاً ولا تعمدتَ طَعنَا",44,"ن",2,0],["تَبَلّجَ بالْبُشْرَى وَلاحَتْ مَوَاكِبُهْ","ورَفَّتْ بِأَنْفَاسِ النَّسِيمِ سَبَائِبُهْ",45,"ب",2,1],["تبلى وفي نفس من طول البقا أمل","وذاك أنصب مما يفعل الألم",46,"م",1,0],["تبلد الخطب اذا جالدته","بمرة تبسه بس السفا",47,"ا",1,0],["تبلى الليالي وهي تندى جدة","ويجف زهر الروض وهو بليله",48,"ل",2,0],["تبلوه ألفاً وتراهُ واحدا","تلقى إليه العُضُل المقالدا",49,"د",2,0],["تبلغ النفس يوم أودى مداها","لا سماء ولا نجوم أراها",50,"ه",2,0],["تَبَلَّغْ باليَسِيْرِ فَكُلُّ شَيْىء ٍ","من الدنيا يكون له انتهاء",51,"ا",2,0],["تَبَلَّجَ مِنْ نورِ النُّبُوَّة ِ وَجْهُهُ","فمنه عليه للعُيُونِ شوَاهِدُ",52,"د",1,0],["تَبلُغِ الحضرَةَ الخَدِيمِيَّةِ السُّن","نِيَّةِ المُستَبَانَ نُورُ سَنَاهَا",53,"ا",3,0],["تَبَلَّجَ إِصباحُ الحَقائِقِ فَوقَهُ","وَفاحَ عَلى فَحواهُ مِسكُ الأَدِلَّةِ",54,"ه",1,0],["تبلجَ صبحُ الهنا مشرقاً","ونورتِ الشمس افقَ السرايةْ",55,"ا",3,1],["تَبلى الرياضُ وكلُ روضٍ وافرٍ","وندى البَ