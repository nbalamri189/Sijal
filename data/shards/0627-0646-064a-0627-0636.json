{"poems":[[75,"أنى أضيع عهدك","https://www.aldiwan.net/poem11869.html","مجزوء الكامل"],[95,"يا مائساً عن غض بان","https://www.aldiwan.net/poem11165.html","مجزوء الكامل"],[186,"ليس الوقيعة من شأني فإن عرضت","https://www.aldiwan.net/poem67078.html","البسيط"],[449,"أما لقربك بعد الهجر ميعاد","https://www.aldiwan.net/poem55954.html","عموديه"],[741,"","https://poetry.dctabudhabi.ae/diwan/poem/199300","البسيط"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141288","البسيط"],[190,"","https://poetry.dctabudhabi.ae/diwan/poem/98374","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109990","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135793","الرجز"],[4775,"سكرات","https://www.poetsgate.com/ViewPoem.aspx?id=175224",""],[5092,"أكسوهُ شوقًا","https://www.poetsgate.com/ViewPoem.aspx?id=176854",""],[5353,"شكوى إلى سيد الكائنات محمد (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=212240",""],[5490,"وقفت بالباب","https://www.poetsgate.com/ViewPoem.aspx?id=176378",""],[5956,"شكراً على الاستدفاء بنيرانكم","https://www.poetsgate.com/ViewPoem.aspx?id=192365",""]],"verses":[["أَنّى أُضَيِّعُ عَهدَك","أَم كَيفَ أُخلِفُ وَعدَك",0,"ك",1,1],["إِنِّي أَضَعْت جَمِيلَ صَبْ","رِي فِي جَمَالِكَ وَافْتِنَانِي",1,"ن",2,0],["إِني أَضنُّ بِعِرضي أَن يُلمَّ بِهِ","غَيري فَهَل أَتَولَّى خرقه بِيَدي",2,"ي",1,0],["إني اضن بقومي كيفما فعلوا","من أن يفرقهم غل واحقاد",3,"د",1,0],["إني أضن بنفس لا يجاد بها","والجود بالنفس أقصى غاية السّرف",4,"ف",1,1],["إنّي أضنّ بعيني أن يلمّ بها","ضيم فصوني من البلوى معانيك",5,"ك",1,0],["إني اضطهدت ولم أختر سؤالهم","ما صيّر الله مختارا كمضطهد",6,"د",1,0],["إِنِّي أَضَعتُ العُمرَ بال","أَسواءِ واللهو المُضيعِ",7,"ع",1,0],["إني اضطررْت يومي ذا أشدْ","من كل يومٍ قبله بذا البلدْ",8,"د",1,1],["إني أضمد جرحا مل من زمن","ذكرى الخديعة في نسيان نسياني",9,"ن",2,0],["إني أضاجعُ في القصيدِ غرامنا","فأخيلُ أنّ الشوق من أبنائهِ!!",10,"ا",3,0],["إنّي أضَعْتُ نهاراتٍ لوهم ِ غد ٍ","طيَّ السّنين ِ انتظارا ً علّها وعسى",11,"س",2,0],["أني أضمّ جراحَ العمر رابطةً","جأشي عليها فيغدو النزفُ تكويني",12,"ن",2,0],["إني أضيف إليكمو هذي الفِكَرْ","إن لم تدُرْ بخيالكم هذي الفِكَرْ",13,"ر",1,0]]}