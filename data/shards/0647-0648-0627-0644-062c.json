m/ViewPoem.aspx?id=108227",""],[5237,"رويدكم فما سمعي بقابل","https://www.poetsgate.com/ViewPoem.aspx?id=113117",""],[5277,"شعارُ الدموع","https://www.poetsgate.com/ViewPoem.aspx?id=204180",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5353,"الآتي الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=212460",""],[5363,"إلى قلبه يأوي غزالٌ وقسوَرهْ","https://www.poetsgate.com/ViewPoem.aspx?id=144295",""],[5425,"أَوفَيتَ عَهْدَكَ ، يا حَقٌّ بِمَقْتَلِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=207514",""],[5431,"تسلل ضوئي...","https://www.poetsgate.com/ViewPoem.aspx?id=202580",""],[5881,"دمي /أنا","https://www.poetsgate.com/ViewPoem.aspx?id=183819",""],[5956,"ذكرياتُ مشاهدَ من حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=184838",""],[6093,"البخاري ولي الخالق الباري","https://www.poetsgate.com/ViewPoem.aspx?id=203342",""],[520,"قفا فلعل الفيض من عبراته","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577454",""],[6239,"النشيد العالي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75976&r=&rc=27",""],[463,"أشوقا وَ من تهوى خليُّ الجوانحُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59999&r=&rc=55",""]],"verses":[["هُوَ الجاعِلُ البيضَ القَواطِعَ وَالقَنا","كِعاماً لِأَفواهِ الثُغورِ الفَواغِرِ",0,"ر",1,1],["هو الجبل الراسي تصدّع بعدما","أقرت به شُمُّ الجبال رَوَاسيها",1,"ي",3,0],["هو الجارح الآسي ولا شك أنه","سيشفى الحشا المجروحُ ممَّا يكابدُ",2,"د",1,0],["هو الجَمّاش للعليا","ء لا للغادة الغزِلَهْ",3,"ل",2,0],["هُوَ الجَدُّ حَتّى تَفضُلَ العَينُ أُختَها","وَحَتّى يَصيرَ اليَومُ لِليَومِ سَيِّدا",4,"د",2,0],["هو الجسد الغليظ غدا لطيفاً","بوزن الروح تحسبه ادارك",5,"ك",1,0],["هُوَ الجَبَلُ الَّذي لَولا ذُراهُ","إِذاً وَقَعَت عَلى الأَرضِ السَماءُ",6,"ا",2,0],["هُوَ الجَبَلُ الراسي الَّذي اِعتَرَفَت لَهُ","رِجالُ نِزارٍ وَهيَ راغِمَةٌ صُفرُ",7,"ر",1,0],["هُوَ الجَبَلُ الأَعلى الَّذي تَرتَقي بِهِ","تَميمٌ عَلى الأَعداءِ تَخطِرُ صيدُها",8,"د",3,0],["هُوَ الجوادُ الذي لولا مكارمُه","لم يُعَرفِ الجُودُ في الدنيا ولم يُنَلِ",9,"ل",1,0],["هو الجبلُ الأشمُّ حِمىً وعِزّاً","ترَفَّعْ أن تَرى جبلاً مُغارا",10,"ر",2,0],["هُوَ الجَوادُ الَّذي يُعطيكَ نائِلَهُ","عَفواً وَيُظلَمُ أَحياناً فَيَظَّلِمُ",11,"م",1,0],["هُوَ الجَوادُ فَإِن يَلحَق بِشَأوِهِما","عَلى تَكاليفِهِ فَمِثلُهُ لَحِقا",12,"ق",2,0],["هو الجِدُّ لا عُذْرَ للهازلين","ولا حقَّ إن غَلَب الباطلُ",13,"ل",1,1],["هو الجلاءُ وإن رِيعت له فئةٌ","يَودُّ ساداتُها لو أنَّهم خَدَمُ",14,"م",1,0],["هو الجلاءُ فمن يَطْلُبْ به بدلاً","فما وَفىَ لبني مصرٍ ولا نصحا",15,"ح",2,0],["هو الجدُّ الشَّقِيُّ عَلاهُ جَدٌّ","تَلَقَّى نِعمةً وأصابَ نُجْحا",16,"ح",2,0],["هو الجلاءُ لقومٍ لا حُلومَ لهم","ساؤوا مُقاماً وساؤوا بعدُ مُرتَحلا",17,"ل",2,0],["هُوَالجَديدُ فَيَطويهِ الزَمانُ بِلىً","وَيُرجِعُ الدَهرُ إِظلاماً بِإِظلامِ",18,"م",1,0],["هُوَ الجهل أخَّرنا وحده","فَلا النار ضارت ولا السيف ضاما",19,"م",2,0],["هو الجدّ حتّى تفضل العين أختها","وحتّى يكون اليوم لليوم سيّدا",20,"د",2,0],["هو الجيش طهَّرَ أرضَ البلادِ","وجمَّعَ شملَ الحمى فانتظمْ",21,"م",1,0],["هو الجوادُ بما في كفِّه، فإِذا","سألتَهُ درهمًا للشعب لم يَجُدِ",22,"د",1,0],["هو الجبل الراسي؛ حجًا، ورزانةً","إذا الحادثُ الطاغي أقام وأقعدا",23,"د",2,0],["هو الجوادُ الذي في مهله سبقا","سبق الجياد إذا الجياد قد سبقوا",24,"ق",3,0],["هُو الجَهلُ يَأبَى المُحتَسِى مَرخدِيَّهُ","إِذَا سُمتَهُ التَّقوِيمَ أن يَتَقَوَّمَا",25,"م",2,0],["هوالجوهرُ الباقي هو الحظّ والنهى","إذا صحّ ينجي من هوى ويعيد",26,"د",1,0],["هو الجيش لولا ان فيهِ شجاعةً","تساوت حصون عندها وخدورُ",27,"ر",1,0],["هو الجسم من غير روح مثال","هو الروح من غير جسم خيال",28,"ل",1,0],["هو الجيشُ يمشي فيلقاً تلوَ فيلقٍ","لحوطِ الضواحي أو لخوضِ الوقيعة",29,"ه",1,0],["هو الجبلُ العالي الذي البحرُ تحتَهُ","يُكسّرُ أمواجاً على الساحل الأخضر",30,"ر",1,0],["هُوَ الجَامِعُ الإحْسانَ والحُسْنَ والذي","أَقَرَّ لهُ زَيْدٌ وَعَمْرٌو وَخالِدُ",31,"د",1,0],["هُوَ الجَوهَر الفَرد الَّذي قَد تَعدّدت","مَزاياه فَضلاً وَهوَ لا يَتَعدّدُ",32,"د",1,0],["هُوَ الجَوهَرُ الأَعلى وَما قَد رَأَيتُهُ","مِنَ الجَوهَرِ الأَعلى هُوَ العَرَضُ الأَدنى",33,"ن",2,0],["هو الجنة الكبرى وفردوسها الذي","يتوق إلى مأواه كلُّ مبارك",34,"ك",1,0],["هو الجليس الذي يصحبك في سفر","وكل شانك قاصيها ودانيها",35,"ي",3,0],["هو الجبل البحر الذي بعلومه","جميع الورى ما بين مُفْتٍ ومقتدي",36,"د",2,0],["هوَ الجَبَل العالي الَّذي شُرُفاته","تَعَلّى عَلى أُسِّ النُجومِ النَواجِمِ",37,"م",1,0],["هوَ الجَريء عَلى مالٍ يَجودُ بِهِ","وَالكُرُّ في الجودِ مثل الكرِّ في البُهَمِ",38,"م",1,0],["هو الجوادُ الذي يلقَاهُ مادحُهُ","وإن غَلا فوقَ ما أثْنَى وما وَصَفَا",39,"ف",2,1],["هُوَ الجَبَلُ الَّذي كانَت نِزارٌ","تَهدُّ مِنَ العَدُوِّ بِهِ الجِبالا",40,"ل",2,0],["هو الجبل الأشمّ من الرَّواسي","تخرُّ له الجبال الشمُّ هدَّا",41,"د",2,0],["هو الجنبلاطي البشير الذي روت","خلايقه ان الفخار مغانمه",42,"م",2,0],["هو الجوهر المكنون دلّت صفاته","عليه كما دل السحاب على البر",43,"ر",1,0],["هو الجنب لاطي فيه معن وحاتم","وفي الجنب لاطيّ بل الجود ناشر",44,"ر",1,0],["هوَ الجِهادُ الَّذِي بَرَّتْ مَشاهِدُهُ","فَأُشهِدَتْهُ الكِرامُ الصَّفْوَةُ البَرَرَهْ",45,"ر",2,0],["هو الجَذْع فاستقبل به بَكرَ عامه","وإن كان مما كرَّ في سنِّ قارحِ",46,"ح",1,0],["هو الجواد وسُحُبُ الجو حابسةٌ","وضاربُ الهام والجأواءُ تضطرمُ",47,"م",1,0],["هو الجرب المرهوب أن حارب العدى","بآرائه وهو السلامة في السلم",48,"م",1,0],["هو الجبن لا كان للحر وصفا","فكم ساق وحشا إلى الأسد",49,"د",1,0],["هو الجوابُ الّذي ردّ السؤالَ به","لسائلٍ مَن كعبدِ اللَّهِ أو كعَلي",50,"ل",2,0],["هو الجذع المربي على كل قارح","سبوح وما يرضي بسبق لداته",51,"ت",2,0],["هو الجوهر الغالي عن البحر خبِّرْنا","على صحبنا غنت فِصاحُ طيورِنا",52,"ا",1,0],["هُوَ الجديرُ بتقديمِ الثَّناءِ لهُ","إذ كانَ في العُرْبِ فرداً مالهُ ثانِ",53,"ن",1,0],["هو الجوهرُ الفردُ المعرَّفُ شخصُهُ","بنَوعِ السجايا ليسَ بالجنِسِ والفَصلِ",54,"ل",1,0],["هو الجَدُّ خذه إِن أَردت مسلِّما","ولا تطلبِ التعليلَ فالأَمرُ مُبْهَمُ",55,"م",1,0],["هُوَ الجَدُّ حَتّى البُعدَ لِلقُربِ سابِقُ","وَحَتى الخَوافي خَلفَهُنَّ القَوادِمُ",56,"م",1,0],["هُوَ الجامِعُ الطايم العُبابُ بِوَقتِهِ","يُحاكي بِهِ عَمّارَهُ لَجَّ أَبحُرِ",57,"ر",1,0],["هو الجبل الراسي تصدع ركنه","فللأرض ميد بعده بالزلازل",58,"ل",1,0],["هو الجَمالُ جزاكَ اللهُ صالحةً","لو أنّه كان موصولاً بسِربالِ",59,"ل",1,0],["هُوَ الجَوهر الفَرد الأَمير الَّذي لَهُ","أَياد عَلى الأَيام لَيسَ لَها حَصر",60,"ر",1,0],["هو الجاعِلُ الهَيْجَا حَشاً وسِنَانَهُ","هَوىً فَهْوَ لا يَعْدُو قُلُوبَ كُمَاتِها",61,"ت",3,0],["هو الجنَّة في الأرض","أفي الجنَّةِ أُغلُوطَه",62,"ط",2,0],["هوَ الجَوهَرُ الفردُ المَصونُ عَنِ الّذي","يُماثلُه وهوَ الطّرازُ المذهَّبُ",63,"ب",1,0],["هوَ الجَهْبَذُ النحريرَ وَالعالِمُ الّذي","تَحقّق بِالتّحريرِ مِن قَبلِ أَن يُلفى",64,"ف",2,0],["هوَ الجَوهَرُ المَظروفُ في المَجدِ وَالعُلى","وَلَم تَكُنِ العَلياءُ إِلّا لَهُ ظَرفا",64,"ف",2,0],["هو الجهبَذُ المِفْضال ذو الفِطنة التي","تكاد بلا فِكرٍ تضيء وتُنْوِرُ",65,"ر",1,0],["هُوَ الجَوهرُ الَّذي دونَهُ الوَرى","غَدَت عَرضاً يَفنى فَلَيسَ لَهُ مِثلُ",66,"ل",1,0],["هُوَ الْجَوْهَرُ الشَّفَّافُ يَدْرِيه مَنْ نَقَدْ","وَلَوْلاَهُ فِي سِلْكِ النُّبُوَّةِ مَا انْعَقَدْ",67,"د",1,0],["هو الجحفل اليوم ذاتاً ولا","يرد مقاصدَه الجحفلُ",68,"ل",1,0],["هُوَ الجَوْهَرُ الأسِنَى النَّفِيسُ وَغَيْرُهُ","إذَا عُدَّ فهْوَ النَّكْسُ وَالعرْضُ وَالسَّقْطُ",69,"ط",1,0],["هوَ الجوادُ وما عاينت من سمنٍ","سواه فهوَ إِذا اِستيقنته ورمُ",70,"م",1,0],["هو الجنبلاطيُّ البشير الفتى الذي","هو الركن فيه طود لبنان يعمرُ",71,"ر",1,0],["هو الجَوْهرُ الفَرْدُ الّذي لم أُثنِّهِ","فما بالُهُ لم يُجنِني شَمْلَ جَمْعِهِ",72,"ع",2,0],["هو الجواد في الندى وفي الوغا","فالصارم القطاع في المضارب",73,"ب",1,0],["هو الجامع الأسماء جمع تحقق","ومشكاة مصباح الصفات الجليلة",74,"ه",1,0],["هو الجامع الأسرار في جيب سره","هو المشرق الأسرار في أي وجهة",74,"ه",1,0],["هو الجدّ حتّى يفني الرّجل الجدّا","هو الحزم حتّى يبلغ الحازم القصدا",75,"د",2,1],["هو الجدُّ لا غَفَلاتُ الملوكِ","بين الأَناةِ وبين العَجَل",76,"ل",1,0],["هو الجهل فينا حشدته لحكمة","يد اللَه تنكيلاً بشعب مدوق",77,"ق",1,0],["هو الجهبذ النقاد والصدر كهفنا","وحيد السجايا والخلال كريم",78,"م",1,0],["هُوَ الجَوادُ الَّذي إِحسانُهُ سَرَفٌ","وَمالُهُ لِذَوي الآمالِ مَبذُولُ",79,"ل",1,0],["هو الجاعلُ الهَيجا هشاً وسنانهُ","هوىً فَهوَ لا يَعدُو قُلُوب كماتِها",80,"ت",3,0],["هو الجليُّ الخفيُّ في تصرُّفه","فليس يظهر منه غيرُ ما ظهرا",81,"ر",2,0],["هو الجديد الذي الايجاد عينه","في كلّ آن مع الأنفاس يخلقه",82,"ق",2,0],["هو الجدير بما أثني عليه لما","أراه من لطف معناه واشهده",83,"د",2,0],["هو الجوهر الفرد الذي حيَّر النهى","وأوصافهُ تُملى علينا وتُكتب",84,"ب",1,0],["هُوَ الجَوابُ عَن المُعَارِضِ إذ به الدَّ","عوَى تَتِمُّ سَلِيمَةَ الأركَانِ",85,"ن",1,0],["هو الجواد الذي سارت مكارمه","شرقاً وغرباً وصارت فيهما مثلا",86,"ل",2,1],["هو الجذامى نَسَباً ومالِكى","بِمَذهَبِ أسكَندَرِىٌ مَسلَكى",87,"ك",2,0],["هو الجنْدبي المعربي الذي به","شَرُفنَ القوافي القريض المفوّف",88,"ف",1,0],["هُوَ الجمود إِذا درَّت مَخالفها","فَأَركن إِلَيها والا أضرب بِها الثَعبا",89,"ب",2,0],["هو الجواد الذي جلى فلا عجب","إذا الجبال له جزت نواصيها",90,"ي",3,0],["هُوَ الجَلاءُ الَّذي يَجتَثُّ أَصلَكُمُ","فَمَن رَأى مِثلَ ذا رَأياً وَمَن سَمِعا",91,"ع",2,0],["هو الجبل الذي ارتكزت زماناً","عليه سياسة الجبل الكبير",92,"ر",1,0],["هو الجنس إلا أنه ليس خارجاً","تعد له الأفراد كالكوكب الدري",93,"ر",2,0],["هُوَ الجَبَلُ الرَّاسِي وَقاراً وَهَيبَةً","وَحَزماً وَعَزماً مَع سِياسَةِ أَلمَعِي",94,"ع",2,0],["هو الجمال الذي غابت مطالعه","فاظلم الروض منها واختفى العيد",95,"د",1,0],["هو الجيلِيُ المشهورُ في كل بلدةٍ","ونائبُ خير الخلق ذو الكرم الغمرِ",96,"ر",1,0],["هُوَ الجَبَل الراسي إِذا طاشَ طائش","وَخفت حلوم الصَيد في الفر وَالكَر",97,"ر",1,0],["هُوَ الجَواد الَّذي قامَت لَهُ حجج","عَلى فضَائل قَد أَربَت عَلى الحجج",98,"ج",1,0],["هو الجليل الجزيل الفضل من قصرت","عن مبتداه الملا عرب واعجام",99,"م",1,0],["هو الجاني وما للعدل ذنب","ولا لقضاتهِ فيما جناه",100,"ه",1,1],["هو الجسد البالي وإن كان ساجنا","سنتركه ذاك الرميم على النعش",101,"ش",1,0],["هو الجد أو فارجع بصفقة خاسر","وما الناس إلا ذو رباح وخاسر",102,"ر",1,0],["هو الجد فليمس الفتى في ظلاله","فلو أخطأ المجدود قيل أصابا",103,"ب",2,0],["هو الجوهر الفرد الذي ليس تنتهي","له قسمة المجموع من فضله المفرد",104,"د",1,0],["هو الجوهر الفرد الذي ضاء أصله","بفرع تحلى صدره بفري