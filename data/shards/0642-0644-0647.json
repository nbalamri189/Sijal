{"poems":[[66,"أقلل المزح في الكلام احترازا","https://www.aldiwan.net/poem38585.html","الخفيف"],[97,"رسم الحبيبِ الأول","https://www.aldiwan.net/poem24407.html","مجزوء الكامل"],[105,"قل ما أردت فما عليك جناح","https://www.aldiwan.net/poem42081.html","الكامل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140894",""],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54194","الخفيف"],[106,"الركب المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=179288",""],[122,"هات اسقنيها يا غلام","https://www.aldiwan.net/poem23753.html","مجزوء الكامل"],[167,"خلياني من وطاء ووساد","https://www.aldiwan.net/poem1619.html",""],[184,"أكرمت سنوري وأحببته","https://www.aldiwan.net/poem43744.html","السريع"],[187,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[397,"حينما يكون البحر شاهداً","https://www.aldiwan.net/poem6727.html","عموديه"],[441,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[477,"ناشدتك الله في فتاك","https://www.aldiwan.net/poem36919.html","مخلع البسيط"],[477,"قبر ابن آدم أيا زرته انتدبا","https://www.aldiwan.net/poem36940.html","البسيط"],[477,"هب لي بيانك في ممدوحك الهادي","https://www.aldiwan.net/poem36957.html","البسيط"],[477,"لله كل يرجع","https://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[477,"طلل يلوح من الضمير ضئيلا","https://www.aldiwan.net/poem37066.html","الكامل"],[477,"قل هكذا مد الشباك","https://www.aldiwan.net/poem37068.html","مجزوء الكامل"],[477,"قل هكذا الشعر ترتاح النفوس له","https://www.aldiwan.net/poem37190.html","البسيط"],[477,"في الجد أو في اللعب","https://www.aldiwan.net/poem37612.html","مجزوء الرجز"],[477,"يا أمة شهد الكتاب بفضلها","https://www.aldiwan.net/poem37623.html","الكامل"],[480,"قلها كلنا عالم بأن فينا","https://www.aldiwan.net/poem24374.html","عموديه"],[556,"قل هو الله أحد","https://www.aldiwan.net/poem34576.html","مجزوء الرمل"],[561,"أحداج تلك الجمال","https://www.aldiwan.net/poem13601.html","المجتث"]],"verses":[["قِلَّةُ السَمِّ لا تَضُرُّ وَقَد يَق","تُلُ مَعَ فَرطِ أَكلِهِ الدِرياقُ",0,"ق",1,0],["قل هل تركتُك مرةً","بالدمعِ غير مبلّلِ",1,"ل",1,0],["قُلْها مُحَبَّبَةَ الرَّنينِ شهيّةً","تمضِي فتبعث من رجاء الوادي",2,"ي",1,0],["قلة ناصرٍ؛ جوزيت عني","بشرٍّ منك ياشر الدهور",3,"ر",1,0],["قِلَّةٌ دَكَّتْ الْحُصون وبَثَّتْ","رِعْدَةَ الرُّعبِ في الْخِضَمِّ العَديِدِ",4,"د",1,0],["قِلَّةٌ لكنها في عزمةٍ","لا قليلٌ ذَرْعُها أو مُتنَاه",5,"ا",2,0],["قل هل رأيت سوى","حياة ثم يعقبها حمام",6,"م",1,0],["قِلّةُ المالِ وَكُثرٌ في العِدى","وَاِبنُ عَمٍّ رَأيُهُ غَيرُ السَدادِ",7,"د",1,0],["قلّة إنصاف بني آدم","علمني حبّ السنانير",8,"ر",1,0],["قُلها تَفُز بأنجحِ الوسائلِ","تَنل رِضا اللَه بخيرٍ شاملِ",9,"ل",1,0],["قُلها مقالة صادقٍ واشهد به","فقلوبنا وعقولنا إصغاء",10,"ا",2,0],["قلة في عسكر صلب النزال","يخدع الفرس بتدبير بهر",11,"ر",1,0],["قل هل أتاك حديث وجدي","يا ربة الحسن هل أتاك",12,"ك",1,0],["قل هكذا في الورى كانت إرادته","ولم يكن غير ما في لوحه كتبا",13,"ب",2,0],["قل هكذا العزم عزم المخلصين له","وهكذا الحق معتز بأمجاد",14,"د",1,0],["قل هكذا إخلاص من","بحياته يتبرع",15,"ع",1,0],["قل هكذا الأهرام يبقى مدفنا","لن ينسفنّه غير إسرافيلا",16,"ل",2,0],["قل هكذا مد الشباك","بيني وما بين الملاك",17,"ك",1,1],["قل هكذا الشعر ترتاح النفوس له","وهكذا الشعرا تبني قوافيها",18,"ي",3,1],["قل هكذا أوصاكما","في دينه عيسى النبي",19,"ب",2,0],["قل هولاء هم الجدود فدونكم","في الرشد سعي أولئك السواس",20,"س",1,0],["قلها كلنا عالم بأن فينا","نعمة ساعدت بها الأقدار",21,"ر",1,1],["قل هو الله أحد","ليس في الكون أحد",22,"د",1,1],["قُل هاتِ أَعطِ كَنَفسي","فَما ثَوابُ كَمالِ",23,"ل",1,0]]}