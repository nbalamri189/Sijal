{"poems":[[66,"أقلل المزح في الكلام احترازا","https://www.aldiwan.net/poem38585.html","الخفيف"],[97,"رسم الحبيبِ الأول","https://www.aldiwan.net/poem24407.html","مجزوء الكامل"],[105,"قل ما أردت فما عليك جناح","https://www.aldiwan.net/poem42081.html","الكامل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140894",""],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54194","الخفيف"],[106,"الركب المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=179288",""],[108,"يا صاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=8399",""],[124,"هات اسقنيها يا غلام","https://www.aldiwan.net/poem23753.html","مجزوء الكامل"],[169,"خلياني من وطاء ووساد","https://www.aldiwan.net/poem1619.html",""],[186,"أكرمت سنوري وأحببته","https://www.aldiwan.net/poem43744.html","السريع"],[189,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[400,"حينما يكون البحر شاهداً","https://www.aldiwan.net/poem6727.html","عموديه"],[443,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[479,"ناشدتك الله في فتاك","https://www.aldiwan.net/poem36919.html","مخلع البسيط"],[479,"قبر ابن آدم أيا زرته انتدبا","https://www.aldiwan.net/poem36940.html","البسيط"],[479,"هب لي بيانك في ممدوحك الهادي","https://www.aldiwan.net/poem36957.html","البسيط"],[479,"لله كل يرجع","https://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[479,"طلل يلوح من الضمير ضئيلا","https://www.aldiwan.net/poem37066.html","الكامل"],[479,"قل هكذا مد الشباك","https://www.aldiwan.net/poem37068.html","مجزوء الكامل"],[479,"قل هكذا الشعر ترتاح النفوس له","https://www.aldiwan.net/poem37190.html","البسيط"],[479,"في الجد أو في اللعب","https://www.aldiwan.net/poem37612.html","مجزوء الرجز"],[479,"يا أمة شهد الكتاب بفضلها","https://www.aldiwan.net/poem37623.html","الكامل"],[482,"قلها كلنا عالم بأن فينا","https://www.aldiwan.net/poem24374.html","عموديه"],[558,"قل هو الله أحد","https://www.aldiwan.net/poem34576.html","مجزوء الرمل"],[563,"أحداج تلك الجمال","https://www.aldiwan.net/poem13601.html","المجتث"]],"verses":[["قِلَّةُ السَمِّ لا تَضُرُّ وَقَد يَق","تُلُ مَعَ فَرطِ أَكلِهِ الدِرياقُ",0,"ق",1,0],["قل هل تركتُك مرةً","بالدمعِ غير مبلّلِ",1,"ل",1,0],["قُلْها مُحَبَّبَةَ الرَّنينِ شهيّةً","تمضِي فتبعث من رجاء الوادي",2,"ي",1,0],["قلة ناصرٍ؛ جوزيت عني","بشرٍّ منك ياشر الدهور",3,"ر",1,0],["قِلَّةٌ دَكَّتْ الْحُصون وبَثَّتْ","رِعْدَةَ الرُّعبِ في الْخِضَمِّ العَديِدِ",4,"د",1,0],["قِلَّةٌ لكنها في عزمةٍ","لا قليلٌ ذَرْعُها أو مُتنَاه",5,"ا",2,0],["قلّه تراني متّبع ملّة هلي","ونفسي على الشهوات .. ماهي جايعه",6,"ع",2,0],["قل هل رأيت سوى","حياة ثم يعقبها حمام",7,"م",1,0],["قِلّةُ المالِ وَكُثرٌ في العِدى","وَاِبنُ عَمٍّ رَأيُهُ غَيرُ السَدادِ",8,"د",1,0],["قلّة إنصاف بني آدم","علمني حبّ السنانير",9,"ر",1,0],["قُلها تَفُز بأنجحِ الوسائلِ","تَنل رِضا اللَه بخيرٍ شاملِ",10,"ل",1,0],["قُلها مقالة صادقٍ واشهد به","فقلوبنا وعقولنا إصغاء",11,"ا",2,0],["قلة في عسكر صلب النزال","يخدع الفرس بتدبير بهر",12,"ر",1,0],["قل هل أتاك حديث وجدي","يا ربة الحسن هل أتاك",13,"ك",1,0],["قل هكذا في الورى كانت إرادته","ولم يكن غير ما في لوحه كتبا",14,"ب",2,0],["قل هكذا العزم عزم المخلصين له","وهكذا الحق معتز بأمجاد",15,"د",1,0],["قل هكذا إخلاص من","بحياته يتبرع",16,"ع",1,0],["قل هكذا الأهرام يبقى مدفنا","لن ينسفنّه غير إسرافيلا",17,"ل",2,0],["قل هكذا مد الشباك","بيني وما بين الملاك",18,"ك",1,1],["قل هكذا الشعر ترتاح النفوس له","وهكذا الشعرا تبني قوافيها",19,"ي",3,1],["قل هكذا أوصاكما","في دينه عيسى النبي",20,"ب",2,0],["قل هولاء هم الجدود فدونكم","في الرشد سعي أولئك السواس",21,"س",1,0],["قلها كلنا عالم بأن فينا","نعمة ساعدت بها الأقدار",22,"ر",1,1],["قل هو الله أحد","ليس في الكون أحد",23,"د",1,1],["قُل هاتِ أَعطِ كَنَفسي","فَما ثَوابُ كَمالِ",24,"ل",1,0]]}