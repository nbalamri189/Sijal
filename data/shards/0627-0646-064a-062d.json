امل"],[62,"إن يحل دهر أو يمر فإنني","https://www.aldiwan.net/poem52313.html","الكامل"],[28,"كيف ببيت قريب منك مطلبه","https://www.aldiwan.net/poem5081.html","البسيط"],[28,"إني حلفت بصارع لابن له","https://www.aldiwan.net/poem5441.html","الكامل"],[28,"إني كتبت إليك ألتمس الغنى","https://www.aldiwan.net/poem5513.html","الكامل"],[28,"قد بلغنا على مخشاة أنفسنا","https://www.aldiwan.net/poem5633.html","البسيط"],[28,"إني حلفت برب البدن مشعرة","https://www.aldiwan.net/poem5646.html","البسيط"],[49,"كل إلى الرحمن منقلبه","https://www.aldiwan.net/poem10384.html","السريع"],[66,"إن يحبسوك فإن جودك سائر","https://www.aldiwan.net/poem38507.html","الكامل"],[66,"أسلبن من فوق النهود ذوائبا","https://www.aldiwan.net/poem41382.html","الكامل"],[105,"إني نظرت إلى الحوادث نظرة","https://www.aldiwan.net/poem43376.html","الكامل"],[81,"طاول بجدك فالأقدار عنوان","https://www.aldiwan.net/poem61481.html","البسيط"],[52,"سار الرفيق لقصده وتلبثا","https://www.aldiwan.net/poem27183.html","الكامل"],[52,"فك حرا للوجد قيد البكاء","https://www.aldiwan.net/poem27332.html","الخفيف"],[67,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[75,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[48,"خلق الشباب وشرتي لم تخلق","https://www.aldiwan.net/poem64445.html","الكامل"],[48,"إني حممت ولم أشعر بحماكا","https://www.aldiwan.net/poem64467.html","البسيط"],[50,"إن يحسدوني فإني غير لائمهم","https://www.aldiwan.net/poem63897.html","البسيط"],[50,"يا عبد ضاق بحبكم جلدي","https://www.aldiwan.net/poem63920.html","الكامل"],[50,"تعجبت جارتي مني وقد رقدت","https://www.aldiwan.net/poem63950.html","البسيط"],[46,"يضحي الفتى المرؤوس بالسيد ال","https://www.aldiwan.net/poem23415.html","السريع"],[46,"طودان قالا زل غفرانا","https://www.aldiwan.net/poem23492.html","السريع"],[1,"إن امرأ سرف الفؤاد يرى","https://www.aldiwan.net/poem34015.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85484","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/142131","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55067","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55085","الكامل"],[106,"«جحا» وقريبه","https://www.poetsgate.com/ViewPoem.aspx?id=179539",""],[90,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[91,"أيّها القلم","https://www.poetsgate.com/ViewPoem.aspx?id=53239",""],[28,"ليست ترد ديات من قد قتلت","https://www.poetsgate.com/ViewPoem.aspx?id=22086",""],[29,"أقفرتِ البلخُ من عيلانَ فالرحبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17432&r=&rc=5",""],[115,"لذ بالرفاعي الحسيني الذي","https://www.aldiwan.net/poem41070.html","عموديه"],[115,"يا احمد الاولياء العارفين ويا","https://www.aldiwan.net/poem41120.html","عموديه"],[127,"يا دار أسماء بين السفح فالرحب","https://www.aldiwan.net/poem24220.html","البسيط"],[160,"هكذا فلتكن إلى الغلمان","https://www.aldiwan.net/poem58854.html","الخفيف"],[164,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[229,"إن يحسد الصبح إشراقي فمعذور","https://www.aldiwan.net/poem51080.html","البسيط"],[229,"ما قال أوه لفقده واها","https://www.aldiwan.net/poem51256.html","المنسرح"],[262,"يا ابن عم النبي دعوة شيخ","https://www.aldiwan.net/poem68212.html","الخفيف"],[285,"بشرى السلامة أشرقت","https://www.aldiwan.net/poem39378.html","مجزوء الكامل"],[328,"رقرقت فيك ملاحني وغنائي","https://www.aldiwan.net/poem54944.html","الكامل"],[405,"هل أنت شار لنفسي من رسيس جوى","https://www.aldiwan.net/poem49939.html","البسيط"],[406,"حكم المنية في البرية جاري","https://www.aldiwan.net/poem50178.html","الكامل"],[409,"إن يحسدوا في السلم من","https://www.aldiwan.net/poem32175.html","مجزوء الكامل"],[416,"عيدي بيوم شفائكم لسقامي","https://www.aldiwan.net/poem54014.html","الكامل"],[420,"وفي الظعائن والأحداج أحسن من","https://www.aldiwan.net/poem4862.html","البسيط"],[441,"حتى متى أنا بين الجد واللعب","https://www.aldiwan.net/poem14347.html","البسيط"],[441,"هذي نهاية وقع الحادث الجلل","https://www.aldiwan.net/poem14475.html","البسيط"],[443,"أما لقربك بعد الهجر ميعاد","https://www.aldiwan.net/poem55954.html","عموديه"],[449,"بوركت من نهضة","https://www.aldiwan.net/poem975.html",""],[453,"الحب والحسن والأمان","https://www.aldiwan.net/poem61245.html","مخلع البسيط"],[458,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[468,"كم من فتى تسفر أفعاله","https://www.aldiwan.net/poem59973.html","السريع"],[479,"تونسي وحسبي","https://www.aldiwan.net/poem37610.html","مجزوء الخفيف"],[514,"عرج على البان وانشد في مجانيه","https://www.aldiwan.net/poem20803.html","البسيط"],[515,"فاعلم وأنت بما أريد مقاله","https://www.aldiwan.net/poem12268.html","الكامل"],[538,"يا أيها المولى الذي بوجوده","https://www.aldiwan.net/poem47952.html","عموديه"],[553,"يا نظرة نلتها على حذر","https://www.aldiwan.net/poem68365.html","المنسرح"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[586,"قف بالركائب أو سقها بترتيب","https://www.aldiwan.net/poem17440.html","البسيط"]],"verses":[["إِنّي حَلَفتُ بِأَيدي الراقِصاتِ ضُحىً","وَبِالحَجيجِ وَما لَبّوا وَما جَمَروا",0,"ر",3,0],["إِن يَحكِ ثَغرَكِ دَمعي حِينَ أَسفَحُهُ","فَإِنَّني جُدتُ لِلمَحكيِّ بِالحاكي",1,"ي",1,0],["إِنّي حَلَلتُ رِحابَهُ","فَنَزَلتُ أَكرَمَ مَنزِلِ",2,"ل",1,0],["أَنّى حَلَلتُ أَرى عَلَيكَ مَآتِماً","فَلِمَن أُوَجِّهُ فيكَ حُسنَ عَزائي",3,"ا",2,0],["أَنّى حَلَلتُم في البِلا","دِ لَكُم مِنَ الإِصلاحِ آيَه",4,"ا",3,0],["إِنْ يَحْتَجِبْ لَكَ وَجْهٌ يَا حُسَيْنُ فَقَدْ","تَرَكْتَ لِلرَّأْيِ وَجْهاً غَيْرَ مُحْتَجِبِ",5,"ب",1,0],["إِنّي حُسِدتُ فَزادَ اللَهُ في حَسَدي","لا عاشَ مَن عاشَ يَوماً غَيرَ مَحسودِ",6,"د",1,1],["إن يحملوك على الكواهل طالما","قد كنت محمولاً على الأحداقِ",7,"ق",1,0],["أَنّى حَلَلتُ فَإِنَّما","يَدعونِيَ السَيفُ المُحَلّى",8,"ل",2,0],["إِنّي حَفِظتُ وُصاةُ مَن هُوَ عالِمٌ","لَمّا عَلَتني كَبرَةٌ وَمَشيبُ",9,"ب",1,0],["إِنّي حَلَفتُ يَميناً غَيرَ كاذِبَةٍ","لَو كانَ لِلحارِثِ الجَفنِيِّ أَصحابُ",10,"ب",1,1],["إن يحلُ عندي مشتهى أبوابه","فلقد حلا من سكّر هرَماها",11,"ه",2,0],["إن يحارِبْكُمُ من الأرض خطبٌ","فله في السماء قِرنٌ ثَبوتُ",12,"ت",1,0],["إني حمدتُكُمُ والذمُّ حقكُمُ","لمَّا جعلْتم إلى الرحمنِ مُنْقَطعي",13,"ع",2,0],["إن يحمني بيض المشيب وشيبه","مرعاي من بيض الشباب وهيفه",14,"ف",2,0],["إِن يَحلُموا عَنكَ فَالأَحلامُ شيمَتُهُم","وَالمَوتُ ساعَةَ يَحمى مِنهُمُ الغَضَبُ",15,"ب",1,0],["إِنّي حَلَفتُ بِرَبِّ الراقِصاتِ وَما","أَضحى بِمَكَّةَ مِن حُجبٍ وَأَستارِ",16,"ر",1,0],["إِنّي حَلِمتُ كَأَنَّما أَنا سائِرٌ","في رَوضَةٍ خَلّابَةٍ غَنّاءِ",17,"ا",2,0],["إِنّي حَسَدتُ عَلى القُرى أَهلَ القُرى","وَغَبَطتُ حَتّى نافِخَ المِزمارِ",18,"ر",1,0],["إِن يَحبِسوا الطائِرَ المَحكِيِّ في قَفَصٍ","فَلَيسَ يُحبَسُ مِنهُ الصَوتُ وَالنَغَمُ",19,"م",1,0],["إِنّي حَلَفتُ يَميناً غَيرَ كاذِبَةٍ","وَقَد حَبا خَلفَها ثَهلانُ فَالنيرُ",20,"ر",1,1],["إِنّي حَلَفتُ عَلى يَمينٍ بَرَّةٍ","لا أَكذِبُ اليَومَ الخَليفَةَ قيلا",21,"ل",2,0],["إِن يَحرِقِ القَلب نَفثٌ مِن مَقالهمُ","فَإِنَّما ذاكَ مِن نارِ القِلى شَرَرُ",22,"ر",1,0],["إِنّي حَذِرتُ عَلَيكَ مِن أُمِّيَّةٍ","رَبَضَت كَجُنحِ الغَيهَبِ المُتَلَبِّدِ",23,"د",1,0],["إِن يَحْلُ دهرٌ أو يَمَرَّ فإِنّنِي","في حالتيهِ مُجْمِلٌ متَجَمِّلُ",24,"ل",1,1],["إِنّي حَلَفتُ وَلَم أَحلِف عَلى فَنَدٍ","فِناءَ بَيتٍ مِنَ الساعينَ مَعمورِ",25,"ر",1,0],["إِنّي حَلَفتُ بِصارِعٍ لِاِبنٍ لَهُ","إِسحاقَ فَوقَ جَبينِهِ المَتلولِ",26,"ل",1,1],["إِنّي حَلَفتُ بِرافِعينَ أَكُفَّهُم","بَينَ الحَطيمِ وَبَينَ حَوضَي زَمزَمِ",27,"م",1,0],["إِنّي حَلَفتُ بِأَعناقٍ مُعَلَّقَةٍ","قَد أُلزِمَت مِن رُؤوسِ النيبِ أَذقانا",28,"ن",2,0],["إِنّي حَلَفتُ بِرَبِّ البُدنِ مُشعَرَةً","وَما بِجُمعٍ مِنَ الرُكبانِ وَالظُعُنِ",29,"ن",1,1],["إِنّي حَلَبتُ الدَهرَ أَشطُرَهُ","فَرَأَيتُهُ لَم يَصفُ لي حَلَبُه",30,"ب",2,0],["إِن يَحبِسوكَ فَإِنَّ جودَكَ سائِرٌ","أَو قَيَّدوكَ فَإِنَّ ذِكرَكَ مُطلَقُ",31,"ق",1,1],["إِن يَحرُسِ الناسُ النُضارَ بِحاجِبٍ","كانَ السَماحُ لِعَينِ مالِكَ حاجِبا",32,"ب",2,0],["إِنّي حَلَلتُ مِنَ الإِلَهِ مَحَلَّةً","تلوي بِيَأسِ الظالِمِ المُتَجَبِّرِ",33,"ر",1,0],["إِن يَحسُدوكَ أَبا العَبّاسِ فَهوَ لَكُم","ذِكرٌ جَميلٌ ولِلحُسّادِ أَشجانُ",34,"ن",1,0],["إِن يَحمِلَ الأَخبارَ يَنقُل نَفسَهُ","حَتّى يَظَلَّ بِسِرِّها مُتَحَدِّثا",35,"ث",2,0],["إِن يَحُل مِن بَيني وَبَينِكَ بَينٌ","فَلَكَم مِن نَأيٍ سَريعِ اللِقاءِ",36,"ا",2,0],["إنْ يُحْيي جُودُكَ لِي أبا دُلَفٍ غَدا","حَيَّا لَهُ فَضْلي أَبَا تَمَّامِ",37,"م",1,0],["إنَّ يحيَى بنَ عليٍّ أهلُ ما","جئتماهُ من جزيلات الأياد",38,"د",1,0],["إِنّي حَلَفتُ عَلَيكَ جَهدَ أَلِيَّةٍ","قَسَماً بِكُلِّ مُقَصِّرٍ وَمُحَلِّقِ",39,"ق",1,0],["إِنّي حُمِمتُ وَلَم أَشعُر بِحُمّاكا","حَتّى تَحَدَّثَ عُوّادي بِشَكواكا",40,"ك",2,1],["إِن يَحسُدوني فَإِنّي غَيرُ لائِمِهِم","قَبلي مِنَ الناسِ أَهلُ الفَضلِ قَد حُسِدوا",41,"د",3,1],["إِني حَلَفتُ أَلِيَّةً صَدَقَت","بِفِناءِ بَيتِ الواحِدِ الصَمَدِ",42,"د",1,0],["إِنّي حَلَفتُ يَميناً غَيرَ كاذِبَةٍ","عِندَ المَقامِ وَلَم أَقرَب لَهُ فَنَدا",43,"د",2,0],["إِن يُحرَمِ السائِلُ عِندي جَداً","فَلَستُ عِندَ اللَهِ بِالحارِمِ",44,"م",1,0],["إِنِّيَ حَيٌّ رانَ ذَنبي عَلى","قَلبي فَما أَنفَكُّ حَيرانا",45,"ن",2,0],["أَنّي حَمِدتُكَ لِلعَشيرَةِ إِذ","جاءَت إِلَيكَ مُرِقَّةَ العَظمِ",46,"م",1,0],["إني حمدت من الدستور طلعته","وَمن شَبيبته شرخاً وَغيدانا",47,"ن",2,0],["إن يحسبوا الطائر المحكّى في قفصٍ","فليس يحبس منه الصوت والنّغم",48,"م",1,0],["إِنْ يُحَقِّقْ قَضِيَّةً فَهْوَ فِيهَا","جَاهد أَوْ يَمَلَّهُ التَّحْقِيقُ",49,"ق",1,0],["إِنْ يَحْجِبُوكَ فَإِنَّ فِكْرَكَ رافِعٌ","نُوراً تُضَاءُ بِهِ سَبِيلُ السَّارِي",50,"ر",2,0],["أَنَّى حَلَلْتِ رعَتْكِ حَضْرَتُهُ فَلاَ","تَأْلِينَهُ بِرّاً وَلاَ يَأْلُوكِ",51,"ك",1,0],["إني حسبتُ «جحا» مجانة ماجنٍ","فإذا به رجلٌ جليل الشانِ",52,"ن",1,1],["ان يُحسَّ الغرامَ قلبي فحقٌّ","خلق اللهُ عَبده لُيحِسّا",53,"س",2,0],["إن يحسبوا الطائر المحكّى في القفص","فليس يحبس منه الصوت والنّغم",54,"م",1,0],["إنّي حَلَفْتُ بِصَارِعٍ لابنٍ لَهُ","إسْحَقَ، فَوْقَ جَبِينِهِ المَتْلُولِ",55,"ل",1,0],["إنْ يَحْلُموا عَنك، الأحلامُ شيمتُهُمْ","والموتُ ساعة َ يحمى منهمُ الغضبُ",56,"ب",1,0],["ان يحسدوا لجدودهم ولجودهم","فهموهمو وعلى الحسود العار",57,"ر",1,0],["ان يحسدوك الأولى انظارهم قصرت","فكم عن الشمس طرف صد مذ قصرا",58,"ر",2,0],["إِنّي حَوَيتُ عَلى الأَقوامِ مَكرَمَةً","قدماً وَحَذَّرَني ما يَتَّقونَ أَبى",59,"ب",2,0],["إِن يحيى ولا يكون كيحيى","فرحة الأوليا وغيظ الشاني",60,"ي",1,0],["إِن يَحم عَن عَيني البُكا تَجَلُّدي","فَالقَلبُ مَوقوفٌ عَلى سُبلِ البُكا",61,"ا",1,0],["إِنّي حَلَبتُ الدَهرَ شَطرَيهِ فَقَد","أَمَرَّ لي حينا وَأَحياناً حَلا",61,"ا",1,0],["إن يحسُد الصبحُ إشراقي فمعذور","بي تُشِرق الشمسُ والأفلاك والنورُ",62,"ر",1,1],["إن يَحْجُبوا وصلَها فما حجبوا","عنِّي سُرَى طيفها وذكراها",63,"ا",3,0],["إن يَحُر عُسرُهُ بِكَفَّيكَ يَوماً","فَبِكَفَّيكَ عُسرُه ويَسَارُه",64,"ر",2,0],["إني حميدي زلا","ل الصدق لا أبدي كدر",65,"ر",1,0],["إن يحكموا فالشاة ذئب وادع","والذئب إن عدلوا صريع الشاء",66,"ا",2,0],["إنَّي حلَفْتُ بما في فيكَ من دُرَرٍ","وما بريقِكَ من أَريٍ ومِنَ شارِ",67,"ر",1,0],["إِن يُحتقر صِغَراً فَرُبٌ مُفَخَّمٍ","يَبدو ضَئيل الشَخصِ لِلنُّظّارِ",68,"ر",1,0],["إن يَحسُدُوا في السِّلمِ مَنْ","زِلتي من العزّ المُنيفِ",69,"ف",1,1],["إنْ يحسُدوك الجاهلون على النهى","لا تحسُدُ الكرماءَ غيرُ لئام",70,"م",1,0],["إِن يَحي ذاكَ فَكُن مِنهُ بِمعزلةٍ","أَو ماتَ ذاكَ فَلا تَشهَدُ لَه جَنَنا",71,"ن",2,0],["إن يحسدوني على فضلي ومعرفتي","فحاسد الفضل في همٍّ وفي تعب",72,"ب",1,0],["إن يحسدوك بنو الأيام في عمل","زاك فذا حين ما تجري على العمل",73,"ل",1,0],["إن يحسب الجاهلون اليوم يومهم","فالعقل فينا له رهط واجناد",74,"د",1,0],["أنى حللت بأرض طاب منبته","نرى بها وارفات الظل أشجارا",75,"ر",2,0],["إن يحرق الناس نثر روض","في حين أوراقه جمان",76,"ن",1,0],["إن يحسدوك فلفرط عجزهم","في المشكلات ولما فيك كملْ",77,"ل",1,0],["إِن يُحسِنِ المَرءُ لَهُ نِيَّةً","كانَ الَّذي نِيَّتُهُ طاهِرَه",78,"ر",2,0],["إن يحب الفرنسي","لا يحب محمد",79,"د",1,0],["إن يحمِلِ الحَمدُ ورداً فهْو قاطِفُه","أو يُجتَنى منه شهدٌ فهْو جانِيهِ",80,"ي",2,0],["إني حسدت على كرامتك التي","من أجلها في كل أرض أكرم",81,"م",1,0],["إني حجَجتُ إلى مقامِكَ حَجَّةَ ال","أشواقِ لا ما يوجِبُ الإسلامُ",82,"م",1,0],["إِن يَحجُبوها عَنِ العُيونِ فَقَد","حَجَبتُ عَيني لَها عَنِ البَشَرِ",83,"ر",1,0],["أن يحكم الحاكم بالكتاب","وسنة النبي بالصواب",84,"ب",1,0],["إن يحْجِبِ الأَضْعَفُ الأَقْوَى فَلاَ عَجَبٌ","فَرُبَّ عَقْلٍ بِسَتْرِ الوَهْمِ مَحْجُوبِ",85,"ب",1,0]]}