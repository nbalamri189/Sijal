8,"عذرا رسول الله ! - صلى الله عليه وسلم -","https://www.poetsgate.com/ViewPoem.aspx?id=201136",""],[5542,"الباحة اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=10055",""],[5542,"حوار بيني وبين أمي","https://www.poetsgate.com/ViewPoem.aspx?id=10059",""],[5598,"وشم على قافية الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=214173",""],[5667,"البحر","https://www.poetsgate.com/ViewPoem.aspx?id=214837",""],[5736,"يا عيد","https://www.poetsgate.com/ViewPoem.aspx?id=208228",""],[5770,"ليلة العيد","https://www.poetsgate.com/ViewPoem.aspx?id=178358",""],[5786,"لعاذلي قلبٌ ولي قلْبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50652",""],[5809,"حسد","https://www.poetsgate.com/ViewPoem.aspx?id=205639",""],[5829,"موت البنفسج","https://www.poetsgate.com/ViewPoem.aspx?id=177034",""],[5842,"يا ربّ عفوك / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=136527",""],[5854,"فصحى اللغات","https://www.poetsgate.com/ViewPoem.aspx?id=208608",""],[5895,"قطرةٌ مِنْ أَنْهَارِ ِالأُمُومَةِ","https://www.poetsgate.com/ViewPoem.aspx?id=198675",""],[5956,"المستنقع","https://www.poetsgate.com/ViewPoem.aspx?id=181944",""],[5956,"بسمة ذات إعجاب بموهبتي","https://www.poetsgate.com/ViewPoem.aspx?id=182292",""],[5956,"حالتان","https://www.poetsgate.com/ViewPoem.aspx?id=183970",""],[5956,"أمضي وآكلُ من أبيات سيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=192102",""],[5956,"من سوف ينقل للخليقة شَهْدي؟","https://www.poetsgate.com/ViewPoem.aspx?id=193360",""],[5956,"إني امرؤ دون السمير أبيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=194267",""],[5956,"عمَّتي العُزَّى نديمة الكريمة وزوجُها فتح الله داوود","https://www.poetsgate.com/ViewPoem.aspx?id=197925",""],[5956,"أ وَلم تضِق ذرعاً بعَون الناس؟","https://www.poetsgate.com/ViewPoem.aspx?id=215974",""],[5975,"يا ظبيةً","https://www.poetsgate.com/ViewPoem.aspx?id=58787",""],[6046,"أنا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=35208",""],[6070,"مِنْ فَرحةِ المَاءِ سارَ الغَيمُ وانتَشَرا","https://www.poetsgate.com/ViewPoem.aspx?id=192068",""],[6152,"الإنسانية جنسية لا جنس","https://www.poetsgate.com/ViewPoem.aspx?id=204601",""],[6152,"إلا غيابكِ لا سبيل عليه 2","https://www.poetsgate.com/ViewPoem.aspx?id=213165",""],[6167,"على شط الأربعين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85485&r=&rc=14",""],[243,"صحيفة الأحرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68182&r=&rc=174",""],[6259,"إن الحمولَ غداة َ غربة غربِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59356&r=&rc=4",""],[454,"بوركت من نهضة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82681&r=&rc=45",""],[6305,"حياتي ... أنْ أموتَ فِداك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87348&r=&rc=22",""],[6305,"حروفي تسكُت في حضرتِك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87352&r=&rc=25",""]],"verses":[["إِنّي حَلَفتُ بِأَيدي الراقِصاتِ ضُحىً","وَبِالحَجيجِ وَما لَبّوا وَما جَمَروا",0,"ر",3,0],["إِن يَحكِ ثَغرَكِ دَمعي حِينَ أَسفَحُهُ","فَإِنَّني جُدتُ لِلمَحكيِّ بِالحاكي",1,"ك",2,0],["إِنّي حَلَلتُ رِحابَهُ","فَنَزَلتُ أَكرَمَ مَنزِلِ",2,"ل",1,0],["أَنّى حَلَلتُ أَرى عَلَيكَ مَآتِماً","فَلِمَن أُوَجِّهُ فيكَ حُسنَ عَزائي",3,"ا",2,0],["أَنّى حَلَلتُم في البِلا","دِ لَكُم مِنَ الإِصلاحِ آيَه",4,"ا",3,0],["إِنْ يَحْتَجِبْ لَكَ وَجْهٌ يَا حُسَيْنُ فَقَدْ","تَرَكْتَ لِلرَّأْيِ وَجْهاً غَيْرَ مُحْتَجِبِ",5,"ب",1,0],["إِنّي حُسِدتُ فَزادَ اللَهُ في حَسَدي","لا عاشَ مَن عاشَ يَوماً غَيرَ مَحسودِ",6,"د",1,1],["إن يحملوك على الكواهل طالما","قد كنت محمولاً على الأحداقِ",7,"ق",1,0],["أَنّى حَلَلتُ فَإِنَّما","يَدعونِيَ السَيفُ المُحَلّى",8,"ل",2,0],["إِنّي حَفِظتُ وُصاةُ مَن هُوَ عالِمٌ","لَمّا عَلَتني كَبرَةٌ وَمَشيبُ",9,"ب",1,0],["إِنّي حَلَفتُ يَميناً غَيرَ كاذِبَةٍ","لَو كانَ لِلحارِثِ الجَفنِيِّ أَصحابُ",10,"ب",1,1],["إن يحلُ عندي مشتهى أبوابه","فلقد حلا من سكّر هرَماها",11,"ه",2,0],["إن يحارِبْكُمُ من الأرض خطبٌ","فله في السماء قِرنٌ ثَبوتُ",12,"ت",1,0],["إني حمدتُكُمُ والذمُّ حقكُمُ","لمَّا جعلْتم إلى الرحمنِ مُنْقَطعي",13,"ع",2,0],["إن يحمني بيض المشيب وشيبه","مرعاي من بيض الشباب وهيفه",14,"ف",2,0],["إِن يَحلُموا عَنكَ فَالأَحلامُ شيمَتُهُم","وَالمَوتُ ساعَةَ يَحمى مِنهُمُ الغَضَبُ",15,"ب",1,0],["إِنّي حَلَفتُ بِرَبِّ الراقِصاتِ وَما","أَضحى بِمَكَّةَ مِن حُجبٍ وَأَستارِ",16,"ر",1,0],["إِنّي حَلِمتُ كَأَنَّما أَنا سائِرٌ","في رَوضَةٍ خَلّابَةٍ غَنّاءِ",17,"ا",2,0],["إِنّي حَسَدتُ عَلى القُرى أَهلَ القُرى","وَغَبَطتُ حَتّى نافِخَ المِزمارِ",18,"ر",1,0],["إِن يَحبِسوا الطائِرَ المَحكِيِّ في قَفَصٍ","فَلَيسَ يُحبَسُ مِنهُ الصَوتُ وَالنَغَمُ",19,"م",1,0],["إِنّي حَلَفتُ يَميناً غَيرَ كاذِبَةٍ","وَقَد حَبا خَلفَها ثَهلانُ فَالنيرُ",20,"ر",1,1],["إِنّي حَلَفتُ عَلى يَمينٍ بَرَّةٍ","لا أَكذِبُ اليَومَ الخَليفَةَ قيلا",21,"ل",2,0],["إِن يَحرِقِ القَلب نَفثٌ مِن مَقالهمُ","فَإِنَّما ذاكَ مِن نارِ القِلى شَرَرُ",22,"ر",1,0],["إِنّي حَذِرتُ عَلَيكَ مِن أُمِّيَّةٍ","رَبَضَت كَجُنحِ الغَيهَبِ المُتَلَبِّدِ",23,"د",1,0],["إِن يَحْلُ دهرٌ أو يَمَرَّ فإِنّنِي","في حالتيهِ مُجْمِلٌ متَجَمِّلُ",24,"ل",1,1],["إِنّي حَلَفتُ وَلَم أَحلِف عَلى فَنَدٍ","فِناءَ بَيتٍ مِنَ الساعينَ مَعمورِ",25,"ر",1,0],["إِنّي حَلَفتُ بِصارِعٍ لِاِبنٍ لَهُ","إِسحاقَ فَوقَ جَبينِهِ المَتلولِ",26,"ل",1,1],["إِنّي حَلَفتُ بِرافِعينَ أَكُفَّهُم","بَينَ الحَطيمِ وَبَينَ حَوضَي زَمزَمِ",27,"م",1,0],["إِنّي حَلَفتُ بِأَعناقٍ مُعَلَّقَةٍ","قَد أُلزِمَت مِن رُؤوسِ النيبِ أَذقانا",28,"ن",2,0],["إِنّي حَلَفتُ بِرَبِّ البُدنِ مُشعَرَةً","وَما بِجُمعٍ مِنَ الرُكبانِ وَالظُعُنِ",29,"ن",1,1],["إِنّي حَلَبتُ الدَهرَ أَشطُرَهُ","فَرَأَيتُهُ لَم يَصفُ لي حَلَبُه",30,"ب",2,0],["إِن يَحبِسوكَ فَإِنَّ جودَكَ سائِرٌ","أَو قَيَّدوكَ فَإِنَّ ذِكرَكَ مُطلَقُ",31,"ق",1,1],["إِن يَحرُسِ الناسُ النُضارَ بِحاجِبٍ","كانَ السَماحُ لِعَينِ مالِكَ حاجِبا",32,"ب",2,0],["إِنّي حَلَلتُ مِنَ الإِلَهِ مَحَلَّةً","تلوي بِيَأسِ الظالِمِ المُتَجَبِّرِ",33,"ر",1,0],["إِن يَحسُدوكَ أَبا العَبّاسِ فَهوَ لَكُم","ذِكرٌ جَميلٌ ولِلحُسّادِ أَشجانُ",34,"ن",1,0],["إِن يَحمِلَ الأَخبارَ يَنقُل نَفسَهُ","حَتّى يَظَلَّ بِسِرِّها مُتَحَدِّثا",35,"ث",2,0],["إِن يَحُل مِن بَيني وَبَينِكَ بَينٌ","فَلَكَم مِن نَأيٍ سَريعِ اللِقاءِ",36,"ا",2,0],["إنْ يُحْيي جُودُكَ لِي أبا دُلَفٍ غَدا","حَيَّا لَهُ فَضْلي أَبَا تَمَّامِ",37,"م",1,0],["إنَّ يحيَى بنَ عليٍّ أهلُ ما","جئتماهُ من جزيلات الأياد",38,"د",1,0],["إِنّي حَلَفتُ عَلَيكَ جَهدَ أَلِيَّةٍ","قَسَماً بِكُلِّ مُقَصِّرٍ وَمُحَلِّقِ",39,"ق",1,0],["إِنّي حُمِمتُ وَلَم أَشعُر بِحُمّاكا","حَتّى تَحَدَّثَ عُوّادي بِشَكواكا",40,"ك",2,1],["إِن يَحسُدوني فَإِنّي غَيرُ لائِمِهِم","قَبلي مِنَ الناسِ أَهلُ الفَضلِ قَد حُسِدوا",41,"د",3,1],["إِني حَلَفتُ أَلِيَّةً صَدَقَت","بِفِناءِ بَيتِ الواحِدِ الصَمَدِ",42,"د",1,0],["إِنّي حَلَفتُ يَميناً غَيرَ كاذِبَةٍ","عِندَ المَقامِ وَلَم أَقرَب لَهُ فَنَدا",43,"د",2,0],["إِن يُحرَمِ السائِلُ عِندي جَداً","فَلَستُ عِندَ اللَهِ بِالحارِمِ",44,"م",1,0],["إِنِّيَ حَيٌّ رانَ ذَنبي عَلى","قَلبي فَما أَنفَكُّ حَيرانا",45,"ن",2,0],["أَنّي حَمِدتُكَ لِلعَشيرَةِ إِذ","جاءَت إِلَيكَ مُرِقَّةَ العَظمِ",46,"م",1,0],["إني حمدت من الدستور طلعته","وَمن شَبيبته شرخاً وَغيدانا",47,"ن",2,0],["إن يحسبوا الطائر المحكّى في قفصٍ","فليس يحبس منه الصوت والنّغم",48,"م",1,0],["إِنْ يُحَقِّقْ قَضِيَّةً فَهْوَ فِيهَا","جَاهد أَوْ يَمَلَّهُ التَّحْقِيقُ",49,"ق",1,0],["إِنْ يَحْجِبُوكَ فَإِنَّ فِكْرَكَ رافِعٌ","نُوراً تُضَاءُ بِهِ سَبِيلُ السَّارِي",50,"ر",2,0],["أَنَّى حَلَلْتِ رعَتْكِ حَضْرَتُهُ فَلاَ","تَأْلِينَهُ بِرّاً وَلاَ يَأْلُوكِ",51,"ك",1,0],["إني حسبتُ «جحا» مجانة ماجنٍ","فإذا به رجلٌ جليل الشانِ",52,"ن",1,1],["ان يُحسَّ الغرامَ قلبي فحقٌّ","خلق اللهُ عَبده لُيحِسّا",53,"س",2,0],["إن يحسبوا الطائر المحكّى في القفص","فليس يحبس منه الصوت والنّغم",54,"م",1,0],["إنّي حَلَفْتُ بِصَارِعٍ لابنٍ لَهُ","إسْحَقَ، فَوْقَ جَبِينِهِ المَتْلُولِ",55,"ل",1,0],["إنْ يَحْلُموا عَنك، الأحلامُ شيمتُهُمْ","والموتُ ساعة َ يحمى منهمُ الغضبُ",56,"ب",1,0],["ان يحسدوا لجدودهم ولجودهم","فهموهمو وعلى الحسود العار",57,"ر",1,0],["ان يحسدوك الأولى انظارهم قصرت","فكم عن الشمس طرف صد مذ قصرا",58,"ر",2,0],["إِنّي حَوَيتُ عَلى الأَقوامِ مَكرَمَةً","قدماً وَحَذَّرَني ما يَتَّقونَ أَبى",59,"ب",2,0],["إِن يحيى ولا يكون كيحيى","فرحة الأوليا وغيظ الشاني",60,"ن",2,0],["إِن يَحم عَن عَيني البُكا تَجَلُّدي","فَالقَلبُ مَوقوفٌ عَلى سُبلِ البُكا",61,"ا",1,0],["إِنّي حَلَبتُ الدَهرَ شَطرَيهِ فَقَد","أَمَرَّ لي حينا وَأَحياناً حَلا",61,"ا",1,0],["إن يحسُد الصبحُ إشراقي فمعذور","بي تُشِرق الشمسُ والأفلاك والنورُ",62,"ر",1,1],["إن يَحْجُبوا وصلَها فما حجبوا","عنِّي سُرَى طيفها وذكراها",63,"ا",3,0],["إن يَحُر عُسرُهُ بِكَفَّيكَ يَوماً","فَبِكَفَّيكَ عُسرُه ويَسَارُه",64,"ر",2,0],["إني حميدي زلا","ل الصدق لا أبدي كدر",65,"ر",1,0],["إن يحكموا فالشاة ذئب وادع","والذئب إن عدلوا صريع الشاء",66,"ا",2,0],["إنَّي حلَفْتُ بما في فيكَ من دُرَرٍ","وما بريقِكَ من أَريٍ ومِنَ شارِ",67,"ر",1,0],["إِن يُحتقر صِغَراً فَرُبٌ مُفَخَّمٍ","يَبدو ضَئيل الشَخصِ لِلنُّظّارِ",68,"ر",1,0],["إن يَحسُدُوا في السِّلمِ مَنْ","زِلتي من العزّ المُنيفِ",69,"ف",1,1],["إنْ يحسُدوك الجاهلون على النهى","لا تحسُدُ الكرماءَ غيرُ لئام",70,"م",1,0],["إِن يَحي ذاكَ فَكُن مِنهُ بِمعزلةٍ","أَو ماتَ ذاكَ فَلا تَشهَدُ لَه جَنَنا",71,"ن",2,0],["إن يحسدوني على فضلي ومعرفتي","فحاسد الفضل في همٍّ وفي تعب",72,"ب",1,0],["إن يحسدوك بنو الأيام في عمل","زاك فذا حين ما تجري على العمل",73,"ل",1,0],["إن يحسب الجاهلون اليوم يومهم","فالعقل فينا له رهط واجناد",74,"د",1,0],["أنى حللت بأرض طاب منبته","نرى بها وارفات الظل أشجارا",75,"ر",2,0],["إن يحرق الناس نثر روض","في حين أوراقه جمان",76,"ن",1,0],["إن يحسدوك فلفرط عجزهم","في المشكلات ولما فيك كملْ",77,"ل",1,0],["إِن يُحسِنِ المَرءُ لَهُ نِيَّةً","كانَ الَّذي نِيَّتُهُ طاهِرَه",78,"ر",2,0],["إن يحب الفرنسي","لا يحب محمد",79,"د",1,0],["إن يحمِلِ الحَمدُ ورداً فهْو قاطِفُه","أو يُجتَنى منه شهدٌ فهْو جانِيهِ",80,"ي",2,0],["إني حسدت على كرامتك التي","من أجلها في كل أرض أكرم",81,"م",1,0],["إني حجَجتُ إلى مقامِكَ حَجَّةَ ال","أشواقِ لا ما يوجِبُ الإسلامُ",82,"م",1,0],["إِن يَحجُبوها عَنِ العُيونِ فَقَد","حَجَبتُ عَيني لَها عَنِ البَشَرِ",83,"ر",1,0],["أن يحكم الحاكم بالكتاب","وسنة النبي بالصواب",84,"ب",1,0],["إن يحْجِبِ الأَضْعَفُ الأَقْوَى فَلاَ عَجَبٌ","فَرُبَّ عَقْلٍ بِسَتْرِ الوَهْمِ مَحْجُوبِ",85,"ب",1,0],["أَن يَحجِبوكَ فَما ضَرَّ النُجومَ دُجىً",