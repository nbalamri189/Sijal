{"poems":[[0,"رب رام من بني ثعل","https://www.aldiwan.net/poem66.html",""],[0,"أحار بن عمرو كأني خمر","https://www.aldiwan.net/poem78.html","المتقارب"],[32,"دنا البين من مي فردت جمالها","https://www.aldiwan.net/poem29539.html","الطويل"],[53,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8499.html","البسيط"],[53,"لعمري لقد أنكرت غير نكير","https://www.aldiwan.net/poem62940.html","الكامل"],[40,"ألم يسأل الركب الديار العوافيا","https://www.aldiwan.net/poem7821.html","الطويل"],[35,"ألا أيها القوم الذين وشوا بنا","https://www.aldiwan.net/poem25911.html","الطويل"],[107,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[74,"","https://poetry.dctabudhabi.ae/diwan/poem/41638","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55243","الرمل"],[56,"","https://poetry.dctabudhabi.ae/diwan/poem/10142","السريع"],[92,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[136,"هذه البئر قنة جار كما أن","https://www.aldiwan.net/poem54835.html","الخفيف"],[139,"أكذا آخر الحياة يكون","https://www.aldiwan.net/poem49161.html","الخفيف"],[234,"غيري رمين ذوات الأعين النجل","https://www.aldiwan.net/poem50856.html","البسيط"],[242,"مظنة إتلاف المحب العواذل","https://www.aldiwan.net/poem18855.html","الطويل"],[463,"من جب غارب هاشم وسنامها","https://www.aldiwan.net/poem55867.html","الكامل"],[484,"كل يترجم عن إحساسه لكمو","https://www.aldiwan.net/poem37057.html","البسيط"],[505,"لا تشوش لك سرا","https://www.aldiwan.net/poem37924.html","مجزوء الرمل"],[505,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[509,"يا من بك التجاء من كان سواك","https://www.aldiwan.net/poem38391.html","عموديه"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126873","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48748","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77569","المجتث"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77598","المتدارك"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96630","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96728","الطويل"],[1056,"","https://poetry.dctabudhabi.ae/diwan/poem/178052","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202075","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136353","الخفيف"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112856","الكامل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/114004","الخفيف"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77902","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77866","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77738","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48225","الوافر"],[2111,"","https://poetry.dctabudhabi.ae/diwan/poem/119244","الرمل"],[2391,"","https://poetry.dctabudhabi.ae/diwan/poem/18053","الوافر"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126201","الخفيف"],[3003,"","https://poetry.dctabudhabi.ae/diwan/poem/126532","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89141","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89118","الرجز"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199021","الرجز"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36743","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59485","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59494","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59471","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59443","المتقارب"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69930","الكامل"],[3975,"","https://poetry.dctabudhabi.ae/diwan/poem/75830","الوافر"],[4238,"","https://poetry.dctabudhabi.ae/diwan/poem/147738","المنسرح"],[4490,"","https://poetry.dctabudhabi.ae/diwan/poem/145773","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72832","البسيط"],[4579,"","https://poetry.dctabudhabi.ae/diwan/poem/205460","الوافر"],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101937","الرجز"],[4755,"بَرْهِنْ بأنكَ ما تَزالُ ضَريرا","https://www.poetsgate.com/ViewPoem.aspx?id=198964",""],[4797,"جمايل وطنا","https://www.poetsgate.com/ViewPoem.aspx?id=178141",""],[592,"أهاجك أم أشجاك رسم المعاهد","https://www.poetsgate.com/ViewPoem.aspx?id=128839",""],[592,"أهاجك رسم بالديار الدوائر","https://www.poetsgate.com/ViewPoem.aspx?id=128849",""],[5582,"أَلا ما لِدَمْعِكَ يَجْرِي طَلَلْ","https://www.poetsgate.com/ViewPoem.aspx?id=187236",""],[5582,"قِفا بِالدِّيارِ وَكُثْبانِها","https://www.poetsgate.com/ViewPoem.aspx?id=187312",""],[5582,"أَرَى رَسْمَ سُعْدَى فِي فُؤادِيَ راسِمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63581",""],[5870,"سَطلُ الغَبَاء","https://www.poetsgate.com/ViewPoem.aspx?id=60864",""],[5887,"رُغمَ الجراح الداميات بغزّةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=27996",""],[5943,"قصيدة في أعضاء موقع العز أحمد عبد الباقي عاشور رح","https://www.poetsgate.com/ViewPoem.aspx?id=34296",""],[5956,"من بعد دعمك حاجتي يا مسلمُ","https://www.poetsgate.com/ViewPoem.aspx?id=194143",""],[6089,"عجبي للعقولِ","https://www.poetsgate.com/ViewPoem.aspx?id=212942",""],[242,"مظنة اتلاف المحب العواذل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563706",""],[6211,"الأرضُ تدورُ، الأرض تبحثُ عني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78497&r=&rc=14",""]],"verses":[["بِرَهيشٍ مِن كِنانَتِهِ","كَتَلَظّي الجَمرِ في شَرَرِه",0,"ر",2,0],["بَرَهرَهَةٌ رَودَةٌ رَخصَةٌ","كَخُرعوبَةِ البانَةِ المُنفَطِر",1,"ر",1,0],["بَرَهبى إِلى رَوضِ القِذافِ إِلى المِعا","إِلى واحِفٍ تَروادُها وَمَجالُها",2,"ل",3,0],["بُرهانُ ذلك أَنْ لا شحمَ يعجبُهُ","وأن شهوتَهُ وَقْفٌ على العَصَبِ",3,"ب",1,0],["برَهْرهةٍ لم تُغْزَ إلا بناعمٍ","ولم تُسقَ من ماءٍ بغير نَمير",4,"ر",1,0],["بِرَهطِ اِبنِ كُلثومٍ بَدَأنا فَأَصبَحوا","لِتَغلِبَ أَذناباً وَكانوا نَواصِيا",5,"ي",2,0],["بَرَهرَهَةٌ كَالشَمسِ في يَومِ صَحوِها","مُنَعَّمَةٌ لَم تَخطُ شِبراً مِنَ الخِدرِ",6,"ر",1,0],["بُرهانُه الوَهَنُ الذي في أعظُمي","ودليلُه الوضَحُ الذي بقذالي",7,"ل",2,0],["برهان دين الله قد أثبته","وجدان معنى الجود في الأزمان",8,"ن",1,0],["بِرَّةٌ لَيْسَ لَها إِلاَّ التُّ","قَى وَالطُّهْرُ إِثْمُ",9,"م",1,0],["بُرهانُ لا تُطرِبُ جُلّاسَها","حَتّى تُريكَ الصَدرَ مَكشوفا",10,"ف",2,1],["بُرهةً ريثما انقضى سمرٌ","تقطرُ لطفاُ أطرافُه وتَطيب",11,"ب",1,0],["بَرَّةٌ يَحمِلُونَ حِينَ تَصَدَّى","سَادَةُ النَّاسِ لاِحتِمَال فِجَارِ",12,"ر",1,0],["برهنتَ للورى الوقائعُ منهُ","أنّ أرواحنا لديه رهونُ",13,"ن",1,0],["برهانُ صِدْقٍ شَفَيتَ الأَولياءَ بِه","وسُقْتُه بين رَيْثِ القَول والعَجَلِ",14,"ل",1,0],["بَرَهْرَةً رَقْرَاقَةً عَذْبَةَ اللَّمَى","ثَوَتْ بِقُصُورِ الْغَرْبِ وَالأَصْلُ بَابِلُ",15,"ل",1,0],["برهانُ حجّتها الذي بَهرَت به","أعداءَها وتقدّمت أعمامَها",16,"م",3,0],["برهان صدقي على ما قلت طلعته","في موكب اليوم فاركض أيها القلم",17,"م",1,0],["بِرُّهُ والعَفْوُ للمُحْ","سِنِ والمُذْنِبِ شاملْ",18,"ل",1,0],["بُرهانُهُ حُجَّةٌ في السِّلكِ قاطِعَةٌ","فيها من القطعِ والإِبْعادِ إِبقاءُ",19,"ا",2,0],["بُرهَانُكَ في الكَمالِ يَكفِي لولاَكَ","لَولاَكَ لَمَا دَارَ مَدارُ الأَفلاك",20,"ك",1,0],["برهانُ فضلكَ ساطعٌ معلوم","فيه اِستنارت أربع ورسومُ",21,"م",1,1],["برهانكم ما تعملو","ن اليوم لا التحف العتيقه",22,"ق",2,0],["برهه وَفار الخلافات","شاف الأسير في حباله",23,"ه",1,0],["برهه وَالديب جاله يعوي","زي الزمارَة المَسحورَه",24,"ر",2,0],["برهرهة لم يدرِ راشفُ ريقها","أَكانَ رضاباً ما ترشّف أم شهدا",25,"د",2,0],["برهرهة تَشكو الخلاخيلُ ساقها","كَما يَشتكي منها الإزارُ المآكما",26,"م",2,0],["برهرهةٌ خود كأن ثيابها","على الشمس تبدو تارةً وتغيب",27,"ب",1,0],["برهانُ علمِك فوقَ بُرْهانُ العَصا","في كلِّ حين غالبٌ لمسَحّر",28,"ر",1,0],["برهن العلم فيه عن كل معنى","متلقى عن الامام المبين",29,"ن",1,0],["برهانه احسانه فرقانه","عالي المكانة عدة المسترشد",30,"د",1,0],["برهيشٍ يمُجُّ زَوَّ المنايا","فمتى ما دعا تُجبهُ المنونا",31,"ن",2,0],["برهانه التَسويف إِن","يسأَله عَن برهانه",32,"ن",2,0],["برهان آل محمد","وَبشير من يَرجو اللقا",33,"ق",2,0],["برهان من خرت له السجود","في أَرسطا واستطهر الصعيد",34,"د",1,0],["بَرَهْرَهَةٌ تُريكَ إِذا أمَالَتْ","إليكَ قَوَامَها غُصْناً قَويما",35,"م",2,0],["برّةٍ تمسحه الدهر","بكّم ووقايه",36,"ا",3,0],["بَرَهرَهَةٌ يَحارُ الطَرفُ فيها","وَتُبدي واضِحاً فَخماً وَسيما",37,"م",2,0],["بَرُّهُمُ حَلَّ فى مَوقِعِ جَورِى","فأبَرَتُ بِرُؤبةٍ وهى رائِبُ",38,"ب",1,0],["برهانه بالصدق يشهد انه","قطب عن الدعوى العريضة عاري",39,"ر",2,0],["برهان مجدك دام في","نعمٍ تقابلها بشكرِكْ",40,"ك",1,0],["برهان مدح منطق اللسانِ","بأنه نتيجة الزمانِ",41,"ن",1,0],["برهانه يدرك بالدليل","مثل دخان النار في التمثيل",42,"ل",1,0],["بِرهرهةٍ تَرنو بِطَرفٍ كَما رَنا","إِلى سِربِهِ وَسَط الخَميلَةِ رَبرَبُ",43,"ب",1,0],["بَرَهرهةٍ جمَّا العظام خريدةٍ","عقليةِ بدوٍ ذات طوقٍ وخلخالِ",44,"ل",1,0],["بَرهرهةٌ رُعبوبةٌ بدوَّية","منعَّمة خَودٌ بها يُضربُ المثلْ",45,"ل",1,0],["بَرهرهةٌ ريَّا الرَّوادفِ غادة","عليها من الحسن البديعِ ملابسُ",46,"س",1,0],["بَرهرَهةٌ غضَّة بضةٌ","لها جيدُ ريمٍ وعينا نَشِبْ",47,"ب",1,0],["بُرهانهُ الشافي تُرَدُّ لاصلِهِ","كُل البَراهين الَّتي تتصدَقُ",48,"ق",1,0],["بَرَهْرَهَةٌ يحارُ الطَّرف فيها","كَحُقَّةِ تاجِرٍ شُدَّتْ خِتاما",49,"م",2,0],["برة أمي إذا انتسبت وبال","أبطح داري بالبلدة التهمه",50,"م",2,0],["برهانُ دين الله لولا جوُدُه","لم تَرْجُ من صُبح الندى أن يُسْفِرا",51,"ر",2,0],["برهانهُ واضحٌ بين الأنامِ يرى","كأنه علمٌ في رأسهِ نورُ",52,"ر",1,0],["برهرهة منعمة نمتها","أبوتها إلى الحسب النضار",53,"ر",1,0],["برهانه لدى الخصام","قاطع لمن جحد",54,"د",1,0],["بَرْهِنْ بأنكَ ما تَزالُ ضَريرا","واصنَع لِكُلِّ جَريمةٍ تَبريرا",55,"ر",2,1],["بَرهِن بأنك لم تَجئ مُتحرِّرًا","ممّن تَخافُ لِتَزعُمَ التحريرا",55,"ر",2,0],["بَرهِن بأنك ما أتَيتَ مُحاربًا","خَطَرًا سِواكَ، ولا ذَهَبتَ خطيرا",55,"ر",2,0],["بَرهِن -لِمَن عَشِقُوكَ أو كَرِهُوكَ- كم","خُدِعُوا بِقولِك والفِعالِ كثيرا",55,"ر",2,0],["بره منازل بدو منا وعنا","وبحره ملاه الله لولو ومرجان",56,"ن",1,0],["برهرهة كالشمس في يوم صحوها","منعمة تسبي نها كل ماجد",57,"د",1,0],["برهرهة في حسن قد وقامة","كأنبوب بان مائد بالأزاهر",58,"ر",1,0],["بَرَهْرَهَةٌ رَخْصَةٌ غادَةٌ","يَزِينُ بِها حَلْيُها وَالحُلَلْ",59,"ل",1,0],["-بَرَهْرَهَةٌ إِنْ مَشَتْ هَزَّها ال","شَّبابُ وَنَشْوَةُ عِرْفانِها",60,"ن",3,0],["بَرَهْرَهَةٌ تَشْكُو الخَلاخِلُ ساقَها","كَما يَشْتَكِي مِنْها الإِزارُ المَآكِمَا",61,"م",2,0],["« بَرهُوشُ » يَا نَعلَ الحِذَاءِ يَا بَغلٌ","وَالبَغلُ يَسمُو إِذَا حَدَّثتَهُ فَهِمَا!",62,"م",2,0],["برهان إنا في في فلسطين التي","فيها حماس تكيد للطغيان",63,"ن",1,0],["\"برهوم\" يقهرمن ينأى الكلام به","عن الشريعة مؤتمًا بمغرورِ",64,"ر",1,0],["بُرهانُ فوزه فوزُ ذرياته","نجْل العُلا لرؤى أبيه مترجمُ",65,"م",1,0],["برهة أنتقي لثغري صباحا","وأخبي عن العيون الجراحا",66,"ح",2,1],["بَرَهرَهَةً رَقراقَةً عَذبَةَ اللَمى","ثَوَت بِقُصورُ الغَربِ وَالأَصلُ بابِلُ",67,"ل",1,0],["بُرهانِيَ القولُ لا أمشي به أثرَ التّنزيل حاشا هل النّوران سيَّانَ؟","لا أعبُدُ الليلَ، لا أنتمْ رعيّةُ صُبحٍ فيه ترعونَ. ليس اللّيلُ مرعانَا.",68,"ن",2,0]]}