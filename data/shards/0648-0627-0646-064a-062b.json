{"poems":[[75,"ما جال بعدك لحظي في سنا القمر","https://www.aldiwan.net/poem11928.html","البسيط"],[60,"ألا قد أرى والله أن لست منكم","https://www.aldiwan.net/poem30890.html","الطويل"],[510,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[521,"ألا أيها الربع المقيم بعنبب","https://www.aldiwan.net/poem48737.html","الطويل"],[977,"","https://poetry.dctabudhabi.ae/diwan/poem/124596","البسيط"],[3419,"","https://poetry.dctabudhabi.ae/diwan/poem/130745","الرجز"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120526","الطويل"],[5365,"حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=190820",""]],"verses":[["وَإِن يُثَبِّط أَبا الحَزمِ الرِضى قَدَرٌ","عَن كَشفِ ضُرّي فَلا عَتَبٌ عَلى القَدَرِ",0,"ر",1,0],["وَإِنّي ثَويٌّ قَد أَحَمَّ اِنطِلاقَهُ","يحيِّيهِ مَن حيّاهُ وَهوَ عَلى رَحَلِ",1,"ل",1,0],["وأنّي ثالثُ اثنين","زها المترفُ نُكْرانا",2,"ن",2,0],["وَاِنّي ثَوَيتُ اليَومَ وَالاِمسِ قَبلَه","عَلى البابِ حَتّى كادَت الشَمسُ تَغرُب",3,"ب",1,0],["وإن يثبتني عند السؤال إذا","ما ضم قبري بعد الدفن أشلائي",4,"ي",1,0],["وأن يثيبنا بجنّة العلا","فإنّه أكرم من تفضّلا",5,"ل",2,0],["وأَن يُثِيبَنِى بِهِ يَومَ الجَزَا","وَمَن وَعَا أَو خَطَّ هَذَا الرَّجَزَا",6,"ز",2,0],["وان يثبت الملك المؤثل راسخا","مصونا لذي جند على غير ذي جند",7,"د",1,0],["وأنّي ثمّ أنّي ثُمّ أنّي","أَطَالَتْ في العتابِ بمايعيها",8,"ي",3,0]]}