{"poems":[[82,"ملاعب البيض بين البيض والأسل","https://www.aldiwan.net/poem31322.html","البسيط"],[207,"القوم أعلم لولا مقدمي فرسي","https://www.aldiwan.net/poem68159.html","البسيط"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48978","البسيط"],[2291,"","https://poetry.dctabudhabi.ae/diwan/poem/114936","السريع"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119714","الخفيف"],[5431,"أقصى التوله...","https://www.poetsgate.com/ViewPoem.aspx?id=198351",""],[5970,"كيد النساء وكيدهن عظيم","https://www.poetsgate.com/ViewPoem.aspx?id=130646",""]],"verses":[["بل ضَعْفُ طرفك في سفكِ الدماءِ له","أضعافُ ما للظُّبا والنّبْلِ والأسَلِ",0,"ل",1,0],["بَل ضارِبينَ حَبيكَ البيضِ إِذ لَحِقوا","شُمَّ العَرانينِ عَندَ المَوتِ لُذّاعِ",1,"ع",1,0],["بل ضَرَّّه أَنْ يضيرَ الناس كُلَّهُمُ","سُقمُ المبادئ والأخلاقِ لو عَلِما",2,"م",2,0],["بل ضاقت الأرض على صابرٍ","أصبحَ يشكو جفوةَ الصاحبِ",3,"ب",1,0],["بل ضروريّة محبة مثلي","لست أسطيعُ عن غرامي رجوعا",4,"ع",2,0],["بل ضمة الصدر ضمٌ لاانتهاءَ به","لافتحةُ البَين لا كسرُ الموازينِ",5,"ن",1,0],["بل ضعفهن مضى ببالغ قوتي","وحديث قوة ضعفهن قديم",6,"م",1,0]]}