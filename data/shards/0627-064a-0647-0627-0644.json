{"poems":[[79,"لا تعجبن لطالب نال العلا","https://www.aldiwan.net/poem36129.html","الخفيف"],[95,"مر في بالنا فأحيانا","https://www.aldiwan.net/poem11201.html","الخفيف"],[95,"ذلك الرزء في الصديق الكريم","https://www.aldiwan.net/poem11372.html","الخفيف"],[87,"لام فيكم عذوله وأطالا","https://www.aldiwan.net/poem63024.html","الخفيف"],[107,"أنشروا الآثار واستقصوا السير","https://www.aldiwan.net/poem43071.html","الرمل"],[107,"مت لتحيا ولا تردها حياة","https://www.aldiwan.net/poem43410.html","الخفيف"],[77,"إيها لك النعمى علي فأنعمي","https://www.aldiwan.net/poem69034.html","الكامل"],[77,"يا خير ملتحف بالمجد والكرم","https://www.aldiwan.net/poem69038.html","البسيط"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125600","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55035","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54560","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141955","الخفيف"],[100,"خيال من دمر","https://www.poetsgate.com/ViewPoem.aspx?id=55301",""],[92,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[119,"جذبتني سلاسل الأقدار","https://www.aldiwan.net/poem41689.html","الخفيف"],[128,"ردت الروح على المضنى معك","https://www.aldiwan.net/poem23783.html","الرمل"],[295,"ما لقصر الزهور أضحى كئيبا","https://www.aldiwan.net/poem11707.html","الخفيف"],[309,"نسمات الحي وهنا إذ سرت","https://www.aldiwan.net/poem16846.html","الرمل"],[422,"شرب القوم من لماك عقارا","https://www.aldiwan.net/poem54115.html","الخفيف"],[458,"لو أن تجربة الحياة وحظها","https://www.aldiwan.net/poem61745.html","الكامل"],[484,"كل يهرول نحوها وييمم","https://www.aldiwan.net/poem37573.html","الكامل"],[520,"خفة الروح واجتناب الثقاله","https://www.aldiwan.net/poem12198.html","الخفيف"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126725","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122635","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48825","الخفيف"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75744","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56109","الرمل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130629","المديد"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95549","الخفيف"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77900","الخفيف"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101011","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125402","الرمل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74990","الرمل"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74992","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202063","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48248","البسيط"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48253","البسيط"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48258","البسيط"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48255","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53052","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130751","الرمل"],[563,"","https://poetry.dctabudhabi.ae/diwan/poem/68665","الخفيف"],[2900,"","https://poetry.dctabudhabi.ae/diwan/poem/102172","الخفيف"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140313",""],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74065","المتدارك"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138647",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91068","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117869","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85212","الخفيف"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99267","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102938","الكامل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44913","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90839","الرمل"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102016","الرمل"],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101933","الرمل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52167","الرمل"],[4728,"حزم ما هو مثل حزم الظامي","https://www.poetsgate.com/ViewPoem.aspx?id=176900",""],[4935,"صبح الله بخير حضرتك","https://www.poetsgate.com/ViewPoem.aspx?id=129532",""],[5183,"الِّلثَامُ","https://www.poetsgate.com/ViewPoem.aspx?id=186447",""],[5401,"فتووون","https://www.poetsgate.com/ViewPoem.aspx?id=78672",""],[5431,"تونس الحب...","https://www.poetsgate.com/ViewPoem.aspx?id=198948",""],[5431,"بنٌ أفّاك!...","https://www.poetsgate.com/ViewPoem.aspx?id=208853",""],[5431,"قلتُ كلا ...","https://www.poetsgate.com/ViewPoem.aspx?id=210687",""],[5725,"قمر بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=177977",""],[402,"مر في بالنا فأحيانا","https://www.poetsgate.com/ViewPoem.aspx?id=36528",""],[5953,"قد أضأ بالقائم النيران","https://www.poetsgate.com/ViewPoem.aspx?id=93851",""],[5970,"أشغل القلب بما يهوى فما","https://www.poetsgate.com/ViewPoem.aspx?id=130592",""],[5997,"عَصْفُ رِيْح","https://www.poetsgate.com/ViewPoem.aspx?id=214286",""],[6052,"هزة الضمير","https://www.poetsgate.com/ViewPoem.aspx?id=34893",""],[6056,"حلايا الحووور","https://www.poetsgate.com/ViewPoem.aspx?id=156712",""],[6144,"فى الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=13797",""],[6144,"الواسطه لسه شغاله","https://www.poetsgate.com/ViewPoem.aspx?id=22536",""]],"verses":[["أَيَّهَ السَّائِقُ الْعَنِيفُ تَرَى","الرَّبْرَبَ يَسْعَى يَمِينَهُ وَشِمَالَهْ",0,"ل",2,0],["آيَةُ الحِلْمِ فِي سِياسَتِهِ","أَنْ يَرُدَّ المُسِيَّ مِعْوَانَا",1,"ن",2,0],["إِيِهِ إِلْيَاسُ بَعْضُ شَأْنِكَ مِمَّا","ضَلَّ فِيهِ السَّبِيلِ عِلْمُ العَلِيمِ",2,"م",1,0],["آيَةُ الحُسنِ لِلقُلوبِ تَجَلَّت","كَيفَ لا تَعشَقُ العُيونُ اِمتِثالا",3,"ل",2,0],["آيَةُ الأَجيالِ قامَت بَعدَهُم","لِيَراها مَن تَوَلّى أَو غَبَرْ",4,"ر",1,0],["آيَةُ الحُرِّ أَن يُغامِرَ لِلمَج","دِ وَأَن يَطلُبَ المَحَلَّ الرَفيعا",5,"ع",2,0],["إيهاً لكِ النُّعْمَى عليّ فأنْعِمي","وبَرِئْتِ من حَرَجِ السلامِ فسلّمي",6,"م",2,1],["إيهاً لعاً لك يا ابنَ الصِّيدِ من ألَمٍ","ولا لَعاً لأناسٍ مُظلِمي الشِّيَم",7,"م",1,0],["آيةُ الورد أنه نفحةٌ من","ك ومن عطرك العبيرَ استمدّا",8,"د",2,0],["آيَةُ الْفَن ذَوْقُه","فِي الأَفَانِينِ وَالتُّحَفْ",9,"ف",1,0],["آيَةُ الْعَصْرِ جَائبٌ","بَيْنَمَا لاَحَ إِذْ عَزَبْ",10,"ب",1,0],["آيةُ الحبّ أن تضلّي ربيعاً","لفؤادي وأن يظَلّ هُياما",11,"م",2,0],["آية الحب أن تظلي ربيعاً","لفؤادي وأن يظل هياما",12,"م",2,0],["آيةُ اللهِ عندَ لُبنانً َ هذا الحسنُ","في عامرٍ له وخراب",13,"ب",1,0],["آية اليل في الذوائب منه","أسدلت والجبين حزب النهار",14,"ر",1,0],["آية الحسن شباب شارد","حلف الشيب له أن يتبعك",15,"ك",1,0],["آيه آل الرسول صبراً على الرزءِ","فهذي صناعة الحدثان",16,"ن",1,0],["آية الأنفال والرعد مع النح","ل لما غيروها غيرت",17,"ت",1,0],["آية الله يفحم الله فيه","كلّ من كانَ فاجراً كفارا",18,"ر",2,0],["أيهاً ليونُ جمعتَ ذخرَ فضائل","وحجىً أقُّل جمالهِ ملكوتُ",19,"ت",1,0],["إيه إلى الفضلا يساق حديثنا","من شاء منهم للعطا يتقدم",20,"م",1,0],["أيها لسيد الذي أنكرتني","نوب الدهر مذ عرفنا نواله",21,"ل",2,0],["آية اللّه سيّد الخلق هادي الن","ناس طرّاً إلى طريق الرشادِ",22,"د",1,0],["آية الله في البَرية والسّت","رِ عَليها والشمسُ وابنُ البدر",23,"ر",1,0],["آية العصر أن يصير نسوراً","وتماسيح ناسُهُ وأسودا",24,"د",2,0],["إِيه إِلَيك فلست أَول عاشِق","قد زور الأعداء عنه وَزوقوا",25,"ق",3,0],["آية الرحمان ارّخ","اقبست منشيه نورا",26,"ر",2,0],["آية البدرين جل اقترانا","لنرى بدر السما والشموسا",27,"س",2,0],["آيةُ الموت تنسخ العَالَمينا","سنّة الله ذى الجلالة فينَا",28,"ن",2,1],["أَيُّها لِلكرام تحييى نفوسا","ولأهل الهَوى تميت نفوسا",29,"س",2,0],["آية الشوق أن تسيل الدموعُ","والجوى تنحني عليه الضلوعُ",30,"ع",1,1],["آية الله في العوالم والآ","ية أعلى صفات من أبداها",31,"ا",3,0],["آيةُ الشمسِ في النهارِ ضياءٌ","وحياةٌ لعالمِ الحَيوانِ",32,"ن",1,0],["آيةُ الصانِعِ العليمِ أمدَّت","كلَّ حيٍّ ما بين إنسٍ وجانِ",32,"ن",1,0],["آيةُ الشمسِ في الوُجودِ حياةٌ","وعلى الأرضِ آيةُ العمرانِ",32,"ن",1,0],["آيةُ النورِ بيَّنَت كلَّ شيءٍ","وكفى الآن أيها الثقلانِ",32,"ن",1,0],["آية اللَه تجلَّت","فهي في أجلي سطوع",33,"ع",1,0],["آيةُ الحقِّ قد تجلَّت عليكم","وبنورِ الإسلامِ تَمَّ الهناء",34,"ا",2,0],["آية اللَه أَمين صادق","وَحَبيب اللَه بر منتضل",35,"ل",1,0],["آية الصدق مني إنني إِذا مت","تُ عليه فَعاد لي أَنوارا",36,"ر",2,0],["آية الله أنت سفر كون","معجزات ألواحه وعجائب",37,"ب",1,0],["إِيهاً لهنَّ وآهاً للمحبِّ لقدْ","أمسى يكلِّمه من وَجْدِهِ موسى",38,"س",2,0],["إِيهاً لكَ الخيرُ من رَبْعٍ فلا كدَرٌ","يُرى بصفوكَ مصطافٌ ومرتبعُ",39,"ع",1,0],["إِيهاً لحسْنكِ فالآفاق ساجدةٌ","له بأقمارِ أسحارٍ وأفلاكِ",40,"ك",1,0],["إيهاً لشمسِ سَمَا هُدىً لم تُكْسَفِ","أبداً وبدرٍ نيِّرٍ لم يُخْسَفِ",41,"ف",1,0],["آية الشوق أن تهبَّ جَنوب","لفؤاد ترفضُّّ عنه الجُنوبُ",42,"ب",1,1],["آية الايمان يوم الغدرات","ما جرى يجري وما كان يكون",43,"ن",1,0],["آية الإنشقاق قد نبَّهته","فأصاب الهدى بنفس مفيقه",44,"ق",2,0],["آية الحسن أنني أهواك","فصليني وخففي مسراك",45,"ك",1,1],["إيهاً لأيام وصل باللوى سلفت","وليس يجدي المعنى قوله إيها",46,"ي",3,0],["آيةُ العلا","آية العِظَم",47,"م",1,0],["آية الحق وكم من آية","حين أبداها بها الحق سما",48,"م",2,0],["آية اللَه أَظهرت معجزاتٍ","لِلنبي الكَريم فيما يَشاء",49,"ا",2,0],["آية الحب فيّ فرط نحولي","واعتياضي عن الدموع الدماء",50,"ا",2,0],["آية الجود عنه تروى ومنها","عاد سكان سوحه أغنياءَ",50,"ا",2,0],["آية الحسن في المحاسن ذاته","وكستها كل الكمال صفاته",51,"ت",2,1],["إيهاً لصائلِ حَلْيها ولِثامها","هذَا يُعَانقها وذاكَ يُقَبِّلُ",52,"ل",1,1],["أيها لعيشك يا نديم أدر لنا","صرف الحميا أو بريقك فامزج",53,"ج",1,0],["آيةُ المَوتِ لَن تَمُرَّ عَلى الخا","لد إِلّا في خاطرِ الدّهَماءِ",54,"ا",2,0],["آية التطهير عنهم نطقت","يا لها من آية مستمعه",55,"ع",2,0],["آية الله ولولاه لما","عرف الله ولا الدين استقاما",56,"م",2,0],["آية التصديق من آياته","حين أعطى في الركوع الصدقات",57,"ت",1,0],["آيةُ الخالقِ لما","جَعَلَ القوّةَ جاها",58,"ا",3,0],["ايه الأقوام احترمها بسّ ما اعظّمها","ولا سعيت لذمّ بيشي لجل عين تْهامي",59,"م",2,0],["آية الحق صفا ترتيلها","بثنا ذاتك تبدى سيرتك",60,"ك",1,0],["آية الله من يُطيقُ اجتلاها","ويدُ الله مَن يَردّ قضاها",61,"ا",3,0],["إيه الهوى والمحبه ماتبي ميكرفون","تبقى كما السر والواجب علي كميته",62,"ت",2,0],["آية الكون برزخٌ من سديمٍ","بين أرضٍ وجنّةٍ أزلية",63,"ي",2,0],[": آية العشق من شفاهك شحني","أكمل الشحن فالصلاة احتكاك",64,"ك",1,0],["آيةُ الإبداع رحمٌ","بانبهار العقل أولى !!",65,"ل",2,0],["آية الليل اطفئت","ماعرفناك مجمرا",66,"ر",2,0],["آية الحلم في سياسته","أن يرد المسيء معوانا",67,"ن",2,0],["آية الرجعة لا تنكروها","وغويان بها ينبشان",68,"ن",1,0],["آية الله بدت في خلقه","في جمال نحن في الدنيا شهوده",69,"د",2,0],["آيَةُ الْعُشَّاْقِ صَنْعَاْء تَشْتَكِيْ","وَالْهَوَىْ مَكْلُوْمُ يَبْكِيْ في عَدَنْ",70,"ن",1,0],["آية النصر في الصدور ثبات","ينطق الحق باللسان جهارا",71,"ر",2,0],["آية الله ، وهبها الحسن شيء ٍ كثير","شوفها مغني ٍ ، عن شوف ناس ٍ كثار",72,"ر",1,0],["إيه الحكاية يا بيه ؟ جال خالفت الجوانين ؟","إشمعنى مليون حرامى فى البلد سارحين",73,"ن",1,0],["ايه اللي خلي الملعونه تصبح فينا","شريعه فوق شرع نبينا شرع القرآن",74,"ن",1,0]]}