{"poems":[[53,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[64,"إذا لم يعن قول النصيح قبول","https://www.aldiwan.net/poem52321.html","الطويل"],[64,"وذي وطن بالغور يصبو إلى الحمى","https://www.aldiwan.net/poem52379.html","الطويل"],[54,"ألا من لعين وتسكابها","https://www.aldiwan.net/poem27305.html","المتقارب"],[48,"معان من أحبتنا معان","https://www.aldiwan.net/poem23635.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[146,"لجاجة قلب ما يفيق غرورها","https://www.aldiwan.net/poem58440.html","الطويل"],[287,"فيك عذولي عذرا","https://www.aldiwan.net/poem32763.html","مجزوء الرجز"],[354,"علام والقد منك عادل","https://www.aldiwan.net/poem15856.html","مخلع الكامل"],[369,"إذا لم يخن صب ففيم عتاب","https://www.aldiwan.net/poem61000.html","الطويل"],[396,"إذا شئت السلام فالزم الدار","https://www.aldiwan.net/poem54567.html","عموديه"],[438,"يا عاذلي لا تطيلا عذلي","https://www.aldiwan.net/poem12482.html","الرجز"],[443,"أمن منزل بالجق أقوت معالمه","https://www.aldiwan.net/poem2537.html","الطويل"],[443,"دعا فأجابه الدمع العصي","https://www.aldiwan.net/poem2606.html","الوافر"],[580,"أيا دمع عيني لا تكن بعد إخواني","https://www.aldiwan.net/poem2776.html","الطويل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110359","الوافر"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53920","السريع"],[1533,"","https://poetry.dctabudhabi.ae/diwan/poem/105653","الوافر"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49559","الطويل"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42473","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87448","الوافر"],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104833","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117859","الطويل"],[3770,"","https://poetry.dctabudhabi.ae/diwan/poem/111346","المتقارب"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102942","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72769","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139718",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139642",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139772",""],[4578,"بغرةٍ تنقضى في حبها حججي","https://www.poetsgate.com/ViewPoem.aspx?id=49370",""],[4578,"من أطلع الريحان في الجلنار","https://www.poetsgate.com/ViewPoem.aspx?id=49426",""],[5431,"لعمريَ إنّ قسوتهم ظنونٌ","https://www.poetsgate.com/ViewPoem.aspx?id=186703",""],[5690,"أمير المؤمنين سعى إليكم","https://www.poetsgate.com/ViewPoem.aspx?id=170623",""],[5701,"ودنيا الورى فندق للورى","https://www.poetsgate.com/ViewPoem.aspx?id=164636",""]],"verses":[["به غدوتُ على الأيام مقتدراً","فقد صفحتُ عن الأيام أن صَفحا",0,"ح",2,0],["به غُلَّةٌ لا يملِكُ الماءُ بردَها","وشجوٌ سِوى ما تعلمونَ دخيلُ",1,"ل",1,0],["بهِ غُبَّرٌ من داءِ حُبٍّ مُمَاطلٍ","يجدِّدُهُ وَعْدٌ من البَيْنِ ناجِزُ",2,"ز",1,0],["بِهِ غَسَلَ اللَهُ مَحلَ الحِجازِ","وَأَبرَأَها بَعدَ أَوصابِها",3,"ب",3,0],["به غَرْقَى النّجُومِ فبيْنَ طافٍ","ورَاسٍ يَسْتَسِرّ ويُسْتَبانُ",4,"ن",1,0],["به غلة يَبكي لها ملء جفنه","لعل البكا منه لما فيه ينقع",5,"ع",1,0],["به غَصَّ ناديها وأشرقَ سعدُها","وأُفعمَ واديها وسُدّت ثُغورُها",6,"ر",3,0],["بهِ غدا متَوّجاً","مُخَتَّماً مُسَوَّرا",7,"ر",2,0],["بِهِ غَليلٌ لَدَيكَ يُشفى","بِضَمِّ ما ضَمَّتِ الغَلائِل",8,"ل",1,0],["بهِ غَنِيتْ أرضُ الحِمىَ عن مُصبَّحٍ","يقول سقَى دارَ الرّبابِ ربَاب",9,"ب",1,0],["به غرس الجنان فكن حريصا","على غرس بها من كل الأشجار",10,"ر",1,0],["به غدا اليومَ قوامَ العالَمِ","عن حاله منذُ نَشا لم يَحُلِ",11,"ل",1,0],["به غفرت للدهر كلّ إساءة","وعاد له بالعذر من هولائمه",12,"م",2,0],["به غفرت إساآت الليالي","وراح يجيدها منه حليّ",13,"ي",1,0],["به غرَّةٌ من يوم وصل قد انْفرَى","عليها إِهابٌ قُدَّ من ليل هِجْران",14,"ن",1,0],["بهِ غُرَرُ المناقبِ قد تجلَّت","مضمَّخةً بأرواحِ الخزام",15,"م",1,0],["به غدا الشرعُ بها ظاهراً","والدّينُ في أرْجائها قَيّمُ",16,"م",1,0],["به غدتْ في نعمةٍ بسطةٌ","بها حَباها الباسطُ المُنْعِمُ",16,"م",1,0],["به غدرت بنو حرب ابن عبد","وأعظم آفة المولى العبيد",17,"د",1,0],["به غُلّةٌ شَمَّاءُ عن كلِّ مَوْرِدٍ","سوى ما أباحتْ أضلعٌ ونحور",18,"ر",1,0],["به غزلي أضحى وفيهِ مدائحي","ومنِّي لمعنى حسنهِ النظمُ والنثرُ",19,"ر",1,0],["بِهِ غَيلانُ يَسلو وَجهَ مَيّا","حَكى المرأةَ او وجهَ الحُمَيّا",20,"ي",2,0],["به غدرت أرجاس حرب فأصبحت","تجرعه كأساً من الحتف ممقرا",21,"ر",2,0],["به غرّة العلم الشريف تهلّلت","سروراً وثغر الفضل أضحى به ألمى",22,"م",2,0],["به غادر الناس في دهشة","تراهم سكارى وما هم سكارى",23,"ر",2,0],["به غضت الأحداث عينا كليلة","فأعينها صور وأجراسها درد",24,"د",1,0],["به غدرت أيدي اللئام كغدرها","بسبط رسول الله فانزاح ايمان",25,"ن",1,0],["به غرر العلوم زهت ومنها","عمود الصبح شقَّته انفلاقا",26,"ق",2,0],["به غرة الأيام زينت فنَّظمت","كما زين عقد بالفريد تنضَّدا",27,"د",2,0],["به غرَّة الإسلام دام ضياؤها","وعزَّة أهل الكفر مات غرورها",28,"ر",3,0],["به غصون الأماني أينعت ودنت","لذي جنى بثنا معروفها لهج",29,"ج",1,0],["به غدا ثغر المنى باسماً","بالدر إذ فاق سناه الدرار",30,"ر",1,0],["به غسلت عن النفس الرزايا","فلا نقص بحب أو عيوب",31,"ب",1,0],["به غاباتهم في الأمن باتت","وقد فاضت معادنها سيولا",32,"ل",2,0],["به غرف بعضها ضيق","وهذا رحيب وذا أرحب",33,"ب",1,0]]}