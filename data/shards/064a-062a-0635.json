://www.poetsgate.com/ViewPoem.aspx?id=16201",""],[4119,"ليت القلوب على نظام واحد","https://www.poetsgate.com/ViewPoem.aspx?id=16126",""],[5072,"نجاة الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=52564",""],[5136,"أيها المدره الحليم العليم","https://www.poetsgate.com/ViewPoem.aspx?id=121656",""],[5410,"الصبر من صبري اشتكى","https://www.poetsgate.com/ViewPoem.aspx?id=141974",""],[5431,"صنعاء_خذلته الأبوة الغرّاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=198199",""],[5517,"أشجار وراء السياج","https://www.poetsgate.com/ViewPoem.aspx?id=199054",""],[5574,"صهيل الصبر","https://www.poetsgate.com/ViewPoem.aspx?id=206031",""],[5943,"صبرًا فإنَّ الصَّبرَ زادُ كرامِ","https://www.poetsgate.com/ViewPoem.aspx?id=37395",""],[6093,"يَتَصدَّقونَ من الدِّنانِ وآيُهم","https://www.poetsgate.com/ViewPoem.aspx?id=176510",""],[1583,"عيناكِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73061&r=&rc=18",""]],"verses":[["يَتَّصِلونَ بِيَربوعٍ وَرِفدُهُمُ","عِندَ التَرافُدِ مَغمورٌ وَمُحتَقَرُ",0,"ر",1,0],["يَتَصَلّى الهَجيرَ مِن قَيظِ كَرما","نَ كَريمٌ تُثنى عَلَيهِ البُنودُ",1,"د",1,0],["يَتَصَرَّعنَ لِلرَجاءِ دُنُوَّ ال","غَيمِ وَالوَدقِ خارِجٌ مِن خِلالِه",2,"ل",2,0],["يَتصدَّى لظاهرِ البِشْرِ طَلقُ ال","وَجْهِ فيه سكينةٌ ووَقارُ",3,"ر",1,0],["يَتَصايَحونَ بِهِ عَلى أَبوابِهِم","يَرجونَ كُلَّ مُخافِتٍ بِسَلامِهِ",4,"م",2,0],["يَتَصَبَّحنَ في الحِجالِ وَيَلبَس","نَ إِذا رُحنَ لِلِّقاءِ العَبيرا",5,"ر",2,0],["يَتَصَدَّعنَ عَن شُرافِيَّةِ الأُذ","نِ أَمونٍ في الحُندسِ الدَيجورِ",6,"ر",1,0],["يتصارعون بأذرعٍ مخضوبةٍ","والسقفُ فوق رؤوسهم يَنهارُ",7,"ر",1,0],["يَتَصَوَّرْنَهَا عَبِيراً ذَكِيّاً","وَشَرَاباً عَذْباً وَطَعْمَاً كَشُهْدِ",8,"د",1,0],["يَتَصَارعُ الداءُ العُضَا","لُ به مع الطبِّ الحَنُون",9,"ن",1,0],["يَتصفّحُ الآراءَ مُنتخباً لما","هو في نفسِ ذوي النباهة أوقعُ",10,"ع",1,0],["يتصابى يا خليلي","ويغالي في التصابي",11,"ي",1,0],["يتصرَّف السرُّ القديم بأمرهِ","وتراه يعملُ زعمه ويجاهد",12,"د",1,0],["يَتَصَيَّدُ الوحشَ المًلُوكُ إذا هُمُ","صاروا وَلستَ تَصيدُ غيرَ الصَِّيدِ",13,"د",1,0],["يَتصدّى في يَوم صَعبِ","لاستكشاف الوَضع الخَصبِ",14,"ب",1,0],["يَتَصدّى إِلى الدروسِ وَيُكسى","حلّةَ النّفعِ زيِّنت بالوَقارِ",15,"ر",1,0],["يتصابى بعدَما ردّ كرهاً","من غَيابات الصِّبا ما استعارا",16,"ر",2,0],["يَتصابى وَلاتَ حينَ تَصابٍ","بِعُيونِ المَها وَسِربِ الظِباءِ",17,"ا",2,0],["يتصوّر الإغراق في مدحي له","ويقول فيها للغلو مكان",18,"ن",1,0],["يَتَصَدّى لَهُ وَلَو صينَ بِالبي","ضِ سَناهُ وَحُفَّ بِالأَهوالِ",19,"ل",1,0],["يَتَصَدّى لَهُ عَلى كُلِّ صَدرٍ","كاعِبِ النَهدِ غَيرِ سَهلِ المَنالِ",19,"ل",1,0],["يتصفحن للأعادي وهيهات","لا مرقد خاب فيه رجاها",20,"ا",3,0],["يَتَّصِلُ بَعضُهُمُ بِبَعضِ","وَبَينَهُم بَحرٌ وَحَدُّ أرضِ",21,"ض",1,0],["يتصابى حتى اسلمه نفسي","فيجفو والعطر ملء إزاره",22,"ر",2,0],["يتصرف المتَصرّفون بأَمرِه","عن حُكْم أَمرٍ نافذٍ لا نافدِ",23,"د",1,0],["يَتَصَارَعُونَ.. ولَستَ تُدرِكُ ما الذي","تَرَكُوهُ غيرَ فَرَاغِهِ ونُضُوبهِ",24,"ب",2,0],["يتصحَّرونَ وأنتِ سهل ٌ ممرعٌ","لك موسمٌ في كلِّ آنٍ أخضرُ",25,"ر",1,0],["يتصرف العافون في أمواله","قبل السؤال تصرف الملاك",26,"ك",1,0],["يتصرف المتصرفون بأمره","عن حكم أمر نافذ لا نافذ",27,"ذ",1,0],["يتصور ُ الكَلِم َ الذَّهول َ مُجرّدا ً","من صدقِه ، ويقول ُ ما لا يفعل ُ",28,"ل",1,0],["يتصدى ذكراك من بسم ال","وصل إلينا فدمعنا مسجوم",29,"م",1,0],["يتصارعون ودأبُهم","مَلء المغانم بالشبك",30,"ك",1,0],["يتصفّى بريحهم جو حزنٍ","تتلظى بعشقهم أحشاءُ",31,"ا",2,0],["يتصوّرونَ الفنَّ سوقُ نخاسةٍ","حتى الجمالُ تخيّلوهُ جواريا",32,"ي",2,0],["١- يتصبّبُ الألقُ الغزيرُ كما الجَدا","في هاجَرِ الشوقِ المُضيَّعِ في السُّدى",33,"د",2,1],["يتصبَّرونَ بحكمةٍ وتفاؤلٍ","طمعًا بعفوِ اللهِ عند َختامِ",34,"م",1,0],["يَتَصدَّقونَ من الدِّنانِ وآيُهم","شِعْرٌ وواعظُ قومهم فَنانُ",35,"ن",1,1],["يتصافحان ، وكم شكا الوادي","قبيل اليوم حقده",36,"د",2,0]]}