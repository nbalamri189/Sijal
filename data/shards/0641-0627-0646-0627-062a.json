{"poems":[[55,"تطاط لها فيوشك أن تجلى","https://www.aldiwan.net/poem29856.html","الوافر"],[57,"يا فوز بالله هبي","https://www.aldiwan.net/poem26465.html","مجزوء الرجز"],[57,"أزين نساء العالمين أجيبي","https://www.aldiwan.net/poem26547.html","الطويل"],[74,"يا سيدي يا ملاذ الطالبين ومن","https://www.aldiwan.net/poem18298.html","البسيط"],[87,"مشيئة الله كانت","https://www.aldiwan.net/poem6834.html","المجتث"],[45,"أوه بديل من قولتي واها","https://www.aldiwan.net/poem10603.html","المنسرح"],[47,"ليالينا بين اللوى فمحجر","https://www.aldiwan.net/poem63636.html","الطويل"],[68,"مملوكك اليوم أبو حبه","https://www.aldiwan.net/poem38646.html","السريع"],[71,"إني إلى طلعته شيق","https://www.aldiwan.net/poem29221.html","السريع"],[41,"نبيت تميما تجتدي حرب طيئ","https://www.aldiwan.net/poem53756.html","الطويل"],[77,"حلفت بالسابغات البيض واليلب","https://www.aldiwan.net/poem69102.html","البسيط"],[50,"رأيت هواي سيرته الوجيف","https://www.aldiwan.net/poem64396.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42619","الطويل"],[92,"شباب يذوي !","https://www.poetsgate.com/ViewPoem.aspx?id=179111",""],[135,"غشيت برابغ طللاً محيلا","https://www.aldiwan.net/poem23993.html","الوافر"],[147,"بالحول نلت ونال الناس بالحيل","https://www.aldiwan.net/poem11794.html","البسيط"],[310,"أعيذ صفاء الود من كدر العتب","https://www.aldiwan.net/poem56604.html","الطويل"],[411,"قامت تريد الرواح وهنا","https://www.aldiwan.net/poem50012.html","مخلع البسيط"],[443,"إن العواني إبراهيم درهمه","https://www.aldiwan.net/poem2515.html","البسيط"],[471,"ألا أيها البيت الذي أنا هاجره","https://www.aldiwan.net/poem50432.html","الطويل"],[484,"بنورك يا مولاي لا زلت أهتدي","https://www.aldiwan.net/poem37046.html","الكامل"],[500,"عندي فديتك جدي","https://www.aldiwan.net/poem9878.html","المجتث"],[520,"ما كل سجع بمعدود من الخطب","https://www.aldiwan.net/poem12020.html","البسيط"],[549,"سقياك يا والد النهرين","https://www.aldiwan.net/poem67249.html","عموديه"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122806","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38011","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77508","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77474","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59414","السريع"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133785","الرجز"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132259","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27700","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27861","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27840","المنسرح"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27822","البسيط"],[2356,"","https://poetry.dctabudhabi.ae/diwan/poem/105646","الرجز"],[2565,"","https://poetry.dctabudhabi.ae/diwan/poem/103775","المجتث"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87325","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87327","الرجز"],[2696,"","https://poetry.dctabudhabi.ae/diwan/poem/10429","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108169","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91886","الطويل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95339","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111462","المتقارب"],[3961,"","https://poetry.dctabudhabi.ae/diwan/poem/198334","السريع"],[4104,"","https://poetry.dctabudhabi.ae/diwan/poem/125322","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81734","البسيط"],[4692,"قل لي بربك كيف يهدأ","https://www.poetsgate.com/ViewPoem.aspx?id=211041",""],[5015,"مرثية الدار","https://www.poetsgate.com/ViewPoem.aspx?id=201339",""],[5150,"بوحي بالحب","https://www.poetsgate.com/ViewPoem.aspx?id=202786",""],[5302,"وقوف على الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=200867",""],[5314,"عودة الذات","https://www.poetsgate.com/ViewPoem.aspx?id=214821",""],[5323,"بارق ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=207293",""],[5859,"طفلة","https://www.poetsgate.com/ViewPoem.aspx?id=29415",""],[5956,"يا ليت","https://www.poetsgate.com/ViewPoem.aspx?id=185663",""],[5997,"قيم الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=214222",""],[1100,"أمن لهاثي ام لهاث الخمر جوي عطر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=612987",""],[6242,"يا أيها الشعر قد جددت أحزاني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87555&r=&rc=2",""],[6251,"وَثائِق ُالشَّمْس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76466&r=&rc=6",""]],"verses":[["فَإِن أَتبَعتَ هَذا الأَمرَ لَهفاً","فَإِنَّكَ أَعزَبُ الثَقَلَينِ عَقلا",0,"ل",2,0],["فَإِن أَتَتكُم رُسُلي","فَاِستَمِعي وَاِقتَرِبي",1,"ب",2,0],["فَإِنّا تَرَكنا بِالعِراقِ أَخا هَوىً","تَنَشَّبَ رَهناً في حِبالِ شَعوبِ",2,"ب",1,0],["فإن أتوكَ وقالوا إنَّها نصفٌ","فإنَّ أطيبَ نصفيه الذي ذهبا",3,"ب",2,0],["فإن أتى كل هذا","حذا مثالك فينا",4,"ن",2,0],["فَإِن أَتى حَظُّها بِأَزمِنَةٍ","أَوسَعَ مِن ذا الزَمانِ أَبداها",5,"ا",3,0],["فَإِن أَتَذَكَّر حُسنَ ما فاتَ لا أَجِد","رُجوعاً لِما فارَقتُهُ بِالتَذَكُّرِ",6,"ر",1,0],["فَإِن أَتى ضَيفٌ عَلى غِرَّةٍ","قابَلَهُ بِالتَعسِ وَالنُكسِ",7,"س",1,0],["فإن أتى الدهر بفتقٍ يَقُلْ","جدهمُ العالي أنا أرتقُ",8,"ق",1,0],["فَإِنّا تَرَكنا اِبنَي شِهابِ بنِ جَعفَرٍ","وَجَنّاءَةَ الثاوي بِصَحراءِ عاقِلِ",9,"ل",1,0],["فإنْ أتَيْتَهُمُ عن فَترَةٍ فهُمُ","كما عَهِدتَهُمُ في سالِفِ الحِقَب",10,"ب",1,0],["فَإِن آتي وَذَلِكَ بَعدَ كَدٍّ","فَدارُ مُحَمَّدٍ ثُمَّ الوُقوفُ",11,"ف",1,0],["فَإِنْ أَتَغَيَّرْ عَنْ وِدَادٍ فَإِنَّنِي","أَرَى كُلَّ شَيءٍ عُرْضَةً لِلتَّغَيُّرِ",12,"ر",1,0],["فانْ أتتكَ أحاديثٌ مُزخرَفةٌ","عن الذينَ رَوَوْها أو عن الللائي",13,"ا",2,0],["فَإِن آتِ الَّذي تَهوَونَ مِنها","فَقَد عاصَيتُها زَمَناً طَويلا",14,"ل",2,0],["فَإِن أَتى حَسَنٌ مِن فِعلِ بَعضِهِمِ","فَقَد يَصِحُّ وُقوعُ السَعدِ عَن زُحَلِ",15,"ل",1,0],["فإن أتّهم فيك العيان فبالحرى","وإلّا فما لي في البقا بعد من أربِ",16,"ب",1,0],["فإنْ أتاك النّاعي بيَومي","كدَأْبِ موسى نُوحي ونُوحِ",17,"ح",1,0],["فإن أتى الضيف يوما نحو منزله","أحلّه الرحب منه والقرى الحرم",18,"م",1,0],["فَإِن آتِهِ لَم أَنجِ إِلّا بِظَنِّهِ","وَإِن يَأتِهِ غَيري تُنَط بي جَرائِرُه",19,"ر",2,0],["فآنا تبث العلم بالدرس جامعا","وآونة بالكتب بيعا لمتهدي",20,"د",2,0],["فإن أتيت فخير","وإن أبيت فخيره",21,"ه",1,0],["فإن أتى فرج من راحتي فرج","فليس ذاك بمعدود من العجب",22,"ب",1,0],["فإنْ أتيتُكَ أحلاماً مُسَعَّفَةً","فأنتَ لي خاطرٌ بالنخلةِ اقترنَا",23,"ن",2,0],["فإن أتى بالحجة المخترقة","أن الذي ترك كان صدقة",24,"ه",1,0],["فإن أتى شهر الصيام اجتمعوا","وصلوا الليل على ما ابتدعوا",24,"ع",3,0],["فَإنَّ إتيانَ نارَ الطُّورِ أَظهَرَ بُر","هانَ النُّبُوَّةِ في مُوسَى بنِ عِمران",25,"ن",1,0],["فَإِنْ أتْلُ آياتٍ عَلَيه فَإِنَّني","كَتالٍ لما يدريه في السرِّ والجهرِ",26,"ر",1,0],["فَإِن أَتى يسمَع مِن بَعيد","وَإِن يَكُن في آخر الصَعيد",27,"د",1,0],["فَإِن أَتى الصَيف فَقبل الصُبح","أَردها عَلَيك غَير الربح",28,"ح",1,0],["فإن أتوا من قبل لا غرو إن","رش الندى البستان قبل الغمام",29,"م",1,0],["فإن أتى فغصة","وأدمع وذكر",30,"ر",1,0],["فإنا توسّلنا بكم للذي به","توسلنا لله في نيلنا الوطر",31,"ر",1,0],["فإنْ أتتك عقولٌ تبتغي أثراً","بقصه فاحذري ولا تقصيه",32,"ي",2,0],["فإن اتخاذ الستر فرضٌ معيَّنٌ","كذا جاءنا فيما به الله قد دنا",33,"ن",2,0],["فإن أتيتَ تسعى","أنا أهرول",34,"ل",1,0],["فإن أتت نونا عينٌ تجادُلنا","فالحشر يجمعنا وفيه ما فيه",35,"ي",2,0],["فإن أتيت محفلا","على الوفا قد اشتمل",36,"ل",1,0],["فإن أتيتَ فدفعا","منها بكلتا اليدين",37,"ن",1,0],["فإن أَتَيتَ يا فتى ذا المجرَى","رَتِّب قِيَاسَك في المُرَبًّع وآحُدُرا",38,"ر",2,0],["فإن أتى مَعكَ المربَّع أربَعَه","دَمِّنَ شِعبَ البومِ فاحذَر مَقطَعَه",38,"ه",1,0],["فَإن أَتَيتَ تِسعَةَ أَبوَاع","لِحَدِّ مَا أَبيضَ لاَ تَرتَاع",39,"ع",1,0],["فَإِنّا تَرَكناكُم لَدى الرَدمِ غُدوَةً","فَريقَينِ مَقتولاً بِهِ وَمُطَرَّدا",40,"د",2,0],["فإن أتت ترخص الأملاك أمتها","تكون أرخصت الأملاك تيجانا",41,"ن",2,0],["فَإِن اتحادَ الرَأي يُبدي صَوابَه","وَربَّ صَوابٍ غابَ في جَنب وحدة",42,"ه",1,0],["فإن أتى وجَدّكم فالفتح","وشِكل هند دلَّها والملح",43,"ح",1,0],["فَإِنَّا تَرَانا حَلِيفَي وَدَاد","وَما بَيننا لا يَحِلُّ الجِلاد",44,"د",1,0],["فإن أتى داعٍ بنيل المنى","ودّع أشجاني ونعم الوداع",45,"ع",1,0],["فان أتاني بأمن كنت أشكره","وما عدا ذاك منه ليس يجديني",46,"ن",2,0],["فإن أتى ناسخٌ للابتداءِ غدا","بحكمه غيرَ مُبْقٍ ذلك الحُكُما",47,"م",2,0],["فأنا تعبت لانني","ياصاح لم انه ليبدأْ",48,"ا",1,0],["فان اتي طيف ابائي يناظرك","ضمي الطيوف وصبي عشق مغليك",49,"ك",1,0],["فإنا تلتقي الأنظارُ فينا","وتُلقينا على شطِّ الشرودِ",50,"د",1,0],["فإن اتهمت نفسي ففي عشق قرية","وإن شرقت كنا بفيفا ومنجد",51,"د",1,0],["فأنا توارت فى النجوم مثابتي","وأن ترصع بالشموس مقامي",52,"م",2,0],["فإن أتهمتْ أتهمْ نزولاً لأمرها","وإن أنجدتْ أنجدْ مشوقاً إلى نجدِ",53,"د",1,0],["فأنا تحليقي علويٌ","لايفهمه .. إلا قلة!",54,"ل",2,0],["فإنْ أتيحَ لنا إشباعُ حاجتِنا","هل ينتهي النهبُ أو أسبابُ سَفْكِ دَمِ؟",55,"م",1,0],["فَإِنَّ أَتَى الدَّهْرُ حَيِّنَا مِنْ جَدَائِلِهِ","أَهْدَيْتُهُ لِلْهَوَى مِنْ نَابِضَاتِ دَمِي",56,"م",2,0],["فإن أتى فغصة وأدمع وذكر","كأن ما بي نغم مشوه مزور",57,"ر",1,0],["فإنْ أتيت فلا تُقبلْ بلا أمل","يظل يشعل للأشواق نيراني",58,"ن",2,0],["فَإِنْ أَتَىْ وَجْهِيْ إِلَيْهَا تَوَالَىْ","الدَّمْعُ مِنْ أَجْفَانِهْا وَانْحَدَرْ",59,"ر",1,0]]}