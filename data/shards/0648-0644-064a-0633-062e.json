{"poems":[[55,"مسيري إلى ليل الشباب ضلال","https://www.aldiwan.net/poem29909.html","الطويل"],[24,"ألا بكرت عرسي تلوم وتعذل","https://www.aldiwan.net/poem21876.html","الطويل"],[37,"ألا حييا ليلى أجد رحيلي","https://www.aldiwan.net/poem39100.html","الطويل"],[33,"يا قلب أخبرني وفي النأي راحة","https://www.aldiwan.net/poem42246.html","الطويل"],[50,"أما ونجيبة يهوي","https://www.aldiwan.net/poem62585.html","مجزوء الوافر"],[60,"ألا هل إلى طول الحياة سبيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15571&r=&rc=97",""],[33,"يَا قَلْبِ أَخْبِرْني وفي النَّأْيِ رَاحَة ٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18939&r=&rc=202",""],[146,"ما فاز بالحمد ولا ناله","https://www.aldiwan.net/poem58429.html","السريع"],[331,"تخفى الملوك لموسى عند طلعته","https://www.aldiwan.net/poem44264.html","البسيط"],[409,"سرى طيفها والطرف مني مسهد","https://www.aldiwan.net/poem33967.html","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38914","الطويل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105454","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49997","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122069","الطويل"],[5306,"الكوكب الدرّي","https://www.poetsgate.com/ViewPoem.aspx?id=174807",""],[6251,"أتيتك بالبشر لا بالعزاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76474&r=&rc=14",""],[6355,"الفجر خصيمي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66665&r=&rc=125",""]],"verses":[["وَلَيسَ خِضابُ المَرءِ إِلّا تَعِلَّةً","لِمَن شابَ مِنهُ عارِضٌ وَقَذالُ",0,"ل",1,0],["وَليسَ خَليلي بِالمَلولِ وَلا الَّذي","يَلومُ عَلى البُخلِ البَخيلَ وَيَبخَلُ",1,"ل",1,0],["وَلَيسَ خَليلي بِالمَلولِ وَلا الَّذي","إِذا غبتُ عَنهُ باعَني بِخَليلِ",2,"ل",1,0],["وَلَيسَ خَليلي بِالمُرَجّى وِصالُهُ","وَلَيسَ لِسِرّي عِندَ غَيرِيَ مَوضِعُ",3,"ع",1,0],["وَلَيسَ خَليفَةُ الرَحمَ","نِ يَعدِلُني إِذا سَجَدوا",4,"د",3,0],["وليس خليلي بالملول ولا الذي","إذا غبت يرضاه سواي بديل",5,"ل",1,0],["وَلَيْسَ خَلِيلي بِکلمُرَجَّى وِصالُهُ","وليسَ لسري عند غيريَ موضع",6,"ع",1,0],["وليس خِدْنى بالهِدانِ الذي","هجوعُه يألفُ آصالَهْ",7,"ل",2,0],["وَلَيسَ خَلقٌ يَرى بَدراً وَطَلعَتَهُ","مِنَ البَرِيَّةِ إِلّا ذَلَّ أَو خَضَعا",8,"ع",2,0],["وليس خليلي غير من كان همه","علوم إلى خير البرية تسند",9,"د",1,0],["وَلَيسَ خُلودُ الخَلقِ في الدّهرِ واقِعاً","فَلَو كانَ ما ماتَ النبيّ المُطيَّبُ",10,"ب",1,0],["وليس خفوق القلب إلا لذكره","سليمى إذا ما هيجت قلبه الذكرا",11,"ر",2,0],["وليَ سخيّ عليّ رَضيٌّ","وابن النَبيِّ الشّجاع البطلْ",12,"ل",1,0],["وَلَيْسَ خِضَاباً مَا عَلاَهُ وَإِنَّمَا","جَرَى فِيهِ بَعْدَ الدَّمْعِ مَا عَزَّ مِنْ دَمِي",13,"م",2,0],["وليس خيالي مستطيعاً لشأوه","سماواته أعيت لذي الصَّب مصعدا",14,"د",2,0],["ولَيْسَ خَيَارَاً لَنَا أَنَّهَا","ضَرِيْبَةُ أَيَّامِنَا لِلْبَقَاءِ",15,"ا",1,0],["وليسَ خصيمي الليلَ في الحُبِّ إنّما","إذا زار عيْني الكَرَى أذَّنَ الفجْرُ",16,"ر",1,0]]}