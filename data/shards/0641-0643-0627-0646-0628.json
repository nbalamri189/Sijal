ل"],[3750,"","https://poetry.dctabudhabi.ae/diwan/poem/126515","الطويل"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202369",""],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59515","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135519","المجتث"],[4163,"","https://poetry.dctabudhabi.ae/diwan/poem/106735","الكامل"],[4705,"ألا ما لشمل المجد أضحى مبددا","https://www.poetsgate.com/ViewPoem.aspx?id=127732",""],[1012,"أباة الضيم","https://www.poetsgate.com/ViewPoem.aspx?id=186325",""],[1012,"فتح بلدة نفعا","https://www.poetsgate.com/ViewPoem.aspx?id=124499",""],[4939,"وإذا الفتى من بعد طو","https://www.poetsgate.com/ViewPoem.aspx?id=135265",""],[5186,"كنا من الدنيا على باخرة","https://www.poetsgate.com/ViewPoem.aspx?id=156435",""],[5187,"عبق نسرين","https://www.poetsgate.com/ViewPoem.aspx?id=33006",""],[5206,"مناهج الله","https://www.poetsgate.com/ViewPoem.aspx?id=187391",""],[5302,"صراع نفس","https://www.poetsgate.com/ViewPoem.aspx?id=202725",""],[5459,"بعثة الرحمة المهداة","https://www.poetsgate.com/ViewPoem.aspx?id=190905",""],[5582,"لِمَنْ الظُّعْنُ تَرْسُبُ وَالقُبَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=186705",""],[5596,"وصلت بشائر نوئكم","https://www.poetsgate.com/ViewPoem.aspx?id=205490",""],[5725,"وحين التقينا","https://www.poetsgate.com/ViewPoem.aspx?id=206233",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[6202,"انفض السامر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86710&r=&rc=11",""],[2220,"قلبي بذكركَ مسرورٌ ومحزونُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11796&r=&rc=666",""]],"verses":[["فَكَانَ بَعْثٌ قُلُوبُ الأُمَّةِ ارْتَقَصَتْ","لَهُ وَأَعْطَافُهَا اهْتَزَّتْ مِنَ الطَّرَبِ",0,"ب",1,0],["فكان بينهما بون وإن غديا","في الشرق أعظم مذكورين ما ذكرا",1,"ر",2,0],["فكأنَّ بحراً قد جرى بدم العدَى","والقوم فيه والجياد سوابح",2,"ح",1,0],["فكأن بعض الأنبيا","ءِ دعا له بشبابِ قرنه",3,"ن",2,0],["فَكانَ بَينَ هاشمٍ مِن حَربِ","ما كانَ بَينَها وَبَينَ حَربِ",4,"ب",1,0],["فكأنَّ بدرَ التِّمِّ فوقَ سَراته","حُسْناً وبين جفونِهِ كيوان",5,"ن",1,0],["فَكَأَنَّ بَهجَةَ وَردِها","شَمسٌ تُلاحِظُها بِعَينِ",6,"ن",1,0],["فَكَأَنَّ بَدراً في سَماهُ راكِباً","بَرقاً يُزَحزِحُ بِالهِلالِ شِهابا",7,"ب",2,0],["فَكَأَنَّ بَدءَ النارِ في أَطرافِهِ","شَفَقٌ لَوى يَدَهُ بِذَيلِ ظَلامِ",8,"م",1,0],["فَكانَ باقي الإِسمِ لي قُبَّةٌ","بِالفَتحِ في خَدِّكَ مَجراها",9,"ا",3,0],["فكأنَّ بحرَ الروم أصبَحَ منبِتًا","بعد الفلا للغاب والآجام",10,"م",1,0],["فَكَأَنَّ بِسطامَ بنَ قَيسٍ لَم يَرُع","يَوماً عِداهُ وَحاتِماً لَم يُكرِمِ",11,"م",1,0],["فَكانَ بُطرسُ بانيها لِبُطرسَ مِن","كُرسيِّ بُطرسَ لِلامدادِ يدَّخرُ",12,"ر",1,0],["فكان بين تَلاقينا وفُرْقَتنا","كما تَبسَّم برق غازَلَ الأُفُقا",13,"ق",2,0],["فكانَ بَنَفسَجِيُّ الخَزِّ فيها","وَسَاجٌ نَاعِمٌ فَأَتمَّ زَيني",14,"ن",2,0],["فكأن بِفيْلقه العرمْرَم فالقاً","هَامَ الأعاجم نَاسِفاً أرْجَاءَها",15,"ا",3,0],["فَكَأَنَّ باكوراتِهِ في نَشرِها","تُهدي ثَناءً حازَهُ بَكرورُ",16,"ر",1,0],["فكان بأعلى الرأس مغنى وصورة","ومهما أتى منكم على الرأس يحمل",17,"ل",1,0],["فَكانَ بها مَساؤُكَ عِندَ مِصْرٍ","وَكان بها صَباحُكَ بِالشَّامِ",18,"م",1,0],["فَكانَ بِهِ كَونُ النَقيبِ وَعَن سَنا","نَقيبُ الهُدى صارَ اِنتِجابُ النَجِيبَةِ",19,"ه",1,0],["فَكَأَنَّ باسِمَها الَّذي يَشكو إِلى","قَلبي وَمُقبِلَها الَّذي وَلّاني",20,"ن",2,0],["فكأنَّ بيت عطائه","من كثرةِ الزوارِ مَشهَد",21,"د",1,0],["فَكانَ بِسَعدٍ لا بِنَجسٍ مَناخُها","عَلى بابِ مَن أَغنَت يَداهُ عَن القَطرِ",22,"ر",1,0],["فكان بحمد الله عَقداً مباركاً","جَلوباً لأفراحي سلوباً لأحزاني",23,"ن",2,0],["فكأنّ بين بنانه","فاضت بحور طاميه",24,"ي",2,0],["فكأن بشيرا ناشده","بمكارمه ذات السحب",25,"ب",1,0],["فكان بالله ورغم العدا","إلى التي حاولتَ أنت المآلْ",26,"ل",1,0],["فكان به دونَ أَصحابِهِ","ما حثّ فيه عليهِ حفيّا",27,"ي",2,0],["فكأنّ بُليل صائفٍ في صدرهِ","يصل الأغاني مُبدياً ومُعيداَ",28,"د",2,0],["فَكأَنَّ بالأَقمار لثمتم","وجوهكم الوسيمه",29,"م",2,0],["فَكانَ بِما أَبداه مِن حُسن سيره","يَرى أَنَّهُ بَينَ الصُدور كَبير",30,"ر",1,0],["فكأنّ بثّك للنّوالِ بثينةٌ","وكأنّ رأيكَ في الجميلِ جميلُ",31,"ل",1,0],["فكأنَّ بين الصّوْمِ خَطَّطَ نَحْوَهُ","خَطّاً خَفِيّاً بَانَ منه النُّوْنُ",32,"ن",1,0],["فكان بوجه الطامعين غضنفرا","هصورا ثقيل الوقع مُذ طرّ شاربه",33,"ب",2,0],["فَكَأَن بِمِصرَ وَأَرضِها لَكَ أَهطَعَت","فَيَقودُها سَعدٌ لَكُم وَتَيَمُّنُ",34,"ن",1,0],["فكأنَّ بابلَ أصْبَحَتْ في طَرْفِهِ","وكأنَّما الأهوازُ في شفتيهِ",35,"ي",2,0],["فَكانَ بِغَيرِ حُكمِ الأَش","عَريِّ هُناكَ ما حُكما",36,"م",2,0],["فكانَ بعدُ مجالِ الشعرِ معجَزَةً","وإنَّ في بعدهِ للشِعرِ مُنخَرِقا",37,"ق",2,0],["فكان بالعود مع ذا كله طربى","طورا وطور بما يحلو من السمر",38,"ر",1,0],["فكان بالأربع عندي وثلث","إذ بالمسير عن ثنايانا انبعث",39,"ث",1,0],["فكان باسمك نصر","لعالم ليس يهدا",40,"د",2,0],["فكان بما يبغيه للترك فائزاً","وكان جزا اعلام اعدائه الخضد",41,"د",1,0],["فَكانَ بَطنُ الحُوتِ مَعَ الفُؤَاد","هُنَاكَ أربَع ثُمَّ نِصفاً بآعتِيَاد",42,"د",1,0],["فَكانَ بِبَيتِ اللَهِ برؤُكِ أَوَّلاً","وَزورة خَيرِ الخَلقِ كانَ اِختِتامُكِ",43,"ك",1,0],["فَكَأنَّ بَلقيساً عَلَيهِ إِذ دَنَت","في الصَّرحِ رافعةً لِفَضلِ ذُيولِ",44,"ل",1,0],["فكأن بارقة السيوف بعينه","قُبَلٌ ومشتبك الرماح عناقُ",45,"ق",1,0],["فكأن برق الثغر ينشئه","غيثا اغام بمقلتي ورغا",46,"غ",2,0],["فكأن بنت الكرم مني زوجت","هرماً حكى هرماً من الأهرام",47,"م",1,0],["فكأن بحراً قد تعلق بالسما","سبحت به سفن من الآكام",48,"م",1,0],["فكانَ بِهِ كالصَّقرِ ينقَضُّ ظافِراً","تَسَاعَدَ مِنهُ مِحلَبٌ وجَنَاحُ",49,"ح",1,0],["فكان بهم سما الأعداء نقما","وفي الأرضين من دمهم سطوح",50,"ح",1,0],["فكان بعيسى مؤمناً في بداية","ومتبعاً للمصطفى في الأواخر",51,"ر",1,0],["فكأَنَّ بيت عَرُوض شِعري مُفرَدٌ","ما عِيبَ بالإِكفاءِ والإِبطاءِ",52,"ا",2,0],["فكان بمصر والشآم وفارس","وفي الهند والأتراك راج لك الدوما",53,"م",2,0],["فكأن بين نسورهن","ن جداول النيران تطلع",54,"ع",1,0],["فكأنَّ بهجته وغَضّ أرِاكهِ","وجهُ الحبيبِ وقامة النُّشوانِ",55,"ن",1,0],["فكان بعدك علواً","والرب أنت الرقيبُ",56,"ب",1,0],["فكأن بِمصرَ اغتاضَ مِن بَعدِ المَدى","مِن جَوهَرٍ بِحُسامِ بَأسِكَ جُؤذُرِ",57,"ر",1,0],["فكان بكائي أنني لا أرى أخا","ودوداً فمن لي أن ارى المتودا",58,"د",2,0],["فكان بجيش أهل البغي منهم","صواعق الانتقام والاصطدام",59,"م",1,0],["فكان بجيش أهل البغي منهم","صواعق الإنتقام الإصطدامي",60,"م",2,0],["فكأنَّ بُوسَى لم تكنْ","وكأن نُعْمَى لم تزل",61,"ل",1,0],["فكان باسم الله مجرى التي","ظلت على فيض الرجى سائرة",62,"ر",2,0],["فكأنَّ بواترها اجتمعتْ","بالسرِّ على قتلي اتفقوا",63,"ق",3,0],["فَكَأَنَّ بِالأُخرَى دَهَتكَ وَهذِهِ","قَد أسْلَمَتكَ لَهَا فَبِيسَ الخَاذِلُ",64,"ل",1,0],["فكان بلائي أن تعودت جفوة","وظلما وظلم الآل والصحب موجع",65,"ع",1,0],["فَكَانَ بِيَثْرِبَ الإسْلامُ حُرًّا","بِهَا الأنْصَارُ تَحْرُسُهُ وِتَحْمِي",66,"م",2,0],["فَكأَنَّ بَنانَ أَنامِلِها","بِخِضابٍ مِنَ الصِّرْفِ مُخْتَضِبُ",67,"ب",1,0],["فكأن بارق وصلكم أورى بها","غيم المحبة فاسبكرّ فأمطرا",68,"ر",2,0],["فكان بياضاً كومض النجوم","يسامر ليلاً سهادا عصيّا",69,"ي",2,0],["فكان بعيد العود للكون أسس ال","مباني على أصل الأصول العليتي",70,"ت",2,0],["فكأن بالأمس القريب أخاله","جئت الحياة لها نثرت معطرا",71,"ر",2,0],["فكانَ بحجبهُ عني وعنْ صفتي","غيمُ العمى وأنا في الغيب مخزونُ",72,"ن",1,0]]}