{"poems":[[53,"يا طول غلة نفسي المبلاه","https://www.aldiwan.net/poem66717.html","الكامل"],[240,"يا رب قد حج الوزير","https://www.aldiwan.net/poem32138.html","مجزوء الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38771","الرمل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104699","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202900","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202898","الطويل"],[3564,"","https://poetry.dctabudhabi.ae/diwan/poem/127809","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94412","الطويل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136382",""],[4782,"نوء","https://www.poetsgate.com/ViewPoem.aspx?id=200885",""],[5033,"أنا باختصار","https://www.poetsgate.com/ViewPoem.aspx?id=182757",""],[5111,"إيَّاكَ أفتَقِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=212361",""],[5431,"وصلّت مع الضحكة التاسعة","https://www.poetsgate.com/ViewPoem.aspx?id=197802",""],[5910,"لقد طال هذا اللَّيلُ","https://www.poetsgate.com/ViewPoem.aspx?id=206275",""],[6004,"الخَطِيئة","https://www.poetsgate.com/ViewPoem.aspx?id=59138",""]],"verses":[["فاسدُدْ يديكَ بخادم من شأْنه","عكْس الرياء إذا تَصنَّع داه",0,"ه",1,0],["فَاِسدُد مَسالِكَهُم وَلا","تَردُد لَهُم يارَبِّ غُربَه",1,"ب",2,0],["فاسِدُ الرّأيِ بِجَهلٍ وَعَمى","لَو رَأى الفرقَ هُنا لَم يَقِسِ",2,"س",1,0],["فَأَسدَى إِلَيكَ اللهُ مِنهُ تَحِيَّتى","عَرَجتَ سَماءً لِلمَعالِى لَقَد سَما",3,"م",2,0],["فأسديت شكري للاله فحينما","أضعت عويناتٍ وجدت عيونا",4,"ن",2,0],["فأسدتْ إليّ الشكر بالطيب والعطر","فهذا الذي يدعونه عاطرُ الشكر",5,"ر",1,0],["فأسدوا الله باري الكون حمداً","اذا ملتم شمالاً أو يمينا",6,"ن",2,0],["فأَسدل بُردَ العدل والرُحم في الوَرى","وشتَّت جمع الجور والبغي والجفا",7,"ف",2,0],["فاسديت معروفاً اليهم فسدتهم","فلم يذهب المعروف منك لهم سنا",8,"ن",2,0],["فأسدل علينا ستار الختام","وكَبِّرْ أسىً واقرأ الفاتحة",9,"ح",2,0],["فأسدلْتُ اللثامَ لثامَ ضعفي","وأظهرتُ الحقيقة إذ دُعيتُ",10,"ت",1,0],["فأسْدل الشِّعْرُ منْ حوليْ سدائِلهُ","يُعتِّقُ الكَاسَ يُذكِيْ وجْدَهُ الصَّفَدُ",11,"د",1,0],["فأسدلتُ فيه شغافا دعاه","وقبلت روحا به دامعة",12,"ع",2,0],["فأسدلتُ ثوب الصبرِ حتى بدت لنا","لواعجُ أشواقٍ عكفن نواهيا",13,"ي",2,0],["فَأَسدَلَ الغَيْمُ حِجابًا سَاترًا","ثُمَّ تدَّجَى الكَونُ صَارَ باليَا",14,"ي",2,0]]}