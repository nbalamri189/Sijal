{"poems":[[110,"ما انفكت الناس في أديانها قددا","https://www.shoaraa.com/p11352",""],[53,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8298.html","البسيط"],[53,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[68,"وليلة في طول يوم العرض","https://www.aldiwan.net/poem40689.html","الرجز"],[71,"محدث كالبدر في","https://www.aldiwan.net/poem28303.html","مجزوء الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39629","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[164,"إليك ما يقطع للسعله","https://www.aldiwan.net/poem58690.html","السريع"],[190,"شره الإنسان يقتله","https://www.aldiwan.net/poem43435.html","المديد"],[276,"محدثي عن فريق فارقوا العلما","https://www.aldiwan.net/poem52058.html","البسيط"],[369,"نمت بأسرار ليل كان يخفيها","https://www.aldiwan.net/poem60595.html","البسيط"],[406,"عمر رضي الله عنه","https://www.aldiwan.net/poem6771.html","عموديه"],[463,"لمن ظعن سوائر لو","https://www.aldiwan.net/poem55846.html","مجزوء الوافر"],[484,"عجائب الدهر شتى","https://www.aldiwan.net/poem36936.html","المجتث"],[549,"غراب على شجرة الميلاد","https://www.aldiwan.net/poem67243.html","عموديه"],[572,"روح من الماء في جسم من الصفر","https://www.aldiwan.net/poem69680.html","البسيط"],[639,"","https://poetry.dctabudhabi.ae/diwan/poem/144434","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122726","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122739","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122719","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122692","الطويل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34430","البسيط"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96361","البسيط"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96579","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1354,"","https://poetry.dctabudhabi.ae/diwan/poem/205983",""],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49592","الخفيف"],[2074,"","https://poetry.dctabudhabi.ae/diwan/poem/33094","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53065","السريع"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95171","المجتث"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40087","السريع"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139141","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72347","البسيط"],[4702,"يامحمد بن الذيب والله مظلوم","https://www.poetsgate.com/ViewPoem.aspx?id=155184",""],[4728,"غادة","https://www.poetsgate.com/ViewPoem.aspx?id=176988",""],[4764,"محنة ارواح","https://www.poetsgate.com/ViewPoem.aspx?id=33155",""],[5012,"ما أوعدك","https://www.poetsgate.com/ViewPoem.aspx?id=26272",""],[5061,"ياضنيني","https://www.poetsgate.com/ViewPoem.aspx?id=147170",""],[5089,"عرِّجْ على هذا الجمال الأقدسِ","https://www.poetsgate.com/ViewPoem.aspx?id=128710",""],[5122,"لا قلت ....!","https://www.poetsgate.com/ViewPoem.aspx?id=28150",""],[5122,"ليلي والنجوم","https://www.poetsgate.com/ViewPoem.aspx?id=29715",""],[5252,"تبي تسكتني","https://www.poetsgate.com/ViewPoem.aspx?id=36105",""],[5277,"الرحيل على صهوة الحيرة","https://www.poetsgate.com/ViewPoem.aspx?id=185132",""],[5461,"غلا الناس (سلطان بن عبد العزيز )","https://www.poetsgate.com/ViewPoem.aspx?id=5062",""],[5608,"فرحانه","https://www.poetsgate.com/ViewPoem.aspx?id=33052",""],[5689,"حمام أم تنور أم بركان","https://www.poetsgate.com/ViewPoem.aspx?id=143412",""],[5732,"محد يلومك","https://www.poetsgate.com/ViewPoem.aspx?id=177929",""],[5732,"يامشرف المرقاب","https://www.poetsgate.com/ViewPoem.aspx?id=177886",""],[5732,"البارحه يازبن بالقلب هوجاس","https://www.poetsgate.com/ViewPoem.aspx?id=177848",""],[5732,"غنيت ما قصدي طرب","https://www.poetsgate.com/ViewPoem.aspx?id=177854",""],[5747,"بعض الخطا","https://www.poetsgate.com/ViewPoem.aspx?id=61611",""],[5747,"شبيك لبيك","https://www.poetsgate.com/ViewPoem.aspx?id=61616",""],[5770,"شجب وأخواتها","https://www.poetsgate.com/ViewPoem.aspx?id=178721",""],[5950,"دموع التماسيح ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128120",""],[5992,"مُحَدَّبٌ عيناهُ في رأسِه","https://www.poetsgate.com/ViewPoem.aspx?id=41831",""],[6056,"إسمك وعنوانك بجوالي","https://www.poetsgate.com/ViewPoem.aspx?id=130335",""],[572,"روحٌ من الماءِ في جِسْمٍ مِنَ الصفَرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9301&r=&rc=158",""]],"verses":[["مُحدَوْدِبَ الظهرِ يُخفي الكبرياءُ به","ملامِحَ الكسرِ في حولٍ له نَفِدا",0,"د",2,0],["محدِّثاً أو مُبيناً عن مُجمجَمةٍ","أو هازلاً هَزْلَ صَدَّافٍ عن الحُوَبِ",1,"ب",1,0],["مُحْدَثي رفعةٍ قديمي سَفالٍ","غلّسُوا فيه أيما تَغْليس",2,"س",1,0],["مُحَدَّدَ النابِ لِغَيرِ عَضِّ","مُنتَصِبَ الأُذنَينِ عِندَ الرَكضِ",3,"ض",1,0],["محدِّثٌ كالبدرِ في","هالةِ قومٍ مُحْدِقَهْ",4,"ه",1,1],["مُحدَّقاتٍ في نواحي السماءْ","تُشهدها هذا الأسى والألمْ",5,"م",1,0],["مُحدِّقَةً فيه مَحْنيّةً","عليه ويا لَلّظى كم يروعْ",6,"ع",1,0],["مُحدِّثتي ما أحبَّ اللقاءَ","لقد حال جسمي دونَ اللقاء",7,"ا",2,0],["مُحْدَثاتٌ عزّتْ على عقلِ إبلي","سَ فعَضَّ البنانَ فَدْماً بليدا",8,"د",2,0],["محدثاً يخبر عما مضى","وعن تمرلنك ومن قبله",9,"ل",2,0],["محدث التركيب مهلكهُ","فيه والأيّام تمهله",10,"ل",2,0],["محدثي عَن فَريق فارَقوا العلما","وأودعوني في تَوديعهم أَلَما",11,"م",2,1],["مُحدِّثٌ بصَوابِ الرَّأْيِ خاطرُه","خافي الأُمورِ لدَيْهِ مثلُ باديها",12,"ي",3,0],["محدَّثٌ أنت بين الناس ميَّزهُ","ربُّ العباد بما يُجلى به البصر",13,"ر",1,0],["محدّثة بسؤدده","حديثَ الروض بالمُزُنِ",14,"ن",1,0],["محدودب الظهر حان","يخطو على الأخشاب",15,"ب",1,0],["محدودب الروح مِمَّا روحُهُ حمَلَتْ","للأرضِ حُبّا وما انْفَكَّتْ تُوَزِّعُهُ",16,"ع",2,0],["مُحَدِّدٌ كلَّ مِيْقَاتٍ تَخَيّرَهُ","ذَوُو التَّخَيُّرِ للأسْفَارِ والحَضَرِ",17,"ر",1,0],["مُحدقاتٌ بكلِّ كإحدا","قِ جُفونٍ العُيونِ بالأحداق",18,"ق",1,0],["مُحَدِّثي بِحَديثِ الرَّكبِ لا تَرِبَت","كَفّاكَ زِد عَلَلاً أزدَد بِهِ عِلَلا",19,"ل",2,0],["مُحَدِّثَتي بِلارَملِ مَن لي لَو أنَّني","ظَفِرتُ بشأدنَى بلَّةٍ مِن بَلالِهِ",20,"ل",2,0],["مُحَدِّثي عَن بِشامِ الأبرُقَينِ أهَل","سَلاسِلُ الرَّملِ مِنَ بَعدي سَلاسِلُه",21,"ل",2,0],["مُحدِّثتي بالبَينِ عَهدي بأهلِهِ","فَريقانِ منهُم مُكذِبٌ وَمُصَدِّق",22,"ق",1,0],["مُحَدِّثٌ قل لِمَن كانوا قَد اِتّفقوا","كَي يَسمَعوا منه فُزتُم منه بالوَطَرِ",23,"ر",1,0],["مُحَدِّث كم له بِالفَتح مِن مَدَدٍ","تَحقيقُ رَجوى نبيّ اللَه في عمرِ",23,"ر",1,0],["مُحدِّث الشامِ بِعَصرِهِ وَمن","في نُسكِهِ وَزُهدِه فَرد الزَمَن",24,"ن",1,0],["محددينَ لِبَرقٍ صابَ في خيمٍ","وفي القُرَيّةِ رادوهُ برُوّادِ",25,"د",1,0],["محدرجةً ليست بزعراءَ خَلَّةً","ولا قُذَّتَى لَغبٍ على فوقِ مِغزلِ",26,"ل",1,0],["محدودب كرائه وصغِّرا","محقق بالربط فيه قدرا",27,"ر",2,0],["مَحَدّْ عارف مصيره","كبارنا واصغار",28,"ر",1,0],["مُحْدَثٌ مِنْ رأي المشيخةِ في","الجُلاّسِ أُزري بكلٍّ رأيٍ قديم",29,"م",1,0],["مُحدَودِباً وُسطى أَنامِلِهِ","كَمَحَةٍ أَجهَضٍ مُستَكرَهِ العُكَنِ",30,"ن",1,0],["مُحَدِّقٌ عن نرجس سافر","عن جُلَّنارٍ باسم عن أقاحْ",31,"ح",1,0],["محدّثٌ لاحَ منّي","ومنه معنى ظريفُ",32,"ف",1,1],["مُحَدِّثٌ تحدثُ أمراضَنَا","أَجفانُهُ الْفاتنةُ الفاتِرهْ",33,"ه",1,1],["محدقٌ مكبرٌ له استعجابا","ثم فريام قال آخيل دعنا",34,"ن",2,0],["محدثات الأمور أردى الشرور","فتحفظ من محدثات الأمور",35,"ر",1,1],["محدَّب يتراآى في مقعره","موج يكاد على الآفاق أن يقعا",36,"ع",2,0],["محدٍ ورى القضبان مرتاح لو يوم","يا جعل قاض الظلم تنشلّ إيده",37,"د",2,0],["محدٍ يلومك وانت قرمٍ من قروم","للحق قلت ولاانْت هايب وعيده",37,"د",2,0],["محدٍ سواها يستحق الإشادة","بين الوصايف والخصال الحميدة",38,"د",2,0],["محدن حبيبي من عنا الوقت خالي","ما غير يحصي في تباريح واجراح",39,"ح",1,0],["محدن عن احبابه بيختار البعاد","لولا الحياء اطلقت للرجل العنان",40,"ن",1,0],["محدن سواك الي تمنيت قربه","ومحدن سواك من العباد يعنيني",41,"ن",2,0],["محدودة الأطراف من أذيالها","يبدو الزمان المبتدي للهندس",42,"س",1,0],["محدً سوى الله من جرحي مشافيني","كان لشفا من يد لمخلوق مبغاله",43,"ل",2,0],["محد يدوم الا الله الواحد يدوم","مرسل على قوم أبرهه طير أبابيل",44,"ل",1,0],["محد على ايديك النواعم ضربها","وما انتب على كل الذي صار مغصوب",45,"ب",1,1],["محد تيقن بك ولاحد حسبها","تبي تسكتني إلى قلت:مكتوب؟!",45,"ب",1,0],["محدوْدَبٌ يزفرُ الآهاتِ من لهَفٍ","يسارعُ الخطوَ محمولاً على عجَلِ",46,"ل",1,0],["محد(ن) وصل بالجود والطيب حدّه","وانا اشهد إنّه أكثر الناس إنسان",47,"ن",1,0],["محدٍ لوى يدّي ولا قلت انا الآه","ولغير ربي ما انثنت يوم اركبي",48,"ب",2,0],["محددة شرقا بخضراء بها","لسنى الحياة ونارها خزان",49,"ن",1,0],["محد يلومك يبو وجه مليحي","اصبر وراعي الصبر يجزا بالاحسان",50,"ن",1,0],["محد ٍ عشق مثله من الحضر وظعون","وشمر وعناز ٍ وروق ٍ وبرقا",51,"ق",2,0],["محدٍ يحوشه بالحيلات وفلوس","واهل الردى ماحصلوه ابملايين",52,"ن",1,0],["محدن يعرف جروحي الخافياتي","واليا نشدني واحدن عنه صديت",53,"ت",1,0],["محدٍ على الدنيا من الهم مرتاح","من عاش بالدنيا يشوف العجايب",54,"ب",1,0],["محدٍ قدر قبلك يسوي سواتك","عامين مرت بي وأنا ميتٍ فيك",55,"ك",1,0],["محدودةٌ إذ ( نتنياهو ) يفصلها","ونحن نلبس والملبوس أسمال",56,"ل",1,0],["محدٍ معاه لضيق صدري مفاتيح","حتى الذي في صدق قلبه توسّمت",57,"ت",1,0],["مُحَدَّبٌ عيناهُ في رأسِه","مسكنُه في الماءِ كالعُشِّ",58,"ش",1,1],["محدٍ ترى من الغلط معصوم","يومك تعذبني على الخالي",59,"ل",2,0],["محدِّدٌ كلَّ ميقاتٍ تخيَّرهٌ","ذوو التخيُّرِ للأسْفَارِ والخَطَرِ",60,"ر",1,0]]}