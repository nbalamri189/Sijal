{"poems":[[66,"شرط المعارف محو الكل منك إذا","https://www.aldiwan.net/poem67626.html","البسيط"],[53,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[53,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[53,"بدعة عندي كاسمها بدعه","https://www.aldiwan.net/poem65395.html","السريع"],[47,"شرط الإنصاف لو قيل اشترت","https://www.aldiwan.net/poem64647.html","الرمل"],[68,"غيري بحبل سواكم يتمسك","https://www.aldiwan.net/poem40111.html","الكامل"],[68,"خطب لسان الحال فيه أبكم","https://www.aldiwan.net/poem41549.html","الكامل"],[54,"جار هذا الدهر أو آبا","https://www.aldiwan.net/poem27301.html","المديد"],[50,"يا معشر اللوام","https://www.aldiwan.net/poem66546.html","المجتث"],[1,"إني من القوم الذين إذا","https://www.aldiwan.net/poem34001.html","الكامل"],[47,"شَرْطِيَ الإنْصَافُ، لوْ قِيلَ اشترِطْ","https://www.poetsgate.com/ViewPoem.aspx?id=31123",""],[208,"للعيد أوعدني من لم يزل عيدا","https://www.aldiwan.net/poem53320.html","البسيط"],[382,"قدك البعاد فهل إليك سبيل","https://www.aldiwan.net/poem59293.html","الكامل"],[409,"عجبا يعاتبني بلا ذنب","https://www.aldiwan.net/poem34115.html","الكامل"],[415,"أتهم فيكم لائمي وأنجدا","https://www.aldiwan.net/poem32486.html","الرجز"],[505,"أراكم بعيني أين كانت شخوصكم","https://www.aldiwan.net/poem37984.html","الطويل"],[543,"شرط العظيم وصفه بالمهتدي","https://www.aldiwan.net/poem48235.html","عموديه"],[563,"نحن إخوان النبي المصطفى","https://www.aldiwan.net/poem34355.html","الرمل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[817,"","https://poetry.dctabudhabi.ae/diwan/poem/145602","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63969","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119979","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59231","الرمل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126128","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126138","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87867","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69315","الطويل"],[2186,"","https://poetry.dctabudhabi.ae/diwan/poem/124169","المنسرح"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2467,"","https://poetry.dctabudhabi.ae/diwan/poem/111707","البسيط"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70341","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58265","الكامل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118807","الكامل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104312","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127003","الهزج"],[3617,"","https://poetry.dctabudhabi.ae/diwan/poem/107037","المجتث"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136935",""],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136938",""],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54418","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94814","البسيط"],[4277,"","https://poetry.dctabudhabi.ae/diwan/poem/124303","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73104","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141683","البسيط"],[4797,"ماهوب كفو الوقت حبك يمحّيه","https://www.poetsgate.com/ViewPoem.aspx?id=50259",""],[5187,"صامدٌ أيها الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=37392",""],[5281,"قانون الصُّحبة","https://www.poetsgate.com/ViewPoem.aspx?id=199349",""]],"verses":[["شَرطَ المَعارِفِ مَحوُ الكُلِّ مِنكَ إِذا","بَدا المُريدُ بِلَحظٍ غَيرِ مُطَّلِعِ",0,"ع",1,1],["شُرَطٌ خُوِّلوا عقائل بيضاً","لا بأحسابهم بل الإكتسابِ",1,"ب",1,0],["شرطَ الدهرُ فجْعَ كل مُحبٍّ","وهو فظٌ على المحبَّين سَلطُ",2,"ط",1,0],["شرطي من الأملاك من لا أرى","لي كل يوم معه وقعه",3,"ع",2,0],["شَرطِ الإِنصافُ لَو قيلَ اشتَرِت","وَعَدوّي مَن إِذا قالَ قَسَط",4,"ط",1,1],["شَرطي بِأَنَّ حُشاشَتي رِقٌّ لَكُم","وَالشَرطُ في كُلِّ المَذاهِبِ أَملِكُ",5,"ك",1,0],["شَرطُ الوُلاةِ بِها بِأَن يَمضي الَّذي","يَمضي وَيَسلَمُ عِندَهُم ما يَسلَمُ",6,"م",1,0],["شَرطُ دَهري كُلُّهُ غِيَرٌ","حينَ عادَيناهُ إِسحابا",7,"ب",2,0],["شرطي المراهقُ منهم","قد قاربَ الإحتلاما",8,"م",2,0],["شَرطاً قَويماً لَيسَ يَحبِسُهُ","لَمّا تَتابَعَ وِجهَةً عُسُرُه",9,"ر",2,0],["شَرْطِيَ الإنْصَافُ، لوْ قِيلَ اشترِطْ،","وعدوي مَنْ إذا قال قَسَطْ",10,"ط",1,1],["شرطي إذا ما رأيت الردف مرتدفاً","والخصر مختصراً والقدَّ مقدودا",11,"د",2,0],["شرطٌ لو اَنَّ هلال الدين أبصره","لم يستطع لشروط الفقه توكيدا",11,"د",2,0],["شَرطُ المحب ثباته في موقفٍ","فيه لوقع المشرفيِّ صليل",12,"ل",1,0],["شرط العهاد كما عرفت به","عدم اتحاد الحب بالحب",13,"ب",1,0],["شرطُ الهَوَى لهُمْ عَليّ أنّنِي","بهم مُعَنّى القلب صبٌّ أبدَا",14,"د",2,0],["شَرَطْتُ لهم لَوْمي إذا كُنتُ باقياً","وإن فُقِدَ المَشروطُ قد يُفْقَدُ الشَّرْطُ",15,"ط",1,0],["شَرطُ العظيم وصفُه بالمُهتَدِي","لدينه بعَمَلٍ مُؤيَّدِ",16,"د",1,1],["شرطوا الرؤية بالعين فمن","نالها منه فبالجسم اكتفى",17,"ف",2,0],["شرطي وشرطكم على الإعلان","أن يحكما بظاهر القرآن",18,"ن",1,0],["شرطت محبته على أهل النهى","ما لا يكاد موثق أن يشرطا",19,"ط",2,0],["شَرْطُ المنازلِ أنْ تقولَ إذا خَلَتْ","جادتْ خلالَكِ أدْمعُ الأشراط",20,"ط",1,0],["شرط الصبابة أن تطي","ع هوى وأن تعصي اللوائم",21,"م",1,0],["شرطُهُ أن لَيْسَ يَبْقَى عَاشِقٌ","فَاحْمَدِ اللَّهَ علَى مَا قَدْ شَرَطْ",22,"ط",1,0],["شرط الأمير أن يكون في عنا","والناس منه في رخاء وهنا",23,"ن",2,0],["شرط الطواف العقل والاسلام","والستر للعورة والإتمام",24,"م",1,1],["شرطية بزمن أو جردت","نكّر بنقص صفة أو وصفت",25,"ت",1,0],["شرطي على كاتبه والقاري","يطلبُ لي عفواً من الأوزارِ",26,"ر",1,0],["شرط الهوى حفظ الهوى","قاوماني فكيف اطلب فوزاً",27,"ز",2,0],["شرط التنزُّه فرضٌ تلك خُطَّتهُ","ليس اشتهاءُ الحشا ليس اقتضا وَطَرٍ",28,"ر",1,0],["شَرَطتُ عَلَيهِنَّ الوَفاءَ فَمُذ بَدا","بَياضُ عِذاري لِلعَذارى مَضى الشَرطُ",29,"ط",1,0],["شرط النسا والرجال يصلح لل","حالين أنثى إن شئتَ أو ذكرا",30,"ر",2,0],["شَرطُ المَحَبَّةِ أن تَوَافِقَ مِن تُحِبُّ","عَلَى مَحَبَّتِهِ بِلاَ عِصيَانِ",31,"ن",1,0],["شرطُ المعارفِ محوُ الكُلِّ منك إذا","بدا المريد بلحظٍ غبر مطلِّع",32,"ع",1,1],["شرط المحبة أن لا يشتكي مللا","من قد رأى أن فرط الحب يهلكه",33,"ك",2,0],["شَرطي شفاءُ الهالكي","نَ مِن الأَذى والشَرطُ أملَكْ",34,"ك",1,0],["شرط المحبة أنَّ كلَّ متيمٍ","يعصي العذول إذا أتاه يُمَخرِقُ",35,"ق",1,0],["شرطي بأن حشاشتي ملك لكم","والشرط في كل المذاهب أملك",36,"ك",1,0],["شرطت الوصل لي قدماً","فلا تعدل عن الشرط",37,"ط",1,0],["شرطت أن لست تسلو","هواه والشرط أملك",38,"ك",1,0],["شرط التكافئ في النهى","ان يصدق القلب اللسان",39,"ن",1,0],["شرط البيان خلود صاحبه","أو لا فبئس النظم والنثر",40,"ر",1,0],["شرطتمْ له حفظَ الودادِ وخُنْتُمُ","حنانيكمُ ما هكذا الوُدُّ والشَّرْطُ",41,"ط",1,0],["شرط الهدية أن تبقى لتذكرةٍ","إلى المهادي وهذا الشرط أنكرهُ",42,"ر",2,0],["شرط كل تقابل حدَسِيّ","أنه ما للمستعار بقاء",43,"ا",2,0],["شرطُ المحبَّةِ أنَّ كُلَّ متيَّمٍ","صبِّ يُطيعُ هواهُ يَعصي عُذَّلَه",44,"ل",2,0],["شرط الزيارة من بعد الطعام على","حكم المزور وأن لا تمنع الشغلا",45,"ل",2,0],["شرط . ان تشوفك فيه منت بحواليه","ويمكن تشوف ديار واماكن رعاه",46,"ا",2,0],["شَرطُ المَعارِكِ أنْ تَكونَ شَريفَةً","لا غَدرَ لامْرأةٍ وطِفلٍ وانِ",47,"ن",1,0],["شرطْ الصحب إنْ لانَ لكْ واغتَلَبْ","فارفعْ مقامهْ في المناصب",48,"ب",1,0]]}