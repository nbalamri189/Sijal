{"poems":[[47,"اسمع هديت أبا يحيى مقال أخ","https://www.aldiwan.net/poem64548.html","البسيط"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90580","الهزج"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115422","البسيط"],[5956,"أفراح الإفراج","https://www.poetsgate.com/ViewPoem.aspx?id=193434",""]],"verses":[["بِدُبرِها إِبنَةٌ شَنعاءُ مُقلِقَةٌ","أَحَرُّ في لَذعِها مِن جَمرَةِ النارِ",0,"ر",1,0],["بِدَبرِ القائمِ الأَقصى","غَزالٌ شادِنٌ أَحوى",1,"ا",1,1],["بدبعةُ الحسن قد فاز الجناس لها","من المعاني بأفنانٍ وأفناء",2,"ا",2,0],["بدبيّ العمر يبدا","وبها يومِض ومضا",3,"ض",2,0],["بدبيّ العمر أحلى","سيّما الأجواء رمضا",3,"ض",2,0]]}