{"poems":[[46,"ظنك فيما أسره حكم","https://www.aldiwan.net/poem30119.html","المنسرح"],[124,"يا حسن واحسرتا على غرر","https://www.aldiwan.net/poem49263.html","المنسرح"],[234,"فيك للمكرمات سر خفي","https://www.aldiwan.net/poem51039.html","الخفيف"],[240,"لوت الستون عودي","https://www.aldiwan.net/poem31895.html","مجزوء الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37959","السريع"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136897","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200083","الخفيف"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121736","البسيط"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35846","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216530","الخفيف"],[5131,"انتهينا لا الهوى يحنو علينا","https://www.poetsgate.com/ViewPoem.aspx?id=54821",""],[5183,"العدوان الثلاثي على مصر","https://www.poetsgate.com/ViewPoem.aspx?id=185649",""],[5411,"سترحل مرغما","https://www.poetsgate.com/ViewPoem.aspx?id=197853",""],[5691,"لاتحزني ياقدس...!","https://www.poetsgate.com/ViewPoem.aspx?id=206251",""],[5956,"لوعة","https://www.poetsgate.com/ViewPoem.aspx?id=182154",""]],"verses":[["كَيفَ سُلُوّي وَلَستَ تَرحَمُني","لَيسَ بِهَذا تُجاوَرُ النِعَمُ",0,"م",1,0],["كيف سعت بي إليكم قدمي","لو نال ردّاً مسائل القدر",1,"ر",1,0],["كيف سمّوا في الأرض بحراً وقطرا","وندى راحتيك بحر وقَطْر",2,"ر",1,0],["كَيفَ سَمَّوهُ عُلُوّاً","وَهوَ أَخذٌ في اِنحِطاطِ",3,"ط",1,0],["كَيفَ سَرقتَ الكحلَ ظَبيَ الفلا","مِن عَينِ حِبي الأَكحَلِ الزَّينِ",4,"ن",1,1],["كيف سالت على الصوارم نفس","هي تجري النفوس في أشلاها",5,"ا",3,0],["كيف سوَّت منك البنان ولمَّا","تكُ شيئاً في ذكريات الزمانِ",6,"ن",1,0],["كيف سيقوا فثووا من بعد ما","كبكبوا فيها وهم لا يدفعون",7,"ن",1,0],["كيف سمّوكم لدينا ضلالاً","شعراءً هال ماتت الشعراء",8,"ا",2,0],["كيف سُلُوِّي إذا تبدَّى","بوَجْهِ مَعْشوقيَ العِذارُ",9,"ر",1,1],["كَيفَ سِلوانُ مُحِبٍّ","نَومُ عَينَيهِ طَريدُ",10,"د",1,0],["كيف سلواك والفؤاد بما يس","ليه في فاجعاته مفجوع",11,"ع",1,0],["كيف سُدَّ الباب، هذا خبر","ليس يدريه سوى القلب لدينا",12,"ن",2,0],["كيف ساء انجلترا استقلالكم","فأرادته بقطع الجذُر",13,"ر",1,0],["كَيْفَ سَألتني وبأيِّ قَوْلٍ","إذ ا لَمْ تَسْتَطِعْ في الحُبِّ دَمْجي",14,"ج",2,0],["كيْفَ سَنَرْمي البِذْرَ في حقْلِنا","والحقْلُ للزُّرّاعِ لا يُحْرَسُ ؟",15,"س",1,0],["كيْفَ سَنَجْني ثَمَراً ندَّعي","نُضوجَهُ والشَّتْلُ لا يُغْرَسُ ؟",15,"س",1,0],["كيف سافرتَ حبيبي","دونَ أن تُعطي الخبرْ؟",16,"ر",1,1]]}