{"poems":[[33,"ذكرتني الديار شوقا قديما","https://www.aldiwan.net/poem41805.html","الخفيف"],[33,"يا صاح قل للربع هل يتكلم","https://www.aldiwan.net/poem41808.html","الكامل"],[33,"فيم الوقوف بمنزل خلق","https://www.aldiwan.net/poem42476.html","الكامل"],[33,"ما شجاك الغداة من رسم دار","https://www.aldiwan.net/poem42533.html","الخفيف"],[111,"أشعة الحق لا تخفى عن النظر","https://www.poetsgate.com/ViewPoem.aspx?id=512",""],[240,"لا وجدتم يا أهل نعمان وجدي","https://www.aldiwan.net/poem32096.html","الخفيف"],[342,"صدع الظعائن قلبه المشتاقا","https://www.aldiwan.net/poem45423.html","الكامل"],[370,"أبني زياد أنتم في قومكم","https://www.aldiwan.net/poem44533.html","الكامل"],[422,"هلا نظرت إلى الكئيب الواله","https://www.aldiwan.net/poem54023.html","الكامل"],[463,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[556,"عرج على الدارسة القفر","https://www.aldiwan.net/poem47777.html","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64361","المنسرح"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70830","الخفيف"],[1185,"","https://poetry.dctabudhabi.ae/diwan/poem/75730","الرمل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56575","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79821","البسيط"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113930","الخفيف"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105431","الرجز"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69418","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2406,"","https://poetry.dctabudhabi.ae/diwan/poem/100120","البسيط"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104246","البسيط"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34571","الكامل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34601","البسيط"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28766","الرمل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58014","البسيط"],[5397,"جلى صباح الهدى للخطب جنح دجى","https://www.poetsgate.com/ViewPoem.aspx?id=157955",""],[5458,"العيد","https://www.poetsgate.com/ViewPoem.aspx?id=72286",""],[5516,"هزي إليك","https://www.poetsgate.com/ViewPoem.aspx?id=212249",""]],"verses":[["عُجتُ فيهِ وَقُلتُ لِلرَكبِ عوجوا","وَدُموعُ العَينَينِ تُذرى سُجوما",0,"م",2,0],["عُجتُ القَلوصَ بِهِ وَعَرَّجَ صُحبَتي","وَكَفَفتُ غَربَ دُموعِ عَينٍ تَسجُمُ",1,"م",1,0],["عُجتُ المَطِيَّ بِهِ أُسائِلُهُ","أَينَ اِستَقَرَّت دارَةُ الشَمسِ",2,"س",1,0],["عُجتُ فيهِ وَقُلتُ لِلرَكبِ عوجوا","فَثَنى الرَكبُ كُلَّ حَرفٍ خِيارِ",3,"ر",1,0],["عجت بتحكيم عمرو بعدما حكمت","همدان فيما بحكم البيض والسمر",4,"ر",1,0],["عُجتُ مُستَشفِياً بِلَثمِ المَغاني","فَكَأَنّي اِستَشفَيتُ مِنها بِوَجدي",5,"د",2,0],["عُجتُ القَلوصَ بِها أُسائِلُ آيَها","وَالعَينُ تُذرى عَبرَةً تَغساقا",6,"ق",2,0],["عَجَّت نساءُ بني زيادٍ عَجَّةً","كَعَجِيجِ نِسوَتِنا غداةَ الأَرنَبِ",7,"ب",1,0],["عجت المطيّ لمنزلٍ مستوبلٍ","حتَّى وَقَفْتُ به على أطلاله",8,"ل",2,0],["عُجْ ترهَا رسوماً","ثلاثةً في رسمِ",9,"م",1,0],["عُجتُ بها أُنفِقُ في آيِها","ما كان مذخوراً من الصّبرِ",10,"ر",1,0],["عجت بأبياتهم أسائلها","فعجت منها بخر أبيات",11,"ت",1,0],["عُجتُ عن فعلهم ولى ه","مة تعلو على الفرقدين والمريخ",12,"خ",1,0],["عجت الطير عندَها وَتَغَنَّت","ان دَعا منشد أَخاه اجابه",13,"ب",2,0],["عجت رواحلها وقد","سئمت مواصلة الكرور",14,"ر",1,0],["عجَّت بهم مُذ على أبرادها اختلفت","أيدي العدوِّ ولكن مَن لَها بِهم",15,"م",1,0],["عُجتُ فيه فَظَلَّ دمعي على الخدَّ","ينِ تجري غُروبُهُ بانسِكابِ",16,"ب",1,0],["عجت عليها الفاطميات فكم","جيب لها شق ووجه خمشا",17,"ش",2,0],["عُجتُ أَشفِي بِها الغَليلَ فَقَد زِد","تُ غَليلاً عَلى الغَلِيلِ وَذِكرا",18,"ر",2,0],["عجت فروج الخلق ثم دماؤهم","وحقوقهم منه الى الديان",19,"ن",1,0],["عجت بمدحك أبناء النظام وإن","علوت عن كل منثور ومنتظم",20,"م",1,0],["عجت على الرسم وهو عاف","تسأل ملا يطيق ردا",21,"د",2,0],["عجت قواقزنا وقدس قسنا","هزجاً وأصخبنا الدجاج صياحا",22,"ح",2,0],["عجت أساقفها في بيت مذبحها","وعج رهبانها في عرصةِ الدارِ",23,"ر",1,0],["عِجتُ بِالساباطِ يَوماً","فَإِذا القينَةُ تُلجَمْ",24,"م",1,0],["عجَّتْ بتسبيحه الأفلاكُ دائرةً","يَرْغُو له البحرُ في أمواجِهِ الزبد",25,"د",1,0],["عجت عليه المعالي يوم خف بها","سيرا وقد حل في أخافهن وجا",26,"ج",2,0],["عجَّت موائدهم بحلوى مثلما","عجَّت مجالسهم بأنواع النفاق",27,"ق",1,0],["عجّت بأدخنةِ الآثام أوجُهُهم","وليلةُ الرقص بالضوضاء تمتلىءُ",28,"ا",1,0]]}