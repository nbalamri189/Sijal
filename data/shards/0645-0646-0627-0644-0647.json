{"poems":[[65,"من الركب يا بن العامري أمامي","https://www.aldiwan.net/poem46178.html","الطويل"],[37,"لعزة أطلال أبت أن تكلما","https://www.aldiwan.net/poem39090.html","الطويل"],[10,"ألا ابكي على صخر وصخر ثمالنا","https://www.aldiwan.net/poem21099.html","الطويل"],[29,"بت أرائي صاحبي تجلدا","https://www.aldiwan.net/poem5936.html","الطويل"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[31,"عفا دير لبى من أميمة فالحضر","https://www.aldiwan.net/poem6041.html","الطويل"],[87,"إلى الله أشكو من عوادي النوى سهما","https://www.aldiwan.net/poem11331.html","الطويل"],[47,"وراءك عني يا عذول الأشايب","https://www.aldiwan.net/poem11493.html","الطويل"],[60,"يا عمرو قد لاقيت فارس همة","https://www.aldiwan.net/poem30872.html","الكامل"],[46,"متى أنت عن ذهلية الحي ذاهل","https://www.aldiwan.net/poem30372.html","الطويل"],[89,"بأي غزال في الخدور تهيم","https://www.aldiwan.net/poem8259.html","الطويل"],[76,"وأغيد في صدر الندي لحسنه","https://www.aldiwan.net/poem12844.html","الطويل"],[41,"ألا أيها الليل الطويل ألا أصبحي","https://www.aldiwan.net/poem53802.html","الطويل"],[69,"انظر بحقك في أمر الدواوين","https://www.aldiwan.net/poem18116.html","البسيط"],[52,"أبا مسلم ما طول عيش بدائم","https://www.aldiwan.net/poem62250.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85696","المجتث"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62205","الطويل"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72206","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202649","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42733","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54860","السريع"],[119,"من الهوى آه","https://www.aldiwan.net/poem40430.html","عموديه"],[119,"لقد طال للركب المجد تلفتي","https://www.aldiwan.net/poem41193.html","عموديه"],[186,"من آل هاشم راحل نزل الثرى","https://www.aldiwan.net/poem61049.html","البسيط"],[190,"اصبر على كل ما جاء الزمان به","https://www.aldiwan.net/poem44120.html","البسيط"],[215,"يا قلب هذا نعيم","https://www.aldiwan.net/poem46564.html","المجتث"],[240,"لمن الركائب تستقي","https://www.aldiwan.net/poem31796.html","مجزوء الكامل"],[240,"حرام على الأجفان أن ترد الغمضا","https://www.aldiwan.net/poem31900.html","الطويل"],[248,"إني على رغم الوشاة لقائل","https://www.aldiwan.net/poem2053.html","الكامل"],[276,"أتأمرني بالصبر والطبع أغلب","https://www.aldiwan.net/poem52082.html","الطويل"],[327,"ألا هاج قلبي العام ظعن بواكر","https://www.aldiwan.net/poem56358.html","الطويل"],[369,"زمان قليل من بنيه نجيب","https://www.aldiwan.net/poem60998.html","الطويل"],[406,"أسد الشيشان","https://www.aldiwan.net/poem6792.html","عموديه"],[463,"نديمي وما الناس إلا السكارى","https://www.aldiwan.net/poem56204.html","المتقارب"],[469,"وناهدة راحت ولاية حسنها","https://www.aldiwan.net/poem3399.html","عموديه"],[469,"رمتني بنجل والسهام جفون","https://www.aldiwan.net/poem3591.html","عموديه"],[482,"أبثك ما بي أم كفاك نحولي","https://www.aldiwan.net/poem15347.html","الطويل"],[580,"لقد لقيت نصباً","https://www.aldiwan.net/poem2747.html","مجزوء الرجز"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126752","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126701","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126859","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122711","الطويل"],[757,"","https://poetry.dctabudhabi.ae/diwan/poem/132472","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96648","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27908","الرمل"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/198394",""],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21449","الطويل"],[2372,"","https://poetry.dctabudhabi.ae/diwan/poem/146241","الطويل"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107170","الكامل"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146338","البسيط"],[2922,"","https://poetry.dctabudhabi.ae/diwan/poem/105330","الطويل"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46890","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86300","الطويل"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199020","الرجز"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86494","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102751","الكامل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104923","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139520",""],[4755,"لِدَارِ الأَسَى بَابَانِ.. عالٍ, وهابِطُ","https://www.poetsgate.com/ViewPoem.aspx?id=198745",""],[4859,"بين الورود","https://www.poetsgate.com/ViewPoem.aspx?id=211013",""],[5199,"حبرى وقرطاسى","https://www.poetsgate.com/ViewPoem.aspx?id=150497",""],[5232,"قامة المجد","https://www.poetsgate.com/ViewPoem.aspx?id=213786",""],[5431,"لاعقلَ بالحب لاتبحث عن السبب!","https://www.poetsgate.com/ViewPoem.aspx?id=200208",""],[5582,"أَلا حَدِّثانِي عَنْ رُسُومِ المَعاهِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=63501",""],[5605,"ستُونَ عَامًا","https://www.poetsgate.com/ViewPoem.aspx?id=160307",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5736,"قدر","https://www.poetsgate.com/ViewPoem.aspx?id=203825",""],[469,"شكوت هوى في مثله تسمع الشكوى","https://www.poetsgate.com/ViewPoem.aspx?id=76778",""],[5952,"تضوع عطراً","https://www.poetsgate.com/ViewPoem.aspx?id=202703",""],[5989,"بالشعر .. ؛ لا أكثر","https://www.poetsgate.com/ViewPoem.aspx?id=181549",""]],"verses":[["منَ الهِيفِ تَستَعدي على لَحْظِها المَها","وتَسلُبُ خُوطَ البانِ حُسْنَ قَوامِ",0,"م",1,0],["مِنَ الهَيفِ لا تَخزى إِذا الريحُ أَلصَقَت","عَلى مَتنِها ذا الطُرَّتَينِ المُنَمنَما",1,"م",2,0],["مِنَ الهَضبَةِ العُليا الَّتي لَيسَ كَالصَفا","صَفاها وَما إِن كَالصُخورِ صُخورُها",2,"ر",3,0],["مِنَ الهوجِ مِصلاتاً كَأَنَّ جِرانَها","يَمانٍ نَضا جَفنَينِ فَهوَ دَلوقُ",3,"ق",1,0],["من الهيفِ لو شاءت لقامت بكأسها","وخاتمُها في خصرها متختَّمُ",4,"م",1,0],["مِنَ الهوجِ خَرقاءُ العَنيقِ مُطارَةُ ال","فُؤادِ بَراها بَعدَ إِبدانِها الضُمرُ",5,"ر",1,0],["مِنَ الهاتِكاتِ القَلبَ أَوَّلَ وَهلَةٍ","وَما دَخَلَت لَحماً وَلا لامَسَت عَظما",6,"م",2,0],["مِنَ الهاشِمِيِّينَ الأُلى كُلَّما دَنَوا","إِلى هاشِمٍ خُصّوا بِأَعلى المَناقِبِ",7,"ب",1,0],["مِن آلِ هاشِمَ مِن سَناءٍ باهِرٍ","وَمُهَذبينَ مُتَوّجينَ كِرامِ",8,"م",1,0],["مِنَ الهيفِ لَو أَنَّ الخَلاخِلَ صُيِّرَت","لَها وُشُماً جالَت عَلَيها الخَلاخِلُ",9,"ل",1,0],["مِنَ الْهِيفِ أَمَّا نَعْتُ مَا فِي إِزَارِهَا","فَرَابٍ وَأَمَّا خَصْرُهَا فَهَضِيمُ",10,"م",1,0],["مِنَ الهيفِ أَمّا رِدفُهُ فَمُنَعَّمٌ","خَصيبٌ وَأَمّا خَصرُهُ فَجَديبُ",11,"ب",1,0],["مِنَ الهوذِ كَدراءُ السَراةِ وَبَطنُها","خَصيفٌ كَلَونِ الحَيقُطانِ المُسَيَّحِ",12,"ح",1,0],["مِنَّا لَهُ العُذْرُ فيما حَلَّ يَقْبَلُهُ","إمَّا بِرَسْمٍ مِدَادٍ أوْ لِصابُونِ",13,"ن",1,0],["مِنَ الهاشِمِيِّينَ الدُعاةِ إِلى الهُدى","جِهاراً وَمَن يَهديكَ مَثلُ اِبنِ هاشِمِ",14,"م",1,0],["من الهوى وَتباري","حه اِشتَكَت واشتكيتُ",15,"ت",1,1],["مِنَ الهِيفِ مَيْدَانٌ تَرَى نَطَفَاتِهَا","بِمَهْلِكةٍ أَخْرَاصُهُنَّ تَذَبْذَبٌ",16,"ب",1,0],["مِنَ الهِنْدُوانِيّاتِ في كلِّ قِطْعَةٍ","دَمٌ زَلَّ عَنْ أَثْرٍ مِنَ السَّيْفِ ظَاهِرِ",17,"ر",1,0],["من الهاتف الداعي؟ أقيس أرى","ماذا وقوفك والفتيان قد ساروا",18,"ر",3,1],["مِنَ الْهيفِ مِقْلاقُ الْوِشَاحَيْنِ غَادَةٌ","سَلِيمَةُ مَجْرَى الدَّمْعِ رَيَّا الْخَلاخِلِ",19,"ل",1,0],["مَنَالُهُ صَعْبٌ وَأَنْصارُهُ","جِدُّ قَلِيلٍ وَالعِدَى كُثْرُ",20,"ر",1,0],["من الهوى آه","والصب اواه",21,"ا",2,1],["من الهاشميين الجحاجح سادة","لهم رتبة التعظيم بين البرية",22,"ه",1,0],["مِن آلِ هاشمَ راحلٌ نَزَلَ الثَرى","فَسَقَت شَآبيبُ المَدامعِ لَحدَهُ",23,"د",2,1],["من الهوى أن من تهواه ممتنع","فالنوم ممتنع والقلب في كرَب",24,"ب",1,0],["من الهوى والأماني","ومن زهور الجنان",25,"ن",1,0],["مَن آلُهُ آلُ النَبِي","يِ وَجَدُّهُ جَدُّ الرَسولِ",26,"ل",1,0],["مِنَ الهَيفِ أَعداني النُحولَ بِخَصرِهِ","وَأَمرَضَني تَفتيرُ أَجفانِهِ المَرضى",27,"ض",2,0],["من الهيفِ صفراوانِ أَنّي أُتيحَتا","لِعَينيَّ إِنّي مهتَدٍ أَو مضَلَّلِ",28,"ل",1,0],["من الهاشمي الطيب الطاهر الَّذي","اليه العلا وَالفَضل وَالفَخر ينسب",29,"ب",1,0],["مِنَ الهِيفِ قَد رَقَّت جُلوداً تَصونُها","وَأَوجُهُها قَد دَقَّ مِنها المَناخِرُ",30,"ر",1,0],["من الهيِفِ أمّا فوقَ عَقْدِ قَبائه","فَخُطوطٌ وأمّا تحته فكثيب",31,"ب",1,0],["من الهمم التي عرفته طفلاً","ومن روض المروءات الخصيب",32,"ب",1,0],["من الهِيفِ حين يجورُ النسيمُ","على غصنها لا تُطيق انتصارا",33,"ر",2,0],["من الهيف إلا ردنها فهو ذو غنى","يرجى وأما خصرها فقير",34,"ر",1,0],["من الهيف أمَّا قلبها مثل قلبها","فيقسو وأما قدُّها فيلين",35,"ن",1,0],["مِنَ الهوجِ لم تغلْ واِنْ كظَّها السُّرى","الى كلَّ حيًّ نازحٍ وقبيلِ",36,"ل",1,0],["من الهوانِ عاد كَفِّ","ي مَلَكاً مُحَجَّبَا",37,"ب",2,0],["مِن آل هاشم سادة العرب الأُلى","بين البريّة فضلهم لا ينكرُ",38,"ر",1,0],["منَ الهاشميّين الألى سار ذِكرهم","ومعروفهم في طارقات النوائبِ",39,"ب",1,0],["مِن آلهِ الأطهارِ قد","لاحَت بغرّتهِ علائِم",40,"م",1,0],["مِنَ الهيفِ لَو وَشَّحتَها بِسِوارِها","وَخِلخالِها كادَ السِّوارُ يَجُولُ",41,"ل",1,0],["من الهاشميين الذين بمجدهم","تعوَّد شخصُ المجدِ جرّ أُفولهِ",42,"ل",2,0],["منَ الهيفِ لسعا الثغرِ خمصانة الحشا","خدلّجة الساقين ريّا السواعدِ",43,"د",1,0],["من إله قرَّر الكشفَ له","إنه المعبودُ حالُ نكره",44,"ر",2,0],["مِنْ آلِهِ الأمجادِ إنّهمو","سبقوا الكِرَامَ لِوْرِدَها الشَّبِمِ",45,"م",1,0],["مِنَ الهائِباتِ السَّهلِ في مُشَمخِرة","بِحَيدِ وَعولٍ يأَمَنُ القَومَ فادِرُه",46,"ر",2,0],["من الهيف خط الحسن في نور وجهه","حروف جمال لا أقيس بها حرفا",47,"ف",2,0],["مِن آلِ هاشِمٍ الذينَ تَمَوَّلُوا ال","كَرَمَ الأَصِيلَ وَلِلكِرامِ أَعارُوا",48,"ر",3,0],["مِنْ آلة الدستِ لمْ يُعْطَ الوزير سِوى","تحريكِ لحيته في حالِ إِيماء",49,"ا",2,1],["من الهيف يشكو الضعف مرهف خصرها","واني منها أشكي ما اشتكى الخصر",50,"ر",1,0],["من الهِيفِ بالصَّبِّ الشّجِيِّ مُهانِفٌ","إِذا ما بَكَى وَجْداً لَدَيْهِ تَبَسَّما",51,"م",2,0],["مِن الهَولِ وَالاِشجانِ وَالسَقمِ وَالجَوي","وَلا زِلتُ اِطوي في القِقار عَلى الطَوى",52,"ط",3,0],["مِنَ الهَجرِ لما ظلُّ وَصلي تَقَلَّصا","عَلى اِنَّني اولَيتهُ الوُدَّ مُخلِصاً",52,"ص",2,0],["من آلة الإحساس والحياة","والقوت والرزق إلى الممات",53,"ت",1,0],["من الهم في قلبي أطلت غمامةٌ","لها كل يوم في الشجون انسجامة",54,"ه",1,1],["من آل هاشم الرفيع جنابهم","والمكرمين الجار حيث يضام",55,"م",1,0],["من الهدايا قد اخترت النعال لكي","ينوب عني في تقبيله قدمك",56,"ك",1,0],["من إله السما أتى بكتابٍ","عطَّر الله من شذاه الرحابا",57,"ب",2,0],["مِن الهِجرَةِ الأَولَى إِلى الهِجرَةِ التي","سَتَأتِي.. وما عِندِي سِوى الجَمرِ لاقِطُ",58,"ط",1,0],["من الهناء ارتوت روحي وفيه سما","طهر الشعور حروفا في قراطيسي!",59,"ي",1,0],["من الهاجس لىا الهاجس على الهاجس من الراسى","تبادلنى شعورى يوم ابعدهاواقربها",60,"ب",3,0],["25 – مَنْ ألهمَ الوحيَ أشعاري وقافيتي","إلاكَ مذْ أنعشتْ أنفاسُكَ الرَّمقا",61,"ق",2,0],["من ألهم الريحَ أنْ هبّت بأضلعنا ؟","من أقنع النار أنّ القلبَ من حطب!!؟؟",62,"ب",1,0],["مِنَ الهِيفِ لَعْسا الثَّغْرِ خَمْصانَةُ الحَشا","خَدَلَّجَةُ السَّاقَيْنِ رَيَّا السَّواعِدِ",63,"د",1,0],["من الهوان شذوذ الغرب يشتمنا","في ديننا وبنا صمت من البُكُمِ",64,"م",1,0],["من الهضب للافلاج مكدين","ضدهم وحريبهم مر المذاق عشاه",65,"ا",2,0],["من ألهمَ العصفورَ يشدو لحنهُ","مترنمًا يُشجي الوجودَ فأطربا",66,"ب",2,0],["من الهيف يشكو خصره ظلم ردفه","ولا عجب أن يقهر الأضعف الأقوى",67,"و",2,0],["منالُها صعبٌ إذا ما رُمْتَها","ما للظبا أنْ تُقتنى كالأينُقِ",68,"ق",1,0],["من الهجران والحرمان","والأشواق أن تحضر",69,"ر",1,0]]}