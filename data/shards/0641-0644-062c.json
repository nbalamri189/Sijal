{"poems":[[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[45,"قلت للائم في الحب أفق","https://www.aldiwan.net/poem65180.html","الرمل"],[45,"أتراه يظنني أو يراني","https://www.aldiwan.net/poem66786.html","الخفيف"],[66,"صاحب السيف الصقيل المحلا","https://www.aldiwan.net/poem39637.html","المديد"],[80,"وكأنها نون تمط وعينها","https://www.aldiwan.net/poem31236.html","الكامل"],[80,"أجمل على بخل الغواني وإجمال","https://www.aldiwan.net/poem31339.html","الطويل"],[167,"دع الكاعب الحسناء تهوي ركابها","https://www.aldiwan.net/poem1600.html",""],[183,"هجر العذول وراح طوع غواته","https://www.aldiwan.net/poem14131.html","الكامل"],[280,"تبنى الممالك بالوشيج الأسمر","https://www.aldiwan.net/poem32790.html","الكامل"],[295,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[295,"يا كوكبا لم تحوه الأفلاك","https://www.aldiwan.net/poem33205.html","الكامل"],[301,"لا تتعجب إن عدمت الصفا","https://www.aldiwan.net/poem58285.html","السريع"],[450,"خذ بنا في محاسن الأوصاف","https://www.aldiwan.net/poem13842.html","الخفيف"],[456,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[456,"لمن طل بلِوى عاقِلِ","https://www.aldiwan.net/poem55998.html","المتقارب"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["فَلِجِبريلَ جَيئَةٌ وَرَواحٌ","وَهُبوطٌ إِلى الثَرى وَاِرتِقاءُ",0,"ا",2,0],["فَلَجي لَو أَنَّ فَقراً أَو غِنىً","يُستَدامانِ بِكيسٍ أَو حُمُق",1,"ق",1,0],["فَلَجَت حُجَّةُ المَوالي ضِراباً","وَطِعاناً لَمّا إِلتَقى الخَصمانِ",2,"ن",1,0],["فَلَّ جَيشَ اللَيلِ لَم","ما أَلَمّا",3,"م",2,0],["فلجسمها والصبحُ يتبع نورَهُ","من جفنِ ليلتها انسلالُ المرودِ",4,"د",1,0],["فَلَجُّوا وقَالوا جَنَّةٌ كَذَّبَتْ بِها","ظنونٌ ظنَنّاها ويا صِدْقَ ما قالوا",5,"ل",3,0],["فلِج بِسلامٍ آمِناً تَلقَ بَلدَةً","مُقَدَّسَةَ الأَكنافِ رَحباً جَنابُها",6,"ب",3,0],["فَلَجا إلى حَرَم ابنِ عثمانَ الذي","لَبَّت له الآمالُ من مِيقاته",7,"ت",2,0],["فَلِجَيشِهِ وَلِعَزمِهِ مُتَضائِلٌ","جَيشُ الهِرَقلِ وَعَزمَةُ الإِسكَندَرِ",8,"ر",1,0],["فلجأَوا إِليها","ووقَعوا عليها",9,"ه",2,0],["فلجيدِه دُرَرُ المدائح تُنتَقى","وَلجوده بُردُ الثَناءِ يُحاكُ",10,"ك",1,0],["فلجةُ الأفق إذا ما صفت","في اليوم يرميها الدجا بالكدر",11,"ر",1,0],["فلَجَمْعُ الأحباب بعد التصافي","نعمة سيّما مع الأسعاف",12,"ف",1,0],["فِلجِ الثرى الراوي فقلْ لمحمّدٍ","عن ذي فؤادٍ بالفجيعة مشعَلِ",13,"ل",1,0],["فَلجتَ بها قاطعاً للخصوم","وقد فُضَّ عنها فمُ الفاصلِ",14,"ل",1,0],["فلج في الجور ولم يخله","ولم يطب نفسا له بعزله",15,"ه",1,0]]}