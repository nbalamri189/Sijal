{"poems":[[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[47,"قلت للائم في الحب أفق","https://www.aldiwan.net/poem65180.html","الرمل"],[47,"أتراه يظنني أو يراني","https://www.aldiwan.net/poem66786.html","الخفيف"],[68,"صاحب السيف الصقيل المحلا","https://www.aldiwan.net/poem39637.html","المديد"],[82,"وكأنها نون تمط وعينها","https://www.aldiwan.net/poem31236.html","الكامل"],[82,"أجمل على بخل الغواني وإجمال","https://www.aldiwan.net/poem31339.html","الطويل"],[173,"دع الكاعب الحسناء تهوي ركابها","https://www.aldiwan.net/poem1600.html",""],[189,"هجر العذول وراح طوع غواته","https://www.aldiwan.net/poem14131.html","الكامل"],[287,"تبنى الممالك بالوشيج الأسمر","https://www.aldiwan.net/poem32790.html","الكامل"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[302,"يا كوكبا لم تحوه الأفلاك","https://www.aldiwan.net/poem33205.html","الكامل"],[308,"لا تتعجب إن عدمت الصفا","https://www.aldiwan.net/poem58285.html","السريع"],[457,"خذ بنا في محاسن الأوصاف","https://www.aldiwan.net/poem13842.html","الخفيف"],[463,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[463,"لمن طل بلِوى عاقِلِ","https://www.aldiwan.net/poem55998.html","المتقارب"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63871","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63933","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37893","الخفيف"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72340","الكامل"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124311",""],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95496","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79842","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108859","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108762","الطويل"],[2518,"","https://poetry.dctabudhabi.ae/diwan/poem/146563","الوافر"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132315","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137117",""],[2786,"","https://poetry.dctabudhabi.ae/diwan/poem/132217","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67988","البسيط"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89076","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74102","الكامل"],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104838","الوافر"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59510","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123522","المنسرح"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97064","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136718",""],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83136","الخفيف"],[4472,"","https://poetry.dctabudhabi.ae/diwan/poem/144575","المنسرح"],[4927,"يا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=12986",""],[4984,"أثر الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=191621",""],[5111,"أرجُ اللقاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=212130",""],[5136,"دام في روضة النعيم تغنيه","https://www.poetsgate.com/ViewPoem.aspx?id=121797",""],[5136,"الحق أبلج واضح للمهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=121802",""],[5183,"نهر الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=186612",""],[5431,"أقسى من الليل ...","https://www.poetsgate.com/ViewPoem.aspx?id=210254",""],[5751,"بيت الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=214721",""],[402,"أهدي إلى عالي المقام","https://www.poetsgate.com/ViewPoem.aspx?id=36221",""],[5895,"نبض النيل","https://www.poetsgate.com/ViewPoem.aspx?id=198611",""]],"verses":[["فَلِجِبريلَ جَيئَةٌ وَرَواحٌ","وَهُبوطٌ إِلى الثَرى وَاِرتِقاءُ",0,"ا",2,0],["فَلَجي لَو أَنَّ فَقراً أَو غِنىً","يُستَدامانِ بِكيسٍ أَو حُمُق",1,"ق",1,0],["فَلَجَت حُجَّةُ المَوالي ضِراباً","وَطِعاناً لَمّا إِلتَقى الخَصمانِ",2,"ن",1,0],["فَلَّ جَيشَ اللَيلِ لَم","ما أَلَمّا",3,"م",2,0],["فلجسمها والصبحُ يتبع نورَهُ","من جفنِ ليلتها انسلالُ المرودِ",4,"د",1,0],["فَلَجُّوا وقَالوا جَنَّةٌ كَذَّبَتْ بِها","ظنونٌ ظنَنّاها ويا صِدْقَ ما قالوا",5,"ل",3,0],["فلِج بِسلامٍ آمِناً تَلقَ بَلدَةً","مُقَدَّسَةَ الأَكنافِ رَحباً جَنابُها",6,"ب",3,0],["فَلَجا إلى حَرَم ابنِ عثمانَ الذي","لَبَّت له الآمالُ من مِيقاته",7,"ت",2,0],["فَلِجَيشِهِ وَلِعَزمِهِ مُتَضائِلٌ","جَيشُ الهِرَقلِ وَعَزمَةُ الإِسكَندَرِ",8,"ر",1,0],["فلجأَوا إِليها","ووقَعوا عليها",9,"ه",2,0],["فلجيدِه دُرَرُ المدائح تُنتَقى","وَلجوده بُردُ الثَناءِ يُحاكُ",10,"ك",1,0],["فلجةُ الأفق إذا ما صفت","في اليوم يرميها الدجا بالكدر",11,"ر",1,0],["فلَجَمْعُ الأحباب بعد التصافي","نعمة سيّما مع الأسعاف",12,"ف",1,0],["فِلجِ الثرى الراوي فقلْ لمحمّدٍ","عن ذي فؤادٍ بالفجيعة مشعَلِ",13,"ل",1,0],["فَلجتَ بها قاطعاً للخصوم","وقد فُضَّ عنها فمُ الفاصلِ",14,"ل",1,0],["فلج في الجور ولم يخله","ولم يطب نفسا له بعزله",15,"ه",1,0],["فلِجُلاَّسِه إذا أنكرَ السك","رَ جليسٌ فضلٌ على الجلاَّس",16,"س",1,0],["فَلَّ جيشَ الآداب مَن كان فيها","موفياً وحْدَه على ألفِ جيش",17,"ش",1,0],["فَلِجيدي الهناءُ فيها تَحَلَّى","وَلَهُ السَّعدُ غِبَّ ذاك الهناءِ",18,"ا",2,0],["فَلِجيدي جعلتَها عِقدَ دُرٍّ","وَهيَ تَبدو لِلعبدِ عَقْدَ ولاءِ",18,"ا",2,0],["فلجا من الحشد الذي قد غره","عدداً لحصن لم يكن بحصين",19,"ن",1,0],["فلج بنا الشيطان في الغيِّ وانتحى","بنا بطن حِقفٍ ذي ركام عقنقل",20,"ل",1,0],["فلجأتُ للمختار أطلب غَوثَه","فأزال عُقدةَ منطقى وبيانى",21,"ن",2,0],["فلجدِّه البُشرى وأين كجدِّه","لا تطلبنَّ سوى ذُكاءِ ذُكاءا",22,"ا",3,0],["فلجلق اليوم المسرة والهنا","والفوز بعد تقادم الأيام",23,"م",1,0],["فلجَّ وقال الأمر للَه وحده","وأعرض عني عابساً متأففا",24,"ف",2,0],["فلج الطبع وانسد المعاني","لما في الصدر من غصص تردد",25,"د",1,0],["فلجاءُ في الشَّهداتِ بينَ شِفاهِها","رُوحي لو انِّي ذُقتُ مِن رشفاتِها",26,"ت",3,0],["فلجبران كنت خير نصير","وبه للعلا رعيت الذماما",27,"م",2,0],["فلج معاهدها واقصد حدائقها","ذات ابتهاج بقرب نهرها الهائج",28,"ج",1,0],["فلَجَّ من شَغَفٍ بالرَّكْبِ يُزْعجه","والبينُ يَصْرعه والشوقُ يَحْتدم",29,"م",1,0],["فلجيوش الهواء كن متشتتا","نصحتك فاقبل يا لبيب نصيحة",30,"ه",1,0],["فلجامع الخيرات قلت مؤرخاً","بشرى لنائلة المطال بمسجد",31,"د",1,0],["فَلجنّةٍ هَذا وَذا","يَلقى الجَزاء جهنّما",32,"م",2,0],["فلج القلب بالزفرات حتى","لقد بلغت بي الروح التراقي",33,"ق",2,0],["فُلجُ الثَغورِ إِذا اِبتَسَمنَ ضَواحِكاً","هيفُ الخُصورِ نَواعِمُ الأَبدانِ",34,"ن",1,0],["فلجا لأرطاةٍ والجأ","ه لها صوب الغَمامِ",35,"م",1,0],["فلجأت في لرنيسةٍ وأنا","هدمت من لرنيسة العمدا",36,"د",2,0],["فلج حماه ولذ به تره","برّا كريما لك المنى ضمنا",37,"ن",2,0],["فل جدي وثل مجدي فقوموا","وأزيلوا عن الرؤوس الترابا",38,"ب",2,0],["فلج غرامي فيه حينَ وجدته","زعيماً بأغراض العلى والمكارم",39,"م",1,0],["فَلَّجَت بَينَها مُنافَسَةُ الحُسنِ","فَكُلٌّ بِحَظِّهِ مِنهُ يُتبي",40,"ب",2,0],["فلَجَّ حتى تقاذفَت بكُمُ","على مطايا الفراق غِيظان",41,"ن",1,0],["فَلَجَتْ عُلُوْجَ الطَّاْمِعِيْنَ بِفَاْلِجٍ","أَفْنَى الْعُلُوْجَ، فَوَلْوَلَ الأَوْغَاْدُ",42,"د",1,0],["فَلَجُلُّ ما نأتيه من رغباتنا","لَهْوَ التليد ويُنتقى من جُلِّه",43,"ل",2,0],["فَلَجَّمْتُ الْجُمُوحَ بِصًمْتِ رُوْحِيْ","وَصُغْتُ لَكِ الْحَنِيْنَ إذِ اسْتَبَاحَا",44,"ح",2,0],["فلجيد العلياء منه عقود","ولعطف الفخار منه وشاح",45,"ح",1,0],["فلجعد الطيا أحسن أسوة","لهم ويا لك قدوة للمقتدي",46,"د",2,0],["فلج به منها على الدرب سابح","وعج اليها عنه بالمهر راكبه",47,"ب",2,0],["فلجة النور مايحمي سفائننا","عند انقلابات جوٍّ هاج واخترقا",48,"ق",2,0],["فَلَجْلَجَ غُصْنُ الضَّوء فيهِ وأزهرَتْ","عِمارةُ آمالٍ ، تُريهِ اتّصالَهُ",49,"ل",2,0],["فلجعلن كتابها","حتى أحققه إمامي",50,"م",2,0],["فلُجَيْنٌ سَالَ على تِبْرٍ وَتَعانَقَ بدرٌ قد أسْفَرْ","يا نيلُ أتشكو لى سِرَّاً ؟ بعيونكَ شَيءٌ يتحجَّرْ!",51,"ر",1,0]]}