{"poems":[[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[45,"قلت للائم في الحب أفق","https://www.aldiwan.net/poem65180.html","الرمل"],[45,"أتراه يظنني أو يراني","https://www.aldiwan.net/poem66786.html","الخفيف"],[66,"صاحب السيف الصقيل المحلا","https://www.aldiwan.net/poem39637.html","المديد"],[80,"وكأنها نون تمط وعينها","https://www.aldiwan.net/poem31236.html","الكامل"],[80,"أجمل على بخل الغواني وإجمال","https://www.aldiwan.net/poem31339.html","الطويل"]],"verses":[["فَلِجِبريلَ جَيئَةٌ وَرَواحٌ","وَهُبوطٌ إِلى الثَرى وَاِرتِقاءُ",0,"ا",2,0],["فَلَجي لَو أَنَّ فَقراً أَو غِنىً","يُستَدامانِ بِكيسٍ أَو حُمُق",1,"ق",1,0],["فَلَجَت حُجَّةُ المَوالي ضِراباً","وَطِعاناً لَمّا إِلتَقى الخَصمانِ",2,"ن",1,0],["فَلَّ جَيشَ اللَيلِ لَم","ما أَلَمّا",3,"م",2,0],["فلجسمها والصبحُ يتبع نورَهُ","من جفنِ ليلتها انسلالُ المرودِ",4,"د",1,0],["فَلَجُّوا وقَالوا جَنَّةٌ كَذَّبَتْ بِها","ظنونٌ ظنَنّاها ويا صِدْقَ ما قالوا",5,"ل",3,0]]}