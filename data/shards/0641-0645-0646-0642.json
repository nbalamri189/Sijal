,[4884,"غَدْرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=202179",""],[4884,"الحب البصير","https://www.poetsgate.com/ViewPoem.aspx?id=212246",""],[557,"كان حلما","https://www.poetsgate.com/ViewPoem.aspx?id=13848",""],[4984,"الإضراب","https://www.poetsgate.com/ViewPoem.aspx?id=196918",""],[3271,"راهب النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=104128",""],[5120,"أحبك ..","https://www.poetsgate.com/ViewPoem.aspx?id=210811",""],[5145,"نسيم الصبا بادر بهبتك الفجرا","https://www.poetsgate.com/ViewPoem.aspx?id=108203",""],[5189,"ألاَ تعجب","https://www.poetsgate.com/ViewPoem.aspx?id=197132",""],[5323,"انسكاب الشعور","https://www.poetsgate.com/ViewPoem.aspx?id=207292",""],[592,"ألم تر أن الصبر أجمل بالفتى","https://www.poetsgate.com/ViewPoem.aspx?id=128852",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5413,"عقيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=200595",""],[5414,"زيارة فوق العادة للخيول العربية","https://www.poetsgate.com/ViewPoem.aspx?id=12930",""],[5490,"نساء","https://www.poetsgate.com/ViewPoem.aspx?id=176174",""],[5558,"لَقدْ فَرِغَ الجَيبُ الذي كان مُتخَما","https://www.poetsgate.com/ViewPoem.aspx?id=212418",""],[5638,"فلتفخري مصرُ","https://www.poetsgate.com/ViewPoem.aspx?id=198248",""],[5701,"لقد لمناه في حب الغواني","https://www.poetsgate.com/ViewPoem.aspx?id=164657",""],[2395,"أيا علماء العصر يا من لهم خبر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=583278",""],[6072,"دَوّامات الندى والغياب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85443&r=&rc=30",""]],"verses":[["فَمِن قَبلِ ما اِختارَ اِبنُ الاَشعَثِ عَيشَهُ","عَلى شَرَفٍ باقٍ رَفيعِ الدَعائِمِ",0,"م",1,0],["فَمِنْ قَبْلِ أَنْ يُقْضَى إِلى الفِكْرِ وَحْيُهُ","وَتَمْلَأَ أَفْواهَ الرُّواةِ القَصائِدُ",1,"د",1,0],["فَمِنْ قَارِعٍ في قَوْمِهِ سنَّ نَادِمٍ","وَمِنْ لاَطِمٍ فِي رَفْعِهِ خَدَّ نَادِبِ",2,"ب",1,0],["فَمَن قاسَ المُلوكَ إِلَيهِ جَهلاً","كَمَن قاسَ النُجومَ إِلى بَراحِ",3,"ح",1,0],["فَمِن قُضُبٍ تَتَثَنّى بِريحٍ","وَمِن قُضُبٍ تَتَثَنّى بِدَلّ",4,"ل",1,0],["فَمَن قالَ أَن لَستُما أَوحَدَي","نِ في الصالِحاتِ فَما وَحَّدا",5,"د",2,0],["فمن قطع قد انتثرت صغاراً","فكانت كالعهون لدى انتفاش",6,"ش",1,0],["فمن قام باسم الدين يدعو مُفّرِقاً","فدعواه في أصل الديانة بُهتان",7,"ن",1,0],["فمن قامر قد فاز باليُسرِ قدحه","وآخَر مقمور بقِدح التصعلُك",8,"ك",1,0],["فمن قال للأعداء حلواء ملككم","ونحن إليكم كالموالهة العُجْلِ",9,"ل",1,1],["فَمَن قامَ يَمدَحُني بَينَكُم","فَقَد تُمدَحُ الكَفُّ بِالإِصبَعِ",10,"ع",1,0],["فَمَنقَصَةٌ في هَذِهِ وَمَذَلَّةٌ","وَشَرٌّ شِمِرٌّ بَينَكُم مُتَفاقِمُ",11,"م",1,0],["فمنْ قَمرٍ يُبقي على الأفق بَعْدَهُ","هلالاً ومن ليث خليفته شبلُ",12,"ل",1,0],["فَمِن قَبلِهِ ما قَد أُصيبَ نَبِيُّنا","أَبوالقاسِمِ النورُ المُبينُ بِقاسِمِ",13,"م",1,0],["فمن قومكَ الصِّيدُ صِيدُ الملوكِ","ومن قومها الأُسدُ أُسْدُ الشرى",14,"ا",1,0],["فمن قائل جسم على عرشه استوى","ومن قائل نور زها في المشارق",15,"ق",1,0],["فمن قوافيهِ استمدَّ النواحْ","ومن أغانيه صدى لحنهِ",16,"ه",1,0],["فَمَن قالَ خَيراً قيلَ إِنَّكَ صادِقٌ","وَمَن قالَ شَرّاً قيلَ أَنتَ كَذوبُ",17,"ب",1,0],["فمِن قارع في قومِه سِنَّ نادِم","ومِنْ لاطِمٍ في خدِّه خَدَّ نادِبِ",18,"ب",1,0],["فمنقصة ٌ في هذهِ وَ مذلة ٌ","وَ شرٌّ بينكمْ متفاقمُ",19,"م",1,0],["فَمِن قَبلِهِ لَم تَنشَ في الأَرضِ ديمَةٌ","تَسُحُّ وَلا لاقى الغَمامُ مُبَخِّلا",20,"ل",2,0],["فمن قال قال الله لي بعد أحمد","فتكذيبه من كل أوجب أوجب",21,"ب",1,0],["فَمِن قَبلِ ذا عاذَت بِأَكنافِ هانِئٍ","بَنُو مُنذِرٍ إِذ عارَضَتها الغَوائِلُ",22,"ل",1,0],["فَمَن قالَ صلّوا قال قائلهم له","يَجوزُ لَنا في البيتِ نَجمعُها قَصرا",23,"ر",2,0],["فَمَن قالَ كالكلبِ العقور فصادقٌ","سِوى أنّهُ في الدينِ قَد فعَل العَقرا",23,"ر",2,0],["فَمَن قالَ عُلوٌ كلّها فهوَ صادقٌ","وَذلكَ قَد يَقضي بِآلهةٍ أخرى",23,"ر",2,0],["فمن قائلٍ آثرت سرَّاً محمداً","وآخرُ إبراهيمَ تُؤْثِرُ في السرِّ",24,"ر",1,0],["فمن قاس بالانواء نائل جوده","فقد زاد حدا في القياس وقد خطا",25,"ط",2,0],["فمن قده يخشى عليك اذا انثنى","ومن لحظه يخشى عليك اذا رهف",26,"ف",1,0],["فمن قاسه بالليث لاشك ما درى","ومن قاسه بالغيث لا شك ما عرف",26,"ف",1,0],["فمن قومُهُ قومي أدينُ بدينهِ","لأني أرى الاسلامَ روحَ العروبة",27,"ه",1,0],["فَمَنْقُودٌ مِنَ الإعْطَاءِ هَامٍ","ومَوْعُودٌ مِنَ الإحْظَاء نَامِ",28,"م",1,0],["فمِنْ قَلبٍ تَملَّكَه التصَابي","وَمن جَسَدٍ تَعَشَّقَهُ النحولُ",29,"ل",1,0],["فَمِن قَدِّهِ المُهتَزِّ يَخطو بِذابِلٍ","وَمِن لَحظِهِ المُعتَزِّ يَسطو بِمِخذَمِ",30,"م",1,0],["فمن قيس ليلى العامرية في الهوى","ومن قيس لبنى أو كثير عزة",31,"ه",1,0],["فمِنْ قبلُ بينَ نَبِيِّيْ هُدىً","جنَى السّامرِيُّ خصاماً مُبِينا",32,"ن",2,0],["فمن قبلُ في تَشريفك اللهُ بالغَتْ","عناياتُه حتّى كبَتْنَ عِداكا",33,"ك",2,0],["فمِن قبلِ الشَيبِ لم يَصْفُ مَشْربٌ","لِعَيْشي وأغصانُ الشبابِ رِطاب",34,"ب",1,0],["فمن قبله قلبُ الشجيين شيِّقٌ","ومن بعده كبْدُ الخليين تُصدَع",35,"ع",1,0],["فمن قائلٍ بالجزم والحزم والحجى","ومن قائلٍ إفكاً بسوء العقيدة",36,"ه",1,0],["فَمَنْ قد كَان قبلكَ مِن بَنيها","زَوالْهُمُ يَدُلُّ عَلى زَوالِكْ",37,"ك",1,0],["فمن قلَّد النعمان أصبح شارباً","نبيذاً وفيه القول للبعض بالحد",38,"د",1,0],["فمَنْ قسّ ومن سحبانُ أيضاً","متى ذكروه في نُطْقِ اللسانِ",39,"ن",1,0],["فمن قبل هذا أُحسد الفضل آدم","فبدل من فردوسه الجبل الشرقي",40,"ق",2,0],["فمن قال آلُ بويه الملوكُ","هُمُ آلُ عباسَ لم يُدفَعِ",41,"ع",1,0],["فمن قاعدٍ منهُمُ خائف","ومِن ثائرٍ قامَ لم يُسعَدِ",42,"د",1,0],["فمن قائل فصلاً ومن باذلٍ ندى","ومن قاتلٍ نصلاً ومن غافرٍ ندب",43,"ب",1,0],["فمن قَلبُه مع غيرِه كَيف حالُه","ومن سرُّه في جفْنه كيف يكْتُم",44,"م",1,0],["فَمِن قائِمٍ خوفُ الإِلهِ شعَارُهُ","ومِن عاكفٍ خوفُ الحَبيبِ حُمَيّاهُ",45,"ا",2,0],["فمِن قدِّه ثارٌ مِن الحبِّ مُدرِكِي","ومِن خدِّهِ نارٌ بأَحشايَ شَبَّتِ",46,"ت",1,0],["فَمِن قَبلِهِ قَد طالَ مُوسَى وراجحاً","وطائفةٌ مِنكُم بأيدي الطَّوائف",47,"ف",1,0],["فَمِن قَبلُ قد أردَى عليَّ ابنُ مَلجَم","وقد حَزَّ رأساً مِن حَسينكم شَمرُ",48,"ر",1,0],["فَمن قائل عَما قَليل جَوادُهُ","بِهِ في الوَغى يَكبو وَيَنقاد للأَسر",49,"ر",1,0],["فَمن قاسه يَوماً بِكسرى وَقَيصر","أَجبناه عَن تِلكَ المَقالة بِالرَد",50,"د",1,0],["فمِن قُمرِيِّ إِنْ أبدى نحيباً","يُطارحُه بما يُخفي العَليلُ",51,"ل",1,0],["فمن قسمه القتل استراح من العنا","ومن سهمه الأسر استمر بلا فك",52,"ك",1,0],["فمن قصرٍ كسا تَقْبِيَ","هُ الحسنُ وتَسْفِيطه",53,"ط",2,0],["فَمَن قالَ زُهر الأفق لَيسَت بِبَدرهِ","فَدَعهُ فَإنّ البدرَ لَيسَ سِوى الزُّهرِ",54,"ر",1,0],["فَمَن قَد رَآها شامَ أَهدابَ عَينِهِ","قَدِ اِنطَبَعت فيها فَظَنَّ عذارا",55,"ر",2,0],["فمن قدها رُمْحٌ لقلبي انثناؤه","ومن لحظها عضبٌ على مُشهَّر",56,"ر",1,0],["فمن قائل لا بارك الله سعيه","ومن باعث لمحا اليك شفونا",57,"ن",2,0],["فَمِنْ قَدِّهِ ذابلٌ مُشْرَعٌ","ومِنْ جَفْنِهِ صارمٌ مُنْتَضَى",58,"ض",2,0],["فمن قال إني بالرحيل محدث","روت عنه أجفاني غريب ثبات",59,"ت",1,0],["فمن قل ذل ومن جاد ساد","ومن ساد ذاد ومن ذاد قادا",60,"د",2,0],["فمن قرا اسفار من قد مضى","جدد أعمارا إلى عمره",61,"ر",2,0],["فمن قد رآها قال من فرط حيرة","هي الكاس أم خد الحبيب أم الخمر",62,"ر",1,0],["فمن قبل كم عادت كريماً وأنكرت","حقوقاً له في أهلها وفواضلا",63,"ل",2,0],["فمن قائمٍ يرجى بخيلٍ إلى الوغى","وصم العوالي والصفيحِ المهندِ",64,"د",1,0],["فَمَن قَد فَرَّ عَنكُم مِن عَدُوٍّ","فَنَحوَكُمُ إِذا يَبغي الفِرارا",65,"ر",2,0],["فَمنقادَ البَليخِ فَحَيثُ حَفَّت","جَداوِلُهُ قُصُورَ الرَقَتَينِ",66,"ن",1,0],["فمن قال: بعض النور أسود صادق","ومن شاء غنى بالعراق وبالنوى",67,"ن",3,0],["فمن قبلث خان السرب لم يرعَ عهده","لها وعليها الحرب شبَّ وأضرما",68,"م",2,0],["فمن قامَ في غيِّه تابعاً","هوى نفسِه ذلك المجرمُ",69,"م",1,0],["فمن قام في الأفراد فالحدّ آجلٌ","ومن قام في التركيب برهانه النقد",70,"د",1,0],["فمن قال إن القول بالحدِّ واحد","فذلك قولٌ ليس يدريه من وعى",71,"ع",2,0],["فمن قلد الاراء ضل عن الهدى","ومن قلد المعصوم في الدين يهتدي",72,"د",2,0],["فَمِن قصرِهِ وإلى قصرِه","فطابَ مُعرَّسهُ والمَقيل",73,"ل",1,0],["فم نقتطف ثمرات المجد والشرف","من روضة لم تدع عذرا لمقتطف",74,"ف",1,1],["فَمَن قَيَّدَ الفرغَ الشماليَّ ستَّةً","ودَرِّجَ أُولَى النَّعشِ في ذلك القُطرِ",75,"ر",1,0],["فَمَن قَالَ مَيناً فالنُّجُومُ تُجيبُهُ","فَمَن غَيرُهُ يا غايباً غيرُ غايبِ",76,"ب",1,0],["فَمَن قَيَّدَ الفرغَ المُقَدَّمَ سَبعَةً","وقاسَ لأُولَى النَّعشِ ضَربَةَ لاَزِبِ",76,"ب",1,0],["فَمِن قَلائد يَعلُو الدُرُّ جَوهَرَها","وَمِن فَرائد يَجلُو نورُها الغَلَسا",77,"س",2,0],["فمن قلّة التميز حاليَ سيئٌ","وفعليَ معتلٌّ وهمِّيَ ممتدُّ",78,"د",1,0],["فمن قبلهم ناح الهدى لمصابه","وأجرى عليه عينه أدمعا حمرا",79,"ر",2,0],["فمن قبله عمت عليها مصائب","وكم شفيت من شدة الخطب اقوام",80,"م",1,0],["فمن قبل الديان للمرء واحد","ومن مصر ألف إن ذاك عجيب",81,"ب",1,0],["فَمِن قائِمٍ يَدعو إِلى الجَهلِ عامِداً","وَمِن أَوَّلِ قَد سَنَّ عَنّا لِآخِرِ",82,"ر",1,0],["فَمُنقَعطُ الرَيحين حاشا عِنانَهُ","وَراكَبَهُ بينَ المؤَخَّر وَالصَدرِ",83,"ر",1,0],["فمنْ قمرٍ شقّ حتى استبا","نَ من بين شقيه جرمُ الجبل",84,"ل",1,0],["فمنْ قائِل نجمُه قد بدا","ومن قائلٍ عصرهُ قد أطل",84,"ل",1,0],["فمن قاسه بفتى عصره","فقد قايس الدر بالمختلب",85,"ب",1,0],["فمَن قاسَني فيما أُقاسُ منَ الهَوى","بقَيْسٍ وليْلَى أخطأتْهُ المَقايِسُ",86,"س",1,0],["فمن قاس فيكم غيركم قاس ضلة","بدر حصى أو بان غابة سيد",87,"د",1,0],["فَمن قَد ماتَ في حُبٍّ شَهيداً","سَعيداً كانَ في دُنيا وَدينِ",88,"ن",1,0],["فمن قال أهوى أن أفارق هذه ال","حياة أجبه أنت في القول تكذب",89,"ب",1,0],["فمن قبله أودى المرادي غيلة","عليا وما في الأرض قرن يحاربه",90,"ب",2,0],["فمن قال إنك مثل الرجال","على عقله وعليه العفا",91,"ف",2,0],["فَمَن قالَ إِنَّ الحبَّ يَخفى لِذي الهَوى","إِذا ما رَأى أَحبابَهُ فَهوَ كاذِبُ",92,"ب",1,0],["فمن قائل عجل بقيدي فإنني","طليق ومن عان كثير التقلب",93,"ب",1,0],["فَمِنْ قَطَراتِ الرَّذإِذْ النِّثارُ","وُمِن وَشْيِ زَهْرِ الرَّبِيعِ المراتِبْ",94,"ب",1,0],["فَمِن قارِصٍ وَردَتي خَدِّها","وَمِن جاذِبٍ فَضلَ زُنّارِها",95,"ر",3,0],["فمن ق