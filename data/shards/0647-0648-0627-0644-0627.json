,"المتقارب"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135088","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136755",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72471","الطويل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136387",""],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136384",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120521","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120497","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120458","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120246","الوافر"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204312","الطويل"],[4679,"بذكراك لا ذكرى حبيبٍ ومنزلِ","https://www.poetsgate.com/ViewPoem.aspx?id=142719",""],[4691,"لفايزتي أهدي القريض المهذبا","https://www.poetsgate.com/ViewPoem.aspx?id=76771",""],[4755,"هو الآنَ يَنهارُ.. أَو يُوشِكُ","https://www.poetsgate.com/ViewPoem.aspx?id=201066",""],[4859,"هو الإحساس لا يفنى!","https://www.poetsgate.com/ViewPoem.aspx?id=208570",""],[4884,"حروفٌ أربعٌ","https://www.poetsgate.com/ViewPoem.aspx?id=202264",""],[669,"يا أهل كوفان إني وامق لكم","https://www.poetsgate.com/ViewPoem.aspx?id=19368",""],[4955,"مصير الحزن أن يرحل","https://www.poetsgate.com/ViewPoem.aspx?id=203790",""],[5009,"إبتهال","https://www.poetsgate.com/ViewPoem.aspx?id=68090",""],[585,"سل الدار هل في الدار من كنت تألف","https://www.poetsgate.com/ViewPoem.aspx?id=161868",""],[5093,"حكاية حب","https://www.poetsgate.com/ViewPoem.aspx?id=144989",""],[5135,"هُوَ الْإِنْسَانُ","https://www.poetsgate.com/ViewPoem.aspx?id=201880",""],[5145,"هنيئاً لدينٍ قد غدوت يمينه","https://www.poetsgate.com/ViewPoem.aspx?id=108174",""],[5145,"سقى السرح من وادي الآراك هطول","https://www.poetsgate.com/ViewPoem.aspx?id=108051",""],[5145,"أتجزع يا قلب أم تصبر","https://www.poetsgate.com/ViewPoem.aspx?id=108201",""],[5145,"ترى الجيرة قد جاروا","https://www.poetsgate.com/ViewPoem.aspx?id=108119",""],[5189,"الأخلاق","https://www.poetsgate.com/ViewPoem.aspx?id=190493",""],[5281,"الرَّحيل","https://www.poetsgate.com/ViewPoem.aspx?id=199315",""],[592,"تلألأ نور الحق في الخلق وانتشر","https://www.poetsgate.com/ViewPoem.aspx?id=128721",""],[5397,"بمد العمر قد ذهب الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=157906",""],[5397,"متى آمن الدنيا من الغدر أخدع","https://www.poetsgate.com/ViewPoem.aspx?id=157923",""],[5410,"مُباح اللهو في يدنا بناءُ","https://www.poetsgate.com/ViewPoem.aspx?id=152242",""],[5431,"هي الأقدار","https://www.poetsgate.com/ViewPoem.aspx?id=194659",""],[709,"عَرِّجْ عَلَى الْبَانِ وانْشُدْ فِي مَجَانِيْهِ","https://www.poetsgate.com/ViewPoem.aspx?id=2907",""],[5541,"الشيبانية .. سأحمد ربي طاعة وتعبدا","https://www.poetsgate.com/ViewPoem.aspx?id=119906",""],[5582,"أَهاجَتْ لَكَ التَّذْكارَ تِلْكَ المَعاهِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=63494",""],[5596,"وادي محرم","https://www.poetsgate.com/ViewPoem.aspx?id=206487",""],[5628,"زفرة على نعش غسان كنفاني","https://www.poetsgate.com/ViewPoem.aspx?id=178759",""],[2110,"هلال حسن هل يا من يراه","https://www.poetsgate.com/ViewPoem.aspx?id=156288",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[5701,"عجبت لصورة فيها سعود","https://www.poetsgate.com/ViewPoem.aspx?id=164677",""],[5762,"هو الإثمُ زلزل زلزالها","https://www.poetsgate.com/ViewPoem.aspx?id=177978",""],[5764,"قلبي كما هو","https://www.poetsgate.com/ViewPoem.aspx?id=161548",""],[5781,"سورية ما بين قلبي والمسافة بيننا","https://www.poetsgate.com/ViewPoem.aspx?id=202833",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5953,"تشخص للأنام فتشبهوه","https://www.poetsgate.com/ViewPoem.aspx?id=93843",""],[5961,"يسير بك المهيمن","https://www.poetsgate.com/ViewPoem.aspx?id=199772",""],[5963,"شاعرٌ في زمن الضَّياع","https://www.poetsgate.com/ViewPoem.aspx?id=187324",""],[5969,"طقوس العز","https://www.poetsgate.com/ViewPoem.aspx?id=198911",""],[5997,"أباكَ","https://www.poetsgate.com/ViewPoem.aspx?id=214261",""],[161,"لكل سؤال جواب وحل","https://www.poetsgate.com/ViewPoem.aspx?id=169334",""],[6142,"بديع كون تحلى بالوجود طلى","https://www.poetsgate.com/ViewPoem.aspx?id=155673",""],[6177,"شرايين التراب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79077&r=&rc=20",""],[6247,"حروف مهاجرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80264&r=&rc=3",""],[6300,"مصير آخر فارس عربيّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82875&r=&rc=46",""],[6318,"حب ووفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66154&r=&rc=4",""]],"verses":[["هُوَ الأَثَرُ المَحْمُودُ لَيْسَ يَنَالُهُ","دُثُورٌ وَلاَ يُخْشَى عَلَيْهِ عَفَاءُ",0,"ف",3,0],["هُوَ الأَثَرُ المَحمودُ إِن عادَ ذِكرُهُ","تَطَلَّعَتِ العَلياءُ وَاِستَشرَفَ المَجدُ",1,"د",1,0],["هُوَ الأَسْمَرُ العَبْلُ البَطِيءُ حَرَاكُهُ","وَلَكِنَّهُ رُوحٌ تَخِفُّ وَوِجْدَانُ",2,"ن",1,0],["هو الأضبَطُ الهَوَّاسُ فينا شَجَاعةً","وفِيمَن يُعَادِيهِ الهِجَفُّ المُثَقَّلُ",3,"ل",1,0],["هُوَ الإِمَامُ إِمامُ الحَقِّ نَعرِفُهُ","لا كاللَّذَينِ استَزَلاّنَا بِمَا ائتَمَرَا",4,"ر",2,0],["هو الإمام إمام الحق نعرفه","لا كالذين استرأ لاّنا بما أتموا",5,"م",3,1],["هو الاسم لكن نصفه فعلُ كله","إذا جعلت أسرار معناه تلمح",6,"ح",1,0],["هو الأجل القاضي على كل حائن","وفيه لمن أمْلى له اللَّه حارس",7,"س",1,0],["هو الأسدُ الوَرْدُ في قصرِهِ","ولكنَّه ثعلبُ المعْرَكَهْ",8,"ك",2,0],["هو الإياسُ أو الإيناسُ من كَثبٍ","فلا تدعْني من أَمريَّ في تيه",9,"ي",2,0],["هُوَ الأَميرُ الَّذي بادَت تَميمُ بِهِ","قِدماً وَساقَ إِلَيها حَينُها الأَجَلا",10,"ل",2,0],["هو الأدهُم اليحمومُ لكنْ جبينُه","بشادخةِ المجدِ النظاميِّ معصوبُ",11,"ب",1,0],["هو الأزهرُ الوضَّاحُ أَمّا مَهزُّه","فلَدْنٌ وأمّا عُودهُ فصليبُ",12,"ب",1,0],["هُوَ الأَقرَعُ الخَيرُ الَّذي كانَ يَبتَني","أَواخِيَ مَجدٍ ثابِتٍ أَن يُنَزَّعا",13,"ع",2,0],["هُوَ الأَحَدُ القَيومُ مِن بَعدِ خَلقِهِ","وَما زالَ في دَيمومَةِ الخَلقِ أَوَّلا",14,"ل",2,0],["هُوَ الإِضحَيانُ الطَلقُ رَفَّت فُروعُهُ","وَطابَ الثَرى مِن تَحتِهِ وَزَكا التُربُ",15,"ب",1,0],["هُوَ الأَوَّلُ السَّبَّاقُ فِي كُلِّ حَلْبَةٍ","وَأَنْتَ لَهُ دُونَ الْبَرِيَّةِ ثَانِي",16,"ن",2,0],["هُوَ الأَزْلَمُ الْخَدَّاعُ يَخْفِرُ إِنْ رَعَى","وَيَغْدِرُ إِنْ أَوْفَى وَيُصْمِي إِذَا رَمَى",17,"م",2,0],["هو الإسلامُ ما للنّاسِ واقٍ","سِواهُ فأين يَذهبُ من تَعامى",18,"م",2,0],["هو الإلحادُ إن جنحوا إليه","فقد علموا جَزاءَ المُلحِدينا",19,"ن",2,0],["هُوَ الإيمانُ لا دُنيا حَلوبٌ","يُعاشُ لها ولا مُلكٌ عَتِيدُ",20,"د",1,0],["هُوَ الإسلامُ إحسانٌ وَبِرٌّ","وأخْذٌ بالمُروءةِ وَاعْتِصامُ",21,"م",1,0],["هُوَ الإسلامُ يَجمعُنا فَلَسْنَا","بحمدِ اللهِ من أهلِ الشِّقاقِ",22,"ق",1,0],["هُوَ الإيمانُ مَن يشدُدْ قواهُ","يُزَلْزِل في الخطوبِ قُوى الجِبالِ",23,"ل",1,0],["هو الإسلامُ ما للنفس عنه","إذا ابتغتِ السّلامةَ من غناءِ",24,"ا",2,0],["هو الأَلفُ لم تعرف فلسطينُ ضربةً","أشدَّ وأنكى منه يوماً لضاربِ",25,"ب",1,0],["هُوَ الأَبلَقُ الفَردُ الَّذي شاعَ ذِكرُهُ","يَعِزُّ عَلى مَن رامَهُ وَيَطولُ",26,"ل",1,0],["هُوَ إِلَّا أَن يُرْفَعَ الحكمُ بالحك","مِ وخَلْقٌ فيه وأمرٌ سَواءُ",27,"ا",2,0],["هُوَ الأَمَلُ البَسَّامُ رَفّ جناحُهُ","فطارتْ به من كلِّ قلبٍ بَلابِلُهْ",28,"ل",2,0],["هو الأمير الذي أحْيَا لكم أدَبًا","يعيد عهد بني حَمْدانَ في حَلَبا",29,"ب",2,0],["هوَ الأزلمُ الخداعُ ، يحفرُ إنْ رعى","وَيَغْدِرُ إِنْ أَوْفَى ، وَيُصْمِي إِذَا رَمَى",30,"م",2,0],["هو الإمام الرفاعي الذي خرجت","له يد المصطفى المبعوث للأمم",31,"م",1,0],["هو الأسد المشهور في كل حضرة","لنيل الأماني والأمان من الكرب",32,"ب",1,0],["هو الأمرُ الرضي طوبى لنفسٍ","يكون لها بعصمتهِ اعتصامُ",33,"م",1,0],["هو الامرُ أمرُ اللَهِ ليس يَفوتُهُ","مُناوٍ ولا ينأى عليه مناصب",34,"ب",1,0],["هُوَ الأَبيَضُ الصَمصامُ عَزماً وَهِزَّةً","وَإِن كانَ يَحكي لَونُهُ الأَسمَرَ اللَدنا",35,"ن",2,0],["هُوَ الأَمَلُ الأَقصى هُوَ السؤلُ وَالمُنى","لَهُ شَرَفُ الأُخرى إِلى شَرَفِ الدُنا",36,"ن",2,0],["هُوَ الآخِرُ المَعدودُ في الفَضلِ أَوَّلا","تَبارَكَ رَبٌّ كَمَّلَ المَجدَ وَالعُلا",37,"ل",2,0],["هُوَ الإِمامُ الَّذي كُلٌّ لَهُ تَبَعٌ","مِن كُلِّ حافٍ عَلى الدُنيا وَمُنتَعِلِ",38,"ل",1,0],["هو الأمير ابن يزدادَ الذي سهلت","به الخطوبُ فللخيرات تسهيلُ",39,"ل",1,0],["هو الالمعي الماجد الفطن الذي","يكاد يجيب المرء عما تخيلا",40,"ل",2,0],["هو الاسد الضرغام والملك الذي","لسطوته تخشى الاسود وتخشع",41,"ع",1,0],["هو الأزهر المعمور ضم شتاتنا","فمن تابع للسالفين ومفتن",42,"ن",1,0],["هو الإسلام طهّرهم فأضحوا","كماء المزن في شعب اللصاب",43,"ب",1,0],["هو الأول المختار أفضل مرسل","هو الآخر المبعوث خير المباعث",44,"ث",1,0],["هُوَ الإِمامُ الَّذي مُعانِدُهُ","مُعانِدُ اللَهِ بارِىءِ النَسَمِ",45,"م",1,0],["هُوَ الإِمامُ اِبنُ الإِما","مِ وَالتَقِيُّ اِبنُ التَقي",46,"ق",2,0],["هو الأسد صوابا والأشد سطا","والمسماح نوالا عن أب فأب",47,"ب",1,0],["هو الأعظمُ ابنُ العَظمةِ البَطلُ الذي","أبى العارَ فاختارَ الوقيعةَ مَخطرا",48,"ر",2,0],["هُوَ الأَلَدُّ خِصاماً وَالأَشَدُّ يَداً","في الحَربِ يُحجِمُ عَنهُ المِدرَهُ الخَصِمُ",49,"م",1,0],["هُوَ الأَسَدُ الدامي الأَظافِرِ في الوَغى","تَقَهقَرُ عَن كَرّاتِهِ الأُسُدُ الضُّبطُ",50,"ط",1,0],["هُوَ الأَسَدُ الحامي الحَقيقَةَ مُقدِماً","وَمَن ذا يَرُدُّ اللَيثَ عَن مَنعِهِ الخيسا",51,"س",2,0],["هُوَ الإِمامُ الَّذي مَدحُ العُفاةِ لَهُ","حَقٌّ وَكُلُّ مَديحٍ غَيرَهُ زورُ",52,"ر",1,0],["هو الأَبلجُ الوضّاحُ أَشرقَ نورُه","فجلّى عن الدنيا قتامَ ظلامِها",53,"م",3,0],["هُوَ الأَبلَجُ الوضّاحُ فوقَ جبينه","ضياءٌ من النور الإِلهيِّ مَكتوبُ",54,"ب",1,0],["هو الأمسُ أو طفلُه العبقريّ","مضى والسعادة بنت المحال",55,"ل",1,0],["هو الأمسُ منتحراً والصفاءُ","مهالاً عليه تراب الزوال",55,"ل",1,0],["هُوَ الأَثر الَّذي يَبقى زَماناً","لَكُم وَلكلّ ذي شَرَف زَمانُ",56,"ن",1,0],["هُوَ الأَمين عَلَيهم وَالأَمير عَلى","بَني العُلى وَلَهُ ساداتهم حلَفا",57,"ف",2,0],["هو الأب وهو الشيخ عند الأب الذي","هو الأب والشيخ الذي لم يزل أدرى",58,"ر",2,0],["هو الأمر بالمعروف يرشدُ لاهياً","وينقذه من طبعهِ المتقلَّبِ",59,"ب",1,0],["هو الأمر بالمعروف يصرف منكراً","ويكشف دعوى كل ذئب وثعلبِ",59,"ب",1,0],["هو الأمر بالمعروف يصرف منكر","ويكشف دعوى كل ذئب وثعلبِ",60,"ب",1,0],["هو الأمنُ للإنسانِ ممَّا يُخيفُهُ","ومن لاذَ بالمولى الكريمِ رأى الأمْنَا",61,"ن",2,0],["هو الأبيُّ الذي تُخشى بوادِرُهُ","ويُرتَجَى عَفوُهُ في سَوْرةِ الحَنَقِِ",62,"ق",1,0],["هو الأمير المجيد المرتقي شرفاً","بجده وأبيه وهو مسعود",63,"د",1,0],["هو الإمام الأوحدُ السّميْدَعُ","الأريحيّ الألمعيُّ المِصقَعُ",64,"ع",1,0],["هو الإمامُ الحافظُ","فأينَ منه الجاحظُ",65,"ظ",1,0],["هو الأفقُ إلا أن وجهكَ بدرُه","وأفعالُك الزُهْرُ النجومُ الشوابِكُ",66,"ك",1,0],["هو الأسد الوحيدُ إذا أغاروا","وفي الشُّورى هو الرأي الجميعُ",67,"ع",1,0],["هو الأمين فلا تخشى أنامله","إلا على الفضة البيضاء والذهب",68,"ب",1,0],["هو الأبيض الإحسان في كلِّ أزمةٍ","من الدهر والأيَّام مسودَّةُ الذَّئب",69,"ب",1,0],["هو الآية الكبرى صلاحا وسيفه","بلاء على الأعدا من اللَه ناذل",70,"ل",1,0],["هو الأصمُّ إذا تدعوهُ فاحِشةٌ","وهو السّميعُ إذا التّقوى تُناديهِ",71,"ي",2,0],["هو الأول اللهُ هو الآخر اللهُ","هو الظاهر اللهُ هو الباطن الله",72,"ل",2,0],["هو إلا مضمون علم قديم","فليجل بالوجود في مضمونه",73,"ن",2,0],["هو الأمر الذي قد أن","كروا والنكر والناكر",74,"ر",1,0],["هو الأرواح والأشبا","ح من أنواع أجساد",75,"د",1,0],["هو الأفلاك والأملا","ك في مثنى وآحاد",75,"د",1,0],["هو الأخرى وما تحوى","كعباد وزهاد",75,"د",1,0],["هو الأزهار والأثما","ر وهو السيل والوادي",75,"د",2,0],["هو الأعواد والإنشا","د والمصغى لإنشاد",75,"د",1,0],["هو الأحمَدُ السَّامي المقامِ الذي بهِ","قد ابتهجَتْ بيروتُ باسمةَ الثَّغرِ",76,"ر",1,0],["هو الأَديبُ الذي رَقَّتْ شَمائِلُهُ","وصانَهُ اللهُ من لومٍ وتَثْريبِ",77,"ب",1,0],["هُوَ الأَجَلُ المَوقوتُ لا يَتَخَلَّفُ","وَلَيسَ يُرَدُّ الفائِتُ المُتَأَسِّفُ",78,"ف",1,1],["هُو الأَسْعَدُ القَاضي الأَميرُ أَما ترى","جنودَ الْمعَالِي كيفَ صِرنَ له جُنْدا",79,"د",2,0],["هو الأسمَحُ في الدَّهرِ","وصَوْبُ المُزْنِ ثانيهِ",80,"ه",1,0],["هو الإداريّ دستُ الحكم فيه خلا","بِعَدلهِ قرَنَ الأحكامَ والحكما",81,"م",2,0],["هو الإمام الذي نَرجو النجاةَ بهِ","من حرِّ نارٍ على الأعداءِ ستعرِ",82,"ر",1,0],["هو الإمامُ الكريمُ العالم العلم ال","حاوي الكَمال العزيز النفس زاكيها",83,"ي",3,0],["هو الأديبً الأريبُ الفاضلُ الوَرعُ ال","سامي المقامِ عن الأشباهِ والنُّظرا",84,"ر",2,0],["هو الإمامُ الكريمُ العاقلُ الوَرِعُ ال","مُحي النفوسِ بنظم منهُ ينتشرُ",85,"ر",1,0],["هُوَ الأَوحد المَوصوف بِالفهم وَالذَكا","وَفي محفل العرفان نعم المخاطب",86,"ب",1,0],["هُوَ الأَمير الَّذي صانَت مَناصبَه","سِياسةٌ زانَها مِنهُ بإتقان",87,"ن",1,0],["هُوَ الآمر الناهي بِلُطف وَرَأفة","وَحُكم بِنَص الشَرع في الذكر صادر",88,"ر",1,0],["هُوَ الآمر الناهي بِأَشرَف دَولة","عَلى العَدل فيهِ يَستَقرّ سَرير",89,"ر",1,0],["هوَ الأَبيَضُ الفرد الخَضيبُ بَنانُهُ","لَهُ وَجنَةٌ قَد أَشرَقَت وَجَبينُ",90,"ن",1,0],["هو الأربعاء بجامع فصح","فأقبح بذيالك الأربعاء",91,"ا",2,0],["هوَ الإِمامُ الَّذي جَلّتْ مَناقِبُهُ","وَضاقَ عَنْ جَمعِها كُتبٌ وَأَسْفارُ",92,"ر",1,0],["هوَ الأسَدُ المِقدامُ في كلِّ مُشكلٍ","هوَ السيّدُ الشَّهمُ اللَّطيفُ المؤدّبُ",93,"ب",1,0],["هوَ الأَحمَرُ الدّرويشُ بَحرٌ مُشَذَّبٌ","وَسيمٌ يُقِرُّ العينَ مرآهُ والطَّرفا",94,"ف",2,0],["هُوَ الأَشرفُ المُمتازُ في مَوكِبِ العُلا","وقد لبس العلياءَ في رجله خُفّا",95,"ف",2,0],["هُوَ الأَسدُ الرّئبالُ وَالضّيغَمُ الّذي","لَقَد أَلبَسَ الآسادَ في حَربِهِ الرَّجفا",96,"ف",2,0],["هوَ الأَبلَقُ الفَردُ الّذي سارَ ذِكرُهُ","وَلَيسَ لَهُ في الخافِقَينِ مَثيلُ",97,"ل",1,0],["هُوَ الأَسدُ الرّئبالُ وَالضّيغّمُ الّذي","لَدَيهِ أُسودُ الغابِ ذُلّاً خَواضِعُ",98,"ع",1,0],["هُوَ الإِمامُ الَّذي زانَت إِمامَتهُ","كلَّ المَحاريبِ إِذ فيها تَلا الحَمدا",99,"د",2,0],["هُوَ الآمِرُ النّاهي فَحاذِرْ خِلافَهُ","مُخالفه مَولاهُ يُلبِسهُ سُخطا",100,"ط",2,0],["هوَ الأَمجَدُ اِبن الماجِدِ المُعتلي السّهى","عَليّ السّجايا كَوكبُ العزِّ وَالمجدِ",101,"د",1,0],["هُوَ الأَسدُ الرّئبالُ يَسطو وَمِثلهُ","عَديمُ وجودٍ في الضّياغِمِ وَالأسدِ",101,"د",1,0],["هُوَ الأَسعَدُ المَسعودُ وَاِبنٌ لِأَسعَدٍ","بنيّ شَديد مُرعِب الأُسدِ وَالضدِّ",102,"د",1,0],["هُو الإمامُ فتى الذِّمْرِ الإمام هو ال","لمرْجُوُّ والموردُ الصافي من الدَّرَن",103,"ن",1,0],["هو الإمامُ الهمامُ الليثُ عادتُه","حتفُ العُداةِ وأهلُ البغى كلِّهمِ",104,"م",1,0],["هو الأول الهادي هو الآخر الذي","تأخر إرسالا وخلقا تقدما",105,"م",2,0],["هو الآية الكبرى لمن كان مبصرا","صنائع إع