أَطلُبَ كُفؤَها","وَزَفَفتُها لَكَ نِعمَ بَعلُ الأَيِّمِ",0,"م",1,0],["عَضَلتُ ثَنائي عَنهُمُ وَذَخَرتُهُ","لِأَبلَجَ مَمنونِ النَقيبَةِ رائِسِ",1,"س",1,0],["عُضوٌ عَشَّت فيهِ المَنِ","يَّةُ ما أَجَلَّ وَما أَعَزّا",2,"ز",2,0],["عَضَّت بِبازِلِها المَنونُ وَلَم تَزَل","تَقرو طَريقَ النابِ بِالأَظفارِ",3,"ر",1,0],["عَضبُ اللِسانِ مُتَقِّنٌ","فَطِنٌ لِما يُعنى بِها",4,"ب",3,0],["عَضَّ بِما أَبقى المَواسي لَهُ","مِن أُمِّهِ في الزَمَنِ الغابِرِ",5,"ر",1,0],["عَضَّت سَلاسِلُنا عَلى اِبنَي مُنذِرٍ","حَتّى أَقَرَّ بِحُكمِنا الجَبّارُ",6,"ر",1,0],["عَضاريطُ يَشوُونَ الفَراسِنَ بِالضُحى","إِذا ما السَرايا حَثَّ رَكضاً مُغيرُها",7,"ر",3,0],["عَضَضتَ بِأَيرٍ مِن أَبيكَ وَخالِهِ","وَعَضَّت بَنو النَجّارِ بِالسُكَّرِ الرَطبِ",8,"ب",1,1],["عضبٌ إذا رمت زهداً أو حذرت وغى","أرضاكَ في ذا وفي هذا بتجريد",9,"د",1,0],["عَضُدٌ لسيّدِنا وغي","ثٌ للورى يَتصبّبُ",10,"ب",1,0],["عَضُدٌ فَعْمَةٌ لمعْتَضِدٍ بال","لَهِ بالنُّصْحِ منْهُمُ مَعْضُودِ",11,"د",1,0],["عُضدتَ بابنين أصبحا لك في ال","تدبيرِ مثل اليدين للظهرِ",12,"ر",1,0],["عضباً كأن شعاعه لهب","يَغنى به في الليل رافعه",13,"ع",2,0],["عَضُّ الدَهرِ وَالأَيّامِ حَتّى","تَغَيَّرَ بَعدَكَ الشَعَرُ الجَديدُ",14,"د",1,0],["عضل الداء بي فما","لي من فتكه مفر",15,"ر",1,0],["عَضَّت بِساقَيهِ القُيودُ فَلَم يَنُؤ","وَمَشَت بِهَيكَلِهِ السُنونَ فَناءَ",16,"ا",2,0],["عَضبُ العَزيمَةِ لايَزالُ مُعَرِّفاً","مَعروفَ عائِدَةٍ وَمُنكَرَ مُنكَرِ",17,"ر",1,0],["عَضَّت سُيوفُ تَميمٍ حينَ أَغضَبَها","رَأسَ اِبنِ عَجلى فَأَضحى رَأسُهُ شَذَبا",18,"ب",2,1],["عَضُدٌ لِوا الإِسلامِ مَشدودٌ بِهِ","رُكنٌ لِدينِ اللَهِ لا يَتَزَعزَعُ",19,"ع",1,0],["عَضبٌ إِذا ما قامَ يَوماً خاطِباً","فَاِلهامُ تَسجُدُ وَالجَماجِمُ تَركَعُ",19,"ع",1,0],["عَضّتْ على حلقاتهنّ ضراغمٌ","فَغَرَتْ بها أفواهَها تكسيرا",20,"ر",2,0],["عَضْبٌ يكون عتادَ فارسِهِ إذا","ما سلّهُ والعضبُ غيرُ عَتادِ",21,"د",1,0],["عَضباً إِذا سَلَّهُ في وَجهِ نائِبَةٍ","جاءَت إِلَيهِ بِناتُ الدَهرِ تَعتَذِرُ",22,"ر",1,0],["عَضبُ العَزيمَةِ في المَكارِمِ لَم يَدَع","في يَومِهِ شَرَفاً يُطالِبُهُ غَدا",23,"د",2,0],["عَضْبُ المضاربِ مُشرِقٌ ذُو رَوْنَقٍ","تهفو الحُلومُ إليهِ وَهْيَ رِزانُ",24,"ن",1,0],["عضّوا أصابعَهم وراح كبيرُهم","يطفو ويرسبُ في المُقيمِ المُقعِدِ",25,"د",1,0],["عَضْبٌ حَمَى عِرضَ الكنانةِ حَدُّهُ","وَرَعى ذِمامَ الشَّرقِ في أبنائهِ",26,"ا",3,0],["عَضّوا عَلى أَموالِنا بِنَواجِذٍ","أَكَلَت خَزائِنَ مِصرَ وَالسودانِ",27,"ن",1,0],["عَضَبُ المَضارِبِ كَالغَدي","رِ نَفى القَذى حَتّى صَفا",28,"ف",2,0],["عَضْبُ المضارب مُقفِرٌ من أعينٍ","لكنّهُ من أنْفُسٍ مَسْكُون",29,"ن",1,0],["عضّت على كفّيه والتفّت على","ساقيه وانسدّت عليه دروبها",30,"ب",3,0],["عضَّ في الثوبِ واشتَكى","وطأةَ الخزِّ والوبَرْ",31,"ر",1,0],["عَضَّ الحديد علينا","وحدّد الدهر نابا",32,"ب",2,0],["عَضْبُ اللسان يكاد يهجُو نَفْسَه","ويجرِّحُ الأخوال والأَعماما",33,"م",2,0],["عضَّا الأناملَ بعدما","عضَّا الحمامَ بكلِّ ناب",34,"ب",1,0],["عَضَّ اليمينَ التي كم أطعمتْ فَمَهُ","وكم سقَتْهُ النَّمِير العذبَ مقطورا",35,"ر",2,0],["عضَّ النواجذَ من غيظٍ فما نفعت","شيئاً ، وأهْوِنْ به من واجد غضبا",36,"ب",2,0],["عَضُدُ الدولة استشارَك بالإعزازِ","واللُطف يا عدوَّ الأعاجِم",37,"م",1,0],["عَضَّاضِ أَعْرَفِ الحَمِيرِ شُتَامَة","ٍ ومُتونِها فِعلَ الفَنِيقِ الصائلِ",38,"ل",1,0],["عُضدتَ يا بنين أصبحا لك في الت","تدبيرِ مثل اليدين للظهرِ",39,"ر",1,0],["عَضّت خَلاخِلُه وَجَالَ وِشَاحُهُ","وَلَوَى مآزِرَهُ عَلَى كُثبانِ",40,"ن",1,0],["عَضَدتَ السُيوفَ فَاِنبَرَت شَفَراتُها","مُحَكَّمَةً في كُلِّ مُحكَمَةِ السَردِ",41,"د",1,0],["عَضُدٌ إِذا عُدِمَ المُعاضِدُ ناصِحٌ","إِذ يُستَشارُ مُظَفَّرٌ إِن أَمجَدا",42,"د",2,0],["عَضباً إِذا شَهِدَ الهَيجاءُ مُضرَمَةً","أَفرى وَإِن شاءَ إِصلاحَ الأُمورِ فَرى",43,"ر",2,0],["عَضَّت رُؤوسَهُمُ بَعدَ الجِماحِ ظُبىً","عَلى المَوارِنِ مِن آثارِها حِكَمُ",44,"م",1,0],["عضضت كفى حتى كدت آكلها","مما ندمت وذابت مهجتي حزنا",45,"ن",2,0],["عَضَّ نابُ النحسِ روحي زمناً","ويحَ حظي كَم بِوجهي عَبَسا",46,"س",2,0],["عَضَّا على الكفِّ واهلكَا أَسَفاً","بَغْياً ومُوتاً كذا بِدَاءَيْنِ",47,"ن",1,0],["عَضاريطُنا مُستَبطِنو البيضِ كَالدُمى","مُضَرَّجَةً بِالزَعفَرانِ جُيوبُها",48,"ب",3,0],["عضد المليك وراحة من حيث ما","لمست جماداً فهو ماء ذائب",49,"ب",1,0],["عضد الرَسول بنفسه وَبماله","طوبى لذلك ما أَبر وأَرحما",50,"م",2,0],["عَضْبٌ لأَكْرَمِ دَوْلَةٍ وَبَهاءُ اَش","رَفِ مِلَّةٍ وَزَعِيمُ أَيِّ جُيُوشِ",51,"ش",1,0],["عَضْبِ الْعَزِيمَةِ لَوْ لاقَتْ مَضارِبُها","طُوْداً مِنَ الْمُشْرِفاتِ الصُّمِّ لاَنْقَضَبا",52,"ب",2,0],["عَضَضتَ يَداً خُلِقَت لِلنَدى","وَبَثِّ العُلومِ وَضَربِ الرِقاب",53,"ب",1,0],["عضبُ اللسانِ ذكيُّ القلبِ أَصمعه","عفُّ السريرةِ منجادٌ إذا نودي",54,"د",2,0],["عَضّتهُ آسفةً عليه كأنّما","عَضّت بنانَ النادمِ المسترجعِ",55,"ع",1,0],["عَضباً جميلَ الصفحِ ما لا ينتهي","فَإِذا اِغتررت به اِستشاك غرارا",56,"ر",2,0],["عَضمُ جارٍ يثني الجريّ به نا","جى الثريّا نصراً بديعَ الجنودِ",57,"د",1,0],["عَضدُ الخِلافةِ ما يزالُ مُطاعِناً","من دونها برماحِ رَأْيٍ شُرَّع",58,"ع",1,0],["عضْلتُ ابنةَ الفِكْرِ المصونةَ خَوْفَ أن","تُزَفَّ إلى مَن ليس كُفْؤَ ثَنائي",59,"ا",2,0],["عَضَّت بنو نَهدٍ بِفَعلِ أَبيهِمُ","إِذا ما صَعُوا الأَقوامَ عند صَمَامِ",60,"م",1,1],["عَضباً يَزينك بَينَ القَومِ مَلبَسِهِ","وَإِن ضربت بِهِ في معرك بَترا",61,"ر",2,0],["عَضَضتَ عَلى كَفَّيكَ حَتّى كَأَنَّما","رُزِئتَ الَّذي أُعطيتُ مِن صُلبِ مالِكا",62,"ك",2,0],["عَضَدَ الإلهُ أَبا الْوَفاءِ بِنَصْرِهِ","عَضُدَ الخْلافَةِ سَيِّدَ الأُمَراءِ",63,"ا",2,0],["عضب يهتز إذا نظرت","يصمي الأحشاء ولا يظهر",64,"ر",1,0],["عضب العزيمة ماضي الوهم مختلس","خواطر الحزم بالأراء منفرد",65,"د",1,0],["عضَدَت كفايتُك السعودَ كما","عضد القِرانُ الحبل بالحبلِ",66,"ل",1,0],["عضَّ العدا أظافراً من بعده","تَدْمَى ولم تُرزق عليه الظفَرا",67,"ر",2,0],["عَضُّوا الحصا إن لان من كمدٍ","لضروسكم وامشُوا على الجمرِ",68,"ر",1,0],["عَضُدٌ لدينِ اللّهِ مِن","هُ لهُ اذا ناداه نَصْرُ",69,"ر",1,0],["عضُد الدينِ مُشارُ ال","دَّهْرِ مُختارُ الاِمامِ",70,"م",1,1],["عضدُ الدين فتى الحَيِّ إذا","بَخِلَ الجَوُّ بِطَلٍّ وسَبَلْ",71,"ل",1,0],["عَضُدُ الدينِ الذي إِحْسانُهُ","لم يزَلْ في المَحْلِ ودْقاً وقُطارا",72,"ر",2,0],["عَضُدُ الدين الذي مَعْروفُهُ","طاردُ الفَقْرِ وقَتَّالُ السْغَبْ",73,"ب",1,0],["عَضُد الهُدى والدِّين رِدْؤهُما","