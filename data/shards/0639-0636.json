{"poems":[[53,"وسمتك حالية الربيع المرهم","https://www.aldiwan.net/poem29817.html","الكامل"],[53,"أقول لركب خابطين إلى الندى","https://www.aldiwan.net/poem30195.html","الطويل"],[53,"إطمح بطرفك هل ترى","https://www.aldiwan.net/poem30202.html","مجزوء الكامل"],[53,"ألقي السلاح ربيعة بن نزار","https://www.aldiwan.net/poem30445.html","الكامل"],[9,"أوصلت صرم الحبل من","https://www.aldiwan.net/poem21910.html","مجزوء الكامل"],[9,"شاقتك من قتلة أطلالها","https://www.aldiwan.net/poem21944.html","السريع"],[27,"لولا الحياء لعادني استعبار","https://www.aldiwan.net/poem5740.html","الكامل"],[27,"ألا بكرت سلمى فجد بكورها","https://www.aldiwan.net/poem5775.html","الطويل"],[23,"عضضت بأير من أبيك وخاله","https://www.aldiwan.net/poem21488.html","الطويل"],[72,"واوحشتي لمقام منك محمود","https://www.aldiwan.net/poem18564.html","البسيط"],[51,"قدم الأمير أخو الأمير","https://www.aldiwan.net/poem8333.html","الخفيف"],[51,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[51,"الحمد لله لا شريك له","https://www.aldiwan.net/poem64017.html","المنسرح"],[51,"لج الفؤاد فليس يلذعه","https://www.aldiwan.net/poem65413.html","أحذ الكامل"],[29,"وحاجلة العيون طوى قواها","https://www.aldiwan.net/poem6160.html","الوافر"],[89,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[85,"ركزوا رفاتك في الرمال لواء","https://www.aldiwan.net/poem62931.html","الكامل"],[45,"هجرت وطيف خيالها لم يهجر","https://www.aldiwan.net/poem63560.html","الكامل"],[28,"عضت سيوف تميمٍ حين أغضبها","https://www.aldiwan.net/poem1296.html",""],[66,"عذل العواذل في هواك مضيع","https://www.aldiwan.net/poem38484.html","الكامل"],[80,"واعمر بقصر الملك ناديك الذي","https://www.aldiwan.net/poem31233.html","الكامل"],[80,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[44,"يا هذه أقصري ما هذه بشر","https://www.aldiwan.net/poem30512.html","البسيط"],[44,"يا دار دار عليك إرهام الندى","https://www.aldiwan.net/poem30539.html","الكامل"],[105,"خلت المنازل منك والأوطان","https://www.aldiwan.net/poem41941.html","الكامل"],[105,"كذبوا على الدستور ما فيهم له","https://www.aldiwan.net/poem42058.html","الكامل"],[105,"نادى الشباب فهب من إغفائه","https://www.aldiwan.net/poem42094.html","الكامل"],[105,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[52,"ذم الزمان لدمنة","https://www.aldiwan.net/poem26825.html","مجزوء الكامل"],[75,"هل من أعقة عالج يبرين","https://www.aldiwan.net/poem69032.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39683","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142053","المجتث"],[106,"فيم احتفالكم ؟","https://www.poetsgate.com/ViewPoem.aspx?id=179398",""],[106,"مؤامرة على شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=179739",""],[106,"كلب بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179351",""],[90,"تحية الوزير","https://www.poetsgate.com/ViewPoem.aspx?id=179070",""],[90,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[51,"الحمد لله لا شريك لهُ","https://www.poetsgate.com/ViewPoem.aspx?id=29174",""]],"verses":[["عَضَّلتُها زَمَناً لِأَطلُبَ كُفؤَها","وَزَفَفتُها لَكَ نِعمَ بَعلُ الأَيِّمِ",0,"م",1,0],["عَضَلتُ ثَنائي عَنهُمُ وَذَخَرتُهُ","لِأَبلَجَ مَمنونِ النَقيبَةِ رائِسِ",1,"س",1,0],["عُضوٌ عَشَّت فيهِ المَنِ","يَّةُ ما أَجَلَّ وَما أَعَزّا",2,"ز",2,0],["عَضَّت بِبازِلِها المَنونُ وَلَم تَزَل","تَقرو طَريقَ النابِ بِالأَظفارِ",3,"ر",1,0],["عَضبُ اللِسانِ مُتَقِّنٌ","فَطِنٌ لِما يُعنى بِها",4,"ب",3,0],["عَضَّ بِما أَبقى المَواسي لَهُ","مِن أُمِّهِ في الزَمَنِ الغابِرِ",5,"ر",1,0],["عَضَّت سَلاسِلُنا عَلى اِبنَي مُنذِرٍ","حَتّى أَقَرَّ بِحُكمِنا الجَبّارُ",6,"ر",1,0],["عَضاريطُ يَشوُونَ الفَراسِنَ بِالضُحى","إِذا ما السَرايا حَثَّ رَكضاً مُغيرُها",7,"ر",3,0],["عَضَضتَ بِأَيرٍ مِن أَبيكَ وَخالِهِ","وَعَضَّت بَنو النَجّارِ بِالسُكَّرِ الرَطبِ",8,"ب",1,1],["عضبٌ إذا رمت زهداً أو حذرت وغى","أرضاكَ في ذا وفي هذا بتجريد",9,"د",1,0],["عَضُدٌ لسيّدِنا وغي","ثٌ للورى يَتصبّبُ",10,"ب",1,0],["عَضُدٌ فَعْمَةٌ لمعْتَضِدٍ بال","لَهِ بالنُّصْحِ منْهُمُ مَعْضُودِ",11,"د",1,0],["عُضدتَ بابنين أصبحا لك في ال","تدبيرِ مثل اليدين للظهرِ",12,"ر",1,0],["عضباً كأن شعاعه لهب","يَغنى به في الليل رافعه",13,"ع",2,0],["عَضُّ الدَهرِ وَالأَيّامِ حَتّى","تَغَيَّرَ بَعدَكَ الشَعَرُ الجَديدُ",14,"د",1,0],["عضل الداء بي فما","لي من فتكه مفر",15,"ر",1,0],["عَضَّت بِساقَيهِ القُيودُ فَلَم يَنُؤ","وَمَشَت بِهَيكَلِهِ السُنونَ فَناءَ",16,"ا",2,0],["عَضبُ العَزيمَةِ لايَزالُ مُعَرِّفاً","مَعروفَ عائِدَةٍ وَمُنكَرَ مُنكَرِ",17,"ر",1,0],["عَضَّت سُيوفُ تَميمٍ حينَ أَغضَبَها","رَأسَ اِبنِ عَجلى فَأَضحى رَأسُهُ شَذَبا",18,"ب",2,1],["عَضُدٌ لِوا الإِسلامِ مَشدودٌ بِهِ","رُكنٌ لِدينِ اللَهِ لا يَتَزَعزَعُ",19,"ع",1,0],["عَضبٌ إِذا ما قامَ يَوماً خاطِباً","فَاِلهامُ تَسجُدُ وَالجَماجِمُ تَركَعُ",19,"ع",1,0],["عَضّتْ على حلقاتهنّ ضراغمٌ","فَغَرَتْ بها أفواهَها تكسيرا",20,"ر",2,0],["عَضْبٌ يكون عتادَ فارسِهِ إذا","ما سلّهُ والعضبُ غيرُ عَتادِ",21,"د",1,0],["عَضباً إِذا سَلَّهُ في وَجهِ نائِبَةٍ","جاءَت إِلَيهِ بِناتُ الدَهرِ تَعتَذِرُ",22,"ر",1,0],["عَضبُ العَزيمَةِ في المَكارِمِ لَم يَدَع","في يَومِهِ شَرَفاً يُطالِبُهُ غَدا",23,"د",2,0],["عَضْبُ المضاربِ مُشرِقٌ ذُو رَوْنَقٍ","تهفو الحُلومُ إليهِ وَهْيَ رِزانُ",24,"ن",1,0],["عضّوا أصابعَهم وراح كبيرُهم","يطفو ويرسبُ في المُقيمِ المُقعِدِ",25,"د",1,0],["عَضْبٌ حَمَى عِرضَ الكنانةِ حَدُّهُ","وَرَعى ذِمامَ الشَّرقِ في أبنائهِ",26,"ا",3,0],["عَضّوا عَلى أَموالِنا بِنَواجِذٍ","أَكَلَت خَزائِنَ مِصرَ وَالسودانِ",27,"ن",1,0],["عَضَبُ المَضارِبِ كَالغَدي","رِ نَفى القَذى حَتّى صَفا",28,"ف",2,0],["عَضْبُ المضارب مُقفِرٌ من أعينٍ","لكنّهُ من أنْفُسٍ مَسْكُون",29,"ن",1,0],["عضّت على كفّيه والتفّت على","ساقيه وانسدّت عليه دروبها",30,"ب",3,0],["عضَّ في الثوبِ واشتَكى","وطأةَ الخزِّ والوبَرْ",31,"ر",1,0],["عَضَّ الحديد علينا","وحدّد الدهر نابا",32,"ب",2,0],["عَضْبُ اللسان يكاد يهجُو نَفْسَه","ويجرِّحُ الأخوال والأَعماما",33,"م",2,0],["عضَّا الأناملَ بعدما","عضَّا الحمامَ بكلِّ ناب",34,"ب",1,0],["عَضَّ اليمينَ التي كم أطعمتْ فَمَهُ","وكم سقَتْهُ النَّمِير العذبَ مقطورا",35,"ر",2,0],["عضَّ النواجذَ من غيظٍ فما نفعت","شيئاً ، وأهْوِنْ به من واجد غضبا",36,"ب",2,0],["عَضُدُ الدولة استشارَك بالإعزازِ","واللُطف يا عدوَّ الأعاجِم",37,"م",1,0],["عُضدتَ يا بنين أصبحا لك في الت","تدبيرِ مثل اليدين للظهرِ",38,"ر",1,0]]}