{"poems":[[55,"وسمتك حالية الربيع المرهم","https://www.aldiwan.net/poem29817.html","الكامل"],[55,"أقول لركب خابطين إلى الندى","https://www.aldiwan.net/poem30195.html","الطويل"],[55,"إطمح بطرفك هل ترى","https://www.aldiwan.net/poem30202.html","مجزوء الكامل"],[55,"ألقي السلاح ربيعة بن نزار","https://www.aldiwan.net/poem30445.html","الكامل"],[9,"أوصلت صرم الحبل من","https://www.aldiwan.net/poem21910.html","مجزوء الكامل"],[9,"شاقتك من قتلة أطلالها","https://www.aldiwan.net/poem21944.html","السريع"],[29,"لولا الحياء لعادني استعبار","https://www.aldiwan.net/poem5740.html","الكامل"],[29,"ألا بكرت سلمى فجد بكورها","https://www.aldiwan.net/poem5775.html","الطويل"],[23,"عضضت بأير من أبيك وخاله","https://www.aldiwan.net/poem21488.html","الطويل"],[74,"واوحشتي لمقام منك محمود","https://www.aldiwan.net/poem18564.html","البسيط"],[53,"قدم الأمير أخو الأمير","https://www.aldiwan.net/poem8333.html","الخفيف"],[53,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[53,"الحمد لله لا شريك له","https://www.aldiwan.net/poem64017.html","المنسرح"],[53,"لج الفؤاد فليس يلذعه","https://www.aldiwan.net/poem65413.html","أحذ الكامل"],[31,"وحاجلة العيون طوى قواها","https://www.aldiwan.net/poem6160.html","الوافر"],[91,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[87,"ركزوا رفاتك في الرمال لواء","https://www.aldiwan.net/poem62931.html","الكامل"],[47,"هجرت وطيف خيالها لم يهجر","https://www.aldiwan.net/poem63560.html","الكامل"],[30,"عضت سيوف تميمٍ حين أغضبها","https://www.aldiwan.net/poem1296.html",""],[68,"عذل العواذل في هواك مضيع","https://www.aldiwan.net/poem38484.html","الكامل"],[82,"واعمر بقصر الملك ناديك الذي","https://www.aldiwan.net/poem31233.html","الكامل"],[82,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[46,"يا هذه أقصري ما هذه بشر","https://www.aldiwan.net/poem30512.html","البسيط"],[46,"يا دار دار عليك إرهام الندى","https://www.aldiwan.net/poem30539.html","الكامل"],[107,"خلت المنازل منك والأوطان","https://www.aldiwan.net/poem41941.html","الكامل"],[107,"كذبوا على الدستور ما فيهم له","https://www.aldiwan.net/poem42058.html","الكامل"],[107,"نادى الشباب فهب من إغفائه","https://www.aldiwan.net/poem42094.html","الكامل"],[107,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[54,"ذم الزمان لدمنة","https://www.aldiwan.net/poem26825.html","مجزوء الكامل"],[77,"هل من أعقة عالج يبرين","https://www.aldiwan.net/poem69032.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39683","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142053","المجتث"],[108,"فيم احتفالكم ؟","https://www.poetsgate.com/ViewPoem.aspx?id=179398",""],[108,"مؤامرة على شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=179739",""],[108,"كلب بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179351",""],[92,"تحية الوزير","https://www.poetsgate.com/ViewPoem.aspx?id=179070",""],[92,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[27,"سَلِ المنَازِلَ كَيْفَ صَرْمُ الوَاصِل","https://www.poetsgate.com/ViewPoem.aspx?id=17327",""],[53,"الحمد لله لا شريك لهُ","https://www.poetsgate.com/ViewPoem.aspx?id=29174",""],[129,"ومهفهف عبث الشمول بقده","https://www.aldiwan.net/poem4065.html","الكامل"],[147,"مساعيك لا تحصى فتدرك بالعد","https://www.aldiwan.net/poem11749.html","الطويل"],[147,"شرف الملوك عدت معاليك المدى","https://www.aldiwan.net/poem11752.html","الكامل"],[147,"لو أن شامخ قدر دافع قدرا","https://www.aldiwan.net/poem11764.html","البسيط"],[147,"ما مرتقاك على من رامه أمم","https://www.aldiwan.net/poem11824.html","البسيط"],[164,"رضاك عني رضا الباري به قرنا","https://www.aldiwan.net/poem58662.html","البسيط"],[182,"لعل وعسى","https://www.aldiwan.net/poem50717.html","الرمل"],[233,"الآن قد الفؤاد نصفين","https://www.aldiwan.net/poem50780.html","المنسرح"],[253,"عفت من سليمى رامة فكثيبها","https://www.aldiwan.net/poem2131.html","الطويل"],[265,"كف العتاب فما يمل العاتب","https://www.aldiwan.net/poem38371.html","الكامل"],[275,"ضحك تبروق الابرقين تبسما","https://www.aldiwan.net/poem52106.html","الكامل"],[284,"أهدى الأمير إليك خير تحية","https://www.aldiwan.net/poem60714.html","الكامل"],[284,"أعطى الشباب من الآراب ما طلبا","https://www.aldiwan.net/poem60775.html","البسيط"],[286,"عتبت على قط ملك النحاة","https://www.aldiwan.net/poem32878.html","المتقارب"],[302,"إن كان للموت حتما كل مولود","https://www.aldiwan.net/poem36254.html","عموديه"],[309,"الدهر حرب بالرزايا الفجع","https://www.aldiwan.net/poem56486.html","الكامل"],[309,"برق به أفق الرجاء أنارا","https://www.aldiwan.net/poem56540.html","الكامل"],[309,"خير حام مجد مجير العبيد","https://www.aldiwan.net/poem56553.html","الخفيف"],[368,"حيتك غادية الحيا من مربع","https://www.aldiwan.net/poem60850.html","البسيط"],[368,"سواء تدان منهم وتناء","https://www.aldiwan.net/poem61015.html","الطويل"],[369,"عضت بنو نهد بفعل أبيهم","https://www.aldiwan.net/poem44481.html","الطويل"],[410,"ولى ولم يقض من أحبابه وطرا","https://www.aldiwan.net/poem50171.html","البسيط"],[414,"أسلم بن عمر وقد تعاطيت خطة","https://www.aldiwan.net/poem67487.html","الطويل"],[428,"نعم الورى بسوابغ النعماء","https://www.aldiwan.net/poem26461.html","الكامل"],[433,"خطرت تفتر عن الجوهر","https://www.aldiwan.net/poem41404.html","المتدارك"],[441,"إن العرين الذي يحتله الأسد","https://www.aldiwan.net/poem2613.html","البسيط"],[461,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[461,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[461,"هل تقبلون إنابة الدهر","https://www.aldiwan.net/poem56194.html","أحذ الكامل"],[464,"ويحل منه نديه","https://www.aldiwan.net/poem15377.html","مجزوء الكامل"],[464,"عضد الدين مشار ال","https://www.aldiwan.net/poem15407.html","مجزوء الرمل"],[464,"وعلى الأيام من نعمائه","https://www.aldiwan.net/poem16075.html","الرمل"],[464,"يا جوادا محرزا سبق العلى","https://www.aldiwan.net/poem16137.html","الرمل"],[464,"هنىء العام وما يعقبه","https://www.aldiwan.net/poem16222.html","الرمل"],[464,"يهب الطلاقة والنوال معا","https://www.aldiwan.net/poem16419.html","أحذ الكامل"],[464,"ينثي برأفته ونجدته","https://www.aldiwan.net/poem16422.html","أحذ الكامل"],[464,"راسي الحبى في سلمه ونديه","https://www.aldiwan.net/poem16423.html","الكامل"],[485,"خود رمت عن قوس حاجبها سها","https://www.aldiwan.net/poem24485.html","عموديه"],[517,"بقيت بقاء الدهر يا بهجة الدهر","https://www.aldiwan.net/poem20808.html","الطويل"],[517,"سطعت شموس قبابهم بزرود","https://www.aldiwan.net/poem20810.html","الكامل"],[517,"هل المحرم فاستهل مكبرا","https://www.aldiwan.net/poem20838.html","الكامل"],[518,"لما أدار مدامة الأحداق","https://www.aldiwan.net/poem12187.html","الكامل"],[570,"وليلة فيها قصر","https://www.aldiwan.net/poem69645.html","مجزوء الرجز"],[578,"يا قلب ويحك إن ظبيك قد سنح","https://www.aldiwan.net/poem3091.html","الكامل"],[583,"وكم نظرت وقد أكبرت من جبل","https://www.aldiwan.net/poem25196.html","عموديه"],[845,"","https://poetry.dctabudhabi.ae/diwan/poem/21444","الطويل"],[1133,"","https://poetry.dctabudhabi.ae/diwan/poem/18995","الكامل"]],"verses":[["عَضَّلتُها زَمَناً لِأَطلُبَ كُفؤَها","وَزَفَفتُها لَكَ نِعمَ بَعلُ الأَيِّمِ",0,"م",1,0],["عَضَلتُ ثَنائي عَنهُمُ وَذَخَرتُهُ","لِأَبلَجَ مَمنونِ النَقيبَةِ رائِسِ",1,"س",1,0],["عُضوٌ عَشَّت فيهِ المَنِ","يَّةُ ما أَجَلَّ وَما أَعَزّا",2,"ز",2,0],["عَضَّت بِبازِلِها المَنونُ وَلَم تَزَل","تَقرو طَريقَ النابِ بِالأَظفارِ",3,"ر",1,0],["عَضبُ اللِسانِ مُتَقِّنٌ","فَطِنٌ لِما يُعنى بِها",4,"ب",3,0],["عَضَّ بِما أَبقى المَواسي لَهُ","مِن أُمِّهِ في الزَمَنِ الغابِرِ",5,"ر",1,0],["عَضَّت سَلاسِلُنا عَلى اِبنَي مُنذِرٍ","حَتّى أَقَرَّ بِحُكمِنا الجَبّارُ",6,"ر",1,0],["عَضاريطُ يَشوُونَ الفَراسِنَ بِالضُحى","إِذا ما السَرايا حَثَّ رَكضاً مُغيرُها",7,"ر",3,0],["عَضَضتَ بِأَيرٍ مِن أَبيكَ وَخالِهِ","وَعَضَّت بَنو النَجّارِ بِالسُكَّرِ الرَطبِ",8,"ب",1,1],["عضبٌ إذا رمت زهداً أو حذرت وغى","أرضاكَ في ذا وفي هذا بتجريد",9,"د",1,0],["عَضُدٌ لسيّدِنا وغي","ثٌ للورى يَتصبّبُ",10,"ب",1,0],["عَضُدٌ فَعْمَةٌ لمعْتَضِدٍ بال","لَهِ بالنُّصْحِ منْهُمُ مَعْضُودِ",11,"د",1,0],["عُضدتَ بابنين أصبحا لك في ال","تدبيرِ مثل اليدين للظهرِ",12,"ر",1,0],["عضباً كأن شعاعه لهب","يَغنى به في الليل رافعه",13,"ع",2,0],["عَضُّ الدَهرِ وَالأَيّامِ حَتّى","تَغَيَّرَ بَعدَكَ الشَعَرُ الجَديدُ",14,"د",1,0],["عضل الداء بي فما","لي من فتكه مفر",15,"ر",1,0],["عَضَّت بِساقَيهِ القُيودُ فَلَم يَنُؤ","وَمَشَت بِهَيكَلِهِ السُنونَ فَناءَ",16,"ا",2,0],["عَضبُ العَزيمَةِ لايَزالُ مُعَرِّفاً","مَعروفَ عائِدَةٍ وَمُنكَرَ مُنكَرِ",17,"ر",1,0],["عَضَّت سُيوفُ تَميمٍ حينَ أَغضَبَها","رَأسَ اِبنِ عَجلى فَأَضحى رَأسُهُ شَذَبا",18,"ب",2,1],["عَضُدٌ لِوا الإِسلامِ مَشدودٌ بِهِ","رُكنٌ لِدينِ اللَهِ لا يَتَزَعزَعُ",19,"ع",1,0],["عَضبٌ إِذا ما قامَ يَوماً خاطِباً","فَاِلهامُ تَسجُدُ وَالجَماجِمُ تَركَعُ",19,"ع",1,0],["عَضّتْ على حلقاتهنّ ضراغمٌ","فَغَرَتْ بها أفواهَها تكسيرا",20,"ر",2,0],["عَضْبٌ يكون عتادَ فارسِهِ إذا","ما سلّهُ والعضبُ غيرُ عَتادِ",21,"د",1,0],["عَضباً إِذا سَلَّهُ في وَجهِ نائِبَةٍ","جاءَت إِلَيهِ بِناتُ الدَهرِ تَعتَذِرُ",22,"ر",1,0],["عَضبُ العَزيمَةِ في المَكارِمِ لَم يَدَع","في يَومِهِ شَرَفاً يُطالِبُهُ غَدا",23,"د",2,0],["عَضْبُ المضاربِ مُشرِقٌ ذُو رَوْنَقٍ","تهفو الحُلومُ إليهِ وَهْيَ رِزانُ",24,"ن",1,0],["عضّوا أصابعَهم وراح كبيرُهم","يطفو ويرسبُ في المُقيمِ المُقعِدِ",25,"د",1,0],["عَضْبٌ حَمَى عِرضَ الكنانةِ حَدُّهُ","وَرَعى ذِمامَ الشَّرقِ في أبنائهِ",26,"ا",3,0],["عَضّوا عَلى أَموالِنا بِنَواجِذٍ","أَكَلَت خَزائِنَ مِصرَ وَالسودانِ",27,"ن",1,0],["عَضَبُ المَضارِبِ كَالغَدي","رِ نَفى القَذى حَتّى صَفا",28,"ف",2,0],["عَضْبُ المضارب مُقفِرٌ من أعينٍ","لكنّهُ من أنْفُسٍ مَسْكُون",29,"ن",1,0],["عضّت على كفّيه والتفّت على","ساقيه وانسدّت عليه دروبها",30,"ب",3,0],["عضَّ في الثوبِ واشتَكى","وطأةَ الخزِّ والوبَرْ",31,"ر",1,0],["عَضَّ الحديد علينا","وحدّد الدهر نابا",32,"ب",2,0],["عَضْبُ اللسان يكاد يهجُو نَفْسَه","ويجرِّحُ الأخوال والأَعماما",33,"م",2,0],["عضَّا الأناملَ بعدما","عضَّا الحمامَ بكلِّ ناب",34,"ب",1,0],["عَضَّ اليمينَ التي كم أطعمتْ فَمَهُ","وكم سقَتْهُ النَّمِير العذبَ مقطورا",35,"ر",2,0],["عضَّ النواجذَ من غيظٍ فما نفعت","شيئاً ، وأهْوِنْ به من واجد غضبا",36,"ب",2,0],["عَضُدُ الدولة استشارَك بالإعزازِ","واللُطف يا عدوَّ الأعاجِم",37,"م",1,0],["عَضَّاضِ أَعْرَفِ الحَمِيرِ شُتَامَة","ٍ ومُتونِها فِعلَ الفَنِيقِ الصائلِ",38,"ل",1,0],["عُضدتَ يا بنين أصبحا لك في الت","تدبيرِ مثل اليدين للظهرِ",39,"ر",1,0],["عَضّت خَلاخِلُه وَجَالَ وِشَاحُهُ","وَلَوَى مآزِرَهُ عَلَى كُثبانِ",40,"ن",1,0],["عَضَدتَ السُيوفَ فَاِنبَرَت شَفَراتُها","مُحَكَّمَةً في كُلِّ مُحكَمَةِ السَردِ",41,"د",1,0],["عَضُدٌ إِذا عُدِمَ المُعاضِدُ ناصِحٌ","إِذ يُستَشارُ مُظَفَّرٌ إِن أَمجَدا",42,"د",2,0],["عَضباً إِذا شَهِدَ الهَيجاءُ مُضرَمَةً","أَفرى وَإِن شاءَ إِصلاحَ الأُمورِ فَرى",43,"ر",2,0],["عَضَّت رُؤوسَهُمُ بَعدَ الجِماحِ ظُبىً","عَلى المَوارِنِ مِن آثارِها حِكَمُ",44,"م",1,0],["عضضت كفى حتى كدت آكلها","مما ندمت وذابت مهجتي حزنا",45,"ن",2,0],["عَضَّ نابُ النحسِ روحي زمناً","ويحَ حظي كَم بِوجهي عَبَسا",46,"س",2,0],["عَضَّا على الكفِّ واهلكَا أَسَفاً","بَغْياً ومُوتاً كذا بِدَاءَيْنِ",47,"ن",1,0],["عَضاريطُنا مُستَبطِنو البيضِ كَالدُمى","مُضَرَّجَةً بِالزَعفَرانِ جُيوبُها",48,"ب",3,0],["عضد المليك وراحة من حيث ما","لمست جماداً فهو ماء ذائب",49,"ب",1,0],["عضد الرَسول بنفسه وَبماله","طوبى لذلك ما أَبر وأَرحما",50,"م",2,0],["عَضْبٌ لأَكْرَمِ دَوْلَةٍ وَبَهاءُ اَش","رَفِ مِلَّةٍ وَزَعِيمُ أَيِّ جُيُوشِ",51,"ش",1,0],["عَضْبِ الْعَزِيمَةِ لَوْ لاقَتْ مَضارِبُها","طُوْداً مِنَ الْمُشْرِفاتِ الصُّمِّ لاَنْقَضَبا",52,"ب",2,0],["عَضَضتَ يَداً خُلِقَت لِلنَدى","وَبَثِّ العُلومِ وَضَربِ الرِقاب",53,"ب",1,0],["عضبُ اللسانِ ذكيُّ القلبِ أَصمعه","عفُّ السريرةِ منجادٌ إذا نودي",54,"د",2,0],["عَضّتهُ آسفةً عليه كأنّما","عَضّت بنانَ النادمِ المسترجعِ",55,"ع",1,0],["عَضباً جميلَ الصفحِ ما لا ينتهي","فَإِذا اِغتررت به اِستشاك غرارا",56,"ر",2,0],["عَضمُ جارٍ يثني الجريّ به نا","جى الثريّا نصراً بديعَ الجنودِ",57,"د",1,0],["عَضدُ الخِلافةِ ما يزالُ مُطاعِناً","من دونها برماحِ رَأْيٍ شُرَّع",58,"ع",1,0],["عضْلتُ ابنةَ الفِكْرِ المصونةَ خَوْفَ أن","تُزَفَّ إلى مَن ليس كُفْؤَ ثَنائي",59,"ا",2,0],["عَضَّت بنو نَهدٍ ب