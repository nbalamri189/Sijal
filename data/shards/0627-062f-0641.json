{"poems":[[95,"إقرار غير جاحد","https://www.aldiwan.net/poem11065.html","مجزوء الرجز"],[74,"حدثتني يوم اللقا فتصا","https://www.aldiwan.net/poem19428.html","الخفيف"],[72,"ركد الرجاء فما يهزك مأرب","https://www.aldiwan.net/poem43107.html","الكامل"],[91,"ما بنا خوف اذا الموت دنا","https://www.aldiwan.net/poem44842.html","الرمل"],[91,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[47,"لم تبلغ الحق ولم تنصف","https://www.aldiwan.net/poem65144.html","السريع"],[60,"خوفني منجم أخو خبل","https://www.aldiwan.net/poem30898.html","الرجز"],[107,"يا مطعم الجيش أشبعت السيوف دما","https://www.aldiwan.net/poem44069.html","البسيط"],[48,"إدفن أخا الملك دفن المرء مفتقرا","https://www.aldiwan.net/poem22208.html","البسيط"],[48,"قد يحج الفتى ويغنى بعرس","https://www.aldiwan.net/poem22640.html","الخفيف"],[48,"إدفع الشر إذا جاء بشر","https://www.aldiwan.net/poem22738.html","الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39560","المنسرح"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142021","الخفيف"],[108,"فيلسوف الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179354",""],[60,"خَوَّفَنِي مُنَجِّمُ أَخُو خَبَلْ","https://www.poetsgate.com/ViewPoem.aspx?id=22775",""],[190,"إني موصيك فاحفظ عن أخي ثقة","https://www.aldiwan.net/poem44158.html","البسيط"],[273,"اطلب أبا القاسم الخمول ودع","https://www.aldiwan.net/poem69120.html","عموديه"],[398,"خوفني منجم أخو خبل","https://www.aldiwan.net/poem53462.html","مشطور الرجز"],[463,"كالشمس من جمرة عبد شمس","https://www.aldiwan.net/poem56156.html","الرجز"],[473,"ما أحرج الباب بل ما أرحب الوادي","https://www.aldiwan.net/poem59455.html","البسيط"],[520,"لو اطلعت على سري وإضماري","https://www.aldiwan.net/poem12126.html","البسيط"],[543,"ادفنوها بحقكم مع رفاتي","https://www.aldiwan.net/poem48259.html","عموديه"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34434","السريع"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133794","الرمل"],[1137,"","https://poetry.dctabudhabi.ae/diwan/poem/34702","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199924","المنسرح"],[3536,"","https://poetry.dctabudhabi.ae/diwan/poem/20615","الكامل"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32843","الكامل"],[4715,"قلبي على الرمثا وعلى من سكنها","https://www.poetsgate.com/ViewPoem.aspx?id=204455",""],[4859,"إلى ولدي!","https://www.poetsgate.com/ViewPoem.aspx?id=204329",""],[5376,"اِسجدْ إليهم واقْتربْ","https://www.poetsgate.com/ViewPoem.aspx?id=197472",""],[5431,"عشق القصيدة...","https://www.poetsgate.com/ViewPoem.aspx?id=186520",""],[5572,"الإطاحة بعاشق نبيل","https://www.poetsgate.com/ViewPoem.aspx?id=53490",""],[5956,"كلنا للحب نركعْ","https://www.poetsgate.com/ViewPoem.aspx?id=184835",""],[5956,"طبيعة مصر","https://www.poetsgate.com/ViewPoem.aspx?id=184951",""],[5970,"أنا في العلم غلام لوذعي","https://www.poetsgate.com/ViewPoem.aspx?id=130659",""],[6354,"أحاديث النازحين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87924&r=&rc=1",""]],"verses":[["ادفعها في الموعد","مع الربى المعدد",0,"د",1,0],["أدفع الهمَّ بالحديثِ إذا عا","دكما يدفع الورى بالعتيق",1,"ق",1,0],["ادفَع بِنَفسِكَ لا تَكُن مُتَهَيِّباً","ما اِعتَزَّ في الأَقوامِ مَن يَتَهَيَّبُ",2,"ب",1,0],["ادفنينا فيك يا لجته","كلنا مرتقب ان يدفنا",3,"ن",2,0],["ادفع الشر ان قدر","ت على دفعه بشر",4,"ر",1,0],["إِدفَع بِأَمثالِ أَبي غالِبٍ","عادِيَةَ الدَهرِ أَوِ اِستَعفِفِ",5,"ف",1,0],["أَدفَع عَن نَفسي أَفانينَ الدُّوَل","بِخالِقي وَرازِقي عَزَّ وَجَل",6,"ل",1,0],["ادفع عُيينةَ واردعْ جهلَ صاحِبِهِ","إنّ الحديثَ حديثُ الدّهرِ لو عَلِما",7,"م",2,0],["إِدفِن أَخا المُلكِ دَفنَ المَرءِ مُفتَقِراً","ما كانَ يَملُكُ مِن بَيتٍ وَلا بيتِ",8,"ت",1,1],["أَدفِئوا بِالطِعانِ بَينَ التَراقي","وَالحَوايا أَسِنَّةً مَقرورَه",9,"ر",2,0],["إِدفَعِ الشَرَّ إِذا جاءَ بِشَرِّ","وَتَواضَع إِنَّما أَنتَ بَشَر",10,"ر",1,1],["أدفأتنا وَقَد يَعود إليها","ما لنا من سعادة وَشَقاء",11,"ا",2,0],["أدفُّ للنُّورِ في مشارقه","وأغتدي من سناه نشوانا",12,"ن",2,0],["أدفقي رحمةً ونورا وكوني","جدول السفح أو هزارَ الغابِ",13,"ب",1,0],["ادفنوه بين دور العلم، أو","بين دور الكُتْب خُطُّوا مضجعه",14,"ع",2,0],["أدفع عن نفسي أفانين الدول","يخالقي ورازقي عزّ وجل",15,"ل",1,0],["ادفع عليه حدارا أو أذقه ردى","مكر تقوم له فيه نوادبه",16,"ب",2,0],["ادفنه في البيت قبل ميتته","واجعل له من خموله كفنا",17,"ن",2,0],["أَدفَعُ عَنّي كُلَّ آفاتِ الدُوَل","بِخالِقي وَرازِقي عزَّ وَجَل",18,"ل",1,0],["اِدفع بهم غضبةَ كلِّ لَزْبَةٍ","عمياءَ تَدفَعْ ربوةً بقُدسِ",19,"س",1,0],["ادفع خطاياكَ بالصدقات تَمحصُها","نَصّاً مقولاً أتى من خالقٍ فاد",20,"د",1,0],["أدفع الهم عن قلبي فيغلبني","ما شئت من فقد أوطان وأوطار",21,"ر",1,0],["ادفِنوهَا بِحقِّكُم مَع رُفاتِي","فهيَ كانت مَعِي عَلَى عَرَفَاتِ",22,"ت",1,1],["أَدفَعُ بِالراحَة ظهر التَعَب","بِلا نَصَب",23,"ب",1,0],["أدفاعاً عن حياض العز عن","أمل ربّاهُ مشبوب الخيال",24,"ل",1,0],["اِدفِنوني إِن مِتُّ في أَصلِ كَرمٍ","إِنَّ روحي تَحيى بِماءِ الكُرومِ",25,"م",1,1],["أدفع أجرَ القريض حل معي","فيها وأجر الشيطان سكانا",26,"ن",2,0],["أَدَفعتَني حَتّى اِنقَطَعتُ وَسُدِّدَت","عَنّي الوُجوه وَلَم يَكُن لي مَدفَعُ",27,"ع",1,0],["اِدفَع وَرودَ الهَمِّ عَنكَ بِقَهوَةٍ","مَخزونَةٍ في خانَةِ الخَمّارِ",28,"ر",1,1],["ادفع لها عمري لو طلعت ملحوق","محبوبتي الرمثا وغالي ثمنها",29,"ن",3,0],["‏ادفن الدمعَ معي وسطَ الثرى","والتناهيدَ وأنّاتِ الكدر",30,"ر",1,0],["اِدفع إليهم عنوةً","من كثرةٍ لا تحتسب",31,"ب",1,0],["أدفء شعوركَ كي يشعَ بها الجوى","حتى تُسرَّ من الحلا الأبصارُ!",32,"ر",1,0],["أدفع ثمن غلطة براءة نواياي","يللي بكل اسرار عمري استشيرك",33,"ك",1,0],["ادفعي صدرك نحوي","لم أشاهد منه أروعْ",34,"ع",1,0],["ادفع بذاتك للطبيعة ناشطاً","فإذا بعيشك وفقَ ما تتطلَبُ",35,"ب",1,0],["أدفع القول فلا أبقي فتي","سامعا لي لم يصر من تبعي",36,"ع",2,0],["أدفّئ الخيمة الخرقاء تمطرنا","بقاتلٍ يغزل الأحشاءَ بالحُرَقِ",37,"ق",1,0]]}