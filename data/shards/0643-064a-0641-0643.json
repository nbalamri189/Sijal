{"poems":[[95,"ذلك الرزء في الصديق الكريم","https://www.aldiwan.net/poem11372.html","الخفيف"],[53,"قل لمن ألبس الجمال جمالا","https://www.aldiwan.net/poem65878.html","الخفيف"],[87,"سألوني لم لم أرث أبي","https://www.aldiwan.net/poem8189.html","الرمل"],[68,"لو أفادتنا العزائم حالا","https://www.aldiwan.net/poem40128.html","المديد"],[108,"سفينة الموت","https://www.poetsgate.com/ViewPoem.aspx?id=179666",""],[102,"ذكريات شيخين","https://www.poetsgate.com/ViewPoem.aspx?id=50390",""],[102,"قالت الضحيّة","https://www.poetsgate.com/ViewPoem.aspx?id=50170",""],[102,"مآتم وأعراس","https://www.poetsgate.com/ViewPoem.aspx?id=50173",""],[228,"كيف قوضتم بناء القضاء","https://www.aldiwan.net/poem41913.html","الخفيف"],[261,"يا أبا أحمد بنفسي أفديك","https://www.aldiwan.net/poem48571.html","الخفيف"],[408,"هات عن أهل الحمى ما فعلوا","https://www.aldiwan.net/poem46738.html","الرمل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48795","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69349","الخفيف"],[2430,"","https://poetry.dctabudhabi.ae/diwan/poem/143672","الخفيف"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67593","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40103","الخفيف"],[4856,"عاشقات","https://www.poetsgate.com/ViewPoem.aspx?id=36270",""],[4934,"ماني بشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=32780",""],[5136,"يا بروحي غزالة كغزال","https://www.poetsgate.com/ViewPoem.aspx?id=121571",""],[5190,"رائيل","https://www.poetsgate.com/ViewPoem.aspx?id=104370",""],[5351,"هل تراهم إليك بالقهر جاؤوا؟","https://www.poetsgate.com/ViewPoem.aspx?id=202634",""],[402,"ذلك كالرزء في الصديق الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=36332",""],[5853,"الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=175698",""],[5977,"ألم الذكرى وذكرى الألم","https://www.poetsgate.com/ViewPoem.aspx?id=213283",""],[6004,"مثلما تمضي الثواني","https://www.poetsgate.com/ViewPoem.aspx?id=33701",""],[6102,"هذه ليلتي","https://www.poetsgate.com/ViewPoem.aspx?id=182769",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"]],"verses":[["كَيْفَ كُنَّا وَنَحْنُ فِي رَيِّقِ الْعُمْ","رِ شِدادَ ضِآلَ الْجُسُومِ",0,"م",1,0],["كيف كانتْ عُقْبى اقتصادكِ كانت","صحَّةً مستفادةً واندِمالا",1,"ل",2,0],["كَيفَ كانَت ساعَةٌ قَضَّيتَها","كُلُّ شَيءٍ قَبلَها أَو بَعدُ هَين",2,"ن",1,0],["كَيفَ كَفَّ الدَهرُ كَفّاً كَريماً","لِيَمينِ الدَهرِ كانَت شِمالا",3,"ل",2,0],["كيف كانت تغالبُ الموتَ غيدٌ","بأكفٍ مخضَّبات البَنَان؟",4,"ن",1,0],["كيف كان الآذيُّ في القتل أمضى","من شبا صارم، وحدِّ سنان؟",4,"ن",1,0],["كيف كنّا ننطوي ، خلف اللّحى","ونواري من هوانا ، ما افتضح",5,"ح",1,0],["كيف كنا ، قبل عشرين نعي","همسة الطيّف ، وإيماء الشبح",5,"ح",1,0],["كيف كنتم أيّام كنت مثيره ؟","حشرات حولي وكنت أميرة",6,"ر",2,1],["كيف كنّا يا ذكريات الجرائم","مأتما في الضياع يتلو يتلو مآتم",7,"م",1,1],["كيف كنّا قوافلا من أنين","تتعايا هنا كشهقات نادم",7,"م",1,0],["كيف كنّا نقتات جوعا ونعطي","أرذل المتخمين أشهى المطاعم ؟",7,"م",1,0],["كَيفَ كفَّنتُمُ الشَبابَ بِقانو","نٍ تَوارى ملوّثاً بِالدماءِ",8,"ا",2,0],["كيف كان انحطاط جعسك في طا","عة شرب الدواء يوم الدواء",9,"ا",2,0],["كيفَ كتْمانُ صباباتي بهِ","وبها يُضْرب فيهِ المثلُ",10,"ل",1,0],["كيف كيف النجاة من مستعد","بالسلاحين من مراس وخير",11,"ر",1,0],["كَيفَ كانَ الوَفاءُ وَهِيَ مَدى الأَي","يامِ لا يُرتَجى لَدَيها وَفاءُ",12,"ا",2,0],["كيف كانت حالي إذا كان لا يع","رف ميلي الرجال من تثقيفي",13,"ف",2,0],["كيف كان الوِطاءُ كيف اتساعُ الد","ارِ كيف المغنى وكيف الربوعُ",14,"ع",1,0],["كَيفَ كَشْخَنْتُهُ ولم يَكُ بِالكَو","شَحِ يا لَيتَ كانَ في اِسْتي لِساني",15,"ن",2,0],["كيفَ كُنتَ قاتلاً وقتيلاً؟","كيفَ صِرتَ مَسلكاً وخَيارا؟",16,"ر",2,0],["كيف كيفي آتلون وارسم الدمعة زهور","وكيف كيفي امتزجها حر صيفي بالبراد",17,"د",1,0],["كيف كانت تصد عن حياء","حين أهوت يدي تحمل الخمارا",18,"ر",2,0],["كَيفَ كَالذِّئْبِ قَد وَصَفْنَاكِ ، والذِّئْبُ ..","طَلِيقاً قَد كَانَ مِنَّا وفِينَا ؟",19,"ن",2,0],["كيف كانوا متى أتيتَ كفاحا","من أمانيكَ يفرغون كفاحك",20,"ك",1,0],["كيف كانوا إذا نويتَ صلاحا","بالعمالات يفسدون صلاحك",20,"ك",1,0],["كيف كنا ونحن في ريق العمر","شداد القوى ضآل الجسوم",21,"م",1,0],["كيف كان الأمس يا شاعرنا","حاضر اليوم كحبرٍ بالورق",22,"ق",1,0],["كيف كنا مثل طيرين اذا","غردا تسمع صوت النغمِ",23,"م",1,0],["كَيفَ كانَ الْحُبُ يَزهُو","فِي ودادٍ ما نُعَانِي",24,"ن",2,0],["كَيفَ كُنَّا نُعاقِرُ الحُبَّ! بَينا","أَعيُنُ الليلِ تَستَغِيثُ غَيارى",25,"ر",2,0],["كَيفَ كان الإبا من البُله هَل سُل","لَت عقول لهم فَلَم يؤمن الكل",26,"ل",1,0],["كَيفَ كفوا أَكفهم عَن يديه","وَسلوه وحن جذع إِليه",26,"ه",1,0]]}