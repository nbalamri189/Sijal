s://www.poetsgate.com/ViewPoem.aspx?id=208730",""],[5186,"قلب الدهر اختيارا","https://www.poetsgate.com/ViewPoem.aspx?id=156521",""],[5213,"أحباي لما جزتما الدار لم أجد","https://www.poetsgate.com/ViewPoem.aspx?id=170538",""],[5397,"توارى محيا الشمس منك بحاجب","https://www.poetsgate.com/ViewPoem.aspx?id=157938",""],[5409,"يومٌ بزغت بأفقه مولودا","https://www.poetsgate.com/ViewPoem.aspx?id=155488",""],[5409,"بلغت يا أيها النحات منزلة","https://www.poetsgate.com/ViewPoem.aspx?id=155284",""],[5563,"دعوها فإنَّها مأمورة","https://www.poetsgate.com/ViewPoem.aspx?id=214572",""],[5628,"ذكرى غروب قمر","https://www.poetsgate.com/ViewPoem.aspx?id=178485",""],[5691,"الحليب الأسود","https://www.poetsgate.com/ViewPoem.aspx?id=205883",""],[5691,"الشيخ والحاخام والبابا","https://www.poetsgate.com/ViewPoem.aspx?id=205928",""],[5691,"غراب صهيون","https://www.poetsgate.com/ViewPoem.aspx?id=206340",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[5691,"أمَّةٌ عمْياءُ...!","https://www.poetsgate.com/ViewPoem.aspx?id=207880",""],[402,"باعوا المخلد بالحطام الفاني","https://www.poetsgate.com/ViewPoem.aspx?id=36493",""],[5790,"تخذتم السبت يوم عيد","https://www.poetsgate.com/ViewPoem.aspx?id=111937",""],[5803,"ظلال العشق","https://www.poetsgate.com/ViewPoem.aspx?id=101597",""],[5943,"خير الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=11258",""],[5956,"رايتان خفاقتان في مصرَ للطيران","https://www.poetsgate.com/ViewPoem.aspx?id=202109",""],[5309,"في نظام مرصع الأصفاد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573552",""],[6167,"فرار الضياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85536&r=&rc=19",""],[5080,"أُصرِّف آياتي على سورة النبضِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88131&r=&rc=1",""]],"verses":[["تَخِذوا المَجدَ أَباً ما اِس","تَحسَنوا قَطُّ عُقوقَه",0,"ق",2,0],["تخِذوا السّيوفَ تَمائِماً لوَليدِهِمْ","والحرْبَ ظِئْراً والسّروجَ مُهودا",1,"د",2,0],["تَخِذتَهُمْ عُدّةً للدّهْرِ فانْقَلَبوا","وهُمْ عليّ لدَهْري أعْظَمُ العُدَدِ",2,"د",1,0],["تَخِذَت شَمسَ الضُحى رَمزاً لَها","وَكَفى بِالشَمسِ رَمزاً لِلعِظَم",3,"م",1,0],["تَخِذَ الخَيالَ لَهُ بُراقاً فَاِعتَلى","فَوقَ السُها يَستَنُّ في طَيَرانِهِ",4,"ن",2,0],["تَخِذَ الْحَقِيقَةَ خُلَّةً فَهُنَا عَلَى","عِلاَّتِ هَذَا الْعَيْشِ يَصْطَحِبانِ",5,"ن",1,0],["تخذت خزاماها البنفسج خدنها","وغدا يشير لوردها المنثور",6,"ر",1,0],["تخذوا منه آلة لأمور","لم تكن من أمورنا بأمور",7,"ر",1,0],["تخذنا بعدك العادات ديناً","فأشقى المسلمون المسلمات",8,"ت",1,0],["تخِذ الطمر مئزراً وتردى","غير ما قدرة به الطمرورا",9,"ر",2,1],["تخِذَ المكارِمَ مذهباً لما رأى","للناسِ فيما يعشقون مذاهِبا",10,"ب",2,0],["تخذتك أنساً حين أوحشتْني الورى","وقلت لراءي المستقيم هناكا",11,"ك",2,0],["تخذت من المعروف درعاً حصينة","وقتْك من الطاغي وأنت أخيذُهُ",12,"ذ",2,0],["تَخِذُ الأمةُ وهباً","عجباً أن قال طوطُ",13,"ط",1,0],["تخذتُ عرضَك منديلاً أَمَشُّ به","كفّي إذا غُمِرت من عرضِك الزّهِكِ",14,"ك",1,1],["تخذتكُمُ دِرعاً وتُرساً لتدفعوا","نِبَاَل العدا عنِّي فكنتُمْ نصالَها",15,"ل",3,1],["تخِذوا الحديدَ مغافراً وأشلَّةً","وتخذتَ صبركَ مِغْفراً وشليلا",16,"ل",2,0],["تَخِذَ الجَوَّ مَلعَباً ثُمَّ أَمسى","راكِضاً في الهَواءِ رَكضَ الهَواءِ",17,"ا",2,0],["تَخِذيهِ أَخاً يَكُن لَكِ عَوناً","كُلُّ نَفسٍ مُحتاجَةٌ لِلإِخاءِ",17,"ا",2,0],["تَخِذَت مِنَ اللَيلِ المُخَيِّمِ صاحِباً","وَمِنَ الأَنينِ إِلى الأَنينِ دَليلا",18,"ل",2,0],["تخذ النوع في الورى للتعالي","سلماً من جماجم الأفراد",19,"د",1,0],["تخذته لها اماما شباب","تتسامى الى العلا وكهول",20,"ل",1,0],["تخذت بيتك سجنا ثانيا فغدا","وانت فيه سجين ثم سجان",21,"ن",1,0],["تخذت سلاح الزور للطعن عدة","ولم تفتكر فيما له من نتائج",22,"ج",1,0],["تخذوا المنابر في ثنائك جمة","واختار شاعرك الثريا منبرا",23,"ر",2,0],["تخذت البعض ضدا البعض جندا","فغال المفسدون المفسدينا",24,"ن",2,0],["تَخِذَ الدُجى وَسَماءَهُ وَنُجومَهُ","سُبُلاً إِلى جَفنَيكِ لَم يَرضَ الثَرى",25,"ر",2,0],["تَخِذَ الغَمامُ بِها بُيوتاً فَاِنجَلَت","مَشبوبَةَ الأَجرامِ شائِبَةَ الذُرى",25,"ر",2,0],["تَخِذتُكِ مَوئِلاً فَحَلَلتُ أَندى","ذُراً مِن وائِلٍ وَأَعَزَّ غابا",26,"ب",2,0],["تَخِذَتها روما إِلى الشَرِّ تَمهي","داً وَتَمهيدُهُ بِأُنثى بَلاءُ",27,"ا",2,0],["تَخِذوا المَجالِسَ في البُيوتِ وَعِندَهُ","أَنَّ السُروجَ مَجالِسُ الفِتيانِ",28,"ن",1,0],["تخِذْتُ العصا قَبْلَ وقتِ العَصَا","لكيما أوَطّئَ نَفْسي عليها",29,"ي",3,1],["تخذ الجنودَ من الأسود فوارساً","مِنْ ضاربٍ أو طاعنٍ أو رامِ",30,"م",1,0],["تَخِذوا الحَديدَ مِنَ الحَديدِ مَعاقِلاً","سُكّانُها الأَرواحُ وَالأَجسامُ",31,"م",1,0],["تَخِذَ الفِرارَ أَخاً وَأَيقَنَ أَنَّهُ","صِرِّيُّ عَزمٍ مِن أَبي سَمّالِ",32,"ل",1,0],["تَخِذَ القَنا خيساً فَإِن طاغٍ طَغى","نَقَلا إِلى مَغناهُ ذاكَ الخيسا",33,"س",2,0],["تخذْتُ مقاماً بالمقامِ مقاطعاً","لأطماعِ نفسٍ حانَ منها ضريحُها",34,"ح",3,0],["تَخذَ الحزمَ عليهِ كفَّةً","مِنْ مِجَنٍّ وقتيراً مِن زَرَد",35,"د",1,0],["تَخِذَ الغُرابُ عَلى المَفارِقِ مَوقِعاً","وَلَقَد عَلِمتُ بِأَنَّهُ سَيُطارُ",36,"ر",1,0],["تخذي الرّكاب بنا بيضاً مشافرها","خضراً فراسنها في الرّغل والينم",37,"م",1,0],["تَخِذَ الصِّدْقَ فِي السِّيَاسَةِ نَهْجاً","وَعَدَاهُ التَّضْلِيلُ وَالتَّغْرِيرُ",38,"ر",1,0],["تَخِذناكَ بَعْدَ اللّهِ حامِي دَارِنا","ولَيْسَ لَنَا عَوْنٌ سِوَاكَ عَلى الضُّرِّ",39,"ر",1,0],["تَخِذَتْ فيكِ بِنْتُ عَدْنَانَ داراً","ذَكَّرَتْها بَدَاوَةَ الأَعْرَاب",40,"ب",1,0],["تخذ السماء غطاءهُ","من كان خزٍّ غطاؤه",41,"ا",3,0],["تَخذوا القصور مساكنًا وتسرْبلوا","بالخزِّ، لا الأوبار والأصواف",42,"ف",1,0],["تَخذتُ الورى بالظن أُحصي خطاهُمُ","ورُحْت لدقاتِ القلوبِ محاسبا",43,"ب",2,0],["تخذي على العلاتِ سامٍ رأسها","روعاء منسمها رثيم دام",44,"م",1,0],["تخِذتُ العصا قبلَ وقتِ العَصَا","لكيما أُوطّىء َ نَفْسي عليها",45,"ي",3,1],["تخذتُ عرضَك مندية ً أَمَشُّ به","كفّي إذا غمِرت من عرضِك الزّهِك",46,"ك",1,1],["تخذتكم درعاً وترسا لتدفعوا","نبال العدى عنى فكنتم نصالها",47,"ل",3,1],["تَخِذَ الدُّجى ، وسماؤه ، ونجومه","سُبُلاً إلى جنيفك ، لم يرضَ الثرى",48,"ر",2,0],["تَخذ المَساعي وَالفَضائل عدّة","وَصِيانة لِلعَرض لا لِلمال",49,"ل",1,0],["تَخذوا سِهامك في الجُسوم إِمارة","فَنَجوا بِيمن جِهادِها مِن مالك",50,"ك",1,0],["تَخذ الجور وَالجِناية عاده","وَاِنتِهاب النُفوس 