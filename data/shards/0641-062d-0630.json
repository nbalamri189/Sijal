{"poems":[[55,"ردوا الغليل لقلبي المشغوف","https://www.aldiwan.net/poem29970.html","الكامل"],[55,"بعض الملام فقد غضضت طماحي","https://www.aldiwan.net/poem30652.html","الكامل"],[93,"ما بالهم نقضوا العهود جهارا","https://www.aldiwan.net/poem8862.html","عموديه"],[93,"حيا الصبا على ربى لبنان","https://www.aldiwan.net/poem62768.html","عموديه"],[63,"ما تم وشك البين حتى تيما","https://www.aldiwan.net/poem51433.html","الكامل"],[63,"أنى يعود من الصبابة مفرقا","https://www.aldiwan.net/poem51535.html","الكامل"],[63,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[51,"إن المليك رآك أحسن","https://www.aldiwan.net/poem64295.html","مجزوء الكامل"],[46,"وعاذل عذلته في عذله","https://www.aldiwan.net/poem29687.html","الرجز"],[50,"حي ربع الغنى وأطلال حسن","https://www.aldiwan.net/poem63392.html","الخفيف"],[92,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[93,"الذئاب الخاطفة","https://www.poetsgate.com/ViewPoem.aspx?id=53086",""],[132,"وعليك نفسك لا تعب أحدا ولا","https://www.aldiwan.net/poem50568.html","الكامل"],[132,"أنا بحر هجو إن أردت جفائي","https://www.aldiwan.net/poem50677.html","الكامل"],[146,"لو كنت أشفق من خضيب بنان","https://www.aldiwan.net/poem58451.html","الكامل"],[164,"على من بالهدى يا ابن الإمامه","https://www.aldiwan.net/poem59206.html","الوافر"],[164,"ليتهم كانوا يهودا","https://www.aldiwan.net/poem59208.html","مجزوء الرمل"],[189,"حكم العيون على القلوب يجوز","https://www.aldiwan.net/poem14549.html","الكامل"],[228,"حرم الجمال على سريرك يحلم","https://www.aldiwan.net/poem39695.html","الكامل"],[257,"ما نام بعد البين يستحلي الكرى","https://www.aldiwan.net/poem1416.html",""],[275,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[280,"أمبتسم الأضحى ومطلع الفطر","https://www.aldiwan.net/poem25567.html","الطويل"],[287,"إن الهوى إن كنت عنه تسأل","https://www.aldiwan.net/poem32675.html","الكامل"],[302,"أرأيت بين المأزمين كواعبا","https://www.aldiwan.net/poem33329.html","الكامل"],[376,"كم نهتهم صبابتي وغرامي","https://www.aldiwan.net/poem57128.html","الخفيف"],[411,"أولى الذخائر بالسياسة","https://www.aldiwan.net/poem49914.html","مجزوء الكامل"],[415,"أطع الهوى واعص المعاتب","https://www.aldiwan.net/poem32615.html","مجزوء الكامل"],[469,"في القلب منزلة الغزال الشامس","https://www.aldiwan.net/poem3577.html","عموديه"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138193",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83291","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122696","الكامل"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88595","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70683","الكامل"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119312","الكامل"],[469,"","https://poetry.dctabudhabi.ae/diwan/poem/205274","الكامل"],[1065,"","https://poetry.dctabudhabi.ae/diwan/poem/177899","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56132","الوافر"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64712","الكامل"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145159","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144008","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1519,"","https://poetry.dctabudhabi.ae/diwan/poem/198496","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101063","الكامل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69405","الكامل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46479","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100860","الكامل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97892","الرمل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62820","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70155","الكامل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75683","الكامل"],[4004,"","https://poetry.dctabudhabi.ae/diwan/poem/111313","الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90832","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73123","الكامل"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139307","الكامل"],[4591,"","https://poetry.dctabudhabi.ae/diwan/poem/144248","الكامل"],[5064,"سيرة غير منشُورة","https://www.poetsgate.com/ViewPoem.aspx?id=199145",""],[5183,"الزوراء","https://www.poetsgate.com/ViewPoem.aspx?id=186596",""],[5320,"صغيرى الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=40902",""],[5411,"مُتَغَرّبٌ نِسرين بَوحي","https://www.poetsgate.com/ViewPoem.aspx?id=190992",""],[5776,"الفجر اليماني","https://www.poetsgate.com/ViewPoem.aspx?id=199936",""]],"verses":[["فَحَذارِ إِن شَبَّ الفَنيقُ لِحاظَهُ","وَتَقارَبَت أَنيابُهُ لَصَريفِ",0,"ف",1,0],["فَحَذارِ إِن مَطَرَت عَليكَ صَواعِقي","وَحَذارِ إِن هَبَّت عَليكَ رِياحي",1,"ح",2,0],["فَحَذارِ ثُمَّ حَذارِ مِن يَومٍ بِهِ","يَجري انَجيعُ عَلى الثَرى أَنهارا",2,"ر",2,0],["فَحَذارِ مِن أَن تُخدَعوا بِلِباسِهِم","فَهُمُ الضَواري في لِباسِ الضانِ",3,"ن",1,0],["فحذَتْ بها صِيدُ المُلوكِ وفاخَرتْ","بأبي الفوارسِ فانتَمَتْ حيثُ انتَمَى",4,"م",2,0],["فحَذارِ من لَحْظِ الشُّجاعِ إذا رَنا","وحَذارِ من عَزَماتِه إن أطرَقا",5,"ق",2,0],["فحَذارِ من حركاتِ صِلِّي قَفرةٍ","وحَذارِ من حَركاتِ لَيْثَيْ غابِ",6,"ب",1,0],["فَحَذا بِقُدرَةِ نَفسِهِ","حورَ الجِنانِ عَلى مِثالِك",7,"ك",1,0],["فَحَذَّ حَبلَ أَمَلي مِن أَصلِهِ","مِن بَعدِ ما اِستَعبَدَني بِمَطلِهِ",8,"ل",2,0],["فَحِذاءَ الصَبّاغِ مِن دارِ تيجا","تَ إِلى الجَدوَلِ الَّذي لَيسَ يَجري",9,"ر",2,0],["فحَذارِ من عُقبى القُنوطِ حذارِ","وبِدارِ للعهدِ الجديدِ بِدار",10,"ر",1,0],["فحذار ثمّ حذار من يوم به","يجري النجيع على الثرى أنهارا",11,"ر",2,0],["فحذارِ لا تقبلْ مقلةَ حاسدٍ","في العارفينَ ومن أبوه المصحفُ",12,"ف",1,0],["فحذار ثم حذار ثم حذار من","ليثِ الشَّرَى ومبدِّدِ الأعداءِ",13,"ا",2,0],["فحذارِ أن يطغىَ السؤالُ بطالبٍ","رفدّا فيركبَ غاربَ الطُّوفانِ",14,"ن",1,0],["فحذر منه والعنه لترضى","به البارى فقد بارى ذمامه",15,"م",2,0],["فحذار أيها الناس","من الكفر حذارا",16,"ر",2,0],["فحَذارِ من مَلَقِ اللَّواحِظِ غِرَّةً","فالسحرُ بينَ جُفونها مكنوز",17,"ز",1,0],["فَحَذارِ مِن جُرحِ الهَوى فَجِراحُهُ","يَبقى الأَذى فيها وَيَفنى المَرهَمُ",18,"م",1,0],["فَحَذارِ أُسدَ الغابِ رَبربَ عالِجٍ","وَحَذارِ ثُمَّ حَذارِ ذاكَ الجؤذَرا",19,"ر",2,0],["فحَذارِ من تزويرهم وخِداعِهم","إن غرّتِ الأقوالُ والأرقام",20,"م",1,0],["فَحَذيا كَما انهَلَّت شَآبِيبُ مُزنةٍ","وَدنيا كَما انشَق الكِمام عَن الزَّهرِ",21,"ر",1,0],["فَحَذارِ مِنهُ حَذارِ مِنهُ فَإِنَّني","مِنهُ عَلى قَلبي الجَريحِ لأَوجَلُ",22,"ل",1,0],["فحَذارِ من تِلكَ اللِحاظِ فإنَّها","أَمضى من البيض الرِقاق مَضاربا",23,"ب",2,0],["فَحَذاراً مِن زَفرَةٍ أيُّها اللا","ئِمُ أمسَت نِيرانُها في اضطِرامِ",24,"م",1,0],["فحذَارِ من تَعطيلِه","إنْ كْنتَ من أهلِ الكِياسَهْ",25,"س",2,0],["فحذَارِ يا أُسْدَ الشَّرى","من فَتكِ ألحاظِ الرّبَارِبْ",26,"ب",1,0],["فحذارِ جذوةَ وجنايهِ فإنها","باللحظ تعلق في فؤاد القابس",27,"س",1,0],["فحذروا منه فشردّوه","لخوفهم منه وطالبوه",28,"ه",1,0],["فحذار ثم حذار من فتانة","قبحا بكل وسائل الإغراء",29,"ا",2,0],["فَحَذَوتُ حَذوَ أَبيكَ بَل جاوَزتَهُ","إِنَّ البَنينَ لِأَهلِهِم أَسرارُ",30,"ر",1,0],["فَحَذارِ مِن قَدِّ القَميصِ وَبَتِّها","مِن قَبلِ عَقدِ نِكاحِها تَطليقا",31,"ق",2,0],["فَحذاراً من مكرها في مقامٍ","لست فيه تحاذر المحذورا",32,"ر",2,0],["فحذارِ ثم حذارِ ثم حذارِ ثمْ","م حذارِ من صَمصَامِه البرَّاق",33,"ق",1,0],["فحذار منها ما استطعت فانها","لدن الأريب ككفة للاقط",34,"ط",1,0],["فحذارِ جذوةَ وجنتيهِ فإنها","باللحظ تعلق في فؤاد القابس",35,"س",1,0],["فحذار من تلك العيون خديعة","فبمكرها سلبت فؤادي مكرها",36,"ه",2,0],["فحذرهُ اخا ودّي وعظه","بأن يرتدّ عن هذي المساخرْ",37,"ر",1,0],["فَحَذارِ ثُمَّ حَذارِ سَطْوَةَ باسِلٍ","يُفْني الطُّغاةَ مِنَ الرَّدى بِمُتاحِهِ",38,"ح",2,0],["فحذروا أنْ تستعيدَ الكره","وأن تعيد للعوالي الجره",39,"ه",1,0],["فحذفتَ الإخاءَ والوُدَّ والصّح","بةَ حذفَ النُّحاةِ حرفَ النّداء",40,"ا",2,0],["فحذف جزء المبتدا في أربعه","حتم كحذف خبر يأتي معه",41,"ه",1,0],["فحذارِ ليثاً لا يُنَهْنَه باسلاً","تَخِذَ الصّوارم غيلَهُ والذُّبَّلا",42,"ل",2,0],["فحذار أن ترد الكثيب مخاطراً","بالنفس حيث ملاعب الغزلان",43,"ن",1,0],["فَحَذَّرَ الناسَ عَذاباً نازِلا","فَلَم يَجِد في الأَرضِ مِنهُم قابِلا",44,"ل",2,0],["فَحَذارِ مِنهُ وَمِن عَواقِبِ كَيدِهِ","إِن كانَ يَنفَعُ حائِناً تَحذِيرُهُ",45,"ر",2,0],["فحذروا الناس مِن روميِّ مَذهبه","وَلا يُرى أَحَدٌ مِنكُم لَهُ جاري",46,"ر",2,0],["فحذار من كيد الحسان فانه","يسبي الحكيم ويصرع الضرغاما",47,"م",2,0],["فحذرت الغب من حب التي","عرضت لي وهي بيضاء عوان",48,"ن",1,0],["فَحذارِ يا بيضَ الصوارمِ إنْ بَدَتْ","مهتوكةُ الإدراعِ ذاتُ مَخائلِ",49,"ل",1,0],["فَحذار مِنهُ حذارِ وَاكسر فخَّهُ","جبراً وَدَع لَيث العرين يَصيدُهُ",50,"د",2,0],["فَحذار أَرض الملك مسبعة فمن","يزجي قَطيعاً أَو يثير رَعيلا",51,"ل",2,0],["فحذاراً فحذاراً","منهما ويك حذارا",52,"ر",2,0],["فحذار يا أهل الهوى إني أرى","أقوى الجفون على الحروب الاضعفا",53,"ف",2,0],["فَحذارِ ثُمَّ حذَارِ من لَحظاتهِ","فكَليلُها يبري القُلوبَ إِذا انبَرى",54,"ر",2,0],["فحذار لا تغررك صولتها","وزمانها فثبوتها محو",55,"و",1,0],["فحذار منه حذار لا تعدل به","لهوا به نوع من الشبهات",56,"ت",1,0],["فَحذَارِ مِنْ بَحرِي ومِنْ دوَّامَتِي","وحَذارِ مِنْ ثأرِي ومِنْ ثُوَّارِي",57,"ر",2,0],["فحذار الحياة شهداً فعقبى","حلوها المرُّ غالباً والبلاء",58,"ا",2,0],["فحذار يا دنيا المنام وخاطرى","مازال فوق الجمر يرتقب الفداء",59,"ا",2,0],["فَحِذار مِنْ وَجعٍ تَعَمَّلَ جَرْحهُ","أوْ مِنْ سماء بِها الغيوم حَبائِسُ",60,"س",1,0],["فحذارِ ما كانت هتافا عابرا","غضب الشعوب يكون بعد حذارِ",61,"ر",1,0]]}