{"poems":[[49,"أبت عبراته إلا انسكابا","https://www.aldiwan.net/poem25381.html","الوافر"],[266,"سقاك الحيا ريا وحياك أربعا","https://www.aldiwan.net/poem38378.html","الطويل"],[354,"له الدهر آن والزمان الذي انتهى","https://www.aldiwan.net/poem15822.html","مجزوء الطويل"],[358,"سقى جلق الغرا من المزن واكف","https://www.aldiwan.net/poem40037.html","الطويل"],[463,"لعل لها مع النسرين سرا","https://www.aldiwan.net/poem56198.html","الوافر"],[482,"تعطر من دياركم النسيم","https://www.aldiwan.net/poem15337.html","الوافر"],[556,"دع الجزع عن يمناك لا عن شمالكا","https://www.aldiwan.net/poem47348.html","الطويل"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104082","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202092","الكامل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61111","الطويل"],[4119,"أقول لخيلي عند أبلى وماؤه","https://www.poetsgate.com/ViewPoem.aspx?id=16147",""]],"verses":[["وَلَمّا ثارَ سَيفُ الدينِ ثُرنا","كَما هَيَّجتَ آساداً غِضابا",0,"ب",2,0],["ولما ثوى في قدر خمسة أذرع","شققنا به من شقة الصبر أدرُعا",1,"ع",2,0],["وَلَم أُثبِتِ الغَيبَ المَنيعَ وَأُنفي ال","شَهادَةَ وَالأَشهادَ آياتِها تَتلو",2,"و",1,0],["وَلَمّا ثَنى عطفَ التَعطّف نَحوَنا","رَأَينا اِمتنانا مِنهُ تَبدو العَواطفُ",3,"ف",1,0],["ولما ثَلَّمت منّي الليالي","أريتُك خَلَّةً فسددتَ عَشْرا",4,"ر",2,0],["ولمّا ثوَّبَ الداعي لحربٍ","وقد كَرَبتْ على ساقٍ تقومُ",5,"م",1,0],["ولمّا ثنتْ كفّي عليك أنامِلِي","تَركتُ اِحتقاراً كلَّ مَن كان مالكا",6,"ك",2,0],["ولمّا ثني في الأُفقِ صورةَ نفسهِ","على قَطواتٍ في الوهادِ عواقلِ",7,"ل",1,0],["ولَمَا ثَنَى عن حُبِّهم عَزْمي ولا","شايَعْتُ غَيْرَ قبيلهِم بقبيل",8,"ل",1,0],["وَلما ثَنَينا لِلقاء ركابنا","وَقامَ عَلى أعجازنا الشوق حاديا",9,"ي",2,1],["ولما ثنى طرفي اشتياقي إليكم","ولم يركم كاد الفؤاد يطير",10,"ر",1,0]]}