{"poems":[[47,"أبت عبراته إلا انسكابا","https://www.aldiwan.net/poem25381.html","الوافر"],[261,"سقاك الحيا ريا وحياك أربعا","https://www.aldiwan.net/poem38378.html","الطويل"],[349,"له الدهر آن والزمان الذي انتهى","https://www.aldiwan.net/poem15822.html","مجزوء الطويل"],[353,"سقى جلق الغرا من المزن واكف","https://www.aldiwan.net/poem40037.html","الطويل"],[458,"لعل لها مع النسرين سرا","https://www.aldiwan.net/poem56198.html","الوافر"],[477,"تعطر من دياركم النسيم","https://www.aldiwan.net/poem15337.html","الوافر"],[551,"دع الجزع عن يمناك لا عن شمالكا","https://www.aldiwan.net/poem47348.html","الطويل"]],"verses":[["وَلَمّا ثارَ سَيفُ الدينِ ثُرنا","كَما هَيَّجتَ آساداً غِضابا",0,"ب",2,0],["ولما ثوى في قدر خمسة أذرع","شققنا به من شقة الصبر أدرُعا",1,"ع",2,0],["وَلَم أُثبِتِ الغَيبَ المَنيعَ وَأُنفي ال","شَهادَةَ وَالأَشهادَ آياتِها تَتلو",2,"و",1,0],["وَلَمّا ثَنى عطفَ التَعطّف نَحوَنا","رَأَينا اِمتنانا مِنهُ تَبدو العَواطفُ",3,"ف",1,0],["ولما ثَلَّمت منّي الليالي","أريتُك خَلَّةً فسددتَ عَشْرا",4,"ر",2,0],["ولمّا ثوَّبَ الداعي لحربٍ","وقد كَرَبتْ على ساقٍ تقومُ",5,"م",1,0],["ولمّا ثنتْ كفّي عليك أنامِلِي","تَركتُ اِحتقاراً كلَّ مَن كان مالكا",6,"ك",2,0]]}