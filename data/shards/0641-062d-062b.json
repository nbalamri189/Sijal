{"poems":[[79,"أرضوان لا توحشك فتكة ظالم","https://www.aldiwan.net/poem36447.html","الطويل"],[79,"حديث على رغم العلا غير كاذب","https://www.aldiwan.net/poem36768.html","الطويل"],[40,"أمن آل وسنى آخر الليل زائر","https://www.aldiwan.net/poem7713.html","الطويل"],[13,"فَحَثْحَثْتُ مَشْغُوفَ الْفُؤَادِ فَرَاعَنِ","https://www.poetsgate.com/ViewPoem.aspx?id=180788",""],[201,"غادة حطم الفؤاد بكاها","https://www.aldiwan.net/poem39820.html","الخفيف"],[202,"ركب يجوبون الفلا بنجائب","https://www.aldiwan.net/poem51914.html","الكامل"],[234,"سقى السفح من دير القصير إلى النهر","https://www.aldiwan.net/poem51045.html","الطويل"],[234,"إذا هب عطري النسيم على عمد","https://www.aldiwan.net/poem51162.html","الطويل"],[266,"قفي ربة الوقف والدملج","https://www.aldiwan.net/poem38353.html","المتقارب"],[369,"ألم تريا أن الحمول تسير","https://www.aldiwan.net/poem60891.html","الطويل"],[376,"سل من أقام من استقلا","https://www.aldiwan.net/poem57228.html","مجزوء الكامل"],[376,"حتى متى كل مشتك زاجر","https://www.aldiwan.net/poem57427.html","المنسرح"],[429,"حن إلى كأسه الخليع","https://www.aldiwan.net/poem4107.html","مخلع البسيط"],[438,"هل من رفيق رفيق","https://www.aldiwan.net/poem12680.html","المجتث"],[457,"خطرنا بحكم اللهو للسفح خطرة","https://www.aldiwan.net/poem13693.html","الطويل"],[558,"وساحرة العينين ما تحسن السحرا","https://www.aldiwan.net/poem68429.html","الطويل"],[590,"عروس الكأس يجلوها نديمي","https://www.aldiwan.net/poem1566.html",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83315","الطويل"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112430","الطويل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39040","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38875","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38766","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70834","الوافر"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21669","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89561","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65945","الطويل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112400","المتقارب"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48322","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85122","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54494","المتقارب"],[460,"سرى لكَ طيفٌ زارَ من أمِّ عاصمِ","https://www.poetsgate.com/ViewPoem.aspx?id=22234",""]],"verses":[["فحُثَّ المَطا ليسَ النّعيمُ منغَّصاً","ولا العيْشُ في دارِ الخُلودِ مكَدَّرُ",0,"ر",1,0],["فَحُثَّا سَحَابَ الدَّمْعِ تَهْمِي هَتُونُهُ","عَلَيْهِ كَمَا كَانَتْ تَصُوبُ يَمِينُهُ",1,"ه",1,0],["فَحَثَّ بِها الحادي الجِمالَ وَمَدَّها","إِلى اللَيلِ سَربٌ مِقبِلُ الريحِ باكِرُ",2,"ر",1,0],["فَحَثْحَثْتُ مَشْغُوفَ الْفُؤَادِ فَرَاعَنِي","أُنَاسٌ بِفَيْفَان فَمِرْتُ الْفَرَانِيَا",3,"ي",2,1],["فحثثت الخطى إليها بجنح","الليل والناس نوّم لأراها",4,"ا",3,0],["فحثثتُها والحيُّ قد نزلوا منىً","ذكرَ الحجيجِ لياليَ التشريق",5,"ق",1,0],["فَحُثّا كؤوس الرّاح صِرْفاً فإنني","أرى الدهرَ صَعْباً لا يَدُومُ على أمر",6,"ر",1,0],["فحُثَّا كُئُوسَ الراح فيها فإنّني","أرى الصحوَ مما لا يُفِيد ولا يُجْدي",7,"د",2,0],["فحث المطايا كحث الكؤوس","يحسبها الشرب لم تمزج",8,"ج",1,0],["فَحُثا خَليليَّ المطايا كأنّها","قُصورٌ عليها في الصَّباحِ صُقور",9,"ر",1,0],["فَحثَثتُه لِلحاقِهن","نَ فَقال هنَّ أخَفُّ حَملا",10,"ل",2,0],["فحثَّني ساعةً فلم يَرَني","في أثر القَوم بَعدهم سائِر",11,"ر",1,0],["فَحُثَّها بِالدِّنانِ حَثّاً","إِن عُدِمَ الكاسُ وَالقَطيعُ",12,"ع",1,0],["فحثها في صبوحٍ","مستحسن وغبوقِ",13,"ق",1,0],["فحث على الشطرمج فكر ابن داهِر","ولولاه لم يسطِع لمُرتَجِه فتحا",14,"ح",2,0],["فَحَثَّ مِطِيَّ الراحِ حَتّى كَأَنَّما","قَفا أَثَرَ العَنقاءِ أَو سايَرَ الخِضرا",15,"ر",2,0],["فَحُثَّ اليَعْمَلات إِلى دمشقٍ","سقاها اللهُ هَطّال الغيوم",16,"م",1,0],["فَحَثّوا مَطايا العَزمِ كَي تَظفَروا بِهِ","تَنالوا بِيُمنِ العَصرِ مِنهُ المُيَمَّما",17,"م",2,0],["فحثوا لاسعاد العراق خيولهم","وما صدهم غر جهول مشاغب",18,"ب",1,0],["فَحُثّ المُدامَ وسَقِّ النَّدامى","وسَلِّ الغرامَ وخَلِّ الفِكَرْ",19,"ر",1,0],["فَحُثَّا مَطايا الجدّ بِالوَجدِ وَاِقطَعا","فَراسِخَ عَشراً في مَسافَةِ ميلِ",20,"ل",1,0],["فَحَثَّ مَطايا القَصدِ تَضرِبْ كبدها","وَسُقْها بِسَوطِ الشّوقِ في غايَةِ الجُهدِ",21,"د",1,0],["فحُثوا عَجَّلُوا فيها","فما في ذاك مِنْ عار",22,"ر",1,0],["فَحَثَّ حَثيثَ الخَيلِ يَرجُمُ عَدوُهُ","بِهِ حَثَّ مَشبوبٍ مِن النَقعِ هاجِمِ",23,"م",1,0],["فَحُثّوا مَطايا الإِرتِحالِ وَشَمِّروا","إِلى اللَهِ وَالدارِ التي لَيسَ تَخرَبُ",24,"ب",1,0],["فحثوا المطايا عنكم وتنصلوا","وصفو لهم بالبيض والشرب الجرد",25,"د",1,0],["فَحَثّ المَطايا وخاضَ البحار","ومرّت لَيالٍ وكرّت سنون",26,"ن",1,0],["فحَثَّ سائِحُها سَيراً لسابِحِها","وبثّ نجْواهُ داعِيها وضارِعُها",27,"ع",3,0],["فحثحث جواباً ببهج النقل والحجا","فمثلك لا تخفاه عنقاء مغرب",28,"ب",1,0],["فحثُّوا النَّسيمَ لإبلاغه","سلامكم في النَّوى لا ونَى",29,"ن",2,0],["فحثَّ حيثُ الخيلِ يرجمُ عدوهُ","به حثَّ مشبوبٍ من النَّقعِ هاجمِ",30,"م",1,0]]}