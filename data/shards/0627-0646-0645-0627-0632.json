{"poems":[[50,"قد قشرت العصا ولم أعلق السير","https://www.aldiwan.net/poem66146.html","البسيط"],[48,"إن مازت الناس أخلاق يعاش بها","https://www.aldiwan.net/poem21997.html","البسيط"],[159,"ما ترى النيل عليه","https://www.aldiwan.net/poem55482.html","مجزوء الرمل"],[234,"مرض الجود والتوى الإكرام","https://www.aldiwan.net/poem50821.html","الخفيف"],[290,"لامني بعض رجال العلم","https://www.aldiwan.net/poem39356.html","مجزوء الرمل"],[484,"راحة النهى الطرب","https://www.aldiwan.net/poem37059.html","المقتضب"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138381",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48870","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27752","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85166","البسيط"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34585","المديد"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111472","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[5443,"حسرةٌ وعتابٌ","https://www.poetsgate.com/ViewPoem.aspx?id=185146",""]],"verses":[["إِنَّما زُرتُكُم لِمَوضِعِ رِبحٍ","لَم أَزُركُم لِمَوضِعِ الخُسرانِ",0,"ن",1,0],["إِن مازَتِ الناسُ أَخلاقٌ يُعاشُ بِها","فَإِنَّهُم عِندَ سوءِ الطَبعِ أَسواءُ",1,"و",3,1],["إِنَّما زَادَ لأَنِّي","فيهِ أَجْرَيْتُ دُمُوعي",2,"ي",1,0],["إنما زارك التشكّي طَلُوباً","منكَ سَلْماً كَيْلاَ بِخَسفٍ يُسامُ",3,"م",1,0],["انما زرت اماما","قد دعاني بكتاب",4,"ب",1,0],["إنما زمانك ك","أفعوان ينسرب",5,"ب",1,0],["ان ماز بعضا علمهم او حلمهم","فالميز انك عالم وحليم",6,"م",1,0],["إنما زدته جميلاً لمما","أنت فيها الفرد العليم الخبير",7,"ر",1,0],["إنما زادتْ بما قد ذكرت","عين حكم وهو برهانٌ قوي",8,"و",2,0],["إن مازحت مزحها جدوان غضبت","عجباً وتيهاً ببذل الروح أرضيها",9,"ي",3,0],["إنما زخرفتَ لي خدعاً","قدحت في الروح والجسدِ",10,"د",1,0],["إنَّما زَلَّةٌ لَها السَّبقُ مُذكا","نَت خُطاها أَشَدَّ وَقعاً وأَجرى",11,"ا",1,0],["إنما زفس وهو بالغيب أدرى","لم يشأ أن ينال طفقير نصرا",12,"ر",2,0],["إنما زفس دافع الطرواد","ومنيلاس أنطلوخ ينادي",12,"ي",1,0],["إنَّما زُخْرُفُ الحياةِ سَرابٌ","والتُّقَى واحةٌ وظِلٌّ مديدُ",13,"د",1,0]]}