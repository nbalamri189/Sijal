4801",""],[6127,"اقرأ","https://www.poetsgate.com/ViewPoem.aspx?id=197852",""],[6127,"جرحي العراق","https://www.poetsgate.com/ViewPoem.aspx?id=198168",""],[5309,"شدت العنادل يا جميلة فارتدي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573528",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[5724,"شريعة الله للاصلاح عنوان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55134&r=&rc=1",""],[6211,"تفاهات،تفاهات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78242&r=&rc=11",""],[6213,"شفرة الذباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76306&r=&rc=54",""],[6233,"إعلام ..!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78460&r=&rc=23",""],[6238,"لُباب الحُب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86777&r=&rc=6",""],[6242,"التِّمثال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87561&r=&rc=8",""],[572,"هاقَدْ كتبتُ فما رَدَدْتَ جَوابِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9160&r=&rc=17",""]],"verses":[["ها قد أجزتك طوع أمرك إن تجز","إن الرفيع تجيزه أدوانه",0,"ن",2,0],["ها قد أثَرْتُ عليك وحْشيَّ العلا","فاصطد فإنك للعلا صيّادُ",1,"د",1,0],["ها قدْ سألتك غُفراناً ونافلةً","فلا أكن كالمُعنَّى يسألُ الدِّمنا",2,"ن",2,0],["ها قد تجلت ليلة القدر لنا","وقبل مولانا سألنا سؤلنا",3,"ن",2,0],["ها قَد جَرَحتِ بِنَبلِ عَينَيكِ الحَشى","فَدَعي فُؤادي فَالجُروحُ قِصاصُ",4,"ص",1,0],["ها قَدْ تفرَّقَ شملُهُ","إنَّ القضاءَ مفرَّقُ",5,"ق",1,0],["ها قَد حَلَلتُ وَلِلتَقَلقُلِ غايَةٌ","في حَيثُ يُشرِقُ ثُمَّ يُشرِفُ مَقعَدُ",6,"د",1,0],["ها قد أتى اليوم الذي صاروا به","أوفى الدعاةِ وأكرمَ الحلفاءِ",7,"ا",2,0],["ها قد أظَلّ زمانُ الوَصْل يا أمَلي","فامنُنْ وثَبّتْ به قلبي وأقدامي",8,"م",2,0],["ها قد أمِنتُ البردَ والبُرَ","داءَ والقلبُ اطمأنا",9,"ن",2,0],["ها قد عرفتُ فهاتِ كفّ","ك نصطفقْ لا تُخْفِ بشْركْ",10,"ك",1,0],["ها قد سبقتَ إلى مماتِ وإنني","ليلذّ لي شوقاً إليكَ لحوقُ",11,"ق",1,0],["هَا قَدْ لَبِستُ ثِيابَ الضُّرِّ فِيكِ فَقَدْ","بُلِيتُ بِالسُّقْمِ فِيها قَبْلَ أُبْلِيها",12,"ي",3,0],["هَا قَدْ تَبَدَّلْتُ أَوْطاناً بِأَوْطانِ","عَمْداً وَفَارَقْتُ خُلاناً بِخُلانِ",13,"ن",1,1],["هَا قَدْ تَأَمَّلْتُ بالعُتْبى الَّتي سَلَفَتْ","أَنْ لا يُعاوِدَني من بَعْدِها عِيدُ",14,"د",1,0],["هَا قَدْ غَضِبْتُ عَلَى رُوحي لِأَجْلِكُمُ","حتى جَفَوتُ حَياتي عِند جَفوَتِكُمْ",15,"م",1,0],["ها قد كتمتُ هواك معْ ما أنه","نار تشَبُّ على فؤادٍ شائق",16,"ق",1,0],["ها قد مضى رجبٌ وودّع وجهَك ال","باقي وقد هَنّى به شعبانا",17,"ن",2,0],["ها قَد فَنِيَ صَبري وَقَلَّت حيلَتي","لَم يَبقَ في قَوسِ العَزا مِن مَنزَعِ",18,"ع",1,0],["ها قد علمت ولا شك يخالطني","أن الطريقة في خرقى لمعتادي",19,"د",2,0],["ها قد أقمتُ بها وقد","بلغ المفضَّل فيَّ جَهدَه",20,"د",2,0],["ها قد أتى لك برذونٌ وعدك لي","قد حان والشوق عندي شأنه ضرم",21,"م",1,0],["ها قد علِمْتَ صحيح ودّي","ورضيتَ بعد القُرْبِ بُعْدي",22,"د",2,1],["ها قد بلغت الذي قد كان ينتظرُ","الله أكبر هذا النصر والظفر",23,"ر",1,1],["ها قد أتيت لنحو بابك مذعنا","فاحكم علي وإنني المغلوب",24,"ب",1,0],["ها قد تمحّض خادم الخضرا لهم","ليحوطها من شعره بعشائر",25,"ر",1,0],["ها قد بدا فوق البسيطة شمس من","أضحت تنور ككوكب من معهدا",26,"د",2,1],["ها قَد هَلَكتُ وَمِتُّ مِن أَلَمِ الهَوى","قُوموا فَعَزّوا مَعشَري وَأَقارِبي",27,"ب",2,0],["ها قد كَتَبْتُ فما رَدَدْتَ جَوابي","ورجعْتَ مَخْتوماً إلى كتابي",28,"ب",2,1],["ها قد بعثت بها عروسا لفظها","بالسحر يأخذ بالقلوب ويخلب",29,"ب",1,0],["ها قَد ظفرتَ ولم يسعفك في أحدٍ","ولكن اللَه فاحفَظ ما له وجَبَا",30,"ب",2,0],["ها قد أَسِفتُ لأني لم أَمتْ أسَفاً","ها قد جزعتُ لأني لم أمُتْ جَزعا",31,"ع",2,0],["ها قد دَنَتْ عساكرُ الأمطارِ","وأُطْلِقَ القُرُّ من الإسار",32,"ر",1,1],["ها قَد سُبِقت بِقَومٍ كُنت لَو رَملوا","لَم يَلحَقوني وَإِن أَزحَف عَلى مهَلِ",33,"ل",1,0],["ها قد وَجَدْنا البَرّ بَحْرَاً زاخِراً","فهل وجدتُم غيرَها سَفِينا",34,"ن",2,0],["ها قد رفعت لك الحجاب فعدها","عد العليم على حروف الجمل",35,"ل",1,0],["ها قد نظم العبد في علاك قصيدا","من بحر خفيف خزامة عدد الدال",36,"ل",1,0],["ها قد ركبت للمسي","ر في البلاد فاركبي",37,"ب",2,0],["ها قد برزت فاركبي","في ألف ألف مقنب",37,"ب",1,0],["ها قد بذلت غائبي من شاهدي","ما ناب عني في سلوك طريقي",38,"ق",2,0],["ها قد نظمت قصيدتي ورفعتها","لجنابكم وبكم ضعيف كم حبى",39,"ب",2,0],["ها قد بلغتَ مُرادَ نفسِك كلَّه","منّى فكيف حُرِمتُ منك مُرادى",40,"د",2,0],["ها قد مددت يدي إليك فساعدني","وخذي بحقك في الهوى يميني",41,"ن",2,0],["هاقد أَتى يحمي العرينة شبْلُها","ويمدُّ في خير الحِمَى منه يدا",42,"د",2,0],["ها قد زهت هذي الرياض وأزهرت","اغصانها وبدت بثيجان الندى",43,"د",2,0],["ها قد أتيت الهنا","للباب فاقبلَ مَن شَطا",44,"ط",2,0],["ها قد أتى بمحمد","عبد ذليل خالطا",44,"ط",2,0],["ها قدت طرحت ببابكم","حملي فزدتم فيه وزنه",45,"ن",2,0],["ها قد أتيتكَ قبل بيعةِ بائعٍ","عبداً بعقدِ ولايتي لك مُعْلِنا",46,"ن",2,0],["ها قد رأيت عليك قلبي طائراً","فعلام صيد من الصدود بأجدل",47,"ل",1,0],["ها قد كفاك الله فرعون فما","فائدة البقيا على هامانه",48,"ه",1,0],["ها قد قدرت فعد بحلمك محسناً","فمَن الذي من نفسه يستنقم",49,"م",1,0],["ها قد أقام وراء الملك في حلب","ملك يلاحظ سر الغيب من أَمَم",50,"م",1,0],["ها قد رأيت خضوع سائل أدمعي","أفكان عاراً أن تُرَى متصدِّقا",51,"ق",2,0],["ها قد أصبت من الزمان بفادح","أوهى الفؤاد وفت في الأعضاد",52,"د",1,0],["ها قَد تَرَكتُ لَكُم فُؤاداً هائِماً","لا يَنتَهي في الحُبِّ حَتّى يَبتَدي",53,"د",2,0],["ها قد أتيتُ بأشعاري أكذّبكم","فالشعر ما مات لكن ماتت الناس",54,"س",1,0],["ها قَد أَتيتك غب القَوم منكسرا","وَمَن أَتاكُم كَسيراً رَد منجبرا",55,"ر",2,0],["ها قر رغبت عن التشبث بالهوى","ورعاً وزهداً فالهوى فضاح",56,"ح",1,0],["ها قد رضيتُ من الحي","اةِ بنظرةٍ منّي إليه",57,"ي",2,0],["ها قرة الجفنين هاك مفاصلي","ممزوجة حركاتها بفتور",58,"ر",1,0],["ها قد جرحت بنبل عينيك الحشا","فدعي فؤادي فالجروح قصاص",59,"ص",1,0],["ها قَد دَعَوتُك يا مَولايَ مُبتَهِلاً","يا مَن عَلى رُكنِهِ في الكَونِ يُستَنَدُ",60,"د",1,0],["ها قد علمت بما شرحت فأنعم","خلِّي صباحاً حزت خير المغنم",61,"م",1,1],["ها قد وفدت على باب اللجا برجا","حسن اعتقاد بعفوٍ منك مغتنم",62,"م",1,0],["ها قد جنيت وأرتجي منك الرضا","عما جنيت وما أتيت من الجفا",63,"ف",2,0],["ها قد جنيت وما جنيت معرج","بعقوبتي إلا إذا خصمي عفا",63,"ف",2,0],["ها قصتي فاستمعها","وانصت الى ما جرى لي",64,"ي",1,0],["ها قَد سَطا جَيشُ الهُمومِ بِخاطِري","فاِبعَث لَهُ جَيشاً مِنَ التَوشيحِ",65,"ح",1,0],["ها قد أتى تاريخ حبٍّ راقماً","إسحاق بات بصرح جنّاتِ النعيم",66,"م",1,0],["ها قد ثلا الصعبيُّ لا يعلو على","عون الإله مدافع وسيوفُ",67,"ف",1,0],["ها قد أتى السرُّ والإقبال يسعدهُ","والضرّ غاب مع العنقاءَ قد طارا",68,"ر",2,0],["ها قول جبريل وافى أرخهُ حسناً","قد بات منصور بالجنّات منصورا",69,"ر",2,0],["ها قد تلا التاريخ سدتُ مبشرا","هيلانةٌ بالخلد هلَّ هلالُها",70,"ل",3,0],["ها قد أتى تاريخ حبّي لاهجاً","مارون بات بحضنِ إبراهيم",71,"م",1,0],["ها قد بعثت آثارهُ في منزلي","لم تجزني عن عينكِ الآثارُ",72,"ر",1,0],["ها قَد شكوت إليك حالة مدنفٍ","ما لي سلوٌّ ما الوصال تعذَّرا",73,"ر",2,0],["ها قد شرحت وقد بثثت لمجدهم","خبراً به عن بذل وجهي أكتفى",74,"ف",2,0],["ها قد قضَى الفِراقُ والبينُ لنا","فاحبِس نفَساً يا سائقَ العيسِ لنا",75,"ن",2,1],["ها قَد فَنِيَ الجَوهَرُ مِني وَمضَى","في حُبِّكُم فَكَيفَ يَبَقَى العَرضُ",76,"ض",1,0],["ها قَد هَدَمَ البِعادُ يَأسي مِنهُ","ما كانَ اقترابي بالرَّجا يَبنيهِ",77,"ه",1,0],["ها قد رَجَعتَ تَقُولُ لي وتَضُمُّني","جُرحًا يُسَائِلُ مِثلَهُ: هل عُوفِي؟!",78,"ف",2,0],["هَا قَدْ أَسَالَ دَمِي.. وخَطَّا","وعليَّ دُونَ النَّاسِ حَطَّا",79,"ط",2,1],["ها قَد كَذَبتُ عليكِ \"لستِ حبيبتي\"","فَمَتى يُصَدِّقُ كِذبتي إبريلُ!",80,"ل",1,0],["ها قَد أَصبَحتَ عَلَى وَطَنٍ","بِالعُريِ يُرَقِّعُ أثوَابَهْ",81,"ب",2,1],["ها قَد ساقُوهُ إِلى زُمَرٍ","تُردِيهِ وأُخرَى نَهَّابَة",81,"ب",2,0],["ها قد عقدت نهاية","كل الدروب لنفترق",82,"ق",1,0],["ها قدْ نطقتُ فجرحُ أهليَ أبكمُ","تعبَ النداءُ وليسَ فيكم بلسمُ",83,"م",1,1],["هاقد ملكتِ قلوبنا ، فترَفقي","يُحْيي القلوبَ أحِبّةٌ رُحَماءُ",84,"ا",2,0],["ها قد أضعنا قدسَنا وبلادَنا","من بعد هجر شريعةٍ سمْحاءِ",85,"ا",2,0],["ها قد تحوّلنا غثاءً طافياً","فوق السيولِ بغير ما اسماءِ",85,"ا",2,0],["ها قد عرفتِ الشّرَّ مَن صُنّاعُهُ","ها قد عرفتِ خيانةَ الأفّاك",86,"ك",1,0],["ها قد عرفتِ عيون أعداء ا