{"poems":[[95,"ما أنس من طيب عيشي","https://www.aldiwan.net/poem11193.html","المجتث"],[95,"مصر تهدي إلى بنيها السلاما","https://www.aldiwan.net/poem11323.html","الخفيف"],[95,"ألتاج تاج مملكين عظام","https://www.aldiwan.net/poem11386.html","الكامل"],[90,"كل ما في البلاد من أموال","https://www.aldiwan.net/poem44984.html","الخفيف"],[53,"زعم الناس خالدا بغاء","https://www.aldiwan.net/poem7979.html","الخفيف"],[53,"يا أبا أحمد ومثلك لا يغفل","https://www.aldiwan.net/poem61894.html","الخفيف"],[93,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[47,"يا أبا جعفر وأنت كريم","https://www.aldiwan.net/poem65626.html","الخفيف"],[63,"ما ضر ليلتنا بسفح محجر","https://www.aldiwan.net/poem51682.html","الكامل"],[82,"إذا كان في الكتب اتصال لقائنا","https://www.aldiwan.net/poem31392.html","الطويل"],[48,"غير مجد في ملتي واعتقادي","https://www.aldiwan.net/poem23625.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54741","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54838","الكامل"],[102,"عيد الجلوس","https://www.poetsgate.com/ViewPoem.aspx?id=50116",""],[47,"يا أَبَا جَعْفَرٍ وأَنْتَ كريمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=32110",""],[102,"شاعر .. ووطنه في الغربة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67707&r=&rc=194",""],[138,"يا رب إما تخرجن طالبي","https://www.aldiwan.net/poem20989.html","الرجز"],[170,"لله أي فتى أقل رداءه","https://www.aldiwan.net/poem47068.html","الكامل"],[190,"من أراد المل والراحة","https://www.aldiwan.net/poem43484.html","مجزوء الرمل"],[190,"من كان يزعم أن الحب يتلفه","https://www.aldiwan.net/poem43818.html","البسيط"],[216,"فلي كبد ما انفك عنها غليلها","https://www.aldiwan.net/poem37837.html","الطويل"],[226,"إن في الألوان أسرارا","https://www.aldiwan.net/poem55267.html","مجزوء الرمل"],[226,"صدقت فيما حكت عنك الدموع","https://www.aldiwan.net/poem55268.html","الرمل"],[228,"جثم الليل بأحضان التلال","https://www.aldiwan.net/poem41896.html","الرمل"],[333,"اسبقي الشمس كالشعاع وثوبا","https://www.aldiwan.net/poem54975.html","الخفيف"],[369,"لولا رجائي ثانيا للقائه","https://www.aldiwan.net/poem61006.html","الكامل"],[376,"يا هل على الطرفين من حاكم","https://www.aldiwan.net/poem57163.html","السريع"],[376,"أيها النازل في بيت","https://www.aldiwan.net/poem57328.html","مجزوء الرمل"],[385,"يحار الطرف في دل عجيب","https://www.aldiwan.net/poem48827.html","الوافر"],[415,"إلى كم أعنى بالسرى والسباسب","https://www.aldiwan.net/poem32505.html","الطويل"],[449,"لست أنسى عهد ليل قريب","https://www.aldiwan.net/poem56036.html","المديد"],[484,"قل معي يا ولدي","https://www.aldiwan.net/poem36926.html","مجزوء الرمل"],[519,"يلوح فتستدعي الفراش وتبسم","https://www.aldiwan.net/poem20798.html","الطويل"],[556,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122695","المنسرح"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145827","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59412","الكامل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61244","المديد"],[1122,"","https://poetry.dctabudhabi.ae/diwan/poem/98088","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56152","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136240","الخفيف"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132809","الوافر"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48970","الرمل"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74993","الوافر"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89529","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27830","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27793","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204434","الطويل"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123880","المتقارب"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67985","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138489",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109988","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91711","الطويل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76517","الخفيف"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76446","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111462","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111424","الخفيف"],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105566","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102756","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136640",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83578","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72432","الكامل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104891","الخفيف"],[5002,"قال... وقالت!","https://www.poetsgate.com/ViewPoem.aspx?id=202699",""],[5056,"<< حالة عشق >>","https://www.poetsgate.com/ViewPoem.aspx?id=34075",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5147,"هي الحقيقة والعقبى بمجراها","https://www.poetsgate.com/ViewPoem.aspx?id=166753",""],[5186,"\"أيهذا \"\"الدبور\"\" أين الحمار","https://www.poetsgate.com/ViewPoem.aspx?id=156553",""],[5212,"قبرُ البدور","https://www.poetsgate.com/ViewPoem.aspx?id=212057",""],[5691,"وجبة تحقيق","https://www.poetsgate.com/ViewPoem.aspx?id=206390",""],[5776,"ذو المعصم الواحدة","https://www.poetsgate.com/ViewPoem.aspx?id=199400",""],[5906,"آدمية جائرة","https://www.poetsgate.com/ViewPoem.aspx?id=188520",""],[5953,"قد أضأ بالقائم النيران","https://www.poetsgate.com/ViewPoem.aspx?id=93851",""],[2220,"أنا في الأمرِ مثلكمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11359&r=&rc=233",""]],"verses":[["فَلْيَكْلأِ اللهُُ سَعْدِي","وَلْيَرَعَ مَا أَعْطَانِي",0,"ن",2,0],["فَلْيَكُنْ شَاهِداً لَكُمْ لا عَلَيْكُمْ","ذَاكَ فِي وُسْعِكُمْ وَبَيْنَ يَدَيَكُمْ",1,"م",1,0],["فَلْيُكْمِلِ المَوْلَى لِمِصْرَ بِكَ المُنَى","وَلْيُتْبِعُ الإِنْعَامِ بِالإِنْعَامِ",2,"م",1,0],["فليكن بعضكم لبعض نصيراً","ومُعيناً له على كل حال",3,"ل",1,0],["فلْيكفُّوا عن الجِدال وإلا","فليكونوا له إذاً نُظراءَ",4,"ا",2,0],["فليكن ما استطاع ساعي المساعي","أحسن اللابسين عقداً وبردا",5,"د",2,0],["فَليَكُنِ الحُسنُ رِداءً لَها","تَرفُلُِ بِهِ أَو فَلتَكُن عارِيَه",6,"ه",1,0],["فَليَكُن بِرُّكَ الجَوابَ فَإِنّي","بِجَميلِ الثَناءِ راعٍ كَفيلُ",7,"ل",1,0],["فَلْيُكْمَدِ الأعداءُ أو فَلْيَحْمَدوا","إذ قدَّروا فيه الذي لم يُقْدَرِ",8,"ر",1,0],["فلي كَبِدٌ بالبين منكم تَصَدّعَتْ","وطولُ اغترابي زائدٌ في انصداعها",9,"ع",3,0],["فليَكُنْ لِلْمُحَسَّنِ الأجَلُ المَمْ","دودُ رغماً لآنُفِ الحُسّادِ",10,"د",1,0],["فَلْيَكُنْ فَيءٌ ذلِكَ الأَرْزِ بَرْداً","وَسَلاَماً عَلَى المَشُوقِ الْعَمِيدِ",11,"د",1,0],["فَلْيَكُنْ منْ تَمَام جَوْدكَ عُذْري","فَقَبُولُ الأَعْذَار شَأْنُ الجَّوَّاد",12,"د",1,0],["فَلْيَكْلإِ اللهُ الرَّئِيسَ وَيُبْقِهِمْ","ذُخْراً عَزِيزاً لِلحِمَى وَفَخَارَا",13,"ر",2,0],["فليكتب المستعمرون بغيظهم","وليخجلوا ، وليخسأ المستعبد",14,"د",1,0],["فَلْيَكُنْ بِلاُّك الجَوَابَ ، فإِنِّي","بِجَمِيلِ الثَّنَاءِ رَاعٍ كَفِيلُ",15,"ل",1,0],["فليكن … ولأمت ثلاثين موتا","كلما خضت ستّة هاج تسعه",16,"ع",2,0],["فَليَكُنِ المَغلوبُ غَيرَ الغالِبِ","وَلَيكُنِ المَسلوبُ غَيرَ السالِبِ",17,"ب",1,0],["فليكثرِ الحسادُ فيَّ مقالَهُم","شَرْوى الكلابِ تناوَحَتْ بِهَريرِ",18,"ر",1,0],["فليكن فردا من النا","س ويرضى بالقليل",19,"ل",1,0],["فليكسر الحب وليشرب براحته","فالشرب بالحب يؤذيه ويبهره",20,"ر",2,0],["فلي كَبِدٌ ما انفَكَّ عَنْها غَلِيلُها","ولي أعْظَمٌ لا شَكَّ زادَ نُحُولُها",21,"ل",3,1],["فليكن منها علاج","مستديم للبشر",22,"ر",1,0],["فليكن هذا عزاءً سائغاً","عند من خر لدى الموت صريع",23,"ع",1,0],["فَليَكُن فَخرُكِ قَلبي إِنَّهُ","ذابَ من أَجلِكِ في كَأسِ الأَنين",24,"ن",1,0],["فليك القابعون في معبد الحك","م سلاماً أو فليكونوا حروبا",25,"ب",2,0],["فليكْشفَنَّ عنِ الورى غَمّاءها","أيُّ الثّلاثةِ كان من أضوائه",26,"ا",3,0],["فَليكفِ هَذا هَذِه أهلَها","فَقَد كَفَى تِلكَ أَبو القاسِمِ",27,"م",1,0],["فليَكُن ما كانَ في","شَعبانَ في شَهر رَبيعِ",28,"ع",1,0],["فَلي كَبد يَقطَعُها اِشتِياقي","وَقَلب لا يَقِرُّ مِن الوَجيب",29,"ب",1,0],["فلي كلَّ يومٍ من جَوى الهمِّ صاحبٌ","يُجدِّدُ أحزاني على فَقدِ صاحبِ",30,"ب",1,0],["فليكن بالسجن أو بالسفر","قاضيا فللذنب ذنبي عظيم",31,"م",1,0],["فليكن منكم لنا","خير عون مرشد",32,"د",1,0],["فلي كلَّ حينٍ منه لُطفٌ مجدَّدٌ","ولي كلَّ يومٍ من أيادِيه أنعُمُ",33,"م",1,0],["فلِي كَبِدٌ تَصلى بغيرِ خريدةٍ","وَلِي جَسدٌ يبلي بغير كَعابٍ",34,"ب",1,0],["فَليُكثِروا القَولَ إن هُم كَذَبُوا","عَلَيَّ في قَولِهِم وإن صَدَقُوا",35,"ق",3,0],["فلْيكنْ شكلُنا قبيحاً سنبدو","آدميين َغير أنّا زَوَايَا",36,"ا",3,0],["فليكف أنا خير أمة أخرجت","للناس إذ لذنا باشرف مرسل",37,"ل",1,0],["فَليَكُن مَن جاءَ يَسكنها","بَعدنا مِنها عَلى حَذَر",38,"ر",1,0],["فليكن ذاكَ بالضمير وبالإيما","ءِ لا تذكُرَنَّ ربّكَ جهرا",39,"ر",2,0],["فليكفنا الله اغترا نفوسنا","ابداً يقنعنا بما قد حلّلَهْ",40,"ل",2,0],["فليكن في الشهود منك انتفاع","حبذا ما بدا بوصف انتفاع",41,"ع",1,0],["فَليَكفِ حِلفَ الفَقرِ ظِلُّ سِدرِهِ","مَن لَم يَقِف عِندَ انتِهاءِ قَدرِهِ",42,"ه",1,0],["فَليَكدَحِ اليَومَ لِغِبِّ رَمسِهِ","حَزامَةً قَبلَ أفُولِ شَمسِهِ",42,"ه",1,0],["فلي كَبِدٌ به حَرَّى وقَلبٌ","على ما فيه من كَمَدٍ طَرُوبُ",43,"ب",1,0],["فليكن شعرُك من غزل البناتْ","لا من الشعر كشعر القدماءْ",44,"ا",2,0],["فَلي كبد عَلى النار تصلى","وَشكل للنوى أَبَدا حزين",45,"ن",1,0],["فَليَكفِهِم مَفخَراً دُنيا وَآخِرَةً","هذا المَقامُ الذي ميزانُهُ رَجَحا",46,"ح",2,0],["فليكن عندك من ذا خبرٌ","منصفٌ تعرفه لا تجحده",47,"د",2,0],["فليكن خيرَ ملجأ","أنكم خير مُستند",48,"د",1,0],["فلي كل حين مأتم وولادة","وشخصي مولود وشخصي والد",49,"د",1,0],["فلي كلما ظفرت راحتي","بجود المظفر أوفى أرب",50,"ب",1,0],["فلي كَلَفٌ من طورِ سَيْناء ناره","لرَشْفٍ لماءِ الوصل أَوْ يُصحبُ الخال",51,"ل",1,0],["فليكن في حبه مستبشراً","لا يخافن عظيم السيئات",52,"ت",1,0],["فلي كَبِدٌ من سهمِ وزري جريحةٌ","تُقابِلُها الآثامُ بالصَدعِ والرضِّ",53,"ض",1,0],["فلي كلما مرّت بفكري هباتها","وَبعد التَلاقي أَيّ صفقة بائس",54,"س",1,0],["فَليَكن للغد القَريب ابنك النا","ر تذيب الحَديد والاغلالا",55,"ل",2,0],["فَليَكن منتصرا في المصرع","وَلتكن بعض ضَحايا الانتداب",56,"ب",1,0],["فَلِيكُرغُ قاوَمَ آلَ السَّما","فَما قامَ قائِمُهُ بَعَد ما",57,"م",2,0],["فَليُكَتِّب ذَوِيه كلُّ نَزِيلٍ","ولك الأَمرُ فَوقَ كُلِّ نزِيلِ",58,"ل",1,0],["فليكٌ له الأملاك نثني رقابها","إذا ما دهاها الخطب أو أعضل الأمر",59,"ر",1,0],["فلى كل يوم في المعاصي زيادة","ونفس أبت في الغي الا تماديا",60,"ي",2,0],["فلي كبدٌ بين الظُعون جريحةٌ","ولي جَسدٌ في أربع ومغاني",61,"ن",2,0],["فَليكُ الصَفحُ وَالتَسامُحُ عَمّا","كانَ مِنكُم من فِريَةٍ وَاِختِلاقِ",62,"ق",1,0],["فليكثر التعنيف من","جهل الغرام فعنفا",63,"ف",2,0],["فليكن في المحب مذهبك العدل","كما فيك مذهبي التوحيد",64,"د",1,1],["فلي كنتِ إلهاماً تربَّي سجيّةً","فعطرْتِ أشعاريِ وماجُدْتُ عَطِّري",65,"ر",2,0],["فليكن ما كان من حالٍ فمالي","في مقام السحر ترديدُ المُحال",66,"ل",1,0],["فلي كبد يطفى رسيس غرامها","وعذبة رشفي لزمزم كالظلما",67,"م",2,0],["فليكفها عند ذكرانا العلاء علا","إن التقادير يجري إثر مجراها",68,"ا",3,0],["فليكابر مكابر، وليناهض","كل من شاء، وليغر من يغار",69,"ر",1,0],["فَلِيكتُبِ التّأريخُ أَنّ مُخَرِّفاً","تاقَ النَّفيسَ وإنَّهُ كَهَلوعِ",70,"ع",1,0],["فلْيكْتُبِ التُّلْمودَ حاخاماتُكُمْ","ولْيلْتزمْ حُكماؤكُمْ ماأبْرموا",71,"م",3,0],["فلي كعطّان َكفٌّ واحدٌ ومعي","كالصقر أيد ٍإليهم تبلغُ الغرضا",72,"ض",2,0],["فَلي كَلبٌ أُلاطِفُهُ وأقْسْو","وبَعضُ الوقتِِ يحرَدُ حينَ يَنويْ",73,"و",2,0],["فليكن نشرا كبيرا مهولا","من ثوى برهوت ذات الهوان",74,"ن",1,0],["فليكن خيراً ملجإٍ","إنكمْ خيرُ مستندْ",75,"د",1,0]]}