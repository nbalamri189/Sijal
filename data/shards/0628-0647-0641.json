{"poems":[[72,"بربك أيها العام الجديد","https://www.aldiwan.net/poem43106.html","الوافر"],[30,"نعائي ابن ليلى للسماح وللندى","https://www.aldiwan.net/poem5378.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54519","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54769","المتقارب"],[119,"رعى الله أطلالا بشهبائنا الغرا","https://www.aldiwan.net/poem41734.html","الطويل"],[164,"أتاها رسولي فاسمعوا ما جرا له","https://www.aldiwan.net/poem58988.html","الطويل"],[193,"رأى مدح خير الخلق صعبا فأحجما","https://www.aldiwan.net/poem35105.html","الرمل"],[193,"لعرب النقا أكرم بهم عربا أهوى","https://www.aldiwan.net/poem35148.html","الطويل"],[214,"لواحظ تشهر بيض الصفاح","https://www.aldiwan.net/poem13460.html","السريع"],[369,"إذا لم يخن صب ففيم عتاب","https://www.aldiwan.net/poem61000.html","الطويل"],[370,"يا أسفا على خزز بن عمرو","https://www.aldiwan.net/poem44499.html","الوافر"],[447,"دع الزفرات صاعدة طوامي","https://www.aldiwan.net/poem14481.html","الوافر"],[466,"ذريني وأهوالي نفر ونلتقي","https://www.aldiwan.net/poem15283.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87282","الوافر"],[1235,"","https://poetry.dctabudhabi.ae/diwan/poem/105224","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112745","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104811","الطويل"],[2080,"","https://poetry.dctabudhabi.ae/diwan/poem/124619","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109422","السريع"],[2274,"","https://poetry.dctabudhabi.ae/diwan/poem/144752","الطويل"],[2442,"","https://poetry.dctabudhabi.ae/diwan/poem/198632","الطويل"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100493","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112693","الوافر"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48282","الطويل"],[3643,"","https://poetry.dctabudhabi.ae/diwan/poem/145190","الطويل"],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140289",""],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117845","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135931","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77070","الرجز"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119672","الطويل"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136815",""],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102747","الطويل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45043","الطويل"],[4386,"","https://poetry.dctabudhabi.ae/diwan/poem/33839","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58179","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72450","المتقارب"],[4778,"الربيع القادم","https://www.poetsgate.com/ViewPoem.aspx?id=188148",""],[4578,"بعيني غزال ألبان هاروت ماكث","https://www.poetsgate.com/ViewPoem.aspx?id=49366",""],[4878,"مصابك فيه ركن الدين هدا","https://www.poetsgate.com/ViewPoem.aspx?id=170951",""],[5237,"بإحسان ذي الطول أهل الكرم","https://www.poetsgate.com/ViewPoem.aspx?id=113118",""],[5431,"شَغِفْتُ بدفئه الأسمرْ","https://www.poetsgate.com/ViewPoem.aspx?id=185257",""],[5431,"أيا خير من صافى وياخير من عفّا","https://www.poetsgate.com/ViewPoem.aspx?id=191456",""],[5493,"إلى ولدي","https://www.poetsgate.com/ViewPoem.aspx?id=197906",""],[192,"نبض الشوارع","https://www.poetsgate.com/ViewPoem.aspx?id=16352",""]],"verses":[["بِهِ فَتَحوا المَمالِكَ ثُمَّ سادوا","كَذاكَ العَدلُ صاحِبُهُ يَسودُ",0,"د",1,0],["بِهِ فَاِنزِلوا فَاِبكوا عَلَيهِ فَإِنَّكُم","وَمِقراهُ كَالناعي أَباهُ المُزايِلِ",1,"ل",1,0],["بِهِ فُجِرَ الحُسْنُ مِنْ مَنْبِعٍ","فَيَا عَجَباً لِلرِّمَالِ الظِّمَاءْ",2,"ا",2,0],["بِهِ فَاسِدُونَ أَعُوذُ بِحَوْ","لِكَ مِنْ شَرِّ خَلْقٍ إِذَا مَا فَسَدْ",3,"د",1,0],["به في الحمى سدنا في رغم ضدنا","ودسنا العدى واللَه عوضنا خيرا",4,"ر",2,0],["به فاقتدوا يا طالبي المجد والعلا","ولكن بعيد أن تنالوا مناله",5,"ل",2,0],["بهِ فاقتِ الزوجات طرّاً ومريَما","عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما",6,"م",2,0],["بهِ فاقتِ الدنيا وصارَت أعزّها","وَأشرفها أرضاً وأشرقها جوّا",7,"و",2,0],["به فادي زاد لكنني","من شرف الدين ارجو الصلاح",8,"ح",1,0],["به في صُدورِ النّاسِ يُفرَش لي هوىً","ويُحرَشُ من بينِ الضُّلوع ضِباب",9,"ب",1,0],["به فخرُ الفَوارسِ من زُبَيدٍ","كأنَّ جبينَهُ لألاءُ شمسِ",10,"س",1,0],["به فخرت عمير واستطالت","كما فخرت معد بالتهام",11,"م",1,0],["به في مساعيه حِرانٌ عن الدَّنا","وعند اكتساب الحمد شدَّةُ مُعنقِ",12,"ق",1,0],["بِهِ في هذهِ الدُنيا","سَعيد الإسم وَالطالعْ",13,"ع",1,0],["به فقدنا أخا العليا أغا حسن","فلا نرى عنه عمر الدهر سلوانا",14,"ن",2,0],["به فاطربونا في الجناب محبة","تعمم تعميما بكل الجوانب",15,"ب",1,0],["به فجع المدينة والمصلى","وزلزل بطن مكة المقاما",16,"م",2,0],["بهِ فابشِرُوا واستَبشِرُوا يا أَحِبَّتِى","مُنِحنا بِقُربٍ لاَ نَرَى بَعدَهُ بُعدَا",17,"د",2,0],["به فاض جثجاث الندى ومعينه","به عمرت نيه العلوم الحوادس",18,"س",1,0],["به فمُ الشام غدا باسماً","وهو عليه بالثنا فاغِر",19,"ر",1,0],["به في فؤادِ الصَّبِّ سُقْمٌ مُبَرِّحٌ","فللهِ سُقمٌ ما ألّذ وما أهْنَا",20,"ن",2,0],["به فخرت قدماً أباطح رندةٍ","وسامت به أعلام حزوى وعاقب",21,"ب",1,0],["به فتكت أيدي المنون وأنه","لصارمٌ عزم في الخطوب مجرد",22,"د",1,0],["به فقدت لؤي طود عز","تزول الراسيات ولا تزول",23,"ل",1,0],["به في ثبات العَزْمِ والحزْمِ يُقْتَدى","إذا تخْفِقُ الرّاياتُ حيناً وتهْدأُ",24,"ا",1,0],["به فاز من قد فاز يا خير مرشد","لذا ورث الفردوس إذ ورث الوحيا",25,"ي",2,0],["به فرح الأموات يوم قدومه","عليهم وقد نالوا الهنا والترفعا",26,"ع",2,0],["به في حنين أيّد الله حزبه","وقد روعت أركانه بانهدامها",27,"م",3,0],["به فإنّيَ عُبَيدٌ من عبيدْ","لك فكن لي يا كريم يا مجيدْ",28,"د",1,0],["بِهِ فَكُن لِلوسع فيهِ باذِل","تَفُز مِنَ المَجدِ بِأَعلى مَنزِل",29,"ل",1,0],["به فضلت عدنان كعباً وحِميَراً","ودانت لعلياها تميمٌ ووائل",30,"ل",1,0],["به في البحر والسلسال ذي يسكّر الصاح","من لماها وما في الدرر من برق يلتاح",31,"ح",1,0],["به فخرت عدنان كل قبيلة","وباءت نزار بالعلاء وخندف",32,"ف",1,0],["بِهِ فازَ خَيرُ الدينِ بالأجر وَالثَنا","أَخو المأثُراتِ الشَفع وَالسؤدَدِ الوِترِ",33,"ر",1,0],["بِهِ فَهِمتَ إِليهِ شَوقاً","فَكيفَ لَكَ التَّصَبُّرَ لَو تَراهُ",34,"ه",1,0],["به فَعِلْمٌ نافعٌ وعَقْلُ","كذلكَ المُلْكُ معاً والعدلُ",35,"ل",1,0],["به فجعتنا عدتك المنون","ولم تدر قد فجعت بابن من",36,"ن",1,0],["به في كل بارقة هطول","وشؤبوب من الغيث الرضاب",37,"ب",1,0],["به في الهوى قلبي الشقي جدّ جده","على أنه بالهائم الصب عابثُ",38,"ث",1,0],["به فخرت بنو العليا وألقت","إليه زمامها شيبا ومردا",39,"د",2,0],["به فتح الله أرساله","شموس الهدى وبه قد ختم",40,"م",1,0],["بهِ فالشوق يقتلني","وعشقُ السمرِ بي يكبُر!",41,"ر",1,0],["به فيضُ خيرات وروضُ محبة","ونبعٌ به الإحسان جارٍ وماجفّا",42,"ف",2,0],["بهِ فخرِي وفِي العَلياءِ يبقَى","بهِ عمُري برغمِ المرِّ أحلَى",43,"ل",2,0],["به فقر مُدقع يبكي وبه غنا فاحش iiورائع","به بخل ظاهر وشامل به كرم لكن iiقنوع",44,"ع",1,0]]}