,[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43691","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43831","المديد"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43733","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43884","المتدارك"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43783","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54278","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54214","الخفيف"],[72,"يَا فَاضلا قد عني لرتبته","https://www.poetsgate.com/ViewPoem.aspx?id=189425",""],[106,"شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=179472",""],[106,"مضيفة الطائرة","https://www.poetsgate.com/ViewPoem.aspx?id=179675",""],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[43,"لك يا منازل في القلوب منازل","https://www.poetsgate.com/ViewPoem.aspx?id=183",""],[98,"سائل العلياء عنا والزمانا","https://www.poetsgate.com/ViewPoem.aspx?id=35379",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[90,"يا فراتي","https://www.poetsgate.com/ViewPoem.aspx?id=178986",""],[90,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[45,"يا فضل فيم الصدود والغضب","https://www.poetsgate.com/ViewPoem.aspx?id=33097",""],[91,"الفيلسوف المجنح","https://www.poetsgate.com/ViewPoem.aspx?id=53013",""],[99,"إفادة في محكمة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=581",""],[51,"يافؤادي غلبتني عصيانا","https://www.poetsgate.com/ViewPoem.aspx?id=30763",""]],"verses":[["يا فاقِدَ اللَهِ بَينَ الحَيِّ مِن يَمَنٍ","أَنساهُمُ الحِلمَ أَحقادٌ وَأَضغانُ",0,"ن",1,0],["يا فَوزُ ما مَلَّني حَقّاً رَسولُكُم","حَتّى مَلِلتُم وَما كُنتُم تَمَلّونا",1,"ن",2,0],["يا فوزُ كَم مِن ذَوي ضِغنٍ رَأَيتُهُمُ","يَنهَونَ عَنكِ وَلَكِن لا يُطاعونا",1,"ن",2,0],["يا فَوزَ مُنّي وَاِجمَعي","مِن شَملِنا ما قَد تَفَرَّق",2,"ق",1,0],["يا فَوزُ كَيفَ بِكُم وَالدارُ قَد شُحَطَت","بي عَنكُمُ وَخروجُ النَفسِ قَد أَزَفا",3,"ف",2,0],["يا فَوزُ ما ضَرَّ مَن أَمسى وَأَنتِ لَهُ","أَن لا يَفوزَ بِدُنيا آلِ عَبّاسِ",4,"س",1,1],["يا فَوزُ يا مُنيَةَ عَبّاسِ","قَلبي يُفَدّي قَلبَكِ القاسي",5,"ي",1,1],["يا فَوزُ هَل لَكِ أَن تَعودي لِلَّذي","كُنا عَلَيهِ مُنذُ نَحنُ صِغارُ",6,"ر",1,0],["يا فَوزُ لَولاكِ لَم أَنفَكَّ مِن طَرَبٍ","آوي إِلى آنِساتٍ كَالدُمى حورِ",7,"ر",1,0],["يا فَوزُ أَهلُكِ لاموني فَقُلتُ لَهُم","أَدّوا فُؤادي أَدَعكُم غَيرَ مَزجورِ",7,"ر",1,0],["يا فَوزُ أَنتِ الَّتي جَشَّمتِني رَقَصاً","يَبري المَهاري بِتَرحالٍ وَتَسيارِ",8,"ر",1,0],["يا فَوزُ يا زَهَرَةَ الدُنيا وَزينَتَها","أَنضَجتِ قَلبي وَأَلبَستِ الهَوى كَبِدي",9,"ي",1,0],["يا فَوزُ لا تَسمَعي مِن قَولِ واشِيَةٍ","لَو صادَفَت كَبِدي عَضَّت عَلى كَبِدي",10,"د",2,0],["يا فَوزُ هَل لي مِنكُمُ مَجلِسٌ","تَقَرُّ عَيني فيهِ قَبلَ المَمات",11,"ت",1,0],["يا فَوزُ بِاللَهِ هَبي","ذَنبي لِيَ اليَومَ هَبي",12,"ي",1,1],["يَافَتْكَةً أَخْفَتْ مَوَاطِئَ غَدْرِهَا","حِيَلُ الْخَدِيِعَةِ وَالظَّلامُ الْمُسْبَلُ",13,"ل",1,0],["يَا فَارسَ الْعَرَبِ الَّذِي مِنْ بَيْتِهِ","حَرَمٌ لَهَا حَجٌّ بِهِ وَمَنَاسِكُ",14,"ك",1,0],["يا فارِجَ الأزَماتِ بالقَلْبِ الذي","مهْما ارتَمى ذلّتْ لهُ أخْطارُهُ",15,"ر",2,0],["يا فارِسَ الأجْوادِ بيْنَ سَفينةٍ","غَزَويّةٍ تُشْجي العَدوَّ ومِنْبَرا",16,"ر",2,1],["يَا فُرْقَةَ السَّكَنِ الَّذِي لاَ تَرْتَجِي","يَوْمَ الْودَاع النَّفْسُ يَوْمَ إِيَابِهِ",17,"ب",2,0],["يا فِتنَةَ المُتَقَرّي","وَحُجَّةَ المُتَصابي",18,"ي",1,0],["يا فَتيتَ المِسكِ يا شَمسَ الضُحى","يا قَضيبَ البانِ يا ريمَ الفَلا",19,"ل",2,0],["يافارِسَ الخَيلِ إِذ شُدَّت رَحائِلُها","وَمُطعِمَ الجُوَّعِ الهَلكى إِذا سَغَبوا",20,"ب",3,0],["يا فارِسَ الخَيلِ إِن شَدّوا فَلَم يَهِنوا","وَفارِسَ القَومِ إِن هَمّوا بِتَقصيرِ",21,"ر",1,0],["يا فرع أصلين قد استكملا","من مجد ميراث ومجد اكتساب",22,"ب",1,0],["يا فرع إسماعيل أنداهم يدا","وأعزهم جاراً وأسمى منزلا",23,"ل",2,0],["يا فاقد الولد الوحيد عجبت من","داء عصاك وطالما أخضعته",24,"ت",2,1],["يَا فَخَارَ البَيَانِ مَاذَا دَهَاهُ","فَهُوَ اليَوْمَ خَاشِعٌ مُسْتَكِينُ",25,"ن",1,0],["يَا فَخْرَ دَارِ الأَنْبِيَاءِ أَلَمْ","يَضِقِ الضَّريحُ بِمُحْتَوَى عَلَمِ",26,"م",1,0],["يَا فُلْذَةَ الكَبِدِ الَّذِي لَمْ يَبْقَ مِنْ","آمَالِنَا فِيهِ سِوَى الآلامِ",27,"م",1,0],["يَا فَخْرَ مِصْرَ وَلِلْمَشَارِقِ سَهْمُهَا","مِمَّا كِنَانَتُهَا بهِ تَتَنَبَّلُ",28,"ل",1,1],["يَا فَتَى الشَّرْقِ لَيْسَ بَدْعاً إِذَا مَا","بُتَّ فِي الشَّرْقِ فَاقِدَ الأكْفَالِ",29,"ل",1,0],["يا فلك ماه مدارك","ونجومك المنيرا",30,"ر",2,0],["يا فاتقَ الرّتق من هذا الوجود كما","في سابق العلم قد خُطت قضاياهُ",31,"ا",2,0],["يا فاتح الرسل أو يا خَتْمَها شرفاً","والله قدّس في الحالين معناهُ",31,"ا",2,0],["يا فخر أندلسٍ لقد مدَّتْ إلى","عليك كفُّ اللاّئذ المستعصم",32,"م",1,0],["يا فخر أندلس وعصمة أهلها","لك فيهم النعمى التي لا تُجهلُ",33,"ل",1,0],["يا فخر أندلس وعصمة أهلها","للناس سرُّ في اختصاصك قد ظهرْ",34,"ر",1,0],["يا فاتِحَ الرسل أو يا ختمها شَرفاً","بوركتَ مُخْتَتِماً قُدْسْتَ مُفْتَتِحا",35,"ح",2,0],["يا فخر أندلسٍ وعصمةَ أهلها","يجزيك عنها اللهُ خيرَ جزاءِ",36,"ا",2,0],["يا فرَجاً علَّلْتُ نفسِي به","والفال محبوب لتعليلِهِ",37,"ه",1,1],["يافارِجَ الكَربِ العَظي","مِ وَكاشِفَ الخَطبِ الجَليلِ",38,"ل",1,0],["يا فاتحاً لي في الورى من عطفهِ","باباً فما آسى على إغلاقِ با",39,"ب",2,0],["يا فاضحَ الغزلان حيث رنا","وإذا انثنى يا مخجل القضب",40,"ب",1,0],["يا فاضحي في الهوى خط بعارضه","لقد نسخت على عشقي بفضّاح",41,"ح",1,0],["يا فرط ضعفي حيث صرت فريسة","وحمام بانات الحمى لي جارح",42,"ح",1,0],["يا فائض البحر من جودٍ ومن كرمٍ","أن شئت كامله أو شئت وافره",43,"ر",2,0],["يا فوز من مات في وقائعها","ما بين تلك العسالة الدبل",44,"ل",1,0],["يا فتى العليا وصاحبها","ما ترى في واثق الأمل",45,"ل",1,1],["يا فاضلاً لو رنت عين العماد له","لبات يخفق رعباً برقه الشامي",46,"م",2,0],["يا فاتكاً خدّه لي شامتاً بدمي","في ألف حلّ من الشكوى وفي حرم",47,"م",1,1],["يا فارغ الفكرة من شقوتي","يعينني من فيك أشقاني",48,"ي",1,0],["يا فاضل الدنيا دع المصريّ قد","أخملتَ ذكر الفاضل النيساني",49,"ن",2,1],["يا فاضلاً حمدت منه مودّته","وحسن إصغائه للمادحِ اللّسن",50,"ن",1,1],["يا فتكُ يا سيدتي","إن لم تثيبي فعدي",51,"ي",1,0],["يا فاصدَ العرق المبارك فصدُهُ","قسماً لقد صَفَّيْتَ غير مكدَّرِ",52,"ر",1,1],["يا فرقداً يهتدي السراةُ به","يا قمراً يُستضاءُ في الدُمُس",53,"س",1,0],["يا فقيد المثل والحا","مد موجود المُعنِّف",54,"ف",1,0],["يا فتى بان قلبه وهو ثاوٍ","قل لحاديك قد أنى أن تسوقا",55,"ق",2,0],["يا فتى حينَ يلبسُ الكشخَ غرَّ","وبه دون فلْسِهِ تحنيك",56,"ك",1,0],["يا فِضَّةً بيضاءَ مسْبُوكةً","جادتْ وصفَّتْها يدُ السابِك",57,"ك",1,0],["يا فَتَى آل بَرمكٍ ليَ مُرْجىً","ما أرى ماجداً سواك يكونه",58,"ن",2,0],["يا فؤادي غلبتني عِصيانا","فأطِعْني فقد عصيتَ زمانا",59,"ن",2,1],["يا فؤادي أما تَحنُّ إلى طُوْ","بَى إذا الريحُ هَبَّت الأغصانا",59,"ن",2,0],["يا فَيلَسوفاً قَد تَلاقى عِندَهُ","طَرَبُ الخَلِي وَحَرقَهُ المُتَوَجِّدِ",60,"د",1,0],["يا فاعِلَ الفَعلَةِ الَّتي اِشتَهَرَت","لَم تَجرِ في خاطِري وَلا خَلَدي",61,"ي",1,1],["يا فُؤَادي","ماتَ مَنْ تَهْوَى وهذا",62,"ذ",2,0],["يا فلذتَي كبِدِي يأبى تقطُّعها","مِن وَجدِها بِكُما ما عِشتُ سُلوانا",63,"ن",2,0],["يا فَتحُ قَد فتحَت تِلكَ الشهادَةُ لي","بابَ الطَماعَة في لُقياكَ جُذلانا",63,"ن",2,0],["يا فرحتي بالتاج ان","التاج حق لا يضيع",64,"ع",1,0],["يا فاكرا في القبر يسبر غوره","الغور مما انت تحسب اعمق",65,"ق",1,0],["يا فخر كل فريقٍ","وعارضاً يستهلُّ",66,"ل",1,0],["يا فايتني لسهدى على كيفك","تعالا لي والاَّ أبعت طيفك",67,"ك",1,0],["يا فارسا ترجلا","وانحط بعد ما علا",68,"ل",2,1],["يا فَوزُ تِلكَ دِمَشقُ خَلفَ سَوادِها","تَرمي مَكانَكَ بِالعُيونِ وَتَرمُقُ",69,"ق",1,0],["يا فَتاةَ العِراقِ أَكتُمُ مَن أَن","تِ وَأَكني عَن حُبِّكُم بِالعِراقِ",70,"ق",1,0],["يا فِتيَةَ الشامِ شُكراً لا اِنقِضاءَ لَهُ","لَو أَنَّ إِحسانَكُم يَجزيهِ شُكرانُ",71,"ن",1,0],["يا فَرَنسا لا عَدِمنا مِنَناً","لَكِ عِندَ العِلمِ وَالفَنِّ جُساما",72,"م",2,0],["يا فُؤادي لِكُلِّ أَمرٍ قَرارٌ","فيهِ يَبدو وَيَنجَلي بَعدَ لَبسِ",73,"س",1,0],["يا فَرَنسا نِلتِ أَسبابَ السَماء","وَتَمَلَّكتِ مَقاليدَ الجِواء",74,"ا",2,1],["يا فِتيَةَ التُركِ حَيّا اللَهُ طَلعَتَكُم","وَصانَكُم وَهَداكُم صادِقَ الخِدَمِ",75,"م",1,0],["يا فِتيَةَ المَعمورِ سارَ حَديثُكُم","نَدّاً بِأَفواهِ الرِكابِ وَعَنبَرا",76,"ر",2,0],["يا فِتيَةَ النيلِ السَعيدِ خُذوا المَدى","وَاِستَأنِفوا ن