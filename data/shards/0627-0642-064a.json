ps://www.aldiwan.net/poem3326.html","عموديه"],[467,"رويدك يا من تدعي شرف العلى","https://www.aldiwan.net/poem3407.html","عموديه"],[467,"رسوم ديار باللوى وربوع","https://www.aldiwan.net/poem3499.html","عموديه"],[473,"وأوقدت ناري باليفاع فلم تدع","https://www.aldiwan.net/poem4659.html","الطويل"],[482,"أبى الله إلا أن تعظم مطلقا","https://www.aldiwan.net/poem37599.html","الطويل"],[498,"أليلتنا بين العتابين والعذر","https://www.aldiwan.net/poem9855.html","الطويل"],[503,"أراني هلال الأفق لمعة أنسكم","https://www.aldiwan.net/poem38063.html","الطويل"],[543,"أجارتنا بذي نفر أقيمي","https://www.aldiwan.net/poem56652.html","الوافر"],[546,"أقيدوا القوم إن الظلم لايرضاه ديان","https://www.aldiwan.net/poem1761.html","الهزج"],[554,"قباء لها أعلى الربى وخيام","https://www.aldiwan.net/poem47236.html","الطويل"],[554,"أتمضي كذا أيدي الردى بالمصاعب","https://www.aldiwan.net/poem48057.html","الكامل"],[554,"إيابا أيها المولى إيابا","https://www.aldiwan.net/poem48081.html","الوافر"],[572,"رب أمور قد بريت لحاءها","https://www.aldiwan.net/poem52036.html","الطويل"],[716,"","https://poetry.dctabudhabi.ae/diwan/poem/202228","الطويل"],[740,"","https://poetry.dctabudhabi.ae/diwan/poem/29431","الطويل"],[818,"","https://poetry.dctabudhabi.ae/diwan/poem/20473","الوافر"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/29531","الطويل"],[1047,"","https://poetry.dctabudhabi.ae/diwan/poem/29384","الوافر"],[1047,"","https://poetry.dctabudhabi.ae/diwan/poem/29382","البسيط"],[1188,"","https://poetry.dctabudhabi.ae/diwan/poem/122164","الوافر"]],"verses":[["أُقيمُ وَخَدُّ الضُحى أَبيَضٌ","وَأَسري وَوَجهُ الدُجى أَسفَعُ",0,"ع",1,0],["أَقيموا رِقابَ اليَعمَلاتِ فَإِنَّني","سَأَستَمطِرُ النَعماءَ نَوءاً بِفارِسِ",1,"س",1,0],["أَقيكَ الرَدى ما كانَ ما كانَ عَن قِلىً","وَلَكِن هَناتٌ كِدنَ يَلعَبنَ بِالجَلدِ",2,"د",1,0],["أَقِيمَا بِحَقٍّ مَأَتَمَ الْبَأْسِ وَالنَّدَى","وَلاَ تَقِفَا خَيْلَ الدُّمُوعِ إِلى مَدَى",3,"د",2,0],["أَقَيسَ بنَ مَسعودِ بنِ قَيسِ بنِ خالِدٍ","وَأَنتَ اِمرُؤٌ تَرجو شَبابَكَ وائِلُ",4,"ل",1,1],["أَقيمي فَإِنَّ الغَورَ يا عَزَّ بَعدَكُم","إِلَيَّ إِذا ما بِنتِ غَيرُ جَميلِ",5,"ل",1,0],["أَقيدي دَمًا يا أُمَّ عمروٍ هرَقتِهِ","فَيَكفيك فِعلُ القاتِلِ المُتَعَمِّدِ",6,"د",1,0],["أُقِيمَ لَمْ يَدَّخِرْ فِيهِ الكِرَامُ يَداً","لِلشَّعْبِ مَوْرِدَ تَهْذِيبٍ وَعُرْفَانِ",7,"ن",1,0],["أَقِيمُوا عَلَى هَذَا اْلإِخَاءِ وَعَلِّمُوا","فَضَائِلَهُ فِي الشَّرْقِ مَنْ يَتَعَلَّمُ",8,"م",1,0],["أُقيمُ السُرى فَوقَ المَطايا لِفِتيَةٍ","إِذا اِضطَرَبوا حَتّى تَجَلّى قَتامُها",9,"م",3,0],["أَقَينَ اِبنَ قَينٍ لا يَسُرُّ نِساءَنا","بِذي نَجَبٍ أَنّا اِدَّعَينا لِدارِمِ",10,"م",1,0],["أَقَينٌ يا تَميمُ يَعيبُ قَيساً","يَطيرُ عَلى لَهازِمِهِ الشَرارُ",11,"ر",1,0],["أَقيما فَإِنَّ اليَومَ يَومٌ جَرَت لَنا","أَيامِنُ طَيرٍ لا نُحوسٍ وَلا عُسرِ",12,"ر",1,0],["أَقيموا إِنَّما يَومٌ كَيَومٍ","وَلَكِنَّ الرَفيقَ لَهُ ذِمامُ",13,"م",1,0],["أَقي العِرضَ بِالمالِ التِلادِ وَأَشتَري","بِهِ الحَمدَ إِنَّ الطالِبَ الحَمدَ مُشتَري",14,"ر",2,0],["أُقيمُ بِهِ أَصلُ الفَخارِ وَفَرعُهُ","وَشُدَّ بِهِ رُكنُ العُلا وَدَعائِمُه",15,"م",2,0],["أقيما فروضَ الحزن فالوقت وقتها","لشمس ضحىً عندَ الزوال ندبتها",16,"ت",3,1],["أقيموا بنو أمي صدور مطيّكم","فإني إلى قومٍ سواكم لأمْيَل",17,"ل",1,0],["أقيموا في ضناكم أو أفيقوا","فإن عدنا فإنا ظالمونا",18,"ن",2,0],["أَقيموا بَني لُبنى صُدورَ رِكابَكُم","فَكُلُّ مَنايا النَفسِ خَيرٌ مِنَ الهَزلِ",19,"ل",1,0],["أَقيموا بَني أُمّي صُدورَ مَطِيَّكُم","فَإِنّي إِلى قَومٍ سِواكُم لَأَمَيلُ",20,"ل",1,1],["أُقيمُ بِالدارِ ما اِطمَأَنَّت بِيَ ال","دارُ وَإِن كُنتُ نازِحاً طَرِبا",21,"ب",2,0],["أَقيمي عَلى العهدِ ما بَينَنا","وَلا تَستَحيلي لِطولِ البِعادِ",22,"د",1,0],["أَقيمي عَلى العَهدِ الَّذي كانَ بَينَنا","فَإِنّي عَلى ما تَعلَمينَ مِنَ العَهدِ",23,"د",1,0],["أقيمُ على عبدٍ خَصِيٍّ مُنافِقِ","لئيمٍ رديءِ الفعلِ للجودِ مُدّعي",24,"ع",2,0],["أقيم لديك إلى أن يصير","جسمك روحا ونعم البديل",25,"ل",1,0],["أقيما صدورَ العِيس واستخبروا الصَّبَا","عن الحَيِّ بالجَرْعاءِ ما فعلوا بعدِي",26,"د",2,0],["أَقيموا بَني الدَيّانِ مِن سُفَهائِكُم","فَقَد طالَ عَن قَصدِ السَبيلِ مَحيدُها",27,"د",3,0],["أُقيمُ عَلى التَشَوُّقِ أَم أَسيرُ","وَأَعدِلُ في الصَبابَةِ أَم أَسيرُ",28,"ر",1,1],["أُقيمُ وَحيداً فيهِ أَندُبُ رَبعَهُ","وَآسى عَلى أَيّامِنا الجِدِّ وَالغُرِّ",29,"ر",1,0],["أُقيمُ وحظِّي الهجرُ عندَ إقامتي","وأرحَلُ والشوقُ المبرِّحُ زادي",30,"د",2,0],["أَقيمي أُمَّ كَعبٍ وَاِطمَئِنّي","فَإِنَّكِ ما أَقَمتِ بِخَيرِ دارِ",31,"ر",1,0],["أَقيكَ بِنَفسي أَيُّها المُصطفى الَّذي","هَدانا بِهِ الرَحمَنُ مِن عَمَهِ الجَهلِ",32,"ل",1,1],["أَقيموا عَلى الإِعراضِ مَع قُربِ دارِكُم","وَلا تُتلِفوا الأَرواحَ بِالبُعدِ عَنكُمُ",33,"م",1,1],["أَقي النَفسَ بِالأَموالِ حَيثُ إِذا وَقَت","كُنوزُ اللُهى نَفسي وَقيتُ بِها عِرضي",34,"ض",2,0],["أقْيَالُ حِمْيَرَ لا يَرُدّ زمانُهُمْ","لَهمُ بما أمرُوا بِه أقْوَالا",35,"ل",2,0],["أُقيمُ بِهِ سَوادَ اللَيلِ نَصّاً","إِذا حُبَّ الرُقادُ عَلى الهُبوبِ",36,"ب",1,0],["أقيموا الحقَّ بالسُّوَرِ الغَواليِ","فإنّ اللهَ يأمرُ أن يُقاما",37,"م",2,0],["أَقيموا على الأخلاقِ بُنيانَ عِزِّها","فقد هَجَعَ الباني وهَبَّ المُخرِّبُ",38,"ب",1,0],["أقيموا الحقَّ ليس له سواكم","وَسُوسوا النَّاسَ أجمعَ والشُّؤونا",39,"ن",2,0],["أَقيموا صُلبَهُ وَتَدارَكوهُ","وَلا تُدنوهُ مِن كَفَنٍ وَقَبرِ",40,"ر",1,0],["أقيموا على الفرقان تتلون آيَهُ","فذلك نورُ اللهِ ما دونه سِتْرُ",41,"ر",1,0],["أقيالُ حِمْيَرَ لانَ جانِبُ عِزِّهم","لِمُسلَّطٍ لِينُ الظُّبَى مِن لِينهِ",42,"ه",1,0],["أَقيموا عَلى المِعزى بِدارِ أَبيكُمُ","تَسوفُ الشَمالَ بَينَ صَبحى وَطالِقِ",43,"ق",1,0],["أقيموا صُدورَ النّاعِجاتِ فإنّهَا","سبيلَ الهوى بينَ الضُّلوع سَوالك",44,"ك",1,0],["أَقيمي لا أَعَدُّ الحَجَّ فَرضاً","عَلى عُجُزِ النِساءِ وَلا العَذارى",45,"ر",2,1],["أَقيمي فَإِنّي لا رَقيمِيَ مُعجِبي","وَرودي فَإِنّي لا أَهَشُّ لِرُوَدِ",46,"د",1,0],["أُقيمُ بِدارِ الحَزمِ ما دامَ حَزمُها","وَأَحرِ إِذا حالَت بِأَن أَتَحَوَّلا",47,"ل",2,0],["أُقِيمُ عَلىالتَقوى وَأَرضى بِفِعِلها","وَكُنتُ مِنَ النارِ المَخُوفَةِ أَوجرا",48,"ر",2,0],["أُقِيمُ عَلى التَقوَى وَأَرضَى بفِعلِهِ","وَكُنتُ مِنَ النارِ المَخُوفَةِ أَوجَرا",49,"ر",2,0],["أقيموا عليه مودَّاتكم","وإلَّا فقد رمتموهُ مُحالا",50,"ل",2,0],["أقيموا صدوركمو للخطوبِ","فما شطَّ طالبُ حقٍّ وغالى",50,"ل",2,0],["أَقَيسَ بنَ عَمرٍو غارَةً بَعدَ غارَةٍ","وَصُبَّةُ خَيلٍ تُحرِبُ المالَ وَالنَعَم",51,"م",1,0],["أُقِيمَ تِمْثَالُهُ وَلَكِنْ","بِهِ لِتِمْثَالِهِ الخُلُودُ",52,"د",1,0],["أَقِيلوا أَخَاكُمْ إِذَا مَا عَثَرْ","فَإِنَّ الْجَمِيلَ جَمِيلُ الأَثَرْ",53,"ر",1,1],["أَقِيمِي أُطِلْ مِنْ نَظْرَتِي مَا اسْتَطَعْتُهَا","إِلَى جَانِبٍ مِنْ وَجْهِكِ المُتَحَوِّلِ",54,"ل",1,1],["أُقِيمَ لِيُجْزَى فِيهِ بِالخَيْرِ عَامِلٌ","نَشِيطٌ كَمَا يَهْوَى النُّبُوغَ قَدِيرُ",55,"ر",1,0],["أقيموا الصِّناعاتِ في أرضِكُمْ","وسَوُّوا الهِضَابَ، وروَّوا الأكَمْ",56,"م",1,0],["أُقيمَ له عرشٌ، وزُلزِلَ عرشُهُ","ولم يمْضِ في الدنيا عليه ربيعُ!",57,"ع",1,0],["أقِيمي، أوْ فَرِيمي، يَا حَياتي","سواءٌ: أَنْ تُقيمي، أو تَرِيمي",58,"م",2,0],["أقيمو عليه مودّاتكم","وإلاّ فقد رمتموه محالا",59,"ل",2,0],["أقيمو صدوركمو للخطوب","فما شطّ طالب حقّ وغالى",59,"ل",2,0],["أُقيمُ عَلى التّشَوّقِ أمْ أسِيرُ،","وَأعدِلُ في الصّبَابَةِ أمْ أجُورُ",60,"ر",1,1],["أقيم ما شئت في عدن وأتركها","وأخلع الجسم أحيانا وأتّزر",61,"ر",1,0],["أُقِيمُ بالْدَّارِ مَا اطْمَأَنَّتْ بِيَ الدْ","دَارُ وَإنْ كُنْتُ نَازِحَاً طَرِبا",62,"ب",2,0],["أقيمُ به سوادَ الليلِ نصاً،","إذا حُبَّ الرُّقادُ عَلَى الهَيُوبِ",63,"ب",1,0],["أَقيمي إِلى أَن تَشتَهي السَير عِندَنا","وَرُوحي لِمَن تَبغي وَخِفي بِلا طَرد",64,"د",1,0],["اقيموا من الارواح صفا مؤيدا","له الجاه عند الله يولي به الوهبا",65,"ب",2,0],["أَقِيموا على قَبري من الصَخرِ دُميةً","بها رَمزُ عَيشي بعدَ مَوتيَ يُعرَضُ",66,"ض",1,1],["أُقيمَ لَهُم بِالقاعِ قاعِ بَلاكِثٍ","إِلى ذَنَبِ الجَزلاءِ يَومٌ عَصَبصَبُ",67,"ب",1,0],["أقِيمًَت ومُلَّت واستُمِيلَ ثِقَافُها","عَلَى وِجهَةِ اليُمنَى وسَاغَت عُنُودُهَا",68,"د",3,0],["أُقيمُ عَلى نَصرِ النَبِيِّ مُحَمَّدٍ","أُقاتِلُ عَنهُ بِالقَنا وَالقَنابِلِ",69,"ل",1,0],["أقيمي في الربوع وجاورينا","فيا نعم المجاور والقرين",70,"ن",1,0],["أَقيمُوا صُدورَ اليَعمُلاتِ ورَفِّعُوا","عَنِ السُبلِ تَنجُوا مِن سَبيلِ المَهالِكِ",71,"ك",1,0],["أَقيما عَلى حَرِّ المُدى أَو تَرَحَّلا","فَلَستُ بِراضٍ مَنزِلَ الهُونِ مَنزِلا",72,"ل",2,1],["أَقيكَ بِنَفسيَ صَرفَ الرَدى","وَحاشاكَ يا أَمَلي أَن تَحينا",73,"ن",2,1],["أقِيس بك الأملاكَ طُرًّا فلا أَرى","سواك زكي الأصل والفرع والنَّسَب",74,"ب",1,0],["أَقيمي إِلَيكِ عَبدَ عَمرٍو وَشايِعي","عَلى كُلِّ ماءٍ وَسطَ ذُبيانَ خَيَّما",75,"م",2,0],["أقيلي عثرةَ الحرِّ النزيهِ","فما ألقاهُ غيري يَتَّقيهِ",76,"ي",2,1],["أُقِيمُ عَلَى الصَّدى ما لَمْ يُهَبْ بِي","إِلى الْوِرْدِ الْكَرِيمِ وَلَمْ يُجاجا",77,"ج",2,0],["أُقيم طَليقاً بِالحِمى وَأَسيرُ","وَقَلبِيَ بِالخَدِّ الأَثيلِ أَسيرُ",78,"ر",1,1],["أقيمَ يمين دارِ الملك منهُ","لِكعبةِ مَجدِها ركنٌ سعيدُ",79,"د",1,0],["أقيمي على الدهر عرش الخلود","وهزّى بصوتك قلب الوجود",80,"د",1,0],["أقيودا والكائنات انطلاق","أم ركودا والعالمون اضطرام",81,"م",1,0],["أُقيمُ لَها وَجهَ الزَمانِ مُصَلِّياً","بِتَوجيدِها في ذاتَها الصَمَدِيَّةِ",82,"ه",1,0],["أُقيمُ بأَعلَى الدَّيرِ فَرْداً مُتَيّماً","أُسائلُ عَمَّنْ حَلّ بالأجْرَعِ الفَرد",83,"د",1,0],["أقيما على باب الإِله وداوما","على قرعه فهو المجيب لداعيه",84,"ي",2,0],["أُقيمُ على الوُدِّ ثَبْتَ الجَنانِ","فلا استَحيلُ ولا أضْطَرِبْ",85,"ب",1,0],["أَقيدوني حآذركم فَقالوا","جِراحة كل عَجماء جَبارُ",86,"ر",1,0],["أقيموا على قبر ثوى فيه بندر","صدور المطايا ما ثوى قبر بندر",87,"ر",1,0],["أُقيلُ ولا أَقُولُ وأَيُّ ذَنْبٍ","لِمَنْ مالَ الزمانُ به فمالا",88,"ل",2,0],["أقيموا عمود الدين للّه تسعدوا","فقد جاءكم عيسى وهذا محمد",89,"د",1,1],["أقيل في كورها كالصقر مرتقياً","به أبيت وجنح الليل ممدود",90,"د",1,0],["أقيلي وغنى غناءَ الربيع","ولو في الخريفِ فينأَى الصقيع",91,"ع",1,0],["أُقيمَ فيها لك رس","مُ الحافظِ المهتَمِّ",92,"م",1,0],["أقيما فلا الأخطارُ تُركَبُ دونهم","لحظٍّ ولا العيسُ المراسيلُ تُرحَلُ",93,"ل",1,0],["أقيم عليها بأمر الهوى","وأمرُ النُّهى أنني راحلُ",94,"ل",1,0],["أقيمُ ولم أقمْ عنه لِمُسْلٍ","ويرحَلُ لم يَسْرِ منّي بزادِ",95,"د",1,0],["أقيمت بهِ سوقٌ بضائعُ أهلها","من الجوهر البحريّ خير البضائع",96,"ع",1,0],["أقيمت قيامة أهل الهوى","فكم مالكٍ غال قلباً بسجن",97,"ن",1,0],["أقيما صدورَ اليعملاتِ صبابةً","بكل جوادٍ مثل عالية الرُّمح",98,"ح",1,0],["أقيما صدور العيس لست بضارع","ولا واصلاً من بعدها لقطوع",99,"ع",1,0],["أُقيمَ بِحَمدٍ مَا أَقَمتُ وَأن أَبِن","إِلَى غَيرِكُم لَم أحمَدِ المُتَوَدّدا",100,"د",2,0],["أقيمت ولا من لاجلك حفلة","وأجمل ما فيها اجتماع لأصدقا",101,"ق",2,0],["أقيسُ أبا نصر بأيٍّ أقيسه","أبالبحر أم بالدهر أم بسنا الفجر",102,"ر",1,0],["أَقيموا لنا وزنَ الغَرامِ برأْفَةٍ","إذا حوسِبَتْ فيكم رِجالُ المحبَّةِ",103,"ه",1,0],["أَقيمي وَجهَ عامكِ ثُمَّ سيري","بلاوَاهِي الجِوارِ وَلا مُليمِ",104,"م",1,0],["أقيدوا القومَ إنَّ الظُل","مَ لا يرضاهُ دَيَّانُ",105,"ن",1,1],["أقيموا على مَنْ وجهُهُ الشّمسُ بهجةً","وكفّاه من فيض النوالِ غمامُ",106,"م",1,0],["أقيموا فلا نارٌ تَوَقَّدُ للقِرى","ولا راحةٌ مفجورةٌ بالمواهبِ",107,"ب",1,0],["أَقيلونا الذّنوبَ فَإِنَّ فيكُمْ","وَعِندَكُمُ لِمُجرِمِكُمْ متابا",108,"ب",2,0],["أُقيمُ بدار الحرب ما لَم اهَن بها","فان خفتُ من دار هواناً تركتها",109,"ت",3,0],["أقيموا لنا ديناً حنيفاً فانتم","لنا غاية قد يُهتدى بالذوائب",110,"ب",1,0],["أَقيموا بَني النُعمانِ عَنّا صُدورَكُم","وَإِلّا تُقيموا كارِهينَ الرُؤوسا",111,"س",2,0],["أَقي حَسبي بِهِ وَيَعِزُّ عِرضي","عَلَيَّ إِذا الحَفيظَةُ أَدرَكَتني",112,"ن",2,0],["أَقَيسَ بنَ مَسعودِ بنَ قَيسِ بنَ خالِدٍ","أَموفٍ بِأَدراعِ اِبنِ طَيبَةَ أَم تُذَمّ",113,"م",1,0],["أقيسٌ إن هلكتُ وأنت حيٌّ","فلا تعدم مواصلة الفقير",114,"ر",1,1],["أقيم عوجته إن كان ذا عوج","كما يقوم قدح النبعة الباري",115,"ر",2,0],["أقيمُوا يا سَراةَ الأوسِ فيها","كأنكم من المَخزاةِ عُورُ",116,"ر",1,0]]}