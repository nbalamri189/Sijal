5438,"تَكْوِينٌ لِذَاتِي","https://www.poetsgate.com/ViewPoem.aspx?id=202094",""],[5459,"أقيموا الوزن بالقسط","https://www.poetsgate.com/ViewPoem.aspx?id=198347",""],[5464,"طرقنا بابكم فأجاب صمت","https://www.poetsgate.com/ViewPoem.aspx?id=6677",""],[444,"صباح مُحلّى حُبّا","https://www.poetsgate.com/ViewPoem.aspx?id=184403",""],[5563,"غيداء لعوب","https://www.poetsgate.com/ViewPoem.aspx?id=211741",""],[5563,"لا بيت لي ولا صاحب","https://www.poetsgate.com/ViewPoem.aspx?id=214534",""],[5616,"حرص","https://www.poetsgate.com/ViewPoem.aspx?id=207652",""],[5691,"عكاظُ الفيسِبوك...!","https://www.poetsgate.com/ViewPoem.aspx?id=207585",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5896,"القمران","https://www.poetsgate.com/ViewPoem.aspx?id=190063",""],[5937,"تزَلُّجٌ","https://www.poetsgate.com/ViewPoem.aspx?id=211891",""],[5937,"متحف الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=211894",""],[5943,"كصبح العيد ياأدباء إنَّا","https://www.poetsgate.com/ViewPoem.aspx?id=37258",""],[5952,"أقيموا على أخلاقنا اليوم مأتما","https://www.poetsgate.com/ViewPoem.aspx?id=197109",""],[5956,"علائق الروح ما بيني وبين أبي","https://www.poetsgate.com/ViewPoem.aspx?id=192096",""],[5970,"أتينا للحياة ولا ذنوباً","https://www.poetsgate.com/ViewPoem.aspx?id=130599",""],[6125,"فمن عينيكِ ألتمسُ المعاني","https://www.poetsgate.com/ViewPoem.aspx?id=210908",""],[6228,"أمّة المجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85973&r=&rc=10",""],[463,"ذكرتُ وما وفايَ بحيثُ أنسى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60101&r=&rc=157",""],[6259,"سقى دمعي الأحبَّة َ حيث ساروا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59414&r=&rc=62",""],[5555,"مُعَلَّقَةٌ لِلِاحتِفَاءِ بِالْهَشَاشَةِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87404&r=&rc=0",""]],"verses":[["أُقيمُ وَخَدُّ الضُحى أَبيَضٌ","وَأَسري وَوَجهُ الدُجى أَسفَعُ",0,"ع",1,0],["أَقيموا رِقابَ اليَعمَلاتِ فَإِنَّني","سَأَستَمطِرُ النَعماءَ نَوءاً بِفارِسِ",1,"س",1,0],["أَقيكَ الرَدى ما كانَ ما كانَ عَن قِلىً","وَلَكِن هَناتٌ كِدنَ يَلعَبنَ بِالجَلدِ",2,"د",1,0],["أَقِيمَا بِحَقٍّ مَأَتَمَ الْبَأْسِ وَالنَّدَى","وَلاَ تَقِفَا خَيْلَ الدُّمُوعِ إِلى مَدَى",3,"د",2,0],["أَقَيسَ بنَ مَسعودِ بنِ قَيسِ بنِ خالِدٍ","وَأَنتَ اِمرُؤٌ تَرجو شَبابَكَ وائِلُ",4,"ل",1,1],["أَقيمي فَإِنَّ الغَورَ يا عَزَّ بَعدَكُم","إِلَيَّ إِذا ما بِنتِ غَيرُ جَميلِ",5,"ل",1,0],["أَقيدي دَمًا يا أُمَّ عمروٍ هرَقتِهِ","فَيَكفيك فِعلُ القاتِلِ المُتَعَمِّدِ",6,"د",1,0],["أُقِيمَ لَمْ يَدَّخِرْ فِيهِ الكِرَامُ يَداً","لِلشَّعْبِ مَوْرِدَ تَهْذِيبٍ وَعُرْفَانِ",7,"ن",1,0],["أَقِيمُوا عَلَى هَذَا اْلإِخَاءِ وَعَلِّمُوا","فَضَائِلَهُ فِي الشَّرْقِ مَنْ يَتَعَلَّمُ",8,"م",1,0],["أُقيمُ السُرى فَوقَ المَطايا لِفِتيَةٍ","إِذا اِضطَرَبوا حَتّى تَجَلّى قَتامُها",9,"م",3,0],["أَقَينَ اِبنَ قَينٍ لا يَسُرُّ نِساءَنا","بِذي نَجَبٍ أَنّا اِدَّعَينا لِدارِمِ",10,"م",1,0],["أَقَينٌ يا تَميمُ يَعيبُ قَيساً","يَطيرُ عَلى لَهازِمِهِ الشَرارُ",11,"ر",1,0],["أَقيما فَإِنَّ اليَومَ يَومٌ جَرَت لَنا","أَيامِنُ طَيرٍ لا نُحوسٍ وَلا عُسرِ",12,"ر",1,0],["أَقيموا إِنَّما يَومٌ كَيَومٍ","وَلَكِنَّ الرَفيقَ لَهُ ذِمامُ",13,"م",1,0],["أَقي العِرضَ بِالمالِ التِلادِ وَأَشتَري","بِهِ الحَمدَ إِنَّ الطالِبَ الحَمدَ مُشتَري",14,"ر",2,0],["أُقيمُ بِهِ أَصلُ الفَخارِ وَفَرعُهُ","وَشُدَّ بِهِ رُكنُ العُلا وَدَعائِمُه",15,"م",2,0],["أقيما فروضَ الحزن فالوقت وقتها","لشمس ضحىً عندَ الزوال ندبتها",16,"ت",3,1],["أقيموا بنو أمي صدور مطيّكم","فإني إلى قومٍ سواكم لأمْيَل",17,"ل",1,0],["أقيموا في ضناكم أو أفيقوا","فإن عدنا فإنا ظالمونا",18,"ن",2,0],["أَقيموا بَني لُبنى صُدورَ رِكابَكُم","فَكُلُّ مَنايا النَفسِ خَيرٌ مِنَ الهَزلِ",19,"ل",1,0],["أَقيموا بَني أُمّي صُدورَ مَطِيَّكُم","فَإِنّي إِلى قَومٍ سِواكُم لَأَمَيلُ",20,"ل",1,1],["أُقيمُ بِالدارِ ما اِطمَأَنَّت بِيَ ال","دارُ وَإِن كُنتُ نازِحاً طَرِبا",21,"ب",2,0],["أَقيمي عَلى العهدِ ما بَينَنا","وَلا تَستَحيلي لِطولِ البِعادِ",22,"د",1,0],["أَقيمي عَلى العَهدِ الَّذي كانَ بَينَنا","فَإِنّي عَلى ما تَعلَمينَ مِنَ العَهدِ",23,"د",1,0],["أقيمُ على عبدٍ خَصِيٍّ مُنافِقِ","لئيمٍ رديءِ الفعلِ للجودِ مُدّعي",24,"ع",2,0],["أقيم لديك إلى أن يصير","جسمك روحا ونعم البديل",25,"ل",1,0],["أقيما صدورَ العِيس واستخبروا الصَّبَا","عن الحَيِّ بالجَرْعاءِ ما فعلوا بعدِي",26,"د",2,0],["أَقيموا بَني الدَيّانِ مِن سُفَهائِكُم","فَقَد طالَ عَن قَصدِ السَبيلِ مَحيدُها",27,"د",3,0],["أُقيمُ عَلى التَشَوُّقِ أَم أَسيرُ","وَأَعدِلُ في الصَبابَةِ أَم أَسيرُ",28,"ر",1,1],["أُقيمُ وَحيداً فيهِ أَندُبُ رَبعَهُ","وَآسى عَلى أَيّامِنا الجِدِّ وَالغُرِّ",29,"ر",1,0],["أُقيمُ وحظِّي الهجرُ عندَ إقامتي","وأرحَلُ والشوقُ المبرِّحُ زادي",30,"د",2,0],["أَقيمي أُمَّ كَعبٍ وَاِطمَئِنّي","فَإِنَّكِ ما أَقَمتِ بِخَيرِ دارِ",31,"ر",1,0],["أَقيكَ بِنَفسي أَيُّها المُصطفى الَّذي","هَدانا بِهِ الرَحمَنُ مِن عَمَهِ الجَهلِ",32,"ل",1,1],["أَقيموا عَلى الإِعراضِ مَع قُربِ دارِكُم","وَلا تُتلِفوا الأَرواحَ بِالبُعدِ عَنكُمُ",33,"م",1,1],["أَقي النَفسَ بِالأَموالِ حَيثُ إِذا وَقَت","كُنوزُ اللُهى نَفسي وَقيتُ بِها عِرضي",34,"ض",2,0],["أقْيَالُ حِمْيَرَ لا يَرُدّ زمانُهُمْ","لَهمُ بما أمرُوا بِه أقْوَالا",35,"ل",2,0],["أُقيمُ بِهِ سَوادَ اللَيلِ نَصّاً","إِذا حُبَّ الرُقادُ عَلى الهُبوبِ",36,"ب",1,0],["أقيموا الحقَّ بالسُّوَرِ الغَواليِ","فإنّ اللهَ يأمرُ أن يُقاما",37,"م",2,0],["أَقيموا على الأخلاقِ بُنيانَ عِزِّها","فقد هَجَعَ الباني وهَبَّ المُخرِّبُ",38,"ب",1,0],["أقيموا الحقَّ ليس له سواكم","وَسُوسوا النَّاسَ أجمعَ والشُّؤونا",39,"ن",2,0],["أَقيموا صُلبَهُ وَتَدارَكوهُ","وَلا تُدنوهُ مِن كَفَنٍ وَقَبرِ",40,"ر",1,0],["أقيموا على الفرقان تتلون آيَهُ","فذلك نورُ اللهِ ما دونه سِتْرُ",41,"ر",1,0],["أقيالُ حِمْيَرَ لانَ جانِبُ عِزِّهم","لِمُسلَّطٍ لِينُ الظُّبَى مِن لِينهِ",42,"ه",1,0],["أَقيموا عَلى المِعزى بِدارِ أَبيكُمُ","تَسوفُ الشَمالَ بَينَ صَبحى وَطالِقِ",43,"ق",1,0],["أقيموا صُدورَ النّاعِجاتِ فإنّهَا","سبيلَ الهوى بينَ الضُّلوع سَوالك",44,"ك",1,0],["أَقيمي لا أَعَدُّ الحَجَّ فَرضاً","عَلى عُجُزِ النِساءِ وَلا العَذارى",45,"ر",2,1],["أَقيمي فَإِنّي لا رَقيمِيَ مُعجِبي","وَرودي فَإِنّي لا أَهَشُّ لِرُوَدِ",46,"د",1,0],["أُقيمُ بِدارِ الحَزمِ ما دامَ حَزمُها","وَأَحرِ إِذا حالَت بِأَن أَتَحَوَّلا",47,"ل",2,0],["أُقِيمُ عَلىالتَقوى وَأَرضى بِفِعِلها","وَكُنتُ مِنَ النارِ المَخُوفَةِ أَوجرا",48,"ر",2,0],["أُقِيمُ عَلى التَقوَى وَأَرضَى بفِعلِهِ","وَكُنتُ مِنَ النارِ المَخُوفَةِ أَوجَرا",49,"ر",2,0],["أقيموا عليه مودَّاتكم","وإلَّا فقد رمتموهُ مُحالا",50,"ل",2,0],["أقيموا صدوركمو للخطوبِ","فما شطَّ طالبُ حقٍّ وغالى",50,"ل",2,0],["أَقَيسَ بنَ عَمرٍو غارَةً بَعدَ غارَةٍ","وَصُبَّةُ خَيلٍ تُحرِبُ المالَ وَالنَعَم",51,"م",1,0],["أُقِيمَ تِمْثَالُهُ وَلَكِنْ","بِهِ لِتِمْثَالِهِ الخُلُودُ",52,"د",1,0],["أَقِيلوا أَخَاكُمْ إِذَا مَا عَثَرْ","فَإِنَّ الْجَمِيلَ جَمِيلُ الأَثَرْ",53,"ر",1,1],["أَقِيمِي أُطِلْ مِنْ نَظْرَتِي مَا اسْتَطَعْتُهَا","إِلَى جَانِبٍ مِنْ وَجْهِكِ المُتَحَوِّلِ",54,"ل",1,1],["أُقِيمَ لِيُجْزَى فِيهِ بِالخَيْرِ عَامِلٌ","نَشِيطٌ كَمَا يَهْوَى النُّبُوغَ قَدِيرُ",55,"ر",1,0],["أقيموا الصِّناعاتِ في أرضِكُمْ","وسَوُّوا الهِضَابَ، وروَّوا الأكَمْ",56,"م",1,0],["أُقيمَ له عرشٌ، وزُلزِلَ عرشُهُ","ولم يمْضِ في الدنيا عليه ربيعُ!",57,"ع",1,0],["أقِيمي، أوْ فَرِيمي، يَا حَياتي","سواءٌ: أَنْ تُقيمي، أو تَرِيمي",58,"م",2,0],["أقيمو عليه مودّاتكم","وإلاّ فقد رمتموه محالا",59,"ل",2,0],["أقيمو صدوركمو للخطوب","فما شطّ طالب حقّ وغالى",59,"ل",2,0],["أُقيمُ عَلى التّشَوّقِ أمْ أسِيرُ،","وَأعدِلُ في الصّبَابَةِ أمْ أجُورُ",60,"ر",1,1],["أقيم ما شئت في عدن وأتركها","وأخلع الجسم أحيانا وأتّزر",61,"ر",1,0],["أُقِيمُ بالْدَّارِ مَا اطْمَأَنَّتْ بِيَ الدْ","دَارُ وَإنْ كُنْتُ نَازِحَاً طَرِبا",62,"ب",2,0],["أقيمُ به سوادَ الليلِ نصاً،","إذا حُبَّ الرُّقادُ عَلَى الهَيُوبِ",63,"ب",1,0],["أَقيمي إِلى أَن تَشتَهي السَير عِندَنا","وَرُوحي لِمَن تَبغي وَخِفي بِلا طَرد",64,"د",1,0],["اقيموا من الارواح صفا مؤيدا","له الجاه عند الله يولي به الوهبا",65,"ب",2,0],["أَقِيموا على قَبري من الصَخرِ دُميةً","بها رَمزُ عَيشي بعدَ مَوتيَ يُعرَضُ",66,"ض",1,1],["أُقيمَ لَهُم بِالقاعِ قاعِ بَلاكِثٍ","إِلى ذَنَبِ الجَزلاءِ يَومٌ عَصَبصَبُ",67,"ب",1,0],["أقِيمًَت ومُلَّت واستُمِيلَ ثِقَافُها","عَلَى وِجهَةِ اليُمنَى وسَاغَت عُنُودُهَا",68,"د",3,0],["أُقيمُ عَلى نَصرِ النَبِيِّ مُحَمَّدٍ","أُقاتِلُ عَنهُ بِالقَنا وَالقَنابِلِ",69,"ل",1,0],["أقيمي في الربوع وجاورينا","فيا نعم المجاور والقرين",70,"ن",1,0],["أَقيمُوا صُدورَ اليَعمُلاتِ ورَفِّعُوا","عَنِ السُبلِ تَنجُوا مِن سَبيلِ المَهالِكِ",71,"ك",1,0],["أَقيما عَلى حَرِّ المُدى أَو تَرَحَّلا","فَلَستُ بِراضٍ مَنزِلَ الهُونِ مَنزِلا",72,"ل",2,1],["أَقيكَ بِنَفسيَ صَرفَ الرَدى","وَحاشاكَ يا أَمَلي أَن تَحينا",73,"ن",2,1],["أقِيس بك الأملاكَ طُرًّا فلا أَرى","سواك زكي الأصل والفرع والنَّسَب",74,"ب",1,0],["أَقيمي إِلَيكِ عَبدَ عَمرٍو وَشايِعي","عَلى كُلِّ ماءٍ وَسطَ ذُبيانَ خَيَّما",75,"م",2,0],["أقيلي عثرةَ الحرِّ النزيهِ","فما ألقاهُ غيري يَتَّقيهِ",76,"ي",2,1],["أُقِيمُ عَلَى الصَّدى ما لَمْ يُهَبْ بِي","إِلى الْوِرْدِ الْكَرِيمِ وَلَمْ يُجاجا",77,"ج",2,0],["أُقيم طَليقاً بِالحِمى وَأَسيرُ","وَقَلبِيَ بِالخَدِّ الأَثيلِ أَسيرُ",78,"ر",1,1],["أقيمَ يمين دارِ الملك منهُ","لِكعبةِ مَجدِها ركنٌ سعيدُ",79,"د",1,0],["أقيمي على الدهر عرش الخلود","وهزّى بصوتك قلب الوجود",80,"د",1,0],["أقيودا والكائنات انطلاق","أم ركودا والعالمون اضطرام",81,"م",1,0],["أُقيمُ لَها وَجهَ الزَمانِ مُصَلِّياً","بِتَوجيدِها في ذاتَها الصَمَدِيَّةِ",82,"ه",1,0],["أُقيمُ بأَعلَى الدَّيرِ فَرْداً مُتَيّماً","أُسائلُ عَمَّنْ حَلّ بالأجْرَعِ الفَرد",83,"د",1,0],["أقيما على باب الإِله وداوما","على قرعه فهو المجيب لداعيه",84,"ي",2,0],["أُقيمُ على الوُدِّ ثَبْتَ الجَنانِ","فلا استَحيلُ ولا أضْطَرِبْ",85,"ب",1,0],["أَقيدوني حآذركم فَقالوا","جِراحة كل عَجماء جَبارُ",86,"ر",1,0],["أقيموا على قبر ثوى فيه بندر","صدور المطايا ما ثوى قبر بندر",87,"ر",1,0],["أُقيلُ ولا أَقُولُ وأَيُّ ذَنْبٍ","لِمَنْ مالَ الزمانُ به فمالا",88,"ل",2,0],["أقيموا عمود الدين للّه تسعدوا","فقد جاءكم عيسى وهذا محمد",89,"د",1,1],["أقيل في كورها كالصقر مرتقياً","به أبيت وجنح الليل ممدود",90,"د",1,0],["أقيلي وغنى غناءَ الربيع","ولو في الخريفِ فينأَى الصقيع",91,"ع",1,0],["أُقيمَ فيها لك رس","مُ الحافظِ المهتَمِّ",92,"م",1,0],["أقيما فلا الأخطارُ تُركَبُ دونهم","لحظٍّ ولا العيسُ المراسيلُ تُرحَلُ",93,"ل",1,0],["أقيم عليها