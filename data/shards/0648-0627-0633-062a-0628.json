 رحاله","https://www.poetsgate.com/ViewPoem.aspx?id=175532",""],[5038,"بوم اللئام","https://www.poetsgate.com/ViewPoem.aspx?id=189927",""],[5055,"حرمة البيت","https://www.poetsgate.com/ViewPoem.aspx?id=101194",""],[585,"حي يا برق زمزماً والمقاما","https://www.poetsgate.com/ViewPoem.aspx?id=161876",""],[5106,"هٰذي الشُّموسُ بَدتْ","https://www.poetsgate.com/ViewPoem.aspx?id=150488",""],[5183,"الزوراء","https://www.poetsgate.com/ViewPoem.aspx?id=186596",""],[5183,"صرخة الفحول","https://www.poetsgate.com/ViewPoem.aspx?id=185636",""],[5190,"العكاز","https://www.poetsgate.com/ViewPoem.aspx?id=153354",""],[5246,"إني لفي أسف مما له انقلبوا","https://www.poetsgate.com/ViewPoem.aspx?id=187030",""],[5277,"جُبٌّ..ولا دلوَ لهُ","https://www.poetsgate.com/ViewPoem.aspx?id=203009",""],[5320,"قلعة الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=40442",""],[5323,"احب حبيبك هوناً !","https://www.poetsgate.com/ViewPoem.aspx?id=207799",""],[5338,"لا تعذل العين أن أرخت عزاليها","https://www.poetsgate.com/ViewPoem.aspx?id=187832",""],[5338,"إن لم تثر في نصر أهلك في اليمن","https://www.poetsgate.com/ViewPoem.aspx?id=187944",""],[5431,"الى قمرٍ أسمر...","https://www.poetsgate.com/ViewPoem.aspx?id=198438",""],[5431,"ليس لي في الأمر يد!!...","https://www.poetsgate.com/ViewPoem.aspx?id=214123",""],[5436,"بغداد/ للشاعر زهير شيخ تراب","https://www.poetsgate.com/ViewPoem.aspx?id=152682",""],[5542,"حوار في ساحة المطاف","https://www.poetsgate.com/ViewPoem.aspx?id=10068",""],[5561,"تركوها","https://www.poetsgate.com/ViewPoem.aspx?id=192910",""],[5561,"آثار الظل","https://www.poetsgate.com/ViewPoem.aspx?id=198219",""],[5582,"لِمَنْ بِسِقْطِ اللِّوَى وَالمُنْحَنَى طَلَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187219",""],[5582,"هَلْ لِلنَّوَى ذلِكَ الظَّبْيُ الأَغَنُّ سَرَى","https://www.poetsgate.com/ViewPoem.aspx?id=63509",""],[5596,"البردة الشعرية","https://www.poetsgate.com/ViewPoem.aspx?id=206751",""],[5616,"نحنُ إِسْلامُنَا عَظِيمٌ عَظِيمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=205223",""],[5656,"قل للإمام الذي ترجى فضائله","https://www.poetsgate.com/ViewPoem.aspx?id=121950",""],[5720,"الْرَوْنَةُ *","https://www.poetsgate.com/ViewPoem.aspx?id=199382",""],[5720,"المُبدِعُونَ*","https://www.poetsgate.com/ViewPoem.aspx?id=199622",""],[5725,"انسام طيبة","https://www.poetsgate.com/ViewPoem.aspx?id=183345",""],[5768,"نَفَحَاتُ عَرَفَاتٍ","https://www.poetsgate.com/ViewPoem.aspx?id=215345",""],[5770,"هذي الملايين حقًا أمة العربِ","https://www.poetsgate.com/ViewPoem.aspx?id=178708",""],[5829,"نكبة 2012","https://www.poetsgate.com/ViewPoem.aspx?id=152668",""],[5829,"شدو المستهام في مدح خير الأنام","https://www.poetsgate.com/ViewPoem.aspx?id=155538",""],[5845,"قلْ للمطيِّ اللواتي طالَ مسراها","https://www.poetsgate.com/ViewPoem.aspx?id=198493",""],[5897,"بشائر على أبواب المدينة","https://www.poetsgate.com/ViewPoem.aspx?id=157555",""],[161,"بيْنَ السَّجؤينِ وخُطَّةِ السَّجَّانِ","https://www.poetsgate.com/ViewPoem.aspx?id=175319",""],[4442,"عاد الوصي إلى علائه","https://www.poetsgate.com/ViewPoem.aspx?id=171021",""],[6089,"هاطلات العين","https://www.poetsgate.com/ViewPoem.aspx?id=213027",""],[6093,"موؤودة","https://www.poetsgate.com/ViewPoem.aspx?id=190794",""],[6102,"قَبِّليني","https://www.poetsgate.com/ViewPoem.aspx?id=184635",""],[6142,"هل أنت معطي العين بعض سناتها","https://www.poetsgate.com/ViewPoem.aspx?id=155761",""],[6147,"سوريا..لاءاتنا الحُمْر","https://www.poetsgate.com/ViewPoem.aspx?id=151697",""],[406,"حوار في ساحة المطاف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=847&r=&rc=38",""],[6328,"آمنة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84422&r=&rc=20",""],[6355,"ليلة الأمس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66688&r=&rc=148",""]],"verses":[["وَاسْتَبْشَرَتْ دَوْلَةُ الإِسْلاَمِ حِينَ رأَتْ","سَيْفَاً مِنَ الْعُرْبِ مَسْلُولاً عَلَى الْعَجَمِ",0,"م",1,0],["واسْتَباحَتْ منْ جِدّتي وفَتائِي","حُرُماً لمْ أخَلْهُ بالمُسْتَباحِ",1,"ح",1,0],["وَاِستَبقِ غَفلَتَها وَنَم عَنها تَنَم","فَالناسُ أَمثالُ الحَوادِثِ قُلَّبُ",2,"ب",1,0],["وَاِستَبِقا العَلياءَ وَاِستَمسِكا","بِعُروَةِ الصَبرِ وَلا تَعجَلا",3,"ل",2,0],["وَاِستَبطَنا الأَشياءَ حَتّى طالَعا","وَجهَ الحَقيقَةِ مِن وَراءِ حِجابِ",4,"ب",1,0],["واستبحتم أموالها وقطعتم","بين أهل الديار كل وشيجه",5,"ج",2,0],["وأستَبِي الكَاعِبَ العَقِيلةَ إذ","أسهُمي الصائِباتُ والصُيُبُ",6,"ب",1,0],["واستبي لكاعب العقيلة اذ","سهمي الصبابات والصّيب",7,"ب",1,0],["وَاِستَبدَلوا بَعدَنا رِجالَ وَغىً","يَوَدُّ أَدنى عُلايَ أَمثَلُها",8,"ل",3,0],["واستباح الأموال يُعمِلُ فِيهِنْ","نَ بلا مدفع ولا تنفيس",9,"س",1,0],["وَاِستَبدَلوا سَيفي الجِرازَ بِأَسيُفٍ","خُشبٍ وَباعوا عَسجَدي بِنُحاسِ",10,"س",1,0],["واستبشر القطر فأهلوه في","أمنٍ مِن العام ومِن جدبه",11,"ب",2,0],["وَاِستَبكِ هَذا الناسَ دَمعاً أَو دَماً","فَاليَومُ يَومُ مَدامِعٍ وَدِماءِ",12,"ا",2,0],["وَاِستَبقِ عِزَهُم بِطَهراءَ الَّتي","كانوا النُجومَ بِها وَكُنتَ سَماءَ",13,"ا",2,0],["وَاِستَبَدَّت بِالأَمرِ مِنهُم فَبا","شا التُركِ في مِصرَ آلَةٌ صَمّاءُ",14,"ا",2,0],["واستبقِ بالكتمان ملكك إنه ال","الملك الذي قد أوتي الأبرارا",15,"ر",2,0],["وَأَستَبطي إِلى بَغدادَ سَيري","وَلَو أَنّي رَحَلتُ عَلى البُراقِ",16,"ق",1,0],["وَاِستَبَدَّت مَرَّةً واحِدَةً","إِنَّما العاجِزُ مَن لا يَستَبِد",17,"د",1,0],["وَاِستَبدَلَت مِن طينَةٍ مَختومَةٍ","تُفّاحَةً في رَأسِ كُلِّ إِناءِ",18,"ا",2,0],["واستبسلوا فتخاضَعَ الشُّمُّ الُّذرَى","وسَطَوْا فذَلَّ الضيغمُ الزَّأآر",19,"ر",1,0],["وَاِستَبعَدَت مِصراً وَما بَعُدَت","أَرضٌ يَحُلُّ بِها أَبو نَصرِ",20,"ر",1,0],["وَاِستَبقِ وِدَّكَ لِلصَديقِ وَلا تَكُن","قَتَباً يَعَضُّ بِغارِبٍ مِلحاحا",21,"ح",2,1],["وَأَستَبدِلُ الأَمرَ القَوِيَّ بِغَيرِهِ","إِذا عَقدُ مَأفونِ الرِجالِ تَحَلَّلا",22,"ل",2,0],["واستبشر الدينُ الحني","فُ بخيرِ من يُحيي الشعائرْ",23,"ر",1,0],["واستبشروا بالنصرِ، إنَّ","النصرَ أقربُ ما يكون",24,"ن",1,0],["واستباح ابنه وأردى أخاه","وتولّى تراث قتلاه غصبا",25,"ب",2,0],["واستُبطِئت عن نَثَا أخباره بُرُدٌ","واستُنهِضَ البرقُ يُستقصي به الخَبَر",26,"ر",1,0],["وَاِستَبشَرَت بِكَ أَبناء الشآم وَقَد","آووا إِلى رُكن عزّ لَيسَ يَنَهدَم",27,"م",1,0],["واستَبدَلَت مِن عِينِهَا أشبَاهَهَا","مِن كُلِّ أُمِّ جِدَايَةٍ وغَزَالِ",28,"ل",1,0],["واستبق نفسكَ من حبِ تزاولهُ","وْأسفْ على عُمرُ ضيعتهُ فيهِ",29,"ي",2,0],["واستبدّت بنزعها من يديها","والليالي إذا عدَت لا تبالي",30,"ل",2,0],["واستبدَّتْ بمن أرادت فداءً","واعتزاما وإن أحبَّت فرَهْنا",31,"ن",2,0],["وَاِستَبقِ مُهجَةَ عَبدٍ رُحتَ مالِكَهُ","فَرُبَّ حَتفٍ جَناهُ كَثرَةُ الجَذَلِ",32,"ل",1,0],["واسَتبشرت أُمم ومدت أَيدنا","لكَ بالدعاءِ إلى الإِلهِ مكرّرا",33,"ر",2,0],["واستبق منهم من بخير من بقى","عمن مضى واشهر حسامك واغمد",34,"د",1,0],["وَاِستَبقِ ماءَ الوَجهِ فيهِ وَكُن بِهِ","حَجِياً وِلا تَقُلِ القُلوبُ تَقَلَّبُ",35,"ب",1,0],["وَاِستَبشَرَت بِالفَوز طائِفة لَها","بِكَ في الأَنام مَسَرَّةٌ وَفخارُ",36,"ر",1,0],["واستبق جسما ذاب فيك صبابة","يكفيك ما يلقى الفؤاد وما لقي",37,"ق",2,0],["وأستبيحُ من اللذات ما رسمت","أهواءُ صبّ غوىّ القلب شيطان",38,"ن",1,0],["واستبقنا معاً لنعلن حرباً","زادها العذبُ أعينٌ وقلوبُ",39,"ب",1,0],["واسْتَبِقْ مُهْجَةَ مُدْنَفٍ","ضَرَّجْتَ مِنْ دَمِه بنَانَكْ",40,"ك",1,0],["واستبهجت أُنْساً ديارك واكتسى","بك حسنَ حالٍ قصرُك المعمور",41,"ر",1,0],["وَاِستَبَقَت مِن غُمودِها دُلُقاً","إِلى الأَعادي الصَوارِمُ الحُذُمُ",42,"م",1,0],["وَاِستَبقِ لِلأَطلالِ بَع","ضَ دَمعِكَ المُستَبِقِ",43,"ق",1,0],["واستبيحي كُنْهَ روحي","إنْ أنا أغفلتُ حدّي",44,"د",2,0],["واستبق مني باللقاء","بوافياً ليست بواقي",45,"ق",2,0],["واستبق مني حساماً صفوى ونقه","يزهو وفي صفحتيه كامن العطب",46,"ب",1,0],["واستبق مني في الزمان بقية","وهنت كلوم المصب في لمياء",47,"ا",2,0],["واِستَبشر العرش وَالكرسي وامتلأت","حجب الجلالة نورا حين واناها",48,"ا",3,0],["وَاسْتَبْقِ لِلأطْلالِ فَضْلَةَ أَدْمُعٍ","أَفْنَيْتَهُنَّ قَطِيعَةً وَتَفَرُّقا",49,"ق",2,0],["واستبن هل له بما ثم علم","من شجون ومن تبلبل بال",50,"ل",1,0],["وَاِستبن منه فيأةً بعد جفوٍ","إِذ تبدّى بهيأة الخجلانِ",51,"ن",1,0],["وَاِستَبشرت نَفسي بِطلعتها ولم","تَزل الوَرى بطلوعِها تستبشرُ",52,"ر",1,0],["وأَسْتبيحُ حِمَاهَا غَيْرَ مُقْتَرِفٍ","ذَنْباً مِن اللَّهِ في وِرْدٍ ولا صَدَرِ",53,"ر",1,0],["وَاِستُبينَ 