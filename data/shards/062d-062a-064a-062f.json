abi.ae/diwan/poem/102985","البسيط"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40119","البسيط"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44695","الكامل"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111066","الكامل"],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143845","الكامل"],[4110,"","https://poetry.dctabudhabi.ae/diwan/poem/101162","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97092","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97090","المجتث"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90953","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94788","البسيط"],[4387,"","https://poetry.dctabudhabi.ae/diwan/poem/124044","الكامل"],[4488,"","https://poetry.dctabudhabi.ae/diwan/poem/131004","الرجز"],[4656,"","https://poetry.dctabudhabi.ae/diwan/poem/98048","الكامل"],[4767,"نار الأسَى","https://www.poetsgate.com/ViewPoem.aspx?id=187546",""],[4578,"أآهدي إليَّ تفضلاً تمثالهُ","https://www.poetsgate.com/ViewPoem.aspx?id=49508",""],[4852,"الطور والتشرين","https://www.poetsgate.com/ViewPoem.aspx?id=214364",""],[5136,"القلب يخشع والأماني تدمع","https://www.poetsgate.com/ViewPoem.aspx?id=121614",""],[5183,"الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=186473",""],[5191,"أقولُ: ألقاكَ","https://www.poetsgate.com/ViewPoem.aspx?id=211977",""],[5431,"مشاعر معلبة!","https://www.poetsgate.com/ViewPoem.aspx?id=207402",""],[567,"ألوى علي فضمني وضممته","https://www.poetsgate.com/ViewPoem.aspx?id=201616",""],[5530,"ترتيلةٌ على حدّ المُحال","https://www.poetsgate.com/ViewPoem.aspx?id=197855",""],[5561,"هو خيرةٌ من خيرةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193807",""],[5582,"أَفْراحُ أَهْلِ الهَوَى فِي الهَجْرِ أَحْزانُ","https://www.poetsgate.com/ViewPoem.aspx?id=187308",""],[5841,"أخلصت للقاف إلين القاف أخلص لي","https://www.poetsgate.com/ViewPoem.aspx?id=37006",""],[5873,"الجمال الأخاذ","https://www.poetsgate.com/ViewPoem.aspx?id=215304",""],[5980,"قانون عدلك لم يبرح يذكرنا","https://www.poetsgate.com/ViewPoem.aspx?id=146261",""],[6068,"وتأهَّل الأفناكْ -07-","https://www.poetsgate.com/ViewPoem.aspx?id=175928",""],[6068,"دَخَلَتْ وَفَى جِلبَابُها -04-","https://www.poetsgate.com/ViewPoem.aspx?id=175937",""],[6102,"شاخ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=184417",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577049",""],[6242,"مَنْ ضيّعَك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87556&r=&rc=3",""],[2220,"قلبي بذكركَ مسرورٌ ومحزونُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11796&r=&rc=666",""]],"verses":[["حَتّى دَنا السَربُ ما أَحيَيتِ مِن كَمَدٍ","قَتلى هَواكِ وَلا فادَيتِ أَسراكِ",0,"ك",1,0],["حَتَّى دَعَاكَ الْمُسْتَعِينُ وَإِنَّه","لآبَرُّ بِالْمُلْكِ الْمُضَاعِ وَأَكْفَلُ",1,"ل",1,0],["حتى دعاهُ اللهُ بينَ بُيوتِهِمْ","فأجابَ مُمْتَثِلاً لأمْرِ الباري",2,"ر",2,0],["حتى دنَوت إليها وهي ماشية","وادمعي أوسعت في الخد مجراها",3,"ا",3,0],["حتى دنت نحو المغيب وجها","كالورس حال به الضياء حيولا",4,"ل",2,0],["حتى دعاهُ حكمُ سيدهِ","وهوَى اللقاءَ فزارَ عن غبّ",5,"ب",1,0],["حَتّى دَوى صَوتُ الرَئيسِ بِنا","فَهَرَعت وَالرُهبانُ في إِثري",6,"ر",2,0],["حَتّى دَنَت مِن ثَغرِ شِمولبو الَّذي","جَمَعَ الأُلى يَعرِفوا ما صارا",7,"ر",2,0],["حتَّى دهتْه اللَّيالي","وجرَّعتْهُ مَنُونَهْ",8,"ه",1,0],["حتَّى دَهِشْتُ وما أُفِدْتُ","بدهشتي رأياً مُصيبْ",9,"ب",1,0],["حَتّى دَخَلنا جَنَّةً","لَو أَنَّ ساكِنَها مُخَلَّد",10,"د",1,0],["حَتّى دَخَلتُ عَلى الفَتاةِ وَإِنَّها","لَتَحُظُّ نَوماً مِثلَ نَومِ المُبهَجِ",11,"ج",1,0],["حتّى دعاهُ اللّهُ يرحَمُ نفسَه","فأجاب يلتمسُ القرارَ ويطلب",12,"ب",1,0],["حتى دَنا منه النبيُّ وَمَنْ دَنا","منه نأَى عَنْ قَلْبِهِ التَّبْريحُ",13,"ح",1,0],["حتى دُفعتُ إلى المعزّ خليفةً","فعلمتُ أنّ المَطلَبَ الخُلفاء",14,"ا",2,0],["حَتّى دَفَعنا إِلَيهِ مَملَكَةً","يَنحَسِرُ الطَرفُ عَن مَواكِبِها",15,"ب",3,0],["حَتّى دَنَت وَالمُحسِنُ المَأجورُ","لَمّا اِلتَقينا وَمَعي المَأثورُ",16,"ر",1,0],["حَتَّى دُفِعْتُ لِمَسْتُورِي عَلَى عَجَلٍ","في جَوْزِهِ ونَصِيلِ الرَّأْسِ تَقْدِيمُ",17,"م",1,0],["حَتى دَعَانِي وكَرْبُ المَوْتِ عَامِرَةٌ","واصْطَادَ رِئْمَانَ وُدِّي بَعْدَ إِنْفَارِ",18,"ر",1,0],["حتى دنت من ثغر شمولبو الذي","جمع الألى لم يعرفوا ما صارا",19,"ر",2,0],["حتى دُفعْتُ إلى المعزّ خليفة ً","فعملتُ أنّ المطلَب الخُلفاء",20,"ا",2,0],["حَتَّى دَخَلْتُ عَلَى الفَتَاة ِ وَإنَّها","لَتَغُطُّ نَوْماً مِثْلَ نَوْمِ المُبْهِجِ",21,"ج",1,0],["حتى دنت نحو المغيب ووجهها","كالورس حال به الضياء حيولا",22,"ل",2,0],["حتى دنوتَ إِلى المصلى ذاكراً","لله مبتهلاً عقيبَ صيامَ",23,"م",1,0],["حَتّى دُموعُ البائِسينَ شَهِيَّةٌ","في قَلبِهِ إِن كانَ فيها مَغنَمُ",24,"م",1,0],["حتّى دَعا فحضَر","وسَرَّهُ عند النَظر",25,"ر",1,0],["حَتىّ دَعاكَ اللَهُ فيها راضياً","لِتَنالَ منه مثوبةً تَرضاها",26,"ا",3,0],["حَتّىدَنَوتُ وَصارَ الوَصلِ يَجمَعُنا","وَالسِرُّ مِنكَ وَمِنكَ غَيرَ مُستَمِرِّ",27,"ر",1,0],["حتى دهانا زمان العار","بخلف سوء من الأغمار",28,"ر",1,0],["حتى دفعتُ وحيدَ قلبي دونكم","يفدي الذي قد ضل عنه بجهلهِ",29,"ه",1,0],["حتَّى دَعَاني السّعدُ لا تَخْضَعُ ولذْ","بِحِمَى الصِّفيّ ونادِ زَيَن النّادي",30,"د",2,0],["حتى دخَلْنا بيتَها","فحَصلْتُ في البَيتِ الحَرامِ",31,"م",1,0],["حتى دنت منه تزهو","على غزال وبدر",32,"ر",1,0],["حتى دُهِينا ذاهلينَ بخطبنا","في كل ما صُنَّاه من أحلام",33,"م",1,0],["حتَّى دهَانىَ ما دهَانىَ فيهمُ","وأسَاء دَهري بعدَ حُسن تَصرُّفِ",34,"ف",1,0],["حتى دَهانا ما دَهى المَغمورَ مِن","سَيلٍ له بِمَصائِبٍ تَفجيرُ",35,"ر",1,0],["حتى دُعُوا وأتاهم المفتاح","هو إن نأى أو زاد في تقريبهم",36,"م",1,0],["حتى دنا من وهج القساطل","من ذات زفّ ساقط الخمايل",37,"ل",1,0],["حتّى دنا مِنْ ربِّهِ جلَّ اسْمُه","فأجلَّهُ وقَضَى له الأوْطَارَا",38,"ر",2,0],["حتَّى دُهيتُ بِحُمْرَةٍ في سُمْرَةٍ","كالخَمرةِ الصَّهْباءِ في تَلْوينِ",39,"ن",1,0],["حتى دهانيَ كيد الخصم يسلبني","أمني ويغتالني ظلماً وعدوانا",40,"ن",2,0],["حَتّى دَهاهُ كُل كَلبٍ قَربا","وَقَطَعوه قطعاً وَإِربا",41,"ب",2,0],["حتى دخلنا روضة الحسن التى","فاح شذاها عبقا كالعطر",42,"ر",1,0],["حتى دهاني وعين الشمس فاترة","وقد جذبت بذيل الليل ما انجذبا",43,"ب",2,0],["حَتّى دَخَلتُ البَيتَ فَاِستَذرَفَت","مِن شَفَقٍ عَيناكَ لي تَسجمُ",44,"م",1,0],["حتّى دَعاكَ الناسُ عدلاً مُقسطاً","وَدَعاكَ بيت المال فضّاً جابرا",45,"ر",2,0],["حتى دنى مني ولم","اشعر به حين ورد",46,"د",1,0],["حتى دعا داعي العلى","لنعيم فردوسٍ وريف",47,"ف",1,0],["حَتَّى دَنا فَتَدَلى رِفعة وَعَلا","كَقاب قَوسَينِ يَدنو وَهو مَكفولُ",48,"ل",1,0],["حتى دنى الرحمن من حيث دنى","فوضع التاج عليه واجتبى",49,"ا",1,0],["حتَّى دعاه إليه أن","يغدو فلبَّى بالرَّواح",50,"ح",1,0],["حتىدنا استشهاده بمرشة","خرقت عليه الدرع من يد باغي",51,"غ",2,0],["حتى دعوك الناس يا ناعسا","لما رأوا لي فيك طرفا سهود",52,"د",1,0],["حتى دهتنا ويحها بغتةً","بنكبةٍ في آل بحر العلوم",53,"م",1,0],["حتى دهاه الموت مغتالاً ولم","يصرعه إلا في مجال جلاد",54,"د",1,0],["حتى دنَتْ منهُ ترومُ إيابَها","وقفَتْ تُسائلهُ فردَّ جوابَها",55,"ا",1,0],["حتى دعتْ من الأشواق داعيةٌ","همت لها نحو قلبي سحبة الجون",56,"ن",1,0],["حتى دبيت ولي عزم يساعدني","مع كل طفل حبي في حارتي ودبا",57,"ب",2,0],["حتى دنا القدر المتاح وحان ما","خط القضاء لقائم أو قاعد",58,"د",1,0],["حتى دعوا لحضيرة القدس التي","فيها يرون العين رأي يقين",59,"ن",1,0],["حتى دعاك الله للخلد الذي","اصبحت فيه اليوم خير مقرب",60,"ب",1,0],["حتى دعا احمد والطهر حيدرةٌ","أقبل حسين إلينا جاءك الأجل",61,"ل",1,0],["حَتّى دَنا قاب قَوسين الوصال فَفي","دنوه أَنبياء اللَه قَد حاروا",62,"ر",3,0],["حتى دنا فقال ألمسنيه","لصاحبٍ قد كانَ يَصطَفيه",63,"ه",1,0],["حتى دمي يُخلَطُ في دمائكُم","وأبتلي في الدهرِ بابتلائكُم",64,"م",1,0],["حتى دهاني منك صدر رامح","ذرب سناناه وطرف قاتل",65,"ل",1,0],["حتى دعاها إلى المولى المهيمن ما","يدعو الملوك ويدعو الأعصم الصدقا",66,"ق",2,0],["حتى دعاك إلى مقام لقائه","فحباك بالأعزاز والأعظام",67,"م",1,0],["حَتّى دُفِعنا إِلى ذي مَيعَةٍ تَئِقٍ","كَالذِنبِ فارَقَهُ السُلطانُ وَالروحُ",68,"ح",1,0],["حتى دنا المحتوم منه اغتاله","والنعش حمالون اضحت تحمل",69,"ل",1,0],["حتى دعاه مالك الملك إلى","لقائه فهان فيه الصعب",70,"ب",1,0],["حتى دعا النفس الزكية ربها","فهوت كما قد طال فيه قيامها",71,"م",3,0],["حتى درى الجلاس أني شاعرٌ","وأخو القوافي مستهام وامقق",72,"ق",1,0],["حتى «ديوجين»؟ قل لي","يا شيخ ماذا صنعتا",73,"ت",2,0],["حتى دهاهم حادث الأيام","وكل عيش فإلى انصرام",74,"م",1,0],["حتى دهاه حادث كبير","فاغتاله بغاء الصغير",74,"ر",1,0],["حتى دهاه ما دهى البريه","فسلبته ملكه المنيه",74,"ه",1,0],["حتى دعاه إلى الكرامة واللقا","من ربه الرحمن خير منادي",75,"د",2,0],["حَتّى دَعتكَ إِلَيهِ يَوماً حاجَةٌ","أَلفَيتُهُ فيها مُريباً خائِما",76,"م",2,0],["حتى دَنَوتُ لثَغْرِه","فرَشفْتُه والرَّشْفُ أنْقَعْ",77,"ع",1,0],["حتى دعاه فحضر","وسره عند النظر",78,"ر",1,0],["حتى دنا فتدلى من حظيرته","وقد علاه من الأنوار إكليل",79,"ل",1,0],["حتى دعتك من الأقدار داعية","إلى جوار عزيز الملك مقتدر",80,"ر",1,0],["حَتّى دَلِفْتَ لَها بِالعَزْمِ يَشحَذُهُ","رأيٌ ببيت فُوَيْقَ النّجم مسراهُ",81,"ا",2,0],["حَتّى دَخَلَتُ لَرَوضةٍ","سَرَّت عُيون الناظِرينْ",82,"ن",1,0],["حتى دخلت بطلعة","البدر المضيه",83,"ي",2,0],["حتى دعوت إلى العدى","من لا يلام إذا تعدّى",84,"د",2,0],["حتى دهى بمجلجل لو أنه","بأطام رضوى خر منه اطام",85,"م",1,0],["حتى دعاهم ربهم لجواره","فرضوا بما رضي الإله وسلموا",86,"م",3,0],["حتى دعاه منادي","إلهه للتلاقي",87,"ق",2,0],["حتى دعاه للشهادة ربه","وحباه بالحسنى مع الأبرار",88,"ر",1,0],["حتى دهاني بأمرٍ لستُ أذكرهُ","إلّا وتهطل من عينيَّ أمطارُ",89,"ر",1,0],["حتى دعاني مشمعل ناصحٌ","من نور جنب الشيخ ليس بمؤتل",90,"ل",1,0],["حتى دنا منها وقد قضى العجب","مما رأى فسرّبت عنه الكرب",91,"ب",1,0],["حتّى دَفعنَ إِلى فتى جشّمنه","ردّ الكرى وَتعسّف الأهوالِ",92,"ل",1,0],["حتى دجا الصبحُ الجميلُ بُعيدَ ما","وشَّاه مِمَّا يرسلُ الإشراق",93,"ق",1,0],["حتى دنا بينٌ فمدَّ يمينه","ما بينا قطع الإله شمالهُ",94,"ل",2,0],["حتى دَوَى قرعُ الطبولِ .. لمن نوَى","ولمن نَوَى .. سِرُّ القضاءِ .. يكونُ",95,"ن",1,0],["حتى دهتني أزمة كادت لها","جزعاً تطير النفس لولا الأضلع",96,"ع",1,0],["حتى درستُ متونَها ودخلتُ في","أعماقِها فإذا الحياةُ شَرابُ",97,"ب",1,0],["حتّى دنا، وحياءُ الظّبيِ يُرجِعُهُ","كأحْمَقينِ؛ تلاقى الحُمْقُ... وافتَرَقا",98,"ق",2,0],["حتى دموعك لم تعد لتبلني!","صدق الكتاب بشاعر ماأكذبه",99,"ه",1,0],["حتى دخلت الدار ساعة غفلة","وعرفت ربع الدار بعد توهم",100,"م",1,0],["حتّى دنت من فرطِ ما أودى بهِ","شوقُ الغليلِ .. دنت بهاءً مُترعا",101,"ع",2,0],["حتى دعوتُ على السلامةِ يقظتي","وأفقتُ من حلُمِ المحبّةِ شاكيا",102,"ي",2,0],["حَتَّى دَهَمْتَهُمُ شَعْواءَ يَحْجُبُها","عَنْ شَمْسِها قُضُبٌ لِلسُّمْرِ مُرَّانُ",103,"ن",1,0],["حتى دموع الحسافه وقهري وذلّي","تشقي فؤادي عتاب وبالشقى تشلّه",104,"ل",2,0],["حتّى دهاني الهجر منك بغدرةٍ","من بعدمااستحوذتني استحواذا",105,"ذ",2,0],["حتى دعانا إلى إهدائه نضراً","مركشاً بنضار قصد تذكار",106,"ر",1,0],["حتى دخلتُ وجدتها","في ناظري تستاكْ",107,"ك",1,0],["حتّى دَنَوْتُ بِقرْبِها","خَجِلَتْ بِخَدٍّ مُشْرِقِ",108,"ق",1,0],["حَتَّى دَمِي , حَتَّى شَرَايِينِي - الَّتي","نَزَفَتْ بِقَطْعِكَ - تَشْتَهِي أَنْ تَقْطَعَكْ !",109,"ك",1,0],["حَتّى دَعيت الكُل مِنا جَلايب","لَجايا بديران التراك حذار",110,"ر",1,0],["حتى دفاترُ شوقنا محمومة","أجهضتها يا غائبي ما أوجعَكْ",111,"ك",1,0],["حتى دعته من الأشواق داعية ٌ","همتْ لها نحوَ قلبي سحبهُ الجونُ",112,"ن",1,0]]}