{"poems":[[53,"يا ظبية البان ترعى في خمائله","https://www.aldiwan.net/poem29919.html","البسيط"],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[77,"يا حسنها من أربع وديار","https://www.aldiwan.net/poem36462.html","الكامل"],[88,"لقيتها ليتني ما كنت القاها","https://www.aldiwan.net/poem44448.html","البسيط"],[88,"نزلت تجر إلى الغروب ذيولا","https://www.aldiwan.net/poem44454.html","الكامل"],[72,"دمعي عليك مجانس قلبي","https://www.aldiwan.net/poem18235.html","أحذ الكامل"],[91,"أبصرتها في الخمس والعشر","https://www.aldiwan.net/poem8851.html","عموديه"],[91,"دبت وقد أرخى الظلام ستارا","https://www.aldiwan.net/poem8861.html","عموديه"],[92,"يا لاابتسامة قلب","https://www.aldiwan.net/poem38892.html","مجزوء الكامل"],[92,"مهما تأملت الحياة","https://www.aldiwan.net/poem38971.html","مجزوء الكامل"],[43,"وزيارة عن غير موعد","https://www.aldiwan.net/poem9545.html","مجزوء الكامل"],[31,"نعق الغراب ببين ذات الدملج","https://www.aldiwan.net/poem42592.html","الكامل"],[105,"هو مرتمى الأبطال مالك دونه","https://www.aldiwan.net/poem44209.html","الكامل"],[67,"أمدائح لي فيك أم تسبيح","https://www.aldiwan.net/poem18045.html","الكامل"],[75,"الحب حيث المعشر الأعداء","https://www.aldiwan.net/poem69109.html","الكامل"],[48,"لست بدار عفت وغيرها","https://www.aldiwan.net/poem62428.html","البسيط"],[50,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[91,"معركة شمولبو","https://www.poetsgate.com/ViewPoem.aspx?id=53085",""],[75,"الحِبّ حيثُ المعشرُ الأعداءُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10780&r=&rc=0",""],[31,"نَعَقَ الغُرَابُ بِبَيْنِ ذاتِ الدُّمْلُجِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18811&r=&rc=74",""],[88,"نزلت تجر إلى الغروب ذيولا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19531&r=&rc=34",""],[160,"لو يستطيع تخطي الأيام","https://www.aldiwan.net/poem58849.html","الطويل"],[223,"حرم الجمال على سريرك يحلم","https://www.aldiwan.net/poem39695.html","الكامل"],[297,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[297,"تفديك لو قبل المنون فداها","https://www.aldiwan.net/poem33083.html","الكامل"],[304,"يا زائري حين لا واش من البشر","https://www.aldiwan.net/poem16751.html","البسيط"],[304,"حييت يا مربع الأحباب","https://www.aldiwan.net/poem16795.html","المديد"],[377,"أحببتكم يا مؤمنين محبة","https://www.aldiwan.net/poem59271.html","الكامل"],[402,"كم ذا يذوب أسى وكم يتجلد","https://www.aldiwan.net/poem46938.html","الكامل"],[405,"وغزالة غازلتها","https://www.aldiwan.net/poem49474.html","مجزوء الكامل"],[443,"وذات حسن وقدر","https://www.aldiwan.net/poem56001.html","عموديه"],[453,"الأربعون صدى فؤادي الدامي","https://www.aldiwan.net/poem61769.html","الكامل"],[538,"فقد الأحبة موقف كالموقف","https://www.aldiwan.net/poem47555.html","عموديه"],[538,"حذرته لو ينفع التحذير","https://www.aldiwan.net/poem48135.html","عموديه"],[558,"أحزاننا بلقائكم أفراح","https://www.aldiwan.net/poem34674.html","الكامل"]],"verses":[["حَتّى دَنا السَربُ ما أَحيَيتِ مِن كَمَدٍ","قَتلى هَواكِ وَلا فادَيتِ أَسراكِ",0,"ك",1,0],["حَتَّى دَعَاكَ الْمُسْتَعِينُ وَإِنَّه","لآبَرُّ بِالْمُلْكِ الْمُضَاعِ وَأَكْفَلُ",1,"ل",1,0],["حتى دعاهُ اللهُ بينَ بُيوتِهِمْ","فأجابَ مُمْتَثِلاً لأمْرِ الباري",2,"ر",2,0],["حتى دنَوت إليها وهي ماشية","وادمعي أوسعت في الخد مجراها",3,"ا",3,0],["حتى دنت نحو المغيب وجها","كالورس حال به الضياء حيولا",4,"ل",2,0],["حتى دعاهُ حكمُ سيدهِ","وهوَى اللقاءَ فزارَ عن غبّ",5,"ب",1,0],["حَتّى دَوى صَوتُ الرَئيسِ بِنا","فَهَرَعت وَالرُهبانُ في إِثري",6,"ي",1,0],["حَتّى دَنَت مِن ثَغرِ شِمولبو الَّذي","جَمَعَ الأُلى يَعرِفوا ما صارا",7,"ر",2,0],["حتَّى دهتْه اللَّيالي","وجرَّعتْهُ مَنُونَهْ",8,"ه",1,0],["حتَّى دَهِشْتُ وما أُفِدْتُ","بدهشتي رأياً مُصيبْ",9,"ب",1,0],["حَتّى دَخَلنا جَنَّةً","لَو أَنَّ ساكِنَها مُخَلَّد",10,"د",1,0],["حَتّى دَخَلتُ عَلى الفَتاةِ وَإِنَّها","لَتَحُظُّ نَوماً مِثلَ نَومِ المُبهَجِ",11,"ج",1,0],["حتّى دعاهُ اللّهُ يرحَمُ نفسَه","فأجاب يلتمسُ القرارَ ويطلب",12,"ب",1,0],["حتى دَنا منه النبيُّ وَمَنْ دَنا","منه نأَى عَنْ قَلْبِهِ التَّبْريحُ",13,"ح",1,0],["حتى دُفعتُ إلى المعزّ خليفةً","فعلمتُ أنّ المَطلَبَ الخُلفاء",14,"ا",2,0],["حَتّى دَفَعنا إِلَيهِ مَملَكَةً","يَنحَسِرُ الطَرفُ عَن مَواكِبِها",15,"ب",3,0],["حَتّى دَنَت وَالمُحسِنُ المَأجورُ","لَمّا اِلتَقينا وَمَعي المَأثورُ",16,"ر",1,0],["حتى دنت من ثغر شمولبو الذي","جمع الألى لم يعرفوا ما صارا",17,"ر",2,0],["حتى دُفعْتُ إلى المعزّ خليفة ً","فعملتُ أنّ المطلَب الخُلفاء",18,"ا",2,0],["حَتَّى دَخَلْتُ عَلَى الفَتَاة ِ وَإنَّها","لَتَغُطُّ نَوْماً مِثْلَ نَوْمِ المُبْهِجِ",19,"ج",1,0],["حتى دنت نحو المغيب ووجهها","كالورس حال به الضياء حيولا",20,"ل",2,0],["حتى دنوتَ إِلى المصلى ذاكراً","لله مبتهلاً عقيبَ صيامَ",21,"م",1,0],["حَتّى دُموعُ البائِسينَ شَهِيَّةٌ","في قَلبِهِ إِن كانَ فيها مَغنَمُ",22,"م",1,0],["حتّى دَعا فحضَر","وسَرَّهُ عند النَظر",23,"ر",1,0],["حَتىّ دَعاكَ اللَهُ فيها راضياً","لِتَنالَ منه مثوبةً تَرضاها",24,"ا",3,0],["حَتّىدَنَوتُ وَصارَ الوَصلِ يَجمَعُنا","وَالسِرُّ مِنكَ وَمِنكَ غَيرَ مُستَمِرِّ",25,"ر",1,0],["حتى دهانا زمان العار","بخلف سوء من الأغمار",26,"ر",1,0],["حتى دفعتُ وحيدَ قلبي دونكم","يفدي الذي قد ضل عنه بجهلهِ",27,"ه",1,0],["حتَّى دَعَاني السّعدُ لا تَخْضَعُ ولذْ","بِحِمَى الصِّفيّ ونادِ زَيَن النّادي",28,"ي",1,0],["حتى دخَلْنا بيتَها","فحَصلْتُ في البَيتِ الحَرامِ",29,"م",1,0],["حتى دنت منه تزهو","على غزال وبدر",30,"ر",1,0],["حتى دُهِينا ذاهلينَ بخطبنا","في كل ما صُنَّاه من أحلام",31,"م",1,0],["حتَّى دهَانىَ ما دهَانىَ فيهمُ","وأسَاء دَهري بعدَ حُسن تَصرُّفِ",32,"ف",1,0],["حتى دَهانا ما دَهى المَغمورَ مِن","سَيلٍ له بِمَصائِبٍ تَفجيرُ",33,"ر",1,0],["حتى دُعُوا وأتاهم المفتاح","هو إن نأى أو زاد في تقريبهم",34,"م",1,0]]}