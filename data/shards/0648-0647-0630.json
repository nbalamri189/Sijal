ttps://poetry.dctabudhabi.ae/diwan/poem/43755","الوافر"],[77,"نديمي عللني بمشمولة واسق","https://www.poetsgate.com/ViewPoem.aspx?id=34194",""],[100,"مدينة الغد","https://www.poetsgate.com/ViewPoem.aspx?id=24212",""],[93,"هَذِي رُؤُوسُ الْقِمَمِ الشِّمَّاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=31925",""],[90,"غازي...","https://www.poetsgate.com/ViewPoem.aspx?id=179077",""],[90,"المآسي في حياة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=179158",""],[90,"إليها !","https://www.poetsgate.com/ViewPoem.aspx?id=179205",""],[90,"الزهَاوي","https://www.poetsgate.com/ViewPoem.aspx?id=179155",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"المحرقة","https://www.poetsgate.com/ViewPoem.aspx?id=179110",""],[80,"خلتْ منك أيّام الشبيبة فاعمرها","https://www.poetsgate.com/ViewPoem.aspx?id=3287",""],[97,"في الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=12763",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[101,"تَبَلّجَ بالْبُشْرَى وَلاحَتْ مَوَاكِبُهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62442&r=&rc=34",""],[88,"لعمرك ان قصر البحر قصر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19540&r=&rc=43",""]],"verses":[["وَهَذا الدَهرُ تَحدوني يَداهُ","حِداءَ الطِلحِ بِالإِبِلِ الرَذايا",0,"ا",3,0],["وَهَذا الدَهرُ يَثنينِ","يَ بِاللَيانِ عَن دَيني",1,"ن",2,0],["وَهَذا وَما اِبيَضَّ السَوادُ فَكيفَ بي","إِذا الشَيبُ أَمسى لَيلَةً مِن عَمائِمي",2,"م",2,0],["وَهَذا يَزيدُ بنُ المُهَلَّبِ نافَرَت","بِهِ الذُلَّ أَعراقُ الجُدودِ الأَكارِمِ",2,"م",1,0],["وَهَذا مَقالي فيكَ غَيثٌ وَرُبَّما","رَمَيتُ العِدى مِن وَقعِهِ بِالصَواعِقِ",3,"ق",1,0],["وَهَذا أَبي الأَدنى الَّذي تَعرِفونَهُ","مُقَدَّمُ مَجدٍ أَوَّلٌ وَمُخَلَّفُ",4,"ف",1,0],["وَهَذا الدَهرُ خَفَّضَ مِن عُرامي","وَرَنَّقَ مِن غَبوقي وَاِصطِباحي",5,"ح",2,0],["وَهَذا الرَبيعُ الطَلقُ رَقَّت فُروعُهُ","نَتيجَةَ ذاكَ العارِضِ المُتَصَبِّبِ",6,"ب",1,0],["وَهَذا مَصِيفٌ بِالحِمى لا تَمَلُّهُ","وَفيهِ لِمَن يَهوى البَداوَةَ مَربَعُ",7,"ع",1,0],["وَهَذا الَّذي أَدرَكتُهُ اليومَ لَم يَكُن","ليَبلُغَ ما أَحظى بإِدراكِهِ مَدى",8,"د",2,0],["وهذهِ قَصيدَةٌ شَبيهةٌ","بالماءِ تُسْقاهُ على بَرْحِ الصّدى",9,"ا",1,0],["وهذهِ مِدَحٌ دَرَّتْ بِها مِنَحٌ","بيضٌ أضاءَتْ بهِنَّ الأزْمُنُ السّودُ",10,"د",1,0],["وهذا الذي فيه وَلغتُ أخلْتُني","سأشهده مني إلى القعر أولغا؟",11,"غ",2,0],["وهذا الفُتاتُ المنطوي شمَّهُ الندى","يُقاوي تلاشيه، ويقوى ليبزُغا",11,"غ",2,0],["وهذا لعَمْري مَذْهَبٌ لمْ يُقَلْ بهِ","ولكنّ مَنْ لمْ يرْوِ ليْسَ كمَنْ رَوى",12,"و",2,0],["وهَذا زمانُ الزّهْرِ حيّاكَ باسِماً","تَلوحُ سِماتُ البِشْرِ في وجْهِهِ الطّلْقِ",13,"ق",1,0],["وهَذا ابْنُ نصْرٍ قد أتى وجَناحُهُ","مَهيضٌ ومنْ عُلْياكَ يُلْتَمَسُ الجَبْرُ",14,"ر",1,0],["وَهَذِهِ جُندٌ أَطاعوا هَوى","أَربابِهِم أَم نَعَمٌ تُنحَرُ",15,"ر",1,0],["وَهَذا يَلوذُ بِقَصرِ الأَميرِ","وَيَدعو إِلى ظِلِّهِ الأَرحَبِ",16,"ب",1,0],["وَهَذا يَلوذُ بِقَصرِ السَفيرِ","وَيُطنِبُ في وِردِهِ الأَعذَبِ",16,"ب",1,0],["وَهَذا يَصيحُ مَعَ الصائِحينَ","عَلى غَيرِ قَصدٍ وَلا مَأرَبِ",16,"ب",1,0],["وَهَذا السُرى نَحوَ الحِمى يَستَفِزُّنا","فَهَيّا وَإِن كُنّا عَلى مَركَبٍ وَعرِ",17,"ر",1,0],["وهذه خُطّةٌ للهِ واضِعُها","رَدَّتْ حُقوقاً فأغنَت مُستَميحيها",18,"ي",3,0],["وَهَذا الصَولَجانُ فَكُن حَريصاً","عَلى مُلكِ القَريضِ وَكُن أَمينا",19,"ن",2,0],["وَهَذي بَناتُ النيلِ يَعمَلنَ لِلنُهى","وَيَغرِسنَ غَرساً دانِيَ الثَمَراتِ",20,"ت",1,0],["وَهَذِهِ الدارُ لا تُبقي عَلى أَحَدٍ","وَلا يَدُومُ عَلى حالٍ لَها شانُ",21,"ن",1,0],["وَهَذِي النجُومُ أَلَيْسَتْ كَدرٍّ","طَوَافٍ عَلَى أَبْحُرٍ زَاخِرَهْ",22,"ر",2,0],["وَهَذَا مِنْهُمَا نُعْمَى مُجَدَّدَةٌ","قُلُوبُنَا نَتَلَقَّاهَا بِشُكْرَانِ",23,"ن",1,0],["وَهَذِي حِكْمَةٌ جُلِيَتْ بِأَزْهَى","مَجَالِيَهَا وَقَدْ سِيمَ الحَكِيمُ",24,"م",1,0],["وَهَذَا الحَشْدُ حَوْلَكَ مِنْ سُرَاةٍ","كَغَالِي الدُّرِّ فِي العِقْدِ النَّظِيمِ",25,"م",1,0],["وَهَذَا فُؤَادِي عَلَى جَفْنِهَا","غَرِيمٌ تَعَلَّقَ بِالغَارِمِ",26,"م",1,0],["وَهَذَا الْعَهْدُ مَيْدَانُ التَّبَارِي","بِلا حَدٍ إِلَى كَسْبِ الْحُطَامِ",27,"م",1,0],["وهذا إلى هذي وذاك لغيرها","من الصحف يدعو آتياً بالشواهد",28,"د",1,0],["وهذه الطير حيث تُبصرها","محمد والصحابة النُجُب",29,"ب",1,0],["وهذا مديح صيغ من أطيب الثنا","وذاك هجاء صيغ من منطق هجر",30,"ر",1,0],["وهذا أنت للمصرين تاجٌ","فريدُ في فريدٍ من نظام",31,"م",1,0],["وهَذَى العاذلُونَ من جهة الرِّب","حِ فخلَّيتهم وطولَ الهُذاءِ",32,"ا",2,0],["وهذي أمورٌ وُفِّقتْ لابن صاعد","أماراتُ جَدٍّ صاعدٍ وبقاءِ",33,"ا",2,0],["وهذا شتاء قد أَظلَّ رِوَاقُه","وجارُك جارٌ لا يخافُ شتاءَ",34,"ا",2,0],["وهذه فَرحتْ واستبشرتْ ثقةً","بأن سيُضعَف منها الحر والسُّعرُ",35,"ر",1,0],["وهذه جَهلةٌ طَخْياء ثانيةٌ","بنا تَكشَّفُ بالخَطِّية السُّمُر",36,"ر",1,0],["وهذا أبو العباس حيّاً مؤمّلاً","ضَروبُ الرؤوسِ الطامحات قَموعها",37,"ع",3,0],["وهذا الموتُ للأحياء طُرّاً","قرارٌ والحياةُ لهم مثيلُ",38,"ل",1,0],["وهذا الدهرُ أطوارٌ تراها","وفيها الشَّهْدُ يُجنى والسِّمامُ",39,"م",1,0],["وَهَذا الجَديدُ أَبوهُ القَديمُ","وَلا تَلِدُ الحَيَّةُ الأَرنَبا",40,"ب",2,0],["وَهَذا الطَيرُ تيّاهٌ فَخورٌ بِالأَغاريدِ","فَمن ذا عَنَّفَ الزَهرَةَ أَو مَن وَبَّخَ الشادي",41,"ي",1,0],["وَهَذا الشَرقُ قَد أَعلَ","نَ بِالنورِ وَقَد صَرَّح",42,"ح",1,0],["وهذا الظَّلامِ وذاك الضِّياءِ","وتلكَ النُّجومِ وهذا الصَّعيدْ",43,"د",1,0],["وهذه الارض من خوفي سأهجرها","فلست تسمع بعد اليوم اخباري",44,"ي",1,0],["وهذا الجو أنت له امتدادٌ","وهذي الأرض أنت لها غطاء",45,"ا",2,0],["وهذا شبكي هات","أجل بالعود قد جيت",46,"ت",1,1],["وهذا الجو يُخمد كل برق","ويعجز دون بارق مقلتيك",47,"ك",1,0],["وهذا الصدر أضيق أن يحلَّى","وأن يسترجع الشأن الأجلا",48,"ل",2,0],["وهذى الرياض وهذى الحياض","وهذا النخيل وهذى الكروم",49,"م",1,0],["وهذى الرياض وهذا الحياض","وهذا النخيل وهذى الكروم",50,"م",1,0],["وهذه فشودة","ربيبتي المعهودة",51,"ه",1,0],["وهذى مصر باسطة اليدين","تؤدّى من ولائك خير دين",52,"ن",1,0],["وَهَذِهِ الدَولَةُ قَد دَعا لَها","وَقادَ في ظُهورِها رِعالَها",53,"ه",2,0],["وَهَذي الطَيرُ أَحقَرها","يَزيدُ الصَبَّ أَشجانا",54,"ن",2,0],["وَهَذِهِ واقِعَةٌ مُستَغرَبَه","في هَوَسِ الأَفعى وَخُبثِ العَقرَبَه",55,"ه",1,1],["وَهَذا كَغُصنِ الرُبا يَنثَني","وَهَذا كَريحِ الصَبا يَخطِرُ",56,"ر",1,0],["وَهَذِهِ حادِثَةٌ لَها مَعَه","تُنبيكَ كَيفَ اِستَأثَرَت بِالمَنفَعَه",57,"ه",1,0],["وَهَذِهِ الأَرضُ مِن سَهلٍ وَمِن جَبَلٍ","قَبلَ القَياصِرِ دِنّاها فَراعينا",58,"ن",2,0],["وَهَذا المُنيرُ القَريبُ القَريب","وَهَذا المُنيرُ البَعيدُ البَعيد",59,"د",1,0],["وَهَذا المُنيرُ الَّذي لَن يُرى","وَهَذا المُنيرُ وَكُلٌّ شَهيد",59,"د",1,0],["وَهَذا الجُسامُ الخَفيفُ الخُطا","وَهَذا الجُسامُ الَّذي ما يَميد",59,"د",1,0],["وَهَذَّبَ الهِندُ دِياناتِهِم","بِكُلِّ خافٍ مِن رُموزي وَباد",60,"د",1,0],["وَهَذا زَمانٌ أَرضُهُ وَسَماؤُهُ","مَجالٌ لِمِقدامٍ كَبيرِ حَياةِ",61,"ه",1,0],["وَهَذِهِ الضَجَّةُ مِن ناسِهِ","جَنازَةُ الرِقِّ إِلى تُربِهِ",62,"ب",2,0],["وهذِهِ الرُّوحُ قدْ جَاءَتْكَ زائرةً","هذي زِيارَةُ مَنْ في القَبْرِ مَلْحُودُ",63,"د",1,0],["وَهَذا الشَوقُ قَبلَ البَينِ سَيفٌ","فَها أَنا ما ضُرِبتُ وَقَد أَحاكا",64,"ك",2,0],["وَهَذا أَوَّلُ الناعينَ طُرّاً","لِأَوَّلِ مَيتَةٍ في ذا الجَلالِ",65,"ل",1,0],["وَهَذا دُعاءٌ لَو سَكَتُّ كُفِيتَهُ","لِأَنّي سَأَلتُ اللَهَ فيكَ وَقَد فَعَل",66,"ل",1,0],["وَهَذا الدُرُّ مَأمونُ التَشَظّي","وَأَنتَ السَيفُ مَأمونُ الفُلولِ",67,"ل",1,0],["وَهَذِهِ هَيبَةٌ لَم يُؤتَها بَشَرٌ","وَذا اِقتِدارُ لِسانٍ لَيسَ في المُنَنِ",68,"ن",1,0],["وهذي المقاطيع فيها اختصا","ر جميع العلوم الذي طوّلوا",69,"ل",3,0],["وهذا ختام القول في الحكمة التي","بدأنا بها شكراً لخالقنا شكرا",70,"ر",2,0],["وهذه الأصباغ قد ولدت","من بذرها الأصباغ في شمسِها",71,"س",3,0],["وَهَذِهِ الأَيّامُ قَد أُبدِلَت","فَهيَ ظِرافٌ ناضِراتٌ حِسان",72,"ن",1,0],["وَهَذا أَواني اليَومَ يا آلَ نَهشَلٍ","رَدَيتُ صَفاكُم مِن عَلٍ فَتَصَدَّعا",73,"ع",2,0],["وهذا العيشُ مُخْتَضَرٌ وقالوا","لنا عَيْشٌ نصيرُ إليه ثانِي",74,"ي",1,0],["وهذا قال قِدرٌ من طَعامٍ","وهذا قال دَنٌّ من شَرابِ",75,"ب",1,0],["وَهَذا رَسولُ اللَهِ كَالبَدرِ بَينَنا","بِهِ كَشَفَ اللَهُ العِدى بِالتَناكُسِ",76,"س",1,0],["وَهَذا العِلمُ لا يَعلَمهُ إِلّا","نَبِيٌّ أَو وَصِيُّ الأَنبِياءِ",77,"ا",2,0],["وَهَذا الخَلقُ مِنكَ عَلى وَفازٍ","وَأَرجُلُهُم جَميعاً في الرِكابِ",78,"ب",1,0],["وَهَذي القِيامَةُ قَد أَشرَفَت","عَلى العالَمينَ لِميقاتِها",79,"ت",3,0],["وَهَذِّب عِبارَةَ طَرزِ الكَلامِ","وَاِستَوفِ سائِرَ أَقسامِها",80,"م",3,0],["وهَذي المنايا الحمر ترقصُ في دمي","وهذي المنايا البيض تختالُ في فَودِي",81,"د",2,0],["وهذا الجسم يا ظمآ","ن في دارك كم يغري",82,"ي",1,0],["وهذه السيارة العاتيه","وربها الجبار كالبرق سار",83,"ر",1,0],["وهذا العمر قد ذهبا","وأحسن ما به ولّى",84,"ل",2,0],["وهذه قيثاري","ذاتُ الشجى والأنين",85,"ن",1,0],["وهذه أوتاري","أصرتِ لا تطربين",85,"ن",1,0],["وهذا لَعَمْري كلّهُ غيرُ كائنٍ","فأخْرَاكَ وَاصِلهْا ودنياكَ فاهجرها",86,"ر",3,0],["وَهَذا صَباحُ اليَومِ يَنعاكَ ضَوؤُهُ","وَلَيلَتُهُ تَنعاكَ إِن كُنتَ تَشعُرُ",87,"ر",1,0],["وَهَذِهِ شِيمَةُ الدُّنْيَا وَمِنْ عَجَبٍ","أَنِّي أَرَى مِحْنَتِي فِيهَا وَتُعْجِبُنِي",88,"ن",2,0],["وهذهِ تُعرَفُ مِنْ قديمٍ","بأنها قطعةُ بِنتِ الرومي",89,"ي",1,0],["وهذهِ قَدْ حُسِبَتْ زورةً","مالكَ يا لعبةُ مستعجلَهْ",90,"ه",1,0],["وهذا يهيِّئُ أشغالَهُ","وهذا يُجهِّزُ أكفانَهُ",91,"ن",2,0],["وهذا يصالحُ أعداءَهُ","وهذا يلاطف إخوانَهُ",91,"ن",2,0],["وهذا يوسِّعُ إنفاقَهُ","وهذا يخالِلُ مَنْ خانَهُ",91,"ن",2,0],["وهذا يحبِّسُ أملاكَهُ","وهذا يحرِّرُ غِلْمانَهُ",91,"ن",2,0],["وهذا يُغيِّرُ أخلاقَهُ","وهذا يعيِّر ميزانَهُ",91,"ن",2,0],["وهذه قد حُسبتْ زورةً","لمْ أَنْتِ يا لعبةُ مستعجلهْ",92,"ه",1,0],["وَهَذا يَنامُ عَلى فِضَّةٍ","وَهَذا يَبيتُ ضَجيعَ الذَهَبْ",93,"ب",1,0],["وَهَذا يَطوفُ بِأَوراقِهِ","مُعَنّى الأَماني حَثيثَ الطَلَبْ",93,"ب",1,0],["وَهَذِي قَضَايَا عَن عُلاَكَ رَوَيتُهَا","فَإنِّي بِهَأ وَهِيَ الكوَاكبُ نَائِلُ",94,"ل",1,0],["وَهَذا ذَبيحٌ قَد فَداهُ بِكَبشِهِ","بَراهُ بَديهاً لا نِتاجَ الثَياتِلِ",95,"ل",1,0],["وَهَذا رَئيسٌ مُجتَبىً ثَمَّ صَفوُهُ","وَسَمّاهُ إِسرائيلَ بَكرَ الأَوائِلِ",95,"ل",1,0],["وهذهِ خيْلُهُ غُرّاً مُسَوَّمَةً","يخرُجن من هبَواتِ النقع كالشُّعَل",96,"ل",1,0],["وَهَذي القِيامَةُ قَد أَشرَفَت","تُريكَ مَخاوِفَ فَزعاتِها",97,"ت",3,0],["وَهَذا الدَهرُ بَشَّرَ بِالمَنايا","فَلِم فَرِحَت بِبَشرٍ أُمُّ بِشرِ",98,"ر",1,0],["وَهَذي الأَرضُ لِلمَلِكِ المُرَجّى","نُلِمُّ بِها كَإِلمامِ الضُيوفِ",99,"ف",1,0],["وَهَذِهِ الدُنيا عَلى أَنَّها","مَحبوبَةٌ لَم تُخلِنا مِن أَلَم",100,"م",1,0],["وهذا لأهلِ النّطقِ شَرْعي ومذهَبي","فمَنْ لم يُطِعْني عَقَّ أمْرَ إمامِهِ",101,"م",2,0],["وهذه مِن أثبتِ المعارفْ","في الأَوْجهِ الغامضَةِ اللَّطائفْ",102,"ف",1,0],["وهذه الغزاةُ تُدعى القاضِيَه","وقد أتَتهمْ بعد ذاك الدَّاهِيه",102,"ه",1,0],["وهذي الأرضُ قد وارتْ","كنوزاً عِدَّةً جَمَّهْ",103,"م",2,0],["وهذه سُنَّةُ العُشّاقِ ما علِقوا","بِشَادِنٍ فخَلاَ عُضْو من الألَم",104,"م",1,0],["وهذا بتهديده يدَّعي","وذاك بتنديده يَزْعم",105,"م",1,0],["وهذه صورة للشعر أعرضها","على الَّذين يرون الشعر ذا صور",106,"ر",1,0],["وَهَذا جزاء الشاعر الأخرق الَّذي","إلى بلد جم الجهالة أَخلدا",107,"د",2,0],["وَهذه حسنات","يذهبن بالسيئات",108,"ت",1,0],["وَهذه هي في التَحقيق باعثة","له عَلى السعي في الدنيا بلا ملل",109,"ل",1,0],["وهذه تُومِئُ للساهر","والليلُ صافٍ وأديم السماء",110,"ا",2,0],["وهذه تجلو كثيف الغيوم","وهذه تَدرَأُ عني الهموم",110,"م",1,0],["وهذه الأعينُ نهبَ العفاءْ","في رقدةِ الموتِ كأنْ لم تَنَمْ",111,"م",1,0],["وهذه الأيدي تحوطُ الصدورْ","كأنها في موقفٍ للصلاهْ",111,"ه",1,0],["وهذه السحبُ أصباغاً مشكّلةً","في رائعٍ من فريدِ اللون فتّانِ",112,"ن",1,0],["وهذه الدنيا يدُ العظيم","وسرّه في ملكه النظيم",113,"م",1,0],["وهذه صُورةُ كُلِّ واحده","مِنها ومَعنى فَسرها على حِدَه",114,"ه",1,0],["وهذه صُورتُها كما تَرى","وذكرُها مبيَّناً مفسَّرا",114,"ر",2,0],["وهذه الثانية المخصوصَه","بالسببِ الثَّقيلِ والمَنقوصَه",114,"ه",1,0],["وهذه صورتُها مبيَّنه","بحَلْيها ووَشْيها مُزَيَّنَه",114,"ه",1,0],["وَهَذا لِسَانُ الشُّكْرِ يَدْعُو مُؤَرِّخَاً","حَوَى الْعِيدُ أَنْوَاعَ الْفَخَارِ بِعَبَّاسِ",115,"س",1,0],["وَهَذا الْعُمْرُ فِي الْغَايَا","تِ يعْدِلُ طُولُهُ الْعَرْضَا",116,"ض",2,0],["وَهَذَا شُرْبُنا يَا لَيْلُ","مِنْ آثَارِهِ الكُدْرِ",117,"ر",1,0],["وَهَذَا لَيْلُكَ المَأْمُولُ","أَحْيَيْنَاهُ بِالْبِشْرِ",117,"ر",1,0],["وَهذَّبَتْ بِقَوْيِمِ السَّيْرِ نِسْوَتَهُمْ","فَمَا بِهِنَّ وَقَدْ جَارَيْنَهَا أَوَدُ",118,"د",1,0],["وَهَذِهِ آيَةٌ مِنْهُ مُجَدَّدَةٌ","زَانَتْ بِكَ النَّسَبَ الْمُوُرُوثَ وَالْحَسَبَا",119,"ب",2,0],["وَهَذَا النَّيلُ نِيلُهُمَا جَمِيعاً","كَفَى سَبَباً لِيَخْلُدَ الاِتِّصَالُ",120,"ل",1,0],["وَهَذِي الظِّلاَلُ الْبَاسِطَاتُ أَكُفَّهَا","وَهَذِي الشِّعَاعُ المُؤمِئَاتُ بِأَذْرُعِ",121,"ع",1,0],["وَهَذِي المِيَاهُ النَّاظِرَاتُ بِأَعْيُنٍ","وَهَذِي الْغُصُونُ المُصْغِيَاتُ بِمَسْمَعِ",121,"ع",1,0],["وَهَذِهِ فِي يَدِي مُشعْشَعَةً","بَعَثْتُهَا مِنْ غَيَابَةِ القبْرِ",122,"ر",1,0],["وَهَذي النِّهَايَةُ عُقْبَى النُّهَى","وَذَاكَ الثَّرَاءُ لِهذَا الثَّرَى",123,"ر",2,0],["وَهَذا السَيلُ مِن تِلكَ الغَوادي","وَهَذي السُحبُ مِن تِلكَ الرِياحِ",124,"ح",1,0],["وهذي كوبَتي الفخّ","ار ما فيها سوى صاب",125,"ب",1,0],["وَهذي رَكائِبُهُ لِلزِّما","عِ قَد زَمَّهُنّ وَقَد شَظَّظا",126,"ظ",2,0],["وَهذا كانَ أَكبَرها","وَأَسعَدها وَأَيمَنها",127,"ن",3,0],["وهذا زمان الزهو حيالك باسما","تلوح سمات البشر في وجهه الطلق",128,"ق",1,0],["وهذت باسمك الرؤى فتنادت","صيحات الديوك من كل قاره",129,"ر",2,0],["وَهَذِهِ المَنَازِلِ الْحَمْرَاءِ","رَاقيةْ مَعَارِجَ العَلاَءِ",130,"ا",2,0],["وَهَذِهِ الْخُطُوطِ فِي البَيْدَاءِ","كَأَنَّهَا أَسِرَّةُ العَذْرَاءِ",130,"ا",2,0],["وهَذِهِ الِميَاهِ فِي الصَّفَاءِ","آناً وَفِي الإِزْبَادِ وَالإِرْغَاءِ",130,"ا",2,0],["وهذا زمانٌ يُلينُ اللسانَ","على وَغَر القلبِ إنسانه",131,"ن",2,0],["وهذا بلاء يُمطر الشرَّ منذراً","وهذا وباءٌ يَجرف الشَعب غاشِيا",132,"ي",2,0],["وهذا الشبابُ الطليقُ العنان","سيُكْبَحُ منه ويُستوقَف",133,"ف",1,0],["وهذي جيوشُ العلم والشعر تبتغي","لها قائداً فذاً فهل أنَت قائد؟",134,"د",1,0],["وهذا \" زعيمٌ \" ، لأنّ السفيرَ","يرنو إليه بعينِ الرّضا",135,"ا",1,0],["وهذا بعِمتَّهِ ، ساخراً ،","من \" الجنِّ \" يَرفعها للعلى",135,"ا",1,0],["وهذا وذا في صميمِ البلادِ","سُلٌّ ، وفي العينِ منها قذى",135,"ا",1,0],["وهذا الذي إحدى يديهِ بجيبهِ","وأُخراهما تلهو بشاربه كِبرا",136,"ر",2,0],["وهذا الذي رغمَ النعيم وشرخهِ","يُرى حاملاٍ وجهاً من الحقدِ مُصفرّا",136,"ر",2,0],["وهذا الذي إنْ أعجبَ الناسَ قولهُ","مشى ليُريهمْ أنه فاتحٌ مِصرا..",136,"ر",2,0],["وهذا الذي قد فخَّمتْه شهادةٌ","خلاصتُها أنَّ الفتى قارئٌ سطرا",136,"ر",2,0],["وهذا لَعَمْرِي كلّهُ غيرُ كائنٍ","فأُخْرَاكَ وَاصِلْها ودنياك",137,"ك",1,0],["وهذي المنايا الحمر ترقص في دمي","وهذي المنايا البيض تختل في فودي",138,"د",2,0],["وَهَذَا مُرَاضِيَهَا وَذَاكَ مُغَاضِبٌ","وَهَذَا مُبَاكِيهَا وَذَاكَ مُلاَعِبُ",139,"ب",1,0],["وَهَذا الذَّكَاءُ العَبْقَرِيُّ مَلِيكُه","وهَذِي الْجُنُودُ الزَّاخِرَاتُ مَواكِبُهْ",140,"ب",2,0],["وهذا القصر بينهم خطيب","ومغناه الانيق له حبيب",141,"ب",1,0]]}