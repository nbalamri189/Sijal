{"poems":[[55,"أغار على ثراك من الرياح","https://www.aldiwan.net/poem30656.html","الوافر"],[79,"إذا فاتني ظل الحمى ونعيمه","https://www.aldiwan.net/poem36117.html","الطويل"],[75,"ألا هل درى الداعي المثوب إذ دعا","https://www.aldiwan.net/poem11947.html","الطويل"],[4,"ترى الكثير قليلا حين تسأله","https://www.aldiwan.net/poem21281.html","البسيط"],[39,"نعلمهم بها ما علمتنا","https://www.aldiwan.net/poem7633.html","الوافر"],[39,"الا حييت عنا يا مدينا","https://www.aldiwan.net/poem7642.html","الوافر"],[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[87,"قبر الوزير تحية وسلاما","https://www.aldiwan.net/poem62828.html","الكامل"],[51,"نعل بعثت بها لتلبسها","https://www.aldiwan.net/poem64161.html","الكامل"],[99,"أقبل بموكبك الأغَر","https://www.aldiwan.net/poem24760.html","مجزوء الكامل"],[15,"يا ذا المخوفنا بقت","https://www.aldiwan.net/poem45242.html","مجزوء الكامل"],[79,"إِذَا فَاتَنِي ظِلُّ الْحِمَى وَنَعِيمُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=118227",""],[87,"قبرَ الوزيرِ، تحيَّة ً وسَلاما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9624&r=&rc=114",""],[130,"للحب دين وللأشواق باقينا","https://www.aldiwan.net/poem794.html",""],[131,"عجبت أمامة إذ رأتني شاحبا","https://www.aldiwan.net/poem24207.html","الكامل"],[136,"أدينك أن تذمى الخيزرانا","https://www.aldiwan.net/poem54721.html","الوافر"],[234,"ألا من لنفسي وأوصابها","https://www.aldiwan.net/poem51210.html","المتقارب"],[254,"لمن الديار غشيتها بالأنعم","https://www.aldiwan.net/poem2093.html","الكامل"],[285,"بنفسي على قربه النازح","https://www.aldiwan.net/poem60778.html","المتقارب"],[396,"الحمدلله مولانا الرحيم الغفور","https://www.aldiwan.net/poem54583.html","عموديه"],[445,"ثنائي عليك ونعماك فينا","https://www.aldiwan.net/poem34861.html","المتقارب"],[556,"من مثلها كنت تخشى أيها الحذر","https://www.aldiwan.net/poem47824.html","البسيط"],[563,"نسب المحبة أقرب الأنساب","https://www.aldiwan.net/poem34931.html","الكامل"],[566,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145796","المتقارب"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203786",""],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133837","الوافر"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25336","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50035","البسيط"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100474","السريع"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71040","الطويل"],[2391,"","https://poetry.dctabudhabi.ae/diwan/poem/18049","الكامل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83212","الوافر"],[563,"","https://poetry.dctabudhabi.ae/diwan/poem/68318","الرجز"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74235","البسيط"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112547","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100806","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62838","الوافر"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125867","الطويل"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119582","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72730","الكامل"],[5186,"حيي السماح عهود ماضينا","https://www.poetsgate.com/ViewPoem.aspx?id=156451",""],[5216,"عَبَرْنا لِلْخُلود","https://www.poetsgate.com/ViewPoem.aspx?id=186939",""],[5233,"غير ُ مُجْد ٍ يا صاحبَيَّ الجدالُ","https://www.poetsgate.com/ViewPoem.aspx?id=37043",""],[5237,"أنوار سيدنا النبي المرسل","https://www.poetsgate.com/ViewPoem.aspx?id=113114",""],[5508,"يا سيّدي قد رمُيتُ من زمني","https://www.poetsgate.com/ViewPoem.aspx?id=110835",""],[327,"آذَنَ اليومَ جِيرتي بارتحالِ","https://www.poetsgate.com/ViewPoem.aspx?id=3928",""],[5652,"عقولٍ تعشق الرأفه بليده دون فكرية","https://www.poetsgate.com/ViewPoem.aspx?id=178408",""],[5691,"نِعلين تقاوم الجدار","https://www.poetsgate.com/ViewPoem.aspx?id=206393",""],[5781,"نورُكَ شمسٌ آفِلة","https://www.poetsgate.com/ViewPoem.aspx?id=202849",""],[5784,"ضفدع","https://www.poetsgate.com/ViewPoem.aspx?id=199021",""],[5922,"أفضل امرءة في التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=183795",""],[5956,"نريد الرجوع","https://www.poetsgate.com/ViewPoem.aspx?id=192335",""],[5956,"تراث يصغي لغناء ابنه ويقول:","https://www.poetsgate.com/ViewPoem.aspx?id=205423",""]],"verses":[["نُعَلَّلُ بِالزُلالِ مِنَ الغَوادي","وَنُتحَفُ بِالنَسيمِ مِنَ الرِياحِ",0,"ح",1,0],["نُعَلِّلُ بالتَّذْكَارِ نَساً مَشُوقَةً","يُدِيرُ عَلَيْهَا كَأْسَهُ وَيُدِيمُهُ",1,"م",2,0],["نُعَلِّلُ فيها بِالمُنى فَتَغُرُّنا","بَوارِقُ لَيسَ الآلُ مِنها بِأَخدَعا",2,"ع",2,0],["نَعلوهُمُ كُلَّما يَنمي لَهُم سَلَفٌ","بِالمَشرَفِيِّ وَلَولا ذاكَ قَد أَمِروا",3,"ر",3,0],["نعلمهم بها ما علمتنا","أُبُوتنا جواريَ أو صُفُونا",4,"ن",2,1],["نعلمها هَبِى وَهَلا وارحِبْ","وفي أبياتنا ولنا افتُلينا",5,"ن",2,0],["نُعَلِّمُهَا هَب وهَلاَ وأَرحب","وَفي أبيَاتِنَا وَلَنَا افتُلِينَا",6,"ن",2,0],["نُعلي تَعاليمَ المَسيحِ لِأَجلِهِم","وَيُوَقِّرونَ لِأَجلِنا الإِسلاما",7,"م",2,0],["نَعلٌ بَعَثتُ بِها لِتَلبَسَها","تَسعى بِها قَدَمٌ إِلى المَجدِ",8,"د",1,1],["نَعلو على قمم الجبال","ونرى العوالم من عَلِ",9,"ل",1,0],["نُعليهِمُ تَحتَ الضَبابِ","المَشرَفِيَّ إِذا اِعتَزَينا",10,"ن",2,0],["نُعَلِّلُ بالتَّذْكَارِ نَفساً مَشُوقَةً","يُدِيرُ عَلَيْهَا كَأْسَهُ وَيُدِيمُهُ",11,"م",2,0],["نعلي تعاليمَ المسيحِ لأجلهم","ويوقِّرون لأجلينا الإسلاما",12,"م",2,0],["نعللُّ النفس بالآمال تسلية","لا النفس تسلو ولا الآمال تغنينا",13,"ن",2,0],["نَعْلَيَّ حَذْوُ نعالها ولربَّما","أحذو العِدا ولكلِّ عادٍ مَصْرَعُ",14,"ع",1,0],["نُعَلِّلُهُم على العِلاَّتِ صِرفاً","أوَاناً ثُمَّ نَمزِجُها أوَانَا",15,"ن",2,0],["نُعَلَّل ما بين حَوْذانِها","وطِيبِ ثراها ولَبْلابها",16,"ب",3,0],["نَعلو القَوانِسَ بِالسُيوفِ وَنَعتَزي","وَالخَيلُ مُشعَلَةُ النُحورِ مِنَ الدَمِ",17,"م",1,0],["نُعَلِّلُ أَنْفُسَنا بِالْمُقامِ","وَفِي طَيِّهِ السَّفَرُ النَّازِحُ",18,"ح",1,0],["نعلم وندري ولا نعمل ومعنا غرور","نفعل ونلهو كانا لم نصر للقبور",19,"ر",1,0],["نُعَلِّلُهمْ بِجَنى روضِها","إذَا أَوْحَشَتْهُمْ عطاياكَ حِينا",20,"ن",2,0],["نُعَلُّ مِن كلِّ مَكروهٍ ويملِكنا","حُبُّ الحياةِ الّتي أيّامُها غَرَرُ",21,"ر",1,0],["نعلو ونسفل في يدي أسمائه","من قرب تنعيم وبعد عذاب",22,"ب",1,0],["نَعلاً وَلا ظَهراً سِوى التَرجُّلِ","حَتّى تَناهى لِمناهي المَوئِلِ",23,"ل",1,0],["نعَلمُه كيفَ أبَاؤنا","إلى قاع ِأحْزانهمْ يَنزلِونْ",24,"ن",1,0],["نُعَلّمُهُ كيفَ آبَاؤنا","يُغنّونَ في الليل ِإذ ْيَضجِرُونْ",24,"ن",1,0],["نُعَلّمُه ُكيفَ يَسْتأمِنونَ ال","سُقوفَ التي تحتها يَسْهَرونْ",24,"ن",1,0],["نُعَلّمُه كيفَ آبَاؤنا","باوجاعِهمْ في المَدَى يَنحَتونْ",24,"ن",1,0],["نَعَلوا النضارَ الغانيا","تِ وشعبهم طاوٍ يصيحُ",25,"ح",1,0],["نعلّك ما يثوب إذا","وفاء الناس لم يثب",26,"ب",1,0],["نَعْلُو بِهَا مَسَاحِج الأَمْشاطِ","حَتَّى أَقَمْنَاهُمْ عَلى الصِراطِ",27,"ط",1,0],["نعلّل النّفس بالشيء المريح لها","عبادةً ما اتقّت لله عصيانا",28,"ن",2,0],["نعلم فيه العدل علم اليقين","يا نفس أي الفضل تحصينه",29,"ه",1,0],["نُعَلِّمُكم منكم وعنكم نُفِيدُكم","أشيءٌ سِوى هذا المقال فهاتوا",30,"ت",3,0],["نَعلو بِهِ صَدرَ البَعيرِ وَلَم","يُوجَد لَنا في قَومِنا كِفلُ",31,"ل",1,0],["نُعَلِّل بِالوُعودِ عَلى شِفارٍ","أَبانَت مِن حناجِرِنا مُصابا",32,"ب",2,0],["نعلمه نحن بما علمنا","به من الوفاء بالعهود",33,"د",1,0],["نعل بها قدم الهادي الأَمين ثَوَت","فَفيه مِن قدم المُختار أَسرار",34,"ر",1,0],["نعل مَشَت في قباب العَرش وَارتفعت","عَلى البساط بِذا جاءتك أَخبار",34,"ر",1,0],["نعل تعالى عن الإكبار والعظم","توّج به الرأس لا تلبسه في القدم",35,"م",1,0],["نعلل النفس بالتمثال نبصره","وان تكن عنك لا تغنى التماثيل",36,"ل",1,0],["نُعَلَّلُ بالدّواءِ إذا مَرضْنا","وهل يَشفى من الموتِ الدّواءُ",37,"ا",2,0],["نعللُ بالآمالِ أطماعَ أَنْفُسٍ","وهل أَحَدُ منا مِن الموتِ سالم",38,"م",1,0],["نعل بعثت بها لتلبسها","قدم بها تسعى إلى المجد",39,"د",1,1],["نعل على هام العلى","يعلو ولا يعلى عليه",40,"ي",2,0],["نعلي ذراه بكل مكرمة","وتزين أيدينا أيادينا",41,"ن",2,0],["نُعَلِّمُ جيلَنا الآتي دُروسًا","ليبقى النَّصْرُ قِنْديلًا يُرينا",42,"ن",2,0],["نَعْلِكُ المفردات ِ مثل لُبان ٍ","فالنقاشاتُ ضجّة ٌ وسِجالُ",43,"ل",1,0],["نعليك لا تخلعهما في حضرة","ما قام فيها قبله من مرسل",44,"ل",1,0],["نَعْلُك تاجٌ إذا رفعتهمُ","لرأسِ حافٍ منهم ومُنتَعِلِ",45,"ل",1,0],["نِ عَلَتْهُ مُسْوَدَّة ُ الأَسْمالِ","وَهْيَ تَسْمو بِذي بلاعيمَ عُوجٍ",46,"ج",1,0],["نعلّم كيف نتعلم نروف ونرحم المحتاج","عقولٍ تعشق الرأفه بليده دون فكرية ..!!!",47,"ر",3,0],["(نعْلينُ) ترفعُ للفَخارِ لواءَ","وتجوزُ في عليائِها الجوْزاءَ",48,"ا",2,1],["نعْلينُ ترْسُمُ بالسَّلامِ طريقَها","لترى الدِّيارَ بهِ تُعَمُّ هَناءَ",48,"ا",2,0],["نُعَلِّقُ آمالاً ونُغْوي وُعودَنا","وَبَوْحُ الوَرى ماضٍ إذا نَفِدَ العُمْرُ",49,"ر",1,0],["نَعْلٌ مُظَفَّرَةُ الُجَوَانِبِ مُرَّةٌ","مِنْ ضَرْبِهَا يَمْشِي الرُّوَيْبِضُ أَرْبَعَا",50,"ع",2,0],["نعلّمُ الكوْنَ مافي الأرضِ من نعمِ","تزهو بها النّفسُ من دوّامةِ الجسدِ",51,"د",1,0],["نعلّل أنفسنا في المساءِ","نقول: الرجوع غداً في البُكورْ",52,"ر",1,0],["نُعْليه فوق نحورنا وكأنه","جنكيزُ، أو هارونُ آلُ رشيدِ",53,"د",1,0]]}