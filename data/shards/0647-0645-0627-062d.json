{"poems":[[95,"ألا أيها الطالع المتبسم","https://www.aldiwan.net/poem11413.html","الطويل"],[87,"خطونا في الجهاد خطى فساحا","https://www.aldiwan.net/poem7108.html","الوافر"],[47,"بعينيك ضوء الأقحوان المفلج","https://www.aldiwan.net/poem62674.html","الطويل"],[107,"من يمنع الليث أن يعتز أو يثبا","https://www.aldiwan.net/poem43386.html","البسيط"],[50,"وجدت لكل الناس في الجود خطة","https://www.aldiwan.net/poem63384.html","الطويل"],[48,"تسمت رجال بالملوك سفاهة","https://www.aldiwan.net/poem23079.html","الطويل"],[108,"تحية العميد","https://www.poetsgate.com/ViewPoem.aspx?id=179696",""],[108,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[521,"بكيت ابن ليلى وابنه ورأيتني","https://www.aldiwan.net/poem48586.html","الطويل"],[574,"فان يبل الشباب فكل شيء","https://www.aldiwan.net/poem51993.html","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48738","الكامل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122350","المنسرح"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16888","الوافر"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78167","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49933","البسيط"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87749","السريع"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93900","الخفيف"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100830","البسيط"],[3574,"","https://poetry.dctabudhabi.ae/diwan/poem/188172",""],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85015","الخفيف"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133291","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54363","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139631",""],[4779,"ولا يَجْزُون من خَيْرٍ بِشَرٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=213882",""],[5490,"ماغيبوك","https://www.poetsgate.com/ViewPoem.aspx?id=176355",""],[5616,"حماس","https://www.poetsgate.com/ViewPoem.aspx?id=205248",""],[402,"ألا أيهذا الطالع المتبسم","https://www.poetsgate.com/ViewPoem.aspx?id=36219",""],[5956,"يتسلسل الوفاء منا لأسرة نجلي فراس","https://www.poetsgate.com/ViewPoem.aspx?id=193153",""]],"verses":[["هُمُ أَحْرَجُونَا فَاقْتَضَوْنَا هَلاَكَهُمْ","عَلَى أنَّنَا كُنَّا نُضَامُ فَنَحْلَمُ",0,"م",1,0],["هما حق وأنت ملَّئت حقا","ومثَّلت الضحية والسماحا",1,"ح",2,0],["هُما حَجَزا شَغبي وَكَفّا شَكيمَتي","فَلَم أَتَوَعَّر في وَشيعَةِ مَنهَجي",2,"ج",2,0],["هُم أَحكَموا الرَأيَ وَالتَدبيرَ وَاِتَّخَذوا","لِكُلِّ ما اِعتَزَموا مِن مَطلَبٍ سَبَبا",3,"ب",2,0],["هُمُ أَحرَزوا الرِغفانَ حَتّى تَكَلَّمَت","أَمِنّا بِحَولِ اللَهِ مِن حَذَرِ الكَسرِ",4,"ر",1,0],["هُما حالَتا سوءٍ حَياةٌ بِلَوعَةٍ","وَمَوتٌ فَخَيِّر هَذِهِ النَفسَ أَو تِلكا",5,"ك",2,0],["هما حرفان ضَمَّهما اسم طه","قرأنا فيهما معنى الخلود",6,"د",1,0],["هم أحرزوا النصر؛ حتى ما لغيرهمو","في النقص: نونٌ، ولا قاف، ولا صاد",7,"د",1,0],["هُما حَذياني الخَير حَتّى تَشعبت","غُصوني بِنَبت ناضِر في ثَراهُما",8,"م",2,0],["هما حبيبا بديباج كَريم","وَياقوت يفصل بالمَحالِ",9,"ل",1,0],["هم أحسنوا الأعذار حتى قاربت","فضل الصفوح رعاية ومقاما",10,"م",2,0],["هم احرمونا الخدود نلثهما","وكل وقت يمسها الخجل",11,"ل",1,0],["هُما حَرّانِ مِن جوعٍ وَسُكرٍ","فَيالَكَ مِن سَعيرٍ في سَعيرِ",12,"ر",1,0],["هُم أَحمَد وَمُحَمَد بَدر العُلا","وَالشَهم سَعد الدين ذو القَدر السَمي",13,"م",2,0],["هُمُ أَحلُّوا أَبا عبد الالهِ بها","في رأْسٍ أرْعَنَ بيتاً غيرَ مَنْحوتِ",14,"ت",1,0],["هُم أَحرَص الناس علَى سُمعة","فَحافِظي أَنتِ عَلى سُمعتك",15,"ك",1,0],["هم أحقاء بالكمال وأني","لسواه في نقصه التكميل",16,"ل",1,0],["هم أحرجونا بهذا الضيم من زمن","فان هممنا بدفع الضيم لم نلم",17,"م",1,0],["هم أحبّائي فديتهمُ","وصلوا المشتاق أو هجروا",18,"ر",3,0],["هُم أَحَلّوهُ في رُبوعِ التَصابي","وَأَثاروا بِعِشقِهِم أَشجانِهِ",19,"ن",2,0],["هم أحرزوا دون البرية سوددا","تلقاء هاتيك المكارم والشيم",20,"م",1,0],["همُ أَحدثوا قمعَ الضّلالةِ بالهُدى","فمذ ملكوا لم تلقَ في الدِّين محدثا",21,"ث",2,0],["هم أحرزوا غر المزايا فأصبحت","برمَّتها تنمى اليهم وتسند",22,"د",1,0],["هُمُ أَحْمَوْا حِمَى الوَقَبْى بضَرْبٍ","يُؤَلِّفُ بَيْنَ أَشْتَاتِ المَنُونِ",23,"ن",1,0],["هم أحرصُ الناس أن يحيَوْأ فأورَثهم","حِرْصٌ عليها وقد غُلّوا بها قلَقا",24,"ق",2,0],["هم أحرقوهُ، ونحن في حاناتنا","مترنِّحونَ، وخمرنا موفورُ!",25,"ر",1,0],["هم أحرجونا فاقتضونا هلاكهم","على أننا كنا نضام فنحل",26,"ل",1,0],["هم أحسنوا إعالتي من دون أن أساءوا","لو مرة في العمرِ أو هم راءوا",27,"ا",1,0]]}