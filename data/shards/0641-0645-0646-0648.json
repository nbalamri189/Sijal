{"poems":[[55,"عجزنا عن مراغمة الحمام","https://www.aldiwan.net/poem29763.html","الوافر"],[55,"تطاط لها فيوشك أن تجلى","https://www.aldiwan.net/poem29856.html","الوافر"],[55,"وفى بمواعيد الخليط وأخلفوا","https://www.aldiwan.net/poem29968.html","الطويل"],[55,"أقول وقد جاز الرفاق بذي النقا","https://www.aldiwan.net/poem30530.html","الطويل"],[93,"تسير بنا على عجل","https://www.aldiwan.net/poem62631.html","عموديه"],[47,"أمير المؤمنين أما غياث","https://www.aldiwan.net/poem64646.html","الوافر"],[47,"قف العيس قد أدنى خطاها كلالها","https://www.aldiwan.net/poem65539.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42599","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54312","البسيط"],[102,"مناضل في الفراش","https://www.poetsgate.com/ViewPoem.aspx?id=50443",""],[151,"سلام عليكم طال شوقي إليكم","https://www.aldiwan.net/poem47671.html","الطويل"],[151,"فإن كان هذا البعد تأديب مذنب","https://www.aldiwan.net/poem47685.html","الطويل"],[154,"لكم من فؤادي خلص الود والحب","https://www.aldiwan.net/poem68479.html","الطويل"],[202,"دعا بإقامة الشوق الرحيل","https://www.aldiwan.net/poem51908.html","الوافر"],[254,"تداركني أوس بن سعدى بنعمة","https://www.aldiwan.net/poem2112.html","الطويل"],[261,"رأيت كلاب مولانا وقوفا","https://www.aldiwan.net/poem48490.html","الوافر"],[275,"أرى حبي شرارا مستطيرا","https://www.aldiwan.net/poem35589.html","الوافر"],[287,"على حبكم عادلي عاذلي","https://www.aldiwan.net/poem32670.html","المتقارب"],[287,"سقى الله ديرا فيه نادمت قسيسا","https://www.aldiwan.net/poem32728.html","الطويل"],[309,"هواكم بقلبي والفؤاد مقيم","https://www.aldiwan.net/poem16821.html","الطويل"],[422,"أدار الكأس صافية المدام","https://www.aldiwan.net/poem53947.html","الكامل"],[422,"أحبتنا أنتم على السخط والرضا","https://www.aldiwan.net/poem53975.html","الطويل"],[422,"بحيث انعطف البان","https://www.aldiwan.net/poem54026.html","الهزج"],[435,"بدا ينجلي تحت الغلالة والبرد","https://www.aldiwan.net/poem40517.html","الطويل"],[438,"نضا عضبا من الجفن","https://www.aldiwan.net/poem12740.html","الهزج"],[447,"هو الرزء حتى خص ريش القوادم","https://www.aldiwan.net/poem14478.html","الطويل"],[519,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[580,"أقمت على عاشقيك القيامه","https://www.aldiwan.net/poem2863.html","المتقارب"],[580,"أتى زائراً مستخفياً من رقيبه","https://www.aldiwan.net/poem2966.html","الطويل"],[591,"أأطلب يا محمد أن يؤولا","https://www.aldiwan.net/poem17660.html","الوافر"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83284","الطويل"],[614,"","https://poetry.dctabudhabi.ae/diwan/poem/105269","الوافر"],[701,"","https://poetry.dctabudhabi.ae/diwan/poem/107332","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87244","الوافر"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54126","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54029","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48534","الوافر"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64987","المتقارب"],[1239,"","https://poetry.dctabudhabi.ae/diwan/poem/128278","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136177","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112824","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128718","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79989","الطويل"],[1845,"","https://poetry.dctabudhabi.ae/diwan/poem/132170","الوافر"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100447","الطويل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104816","المتقارب"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104769","الوافر"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48204","الوافر"],[2175,"","https://poetry.dctabudhabi.ae/diwan/poem/101271","الطويل"],[2216,"","https://poetry.dctabudhabi.ae/diwan/poem/100479","الطويل"],[2216,"","https://poetry.dctabudhabi.ae/diwan/poem/100482","المتقارب"],[2399,"","https://poetry.dctabudhabi.ae/diwan/poem/26607","الطويل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46744","الطويل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102553","الوافر"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113839","الطويل"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84475","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132748","السريع"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86328","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86276","الطويل"],[3612,"","https://poetry.dctabudhabi.ae/diwan/poem/76592","الطويل"],[3666,"","https://poetry.dctabudhabi.ae/diwan/poem/29378","الوافر"],[3784,"","https://poetry.dctabudhabi.ae/diwan/poem/18575","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103014","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146751","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133078","الطويل"],[4767,"إلى المنسوب","https://www.poetsgate.com/ViewPoem.aspx?id=179875",""],[4955,"رسول الله كم هامت حروفي","https://www.poetsgate.com/ViewPoem.aspx?id=203670",""],[4978,"مع إباء العرب","https://www.poetsgate.com/ViewPoem.aspx?id=177290",""],[5131,"مكانَكِ يا نفسُ لا تنطقي","https://www.poetsgate.com/ViewPoem.aspx?id=53814",""],[5442,"إذا البرق من تلقاء كاظمة عنا","https://www.poetsgate.com/ViewPoem.aspx?id=114776",""],[5830,"أَسَاحِرَةَ العُيُونِ","https://www.poetsgate.com/ViewPoem.aspx?id=201193",""],[6124,"ما لقلبك","https://www.poetsgate.com/ViewPoem.aspx?id=201228",""]],"verses":[["فَمَن وَرَدَ المَنِيَّةَ عَن وَفاةٍ","كَآخِرَ عاثِرِ العِرنَينِ دامِ",0,"م",1,0],["فَمَن وَجَدَ الطَريقَ إِلَيَّ صَعباً","فَقَد وَجَدَ الطَريقَ إِلَيكَ سَهلا",1,"ل",2,0],["فَمِن واجِدٍ قَد أَلزَمَ القَلبَ كَفَّهُ","وَمِن طَرَبٍ يَعلو اليَفاعَ وَيُشرِفُ",2,"ف",1,0],["فَمِن واصِفٍ شَوقاً وَمَن مُشتَكٍ حَشاً","رَمَتهُ المَرامي أَعيُنٌ وَخُدودُ",3,"د",1,0],["فَمِن وَطَنٍ إِلى وَطَنٍ","وَمِن أَهلٍ إِلى أَهلِ",4,"ل",1,0],["فَمِن والٍ يُلاطُ بِهِ فَتَخزى","رَعِيَّتُهُ وَمِن والٍ يَلوطُ",5,"ط",1,0],["فَمِن وَجهِكَ الضاحي إِلَينا بِبِشرِهِ","وَمِن يَدِكَ الجاري عَلَينا نَوالُها",6,"ل",3,0],["فَمِنْ وَاقِعٍ يَهْذِي وَآخَرَ ذاهِلٍ","لَهُ جَسَدٌ مَا فِيهِ رُوحٌ سِوَى الْخَمْرِ",7,"ر",1,0],["فَمِنْ وُثُوبٍ إلى وُثُوبِ","ومِن صُعُودٍ إلى صُعُودِ",8,"د",1,0],["فمن وصيفين تأتي","إلى وصيفين تأوي",9,"ا",3,0],["فمنوا على العبد الذليل بدعوةٍ","ينال بها حسن الختام مع الأرب",10,"ب",1,0],["فمنّوا بلقياكم وإلا فلا بقا","وريح الفنا تسفي علينا إذا سفا",11,"ف",2,0],["فمنوا بإهداء الجواب فليس لي","إِمام على الدنيا سواكم ولا قطب",12,"ب",1,0],["فمن وغدٍ يلاطفه أريب","ومن فَدْمٍ يصانعه نبيل",13,"ل",1,0],["فَمَنَّ وَأَعطاني الجَزيلَ وَإِنَّهُ","بِأَمثالِها رَحبُ الذِراعِ نَهوضُ",14,"ض",1,0],["فمن وردٍ له ذنبُ طويلٌ","يعقفه وملهوبٌ خلوقي",15,"ق",2,0],["فمَن وصَلتكَ صِلها ثم دَعها","إِلى أُخرى ولا تَلبث حَسيرا",16,"ر",2,0],["فَمِن وَجدِهِ هُوَ في دَهرِهِ","عَنِ العَذلِ في شُغُلٍ شاغِلِ",17,"ل",1,0],["فَمن وَجهِها في الكَأسِ يُبدي طَلاقَةً","إِلَيَّ وَمِن وَجهي يُقابِلُ تَعبيسا",18,"س",2,0],["فمنوا وجوداً باللقا وتعطفوا","وعودوا فإني فاقد وعديم",19,"م",1,0],["فمِنْ وَجهٍ تَقَرُّ به عُيوني","ومن رشفٍ أبُلُّ به أُوامي",20,"م",2,0],["فمُنُّوا علينا بعدها بزيارةٍ","بها العيش يصفو والحياة تطيبُ",21,"ب",1,0],["فمن وجنتك الوَرْدُ","ومن قامتك البان",22,"ن",1,0],["فمن ورد خديه ولامي عذاره","لقد بتُ أقرا شرح لامية الوردي",23,"د",2,0],["فمن وردٍ غَدا يُسقى","حياءً لا حَيا مُزْن",24,"ن",1,0],["فمن واكف دمعاً على صحن خده","ومن هاتك جيبا عليك ولاطم",25,"م",1,0],["فمنْ واقعٍ في الأرض في شبَكِ الرّدى","ومن طائرٍ عنه بأجنحةِ الغُرِّ",26,"ر",1,0],["فمن وردِ خدّك كيفَ النجاةُ","ومن غصن قدّك كيفَ السّلامه",27,"م",2,0],["فمِنْ وَلَهِي قَبَّلتُه وعضَضْتُه","فنمَّتْ عليه عضَّةٌ فوق خَدِّه",28,"د",2,0],["فَمَنْ وَافى يَعيبُ الشَّمْسَ يَوْماً","كَفاهُ على جَهَالتِهِ دَليلا",29,"ل",2,0],["فَمِن وَصفِهِ دَرَّ المَحامِدِ وَالثَنا","وَمِن نَوحُهُ دَرُّ الدموعِ السَواجِمِ",30,"م",1,0],["فمن والاه يوم غدير خم","فقد حاز الهدى وسما سعيدا",31,"د",2,0],["فَمن وليت عباد اللَه فارعهمُ","وراعهم واجتهد حتى تكون أَبا",32,"ب",2,0],["فَمن وَردٍ وَمِن وِردٍ","وَفاكِهَة وَمِن أَبِّ",33,"ب",1,0],["فمنوا علينا بالدنو وأسعفوا","بقربكم أهل الودادِ وأسعدوا",34,"د",3,0],["فمنوا بإحساني على قدر خدمتي","وخصوه لي منكم بفضلٍ ورجحانِ",35,"ن",1,0],["فمن وجد الفرار من العوالي","تَلَقَّته صدور الصافنات",36,"ت",1,0],["فَمُنُّوا بميعادِ لُقْياكمُ","لَعلِّي أَعيشُ بهذا التَّمنِّي",37,"ن",2,0],["فمن وهنت عن مورد العز نفسه","فإن عليه آسن الماء زائد",38,"د",1,0],["فمن والدي مفتي الحجاز محمد","تلقيت رشدي في صدوري وايرادي",39,"د",2,0],["فمنوا عليه بالوصال فانه","لبعدكموا ما طاب والبعد يذعر",40,"ر",1,0],["فمن وجد واعطف عليّ برأفة","فمن عادة السادات أن تترأفا",41,"ف",2,0],["فمن وجهك الهادي تروق بمنظرٍ","لها حسنٌ والحمد بالحسنِ يكسبُ",42,"ب",1,0],["فمن والاه نال هدى وفضلاً","ومن عاداه راح إلى عذاب",43,"ب",1,0],["فمن وجهه نور السعادة ساطع","ومن كفه ماء السماحة ناضح",44,"ح",1,0],["فَمُنُّوا بِطَيفِ الخَيَالِ أيا","أُحَيبَابَ قَلبى وَلَو فِى المَنام",45,"م",1,0],["فَمُنُّوا بالشُّهُودِ فَلى فُؤَادٌ","يُحِبُّ يَرَى وَيَشهَدُ ذا الجَنابا",46,"ب",2,0],["فمَنْ والاهُ أولاهُ نعيماً","ومن عاداهُ إِصْراراً أبادَهْ",47,"د",2,0],["فمنوا على جسم تمرض فيكم","بعافية وفراء فضفاضة البرد",48,"د",1,0],["فمنوا على الخل الوفي بنظرةٍ","أسر بها يوماً وإن وقعت شزرا",49,"ر",2,0],["فمنوا على خلكم بالوصال","فجسمي عليكم نحيف عليل",50,"ل",1,0],["فَمَن وَبِمَن نَستَدفِعُ الضَيمَ بَعدَهُ","وَقَد صَمَّمَت فينا الخُطوبُ النَوازِلُ",51,"ل",1,0],["فَمَنَّ وَمنّاهُم رِجالٌ رأَيتُهُم","إِذا ضارسوني يكرهونَ قِراني",52,"ن",2,0],["فمن والاك نال بك المعالي","ومن عاداك أضحى في تلاف",53,"ف",1,0],["فمن وجهه تبدو السماحة للورى","ومن كفه للناس أمن من الفقر",54,"ر",1,0],["فمن وَصفها حادي السُرى يَستَعيرها","بسطنا أَكف الابتهال لربها",55,"ه",2,0],["فمن وقى بالنفس أوطانه","كان جديراً بالوسام المزان",56,"ن",1,0],["فَمَنوا بِحل يا ذَوي الفَضلِ وَالنهى","وَفوزوا من الخل الوَدودِ بِشُكران",57,"ن",1,0],["فَمُنّوا عَلى بَكرٍ بِحُسن قُبولِها","فَمن اهلِ فَضلِ مِثلِكُم نُكرَم بالبكر",58,"ر",1,0],["فَمُنُّوا بِتَوديعِ المسافِر وَاسمَحُوا","بِقُبلَةِ كَفٍّ مِنكُمُ فَهوَ زادُهُ",59,"د",2,0],["فمن ورِث الغنى فليصطنعه","صنيعته ويجهد كل جهدِ",60,"د",1,1],["فَمِن والِغٍ حَصداءَ جِلدَةَ ظَهرِهِ","وَمِن ناهِشٍ أَدفى الجَناحَينِ أَقرَعا",61,"ع",2,0],["فمن ورق على ورق تغني","ومن طلّ على روض جميم",62,"م",1,0],["فمن وجهه اندفعوا بالثبور","إلى النهر والتجأوا للصخور",63,"ر",1,0],["فمن واقف في جفنه الدمع واقف","ومن سائل في خده الدمع سائل",64,"ل",1,0],["فمنوا بنيل السول والقرب والرضا","لتبرى من القلب الحزين قروح",65,"ح",1,0],["فمن ولاكمُ بالخلقِ حتى","من الأشرار نصبتم أميرا",66,"ر",2,0],["فمن والاكَ نال البِشرَ حتمًا","ومن عاداك لا مانال فخرا",67,"ر",2,0],["فمن وطني الشآم إلى بلادٍ","بها استوطنت لكن لست أبرا",68,"ر",2,0],["فمنْ وطنٍ بيعَ للسامري","وآخر أعُطيَ للأخرق",69,"ق",1,0],["فمن واقف يثني عليه بجهده","ويعلم أن الأمر غضعاف ما أثنى",70,"ن",2,0],["فَمَنْ وَفَّىَ المَحَبَّةَ مِلْءَ كَأْسٍ","سَيَجْنِي الصَّابَ شُؤْماً وَ القَتَادَا",71,"د",2,0],["فَمِنْ وِكْرِ عِطْرٍ إِلَى زَهْرَةٍ","يُقَضِّي اللَّيَالِي وَمَوَّالَهُ",72,"ل",2,0]]}