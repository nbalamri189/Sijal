466,"","https://poetry.dctabudhabi.ae/diwan/poem/66140","الكامل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104893","البسيط"],[4701,"لارا","https://www.poetsgate.com/ViewPoem.aspx?id=176662",""],[4852,"بعض المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=216002",""],[4862,"إلى راحلة","https://www.poetsgate.com/ViewPoem.aspx?id=55519",""],[4927,"غُرْبَةُ الْعِشْقِ","https://www.poetsgate.com/ViewPoem.aspx?id=29651",""],[4956,"حي يعزّيه ميت","https://www.poetsgate.com/ViewPoem.aspx?id=1397",""],[4980,"هل راقكَ الشّوق","https://www.poetsgate.com/ViewPoem.aspx?id=193471",""],[3271,"وطن الفأس","https://www.poetsgate.com/ViewPoem.aspx?id=104126",""],[5074,"شوق واعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=153919",""],[5074,"ضيعتي في اللَّيل","https://www.poetsgate.com/ViewPoem.aspx?id=153951",""],[5106,"لا تَقُلْ لِيْ قَدْ تَعِبْنَاْ","https://www.poetsgate.com/ViewPoem.aspx?id=150039",""],[5135,"قلوب متحجرة","https://www.poetsgate.com/ViewPoem.aspx?id=202533",""],[5136,"يا بدر تم وجهه","https://www.poetsgate.com/ViewPoem.aspx?id=121613",""],[5147,"هل ربع ذاك الحي يدري","https://www.poetsgate.com/ViewPoem.aspx?id=166707",""],[5174,"لغة الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=199065",""],[5283,"هل أُمْسِكُ الماء","https://www.poetsgate.com/ViewPoem.aspx?id=207580",""],[5302,"شعري","https://www.poetsgate.com/ViewPoem.aspx?id=201746",""],[5324,"بغداد مشفقة على أعدائها .","https://www.poetsgate.com/ViewPoem.aspx?id=207568",""],[5376,"قد شتَّت الدهرُ قلباً كان ماكانا","https://www.poetsgate.com/ViewPoem.aspx?id=191852",""],[5409,"حدثينا يا فرنسا","https://www.poetsgate.com/ViewPoem.aspx?id=155283",""],[5559,"من يرد للقدس نصرا","https://www.poetsgate.com/ViewPoem.aspx?id=204217",""],[5589,"بيني وبينك","https://www.poetsgate.com/ViewPoem.aspx?id=187983",""],[5628,"لست شاكيا","https://www.poetsgate.com/ViewPoem.aspx?id=178488",""],[5691,"بوم وغربان","https://www.poetsgate.com/ViewPoem.aspx?id=205929",""],[5725,"جحر ضب","https://www.poetsgate.com/ViewPoem.aspx?id=187234",""],[5736,"احتضار","https://www.poetsgate.com/ViewPoem.aspx?id=208862",""],[5939,"استبداد","https://www.poetsgate.com/ViewPoem.aspx?id=178595",""],[5956,"عَالَمِيّا الروح","https://www.poetsgate.com/ViewPoem.aspx?id=182113",""],[5956,"صرخة أهل فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=192087",""],[5956,"إني لَأجثو فوق قبرك شاكراً","https://www.poetsgate.com/ViewPoem.aspx?id=193484",""],[5989,"ما كنتُ بدعاً من العاشقين","https://www.poetsgate.com/ViewPoem.aspx?id=183969",""],[6082,"اكتبي يا أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=59114",""]],"verses":[["هَل رُوِّضَت قاعَةُ الوَعساءِ أَم مُطِرَت","خَميلَةُ الطَلحِ ذاتِ البانِ وَالغارِ",0,"ر",1,0],["هَل رَيعَ قَلبُكَ لِلخَليطِ المُنجِدِ","بِلَوى البُراقِ تَزايَلوا عَن مَوعِدي",1,"د",2,1],["هَل رَأَيتُم تِلكَ النُقوشَ اللَواتي","أَعَجَزَت طَوقَ صَنعَةِ المُتَحَدّي",2,"د",2,0],["هَل رَأَيتُم مُوَفَّقاً كَعَلِيٍّ","في الأَطِبّاءِ يَستَحِقُّ الثَناءَ",3,"ا",2,1],["هَل راكِبٌ ذاهِبٌ عَنهُم يُحَيِّيني","إِذ لا كِتابَ يُوافيني فَيُحيِيني",4,"ن",2,1],["هَلْ رَدَّدَتْ نَدْوَةٌ ذِكْرَى مَآثِرَهُ","إِلاَّ وَقَدْ أَخَذَتْهَا هَزَّةُ الطَّرَبِ",5,"ب",1,0],["هَلْ رُحْتَ تَسْتَبِقُ المَرَاحِلَ فِي","دُنْيَاكَ حَتَّى حَانَ أَبْعَدُهَا",6,"د",3,0],["هَل رامَ جَوُّ سُوَيقَتَينِ مَكانَهُ","أَو حَلَّ بَعدَ مَحَلِّنا البُردانِ",7,"ن",1,0],["هَل رامَ بَعدَ مَحَلِّنا رَوضُ القَطا","فَرُوَيَّتانِ إِلى غَديرِ الخانِقِ",8,"ق",1,0],["هَل رامَ أَم لَم يَرِم ذو السِدرِ فَالثَلَمُ","ذاكَ الهَوى مِنكَ لا دانٍ وَلا أَمَمُ",9,"م",1,1],["هَل رَسمُ دارِسَةِ المَقامِ يَبابِ","مُتَكَلِّمٌ لِمُسائِلٍ بِجَوابِ",10,"ب",1,1],["هل رأى منك قبيحاً بثه","أم رأى منك جميلاً دفنه",11,"ن",2,0],["هل رآه اللَّه أجرى ذمَّكم","ببيانٍ أو بلحن لحنه",11,"ن",2,0],["هل رآه الفَحْصُ قِرناً لكُمُ","ببِرازٍ أو كُمونٍ كَمنه",11,"ن",2,0],["هَل راعَكُم أَنَّ المَدا","رِسَ في الكِنانَةِ خاوِيَه",12,"ي",2,0],["هَل رَجَعتُنَّ في الحَياةِ لِفَهمٍ","إِنَّ فَهمَ الأُمورِ نِصفُ السَدادِ",13,"د",1,0],["هل رغبةٌ لك عندَنا","في الطوطماج مع القطائفْ",14,"ف",1,0],["هَل رَكبُ مَكَّةَ حامِلونَ تَحِيَّةً","تُهدى إِلَيها مِن مُعَنّىً مُغرَمِ",15,"م",1,0],["هل رأى الحب سكارى مثلنا","كم بنينا من خيالٍ حولنا",16,"ن",2,0],["هَل رَأَيتَ الرَكبَ أَو أَب","صَرتَ بِالقاعِ هُجوعا",17,"ع",2,0],["هل رأى الألواحَ فاستهدَى بما","جاءَ فيها مِن عظاتٍ وحِكَمْ",18,"م",1,0],["هل رأيتم أمّةً تحيا على","ما تُلاقون حياةَ الآمنينْ",19,"ن",1,0],["هل رعى السَّيفُ دماً من عابثٍ","ناكثٍ من كل عهدٍ ما عقدْ",20,"د",1,0],["هَل رَأَيت الرَوض أَيام الخَريف","ذابلَ الأَزهار مَسلوب الحَفيف",21,"ف",1,0],["هَل رَأَيت الطَير في الرَوض يُدور","هائِماً يَبحَث عَن عَهد السُرور",21,"ر",1,0],["هَل رَأَيتَ الدِيارَ رَدَّت جَواباً","وَأَجابَت لِذي سُؤالٍ سُؤولا",22,"ل",2,0],["هل رُحْتَ في إغماءةٍ","أم بالمخدِّر قد حُقِنْتْ",23,"ت",1,0],["هَلْ رَأَى الشَّرْقُ مُنْذُ كَانَتْ بِهِ الأَ","عْيادُ عِيداً أَزْهَى ضِياءً وَأَنْدَى",24,"د",2,0],["هلْ رَاعَكُمْ مِنْ طَلْعَتٍ وَبَيانِهِ","نُطْقُ السكُوتِ وَحُسْنُ مَا هُوَ نَالِي",25,"ل",2,0],["هَلْ رَأَيْتُمْ مَجْداً كَإِقْرَارِ أَحْرَا","رٍ كِبَارٍ بِفضْلِ حُرٍ كَبِيرِ",26,"ر",1,0],["هَلْ رَأَيْتُمْ أَبَرًّ مِنْهُ وَلِيّاً","لأَماني أَهْلِهِ يَتَفَقَّدْ",27,"د",1,0],["هل رأيت النجوم تزداد نوراً","كلما احلولك الدجى وفتونا",28,"ن",2,0],["هَل رَأَيتَ الصِبا يَجي","ءُ بِحِلمِ التَشَيُّخِ",29,"خ",1,0],["هلْ رأيتَ النَّجْمَ الذي يَبْهَرُ","العَيْنَ ويَمْحُو دَيَاجِرَ الظُّلماتِ",30,"ت",1,0],["هل رأيتَ الغَديِرَ يَنْسَابُ في","القَفْرِ فَيهْتَزُّ مُخْصِبَ الْجَنَبَاتِ",30,"ت",1,0],["هل رأيتَ الْحَياة تَسْرِي إِلى الجِسْمِ","فتُحْيِي عِظَامَه النَّخِرَاتِ",30,"ت",1,0],["هل رأيتَ الآمالَ بَعْد نِفَارٍ","واقْتبالَ الشَّبَابِ بَعْدَ فَواتِ",30,"ت",1,0],["هل رأيتم دَوْحَةً مثمرةً","كلَّ آن في صباحٍ أو مَساء",31,"ا",2,0],["هل رام شكرَ الميْت من","أسدى إلى ميت يدا؟",32,"د",2,0],["هل رأيتينّ يحصبا أو عسيرا ؟","كان عندي هناك أهل وجيره",33,"ر",2,0],["هل رايةُ الوطنِ المفجوعِ عالمةٌ","على مَن اشتملتْ والمِدفَع الضَخِم",34,"م",1,0],["هل رأيتَ الركبَ، أوْ","صَرْتَ بالقاع هُجوعا",35,"ع",2,0],["هل رأت هذه الخمائل فبلي","من رآها عينا وثغرا وخدّا",36,"د",2,0],["هلْ رسمُ دارسة ِ المقامِ، يبابِ","متكلكٌ لمسائلٍ بجوابِ",37,"ب",1,1],["هل رأَيتُم نسق الحا","لِ على هذا الوّلاءِ",38,"ل",3,0],["هل رأيتم ورقاء هامت بنسر","وسمعتم بوكره نجواها",39,"ا",3,0],["هل رَأت وجوهَهُمُ","في سَمائِها الشُهُب",40,"ب",1,0],["هَل رَأَيتَ من ذَهَبوا","قافِلينَ لا ذَهبوا",40,"ب",3,0],["هل رَأَيتَ الوردَ النَضير على الغُص","نِ تَحَلّى بِلُؤلُؤ الأَنداءِ",41,"ا",2,0],["هل روحُ أحمدَ تُلظي قلبَ أمتهِ","لكي نؤجِّجَ ناراً دونَ ملجاك",42,"ك",1,0],["هل رووا علما عن العلم","أَم رأوا سَلمى بذي سلم",43,"م",1,0],["هل رأَيتَ النارَ يعلوها دخانٌ","أَبيضٌ والشمسُ يغشاها ضبابُ",44,"ب",1,0],["هل رأت مقلتاك قط سناه","في بدور أو عطفه في غصون",45,"ن",1,0],["هل رأى العيدُ قَطُّ قبلَك مَولىً","كُلُّ معنىً في جودِه مَوْجود",46,"د",1,0],["هَل رَأَيتَ النجومَ أَغنَت عَن المَأ","مونِ في عزِّ مُلكِهِ المَأسوسِ",47,"س",1,0],["هل رأيتم سُفُنَ الخيرِ التي","نالها البغيُ وأنتم تنظرون؟",48,"ن",1,0],["هل رَعَتْ قبلَه الحسانُ عهوداً","أم وَفَتْ قبلَه الملاحُ ضمانا",49,"ن",2,0],["هل رجعةٌ لرؤىً كنا نُغازلها","وكنتَ تنفحها عَرفا وتغذوها",50,"و",3,0],["هل رفدُ ذاتِ الطوق يوماً عائدٌ","بسوى الخديعةِ من سحابٍ عابرِ",51,"ر",1,0],["هل راكبٌ وضَمِنَتْ حاجتَهُ","غضبَى القِماصِ سَمحةُ القيادِ",52,"د",1,0],["هل رأيتُم من ادّعى أنّني با","بٌ لأخرى منه يكونُ العبورُ؟",53,"ر",1,0],["هل رَأيتُم مِنَ الغُصُونِ طُيوراً","هل رَأَيتم مِنَ الطُّورِ غُصُونَأ",54,"ن",2,0],["هل رأينا مذ عهد آدم بكراً","ذات عهدٍ مع من يديم الوفاءَ",55,"ا",2,0],["هلْ رأيتِ العيونَ تصعَدُ للهِ","وتُلقي دمُوعَها فِي يَديِّهِ",56,"ي",2,0],["هَلْ رَأيْتمُ نَجْمَهُ طَلَعا","أَمْ تَرَاءى البَدْرُ أَوْ سَطَعا",57,"ا",1,0],["هل رأيتم في عنادٍ مثلَه","كُلَّمَا قاربتُ منْهُ احْتَجبَا",58,"ب",2,0],["هل رحمة منها لصب لم يزل","يصلى بنار الشوق والحسرَات",59,"ت",1,0],["هَلْ رَامَ تَقْبِيلَ اللَّمَى","أوْ أنْ يُرَشَّفَ سَلْسَلَهْ",60,"ل",2,0],["هَل رأيتَ الحيَّ ساروا جملةً","أَم همُ ساروا شعاعاً وبدَد",61,"د",1,0],["هل رأت مقلتاك روح الله","في دجى الليل ماثلا في الهضاب",62,"ب",1,0],["هل رأيت الزمان يرمي سهاماً","مجهزات وهل عداني الرماء",63,"ا",2,0],["هل رابه غيرها وقد جعل ال","ماء طهوراً لكل مغتسل",64,"ل",1,0],["هل رأيتم يا قوم منطوق شيء","هو مفهومه على كل حال",65,"ل",1,0],["هَل رأيتم أَو سمعتم حسنا","في الوَرى من حسنه الحسن اِكتَمَل",66,"ل",1,0],["هَل رمحك المَهموز إِلا ابرةٌ","أَمن الطَعين بِها مِن الأَدماء",67,"ا",2,0],["هل رأى يوماً بروضته","وأرى قلبي رما الحَزنا",68,"ن",2,0],["هل راجع منك وقت مر حين حلا","أحيا فؤادي المعنى من تفانيه",69,"ي",2,0],["هَل رَجعَةٌ لِمَقامِهِ","أَو وَقفَةٌ لِسَلاَمِهِ",70,"ه",1,0],["هل راحميرحم الطفل الرضيع فقد","جف الرضاع وما للطفل مصطبر",71,"ر",1,0],["هَل رَأَيتُم يا سادَتي أَو سَمِعتُم","أَنَّ ضِدَّينِ قَطُّ يَجتَمِعانِ",72,"ن",1,0],["هَل رَأَيتَ البَيتَ في مِص","رَ عَلَيهِ المَجدُ حام",73,"م",1,0],["هَل رَأَت عَيناكَ أَبهى صورَةً","عمركَ اللَهُ وَأَحلى مَنظَرا",74,"ر",2,0],["هَل رُفِعَت في كَرم رايَةٌ","قَصَّرَ عَن إِدراكِها باعي",75,"ي",1,0],["هل رأيت النجوم اغنت عن المأ","مون شيئاً وملكه المأسوس",76,"س",1,1],["هل رشفةٌ منك وهل لي قُبْلَةٌ","من ذلك الثَّغرِ وذاك الخدّ",77,"د",1,0],["هل راحمٌ صبّاً أذابَ فُؤادَه","دَهرٌ ألَحَّ لصَرفِه لم يَصرِفِ",78,"ف",1,0],["هل رسول وكيف لي برسول","إن ليلي إن نمت جد طويل",79,"ل",1,1],["هل رسول إلى أخي وشقيقي","ليت اني مكان ذاك الرسول",79,"ل",1,0],["هل راجع عصر مضى لسبيله","في دارة الأفراح دارة رفرف",80,"ف",1,0],["هل ربّ يقصد يا إله غيرك","فنقصده في كلّ ما طلبنا",81,"ن",2,0],["هل رام نَهى حمامتين مكانَه","أم هل تَغَيرَّ بعدنا الأحفارُ",82,"ر",1,1],["هل ربيع وقد رحلت ربيعي","ام مصيفي وقد نزحت مصيفي",83,"ف",2,0],["هل رأيت الوكر أم قد هدما","وغدا سكانه تحت الرموس",84,"س",1,0],["هل رأيتم بعد موسى","أحداً فجّر صخرهْ",85,"ر",2,0],["هَلْ رُبَّمَا مُدَّتِ الآهَاتُ أَعْمِدَةً","حَتَّى أَنُوْءَ بِجُرْحِ القَبْرِ مِنْ إِرَمِ",86,"م",1,0],["هَل رَأيتُم مَدى الزَمان خُدوداً","مِن ورود وَجنة مِن طيب",87,"ب",1,0],["هل ريع سعد وهل خارت عزيمته","أم هل نعى مصر الحادث النكر",88,"ر",1,0],["هل رأيتِ المرأةَ تحملُ قيداً","أم رأيتِ الخَلخَالَ زان الرِّجالا",89,"ل",2,0],["هل رجنا منك قبلة كم تمناها","فؤادي من ثغرك المعسول",90,"ل",1