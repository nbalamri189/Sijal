{"poems":[[53,"يا قلب ما أنت من نجد وساكنه","https://www.aldiwan.net/poem30428.html","البسيط"],[53,"هل ريع قلبك للخليط المنجد","https://www.aldiwan.net/poem30612.html","الكامل"],[86,"وقف الخلق ينظرون جميعاً","https://www.aldiwan.net/poem10675.html","الخفيف"],[86,"هل رأيتم موفقا كعلي","https://www.aldiwan.net/poem68934.html","الخفيف"],[73,"هل راكب ذاهب عنهم يحييني","https://www.aldiwan.net/poem11849.html","البسيط"],[93,"صوت الكنانة في يوبيلك الذهبي","https://www.aldiwan.net/poem9800.html","عموديه"],[93,"هانت معالم مات سيدها","https://www.aldiwan.net/poem11139.html","أحذ الكامل"],[27,"لمن الديار ببرقة الروحان","https://www.aldiwan.net/poem4448.html","الكامل"],[27,"أسرى لخالدة الخيال ولا أرى","https://www.aldiwan.net/poem5935.html","الكامل"],[27,"هل رام أم لم يرم ذو السدر فالثلم","https://www.aldiwan.net/poem5990.html","البسيط"],[23,"هل رسم دارسة المقام يباب","https://www.aldiwan.net/poem21246.html","الكامل"],[51,"إنما يبكي شجي شجنه","https://www.aldiwan.net/poem66464.html","الرمل"],[85,"قف حي شبان الحمى","https://www.aldiwan.net/poem8085.html","مجزوء الكامل"],[85,"كل حي على المنية غادي","https://www.aldiwan.net/poem62901.html","الخفيف"],[62,"يا من خلائقه لطائف","https://www.aldiwan.net/poem52336.html","مجزوء الكامل"],[45,"هذي المعاهد من سعاد فسلم","https://www.aldiwan.net/poem66637.html","البسيط"],[97,"حان حرماني وناداني النذير","https://www.aldiwan.net/poem24787.html","الرمل"],[31,"علق القلب وزوعا","https://www.aldiwan.net/poem42235.html","مجزوء الرمل"],[105,"في حمى الحق ومن حول الحرم","https://www.aldiwan.net/poem42091.html","الرمل"],[105,"يا وفود النيل ترتج القرى","https://www.aldiwan.net/poem43055.html","الرمل"],[105,"أقبلوا أو فاتقوا سوء المرد","https://www.aldiwan.net/poem44205.html","الرمل"],[102,"لا تقل لله لبنان الأشم","https://www.aldiwan.net/poem32913.html","الرمل"],[48,"انس رسم الديار ثم الطلولا","https://www.aldiwan.net/poem64509.html","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39617","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54716","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55197","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54889","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54781","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141979","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43691","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54320","الرمل"],[106,"شكر عارفة","https://www.poetsgate.com/ViewPoem.aspx?id=179475",""],[100,"مسافرة بلا مهمة","https://www.poetsgate.com/ViewPoem.aspx?id=50437",""],[90,"في الأربعين","https://www.poetsgate.com/ViewPoem.aspx?id=179041",""],[31,"عُلِّقَ القَلْبُ وزُوعَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18950&r=&rc=213",""],[94,"من كسعد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66301&r=&rc=19",""],[23,"هلْ رسمُ دارسة ِ المقامِ، يبابِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=12798&r=&rc=2",""],[167,"أف من دهر رآني","https://www.aldiwan.net/poem47137.html","مجزوء الرمل"],[198,"غادة حطم الفؤاد بكاها","https://www.aldiwan.net/poem39820.html","الخفيف"],[226,"كم تهيم كم تجب","https://www.aldiwan.net/poem55209.html","المقتضب"],[226,"أطلع الكاس كوكبا في ازدهاء","https://www.aldiwan.net/poem55244.html","الطويل"],[271,"حبي الخليفة مولانا ومولاك","https://www.aldiwan.net/poem35652.html","البسيط"],[272,"قف بذات السفح من اضم","https://www.aldiwan.net/poem52088.html","المديد"],[299,"لو رأيت الكأس والوجه الصبيحا","https://www.aldiwan.net/poem36853.html","عموديه"],[304,"يا عذولي إذا بدا وتثنى","https://www.aldiwan.net/poem58083.html","الخفيف"],[365,"أنت للعيد وهو للناس عيد","https://www.aldiwan.net/poem60931.html","الخفيف"],[394,"أيها الجالس المفكر في الأم","https://www.aldiwan.net/poem53520.html","الخفيف"],[401,"حداء على أسطول الحرية","https://www.aldiwan.net/poem6743.html","عموديه"],[417,"قال لي صاحبي ونحن بسلع","https://www.aldiwan.net/poem53832.html","الخفيف"],[454,"ما اسكندر اليازجي اليوم أعرفه","https://www.aldiwan.net/poem61793.html","البسيط"],[459,"الليل بعد اليأس أطمع ناظري","https://www.aldiwan.net/poem56175.html","الكامل"],[459,"حرم عليها نزهات الوادي","https://www.aldiwan.net/poem56222.html","البسيط"],[506,"نحن لا نكذب ولكن نتجمّل","https://www.aldiwan.net/poem27793.html","الخفيف"],[539,"قد أثرتم لواعجا وشجونا","https://www.aldiwan.net/poem47587.html","عموديه"]],"verses":[["هَل رُوِّضَت قاعَةُ الوَعساءِ أَم مُطِرَت","خَميلَةُ الطَلحِ ذاتِ البانِ وَالغارِ",0,"ر",1,0],["هَل رَيعَ قَلبُكَ لِلخَليطِ المُنجِدِ","بِلَوى البُراقِ تَزايَلوا عَن مَوعِدي",1,"د",2,1],["هَل رَأَيتُم تِلكَ النُقوشَ اللَواتي","أَعَجَزَت طَوقَ صَنعَةِ المُتَحَدّي",2,"د",2,0],["هَل رَأَيتُم مُوَفَّقاً كَعَلِيٍّ","في الأَطِبّاءِ يَستَحِقُّ الثَناءَ",3,"ا",2,1],["هَل راكِبٌ ذاهِبٌ عَنهُم يُحَيِّيني","إِذ لا كِتابَ يُوافيني فَيُحيِيني",4,"ن",2,1],["هَلْ رَدَّدَتْ نَدْوَةٌ ذِكْرَى مَآثِرَهُ","إِلاَّ وَقَدْ أَخَذَتْهَا هَزَّةُ الطَّرَبِ",5,"ب",1,0],["هَلْ رُحْتَ تَسْتَبِقُ المَرَاحِلَ فِي","دُنْيَاكَ حَتَّى حَانَ أَبْعَدُهَا",6,"د",3,0],["هَل رامَ جَوُّ سُوَيقَتَينِ مَكانَهُ","أَو حَلَّ بَعدَ مَحَلِّنا البُردانِ",7,"ن",1,0],["هَل رامَ بَعدَ مَحَلِّنا رَوضُ القَطا","فَرُوَيَّتانِ إِلى غَديرِ الخانِقِ",8,"ق",1,0],["هَل رامَ أَم لَم يَرِم ذو السِدرِ فَالثَلَمُ","ذاكَ الهَوى مِنكَ لا دانٍ وَلا أَمَمُ",9,"م",1,1],["هَل رَسمُ دارِسَةِ المَقامِ يَبابِ","مُتَكَلِّمٌ لِمُسائِلٍ بِجَوابِ",10,"ب",1,1],["هل رأى منك قبيحاً بثه","أم رأى منك جميلاً دفنه",11,"ن",2,0],["هل رآه اللَّه أجرى ذمَّكم","ببيانٍ أو بلحن لحنه",11,"ن",2,0],["هل رآه الفَحْصُ قِرناً لكُمُ","ببِرازٍ أو كُمونٍ كَمنه",11,"ن",2,0],["هَل راعَكُم أَنَّ المَدا","رِسَ في الكِنانَةِ خاوِيَه",12,"ي",2,0],["هَل رَجَعتُنَّ في الحَياةِ لِفَهمٍ","إِنَّ فَهمَ الأُمورِ نِصفُ السَدادِ",13,"د",1,0],["هل رغبةٌ لك عندَنا","في الطوطماج مع القطائفْ",14,"ف",1,0],["هَل رَكبُ مَكَّةَ حامِلونَ تَحِيَّةً","تُهدى إِلَيها مِن مُعَنّىً مُغرَمِ",15,"م",1,0],["هل رأى الحب سكارى مثلنا","كم بنينا من خيالٍ حولنا",16,"ن",2,0],["هَل رَأَيتَ الرَكبَ أَو أَب","صَرتَ بِالقاعِ هُجوعا",17,"ع",2,0],["هل رأى الألواحَ فاستهدَى بما","جاءَ فيها مِن عظاتٍ وحِكَمْ",18,"م",1,0],["هل رأيتم أمّةً تحيا على","ما تُلاقون حياةَ الآمنينْ",19,"ن",1,0],["هل رعى السَّيفُ دماً من عابثٍ","ناكثٍ من كل عهدٍ ما عقدْ",20,"د",1,0],["هَل رَأَيت الرَوض أَيام الخَريف","ذابلَ الأَزهار مَسلوب الحَفيف",21,"ف",1,0],["هَل رَأَيت الطَير في الرَوض يُدور","هائِماً يَبحَث عَن عَهد السُرور",21,"ر",1,0],["هَل رَأَيتَ الدِيارَ رَدَّت جَواباً","وَأَجابَت لِذي سُؤالٍ سُؤولا",22,"ل",2,0],["هل رُحْتَ في إغماءةٍ","أم بالمخدِّر قد حُقِنْتْ",23,"ت",1,0],["هَلْ رَأَى الشَّرْقُ مُنْذُ كَانَتْ بِهِ الأَ","عْيادُ عِيداً أَزْهَى ضِياءً وَأَنْدَى",24,"د",2,0],["هلْ رَاعَكُمْ مِنْ طَلْعَتٍ وَبَيانِهِ","نُطْقُ السكُوتِ وَحُسْنُ مَا هُوَ نَالِي",25,"ل",2,0],["هَلْ رَأَيْتُمْ مَجْداً كَإِقْرَارِ أَحْرَا","رٍ كِبَارٍ بِفضْلِ حُرٍ كَبِيرِ",26,"ر",1,0],["هَلْ رَأَيْتُمْ أَبَرًّ مِنْهُ وَلِيّاً","لأَماني أَهْلِهِ يَتَفَقَّدْ",27,"د",1,0],["هل رأيت النجوم تزداد نوراً","كلما احلولك الدجى وفتونا",28,"ن",2,0],["هَل رَأَيتَ الصِبا يَجي","ءُ بِحِلمِ التَشَيُّخِ",29,"خ",1,0],["هلْ رأيتَ النَّجْمَ الذي يَبْهَرُ","العَيْنَ ويَمْحُو دَيَاجِرَ الظُّلماتِ",30,"ت",1,0],["هل رأيتَ الغَديِرَ يَنْسَابُ في","القَفْرِ فَيهْتَزُّ مُخْصِبَ الْجَنَبَاتِ",30,"ت",1,0],["هل رأيتَ الْحَياة تَسْرِي إِلى الجِسْمِ","فتُحْيِي عِظَامَه النَّخِرَاتِ",30,"ت",1,0],["هل رأيتَ الآمالَ بَعْد نِفَارٍ","واقْتبالَ الشَّبَابِ بَعْدَ فَواتِ",30,"ت",1,0],["هل رأيتم دَوْحَةً مثمرةً","كلَّ آن في صباحٍ أو مَساء",31,"ا",2,0],["هل رام شكرَ الميْت من","أسدى إلى ميت يدا؟",32,"د",2,0],["هل رأيتينّ يحصبا أو عسيرا ؟","كان عندي هناك أهل وجيره",33,"ر",2,0],["هل رايةُ الوطنِ المفجوعِ عالمةٌ","على مَن اشتملتْ والمِدفَع الضَخِم",34,"م",1,0],["هل رأيتَ الركبَ، أوْ","صَرْتَ بالقاع هُجوعا",35,"ع",2,0],["هل رأت هذه الخمائل فبلي","من رآها عينا وثغرا وخدّا",36,"د",2,0],["هلْ رسمُ دارسة ِ المقامِ، يبابِ","متكلكٌ لمسائلٍ بجوابِ",37,"ب",1,1],["هل رأَيتُم نسق الحا","لِ على هذا الوّلاءِ",38,"ل",3,0],["هل رأيتم ورقاء هامت بنسر","وسمعتم بوكره نجواها",39,"ا",3,0],["هل رَأت وجوهَهُمُ","في سَمائِها الشُهُب",40,"ب",1,0],["هَل رَأَيتَ من ذَهَبوا","قافِلينَ لا ذَهبوا",40,"ب",3,0],["هل رَأَيتَ الوردَ النَضير على الغُص","نِ تَحَلّى بِلُؤلُؤ الأَنداءِ",41,"ا",2,0],["هل روحُ أحمدَ تُلظي قلبَ أمتهِ","لكي نؤجِّجَ ناراً دونَ ملجاك",42,"ك",1,0],["هل رووا علما عن العلم","أَم رأوا سَلمى بذي سلم",43,"م",1,0],["هل رأَيتَ النارَ يعلوها دخانٌ","أَبيضٌ والشمسُ يغشاها ضبابُ",44,"ب",1,0],["هل رأت مقلتاك قط سناه","في بدور أو عطفه في غصون",45,"ن",1,0],["هل رأى العيدُ قَطُّ قبلَك مَولىً","كُلُّ معنىً في جودِه مَوْجود",46,"د",1,0],["هَل رَأَيتَ النجومَ أَغنَت عَن المَأ","مونِ في عزِّ مُلكِهِ المَأسوسِ",47,"س",1,0],["هل رأيتم سُفُنَ الخيرِ التي","نالها البغيُ وأنتم تنظرون؟",48,"ن",1,0],["هل رَعَتْ قبلَه الحسانُ عهوداً","أم وَفَتْ قبلَه الملاحُ ضمانا",49,"ن",2,0],["هل رجعةٌ لرؤىً كنا نُغازلها","وكنتَ تنفحها عَرفا وتغذوها",50,"و",3,0],["هل رفدُ ذاتِ الطوق يوماً عائدٌ","بسوى الخديعةِ من سحابٍ عابرِ",51,"ر",1,0],["هل راكبٌ وضَمِنَتْ حاجتَهُ","غضبَى القِماصِ سَمحةُ القيادِ",52,"د",1,0],["هل رأيتُم من ادّعى أنّني با","بٌ لأخرى منه يكونُ العبورُ؟",53,"ر",1,0],["هل رَأيتُم مِنَ الغُصُونِ طُيوراً","هل رَأَيتم مِنَ الطُّورِ غُصُونَأ",54,"ن",2,0]]}