{"poems":[[88,"إيه يا ليل هل شهدت المصابا","https://www.aldiwan.net/poem10378.html","الخفيف"],[95,"لينتشر بعد طي ذلك العلم","https://www.aldiwan.net/poem11332.html","البسيط"],[56,"إن أبا سعد على مجونه","https://www.aldiwan.net/poem27453.html","الرجز"],[90,"هذي بلودان وذا نزلها","https://www.aldiwan.net/poem44394.html","الخفيف"],[53,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[53,"يبتُ أخو البلوى إذا الخلو غمضا","https://www.aldiwan.net/poem64946.html","الطويل"],[53,"إني إذا ما الخصم في الغي ابترك","https://www.aldiwan.net/poem65823.html","الرجز"],[31,"محا رسم دار بالصريمة مسبل","https://www.aldiwan.net/poem6164.html","الطويل"],[40,"يبتن سجودا من نهيت مصدر","https://www.aldiwan.net/poem7738.html","الطويل"],[91,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[91,"اغتنم كل فرصة في الحياة","https://www.aldiwan.net/poem44633.html","الخفيف"],[47,"كيف به والزمان يهرب به","https://www.aldiwan.net/poem10913.html","المنسرح"],[47,"شط من ساكن الغوير مزاره","https://www.aldiwan.net/poem63580.html","الخفيف"],[47,"بالله أولي يمينا برة قسما","https://www.aldiwan.net/poem65683.html","البسيط"],[68,"هكذا إن بنى المنازل بان","https://www.aldiwan.net/poem40973.html","الخفيف"],[89,"كم غادر الشعراء من متردم","https://www.aldiwan.net/poem8260.html","الكامل"],[107,"انبعث في الأرض يا وحي السماء","https://www.aldiwan.net/poem41932.html","الرمل"],[107,"رددوا الذكرى لقوم غافلين","https://www.aldiwan.net/poem42065.html","الرمل"],[107,"هو الحكم أمضته السيوف القواطع","https://www.aldiwan.net/poem43054.html","الطويل"],[107,"يا غاديا ببريد الشام ينتحب","https://www.aldiwan.net/poem43094.html","الكامل"],[104,"هو ذا البحر مزبدا يتعالى","https://www.aldiwan.net/poem33132.html","الخفيف"],[41,"طال في رسم مهدد أبده","https://www.aldiwan.net/poem53781.html","المنسرح"],[50,"طول اشتياقي وضيق مصطبري","https://www.aldiwan.net/poem63322.html","المنسرح"],[48,"ترنم في نهارك مستعينا","https://www.aldiwan.net/poem22214.html","الوافر"],[48,"كل ذكر من بعده نسيان","https://www.aldiwan.net/poem23463.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54588","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[108,"في ربا الخلد","https://www.poetsgate.com/ViewPoem.aspx?id=179685",""],[108,"يا ملاذ الموظفين","https://www.poetsgate.com/ViewPoem.aspx?id=179706",""],[108,"حفظ الله صالحًا","https://www.poetsgate.com/ViewPoem.aspx?id=179358",""],[102,"الضباب .. وشمس هذا الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=50327",""],[47,"بِالله أَولَى يَمِيناً بَرّةً، قَسَمَا","https://www.poetsgate.com/ViewPoem.aspx?id=32080",""],[48,"ترنّمْ في نهارِكَ، مستعيناً","https://www.poetsgate.com/ViewPoem.aspx?id=18122",""],[40,"يبتنَ سجودًا منْ نهيتِ مصدّرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=21219",""],[89,"كَمْ غادَرَ الشُّعَرَاءُ مِنْ مُتَرَدَّمِكَمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23829&r=&rc=91",""],[132,"أيها العاقل الذي شاء تزو","https://www.aldiwan.net/poem50678.html","الخفيف"],[150,"يبتهج الناس بأعيادهم","https://www.aldiwan.net/poem2626.html","السريع"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[199,"لمن الدار مثل خط الكتاب","https://www.aldiwan.net/poem54424.html","الخفيف"],[240,"أتظنني ما عشت أنعم بالا","https://www.aldiwan.net/poem31787.html","الكامل"],[285,"أقول واليوم بهيم خطبه","https://www.aldiwan.net/poem60605.html","الرجز"],[309,"قل لأحبابنا بسوح المقام","https://www.aldiwan.net/poem16829.html","الخفيف"],[357,"الحبيب الشرود","https://www.aldiwan.net/poem950.html",""],[369,"كلما اشتقت يا خليلي نجدا","https://www.aldiwan.net/poem60932.html","الخفيف"],[369,"صوت حمام الأيك عند الصباح","https://www.aldiwan.net/poem60968.html","السريع"],[384,"كيف ترى وقع طلاحياتها","https://www.aldiwan.net/poem4534.html","الرجز"],[422,"شام برقا راعه مبتسما","https://www.aldiwan.net/poem53999.html","الرمل"],[422,"أكرم بطيف خيالكم من زائر","https://www.aldiwan.net/poem54150.html","الكامل"],[438,"حرس الدهر بعين لم تنم","https://www.aldiwan.net/poem12507.html","الرمل"],[463,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[463,"إذا رفعت من شراف الخدور","https://www.aldiwan.net/poem56193.html","المتقارب"],[520,"ما عن هوى الرشأ العذري أعذار","https://www.aldiwan.net/poem12136.html","البسيط"],[543,"لم أستمع لشكاية من شاك","https://www.aldiwan.net/poem48003.html","عموديه"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48565","الرمل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145808","الخفيف"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25362","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64734","الوافر"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56694","الخفيف"],[1389,"","https://poetry.dctabudhabi.ae/diwan/poem/102233","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79951","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124731","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27804","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27908","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27894","السريع"],[2384,"","https://poetry.dctabudhabi.ae/diwan/poem/123645","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58248","الكامل"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100495","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204920","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204500","الخفيف"],[2983,"","https://poetry.dctabudhabi.ae/diwan/poem/133933","الرمل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103000","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111450","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111436","الرمل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72460","الرجز"],[357,"الحبيب الشرود","https://www.poetsgate.com/ViewPoem.aspx?id=6325",""],[4691,"يبتزّني الخدّ فما أفلحُ","https://www.poetsgate.com/ViewPoem.aspx?id=211311",""],[4940,"لا تسألوا الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=210457",""],[585,"لم تزل في هواك نضواً طليحا","https://www.poetsgate.com/ViewPoem.aspx?id=161862",""],[5225,"مدارات","https://www.poetsgate.com/ViewPoem.aspx?id=36080",""],[5261,"رمضانيون","https://www.poetsgate.com/ViewPoem.aspx?id=212890",""],[5408,"أقسمت إني لا أخونك","https://www.poetsgate.com/ViewPoem.aspx?id=190872",""],[5409,"تخشع النفس هيبةً من جلال ال","https://www.poetsgate.com/ViewPoem.aspx?id=155478",""],[5410,"همسات ناعمة","https://www.poetsgate.com/ViewPoem.aspx?id=152343",""],[5411,"(الشاعِرُ الذوّاقُ)","https://www.poetsgate.com/ViewPoem.aspx?id=198868",""],[5455,"نديم الجرح","https://www.poetsgate.com/ViewPoem.aspx?id=34411",""],[5470,"يزري به الألم","https://www.poetsgate.com/ViewPoem.aspx?id=11007",""],[5512,"ذكرى النظرة الأولى","https://www.poetsgate.com/ViewPoem.aspx?id=204332",""],[5691,"أسوار وحراب","https://www.poetsgate.com/ViewPoem.aspx?id=206525",""],[5751,"بينَ موتٍ وموت","https://www.poetsgate.com/ViewPoem.aspx?id=214771",""],[5842,"أبكي مصاب الجامعة \\ محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=130029",""],[5853,"تباريح الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=175697",""],[5956,"البلدة السعيدة","https://www.poetsgate.com/ViewPoem.aspx?id=185792",""],[5957,"ما أعذب الحب وما أنبله","https://www.poetsgate.com/ViewPoem.aspx?id=180733",""],[6056,"الغريق","https://www.poetsgate.com/ViewPoem.aspx?id=130377",""],[6056,"الفقر بلوى وحكمة","https://www.poetsgate.com/ViewPoem.aspx?id=130518",""]],"verses":[["يَبتَنونَ العُلا يَشيدونَ مَجداً","يُسعِدونَ البَنينَ وَالأَعقابا",0,"ب",2,0],["يَبِت فِي الأَمْرِ لا يَعْنِيهِ مِنْهُ سِوَى","مَا تَرْتَضِيهِ عُهُودُ اللهِ وَالذِّمَمُ",1,"م",1,0],["يَبتَرِكُ الدَهرَ عَلى جَبينِهِ","لِحَيَّةٍ تَنسابُ في تِسعينِهِ",2,"ن",2,0],["يبتسم الأنس بلا حشمة","فيه على مرأىً من التقوى",3,"ق",3,0],["يبتهجُ المُبغضو الصليب من ال","ناسِ إذا رُفِّعت بهمْ صُلُبُهْ",4,"ب",2,0],["يبتُ أخو البلوى إذا الخِلوُ غمَّضا","وفي قلبه جمر من الوجد لا الغضا",5,"ض",2,1],["يبتْنَ في جوفِ الظلامِ ذي الحلكْ","يشرك فيهن البعولَ مَنْ شركْ",6,"ك",1,0],["يَبِت وَهوَ مَشحوذٌ عَلَيهِ وَلا يُرى","إِلى بَيضَتي وَكرِ الأَنوقِ سَبيلُ",7,"ل",1,0],["يَبِتنَ سُجوداً مَن نَهَيتِ مُصَدَّرٍ","بِذَكرَةَ إِطراقَ الظِباءِ مِنَ الوَبلِ",8,"ل",1,1],["يبتغي الموت كل يوم صريعا","وعلى الذئب لا يعز القطيع",9,"ع",1,0],["يبتغي اكثر المصلين منا","ان ينالوا الجنان بالصلوات",10,"ت",1,0],["يَبتَدِرُ الراغِبونَ مِن يَدِهِ","وَقائِعَ الغَيثِ غِبَّ مُنسَكَبِه",11,"ب",2,0],["يَبتَغي المَرءُ وَقفَةَ العَيشِ وَالعَي","شُ سِجالٌ كَثيرَةٌ أَطوارُه",12,"ر",2,0],["يَبتَدِرونَ الحُطامَ المُستَعارَ وَلَم","يُهدَو فَيَبتَدِروا الأَخلاقَ وَالشِيَما",13,"م",2,0],["يَبتَني المَجدَ أَوَّلاً فَإِذا ما","شادَهُ شَيَّدَ المَنازِلَ ثانِ",14,"ن",1,0],["يَبْتَزُّ أُهْبَةَ كُلِّ فَارِسِ بُهْمَةٍ","وَيَزُمُّ شِقْشِقَةَ الْفَتِيقِ الْمُقْرَمِ",15,"م",1,0],["يبتغِي وَجْهَكَ بين الشُّعراءْ","يُرسِلُ الشّعرَ شُعاعاً سَارِيا",16,"ي",2,0],["يَبْتَغِي الزُّلفَى لَدَى أصنامِه","فدعوه تلك زُلفى المُشركينْ",17,"ن",1,0],["يَبتْنَ وَراءَ الخيلِ يَحْمينَ سَرْحَها","إذا بات منّا في الحشيَّةِ وادعُ",18,"ع",1,0],["يَبتاعُ ذو الأَلفِ مِنهُ حينَ يَملِكُها","أَدنى وَأَهوَنَ ما يُشرَى وَيُجتَلَبُ",19,"ب",1,0],["يَبتَغون التَفريق في الجَسد الوا","حد خابَت تِلكَ الشَياطين فَالا",20,"ل",2,0],["يَبتَدِرنَ الأَحراجَ كَالثَولِ وَالحِر","جُ لِرَبِّ الصُيودِ يَصطَفِدُه",21,"د",2,0],["يَبتَعِثُ الشَوقَ مِن مَكامِنِهِ","وَجهٌ زَها حُسنُهُ عَلى القَمَرِ",22,"ر",1,0],["يَبِتنَ بِكُلِّ مُظلِمَةٍ وَفَجٍّ","عَلى حَوضِ الرَدى مُتَجَهِّماتِ",23,"ت",1,0],["يَبتَني راغِبٌ فَما تَكمُلُ الرَغ","بَةُ حَتّى يُهَدَّمَ البُنيانُ",24,"ن",1,0],["يَبْتَغُونَ الكَمَالَ فِي ظِلِّ فَارُوقَ","وَقَدْرُ النَّجَاحِ قَدْرُ الطِّلاَبِ",25,"ب",1,0],["يَبْتَغِي إِشْهَادَهَا فِي مَحْفِلٍ","حُسْنَهُ الطَّالِعَ فِي الظَّلْمَاءِ بَدْرَا",26,"ر",2,0],["يَبتَني للبلاد مثُلك مالاً","تبتنيه فيالقٌ من جنود",27,"د",1,0],["يَبتَني شاهقَ القصورِ سواهُ","وهو -ما عاشَ- ساكنٌ بالكِراء",28,"ا",2,0],["يُبْتَلىَ الحرُّ دائمًا بأُنَاس","لا تساوي هاماتُهم إيهامه",29,"م",2,0],["يبتدى ، عليه جلد الصحارى","وطلاء ، تشمّ فيه ، (فرنسا)",30,"س",2,0],["يُبتَدِرُونَ الحُطامَ المُسْتَعَارَ، ولَمْ","يُهدَوْا فيَبتَدرُوا الأخلاقَ وَالشّيَمَا",31,"م",2,0],["يبتْنَ، بكلّ مُظلِمةٍ وفجٍّ،","على حَوضِ الرّدى مُتهجّماتِ",32,"ت",1,0],["يبتنَ سجودًا منْ نهيتِ مصدّرٍ","بِذَكْوَة َ إطْرَاقَ الظِّبَاءِ مِنَ الْوَبْلِ",33,"ل",1,1],["يبتذُّ أهبة َ كلَّ فارسِ بهمة ٍ","وَيَزُمُّ شِقْشِقَة َ الْفَتِيقِ الْمُقْرَمِ",34,"م",1,0],["يبتغى العدل منه والعدلُ صعبٌ","إنما العدل شِيمَةُ الأتقياءِ",35,"ا",2,0],["يَبتَهج الناسُ بِأعيادهم","من أجل ذَبحٍ أو لإِفطارِ",36,"ر",1,1],["يَبتَغي قُربَكم فينأي كأنّ ال","عَبدَ منهُ للإبتعاد اِبتغاءُ",37,"ا",2,0],["يَبتَغي الحبَّ يَبتغي القُرب يبغي","كلَّ خَيرٍ قد ناله السعداءُ",37,"ا",2,0],["يَبتَغي أَن تحيلَ منهُ الخطايا","حَسناتٍ من جودكَ الكيمياءُ",37,"ا",2,0],["يَبتَغي عيشةً لديكُم يطيب الس","سرُّ فيها وتحصل السرّاءُ",37,"ا",2,0],["يَبتَغي في جِواركم خيرَ موتٍ","نالهُ الصالِحون والشهداءُ",37,"ا",2,0],["يَبتَدِرنَ القِيامَ يَجمُزنَ قُدماً","ثانِياتٍ وَهُنَّ غَيرُ صِعابِ",38,"ب",1,0],["يَبتَزُّها الآسادَ مِن صَهواتِها","غُلباً وَتُلبِسُها الدِماءَ جِلالا",39,"ل",2,0],["يَبْتِكُ مِنْها لَحْمَها وَتارَةً","تَكادُ تَنْجُو فَيُطارُ رِيشُها",40,"ش",3,0],["يبتغون فضلاً من ربهم ورضوا","نا كما في القران خير الكلام",41,"م",1,0],["يبتليني بالصدود","ان راي عيشي صفا",42,"ف",2,0],["يَبْتَني رُتبةً على كلِّ حالٍ","لِوَلّيٍ لها ويَكْبِتُ أَعدا",43,"د",2,0],["يَبْتَدِر الصّارخُ يومَ الوغَى","بسائلِ الغُرّة طاغِي المِراح",44,"ح",1,0],["يبتن ينقلن باجهزاتها","والحادي اللاعب من حداتها",45,"ت",3,0],["يَبتليني صابراً لم يُلْفِني","فاغراً فيه من الشكوى فما",46,"م",2,0],["يبتاع بالمال الثناء وإنَّما","في سوقه ربحت تجارة تاجر",47,"ر",1,0],["يبتني بالمجدِ ما يهدِمُه","ويداوي بالنّدى ما يجرحُ",48,"ح",1,0],["يبتغي حقَّه من الشرف الأب","عدِ خوضاً إليه أو تشميرا",49,"ر",2,0],["يبِتْ للغزالةِ من دونه","ذراعٌ قصيرٌ وطرفٌ حسيرُ",50,"ر",1,0],["يبتاع بالجود أحرار الرجال فهم","عب