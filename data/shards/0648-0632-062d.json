{"poems":[[90,"حببت العلا منذ الصبا حب شاعر","https://www.aldiwan.net/poem44989.html","الطويل"],[53,"وقتك يد الإله أبا علي","https://www.aldiwan.net/poem8297.html","الوافر"],[80,"كذبت مناكم صرحوا أو جمجموا","https://www.aldiwan.net/poem14191.html","الكامل"],[47,"أترى الزمان يعيد لي أيامي","https://www.aldiwan.net/poem65674.html","الكامل"],[30,"ولنا قراسية تظل خواضعا","https://www.aldiwan.net/poem5475.html","الكامل"],[51,"جرى لك من هارون بالسعد طائره","https://www.aldiwan.net/poem64183.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39647","البسيط"],[102,"بين الرجل والطريق","https://www.poetsgate.com/ViewPoem.aspx?id=50371",""],[102,"الطريق الهادر","https://www.poetsgate.com/ViewPoem.aspx?id=50202",""],[102,"مآتم وأعراس","https://www.poetsgate.com/ViewPoem.aspx?id=50173",""],[47,"أتَرَى الزّمَانَ يُعَيدُ لي أيّامي","https://www.poetsgate.com/ViewPoem.aspx?id=32037",""],[96,"حيرة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=15611",""],[96,"أين أين الرعيل من أهل بدر","https://www.poetsgate.com/ViewPoem.aspx?id=13787",""],[80,"كَذبَتْ مُناكُم، صَرّحوا أَو جَمْجِموا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86640&r=&rc=135",""],[228,"أذكره وكيف لا أذكر","https://www.aldiwan.net/poem41894.html","السريع"],[275,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[280,"رأى الله ما أرضاه من سعيه الأسنى","https://www.aldiwan.net/poem25512.html","الطويل"],[382,"أمانا لقلب طال فيه اعتناؤه","https://www.aldiwan.net/poem66968.html","الطويل"],[408,"يا دار سلمى بسفح ذي سلم","https://www.aldiwan.net/poem46982.html","المنسرح"],[445,"سماء العلا منكم وأنت لها بدر","https://www.aldiwan.net/poem34843.html","الطويل"],[514,"هل عرفت الغداة رسماً محيلا","https://www.aldiwan.net/poem751.html",""],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133830","الوافر"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25362","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/19992","المديد"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108704","الطويل"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102063","الوافر"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102060","البسيط"],[2177,"","https://poetry.dctabudhabi.ae/diwan/poem/138794",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137076",""],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26201","الكامل"],[2939,"","https://poetry.dctabudhabi.ae/diwan/poem/146985","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200059",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109981","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216619","الطويل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132118","الطويل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107530","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81916","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73266","البسيط"],[4729,"أُتنكرين الحقَّ أختَ دَارمِ","https://www.poetsgate.com/ViewPoem.aspx?id=109473",""],[4929,"عطسة في دائرة الرعب","https://www.poetsgate.com/ViewPoem.aspx?id=211346",""],[592,"أكتب ككتبي كما قد كنت أكتبه","https://www.poetsgate.com/ViewPoem.aspx?id=128829",""],[5401,"تويتر والفيس بوك","https://www.poetsgate.com/ViewPoem.aspx?id=142371",""],[6102,"على !!","https://www.poetsgate.com/ViewPoem.aspx?id=184455",""],[6147,"أم الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=151698",""],[6167,"فرار الضياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85536&r=&rc=19",""],[6305,"مَنْ يُرينِي الشِّعْر ؟!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87327&r=&rc=0",""]],"verses":[["وزحلة في لبنان تاج لرأسه","قد أزدان من أبنائها بالجواهر",0,"ر",1,0],["وزُحزحَتِ المكارهُ عنك طُرّاً","ونُفِّسَتِ الشدائدُ والكروبُ",1,"ب",1,0],["وَزَحَفتُمُ بِمَحالِكُم لِمُجَرّبٍ","ما زالَ يَثبُتُ لِلمَحال فَيَهزِمُ",2,"م",1,0],["وَزَحَفتَ مِن قُربٍ فَلَم تَكُ دارُهُ","لَمّا زَهَفتَ إِلَيهِ دارَ مُقامِ",3,"م",1,0],["وَزَحَلتَ عَن عَتَبِ الطَريقِ وَلَم تَجِد","قَدَماكَ حَيثُ تَقومُ سُدَّ المَنقَلُ",4,"ل",1,0],["وَزَحفٍ لَهُ تَحكي البُروقَ سُيوفُهُ","وَتَحكي الرُعودَ القاصِفاتِ حَوافِرُه",5,"ر",2,0],["وزحزحتْ ورَقَ الصفصاف حانيةً","على البحيرة أعشابٌ وأزهارُ",6,"ر",1,0],["وزحام السّوق يشتدّ بلا","نظرة عجلى بلا أي انعطافه",7,"ف",2,0],["وزحف مريد يقود السنا","ويهدي العمالقة المرّدا",8,"د",2,0],["وزحفا يجنّح درب الصباح","ويستنفر الترب والجلمدا",8,"د",2,0],["وزحفنا نهدي الهدى ةو مددنا","من قوانا إلى الأعالي سلالم",9,"م",1,0],["وَزَحَفْتَ من قُرْبٍ، فلمْ تَكُ دارُه","لمّا زَحَفْتَ إلَيْهِ دارَ مُقَامِ",10,"م",1,0],["وزحزحت الحجاب عن الخفايا","وقلنا شقوة بلغت مداها",11,"ا",3,0],["وزحوف على العدو كما تخبط","بالعاصف المرنّ السيول",12,"ل",1,0],["وَزَحَفتُمُ بِمَحالِكُم لِمُجَرّبٍ","ما زالَ يَثبُتُ في المَجال فَيَهزِمُ",13,"م",1,0],["وَزُحلَةٌ شَوقي إِلى زحلَةٍ","كَأَنَّها في حُسنِها جُؤذَرُ",14,"ر",1,0],["وزَحزَحَتِ القَبرَ الشّريفَ خُطُوبُها","وزَعزَعتِ البَيتَ العَتيقَ المُستَّرا",15,"ر",2,0],["وَزَحْزَحَ بالتَّوْحيدِ عَنْ جَنَبَاتِها","عَصائِبَ للتَّثْليثِ جَارُوا بِها سُكْنَى",16,"ن",2,0],["وزحزحَ جِرمَ القلب عن شمس إفكها","فمركزُها دوماً يحولُ لواؤه",17,"ا",3,0],["وزَحْزحوا مَنْصب الإمامةِ عَنْ","مَعْدنِ فَصْلِ الخِطاب والحِكمِ",18,"م",1,0],["وَزَحْفٌ إِلَى الأَعداءِ أَغراضُهُ العِدى","وسيفٌ عن الإِسلامِ إِقدامُهُ النَّصْرُ",19,"ر",1,0],["وَزَحَفنا إِلى تَميمِ بنِ مُرٍّ","بِجُموعٍ تَرى لَهُن رَعيلا",20,"ل",2,0],["وزحلٌ إذ تضام فقد نماها","إلى ذرواته نسب قراب",21,"ب",1,0],["وَزَحْمُ رُكْنَيْكَ شِداد الأَرْكُنِ","بِدَرْءِ هَمَّازٍ دُرُوءَ الضَيْزَنِ",22,"ن",1,0],["وزحفه أعصب مكثرا فقد حلا","واعقل أي اسقط خامسا لام علا",23,"ل",2,0],["وَزَحوفٍ في صَواهِلِهِ","كَصِياحِ الحَشرِ في أَمَرِه",24,"ر",2,0],["وزحزح عنها روعها وشقاءها","ومد عليها من مراحمه سترا",25,"ر",2,0],["وزحزهم وصحبهم بغزو","أباد المشركين بمشرفي",26,"ي",1,0],["وزحزحو الشرك حتى صار منخفضاً","بماضي البيض ثم القوس والوتر",27,"ر",1,0],["وزحزحوا الامر للاذناب عن ترة","وأخروا من به العلياء علياء",28,"ا",2,0],["وزحلة يجري الماء فيها كأنه","وقد طاب للظمآن مازجه الشهد",29,"د",1,0],["وَزَحَمَت واديها بِمِثلِ عُبابَةِ","مِن سَلسَبيلٍ في القُلوبِ سُلافِ",30,"ف",1,0],["وزحام والجرح فيكتف المن","بل يجري ونصله مسلول",31,"ل",1,0],["وزحاف في مقاطعها","وبها خبن ٌمن الوجل",32,"ل",1,0],["وزُحزِحَت ظُلمةُ الأوثانِ وانحسَرَت","ملابسُ التَبَسَت من كل ملتبسِ",33,"س",1,0],["وزحزحني عنه بكف رفيقة","وأسبل أهداب الجفون السواجيا",34,"ي",2,0],["وزحزح ثقال النائبات وهاتها","ليحملها عن عاتق الشعب عاتقي",35,"ق",2,0],["وزحمتاها بالمناكب زحمةً","فغدَت تصيحُ وتستغيث الأَنجما",36,"م",2,0],["وزحمت الوفود أطمع أن يضرب","لي معهمو بسهم عطاء",37,"ا",2,0],["وزحتُ عن الحدباءِ بغضاً بأهلها","فقد جمعت أكنافها كل مأزم",38,"م",1,0],["وَزَحفوا حَولَها الإِنجيلَ مِن فَرحٍ","بِها وَطافوا بِتَعظيم وَتَمجيدِ",39,"د",1,0],["وزَحزحُوا كسراهُمُ عن مُلكِهِ","بالمشرفِياتِ وباللهازمِ",40,"م",1,0],["وزحمةُ القاتِ في المِقْوِاتِ خانقةٌ","والساعلونَ به في غيرِهمْ لُصَقَا",41,"ق",2,0],["وزحزح النفس عن زور وعن زلل","ولازم الحزم مع عزم لى الطلب",42,"ب",1,0],["وزحمة جماهير تشجع بلا قيس","لا نوم لا راحه وشعب مواصل",43,"ل",1,0],["وَزَحَفتُ مَهزُومًا, عَلَى شَفَتِي","وَالشِّعرُ يَشكُو - فِي فَمِي - الشَّلَلا",44,"ل",2,0],["وزحمة أبكار أوانس كالضحى","يراقصهن الليل في الشعر ذائب",45,"ب",1,0],["وزَحفتُ في وادي الزّمانِ وربْعه","والناسُ تنهلُ من دِنانِ هواءِ",46,"ا",2,0],["وزحزحتُ قلباً كان كفَّ خفوقَهُ","وأرغمتُه أن لا يُحِبَّ فيصغُرا",47,"ر",2,0]]}