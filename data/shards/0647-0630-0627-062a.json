{"poems":[[29,"لمن الديار رسومهن خوالي","https://www.aldiwan.net/poem5974.html","الكامل"],[74,"هنئت صوما ترتجي أو تختشي","https://www.aldiwan.net/poem18954.html","الكامل"],[66,"لم يبق بيني وبين الحق تبياني","https://www.aldiwan.net/poem67608.html","البسيط"],[71,"هذا تعدى طوره","https://www.aldiwan.net/poem28021.html","مجزوء الرجز"],[107,"تلك العروبة جرحها يجري دما","https://www.aldiwan.net/poem42060.html","الكامل"],[107,"من هيبة يغضي القريض ويطرق","https://www.aldiwan.net/poem42076.html","الكامل"],[107,"خطب الرسول فكل سمع منصت","https://www.aldiwan.net/poem44021.html","الكامل"],[78,"قول كأن فريده","https://www.aldiwan.net/poem39502.html","مجزوء الكامل"],[92,"تحية العيد أو الملك والإنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=178948",""],[119,"سلم لربك لا تحاذر","https://www.aldiwan.net/poem41121.html","عموديه"],[139,"لي في الصبابة أخبار وأحوال","https://www.aldiwan.net/poem49113.html","البسيط"],[203,"الأرض للناس بحر","https://www.aldiwan.net/poem45372.html","المجتث"],[234,"ورد الخدود أرق من","https://www.aldiwan.net/poem50811.html","مجزوء الكامل"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[376,"نظرت بكأس ليس يصحو شاربه","https://www.aldiwan.net/poem57527.html","الكامل"],[422,"كن بالمدامة للسرور متمما","https://www.aldiwan.net/poem54035.html","الكامل"],[445,"قل للخلافة قد بلغت مناك","https://www.aldiwan.net/poem34895.html","الكامل"],[449,"أهلا بطلعة وجهك المحبوب","https://www.aldiwan.net/poem55944.html","عموديه"],[463,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[484,"الذكر أبقى لكم والمال عارية","https://www.aldiwan.net/poem37207.html","البسيط"],[567,"جاء الصيام قرير العين مبتهجا","https://www.aldiwan.net/poem52754.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138302",""],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62644","الكامل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16789","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126149","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55923","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56336","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48946","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101056","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27730","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107004","الكامل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100881","البسيط"],[2734,"","https://poetry.dctabudhabi.ae/diwan/poem/101411","الكامل"],[3419,"","https://poetry.dctabudhabi.ae/diwan/poem/130745","الرجز"],[3531,"","https://poetry.dctabudhabi.ae/diwan/poem/145740","البسيط"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118774","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91078","الكامل"],[3737,"","https://poetry.dctabudhabi.ae/diwan/poem/138914",""],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66581","البسيط"],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/117143","الرجز"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139768",""],[4679,"إيفاء مدحك منتهى ما نطلب","https://www.poetsgate.com/ViewPoem.aspx?id=142727",""],[4718,"ياصاح انا قلبي من الهم طاويه","https://www.poetsgate.com/ViewPoem.aspx?id=137214",""],[4767,"الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=87657",""],[4767,"عودة الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=94471",""],[4884,"(أَفَأَمِنُوا مَكْرَ اللَّهِ ...)","https://www.poetsgate.com/ViewPoem.aspx?id=201762",""],[5410,"فحضارة الإسلام حصن صامد","https://www.poetsgate.com/ViewPoem.aspx?id=73563",""],[5502,"إن كنت تبحث عن تراث عمان","https://www.poetsgate.com/ViewPoem.aspx?id=124955",""],[5691,"هراوة أمريكا","https://www.poetsgate.com/ViewPoem.aspx?id=206339",""],[5736,"يا قدس يا طفلتي","https://www.poetsgate.com/ViewPoem.aspx?id=208458",""],[5851,"ضوء من خفايا الروح","https://www.poetsgate.com/ViewPoem.aspx?id=175293",""],[6002,"هلا عجبت وكيف ينقضي العجب","https://www.poetsgate.com/ViewPoem.aspx?id=210295",""],[6127,"يوم الجائزة","https://www.poetsgate.com/ViewPoem.aspx?id=206104",""]],"verses":[["هَذا تَقَدُّمُنا وَزَجرَي مالِكاً","لا يُردِيَنَّكَ حَينُ قَينِكَ مالِ",0,"ل",1,0],["هذا تفطّره من الإفطار أو","هذا تفطّره من التفطير",1,"ر",1,0],["هَذا تَجلي طُلوعِ الحَقِّ نائِرَةٌ","قَد أَزهَرَت في تَلاليها بِسُلطانِ",2,"ن",1,0],["هذا تعدَّى طورَهُ","فنالَهُ ما نالَهُ",3,"ه",1,1],["هذا تُراثُ مُحمَّدٍ في قومِه","أَمْسَى بأيدِي النّاهِبينَ مُقَسَّما",4,"م",2,0],["هذا تُراثُ المسلمينَ فبعضُه","يُزجَى علانيةً وبعضٌ يُسرَقُ",5,"ق",1,0],["هذا تراثُ العالمِينَ بأسرهم","يَجرِي عليهم نَفْعُه المتتابعُ",6,"ع",1,0],["هَذا تُجَذُّ بهِ الرّقَا","بُ وذا تُجَذُّ به الخُطوبْ",7,"ب",1,0],["هذا تراث السالفين وديعة","لا تخجلوا الأجداد في الأحفاد",8,"د",1,0],["هذا تقي مؤمن","رحب الجنان وذاك كافر",9,"ر",1,0],["هذا تغالطه الشعو","ب وذاك توهمه العشائر",9,"ر",1,0],["هذا تقيدت الأحشاءُ منه على","خُودِ وللدمع فوق الخد إرسالُ",10,"ل",1,0],["هذا تُشادُ بهِ الدا","رُ وهي للدارِ زينهْ",11,"ن",2,0],["هذا تَنَشَّقُه الأُنو","فُ وذا يُقبِّلُه الفَمُ",12,"م",1,0],["هَذا تحفّل للدروسِ مقلّباً","ظهراً لبطن ما الصحائفُ تجمعُ",13,"ع",1,0],["هذا تضيقُ به القلوبُ إذا أتت","أوقاتُه أبداً ويثقلُ واجبُه",14,"ب",2,0],["هذا تراه مُؤَمِّلاً يرجو الندى","من راحتيه وذا أتى متعلّما",15,"م",2,0],["هذا تَعَجَّل من كَرامة رَبِّهِ","فِي الخلد مثوىً جَلَّ عن مثواك",16,"ك",1,0],["هذا تراث لم تنله امة","من قبلكم متكامل الترتيب",17,"ب",1,0],["هذا تصيب إذا ركبت به وذا","وَزَرٌ يقيك إذا أردت نزالا",18,"ل",2,0],["هذا تدافع عن حق بسالته","وذاك تجعله الأطماع في حنق",19,"ق",1,0],["هذا تدومُ على الأيامِ بَهجتُهُ","لنا وهذا بيومٍ مرَّ وانصرَفا",20,"ف",2,0],["هذا توخاه الامين بوضعه","هذي الرواية مبدعاً لنحاذرا",21,"ر",2,0],["هذا تزوجَ أُمَّهُ","جهلاً فأولدها عدا",22,"د",2,0],["هَذا تَعَدٍّ في الشِكايَةَ ظاهِرٌ","وَلَرُبَّ شاكٍ مُعتَدٍ بِشِكاتِهِ",23,"ت",2,0],["هذا تراه يمرُّ في","ذوقي وذلك يعذب",24,"ب",1,0],["هذا تراه راصداً ريح الصبا","يشجو إذا هّبت وذلك معرقا",25,"ق",2,0],["هذا تراه زهيّاً في البياض حكى","دُرّاً وهذا عقيقيّاً حكى الشفقا",26,"ق",2,0],["هذا تمام القول في الأوزان","والحمد لله على الإحسان",27,"ن",1,0],["هذا تمام القول في الضرائر","جئت بها معونة للشاعر",27,"ر",1,0],["هذا تدبُّ به الحياة وهذه","لم يبقَ فيها للحياة ذَماء",28,"ا",2,0],["هذا تعاجله وذا","ك غداً وذلك بعد عام",29,"م",1,0],["هذا تولد عن هذا فوالده","هذا فيا حيرة المفتون في الله",30,"ه",1,0],["هذا تواتر عن رسول الله لم","ينكره الا فاسد الايمان",31,"ن",1,0],["هذا تورد بالحياء وذاك من","نضج الدماء وما سواء ذان",32,"ن",1,0],["هذا تراثي وهذا ما أُمِرَّ بهِ","عهدُ الشبيبة بين العين والأثرِ",33,"ر",1,0],["هذا تلاعب عامدٍ أم جاهلٍ","بمكانة القرآن ذي استزراء",34,"ا",2,0],["هذا تمام الغرض المقصود","من أمّهات المنطق المحمود",35,"د",1,0],["هذا تواضُعك المشهورُ عن ضعَةٍ","فصرتَ من أجله بالكبر تُتّهَمُ",36,"م",1,1],["هذا تمام العامل السماعي","وبعضه لم يخل من نزاع",37,"ع",1,0],["هَذا تكلَّم بِالسُكوت وَهذِهِ","بِلسانها الجاري رَأَت إفصاحا",38,"ح",2,0],["هذا تراثك من نبي هدى","تجلى بنور جبينه الظلم",39,"م",1,0],["هذا تَموتُ بِهِ أَحْياؤُكُمْ أَبَداً","وَذاكَ يَحْيا بِهِ فِي التُّرْبِ أَمْواتُ",40,"ت",1,0],["هذا تراه خايفاً وداعياً","وذا تراه طايفاً وساعيا",41,"ي",2,0],["هذا توحَّد بالمعالي مثلما","ذا بالعلوم نسيج وحد جنابه",42,"ب",2,0],["هذا تمام الخمس والعشرين من","زمنٍ سقاه من نوالك صيب",43,"ب",1,0],["هذا ترا بالمختصر كل مافيه","راعي ظميرك وانت مسلم تصلّي",44,"ل",2,0],["هذا تعميم أنشره","فليحفظ للمعلومية",45,"ي",2,0],["هذا ترابك أسفرت صفحاتُه","نوراً كخد جميلةٍ متورد",46,"د",1,0],["هذا تَخَطَّفَهُ وأَجْحَفَ زُوْرُهُ","هذاك مُسْتَوْلِيٍ لِمَا جَمَعَتْ يداهْ",47,"ا",2,0],["هذا ترابي للعطاء نَسَبْتُهُ","وسقيتُهُ طِيْبَ المُنى ودوامََها",48,"م",3,0],["هذا تراث عمان لا الليوا ولا","النيروز والزار الخسيس الشأن",49,"ن",1,0],["هذا تَرَمْبُ سليلُ السّاقِطينَ يَفي","تاجَ المَدائِنِ للشُّذّاذِ إزْلافا",50,"ف",2,0],["هذا ترابك طهر الأرض منبعهُ","وذي سماؤك تُهدي شمسها غضبا",51,"ب",2,0],["هذا ترابي وهذي الأرض من أزل","كل المدائن أرض وحدها الأفُق",52,"ق",1,0],["هذا تضلع من شرع العلوم وذا","من الحقيقة كالمحروق يلتهب",53,"ب",1,0],["هذا ترى ثوبه ظلا يلوذ به","وآخرٌ قد بدا من أمرِه وجلا",54,"ل",2,0]]}