{"poems":[[29,"لمن الديار رسومهن خوالي","https://www.aldiwan.net/poem5974.html","الكامل"],[74,"هنئت صوما ترتجي أو تختشي","https://www.aldiwan.net/poem18954.html","الكامل"],[66,"لم يبق بيني وبين الحق تبياني","https://www.aldiwan.net/poem67608.html","البسيط"],[71,"هذا تعدى طوره","https://www.aldiwan.net/poem28021.html","مجزوء الرجز"],[107,"تلك العروبة جرحها يجري دما","https://www.aldiwan.net/poem42060.html","الكامل"],[107,"من هيبة يغضي القريض ويطرق","https://www.aldiwan.net/poem42076.html","الكامل"],[107,"خطب الرسول فكل سمع منصت","https://www.aldiwan.net/poem44021.html","الكامل"],[78,"قول كأن فريده","https://www.aldiwan.net/poem39502.html","مجزوء الكامل"],[92,"تحية العيد أو الملك والإنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=178948",""],[119,"سلم لربك لا تحاذر","https://www.aldiwan.net/poem41121.html","عموديه"],[139,"لي في الصبابة أخبار وأحوال","https://www.aldiwan.net/poem49113.html","البسيط"],[203,"الأرض للناس بحر","https://www.aldiwan.net/poem45372.html","المجتث"],[233,"ورد الخدود أرق من","https://www.aldiwan.net/poem50811.html","مجزوء الكامل"],[309,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[375,"نظرت بكأس ليس يصحو شاربه","https://www.aldiwan.net/poem57527.html","الكامل"],[420,"كن بالمدامة للسرور متمما","https://www.aldiwan.net/poem54035.html","الكامل"],[443,"قل للخلافة قد بلغت مناك","https://www.aldiwan.net/poem34895.html","الكامل"],[447,"أهلا بطلعة وجهك المحبوب","https://www.aldiwan.net/poem55944.html","عموديه"],[461,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[482,"الذكر أبقى لكم والمال عارية","https://www.aldiwan.net/poem37207.html","البسيط"],[565,"جاء الصيام قرير العين مبتهجا","https://www.aldiwan.net/poem52754.html","البسيط"]],"verses":[["هَذا تَقَدُّمُنا وَزَجرَي مالِكاً","لا يُردِيَنَّكَ حَينُ قَينِكَ مالِ",0,"ل",1,0],["هذا تفطّره من الإفطار أو","هذا تفطّره من التفطير",1,"ر",1,0],["هَذا تَجلي طُلوعِ الحَقِّ نائِرَةٌ","قَد أَزهَرَت في تَلاليها بِسُلطانِ",2,"ن",1,0],["هذا تعدَّى طورَهُ","فنالَهُ ما نالَهُ",3,"ه",1,1],["هذا تُراثُ مُحمَّدٍ في قومِه","أَمْسَى بأيدِي النّاهِبينَ مُقَسَّما",4,"م",2,0],["هذا تُراثُ المسلمينَ فبعضُه","يُزجَى علانيةً وبعضٌ يُسرَقُ",5,"ق",1,0],["هذا تراثُ العالمِينَ بأسرهم","يَجرِي عليهم نَفْعُه المتتابعُ",6,"ع",1,0],["هَذا تُجَذُّ بهِ الرّقَا","بُ وذا تُجَذُّ به الخُطوبْ",7,"ب",1,0],["هذا تراث السالفين وديعة","لا تخجلوا الأجداد في الأحفاد",8,"د",1,0],["هذا تقي مؤمن","رحب الجنان وذاك كافر",9,"ر",1,0],["هذا تغالطه الشعو","ب وذاك توهمه العشائر",9,"ر",1,0],["هذا تقيدت الأحشاءُ منه على","خُودِ وللدمع فوق الخد إرسالُ",10,"ل",1,0],["هذا تُشادُ بهِ الدا","رُ وهي للدارِ زينهْ",11,"ن",2,0],["هذا تَنَشَّقُه الأُنو","فُ وذا يُقبِّلُه الفَمُ",12,"م",1,0],["هَذا تحفّل للدروسِ مقلّباً","ظهراً لبطن ما الصحائفُ تجمعُ",13,"ع",1,0],["هذا تضيقُ به القلوبُ إذا أتت","أوقاتُه أبداً ويثقلُ واجبُه",14,"ب",2,0],["هذا تراه مُؤَمِّلاً يرجو الندى","من راحتيه وذا أتى متعلّما",15,"م",2,0],["هذا تَعَجَّل من كَرامة رَبِّهِ","فِي الخلد مثوىً جَلَّ عن مثواك",16,"ك",1,0],["هذا تراث لم تنله امة","من قبلكم متكامل الترتيب",17,"ب",1,0],["هذا تصيب إذا ركبت به وذا","وَزَرٌ يقيك إذا أردت نزالا",18,"ل",2,0],["هذا تدافع عن حق بسالته","وذاك تجعله الأطماع في حنق",19,"ق",1,0],["هذا تدومُ على الأيامِ بَهجتُهُ","لنا وهذا بيومٍ مرَّ وانصرَفا",20,"ف",2,0]]}