{"poems":[[87,"مرحبا بالربيع في ريعانه","https://www.aldiwan.net/poem62943.html","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53202","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53052","الخفيف"]],"verses":[["مَلَكٌ ظِلُّهُ عَلى رَبوَةِ الخُل","دِ وَكُرسِيُّهُ عَلى خُلجانِه",0,"ن",2,0],["ملك ظَمِئْتُ فكان يوم قدومه","رِيٌّ لتقبيلي ثَرَى أقدامه",1,"م",2,0],["ملك ظله الظليل ظليل","من حماه تَزْوَرُّ عنه الخطوبُ",2,"ب",1,0]]}