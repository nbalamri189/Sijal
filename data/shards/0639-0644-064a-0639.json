{"poems":[[108,"سطا حُسناً","https://www.shoaraa.com/p13815",""],[63,"أبت إبلي والليل وحف الغدائر","https://www.aldiwan.net/poem46167.html","الطويل"],[63,"على عذب الجرعاء من أيمن الحمى","https://www.aldiwan.net/poem46170.html","الطويل"],[100,"وحدي هنا","https://www.aldiwan.net/poem24837.html","عموديه"],[55,"أتطمع يا عباس في غير مطمع","https://www.aldiwan.net/poem26259.html","الطويل"],[24,"أبت ذكرة من حب ليلى تعودني","https://www.aldiwan.net/poem21862.html","الطويل"],[86,"شوفتماني أيها الفرقدان","https://www.aldiwan.net/poem10369.html","السريع"],[54,"يا حسرة تتردد","https://www.aldiwan.net/poem27433.html","المجتث"],[30,"قف العيس في أطلال مية فاسأل","https://www.aldiwan.net/poem29540.html","الطويل"],[30,"تصابيت في أطلال مية بعدما","https://www.aldiwan.net/poem29578.html","الطويل"],[83,"سلام على الدنيا جميعا وما فيها","https://www.aldiwan.net/poem54233.html","الطويل"],[27,"أراح الحي من إرم الطراد","https://www.aldiwan.net/poem5709.html","الوافر"],[72,"عيد يعود إلى هذا الثنا العالي","https://www.aldiwan.net/poem19474.html","البسيط"],[51,"على عاقد الزنار تحت قضيب","https://www.aldiwan.net/poem8643.html","الطويل"],[51,"صرمت اليوم حبلك من لميس","https://www.aldiwan.net/poem64658.html","الوافر"],[43,"وفاؤكما كالربع أشجاه طاسمه","https://www.aldiwan.net/poem10140.html","الطويل"],[62,"لاح الهلال والثري","https://www.aldiwan.net/poem52437.html","مجزوء الرجز"],[62,"لمن في عراص البيد نوق مطاريب","https://www.aldiwan.net/poem52480.html","الطويل"],[28,"كيف ببيت قريب منك مطلبه","https://www.aldiwan.net/poem5081.html","البسيط"],[28,"ومن حين قحطاني سجستان أصبحوا","https://www.aldiwan.net/poem5106.html","الطويل"],[28,"حملت من جرم مثاقيل حاجتي","https://www.aldiwan.net/poem5364.html","الطويل"],[28,"وكيف بنفس كلما قلت أشرفت","https://www.aldiwan.net/poem5383.html","الطويل"],[28,"أخذنا بالنجوم على كليب","https://www.aldiwan.net/poem5599.html","الوافر"],[2,"أبت ذكر من حب ليلى تعودني","https://www.aldiwan.net/poem25031.html","الطويل"],[39,"نبيت تميما تجتدي حرب طيئ","https://www.aldiwan.net/poem53756.html","الطويل"],[40,"تعدد نفسي من سليمى عدادها","https://www.aldiwan.net/poem42278.html","الطويل"],[40,"فكم من كاعب حوراء رود","https://www.aldiwan.net/poem42292.html","الوافر"],[17,"ألا أيها الضيفُ الذي عاب سادتي","https://www.aldiwan.net/poem1202.html",""],[52,"قد جمع الحسن والملاحة","https://www.aldiwan.net/poem27194.html","المنسرح"],[48,"يا ربع شغلك إني عنك في شغل","https://www.aldiwan.net/poem65028.html","البسيط"],[50,"أشاقك مغنى منزل متأبد","https://www.aldiwan.net/poem63906.html","الطويل"],[50,"تجهز طال في النصب الثواء","https://www.aldiwan.net/poem64892.html","الوافر"],[7,"كليني لهم يا أميمة ناصب","https://www.aldiwan.net/poem2017.html","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140949",""],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16635","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42733","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55119","الوافر"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67329","الطويل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199501","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/200123","الطويل"],[106,"من وحي الكأس","https://www.poetsgate.com/ViewPoem.aspx?id=179738",""],[106,"عرش هوى","https://www.poetsgate.com/ViewPoem.aspx?id=179587",""],[54,"يا حَسرة ً تَتَردَّدْ","https://www.poetsgate.com/ViewPoem.aspx?id=13882",""],[39,"نبيتُ تميماً تجتدي حربَ طيِّىء ٍ،","https://www.poetsgate.com/ViewPoem.aspx?id=4266",""],[116,"أهيم بخود عندها القلب قد فنى","https://www.aldiwan.net/poem41648.html","الطويل"],[133,"لقيت بني الشيخ الكرام عشية","https://www.aldiwan.net/poem54865.html","الطويل"],[136,"مني لسيد الزجاله","https://www.aldiwan.net/poem48846.html","عموديه"],[143,"أكرم بوجه الراكب المعنق","https://www.aldiwan.net/poem58428.html","السريع"],[151,"ألا فاخش سهم الموت عن كل مرصد","https://www.aldiwan.net/poem68588.html","الطويل"],[161,"قوامك مثل معتدل القناة","https://www.aldiwan.net/poem59052.html","الوافر"],[166,"نأت سلمى وأمست في عدو","https://www.aldiwan.net/poem719.html",""],[199,"ومرتجة الأعطاف أما قوامها","https://www.aldiwan.net/poem51967.html","الطويل"],[200,"هم الناس حى يروي الأرض مدمع","https://www.aldiwan.net/poem45406.html","الطويل"],[211,"لطائر البشر بالأفراح تغريد","https://www.aldiwan.net/poem13312.html","البسيط"],[224,"تذكرني وحقك ما نسيت","https://www.aldiwan.net/poem39692.html","الوافر"],[232,"تواضع لرب العرش علك ترفع","https://www.aldiwan.net/poem44582.html","الطويل"],[282,"دعوني وتسكاب الدموع السوافك","https://www.aldiwan.net/poem1379.html",""],[286,"رسول جاء بالبشر","https://www.aldiwan.net/poem39382.html","مجزوء الوافر"],[299,"حماة الديار","https://www.aldiwan.net/poem36297.html","عموديه"],[299,"عيون من كلامك قد","https://www.aldiwan.net/poem36803.html","عموديه"],[305,"وصلنا إلى الحي الذي دون المنى","https://www.aldiwan.net/poem16796.html","الطويل"],[305,"تفيض عيون بالدموع السواكب","https://www.aldiwan.net/poem16819.html","الطويل"],[306,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[323,"أرقت وصاحباي ببعلبك","https://www.aldiwan.net/poem56348.html","الوافر"],[365,"أقلا عند طيتي المقالا","https://www.aldiwan.net/poem60808.html","الوافر"],[381,"بنفسي جيرة شطوا","https://www.aldiwan.net/poem49213.html","مجزوء الوافر"],[394,"لقد رحلت سعدى فهل لك مسعد","https://www.aldiwan.net/poem53688.html","الطويل"],[404,"لي الله ما قلبي هو الحجر الصلد","https://www.aldiwan.net/poem33975.html","الطويل"],[417,"رمينا بأدهى المعضلات النوائب","https://www.aldiwan.net/poem54172.html","الطويل"],[442,"أذاب فؤادي ذكر ليلى ومن لها","https://www.aldiwan.net/poem14324.html","الطويل"],[442,"هو الحزن حتى ما يماثله حزن","https://www.aldiwan.net/poem14388.html","الطويل"],[442,"إليك صبت أفيدتنا ولاها","https://www.aldiwan.net/poem14392.html","الوافر"],[442,"آها لها من غصة النادم","https://www.aldiwan.net/poem14479.html","السريع"],[459,"أعلل فيكِ ببرد النسيمِ","https://www.aldiwan.net/poem55876.html","المتقارب"],[459,"نبهت سعدا والأفق","https://www.aldiwan.net/poem56086.html","مجزوء الرجز"],[462,"دلفت بجيش ذي زهاء كأنه","https://www.aldiwan.net/poem15308.html","الطويل"],[462,"وبالقصر أريحي","https://www.aldiwan.net/poem15360.html","المضارع"],[462,"منازلكم للخائفين عصام","https://www.aldiwan.net/poem16033.html","الطويل"],[466,"في رحاب الحسين","https://www.aldiwan.net/poem59034.html","عموديه"],[469,"السحب قد نصبت في الجو أروقة","https://www.aldiwan.net/poem60442.html","البسيط"],[505,"حلت حين ما حلت على المصايب","https://www.aldiwan.net/poem38413.html","الطويل"],[517,"إليك أبا حفص تعسفت الفلا","https://www.aldiwan.net/poem48702.html","الطويل"],[530,"على عصر الشبيبة كل حين","https://www.aldiwan.net/poem37469.html","الوافر"],[539,"سلام على الأدب المنتقى","https://www.aldiwan.net/poem47538.html","عموديه"],[552,"ألا لله ما صنع الحمام","https://www.aldiwan.net/poem47251.html","الوافر"],[559,"إني أنا وبينما","https://www.aldiwan.net/poem33772.html","مجزوء الرجز"],[559,"ظهرت لقلبي بما قد نوى","https://www.aldiwan.net/poem34272.html","المتقارب"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"هواي لمحبوبي الأول","https://www.aldiwan.net/poem3036.html","المتقارب"]],"verses":[["على عهد المناقب بي وإني","لمن يأبى الحفاظ له إيابا",0,"ب",2,0],["على عارِفاتٍ للطّعانِ عَوابِسٍ","طِوالِ الهَوالي مُجْفَراتِ الخواصِرِ",1,"ر",1,0],["على عَذَبِ الجَرْعاءِ منْ أيْمَنِ الحِمى","مَرادُ الظِّباءِ الأُدْمِ أو مَلْعَبُ الدُّمى",2,"م",2,1],["على عهد العلا","فلتذكر العليا عهدي",3,"د",2,0],["عَلى عَطَشٍ حَتّى بَدَت وَهيَ مَشرَعٌ","حَياضُ الهَوى مِن بَعدِ إيرادِ مَشرَعي",4,"ع",2,0],["عَلى عَجَلٍ مِني غِشاشاً وَقَد بَدا","ذُرا النَخلِ وَاِحمَرَّ النَهارُ فَأَدبَرا",5,"ر",2,0],["عَلى عَزيزٍ قَد تَوَلّى وَلَن","يَؤوبَ حَتّى يَرجِعَ القارِظانِ",6,"ن",1,0],["عَلى عَلِيِّ اِبنِ موسى اِب","نِ جَعفَرِ اِبنِ مُحَمَّد",7,"د",1,0],["عَلى عانِكٍ مِن رَملِ يَبرينَ رَشَّهُ","أَهاضيبُ تَلبيداً فَلَم يَتَهَيَّلِ",8,"ل",1,0],["عَلى عانَةٍ حُقبٍ سَماحيجَ عارَضَت","رِياحَ الصِبا حَتّى طَوَتها حُرورُها",9,"ر",3,0],["على علم الدنيا وفخر ملوكها","تحيّة ربٍّ لا يزال يُواريها",10,"ي",3,0],["عَلى عَلياءَ تَرفَعُ خَيرَ نارٍ","وَتَقدَحُ بِالوَرِيِّ مِنَ الزِنادِ",11,"د",1,0],["على عليّ معانيه وأكتمها","نعم الأمالي تلاقت نعم آمالي",12,"ل",2,0],["على عاقدِ الزُّنارِ تحت قضيبِ","من البانِ مَيَّادٍ وفوق كثيبِ",13,"ب",1,1],["على عمرو عَفاء من نديمٍ","إذا حُمدَ النديم ومن جليس",14,"س",1,0],["عَلى عاتِقِ المَلكِ الأَغَرِّ نِجادُهُ","وَفي يَدِ جَبّارِ السَمَواتِ قائِمُه",15,"م",2,0],["على عروس لبِستْ","لثامَ خَزٍّ أسودِ",16,"د",1,0],["على عارفاتٍ للطِّعانِ كأنها","دُمَىً ورواقُ النقعِ منها محاريبُ",17,"ب",1,0],["عَلى عَمائِمِنا يُلقى وَأَرحُلِنا","عَلى زَواحِفَ نُزجيها مَحاسيرِ",18,"ر",1,0],["عَلى عُصبَةٍ عُثمانُ مِنهُم وَمِنهُمُ","إِمامٌ جَلا عَنّا الظَلامَ فَأَسفَرا",19,"ر",2,0],["عَلى عَهدِ ذي القَرنَينِ كانَت سُيوفُهُم","عَمائِمَ هاماتِ المُلوكِ البَطارِقِ",20,"ق",1,0],["عَلى عاتِقَيها اِثنانِ مِنهُم وَإِنَّها","لَتُرعَدُ قَد كادَت يُقَصُّ هُزالُها",21,"ل",3,0],["عَلى عَهدِ اِبنِ مَريَمَ كانَ قَومي","هُمُ الفَرعَ المُقَدَّمَ وَالسَناما",22,"م",2,0],["عَلى عَجَلٍ مِنّي غِشاشاً وَقَد دَنا","ذُرى اللَيلِ وَاِحمَرَّ النَهارُ وَأَدبَرا",23,"ر",2,0],["عَلى عَهدِ عادٍ سامَتِ الذُلَّ طَيِّئٌ","تَميماً وَعادَت كُلَّ جَنِّ وَخابِلِ",24,"ل",1,0],["عَلى عَهدِ ذي القَرنَينِ حَتّى تَتابَعَت","عَلى سَنَنِ الإِسلامِ صيدُ المَقاوِلِ",24,"ل",1,0],["عَلى عَبراتٍ تَعتَريني لَو أَنَّها","بِجانِبِ رَضوى أَنفَذَتهُ وِهادُها",25,"د",3,0],["عَلَيَّ عَباءَةٌ بَرقاءُ لَيسَت","مِن البَلوى تُغَطّى نِصفَ ساقي",26,"ق",2,0],["عَلى عَدَدِ الأَسباطِ تَجري عُيونُها","فُراتاً زُلالاً طَعمُهُ غَيرُ حائِلِ",27,"ل",1,0],["عَلى عُقارٍ صَفراءَ تَحسَبُها","شيبَت بِمِسكٍ في الدَنِّ مَفتوتِ",28,"ت",1,0],["عَلَيَّ عَينٌ وَأُذنٌ مِن مُذَكَّرَةٍ","مَوصولَةٍ بِهَوى اللوطِيِّ وَالغَزِلِ",29,"ل",1,0],["عَلى عَينِها مِنّي السَلامُ وَإِن غَدَت","مُفارِقَةً تَخدي إِلى غَيرِ مَقعَدِ",30,"د",1,0],["عَلى عَينَي أَبي أَيّوبَ مِنّي","غِطاءٌ سَوفَ يَنكَشِفُ الغِطاءُ",31,"ا",2,0],["عَلى عارِفاتٍ لِلطِعانِ عَوابِسٍ","بِهِنَّ كُلومٌ بَينَ دامٍ وَجالِبِ",32,"ب",1,0],["على عاتق الملك الأغرّ نجاده","وفي يد جبّار السّماوات قائمه",33,"م",2,0],["على عُشَرٍ كالنخْلِ أبْدى لُغامُها","جَنى عُشَرٍ مِثلَ السبيخِ الموَضَّع",34,"ع",1,0],["على عكاظ تتبارى الجِنَّه","وفوق ذي المجاز والمجنه",35,"ه",1,0],["عَلَى عِفَّةٍ قَدْ يَعْلَمُ اللَّهُ أَنَّهَا","مُبَرَّأَةٌ مِنْ كُلِّ غَيٍّ وَبَاطِلِ",36,"ل",1,0],["عَلَى عَجَلٍ ونَحْسَبُهَا","لِمَا ثَقُلَتْ عَلَى مَهَلِ",37,"ل",1,0],["على عَادَةٍ تلكُمْ جَرَيْنَا بِصَبْرِنَا","وَقِدْماً لدى الغَايَاتِ نَجري فَنَسْبِقُ",38,"ق",1,0],["على عينيكِ ألمح برق دمعٍ","أحالكِ يا حبيبةُ مثل حالي؟",39,"ل",2,0],["علي على عليا علي علاً علا","فجل عن الاشباه والشرك والوزر",40,"ر",1,0],["عليُّ، عذرًا إذا أسرفتُ في هذري","فأنت ذو منزلٍ عندي ومقدار",41,"ر",1,0],["على عَتَباتها الهاماتُ تُحنَى","كما تْحنَي من الطَّعن الرماحُ",42,"ح",1,0],["علَى عليِّ بنِ مُوسَى","بنِ جعفرِ بنِ مَحَمَّدْ",43,"د",1,0],["علَى عهدِ عادٍ سامتِ الذُّلِّ طيِّىء","ٌ تَمِيماً، وعَادَتْ كُلَّ جِنّ وخَابِلِ",44,"ل",1,0],["على عهدها باقٍ وإن مسني العنا","غزالة سرح حبها الجوى",45,"ا",1,0],["عَلىُّ عَلىُّ من أصول عَلِيَّةٍ","ومحمودُ وصالحُ صالحُ",46,"ح",1,0],["على عزومْتين في الفسحهْ","تعمل زجلْ يطلع وشّين",47,"ن",1,0],["علىّ عَقْرُ البُدْن إن اصبحت","خيامُهم وهي رُبَى الأبرقِ",48,"ق",1,0],["عَلى عِلمِهِ ما كانَ مِن حَنَّةِ الجِذعِ","إِلى اللَهِ أَشكو حَرَّ قَلبي وَوَجدَهُ",49,"ه",1,0],["على عتباته في كل حين","ترى قممم الملوك منكسات",50,"ت",1,0],["على عمد كسوتهما قبوحا","كما أكسو نساءهما السلابا",51,"ب",2,0],["على عاتقي من ساعِديْها حمائلٌ","وفي خَصرها منْ ساعديَّ وشاح",52,"ح",1,0],["على عصبةٍِ لم يظلموا غيرَ أنهم","مفاتيحُ أمَّا قيلَ أغلق موضعُ",53,"ع",1,0],["على علاك لقد ضل العدى حسدا","ان الكريم على علياه محسود",54,"د",1,0],["عَلى عُريي نَما أَمَلاً وَلَمّا","أَظَلَّتني ذِراعاهُ كُسيتُ",55,"ت",1,0],["على عرشه خطّ اسمه ولقد عفا","لآدم إذا أضحى به يتضرع",56,"ع",1,0],["على علم الإسلامِ قامت نوادب","بهتنِ مباكٍ أو بهتم مضاحك",57,"ك",1,0],["على عجل كمرتجل","ليخدم ثاقب الفكر",58,"ر",1,0],["عَلَى عَلَمٍ ضمَّ","شملَ البلاد",59,