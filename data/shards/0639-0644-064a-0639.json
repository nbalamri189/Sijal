"من مُلح الرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=180281",""],[5183,"حائم المنية","https://www.poetsgate.com/ViewPoem.aspx?id=180264",""],[5246,"في ربوع العراص المقدسة","https://www.poetsgate.com/ViewPoem.aspx?id=187039",""],[5274,"أحلام أندلسية","https://www.poetsgate.com/ViewPoem.aspx?id=207438",""],[5277,"مشاويرُ الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=191962",""],[5277,"لزوم ما لا يلزم","https://www.poetsgate.com/ViewPoem.aspx?id=192925",""],[5277,"مِن تهجّدات البدوي الحزين","https://www.poetsgate.com/ViewPoem.aspx?id=208837",""],[592,"على الحبر بحر العلم الحقائق","https://www.poetsgate.com/ViewPoem.aspx?id=128858",""],[592,"لك الحمد اللهم يا واسع المجد","https://www.poetsgate.com/ViewPoem.aspx?id=128838",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5367,"روضُ الهُدى","https://www.poetsgate.com/ViewPoem.aspx?id=197190",""],[5376,"لنا في الشامِ أشواقٌ وعشقُ","https://www.poetsgate.com/ViewPoem.aspx?id=188345",""],[5376,"علا القدسَ في أرجائها الحقُّ والعدلُ","https://www.poetsgate.com/ViewPoem.aspx?id=188562",""],[5397,"سقيت ربوعا بالحمى ومعالما","https://www.poetsgate.com/ViewPoem.aspx?id=157964",""],[5397,"أهل بسط كف تحجب الشمس والبدرا","https://www.poetsgate.com/ViewPoem.aspx?id=157931",""],[5428,"أراني كُلّما قطعوا المزارا","https://www.poetsgate.com/ViewPoem.aspx?id=124932",""],[5431,"البردة -ريم","https://www.poetsgate.com/ViewPoem.aspx?id=190769",""],[5459,"أراك تَحنّ ..","https://www.poetsgate.com/ViewPoem.aspx?id=203153",""],[5461,"حول سحابي","https://www.poetsgate.com/ViewPoem.aspx?id=506",""],[5545,"ما تُرى أنتَ صانعُ","https://www.poetsgate.com/ViewPoem.aspx?id=184826",""],[5628,"الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=178487",""],[5732,"ما طاع عذاله","https://www.poetsgate.com/ViewPoem.aspx?id=177911",""],[5732,"من يم خلي","https://www.poetsgate.com/ViewPoem.aspx?id=177891",""],[5770,"إلى صديق","https://www.poetsgate.com/ViewPoem.aspx?id=178681",""],[5770,"شجب وأخواتها","https://www.poetsgate.com/ViewPoem.aspx?id=178721",""],[5829,"رسالة الى اوباما","https://www.poetsgate.com/ViewPoem.aspx?id=148336",""],[5837,"غيث الجهام (هلالية)","https://www.poetsgate.com/ViewPoem.aspx?id=181595",""],[5872,"هواكم بقلبي لأحكامه نسخ","https://www.poetsgate.com/ViewPoem.aspx?id=120609",""],[5872,"هواكم بقلبي ما لنحكمه نسخ","https://www.poetsgate.com/ViewPoem.aspx?id=120616",""],[5906,"فجور طيف","https://www.poetsgate.com/ViewPoem.aspx?id=188072",""],[5923,"سَأَم الجراح","https://www.poetsgate.com/ViewPoem.aspx?id=162750",""],[5969,"شِفاءْ","https://www.poetsgate.com/ViewPoem.aspx?id=204788",""],[5977,"نقّل فؤادك","https://www.poetsgate.com/ViewPoem.aspx?id=213301",""],[6019,"شهقةٌ على طريقِ وَداعِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=190730",""],[6056,"حالة وراثية","https://www.poetsgate.com/ViewPoem.aspx?id=130318",""],[6152,"جدتي الغالية رحمها الله","https://www.poetsgate.com/ViewPoem.aspx?id=203759",""],[520,"على عدن من ساكني شاطئ مصر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577559",""]],"verses":[["على عهد المناقب بي وإني","لمن يأبى الحفاظ له إيابا",0,"ب",2,0],["على عارِفاتٍ للطّعانِ عَوابِسٍ","طِوالِ الهَوالي مُجْفَراتِ الخواصِرِ",1,"ر",1,0],["على عَذَبِ الجَرْعاءِ منْ أيْمَنِ الحِمى","مَرادُ الظِّباءِ الأُدْمِ أو مَلْعَبُ الدُّمى",2,"م",2,1],["على عهد العلا","فلتذكر العليا عهدي",3,"د",2,0],["عَلى عَطَشٍ حَتّى بَدَت وَهيَ مَشرَعٌ","حَياضُ الهَوى مِن بَعدِ إيرادِ مَشرَعي",4,"ع",2,0],["عَلى عَجَلٍ مِني غِشاشاً وَقَد بَدا","ذُرا النَخلِ وَاِحمَرَّ النَهارُ فَأَدبَرا",5,"ر",2,0],["عَلى عَزيزٍ قَد تَوَلّى وَلَن","يَؤوبَ حَتّى يَرجِعَ القارِظانِ",6,"ن",1,0],["عَلى عَلِيِّ اِبنِ موسى اِب","نِ جَعفَرِ اِبنِ مُحَمَّد",7,"د",1,0],["عَلى عانِكٍ مِن رَملِ يَبرينَ رَشَّهُ","أَهاضيبُ تَلبيداً فَلَم يَتَهَيَّلِ",8,"ل",1,0],["عَلى عانَةٍ حُقبٍ سَماحيجَ عارَضَت","رِياحَ الصِبا حَتّى طَوَتها حُرورُها",9,"ر",3,0],["على علم الدنيا وفخر ملوكها","تحيّة ربٍّ لا يزال يُواريها",10,"ي",3,0],["عَلى عَلياءَ تَرفَعُ خَيرَ نارٍ","وَتَقدَحُ بِالوَرِيِّ مِنَ الزِنادِ",11,"د",1,0],["على عليّ معانيه وأكتمها","نعم الأمالي تلاقت نعم آمالي",12,"ل",2,0],["على عاقدِ الزُّنارِ تحت قضيبِ","من البانِ مَيَّادٍ وفوق كثيبِ",13,"ب",1,1],["على عمرو عَفاء من نديمٍ","إذا حُمدَ النديم ومن جليس",14,"س",1,0],["عَلى عاتِقِ المَلكِ الأَغَرِّ نِجادُهُ","وَفي يَدِ جَبّارِ السَمَواتِ قائِمُه",15,"م",2,0],["على عروس لبِستْ","لثامَ خَزٍّ أسودِ",16,"د",1,0],["على عارفاتٍ للطِّعانِ كأنها","دُمَىً ورواقُ النقعِ منها محاريبُ",17,"ب",1,0],["عَلى عَمائِمِنا يُلقى وَأَرحُلِنا","عَلى زَواحِفَ نُزجيها مَحاسيرِ",18,"ر",1,0],["عَلى عُصبَةٍ عُثمانُ مِنهُم وَمِنهُمُ","إِمامٌ جَلا عَنّا الظَلامَ فَأَسفَرا",19,"ر",2,0],["عَلى عَهدِ ذي القَرنَينِ كانَت سُيوفُهُم","عَمائِمَ هاماتِ المُلوكِ البَطارِقِ",20,"ق",1,0],["عَلى عاتِقَيها اِثنانِ مِنهُم وَإِنَّها","لَتُرعَدُ قَد كادَت يُقَصُّ هُزالُها",21,"ل",3,0],["عَلى عَهدِ اِبنِ مَريَمَ كانَ قَومي","هُمُ الفَرعَ المُقَدَّمَ وَالسَناما",22,"م",2,0],["عَلى عَجَلٍ مِنّي غِشاشاً وَقَد دَنا","ذُرى اللَيلِ وَاِحمَرَّ النَهارُ وَأَدبَرا",23,"ر",2,0],["عَلى عَهدِ عادٍ سامَتِ الذُلَّ طَيِّئٌ","تَميماً وَعادَت كُلَّ جَنِّ وَخابِلِ",24,"ل",1,0],["عَلى عَهدِ ذي القَرنَينِ حَتّى تَتابَعَت","عَلى سَنَنِ الإِسلامِ صيدُ المَقاوِلِ",24,"ل",1,0],["عَلى عَبراتٍ تَعتَريني لَو أَنَّها","بِجانِبِ رَضوى أَنفَذَتهُ وِهادُها",25,"د",3,0],["عَلَيَّ عَباءَةٌ بَرقاءُ لَيسَت","مِن البَلوى تُغَطّى نِصفَ ساقي",26,"ق",2,0],["عَلى عَدَدِ الأَسباطِ تَجري عُيونُها","فُراتاً زُلالاً طَعمُهُ غَيرُ حائِلِ",27,"ل",1,0],["عَلى عُقارٍ صَفراءَ تَحسَبُها","شيبَت بِمِسكٍ في الدَنِّ مَفتوتِ",28,"ت",1,0],["عَلَيَّ عَينٌ وَأُذنٌ مِن مُذَكَّرَةٍ","مَوصولَةٍ بِهَوى اللوطِيِّ وَالغَزِلِ",29,"ل",1,0],["عَلى عَينِها مِنّي السَلامُ وَإِن غَدَت","مُفارِقَةً تَخدي إِلى غَيرِ مَقعَدِ",30,"د",1,0],["عَلى عَينَي أَبي أَيّوبَ مِنّي","غِطاءٌ سَوفَ يَنكَشِفُ الغِطاءُ",31,"ا",2,0],["عَلى عارِفاتٍ لِلطِعانِ عَوابِسٍ","بِهِنَّ كُلومٌ بَينَ دامٍ وَجالِبِ",32,"ب",1,0],["على عاتق الملك الأغرّ نجاده","وفي يد جبّار السّماوات قائمه",33,"م",2,0],["على عُشَرٍ كالنخْلِ أبْدى لُغامُها","جَنى عُشَرٍ مِثلَ السبيخِ الموَضَّع",34,"ع",1,0],["على عكاظ تتبارى الجِنَّه","وفوق ذي المجاز والمجنه",35,"ه",1,0],["عَلَى عِفَّةٍ قَدْ يَعْلَمُ اللَّهُ أَنَّهَا","مُبَرَّأَةٌ مِنْ كُلِّ غَيٍّ وَبَاطِلِ",36,"ل",1,0],["عَلَى عَجَلٍ ونَحْسَبُهَا","لِمَا ثَقُلَتْ عَلَى مَهَلِ",37,"ل",1,0],["على عَادَةٍ تلكُمْ جَرَيْنَا بِصَبْرِنَا","وَقِدْماً لدى الغَايَاتِ نَجري فَنَسْبِقُ",38,"ق",1,0],["على عينيكِ ألمح برق دمعٍ","أحالكِ يا حبيبةُ مثل حالي؟",39,"ل",2,0],["علي على عليا علي علاً علا","فجل عن الاشباه والشرك والوزر",40,"ر",1,0],["عليُّ، عذرًا إذا أسرفتُ في هذري","فأنت ذو منزلٍ عندي ومقدار",41,"ر",1,0],["على عَتَباتها الهاماتُ تُحنَى","كما تْحنَي من الطَّعن الرماحُ",42,"ح",1,0],["على عجمات الصبر شجت قلوبنا","ليمتاز رخو الصبر بين صلابها",43,"ب",3,0],["علَى عليِّ بنِ مُوسَى","بنِ جعفرِ بنِ مَحَمَّدْ",44,"د",1,0],["علَى عهدِ عادٍ سامتِ الذُّلِّ طيِّىء","ٌ تَمِيماً، وعَادَتْ كُلَّ جِنّ وخَابِلِ",45,"ل",1,0],["على عهدها باقٍ وإن مسني العنا","غزالة سرح حبها الجوى",46,"ا",1,0],["عَلىُّ عَلىُّ من أصول عَلِيَّةٍ","ومحمودُ وصالحُ صالحُ",47,"ح",1,0],["على عزومْتين في الفسحهْ","تعمل زجلْ يطلع وشّين",48,"ن",1,0],["علىّ عَقْرُ البُدْن إن اصبحت","خيامُهم وهي رُبَى الأبرقِ",49,"ق",1,0],["عَلى عِلمِهِ ما كانَ مِن حَنَّةِ الجِذعِ","إِلى اللَهِ أَشكو حَرَّ قَلبي وَوَجدَهُ",50,"ه",1,0],["على عتباته في كل حين","ترى قممم الملوك منكسات",51,"ت",1,0],["على عمد كسوتهما قبوحا","كما أكسو نساءهما السلابا",52,"ب",2,0],["على عاتقي من ساعِديْها حمائلٌ","وفي خَصرها منْ ساعديَّ وشاح",53,"ح",1,0],["على عصبةٍِ لم يظلموا غيرَ أنهم","مفاتيحُ أمَّا قيلَ أغلق موضعُ",54,"ع",1,0],["على علاك لقد ضل العدى حسدا","ان الكريم على علياه محسود",55,"د",1,0],["عَلى عُريي نَما أَمَلاً وَلَمّا","أَظَلَّتني ذِراعاهُ كُسيتُ",56,"ت",1,0],["على عرشه خطّ اسمه ولقد عفا","لآدم إذا أضحى به يتضرع",57,"ع",1,0],["على علم الإسلامِ قامت نوادب","بهتنِ مباكٍ أو بهتم مضاحك",58,"ك",1,0],["على عجل كمرتجل","ليخدم ثاقب الفكر",59,"ر",1,0],["عَلَى عَلَمٍ ضمَّ","شملَ البلاد",60,"د",1,0],["عَلَى عيني التي نظرتْ","أَلَحَّ الدمعُ والسهدُ",61,"د",1,0],["عَلى عَرفات الخَير وَالعَفو وَالرِضا","لِمَن كانَ مِنا مُحسِناً وَلِمَن جَنى",62,"ن",2,0],["على عمل للعلم غير موافق","وما فضل علم دون فعل مناسب",63,"ب",1,0],["عَلى عوائقَ مِن شغلٍ ومن سقمٍ","خالَستها فرصاً كالطيف تغتنمُ",64,"م",1,0],["عَلى عَودٍ تُعُبِّدِ قَبلَ عادٍ","كَأَنَّ مُتونَهُ تَسبيجُ شِركِ",65,"ك",1,0],["على عَدَدِ الثّلاثةِ من شهابٍ","وأسْعَد فامْتثِلْهنّ امْتِثالا",66,"ل",2,0],["عَلى عُشاقِهِ أَبَداً","بِسَيف صُدودهِ يَسطو",67,"ط",2,0],["عليّ عَلِيّ في المَواقِف كُلِّها","وَلكِنَّكُم قَد خانَكم فيه مَولد",68,"د",1,0],["عليَّ علا مجداً وعلماً وسؤدداً","وكل أديب عند آدابه عبد",69,"د",1,0],["على عمر الرماضان ذي الفضل والنهى","أحاطت بي الأحزان من كلِّ جانب",70,"ب",1,0],["على عقب لا يقضون فرضاً وسنةً","وتفل اكتساب بالتجارة جلها",71,"ل",3,0],["على عبدك المختار صل محمد","مدى قصدت ليلى معملة هجن",72,"ن",1,0],["على عجل بلطفك يا كريم","أغثها بعد محل قد عفاها",73,"ا",3,0],["على علي بن أبي القاسم","تبكي العلا بالمدمع الساجم",74,"م",1,0],["على عمل بالتقى ضيِّقٍ","خفيّ وملكٍ وسيع وسيمِ",75,"م",1,0],["على عميد الرؤسا","ء وقفَ الظنُّ المحقّْ",76,"ق",1,0],["على عطفه من مجدهِ أريحيَّةٌ","به نشوةٌ منها وما دارتِ الخمرُ",77,"ر",1,0],["على عَزْمِه مضاءٌ","وفي عِطفْهِ وقارُ",78,"ر",1,0],["على عِطفهِ عُلْويَّةٌ من سكينةٍ","أنالتْهُ سِرَّ اللّهِ وهو غُلامُ",79,"م",1,0],["عليُّ..عليَّ الهُُدى والجهاد","عَظُمتَ لدى اللهِ من مُسلمِ",80,"م",1,0],["عَلى عَمائشمِ ريحانٍ مُلَوَّنَةٍ","لَها مِنَ الخَضرِ مِن أَوراقِهِ عَذَبُ",81,"ب",1,0],["على عناداً لو تقدم جاهلٌ","فما انا للأيام فيه معايب",82,"ب",1,0],["عَلى عادَة كانَت لَنا مِنكَ اِنَّما","جَرَت لِلَّذي كانَت عَلَيكُم تُعَوَّدُ",83,"د",1,0],["عَلَى عَصْرِ الشَّبِيبةِ كُلَّ حِينِ","سَلاَمٌ ما تَقَهْقَهتِ الرُّعُودُ",84,"د",1,1],["على عُمدةِ المَلكِ مَن مُلكُنا","به قد زَهَا وازدَهى وارتَقَى",85,"ق",2,0],["على عَبِقِ الثّرى خَضِلِ النّواحي","وإنْ لم يُستَهلَّ له الغَمامُ",86,"م",1,0],["على عقائدٍ لهم","لأنها خلق الدُّنا",87,"ن",2,0],["على عشقك القلب من علَّهُ","وأما الذي أنت أهل لهُ",88,"ه",1,0],["على علي وتبروا منهما","وقال قوم حين خلى عنهما",89,"م",2,0],["على علي ما أقام فيهم","لكنهم ولى عليهم منهم",89,"م",1,0],["عليٌّ علا فوق أُفق السَّمَا","وباتَ يرى النجم مِنْ أَسْفَل",90,"ل",1,0],["عليّ عزّ بأن تبقى رهين ثرى","موزّع الجسم شلو عافر البدنِ",91,"ن",1,0],["عليّ عليه رُدتْ الشمسُ مَرَّةً","بِطَيْبَةَ يوم الوَحْيِ بعدَ مَغيبِ",92,"ب",1,1],["على عمدٍ يدعوكَ ماء صفائها","إليهِ فلولا جمدُها كُنتَ تكرعُ",93,"ع",1,0],["عَلى عَدوّ ذَميمِ","فَفرّ من ذا العَميدِ",94,"د",1,0],["على عليٍّ بِبرٍّ","في الخُلد زادَ سَناهُ",95,"ه",1,1],["عَلى عامِلينا وَالسُيوفُ مَصونَةٌ","بِأَغمادِها ما زايَلَتها نِصالُها",96,"ل",3,0],["على عهد ذي القرنين كانت مجاشع","أعزاء لا يسطيعها من يضيمها",97,"م",3,0],["على عجل سيروا العجلات","تقل من العين والدر جما",98,"ا",1,0],["عَلى عُبَيْدِكَ الرّقيقِ الحرِّ","مَنْ ودُّه يوصَفُ بِالأَبرِّ",99,"ر",1,0],["على عدوِّك يا ابنَ الأكرمينَ مدى","أيامه رصدان الصبحُ والظُّلَم",100,"م",1,0],["على عَرْشِ خَدَّيْهَا اسْتَوى الخَالُ فَاهْتَدَى","لِطُورِ سَنَاهَا القلبُ مِنْ كُلّ جَانِبِ",101,"ب",1,0],["عليّ علوت الناس قدرا ورفعةً","تساعدك الدنيا ويخدمك الدهر",102,"ر",1,0],["على عهد عثمان وفدنا وقبله","وكنا أولي مجد تليد وطارف",103,"ف",1,0],["على عطوى وإن بعدت سلام","سلام كلما ذكر السلام",104,"م",1,1],["على عَيشٍ تَقَضَّى لي حَميدٍ","نَعِمْتُ بهِ وزايلَني كَأَنِّي",105,"ن",2,0],["على عروش قلوب أنتِ جالسةٌ","وتاجك الحسن أعظم بالبها جاها",106,"ا",3,0],["على عطفها قلب المتيم طائر","وفي شرك الأجفان بالسحر واقع",107,"ع",1,0],["على عزّ هذا الدين والملّة التي","لحقتها فازت بفضل التقدّم",108,"م",1,0],["عَلى عَهدِها أَوقَفتُ عِقيانَها الَّذي","مُنَضَّدُهُ مِن ذَوبِ قَلبي تَجَسَّما",109,"م",2,0],["على عنتريس عيطموس شملّة","زفوف خنوف نسعها قد تقطّعا",110,"ع",2,0],["عَليٌّ عانَقَتْ يُمْناهُ طُرّاً","كُعوبَ رِماحِهِ دونَ الكِعابِ",111,"ب",1,0],["عَليُّ عابِسٌ طَلِقُ المُحَيّا","مضاعُ المالِ مَحْمِيُّ الْجنابِ",111,"ب",1,0],["على عدد الأنفاس ذكرك في فمي","وشخصك في قلبي وعهدك في بالي",112,"ل",2,0],["على 