/ViewPoem.aspx?id=122913",""],[5690,"صدقتم لحظهُ لحظ الغزالِ","https://www.poetsgate.com/ViewPoem.aspx?id=172173",""],[5690,"إذا الصارم البتار عزت مضاربه","https://www.poetsgate.com/ViewPoem.aspx?id=172139",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5756,"الليالي السرمدية","https://www.poetsgate.com/ViewPoem.aspx?id=5438",""],[5768,"أَخَاكَ .. أَخَاكَ","https://www.poetsgate.com/ViewPoem.aspx?id=215592",""],[5791,"نصٌّ مقلوب ..!","https://www.poetsgate.com/ViewPoem.aspx?id=213016",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[5848,"طعنة احباب","https://www.poetsgate.com/ViewPoem.aspx?id=50596",""],[5953,"ألا يا رجال الحق بالحق أبشروا","https://www.poetsgate.com/ViewPoem.aspx?id=93852",""],[5377,"صوت الله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79570&r=&rc=26",""],[5724,"أحجاج بيت الله ألف تحية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55154&r=&rc=21",""],[4960,"الليلية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87988&r=&rc=0",""],[6360,"شَغَبْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87598&r=&rc=1",""]],"verses":[["وَإِنْ ذَكَروا آباءَهُمْ فَوُجوهُهُمْ","تُشَبِّهُها قِطْعاً مِنَ اللَّيلِ مُظْلِما",0,"م",2,0],["وإنْ ذُكِرَتْ مَفاخِرُهُ ابْتَدَرْنا","مهَبَّ الطّيبِ يُنْتَشَقُ انْتِشاقا",1,"ق",2,0],["وَإِنْ ذُكِرَ الإِخْوَانُ مَنْ مثِلُ أحمَدٍ","ألاَ كُلّ مَرْعىً بَعْدَهُ غَيْرُ سَعْدَانِ",2,"ن",1,0],["وَأَنذَرتُكُم قَوماً لَكُم تَظلِمونَهِم","كِراماً فَإِن لا يَنفَدِ العَيشُ تَلتَقوا",3,"ق",3,0],["وَإِن ذَكَروا مِنهُ الحَماسَ حَسِبتَنا","نَرى الصارِمَ المَخضوبَ خَدّاً مُوَرَّدا",4,"د",2,0],["وَأَنذِر خَليلَكَ مِن ماهِرٍ","بِطِبِّ الجُنونِ إِذا ما عَرَض",5,"ض",1,0],["وَإِن ذُكِرَ المَجدُ أَلفَيتَهُ","تَأَزَّرَ بِالمَجدِ ثُمَّ اِرتَدى",6,"د",2,0],["وَإِنَّ ذِيادَ اللَيلِ لا تَستَطيعُهُ","وَلا الصُبحَ حَتّى يَستَنيرَ فَيَسطَعا",7,"ع",2,0],["وَأَنذَرَنا ناراً وَبَشَّرَ جَنَّةً","وَعَلَّمَنا الإِسلامَ فَاللَهَ نَحمَدُ",8,"د",1,0],["وإن ذقن منًّا من حلاوة ريقه","أتانا رقيب يتبع المنّ بالأذى",9,"ذ",2,0],["وإن ذكرت أفق بيتٍ قد نما","فانْصب وقل كم كوكباً يحوي السما",10,"م",2,0],["وَإِن ذَكَرَ الناسُ القَديمَ وَجَدتَنا","لَنا مِقدَحا مَجدٍ وَلِلناسِ مِقدَحُ",11,"ح",1,0],["وأنذر إن تفضل صوم عام","ومثلي من يصوم ومن يصلى",12,"ل",2,0],["وَأَنَّ ذا الأَسوَدَ المَثقوبَ مِشفَرُهُ","تُطيعُهُ ذي العَضاريطُ الرَعاديدُ",13,"د",1,0],["وإن ذُقتما السُّلوانَ بعدِي فإنَّني","وحقِّ الهَوى لم أسْلُ حتى أراكما",14,"م",2,0],["وإن ذكري شائعٌ ذائعٌ","وذكرُهُم أخفى منَ الوهمِ",15,"م",1,0],["وَأَنَّ ذَوي الأَمولِ أَضحَوا وَما لُهُم","لَهُم عِندَ أَبوابِ المُلوكِ شَفيعُ",16,"ع",1,0],["وَإنْ ذَهَبَتْ بالنارِ عنه زَخَارِفٌ","فما ضَرَّهُ منها ذَهابٌ وَلا فَقْدُ",17,"د",1,0],["وَإِن ذُكِرَ الجَعدِيِّ أَذرَيتَ عَبرَةً","وَقُلتَ أَدالَ اللَهُ مِن كُلِّ ظالِمِ",18,"م",1,0],["وَأَنذَلُ مَن يَمشي ضُبَيعَةُ إِنَّهُم","زَعانِفُ لَم يَخطُب إِلَيهِم مُحَجَّبُ",19,"ب",1,0],["وَإِن ذَهَبَت كَالفَيءِ فَهِيَ كَمَغنَمٍ","يُحازُ وَلم يُفرَد لِخالِقِهِ الخُمسُ",20,"س",1,0],["وإن ذَهَلَتْ عمّا أجِنّ صُدورُها","فقد ألهَبَتْ وَجْداً نُفوسَ رِجال",21,"ل",1,0],["وَإِنَّ ذِكْرَاهُ وَزِيدَتْ بِمَا","جَدَّدْتِ لَنْ تُنْسَى وَلَن تَخْمُلاَ",22,"ل",2,0],["وإن ذَرَفَتْ من جَفْن دِجْلَةَ دمْعَةٌ","رأيتَ دموعَ النيلِ حَيْرَى تَصَبَّبُ",23,"ب",1,0],["وان ذكر الدنيا تفانى وأصعقت","مشاعرة تلك الصعاب القوارع",24,"ع",1,0],["وأنَّ ذاكَ الخفيفَ الروحِ يُوحشُه","بيتٌ ثقيلٌ على الأحياءِ مَثواه",25,"ا",2,0],["وأنَّ ذوي الأموالِ أضحَوْا وما لهُمْ","لَهُمْ عِنْدَ أَبْوَابِ المُلُوكِ شَفِيعُ",26,"ع",1,0],["وإن ذُكرَت تَذَكَّرَ خَوطَ بَانٍ","عَلَى دِعصٍ وأُمَّ طَلاً خَذُولا",27,"ل",2,0],["وإِن ذُقتَ صَافِيَةً قَرقَفاً","تَذَكَّرتَ صَافِيَهُ القَرقَفَا",28,"ف",2,0],["وإن ذَكَرتكِ نَفسِى في شَرَابٍ","اكَادُ أغُصُّ مِن ذاك الشرابِ",29,"ب",1,0],["وأنذرت النّهي فصمم","ت عما ألفت النّذر",30,"ر",1,0],["وَإِن ذَكَروهُ في النَدى قُلتُ ماجِدٌ","وَهوبٌ لِجُلِّ المالِ حُلوٌ شَمائِلُه",31,"ل",2,0],["وَأنذُرُ للرَّحمنِ مَا دُمتِ أَيِّماً","وَهَل أنتَ يا رَبَّ العُلاَ مُوجِبٌ نَذرِى",32,"ر",2,0],["وإن ذكروا الصهباء فالقفص دارها","وأرض أوانا معدن القصف والخمر",33,"ر",1,0],["وَإِن ذُكِرَت بينَ الورى غزواتهُ","فَقدِّم عليها في سماءِ العُلا بدرا",34,"ر",2,0],["وان ذكروا ندًّ لعلمك في الورى","فلن يذكروا في هذه أبداً ندَّا",35,"د",2,0],["وإن ذكر التاريخَ يوما بُمقتَضَى","بلاغته حَلَّى الزمانَ الذي مَرَّا",36,"ر",2,0],["وان ذا اللب في تصوره","اصدق في القول من منجمه",37,"م",2,0],["وإن ذكرناكِ هزّتنا حمَيّتُنا","فمثلُ ماويةِ الأغصانِ ذكراك",38,"ك",1,0],["وان ذكروا لَيلى ولبنى فانني","بذكر الحَبيب الطيب الذكر ملهج",39,"ج",1,0],["وان ذكر وانجىّ الطور فاذكر","نجيّ العرش مفتَقرا لتغنى",40,"ن",2,0],["وإن ذهلت عني تهاويل شقوتي","تحايلت حتى لا أفيق لسامري",41,"ر",2,0],["وإن ذاكر الله","كحى بين أموات",42,"ت",1,0],["وَأَنَّ ذُنوبَ الناسِ أَجمَع كَسبُهُم","بِاِحداثِها من دونِهِ قَد تَفَرَّدوا",43,"د",3,0],["وأن ذاكرتي صارت مغلقة","عن غير ذكراك لم تحفل بما حصلا",44,"ل",2,0],["وإنّ ذِكْر أبي حفْصٍ وصحِبهِ","عثمان يَعْلُو بهِ يومَ اللِّقَا جاهي",45,"ي",1,0],["وإن ذُكِرَت شهواتُ النفوسِ","فما تشتهي غيرَ أن تشتهِي",46,"ت",3,0],["وإن ذكروا له خلقاً وخلقاً","فَقُلْ ما شئت بالخلق الحميد",47,"د",1,0],["وأنذرهم بطشاً شديداً وسطوةً","وبالغ بالرُّسْلِ الكرام وبالنّذر",48,"ر",1,0],["وإِن ذَمُّوا المِصاع لِحَرِّ بأْسٍ","فقد حمدوكَ في ذَمِّ المصاعِ",49,"ع",1,0],["وإِنْ ذَبُلَتْ من دَوْحَةِ المُلْكِ نَضْرَةٌ","فما أَوْحَشَ الدُّنْيا جَنِيُّ قُطُوفِها",50,"ف",3,0],["وإِن ذابَ حُرُّ الوجْهِ من حَرِّ نارِهِمْ","فما مُسْتَغَاثِي منهُ إِلّا إِلَى المُهْلِ",51,"ل",1,0],["وأنذره بدلّانٍ وُسومٌ","على الأعناق ثابتةٌ بواقي",52,"ق",2,0],["وأَنذُر إن أدركتُها فيك منسكاً","أقوم به فاليوم قد وجبَ النذرُ",53,"ر",1,0],["وإن ذكرتُ وهمُ في محضرٍ","أو مجلسٍ حاكمهُ من يعلم",54,"م",1,0],["وإن ذقت طعم الجمع للضد عندما","تخالفت الأعيان أنت امتناعه",55,"ع",2,0],["وإنْ ذَكرتي في المَقامِ لَهْفتي","عن لَوعتي ووَلهي فأفْصحي",56,"ح",2,0],["وَاِنذُر بالهِجرانِ نَفسي اروضها","لِتَعلَمَ عِندَ الهَجرِ هَل لي مِن صَبر",57,"ر",1,0],["وإن ذكر الأكابر في حماءٍ","لأنت المعدن الصافي المديمُ",58,"م",1,0],["وَإِن ذعرَ الزّمانُ فَأَنتَ رُكني","أَلوذُ بِهِ مِن الخططِ العظامِ",59,"م",1,0],["وإنْ ذبلتْ أغصان قومٍ فلا رأتْ","لغصنك عينٌ للزّمان ذبولا",60,"ل",2,0],["وإن ذهبَ الكبيرُ ولم يُؤَثِرْ","فليسَ نخافُ مِن أثَرِ الصَّغيرِ",61,"ر",1,0],["وإِنَّ ذَا عِنْدَه قَلِيلٌ","وفي ندى كفِّه كَذَرَّه",62,"ر",2,0],["وإن ذكروا يوماً حديثاً مجوزاً","لذلك في البنيان غير مفندد",63,"د",1,0],["وإن ذكرتُ صفاتٍ عندكِ اجتمعتْ","دون المِلاح كإكرامٍ وإشفاقِ",64,"ق",1,0],["وأنذرونا فزدناكم مظاهرة","حتى اكتفيتم وما أغنتهم النذر",65,"ر",1,0],["وإنْ ذممْتَ فأظهِرْ ما بدا لك مِنْ","نطقِ البذا كلَّ موجودٍ ومعدومِ",66,"م",1,0],["وأنذُرُكم مصائرَ قوم نوحٍ","وكانت أمةً فيها انتشارُ",67,"ر",1,0],["وَإِنَّ ذَوي الإِقدامِ وَالصَبرِ وَالنُهى","لإخوانِنا ذُهلٌ عَلى اللزباتِ",68,"ت",1,0],["وَإِن ذَكَرُوا الأَحساءَ فَالقَلبُ خافِقٌ","كَما خَفَقَت بِالرَاحَتَينِ المرَاوِحُ",69,"ح",1,0],["وإن ذكرت دنيا اعتبرت وإن جرى","لأخراك ذكر كنت منشرح الصدر",70,"ر",1,0],["وإن ذكر الجبار رجل جلاله","نشرت على العلياء أولةي الفخر",70,"ر",1,0],["وأنذر النطقاء الصادقون بما","يكون من أمره والطهر لم يكن",71,"ن",1,0],["وَإِن ذُكِرَ الحِلمُ المُزَيِّنُ أَهلَهُ","فَمَا الحِلمُ عَنهُ يَومَ ذَاكَ بِغَائِبِ",72,"ب",1,0],["وَإِن ذَهِلت نَفسِى وَأَذهِبَ دَاؤُهَا","فمَا دَاءُ نَفسِى مِن حَكِيمٍ بِذَاهِبٍ",72,"ب",1,0],["وَإِنْ ذَوُو التاجِ وَغَيْرِ التَاجِ","تَنَاهَبُوا الفَضْلَ بِحَظٍّ زاجِ",73,"ج",1,0],["وان ذكرتكَ في انس تتابع أو","في عابسٍ من وجوه الدهر مُحتدمِ",74,"م",1,0],["وأنذرتنا بوقفٍ غير منفصلٍ","ووصل حبل اتحادٍ غير منصرم",75,"م",1,0],["وان ذكر العشاق سعدا وزينبا","في غنية بالساكنين ربى عمد",76,"د",1,0],["وإن ذَكَرَ الثلاثَ أُنَاسٌ إِنَّا","لفي وادٍ وما ذَكَرُوا بِوَادِ",77,"د",1,0],["وَأَنذرتَنا مِن نارِ كُلِّ شَقاوَةٍ","وَبَشَّرت مَن أَضحى حَنيفاً مُوحِّدا",78,"د",2,0],["وإن ذكرت أيام رامة أنثني","وفي القلب من فرط الغرام هجيرُ",79,"ر",1,0],["وإن ذَاقَ من دُنيَاهُ طَعمَاً تَخَالُهُ","لَدَى سَمُراتِ الحيِّ ناقِف حَنظَلِ",80,"ل",1,0],["وأنذرني عِقدُ الثمانينَ بالبلَى","فها هي أعضائي من الضَّعفِ ترتعش",81,"ش",1,0],["وأنذرُ بالهجرانِ نفسِي أروضُها","لأعلمَ عندَ الهجرِ هل ليَ من صبرِ",82,"ر",1,0],["وإِن ذهلا لأهل للتقى ومَتى","حليته كَرماً أَظهرت برهانا",83,"ن",2,0],["وإن ذكرَ الإِقدامُ والبأسُ في الوغى","فأنت الشُّجاعُ الشَّمريُّ المجرَّبُ",84,"ب",1,0],["وأن ذكروا فخر العقائل أحرزت","قلائد قصب السبق فى حَلبَةِ الفَخرِ",85,"ر",1,0],["وإن ذكرت يوماً يزيدَ وفتكَهُ","بعترة طه المصطفى امتلأت بشرا",86,"ر",2,0],["وإنّ ذاك الذّي يدعونه وطناً","عند الحقيقة أمسى ليس بالوطن",87,"ن",1,0],["وإن ذكرت باريسُ سعداً وصحبه","عرا القوم من حمى السياسة ما يعرو",88,"ر",2,0],["وإن ذكروا أبناء فرعون رجَّعت","مناقبهم وُرقٌ من الفخر هُتَّف",89,"ف",1,0],["وإن ذكر المجد الأثيل سما به","لعدنان من آبائه طرفان",90,"ن",1,0],["وَإِن ذُكِرَ المَجدُ القَديمُ فَإِنَّما","يَقُصُّ عَلَينا ما تَنَزَّلَ في الزُبرِ",91,"ر",1,0],["وإن ذكرت أرض سواها وخرّد","بأرض سوى ساحاتها خرج الحرف",92,"ف",1,0],["وَأنْذَرَ مَولاهُ بِأنَّ وَرَاءَهُ","تَمَام جَلالٍ هَذَّبَتْهُ التَجَارِبُ",93,"ب",1,0],["وإن ذهب العضوان منه تكاملت","له ديةٌ موفورةٌ ليس تجهلُ",94,"ل",1,0],["وإن ذهبت عيناه من حين ضربه","أميت قصاصاً أو يزولُ السبهلل",94,"ل",1,0],["وإن ذكروا سلعاً تسَلسَل دمعهُ","تراهُ على الخدّينِ مجراهُ أزرَقُ",95,"ق",1,0],["وان ذكرت امير الشعر شاعرهم","كبرت تكبير اعجاب واجلال",96,"ل",1,0],["وان ذكرته بالأمر أرغى","وازبد واستحقيت انتقامه",97,"م",2,0],["وإنَّ ذلك من خلقي ومن شيمي","ليس التكرُّم من شأني ومن عملي",98,"ل",2,0],["وان ذوي الإدراك لولا بيانه","لما فهموا الغازها والاحاجيا",99,"ي",2,0],["وان ذلك مولود متى سقطت","انواره تلق بدرا جل عن كلف",100,"ف",1,0],["وان ذكر الكرام فانت منهم","اميرٌ قد زكا خبراً وخبرا",101,"ر",2,0],["وإن ذكرت يوما أهيم بذكرها","وأسقى وهاد الأرض بالأدمع الحمر",102,"ر",1,0],["وإن ذكرَ الخليجَ وسكانيهِ","يعَوّض عنهما بردى ومزَّه",103,"ز",2,0],["وإن ذا الانشقاق الفَخم أَكسبه","من قلبه نسبة مبرورة القسَم",104,"م",1,0],["وإن ذكر الغوير شدا وغنى","وخفَّ عليه تكرار المعادِ",105,"د",1,0],["وإن ذكر السلوان عني فويله","من الزور والبهتان والسعي في حربي",106,"ب",2,0],["وَإِن ذكر السامون فاذكر كَنانة","عَلا في المَعالي عَن مُعاونة الأَعدا",107,"د",2,0],["وَإِن ذكرت اسمهُ للميت في جدث","أَحيا اسمهُ حينَ يدعى دارس الرمم",108,"م",1,0],["وإن ذكرُوا مجدا فإنّ مُحمّدا","له في العلى ذكر لمن يتدبّرُ",109,"ر",1,0],["وان ذكرت أجنبيا عنهم","ولا يليق ان يعد منهم",110,"م",1,0],["وإن ذكرناها فتحنَا الكتاب","ثمّ اجتمعنَا بينَ تلك السّطور",111,"ر",1,0],["وأنذالٌ للاستعبادِ حِيكوا","وما في الفخرِ يَشركُنا شَرِيك",112,"ك",1,0],["وانذرني الشيب المفند للفتى","ولم يصغ سمعي للعذول المفند",113,"د",1,0],["وإن ذكروا له سكان نجد","يميل كأنما سقي المدامه",114,"م",2,0],["وأَنذَرَنا إِنذارَ افضلِ ناصحٍ","إذا مَحَضَ النُصحَ الجميلَ وأَخلَصا",115,"ص",2,0],["وَإِن ذكروا وصالاً من حَبيبٍ","أَقول عدمتَ يا يومَ التَنائي",116,"ي",1,0],["وَأَنذركم ما جرب الناس قَبلكم","فردّتكم الأهَواء عَن ذاكَ بِالإفك",117,"ك",1,0],["وإن ذكر الغر الكرام بمجلس","فقومي لعمري غره وكرامه",118,"م",2,0],["وان ذكر الندى فيداه غيث","تسح الجود والمنن الجساما",119,"م",2,0],["وإن ذوي الإيمان والعلم والنهى","هم الغربا طوبى لهم ما تغربوا",120,"ب",3,0],["وإن ذكرت الآؤكم في دجنة","بدا من نضاعيف الدجى وضح الفجر",121,"ر",1,0],["وإن ذاك الحريق المنكمي حنقٌ","وغن ذاك الدخان المعتلي دخن",122,"ن",1,0],["وإن ذُكر الملوكُ غداةَ رَوْعٍ","فإني نِعم خَوَّاضُ اللُّهامِ",123,"م",1,0],["وأنذرت قومها الرهبان قائلة","بأنّ دينهم قد زال أو كادا",124,"د",2,0],["وإن ذَخِرَ الأقوامُ نُسكَ عِبادة","فحبُّكَ أَوفى عُدَّتي وذَخائِري",125,"ر",2,0],["وَإِنَّ ذا القَصرِ حَيٌّ ما بِهِ وَطَني","لَكِن بِمكَّةَ أَمسى الأَهلُ والوَطَنُ",126,"ن",1,0],["وإنَّ ذلكَ عندَ اللّه محتسبٌ","في الحشر من أَفضل الطاعات والقُرَبِ",127,"ب",1,0],["وإن ذرَّ جنح الليل بدر جمالها","تبيت البدور التمّ ابناءَ لَيلةِ",128,"ه",1,0],["وإن ذُكِر الإطهار تسمو طهارةً","وهل تعرف التدنيس شمسٌ تجلَّتِ",129,"ت",1,0],["وإن ذاق في يوم من الشهد جرعةً","فيصبح ذاك الشهد في حلقهِ مُرّا",130,"ر",2,0],["وإنَّ ذوي المكرما","تِ قد أصبحوا في الثرى",131,"ر",2,0],["وَأُنْذِرُوا لَو يُوَقَّوْنَ الرَّدَى بِنِقَمْ","لكِنَّهُمْ مِن عَمىً لَجُّوا بِهِ وَصَمَمْ",132,"م",1,0],["وأن ذا القرنين مع لقمان","في طرق الأنبياء مجهولان",133,"ن",1,0],["وإن ذكرنا اسمه لطيبته","يبقى بأفواهنا له عبق",134,"ق",1,0],["وإن ذكر الحجاج أو عشر حجةٍ","يسيل على الأذقان فيض المحاجر",135,"ر",1,0],["وإن ذكر الزوار عالي جنابها","جرت أدمعي فوق الخدود سفوح",136,"ح",1,0],["وانْ ذَكَرَتْها النَّفْسُ طالَ حَنِينُها","وباتَتْ تُناجِي طاافا من خَيالِها",137,"ل",3,0],["وإنَّ ذنوبي صيَّرتْني على شفا","فجدْ بخلاصٍ عاجلٍ وشفاءِ",138,"ا",2,0],["وإن ذرّ قرن الشمس أوهمت أنها","تبلغني عنهم سلاماً وتنطق",139,"ق",1,0],["وان ذكر اسمه من صام شهرا","نشيت لفيه نسرينا ووردا",140,"د",2,0],["وان ذويه فيه قرت عيونها","به بعدما كانت لنأىٍ قرائحا",141,"ح",2,0],["وان ذكرت مرصعات بالزمرد لا عزلها","يا صلاة الله على وجه الرسول ويا سلامه",142,"م",2,0],["وإن ذاع سرك من صاحبٍ","فأنت وإن لمته ألوم",143,"م",1,0],["وإن ذكَرَ الأبطالُ سيرةَ فارسٍ","ذُكِرتَ كجيشٍ للقتال تحشدا",144,"د",2,0],["وَأَنْذَلُ قَاْدَةِ الأَعْرَاْبِ هَاْدُوْا","وَشَاْدُوْا بِالسَّلاْمِ الْمُسْتَحِيْلِ",145,"ل",1,0],["وأنذرتني اقتراب الحين ضاحكةً","وقد قرعت بكفي الصدر من شجن",146,"ن",1,0],["وإنْ ذلّ قومٌ وَهُمْ صَاغِرُونَ","فَمَن قادتي تكبرُ الكبرياءْ",147,"ا",2,0],["وإن ذاب من حر الوغى قلب ماجد","فقلبك أقوى صخرة أن يفلقا",148,"ق",2,0],["وإن ذكرت أحمداً وصنوه","نشرت للتاريخ أسطار البها",149,"ا",1,0],["وإن ذكرت بعدهم محمداً","ذكرت للدهر الحسام والندى",149,"ا",1,0],["وان ذبحته خلّك بذبحه رفوق!","واختر اسرع قاتل من الاسلحة",150,"ح",2,0],["وإنْ ذَرَّ فِي آفَاقِهَا نُورُ صَورِهَا","يَكُن كُفرُهَا كَهْرًا وكَونُ الكَرَى هَبَّا",151,"ب",2,0],["وان ذكرتُ من المأساةِ من رحلوا","ستُقْسِمُ الروحُ انتمْ من مآسيها",152,"ي",3,0],["وإن ذَرَفُوا دمعًا وهاموا صبابة","فإن هيامي لا مَحَالَةَ أعْظَمُ",153,"م",1,0],["وأن ذوي الإسلام أهل ضلالة","وأهل ابتداع بئسما قال إذ رمى",154,"م",2,0],["وإن ذلك دين الله قال به","من كان بالعلم والإنصاف متصفا",155,"ف",2,0],["وأن ذهبت نفسي لحاجة فقرها","ففي جاهه يوم المعاد غناها",156,"ا",3,0],["وأن ذاتي على سِورِ القصيدةِ قد","صارت شراباً لأحبابي وخُبزَ عِدا",157,"د",2,0],["وان ذكر عند الرجاجيل قالوا طز فيه","قد دروا ماعمر نعجه تخوف سبعها",158,"ع",3,0],["وإن ذكر المعروف والحلم والندى","فذاك له منه حليف وناصر",159,"ر",1,0],["وأن ذكروا معارفهُ فحدث","عن الغدران عن بحر النوالِ",160,"ل",1,0],["وإن ذكروا يوماً أباه ليعرفوا","أقول لهم ذا سره وهو عاقبه",161,"ب",2,0],["وأنذهل كسرى وجيش الروم خار","من كتايب من سعوا للصالحات",162,"ت",1,0],["وان ذبح خير عند وجهه","وكسب الفضيله بالحيلة إمناه",163,"ا",2,0],["وان ذبحتني تمني رجعتي وابكي عليه","لين تملين المحاجر بالبكا حزن وكآ به",164,"ب",2,0],["وَإِنْ ذَاقُوا أَذًى يَوْمًا","فَأَنْقِذْهُمْ مِنَ الْعَسْفِ",165,"ف",1,0],["وأنّ ذاكرةَ المنفى تغرّرُنا","بكُحلهنّ فتغدو روحُنا رمشا",166,"ش",2,1],["وأنذرت عن نهي وأمر بطاعة","وحذرت من خوف الوعيد بقصة",167,"ه",1,0],["وان ذاب قلبه قلت : ما ذاب .. كذاب","بك ذاب كله واعند جروحه يطيب",168,"ب",1,0],["وأن ذوي التقصير لا يرجعون عن","عمائهم حتى إلى الجهل يحشروا",169,"ر",3,0],["وأن ذوي التقصير أعداءهم به","فيا ويلهم ماذا جنوا لو تبصروا",169,"ر",3,0],["وانذر فالشر قد طبّق الأر","ض وعل الظلام والأرجاء",170,"ا",2,0],["وإن ذنوب المرء مهما تعاظمت","لأعظم منها عفو ربي وأوسع",171,"ع",1,0],["وأنذرتني من الصحراء، عاتِبةٌ","عليَّ إذْ لَمْ أُقاسِمْها الضنى ثَمَّا",172,"م",2,0],["وَإِنْ ذَابَ كَأْسٌ عَلَى رَاحَتَيَّ","تَسَابَقَ أَلْفٌ وَأَلْفٌ سَكَبْ",173,"ب",1,0]]}