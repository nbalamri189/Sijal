{"poems":[[63,"لويت على الرمح الرديني معصما","https://www.aldiwan.net/poem46086.html","الطويل"],[77,"رأت والليل قد سدل الرواقا","https://www.aldiwan.net/poem35908.html","الوافر"],[77,"أسائلكم هل من خبير بسلوان","https://www.aldiwan.net/poem36027.html","الطويل"],[9,"أرقت وما هذا السهاد المؤرق","https://www.aldiwan.net/poem21956.html","الطويل"],[86,"تعمدت قتلي في الهوى وتعمدا","https://www.aldiwan.net/poem68959.html","الطويل"],[73,"أثرت هزبر الشرى إذ ربض","https://www.aldiwan.net/poem11911.html","المتقارب"],[10,"أعيني جودا ولا تجمدا","https://www.aldiwan.net/poem21068.html","المتقارب"],[27,"أقمنا وربتنا الديار ولا أرى","https://www.aldiwan.net/poem5798.html","الطويل"],[23,"شق له من إسمه كي يجله","https://www.aldiwan.net/poem21418.html","الطويل"],[72,"بروحي معسول اللمى متحجب","https://www.aldiwan.net/poem18689.html","الطويل"],[72,"صرفت فعلي في الأسى وقولي","https://www.aldiwan.net/poem20616.html","الرجز"],[29,"ألا جعل الله الأخلاء كلهم","https://www.aldiwan.net/poem6201.html","الطويل"],[85,"سيوف أبيه من خمسين عاما","https://www.aldiwan.net/poem7046.html","الوافر"],[43,"عيد بأية حال عدت يا عيد","https://www.aldiwan.net/poem9555.html","البسيط"],[62,"خليلي لا راع الفراق حشاكما","https://www.aldiwan.net/poem52272.html","الطويل"],[69,"قولوا لمن يفخر بالعظم","https://www.aldiwan.net/poem28565.html","السريع"],[39,"برت لك حماء العلاط سجوع","https://www.aldiwan.net/poem53769.html","الطويل"],[67,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[48,"ألا قل لإسماعيل إنك شارب","https://www.aldiwan.net/poem65264.html","الطويل"],[50,"أصفراء ما في العيش بعدك مرغب","https://www.aldiwan.net/poem64815.html","الطويل"],[46,"تداولني صبح ومسي وحندس","https://www.aldiwan.net/poem22778.html","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16669","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55169","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54259","الطويل"],[90,"حافظ إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=179126",""],[39,"بَرَتْ لَكَ حَمَّاءُ العِلاطِ سَجُوعُ","https://www.poetsgate.com/ViewPoem.aspx?id=4262",""]],"verses":[["وَإِنْ ذَكَروا آباءَهُمْ فَوُجوهُهُمْ","تُشَبِّهُها قِطْعاً مِنَ اللَّيلِ مُظْلِما",0,"م",2,0],["وإنْ ذُكِرَتْ مَفاخِرُهُ ابْتَدَرْنا","مهَبَّ الطّيبِ يُنْتَشَقُ انْتِشاقا",1,"ق",2,0],["وَإِنْ ذُكِرَ الإِخْوَانُ مَنْ مثِلُ أحمَدٍ","ألاَ كُلّ مَرْعىً بَعْدَهُ غَيْرُ سَعْدَانِ",2,"ن",1,0],["وَأَنذَرتُكُم قَوماً لَكُم تَظلِمونَهِم","كِراماً فَإِن لا يَنفَدِ العَيشُ تَلتَقوا",3,"ق",3,0],["وَإِن ذَكَروا مِنهُ الحَماسَ حَسِبتَنا","نَرى الصارِمَ المَخضوبَ خَدّاً مُوَرَّدا",4,"د",2,0],["وَأَنذِر خَليلَكَ مِن ماهِرٍ","بِطِبِّ الجُنونِ إِذا ما عَرَض",5,"ض",1,0],["وَإِن ذُكِرَ المَجدُ أَلفَيتَهُ","تَأَزَّرَ بِالمَجدِ ثُمَّ اِرتَدى",6,"د",2,0],["وَإِنَّ ذِيادَ اللَيلِ لا تَستَطيعُهُ","وَلا الصُبحَ حَتّى يَستَنيرَ فَيَسطَعا",7,"ع",2,0],["وَأَنذَرَنا ناراً وَبَشَّرَ جَنَّةً","وَعَلَّمَنا الإِسلامَ فَاللَهَ نَحمَدُ",8,"د",1,0],["وإن ذقن منًّا من حلاوة ريقه","أتانا رقيب يتبع المنّ بالأذى",9,"ذ",2,0],["وإن ذكرت أفق بيتٍ قد نما","فانْصب وقل كم كوكباً يحوي السما",10,"م",2,0],["وَإِن ذَكَرَ الناسُ القَديمَ وَجَدتَنا","لَنا مِقدَحا مَجدٍ وَلِلناسِ مِقدَحُ",11,"ح",1,0],["وأنذر إن تفضل صوم عام","ومثلي من يصوم ومن يصلى",12,"ل",2,0],["وَأَنَّ ذا الأَسوَدَ المَثقوبَ مِشفَرُهُ","تُطيعُهُ ذي العَضاريطُ الرَعاديدُ",13,"د",1,0],["وإن ذُقتما السُّلوانَ بعدِي فإنَّني","وحقِّ الهَوى لم أسْلُ حتى أراكما",14,"م",2,0],["وإن ذكري شائعٌ ذائعٌ","وذكرُهُم أخفى منَ الوهمِ",15,"م",1,0],["وَأَنَّ ذَوي الأَمولِ أَضحَوا وَما لُهُم","لَهُم عِندَ أَبوابِ المُلوكِ شَفيعُ",16,"ع",1,0],["وَإنْ ذَهَبَتْ بالنارِ عنه زَخَارِفٌ","فما ضَرَّهُ منها ذَهابٌ وَلا فَقْدُ",17,"د",1,0],["وَإِن ذُكِرَ الجَعدِيِّ أَذرَيتَ عَبرَةً","وَقُلتَ أَدالَ اللَهُ مِن كُلِّ ظالِمِ",18,"م",1,0],["وَأَنذَلُ مَن يَمشي ضُبَيعَةُ إِنَّهُم","زَعانِفُ لَم يَخطُب إِلَيهِم مُحَجَّبُ",19,"ب",1,0],["وَإِن ذَهَبَت كَالفَيءِ فَهِيَ كَمَغنَمٍ","يُحازُ وَلم يُفرَد لِخالِقِهِ الخُمسُ",20,"س",1,0],["وإن ذَهَلَتْ عمّا أجِنّ صُدورُها","فقد ألهَبَتْ وَجْداً نُفوسَ رِجال",21,"ل",1,0],["وَإِنَّ ذِكْرَاهُ وَزِيدَتْ بِمَا","جَدَّدْتِ لَنْ تُنْسَى وَلَن تَخْمُلاَ",22,"ل",2,0],["وإن ذَرَفَتْ من جَفْن دِجْلَةَ دمْعَةٌ","رأيتَ دموعَ النيلِ حَيْرَى تَصَبَّبُ",23,"ب",1,0],["وأنَّ ذاكَ الخفيفَ الروحِ يُوحشُه","بيتٌ ثقيلٌ على الأحياءِ مَثواه",24,"ا",2,0],["وأنَّ ذوي الأموالِ أضحَوْا وما لهُمْ","لَهُمْ عِنْدَ أَبْوَابِ المُلُوكِ شَفِيعُ",25,"ع",1,0]]}