{"poems":[[63,"لويت على الرمح الرديني معصما","https://www.aldiwan.net/poem46086.html","الطويل"],[77,"رأت والليل قد سدل الرواقا","https://www.aldiwan.net/poem35908.html","الوافر"],[77,"أسائلكم هل من خبير بسلوان","https://www.aldiwan.net/poem36027.html","الطويل"],[9,"أرقت وما هذا السهاد المؤرق","https://www.aldiwan.net/poem21956.html","الطويل"],[86,"تعمدت قتلي في الهوى وتعمدا","https://www.aldiwan.net/poem68959.html","الطويل"],[73,"أثرت هزبر الشرى إذ ربض","https://www.aldiwan.net/poem11911.html","المتقارب"],[10,"أعيني جودا ولا تجمدا","https://www.aldiwan.net/poem21068.html","المتقارب"],[27,"أقمنا وربتنا الديار ولا أرى","https://www.aldiwan.net/poem5798.html","الطويل"],[23,"شق له من إسمه كي يجله","https://www.aldiwan.net/poem21418.html","الطويل"],[72,"بروحي معسول اللمى متحجب","https://www.aldiwan.net/poem18689.html","الطويل"],[72,"صرفت فعلي في الأسى وقولي","https://www.aldiwan.net/poem20616.html","الرجز"],[29,"ألا جعل الله الأخلاء كلهم","https://www.aldiwan.net/poem6201.html","الطويل"],[85,"سيوف أبيه من خمسين عاما","https://www.aldiwan.net/poem7046.html","الوافر"],[43,"عيد بأية حال عدت يا عيد","https://www.aldiwan.net/poem9555.html","البسيط"],[62,"خليلي لا راع الفراق حشاكما","https://www.aldiwan.net/poem52272.html","الطويل"],[69,"قولوا لمن يفخر بالعظم","https://www.aldiwan.net/poem28565.html","السريع"],[39,"برت لك حماء العلاط سجوع","https://www.aldiwan.net/poem53769.html","الطويل"],[67,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[48,"ألا قل لإسماعيل إنك شارب","https://www.aldiwan.net/poem65264.html","الطويل"],[50,"أصفراء ما في العيش بعدك مرغب","https://www.aldiwan.net/poem64815.html","الطويل"],[46,"تداولني صبح ومسي وحندس","https://www.aldiwan.net/poem22778.html","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16669","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55169","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54259","الطويل"],[90,"حافظ إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=179126",""],[39,"بَرَتْ لَكَ حَمَّاءُ العِلاطِ سَجُوعُ","https://www.poetsgate.com/ViewPoem.aspx?id=4262",""],[132,"أقلب لا يزال ولن يزولا","https://www.aldiwan.net/poem54776.html","الوافر"],[132,"أشاقتك ورق اللوى هتفا","https://www.aldiwan.net/poem54796.html","المتقارب"],[132,"رقاب العقل لو تدرين ما بي","https://www.aldiwan.net/poem54880.html","الوافر"],[150,"بدت لجفونك العبر","https://www.aldiwan.net/poem68498.html","مجزوء الرمل"],[169,"أفي كل دار لي عدو أصاوله","https://www.aldiwan.net/poem1645.html",""],[181,"ألا حييا الأطلال بالجرع العفر","https://www.aldiwan.net/poem59043.html","الطويل"],[186,"سكنت إلى حسن التوكل والصم","https://www.aldiwan.net/poem43867.html","الطويل"],[189,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[199,"مضى والتقى نجمين في أفق جدا","https://www.aldiwan.net/poem45160.html","الطويل"],[250,"سرى في دجى من شعره فحكا البدرا","https://www.aldiwan.net/poem14966.html","الطويل"],[261,"منهل دمع المحب من دمه","https://www.aldiwan.net/poem38141.html","المنسرح"],[270,"حبي الخليفة مولانا ومولاك","https://www.aldiwan.net/poem35652.html","البسيط"],[271,"متى يستقيم الظل والعود أعوج","https://www.aldiwan.net/poem52083.html","الطويل"],[271,"سمعت سويجع الاثلاث غنى","https://www.aldiwan.net/poem52085.html","الوافر"],[328,"أفي القمة السكرى بخمر الأداهر","https://www.aldiwan.net/poem55056.html","الطويل"],[391,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[393,"لقد رحلت سعدى فهل لك مسعد","https://www.aldiwan.net/poem53688.html","الطويل"],[400,"عندما يرتحل القلب","https://www.aldiwan.net/poem6749.html","عموديه"],[402,"قالوا أتنكر ذكر الشيخ قلت لهم","https://www.aldiwan.net/poem46945.html","البسيط"],[405,"وهت عزماتك عند المشيب","https://www.aldiwan.net/poem49377.html","المتقارب"],[416,"ليالينا على الجرعاء عودي","https://www.aldiwan.net/poem54070.html","الوافر"],[416,"لقد خفقت في النحر ألوية النصر","https://www.aldiwan.net/poem54141.html","الطويل"],[432,"يروع الذئب حيث سواك راع","https://www.aldiwan.net/poem12377.html","الوافر"],[439,"كذا تتجلى الشمس بعد كسوفها","https://www.aldiwan.net/poem34867.html","الطويل"],[439,"أفي مثلها تنبو أياديك عن مثلي","https://www.aldiwan.net/poem34897.html","الطويل"],[458,"إذا لم أحظ منك على التلاقي","https://www.aldiwan.net/poem56089.html","الوافر"],[458,"أفاق بها من طول سكرته الدهر","https://www.aldiwan.net/poem56161.html","الطويل"],[464,"في لأذني عن كل لاح صمم","https://www.aldiwan.net/poem3159.html","عموديه"],[482,"تستر ناسوتي بناسوت أهبه","https://www.aldiwan.net/poem24438.html","عموديه"],[500,"بين بطاح حيهم والأبطح","https://www.aldiwan.net/poem38037.html","الرجز"],[516,"وإني لاستحيي كثيرا واتقي","https://www.aldiwan.net/poem48668.html","الطويل"],[520,"لسعد قدومكم هبّ النسيم","https://www.aldiwan.net/poem815.html",""],[551,"على دار حللت بها سلامي","https://www.aldiwan.net/poem47213.html","الوافر"],[551,"على المزمعين البين منا عشية","https://www.aldiwan.net/poem47317.html","الطويل"],[562,"إذا ذهب الكثير من الكثير","https://www.aldiwan.net/poem52789.html","الوافر"],[575,"أعيذها ألف ألف مره","https://www.aldiwan.net/poem2718.html","مخلع البسيط"],[587,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"]],"verses":[["وَإِنْ ذَكَروا آباءَهُمْ فَوُجوهُهُمْ","تُشَبِّهُها قِطْعاً مِنَ اللَّيلِ مُظْلِما",0,"م",2,0],["وإنْ ذُكِرَتْ مَفاخِرُهُ ابْتَدَرْنا","مهَبَّ الطّيبِ يُنْتَشَقُ انْتِشاقا",1,"ق",2,0],["وَإِنْ ذُكِرَ الإِخْوَانُ مَنْ مثِلُ أحمَدٍ","ألاَ كُلّ مَرْعىً بَعْدَهُ غَيْرُ سَعْدَانِ",2,"ن",1,0],["وَأَنذَرتُكُم قَوماً لَكُم تَظلِمونَهِم","كِراماً فَإِن لا يَنفَدِ العَيشُ تَلتَقوا",3,"ق",3,0],["وَإِن ذَكَروا مِنهُ الحَماسَ حَسِبتَنا","نَرى الصارِمَ المَخضوبَ خَدّاً مُوَرَّدا",4,"د",2,0],["وَأَنذِر خَليلَكَ مِن ماهِرٍ","بِطِبِّ الجُنونِ إِذا ما عَرَض",5,"ض",1,0],["وَإِن ذُكِرَ المَجدُ أَلفَيتَهُ","تَأَزَّرَ بِالمَجدِ ثُمَّ اِرتَدى",6,"د",2,0],["وَإِنَّ ذِيادَ اللَيلِ لا تَستَطيعُهُ","وَلا الصُبحَ حَتّى يَستَنيرَ فَيَسطَعا",7,"ع",2,0],["وَأَنذَرَنا ناراً وَبَشَّرَ جَنَّةً","وَعَلَّمَنا الإِسلامَ فَاللَهَ نَحمَدُ",8,"د",1,0],["وإن ذقن منًّا من حلاوة ريقه","أتانا رقيب يتبع المنّ بالأذى",9,"ذ",2,0],["وإن ذكرت أفق بيتٍ قد نما","فانْصب وقل كم كوكباً يحوي السما",10,"م",2,0],["وَإِن ذَكَرَ الناسُ القَديمَ وَجَدتَنا","لَنا مِقدَحا مَجدٍ وَلِلناسِ مِقدَحُ",11,"ح",1,0],["وأنذر إن تفضل صوم عام","ومثلي من يصوم ومن يصلى",12,"ل",2,0],["وَأَنَّ ذا الأَسوَدَ المَثقوبَ مِشفَرُهُ","تُطيعُهُ ذي العَضاريطُ الرَعاديدُ",13,"د",1,0],["وإن ذُقتما السُّلوانَ بعدِي فإنَّني","وحقِّ الهَوى لم أسْلُ حتى أراكما",14,"م",2,0],["وإن ذكري شائعٌ ذائعٌ","وذكرُهُم أخفى منَ الوهمِ",15,"م",1,0],["وَأَنَّ ذَوي الأَمولِ أَضحَوا وَما لُهُم","لَهُم عِندَ أَبوابِ المُلوكِ شَفيعُ",16,"ع",1,0],["وَإنْ ذَهَبَتْ بالنارِ عنه زَخَارِفٌ","فما ضَرَّهُ منها ذَهابٌ وَلا فَقْدُ",17,"د",1,0],["وَإِن ذُكِرَ الجَعدِيِّ أَذرَيتَ عَبرَةً","وَقُلتَ أَدالَ اللَهُ مِن كُلِّ ظالِمِ",18,"م",1,0],["وَأَنذَلُ مَن يَمشي ضُبَيعَةُ إِنَّهُم","زَعانِفُ لَم يَخطُب إِلَيهِم مُحَجَّبُ",19,"ب",1,0],["وَإِن ذَهَبَت كَالفَيءِ فَهِيَ كَمَغنَمٍ","يُحازُ وَلم يُفرَد لِخالِقِهِ الخُمسُ",20,"س",1,0],["وإن ذَهَلَتْ عمّا أجِنّ صُدورُها","فقد ألهَبَتْ وَجْداً نُفوسَ رِجال",21,"ل",1,0],["وَإِنَّ ذِكْرَاهُ وَزِيدَتْ بِمَا","جَدَّدْتِ لَنْ تُنْسَى وَلَن تَخْمُلاَ",22,"ل",2,0],["وإن ذَرَفَتْ من جَفْن دِجْلَةَ دمْعَةٌ","رأيتَ دموعَ النيلِ حَيْرَى تَصَبَّبُ",23,"ب",1,0],["وأنَّ ذاكَ الخفيفَ الروحِ يُوحشُه","بيتٌ ثقيلٌ على الأحياءِ مَثواه",24,"ا",2,0],["وأنَّ ذوي الأموالِ أضحَوْا وما لهُمْ","لَهُمْ عِنْدَ أَبْوَابِ المُلُوكِ شَفِيعُ",25,"ع",1,0],["وإن ذُكرَت تَذَكَّرَ خَوطَ بَانٍ","عَلَى دِعصٍ وأُمَّ طَلاً خَذُولا",26,"ل",2,0],["وإِن ذُقتَ صَافِيَةً قَرقَفاً","تَذَكَّرتَ صَافِيَهُ القَرقَفَا",27,"ف",2,0],["وإن ذَكَرتكِ نَفسِى في شَرَابٍ","اكَادُ أغُصُّ مِن ذاك الشرابِ",28,"ب",1,0],["وأنذرت النّهي فصمم","ت عما ألفت النّذر",29,"ر",1,0],["وَإِن ذَكَروهُ في النَدى قُلتُ ماجِدٌ","وَهوبٌ لِجُلِّ المالِ حُلوٌ شَمائِلُه",30,"ل",2,0],["وَأنذُرُ للرَّحمنِ مَا دُمتِ أَيِّماً","وَهَل أنتَ يا رَبَّ العُلاَ مُوجِبٌ نَذرِى",31,"ر",2,0],["وإن ذكروا الصهباء فالقفص دارها","وأرض أوانا معدن القصف والخمر",32,"ر",1,0],["وَإِن ذُكِرَت بينَ الورى غزواتهُ","فَقدِّم عليها في سماءِ العُلا بدرا",33,"ر",2,0],["وان ذكروا ندًّ لعلمك في الورى","فلن يذكروا في هذه أبداً ندَّا",34,"د",2,0],["وإن ذكر التاريخَ يوما بُمقتَضَى","بلاغته حَلَّى الزمانَ الذي مَرَّا",35,"ر",2,0],["وان ذا اللب في تصوره","اصدق في القول من منجمه",36,"م",2,0],["وإن ذكرناكِ هزّتنا حمَيّتُنا","فمثلُ ماويةِ الأغصانِ ذكراك",37,"ك",1,0],["وان ذكروا لَيلى ولبنى فانني","بذكر الحَبيب الطيب الذكر ملهج",38,"ج",1,0],["وان ذكر وانجىّ الطور فاذكر","نجيّ العرش مفتَقرا لتغنى",39,"ن",2,0],["وإن ذهلت عني تهاويل شقوتي","تحايلت حتى لا أفيق لسامري",40,"ي",1,0],["وإن ذاكر الله","كحى بين أموات",41,"ت",1,0],["وَأَنَّ ذُنوبَ الناسِ أَجمَع كَسبُهُم","بِاِحداثِها من دونِهِ قَد تَفَرَّدوا",42,"د",3,0],["وأن ذاكرتي صارت مغلقة","عن غير ذكراك لم تحفل بما حصلا",43,"ل",2,0],["وإنّ ذِكْر أبي حفْصٍ وصحِبهِ","عثمان يَعْلُو بهِ يومَ اللِّقَا جاهي",44,"ي",1,0],["وإن ذُكِرَت شهواتُ النفوسِ","فما تشتهي غيرَ أن تشتهِي",45,"ت",3,0],["وإن ذكروا له خلقاً وخلقاً","فَقُلْ ما شئت بالخلق الحميد",46,"د",1,0],["وأنذرهم بطشاً شديداً وسطوةً","وبالغ بالرُّسْلِ الكرام وبالنّذر",47,"ر",1,0],["وإِن ذَمُّوا المِصاع لِحَرِّ بأْسٍ","فقد حمدوكَ في ذَمِّ المصاعِ",48,"ع",1,0],["وإِنْ ذَبُلَتْ من دَوْحَةِ المُلْكِ نَضْرَةٌ","فما أَوْحَشَ الدُّنْيا جَنِيُّ قُطُوفِها",49,"ف",3,0],["وإِن ذابَ حُرُّ الوجْهِ من حَرِّ نارِهِمْ","فما مُسْتَغَاثِي منهُ إِلّا إِلَى المُهْلِ",50,"ل",1,0],["وأنذره بدلّانٍ وُسومٌ","على الأعناق ثابتةٌ بواقي",51,"ي",1,0],["وأَنذُر إن أدركتُها فيك منسكاً","أقوم به فاليوم قد وجبَ النذرُ",52,"ر",1,0],["وإن ذكرتُ وهمُ في محضرٍ","أو مجلسٍ حاكمهُ من يعلم",53,"م",1,0],["وإن ذقت طعم الجمع للضد عندما","تخالفت الأعيان أنت امتناعه",54,"ع",2,0],["وإنْ ذَكرتي في المَقامِ لَهْفتي","عن لَوعتي ووَلهي فأفْصحي",55,"ي",1,0],["وَاِنذُر بالهِجرانِ نَفسي اروضها","لِتَعلَمَ عِندَ الهَجرِ هَل لي مِن صَبر",56,"ر",1,0],["وإن ذكر الأكابر في حماءٍ","لأنت المعدن الصافي المديمُ",57,"م",1,0],["وَإِن ذعرَ الزّمانُ فَأَنتَ رُكني","أَلوذُ بِهِ مِن الخططِ العظامِ",58,"م",1,0],["وإنْ ذبلتْ أغصان قومٍ فلا رأتْ","لغصنك عينٌ للزّمان ذبولا",59,"ل",2,0],["وإن ذهبَ الكبيرُ ولم يُؤَثِرْ","فليسَ نخافُ مِن أثَرِ الصَّغيرِ",60,"ر",1,0],["وإِنَّ ذَا عِنْدَه قَلِيلٌ","وفي ندى كفِّه كَذَرَّه",61,"ر",2,0],["وإن ذكروا يوماً حديثاً مجوزاً","لذلك في البنيان غير مفندد",62,"د",1,0]]}