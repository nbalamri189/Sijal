?name=Sh3er&doWhat=shqas&qid=85976&r=&rc=13",""],[2220,"إذا اختصمَ الجمعانِ قيل لهم كُفُّوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11556&r=&rc=430",""]],"verses":[["إِذا أَخَذَ الرَدى مِنّا رَجَعنا","إِلى صَبرٍ يُشَرَّدُ بِالغَرامِ",0,"م",1,0],["إِذا أَخَذَت مِنها الأَزِمَّةُ حَثَّها","نَجاءٌ وَأَعضادُ المَطِيِّ تَبوعُ",1,"ع",1,0],["إِذا أَخطَأوا مَرمىً مِنَ المَجدِ أَجهَشوا","زَئيرَ الضَواري أَفلَتَتها الفَرائِسُ",2,"س",1,0],["إِذا اِختارَت بَنو قَيسٍ نِزالي","رَجَعتُ وَلِلرَدى فيها الخِيارُ",3,"ر",1,0],["إِذا اِختَصَما كانَ الرَسولَ إِلَيهِما","لِسانٌ عَنِ الجِسمِ النَحيفِ مُراجِمُ",4,"م",1,0],["إذا أخْلَفَ الغيْثُ الأباطِحَ والرُّبا","فتَسْكابُ دَمْعِ المُقلَتَيْنِ يَجودُهُ",5,"د",2,0],["إِذا أَخصَبَت أَرضٌ وَأَجدَبَ أَهلُها","فَلا أَطلَعَت نَبتاً وَلا جادَها السَما",6,"م",2,0],["إِذا اِختَبَرتَ بَني الدُنيا وَجَدتَهُمُ","عَقارِباً وَثَعابيناً وَأَوزاغا",7,"غ",2,0],["إِذا أَخَذَتها هِزَّةُ الرَوعِ أَمسَكَت","بِمَنكِبِ مِقدامٍ عَلى الهَولِ أَروَعا",8,"ع",2,0],["إذا أَخَذوا أَدراعَهُ فَتَسَربَلوا","مُقَلَّصَ مَسروداتِها وَمُذالَها",9,"ل",3,0],["إِذا اخْتلَفَتْ فِي بَعْثِهَا وُجُهَاتُكُمْ","فَمَا ضَارَ أَصْلاً أَنَّ أَفْنَانَهُ شُعَبْ",10,"ب",1,0],["إِذا أَخَذَت مِسواكَها صَقَلَت بِهِ","ثَنايا كَنَورِ الأُقحُوانِ المُهَطَّلِ",11,"ل",1,0],["إِذا أَخو لَذَّةِ الدُنيا تَبَطَّنَها","وَالبَيتُ فَوقَهُما بِاللَيلِ مُحتَجِبُ",12,"ب",1,0],["إذا أخلف الناسَ الغمامُ وأمحلوا","فإن نداه والغمامَ لَسِيَّانِ",13,"ن",1,0],["إِذا أَخَذوا وَكَيدُهُمُ ضَعيفٌ","بِبابٍ يَمكِرونَ فَتَحتَ بابا",14,"ب",2,0],["إِذا أَخَذَت قَيسٌ عَلَيكَ وَخِندِفٌ","بِأَقطارِها لَم تَدرِ مِن أَينَ تَسرَحُ",15,"ح",1,0],["إِذا أخذت له في ما شَرِيطٍ","رآنَا بِالإِسَاءَةِ مُحسِنِينَا",16,"ن",2,0],["إِذا اِختَبَطوا لَم يُفحِشوا في نَدِيِّهِم","وَلَيسَ عَلى سُؤالِهِم عِندَهُم بُخلُ",17,"ل",1,0],["إذا اخْتصمَ الأقوام ضاءَ بفكرةٍ","يقول ضياء الصبح لست بخصمها",18,"م",3,0],["إذا أُخِّرتْ سرجُ الجبان وجدتَني","أغامسها في حومة الطعن والضربِ",19,"ب",1,0],["إذا اختطّ قومٌ خِطةً لمدينةٍ","تقاضتهمُ أضعافَها للمقابِر",20,"ر",1,1],["إذا أخذتُ المرآة أسْلفني","وجهي وما مُتُّ هول مطَّلعي",21,"ع",2,0],["إذا أخطأتْهُ ثُلمةٌ لا يجرُّها","له غيرهُ جاءتْه من ذاته الثُّلمْ",22,"م",1,0],["إِذا اِختَفى في الوَردِ لَونُ الضُحى","فَالذَنبُ ذَنبُ الأَعيُنِ الناظِرات",23,"ت",1,0],["إِذا اِختَلَفَت رَأياً فَما اِختَلَفَت هَوىً","أَوِ اِقتَرَفَت سَعياً فَما اِفتَرَقَت قَصدا",24,"د",2,0],["إِذا أُخلِيَت عودَ الهَشيمَةِ أَرزَمَت","جَوانِبُها حَتّى نَبيتَ نَذودُها",25,"د",3,0],["إِذا أَخلَفَت صَوبَ الرَبيعِ وَصى لَها","عَرادٌ وَحاذٌ أَلبَسا كُلَّ أَجرَعا",26,"ع",2,0],["إِذا أخَطأَ الأَحبابُ تَرتيبَ حالِهِم","فَإِنَّ فُؤادي دائما لَيُصيبُ",27,"ب",1,0],["إِذا اِختَلَفَ الزَمانُ عَلى حَزينٍ","مَضى بِالدَمعِ ثُمَّ مَحا الدِماعا",28,"ع",2,0],["إِذا آخَتِ الجَوهَرِيَّ الحُظوظُ","كَفَلنَ اليَتيمَ لَهُ في الصَدَف",29,"ف",1,0],["إِذا أَخَذَت أَطرافُهُ مِن قُنوئِها","رَأَيتَ اللُجَينَ بِالمُدامَةِ يُذهَبُ",30,"ب",1,0],["إِذا أَخذتَ العَصا تَواكَلَكَ ال","أَنصارُ إِلّا ما قُمتَ تَقتَضِبُه",31,"ب",2,0],["إِذا اختَلَفَت سُبلُ الرِجالِ وَجَدتَهُ","مُقيماً عَلى نَهجٍ مِنَ القَولِ واضِحِ",32,"ح",1,0],["إِذا اختارَ وَقتاً لِلنُجومِ يَعُدُّهُ","لِيَومِ وَغى عادَت نُحوساً سُعودُها",33,"د",3,0],["إِذا اِخضَرَّ عَيشومُ الجِفارِ وَأُرسِلَت","عَلَيهِنَّ أَنواءُ الرَبيعِ المَرازِمِ",34,"م",1,0],["إذا اختلَجَت مَناكِبُه لرَقصٍ","نَزَت طَيرُ القلوبِ إليه نَزْوَا",35,"و",2,0],["إِذا اِختَلَفَ الأَبطالُ وَاَشتَبَكَ القَنا","وَكانَ حَديثُ القَومِ ضَربُ الجَماجِمِ",36,"م",1,0],["إِذا اِختَلَّ الخَليلُ لَغَيرِ ذَنبٍ","فَلي في عَودِ صُحبَتِهِ الخِيارُ",37,"ر",1,0],["إِذا اِختَلَّ وُدُّ الخِلِّ مِن غَيرِ موجِبٍ","فَلي نَحوَ أَهلِ الوُدِّ مِنهُ ذَهابُ",38,"ب",1,0],["إذا أخذ البدر المنير مكانه","وملك آفاق السما وتمكنا",39,"ن",2,0],["إذا اختصموا في اللّه كانت قضاتُهُمْ","قواضبَ تَقْضي بينهم ولهاذما",40,"م",2,0],["إِذا اِختَلَّ ثَغرُ المَجدِ أَضحى جِلادُهُم","وَنائِلُهُم مِن حَولِهِ كَالعَواصِمِ",41,"م",1,0],["إذا أخَّرْت كتبَكَ عنْ محبٍّ","فإنكَ قدْ حشوتَ حشاهُ نارا",42,"ر",2,1],["إذا أخفى صديقكَ عنكَ سرّاً","وأبهمَ حالَهُ فسواهُ أولى",43,"ل",2,1],["إِذا اِختَلَفوا أَوِ اِتَّفَقوا فَإِنّا","سِوى اِستِقلالِ مِصرٍ لا نُريدُ",44,"د",1,0],["إذا أخذ السيْلُ الأَتِيُّ سبيلَه","فلا الشّرقُ مَسْدودُ الفجاجِ ولا الغربُ",45,"ب",1,0],["إِذا اِختَلَطَ الرِتاكُ مالَت سَراتُهُ","عَلى يَسَراتٍ أَو بُهُنَّ ذَريعُ",46,"ع",1,0],["إِذا اِختَلَجَتها مُنجَياتٌ كَأَنَّها","صُدورُ عَراقٍ ما بِهِنَّ قُطوعُ",46,"ع",1,0],["إِذا أَخَذَ القُرطاسَ خِلتَ يَمينَهُ","تُفَتِّحُ نوراً أَو تُنَظِّمُ جَوهَرا",47,"ر",2,0],["إِذا أَخَذَت أَطرافُهُ مِن قُنوئِها","رَأَيتَ لُجَيناً بِالمُدامَةِ مُذهَبُ",48,"ب",1,0],["إذا أخذَتْ أعلامُه صَدْرَ مِقْنَبٍ","رأيتَ شَرَورَى تحتَ نخلٍ مكَمَّم",49,"م",1,0],["إذا اختلفوا في الأمرِ ألّفَ بينهُم","طبيبٌ بأدواءِ النفوسِ السّقائم",50,"م",1,0],["إِذا أَخَذَتها الكَأسُ كادَت بِريحِها","تَخالُ بِها عِطراً وَما إِن تَرى عِطرا",51,"ر",2,0],["إِذا أَخلَفَ القَومُ ظَنّي بِها","وَكانَ لَها في غَدٍ مَوعِدُ",52,"د",1,0],["إِذا أُخرِجَت مِنّي لِقَومٍ حَدا بِها","مِنَ القَومِ حادٍ خَلفَها أَيِّدٌ غَرِد",53,"د",1,0],["إِذا أَخَذوا الزَوائِفَ أَولَجوهُم","وَلَو كانوا اليَهودَ أَو النَصارى",54,"ر",2,0],["إِذا أَخلَصَت لِلخَلّاقِ سِرّاً","فَلَيسَت مِن ضَوائِرَكَ الضَواري",55,"ر",2,0],["إِذا أَخَذَت قِسطاً مِنَ العَقلِ هَذِهِ","فَتِلكَ لَها في ضِلَّةِ المَرءِ قِسطانِ",56,"ن",1,0],["إِذا اِختَصَمَت في سَيِّءِ الفِعلِ وَاِبنَها","فَلا هِيَ مِن أَهلِ الحُقوقِ وَلا هو",57,"و",1,0],["إِذا أَخْفَيْتُهُ أَبْلَى فُؤادِي","وَإِنْ أَظْهَرْتُهُ غَضِبَ الْحَبيبُ",58,"ب",1,0],["إِذَا اخْتَمَرَتْ بِاللَّيْلِ قِمَّةُ رَأْسِهِ","تَفَجَّرَ مِنْ أَطْرَافِ لِمَّتِهَا الْفَجْرُ",59,"ر",1,0],["إذا اختلفوا لوجهِ الحقِّ يوماً","مشَوْا للحقِ فالتأموا التئاما",60,"م",2,0],["إذا أخذتها هزة ُ الروع أمسكت","بِمَنْكِبِ مِقْدَامٍ علء الهَوْلِ أرْوَعا",61,"ع",2,0],["إذا اختلفت رأيا فما اختلفت هوى ،","أو افترقت سعيا فما افترقت قصدا",62,"د",2,0],["إذا أخذوا أدراعهُمْ فتسربلوا","مُقَلَّصَ مَسْرُوداتِها وَمُذالها",63,"ل",3,0],["إذا اخترت من بين المذاهب مذهباً","فإياك أن تعتاض عنه بديلا",64,"ل",2,1],["إذا اختلف الأعداء عنكم ملامة","لتنشر محب