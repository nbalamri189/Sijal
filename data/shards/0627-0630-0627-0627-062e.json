{"poems":[[53,"عجزنا عن مراغمة الحمام","https://www.aldiwan.net/poem29763.html","الوافر"],[53,"خصيم من الأيام لي وشفيع","https://www.aldiwan.net/poem30151.html","الطويل"],[53,"تمنى رجال نيلها وهي شامس","https://www.aldiwan.net/poem30198.html","الطويل"],[53,"أما لو لم تعاقره العقار","https://www.aldiwan.net/poem30451.html","الوافر"],[55,"بدا من أبي الفضل الهوى المتقادم","https://www.aldiwan.net/poem26122.html","الطويل"],[77,"لمن طلل نائي المزار بعيده","https://www.aldiwan.net/poem36615.html","الطويل"],[86,"لقد كان فينا الظلم فوضى فهذبت","https://www.aldiwan.net/poem10692.html","الطويل"],[71,"لا تحسبوا أن قلبي عن محبتكم","https://www.aldiwan.net/poem3916.html","البسيط"],[0,"جزعت ولم أجزع من البين مجزع","https://www.aldiwan.net/poem83.html","الطويل"],[35,"خليلي إن أم الحكيم تحملت","https://www.aldiwan.net/poem39117.html","الطويل"],[93,"شهدنا زمانا في الكنانة ردنا","https://www.aldiwan.net/poem9798.html","عموديه"],[30,"قف العيس في أطلال مية فاسأل","https://www.aldiwan.net/poem29540.html","الطويل"],[30,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[83,"لعل الصبا إن صافحت روض نعمان","https://www.aldiwan.net/poem54236.html","الطويل"],[27,"سإمت من المواصلة العتابا","https://www.aldiwan.net/poem5660.html","الوافر"],[27,"أجد رواح القوم أم لا تروح","https://www.aldiwan.net/poem5704.html","الطويل"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[23,"كنا ملوك الناس قبل محمد","https://www.aldiwan.net/poem21425.html","الطويل"],[72,"يدافعني الغيران عن طيب لثمها","https://www.aldiwan.net/poem19677.html","الطويل"],[51,"طربت إلى ريحانة الأنف والقلب","https://www.aldiwan.net/poem8307.html","الطويل"],[51,"إذا اختط قوم خطة لمدينة","https://www.aldiwan.net/poem62874.html","الطويل"],[51,"من كان يبكي الشباب من جزع","https://www.aldiwan.net/poem65065.html","المنسرح"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[91,"يا ميتا فيه جمال الحياة","https://www.aldiwan.net/poem8784.html","عموديه"],[91,"تبدل قلبي من ضلالته رشدا","https://www.aldiwan.net/poem8815.html","عموديه"],[38,"ماذا ذكرتم من قلوص عقرتها","https://www.aldiwan.net/poem7710.html","الطويل"],[38,"ضعيف العصا بادي العروق ترى له","https://www.aldiwan.net/poem7728.html","الطويل"],[78,"ينادون قلبي والغرام يجيب","https://www.aldiwan.net/poem14238.html","الطويل"],[85,"خفضت لعزة الموت اليراعا","https://www.aldiwan.net/poem62859.html","الوافر"],[85,"لكل زمان مضى آية","https://www.aldiwan.net/poem63760.html","المتقارب"],[45,"بعمرك تدري أي شأني أعجب","https://www.aldiwan.net/poem10663.html","الوافر"],[45,"لا الدهر مستنفذ ولا عجبه","https://www.aldiwan.net/poem10901.html","المنسرح"],[45,"أفي مستهلات الدموع السوافح","https://www.aldiwan.net/poem62691.html","الطويل"],[45,"سواي مرجي سلوة أو مريدها","https://www.aldiwan.net/poem62760.html","الطويل"],[28,"ما نحن إن جارت صدور ركابنا","https://www.aldiwan.net/poem5609.html","الطويل"],[61,"سألت الله مما كان عفوا","https://www.aldiwan.net/poem51398.html","الوافر"],[58,"جزى الله خيرا عصبة أسلمية","https://www.aldiwan.net/poem30877.html","الطويل"],[66,"أتهجرني وما أسلفت ذنبا","https://www.aldiwan.net/poem38756.html","الوافر"],[66,"تنزه عتبي عن خطاك صواب","https://www.aldiwan.net/poem39643.html","الطويل"],[97,"منى نلتها كانت لأنفسنا منى","https://www.aldiwan.net/poem24974.html","الطويل"],[80,"أبا هاشم هشمتني الشفار","https://www.aldiwan.net/poem31300.html","المتقارب"],[44,"لنمنا وصرف الدهر ليس بنائم","https://www.aldiwan.net/poem30302.html","الطويل"],[69,"إذا أخرت كتبك عن محب","https://www.aldiwan.net/poem28787.html","الوافر"],[69,"إذا أخفى صديقك عنك سرا","https://www.aldiwan.net/poem28889.html","الوافر"],[105,"يقول البرق شر مستطير","https://www.aldiwan.net/poem43067.html","الوافر"],[105,"توالت وفود الله تختار دينه","https://www.aldiwan.net/poem44000.html","الطويل"],[39,"برت لك حماء العلاط سجوع","https://www.aldiwan.net/poem53769.html","الطويل"],[52,"عليم بأعقاب الأمور كأنه","https://www.aldiwan.net/poem27018.html","الطويل"],[52,"ألا ربما كأس سقاني سلافها","https://www.aldiwan.net/poem27248.html","الطويل"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[75,"سقتني بما مجت شفاه الأراقم","https://www.aldiwan.net/poem69041.html","الطويل"],[48,"وأحور ذمي طرقت فنائه","https://www.aldiwan.net/poem63278.html","الطويل"],[50,"ألا طرقت موهنا مهدد","https://www.aldiwan.net/poem63884.html","الوافر"],[50,"تنح لحاك الله لست من العدد","https://www.aldiwan.net/poem63887.html","الطويل"],[46,"أقيمي لا أعد الحج فرضا","https://www.aldiwan.net/poem22042.html","الوافر"],[46,"أوى ربي إلي فما وقوفي","https://www.aldiwan.net/poem22692.html","الوافر"],[46,"مطيتي الوقت الذي ما امتطيته","https://www.aldiwan.net/poem23497.html","الطويل"],[46,"لعمري الخير الذخر في كل شدة","https://www.aldiwan.net/poem23557.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42519","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42607","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54258","الوافر"],[0,"جزعتُ ولم أجزع من البين مجزعاً","https://www.poetsgate.com/ViewPoem.aspx?id=4804",""],[91,"الغد لنا","https://www.poetsgate.com/ViewPoem.aspx?id=53031",""],[35,"خليليّ إنْ أمُّ الحكيم تحمَّلتْ","https://www.poetsgate.com/ViewPoem.aspx?id=22071",""],[135,"إذا اخترت من بين المذاهب مذهبا","https://www.aldiwan.net/poem48980.html","الطويل"],[160,"بنى السيف علياه وشيدها الندى","https://www.aldiwan.net/poem58906.html","الطويل"],[186,"إلى من أشتكي همي وغمي","https://www.aldiwan.net/poem43444.html","الوافر"],[204,"بدت لوداع والتجمل سترها","https://www.aldiwan.net/poem53273.html","الطويل"],[235,"أصبحت ظلا على من ظل دولته","https://www.aldiwan.net/poem31952.html","البسيط"],[249,"أصوت مناد من رميلة تسمع","https://www.aldiwan.net/poem2109.html","الطويل"],[349,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[366,"إذا أخلف الراجي البخيلة جودها","https://www.aldiwan.net/poem16969.html","الطويل"],[371,"أما بهواه تيمني هواه","https://www.aldiwan.net/poem56988.html","الخفيف"],[371,"سل الظعن هل من نظرة تستزيدها","https://www.aldiwan.net/poem57501.html","الطويل"],[409,"إذا اختفت في الهوى عني إساءته","https://www.aldiwan.net/poem31615.html","عموديه"],[416,"تولت من الظلماء تلك الدياجر","https://www.aldiwan.net/poem54031.html","الطويل"],[416,"ألا هل للمتيم من مجير","https://www.aldiwan.net/poem54160.html","الوافر"],[432,"لأية حال فيض دمعك هتان","https://www.aldiwan.net/poem12754.html","الطويل"],[458,"كم النحت في جنبي والحز في متني","https://www.aldiwan.net/poem55835.html","الطويل"],[458,"من ناصري والزمان لي خصم","https://www.aldiwan.net/poem55862.html","المنسرح"],[458,"كذا تنقضي الأيام حالا على حال","https://www.aldiwan.net/poem56070.html","الطويل"],[458,"أزائرة كما زعم الخيال","https://www.aldiwan.net/poem56081.html","الوافر"],[458,"بدينك بعد ما انفرق الجميع","https://www.aldiwan.net/poem56119.html","الوافر"],[458,"سلمت وما الديار بسالمات","https://www.aldiwan.net/poem56232.html","الوافر"],[458,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[458,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[461,"أأهجع أم آوي إلى لين مرقد","https://www.aldiwan.net/poem15111.html","الطويل"],[461,"عفا ضارج من آل ليلى فعاقل","https://www.aldiwan.net/poem15298.html","الطويل"],[461,"أبى الله أن تمسي همومي صواحبي","https://www.aldiwan.net/poem15375.html","الطويل"],[461,"شموس المواضي ان بغيت الأمانيا","https://www.aldiwan.net/poem15466.html","الطويل"],[461,"دعوت الذي أرسى ثيرا بحوله","https://www.aldiwan.net/poem15631.html","الطويل"],[461,"طربت وما دارت علي زجاجة","https://www.aldiwan.net/poem16110.html","الطويل"],[461,"أقول لساري الليل والليل غابر","https://www.aldiwan.net/poem16236.html","الطويل"],[464,"سهادي وليلي فيك ما لها حد","https://www.aldiwan.net/poem3629.html","عموديه"],[464,"سرى موهناً والأنجم الزهر لا تسري","https://www.aldiwan.net/poem3632.html","عموديه"],[468,"أبا الفضل تبدي تمصبطرما","https://www.aldiwan.net/poem59771.html","المتقارب"],[513,"يعاتبني أناس في التصابي","https://www.aldiwan.net/poem67767.html","الوافر"],[515,"ولي حرمة الضيف الغريب وحرمة","https://www.aldiwan.net/poem12270.html","الطويل"],[538,"تجلت معاني الطعن من قدك اللدن","https://www.aldiwan.net/poem47919.html","عموديه"],[553,"خيال من النائي الهوى المتبعد","https://www.aldiwan.net/poem68426.html","الطويل"],[576,"يعيرني أمي رجال لا أرى","https://www.aldiwan.net/poem1777.html","الطويل"]],"verses":[["إِذا أَخَذَ الرَدى مِنّا رَجَعنا","إِلى صَبرٍ يُشَرَّدُ بِالغَرامِ",0,"م",1,0],["إِذا أَخَذَت مِنها الأَزِمَّةُ حَثَّها","نَجاءٌ وَأَعضادُ المَطِيِّ تَبوعُ",1,"ع",1,0],["إِذا أَخطَأوا مَرمىً مِنَ المَجدِ أَجهَشوا","زَئيرَ الضَواري أَفلَتَتها الفَرائِسُ",2,"س",1,0],["إِذا اِختارَت بَنو قَيسٍ نِزالي","رَجَعتُ وَلِلرَدى فيها الخِيارُ",3,"ر",1,0],["إِذا اِختَصَما كانَ الرَسولَ إِلَيهِما","لِسانٌ عَنِ الجِسمِ النَحيفِ مُراجِمُ",4,"م",1,0],["إذا أخْلَفَ الغيْثُ الأباطِحَ والرُّبا","فتَسْكابُ دَمْعِ المُقلَتَيْنِ يَجودُهُ",5,"د",2,0],["إِذا أَخصَبَت أَرضٌ وَأَجدَبَ أَهلُها","فَلا أَطلَعَت نَبتاً وَلا جادَها السَما",6,"م",2,0],["إِذا اِختَبَرتَ بَني الدُنيا وَجَدتَهُمُ","عَقارِباً وَثَعابيناً وَأَوزاغا",7,"غ",2,0],["إِذا أَخَذَتها هِزَّةُ الرَوعِ أَمسَكَت","بِمَنكِبِ مِقدامٍ عَلى الهَولِ أَروَعا",8,"ع",2,0],["إذا أَخَذوا أَدراعَهُ فَتَسَربَلوا","مُقَلَّصَ مَسروداتِها وَمُذالَها",9,"ل",3,0],["إِذا اخْتلَفَتْ فِي بَعْثِهَا وُجُهَاتُكُمْ","فَمَا ضَارَ أَصْلاً أَنَّ أَفْنَانَهُ شُعَبْ",10,"ب",1,0],["إِذا أَخَذَت مِسواكَها صَقَلَت بِهِ","ثَنايا كَنَورِ الأُقحُوانِ المُهَطَّلِ",11,"ل",1,0],["إِذا أَخو لَذَّةِ الدُنيا تَبَطَّنَها","وَالبَيتُ فَوقَهُما بِاللَيلِ مُحتَجِبُ",12,"ب",1,0],["إذا أخلف الناسَ الغمامُ وأمحلوا","فإن نداه والغمامَ لَسِيَّانِ",13,"ن",1,0],["إِذا أَخَذوا وَكَيدُهُمُ ضَعيفٌ","بِبابٍ يَمكِرونَ فَتَحتَ بابا",14,"ب",2,0],["إِذا أَخَذَت قَيسٌ عَلَيكَ وَخِندِفٌ","بِأَقطارِها لَم تَدرِ مِن أَينَ تَسرَحُ",15,"ح",1,0],["إِذا أخذت له في ما شَرِيطٍ","رآنَا بِالإِسَاءَةِ مُحسِنِينَا",16,"ن",2,0],["إِذا اِختَبَطوا لَم يُفحِشوا في نَدِيِّهِم","وَلَيسَ عَلى سُؤالِهِم عِندَهُم بُخلُ",17,"ل",1,0],["إذا اخْتصمَ الأقوام ضاءَ بفكرةٍ","يقول ضياء الصبح لست بخصمها",18,"م",3,0],["إذا أُخِّرتْ سرجُ الجبان وجدتَني","أغامسها في حومة الطعن والضربِ",19,"ب",1,0],["إذا اختطّ قومٌ خِطةً لمدينةٍ","تقاضتهمُ أضعافَها للمقابِر",20,"ر",1,1],["إذا أخذتُ المرآة أسْلفني","وجهي وما مُتُّ هول مطَّلعي",21,"ع",2,0],["إذا أخطأتْهُ ثُلمةٌ لا يجرُّها","له غيرهُ جاءتْه من ذاته الثُّلمْ",22,"م",1,0],["إِذا اِختَفى في الوَردِ لَونُ الضُحى","فَالذَنبُ ذَنبُ الأَعيُنِ الناظِرات",23,"ت",1,0],["إِذا اِختَلَفَت رَأياً فَما اِختَلَفَت هَوىً","أَوِ اِقتَرَفَت سَعياً فَما اِفتَرَقَت قَصدا",24,"د",2,0],["إِذا أُخلِيَت عودَ الهَشيمَةِ أَرزَمَت","جَوانِبُها حَتّى نَبيتَ نَذودُها",25,"د",3,0],["إِذا أَخلَفَت صَوبَ الرَبيعِ وَصى لَها","عَرادٌ وَحاذٌ أَلبَسا كُلَّ أَجرَعا",26,"ع",2,0],["إِذا أخَطأَ الأَحبابُ تَرتيبَ حالِهِم","فَإِنَّ فُؤادي دائما لَيُصيبُ",27,"ب",1,0],["إِذا اِختَلَفَ الزَمانُ عَلى حَزينٍ","مَضى بِالدَمعِ ثُمَّ مَحا الدِماعا",28,"ع",2,0],["إِذا آخَتِ الجَوهَرِيَّ الحُظوظُ","كَفَلنَ اليَتيمَ لَهُ في الصَدَف",29,"ف",1,0],["إِذا أَخَذَت أَطرافُهُ مِن قُنوئِها","رَأَيتَ اللُجَينَ بِالمُدامَةِ يُذهَبُ",30,"ب",1,0],["إِذا أَخذتَ العَصا تَواكَلَكَ ال","أَنصارُ إِلّا ما قُمتَ تَقتَضِبُه",31,"ب",2,0],["إِذا اختَلَفَت سُبلُ الرِجالِ وَجَدتَهُ","مُقيماً عَلى نَهجٍ مِنَ القَولِ واضِحِ",32,"ح",1,0],["إِذا اختارَ وَقتاً لِلنُجومِ يَعُدُّهُ","لِيَومِ وَغى عادَت نُحوساً سُعودُها",33,"د",3,0],["إِذا اِخضَرَّ عَيشومُ الجِفارِ وَأُرسِلَت","عَلَيهِنَّ أَنواءُ الرَبيعِ المَرازِمِ",34,"م",1,0],["إذا اختلَجَت مَناكِبُه لرَقصٍ","نَزَت طَيرُ القلوبِ إليه نَزْوَا",35,"و",2,0],["إِذا اِختَلَفَ الأَبطالُ وَاَشتَبَكَ القَنا","وَكانَ حَديثُ القَومِ ضَربُ الجَماجِمِ",36,"م",1,0],["إِذا اِختَلَّ الخَليلُ لَغَيرِ ذَنبٍ","فَلي في عَودِ صُحبَتِهِ الخِيارُ",37,"ر",1,0],["إِذا اِختَلَّ وُدُّ الخِلِّ مِن غَيرِ موجِبٍ","فَلي نَحوَ أَهلِ الوُدِّ مِنهُ ذَهابُ",38,"ب",1,0],["إذا أخذ البدر المنير مكانه","وملك آفاق السما وتمكنا",39,"ن",2,0],["إذا اختصموا في اللّه كانت قضاتُهُمْ","قواضبَ تَقْضي بينهم ولهاذما",40,"م",2,0],["إِذا اِختَلَّ ثَغرُ المَجدِ أَضحى جِلادُهُم","وَنائِلُهُم مِن حَولِهِ كَالعَواصِمِ",41,"م",1,0],["إذا أخَّرْت كتبَكَ عنْ محبٍّ","فإنكَ قدْ حشوتَ حشاهُ نارا",42,"ر",2,1],["إذا أخفى صديقكَ عنكَ سرّاً","وأبهمَ حالَهُ فسواهُ أولى",43,"ل",2,1],["إِذا اِختَلَفوا أَوِ اِتَّفَقوا فَإِنّا","سِوى اِستِقلالِ مِصرٍ لا نُريدُ",44,"د",1,0],["إذا أخذ السيْلُ الأَتِيُّ سبيلَه","فلا الشّرقُ مَسْدودُ الفجاجِ ولا الغربُ",45,"ب",1,0],["إِذا اِختَلَطَ الرِتاكُ مالَت سَراتُهُ","عَلى يَسَراتٍ أَو بُهُنَّ ذَريعُ",46,"ع",1,0],["إِذا اِختَلَجَتها مُنجَياتٌ كَأَنَّها","صُدورُ عَراقٍ ما بِهِنَّ قُطوعُ",46,"ع",1,0],["إِذا أَخَذَ القُرطاسَ خِلتَ يَمينَهُ","تُفَتِّحُ نوراً أَو تُنَظِّمُ جَوهَرا",47,"ر",2,0],["إِذا أَخَذَت أَطرافُهُ مِن قُنوئِها","رَأَيتَ لُجَيناً بِالمُدامَةِ مُذهَبُ",48,"ب",1,0],["إذا أخذَتْ أعلامُه صَدْرَ مِقْنَبٍ","رأيتَ شَرَورَى تحتَ نخلٍ مكَمَّم",49,"م",1,0],["إذا اختلفوا في الأمرِ ألّفَ بينهُم","طبيبٌ بأدواءِ النفوسِ السّقائم",50,"م",1,0],["إِذا أَخَذَتها الكَأسُ كادَت بِريحِها","تَخالُ بِها عِطراً وَما إِن تَرى عِطرا",51,"ر",2,0],["إِذا أَخلَفَ القَومُ ظَنّي بِها","وَكانَ لَها في غَدٍ مَوعِدُ",52,"د",1,0],["إِذا أُخرِجَت مِنّي لِقَومٍ حَدا بِها","مِنَ القَومِ حادٍ خَلفَها أَيِّدٌ غَرِد",53,"د",1,0],["إِذا أَخَذوا الزَوائِفَ أَولَجوهُم","وَلَو كانوا اليَهودَ أَو النَصارى",54,"ر",2,0],["إِذا أَخلَصَت لِلخَلّاقِ سِرّاً","فَلَيسَت مِن ضَوائِرَكَ الضَواري",55,"ي",1,0],["إِذا أَخَذَت قِسطاً مِنَ العَقلِ هَذِهِ","فَتِلكَ لَها في ضِلَّةِ المَرءِ قِسطانِ",56,"ن",1,0],["إِذا اِختَصَمَت في سَيِّءِ الفِعلِ وَاِبنَها","فَلا هِيَ مِن أَهلِ الحُقوقِ وَلا هو",57,"و",1,0],["إِذا أَخْفَيْتُهُ أَبْلَى فُؤادِي","وَإِنْ أَظْهَرْتُهُ غَضِبَ الْحَبيبُ",58,"ب",1,0],["إِذَا اخْتَمَرَتْ بِاللَّيْلِ قِمَّةُ رَأْسِهِ","تَفَجَّرَ مِنْ أَطْرَافِ لِمَّتِهَا الْفَجْرُ",59,"ر",1,0],["إذا اختلفوا لوجهِ الحقِّ يوماً","مشَوْا للحقِ فالتأموا التئاما",60,"م",2,0],["إذا أخذتها هزة ُ الروع أمسكت","بِمَنْكِبِ مِقْدَامٍ علء الهَوْلِ أرْوَعا",61,"ع",2,0],["إذا اختلفت رأيا فما اختلفت هوى ،","أو افترقت سعيا فما افترقت قصدا",62,"د",2,0],["إذا أخذوا أدراعهُمْ فتسربلوا","مُقَلَّصَ مَسْرُوداتِها وَمُذالها",63,"ل",3,0],["إذا اخترت من بين المذاهب مذهباً","فإياك أن تعتاض عنه بديلا",64,"ل",2,1],["إذا اختلف الأعداء عنكم ملامة","لتنشر محبتها المسامع موردا",65,"د",2,0],["إذا أخطوا أقاموا الحكم عذراً","وأوخذ بالخطيّة بالقليل",66,"ل",1,0],["إذا اختلفت بالأكرمين مجالسٌ","فإنك في كلِّ المجالس صدرُها",67,"ر",3,0],["إِذا اِختَبى رَبُّهُ يَومَ السَلامِ بِهِ","كَفَيتَهُ حاسِدَيهِ الشَمسَ وَالقَمَرا",68,"ر",2,0],["إِذا اِختَلَجَت عَيني أَقولُ لَعَلَّها","فَتاةُ بَني عَمرٍو بِها العَينُ تَلمَعُ",69,"ع",1,0],["إِذا أَخرَجتَني مِن لِظاها مَطامِعي","أُعادُ بِيَأسي وارِداً نارَ خيفَتي",70,"ي",1,0],["إِذا أَخلَفَ الراجي البخيلة جودُها","فَإِنَّ سَواءً فَقدُها وَوُجودُها",71,"د",3,1],["إذا اختلَفَت مَساوِئُها مَحَتها","محاسِنُها الَّتي فِيها اشتِباهُ",72,"ا",2,0],["إذا اختلَست باللحظ وافتَرست به","فلا عجبٌ سود العيونِ أسودُها",73,"د",3,0],["إذا اختفت في الهوى عني إساءته","أبدى تجنبه ذنبي قبل أجنيه",74,"ه",1,1],["إذا اختَبَرتْ كُنْهَ الرجال بعلمها","أفادَتْك عِلماً والرجال مخابر",75,"ر",1,0],["إذا أخَذَت بغاربهم يميني","أخذتُ بغارب الجدّ العثور",76,"ر",1,0],["إذا اختالَ فيه لابِسوهُ فحِلّةٌ","تزينُ ومن بعضِ الملابسِ أكفانُ",77,"ن",1,0],["إذا اختلفت أرضٌ خُفوضا ورفعةً","طغَى شامخا فاستبدل السهلَ بالحَزْنِ",78,"ن",1,0],["إذا أخيفوا رموا بخوفهمُ","وراء ما ألجموا وما زمُّوا",79,"م",3,0],["إذا اخضرَّ فرعٌ منهم اغبرّ أصله","فصوّحَ حتى يتبعَ العاطلَ الحالي",80,"ي",1,0],["إذا اختلَف الجدودُ فِظلتَ يوماً","تعدُّهم استوى عمٌّ وخالُ",81,"ل",1,0],["إذا اختلفت أسامي السير يوماً","فكلّ اسمٍ لمسراها السريعُ",82,"ع",1,0],["إذا اخضرّت بنانُ أبٍ كريمٍ","فصِبغتُها إلى الأبناء تُعدِي",83,"ي",1,0],["إذا أخفقَ القنَّاصُ راح بكل ما","يَرَى مُطعِمٌ للصيد منه كسوبُ",84,"ب",1,0],["إذا اختَصموا قالت تأخَّرْ فإنما","لنا السبقُ فاتبعنا وأنت جنيبُ",84,"ب",1,0],["إذا اختلطت لذَّاتُ حُبٍّ بعارهِ","فأنعَمُها عندي الذي لا أُصيبُها",85,"ب",3,0],["إذا أخمدَ النيرانَ قُرٌ مُراوحٌ","بأهداب رجَّاف العشيَّة مُرْعدِ",86,"د",1,0],["إذا اخْروَّطَ السَّيرَ العنيف برحلةٍ","هوى ابن لبونٍ واقتضى الحتف بازلُ",87,"ل",1,0],["اذا اخروَّط السير العنيف براكبٍ","دياجيرهُ عَرَّاقةٌ والهَواجِرُ",88,"ر",1,0],["إِذا أخمد النيرانَ ريعانُ زعزعٍ","يُعيدُ ذكيَّ الجمر قَرَّانَ شاتيا",89,"ي",2,0],["إِذا اخْترموا ألفيت جُلَّ تراثهم","كِرامَ المواضي والعِتاقَ المَذاكيا",89,"ي",2,0],["اذا أخْدج الرأي اللَّبيبُ لطارقٍ","أتيت تماميَّ الحجا غير مُخْدَجِ",90,"ج",1,0],["إذا اخْرَوَّط السير العنيف برفقةٍ","نَضا عيسَهُمْ إِسْراؤهُم والهواجر",91,"ر",1,0],["إذا اخْروَّط السير العنيف برُفْقةٍ","جَلَتْهم عن الأوطان شُهبٌ عواقر",92,"ر",1,0],["إذا أخمدت نار الأسى بعد هجعة","فعند الصبا بعد الخمود لها وقد",93,"د",1,0],["إذا أخترطت ألحاظهم وقدودهم","فبيض وسمر لذنَ بالبيض والسمر",94,"ر",1,0],["إِذا اِختَرتَ قُربى فَلا تَجعَلَن","خِطابَكَ مُنحَدِراً مِن عَلِ",95,"ل",1,0],["إذا اختلط الظلام وهم سكارى","بكاسات الرقاد إلى الصباح",96,"ح",1,0],["إذا اختار غيري ساحل اليم مورداً","وجدت جهاتي كلها ساحل اليم",97,"م",1,0],["إذا اختارَكَ التاريخُ إِبناً مُخَلَّداً","فقد عَرَفَ التَّاريخُ ما اختارَ مِن إِبنِ",98,"ن",1,0],["إِذا اِختَلَفَت أَهواءُ قَومٍ جَمَعتَهُم","عَلى العَفوِ أَو حَدِّ الحُسامِ المُهَنَّدِ",99,"د",1,0],["إِذا اِختَلَفَت يَوماً رَبيعَةُ صادَفَت","لَنا حَكَماً عَدلاً وَجَيشاً عَرَمرَما",100,"م",2,0]]}