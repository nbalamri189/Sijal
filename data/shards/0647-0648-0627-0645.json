{"poems":[[88,"جاز بي عرفها فهاج الغراما","https://www.aldiwan.net/poem68932.html","الخفيف"],[89,"كل صعب سوى المذلة سهل","https://www.aldiwan.net/poem8345.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[123,"بعلاكم وهو حسب المطنب","https://www.aldiwan.net/poem4363.html","الرمل"],[146,"كل يوم خل يرحل عنا","https://www.aldiwan.net/poem58418.html","الخفيف"],[146,"يا صحابي واين منى صحبى","https://www.aldiwan.net/poem58430.html","البسيط"],[327,"أرقت وشر الداء هم مؤرق","https://www.aldiwan.net/poem56359.html","الطويل"],[447,"عزاء فما نفس على الموت عزت","https://www.aldiwan.net/poem14440.html","الطويل"],[563,"ليس طيب الحياة غير وفاتك","https://www.aldiwan.net/poem34275.html","الخفيف"],[563,"لا تمش معه كما ترى","https://www.aldiwan.net/poem34486.html","مجزوء الكامل"],[563,"هو أمر وكل أمر","https://www.aldiwan.net/poem34499.html","مجزوء الخفيف"],[563,"هو كل شيء في الوجود الواحد","https://www.aldiwan.net/poem34584.html","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37971","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37975","المتقارب"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96663","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79933","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[563,"","https://poetry.dctabudhabi.ae/diwan/poem/68875","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200836","الوافر"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140007","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138664",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110061","الوافر"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102739","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83664","الخفيف"],[4852,"بغداد الدهور","https://www.poetsgate.com/ViewPoem.aspx?id=214428",""],[5064,"الهوامش المهشّمة","https://www.poetsgate.com/ViewPoem.aspx?id=199092",""],[5413,"فقد الأحبة غربةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=201389",""]],"verses":[["هُوَ آمالُنا وَحامي حِمانا","أَيَّدَ اللَهُ مُلكَهُ وَأَداما",0,"م",2,0],["هو إِمَّا الْحِمَامُ أَوْ عِيشَةٌ خَضْ","رَاءُ فِيهَا لِمَنْ تَفَيَّأَ ظِلُّ",1,"ل",1,0],["هُوَ أَمْرٌ لِمَنْ بَكَى فِيهِ عُذْرٌ","إِنَّمَا الصَّبْرُ فِي سِوَاهُ جَمِيلُ",2,"ل",1,0],["هو أمرُ اللَهِ في أيديكمُ","فاجذبوا الأرضَ به تنجذِبِ",3,"ب",1,0],["هو إما روحُ الحياة وإلا","فحياةٌ تظلُّ فيها مُعنَّى",4,"ن",2,0],["هو إما الذُّعافُ رقرقه الص","لُّ لحاويهِ أو هِناءُ النُّقْبِ",5,"ب",1,0],["هَوامِلُ في دارٍ كَأَنَّ رُسومَها","مِنَ الدَرسِ عادِيٌّ مِنَ الكُتبِ مُهرَقُ",6,"ق",1,0],["هوامل في روض الأَماني وما درت","جيوش المنايا بالرز أخفت",7,"ت",1,0],["هو أمر لنا قريب بعيد","فارجعي يا حروف في ألفاتك",8,"ك",1,0],["هو أمره والأمر قد","دره فجاء مقدرا",9,"ر",2,0],["هو أمر وكل أمرْ","وهو زيد هنا وعمروْ",10,"ر",2,1],["هو أمره القدر المقدر دائماً","في عين معترف بذاك وجاحد",11,"د",1,0],["هُوَ امْعلَمُ امْسَعديُّ وامْشّمسُ في امْضُحى","هو امْبدرُ في امْظلماءِ وامْكَوكَبُ امْدُرّي",12,"ر",2,0],["هوَ امْسيّدُ امْراقي على هامَةِ امْسُهَى","إِلى ذروةِ امْعَلياءِ في شَرفِ امْدَهرِ",12,"ر",1,0],["هُوَ امْبارِعُ امْدراك مِن حِينِ مَهدِهِ","هوَ امْعالِمُ امْنِحريرُ مِن عالَمِ امْذرِّ",12,"ر",1,0],["هوَ امْفردُ امْخالي عَنِ امِّثْلِ في امْعُلى","فَلَستُ أضاهيه بزيدٍ ولا عَمرِو",12,"ر",2,0],["هوَ امُّصطفى خيرةُ اللَّه مَنْ","أبان امْحلالَ لنا وامْحراما",13,"م",2,0],["هو امَّلجأُ امْحصينُ كهفُ امْوَرى","هو امُّغيث في امْدهرِ غَوثُ امْيتامى",13,"م",2,0],["هو أَمجدُ الأملاكِ إِن ذُكروا بما","فَعلوا منَ الأفعال وهو الأفخرُ",14,"ر",1,0],["هو أمجدُ الدنيا أباً","هو أكرمُ الثقلينِ خالا",15,"ل",2,0],["هُوَ أمرهُ الدِّينِيُّ جَاءَت رُسلُهُ","بِقِيَامِهِ فِي سَائِرِ الأزمَانِ",16,"ن",1,0],["هو أمر ترى الجبان شجاعاً","إن بدا منه والشجاع جبانا",17,"ن",2,0],["هوام في طريقي عارضاتٌ","على خطأٍ تُسمى بالأنام",18,"م",1,1],["هوامي دموعي أو هوامي جوانحي","نَشَرنَ الذي كان العراء طواه",19,"و",3,0],["هو أمر الله هل من عاصمٍ","دونه يلفى وان جل اقتدارا",20,"ر",2,0],["هوام هَواك أَفرَغَ فيك سَمّاً","ولا غَروَ الهَوَى مثلُ الهَوامِ",21,"م",1,0],["هوامع السحب لا ترقا مدامعها","من كل اسحم همامي الودق رجاس",22,"س",1,0],["هو أُمّ الكِتابِ مَعنىً رَآهُ","في علاهُ بِالذِكرِ قَلبٌ مُنيرُ",23,"ر",1,0],["هوامُ الأرضِ رغم الكمِّ تبقى","هوامًا .. مثلما تبقى الصقورُ",24,"ر",1,0],["هوامِشُنَا هُشِّمَتْ يَا حَبِيبَةْ","فهيَّا لنتلُوَ مَتنَ الرَّحِيلْ",25,"ل",1,0],["هو أمةٌ لم يخشَ إلا ربَّهُ","في عالَمٍ حُكَّامُهُ فُجَّار",26,"ر",1,0]]}