/poetry.dctabudhabi.ae/diwan/poem/67662","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73406","الخفيف"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139290","الخفيف"],[4830,"يالِقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=213988",""],[4859,"قناديل الإياب","https://www.poetsgate.com/ViewPoem.aspx?id=191609",""],[4997,"الأحول","https://www.poetsgate.com/ViewPoem.aspx?id=108085",""],[5183,"ألف أهلا","https://www.poetsgate.com/ViewPoem.aspx?id=185692",""],[5183,"طوى","https://www.poetsgate.com/ViewPoem.aspx?id=180160",""],[4045,"كنت أمشى مع المعذّل يوما","https://www.poetsgate.com/ViewPoem.aspx?id=200269",""],[5277,"زهرةٌ كرخيّةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=198878",""],[5281,"الحياءُ البِكر","https://www.poetsgate.com/ViewPoem.aspx?id=199311",""],[5358,"الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=21884",""],[5362,"ولدي وما أدراك ما ولدي","https://www.poetsgate.com/ViewPoem.aspx?id=170313",""],[5431,"إقرأ ....","https://www.poetsgate.com/ViewPoem.aspx?id=206810",""],[5642,"الغروب","https://www.poetsgate.com/ViewPoem.aspx?id=123668",""],[5691,"الحبر والورقة","https://www.poetsgate.com/ViewPoem.aspx?id=206386",""],[5736,"طاحون الهواء","https://www.poetsgate.com/ViewPoem.aspx?id=203881",""],[402,"ما موقفي في مصرف للمال","https://www.poetsgate.com/ViewPoem.aspx?id=36338",""],[5804,"الحب والغيب","https://www.poetsgate.com/ViewPoem.aspx?id=190654",""],[5845,"قفا برياضِ الشعبِ شعبِ القرنفلِ","https://www.poetsgate.com/ViewPoem.aspx?id=198491",""],[5897,"فضاءات حمد","https://www.poetsgate.com/ViewPoem.aspx?id=156362",""],[5309,"عشق الناس السلام","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573955",""],[6229,"من بين الأشوك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82505&r=&rc=40",""],[6328,"ليته جاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82087&r=&rc=6",""]],"verses":[["فَإِذا لَهجَتانِ مِن لَهَجاتِ ال","شَرقِ قَد شاقَتا فُؤادي فَهاما",0,"م",2,0],["فَإِذا لَم أُجب فَغَيرُ مَلومٍ","أَن يَرومَ المَشيبُ إِطفاءَ ناري",1,"ر",2,0],["فَإِذا لَقيتَ مُجَيلِساً مِن بارِقٍ","لاقَيتَ أَطبَعَ مَجلِسٍ أَخلاقا",2,"ق",2,0],["فإذا لاح وجهه في ذوي القص","د بعيدٍ قاضت يداه بعشر",3,"ر",1,0],["فإذا ليمت على ذاك قالت","ليس لي بالجاهلين ارتقاع",4,"ع",1,0],["فإذا ليم في تغاضيه عنها","قال من شأْنِيَ اطراحُ الهموم",5,"م",1,0],["فَإِذا لاحَ فَرَّتِ الناسُ ذُعراً","مِن طَريقِ المُنافِقِ الكَذّابِ",6,"ب",1,0],["فَإِذا لَذيذُ العَيشِ نَغبَةَ طائِرٍ","وَإِذا طَويلُ الدَهرِ خَطرَةَ مَرودِ",7,"د",1,0],["فإذا لُطِمت بألف كف لم تجد","للفخر قولا يا ابن إبراهيم",8,"م",1,0],["فَإِذا لَقيتَ لَقيتَ حَيّاً بائِساً","وَإِذا رَأَيتَ رَأَيتَ مَيتاً مُنكَرا",9,"ر",2,0],["فَإِذا لَقَّبوا قَوِيّاً إِلَها","فَلَهُ بِالقُوى إِلَيكِ اِنتِهاءُ",10,"ا",2,0],["فَإِذا لَقَيتَهُمُ فَمَوكِبُ أَنجُمٍ","زُهرٍ وَعَبدُ اللَهِ بَدرُ المَوكِبِ",11,"ب",1,0],["فَإِذا لَقيتَ مُحَمَّداً فَاسجُد لَهُ","لا غَروَ مَن صَلّى أَبا العَبّاسِ",12,"س",1,0],["فإذا لَقِيتَ أخا المكارمِ قائلاً","لم تَلقَ إبراهيمَ إلاّ فَاعلا",13,"ل",2,0],["فَإِذا لُحتَ كُنتَ قَيداً لِعَيني","وَإِذا غِبتَ كُنتَ قَيداً لِقَلبي",14,"ب",2,0],["فإذا لقيتَ مُهَفهفاً","أحوىً رخيماً قد نسَك",15,"ك",1,0],["فَإِذا لَمَستَ لَمَستَ أَجثَمَ جاثِماً","مُتَحَيِّزاً بِمَكانِهِ مِلءَ اليَدِ",16,"د",1,0],["فَإِذَا لَمْ يَرُدَّ عَنكَ الشَّظَايَا","فَليَكُنْ قَبلَ أَنْ تُصَابَ كَسِيرَا",17,"ر",2,0],["فَإِذَا لِلاِسْتِغْلاَلِ مَعْنًى مُخْلِفٌ","مَا كَانَ مِنْ مَعْنًى لِلاِسْتِعْلاَلِ",18,"ل",1,0],["فَإِذَا لَقَيْتكَ لَمْ يَكونَا","غَائِبَيْنِ وَأَنْتَ حَاضِرْ",19,"ر",1,0],["فإذا لَمستَ لمستَ أجخثَمَ جاثِماً،","متحيزاً بمكانهِ ، ملءَ اليدِ",20,"د",1,0],["فإذا لم تكنْ تعوَّضْتُ عنها","صُوراً من تخيّلاتٍ عِذاب",21,"ب",1,0],["فَإِذا لَبِستَ مِنَ الثَناءِ مَلابِساً","جُدُداً رَضوا بِمَلابِسٍ أَسمالِ",22,"ل",1,0],["فإذا لي تمّ ما أمّلتُه","عاد إنساني وروحي للجسد",23,"د",1,0],["فإذا لم يرحم الواحد من","خلق الواحد من ضعف فمن",24,"ن",1,0],["فَإِذا لِبَيتِكَ حينَ عُدَّ عَمادُهُ","عَرَضٌ يَزيدُ عَلى البُيوتِ وَطولُ",25,"ل",1,0],["فإذا لفظتُ ففلذةً لا لفظةً","إني أضنُّ بفلذةٍ أن تُلفظا",26,"ظ",2,0],["فإذا لهوتُ بها طربتُ وأشبَهت","أوتارَ عودٍ تحتَ أنملِ ضارب",27,"ب",1,0],["فَإِذا لا مَحيصَ عَن","هَذِهِ كَيفَ أَفزَعُ",28,"ع",1,0],["فَإِذا لا قَوا أُسوداً","أَوعَدَت أُسداً بِزيرِ",29,"ر",1,0],["فإذا لحنٌ تغشّاه الندم","ضارعٌ للَه في عليائه",30,"ه",1,0],["فإذا لم يقم وينقم للدي","ن فقم داعياً عليه بنقمه",31,"م",2,0],["فإذا لم يكن رجوع إليه","بخضوع وذلة ووبال",32,"ل",1,0],["فَإِذا لَم أَنَل من الجودِ سُؤلي","فَأَخو الجودِ سَيبهُ لي جَزيلُ",33,"ل",1,0],["فإِذا لَمْ تَزِنِ الْ","فِضَّةَ فاذْهَبْ بِسَلامِ",34,"م",1,0],["فإذا لقيت العام قابل إنني","لأزور وجهك إن أراد اللَه لي",35,"ل",2,0],["فإذا لبستَ التاج ثمَّتَ لم نفز","بفريدها فالتاجُ غيرُ مرصَّع",36,"ع",1,0],["فإذا لم يكن مجالٌ لسيفٍ","سلَّ آراءهُ وشام الحساما",37,"م",2,0],["فإذا لَواكَ من الحَواسِدِ حادِثٌ","صَبراً فأنتَ على الحَسودِ عَلِيُّ",38,"ي",1,0],["فإذا لَوَوا طَرْفاً إليكَ بِرَحْمةٍ","لِتَوَلُّهي فاذْكُرْ لَهُمْ أسراري",39,"ر",2,0],["فإذا له آجالُها عرضَتْ","عرضَتْ لها آجالُها الحُمرُ",40,"ر",1,0],["فإذا لكم بدتِ الرّسومُ فأمْسِكوا","أكبادَكُم حتّى يدَيكُم تنضجُ",41,"ج",1,0],["فإذا لُقينَ فإنهن عوالي","وإذ شممن فإنهن غوالي",42,"ي",1,0],["فَإِذا لم يكن هنالِكَ عُذرٌ","في قيامٍ فاقبض على دُيُوني",43,"ن",2,0],["فإذا لاح كوكبٌ","منك فاشهده تهتدي",44,"د",2,0],["فَإِذا لِما جَزَمَ الفَتى بِوُقوعِهِ","بِخِلافِ إِن فَاِفهَم أَخي وَتَفَهَّمِ",45,"م",1,0],["فإذا لم يَكن من الحبّ بدُّ","لأخي صبوةٍ فلي منه بدُّ",46,"د",1,0],["فاذا لم تُعطَ يا قلب المنى","دَعهُ لكن هل من الحبّ مفرّ",47,"ر",1,0],["فإذا لم أُحْسِنِ الشك","رَ فقل هذا حِمار",48,"ر",1,0],["فَإِذا لَقيتِ سَراتَهُم فَتَقَنَّعي","حَذَراً عَلى خُلُقِ الهُمامِ الأَروَعِ",49,"ع",1,0],["فإذا لثمَت يمينَهُ","منحتكَ أسباب الغِنى",50,"ن",2,0],["فإذا لم يكن بقَلبكِ إلا","ما أعدَّ الإِخلاصُ لِلمُخلصينا",51,"ن",2,0],["فإذا لاح للعيون جمال","من سجاياه لاح سعد السعود",52,"د",1,0],["فإذا لم تحترق في نارهم","عشتَ ما دمت لديهم تحت رق",53,"ق",1,0],["فإذا لغيرك ذمَّ موجفها السرى","حمدت إليك بنو السرى إيجافَها",54,"ف",3,0],["فإذا لذَّ لك العيشُ فَصُلْ","و