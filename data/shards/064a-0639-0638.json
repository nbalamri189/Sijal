{"poems":[[55,"أعلى الغور تعرفت الخياما","https://www.aldiwan.net/poem29816.html","الرمل"],[55,"أشوقا وما زالت لهن قباب","https://www.aldiwan.net/poem30761.html","الطويل"],[95,"سوى الحب لا تشفي الفؤاد المكلما","https://www.aldiwan.net/poem11364.html","الطويل"],[74,"إن هرب العبد ولا طالب","https://www.aldiwan.net/poem18245.html","السريع"],[72,"أأحبابنا ما ذا الرحيل الذي دنا","https://www.aldiwan.net/poem42814.html","الطويل"],[87,"حياة ما نريد لها زيالا","https://www.aldiwan.net/poem62956.html","الوافر"],[47,"أطلب النوم كي يعود غراره","https://www.aldiwan.net/poem63577.html","الخفيف"],[51,"لكل أمر جرى فيه القضا سبب","https://www.aldiwan.net/poem10329.html","البسيط"],[107,"على ذكرها فليعرف الحق جاهله","https://www.aldiwan.net/poem41937.html","الطويل"],[51,"لكُلّ أمرٍ جَرَى فيهِ القَضَا سَبَبُ،","https://www.poetsgate.com/ViewPoem.aspx?id=16961",""],[15,"معلقة عبيد بن الأبرص","https://www.poetsgate.com/ViewPoem.aspx?id=11410",""],[93,"موت العبقري","https://www.poetsgate.com/ViewPoem.aspx?id=52962",""],[164,"من فتى أعطاه موليه المنى","https://www.aldiwan.net/poem58957.html","الرمل"],[164,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[343,"رأيت صلاح المرء يصلح أهله","https://www.aldiwan.net/poem68796.html","الطويل"],[358,"اعمل بدنياك واحذر من عواقبها","https://www.aldiwan.net/poem40561.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122611","الوافر"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96991","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46535","الرجز"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123074","الرمل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123175","البسيط"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137929",""],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76094","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201486","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201441","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74065","المتدارك"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131110",""],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139285","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58031","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120457","الوافر"]],"verses":[["يَعظُمُ الناسُ فَإِن جِئنا بِكُم","كُنتُمُ الراعينَ وَالناسُ سَواما",0,"م",2,0],["يُعَظَّمُ أَحياناً وَلَيسَ تَجَبُّرٌ","وَيَنظُرُ غَضباناً وَلَيسَ سِبابُ",1,"ب",1,0],["يُعَظِّمْنَهُ عَنْ أَنْ يَمُرَّ زَمَانُهُ","مُنَاراً كَحُكْمِ اللهِ وَالبَعْضُ مُظْلِمَا",2,"م",2,0],["يعظم من كان لكم شاعراً","فكيف وهوَ الشاعرُ الكاتب",3,"ب",1,0],["يُعَظَّمُ مَن يَهوى وَيَطلُبُ قُربُهُ","فَتَكثُرُ آدابٌ لَهُ وَتَظَرَّفُ",4,"ف",1,0],["يُعَظِّمُ كُلَّ جُهدٍ عَبقَرِيٍّ","أَكانَ السِلمَ أَم كانَ القِتالا",5,"ل",2,0],["يُعظِمُ المالَ مَعشَرٌ وَأَرى الما","لَ بِحَيثُ اِزدِراؤُهُ وَاِحتِقارُه",6,"ر",2,0],["يُعَظِّمونَ أَخا الدُنيا وَإِن وَثَبَت","يَوماً عَلَيهِ بِما لا يَشتَهي وَثَبوا",7,"ب",3,0],["يُعظِّمُه في نفسِه ويُطِيعُه","وما يَقْضِ من أَمرٍ له فهو قابلُهْ",8,"ل",2,0],["يُعَظّمُونَ أخا الدّنْيا، فإنْ وثَبَتْ","عَلَيْهِ يَوْماً بما لا يَشتَهي وَثَبُوا",9,"ب",3,0],["يَعِظُ النَّاسُ مَنْ لا يَعِظُ الدْ","دَهْرُ ولا يَنْفَعُ التَّلْبِيبُ",10,"ب",1,0],["يعظ النابغ الخلائق حيّا","إنما موته أجلّ عظاته",11,"ت",2,0],["يعظم الخطب ويطفي فإذا","قيل يا أحمد أضحى هينا",12,"ن",2,0],["يعظم من قال اعبدوا ما أردتم","ويمدح من قال الالوهة تكسب",13,"ب",1,0],["يعظم أهل الكفر والأنبياء لا","يعاملهم إلا بحط المقادر",14,"ر",1,0],["يُعَظَّم في الدُنيا بِفَضلِ صَلاحِهِ","وَيُحفَظُ بَعدَ المَوتِ في الأَهلِ وَالوَلَد",15,"د",1,0],["يعظِّمون أَخا الدُنيا فَإِن وَثَبت","يَوماً عَلَيهِ بِما لا يَشتَهي وَثَبوا",16,"ب",3,0],["يعظِّمني بَعيدُ الدارِ عَنّي","وَلي مِمَّن أقارِبُه احتِقار",17,"ر",1,0],["يعظم في الدنيا شعائر دولةٍ","معظمةٍ في شرقها والمغارب",18,"ب",1,0],["يعظمون المالا","وَالموسر المُحتالا",19,"ل",2,0],["يعظم ربي أجرك","فعبدك مات عشقا",20,"ق",2,0],["يعظّم اللَه فيها الأجر لي وكذا","لي فيّ من بعدها جودوا بآمين",21,"ن",1,0],["يعظم من غزاةِ حماكش شأناً","ويرفعُ من حُماةِ حماكِ قدرا",22,"ر",2,0],["يُعَظِّمنَها إِمّا حَلَلنَ بِمُنتَدىً","فَيجلِسنَ سُفلاً وَهيَ تَجلِس في البَهوِ",23,"و",1,0],["يعظّم شأنيَ بعض الأنام","وتعظيمهم لي يسوق الخجلْ",24,"ل",1,1],["يعظمني الفذّ العظيم بعقله","فذا قد سما منه إلى فضليَ الفضلُ",25,"ل",1,1],["يَعظُمُ الفَتى","صالَ أَو قحم",26,"م",1,0],["يعظم الفرق في احتمال الهموم","بين إلفين ظاعن ومقيم",27,"م",1,1],["يعظمون إخا الدنيا وإن عثرت","يوماً به أولغوا فيه السكاكينا",28,"ن",2,0],["يعظُ الأنامَ بكلِّ ناد راكباً","جملاً عليهِ سكينةٌ ووقارُ",29,"ر",1,0],["يعظم قدره دان وقاص","ويكبره سماع او عيان",30,"ن",1,0]]}