,""],[5573,"ياعناد","https://www.poetsgate.com/ViewPoem.aspx?id=200344",""],[2110,"يا مهاة قد نأت عن مقلتي","https://www.poetsgate.com/ViewPoem.aspx?id=156291",""],[5732,"فتى بني وايل","https://www.poetsgate.com/ViewPoem.aspx?id=177900",""],[5741,"كم قطع الطرق نيل مصرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=187481",""],[5756,"الدنيا بخير","https://www.poetsgate.com/ViewPoem.aspx?id=5434",""],[5842,"أنين الشام/ محمد الرحمون","https://www.poetsgate.com/ViewPoem.aspx?id=113403",""],[6106,"موسم حج حكام الأمة للبيت الأبيض","https://www.poetsgate.com/ViewPoem.aspx?id=6305",""],[6142,"ما أوتيت أنبياء الله قبل من ال","https://www.poetsgate.com/ViewPoem.aspx?id=155711",""],[2220,"إذا جاءتِ الأسماء يقدمُها الله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11859&r=&rc=728",""]],"verses":[["بِالسُمرِ تَختَبُّ ثُعَيلِباتُها","مِثلَ ذِئابِ الرَدهَةِ العَواسِلِ",0,"ل",1,0],["بِالسُمرِ تَهتَزُّ في أَسِنَّتِها","وَالخَيلِ تَعدو العَنيقَ وَالرَبَعَه",1,"ع",2,0],["بِأَلسُنٍ راضَةٍ لِلقَولِ لَو نُضِيَت","نابَت عَنِ السُمرِ في الأَبدانِ وَالحُجُبِ",2,"ب",1,0],["بِالساحَتَينِ لِكُلِّ راجٍ مَوئِلٌ","وَلِكُلِّ عافٍ مَربَعٌ وَمَقيلُ",3,"ل",1,0],["بِالسَيِّدِ الحُلوِ الأَمينِ الَّذي","يَعصِمُنا في السَنَةِ العادِيَه",4,"ي",2,0],["بالساعة البيضاء حين تبلجت","أذن المهيمن أن يلم سواد",5,"د",1,0],["بِالسِندِ إِذ جَمُعنا تَكسو جَماجِمهُم","بيضاً تُداوي مِنَ الصَوراتِ وَالصَيَدِ",6,"د",1,0],["بالسعي تزدهر الحياة وإنما","لون الحياة بغير سَعيٍ كامد",7,"د",1,0],["بألسنِ نيرانٍ لهم وقواضبٍ","إذا ما دَعوا نادي النداء أنابوا",8,"ب",3,0],["بِالسِرِّ إِن باحوا تُباحُ دِماؤُهُم","وَكَذا دِماءُ البائِحينَ تُباحُ",9,"ح",1,1],["بِالسَحابِ الَّذي يَسُحُّ","وَبِالخادِعِ الجَهام",10,"م",1,0],["بالسَّائلِ الأَعمى وبالمعتوهِ","والشَّيخِ الكَبيرْ",11,"ر",1,0],["بالسيف بالنار بالغازات خانقة","وبابتعاث الوباء الفاتك الساري",12,"ر",2,0],["بِالسَيفِ وَالسِحرِ المُبينِ وَبِالطِلى","حَمَلا عَلَيَّ وَبِالقَنا المَشبوكِ",13,"ك",1,0],["بالسجن والقيد والحديد وما","يُنقضُ عند القيام من حلَقِهْ",14,"ق",2,0],["بِالسَيفِ أَرسَلَهُ الخَليفَةُ مُصلِتاً","وَالمَوتُ هَبَّ مِنَ العِراقِ جَنوبا",15,"ب",2,0],["بِالسَيرِ مَرفوعاً إِلى سَيِّدٍ","مَكانُهُ فَوقَ ذَويهِ رَفيع",16,"ع",1,0],["بِالسَيفِ في نَهنَهَةِ الكَتائِبِ","وَالصَبرُ فيهِ الحَمدُ لِلعَواقِبِ",17,"ب",1,0],["بِالسَمعِ وَالأَبصارِ وَالشَمِّ قَد","تُدرَكُ دونَ الذَوقِ وَاللَمسِ",18,"س",1,0],["بِالسَفحِ مِن هَمَذانَ إِذ سَفَحَت دَماً","رَوِيَت بِجُمَّتِهِ الرِماحُ الهيمُ",19,"م",1,0],["بِالسَكسَكِيِّ الماتِعِيِّ تَمَتَّعَت","هِمَمٌ ثَنَت طَرفَ الزَمانِ كَليلا",20,"ل",2,0],["بالسّاطعاتِ الشّافِياتِ من العَمَى","يَطْغَى غَياهِبَ أو يموجُ غُيوما",21,"م",2,0],["بالسّابقين الأوّلِينَ يؤمُّهُمْ","جبريلُ يَعتَنِقُ الكُماةَ مُشِيحا",22,"ح",2,0],["بِالسودِ مِن حِميَرٍ وَمِن سُلَفٍ","أَرغَنَ وَالشُمِّ مِن مَناسِبِها",23,"ب",3,0],["بِالسَيبِ مِنهُم نَفَرٌ سادَةٌ","إِلَيهِمُ تُلقي الجَماهيرُ",24,"ر",1,0],["بالسّعدِ جادَتْكِ السماءُ لتَسْعَدي","والغَفْرِ علَّ ذنوبَ أهلِكِ تُغفَر",25,"ر",1,0],["بِالسَّرِيِّ المُبَجَّلِ المنزلاوِ","يِّ سَرِيِّ الأَجْدَادِ وَالآباءِ",26,"ا",2,0],["بالسهدِ، لا بالكُحْل، يو","مَ الزحفِ كحَّلَتِ النواظر",27,"ر",1,0],["بالسيف في نهنهة الكتائب","عَضْبُ كَلَوْنِ المِلْحِ في أَقْرابِ",28,"ب",1,0],["بالسمعِ يَفْدي المرءُ ناظِرَهُ","وأنا فديتُ السَّمْعَ بالبصر",29,"ر",1,0],["بالسادة الاملاك والآل والاص","حاب يا رباه والتابعين",30,"ن",1,0],["بالسيد الصديق والفاروق","والحبر ذي النورين والتصديق",31,"ق",1,0],["بالسلط غزلان كما قيل لي","هضيمه الكشح حصان الخبا",32,"ب",2,0],["بِالسَّبِ مَن يَدَّعِى ما لَيسَ فِيهِ حَرِ","والمُصطفي مِن دُعَاتِ المُحدَثَاتِ بَرِي",33,"ر",2,1],["بالسبق منفردٌ بلَى في مَتنه","منه إلى طُرُق المعالى أسرعُ",34,"ع",1,0],["بِالسَيفِ ما عَرَفَ النُبُوَّ غِرارُهُ","مُذ سَلَّ وَالعَضُدِ الَّذي لَن يَنكُلا",35,"ل",2,0],["بالسَّعد يرفع رافع","يوماً وينصب ناصب",36,"ب",1,0],["بالسيّفِ والإِحسان تقتنص العلا","وحصولها بهما جيمعا مرتهنْ",37,"ن",1,0],["بالسعد دار نجم هذا الدار","والنعم الطويلة الأعمار",38,"ر",1,1],["بِالسَيفِ يُفتَحُ كُلُّ بابٍ مُقفَلٍ","وَتُحَلُّ عُقدَةُ كُلِّ خَطبٍ مُشكِلِ",39,"ل",1,1],["با