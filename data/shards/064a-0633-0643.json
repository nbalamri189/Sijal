/ViewPoem.aspx?id=202103",""],[5431,"لغة الحب أن تذوب عطاءً","https://www.poetsgate.com/ViewPoem.aspx?id=198222",""],[5512,"ربيعٌ أم خريف","https://www.poetsgate.com/ViewPoem.aspx?id=204667",""],[5533,"حنينٌ إلى الوَطَن","https://www.poetsgate.com/ViewPoem.aspx?id=177398",""],[5533,"أَشْجانُ الخَريف","https://www.poetsgate.com/ViewPoem.aspx?id=208126",""],[5596,"من وحي \"بون\"","https://www.poetsgate.com/ViewPoem.aspx?id=206482",""],[5672,"ملل الباكيات","https://www.poetsgate.com/ViewPoem.aspx?id=206428",""],[5691,"لاتحزني ياقدس...!","https://www.poetsgate.com/ViewPoem.aspx?id=206251",""],[6052,"قبة الهادي","https://www.poetsgate.com/ViewPoem.aspx?id=34642",""],[6052,"قبة الامام علي الهادي","https://www.poetsgate.com/ViewPoem.aspx?id=53825",""],[6115,"استغفرالله العظيم استغفر الله العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=180498",""],[6124,"أمسيات","https://www.poetsgate.com/ViewPoem.aspx?id=105842",""],[6124,"أين","https://www.poetsgate.com/ViewPoem.aspx?id=109739",""],[1333,"يا أيها المغتر بالله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=56036&r=&rc=14",""],[3155,"الأريج القديم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75609&r=&rc=32",""]],"verses":[["يسكن الناس إلى أفيائها","ويوافي تحتها الكل مَراده",0,"د",2,0],["يُسكِرُ الناظِرينَ كَرماً وَلَمّا","تَعتَصِرهُ يَدٌ وَلا عَتَّقوهُ",1,"ق",3,0],["يَسكُنُ الوَحشُ لِلوُثوبِ مِنَ الأَس","رِ فَكَيفَ الخَلائِقُ العُقَلاءُ",2,"ا",2,0],["يُسكِرُنا مِن كَأسِهِ","وَلَحظِهِ المُستَرِقِ",3,"ق",1,0],["يُسكِرُنا مِن نُطقِ أَلحاظِهِ","وَأَلسُنُ الأَعيُنِ خُرسٌ فِصاح",4,"ح",1,0],["يُسكِرُنا مِن خَمرِ أَلحاظِهِ","وَيَمزُجُ الجِدَّ لَنا بِالمُزاح",5,"ح",1,0],["يُسْكِرُ من شَمّهُ بسَوْرَتِهِ","فكيف بالمنتشي إذا شربَه",6,"ب",2,0],["يَسكُبُ الجودَ عِندَ نَغمَةِ عافٍ","كَالرَحيقِ عَلى الغِناءِ يُدارُ",7,"ر",1,0],["يُسكَرنَ أَنهارَ ماءٍ","زُرقاً عِذاباً نَقِيَّه",8,"ي",2,0],["يَسْكُتُ الأيْكُ وَالمَسَامِعُ مَلأى","بِصَدَى النوْحِ مِنك والتغرِيدِ",9,"د",1,0],["يسكب النفس والبيان على","الطرس فيطوى على الظلام افترارا",10,"ر",2,0],["يسكب لي الماء.. ولا يرويني","ويجعل الأغلال في يميني",11,"ن",2,0],["يسكن المخبرون صوت المضحي","يستعير الجنون وجها رزينا",12,"ن",2,0],["يُسكر سُكري مِن المدام إِذا","مَرَّ بِفِكري خَيال مَبسمِهِ",13,"ه",1,0],["يسك صوت المنى سمعي وتومض لي","ثغرها عن بديع جد خداع",14,"ع",1,0],["يُسكِّن أمرُك الحركاتِ منهم","فيخفُت خوفَه نفَس ونَبْض",15,"ض",1,0],["يَسكنُ الفِردوسَ يُعطى غُرفا","تحتَها للرسلِ أعلى موطنِ",16,"ن",1,0],["يُسكِرُني بِلَحظِهِ وَالكاسِ","سَقاكِ مِن مَعالِمٍ أَدراسِ",17,"س",1,0],["يَسْكُنُ الدّينُ لأقوى عِمادٍ","مِنْهُ والدُّنيا لأقْوى جَناح",18,"ح",1,0],["يسكبُ الدمع كلّما","هاجه نوح طائر",19,"ر",1,0],["يَسكن في بغداد","في نعمة تِلادِ",20,"د",1,0],["يسكن النور باطني","ولصدري يشرح",21,"ح",1,0],["يسكنُ الراشقُ في نزْعَتهِ","ورواءَ الرَّشْقِ طيَّارٌ عَجِلْ",22,"ل",1,0],["يُسكِرُني تغريدُها سُحْرَةً","كأنَّه قهوةُ خمّارِ",23,"ر",1,0],["يسكر العارفين منهم بديوا","ن التجلي الغيبي جامٌ فجام",24,"م",1,0],["يسكر العقل بالذي منه يبدو","فتفيض العلوم والأنباء",25,"ا",2,0],["يُسَكِّنُ الشوقَ ريَّا الريحِ إن نَسَمتْ","من الشآم وضوءُ البرقِ إن لمعا",26,"ع",2,0],["يَسكُنُ في الفِردَوسِ في قُبَّةٍ","مِن لُؤلُؤٍ في جيرَةِ اللَهِ",27,"ل",2,0],["يَسكُنُ الطَيرُ في الشِباكِ وَلا تَس","كُنُ رَوعاتُ قَلبِهِ الرِجافِ",28,"ف",1,0],["يسكتُ لكن بجوابٍ حاضرٍ","يتركُ أكبادَ الخصومِ فلذا",29,"ذ",2,0],["يسكرن مهما يلفظون ويسكروا","مهما لفظن وما هناك شراب",30,"ب",1,0],["يسكنُ الوحشُ هادئاً في كهوفٍ","آمناتٍ من وطأةِ الإنسانِ",31,"ن",1,0],["يُسَكّن روعةً ويُنيلُ أمناً","إذا بالخوفِ أفئدةٌ تطيرُ",32,"ر",1,0],["يسكُبُ السرَّ في سرائر قوم","أصبحوا بالوِصَال سكرى غرام",33,"م",1,0],["يَسكُنُهَا الرُّخُّ لأَنَّ فِيهَا","أَشتَاتَ أَفيَالٍ وَهُو يَرقُبُهَا",34,"ه",2,0],["يسكرني الكون فإن رأيتكم","تطير سكرتي ولذّاتي الأخر",35,"ر",1,0],["يسكن فيها بلا كراء","فار وبق وعنكبوت",36,"ت",1,0],["يسكبون الدموع من كل عين","ودموعي أمامهم تبياني",37,"ن",2,0],["يسكنون العُلا معاقلَ شُمّاً","ويرون الآدابَ ظلاً ظليلا",38,"ل",2,0],["يسكب أفواها من الذنوب","تمتد كالنهر إلى الجنوب",39,"ب",1,0],["يَسكنُ المِسكُ سُرَّةَ الظَّبي بَدأً","ثم يُصلِيه وَقدةَ الَجمَراتِ",40,"ت",1,0],["يسكن في بغداد","في نعمة تلادي",41,"ي",1,0],["يَسكُنُ الخَلَّ والصِفاحَ فَمَرّا","نَ وَسَلعاً وَتارَةً نَجديّا",42,"ي",2,0],["يُسْكرني قَرقفٌ يشعشعُها","لحظُ الطَّلا لا الطِّلا وقرقفُها",43,"ف",3,0],["يَسكبُ اللهوَ مداما رائقا","ويُذيق الروحَ إثمالا عليلا",44,"ل",2,0],["يسكت الدهر إن نطقت ويصغى","ملقيا سمعه إلى إنشادي",45,"د",2,0],["يسكن بها كل العباد المصلين","الركَّع السجَّد خشوع وطمانه",46,"ن",2,0],["يسكب القاف نهرٍ للغزل سلسبيل","يروي قلوب عطشا لو بغير سببه",47,"ب",2,0],["يسكُرُهُ وصْبُ لهيبِ الهوى","ولم يقُلْ مهلاً روَيداً كفى",48,"ف",2,0],["يسكن بجوفي خوف والخوف نوعين","خوف الفراق وخوف طعم الخيانه",49,"ن",2,1],["يَسْكُنُ فِي صَفْوِ بَصَائِرِهِمْ","سِحْرٌ يَتَرَاءَى مُنْطَلِقَا",50,"ق",2,0],["يسكب النور في العيون ولكن","أين للروح ومضةٌ من سناء؟",51,"ا",2,0],["يسكن من بغداد في كرخها","حيث رأيت القصر والباغا",52,"غ",2,0],["يسكب الصحو نجيعاً أحمراً","جارفاً يروي الثريا من دماه",53,"ا",2,0],["يسكب الروح للحبيب حنينا","وابتهالا يُحيطه في ولوعِ",54,"ع",1,0],["يسكنُ اللَّيلَ تحتَ خيمةِ بؤسٍ","يحسبُ السَّقفَ سقفَ قصرٍ منيفِ",55,"ف",1,0],["يَسْكُنني عِشْقُكَ يَسْكُنُنِي","لكنَّ الباغِي يَمْنَعُنِي",56,"ن",2,1],["يَسْكُبُ الطَّيْرُ عَبِيرًا مُتْرَفًا","يا لِطَيْفِ الطَّيْرِ إِنْ مرَّ أَسَرْ",57,"ر",1,0],["يسكب الأشجان في أدمعه","جوهراً شيب بماء الذهب",58,"ب",1,0],["يسكبن دمع العين اثر رواحل","يدرين ان صاروا هناك رواحلا",59,"ل",2,0],["يسْكُنُها الأرْمَنُ والكُرْدُ","والسِّرْيانُ والبُشْناقُ والشَّرْكَسُ",60,"س",1,0],["يسكب الشوق في القلوب هواها","وتفيض النفوس فيها حنانا",61,"ن",2,0],["يسكب الشوق في القلوب هواه","وتفيض النفوس منها حنانا",62,"ن",2,0],["يسكن بدار الخلد في روضات جنات النعيم","مادامه موحد وللطاعات ربي يسره",63,"ر",2,0],["يسكنُ الوهمُ الضّلوعَ الغافياتِ","كاسراً رُمحِي على بابِ المغارِ",64,"ر",1,0],["يَسكبُ المِلْحَ الّذي صارَ الأغاني","فوق قَلْبٍ كانَ زَهْرًا مِنْ شَبَابِ",65,"ب",1,0],["يسكن في الفردوس في قبة","من لؤلؤ في جيزة الله",66,"ل",2,0],["يَسْكُبانِ السحْرَ القديمَ جلالاً","وجمالاً على الفَناءِ عَصِيّا",67,"ي",2,0]]}