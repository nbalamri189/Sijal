{"poems":[[74,"هام بالركن هائم","https://www.aldiwan.net/poem20476.html","مجزوء الخفيف"],[87,"من أعجب الأخبار أن الأرنبا","https://www.aldiwan.net/poem8001.html","الرجز"],[82,"كل يوم مودع أو مودع","https://www.aldiwan.net/poem31388.html","الخفيف"],[50,"ما ارتد طرف محمد","https://www.aldiwan.net/poem64384.html","مجزوء الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85457","الخفيف"],[82,"كلَّ يوم مودِّع أو مودَّعْ","https://www.poetsgate.com/ViewPoem.aspx?id=3346",""],[315,"هنيئا بصوم لا عداه قبول","https://www.aldiwan.net/poem59517.html","الطويل"],[520,"إن السعادة قد أظل زمانها","https://www.aldiwan.net/poem12284.html","الكامل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66839","الكامل"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104045","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54058","الوافر"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114035","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109748","البسيط"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127373","البسيط"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127388","الرمل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65380","الخفيف"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/132914","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109891","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85277","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58031","الكامل"],[4767,"النهج الأصيل","https://www.poetsgate.com/ViewPoem.aspx?id=179919",""],[4858,"سلام الضعفاء","https://www.poetsgate.com/ViewPoem.aspx?id=34883",""],[4929,"مآل الغرور","https://www.poetsgate.com/ViewPoem.aspx?id=199347",""],[4978,"من قال كالصيف لم يعرف سجاياك","https://www.poetsgate.com/ViewPoem.aspx?id=180129",""],[4984,"في عيدها ..","https://www.poetsgate.com/ViewPoem.aspx?id=196952",""],[5409,"حياةُ الربيع وعصر الباب","https://www.poetsgate.com/ViewPoem.aspx?id=155499",""],[5431,"أمازلتَ ياقلبي تضخّ له الحُبا","https://www.poetsgate.com/ViewPoem.aspx?id=189641",""],[5674,"احذر حروف الشاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=191749",""],[5906,"أُمّة وأئمة","https://www.poetsgate.com/ViewPoem.aspx?id=188216",""],[520,"إن السعادة قد اظل زمانها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577667",""],[6225,"عَولَمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80968&r=&rc=237",""],[6225,"عَوْلمَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81105&r=&rc=299",""]],"verses":[["فعصى كلّ عاذلٍ","وتولَّى بركنه",0,"ه",1,0],["فَعَصَفَ الثَعلَبُ بِالضَعيفِ","عَصفَ أَخيهِ الذيبِ بِالخَروفِ",1,"ف",1,0],["فَعَصَتني الفَتاةُ كَيْداً وكانَتْ","في الهوى من يدي إلى الفمِ أطوَع",2,"ع",1,0],["فَعَصا نَداهُ بِراحَتي","أَعلو بِها الإِفلاسَ قَرعا",3,"ع",2,0],["فَعَصوني يا رب واِتبعوا من","لا يَزيد الأنام إلا خسارا",4,"ر",2,0],["فعصتني الفناة ُ كيداً وكانتْ","في الهوى من يدي إلى الفم أطوعْ",5,"ع",1,0],["فعصرك ما بين الليالي مواسم","لها غرر وضاحة وحجول",6,"ل",1,0],["فعصابة غزية غادرتها","وأجل ما ترجوه منك أمانها",7,"ن",3,0],["فعصاهمُ وأبت له","نفسٌ معزّزةٌ أبيَّهْ",8,"ي",2,0],["فعصيتُ إقدامي فما ودَّعتُهُ","إلاّ مُخالسة وعيري ترسُفُ",9,"ف",1,0],["فعصمتها لذاك المجد قيدٌ","وإني بالطلاق أرى انحلاله",10,"ل",2,0],["فعُصبةٌ هامُها بالقضب قد قضبت","وسيق منها الى علياك أجمالُ",11,"ل",1,0],["فعصرُ شاوول قد ولىَّ على كظمٍ","منه كما اوضحت عنه الأسانيد",12,"د",1,0],["فعصرتا قلب خطوا طريقكم","وحاذروا من وعود الزور والكذب",13,"ب",1,0],["فعصي مولاه ليت ال","حكم قد كان الإباده",14,"د",2,0],["فعصاني وقال هل مات يوماً","مُسلمٌ من حديثنا بالبخار",15,"ر",1,0],["فَعَصيتُهُ إن الشرا","ب عمارة البيت الخراب",16,"ب",1,0],["فعَصاهُ صارت حيَّةً فتَلَّقفَت","حيَّاتِ فِرعَونَ الذي بغياً طَغَى",17,"ا",1,0],["فعصت غواتاً أوردوها للردى","وأمير سوء قادها فاضلها",18,"ل",3,0],["فعصاها وضلّ بعد على علم","بأحكام ما جنى باجتراء",19,"ا",2,0],["فعصى وتابَ وقد تَقَّبلَ توبةً","مولاهُ حين بَدَا لهُ استغفارُ",20,"ر",1,0],["فعصر ثم كسر واغتصاب","لحكم الله من فحل الفحول",21,"ل",1,0],["فعصبة الكفر آلتْ أنْ تشتّتنَا","في كلّ ناحيةٍ، نشكُو وننتحبُ",22,"ب",1,0],["فَعَصى ربَّهُ فَحلّتْ عَلَيْهِ","لَعْنَةُ اللَّه الوَاحِدِ القَهَّارِ",23,"ر",1,0],["فعصف أيّارَ يودي بالزهور وما","كذاك في رقّةٍ إلمام يُمناك",24,"ك",1,0],["فعصرنا اليوم مرْقَاة لها صُعُدا","يسري بدرب العلا فورا بإعجال",25,"ل",1,0],["فعصر الشباب وأحلامه","مغان ينابيعها جاريه",26,"ه",1,0],["فعصفور أشعاري طليقٌ مغردٌ","على غصن أحلامي يبيتُ به صبّا",27,"ب",2,0],["فعصا جنوني حين يلقيها الهوى","تهتزُّ مثل الجنِِّ شهقة ساحرة",28,"ر",2,0],["فَعَصَتْ تَشُدُ حُروفُها فَحَسِبتُها","مالَتْ عَليَّ مِنَ الَأسى تَتَجَبَّرُ",29,"ر",1,0],["فعصابةٌ غزيةٌ غادرتها","وأجل ما نرجوه منك أمانها",30,"ن",3,0],["فعصرٌ داس فيه الُلبَّ","تحت حذائه القشرُ",31,"ر",1,0],["فعصْرٌ داسَ فيهِ اللُبَّ تحتَ حِذائهِ القِشرُ","وأقلامُ العطاءِ الحُرِّ في أيدِي الوفا جَمْرُ",32,"ر",1,0]]}