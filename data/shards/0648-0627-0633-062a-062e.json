277,"للهجرتينِ طريقٌ واحدٌ..","https://www.poetsgate.com/ViewPoem.aspx?id=206347",""],[308,"سلوا الدموع فإن الصب مشغول","https://www.poetsgate.com/ViewPoem.aspx?id=118851",""],[5320,"قلعة الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=40442",""],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""],[5397,"أخذ الريع من دموعي حذاره","https://www.poetsgate.com/ViewPoem.aspx?id=157939",""],[5582,"دَعْهُ يَحِنُّ لِشَجْوِهِ وَشُجُونِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63583",""],[5582,"قِفْ وَاسْأَلْ السَّفْحَ سَفْحَ الرَّمْلِ وَالبانَا","https://www.poetsgate.com/ViewPoem.aspx?id=63598",""],[5582,"شاقَتْكَ هِنْدٌ وَأَمْسَى الحَبْلُ مُنْصَرِمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63568",""],[5582,"أَتِلْكَ لِلحَيِّ أَحْداجٌ وَأَظْعانُ","https://www.poetsgate.com/ViewPoem.aspx?id=63592",""],[5582,"عُجْ بِالمَطِيِّ عَلَى رُسُومِ البانِ","https://www.poetsgate.com/ViewPoem.aspx?id=63599",""],[5691,"الشيخ والحاخام والبابا","https://www.poetsgate.com/ViewPoem.aspx?id=205928",""],[5691,"مُصفِّقون...!","https://www.poetsgate.com/ViewPoem.aspx?id=208536",""],[5790,"ما بعد بعدكم تصان دموع","https://www.poetsgate.com/ViewPoem.aspx?id=112069",""],[5845,"أيرجعُلي قربُ الحبيبِ المعاهدِ","https://www.poetsgate.com/ViewPoem.aspx?id=198432",""],[520,"يا من اذل ببسط العذر من جارا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577542",""],[520,"ردا احاديث المنى وأعيدا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577496",""]],"verses":[["وَاِستَخدَمَ الأَيّامَ في أَوطارِهِ","فَبَلَغنَ أَبعَدَ غايَةِ المُستَخدَمِ",0,"م",1,0],["وَاسْتَخْبِرِي عَنِّي النُّجومَ فَقدْ رَأَتْ","سَهَري وَأَرْوِقَةُ الغَياهِبِ جُونُ",1,"ن",1,0],["وأسْتَخْبِرُ الأطْلالَ عنْ ساكِني الحِمى","فلا الدّمْعُ يَشْفيني ولا الرّبْعُ يُخْبِرُ",2,"ر",1,0],["وَاِستَخبِري قافِلَ الرُكبانِ وَاِنتَظِري","أَوبَ المُسافِرِ إِن رَيثاً وَإِن سَرعا",3,"ع",2,0],["واستخرج الهول ما تخفي براقعها","تحت العجاجة والأوضاحَ في القصبَ",4,"ب",1,1],["واستخرجَ الحبَّ كنزاً من محاجرهِ","فقامَ يبكي على أحبابهِ ذهبا",5,"ب",2,0],["واسْتَخفَّتْهُ طَرْبَةٌ","يتغنَّى لها الهزَجْ",6,"ج",1,0],["واسْتخلفتْ بِنتَكَ تَعْساً أتعسا","متى تُلاقِ الرَّاهبَ المُبَرْنَسا",7,"س",2,0],["واستخْلفتكَ وما نَسلتْ مكانها","فابذلْ لناكتها عجانَك وابذلِ",8,"ل",1,0],["وَاِستَخبِروهُ إِلى كَم نارُ جَفوَتِهِ","أَما كَفى ما جَنَت نارُ الخُدودِ أَما",9,"م",2,0],["واستخرجوا منها فراخهمُ","ألوانها شتى على مهل",10,"ل",1,0],["وَاِستَخدَمَ الدَهرَ يَنهاهُ وَيَأمُرُهُ","بِعَزمِ مُغتَنِمٍ في زِيِّ مُغتَرِمِ",11,"م",1,0],["وَاِستَخارَ اللَهَ في عَزمَتِهِ","ثُمَّ ضَحّى بِقَفاهُ وَاِحتَجَم",12,"م",1,0],["واستَخبِرُوا الإِنْجِيلَ عنه وحاذِرُوا","مِنْ لَفْظِهِ التَّحْرِيفَ والتَّبْدِيلا",13,"ل",2,0],["واستخرج الخمرَ من مُبزلها","ولونها كالعقيق أو أصبح",14,"ح",1,0],["وَاِستَخَفَّ الفُؤادُ شَوقاً إِلى قُر","بِكَ حَتّى كَأَنَّني في الهَواءِ",15,"ا",2,0],["واستخبر النصر العزيز ولم يزل","يلوي بدين الدين فيك مطوله",16,"ل",2,0],["واستخفّ الحياة بالشدو حتّى","زادها فوق حسنها البكر حسنا",17,"ن",2,0],["واستخفَّ الشقيقةَ \" الصْرعُ \" فهي اليومَ","نِضوٌ يعالج الموتَ مُضنَى",18,"ن",2,0],["واستخفَّتْ به الشعوبُ ، وباتَتْ","وهي ترنو له بلحظٍ خفيّ",19,"ي",1,0],["واستَخرَجَ الزَّبَدَ المَرمِىَّ عَن تَعَبٍ","مِن بَعدِ ما بُثَّ في أعضَائِه النَّجَدُ",20,"د",1,0],["وَاِستَخَفّوا بي وَصاروا","كَقرودٍ خاسِئاتِ",21,"ت",1,0],["واستخدم الدهرَ فما يأمره","إلا أتى الطاعةَ في جوابه",22,"ب",2,0],["وَاِستَخدِمِ السَيفَ الَّذي ما فُلَّ في ال","هَيجاءِ وَالرَأيَ الَّذي ما فالا",23,"ل",2,0],["وَاِستَخلَفاكَ فَنَوَّهَت بِكَ هِمَّةٌ","أَربى الأَخيرُ بِها عَلى المُتَقَدِّمِ",24,"م",1,0],["واستخدم الاقدار فيما تشتهي","إذا فما تعصى عليك أمرا",25,"ر",2,0],["واستخبروا الأرضَ ما للشمسِ كاسفةٌ","فما جهينةُ إلا عندها الخبرُ",26,"ر",1,0],["واستخرج الأخبار في السنن التي","ثبتت وصحت أحسن استخراج",27,"ج",1,0],["وَاِستَخدَمَت عونُ القَوا","في فيكَ أَبكارُ المَعاني",28,"ن",2,0],["وَاِستَخرِجِ المالَ الَّذي","جَمَّعَهُ وَاِرتَفَقَه",29,"ق",2,0],["وَاِستَخدَموا الأَيّامَ وَاِقتَعَدوا عَلى","صَهَواتِها وَالدَهرُ طِفلٌ يَرضَعُ",30,"ع",1,0],["واستَخرَجت منه أصواتاً طبيعتنا","لها أراجيح خفّت من تلاحينا",31,"ن",2,0],["واستخرج النفس أَملاك مطهرة","لها إِلى لطفك المأمول ترحال",32,"ل",1,0],["وأستخبر النجدى ان هب عائدا","بربع اللوى عَن ظنتي وَعقائدي",33,"د",2,0],["وَاسْتَخْلَصَ الْحَمْدَ الْجَزِيلَ لِنَفْسِهِ","فَحَواهُ وَاتَّخَذَ السَّماحَ خَلِيلا",34,"ل",2,0],["واِستَخدموا منه المنايا والمنى","فَكأنّه لِجسومهم أعضاءُ",35,"ا",2,0],["واستخف الوجود حسن مجاليه","وهامت بكلها الأجزاء",36,"ا",2,0],["وَاِستَخف شحّ النَفس إِن تَك في غِنى","فَالمَرءُ أَقبَح ما يَكون شَحيحا",37,"ح",2,0],["واستَخبِر الأيامَ عن صَرفِها","في أيهم أصبحَ مَحصورا",38,"ر",2,0],["واستخبرنْهُ مُعلناً متى اعترفْ","وهل وفَى القانونَ وافرِزْ ما اقترفْ",39,"ف",1,0],["واستخبرنَّ رياضَها وغياضها","فلقد أضعت بظلِّهن فؤادي",40,"د",2,0],["وَأَستَخير الريح عَن أَحبتنا","فَعِندَها مِن حَديثهم خَبَر",41,"ر",1,0],["واستخرفي كل أمر شئته","واستشر أهل البصائر والعبر",42,"ر",1,0],["واستخبرت عني فقلت لها امرؤ","نائي المواطن من كرام الشام",43,"م",1,0],["واستخرجت كبدها في رأس مخلبها","بضربةٍ هي بعض من عجائبها",44,"ب",3,0],["واسْتَخَفَّتْهُمُ المقاديرُ حتَّى","زُلْزِلُوا حيثُ يَمَّمُوا زِلْزالا",45,"ل",2,0],["واستخْدَمَ الثَّقَلَيْنِ طَوْعَ حُسامِه","وهو الذي يتحمَّلُ الأَثقالا",46,"ل",2,0],["واستخدم الأعلام لل","أقلامِ والصّمْصامِ غالِب",47,"ب",1,0],["واستخدم الأيامَ في","أحكامِه نهياً وأمْرا",48,"ر",2,0],["وأستخبِرُ الحادي ولا علمَ عندَهُ","بما كتمَتْ عنه القَنا والقنابِلُ",49,"ل",1,0],["وَاسْتَخْلَصوا مِنْ جَوْهَرٍ وَمَلابِسٍ","وَطرائِفٍ وَذَخائِرٍ وَأَوانِ",50,"ن",1,0],["واسْتَخْبِرَا نَفَحاتِ الرِّيحِ هل سَبَكَتْ","دُرّاً من التِّبْرِ أَوْ شابَتْ دُجىً بِضُحى",51,"ح",2,0],["واسْتَخْلِفِ العَارِضَ المُنْهَلَّ يَخْلُفُهُ","رَوْضٌ تَصِيفُ بِهِ مِصْرٌ وتَرْتَبِعُ",52,"ع",1,0],["واستخدموا لمنافع ال","تأريخ هاتيك الذخائر",53,"ر",1,0],["واستخلفوني والجوى بي شاخصٌ","حيرانَ أسألُ منه غيرَ مبينِ",54,"ن",1,0],["واستُخرجوا من طينة كانت بهم","عنصرَ بيت الفخر أو صَلصالَه",55,"ل",2,0],["واستخدموا الأقدارَ في أمركُم","تسمعُه وتُسرعُ امتثالَه",55,"ل",2,0],["واستخدم الأيّامَ نَفّاعةً","تجري بما شئتَ وضرَّارَهْ",56,"ر",2,0],["واستخدم النيروزَ واسعد به","مستعملاً في العزّ مستعمرا",57,"ر",2,0],["واستخدم الأقدارَ في ضبطها","واستشِر الإقبالَ واستصحِبِ",58,"ب",1,0],["واستخْمد الشَّفَّانُ كل ضريمةٍ","فاذا تَلَظِّيَ كلِّ جَمْرٍ أفْكلُ",59,"ل",1,0],["واستخرجوك من الغياهب بعدما","وجدوك فيها جاهلا بالنور",60,"ر",1,0],["واستخدم الفكر في نفع الأنام ولا","تصد عن وطن رباك من صغر",61,"ر",1,0],["واستخدمتها يد الأيام في شظف","وجاذبتها بأسلاك لمحتجن",62,"ن",1,0],["واستخرج الياقوت من أغواره","بهر العقول شعاعه الوضاء",63,"ا",2,0],["وَاِستَخلَفَ الفَلَكُ الدَوّارُ هِمَّتَهُ","فَلَو وَنى أَغنَت الدُنيا عَنِ الفَلَكِ",64,"ك",1,0],["واِستَخبِر البَرْقَ الضحوكَ إذا اِنْبرى","شطرَ اللّوى عمّن حكاه بثغرِهِ",65,"ر",2,0],["واِستخدَمَتْ أجفانُكُم بيضَ الظُّبا","فعصيُّهُنّ لها مُجيبٌ طيّعُ",66,"ع",1,0],["واِستخرجَتْ أيدي الرّبيعِ كُنوزه","فحبَاهُ بالبيضاءِ والصّفراءِ",67,"ا",2,0],["واستخبر الهول كم آنست وحشته","وكم وهبت له روحي ولم أهب",68,"ب",1,0],["واستخبروا رياً برامة نافراً","لما لا يريد عن الصدود صدودا",69,"د",2,0],["واستخبر ابن عريف والرشيد تجد","لديهما نبأ مني وإخبارا",70,"ر",2,0],["واستخفوا بنا على سوء ظن","ثم عادوا باللوم والتأنيب",71,"ب",1,0],["واستخلف النبي نوح ساما","من بعده في قومه فقاما",72,"م",2,0],["واستخفوا لحربه بثلاث","بين سهم وصار وسنان",73,"ن",1,0],["واستَخبِرِ الناسَ عمّا أنت جَاهِلُه","إذا عَمِيتَ فقد يَجلو العَمَى البَصَرُ",74,"ر",1,0],["واستَخَفَّ الصِّغارُ قَيساً فَما ش","مَّ بأنفٍ إلا بأنفِ الصَّغار",75,"ر",1,0],["واستخدم الافلاك طراًّ مصحفاً","واجعل مدادكَ كل ماءِ الرافدَين",76,"ن",1,0],["واستخبروا ريح الصبا تخبركم","عن بعض ما يلقى الفؤاد المغرم",77,"م",1,0],["واسْتَخْلَصتْ من فحمةِ القلب الشَّجِي","صِبغاً لنونِ الحاجِبِ المَقْرُونِ",78,"ن",1,0],["واستخدموا الفجر أي فجر النصال ففي","وريد كل كمي لاح منفجرا",79,"ر",2,0],["واستخفوا بكل عبء فلما","حملوا اليوم عبئك استثقلوه",80,"و",2,0],["واستُخٍفَّ الدثارُ من بعدِ ما اسْتُثْ","قِلَ في الليلِ والنهارِ الدّثار",81,"ر",1,0],["واستُخْلِصَتْ لسيوف سيفِ الدولة الدّ","نيا هَنَ