hqas&qid=76302&r=&rc=50",""],[6239,"النشيد العالي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75976&r=&rc=27",""],[6259,"هبُوا أنّ سجني مانع لوصاله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59393&r=&rc=41",""],[6291,"طفولة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87679&r=&rc=13",""],[2220,"إنَّ الوجودَ لعينِ الحكمِ والذاتِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11233&r=&rc=107",""],[6324,"نجوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87950&r=&rc=15",""],[6357,"ونقعد ُ كالنساء ِ ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78226&r=&rc=20",""]],"verses":[["صَغا قَلبي إِلى الحِلمِ","بِلا قَولِ العَذولَينِ",0,"ن",1,0],["صَغَّرَهُ في أَعيُنِ ال","غيدِ بَياضٌ وَكِبَر",1,"ر",1,0],["صَغيرُهُم كَكَبيرٍ في اِقتِناء عُلا","مَن تَلقَ مِنهُم تَقلْ لا قَيتُ سَيِّدَهُمْ",2,"م",1,0],["صُغْتُها في النَّسيبِ وَالفَخْرِ حَتّى","عُدَّ فيها الإعْجازُ مِنْ أَوْصافي",3,"ف",2,0],["صَغا إِلى اللاحي وصَغْوُ الهَوى","إليهِ لا رُوِّعَ صَبٌّ بِلاحْ",4,"ح",1,0],["صُغتُ القَريضَ فَما غادَرتُ لُؤلُؤَةً","في تاجِ كِسرى وَلا في عِقدِ بورانِ",5,"ن",1,0],["صَغِيرَة النَّارِ عصْفُ الرِّيحِ يُطْفِئُهَا","وَمُعْظَمُ النَّارِ عَصفُ الرِّيحِ يُذْكِيهِ",6,"ه",1,0],["صُغْتَ الُقَرِيضَ وَمَنْ يَصُوغُ فَرِيدَهُ","إلاَّكَ صَوْغَ قَلاَئِدِ الْعِقْبَانِ",7,"ن",1,0],["صُغْتُ القَرِيضَ فَرَاحَ يَبْهَى فِي الحِلَى","مَا صِيغَ مِنْ دُرٍّ وَمِنْ عِقْيَانِ",8,"ن",1,0],["صغرَتْ عَظَائِمُهَتا لَدَى تَكْوِينِهَا","وِصِغَارُهُنَّ عَلَى النِّظَامِ عَظَائِمُ",9,"م",1,0],["صِغارُ الجَماجِمِ ثُطُّ اللِحى","كَأَنَّهُمُ القَملُ بِالبَلقَعِ",10,"ع",1,0],["صغت الوعود لها صياغة ماهرٍ","وجمعت بين خلاخلٍ وشنوف",11,"ف",1,0],["صغت من حلاك يا ابن عليٍّ","طوق مجدٍ على الفخارِ مقيم",12,"م",1,0],["صغيرٌ وهو إذ يتلو كبيرٌ","فما أدرِي بنيّ أو أبيّ",13,"ي",1,0],["صَغا إليهم وولّاهم أمانتَهُ","دون الأنام فلم يَرْتَبْ ولم يُرِبِ",14,"ب",1,0],["صَغَّروها مخافةَ العيْنِ عَمْداً","وهي أَعلى القيانِ قَدْراً وشانا",15,"ن",2,0],["صَغُرَت حِكمَةُ الشُيوخِ لَدَيها","وَاِستَخَفَّت بِكُلِّ ما لِلشَبابِ",16,"ب",1,0],["صَغُرَت نُفوسُهُمُ فَباتَ عَزيزُهُم","يَخشى الجَبانَ كَما يَخافُ الطاغِيَه",17,"ي",2,0],["صَغيرُهُمُ وَكُلُّهُمُ سَواءٌ","هُمُ الجَمّاءُ في اللُؤمِ الغَفيرُ",18,"ر",1,1],["صغيرات الحجوم محقراتٌ","ومنها الكائنات لها ابتناءُ",19,"ا",2,0],["صغار في الذهاب وفي الإياب","أهذا كل شأنك يا عرابي",20,"ب",2,1],["صِغارٌ بِحُلوانَ تَستَبشِرُ","وَرُؤيَتُها الفَرَحُ الأَكبَرُ",21,"ر",1,1],["صِغارِ الحَجمِ مُرهَفَةِ الحَواشي","لَها عُرفٌ إِذا خَطَرَت وَجَرسُ",22,"س",1,0],["صَغُرتَ عَنِ المَديحِ فَقُلتَ أُهجى","كَأَنَّكَ ماصَغُرتَ عَنِ الهِجاءِ",23,"ا",2,0],["صُغتُ السِوارَ لِأَيِّ كَفٍّ بَشَّرَت","بِاِبنِ العَميدِ وَأَيِّ عَبدٍ كَبَّرا",24,"ر",2,0],["صَغَّرتَ كُلَّ كَبيرَةٍ وَكَبُرتَ عَن","لَكَأَنَّهُ وَعَدَدتَ سِنَّ غُلامِ",25,"م",1,0],["صَغُرَت مَقاديرُ الرِجالِ وَقارَبوا","في السَعيِ حَتّى ما تَرى لَكَ حاسِدا",26,"د",2,0],["صَغَّرَ قَدري في الغانِياتِ وَما","صَغَّرَ صَبّاً تَصغيرُهُ كِبَرُه",27,"ر",2,0],["صَغيرٌ يُرَجّى لِلكَبيرِ ضُحى غَدٍ","وَكَم مِن كَثيرٍ قَد بَداهُ قَليلُ",28,"ل",1,0],["صَغُرَت دِلائُهُمُ فَما مَلَأوا بِها","حَوضَن وَلا شَهِدوا عِراكَ زِحامِ",29,"م",1,0],["صَغيرُهُم لا يَعيبُهُ صِغَرٌ","وَشَيخُهُم لا يَشينُهُ هَرَمُ",30,"م",1,0],["صُغتُ القَريضَ وَلَم أَقُلهُ تَكَلُّفاً","لَكِنَّهُ طَبعٌ لَدَيَّ عَزيزُ",31,"ز",1,0],["صَغُرَتْ رَأْسُهُ وَأَفْرَطَ فِي الطُّولِ","شَوَاهُ وَعُنْقُهُ فَهْوَ صَعْلُ",32,"ل",1,0],["صَغيرَينِ نَرعى البَهمَ يا لَيتَ أَنَّنا","إِلى اليَومِ لَم نَكبَر وَلَم تَكبَرِ البَهمُ",33,"م",1,0],["صَغَا قلبُه فاختارها خُطّةً هُدىً","تُجنِّبُ مَن يَختارُها كُلَّ لائِمِ",34,"م",1,0],["صغائر افعال الملوك عظائم","وأعراسها في الناكثين مآتِمُ",35,"م",1,1],["صَغيرُ الأَذى يَدعو كَبيراً لِأَهلِهِ","وَتَفتَضِحُ القُربى بِذَنبِ غَريبِ",36,"ب",1,0],["صِغارِ النَوى مَكنوزَةٍ لَيسَ قِشرُها","إِذا طارَ قِشرُ التَمرِ عَنها بِطائِرِ",37,"ر",1,0],["صغرت بعينك للنزو","ح وَما هنالك من صغار",38,"ر",1,0],["صغا لها الليلُ واستحثّا","سواكنَ الريح للهبُوبِ",39,"ب",1,0],["صُغْتُهُ صوغَ خالقٍ يعشق الْ","فَنَّ ويسمو لكل معنى دقيقِ",40,"ق",1,0],["صَغِيرَيْنِ لَمْ يَذْهَبْ بِنَا الظَّنُّ مَذْهَباً","بَعِيداً وَلَمْ يُسْمَعْ لَنَا بِطَوَائِلِ",41,"ل",1,0],["صِغَارٌ تُقَوَّمُ أَعْطَافُهُمْ","لِيَنْمُوا صِلاباً كَمَا قُوِّمُوا",42,"م",3,0],["صَغُرُوا لَدِيْكَ فَلَمْ تَسِرْ لِقِتَالِهِمْ","وَهُمُ الكِبَارُ رَمَيْتَهُمْ بِكِبَارِ",43,"ر",1,0],["صَغِيرَةٌ أَمْرُهَا كَبِير","وَهَكَذَا الْشَّأْنُ فِي الصِّغارْ",44,"ر",1,0],["صِغْهَا عُقُوداً لِهَذَا الْيَوْمَ مِنْ دُرَرٍ","وَحَيِّ فِيهَا العُلاَ وَالْعِلْمَ وَالأَدَبَا",45,"ب",2,0],["صُغِ القوافي كما تهوى أو اعتذِر","لو كان يرضى الهوى عُذرا لمُعتذر",46,"ر",1,1],["صُغتُ الأكاليل من نور ومن أرجٍ","للعيد للسّحرِ للأقداح للوَتَرِ",46,"ر",1,0],["صغرت فهبها في اللآلي حبة","أو لا فهبها في الأزاهر برعما",47,"م",2,0],["صَغَت إِلى الدُرِّ ضارِباتٍ","صَدري وَقالَت هُنا المَغاصُ",48,"ص",1,0],["صَغُرتَ سِنّاً كَبُرتَ قَدراً","كَمُلتَ حَتّى عَدا اِنتِقاصُ",48,"ص",1,0],["صَغيرُ السِنِّ لَو دامَت سُنوهُ","عَقَدتُ عَلى السِماكِ بِهِ لِوائي",49,"ا",3,0],["صغر اليأس لن يرى","بين عيني مقصده",50,"د",2,0],["صغارٌ، نربِّيهم بمثل عقولهم","ونبنيهمو، لكننا نتهدَّم",51,"م",1,0],["صغارٌ بغوا للنحو شرَّ وسيلة","تضِل بها للسالكين المقاصد",52,"د",1,0],["صغير سن وراس قوم ولالالالا بعد.؟","تفرق عن أقراني.؟ عظم iشخصيّتي",53,"ت",2,0],["صَغُرَتْ دِلاؤهُمُ، فَما ملأوا بهَا","حَوْضاً، ولا شَهِدوا عِرَاكَ زِحَامِ",54,"م",1,0],["صغيرتي إن عاتبوكِ يوماً","كيف قصصتِ شعركِ الحريرا",55,"ر",2,0],["صُغْنَ لَهَا مِنْ فَحم تِلْكَ الغَيَاهِبِ","ذَكَاءً مِن الماسِ المُضِيءِ الجَوَانِبِ",56,"ب",1,0],["صَغير إِذا عدَّت سنيُّ زَمانِهِ","كَبير بِهِ أَشياخنا الغُر تَقتَدي",57,"د",2,0],["صَغير إِذا عُدَّت سَنيّ زَمانِهِ","وَفي المَعلوات الغرّ شَيخ رِجالِها",58,"ل",3,1],["صَغا إِلَيهِ إِلى أَن صارَ مَوطِنَهُ","فَلو عَداهُ وَلَن يَعدوهُ ما اِغتَرَبا",59,"ب",2,0],["صُغت المديح وقد سبقت بمدحكم","فكأنني قد جئت بالتضمين",60,"ن",1,0],["صَغيرُ هَواهُ في الفُؤادِ مَنِيَّةٌ","فما الظَّنُّ إن أوفى عَلَى الأمَدِ الأقصى",61,"ص",2,0],["صغيرُكم في اكتساب المجد مكتهلٌ","وكهلكم همه في المجد لم يشبِ",62,"ب",1,0],["صَغُرْتَ عَنِ الأَمْرِ الَّذِي رُمْتَ فِعْلَهُ","فَطَالَعْتَنِي بِالضّغْنِ مِنْ كُلَّ جَانِبِ",63,"ب",1,0],["صِغارِ السنِّ وافرةٍ سِمانٍ","تُريكَ صفاءَ ناعمةٍ نِضاج",64,"ج",1,0],["صِغار لها سِمَنٌ ظاهِر","تدل على حِذْق عَلاّفها",65,"ف",3,0],["صغار الأفاعي والعقارب شرّها","وأقتلها لسبا وإن خفي اللسب",66,"ب",1,0],["صغيرين لم تَصْغُرْ حياتي عليهما","ولا كان حظِّي باليسير ولا النزر",67,"ر",1,0],["صغيرة السن بالالباب عابثة","اتى بها الحسن من آياته الكبر",68,"ر",1,0],["صغيرة السن بالالباب عابثة","اتى بها الحسن من آياتها الكبر",69,"ر",1,0],["صغار الدر قد نظمت بفيها","وذاك الدر ما احلى صغاره",70,"ر",2,0],["صغيرُ جسمٍ لَجُوجٌ في سماحتِهِ","يأتي الندَى وهو ركَّاضٌ وَوَثَّابُ",71,"ب",1,0],["صَغيرٌ بَريءُ العَينِ يَرضى بِلُعبَة","فَيَرقِد مَغبوطاً بِذي الهبةِ الكُبرى",72,"ر",2,0],["صَغيرَةُ السنّ لَها أَعيُنٌ","زرقٌ وَخدّ أَبيَضُ أَحمَرُ",73,"ر",1,0],["صِغارا وكبرى في الكؤوس كأنها","على الراح واوات تجمّعن في سطر",74,"ر",1,0],["صَغَّرتَ أَفعالَهُم وَلا حاتِمٌ","يُذكَرُ في دَهرِهِم وَلا هَرِمُ",75,"م",1,0],["صغرت عليكَ من الخصومِ عظائمٌ","ولديكَ أعظمُهم يذلُّ ويصغر",76,"ر",1,0],["صَغَا لِلمَعالي مِنهُ عائِلُ صِبْيَةٍ","حَشَايَاهُمُ طَيَّ الحَشا والجَوانِح",77,"ح",1,0],["صغيرٌ أقعدته فوقه","فقال حكك قلت لا فائده",78,"ه",1,1],["صَغيرَةً وَتَكلُ الطَرفَ مِن أُمَمِ","ما كانَ مِن عارِفٍ فينا خَليقَتُهُ",79,"ه",1,0],["صِغَرُ الرَّأسِ وَطولُ العُنُق","خِلقَةٌ مُنكَرَةٌ في الخِلَق",80,"ق",1,1],["صَغيرُهُم وَكَهلَهُم سواء","تَعود كل المَعروفِ طِفلا",81,"ل",2,0],["صَغُرَت نفوسُ أكابرٍ عن كشفِها","فلأجل ذاك رأتني أتكبَّرُ",82,"ر",1,0],["صغيرهم والكبير","والعجز العاجزات",83,"ت",1,0],["صغيرة النار عصف الريح يطفئها","ومعظم النار عصف الريح يذآيه",84,"ه",1,0],["صَغيراً تربّيه المَعاليَ فاضِلاً","فَسُوِّدَ مِن إِقبالِهِ في اِقتِبالِهِ",85,"ل",2,0],["صَغُر الناس في زَمانك وازددت","عَلاءً وَسؤدداً قُدموسا",86,"س",2,0],["صغيرةُ العار كُبرى في مناقبِهِ","وهائلُ الخطب في آرائه جَدَلُ",87,"ل",1,0],["صغرت عندك الهدايا الجلي","لاتُ فملنا إلى اليسير الحقير",88,"ر",1,0],["صَغى القَلبُ مِنهُ إِلى سَفرَةٍ","غَداةَ رَأى وَجهَها