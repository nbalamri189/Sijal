{"poems":[[65,"من الطوالع من نجد تظلهم","https://www.aldiwan.net/poem45743.html","البسيط"],[79,"أرى سيف إبراهيم بيني وبينه","https://www.aldiwan.net/poem36742.html","الطويل"],[9,"أترحل من ليلى ولما تزود","https://www.aldiwan.net/poem21924.html","الطويل"],[88,"يا ليلة ألهمتني ما أتيه به","https://www.aldiwan.net/poem68834.html","البسيط"],[53,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[72,"لئن صدقتني في الحديث ظنوني","https://www.aldiwan.net/poem42435.html","الطويل"],[87,"رضاكم بالعلاقة لي كفيل","https://www.aldiwan.net/poem7893.html","الوافر"],[47,"نصيبي منك لوم العاذلات","https://www.aldiwan.net/poem62649.html","الوافر"],[47,"حرمت رضاك من عدمي وخسري","https://www.aldiwan.net/poem63561.html","الوافر"],[68,"بدت تختال في ذيل النعيم","https://www.aldiwan.net/poem39924.html","الوافر"],[99,"أرى سمائي انحدرت وانطوت","https://www.aldiwan.net/poem24937.html","السريع"],[82,"ملاعب البيض بين البيض والأسل","https://www.aldiwan.net/poem31322.html","البسيط"],[35,"ألا لا أحب السير إلا مصعدا","https://www.aldiwan.net/poem25748.html","الطويل"],[107,"أمنك الذكر يعصف بالقلوب","https://www.aldiwan.net/poem42121.html","الوافر"],[107,"أعلل نفسي والأماني طماعة","https://www.aldiwan.net/poem43427.html","الطويل"],[52,"ألا يا اسقياني بالرحيق فنيت","https://www.aldiwan.net/poem64738.html","الطويل"],[48,"وجدت الأنام على خطة","https://www.aldiwan.net/poem22749.html","المتقارب"],[48,"إذا ما جاءني رجل حذام","https://www.aldiwan.net/poem23408.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85309","المجتث"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85422","الرجز"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125533","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42549","الطويل"],[147,"أرى سفها ولو جاء العذول","https://www.aldiwan.net/poem11804.html","الوافر"],[202,"مصابك ما كر الجديدان سرمد","https://www.aldiwan.net/poem51953.html","الطويل"],[214,"سلوا فاتر الأجفان عن كبدي الحرا","https://www.aldiwan.net/poem13338.html","الطويل"],[257,"فلا وصلها يبدو فتبلى بلا بلى","https://www.aldiwan.net/poem1427.html",""],[303,"لياليك يا بغداد في الحسن كالفجر","https://www.aldiwan.net/poem36830.html","عموديه"],[310,"أمولاي والآمال تستعبد الحرا","https://www.aldiwan.net/poem56546.html","الكامل"],[398,"أرى سنتي قد ضمنت بعجائب","https://www.aldiwan.net/poem53621.html","الطويل"],[422,"وميض البرق هيج منك وجدا","https://www.aldiwan.net/poem54190.html","الوافر"],[469,"أرى سيرها عنقاً أو خيدا","https://www.aldiwan.net/poem3276.html","عموديه"],[471,"وحنت قلوصي بعد هدء صبابة","https://www.aldiwan.net/poem50378.html","الطويل"],[505,"أرى سيرة الوراث وراث أحمد","https://www.aldiwan.net/poem38075.html","الطويل"],[510,"البديل","https://www.aldiwan.net/poem56766.html","مخلع البسيط"],[520,"عسى منجد الأظعان يوماً يغيرها","https://www.aldiwan.net/poem12160.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48761","الطويل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56603","الوافر"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121181","الطويل"],[2528,"","https://poetry.dctabudhabi.ae/diwan/poem/199539","الوافر"],[2530,"","https://poetry.dctabudhabi.ae/diwan/poem/96599","الوافر"],[2656,"","https://poetry.dctabudhabi.ae/diwan/poem/124601","البسيط"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93348","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58382","المجتث"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200740","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200483","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200204","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65113","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100808","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100853","البسيط"],[3260,"","https://poetry.dctabudhabi.ae/diwan/poem/204132","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216833","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101370","الطويل"],[4279,"","https://poetry.dctabudhabi.ae/diwan/poem/101972","الطويل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117213","الطويل"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121276","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58020","الطويل"],[5005,"حُلمٌ في الضّجيج..","https://www.poetsgate.com/ViewPoem.aspx?id=190155",""],[5644,"لمن تكتبين؟","https://www.poetsgate.com/ViewPoem.aspx?id=204499",""],[5701,"لقد كان هذا الشرق غاب ضراغم","https://www.poetsgate.com/ViewPoem.aspx?id=164599",""],[422,"وميضُ البرق هيَّج منك وجدا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22245&r=&rc=1",""],[6336,"عشاق في الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73561&r=&rc=22",""]],"verses":[["أَرى سُيوفَهُمُ بيضاً كأَوجُهِهِمْ","فَما لأَعيُنِهِمْ مُحمَرَّةً غَضَبا",0,"ب",2,0],["أَرَى سَيْفَ إِبْرَاهِيمَ بَيْنِي وَبَيْنَهُ","مُنَاسَبَةٌ عِنْدَ اعْتَبِارِ الْمُنَاسِبِ",1,"ب",1,1],["أَرى سَفَهاً بِالمَرءِ تَعليقَ لُبَّهِ","بِغانِيَةٍ خَودٍ مَتى تَدنُ تَبعُدِ",2,"د",1,0],["أَرى سُمُوُّ خِديوينا وَقَد بُسِطَت","بِالعَدلِ وَالبَذلِ يُمناهُ وَيُسراهُ",3,"ا",2,0],["أرى سقم الدنيا بصحة حظكم","شفى داءها ضرّارُها ونفوعها",4,"ع",3,0],["أَرى سُقمَ جِسمي قَد حَوَتهُ جُفونُكُم","فَلا تَأخُذوا يا ظالِمينَ جُفوني",5,"ن",2,0],["أرى سبل الرجاء إليه شتى","ولكن خيرها هذا السبيل",6,"ل",1,0],["أَرى سَيري إِلى أَقصى سَبيلي","لِفَرطِ الجِدِّ يَمنَعُني اِلتِفاتي",7,"ت",2,0],["أَرى سَبَبي سَيَقوى بَعدَ ضَعفٍ","إِذا أَنا بِالوَزيرِ شَدَدتُ أَزري",8,"ر",2,0],["أَرى سَقَمَ الجُفونِ بَرى فُؤادي","وَعَلَّمَني مُكابَدَةَ الهُمومِ",9,"م",1,0],["أرى سمائي انحدرت وانطوت","لا تحسبي النجم هوى وحده",10,"ه",1,1],["أرى سِهامَ لحاظٍ منكِ تَرْشُقُني","أفي جُفونكِ رامٍ من بني ثُعَلِ",11,"ل",1,0],["أَرى سَقَماً في الجِسمِ أَصبَحَ ثاوِياً","وَحُزناً طَويلاً رائِحاً ثُمَّ غادِيا",12,"ي",2,0],["أرى سَلَباً يَطيحُ على أكُفٍّ","تُراشُ سِهامُها بيد السّليبِ",13,"ب",1,0],["أَرى سَوءَةً شَنعاءَ لَستُ إِخالها","بِغَيرِ الدَمِ المُهراقِ عَن مَصرَ تُغسَلُ",14,"ل",1,0],["أَرى سَقَمي يَزدادُ مِن أُمِّ مالِكٍ","وَلو ذُقتُ يَوماً ريقَها لَبَريتُ",15,"ت",1,0],["أَرى سِنَةً وَهُوَ في حيلَةٍ","وَلَم يُغفِ حَقّاً وَلَكِن مَكَر",16,"ر",1,0],["أَرى سَيفَ بنِ ذي يَزَنٍ فَرَتهُ","صُروفُ الدَهرِ بِالسَيفِ الهُذامِ",17,"م",1,0],["أَرى سماء وَلكن","لا أَستَطيع علوّا",18,"و",2,0],["أَرى سيوفاً أَرهفت","من البروق اللُّمَّع",19,"ع",1,0],["أرى سحر الشباب عليك غضاً","وقاك الله أنفاس الأصيل",20,"ل",1,0],["أَرَى سِتْرَ خَطْبٍ قَدْ تَرَفَّعَ وانْبَرَتْ","تَلُوحُ لَهُمْ مِنْهُ وُجُوهُ الْحَوادِثِ",21,"ث",1,0],["أَرى سَفَهاً وَلَو جاءَ العَذولُ","بِحَقٍّ أَن أَقولَ كَما يَقولُ",22,"ل",1,1],["أرى ساعدي الأقوى يُجذُّ وصارمي","يُثَلُّ وعَسّالي الأصمُّ يُقْصَّدُ",23,"د",1,0],["ارى سهري قد طال في ليل فرعه","ومن فرقه ما زلت ارتقب الفجرا",24,"ر",2,0],["أَرى سودَها أَمضى وأفتك في الحَشا","فَما بالُ أَنقاها بَياضاً ثَمينُها",25,"ن",3,0],["أَرى سهري فيها أَلذَّ من الكرى","بعيني طليحٍ من سهادٍ وَمن سكر",26,"ر",1,0],["أَرى سيمياءِ المجدِ تُشرقُ حوله","فَأزوي اِحتشاما حينَ يبسط لي البشرى",27,"ر",2,0],["أَرى سنتي قَد ضُمِّنَت بِعَجائِبِ","وَرَبِّيَ يَكفيني جَميعَ النَوائِبِ",28,"ب",1,1],["أرى سيفي فأذكر منك لحظاً","وخطَّاري فأذكر منك قدَّا",29,"د",2,0],["أرى سيرها عنقاً أو خيدا","لعلك يا سعد تنوي زرودا",30,"د",2,1],["أَرى سَبعَةً يَسعَونَ لِلوَصلِ كُلُّهُم","لَهُ عِندَ لَيلى دَينَةٌ يَستَدينُها",31,"ن",3,0],["أَرى سيرَةَ الوُرَّاثِ وُرَّاثِ أَحمدٍ","نبيِّ الهُدى سرِّ الوُجودِ المُقرَّبِ",32,"ب",1,1],["أرىْ سلاماً على الجِبالِ","في ظلِّهِ سهلُها الرّحيبُ",33,"ب",1,0],["أرى سير الأملاك تفنى وإنما","يكون بمثلي بعثها ونشورها",34,"ر",3,0],["أرى سبب استقلالكم جمع شملكم","إلى ملك فيكم أبر وأرحما",35,"م",2,0],["أرى سيواس تغمدني","كأني صارم ذكر",36,"ر",1,0],["أرى سرب آرام من الخود جفل","يسارعن رعبا والرماة بمعزل",37,"ل",1,1],["أرى سبب الرضى عنه قوياً","على الله الزيادة والتمام",38,"م",1,0],["أرى سلمى تصد وما صددنا","وغيرَ صُدودها كنّا أردنا",39,"ن",2,1],["أرى سهام المنايا لم تدع أحدا","ولا تغادر أهل الملك والسوقا",40,"ق",2,0],["أَرى سَكراتٍ لِلسراجِ كَأَنَّهُ","عَليلُ هَوىً فَوقَ الفِراشِ يَجُودُ",41,"د",1,1],["أرى سكوتَكَ عَنِّي","مَنْعاً وأينَ الثوابُ",42,"ب",1,1],["أرى ساعة العمر فوق المنى","وأثمن للمرء من وفره",43,"ه",1,1],["أرى سوق مثلي أصبح اليوم كاسداً","ومالي ذنبٌ غير بيع الجواهر",44,"ر",1,1],["أرى سينماء ناطقاً مثل صامت","فما أفهم القول الذي فيه ينبسُ",45,"س",1,1],["أرى سفينة صبري لا فلاح لها","في بحر حُبّك أو تُفضي إلى الفلح",46,"ح",1,0],["أرى سماء اضاءت في جوانبها","زهر الدجى بين تصويب واصماد",47,"د",1,1],["ارى سوادا ارى وجها به سحم","قد شابه الزفت والقطران والطينا",48,"ن",2,0],["أرى سطراً من المسك الذكيّ","على جمرٍ بوجنته ذكيّ",49,"ي",1,1],["أرى سطعة الحسن في عالم","وجوهرة الحسن في آخر",50,"ر",1,0],["أرى سرفذون أحب العباد","إلي بعامل فطرقل باد",51,"د",1,0],["أريس براحة فطرقل قد","رماه وحرقنا بالكمد",51,"د",1,0],["أرى ساحل الاصباح يبيض رمله","فيضربه موج الظلام ويسود",52,"د",1,0],["أرى ساعة أرتاح فيها لذكركم","أجل زمان في أغانيه أطرب",53,"ب",1,0],["أرى ساقى الأنواء قد أسكر القضبا","وروض سماء الزهر قد أطلع الشهبا",54,"ب",2,1],["أرى سحُباً في الجوّ تمطِرُ لؤلُؤاً","على الروضِ لكنّا علَيَّ كحاصبِ",55,"ب",1,0],["أرى سلم العلياء صعباً مرامهُ","يجاوز راقيه السما والفراقدا",56,"د",2,0],["أرى سبلَ الشقاء بكل دربٍ","ولم أرَ للتَّفاؤلِ من سبيلِ",57,"ل",1,0],["أرى سطر حرفك ذاب التياعا","فبالله قولي لمن تكتبين؟",58,"ن",1,0],["أرى سفراء الغرب في الشرق روحه","وحكامه ليست به غير أجسام",59,"م",1,0],["أرى سيقي فأذكر منك لحظاً","وخطَّاري فأذكر منك قدا",60,"د",2,0],["أرى سرَّنا نمَّتْ عليه عيوننا","وثار الهوى في صمتنا وتكلَّما",61,"م",2,0]]}