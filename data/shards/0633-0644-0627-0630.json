{"poems":[[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42709","الخفيف"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88636","الطويل"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127388","الرمل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74313","الخفيف"]],"verses":[["سَلْ إِذَا شِئْتَ أَنْجُمَ اللَّيْلِ عَنِّي","فَهْيَ أَدْرَى بِكُلِّ مَا بِتُّ أَلْقَى",0,"ق",2,0],["سلا ذلك الدر النقي فطالَما","تعود بسط الجود من جود يمناه",1,"ا",2,0],["سل إذا شئت دراوي","ش الطريقة",2,"ه",1,0],["سَل إِذا ما استطَعت جبريل عَمَن","خاطب الرَب فَوقَ عَرش وَكُرسي",3,"س",2,0]]}