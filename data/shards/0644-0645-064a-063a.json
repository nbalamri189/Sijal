{"poems":[[53,"غالى بها الزائد حتى ابتاعها","https://www.aldiwan.net/poem30152.html","الرجز"],[53,"لن تشقوا لذا الجواد غبارا","https://www.aldiwan.net/poem30482.html","الخفيف"],[53,"أترى السحاب إذا سرت عشراؤه","https://www.aldiwan.net/poem30778.html","الكامل"],[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[86,"لله آثار هناك كريمة","https://www.aldiwan.net/poem10679.html","الكامل"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[86,"ملكت علي مذاهبي","https://www.aldiwan.net/poem68864.html","مجزوء الكامل"],[71,"لا يخدعنك صحة ويسار","https://www.aldiwan.net/poem4009.html","الكامل"],[73,"أيها الظافر أبشر بالظفر","https://www.aldiwan.net/poem11957.html","الرمل"],[89,"مات سعد فما عسى أن تقولا","https://www.aldiwan.net/poem44613.html","الخفيف"],[89,"الشعر ديوان العرب","https://www.aldiwan.net/poem44780.html","مجزوء الرجز"],[85,"الله أكبر كم في الفتح من عجب","https://www.aldiwan.net/poem63785.html","البسيط"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[45,"أن دعاه داعي الصبا فأجابه","https://www.aldiwan.net/poem10667.html","الخفيف"],[45,"كفي الملامة أو دومي على العذل","https://www.aldiwan.net/poem65639.html","البسيط"],[45,"أمحلتي سلمى بكاظمة اسلما","https://www.aldiwan.net/poem65659.html","الكامل"],[45,"رحلت وأودعت الفؤاد لواحظا","https://www.aldiwan.net/poem66839.html","الكامل"],[61,"أنى يعود من الصبابة مفرقا","https://www.aldiwan.net/poem51535.html","الكامل"],[66,"سلي الرماح العوالي عن معالينا","https://www.aldiwan.net/poem41584.html","البسيط"],[80,"ما أغمد العضب حتى جرد الذكر","https://www.aldiwan.net/poem31441.html","البسيط"],[44,"قل للأمير لقد قلدتني نعما","https://www.aldiwan.net/poem30562.html","البسيط"],[44,"السيف أصدق أنباء من الكتب","https://www.aldiwan.net/poem30591.html","البسيط"],[105,"حيوا بمصر حماتها الأحرارا","https://www.aldiwan.net/poem42107.html","الكامل"],[50,"يا طلل الحي بذات الصمد","https://www.aldiwan.net/poem63943.html","الرجز"],[46,"فرق بدا ومن الحوادث يفرق","https://www.aldiwan.net/poem23023.html","الكامل"],[46,"لم يكفها نور خديها ونور نقا","https://www.aldiwan.net/poem23346.html","البسيط"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[76,"قول كأن فريده","https://www.aldiwan.net/poem39502.html","مجزوء الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85478","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39676","البسيط"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20248","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54772","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54770","الرجز"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67326","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43667","المجتث"],[6,"معلقة الحارث بن حلزة اليشكري","https://www.poetsgate.com/ViewPoem.aspx?id=11409",""],[45,"إنْ دَعَاهُ داعي الصبَى، فأجابَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31576",""],[44,"السَّيْفُ أَصْدَقُ إِنْبَاءً مِنَ الكُتُبِ","https://www.poetsgate.com/ViewPoem.aspx?id=64458",""],[66,"سَلي الرّماحَ العَوالي عن معالينا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19697&r=&rc=2",""],[107,"هل وقفة بين الطلول","https://www.aldiwan.net/poem16305.html","مجزوء الكامل"],[131,"فتح يطاول فتحه الأحقابا","https://www.aldiwan.net/poem4248.html","الكامل"],[141,"يطمع الناس في البقاء وتابى","https://www.aldiwan.net/poem11735.html","الخفيف"],[283,"أمحمد بن الشيخ يا فخر القضا","https://www.aldiwan.net/poem39394.html","الكامل"],[336,"قد قلت لما قال لي قائل","https://www.aldiwan.net/poem68746.html","السريع"],[347,"عند ولي الخير شر العباد","https://www.aldiwan.net/poem15626.html","السريع"],[347,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[362,"يا مودع السر درا عند أجفاني","https://www.aldiwan.net/poem60635.html","البسيط"],[369,"بركات مولانا عليك تعود","https://www.aldiwan.net/poem57476.html","الكامل"],[377,"لي شوق إليك لا يتناها","https://www.aldiwan.net/poem48763.html","الخفيف"],[377,"طرف جفاه هجوعه","https://www.aldiwan.net/poem48798.html","مجزوء الكامل"],[377,"أصبح الجسم بالجروح موشى","https://www.aldiwan.net/poem49224.html","الخفيف"],[456,"ما للدسوت وللسروج تسائل","https://www.aldiwan.net/poem56069.html","الكامل"],[477,"ما للقريض تعاصى","https://www.aldiwan.net/poem36906.html","المجتث"],[491,"واليوم من غسق العجاجة ليلة","https://www.aldiwan.net/poem67393.html","الكامل"],[512,"كتم الهوى فوشى النحول بسره","https://www.aldiwan.net/poem20801.html","الكامل"],[513,"إن حارت الأفكار كيف تقول","https://www.aldiwan.net/poem12199.html","الكامل"],[549,"ما الحب إلا موئل المتعلل","https://www.aldiwan.net/poem47295.html","الكامل"],[549,"ما لي تطيح الدهر أخياري","https://www.aldiwan.net/poem47788.html","البسيط"],[549,"في مثلها يستثار الصبر والجلد","https://www.aldiwan.net/poem47882.html","البسيط"],[549,"لا تقربن عضيهة","https://www.aldiwan.net/poem48037.html","مجزوء الكامل"],[551,"لم أصح من لذة لا لا ولا طرب","https://www.aldiwan.net/poem68405.html","البسيط"],[551,"قد اطلعت على سري وإعلاني","https://www.aldiwan.net/poem68419.html","البسيط"],[577,"أي شيء يمنح الأوطان قدرا","https://www.aldiwan.net/poem56777.html","الرمل"],[584,"في الراح سر بالسرور يحصص","https://www.aldiwan.net/poem17571.html","الكامل"]],"verses":[["لَم يَغنَموا الأَموالَ إِلّا أَخَذوا","صَفيِّها وَقَبَضوا مِرباعَها",0,"ع",3,0],["لَم يُغالِط عَنها اللَحاظُ وَلا أَص","فَحُ عَنها فِعلَ اللَئيمِ اِزوِرارا",1,"ر",2,0],["لَم يُغنِهِ مَن كانَ وَدَّ لَوَ اَنَّهُ","قَبلَ المَنونِ مِنَ المَنونِ فِداؤُهُ",2,"ا",3,0],["لَم يَغُرّوكُم غُروراً وَلَكن","يَرفَعُ الآلُ جَمعَهُم وَالضَحاءُ",3,"ا",2,0],["لَم يُغنِ عَنها مَعبَدٌ خَرَّبتَهُ","ظُلماً وَلَم يُمسِك عِنانَكَ دينُ",4,"ن",1,0],["لم يُغنِ عنه وقد حاسَبْتَه حَسَبٌ","ولا مُعاويةٌ بالشامِ يَجبيها",5,"ي",3,0],["لَم يَغشَها وَغدٌ وَلَم","يَنزِل بِساحَتِها لَئيمُ",6,"م",1,0],["لَم يُغذَ مِن لَبَنِ الإِماءِ وَلَم تُحِل","أَخلاقَهُ عَن طَبعِها الأَظآرُ",7,"ر",1,0],["لَم يُغادِر لي سَقامي جَلَداً","مَعَ أَنّي لَم أَزَل ثَبتَ المِرَر",8,"ر",1,0],["لم يغير من وجهك الموت شيئا","إنما أنت ذلك البسام",9,"م",1,0],["لم يغن عنه ماله","في هلكه وما كسب",10,"ب",1,0],["لَم يُغنِ عَن قادَةِ اليونانَ ما حَشَدوا","مِنَ السِلاحِ وَما ساقوا مِنَ العُصَبِ",11,"ب",1,0],["لَم يُغَيِّرهُ يَومَ ميلادِهِ بُؤ","سٌ وَلا نالَهُ وَليداً شَقاءُ",12,"ا",2,0],["لَم يُغادِ الظَما وَلَم يَدرِ كَيفَ الرِي","يُ مَن لَم يُمطَر بِتِلكَ السَحابَه",13,"ب",2,0],["لَم يَغزُ ساحَتَهُ راجٍ سَماحَتَهُ","يَوماً فَيَرجِعُ إِلّا غانِمِ القَفَلِ",14,"ل",1,0],["لَم يَغبَ عَن شَيءٍ فَيَظلِمُهُ وَلَم","يَأبَ الَّذي حَدَّ الكِتابُ فَيَظلِما",15,"م",2,0],["لَم يَغنَ في تِلكَ المَغاني بَعدَهُم","بَل ماغَناءُ مَعاهِدٍ وَمَغانِ",16,"ن",1,0],["لم يَغْنَ من تلكَ المَحاسنِ مَنْزِلٌ","إلا تَقاضاه الفِراقُ فأملَقا",17,"ق",2,0],["لَم يُغنِهِم مالُنا عَن نَهبِ أَنفُسِنا","كَأَنَّهُم في أَمانٍ مِن تَقاضينا",18,"ن",2,0],["لَم يُغْنِيَا عَنهُ لا عِزٌّ يُدِلُّ بِهِ","مَن كانَ بِالكِبرِ في عِرنِينِهِ أَشَرُ",19,"ر",1,0],["لَم يُغلِقِ اللَهُ بابَ العُرفِ عَن أَحَدٍ","بابُ الأَميرِ لَهُ المَألوفُ مَفتوحُ",20,"ح",1,0],["لَم يَغزُ قَوماً وَلَم يَنهَض إِلى بَلَدٍ","إِلّا تَقَدَّمَهُ جَيشٌ مِنَ الرَعَبِ",21,"ب",1,0],["لم يُغنِه الأسطولُ يَغمرُه دماً","والجيشُ يُطعِمهُ الممالكَ نارا",22,"ر",2,0],["لَم يُغذَ بِالفَيضِ وَلا بِالعِدِّ","إِلّا بِماءِ المُعصِراتِ الهُدِّ",23,"د",1,0],["لَم يَغّدُ غَدوَةَ طائِرٍ مُتَكَسِّبٍ","وافاهُ يَلقُطُ أَجدَلٌ أَو زُرَّقُ",24,"ق",1,0],["لَم يَغنَمِ القَيلُ عُدَّت في الإِماءِ لَهُ","بَل مُظهِرُ الزُهدِ في أَمثالِها غَنِما",25,"م",2,0],["لم يَغْزُ فيها وغَزَتْ قُوَّادُهُ","واعتَوَرت بِبُشترا أجنادُهُ",26,"ه",1,0],["لم يَغْزُ فيها وانتحَى بِبُشترا","فَرمَّها بما رأى ودبّرا",26,"ر",2,0],["لَم يَغْلُ في شنعِ اللُّغا","تِ وَلا تَوَحَّشَ بالغريبْ",27,"ب",1,0],["لَم يغضب الشعب من خسفٍ يسام به","كأَنَّما الشعب قوم لَيسَ من مضر",28,"ر",1,0],["لم يغمضِ النوم عينيها ولا خمدت","نيران قلب لها في فحمَةِ العلس",29,"س",1,0],["لَم يُغنِ عَنّي بَينَ مَش","رِقِها وَمَغرِبِها اِضطِراب",30,"ب",1,0],["لم يغن داعي الحقّ والفلاح","عنها وأغنتْ صلّة السلاح",31,"ح",1,0],["لم يغن عنه من النباء نباهه","ملأ أتاك عِتيُّه وسَباهه",32,"ه",1,0],["لمْ يَغْلُ مَنْ قالَ فِيكُمْ إِنَّكُمْ أُسُدٌ","تِلْكَ الْفَعَائِلُ لِمْ يَسْبِقْ بِهَا أَحَدُ",33,"د",1,0],["لَمْ يُغْنِكُمْ مِنْهُ الْبِنَاءُ عَالِياً","وَالأَرْضُ نَهْباً وَالمُلُوكُ أَعْبُدَا",34,"د",2,0],["لم يَغْذُهَا قدٌّ ولا نَصِيفُ","لكِنْ غَذَاهَا الحَنظَلُ النّقِيفُ",35,"ف",1,1],["لَم يُغنِ عَنّي اِجتِهادي","لَهُ فَكَيفَ اِجتَهَدتُه",36,"ت",2,0],["لم يغروكم غروراً ولكن","رفع الآل شخصهم والضحاء",37,"ا",2,0],["لمْ يُغادِ الظّما وَلم يَدرِ كَيفَ ال","ريُّ مَنْ لم يُمْطَرْ بتلكَ السّحابَهْ",38,"ب",2,0],["لَمْ يَغْزُ قَوْماً، ولَمْ يَنْهَدْ إلَى بَلَدٍ","إلاَّ تقدَّمهُ جيشٌ من الرَّعبِ",39,"ب",1,0],["لم يغنِهِمْ مالُنا عن نَهبش أنفُسِنا،","كأنّهمْ في أمانٍ من تقاضينا",40,"ن",2,0],["لَم يَغنِ درع شَهامَتي","مِن طَرف فَتّان كَحيل",41,"ل",1,0],["لَم يُغن عَنهُم إذ أتاهُم مِن عَلٍ","أن يَحرسُوا الأسوارَ والأبوابا",42,"ب",2,0],["لَم يُغالِب قَضاءَ ذي العَرشِ إِذ وا","فى وَمازالَ لِلعِدى غَلّابا",43,"ب",2,0],["لم يغنه مال ولا ولد ولا","جاه ولم يقبل له توكيل",44,"ل",1,0],["لَم يُغنِهِ إِذ حُمَّ مِقدارُهُ","وَلَم يُساوِ العُشرَ مِن فلسِهِ",45,"س",2,0],["لَم يُغنِ عَنهُ بِالغِنى مالُهُ","وَلا إِلى الجاهِ التَجاهُ أَفاد",46,"د",1,0],["لَم يَغوَ فيما قَد رَوى فُؤادُهُ","وَما رَآهُ عَنهُ ما زاغَ البَصَر",47,"ر",1,0],["لم يُغْرِ بي غَيْرُ شانٍ في وِشايته","والنّاس بالبُعْدِ لا يَدْرونَ ما شاني",48,"ن",2,0],["لم يغمِدوا فشلاً سيوفاً في الوغى","إلا وأشهرَ سيفَك التجريدُ",49,"د",1,0],["لَم يُغادر مِن مُهجَتي الشَوق مُذ بَن","ت وَشَطَ المزار إِلّا زَهاها",50,"ا",3,0],["لَم يَغنِ عَنهُ إِذ هَجَر","ت بُكاؤُهُ وَخُضوعَهُ",51,"ع",2,0],["لَم يُغادر مني التَباعُد إِلّا","عَبرةً عَبرةً لِمَن كانَ يَخشى",52,"ش",2,0],["لم يُغنك الكرمُ العتيدُ ولا حَمَى","عنك السماحُ ولا كفاك النائلُ",53,"ل",1,0],["لم يغد منه طليقا","إلا لكونه حرا",54,"ر",2,0],["لَم يَغُنِ غَيرُ أَبي شُجاعٍ وَالعُلا","عَنهُ تُناجي النَصرَ وَالتَأييدا",55,"د",2,0],["لم يغشَ وجهَ الأفْقِ حتّى ينطوي","كلَفُ الدُجى لو حاز رونَق بِشرِهِ",56,"ر",2,0],["لم يغنه نقص المحاق وإنما","أفناه من حذر الفراق نحول",57,"ل",1,0],["لم يغنِ إنْ دبوا بعذرٍ بعدها","ركبوا بذنبهمُ قوادمَ أجدَلِ",58,"ل",1,0],["لم يُغنِ عنه وقد همّ الحمامُ به","أن بات من دون أردامٍ وأستارِ",59,"ر",1,0],["لم يُغنِ عنهمْ وقد همّ الحِمامُ بهمْ","ما جَمّعوا لدفاعِ البُؤْسِ وَاِحتَشدوا",60,"د",3,0],["لم يُغنِ عنهمْ حين هم","مَ بهمْ حِمامُهُمُ الحُماةُ",61,"ه",1,0],["لَم يَغذُها بِمَصيَفِ القَيظِ بائِعُها","وَلا غَذاها بِحَرِّ الشَمسِ وَاللَهَبِ",62,"ب",1,0],["لَم يُغمِدِ السَيفَ مُذ نيطَت حَمائِلُهُ","يَوماً وَلا سَلَّهُ إِلّا عَلى جانِ",63,"ن",1,0],["لم يغيِّر حبها فينا خؤونٌ","عاثَ في بُستانها سِرَّاً وجهرا",64,"ر",2,0],["لم يُغْلِهَا ثَمَنٌ لَدَى خُطَّابِها","إِذْ كُلُّ غالٍ في اللَّذاذةِ يَرْخُصُ",65,"ص",1,0]]}