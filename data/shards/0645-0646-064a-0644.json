{"poems":[[57,"ولقد قلت والهموم ركود","https://www.aldiwan.net/poem26421.html","الخفيف"],[9,"من ديار بالهضب هضب القليب","https://www.aldiwan.net/poem21913.html","الخفيف"],[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[75,"ألم يأن أن يبكي الغمام على مثلي","https://www.aldiwan.net/poem11932.html","الطويل"],[95,"في أي جو بالأسى مفعم","https://www.aldiwan.net/poem11348.html","السريع"],[39,"هل للشباب الذي قد فات من طلب","https://www.aldiwan.net/poem6852.html","البسيط"],[53,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[87,"قم ناد أنقرة وقل يهنيك","https://www.aldiwan.net/poem63757.html","الكامل"],[64,"إذا لم يعن قول النصيح قبول","https://www.aldiwan.net/poem52321.html","الطويل"],[47,"تفتأ عجبا بالشيء تدكره","https://www.aldiwan.net/poem63626.html","المنسرح"],[47,"أعلت بني وهب على العالم","https://www.aldiwan.net/poem65688.html","السريع"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[76,"يا بانة تهتز فينانة","https://www.aldiwan.net/poem12918.html","السريع"],[48,"إن يقرب الموت مني","https://www.aldiwan.net/poem22148.html","المجتث"],[70,"قلبي يحدثني بأنك متلفي","https://www.aldiwan.net/poem1510.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202535","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54710","الكامل"],[121,"مسقط","https://www.aldiwan.net/poem24041.html","الخفيف"],[139,"مني لسيد الزجاله","https://www.aldiwan.net/poem48846.html","عموديه"],[147,"سل عن فضائلك الزمان لتخبرا","https://www.aldiwan.net/poem11760.html","الكامل"],[164,"ردي جفونك عن حشاي قليلا","https://www.aldiwan.net/poem58771.html","الكامل"],[164,"هذا التأني وهذا الحلم قد فعلا","https://www.aldiwan.net/poem58892.html","البسيط"],[164,"ملك سما ذو كمال زانه كرم","https://www.aldiwan.net/poem59106.html","البسيط"],[173,"العز ما خضعت لهيبته العدى","https://www.aldiwan.net/poem1618.html",""],[173,"قم فاسقنيها قبل صوت الحمام","https://www.aldiwan.net/poem1679.html",""],[240,"أتظنني ما عشت أنعم بالا","https://www.aldiwan.net/poem31787.html","الكامل"],[287,"من علا الصاحب الطويل الركاب","https://www.aldiwan.net/poem32864.html","الخفيف"],[327,"بان الخليط فشطوا بالرعابيب","https://www.aldiwan.net/poem56349.html","البسيط"],[415,"كناس سرب المها عريسة الأسد","https://www.aldiwan.net/poem32224.html","البسيط"],[460,"من لعين كثيرة الهملان","https://www.aldiwan.net/poem26633.html","الخفيف"],[463,"أين ظباء المنحنى","https://www.aldiwan.net/poem55827.html","مجزوء الرجز"],[463,"حب إليها بالغضا مرتبعا","https://www.aldiwan.net/poem56125.html","السريع"],[473,"ما أحرج الباب بل ما أرحب الوادي","https://www.aldiwan.net/poem59455.html","البسيط"],[473,"إني لمن أهل بيت","https://www.aldiwan.net/poem60109.html","البسيط"],[487,"يا راميا قلبا جريح","https://www.aldiwan.net/poem24200.html","عموديه"],[487,"لي في الغرام صبابة قد أسكرت","https://www.aldiwan.net/poem24326.html","عموديه"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86626","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48705","السريع"],[839,"","https://poetry.dctabudhabi.ae/diwan/poem/205092","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38119","الخفيف"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96708","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56176","الرمل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122059","المتقارب"],[1491,"","https://poetry.dctabudhabi.ae/diwan/poem/107311","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80029","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49551","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69424","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69421","الكامل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102156","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109455","الرجز"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77307","البسيط"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106837","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93602","الوافر"],[3318,"","https://poetry.dctabudhabi.ae/diwan/poem/138743",""],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62910","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109898","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92044","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133283","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111430","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123523","السلسلة"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90842","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28667","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133185","الرمل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120293","المقتضب"],[4791,"الجمره","https://www.poetsgate.com/ViewPoem.aspx?id=37106",""],[4916,"انكساري","https://www.poetsgate.com/ViewPoem.aspx?id=177311",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5186,"\"أيهذا \"\"الدبور\"\" أين الحمار","https://www.poetsgate.com/ViewPoem.aspx?id=156553",""],[5277,"وخزةُ الورد","https://www.poetsgate.com/ViewPoem.aspx?id=192208",""],[5536,"الحب والهندسه","https://www.poetsgate.com/ViewPoem.aspx?id=22591",""],[5573,"ياعناد","https://www.poetsgate.com/ViewPoem.aspx?id=200344",""],[5582,"عُوجُوا فَحَيُّوا مَغانِي رَبَّةِ الخالِ","https://www.poetsgate.com/ViewPoem.aspx?id=63561",""],[5595,"وسَكرتُ فيك","https://www.poetsgate.com/ViewPoem.aspx?id=150151",""],[5739,"قلبي وكر ...!","https://www.poetsgate.com/ViewPoem.aspx?id=155476",""],[5784,"سفر المجاز","https://www.poetsgate.com/ViewPoem.aspx?id=215226",""],[5873,"إهداء عشية سجال","https://www.poetsgate.com/ViewPoem.aspx?id=215782",""],[6123,"إن بني ضرجوني بالدم","https://www.poetsgate.com/ViewPoem.aspx?id=84635",""],[6320,"أَقْتَاتُ حُزْنِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83620&r=&rc=1",""]],"verses":[["مَن يَلُمني عَلى النِساءِ أَلُمهُ","أَنا وَاللَهِ لِلنِساءِ وَدودُ",0,"د",1,0],["مَن يَلُمني عَلى بَني اِبنَةِ حَسّا","نَ أَلُمهُ وَأَعصِهِ في الخُطوبِ",1,"ب",1,0],["مَن يَلقَ هَوذَةَ يَسجُد غَيرَ مُتَّئبٍ","إِذا تَعَصَّبَ فَوقَ التاجِ أَو وَضَعا",2,"ع",2,0],["مُنىً لَو تَسَنّى عَقدُها بِيَدِ الرِضا","تَيَسَّرَ مِنها كُلُّ مُستَصعَبِ الحَلِّ",3,"ل",1,0],["مَنْ يَلْتَمِسْ وَصْفاً لَهُ صَادِقاً","فَالْقَوْلُ قَوْلُ الشَّاعِرِ المُلْهَمِ",4,"م",1,0],["من يلبس الشيب يذكر من شبيبته","ما لن يعود ومن أثوابه القُشُبِ",5,"ب",1,0],["من يُلَقَّبْ فإن أسماءك الأس","ماءُ يشغلنَ موضعَ التلقيبِ",6,"ب",1,0],["مِنّي لِعَهدِكِ يا فُروقُ تَحِيَّةٌ","كَعُيونِ مائِكِ أَو رُبى واديكِ",7,"ك",1,0],["منيلٌ إِذا ما كان منِّيَ خدمةٌ","وإن سبقتْ لي عثرةٌ فمُقِيلُ",8,"ل",1,0],["مَنّى لَهُ اللَهُ حَظَّنا مَعَهُ","وَيُغرِقُ البَحرُ وافِياً غَزِرُه",9,"ر",2,0],["مَن يَلهَ عَن نَصري فَلَم يَمتَعِض","لِسوءِ ما يَأتي بِهِ ظالِمي",10,"م",2,0],["مَن يَلزَمِ الصَّبرَ يَستَحسِن عَواقِبَهُ","وَالماءُ يَحسُنُ وَقعاً عِندَ كُلِّ ظَمِ",11,"م",1,0],["مَن يَلقَ مِن لاعِجِ وَجدٍ بِهِ","ريحاً فَقَد لاقَيتُ إِعصارا",12,"ر",2,0],["مَن يَلقَهُ لا يُراقَب","خَطباً وَلا يَخشَ كُربَه",13,"ب",2,0],["مني لَهُ ذُلّ الخَضُوعِ ومنهُ لي","عِزّ المَنوعِ وقوّة المستضْعِف",14,"ف",1,0],["من يلقه في طمره يلاق","ركن الحقوق حائط الأخلاق",15,"ق",1,0],["مَنْ يَلُمْ نَيْرُونَ إِني لائِمُ","أُمَّةً لوْ كَهَرَتْهُ ارْتَدَّ كهْرَا",16,"ر",2,0],["مَنْ يَلْتَمِسْ رَوْحاً وَعَافِيَةً","فَهُنَاكَ تُنْقَعُ غُلَّةُ الصَّادِي",17,"د",2,0],["مَنْ يَلُمْني إذا تَغَزَّلْتُ فيها","وافتخاري بأنَّني صنعانِي",18,"ن",2,0],["منِّي لسيدْ الزجاله","ألفينْ سلامْ فوقْهم بوسهْ",19,"ه",1,1],["مَنٌّ يَلوحُ عَلى الجِباهِ مُسَطَّرا","وَهَوىً يَظَلُّ عَلى القُلوبِ مُسَيطِرا",20,"ر",2,0],["من يلق منهم يلق بحراً زاخراً","يوم الفخارِ وصارَ ما مصقولا",21,"ل",2,0],["من يلهُ بالعيدِ أو يلعب فأنت به","لله مرضٍ تعالى جده وعَلا",22,"ل",2,0],["منيلنا باسط في اللين جانبه","كم قد كفا وكفانا صولة العدم",23,"م",1,0],["مَن يَلقَ إِبراهيمَ يِلقَ الأَروَعَ الن","نَدبَ الهُمامَ الناسِكَ المُتَهَجِّدا",24,"د",2,0],["مَن يَلقَ شَمسَ الدِّينِ يَلقَ اِمرَءاً","يَقعُدُ وَالأَعداءُ مِنهُ قِيام",25,"م",1,0],["مَن يَلبَسُ السَردَ المُضاعَفَ في الوَغى","وَالحَمدَ في يَومِ النَدى سِربالا",26,"ل",2,0],["مَن يَلُم في السَماحَةِ اِبنَ عَلِيٍّ","لَيسَ يَلقى سِوى الجَوى بِالجَوابِ",27,"ب",1,0],["مَن يَلقَ بِلَوى يَنُبهُ بَعدَها فَرَجٌ","وَالناسُ بَينَ ذَوي روحٍ وَمَكروبِ",28,"ب",1,0],["مَن يلتقِي المُذنِبين المُسْلَمِينَ بما","جَنوْهُ قَصداً بعفوٍ غَيرِ مُقتَصِدِ",29,"د",1,0],["مَن يَلُم في بُكائِهِ لا أُطِعهُ","وَأَقُل مِثلُ عامِرٍ أَبكاني",30,"ن",2,0],["مُنىً لعيني أن ترى","تلك الثلاثَ من مِنَى",31,"ن",2,0],["مُنىً لها لو جعلَ الدهرُ لها","أن تأمنَ الطاردَ والمدعدِعا",32,"ع",2,0],["من يلتفت خلفه ضلت محجّتُه","عن مُلك ربٍّ وعن فردوسه البادي",33,"د",2,0],["مَن يَلقَهُم وَهوَ ظامٍ","إِلى نَوالٍ وَبِرِّ",34,"ر",1,0],["مني له ذل غوى","ليت الصدود له حدود",35,"د",1,0],["مني له ذل الخضوع ومنه لي","عز المنوع وقوتي المثبتي",36,"ت",2,0],["مَن يَلمني إِذا تَهَتَّكت غَصَباً","بِحبيبي فمنكِرٌ أَوصابي",37,"ب",2,0],["منيلتي من حُلىً","وزينة ما أشاء",38,"ا",2,0],["من يلقني يلق مرهوناً بصوبته","متيماً لا يفك الدهر قيداه",39,"ا",2,0],["مَن يُلازِمْ مِنَ الكِرامِ كَريماً","يَكسَبُ المَجدَ في طَريقِ السّلامَه",40,"م",2,0],["مَن يلبس الدهرَ لو طالت سلامتهُ","لا بدَّ يبلى وما الملبوسُ بالبالي",41,"ل",2,0],["من يلذه أرّخوا","تهديه أنوار البشير",42,"ر",1,0],["مُنِيلٌ نَدَاهُ لِمَالٍ وَجَاهٍ","إِذَا عَزَّ نَيْلٌ لِجَاهٍ وَمَالِ",43,"ل",1,0],["منِّي له أَزكى سَلامٍ ما حَدا","حادٍ أو الأَطيارُ أضحَت سُجَّعا",44,"ع",2,0],["مَن يلقه قالَ هذا في شمائله","محمدٌ صالحٌ أن يغتدي علما",45,"م",2,0],["مُنىً لا أُبالي أن تكونَ كواذِباً","فتفنى ولكنّ المَدَارَ على وَجْدي",46,"د",2,0],["مَن يَلقَهُمُ يَلقَ مِنهُم مَعشَراً نُجُباً","لَم يُخلَقِ الفَضلُ إِلّا ساعَةً خُلِقُوا",47,"ق",3,0],["مَن يَلقَ فَخرَ المُلكِ يَلقَ حُلاحِلاً","ما لِلنُضارِ بِراحَتَيهِ مَلاقُ",48,"ق",1,0],["من يلتجىء بحماهمو يلقَ الهنا","فوقَ الرجا جادوا لنا بمضاعفِ",49,"ف",1,0],["مني لربات الخدور في الوطن","ولي من اللَه بها الأجر الحسن",50,"ن",1,0],["مَن يُلبِسَ الطِفلَ روحَ الحَزمِ مِن صِغَرٍ","حَتّى يُرى وَهوَ ماضي العَزمِ مِغوارُ",51,"ر",1,0],["مُنىً لحنَ لي ثم انثنينَ عجالا","وزايلنَ آمالَ الشبابِ فزالا",52,"ل",2,1],["منىً لَكَ بَينَ هاتيك الخدور","وَما هِيَ غَير ولدان وحور",53,"ر",1,1],["مني لكم محض المودة والولا","والنصح في الاعلان والأسرار",54,"ر",1,0],["مَن يلقَهم يلقَ الطعانَ على ال","لباتِ قبلَ ورودِه يُدْمِي",55,"م",2,0],["مَن يَلمِسِ القارَ يَلصَق في يَدَيهِ ومَن","يَقُرب مِنَ النارِ هل يَنجُو مِنَ اللَهَبِ",56,"ب",1,0],["مَن يَلقَ في الدُنيا سروراً فليعش","لا من يعيش يضام ان لم يعتل",57,"ل",1,0],["من يلتجىء للمصطفى ولآله","والشافعي فليس قط بضائع",58,"ع",1,0],["مَنِيلا إِذا ما قامَ أَوسَعُ مَنكِباً","وأُوذِسُ إِن يَجلِس وَقارٌ وإِبرارُ",59,"ر",1,0],["منى لمحب سلاه دائم كرب","عوديه بقرب يرى جمالك بالعين",60,"ن",1,0],["مني له خير الدعاء مع الثنا","ء عليه في فرضي وفي اورادي",61,"د",2,0],["مَن يَلقَهُ مِمَّن تَرى فَلِقاؤُهُ","إِيّاهُ بِالتَّعظيمِ وَالسُّلطانِ",62,"ن",1,1],["من يلبينا نرقيه ومن","صد عنا فيكفيه الصدود",63,"د",1,0],["من يلح من الدنيا","منكراً كما لحتِ",64,"ت",1,1],["من يلمس الجمرة الحمرا كلت كفه","وش يطفي الجمرة اللي داخل فؤادي",65,"د",2,1],["من يلوم الصّدْرِ دام الصّدْرِ ضاري","الهموم اللي على اضلاعه امْحَفوره",66,"ر",2,0],["من يلزم الصبر فلن تغلبه","مصائب الدنيا ولا صرف القضا",67,"ا",1,0],["من يلوم الأعمى، وقد أظلمت في","مقلتيه البدور والأقمار؟",68,"ر",1,0],["مني لك يمضي السلام حبيبتي","ووقاك رب العرش غمَّ نواكِ",69,"ك",1,0],["من يلوم الطريق ومن يلوم السحاب","لو غدى بينهم في عشقها منافسه",70,"س",2,0],["من يلوم الي غلط لامل من كثر الصواب","شاف من همه عذاب وصار بالدنيا غريب",71,"ب",1,0],["مَنْ يَلْبَسْ الدَّهْرَ لَو طالَتْ سَلامَتُهُ","لابُدَّ يَبْلَ وَما المَلْبُوسُ بِالبالِي",72,"ل",2,0],["مَن يلثم ِالشّهدَ اللذيذَ يحسّهُ","طعمَ اللسانِ حلاوة ً يتقطّرُ",73,"ر",1,0],["من يلوم الفكر بالعقل اختلال.","او ملاه الحقد في بطن وظهر.",74,"ر",1,0],["من يلبس المعنى القميء كغاية","لا باب للتأويل في أبوابهِ",75,"ب",2,0],["من يلجم الأفكار يوماً إن غدت","في اللُبِّ كالخيل العراب الجامحة",76,"ح",2,0],["من يلق لبطال الرجال يكلم","ومن يكن ذا أود يقوم",77,"م",1,0],["مَنْ يَلْتَقِينِي يَرَى نَفْساً مُحَطَّمَةً","قَدْ سَامَهَا الضَّيْمُ خَسْفاً قَبْلَ لُقْيَايَا",78,"ا",3,0]]}