{"poems":[[107,"سيري الهوينى دومة الجندل","https://www.aldiwan.net/poem44201.html","السريع"],[242,"يا من ألح علي في الإنشاد","https://www.aldiwan.net/poem18166.html","الكامل"],[295,"ما لقصر الزهور أضحى كئيبا","https://www.aldiwan.net/poem11707.html","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92026","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128914","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128887","الخفيف"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34585","المديد"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83140","الخفيف"],[5386,"يحمدون الموت","https://www.poetsgate.com/ViewPoem.aspx?id=35634",""],[5431,"سطوة المال ...(شجرُ الحب مورقٌ لا انتهاءُ )","https://www.poetsgate.com/ViewPoem.aspx?id=198472",""],[5596,"زنجبار والشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=206692",""],[5596,"وفاء وولاء","https://www.poetsgate.com/ViewPoem.aspx?id=209113",""]],"verses":[["إيهٍ قنيصَ اللّهِ في حبلهِ","ظَفِرتَ بالأمنِ فلا تَوْجَلِ",0,"ل",1,0],["إِيهٍ قُسَنْطِينَةٌ فَخَارُكِ فَافْخَرِي","أَنْ كُنْتِ مَنْشَأَهُ على بَغْدَادِ",1,"د",1,0],["أيه قصر الزهور رزؤك عم الكون","حزناً وقد بكى الحرمان",2,"ن",1,0],["إيهِ قومي احملوا السكينة واسعوا","لمقام عَلى اقتراب بعيد",3,"د",1,0],["ايه قيثارة الوجود أعيدي","ذكريات للعالم الاسلامي",4,"م",2,0],["ايه قيثارة الوجود اعدى","ذكريات الصفا وعهد السلام",5,"م",1,0],["إيه قل لي غير محتشمٍ","هل دهاني فيك من أحدِ",6,"د",1,0],["إيهِ قُم أُعطِكَ زَوجاً تُستَباح","بَهجَةً إِحدى الخَريداتِ الصِباح",7,"ح",1,0],["إِيهِ قَلبي كَم فرقَةٍ ذُقتَ حَتّى","كِدتَ تَسلُو الهَوى فِراقاً وَوَصلا",8,"ل",2,0],["إيه قلت الشمس وجه وقالت القمرا تحبني","واستدرت بكل صيحة في العشق صوب الكفن",9,"ن",1,0],["إيهِ قلبي لتمنح الحب دوما","وحده الحب راحةٌ وشفاءُ",10,"ا",2,0],["إيهِ قلبي لتزرع الحبَ دوما","شجرُ الحب مورقٌ لا انتهاءُ",10,"ا",2,0],["إيه قد جئت شاكياً فشكتني","بتعابير صَمْتِها الآثار",11,"ر",1,0],["إيه (قابوس) قد فقدناك ظلّاً","من هجير الأيام والأزمات",12,"ت",1,0]]}