{"poems":[[55,"عذيري من العشرين يغمزن صعدتي","https://www.aldiwan.net/poem30678.html","الطويل"],[90,"سمعت شعرا للعندليب","https://www.aldiwan.net/poem44413.html","مخلع البسيط"],[71,"إن الدهر خان امرأ","https://www.aldiwan.net/poem29215.html","مجزوء المتقارب"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85439","الطويل"],[92,"شباب ضائع","https://www.poetsgate.com/ViewPoem.aspx?id=179161",""],[163,"بباب مربيطرٍ عاينت ذا عظةٍ","https://www.aldiwan.net/poem1350.html",""],[203,"إذا ما بكيت فنح يا حمام","https://www.aldiwan.net/poem45592.html","المتقارب"],[228,"بلوت الحياة فما من أنيس","https://www.aldiwan.net/poem41897.html","المتقارب"],[287,"إذا كنت في جلق راجلا","https://www.aldiwan.net/poem32429.html","المتقارب"],[371,"قضى نحبه الصوم بعد المطال","https://www.aldiwan.net/poem17310.html","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37971","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59710","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62705","الطويل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105454","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49926","الطويل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127953","الطويل"],[2360,"","https://poetry.dctabudhabi.ae/diwan/poem/119190","المتقارب"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93649","الطويل"],[2839,"","https://poetry.dctabudhabi.ae/diwan/poem/102200","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100217","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203005","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89164","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89042","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103931","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86286","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138654",""],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66355","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110051","الطويل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44677","الطويل"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105516","الوافر"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136586",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136534",""],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35414","الطويل"],[4758,"أيا قادماً من طوس أهلاً ومرحباً","https://www.poetsgate.com/ViewPoem.aspx?id=181665",""],[3794,"لأفضل من دمع لدى الغيد يطلق","https://www.poetsgate.com/ViewPoem.aspx?id=140800",""],[5189,"طيبة","https://www.poetsgate.com/ViewPoem.aspx?id=208519",""],[5219,"حديث الروح","https://www.poetsgate.com/ViewPoem.aspx?id=195009",""],[5616,"محنة","https://www.poetsgate.com/ViewPoem.aspx?id=203469",""],[5691,"روح المدائن","https://www.poetsgate.com/ViewPoem.aspx?id=206312",""],[5725,"حفظتك في قلبي عراقا مبجلا","https://www.poetsgate.com/ViewPoem.aspx?id=179745",""],[469,"أعاذلتي كُفّي ثكلتِ عن العذلِ","https://www.poetsgate.com/ViewPoem.aspx?id=76855",""],[5830,"سَلِي العُرُوبَةَ","https://www.poetsgate.com/ViewPoem.aspx?id=200822",""],[6029,"نشيج المدائن","https://www.poetsgate.com/ViewPoem.aspx?id=189014",""],[6318,"الجمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66160&r=&rc=10",""]],"verses":[["فَكَم زَعزَعَتني النائِباتُ فَلَم أُزِل","لَها قَدَمي عَن وَطأَةِ المُتَثَبِّتِ",0,"ت",1,0],["فكم زهور لِما أفوه","أصغت وقالت لا فضّ فوه",1,"ه",1,0],["فكم زخرفٍ قد سبا","إذا زُلزت لم يكنْ",2,"ن",1,0],["فَكَم زوجة لما دَهى الظلم بعلها","بَكَت فَبَكى في الحجر منها وَليدها",3,"د",3,0],["فكم زعزعٍ ما حرّكَتْ منه ساكناً","وكم فُرَصٍ عنّت له فأضاعا",4,"ع",2,0],["فَكَم زَجَرتُ وَلَكِن أَينَ مُزدَجِرٌ","عَمّا أُحَذِّرُهُ وَأَينَ مُتَّعِظُ",5,"ظ",1,0],["فكم زمنٍ هامَ فيها الفؤادُ","بينَ الفتاةِ وبينَ الغلامْ",6,"م",1,0],["فَكَم زارَني فيهِ من زائِرٍ","وَأَبصَرَني بِالدُموعِ أُصَلّي",7,"ي",1,0],["فَكَم زِلقَةٍ في حَواشي الطَريق","تَرُدُّ الثِيابَ بِخِزيٍ عَظيمِ",8,"م",1,0],["فَكَم زَخرَفَت جَنَّةً لِلعَذابِ","وَكَم رَفَعَت قَبَساً لِلضَلالِ",9,"ل",1,0],["فَكَمْ زِنْتُ أَجيادَ امْكَلام بِمَدحِهِم","بِجَوهَر مَنظومٍ ودرٍّ من امْنَّثْرِ",10,"ر",1,0],["فكم زَفرةٍ قد رددَت بتسهد","وكم عَبرةٍ قد غُيضتْ ببنان",11,"ن",1,0],["فكم زَخْرَفَ الدنيا أخو الجهل بالبنا","فهدّم والدهر المشتِّت ما بنى",12,"ا",1,0],["فكم زرتها والليل يرخي رداءه","علي وخزر الشهب تنظرني شزرا",13,"ر",2,0],["فكم زلّةٍ من صاحبِ لا تخاله","عليَّ بها من شدّة الخرق مذنبا",14,"ب",2,0],["فكم زان عباس من المجد والعلا","ومن همم فوق السماك عظام",15,"م",1,0],["فكم زلقة في حواشي الطريق","ترد الثياب يخزي عظيم",16,"م",1,0],["فَكم زَهرت للمجتني بِك وَردة","وَكَم عنَّ للغزلان فيكَ قَطيع",17,"ع",1,0],["فكم زرته والليل وحف فروعه","وما أرتاح لي قلب وإن طاف حراس",18,"س",1,0],["فكم زفرة لي فيك تعقب زفرة","وسرب دموعٍ يشرئب إلى سرب",19,"ب",1,0],["فكم زفرة أخفيتها عن عزيمتي","فباتت جحيماً تحرق العظم كالفحم",20,"م",1,0],["فكم زالت بهمته همومٌ","وكم حُسمت بمحضره أمور",21,"ر",1,0],["فكم زهدت في طامعٍ بيد أنها","لها طمع ذا اليوم منه بزاهد",22,"د",1,0],["فكم زنر بقد الصخر أيسره","وكم أنين بنار الوجد يشفعه",23,"ع",2,0],["فَكَم زَفرات من فُؤاد تَصاعَدَت","عَلَيهِ وَكَم دَمع جَرى يَتحدَّر",24,"ر",1,0],["فكم زالت أمورٌ خلت تبقى","وما خطر الزوال لها بوهم",25,"م",1,0],["فكم زان بغداد بإنشاء معهد","له منظر بادي البهاء نضير",26,"ر",1,0],["فكم زَمِن أَشفى شَفى ظِلُّ ثوبهِ","فللَّه ما سوَّى حقيقتَهُ الظِلُّ",27,"ل",1,0],["فَكَم زُرتَها في الصَيفِ مُنفَرِداً بِها","يؤانسني الصَفصافُ وَالقُبَّةُ الخَضرا",28,"ر",2,0],["فكم زاد أجد لذي اغتصابا","أعد من المدام لها شرابا",29,"ب",2,0],["فكم زَفير على الواشينَ أكتمه","وعَبرةٍ خوفَ عُذالي أكفكفها",30,"ف",3,0],["فكم زَفراتٍ في الضُلوع يصونها","وكم شجنٍ في القلب أورى زناده",31,"د",2,0],["فَكَم زاهِدٍ أَلقاهُ في اللَيلِ زُهدُهُ","تفكّرهُ فيهِ أَتاهُ بِظُلمَةِ",32,"ه",1,0],["فكم زفرةٍ قد هجتها لو زفرتها","على سد ذي القرنين أمسى مذوبا",33,"ب",2,0],["فكم زهرة حسناء يأتيك حسنها","بريح خبيث كلما جئت تنشق",34,"ق",1,0],["فكم زاروكِ من خير البرايا","ومنهم شاديًا فرحًا وباكِ",35,"ك",1,0],["فكم زللت عن الطاعات في سرف","عصيت بارئها سرا وإعلانا",36,"ن",2,0],["فكم زرعت وروداً في حدائقهم","وكم شحذت لهم سيفاً وكم ثلموا!",37,"م",3,0],["فكمْ زافوا الحَقائِقَ في انْتِمائي","وكمْ قاوَمْتُ بالتَّهْويدِ طمْسا",38,"س",2,0],["فكم زارني ليلا وفي العين غربة","متى ياجميل الوجه القاك مقبلا",39,"ل",2,0],["فكم زُفَّت الدنيا عروساً لخاطبِ","وكم فتكتْ بابنٍ وأختٍ على بعلِ",40,"ل",1,0],["فَكَمْ زَرَعْنَا عَلَى شَطٍّ لَنَا أَمَلاً","وَكَمْ حَصَدْنَا مِنَ الأَحْلامِ نَسْرِينَا",41,"ن",2,0],["فكم زيتونةٍ في الشَّام ناحَتْ","يَضِجُّ لها مِنَ اليَمَن الصُّواحُ",42,"ح",1,0],["فَكَمْ زِينَةٍ سَعَّرَتْ فِتْنَةً","تلظَّتْ عَلَى شَهْوَةٍ أَو مُجُونْ",43,"ن",1,0]]}