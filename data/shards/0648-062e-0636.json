{"poems":[[53,"هذي الرماح عصي الضال والسلم","https://www.aldiwan.net/poem29765.html","البسيط"],[3,"أعادي صرف دهر لا يعادى","https://www.aldiwan.net/poem145.html",""],[3,"طربت وهاجني البرق اليماني","https://www.aldiwan.net/poem220.html",""],[77,"هل كنت تعلم في هبوب الريح","https://www.aldiwan.net/poem36635.html","الكامل"],[86,"أشرق فدتك مشارق الإصباح","https://www.aldiwan.net/poem10673.html","الكامل"],[86,"تعمدت قتلي في الهوى وتعمدا","https://www.aldiwan.net/poem68959.html","الطويل"],[30,"لقد جشأت نفسي عشية مشرف","https://www.aldiwan.net/poem29594.html","الطويل"],[27,"أقلي اللوم عاذل والعتابا","https://www.aldiwan.net/poem5686.html","الوافر"],[37,"الا حييت عنا يا مدينا","https://www.aldiwan.net/poem7642.html","الوافر"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[64,"للعلم أهل وللإيمان ترتيب","https://www.aldiwan.net/poem67665.html","البسيط"],[51,"وخضراء من حوك الربيع شهدتها","https://www.aldiwan.net/poem64584.html","الطويل"],[51,"حي المعاهد والمنازل","https://www.aldiwan.net/poem65977.html","مجزوء الكامل"],[92,"يا عذارى الجمال والحب والأحلام","https://www.aldiwan.net/poem38951.html","الخفيف"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[43,"محبي قيامي ما لذلكم النصل","https://www.aldiwan.net/poem9982.html","الطويل"],[62,"بضاعة هرمس مكنونة","https://www.aldiwan.net/poem52211.html","المتقارب"],[61,"هفا طربا في أوان الطرب","https://www.aldiwan.net/poem51796.html","المتقارب"],[66,"صاحب السيف الصقيل المحلا","https://www.aldiwan.net/poem39637.html","المديد"],[80,"عسى للصبا علم برسم المعالم","https://www.aldiwan.net/poem31293.html","الطويل"],[80,"حبذا فتيان صدق أعرسوا","https://www.aldiwan.net/poem31454.html","الرمل"],[74,"أما والتفات الروض عن أزرق النهر","https://www.aldiwan.net/poem12954.html","الطويل"],[74,"أفي ما تؤدي الريح عرف سلام","https://www.aldiwan.net/poem13260.html","الطويل"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[75,"أحبب بتياك القباب قبابا","https://www.aldiwan.net/poem69103.html","الكامل"],[46,"حالي حال اليائس الراجي","https://www.aldiwan.net/poem22270.html","السريع"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9913","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54302","الخفيف"],[106,"عودة إلى مصر","https://www.poetsgate.com/ViewPoem.aspx?id=179678",""],[106,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[90,"إليها !","https://www.poetsgate.com/ViewPoem.aspx?id=179205",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[90,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[64,"جواب في حقيقة الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=3095",""],[116,"ابحت لنا عينيك للسفك والفتك","https://www.aldiwan.net/poem40864.html","عموديه"],[122,"شربت شراباً لا ذوو الخمر تشرب","https://www.aldiwan.net/poem23828.html","الطويل"],[136,"سواي بهذه الدنيا يبالي","https://www.aldiwan.net/poem48852.html","الوافر"],[136,"أتذكر إذ كنا على القبر ستة","https://www.aldiwan.net/poem49079.html","الطويل"],[136,"ليدع المدعون العلم والأدبا","https://www.aldiwan.net/poem49171.html","البسيط"],[144,"ضل من يستزير طيف الخيال","https://www.aldiwan.net/poem11795.html","الخفيف"],[187,"إن الخطوب سقيني","https://www.aldiwan.net/poem43215.html","مجزوء الكامل"],[231,"وخضر من الدوحات لمي ظلالها","https://www.aldiwan.net/poem4046.html","الطويل"],[236,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[238,"لئن كان ورد الخد أبدع في الصبغ","https://www.aldiwan.net/poem19495.html","الطويل"],[260,"ليل الخطوب له فجر من الفرج","https://www.aldiwan.net/poem35932.html","البسيط"],[260,"من بحر حمدي لرب المنح مغترفي","https://www.aldiwan.net/poem35943.html","البسيط"],[350,"طليق دموع لا يفك له أسر","https://www.aldiwan.net/poem15720.html","الطويل"],[350,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[354,"رد الجدول الصافي الذي ضم أبحرا","https://www.aldiwan.net/poem39982.html","الطويل"],[365,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[367,"ظفرت على رغم الليالي بكوكب","https://www.aldiwan.net/poem16935.html","الطويل"],[401,"تلاميذ النبوة","https://www.aldiwan.net/poem6731.html","عموديه"],[417,"أحبتنا أنتم على السخط والرضا","https://www.aldiwan.net/poem53975.html","الطويل"],[430,"يا يوم بحفوفة والشهب هائلة","https://www.aldiwan.net/poem40807.html","البسيط"],[430,"رعى الله ربعا زاد فيه سروره","https://www.aldiwan.net/poem40855.html","الطويل"],[440,"لئن سرت الدنيا فأنت سرورها","https://www.aldiwan.net/poem34913.html","الطويل"],[466,"في رحاب الحسين","https://www.aldiwan.net/poem59034.html","عموديه"],[483,"بكعبة أنوار أنخت مطيتي","https://www.aldiwan.net/poem24323.html","عموديه"],[483,"نسيم الصبا عنعن وسلسل بنافح الت","https://www.aldiwan.net/poem24378.html","عموديه"],[515,"كشفت حجاب السجف عن بيضة الخدر","https://www.aldiwan.net/poem20816.html","الطويل"],[530,"ما لبسك الديباج والتاج مع","https://www.aldiwan.net/poem37420.html","السريع"],[554,"تعز فقد مات الهوى وانتهى الجهل","https://www.aldiwan.net/poem68388.html","الطويل"]],"verses":[["وَخُضخِضَ السَجلُ في قَعرِ القَليبِ فَلَم","يَنزَح لَهُ غَيرُ مَكتومٍ مِنَ الوَذَمِ",0,"م",1,0],["وَخُضتُ بِمُهجَتي بَحرَ المَناي","وَنارُ الحَربِ تَتَّقِدُ اِتِّقادا",1,"د",2,0],["وَخُضتُ غُبارَها وَالخَيلُ تَهوي","وَسَيفي وَالقَنا فَرَسا رِهانِ",2,"ن",1,0],["وخَضيبَةِ المِنْقارِ تَحْسِبُ أنّها","نَهَلَتْ بمَوْرِدِ دَمْعيَ المَسْفوحِ",3,"ح",1,0],["وَخُضِ الحَياةَ وَإِن تَلاطَمَ مَوجُها","خَوضُ البِحارِ رِياضَةُ السَبّاحِ",4,"ح",1,0],["وَخُضتُ بِأَحشاءِ الجَميعِ كَأَنَّهُم","نِيامٌ سَقاهُم فاجِئُ الرُعبِ مُرقِدا",5,"د",2,0],["وَخَضراءَ في وَكرَينَ عَرعَرتُ رَأَسَها","لِأُبلي إِذ فارَقتُ في صُحبَتي عُذرا",6,"ر",2,0],["وَخَضراءِ المَغابِنِ مِن نُمَيرٍ","يَشينُ سَوادُ مَحجِرِها النِقابا",7,"ب",2,0],["وخضنا بالقُرات إلى عدى","وقد ظنت بنا مُضَرُ الظنونا",8,"ن",2,0],["وَخُضنَا بِالسُّيُوفِ إليه خَوضاً","وسُمرِ الخَطِّ كِندَةَ والسّكُونا",9,"ن",2,0],["وَخُضنَا بِالقُراتِ إِلى عَدِيٍّ","وَقَد ظَنَّت مُضَرُ الظُّنُونَا",9,"ن",2,0],["وَخُضتُ بَحراً وَلَم يَرسُب بِهِ قَدَمي","خاضَتهُ روحي وَقَلبي مِنهُ مَرعوبُ",10,"ب",1,0],["وخضراءَ من حَوكِ الربيع شهدتها","مغيمةَ شمس اليوم معهودةَ الأمس",11,"س",1,1],["وخضبْتَ خُنْثَك بالتغزْ","زُلِ والبغاءُ هناك ناصلُ",12,"ل",1,0],["وخِضَمُّ يَموج بالإثمِ والنَّكْرِ","والشَّرِّ والظِّلالِ المَديدِ",13,"د",1,0],["وَخَضَع الشامُ وَمِن حِيالَهُ","مِن آل حَمدانَ فَوارِسِ اللُقا",14,"ا",1,0],["وَخُضرَةُ ثَوبِ العَيشِ في الخُضرَةِ الَّتي","أَرَتكَ اِحمِرارَ المَوتِ في مَدرَجِ النَملِ",15,"ل",1,0],["وخض في التجارب بعد الوقوف","على السر واصبر ولا تيأسِ",16,"س",1,0],["وخضراءُ تَنثُرُ فيها الصَّبا","فريدَ ندىً ما لَه من ثُقَب",17,"ب",1,0],["وَخِضابُ اللَيلِ بِال","صُبحِ ناصِل",18,"ل",1,0],["وخضرٍ خلاياهُنّ تجري كما ارتَمَتْ","بقاعِ سرابٍ مُجْفَلاتُ النّعائمِ",19,"م",1,0],["وَخِضابُ الشَّيبِ لا أَقبَلُهُ","إِنَّهُ في شَعَري شاهِدُ زُور",20,"ر",1,0],["وَخُضتُ ظَلامَ اللَيلِ يَسوَدُّ فَحمُهُ","وَدُستُ عَرينَ اللَيثِ يَنظُرُ عَن جَمرِ",21,"ر",1,0],["وَخَضخَضتُ دونَ الحَيِّ أَحشاءَ لَيلَةٍ","يُخَفِّرُني فيها وَميضُ غَمامِ",22,"م",1,0],["وَخَضَعنَ لي بَعضَ الخُضو","عِ عَنِ التَنازُحِ وَالتَحاوُل",23,"ل",1,0],["وخضَبْتُ مُسْوَدَّ الحِداد عليكُمُ","لو أنّني أجِدُ البَياضَ خِضابا",24,"ب",2,0],["وَخَضبَهُ الأَبيَضَ مُستَأنِساً","بِأَسوَدٍ لِلهَولِ فَرّاجِ",25,"ج",1,0],["وَخُضتُ بِمُهجَتي بَحرَ المَنايا","وَنارُ الحَربِ تَتَّقِدُ اِتِّقادا",26,"د",2,0],["وخضَمُّ الماضِي يَعُجُّ بمن في","ه ويغْشى قوْماً ويغمرُ مُدنَا",27,"ن",2,0],["وخضرةٍ، وسلسلٍ مَعين","ومعشرٍ بالفضلِ طوقوني",28,"ن",2,0],["وخَضِ المحيطَ -إذ أرد","تَ بنا- نخُضْهُ بلا سفين",29,"ن",1,0],["وخضتُ من الحُبِّ لُجِّيه","على مَتن جِنيَّة أُقذَف",30,"ف",1,0],["وخُضوعُهُ كخُضوعهمْ أبداً","للغيبِ أنَّى سارَ يقصده",31,"د",2,0],["وخُضْها كما خاضَها الأسبقون","وَثنِّ بما افتتحَ الأقدم",32,"م",1,0],["وخُضْتُ بحراً ولم يرسب به قدمي","خاضَتْهُ روحي وقلبي منه مرغوب",33,"ب",1,0],["وخضت مع الافاك في تهجما","ويشرف ذو الاصل الشريف عن الافك",34,"ك",1,0],["وخضت بحاراً لا تخاض بحيلة","ولكنها فضلاً تخاض وتشرب",35,"ب",1,0],["وخضت غمارهم وخلعت منهم","قلوباً ما بقدرتها احتمالي",36,"ل",2,0],["وخضت اللجّ أطعن في حشاها","وما قصرت في قطعِ الجبالِ",36,"ل",1,0],["وخُض لُججَ الهيجاء أعزلَ آمنا","فإن المنايا منك تعدو وتهربُ",37,"ب",1,0],["وخِضرم غاض لما فاض زاخرُه","وضامر أدرك الغايات ثم كبا",38,"ب",2,0],["وَخِضَمٌّ يَأبى وَإِن كَثُرَ الوُرّا","دُ أَن يَظفَروا بِغَيرِ زُلالِ",39,"ل",1,0],["وخضعت في طلبِ المعا","ش لكل حاتيه مسنّه",40,"ن",2,0],["وخضرٌ منَ الدوْحَاتِ لميٌ ظِلالُها","وصلتُ صَبُوحًا بها بغَبُوقِ",41,"ق",1,1],["وَخُضتَ مِنها بَحرَ مُل","كٍ مَن يَخُضهُ يَغرَقِ",42,"ق",1,0],["وَخَضَّبَ تَحْجْيلَ الْجِيَادِ نَجِيعُهُمْ","فَتَحْسِبُ يَاقُوتاً تَنَاسَقَ فِي الرُّسْغِ",43,"غ",1,0],["وخض بحور صفا التسليم منشرحاً","واسبح ولا تخش إغراقاً من اللُّجَج",44,"ج",1,0],["وخض بغوصك بحر السرّ ملتقطاً","مكنون درٍّ من الأسرار في صدف",45,"ف",1,0],["وَخُض غَمَراتِ المَوتِ لا باخِلاً بِما","عَلَيكَ بِنَزرٍ مِنهُ قَد أَنعَمَ الدَهرُ",46,"ر",1,0],["وَخُض بِبَحرٍ لِبُحَيرا تَلقَ في","قَرارِهِ مِنَ اليَواقيتِ بِدَر",47,"ر",1,0],["وَخُض لجّهُ وَاِستجلِ كُلّ فَريدةٍ","تحلّى بِها في الناس مَن كانَ عاطِلا",48,"ل",2,0],["وخُضنْا بها بحراً من الآل طافحا","فعامتْ بنا مثلَ السّفينِ المُلجَّج",49,"ج",1,0],["وَخُضرَتُها قَد جاوَرَت خُضرَةَ اللَمى","وَلِلعَينِ فيها وَالقُلوبِ مَذاهِبُ",50,"ب",1,0],["وخضتم بالهوى مستنقعاتٍ","من الأحقاد, زادتكم سقاما",51,"م",2,0],["وخُضْنا ظَلامَ اللَّيل واللَّيل حالك","بهيمٌ وفي وجه الخطوب قطوب",52,"ب",1,0],["وخضبت من دم الأعدا مخالبها","فلم تدع لبني حجلان من أثر",53,"ر",1,0],["وخضبها الريحان كفّاً بعندمٍ","ومنطقها أبهى وشاحٍ نضيرهُ",54,"ه",1,0],["وَخَضْتَ وَقَدْ أَعْيَتْ نجاةُ غَرِيقِهَا","وهالَتْ بأمواجِ المنايا بُحُورُها",55,"ر",3,0],["وخُضْتَ وقد ضُفِرَ الموتُ ضَفْراً","فَما فيهِ للرّوحِ مِن مَخْرَمِ",56,"م",1,0],["وخضت مقامات تحار بوصفها","لديها قضى العرفان دون هويتي",57,"ت",2,0],["وخضت بحارا طاميات زواجرا","برشحتها هامت خلائق بالسكر",58,"ر",1,0],["وخُضْتُ إليها الحَتْفَ حتّى كأنّني","أُفتِّشُ أحشاءَ المنيّةِ عن سِرّي",59,"ر",2,0],["وخُضْ غِمارَ الفِقْهِ إنْ شِئْتَ أَنْ","تَطُولَ إمّا امْرُؤٌ قَصَّرا",60,"ر",2,0],["وَخَضراءَ يَدعو شَجوَ مُكِّيِّها الصَدى","إِذا نَسَفَتها الريحُ ريحانُها شُعلُ",61,"ل",1,0]]}