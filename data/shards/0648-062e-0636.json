tps://www.poetsgate.com/ViewPoem.aspx?id=205241",""],[5688,"وهكذا تآخينا","https://www.poetsgate.com/ViewPoem.aspx?id=200931",""],[5689,"ضاقت بمن في ظلها الآجام","https://www.poetsgate.com/ViewPoem.aspx?id=143413",""],[5770,"يا وَحشَةَ الدرب","https://www.poetsgate.com/ViewPoem.aspx?id=178815",""],[5786,"ما الغيث لمّا جرى بالسَّيل واديه","https://www.poetsgate.com/ViewPoem.aspx?id=50656",""],[5943,"تشطير لقصيدة نجاة الظاهري","https://www.poetsgate.com/ViewPoem.aspx?id=138286",""],[6093,"تجربة ماء","https://www.poetsgate.com/ViewPoem.aspx?id=205456",""],[5724,"ربيعك للروح كالبلسم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55133&r=&rc=0",""],[406,"مهرجان الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1119&r=&rc=63",""],[6262,"صديقي الوطن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80127&r=&rc=25",""],[6320,"كِتَابُ الله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84340&r=&rc=37",""],[6320,"حَائِطُ الشَّجَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83619&r=&rc=0",""]],"verses":[["وَخُضخِضَ السَجلُ في قَعرِ القَليبِ فَلَم","يَنزَح لَهُ غَيرُ مَكتومٍ مِنَ الوَذَمِ",0,"م",1,0],["وَخُضتُ بِمُهجَتي بَحرَ المَناي","وَنارُ الحَربِ تَتَّقِدُ اِتِّقادا",1,"د",2,0],["وَخُضتُ غُبارَها وَالخَيلُ تَهوي","وَسَيفي وَالقَنا فَرَسا رِهانِ",2,"ن",1,0],["وخَضيبَةِ المِنْقارِ تَحْسِبُ أنّها","نَهَلَتْ بمَوْرِدِ دَمْعيَ المَسْفوحِ",3,"ح",1,0],["وَخُضِ الحَياةَ وَإِن تَلاطَمَ مَوجُها","خَوضُ البِحارِ رِياضَةُ السَبّاحِ",4,"ح",1,0],["وَخُضتُ بِأَحشاءِ الجَميعِ كَأَنَّهُم","نِيامٌ سَقاهُم فاجِئُ الرُعبِ مُرقِدا",5,"د",2,0],["وَخَضراءَ في وَكرَينَ عَرعَرتُ رَأَسَها","لِأُبلي إِذ فارَقتُ في صُحبَتي عُذرا",6,"ر",2,0],["وَخَضراءِ المَغابِنِ مِن نُمَيرٍ","يَشينُ سَوادُ مَحجِرِها النِقابا",7,"ب",2,0],["وخضنا بالقُرات إلى عدى","وقد ظنت بنا مُضَرُ الظنونا",8,"ن",2,0],["وَخُضنَا بِالسُّيُوفِ إليه خَوضاً","وسُمرِ الخَطِّ كِندَةَ والسّكُونا",9,"ن",2,0],["وَخُضنَا بِالقُراتِ إِلى عَدِيٍّ","وَقَد ظَنَّت مُضَرُ الظُّنُونَا",9,"ن",2,0],["وَخُضتُ بَحراً وَلَم يَرسُب بِهِ قَدَمي","خاضَتهُ روحي وَقَلبي مِنهُ مَرعوبُ",10,"ب",1,0],["وخضراءَ من حَوكِ الربيع شهدتها","مغيمةَ شمس اليوم معهودةَ الأمس",11,"س",1,1],["وخضبْتَ خُنْثَك بالتغزْ","زُلِ والبغاءُ هناك ناصلُ",12,"ل",1,0],["وخِضَمُّ يَموج بالإثمِ والنَّكْرِ","والشَّرِّ والظِّلالِ المَديدِ",13,"د",1,0],["وَخَضَع الشامُ وَمِن حِيالَهُ","مِن آل حَمدانَ فَوارِسِ اللُقا",14,"ا",1,0],["وَخُضرَةُ ثَوبِ العَيشِ في الخُضرَةِ الَّتي","أَرَتكَ اِحمِرارَ المَوتِ في مَدرَجِ النَملِ",15,"ل",1,0],["وخض في التجارب بعد الوقوف","على السر واصبر ولا تيأسِ",16,"س",1,0],["وخضراءُ تَنثُرُ فيها الصَّبا","فريدَ ندىً ما لَه من ثُقَب",17,"ب",1,0],["وَخِضابُ اللَيلِ بِال","صُبحِ ناصِل",18,"ل",1,0],["وخضرٍ خلاياهُنّ تجري كما ارتَمَتْ","بقاعِ سرابٍ مُجْفَلاتُ النّعائمِ",19,"م",1,0],["وَخِضابُ الشَّيبِ لا أَقبَلُهُ","إِنَّهُ في شَعَري شاهِدُ زُور",20,"ر",1,0],["وَخُضتُ ظَلامَ اللَيلِ يَسوَدُّ فَحمُهُ","وَدُستُ عَرينَ اللَيثِ يَنظُرُ عَن جَمرِ",21,"ر",1,0],["وَخَضخَضتُ دونَ الحَيِّ أَحشاءَ لَيلَةٍ","يُخَفِّرُني فيها وَميضُ غَمامِ",22,"م",1,0],["وَخَضَعنَ لي بَعضَ الخُضو","عِ عَنِ التَنازُحِ وَالتَحاوُل",23,"ل",1,0],["وخضَبْتُ مُسْوَدَّ الحِداد عليكُمُ","لو أنّني أجِدُ البَياضَ خِضابا",24,"ب",2,0],["وَخَضبَهُ الأَبيَضَ مُستَأنِساً","بِأَسوَدٍ لِلهَولِ فَرّاجِ",25,"ج",1,0],["وَخُضتُ بِمُهجَتي بَحرَ المَنايا","وَنارُ الحَربِ تَتَّقِدُ اِتِّقادا",26,"د",2,0],["وخضَمُّ الماضِي يَعُجُّ بمن في","ه ويغْشى قوْماً ويغمرُ مُدنَا",27,"ن",2,0],["وخضرةٍ، وسلسلٍ مَعين","ومعشرٍ بالفضلِ طوقوني",28,"ن",2,0],["وخَضِ المحيطَ -إذ أرد","تَ بنا- نخُضْهُ بلا سفين",29,"ن",1,0],["وخضتُ من الحُبِّ لُجِّيه","على مَتن جِنيَّة أُقذَف",30,"ف",1,0],["وخُضوعُهُ كخُضوعهمْ أبداً","للغيبِ أنَّى سارَ يقصده",31,"د",2,0],["وخُضْها كما خاضَها الأسبقون","وَثنِّ بما افتتحَ الأقدم",32,"م",1,0],["وخُضْتُ بحراً ولم يرسب به قدمي","خاضَتْهُ روحي وقلبي منه مرغوب",33,"ب",1,0],["وخضت مع الافاك في تهجما","ويشرف ذو الاصل الشريف عن الافك",34,"ك",1,0],["وخضت بحاراً لا تخاض بحيلة","ولكنها فضلاً تخاض وتشرب",35,"ب",1,0],["وخضت غمارهم وخلعت منهم","قلوباً ما بقدرتها احتمالي",36,"ل",2,0],["وخضت اللجّ أطعن في حشاها","وما قصرت في قطعِ الجبالِ",36,"ل",1,0],["وخُض لُججَ الهيجاء أعزلَ آمنا","فإن المنايا منك تعدو وتهربُ",37,"ب",1,0],["وخِضرم غاض لما فاض زاخرُه","وضامر أدرك الغايات ثم كبا",38,"ب",2,0],["وَخِضَمٌّ يَأبى وَإِن كَثُرَ الوُرّا","دُ أَن يَظفَروا بِغَيرِ زُلالِ",39,"ل",1,0],["وخضعت في طلبِ المعا","ش لكل حاتيه مسنّه",40,"ن",2,0],["وخضرٌ منَ الدوْحَاتِ لميٌ ظِلالُها","وصلتُ صَبُوحًا بها بغَبُوقِ",41,"ق",1,1],["وَخُضتَ مِنها بَحرَ مُل","كٍ مَن يَخُضهُ يَغرَقِ",42,"ق",1,0],["وَخَضَّبَ تَحْجْيلَ الْجِيَادِ نَجِيعُهُمْ","فَتَحْسِبُ يَاقُوتاً تَنَاسَقَ فِي الرُّسْغِ",43,"غ",1,0],["وخض بحور صفا التسليم منشرحاً","واسبح ولا تخش إغراقاً من اللُّجَج",44,"ج",1,0],["وخض بغوصك بحر السرّ ملتقطاً","مكنون درٍّ من الأسرار في صدف",45,"ف",1,0],["وَخُض غَمَراتِ المَوتِ لا باخِلاً بِما","عَلَيكَ بِنَزرٍ مِنهُ قَد أَنعَمَ الدَهرُ",46,"ر",1,0],["وَخُض بِبَحرٍ لِبُحَيرا تَلقَ في","قَرارِهِ مِنَ اليَواقيتِ بِدَر",47,"ر",1,0],["وَخُض لجّهُ وَاِستجلِ كُلّ فَريدةٍ","تحلّى بِها في الناس مَن كانَ عاطِلا",48,"ل",2,0],["وخُضنْا بها بحراً من الآل طافحا","فعامتْ بنا مثلَ السّفينِ المُلجَّج",49,"ج",1,0],["وَخُضرَتُها قَد جاوَرَت خُضرَةَ اللَمى","وَلِلعَينِ فيها وَالقُلوبِ مَذاهِبُ",50,"ب",1,0],["وخضتم بالهوى مستنقعاتٍ","من الأحقاد, زادتكم سقاما",51,"م",2,0],["وخُضْنا ظَلامَ اللَّيل واللَّيل حالك","بهيمٌ وفي وجه الخطوب قطوب",52,"ب",1,0],["وخضبت من دم الأعدا مخالبها","فلم تدع لبني حجلان من أثر",53,"ر",1,0],["وخضبها الريحان كفّاً بعندمٍ","ومنطقها أبهى وشاحٍ نضيرهُ",54,"ه",1,0],["وَخَضْتَ وَقَدْ أَعْيَتْ نجاةُ غَرِيقِهَا","وهالَتْ بأمواجِ المنايا بُحُورُها",55,"ر",3,0],["وخُضْتَ وقد ضُفِرَ الموتُ ضَفْراً","فَما فيهِ للرّوحِ مِن مَخْرَمِ",56,"م",1,0],["وخضت مقامات تحار بوصفها","لديها قضى العرفان دون هويتي",57,"ت",2,0],["وخضت بحارا طاميات زواجرا","برشحتها هامت خلائق بالسكر",58,"ر",1,0],["وخُضْتُ إليها الحَتْفَ حتّى كأنّني","أُفتِّشُ أحشاءَ المنيّةِ عن سِرّي",59,"ر",2,0],["وخُضْ غِمارَ الفِقْهِ إنْ شِئْتَ أَنْ","تَطُولَ إمّا امْرُؤٌ قَصَّرا",60,"ر",2,0],["وَخَضراءَ يَدعو شَجوَ مُكِّيِّها الصَدى","إِذا نَسَفَتها الريحُ ريحانُها شُعلُ",61,"ل",1,0],["وَخض بَحر الفُنون فَكُل صَعب","عَلى مَن كانَ مُجتَهداً يَسير",62,"ر",1,0],["وخضر الروابي لأناته","تردد من شجوه زفرتين",63,"ن",1,0],["وَخِضابٌ بِكَفِّهِ","أَسوَدُ اللَونِ قارِتُه",64,"ه",1,0],["وَخَضَعَت مَرينُ تَحتَ قَهره","وَأَذعَنوا لِنَهيه وَأَمره",65,"ه",1,0],["وخضت إليك القفر وهو مُمنعٌ","بكل صَقيل مُرهفٍ لجلادي",66,"د",2,0],["وَخُضوعاً كانَ بي فيما مَضى","سَيَصيرُ الآنَ كِبراً وَعِنادا",67,"د",2,0],["وَخُضْنَا بِحَاراً فِي رِضَاهُ وَلُجَّةً","وَلَوْلاَهُ مَا اشْتَقْنَا طَوَافاً وَحَجَّةً",68,"ه",1,0],["وخضتُ الدجى بحراً إلى أن بدا لنا","كشمس الضحى وجه الهمام محمد",69,"د",1,0],["وَخَضَّبَ راحتي بالراح فاعْجَبْ","ألِلرَّاحاتِ بِالرَّاحِ اخْتِضَابُ",70,"ب",1,0],["وخضب راحات القرنفل فاغتدت","معاصمه خضرا وأنمله حمرا",71,"ر",2,0],["وخضّب كفيه ووشى جناحه","وكحل عينيه كما كلل الصدرا",71,"ر",2,0],["وَخُضْ أبْحُرَ البَيْداَ بِبِيضِ رَكَائِبٍ","تَمُرُّ فَلاَ تَبْدُو لِطَرْفِكَ إذْ تَعْدُو",72,"د",2,0],["وَخُضرٌ يَجمَعُ الأَعجازُ مِنها","مَناطِقُ مِثلَ أَطواقِ الحَمامِ",73,"م",1,1],["وَخَضبِ أَطرافِ البَنانِ الطَفلِ","وَطُولِ إِسْجاءِ العُيُونِ النُجْلِ",74,"ل",1,0],["وخضبن بالراح رخص البنان","فخضب بالدمع ذو الشوق راحا",75,"ح",2,0],["وخَضَبْتَ صُفْرَ وُجوهِهِمْ بِدِمائِهمْ","فحَكَتْ شعارَكَ أَحْمراً في أَصْفَرا",76,"ر",2,0],["وخضرة وثمر وزهرِ","فاكهة من كلها زوجان",77,"ن",1,0],["وخُضتُ لأنواعِ المعارفِ أبحُراً","ففي الحينِ ما استخرجتُها وهي تنزِفُ",78,"ف",1,0],["وخضرم تردُ الآمالُ ساحلَه","لو رامت اللجَّ أدناها لتغريقِ",79,"ق",1,0],["وخضرةُ الروضِ حفَّت في سواحله","فروضُهُ روضةً الفردوسِ أَنسنا",80,"ن",2,0],["وخُض الأَهوال في كسب العلى","بيد الكدّ وقلبٍ صَلِب",81,"ب",1,0],["وخضت بحراً بهِ الامواج تلثطمُ","وكم فريت الفلا والليل معثكرٌ",82,"ر",1,0],["وَخَضَّبَت شَيبَ عُثمانٍ دَماً وَخَطَت","إِلى الزُبَيرِ وَلَم تَستَحي مِن عمرِ",83,"ر",1,0],["وخضاب كفك بالمسرة شاهدٌ","أما أنا فمعذبٌ متباعدٌ",84,"د",1,0],["وَخُضْتُ بِحَارَ الْعِلْمِ مِنْ قَبْلِ نَشْأَتِي","أَخِي وَرفَيقِي كَانَ مُوسَى بْن