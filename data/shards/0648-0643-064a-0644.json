{"poems":[[23,"كبرت كذاك المرء ما عاش يكبر","https://www.aldiwan.net/poem21567.html","الطويل"],[53,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[92,"حالنا أو في سبيل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179149",""],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70834","الوافر"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64471","الطويل"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113874","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110051","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135732","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94405","البسيط"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136384",""],[4755,"دَعِينِي _ وصنعاءُ تَحتَ الحِصارْ _","https://www.poetsgate.com/ViewPoem.aspx?id=184228",""],[5956,"أواصلُ الانجذاب إلى حياتي الجديدة بمدريد","https://www.poetsgate.com/ViewPoem.aspx?id=192079",""]],"verses":[["وَكيلاً بِأَسبابِ السَماءِ نَهارَهُ","وَلَيلاً رَقيباً دائِماً لَيسَ يَفتُرُ",0,"ر",1,0],["وكي لا يقولَ القائلون أثابَهُ","وعاقَبَهُ والقولُ جَمَّ المَشاعِبِ",1,"ب",1,0],["وكي لا ترى عينٌ على البَغي شاهداً","تُغيرُ عمداً ناطقاتُ المحاضر",2,"ر",1,0],["وكيلها عليه والنبي","أقطعها ذلك وهو حيّ",3,"ي",1,0],["وكِيلوها شراءً لو","بذلتم ألفَ دينارِ",4,"ر",1,0],["وكيلي قد فوضت أمري مطلقاً","إليك ولم أعلم سواك لخطتي",5,"ي",1,0],["وكيلي اشهدني مقام توكلي","عليك وحققن به وبتوبتي",5,"ي",1,0],["وكيله يا صاح غير وافي","وأهله من شذة التجافي",6,"ي",1,0],["وكيلٌ على البيتِ العظيمِ مُفوَّضٌ","امينٌ على حِفظ الأَمانةِ إِردَخلُ",7,"ل",1,0],["وكيلُ يا كافي أيا حبيبُ","توكُّلي عليك لا أخيبُ",8,"ب",1,0],["وَكيلُ مَلكٍ لهُ الأملاكُ خاضعةٌ","يوني البسيطة منهُ النهيُ والأمرُ",9,"ر",1,0],["وكيل أمير المؤمنين أمينه","وذلك يكفيه فخاراً وسؤددا",10,"د",2,0],["وكي لا يكونَ انتِمائي لَصِيقًا","بِهادٍ مُضِلٍّ وراعٍ حِمارْ",11,"ر",1,0],["وكي لا أرى بَعدَ \"أيلولَ\" شعبًا","يُعادي نَشيدًا ويُدنِي شِعارْ",11,"ر",1,0],["وكي لا يَطولَ انتظاري كثيرًا","على البابِ, والبابُ مِن غَير دارْ",11,"ر",1,0],["وكي لا تَصِيرَ العَناقيدُ شوكًا","بِصدري, ويَطغَى عليهِ الغُبارْ",11,"ر",1,0],["وكي لا أرى الصَّمتَ يَبتَزُّ قلبي","مِن الذُّلِّ, فالصَّمتُ والذُّلُّ عارْ",11,"ر",1,0],["وكي لا يَصِيرَ اشتياقِي لِنفسي","ولِلحُبِّ مِن \"مُخرَجاتِ الحِوارْ\"",11,"ر",1,0],["وكيلا أستحيل إلى نحيبٍ","أقومُ بنسج إحساس بليد",12,"د",1,0]]}