{"poems":[[55,"يا قلب ليتك حين لم تدع الهوى","https://www.aldiwan.net/poem29918.html","الكامل"],[59,"إني صحبت الناس ما لهم عدد","https://www.aldiwan.net/poem24705.html","البسيط"],[90,"أصبحت أوسعهم لوما وتثريبا","https://www.aldiwan.net/poem44832.html","البسيط"],[93,"أنا لست بالحسناء أول مولع","https://www.aldiwan.net/poem8980.html","عموديه"],[33,"عوجا نحي الطلل المحولا","https://www.aldiwan.net/poem41853.html","السريع"],[107,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[41,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[41,"إني صرمت من الصبا آرابي","https://www.aldiwan.net/poem53815.html","الكامل"],[50,"إني صرفت الهوى إلى قمر","https://www.aldiwan.net/poem63314.html","المنسرح"],[50,"يزيد ماذا دهاكا","https://www.aldiwan.net/poem64487.html","المجتث"],[48,"إن يصحب الروح عقلي بعد مظعنها","https://www.aldiwan.net/poem22120.html","البسيط"],[48,"دنياك تشبه ناضحا متردا","https://www.aldiwan.net/poem22575.html","الكامل"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72205","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54557","الكامل"],[108,"انتصار الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179290",""],[108,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[59,"إني صحبت أناس ما لهم عدد","https://www.poetsgate.com/ViewPoem.aspx?id=3403",""],[20,"أرواح مودع أم بكور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69771&r=&rc=12",""],[119,"قسما بأيام اللقا وبسر ما","https://www.aldiwan.net/poem41486.html","الكامل"],[121,"جزائري","https://www.aldiwan.net/poem24036.html","الكامل"],[124,"كيف به والجفاء يبعد به","https://www.aldiwan.net/poem49347.html","المنسرح"],[128,"قالوا كبا جواده وما كبا","https://www.aldiwan.net/poem23744.html","الرجز"],[131,"ما هاجك اليوم من رسم وأطلال","https://www.aldiwan.net/poem24261.html","البسيط"],[193,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[302,"عارضه السندسي من رقمه","https://www.aldiwan.net/poem33169.html","المنسرح"],[371,"عذاره قد سبى طرفي تطرفه","https://www.aldiwan.net/poem17035.html","البسيط"],[396,"لأنها اوزار فيها الضرر والأضرار","https://www.aldiwan.net/poem54523.html","عموديه"],[409,"مولاي خذ نشر الذي طويته","https://www.aldiwan.net/poem34102.html","الرجز"],[422,"يا إماما في الدين والمذهب الحق","https://www.aldiwan.net/poem54104.html","الخفيف"],[443,"لك ذروة المجد الذي لا يرتقى","https://www.aldiwan.net/poem2535.html","الكامل"],[445,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[466,"سألت ربي ورب الناس كلهم","https://www.aldiwan.net/poem15430.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138418",""],[609,"","https://poetry.dctabudhabi.ae/diwan/poem/198617","البسيط"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66673","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48671","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64001","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77650","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77498","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70955","الخفيف"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126119","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79967","البسيط"],[1762,"","https://poetry.dctabudhabi.ae/diwan/poem/89628","السريع"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87856","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69401","الكامل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96029","البسيط"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121911","الكامل"],[2384,"","https://poetry.dctabudhabi.ae/diwan/poem/123651","الكامل"],[2391,"","https://poetry.dctabudhabi.ae/diwan/poem/18049","الكامل"],[2598,"","https://poetry.dctabudhabi.ae/diwan/poem/17379","الكامل"],[345,"","https://poetry.dctabudhabi.ae/diwan/poem/124712","الكامل"],[3015,"","https://poetry.dctabudhabi.ae/diwan/poem/199457","الكامل"],[3031,"","https://poetry.dctabudhabi.ae/diwan/poem/22549","الرجز"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65369","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74043","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110091","السريع"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66533","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135517","الرمل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135767","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94612","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94325","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94327","البسيط"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35047","الرمل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83549","السريع"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33451","البسيط"],[4674,"سعوا لنيل العلا","https://www.poetsgate.com/ViewPoem.aspx?id=210593",""],[585,"لم يغن تحذير ولا إغراء","https://www.poetsgate.com/ViewPoem.aspx?id=161847",""],[585,"هل في القطين وراء المنش مستمع","https://www.poetsgate.com/ViewPoem.aspx?id=161904",""],[5216,"المارد المصري","https://www.poetsgate.com/ViewPoem.aspx?id=186819",""],[5216,"ابني إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=187638",""],[5219,"تشطير أبيات الأخطل الصغير","https://www.poetsgate.com/ViewPoem.aspx?id=194987",""],[5277,"رَبْح..أم الخير","https://www.poetsgate.com/ViewPoem.aspx?id=191819",""],[5299,"لا تلعبي في الحب","https://www.poetsgate.com/ViewPoem.aspx?id=210539",""],[5351,"موعد التغيير","https://www.poetsgate.com/ViewPoem.aspx?id=202232",""],[5410,"دٌّ على موغل في الزيفِ والعدم","https://www.poetsgate.com/ViewPoem.aspx?id=140754",""],[5431,"عشقٌ بكليَّ قد ظفر !","https://www.poetsgate.com/ViewPoem.aspx?id=184890",""],[5449,"موسوعةُ الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=188935",""],[5899,"داليا","https://www.poetsgate.com/ViewPoem.aspx?id=31373",""],[5948,"قُل للأميرِ الذي يرجو نوافَله","https://www.poetsgate.com/ViewPoem.aspx?id=100580",""],[5956,"الشعر يعجز أن يعلو إلى القممِ","https://www.poetsgate.com/ViewPoem.aspx?id=210476",""],[4442,"يبدو الشباب بشكل الخرد العين","https://www.poetsgate.com/ViewPoem.aspx?id=171001",""],[6189,"شهادة حياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83554&r=&rc=21",""],[6266,"الحب والسور العالي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82752&r=&rc=0",""]],"verses":[["إِن يُصبِحوا صاحينَ مِن خَمرِ الهَوى","فَلَقَد سَقَوكَ مِنَ الغَرامِ دِراكا",0,"ك",2,0],["إِنّي صَحِبتُ الناسَ ما لَهُم عَدَدُ","وَكُنتُ أَحسَبُ أَنَّي قَد مَلَأتُ يَدي",1,"د",2,1],["أن يصدُقوا أنهم لا يلبسون سوى","محض النصيحة في الدعوى الجلابيبا",2,"ب",2,0],["إِنّي صَرَفتُ عَنِ الطَماعَةِ وَالهَوى","قَلبي وَلا ظُفرٌ لِمَن لَم يَطمَعِ",3,"ع",1,0],["إِن يُصبِحَ المَنزِلُ مِن أَهلِهِ","وَحشاً مَغاني رَسمِهِ مُمحِلا",4,"ل",2,0],["إنّي صَدقتكمُ البلاغَ لِتعلموا","وجبالُ مَكّةَ شُهّدٌ والأبطُحُ",5,"ح",1,0],["إِن يُصِب صَيداً يَكُن جُلُّهُ","لِعجايا قوتُهُم بِاللِحام",6,"م",1,0],["إِنّي صَرَمتُ مِنَ الصَبا آرابي","وَسَلَوتُ بَعدَ تَعِلَّةٍ وَتَصابي",7,"ب",2,1],["إِنّي صَرَفتُ الهَوى إِلى قَمَرٍ","لا يَتَحَدّى العُيونَ بِالنَظَرِ",8,"ر",1,1],["أَن يَصفِناكَ عَلى أَر","بَعٍ وَأَن يُبرِكاكا",9,"ك",2,0],["إِن يَصحَبِ الروحَ عَقلي بَعدَ مَظعَنِها","لِلمَوتِ عَنِّيَ فَأَجدِر أَن تَرى عَجَبا",10,"ب",2,1],["إِن يَصغُروا أَو يَعظُموا فَبِقُدرَةٍ","وَلِرَبِّنا الإِعظامُ وَالإِكبارُ",11,"ر",1,0],["إنْ يُصدِروا الأَمْرَ تُطلِعْهُ مَوارِدُهُ","أَو يُورِدُوا الأَمْرَ تُحْلِلْهُ بإصْدارِ",12,"ر",1,0],["إِنِّي صَدَقْتُهُمُ المَديحَ بِمَا بِهِمْ","وَأقُولُ شَرُّ الشِّعْرِ شِعْرُ الْكَاذِبِ",13,"ب",1,0],["إن يصدقوا فالسّلم، أَو","فالسَّيف إن كذَبَتْ سجاح",14,"ح",1,0],["إن يصفْ للعيون إيوان كسرى","لمحَتْ صخر ركنه المهدودِ",15,"د",1,0],["إني صحبت أناس ما لهم عدد","وكنت أحسب إني قد ملأت يدي",16,"ي",1,1],["إِن يُصِبني بَعضُ الهَناتِ فَلا وا","نٍ ضَعيفٌ وَلا أَكَبُّ عَثورُ",17,"ر",1,0],["إني صديق صديقها ومحبها","أبداً وإن عاداني الثقلان",18,"ن",1,0],["إنّي صَبَرْتُ وفي التَّصَبُّرِ ذِلَّةٌ","مازلتُ أَطْمَعُ في ثَوابِ الصَّابِرِ",19,"ر",1,0],["إن يصغ للشوق بعد ذاك فقد","أسرف في كبره وفي غضبه",20,"ب",2,0],["أن يصفعن ويضربا","فشرقوا وغربا",21,"ب",2,0],["إِنّي صَبورٌ عَلى ما نابَ مُعتَرِفٌ","أُصَرِّفُ الأَمرَ مِن حالٍ إِلى حالِ",22,"ل",1,0],["أَن يَصطفوا لأجلهِ النساءَ","وَينكحوا الكرائمَ الأكفاءَ",23,"ا",2,0],["إِن يُصغ يوماً إليه ذو صَمَمٍ","أَزالَ عنه بلطفه صَمَمه",24,"م",2,0],["إِن يُصبِحِ الوَردُ لا يُغري الغَرامَ بِهِ","ضَعيفُهُ فبما أَغراهُ مُضعَفُهُ",25,"ف",2,0],["إن يصلح الشان","يكفي حاسدي والشان",26,"ن",1,0],["إن يصلح المبرد منه عوجاً","فقبله بالنشر قد أحييته",27,"ت",2,0],["إنْ يصادفْ منك القبول فقد","فازَ وثَمَّ الإِسعاد والإِقبال",28,"ل",1,0],["أنى صلتّ يراعة للكتابة","تثني الكتائب هاربا أو مصعقا",29,"ق",2,0],["إِنْ يُصْدِهِ رَهَجُ الوغى فَشُعاعُهُ","بالعِلْمِ لَمَّاعُ الجِلاءِ صَقِيلُهُ",30,"ل",2,0],["أن يصرف السوء عن حوباءِ محتمل","أوْقَ المكارمِ تحلو عندهُ النِّعمُ",31,"م",1,0],["ان يصنع الآيات سعد فهي كي","تدروا بان الله عنكم ما ونا",32,"ن",2,0],["إن يصدق البشر إلا عند طلعته","فالبدر أصدق نورا وهو مكتمل",33,"ل",1,0],["إن يصدُقوك فلن يَعدوا أبا حسنٍ","إنْ أنت لم تلقَ للأبرارِ حُسَّادا",34,"د",2,0],["إني صبرت على الجهاد وطالما","بلغ المدى بعد الجهاد صبور",35,"ر",1,0],["إن يَصْطَنِعْهُ على اختيارٍ","منك فما ضاعَ الاصْطِناع",36,"ع",1,0],["إِني صَغيرٌ يا اِبنَ ودي جدّا","لَم أغن مِن جوعٍ لِمَن تَغدّى",37,"د",2,0],["إِني صَغيرة وَلَستُ أُغني","يَوماً مِن الجُوع لِمَن يمضُغُني",38,"ي",1,0],["إن يُصْبني اللئيم يوما ولو بالما","ء عمداً أصبتُه بالشُّواظ",39,"ظ",1,0],["إن يصحبوكم يصحبوكم لغرض","منافقون في قلوبهم مرض",40,"ض",1,0],["إن يُصدِ نقص أناسٍ فكرَ مادحهم","ففضلكم صقيلُ الألباب والفكر",41,"ر",1,0],["إِن يَصدِفِ الأَترابُ عنّي فَقَد","أَخدَع مثلَ الرَشأِ الأَكحَلِ",42,"ل",1,0],["إِن يَصبُ غَيري فَإِنّي ما صَبَوتُ إِلى","عَهدِ النَجائِبِ وَالوَخّادَةِ النُزُرِ",43,"ر",1,0],["إِن يَصدُقُوا فَسُيُوفُ مَن تَرَكتُهُمُ","صَرعى تَهُزُّهُمُ النُسُورُ الحُوَّمُ",44,"م",1,0],["ان يصبح الكون داجي اللون بعدك","والايام سوداً وحسن الدهر مستلب",45,"ب",1,0],["ان يصغ يوما للوشاة بسمعه","فاصبر وصبرك للنوائب أنفع",46,"ع",1,0],["أني صرفت لقصد بابك وجهتي","باب إذا ما أمه ذو لوعة",47,"ه",1,0],["إِنّي صَرَمتُهُمُ وَما صَرَموا","لا بَل لِكُلِّ إِخائِهِم دَخلُ",48,"ل",1,0],["إِنّي صَدَقتُكَ إِذ وَجَدتُكَ كاذِباً","وَكَذَبتَني فَوَجَدتَني كَذّابا",49,"ب",2,0],["إن يُصبِني ذكِرُ الديار فإنه","لإناث أصبية بها وذكورِ",50,"ر",1,0],["إن يصبح الفضل القتيل فإنني","أمسيت من كمد عليه قتيلا",51,"ل",2,0],["إِنّي صَبَحتُ حَمَلَ بنِ كوزِ","عُلالَةً في وَكَرى أَبوزِ",52,"ز",1,1],["إن يصطحب في الورى ذيابٌ","قطاطة ما به ارتيابُ",53,"ب",1,1],["إِنّي صحبتُ رِجالَهُم","وَخبرتهُم عند الكرب",54,"ب",1,0],["ان يَصمُتوا فالخُبثُ في طَيِّهم","وان رَوَوا يوماً فهم آفِكُون",55,"ن",1,0],["إنْ يَصْعَدِ الْجَوَّ ناشَتْهُ خَواطِفَهُ","أوْ يَهْبِطِ الأرْضَ غالَتْهُ كَواسِرُهُ",56,"ر",2,0],["إن يصل يقصر وحيث","عنك ينأى جاء طولهْ",57,"ه",1,0],["أن يصرف البلاء عنا والوباءْ","وأن يوالي لنا منه العطاءْ",58,"ا",2,0],["إنّي صدوقٌ ما أنا بمماذِقٍ","دأبي على غير الصداقة لن يُرى",59,"ر",2,0],["إنّي صديقٌ صادقٌ بمودَّتي","ومحكّمٌ في عاتقي لكم العرى",59,"ر",2,0],["إني صَبورٌ ولا أرتاد من ضجرٍ","دأبي ومن شيمتي للنفس إصبارُ",60,"ر",1,0],["إني صَبورٌ على كيد الزَمان وهل","يضيع صَبرٌ وعون اللَه نصرتُهُ",61,"ت",2,0],["إِن يُصِب منّا قعيداً","هبّ كالجسمِ المُكَهرب",62,"ب",1,0],["إِن يُصلِح الرحمنُ ما بَينَنا","تَغدو إِذاً قُوَّتُنا قُوَّتَينِ",63,"ن",1,0],["إن يُصبياني فإنَّ ماءً","سقاهُ من وردِ وجنتيكا",64,"ك",2,0],["إنْ يصدَحِ العلمُ فالآذانُ صاغيةٌ","ويَعتريها عن المهذارةِ الصَّممُ",65,"م",1,0],["إني صرخت فلم يكن إلا صدى","مرت به الأرياح والأنواء",66,"ا",2,0],["إن يصلبوكم ويغزوكم فلا حرجٌ","فالحب يغفر إصر القوم والولع",67,"ع",1,0],["إنْ يَصْبِرْ قُلْ ما أحْلَمَهُ","أو ثارَ فَقُلْ ما أَعْظَمَهُ",68,"م",2,0],["إن يصْحو حُلْوًا لاعَبَهُ","ويُجَدِّدُ حُلْمًا ناجاهُ",69,"ا",2,0],["أني صريع الهوى والشعر يشهد لي ...","لكنت أرفق من آسى ومن صفحا",70,"ح",2,0],["إني صديٌّ وبئرُ الشهدِ طافحةٌ","مالي إليهِ سبيلٌ بالهوى يصلُ",71,"ل",1,0],["إني صبرتُ على عذابي في الهوى","وجرعتُ من بلواه ما لم تجرعي",72,"ع",2,0],[