{"poems":[[53,"يا قلب ليتك حين لم تدع الهوى","https://www.aldiwan.net/poem29918.html","الكامل"],[57,"إني صحبت الناس ما لهم عدد","https://www.aldiwan.net/poem24705.html","البسيط"],[88,"أصبحت أوسعهم لوما وتثريبا","https://www.aldiwan.net/poem44832.html","البسيط"],[91,"أنا لست بالحسناء أول مولع","https://www.aldiwan.net/poem8980.html","عموديه"],[31,"عوجا نحي الطلل المحولا","https://www.aldiwan.net/poem41853.html","السريع"],[105,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[39,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[39,"إني صرمت من الصبا آرابي","https://www.aldiwan.net/poem53815.html","الكامل"],[48,"إني صرفت الهوى إلى قمر","https://www.aldiwan.net/poem63314.html","المنسرح"],[48,"يزيد ماذا دهاكا","https://www.aldiwan.net/poem64487.html","المجتث"],[46,"إن يصحب الروح عقلي بعد مظعنها","https://www.aldiwan.net/poem22120.html","البسيط"],[46,"دنياك تشبه ناضحا متردا","https://www.aldiwan.net/poem22575.html","الكامل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72205","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54557","الكامل"],[106,"انتصار الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179290",""],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[57,"إني صحبت أناس ما لهم عدد","https://www.poetsgate.com/ViewPoem.aspx?id=3403",""],[20,"أرواح مودع أم بكور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69771&r=&rc=12",""],[116,"قسما بأيام اللقا وبسر ما","https://www.aldiwan.net/poem41486.html","الكامل"],[118,"جزائري","https://www.aldiwan.net/poem24036.html","الكامل"],[121,"كيف به والجفاء يبعد به","https://www.aldiwan.net/poem49347.html","المنسرح"],[125,"قالوا كبا جواده وما كبا","https://www.aldiwan.net/poem23744.html","الرجز"],[128,"ما هاجك اليوم من رسم وأطلال","https://www.aldiwan.net/poem24261.html","البسيط"],[190,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[298,"عارضه السندسي من رقمه","https://www.aldiwan.net/poem33169.html","المنسرح"],[367,"عذاره قد سبى طرفي تطرفه","https://www.aldiwan.net/poem17035.html","البسيط"],[392,"لأنها اوزار فيها الضرر والأضرار","https://www.aldiwan.net/poem54523.html","عموديه"],[404,"مولاي خذ نشر الذي طويته","https://www.aldiwan.net/poem34102.html","الرجز"],[417,"يا إماما في الدين والمذهب الحق","https://www.aldiwan.net/poem54104.html","الخفيف"],[438,"لك ذروة المجد الذي لا يرتقى","https://www.aldiwan.net/poem2535.html","الكامل"],[440,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[462,"سألت ربي ورب الناس كلهم","https://www.aldiwan.net/poem15430.html","البسيط"]],"verses":[["إِن يُصبِحوا صاحينَ مِن خَمرِ الهَوى","فَلَقَد سَقَوكَ مِنَ الغَرامِ دِراكا",0,"ك",2,0],["إِنّي صَحِبتُ الناسَ ما لَهُم عَدَدُ","وَكُنتُ أَحسَبُ أَنَّي قَد مَلَأتُ يَدي",1,"د",2,1],["أن يصدُقوا أنهم لا يلبسون سوى","محض النصيحة في الدعوى الجلابيبا",2,"ب",2,0],["إِنّي صَرَفتُ عَنِ الطَماعَةِ وَالهَوى","قَلبي وَلا ظُفرٌ لِمَن لَم يَطمَعِ",3,"ع",1,0],["إِن يُصبِحَ المَنزِلُ مِن أَهلِهِ","وَحشاً مَغاني رَسمِهِ مُمحِلا",4,"ل",2,0],["إنّي صَدقتكمُ البلاغَ لِتعلموا","وجبالُ مَكّةَ شُهّدٌ والأبطُحُ",5,"ح",1,0],["إِن يُصِب صَيداً يَكُن جُلُّهُ","لِعجايا قوتُهُم بِاللِحام",6,"م",1,0],["إِنّي صَرَمتُ مِنَ الصَبا آرابي","وَسَلَوتُ بَعدَ تَعِلَّةٍ وَتَصابي",7,"ب",2,1],["إِنّي صَرَفتُ الهَوى إِلى قَمَرٍ","لا يَتَحَدّى العُيونَ بِالنَظَرِ",8,"ر",1,1],["أَن يَصفِناكَ عَلى أَر","بَعٍ وَأَن يُبرِكاكا",9,"ك",2,0],["إِن يَصحَبِ الروحَ عَقلي بَعدَ مَظعَنِها","لِلمَوتِ عَنِّيَ فَأَجدِر أَن تَرى عَجَبا",10,"ب",2,1],["إِن يَصغُروا أَو يَعظُموا فَبِقُدرَةٍ","وَلِرَبِّنا الإِعظامُ وَالإِكبارُ",11,"ر",1,0],["إنْ يُصدِروا الأَمْرَ تُطلِعْهُ مَوارِدُهُ","أَو يُورِدُوا الأَمْرَ تُحْلِلْهُ بإصْدارِ",12,"ر",1,0],["إِنِّي صَدَقْتُهُمُ المَديحَ بِمَا بِهِمْ","وَأقُولُ شَرُّ الشِّعْرِ شِعْرُ الْكَاذِبِ",13,"ب",1,0],["إن يصدقوا فالسّلم، أَو","فالسَّيف إن كذَبَتْ سجاح",14,"ح",1,0],["إن يصفْ للعيون إيوان كسرى","لمحَتْ صخر ركنه المهدودِ",15,"د",1,0],["إني صحبت أناس ما لهم عدد","وكنت أحسب إني قد ملأت يدي",16,"ي",1,1],["إِن يُصِبني بَعضُ الهَناتِ فَلا وا","نٍ ضَعيفٌ وَلا أَكَبُّ عَثورُ",17,"ر",1,0],["إني صديق صديقها ومحبها","أبداً وإن عاداني الثقلان",18,"ن",1,0],["إنّي صَبَرْتُ وفي التَّصَبُّرِ ذِلَّةٌ","مازلتُ أَطْمَعُ في ثَوابِ الصَّابِرِ",19,"ر",1,0],["إن يصغ للشوق بعد ذاك فقد","أسرف في كبره وفي غضبه",20,"ب",2,0],["أن يصفعن ويضربا","فشرقوا وغربا",21,"ب",2,0],["إِنّي صَبورٌ عَلى ما نابَ مُعتَرِفٌ","أُصَرِّفُ الأَمرَ مِن حالٍ إِلى حالِ",22,"ل",1,0],["أَن يَصطفوا لأجلهِ النساءَ","وَينكحوا الكرائمَ الأكفاءَ",23,"ا",2,0],["إِن يُصغ يوماً إليه ذو صَمَمٍ","أَزالَ عنه بلطفه صَمَمه",24,"م",2,0],["إِن يُصبِحِ الوَردُ لا يُغري الغَرامَ بِهِ","ضَعيفُهُ فبما أَغراهُ مُضعَفُهُ",25,"ف",2,0],["إن يصلح الشان","يكفي حاسدي والشان",26,"ن",1,0],["إن يصلح المبرد منه عوجاً","فقبله بالنشر قد أحييته",27,"ت",2,0],["إنْ يصادفْ منك القبول فقد","فازَ وثَمَّ الإِسعاد والإِقبال",28,"ل",1,0],["أنى صلتّ يراعة للكتابة","تثني الكتائب هاربا أو مصعقا",29,"ق",2,0],["إِنْ يُصْدِهِ رَهَجُ الوغى فَشُعاعُهُ","بالعِلْمِ لَمَّاعُ الجِلاءِ صَقِيلُهُ",30,"ل",2,0],["أن يصرف السوء عن حوباءِ محتمل","أوْقَ المكارمِ تحلو عندهُ النِّعمُ",31,"م",1,0]]}