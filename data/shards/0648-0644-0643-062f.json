{"poems":[[93,"لو أستطيع كتبت بالنيران","https://www.aldiwan.net/poem62773.html","عموديه"],[93,"الحرب العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=53314",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122753","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81245","الكامل"]],"verses":[["وَلَكِدتُ أَستَحيِ القَئيضَ وَأَتَّقي","أَن يَستَريبَ يَراعَتي وَجَناني",0,"ن",2,0],["ولكدت استحي القريض وأتّقي","أن يستريب يراعتي وجناني",1,"ن",2,0],["وَلَكِدتَ إن تَرقى السَّماءَ بِسُلَّمٍ","لَو كانَ في أرضِ المَجَرَّةش سُلّمُ",2,"م",1,0],["وَلَكدت أَحسبها معاني قصرت","كلماً فَأَفرغها الهَوى في دور",3,"ر",1,0]]}