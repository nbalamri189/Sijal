{"poems":[[73,"هل عهدنا الشمس تعتاد الكلل","https://www.aldiwan.net/poem11918.html","الرمل"],[72,"من عذيري من الطلا والأغاني","https://www.aldiwan.net/poem20180.html","الخفيف"],[91,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[78,"أنا في الحب مغرم مستنيل","https://www.aldiwan.net/poem14255.html","الخفيف"],[85,"رضي المسلمون والإسلام","https://www.aldiwan.net/poem63740.html","الخفيف"],[45,"إنك والاحتفال في عذلي","https://www.aldiwan.net/poem65613.html","الخفيف"],[46,"ليذمم والدا ولد ويعتب","https://www.aldiwan.net/poem23172.html","الوافر"],[152,"خلال رحيل العمر","https://www.aldiwan.net/poem933.html",""],[221,"ما لي أرى القلب في عينيك يلتهب","https://www.aldiwan.net/poem41599.html","البسيط"],[456,"هل عند هذا الطلل الماحِلِ","https://www.aldiwan.net/poem55907.html","السريع"],[511,"يا أخي كم يكون هذا الجفاء","https://www.aldiwan.net/poem67799.html","الخفيف"],[560,"لمن الهوادج في عراء الهوجل","https://www.aldiwan.net/poem52887.html","الكامل"],[560,"بين رئم الحمى وآرام رامه","https://www.aldiwan.net/poem52971.html","الخفيف"]],"verses":[["لِيَ ذِكرٌ بِالَّذي أَسدَيتَهُ","نابِهٌ وَدَّ حَسودٌ لَو خَمَل",0,"ل",1,0],["ليَ ذكر سارٍ بودك في الخل","قِ فلو لم تجد عليّ كفاني",1,"ن",2,0],["لِيَ ذاتٌ غَيرَ أَنّي لَستُ أَدري ماهِيَه","فَمَتى تَعرِفُ ذاتي كَنَهُ ذاتي لَستُ أَدري",2,"ي",1,0],["ليَ ذِهنٌ مِثلَ الحُسامِ صَقيلُ","هُوَ مِن كَثرَةِ التَجَنّي فَليلُ",3,"ل",1,0],["لَيَذوقُنَّ لِلمُهَلهِلِ صَحواً","تَشرُفُ الكَأسُ عِندَهُ وَالمُدامُ",4,"م",1,0],["لِيَذهَبَ الغَيُّ حَيثُ طَيَّتُهُ","ما سُبُلُ الغِيِّ بَعدُ مِن سُبُلي",5,"ل",2,0],["لِيَذمُم والِداً وَلَدٌ وَيَعتُب","عَلَيهِ فَبِئسَ عَمري ما سَعى لَه",6,"ل",2,1],["ليذيعها في غابة غزلانه","مثلي تخاف معابر الأوهامِ",7,"م",1,0],["لي ذِكرياتٌ كَأَخلاقي تُؤَدِّبُني","فَلا يُخالِجُني رَوغ وَلا كَذِبُ",8,"ب",1,0],["لي ذلّةُ السائلِ ما بينكم","فلا تفتْكم عزّةُ الباذلِ",9,"ل",1,0],["لي ذنوب ولست أنكر فاغفر","فالتجني على المقر اعتداء",10,"ا",2,0],["لي ذاتُ خِدرٍ بَينَهُنَّ أنا لَها","وأوَدُّ لو رَضِيَتْ فقالتْ أنتَ لي",11,"ل",2,0],["لِيَ ذُلٌّ أقامَ عِزّاً لديهِ","ذُلُّ نفسٍ لعِزِّ نفسٍ إِقامَهْ",12,"م",2,0]]}