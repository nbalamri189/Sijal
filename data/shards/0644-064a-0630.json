{"poems":[[75,"هل عهدنا الشمس تعتاد الكلل","https://www.aldiwan.net/poem11918.html","الرمل"],[74,"من عذيري من الطلا والأغاني","https://www.aldiwan.net/poem20180.html","الخفيف"],[93,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[80,"أنا في الحب مغرم مستنيل","https://www.aldiwan.net/poem14255.html","الخفيف"],[87,"رضي المسلمون والإسلام","https://www.aldiwan.net/poem63740.html","الخفيف"],[47,"إنك والاحتفال في عذلي","https://www.aldiwan.net/poem65613.html","الخفيف"],[48,"ليذمم والدا ولد ويعتب","https://www.aldiwan.net/poem23172.html","الوافر"],[158,"خلال رحيل العمر","https://www.aldiwan.net/poem933.html",""],[228,"ما لي أرى القلب في عينيك يلتهب","https://www.aldiwan.net/poem41599.html","البسيط"],[463,"هل عند هذا الطلل الماحِلِ","https://www.aldiwan.net/poem55907.html","السريع"],[518,"يا أخي كم يكون هذا الجفاء","https://www.aldiwan.net/poem67799.html","الخفيف"],[567,"لمن الهوادج في عراء الهوجل","https://www.aldiwan.net/poem52887.html","الكامل"],[567,"بين رئم الحمى وآرام رامه","https://www.aldiwan.net/poem52971.html","الخفيف"],[786,"","https://poetry.dctabudhabi.ae/diwan/poem/142315","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63882","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70907","الخفيف"],[966,"","https://poetry.dctabudhabi.ae/diwan/poem/146412","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108788","الكامل"],[2242,"","https://poetry.dctabudhabi.ae/diwan/poem/216396",""],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121199","البسيط"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121194","البسيط"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116499","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62897","الكامل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66572","السريع"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111520","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136747",""],[4626,"","https://poetry.dctabudhabi.ae/diwan/poem/102880","الخفيف"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204227","الكامل"],[585,"من مهبط الوحي حول البيت والحرم","https://www.poetsgate.com/ViewPoem.aspx?id=161898",""],[5072,"كفى هوساً","https://www.poetsgate.com/ViewPoem.aspx?id=52569",""],[5226,"القدس .. في القلب","https://www.poetsgate.com/ViewPoem.aspx?id=24251",""],[5431,"الطاغية ....","https://www.poetsgate.com/ViewPoem.aspx?id=205781",""],[5616,"يا قدس","https://www.poetsgate.com/ViewPoem.aspx?id=205249",""],[5725,"اشتاقها","https://www.poetsgate.com/ViewPoem.aspx?id=203717",""],[5776,"بثينة","https://www.poetsgate.com/ViewPoem.aspx?id=199379",""],[5829,"انت الشآم","https://www.poetsgate.com/ViewPoem.aspx?id=150260",""],[6102,"أَ...هَرِمنا؟!","https://www.poetsgate.com/ViewPoem.aspx?id=186308",""],[6117,"تُمِّمَتْ أخْلاَقُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=182796",""],[158,"خلال رحيل العمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84688&r=&rc=12",""]],"verses":[["لِيَ ذِكرٌ بِالَّذي أَسدَيتَهُ","نابِهٌ وَدَّ حَسودٌ لَو خَمَل",0,"ل",1,0],["ليَ ذكر سارٍ بودك في الخل","قِ فلو لم تجد عليّ كفاني",1,"ن",2,0],["لِيَ ذاتٌ غَيرَ أَنّي لَستُ أَدري ماهِيَه","فَمَتى تَعرِفُ ذاتي كَنَهُ ذاتي لَستُ أَدري",2,"ي",1,0],["ليَ ذِهنٌ مِثلَ الحُسامِ صَقيلُ","هُوَ مِن كَثرَةِ التَجَنّي فَليلُ",3,"ل",1,0],["لَيَذوقُنَّ لِلمُهَلهِلِ صَحواً","تَشرُفُ الكَأسُ عِندَهُ وَالمُدامُ",4,"م",1,0],["لِيَذهَبَ الغَيُّ حَيثُ طَيَّتُهُ","ما سُبُلُ الغِيِّ بَعدُ مِن سُبُلي",5,"ل",2,0],["لِيَذمُم والِداً وَلَدٌ وَيَعتُب","عَلَيهِ فَبِئسَ عَمري ما سَعى لَه",6,"ل",2,1],["ليذيعها في غابة غزلانه","مثلي تخاف معابر الأوهامِ",7,"م",1,0],["لي ذِكرياتٌ كَأَخلاقي تُؤَدِّبُني","فَلا يُخالِجُني رَوغ وَلا كَذِبُ",8,"ب",1,0],["لي ذلّةُ السائلِ ما بينكم","فلا تفتْكم عزّةُ الباذلِ",9,"ل",1,0],["لي ذنوب ولست أنكر فاغفر","فالتجني على المقر اعتداء",10,"ا",2,0],["لي ذاتُ خِدرٍ بَينَهُنَّ أنا لَها","وأوَدُّ لو رَضِيَتْ فقالتْ أنتَ لي",11,"ل",2,0],["لِيَ ذُلٌّ أقامَ عِزّاً لديهِ","ذُلُّ نفسٍ لعِزِّ نفسٍ إِقامَهْ",12,"م",2,0],["لي ذكريات في ربوعهم","هنّ الحياة تألقاً وسنا",13,"ن",2,0],["ليذودَ الإفلاسَ عنِّيَ حتى","أغتدي مُفْلِساً من الإفلاس",14,"س",1,0],["لي ذنوبٌ لو عُدَّ منها القليل","في حديث لَما حَوَتْهُ العقولُ",15,"ل",1,1],["لي ذنوبٌ تصيح منها السموا","تُ وكادتْ منها الجبالُ تزول",15,"ل",1,0],["ليذهبوا في ملامي أيةً ذهبوا","في الخمر لا فضةً تبقى ولا ذهب",16,"ب",1,1],["ليذود عني علةً","أرسى وأرسخ من جبالك",17,"ك",1,0],["لي ذكرت الوقت لي زَلّي","والصِّبا يوم انقضى سُونه",18,"ن",2,0],["لي ذمة منك اني مادح حسن","ولي حسين لدى الاهوال معتمد",19,"د",1,0],["لي ذمة منه يدعى من محاسنه","كذاك شعري به بالمفرد العلم",20,"م",1,0],["لي ذمة حفظ الاله عهودها","من أن تحل برغم بعض أنوف",21,"ف",1,0],["لي ذمةٌ عَقَدَتْ شرئِطُها","أَلا يَمُرّ بمهجَتي وَجَلُ",22,"ل",1,0],["لِيْ ذَهَبُ الشِّعرِ الَّذِي كُلَّما","قُلِّبِ فِي نِيرانِهِمْ يِزْدَدِ",23,"د",1,0],["ليذهب إلى الأسطول هكطور يفتدي","وآخيل يسترضي وبالغر يتحف",24,"ف",1,0],["لي ذلُّ الهوى وعزُّ الجمال","لك يا مائساً ببرد الدلال",25,"ل",1,1],["لي ذهن مثل الحسام صقيل","وهو من كثرة التجني قليل",26,"ل",1,0],["لي ذمة محفوظة في ضمنها","ووثائق محروسة في كفلها",27,"ل",3,0],["لي ذمةٌ فيه لو أني طلبت بها","رد الشباب لسلتني من الهرم",28,"م",1,0],["لِيذكرَني ارتحالي عن أناسي","كنهر ٍ فرّقتُه ُ يد ُ الفروع ِ",29,"ع",1,0],["لي ذكرياتٌ لي أمانٍ لي رؤىً","لي فيكِ غاليتي .. صِباً وشبابُ",30,"ب",1,0],["ليذبحني غرورك إذْ يُضحّي","ويسلخ من شعوريََ للدباغِ!!",31,"غ",1,0],["لي ذكرياتٌ بها ترتاح قافلَتي","ولي سفوحٌ إليها كم هفَوتُ أَنا!",32,"ن",2,0],["ليذوب دمعاً فجر مقلتها","في مرودٍ يغتالني كحلا",33,"ل",2,0],["‏لي ذكرياتي سأطهوها طعامَ غدي","‏وكفّ أمّي ستُلقِمُها فمي سهوا",34,"و",2,0],["ليذوب في عشق الشآم ولم يزل","للشام مرتهن وذاك عزائي",35,"ا",2,0],["لِيُذِيقَ خاصِرَتَيكَ حَربَتَهُ!","فَيَمُرَّ جَيشٌ ما, بِلا عَدَدِ!",36,"د",1,0],["ليذكرَ الناسُ معراجاً بهِ جَحَدوا","كأنهُ لم يكنْ في الأسرِ يحتضرُ",37,"ر",1,0],["ليذيعها في غابة غزلانها","مثلي تخاف معابر الأوهامِ",38,"م",1,0]]}