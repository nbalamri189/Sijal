{"poems":[[55,"من رأى أعينا حذفن","https://www.aldiwan.net/poem29625.html","مجزوء الخفيف"],[79,"خدع الشوق فؤادي فانخدع","https://www.aldiwan.net/poem35986.html","الرمل"],[74,"قل لوزير الشام يا من","https://www.aldiwan.net/poem18664.html","مخلع البسيط"],[74,"قل لوزير الملك يا من له","https://www.aldiwan.net/poem19192.html","السريع"],[74,"قل لوزير الملك يا من به","https://www.aldiwan.net/poem19201.html","السريع"],[72,"كم أناس أظهروا الزهد لنا","https://www.aldiwan.net/poem42695.html","الرمل"],[99,"قل لوزير الحق وهو الذي","https://www.aldiwan.net/poem24979.html","السريع"],[104,"بين ليلى وسعاد ومنى","https://www.aldiwan.net/poem33048.html","الرمل"],[69,"قل لولي الدولة المرتجى","https://www.aldiwan.net/poem18074.html","السريع"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141928","الخفيف"],[358,"قل لوحيد العصر سامي الفخار","https://www.aldiwan.net/poem40224.html","السريع"],[463,"كم النوى قد جزع الصابر","https://www.aldiwan.net/poem56172.html","السريع"],[520,"قل لولي الدولة اسمع فقد","https://www.aldiwan.net/poem12113.html","السريع"],[534,"قل لوادي الظهر حياه الحيا","https://www.aldiwan.net/poem37102.html","الرمل"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/124040","الخفيف"],[996,"","https://poetry.dctabudhabi.ae/diwan/poem/82243","الرمل"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82276","الخفيف"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107004","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94223","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89088","الخفيف"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126942","الرمل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126926","الرمل"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67659","المتقارب"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57987","البسيط"],[5120,"عَاصِفَه","https://www.poetsgate.com/ViewPoem.aspx?id=205364",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""]],"verses":[["قُل لِوادٍ عَلى الثَوِي","يَةِ حُيِّيتَ وادِيا",0,"ي",2,0],["قُلْ لَوادي الغَبْطِ هلْ منْ عوْدَةٍ","يصِلُ الأنْسُ لدَيْها ما قطَعْ",1,"ع",1,0],["قل لوزير الشام يا من","مد يدَ الجود للعباد",2,"د",1,1],["قل لوزير الملك يا من له","عزائم مثل الظُّبا تقطع",3,"ع",1,1],["قل لوزير الملك يا من به","تروي بلاد الشام عن نافع",4,"ع",1,1],["قَلَّلوا الأَكلَ وَأَبدَوا وَرَعاً","وَاِجتِهاداً في صِيامٍ وَقِيامِ",5,"م",1,0],["قل لوزير الحق وهو الذي","قد استقامت في حجاه الأمور",6,"ر",1,1],["قُل لِوَجه البَدر إِن قابلَتها","جاءَكَ الحُسن اِنعِكاساً مِن هُنا",7,"ن",2,0],["قُلْ لِوَلِيِّ الدَّوْلةِ المُرْتَجَى","والمُتَّقَى في الجُودِ والباسِ",8,"س",1,1],["قل لوكر النسور قدستَ وكرا","كل يوم تهدي إلى الأفق نسرا",9,"ر",2,1],["قُل لِوَحيد العَصر سامي الفَخار","منزّه الشيمة عَن كُلّ عار",10,"ر",1,1],["قل لوزير الوزراء التظَى","بعدك ذاك الولَهُ الفاترُ",11,"ر",1,0],["قل لولي الدولة اسمع فقد","ضيقت صدر النظم والنثر",12,"ر",1,1],["قُلْ لِوادِي الظَّهْرِ حَيَّاهُ الْحَيا","أَنْتَ قد أذكَرْتَنا جَنّاتِ عَدْنِ",13,"ن",1,1],["قلّ لو كان نافعا فيه منّا","بعد شق الجيوب لطمُ الخدود",14,"د",1,0],["قُل لِوالي العَهدِ إن لاقَيتَهُ","وَوَلِيُّ العَهدِ أَولى بِالرَّشَد",15,"د",1,1],["قُل لِوَجهِ الخَصِيِّ ذي العارِ إِنّي","سَوفَ أُهدي لِزَينَبَ الأَشعارا",16,"ر",2,1],["قلل وكثر ما تشا يا عاذلي","فيه فما في الحب شأنك شاني",17,"ن",2,0],["قل لوالي ديار مصر المفدى","بأبي الحظ أنت في الملك كنيت",18,"ت",1,1],["قل لوجدي عليه ما عشت أرخ","أحمد خادمي توفي حميدا",19,"د",2,0],["قل لوالي الامر قد مات الفرات","وندى كفيك في الست الجهات",20,"ت",1,1],["قل لو أنا نديب المهجا","جزعاً فيها ووجداً وشجا",21,"ج",2,0],["قل لوهب البغيض يا وَخِشَ الخل","قة يا ناطقاً بغير لسانِ",22,"ن",1,1],["قل لو قدرتُ ملأتُ الأرض أجمعها","عدلاً جوانبُها في كل أوقات",23,"ت",1,0],["قُلْ: لَوْ تَرَاكَ، وَأَنْتَ تَلْبَسُ مَا يَقِي","مِنْهَا، وَأَنْتَ تُعَانِقُ الْأَشْجَارَا",24,"ر",2,0],["قللو العَجايب يا اِبن عَمي الَّتي جَرَت","عَلَينا عَسى المَولى يُفرج شجونها",25,"ن",3,0]]}