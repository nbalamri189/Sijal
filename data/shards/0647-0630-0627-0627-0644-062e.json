{"poems":[[55,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[87,"فلوس الشغل ما تأخير","https://www.aldiwan.net/poem7900.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39627","السريع"],[107,"كم دون مية من عينٍ أحاذرها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54907&r=&rc=77",""],[189,"هذا الخليج فمرحبا بزمانه","https://www.aldiwan.net/poem14669.html","الكامل"],[449,"دع عنك صهباء الدساكر","https://www.aldiwan.net/poem56047.html","عموديه"],[470,"يا صبر أيوب","https://www.aldiwan.net/poem36227.html","عموديه"],[558,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[558,"يا أيها المعمود","https://www.aldiwan.net/poem68407.html","مجزوء الرجز"],[567,"نادى حمى الملك حسبي عزة وكفى","https://www.aldiwan.net/poem52828.html","البسيط"],[567,"أسفا على أسف وليس بمنكر","https://www.aldiwan.net/poem52942.html","الكامل"],[567,"شوقي إليك كما علمت طويل","https://www.aldiwan.net/poem52957.html","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87200","البسيط"],[1579,"","https://poetry.dctabudhabi.ae/diwan/poem/198787","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108515","البسيط"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52062","الكامل"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95177","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27199","البسيط"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47128","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65949","البسيط"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65994","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94296","الرجز"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122467","البسيط"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107056","الكامل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108409",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108358",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108354",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108363",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91189","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91195","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86531","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77163","الكامل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44717","الكامل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101375","البسيط"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78244","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123486","الكامل"],[4718,"عديت في عالي طويل المراقيب","https://www.poetsgate.com/ViewPoem.aspx?id=137297",""],[4987,"ترجل الفارس","https://www.poetsgate.com/ViewPoem.aspx?id=49568",""],[5376,"دع عنك شعرا بما هيجته أدبا","https://www.poetsgate.com/ViewPoem.aspx?id=189134",""],[5431,"للبردوني ..في يوم ذكراه","https://www.poetsgate.com/ViewPoem.aspx?id=199645",""],[5444,"راية الأمجاد","https://www.poetsgate.com/ViewPoem.aspx?id=209112",""],[5628,"السماء القاتمة","https://www.poetsgate.com/ViewPoem.aspx?id=178511",""],[5956,"صلواتٌ في ذكرى الخليل بن أحمد الفراهيدي","https://www.poetsgate.com/ViewPoem.aspx?id=215185",""],[6093,"خريف","https://www.poetsgate.com/ViewPoem.aspx?id=197064",""],[6142,"من مبلغ أكثر الأصحاب معذلتي","https://www.poetsgate.com/ViewPoem.aspx?id=155745",""],[6145,"من نحن ؟","https://www.poetsgate.com/ViewPoem.aspx?id=7794",""],[5309,"هذا الخلود فإن بلغت محله","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573742",""],[6234,"الدوحة الشاعرة المحتضرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6536&r=&rc=3",""],[6256,"الجلاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65927&r=&rc=15",""],[2220,"هذا الخليفة هذا السيدُ العلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11730&r=&rc=600",""]],"verses":[["هَذا الخَليفَةُ لا يَغُضُّ عَنِ الهُدى","إِن نامَ لَيلُ القائِمِ المُتَبَتِّلِ",0,"ل",1,0],["هذا الخلاصة يا أميرة فاسمعي","لي بالقراريط وبالحبات",1,"ت",1,0],["هذا الخريف الجهمُ تمشي خُطاهْ","على الربيع الذَّابلِ المحتضَرْ",2,"ر",1,0],["هذا الخلافة طابت نفسها وغدت","فرحى ولولاك لم تفرح ولم تطب",3,"ب",1,0],["هذا الخليجُ فمَرْحَبا بزمانِهِ","يا حَبَّذا الآصالُ بين جِنانِهِ",4,"ن",2,1],["هذا الخنوع وذا الخمو","ل وكل جبن فيك خادر",5,"ر",1,0],["هذا الخراب.. وهذا الضيق.. لقمتنا","صارت زعافا، وحتى ماؤنا وشل",6,"ل",1,0],["هَذا الخَيالُ فَكَيفَ لي بِمُنَعَّمٍ","رودِ الشَبابِ تَخالُهُ تِمثالا",7,"ل",2,0],["هَذا الخُلودُ عِندي","لَو دامَ لِيَ الخُلودُ",8,"د",1,0],["هذا الخليفةُ ظِلُّ اللهِ مُنبَسِطاً","في أرضِهِ لِعبادِ اللهِ مُكتَنِفا",9,"ف",2,0],["هذا الخطيبُ على الرُؤوس منادياً","جَهراً وذاك النَّعشُ عُودُ المِنْبَرِ",10,"ر",1,0],["هذا الخُسوفُ عراكَ يا بدرَ الدُجَى","ونَرَى خُسوفَ البدرِ ليس يطولُ",11,"ل",1,0],["هَذا الخِتان الَّذي فيهِ ثَناء عَلِي","مَع يُوسفٍ لَم يَزَل يُتلى بِأَفواه",12,"ه",1,0],["هذا الخليجُ زها في العيدِ مربَعُه","وجُّن فيه نشيدُ المجدِ والطربِ",13,"ب",1,0],["هذا الخليج خليج العربِ يذكركم","لازلتم في ذراه راية الحسبِ",13,"ب",1,0],["هذا الخمار من الفيروز معدنه","أم من خيال العيون الزرق واحربا",14,"ب",2,0],["هَذا الخِتانُ وَقَدْ دَعَوهُ طُهُوراً","ة خَلَعَ الزَّمَانَ بِهِ عَلَيكَ سُرُوراً",15,"ر",2,1],["هَذا الخُلافي أطال صَدّي","وَكان لي قَبلَ ذَا مُوَافي",16,"ي",1,1],["هذا الخليفة هذا السيدُ العلم","هذا المقام هذا الركن والحرمُ",17,"م",1,1],["هذا الخليفة وابنُ أَكْرَمِ مُرْسَلٍ","وسليلُ من فَخَرَتْ به الأعصارُ",18,"ر",1,0],["هذا الخطاب وهذا الفصل يقطعه","ضرب المفارق أولا تسلم الغمد",19,"د",1,0],["هذا الخليل امام المسلمين حكت","أنوار سيرته في العدل نيرانا",20,"ن",2,0],["هذا الخفاجي الذي بفضله","بين الورى قد سار ضرب المثل",21,"ل",1,0],["هَذَا الخُويدِمُ فِي سُوسٍ تُضايقُهُ","أهلُ الجهالَةِ فِيما جلَّ أَو حَقُرا",22,"ر",2,0],["هذا الختام وأنه","نسج بعلياكم تفوف",23,"ف",1,0],["هذا الخليل ابوه كافرا شر","ونوح كان ابنه من افجر النسم",24,"م",1,0],["هذا الخطير مضى فاجفان الورى","قد ضرجت من ذكرهِ بوروده",25,"د",2,0],["هذا الخطيب اذا انبرى لأَسرة","شرق تهافت للسماع ومغرب",26,"ب",1,0],["هذا الخطيب وهذا المنشئُ العرب","تزهو به والمحامي الملسن الذربُ",27,"ب",1,1],["هذا الخطيب اذا انبرى لخطابة","منه الجلامد والصخور تلين",28,"ن",1,0],["هَذا الخديو الَّذي يَسمو الزَمان بِهِ","وَافى وَيقدمه الإِجلال مَوفورا",29,"ر",2,0],["هَذا الخديو مَليكنا","يَقضي بِنا حُكم النصف",30,"ف",1,0],["هذا الخطيب الرائع الأدب الذي","ألقى البيان إليه كل قياده",31,"د",2,0],["هذا الخِطاب لكُل عَبد مُؤمِن","وَالنُصح يَجدي بِالكَريم السَيد",32,"د",1,0],["هَذا الخِتامُ وَذا الختانُ قَد أَشرَقا","في بَيتِ مَحمودٍ كَما القمرانِ",33,"ن",1,0],["هذا الخورنق مطموس بلا أثر","وذي المدائن لا بهو ولا سور",34,"ر",1,0],["هذا الخديوي الَّذي قرت بموكِبِه","عين الزَمانِ وَقالَت لِلهُدى اِبتَهِج",35,"ج",1,0],["هذا الخليل المجتبى هذا الجليل","المختبى لاقالة العثرات",36,"ت",1,0],["هذا الخبر مافيه شكً ولاريب","أوعزي لمن غير طريقه وممشاه",37,"ا",2,0],["هذا الخبر صدمه وحزن وعلامه","على محبّة كل الامه لخطاب",38,"ب",1,1],["هذا الخبر والهم هذى خيامه","شرّع للأحزان النوافذ والابواب",38,"ب",1,0],["هذا الخنوع رأى فيه مذلته","فما استكان له أوكان مصطحبا",39,"ب",2,0],["هذا الخواء وهذا الجوع ياأبتي","زادٌ لمهجتنا من جهل مازرعوا",40,"ع",3,0],["هذا الخليفةُ (هيثمٌ) سلطانُكم","وله فكونوا خيرةَ الأعضاد",41,"د",1,0],["هذا الخيارُ رفضتهُ ورفضتُ أنْ","أحيا بغير مشاعري المتناغمهْ",42,"م",2,0],["هذا الخليلُ كفاه الزهدُ مكرمةً","من ربه جاعلِ الزهّاد في عيدِ",43,"د",1,0],["هذا الخريف المر في نظراتها","قتل الربيع بوجهها واصطافا",44,"ف",2,1],["هذا الخلاف الذي أفضى لفرقتنا","أيدي سبأ ذا لهذا قط لم يؤب",45,"ب",1,0],["هذا الخلاف الذي آم البنين به","من الدما جبلت تلا من الترب",45,"ب",1,0],["هذا الخيارُ هو المُجرَّب وحدَهُ","أمّا السّلاحُ وحمْلُهُ فمُحرَّمُ",46,"م",1,0],["هذا الخلودُ فَإِن بَلَغت مَحَلَّهُ","فَارأَف بِمَن عِشقُ الزَّوالِ أَذَلَّهُ",47,"ل",2,1],["هذا الخريف مكدس ورقي","تحتي لينسج منه أكفاني",48,"ن",2,0],["هذا الخلاف نذيرٌ ليس يجهله","ذوو البصيرة إّذ يا طالما انفجرا",49,"ر",2,0],["هذا الخليفة هذا السيدُ العلم","هذا المقام وهذا الركن والحرمُ",50,"م",1,1]]}