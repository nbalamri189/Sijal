.net/poem18070.html","الطويل"],[67,"إن تحي آمالي برؤية عيسى","https://www.aldiwan.net/poem18073.html","الكامل"],[75,"أرياك أم ردع من المسك صائك","https://www.aldiwan.net/poem69053.html","الطويل"],[48,"دع الأمطار تعتور الديارا","https://www.aldiwan.net/poem66573.html","الوافر"],[50,"تجاللت عن فهر وعن جارتي فهر","https://www.aldiwan.net/poem63803.html","الطويل"],[50,"وضعت قناعي وارتببت نجادي","https://www.aldiwan.net/poem63903.html","الطويل"],[46,"ترنم في نهارك مستعينا","https://www.aldiwan.net/poem22214.html","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42624","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55123","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43633","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43835","البسيط"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50449","الرجز"],[77,"ثنى الصعدة السمراء من لين قده","https://www.poetsgate.com/ViewPoem.aspx?id=33801",""],[67,"جِوَارُكَ منْ جَوْرِ الزَّمانِ يُجِيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=14535",""],[45,"سواي مرجي سلوة أو مريدها","https://www.poetsgate.com/ViewPoem.aspx?id=32953",""],[45,"يَهُونُ عَلَيْهَا أنْ أبِيتَ مُتَيَّما","https://www.poetsgate.com/ViewPoem.aspx?id=31883",""],[46,"ترنّمْ في نهارِكَ، مستعيناً","https://www.poetsgate.com/ViewPoem.aspx?id=18122",""]],"verses":[["ثَنى الذِراعَ وَأَلقى فَضلَ لِمَّتِهِ","عَلى الكَثيبِ خَميصَ البَطنِ طَيّانا",0,"ن",2,0],["ثَنَت طَرفَها عَنّي نَوارُ وَأَعرَضَتْ","وَلِلرَّكبِ بَينَ المأزَمَينِ ضَجيجُ",1,"ج",1,1],["ثَنى عِطْفَهُ للْبارِقِ المتأجّجِ","كَما عَلِقَتْ نارٌ بأطْرافِ عَرْفَجِ",2,"ج",1,1],["ثَنى الصّعْدَةَ السّمْراءَ منْ لِينِ قَدِّهِ","وجَرّدَ منْ أجْفانِهِ سَيْفَ خَدِّهِ",3,"د",2,1],["ثَناياهُ قد أبْدَتْ مَعالِمَ بارِقٍ","وأنْفاسُهُ أبْدَتْ نَواسِمَ نجْدِهِ",3,"د",2,0],["ثَنائي عَلَيكُم بِالمَغيبِ وَإِنَّني","أَراني إِذا صارَ الوَلاءُ تَحَزُّبا",4,"ب",2,0],["ثَناءٌ ثَنى في سَناءِ المَحَ","لِّ زُهرَ الكَواكِبِ لي حُسَّدا",5,"د",2,0],["ثَنائي تُنَمّيهِ عَلَيَّ وَمِدحَتي","سَمامٌ عَلى رُكبانِهِنَّ العَمائِمُ",6,"م",1,0],["ثَناءً يُوافي بِالمَواسِمِ أَهلَها","وَيُنشِدُهُ الرُكبانُ في كُلِّ مَحفَلِ",7,"ل",1,0],["ثَنائي تُؤَدّيهِ إليك وَمِدحَتي","صُهابِيَّةُ الأَلوانِ باقٍ ذَميلُها",8,"ل",3,0],["ثَنَاءٌ عَلَيْكُمْ بِالَّذِي تَبْتَغُونَهُ","وَتَدْرُونَ أَنَّ الْفَوْزَ بِالجِّدِ وَالدَّأَبْ",9,"ب",1,0],["ثَنى بَعدَ ما طالَت بِهِ لَيلَةُ السُرى","وَبِالعيسِ بَينَ اللامِعاتِ الجَفاجِفِ",10,"ف",1,0],["ثَنَتهُ عَنِ الأَقناصِ يَوماً وَلَيلَةً","أَهاضيبُ حَتّى أَقلَعَت وَهُوَ جائِعُ",11,"ع",1,0],["ثناء يقول المسك إن ضاع عَرْفُهُ","أيا لك من نَدِّ أما لك من نِدِّ",12,"د",1,0],["ثَناءٌ طَيِّبٌ لا خُلفَ فيهِ","وَأَثارٌ كَأَثارِ العَمامِ",13,"م",1,0],["ثَناؤُكَ خَيرٌ مِن فَعالِ مَعاشِرٍ","وَفِعلُكَ يا اِبنَ الهاشِمِيَّةِ أَفضَلُ",14,"ل",1,0],["ثنى عن العرضِ الأدنى به بصراً","ثنى إلى الجوهرِ الأعلى بصائره",15,"ر",2,0],["ثناؤك أشهى من لماه إلى فمي","ولفظك لا حلو الوصال ومرّه",16,"ر",2,0],["ثنى كلّ باعٍ من مداها ممدَّح","كأن ثناه في البسيطةِ باغ",17,"غ",1,0],["ثنى امتداحك شعري عن عوائده","فما بدأت بتشبيب ولا غزَل",18,"ل",1,0],["ثنى رجله فوق النجوم ولو علتْ","وطالتْ ثنى باعيه أعلى وأطولا",19,"ل",2,0],["ثنائيَ لا تُسبَق إليه فإنه","خُلودٌ لما تَبنِي وطولُ بقاءِ",20,"ا",2,0],["ثناؤنا يبقى ويطوي الفلا","طيّاً فلا يُثنَى ولا يُقصر",21,"ر",1,0],["ثنى شوقه والمرء يصحو ويسكَرُ","رسومٌ كأخلاق الصحائف دُثَّرُ",22,"ر",1,1],["ثنائي مسك دارينٍ","وذكري عنبر الشِّحر",23,"ر",1,0],["ثناؤكُمُ للبحتري وودُّكُمْ","ومدحي لكم حاشا هواكم من الخبلِ",24,"ل",1,0],["ثنايا لعمري وُضَّحٌ لا يشينُها","ونابُ عضاضٍ مِقْصلٌ حين يَضْغَمُ",25,"م",1,0],["ثنى إليه طُلَى الأحرار أنَّ لَهُ","عَهْداً وفِيّاً وأنَّ الدهرَ خوَّان",26,"ن",1,0],["ثَنَينَ عَليها الريشَ حَتّى تَلاحَقَت","وَطارَ شَعاعاً قَيضُها قَد تَحَطَّما",27,"م",2,0],["ثَنى مُهرَهُ وَالخَيلُ رَهوٌ كَأَنَّها","قِداحٌ عَلى كَفَّي مُفيضٍ يُجيلُها",28,"ل",3,0],["ثَنائي عَلَيكُم آلَ حَربٍ وَمَن يَمِل","سِواكُم فَإِنّي مُهتَدٍ غَيرُ مائِلِ",29,"ل",1,0],["ثَناءٌ تُشرِقُ الأَحسابُ مِنهُ","بِهِ نَتَوَدَّعُ الحَسَبُ المَصونا",30,"ن",2,0],["ثنى الأعناق عوّده","وألقى العذر لوّمه",31,"م",2,0],["ثَنى عِطفَيهِما الهَرَمانِ تيهاً","وَقالَ الثالِثُ الأَدنى سَلامُ",32,"م",1,0],["ثَنَتهُ العَوادي دونَ أودينَ فَاِنثَنى","بِآخَرَ مِن دُهمِ المَقاديرِ ذَيّالِ",33,"ل",1,0],["ثَناهُم وَبَرقُ البيضِ في البيضِ صادِقٌ","عَلَيهِم وَبَرقُ البَيضِ في البيضِ خُلَّبُ",34,"ب",1,0],["ثَنى يَدَهُ الإِحسانُ حَتّى كَأَنَّها","وَقَد قُبِضَت كانَت بِغَيرِ بَنانِ",35,"ن",1,0],["ثناءٌ مثلُ ما تُثني رياضٌ","بريِّقِها على نعمِ الغَمامِ",36,"م",1,0],["ثنتِ اللثام على وميضِ مباسمٍ","بَرقَتْ وهل يُخفِي الوميضَ لِثامُ",37,"م",1,0],["ثَنى عِطْفَهُ واحتجَّ بالشُّغْلِ مُعرِضاً","ألا إِنما بعضُ الصدودِ سَآم",38,"م",1,0],["ثَناءٌ تَقَصّى الأَرضَ نَجداً وَغائِراً","وَسارَت بِهِ الرُكبانُ شَرقاً وَمَغرِبا",39,"ب",2,0],["ثَنَت مِن تَباريحِ الغَليلِ وَنَهنَهَت","مَدامِعَ ما تَرقا لَهُنَّ غُروبُ",40,"ب",1,0],["ثَنَت طَرفَها دونَ المَشيبِ وَمَن يَشِب","فَكُلُّ الغَواني عَنهُ مُثنِيَةُ الطَرفِ",41,"ف",1,0],["ثَنى عَنكُمُ زَحفَ الخِلافَةِ بَعدَما","أَضاءَت بُروقُ العارِضِ المُتَأَلِّقِ",42,"ق",1,0],["ثَناهُ العِدى عَنّي فَأَصبَحَ مُعرِضاً","وَأَوهَمَهُ الواشونَ حَتّى تَوَهَّما",43,"م",2,0],["ثَناءٌ كَأَنَّ الرَوضَ مِنهُ مُنَوِّراً","ضُحاً وَكَأَنَّ الوَشيَ فيهِ مُسَهَّما",43,"م",2,0],["ثَنى أَمَلي فَاِحتازَهُ مِن مَعاشِرٍ","يَبيتونَ وَالآمالُ فيهِم مَطامِعُ",44,"ع",1,0],["ثَنَت رُكَبَ الأَيدي كَأَنَّ رَشيفَها","تَرَشُّفُ مَمطورٍ وَقيعاً يُناهِبُه",45,"ب",2,0],["ثِنتانِ لَم تَترُكا لَحماً وَحاطِمَةٌ","بِالعَظمِ حَمراءُ حَتّى اِجتيحَتِ الغُرَرُ",46,"ر",1,0],["ثَناءً لَستُ كاذِبَهُ كَفَتني","يَداكَ نَوائِبِ الحَدَثِ الكِبارا",47,"ر",2,0],["ثَنائي عَلى العَبّاسِ أَكرَمِ مَن مَشى","إِذا رَكِبوا ثُمَّ اِلتَقوا بِالمَواقِفِ",48,"ف",1,0],["ثَنَت مُضمِراتٌ مِن بِلالٍ قُلوبَنا","إِلى مُنكَرِ النَكراءِ لِلحَقِّ عارِفِ",49,"ف",1,0],["ثَنَيتَ ذُكورَ الخَيلِ مِن أَهلِ واسِطٍ","وَكُلَّ مُفَدّاةِ الرِهانِ سَبوقِ",50,"ق",1,0],["ثَناي عَليهِمُ مادُمتُ حَيَّاً","ثَناءَ المُستهامِ علَى الثَّنايا",51,"ا",3,0],["ثنَّى العزِيزُ إليها ليثَ مَلحَمةٍ","يَسري العزيزُ بمَسراه فيَنتقِلُ",52,"ل",1,0],["ثناءً كأفوافِ الرِّياضِ يَشوبُه","عتابٌ كأنفاسِ الرِّياحِ الضَّعائفِ",53,"ف",1,0],["ثناءً إذا عايَنْتَ عِقدَ نِظامِه","توهَّمْتَه للجَوهرِ التِّبرِ مَجمَعا",54,"ع",2,0],["ثَنَتْني عنكَ فاستشعرْتُ هَجراً","خِلالٌ فيكَ لستُ لها بِرَاضي",55,"ي",1,1],["ثَنَتْ لكَ أعطافَها والخُصورا","وأعطَتْكَ أجيادَها والنُّحورا",56,"ر",2,1],["ثَنَيْتَ إلى غاياتِها الأُسْدَ فانثَنتْ","تُساوِرُ بالبِيضِ الصَّوارمِ سُورَها",57,"ر",3,0],["ثَنى الخَيلَ عن ماءِ الفُراتِ صَوادراً","فكان لها وِردُ الخَليجَيْنِ مَوْرِدا",58,"د",2,0],["ثَنى المديحُ إليه عِطْفَه فثَنى","أعطافَه منه في وَشيٍ وديباجِ",59,"ج",1,0],["ثَناءٌ أبانَ الفضلَ مني لحاسِدٍ","تبيَّنَ فيه ذِلَّةُ العبدِ للمَولى",60,"ا",1,0],["ثَنَت أَربَعاً مِنها عَلى ثِنيِ أَربَعٍ","فَهُنَّ بِمَثنِيّاتِهِنَّ ثَماني",61,"ن",2,0],["ثَنَتِ العُهودُ أَعِنَّتي عَن غَيرِكُم","فَعُقودُها مَنظومَةٌ لا تُنكَثُ",62,"ث",1,0],["ثَنانا عَنكَ فَاِزدَدنا ثَناءً","عَلى عَلياكَ لا نَألو اِجتِهادا",63,"د",2,0],["ثَنَيتُ عِناني مَع ثَنائي عَلَيكُمُ","فَأَصبَحتُ وَالثاني العِنانَ هُوَ المُثني",64,"ي",1,0],["ثَنى حَدَّهُ فَرطُ الضِرابِ فَلَم يَزَل","حَديدَ فِرِندِ المَتنِ رَثِّ المَضارِبِ",65,"ب",1,0],["ثنى توحيدُكَ التثليثَ منه","يَعَضّ على يَدَيْ فَزِعٍ كظيمِ",66,"م",1,0],["ثَناؤُكَ في الآفاقِ أَركَبَني المُنَى","وَغَرّبَني عَنْ مَوْطِني المُتَباعِدِ",67,"د",1,0],["ثناءٌ تخالُ الشمسَ ناراً له وما","على الأرضِ من نبتٍ له منزلاً رطبا",68,"ب",2,0],["ثِنتانِ كَالقَمَرَينِ حُفَّ سَناهُما","بِكَواعِبٍ مِثلِ الدُمى أَترابِ",69,"ب",1,0],["ثَنَاءٌ بِزَهرِ الرَّوضِ فِي الأرضِ مُرتَدٍ","وَمَجدٌ بِفَخرِ النَّجمِ في الأفقِ نَازِلُ",70,"ل",1,0],["ثَنَينَ الذُيولَ وَاِرتَدَينَ بِسابِغٍ","كَحَيّاتِ رَملٍ وَاِنتَقَبنَ بِحَنّاءِ",71,"ا",2,0],["ثَناؤُكَ مِنْ رَوْضِ الخَمائِلِ أَعْطَرُ","وَوَجْهُكَ مِنْ شَمْسِ الأَصائِلِ أَنْوَرُ",72,"ر",1,1],["ثَنَتِ السُّنُونَ سِنانَ صَعْدَتِيَ الَّتي","لم تَلْقَ رادِفَةً ولا قَرْبُوسا",73,"س",2,0],["ثَنائي على وحيِ الكِتابِ عليكُمُ","فلا الوَحْيُ مأفوكٌ ولا أنا آفك",74,"ك",1,0],["ثناه عن عبادتهِ فقيسوا","بما قد قلتُ واعتبروا اعتبارا",75,"ر",2,0],["ثَنى وَجهَها المَهدِيُّ يَومَ لَقيتُها","وَقَد زانَها الحِنّاءُ في قَصَبٍ عَشرِ",76,"ر",1,0],["ثَنَيتُكَ عَن لَقطِ النَوى فَهَجَوتَني","وَكَلَّفتَني داداً فَرُحتَ بِدادِ",77,"د",1,0],["ثَنَتهُنَّ الجَماجِمُ عَن مُرادٍ","بِشيبٍ فَاِنثَنَينَ مُجَمجِماتِ",78,"ت",1,0],["ثَنَتْ عَزْمَتِي ثَوْرَةُ الْمُفْسِدِينَ","وَغَلَّتْ يَدِي فَتْرَةُ الْعَسْكَرِ",79,"ر",1,0],["ثَنَى لُبْنَانُ مُهْجَتَهُ عَلَيْهِ","وَشُبِّهَ لِلعُيُونِ ثَرىً مَهِيلُ",80,"ل",1,0],["ثَنَتني صُروفُ الدَهرِ عَنكِ وَما اِنثَنى","فُؤادي فَجِسمي راحِلٌ مِثل لابِثِ",81,"ث",1,0],["ثَنِّ لَهُ دَعوَةً وَثَلِّث","تُجب لِثَنتَين أَو ثَلاثِ",82,"ث",1,0],["ثناؤُنا زَهْرُ الرَّبيعِ المُجتلى","وجُودُه صَوبُ الرَّبيعِ المُنسجِم",83,"م",1,0],["ثنى الصعدة السمراء من لين قده","وجرد من أجفانه سيف جده",84,"د",2,1],["ثَناءٌ حَكاهُ عَنْبَرٌ وعَبيرُ","يؤَيَّدُ منها بالنفيرِ نفيرُ",85,"ر",1,0],["ثناء اللئيم خطة ما أطورها","ومال اللئيم روضة ما أرودها",86,"د",3,0],["ثَنَاءٌ كأنّ الرّوْضَ مِنْهُ مُنَوِّراً،","ضُحًى، وكأنّ الوَشيَ فيهِ مُسَهَّمَا",87,"م",2,0],["ثنتهنّ الجماجمُ من مُرادٍ","، بشيبٍ، فانْثنينَ مُجَمجمِات",88,"ت",1,0]]}