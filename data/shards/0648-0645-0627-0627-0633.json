em.aspx?id=192954",""],[4914,"لك الهنا ولي الأفراح والطرب","https://www.poetsgate.com/ViewPoem.aspx?id=170938",""],[4984,"أول ماي","https://www.poetsgate.com/ViewPoem.aspx?id=180386",""],[4984,"لَوْلَا ..","https://www.poetsgate.com/ViewPoem.aspx?id=201164",""],[4984,"يَوْمُ الْاسْتِقْلَالِ","https://www.poetsgate.com/ViewPoem.aspx?id=204988",""],[3647,"وما اسمٌ اصلهُ نَبتٌ","https://www.poetsgate.com/ViewPoem.aspx?id=125688",""],[5041,"إلى عزيزٍ لهُ في مُهْجَتي نُزُلُ","https://www.poetsgate.com/ViewPoem.aspx?id=24396",""],[585,"يا شيب إن أوان الشيب لم يحن","https://www.poetsgate.com/ViewPoem.aspx?id=161874",""],[5083,"بَشيرُ السَعد","https://www.poetsgate.com/ViewPoem.aspx?id=53761",""],[3591,"أودع ميمون الجميل المهفهفا","https://www.poetsgate.com/ViewPoem.aspx?id=149539",""],[3591,"عارٌ على الغيد أن تزهو وتفتخرا","https://www.poetsgate.com/ViewPoem.aspx?id=149462",""],[5274,"هي الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=203694",""],[5277,"جيرةُ القلب","https://www.poetsgate.com/ViewPoem.aspx?id=192256",""],[5302,"لقاء حب","https://www.poetsgate.com/ViewPoem.aspx?id=200063",""],[5318,"لأرضِ الحشدٍ ينتسبُ الرِجالُ","https://www.poetsgate.com/ViewPoem.aspx?id=210843",""],[5376,"إياك نعبدُ ما في القلبِ الاهُ","https://www.poetsgate.com/ViewPoem.aspx?id=188352",""],[5376,"بشراك ما قد أتتنا الأعينُ النجلُ","https://www.poetsgate.com/ViewPoem.aspx?id=194080",""],[5376,"بَلْقيسُ ألْقتْ جَمَالاً من خمائلِها","https://www.poetsgate.com/ViewPoem.aspx?id=196647",""],[5387,"أمي..","https://www.poetsgate.com/ViewPoem.aspx?id=53896",""],[5409,"ومعشرٍ عرفتنا الحادثات بهم","https://www.poetsgate.com/ViewPoem.aspx?id=155293",""],[5452,"رسائل حبلى بطيب العيد","https://www.poetsgate.com/ViewPoem.aspx?id=117587",""],[5464,"القتلى لن يُحييهم الإعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=125401",""],[5512,"بباب الحي","https://www.poetsgate.com/ViewPoem.aspx?id=204219",""],[5587,"عمر الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=196762",""],[5613,"وَمَا أسم رباعي إِذا مَا عددته","https://www.poetsgate.com/ViewPoem.aspx?id=190236",""],[5616,"قاصمة الظهر","https://www.poetsgate.com/ViewPoem.aspx?id=203429",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5655,"تحيّةُ ربّي كلَّ يومٍ مجدَّدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=107216",""],[5701,"شفاك الله يا صال","https://www.poetsgate.com/ViewPoem.aspx?id=164705",""],[5721,"ينابيع البكاء","https://www.poetsgate.com/ViewPoem.aspx?id=214506",""],[5751,"كذبةُ سيف","https://www.poetsgate.com/ViewPoem.aspx?id=214773",""],[5776,"عامُ الأبابيلِ اليمانية...","https://www.poetsgate.com/ViewPoem.aspx?id=203647",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5956,"الطفل أرتين يناجي ابنَي عمته وأسرتهما","https://www.poetsgate.com/ViewPoem.aspx?id=210842",""],[5996,"وما أسفي إلا عليها فإنني","https://www.poetsgate.com/ViewPoem.aspx?id=181342",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[2395,"أيا علماء العصر يا من لهم خبر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=583278",""],[5080,"أشجرت ذاتك في أحشاء تربته","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88137&r=&rc=7",""],[5126,"متى أعيش؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87816&r=&rc=31",""]],"verses":[["وَما أُسَرُّ بِمالٍ لا أَعُزُّ بِهِ","وَلا أَلَذُّ بِرَأيٍ فيهِ تَفنيدُ",0,"د",1,0],["وَما أَسَفي إِلّا عَلى ما جَلَوتُهُ","عَلى سَمعِ مَنزورِ النَوالِ نَضوبِهِ",1,"ب",2,0],["وَما اسْتَهْدَفَتْ لِلْذُّلِّ حينَ تَكَدَّرَتْ","عَلَيْها اللَّيالي فَالقَناعَةُ جُنَّتي",2,"ت",2,0],["وَمَا اسْتَرْعَفَتْ مِنْ لَبَّةِ القِرْنِ صَعْدَتِي","وَلَمْ يَتَلَمَّظْ بَيْنَ أَوْداجِه عَضْبي",3,"ب",2,0],["وما اسْمُ شيءٍ إذا صحّفْتَ ثانيَهُ","فاذْكُرْ بهِ رجُلاً قد طالَ في ضجَرِ",4,"ر",1,0],["وَمَا اسْتَعْبَرْتُ مِنْ طَرَبٍ وَلكِنْ","يُذَكِّرُنِي الرَّبَابُ هَوَى الرَّبَابِ",5,"ب",1,0],["وَما استَخبَأتُ في رِجُلٍ خَبيئاً","كَدينِ الصِدقِ أَو حَسَبٍ عَتيقِِ",6,"ق",1,0],["وما استَبَدَّ برأْيٍ في حُكومَتِه","إنّ الحُكومَةَ تُغري مُستَبِدِّيها",7,"ي",3,0],["وَما اِستَعبَدَ الأَحرارَ كَالعَفوِ إِن جَنى","جَهولٌ وَفَضلُ الصَدرِ في سَعَةِ الصَدرِ",8,"ر",1,0],["وَما اِستَبهَمَ القُفلُ في الحادِثا","تِ إِلّا رَآكَ لَهُ مِقلَدا",9,"د",2,0],["وَما اِستنَّ رَقراقُ السَرابِ وَما جَرى","بِبيضِ الرُبى وَحشِيُّها وَنَوارُها",10,"ر",3,0],["وَما اِستنَّ رَقراقُ السَرابِ وَما جَرَت","مِنَ الوَحشِ عَصماءُ اليَدينِ نَوارُ",11,"ر",1,0],["وَمَا أَسْبَابُ أَدْوَائِهِمْ","وَكُلُّهُمْ لَوْ نُفِيَتْ ضَيْغَمُ",12,"م",1,0],["وَمَا اسْطَاعَ يُلْفِيهِ الغَدَاةَ وَلِيُّهُ","مُعِيناً عَلَى دَفْعِ الأَذَى وَالمَغَارِمِ",13,"م",1,0],["وَما اِستَفَدتَ مِنَ الديوانِ فائِدَةً","فيما عَلِمتُ سِوى نَشرُِ الطَواميرِ",14,"ر",1,1],["وَما استَعهَدَ الأَقوامُ مِن ذي خُتونَةٍ","مِنَ الناسِ إِلّا مِنكَ أَو مِن مُحارِب",15,"ب",1,0],["وما استنزلت في غيرنا قدرُ جارنا","ولا ثُفيت إلا بناحين تُنْصَبُ",16,"ب",1,1],["وَما اِستَمتَعتُ مِن داعي التَصابي","إِلى أَن جاءَني داعي الوَقارِ",17,"ر",1,0],["وما أسَفي إنَّ الثواء يفوتني","ولكن لقدرٍ عند غيرك ضائع",18,"ع",1,0],["وما استدخل الأير من حاجةٍ","ولكن به المذهب الأكبرُ",19,"ر",1,0],["وما استطرف الأقوام لي فيه طُرفةً","لأني ما عرَّفتهم فيه منكرا",20,"ر",2,0],["وما استفدت من الديوان فائدةً","فيما علمنا سوى نشر الطوامير",21,"ر",1,0],["وما استدخل الأيرَ من شهوةٍ","ولكن به المذهبُ الأكبر",22,"ر",1,0],["وما استمتعوا من صدر أمٍّ بضمةٍ","ولا سقطوا في قعر مهد ولا حجر",23,"ر",1,0],["وما اسْتَكْتَمت تلك الوصاوصُ أَوجُهاً","قِباحاً ولا ألوانَ سودٍ عَنافِص",24,"ص",1,0],["وما استطرفَ الأقوامُ لي فيك مِدحةً","لأني بما علَّمتهم بك من جهلِ",25,"ل",1,0],["وما استبطأْتُ طولك في عتابي","كما يستبطِئُ الخَرِقُ العَجُولُ",26,"ل",1,0],["وَما أَسَفي إِلّا عَلى القُربِ مِنكُمُ","إِذا شَطَّ عَنّي دارُكُم أَو نَأَيتُمُ",27,"م",1,0],["وَما أَسَفي إِلّا عَلى القُربِ مِنكُمُ","وَلَستُ عَلى شَيءٍ سِواهُ بِآسِفِ",28,"ف",1,0],["وَما اِستَطرَفَت نَفسي حَديثاً لِخلَّةٍ","أُسِرّ بِهِ إِلّا حَديثُكِ أَطرَفُ",29,"ف",1,0],["وما استقبلت إلا ضياها تعيره","دليل الهوى من نورها ويعير",30,"ر",1,0],["وما استوى المرء يطوى ذكره معه","وذاهب فضله في الناس ما ذهبا",31,"ب",2,0],["وَما أُسطولُهُم في البَحرِ إِلّا","شَخاشِخُ ما يَرُحنَ وَما يَجينا",32,"ا",1,0],["وَما اِستَعصى عَلى قَومٍ مَنالٌ","إِذا الإِقدامُ كانَ لَهُم رِكابا",33,"ب",2,0],["وَما اِستَغرَقتُ وَصفَكَ في مَديحي","فَأَنقُصَ مِنهُ شَيئاً بِالهِجاءِ",34,"ا",2,0],["وَما اِستَغرَبَت عَيني فِراقاً رَأَيتُهُ","وَلا عَلَّمَتني غَيرَ ما القَلبُ عالِمُه",35,"م",2,0],["وَما اِستَعَنتُ عَلى دارٍ وَإِن بَعُدَت","كَالمُرتَجى بنِ نُصَيرٍ مَعدِنِ الخيرِ",36,"ر",1,0],["وَما أَسَرَّت أُمُّ العِيالِ سُروراً","مُنذُ قالوا أَبو العِيالِ يُناكُ",37,"ك",1,0],["وَما أَسَدٌ وَلِيُّ يَدٍ فَتُرجى","نَوافِلُهُ وَلا مَولى جَميلِ",38,"ل",1,0],["وَما اِستَثقَلوا مِن مُدَّةٍ قَد تَكامَلَت","وَمِن عُمُرٍ لَم يَبقَ إِلّا أَقَلُّهُ",39,"ل",2,0],["وَما اِستَدَرَّت جُفونُ العَينِ إِذ بَكَأَت","أَخلافَ دِرَّتِها كَالنُؤيِ وَالطَلَلِ",40,"ل",1,0],["وَما اِستَعهَدَ الأَقوامُ مِن زَوجِ حُرَّةٍ","مِنَ الناسِ إِلّا مِنكَ أَو مِن مُحارِبِ",41,"ب",1,0],["وَما اِستَرَبتَ فَكُن وَقّافَةً حَذِراً","قَد يُبرَمُ الأَمرُ أَحياناً فَيَنتَقِضُ",42,"ض",1,0],["وما اسم تراه في البروج وإنما","يحل به المريخ دون الكواكب",43,"ب",1,1],["وما اسم له شطر صحيح منطق","يعد بلا كسر وأحرفه خمس",44,"س",1,1],["وما استنطقْتُ من طَلَلٍ صَموتٍ","كأنّ له إشاراتِ الكليمِ",45,"م",1,0],["وَما أَسهَرُ الظَلماءَ إِلّا لَعَلَّهُ","يُنَشِّقُني الخَيرِيُّ مِن نَشرِهِ عَرفا",46,"ف",2,0],["وَما أَسَفي أَنّي أَموتُ وَإِنَّما","حِذارِيَ أَن تُرمى بِلُؤمِ الطَبائِعِ",47,"ع",1,0],["وَما أَساؤوا فِراراً عَن مُجَلِّيَةٍ","لا كاهِنٌ يَمتَري فيها وَلا حَكَمُ",48,"م",1,0],["وَما اِستَعَنتُكِ إِلّا","أَبرَقتِ لي وَرَعَدتِ",49,"ت",1,0],["وَما اِستَغلى أَبو العَبّاسِ مَدحاً","وَلَم يَكثُر عَلَيهِ لَهُ كَثيرُ",50,"ر",1,0],["وَما اِستَفرَغَ اللَذّاتِ إِلّا مُشَيَّعٌ","إِذا هَمَّ لَم يَذكُر رِضى مَن تَغَضَّبا",51,"ب",2,0],["وَما أُسَرُّ لِتَعشيرِ الغُرابِ أَسىً","وَلا أُبَكّي خَليطاً حَلَّ تِعشارا",52,"ر",2,0],["وَما أَسأَلُ الأَحياءَ بَعدي زِيارَةً","ثَلاثاً لإِيناسِ الدَفينِ وَلا سَبعا",53,"ع",2,0],["وَما أُسائِلُ عَن شَخصٍ لِمَولِدِهِ","عَشرٌ وَتِسعونَ إِلّا قيلَ قَد هَلِكا",54,"ك",2,0],["وَما اِستَفَزَّهُما الاِمهالُ فَاِدَّعَيا","بِالجَهلِ ما قالَهُ المَغرورُ وَاِنتَحَلا",55,"ل",2,0],["وَما أَسيتُ عَلى الدُنيا مُزايَلَةً","وَلا تَأَسَّت عَلى البالي مِنَ الرِمَمِ",56,"م",1,0],["وَما اِستَراحَ لَعَمري مِن سَوائِلِها","إِذا طَغى مائُها إِلّا سَواليها",57,"ي",3,0],["وما استَعذَبَتهُ روحُ موسى وآدَمٍ","وقد وُعِدا من بعدِه جَنَّتَيْ عَدْنِ",58,"ن",1,0],["وما أُسمِّي فتىً شتَّى مناقبُهُ","إنَّ المناقب للفتيان أسماءُ",59,"ا",2,0],["وَما اِستَمكَنَت عَيني مِنَ النَظَرِ الَّذي","أُداوي بِهِ قَلبي وَأَشفي بِهِ صَدري",60,"ر",2,0],["وما اسم شيء إذا صحفت ثانيه","فاذكربه رجلا قد طال في صحر",61,"ر",1,0],["وما استفرغَ اللَّذَّات إلاَّ مُقابلُ","إذا همَّ لمْ يذكرْ رضى منْ تغضَّبا",62,"ب",2,0],["وما استجاب له منهم سوى نفر","فى الله ما عذبوا فى الله ما ضربوا",63,"ب",3,0],["وما اسطعت فاقطع يد المُعْتَدَي","عليه وقبّلْ يدَ المُعتَدي",64,"د",2,0],["وما أسْتَعْبَدَ الْحُرَّ الكَريمَ كَنِعْمَةٍ","يَنَالُ بِها عَفواً ولَمْ يَتَكَلَّمِ",65,"م",1,0],["وما استعنت على دار وإن بعدت","كالمرتجى ابن نصير معدن الخير",66,"ر",1,0],["وما أسكرت عيناك إلا لأنّني","سكبت بجفنيك الغويّين أسراري",67,"ر",2,0],["وما استباح عرين الحقّ طاغية","إلاّ وصرح عن أنيابه النّمر",68,"ر",1,0],["وما اسود ن ليل التقاطع آخر","من الوقت الاضاء بالوصل اولا",69,"ل",2,0],["وما استراح بذي الدنيا سوى سفل","لهم من الراح",70,"ح",1,0],["وما استبصرتمو منه برشد","وما استضويتمو منه ضياء",71,"ا",2,0],["وما أسرَ الطَّرفَ مثلُ امرىء","يبارزُ لامِحَه بالبهاءِ",72,"ا",2,0],["وَما اِستَأثَروا عَن كُلِّ عافٍ وَزائِرٍ","بِما كَسَبوهُ بِالرِماحِ الشَوارِعِ",73,"ع",1,0],["وَما أُسميهِ إِبقاءً لِوُدٍّ","سَلا عَنهُ وَما أَنا عَنهُ سالِ",74,"ل",1,0],["وَما اِستَفهَمتُ شَكّاً لِم بَغاهُ","فَما وَجَدَ الطَريقَ إِلَيهِ سَهلا",75,"ل",2,0],["وَما اِستَجاشَ نَصيراً نُطقُهُ كَذِبٌ","إِلّا لِيُمطى بَعيراً خَلقُهُ عَمَمُ",76,"م",1,0],["وما استولت الدنيا عليك وقد حوت","يمينك ما فيها من النفع والضر",77,"ر",1,0],["وما استويا سنّاً ولكن تَساوَيا","ولوعاً وحُبَّاً في الجوانحِ والصَّدر",78,"ر",1,0],["وما استوتِ النفوسُ بشكلِ جسمٍ","وهل ينبيكَ بالسيفِ الترابُ",79,"ب",1,0],["وما استماعي لكلام امرئٍ","يزيد في شوقي وتذكاري",80,"ر",2,0],["وما اسم خماسيٌّ صحيحٌ مذكرٌ","وليس بممدودٍ ويلزمه المد",81,"د",1,1],["وَما أسناهُ في عَينَيَّ وَجهاً","وَما أَحلاهُ في سَمعي كَلاما",82,"م",2,0],["وَما اسْتَنْهَضَتْ عَلْياكَ لِلصَّفْحِ والرِّضَى","وَإنْ عَظُمَ الإِجْرام إِلا وَفَتْ نَهْضَا",83,"ض",2,0],["وَما اسْوَدَّ وَجْهُ الخَطْبِ إلا سَمَا بِهِ","لِيَجْلُوَهُ طَلْقَ الأَسِرَّةِ مبيضَّا",83,"ض",2,0],["وَما اسْتَصْرَخْتُ فَيْضَ نَداكَ حَتّى","عَنانِي مِنْهُ بِالْحَرْبِ الزَّبُونِ",84,"ن",1,0],["وَما أَسَدٌ دامي الأَظافِرِ كاسِرٌ","وَفي الغيلِ أَعراسٌ لَدَيهِ وَأَشبالُ",85,"ل",1,0],["وَما اِستَطابَت لَهاةٌ","مَذاقَةَ البَطّيخِ",86,"خ",1,0],["وَما أَسَدٌ دامي الأَظافِرِ باسِلٌ","غَضوبٌ جَريءٌ في الكُماةِ جَريحُ",87,"ح",1,0],["وَما أَسِفتُ عَلى عَصرٍ قضيتُ به","عيشَ الشَبيبة في فَسحٍ من العُمُرِ",88,"ر",1,0],["وما اسمٌ رباعي الحروف وإنما","تركب من حرفين من رامها هدى",89,"د",2,1],["وما استوجبت مرآةُ خديه أنها","يغلفها ذاك العذارُ بجله",90,"ه",1,0],["وما أستلذ العيش في البعد عنهم","ولو كان ملك الأرض في قبضة اليد",91,"د",1,0],["وَما اِستَحالَت شُؤونٌ مِن هُنا وَعَنا","إِلّا بِحِكمَةِ فِعالٍ وَمُقتَدِرِ",92,"ر",1,0],["وَما اِستَقَمتُ فَما قَولي لَكَ اِستَقِمِ","النَفسُ كانَت عَنِ الإِحسانِ غافِلَةً",93,"ه",1,0],["وَما اِستبردوا مِنهُ سِوى خَمر ريقه","وَلا اِستَغلَظوا إِلّا مقرّ حُجولهِ",94,"ل",2,0],["وما اسْمِي غيرُ عبدِكَ َكيف أضحَى","مَكانيَ منكَ صَوْناً وابْتِذالا",95,"ل",2,0],["وَما اِسمُهُ عِندَكَ في مَوضِعٍ","فَهوَ عَلى لَفظِكَ حَيرانُ",96,"ن",1,0],["وَما أَسِدتُم عَلى أَعداءِ دَولَتِكُم","هَذا التَأَسُّدَ إِلّا بَعدَ ما كَلِبوا",97,"ب",3,0],["وَما اِستَغرَبَت عَينايَ قَفراً فَإِنَّني","خَرَجتُ وَبَيني مِثلُهُ صَفصَفٌ قَفرُ",98,"ر",1,0],["وما أَسلَفوني المالَ حتَّى تسلَّفَت","مَعاليكَ آمالي ولستَ بمُقترِ",99,"ر",1,0],["وما أسعد الصدّيقَ فيه وسعيُهُ","قويمٌ بنور الصدق في السر والجهر",100,"ر",1,0],["وما أسعدَ النساكَ إذ تم سعيهم","ورَدّوا هوى 