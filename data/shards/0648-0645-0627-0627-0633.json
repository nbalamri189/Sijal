["وَما اِستَنزَلَتني صَبوَةٌ عَن صِيانَةٍ","وَلكِنَّني مَع عِفَّتي سَأَقول",176,"ل",1,0],["وما استطال سحاب من جموعهم","إلا استطار به من لمعه الرهب",177,"ب",1,0],["وما استطار خُلَّبا لأنه","أومض يستمطر دمعي فَهَمَى",178,"م",2,0],["وما أسفى فيما اتاه وانما","أسفت كما لجوا على وزادوا",179,"د",3,0],["وما اسرَّته في تبليغنا رسل","لأنَّ مرسلهم هو الذي أفشى",180,"ش",2,0],["وما استقامتُه إلاَّ تمايلُه","فإنه عورةٌ والكلُّ عورته",181,"ت",2,0],["وما أسعد السرداب في سرِّ من رأى","وأسعد منه مكة فلها البشر",182,"ر",1,0],["وما اسمٌ لِسَميَّينِ","ولم يجمعهما جِنسُ",183,"س",1,1],["وما اسم لشيء يبتغي النَّاس أخذه","فكم من فتى قد نال منه نَصيبَا",184,"ب",2,1],["وما أسعد السرداب حظاً ولا تقل","له الفضل عن أم القرى وله الفخر",185,"ر",1,0],["وما استخلصت ودي سوى محنة النوى","وقوف عليها بالخلوص الثنائيا",186,"ي",2,0],["وما استنجدتُ فخر الدين إلاّ","وجدتُ به النجاة بَلِ النَّجَاحَا",187,"ح",2,0],["ومَا استزدتُ بشيبِ الرأس منقصةٌ","فالبازُ مخْلَبُه يَدمي مع الهرمِ",188,"م",1,0],["وما استهواك من هند جمال","ولا سحرتك عين بابليه",189,"ي",2,0],["وَما اِستَخبَيتُ في رَحلٍ خَبيئاً","كِدينِ الصِدقِ أَو حَسَبٍ عَتيقِ",190,"ق",1,0],["وَما اسمٌ خُماسيٌّ إِذا ما فَكَكتَه","يَصيرُ لَنا فِعلينِ أَمراً وَماضيا",191,"ي",2,1],["وَما اِستَلأموا حِرزا وَلَكنَّ لأمَهُم","بُرُودُهُم في المَعرَكِ المُتَلاحِمِ",192,"م",1,1],["وما اسمٌ مفردٌ ويفيدُ جمعاً","له في كلّ موجودِ نصيبُ",193,"ب",1,1],["وما اسم نجم في السما يحكى","مفهومه اسمان بالنزكي",194,"ي",1,1],["وَما اِستقمت فَما قَولي لك اِستقم","وَلا صحبت لحج البيت قافلة",195,"ه",1,0],["وما استمطرت عيني سحابة ريبة","لديك ولا مست يميني سخابك",196,"ك",1,0],["وما اسروا إلا الكريم الذي اغتدى","مثال المساعي الغرّ والحسب العد",197,"د",1,0],["وما أسعدت سعد هواه بنظرة","ولا جاملته في محبتها جمل",198,"ل",1,0],["وما أسفى الا على مدح معشر","خلائقهمِ شيدت على المين والبطل",199,"ل",1,0],["وما آس عارضك المستني","ر كالقلب مني في حرقته",200,"ت",2,0],["وما أسهرت عيني في احتفاظ","بنادرة أقررها بنادي",201,"د",2,0],["وَما اِستَردَفَت خَيلُ الهُذَيلِ نِساءَنا","وَلا قُمنَ في صَفٍّ لِسَجحَةَ سُجَّدا",202,"د",2,0],["وما استنصروا غير الصوارم ناصرا","وأغنتهم عمن أتى متنصرا",203,"ر",2,0],["وما استبطأتُ كفَّكَ في نَوالٍ","على عدواءِ نأيٍ واقْتِرابِ",204,"ب",1,0],["وما استبقى له في الرفقِ جُهداً","ولا في الذَّبِ عنه والدِّفاعِ",205,"ع",1,0],["وما استصحبَ الفتيانُ مثل مثقفٍ","يُماجُ به ماءُ القلوبِ ويُمنَحُ",206,"ح",1,0],["وما أسَفي إلاّ عليْكَ فخصَّني","بكتبكَ إنّي بالقَراطيسِ قانِعُ",207,"ع",1,0],["وما استظل به الضاحي بقائلة","الا بظل ظليل غير منتقل",208,"ل",1,0],["وَما اِسمٌ مالَه جِسمٌ وَلكِن","لَدى الآمان رُؤيَتَهُ سنيَّه",209,"ي",2,1],["وَما اسوَدَّ فيهِ الخالُ صبغاً وَإِنَّما","لفرط لَهيبٍ يَصطَليهِ حَريقا",210,"ق",2,0],["وَمَا استَحَقَّ قَبلَ آخِرٍ ألِف","فَالمَدُّ فِى نَظِيرِهِ حَتماً عُرِف",211,"ف",1,0],["وما استنَزلَ الأجفانَ من عَبَراتِها","ولا سِيّما أن اقفرت كالمنازل",212,"ل",1,0],["وما استحسنت عين البرية منعماً","كمثل الذي في خطبهم جاد منعما",213,"م",2,0],["وما اسمٌ على حرفينِ جاءَ ثلثةً","لتعريفهِ أَل لا لتعريفِ عدِّهِ",214,"د",2,1],["وما اسمٌ سما في دَورِهِ حينما أَتَى","بفعلٍ هُوَ اسمٌ أَوَّل الخلقِ كُلِّه",215,"ل",2,1],["وما اسمٌ يعمُّ الحَزنَ والسَهلَ طَردُهُ","وفي قلبهِ قد ساغَ اكلُ البهائِمِ",216,"م",1,1],["وما أسأتُ ولكن","حسدتني منك قربي",217,"ب",2,0],["وما أسجد الله الملائكَ كلَّهُمْ","لآدم إلا أنَّ في نسلهِ مثلي",218,"ل",2,1],["وَما اِستَدارَ الصِدغُ في ناعِمٍ","مُوَرِّدٍ كَاللَهَبِ المُشعَلِ",219,"ل",1,0],["وَمَا أسْنَدَ الوَاشِي وَعَنْعَنَ مُنْكَرٌ","لَدَيْهِ وَمَتْرُوكٌ وَمَا كَانَ يُنْقَلُ",220,"ل",1,0],["وما أسفي على الأيام إلا","على إبل حداها غير حاد",221,"د",1,0],["وما استنكرتَ من وحشٍ بقفرٍ","رأينَ الانس فاستقبلنَ ريحا",222,"ح",2,1],["وَما اِستطاعَ بَنو الطُروادِ صضدَّهُمُ","بَلِ اِستَوى في مَجالِ الفَتكِ هائِلُهُ",223,"ه",1,0],["وما أسفي حقا على موت انور","فأني على من مات لا اتكدر",224,"ر",1,0],["وما استنكفت من جدواك لكن","كفاني بذل ودك عن لهاكا",225,"ك",2,0],["وما آسفاً ما إن مضي الدهر كله","هباء إذا أبصرت وجهك آنا",226,"ن",2,0],["وما أَسداهُ مِن برٍ","بلا عدٍ ولا حصرِ",227,"ر",1,0],["وما أَسعدَ المَلْكَ الذي نحوَ بابهِ","مطايا بأَبناءِ الرَّجاءِ غدتْ تَمْطوا",228,"ط",3,0],["وما اسْتَقَمْتُ فَما قَولي لكَ اسْتَقمِ","أَفْنيْتُ أَيّامَ عُمْرِي الغَضِّ كامِلَةً",229,"ه",1,0],["وما اسم الشمس ليس الشمس إلا","أبا نصر فصنه عن اشتراك",230,"ك",1,1],["وما استنارت بذاتِ الطَّلحِ نيِّرةٌ","إن غاب عنها الحيا حيَّا بها الطفل",231,"ل",1,0],["وما استحسانه كلمى سوى من","طباع فيه طين على الصداق",232,"ق",1,0],["وما اسْتَعْصَتْ عليهِ جراح نفسي","كأنْ للسّحر قدْ خلِقَتْ يداه",233,"ه",1,0],["وما أساتذةُ العربِ الكرامِ سوى","أسلافِ ناظمِ هذه صفوةِ الكلمِ",234,"م",1,0],["وما استمعنا لصوتِ الشّوق في طربٍ","يهدهد الروحَ باللّقيا يمنّينا!",235,"ن",2,0],["وما استطالت جموع للعدى وأبت","إلا النزال ونار الحرب تلتهب",236,"ب",1,0],["وما استطاعوا احتواء المَدِّ حين رأوا","نورا حوى الحق في الإصباح منبلجا",237,"ج",2,0],["وما استجدت حاجة أيقظت","فينا انتباها ترجمت في حروف",238,"ف",1,0],["وَمَا اسْتَوَتِ الْآرَاءُ فِي رَأْبِ حُلْمِهُمْ","لِذَا لَجَئُوا سِرّاً إِلَى رَدِّ عِصْيَانِ",239,"ن",1,0],["وما اسمٌ اصلهُ نَبتٌ","ولكن قلبهُ دَسَمُ",240,"م",1,1],["وما اسْتُبِيحَ حِمى قَوْمٍ يُسَيِّجُهُ","نَزْفُ الصُّدورِ، وَسَيْفٌ هَزَّهُ رَجُلُ",241,"ل",1,0],["وما استطعت فصح في الناس مرتعشاً","تحمساً لمقالٍ غير متزن",242,"ن",1,0],["وما اسْتَعْصى سِوى الإبريزِ مَهْمَا","تَراكَمَتِ الوُحولُ على الُوحُولِ",243,"ل",1,0],["وما استقبح الإنسان إلا لحسنه","وما أنكرته الناس إلاّ ليعرفا",244,"ف",2,0],["وما استحقت بأن يدمي الفؤاد لها","من بعلها وسيل القلب منفطرا",245,"ر",2,0],["وما أسْرَفْتُ فيْ طَلب الامَاني","ولا طَاوعْتَهَا في غَيْر طَاعَة ْ",246,"ع",2,0],["وَماإسْترْعيتُ مِنْ خَفَرات قَوْمي","إذا ما الرُّوحُ لامَسَتِ الخفارا",247,"ر",2,0],["وما استحى وجمال الغيد جللها","بهالة فانتهى للأمس وادكرا",248,"ر",2,0],["وما أسطاعوا مواجهةً ونصراً","فهذيْ الأرضُ يحميها الرِجالُ",249,"ل",1,0],["وما استطاب بهذا العيش مؤتلفا","فمات بالهم وما ترضاه عيناه",250,"ا",2,0],["وما استمالتْ هوى بالنفس تحرزه","بما استطابت بنا لم تدْنه العللُ",251,"ل",1,0],["وما اسْتطابَ سليمانٌ لها شَرَكاً","وما أرادَ سقوطاً في حبائلِها",252,"ل",3,0],["وما أسفي على عمرٍ نبدده","وسيف الموت منتظرٌ ليلقانا",253,"ن",2,0],["وما أسفت على فعلي فليس على","من لا لهم قيمةٌ لو عفتهم أسف",254,"ف",1,0],["وما اسطعت لله أمنيّتي","بأن يمنح العالمين الهنا",255,"ن",2,0],["وما أسِفْتُ على نزفي ووأدِ غدي","ولا على كبرياءِ المطمح ِ افْتُرِعا (4)",256,"ع",2,0],["وما استطاعتْ حروفي أن تخاطَبهَا","فضاقَ بالحرفِ في الخفَّاقِ غسَّانُ",257,"ن",1,0],["وَ مَا اسْتَقَرَتْ بِهِ دَارٌ وَ لَا وَطَنٌ","وَ لَا تَدَفَأ فِي نِيرَانِه البَشَرُ",258,"ر",1,0],["وَمَا أسم رباعي إِذا مَا عددته","ترَاهُ بِلَا شكّ يزِيد على عشر",259,"ر",1,1],["وما أسعد الإنسان إن عاش لاهياً","عليه تمرّ العاديات ولا يدري!",260,"ر",2,0],["وما استكنّتْ إلى الأعماقِ زاحفةٌ","إلاّ لتحيا ولا عينٌ ولا رَصَدُ",261,"د",1,0],["وما استطعمتْ نفسي طعاماً بلذّة","ولا استعذبتْ من بَعْدِ بُعْدِك مَشْرَبا",262,"ب",2,0],["وما أسديت من خير","لهم بعض مزاياكا",263,"ك",2,0],["وَ مَا اسْتَسْلَمْتُ لا أَبْغِي سَلاماً","أَحِبِّذُ كُلَّ أَفْكَارِ الفَنَاءِ",264,"ا",2,0],["وما استفقنا وفي صحراءِ خَيبتِنا","قارونُ يبحثُ في الأموات ِ عن سَلَبِ",265,"ب",1,0],["وما استغفروا أشلاءَنا أو ركامنا","ولسنا نبقّي اليوم منهم بواقيا",266,"ي",2,0],["وما استوعبت من علمه بعض علمه","وقد عجزت أن تجتذت كل صورتي",267,"ت",2,0],["وما استوطنته فهو بيت مقدس","وما جنها المأوى به بيت عزتي",267,"ت",2,0],["وما أستطيع أغرّد حقاً","إذا لا أميل معاً حيث مالوا",268,"ل",3,0],["وما أسفي إلا عليها فإنني","بقرطاسها لا بالدنانير أكلف",269,"ف",1,1],["وَمَا اسْتدَامَ المُلكُ في زَمَنٍ","أو خُلِّدَ امْرءٌ علَى الأَدَمِ",270,"م",1,0],["وما أسعد السرداب في سر من رأى","له الفضل عن أم القرى وله الفخر",271,"ر",1,0],["وما استعنت بأوراق تدونها","لذا صلبت عراقا فوق قبتهِ",272,"ت",2,0],["وما استعرتُ هواه من ملازمَةٍ","لكنَّه دمُ آباءٍ وأخْوالِ",273,"ل",1,0]]}