َامَت لِمَلْكٍ قطُّ مملكةٌ","إِلاَّ إِذا قَصَدَ النَّهجَ الَّذِي قَصَدَا",127,"د",2,0],["وما أسفي إِلاَّ على قُرب ملكِه","وما حَزَنِي إِلاَّ على مُلك قُرْبِه",128,"ب",2,0],["وَما أَسَدٌ من أُسودِ العَرينِ","يعتَنِقُ السائلينَ اِعتِناقا",129,"ق",2,0],["وَمَا اسْمٌ بِلا جِسْمٍ وَتُمْسِكُه يَدٌ","وَأَحْقَرُ شَيْءٍ فيهِ أَشْرَفُ ما فيهِ",130,"ه",1,1],["وما استقال من علاً","لكن بحملها استقل",131,"ل",1,0],["وَما اِستَعبَدَ الرُهبانَ بِالدَيرِ مِنهُما","وَلَم يَستَحِلّا لا حَراماً وَلا نَجسا",132,"س",2,0],["وما آسَى عَلَى شَيءٍ تَوَلّى","وهَل آسَى عَلَى خَلعِي نِعالِي",133,"ل",2,0],["وَما أَسعَدَ اللَيلُ الَّذي أَنا ساهِرُهُ","وَما أُقَدِّسُ الدَمعَ الَّذي أَنا سافِحُهُ",134,"ح",2,0],["وما استغربت سري النجوم أبثها","كما استغربت أهل العداء جهاري",135,"ر",2,0],["وَما أَسفي إِلا عَلى خُلف مَوعدٍ","عَدلتَ بِهِ في الحكم عَن مَنهَج الحَق",136,"ق",1,0],["وَما اِستعبَرَ العُشّاقُ إِلّا ليَدفَعوا","يَدَ الحُزنِ جَهلاً عَن قلوب بِأَبصارِ",137,"ر",1,0],["وَما اِستكثَروا مِن أَدمع مستهلّةٍ","نَهار اِستَقلّوا لِلرَحيل اِنهمالها",138,"ل",3,0],["وما أسَفي أنْ مَرَّ ما مرَّ فانْقَضى","ولكنَّ هَمِّي ما بَقِيْ مِنْ زَمانِيا",139,"ي",2,0],["وما استوى القصد منكم والغلوُّ لها","وليس من راح يغريها كم شفعا",140,"ع",2,0],["وما استبداد قيصر في رعايا","أضاعوا العمر من نَقَهٍ لِنَكْس",141,"س",1,0],["وما استطاع إلى ملقاك مرحلة","وعلة الجسم تمشي في بقاياه",142,"ا",2,0],["وما استجمعوا للحكم إلا وسبْلهم","إليه الأذى والكيد والإفك والدم",143,"م",1,0],["وَما اِستَكمَلَت في الفِكرِ مدّةَ حَملِها","فَلا بِدْعَ أَنّ النّقصَ فيها لَقَد يلفى",144,"ف",2,0],["وما أُسمِّيهِ لكنِّي نَعَتُّ لكُمْ","نعتاً أدُلكمُ فيه على الرَّجُل",145,"ل",1,0],["وَما اِستَطَعت اِبعِد عَنِ النسوانِ","إِنَّ النِسا حَبائِلَ الشَيطانِ",146,"ن",1,0],["وما استُودعتَ فاحفْظه","وعادى كلَّ من خانا",147,"ن",2,0],["وما أَسْمَعت نفسي الجهول مقالةً","من الوعظ إلا سار عنيَ مُعرضا",148,"ض",2,0],["وما استكفى بملك العرب حتى","تسنم صهوة من ملك كسرى",149,"ر",2,0],["وما استحالوا عن الدار التي تركوا","عَنّي كأن فؤادي طائرٌ عَلِقُ",150,"ق",1,0],["وما است