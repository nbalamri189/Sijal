n.net/poem17126.html","الرجز"],[367,"أما ومنك على أعدائك الطلب","https://www.aldiwan.net/poem17155.html","البسيط"],[367,"ليهن الذي تسري إليك ركابه","https://www.aldiwan.net/poem17209.html","الطويل"],[372,"أرى غير الأيام تسطو ولا أرى","https://www.aldiwan.net/poem57395.html","الطويل"],[378,"أيا أغنياء الروح صونوا كنوزَكم","https://www.aldiwan.net/poem59426.html","الطويل"],[406,"نصيبك من سفيه أو فقيه","https://www.aldiwan.net/poem49714.html","الوافر"],[410,"دع ما نهى الشيب والسبعون عنه","https://www.aldiwan.net/poem31981.html","البسيط"],[417,"سنا برق تبلج واستنارا","https://www.aldiwan.net/poem54050.html","الوافر"],[417,"ألما على لومي وجدا مجددا","https://www.aldiwan.net/poem54134.html","الطويل"],[417,"ألا من مبلغ عني سلامي","https://www.aldiwan.net/poem54135.html","الوافر"],[417,"إلى شعبان مولاي المفدى","https://www.aldiwan.net/poem54139.html","الوافر"],[417,"متى يشفى بك الصب العميد","https://www.aldiwan.net/poem54140.html","الوافر"],[417,"أتذكر أطلالا تعفت وأرسما","https://www.aldiwan.net/poem54191.html","الطويل"],[433,"لو لم يحرم على الأيام إنجادي","https://www.aldiwan.net/poem12352.html","البسيط"],[433,"نضا عضبا من الجفن","https://www.aldiwan.net/poem12740.html","الهزج"],[454,"أنا الجنين وهذى الأرض من قدم","https://www.aldiwan.net/poem61768.html","البسيط"],[459,"ظل المنى واسع والشمل ملتئم","https://www.aldiwan.net/poem55869.html","البسيط"],[459,"أتعلمين يا ابنة الأعاجم","https://www.aldiwan.net/poem55879.html","الرجز"],[459,"تراك ترى غدوا أو أصيلا","https://www.aldiwan.net/poem56078.html","الوافر"],[462,"أجل ما رمت في آت مقتبل","https://www.aldiwan.net/poem15134.html","البسيط"],[462,"عليك ذمام الله ما ذر شارق","https://www.aldiwan.net/poem15694.html","الطويل"],[465,"لقد أصبحت في سلطان ملك","https://www.aldiwan.net/poem3452.html","عموديه"],[483,"وما حيوان في الرياض ممايلا","https://www.aldiwan.net/poem24324.html","عموديه"],[483,"من هو أصل وجود","https://www.aldiwan.net/poem24334.html","عموديه"],[525,"نبي له في كل فضل تقدم","https://www.aldiwan.net/poem13291.html","الطويل"],[552,"أنتم علي وإن لم","https://www.aldiwan.net/poem47175.html","المجتث"],[552,"على المزمعين البين منا عشية","https://www.aldiwan.net/poem47317.html","الطويل"],[552,"تقول لي إنما الستون مقطعة","https://www.aldiwan.net/poem47829.html","البسيط"],[554,"استمطر العين أن أحبابه احتملوا","https://www.aldiwan.net/poem68393.html","البسيط"],[565,"أجودُ ابن زين أو غيوثُ سواجم","https://www.aldiwan.net/poem890.html",""],[576,"مديحك كالمسك لا يكتتم","https://www.aldiwan.net/poem3006.html","المتقارب"],[576,"لو واصلتني يوما لم أمت أبداً","https://www.aldiwan.net/poem3080.html","البسيط"],[576,"أذم زماناً حال بيني وبينه","https://www.aldiwan.net/poem3097.html","الطويل"],[584,"كبيشة عرسي تمنى الطلاقا","https://www.aldiwan.net/poem443.html",""],[587,"وما اسم بلا جسم وتمسكه يد","https://www.aldiwan.net/poem17838.html","الطويل"]],"verses":[["وَما أُسَرُّ بِمالٍ لا أَعُزُّ بِهِ","وَلا أَلَذُّ بِرَأيٍ فيهِ تَفنيدُ",0,"د",1,0],["وَما أَسَفي إِلّا عَلى ما جَلَوتُهُ","عَلى سَمعِ مَنزورِ النَوالِ نَضوبِهِ",1,"ب",2,0],["وَما اسْتَهْدَفَتْ لِلْذُّلِّ حينَ تَكَدَّرَتْ","عَلَيْها اللَّيالي فَالقَناعَةُ جُنَّتي",2,"ت",2,0],["وَمَا اسْتَرْعَفَتْ مِنْ لَبَّةِ القِرْنِ صَعْدَتِي","وَلَمْ يَتَلَمَّظْ بَيْنَ أَوْداجِه عَضْبي",3,"ب",2,0],["وما اسْمُ شيءٍ إذا صحّفْتَ ثانيَهُ","فاذْكُرْ بهِ رجُلاً قد طالَ في ضجَرِ",4,"ر",1,0],["وَمَا اسْتَعْبَرْتُ مِنْ طَرَبٍ وَلكِنْ","يُذَكِّرُنِي الرَّبَابُ هَوَى الرَّبَابِ",5,"ب",1,0],["وَما استَخبَأتُ في رِجُلٍ خَبيئاً","كَدينِ الصِدقِ أَو حَسَبٍ عَتيقِِ",6,"ق",1,0],["وما استَبَدَّ برأْيٍ في حُكومَتِه","إنّ الحُكومَةَ تُغري مُستَبِدِّيها",7,"ي",3,0],["وَما اِستَعبَدَ الأَحرارَ كَالعَفوِ إِن جَنى","جَهولٌ وَفَضلُ الصَدرِ في سَعَةِ الصَدرِ",8,"ر",1,0],["وَما اِستَبهَمَ القُفلُ في الحادِثا","تِ إِلّا رَآكَ لَهُ مِقلَدا",9,"د",2,0],["وَما اِستنَّ رَقراقُ السَرابِ وَما جَرى","بِبيضِ الرُبى وَحشِيُّها وَنَوارُها",10,"ر",3,0],["وَما اِستنَّ رَقراقُ السَرابِ وَما جَرَت","مِنَ الوَحشِ عَصماءُ اليَدينِ نَوارُ",11,"ر",1,0],["وَمَا أَسْبَابُ أَدْوَائِهِمْ","وَكُلُّهُمْ لَوْ نُفِيَتْ ضَيْغَمُ",12,"م",1,0],["وَمَا اسْطَاعَ يُلْفِيهِ الغَدَاةَ وَلِيُّهُ","مُعِيناً عَلَى دَفْعِ الأَذَى وَالمَغَارِمِ",13,"م",1,0],["وَما اِستَفَدتَ مِنَ الديوانِ فائِدَةً","فيما عَلِمتُ سِوى نَشرُِ الطَواميرِ",14,"ر",1,1],["وَما استَعهَدَ الأَقوامُ مِن ذي خُتونَةٍ","مِنَ الناسِ إِلّا مِنكَ أَو مِن مُحارِب",15,"ب",1,0],["وما استنزلت في غيرنا قدرُ جارنا","ولا ثُفيت إلا بناحين تُنْصَبُ",16,"ب",1,1],["وَما اِستَمتَعتُ مِن داعي التَصابي","إِلى أَن جاءَني داعي الوَقارِ",17,"ر",1,0],["وما أسَفي إنَّ الثواء يفوتني","ولكن لقدرٍ عند غيرك ضائع",18,"ع",1,0],["وما استدخل الأير من حاجةٍ","ولكن به المذهب الأكبرُ",19,"ر",1,0],["وما استطرف الأقوام لي فيه طُرفةً","لأني ما عرَّفتهم فيه منكرا",20,"ر",2,0],["وما استفدت من الديوان فائدةً","فيما علمنا سوى نشر الطوامير",21,"ر",1,0],["وما استدخل الأيرَ من شهوةٍ","ولكن به المذهبُ الأكبر",22,"ر",1,0],["وما استمتعوا من صدر أمٍّ بضمةٍ","ولا سقطوا في قعر مهد ولا حجر",23,"ر",1,0],["وما اسْتَكْتَمت تلك الوصاوصُ أَوجُهاً","قِباحاً ولا ألوانَ سودٍ عَنافِص",24,"ص",1,0],["وما استطرفَ الأقوامُ لي فيك مِدحةً","لأني بما علَّمتهم بك من جهلِ",25,"ل",1,0],["وما استبطأْتُ طولك في عتابي","كما يستبطِئُ الخَرِقُ العَجُولُ",26,"ل",1,0],["وَما أَسَفي إِلّا عَلى القُربِ مِنكُمُ","إِذا شَطَّ عَنّي دارُكُم أَو نَأَيتُمُ",27,"م",1,0],["وَما أَسَفي إِلّا عَلى القُربِ مِنكُمُ","وَلَستُ عَلى شَيءٍ سِواهُ بِآسِفِ",28,"ف",1,0],["وَما اِستَطرَفَت نَفسي حَديثاً لِخلَّةٍ","أُسِرّ بِهِ إِلّا حَديثُكِ أَطرَفُ",29,"ف",1,0],["وما استقبلت إلا ضياها تعيره","دليل الهوى من نورها ويعير",30,"ر",1,0],["وما استوى المرء يطوى ذكره معه","وذاهب فضله في الناس ما ذهبا",31,"ب",2,0],["وَما أُسطولُهُم في البَحرِ إِلّا","شَخاشِخُ ما يَرُحنَ وَما يَجينا",32,"ا",1,0],["وَما اِستَعصى عَلى قَومٍ مَنالٌ","إِذا الإِقدامُ كانَ لَهُم رِكابا",33,"ب",2,0],["وَما اِستَغرَقتُ وَصفَكَ في مَديحي","فَأَنقُصَ مِنهُ شَيئاً بِالهِجاءِ",34,"ا",2,0],["وَما اِستَغرَبَت عَيني فِراقاً رَأَيتُهُ","وَلا عَلَّمَتني غَيرَ ما القَلبُ عالِمُه",35,"م",2,0],["وَما اِستَعَنتُ عَلى دارٍ وَإِن بَعُدَت","كَالمُرتَجى بنِ نُصَيرٍ مَعدِنِ الخيرِ",36,"ر",1,0],["وَما أَسَرَّت أُمُّ العِيالِ سُروراً","مُنذُ قالوا أَبو العِيالِ يُناكُ",37,"ك",1,0],["وَما أَسَدٌ وَلِيُّ يَدٍ فَتُرجى","نَوافِلُهُ وَلا مَولى جَميلِ",38,"ل",1,0],["وَما اِستَثقَلوا مِن مُدَّةٍ قَد تَكامَلَت","وَمِن عُمُرٍ لَم يَبقَ إِلّا أَقَلُّهُ",39,"ل",2,0],["وَما اِستَدَرَّت جُفونُ العَينِ إِذ بَكَأَت","أَخلافَ دِرَّتِها كَالنُؤيِ وَالطَلَلِ",40,"ل",1,0],["وَما اِستَعهَدَ الأَقوامُ مِن زَوجِ حُرَّةٍ","مِنَ الناسِ إِلّا مِنكَ أَو مِن مُحارِبِ",41,"ب",1,0],["وَما اِستَرَبتَ فَكُن وَقّافَةً حَذِراً","قَد يُبرَمُ الأَمرُ أَحياناً فَيَنتَقِضُ",42,"ض",1,0],["وما اسم تراه في البروج وإنما","يحل به المريخ دون الكواكب",43,"ب",1,1],["وما اسم له شطر صحيح منطق","يعد بلا كسر وأحرفه خمس",44,"س",1,1],["وما استنطقْتُ من طَلَلٍ صَموتٍ","كأنّ له إشاراتِ الكليمِ",45,"م",1,0],["وَما أَسهَرُ الظَلماءَ إِلّا لَعَلَّهُ","يُنَشِّقُني الخَيرِيُّ مِن نَشرِهِ عَرفا",46,"ف",2,0],["وَما أَسَفي أَنّي أَموتُ وَإِنَّما","حِذارِيَ أَن تُرمى بِلُؤمِ الطَبائِعِ",47,"ع",1,0],["وَما أَساؤوا فِراراً عَن مُجَلِّيَةٍ","لا كاهِنٌ يَمتَري فيها وَلا حَكَمُ",48,"م",1,0],["وَما اِستَعَنتُكِ إِلّا","أَبرَقتِ لي وَرَعَدتِ",49,"ت",1,0],["وَما اِستَغلى أَبو العَبّاسِ مَدحاً","وَلَم يَكثُر عَلَيهِ لَهُ كَثيرُ",50,"ر",1,0],["وَما اِستَفرَغَ اللَذّاتِ إِلّا مُشَيَّعٌ","إِذا هَمَّ لَم يَذكُر رِضى مَن تَغَضَّبا",51,"ب",2,0],["وَما أُسَرُّ لِتَعشيرِ الغُرابِ أَسىً","وَلا أُبَكّي خَليطاً حَلَّ تِعشارا",52,"ر",2,0],["وَما أَسأَلُ الأَحياءَ بَعدي زِيارَةً","ثَلاثاً لإِيناسِ الدَفينِ وَلا سَبعا",53,"ع",2,0],["وَما أُسائِلُ عَن شَخصٍ لِمَولِدِهِ","عَشرٌ وَتِسعونَ إِلّا قيلَ قَد هَلِكا",54,"ك",2,0],["وَما اِستَفَزَّهُما الاِمهالُ فَاِدَّعَيا","بِالجَهلِ ما قالَهُ المَغرورُ وَاِنتَحَلا",55,"ل",2,0],["وَما أَسيتُ عَلى الدُنيا مُزايَلَةً","وَلا تَأَسَّت عَلى البالي مِنَ الرِمَمِ",56,"م",1,0],["وَما اِستَراحَ لَعَمري مِن سَوائِلِها","إِذا طَغى مائُها إِلّا سَواليها",57,"ي",3,0],["وما استَعذَبَتهُ روحُ موسى وآدَمٍ","وقد وُعِدا من بعدِه جَنَّتَيْ عَدْنِ",58,"ن",1,0],["وما أُسمِّي فتىً شتَّى مناقبُهُ","إنَّ المناقب للفتيان أسماءُ",59,"ا",2,0],["وَما اِستَمكَنَت عَيني مِنَ النَظَرِ الَّذي","أُداوي بِهِ قَلبي وَأَشفي بِهِ صَدري",60,"ر",2,0],["وما اسم شيء إذا صحفت ثانيه","فاذكربه رجلا قد طال في صحر",61,"ر",1,0],["وما استفرغَ اللَّذَّات إلاَّ مُقابلُ","إذا همَّ لمْ يذكرْ رضى منْ تغضَّبا",62,"ب",2,0],["وما استجاب له منهم سوى نفر","فى الله ما عذبوا فى الله ما ضربوا",63,"ب",3,0],["وما اسطعت فاقطع يد المُعْتَدَي","عليه وقبّلْ يدَ المُعتَدي",64,"د",2,0],["وما أسْتَعْبَدَ الْحُرَّ الكَريمَ كَنِعْمَةٍ","يَنَالُ بِها عَفواً ولَمْ يَتَكَلَّمِ",65,"م",1,0],["وما استعنت على دار وإن بعدت","كالمرتجى ابن نصير معدن الخير",66,"ر",1,0],["وما أسكرت عيناك إلا لأنّني","سكبت بجفنيك الغويّين أسراري",67,"ر",2,0],["وما استباح عرين الحقّ طاغية","إلاّ وصرح عن أنيابه النّمر",68,"ر",1,0],["وما اسود ن ليل التقاطع آخر","من الوقت الاضاء بالوصل اولا",69,"ل",2,0],["وما استراح بذي الدنيا سوى سفل","لهم من الراح",70,"ح",1,0],["وما استبصرتمو منه برشد","وما استضويتمو منه ضياء",71,"ا",2,0],["وما أسرَ الطَّرفَ مثلُ امرىء","يبارزُ لامِحَه بالبهاءِ",72,"ا",2,0],["وَما اِستَأثَروا عَن كُلِّ عافٍ وَزائِرٍ","بِما كَسَبوهُ بِالرِماحِ الشَوارِعِ",73,"ع",1,0],["وَما أُسميهِ إِبقاءً لِوُدٍّ","سَلا عَنهُ وَما أَنا عَنهُ سالِ",74,"ل",1,0],["وَما اِستَفهَمتُ شَكّاً لِم بَغاهُ","فَما وَجَدَ الطَريقَ إِلَيهِ سَهلا",75,"ل",2,0],["وَما اِستَجاشَ نَصيراً نُطقُهُ كَذِبٌ","إِلّا لِيُمطى بَعيراً خَلقُهُ عَمَمُ",76,"م",1,0],["وما استولت الدنيا عليك وقد حوت","يمينك ما فيها من النفع والضر",77,"ر",1,0],["وما استويا سنّاً ولكن تَساوَيا","ولوعاً وحُبَّاً في الجوانحِ والصَّدر",78,"ر",1,0],["وما استوتِ النفوسُ بشكلِ جسمٍ","وهل ينبيكَ بالسيفِ الترابُ",79,"ب",1,0],["وما استماعي لكلام امرئٍ","يزيد في شوقي وتذكاري",80,"ر",2,0],["وما اسم خماسيٌّ صحيحٌ مذكرٌ","وليس بممدودٍ ويلزمه المد",81,"د",1,1],["وَما أسناهُ في عَينَيَّ وَجهاً","وَما أَحلاهُ في سَمعي كَلاما",82,"م",2,0],["وَما اسْتَنْهَضَتْ عَلْياكَ لِلصَّفْحِ والرِّضَى","وَإنْ عَظُمَ الإِجْرام إِلا وَفَتْ نَهْضَا",83,"ض",2,0],["وَما اسْوَدَّ وَجْهُ الخَطْبِ إلا سَمَا بِهِ","لِيَجْلُوَهُ طَلْقَ الأَسِرَّةِ مبيضَّا",83,"ض",2,0],["وَما اسْتَصْرَخْتُ فَيْضَ نَداكَ حَتّى","عَنانِي مِنْهُ بِالْحَرْبِ الزَّبُونِ",84,"ن",1,0],["وَما أَسَدٌ دامي الأَظافِرِ كاسِرٌ","وَفي الغيلِ أَعراسٌ لَدَيهِ وَأَشبالُ",85,"ل",1,0],["وَما اِستَطابَت لَهاةٌ","مَذاقَةَ البَطّيخِ",86,"خ",1,0],["وَما أَسَدٌ دامي الأَظافِرِ باسِلٌ","غَضوبٌ جَريءٌ في الكُماةِ جَريحُ",87,"ح",1,0],["وَما أَسِفتُ عَلى عَصرٍ قضيتُ به","عيشَ الشَبيبة في فَسحٍ من العُمُرِ",88,"ر",1,0],["وما اسمٌ رباعي الحروف وإنما","تركب من حرفين من رامها هدى",89,"د",2,1],["وما استوجبت مرآةُ خديه أنها","يغلفها ذاك العذارُ بجله",90,"ه",1,0],["وما أستلذ العيش في البعد عنهم","ولو كان ملك الأرض في قبضة اليد",91,"د",1,0],["وَما اِستَحالَت شُؤونٌ مِن هُنا وَعَنا","إِلّا بِحِكمَةِ فِعالٍ وَمُقتَدِرِ",92,"ر",1,0],["وَما اِستَقَمتُ فَما قَولي لَكَ اِستَقِمِ","النَفسُ كانَت عَنِ الإِحسانِ غافِلَةً",93,"ه",1,0],["وَما اِستبردوا مِنهُ سِوى خَمر ريقه","وَلا اِستَغلَظوا إِلّا مقرّ حُجولهِ",94,"ل",2,0],["وما اسْمِي غيرُ عبدِكَ َكيف أضحَى","مَكانيَ منكَ صَوْناً وابْتِذالا",95,"ل",2,0],["وَما اِسمُهُ عِندَكَ في مَوضِعٍ","فَهوَ عَلى لَفظِكَ حَيرانُ",96,"ن",1,0],["وَما أَسِدتُم عَلى أَعداءِ دَولَتِكُم","هَذا التَأَسُّدَ إِلّا بَعدَ ما كَلِبوا",97,"ب",3,0],["وَما اِستَغرَبَت عَينايَ قَفراً فَإِنَّني","خَرَجتُ وَبَيني مِثلُهُ صَفصَفٌ قَفرُ",98,"ر",1,0],["وما أَسلَفوني المالَ حتَّى تسلَّفَت","مَعاليكَ آمالي ولستَ بمُقترِ",99,"ر",1,0],["وما أسعد الصدّيقَ فيه وسعيُهُ","قويمٌ بنور الصدق في السر والجهر",100,"ر",1,0],["وما أسعدَ النساكَ إذ تم سعيهم","ورَدّوا هوى اللذات بالسود والصفر",100,"ر",1,0],["وما استوفى شُروطَ الجدِّ إلاّ","فتىً في خُلْقِهِ سَهْلٌ وحَزْنُ",101,"ن",1,0],["وما أساءت بك الأيامُ إذ جَعلتْ","فَودَيك دُرّاً وكانا قبلَه سَبَجَا",102,"ج",2,0],["وما استَقْصَتْ مدائحك القوافي","نظاماً في علاك ولا نثارا",103,"ر",2,0],["وما أسفي إلاَّ على عُمْر مغرم","قضاه ولكن في تبعدكم سُدى",104,"د",2,0],["وما أسداه من كرم السجايا","وفاءٌ بالمودة والذمام",105,"م",1,0],["وما استغنيتُ لا وأبيك عنه","غِنى الظامي عن الماء النمير",106,"ر",1,0],["وما استغنيتُ عنك بكلِّ حال","وهل يغني عن الماء الصعيد",107,"د",1,0],["وما أسأر البين المشتُّ بقيَّةً","من الدمعِ إلاَّ كانَ ممتزجاً دما",108,"م",2,0],["وما أَسيرُ الى رومٍ ولا عربٍ","لكنْ لريحٍ وإِبراقٍ وإِرعادِ",109,"د",1,0],["وما أسعد من لاقى","جيوشَ الحُسنِ بالحَزْنِ",110,"ن",1,0],["وما استوى من بنيها عير شرذمةٍ","كانوا النبيين أو شبهَ النبيينِ",111,"ن",1,0],["وما أسفتُ لمالٍ فاتَ فازَ به","غيري بلى فاتني الأخلاقُ والشيَمُ",112,"م",1,0],["وما استحلَّ باغيا إمامُكُمُ","يزيدُ بالطَّفِّ من ابن فاطمِ",113,"م",1,0],["وما استغفرتُمُ إلا لشخصٍ","أعدّ ليومه الذخر الجزيلا",114,"ل",2,0],["وما اسْتراثكَ في الإقدامِ آونةً","إلا جهولٌ في الأسرار لم يَصلِ",115,"ل",1,0],["وما أستزيد العزْم منه وقد هَمَت","سحائبُ جودٍ منه جَمٌّ سِجامُها",116,"م",3,0],["وما اسمٌ في القتال به حياةٌ","ويوجد صورةً في كل راسِ",117,"س",1,0],["وما اسم نلا يلذ سماعه","وإن صحفت أجزاؤه فهو بغضتي",118,"ت",2,0],["وما استطعنا كلاما","محمد عبد صالح",119,"ح",1,0],["وَما أَسعف الجُود الإِلهي بِالوَفا","وَقَرت عُيون السَّير بِالمَشهَد العَلي",120,"ل",2,0],["وما أسَاتُ ولكنْ","أحسنتُ بالسّوءِ ظَنّا",121,"ن",2,0],["وَما أَسرعوا إلّا لِكَرْع حُتوفهمْ","كما أسهلَ الموتُ الزّؤامُ وُغُولا",122,"ل",2,0],["وَما اِستوى يَفَنٌ ولّتْ نضارتُه","في الغانياتِ بغضٍّ ناضرِ العودِ",123,"د",1,0],["وَما اِستَخَفَّكَ إِلّا نَظرَةٌ سَلَكَت","إِثرَ القَبولِ وَقَد خَفَّت لَهُ السُدُلُ",124,"ل",1,0],["وما اسقط الإنسان في الغي عقله","ولكن دني قد غوى وهو عالم",125,"م",1,0],["وما اسودَّ إِلا لأَنِّي به","قَبَرْتُ العُلاَ ودفَنْتُ الكَرمْ",126,"م",1,0],["ومَا استَقَامَت لِمَلْكٍ قطُّ مملكةٌ","إِلاَّ إِذا قَصَدَ النَّهجَ الَّذِي قَصَدَا",127,"د",2,0],["وما أسفي إِلاَّ على قُرب ملكِه","وما حَزَنِي إِلاَّ على مُلك قُرْبِه",128,"ب",2,0],["وَما أَسَدٌ من أُسودِ العَرينِ","يعتَنِقُ السائلينَ اِعتِناقا",129,"ق",2,0],["وَمَا اسْمٌ بِلا جِسْمٍ وَتُمْسِكُه يَدٌ","وَأَحْقَرُ شَيْءٍ فيهِ أَشْرَفُ ما فيهِ",130,"ه",1,1]]}