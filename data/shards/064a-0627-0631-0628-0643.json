{"poems":[[74,"يا رب كلب في راحتي حجر","https://www.aldiwan.net/poem19433.html","المنسرح"],[74,"يا رب كأس صاغها لي شادن","https://www.aldiwan.net/poem20108.html","الكامل"],[77,"يا رب كل كتيبة شهباء","https://www.aldiwan.net/poem69108.html","الكامل"],[50,"يا رب كم وإلى كم","https://www.aldiwan.net/poem66268.html","المجتث"],[108,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[240,"يا رب كيف بلوتني بعصابة","https://www.aldiwan.net/poem31783.html","الكامل"],[242,"جاشت بلابلنا وسال واديها","https://www.aldiwan.net/poem19726.html","البسيط"],[287,"لئن نأت بعد قرب منكم الدار","https://www.aldiwan.net/poem32761.html","البسيط"],[302,"يا رب كم لك من يد عظمت","https://www.aldiwan.net/poem33304.html","أحذ الكامل"],[343,"يا رب كن لي وليا","https://www.aldiwan.net/poem68722.html","المجتث"],[376,"حتى متى يرمي وكم يتعمد","https://www.aldiwan.net/poem57489.html","الكامل"],[396,"يا أهل العقول السالمه وأهل القلوب العالمه","https://www.aldiwan.net/poem54450.html","عموديه"],[396,"يقول طاهر عسى الله يعين","https://www.aldiwan.net/poem54553.html","عموديه"],[534,"يا رب كن شارحا لصدري","https://www.aldiwan.net/poem37503.html","مخلع البسيط"],[747,"","https://poetry.dctabudhabi.ae/diwan/poem/143267","الكامل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122344","الدوبيت"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70674","الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133781","الكامل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122008","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108688","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126194","الرجز"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101736","الرجز"],[2437,"","https://poetry.dctabudhabi.ae/diwan/poem/127801","الكامل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103412","الرجز"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91065","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91462","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91306","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91050","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92291","الكامل"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/89991","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111404","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94555","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83409","السريع"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33186","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120525","الكامل"],[4689,"يا رب كيف إلى النجاة سبيلُ","https://www.poetsgate.com/ViewPoem.aspx?id=152845",""],[4984,"الدهر أعطى","https://www.poetsgate.com/ViewPoem.aspx?id=190854",""],[5009,"مناجاة ليلة القدر","https://www.poetsgate.com/ViewPoem.aspx?id=24372",""],[5045,"النفس وأهوائها","https://www.poetsgate.com/ViewPoem.aspx?id=184900",""],[5121,"جنون عاقلة","https://www.poetsgate.com/ViewPoem.aspx?id=37465",""],[5277,"هي..وليتها","https://www.poetsgate.com/ViewPoem.aspx?id=190793",""],[5504,"سطعت سيوف الهند باللّمعان","https://www.poetsgate.com/ViewPoem.aspx?id=124901",""],[5742,"المجلس الميمون","https://www.poetsgate.com/ViewPoem.aspx?id=207146",""],[5804,"ماذا يصدك","https://www.poetsgate.com/ViewPoem.aspx?id=191225",""],[5829,"ليلة النصف من شعبان","https://www.poetsgate.com/ViewPoem.aspx?id=177403",""],[5943,"قلبي سعيدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=34486",""],[5956,"قضية العدل","https://www.poetsgate.com/ViewPoem.aspx?id=192032",""],[5956,"قوافل الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=192294",""],[5956,"صور إيمانية","https://www.poetsgate.com/ViewPoem.aspx?id=192502",""],[5956,"يمر عمري","https://www.poetsgate.com/ViewPoem.aspx?id=192655",""],[5956,"إني لَأجثو فوق قبرك شاكراً","https://www.poetsgate.com/ViewPoem.aspx?id=193484",""],[5956,"ما درَّ شعري هكذا لسواكما","https://www.poetsgate.com/ViewPoem.aspx?id=193703",""],[5956,"يا رب كيف أساعد الصنديدا","https://www.poetsgate.com/ViewPoem.aspx?id=194580",""],[5956,"هذا الحسامُ نموذج فعَّالُ","https://www.poetsgate.com/ViewPoem.aspx?id=204690",""],[5956,"يا ربِّ كيف خلقت هذا الهاديا؟","https://www.poetsgate.com/ViewPoem.aspx?id=207357",""],[5956,"يا ربَّنا انصرها على أعدائها","https://www.poetsgate.com/ViewPoem.aspx?id=214089",""]],"verses":[["يا رُبَّ كلبٍ في راحتي حجر","يذُوده والحمام ينطلق",0,"ق",1,1],["يا رُب كأس صاغها لي شادنٌ","نعم الصياغة في الزمان المعلم",1,"م",1,1],["يا ربّ كلّ كتيبةٍ شَهْباءِ","ومآبَ كلّ قصيدَةٍ غرّاءِ",2,"ا",2,1],["يا ربّ كم وإلى كم","أمشي ويركبُ غيري",3,"ر",2,1],["يا رُبَّ كنز حوته دارُ حكمتها","تُحْصَى النجومُ ولا يحصيه تعداد",4,"د",1,0],["يا رَبِّ كَيفَ بَلَوتَني بِعِصابَةٍ","ما فيهِمِ فَضلٌ وَلا إِفضالُ",5,"ل",1,1],["يَا رَبِّ كُنْ مَلْجَأً لَنَا وَمُسْتَنَداً","فَقَدْ غَزَتْنَا هُمُومٌ لاَ نُقَاوِيهَا",6,"ي",3,0],["يا رَبِّ كُن جارَهُ مِمّا يُحاذِرُهُ","فَما يَخيبُ لَهُ راجٍ وَلا جارُ",7,"ر",1,0],["يا ربِّ كَم لَكَ من يَدٍ عظُمَت","عِندي فنِلتُ بها المُنى سَرحا",8,"ح",2,1],["يا رَبِّ كُن لي وَلِيّاً","بِالحِفظِ حَتّى أُطيعَك",9,"ك",1,1],["يا ربِّ كيفَ نصرتَه وأنا الذي","إياكَ من بينِ الثلاثة أعبُدُ",10,"د",1,0],["يارب كن لي يامعين إذا رشح عظم الجبين","واختم إليه باليقين",11,"ن",1,0],["يا رب كن لي عند رشح الجبين","والساق بالمساق قد التف",12,"ف",1,0],["يا رَبِّ كُنْ شارِحاً لِصَدْري","فَقَدْ طالَ مِنْ ضِيقِهِ اكْتئابي",13,"ي",1,1],["يا رُبَّ كوْماءَ خَضبتُ نَحرَها","بمُديةٍ مثل القضاء السابق",14,"ق",1,1],["يا رب كم اقصد بالشعر سواك","والقصد يردني إلى باب غناك",15,"ك",1,1],["يا رب كن لي راحما مُتقبِّلاً","مني فإنك لا تزال عليما",16,"م",2,0],["يا رب كيف أعلّم ال","أطيار غير أسى وحزن",17,"ن",1,1],["يَا رُبَّ كَأْسٍ لَمْ تُشَجَّ شُمُولُهَا","فَاعْجَبْ لَهَا جِسْماً بِغَيْرِ مِزَاجِ",18,"ج",1,1],["يا رب كيف يتم رسم خيالها","ويداك تسكب فوقه الأنوارا",19,"ر",2,0],["يا رب كن لهم وليا ناصرا","واحفظهم من فتنة الفتان",20,"ن",1,0],["يا ربّ كيفَ أنت ذا لِتُخفى","وإنّك الظاهرُ جَلَّ وَصفاً",21,"ف",2,0],["يا رب كل العالم","اسمح بخير دائم",22,"م",1,1],["يا رب كل العالم اسمح بخير دائم","لجشم آفت خانم وجمع كل السامعين",22,"ن",1,0],["يا ربِّ كن لي صالحاً عمَّا طغت","قدمي وكن لي غافراً ما قد جرى",23,"ر",2,0],["يا رُبَّ كَلبٍ أهلُهُ في كسبِهِ","يَقوتُهُم بسَعيهِ وَذأبِهِ",24,"ب",2,1],["يا رب كن يوم حشري اخذا بيدي","بيض لوجهي واعصمني من النقم",25,"م",1,0],["يا رَب كَم لَكِ إِحسانٌ وَكَم لك في","هَذا الوُجود شُؤونٌ كُلُّها حِكَم",26,"م",1,0],["يا رَبُّ كَم أَشكو الغَرامَ وَلا أَرى","إِلا معالجَ لاعجٍ من عالج",27,"ج",1,1],["يا رَبَّ كُلِّ مَلاحةٍ صِل رَبَّ كل","ل صَبابةٍ فيكَ العَذاب استعذبا",28,"ب",2,0],["يا رَب كَم ليَ مِن ذَنب وَسَيئة","ملّ الكِرام وَملَّت حملَها الكُتب",29,"ب",1,0],["يا رب كم فتنٍ خلقت وكم نَرى","جناتِ حسنٍ نصطلي بجحيمِها",30,"ه",2,1],["يا ربّ كن عند ظني فيك لي ولها","كذاك يفعل رحبُ الطول غفارُ",31,"ر",1,0],["يا ربَّ كِلاَّ وَذَا قَوسِ اللُّجَينِ ويا","مولىً بقُوَّتِهِ تِينيذُساً وَصلاَ",32,"ل",2,0],["يا رب كن لي مجيباً بالدعاءِ وجد","لطفاً بأمرٍ به تدنو مآثرهُ",33,"ر",2,0],["يا ربّ كم أَغدقتَ من رحمة","عليّ كم جاد بها صيِّبُ",34,"ب",1,0],["يا رب كم أشكو وما لي راحةٌ","ماذا جنى طرفي وما كسبت يدي",35,"د",2,0],["يا رب كن لعزيز مصر واهله","في كل حين واقيا ونصيرا",36,"ر",2,0],["يارب كيف إلى النجاة سبيلُ","وبدار خلدك يستقر عليلُ",37,"ل",1,1],["يا رب كن مع كل من عقد الرجا","طمعا بقلب خاشع يتفطر",38,"ر",1,0],["يا رب كم يوسف فينا نقي يد","دانوه بالسجن والقاضي هو الجاني",39,"ن",2,0],["يا رب كم من صبي صفدوا فمضى","يبكي كضفدعة في ناب ثعبان",39,"ن",1,0],["يا رب كم أسرة باتت مشردة","تشكو تجبر فرعون وهامان",39,"ن",1,0],["يارب كنز القناعة عافية درسي","ماعاد للنفس وصلة في مناياها",40,"ا",3,0],["يَارَبُّ كَيْفَ حُقُوقُ نَفْسِي خُنْتُهَا ؟","بِبَرَاعَةٍ وَتَصَلُّفٍ مِنْ غَيْرِ حَقْ !!",41,"ق",1,0],["يا ربُّ..كلُّ الوجودِ الآن ينثرني","قمحاً تشظّى على أفواه سنبلتي",42,"ت",2,0],["يا رب كن للمسلمين مؤيداً","ومعينهم في كل أمر عاني",43,"ن",2,0],["يا ربك لطفك من عواقب فتنة","وسهام لحظ قاطع فتان",44,"ن",1,0],["يا ربّ كن لي صاحبًا ومُجييا","إنّي غدوتُ من الزمانِ غريبا",45,"ب",2,1],["ياربِّ كم كبرت آثامنا وطغت","دنيا ملكناها نحسوا ونحصيها",46,"ي",3,0],["ياربُ كمْ يرتقي في حبِّكَ القلمُ","حتَّى يطالَ السَّنا والرُّوحُ تبتسمُ",47,"م",1,1],["يا ربِّ كيف أعيد منه غنائمي","باللطف والمسعَى لأيّ تفاهمِ؟",48,"م",1,0],["يا ربِّ كيف أطلت عمري كي أرى","خير الأنام جهادهم مغلوبا؟",49,"ب",2,0],["يا رب كم أسرفتُ سامحني استجب","إني أتيتك شارحاً مأساتي",50,"ت",2,0],["يا رب كيف يمر عمري هكذا","وأنا أُعاني من تصاريف الأذى؟",51,"ذ",2,1],["يا رب كيف قصَصْتَني عن حبلهم","ورميتَني عن موطني متذللا؟",52,"ل",2,0],["يا ربِّ كيف جبلتَ هذا المجتبى","مما يفوق تصوّر المشروبِ؟",53,"ب",1,0],["يا رب كيف أساعد الصنديدا","مولاي صالحَ كي يزيد سُعودا؟",54,"د",2,1],["يا رب كيف أزيد عطر مناخه","أو أن أكون لمقلتيه حديدا",54,"د",2,0],["يا رب كيف نثيبه بدعائنا","إن لم تجبنا أيها المفضالُ؟",55,"ل",1,0],["يا رب كيف خلقتَ هذا الهاديا","خِلِّي اللواءَ محمداً كخياليا؟؟",56,"ي",2,1],["يا ربِّ كيف تعيش زوجي دون أن","تَجْبي من الخبثاء حقَّ وفائها؟",57,"ا",3,0]]}