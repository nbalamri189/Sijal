835",""],[5922,"صراخ فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=185119",""],[5953,"ديني دان فاعرفوه","https://www.poetsgate.com/ViewPoem.aspx?id=93916",""],[5956,"عودي سريعاً يا حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=182210",""],[6046,"يا ذات الخمار","https://www.poetsgate.com/ViewPoem.aspx?id=35809",""],[6056,"الشعر أكذبه  أعذبه","https://www.poetsgate.com/ViewPoem.aspx?id=130138",""],[463,"عسى معرضٌ وجههُ مقبلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60250&r=&rc=306",""],[6277,"أحلام العروبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64470&r=&rc=33",""]],"verses":[["أُصفي الوِدادَ مُدَلَّلاً","لَم يَصفُ لي مِنهُ الوِدادُ",0,"د",1,0],["أصف العيون من الظباء لأجله","ولفرد عينٍ ألفَ عينٍ تكرم",1,"م",1,0],["أصف الحبيبَ ولا أقول كأنه","كلّا لقد أمسى من الأفرادِ",2,"د",1,1],["أصفاكَ شكرَ القلب عن نيةٍ","وبعدَ شكرِ القلب شكر اللسان",3,"ن",1,0],["اصفرت الاوراق تفرق حينما","هجم الخريف كأنه ثعبان",4,"ن",1,0],["أصفيتهُ ودي لأَنقل طبعه","والطبعُ يعجزُ من يهمُّ بنقلهِ",5,"ل",2,0],["أصفيتُه ودِّي وأصفاني القِلَى","إنّ المودةَ والقِلَى أرزاقُ",6,"ق",1,0],["أُصفيكَ أَقصى الوِدِّ غَيرَ مُقَلَّلِ","إِن كانَ أَقصى الوِدِّ عِندَكِ يَنفَعُ",7,"ع",1,0],["أَصَفَتكَ مِن بَعدِ الصُدودِ مَوَدَّةً","وَكَذا الدَواءُ يَكونُ بَعدَ الداءِ",8,"ا",2,0],["أَصَفيحُ ماءٍ أَديمُ أَم سَماءِ","فيهِ تَغورُ كَواكِبُ الجَوزاءِ",9,"ا",2,1],["أَصفى لَمَحضِ وَلاكَ عِقدَ ضَميرِهِ","فَسِوى مَديحَكَ لا يَمُرُّ بِبالِهِ",10,"ل",2,0],["أصفراءُ يَبْيَضّ منها الحباب","أمِ الشمسُ عن أنجمٍ تبسِمُ",11,"م",1,0],["أصِفُ الراحَ ولا أشْرَبُهَا","وهيَ بالشّدْوِ على الشَّرْبِ تَدور",12,"ر",1,0],["أَصفَوا مُلوكَ بَني العَبّاسِ كُلَّهُمُ","ذَخيرَةً ذَخَروها عَن بَني الحَكَمِ",13,"م",1,0],["أَصفَرُ مِنها كَأَنَّهُ مُحَّةُ ال","بَيضَةِ صافٍ كَأَنَّهُ عَجسُ",14,"س",1,0],["أُصْفِيهِ وُدِّي وَأُمْلِيهِ الْهَوَى وَأَرَى","مِنْهُ الصَوَابَ وَأَرْجُوهُ عَلَى الزَّمَنِ",15,"ن",1,0],["أصفيتكم ودّي وأعلم أنه","ثقل على اللؤماء من حسّادي",16,"د",2,0],["أَصفَرُ قَد خُرِّجَ بِالمُلابِ","كَأَنَّما يُدهَنُ بِالزِريابِ",17,"ب",1,0],["أَصَفراءُ لَيسَ الفَتى صَخرةً","ولَكِنَّهُ نُصبُ هَمٍّ وَغَم",18,"م",1,0],["أَصَفراءُ ما أَنسى هَواكِ وَلا وُدّي","وَلا ما مَضى بَيني وَبَينَكِ مِن وُكدِ",19,"د",1,1],["أَصَفراءُ ما صَبري وَأَنتِ غَريبَةٌ","كَأَنَّكِ عِندَ اِبنِ السَميذَعِ في لَحدِ",19,"د",1,0],["أَصَفراءُ لا تَبعَد نَواكِ فَإِنَّما","يَسوقُ لَكِ المَرأى حَبيبُكِ مِن بُعدِ",19,"د",1,0],["أَصَفراءُ لَولا ما أُؤَمِّلُ مِن غَدٍ","ضَرَبتُ بِسَيفي رَأسَ قَيِّمِكِ العَبدي",19,"د",2,0],["أَصَفراءُ لَو أَرسَلتِ في الريحِ حاجَةً","سَكَنتُ إِلَيها أَو حَرِجتُ مِنَ الجَهدِ",19,"د",1,0],["أَصَفراءُ كانَ الوُدُّ مِنكِ مُباحا","لَيالِيَ كانَ الهَجرُ مِنكِ قِراحا",20,"ح",2,1],["أُصفي الخَليلَ إِذا دَنا","وَإِذا نَأى عَنّي رَأَيتُه",21,"ت",2,0],["أَصَفراءُ ما في العَيشِ بَعدَكِ مَرغَبُ","وَلا لِلصِبى مَلهىً فَأَلهو وَأَلعَبُ",22,"ب",1,1],["أَصَفراءُ إِن أَهلِك فَأَنتِ قَتَلتِني","وَإِن طالَ بي سُقمٌ فَذَنبُكِ أَذنَبُ",22,"ب",1,0],["أَصَفراءُ أَيّامُ النَعيمِ لَذيذَةٌ","وَأَنتِ مَعَ البُؤسى أَلَذُّ وَأَطيَبُ",22,"ب",1,0],["أَصَفراءُ في قَلبي عَلَيكِ حَرارَةٌ","وَفي كَبِدي الهَيماءِ نارٌ تَلَهَّبُ",22,"ب",1,0],["أَصَفراءُ مالي في المَعازِفِ سَلوَةٌ","فَأَسلو وَلا في الغانِياتِ مُعَقَّبُ",22,"ب",1,0],["أَصَفراءُ لي نَفسٌ إِلَيكِ مَشوقَةٌ","وَعَينٌ عَلى ما فاتَ مِنكِ تَصَبَّبُ",22,"ب",1,0],["أَصَفراءُ لَم أَعرِفكِ يَوماً وَإِنَّني","إِلَيكِ لِمُشتاقٌ أَحِنُّ وَأَنصَبُ",22,"ب",1,0],["أَصَفراءُ ما لي في المَدامَةِ سُلوَةٌ","فَأَسلو وَلا في الغانِياتِ مُعَقَّبُ",23,"ب",1,0],["أُصفي خَليلي ما دَحا ظِلَّهُ","وَدامَ لي مِن وُدِّهِ جانِبُ",24,"ب",1,0],["أَصفَيتُهُ وُدّي وَحَدَّثتُهُ","بِالحَقِّ عَن سُعدى وَعَن زَينَبِ",25,"ب",1,0],["إِصفَح وَجاهِر بِالمُرادِ الفَتى","وَلا يَقولوا هُوَ مُغتابُ",26,"ب",1,1],["أَصْفَيْتني مَحْضَ الوِدادِ وطَالما","خَلَط المُماذِقُ مِلْحَه بفُرَاتِه",27,"ت",2,0],["أصفي الودادَي مدلَّلاً،","لْمْ يَصْفُ لي مِنْهُ الوِدَادُ",28,"د",1,0],["أصفيت آل رسول الله عاطفتي","وكنت شاعركم نعمى وأحزانا",29,"ن",2,0],["أصفيتك الحبّ لا منّا ولا كدرا","ومن هنات المحبّ المنّ والكدر",30,"ر",1,0],["أصفيتَ العيشَ لا كدرٌ","وأقمتَ الدينَ فلا أودُ",31,"د",1,0],["أصفُ الأحبّةَ واللسان يقول لي","وصفُ الوزير أبى المعالى أعظمُ",32,"م",1,0],["أَصفَيتَها المالَ شِرباً وَالعُلى كَلَأً","مِن بَعدِ أَن رَضيَت بِالماءِ وَالعُشُبِ",33,"ب",1,0],["أَصفَيتَ لِلعَرَبِ المَشارِبَ بَعدَ أَن","كانَت كَرُمحٍ لا يُعانُ بِلَهذَمِ",34,"م",1,0],["أصفيتك الود مضطراً ومختارا","ولم أخاطبك إجلالاً وإكبارا",35,"ر",2,1],["أَصفى الأنام نَسَباً وَحَسبا","مِن خيرِ كلّ شُعبةٍ تشعّبا",36,"ب",2,0],["أَصْفَرُهُ الْفَاقِعُ مِنْ ذَهَبٍ","وَالأَبْيَضُ النَّاصِعُ مِنْ فِضَّهْ",37,"ض",2,0],["أَصَفا لدمعِكَ أَن يَبيتَ مُرقرقاً","وَحَلا لِقَلبكَ أَن يظلَّ مولَّها",38,"ه",2,0],["آصفيٌّ إِذا اِدَلهمَّ بِنا الخَط","بُ دَعَوناه بِالقَويِّ المَتينِ",39,"ن",1,0],["أَصفيَّ دينِ اللهِ دَعوةَ مَن","أَضحَى بذَيْلِ عُلاكَ يَعتَلِق",40,"ق",1,0],["أصفياءٌ كَدَّروا عيَشْي نوى","كيف يصْفو العيشُ دونَ الأصفياء",41,"ا",2,0],["أَصفى مِن الدَمع الَّذي","يَعصى العَذول وَيَهمع",42,"ع",1,0],["أَصفَيتُكَ الود مِن دون الأَنام وَمِن","يَصف الوِداد لِمَن يَهواهُ غَير خَفي",43,"ف",2,0],["أصفيتكم في الحبّ محض مودمي","ولها وليس لكم إلّ تودّد",44,"د",1,0],["أَصفى المُلُوكِ فَناصِرٌ أَوْ واصلٌ","وصَفا الأَنامُ فعائِذٌ أَوْ خاضِعُ",45,"ع",1,0],["أصفيكما مني السّلام مهادياً","بتَحية مسكية الأنفاسِ",46,"س",1,0],["اصفعوا الغاشمَ الأنَاني واقضوا","في دَعَاوى يُقيمها الشيطانُ",47,"ن",1,0],["أصفرَ كفّاً وعزّ نفساً","فقال نفسي مكانُ مالي",48,"ل",2,0],["أصفى لي النعمى وكانت حمأة","وأباحني الحسنى وقد كانت حمى",49,"م",2,0],["أَصفى مِنَ العَيشِ لِمَن لَم يَهجُرِ","سَوفَ أَجزي بِالثَناءِ الأَزهَرِ",50,"ر",1,0],["أصفاك ساكنها حباً ولا عجب","حسب الأنام لمن تندى أنامله",51,"ل",2,0],["أَصفَيتُ ساكِنَها العزيزَ مَوَدَّتي","وعلى مَحَبَّتهِ عَقَدتُ وَلائي",52,"ا",2,0],["أُصفِّفُ اللَّثم ولكنَّني","أُبَلْبِلُ الصُّدْغَين والطُّرَّه",53,"ر",2,0],["أَصفُ الحبيبَ ولستُ أُبْصره","وكذاك تُوصف جنَّةُ الخُلْدِ",54,"د",1,0],["أَصفيَّ دينِ الله يا","أَسْنَى الوَرى قدْراً وَأَسْمَى",55,"م",2,0],["أَصْفُو فأُظْهِرُ ما أُجِنُّ وَلَمْ يَكُنْ","في باطِني شَيْءٌ يخالفُ ظَاهِري",56,"ي",1,0],["أصفاكَها صَنَعٌ شَحَذتَ لِسانَه","فَجَعَلتَه صَنعاً ولَم يَكُ صانعا",57,"ع",2,0],["أصفاهُمُ ما كانَ في آبائِه","من صالِح الأفعالِ في أجداده",58,"د",2,0],["اصفاك والله بها اصفاكا","فقد نظرنا زمنا اباكا",59,"ك",2,0],["آصِف الهِمّةِ مَعن في السّخا","سَمح كَفٍّ لَم يَكُن يَحكيهِ سَمحُ",60,"ح",1,0],["أَصَفاءٌ وَهَل يَدومُ صَفاءُ","وَهَناءٌ وَلَيسَ يَبقى هناءُ",61,"ا",2,1],["أصفيته ودّي وبحت بحبه","إذ لا يلذ متيّم بخفائهِ",62,"ا",3,0],["أصفي خلالا من بنت كرم","تشاب بابن المُزن القَراحِ",63,"ح",1,0],["اصفيته محض الوداد وسامني","فيه هوانا عاذلي ورقيبي",64,"ب",2,0],["أَصْفَيْتُهُ مِنْ مُوالاتي ومِنْ مِدَحي","مَحْضاً ولم أَرَ مَلْكاً غيرَهُ أَهْلَهْ",65,"ل",2,0],["أصْفَيْتُهُ وُدّي عَلى","غُلُوائِهِ وطِماحِهِ",66,"ح",2,0],["اصفح عَن الجاني وَعُد بحلمكا","يظهر خَفيَّ جَهلِهِ بِعلمِكا",67,"ك",2,0],["أصف الأشواق في تلك الرُّبا","وأعاطي التُّرْب سَوْفاً والتئاما",68,"م",2,0],["أصفرَ مثلِ النجوم مُشرقةً","مُجتمِعاً بعضُها إلى بعضِ",69,"ض",1,0],["أَصفى الهَوى يا آس بستان الجنى","أَن يقتضي ما عندهم ما عندنا",70,"ن",2,1],["أَصفهسلارة ملكون الملوك بها","ميم المحب وَكاف الكشف ما اِشتَبها",71,"ب",3,1],["أصفى صفاتي لوصف الوصف واصفه","لا الوصف وصفي ولا الأخبار أخباري",72,"ر",2,1],["أَصفى الأَحِبَّة من صافى فَما جافى","وأوقف القَلب للمحبوب إِيقافا",73,"ف",2,1],["أصفهسلارة المنى","زهر الجنان وَالجنى",74,"ا",1,1],["اصفر لون المهرجان","بزات مرج الزَعفران",75,"ن",1,0],["أَصفاك للصافين من أَسراره","مصفى القلوب من الخطا وَالعار",76,"ر",1,0],["أصفى من الراح لمستأنس","أما تراها للصفا منهجا",77,"ج",2,0],["أصفى من الثلج إشراقا مذاقَتهُ","أحلى من الدين المضروب بالعسل",78,"ل",1,0],["أَصفاهما منه الوَلاء فأَصْفيا","فيه الوِداد وأَضْفيا الآلاءَ",79,"ا",2,0],["أصفح في تغريده منطقا","يقول بشرى بمدير أمين",80,"ن",1,0],["أصفيتك الإخلاص صدقاً لا أنا","متخلف عنه ولا مستبدل",81,"ل",1,0],["أصفيتكم ودي واخلص","في الولا لكم اعتقادي",82,"د",2,0],["أَصِفِ المَوَدَّةَ مَن صَفا لَكَ ودُّهُ","وَاِترُك مُصافاةَ القَريبِ الأَميَلِ",83,"ل",1,1],["أَصفَيتُ وُدّي لِهارونٍ وَشيعَتِهِ",