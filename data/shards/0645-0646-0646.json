انة غدوة استقلالها","https://www.aldiwan.net/poem10993.html","عموديه"],[402,"قد آن أن تلوي العنان وتقصرا","https://www.aldiwan.net/poem46979.html","الكامل"],[402,"يا دار سلمى بسفح ذي سلم","https://www.aldiwan.net/poem46982.html","المنسرح"],[406,"لو جادهن غداة رمن رواحا","https://www.aldiwan.net/poem50194.html","الكامل"],[409,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[409,"من كان لي من حماه خيس ذي لبد","https://www.aldiwan.net/poem32214.html","البسيط"],[416,"لامني سعد على","https://www.aldiwan.net/poem53873.html","مجزوء الرمل"],[416,"أعلمت أي معالم ومعاهد","https://www.aldiwan.net/poem54097.html","الطويل"],[416,"زيد لوما فزاد في الحب وجدا","https://www.aldiwan.net/poem54124.html","الخفيف"],[416,"أكرم بطيف خيالكم من زائر","https://www.aldiwan.net/poem54150.html","الكامل"],[416,"يا إمام الهدى ويا صفوة الله","https://www.aldiwan.net/poem54171.html","الخفيف"],[429,"يا سالب النوم من عيني ما سلبا","https://www.aldiwan.net/poem40284.html","البسيط"],[429,"رعى الله أوصافا بفضلك شمتها","https://www.aldiwan.net/poem41432.html","الطويل"],[432,"طار عن برقة برق فشم","https://www.aldiwan.net/poem12350.html","الرمل"],[432,"هذا مقام أبيك فاسم بمجده","https://www.aldiwan.net/poem12593.html","الكامل"],[432,"مولاي أمرك قد تقدم","https://www.aldiwan.net/poem12729.html","مجزوء الكامل"],[432,"إن جوى لو يذهب الأوجالا","https://www.aldiwan.net/poem12763.html","الرجز"],[437,"ته فلو قستك بالظبي الغرير","https://www.aldiwan.net/poem2516.html","الرمل"],[437,"صلت بالهجر فبالرحمن صلني","https://www.aldiwan.net/poem2541.html","الرمل"],[439,"منن بأيسر شكرها أعييتني","https://www.aldiwan.net/poem34915.html","الكامل"],[441,"سعدي ونحسي بأحكام القضا سبقا","https://www.aldiwan.net/poem14290.html","البسيط"],[443,"دع عنك صهباء الدساكر","https://www.aldiwan.net/poem56047.html","عموديه"],[452,"ما الروض نديان الثرى متعطرا","https://www.aldiwan.net/poem13759.html","الكامل"],[452,"أبدر تم مذ تبدا طالعا","https://www.aldiwan.net/poem13829.html","الرجز"],[453,"الشباب العزيم شعر جميل","https://www.aldiwan.net/poem61345.html","الخفيف"],[453,"خبرتكم فوجدت الجبن آيتكم","https://www.aldiwan.net/poem61357.html","البسيط"],[458,"سقى دارها بالرقمتين وحياها","https://www.aldiwan.net/poem55818.html","الطويل"],[458,"من ناصري والزمان لي خصم","https://www.aldiwan.net/poem55862.html","المنسرح"],[458,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[458,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[458,"أنشد من عهد ليلى غير موجود","https://www.aldiwan.net/poem56215.html","البسيط"],[458,"من ناظر لي بين سلعٍ وقبا","https://www.aldiwan.net/poem56276.html","الرجز"],[461,"الق الحدائج ترع الضمر القود","https://www.aldiwan.net/poem15103.html","البسيط"],[464,"هذه دولة الندى والسماح","https://www.aldiwan.net/poem3162.html","عموديه"],[464,"لنا بسمر الحمى في الحي أسمار","https://www.aldiwan.net/poem3186.html","عموديه"],[464,"هي دار مية يا طليق العدل","https://www.aldiwan.net/poem3282.html","عموديه"],[464,"جد بقلبي وهزل","https://www.aldiwan.net/poem3313.html","عموديه"],[464,"عثرة قلبي فيكم لا تقال","https://www.aldiwan.net/poem3558.html","عموديه"],[500,"منن الرفاعي الرفيع الهمة","https://www.aldiwan.net/poem37634.html","الكامل"],[500,"واد أبو البركات يوما يجتلي","https://www.aldiwan.net/poem37789.html","الكامل"],[515,"سرت نفحة كالمسك أزهى وأعطر","https://www.aldiwan.net/poem12119.html","الطويل"],[515,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[515,"لما أدار مدامة الأحداق","https://www.aldiwan.net/poem12187.html","الكامل"],[515,"لك أن تقول إذا أردت وتفعلا","https://www.aldiwan.net/poem12207.html","الكامل"],[515,"لولا جفون ومقل","https://www.aldiwan.net/poem12209.html","مجزوء الكامل"],[538,"قال البيان لمن أراد مديحه","https://www.aldiwan.net/poem48155.html","عموديه"],[551,"ضرم قلبي فاضطرم","https://www.aldiwan.net/poem47190.html","مجزوء الرجز"],[551,"يوم الحمى ما أنت من همي","https://www.aldiwan.net/poem47212.html","أحذ الكامل"],[551,"لو كنت في مثل حالي لم ترد عذلي","https://www.aldiwan.net/poem47288.html","البسيط"],[551,"أرق عيني طارق","https://www.aldiwan.net/poem47360.html","مجزوء الرجز"],[555,"ألا أبلغا سعد بن ليث وجندعاً","https://www.aldiwan.net/poem1921.html","الطويل"],[561,"الحمد لله الذي استقلت","https://www.aldiwan.net/poem27845.html","الرجز"],[562,"لقد أتانا غلام طاب مولده","https://www.aldiwan.net/poem52561.html","البسيط"],[562,"من كان كاتب نون هذا الحاجب","https://www.aldiwan.net/poem52841.html","الكامل"],[567,"ما تغطي أكوار تلك البدور","https://www.aldiwan.net/poem69679.html","الخفيف"],[587,"يا تاركاً لمراضي الله أوطاناً","https://www.aldiwan.net/poem11514.html","عموديه"]],"verses":[["مِن ناظِرٍ مَطروفَةٍ أَلحاظُهُ","أَو خاطِرٍ مَطلولَةٍ سَوداؤُهُ",0,"ا",3,0],["مِن ناصِرٍ لِلحَقِّ أَو راعٍ إِلى","سُبُلِ الهُدى أَو كاشِفِ الغَمّاءِ",1,"ا",2,0],["مِن نائِلٍ وَعَديٍّ في عَضادَتِها","أو آلِ نَسْرِ بنِ وهبٍ أو بَني ناجِ",2,"ج",1,0],["مِنَنُ الرِجالِ عَلى القُلو","بِ أَشَدُّ مِن وَقعِ الأَسِنَّه",3,"ن",2,0],["مِن نَظرَةٍ نَظَرَت ضُحىً فَرَأَيتُها","وَلَمَن يَحينُ عَلى المَنِيَّةِ هادي",4,"د",2,0],["مَنَنتَ عَلَيَّ العَطاءَ الجَزيلَ","وَقَد قَصَّرَ الضَنُّ مِنّي كَثيرا",5,"ر",2,0],["مَن نالَها نالَ خُلداً لا اِنقِطاعَ لَهُ","وَما تَمَنّى فَأَضحى ناعِماً أَنِقا",6,"ق",2,0],["مِن نَواصي دودانَ إِذ كَرِهوا البَأ","سَ وَذُبيانَ وَالهِجانِ الغَوالي",7,"ل",2,0],["مَنَنتَ عَلَيَّ بِالنُعماءَ حَتّى","رَدَدتَ عَلَيَّ أَيّامَ الشَبابِ",8,"ب",1,1],["مَن نَبَّأَ الوَرقاءَ أَنَّ مَحَلكُم","حَرمٌ وَأَنَّكَ مَلجَأٌ لِلخائِفِ",9,"ف",1,0],["مِنْ نَفْسِهَا لا جَاهِهَا مَجْدُهَا","ومِنْ سجاياهَا مِعالِيهَا",10,"ي",3,0],["مِنْ نَفْسِهَا وَبِنَفْسِهَا تَذْكُو فَمَا","تَفْنَى وَمَا يَفْنَى خَفِي ذُبالِهَا",11,"ل",3,0],["مِنْ نُخْبَةٍ إِنْ يَدْعُهُمْ دَاعِي الفِدَى","لَبَّاهُ كُلُّ سَمَيْذَعٍ مُتَفَانِ",12,"ن",1,0],["مِن نُخْبَةٍ فِي شِيبِهَا وَشَبَابِهَا","غُرِّ الخِلالِ وَصَفْوَةِ الأَعْيَانِ",13,"ن",1,0],["مِنَنٌ لاَ تَنِي تتَابِعُهَا","قَدْ مَلأَتَ الأَيَّامَ بِالمِنَنِ",14,"ن",1,0],["مِنْ نَدَى شَمْسِ المَبَرَّاتِ الَّتِي","حَمْدُهَا مِلْءُ قُلُوبِ العَالَمِينْ",15,"ن",1,0],["مِنْ نِصْفِ قَرْنٍ شَاءَ رَهْطُ أَعِزَّةٍ","فِي قَوْمِهِمْ تَأْسِيسَ هَذَا المَعْلَمِ",16,"م",1,0],["مِنَنٌ شَمَلْتِ بِهَا المَشَارِقَ فَانْتَفَى","فِيمَا وَسِعْنَ تَبَايُنُ الأَقْوَامِ",17,"م",1,0],["مَنَنّاهُما بِالخِمسِ وَالخِمسِ قَبلَهُ","وَبِالحَلِّ وَالتِرحالِ أَيّامَ ناجِرِ",18,"ر",1,0],["من نور وجهك ضاء الكونُ أجمعُهُ","حتى تشيَّد بالأفلاك مبناهُ",19,"ا",2,0],["مَنَنّا عَلَيكُم لَو شَكَرتُم بَلاءَنا","وَقَد حَمَلَتكُم حَربُ ذُهلٍ عَلى قُترِ",20,"ر",1,0],["مِن نَحوِ كابَةَ تَحتَثُّ الحُداةُ بِهِم","كَي يَشعُفوا آلِفاً صَبّاً فَقَد شَعَفوا",21,"ف",3,0],["مِن نَسا الناشِطِ إِذ ثَوَّرتُهُ","أَو رَئيسِ الأَخدَريّاتِ الأُوَل",22,"ل",1,0],["من نداك الجم والعلم معاً","لكَ بحران بسيطٌ ومديد",23,"د",1,0],["من نظم مصري أقام بجلق","ما كان في هذا الطراز مجيشا",24,"ش",2,0],["مننت بحلّ اللغز معنىً وصورةً","فلله موصوفٌ لديكَ وواصف",25,"ف",1,1],["من نعم الوهَّاب سبحان من","جمَّل من أخلاقه ما خلق",26,"ق",1,0],["من نظام يعشو له الأعشيان","ونثارٍ يعنو له العبدان",27,"ن",1,0],["من نِحلةٍ زورٍ إلى نحلة","زُورٍ فما ينفك من مهربِ",28,"ب",1,0],["من نجم رأيٍ ومن بحرٍ له فجرٌ","على العفاةِ ومن ضِرغامةٍ عادي",29,"د",2,0],["من نسيمٍ كأنَّ مَسْراه في الأرْ","واح مسرى الأرواح في الأجسادِ",30,"د",1,0],["من نَيْلُ غايته يَشُقْ","قُ ونيلُ نائله يسيرُ",31,"ر",1,0],["من ناصع الحمرة رَيّا قالسه","تكاد تحت الظلمات الدامسه",32,"س",2,0],["من ناشِئٍ محض الحُلاقِ وشيخةٍ","شوهاءَ لائطةٍ وشيخ لائط",33,"ط",1,0],["من نَدِّك الفاخر المُفضَّل في ال","ندِّ على غيره إذا وُصِفا",34,"ف",2,0],["من نَتْن حشَّيها وتشويهها","ومن لظىً تبَّاً وتضليلا",35,"ل",2,0],["من ناصحٍ بالذي تحيى النفوسُ به","وحائلٍ بين أرواحٍ وأجسامِ",36,"م",1,0],["من نورِ حكمتِهِ بمُضْطَرَمٍ","وبحورِ نائله بملتَطَمِ",37,"م",1,0],["من نَغْمةٍ تَضْرط في حلقِها","ونكهةٍ تفسُو كُرُنْبيَّهْ",38,"ي",2,0],["مَن نَجا مِنه وَهوَ في رَوحاتِهِ","إِنَّما قَد نَجا إِلى غُدواتِه",39,"ت",2,0],["مِن نائِمينَ عَلى ذُلٍّ وَمَترَبَةٍ","وَمِن تِجارٍ وَأَشرافٍ وَأَملاكِ",40,"ك",1,0],["مِن نُبَلاءِ الشَعبِ ساداتُها","وَخيرَةِ الغيدِ غَوانيها",41,"ي",3,0],["مِنَنٌ أَتَتني وَهيَ مُسرِعَةُ الخُطى","سَبَقَت إِلَيَّ حَوادِثَ الأَزمانِ",42,"ن",1,0],["مِن نازِحٍ كَثُرَت إِلَيكَ هُمومُهُ","لَو يَستَطيعُ إِلى اللِقاءِ سَبيلا",43,"ل",2,0],["مِن نِعمَةِ الرَحمَنِ لا مِن حيلَتي","إِنّي أَعُدُّ لَهُ عَلَيَّ فُضولا",43,"ل",2,0],["من نازح الدار التقى بك داره","ساح الأكارم للكريم ديار",44,"ر",1,0],["مَنْ نامَ لَمْ يَدْرِ طالَ اللّيلُ أَمْ قَصُرا","لا يعرفُ اللّيلَ إلاَّ عاشِقٌ سَهرا",45,"ر",2,1],["مَن نَفعُهُ في أَن يُهاجَ وَضَرُّهُ","في تَركِهِ لَو تَفطَنُ الأَعداءُ",46,"ا",2,0],["مَنَنتَ عَلَيهِ إِذ تَقَلَّبَتِ الظُبا","عَلَيهِ وَزَيدٌ مِن قَتيلٍ وَهارِبِ",47,"ب",1,0],["مِن نَوبَةٍ وَاِختِلالٍ بِتُّ بَينَهُما","فَلا يَكُن لَكَ إِمسائي وَإِصباحي",48,"ي",1,0],["مِن نِعمَةِ الصانِعِ الَّذي صَنَعَكَ","صاغَكَ لِلمَكرُماتِ وَإِبتَدَعَك",49,"ك",1,1],["مِن ناصِرٍ بِحُسامِهِ وَمُخَذِّلٍ","عَنكَ العَدُوَّ بِرَأيِهِ المُستَوثَقِ",50,"ق",1,0],["مَنَنتَ عَلَيهِم بِالحَياةِ فَأَصبَحوا","مَواليكَ فازوا مِنكَ بِالمَنِّ وَالعِتقِ",51,"ق",1,0],["مِن نِسوَةٍ لِبَني لَيثٍ وَجيرَتِهِم","بَرَحنَ بِالعَينِ مِن حُسنٍ وَمِن طيبِ",52,"ب",1,0],["مِن نازِعٍ طاعَةً حَتّى تَكونَ لَهُ","بَعدَ العَمى مِن فُؤادٍ ناكِثٍ بَصَرا",53,"ر",2,1],["مَن نافَسَ الناسَ لَم يَسلَم مِنَ الناسِ","حَتّى يُعَضَّ بِأَنيابٍ وَأَضراسِ",54,"س",1,1],["مِن نَفخَةِ الصورِ أَم مِن نَفحَةِ الصورِ","أَحيَيتِ يا ريحُ مَيتاً غَيرَ مَقبورِ",55,"ر",1,1],["من نامَ منها قبَّلته ومن بكى","فله من الريحِ الطبيبةِ آسِ",56,"س",1,0],["مِنْ نَقْضِهِ الظُلْمَ مَهمَا جَلّ صَاحِبُهُ","إِنْقَضَّ إِيوانُ كِسْرَى عِنْدَما وُلِدَا",57,"د",2,0],["من نُور بِشرِكَ أشرقَ النور الَّذي","بِتَكاثُرِ الأعيادِ عِندَكَ بَشّرا",58,"ر",2,0],["مَن نامَ عَن مَكرُمَةٍ عامِداً","فَلَستَ عَنها الدَهرَ بِالنائِمِ",59,"م",1,0],["مِن نَجلِ كُلِّ تَليدَةٍ أَعراقُهُ","طِرفٍ مُعَمٍّ في السَوابِقِ مُخوَلِ",60,"ل",1,0],["مَن نالَ مِن سُؤدُدٍ زاكٍ وَمِن حَسَبٍ","ما حَسبُ واصِفِهِ مِن وَصفِهِ حَسَبا",61,"ب",2,0],["مِن نَكبَةٍ مَحفوفَةٍ بِمُصيبَةٍ","جُذَّ السَنامُ لَها وَجُذَّ الغارِبُ",62,"ب",1,0],["مِن ناكرٍ عَلَماً تُهدى الغواة به","حتى كأن لم يكن في الكاف والنون",63,"ن",1,0],["مَننتُ عليك فإن تفرحي","فَغَيرُكَ أولى بِحُزْنٍ وَهَمّ",64,"م",1,0],["مِن ناقضٍ عَهداً ومن مُتمرّدٍ","يُمسِي على دِينِ الغُواةِ ويُصبِحُ",65,"ح",1,0],["مِن نَظرَةٍ غَشِيَتني إِذ رَفَعتُ لَها","طَرفي وَما شَعَرَت جِدّاً سَمادِيرُ",66,"ر",1,0],["مِن نَظرَةٍ خالَستُها بَلَغَت","ما زادَ مِن نَعتٍ عَلى وَصفي",67,"ي",1,0],["مِنَنٌ كباكِرَةِ الغَمامِ كفيلةٌ","بالنُّجْحِ موقوفٌ عليه ضَمانها",68,"ن",3,0],["مِن نَسجِ خَرقاءَ لا تُشَدُّ لَها","آخِيَّةٌ في الثَرى وَلا طُنُبُ",69,"ب",1,0],["مِن نَهَمِ الحِرصِ وَمِن خَواتِها","لِتَفثَأَ الأَرنَبَ عَن حَياتِها",70,"ت",3,0],["مِن نُواحِ الفَقيرِ لاحَ عَلى الخا","في وَعَزفِ الصَيدانَةِ العَنقَفيرِ",71,"ر",1,0],["مَن ناقَشَ الإِخوانَ لَم","يُبدِ العِتابَ وَلَم يُعِده",72,"د",2,0],["مِن نازِحٍ حَسَنِ الدَلا","لِ أَبى لَكَ التَغميضَ حُبُّه",73,"ب",2,0],["مِن ناحِلِ الأَلواحِ لَو كِلتَهُ","في قُلبِها مَرَّ وَلَم يَنشَبِ",74,"ب",1,0],["مِن نَفَرٍ مُوَطَّاءِ الأَعقابِ","يُربى عَلى القَومِ بِفَضلِ الرابي",75,"ب",2,0],["مِن نُجومٍ نارِيَّةٍ وَنُجومٍ","ناسَبَت تُربَةً وَماءً وَريحا",76,"ح",2,0],["مَنَنتَ عَلى أَبنائِكَ النَزرَ آسِفاً","فَأَنتَ عَلَيهِم كَالأَلَدِّ المُفاصِلِ",77,"ل",1,0],["مِن نُطفَةٍ قَدَّها مُقدّرُها","يَخلُقُ مِنها الأَبشارَ وَالنَسَما",78,"م",2,0],["من نصارى ومسلمين وهود","كل حزب منهم عن الكل راضي",79,"ض",2,0],["من نجوم حمر وَصفر وزرق","وَنجوم خلافها بيضاء",80,"ا",2,0],["من نسوة لعب الصبا بقدودها","لعب الصبا بمعاطف الأغصان",81,"ن",1,0],["من نعم تترى وعيش مرغَد","وشان اليوم وذكر في غدِ",82,"د",1,0],["مِن نَجِيِّ الهَمِّ عندي ثاوِياً","بينَ ما أُعلِنُ منهُ وأُسِرّ",83,"ر",1,0],["مِنْ نَبْعَةٍ أَكْرِمُ بِهَا","مُنْتَسَباً وَأَنْبِلِ",84,"ل",1,0],["مِنْ نُخْبَةٍ هُمْ فَخَارُ الغَرْب إِنْ نُعِتُوا","وَنُخْبَةٍ هُمْ فَخَارُ الشَّرْقِ وَالعَرَبَ",85,"ب",1,0],["مِنْ نِسَاءٍ زَوَاهِرٍ","بِحِلَى الْحُسْنِ وَالأَدَبْ",86,"ب",1,0],["مِنْ نَفَرِ الخَيْرِ الأُلَى إِنْ دَعُوا","لِلشَّرَّ كَانُوا عَنْهُ فِي مَعْزِلِ",87,"ل",1,0],["مِنْ نَابِغٍ فِي مِصْرَ أَوْ مِنَ نَابِهٍ"