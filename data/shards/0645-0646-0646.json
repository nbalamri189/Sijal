بالْفِرَاشِ مَذِيلاَ","https://www.poetsgate.com/ViewPoem.aspx?id=21222",""],[51,"أبا عليٍّ طلبتُ عيبك ما اس","https://www.poetsgate.com/ViewPoem.aspx?id=29588",""],[51,"أشجتكَ منزلة ٌ بمَرجَيْ راهِط","https://www.poetsgate.com/ViewPoem.aspx?id=29400",""],[50,"يا دارُ بين الفرع والجنابِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=8373&r=&rc=14",""],[20,"طال الليل علينا واِعتكر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69774&r=&rc=15",""],[91,"الفراشة المحتضرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67880&r=&rc=160",""]],"verses":[["مِن ناظِرٍ مَطروفَةٍ أَلحاظُهُ","أَو خاطِرٍ مَطلولَةٍ سَوداؤُهُ",0,"ا",3,0],["مِن ناصِرٍ لِلحَقِّ أَو راعٍ إِلى","سُبُلِ الهُدى أَو كاشِفِ الغَمّاءِ",1,"ا",2,0],["مِن نائِلٍ وَعَديٍّ في عَضادَتِها","أو آلِ نَسْرِ بنِ وهبٍ أو بَني ناجِ",2,"ج",1,0],["مِنَنُ الرِجالِ عَلى القُلو","بِ أَشَدُّ مِن وَقعِ الأَسِنَّه",3,"ن",2,0],["مِن نَظرَةٍ نَظَرَت ضُحىً فَرَأَيتُها","وَلَمَن يَحينُ عَلى المَنِيَّةِ هادي",4,"د",2,0],["مَنَنتَ عَلَيَّ العَطاءَ الجَزيلَ","وَقَد قَصَّرَ الضَنُّ مِنّي كَثيرا",5,"ر",2,0],["مَن نالَها نالَ خُلداً لا اِنقِطاعَ لَهُ","وَما تَمَنّى فَأَضحى ناعِماً أَنِقا",6,"ق",2,0],["مِن نَواصي دودانَ إِذ كَرِهوا البَأ","سَ وَذُبيانَ وَالهِجانِ الغَوالي",7,"ل",2,0],["مَنَنتَ عَلَيَّ بِالنُعماءَ حَتّى","رَدَدتَ عَلَيَّ أَيّامَ الشَبابِ",8,"ب",1,1],["مَن نَبَّأَ الوَرقاءَ أَنَّ مَحَلكُم","حَرمٌ وَأَنَّكَ مَلجَأٌ لِلخائِفِ",9,"ف",1,0],["مِنْ نَفْسِهَا لا جَاهِهَا مَجْدُهَا","ومِنْ سجاياهَا مِعالِيهَا",10,"ي",3,0],["مِنْ نَفْسِهَا وَبِنَفْسِهَا تَذْكُو فَمَا","تَفْنَى وَمَا يَفْنَى خَفِي ذُبالِهَا",11,"ل",3,0],["مِنْ نُخْبَةٍ إِنْ يَدْعُهُمْ دَاعِي الفِدَى","لَبَّاهُ كُلُّ سَمَيْذَعٍ مُتَفَانِ",12,"ن",1,0],["مِن نُخْبَةٍ فِي شِيبِهَا وَشَبَابِهَا","غُرِّ الخِلالِ وَصَفْوَةِ الأَعْيَانِ",13,"ن",1,0],["مِنَنٌ لاَ تَنِي تتَابِعُهَا","قَدْ مَلأَتَ الأَيَّامَ بِالمِنَنِ",14,"ن",1,0],["مِنْ نَدَى شَمْسِ المَبَرَّاتِ الَّتِي","حَمْدُهَا مِلْءُ قُلُوبِ العَالَمِينْ",15,"ن",1,0],["مِنْ نِصْفِ قَرْنٍ شَاءَ رَهْطُ أَعِزَّةٍ","فِي قَوْمِهِمْ تَأْسِيسَ هَذَا المَعْلَمِ",16,"م",1,0],["مِنَنٌ شَمَلْتِ بِهَا المَشَارِقَ فَانْتَفَى","فِيمَا وَسِعْنَ تَبَايُنُ الأَقْوَامِ",17,"م",1,0],["مَنَنّاهُما بِالخِمسِ وَالخِمسِ قَبلَهُ","وَبِالحَلِّ وَالتِرحالِ أَيّامَ ناجِرِ",18,"ر",1,0],["من نور وجهك ضاء الكونُ أجمعُهُ","حتى تشيَّد بالأفلاك مبناهُ",19,"ا",2,0],["مَنَنّا عَلَيكُم لَو شَكَرتُم بَلاءَنا","وَقَد حَمَلَتكُم حَربُ ذُهلٍ عَلى قُترِ",20,"ر",1,0],["مِن نَحوِ كابَةَ تَحتَثُّ الحُداةُ بِهِم","كَي يَشعُفوا آلِفاً صَبّاً فَقَد شَعَفوا",21,"ف",3,0],["مِن نَسا الناشِطِ إِذ ثَوَّرتُهُ","أَو رَئيسِ الأَخدَريّاتِ الأُوَل",22,"ل",1,0],["من نداك الجم والعلم معاً","لكَ بحران بسيطٌ ومديد",23,"د",1,0],["من نظم مصري أقام بجلق","ما كان في هذا الطراز مجيشا",24,"ش",2,0],["مننت بحلّ اللغز معنىً وصورةً","فلله موصوفٌ لديكَ وواصف",25,"ف",1,1],["من نعم الوهَّاب سبحان من","جمَّل من أخلاقه ما خلق",26,"ق",1,0],["من نظام يعشو له الأعشيان","ونثارٍ يعنو له العبدان",27,"ن",1,0],["من نِحلةٍ زورٍ إلى نحلة","زُورٍ فما ينفك من مهربِ",28,"ب",1,0],["من نجم رأيٍ ومن بحرٍ له فجرٌ","على العفاةِ ومن ضِرغامةٍ عادي",29,"د",2,0],["من نسيمٍ كأنَّ مَسْراه في الأرْ","واح مسرى الأرواح في الأجسادِ",30,"د",1,0],["من نَيْلُ غايته يَشُقْ","قُ ونيلُ نائله يسيرُ",31,"ر",1,0],["من ناصع الحمرة رَيّا قالسه","تكاد تحت الظلمات الدامسه",32,"س",2,0],["من ناشِئٍ محض الحُلاقِ وشيخةٍ","شوهاءَ لائطةٍ وشيخ لائط",33,"ط",1,0],["من نَدِّك الفاخر المُفضَّل في ال","ندِّ على غيره إذا وُصِفا",34,"ف",2,0],["من نَتْن حشَّيها وتشويهها","ومن لظىً تبَّاً وتضليلا",35,"ل",2,0],["من ناصحٍ بالذي تحيى النفوسُ به","وحائلٍ بين أرواحٍ وأجسامِ",36,"م",1,0],["من نورِ حكمتِهِ بمُضْطَرَمٍ","وبحورِ نائله بملتَطَمِ",37,"م",1,0],["من نَغْمةٍ تَضْرط في حلقِها","ونكهةٍ تفسُو كُرُنْبيَّهْ",38,"ي",2,0],["مَن نَجا مِنه وَهوَ في رَوحاتِهِ","إِنَّما قَد نَجا إِلى غُدواتِه",39,"ت",2,0],["مِن نائِمينَ عَلى ذُلٍّ وَمَترَبَةٍ","وَمِن تِجارٍ وَأَشرافٍ وَأَملاكِ",40,"ك",1,0],["مِن نُبَلاءِ الشَعبِ ساداتُها","وَخيرَةِ الغيدِ غَوانيها",41,"ي",3,0],["مِنَنٌ أَتَتني وَهيَ مُسرِعَةُ الخُطى","سَبَقَت إِلَيَّ حَوادِثَ الأَزمانِ",42,"ن",1,0],["مِن نازِحٍ كَثُرَت إِلَيكَ هُمومُهُ","لَو يَستَطيعُ إِلى اللِقاءِ سَبيلا",43,"ل",2,0],["مِن نِعمَةِ الرَحمَنِ لا مِن حيلَتي","إِنّي أَعُدُّ لَهُ عَلَيَّ فُضولا",43,"ل",2,0],["من نازح الدار التقى بك داره","ساح الأكارم للكريم ديار",44,"ر",1,0],["مَنْ نامَ لَمْ يَدْرِ طالَ اللّيلُ أَمْ قَصُرا","لا يعرفُ اللّيلَ إلاَّ عاشِقٌ سَهرا",45,"ر",2,1],["مَن نَفعُهُ في أَن يُهاجَ وَضَرُّهُ","في تَركِهِ لَو تَفطَنُ الأَعداءُ",46,"ا",2,0],["مَنَنتَ عَلَيهِ إِذ تَقَلَّبَتِ الظُبا","عَلَيهِ وَزَيدٌ مِن قَتيلٍ وَهارِبِ",47,"ب",1,0],["مِن نَوبَةٍ وَاِختِلالٍ بِتُّ بَينَهُما","فَلا يَكُن لَكَ إِمسائي وَإِصباحي",48,"ي",1,0],["مِن نِعمَةِ الصانِعِ الَّذي صَنَعَكَ","صاغَكَ لِلمَكرُماتِ وَإِبتَدَعَك",49,"ك",1,1],["مِن ناصِرٍ بِحُسامِهِ وَمُخَذِّلٍ","عَنكَ العَدُوَّ بِرَأيِهِ المُستَوثَقِ",50,"ق",1,0],["مَنَنتَ عَلَيهِم بِالحَياةِ فَأَصبَحوا","مَواليكَ فازوا مِنكَ بِالمَنِّ وَالعِتقِ",51,"ق",1,0],["مِن نِسوَةٍ لِبَني لَيثٍ وَجيرَتِهِم","بَرَحنَ بِالعَينِ مِن حُسنٍ وَمِن طيبِ",52,"ب",1,0],["مِن نازِعٍ طاعَةً حَتّى تَكونَ لَهُ","بَعدَ العَمى مِن فُؤادٍ ناكِثٍ بَصَرا",53,"ر",2,1],["مَن نافَسَ الناسَ لَم يَسلَم مِنَ الناسِ","حَتّى يُعَضَّ بِأَنيابٍ وَأَضراسِ",54,"س",1,1],["مِن نَفخَةِ الصورِ أَم مِن نَفحَةِ الصورِ","أَحيَيتِ يا ريحُ مَيتاً غَيرَ مَقبورِ",55,"ر",1,1],["من نامَ منها قبَّلته ومن بكى","فله من الريحِ الطبيبةِ آسِ",56,"س",1,0],["من نُور بِشرِكَ أشرقَ النور الَّذي","بِتَكاثُرِ الأعيادِ عِندَكَ بَشّرا",57,"ر",2,0],["مَن نامَ عَن مَكرُمَةٍ عامِداً","فَلَستَ عَنها الدَهرَ بِالنائِمِ",58,"م",1,0],["مِن نَجلِ كُلِّ تَليدَةٍ أَعراقُهُ","طِرفٍ مُعَمٍّ في السَوابِقِ مُخوَلِ",59,"ل",1,0],["مَن نالَ مِن سُؤدُدٍ زاكٍ وَمِن حَسَبٍ","ما حَسبُ واصِفِهِ مِن وَصفِهِ حَسَبا",60,"ب",2,0],["مِن نَكبَةٍ مَحفوفَةٍ بِمُصيبَةٍ","جُذَّ السَنامُ لَها وَجُذَّ الغارِبُ",61,"ب",1,0],["مِن ناكرٍ عَلَماً تُهدى الغواة به","حتى كأن لم يكن في الكاف والنون",62,"ن",1,0],["مَننتُ عليك فإن تفرحي","فَغَيرُكَ أولى بِحُزْنٍ وَهَمّ",63,"م",1,0],["مِن ناقضٍ عَهداً ومن مُتمرّدٍ","يُمسِي على دِينِ الغُواةِ ويُصبِحُ",64,"ح",1,0],["مِن نَظرَةٍ غَشِيَتني إِذ رَفَعتُ لَها","طَرفي وَما شَعَرَت جِدّاً سَمادِيرُ",65,"ر",1,0],["مِن نَظرَةٍ خالَستُها بَلَغَت","ما زادَ مِن نَعتٍ عَلى وَصفي",66,"ي",1,0],["مِنَنٌ كباكِرَةِ الغَمامِ كفيلةٌ","بالنُّجْحِ موقوفٌ عليه ضَمانها",67,"ن",3,0],["مِن نَسجِ خَرقاءَ لا تُشَدُّ لَها","آخِيَّةٌ في الثَرى وَلا طُنُبُ",68,"ب",1,0],["مِن نَهَمِ الحِرصِ وَمِن خَواتِها","لِتَفثَأَ الأَرنَبَ عَن حَياتِها",69,"ت",3,0],["مِن نُواحِ الفَقيرِ لاحَ عَلى الخا","في وَعَزفِ الصَيدانَةِ العَنقَفيرِ",70,"ر",1,0],["مَن ناقَشَ الإِخوانَ لَم","يُبدِ العِتابَ وَلَم يُعِده",71,"د",2,0],["مِن نازِحٍ حَسَنِ الدَلا","لِ أَبى لَكَ التَغميضَ حُبُّه",72,"ب",2,0],["مِن ناحِلِ الأَلواحِ لَو كِلتَهُ","في قُلبِها مَرَّ وَلَم يَنشَبِ",73,"ب",1,0],["مِن نَفَرٍ مُوَطَّاءِ الأَعقابِ","يُربى عَلى القَومِ بِفَضلِ الرابي",74,"ب",2,0],["مِن نُجومٍ نارِيَّةٍ وَنُجومٍ","ناسَبَت تُربَةً وَماءً وَريحا",75,"ح",2,0],["مَنَنتَ عَلى أَبنائِكَ النَزرَ آسِفاً","فَأَنتَ عَلَيهِم كَالأَلَدِّ المُفاصِلِ",76,"ل",1,0],["مِن نُطفَةٍ قَدَّها مُقدّرُها","يَخلُقُ مِنها الأَبشارَ وَالنَسَما",77,"م",2,0],["من نصارى ومسلمين وهود","كل حزب منهم عن الكل راضي",78,"ض",2,0],["من نجوم حمر وَصفر وزرق","وَنجوم خلافها بيضاء",79,"ا",2,0],["من نسوة لعب الصبا بقدودها","لعب الصبا بمعاطف الأغصان",80,"ن",1,0],["من نعم تترى وعيش مرغَد","وشان اليوم وذكر في غدِ",81,"د",1,0],["مِن نَجِيِّ الهَمِّ عندي ثاوِياً","بينَ ما أُعلِنُ منهُ وأُسِرّ",82,"ر",1,0],["مِنْ نَبْعَةٍ أَكْرِمُ بِهَا","مُنْتَسَباً وَأَنْبِلِ",83,"ل",1,0],["مِنْ نُخْبَةٍ هُمْ فَخَارُ الغَرْب إِنْ نُعِتُوا","وَنُخْبَةٍ هُمْ فَخَارُ الشَّرْقِ وَالعَرَبَ",84,"ب",1,0],["مِنْ نِسَاءٍ زَوَاهِرٍ","بِحِلَى الْحُسْنِ وَالأَدَبْ",85,"ب",1,0],["مِنْ نَفَرِ الخَيْرِ الأُلَى إِنْ دَعُوا","لِلشَّرَّ كَانُوا عَنْهُ فِي مَعْزِلِ",86,"ل",1,0],["مِنْ نَابِغٍ فِي مِصْرَ أَوْ مِنَ نَابِهٍ","فِي الصِّينِ أَوْ بَادٍ يَلُمُّ وَحَاضِرِ",87,"ر",1,0],["مِنْ نظِيمٍ وَمِنْ نَثِيرٍ أَرَانَا","تَحْتَ أَزْهَى الْعَتِيقِ حُسْناً أَجَدَّا",88,"د",2,0],["مِنْ نَائلٍ أو سُؤْددٍ وحَمَالةٍ","سَبَقَتْ لَهُ في النّاسِ أو مَعْروفِ",89,"ف",1,0],["مننتُم عَلَينا مَرَّةً بِوِصالِكُم","وَسالَمتُمُ وَالدَهرُ غَيرُ مُسالِمِ",90,"م",1,0],["مَن نَوى خَيراً فَإِنّي","فيهِ لِلخَيراتِ أَنوى",91,"و",2,0],["من نضال عاثر مصطخب","لنضال عاثر مصطخب",92,"ب",1,0],["من نَبْعِه خُلِقَتْ ما بالُها صرفتْ","سِرْبَ الشفاه الحيارَى وهو ظمآنُ",93,"ن",1,0],["مَنَ نظم الشعر بلا مستفعِل","فإنما أصابهُ في المقتل",94,"ل",1,0],["من نَسْل كلِّ أَبٍ أَبيّ، بالردى","يَرْضَى، ولا يَرْضَى هوانَ الجار",95,"ر",1,0],["مِن نفايات عطاياهم يدي","وجبيني، وبأيديهم عتادي",96,"د",2,0],["منْ نظرتْ ضحى ً، فرأيتها،","ولمنْ يحينُ على المنيّة ِ، هادي",97,"د",2,0],["مِنْ ناصِرٍ بحُسَامِهِ وَمُخَذِّلٍ","عَنكَ العَدوَّ برَأيهِ المُستَوْسِقِ",98,"ق",1,0],["مَنَنْتَ عَلَيْهِ، إذْ تَقَلّبَتِ الظُّبَى","عَلَيْهِ، وَزِيدَ مِنْ قَتيلِ وَهَارِبِ",99,"ب",1,0],["منْ نعمة ِ الرّحمانِ لا منْ حيلتي","إنّي أعدُّ لهُ عليَّ فضولا",100,"ل",2,0],["من نَدِّك الفاخر المفضَّل في النْ","نَدَّ على غيره إذا وصِفا",101,"ف",2,0],["من ناشىء ٍ محضِ الحُلاقِ وشيخة ٍ","شوهاءَ لائطة ٍ وشيخ لائط",102,"ط",1,0],["من نفرٍ موطَّإ الأعقابِ","يُرْبَى عَلَى الْقَوْمِ بِفَضْلِ الرَّابِي",103,"ب",2,0],["مِن نَجِيِّ الهَمِّ عَندي ثاوِياً","فَوقَ ما أُعلِنُ مِنهُ وَأُسِر",104,"ر",1,0],["من نائمين على ذلّ وتربة","ومن تجار وأشراف وأملاك",105,"ك",1,0]]}