{"poems":[[54,"من لامني اليوم في سكر فلا عذرا","https://www.aldiwan.net/poem26957.html","البسيط"],[353,"هل تعلم الناس أني في صيامي قد","https://www.aldiwan.net/poem20259.html","البسيط"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26546","الكامل"],[2251,"","https://poetry.dctabudhabi.ae/diwan/poem/82123","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138531",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45783","الكامل"]],"verses":[["حَتّى إِذا ثَقُلَت حَملاً وَما بَقِيَت","أَرضٌ بِبَغدادَ إِلّا تَرتَجي مَطَرا",0,"ر",2,0],["حتَّى إذا ثَوَّبَ الدَّاعِي نَهضْتُ وقد","خِفْنا نَمِيمَةَ طِيبٍ فَوقَها عَطِرِ",1,"ر",1,0],["حَتّى إِذا ثَمِلَت بِنَشوَتِها","قَرَأَت كِتابَ الباهِ عَيناها",2,"ا",3,0],["حَتّى إِذا ثَمِلوا من طولِ مانَهِلوا","قالوا وَما عَقلوا تِمثالَ وَسنانِ",3,"ن",1,0],["حتى إذا ثمل الفتى وتلاعبت","بالعقل خمرته رماه بما أعد",4,"د",1,0],["حَتّى إِذا ثَبَتت بِهَم أَقدامَهُم","نَكَسوا الرُؤوس لذي المَقام الأَكبَر",5,"ر",1,0]]}