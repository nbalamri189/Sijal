943,"حبيبتي الشامُ","https://www.poetsgate.com/ViewPoem.aspx?id=34360",""],[5982,"يا مصر","https://www.poetsgate.com/ViewPoem.aspx?id=152889",""],[5991,"يا ألمي منك إليك الفرار","https://www.poetsgate.com/ViewPoem.aspx?id=116385",""],[6004,"يا زماني","https://www.poetsgate.com/ViewPoem.aspx?id=33683",""],[6068,"حكمة -02-","https://www.poetsgate.com/ViewPoem.aspx?id=175945",""],[6097,"الباكية والقاضي","https://www.poetsgate.com/ViewPoem.aspx?id=190664",""],[6102,"دِيوانُ العَربِ...","https://www.poetsgate.com/ViewPoem.aspx?id=182739",""],[6124,"أغنية الكروان","https://www.poetsgate.com/ViewPoem.aspx?id=125178",""],[6124,"يا مالكا قلبي لما","https://www.poetsgate.com/ViewPoem.aspx?id=201239",""],[6213,"أعباء الصور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76246&r=&rc=3",""]],"verses":[["هُم تَبِعوهُ مُقصِرينَ وَرُبَّما","تَوَسَّدَتِ الأَظلافُ وَقعَ الحَوافِزِ",0,"ز",1,0],["هِمَّتي هِمَّةُ المُلوكِ وَنَفسي","نَفسُ حُرٍّ تَرى المَذَلَّةَ كُفرا",1,"ر",2,0],["همّتْ ثُغورُ الأقاحي أنْ تُقَبّلهُ","فلِلْبَنفْسَجِ وجْهُ الواجِمِ الحَنِقِ",2,"ق",1,0],["هُم تَرَكوا صَليبَ الكُفرِ أَرضاً","يُداسُ وَكانَ مَعبوداً يُباسُ",3,"س",1,0],["هُمُ تَرَكوا قَيساً وَعَمرواً كِلاهُما","يَمُجُّ نَجيعاً مِن دَمِ الجَوفِ أَحمَرا",4,"ر",2,0],["هُمُ تَرَكُوا سَرَاتَهُمُ جِثِيًّا","ومَادُونَ السَّرَاةِ مُغِربلينَا",5,"ن",2,0],["همَّتْ بأنْ تَظْلِمَ الظِّلمانَ سُرعَتُها","وكاد يظلمُها من قال ظِلمان",6,"ن",1,0],["هِمتَ فيمَن حَسُنَت صورَتُها","مِثلَما قَد حَسُنَت مِنها الخِصال",7,"ل",1,0],["همت وجرأها على تياره","أن الأمور جميعها تيار",8,"ر",1,0],["هَمَّتِ الفُلكُ وَاِحتَواها الماءُ","وَحَداها بِمَن تُقِلُّ الرَجاءُ",9,"ا",2,1],["هَمَّت بِنا حَتّى إِذا أَقبَلَت","نَمَّ عَلَيها المِسكُ وَالعَنبَرُ",10,"ر",1,0],["هَمَّت بِهِ في البِلادِ هِمَّتُهُ","وَنالَ بِاسَعيِ ما تَمَنّاهُ",11,"ا",2,0],["هَمَت عَلى الناسِ سُحبُهُ فَلَكَم","قَتيلَ فَقرٍ نَداهُ أَحياهُ",11,"ا",2,0],["هِمْتَ بحبِّ فاركٍ","وَقَلَّما تُمَتِّعُك",12,"ك",1,0],["همتُ بالغيدِ فلو كنت الصِّبا","لم يكُنْ منّيَ عنهنّ بَرَاح",13,"ح",1,0],["هُمُ تَرَكوا القَبائِلَ مِن مَعَدٍّ","لَما شاءوا قَليلاتِ العِيافِ",14,"ف",1,0],["همَّتْ تُغنّي فكانت نبأةً وصدىً","صَحَتْ لوقعهما دوحٌ وأفياءُ",15,"ا",2,0],["همتك العليا هوت في الثرى","وشيمة الزاكي علو الهمم",16,"م",1,0],["هم تركوا سراتهم جثيا","وهم دون السراةِ مقرَّنينا",17,"ن",2,1],["هَمَّتْ تَطِيرُ إِلَيْهِ","وَلَكَنْ عَدَتْهَا عَوَادِي",18,"د",2,0],["همت فيكم قبل ان جربتكم","كشف التجريب عن عيني عماها",19,"ا",3,0],["همت بالحي معظما كل ذي طم","ر ين فيه اجل بط السواد",20,"د",1,0],["هَمَتُ بإدرَاكٍ فقَصَّرتُ هَيبةً","وَعَجزي عَن الإدراكِ أولى وأشبَهُ",21,"ب",2,0],["همت عكابة أن تضيم لجيما","فأبت لجيم ما تقول عكابه",22,"ب",2,1],["هِمَّتُه في تلك مرفوعة","وجُودُه في هذه يَقْرُب",23,"ب",1,0],["هَمَّت بتحصيله كما حَصَّلتْ","بغير نفعٍ يُرْجَى ولا مَرْفَق",24,"ق",1,0],["هِمتُ فَما أَدناكَ مِن مُهجَتي","وَدِنتَ بِالهَجرِ فَما أَبعَدَك",25,"ك",1,0],["همته فوق ما حوى فبه","يفتخر البأسُ وهو لا يفخر",26,"ر",1,0],["هِمَّتي هِمَّةُ الشُيوخِ وَنَفسي","نَفسُ عالي المقامِ وَالمِقدار",27,"ر",1,0],["هِمَتٌ إِذا مَدَّت لِمفتخَرِ يَداً","لا تَرتَضى إِلّا الأَعزَّ الأَكبرا",28,"ر",2,0],["هَمّت تُقبِّله عقاربُ صُدغِه","فاستلّ ناظره عليها خَنجَرا",29,"ر",2,0],["هِمتُ شوقاً، ذبتُ عشقاً","غير أن الظن خابا",30,"ب",2,0],["هم تحت حكم مراد الحقّ ما خرجوا","يا عادلاً لا يُرى في حكمه شطط",31,"ط",1,0],["همت فاِستعذبت تَعذيبي بكم","فأجرحوا قَلبي وَلاتخشوا أَثاما",32,"م",2,0],["هِمتُ بِذي خُلقٍ لِحَربي جامِحٍ","وَذي قَوامٍ جانِحٍ لِسَلمي",33,"م",2,0],["هِمَّتُهُ تَعصِرُ تَحتَ رِجلِها","في الأُفقِ عُنقودَ الثُرَيّا المُنتَهَك",34,"ك",1,0],["هَمَت نَعلُها بِالسَيلَحَينِ وَأَوفَضَت","بَوادي ثُمَيلٍ عَن جَنينٍ مُسَبَّدِ",35,"د",1,0],["هِمْتُ في واديَيْ عتابٍ وعِشْق","مذْ أُتيحَتْ عيناهُما لبلائي",36,"ا",2,0],["هِمتَ بالمكرُماتِ حتَّى تَسمَّي","ت بِما تُجمعُ النُّفوسُ عَليهِ",37,"ي",2,1],["همتَ بالمكرُماتِ حبّاً وهامت","بكَ كم لا تزال تصبو وتُصبي",38,"ب",2,0],["هِمَّتهُ للسِّماكِ سَمْكٌ","وخَدُّهُ للتُّرابِ تِرْبُ",39,"ب",1,0],["هِمْتُ وَجْداً وذُبْتُ فيك هياما","وقليلٌ على هواك الهيام",40,"م",1,0],["همّتهُ فوق السُّها","بذا قضى أهلُ النُهى",41,"ه",2,0],["هَمَّتْ عِذاراهُ بِتَقْبيلِهِ","فاسْتَلَّ مِنْ عَيْنَيْهِ سَيْفَيْنِ",42,"ن",1,1],["هِمَّتي والهَمُّ خَصْما مُهْجَتي","قد أطالا ليَ بَرْحاً وسَقاما",43,"م",2,0],["همتم غداة سلا الأنام بحبها","أين المحب من الملول السالي",44,"ل",2,0],["همتُ غراماً بالبروقِ اللمَّعِ","لاحتْ على روضِ الحمى ولَعْلَعِ",45,"ع",1,1],["همت في يمّ الذات لما","جلت في قبري",46,"ر",2,0],["همت على ربع الظلل","والفقر منه في امل",47,"ل",1,0],["هم تجليه وانكشاف سناه","عنده يدخلون منه جنانه",48,"ن",2,0],["هم تاركون لكم ما تفخرون به","فلتتركوهم وكفوا عنهم الخبرا",49,"ر",2,0],["هَمَتْ في ذُرَاها أَدمعُ الطَّلِّ والنَّدى","وبات بِها زَهْرُ الرُّبى باسمَ الثَّغر",50,"ر",1,0],["هِمْتُ به عارياً فكيفَ وقد","أَلبسَهُ الحسنُ منه جِلْبابا",51,"ب",2,0],["همَّت الشهبُ بالنزولِ إِليه","فلذا قيل إِنّ للشُّهبِ عَقْلا",52,"ل",2,0],["هِمَتّي غَيرُكَ فاستَحيي فَما","سِمَني مِنكِ وَلا مِنكِ هُزالي",53,"ل",2,0],["هَمَت في عشق ما لَهُ مِن صِفات","حالياتٍ وَطَبع حُرّ سَليم",54,"م",1,0],["همّته تسْمُوا به للعلى","فدونها في الرّفعة الأنْجمُ",55,"م",1,0],["همت ولولا كبرها وحياؤها","منك استعارتها من الجارات",56,"ت",1,0],["همتي شرب خمورٍ","من يدي ذات خمار",57,"ر",1,0],["هِمْتُ وَجْداً فيهِ مِن حين اِنتَشَى","وَبِهِ عَقلي لَقَد حارَ فَطارْ",58,"ر",1,0],["هِمتُ في القَفرِ بِالهَوى وَغَرامي","فَإِذا الحِبُّ قَد أَتاني يَقينا",59,"ن",2,1],["همُ توَلَّوْا بالفؤادِ والحَشا","فأين صَبْرِي بَعْدَهمْ والجلَدُ",60,"د",1,0],["همت راحتاه للعدى وعفاته","فمن هذه سم ومن هذه شهد",61,"د",1,0],["هُم تَعاويذُ الحِمى يُقصى بِهِم","عَنهُ مَكرُ السوءِ أَو كَيدُ الحَسودِ",62,"د",1,0],["همّتي دونها السُّهى والزُّبانى","قد عَلَتْ جُهدها فلا تَتَدَانى",63,"ن",2,1],["همت المدامع والكبود تفتتت","بوفاة هذا البطرك المرحومِ",64,"م",1,1],["همت في حبه فكان قليلا","بذل روحي له دعوني دعوني",65,"ن",2,0],["همّتُه في العُلا فتاةٌ","وهمّةُ العالمين همَّه",66,"م",2,0],["همت كفاه في سلم وحرب","على العافين بالمنن الجسام",67,"م",1,0],["هم تركوا على النَّشَّاش صرعى","أباحوها القشاعم والذئابا",68,"ب",2,1],["هم تركوا على النَّشَّاش صرعى","بضربٍ ثمَّ أهوَنُهُ شَدِيدُ",69,"د",1,0],["هِمتُ بِظَبيٍ أَفنَن","عَذراء مِنهُ أَفنن",70,"ن",1,0],["هَمَت مِن وَجدي إِلَيها طَرَبا","إِذ دَعاني لِلهَوى داعي الضَنى",71,"ن",2,0],["هم تَركوا كلَّ عاسٍ مُطيعاً","وهمغادروا كل صعب ذَلولا",72,"ل",2,0],["هُم توّجوا هامَ الملوك ببيضهم","وداسوا على أنماطهم بالسوابق",73,"ق",1,0],["همت في عفرها وما كلُّ من ها","مَ بوادي القريض يصطاد عفرا",74,"ر",2,0],["همت أجفانه وقضى","نزاعاً وهو يرتجف",75,"ف",1,0],["هُم تَرَكوا صِحابَكَ بَينَ شاصٍ","وَمُرتَفِقٍ عَلى شَزَنٍ يَميدُ",76,"د",1,0],["همت أعيني شوقا لرؤية أرضه","ترى قبل أن أفنى أزور قبره قباها",77,"ا",3,0],["هُمُ تَوَّجُوني العِزَّ في كُلِّ بَلدَةٍ","وَمِن فَضل ما قَد أَنعَمُوا أَنا فالِحُ",78,"ح",1,0],["هَمَّتْ فطارَتْ فلمْا حَلَّقَتْ وَقَعَتْ","بها القَوادِمُ لمّا حانَ إِمْكانُ",79,"ن",1,0],["هم تباروا في الذود عنك مشاةً","يسبقون الركبان والطائرينا",80,"ن",2,0],["همتُ وجداً في كلِّ وادٍ لأني","شاعر تابع لقلب غويِّ",81,"ي",1,0],["همت حبّاً بالمكرمات وبالمج","د فهيهات أن يملك سلوه",82,"و",2,0],["هِمْتُ به عِشْقاً ولا عذر لي","إذا بدا أيان لا أعشق",83,"ق",1,0],["همت بين اعصار عسافي","في شموخ اجبال امشيده",84,"د",2,0],["همتُ بمن شَبَّبت","بنفسٍ مَا أطيَبَه",85,"ه",1,1],["همتُ بِحُبِّ غَادة","حَنينها مَا أحسَنه",86,"ه",1,1],["همت مزن جدواه ومزن علومه","بما شاء جهال الورى وسغابها",87,"ب",3,0],["همت فكفى الجادين واكف جودها","واذهب لوح الواردين ذهابها",87,"ب",3,0],["هَمَّت لتقضيَ من توديعه وطراً","وقد أبى سوط شمرٍ أن تودعه",88,"ه",1,1],["همت مقلة المجد في يومه","دماء وعين المكارم أهمى",89,"م",2,0],["همت على روض قبر حله ديم","من الرضى ما هما دمع من المقل",90,"ل",1,0],["هُم تَرَكوا الذكر الجَميل وَراثة","وَماترك الاباء يَحظى بِهِ النسل",91,"ل",1,0],["همت بها حباً وكم في الهوى","هام بها في العشق مثلي همام",92,"م",1,0],["هِمَّتِي فَوْقَ السَّمَاكَيْ","نِ وَرِجْلِي في الصَّعِيدِ",93,"د",1,1],["همت بقتل الشقي يوماً أَما علمت","أَنَّ الوَزير بهذا العصر ينهاها",94,"ا",3,0],["هُم تَحتَهُ وَتَحتَ نَجمِ القايدِ","ورابعِ النَّعشِ بعِلمٍ واكِدِ",95,"د",1,0],["همت والنجم 