{"poems":[[55,"أغار على ثراك من الرياح","https://www.aldiwan.net/poem30656.html","الوافر"],[53,"بكيت فلم تترك لعينك مدمعا","https://www.aldiwan.net/poem65076.html","الطويل"],[91,"لقد كان منك اليك السبيل","https://www.aldiwan.net/poem44883.html","المتقارب"],[48,"سحائب مبرقات مرعدات","https://www.aldiwan.net/poem22152.html","الوافر"],[280,"ونت من دون غايتك العقول","https://www.aldiwan.net/poem25542.html","الوافر"],[310,"رسل البشائر ورد وصدور","https://www.aldiwan.net/poem56545.html","الخفيف"],[318,"ما بال نفس تطيل شكواها","https://www.aldiwan.net/poem59508.html","المنسرح"],[466,"تعلمت البيداء فسحة صدره","https://www.aldiwan.net/poem15445.html","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119632","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139475",""],[5829,"يا هدأة الليل","https://www.poetsgate.com/ViewPoem.aspx?id=151390",""],[5956,"مغناطيس الاستعطاف","https://www.poetsgate.com/ViewPoem.aspx?id=192106",""],[5956,"نشتاق يا جَدِّي إليكِ وأسرتِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=200897",""]],"verses":[["تَؤولُ النائِباتُ إِلى مُرادي","وَيُعطيني الزَمانُ عَلى اِقتِراحي",0,"ح",2,0],["تؤوب بها قد أمتعتك وغادرت","من الطير مفجوعاً به ومفجَّعا",1,"ع",2,0],["تؤول حياتي بعد الردى","ولكن الى أي شيء تؤول",2,"ل",1,0],["تُؤَوِّدُ مِنكَ عَقلاً في سُكونٍ","غُصونُ خَواطِرٍ مُتَأَوِّداتُ",3,"ت",1,0],["تؤودُ المُعقلِين بها الأَيادِي","وَيَضْبحُ تَحتَها حتَّى الخُيولُ",4,"ل",1,0],["تُؤوي الأَنام إِلى ظِلالِ مَعيشَةٍ","مَهدُ النَعيمِ لِجَنبِها مَوثورُ",5,"ر",1,0],["تؤومة العين عند صحتها","عظيمة الخوف عند ضراها",6,"ا",3,0],["تَؤودُ قوى أتباعِهِ عَزماتُه","فأكْفاهمُ مُستهدفٌ للمعاتبِ",7,"ب",1,0],["تووده الرياح فحيث ناعت","إلى أي الجهات تراه ناعا",8,"ع",2,0],["تؤوب من اللئام بلا اغتنامٍ","وترجع عن غناءٍ في عناء",9,"ا",2,0],["تؤوي دخيلا وتحمي كلّ ملتجئٍ","ممن أتاها وتبدي كلّ إيثار",10,"ر",1,0],["تؤويه في بيت الفراس وليدها","كيلا تراه في الشآم قتيلا",11,"ل",2,0],["تُؤوِيننا بحفاوةٍ في حُجْرتكْ","بأجَلِّ تضحيةٍ تشير لنخوتكْ",12,"ك",1,0]]}