80,"يا سفر سيفر وإن خطوك بالذهب","https://www.aldiwan.net/poem37206.html","البسيط"],[517,"بكيت ابن ليلى وابنه ورأيتني","https://www.aldiwan.net/poem48586.html","الطويل"],[530,"حفظ اله علاكا","https://www.aldiwan.net/poem37280.html","مجزوء الرمل"],[552,"إني الشجاع وقد جزعت كما ترى","https://www.aldiwan.net/poem47701.html","الكامل"],[552,"لم يبق لي بعد المشيب تصابي","https://www.aldiwan.net/poem48055.html","الكامل"],[562,"قلت لعنس قد ونت طليح","https://www.aldiwan.net/poem27836.html","الرجز"],[562,"طاف الخيالان فهاجا سقما","https://www.aldiwan.net/poem27844.html","الرجز"],[576,"الشام للإسلام دار القرار","https://www.aldiwan.net/poem3069.html","السريع"],[587,"جيش الملاحة مقرون به الظفر","https://www.aldiwan.net/poem17513.html","البسيط"],[587,"أسكرني باللفظ والمقلة ال","https://www.aldiwan.net/poem17560.html","السريع"],[587,"ساق يريني قلبه في الهوى","https://www.aldiwan.net/poem17997.html","السريع"]],"verses":[["ساقَيتُكَ الحُلوَ فَلا بِدعَةً","إِن أَنا طاعَمتُكَ مُرَّ الجَنى",0,"ن",2,0],["سَأُقدِمُ لا مُستَعظِماً ما لَقيتُهُ","تَوَسَّعَ لي في الرَوعِ أَو ضاقَ مَقدَمي",1,"م",2,0],["ساقَ بِسطاماً إِلى مَصرَعِهِ","عالِقاً مِنهُ بِأَذيالِ الطَمَع",2,"ع",1,0],["ساقَ طَرفي إِلى فُؤادي البَلايا","إِنَّ طَرفي عَلى فُؤادي مَشومُ",3,"م",1,0],["سَأُقِرُّ بِالذَنبِ الَّذي لَم أَجنِهِ","إِن كانَ يَنفَعُ عِندَكِ الإِقرارُ",4,"ر",1,0],["ساقَت التَيمِسُ العَزاءَ إِلَينا","وَتَوَخَّت في مَدحِكَ الإِسهابا",5,"ب",2,0],["سَأَقتُلُ ضَيفي وَاِبنَ عَمّي وَمالِكي","وَلَو أَنَّ عُقبى القاتِلينَ خَسارُ",6,"ر",1,0],["سَأَقنَعُ مِنكِ بِلَحظِ البَصَر","وَأَرضى بِتَسليمِكِ المُختَصَر",7,"ر",1,1],["سَاقِي النُّهَى بِنَثِيرِهِ","وَنَظِيمِهِ أَشْهَى مُدَامِ",8,"م",1,0],["سَأَقنُتُ طولَ الدَهرِ ما هَبَّتِ الصِبا","وَأَقنُتُ بِالآصالِ وَالغُدُواتِ",9,"ت",1,0],["سَأَقضي بِبَيتٍ يَحمَدُ الناسُ أَمرَهُ","وَيَكثُرُ مِن أَهلِ الرِوايَةِ حامِلُه",10,"ل",2,0],["سَأَقصُرُ نَفسي جاهِداً عَن جِدالِهِم","كَفاني ما أَلقى مِنَ العَبَراتِ",11,"ت",1,0],["سأقول فيها ما أقول ولم أخف","من أن يقولوا شاعر متطرِّف",12,"ف",1,0],["ساقَتكَ خَيلي مِنَ الأَشرافِ مُعلِمَةً","حَتّى نَزَلتَ جَحيشاً غَيرَ مُختارِ",13,"ر",1,0],["ساقيَ الرَّاح بادِّكار لقاه","لا عدِمنا ذاكَ اللقا وسقاته",14,"ت",2,0],["ساقٍ إذا اغْتبقت ندمان قهوتهِ","أضاء مبسمه الصبحيّ فاصطبحت",15,"ت",1,0],["سأقصِر عن خالدٍ مَنْطقي","وعن أمه حافظاً مَنْصِبي",16,"ي",1,1],["سأقترحُ السكوتَ عليك دهري","فأحسنُ ما تُغنينَ السكوتُ",17,"ت",1,0],["سأقسم دمعي إذ غدرتَ فدمعةٌ","على مِدَحٍ سيَّرتُها فيك ضُيَّعِ",18,"ع",1,1],["ساقهُ نحوك الزمانُ وقادت","ه أفاعيلُ كفّك الفعَّالهْ",19,"ل",2,0],["ساقطٌ يخبنُ الغلاصِمَ والأع","ينُ في رُدنه لمنبت قَرْنه",20,"ن",2,0],["ساق الخليل إلى الخيلِ فناؤه","ليكون مدفوناً له أو دافنا",21,"ن",2,0],["ساقَت إِلى قَلبي الشُكوكَ فَنَغَّصَت","لَيلي وَلَيسَ مَعَ الشُكوكِ سُرورُ",22,"ر",1,0],["ساقوا إِلَيكَ مِئنَهُم وَأُلوفَهُم","فِرَقاً وَسُقتَ إِلَيهِمُ الآجالا",23,"ل",2,0],["سأقاسي الشقاء ما دمت حيا","واذم الحياة حتى اموتا",24,"ت",2,0],["ساقَ إِلى الدار خَميساً حازَها","وَقَتل المَهديَّ عِندَ المُلتَقى",25,"ا",1,0],["ساقَةَ النَعشِ بِالرَئيسِ رُوَيداً","مَوكِبُ المَوتِ مَوضِعُ الإِتِّئادِ",26,"د",1,0],["ساقَ لِلفَتحِ في المَمالِكِ عَرضاً","وَجَلا لِلفَخارِ في السِلمِ عَرضا",27,"ض",2,0],["ساقِيَ الطِلا","شُربُها وَجَب",28,"ب",1,0],["ساقي كُؤوسِ المَوتِ وَالجِريالِ","لَمّا أَصارَ القُفصَ أَمسِ الخالي",29,"ل",2,0],["سَأُقيمُ بَعدَكَ إِن أَقَمتُ بِغُصَّةٍ","في الصَدرِ لَم تَصعَد وَلَم تَتَصَوَّبِ",30,"ب",1,0],["ساقَت بِنا نَكبَةُ مُذَمَّمَةٌ","فينا وَدَهرٌ رَخيصَةٌ نُوَبُه",31,"ب",2,0],["ساقَ الأُمورَ بِعَزمِهِ فَاِستَوسَقَت","لِمُوَفَّقٍ في أَمرِهِ عَزّامِ",32,"م",1,0],["ساقَ أُمورَ السُلطانِ يُسلِكُها","نَهجاً مِنَ الرُشدِ واضِحاً سَنَنُه",33,"ن",2,0],["سَأُقيمُ بَعدَكَ عِندَ غَيرَكِ عالِماً","عِلمَ الحَقيقَةِ أَنَّني سَأَضيعُ",34,"ع",1,0],["ساق غرير يمزج ال","كأس لنا من ساقيه",35,"ي",2,0],["سَأَقنَعُ ما بَقيتُ بِقوتِ يَومٍ","وَلا أَبغي مُكاثَرَةً بِمالِ",36,"ل",1,0],["ساقٍ فَلَو طَرَحَ المُدامَ لَأَسكَرَت","صَهباءَ فاتِرِ طَرفِهِ النَعّاسِ",37,"س",1,0],["سَأَقطَعُ أَرسانَ العِتابِ بِمَنطِقٍ","قَصيرُ عَناءِ الفِكرِ فيهِ طَويلُ",38,"ل",1,0],["سَأَقطَعُ أَمطاءَ المَطايا بِرِحلَةٍ","إِلى البَلَدِ الغَربِيِّ هَجراً وَموصِلا",39,"ل",2,0],["سَأَقولُ قَولَةَ ناصِحٍ لَكَ يَنتَحي","قَلباً نَقِيّاً في رِضاكَ نَظيفا",40,"ف",2,0],["ساقٌ عَلى ساقٍ دَعا قُمرِيَّةً","فَدَعَت تُقاسِمُهُ الهَوى وَتَصيدُ",41,"د",1,0],["ساقٍ يسوقُ إلى السياق محبةً","ويرى شفاءَ حريقِه برحيقِه",42,"ه",1,1],["سَاقَها ما جُعِلَتْ من هَمِّهِ","هَمُّهُ تِلكَ النُّفُوسُ الشُّرَّدُ",43,"د",1,0],["ساقَهَا إلا بَعِيْرَيْنِ هما","من صفايا المالِ أو صُيَّابِهِ",44,"ه",1,0],["سَأَقتَضي مِنكَ حَقّي في القِيامَةِ إِن","كانَت نُجومُ السَما تُجزى عَنِ البَشَرِ",45,"ر",1,0],["ساقَها الأَزرَقُ الغَيورُ إِلى الشا","مِ فَذاتُ الأَشياءِ مِنها خَرابُ",46,"ب",1,0],["ساقَطَت مَنطِقاً إِلَيَّ رَخيماً","فَسَبَتني بِهِ وَقَد كُنتُ أَسبي",47,"ب",2,0],["ساقي الحَجيجِ أَبوهُ الخَيرُ قَد عَلِمَت","عُليا قُرَيشٍ لَهُ الغاياتُ وَالقَصَبُ",48,"ب",1,0],["ساقَ الرُفَيداتِ مِن جَوشٍ وَمِن عِظَمٍ","وَماشَ مِن رَهطِ رَبعِيٍّ وَحَجّارِ",49,"ر",1,0],["ساقٌ ترَنَّحَ يَشْدو فَوقَهُ ساقُ","كأنَّهُ لِحنينِ الصَّوتِ مُشْتاقُ",50,"ق",1,1],["ساق الطغاة لها فرائس فتنةٍ","حمراء ينفخ في الجحيم ربوبها",51,"ب",3,0],["ساق الينا الثمر العجابا","وأنجبت أوراقه إنجابا",52,"ب",2,0],["ساقي الجَريحِ وَمُطعِمُ الأَسرى وَمَن","أَمِنَت سَنابِكَ خَيلِهِ الأَشلاءُ",53,"ا",2,0],["ساقَت إليها الأسبابُ جُند بني ال","أحرارِ فُرسانُها مَواكِبُها",54,"ب",3,0],["سَاقَهَا مُثْلَةً تَوَهَّمَهَا خَيْر","اً وَكَانَتْ عَلَيْهِ شَرَّ نَآدِ",55,"د",1,0],["ساقوه حيران في مواطنه","لا بدوه في الصدى ولا حضره",56,"ر",2,0],["ساقت الموتَ إلى مصرَ، وإنْ","بعثَتْ في الشرق والغرب الحياةْ",57,"ا",2,0],["ساقاه جنزيران أعراقه","إذاعة مبحوحة زاحفه",58,"ف",2,0],["سأقول شيئا تافها","يكفي الذي قد كان يكفي",59,"ف",2,0],["سأقذِفُها وإنْ حُسِبَتْ شذوذاً","وإن ثقُلتْ على الأذنِ استماعا",60,"ع",2,0],["ساقَتْ جُيوشَ الموبقاتِ حواشداً","للرافدين مع الجيوشِ حواشدا",61,"د",2,0],["سأقذِفُ حُرَّ القولِ غيرَ مُخاتِل","ولا بدّ أن يبدو فيُخْزَى المُخاتل",62,"ل",1,0],["ساقها..؟ من برحة الوادي..؟ ليا.. حد... المواني..","وقال......؟ نامي ياغناة... الروح وأحلامس.. سعيده...",63,"د",2,0],["ساقَ الأُمُورَ بعَزْمِهِ، فاستَوثقتْ","لِمُوَفَّقٍ في أمْرِهِ، عَزّامِ",64,"م",1,0],["ساقوا إليك مثنهم وألوفهم","فرقا وسقت إليهم الآجالا",65,"ل",2,0],["ساق الخليل إلى الخليلِ فناؤه","ليكون مدفوناً له أو دافنا",66,"ن",2,0],["سَأَقدُّ مِن طَود القَريض مَدائِحاً","تَلقي إِلَيها الأَرض بِالأَفلاذ",67,"ذ",1,0],["سأقضي حياتي ثائر النفس هائجاً","ومن أين لي عن ذاك معدى ومذهب",68,"ب",1,0],["ساقطَ الوجه إن أراد سكوتا","ناقصَ القول إن أراد خصوما",69,"م",2,0],["ساقني الله نحو ارض زبيد","ودعتني كواذب الأوهام",70,"م",1,0],["ساقَها الحَينُ لِنَفسي","جَهرَةً وَهيَ عَيوفُ",71,"ف",1,0],["ساقَهُم لِلحِجازِ أَيُّ حنينٍ","ضَمَّهُ مِن ضُلوعِهِم أَحناءُ",72,"ا",2,0],["سأقيمُ عُذْرَ السمهريِّ فإنما","تُدْمي لحاظُكِ لا الوشيجُ الأسمر",73,"ر",1,0],["ساقي الحَجيجِ وَهَذا ياسِرٌ فَلَجٌ","وَالمَجدُ يورَثُ أَخماسا وَأَسداسا",74,"س",2,0],["ساق عليه سمات البشر قد ظهرت","اما تراه غدا بالراح مختضبا",75,"ب",2,0],["ساق اذا ما لم تدر صهباؤه","فيديرها من مقلة حوراء",76,"ا",2,0],["ساق عن المصباح بغني وجه","وعن النديم بقوله المستظرف",77,"ف",1,0],["ساق بمجلسه اللذات قد كملت","تجانس الحسن في معناه والادب",78,"ب",1,0],["ساق ففيه المدام طاب وقد","حلا ارتشافا فما الذ فمه",79,"م",2,0],["ساق به كملت ليالي الأنس فال","ريق المدام وفرقه المصباح",80,"ح",1,0],["ساق يطوف بها خمراء صافية","من ورد خديه ام من فيه معتصره",81,"ر",2,0],["ساق لنا عنقودها قد جنى","من صدغه في سالف العصر",82,"ر",1,0],["ساق اذا طاف في مخيمه","كلمني والمدام في فمه",83,"ه",1,0],["ساق يطوف بكأسه فيديره","شمسا تجلت عن صباح جبين",84,"ن",1,0],["سأقتل روحي فديةً لشبابكم","ألا إنما المقمور في الصدق قامر",85,"ر",1,0],["سأقطع ليلى بالأماني أديرها","أقول لها ما أشتهى وتقول",86,"ل",1,0],["سأقضى نهار العيد وحدى بلوعة","أناجيك فيها والمناجاة تمتع",87,"ع",1,0],["ساقني الطرف الى هذا الردى","ويح قلبي من سهام المقل",88,"ل",1,0],["ساقَ الهَدايا مُشعِراً وَمُقَلِّداً","قَد أُعفِيَت عَن حلقَةٍ وَأَسانِ",89,"ن",1,0],["ساقَتهُمُ أَيّامُ مَك","كَةَ وَالمَحارِمُ وَالحَطيمُ",90,"م",1,0],["ساقَهُ اللَهُ إِل