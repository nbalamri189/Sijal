038","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83460","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133168","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33235","الخفيف"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119512","الطويل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136391",""],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136387",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120512","الطويل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204312","الطويل"],[4750,"قبة الفرو","https://www.poetsgate.com/ViewPoem.aspx?id=180419",""],[4750,"ياوليفي دمعكم في غيابي ردّ لي","https://www.poetsgate.com/ViewPoem.aspx?id=180434",""],[4767,"ساعة الصفر","https://www.poetsgate.com/ViewPoem.aspx?id=179844",""],[1901,"عدتْك كرائمُ الديَمُ الغوادي","https://www.poetsgate.com/ViewPoem.aspx?id=160388",""],[4884,"من ماجدٍ إلى ماجد","https://www.poetsgate.com/ViewPoem.aspx?id=210428",""],[4929,"سحر الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=199428",""],[5064,"الرُّوح","https://www.poetsgate.com/ViewPoem.aspx?id=199136",""],[585,"هل في القطين وراء المنش مستمع","https://www.poetsgate.com/ViewPoem.aspx?id=161904",""],[3591,"على الله أجر المسّهام المتيّم","https://www.poetsgate.com/ViewPoem.aspx?id=149475",""],[5121,"صَهٍ صَهٍ","https://www.poetsgate.com/ViewPoem.aspx?id=33838",""],[5136,"أيامنا بين أعراس وأفراج","https://www.poetsgate.com/ViewPoem.aspx?id=121540",""],[5277,"رسالةٌ مشفّرة","https://www.poetsgate.com/ViewPoem.aspx?id=195132",""],[5277,"قصارى القول..في رسول الله صلى الله عليه وآلهِ وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=212991",""],[5318,"\"لإربدَ\" أن تُعاتبَ ما اْستطابتْ..","https://www.poetsgate.com/ViewPoem.aspx?id=211011",""],[592,"أهاجك أم أشجاك رسم المعاهد","https://www.poetsgate.com/ViewPoem.aspx?id=128839",""],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""],[5353,"ارح صوتك الدامي","https://www.poetsgate.com/ViewPoem.aspx?id=212647",""],[5358,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=21890",""],[5525,"هام القصايد","https://www.poetsgate.com/ViewPoem.aspx?id=30108",""],[5626,"يا زورق الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=189562",""],[5653,"خليلي من قيس بن عيلان خليا","https://www.poetsgate.com/ViewPoem.aspx?id=26386",""],[5720,"القِلادَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=214547",""],[5751,"كل ما فيها يُغنّي","https://www.poetsgate.com/ViewPoem.aspx?id=215018",""],[5910,"سلامٌ على تلك الدِّيار","https://www.poetsgate.com/ViewPoem.aspx?id=206229",""],[5956,"أعِنّا يا إله الناس","https://www.poetsgate.com/ViewPoem.aspx?id=192567",""],[6068,"ل بُونَةَ فِي قَلْبِي غَرَامٌ مُطَابِق -26-","https://www.poetsgate.com/ViewPoem.aspx?id=175807",""],[6261,"الأستاذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82131&r=&rc=3",""]],"verses":[["وَإِن تَستَجِمُّ النائِباتُ سَوابِقي","فَمِن قَبلِ ما بَذَّ الجِيادَ رِهانُها",0,"ن",3,0],["وَإِن تَسأَلوا يا تَيمُ عَنكُم تَحَدَّثوا","أَحاديثَ يُخزيكُم بِنَجدٍ يَقينُها",1,"ن",3,0],["وَإِن تَسأَلوا عَنهُم لَدى كُلِّ غارَةٍ","فَقَد يُنبَأُ الأَخبارَ مَن كانَ سائِلا",2,"ل",2,0],["وإن تسخير فكري فيك قافيةً","لسُخْرة منه خفَّت عندها السُّخَر",3,"ر",1,0],["وأنتَ سيدُ هذا الخلق كلهمُ","طولاً وفضلاً وإنعاماً وسيِّدنا",4,"ن",2,0],["وَإِن تَسأَلونا بِالحَريشِ فَإِنَّنا","مُنينا بِنوكٍ مِنهُمُ وَفُجورِ",5,"ر",1,0],["وَأَن تَسعَيا مَسعاةَ سَلمى بنِ جَندَلٍ","وَسَعيَ حُبَيشٍ بَينَ غَولٍ وَقادِمِ",6,"م",1,0],["وَإِن تَسكَر لِكَي تَنسى هُموماً ذاتِ أَوقارِ","خَسِرتَ الدين وَالدُنيا وَلَم تَربَح سِوى العارِ",7,"ر",1,0],["وَإِن تَسَل عَمَّن بِهِ","لَم تَلقَ إِلّا خَدَمَك",8,"ك",1,0],["وَأَنتَ سَماءُ اللَهِ فيها الَّتي لَهُم","مِنَ الأَرضِ يُحيِي مَيِّتَ الأَضِ ماؤُها",9,"ا",3,0],["وَإِن تَسأَلوا أُذنَي قُتَيبَةَ تَشهَدا","لَكُم وَاِبنَ عِجلى إِذ يُسَحَّجُ في البُردِ",10,"د",1,0],["وإن تَسْأَلوني قَطرةً من مَحاسنٍ","فحَوضيَ من ماءِ المحاسنِ مُفعَمُ",11,"م",1,0],["وَأَن تَستَخِفَّ بِدارِ الغُرورِ","وَأَن تَستَعِدَّ لِإِحدى الكُبَر",12,"ر",1,0],["وأنتِ سماءٌ يعشقُ المرءُ نورَهَا","ويعشقُ ما في أفقِها مِن تجهُّمِ",13,"م",1,0],["وَأَنتَ سَمحٌ بِطَبعٍ غَيرِ مُنتَقِلٍ","سِيّانِ في المحلِ مِنكَ الجَوْدُ وَالمَطَرُ",14,"ر",1,0],["وَأَنتَ سَفيهٌ رَأى مِثلَهُ","فَقالَ السَفاهُ لَهُ عَيِّبِ",15,"ب",1,0],["وَأَن تُسَمّى رِجلُهُ حافِراً","في واجِبِ التَشبيهِ أَو فِرسِنا",16,"ن",2,0],["وَإِن تَسأَلي بي فَإِنّي اِمرُؤٌ","أُهينُ اللَئيمَ وَأَحبو الكَريما",17,"م",2,1],["وَإِنْ تَسْمَحْ فَتَعْدُدْنِي مُرِيداً","فَمَا عَدِّي مُرِيداً بِالْقَلِيلِ",18,"ل",1,0],["وأنت سرُّ خُضرة الروابي","وثَمَر النخيل والأعْنَاب",19,"ب",1,0],["وَأنْتَ سَمَاءُ الله فِيها التي لَهُمْ","من الأرْض يُحيي ميّتَ الأرْض ماؤها",20,"ا",3,0],["وأنت سَميُّ أصدقِ ذي لسان","فهل بالصدق دونك مُسْتَبَدُّ",21,"د",1,0],["وأنت سر لسان روح حكمته","عليا عبارتها في شانها برعت",22,"ت",1,0],["وأنت سطوة عز عند حضرتها","هامات أعيان كبار الورى خضعت",22,"ت",1,0],["وأنتَ سَليلُ المَجْدِ مِن آلِ (حِمْيَرٍ)","(وذي يَزنٍ) والقَيلِ (سيفٍ) (وتُبَّعِ)",23,"ع",1,0],["وَإِن تَسأَلي الأَقوامَ عَنّي فَإِنَّني","لَمُشتَرِكٌ مالي فَدونَكِ فَاِسأَلي",24,"ل",2,0],["وَإِن تُسهِلوا لِلخَيلِ تُسهِل عَلَيكُمُ","بِطَعنٍ كَإيزاعِ المَخاضِ الضَوارِبِ",25,"ب",1,0],["وإِن تَسَلَّى بنأىٍ أو بِتَذكِرَةٍ","أو إتِّئَادٍ شَجَاهُ النُّؤىُ والوَتِدُ",26,"د",1,0],["وأن تسألوني تسألون مجربا","ملوكا سواه ليس فيهم له ند",27,"د",1,0],["وأنت سؤلي من الزمان فجد","عليّ في منّة قبح خلقانه",28,"ن",2,0],["وأنت سراجُ الحقّ في كلّ شبهة","وغوثُ الورى واليسرُ في أثَر العسر",29,"ر",1,0],["وَإِن تُسري وَلَم يَملَأ فَضاءَ ال","بَسيطَةِ حَولَها الجَيشُ اللُهامُ",30,"م",1,0],["وَأَن تَستَلينَ الحادِثاتُ عَريكَتي","وَتَعلَمُ أَني مِن نَذاكَ بِمَرصَدِ",31,"د",1,0],["وإن تسل عن الّذي علّمتَه","فالجهل فيه كلّ شيءٍ علّمهْ",32,"م",2,0],["وَاِنتِسابي إِلى عُلاكَ اِفتِخاري","بَينَ قَومي في بُكرَتي وَعَشِيِّ",33,"ي",1,0],["وَإِن تَستَعِذ مِنهُم بِأَعظَم مَيِّتٍ","فَذَلِكَ حِصنٌ مانِعٌ لَكَ حارِسُ",34,"س",1,0],["وانْتَسَبَت في أَشرَفِ المَحاتِد","فَلَيسَ عَنْها أَحدٌ بِحائِدِ",35,"د",1,0],["وَإِن تَسأل فَدَيتك عَن صَفائي","فَإِنَّ العَيش بَعدَكَ ما صَفا لي",36,"ل",2,0],["وَان تَسمَع تِلاوَتِه تجده","حَكى داود يَلهج بِالزُبور",37,"ر",1,0],["وأنت سديدٌ من يدِ اللهِ مُرسَلٌ","وإصلاحُ أحوالِ العبادِ له هَدَف",38,"ف",1,0],["وأَنت سحابٌ إذا ما مطَرتَ","عَمَمْتَ لنا القُربَ والبُعدَ قَطرا",39,"ر",2,0],["وإِن تَسمَعوها خَلوَةً فَشِكايَةٌ","وَإِن تَسمَعوها في المَلا فَاِسمَعوا الشُكرا",40,"ر",2,0],["وأنت سماءٌ فيك أشرق دينُنا","مليّاً وأعشى عينَ ضدٍّ وحاسد",41,"د",1,0],["وإن تسل من بعدُ عن خلقه","فندي التحقيق في ذا المقا",42,"ق",2,0],["وأنتسى الأيام في صعدة","سقى رباها مطر صيِّب",43,"ب",1,0],["وإن تسل جيرون عنه يقل","يا صاحِ إني عبده إلا صغر",44,"ر",1,0],["وان تسامت على ضعفي بقوتها","يأتي لنصري معينا عسكر التتن",45,"ن",1,0],["وأنت سماء المكرماتِ وإنما","يرجّي السماء الناسُ حين تحجّبُ",46,"ب",1,0],["وأَنْ تَسْألوا اللهَ طُولَ البَقَاءِ","لِعَبْدِ المَلِيكِ مَليكِ العَرَبْ",47,"ب",1,0],["وإن تسقني اللَهم منك برحمةٍ","فانقع من سلسالها غلة الصادي",48,"د",2,0],["وإن تسابق سواها في مآثرها","فلن يساورها ظلم وتبديد",49,"د",1,0],["وانتسم الريح الصبا ومن له","بنفحةٍ من الصَّبا طُوالَه",50,"ل",2,0],["وأن تستقيموا في الأمور جميعها","لأنكم الهادون في المدن والقرى",51,"ر",2,0],["وإن تسمعت فاستهوتك أغنية","حاذر سقوطك بين اللهو والطرب",52,"ب",1,0],["وانْتِساقِ الأسرارِ سِرًّا فَسِرًّا","وامْتِزاجِ التَّركيبِ في كُلِّ شَيِّ",53,"ي",1,0],["وأنت سنان في القناة التي هم","جميعاً أنابيب لها وكعوب",54,"ب",1,0],["وأنت سويتني من نطفة رجلاً","وفيَّ منك بنفخ الروح تحييني",55,"ن",2,0],["وانتساب الخلق للعقل كما","قال عيسى وعلى الأذن حمل",56,"ل",1,0],["وإن تسكت وتكرهه بقلب","فقلبك ما له فيهم خفاء",57,"ا",2,0],["وأنتَ سِبطُ عَليٍّ وابنُ فاطِمَةٍ","إنَّ الأصُولَ عليها تَنبُتُ الشَّجرُ",58,"ر",1,0],["وإنْ تُسْعِدَا مَنْ أَسْلَمَ الصَّبْرُ قَلْبَهُ","يُعَرِّسْ بدوحِ البَانِ مِنْ عَرَصَاتِها",59,"ت",3,0],["وإِن تسربلتَ فيه قُمْصَ أَسىً","تَسَرْبَلَ الصبرَ قَلْبُهُ قُمُصَا",60,"ص",2,0],["وإن تسَوَّق بالألفاظ ألحقهُ","حُكْم الملوك ذَوي البُقْيا على السُّوَقِ",61,"ق",1,0],["وأنت سيدُهم بل أنت أشرفُهم","قدراً وإن عدلوا فيها وإن جاروا",62,"ر",3,0],["وإن تسألهُ كشف بَلاً","رجعت بوجه مسرورِ",63,"ر",1,0],["وان تسم نحو الفقر نفسك فاطرح","هواها وجانبه مجانبة الشر",64,"ر",1,0],["وأنت سماء للموالين ثره","أجل أم سمام للمعادين ناقعُ",65,"ع",1,0],["وأنت سرقت يابانات سلع","من الحسناء لي ذاك التئني",66,"ن",2,0],["وَإنْ تَسَلْ عَمَّا جَرَى مَدْمَعِي","فَلاَ تَسَلْ يَا مَا جَرَى وَاتَّفَقْ",67,"ق",1,0],["وَإن تستمحه في السماحةِ تَستَمح","أبرّ جوادٍ للمَواهبِ غالبِ",68,"ب",1,0],["وَانْتَسَجَتْ في الرِيحِ بُطْنانُ القَرَقْ","وَشَجَّ ظَهْر الأَرْضِ رَقّاصُ الهَزَقْ",69,"ق",1,0],["وَأَنتَ سَمعٌ في العالَمين له","وَمُقلَةٌ ما يَكِلّ ناظرها",70,"ر",3,0],["وَأَنت سَرسورها وَسائسها","فَهَل عَلى الحَقّ أَنتَ قاسرها",70,"ر",3,0],["وَإِنْ تُسْفِرْ فإِنَّ الأَرْضَ أَرْضِي","بِأُنْسِكَ والسَّماءَ إِذَنْ سَمَائي",71,"ي",1,0],["وإِنْ تَسُمْني فَوْقَ هذا فَقَدْ","كَلَّفْتَني فَوْقَ الَّذي أَستطيعْ",72,"ع",1,0],["وان تسعد وبالوصل حتى يزول ما","لدي من الاحزان يسهل لي صعبي",73,"ب",2,0],["وأنت سؤلي إلاهي","وعدتي لمقري",74,"ر",2,0],["وانتسب طائعاً الى باب مولا","ك فما خاب من اليه انتسابه",75,"ب",2,0],["وَاِنتَسَفَ الجالِبَ مِن أَندابِهِ","إِغباطَنا المَيسَ عَلى أَصلابِهِ",76,"ه",1,1],["وأَنت سعيدُ الجَدِّ أَكرم قادم","بيوم حبته بالسّعُود المقادِرُ",77,"ر",1,0],["وأنت سيفٌ لدين الله منصلتٌ","فما بشرعك عن تأييده كلل",78,"ل",1,0],["وإن تُسألِ الأطلالُيوماً شهادةً","بما كان فيها من مصيفٍ ومَربَعِ",79,"ع",1,0],["وإن تسْتَطيبي فابْدَئيني بزورةٍ","فإنك أولى بالزيارةِ والبر",80,"ر",1,0],["وأن تسبي علوج بني زياد","حرائركم كما يسبون زنجا",81,"ج",2,0],["وإن تسألاني عن زماني فإنما","لساني بما في صدرهِ منهُ أعلمُ",82,"م",1,0],["وان تستنفروا جمعا لهاما","تغص به السباسب والبحارى",83,"ر",2,0],["وَأَنتَ سَيِّدٌ بِهِم مُلصَق","كَما أَلصَقتَ رُقعَةُ الشاعِبِ",84,"ب",1,0],["وإن تسألوا عن بعض ما اقترف الورى","من الإثم فالرحمن للتوب قابل",85,"ل",1,0],["وإن تسوّده قام القوق بيّضها","مهما روى عطشاً فيها بتسييل",86,"ل",1,0],["وأن تسلني اين ضاعَ دمي","فاطلبه وانظر ما حوت وجنتاه",87,"ا",2,0],["وان تستبق للمجد خيل سوابق","فحامله منها الوجيه ودا