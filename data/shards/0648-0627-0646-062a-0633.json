"ل",1,0],["وإن تسأل عن الشعرا فأنا","ملوك في ثياب باليات",116,"ت",1,0],["وإن تسئ يوماً إليها وتس","تغفر فذاك الذنب لا يغفر",117,"ر",1,0],["وإِن تسأَموا مِن رِحلَةٍ أَو تُعَجِّلوا","إِنى الحَجِ أُخبِركُم حَديثاً مُطَنِّبا",118,"ب",2,0],["وإن تسفكو فيها الدماء فإنها","لكم هدرٌ لا تحذر وأمن معاقب",119,"ب",1,0],["وإن تسئلا عن جوده وسخائه","فكفاه مثل المعصرات الهوامع",120,"ع",1,0],["وَإِن تَسَارَعَ أوغَادُ إِلَى شَرَفٍ","بأرجُلِ الحَظِّ فَاقعُد أنتَ ذَا عَرَجِ",121,"ج",1,0],["وأنت سميعٌ يا سميع أجب لنا","دعوناك في عسرٍ رجوناك في يسرِ",122,"ر",1,0],["وإن تسلل بوارقه لحرب","فإن البرق من سمة الغوادي",123,"د",2,0],["وإن تسمح فإنك ذو سماح","تسهل شدة اليوم الشديد",124,"د",1,0],["وَأَن تُسكِتَ الأَحدَاثُ مِحرَابَ سَاجِدٍ","وَكَانَ بِهِ التَّسبِيحُ يُفعِمُهُ فَعمَا",125,"م",2,0],["وأنت سرحت بتلك البقر","على شم إيذا الكثيف الشجر",126,"ر",1,0],["وان تَسبَعوا نَثمِن وان يَكُ تاسِعٌ","يَكُن عاشِرٌ حَتّى يَكونَ لَنا الفَضلُ",127,"ل",1,0],["وأنت سرّ اللَه في أرضه","تعلم ما دقّ وأخفى الخفا",128,"ا",1,0],["وان تسل عن الخفاف الرايقه","فقد أتت مع ذي السجايا الرائقه",129,"ه",1,0],["وأنت سماء مجد فالدراري","فراش طائف بسنا شهابك",130,"ك",1,0],["وان تسألوا عن داره فهي طيبة","وإن تسألوا عن مائه فهو زمزم",131,"م",1,0],["وان تسألا عن لونه فهو مشرَبٌ","وان تسألوا عن قدره فمعظم",131,"م",1,0],["وان تسألوا عن وجهه فهو روضة","وإن تسألوا عن خلقه فالتبسم",131,"م",1,0],["وان تسألوا عن بعده فهو خيبة","وان تسألوا عن قربه فهو مغنم",131,"م",1,0],["وإن تَسُقْ غيرَ وصفِ الشيء عن خَبرٍ","له فأبرز من الأضمارِ ما اكتتما",132,"م",2,0],["وإِن تَسامَيتَ فَقُل دِعصُ نَقاً","عَلَيهِ غُصنٌ فَوقَهُ بَدرُ دُجى",133,"ا",1,0],["وانتَسَبَ المَعَنى بلُطفِ حيلةٍ","فيها إلى المَعنى الذي مِنهُ انتَفَى",133,"ا",1,0],["وَإِنْ تَساوَتْ بِحالَيْهِ لَهُ قِيَمٌ","فَالدُّرُّ يَزْدادُ حُسْنَاً وَهْوَ مُنْتَظِمٌ",134,"م",1,0],["وَإِن تَسأليهِ حاجَةً فَتَوسّلي","إليهِ بخير الخَلق في السرّ وَالجَهرِ",135,"ر",1,0],["وإن تسكتوا زاد الظلام كثافةً","ويعلو على النسب الشريف وضيع",136,"ع",1,0],["وانتساباً إن رام ذاك فهذا","من همومٍ حلَّت بقلبٍ 