{"poems":[[95,"في أي جو بالأسى مفعم","https://www.aldiwan.net/poem11348.html","السريع"],[71,"غريبة الدار سبت مهجتي","https://www.aldiwan.net/poem28179.html","السريع"],[71,"كم أسقط شاهدا وعدل ضابط","https://www.aldiwan.net/poem29130.html","الدوبيت"],[112,"الطايش","https://www.poetsgate.com/ViewPoem.aspx?id=8376",""],[112,"المستحيل","https://www.poetsgate.com/ViewPoem.aspx?id=8394",""],[193,"برئت من عقيدة الأشرار","https://www.aldiwan.net/poem35101.html","الرجز"],[193,"أقبل على مدح النبي مفخما","https://www.aldiwan.net/poem35104.html","الكامل"],[1840,"","https://poetry.dctabudhabi.ae/diwan/poem/216635",""],[2483,"","https://poetry.dctabudhabi.ae/diwan/poem/144374","السريع"],[3653,"","https://poetry.dctabudhabi.ae/diwan/poem/146541","المنسرح"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[4155,"","https://poetry.dctabudhabi.ae/diwan/poem/178124","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58179","الرجز"],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/199652","الرجز"],[4747,"رسالة إلى صدام","https://www.poetsgate.com/ViewPoem.aspx?id=17213",""],[4799,"حبيبي رسول الله ( ص )","https://www.poetsgate.com/ViewPoem.aspx?id=12263",""],[4916,"ياليته يطير ويحلّق علشاني","https://www.poetsgate.com/ViewPoem.aspx?id=135651",""],[4916,"للذاكره روح وامسحني","https://www.poetsgate.com/ViewPoem.aspx?id=157794",""],[4916,"انته ملكت القلب وانته حكمته","https://www.poetsgate.com/ViewPoem.aspx?id=157795",""],[5039,"من وين ؟..ولو ين؟","https://www.poetsgate.com/ViewPoem.aspx?id=48138",""],[5061,"ياوطن","https://www.poetsgate.com/ViewPoem.aspx?id=147162",""],[5061,"دنيا الفنا","https://www.poetsgate.com/ViewPoem.aspx?id=152995",""],[5122,"مابين كفي والقلم","https://www.poetsgate.com/ViewPoem.aspx?id=24074",""],[5222,"احساسي","https://www.poetsgate.com/ViewPoem.aspx?id=200134",""],[5344,"في بعاده امتلى صدري كئابه..","https://www.poetsgate.com/ViewPoem.aspx?id=155074",""],[5344,"إلتقينا","https://www.poetsgate.com/ViewPoem.aspx?id=180697",""],[5357,"مسامحك","https://www.poetsgate.com/ViewPoem.aspx?id=16499",""],[5376,"الدهرُ أمتعنا بالرود والغيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=188404",""],[5434,"لاتسقط شرفها","https://www.poetsgate.com/ViewPoem.aspx?id=37615",""],[5455,"باب النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=213952",""],[5455,"اللي تركني","https://www.poetsgate.com/ViewPoem.aspx?id=34697",""],[5461,"من كثر حبي","https://www.poetsgate.com/ViewPoem.aspx?id=5296",""],[5526,"من كثر ماراحو من الناس غالين","https://www.poetsgate.com/ViewPoem.aspx?id=201524",""],[5526,"خلف الشبابيك","https://www.poetsgate.com/ViewPoem.aspx?id=209124",""],[5587,"الحب سرار","https://www.poetsgate.com/ViewPoem.aspx?id=197803",""],[5756,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=5431",""],[5756,"الذهب","https://www.poetsgate.com/ViewPoem.aspx?id=5187",""],[5764,"الواقع المر","https://www.poetsgate.com/ViewPoem.aspx?id=137045",""],[5784,"ضفدع","https://www.poetsgate.com/ViewPoem.aspx?id=199021",""],[5848,"شعر ومواويل","https://www.poetsgate.com/ViewPoem.aspx?id=51949",""],[5848,"أنصحك تكسر الجوال","https://www.poetsgate.com/ViewPoem.aspx?id=48964",""],[5848,"احضنيني","https://www.poetsgate.com/ViewPoem.aspx?id=53204",""],[5848,"مالك ومال للتعب ياجارة الوادي","https://www.poetsgate.com/ViewPoem.aspx?id=48821",""],[5848,"فرحة حزين","https://www.poetsgate.com/ViewPoem.aspx?id=50617",""],[5848,"لا تسهر","https://www.poetsgate.com/ViewPoem.aspx?id=50625",""],[5950,"مورقه يا طواريق الطريق الطويل","https://www.poetsgate.com/ViewPoem.aspx?id=139963",""],[6115,"يارصيف الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=180526",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""]],"verses":[["مَنْ كَثُرَتْ أَصْحَابُهُ حَوَّلَتْ","حُلْوُهُمُ الدُّنْيَا إِلَى عَلْقَمِ",0,"م",1,0],["مِنْ كثرةِ القانيَ منْ خدها","أشكو فيشكو قلةَ القاني",1,"ي",1,0],["من كثرةِ ما يسقطُ خافتْ حلب","أن يكتبَ ظاءَ حظِّها بالساقط",2,"ط",1,0],["من كثر ماحبّه.,؟ أحب أمّه وأبوه","بالمختصر؟ أحبّهم جماعته",3,"ت",2,0],["من كثر ما أأأأأعشق في عشقك المستحيل","لانشف بحرك ؟ أعمللّي ..بحر ..... وأسبحه",4,"ح",2,0],["مِن كثرةِ المصائب الطواري","في زَمَنٍ دُبّر بالإدبارِ",5,"ر",1,0],["مِن كثرِ زلّاتٍ وعظمِ جرائرِ","لَكِن عَفا عفوَ الكريم القادرِ",6,"ر",1,0],["مِنْ كِثْر شَوْقِيْ غدا فكري مشرّد","وكِلّ لَيْلِهْ فِيْ منامي لِهْ زيارة",7,"ر",2,0],["من كثر الجند رأى سعده","يصعد حتى ينتهى حده",8,"د",2,1],["من كثرة الاختلاف يا سكني","قد صرت في الناس شهرةً آية",9,"ه",1,1],["من كثرت قل نعم الله عليهْ","قل كثرت حوائج الناس إليهْ",10,"ه",1,0],["من كثرة القردان في صهوته","تحسبه مجدّراً محصّبا",11,"ب",2,0],["من كَثُرَ الدهرَ إذاً كلامُهْ","كَثُرَتْ يوم القضَا آثامُهْ",12,"ه",1,0],["من كثرة الدين وفقر مدقع","وأنت ظلي وإليك مفزعي",13,"ع",2,0],["من كثر ما يرتميه يخاف من ظله","ومن يعلم الغيب لو عدي قتاله",14,"ل",2,0],["من كثرة الكره بينتوا العدائيّه","ومن دافع الحقد لا تقولون حريّه",15,"ي",2,1],["من كثر ما اغليه ما ودي يدوس الثرى","ياليته يطير .. ويحلّق .. علشاني",16,"ن",2,0],["من كثر (صدّك).. بديت اقنع","تعال ..وإلا إنسني وبحني !!",17,"ن",2,0],["من كثر ماهو منك يائس ..ومحروم","كم واحدن لا مّر بإسمك زهمته!",18,"ت",2,0],["من كثر شوقي لك سبقت لك الأيام","صرت الخميس وتوها الناس الأثنين",19,"ن",1,1],["من كثر ماحبك سعى في دمي","غطا على دمي وصار بدالہ",20,"ل",1,0],["من كثر-صبري شيب الراس ياسعود","والنفس .....ماعاد تتحمل عناها",21,"ا",3,0],["من كثرها محد(ن) يعدد ابدودها","من أقصا اليمن لآيران وأطرافهم بأنيل",22,"ل",1,0],["من كثر ما هاجم الفرقا خسر بالدفاع","حتى تمنا يبات الليل فوق شجره",23,"ر",2,0],["من كثر ماكنت اسرح في جنابه,","كنت أشك انه حقيقه او خيال.!..",24,"ل",1,0],["من كثير الهم صرنا ناحلين،","وكل منّا مع متاهاته وَلَف",25,"ف",1,0],["من كثر ما احبك وابيك ... وانته معاي اوله عليك","واعذرك لو مالك عذر ... من كثر ما احبك وابيك",26,"ك",1,0],["من كثر شجوك قد سلمت غيبته","لم يفلح العقل من شجب وتنديدِ",27,"د",1,0],["من كثر ماتكتم تزايد تلفها","بين كداها بالعروق الصخافي",28,"ف",2,0],["من كثر ماكنت أدوّر في شوارعها جواب :","هو صحيح الحب أعمى ! أو عيون الناس عور ؟!",29,"ر",1,0],["من كثر ماكان طيفه دايم قبالي","احيان احسه معي وتضمه ايديني",30,"ن",2,0],["من كثر حبي لك تركتك وصديت","والقلب خالفني عليك وتركني",31,"ن",2,1],["من كثر ماراحوا من الناس غالين","صار الوداع أحيان فيني يتجوّل",32,"ل",1,1],["من كثر ما احبك وافرح بطاريك","اشوف من هو بالبشر نفس اسمك",33,"ك",1,1],["من كثر ما احبك واحيى بطاريك","ودي السوالف كلها بس ب اسمك",33,"ك",1,0],["مِنْ كُثَرْ لَوْجَاعْ دَمِي رَابْلِي","الَعْقَلْ تْلَفْ وْ الكْلَامْ مْنِينْ نْجِيبْ",34,"ب",1,0],["من كثر ما كنا نجامل ونحتار","صرنا نخاف نعارض اللي يقولون",35,"ن",1,0],["من كثر ما خفاقها بالدعا ذاب","صارت تحس إن زملاي كرهوني",36,"ن",2,0],["من كثر ما صاروا من طبوعي قراب","حتى بلبسة شمغهم قلدوني",36,"ن",2,0],["من كثر ماكنت بالاحساس جباره","أحس فيروز تقصدني باغانيها",37,"ي",3,0],["مِنْ كَثْرَةِ التَّقْرِيعِ تَقْفِزُ هَارِبًا","مُسْتَنْفِرًا نَحْوَ الْبُحَيْرَةِ مُسْرِعَا",38,"ع",2,0],["من كثر ما كذبت الأحلام صدقت :","إن التعب بحرٍ بليا مواني",39,"ن",2,0],["من كثر ما الهم جال وصال","في قلبي .. استمطرت عيني",40,"ن",2,0],["من كثر ما حزني غدا محتويني","بديت احس اني بحزني أناني",41,"ن",2,0],["من كثر ماهو م هو عادي , غدا عادي","ومن كثر ما كنت أكذّب فيه , صدقته",42,"ت",2,0],["من كثر ما اشوف قلبي يابسٍ راسه","على غرامك أشك انه تلبّسني",43,"ن",2,0],["من كثر ما احتاج له واوله لتحنانه","احس حتى جفاه بداخلي أزهر",44,"ر",1,0],["من كثيره بقى للعابرين القليل","اقروا الحزن ماحول المغنّي طرب",45,"ب",1,0],["من كثر هذرك معك نوبة سعال","بالسوالف تدرّج مثل الرحا",46,"ح",2,0],["مِن كثر ما سنوا عَجايب مُنوعة","رخصة وَالها كل دار ايوان",47,"ن",1,0]]}