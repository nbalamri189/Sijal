ttps://poetry.dctabudhabi.ae/diwan/poem/136678",""],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139296","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72786","الخفيف"],[4560,"","https://poetry.dctabudhabi.ae/diwan/poem/143254","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141677","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120415","الخفيف"],[4717,"رثاء مصطفى القاسم","https://www.poetsgate.com/ViewPoem.aspx?id=199669",""],[5074,"شوق واعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=153919",""],[5092,"دنيا","https://www.poetsgate.com/ViewPoem.aspx?id=179344",""],[5111,"الكهف والرقيم","https://www.poetsgate.com/ViewPoem.aspx?id=212067",""],[5131,"يا بلادي ما اغتربنا ما نأيْنا","https://www.poetsgate.com/ViewPoem.aspx?id=42208",""],[5315,"رام أَن يتْرك الْهوى فَبَدَا لَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=190297",""],[5335,"الغرير","https://www.poetsgate.com/ViewPoem.aspx?id=35189",""],[5376,"يا نبيُّ اللهِ يا نورُ السما","https://www.poetsgate.com/ViewPoem.aspx?id=188536",""],[5376,"يا نبيُّ اللهِ يا نورَ السما","https://www.poetsgate.com/ViewPoem.aspx?id=199017",""],[5409,"لعبوا كيفما أرادوا وقالوا","https://www.poetsgate.com/ViewPoem.aspx?id=155382",""],[5431,"وضياءات للرؤى في الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=197022",""],[5433,"العنود","https://www.poetsgate.com/ViewPoem.aspx?id=36261",""],[5461,"أعظم الحب","https://www.poetsgate.com/ViewPoem.aspx?id=5236",""],[5470,"يزري به الألم","https://www.poetsgate.com/ViewPoem.aspx?id=11007",""],[243,"عرب الثأر فاهتفي يا ضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=50475",""],[5696,"بين الرياء والحياء","https://www.poetsgate.com/ViewPoem.aspx?id=151407",""],[5764,"حيرة الجاني","https://www.poetsgate.com/ViewPoem.aspx?id=174653",""],[5829,"قالت الاعوام صبرا","https://www.poetsgate.com/ViewPoem.aspx?id=214632",""],[6102,"نَكهَةُ الغَدر","https://www.poetsgate.com/ViewPoem.aspx?id=182767",""],[6189,"بيان للجماهير المحتشدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83593&r=&rc=60",""],[6192,"هل أتاكم حديث الخيول ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63746&r=&rc=12",""],[6324,"لا تسل عن أرقي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87946&r=&rc=11",""],[6331,"خبِّريني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82020&r=&rc=1",""],[6336,"لقاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73564&r=&rc=25",""]],"verses":[["كُلَّمَا لاحَ كَوْكَبٌ فِي ذُرَاهَا","كَوَّرَتْهُ حَوَادِثٌ الأَيَّامِ",0,"م",1,0],["كلَّما لاحَ في عجاجِ سوادٍ","وقرَ البيضَ من سواد عجاج",1,"ج",1,0],["كلما لاح مجده وقريضي","سبح الناظر الخبير ونزّه",2,"ز",2,0],["كُلَّما لاحَ خَيالٌ خافَ","مِن ذاكَ الخَيالِ وَاِقشَعَرّا",3,"ر",2,0],["كَلَمَ السُهادُ بُيوتَ هُدبِهِما","وَأَقامَ بَينَ رُسومِها الحُمرِ",4,"ر",1,0],["كُلَّما لُبِّسَت بِأَهلِ زَمانٍ","شَهِدَت مِن زَمانِهِم آثامَه",5,"م",2,0],["كُلُّ ما لَم يَكُن مِنَ الصَعبِ في الأَن","فُسِ سَهلٌ فيها إِذا هُوَ كانا",6,"ن",2,0],["كُلِّمَ الخِضرُ لي فَصَيَّرَني بَع","دَكِ عَيناً عَلى عِيارِ البِلادِ",7,"د",1,0],["كُلَّما لاحَ أَو تَغَوَّرَ نَجمٌ","صَدَعَ القَلبَ ذِكرُكُم فَبَكاكِ",8,"ك",1,0],["كلُّ مالٍ تُقِلُّ عِيرُ قُريشٍ","بين عينيهِ ظاهرٌ ليس يُكْمَى",9,"م",2,0],["كلَّمَا لاَحَ لي رَأيتُ نَعِيمَا","مِن سَنَا وَجهِه ومُلكا كَبيرَا",10,"ر",2,0],["كُلَّما لاحَ لِلعُيونِ هِلالٌ","كانَ حَولاً لَدَيهِمُ في الدُهورِ",11,"ر",1,0],["كلَّما لألأ في الشرق السَّنا","دقَّتِ البابَ الأكُفُّ الناحلهْ",12,"ه",1,0],["كلما لاحَ فجرُه، استَقْبَلَتْه","أنفسٌ طُهِّرتْ من الآثام",13,"م",1,0],["كلّما لَوَّحتَ بالذكرى لهم","أوسعوا القول طلاء ودِهانا",14,"ن",2,0],["كُلَما لاحوا مَساءً","تَحسد الأَرض السَماء",15,"ا",2,0],["كلما لاحت النجوم لعي","ني بمنظومها المضيء اراكا",16,"ك",2,0],["كلما لِيمَ في الصبابة أجرى","من مصون الدموع دمعا جموما",17,"م",2,0],["كُلَّما لامَني خَبيثٌ بِعَتْبٍ","قَام لِبْسي لَه مقامَ الجَوابِ",18,"ب",1,0],["كل مالبعض يجري بالشقا","لسواه راح يجري بالحبور",19,"ر",1,0],["كل ما لم تره العين جديد","يا غريب الروح في دار الخلود",20,"د",1,0],["كُلَما لاحَ برق","من جياد شَجاها",21,"ا",3,0],["كُلَّما لاحَ بَريقٌ شاقَه","وإذا هبَّ نَسيمٌ أَطرَبَه",22,"ب",2,0],["كلما لاح بارق","فوق وادي زرود",23,"د",1,0],["كلّما لاحَ لَهُ مَرأىً نضير","صارَ يَزهو بعيونٍ من حَبب",24,"ب",1,0],["كُلَّما لاحتْ لهمْ أطلالُه","جاذَبتْ راكِبَها العِيسُ الزِّماما",25,"م",2,0],["كُلَما لَجَّ في الصُدود تَمادى ال","قلب في حُبِهِ وَجدَّ جُنوني",26,"ن",2,0],["كلَّما لاحت لها أشجارُ روضٍ","يانعاتٌ، طَوَّقَتْها بحصار",27,"ر",1,0],["كلما للصحب من مكرمة","فله السبق تراه الأوليا",28,"ي",2,0],["كلّما لامَهُ العذولُ مَرَى دمْ","عاً تُبَاِريه زَفرةٌ وعَويلُ",29,"ل",1,0],["كلَّما لاح لها برق الحمى","نَثَرت من لؤلؤ الدَّمع عقودا",30,"د",2,0],["كلَّما لاح بارق هاج وجد","وجرى مدمعٌ له واستهلاّ",31,"ل",2,0],["كلما لمت هجت مني غراما","كامنا والكلام فيه كلام",32,"م",1,0],["كلّما لزَّ إلى أقرانه","ظلَعوا غيرَ عِجافٍ واستقلّ",33,"ل",1,0],["كلما لاحظه سِيدُ المَلا","عاسِلَ الأرْماحِ للطَّعن عَسَلْ",34,"ل",1,0],["كَلَّما لاقى عُفاةً وعِدىً","سالَ كفَّاهُ نَوالاً ودَما",35,"م",2,0],["كُلَّما لاحَ وَجهُهُ بِمَكانِ","كَثُرَت زَحمَةُ العُيونِ عَلَيهِ",36,"ه",1,0],["كلم الغرام أصابني يوم النوى","بين العراق ومنهل للشارخ",37,"خ",1,0],["كلم الحجاز وحاجر جمر الذرى","ورب الدر إذ نسيمها من نافخ",37,"خ",1,0],["كلما لألأ البوارق ليلاً","قلت ليلى انجلت ولاح سناها",38,"ا",3,0],["كلُّ ما لا يَشتهِي يَلْ","قى سليمٌ من صحيحِ",39,"ح",1,0],["كُلّما لِيموا عَلى عَي","بِهمُ اِزدادوا عُيوبا",40,"ب",2,0],["كل مالي من الصفاء به","حاش لله أن أكون أنا",41,"ن",2,0],["كلما لاحت سجدت لها","حيث كلى ذاب وانمحقا",42,"ق",2,0],["كلما لمتم شربنا","كم كؤوس صافيات",43,"ت",1,0],["كلَّما لاحَ بريق نحوهم","جذبَ القلبَ هوى الربع فحنّا",44,"ن",2,0],["كلما لي لاح منه الرونقُ","خلته بدراً تجلى في الدجا",45,"ج",2,0],["كلما لاح فالنهى فيه ساع","سعي علم يقضي بما قد قضيت",46,"ت",1,0],["كل ما لاح في المثال فغير","والشهود الحقيق غير المثال",47,"ل",1,0],["كُلَّما لجّت عواذلُهُ","أجَّجت نيرانَ لوعته",48,"ت",2,0],["كلما لاح مقبلاً","زف بدراً على علم",49,"م",1,0],["كُلَّما لَفَّهُ الدُجى بِسِتار","لاحَ أَجلى مِ