{"poems":[[193,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77591","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77574","الرجز"],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[6115,"شعر النظم أحساس شاعر وفكره","https://www.poetsgate.com/ViewPoem.aspx?id=196452",""]],"verses":[["أوّل شافعٍ مشفّعٍ بنا","والرسلُ كلٌّ نفسهُ قد لَزِما",0,"م",2,0],["أَول شَيءٍ هُوَ فَضل التَجربَه","لا يوقع النَفس بِأَشراك الشبَه",1,"ه",1,0],["أَوّلُ شَخص في الخَلا رَأى الجَمَل","خافَ لقاه ثُمَ وَلّى وَرَحَل",2,"ل",1,1],["أول شيءٍ خلقه تقدما","نورُ النبي ثم بعد قسما",3,"م",2,0],["أول شطور البيت ندعيه صدره","والثاني اسمه عجز للي يسمون",4,"ن",1,0]]}