{"poems":[[55,"ولقد أقول لصاحب نبهته","https://www.aldiwan.net/poem29945.html","الكامل"],[0,"لمن الديار غشيتها بِسحام","https://www.aldiwan.net/poem64.html",""],[87,"ممات في المواكب أم حياة","https://www.aldiwan.net/poem62910.html","الوافر"],[87,"أنادي الرسم لو ملك الجوابا","https://www.aldiwan.net/poem63784.html","الوافر"],[60,"تحرز من الدنيا فإن فناءها","https://www.aldiwan.net/poem31205.html","الطويل"],[51,"ألا من لمهموم الفؤاد حزينه","https://www.aldiwan.net/poem63167.html","الطويل"],[68,"وغزال غازلته بعد بين","https://www.aldiwan.net/poem39511.html","الكامل"],[82,"صادتك مهاة لم تصد","https://www.aldiwan.net/poem31480.html","المتدارك"],[46,"دع ابن الأعمش المسكين يبكي","https://www.aldiwan.net/poem30016.html","الوافر"],[71,"رعى الله عيشا بالمعرة لي مضى","https://www.aldiwan.net/poem28441.html","الطويل"],[22,"أمن رسم دار مربع ومصيف","https://www.aldiwan.net/poem21650.html","الطويل"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[52,"بلغ المرعث في الرحيل","https://www.aldiwan.net/poem64864.html","مجزوء الكامل"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30450","الطويل"],[154,"عجبا لمن ترك الحقيقة جانبا","https://www.aldiwan.net/poem68457.html","الكامل"],[164,"أعلي ترجف بالوعيد وتوجف","https://www.aldiwan.net/poem58672.html","الكامل"],[164,"دعوني فما مما يكلفني بد","https://www.aldiwan.net/poem58839.html","الطويل"],[201,"إغتال قلبي يا له من جائر","https://www.aldiwan.net/poem39812.html","الرمل"],[215,"لم أقض منك مرادى","https://www.aldiwan.net/poem46339.html","المجتث"],[234,"إذا كنت مصطفيا مربعا","https://www.aldiwan.net/poem51269.html","المتقارب"],[242,"لعبد الله وجهت الخطابا","https://www.aldiwan.net/poem18079.html","الوافر"],[255,"فضائل خير المرسلين عظيمة","https://www.aldiwan.net/poem15073.html","الطويل"],[289,"نزل الفأر ببيتي","https://www.aldiwan.net/poem44309.html","مجزوء الرمل"],[290,"كوكب المغرب في برج الأسد","https://www.aldiwan.net/poem39346.html","الرمل"],[290,"عام جديد عاد فالبشرى به","https://www.aldiwan.net/poem39430.html","الكامل"],[370,"خليل لم أهبه من قلاه","https://www.aldiwan.net/poem44480.html","الوافر"],[371,"فعالك في العلياء أسمى وأسمح","https://www.aldiwan.net/poem17315.html","الطويل"],[412,"أخذن زمام الدمع خوف انسجامه","https://www.aldiwan.net/poem50120.html","الطويل"],[435,"وباقة زهر من أقاح منحتها","https://www.aldiwan.net/poem41431.html","الطويل"],[435,"رعى الله أوصافا بفضلك شمتها","https://www.aldiwan.net/poem41432.html","الطويل"],[466,"تتبارى أقلامه وقناه","https://www.aldiwan.net/poem16166.html","الخفيف"],[466,"وإني وإن كف الأسى غرب مقولي","https://www.aldiwan.net/poem16393.html","الطويل"],[469,"قفا في ذمام الدمع بين الملاعب","https://www.aldiwan.net/poem3188.html","عموديه"],[469,"رفقاً بها يا سائق الأظعان","https://www.aldiwan.net/poem3197.html","عموديه"],[505,"أطلق الصب في الهوى تقييده","https://www.aldiwan.net/poem37687.html","الخفيف"],[505,"تلألأ في الأكوان نور محيانا","https://www.aldiwan.net/poem37752.html","الطويل"],[510,"البديل","https://www.aldiwan.net/poem56766.html","مخلع البسيط"],[556,"أدر أيها الساقي الكؤوس على صحبي","https://www.aldiwan.net/poem48063.html","الطويل"],[567,"أتدري ما بقلبك من جراح","https://www.aldiwan.net/poem52911.html","الوافر"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138273",""],[580,"","https://poetry.dctabudhabi.ae/diwan/poem/47713","الخفيف"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146225","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38927","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37992","الوافر"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77550","الرجز"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59781","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62581","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136169","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136122","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136235","الخفيف"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/78010","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77751","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108579","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108822","الوافر"],[1837,"","https://poetry.dctabudhabi.ae/diwan/poem/143884","الكامل"],[1965,"","https://poetry.dctabudhabi.ae/diwan/poem/102726","المتدارك"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46485","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110314","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53191","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77365","الطويل"],[2272,"","https://poetry.dctabudhabi.ae/diwan/poem/131433","الخفيف"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121224","البسيط"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75962","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94320","الرجز"],[2823,"","https://poetry.dctabudhabi.ae/diwan/poem/146724","البسيط"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146339","الكامل"],[2875,"","https://poetry.dctabudhabi.ae/diwan/poem/124045","الخفيف"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109799","الكامل"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132605","المتقارب"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68017","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68005","البسيط"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112382","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89048","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89186","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52981","الكامل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61261","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66420","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92434","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91190","الطويل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36760","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36771","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133298","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135384","الكامل"],[3914,"","https://poetry.dctabudhabi.ae/diwan/poem/116880","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111450","الخفيف"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69989","الوافر"],[4163,"","https://poetry.dctabudhabi.ae/diwan/poem/106736","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91046","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83162","المتقارب"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104532","الطويل"],[4469,"","https://poetry.dctabudhabi.ae/diwan/poem/103138","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141685","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120200","الكامل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4691,"سجال الإجازة زياد بنجر وظميان غدير","https://www.poetsgate.com/ViewPoem.aspx?id=110553",""],[4858,"الأم","https://www.poetsgate.com/ViewPoem.aspx?id=30460",""],[5054,"‏ثورة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=213745",""],[5186,"جحدوا فضل بني العرب جحودا","https://www.poetsgate.com/ViewPoem.aspx?id=156479",""],[5200,"لعمرى لئن سرّ الحيا فى مواطن","https://www.poetsgate.com/ViewPoem.aspx?id=200813",""],[5277,"صفعةُ القرن","https://www.poetsgate.com/ViewPoem.aspx?id=204495",""],[592,"سفاسط أملاها الغبي وسطرا","https://www.poetsgate.com/ViewPoem.aspx?id=128722",""],[5363,"يا حبيب التائبينا","https://www.poetsgate.com/ViewPoem.aspx?id=144497",""],[5485,"اليك اعتذارى من مديحك تائبا","https://www.poetsgate.com/ViewPoem.aspx?id=200789",""],[5544,"موطني","https://www.poetsgate.com/ViewPoem.aspx?id=213413",""]],"verses":[["فَصِفِ الغَرامَ لِمُفرِقٍ مِن دائِهِ","إِنّي لَأَقدَمُ مِنكَ في العُشّاقِ",0,"ق",1,0],["فَصَفا الأَطيطِ فَصاحَتَينِ فَغاضِرٍ","تَمشي النِعاجُ بِها مَعَ الآرامِ",1,"م",1,0],["فَصَفحاً في التُرابِ إِذا اِلتَقَينا","وَلو شِيَتِ العَداوَةُ وَالتَراتُ",2,"ت",1,0],["فَصَفحاً لِلزَمانِ لِصُبحِ يَومٍ","بِهِ أَضحى الزَمانُ إِلَيَّ ثابا",3,"ب",2,0],["فَصَفوَتُها مَمزوجَةٌ بِكُدورَةٍ","وَراحَتُها مَقرونَةٌ بِعَناءِ",4,"ا",2,0],["فَصَفَّ الخَدينَ ما استَطَعتَ مِنَ القَذى","أَلا إِنَّما كُلُّ امرِئٍ بِخَدينِهِ",5,"ن",2,0],["فَصَفَفنا الجَيشَينِ تُركاً وَزَنجاً","وَاِعتَبَرنا تَقابُلَ العَسكَرَينِ",6,"ن",1,0],["فصفيرُ البلبلِ مُطّرَحٌ","في الأيْكِ له صوتُ الصُّرَدِ",7,"د",1,0],["فَصُفرَةُ وَجهِهِ مِن غَيرِ سُقمٍ","تَنِمُّ عَنِ الشَقِيِّ بِما يُلاقي",8,"ق",2,0],["فصفْ لي عيوناً بالمنابعِ فُيَّضا","أريكَ عيوناً بالمدامعِ فُيَّضا",9,"ض",2,0],["فَصُفّوا وَماذِيُّ الحَديدِ عَلَيهِمُ","وَبَيضٌ كَأَولادِ النَعامِ كَثيفُ",10,"ف",1,0],["فصِفِ الليلةَ التي كان للمُخ","تارِ فيها على البُراقِ استواءُ",11,"ا",2,0],["فَصَفَحتُ عَنهُ لَعَلَّهُ","فيما أُريدُ يَذِلُّ صَعبُه",12,"ب",2,0],["فصفحَ الإمامُ عن جنايتِهْ","وقَبِلَ المبذولَ من إنابتِهْ",13,"ه",1,0],["فَصفَّق مِن ريِش الجنَاحيْنِ واقِعاً","على القُرْبِ حتَّى ما علَيْهِ مزِيدُ",14,"د",1,0],["فصفا الدليل فما نفعت بصفوه","حتى جعلت له التحير شائبا",15,"ب",2,0],["فصفحت عنك ولست أول جاحد","فضلا بكفران الصنيعة توصف",16,"ف",1,0],["فصفه لوصف غير ما توصف الورى","فما جامع ما بين يحي وهم حد",17,"د",1,0],["فصفا لي يا خليليّ الدوا","وأرى الحيلة أن لا تصفا",18,"ف",2,0],["فصف لظلام قلبي","مدامعي ونحولي",19,"ل",2,0],["فَصفْحَك عن زَلّتي مُنْعِماً","وعَفْوَك عن نَبْوَتي والتوائي",20,"ا",2,0],["فَصَفْحاً سَيِّدِي فَالصَّفْحُ أَوْلَى","بِمَنْصِبِكَ الذِي خَفَضَ النِّصابَا",21,"ب",2,0],["فصفهُ وبالغ في مناقبه بما","أردت وأدرى أنّ وصفَك يضعُفُ",22,"ف",1,0],["فصَفقَةٌ أَبصَرَت مِنها","في سَوادِ العَينِ زُرقَه",23,"ق",2,0],["فصفا الأنس وطاب الالتقا","مذ غدا مركزنا قطب البلد",24,"د",1,0],["فصفا الزمان لنا وسهل سيرنا","في موجبات البر والرأي السديد",25,"د",1,0],["فَصَفحِ حَبونَنٍ فَخَليفِ صُبحٍ","فَنَحلَ إِلى رَنينَ إِلى بَشَامِ",26,"م",1,0],["فَصَفقَةُ وُدّي إِن شَرَيتَ صَفاءَها","فَإِنَّكَ فيهِ لاَمَحالَةَ تَربَحُ",27,"ح",1,0],["فَصفحاً فَما زالَ الزَمان كَما تَرى","أَكارِمه مَرميَّة بِلئامِهِ",28,"م",2,0],["فصفر وجوه ثم زرق كخطبهم","وتبسم ثغرا مثل سار بظله",29,"ل",2,0],["فصفر وجوه ثمّ زرق كخطبهم","وحمرٌ كدمّ فاض من حدّ نصله",30,"ه",1,0],["فصُفوفُ الجيوش مثْلُ سُطورِ","الخَطِّ كَرارَةٌ على الأبْطالِ",31,"ل",1,0],["فصَفْحٌ يَغولُ الجُرْمَ والجُرمُ فاحشٌ","وبأسٌ يَفِلُّ الجيشَ والجيشُ رائِعُ",32,"ع",1,0],["فصفحهم عيش الصديقِ مسالماً","وحدّهم حتفُ العدوّ المحارب",33,"ب",1,0],["فصفوا لعينيَّ المنامَ وطيبهُ","أو حدِّثوا سمعي عن السُّلوان",34,"ن",1,0],["فصفاتٌ حميدةٌ رقرقتها","هارقاتٌ من النبي مجيده",35,"د",2,0],["فصُفَّ صُفوفَ العاشقينَ ببابِنا","وخذْ لك في تلك المَحاضِرِ ميدَانَا",36,"ن",2,0],["فصِفْ لنا باليقينِ ما أنْ","ستْكَ معالمَهُ الغيوبُ",37,"ب",1,0],["فَصفْوُكَ لا يُبلى بِشيءٍ منَ القذى","وخِصْبكَ لا يُمنى بشيءٍ من الجَدْبِ",38,"ب",1,0],["فصفَّقَتِ الغُصونُ لهُ ابتِهاجاً","وأصبَحَ باسماً ثَغرُ الأقاحي",39,"ح",2,0],["فصفوك يا كريم لهم صفاء","وعيدك عيدهم فيه الحبور",40,"ر",1,0],["فصَفا عنده العَدُوُّ المُدَاجي","وَوَفى عنده الزَّمانُ الخَئُونُ",41,"ن",1,0],["فصفت على الحبل في محضر","يلي أمره ثقة مسلم",42,"م",1,0],["فَصِفها بِأَسنى الحُسنِ في وَصفِ حسنِها","وَهَيهات ذاكَ الحُسن يُحصيهِ واصِفُ",43,"ف",1,0],["فَصفوَاً إِنّك الأَحرى بِصَفحٍ","وَغَيظُ المُؤمِنِ المَحمودِ بَرْقُ",44,"ق",1,0],["فَصَفَّق الجُلّاس لِلحِكايَه","وَأَظهَروا فَرَحاً بِلا نِهايه",45,"ه",1,0],["فصفاحُنا لتورد وجيادنا","لتسابق ورماحنا لتأود",46,"د",1,0],["فصفاته كالروض باكره الحَيا","وهباته كالعارض الهتّان",47,"ن",1,0],["فصف ان عرفت الأمر وصف تعلق","يفيد اخا الوجدان سر التواجد",48,"د",1,0],["فصفها لسمعي إن سمعي بوصفها","يزيد بذاك الوصف من حسنه عجبا",49,"ب",2,0],["فصف القلب في مجاريه بالوصف ا","لذي زال منه مظلم رجسه",50,"س",2,0],["فصفا به ثوب الزمان","وكان طمرا أغبرا",51,"ر",2,0],["فصفها أَنَّها شمس","حروف الوصف تعياها",52,"ا",3,0],["فصفاته كالبحر يدرك بعضها","والبعض منها يغرق السباحا",53,"ح",2,0],["فصف شوقي لها ونح