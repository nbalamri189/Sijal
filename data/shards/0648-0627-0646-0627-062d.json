{"poems":[[55,"تواعد ذا الخليط لأن يبينا","https://www.aldiwan.net/poem29647.html","الوافر"],[55,"ألا مخبر فيما يقول جلية","https://www.aldiwan.net/poem29654.html","الطويل"],[57,"كتاب حبيب جاءني بعد جفوة","https://www.aldiwan.net/poem26141.html","الطويل"],[79,"إذا أنا لم أوثر هواي على عزمي","https://www.aldiwan.net/poem36126.html","الطويل"],[79,"لما رأت راية القيسي زاحفة","https://www.aldiwan.net/poem36344.html","البسيط"],[79,"قفا فاسألا في ساحة الأجرع الفرد","https://www.aldiwan.net/poem36602.html","الطويل"],[44,"كساني ولم استكسه فحمدته","https://www.aldiwan.net/poem50339.html","الكامل"],[95,"إلى مصر أزف عن الشآم","https://www.aldiwan.net/poem11411.html","الوافر"],[23,"أبوك أبو سوء وخالك مثله","https://www.aldiwan.net/poem21603.html","الطويل"],[91,"لبيك من آمر يا خير من عزما","https://www.aldiwan.net/poem44739.html","البسيط"],[47,"بعينيك إعوالي وطول شهيقي","https://www.aldiwan.net/poem65197.html","الطويل"],[63,"محلك مثل الغاب ليس يرام","https://www.aldiwan.net/poem51457.html","الطويل"],[68,"وفى لي فيك الدمع إذ خانني الصبر","https://www.aldiwan.net/poem40123.html","الطويل"],[99,"ما حيلتي يا هند وجهك لاح لي","https://www.aldiwan.net/poem24862.html","الكامل"],[99,"يا فؤادي رحم الله الهوى","https://www.aldiwan.net/poem25088.html","الرمل"],[82,"يا ذنوبي ثقلت والله ظهري","https://www.aldiwan.net/poem31425.html","الخفيف"],[54,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[50,"ألا قوموا إلى الكرخ","https://www.aldiwan.net/poem63331.html","الهزج"],[48,"فعلت فعل تجار مخسرين به","https://www.aldiwan.net/poem22667.html","البسيط"],[1,"ولا أغير على الأشعار أسرقها","https://www.aldiwan.net/poem34006.html","البسيط"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30490","البسيط"],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/10950","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42552","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54972","الطويل"],[76,"خليلي هَل من وَقْفَة بتألم","https://www.poetsgate.com/ViewPoem.aspx?id=189651",""],[79,"دعاها تشم آثار نجد ففي نجد","https://www.poetsgate.com/ViewPoem.aspx?id=33821",""],[132,"أحب أهل العقول من الرعايا","https://www.aldiwan.net/poem50576.html","الوافر"],[147,"ليهنك ما شادت لك الهمم العلا","https://www.aldiwan.net/poem11807.html","الطويل"],[178,"كري الملام فباغي اللوم مخصوم","https://www.aldiwan.net/poem46024.html","البسيط"],[193,"هواي طيبة لا بيضاء عطبول","https://www.aldiwan.net/poem35275.html","البسيط"],[242,"صبا نجد ألا هبي علينا","https://www.aldiwan.net/poem19274.html","الوافر"],[303,"تسر الناظرين فراشتان","https://www.aldiwan.net/poem36854.html","عموديه"],[369,"أيا أهدى من الشهب السواري","https://www.aldiwan.net/poem60892.html","السريع"],[385,"أضر بمقلتي السهر الطويل","https://www.aldiwan.net/poem48829.html","الوافر"],[409,"أترى يعود من الحمى قلبي","https://www.aldiwan.net/poem34152.html","الكامل"],[422,"تحلف بالبيت وهي صادقة","https://www.aldiwan.net/poem53820.html","المنسرح"],[422,"نعم ما لهذا الأمر غيرك صالح","https://www.aldiwan.net/poem54137.html","الطويل"],[445,"بحكم العدل من قاضي السماء","https://www.aldiwan.net/poem34836.html","الوافر"],[445,"تتبين شمل الدين أنك ناظمه","https://www.aldiwan.net/poem34869.html","الطويل"],[445,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[458,"إن نالني السقم لم يبلغ بي الجزع","https://www.aldiwan.net/poem61292.html","البسيط"],[463,"أما لنجوم ليلك بالمصلى","https://www.aldiwan.net/poem56087.html","الوافر"],[463,"لعمر الواشيات بأم عمرو","https://www.aldiwan.net/poem56176.html","الوافر"],[463,"نعم هذه يا دهر أم المصائب","https://www.aldiwan.net/poem56291.html","الطويل"],[466,"منازلكم للخائفين عصام","https://www.aldiwan.net/poem16033.html","الطويل"],[505,"رأيت رسول الله سبعين مرة","https://www.aldiwan.net/poem37969.html","الطويل"],[563,"أنا كل الوجود والكائنات","https://www.aldiwan.net/poem34732.html","الخفيف"],[580,"سلام عليه لا على الدهر بعده","https://www.aldiwan.net/poem3075.html","الطويل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101475","الوافر"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54172","الطويل"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44618","الوافر"],[790,"","https://poetry.dctabudhabi.ae/diwan/poem/142576","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48851","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37724","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59423","البسيط"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130631","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50035","البسيط"],[1891,"","https://poetry.dctabudhabi.ae/diwan/poem/27044","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109458","البسيط"],[2291,"","https://poetry.dctabudhabi.ae/diwan/poem/114981","الطويل"],[2382,"","https://poetry.dctabudhabi.ae/diwan/poem/101805","البسيط"],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131727",""],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/198644","البسيط"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107174","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130784",""],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65948","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65939","الطويل"],[2909,"","https://poetry.dctabudhabi.ae/diwan/poem/96433","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199955","الخفيف"],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76548","الطويل"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/132973","المجتث"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138591",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131210",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131106",""],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86360","الوافر"],[4193,"","https://poetry.dctabudhabi.ae/diwan/poem/131373","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94522","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57987","البسيط"],[4869,"قسايم المحبه","https://www.poetsgate.com/ViewPoem.aspx?id=151537",""],[4916,"ياسنين","https://www.poetsgate.com/ViewPoem.aspx?id=135641",""],[4927,"ما هذه البنت","https://www.poetsgate.com/ViewPoem.aspx?id=29609",""],[5074,"الغائب الحاضر","https://www.poetsgate.com/ViewPoem.aspx?id=153717",""],[5213,"حتام يا دهر قد أعيت بك الحيل","https://www.poetsgate.com/ViewPoem.aspx?id=170518",""],[5277,"من أوراق حمامة بغدادية","https://www.poetsgate.com/ViewPoem.aspx?id=185800",""],[5277,"أريدكَ مثلَ رابعة","https://www.poetsgate.com/ViewPoem.aspx?id=208530",""],[5582,"أَبَى اللهُ إِلاّ أَنْ أَرَى الحَقَّ غالِبا","https://www.poetsgate.com/ViewPoem.aspx?id=186674",""],[5616,"قدر","https://www.poetsgate.com/ViewPoem.aspx?id=205239",""],[5616,"مهر شموس","https://www.poetsgate.com/ViewPoem.aspx?id=207462",""],[5674,"أمواجي لجرفك هادرة","https://www.poetsgate.com/ViewPoem.aspx?id=189089",""],[178,"كرّى الملام فباغى اللّوم مخصوم","https://www.poetsgate.com/ViewPoem.aspx?id=201001",""],[5829,"بلسم الروح","https://www.poetsgate.com/ViewPoem.aspx?id=180642",""],[5848,"طفلة نجديه","https://www.poetsgate.com/ViewPoem.aspx?id=53355",""],[5848,"سيجارة فوق طفايه","https://www.poetsgate.com/ViewPoem.aspx?id=48904",""],[5956,"لحل المشكلات","https://www.poetsgate.com/ViewPoem.aspx?id=194892",""],[6359,"المجلس الطاريء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69093&r=&rc=7",""]],"verses":[["وَإِن أَحَقَّ مِنكَ بِأَن يُهَنّى","إِذا مَدَّ البَقاءَ لَكَ السِنونا",0,"ن",2,0],["وَإِنَّ أَحَقَّ المُجهِشينَ لِعَبرَةٍ","وَوَجدٍ قَرينٌ بانَ عَنهُ قَرينُ",1,"ن",1,0],["وَإِنَّ أَحَقَّ الناسِ أَن يَكثُرَ البُكا","عَلَيهِ قَتيلٌ لَيسَ يُعرَفُ قاتِلُه",2,"ل",2,0],["وَإِنَّ أَحَقُّ الْنَّاسِ بِاللَّوْمِ لامْرُؤ","يَضِلُّ طَريقَ الرُّشْدِ وَهُوَ عَلَى عِلْمِ",3,"م",1,0],["وَإِنَّ أَحْسَنَ مِنْ هَذَا وَذَا وَزَرٌ","بِمِثْلِهِ فِي الدَّوَاهِي يُبْلَغُ الأَمَلُ",4,"ل",1,0],["وإنّ أحَقَّ الغيْثِ أنْ يَرْوِيَ الثّرَى","لَغَيْثٌ زكيٌّ صابَ منْ مَنْشإِ المجْدِ",5,"د",1,0],["وَأَنَّ أَحَقَّ الناسِ إِن كُنتَ حامِداً","بِحَمدِكَ مَن أَعطاكَ وَالوَجهُ وافِرُ",6,"ر",1,0],["وَأَنَا حَيْثُ فَاتَحَنَا كَذُوبٌ","بِمِيعَادٍ فَطِنَّا لِلْخِتَامِ",7,"م",1,0],["وَإِنَّ أَحَقَّ الناسِ أَن لا تَلومَهُ","عَلى اللُؤمِ مَن أَلفى أَباهُ كَذَلِكا",8,"ك",2,0],["وان احمد بحر في معارفه","فليغترف منه من قد كان يغترف",9,"ف",1,0],["وَإِنَّ أَحَقَّ الناسَ مِنّي بِخُلَّةٍ","عَدُوُّ عَدُوّي أَو صَديقُ صَديقي",10,"ق",2,0],["وإنْ أُحفِظَت منكم أُسودُ حَفائظٍ","فردُّوا القنا والبِيضَ وهيَ حُطامُ",11,"م",1,0],["وَإِن أَحدَثَت بِالناصِرِ المَلكِ زَلَّةً","فَبِالمَلِكِ المَنصورِ قامَ لَها العُذرُ",12,"ر",1,0],["وأنا حزينٌ ظامئٌ قد جدَّ لي","ورِدٌ وراء مَعِينه شفتان",13,"ن",1,0],["وأنا حب وقلب ودم","وفراش حائر منك دنا",14,"ن",2,0],["وأنا حيثُ سرْتُ آكلُ رزقي","غير أنّ الزمانَ يأكل عمري",15,"ر",2,0],["وَإِن أَحَسَّ مِن نَديمٍ صَوتا","قالَ مُجيباً طَعنَةً وَمَوتا",16,"ت",2,0],["وَإِن أَحبَبتُمُ وَصلاً","فَهَذي رَبَّةُ الدارِ",17,"ر",1,0],["وَإِنَّ أَحسَنَ مِن تَعظيمِهِم رَجُلاً","صِفراً مِنَ الحِكَمِ التَعظيمُ لِلحَجَرِ",18,"ر",1,0],["وَإِنَّ أَحسَنَ بَيتٍ أَنتَ قائِلُهُ","بَيتٌ يُقالُ إِذا أَنشَدتَهُ صَدَقا",19,"ق",2,0],["وإِنْ أَحَبَّ الثَّرَى جِسْماً ليَأكُلَه","أَسْمَحْ بجِسْمِي له يَفْدِيكَ تَعْظِيمِي",20,"م",2,0],["وَإِنَّ أَحَقَّ الناسِ مِنّي تَحيَّةً","وَشَوقاً لَهُ مَن لَو يَشاءُ شَقاني",21,"ن",2,0],["وإِنَّ أَحَقَّ الأَرْضِ بِالشُّكْرِ مَنْزِلٌ","يَكونُ بِهِ لِلْمَرْءِ خِلٌّ مُنَاصِحُ",22,"ح",1,0],["وَإِنَّ أَحَادِيثَ الصِّنَاعَةِ إِنْ يَجِدْ","بِهَا وَحْشةً قَوْمٌ لأَبْهَجُ مُؤْنِسِ",23,"س",1,0],["وَأَنا حيينا أوردينا لاخوة","فَمن مر بِي من مسلمك فليسلم",24,"م",1,0],["وإن أحق الغيث أن يحيي الربا","ويروي غمام صاب من منشىء المجد",25,"د",1,0],["وإن أحدٌ غضبتَ عليه فاغفرْ","له زلاتهِ تكنِ المُطِيعَا",26,"ع",2,0],["وَإِن أَحكَما الأَيّامَ زالَ جِماحُها","وَإِن حَكَما أَمّا الكِتابِ المُنَزَّلا",27,"ل",2,0],["وَإنْ أَحُلُّكِ لا آسى عَلَى بَلَدٍ","وَحَبْلُهُ مِنْ حِبالِي فِيكِ مَصْرُومُ",28,"م",1,0],["وَأَنّ أحمدَ خيرُ الرسلِ رحمتهُ","لِلعالمينَ ففيها الكلُّ مشمولُ",29,"ل",1,0],["وَأَنَّا حَيْثُمَا تُقْنَا إِلَيْهِمْ","نَرَاهُمْ بِالْبَصَائِرِ فِي يَدَيْنَا",30,"ن",2,0],["وإِن إِحداهما انطلقتْ فجدَّتْ","بمتنِ الريح مطلقةَ العنان",31,"ن",1,0],["وإن أَحبَبْتَ أن تَقْضِيه فاعْجَلْ","فما بعدَ العَشيّةِ من عَرار",32,"ر",1,0],["وَإِن أَحمى هَجير الهَم خَطب","فَجانَبهُ لَنا ظلٌّ ظَليل",33,"ل",1,0],["وأنا حليف ضنى يؤرقني","ذكراهم وأغص بالشرب",34,"ب",1,0],["وأنَّ أحشاءها قد اتّقَدَتْ","تحتَ الضلوع كواقد الجمر",35,"ر",1,0],["وإنْ أحجمَ المقدامُ عن طلب العُلى","فإنَّك مقدامٌ إليها وجامح",36,"ح",1,0],["وإِنَّ أَحَبَّ مَا تَقْضِي إِلَيْهِ","لِمَنْ آواهُمُ حُكْمُ الحِباءِ",37,"ا",2,0],["وإِنْ أَحْرَزُوا فِي قُطْرِ شَنْجٍ نُفُوسَهُمْ","فغانِمُ مَا لا يَحْفَظُ اللهُ غارِمُهْ",38,"م",2,0],["وإِنْ أُحْيِ نفسي فِيهِ من مِيتَةِ الهَوى","بلَثْمِي لَهُ لَمْ أَعْدُ أَنِّيَ آثِمُ",39,"م",1,0],["وأن أحكم سيفا في اصاغرها","الهادميها بما بثوا وما جمعوا",40,"ع",3,0],["وإنّ أحقّ من ردّ العواري","فتىً أخذ الذي لا يستحِقُّ",41,"ق",1,0],["وإنَّ أحبَّتي لبنو زماني","كلا العودين من سِنْخٍ ونَجْرِ",42,"ر",1,0],["وإن أُحرمْ قضاءَ العدل أرجِعْ","إلى كُفئين من هَجرٍ وصبرِ",42,"ر",1,0],["وإن أحدثَتْ عندي يدُ الدهرِ نِعمةً","ذكرتُك فيها فاغتدتْ من مَصائبي",43,"ب",2,0],["واِن أحجم الشُّمْس الغطاريف أقدموا","واِنْ طُوي الثَّغر المخوفُ أقاموا",44,"م",3,0],["وأن أُحكِمَ التَّنزيهَ للهِ خالِصاً","عن الفوقِ والتَّحتِ المُمَهَّدِ والشَّفْعِ",45,"ع",1,0],["وأنا حافظ قضية حكمي","والحدود التي بهن نجاتي",46,"ت",2,0],["وإِنَّ أَحَقَّ الناسِ أَنْ يرِثَ العُلا","فتى وارِثٌ منه أَبَاه وجدَّه",47,"د",2,0],["وان احي بأَرضٍ عُدَّ فيها","رجال الفضل من أهل الشقاءِ",48,"ا",2,0],["وإن أحرقوا حانوتَ مثلي تعدياً","فلم يحرقوا منه سوى طيب منزلِ",49,"ل",1,0],["وَإِن أَحبَبتَ مُسمِعَةً أَتَتنا","مُحَذَّفَةً بِأَصنافِ الأَغاني",50,"ن",2,0],["وإن أحلامنا في الشط غافية","وفي الحنايا لهيب الشوق يستعر",51,"ر",1,0],["وأنّا حماة العرش والعرش خالد","نقدسه تقديس مصر ونفديه",52,"ي",2,0],["وإنْ أحْرَقَتْ قَلبي بهُجْرانِها فَلا","وَكَلْتُ بلَيْلى مَنْ يَهيمُ بِها بَعْدي",53,"ي",1,0],["وإن أحاطت به الأبطال يحطمها","كأنه النار لما تحطم السقفا",54,"ف",2,0],["وان احمد ما في الناس احمدها","مجدا ألا كل مجد دونه عدم",55,"م",1,0],["وإن أَحسن شيء أَن أَرى وَرَعاً","من ناشىء واجدٍ في اللهو إمكانا",56,"ن",2,0],["وَإِنَّ أَحَقَّ الناسِ أَلّا أَهابُهُ","عَتودٌ يُباريهِ فَريرُ وَثَعلَبُ",57,"ب",1,1],["وإن أحسن ما يبغيه ذو وطرٍ","حليلةٌ ذات أخلاقٍ تناسبه",58,"ب",2,0],["وأنّ أحقّ الناس باللوم شاعرٌ","يلومُ على البخلِ الرجال ويبخلُ",59,"ل",1,0],["وإن احرف مدحي فيك مهملة","ما لم أصير لها شهب السما نقطا",60,"ط",2,0],["وانا حمدين اذا به رزق واجد","اكيرم في رضاك كيرام بنقده",61,"د",2,0],["وإنّ أحمد في الدنيا وإن عظمت","لواحد مُفْرَد في عالم أمَم",62,"م",1,0],["وَإِنَّا حَمِدنا اللَّه ثُمَّ إِمامنا","مَنارَ الهُدى عبدَ الحَميدِ يَدَ الباري",63,"ر",2,0],["وان احمقهم من كان ابغصهم","للانتقاد وطبع الكبر اقصاهُ",64,"ا",2,0],["وإن أحدقت للشعر يوماً كتيبة","وأشدوا جميع الشعر أزرت بما أشدوا",65,"د",3,0],["وإن أحدرت في هام كبر ونخوة","تحدر عنها كل كبر ونخوة",66,"ه",1,0],["وإن أحقَّ الناسِ بالجُودِ من رأى","أباهُ جواداً للمكارمِ يُجزِلُ",67,"ل",1,0],["وأنا حائر كحيره عقلي","فلك السعد مطلقا من حجاكا",68,"ك",2,0],["وَأنّ أَحاديث العُذَيب لِمسمَعي","أَلَذُّ مِن العَذبِ الزُلالِ لِظَمآنِ",69,"ن",1,0],["وإنَّ أحسَنَ منه","بالمرءِ أن يَتَكَفَّف",70,"ف",1,0],["وان احاديث الهداة بفضلها","على قدر السؤال ليس المقدرا",71,"ر",2,0],["وإن أحجم العالي عن الشر أقدمت","ولكن متى يقدم على الخير تحجم",72,"م",1,0],["وأنا حكمت لدن علمت بأمره","شرعا برد القلب حكم نزيه",73,"ي",2,0],["وإن أحزن لشحط من نواها","فبالمهدي مقتبل سروري",74,"ر",2,0],["وانا حين تشتجر العوالي","حماة الجرب والاسد الغضاب",75,"ب",1,0],["وأنا حُرمتُ من الحَبيب وانسهِ","حتى المنازِل والرُبوع مع الرُبا",76,"ب",2,0],["وأن أحمد منه مرسل ولقد","وافى بنور له كل الدلالات",77,"ت",1,0],["وان احمد الله حظي اليوم قايم","والقلب ياسعده سكن في نديمه",78,"م",2,0],["وانا حبيبي ما تأنّى عشاني","ولاهو محاسبني على فراق وصدود",79,"د",1,0],["وَأَنَاْ حَيٌّ وَلَكِنْ","مَقْتَلِيْ فِيْ شَفَتَيْهَاْ",80,"ي",3,0],["وَ أنا حائرٌ نهاريَ ليلٌ","وَ ليالِيْ المعذَّبينَ ضُرُوْبُ",81,"ب",1,0],["وان أحسن ما في المرء فعلته","في الدهر ما فعلت آباؤه الاول",82,"ل",1,0],["وانا حمامةُ عاشقٍ","تبكي نوىً في كلِّ داثرْ",83,"ر",1,0],["وأن احببتُ انثى لست أرضى","شريكا لي بهاتيكِ الحنايا",84,"ا",3,0],["وَأَنْ أَحْفَظَ المِيثاقَ وَالعَهْدَ كُلَّما","عَقَدْتُ بِهِ ما دُمْتُ لِلْعَيْشِ صاحِبا",85,"ب",2,0],["وانا. حائر. ودربي. مخوف","كم. اعاني. كي. اضبط. الايقاعا",86,"ع",2,0],["وانا حارس البراءة في الشعر","فشعر غض وشعر ٠٠٠يبيس",87,"س",1,0],["وأنا حروفي مثل حبات الندى","لمست خدود الورد غير مهاجره",88,"ر",2,0],["وإن أحلّك لا آسى على بلد","وحبله من جالى فيك مصروم",89,"م",1,0],["وأنا حبيس في العناية مجهدٌ","والناس تُغرق لجة الردهاتِ",90,"ت",1,0],["وانا حبيبك وابقهر كل عذالي","لا شافوا ان القمر يختال فيديه",91,"د",3,0],["وانا حبيبك إلين تجين","يا سكر احساسي ومايه",92,"ا",3,0],["وانا حبيبك إلين يبين","شيب الأحاسيس جوايه",92,"ا",3,0],["وإن أحْسَسْتُ عُقْماً في بذوري","فلستُ بزارعٍ أبداً بذوري",93,"ر",2,0],["وإنِ احتاجوا لخبثٍ مسرحاً","فاركعي عند صعودِ السفلة",94,"ل",2,0]]}