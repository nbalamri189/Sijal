{"poems":[[39,"كالناطقات الصادقات","https://www.aldiwan.net/poem7177.html","مجزوء الكامل"],[74,"تحلو الثغور بذكرك المتردد","https://www.aldiwan.net/poem18546.html","الكامل"],[74,"أقوادتي إني فرغت عن النسا","https://www.aldiwan.net/poem19642.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54882","الكامل"],[139,"إن فؤادا آية في الحفظ","https://www.aldiwan.net/poem49102.html","الرجز"],[182,"جرحك في كفك","https://www.aldiwan.net/poem50701.html","الوافر"],[325,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[369,"غير العدا بسيوفكن قتيل","https://www.aldiwan.net/poem60807.html","الكامل"],[408,"برح الشوق فواصل","https://www.aldiwan.net/poem46726.html","مجزوء الرمل"],[409,"فقلت حسبكما لله دركما","https://www.aldiwan.net/poem33440.html","البسيط"],[422,"سلمه الرب من الأسواء","https://www.aldiwan.net/poem53860.html","الرجز"],[435,"خود من الترك قد صالت على العرب","https://www.aldiwan.net/poem40050.html","البسيط"],[466,"أقوال له والزهو ينغض عطفه","https://www.aldiwan.net/poem15933.html","الطويل"],[520,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[567,"قف بالمطايا على أنجاد ذي سلم","https://www.aldiwan.net/poem52785.html","البسيط"],[567,"لولا التفاوت في الأخلاق والأدب","https://www.aldiwan.net/poem52810.html","البسيط"],[567,"إن كان يلبس ما أفاد تجملا","https://www.aldiwan.net/poem52963.html","الكامل"],[567,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56351","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84477","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77976","البسيط"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127979","البسيط"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48197","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27840","المنسرح"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109400","السريع"],[591,"","https://poetry.dctabudhabi.ae/diwan/poem/25588","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83225","الكامل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140089",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91945","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91272","السريع"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86574","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69982","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125822","الكامل"],[4692,"لغز3","https://www.poetsgate.com/ViewPoem.aspx?id=213013",""],[4702,"مشوار عز","https://www.poetsgate.com/ViewPoem.aspx?id=155169",""],[4767,"صفقة خاسر","https://www.poetsgate.com/ViewPoem.aspx?id=211955",""],[4859,"بعض الأنام!","https://www.poetsgate.com/ViewPoem.aspx?id=204881",""],[4929,"ترجمة ضوئية لألوان الطيف","https://www.poetsgate.com/ViewPoem.aspx?id=199204",""],[5092,"اغضب","https://www.poetsgate.com/ViewPoem.aspx?id=178241",""],[3591,"هي الحسان أراقت مهجة البطل","https://www.poetsgate.com/ViewPoem.aspx?id=149410",""],[5956,"أخَّرْتُ في أغلى الصحاب قصائدي","https://www.poetsgate.com/ViewPoem.aspx?id=214991",""]],"verses":[["أقوات ناظرة الفوا","ئد غير رائشة الموائرْ",0,"ر",1,0],["أقواله للمجتني ونكاله","للمجتري ونواله للمجتدي",1,"د",2,0],["أقوَّادتي إني فرغت عن النسا","وأضحى على ميل العلوق معوَّلي",2,"ي",1,1],["أَقْوَاتُ هَاتِيكَ المِئَاتِ كَفَلتَهَا","بِسَمَاحِ مِعْطَاءٍ وَقَصْدِ مُدبرِ",3,"ر",1,0],["أقوالهُ لم تخلُ من إعجازِ","لكنهُ أفرط في الإيجازِ",4,"ز",1,0],["أقْوالُنا دَجَلٌ عَلاهُ رِياءُ","وفِعالُنا مَهْزولةٌ عَجْفاءُ",5,"ا",2,1],["أَقوالُهُ دُرَرُ أَعمالِهِ غُرَرُ","كَم نَسَقَت سوراً مِنها بَديهَتُهُ",6,"ت",2,0],["أَقْوالُه نَعَمٌ وأيْسَرُ بَذْله","سَرَفٌ وجُلُّ عقابِه تَحْليل",7,"ل",1,0],["أَقوامٌ ذاكَ أم غُصْنُ نقاً","في الدَّوحِ مائِلْ",8,"ل",1,0],["أقواتها قدرت فيها على قدر","وفق الطباع على ما حرر القلم",9,"م",1,0],["أقوالُه في المجد أو أفعاله","يَقصرُ عن أمثالها أمثاله",10,"ه",1,0],["أقواله أصبحت فعالةً فاتت","متونهنَّ جلاء الشك والريب",11,"ب",1,0],["أقوالُ له والزهو يُنغضُ عِطْفه","وزينَتُه مَعْسولة وشَمائُلهْ",12,"ل",2,1],["أقوال وقول الحق فرض على الفتى","إذا شهدت بالصدق يوماً دلائله",13,"ل",2,0],["أقوالهُ دُرَرٌ تُبنَى بها سُوَرٌ","ألقى بها قمرٌ في النورِ والشَّمَمِ",14,"م",1,0],["أقوالُهُ دُرَرٌ أفعالهُ غُرَرٌ","أفضالُهُ طُرَرٌ في جَبْهةِ العَرَبِ",15,"ب",1,0],["أقوالُهُ دُرَرٌّ تُقلَّدُها النُهَى","وفِعالُهُ غُرَرٌ تُقلَّدُها الطُلَى",16,"ل",2,0],["أقوالُهُ خُطَبٌ أفعالُهُ شُهُبٌ","آراؤهُ قُضُبٌ باللهِ حاميها",17,"ي",3,0],["أقوامه فيك اهتدت للحق وال","جهّال طرّاً أصبحوا عقّالا",18,"ل",2,0],["أَقوالُهُم في فُنونِ الفَضلِ كافِيَةٌ","كَما فِعالُهُم تُشفي من الأَلَمِ",19,"م",1,0],["إقواؤهم به الروي يختلف","تحريكه لوقف سابق ألف",20,"ف",1,0],["أَقوالهم فتن للتابعين لهم","وَزخرف القول من وحي الشياطين",21,"ن",1,0],["أقوام سوء لأشراك الردى نصبوا","لذاك غشتهم الايام اشراكه",22,"ك",2,0],["أَقَواَمٌ تحت الغِلاَلةِ أَثْنَيْ","تَ فأزريتَ بالغصونِ الرِّطَاب",23,"ب",1,0],["أقوالنا نصوصٌ","فلا تؤوِّلوا",24,"ل",3,0],["أقوالهم في كل ما يُرتجى","به لنا الخير ملوكُ الكلام",25,"م",1,0],["أَقْوالُهُمْ لِلصِّدْقِ وَالأَفْعَالِ لِل","تَأييدِ وَالآراءُ لِلتَّسْدِيدِ",26,"د",1,0],["أقوَامُهَا مُحمَرَّةُ الألوَانِ","مِن شِدَّةِ البَردِ هُنَا يَا آخوَانِي",27,"ي",1,0],["أقواسُ نصرٍ عند تاج مفاخرٍ","وهُما بأبواب الفؤاد تَرَصَّعا",28,"ع",2,0],["أقواسها قوس التمام وبعده","قوس لطول آخر المعمورة",29,"ه",1,0],["أَقوال مَعنىً أَسمعت أُذُنَ النُهى","لا تلك صاغية وَلا هذا نطق",30,"ق",1,0],["أَقواله لم تخل من حكمة","كَأَنَّها بَين الوَرى تشرع",31,"ع",1,0],["أقوالك الغر التي اشتهرت","أمثالها أخلاقك الزهر",32,"ر",1,0],["أَقوالهُ دررٌ بِأَصدافِ الحجى","وَفعالهُ غررٌ سَمَت بِبَيانِ",33,"ن",1,0],["أقواله أسمى الدروس وشخصه","ملءُ النفوس برقة وبيان",34,"ن",1,0],["أقواسه طيف الوان تزينه","وزخرفات تحاكي روعة الصور",35,"ر",1,0],["اقواهن القاها على كف عفريت","واقرب من شداد المطية للاركاب",36,"ب",1,0],["أقوالها عن حبها لم تبدُ لي","إلا كلام مُجامِلٍ مُتظاهر",37,"ر",1,0],["أقوالهم شهدٌ وطيبُ خصالهم","درر برغم تقلب الأحوالِ",38,"ل",1,0],["أقواتُنا تَصُبُّ في جوعِهِ","وخوفُنا يَصُبُّ في أمنِهِ",39,"ن",2,0],["أقوالنا باتتْ ملونةَ الرِّنا","ما حرّرتْ أرضًا لنا أقوالُ",40,"ل",1,0],["أقواله عندما من فيه قد برزت","اسببى وأفتن من ظبي بلا حلل",41,"ل",1,0],["أقوال غيرهما جُفاءً قد مضت","أمّا فعالُهما رسَا لفوائدِ",42,"د",1,0]]}