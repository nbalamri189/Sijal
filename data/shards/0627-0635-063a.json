35","البسيط"],[4601,"","https://poetry.dctabudhabi.ae/diwan/poem/147770","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120516","السريع"],[4755,"مِن بَسمَةٍ _يا حُبُّ_ هذا الدَّمْ","https://www.poetsgate.com/ViewPoem.aspx?id=184809",""],[4755,"صَيَّادُ البُرُوق","https://www.poetsgate.com/ViewPoem.aspx?id=199741",""],[4790,"سمفونية الخلخال","https://www.poetsgate.com/ViewPoem.aspx?id=144355",""],[4578,"ملأ القلوب من الغرام كما ابتغى","https://www.poetsgate.com/ViewPoem.aspx?id=49480",""],[4859,"عذب الطباع","https://www.poetsgate.com/ViewPoem.aspx?id=195201",""],[4904,"كانَ الْقِرى لَحْمي","https://www.poetsgate.com/ViewPoem.aspx?id=175727",""],[4997,"تبارك النصر","https://www.poetsgate.com/ViewPoem.aspx?id=108086",""],[5038,"أيّها الشّهداء","https://www.poetsgate.com/ViewPoem.aspx?id=190077",""],[5061,"حب بدوي","https://www.poetsgate.com/ViewPoem.aspx?id=148017",""],[5225,"أصغي لصوتك ولا جاني نداك","https://www.poetsgate.com/ViewPoem.aspx?id=36750",""],[5232,"بلبلُ الحبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=212611",""],[5408,"أوجاع يوسفية","https://www.poetsgate.com/ViewPoem.aspx?id=190737",""],[5409,"وطني لأجلك قد عدمت قراري","https://www.poetsgate.com/ViewPoem.aspx?id=155272",""],[5512,"رثاء حبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=204150",""],[5518,"هو المختار (ﷺ)","https://www.poetsgate.com/ViewPoem.aspx?id=187373",""],[5644,"حديث آسر","https://www.poetsgate.com/ViewPoem.aspx?id=198639",""],[5691,"ليلاي...!","https://www.poetsgate.com/ViewPoem.aspx?id=206654",""],[5704,"بالذي سوَّاكَ ...","https://www.poetsgate.com/ViewPoem.aspx?id=191808",""],[5763,"أنتِ حبيبتي فقط","https://www.poetsgate.com/ViewPoem.aspx?id=27057",""],[5784,"#يا ريح","https://www.poetsgate.com/ViewPoem.aspx?id=210510",""],[5815,"رفقاً","https://www.poetsgate.com/ViewPoem.aspx?id=190221",""],[5910,"بردة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=208729",""],[5956,"العروبة تناجي فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=192289",""],[5970,"ذرة ما بين أرض وسماء","https://www.poetsgate.com/ViewPoem.aspx?id=130581",""],[5977,"عالمي","https://www.poetsgate.com/ViewPoem.aspx?id=212746",""],[6019,"نص لم تكتمل ملامحه بعد","https://www.poetsgate.com/ViewPoem.aspx?id=145331",""],[6093,"سِرٌّ مِن ذهَب","https://www.poetsgate.com/ViewPoem.aspx?id=184724",""],[6096,"عماء .. لكني أرى","https://www.poetsgate.com/ViewPoem.aspx?id=177111",""],[6142,"ولادة المرتضى لم يحوها أحد","https://www.poetsgate.com/ViewPoem.aspx?id=155710",""],[6312,"البؤرُ المتحركةُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82949&r=&rc=4",""],[6315,"قَبائلُ النِّسْرِين !! هامشٌ على قرطاسِ المُتَنَبّي ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87575&r=&rc=0",""],[6349,"من قبو ذاكرتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85446&r=&rc=0",""]],"verses":[["أصْغَتْ إِلى الواشينَ بعْدَ صَبْوَةٍ","أرُدُّ فيها لَغَطَ العَواذِلِ",0,"ل",1,0],["إصغ لي أرجوك ؟.. أغرى أمّها","شيّدت قصرين ، من أشلاء هدمي",1,"م",2,0],["أَصغَت إِلى قَولِ الوُشاةِ فَأَسرَفَت","في هَجرِها وَجَنَت عَلَيَّ وَأَجرَموا",2,"م",3,0],["أصغيت منقطعاً إلي","ه عن المواطن والعشير",3,"ر",1,0],["أصغَ ساعف قدّم ارْعَ أنلْ","إعطف ارحم صنْ أعذ أغث",4,"ث",1,0],["إصغي إلى مدحٍ لي فيك سائرةٍ","قد أسمعت كلماتي من به صمًم",5,"م",1,0],["أصغَى لما قلتُ الأصمُّ الأصلَخُ","حُسْناً وللحقِّ دواعٍ تَصْمَخُ",6,"خ",1,1],["أصغرتموهُ فأسرفتم وحُق لهُ","لو تمم الله ما لقّاه إصغارا",7,"ر",2,0],["أصغِ إليه فلم يُحابك في ال","مدح ولا قال وهو مخترعُ",8,"ع",1,0],["أصغت إلى العشاق أذني مرةً","ومن الجميل تعاطفُ العشاق",9,"ق",1,0],["أصغ إلي قولي بأُذْنِ امرئٍ","يرى العطايا خيَر مالٍ ملَكْ",10,"ك",1,0],["أصغَى وظل لما حدثتُ متهماً","لولا شواهدُه من وجهك الحسن",11,"ن",1,0],["أَصغي إِلى النَسَماتِ تَروي لِلرُبى","ما قالَتِ الأَشجارُ لِلغُدرانِ",12,"ن",1,0],["أُصْغي لمُوسيقى الحَياةِ وَوَحْيِها","وأذيبُ روحَ الكَوْنِ في إنْشَائي",13,"ي",1,0],["إصغ لي أنت مثل ما تتمنى","زينب تجمع الغنى والجمالا",14,"ل",2,0],["أَصَغَيتِ سَمعاً لِلوُشاةِ فَتارَةً","أَخشى عَليكَ وَتارَةً أَخشاكِ",15,"ك",1,0],["أَصغَرَت مالَنا النُفوسُ الكِبارُ","فَاِقتَضَت طَولَنا السُيوفُ القِصارٌ",16,"ر",1,1],["أصغى العباب ورجّع الوادي","أصداءه وتناجت السحب",17,"ب",1,0],["أصغ لي وانظر ودع كف","فك في كفيَ حينا",18,"ن",2,0],["أَصغَيتُ لِلأَيّامِ إذا نَطَقَتْ","بالوعظ فهيَ نَواطِقٌ خُرسُ",19,"س",1,0],["أَصغى إِلى البَينِ مُغتَرّاً فَلا جَرَما","أَنَّ النَوى أَسأَرَت في قَلبِهِ لَمَما",20,"م",2,1],["أَصغتْ إليه فلم يَقِرَّ بغمدِه","منها على طولِ التحلّمِ مِخْذَم",21,"م",1,0],["أَصغى بِإِبريقِهِ مِن تَحتِ مِبزَلِها","حَتّى تَمَلَّأَ مِن أَحشاءِ مَوخوزِ",22,"ز",1,0],["أصغرُها في القلوبِ أكبرُها","يُبْعثُ منهُ الشِّفاءُ والسَّقمُ",23,"م",1,0],["أصغَى إليكَ بِكأسهِ مُصغِي","صَلْتُ الجبينِ مُعَقْرَبُ الصّدغِ",24,"غ",1,1],["أُصْغي إليكَ عميقَ الفكر ملتمعاً","في منطقٍ جهوريِّ الصّوت رنّانِ",25,"ن",1,0],["أُصْغي وأُحْصي دَرَجَ السلّمِ","لكنَّهُ يمضي وينأى صداهْ",26,"ه",1,0],["أُصْغي لأَوجاعِ الكآبَةِ","والكآبَةُ لا تُجيبْ",27,"ب",1,0],["أَصْغُوْا لِقَوْلِ فَتىً جَرِيءٍ مِنْهُمُ","غَضِّ الشَّبِيبَةِ جَامِحِ الأَهْوَاءِ",28,"ا",2,0],["أصغى إليها اللّيل لم يسمع بها","إلاّ أنين الجوع في الأحشاء",29,"ا",2,0],["أصغى لأنغامه ومهجته","نوح مع الطير هاجه سحره",30,"ر",2,0],["أصغى له جمعُ الدهاةِ وأطرقوا","شَتّان بين السمع والإنصافِ",31,"ف",1,0],["أصْغَى إليه الشَّرْقُ يَسْمَعُ دَعوَةً","قُدْسِيَّةً للبَعْثِ والتَّجْدِيدِ",32,"د",1,0],["أصغَى له الوادي وغنّتْ باسمه","بغدادُ واهتزَّت إليهِ الشام",33,"م",1,0],["أصغى فلم يسمع سوى غيمة","وثرثرات المطر الواكف",34,"ف",1,0],["أصغيتُ للأيام إذ نَطَقَتْ","بالوعظ فهي نواطقٌ خرسُ",35,"س",1,0],["أصغِ إلى قولي بأُذْنِ امرىء ٍ","يرى العطايا خيَر مالٍ ملك",36,"ك",1,0],["أصغِ لهذي الأرضِ واسمعْ لما","تشكو، لمن غيرك يوماً تبوحْ؟",37,"ح",1,0],["أُصغي تُرى من مُجيبِ","أو من خَيالٍ جَميل",38,"ل",1,0],["أصغت لهم زمر مافي مجالسهم","من منكر لاهتضام الشيخ مُنتَهر",39,"ر",1,0],["أصغوا إِلى عاذلهم وقتلها","كم في التراب عفّروها من لحا",40,"ح",2,0],["أُصغي إِلى الواشي وقد حذرتٌه","منه وبنيان المودة عامر",41,"ر",1,0],["أُصغي فلم أسمَع بها","غير النهيقِ أو الخوارِ",42,"ر",1,0],["أَصغي إِلى أَنغامِ صَوتِ الهَوى","من غابَةِ الحُبِّ سَمَت صاعِدَه",43,"ه",1,0],["أَصغي إِلى صَوتٍ دَوى في الدُجى","أَنينُهُ في الظُلمَةِ السائِدَه",43,"ه",1,0],["اصغَ وارحمْ نبضَ قلبي","لا تبالغْ في استلابي",44,"ب",2,0],["اصغ واسْتَمْسِكْ بِنُصْحي","إنَّ عقلي قد دعاكَ",45,"ك",1,0],["اصغ وارحم قلب شاكٍ","حسرةً، يامن شجاني",46,"ن",2,0],["اصغرهم في الاختبار كهل","وبعضهم بالاقتدار كُل",47,"ل",1,0],["أَصغى إِلى كَذِبِ الواشي فَصَدَّقَهُ","يا بِئسَ ما صَنَعَ الواشي وَما نَصَعا",48,"ع",2,0],["أصغَتْ لستمعَ شكوتي وتظلُّمي","لمَّا رأتْ دمعي جرى كالعنْدَمِ",49,"م",1,1],["أصغَى مَسامِعَه إلى عُذّالِهِ","ونأَى بأسرارِ الفؤادِ الوالِهِ",50,"ل",2,1],["أصغِي لصوت أنينهِ كي تعرفي","من صوتِه ما فيهِ من بَلواءِ",51,"ا",2,0],["أَصغ إِلى وَصفي حُدوثَ العالَمِ","بِحُجَّةٍ كَحَدِّ سَيفٍ صارِم",52,"م",1,0],["أصغي إلى نَغَم القيان وأرتوي","من ريق ممتزج بريق الجام",53,"م",1,0],["أصغيتم في تقليداً لما ذكروا","من العيوب فعيشي كله نكدُ",54,"د",1,0],["أصغي إليها يا نجوم فربما","ألهمت ما ضيت من إيحاء",55,"ا",2,0],["أصغت إلى شدوه الآرباب ساهمة","والأنبياء وأعلام الألباء",56,"ا",2,0],["أصغي إليهِ ولا أحسُّ به","وَهوَاه في قلبي وفي عَيني",57,"ن",2,0],["اصغرتَ آلافَ الفراسخ جائزا","هذا العباب كعابر لجداول",58,"ل",1,0],["أصغَى إلى الواشي فحلَّ عهدَه","والغدرُ ما غيَّر عندي حالَه",59,"ل",2,0],["أصغت له بنت الكئيبة مسهبا","فيما حواه حديثه المأثور",60,"ر",1,0],["أَصْغَى وَأَشْفَى عَلَى الرَّدَى سَقَمَاً","أَصَمُّ عَمَّا أُحِبُّهُ أَعْمَى",61,"م",2,0],["أصغَى إلَيكَ فَقُدتَهُ","قَودَ الجَنيبَةِ في الرَّسَن",62,"ن",1,0],["أصغي لألحان الصبابة والكآ","بة عندما تتصبب الأنهار",63,"ر",1,0],["أصغِ يا مُصْغياً إلى كلِّ رِكزٍ","بمديحٍ يستعذبُ السمعُ ركزه",64,"ز",2,0],["أَصَغَى لِلّاحِ قَولاً وَاِستَمَعْ","وَإِليهِ اللّاحِ في لَومي اِقتَربْ",65,"ب",1,0],["أصغ لمدائحي كرما وبشر","توافيها ببشر والتفات",66,"ت",1,0],["أصغي مع الظلمات مر","تقباً تباشير النهار",67,"ر",1,0],["أصغي إِلي فَما في الأَرض مِن أَحد","أَلقى إلَيهِ صَريح النصح إِلاك",68,"ك",1,0],["أُصغي إِلى قائِدي لِيُخبرَني","إِذا التَقَينا عَمّن يحيّيني",69,"ن",2,1],["أصغي بكل جوارحي لحديثها","المقرون بالإعجاب والإكبار",70,"ر",1,0],["أصغي الى قول العذول بجملتي","مستفهماً عنكم بغير ملال",71,"ل",1,1],["اصغت لك الدنيا بمساميع","ما بين منظور ومسموع",72,"ع",1,0],["أصغ والحظ ديارهم هل ترى من","أَحَد منهُمُ وتَسمَعُ رِكزا",73,"ز",2,0],["أصْغ النبا يا حادي ظْعون لاحباب","وافهم عسى تِغْنم بكل المطاليب",74,"ب",1,1],["أصغر الأرض وما فيها مقاما","فاعتلى يضرب في السحب الخياما",75,"م",2,1],["اصغ لي تستمع نصيحة ود","احر ان لا يأبى النصيحة بر",76,"ر",1,0],["أصغر القوم الذي","عن هواه انتبذا",77,"ذ",2,0],["أُصغي إلى الماءِ يجري في مسارحه","على الحصى وهو صبٌّ يغنم القبلا",78,"ل",2,0],["أصغ إلى دعوة المروءة لا","تلغ لها دعوة تكررها",79,"ر",3,0],["أَصغى لَهُ الدَهر إِجلالاً وَلاحظه","شَوقاً فَقيَّد مِنهُ السَمع وَالبَصَرا",80,"ر",2,0],["أصغتِ الروضُ للطبيعة حتى","سمعت أذنها دبيبَ الأمانى",81,"ن",2,0],["أصغرتَ أمرَ رجال أمرُهم جَللٌ","وبتَّ تعبد أصنام الخرافاتِ",82,"ت",1,0],["أصغي مسامعه لما نطقت به","حال الحكيم لوم تحاول كتمه",83,"م",2,0],["أصغت إلى شعري ردّدته","أبثُّه ما جال في صدري",84,"ر",2,0],["اصغي ولا يرنُّ لي خلخالها","ما بال ذات الخال والخلاخل",85,"ل",1,0],["أصغ لشَأني فإنَهُ عَجَبٌ","وإن يَكُنْ ما أقولُ من هوسي",86,"س",2,0],["أُصغي الى الحق في قلبي فأنظمه","شعراً وما جاء من وحي أسجّله",87,"ل",2,0],["أصغي إلى أحكامه طائعاً","ولم يصغ يوما الى حكمي",88,"م",2,0],["أصغوا لأنفسكم من بعد تزكية","لها لتدخلكم في روض جناتي",89,"ت",2,0],["أصغي لما يُلقيهِ ممتثلاً لَهُ","وَيَروقني إِرشادهُ وعظاتهُ",90,"ت",2,0],["أصغر بأضحية في غير يوم وغى","فما اضاحيك الا الخيل والبهم",91,"م",1,0],["أصغى إِلى الشَرق ذو التطراب واِستمعا","كَأَنَّ بلبله في رَوضِهِ سجعا",92,"ع",2,1],["أُصغي إِلى القَلب مِن بَعيد","فأسمع البثّ وَالهُموما",93,"م",2,0],["أصغي إِلى ذكركم فيرجع بي","إِلى طَويل الغَليل إِصغائي",94,"ا",2,0],["أصغى لها وكأنني مستقبل","في ظلمة الليل البهيم الأنجما",95,"م",2,0],["أصغِ لما اذكر من امثالِ","قد سقتها بأوضح المقال",96,"ل",1,0],["أصغرُ الساقيينِ أشكلُ","عندي وأملحُ",97,"ح",1,0],["أصغي لأقوالِ العُفاةِ ولم أكن","للّومٍ في بذل المواهبِ أسمعُ",98,"ع",1,0]