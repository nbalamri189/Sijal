gate.com/ViewPoem.aspx?id=33579",""],[5121,"صَهٍ صَهٍ","https://www.poetsgate.com/ViewPoem.aspx?id=33838",""],[5186,"\"من \"\"البرج\"\" في كانون والليل خيما","https://www.poetsgate.com/ViewPoem.aspx?id=156441",""],[5320,"الموظف","https://www.poetsgate.com/ViewPoem.aspx?id=40423",""],[5397,"تدلت لأفنان النقا عذباتها","https://www.poetsgate.com/ViewPoem.aspx?id=157920",""],[5397,"توارى محيا الشمس منك بحاجب","https://www.poetsgate.com/ViewPoem.aspx?id=157938",""],[5582,"خَيالٌ سَرَى نَوْمَةَ السَّامِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=187098",""],[5701,"رعى الله على دِجل","https://www.poetsgate.com/ViewPoem.aspx?id=164597",""],[5725,"ونادبة قتلي","https://www.poetsgate.com/ViewPoem.aspx?id=196931",""],[5912,"رباعيات 2","https://www.poetsgate.com/ViewPoem.aspx?id=205019",""],[6019,"عتاب على هامش الشوق ...!!","https://www.poetsgate.com/ViewPoem.aspx?id=53042",""],[6043,"اختِباء","https://www.poetsgate.com/ViewPoem.aspx?id=215589",""],[6097,"ألا يا خاطب الحسنا","https://www.poetsgate.com/ViewPoem.aspx?id=186339",""],[6157,"دعيني من مقال العاذلين","http://www.aldiwanalarabi.com/poemDescription.do?poemId=558686",""],[6177,"مديح الفصيح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79433&r=&rc=22",""],[6198,"الأفق المحترق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79279&r=&rc=53",""],[6259,"أسيلة خدٍّ دونهُ الأسلُ السمرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59375&r=&rc=23",""],[572,"وَحَاسدٌ ظاهِرهُ لي وامقُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9405&r=&rc=262",""]],"verses":[["تَخُبُّ بِجانيكُم وَفي كُلِّ ساعَةٍ","يُتاحَ لَها مِنكُم بِراقٍ وَرادِفِ",0,"ف",1,0],["تَخَبَّروا اليَومَ فَما","بَعدَ الطِعانِ مِن خَبَر",1,"ر",1,0],["تَخبو وتُوقِدُها ولائِدُ عامِرٍ","بالمَندَليّ وبالقَنا المُتَكَسِّرِ",2,"ر",1,0],["تَخُبُّ بَرِحْلِي كُلُّ شَاكِيَةِ الْوَجَى","هِيَ الْقَوْسُ تَرْمِي الرُّكْنَ رَاكِبُهَا سَهْمُ",3,"م",1,0],["تُخَبِّرُهُنَّ الطَيرُ عَنكَ بِأَوبَةٍ","وَعَينٌ أَقَرَّت نَومَها بِلِقائِكا",4,"ك",2,0],["تَخَبَّطَني مَسٌّ مِنَ الجِنِّ أَم سَرَت","بِأَجزاءِ نَفسي نَشوَةٌ وَخُمارُ",5,"ر",1,0],["تُخَبِّرُني عَنّي بِما لا رَأَيتُهُ","فَتَصدُقَ فيما خَبَّرَت وَهيَ لا تَدري",6,"ر",2,0],["تُخَبِّرُ مَن لاقَيتَ أَنَّكَ عائِذٌ","بِلَ العائِذُ المَظلومُ في سِجنِ عارِمِ",7,"م",1,0],["تُخبرنا عن رجلٍ","مسْتعمَلِ المقافِدِ",8,"د",1,0],["تخبط قومه فيك الخطيب","يريبك في المجامع ما يريب",9,"ب",1,0],["تخبِّرُنَا عمَّنْ تقدَّم قبلنَا","وإنْ لم نسائلْهَا بكيفَ وإِيهِ",10,"ي",2,0],["تُخَبِّرُ عَن نَصرِ المَوالي وَعِزِّهِم","وَخِذلانِ عَبدوسِ وَإِفلاحِ مُفلِحِ",11,"ح",1,0],["تُخبِرُ عَن ذاكَ أَنَّ زائِرَةً","تَشفي مَزوراً مِن لاعِجِ الدَنَفِ",12,"ف",1,0],["تُخَبِّرُني أَيّامِيَ الحُدثُ أَنَّني","تَرَكتُ السُرورَ عِندَ أَيّامِيَ القُدمِ",13,"م",1,0],["تُخَبِّرَكَ الكُهّانُ أَنَّكَ ناقِضٌ","دِمَشقَ الَّتي كانَت إِذا الحَربُ حَرَّتِ",14,"ت",1,0],["تُخبِركَ فُرسانُ العَريكَةِ أَنَّني","كُنتُ المُصَلّي بَعدَ سَبقِ الأَوَّلِ",15,"ل",1,0],["تخبو العواطفُ في الصدورِ وتنتهي","ويجفُّ في زهر القلوب نَداهَا",16,"ا",3,0],["تخبّ بهمْ قبٌّ يُطيلُ صهيلُها","بأرْض أعاديهم نياحَ النّوادِبِ",17,"ب",1,0],["تَخَبَّطَ في غابةٍ أطْبَقَتْ","على مُذْئِبٍ منه أو مُسْبِعِ",18,"ع",1,0],["تُخَبِّرُني الأَحلامُ إِنّي أَراكُمُ","فَيا لَيتَ أَحلامَ المَنامِ يَقينُ",19,"ن",1,0],["تَخبو وَتَقتَدحُ الحُقودُ رَمادَها","كَالنارِ هاجَ كَمينَها المِقداحُ",20,"ح",1,0],["تُخبِرُكَ القَبائِلُ مِن مَعَدٍّ","إِذا عَدّوا سَعايَةً أَوَّلِينا",21,"ن",2,0],["تُخبِرُ عَن عِزٍّ وَعَن تَمكينِ","وَحِكمَةٍ مَقرونَةٍ بِالدينِ",22,"ن",1,0],["تُخبِركُمُ عَن زَمَنٍ لَم يَزَل","يَجِدُّ بِالقَومِ وَهُم يَلعَبون",23,"ن",1,0],["تُخبِركُمُ التَّوراةُ أنْ قد بَشَّرَتْ","قِدْماً بأَحْمَدَ أَمْ بإسْماعِيلا",24,"ل",2,0],["تَخُبُّ إلى مَيْدان سَبقي بطاؤهَا","وتلك الظّنونُ الكاذباتُ الأوافك",25,"ك",1,0],["تُخبِرُني عَن قَلبِهِ كُتبُهُ","إِنَّ بِهِ أَعظَمَ مِمّا بي",26,"ب",2,0],["تُخبِرُ عَن طيبِهِ مَحاسِنُهُ","مُكَحِّلٌ ناظِرَيهِ بِالفِتَنِ",27,"ن",1,0],["تَخُبُّ إِلى النُعمانِ حَتّى تَنالَهُ","فِدىً لَكَ مِن رَبٍّ طَريفي وَتالِدي",28,"د",2,0],["تَخَبَّثتَ إِذ جُمِعَت أَربَعٌ","لَدَيكَ وَأَضحَكتَ في الحَيِّ بي",29,"ب",2,0],["تُخَبَّرُ عَن أَسرارِهِ قُرَناءَهُ","وَمِن دونِها قفلٌ مَنيعٌ وَسادِنُ",30,"ن",1,0],["تَخُبّ بكَ الجيادُ كأنّ جَوْناً","على لَبّاتِهِنّ الأرْجُوانُ",31,"ن",1,0],["تَخُبّ إلى المُشَرّفِ آمِناتٍ","كَلالاً إنْ ألَمّ بكُمْ كَلال",32,"ل",1,0],["تُخْبِرْ بِمِثْلِ الَّذِي أَنْتَ العَلِيمُ به","أَيَّامُنَا والصِّبَا تُعْصَى عواذِلُهُ",33,"ل",2,0],["تخبو الشموس وتنطفي","وتظل نامية الشبوب",34,"ب",1,0],["تخبركُم حرقةُ انفاسِهم","كيف – تقضَّت – وانتفاخُ العيون",35,"ن",1,0],["تخبط في بسائطهِ وحَلَّت","على يده من الأفكار غُلقُ",36,"ق",1,0],["تخبط اللّيل والعواصف والرّكب","حيارى دليلهم حيران",37,"ن",1,0],["تُخَبّرُ مَنْ لاقيتَ أنّكَ عائِذٌ","بلِ العائذُ المظلومُ في مسجن عارمِ",38,"م",1,0],["تخبو العواطفُ في الصدور وتنتَهي","ويَجف في زهرِ القلوبِ نذاهَا!",39,"ا",3,0],["تُخَبَّرُ أَنَّنا أَولى بِمَجدٍ","تَوارَثَهُ طِرافٌ عَن طِرافِ",40,"ف",1,0],["تُخْبِرْك عنِّي أَنني لم أَلقَها","هَيْنَ العَزائِمِ واهي الأركانِ",41,"ن",1,0],["تخبِرُنا عنهما عيونهمُا","أنّهما يَحملان حِقديَن",42,"ن",1,0],["تَخُبُّ بِهِ حَرفٌ يُعَرِّقُها السُرى","فَلَم يُبقِ شَيئاً في الأَديمِ وَلا نَحضا",43,"ض",2,0],["تُخبِرُ عَن عِرضِكَ النَقِيِّ مِن","اللَومِ وَعَن طيبِ ذِكرِكَ الأَرِجِ",44,"ج",1,0],["تُخبِرُني شَواحِجُ الغُدقانِ","وَالخُطبُ يَشهَدنَ مَعَ العِقانِ",45,"ن",1,1],["تُخَبِّر ألسُنُ العَيِيَاتِ عنْها","بِما يُعْيِي عَلَى اللسِنِ الخَبيرِ",46,"ر",1,0],["تَخَبَّطُ من حرِّ السلاحِ بنحرِها","وَبالريق والأنفاسِ والدم تشرق",47,"ق",1,0],["تَخُبّ بِهِ تَحتَ الرُّوَأةِ نََائِبٌ","عَلِيهنَّ من دُر الكلام وُسُوق",48,"ق",1,0],["تَخُبُّ ببيضٍ مُغْمدي البِيضِ في الطُّلى","فمِن صالِفٍ ضَرْباً بهنّ ولائت",49,"ت",1,0],["تَخْبِطُ رِجْلاه على العراء","مَع الصّوابِ خبَطْةَ العَشْواء",50,"ا",2,0],["تخبركما عمن بنى غرفاتها","وفارقها من بعده وسلاها",51,"ا",3,0],["تخبرك ناطقة بالحال صادقة","بكل ما كان من قبح ومن حسن",52,"ن",1,0],["تُخَبِّرُ عَمّا في الضَمير كَأَنَّها","سواد سويداواتهنَّ لَها حِبرُ",53,"ر",1,0],["تخبرك أن الأرض قد وارتهم","رأيت لهم أن يسمعوا أو ينطقوا",54,"ق",3,0],["تُخَبر أَنَّنا ولأنتَ أدرى","صيامٌ منذ وافانا الصِّيام",55,"م",1,0],["تخبرنا عن نار كسرى لعهده","وقد بَرَزَتْ في طوقه وسواره",56,"ر",2,0],["تخبّرني ضيوفك أين جاءَت","بأنَّك قد بعدت عن اللحوق",57,"ق",1,0],["تُخَبِّرُ عن جَمْعِ المُنى فَتَهَنَّها","وعن عَوْدِ أَعْيادٍ بِهَا فَتَمَلَّها",58,"ل",3,0],["تخبِط الأرضَ خِلاطاً سيرُها","وَهدةً تخبِطُ أو تُشْرِفُ رَعْنا",59,"ن",2,0],["تخبركم عن الخلود أبداً","وتخبر الأعداءَ عن آجالها",60,"ل",3,0],["تخبِطُ عشواؤهُمُ","ما فعل المُقَوِّدُ",61,"د",1,0],["تَخْبرُ منه ما أنت ناقده","وأكثر الإنتقادِ تقليدُ",62,"د",1,0],["تَخبُث الأيدي وفي راحتِهِ","من نداه أرجُ المَشتَا المَطيبِ",63,"ب",1,0],["تُخبِّرُ ضيِفانُ الشتاءِ بجودهِ","اذا الجرن من عصف الشمال اضمحلَّت",64,"ت",1,0],["تخبو المواقدُ باليَفاع وبشْرُك ال","هادي ركابَ الخابطِ المُتنوِّرِ",65,"ر",1,0],["تُخَبِّرُ والرَحمَنِ أَن لَستَ زائِراً","ديارَ المَلا ما لاءَمَ العَظمَ جابِرُ",66,"ر",1,0],["تَخُبُّ في الهَجْلِ كالارسانِ معنِقةً","مِن فوقِهنَّ مهازيلٌ كأرسانِ",67,"ن",1,0],["تُخَبِّرُني بِالنَجاةِ القَطاةُ","وَقَولُ الغُرابِ لَها شاهِدُ",68,"د",1,1],["تخبر في الأرض عن السماء","ألطف في الجو من الهواء",69,"ا",2,0],["تخبرنا عن بأسه ونواله","وإن نحن لم نجهل منى ومنون",70,"ن",1,0],["تَخُبُّ بِكلِّ عامِرَةٍ وقَفْرٍ","وتَخْتَرِقُ الْمَوامِي للتَّنائي",71,"ا",2,0],["تُخبِرُ عن غَيبٍ لَه فِراسَةٌ","فمَا تنبَّأَ به فَلتَثِقِ",72,"ق",1,0],["تَخبُّ إليَّ مِن بَلَدٍ بعيدٍ","مَنيعٍ لا تَعَلَّقُه الأماني",73,"ن",2,0],["تُخبِرْكَ عن نَصْلِ الفَراشِ رؤوسُهمْ","وَنُحورُهم تُنبيك عن خُرصاني",74,"ن",2,0],["تُخَبِّرُني الأَحلامُ أَنّي أَراكُمُ","فَوَيلي كَم مِنَ الأَباطِلِ أَحلُمُ",75,"م",1,0],["تخبر عن عادٍ القديم وتبع","بأبلغ معنى ما على الشرب يشكل",76,"ل",1,0],["تُخْبِرُنِي عَنْ سِرِّهِ الخَلاَئِقُ","وَقَلَّ مَا يَنْكَتِمُ المُنَافِقُ",77,"ق",1,0],["تخبط أجواز الفلا","لا تنثني من اللغب",78,"ب",1,0],["تخبو المواقدُ باليَفاع وبشْرُك ال","هادي ركابَ الخابطِ المُنتوِّرِ",79,"ر",1,0],["تخبر بورد وورد طول ليلته","من خده ولماه البارد الخصر",80,"ر",1,0],["تُخبرُ عن كسرى وايقاعهِ","بعدَ