 الله عنها هل يلم خيالها","https://www.aldiwan.net/poem15086.html","الطويل"],[463,"نعمت صباحا ما تغنت حمامة","https://www.aldiwan.net/poem16155.html","الطويل"],[463,"ليهن الرعايا والمناقب والعلى","https://www.aldiwan.net/poem16354.html","الطويل"],[466,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[466,"كم بين اظعان الخليط الزائلِ","https://www.aldiwan.net/poem3603.html","عموديه"],[481,"عارف ما الشعر صاغيه","https://www.aldiwan.net/poem37208.html","مجزوء الرمل"],[481,"يا ثابت الراي في الأعمال تجريها","https://www.aldiwan.net/poem37595.html","البسيط"],[502,"خبط الظلام ولألأ الفجر","https://www.aldiwan.net/poem37558.html","أحذ الكامل"],[516,"لله قوم بأكناف الحمى نزلوا","https://www.aldiwan.net/poem20817.html","البسيط"],[531,"قل لعلي نالا","https://www.aldiwan.net/poem37249.html","مجزوء الرجز"],[540,"يا من تكفل لمن دعاه","https://www.aldiwan.net/poem47447.html","عموديه"],[546,"المتنبي .. كون في ملامح كائن","https://www.aldiwan.net/poem67242.html","عموديه"],[553,"قل لقوم شنوا المعاتب منهم","https://www.aldiwan.net/poem47170.html","الخفيف"],[553,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"],[553,"من أين زرت خيال ذات البرقع","https://www.aldiwan.net/poem47707.html","الكامل"],[553,"يا خليلي ومعيني","https://www.aldiwan.net/poem47735.html","مجزوء الرمل"],[553,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[553,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[553,"من عذيري من سقام","https://www.aldiwan.net/poem48076.html","مجزوء الرمل"],[555,"ذهب في ذهب راح","https://www.aldiwan.net/poem68235.html","مجزوء الرمل"],[564,"تذكر المنحنى فانهل مدمعه","https://www.aldiwan.net/poem52851.html","البسيط"],[569,"أعاذ الله شكواك","https://www.aldiwan.net/poem69565.html","مجزوء الكامل"],[570,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[577,"يا ساكناً بين جنات وأنهار","https://www.aldiwan.net/poem2784.html","البسيط"],[588,"في غزلي من لحظ ذاك الغزال","https://www.aldiwan.net/poem17690.html","السريع"],[900,"","https://poetry.dctabudhabi.ae/diwan/poem/10420","المنسرح"]],"verses":[["في غِلمَةٍ تَرَكوا قُعودَهُمُ","نَزَعوا وَراءَ اللَيلِ وَاِنحَفَلوا",0,"ل",3,0],["في غُرَّةِ المَجدِ مُذ غُيَّبتُمُ كَلَفٌ","عَلى الزَمانِ وَفي خَدِّ العُلى ضَرَعُ",1,"ع",1,0],["في غَمامٍ بُهَّلٍ أَخلافُها","أَطلَقَ الراعِدُ عَنهُنَّ الصِرارا",2,"ر",2,0],["في غِلمَةٍ هَدَموا ذُرى عَبدِيَّةٍ","أَنضاءِ خَمسٍ لِلنَجاءِ عَمَرَّدِ",3,"د",1,0],["في غِلمَةٍ حَمَلوا القَنا وَتَحَمَّلوا","أَعباءَ يَومِ المَأزِقِ المَشهودِ",4,"د",1,0],["في غِلْمَةٍ مُرْدٍ تَمطّى بهِمْ","إِلى الوَغى جُرْدٌ سَراحيبُ",5,"ب",1,0],["في غِلْمةٍ كَضواري الأُسْدِ أحْنَقَها","رِزُّ العِدا دون غاباتٍ وأحْراجِ",6,"ج",1,0],["في غيْرِ حِفْظِ اللّهِ منْ هامَةٍ","هامَ بِها الشّيطانُ في كُلِّ وادْ",7,"د",1,1],["فيغتدي أنور في عصره","مزدهراً كالوكوب الهادي",8,"د",2,0],["في غَفلَةٍ عَنّا وَفي ضَلالِ","وَنَحنُ قَد زُرناهُ بِالآجالِ",9,"ل",1,0],["فَيَغلُظُ قَلبي ساعَةً ثُمَّ أَنثَني","وَأَقسو عَلَيهِ تارَةً وَأَلينُ",10,"ن",1,0],["في غصونٍ ناعماتٍ","مثل أوصال العَذارِي",11,"ر",2,0],["فيغتدي سُبحةً لفيك ولو","شِئتَ بحقٍّ لكان من لُعَنك",12,"ك",1,0],["في غيرِ عيبٍ يعيبُ مَنزِلتي","وغير ريب يُريبُ إسلامي",13,"م",2,0],["في غَمرَةٍ مِن سَحابِ الآلِ يَرفَعُهُم","يَطفونَ فيها قَليلاً ثُمَّ تَنخَرِقُ",14,"ق",1,0],["في غَيرِ شَيءٍ أَقَلَّ اللَهُ خَيرَهُمُ","ما إِن لَهُم دِمنَةٌ فيهِم وَلا ثُؤَرُ",15,"ر",1,0],["في غُرفَتي مَوقِدٌ صَغيرٌ","لِلَّهِ مِن مَوقِدي الصَغيرِ",16,"ر",1,0],["في غُرفَتي وَالريحُ راكِدَةٌ","بَينَ المَغارِس وَالصَبا تَسري",17,"ر",2,0],["في غابَةٍ تَحكي ذَوائِبَها","في لَونِها وَاللَف وَالنَشرِ",18,"ر",1,0],["في غَفلَةِ العُذّالِ في غَسَقِ الدُجى","إِنَّ السَعادَةَ غَفلَةُ العُذّالِ",19,"ل",1,0],["في غُربةٍ رُوحيَّةٍ مَلْعُونةٍ","أَشواقُها تَقْضي عِطاشاً هِيما",20,"م",2,0],["في غد نستردّه","وهو اليوم مهتضم",21,"م",1,0],["في غَدٍ تَأوي إِلى قَفرٍ حَلِك","يَستَوي الصُعلوكُ فيهِ وَالمَلِك",22,"ك",1,0],["في غَلائِلٍ","سُندُسٍ قُشُب",23,"ب",1,0],["في غِلمَةٍ أَخطَروا أَرواحَهُم وَرَضوا","بِما لَقينَ رِضا الأَيسارِ بِالزَلَمِ",24,"م",1,0],["في غايَةٍ طُلِبَت فَقَصَّرَ دونَها","مَن رامَها فَكَأَنَّها ما تُطلَبُ",25,"ب",1,0],["في غِرارَيهِ وَالذُبابِ بَناتُ الذَر","رِ يَرفُلنَ في نَهيكٍ سَبيكِ",26,"ك",1,0],["في غَيرِ شَأنِكَ بُكرَتي وَأَصيلي","وَسِوى سَبيلِكَ في السُلُوِّ سَبيلي",27,"ل",2,1],["في غُرَفِ الجَنَّةِ العُليا الَّتي جُعِلَت","لَهُم هُناكَ بِسَعيٍ كانَ مَشكورِ",28,"ر",1,0],["في غارةٍ لم تَسقِ ظَمآنَ الثَّرى","عَلَقاً ولم تُغشِ السَماءَ قَساطِلا",29,"ل",2,0],["في غارةٍ لم تَنْثَلِمْ فيها الظُّبا","ضَرْباً ولم تَنْدَ القَنا بخِضابِ",30,"ب",1,0],["فيغيب في أحضانه ثملاً","ويعب من فيض الهوى الدفاق",31,"ق",1,0],["فَيُغبَقنَ أَحلاباً وَيُصبَحنَ مِثلَها","فَهُنَّ مِنَ التَعداءِ قُبٌّ شَوازِبُ",32,"ب",1,0],["في غُلَّةٍ أَوقَدَت عَلى كَبِدِ ال","سائِلِ ناراً تُعيِي عَلى كَبِدِه",33,"د",2,0],["في غَفلَةٍ مِمَّن نُحاذِرُ قَولَهُ","وَسَوادِ لَيلٍ ذي دَواجٍ مُظلِمِ",34,"م",1,0],["في غَمرةٍ ضَمِنَ الحِفاظُ لِقاحَها","فالحربُ تَسدحُ بالكُماةِ وترْدَحُ",35,"ح",1,0],["في غَدٍ يَنشأ الصِغار فَيبغو","ن تلاداً وَما تَرَكتُم تلادا",36,"د",2,0],["في غَفلَةٍ لا هَمَّ يَعرِفُها","فَطَفِقتُ أَهزِلُ بِالزَمانِ وَجَد",37,"د",1,0],["في غَمرَةٍ كانَت رَحى المَوتِ بِها","تَدورُ وَالصَبرُ لَها مِنّي قُطُب",38,"ب",1,0],["فيَغْدوُ عليها فارسٌ غيرُ دارعٍ","ويَرْدى إليها سابحٌ غيرُ مُلجَم",39,"م",1,0],["في غُرَّةِ الدَهرِ إِذ نُعمانُ ذُو تَبَعٍ","وَإِذ تَرى الناسَ في الأَهواءِ هُمّالا",40,"ل",2,0],["فِي غَمرَةِ المَوتِ نَغشاها وَنَركَبُها","ثُمَتَ تَبدُو كِرامَ الصَبرِ أَبطالا",40,"ل",2,0],["في غير تَأخيرٍ ولا فِرارِ","إلا شديدَ الضَّربِ للكُفّارِ",41,"ر",1,0],["فِي غُرْبَةٍ مَوْصُولَةٍ آلامُهَا","أَنْضَتْهُ فِي الرَّحَلاَتِ وَالأَسْفَارِ",42,"ر",1,0],["فَيَغْتَدي أَنْوَرُ في عَصْره","مزْدَهراً كالكوْكب الهَادي",43,"د",2,0],["فِي غَيْهَبٍ أَبْيَضَ لَمَّا","عٍ بِهَا مُنَزَّلِ",44,"ل",1,0],["فِي غَادَةٍ آدَابُهَا","مِنَ الطِّرَازِ الأوَّلِ",44,"ل",1,0],["فِي غرْبةٍ كَالقَفْرِ لَمْ يُلمِمْ بِهِ","سَكَنٌ هُنَاكَ وَلَمْ يَعُدْهُ العُوَّدُ",45,"د",1,0],["فِي غادَةٍ لَمْ تُطالِعْهَا وَقدْ سَمَحَتْ","عَيْنُ الْعِنايَةِ إِلاَّ أَعْينُ الْفِكَرِ",46,"ر",1,0],["فِي غِبْطَةٍ تَصْفُو وَبِالْغَيْرِ","المُلِمَّةِ لاَ تُثَابْ",47,"ب",1,0],["فَيَغفِرُ اللَهَ ذَنباً","أَبدَأتُهُ وَأَعَدتُه",48,"ت",2,0],["فيغير ، يطعن ، أو يجوز فلانة","وفلانة بشريعة الأسياف",49,"ف",1,0],["فيغتلي خلف ذبولي فتى","ويجتدي شيخ ، ويبكي رضيع",50,"ع",1,0],["فِي غِرَارَيْهِ والذُّبَابِ بَنَاتُ الذَّرِّ ،","يَرْفُلْنَ فِي نَهِيكٍ سَبِيكِ",51,"ك",1,0],["في غربة أنا والإباء المرّ والأدب اللباب","كالسيف حلّته الفتوح وربّما بلي القراب",52,"ب",1,0],["فَيَغْتَرُّ عَنْ حَزْمٍ وَيَسخُو عَلَى بُخلِ","حَوَى سِيَراً مِنْ كُلِّ ضَرْبٍ فُؤَادُهَا",53,"ه",2,0],["فَيَغْبُرَ حَوْلَهُ نَعَمٌ وشَاءُ","فيبني مجدهم ويقيم فيها",54,"ا",1,0],["في غير وادي الشتا في غير أربعه","ما تورف الظل للأشواق أفياء",55,"ا",2,0],["فيُغمِضُ اذ يَرى الأرواحَ","أَسرى والوَرى رَهنا",56,"ن",2,0],["في غُرفَةٍ مُستَبَانَاتٍ بِهَا فُرشٌ","مَرفُوعَةٌ مِن سَمَاهَا قَد سَمَا لِسَمَا",57,"م",2,0],["في غير ليلى لا يروقُ لمغرمٍ","غزلٌ ولا يستحسنُ التشبيبُ",58,"ب",1,0],["في غير خطبك ليس تُسكب عَبرةٌ","إذ كلّ شيء بَعد فقدكَ هيِّنُ",59,"ن",1,0],["فَيُغضي لِعَبدٍ بِالهُدى مُتَمَسِّكٍ","وَيَسطو إِذا الخِذلانُ لَجَّ بِمُشرِكٍ",60,"ك",1,0],["فيُغيرُ في الظّلماءِ غيرَ منبِّهٍ","جيشَ العدوِّ بأنْ يُحَمْحِمَ صاهِلا",61,"ل",2,0],["فيُغِنى خَطُّه يوم العَطايا","ويُفنى سيفُه يومَ الضِّراب",62,"ب",1,0],["فيغضب مغوار ويعبس فاتك","ويفزع موتور إلى سفه الشر",63,"ر",1,0],["فَيَغمُرُهُ بِبَخورِ الحَنانِ","وَيَسمَحُهُ بِزُيوتِ الكِبَر",64,"ر",1,0],["في غِشاءٍ يشفُّ عَن بَعضِ روحٍ","لَيسَ فيهِ لِلأُمِّ بَعضُ رجاءِ",65,"ا",2,0],["في غَنجِ عَينَيهِ وَفي ناظِري","سِحرٌ حَلالٌ وَرُقادٌ حَرام",66,"م",1,0],["في غَيرِ مَوسِمِها وَقَد ذَهَبَت","أَيّامُها وَالدَهرُ ذو دُوَلِ",67,"ل",1,0],["في غِمدِها وَشَكيمِها","مِنها الجَداوِلُ وَالهِضابُ",68,"ب",1,0],["في غَيرِ ما يَزكو بِهِ ال","أَحسابُ لَيسَ لَهُم حِسابُ",68,"ب",1,0],["في غار ثور ثاني اثنين اختفى","وكأنما الأعداءُ دونهما عموا",69,"م",3,0],["في غاية الحسن والدماثة وال","نعمة والظرف والجمال معاً",70,"ع",2,0],["في غصنِ قامتِها ما شئتُ من ثمرٍ","فليتَ قلبي على الأثمارِ عصفور",71,"ر",1,0],["في غفلةٍ كنا فنبَّهنا","طيبٌ تنشَّقناه من فيك",72,"ك",1,0],["فيُغنيكِ طيبُ الذّكرِ عن حُسن صُورتي","وهل دائمٌ عندَ النساءِ هوى خلِّ",73,"ل",1,0],["في غارةِ عربيةٍ تُمحى بها","آثارُ حكم الرومِ والمنغول",74,"ل",1,0],["فيغدو الشرقُ حراً مستقلاً","فتجمعُهُ خلافةُ هاشمي",75,"ي",1,0],["في غَيْرِهِ يَقَعُ الخِلافُ ضَرُورَةً","وعَلَيْهِ حَقّاً يَلْتَقِي الأَصْفَاقُ",76,"ق",1,0],["في غدٍ يذكرُ الهوى","ويطيلُ التلَهَّفا",77,"ف",2,0],["في غرفة اريجها عاطر","يزري بريح الورد والنرجس",78,"س",1,0],["في غِشاءيْنِ أَصفَريْنِ صَقيلَيْ","نِ يقولُ المُشاهِدُ المُسْتَبِين",79,"ن",1,0],["فيَغْدو به مُشرِقاً ناظرٌ","بِبْشرٍ مُقارِنِ بِرٍّ عَميم",80,"م",1,0],["في غِلمةٍ لَفُّوا نَواصيَ خَيلِهم","شُعْثاً بأطرافِ الوَشيج الذُّبَّل",81,"ل",1,0],["في غلْمةٍ ذرعَتْ بهم عَرْضَ الفَلا","هُوجٌ تَلُفُّ تَهائماً بنُجود",82,"د",1,0],["في غَيرِ وقتِ الدَّمع ضيَّعته","قلتُ فقَلبي عندَكم أضيَعُ",83,"ع",1,0],["في غَضَبِ الفهدِ الوثوب يقتدى","بعد ثلاثٍ طاوياً لم يَصطَدِ",84,"د",1,0],["في غَير نَظرة وَامق","عِندَ اللُقا لا يَطمَعُ",85,"ع",1,0],["فَيَغيب سُكراً مِن تَأَم","ل بَل يَذوب تَلهفا",86,"ف",2,0],["فَيَغوص فِكري في دُموعي غَوصة","يَستَخرج الدُرّ الجُمان لِوَصفِهِ",87,"ف",2,0],["في غزة الأبطال خطوي مسرع","أملاً، وخَطْوُ مواجعي متثاقلُ",88,"ل",1,0],["في غور إطراءٍ عديم تناهي","أبدعْتُ في مدحي وأعلى من مَدَحْ",89,"ح",1,0],["فَيُغبَفنَ أَحلاباً وَيُصبَحنَ مِثلَها","فَهُنَّ مِنَ التَعداءِ قُبٌّ شَوازِبُ",90,"ب",1,0],["في غمرةٍ أَعْيا الحِمامَ طريقُها","ففتحتَ فِيهِ للقنا حَتَّى سَلَكْ",91,"ك",1,0],["فِي غَوْلِ ذي لُجَجٍ لَبِسْنَ دياجياً","تركَ الحياةَ لنا كَأَمسِ الذَّاهِبِ",92,"ب",1,0],["فِي غَمرَةٍ لا تنقضي نَشَواتُها","من صَرْفِ كأْسٍ أَوْ جُفونِ كَعَابِ",93,"ب",1,0],["فيغض طرفا عن مناظر عالم","يلهو به اللاهون بالتقليد",94,"د",1,0],["في غُربتي لهفانُ أس","ألُ عنك كل هوىً غريبِ",95,"ب",1,0],["فيغضب لي حتى أدير رحى وغىً","يكون ديار الناكثين ثفالُها",96,"ل",3,0],["فيُغْني ضَريكاً أخْلفتهُ بُروقُهُ","ويحْمي ط