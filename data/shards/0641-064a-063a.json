ا الله عنها هل يلم خيالها","https://www.aldiwan.net/poem15086.html","الطويل"],[462,"نعمت صباحا ما تغنت حمامة","https://www.aldiwan.net/poem16155.html","الطويل"],[462,"ليهن الرعايا والمناقب والعلى","https://www.aldiwan.net/poem16354.html","الطويل"],[465,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[465,"كم بين اظعان الخليط الزائلِ","https://www.aldiwan.net/poem3603.html","عموديه"],[480,"عارف ما الشعر صاغيه","https://www.aldiwan.net/poem37208.html","مجزوء الرمل"],[480,"يا ثابت الراي في الأعمال تجريها","https://www.aldiwan.net/poem37595.html","البسيط"],[501,"خبط الظلام ولألأ الفجر","https://www.aldiwan.net/poem37558.html","أحذ الكامل"],[515,"لله قوم بأكناف الحمى نزلوا","https://www.aldiwan.net/poem20817.html","البسيط"],[530,"قل لعلي نالا","https://www.aldiwan.net/poem37249.html","مجزوء الرجز"],[539,"يا من تكفل لمن دعاه","https://www.aldiwan.net/poem47447.html","عموديه"],[545,"المتنبي .. كون في ملامح كائن","https://www.aldiwan.net/poem67242.html","عموديه"],[552,"قل لقوم شنوا المعاتب منهم","https://www.aldiwan.net/poem47170.html","الخفيف"],[552,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"],[552,"من أين زرت خيال ذات البرقع","https://www.aldiwan.net/poem47707.html","الكامل"],[552,"يا خليلي ومعيني","https://www.aldiwan.net/poem47735.html","مجزوء الرمل"],[552,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[552,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[552,"من عذيري من سقام","https://www.aldiwan.net/poem48076.html","مجزوء الرمل"],[554,"ذهب في ذهب راح","https://www.aldiwan.net/poem68235.html","مجزوء الرمل"],[563,"تذكر المنحنى فانهل مدمعه","https://www.aldiwan.net/poem52851.html","البسيط"],[568,"أعاذ الله شكواك","https://www.aldiwan.net/poem69565.html","مجزوء الكامل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"يا ساكناً بين جنات وأنهار","https://www.aldiwan.net/poem2784.html","البسيط"],[587,"في غزلي من لحظ ذاك الغزال","https://www.aldiwan.net/poem17690.html","السريع"]],"verses":[["في غِلمَةٍ تَرَكوا قُعودَهُمُ","نَزَعوا وَراءَ اللَيلِ وَاِنحَفَلوا",0,"ل",3,0],["في غُرَّةِ المَجدِ مُذ غُيَّبتُمُ كَلَفٌ","عَلى الزَمانِ وَفي خَدِّ العُلى ضَرَعُ",1,"ع",1,0],["في غَمامٍ بُهَّلٍ أَخلافُها","أَطلَقَ الراعِدُ عَنهُنَّ الصِرارا",2,"ر",2,0],["في غِلمَةٍ هَدَموا ذُرى عَبدِيَّةٍ","أَنضاءِ خَمسٍ لِلنَجاءِ عَمَرَّدِ",3,"د",1,0],["في غِلمَةٍ حَمَلوا القَنا وَتَحَمَّلوا","أَعباءَ يَومِ المَأزِقِ المَشهودِ",4,"د",1,0],["في غِلْمَةٍ مُرْدٍ تَمطّى بهِمْ","إِلى الوَغى جُرْدٌ سَراحيبُ",5,"ب",1,0],["في غِلْمةٍ كَضواري الأُسْدِ أحْنَقَها","رِزُّ العِدا دون غاباتٍ وأحْراجِ",6,"ج",1,0],["في غيْرِ حِفْظِ اللّهِ منْ هامَةٍ","هامَ بِها الشّيطانُ في كُلِّ وادْ",7,"د",1,1],["فيغتدي أنور في عصره","مزدهراً كالوكوب الهادي",8,"د",2,0],["في غَفلَةٍ عَنّا وَفي ضَلالِ","وَنَحنُ قَد زُرناهُ بِالآجالِ",9,"ل",1,0],["فَيَغلُظُ قَلبي ساعَةً ثُمَّ أَنثَني","وَأَقسو عَلَيهِ تارَةً وَأَلينُ",10,"ن",1,0],["في غصونٍ ناعماتٍ","مثل أوصال العَذارِي",11,"ر",2,0],["فيغتدي سُبحةً لفيك ولو","شِئتَ بحقٍّ لكان من لُعَنك",12,"ك",1,0],["في غيرِ عيبٍ يعيبُ مَنزِلتي","وغير ريب يُريبُ إسلامي",13,"م",2,0],["في غَمرَةٍ مِن سَحابِ الآلِ يَرفَعُهُم","يَطفونَ فيها قَليلاً ثُمَّ تَنخَرِقُ",14,"ق",1,0],["في غَيرِ شَيءٍ أَقَلَّ اللَهُ خَيرَهُمُ","ما إِن لَهُم دِمنَةٌ فيهِم وَلا ثُؤَرُ",15,"ر",1,0],["في غُرفَتي مَوقِدٌ صَغيرٌ","لِلَّهِ مِن مَوقِدي الصَغيرِ",16,"ر",1,0],["في غُرفَتي وَالريحُ راكِدَةٌ","بَينَ المَغارِس وَالصَبا تَسري",17,"ر",2,0],["في غابَةٍ تَحكي ذَوائِبَها","في لَونِها وَاللَف وَالنَشرِ",18,"ر",1,0],["في غَفلَةِ العُذّالِ في غَسَقِ الدُجى","إِنَّ السَعادَةَ غَفلَةُ العُذّالِ",19,"ل",1,0],["في غُربةٍ رُوحيَّةٍ مَلْعُونةٍ","أَشواقُها تَقْضي عِطاشاً هِيما",20,"م",2,0],["في غد نستردّه","وهو اليوم مهتضم",21,"م",1,0],["في غَدٍ تَأوي إِلى قَفرٍ حَلِك","يَستَوي الصُعلوكُ فيهِ وَالمَلِك",22,"ك",1,0],["في غَلائِلٍ","سُندُسٍ قُشُب",23,"ب",1,0],["في غِلمَةٍ أَخطَروا أَرواحَهُم وَرَضوا","بِما لَقينَ رِضا الأَيسارِ بِالزَلَمِ",24,"م",1,0],["في غايَةٍ طُلِبَت فَقَصَّرَ دونَها","مَن رامَها فَكَأَنَّها ما تُطلَبُ",25,"ب",1,0],["في غِرارَيهِ وَالذُبابِ بَناتُ الذَر","رِ يَرفُلنَ في نَهيكٍ سَبيكِ",26,"ك",1,0],["في غَيرِ شَأنِكَ بُكرَتي وَأَصيلي","وَسِوى سَبيلِكَ في السُلُوِّ سَبيلي",27,"ل",2,1],["في غُرَفِ الجَنَّةِ العُليا الَّتي جُعِلَت","لَهُم هُناكَ بِسَعيٍ كانَ مَشكورِ",28,"ر",1,0],["في غارةٍ لم تَسقِ ظَمآنَ الثَّرى","عَلَقاً ولم تُغشِ السَماءَ قَساطِلا",29,"ل",2,0],["في غارةٍ لم تَنْثَلِمْ فيها الظُّبا","ضَرْباً ولم تَنْدَ القَنا بخِضابِ",30,"ب",1,0],["فيغيب في أحضانه ثملاً","ويعب من فيض الهوى الدفاق",31,"ق",1,0],["في غُلَّةٍ أَوقَدَت عَلى كَبِدِ ال","سائِلِ ناراً تُعيِي عَلى كَبِدِه",32,"د",2,0],["في غَفلَةٍ مِمَّن نُحاذِرُ قَولَهُ","وَسَوادِ لَيلٍ ذي دَواجٍ مُظلِمِ",33,"م",1,0],["في غَمرةٍ ضَمِنَ الحِفاظُ لِقاحَها","فالحربُ تَسدحُ بالكُماةِ وترْدَحُ",34,"ح",1,0],["في غَدٍ يَنشأ الصِغار فَيبغو","ن تلاداً وَما تَرَكتُم تلادا",35,"د",2,0],["في غَفلَةٍ لا هَمَّ يَعرِفُها","فَطَفِقتُ أَهزِلُ بِالزَمانِ وَجَد",36,"د",1,0],["في غَمرَةٍ كانَت رَحى المَوتِ بِها","تَدورُ وَالصَبرُ لَها مِنّي قُطُب",37,"ب",1,0],["فيَغْدوُ عليها فارسٌ غيرُ دارعٍ","ويَرْدى إليها سابحٌ غيرُ مُلجَم",38,"م",1,0],["في غُرَّةِ الدَهرِ إِذ نُعمانُ ذُو تَبَعٍ","وَإِذ تَرى الناسَ في الأَهواءِ هُمّالا",39,"ل",2,0],["فِي غَمرَةِ المَوتِ نَغشاها وَنَركَبُها","ثُمَتَ تَبدُو كِرامَ الصَبرِ أَبطالا",39,"ل",2,0],["في غير تَأخيرٍ ولا فِرارِ","إلا شديدَ الضَّربِ للكُفّارِ",40,"ر",1,0],["فِي غُرْبَةٍ مَوْصُولَةٍ آلامُهَا","أَنْضَتْهُ فِي الرَّحَلاَتِ وَالأَسْفَارِ",41,"ر",1,0],["فَيَغْتَدي أَنْوَرُ في عَصْره","مزْدَهراً كالكوْكب الهَادي",42,"د",2,0],["فِي غَيْهَبٍ أَبْيَضَ لَمَّا","عٍ بِهَا مُنَزَّلِ",43,"ل",1,0],["فِي غَادَةٍ آدَابُهَا","مِنَ الطِّرَازِ الأوَّلِ",43,"ل",1,0],["فِي غرْبةٍ كَالقَفْرِ لَمْ يُلمِمْ بِهِ","سَكَنٌ هُنَاكَ وَلَمْ يَعُدْهُ العُوَّدُ",44,"د",1,0],["فِي غادَةٍ لَمْ تُطالِعْهَا وَقدْ سَمَحَتْ","عَيْنُ الْعِنايَةِ إِلاَّ أَعْينُ الْفِكَرِ",45,"ر",1,0],["فِي غِبْطَةٍ تَصْفُو وَبِالْغَيْرِ","المُلِمَّةِ لاَ تُثَابْ",46,"ب",1,0],["فَيَغفِرُ اللَهَ ذَنباً","أَبدَأتُهُ وَأَعَدتُه",47,"ت",2,0],["فيغير ، يطعن ، أو يجوز فلانة","وفلانة بشريعة الأسياف",48,"ف",1,0],["فيغتلي خلف ذبولي فتى","ويجتدي شيخ ، ويبكي رضيع",49,"ع",1,0],["فِي غِرَارَيْهِ والذُّبَابِ بَنَاتُ الذَّرِّ ،","يَرْفُلْنَ فِي نَهِيكٍ سَبِيكِ",50,"ك",1,0],["في غربة أنا والإباء المرّ والأدب اللباب","كالسيف حلّته الفتوح وربّما بلي القراب",51,"ب",1,0],["فَيَغْتَرُّ عَنْ حَزْمٍ وَيَسخُو عَلَى بُخلِ","حَوَى سِيَراً مِنْ كُلِّ ضَرْبٍ فُؤَادُهَا",52,"ه",2,0],["فَيَغْبُرَ حَوْلَهُ نَعَمٌ وشَاءُ","فيبني مجدهم ويقيم فيها",53,"ا",1,0],["في غير وادي الشتا في غير أربعه","ما تورف الظل للأشواق أفياء",54,"ا",2,0],["فيُغمِضُ اذ يَرى الأرواحَ","أَسرى والوَرى رَهنا",55,"ن",2,0],["في غُرفَةٍ مُستَبَانَاتٍ بِهَا فُرشٌ","مَرفُوعَةٌ مِن سَمَاهَا قَد سَمَا لِسَمَا",56,"م",2,0],["في غير ليلى لا يروقُ لمغرمٍ","غزلٌ ولا يستحسنُ التشبيبُ",57,"ب",1,0],["في غير خطبك ليس تُسكب عَبرةٌ","إذ كلّ شيء بَعد فقدكَ هيِّنُ",58,"ن",1,0],["فَيُغضي لِعَبدٍ بِالهُدى مُتَمَسِّكٍ","وَيَسطو إِذا الخِذلانُ لَجَّ بِمُشرِكٍ",59,"ك",1,0],["فيُغيرُ في الظّلماءِ غيرَ منبِّهٍ","جيشَ العدوِّ بأنْ يُحَمْحِمَ صاهِلا",60,"ل",2,0],["فيُغِنى خَطُّه يوم العَطايا","ويُفنى سيفُه يومَ الضِّراب",61,"ب",1,0],["فيغضب مغوار ويعبس فاتك","ويفزع موتور إلى سفه الشر",62,"ر",1,0],["فَيَغمُرُهُ بِبَخورِ الحَنانِ","وَيَسمَحُهُ بِزُيوتِ الكِبَر",63,"ر",1,0],["في غِشاءٍ يشفُّ عَن بَعضِ روحٍ","لَيسَ فيهِ لِلأُمِّ بَعضُ رجاءِ",64,"ا",2,0],["في غَنجِ عَينَيهِ وَفي ناظِري","سِحرٌ حَلالٌ وَرُقادٌ حَرام",65,"م",1,0],["في غَيرِ مَوسِمِها وَقَد ذَهَبَت","أَيّامُها وَالدَهرُ ذو دُوَلِ",66,"ل",1,0],["في غِمدِها وَشَكيمِها","مِنها الجَداوِلُ وَالهِضابُ",67,"ب",1,0],["في غَيرِ ما يَزكو بِهِ ال","أَحسابُ لَيسَ لَهُم حِسابُ",67,"ب",1,0],["في غار ثور ثاني اثنين اختفى","وكأنما الأعداءُ دونهما عموا",68,"م",3,0],["في غاية الحسن والدماثة وال","نعمة والظرف والجمال معاً",69,"ع",2,0],["في غصنِ قامتِها ما شئتُ من ثمرٍ","فليتَ قلبي على الأثمارِ عصفور",70,"ر",1,0],["في غفلةٍ كنا فنبَّهنا","طيبٌ تنشَّقناه من فيك",71,"ك",1,0],["فيُغنيكِ طيبُ الذّكرِ عن حُسن صُورتي","وهل دائمٌ عندَ النساءِ هوى خلِّ",72,"ل",1,0],["في غارةِ عربيةٍ تُمحى بها","آثارُ حكم الرومِ والمنغول",73,"ل",1,0],["فيغدو الشرقُ حراً مستقلاً","فتجمعُهُ خلافةُ هاشمي",74,"ي",1,0],["في غَيْرِهِ يَقَعُ الخِلافُ ضَرُورَةً","وعَلَيْهِ حَقّاً يَلْتَقِي الأَصْفَاقُ",75,"ق",1,0],["في غدٍ يذكرُ الهوى","ويطيلُ التلَهَّفا",76,"ف",2,0],["في غرفة اريجها عاطر","يزري بريح الورد والنرجس",77,"س",1,0],["في غِشاءيْنِ أَصفَريْنِ صَقيلَيْ","نِ يقولُ المُشاهِدُ المُسْتَبِين",78,"ن",1,0],["فيَغْدو به مُشرِقاً ناظرٌ","بِبْشرٍ مُقارِنِ بِرٍّ عَميم",79,"م",1,0],["في غِلمةٍ لَفُّوا نَواصيَ خَيلِهم","شُعْثاً بأطرافِ الوَشيج الذُّبَّل",80,"ل",1,0],["في غلْمةٍ ذرعَتْ بهم عَرْضَ الفَلا","هُوجٌ تَلُفُّ تَهائماً بنُجود",81,"د",1,0],["في غَيرِ وقتِ الدَّمع ضيَّعته","قلتُ فقَلبي عندَكم أضيَعُ",82,"ع",1,0],["في غَضَبِ الفهدِ الوثوب يقتدى","بعد ثلاثٍ طاوياً لم يَصطَدِ",83,"د",1,0],["في غَير نَظرة وَامق","عِندَ اللُقا لا يَطمَعُ",84,"ع",1,0],["فَيَغيب سُكراً مِن تَأَم","ل بَل يَذوب تَلهفا",85,"ف",2,0],["فَيَغوص فِكري في دُموعي غَوصة","يَستَخرج الدُرّ الجُمان لِوَصفِهِ",86,"ف",2,0],["في غزة الأبطال خطوي مسرع","أملاً، وخَطْوُ مواجعي متثاقلُ",87,"ل",1,0],["في غور إطراءٍ عديم تناهي","أبدعْتُ في مدحي وأعلى من مَدَحْ",88,"ح",1,0],["فَيُغبَفنَ أَحلاباً وَيُصبَحنَ مِثلَها","فَهُنَّ مِنَ التَعداءِ قُبٌّ شَوازِبُ",89,"ب",1,0],["في غمرةٍ أَعْيا الحِمامَ طريقُها","ففتحتَ فِيهِ للقنا حَتَّى سَلَكْ",90,"ك",1,0],["فِي غَوْلِ ذي لُجَجٍ لَبِسْنَ دياجياً","تركَ الحياةَ لنا كَأَمسِ الذَّاهِبِ",91,"ب",1,0],["فِي غَمرَةٍ لا تنقضي نَشَواتُها","من صَرْفِ كأْسٍ أَوْ جُفونِ كَعَابِ",92,"ب",1,0],["فيغض طرفا عن مناظر عالم","يلهو به اللاهون بالتقليد",93,"د",1,0],["فَيُغبَقنَ أَحلاباً وَيُصبَحنَ مِثلَها","فَهُنَّ مِنَ التَعداءِ قُبٌّ شَوازِبُ",94,"ب",1,0],["في غُربتي لهفانُ أس","ألُ عنك كل هوىً غريبِ",95,"ب",1,0],["فيغضب لي حتى أدير رحى وغىً","يكون ديار الناكثين ثفالُها",96,"ل",3,0],["فيُغْني ضَريكاً أخْلفتهُ بُروقُهُ","ويحْمي طريداً أسْلمتْهُ العشائر",97,"ر",1,0],["فيُغضي عن العوْراء غيرَ مُعق