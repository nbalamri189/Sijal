0575.html","البسيط"],[45,"عارضننا أصلا فقلنا الربرب","https://www.aldiwan.net/poem10644.html","الكامل"],[45,"يائبنة الدهر هل رأيت كمثلي","https://www.aldiwan.net/poem65532.html","الخفيف"],[45,"في غير شأنك بكرتي وأصيلي","https://www.aldiwan.net/poem65605.html","الكامل"],[28,"فأنت إذ لم تكن إياه صاحبه","https://www.aldiwan.net/poem5082.html","البسيط"],[61,"وهي الشموس فإن رأين طوالعا","https://www.aldiwan.net/poem51459.html","الكامل"],[61,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[97,"فجر جديد حالم خفاق","https://www.aldiwan.net/poem24596.html","الكامل"],[44,"ما لكثيب الحمى إلى عقده","https://www.aldiwan.net/poem30552.html","المنسرح"],[31,"من عاشق كلف الفؤاد متيم","https://www.aldiwan.net/poem41822.html","الكامل"],[105,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[102,"يا سراة البلاد يكفي البلادا","https://www.aldiwan.net/poem33129.html","الخفيف"],[52,"ما بالمنازل لو سألت أحد","https://www.aldiwan.net/poem27074.html","الكامل"],[52,"رأيت فيها برقها لما وثب","https://www.aldiwan.net/poem27297.html","الرجز"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[8,"إما تري ظلل الأيام قد حسرت","https://www.aldiwan.net/poem21815.html","البسيط"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54739","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55172","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54761","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54866","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54638","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43667","المجتث"],[100,"فارس الاصطياف","https://www.poetsgate.com/ViewPoem.aspx?id=50417",""],[45,"يَا ابْنَةَ الدَّهرِ ،هَلْ رَأَيْتِ كَمِثْلِي","https://www.poetsgate.com/ViewPoem.aspx?id=32156",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[22,"ولما كنتُ جَارَهُمُ حَبَوْنِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18438&r=&rc=10",""]],"verses":[["في غِلمَةٍ تَرَكوا قُعودَهُمُ","نَزَعوا وَراءَ اللَيلِ وَاِنحَفَلوا",0,"ل",3,0],["في غُرَّةِ المَجدِ مُذ غُيَّبتُمُ كَلَفٌ","عَلى الزَمانِ وَفي خَدِّ العُلى ضَرَعُ",1,"ع",1,0],["في غَمامٍ بُهَّلٍ أَخلافُها","أَطلَقَ الراعِدُ عَنهُنَّ الصِرارا",2,"ر",2,0],["في غِلمَةٍ هَدَموا ذُرى عَبدِيَّةٍ","أَنضاءِ خَمسٍ لِلنَجاءِ عَمَرَّدِ",3,"د",1,0],["في غِلمَةٍ حَمَلوا القَنا وَتَحَمَّلوا","أَعباءَ يَومِ المَأزِقِ المَشهودِ",4,"د",1,0],["في غِلْمَةٍ مُرْدٍ تَمطّى بهِمْ","إِلى الوَغى جُرْدٌ سَراحيبُ",5,"ب",1,0],["في غِلْمةٍ كَضواري الأُسْدِ أحْنَقَها","رِزُّ العِدا دون غاباتٍ وأحْراجِ",6,"ج",1,0],["في غيْرِ حِفْظِ اللّهِ منْ هامَةٍ","هامَ بِها الشّيطانُ في كُلِّ وادْ",7,"د",1,1],["فيغتدي أنور في عصره","مزدهراً كالوكوب الهادي",8,"د",2,0],["في غَفلَةٍ عَنّا وَفي ضَلالِ","وَنَحنُ قَد زُرناهُ بِالآجالِ",9,"ل",1,0],["فَيَغلُظُ قَلبي ساعَةً ثُمَّ أَنثَني","وَأَقسو عَلَيهِ تارَةً وَأَلينُ",10,"ن",1,0],["في غصونٍ ناعماتٍ","مثل أوصال العَذارِي",11,"ر",2,0],["فيغتدي سُبحةً لفيك ولو","شِئتَ بحقٍّ لكان من لُعَنك",12,"ك",1,0],["في غيرِ عيبٍ يعيبُ مَنزِلتي","وغير ريب يُريبُ إسلامي",13,"م",2,0],["في غَمرَةٍ مِن سَحابِ الآلِ يَرفَعُهُم","يَطفونَ فيها قَليلاً ثُمَّ تَنخَرِقُ",14,"ق",1,0],["في غَيرِ شَيءٍ أَقَلَّ اللَهُ خَيرَهُمُ","ما إِن لَهُم دِمنَةٌ فيهِم وَلا ثُؤَرُ",15,"ر",1,0],["في غُرفَتي مَوقِدٌ صَغيرٌ","لِلَّهِ مِن مَوقِدي الصَغيرِ",16,"ر",1,0],["في غُرفَتي وَالريحُ راكِدَةٌ","بَينَ المَغارِس وَالصَبا تَسري",17,"ي",1,0],["في غابَةٍ تَحكي ذَوائِبَها","في لَونِها وَاللَف وَالنَشرِ",18,"ر",1,0],["في غَفلَةِ العُذّالِ في غَسَقِ الدُجى","إِنَّ السَعادَةَ غَفلَةُ العُذّالِ",19,"ل",1,0],["في غُربةٍ رُوحيَّةٍ مَلْعُونةٍ","أَشواقُها تَقْضي عِطاشاً هِيما",20,"م",2,0],["في غد نستردّه","وهو اليوم مهتضم",21,"م",1,0],["في غَدٍ تَأوي إِلى قَفرٍ حَلِك","يَستَوي الصُعلوكُ فيهِ وَالمَلِك",22,"ك",1,0],["في غَلائِلٍ","سُندُسٍ قُشُب",23,"ب",1,0],["في غِلمَةٍ أَخطَروا أَرواحَهُم وَرَضوا","بِما لَقينَ رِضا الأَيسارِ بِالزَلَمِ",24,"م",1,0],["في غايَةٍ طُلِبَت فَقَصَّرَ دونَها","مَن رامَها فَكَأَنَّها ما تُطلَبُ",25,"ب",1,0],["في غِرارَيهِ وَالذُبابِ بَناتُ الذَر","رِ يَرفُلنَ في نَهيكٍ سَبيكِ",26,"ك",1,0],["في غَيرِ شَأنِكَ بُكرَتي وَأَصيلي","وَسِوى سَبيلِكَ في السُلُوِّ سَبيلي",27,"ل",2,1],["في غُرَفِ الجَنَّةِ العُليا الَّتي جُعِلَت","لَهُم هُناكَ بِسَعيٍ كانَ مَشكورِ",28,"ر",1,0],["في غارةٍ لم تَسقِ ظَمآنَ الثَّرى","عَلَقاً ولم تُغشِ السَماءَ قَساطِلا",29,"ل",2,0],["في غارةٍ لم تَنْثَلِمْ فيها الظُّبا","ضَرْباً ولم تَنْدَ القَنا بخِضابِ",30,"ب",1,0],["فيغيب في أحضانه ثملاً","ويعب من فيض الهوى الدفاق",31,"ق",1,0],["في غُلَّةٍ أَوقَدَت عَلى كَبِدِ ال","سائِلِ ناراً تُعيِي عَلى كَبِدِه",32,"د",2,0],["في غَفلَةٍ مِمَّن نُحاذِرُ قَولَهُ","وَسَوادِ لَيلٍ ذي دَواجٍ مُظلِمِ",33,"م",1,0],["في غَمرةٍ ضَمِنَ الحِفاظُ لِقاحَها","فالحربُ تَسدحُ بالكُماةِ وترْدَحُ",34,"ح",1,0],["في غَدٍ يَنشأ الصِغار فَيبغو","ن تلاداً وَما تَرَكتُم تلادا",35,"د",2,0],["في غَفلَةٍ لا هَمَّ يَعرِفُها","فَطَفِقتُ أَهزِلُ بِالزَمانِ وَجَد",36,"د",1,0],["في غَمرَةٍ كانَت رَحى المَوتِ بِها","تَدورُ وَالصَبرُ لَها مِنّي قُطُب",37,"ب",1,0],["فيَغْدوُ عليها فارسٌ غيرُ دارعٍ","ويَرْدى إليها سابحٌ غيرُ مُلجَم",38,"م",1,0],["في غُرَّةِ الدَهرِ إِذ نُعمانُ ذُو تَبَعٍ","وَإِذ تَرى الناسَ في الأَهواءِ هُمّالا",39,"ل",2,0],["فِي غَمرَةِ المَوتِ نَغشاها وَنَركَبُها","ثُمَتَ تَبدُو كِرامَ الصَبرِ أَبطالا",39,"ل",2,0],["في غير تَأخيرٍ ولا فِرارِ","إلا شديدَ الضَّربِ للكُفّارِ",40,"ر",1,0],["فِي غُرْبَةٍ مَوْصُولَةٍ آلامُهَا","أَنْضَتْهُ فِي الرَّحَلاَتِ وَالأَسْفَارِ",41,"ر",1,0],["فَيَغْتَدي أَنْوَرُ في عَصْره","مزْدَهراً كالكوْكب الهَادي",42,"د",2,0],["فِي غَيْهَبٍ أَبْيَضَ لَمَّا","عٍ بِهَا مُنَزَّلِ",43,"ل",1,0],["فِي غَادَةٍ آدَابُهَا","مِنَ الطِّرَازِ الأوَّلِ",43,"ل",1,0],["فِي غرْبةٍ كَالقَفْرِ لَمْ يُلمِمْ بِهِ","سَكَنٌ هُنَاكَ وَلَمْ يَعُدْهُ العُوَّدُ",44,"د",1,0],["فِي غادَةٍ لَمْ تُطالِعْهَا وَقدْ سَمَحَتْ","عَيْنُ الْعِنايَةِ إِلاَّ أَعْينُ الْفِكَرِ",45,"ر",1,0],["فِي غِبْطَةٍ تَصْفُو وَبِالْغَيْرِ","المُلِمَّةِ لاَ تُثَابْ",46,"ب",1,0],["فَيَغفِرُ اللَهَ ذَنباً","أَبدَأتُهُ وَأَعَدتُه",47,"ت",2,0],["فيغير ، يطعن ، أو يجوز فلانة","وفلانة بشريعة الأسياف",48,"ف",1,0],["فِي غِرَارَيْهِ والذُّبَابِ بَنَاتُ الذَّرِّ ،","يَرْفُلْنَ فِي نَهِيكٍ سَبِيكِ",49,"ك",1,0],["فَيَغْتَرُّ عَنْ حَزْمٍ وَيَسخُو عَلَى بُخلِ","حَوَى سِيَراً مِنْ كُلِّ ضَرْبٍ فُؤَادُهَا",50,"ه",2,0],["فَيَغْبُرَ حَوْلَهُ نَعَمٌ وشَاءُ","فيبني مجدهم ويقيم فيها",51,"ا",1,0]]}