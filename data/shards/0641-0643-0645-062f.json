{"poems":[[55,"ترى نوب الأيام ترجي صعابها","https://www.aldiwan.net/poem30759.html","الطويل"],[79,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[79,"أهاجتك ذكرى من خليط ومعهد","https://www.aldiwan.net/poem36601.html","الطويل"],[95,"هو العيش جهد طائل وفتون","https://www.aldiwan.net/poem11186.html","الطويل"],[31,"ما لعياض جب خصييه مسحت","https://www.aldiwan.net/poem6195.html","الطويل"],[93,"ألا نبي لو طبعنا الشمس يوما","https://www.aldiwan.net/poem8791.html","عموديه"],[91,"أعاشر قوما عندهم لي عداوة","https://www.aldiwan.net/poem45081.html","الطويل"],[64,"أهاب به داعي الهوى فأجابا","https://www.aldiwan.net/poem52502.html","الطويل"],[54,"ألا ما لقلب لا تقضى حوائجه","https://www.aldiwan.net/poem27179.html","الطويل"],[48,"يا ساهر البرق أيقظ راقد السمر","https://www.aldiwan.net/poem23634.html","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43778","المنسرح"],[31,"هوى أُمِّ بِشْرٍ أنْ تراني بغِبْطَة","https://www.poetsgate.com/ViewPoem.aspx?id=12229",""],[93,"إلى الفاتح ..","https://www.poetsgate.com/ViewPoem.aspx?id=52999",""],[136,"دعا للبين من أسماء داع","https://www.aldiwan.net/poem54804.html","الوافر"],[240,"عسى مر أنفاس النسيم المردد","https://www.aldiwan.net/poem32103.html","الطويل"],[275,"تذكرت ما أبلى الزمان وما غير","https://www.aldiwan.net/poem35628.html","الطويل"],[275,"سأتبع ظل الموت بين الكتائب","https://www.aldiwan.net/poem35630.html","الطويل"],[284,"أيحسن بعد ضنك حسن ظني","https://www.aldiwan.net/poem2631.html","الوافر"],[358,"أصاحي ما لطير العز صاحا","https://www.aldiwan.net/poem40543.html","الوافر"],[371,"لكل مودة أجر وأجري","https://www.aldiwan.net/poem17316.html","الوافر"],[411,"فكم دقت وشقت واسترقت","https://www.aldiwan.net/poem49498.html","الوافر"],[487,"بكعبة أنوار أنخت مطيتي","https://www.aldiwan.net/poem24323.html","عموديه"],[520,"حسبت الدهر في ولدي","https://www.aldiwan.net/poem12294.html","الهزج"],[534,"إذا رضي الرحمن عني فكل من","https://www.aldiwan.net/poem37132.html","الوافر"],[556,"أراعك ما راعني من ردى","https://www.aldiwan.net/poem48121.html","المتقارب"],[564,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"],[674,"","https://poetry.dctabudhabi.ae/diwan/poem/145910","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48734","البسيط"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96579","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71038","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89536","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53086","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27877","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100264","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200024","الوافر"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130095","الطويل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121783","المتقارب"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68128","الوافر"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112301","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48442","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86276","الطويل"],[3962,"","https://poetry.dctabudhabi.ae/diwan/poem/131905","الطويل"],[4004,"","https://poetry.dctabudhabi.ae/diwan/poem/111321","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102756","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83637","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83197","الرجز"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104513","الهزج"],[4621,"","https://poetry.dctabudhabi.ae/diwan/poem/97650","المتقارب"],[4679,"يجد الفتى كما يعيش مُخلَّدَا","https://www.poetsgate.com/ViewPoem.aspx?id=142735",""],[4679,"بذكراك لا ذكرى حبيبٍ ومنزلِ","https://www.poetsgate.com/ViewPoem.aspx?id=142719",""],[592,"أهاجك أم أشجاك رسم المعاهد","https://www.poetsgate.com/ViewPoem.aspx?id=128839",""],[5376,"لنا في الشامِ أشواقٌ وعشقُ","https://www.poetsgate.com/ViewPoem.aspx?id=188345",""],[5655,"عُوجا علي أرضهم غداً ولِجا","https://www.poetsgate.com/ViewPoem.aspx?id=107217",""],[5704,"المذاهب الاربعه...","https://www.poetsgate.com/ViewPoem.aspx?id=200005",""],[5725,"عشق صوفي","https://www.poetsgate.com/ViewPoem.aspx?id=186860",""],[5744,"فَخرُ أُنثى","https://www.poetsgate.com/ViewPoem.aspx?id=207278",""],[6024,"مية","https://www.poetsgate.com/ViewPoem.aspx?id=186352",""],[6152,"سيدة القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=203012",""]],"verses":[["فَكَم دَعوَةٍ أَرسَلتُها عِندَ كُربَةٍ","إِلَيهِ فَكانَ الطولُ مِنهُ جَوابَها",0,"ب",3,0],["فَكَمْ دَعْوَةٍ أَوْلاَكَ عِنْدَ انْتِقَالِهِ","إِلَى الْعَالَمِ الْبَاقِي مِنَ الْعَالَمِ الْفَانِي",1,"ن",2,0],["فكَمْ دونَهُمْ منْ مَهْمَةٍ ومَفازَةٍ","وأثْباجِ بحْرٍ زاخِرِ اللُّجِّ مُزْبِدِ",2,"د",1,0],["فَكَمْ دَارِفٍ دَمْعاً وَكَمْ صَافِقٍ أَسًى","كَمَا يُصْفِقُ الارَاهَ وَهْوَ غَبِينُ",3,"ن",1,0],["فَكَم دَنَّسا مِن فَرجِ بَيضاءَ حُرَّةٍ","كَأَنَّهُما خَلفَ اِستِها جُعَلانِ",4,"ن",1,0],["فَكَم داوَيتَ سورِيّاً مَريضاً","وَكَم أَسقَمتَ تُركِيّاً صَحيحا",5,"ح",2,0],["فكم دُبِّرت منهم عليَّ سعاية","وكم زُوِّرت منهم عليّ شهادات",6,"ت",1,0],["فكم دونَ ذاك البرق من متجلِّدٍ","يُكاتمُ أسرارَ الغَرامِ صحَابَا",7,"ب",2,0],["فَكَم دَمعَةٍ تَعصي الجُفونَ غَزيرَةٍ","وَكَم نَفَسٍ كَالجَمرِ تَدمى مَخارِجُه",8,"ج",2,0],["فكم دِلاصٍ على البطحاء ساقطةٍ","وكم جُمانٍ مع الحَصْباءِ مُنْتَثِرِ",9,"ر",1,0],["فَكَم دَعا آسِياً أَبوكَ لَهُ","وَكَم رَقى لَو شَفى وَكَم نَشغا",10,"غ",2,0],["فكمْ دونها من ملعبٍ ومفازة","تظلّ بها الورقُ الخفافُ تقلب",11,"ب",1,0],["فكم داويت سوريّا مريضا","وكم أسقيت تركيا صحيحا",12,"ح",2,0],["فَكَم دَفَعُوا الأعَادِى عَن حِمَاهُم","بِصَولاَتِ المَدَافِعِ واليَرَاعِ",13,"ع",1,0],["فَكَم دونَ ذاكَ الجِزعِ مِن مُغرَمِ الحَشا","إِذا عَنَّ ذِكرى موجَعِ القَلبِ مُكمَدِ",14,"د",1,0],["فكم دهشة أو صبوةٍ منهُ للفتى","إذا قلبَه والعينَ دَحرجَ أو دَهور",15,"ر",1,0],["فكم ديّنٍ يزني ويقتلُ سارقاً","ولا يختَشي سُخطَ الإلهِ المحاسب",16,"ب",1,0],["فكم دمعٍ حَمَلْتُ عليه عيني","وكم نَدَمٍ قَرَعْتُ عليه سِنّي",17,"ن",2,0],["فَكَم داوَيت مِن مُهج سقاما","وَكَم واسيت مِن كَبد جِراحا",18,"ح",2,0],["فَكَم دارَت عَلَيَّ كُئوسُ هَمٍّ","كَما دارَت عَلَيَّ كُئوسُ خَمرِ",19,"ر",1,0],["فكَمْ دَقَّتْ وشَقَّتْ واستَرقَّتْ","فُضولُ العَيشِ أعناقَ الرِّجالِ",20,"ل",1,1],["فكم دهمتنا النائبات فصرنا في","زوايا خطوب لا تسام بلفتتي",21,"ت",2,0],["فكم دهري يعاندني","ويفضحني ويثكلني",22,"ن",2,0],["فكَمْ دَارَيْتُ فَدْماً بَعْدَ فَدْمٍ","وأَرْخَيْتُ الْعِنانَ لَمنْ عَناني",23,"ن",2,0],["فَكَم دافَعوه فَفات الدفاعُ","وَكَم قَد رَقَوْه فَأَعيا الرُّقى",24,"ا",1,0],["فكم دونَه من فِتْنةٍ وبليَّةٍ","وكم مَهْمهٍ من قبْل ذلك قد جُبْنا",25,"ن",2,0],["فكم دارس أحياه من أربع التقا","وكم غاسق من حندس الليل أحياه",26,"ا",2,0],["فكم دعوا ولهم إيقان مصطبر","فأصبحوا ولهم إيقان منتظر",27,"ر",1,0],["فكم دون جدوى من فلاة كأَنها","إِذا ضربتها الريحُ سحقُ مُهَلهَلِ",28,"ل",1,0],["فكم دعوةٍ لي وابتهالٍ بِنِيَّةٍ","صَفَتْ فَهْيَ تحكي في الصفاءِ صَفائي",29,"ا",2,0],["فَكَم دَوَّخَ الأَعداء شَرقاً وَمَغرِباً","وَداسَ حِماهُم بِالعِتاقِ الصَلادِم",30,"م",1,0],["فكم دنت غصونه لمجتنٍ","وما ونت يمينه عن مجتدي",31,"د",2,0],["فكم دعوتكَ يا عيني ولم تجبْ","خابتْ سهامُ دعائي فيك لم تصبِ",32,"ب",1,1],["فكم دمع يمر عليك دمعا","وكم وجد يثير عليك وجدا",33,"د",2,0],["فكم دخل الهراء برغم سمعي","بأذني دون إذن أو سلام",34,"م",1,0],["فكم دار علمٍ أثمرت حين زُرتَها","وكم فاز إذ شَرّفت مغناه معهدُ",35,"د",1,0],["فكم دَارِعٍ صادَه في الوغَى","كأن الدُّرُوعَ عليه شِباكُ",36,"ك",1,0],["فكم دهرٍ بِهِ طال اغتِرابي","أُطاردُ فِيهِ أبطالَ الذُّبابِ",37,"ب",1,1],["فَكَم دولَةٍ شدنا وسُدنا بِهمّةٍ","أحَدّ مِنَ البِيضِ الرّقاقِ مضارِبَا",38,"ب",2,0],["فكمْ دعوة منهُمْ لعُلياكَ أُخْلِصَتْ","وما كان يُلْفَى خائباً مُسْتَجابُها",39,"ب",3,0],["فَكَم دَوَّخت ارضاً لاعدائِنا وَكَم","لَها شَهِدَت يَومَ الوَغى البيض وَالسُمرِ",40,"ر",1,0],["فكم دمعة أسبلتها من توله","وكم زفرة نهّضتُها من لظى الحب",41,"ب",1,0],["فكم داعبتني غلمة لست أرتجي","بها غير درك الثار والأخذ بالدم",42,"م",1,1],["فكم دوّ خبت مع هضاب قطعنها","يبيت بها السرحان ظمآن طاويا",43,"ي",2,0],["فَكَم دَحتِ الأَيّامُ أَرباب دَولَةٍ","قَضوا وَمَضوا في الدَهر هُم وَصعالِكُه",44,"ك",2,0],["فَكَم دَنَوتُ وَهوَ عَنّى يَنفِرُ","وَكَم أَفي وَهوَ بِعَهدي يَغدرُ",45,"ر",1,0],["فكم دنياً رأينا منك","في الأيام معموره",46,"ه",1,0],["فكم دعة أتعبت أهلها","وكم راحة نتجت من تعب",47,"ب",1,0],["فكم دكَّ طوداً للمطامع شامخاً","وقوّض صرحاً للهناء مشّيدا",48,"د",2,0],["فكم دولةٍ فدعا صرته فأدبرت","وظل على رغم النوائب يعتلي",49,"ل",2,0],["فكم دون نهوى من البيد والفلا","وهيهات كم بين اليمامة والهند",50,"د",1,0],["فكم دانت لها دول ودالت","لها في عرشِها غربٌ وشرقُ",51,"ق",1,0],["فكم دخيلٍ بغيرِ معرفةٍ","غير عليمٍ بأنَّهُ خَرَجا",52,"ج",2,0],["فكم دلَّتْ مضلًّا بعد زيغٍ","وأوضحت الطريق إلى المعالي",53,"ل",2,0],["فكم دارت بقمراءٍ كؤوسا","لجيناً مثل بارقة اللآلي",54,"ل",2,0],["فكمْ داوى عليلَ الرُّوحِ حَرْفي","وكمْ صَدَحَتْ بأشْعاري القِيانُ",55,"ن",1,0],["فكم دون مية من فدفد","وكم دون مية من فيلق",56,"ق",1,0],["فكم دانت لإحساسي القوافي","وكم فاحت بأوصافي عطورا",57,"ر",2,0]]}