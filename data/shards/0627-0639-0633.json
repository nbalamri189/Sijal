{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54867","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56129","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144126","السريع"],[3511,"","https://poetry.dctabudhabi.ae/diwan/poem/202632","الخفيف"],[6056,"طري العود","https://www.poetsgate.com/ViewPoem.aspx?id=130346",""],[6056,"منثور الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=130519",""]],"verses":[["أَعُسْر بمَنْ يَهْوَى وَأَنْتَ لَهُ الْغِنَى","إِذَنْ فَثَرَاءُ الْعَالَمينَ هُوَ الْفَقرُ",0,"ر",1,0],["اعساك تجهل غيرة الشعراء عن","د سماعهم تأليف شعر ملحنِ",1,"ن",1,0],["أعسرُ من رزقي ومن قصّتي","معْ سيّدي الشيخ أبي الفضل",2,"ل",1,0],["ا عَسى أَن يُريدَ منّي العَذولُ","وفُؤادي مُتَيَّمٌ متبولُ",3,"ل",1,1],["أعسف القاف والمعنى بكيفي آمره وأنهاه","أطوّع نايفات القيل وهذا في الشعر مبداي",4,"ا",2,0],["أعسف القاف وأبحربه أساير معظم الأذواق","وأروّض نايفات القيل وأفصح عن عباراته",5,"ت",2,0]]}