{"poems":[[88,"لله آثار هناك كريمة","https://www.aldiwan.net/poem10679.html","الكامل"],[88,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[29,"سقيا لنهي حمامة وحفير","https://www.aldiwan.net/poem5737.html","الكامل"],[53,"تبارك الله خالق الكرم البارع","https://www.aldiwan.net/poem65517.html","المنسرح"],[80,"غربان أغمات لا تعدمن طيبة","https://www.aldiwan.net/poem14231.html","البسيط"],[87,"ماذا رجوت من الحفاوة عنده","https://www.aldiwan.net/poem7529.html","الكامل"],[87,"يا أيها الدمع الوفي بدار","https://www.aldiwan.net/poem62872.html","الكامل"],[47,"يا أحمد بن أبي دؤاد","https://www.aldiwan.net/poem63542.html","مجزوء الكامل"],[107,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[107,"إن جل غنم المسلمين بخيبر","https://www.aldiwan.net/poem44059.html","الكامل"],[7,"ماذا رزئنا به من حية ذكر","https://www.aldiwan.net/poem1974.html","البسيط"],[111,"تلك البوارق حاديهن مرنان","https://www.poetsgate.com/ViewPoem.aspx?id=100",""],[201,"ولهان ذو خافق رقت حواشيه","https://www.aldiwan.net/poem39877.html","البسيط"],[274,"لما رأيت البز والشاره","https://www.aldiwan.net/poem26749.html","الرجز"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[376,"إن مس مسقمتي من طرفها سقم","https://www.aldiwan.net/poem57123.html","الكامل"],[473,"ماذا رميت به من","https://www.aldiwan.net/poem59755.html","المجتث"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48690","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77669","الرجز"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133811","الرجز"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130816",""],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65961","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201992","البسيط"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32373","البسيط"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86571","الكامل"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[5121,"نُزْهَة","https://www.poetsgate.com/ViewPoem.aspx?id=49545",""],[5183,"ذكرى الأخوة","https://www.poetsgate.com/ViewPoem.aspx?id=180230",""],[5351,"حسناً سأحدث","https://www.poetsgate.com/ViewPoem.aspx?id=202715",""],[5595,"ماذا رويتَ أبا زهراء .... ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=144532",""]],"verses":[["ماذا رَأَيتُ مِنَ النَبالَةِ وَالعُلا","في عُدمِهِنَّ وَكُلُّهُنَّ عُيونُ",0,"ن",1,0],["ماذا رأيتَ بباب الشامِ حين رَأوْا","أنْ يُلبِسُوكَ مِن الأثوابِ زاهيها",1,"ي",3,0],["ماذا رَجَوتَ مِنَ العُلالَةِ بَعدَما","نُقِضَت حِبالُكَ وَاِستَمَرَّ مَريري",2,"ر",2,0],["ماذا رعيناه في جناب فتى","كالبدر يجلو غواشي الغسقِ",3,"ق",1,0],["ماذا رمتكَ بِهِ الأَيّامُ يا كبِدِي","مِن نَبلهِنَّ وَلا رامٍ سِوى القَدَرِ",4,"ر",1,0],["ماذا رجوت من الحفاوة عنده","يا بائع القرآن بالإنجيل",5,"ل",1,1],["ماذا رَأَيتَ مِنَ الحِجابِ وَعُسرِهِ","فَدَعَوتَنا لِتَرَفُّقٍ وَيَسارِ",6,"ر",1,0],["ماذا رَأَيتَ إِذا اِنتَسَب","تَ إِلى إِيادٍ في إِيادِ",7,"د",1,0],["ماذا رَأَيتِ مِنَ البَواسِلِ إِذ دَعا","داعي العَوانِ فَطارَ كُلُّ جَنانِ",8,"ن",1,0],["ماذا رَأيتِ من الذي أبغضتِهِ","ونَقمتِ ما يَرضى وما يَتخيَّرُ",9,"ر",1,0],["ماذا رأيتِ أما عَذرتِ سُيوفَهُ","وَعَلِمتِ أنَّ عدوَّه لا يُعذَرُ",9,"ر",1,0],["ماذا رُزِئنا بِهِ مِن حَيَّةٍ ذَكَرٍ","نَضناضَةٍ بِالرَذايا صِلِّ أَصلالِ",10,"ل",1,1],["ماذا رأيت أباك الطهر يصنع في","سياسة الدين لما قام (عزان)",11,"ن",1,0],["ماذا رأى غير أعوادٍ مبعثرة","على هشيم به وأرى أمانيه",12,"ي",2,0],["ماذا رَأَت فيهِ وَماذا رَجَت","وَهيَ مِنَ النِسوانِ مُختارَه",13,"ر",2,0],["ماذا رَأى مِنهُم في كُلِّ مُصطَدِمِ","وَسَل قَريظَةً وَالأَحزابِ مُفتَقِداً",14,"د",2,0],["ماذا رَشاكَ النَّدَى حتى حَكَمتَ له","حُكماً سِواك فأنتَ اليَومَ متَّهَمُ",15,"م",1,0],["ماذا رُميتَ بِهِ مِن","شُوَيعِرٍ فيهِ جَهلُ",16,"ل",1,1],["ماذا رأيت على التخوم من الخطى","بأمينها أنبئت أم برهيبها",17,"ب",3,0],["ماذا رَأَيت في الهِلال قُل لي","بِعَينِ رَأس لا بِعَينِ عَقل",18,"ل",1,0],["ماذا رغبتَ من الدنيا ولم يكنِ","المرغوبُ أدنى إلى كفيك من بال",19,"ل",1,0],["ما ذا رأيت وكل من حولي إلى","لوج مغطي يرمق المكشوفا",20,"ف",2,0],["ماذا رجاؤك في الدنيا وقد كشفت","لك القناع وأبدت عن يد العبر",21,"ر",1,0],["ماذا رأيت وقد تمت ليَ اللقيا","فقلت هل أنا في اللقيا أو الرؤيا",22,"ي",2,1],["ماذا رأى منهم في كل مُصطدم","لا تُلف في الناس من أَمثالهم أَحدا",23,"د",2,0],["ماذا رُزِئنا غَداةَ النَحِلِّ مِن رِمَعٍ","عِندَ التَفَرُّقِ مِن خِيرٍ وَمِن كَرَمِ",24,"م",1,1],["ماذا روى الناعي فإن مقاله","قد فض أعشار القلوب وبددا",25,"د",2,0],["ماذا رَأَى مِنْهُمُ في كُلِّ مُصْطَدَمِ","كَم أَرْهَقُوهُمْ عَذابَاً إِذ عَتَوْا صَعَدَاً",26,"د",2,0],["مَاذَا رَأَيْتُ بِأَطْلالٍ تُلاحِقُنِي ؟","غَيْرَ الْفَتَاةِ الَّتِي كَانَتْ تُحَلّيِهَا !!",27,"ي",3,0],["ماذا رأيت به والناس معلنة","لبيك لبيك رب البيت تنويها",28,"ي",3,0],["ماذا رأيتَ؟ تقول لي بتهكمٍ","فأجيبها: أواهُ لا تتساءلي",29,"ل",2,0],["ماذا رويتَ أبا زهراء يا رجلا ً؟","عن سيبويه وفيك َ النحوُ يضطرمُ",30,"م",1,0],["ماذا رويتَ أ أفعالا ً لها زمن ٌ؟","صَاغتْ نقوشاً وقد حَارَ بها القلم ُ",30,"م",1,0]]}