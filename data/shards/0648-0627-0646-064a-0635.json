{"poems":[[55,"سننت لهذا الرمح غربا مذلقا","https://www.aldiwan.net/poem29931.html","الطويل"],[79,"جزتني غرناطة بعد ما","https://www.aldiwan.net/poem35718.html","المتقارب"],[95,"عذيري من ضنى القلب الحزين","https://www.aldiwan.net/poem11221.html","الوافر"],[26,"هل الدهر إلا ليلة ونهارها","https://www.aldiwan.net/poem24105.html","الطويل"],[31,"ألا يا اسلمي يا أم بشر على الهجر","https://www.aldiwan.net/poem6070.html","الطويل"],[47,"فدتك يدي من عاتب ولسانيا","https://www.aldiwan.net/poem66867.html","الطويل"],[99,"متى نلتها كانت لأنفسنا منى","https://www.aldiwan.net/poem24587.html","الطويل"],[46,"أبا دلف لم يبق طالب حاجة","https://www.aldiwan.net/poem29989.html","الطويل"],[108,"ظلع وشيب!","https://www.poetsgate.com/ViewPoem.aspx?id=179321",""],[92,"اليأس المنشود","https://www.poetsgate.com/ViewPoem.aspx?id=179218",""],[308,"خل إدكارك ربعا دارس الطلل","https://www.aldiwan.net/poem16847.html","البسيط"],[395,"يا تاركين الصلاة","https://www.aldiwan.net/poem54601.html","عموديه"],[407,"إن كان من يبغضنا كارها","https://www.aldiwan.net/poem33906.html","السريع"],[420,"أينكر معروفنا المنكر","https://www.aldiwan.net/poem54039.html","المتقارب"],[443,"ما أحسن الصبر فيما يحسن الجزع","https://www.aldiwan.net/poem34837.html","البسيط"],[456,"خبرتكم فوجدت الجبن آيتكم","https://www.aldiwan.net/poem61357.html","البسيط"],[488,"إني أتتني لسان لا أسر بها","https://www.aldiwan.net/poem1121.html",""],[532,"دعي لومي على فرط الهواء","https://www.aldiwan.net/poem37548.html","الوافر"],[554,"أرق عيني طارق","https://www.aldiwan.net/poem47360.html","مجزوء الرجز"]],"verses":[["وَإِن يَصِبِ السَهمُ الَّذي راشَ نَصلَهُ","فَما كانَ إِلّا في هَواكَ مُفَوَّقا",0,"ق",2,0],["وأنّيَ صنّفْتُ فيها الغَريبَ","فصِرْتُ الغَريبَ أجوبُ الفَلا",1,"ل",2,0],["وَإنْ يَصْهِلْ فَأَبْجَرُ آلِ عَبْسٍ","لَهُ صَوْتٌ يُعَادُ بِلاَ رَنِينِ",2,"ن",1,0],["وَإِنّي صَبَرتُ النَفسَ بَعدَ اِبنِ عَنبَسٍ","نُشَيبَةٌ وَالهَلكى يَهيجُ اِدِّكارُها",3,"ر",3,0],["وَإِنّي صَبورٌ مِن سُلَيمٍ وَعامِرٍ","وَنَصرٍ عَلى البَغضاءِ وَالنَظَرِ الشَزرِ",4,"ر",1,0],["وَإِنّي صَديقٌ غَيرَ أَن لَستُ واجِداً","لِفَضلِكَ فَضلاً أَو يَعُمَّ الأَعادِيا",5,"ي",2,0],["وإني صدى الهمس الذي في قلوبهم","فدعني أقم عما يكنون معلنا",6,"ن",2,0],["وَأَنِّيَ صَيَّرتُ الثَناءَ مَذَمَّةً","وَقامَ بِها في العالَمينَ خَطيبُ",7,"ب",1,0],["وأني صِرتُ مطمعَ كلِّ عَادٍ","قليلِ الحَوْلِ ذي خدٍّ لطيم",8,"م",1,0],["وان يَصُبّوا عليها من وُعودِهُمُ","كالشِعر مكتمِلا – سهلاً ومُمتنِعا",9,"ع",2,0],["وأن يصلي على المختار سيدنا","محمد ما بكت سحب بمنهمل",10,"ل",1,0],["وإن يصلوا الجميع","ثم أتوا بالزكاة",11,"ه",1,0],["وأن يُصَلوا الخمس في وقتها","جماعةً في الجامع الأزهر",12,"ر",1,0],["وإنِّي صبورٌ على النائبات","وإنِّي على الضَّيم لا أصبرُ",13,"ر",1,0],["وإِنْ يُصَدِّعْ قُلُوباً صَدْعُ شَمْلِكُمُ","فالصَّبْرُ كالشَّمْسِ حَيْثُ الفَجْرُ يَنْصَدِعُ",14,"ع",1,0],["وأن يصفق للحكام أجمعهم","خيرا وشرا فيبقى الفضل مقبورا",15,"ر",2,0],["وإن يصبك عدو في مناوأة","يوماً فقد كنت تستعلي وتنتصر",16,"ر",1,0],["وَإِنْ يَصْفُو لَهُ وَقْتٌ تَراهُ","يُوقِّعُ في رِقاعِ الإدّعاءِ",17,"ا",2,0],["وإِنْ يُصِبْه صَيِّبٌ","لاطَفَهُ ورقَّقا",18,"ق",2,0]]}