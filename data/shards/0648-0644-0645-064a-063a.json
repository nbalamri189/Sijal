{"poems":[[36,"أضوء سنا برق بدا لك لمعه","https://www.aldiwan.net/poem4863.html","الطويل"],[79,"من استغضبت من هذي الخليقه","https://www.aldiwan.net/poem35915.html","الوافر"],[88,"أجل هذه أعلامه ومواكبه","https://www.aldiwan.net/poem10687.html","الطويل"],[10,"أعيني هلا تبكيان على صخر","https://www.aldiwan.net/poem21080.html","الطويل"],[74,"سقاك وحياك الحيا أيها القبر","https://www.aldiwan.net/poem18739.html","الطويل"],[53,"إذا تغنت شنطف مرة","https://www.aldiwan.net/poem65930.html","السريع"],[45,"أزائر يا خيال أم عائد","https://www.aldiwan.net/poem9559.html","المنسرح"],[64,"أبى الله أن أسمو بغير فضائلي","https://www.aldiwan.net/poem52453.html","الطويل"],[47,"أمرتجع مني حباء خلائف","https://www.aldiwan.net/poem62732.html","الطويل"],[68,"وفى لي فيك الدمع إذ خانني الصبر","https://www.aldiwan.net/poem40123.html","الطويل"],[82,"رمى الموت في عين التصبر بالدم","https://www.aldiwan.net/poem31279.html","الطويل"],[48,"أيا ديك عدت من أياديك صيحة","https://www.aldiwan.net/poem23291.html","الطويل"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72186","الطويل"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72204","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54857","الطويل"],[30,"","https://poetry.dctabudhabi.ae/diwan/poem/178136","الطويل"],[108,"سلاح غاندي","https://www.poetsgate.com/ViewPoem.aspx?id=179409",""],[124,"عباس إن ابني لي مفزع","https://www.aldiwan.net/poem49262.html","السريع"],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[280,"أدرك بخيلك خيل الله أندلسا","https://www.aldiwan.net/poem25469.html","البسيط"],[287,"إلمام طيف شنيب الثغر ألماه","https://www.aldiwan.net/poem32309.html","البسيط"],[310,"لصادق رعيه القصر السعيد","https://www.aldiwan.net/poem56577.html","الوافر"],[369,"إلى من يشار بهذا العذل","https://www.aldiwan.net/poem60798.html","المتقارب"],[371,"رمى الله بالمقترين البيوت","https://www.aldiwan.net/poem17741.html","المتقارب"],[382,"وشاحك فخر في الأنام جليل","https://www.aldiwan.net/poem59286.html","الطويل"],[382,"أزل يا شقيق الروح مني بقيتي","https://www.aldiwan.net/poem66906.html","الطويل"],[422,"قدمت قدوم الغاديات السواجم","https://www.aldiwan.net/poem54041.html","الطويل"],[469,"سلا عنك قلبي بعد ما قيل لا يسلو","https://www.aldiwan.net/poem3165.html","عموديه"],[556,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[556,"عجبت لقلبي كيف يصبو ويكلف","https://www.aldiwan.net/poem47405.html","البسيط"],[580,"بحقك حدث عن هواي ولا حرج","https://www.aldiwan.net/poem2976.html","الطويل"],[591,"دعاه ورقم الليل بالبرق مذهب","https://www.aldiwan.net/poem17416.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122588","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48872","الطويل"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18519","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77596","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70668","الكامل"],[1338,"","https://poetry.dctabudhabi.ae/diwan/poem/79655","الطويل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137846",""],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/121990","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/78018","المتقارب"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101071","الطويل"],[1893,"","https://poetry.dctabudhabi.ae/diwan/poem/146600","الطويل"],[2100,"","https://poetry.dctabudhabi.ae/diwan/poem/34942","الطويل"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45459","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53204","الوافر"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28067","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93676","البسيط"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65937","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132613","المتقارب"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145036","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138591",""],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117862","الوافر"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44891","الرجز"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125865","الوافر"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93260","السريع"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146758","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141678","الطويل"],[4657,"","https://poetry.dctabudhabi.ae/diwan/poem/140143",""],[3591,"أوحشت باريس هذا الصيف يا قمر","https://www.poetsgate.com/ViewPoem.aspx?id=149469",""],[5277,"ملاذاتُ الأبجدية","https://www.poetsgate.com/ViewPoem.aspx?id=199985",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5573,"الا هُبي بغيثكِ فامطرينا","https://www.poetsgate.com/ViewPoem.aspx?id=215491",""],[5582,"هوَ الدَّهْرُ فِينا جائِدٌ غَيْرُ جائِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186912",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5953,"علت قباب لكم هداتي","https://www.poetsgate.com/ViewPoem.aspx?id=93794",""]],"verses":[["وَلَم يُغنِ عَنّي ما يُعَقِّدُ طائِلاً","وَلا ما يُمَنّيني الطَبيبُ المُجَرِّبُ",0,"ب",1,0],["ولمْ يغْضَبْ فتَيْسٌ أو حِمارٌ","مَجازاً لا لعَمْري بلْ حَقيقَهْ",1,"ق",2,0],["وَلَم يُغنِ عَن عَبدِ الحَميدِ دَهاؤُهُ","وَلا عَصَمَت عَبدَ الحَميدِ تَجارِبُه",2,"ب",2,0],["وَلَم يَغدُ في خَيلٍ مُجَنَّبَةِ القَنا","لِيُروِيَ أَطرافَ الرُدَينيَّةِ السُمرِ",3,"ر",1,0],["ولم يغزُ ذو الأملاك مغمدة الظُّبا","بجيشٍ من الآراء يقدمه النصر",4,"ر",1,0],["ولم يغصْ في بحركم قامةً","حتى أراهُ عزرائيلا",5,"ل",2,0],["وَلَم يَغِب غائِبٌ خَليفَتُهُ","جَيشُ أَبيهِ وَجَدُّهُ الصاعِد",6,"د",1,0],["ولم يَغْشَ بابي موكبٌ بعدَ موكبٍ","مَخافةَ إيعادٍ وتأميلَ موعِدِ",7,"د",1,0],["وَلَم يُغنِ تَوكيدُ السِجِلّاتِ وَالَّذي","تَناصَرَ فيها مِن ضَمانٍ وَمِن عَقدِ",8,"د",1,0],["وَلَم يُغنِ عَنهُ الجَأشُ وَالجَيشُ وَاللُهى","وَفَرطُ النُهى وَالحُكمُ وَالنَهيُ وَالأَمرُ",9,"ر",1,0],["ولم يُغنِ عنها الضرْبُ من كلّ مرْهَفٍ","ولا نافذاتُ الطعنِ من كلّ لهذمِ",10,"م",1,0],["وَلَم يُغلَ ماءٌ كَي تُمَزَّقَ حُلَّةٌ","حَبَتكَ بِأَسناها العُصورُ القَدائِمُ",11,"م",1,0],["ولَمْ يَغْدُ قَبْلَ الصُّبْحِ طَيَّانَ بَطْنُه","نَظِيفٌ كَطَيِّ البُرْدِ لَيْسَ بِحَوْشَبِ",12,"ب",1,1],["ولَمْ يَغْلِبِ الخَصْمَ الضِّجاجَ ويَمْلأ","الجِفانَ سَدِيفاً يَوْمَ نَكْباءَ صَرْصَرِ",13,"ر",1,0],["وَلَمْ يغْنِ مِنْكَ الْعِلْمُ وَالفَضْلُ سَاعَةً","فَيَا عُذْرَ منْ بِالعِلْمِ وَالفَضْلِ يكْفُرُ",14,"ر",1,0],["ولم يُغنِ عنهُ عيشُ سبعينَ حجةً","وستينَ لمَا بانَ غيرَ مُوَسَّدِ",15,"د",1,0],["ولم يغمده إلا أن","تجاب مطالب الهند",16,"د",1,0],["ولم يغير ذاك من نجره","ولا أحال الفرع عن جذره",17,"ر",2,0],["ولم يغرهم إلا بدين محمد","فما غيرتي إلا له وغوائري",18,"ر",2,0],["ولَم يُغَادِر علَى سَهْلٍ وَلا جَبَلٍ","حَيَّا لقاحاً إِذا وَفَّيْتَهُ بَخَسا",19,"س",2,0],["وَلَم يَغِض ماءُ بِشرٍ مِن أَسِرَّتِهِ","وَكَم خِطابِ اِمرِئٍ أَبداهُ فَحواهُ",20,"ا",2,0],["وَلم يُغرر بلينِ الصفحِ منه","فَيُنكر بأسُه الخَشنُ الحديدُ",21,"د",1,0],["ولم يَغْتِمضْ بالكرَى ناظري","ولكنّه بكَ عنك اشْتغَل",22,"ل",1,0],["وَلَم يُغنِهِم أَنَّهُم كَالسُيوفِ","فَلا يَستَطيعونَ في الأَرضِ ضَربا",23,"ب",2,0],["ولم يغوه قولُ المماذق خادعاً","رويدَك إن تكفرْ فأنت خليل",24,"ل",1,0],["ولم يغوها بالكذب نصٌّ مصدق","خلافاً بقسر القول من غير ميزة",25,"ه",1,0],["ولم يَغْنَموا غير الفخار غَنيمةً","وما الفخر إلاَّ من أجلِّ المقاسم",26,"م",1,0],["ولم يغنهم من خلب البيض مخلب","ولا صال من خطي سمرهم صل",27,"ل",1,0],["ولم يُغنِ الّذي يُغني","هِ أهلونَ وإخوانُ",28,"ن",1,0],["وَلَم يُغنِهمْ واللَّهُ حِصنُك منهُمُ","مِنَ القولِ زورٌ لفّقوه وحرّفوا",29,"ف",3,0],["ولم يغتصِبْ تلك الذخائر ظالماً","ولكن لذاك الحُسْنِ في أَخذها حُجَجْ",30,"ج",1,0],["وَلمْ يُغْنِ عَنِّي أنّني السّيفُ مَاضِياً","إِذَا لَمْ يَكُنْ لِيَ مَنْ بِحَدّي يَضْرِبُ",31,"ب",1,0],["ولم يُغنِ عنكَ الفارسُ المصطلي الوَغى","ولا دعواتُ الناسِكِ المتَهَجّد",32,"د",1,0],["ولم يغنهم أني طليق مخير","ولم يعنهم أني حبيس مقيد",33,"د",1,0],["وَلَم يُغنِ عَنكَ الناسُ مِثلَ غِنائِنا","وَلَم تَمتَنِع مِن آكِلٍ مُتَمَشمِشِ",34,"ش",1,0],["وَلَم يُغادر أَبَداً صِغاره","خَوفاً عَلَيهنَّ مِن الإِغارَه",35,"ه",1,0],["ولم يغمدوا يوم النزال سيوفهم","إلى أن يسيل الواديان نجيعا",36,"ع",2,0],["ولم يُغْنِ عن حِجْر بنوه ورهطُه","وحيلتُه لو حاولَ الخلدَ إنسانُ",37,"ن",1,0],["ولم يغب عنا فضلك اليوم في الورى","ولكن حق المدح عن فكرنا يغبي",38,"ب",2,0],["وَلَمْ يَغِبَا لَكِنْ شَكَا الضُّرَّ فَارِسٌ","وَأَوْحَشَ مِنْهُ مَجْلِسُ الْمُلْكِ غَائِبُ",39,"ب",1,0],["ولم يغن عنه هناك البكا","وأخرج منها على رغمه",40,"م",2,0],["ولم يغن عنه ولا سد منه","بكاء أبيه ولا أمه",40,"م",2,0],["ولم يغن عنهم يوم أحد فضيحة","قضاء جرى أن يعرث البصراء",41,"ا",2,0],["ولم يغن علم المرء إن قل عقله","وقل غناء العلم لولا التجارب",42,"ب",1,0],["وَلَم يُغنِ عَنكَ المَوتُ يا جَمر إِذ أَتى","رِجالٌ بِأَيديهِم سُيوفٌ قَواضِبُ",43,"ب",1,1],["وَلَم يَغنَ مِن حَيّانَ حَيٌّ وَجابِرٌ","بِها لِيلُ أَمثالِ السُيوفِ الجَوارِحِ",44,"ح",1,0],["ولم يغبرَّ قدٌّ من قناة","ولم يحمرَّ خدٌّ من حسام",45,"م",1,0],["وَلَم يَغن مِن حَيّى وِمِن حَيِّ خُلَّتي","بِها مَن يُناصي الشَمسَ عِزّاً وَسُؤدَدا",46,"د",2,0],["وَلم يُغادر جَماداً لا وَلا بَشَرا","إِلا بُكاه وَلا جناً وَلا ملكا",47,"ك",2,0],["ولم يغتمض مذ يوم فارق أرضه","إلى أن أتاها زائراً بالقواضب",48,"ب",1,0],["ولم يغن مرمي موتورها","ولا المدفعي ولا الطائرة",49,"ر",2,0],["ولم يغنهم (جوبتير) رب ربوبهم","ولكن هوى من عرشه غير شائل",50,"ل",1,0],["ولم يغتسل من شاطئ النهر ناسياً","ظما السبط أو عن لذةٍ قد تعطرا",51,"ر",2,0],["ولم يغتب سواه ولا اشتكى من","نميمته القريب ولا البعيد",52,"د",1,0],["وَلَم يَغِب عَن فِطنَتي","آمالَهُ في مَطلَبي",53,"ب",2,0],["ولم يغضبْ على جاني","ولم يطمع بتافهةٍ",54,"ه",1,0],["ولم يغامر جودَك المعتفي","ولم يجانب مجدَك العادل",55,"ل",1,0],["ولم يُغادِر أَعصماً مُعتَصِماً","بِذُرِوَةٍ ولا عَفَا عَنِ العَفَا",56,"ا",1,0],["وَلَم يُغِث مُهجَتَهُ بالرِّيِّ بَل","أَروى أخاهُ النمريَّ وَسَقَى",56,"ا",1,0],["ولم يغلقوا أبوابهم دون ضيفهم","ولا شتموا خدامهم ساعة الأكل",57,"ل",1,0],["ولم يغن عني ما مدحتهم به","فتيلاً وما ازدادوا سوى البخل والشح",58,"ح",1,0],["ولم يغن شيئا عن كليب بن وائل","وعمر بن هند ما استجاشا وقبّضا",59,"ض",2,0],["ولم يغب عنك عشق الحاضرين فكم","لاقيت أهل هوىً من قبلكم غبروا",60,"ر",3,0],["ولم يغفُ ليلاً بلا ركعةٍ","ولم ينسَ يوماً صلاةَ القيامْ",61,"م",1,0],["ولم يغل في أقواله وفعاله","بإطرائه مما تجاوز للحد",62,"د",1,0],["ولم يغنمْ بها من يقْتنصها","ولم يهنأ بها من يقتفينا",63,"ن",2,0],["وَلَمْ يُغْنِ عَنْهُ حارِسٌ خَلْفَ حارِسٍ","وَلَمْ يُغْنِ عَنْهُ قائِدٌ خَلْفَ قائِدِ",64,"د",1,0],["ولم يُغْنِ عنهم جمعهم وحصونهم","ولا ما استعدوها من السابريةِ",65,"ه",1,0],["ولم يغب من به قوام الس","ماء والأرض والنبات",66,"ت",1,0],["ولم يغب مالك البرايا","والخلق والرزق والنجات",66,"ت",1,0]]}