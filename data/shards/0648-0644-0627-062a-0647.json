{"poems":[[55,"أما آن للدمع أن يستجم","https://www.aldiwan.net/poem29769.html","المتقارب"],[44,"ذروا آل سلمى ظنتي وتعنتي","https://www.aldiwan.net/poem50431.html","الطويل"],[90,"وخرساء لم ينطق بحرف لسانها","https://www.aldiwan.net/poem44449.html","الطويل"],[53,"رواغي رواغ الخائف القلب لا السالي","https://www.aldiwan.net/poem65945.html","الطويل"],[53,"تأمل أبا عبد الإله فإنه","https://www.aldiwan.net/poem66003.html","الطويل"],[53,"اسعد بعيد أخي نسك وإسلام","https://www.aldiwan.net/poem66052.html","البسيط"],[40,"ولا تهيبني الموماة أركبها","https://www.aldiwan.net/poem7849.html","البسيط"],[87,"يا فارسا ترجلا","https://www.aldiwan.net/poem7259.html","مجزوء الرجز"],[64,"هلموا إذا ما خفتهم الفقر فاصعدوا","https://www.aldiwan.net/poem52185.html","الطويل"],[48,"المرء حتى يغيب الشبح","https://www.aldiwan.net/poem22287.html","المنسرح"],[48,"إذا ما عانق الخمسين حي","https://www.aldiwan.net/poem22769.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202535","الرجز"],[53,"رواغي رواغُ الخائف القلبِ لا السالي","https://www.poetsgate.com/ViewPoem.aspx?id=30286",""],[124,"هيهات يحنو على قلبي معذبه","https://www.aldiwan.net/poem49319.html","البسيط"],[136,"ما للشجى على برح الغرام يد","https://www.aldiwan.net/poem54853.html","الطويل"],[159,"فديت من قال وقد زرته","https://www.aldiwan.net/poem55534.html","السريع"],[173,"لذا اليوم أعملت القلاص العباهلا","https://www.aldiwan.net/poem1655.html",""],[173,"إلى كم مداراة العدى واحترامها","https://www.aldiwan.net/poem1663.html",""],[198,"لكل هم من الهموم سعه","https://www.aldiwan.net/poem635.html",""],[275,"غرست بلحظي أجمل الزهرات","https://www.aldiwan.net/poem35612.html","الطويل"],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[447,"ألا مبلغ عني بشير بن جمعة","https://www.aldiwan.net/poem14425.html","الطويل"],[458,"لم ينهض الظلم في يوم بإنسان","https://www.aldiwan.net/poem61262.html","البسيط"],[556,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83311","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122564","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87023","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48526","البسيط"],[1302,"","https://poetry.dctabudhabi.ae/diwan/poem/131391","السريع"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124392",""],[1471,"","https://poetry.dctabudhabi.ae/diwan/poem/18382","المنسرح"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48937","الوافر"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77983","الطويل"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131594",""],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131553",""],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124740","الوافر"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118430","البسيط"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42402","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28602","البسيط"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106885","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60942","الطويل"],[2423,"","https://poetry.dctabudhabi.ae/diwan/poem/132502","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87336","الطويل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104681","الطويل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145039","الطويل"],[3335,"","https://poetry.dctabudhabi.ae/diwan/poem/202295","السريع"],[3480,"","https://poetry.dctabudhabi.ae/diwan/poem/202490","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91613","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91350","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117856","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86519","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59488","الطويل"],[3856,"","https://poetry.dctabudhabi.ae/diwan/poem/124139","البسيط"],[3882,"","https://poetry.dctabudhabi.ae/diwan/poem/124627","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54396","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133123","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58171","البسيط"],[4726,"ألا بالصبر تبلغ ما تريدُ","https://www.poetsgate.com/ViewPoem.aspx?id=146641",""],[4727,"على البديهة أمشي غير محتشم","https://www.poetsgate.com/ViewPoem.aspx?id=208068",""],[4729,"دَعُوهَا تَنُش إسحلا بالعقيق","https://www.poetsgate.com/ViewPoem.aspx?id=109444",""],[4869,"المعمّره القذافيه","https://www.poetsgate.com/ViewPoem.aspx?id=151677",""],[4927,"هَاْتِفُ الْحُبّ","https://www.poetsgate.com/ViewPoem.aspx?id=29732",""],[5072,"رهو ٌ هو العيد","https://www.poetsgate.com/ViewPoem.aspx?id=51900",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5448,"أطع ربك الباري وصفوة رحمان","https://www.poetsgate.com/ViewPoem.aspx?id=138060",""],[5512,"يا دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=205119",""],[5573,"ياخشف اشوف ان الهوى ماله حدود","https://www.poetsgate.com/ViewPoem.aspx?id=203090",""],[5701,"رعى الله على دِجل","https://www.poetsgate.com/ViewPoem.aspx?id=164597",""],[5788,"إذا نالك الدهر بالحادثات","https://www.poetsgate.com/ViewPoem.aspx?id=181610",""],[5818,"دعي شِعري يموجُ","https://www.poetsgate.com/ViewPoem.aspx?id=187478",""],[5830,"أَسَاحِرَةَ العُيُونِ","https://www.poetsgate.com/ViewPoem.aspx?id=201193",""],[5953,"علت قباب لكم هداتي","https://www.poetsgate.com/ViewPoem.aspx?id=93794",""],[6152,"لا عز لنا إلا بالدين","https://www.poetsgate.com/ViewPoem.aspx?id=204959",""]],"verses":[["وَلا تَهجُرِ العَزمَ عِندَ المَشيبِ","فَلَيسَ عَجيباً بِهَمٍّ يَهُم",0,"م",1,0],["وَلا تُهلِكوني بِالمَلامَةِ إِنَّما","نَطَقتُ قَليلاً ثُمَّ إِنّي لَساكِتُ",1,"ت",1,0],["ولا تهملوا الأوقات فهي بواترٌ","تقطع أوصال الحياة شباها",2,"ا",3,0],["ولا تهجُ أفعالاً حِساناً فعلتها","لأنّي امرؤ أخطأتُ في بعض أفعالي",3,"ل",2,0],["ولا تُهدفِ الإقْذاع سمعَك إنه","وجدِّك لا تُبلى عليك المفضّلُ",4,"ل",1,0],["ولا تهوُّرَ فيه عند ملتزمٍ","ولا تهيّبَ فيه عند إحجامِ",5,"م",1,0],["وَلا تَهَيَّبُني المَوماةُ أَركَبُها","إِذا تَجاوَبَتِ الأَصداءُ بِالسَحَرِ",6,"ر",1,1],["ولا تهدّد قاضيا","من شأنه أن يعدلا",7,"ل",2,0],["ولا تهملوا نار الحضان فإنها","تقلّب ما شئتم ظهورا وابطنا",8,"ن",2,0],["وَلا تَهِب أُسدَهُم إِذ زَأَروا","وَقُل تَداعَت ثَعالِبٌ ضُبُحُ",9,"ح",1,0],["وَلا تَهمِز جَليسَكَ مِن قَريبٍ","تُنَبِّهُهُ عَلى سَقطٍ بِهَمزِ",10,"ز",1,0],["ولا تهذب منهم","بالشعر تلك الطباع",11,"ع",1,0],["ولاته في ملكهم رهبان","والفلك حيث ساقها الرّبّان",12,"ن",1,0],["ولا تهجُ أفعالً حِساناً فعلتها","لأني امرؤ أخطأت في بعض أفعالي",13,"ل",2,0],["ولا تهش فراديس الجمال إلى","نار الجوى وجراحات المساكين",14,"ن",1,0],["ولا تَهَابُوا ولاَ تَخشَوا ولا تَهِنُوا","ولاَ تَوَانَوا ولاَ تاَلَوا ولا تَجَدُوا",15,"د",3,0],["وَلا تَهَنَّيْتُ لَذيذَ الكَرى","إِذا تَجافَتْ عَنْكَ أَجْفانِي",16,"ن",2,0],["وَلا تُهمِلَن وُدّي لَكُم وَقَرابَتي","وَأَشعارِيَ اللّاتي مَلَأنَ المَحافِلا",17,"ل",2,0],["وَلا تَهِنُوا وَاِستَشعِرُوا الصَبرَ جُنَّةً","وَعَزماً فَما لِلحَربِ إِلّا اِعتِرامُها",18,"م",3,0],["وَلا تُهينَ الفَقيرَ عَلَّكَ أَن","تَركَعَ يَوماً وَالدَهرُ قَد رَفَعَه",19,"ع",2,0],["ولا تُهمِلي شِعري الذي فاضَ في الهوى","فكانَ كنوحاتٍ على رَنمات",20,"ت",1,0],["ولا تهملن المستجير اذا أتى","فاهماله بلقيك في لؤم لأمان",21,"ن",1,0],["ولا تهلك الدُنيا بكدحك فانيا","فإِنك فإن فان والَّذي أَنتَ تكدح",22,"ح",1,0],["ولا تهادى بها التمدين منبسطا","والنيل ما بين إحياء وإحسان",23,"ن",1,0],["ولا تهافت من راموا مودتها","على منائر جازت كل حسبان",23,"ن",1,0],["ولا تُهِبْ بِي إلى ثِنْيَيْ بُلَهْنِيةٍ","وَاِجعَلْ نِداءَك لِي من فادحٍ فَدَحا",24,"ح",2,0],["وَلا تُهمِلِ المُستَنصِرَ الحُكمَ الَّذي","تَلاهُ وَمَن يَستَنصِرُ اللَهَ يَنصُرِ",25,"ر",1,0],["ولا تَهنوا أو تحزنُوا من عدوِّكُم","وإن مَسَّكُم قَرحٌ فقد مسهم قَرحُ",26,"ح",1,0],["ولا تهدم بسوء الرأي دوراً","بها تنزل",27,"ل",1,0],["ولا تهب عمدة يوماً مجاملة","يؤذي بها القوم مغتراً ويحتقر",28,"ر",1,0],["ولا تهولنك قارورتي","فإنها أقنع من ذاكا",29,"ك",2,0],["ولا تهتدي الزباء فيه ولا القطا","ولا تهتدي الأفرادُ فيه ولا الجُمل",30,"ل",1,0],["وَلا تُهِن لِلصَديقِ تُكرِمُهُ","نَفسَكَ حَتّى تُعَدَّ مِن خَوَلِه",31,"ل",2,0],["ولا تهجر حِماكَ وجِدَّ فيه","تجد أَن الرقيَّ إليه ثابا",32,"ب",2,0],["ولا تهلك الخلق الذي أنت ربه","ولا تهتك الستر الذي أنت ساتر",33,"ر",1,0],["ولا تهاب من صراع الداهيه","ذي مالأهل الكمال فيها صراع",34,"ع",1,0],["ولا تهوله كثرة المحافل","حوله وقد دارت بسود الأخشام",35,"م",1,0],["ولا تهمل نصيبك للأعادي","من الخيراتِ والحسبِ الحسيب",36,"ب",1,0],["ولا تهنا يا مجير المجرم","فما لمن اهنته من مكرم",37,"م",1,0],["ولا تهرعي إلَّا إليه إذا جَفا","سحابٌ فما في غيرِ ألطافِه رَجوى",38,"و",2,0],["وَلا تَهِبُّ مِنَ الأَحلامِ راقِدَة","إِلّا وَيَغبُرُ في أَجفانِها الوَسَنُ",39,"ن",1,0],["ولا تهاترهم فتغرم","رجاءَهم فيك وهو دينُ",40,"ن",1,0],["ولا تهملي عهدَ الشباب الذي مَضَى","قديماً فنِعمَ العهدُ ذلك والعصرُ",41,"ر",1,0],["وَلاَ تُهلِكَنَّ النَّفسَ كَرباً وحَسرَةً","على الشَّيءِ سَدَّاهُ لِغَيرِكَ قَادِرُه",42,"ه",1,1],["ولا تُهملوها وآجعَلُوها رسالةً","أتَت من خبيرٍ قَد ملاها من البِشرِ",43,"ر",1,0],["ولا تهملوني فالليالي ذواهبٌ","وأكثر عمر العاشقين قصير",44,"ر",1,0],["ولا تهملوا أمر الحياة فإنها","حياة نشاط بل حياة جدال",45,"ل",1,0],["ولا تهروا الموت إن أقبلت","خيل تعادى سنن الدبر",46,"ر",1,0],["ولا تهجر الصهباء فهي لذيدة","مسهلة ما كان من من خلق صعب",47,"ب",1,0],["وَلا تَهب مَن وَشَى عَنّا فَإِنّ لَنا","جَيشاً نَصولُ بِهِ حَيثُ المُدام طَغى",48,"غ",2,0],["وَلا تهب من غَد غَدراً تحاذره","فَكلُّ شَيء لَهُ حَدٌّ وَمَقدور",49,"ر",1,0],["ولا تهنوا وابغوا المزيد وثابروا","فليس على أبواب ذي الطول أقفال",50,"ل",1,0],["ولا تهملوا حسن الخطاب ولينه","فإن الخطاب العذب نعم المثقف",51,"ف",1,0],["ولا ُتهملاها من لحافٍ فانها","لحصني إذا جاءت رعالُ قنابلِ",52,"ل",1,0],["ولا تهتكت من وجدي وقد لمعت","انوارك الزهر او نار باشجار",53,"ر",1,0],["ولا تُهمِلِ الآدَابَ من حيثُ تَنتَهِي","إلى حضرة المبعوثِ أصدقِ ناطق",54,"ق",1,0],["ولا تهبن إلى الأمام","بل حوله ذودن بالإقدام",55,"م",1,0],["ولا تهملوا البيتَ المقدَّسَ واعزموا","على فتحهِ غازينَ وافترعوا البكرا",56,"ر",2,0],["ولا تهملوا تعليمهن فرائضاً","صلاةً وتوحيداً وحيضاً وباقيا",57,"ي",2,0],["ولا تُهبِيكَ خُرعوبٌ مُنَعَّمَةٌ","هَيْفَا مخلخَلَةٌ بالعَسْجَدِ اللّدِنِ",58,"ن",1,0],["ولا تهمل معانيه فترقى","بمرقى العز للعليا تُشيد",59,"د",1,0],["ولا تَهَلْهَلتُ في خَلقي وفِي خُلُقِي","حَتَّى أوافِقَ خُدّاماً إلى العَجَمِ",60,"م",1,0],["ولا تُهملنّ، فيأتي العتابُ رائحُ","هُ في الوَرَى مثلُ غَادِ",61,"د",1,0],["ولاتهدديني وانتي حيل تخافي","بترول وصلك ماترده طفقه",62,"ق",2,0],["وَلاْ تُهَاْدِنْ وُشَاْةَ الْعَصْرِ إِنْ خَضَعُوْا","حَتَّىْ تُدِيْنَ عَذُوْلاً يَزْرَعُ الْمَضَضَاْ",63,"ض",2,0],["ولا تَهِمّوا لأمر ِ الجار ِ ما فعلوا","ولا تظنّوا بهم نصرا ً فتنخذلوا",64,"ل",3,0],["ولا تهتف بزينب والرفاعي","ولا الست النفسية ذي الجمال",65,"ل",1,0],["ولا تهملن المستجير إذا أتى","فإهماله يلقيك في لؤم لأمان",66,"ن",1,0],["ولا تهابي لظى النَّارِ التي وُقِدَتْ","بردٌ وغيثٌ منَ الرَّحمنُ ينسكبُ",67,"ب",1,0],["ولا تهب ياسالكا درب الصعود","صلف الوعر لايثني اعزومك حصاه",68,"ا",2,0],["ولا تهتز نشوان","تجيل النهي والأمرا",69,"ر",2,0],["ولا تهن النفس عند الخطوب","إذا كان عندك للنفس قيمه",70,"م",2,0],["ولا تهني وصَلّي فيَّ صَلِّي","لِ ندخلَها ونحظى ب الشفاعهْ",71,"ع",2,0],["وَلا تَهَبِ المَحَبَّةَ ذَاتَ يَوْمٍ","وَ كُلَّ الكَوْنِ لا تُعْطِ الوِدَادَا",72,"د",2,0],["ولا تهادت بنا رياح","من مصعدات ومحدرات",73,"ت",1,0],["ولا تهنوا فإن النصر آت","وفي نص الكتاب أتى البيان",74,"ن",1,0]]}