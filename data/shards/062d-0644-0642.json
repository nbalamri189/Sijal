","https://www.poetsgate.com/ViewPoem.aspx?id=187373",""],[5542,"شعري وحبي فيكَ يلتقيانِ","https://www.poetsgate.com/ViewPoem.aspx?id=24756",""],[5573,"ياهن وش فيهم علينا الموارد","https://www.poetsgate.com/ViewPoem.aspx?id=200453",""],[5644,"يا من تلوم على الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=198656",""],[5725,"ايلان","https://www.poetsgate.com/ViewPoem.aspx?id=177746",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5739,"هيه يالمسترجله ...!","https://www.poetsgate.com/ViewPoem.aspx?id=131708",""],[5804,"حديث مع المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=214749",""],[5819,"صديقي مصطفى","https://www.poetsgate.com/ViewPoem.aspx?id=215676",""],[5861,"وطن أنا","https://www.poetsgate.com/ViewPoem.aspx?id=188050",""],[5880,"طائر الليل","https://www.poetsgate.com/ViewPoem.aspx?id=206231",""],[5940,"أنشأت نظمًا زاهرًا قد طابا","https://www.poetsgate.com/ViewPoem.aspx?id=124948",""],[5943,"ياشعرُ اِصدحْ","https://www.poetsgate.com/ViewPoem.aspx?id=37338",""],[5956,"غرِّدْ أيا قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=200909",""],[6019,"إشتياق بعنوان آخر !!","https://www.poetsgate.com/ViewPoem.aspx?id=53047",""],[6093,"لا تسمى وثبة النسر انحطاط","https://www.poetsgate.com/ViewPoem.aspx?id=203968",""],[6152,"يوما ستشرق شمسك","https://www.poetsgate.com/ViewPoem.aspx?id=203080",""],[6152,"قم للعلا","https://www.poetsgate.com/ViewPoem.aspx?id=203092",""],[520,"يا دهر قد اكثرت في التلوين","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577682",""]],"verses":[["حَلقٌ وَضَربٌ يَستَوجِبانِ لَهُ","مُعَجَّلَ الحَلقِ مِنهُ وَالضَربِ",0,"ب",1,0],["حَلقُ الدرعِ ليس يُمسكُ منها","سَرْدها غيرُ شكَّة الحِرباءِ",1,"ا",2,0],["حلقت لحيةٌ عليك ودُسَّت","أقبحَ الدسِّ في استك الضيعوز",2,"ز",1,0],["حُلقتْ ذوائبُها التي","خُلقت لصُنَّاع المناخِلْ",3,"ل",1,0],["حَلَّقَ الغَربِيُّ فَوقَ السَمَواتِ","وَلَبِثنا نَندُبُ الرَسمَ المَحيل",4,"ل",1,0],["حُلِقَت كَيفَ أَتَتهُ","قَبلَ أَن يُنجَزَ وَعدي",5,"ي",1,0],["حلقت سبالك جهلا بما","يواري من العورات القباح",6,"ح",1,0],["حُلِقَت لِحيَةُ موسى بِاسمِهِ","وَبِهارونَ إِذا ما قُلِبا",7,"ب",2,1],["حلّ قصرَ المجد منه مَلِكٌ","بُدئَ المجدُ به ثمّ خُتِم",8,"م",1,0],["حَلَّقوا بالأمسِ في طُغيانهم","ثمَّ بادوا في مَهاويهِ وبادا",9,"د",2,0],["حلّق المَجد بِهُم ثُمَ هَوى","وَاِنثَنى ينشدهم لَما اِنثَنى",10,"ن",2,0],["حَلقَاتُ أدرعِهمْ قيو","د الموْتِ في دَرَك الطعانِ",11,"ن",1,0],["حَلَّ قَلبي ثُمَّ قَد","آبَ بي وَعَقَلا",12,"ل",2,0],["حَلَقَ النِّصْفَ بِذَنْبٍ حاضِرٍ","وَعَفا بالنصفِ عَمَّا سَلَفَا",13,"ف",2,0],["حَلَقٌ مُجادَلَةٌ كَشُربِ مُهَلهِلٍ","شَرِبوا عَلى رُغمٍ بِكَأسِ حَلاقِ",14,"ق",1,0],["حَلَّقْ مَعِ الْفَلكِ الدَوَّارِ في فَلَكٍ","وَزُحُ أَنْ اسْطَعْتْ عَنْ أَسْرَارِهِ حُجُبَا",15,"ب",2,0],["حلق ولا تحفل أأزرى حاسد","أو انبرى لحتفه شويعر",16,"ر",1,0],["حلّق النسْرُ كما شاء وَصاحْ","ورمَى بالقيدِ في وجهِ الريَاحْ",17,"ح",1,1],["حلِّق بروحكَ في سماءٍ حُرةٍ","لم تُخلَقِ الأطيارُ للأطواق",18,"ق",1,0],["حلِّقي كَيْفَ شئت في الشرق أو في ال","غَرْب، ترعاك مقلة الرحمن",19,"ن",1,0],["حلَّقت بي قوادمٌ وخوافٍ","من خيالي في كلِّ أفْقٍ بعيد",20,"د",1,0],["حلقت للطاعات خطفة طائر","فحللت مسرح جعفر الطيار",21,"ر",1,0],["حلّقت فوق مسابح الأوهام لم","تلمح خيال جناحك الأوهام",22,"م",1,0],["حلق الشوارب والتقصير من ردن","ولين قول وفي ألفاظهم ملق",23,"ق",1,0],["حلق الله ذقن من يتشنا","ك وألقاه في غيابه حجر",24,"ر",1,0],["حلقت في الطول ذقن جريرٍ","والأراجيز لحية العجاج",25,"ج",1,0],["حلقوا رؤوسَهمو وقصّوا ظُفرَهُم","قَبِلَ المُهَيمنُ توبةَ الأسيادِ",26,"د",1,0],["حَلَّقَتْ مُحْتَلَّةً بِهِمُ","شَرَّ تَحليقٍ وتَحْليلِ",27,"ل",1,0],["حَلقاً بَعدَ قِطارٍ","نَزَلوا بِالبَيتِ صَفقَه",28,"ق",2,0],["حَلقي قَد تَلَقّى","كامِناً في جَوفِ جُلَّةِ",29,"ل",2,0],["حَلَقَت بَنو عُزوانَ جُؤجُؤَهُ","وَالرَأسُ غَيرَ قَنازِعٍ زُعرِ",30,"ر",1,0],["حَلقي مُسحت بِمَوطئ القدمِ الّتي","فَخَرت بِها الأرضُ الذلولُ عَلى السما",31,"م",2,1],["حلقات من الزمان تغايَر","نَ وإن كان صوغُهن فريدا",32,"د",2,0],["حَلَقٌ كما اطّردَ الغديرُ حَبابُه","نَسَقٌ وضاحي مَتْنِه مَشْمول",33,"ل",1,0],["حَلَقاتُ شَعرٍ تَستَديرُ كَأَنَّها","حَلَقُ البَريدِ بِها قَعاقِعُ عَزلِهِ",34,"ل",2,0],["حلّق بنا في تلاواتٍ مرتلةٍ","ترقى بأنفسنا حُباً وإيثارا",35,"ر",2,0],["حلقوا ما قصروا في رميهم","جمرات قد أُصيبت بحصاها",36,"ا",3,0],["حَلَّقَتْ من خَلْقِهِ راياتُهُ","فَهْيَ أَمثالُ الحَمَامِ الحُوَّمِ",37,"م",1,0],["حلَّقتْ مبتدِئا همّتُه","وانتهى المجدُ فلم يبلغ مداها",38,"ا",3,0],["حلَّق والنسرُ المُطا","ر حوله يرفرفُ",39,"ف",1,0],["حلَّق حتى اشتط في سمائه","بحاكمٍ في نفسه وآمرِ",40,"ر",1,0],["حلق بأجوائها وانظر بوارقها","فكل بارقة تومي لميعاد",41,"د",1,0],["حلق بخافقتي مناك إلى السهى","فالدون لا يرضاه غير الدون",42,"ن",1,0],["حَلَقٌ مِن بَني كِنانَةَ حَولي","بِفِلَسطينَ يُسرِعونَ الرُكوبا",43,"ب",2,0],["حَلقوا في العلى نُسوراً وصادوا","ما رأَوهُ منَ المعاني فريدا",44,"د",2,0],["حلق الزغف والوجوه بليل","النقع يطلعن أَنجماً وبدورا",45,"ر",2,0],["حَلَّ قُوايَ العَقدُ مِن زُنّارِهِ","أَلهَبَ قَلبي خَدُّهُ بِنارِهِ",46,"ه",1,0],["حَلَقٌ أَحَلّوها الفَضاءَ كَأَنَّهُم","مِن بَينِ مَنبِجَ وَالكَثيبِ قُيولُ",47,"ل",1,0],["حَلَقْتَ سِبالَكَ جَهْلاً بما","يُواري مِنَ النَّكِراتِ القِباحِ",48,"ح",1,1],["حلقة مِن استه أَو","سَعُ مِن استِ بُحَيشِ",49,"ش",1,0],["حل قلبونُ أنّ قُلبَينَ أشهى","لفُؤاد المُتيَّمِ المُستهامِ",50,"م",1,0],["حلقاً توسّطها العمود فلزّها","لولا ثمامة والإله لداما",51,"م",2,0],["حلَّقت حيث الطرفُ عنك مقصرٌ","فصعدت حيث النجم عنك تصوَّبا",52,"ب",2,0],["حلقَت هيبةٌ فأشرقَ نورٌ","واعتلى العدلُ كفةَ الميزانِ",53,"ن",1,0],["حلقت رهبةٌ وسادَ خشوعٌ","واستطارت بواعثُ النسيانِ",53,"ن",1,0],["حلقَ الرعبُ والمليكُ يُنادِي","ها وعيدي والويلُ من سلطاني",53,"ن",2,0],["حلَّقَت رهبةٌ وَسادَ سُكُونٌ","وانجلَت قدرةٌ وآنَ الوفاءُ",54,"ا",2,0],["حلقت بالشعر عنقاء الردى","في مهاوي الغيث والكون الجنين",55,"ن",1,0],["حلق كالنسر بأفق العلى","لكن من العلم جناحاه",56,"ا",2,0],["حلَّقتِ يا جُبَعٌ بِهِ فَبَدت","مِن تَحتكِ الغيطان وَاليَفَع",57,"ع",1,0],["حَلَّق المغرب في العزّ وَما","بَرِح المَشرق في الذُلّ يُسِف",58,"ف",1,0],["حلقت فوق الشاعرين فلا نرى","لك بينهم في شأوه اندادا",59,"د",2,0],["حلقها مخجل الشمس والبدر التمام","ومغير الغصون الرشيقه",60,"ق",2,0],["حلقوا رَأسَه لِيَكسوه قُبحاً","خيفةً مِنهُمُ عَلَيهِ وَشُحَّا",61,"ح",2,1],["حلقت في الجو يا ابن السين من بلد","ما زال للعلم وردا طيبا عذبا",62,"ب",2,0],["حلقوا ذقونَهم ولو طالت بهمِ","لرأَيتَهم عندَ النِّطاح تُيوسا",63,"س",2,0],["حلقت في الجو تسعى للوجود","حرة تحيا وإلا فالقبور",64,"ر",1,0],["حلقت فوق الجبال معتلياً","عن سرب طير مقصّر عائب",65,"ب",1,0],["حلقتُ فوق الخيال معتلياً","عن سرب طير مقصّرٍ عائب",66,"ب",1,0],["حلّق بروحك إن أردت سلامة","وبذاك أوحي لي هتافُ البلبل",67,"ل",1,0],["حَلَقت بِك الأَعداء ثُم نحرتهم","وَلا شَك أَن الحلق يَعقبه النَّحر",68,"ر",1,0],["حلّقي حلّقي والقي على الأف","لاكِ رعباً وروعة وفضولا",69,"ل",2,0],["حلقت في السماء فهي نسور","طائرات لها السماء وكون",70,"ن",1,0],["حلقوا شعره ليكسوه قُبحا","غيرةً منهم عليه وشحا",71,"ح",2,1],["حلّق بقادمةِ الجنا","حِ وطِر بِغَيرِ مهيضهِ",72,"ض",2,0],["حلّقت وهي تطلب الشهب حتى","جاوزت في السما سماكاً ونسرا",73,"ر",2,0],["حلقت فوقها كواسر عقبا","ن تجلت من شاهق متعال",74,"ل",1,0],["حل قوما من أمة الزنج يرجو","كشف ما فيهمو من العادات",75,"ت",1,0],["حَلَق الحوادثُ لمَّتِي فتركنَ لي","رأساً يَصِلُّ كأنَّه جُمَّاحُ",76,"ح",1,0],["حلقت في أفق المعالي سابقاً","وكبا عدوك لليدين وللفم",77,"م",1,0],["حلَّقتما حتى النورُ جوافلٌ","فزعاً تساءَلُ أَيُّ طيرٍ أَنتما",78,"م",2,0],["حلّ قلبي تصحيف اسمك لما","صرت للهجر والصدود رفيقا",79,"ق",2,1],["حلقت في السماء منها نسور","يمتطون الحديد فوق الغمام",80,"م",1,0],["حلق بي عن أن أضام محتدٌ","عن أحمد المختار قد تفرعا",81,"ع",2,0],["حلَّقتَ في الأَمصارْ","تُغالب الأقدارْ",82,"ر",1,0],["حلق بِها ما شئتَ مفتخراً","لا تعرف الإخفاقَ والفشلا",83,"ل",2,0],["حلَّقت بالبشر في الذكرى احتفاءً","بالذي ازدانت بذكراه المحافل",84,"ل",1,0],["حلِّق بأجنحة الدعاء دجًى له","واخشع بصبِّ سحائبِ الإعوال",85,"ل",1,0],["حلق بنا بالعزم من فوق الأوطان","وجاور بمداته سهيل اليماني",86,"ن",2,0],["حلقاتُ درسٍ كان فيها رائداً","يَهدي إلى الدّرب القويم ويُرشِدُ",87,"د",1,0],["حلقت بي متهادياً وبدت رؤى هذا الحرم","وأراك تجري في الشعور وتستحيل إلى نغم",88,"م",1,0],["حلِّقي حولي وطيري","وانثُري العطرَ بقربي",89,"ب",2,0],["حلَّقتْ بي أمنياتٌ","والرَّجَا مات لِتُدنِي",90,"ن",2,0],["حلَّقَتْ آمَالُ رُوحِي تَساَمَتْ","لاسؤالٌ قدْ يُجِيزُ الجَوَابا",91,"ب",2,0],["حلَّقْتُ حتّى لا أرى ما جُزتُه","تحتي كأنّ الكون كالدخَّانِ",92,"ن",1,0],["حَلِّقْ مَعِي يَا طَائِرَ الأشْجَانِ","َارْتَعْ مَعَيْ صَفِّقْ هُنَا لِحَنَانِيْ",93,"ن",2,1],["حَلِّقْ كَمَا الأفْلاكِ فِيْ أفْقِيْ هُنَا","سَلْوى عَلى حُلْمٍ تَسِيْحُ ظِلالاَ",94,"ل",2,0],["حَلِّقِي حَوْلِي وَطِيِرِي","وَانْشَقِي أَحْلَى الْعُطُورْ",95,"ر",1,0],["حلقت في الجو ترعى شهبه","فاذا الانجم عقد من حلاها",96,"ا",3,0],["حلقت في سمائها فأرتني","نؤها وهو بالغرام ينوء",97,"و",2,1],["حلق بأحلام وراء سحابة","وامرح بها إن السبيل تقطعا",98,"ع",2,0],["حَلِّق .. إلَى أعلَى السَّمَاءِ وكُن لَهُم","نَجمًا يُضِيءُ دُرُوبَهُم .. يَومَ الحَلَكْ",99,"ك",1,0],["حلّقْ بعيداً عاليا ً وأهزأ بها","الأسم فرعونٌ ومسكنكَ الهرمْ !",100,"م",1,0],["حَلِّقْ، وحَلِّقْ في لَهيبِ تَعَطُّشِي","فأنَا الفَضَاءُ، وأنتَ مَن يَروِيني",101,"ن",2,0],["حلقت في الإبداع ردحا وانتهى","بك عاليا تزهو على الأفنان",102,"ن",1,0],["حلَّق السرب وما زالت به","خيفة التحليق فيها ما رجع",103,"ع",1,0],["حلّقت روحا تستجير من الجوى","وبصبرها وبحزنها تتذرّعُ",104,"ع",1,0],["حلَّقتُ فوقَ الغيمِ منتشياً","ما طالني نجمٌ ولا نَسْرُ",105,"ر",1,0],["حلّقت في الأفق البعيد، فلا يدٌ","وصلت إليك ، ولا فمٌ مهذار",106,"ر",1,0],["حَلَقاتُ مسجدك الكريمِ منارةٌ","للعلم، تمسحُ ظُلمَةَ الأَذهانِ",107,"ن",1,0],["حلقت حلمي فوق كوكب عطارد","ومشيت دربي باختياري وطاعه",108,"ع",2,0],["حلق بروحك وارتفع في رحْبِها","كم من طيورٍ رفرفتْ بفضاءِ",109,"ا",2,0],["حلّق مداها ياملاك كما تشا","حراً ودعْ هذي الجباه تعفّرُ",110,"ر",1,0],["حلقن بأفاق ميدان الهوى","يم من يهواه قلبي سابحات",111,"ت",1,0],["حلّقَت واسترّجَلت بين الحضور.","والفحول فحول ومنيره منير.",112,"ر",1,0],["حلّقي بي إلى المنى","أو أريحي وغادري",113,"ر",2,0],["حلق برحب سماء الحب مندفعا","واركب شهابا إلى العلياء براقا",114,"ق",2,0],["حلقْ بنا نحوَ الفضاءِ كعاشقٍ","شيّدْ لنا فوقَ السحابةِ عشّنا",115,"ن",2,0],["حلق بعيداً.. ولا تركن إلى وطنٍ","لا يفرح الطير إلا وهو مغتربُ",116,"ب",1,0],["حلق اللحى إحدى الكبائرعندنا","فلقد نهى عنها النبيُّ وعابا",117,"ب",2,0],["حلِّق ضياءً يشعُّ الحسنَ مبتهجًا","أمواجَ نورٍ على خدٍ من الشَّفقِِ",118,"ق",1,0],["حلِّقْ أيا قلبي بأقصى سرعةٍ","لِشِغافِ أحفدة إليك تطلعا",119,"ع",2,0],["حلِّقْ لأرضِ حفائد من بُعدنا","عنهم يقاسون الفراق المفجعا",119,"ع",2,0],["حَلَّقتُ في جَوِّ المَوَدَّةِ قَاصِدَاً","في رِحلَتِي أَنْ أَرتَقِي لِسَمَاكِ",120,"ك",1,0],["حلَّقَ النسرُ بحلمٍ فوقها","ليسَ للنسرِ معَ الريحِ ارتباطْ",121,"ط",1,0],["حلّق بعيدا فالفضاء فسيح","وأسبح بفكرك ما عليه قيود",122,"د",1,1],["حلق بعيدا ولا ترضى الخلود إلى","أحزان قلبك وألبس للرضا حُللا",123,"ل",2,0],["حلق يخافقني مناي إلى السهى","فالدون لا يرضاه غير الدون",124,"ن",1,0]]}