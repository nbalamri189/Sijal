spx?id=53368",""],[5853,"(( لي حبيبٌ))","https://www.poetsgate.com/ViewPoem.aspx?id=175657",""],[5864,"يا أبي","https://www.poetsgate.com/ViewPoem.aspx?id=190488",""],[5908,"هل لقلب المتيم المتبول","https://www.poetsgate.com/ViewPoem.aspx?id=170976",""],[192,"فهد بن سلمان","https://www.poetsgate.com/ViewPoem.aspx?id=16371",""],[5939,"صدفة","https://www.poetsgate.com/ViewPoem.aspx?id=195304",""],[5956,"الأحزاب","https://www.poetsgate.com/ViewPoem.aspx?id=182754",""],[5956,"الرَّفْضُ السَّلْبِيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=183335",""],[5956,"ينبغي محْوُ الخماسيِّ","https://www.poetsgate.com/ViewPoem.aspx?id=192327",""],[5956,"بلغ استكبارها أعلى الزبى","https://www.poetsgate.com/ViewPoem.aspx?id=194437",""],[5957,"كل حب في حياتي لا يزول","https://www.poetsgate.com/ViewPoem.aspx?id=113357",""],[6004,"مثلما تمضي الثواني","https://www.poetsgate.com/ViewPoem.aspx?id=33701",""],[6004,"واستباح العُرى","https://www.poetsgate.com/ViewPoem.aspx?id=33753",""],[6004,"جَنَّةٌ للنِّسَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=59595",""],[6056,"المرثية","https://www.poetsgate.com/ViewPoem.aspx?id=130571",""],[6093,"حياد الشعر والنثر","https://www.poetsgate.com/ViewPoem.aspx?id=192352",""],[6124,"فيك صرنا","https://www.poetsgate.com/ViewPoem.aspx?id=174830",""],[6142,"عهدي بربعهم أغن المعهد","https://www.poetsgate.com/ViewPoem.aspx?id=155758",""],[6152,"هاشميون","https://www.poetsgate.com/ViewPoem.aspx?id=203020",""],[5957,"يا ملاكاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82581&r=&rc=123",""],[6237,"آذان الفجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77887&r=&rc=29",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""],[6244,"ما هو الكون ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=510&r=&rc=3",""],[6129,"للمجاهدين في العراق وللبطلة العظيمة (ميسون)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74364&r=&rc=2",""],[6318,"مواكب بدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66158&r=&rc=8",""]],"verses":[["كُلُّ حَبيبٍ أَبَداً","أَيّامُهُ قَلائِلُ",0,"ل",1,0],["كُلُّ حَيٍّ يُغالِطُ العَيشَ بِالدَه","رِ وَكُلٌّ تَعدو عَلَيهِ العَوادي",1,"د",2,0],["كُلُّ حَبسٍ يَهونُ عِندَ اللَيالي","بَعدَ حَبسِ الأَرواحِ في الأَجسادِ",1,"د",1,0],["كُلُّ حُبٍّ يَبيدُ يَوماً فَيفنَى","وَهَوانا وَهَجرُنا لا يَبيدُ",2,"د",1,0],["كَلِحيَةِ المُرِّ كُلَّما حُلِقَت","نَمَت نُمُوَّ الزُروعِ وَالعُشبِ",3,"ب",1,0],["كُلُّ حَدِيثٍ وَكُلُّ ذي قِدَمٍ","فِيها مُدينٌ بِفَضْلِهَا الجَمِّ",4,"م",1,0],["كُلُّ حُبٍّ إِذَا استَطَالَ سَيَبلَى","وهَوَى روضةِ المُنىَ غَيرُ بَالِي",5,"ل",2,0],["كل حد يجري إليها","ويقول وروح يرتاح",6,"ح",1,0],["كل حزب بما لديه فَخور","ولمَن هم مخالفوه خَذول",7,"ل",1,0],["كلُّ حسناء صيرت بيتَ قلبي","بيتَ شعرٍ يُقام بالتَّقطيع",8,"ع",1,0],["كلّ حيٍّ قاضٍ عليه زواله","وإلى هذه السبيل مآله",9,"ل",2,1],["كُلُّ حُبِّ حَشوَ قَلبي","غَيرَ حُبّيكَ حَرامُ",10,"م",1,1],["كلُّ حرفٍ زلّ عن مَرْشَفِها","نثر الطِّيبَ يميناً وشمالا",11,"ل",2,0],["كلُّ حبّ تَعمُّلٌ وهَوى الحس","ناء إياي من خلاف التعمُّلْ",12,"ل",1,0],["كلُّ حسناءَ لها ذا","مٌ وما إنْ فيك ذامُ",13,"م",1,0],["كل حي فإنما فيه نقص","وبه النسل سائر للتمام",14,"م",1,0],["كل حي فأنما هو يوما","سيلاقي من الردى ما يلاقي",15,"ق",2,0],["كُلُّ حالٍ صائِرٌ يَوماً لِضِدّ","فَدَعِ الأَقدارَ تجري وَاِستَعَدّ",16,"د",1,0],["كُلُّ حَيٍّ ما خَلا اللَهَ يَموت","فَاِترُكِ الكِبرَ لَهُ وَالجَبَروت",16,"ت",1,0],["كُلُّ حَيٍّ وَإِن تَراخَت مَنايا","هُ قَضاءٌ عَنِ الحَياةِ اِنقِطاعُه",17,"ع",2,0],["كُلُّ حَيٍّ عَلى المَنِيَّةِ غادي","تَتَوالى الرِكابُ وَالمَوتُ حادي",18,"د",2,1],["كُلَّ حينٍ مِنهُمو نابِغَةٌ","يَفضُلُ البَدرَ بَهاءً وَتَماما",19,"م",2,0],["كُلُّ حِلمٍ أَتى بِغَيرِ اِقتِدارٍ","حُجَّةٌ لاجِئٌ إِلَيها اللِئامُ",20,"م",1,0],["كل حرفٍ كتبته كان سيف","عربياً يشع منه الضياء",21,"ا",2,0],["كُلُّ حَيٍّ ضاقَتِ الأَرضُ عَنهُ","سَوفَ يَكفيهِ مِنَ الأَرضِ لَحدُ",22,"د",1,0],["كُلُّ حَيٍّ إِلى المَماتِ يَصيرُ","كُلُّ حَيٍّ مِن عَيشِهِ مَغرورُ",23,"ر",1,1],["كُلُّ حَياةٍ فَلَها مُدَّةٌ","وَكُلُّ شَيءٍ فَلَهُ آخِرُ",24,"ر",1,1],["كُلُّ حَيٍّ سَيَطعَمُ المَوتَ كَرهاً","ثُمَّ خَلفَ المَماتِ يَومٌ فَظيعُ",25,"ع",1,0],["كُلُّ حَيٍّ كِتابُهُ مَعلومُ","لا شَقاءٌ وَلا نَعيمٌ يَدومُ",26,"م",1,1],["كُلُّ حَيٍّ عِندَ ميتَتِهِ","حَظُّهُ مِن مالِهِ الكَفَنُ",27,"ن",1,0],["كُلُّ حَيٍّ مُمَلَّكٍ","سَوفَ يَفنى وَما مَلَك",28,"ك",1,0],["كُلُّ حَياةٍ إِلى مَماتٍ","وَكُلُّ ذي جِدَّةٍ يَحولُ",29,"ل",1,1],["كُلَّ حينٍ أَلحى الخُطوبَ عَلى فَق","دِ حَبيبٍ وَأَعتِبُ الأَقدارا",30,"ر",2,0],["كلُّ حُسْنٍ كامِلٍ في خَلقها","لَيتها تَنجو منَ العينِ بعاب",31,"ب",1,0],["كُلُّ حالٍ تَلقاهُ فيها وَلَكِن","لَيسَ يُلقى في حالَةٍ مَذموما",32,"م",2,0],["كُلُّ حِصنٍ مِن ذي الكَلاعِ وَأَكشو","ثاءَ أَطلَقتَ فيهِ يَوماً عِصيبا",33,"ب",2,0],["كُلُّ حَيّ يَظُنُّ أَمْرَاً وَلَكِنْ","أَيْنَ مِنْهُ مَحَجَّةُ الْبُرْهَانِ",34,"ن",1,0],["كلُّ حيٍّ حين يرمي عن يدٍ","مُوثَقُ القُوّةِ مغلولُ اليدَيْنْ",35,"ن",1,0],["كلٌّ حرامٌ على كلٍّ فإنْ فِئَةٌ","بَغَتْ على فِئةٍ فاللّهُ في الطَّلَبِ",36,"ب",1,0],["كلُّ حربٍ خمدَتْ نِيرَانُها","منذُ حِينٍ وَهْيَ حَرَّى تَتَّقِدْ",37,"د",1,0],["كُلُّ حَيٍّ مُستَكمِلٌ عِدَّةَ العُم","رِ وَمودٍ إِذا اِنقَضى عَدَدُه",38,"د",2,0],["كَلَحظَةِ بازٍ صائِدٍ قَبلَ كَفِّهِ","بِمُقلَتِهِ وَالطَيرُ عَنهُ بَوارِحُ",39,"ح",1,0],["كُلُّ حاجاتي تَناوَلَها","وَهوَ لَم تَنقُص قُوى أَشَرِه",40,"ر",2,0],["كُلُّ حَيٍّ يُقالُ فيهِ وَذو الحِل","مِ مُريحٌ وَلِلسَفيهِ الشَقاءُ",41,"ا",2,0],["كل حيٍّ به يعيش ويردى","وكما قد أراد تجري الأمور",42,"ر",1,0],["كل حلمٍ أتى بغير اقتدار","حجةٌ لاجىءٌ إليها اللئام",43,"م",1,0],["كلُّ حيٍّ وجمادٍ ههنا","هاتفٌ يدعو الحبيبَ المحسِنا",44,"ن",2,0],["كلُّ حَليفٍ حَدُّهُ حالِفٌ","أنْ سيُرى مُخْتَضِباً بالدم",45,"م",1,0],["كلّ حسن أرى محيّاك فيه","فأطيل الإمعان والتحديقا",46,"ق",2,0],["كُلُّ حَيٍّ تَقُودُهُ كَفُ هَادٍ","جِنَّ عَينٍ يُغشيهِ ما هُوَ لاقي",47,"ق",2,0],["كُلُّ حَيٍّ سَيَمُوتُ","لَيْسَ فِي الدُّنيا ثُبُوتُ",48,"ت",1,1],["كُلَّ حَفْلٍ شَهِدْتَهُ كُنْتَ فِيه","قِبْلَةَ السَّامِعِينَ وَالأَشْهَادِ",49,"د",1,0],["كُلُّ حَالٍ أَحَالَهَا الذُّعْرُ حَتَّى","أَنْكَرَتْ أُخْرَيَاتِهِنَّ المَبَادِي",50,"د",2,0],["كل حق لم تسقهِ لضَياعٍ","كلّ صرح لم تبنِهِ لتَبابِ",51,"ب",1,0],["كلَّ حُسامي وَأَنتَ ناءٍ","فَلَيسَ في الهامِ بِالمَحيكِ",52,"ك",1,0],["كلّ حرف من لفظك الحلو فردو","س نديّ وسلسبيل مسلسل",53,"ل",1,0],["كل حيَّ له كتابٌ، ولكن","أعجم الله خطه إعجاما!",54,"م",2,0],["كل حي السعته حمة","أعيت الراقي فيها والحيل",55,"ل",1,0],["كل حين وكل شبر زحام","من ركام الوحول يتلو زحاما",56,"م",2,0],["كلّ حسناء زهرة : هل يردّ الزه","ر عنه حتّى الذباب المغيره ؟",57,"ر",2,0],["كل حي وإن تملأ عيشاً","آخذ من سهامها بنصيبِ",58,"ب",1,0],["كلّ حسن بدعة مفردة","ليس بين الحسن والحسن إخاء",59,"ا",2,0],["كلّ حوراء على أجفانها","يحلم السّحر ويغفو الإشتهاء",59,"ا",2,0],["كلُّ حرفٍ كتبتهُ كانَ سيفاً","عربيّاً يشعُّ منهُ الضياءُ",60,"ا",2,0],["كل حي لسوف تحمله","يوماً لمثواك مرغماً أعواد",61,"د",1,0],["كُلُّ حَيٍّ وَإِن تَمَلّى بِعُمرٍ","آخِذٌ مِن مَذاقِها بِنَصيبِ",62,"ب",1,0],["كُلُّ حَسناءَ لا تَجودُ بِإِحسا","نٍ وَرودٍ لا تُحسِنُ الإِروادا",63,"د",2,0],["كُلُّ حَيٍّ إلَى الفَنَاءِ ورَبِّي","كَلُّ حَيٍّ إلى الرَّحِيلِ المُحَتَّمْ",64,"م",1,0],["كلَّ حين تُصغي لما قال هلّا","بعضَ حين تُصغي إلى ما أَقول",65,"ل",1,0],["كلح الزمان إلى الورى","فشقوا بقبح كلوحه",66,"ح",2,1],["كلُّ حرفٍ سيفٌ ورمحٌ وسهمٌ","وَمِجنٌّ ونثرةٌ حصداءُ",67,"ا",2,0],["كلحظكِ أو أمضى وإن كانَ آسيا","جراحَ اللواتي ما لهنَّ قرابُ",68,"ب",1,0],["كل حرب لها بشائر صلح","غير حرب سعيرها في فؤادي",69,"ي",1,0],["كُلُّ حَيٍّ يَموتُ إِلّا هَوانا","أَعلى الأَرضِ مَن يُحِبُّ سِوانا",70,"ن",2,1],["كلُّ حيّ إلى الفناء يصيرُ","والليالي تَعِلَّةٌ وغُرورُ",71,"ر",1,1],["كَلَحَ الحِمامُ بِهِ فَأَب","رَقَ في نَواحيهِ وَأَرعَد",72,"د",1,0],["كلّ حي يقيم يوماً على الضيم","جبان أحرى به قعر رمس",73,"س",1,0],["كلّ حينٍ لربّنا نفحات","فتعرّض لها بقلب طهور",74,"ر",1,0],["كل حين تجلى بثوب جديد","من أعاجيب فنّها مغزول",75,"ل",1,0],["كل حبّ مصيره اللذّهاب","غير حبّ الشفيع يوم الحساب",76,"ب",1,1],["كل حزب بما لديهم قرير","يا لقومي من كثرة الأحزاب",76,"ب",1,0],["كل حيٍّ له لسان وهذا","وحده ناطقٌ بألف لسان",77,"ن",1,0],["كُلُّ حَرفٍ مِنَ الكِتابِ كِتابٌ","مُحكَمٌ ما لِحُكمِهِ الدَهرُ نَسخُ",78,"خ",1,1],["كُلّ حَيّ سِوى المهيمن فاني","فَاِتَّقوا اللَه يا ذَوي العرفانِ",79,"ن",1,1],["كُلٌّ حَوى وَصف الرُجولة إِذ بَدا","في طرس خَدّيهِ لَنا عُنوانهُ",80,"ن",2,0],["كُلُّ حَربٍ سَمِعوا يوماً بها","أوقَعوها بين أيّامي وبَيْني",81,"ن",2,0],["كُلٌّ حَنايا تُصيبُ الدَّهْرَ أَسهمُها ال","أَغراضَ وهْي عنِ الأقواسِ لم تَزُل",82,"ل",1,0],["كُلٌّ حَوالَيْكَ أمثالٌ نُشاهِدُها","وأنت ما بينَهمْ فَرْدٌ بلا مَثَل",82,"ل",1,0],["كلُّ حبيبٍ تذيبُ فرقته الأحشا","ولا مثل فرقة الولد",83,"د",1,0],["كلّ حينٍ أجيل فكري وطرفي","في فنون مثل الرياض نضارَهْ",84,"ر",2,0],["كلّ حُسنٍ في الخَلقِ مُجتمِعٌ في","كَ فبِاللهِ لا تَشِنْهُ وصُنْهُ",85,"ن",2,0],["كلّ حِلي من فخارٍ وعُلًى","كانَ حِلياً من حُلاهم مستعارا",86,"ر",2,0],["كلّ حَبانا بعدْن في رُبى عدَنٍ","رضوانُك ابنُ بِلالٍ قبلَ رُضْوانِ",87,"ن",1,0],["كلّح الوجه وأبدى","لي سوء الفعلان",88,"ن",1,0],["كلٌّ حَباكُم أَميرُ المؤمنين بِهِ","كما بقربكُمُ الرَّحْمنُ حابانا",89,"ن",2,0],["كل حسن تراه مني وعني","وبدوني ضياؤها تغليس",90,"س",1,0],["كل حمد لما صنعتم قليل","وافر الشكر قاصر والطويل",91,"ل",1,1],["كل حي أرى وكل جماد يتغذى من","روحك السرمديّه",92,"ي",2,0],["كلح الصباحُ بموته من ليلةٍ","نفضت على وجه الصباح ظلامَها",93,"م",3,0],["كلّ حسَرى الجبين عاريةِ الجس","م فمن ذا أحلَّ هتكَ الحُرمَهْ",94,"م",2,0],["كلّ حامٍ لسرحه قائم الحف","ظ على رعيه أمين الكفالَهْ",95,"ل",2,0],["كلُّ حِمى مِئزرِه","حديقةٌ لا تُختَلى",96,"ل",2,0],["كلُّ حصاة بتراء تُنبَذ بال","وادي حسامٌ من كفّه باترْ",97,"ر",1,0],["كلُّ حِلِّ العِرْضِ محمي الثَّرا","لا ينالُ المجدَ ما عاشَ ولَنْ",98,"ن",1,0],["كلُّ حرف كأنه الحجر","الأسود فينا مقَّبل ملثوم",99,"م",1,0],["كل حرفٍ يحلُّهُ كفؤ معنى","تتهانى به بناتُ الصُّدور",100,"ر",1,0],["كل حمراءَ ما أشبهها في الكأس","إلاَّ بنار إبراهيم",101,"م",1,0],["كلُّ حالٍ لا بدَّ آناً يحول","وظلال الشأنين يوماً يزول",102,"ل",1,1],["كُلَّ حِينٍ تَرْوي فَيُروِي غَليلاً","وَبِهِ يَشْتَفَى ويَشْفَى العَلِيلُ",103,"ل",1,0],["كل حمد فذاك منه إليه","راجع حيثما تنزَّل ماء",10