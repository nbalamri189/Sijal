,"الخفيف"],[332,"هائم الروح بالهوى والأماني","https://www.aldiwan.net/poem54990.html","الخفيف"],[353,"كل حرف من الكتاب كتاب","https://www.aldiwan.net/poem15563.html","مجزوء الخفيف"],[357,"كل حي سوى المهيمن فاني","https://www.aldiwan.net/poem39759.html","الخفيف"],[357,"انظر مناقب فرقدي فلك التقى","https://www.aldiwan.net/poem39765.html","الكامل"],[368,"حسن الهجر مع القرب لعيني","https://www.aldiwan.net/poem60622.html","الرمل"],[368,"اليوم يومي ويوم الأينق الذلل","https://www.aldiwan.net/poem60675.html","البسيط"],[406,"قبر حوى قطعة من الكبد","https://www.aldiwan.net/poem46435.html","المنسرح"],[406,"سالكا من فنونه كل شعب","https://www.aldiwan.net/poem46477.html","الخفيف"],[413,"يا هلالا إذا تبدى يراه","https://www.aldiwan.net/poem32519.html","الخفيف"],[420,"قدحت في مزجها بالماء نارا","https://www.aldiwan.net/poem54186.html","الرمل"],[436,"احكم على الثقلين الإنس والجان","https://www.aldiwan.net/poem12753.html","البسيط"],[441,"لي صديق من أبر الناس","https://www.aldiwan.net/poem2510.html","مجزوء الرمل"],[443,"بشراك أيتها الدنيا وبشرانا","https://www.aldiwan.net/poem34881.html","البسيط"],[447,"أهي الجنة التي وعد الله","https://www.aldiwan.net/poem55987.html","عموديه"],[447,"كل حمد لما صنعتم قليل","https://www.aldiwan.net/poem56020.html","عموديه"],[456,"من فؤادي يا أم هذي التحية","https://www.aldiwan.net/poem61332.html","الخفيف"],[461,"من جب غارب هاشم وسنامها","https://www.aldiwan.net/poem55867.html","الكامل"],[461,"ما على منجد رأى ما أهمه","https://www.aldiwan.net/poem55903.html","الخفيف"],[461,"ذكر العيش بالحمى فبكى له","https://www.aldiwan.net/poem55940.html","الخفيف"],[461,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[461,"هل لقتيل على اللوى ثائر","https://www.aldiwan.net/poem56169.html","المنسرح"],[464,"يا لقومي من تيمي دعوة","https://www.aldiwan.net/poem15136.html","الرمل"],[467,"ولهي في الهوى حديث قديم","https://www.aldiwan.net/poem3279.html","عموديه"],[467,"بك طالت يد الزمان القصيرِ","https://www.aldiwan.net/poem3316.html","عموديه"],[467,"ورياضِ محنية دفنت بها الأسى","https://www.aldiwan.net/poem3382.html","عموديه"],[503,"كل حال لا بد آنا يحول","https://www.aldiwan.net/poem37568.html","الخفيف"],[532,"هل إلى وصل من هويت سبيل","https://www.aldiwan.net/poem37274.html","الخفيف"],[561,"حضرة الغيب سترها الأشياء","https://www.aldiwan.net/poem35077.html","الخفيف"],[565,"تلك أيامنا عليها السلام","https://www.aldiwan.net/poem52965.html","الخفيف"],[565,"لمن الدمع بعد هذا تصون","https://www.aldiwan.net/poem52978.html","الخفيف"],[803,"","https://poetry.dctabudhabi.ae/diwan/poem/202201","الخفيف"],[1103,"","https://poetry.dctabudhabi.ae/diwan/poem/122154","الرمل"]],"verses":[["كُلُّ حَبيبٍ أَبَداً","أَيّامُهُ قَلائِلُ",0,"ل",1,0],["كُلُّ حَيٍّ يُغالِطُ العَيشَ بِالدَه","رِ وَكُلٌّ تَعدو عَلَيهِ العَوادي",1,"د",2,0],["كُلُّ حَبسٍ يَهونُ عِندَ اللَيالي","بَعدَ حَبسِ الأَرواحِ في الأَجسادِ",1,"د",1,0],["كُلُّ حُبٍّ يَبيدُ يَوماً فَيفنَى","وَهَوانا وَهَجرُنا لا يَبيدُ",2,"د",1,0],["كَلِحيَةِ المُرِّ كُلَّما حُلِقَت","نَمَت نُمُوَّ الزُروعِ وَالعُشبِ",3,"ب",1,0],["كُلُّ حَدِيثٍ وَكُلُّ ذي قِدَمٍ","فِيها مُدينٌ بِفَضْلِهَا الجَمِّ",4,"م",1,0],["كُلُّ حُبٍّ إِذَا استَطَالَ سَيَبلَى","وهَوَى روضةِ المُنىَ غَيرُ بَالِي",5,"ل",2,0],["كل حد يجري إليها","ويقول وروح يرتاح",6,"ح",1,0],["كل حزب بما لديه فَخور","ولمَن هم مخالفوه خَذول",7,"ل",1,0],["كلُّ حسناء صيرت بيتَ قلبي","بيتَ شعرٍ يُقام بالتَّقطيع",8,"ع",1,0],["كلّ حيٍّ قاضٍ عليه زواله","وإلى هذه السبيل مآله",9,"ل",2,1],["كُلُّ حُبِّ حَشوَ قَلبي","غَيرَ حُبّيكَ حَرامُ",10,"م",1,1],["كلُّ حرفٍ زلّ عن مَرْشَفِها","نثر الطِّيبَ يميناً وشمالا",11,"ل",2,0],["كلُّ حبّ تَعمُّلٌ وهَوى الحس","ناء إياي من خلاف التعمُّلْ",12,"ل",1,0],["كلُّ حسناءَ لها ذا","مٌ وما إنْ فيك ذامُ",13,"م",1,0],["كل حي فإنما فيه نقص","وبه النسل سائر للتمام",14,"م",1,0],["كل حي فأنما هو يوما","سيلاقي من الردى ما يلاقي",15,"ق",2,0],["كُلُّ حالٍ صائِرٌ يَوماً لِضِدّ","فَدَعِ الأَقدارَ تجري وَاِستَعَدّ",16,"د",1,0],["كُلُّ حَيٍّ ما خَلا اللَهَ يَموت","فَاِترُكِ الكِبرَ لَهُ وَالجَبَروت",16,"ت",1,0],["كُلُّ حَيٍّ وَإِن تَراخَت مَنايا","هُ قَضاءٌ عَنِ الحَياةِ اِنقِطاعُه",17,"ع",2,0],["كُلُّ حَيٍّ عَلى المَنِيَّةِ غادي","تَتَوالى الرِكابُ وَالمَوتُ حادي",18,"د",2,1],["كُلَّ حينٍ مِنهُمو نابِغَةٌ","يَفضُلُ البَدرَ بَهاءً وَتَماما",19,"م",2,0],["كُلُّ حِلمٍ أَتى بِغَيرِ اِقتِدارٍ","حُجَّةٌ لاجِئٌ إِلَيها اللِئامُ",20,"م",1,0],["كل حرفٍ كتبته كان سيف","عربياً يشع منه الضياء",21,"ا",2,0],["كُلُّ حَيٍّ ضاقَتِ الأَرضُ عَنهُ","سَوفَ يَكفيهِ مِنَ الأَرضِ لَحدُ",22,"د",1,0],["كُلُّ حَيٍّ إِلى المَماتِ يَصيرُ","كُلُّ حَيٍّ مِن عَيشِهِ مَغرورُ",23,"ر",1,1],["كُلُّ حَياةٍ فَلَها مُدَّةٌ","وَكُلُّ شَيءٍ فَلَهُ آخِرُ",24,"ر",1,1],["كُلُّ حَيٍّ سَيَطعَمُ المَوتَ كَرهاً","ثُمَّ خَلفَ المَماتِ يَومٌ فَظيعُ",25,"ع",1,0],["كُلُّ حَيٍّ كِتابُهُ مَعلومُ","لا شَقاءٌ وَلا نَعيمٌ يَدومُ",26,"م",1,1],["كُلُّ حَيٍّ عِندَ ميتَتِهِ","حَظُّهُ مِن مالِهِ الكَفَنُ",27,"ن",1,0],["كُلُّ حَيٍّ مُمَلَّكٍ","سَوفَ يَفنى وَما مَلَك",28,"ك",1,0],["كُلُّ حَياةٍ إِلى مَماتٍ","وَكُلُّ ذي جِدَّةٍ يَحولُ",29,"ل",1,1],["كُلَّ حينٍ أَلحى الخُطوبَ عَلى فَق","دِ حَبيبٍ وَأَعتِبُ الأَقدارا",30,"ر",2,0],["كلُّ حُسْنٍ كامِلٍ في خَلقها","لَيتها تَنجو منَ العينِ بعاب",31,"ب",1,0],["كُلُّ حالٍ تَلقاهُ فيها وَلَكِن","لَيسَ يُلقى في حالَةٍ مَذموما",32,"م",2,0],["كُلُّ حِصنٍ مِن ذي الكَلاعِ وَأَكشو","ثاءَ أَطلَقتَ فيهِ يَوماً عِصيبا",33,"ب",2,0],["كُلُّ حَيّ يَظُنُّ أَمْرَاً وَلَكِنْ","أَيْنَ مِنْهُ مَحَجَّةُ الْبُرْهَانِ",34,"ن",1,0],["كلُّ حيٍّ حين يرمي عن يدٍ","مُوثَقُ القُوّةِ مغلولُ اليدَيْنْ",35,"ن",1,0],["كلٌّ حرامٌ على كلٍّ فإنْ فِئَةٌ","بَغَتْ على فِئةٍ فاللّهُ في الطَّلَبِ",36,"ب",1,0],["كلُّ حربٍ خمدَتْ نِيرَانُها","منذُ حِينٍ وَهْيَ حَرَّى تَتَّقِدْ",37,"د",1,0],["كُلُّ حَيٍّ مُستَكمِلٌ عِدَّةَ العُم","رِ وَمودٍ إِذا اِنقَضى عَدَدُه",38,"د",2,0],["كَلَحظَةِ بازٍ صائِدٍ قَبلَ كَفِّهِ","بِمُقلَتِهِ وَالطَيرُ عَنهُ بَوارِحُ",39,"ح",1,0],["كُلُّ حاجاتي تَناوَلَها","وَهوَ لَم تَنقُص قُوى أَشَرِه",40,"ر",2,0],["كُلُّ حَيٍّ يُقالُ فيهِ وَذو الحِل","مِ مُريحٌ وَلِلسَفيهِ الشَقاءُ",41,"ا",2,0],["كل حيٍّ به يعيش ويردى","وكما قد أراد تجري الأمور",42,"ر",1,0],["كل حلمٍ أتى بغير اقتدار","حجةٌ لاجىءٌ إليها اللئام",43,"م",1,0],["كلُّ حيٍّ وجمادٍ ههنا","هاتفٌ يدعو الحبيبَ المحسِنا",44,"ن",2,0],["كلُّ حَليفٍ حَدُّهُ حالِفٌ","أنْ سيُرى مُخْتَضِباً بالدم",45,"م",1,0],["كلّ حسن أرى محيّاك فيه","فأطيل الإمعان والتحديقا",46,"ق",2,0],["كُلُّ حَيٍّ تَقُودُهُ كَفُ هَادٍ","جِنَّ عَينٍ يُغشيهِ ما هُوَ لاقي",47,"ق",2,0],["كُلُّ حَيٍّ سَيَمُوتُ","لَيْسَ فِي الدُّنيا ثُبُوتُ",48,"ت",1,1],["كُلَّ حَفْلٍ شَهِدْتَهُ كُنْتَ فِيه","قِبْلَةَ السَّامِعِينَ وَالأَشْهَادِ",49,"د",1,0],["كُلُّ حَالٍ أَحَالَهَا الذُّعْرُ حَتَّى","أَنْكَرَتْ أُخْرَيَاتِهِنَّ المَبَادِي",50,"د",2,0],["كل حق لم تسقهِ لضَياعٍ","كلّ صرح لم تبنِهِ لتَبابِ",51,"ب",1,0],["كلَّ حُسامي وَأَنتَ ناءٍ","فَلَيسَ في الهامِ بِالمَحيكِ",52,"ك",1,0],["كلّ حرف من لفظك الحلو فردو","س نديّ وسلسبيل مسلسل",53,"ل",1,0],["كل حيَّ له كتابٌ، ولكن","أعجم الله خطه إعجاما!",54,"م",2,0],["كل حي السعته حمة","أعيت الراقي فيها والحيل",55,"ل",1,0],["كل حين وكل شبر زحام","من ركام الوحول يتلو زحاما",56,"م",2,0],["كلّ حسناء زهرة : هل يردّ الزه","ر عنه حتّى الذباب المغيره ؟",57,"ر",2,0],["كل حي وإن تملأ عيشاً","آخذ من سهامها بنصيبِ",58,"ب",1,0],["كلّ حسن بدعة مفردة","ليس بين الحسن والحسن إخاء",59,"ا",2,0],["كلّ حوراء على أجفانها","يحلم السّحر ويغفو الإشتهاء",59,"ا",2,0],["كلُّ حرفٍ كتبتهُ كانَ سيفاً","عربيّاً يشعُّ منهُ الضياءُ",60,"ا",2,0],["كل حي لسوف تحمله","يوماً لمثواك مرغماً أعواد",61,"د",1,0],["كُلُّ حَيٍّ وَإِن تَمَلّى بِعُمرٍ","آخِذٌ مِن مَذاقِها بِنَصيبِ",62,"ب",1,0],["كُلُّ حَسناءَ لا تَجودُ بِإِحسا","نٍ وَرودٍ لا تُحسِنُ الإِروادا",63,"د",2,0],["كُلُّ حَيٍّ إلَى الفَنَاءِ ورَبِّي","كَلُّ حَيٍّ إلى الرَّحِيلِ المُحَتَّمْ",64,"م",1,0],["كلَّ حين تُصغي لما قال هلّا","بعضَ حين تُصغي إلى ما أَقول",65,"ل",1,0],["كلح الزمان إلى الورى","فشقوا بقبح كلوحه",66,"ح",2,1],["كلُّ حرفٍ سيفٌ ورمحٌ وسهمٌ","وَمِجنٌّ ونثرةٌ حصداءُ",67,"ا",2,0],["كلحظكِ أو أمضى وإن كانَ آسيا","جراحَ اللواتي ما لهنَّ قرابُ",68,"ب",1,0],["كل حرب لها بشائر صلح","غير حرب سعيرها في فؤادي",69,"ي",1,0],["كُلُّ حَيٍّ يَموتُ إِلّا هَوانا","أَعلى الأَرضِ مَن يُحِبُّ سِوانا",70,"ن",2,1],["كلُّ حيّ إلى الفناء يصيرُ","والليالي تَعِلَّةٌ وغُرورُ",71,"ر",1,1],["كَلَحَ الحِمامُ بِهِ فَأَب","رَقَ في نَواحيهِ وَأَرعَد",72,"د",1,0],["كلّ حي يقيم يوماً على الضيم","جبان أحرى به قعر رمس",73,"س",1,0],["كلّ حينٍ لربّنا نفحات","فتعرّض لها بقلب طهور",74,"ر",1,0],["كل حين تجلى بثوب جديد","من أعاجيب فنّها مغزول",75,"ل",1,0],["كل حبّ مصيره اللذّهاب","غير حبّ الشفيع يوم الحساب",76,"ب",1,1],["كل حزب بما لديهم قرير","يا لقومي من كثرة الأحزاب",76,"ب",1,0],["كل حيٍّ له لسان وهذا","وحده ناطقٌ بألف لسان",77,"ن",1,0],["كُلُّ حَرفٍ مِنَ الكِتابِ كِتابٌ","مُحكَمٌ ما لِحُكمِهِ الدَهرُ نَسخُ",78,"خ",1,1],["كُلّ حَيّ سِوى المهيمن فاني","فَاِتَّقوا اللَه يا ذَوي العرفانِ",79,"ن",1,1],["كُلٌّ حَوى وَصف الرُجولة إِذ بَدا","في طرس خَدّيهِ لَنا عُنوانهُ",80,"ن",2,0],["كُلُّ حَربٍ سَمِعوا يوماً بها","أوقَعوها بين أيّامي وبَيْني",81,"ن",2,0],["كُلٌّ حَنايا تُصيبُ الدَّهْرَ أَسهمُها ال","أَغراضَ وهْي عنِ الأقواسِ لم تَزُل",82,"ل",1,0],["كُلٌّ حَوالَيْكَ أمثالٌ نُشاهِدُها","وأنت ما بينَهمْ فَرْدٌ بلا مَثَل",82,"ل",1,0],["كلُّ حبيبٍ تذيبُ فرقته الأحشا","ولا مثل فرقة الولد",83,"د",1,0],["كلّ حينٍ أجيل فكري وطرفي","في فنون مثل الرياض نضارَهْ",84,"ر",2,0],["كلّ حُسنٍ في الخَلقِ مُجتمِعٌ في","كَ فبِاللهِ لا تَشِنْهُ وصُنْهُ",85,"ن",2,0],["كلّ حِلي من فخارٍ وعُلًى","كانَ حِلياً من حُلاهم مستعارا",86,"ر",2,0],["كلّ حَبانا بعدْن في رُبى عدَنٍ","رضوانُك ابنُ بِلالٍ قبلَ رُضْوانِ",87,"ن",1,0],["كلّح الوجه وأبدى","لي سوء الفعلان",88,"ن",1,0],["كلٌّ حَباكُم أَميرُ المؤمنين بِهِ","كما بقربكُمُ الرَّحْمنُ حابانا",89,"ن",2,0],["كل حسن تراه مني وعني","وبدوني ضياؤها تغليس",90,"س",1,0],["كل حمد لما صنعتم قليل","وافر الشكر قاصر والطويل",91,"ل",1,1],["كل حي أرى وكل جماد يتغذى من","روحك السرمديّه",92,"ي",2,0],["كلح الصباحُ بموته من ليلةٍ","نفضت على وجه الصباح ظلامَها",93,"م",3,0],["كلّ حسَرى الجبين عاريةِ الجس","م فمن ذا أحلَّ هتكَ الحُرمَهْ",94,"م",2,0],["كلّ حامٍ لسرحه قائم الحف","ظ على رعيه أمين الكفالَهْ",95,"ل",2,0],["كلُّ حِمى مِئزرِه","حديقةٌ لا تُختَلى",96,"ل",2,0],["كلُّ حصاة بتراء تُنبَذ بال","وادي حسامٌ من كفّه باترْ",97,"ر",1,0],["كلُّ حِلِّ العِرْضِ محمي الثَّرا","لا ينالُ المجدَ ما عاشَ ولَنْ",98,"ن",1,0],["كلُّ حرف كأنه الحجر","الأسود فينا مقَّبل ملثوم",99,"م",1,0],["كل حرفٍ يحلُّهُ كفؤ معنى","تتهانى به بناتُ الصُّدور",100,"ر",1,0],["كل حمراءَ ما أشبهها في الكأس","إلاَّ بنار إبراهيم",101,"م",1,0],["كلُّ حالٍ لا بدَّ آناً يحول","وظلال الشأنين يوماً يزول",102,"ل",1,1],["كُلَّ حِينٍ تَرْوي فَيُروِي غَليلاً","وَبِهِ يَشْتَفَى ويَشْفَى العَلِيلُ",103,"ل",1,0],["كل حمد فذاك منه إليه","راجع حيثما تنزَّل ماء",104,"ا",2,0],["كلُّ حالٍ سينقضي ليسَ للدهْ","رِ دَوامٌ وليسَ فيهِ دَوامُ",105,"م",1,0],["كلُّ حُزنٍ بحَسْبِ كلِّ فقيدٍ","وبحَسْبِ الأحزان يبكي الحزِينُ",106,"ن",1,0],["كلُّ حَيٍّ يرجو الحياةَ ولو في ال","موتِ وهماً فماتَ وهْوَ ضنينُ",106,"ن",1,0],["كل حي يموت حقا فيفني","سبب غالب من الأسباب",107,"ب",1,0],["كُلُّ حاجاتيَ قد قضيتُها","غيرَ حاجاتي في بَطنِ الجُرُف",108,"ف",1,0]]}