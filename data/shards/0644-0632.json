كَ أَوضاحاً","إِلى أَوضاحِهِ الشُهبِ",1,"ب",1,0],["لَزِمَت ظَلومُ خِلافَ أَمري كُلِّهِ","وَأَطاعَها قَلبٌ عَلَيَّ مَشومُ",2,"م",1,0],["لَزَيَّنْتَ أَجْيَادَ الْمَنَابِرِ بِالَّتِي","أتَاحَ لَهَا الرَّحْمَانُ مِنْ آلِ زِيَّانِ",3,"ن",1,0],["لَزَجَرتُ قَلباً لا يَريعُ لِزاجِرٍ","إِنَّ الغَويَّ إِذا نُهي لَم يُعتِبِ",4,"ب",1,0],["لِزَيدِ اِبنِ كَهلانَ الَّذي نالَ عِزُّهُ","قَديماً ذَرارِيَّ النُجومِ الشَوابِكِ",5,"ك",1,0],["لزم الأسى قلبي كما لزم الثنا","قاضي القضاة أبا المناقب أجمع",6,"ع",1,0],["لزهر الشقائق والبدر من","جُلا وجنتيك انتساب عريق",7,"ق",1,1],["لزَمتهُ زِجاجَها لعيونٍ","ليس فيها كوالئٌ بل كوالي",8,"ل",2,0],["لزها وتاه بقُبْحه","تِيهاً يحاقِرُ كلَّ تيهِ",9,"ي",2,0],["لِزَيدِ اللاتِ أَقدامٌ صِغارٌ","قَليلٌ أَخذُهُنَّ مِنَ النِعالِ",10,"ل",1,0],["لَزُرتُكُم لا أُكافيكُم بِجَفوَتِكم","مَشيا عَلى الوَجه أَو سَعيا عَلى الرأسِ",11,"س",1,0],["لَزِمتُ بابَ أَميرِ الأَنبِياءِ وَمَن","يُمسِك بِمِفتاحِ بابِ اللَهِ يَغتَنِمِ",12,"م",1,0],["لَزِمَ المَشايِخَ مِلَّةً قَدُمَت","بانَت فَضيلَتُها عَلى الوَلَدِ",13,"د",1,0],["لَزومُ صَبرٍ وَخَلعُ كِبرٍ","وَصَونُ عِرضٍ وِبَذلُ مالِ",14,"ل",1,0],["لَزَّت إِلى صَدرِها صَدري مُوَدَّعَةً","وَزَوَّدَتني مِنَ الإِرشافِ وَالقُبَلِ",15,"ل",1,0],["لَزِمتَ حَدَّ التُقى عَن كُلِّ فاحِشَةٍ","حَتّى كَأَنَّكَ مَعصومٌ عَنِ الزَلَلِ",15,"ل",1,0],["لَزَّت بِها ضَرَّةٌ زَهراءُ واضِحَةٌ","كَالشَمسِ أَحسَنُ مِنها عِندَ رائيها",16,"ي",3,0],["لَزِموا مَركَزَ النَدى وَذَراهُ","وَعَدَتنا عَن مِثلِ ذاكَ العَوادي",17,"د",2,0],["لِزَينَبَ إِذ تُجِدُّ لَنا","صَفاءً لَم يَكُن كَدَرا",18,"ر",2,0],["لزموا تُخُومَ بُيوتِهم وغُزاتُهم","لا يرتضون سِوَى النُّجومِ تُخُوما",19,"م",2,0],["لِزَهرَةِ البُستان في غُصنِها","الفَينان عَرفٌ يَفوح",20,"ح",1,1],["لَزِمَت حَوالِسُها النُفوسَ فَثَوَّرَت","عُصَباً تَقومُ مِنَ الحِذارِ وَتَقعُدُ",21,"د",1,0],["لِزُغبٍ كَأَولادِ القَطا راثَ خَلقُها","عَلى عاجِزاتِ النَهضِ حُمرٍ حَواصِلُه",22,"ل",2,0],["لَزمَ التَّقَلُّبَ في مَعاصِي رَبِّهِ","إذْ باتَ في نَعْمائِهِ يَتَقَلَّبُ",23,"ب",1,0],["لِزَينَبَ يَحلو جَنِيٌّ أَمَرَّ","وَقَد عَلِقَت كَفُّها بِالقَمَر",24,"ر",1,1],["لِزادِ المَرءِ آبَصَ مِن عُقابٍ","وَعِندَ البابِ أَثقَلَ مِن رَصاصِ",25,"ص",1,0],["لزم العبادة في جميع حياته","حتى ينال سعادة في الآتي",26,"ي",1,1],["لزمت بيتاً بناه الجد من مدر","كأنه بيت شعر ليس يتزن",27,"ن",1,1],["لزاز حروب يكره القوم درأه","ويمشي غلى الأقران بالسيف يخطرُ",28,"ر",1,1],["لزهْر النَّرد قد خلقت يداه","وليست لليراع، ولا الكتاب",29,"ب",1,0],["لِزُغْبٍ كأولادِ القَطَا رَاثَ خَلْفُها","على عاجزات النّهض حمرٍ حواصله",30,"ل",2,0],["لزُعزِع يومُ الطف عن مُستقَرِّه","وغُيِّرَ من تاريخه فتَطَوَّرا",31,"ر",2,0],["لزَكا \" ابولَهَبٍ \" وكانُ مُرجَّماً","ودَنَا \" صُهَيبُ \" وإنه لامام",32,"م",1,0],["لَزِموا جُحورَهُمُ وطارَ حليمُهُمْ","ذُعْراً ، وبُدِّلَتِ الأسودُ أرانبا",33,"ب",2,0],["لَزُرتُكُم، لا أُكافيكُم بِجَفوَتِكم","مَشيًا عَلى الوَجه، أَو حَبوًا عَلى الرأسِ",34,"س",1,0],["لزم الخطايا في جميع أموره","واستصحب العصيان في أعماله",35,"ل",2,0],["لزمت طول عمرها المجد والسؤ","دد والفخر والوفارَ والتزاما",36,"م",2,0],["لَزِموا المَنازِلَ وَاِكتَفَوا بِقَعاقِعٍ","مَسموعَةٍ لَكِنَّها لا تَنجَعُ",37,"ع",1,0],["لزموا التواضع والتذلل والبكا","والخوف منك ومن شديد حساب",38,"ب",1,0],["لزمتُ مختتماً من شكر مِنَّتِهِ","لزوم غيري شكراً غير مختتم",39,"م",1,0],["لزمتُ البيت مضطرا كأنّي","ذو وتر دفنت بلا جليس",40,"س",1,0],["لزم التوقّي بالهوى فلسانُه","متباعد والقلب غير مباعدِ",41,"د",1,0],["لَزُومٌ ما عَلِمتُ لباب دَارِي","لُزُومَ الكَلبِ أصحَابَ الرَّقِيمِ",42,"م",1,0],["لزيمهم في رياض الخير مغتبط","وَجارهم في نَعيم ناعم البال",43,"ل",1,0],["لزيمهم بعرا التَوفيق معتصم","وَللنزيل اليهم اكرم النزل",44,"ل",1,0],["لَزِمْتُ الصَّبْرَ حَتَّى عيل صَبْرِي","وَبانَ العُذْرُ إذْ جَدَّ الزَّماعُ",45,"ع",1,0],["لَزِمتَ مَلالاً ما تَمَلُّ لُزومَهُ","فَقَلبي عَلى جَمرِ الغَضا يَتَمَلمَلُ",46,"ل",1,0],["لزوالٍ جميعُ ما أنتَ رائي","فاعتبرْ بالظلالِ والأفياءِ",47,"ا",2,1],["لزمت بيتي كلزوم البنا","في الحرف والفعل على الأصل",48,"ل",1,1],["لزمت بيتي مثل ما قيل لي","ولم أعاند حادث الدهرِ",49,"ر",1,1],["لِزَهرِ آدابِهِ رِبحُ الصِبا اِتَّجَهَت","فَاِذكَرَتنا بِنَفحِ الطيبِ نِسمَتُهُ",50,"ت",2,0],["لُزومُ العارٍ لي طَوْقٌ","ولَومُ النّاسِ لي قُرط",51,"ط",1,0],["لزمانِ الصِّبا عليَّ حقوقٌ","أنا منهنَّ بالوفاء حقيقُ",52,"ق",1,0],["لزمَ اِبن عبادٍ وَلا","ءكُمُ الصَريحَ بِلا براح",53,"ح",1,0],["لزمت بابَ الملوك دهراً","فلم يلق ماؤهم ذنوبي",54,"ب",2,0],["لزمت عرى الدين حتى غدت","حبال التقى بكم تلتزَم",55,"م",1,0],["لزاجر أعجازِ السوابق فوقه","يقاومه طوراً وطوراً يمايلُهْ",56,"ل",2,0],["لَزِمَ الثَّنِيَّةَ لا يَلوحُ لشخصه","شَبَحٌ ولا يبدو عليه رُواءُ",57,"ا",2,0],["لزانت كنانة هذي السهام","كما زانت المرهفات الغمودا",58,"د",2,0],["لزدتُ به عاماً تعفّى جماله","وما يتساوى عالمُ وجهول",59,"ل",1,0],["لِزَمرِها نَغَماتٌ","هُنَّ الغِنى لِلغِناءِ",60,"ا",2,0],["لَزمتُ ذَيلَكَ أرجُو رِضَاكَ فَي الدَّارَين","كَفَى وُثُوقُ رَجَائِي بِلطفِكَ المُوفُور",61,"ر",1,0],["لزُيّنَ الحيُّ كي أراهُ","من قمرةِ بومَتي براحِ",62,"ح",1,0],["لزمت ملازمها وأبرم عقدها","ملك إليه النقض والإبرام",63,"م",1,0],["لَزِمتُ صدقَ وَلاهُم وَالتَزَمت بِهِ","فَلَست أَسلوهُ إِلّا عَن سُلُوّهِمِ",64,"م",1,0],["لَزَّه في قَرارةٍ تخذ اللُّج","جةَ منها كهفاً له ومَقيلا",65,"ل",2,0],["لَزاروهُ وَاِستَنزلوا عندهُ","عطاءً من المانع المائحِ",66,"ح",1,0],["لزوم ما يقتضيه المجد عن شيمي","والطبع لا يلزم المسترخص القيم",67,"م",1,0],["لزِمَتْ بهِ ثِقَةُ الجميعِ بأَنَّهُ","حقٌّ وغيرَ الحقِّ لم يَتَكَلَّمِ",68,"م",1,0],["لَزِمَ المدارِسَ في الدِّيارِ وذكرُهُ","قد سارَ في شرقِ الفضاءِ وغَرْبهِ",69,"ب",2,0],["لزوجة النبي قد أخلاها","فنزلت فيها فما رآها",70,"ه",2,0],["لزهّدني في هذه الدار موته","فسيَّانَ إِقلالٌ لديَّ وإِكْثَارُ",71,"ر",1,0],["لزايد الخير باني المجد أكمله","ولابن نهيان دانت أرفع الرتب",72,"ب",1,0],["لزمت بيتي وصنعت عرضاً","به عن الذلة امتناع",73,"ع",1,0],["لَزَهِدتَ في الدُّنيا فَلَولا عِلمُنا","بِأَبيكَ قُلنا إنَّ أُمَّكَ مَريَمُ",74,"م",1,0],["لزم السجنَ زوجُها ولصوصُ ا","لحق فازوا بسؤددٍ وعُلاءِ",75,"ا",2,0],["لِزينَبَ طَيفٌ تَعتَريني طَوارِقُهْ","هُدوءاً إِذا النَجمُ اِرجَحنَّت لَواحِقُهْ",76,"ق",2,1],["لزاز حضار يسبق الخيل عفوه","على الدفعة الأولى وف