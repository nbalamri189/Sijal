{"poems":[[53,"لنا كل يوم رنة خلف ذاهب","https://www.aldiwan.net/poem30738.html","الطويل"],[53,"يد في قائم العضب","https://www.aldiwan.net/poem30764.html","الهزج"],[55,"يا إخوتي إني لموضع رحمة","https://www.aldiwan.net/poem26113.html","الكامل"],[77,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[4,"طرب الفؤاد وليته لم يطرب","https://www.aldiwan.net/poem21150.html","الكامل"],[23,"من يك عنا معشر الأسد سائلا","https://www.aldiwan.net/poem21341.html","الطويل"],[72,"كف الملامة عن حشا المتوجع","https://www.aldiwan.net/poem19166.html","الكامل"],[72,"لزهر الشقائق والبدر من","https://www.aldiwan.net/poem19412.html","المتقارب"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"لو يعلم ابن أبي سميه","https://www.aldiwan.net/poem66739.html","مجزوء الكامل"],[29,"هنيئة في الضلال وعبد بكر","https://www.aldiwan.net/poem6131.html","الوافر"],[78,"لولا عيون من الواشين ترمقني","https://www.aldiwan.net/poem14039.html","البسيط"],[85,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[45,"لأبي علي في حداثته","https://www.aldiwan.net/poem63537.html","الطويل"],[58,"أحمد ربي على خصال","https://www.aldiwan.net/poem30888.html","مخلع البسيط"],[66,"لم أدر أن نبال الغنج والكحل","https://www.aldiwan.net/poem38479.html","البسيط"],[44,"لقد أقام على بغداد ناعيها","https://www.aldiwan.net/poem29993.html","البسيط"],[44,"سعدت غربة النوى بسعاد","https://www.aldiwan.net/poem30559.html","الخفيف"],[31,"تصابى القلب وادكرا","https://www.aldiwan.net/poem42504.html","مجزوء الوافر"],[105,"الكون أشرق نضرة ونعيما","https://www.aldiwan.net/poem42064.html","الكامل"],[81,"لزهرة البستان في غصنها","https://www.aldiwan.net/poem61387.html","الكامل"],[39,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[22,"عفا توأم من أهله فجلاجله","https://www.aldiwan.net/poem21649.html","الطويل"],[67,"وافاك بالذنب العظيم المذنب","https://www.aldiwan.net/poem18038.html","الكامل"],[46,"لزينب يحلو جني أمر","https://www.aldiwan.net/poem22745.html","المتقارب"],[15,"أرقت لضوء برق في نشاص","https://www.aldiwan.net/poem45263.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85816","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147578","البسيط"],[36,"لزاز حروب يكره القوم درأه","https://www.poetsgate.com/ViewPoem.aspx?id=15871",""],[106,"أنصاف رجال","https://www.poetsgate.com/ViewPoem.aspx?id=179440",""],[22,"عَفَا تَوْءَمٌ مِنْ أَهْلِهِ فَجُلاجِلُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=19805",""],[90,"عاشوراء","https://www.poetsgate.com/ViewPoem.aspx?id=179150",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[78,"لولا عُيونٌ مِنَ الواشينَ تَرمُقُني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86484&r=&rc=29",""]],"verses":[["لُزِزنا مِنَ الدَهرِ الخَؤونِ بِمِصدَمٍ","يُحَطِّمُ أَشلاءَ القَرينِ المَجاذِبِ",0,"ب",1,0],["لَزِدتَ المُلكَ أَوضاحاً","إِلى أَوضاحِهِ الشُهبِ",1,"ب",1,0],["لَزِمَت ظَلومُ خِلافَ أَمري كُلِّهِ","وَأَطاعَها قَلبٌ عَلَيَّ مَشومُ",2,"م",1,0],["لَزَيَّنْتَ أَجْيَادَ الْمَنَابِرِ بِالَّتِي","أتَاحَ لَهَا الرَّحْمَانُ مِنْ آلِ زِيَّانِ",3,"ن",1,0],["لَزَجَرتُ قَلباً لا يَريعُ لِزاجِرٍ","إِنَّ الغَويَّ إِذا نُهي لَم يُعتِبِ",4,"ب",1,0],["لِزَيدِ اِبنِ كَهلانَ الَّذي نالَ عِزُّهُ","قَديماً ذَرارِيَّ النُجومِ الشَوابِكِ",5,"ك",1,0],["لزم الأسى قلبي كما لزم الثنا","قاضي القضاة أبا المناقب أجمع",6,"ع",1,0],["لزهر الشقائق والبدر من","جُلا وجنتيك انتساب عريق",7,"ق",1,1],["لزَمتهُ زِجاجَها لعيونٍ","ليس فيها كوالئٌ بل كوالي",8,"ل",2,0],["لزها وتاه بقُبْحه","تِيهاً يحاقِرُ كلَّ تيهِ",9,"ي",2,0],["لِزَيدِ اللاتِ أَقدامٌ صِغارٌ","قَليلٌ أَخذُهُنَّ مِنَ النِعالِ",10,"ل",1,0],["لَزُرتُكُم لا أُكافيكُم بِجَفوَتِكم","مَشيا عَلى الوَجه أَو سَعيا عَلى الرأسِ",11,"س",1,0],["لَزِمتُ بابَ أَميرِ الأَنبِياءِ وَمَن","يُمسِك بِمِفتاحِ بابِ اللَهِ يَغتَنِمِ",12,"م",1,0],["لَزِمَ المَشايِخَ مِلَّةً قَدُمَت","بانَت فَضيلَتُها عَلى الوَلَدِ",13,"د",1,0],["لَزومُ صَبرٍ وَخَلعُ كِبرٍ","وَصَونُ عِرضٍ وِبَذلُ مالِ",14,"ل",1,0],["لَزَّت إِلى صَدرِها صَدري مُوَدَّعَةً","وَزَوَّدَتني مِنَ الإِرشافِ وَالقُبَلِ",15,"ل",1,0],["لَزِمتَ حَدَّ التُقى عَن كُلِّ فاحِشَةٍ","حَتّى كَأَنَّكَ مَعصومٌ عَنِ الزَلَلِ",15,"ل",1,0],["لَزَّت بِها ضَرَّةٌ زَهراءُ واضِحَةٌ","كَالشَمسِ أَحسَنُ مِنها عِندَ رائيها",16,"ي",3,0],["لَزِموا مَركَزَ النَدى وَذَراهُ","وَعَدَتنا عَن مِثلِ ذاكَ العَوادي",17,"د",2,0],["لِزَينَبَ إِذ تُجِدُّ لَنا","صَفاءً لَم يَكُن كَدَرا",18,"ر",2,0],["لزموا تُخُومَ بُيوتِهم وغُزاتُهم","لا يرتضون سِوَى النُّجومِ تُخُوما",19,"م",2,0],["لِزَهرَةِ البُستان في غُصنِها","الفَينان عَرفٌ يَفوح",20,"ح",1,1],["لَزِمَت حَوالِسُها النُفوسَ فَثَوَّرَت","عُصَباً تَقومُ مِنَ الحِذارِ وَتَقعُدُ",21,"د",1,0],["لِزُغبٍ كَأَولادِ القَطا راثَ خَلقُها","عَلى عاجِزاتِ النَهضِ حُمرٍ حَواصِلُه",22,"ل",2,0],["لَزمَ التَّقَلُّبَ في مَعاصِي رَبِّهِ","إذْ باتَ في نَعْمائِهِ يَتَقَلَّبُ",23,"ب",1,0],["لِزَينَبَ يَحلو جَنِيٌّ أَمَرَّ","وَقَد عَلِقَت كَفُّها بِالقَمَر",24,"ر",1,1],["لِزادِ المَرءِ آبَصَ مِن عُقابٍ","وَعِندَ البابِ أَثقَلَ مِن رَصاصِ",25,"ص",1,0],["لزم العبادة في جميع حياته","حتى ينال سعادة في الآتي",26,"ي",1,1],["لزمت بيتاً بناه الجد من مدر","كأنه بيت شعر ليس يتزن",27,"ن",1,1],["لزاز حروب يكره القوم درأه","ويمشي غلى الأقران بالسيف يخطرُ",28,"ر",1,1],["لزهْر النَّرد قد خلقت يداه","وليست لليراع، ولا الكتاب",29,"ب",1,0],["لِزُغْبٍ كأولادِ القَطَا رَاثَ خَلْفُها","على عاجزات النّهض حمرٍ حواصله",30,"ل",2,0],["لزُعزِع يومُ الطف عن مُستقَرِّه","وغُيِّرَ من تاريخه فتَطَوَّرا",31,"ر",2,0],["لزَكا \" ابولَهَبٍ \" وكانُ مُرجَّماً","ودَنَا \" صُهَيبُ \" وإنه لامام",32,"م",1,0],["لَزِموا جُحورَهُمُ وطارَ حليمُهُمْ","ذُعْراً ، وبُدِّلَتِ الأسودُ أرانبا",33,"ب",2,0],["لَزُرتُكُم، لا أُكافيكُم بِجَفوَتِكم","مَشيًا عَلى الوَجه، أَو حَبوًا عَلى الرأسِ",34,"س",1,0]]}