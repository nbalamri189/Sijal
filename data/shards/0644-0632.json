{"poems":[[53,"لنا كل يوم رنة خلف ذاهب","https://www.aldiwan.net/poem30738.html","الطويل"],[53,"يد في قائم العضب","https://www.aldiwan.net/poem30764.html","الهزج"],[55,"يا إخوتي إني لموضع رحمة","https://www.aldiwan.net/poem26113.html","الكامل"],[77,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[4,"طرب الفؤاد وليته لم يطرب","https://www.aldiwan.net/poem21150.html","الكامل"],[23,"من يك عنا معشر الأسد سائلا","https://www.aldiwan.net/poem21341.html","الطويل"],[72,"كف الملامة عن حشا المتوجع","https://www.aldiwan.net/poem19166.html","الكامل"],[72,"لزهر الشقائق والبدر من","https://www.aldiwan.net/poem19412.html","المتقارب"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"لو يعلم ابن أبي سميه","https://www.aldiwan.net/poem66739.html","مجزوء الكامل"],[29,"هنيئة في الضلال وعبد بكر","https://www.aldiwan.net/poem6131.html","الوافر"],[78,"لولا عيون من الواشين ترمقني","https://www.aldiwan.net/poem14039.html","البسيط"],[85,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[45,"لأبي علي في حداثته","https://www.aldiwan.net/poem63537.html","الطويل"],[58,"أحمد ربي على خصال","https://www.aldiwan.net/poem30888.html","مخلع البسيط"],[66,"لم أدر أن نبال الغنج والكحل","https://www.aldiwan.net/poem38479.html","البسيط"],[44,"لقد أقام على بغداد ناعيها","https://www.aldiwan.net/poem29993.html","البسيط"],[44,"سعدت غربة النوى بسعاد","https://www.aldiwan.net/poem30559.html","الخفيف"],[31,"تصابى القلب وادكرا","https://www.aldiwan.net/poem42504.html","مجزوء الوافر"],[105,"الكون أشرق نضرة ونعيما","https://www.aldiwan.net/poem42064.html","الكامل"],[81,"لزهرة البستان في غصنها","https://www.aldiwan.net/poem61387.html","الكامل"],[39,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[22,"عفا توأم من أهله فجلاجله","https://www.aldiwan.net/poem21649.html","الطويل"],[67,"وافاك بالذنب العظيم المذنب","https://www.aldiwan.net/poem18038.html","الكامل"],[46,"لزينب يحلو جني أمر","https://www.aldiwan.net/poem22745.html","المتقارب"],[15,"أرقت لضوء برق في نشاص","https://www.aldiwan.net/poem45263.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85816","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147578","البسيط"],[36,"لزاز حروب يكره القوم درأه","https://www.poetsgate.com/ViewPoem.aspx?id=15871",""],[106,"أنصاف رجال","https://www.poetsgate.com/ViewPoem.aspx?id=179440",""],[22,"عَفَا تَوْءَمٌ مِنْ أَهْلِهِ فَجُلاجِلُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=19805",""],[90,"عاشوراء","https://www.poetsgate.com/ViewPoem.aspx?id=179150",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[78,"لولا عُيونٌ مِنَ الواشينَ تَرمُقُني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86484&r=&rc=29",""],[113,"من للفقير المشتكي من حاله","https://www.aldiwan.net/poem41750.html","الكامل"],[133,"أرسلي الدمع يا عيوني انسجاما","https://www.aldiwan.net/poem49159.html","الخفيف"],[141,"هل للأماني عن جنابك مدفع","https://www.aldiwan.net/poem11771.html","الكامل"],[142,"أبدا إليك تولع الأحباب","https://www.aldiwan.net/poem4461.html","الكامل"],[148,"لم تبق معلوة إلا خصصت بها","https://www.aldiwan.net/poem68465.html","البسيط"],[184,"إذا فكرت في زمن عبوس","https://www.aldiwan.net/poem43713.html","الوافر"],[202,"نفسي الفدا لمقارب كمباعد","https://www.aldiwan.net/poem53327.html","الكامل"],[260,"إذا جئت الأمير فقل سلام","https://www.aldiwan.net/poem68188.html","الخفيف"],[269,"حياك يا ربع ليلى كل هطال","https://www.aldiwan.net/poem52075.html","البسيط"],[269,"لم يبق في الحي من ربع ولا طلل","https://www.aldiwan.net/poem52078.html","البسيط"],[273,"أبين واشتياق وارتياع","https://www.aldiwan.net/poem25483.html","الوافر"],[280,"رويدك كم تجني وكم تتدلل","https://www.aldiwan.net/poem32666.html","الطويل"],[296,"لزوال جميع ما أنت رائي","https://www.aldiwan.net/poem36262.html","عموديه"],[301,"لزمت بيتي كلزوم البنا","https://www.aldiwan.net/poem58269.html","السريع"],[301,"لزمت بيتي مثل ما قيل لي","https://www.aldiwan.net/poem58291.html","السريع"],[318,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[362,"بدا في فرعك الوخط","https://www.aldiwan.net/poem60858.html","الهزج"],[367,"عقني الصبر منذ أقوى العقيق","https://www.aldiwan.net/poem4296.html","الخفيف"],[390,"أسد ولكن الكلاب","https://www.aldiwan.net/poem53595.html","مجزوء الكامل"],[402,"أحمد ربي على ضياء","https://www.aldiwan.net/poem49428.html","مخلع البسيط"],[434,"سلام على الربع من ذي سلم","https://www.aldiwan.net/poem2553.html","المتقارب"],[456,"ألا صاحب كالسيف حلو شمائله","https://www.aldiwan.net/poem55994.html","الطويل"],[459,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"],[462,"أرى سيرها عنقاً أو خيدا","https://www.aldiwan.net/poem3276.html","عموديه"],[462,"ألمت سليمى والنسيم عليل","https://www.aldiwan.net/poem3634.html","عموديه"],[466,"ناؤ كلون الناي","https://www.aldiwan.net/poem60523.html","المجتث"],[502,"فتحت عين رجائي بسيفك القاهر","https://www.aldiwan.net/poem38387.html","عموديه"],[503,"إلهٌ من نباح","https://www.aldiwan.net/poem42459.html","مخلع البسيط"],[513,"ثغر الهدى متبلج بسام","https://www.aldiwan.net/poem12245.html","الكامل"],[522,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[549,"نولِينا منك الغداة قليلا","https://www.aldiwan.net/poem47318.html","الخفيف"],[549,"سلام على العمل الصالح","https://www.aldiwan.net/poem47889.html","المتقارب"],[556,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[560,"نحن النصارى آل عيسى المنتمي","https://www.aldiwan.net/poem52748.html","الكامل"],[560,"ماذا لقيت من الحبيب وحبه","https://www.aldiwan.net/poem52950.html","الكامل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"أيا دار في جنات عدن له دار","https://www.aldiwan.net/poem2783.html","الطويل"]],"verses":[["لُزِزنا مِنَ الدَهرِ الخَؤونِ بِمِصدَمٍ","يُحَطِّمُ أَشلاءَ القَرينِ المَجاذِبِ",0,"ب",1,0],["لَزِدتَ المُلكَ أَوضاحاً","إِلى أَوضاحِهِ الشُهبِ",1,"ب",1,0],["لَزِمَت ظَلومُ خِلافَ أَمري كُلِّهِ","وَأَطاعَها قَلبٌ عَلَيَّ مَشومُ",2,"م",1,0],["لَزَيَّنْتَ أَجْيَادَ الْمَنَابِرِ بِالَّتِي","أتَاحَ لَهَا الرَّحْمَانُ مِنْ آلِ زِيَّانِ",3,"ن",1,0],["لَزَجَرتُ قَلباً لا يَريعُ لِزاجِرٍ","إِنَّ الغَويَّ إِذا نُهي لَم يُعتِبِ",4,"ب",1,0],["لِزَيدِ اِبنِ كَهلانَ الَّذي نالَ عِزُّهُ","قَديماً ذَرارِيَّ النُجومِ الشَوابِكِ",5,"ك",1,0],["لزم الأسى قلبي كما لزم الثنا","قاضي القضاة أبا المناقب أجمع",6,"ع",1,0],["لزهر الشقائق والبدر من","جُلا وجنتيك انتساب عريق",7,"ق",1,1],["لزَمتهُ زِجاجَها لعيونٍ","ليس فيها كوالئٌ بل كوالي",8,"ل",2,0],["لزها وتاه بقُبْحه","تِيهاً يحاقِرُ كلَّ تيهِ",9,"ي",2,0],["لِزَيدِ اللاتِ أَقدامٌ صِغارٌ","قَليلٌ أَخذُهُنَّ مِنَ النِعالِ",10,"ل",1,0],["لَزُرتُكُم لا أُكافيكُم بِجَفوَتِكم","مَشيا عَلى الوَجه أَو سَعيا عَلى الرأسِ",11,"س",1,0],["لَزِمتُ بابَ أَميرِ الأَنبِياءِ وَمَن","يُمسِك بِمِفتاحِ بابِ اللَهِ يَغتَنِمِ",12,"م",1,0],["لَزِمَ المَشايِخَ مِلَّةً قَدُمَت","بانَت فَضيلَتُها عَلى الوَلَدِ",13,"د",1,0],["لَزومُ صَبرٍ وَخَلعُ كِبرٍ","وَصَونُ عِرضٍ وِبَذلُ مالِ",14,"ل",1,0],["لَزَّت إِلى صَدرِها صَدري مُوَدَّعَةً","وَزَوَّدَتني مِنَ الإِرشافِ وَالقُبَلِ",15,"ل",1,0],["لَزِمتَ حَدَّ التُقى عَن كُلِّ فاحِشَةٍ","حَتّى كَأَنَّكَ مَعصومٌ عَنِ الزَلَلِ",15,"ل",1,0],["لَزَّت بِها ضَرَّةٌ زَهراءُ واضِحَةٌ","كَالشَمسِ أَحسَنُ مِنها عِندَ رائيها",16,"ي",3,0],["لَزِموا مَركَزَ النَدى وَذَراهُ","وَعَدَتنا عَن مِثلِ ذاكَ العَوادي",17,"د",2,0],["لِزَينَبَ إِذ تُجِدُّ لَنا","صَفاءً لَم يَكُن كَدَرا",18,"ر",2,0],["لزموا تُخُومَ بُيوتِهم وغُزاتُهم","لا يرتضون سِوَى النُّجومِ تُخُوما",19,"م",2,0],["لِزَهرَةِ البُستان في غُصنِها","الفَينان عَرفٌ يَفوح",20,"ح",1,1],["لَزِمَت حَوالِسُها النُفوسَ فَثَوَّرَت","عُصَباً تَقومُ مِنَ الحِذارِ وَتَقعُدُ",21,"د",1,0],["لِزُغبٍ كَأَولادِ القَطا راثَ خَلقُها","عَلى عاجِزاتِ النَهضِ حُمرٍ حَواصِلُه",22,"ل",2,0],["لَزمَ التَّقَلُّبَ في مَعاصِي رَبِّهِ","إذْ باتَ في نَعْمائِهِ يَتَقَلَّبُ",23,"ب",1,0],["لِزَينَبَ يَحلو جَنِيٌّ أَمَرَّ","وَقَد عَلِقَت كَفُّها بِالقَمَر",24,"ر",1,1],["لِزادِ المَرءِ آبَصَ مِن عُقابٍ","وَعِندَ البابِ أَثقَلَ مِن رَصاصِ",25,"ص",1,0],["لزم العبادة في جميع حياته","حتى ينال سعادة في الآتي",26,"ي",1,1],["لزمت بيتاً بناه الجد من مدر","كأنه بيت شعر ليس يتزن",27,"ن",1,1],["لزاز حروب يكره القوم درأه","ويمشي غلى الأقران بالسيف يخطرُ",28,"ر",1,1],["لزهْر النَّرد قد خلقت يداه","وليست لليراع، ولا الكتاب",29,"ب",1,0],["لِزُغْبٍ كأولادِ القَطَا رَاثَ خَلْفُها","على عاجزات النّهض حمرٍ حواصله",30,"ل",2,0],["لزُعزِع يومُ الطف عن مُستقَرِّه","وغُيِّرَ من تاريخه فتَطَوَّرا",31,"ر",2,0],["لزَكا \" ابولَهَبٍ \" وكانُ مُرجَّماً","ودَنَا \" صُهَيبُ \" وإنه لامام",32,"م",1,0],["لَزِموا جُحورَهُمُ وطارَ حليمُهُمْ","ذُعْراً ، وبُدِّلَتِ الأسودُ أرانبا",33,"ب",2,0],["لَزُرتُكُم، لا أُكافيكُم بِجَفوَتِكم","مَشيًا عَلى الوَجه، أَو حَبوًا عَلى الرأسِ",34,"س",1,0],["لزم الخطايا في جميع أموره","واستصحب العصيان في أعماله",35,"ل",2,0],["لزمت طول عمرها المجد والسؤ","دد والفخر والوفارَ والتزاما",36,"م",2,0],["لَزِموا المَنازِلَ وَاِكتَفَوا بِقَعاقِعٍ","مَسموعَةٍ لَكِنَّها لا تَنجَعُ",37,"ع",1,0],["لزموا التواضع والتذلل والبكا","والخوف منك ومن شديد حساب",38,"ب",1,0],["لزمتُ مختتماً من شكر مِنَّتِهِ","لزوم غيري شكراً غير مختتم",39,"م",1,0],["لزمتُ البيت مضطرا كأنّي","ذو وتر دفنت بلا جليس",40,"س",1,0],["لزم التوقّي بالهوى فلسانُه","متباعد والقلب غير مباعدِ",41,"د",1,0],["لَزُومٌ ما عَلِمتُ لباب دَارِي","لُزُومَ الكَلبِ أصحَابَ الرَّقِيمِ",42,"م",1,0],["لزيمهم في رياض الخير مغتبط","وَجارهم في نَعيم ناعم البال",43,"ل",1,0],["لزيمهم بعرا التَوفيق معتصم","وَللنزيل اليهم اكرم النزل",44,"ل",1,0],["لَزِمْتُ الصَّبْرَ حَتَّى عيل صَبْرِي","وَبانَ العُذْرُ إذْ جَدَّ الزَّماعُ",45,"ع",1,0],["لَزِمتَ مَلالاً ما تَمَلُّ لُزومَهُ","فَقَلبي عَلى جَمرِ الغَضا يَتَمَلمَلُ",46,"ل",1,0],["لزوالٍ جميعُ ما أنتَ رائي","فاعتبرْ بالظلالِ والأفياءِ",47,"ا",2,1],["لزمت بيتي كلزوم البنا","في الحرف والفعل على الأصل",48,"ل",1,1],["لزمت بيتي مثل ما قيل لي","ولم أعاند حادث الدهرِ",49,"ر",1,1],["لِزَهرِ آدابِهِ رِبحُ الصِبا اِتَّجَهَت","فَاِذكَرَتنا بِنَفحِ الطيبِ نِسمَتُهُ",50,"ت",2,0],["لُزومُ العارٍ لي طَوْقٌ","ولَومُ النّاسِ لي قُرط",51,"ط",1,0],["لزمانِ الصِّبا عليَّ حقوقٌ","أنا منهنَّ بالوفاء حقيقُ",52,"ق",1,0],["لزمَ اِبن عبادٍ وَلا","ءكُمُ الصَريحَ بِلا براح",53,"ح",1,0],["لزمت بابَ الملوك دهراً","فلم يلق ماؤهم ذنوبي",54,"ب",2,0],["لزمت عرى الدين حتى غدت","حبال التقى بكم تلتزَم",55,"م",1,0],["لزاجر أعجازِ السوابق فوقه","يقاومه طوراً وطوراً يمايلُهْ",56,"ل",2,0],["لَزِمَ الثَّنِيَّةَ لا يَلوحُ لشخصه","شَبَحٌ ولا يبدو عليه رُواءُ",57,"ا",2,0],["لزانت كنانة هذي السهام","كما زانت المرهفات الغمودا",58,"د",2,0],["لزدتُ به عاماً تعفّى جماله","وما يتساوى عالمُ وجهول",59,"ل",1,0],["لِزَمرِها نَغَماتٌ","هُنَّ الغِنى لِلغِناءِ",60,"ا",2,0],["لَزمتُ ذَيلَكَ أرجُو رِضَاكَ فَي الدَّارَين","كَفَى وُثُوقُ رَجَائِي بِلطفِكَ المُوفُور",61,"ر",1,0],["لزُيّنَ الحيُّ كي أراهُ","من قمرةِ بومَتي براحِ",62,"ح",1,0],["لزمت ملازمها وأبرم عقدها","ملك إليه النقض والإبرام",63,"م",1,0],["لَزِمتُ صدقَ وَلاهُم وَالتَزَمت بِهِ","فَلَست أَسلوهُ إِلّا عَن سُلُوّهِمِ",64,"م",1,0],["لَزَّه في قَرارةٍ تخذ اللُّج","جةَ منها كهفاً له ومَقيلا",65,"ل",2,0],["لَزاروهُ وَاِستَنزلوا عندهُ","عطاءً من المانع المائحِ",66,"ح",1,0],["لزوم ما يقتضيه المجد عن شيمي","والطبع لا يلزم المسترخص القيم",67,"م",1,0],["لزِمَتْ بهِ ثِقَةُ الجميعِ بأَنَّهُ","حقٌّ وغيرَ الحقِّ لم يَتَكَلَّمِ",68,"م",1,0],["لَزِمَ المدارِسَ في الدِّيارِ وذكرُهُ","قد سارَ في شرقِ الفضاءِ وغَرْبهِ",69,"ب",2,0],["لزوجة النبي قد أخلاها","فنزلت فيها فما رآها",70,"ه",2,0],["لزهّدني في هذه الدار موته","فسيَّانَ إِقلالٌ لديَّ وإِكْثَارُ",71,"ر",1,0]]}