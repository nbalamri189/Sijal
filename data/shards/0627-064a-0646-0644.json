797",""],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34665","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114052","الخفيف"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101369","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86454","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86356","الرمل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135106","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83507","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83479","الخفيف"],[4386,"","https://poetry.dctabudhabi.ae/diwan/poem/33812","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33686","الرمل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33493","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33250","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33210","الخفيف"],[4691,"حسنها","https://www.poetsgate.com/ViewPoem.aspx?id=125562",""],[4767,"أيكة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=91456",""],[1901,"أرهقْتنا الأيامُ بسطاً وقبضاً","https://www.poetsgate.com/ViewPoem.aspx?id=160385",""],[5106,"مِهْرَجَانُ الشَّمْس .","https://www.poetsgate.com/ViewPoem.aspx?id=153972",""],[5293,"نغمات من العَلَم","https://www.poetsgate.com/ViewPoem.aspx?id=186132",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[5409,"لم ينل من علاك كل أثيم","https://www.poetsgate.com/ViewPoem.aspx?id=155489",""],[5414,"الهابطون والصاعدون","https://www.poetsgate.com/ViewPoem.aspx?id=12938",""],[5442,"عز قرب الدار إلا في الكرا","https://www.poetsgate.com/ViewPoem.aspx?id=114789",""],[5720,"عُدْ","https://www.poetsgate.com/ViewPoem.aspx?id=204381",""],[5829,"يا حبيب العمر","https://www.poetsgate.com/ViewPoem.aspx?id=152234",""],[6229,"من بين الأشوك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82505&r=&rc=40",""]],"verses":[["أَينَ لا أَينَ مَن يُجيرُ عَلى الدَه","رِ إِذا الدَهرُ هَرَّ يَوماً وَعَضّا",0,"ض",2,0],["أَينَ لا أَينَ المَعالي جَمَّةً","وَالحِمى أَفيَحَ وَالرَأيُ مُغارا",1,"ر",2,0],["أَينَ لا أَينَ مِثلُها إِنَّما يَح","سُنُ مِن فَضلِ حُسنِها مَن سَواها",2,"ا",3,0],["أَينَ لَيثُ الجَزيرَةِ اِبنُ عَلِيٍّ","واهِبُ الأَلفِ مُكرِمُ الضَيفانِ",3,"ن",1,0],["أَينَ لَيلىعَلى شَوا","طئ بيروت يا عُمر",4,"ر",1,0],["أَين لَهوي وَشَرَّتي","وَالزَمانُ الَّذي غَبر",4,"ر",1,0],["أَينَ لا أَين وَالحَيا","ة هِيَ اللَمح بِالبَصَر",4,"ر",1,0],["أَينَ لَبيدٌ وَأَينَ أُسرَتُهُ","تَزخَرُ عِندَ الضُحى مَسابِلَها",5,"ل",3,0],["أين لا أين ما غنائيَ بالذكْ","رى وقد أصبَحَ الوهوبُ منوعا",6,"ع",2,0],["أَيْنَ لَيَالِينَا بِوَادي الْغَضَى","ذَلِكَ عَهْدٌ لَيْتَهُ مَا انْقَضَى",7,"ض",2,1],["أَيْنَ لَوْنُ الْحَيَاةِ والقَهْرِ والقُوَّةِ","مِنْ لَوْنِ ناصِل الأعْشاب",8,"ب",1,0],["ائن لفجت كفي بتشتيت طولها","الى حيث احساب الرجال تزاحم",9,"م",1,0],["أين لا أين موثق ويمين","رحم اللَه موثقاص ويمينا",10,"ن",2,0],["أَين ليالي لهوك الممتعة","يا هبر أَيام الصفا والدعه",11,"ع",2,0],["أين للبدر مثل هذا التَّلالي","أين للغصن مثل هذا التثنّي",12,"ن",2,0],["أين ليلى وأين صبحى أجبني","وحياة الفؤاد ليل وصبح",13,"ح",1,0],["أين لا أين نعيم العقلاء","هو ضربٌ من أفانين الجمود",14,"د",1,0],["أَينَ لَيالينا عَلى كا ظِمِةٍ","أَيّامَ عودُ شَملِنا لَم يَنحَصِد",15,"د",1,0],["أين لي بالإله رب الأغاري","د أبولّو يملأ من الخلد كوبى",16,"ب",2,0],["أين لا أين فقد ضمّ الثرى","رائد البغي فما يجدي السؤال",17,"ل",1,0],["أَينَ لا أَنتَ كَي يُفَرَّ إِلَيهِ","مِنكَ بَل أَينَ أَنتَ وَالأَينُ فيكَ",18,"ك",1,1],["أين لي هل نظمت الشهب شعرا","وهل وافى ذراك الفرقدان",19,"ن",1,0],["أين لبيب عارف","يُظهر ما قد أضمرا",20,"ر",2,0],["أَينَ لا أَينَ مِثلُ زائِدَةَ الخَي","راتِ إِلّا أَبوهُ لا أَينَ ذاكا",21,"ك",2,0],["أينَ لا أينَ لنوقٍ أصْبَحَتْ","تتراءى بين حلٍّ وارتحال",22,"ل",1,0],["أين ليالينا على الخيفِ وهل","يردُّ عيشا بالحمى قولُك هَلْ",23,"ل",1,0],["أين له أين بكم نادماً","معتذراً إلا بأن يُعذَرا",24,"ر",2,0],["أين لبنى أختُ الشباب وما","لذَّةُ من فارق الشبابَ ولبنى",25,"ن",2,0],["أَينَ لَيلى وَأَينَ لَيلى وَلَيلى","أَمرَضَت غَيرَنا رِجالاً صِحاحا",26,"ح",2,0],["أَين ليالٍ مَضتْ وَنحْنُ بِها","أَحبّةً في الهَوى وَجِيرانُ",27,"ن",1,0],["أين لا أين هم وأين علاهم","أسلام ذكراهم أم وداع",28,"ع",1,0],["أيْنَ لا أيْنَ مِثْلُ ذاكَ المُحَيَّا","أيْنَ لا أيْنَ مِثلُ تِلْكَ الجُفونِ",29,"ن",1,0],["أين لي عدل إلى بدلٍ","أبديل منك مقبول",30,"ل",1,0],["أَينَ لي مثلُها وَأَنَّى لِمِثلي","حَيثُ أَنّي أُعَدُّ في الغَوغاءِ",31,"ا",2,0],["أين لياليكم وأيامكم","نَضَارة الدهر وعيش الأريبْ",32,"ب",1,0],["أين لا أين ترانيم الهوى","أين عزفي أين طبلي أين زمري",33,"ر",2,0],["أَينَ لي مَلجاً إِذا ما طرفُه","بجيوش السحر نَحوى جَيَّشا",34,"ش",2,0],["أين ليث كان بالأمس هنا","خادرًا قد ملأ الدنيا زئير",35,"ر",1,0],["أين لي في هوى سواها ولوع","هل حكاها بما حوتْهُ سواها",36,"ا",3,0],["أين للعنكبوتِ بَيْتٌ ضعيفٌ","مثله وهو مثلُ عقلي الضعيف",37,"ف",1,0],["أَينَ لا أَينَ مِثلُها مُصطَفاةً","مِن صَفايا المُلوكِ وَالوُزَراءِ",38,"ا",2,0],["أَينَ لا أَينَ مِثلُها مُقتَناةً","عِندَ حالَينِ شِدَّةٍ أَو رَخاءِ",38,"ا",2,0],["أَينَ لا أَينَ مِثلُها لِجميعٍ","أَغنِياءٍ في الناسِ أَو فُقَراءِ",38,"ا",2,0],["أين للدين من يقيم قناه","حيث مالت وينجح الآمالا",39,"ل",2,0],["أين للبدر مبسم فيه عقد","من جمان يسبى النهى مكنونه",40,"ن",2,0],["أئن لثمتك سرا","وأبصرتني رخاص",41,"ص",1,0],["أَينَ لا أَينَ جُنَّتي وَسِلاحي","وَمَطايا سَيَّرتُها لِارتِحالي",42,"ل",2,0],["أين لقيا مهذب لأن عطفا","من ملاقة جامد الطبع قاسي",43,"س",2,0],["أين لطف النسيم منكِ لماذا","بدّلتْ هينماته بالعزيف",44,"ف",1,0],["أين ليلاي أينها","حيل بيني وبينها",45,"ن",3,1],["أَينَ لا أَينَ الأُلى قَد أَنفوا","وَأَبوا إِلّا المَعالي والإباءَ",46,"ا",2,0],["أين لبنان والعراق","وامريك والنجف",47,"ف",1,0],["أين ليلٌ نعمتُ فيه بِلَيلى","وعلينا من النجوم رقيبُ",48,"ب",1,0],["أينَ لم تأت أيها الفتانُ","أنا أشقى وليسَ فيك حنانُ",49,"ن",1,1],["أَينَ لاوِي وحِزبُهُ وبَنُوهُ","يا إِمامَ الهُداةِ أَنتَ إِمامي",50,"م",2,0],["أين لون الأزهارلم أعد الآ","ن أرى في الأزهار غير البوار",51,"ر",1,0],["أين لحن الطيور لم يعد الآ","ن اشتياقا وحرقة في فؤادي",51,"ي",1,0],["أين لا أبعد المهيمن داراً","لك يا من أجلّه عن ندائي",52,"ا",2,0],["أين لا أين القرار بنا","آذنوا بالبين أم قطنوا",53,"ن",3,0],["أين لا أين مثلها","في جميع الورى سكن",54,"ن",1,0],["أينَ لِلغَاوِي أن يَحُومَ بِسَاحَا","تِ نَبِيٍّ لَهُ الوَقَارُ وِقَاءُ",55,"ا",2,0],["أين لا أينها أخافت فأمسى","سربها في الركون ليس بآمن",56,"ن",1,0],["إين لا أين من يجاريك فضلا","وارتياحاً إلى المعالي وبطشا",57,"ش",2,0],["أين لا أين سرت تلك الحدوج","تترامى العيش فيها بالسرى",58,"ر",2,0],["أين للنجم الفة بين قوم","أين للنجم زينة العنقود",59,"د",1,0],["أَينَ لا أَينَ أُفقها في مِثالٍ","أَينَ لا أَينَ حدُّ هذا المِثالِ",60,"ل",1,0],["أَين لا أَينَ طيبَةٌ وَقُباها","عزّ منها الوِصال طال المطالُ",61,"ل",1,0],["أَينَ لا أَينَ لُبُّ ذي اللُّبّ منّا","لَو عقلنا الهَوى لحُلَّ العِقالُ",61,"ل",1,0],["أَينَ لِلوَردِ مِثلُ وَردٍ بَخَدَّي","كَ إِذا ما قَطَفتَهُ صارَ غَضّا",62,"ض",2,0],["أينَ لا أينَ خلاصٌ","لِمُحبٍّ من يَديهِ",63,"ي",2,0],["أينَ لي راحةٌ وليسَ عزاء","زالَ صَبري وزَفرتي لا تَزول",64,"ل",1,0],["أينَ لي مثلُ قلبهِ فأصد","كيفَ أسلو وليس لي منه بُدُّ",65,"د",1,1],["أين لي عبرةٌ فأطفئ وجدا","إن عيني لم تأل في الدمع جهدا",66,"د",2,1],["أين لي حضنك المعطّر حبا","فيهِ أغفو وأستريحُ وأدفأ",67,"ا",1,0],["أين لو كان ما أثاروه صدقا","يا أخي موقع الثرى والثريا",68,"ي",2,0],["أين للدهرِ أن يَرى ليَ حَقا","وعيونُ الزمانِ كالغيدِ مَرضى",69,"ض",2,0],["أينَ لا أينَ مَن يَردُّ على العينِ","نعيماً سَرعانَ ما قد تَقَضّى",69,"ض",2,0],["أَينَ لِي أَُمْسِيْ هُنَا وَجَرَادٌ","يَتَمَادَىْ وَقِحَاً وَأَذِيَّا",70,"ي",2,0],["أين? لا أين قد خبا","كل شيء غدا عدم",71,"م",1,0],["أين لي أين لي لم سفكت دماءهم","ولم ذا نهبت المال قصدا على عمد",72,"د",1,0],["أين لو أنصفتك دنياك يوماً","منك في الشر حية رقطاء",73,"ا",2,0],["أينَ؟ لا أينَ، فالمَسَار سوادٌ","ليْسَ إلا الأنيابُ والأظفار",74,"ر",1,0],["أين لفي الصبر من فارقه","وجماد لم يجد مصطبرا",75,"ر",2,0],["أَيْنَ لَيْلٌ .. عِنْدَمَا تَأَتِيْ لَنَا","يَرْتَوِيْ حُبَّاً .. فُؤَادٌ أمَّلَكْ ؟",76,"ك",1,0],["أين لألاءُ الثريا يا حبيبي من سناكْ","يا إمامَ الحسنِ والإبداع يا شبه الملاكْ",77,"ك",1,0],["أين للبلبل أن يُلقي بيانَهْ","وهو لا يعرف في الظلّ مكانَهْ",78,"ن",2,1]]}