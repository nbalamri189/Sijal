,[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42573","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55524","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55168","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54888","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54660","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54697","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54518","المجتث"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43806","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43741","الطويل"],[77,"","https://poetry.dctabudhabi.ae/diwan/poem/71429","الطويل"],[77,"سقى دارهم هام من السحب هامع","https://www.poetsgate.com/ViewPoem.aspx?id=34206",""],[77,"أيغلبُ من عاداك والله غالبُه","https://www.poetsgate.com/ViewPoem.aspx?id=33204",""],[22,"أَشاقتك أظعانٌ لليلى","https://www.poetsgate.com/ViewPoem.aspx?id=19749",""],[22,"يأيُّها المَلِكُ الذي أَمْسَتْ لَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=19777",""],[50,"ألم يأن أن تسلى مودة مهددا","https://www.poetsgate.com/ViewPoem.aspx?id=21791",""],[96,"راقصة الحانة","https://www.poetsgate.com/ViewPoem.aspx?id=17511",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"ثورة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=179144",""],[90,"الفرات الطاغي","https://www.poetsgate.com/ViewPoem.aspx?id=179148",""],[46,"يُحقُّ كسادُ الشعرِ في كلّ موطنٍ،","https://www.poetsgate.com/ViewPoem.aspx?id=18311",""],[31,"وإني لسائلُ أمّ الربيعِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18956&r=&rc=219",""],[91,"السجينة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=374&r=&rc=2",""]],"verses":[["وَمِن عَجَبٍ صُدودُ الحَظِّ عَنّا","إِلى المُتَعَمِّمينَ عَلى الخَزايا",0,"ا",3,0],["وَمِن عَجَبِ الأَيّامِ أَنّي مُحَسَّدٌ","أُعادى عَلى ما يوجِبُ الوُدُّ حُكمُهُ",1,"م",2,0],["وَمِن عَجيبِ ما أَرى مِن صَرفِهِ","قَد دَمِيَت مِن ناجِذي أَنامِلي",2,"ل",2,0],["وَمِن عَجَبٍ غَضّي عَنِ الشَيبِ جازِعاً","وَكَرّي إِذا لاقى الرَعيلَ رَعيلُ",3,"ل",1,0],["وَمِن عَدَمٍ أَقري النَوازِلَ عِذرَةً","وَلَو حَلَّ لي لَحمي قَرَيتُهُمُ بَعضي",4,"ي",1,0],["وَمِن عامِرٍ غِلمَةٌ كَالسُيو","فِ جِريالُ أَوجُهِهِم يَقطُرُ",5,"ر",1,1],["وَمِن عَجَبٍ أَصفَيتُكِ الوِدَّ بَعدَما","تَعاطى القَنا قَومي وَقَومُكِ أَعصُرا",6,"ر",2,0],["وَمِن عَجَبٍ رَيّي وَما نَقَعَ الصَدى","وَعَدّي مَنّاً عَلَيَّ وَما اِعتَدّا",7,"د",2,0],["وَمِن عَزَماتٍ كُلَّ يَومٍ يَقِفنَ بي","عَلى كُلِّ بابٍ لِلمَقاديرِ مُصمَتِ",8,"ت",1,0],["وَمِن عَجَبٍ أَن تُخلِفَ العَهدَ غادَةٌ","أَبي وَأَبوها مِن بَني صادِقِ الوَعدِ",9,"د",1,0],["وَمِن عُقودِكَ ما أَبكي عَلَيكِ بِهِ","وَهَل عُقودُكِ إِلّا مِن ثَناياكِ",10,"ك",1,0],["ومنْ عَجَبٍ أنّني في ذَراكَ","على الدّهْرِ منْ حَنَقٍ أغْضَبُ",11,"ب",1,0],["ومنْ عَجَلٍ ما لَفَّ جيداً وداعُنا","بِجيدٍ ولا نَحْراً أضَفْنا إِلى نَحْرِ",12,"ر",1,0],["ومَنْ عَلِقَ العَفافُ بِبُرْدَتَيْهِ","رَأى هُجْرانَ غانِيَةٍ وِصالا",13,"ل",2,0],["ومِنْ عجَبٍ أنْ خانَنا فيكِ عزْمُنا","فَلا العَهْدُ مَنْسيٌّ ولا الحيُّ شاسِعُ",14,"ع",1,0],["وَمَنْ عَجَبِ الدُّنْيَا بُنَيَّةُ خَاطِرِي","تَأَتَّى بِيَوْمٍ حَمْلُهُ وَفِصَالُهُ",15,"ل",2,0],["ومنْ عجَب أنْ يُسْتَنالَ نوالُهُ","فيعْذُبُ شُهْداً وهْوَ في الشّكْلِ زُنْبورُ",16,"ر",1,0],["ومنْ عاشِقٍ حُرٍّ إذا ما اسْتَمالَهُ","حَديثُ الهَوى العُذْريِّ صيَّرَهُ عَبْدا",17,"د",2,0],["وَمِن عُيونِ رُباها","وَعَذبِ فيكِ اِرتَوَيتُ",18,"ت",1,0],["وَمِن عَجَبٍ قَد قَلَّدوكَ مُهَنَّداً","وَفي كُلِّ لَحظٍ مِنكَ سَيفٌ مُهَنَّدُ",19,"د",1,1],["وَمِن عَجَبٍ تَدينُ بِدينِ موسى","وَتَأتينا بِمُعجِزَةِ المَسيحِ",20,"ح",1,0],["وَمِن عَجَبِ الأَيّامِ أَنَّ شَفاعَتي","تُرَجّى لِمَن في وَجهِهِ أَلفُ شافِعِ",21,"ع",1,1],["وَمنعتَ طَيفكَ مِن زِيارَةِ عاشِقٍ","حاوَلتَ مُهجَتَهُ فَلَم يَتَمَنَّعِ",22,"ع",1,0],["وَمِن عجبٍ أَن لَيسَ يَنفذُ حُكمُهُم","عَلى أَحَدٍ إِلّا إِذا ضَمَّهُم قَبرُ",23,"ر",1,0],["وَمِن عُمَرٍ بَرِئتُ وَمِن عَتيقٍ","غَداةَ دُعي أَميرَ المُؤمِنينا",24,"ن",2,0],["وَمِنْ عَزَائِمَ لَمْ تَفْتَأْ مُصَرَّفَةً","فِي النَّفْعِ لِلْنَّاسِ وَالتَّفْرِيجِ لِلْكَرَبِ",25,"ب",1,0],["وَمَنَعْتَ فِي المَقْسُومِ مِنْ آلائِهِ","إِيثَارَ إِنْسَان عَلَى إِنْسَانِ",26,"ن",1,0],["وَمِنْ عَلِيِّ الذُّرَى فِي الطُّورِ عَنْ كَثَبٍ","إِلَى قَصَيِّ الرُّبَى فِي أَرْضِ كَنْعَانِ",27,"ن",1,0],["وَمِنْ عَفَافٍ وَتُقًى صَادِقٍ","بِلاَ مُدَاجَاةٍ وَبُهْتَانِ",28,"ن",1,0],["وَمِن عاقِرٍ يَنفي الأَلاءَ سَراتُها","عَذارَينِ عَن جَرداءَ وَعثٍ خُصورُها",29,"ر",3,0],["ومن علوّ في ذرا هَضْبه","لن يجد الطير بها مثوى",30,"ث",3,0],["ومن عجب أن الورى يدعونه","وهم من قديم الدهر أعداؤه الزرق",31,"ق",1,0],["ومن عجب أن الشُوَ يعر لامني","ببيروت لوم الشاتم المتجاسر",32,"ر",1,0],["ومن عجب أن يَعشَقَ الروض بلبل","ويمنعه ذِبّانه أن يُغرِّدا",33,"د",2,0],["ومن عِضةٍ من آجر فانبتَّم","نضاراً عيصه الأشب النضيرُ",34,"ر",1,1],["ومن عجب عليّ لعمر أمٍ","غذتك وغيرها تتايمنينا",35,"ن",2,0],["ومن عجب بجيلَ لعمرُ أُمٍّ","غذتك وغيرها تتأممينا",35,"ن",2,0],["وَمُنعَفِرُ الخدّينِ مِن آلِ هاشِمٍ","إلا حَبَّذا ذَاكَ الجبينُ المُتَرَّبُ",36,"ب",1,0],["وَمِن عِجَبٍ لم أَقضِهِ أنَّ خَيلَهُ","لأَجوَافها تَحتَ العَجَاجَةِ أزمَلُ",37,"ل",1,0],["ومن عَجَب بَجِيل لعمرو أُمٍّ","غَذَتك وغَيرَهَا تَتَأَمَّمِينَا",38,"ن",2,0],["وَمَن عاشَ مِنّا عاشَ في عُنجُهِيَّةٍ","عَلى شَظَفٍ مِن عَيشِهِ المُتَنَكِّدِ",39,"د",1,1],["ومن عذل العذول عن انتقاص","ولكن من هواكم عن زياده",40,"د",2,0],["ومن عجب الأشياءِ حلوٌ ممنعٌ","أصبر عنه وهو حلوٌ مع الصبر",41,"ر",1,0],["ومن عجب الدّهر أني به","تلذّذت مع أنه سمّ ساعه",42,"ه",1,0],["ومن عجب الزمان إذا اعتبرنا","خليلٌ ما يجي منه صديق",43,"ق",1,0],["ومن عجب إني بعادل قدّه","أجنّ ودمع العين دوني المسلسل",44,"ل",1,0],["ومن عجب مقدار فرع يراعة","وقد وسع الدنيا بفيء نواله",45,"ل",2,0],["ومن عجب محض الأعاريب جاده","تجوع على غِلاَّتهِ وهو شبعان",46,"ن",1,0],["ومن عقابٍ بأسها مروّع","كأنها للطيرِ جنٌّ تفزع",47,"ع",1,0],["ومن عَجَبٍ كدتَ تَجني به","عليَّ مشيباً يُعَفِّي الشّبابا",48,"ب",2,0],["ومن عجبٍ أنْ كلما جدَّ ركضُنا","عليه تباعدنا من الطَّلباتِ",49,"ت",1,0],["ومن عجَبِ الأشياء أَنِّيَ مُسْلِمٌ","حَنِيفٌ ولكنْ خيرُ أيَّامِيَ السَّبتُ",50,"ت",1,0],["ومن عَقْده عند العطايا ارتجاعُه","وأن يُنْقَضَ العقْدُ الذي هو عاقدُ",51,"د",1,0],["ومن عاد عدنا طالبين بحقنا","ولابد للمستنبِط الماء من حفر",52,"ر",1,0],["ومن عجائب ما يُبلَى المحِب به","أنّي على ذاك أرجوها وأحذَرها",53,"ر",3,0],["ومنعُ الجَدا المبذولِ حتى كأنني","لقىً لا يُرجّى فيه حمدٌ ولا أجر",54,"ر",1,0],["ومن عيونٍ إليكم جد طامحةٍ","كأنصل النبل من خُزْرٍ ومن شوس",55,"س",1,0],["ومن عجبٍ أني بسطت بمنطقي","عليك لساناً في الإسارِ مُقبّضا",56,"ض",2,0],["ومن عجب أني اقتضيْتك نائلاً","ووجهُك أولى أن يُعانى ويقتضَى",56,"ض",2,0],["ومن عجب أني أطيلُ تعتُّبي","عليكُ وقد أصبحتَ في الخلق مُرتَضى",56,"ض",2,0],["ومن عجب ذليلٌ مستكينٌ","يُطالبهُ عزيزٌ مستشيطُ",57,"ط",1,0],["ومن علمناه غير متَّبعٍ","في المجد بل لا يزال يبتدع",58,"ع",1,0],["ومن عرفناه غير مبتدعٍ","في الدين بل لا يزال يتبع",58,"ع",1,0],["ومُنعَّمٍ كالماء يشفي ذا الصدى","كشفائه ويشفُّ مثل شفيفه",59,"ف",2,0],["ومن عجيبِ الأمرِ بل من مُعْضلِهْ","مُخوَّلٌ يصغي إلى مُخوّلِهْ",60,"ل",2,0],["ومن عادتي تكذيبُ ظنّ مُحاذري","كما عادتي تصديقُ ظن المؤملِ",61,"ل",1,0],["ومن عتبك الغثِ الذي قد عتبته","على ابن فرات موضعٌ ليسَ يُعقلُ",62,"ل",1,0],["ومنعِهِ لذَّةَ التَّعتُّبِ بال","عدلِ عليه في كل أحكامي",63,"م",2,0],["ومن عجائب ما يُمنَى الرِّجالُ به","مُستَضْعَفاتٌ له منهن أقران",64,"ن",1,0],["وَمَن عُصِبَت عَيناهُ فَالوَقتُ كُلُّهُ","لَدَيهِ وَإِن لاحَ الصَباحُ غُروبُ",65,"ب",1,0],["وَمَنَعتِ قَلبي أَن يَقَرَّ قَرارَهُ","وَلَقَد يَكونُ عَلى الخُطوبِ جَليدا",66,"د",2,0],["وَمِن عَجَبٍ عَتبي عَلى الحَسَنِ الَّذي","لَدَيَّ وَعِندي جودُهُ مُتَوالِ",67,"ل",1,0],["وَمِن عُجُزٍ فيها جَناحانِ أَلحَقا","تَوالِيَ لا شَختٍ وَلا مُتَخاذِلِ",68,"ل",1,0],["ومن عجب بعد هذا المشيب","بنى باثنتين على زوجته",69,"ه",1,0],["ومن عجبٍ قيامك في الليالي","وأنت الشمس في نظر الأنام",70,"م",1,0],["وَمِن عَجَبٍ مِنهُمو المُسلِمونَ","أَوِ المُسلِمونَ هُمُ الأَكثَرُ",71,"ر",1,0],["وَمِن عَجَبٍ مَرَّتِ الحادِثاتُ","وَأَنتِ لِأَحدَثِها ناسِيَه",72,"ي",2,0],["وَمِن عَجَبٍ نُثَبِّتُها أُصولاً","وَتِلكَ فُروعُها تَغَشى البِلادا",73,"د",2,0],["وَمُنَعَّمٌ لَم يَلقَ إِلّا لَذَّةً","في طَيِّها شَجَنٌ مِنَ الأَشجانِ",74,"ن",1,0],["وَمِن عَجَبٍ في ظِلِّها وَهوَ وارِفٌ","يُصادِفُ شَعباً آمِناً فَيُغيرُ",75,"ر",1,0],["وَمِن عَبَثِ العِشقِ بِالعاشِقين","حَنينُ القَتيلِ إِلى القاتِلِ",76,"ل",1,0],["وَمِن عَجَبِ الأَشياءِ أَبكي وَأَشتَكي","وَأَنتَ تُغَنّي في الغُصونِ وَتَسجَعُ",77,"ع",1,0],["وَمِن عَجَبٍ يَأسى إِذا قُلتُ مُتعَبٌ","وَيَطرَبُ إِن قُلتُ الأَسيرُ المُمَنَّعُ",77,"ع",1,0],["وَمِن عَبَثِ الدُنيا وَما عَبَثَت سُدىً","شَبَبنا وَشِبنا وَالزَمانُ وَليدُ",78,"د",1,0],["وَمِن عَجَبٍ هُوَ الجِسرُ المُعَلّى","عَلى البُسفورِ يَجمَعُ شاطِئَيهِ",79,"ي",2,0],["وَمِن عَجَبٍ وَهوَ جَدُّ اللَيالي","يُبيدُ اللَيالِيَ فيما يُبيد",80,"د",1,0],["وَمِن عَجيبٍ لِغَيرِ اللَهِ ما سَجَدوا","عَلى الفَلا وَلِغَيرِ اللَهِ ما رَكَعوا",81,"ع",3,0],["وَمِن عَجَبٍ تُشَيِّبُ عاشِقيها","وَتُفنيهِمِ وَما بَرَحَت كَعابا",82,"ب",2,0],["وَمُنعَفِرٍ لِنَصلِ السَيفِ فيهِ","تَواري الضَبِّ خافَ مِنِ اِحتِراشِ",83,"ش",1,0],["وَمِن عَذبِ الرُضابِ إِذا أَنَخنا","يُقَبِّلُ رَحلَ تُروَكَ وَالوِراكا",84,"ك",2,0],["وَمِن عَلِيِّ بنِ عَبدِ اللَهِ مَعرِفَتي","بِحَملِهِ مَن كَعَبدِ اللَهِ أَو كَعَلي",85,"ل",2,0],["وَمِن عاتِقٍ نَصرانَةٍ بَرَزَت لَهُ","أَسيلَةِ خَدٍّ عَن قَريبٍ سَتُلطَمُ",86,"م",1,0],["وَمَن عَرَفَ الأَيّامَ مَعرِفَتي بِها","وَبِالناسِ رَوّى رُمحَهُ غَيرَ راحِمِ",87,"م",1,0],["ومن عافَ إِلّا الصفوَ من كلِّ مشربٍ","أراه يقاسي برحَ ظمآنَ حائمِ",88,"م",1,0],["ومن عَجَبٍ أنّي رجوتُ سلامتي","على من لهُ أينَ الْتَفَتُّ صريعُ",89,"ع",1,0],["وَمِن عَجَبِ الدَهرِ أَنَّ الأَمي","رَ أَصبَحَ أَكتَبَ مِن كاتِبِه",90,"ب",2,0],["وَمِن عادَتي وَالعَجزُ مِن غَيرِ عادَتي","مَتى لا أَرُح عَن حَضرَةِ الذُلِّ أُدلِجِ",91,"ج",1,0],["وَمَن عَزَمَ الفِصادَ بِلا نَبيذٍ","كَمَن عَزَمَ الرَحيلَ بِغَيرِ زادِ",92,"د",1,0],["وَمَنَعتَني الإِنصافَ مِنكَ وَلَم تَكُن","تَأباهُ في بَرٍّ وَلا في فاجِرِ",93,"ر",1,0],["وَمِن عَناءِ المَرءِ أَو أَفنِهِ","في الرَأيِ أَن يَأمُرَ مَن لايُطيع",94,"ع",1,0],["وَمِن عاثِرٍ بِالشَيبِ ضاعَفَ وَجدَهُ","عَلى وَجدِهِ أَن لَم تَقولي لَهُ لَعا",95,"ع",2,0],["وَمُنَعَّمٍ هَجَرُ السُرورِ بِهَجرِهِ","لِمُحِبِّهِ وَوِصالُهُ بِوِصالِهِ",96,"ل",2,0],["وَمِن عَظمٍ كَسيرٍ أَبطَحِيٍّ","جَبَرتَ بِنائِلٍ غَمرٍ جَزيلِ",97,"ل",1,0],["وَمُنِعتُ إِنصافاً وَسِعتَ بِهِ الوَرى","دوني فَجَدُّ ذاكَ أَم حِرمانُ",98,"ن",1,0],["وَمِن عَبدُ شَمسٍ أَنتَ سادِسُ سِتَّةٍ","خِلائِفَ كانوا مِنهُمُ العَمُّ وَالأَبُ",99,"ب",1,0],["وَمِن عَبدِ شَمسٍ قَد تَفَرَّعتَ في العُلى","ذُراها لَكَ القُدموسُ مِنها العُراعِرُ",100,"ر",1,0],["وَمَنَّ عَلى عُليا تَميمٍ إِلى الَّذي","لَها فَوقَ أَعناقٍ طِوالِ الزَرانِقِ",101,"ق",1,0],["وَمِن عَجَبِ الأَيّامِ وَالدَهرِ أَن تُرى","كُلَيبٌ تَبَغّى الماءَ بَينَ الصَرائِمِ",102,"م",1,1],["ومن عدوٍ لكم مُخْفٍ عداوتَه","واللهُ يرميه عنا وهو يرمينا",103,"ن",2,0],["ومنعَّمِينَ عن القِتَالِ بِمَعزلٍ","لبِسوا السُّعودَ بغَفْلَةِ الأقدارِ",104,"ر",1,0],["ومن عَجَبٍ أنَّ الغَبِيِّينِ أبرَقا","مُغِيرَيْنِ في أقطارِ شِعْري وأرعَدا",105,"د",2,0],["ومن عَجبٍ ثَناي على رُضابٍ","تَضِنُّ به ثناياكِ العِذابُ",106,"ب",1,0],["ومن عَجَبٍ أنَّ حِلفَ الفُسو","قِ حالَفه عَدَمُ الأنبياءِ",107,"ا",2,0],["وَمَن عَرَفَ الدَهرَ الخَؤونَ وَصَرفَهُ","تَصبَّر لِلبَلوى وَلَم يُظهِر الشَكوى",108,"و",2,0],["وَمِن عَجَبِ الدُنيا يَقينُكَ بِالفَنا","وَأَنَّكَ فيها لِلبَقاءِ مُريدُ",109,"د",1,0],["وَمَن عَقَلَ اِستَحيا وَأَكرَمَ نَفسَهُ","وَمَن قَنِعَ استَغنى فَهَل أَنتَ قانِعُ",110,"ع",1,0],["وَمَن عَرَفَ المَحامِدَ جَدَّ فيها","وَحَنَّ إِلى المَحامِدِ بِاِحتِيالِه",111,"ل",2,0],["وَمِن عَلامَةِ تَضيِيعي لِآخِرَتي","أَن صِرتُ تُغضِبُني الدُنيا وَتُرضيني",112,"ي",1,0],["وَمُنِعتُ الرُقادَ حَتّى كَأَنّي","أَرمَدُ العَينِ أَو كُحِلتُ بِصابِ",113,"ب",1,0],["وَمِن عَجَبِ الأَيّامِ أَن بادَ مَن يَفي","وَمَن كُنتَ تَرعاني لَهُ وَبَقيتا",114,"ت",2,0],["ومن عجبي أني أروم لقاكم","وطرفي لكم محوى وقلبي لكم مغنى",115,"ن",2,1],["وَمَن عَجَبِ الأَشياءِ أَنَّ جَريمَةً","يَجيءُ بِها زَيدٌ فَيُجزى بِها عَمرُو",116,"و",1,0],["وَمِن عَجَبٍ أَنَّ السَحابَ بِقَبرِهِ","وَأَسأَلُ مِن صَوبِ الحَيا رَيَّ رَبِّهِ",117,"ب",2,0],["وَمَن عَشِقَ العَلاءَ وَخافَ حَتفاً","غَدا عِندَ الكَريهَةِ وَهوَ سالي",118,"ي",1,0],["وَمِن عَجَبي أَنّي أَحِنُّ إِلَيكُمُ","وَلَم يَخلُ طَرفي مِن سَناكُم وَلا قَلبي",119,"ي",1,1],["وَمَن عَلَّمَتني المَدحَ أَو صافُ مَجدِهِ","فَما زِدتُها عِندَ النِظامِ سِوى السَلكِ",120,"ك",1,0],["ومُنَعَّمٍ بين القصو","رِ قد استَتم له الثراء",121,"ا",2,0],["ومن عجب أحنو على السهم غائراً","ويسألني قلبي متى يرجع الرامي",122,"ي",1,0],["وَمِن عَرَضِ الجبنِ المَنوطِ بِغُمرِهمْ","صَفا جَوهَرٌ مِنهُم بِنارِ الوغى سَبكا",123,"ك",2,0],["ومن عَدَمٍ أغنى ومن حيرةٍ هدى","ومن ظمإٍ أروى ومن مرضٍ شفى",124,"ف",2,0],["وَمِن عَجَبٍ أَنَّ الشياطينَ صَيّرَتْ","بُروجَ النُّجومِ المحرِقاتِ مَجالِسا",125,"س",2,0],["وَمَنعتَني مِن لَثمِ فيك","جَنَى الرُّضابِ المُسكِرِ",126,"ر",1,0],["ومنعَّمٌ جَرَحَ الشّبابُ بخَدّهِ","لحظي فسالَ على المها الياقوتُ",127,"ت",1,0],["وَمَن عافَ مَليكُ المَو","تِ وَاِستَقذَرَ مِن قَبضِه",128,"ض",2,0],["وَمِنْ عَجَبٍ أَنِّي أَدِينُ لِحُكْمِهَا","وَأَكْبُرُ أَنْ أَنْقَادَ طَوْعَ الْخَزَائِمِ",129,"م",1,0],["وَمَنْ عَرفَ الدُّنْيَا رَأَى مَا يَسُرُّهُ","مِنَ الْعَيْشِ هَمّاً يَتْرُكُ الشَّهْدَ عَلْقَمَا",130,"م",2,0],["وَمِنْ عَجَبٍ أَنَّا نَرَى الْحَقَّ جَهْرَةً","وَنَلْهُو كَأَنَّا لا نُحَاذِرُ مَنْدَمَا",130,"م",2,0],["وَمِن عَجَبٍ ضَحِكَت إِذ رَأَت","قُرَيبَةُ بِالخَيفِ رَكباً وُقوفا",131,"ف",2,0],["وَمِن عَجَبٍ أَنّي أَرى القَوسَ مُنحَنىً","بِهِ في يَدِ البَيداءِ وَالسَهمَ مُرتَمى",132,"م",2,0],["ومن عدم الأخلاق لم يغن عمله","وإن غلب الأقران أو جاوز الحدا",133,"د",2,0],["ومن عجبٍ أنَّا شبيهان في الهوى","بِمنْ أنت تهوى هل أطَقتَ تجّلدا",134,"د",2,0],["وَمَنَعتَ وَفراً جُمِّعَت","فيها مُذَمَّمَةٌ خَناجِر",135,"ر",1,0],["وَمَنَعتَني شَتمَ البَخيلِ فَلَم يَخَف","شَتمي فَأَصبَحَ آمِناً لا يَفزَعُ",136,"ع",1,0],["وَمَنَعتَ نَفسَكَ فَضلَها وَمَنَحتَها","أَهلَ الفَعالِ فَأَنتَ خَيرٌ مولَعُ",136,"ع",1,0],["وَمِن عَينِ الرَسولِ وَمِن كِتابٍ","إِذا ما فُضَّ مَسَّتهُ يَداكِ",137,"ك",1,0],["وَمِن عَجَبِ الأَيّامِ بَغيُ مَعاشِرٍ","غِضابٍ عَلى سَبقي إِذا أَنا جارَيتُ",138,"ت",1,0],["وَمنْ عُمُدٍ في هِمَّةِ الدَّهرِ قُوَّةٌ","وَفي باعِهِ مِنْ طُولِهنَّ قُصُورُ",139,"ر",1,0],["ومن عَجَبٍ أنّي هَرمْتُ ولم أشِبْ","ومَن يَلَبسِ الهِجرَانَ والبَينَ يَهرَم",140,"م",1,0],["ومن عجَبٍ أنّي أُسائلُ عنهمُ","وهُمْ بينَ أحْناءِ الجوانجِ والصدر",141,"ر",1,0],["ومن عجَبٍ أنَّ اللسانَ جرَى لهمْ","بذكرٍ على حين انقضَوا وانقضى الذكر",142,"ر",1,0],["ومن عجبٍ أن تشجُرَ الرومُ بالقنا","فتوطَأ أغمارٌ وهضْبٌ شناخيب",143,"ب",1,0],["وَمِن عَجَبٍ لِعِشقِهِمُ ال","جُفاةَ الجُلفَ وَالصَحَرا",144,"ر",2,0],["وَمِن عَجَبِ الأَيّامِ أَن قُمتَ ناطِقاً","وَأَنتَ ضَئيلُ الصَوتِ مُنتَفِخُ السَحرِ",145,"ر",1,1],["وَمِن عَجَبٍ يَعدو عَلَيَّ اِبنُ كَشكَشٍ","بِغُرمولِ كِنديرٍ عَلَيهِ سُهادُ",146,"د",1,0],["وَمَنَعنَ خاقانَ المَسارِحَ فَاِنثَنى","عَجِلاً يَشُلُّ سَوامَهُ مَزؤودا",147,"د",2,0],["وَمِن عُجبٍ بِعَبّادَ","ةَ قَد أَعجَبَني البَيتُ",148,"ت",1,0],["وَمِن عَجَبٍ سَعيُ اِبنِ أَغنَمَ فيهِمُ","وَعُثمانَ إِنَّ الدَهرَ جَمُّ عَجائِبُه",149,"ب",2,0],["وَمِن عَجَبِ الأَيّامِ أَنَّ اِجتِنابَنا","رَشادٌ وَلَكِن لا نُطيقُ التَجَنُّبا",150,"ب",2,0],["وَمَن عَصاكَ فَعاقِبهُ مُعاقَبَةً","تَنهى الظَلومَ وَلا تَقعُد عَلى ضَمَدِ",151,"د",1,0],["وَمَن عاشَرتَ مِن إِنسٍ فَحاذِر","غَوائِلَ مُرَّدٍ مُتَهَكِّماتِ",152,"ت",1,0],["وَمَن عاشَ بَينَ الناسِ لَم يَخلُ مِن أَذاً","بِما قالَ واشٍ أَو تَكَلَّمَ حاسِدُ",153,"د",1,0],["وَمَن عايَنَ الدُنيا بِعَينٍ مِنَ النُهى","فَلا جَذَلٌ يُفضي إِلَيهِ وَلا كَبتُ",154,"ت",1,0],["وَمِن عَناءِ اللَيالي خادِمٌ ضَغِنٌ","إِن يُؤمَرِ الأَمرَ يَفعَل غَيرَ ما أُمِرا",155,"ر",2,0],["وَمِن عاداتِ رَيبِ الدَه","رِ أَن يَذعَرَ بابوسَك",156,"ك",1,0],["وَمِن عاداتِهِ في كُلِّ جيلٍ","غَذاهُ أَن يَقِلَّ مُهَذَّبوهُ",157,"ب",3,0],["وَمِن عَجبٍ دَعواكَ عِلماً وَحِكمَةً","وَعِلمُكَ شَيءٌ قيلَ بِالظَنِّ أَو حُزي",158,"ز",2,0],["وَمِن عامِرٍ بيضٌ كَأَنَّ وُجوهَها","مَصابيحُ لاحَت في دُجىً مُتَحالِكِ",159,"ك",1,0],["وَمَنَعتَهُم نَجداً فَقَد","حَلّوا عَلى وَجَلٍ تِهامَه",160,"م",2,0],["وَمن عَنت لوجهه الوجوهُ","فما له نِدٌّ ولا شَبيهُ",161,"ه",1,0],["ومَنَ عليهِ مِن عُيونِ اللَّهِ","حوافظٌ من كُلِّ أمرٍ داهي",161,"ي",1,0],["ومن عاتقٍ نصرانهٍ برزت له","أسيلة خدٍّ عن قليلٍ ستلطم",162,"م",1,0],["\"ومنعفرٍ، لنصف السيف فيه","تواري الضب، خاف من احتراش\"",163,"ش",1,0],["ومن عَجَب وهي مفتونةٌ","تُريكَ الهدى وتْريكَ الضلالْ",164,"ل",1,0],["ومن عَجَبٍ شَدْوُهُ للربيع","وقد يخطىءُ الطيرُ شدوَ الأوانْ",165,"ن",1,0],["ومَنَعْتُمُوها من مواهب أرضِها","ماءً به تجدُ الحياةَ وَزَادا",166,"د",2,0],["وَمِن عَجَبي أَصيدُ الأُسدَ قَهراً","وَأَفتَرِسُ الضَواري كَالهَوامِ",167,"م",1,0],["وَمِنْ عَجَبٍ أَنَّ الْفَتَى وَهْوَ عَاقِلٌ","يُطِيعُ الْهَوَى فِيمَا يُنَافِيهِ رُشْدُهُ",168,"د",2,0],["وَمِنْ عَجَائِبِ ما لاقَيْتُ مِنْ زَمَنِي","أَنِّي مُنِيتُ بِخَطْبٍ أَمْرُهُ عَجَبُ",169,"ب",1,0],["وَمِنْ عَجَبِ الْهَوَى يَا لَيْلُ أَنِّي","فَنِيتُ صَبابَةً وَهَوَاكِ بَاقِي",170,"ي",1,0],["وَمِنْ عَجَبٍ أَنَّا نُسَاءُ وَنَرْتَضِي","وَنُدْرِكُ أَسْبَابَ الْفَنَاءِ وَنَطْمَعُ",171,"ع",1,0],["وَمِنْ عَجَبِ الأَيَّامِ أَنِّي مُولَعٌ","بِمَنْ لَيْسَ يَعْنِيهِ بُكَائِي وَلا سُهْدِي",172,"ي",1,0],["وَمِنْ عُرُوضِ التجَارَا","تِ تُحْفَةٌ عِنْدَ تُحْفَهْ",173,"ف",2,0],["وَمِنْ عَجَبٍ أَنَّ الأُولَى فَازَ دُونَهُمْ","بِخَصِلِ الْعُلَى يَبْكُونَ مَنْ فَازَ بِالخَصْل",174,"ل",1,0],["وَمِنْ عِزَّةٍ قَعْساءَ أَبْلَوا لِصَوْنِهَا","بِلاءَ أُبَاةِ الضَّيْمِ فِي الْكَرِّ وَالْفَرِّ",175,"ر",1,0],["وَمِنْ عَلاَّمَةٍ لُسُنٍ أَدِيبٍ","لَهُ فِي الَفضْلِ أَبْقَى الذِّكْرَيَاتِ",176,"ت",1,0],["وَمَنْ عَدَا الأَجَلَ المَحْتُومَ مَطْلَبُهُ","عَدَا الفَنَاءَ بِذِكْرٍ غَيْرَ مَلْحُودِ",177,"د",1,0],["وَمنَ عَلَى مَتَمنىً","سَلاَمَةِ الذَّوْقِ جَاءَ",178,"ا",2,0],["وَمن عَرَفَ الدُنيا صَحا مِن سُرورِهِ","وَأَمسى كَما أَمسَيتُ مِن هَمِّهِ يَنشو",179,"و",1,0],["وَمِن عَجَبِ الدُنيا غَيربٌ مُحَبَّبٌ","وَمِن نَكَدِ الدُنيا أَلَدَّ جَهولُ",180,"ل",1,0],["وَمَنْ عَلِمَ الرَّحْمنُ نِيَّةَ صِدْقِهِ","أَتَتْهُ بِأَلْطَافِ الإِلاَهِ عَجَائِبُهُ",181,"ب",2,0],["ومن عجب أن خاننا فيك عزمنا","ولا العهد منسي ولا الحي شاسع",182,"ع",1,0],["ومن علمَ الرحمنُ نية صدقهِ","أتته بألطاف الإله عجائبهُ",183,"ب",2,0],["ومنعت أوفرَ جمَّعت","فيه مذمِّمة ٌ خناجر",184,"ر",1,0],["ومنعتَ نفسك فضلها ومنعتها","أهْلَ الفَعال فأنت شَرٌّ مُولعُ",185,"ع",1,0],["ومن عمه فيه شمائلُ أصبحت","وبالاً على قومٍ وإن كن ....دا",186,"د",2,0],["ومن عجب وعي مفتونة","تريك الهدى وتريك الضّلال",187,"ل",1,0],["ومَن عاثَ في أممِ المشرقَينَ","وجارَ على أهلها واحتمى",188,"ا",1,0],["ومن عجبٍ أنّ القوافي سوائلا","اذا شُحِذَتْ للحَصْدِ فِهي مَناجل",189,"ل",1,0],["ومن على ضَفَّتيه انصاعَ منغمرا","في الماء نصفٌ فوقَه الشَجر",190,"ر",1,0],["ومن عاشَ بين النّاس لم يخلُ من أذًى","بما قال واشٍ، أو تكلم حاسد",191,"د",1,0],["وَمِنْ عَجَبٍ ضَحِكَتْ إذْ رَأَتْ","قُرَيْبَة ُ بِکلخَيْفِ رَكْباً وُقُوفا",192,"ف",2,0],["ومن عصيت عيناه فالوقت كلّه","لديه ، وإن لاح الصباح ، غروب",193,"ب",1,0]]}