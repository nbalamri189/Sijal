{"poems":[[86,"أما أمين فقد ذقنا لمصرعه","https://www.aldiwan.net/poem10377.html","البسيط"],[83,"الوجود يقول هنيا","https://www.aldiwan.net/poem54205.html","مجزوء الرمل"],[47,"أيلحاني على العبرات لاح","https://www.aldiwan.net/poem25341.html","الوافر"],[51,"أيلتمس الناس الغنى فيصيبهم","https://www.aldiwan.net/poem66703.html","الطويل"],[91,"الحسن حولك في الوهاد وفي الذرى","https://www.aldiwan.net/poem8867.html","عموديه"],[91,"راودني النوم وما برحا حتى طأطأت له راسي","https://www.aldiwan.net/poem8971.html","عموديه"],[91,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[89,"إني غير مختار وفارق مضطرا","https://www.aldiwan.net/poem45097.html","الطويل"],[45,"ها هو الشيب لائما فأفيقي","https://www.aldiwan.net/poem65182.html","الخفيف"],[49,"أنلهو وأيامنا تذهب","https://www.aldiwan.net/poem10343.html","المتقارب"],[49,"حتى متى يستفزني الطمع","https://www.aldiwan.net/poem62168.html","المنسرح"],[105,"أعن خطب الخلافة تسألينا","https://www.aldiwan.net/poem42132.html","الوافر"],[50,"على واسط من ربها ألف لعنة","https://www.aldiwan.net/poem62350.html","الطويل"],[46,"إذا سنة بكى تشرين فيها","https://www.aldiwan.net/poem22556.html","الوافر"],[46,"أمرت هذه الدنيا ومرت","https://www.aldiwan.net/poem22629.html","الوافر"],[46,"إياك والأيمان تلقي بها","https://www.aldiwan.net/poem22636.html","السريع"],[46,"وجدت ابن آدم في غرة","https://www.aldiwan.net/poem23006.html","المتقارب"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142022","الهزج"],[100,"منها وإليها","https://www.poetsgate.com/ViewPoem.aspx?id=50159",""],[98,"الشباب الذاوى","https://www.poetsgate.com/ViewPoem.aspx?id=55332",""],[90,"أمنعم القلب الخلى","https://www.poetsgate.com/ViewPoem.aspx?id=178972",""],[90,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[47,"أيَلْحاني، عَلى العَبَرَاتِ، لاحِ","https://www.poetsgate.com/ViewPoem.aspx?id=14754",""],[91,"أخت البلجيك","https://www.poetsgate.com/ViewPoem.aspx?id=53153",""]],"verses":[["أَيَلبَسُ الخَزَّ مَن لانَت مَهَزَّتَهُ","وَأَنتَ تَخرُجُ مِن دُنياكَ عُريانا",0,"ن",2,0],["إيلها يا ما وليّا","فم أشهاك وم أحلاك",1,"ك",1,0],["أَيَلحاني عَلى العَبَراتِ لاحِ","وَقَد يَإِسَ العَواذِلُ مِن صَلاحي",2,"ح",2,1],["أيلتمسُ الناسُ الغنى فيصيبهم","وألتمسُ القوتَ الطفيف فيلتوي",3,"ت",3,1],["أَيلولُ يَمشي في الحُقول وَفي الرُبى","وَالأَرضُ في أَيلولَ أَحسَنُ مَنظَرا",4,"ر",2,0],["أَيَلَذُّ لِغُصنٍ مُنكَسِرٍ","عَرَّتهُ الريحُ مِنَ الوَرَقِ",5,"ق",1,0],["أَيَلُفُّ كَاللَيلِ الأَباطِحِ وَالرُبى","وَالمَنزِلَ المَعمورَ وَالمهجورا",6,"ر",2,0],["أيُلقى رنان في الجحيم وبخنر","وداروين من عن أصلنا كشف السترا",7,"ر",2,0],["أَيُّ لَيلٍ يُبهى بِغَيرِ نُجومٍ","أَم سَحابٍ يَندى بِغَيرِ بُروقِ",8,"ق",1,0],["أَيَلهو وَيَلعَبُ مَن نَفسُهُ","تَموتُ وَمَنزِلُهُ يَخرَبُ",9,"ب",1,0],["أَيُّ لَبيبٍ تَصفو الحَياةُ لَهُ","وَالمَوتُ وِردٌ لَهُ وَمُنتَجَعُ",10,"ع",1,0],["أيلدزُ ما دهاكِ وأيُّ رامٍ","رماكِ فهدَّ سؤدُدَكِ المكينا",11,"ن",2,0],["أَيُلتَمَسُ المُعروفُ مِن أَهلِ واسِطٍ","وَواسِطُ مَأوى كُلِّ عِلجٍ وَساقِطِ",12,"ط",1,0],["أَيُلقى العُذرُ أَم أَبَتِ الخَطايا","قَديماً أَن يَكونَ لَكِ اِعتِذارُ",13,"ر",1,0],["أَيَلبَثُ لي فَأَذكُرَهُ زَمانٌ","فَإِنّي خِلتُهُ نَسِيَ السُرورا",14,"ر",2,0],["أَيُلحِدُ الشَيخُ وَمَلحودُهُ","قَد آنَ للحافِرِ أَن يَحفِرَه",15,"ر",2,0],["أَيَلتَمِسُ الماءَ مِن ناكِزٍ","وَيَترُكُ جَمّاً لِمَن يَغتَرِف",16,"ف",1,0],["أيْ ليالي الوصلِ هل من عودَة","ومن التعليلِ قولُ الصَبّ أَي",17,"ي",1,0],["ايلولٌ على الأبواب","لا عشنا لأيلول",18,"ل",1,0],["أيّ لحن أهدي إليك ومعنا","ك لحون تسمو على الفنّ زهوا",19,"و",2,0],["أيلام الورد الجنى إذا جف","رحيق الجمال فى وجناته",20,"ت",2,0],["أيلام إلْفٌ بان عنه","أليفُه فبكى وحن",21,"ن",1,0],["أي لونٍ ألقتْ على الأرضِ حَلَّى","كلَّ ما فوقَها ، وأيَّ خِضاب",22,"ب",1,0],["أيَلْحاني، عَلى العَبَرَاتِ، لاحِ","وَقد يَئسَ العَوَاذِلُ من صَلاحي",23,"ح",2,1],["أيلبيت يشرب من معين دموعه","وتبيت تحسوها كعين الدّيك؟",24,"ك",1,0]]}