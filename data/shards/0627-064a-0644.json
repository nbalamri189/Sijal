{"poems":[[86,"أما أمين فقد ذقنا لمصرعه","https://www.aldiwan.net/poem10377.html","البسيط"],[83,"الوجود يقول هنيا","https://www.aldiwan.net/poem54205.html","مجزوء الرمل"],[47,"أيلحاني على العبرات لاح","https://www.aldiwan.net/poem25341.html","الوافر"],[51,"أيلتمس الناس الغنى فيصيبهم","https://www.aldiwan.net/poem66703.html","الطويل"],[91,"الحسن حولك في الوهاد وفي الذرى","https://www.aldiwan.net/poem8867.html","عموديه"],[91,"راودني النوم وما برحا حتى طأطأت له راسي","https://www.aldiwan.net/poem8971.html","عموديه"],[91,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[89,"إني غير مختار وفارق مضطرا","https://www.aldiwan.net/poem45097.html","الطويل"],[45,"ها هو الشيب لائما فأفيقي","https://www.aldiwan.net/poem65182.html","الخفيف"],[49,"أنلهو وأيامنا تذهب","https://www.aldiwan.net/poem10343.html","المتقارب"],[49,"حتى متى يستفزني الطمع","https://www.aldiwan.net/poem62168.html","المنسرح"],[105,"أعن خطب الخلافة تسألينا","https://www.aldiwan.net/poem42132.html","الوافر"],[50,"على واسط من ربها ألف لعنة","https://www.aldiwan.net/poem62350.html","الطويل"],[46,"إذا سنة بكى تشرين فيها","https://www.aldiwan.net/poem22556.html","الوافر"],[46,"أمرت هذه الدنيا ومرت","https://www.aldiwan.net/poem22629.html","الوافر"],[46,"إياك والأيمان تلقي بها","https://www.aldiwan.net/poem22636.html","السريع"],[46,"وجدت ابن آدم في غرة","https://www.aldiwan.net/poem23006.html","المتقارب"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142022","الهزج"],[100,"منها وإليها","https://www.poetsgate.com/ViewPoem.aspx?id=50159",""],[98,"الشباب الذاوى","https://www.poetsgate.com/ViewPoem.aspx?id=55332",""],[90,"أمنعم القلب الخلى","https://www.poetsgate.com/ViewPoem.aspx?id=178972",""],[90,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[47,"أيَلْحاني، عَلى العَبَرَاتِ، لاحِ","https://www.poetsgate.com/ViewPoem.aspx?id=14754",""],[91,"أخت البلجيك","https://www.poetsgate.com/ViewPoem.aspx?id=53153",""],[115,"مسقط","https://www.aldiwan.net/poem24041.html","الخفيف"],[130,"إن للبين صولة وهجوما","https://www.aldiwan.net/poem54650.html","الخفيف"],[140,"أى لبيب بك لم يخدع","https://www.aldiwan.net/poem58407.html","السريع"],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[208,"قسما بفرط تلهبي وتلهفي","https://www.aldiwan.net/poem13350.html","الكامل"],[221,"نحن عدن وهم مكان مريب","https://www.aldiwan.net/poem39718.html","الخفيف"],[223,"يا فتاة الحي قد أذكرتنا","https://www.aldiwan.net/poem55174.html","الرمل"],[254,"أيلول والعيد واعتدال الهواء","https://www.aldiwan.net/poem48466.html","مخلع البسيط"],[279,"تذاكرن ذكرى أو تهيج اللواعجا","https://www.aldiwan.net/poem1361.html",""],[302,"ولى الزمان وولت الأيام","https://www.aldiwan.net/poem16867.html","الكامل"],[303,"دليل اصطفاء الله للعبد علمه","https://www.aldiwan.net/poem56414.html","الطويل"],[364,"وسادة قد سقت مجالسهم","https://www.aldiwan.net/poem17736.html","المنسرح"],[366,"أغالبك القلب اللجوج صبابة","https://www.aldiwan.net/poem1865.html","الطويل"],[374,"أيلام بشر بالهوى وهو الفتى","https://www.aldiwan.net/poem66983.html","الكامل"],[377,"من لصب أحشاؤه في التهاب","https://www.aldiwan.net/poem49258.html","الخفيف"],[406,"أيلام مسلوب الفؤاد فقيده","https://www.aldiwan.net/poem32496.html","الكامل"],[429,"طلعت ربيعا من ربيع وأربع","https://www.aldiwan.net/poem12659.html","الطويل"],[447,"النكسة","https://www.aldiwan.net/poem994.html",""],[451,"أيها العام الذي","https://www.aldiwan.net/poem61588.html","مجزوء الرمل"],[477,"لست الإله ولست بالشيطان","https://www.aldiwan.net/poem36946.html","الكامل"],[477,"كل يهرول نحوها وييمم","https://www.aldiwan.net/poem37573.html","الكامل"],[512,"أما ومواضي مقلتيها الفواصل","https://www.aldiwan.net/poem20797.html","الطويل"],[527,"أنا أطلب التعجيل منك وقد","https://www.aldiwan.net/poem37231.html","الكامل"],[536,"بدون اجتهاد لا يكون التعلم","https://www.aldiwan.net/poem47465.html","عموديه"],[541,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[573,"تلاقى تلاقي سورة ليس تعلم","https://www.aldiwan.net/poem2857.html","الطويل"]],"verses":[["أَيَلبَسُ الخَزَّ مَن لانَت مَهَزَّتَهُ","وَأَنتَ تَخرُجُ مِن دُنياكَ عُريانا",0,"ن",2,0],["إيلها يا ما وليّا","فم أشهاك وم أحلاك",1,"ك",1,0],["أَيَلحاني عَلى العَبَراتِ لاحِ","وَقَد يَإِسَ العَواذِلُ مِن صَلاحي",2,"ح",2,1],["أيلتمسُ الناسُ الغنى فيصيبهم","وألتمسُ القوتَ الطفيف فيلتوي",3,"ت",3,1],["أَيلولُ يَمشي في الحُقول وَفي الرُبى","وَالأَرضُ في أَيلولَ أَحسَنُ مَنظَرا",4,"ر",2,0],["أَيَلَذُّ لِغُصنٍ مُنكَسِرٍ","عَرَّتهُ الريحُ مِنَ الوَرَقِ",5,"ق",1,0],["أَيَلُفُّ كَاللَيلِ الأَباطِحِ وَالرُبى","وَالمَنزِلَ المَعمورَ وَالمهجورا",6,"ر",2,0],["أيُلقى رنان في الجحيم وبخنر","وداروين من عن أصلنا كشف السترا",7,"ر",2,0],["أَيُّ لَيلٍ يُبهى بِغَيرِ نُجومٍ","أَم سَحابٍ يَندى بِغَيرِ بُروقِ",8,"ق",1,0],["أَيَلهو وَيَلعَبُ مَن نَفسُهُ","تَموتُ وَمَنزِلُهُ يَخرَبُ",9,"ب",1,0],["أَيُّ لَبيبٍ تَصفو الحَياةُ لَهُ","وَالمَوتُ وِردٌ لَهُ وَمُنتَجَعُ",10,"ع",1,0],["أيلدزُ ما دهاكِ وأيُّ رامٍ","رماكِ فهدَّ سؤدُدَكِ المكينا",11,"ن",2,0],["أَيُلتَمَسُ المُعروفُ مِن أَهلِ واسِطٍ","وَواسِطُ مَأوى كُلِّ عِلجٍ وَساقِطِ",12,"ط",1,0],["أَيُلقى العُذرُ أَم أَبَتِ الخَطايا","قَديماً أَن يَكونَ لَكِ اِعتِذارُ",13,"ر",1,0],["أَيَلبَثُ لي فَأَذكُرَهُ زَمانٌ","فَإِنّي خِلتُهُ نَسِيَ السُرورا",14,"ر",2,0],["أَيُلحِدُ الشَيخُ وَمَلحودُهُ","قَد آنَ للحافِرِ أَن يَحفِرَه",15,"ر",2,0],["أَيَلتَمِسُ الماءَ مِن ناكِزٍ","وَيَترُكُ جَمّاً لِمَن يَغتَرِف",16,"ف",1,0],["أيْ ليالي الوصلِ هل من عودَة","ومن التعليلِ قولُ الصَبّ أَي",17,"ي",1,0],["ايلولٌ على الأبواب","لا عشنا لأيلول",18,"ل",1,0],["أيّ لحن أهدي إليك ومعنا","ك لحون تسمو على الفنّ زهوا",19,"و",2,0],["أيلام الورد الجنى إذا جف","رحيق الجمال فى وجناته",20,"ت",2,0],["أيلام إلْفٌ بان عنه","أليفُه فبكى وحن",21,"ن",1,0],["أي لونٍ ألقتْ على الأرضِ حَلَّى","كلَّ ما فوقَها ، وأيَّ خِضاب",22,"ب",1,0],["أيَلْحاني، عَلى العَبَرَاتِ، لاحِ","وَقد يَئسَ العَوَاذِلُ من صَلاحي",23,"ح",2,1],["أيلبيت يشرب من معين دموعه","وتبيت تحسوها كعين الدّيك؟",24,"ك",1,0],["أيُّ لونٍ لما بَقي من حياتي","مِن انعدامِ الأضواءِ والألوانِ",25,"ن",1,0],["أيُلامُ المشوقُ إِن ظل يبكى","منزلاتٍ دوراسَ ورُسوما",26,"م",2,0],["أىُّ لبيبٍ بك لم يُخدَعِ","وأيُّ عين فيك لم تدمَعِ",27,"ع",1,1],["أَيُّ لَفظٍ يَكونُ كُفؤاً لِمَعنا","هُ وَفي الخَلقِ ما لَهُ أَكفاءُ",28,"ا",2,0],["أيلومني حسدا عليك بجهله","ليس العذول على هواك بمنصفي",29,"ي",1,0],["أَيُّ لَونٍ كَأَنَّهُ الصُبحُ فيهِ","مِن بَقايا الفَجرِ العَميقِ شُحوبُ",30,"ب",1,0],["أَيُّ لحنٍ تَرجَمَت تِلكَ الخُطا","عنه لِلعَينِ هناء الأُذُنِ",31,"ن",1,0],["أيلول والعيد واعتدال ال","هواء في الليل والنهارِ",32,"ر",1,1],["أيلحقُ جلس للبيوتِ مداهمُ","ولم يحظ في تلك المدارج دارجا",33,"ج",2,0],["إيلام مثلي في هوى أمثالهم","كلا وكلى لوعة وغرام",34,"م",1,0],["أَيلزمُ حرُّ النفسِ برزخ حيرةٍ","عكوفاً عَلى أصنام وهم تهمّهُ",35,"م",2,0],["أَيُّ لِسانٍ لِمَن يَذُمُّهُمُ","وَأَيُّ قَولٍ لِمَن يَرومُهُمُ",36,"م",1,0],["أيُلحى امرؤ في حبِّ أسماء قد نأى","بِغَمْزٍ من الواشين وازوَرَّ جانبُهْ",37,"ب",2,0],["أَيُلامُ بِشرٌ بالهوى وهوَ الفتى","وقد استقام مُدجَّجاً بفَتاءِ",38,"ا",2,1],["أَيَليقُ الصُدود عَن عاشق لَي","سَ لَهُ بُغية سِوى الإِقتِرابِ",39,"ب",1,0],["أَيُلامُ مسلوبُ الفؤادِ فقيدُهُ","جَحَدَ الغرامَ فأَثْبتتهُ شُهودُهُ",40,"د",2,1],["أيُلْحِدُ في فضلي امرؤ لو أمتُّهُ","لأويسَ بالإلحادِ مرجوّ مَرْجِعِ",41,"ع",1,0],["أيليق بي أن استمد شريعتي","من كافر بشريعة الخلاق",42,"ق",1,0],["أي لون منه يا عا","مٌ به للحلم وكر",43,"ر",1,0],["أيليق واأسفا بتضحية الأخ","وة تحت هيكل معبد الشيطان",44,"ن",1,0],["أيليق بالأحياء غض الطرف","عن بذل الإعانة وهو ميتا منعم",45,"م",1,0],["أيَلحَقُني في حُبِّها نقصُ سَلْوةٍ","إذاً فارَقَتْني نِسبَتي للفَضائِلِ",46,"ل",1,0],["أَيُلامُ في اسْتِعجالِ مَطْلَبِهِ","مَنْ كَانَ مَخْلوقاً منَ العَجَلِ",47,"ل",1,0],["أيَلزَمُ أَن يَبقَى الفَتى طولَ عُمرِه","مُكِبًّا على أخذٍ إلى حِينَ يُعدَمُ",48,"م",1,0],["أَيُّ لُبٍّ لِاِمرِئٍ في قَدرِهِ","عائِذٍ بِالحُزنِ إِذ تُشجيهِ دارُ",49,"ر",1,0],["أَيلبسُ ثوبَ الخدِّ إِذ كان سَاذَجاً","ويتركه لمَّا غَدَا وهو مُعْلَمُ",50,"م",1,0]]}