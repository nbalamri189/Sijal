sgate.com/ViewPoem.aspx?id=202541",""],[313,"ألا واشيب عيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=902&r=&rc=3",""],[6268,"شاعر في المنفى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82919&r=&rc=5",""],[6324,"اللحن الشريد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87935&r=&rc=0",""],[5190,"شموع ودموع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85041&r=&rc=116",""],[5190,"لا تسألي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85040&r=&rc=115",""],[5567,"فيوضات فارابية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82101&r=&rc=142",""]],"verses":[["أَيَلبَسُ الخَزَّ مَن لانَت مَهَزَّتَهُ","وَأَنتَ تَخرُجُ مِن دُنياكَ عُريانا",0,"ن",2,0],["إيلها يا ما وليّا","فم أشهاك وم أحلاك",1,"ك",1,0],["أَيَلحاني عَلى العَبَراتِ لاحِ","وَقَد يَإِسَ العَواذِلُ مِن صَلاحي",2,"ح",2,1],["أيلتمسُ الناسُ الغنى فيصيبهم","وألتمسُ القوتَ الطفيف فيلتوي",3,"ت",3,1],["أَيلولُ يَمشي في الحُقول وَفي الرُبى","وَالأَرضُ في أَيلولَ أَحسَنُ مَنظَرا",4,"ر",2,0],["أَيَلَذُّ لِغُصنٍ مُنكَسِرٍ","عَرَّتهُ الريحُ مِنَ الوَرَقِ",5,"ق",1,0],["أَيَلُفُّ كَاللَيلِ الأَباطِحِ وَالرُبى","وَالمَنزِلَ المَعمورَ وَالمهجورا",6,"ر",2,0],["أيُلقى رنان في الجحيم وبخنر","وداروين من عن أصلنا كشف السترا",7,"ر",2,0],["أَيُّ لَيلٍ يُبهى بِغَيرِ نُجومٍ","أَم سَحابٍ يَندى بِغَيرِ بُروقِ",8,"ق",1,0],["أَيَلهو وَيَلعَبُ مَن نَفسُهُ","تَموتُ وَمَنزِلُهُ يَخرَبُ",9,"ب",1,0],["أَيُّ لَبيبٍ تَصفو الحَياةُ لَهُ","وَالمَوتُ وِردٌ لَهُ وَمُنتَجَعُ",10,"ع",1,0],["أيلدزُ ما دهاكِ وأيُّ رامٍ","رماكِ فهدَّ سؤدُدَكِ المكينا",11,"ن",2,0],["أَيُلتَمَسُ المُعروفُ مِن أَهلِ واسِطٍ","وَواسِطُ مَأوى كُلِّ عِلجٍ وَساقِطِ",12,"ط",1,0],["أَيُلقى العُذرُ أَم أَبَتِ الخَطايا","قَديماً أَن يَكونَ لَكِ اِعتِذارُ",13,"ر",1,0],["أَيَلبَثُ لي فَأَذكُرَهُ زَمانٌ","فَإِنّي خِلتُهُ نَسِيَ السُرورا",14,"ر",2,0],["أَيُلحِدُ الشَيخُ وَمَلحودُهُ","قَد آنَ للحافِرِ أَن يَحفِرَه",15,"ر",2,0],["أَيَلتَمِسُ الماءَ مِن ناكِزٍ","وَيَترُكُ جَمّاً لِمَن يَغتَرِف",16,"ف",1,0],["أيْ ليالي الوصلِ هل من عودَة","ومن التعليلِ قولُ الصَبّ أَي",17,"ي",1,0],["أيلامُ الورد الجنيّ إذا جفَ","رحيقُ الجمال في وجناتِه",18,"ت",2,0],["ايلولٌ على الأبواب","لا عشنا لأيلول",19,"ل",1,0],["أيّ لحن أهدي إليك ومعنا","ك لحون تسمو على الفنّ زهوا",20,"و",2,0],["أيلام إلْفٌ بان عنه","أليفُه فبكى وحن",21,"ن",1,0],["أي لونٍ ألقتْ على الأرضِ حَلَّى","كلَّ ما فوقَها ، وأيَّ خِضاب",22,"ب",1,0],["أيَلْحاني، عَلى العَبَرَاتِ، لاحِ","وَقد يَئسَ العَوَاذِلُ من صَلاحي",23,"ح",2,1],["أيلبيت يشرب من معين دموعه","وتبيت تحسوها كعين الدّيك؟",24,"ك",1,0],["أيّ لوم على الكهول وخاضوا","غمرات العلى شبولا وأسدا",25,"د",2,0],["أيُّ لونٍ لما بَقي من حياتي","مِن انعدامِ الأضواءِ والألوانِ",26,"ن",1,0],["أيُلامُ المشوقُ إِن ظل يبكى","منزلاتٍ دوراسَ ورُسوما",27,"م",2,0],["أىُّ لبيبٍ بك لم يُخدَعِ","وأيُّ عين فيك لم تدمَعِ",28,"ع",1,1],["أَيُّ لَفظٍ يَكونُ كُفؤاً لِمَعنا","هُ وَفي الخَلقِ ما لَهُ أَكفاءُ",29,"ا",2,0],["أيلومني حسدا عليك بجهله","ليس العذول على هواك بمنصفي",30,"ف",2,0],["أَيُّ لَونٍ كَأَنَّهُ الصُبحُ فيهِ","مِن بَقايا الفَجرِ العَميقِ شُحوبُ",31,"ب",1,0],["أَيُّ لحنٍ تَرجَمَت تِلكَ الخُطا","عنه لِلعَينِ هناء الأُذُنِ",32,"ن",1,0],["أيلول والعيد واعتدال ال","هواء في الليل والنهارِ",33,"ر",1,1],["أيلحقُ جلس للبيوتِ مداهمُ","ولم يحظ في تلك المدارج دارجا",34,"ج",2,0],["إيلام مثلي في هوى أمثالهم","كلا وكلى لوعة وغرام",35,"م",1,0],["أَيلزمُ حرُّ النفسِ برزخ حيرةٍ","عكوفاً عَلى أصنام وهم تهمّهُ",36,"م",2,0],["أَيُّ لِسانٍ لِمَن يَذُمُّهُمُ","وَأَيُّ قَولٍ لِمَن يَرومُهُمُ",37,"م",1,0],["أيُلحى امرؤ في حبِّ أسماء قد نأى","بِغَمْزٍ من الواشين وازوَرَّ جانبُهْ",38,"ب",2,0],["أَيُلامُ بِشرٌ بالهوى وهوَ الفتى","وقد استقام مُدجَّجاً بفَتاءِ",39,"ا",2,1],["أَيَليقُ الصُدود عَن عاشق لَي","سَ لَهُ بُغية سِوى الإِقتِرابِ",40,"ب",1,0],["أَيُلامُ مسلوبُ الفؤادِ فقيدُهُ","جَحَدَ الغرامَ فأَثْبتتهُ شُهودُهُ",41,"د",2,1],["أيُلْحِدُ في فضلي امرؤ لو أمتُّهُ","لأويسَ بالإلحادِ مرجوّ مَرْجِعِ",42,"ع",1,0],["أيليق بي أن استمد شريعتي","من كافر بشريعة الخلاق",43,"ق",1,0],["أي لون منه يا عا","مٌ به للحلم وكر",44,"ر",1,0],["أيليق واأسفا بتضحية الأخ","وة تحت هيكل معبد الشيطان",45,"ن",1,0],["أيليق بالأحياء غض الطرف","عن بذل الإعانة وهو ميتا منعم",46,"م",1,0],["أيَلحَقُني في حُبِّها نقصُ سَلْوةٍ","إذاً فارَقَتْني نِسبَتي للفَضائِلِ",47,"ل",1,0],["أَيُلامُ في اسْتِعجالِ مَطْلَبِهِ","مَنْ كَانَ مَخْلوقاً منَ العَجَلِ",48,"ل",1,0],["أيَلزَمُ أَن يَبقَى الفَتى طولَ عُمرِه","مُكِبًّا على أخذٍ إلى حِينَ يُعدَمُ",49,"م",1,0],["أَيُّ لُبٍّ لِاِمرِئٍ في قَدرِهِ","عائِذٍ بِالحُزنِ إِذ تُشجيهِ دارُ",50,"ر",1,0],["أَيلبسُ ثوبَ الخدِّ إِذ كان سَاذَجاً","ويتركه لمَّا غَدَا وهو مُعْلَمُ",51,"م",1,0],["أيلوح في العلياء غير نجومها","تلك الثواقب بالضيا المتوقد",52,"د",1,0],["ايلوح في الآفاق نجمي بعدما","في الخافقين ضياء شمسك قد ظهر",53,"ر",1,0],["أَي لَيل غسلت جسماً خَبيثاً","مِن ذُنوب أَو مِن جَنابة عام",54,"م",1,0],["أيلهوا مرؤٌ مثلي صباه قد انقضى","بخمسين عاماً قد تولت من العمرِ",55,"ر",1,0],["أي ليث ببسطةٍ قد تقضى","لرعايا بهائم في مفازهْ",56,"ز",2,1],["أيلتمس القوت الجياع من الثرى","ويأبون إلا أن يخالطه السمن",57,"ن",1,0],["أيلزمني أن لا أرى غير ما يرى","ولست بمضطر ولا بمكلَّف",58,"ف",1,0],["أيلتمس الحكم الرجال وكلهم","بشرِّ مداه والمآل عليم",59,"م",1,0],["أَيَلا لائِمي جَهلاً عَلى العِشقِ وَالهَوى","وَصَومي عَنِ السّلوى بِنصّ وَتَعريضِ",60,"ض",1,1],["أَيُّ لَفظٍ يَسعَ المَعنى الَّذي","مِنكَ أَستَوحيهِ يا وَحيَ قَصيدي",61,"د",2,0],["أيليق فرعاً أن تعادوا خصمهم","ويحلُّ شرعاً نصر باغ غائل",62,"ل",1,0],["أيلغي عدو اللّه شرع محمد","وقهر جلال اللّه حامي الحقيقة",63,"ه",1,0],["أيلحق باللقيا أو الوصل من يغو","ر \"في نوره\" بدر السماء وجندُهُ",64,"د",2,0],["أيلسع مؤمن من جحر أفعى","ويختدع اغتراراً مرتين",65,"ن",1,0],["أيّ ليث ما كنت أحسب أنّ الده","ر يغتاله فيخلو العرين",66,"ن",1,0],["أي ليث حام وغيث ندى ه","ام إذا ما طغت عدا أو جدوبُ",67,"ب",1,0],["أي ليل علىالمحب أطاله","سائق الظعن يوم زمّ جماله",68,"ل",2,1],["أيلتذّ بالدّنيا منعَّمُ بالِ","وللموت في الأحشاء رَشقُ نِبَال",69,"ل",1,1],["أيّ لفظ بالغ ذاك المدى","أو لسانٌ واصفٌ ذَاكَ الكرم",70,"م",1,0],["أيليق بي بعد المشيب صبابة","بأغر ساه طرفه فتاكه",71,"ك",2,0],["أيليق ان تطىء الثرى يا زائري","فاسعى على سمعي الي وناظري",72,"ي",1,1],["ايلام مثلي لو جرت عبراته","ببياض دمع أو بأحمر ادكن",73,"ن",1,0],["ايليا طب نفساً فديتك واستمع","نظماً كما نظم الجمان منضدا",74,"د",2,1],["ايلي لقد اضحى بحبك هائماً","وعلى سواك فؤاده ما عرجا",75,"ج",2,0],["أَيُّ لَهوٍ لامرئٍ يَبقى خلي","وَقد الفَودانِ مِنهُ وأَسَن",76,"ن",1,0],["أيلام وهو إذا تعلم ناشئاً","لغداً هو الحر الابيُّ الحازم",77,"م",1,0],["ايلهيك التبرج والتعري","طباع الجاهلية لا مراء",78,"ا",2,0],["أيلام من صنع الجميل مع الورى","وأراحهم من قبح شر لئيم",79,"م",1,0],["اُيلامُ مكلومُ الحشا في هوى رشا","لجبينه تاج الجمالُ مُكلّلُ",80,"ل",1,0],["أيليق سلواني وسهوة خاطري","وتغافلي عن ذكر جدي في الملا",81,"ل",2,0],["أي لفظ وأي معنىً عدمنا","ورفيق محرّر ودقيق",82,"ق",1,0],["أَيّ لَيل سهرته بك يا لَي","لُ وَكابدته جَوىً وَعناءَ",83,"ا",2,0],["أيلذ الكرى ورزؤك قد","فرق بين الجفون بماء البكاء",84,"ا",2,0],["أيلتذ طرفي بالكرى بعدما جرى","على السبط من أهل الشقاوة ما جرى",85,"ر",2,0],["أيلزمنا هول الذليل ونحن في","فناءٍ عزيز من حماك نلازمه",86,"م",2,0],["أَيَّ لَفظٍ يَبينُ لي وَصفُ غانِ","سادَ غاداتُ عَصرِهِ بِاِتَّفاقِ",87,"ق",1,0],["إيلوس عسا زاقسٌ وكذا","غانيمذٌ أبناؤه العظما",88,"م",2,0],["إيلوس كان للومذون أبا","وللومذون طثونٌ انتسبا",88,"ب",2,0],["أى لاَ يُكَلِّفُ النُّفُوسَ مَا نَهَى","عَنهُ وَلاَ يُحِبُّ غَيَّا شَانَهَا",89,"ه",2,0],["أي لونين اخضرار واحمرار","وشعا فيك وثغرٍ ألعس",90,"س",1,0],["أي لا أُبالي وسقيا جودكم أحبا","دهري مواهبَ أم لم يحبني وجما",91,"م",2,0],["ايلاجيتني من خلف عمر الوهم سارح","فلا تقتنع بالشوق حتى تجربني",92,"ن",2,0],["أيلُولُ ماذا عَنكَ؟ هَل تَكتَفِي","بالصَّمْتِ إنْ فَارَقْتَ أُكتُوبَرَا؟!",93,"ر",2,0],["أيلُولُ يا أيلُولُ مَن ذا الذي","يَسطُو على ذِكرَاكَ كَي يَنخَرا",93,"ر",2,0],["أَيلُولُ لَيسَ ابنَ سَبعٍ راعِفًا دَمَهُ","ولا ضَريرًا غريبًا نالَهُ الكِبَرُ",94,"ر",1,0],["أَيلُولُ أَرضٌ وشَعبٌ، حِينما التَقَيَا","تَعَانقَا، فَاستَقَالَ الشَّوقُ والسَّفَرُ",94,"ر",1,0],["أَيلُولُ ما زالَ بَيتًا لِلبيوتِ، وجُم","هُوريَّةً تَتَساوَى عِندَها الأُسَرُ",94,"ر",1,0],["أيليق بالمعل