{"poems":[[55,"أحظى الملوك من الأيام والدول","https://www.aldiwan.net/poem29908.html","البسيط"],[55,"يا دين قلبك من","https://www.aldiwan.net/poem30734.html","المجتث"],[47,"أبا الحسين دعاء من فتى علقت","https://www.aldiwan.net/poem63550.html","البسيط"],[92,"فداء لمثواك","https://www.aldiwan.net/poem59036.html","عموديه"],[54,"وغادر مني الدهر عضبا مهندا","https://www.aldiwan.net/poem26862.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85484","البسيط"],[111,"غوث الوجود اغثني ضاق مصطبري","https://www.poetsgate.com/ViewPoem.aspx?id=517",""],[169,"ألا أبلغ النعمان عني رسالة","https://www.aldiwan.net/poem722.html",""],[382,"تنبه دهري من عهود معاهدي","https://www.aldiwan.net/poem59454.html","الطويل"],[556,"زارك زوار الحلم","https://www.aldiwan.net/poem47191.html","مجزوء الرجز"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137702",""],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203796","الوافر"],[1085,"","https://poetry.dctabudhabi.ae/diwan/poem/124808","الوافر"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64815","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114718","السريع"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76803","الطويل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123277","المواليا"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130807",""],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109794","البسيط"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112566","البسيط"],[3366,"","https://poetry.dctabudhabi.ae/diwan/poem/28306","الطويل"],[3914,"","https://poetry.dctabudhabi.ae/diwan/poem/116877","البسيط"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138723","البسيط"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117315","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133059","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72726","البسيط"],[4572,"","https://poetry.dctabudhabi.ae/diwan/poem/22796","البسيط"],[4988,"كل جنس الخود إلاكي .,., حدر","https://www.poetsgate.com/ViewPoem.aspx?id=153966",""],[6305,"حروفي تسكُت في حضرتِك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87352&r=&rc=25",""]],"verses":[["وَأَنتَ طَوَّقتَهُ بِالمَنِّ جامِعَةً","قامَت عَلَيهِ مَقامَ الحَليِ وَالحُلَلِ",0,"ل",1,0],["وَأَن تُطارِدَ ما بَي","نَنا زَعازِعُ نُكبُ",1,"ب",1,0],["وَأَنتَ طَودُ الحِجى في الناسِ قَد عَلِموا","وَأَنتَ فَجرُ الدُجى في الأَزمُنِ السودِ",2,"د",1,0],["وأن تُطْعِمَ الموتَ خيرَ البنينَ","مِنَ \"الأَكْهَلِينَ\" إلى الرُّضَّعِ",3,"ع",1,0],["وَإِن تَطلُبَنّي في الحُروبِ تُلاقيني","أَهُزُّ حُساماً كُلَّما هُزَّ قَطَّعا",4,"ع",2,0],["وأن تَطوف عَلى الأغصان طائرة","بَلابل تملأ الأسماع ألحانا",5,"ن",2,0],["وأنت طب بصير قد بعثت بما","يشفي العضال فانقذني من الضرر",6,"ر",1,0],["وأنت طويل البغي أبلخ معور","فزوع إذا ما خيف إحدى العظائم",7,"م",1,0],["وأنت طريق الحق والحق ناطقٌ","بفيك فيدعو للهدى كلَّ شارد",8,"د",1,0],["وأنتَ طَلْقٌ باسمٌ","في لاتَ حينَ مُبتَسَمْ",9,"م",1,0],["وإن تطلب الصدقات وير","سل ما يتدفق من بعد تترى",10,"ر",2,0],["وإن تطمعْ لمصرعك العوادي","فتغري الغاصبين بنا ، وتوحي",11,"ح",2,0],["وإن تطلب ربائعهم تجدها","ببطن السعد ليس لهم ظهور",12,"ر",1,0],["وإن تطلب طهية في تميم","تجدها العمى ليس لها بصير",12,"ر",1,0],["وإِنْ تَطايرَ مِنْهمْ ريشُ حِلمهمُ","عِندَ العواصفِ فهْوَ الشَّامخُ الرَّاسي",13,"س",2,0],["وإن تطابقا مع الإفراد","فاخبر بثان أو بوصف باد",14,"د",1,0],["وأنت طُهرٌ وأمانٌ لَنا","من كُلّ مَخشِيٍّ ومَحذُورِ",15,"ر",1,0],["وان تطلبوا ابناً للنبي فلن تروا","سواي مقال منه غير مفند",16,"د",1,0],["وانت طلعت في العين","للإنسان",17,"ن",1,0],["وان تطلق برجعي فذا خطأ","وقل ثلاثا لنفي الشك والخطل",18,"ل",1,0],["وانت طوع يدي والوصل يجمعنا","في بردة للتقى فاقت على البرد",19,"د",1,0],["وإن تطلب غيرى عيشه رغدا","كانت له الناس والدنيا كما شاء",20,"ا",2,0],["وَأَنتَ طَريدٌ مُستَسِرٌّ بِقَفرَةٍ","مِراراً وَأَحياناً تُصَبُّ فَتَظهَرُ",21,"ر",1,0],["وان تطاول بي ليلى أنست بها","فيه كما أنس السارون بالقمرِ",22,"ر",1,0],["وإن تطولت بالإسعاف منك وفا","فسر بنا في ذمام الليل معتسفا",23,"ف",2,0],["وإن تطردوني فالردى بي أليق","أذاب الهوى قلبي وأسقمنى الجوى",24,"ج",3,0],["وإن تطلب صفا الدين دواماً","بلا بؤس فقد رمت المحالا",25,"ل",2,0],["وأنت طابت مساعيك الحسان بها","لازلت تستخدم الاقليم بالقلم",26,"م",1,0],["وَأَنتِ طَيِّبَةٌ في القَيظِ بارِدَةٌ","وَفي الشِتاءِ سَخونٌ لَيلَةَ الصَرَدِ",27,"د",1,0],["وان تطير طيور .. ما تاصل سماي","دام انتي لي سمايا والقدر",28,"ر",1,0],["وأنت طِبُّ جراحاتي وبلسمُها","وأنت مالِكُ نفسي إنْ طغى الغضب",29,"ب",1,0]]}