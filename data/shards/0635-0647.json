.aldiwan.net/poem1679.html",""],[182,"فسطاط عزاء","https://www.aldiwan.net/poem50704.html","أحذ الكامل"],[186,"أحبابنا هل لذاك العهد تذكار","https://www.aldiwan.net/poem67065.html","البسيط"],[199,"غدا ولم يقض من سلومة الوطرا","https://www.aldiwan.net/poem54407.html","البسيط"],[201,"صهرت في قدح الصهباء أحزاني","https://www.aldiwan.net/poem39945.html","البسيط"],[202,"يا شمس خدر مالها مغرب","https://www.aldiwan.net/poem51986.html","السريع"],[203,"هجروك بعد صبابة وغرام","https://www.aldiwan.net/poem45577.html","الكامل"],[215,"قد حضرنا إليك يا بحر نشكو","https://www.aldiwan.net/poem46231.html","الخفيف"],[216,"نفرت غزالا خشية أن تبصرا","https://www.aldiwan.net/poem37893.html","الطويل"],[247,"إني على رغم الوشاة لقائل","https://www.aldiwan.net/poem2053.html","الكامل"],[260,"اليوم يوم سروري","https://www.aldiwan.net/poem48345.html","المجتث"],[274,"طربت لصوت المجد حين دعاني","https://www.aldiwan.net/poem35595.html","الطويل"],[274,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[286,"اقدح زناد السرور بالقدح","https://www.aldiwan.net/poem32826.html","المنسرح"],[304,"قد بكرت عاذلتي بكرة","https://www.aldiwan.net/poem45491.html","السريع"],[332,"لهف نفسي والمنايا تلتظى","https://www.aldiwan.net/poem55052.html","الرمل"],[406,"لو كان يعلم أنها الأحداق","https://www.aldiwan.net/poem46984.html","الكامل"],[433,"هبت نسيمات السرور","https://www.aldiwan.net/poem40742.html","مجزوء الكامل"],[433,"طاف الحباب على حميا الكاس","https://www.aldiwan.net/poem41066.html","الكامل"],[443,"بشراك أيتها الدنيا وبشرانا","https://www.aldiwan.net/poem34881.html","البسيط"],[456,"مسكينة إن من خانوك أوقحهم","https://www.aldiwan.net/poem61279.html","البسيط"],[456,"الفتنة الكبرى تطل قرونها","https://www.aldiwan.net/poem61287.html","الكامل"],[461,"تظن ليالينا عودا","https://www.aldiwan.net/poem56231.html","المتقارب"],[464,"تود الجحاجيح من خندف","https://www.aldiwan.net/poem15115.html","المتقارب"],[485,"عرج بمنعرج الكثيب الأخضد","https://www.aldiwan.net/poem24364.html","عموديه"],[561,"ما الشدة إلا للفرج","https://www.aldiwan.net/poem34692.html","المتدارك"],[570,"حي الربيع تحية المستقبل","https://www.aldiwan.net/poem69531.html","الكامل"],[578,"من للريب هفت به الفكر","https://www.aldiwan.net/poem2726.html","أحذ الكامل"],[589,"يا زائرا جعل الدجنة مركبا","https://www.aldiwan.net/poem17424.html","الكامل"],[758,"","https://poetry.dctabudhabi.ae/diwan/poem/96399","المتقارب"],[819,"","https://poetry.dctabudhabi.ae/diwan/poem/18691","الكامل"]],"verses":[["صِهرُهُ الباذِلُ عَنهُ نَفسَهُ","وَحُسامُ اللَهِ في يَومِ الوَغى",0,"ا",1,0],["صَهباءُ تُعْشي النّاظِرينَ نَضَتْ بِها","عَذَبَ الفَدامِ عنِ اللّطيمَةِ بابِلُ",1,"ل",1,0],["صَهِيلُ الْجِيَادِ الصَّافِنَاتِ غِنَاؤُهُ","وَتَحْتَ الْبُنُودِ الْخَافِقَاتِ ظِلاَلُهُ",2,"ل",2,0],["صَهباءَ صافِيَةً إِذا ما اِستَودِفَت","شُجَّت غَوارِبُها بِماءِ غَوادي",3,"د",2,0],["صِهرُ النَبِيِّ وَخيرُ الناسِ مُفتَخَراً","فَكُلُّ مَن رامَهُ بِالفَخرِ مَفخورُ",4,"ر",1,0],["صَهرُ المُكَرَّمِ وَالمُكَرَّمُ وَاِبنُهُ","وَالحاكِمُ المصرِيُّ وَاِبنُ التِنَّبي",5,"ي",1,0],["صِهرُ الرَسولِ عَلى الزَهراءِ زَوَّجَهُ ال","لَهُ العَلِيُّ بِها فَوقَ السَمَواتِ",6,"ت",1,0],["صُهابِيَّةً غُلبَ الرِقابِ كَأَنَّما","تُناطُ بِأَلحِيها فَراعلَةٌ غُثرُ",7,"ر",1,0],["صُهابِيَّةٌ جَلسٌ كَأَنّي وَرحلَها","يَجوبُ بِنا المَوماةَ جَأبٌ مُكَدَّحُ",8,"ح",1,0],["صُهباً كَأَنَّ عَصيمَ الوَرسِ خالَطَها","مِمّا تُصَرِّفُ مِن خَطرٍ وَإِلبادِ",9,"د",1,0],["صه وانْصِتونا للتحاور واسمعوا","تشهَّدها من خطبة وارتجالها",10,"ه",2,1],["صَه لِجَوَاب مَا قُلتُم وَأَوكَت","أَكَفُّكُم عَلَى ما تَنفُخُونَا",11,"ن",2,0],["صَهباءُ قَد كَلِفَت مِن طولِ ما حُبِسَت","في مَخدَعٍ بَينَ جَنّاتٍ وَأَنهارِ",12,"ر",1,0],["صَهباءَ صافِيَةٍ تَنَزَّلَ تَجرُها","بِبَلاطِ صَرخَدَ مِن رُؤوسِ جِبالِ",13,"ل",1,0],["صَهباءُ صافِيَةٌ أَغلى التِجارُ بِها","مِن خَمرِ عانَةَ يَطفو فَوقَها الزَبَدُ",14,"د",1,0],["صُهبٌ مَهاريسُ أَشباهٌ مُذَكَّرَةٌ","فاتَ العَزيبَ بِها تَرعِيَّةٌ أَبِلُ",15,"ل",1,0],["صَهوَةَ العِزِّ اِعتَلَوا تَحسَبُهُم","جَمعَ أَملاكٍ عَلى الخَيلِ تَسامى",16,"م",2,0],["صَهباءَ قَد أَخلَفَت عامَينِ باذِلَها","تَلُطُّ عَن جاذِبِ الأَخلافِ مَعقومِ",17,"م",1,0],["صَهَلا بشِعري مُقرِفَينِ فكُذِّبا","إنَّ المَقارِفَ لا يَكُنَّ صَواهِلا",18,"ل",2,0],["صهلا بشعري مقرفين فكذبا","إن المقارف لا تكون صواهلا",19,"ل",2,0],["صَهباءُ قَد راضَ المَزاجُ مِزاجَها","فَغَدَت تُقَهقِهُ وَالفَواقِعُ تَرقُصُ",20,"ص",1,0],["صَهصَلِقٌ في الصَهيلِ تَحسِبُهُ","أُشرِجَ حُلقومُهُ عَلى جَرَسِ",21,"س",1,0],["صَهَروا الأَغلالَ وَاِنصاعوا إِلى","دنس الأَرضِ فَقالوا اِغتَسِلي",22,"ل",2,0],["صَهْصلِقُ الرَّعدِ إذا ما قفَا","ليْلُ المَطايا لامِعُ البَرْق",23,"ق",1,0],["صَهباءَ فَضَّلَها المُلوكُ عَلى","نُظَرائِها بِفَضيلَةِ القَدمِ",24,"م",1,0],["صَهباءُ صافِيَةٌ عَذراءُ ناصِعَةٌ","لِلسُقمِ دافِعَةٌ مِن كَرمِ دِهقانِ",25,"ن",1,0],["صَهباءُ تَبني حَباباً كُلَّما مُزِجَت","كَأَنَّهُ لُؤلُؤٌ يَتلوهُ عِقيانُ",26,"ن",1,0],["صَهباءُ صافِيَةٌ تُجديكَ نَكهَتُها","تَنَفُّسَ المِسكِ مَلطوخاً بِتُفّاحِ",27,"ح",1,0],["صَه لا تَكَلَّم جِهاراً في مَجالِسِنا","وَسَل عَجوزَكَ عَن بَكرِ بِنِ مَذعورِ",28,"ر",1,0],["صُهبَ الظِلالِ أَتَينَ التينَ عَن عُرُضٍ","يُزجينَ غَيماً قَليلاً ماؤُهُ شَبِما",29,"م",2,0],["صُهابيَّةُ العُثنونِ موجَدَةُ القَرا","بَعيدَةُ وَخدِ الرِجلِ مَوّارَةُ اليَدِ",30,"د",1,0],["صُهَابِيَّةٍ مُتْرَعٍ دَنُّهَا","تُرَجَّعُ مِنْ عُوِد وَعْسٍ مُرِنْ",31,"ن",1,0],["صهباءُ ما كانتْ","من غرس إبليسِ",32,"س",1,0],["صهٍ أيها الموتى ولو كان فيكمو","حياة لصِحتُم ملء هذه الحناجرِ",33,"ر",1,1],["صهر القرون وصاغها","تاجاً لمفرقك الحبيب",34,"ب",1,0],["صهٍ حاسِدي أَنا مِن طَيِّبينَ","إِذا مسك اِيّهما مَسَّكا",35,"ك",2,0],["صهرت نفسَه الخطوبُ؛ فزادَت","نفسهُ في تَنُّورها لمعانا",36,"ن",2,0],["صَهرَ الغلاء كبيرها، وصغيرها","فالكل غَرثانُ الجوانح، صاد",37,"د",1,0],["صَهَرَ الأنفُسَ حتى لم تعُدْ","تدركُ الأنفسُ شيئًا ما عداه",38,"ا",2,0],["صهابية العثنون موجدة الفرا","بعيدة وخد الرجل موارة اليد",39,"د",1,0],["صُهابِيّة ُ العُثْنُونِ مُوجَدَة ُ القَرَا","بعيدة ُ وخد الرِّجل موَّراة ُ اليد",40,"د",1,0],["صَهباءَ لَيسَ يَجوز عِندي مَزجَها","إِلّا بِريقة شادن مِعطار",41,"ر",1,0],["صَهباء تَلعَب بِالعُقول فَفعلها","فعل الهَوى بِأَلواله المُشتاقِ",42,"ق",1,0],["صهر النبي ولي البضعتين ومن","علت له في زوايا القدس اركان",43,"ن",1,0],["صهر النبي ابو السبطين بحر هدى","ما زال منهمرا بالعلم والعمل",44,"ل",1,0],["صَه يا لساناً مُظهِراً","ضُعفِي ولا جاوَرتَ حَلقا",45,"ق",2,0],["صهيلُ الجياد المقرَباتِ غِناؤه","فلو سمّها الغَريضَ ومَعبْدا",46,"د",2,0],["صهباء في القلب والأعضاء جارية","مجرى محبة معنى كل مرتزق",47,"ق",1,0],["صَهباءَ مِمّا عَتَّقَت بابِلٌ","مِزاجُها الأَريُ وَماءُ الغَمام",48,"م",1,0],["صهيونُ ألجَمَنا بِلا رَسَنٍ","كَيْ يستبيحَ قِبابَ أقْصانا",49,"ن",2,0],["صَهباءُ تَكسو النَدامَى مِن أَشعَّتِها","كَوجهِ مُوسى وَقَد ضاءَت لَهُ النارُ",50,"ر",1,0],["صُهبُ العَثانينِ مَكتوبٌ جَماجِمُها","خورُ الضُروعِ تَغُرُّ الأَوفَرَ الحَشَرا",51,"ر",2,0],["صَهَرتُ في قدحِ الصهباءِ أحزاني","وصُغتُ من ذَوبها شِعري وألحاني",52,"ن",2,1],["صَهيلُهُ عن عِتقِهِ مُفْصِحٌ","وخَلْقُهُ عن سَبْقِهِ مُعربُ",53,"ب",1,0],["صهباءُ إن مستْ فؤادي مرةً","غسلتْ بجنبي كلَّ جرحٍ دامي",54,"م",2,0],["صهرتنا الخطوب حتى شوتنا","ورمتنا بأعنف الآلام",55,"م",1,0],["صهيبة الرشفات شيب زلالها","بمزاج كافور يخافِرُ اذفرا",56,"ر",2,0],["صُهابيَّةُ العُثنونِ مَخطوفَةُ الحَشا","تَخيَّلُ للأَشباحِ غَرباً فتجفِلُ",57,"ل",1,0],["صهيله جوف إذني","ولا غناء غريب",58,"ب",1,0],["صهيلَ حصانِ طالما شَهدَ الوَغى","وباهى بجرحَي شفرةٍ وسِنان",59,"ن",1,0],["صهبُ العثانين مع زرقِ العيونِ بدت","شؤماً به حدثانُ الدهرِ يرمينا",60,"ن",2,0],["صَهباءُ قُل لِلَّذي تَجَنَّبَها","صَه باءَ بِالهَمِّ تارِكُ الفَرَحِ",61,"ح",1,0],["صَهصَلَقُ الصَوتِ إِذا ما غَدَت","لَم يَطمَعِ الصَقرُ بِها المُنكَدِر",62,"ر",1,0],["صهرتها وهي كالغيم ندى","في لظى الحسرة أبناء الصعيد",63,"د",1,0],["صِهرُ النبيّ وصنِوهُ يا حَبَّذا","صِنوان قَدْ وَشَجَتْهما الأَعْراق",64,"ق",1,0],["صهباءَ حلل مزجها","بنت الشموس إلى البدور",65,"ر",1,0],["صهباء تهدي للنفوس نفائسا","تجلي ببهجتها دجى الأغلاس",66,"س",1,0],["صِهراً يكادُ وَقَدْ لاحَتْ معالِمُهُ","يَشدُو بِهِ الدَّهْرُ إِفصاحاً وتِبيانا",67,"ن",2,0],["صه يا دخيل علينا ليس تعرفه","إلا مجالي التدني لا مجاليك",68,"ك",1,0],["صهيون ليس بمحض خصم واحد","فبكل باطن دولة صهيونها",69,"ن",3,0],["صُهابيَّةُ اللون قاريَّةٌ","تخالف صبغتُها المولدا",70,"د",2,0],["صَهيلُ السَّوابقِ نَدْمانُها","وبيضُ القَواضِب أخْدانُها",71,"ن",3,0],["صهباء ليس كؤوسها إلا التني","يات العذاب على رضاب الجلد",72,"د",1,0],["صهر المختار وعمدته","في الشدة والهم اللزج",73,"ج",1,0],["صَهْبَاءُ تُجْلَى فِي الزُّجَاجِ وَيُتَّقَى","مِنْهَا أَلِيْمُ القَتْلِ إِنْ لَمْ تَقْتُلِ",74,"ل",1,0],["صه يا زمانُ فإِنَّني رَجُلٌ","لَيْسَتْ تُغَيِّرُ صَبْرَهُ الغِيرَ",75,"ر",1,0],["صَهْباء كَمْ نَهَبتْ نُهىً وَصِيانةً","مِنّا وَأَعْطَتْ صَبْوةً وتَطرُّبا",76,"ب",2,0],["صُهابِيّةً كعَلاةِ القُيو","نِ مِنْ ضَرْبِ جَوْهرهاُ يخْلصونا",77,"ن",2,0],["صَهباءَ صافِيَةَ القَذى أَغلى بِها","يَسِرٌ كَريمُ الخيمِ غَيرَ مُبَخَّلِ",78,"ل",1,0]]}