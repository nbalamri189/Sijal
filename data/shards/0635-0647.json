{"poems":[[53,"كربلا لا زلت كربا وبلا","https://www.aldiwan.net/poem30772.html","الرمل"],[63,"لك ما يروقه الغمام الهاطل","https://www.aldiwan.net/poem46192.html","الكامل"],[77,"سلو عن فؤادي بعدكم كيف حاله","https://www.aldiwan.net/poem36368.html","الطويل"],[9,"أجبير هل لأسيركم من فادي","https://www.aldiwan.net/poem21925.html","الكامل"],[24,"هل حبل رملة قبل البين مبتور","https://www.aldiwan.net/poem21897.html","البسيط"],[71,"في دولة الملك المعظم خمسة","https://www.aldiwan.net/poem3745.html","الكامل"],[54,"آل الرسول مصابيح الهداية","https://www.aldiwan.net/poem27438.html","البسيط"],[30,"ألا يا اسلمي يا دار مي على البلي","https://www.aldiwan.net/poem29589.html","الطويل"],[30,"أمنزلتي مي سلام عليكما علي","https://www.aldiwan.net/poem29608.html","الطويل"],[27,"قد قرب الحي إذ هاجوا لإصعاد","https://www.aldiwan.net/poem5728.html","البسيط"],[37,"صه وانصتونا للتحاور واسمعوا","https://www.aldiwan.net/poem7479.html","الطويل"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[29,"تغير الرسم من سلمى بأحفار","https://www.aldiwan.net/poem6035.html","البسيط"],[29,"طرق الكرى بالغانيات وربما","https://www.aldiwan.net/poem6174.html","الكامل"],[38,"بان الأحبة بالعهد الذي عهدوا","https://www.aldiwan.net/poem7699.html","البسيط"],[38,"قالت سليمى أتنوي اليوم أم تغل","https://www.aldiwan.net/poem7736.html","البسيط"],[85,"قم سليمان بساط الريح قاما","https://www.aldiwan.net/poem63696.html","الرمل"],[28,"يا ظمي ويحك إني ذو محافظة","https://www.aldiwan.net/poem5495.html","البسيط"],[61,"وهي الشموس فإن رأين طوالعا","https://www.aldiwan.net/poem51459.html","الكامل"],[61,"تأبى المنازل أن تجيب مسائلا","https://www.aldiwan.net/poem51474.html","البسيط"],[66,"صرف المدام به السرور مخصص","https://www.aldiwan.net/poem38488.html","الكامل"],[44,"قالت وعي النساء كالخرس","https://www.aldiwan.net/poem30489.html","المنسرح"],[102,"شيعي الليل وقومي استقبلي","https://www.aldiwan.net/poem32992.html","الرمل"],[75,"أحين ولت أنجم الأفق","https://www.aldiwan.net/poem69057.html","السريع"],[48,"صفة الطلول بلاغة القدم","https://www.aldiwan.net/poem65092.html","الكامل"],[48,"عج للوقوف على راح وريحان","https://www.aldiwan.net/poem65297.html","البسيط"],[48,"يا ساحر الطرف أنت الدهر وسنان","https://www.aldiwan.net/poem65298.html","البسيط"],[48,"لا تحفلن بقول الزاجر اللاحي","https://www.aldiwan.net/poem62506.html","البسيط"],[50,"يا فرخ نهيا بإفك قلت أو زور","https://www.aldiwan.net/poem63807.html","البسيط"],[7,"بانت سعاد وأمسى حبلها انجذما","https://www.aldiwan.net/poem1973.html","البسيط"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39611","المنسرح"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142034","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141981","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43734","المتقارب"],[106,"كرموه","https://www.poetsgate.com/ViewPoem.aspx?id=179708",""],[106,"من للموظف","https://www.poetsgate.com/ViewPoem.aspx?id=179515",""],[106,"الركب المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=179288",""],[1,"لِخَوْلَةَ أَطْلالٌ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=10033",""],[1,"لِخَولة َ أطْلالٌ بِبُرقَة ِ ثَهمَدِ، ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13176&r=&rc=0",""],[107,"وافى الربيع فما عليك بعار","https://www.aldiwan.net/poem16374.html","الكامل"],[107,"زمن الربيع كنشأة العشاق","https://www.aldiwan.net/poem16376.html","الكامل"],[113,"كر الجديدين تبدو منه الوان","https://www.aldiwan.net/poem40479.html","عموديه"],[113,"كنز المقل سلاح الخائف الوجل","https://www.aldiwan.net/poem40858.html","عموديه"],[127,"الطبول الطبول إِنا انتصرنا","https://www.aldiwan.net/poem67451.html","الخفيف"],[140,"ترى رائح يأتى بأخبار من غدا","https://www.aldiwan.net/poem58445.html","الطويل"],[158,"بشراك بشراك هبت نسمة الفلق","https://www.aldiwan.net/poem59101.html","البسيط"],[167,"قم فاسقنيها قبل صوت الحمام","https://www.aldiwan.net/poem1679.html",""],[176,"فسطاط عزاء","https://www.aldiwan.net/poem50704.html","أحذ الكامل"],[180,"أحبابنا هل لذاك العهد تذكار","https://www.aldiwan.net/poem67065.html","البسيط"],[193,"غدا ولم يقض من سلومة الوطرا","https://www.aldiwan.net/poem54407.html","البسيط"],[195,"صهرت في قدح الصهباء أحزاني","https://www.aldiwan.net/poem39945.html","البسيط"],[196,"يا شمس خدر مالها مغرب","https://www.aldiwan.net/poem51986.html","السريع"],[197,"هجروك بعد صبابة وغرام","https://www.aldiwan.net/poem45577.html","الكامل"],[209,"قد حضرنا إليك يا بحر نشكو","https://www.aldiwan.net/poem46231.html","الخفيف"],[210,"نفرت غزالا خشية أن تبصرا","https://www.aldiwan.net/poem37893.html","الطويل"],[241,"إني على رغم الوشاة لقائل","https://www.aldiwan.net/poem2053.html","الكامل"],[254,"اليوم يوم سروري","https://www.aldiwan.net/poem48345.html","المجتث"],[268,"طربت لصوت المجد حين دعاني","https://www.aldiwan.net/poem35595.html","الطويل"],[268,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[280,"اقدح زناد السرور بالقدح","https://www.aldiwan.net/poem32826.html","المنسرح"],[298,"قد بكرت عاذلتي بكرة","https://www.aldiwan.net/poem45491.html","السريع"],[326,"لهف نفسي والمنايا تلتظى","https://www.aldiwan.net/poem55052.html","الرمل"],[399,"لو كان يعلم أنها الأحداق","https://www.aldiwan.net/poem46984.html","الكامل"],[426,"هبت نسيمات السرور","https://www.aldiwan.net/poem40742.html","مجزوء الكامل"],[426,"طاف الحباب على حميا الكاس","https://www.aldiwan.net/poem41066.html","الكامل"],[436,"بشراك أيتها الدنيا وبشرانا","https://www.aldiwan.net/poem34881.html","البسيط"],[451,"مسكينة إن من خانوك أوقحهم","https://www.aldiwan.net/poem61279.html","البسيط"],[451,"الفتنة الكبرى تطل قرونها","https://www.aldiwan.net/poem61287.html","الكامل"],[456,"تظن ليالينا عودا","https://www.aldiwan.net/poem56231.html","المتقارب"],[459,"تود الجحاجيح من خندف","https://www.aldiwan.net/poem15115.html","المتقارب"],[480,"عرج بمنعرج الكثيب الأخضد","https://www.aldiwan.net/poem24364.html","عموديه"],[556,"ما الشدة إلا للفرج","https://www.aldiwan.net/poem34692.html","المتدارك"],[565,"حي الربيع تحية المستقبل","https://www.aldiwan.net/poem69531.html","الكامل"],[573,"من للريب هفت به الفكر","https://www.aldiwan.net/poem2726.html","أحذ الكامل"],[584,"يا زائرا جعل الدجنة مركبا","https://www.aldiwan.net/poem17424.html","الكامل"]],"verses":[["صِهرُهُ الباذِلُ عَنهُ نَفسَهُ","وَحُسامُ اللَهِ في يَومِ الوَغى",0,"ا",1,0],["صَهباءُ تُعْشي النّاظِرينَ نَضَتْ بِها","عَذَبَ الفَدامِ عنِ اللّطيمَةِ بابِلُ",1,"ل",1,0],["صَهِيلُ الْجِيَادِ الصَّافِنَاتِ غِنَاؤُهُ","وَتَحْتَ الْبُنُودِ الْخَافِقَاتِ ظِلاَلُهُ",2,"ل",2,0],["صَهباءَ صافِيَةً إِذا ما اِستَودِفَت","شُجَّت غَوارِبُها بِماءِ غَوادي",3,"د",2,0],["صِهرُ النَبِيِّ وَخيرُ الناسِ مُفتَخَراً","فَكُلُّ مَن رامَهُ بِالفَخرِ مَفخورُ",4,"ر",1,0],["صَهرُ المُكَرَّمِ وَالمُكَرَّمُ وَاِبنُهُ","وَالحاكِمُ المصرِيُّ وَاِبنُ التِنَّبي",5,"ي",1,0],["صِهرُ الرَسولِ عَلى الزَهراءِ زَوَّجَهُ ال","لَهُ العَلِيُّ بِها فَوقَ السَمَواتِ",6,"ت",1,0],["صُهابِيَّةً غُلبَ الرِقابِ كَأَنَّما","تُناطُ بِأَلحِيها فَراعلَةٌ غُثرُ",7,"ر",1,0],["صُهابِيَّةٌ جَلسٌ كَأَنّي وَرحلَها","يَجوبُ بِنا المَوماةَ جَأبٌ مُكَدَّحُ",8,"ح",1,0],["صُهباً كَأَنَّ عَصيمَ الوَرسِ خالَطَها","مِمّا تُصَرِّفُ مِن خَطرٍ وَإِلبادِ",9,"د",1,0],["صه وانْصِتونا للتحاور واسمعوا","تشهَّدها من خطبة وارتجالها",10,"ه",2,1],["صَه لِجَوَاب مَا قُلتُم وَأَوكَت","أَكَفُّكُم عَلَى ما تَنفُخُونَا",11,"ن",2,0],["صَهباءُ قَد كَلِفَت مِن طولِ ما حُبِسَت","في مَخدَعٍ بَينَ جَنّاتٍ وَأَنهارِ",12,"ر",1,0],["صَهباءَ صافِيَةٍ تَنَزَّلَ تَجرُها","بِبَلاطِ صَرخَدَ مِن رُؤوسِ جِبالِ",13,"ل",1,0],["صَهباءُ صافِيَةٌ أَغلى التِجارُ بِها","مِن خَمرِ عانَةَ يَطفو فَوقَها الزَبَدُ",14,"د",1,0],["صُهبٌ مَهاريسُ أَشباهٌ مُذَكَّرَةٌ","فاتَ العَزيبَ بِها تَرعِيَّةٌ أَبِلُ",15,"ل",1,0],["صَهوَةَ العِزِّ اِعتَلَوا تَحسَبُهُم","جَمعَ أَملاكٍ عَلى الخَيلِ تَسامى",16,"م",2,0],["صَهباءَ قَد أَخلَفَت عامَينِ باذِلَها","تَلُطُّ عَن جاذِبِ الأَخلافِ مَعقومِ",17,"م",1,0],["صَهَلا بشِعري مُقرِفَينِ فكُذِّبا","إنَّ المَقارِفَ لا يَكُنَّ صَواهِلا",18,"ل",2,0],["صهلا بشعري مقرفين فكذبا","إن المقارف لا تكون صواهلا",19,"ل",2,0],["صَهباءُ قَد راضَ المَزاجُ مِزاجَها","فَغَدَت تُقَهقِهُ وَالفَواقِعُ تَرقُصُ",20,"ص",1,0],["صَهصَلِقٌ في الصَهيلِ تَحسِبُهُ","أُشرِجَ حُلقومُهُ عَلى جَرَسِ",21,"س",1,0],["صَهَروا الأَغلالَ وَاِنصاعوا إِلى","دنس الأَرضِ فَقالوا اِغتَسِلي",22,"ل",2,0],["صَهْصلِقُ الرَّعدِ إذا ما قفَا","ليْلُ المَطايا لامِعُ البَرْق",23,"ق",1,0],["صَهباءَ فَضَّلَها المُلوكُ عَلى","نُظَرائِها بِفَضيلَةِ القَدمِ",24,"م",1,0],["صَهباءُ صافِيَةٌ عَذراءُ ناصِعَةٌ","لِلسُقمِ دافِعَةٌ مِن كَرمِ دِهقانِ",25,"ن",1,0],["صَهباءُ تَبني حَباباً كُلَّما مُزِجَت","كَأَنَّهُ لُؤلُؤٌ يَتلوهُ عِقيانُ",26,"ن",1,0],["صَهباءُ صافِيَةٌ تُجديكَ نَكهَتُها","تَنَفُّسَ المِسكِ مَلطوخاً بِتُفّاحِ",27,"ح",1,0],["صَه لا تَكَلَّم جِهاراً في مَجالِسِنا","وَسَل عَجوزَكَ عَن بَكرِ بِنِ مَذعورِ",28,"ر",1,0],["صُهبَ الظِلالِ أَتَينَ التينَ عَن عُرُضٍ","يُزجينَ غَيماً قَليلاً ماؤُهُ شَبِما",29,"م",2,0],["صُهابيَّةُ العُثنونِ موجَدَةُ القَرا","بَعيدَةُ وَخدِ الرِجلِ مَوّارَةُ اليَدِ",30,"د",1,0],["صهباءُ ما كانتْ","من غرس إبليسِ",31,"س",1,0],["صهٍ أيها الموتى ولو كان فيكمو","حياة لصِحتُم ملء هذه الحناجرِ",32,"ر",1,1],["صهر القرون وصاغها","تاجاً لمفرقك الحبيب",33,"ب",1,0],["صهٍ حاسِدي أَنا مِن طَيِّبينَ","إِذا مسك اِيّهما مَسَّكا",34,"ك",2,0],["صهرت نفسَه الخطوبُ؛ فزادَت","نفسهُ في تَنُّورها لمعانا",35,"ن",2,0],["صَهرَ الغلاء كبيرها، وصغيرها","فالكل غَرثانُ الجوانح، صاد",36,"د",1,0],["صَهَرَ الأنفُسَ حتى لم تعُدْ","تدركُ الأنفسُ شيئًا ما عداه",37,"ا",2,0],["صهابية العثنون موجدة الفرا","بعيدة وخد الرجل موارة اليد",38,"د",1,0],["صُهابِيّة ُ العُثْنُونِ مُوجَدَة ُ القَرَا","بعيدة ُ وخد الرِّجل موَّراة ُ اليد",39,"د",1,0],["صَهباءَ لَيسَ يَجوز عِندي مَزجَها","إِلّا بِريقة شادن مِعطار",40,"ر",1,0],["صَهباء تَلعَب بِالعُقول فَفعلها","فعل الهَوى بِأَلواله المُشتاقِ",41,"ق",1,0],["صهر النبي ولي البضعتين ومن","علت له في زوايا القدس اركان",42,"ن",1,0],["صهر النبي ابو السبطين بحر هدى","ما زال منهمرا بالعلم والعمل",43,"ل",1,0],["صَه يا لساناً مُظهِراً","ضُعفِي ولا جاوَرتَ حَلقا",44,"ق",2,0],["صهيلُ الجياد المقرَباتِ غِناؤه","فلو سمّها الغَريضَ ومَعبْدا",45,"د",2,0],["صهباء في القلب والأعضاء جارية","مجرى محبة معنى كل مرتزق",46,"ق",1,0],["صَهباءَ مِمّا عَتَّقَت بابِلٌ","مِزاجُها الأَريُ وَماءُ الغَمام",47,"م",1,0],["صهيونُ ألجَمَنا بِلا رَسَنٍ","كَيْ يستبيحَ قِبابَ أقْصانا",48,"ن",2,0],["صَهباءُ تَكسو النَدامَى مِن أَشعَّتِها","كَوجهِ مُوسى وَقَد ضاءَت لَهُ النارُ",49,"ر",1,0],["صُهبُ العَثانينِ مَكتوبٌ جَماجِمُها","خورُ الضُروعِ تَغُرُّ الأَوفَرَ الحَشَرا",50,"ر",2,0],["صَهَرتُ في قدحِ الصهباءِ أحزاني","وصُغتُ من ذَوبها شِعري وألحاني",51,"ي",1,1],["صَهيلُهُ عن عِتقِهِ مُفْصِحٌ","وخَلْقُهُ عن سَبْقِهِ مُعربُ",52,"ب",1,0],["صهباءُ إن مستْ فؤادي مرةً","غسلتْ بجنبي كلَّ جرحٍ دامي",53,"م",2,0],["صهرتنا الخطوب حتى شوتنا","ورمتنا بأعنف الآلام",54,"م",1,0],["صهيبة الرشفات شيب زلالها","بمزاج كافور يخافِرُ اذفرا",55,"ر",2,0],["صُهابيَّةُ العُثنونِ مَخطوفَةُ الحَشا","تَخيَّلُ للأَشباحِ غَرباً فتجفِلُ",56,"ل",1,0],["صهيله جوف إذني","ولا غناء غريب",57,"ب",1,0],["صهيلَ حصانِ طالما شَهدَ الوَغى","وباهى بجرحَي شفرةٍ وسِنان",58,"ن",1,0],["صهبُ العثانين مع زرقِ العيونِ بدت","شؤماً به حدثانُ الدهرِ يرمينا",59,"ن",2,0],["صَهباءُ قُل لِلَّذي تَجَنَّبَها","صَه باءَ بِالهَمِّ تارِكُ الفَرَحِ",60,"ح",1,0],["صَهصَلَقُ الصَوتِ إِذا ما غَدَت","لَم يَطمَعِ الصَقرُ بِها المُنكَدِر",61,"ر",1,0],["صهرتها وهي كالغيم ندى","في لظى الحسرة أبناء الصعيد",62,"د",1,0],["صِهرُ النبيّ وصنِوهُ يا حَبَّذا","صِنوان قَدْ وَشَجَتْهما الأَعْراق",63,"ق",1,0],["صهباءَ حلل مزجها","بنت الشموس إلى البدور",64,"ر",1,0],["صهباء تهدي للنفوس نفائسا","تجلي ببهجتها دجى الأغلاس",65,"س",1,0],["صِهراً يكادُ وَقَدْ لاحَتْ معالِمُهُ","يَشدُو بِهِ الدَّهْرُ إِفصاحاً وتِبيانا",66,"ن",2,0],["صه يا دخيل علينا ليس تعرفه","إلا مجالي التدني لا مجاليك",67,"ك",1,0],["صهيون ليس بمحض خصم واحد","فبكل باطن دولة صهيونها",68,"ن",3,0],["صُهابيَّةُ اللون قاريَّةٌ","تخالف صبغتُها المولدا",69,"د",2,0],["صَهيلُ السَّوابقِ نَدْمانُها","وبيضُ القَواضِب أخْدانُها",70,"ن",3,0],["صهباء ليس كؤوسها إلا التني","يات العذاب على رضاب الجلد",71,"د",1,0],["صهر المختار وعمدته","في الشدة والهم اللزج",72,"ج",1,0],["صَهْبَاءُ تُجْلَى فِي الزُّجَاجِ وَيُتَّقَى","مِنْهَا أَلِيْمُ القَتْلِ إِنْ لَمْ تَقْتُلِ",73,"ل",1,0],["صه يا زمانُ فإِنَّني رَجُلٌ","لَيْسَتْ تُغَيِّرُ صَبْرَهُ الغِيرَ",74,"ر",1,0],["صَهْباء كَمْ نَهَبتْ نُهىً وَصِيانةً","مِنّا وَأَعْطَتْ صَبْوةً وتَطرُّبا",75,"ب",2,0]]}