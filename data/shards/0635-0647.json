Poem.aspx?id=179482",""],[5691,"عراقة شعب","https://www.poetsgate.com/ViewPoem.aspx?id=206063",""],[5704,"لبيك يا أقصى","https://www.poetsgate.com/ViewPoem.aspx?id=191599",""],[5725,"خمرية طيبة","https://www.poetsgate.com/ViewPoem.aspx?id=177436",""],[5725,"شمس بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=177437",""],[5786,"ما الغيث لمّا جرى بالسَّيل واديه","https://www.poetsgate.com/ViewPoem.aspx?id=50656",""],[5823,"كم تقت للأقصى","https://www.poetsgate.com/ViewPoem.aspx?id=61555",""],[5848,"قبر النبي لا يدنس","https://www.poetsgate.com/ViewPoem.aspx?id=48813",""],[5861,"سر الداء","https://www.poetsgate.com/ViewPoem.aspx?id=188030",""],[5952,"ليلُكَ مُنْجَلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=197047",""],[5956,"اشتاقتِ الأرواحُ للأرواحِ","https://www.poetsgate.com/ViewPoem.aspx?id=182127",""],[5956,"مجرمو حرب وينجون من العقاب؟","https://www.poetsgate.com/ViewPoem.aspx?id=192219",""],[5956,"ينبغي محْوُ الخماسيِّ","https://www.poetsgate.com/ViewPoem.aspx?id=192327",""],[5956,"يا صهيون","https://www.poetsgate.com/ViewPoem.aspx?id=192337",""],[5956,"ديمقراطية الدمويِّين","https://www.poetsgate.com/ViewPoem.aspx?id=192364",""],[5956,"المصائب الراتعة من ممارسات الأطباء الغبية المائعة","https://www.poetsgate.com/ViewPoem.aspx?id=193100",""],[5956,"حدثٌ أليم","https://www.poetsgate.com/ViewPoem.aspx?id=193104",""],[5956,"غزة وإسرائيل","https://www.poetsgate.com/ViewPoem.aspx?id=202518",""],[5956,"إسرائيل فجَّرت ميناء بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=215378",""],[5956,"يومَ الخميس حبيبتي قد سافرتْ","https://www.poetsgate.com/ViewPoem.aspx?id=215905",""],[6038,"يا رب الارباب","https://www.poetsgate.com/ViewPoem.aspx?id=25684",""],[161,"قَلْنَا لِغَزَّةَ : ...","https://www.poetsgate.com/ViewPoem.aspx?id=175084",""],[6070,"بيريزُ مَاتَ وطارتِ الغربانُ","https://www.poetsgate.com/ViewPoem.aspx?id=188857",""],[6093,"دَعْني لشأنيَ إنِّي قَدْ غَضِبْتُ لِمَنْ","https://www.poetsgate.com/ViewPoem.aspx?id=176179",""],[6159,"كوز الحنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85858&r=&rc=4",""],[6198,"غمز الشموس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79228&r=&rc=1",""],[6213,"مغارات السلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76300&r=&rc=48",""],[6213,"لك الله يا غزة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80804&r=&rc=81",""],[6278,"جميلتي عمّان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86849&r=&rc=2",""],[6346,"بركان المشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83389&r=&rc=5",""]],"verses":[["صِهرُهُ الباذِلُ عَنهُ نَفسَهُ","وَحُسامُ اللَهِ في يَومِ الوَغى",0,"ا",1,0],["صَهباءُ تُعْشي النّاظِرينَ نَضَتْ بِها","عَذَبَ الفَدامِ عنِ اللّطيمَةِ بابِلُ",1,"ل",1,0],["صَهِيلُ الْجِيَادِ الصَّافِنَاتِ غِنَاؤُهُ","وَتَحْتَ الْبُنُودِ الْخَافِقَاتِ ظِلاَلُهُ",2,"ل",2,0],["صَهباءَ صافِيَةً إِذا ما اِستَودِفَت","شُجَّت غَوارِبُها بِماءِ غَوادي",3,"د",2,0],["صِهرُ النَبِيِّ وَخيرُ الناسِ مُفتَخَراً","فَكُلُّ مَن رامَهُ بِالفَخرِ مَفخورُ",4,"ر",1,0],["صَهرُ المُكَرَّمِ وَالمُكَرَّمُ وَاِبنُهُ","وَالحاكِمُ المصرِيُّ وَاِبنُ التِنَّبي",5,"ي",1,0],["صِهرُ الرَسولِ عَلى الزَهراءِ زَوَّجَهُ ال","لَهُ العَلِيُّ بِها فَوقَ السَمَواتِ",6,"ت",1,0],["صُهابِيَّةً غُلبَ الرِقابِ كَأَنَّما","تُناطُ بِأَلحِيها فَراعلَةٌ غُثرُ",7,"ر",1,0],["صُهابِيَّةٌ جَلسٌ كَأَنّي وَرحلَها","يَجوبُ بِنا المَوماةَ جَأبٌ مُكَدَّحُ",8,"ح",1,0],["صُهباً كَأَنَّ عَصيمَ الوَرسِ خالَطَها","مِمّا تُصَرِّفُ مِن خَطرٍ وَإِلبادِ",9,"د",1,0],["صه وانْصِتونا للتحاور واسمعوا","تشهَّدها من خطبة وارتجالها",10,"ه",2,1],["صَه لِجَوَاب مَا قُلتُم وَأَوكَت","أَكَفُّكُم عَلَى ما تَنفُخُونَا",11,"ن",2,0],["صَهباءُ قَد كَلِفَت مِن طولِ ما حُبِسَت","في مَخدَعٍ بَينَ جَنّاتٍ وَأَنهارِ",12,"ر",1,0],["صَهباءَ صافِيَةٍ تَنَزَّلَ تَجرُها","بِبَلاطِ صَرخَدَ مِن رُؤوسِ جِبالِ",13,"ل",1,0],["صَهباءُ صافِيَةٌ أَغلى التِجارُ بِها","مِن خَمرِ عانَةَ يَطفو فَوقَها الزَبَدُ",14,"د",1,0],["صُهبٌ مَهاريسُ أَشباهٌ مُذَكَّرَةٌ","فاتَ العَزيبَ بِها تَرعِيَّةٌ أَبِلُ",15,"ل",1,0],["صَهوَةَ العِزِّ اِعتَلَوا تَحسَبُهُم","جَمعَ أَملاكٍ عَلى الخَيلِ تَسامى",16,"م",2,0],["صَهباءَ قَد أَخلَفَت عامَينِ باذِلَها","تَلُطُّ عَن جاذِبِ الأَخلافِ مَعقومِ",17,"م",1,0],["صَهَلا بشِعري مُقرِفَينِ فكُذِّبا","إنَّ المَقارِفَ لا يَكُنَّ صَواهِلا",18,"ل",2,0],["صهلا بشعري مقرفين فكذبا","إن المقارف لا تكون صواهلا",19,"ل",2,0],["صَهباءُ قَد راضَ المَزاجُ مِزاجَها","فَغَدَت تُقَهقِهُ وَالفَواقِعُ تَرقُصُ",20,"ص",1,0],["صَهصَلِقٌ في الصَهيلِ تَحسِبُهُ","أُشرِجَ حُلقومُهُ عَلى جَرَسِ",21,"س",1,0],["صَهَروا الأَغلالَ وَاِنصاعوا إِلى","دنس الأَرضِ فَقالوا اِغتَسِلي",22,"ل",2,0],["صَهْصلِقُ الرَّعدِ إذا ما قفَا","ليْلُ المَطايا لامِعُ البَرْق",23,"ق",1,0],["صَهباءَ فَضَّلَها المُلوكُ عَلى","نُظَرائِها بِفَضيلَةِ القَدمِ",24,"م",1,0],["صَهباءُ صافِيَةٌ عَذراءُ ناصِعَةٌ","لِلسُقمِ دافِعَةٌ مِن كَرمِ دِهقانِ",25,"ن",1,0],["صَهباءُ تَبني حَباباً كُلَّما مُزِجَت","كَأَنَّهُ لُؤلُؤٌ يَتلوهُ عِقيانُ",26,"ن",1,0],["صَهباءُ صافِيَةٌ تُجديكَ نَكهَتُها","تَنَفُّسَ المِسكِ مَلطوخاً بِتُفّاحِ",27,"ح",1,0],["صَه لا تَكَلَّم جِهاراً في مَجالِسِنا","وَسَل عَجوزَكَ عَن بَكرِ بِنِ مَذعورِ",28,"ر",1,0],["صُهبَ الظِلالِ أَتَينَ التينَ عَن عُرُضٍ","يُزجينَ غَيماً قَليلاً ماؤُهُ شَبِما",29,"م",2,0],["صُهابيَّةُ العُثنونِ موجَدَةُ القَرا","بَعيدَةُ وَخدِ الرِجلِ مَوّارَةُ اليَدِ",30,"د",1,0],["صُهَابِيَّةٍ مُتْرَعٍ دَنُّهَا","تُرَجَّعُ مِنْ عُوِد وَعْسٍ مُرِنْ",31,"ن",1,0],["صهباءُ ما كانتْ","من غرس إبليسِ",32,"س",1,0],["صهٍ أيها الموتى ولو كان فيكمو","حياة لصِحتُم ملء هذه الحناجرِ",33,"ر",1,1],["صهر القرون وصاغها","تاجاً لمفرقك الحبيب",34,"ب",1,0],["صهٍ حاسِدي أَنا مِن طَيِّبينَ","إِذا مسك اِيّهما مَسَّكا",35,"ك",2,0],["صهرت نفسَه الخطوبُ؛ فزادَت","نفسهُ في تَنُّورها لمعانا",36,"ن",2,0],["صَهرَ الغلاء كبيرها، وصغيرها","فالكل غَرثانُ الجوانح، صاد",37,"د",1,0],["صَهَرَ الأنفُسَ حتى لم تعُدْ","تدركُ الأنفسُ شيئًا ما عداه",38,"ا",2,0],["صهابية العثنون موجدة الفرا","بعيدة وخد الرجل موارة اليد",39,"د",1,0],["صُهابِيّة ُ العُثْنُونِ مُوجَدَة ُ القَرَا","بعيدة ُ وخد الرِّجل موَّراة ُ اليد",40,"د",1,0],["صَهباءَ لَيسَ يَجوز عِندي مَزجَها","إِلّا بِريقة شادن مِعطار",41,"ر",1,0],["صَهباء تَلعَب بِالعُقول فَفعلها","فعل الهَوى بِأَلواله المُشتاقِ",42,"ق",1,0],["صهر النبي ولي البضعتين ومن","علت له في زوايا القدس اركان",43,"ن",1,0],["صهر النبي ابو السبطين بحر هدى","ما زال منهمرا بالعلم والعمل",44,"ل",1,0],["صَه يا لساناً مُظهِراً","ضُعفِي ولا جاوَرتَ حَلقا",45,"ق",2,0],["صهيلُ الجياد المقرَباتِ غِناؤه","فلو سمّها الغَريضَ ومَعبْدا",46,"د",2,0],["صهباء في القلب والأعضاء جارية","مجرى محبة معنى كل مرتزق",47,"ق",1,0],["صَهباءَ مِمّا عَتَّقَت بابِلٌ","مِزاجُها الأَريُ وَماءُ الغَمام",48,"م",1,0],["صهيونُ ألجَمَنا بِلا رَسَنٍ","كَيْ يستبيحَ قِبابَ أقْصانا",49,"ن",2,0],["صَهباءُ تَكسو النَدامَى مِن أَشعَّتِها","كَوجهِ مُوسى وَقَد ضاءَت لَهُ النارُ",50,"ر",1,0],["صُهبُ العَثانينِ مَكتوبٌ جَماجِمُها","خورُ الضُروعِ تَغُرُّ الأَوفَرَ الحَشَرا",51,"ر",2,0],["صَهَرتُ في قدحِ الصهباءِ أحزاني","وصُغتُ من ذَوبها شِعري وألحاني",52,"ن",2,1],["صَهيلُهُ عن عِتقِهِ مُفْصِحٌ","وخَلْقُهُ عن سَبْقِهِ مُعربُ",53,"ب",1,0],["صهباءُ إن مستْ فؤادي مرةً","غسلتْ بجنبي كلَّ جرحٍ دامي",54,"م",2,0],["صهرتنا الخطوب حتى شوتنا","ورمتنا بأعنف الآلام",55,"م",1,0],["صهيبة الرشفات شيب زلالها","بمزاج كافور يخافِرُ اذفرا",56,"ر",2,0],["صُهابيَّةُ العُثنونِ مَخطوفَةُ الحَشا","تَخيَّلُ للأَشباحِ غَرباً فتجفِلُ",57,"ل",1,0],["صهيله جوف إذني","ولا غناء غريب",58,"ب",1,0],["صهيلَ حصانِ طالما شَهدَ الوَغى","وباهى بجرحَي شفرةٍ وسِنان",59,"ن",1,0],["صهبُ العثانين مع زرقِ العيونِ بدت","شؤماً به حدثانُ الدهرِ يرمينا",60,"ن",2,0],["صَهباءُ قُل لِلَّذي تَجَنَّبَها","صَه باءَ بِالهَمِّ تارِكُ الفَرَحِ",61,"ح",1,0],["صَهصَلَقُ الصَوتِ إِذا ما غَدَت","لَم يَطمَعِ الصَقرُ بِها المُنكَدِر",62,"ر",1,0],["صهرتها وهي كالغيم ندى","في لظى الحسرة أبناء الصعيد",63,"د",1,0],["صِهرُ النبيّ وصنِوهُ يا حَبَّذا","صِنوان قَدْ وَشَجَتْهما الأَعْراق",64,"ق",1,0],["صهباءَ حلل مزجها","بنت الشموس إلى البدور",65,"ر",1,0],["صهباء تهدي للنفوس نفائسا","تجلي ببهجتها دجى الأغلاس",66,"س",1,0],["صِهراً يكادُ وَقَدْ لاحَتْ معالِمُهُ","يَشدُو بِهِ الدَّهْرُ إِفصاحاً وتِبيانا",67,"ن",