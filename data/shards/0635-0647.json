{"poems":[[53,"كربلا لا زلت كربا وبلا","https://www.aldiwan.net/poem30772.html","الرمل"],[63,"لك ما يروقه الغمام الهاطل","https://www.aldiwan.net/poem46192.html","الكامل"],[77,"سلو عن فؤادي بعدكم كيف حاله","https://www.aldiwan.net/poem36368.html","الطويل"],[9,"أجبير هل لأسيركم من فادي","https://www.aldiwan.net/poem21925.html","الكامل"],[24,"هل حبل رملة قبل البين مبتور","https://www.aldiwan.net/poem21897.html","البسيط"],[71,"في دولة الملك المعظم خمسة","https://www.aldiwan.net/poem3745.html","الكامل"],[54,"آل الرسول مصابيح الهداية","https://www.aldiwan.net/poem27438.html","البسيط"],[30,"ألا يا اسلمي يا دار مي على البلي","https://www.aldiwan.net/poem29589.html","الطويل"],[30,"أمنزلتي مي سلام عليكما علي","https://www.aldiwan.net/poem29608.html","الطويل"],[27,"قد قرب الحي إذ هاجوا لإصعاد","https://www.aldiwan.net/poem5728.html","البسيط"],[37,"صه وانصتونا للتحاور واسمعوا","https://www.aldiwan.net/poem7479.html","الطويل"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[29,"تغير الرسم من سلمى بأحفار","https://www.aldiwan.net/poem6035.html","البسيط"],[29,"طرق الكرى بالغانيات وربما","https://www.aldiwan.net/poem6174.html","الكامل"],[38,"بان الأحبة بالعهد الذي عهدوا","https://www.aldiwan.net/poem7699.html","البسيط"],[38,"قالت سليمى أتنوي اليوم أم تغل","https://www.aldiwan.net/poem7736.html","البسيط"],[85,"قم سليمان بساط الريح قاما","https://www.aldiwan.net/poem63696.html","الرمل"],[28,"يا ظمي ويحك إني ذو محافظة","https://www.aldiwan.net/poem5495.html","البسيط"],[61,"وهي الشموس فإن رأين طوالعا","https://www.aldiwan.net/poem51459.html","الكامل"],[61,"تأبى المنازل أن تجيب مسائلا","https://www.aldiwan.net/poem51474.html","البسيط"],[66,"صرف المدام به السرور مخصص","https://www.aldiwan.net/poem38488.html","الكامل"],[44,"قالت وعي النساء كالخرس","https://www.aldiwan.net/poem30489.html","المنسرح"],[102,"شيعي الليل وقومي استقبلي","https://www.aldiwan.net/poem32992.html","الرمل"],[75,"أحين ولت أنجم الأفق","https://www.aldiwan.net/poem69057.html","السريع"],[48,"صفة الطلول بلاغة القدم","https://www.aldiwan.net/poem65092.html","الكامل"],[48,"عج للوقوف على راح وريحان","https://www.aldiwan.net/poem65297.html","البسيط"],[48,"يا ساحر الطرف أنت الدهر وسنان","https://www.aldiwan.net/poem65298.html","البسيط"],[48,"لا تحفلن بقول الزاجر اللاحي","https://www.aldiwan.net/poem62506.html","البسيط"],[50,"يا فرخ نهيا بإفك قلت أو زور","https://www.aldiwan.net/poem63807.html","البسيط"],[7,"بانت سعاد وأمسى حبلها انجذما","https://www.aldiwan.net/poem1973.html","البسيط"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39611","المنسرح"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142034","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141981","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43734","المتقارب"],[106,"كرموه","https://www.poetsgate.com/ViewPoem.aspx?id=179708",""],[106,"من للموظف","https://www.poetsgate.com/ViewPoem.aspx?id=179515",""],[106,"الركب المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=179288",""],[1,"لِخَوْلَةَ أَطْلالٌ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=10033",""],[1,"لِخَولة َ أطْلالٌ بِبُرقَة ِ ثَهمَدِ، ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13176&r=&rc=0",""]],"verses":[["صِهرُهُ الباذِلُ عَنهُ نَفسَهُ","وَحُسامُ اللَهِ في يَومِ الوَغى",0,"ا",1,0],["صَهباءُ تُعْشي النّاظِرينَ نَضَتْ بِها","عَذَبَ الفَدامِ عنِ اللّطيمَةِ بابِلُ",1,"ل",1,0],["صَهِيلُ الْجِيَادِ الصَّافِنَاتِ غِنَاؤُهُ","وَتَحْتَ الْبُنُودِ الْخَافِقَاتِ ظِلاَلُهُ",2,"ل",2,0],["صَهباءَ صافِيَةً إِذا ما اِستَودِفَت","شُجَّت غَوارِبُها بِماءِ غَوادي",3,"د",2,0],["صِهرُ النَبِيِّ وَخيرُ الناسِ مُفتَخَراً","فَكُلُّ مَن رامَهُ بِالفَخرِ مَفخورُ",4,"ر",1,0],["صَهرُ المُكَرَّمِ وَالمُكَرَّمُ وَاِبنُهُ","وَالحاكِمُ المصرِيُّ وَاِبنُ التِنَّبي",5,"ي",1,0],["صِهرُ الرَسولِ عَلى الزَهراءِ زَوَّجَهُ ال","لَهُ العَلِيُّ بِها فَوقَ السَمَواتِ",6,"ت",1,0],["صُهابِيَّةً غُلبَ الرِقابِ كَأَنَّما","تُناطُ بِأَلحِيها فَراعلَةٌ غُثرُ",7,"ر",1,0],["صُهابِيَّةٌ جَلسٌ كَأَنّي وَرحلَها","يَجوبُ بِنا المَوماةَ جَأبٌ مُكَدَّحُ",8,"ح",1,0],["صُهباً كَأَنَّ عَصيمَ الوَرسِ خالَطَها","مِمّا تُصَرِّفُ مِن خَطرٍ وَإِلبادِ",9,"د",1,0],["صه وانْصِتونا للتحاور واسمعوا","تشهَّدها من خطبة وارتجالها",10,"ه",2,1],["صَه لِجَوَاب مَا قُلتُم وَأَوكَت","أَكَفُّكُم عَلَى ما تَنفُخُونَا",11,"ن",2,0],["صَهباءُ قَد كَلِفَت مِن طولِ ما حُبِسَت","في مَخدَعٍ بَينَ جَنّاتٍ وَأَنهارِ",12,"ر",1,0],["صَهباءَ صافِيَةٍ تَنَزَّلَ تَجرُها","بِبَلاطِ صَرخَدَ مِن رُؤوسِ جِبالِ",13,"ل",1,0],["صَهباءُ صافِيَةٌ أَغلى التِجارُ بِها","مِن خَمرِ عانَةَ يَطفو فَوقَها الزَبَدُ",14,"د",1,0],["صُهبٌ مَهاريسُ أَشباهٌ مُذَكَّرَةٌ","فاتَ العَزيبَ بِها تَرعِيَّةٌ أَبِلُ",15,"ل",1,0],["صَهوَةَ العِزِّ اِعتَلَوا تَحسَبُهُم","جَمعَ أَملاكٍ عَلى الخَيلِ تَسامى",16,"م",2,0],["صَهباءَ قَد أَخلَفَت عامَينِ باذِلَها","تَلُطُّ عَن جاذِبِ الأَخلافِ مَعقومِ",17,"م",1,0],["صَهَلا بشِعري مُقرِفَينِ فكُذِّبا","إنَّ المَقارِفَ لا يَكُنَّ صَواهِلا",18,"ل",2,0],["صهلا بشعري مقرفين فكذبا","إن المقارف لا تكون صواهلا",19,"ل",2,0],["صَهباءُ قَد راضَ المَزاجُ مِزاجَها","فَغَدَت تُقَهقِهُ وَالفَواقِعُ تَرقُصُ",20,"ص",1,0],["صَهصَلِقٌ في الصَهيلِ تَحسِبُهُ","أُشرِجَ حُلقومُهُ عَلى جَرَسِ",21,"س",1,0],["صَهَروا الأَغلالَ وَاِنصاعوا إِلى","دنس الأَرضِ فَقالوا اِغتَسِلي",22,"ل",2,0],["صَهْصلِقُ الرَّعدِ إذا ما قفَا","ليْلُ المَطايا لامِعُ البَرْق",23,"ق",1,0],["صَهباءَ فَضَّلَها المُلوكُ عَلى","نُظَرائِها بِفَضيلَةِ القَدمِ",24,"م",1,0],["صَهباءُ صافِيَةٌ عَذراءُ ناصِعَةٌ","لِلسُقمِ دافِعَةٌ مِن كَرمِ دِهقانِ",25,"ن",1,0],["صَهباءُ تَبني حَباباً كُلَّما مُزِجَت","كَأَنَّهُ لُؤلُؤٌ يَتلوهُ عِقيانُ",26,"ن",1,0],["صَهباءُ صافِيَةٌ تُجديكَ نَكهَتُها","تَنَفُّسَ المِسكِ مَلطوخاً بِتُفّاحِ",27,"ح",1,0],["صَه لا تَكَلَّم جِهاراً في مَجالِسِنا","وَسَل عَجوزَكَ عَن بَكرِ بِنِ مَذعورِ",28,"ر",1,0],["صُهبَ الظِلالِ أَتَينَ التينَ عَن عُرُضٍ","يُزجينَ غَيماً قَليلاً ماؤُهُ شَبِما",29,"م",2,0],["صُهابيَّةُ العُثنونِ موجَدَةُ القَرا","بَعيدَةُ وَخدِ الرِجلِ مَوّارَةُ اليَدِ",30,"د",1,0],["صهباءُ ما كانتْ","من غرس إبليسِ",31,"س",1,0],["صهٍ أيها الموتى ولو كان فيكمو","حياة لصِحتُم ملء هذه الحناجرِ",32,"ر",1,1],["صهر القرون وصاغها","تاجاً لمفرقك الحبيب",33,"ب",1,0],["صهٍ حاسِدي أَنا مِن طَيِّبينَ","إِذا مسك اِيّهما مَسَّكا",34,"ك",2,0],["صهرت نفسَه الخطوبُ؛ فزادَت","نفسهُ في تَنُّورها لمعانا",35,"ن",2,0],["صَهرَ الغلاء كبيرها، وصغيرها","فالكل غَرثانُ الجوانح، صاد",36,"د",1,0],["صَهَرَ الأنفُسَ حتى لم تعُدْ","تدركُ الأنفسُ شيئًا ما عداه",37,"ا",2,0],["صهابية العثنون موجدة الفرا","بعيدة وخد الرجل موارة اليد",38,"د",1,0],["صُهابِيّة ُ العُثْنُونِ مُوجَدَة ُ القَرَا","بعيدة ُ وخد الرِّجل موَّراة ُ اليد",39,"د",1,0]]}