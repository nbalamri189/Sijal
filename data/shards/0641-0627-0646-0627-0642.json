{"poems":[[9,"ألا من مبلغ عني حريثا","https://www.aldiwan.net/poem21987.html","الوافر"],[88,"أجاد مطران كعاداته","https://www.aldiwan.net/poem10857.html","السريع"],[95,"هدايا الناس من زهر الجنان","https://www.aldiwan.net/poem11187.html","الوافر"],[95,"سوى الحب لا تشفي الفؤاد المكلما","https://www.aldiwan.net/poem11364.html","الطويل"],[53,"رأيت منكسر السكان ظاهره","https://www.aldiwan.net/poem65805.html","البسيط"],[87,"معالي العهد قمت بها فطيما","https://www.aldiwan.net/poem8100.html","الوافر"],[60,"أتاني أن هندا أخت صخر","https://www.aldiwan.net/poem31088.html","الوافر"],[68,"إذا زرت الملوك فكن رئيسا","https://www.aldiwan.net/poem38574.html","الوافر"],[76,"وتيقن أن الله أكرم جيرة","https://www.aldiwan.net/poem13224.html","الطويل"],[50,"مني إلى المتكبر","https://www.aldiwan.net/poem63350.html","مجزوء الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54594","البسيط"],[96,"الشّهيد","https://www.poetsgate.com/ViewPoem.aspx?id=13789",""],[173,"ما أنصف الطلل العافي بماوانا","https://www.aldiwan.net/poem1685.html",""],[226,"أتستقبل الدهر مستبشرا","https://www.aldiwan.net/poem55293.html","المتقارب"],[240,"أبثكم أني مشوق بكم صب","https://www.aldiwan.net/poem32178.html","الطويل"],[266,"شكت شجي وبكت يوم النوى شجنا","https://www.aldiwan.net/poem38169.html","البسيط"],[325,"وسيع صدري انقضت في ضيقه حيلي","https://www.aldiwan.net/poem67221.html","البسيط"],[354,"يا مي مل الهوى إلا معناك","https://www.aldiwan.net/poem15813.html","البسيط"],[362,"سلام من لدن روض السلام","https://www.aldiwan.net/poem4146.html","الوافر"],[443,"إن العرين الذي يحتله الأسد","https://www.aldiwan.net/poem2613.html","البسيط"],[445,"أخو ظمأ يمص حشاه سبع","https://www.aldiwan.net/poem34835.html","الوافر"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[581,"إن الهوان حمار القوم يعرفه","https://www.aldiwan.net/poem1772.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138254",""],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126700","البسيط"],[749,"","https://poetry.dctabudhabi.ae/diwan/poem/97585","البسيط"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130152","الطويل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/67037","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70765","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70782","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112796","الوافر"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115995","الطويل"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21700","الوافر"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87944","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101062","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101018","الطويل"],[2029,"","https://poetry.dctabudhabi.ae/diwan/poem/123710","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53105","الطويل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45715","السريع"],[3234,"","https://poetry.dctabudhabi.ae/diwan/poem/144700","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68018","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103835","البسيط"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66437","الطويل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118748","المتقارب"],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21379","الوافر"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69936","الوافر"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135073","الرجز"],[4532,"","https://poetry.dctabudhabi.ae/diwan/poem/45313","الوافر"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123862","المنسرح"],[4590,"","https://poetry.dctabudhabi.ae/diwan/poem/20865","الرمل"],[4830,"أتلو جمالَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=206865",""],[5083,"بَشيرُ السَعد","https://www.poetsgate.com/ViewPoem.aspx?id=53761",""],[5121,"الْمِنْهَاجُ","https://www.poetsgate.com/ViewPoem.aspx?id=34716",""],[5205,"سما أكباد ارباب النهى انفطرت","https://www.poetsgate.com/ViewPoem.aspx?id=120993",""],[5302,"ما خانك الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=200065",""],[5596,"وادي الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=206177",""],[5616,"الراحلون","https://www.poetsgate.com/ViewPoem.aspx?id=204853",""],[5790,"تملكت من سيد أصيدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=111889",""],[6031,"إنَّ الثَّنَاءَ وإنْ تَعاظَمَ قَدْرُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=46392",""],[6223,"أعتقيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1205&r=&rc=12",""],[5080,"من يصطفي جسد الرّحيل مواظبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88142&r=&rc=12",""],[5616,"الرّاحلون ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1934&r=&rc=4",""]],"verses":[["فَإِنّا قَد أَقَمنا إِذ فَشِلتُم","وَإِنّا بِالرِداعِ لِمَن أَتانا",0,"ن",2,0],["فَإِن أَقِف مِن بَعدِهِ مُنشِداً","فَإِنَّما مِن طِرسِهِ طِرسي",1,"س",2,0],["فَإِنْ أَقُلِ انْفَرَدْتَ فَرُبَّ زَهْرٍ","بِكَ ابْتَدَأَتْ وَلَيْسَتْ بِالثَّوانِي",2,"ن",2,0],["فَإِنْ أَقْبَلَتْ فَالغُصْنُ أَثْقَلَهُ الْجَنَى","فَمَالَ قَلِيلاً وَاسْتَوَى مُتَقَوِّمَا",3,"م",2,0],["فإن أقمتَ ففي خفضٍ وفي دعةٍ","وإن ظعنتَ فربُّ الناس يرعاكا",4,"ك",2,0],["فَإِن أُقرِئتَ يا مَولايَ شِعري","فَإِنَّ أَباكَ يَعرِفُهُ وَيَدري",5,"ي",1,0],["فَإِنَّا قَد قَتَلنا يَومَ بَدرٍ","أَبا جَهلٍ وَعُتبَةَ وَالوَليدا",6,"د",2,0],["فَإِن أَقصَوكَ قُل هَذا مَقامي","وَإِن أَدنوكَ قُل ذا فَوقَ قَدري",7,"ر",2,0],["فَإِن أَقفَرَت مِنهُ العُيونُ فَإِنَّهُ","تَعَوَّضَ عَنها بِالقُلوبِ بَديلا",8,"ل",2,0],["فَإِن أَقُل قِف يَسِر أَو","أَقُل تَقَدَّم تَأَخَّر",9,"ر",1,0],["فَإِنْ أَقْصُرْ وَأَرْجُ الْيَوْمَ مَعْذَرَةً","فَالْوِدُّ يَحْفُزُنِي والجِهْدُ يَقْعُدُ بِي",10,"ب",2,0],["فإن أقسموا أن يفتدوا بنفوسهم","أمانتك الكبرى لديهم فقد برّوا",11,"ر",3,0],["فَإِن أَقُل سَيِّدا قَومي هُما سَبَبٌ","لِذاكَ لَم أَرَ هَذا القَولَ إِحسانا",12,"ن",2,0],["فإن أقبلت غر أيامه","تراه على الفور قد أدبرا",13,"ر",2,0],["فَإِن أَقتَرِف ذَنباً بِمَدحِ سِواهُمُ","فَإِنَّ خِماصَ الطَيرِ يَقنِصُها الحَبُّ",14,"ب",1,0],["فأن اقتل داء لا دواء له","قلب يضم به الشحناء والأحنا",15,"ن",2,0],["فَإِن أُقابِلُ بِالحُسنى وَأَنصَفَني","ذا الدَهرِ نِلتُ المُنى قَبلَ اِنقَضا أَجَلي",16,"ل",2,0],["فَإِن أَقُل غَيرَ هَذا فيكِ وَاِخجَلي","مِن الغَرامِ وَواكُفري وَإِشراكي",17,"ك",2,0],["فإِن أَقصِر فمن عَدَم المُوَالي","وإن السَّهم بِالرِّيش اللُّؤامِ",18,"م",1,0],["فإن أقم فحقيق أو تسترني","فالبدر في الليلة الظلماء يفتقد",19,"د",1,0],["فإِن أَقْوَتْ مغاني العِزِّ منهمْ","فكم عَمِرَتْ بِهِم بِيدٌ خلاءُ",20,"ا",2,0],["فإن أقرّ أنه أوصاه","فالحمد لله الذي هداه",21,"ه",1,0],["فإن أقر قبل الهداية","وإن أبى خوصم بالحكاية",21,"ه",1,0],["فَإِن أَقَمتُم عَلى ضَيمٍ يُرادُ بِكُم","فَإِنَّ رَحلي لَكُم وَالٍ وَمُعتَمَدُ",22,"د",1,0],["فإن أقل ليس يحوي مثله ملك","قد لا تصدقني إلا بتوكيد",23,"د",1,0],["فإن أقمتم له حفلاً فإنّ لكم","أجراً عظيماً وشكراً أيّها العربُ",24,"ب",1,0],["فَإن أقمت ففي نعماك عاطفة","وَإن رحلت فقد زوّدتني زادي",25,"د",2,0],["فان أقلعت كانت لديه أمينة","وإن رنجعت تبغي أحل ذمارها",26,"ر",3,0],["فإن أقفرت منه العيون فإنه","تعوض منها بالقلوب بديلا",27,"ل",2,0],["فإن أقبلاهُمْ صَحَّ إقبالُها لنا","وإنْ وَليا عنا قفتْهم على الأثرِ",28,"ر",1,0],["فإن أقلْ حصل المطلوب مِنْتُ ولم","يجمل إذا قلتُ لم أو قلت قولة لا",29,"ل",2,0],["فانا قد أجرنا فابشرن بالوصال","بنا واحسان الشؤن",30,"ن",1,0],["فإن أقضِ نحبى بعدها من تأسُّفٍ","فأيسَرُ ما قاسيتُ للنَّفسِ قاتِلُ",31,"ل",1,0],["فَإِنَّ أَقصر فَقَد أَجرَيتُ عَصراً","وَبَلّاني الهَوى فيمَن يُبَلّي",32,"ل",2,0],["فان اقاموا على علاتهم همجاً","ولم يَروا مهرباً راضين بالبأسِ",33,"س",1,0],["فإنا قد جعلنا ضفتيه","سبيل الحين للمستهدفينا",34,"ن",2,0],["فإن أقبلوا طاحوا وإن أدبروا فنوا","وإن أبقوا فالويل للمتأبق",35,"ق",1,0],["فإن أقوت فهل لي من سبيل","إلى صبر يعلل ما أقاسي",36,"س",2,0],["فإن أقلعت عني غيوثك برهة","وأوحش قطري بعد عهدي بالقطر",37,"ر",1,0],["فإِن أَقاموها فَما ذَنبنا","كُنا عَلى ذاكَ نَفضناها",38,"ا",3,0],["فإن أقنعتكم فاسمعوها سريحة","وإلا فجيئوا من يحدثكم ألفا",39,"ف",2,0],["فإن أقفرتْ منا لياليك إننا","سنأتيك يوماً عن قريبٍ ونرجعُ",40,"ع",1,0],["فإن أقم عنه مضطرّاً فإني لا","أزال ملتفتاً والمشي شيء وجي",41,"ج",2,0],["فإن اقترف ذنباً فكن خير غافرٍ","وإن اجترح جرماً فكن خير صافح",42,"ح",1,0],["فإنَّا قهرنا طغاة الملوك","زمان اتخذنا التقى متجرا",43,"ر",2,0],["فإِنّا قَد حَلَلنا دارَ بَلوى","فَتُخطِئُنا المَنايا أَو تُصِيبُ",44,"ب",1,0],["فانا قَد رَتعنا في رياض","عَلَيها مِن عَوارفِهِ سُيولُ",45,"ل",1,0],["فإن اقل ما فيه من","وصفي لكل مهتدي",46,"د",2,0],["فَأَنَّا قَد جَمَعنا جَمعَ صِدقٍ","يُفَرِّجُ عَن مَناكِبِهِ الزِحاما",47,"م",2,0],["فان اقس يومها بامس أقل","يا وحشة الدار بعد ايناس",48,"س",1,0],["فأنا قاتلةٌ مقتولةٌ","ولعل اللَه أن ينظر لي",49,"ل",2,0],["فانْ أقرضتني أوجبتَ دَينَاً","على صبٍّ فلا تُبدِ انشغالَكْ",50,"ك",1,0],["فإنَّا قادمون ولاتَ مَنْجَى","ففي أُذُنَيَّ أَصْداءُ العَويلِ",51,"ل",1,0],["فَإِنَّ اقْتِرَابَ الْمَوْتِ كَالرِّمْشِ رَفُّهُ","وَلَنْ يَسْتَشِيِرَ الْمَرْءَ وَقْتٌ لِيَجْزَعَا",52,"ع",2,0],["فأن أقيل الدلنجاوي صفقته","وردت النفس ما باعت به وشرت",53,"ت",1,0],["فإن أقمت ففي قصر عرفت به","وإن رحلت فمني يعشب السفر",54,"ر",1,0],["فإنا قد تركنا في ( العوابي )","شغاف قلوبنا في الرهن نصبا",55,"ب",2,0],["فإنَّا قد رحلْنَا منذُ دهرٍ","فلم تبْقَ الفروعُ ولا الأصولُ",56,"ل",1,0],["فإن إقامات مجد العبيد","تدل على سؤدد السيد",57,"د",1,0],["فإن اقتَصَرْتُ علَى القَليلِ من الذي","أُثْنِي عَليكَ بهِ فإنِّي أُعْذَرُ",58,"ر",1,0],[".. فأنا قلبي ، وقلبي لغةٌ","كتبت أحداثها في ناظريّا",59,"ي",2,0],["فأنا قتيلُ العمرِ حطَّ ظلالهُ","بينَ المسافةِ للسرابِ مصاحبا",60,"ب",2,0],["فإنَّا قبلَ ذلكَ قد رحلنا","فلم تبقَ الفروعُ ولا الأصولُ",61,"ل",1,0]]}