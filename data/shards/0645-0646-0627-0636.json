{"poems":[[55,"نهنه عتابك إلا إن هفا جرم","https://www.aldiwan.net/poem29760.html","البسيط"],[53,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59433","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111470","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141567","الكامل"],[4830,"هوى الأزهار","https://www.poetsgate.com/ViewPoem.aspx?id=200549",""],[4929,"مَيَلانُ الموازين. (من بحر المنسرح)","https://www.poetsgate.com/ViewPoem.aspx?id=207997",""],[5045,"دام صدرك يااليماني في انشراحه","https://www.poetsgate.com/ViewPoem.aspx?id=185177",""],[5956,"مناضلٌ هاجم العدوانُ شوكتَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=194194",""],[5309,"ذلك البدر كنت ادري مصيره","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573542",""]],"verses":[["مَن أَضمَرَ الصَدَّ عَمَّن لَيسَ يُضمِرُهُ","بَغياً مَشى في نَواحي سِرِّهِ النَدَمُ",0,"م",1,0],["مناضلاتٌ بنبلٍ لا تقومُ له","كتائبُ التُّركِ يُزْجيهنَّ خاقان",1,"ن",1,0],["مَن أَضمَرَ السُّوءَ جازاهُ الإِلَهُ بِهِ","وَمَن رَعى البَغيَ لَم يَسلَم مِنَ النِقَمِ",2,"م",1,0],["من أضا نوره بواضح شيت","فتبدّى لحاضر ولبادي",3,"د",2,0],["مَنَاضِدَ سَبعاً لَم تَر النارَ جُدَّداً","وعِشرِينَ طَسًّا ساطِعاتٍ لِمَنظَرِ",4,"ر",1,0],["مناضدٌ سبعٌ تشوق النظر","يكنفها عشرون طسّاً أغر",5,"ر",1,0],["من أضحك السلطان صوت ردامه","فهو الذي في الناس عدَّ عريفا",6,"ف",2,0],["مَنْ أضرمَ قلبكَ واستبكى","قلتُ الأشواقُ وَقودُ النّارْ",7,"ر",1,0],["من أضرموا النارَ في زهوركِ ما","ذا ضرَّهُمْ في جمالِها النضرِ ؟",8,"ر",1,0],["من اضافوا لليمن صفحة جراحة","باطلك والجرم هو باطل وزاهق",9,"ق",1,0],["مناضلٌ هاجم العدوانُ شوكتَهُ","وآثَر العفوَ رفقاً بالجماهيرِ..",10,"ر",1,1],["مَن أَضاعَ البَدرَ المُنيرَ سَيَحيا","نادِماً يَشتَكي اللَّظى وَسَعيرَه",11,"ر",2,0]]}