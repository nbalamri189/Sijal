{"poems":[[53,"رأيت المنى نهزة الثائر","https://www.aldiwan.net/poem30474.html","المتقارب"],[63,"هي الصبابة من باد ومكتمن","https://www.aldiwan.net/poem46187.html","البسيط"],[0,"ألا إلا تكن إبل فمعزى","https://www.aldiwan.net/poem71.html","الوافر"],[89,"الشعر ديوان العرب","https://www.aldiwan.net/poem44780.html","مجزوء الرجز"],[85,"لي ساعة من معدن","https://www.aldiwan.net/poem7751.html","مجزوء الرجز"],[85,"ممالك الشرق أم أدارس أطلال","https://www.aldiwan.net/poem62835.html","البسيط"],[45,"برق أضاء العقيق من ضرمه","https://www.aldiwan.net/poem65686.html","المنسرح"],[80,"وثابتة الوقفين جوالة القرط","https://www.aldiwan.net/poem31393.html","الطويل"],[48,"يا نظرة ساقت إلى ناظر","https://www.aldiwan.net/poem64404.html","السريع"],[50,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85302","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16637","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55173","السريع"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/29753","الرجز"],[106,"بين عهدين","https://www.poetsgate.com/ViewPoem.aspx?id=179345",""],[107,"فخرا دمشق على كل البلاد بمن","https://www.aldiwan.net/poem16232.html","البسيط"],[273,"لمن وقعة بالغرب ضعضعت الشرقا","https://www.aldiwan.net/poem25477.html","الطويل"],[346,"ولي حمار قطعتي في الدرى","https://www.aldiwan.net/poem20261.html","السريع"],[406,"ظبي تغار الشمس من حسنه","https://www.aldiwan.net/poem32580.html","السريع"],[456,"سل الركب إن أعطاك حاجتك الركب","https://www.aldiwan.net/poem56270.html","الطويل"],[462,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[484,"يا مال والسيد المعمم","https://www.aldiwan.net/poem480.html",""],[549,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"]],"verses":[["إِذا مَشَقَ الخِفَّ فَوقَ البِطا","حِ وَقَّعَ فيهِنَّ بِالحافِرِ",0,"ر",1,0],["إذا مَشَتْ دَبَّ في أعطافِها مَرَحٌ","كَما هفَتْ نَسَماتُ الرّيحِ بالغُصُنِ",1,"ن",1,0],["إِذا مُشَّت حَوالِبُها أَرَنَّت","كَأَنَّ الحَيَّ صَبَّحَهُم نَعِيُّ",2,"ي",1,0],["اذا مشى يمشي العرضنى","او مضى يمضي الحبب",3,"ب",1,0],["إذا مشت لم أحتفل","أو وقفت لم أحزن",4,"ن",1,0],["إِذا مَشَت أُمَّةٌ في العالَمينَ بِهِ","أَبى لَها اللَهُ أَن تَمشي بِأَغلالِ",5,"ل",1,0],["إِذا مَشى أُدمِجَت جَوانِبُهُ","وَاِهتَزَّ مِن قَرنِهِ إِلى قَدَمِه",6,"م",2,0],["إذا مَشَطَتْ فرعاً تَفَرّعَ ليلُهُ","وطالَ من القيناتِ فيه سُرَى المِشطِ",7,"ط",1,0],["إِذا مَشى جاذَبَهُ رِدفُهُ","كَأَنَّما يَمشي إِلى خَلفِهِ",8,"ف",2,0],["إِذا مَشَت تَقصِدُ أَو تَجورُ","مَيَّلَها دِعصُ مَلاً مَمطورُ",9,"ر",1,0],["إذا مَشَت تَتَثنّى عند مشيتها","كَما تَمايل غُصنٌ ناعم غضر",10,"ر",1,0],["إذا مَشَطَتْها قَيْنَةٌ بَعْدَ قَيْنَةٍ","تضَوّعَ مِسْكاً من ذوائبِها المِشطُ",11,"ط",1,0],["إِذَا مَشَى بِالجَيْشِ صَوْبَ العِدَى","فَقَدْ مَشَى جَيْشَانِ فِي جَحْفَلِ",12,"ل",1,0],["إذا مَشى في حَلَقاتِ الماذي","رَمَتْ إليهِ الأرضُ بالأفْلاذِ",13,"ذ",1,0],["إذا مشيتُ بِسِيف النيل أنكرُهُ","وربما أنكرَتْنِي منه شُطْآن",14,"ن",1,0],["إِذا مَشى فَعلى الأَعناق مَشيَتَهُ","وَإِن رَأَيت رِجال الحَي رُكبانا",15,"ن",2,0],["إذا مَشَقُوا الأَقْرانَ أَبْقَتْ رِماحُهُمْ","فُوَيْقَ ثِيَابِ السَّرْدِ مَا يَصِفُ الشَّقَّا",16,"ق",2,0],["إذا مَشَى الخُطوةَ أَو دُونَها","أَقُولُ سِبْحَانَ اللَّطِيفِ الخَبيرْ",17,"ر",1,0],["إذا مَشَى أخجلَ سُمرَ القَنَا","وحارَ فيه عقلُ مَن ينظُرُ",18,"ر",1,0],["إذا مشتِ الأقران حولَ خريدةٍ","فَوحدتُها في الحسنِ ليس لها تِربُ",19,"ب",1,0],["إذا مشهدٌ صلَّت بهِ البيض لم تجد","فتى ساجداً منهنَّ إلاَّ لراكع",20,"ع",1,0],["إِذا مَشَينا في الفارِسِيِّ كَما","تَمشي جِمالٌ مَصاعِبٌ قُطُفُ",21,"ف",1,0],["إذا مشى في فضولِ الدّرع تحسبه","مقلّباً نَخْوةً أعطافَ رِئْبالِ",22,"ل",1,0]]}