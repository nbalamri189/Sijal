{"poems":[[55,"رأيت المنى نهزة الثائر","https://www.aldiwan.net/poem30474.html","المتقارب"],[65,"هي الصبابة من باد ومكتمن","https://www.aldiwan.net/poem46187.html","البسيط"],[0,"ألا إلا تكن إبل فمعزى","https://www.aldiwan.net/poem71.html","الوافر"],[91,"الشعر ديوان العرب","https://www.aldiwan.net/poem44780.html","مجزوء الرجز"],[87,"لي ساعة من معدن","https://www.aldiwan.net/poem7751.html","مجزوء الرجز"],[87,"ممالك الشرق أم أدارس أطلال","https://www.aldiwan.net/poem62835.html","البسيط"],[47,"برق أضاء العقيق من ضرمه","https://www.aldiwan.net/poem65686.html","المنسرح"],[82,"وثابتة الوقفين جوالة القرط","https://www.aldiwan.net/poem31393.html","الطويل"],[50,"يا نظرة ساقت إلى ناظر","https://www.aldiwan.net/poem64404.html","السريع"],[52,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85302","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16637","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55173","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/29753","الرجز"],[108,"بين عهدين","https://www.poetsgate.com/ViewPoem.aspx?id=179345",""],[113,"فخرا دمشق على كل البلاد بمن","https://www.aldiwan.net/poem16232.html","البسيط"],[280,"لمن وقعة بالغرب ضعضعت الشرقا","https://www.aldiwan.net/poem25477.html","الطويل"],[353,"ولي حمار قطعتي في الدرى","https://www.aldiwan.net/poem20261.html","السريع"],[415,"ظبي تغار الشمس من حسنه","https://www.aldiwan.net/poem32580.html","السريع"],[463,"سل الركب إن أعطاك حاجتك الركب","https://www.aldiwan.net/poem56270.html","الطويل"],[469,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[491,"يا مال والسيد المعمم","https://www.aldiwan.net/poem480.html",""],[556,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59810","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62560","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59333","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16721","السريع"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56182","البسيط"],[1471,"","https://poetry.dctabudhabi.ae/diwan/poem/18373","المنسرح"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77844","الرجز"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77825","الرجز"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141355","البسيط"],[1826,"","https://poetry.dctabudhabi.ae/diwan/poem/198963","السريع"],[1953,"","https://poetry.dctabudhabi.ae/diwan/poem/123873","الرجز"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69404","السريع"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123310",""],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123166","البسيط"],[2169,"","https://poetry.dctabudhabi.ae/diwan/poem/141414","الرجز"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104977","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60926","البسيط"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65944","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65979","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100274","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100336","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132752","السريع"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103622","الطويل"],[3531,"","https://poetry.dctabudhabi.ae/diwan/poem/145741","الوافر"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36719","السريع"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32480","المجتث"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86376","الوافر"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45933","الطويل"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105131","الوافر"],[4550,"","https://poetry.dctabudhabi.ae/diwan/poem/107141","البسيط"],[4862,"بات المحب لمن يهواه مشتاقا","https://www.poetsgate.com/ViewPoem.aspx?id=157674",""],[5338,"على منهاج صاحب البردة","https://www.poetsgate.com/ViewPoem.aspx?id=187617",""],[5759,"نشيدُ الغُربة","https://www.poetsgate.com/ViewPoem.aspx?id=214175",""],[5937,"خارِجَ النّسَق","https://www.poetsgate.com/ViewPoem.aspx?id=211805",""],[6089,"نهر البصيرة","https://www.poetsgate.com/ViewPoem.aspx?id=212970",""],[6102,"تحاميل","https://www.poetsgate.com/ViewPoem.aspx?id=183310",""]],"verses":[["إِذا مَشَقَ الخِفَّ فَوقَ البِطا","حِ وَقَّعَ فيهِنَّ بِالحافِرِ",0,"ر",1,0],["إذا مَشَتْ دَبَّ في أعطافِها مَرَحٌ","كَما هفَتْ نَسَماتُ الرّيحِ بالغُصُنِ",1,"ن",1,0],["إِذا مُشَّت حَوالِبُها أَرَنَّت","كَأَنَّ الحَيَّ صَبَّحَهُم نَعِيُّ",2,"ي",1,0],["اذا مشى يمشي العرضنى","او مضى يمضي الحبب",3,"ب",1,0],["إذا مشت لم أحتفل","أو وقفت لم أحزن",4,"ن",1,0],["إِذا مَشَت أُمَّةٌ في العالَمينَ بِهِ","أَبى لَها اللَهُ أَن تَمشي بِأَغلالِ",5,"ل",1,0],["إِذا مَشى أُدمِجَت جَوانِبُهُ","وَاِهتَزَّ مِن قَرنِهِ إِلى قَدَمِه",6,"م",2,0],["إذا مَشَطَتْ فرعاً تَفَرّعَ ليلُهُ","وطالَ من القيناتِ فيه سُرَى المِشطِ",7,"ط",1,0],["إِذا مَشى جاذَبَهُ رِدفُهُ","كَأَنَّما يَمشي إِلى خَلفِهِ",8,"ف",2,0],["إِذا مَشَت تَقصِدُ أَو تَجورُ","مَيَّلَها دِعصُ مَلاً مَمطورُ",9,"ر",1,0],["إذا مَشَت تَتَثنّى عند مشيتها","كَما تَمايل غُصنٌ ناعم غضر",10,"ر",1,0],["إذا مَشَطَتْها قَيْنَةٌ بَعْدَ قَيْنَةٍ","تضَوّعَ مِسْكاً من ذوائبِها المِشطُ",11,"ط",1,0],["إِذَا مَشَى بِالجَيْشِ صَوْبَ العِدَى","فَقَدْ مَشَى جَيْشَانِ فِي جَحْفَلِ",12,"ل",1,0],["إذا مَشى في حَلَقاتِ الماذي","رَمَتْ إليهِ الأرضُ بالأفْلاذِ",13,"ذ",1,0],["إذا مشيتُ بِسِيف النيل أنكرُهُ","وربما أنكرَتْنِي منه شُطْآن",14,"ن",1,0],["إِذا مَشى فَعلى الأَعناق مَشيَتَهُ","وَإِن رَأَيت رِجال الحَي رُكبانا",15,"ن",2,0],["إذا مَشَقُوا الأَقْرانَ أَبْقَتْ رِماحُهُمْ","فُوَيْقَ ثِيَابِ السَّرْدِ مَا يَصِفُ الشَّقَّا",16,"ق",2,0],["إذا مَشَى الخُطوةَ أَو دُونَها","أَقُولُ سِبْحَانَ اللَّطِيفِ الخَبيرْ",17,"ر",1,0],["إذا مَشَى أخجلَ سُمرَ القَنَا","وحارَ فيه عقلُ مَن ينظُرُ",18,"ر",1,0],["إذا مشتِ الأقران حولَ خريدةٍ","فَوحدتُها في الحسنِ ليس لها تِربُ",19,"ب",1,0],["إذا مشهدٌ صلَّت بهِ البيض لم تجد","فتى ساجداً منهنَّ إلاَّ لراكع",20,"ع",1,0],["إِذا مَشَينا في الفارِسِيِّ كَما","تَمشي جِمالٌ مَصاعِبٌ قُطُفُ",21,"ف",1,0],["إذا مشى في فضولِ الدّرع تحسبه","مقلّباً نَخْوةً أعطافَ رِئْبالِ",22,"ل",1,0],["إذا مشكلاتُ الأمر أظلم ليلها","ولمْ تور فيهن العقول القوادح",23,"ح",1,0],["إذا مشين في البرى","قْبَّلِتِ الشمس الثرى",24,"ر",2,0],["إذاَ مَشَطَتْ أيدي النسيم فُرُوعَهَا","تَرَى حُلَلاً خضرا تُزَرَّرُ بِالذَّهَبْ",25,"ب",1,0],["إِذا مَشى يَخطُرُ في بُردِهِ","غايَرَ فيهِ الشَكلُ حُسناً رَطيب",26,"ب",1,0],["إذا مشى مهلاً فات النعام وإن","جدّ السرى كلَّ عن أحكاره البصر",27,"ر",1,0],["إِذا مَشَوا بِالنَميمِ بَينَهُمُ","مَلَّ الجَميعُ الصَفاءَ فَاِفتَرَقا",28,"ق",2,0],["إِذا مشت ترنحت","كَأَنَّها تجاذب",29,"ب",1,0],["إِذا مَشَت تكنّى","أَغصان بان ياسون",30,"ن",1,0],["إذا مشى لا تحسّ الأرض وطأته","وإن تكلّم فالألفاظ أعسال",31,"ل",1,0],["إذا مشى والجيش قدامه","صاح عليه حسنه: لا براح",32,"ح",1,0],["إذا مشى في جنبه دُرامِجَا","مشى العذارى تجتني الغمالِجا",33,"ج",2,0],["إِذا مَشى سَدَّ بِهِ فَرجَهُ","مِثلَ عَثاكِيلِ نَخيلِ القَراح",34,"ح",1,0],["إذا مشى في الصخر غاصت نعله به","وإن مشى في الرمل لم يُشهد له أثر",35,"ر",1,0],["إذا مشى واحد منهم لحاجته","فظهره من ورا والوجه من أمَم",36,"م",1,0],["إذا مشيت مشية العود النطف","طعنهم بكل خطي ثقف",37,"ف",1,0],["إذا مشى هزَّ أغصان الأراك فهل","من النسيم براه بارىء النسم",38,"م",1,0],["إذا مشت ماست الأعالي","وأرتج ما حازت البرود",39,"د",1,0],["إذا مشيت في الرعاع مغبقاً","مشى لدينا الأكرمون الصيد",40,"د",1,0],["إِذا مشت سلبت بالمشي من لحظت","عيناه مشيتها في الرسل والكسل",41,"ل",1,0],["إذا مشى اهتزَّ من فرع إلى قدم","كأنه غُصُنٌ بالريح مخضود",42,"د",1,0],["اذا مشت لك ريثاً او على عجل","تقسَّمت لك قضبانا واحقانا",43,"ن",2,0],["إذا مشى ارتج كثيب النفا","وفوقه من شعره ارقمان",44,"ن",1,0],["اذا مشقت يمناه في بطن مهرق","تحجّب نوار الربا في الكمائم",45,"م",1,0],["إذا مشَيا معي أبصرتُ أفقاً","أحاطَ به السّنا من جانبيْهِ",46,"ب",3,0],["إِذا مَشَت في الطِرس أَقلامُهُ","أَهوِن بِفعل السُمرِ ذاتِ الكِعاب",47,"ب",1,0],["إِذا مَشَت تَثَنَّت","كَأَنَّها ثُعبانُ",48,"ن",1,0],["إذا مشيته في الطرس رضيعا","فإن فطم استكن وعاد حملا",49,"ل",2,0],["إِذا مُشكِلٌ يَوماً تَعَسَّرَ فَهمُهُ","جَلاهُ وَأَبداهُ بِأَوضَحِ حُجَّةِ",50,"ه",1,0],["إذا مشق الذميل لها إهابا","من العزمات جدّده الرسيم",51,"م",1,0],["إذا مشت فقلوب الناس تتبعها","كما اشرأب إلى العفراء خشفاها",52,"ا",3,0],["إذا مشت في طريق الناس ضاحكةً","من كل صدرٍ يطير القلب خفاقا",53,"ق",2,0],["إذا مَشَتْ فالْجَلالُ الطُّهْرُ يحرُسُها","وإنْ رَنَتْ فالْعَفافُ الْخَفْرُ فِي ذِمَمِ",54,"م",1,0],["إذا مشيتُ وئيداً طارَ بي قَدَمي","فوقَ السِماكِ فلا تَقفوا على أثَري١",55,"ر",2,0],["إذا مشيتِ أرى الأزهار نابتةً","كأن مشيكِ مِن حرثٍ ومن ودَقِ",56,"ق",1,0],["إذا مشى ،رجَّ أغصانَ الأراكِ ، فهل","من النَّسيم بَراه بَارىءُ النّعَمِ ؟!",57,"م",1,0],["إِذا مَشَينا عُيُونُ القَصرِ تَتبَعُنا","وَ إِنْ حَكَينا فَوَيلٌ لِلتَّآوِيلِ",58,"ل",1,0]]}