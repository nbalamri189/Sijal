],[3271,"دمعة في قلب الليل","https://www.poetsgate.com/ViewPoem.aspx?id=102704",""],[5090,"صبرًا أخية ..","https://www.poetsgate.com/ViewPoem.aspx?id=186816",""],[778,"اسقني من قهوة مشمولة","https://www.poetsgate.com/ViewPoem.aspx?id=89214",""],[5190,"إن تُتهمي أو تُنجدي","https://www.poetsgate.com/ViewPoem.aspx?id=153359",""],[5190,"روح وريحان","https://www.poetsgate.com/ViewPoem.aspx?id=121512",""],[5302,"ما الذي سوف نلقى ؟","https://www.poetsgate.com/ViewPoem.aspx?id=200122",""],[5320,"شكرا أمريكا","https://www.poetsgate.com/ViewPoem.aspx?id=41633",""],[5358,"مجرى الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=183421",""],[5409,"دم ذاكراً فيك يا شعبان من وثبوا","https://www.poetsgate.com/ViewPoem.aspx?id=155253",""],[5445,"لا تذكرني","https://www.poetsgate.com/ViewPoem.aspx?id=25797",""],[5525,"فكرة","https://www.poetsgate.com/ViewPoem.aspx?id=7178",""],[5561,"انتظار","https://www.poetsgate.com/ViewPoem.aspx?id=197276",""],[5596,"طبع الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=205611",""],[5612,"يا شاكِيَ الهمّْ","https://www.poetsgate.com/ViewPoem.aspx?id=180381",""],[5612,"لا تَحْزَني","https://www.poetsgate.com/ViewPoem.aspx?id=181648",""],[5628,"السماء القاتمة","https://www.poetsgate.com/ViewPoem.aspx?id=178511",""],[5937,"كي لايحزن الفلاح","https://www.poetsgate.com/ViewPoem.aspx?id=211882",""],[5952,"ما ودَّعَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=203725",""],[5956,"ترجوني ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181967",""],[5970,"أشغل القلب بما يهوى فما","https://www.poetsgate.com/ViewPoem.aspx?id=130592",""],[6004,"جَنَّةٌ للنِّسَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=59595",""],[6019,"إشتياق بعنوان آخر !!","https://www.poetsgate.com/ViewPoem.aspx?id=53047",""],[6019,"رمادٌ تدره الرياح","https://www.poetsgate.com/ViewPoem.aspx?id=53048",""],[6124,"إلى لقاء","https://www.poetsgate.com/ViewPoem.aspx?id=154116",""],[5309,"لا تذرفا دمعا على فقدانه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573555",""],[6234,"الربيع الفاتن في نجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6538&r=&rc=5",""]],"verses":[["لا تَذكُروا الأَخلاقَ بَعدَ حِيادِكُم","فَمُصابُكُم وَمُصابُنا سِيّانِ",0,"ن",1,1],["لا تُذلهُ في سائِرِ الناسِ وَاِحفَظ","هُ فَما في خِيارِهِم مِن خَيرِ",1,"ر",1,0],["لا تذكر المرآة فيما رأت","حسناً كهذا حل في خدر",2,"ر",1,0],["لا تَذكُروا حُلَلَ المُلوكِ فَإِنَّكُم","بَعدَ الزُبَيرِ كَحائِضٍ لَم تُغسَلِ",3,"ل",1,0],["لا تَذكُرَنَّ إِذا ما كُنتَ مُفتَخِراً","أَبا كُثَيبَةَ قَد أَسرَفتَ في الحُمُقِ",4,"ق",1,0],["لا تذكروا معن بن زائدة لدى","قاضي القضاة ولا لهاهُ الجائده",5,"ه",1,1],["لا تذكرنَّ بحاراً عند أنعمه","إنَّ البحار لدى نعمائه برَك",6,"ك",1,0],["لا تذكري أحواض مص","ر فأنت دون المقلتين",7,"ن",1,0],["لا تذوقُ المنامَ إلا غِراراً","حسرتي فيه غيرُ ما معسولهْ",8,"ل",2,0],["لا تَذكُروهُم لي وَإِن سَأَلوا","لا تَذكُروني عِندَهُم أَبَدا",9,"د",2,0],["لا تَذكُرَنَّ لِيَّ الحَنّانَ وَما جَرى","مَجراهُ إِنّي قَد قَتَلتُ حَناني",10,"ن",2,0],["لا تذم المضل للشك فيه","فلعل المضلّ للناس هاد",11,"د",1,0],["لا تذمن المقا","دير واذمم خطلك",12,"ك",1,0],["لا تذكر الصبر في مصاب","تجاوز الصبر والعزاء",13,"ا",2,0],["لا تذكرنّ الحرب أو أهوالها","إلا بقلب خاشع يتوجع",14,"ع",1,0],["لا تَذهَبَنَّ عَلى الذُكورِ بِحَسرَةٍ","الذِكرُ نِعمَ سُلالَةُ العُظَماءِ",15,"ا",2,0],["لا تذكرنَّ ليَ السنينَ وعدها","العمرُ يقدرُ بالفعالِ النابِهِ",16,"ب",2,0],["لا تُذيلَن صَغيرَ هَمِّكَ وَاِنظُر","كَم بِذي الأَثلِ دَوحَةً مِن قَضيبِ",17,"ب",1,0],["لا تَذُمَّ اللَّئِيمَ وَامْدَحْ كَرِيماً","إِنَّ مَدْحَ الْكَرِيمِ ذَمُّ اللَّئِيمِ",18,"م",1,0],["لا تذلي على هواكِ عنادي","للأعادي أما الوزيرُ نصيري",19,"ر",2,0],["لا تَذهَبَنّ مَعَ العَواصِفِ وَاِجتَنِب","هَبَواتِ هَذا الحادِثِ المُتَنَمِّرِ",20,"ر",1,0],["لا تَذكُروا ما مَضى مِن أَمرِكُم وَدَعوا","ما جَرَّ بِالأَمسِ حُكمُ الفَردِ أَو جَلَبا",21,"ب",2,0],["لا تَذكُرِي الكَبِدَ التي مَارَسْتِها","فَأَبَتْ عَليكِ لعلّها تَنساكِ",22,"ك",1,0],["لا تذرفي الدّمعَ على راحلٍ","في اللّهِ لولا اللَّهُ لم يرحل",23,"ل",1,0],["لا تذكروا الدمَ إنّ السيفَ مُنصلِتٌ","في كفِّ أبيضَ يُدمِي البِيضَ والأسلا",24,"ل",2,0],["لا تَذكُرِيني لِأَعداءٍ لَو أَنَّهُمُ","مِن بُغضِنا أُطعِمُوا الحِمى إذن طَعِمُوا",25,"م",3,0],["لا تُذَكِّر بِوَصلِكَ ال","هَجرَ ما دامَ قَد عَقَل",26,"ل",1,0],["لا تَذكُرَنّي بِالصُبوحِ وَعاطِني","كَأسَ المُدامَةِ عِندَ كُلِّ مَساءِ",27,"ا",2,0],["لا تَذْكُروا الكتبَ السَّوالِفَ عندَهُ","طَلَعَ النَّهارُ فأَطْفِئُوا القِنْدِيلا",28,"ل",2,0],["لا تُذَكِّر بِنَفسِكَ ال","مَوتَ ما دامَ غافِلا",29,"ل",2,0],["لا تَذهَلَنَّ عَنِ اِبنَةِ الكَرمِ","فَبِها تَماسُكُ قُوَّةِ الجِسمِ",30,"م",1,1],["لا تَذكُري ما مَضى وَشَأنَكِ بي ال","يَومَ فَإِنَّ الزَمانَ يَنقَلِبُ",31,"ب",1,0],["لا تُذهِبِ الوَجدَ في إيثارِ وَجدِهِمُ","فَإِنَّ ذَمَّكَ بَينَ الإِنسِ مَوجودُ",32,"د",1,0],["لا تذيلي الدموع حزنا عليا","واسمحي ان اكون وحدي شقيا",33,"ي",2,1],["لا تَذهَبَن في الأمورِ فَرطا","وكُن مِن الناسِ جَميعاً وَسطا",34,"ط",2,1],["لا تَذكُروهُ فَتُريقوا دَمي","وَتَنثُروا مِن أَدمُعي سِمطا",35,"ط",2,0],["لا تَذَر عَبدَكَ يَتبع","شَهَواتِ النَفسِ سَهوا",36,"و",2,0],["لا تذودي بعضنا عن وِردهِ","كلُّنا يشكو الجوى والبُرَحاءْ",37,"ا",2,0],["لاَ تَذْكُرُوا نَارَ الصَّوَاعِقِ عِنْدَهَا","نَارُ الصَّوَاعِقِ عِنْدَهَا كذُبَالِ",38,"ل",1,0],["لا تُذهِبُ الأحزانَ آ","هاتُ التوجُّع والأنين!",39,"ن",1,0],["لا تذهب الحادثاتُ فِطنتهُ","إن هي طاشت بفطنَةِ الفَطِنِ",40,"ن",1,0],["لا تذكُرُوا خَطَأَ الماضي وحَوْبتَهُ","ما كان من خطإ فالله غافره",41,"ر",2,0],["لا تذكروا مجدِ الأوا","ئلِ، واذكروا عمَلَ الأواخر",42,"ر",1,0],["لا تذكّر \" أبا العلا \" إنّ جيل اليو","م أضرى من جيل أمس وأغبى",43,"ب",2,0],["لا تذوّق صراحتي فهي مرّ","إنّما من تذوق المرّ ذاقا",44,"ق",2,0],["لا تُذِلْ عهدَ \" الرجولات \" التي","تكرهُ الضَعْفَ . وتأبى الانحِلالا",45,"ل",2,0],["لا تذكرني الهنا يشجو الحشا","ذكره إني ألفت الشَّجنا",46,"ن",2,0],["لا تَذَرني فَدتك روحي فَريدا","أَشتَكي غُربة تُسيء الصَديقا",47,"ق",2,0],["لا تذهبن إلى معان فما بها","من واضح النشوات غير ظنون",48,"ن",1,0],["لا تذممنّ بيوتاً خفّ محملها","وتمدحنّ بيوت الطين والحجر",49,"ر",1,0],["لا تذكروهم فلستم في طريقهم","هيهات أين الثريا من ثرى الترب",50,"ب",1,0],["لا تذو بالصد عنه مهجةً ظمئت","العيد للروح مثل الماء للعود",51,"د",1,0],["لا تذكروني ولا يخطر لكم أبداً","أني سأذكركم في ليلة العيد",51,"د",1,0],["لا تذكروا كيف كنا تلك آونةٌ","جهلت فيها وللأقدار أرصاد",52,"د",1,0],["لا تذكروا البحر نمضي في غواربه","والبحر يطغيه إرغاءٌ وإزباد",52,"د",1,0],["لا تذكروا الليلة الأولى وقد عريَت","عند التعانق أرواح وأجساد",52,"د",1,0],["لا تذكروها فإني لست أذكرها","مضت على عصفها بالقلب آماد",52,"د",1,0],["لا تَذودي بَعضَنا عن وِردهِ","دونَ بعضٍ واعدلي بين الظِماء",53,"ا",2,0],["لا تذكِّره بالجميل فما كا","ن لفعل الجميل يوماً بناسِ",54,"س",1,0],["لاتذرني في انتظار","قاتل، ابعث جوابا",55,"ب",2,0],["لا تذكروا الظاعنين عندي","فَلي وَللظاعنين شان",56,"ن",1,0],["لا تَذْكُرَنَّ لَهُ الْمَكارِمَ وَالعُلى","فَتَهِيجَ صَبّاً أَوْ تَشُوقَ مُشَوَّقا",57,"ق",2,0],["لا تذكرنَّ بِسوءٍ من نظرت بِهِ","عَيباً فَما أَنتَ مَعصوم مِن الزَلَلِ",58,"ل",1,1],["لا تذممنْ من جاء يجهل كُنهَهُ","إذ كان فيما بين كيف ولعل",59,"ل",1,0],["لا تذهَلَنَّ فإِنَّ أمرَكَ واضحٌ","إذ تَمَّ ذاك بمَريمَ العَذراءِ",60,"ا",2,0],["لا تذعهُ وَاِن وَثَق","تَ لِمَن يَكتُم الخَبَر",61,"ر",1,0],["لا تُذكروني تَجَنِّيهِ وهَجْرَتَهِ","فحبُّه شَاغِلٌ عن كلِّ ما سَلَفَا",62,"ف",2,0],["لا تذكر الناسَ في شيءٍ إذا ذكروا","كاليمِّ يقذف بالأَلواح والدسر",63,"ر",1,0],["لا تذهبنَّ بك المذاهب غرّة","آرام ذيَّاك الحمى وظباؤه",64,"ا",3,0],["لا تذقني طعم الملام فإن كن","ت مذيقا فأنت غير شفيق",65,"ق",1,0],["لا تذكري منه خلقا لا ولا خُلقا","لكي تقري عيوناً بعد طُول عنا",66,"ن",2,0],["لا تذكروا لي غيرهم في حضرتي","إني بذكر سواهمُ أتقيّأ",67,"ا",1,0],["لا تذهبوا بفؤاد من عاهدتموا","هذا مقام المستجير العائذ",68,"ذ",1,0],["لا تذخر الأنزرَ تضطرّ له","ولا تَضنُّ ما وجدتَ الأنفَسا",69,"س",2,0],["لا تذهبنَّ اليومَ في ذِلةٍ","فاليومُ من عُمرك محسوبُ",70,"ب",1,0],["لا تذكُرنَّ عُكاظاً وابن ساعِدَةٍ","ويطَّبيكَ مقالُ القَرْمِ سحْبانُ",71,"ن",1,0],["لا تَذخَرِ المالَ دونَ الحَمدِ مُعتَقِداً","أَن لَيسَ يُخلِفُهُ إِن ضاعَ صاحِبُهُ",72,"ه",1,1],["لا تذمّيه فالمشيبُ على طو","ل بقاءِ الفتى يكون دليلا",73,"ل",2,0],["لا تذكروا الغزلان عند لحظاتها","أبدا فكل الصيد في جوف الغرا",74,"ر",2,0],["لا تذكر اللهو بعد اليوم والطربا","ولا تصف كف ساق بالطلا اختضبا",75,"ب",2,1],["لا تذكري لوعةً إثري ولا جزعا","ولا تقاسن بعدي الهم والهلعا",76,"ع",2,1],["لا تَذكُري الماضيَ ماذا بِهِ","هَل ذُقتُ في حَبِّكِ إِلّا العَذابْ",77,"ب",1,0],["لا تُذهِبي رَيعَانَهُ في وَقفَةٍ","إِمّا لِهَجرٍ أَو لِقَولِ الزَّاجِرِ",78,"ر",1,0],["لا تُذرِ إِلّا أَدمُعا مَعدودةً","فَالبِرُّ أَصدَقُ أن يُقيمَ دَليلا",79,"ل",2,0],["لا تَذْرني من الكآبة والوَجْ","دِ إلهي أهيم فرداً خليّا",80,"ي",2,0],["لا تذهل العَين مِن آثار صَنَعتهم","فَلا نَراها سِوى ضَربٍ مِن اللَعبِ",81,"ب",1,0],["لا تذكر الدين لهم بين الورى","فالدين إن ذكرته قالوا انخلي",82,"ي",1,0],["لا تذكر القرب ان القرب فيه على","بعد الديار مقاييس واشباه",83,"ا",2,0],["لا تذكريني فإن الذكر يرجع لي","عادات وجدي في أيامي الأول",84,"ل",1,1],["لا تَذكرنَّ حَقا","عَلَيهم فَتَشقى",85,"ق",2,0],["لا تذر الأيام تطوي طيها","تختبط الكلا وتعثو في الحمى",86,"ا",1,0],["لا تذرني يا خالقي غرض البل","وى احطني من كل كيد وختل",87,"ل",1,0],["لا تذكرِ البين فإنَّ ال","حَديثَ فيه من الحوادث",88,"ث",1,0],["لا تذكر البحر يوما عند راحته","ذت الندى فهو منسوب إلى الملق",89,"ق",1,0],["لا تذبحي هذا الغزال لنا قرىً","فلكم تقتِّل بعضها الغزلان",90,"ن",1,0],["لا تَذهَبي يا نَفسُ وَيحَكِ حَسرَةً","فَالناسُ مَعدولٌ بِهِ وَمُشَرَّدُ",91,"د",1,0],["لا تَذع سراً إِلى طالِبِه","مِنكَ إِنَّ الطالِبَ السر مُذيع",92,"ع",1,1],["لا تُذنِبِي الرَجُلَ الغَرِيبَ عَلى النَوى","فَالذَنبُ ذَنبُ غُرابِكِ النَعّابِ",93,"ب",1,0],["لا تذكري فرسي وما اطعمتهُ","فيكونَ لونُكِ مثل لونِ الأجربِ",94,"ب",1,0],["لا تذقني صدّاً وبُعداً وسُهْداً","وتغيّر يا مهجتي ألواني",95,"ن",2,0],["لا تذكروه بالذي تنظروا","فالفرعُ يُعطي قوّةَ النجر",96,"ر",1,0],["لا تذمنّ الهوى يا عاذلي","إنما للمرء فيه ما نوى",97,"و",2,0],["لا تذرفي تلك الدّموعَ لأنني","لا أستحقّ الحبّ والإعجابا",98,"ب",2,1],["لا تذكرني زمَاناً باللِّوى","فاتَ عنّي عيشهُ فانصَرَما",99,"م",2,0],["لا تذكروا لي سوى حبيبي","دع عنك هندا