{"poems":[[86,"لا تذكروا الأخلاق بعد حيادكم","https://www.aldiwan.net/poem10518.html","الكامل"],[71,"يا ابن إدريس لفظك الأنجم الزهر","https://www.aldiwan.net/poem3936.html","الخفيف"],[93,"يا بالغ التسعين من عمره","https://www.aldiwan.net/poem9841.html","السريع"],[27,"لمن الديار كأنها لم تحلل","https://www.aldiwan.net/poem5967.html","الكامل"],[23,"ما بال عينك لا ترقا مدامعها","https://www.aldiwan.net/poem21362.html","البسيط"],[72,"لا تذكروا معن بن زائدة لدى","https://www.aldiwan.net/poem18653.html","الكامل"],[72,"قالوا أمير فقال العدل بل ملك","https://www.aldiwan.net/poem19444.html","البسيط"],[72,"أجران حمام الشام","https://www.aldiwan.net/poem20479.html","مجزوء الكامل"],[51,"دع لباك رسومه وطلوله","https://www.aldiwan.net/poem65987.html","الخفيف"],[91,"قالت سكت وما سكت سدى","https://www.aldiwan.net/poem8813.html","عموديه"],[91,"مازال يمشي في الأمور بفكره","https://www.aldiwan.net/poem62771.html","عموديه"],[89,"هل لمن يرقدون في الالحاد","https://www.aldiwan.net/poem44644.html","الخفيف"],[89,"إن من قد جبلك","https://www.aldiwan.net/poem44848.html","مجزوء المديد"],[85,"شأنك والدمع والبكاء","https://www.aldiwan.net/poem7111.html","مخلع البسيط"],[85,"دع ما يضرك والتمس ما ينفع","https://www.aldiwan.net/poem7127.html","الكامل"],[85,"يا أيها الناعي أبا الوزراء","https://www.aldiwan.net/poem62939.html","الكامل"],[97,"قدم لبسيوني قريضك واعتذر","https://www.aldiwan.net/poem24384.html","الكامل"],[44,"أي مرعى عين ووادي نسيب","https://www.aldiwan.net/poem30586.html","الخفيف"],[87,"أيها الشاعر المجيد تدبر","https://www.aldiwan.net/poem8251.html","الخفيف"],[69,"أنا في الحب قانع باليسير","https://www.aldiwan.net/poem28994.html","الخفيف"],[105,"إني نظرت إلى الحوادث نظرة","https://www.aldiwan.net/poem43376.html","الكامل"],[105,"من يمنع الليث أن يعتز أو يثبا","https://www.aldiwan.net/poem43386.html","البسيط"],[105,"يا هند حسبك مغنما وكفاك","https://www.aldiwan.net/poem44042.html","الكامل"],[105,"سيري الهوينى دومة الجندل","https://www.aldiwan.net/poem44201.html","السريع"],[105,"ردوا بني قينقاع الأمر إذ نزلا","https://www.aldiwan.net/poem44215.html","البسيط"],[40,"حور بعثن رسولا في ملاطفة","https://www.aldiwan.net/poem42344.html","البسيط"],[52,"لا تعاتب إذا هويت","https://www.aldiwan.net/poem26742.html","مجزوء الخفيف"],[52,"داو الهموم بقهوة صفراء","https://www.aldiwan.net/poem27329.html","الكامل"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[48,"دع جنانا وحبها","https://www.aldiwan.net/poem64515.html","مجزوء الخفيف"],[48,"لا تذهلن عن ابنة الكرم","https://www.aldiwan.net/poem65117.html","الكامل"],[50,"عامت سليمى ومسها سغب","https://www.aldiwan.net/poem64838.html","المنسرح"],[46,"إن جاد بالمال سمح يبتغي شرفا","https://www.aldiwan.net/poem22390.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/86022","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30519","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43720","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43818","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54243","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54196","الكامل"],[106,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[106,"فلسفة الألم","https://www.poetsgate.com/ViewPoem.aspx?id=179662",""],[106,"شعب واحد ورب واحد","https://www.poetsgate.com/ViewPoem.aspx?id=179304",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[100,"لا تقل لي","https://www.poetsgate.com/ViewPoem.aspx?id=50110",""],[90,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[90,"جناية الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=178941",""]],"verses":[["لا تَذكُروا الأَخلاقَ بَعدَ حِيادِكُم","فَمُصابُكُم وَمُصابُنا سِيّانِ",0,"ن",1,1],["لا تُذلهُ في سائِرِ الناسِ وَاِحفَظ","هُ فَما في خِيارِهِم مِن خَيرِ",1,"ر",1,0],["لا تذكر المرآة فيما رأت","حسناً كهذا حل في خدر",2,"ر",1,0],["لا تَذكُروا حُلَلَ المُلوكِ فَإِنَّكُم","بَعدَ الزُبَيرِ كَحائِضٍ لَم تُغسَلِ",3,"ل",1,0],["لا تَذكُرَنَّ إِذا ما كُنتَ مُفتَخِراً","أَبا كُثَيبَةَ قَد أَسرَفتَ في الحُمُقِ",4,"ق",1,0],["لا تذكروا معن بن زائدة لدى","قاضي القضاة ولا لهاهُ الجائده",5,"ه",1,1],["لا تذكرنَّ بحاراً عند أنعمه","إنَّ البحار لدى نعمائه برَك",6,"ك",1,0],["لا تذكري أحواض مص","ر فأنت دون المقلتين",7,"ن",1,0],["لا تذوقُ المنامَ إلا غِراراً","حسرتي فيه غيرُ ما معسولهْ",8,"ل",2,0],["لا تَذكُروهُم لي وَإِن سَأَلوا","لا تَذكُروني عِندَهُم أَبَدا",9,"د",2,0],["لا تَذكُرَنَّ لِيَّ الحَنّانَ وَما جَرى","مَجراهُ إِنّي قَد قَتَلتُ حَناني",10,"ن",2,0],["لا تذم المضل للشك فيه","فلعل المضلّ للناس هاد",11,"د",1,0],["لا تذمن المقا","دير واذمم خطلك",12,"ك",1,0],["لا تذكر الصبر في مصاب","تجاوز الصبر والعزاء",13,"ا",2,0],["لا تذكرنّ الحرب أو أهوالها","إلا بقلب خاشع يتوجع",14,"ع",1,0],["لا تَذهَبَنَّ عَلى الذُكورِ بِحَسرَةٍ","الذِكرُ نِعمَ سُلالَةُ العُظَماءِ",15,"ا",2,0],["لا تذكرنَّ ليَ السنينَ وعدها","العمرُ يقدرُ بالفعالِ النابِهِ",16,"ب",2,0],["لا تُذيلَن صَغيرَ هَمِّكَ وَاِنظُر","كَم بِذي الأَثلِ دَوحَةً مِن قَضيبِ",17,"ب",1,0],["لا تَذُمَّ اللَّئِيمَ وَامْدَحْ كَرِيماً","إِنَّ مَدْحَ الْكَرِيمِ ذَمُّ اللَّئِيمِ",18,"م",1,0],["لا تذلي على هواكِ عنادي","للأعادي أما الوزيرُ نصيري",19,"ر",2,0],["لا تَذهَبَنّ مَعَ العَواصِفِ وَاِجتَنِب","هَبَواتِ هَذا الحادِثِ المُتَنَمِّرِ",20,"ر",1,0],["لا تَذكُروا ما مَضى مِن أَمرِكُم وَدَعوا","ما جَرَّ بِالأَمسِ حُكمُ الفَردِ أَو جَلَبا",21,"ب",2,0],["لا تَذكُرِي الكَبِدَ التي مَارَسْتِها","فَأَبَتْ عَليكِ لعلّها تَنساكِ",22,"ك",1,0],["لا تذرفي الدّمعَ على راحلٍ","في اللّهِ لولا اللَّهُ لم يرحل",23,"ل",1,0],["لا تذكروا الدمَ إنّ السيفَ مُنصلِتٌ","في كفِّ أبيضَ يُدمِي البِيضَ والأسلا",24,"ل",2,0],["لا تَذكُرِيني لِأَعداءٍ لَو أَنَّهُمُ","مِن بُغضِنا أُطعِمُوا الحِمى إذن طَعِمُوا",25,"م",3,0],["لا تُذَكِّر بِوَصلِكَ ال","هَجرَ ما دامَ قَد عَقَل",26,"ل",1,0],["لا تَذكُرَنّي بِالصُبوحِ وَعاطِني","كَأسَ المُدامَةِ عِندَ كُلِّ مَساءِ",27,"ا",2,0],["لا تَذْكُروا الكتبَ السَّوالِفَ عندَهُ","طَلَعَ النَّهارُ فأَطْفِئُوا القِنْدِيلا",28,"ل",2,0],["لا تُذَكِّر بِنَفسِكَ ال","مَوتَ ما دامَ غافِلا",29,"ل",2,0],["لا تَذهَلَنَّ عَنِ اِبنَةِ الكَرمِ","فَبِها تَماسُكُ قُوَّةِ الجِسمِ",30,"م",1,1],["لا تَذكُري ما مَضى وَشَأنَكِ بي ال","يَومَ فَإِنَّ الزَمانَ يَنقَلِبُ",31,"ب",1,0],["لا تُذهِبِ الوَجدَ في إيثارِ وَجدِهِمُ","فَإِنَّ ذَمَّكَ بَينَ الإِنسِ مَوجودُ",32,"د",1,0],["لا تذيلي الدموع حزنا عليا","واسمحي ان اكون وحدي شقيا",33,"ي",2,1],["لا تَذهَبَن في الأمورِ فَرطا","وكُن مِن الناسِ جَميعاً وَسطا",34,"ط",2,1],["لا تَذكُروهُ فَتُريقوا دَمي","وَتَنثُروا مِن أَدمُعي سِمطا",35,"ط",2,0],["لا تَذَر عَبدَكَ يَتبع","شَهَواتِ النَفسِ سَهوا",36,"و",2,0],["لا تذودي بعضنا عن وِردهِ","كلُّنا يشكو الجوى والبُرَحاءْ",37,"ا",2,0],["لاَ تَذْكُرُوا نَارَ الصَّوَاعِقِ عِنْدَهَا","نَارُ الصَّوَاعِقِ عِنْدَهَا كذُبَالِ",38,"ل",1,0],["لا تُذهِبُ الأحزانَ آ","هاتُ التوجُّع والأنين!",39,"ن",1,0],["لا تذهب الحادثاتُ فِطنتهُ","إن هي طاشت بفطنَةِ الفَطِنِ",40,"ن",1,0],["لا تذكُرُوا خَطَأَ الماضي وحَوْبتَهُ","ما كان من خطإ فالله غافره",41,"ر",2,0],["لا تذكروا مجدِ الأوا","ئلِ، واذكروا عمَلَ الأواخر",42,"ر",1,0],["لا تذوّق صراحتي فهي مرّ","إنّما من تذوق المرّ ذاقا",43,"ق",2,0],["لا تُذِلْ عهدَ \" الرجولات \" التي","تكرهُ الضَعْفَ . وتأبى الانحِلالا",44,"ل",2,0],["لا تذكرني الهنا يشجو الحشا","ذكره إني ألفت الشَّجنا",45,"ن",2,0]]}