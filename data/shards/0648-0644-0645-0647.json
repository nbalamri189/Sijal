{"poems":[[47,"أطاع عاذله في الحب إذ نصحا","https://www.aldiwan.net/poem62687.html","البسيط"],[47,"هزيع دجا في الرأس بادره بدر","https://www.aldiwan.net/poem64537.html","الطويل"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[354,"عجبي لرقة وجه كلفي به","https://www.aldiwan.net/poem15653.html","الكامل"],[371,"داء ولكنه داء بلا ألم","https://www.aldiwan.net/poem17721.html","البسيط"],[438,"لم يشف طيفك لما زارني ألما","https://www.aldiwan.net/poem12372.html","البسيط"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67828","الطويل"],[1266,"","https://poetry.dctabudhabi.ae/diwan/poem/198695",""],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123922","الكامل"],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577049",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""]],"verses":[["وَلِمَّةٍ كُنتُ مَشغوفاً بِجِدَّتِها","فَما عَفا الشَيبُ لي عَنها وَلا صَفَحا",0,"ح",2,0],["وَلِمَّةُ مُشتاقٍ أَلَمَّ مَشيبُها","عَلى حينِ لَم يودِ الشَبابُ وَلا العُمرُ",1,"ر",1,0],["ولمُّ هَذا الحكم","لم يقترن بعلِمِ",2,"م",1,0],["وَلِمُهجَتي تُذكى لِبَردِ رِضابِهِ","وَتَقِرُّ عَيني أَن تُشاهِدَ نارَهُ",3,"ه",1,0],["وَلِمَّةٍ لَم يُوَفِّ الدَهرُ ذِمَّتَها","هَل يُعرَفُ الدَهرُ في الموفينَ بِالذِمَمِ",4,"م",1,0],["ولِمَّةٌ مُذْ هَفَتْ منها مُلِمَّتُهُ","عادَتْ رماداً وكانِتْ قَبْلَهُ فَحَما",5,"م",2,0],["وَلِمْ هَجَرُوا مَنْ لَمْ يُخَالِفْ مُرَادَهُمْ","فَيَا عَادِلاً لَوْ أنَّ عَدْلي أَفَادَهُمْ",6,"م",1,0],["ولمةٍ أسبلت أثيثاً","كأنه وابل معطر",7,"ر",1,0],["ولمهجتي بولاكم الحسنى إذا","فقدت غداً بصحيفتي حسناتها",8,"ت",3,0],["وَلم هداك اللَه يا طارش النَوى","عَلى هيزعية وَالطَريق أَمان",9,"ن",1,0],["وَلم هداك اللَه يا طارش النيا","وَانسف عَلى ظَهر الظَليم وَسار",10,"ر",1,0],["وَلم هداك اللَه يا طارش النَوا","عا هفهوفة طراشها حيلونها",11,"ن",3,0],["وَلم هداك اللَه وَأحذر من البَطا","عا هفهوفة تَجري مُدير غَزالها",12,"ل",3,0]]}