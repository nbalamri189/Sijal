{"poems":[[45,"أطاع عاذله في الحب إذ نصحا","https://www.aldiwan.net/poem62687.html","البسيط"],[45,"هزيع دجا في الرأس بادره بدر","https://www.aldiwan.net/poem64537.html","الطويل"],[295,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[347,"عجبي لرقة وجه كلفي به","https://www.aldiwan.net/poem15653.html","الكامل"],[364,"داء ولكنه داء بلا ألم","https://www.aldiwan.net/poem17721.html","البسيط"],[429,"لم يشف طيفك لما زارني ألما","https://www.aldiwan.net/poem12372.html","البسيط"]],"verses":[["وَلِمَّةٍ كُنتُ مَشغوفاً بِجِدَّتِها","فَما عَفا الشَيبُ لي عَنها وَلا صَفَحا",0,"ح",2,0],["وَلِمَّةُ مُشتاقٍ أَلَمَّ مَشيبُها","عَلى حينِ لَم يودِ الشَبابُ وَلا العُمرُ",1,"ر",1,0],["ولمُّ هَذا الحكم","لم يقترن بعلِمِ",2,"م",1,0],["وَلِمُهجَتي تُذكى لِبَردِ رِضابِهِ","وَتَقِرُّ عَيني أَن تُشاهِدَ نارَهُ",3,"ه",1,0],["وَلِمَّةٍ لَم يُوَفِّ الدَهرُ ذِمَّتَها","هَل يُعرَفُ الدَهرُ في الموفينَ بِالذِمَمِ",4,"م",1,0],["ولِمَّةٌ مُذْ هَفَتْ منها مُلِمَّتُهُ","عادَتْ رماداً وكانِتْ قَبْلَهُ فَحَما",5,"م",2,0]]}