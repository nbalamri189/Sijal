{"poems":[[55,"أبلغا عني الحسين ألوكا","https://www.aldiwan.net/poem30639.html","الخفيف"],[79,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[95,"يا جنة أهدت إلي سلاما","https://www.aldiwan.net/poem11299.html","الكامل"],[53,"لا تقصدن لحاجة","https://www.aldiwan.net/poem64582.html","مجزوء الكامل"],[87,"نزل المناهل والربى آذار","https://www.aldiwan.net/poem7051.html","الكامل"],[87,"ساجع الشرق طار عن أوكاره","https://www.aldiwan.net/poem62880.html","الخفيف"],[50,"اسقنيها يا نديمي بغلس","https://www.aldiwan.net/poem63436.html","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54690","الخفيف"],[79,"ما على القلب بعدكم من جناح","https://www.poetsgate.com/ViewPoem.aspx?id=33823",""],[264,"الشدة عنوان الفرج","https://www.aldiwan.net/poem35545.html","المتدارك"],[266,"إنا لتقتلنا العيون","https://www.aldiwan.net/poem38164.html","مجزوء الكامل"],[275,"أفدي التي حكت الصباح تبلجا","https://www.aldiwan.net/poem35337.html","الكامل"],[280,"أسرف الدهر فهلا قصدا","https://www.aldiwan.net/poem25585.html","الرمل"],[354,"زعموا أن كل من أعمل الرأي","https://www.aldiwan.net/poem15513.html","الخفيف"],[354,"قلت عندي وعندكم عمن","https://www.aldiwan.net/poem15773.html","الخفيف"],[369,"أنت للعيد وهو للناس عيد","https://www.aldiwan.net/poem60931.html","الخفيف"],[376,"قلت لما أن شبهوك وقاسوا","https://www.aldiwan.net/poem57524.html","البسيط"],[463,"مل معي لا عليك ضري ونفعي","https://www.aldiwan.net/poem56120.html","الخفيف"],[463,"أنذرتني أم سعد أن سعدا","https://www.aldiwan.net/poem56214.html","الرمل"],[540,"عاقني عنك توالي المطر","https://www.aldiwan.net/poem4122.html","الرمل"],[556,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[563,"طلعت شمس الوجود","https://www.aldiwan.net/poem34655.html","مجزوء الرمل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126765","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86972","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63944","الخفيف"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122064","الخفيف"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/78012","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114749","الخفيف"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109296","الرمل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126233","الكامل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130834",""],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117984","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117949","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111450","الخفيف"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33064","المديد"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81925","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72787","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120506","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120434","المديد"],[4816,"ليالي السعد","https://www.poetsgate.com/ViewPoem.aspx?id=8470",""],[5026,"منبطحون على رصيف الرؤى","https://www.poetsgate.com/ViewPoem.aspx?id=211278",""],[5136,"يا بروحي المدلل البتاه","https://www.poetsgate.com/ViewPoem.aspx?id=121772",""],[5320,"فيتنام","https://www.poetsgate.com/ViewPoem.aspx?id=42916",""],[4623,"إني بحبل الحب فيك مقيد ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146853",""],[4623,"أتسرك الدنيا وعمرك ذاهب ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146604",""],[6031,"لا أَلَمَّتْ بِجِسْمِكَ الآلاَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=46359",""]],"verses":[["وَعَلّى ذَلِكَ الزَمانِ بِهِم عا","دَ غُلاماً مِن بَعدِ ما كانَ شاخا",0,"خ",2,0],["وعلى ذاكَ فهْيَ ساحِرَةُ الأحْ","داق تُزْري بكلِّ خَوْدٍ رَداحِ",1,"ح",1,0],["وَعَلَى ذُرَاكِ مِنَ الصُّنُوبَرِ غَابَةٌ","تُحْيِي النُّفُوسَ وَتُبْرِيءُ الأَسْقَامَا",2,"م",2,0],["وعلى ذوي عاهاتهم","يوم يدمرهم بِنحسه",3,"س",2,0],["وعلى ذؤابة كل غصن قينة","الصَّنج خلف بنانها والطار",4,"ر",1,0],["وَعَلى ذاهِبٍ مِنَ العَيشِ وَلَّي","تَ فَوَلّى الأَخيرُ مِن أَوطارِهِ",5,"ر",2,0],["وَعَلى ذِكرِ حَبيبي فَاِسقِني","لا عَلى ذِكرِ مَحَلٍّ قَد دَرَس",6,"س",1,0],["وَعَلى ذَاك تَغَابَتْ مَرَّة","بعْدَ أُخْرَى وَتَمَادَى مُسْتَشِرَّا",7,"ر",2,0],["وَعَلَى ذِهْنِهِ الْخُلُو","صُ بِمَا شَاءَهُ فَتَحْ",8,"ح",1,0],["وعلى ذلك فهي ساحرة الأحداق","تزري بكل خود رداح",9,"ح",1,0],["وعلى ذاك المحيا فعُجِ","ما خاب عُبيدٌ قد طرقا",10,"ق",2,0],["وعلى ذوي القربى لنا","تقضى بمظلمة ديون",11,"ن",1,0],["وعلى ذُؤابتِها نثرتُ مدامِعي","حيناً كتنثير النجوم على الدجى",12,"ج",2,0],["وعَلى ذلِكَ يا نَفْسُ فَلا","تَيْأَسي إنّ مَعَ اليَوم غَدا",13,"د",2,0],["وَعَلى ذا فَكُلُّ مُجتَهِدٍ أَخطا بِعَينِ","الخَطا أَصابَ الصَوابا",14,"ب",2,0],["وَعَلى ذا فَكُلُّ مُنفَرِدٍ مِنكَم","بِقَولٍ مُخالِفٌ لِلجَماعَه",15,"ع",2,0],["وعلى ذاك فاغتنِمْه نزيلاً","فهْو بينَ الأنامِ يومٌ جَديد",16,"د",1,0],["وعلى ذكر ذا وذاك فلِلجا","لبِ عندي شكرٌ على المجلوبِ",17,"ب",1,0],["وعلى ذكره جرى باسمه المح","فوظُ من عهد أهله والمرعي",18,"ع",2,0],["وعلى ذي نظرةٍ غائرةٍ","بعثتْ سُقماً إلى القلب تعدَّى",19,"د",2,0],["وعلى ذاك فإن أرسلتَ لي","سابحاً خُضت بذاك البَحر",20,"ر",1,0],["وعلى ذا مضى الزّمانُ فحيٌّ","غيرُ ساهٍ وميّتٌ غيرُ داعِ",21,"ع",1,0],["وعلى ذاتي إقبا","لي كما عني صدودي",22,"د",2,0],["وَعَلى ذُرى العلياء ضَع قَدماً","فلكَ العلى والمجد والفخرُ",23,"ر",1,0],["وَعَلى ذَلِكَ اِستَعان بِشَهم","وافر الحَزم بِالرعية يَرأف",24,"ف",1,0],["وعلى ذا فإِنَّ بي من عِضاضِ الد","هر ما شيت من صنوف العضاض",25,"ض",1,0],["وَعَلَى ذَاكَ سَالَ مَاءُ دُمُوعِي","فَطَغَى ما ثَنَى لِلَوْمِي طَغَامَا",26,"م",2,0],["وعلى ذوي الأسباب مفترض","ترك الحرام بواجب الأمر",27,"ر",1,0],["وعلى ذاكَ فالرَّجاءُ مُقِيمٌ","ما تَراخَت عنّي وعنهُ غُلوقُ",28,"ق",1,0],["وعلى ذكر الجبين الكوكبي","عاطنيها يا بن ام البصر",29,"ر",1,0],["وعلى ذُنُوبى قد غَدَوتُ نادِماً","ولقد رَجَوتُك أن تكُن لِى راحِماً",30,"م",2,0],["وعلى ذرى الجو المقدس قبةٌ","رفعت بلا عمدٍ ولا ارجاء",31,"ا",2,0],["وعلى ذكر من نحب شربنا","ما براح الأفراح يا صاح مأثم",32,"م",1,0],["وعلى ذويه لنشره وبيانه","أخذت عهود اللّه والميثاق",33,"ق",1,0],["وَعَلى ذا بالثَّدي مَدَّ قَناهُ","فَرَماهُ ثُمَّ انثَنى لِسَواهُ",34,"ه",1,0],["وَعَلَيَّ ذو المَعالي أَبوهُم","كَرُمَ السامي بِهِ وَالمُدِلُّ",35,"ل",1,0],["وعلي ذو الثقلين ثم محمد","والصادق الأواب بالإحسان",36,"ن",1,0],["وعلى ذرى كيوانَ من أوجِ العلى","كالصبح تُشرقُ فيهِ سبع أقالم",37,"م",1,0],["وعلى ذكر أربع ليس يرقا","فغرامي مستحكم ليس يرقى",38,"ق",2,0],["وعلى ذاك دليل يرى","وهو دمع العين ينسجم",39,"م",1,0],["وعلى ذا الحال يا مضنون مجدر","ولو حبك بمجرى الدم مدى",40,"د",2,0],["وعلى ذراعِ الغَمِّ يَتّكأ العماءُ","..معيْ وهُمْ يتَقَمَّصُونَ صَبابَه",41,"ب",2,0],["وعلى ذاك آية حمرة الثغر","وأنعاسه ولون لماه",42,"ا",2,0],["وعلى ذوى الجبل المخضب بالدما","طاب الهبوط له فاطلق أرغنا",43,"ن",2,0],["وعلى ذويك ذوي الكمال تحية","طول الدوام عليهم تتجدد",44,"د",1,0],["وعلى ذويك ومن يواليهم ومن","هو بالثناء على علاك مواظب",45,"ب",1,0],["وعلَى ذَا وذَا فَزارَاكَ أنَّى","كُنْتَ عَنَّا تحيَّةٌ وسَلاَمُ",46,"م",1,0]]}