.html","الطويل"],[67,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[75,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[48,"قد أغتدي في فلق الإصباح","https://www.aldiwan.net/poem62541.html","الرجز"],[48,"هل لديار حييتها درس","https://www.aldiwan.net/poem64333.html","المنسرح"],[50,"إذا سلم المسكين طار فؤاده","https://www.aldiwan.net/poem24559.html","الطويل"],[50,"تجاللت عن فهر وعن جارتي فهر","https://www.aldiwan.net/poem63803.html","الطويل"],[50,"ألا طرقت موهنا مهدد","https://www.aldiwan.net/poem63884.html","الوافر"],[50,"يا طلل الحي بذات الصمد","https://www.aldiwan.net/poem63943.html","الرجز"],[50,"صحا تربي وما قلبي بصاح","https://www.aldiwan.net/poem63977.html","الوافر"],[50,"أجارتنا ما بالهوان خفاء","https://www.aldiwan.net/poem64883.html","الطويل"],[46,"سحائب مبرقات مرعدات","https://www.aldiwan.net/poem22152.html","الوافر"],[46,"إذا سكت الإنسان قلت خصومه","https://www.aldiwan.net/poem22190.html","الطويل"],[46,"تعالى الله ما تلقى المطايا","https://www.aldiwan.net/poem22410.html","الوافر"],[46,"إذا سنة بكى تشرين فيها","https://www.aldiwan.net/poem22556.html","الوافر"],[46,"إذا سعد البازي البعيد مغاره","https://www.aldiwan.net/poem22650.html","الطويل"],[46,"يكاد المشيب ينادي الغوي","https://www.aldiwan.net/poem22885.html","المتقارب"],[46,"إذا سلقت عرس الفتى في كلامها","https://www.aldiwan.net/poem23033.html","الطويل"],[46,"دع الناس واصحب وحش بيداء قفرة","https://www.aldiwan.net/poem23066.html","الطويل"],[46,"إذا سخطت روح الفتى فليقل لها","https://www.aldiwan.net/poem23335.html","الطويل"],[46,"ليبك مسن ثم أجله","https://www.aldiwan.net/poem23556.html","الطويل"],[46,"سمعت نعيها صما صمام","https://www.aldiwan.net/poem23631.html","الكامل"],[46,"أعن وخد القلاص كشفت حالا","https://www.aldiwan.net/poem23633.html","الوافر"],[46,"معان من أحبتنا معان","https://www.aldiwan.net/poem23635.html","الوافر"],[19,"صحا قلبه عن سُكره فتأملا","https://www.aldiwan.net/poem356.html",""],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[76,"ألما على قصر الخليفة فانظرا","https://www.aldiwan.net/poem39323.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85589","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85554","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85314","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85552","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141014",""],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140987",""],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72229","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16701","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16696","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16654","الوافر"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16635","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/1691","الطويل"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10976","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42508","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42602","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42667","المتقارب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42567","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42607","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42530","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42701","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54752","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54562","المتقارب"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116987","المتقارب"],[106,"صحا الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179625",""],[106,"ذكرى شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179690",""],[106,"نيسان","https://www.poetsgate.com/ViewPoem.aspx?id=179310",""],[106,"كلب بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179351",""],[100,"مروءات العدو","https://www.poetsgate.com/ViewPoem.aspx?id=50193",""],[90,"عاشوراء","https://www.poetsgate.com/ViewPoem.aspx?id=179150",""],[45,"تَقَضّى الصّبَا، إلاّ تَلَوّمَ رَاحِلِ","https://www.poetsgate.com/ViewPoem.aspx?id=32195",""],[45,"سَقَى رَبْعَها سَحُّ السّحابِ وَهَاطِلُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31871",""],[28,"وأغيد من من النعاس بعظمه","https://www.poetsgate.com/ViewPoem.aspx?id=22089",""],[28,"رأيت بني حنيفة يوم لاقوا","https://www.poetsgate.com/ViewPoem.aspx?id=22106",""],[38,"ألم تسألْ بعارمة َ الدّيارا","https://www.poetsgate.com/ViewPoem.aspx?id=21198",""],[87,"وَذِى نَعَرَاتٍ يَقْطَعُ الأَرْضَ سَارياً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24034&r=&rc=296",""]],"verses":[["إِذا سَكِرَ العَسالُ مِن قَطَراتِها","سَقَيتُ حُمَيّاها أَغَرُّ يَماني",0,"ي",1,0],["إِذا ساوَمَنا الضَيمُ","عَلى الأَعراضِ غالينا",1,"ن",2,0],["إِذا سارَ صُبحاً طارَدَ الشَمسَ نَقعُه","وَإِن سارَ لَيلاً طَبَّقَ الأَرضَ دَهمُهُ",2,"م",2,0],["إِذا سارَ فَالشَمسُ مَستورَةٌ","وَوَجهُ الثَرى بارِزُ الخَدِّ دامِ",3,"م",1,0],["إِذا سَما فَإِلى العَلياءِ نَهضَتُهُ","وَإِن مَشى فَعَلى الأَعناقِ وَالقِمَمِ",4,"م",1,0],["إِذا سَلَكَ العُلى سَلِمَت قُواهُ","فَلا جَزَعٌ إِذا اِنتَقَصَ النِظامُ",5,"م",1,0],["إِذا سَلِموا فَقَد سَلِمَ البَرايا","وَإِن نُقِذوا فَقَد فُقِدَ الأَنامُ",5,"م",1,0],["إِذا سالَموا لَم يَمنَعوا النَصفَ طالِباً","وَإِن طاعَنوا الأَقرانَ لَم يَعرِفوا العَدلا",6,"ل",2,0],["إِذا سَطَّرَت نَهراً وَراءَ بُيوتِها","سَطَوتُ وَما يُعدي عَلَيَّ قَبيلُ",7,"ل",1,0],["إِذا سَمَحَت يَوماً بِمَجواءَ سَجسَجٍ","تَلَتها عَلى عَمدٍ بِنَكباءَ زَعزَعِ",8,"ع",1,0],["إِذا سُؤِلوا لَم يُتبَعوا المالَ وَجمَةً","وَلَم يَدفَعوا في صَفحَةِ الحَقِّ بِالعُذرِ",9,"ر",1,0],["إِذا سالَت عَواليهِ بِحَتفٍ","فَليسَ لَها سِوى قَلبٍ قَرارُ",10,"ر",1,0],["إِذا سَتَرَ النَقعُ آثارَها","هَتَكنَ الضَمائِرَ عَن كُلِّ ثارِ",11,"ر",1,0],["إِذا سالَمَ المَوتُ نَفسَيكُما","فَلا حارَبَ الدَهرُ إِلّا اليَسارا",12,"ر",2,0],["إِذا سَمَحَت بِالمَوتِ نَفسي فَإِنَّهُ","يَقِلُّ اِحتِفالي بِالَّذي جَرَّ ميتَتي",13,"ي",1,0],["إِذا سُئِلَ اِنهالَ النَدى مِن بَنانِهِ","كَما اِنهالَ أَذيالُ النَقا مِن كَثيبِهِ",14,"ب",2,0],["إِذا سُمنَهُ خَسفاً تَلَظّى جِماحُهُ","فأَجلَينَ عَن قِرنٍ أَلَدَّ مُشاحِنِ",15,"ن",1,0],["إِذا سَحَبَتْ أَذيالَها في عِراصِهِ","وَجَدتُ ثَرى تِلكَ الرِّباعِ يَطيبُ",16,"ب",1,0],["إذا سارَ في الأرضِ الفَضاءِ بجَحْفَلٍ","ثَنى الشّمْسَ حَيْرى في السّماءِ قَتامُهُ",17,"م",2,0],["إذا سِيمَ خَسْفاً أدْرَكَتْهُ حَفيظَةٌ","تُصَعِّرُ خَدَّ العامِرِيِّ فيَنْتَخي",18,"خ",2,0],["إذا سَرى البَرْقُ مُجتازاً لطيَّتِهِ","وهَزَّتِ الرِّيحُ خُوطَ البانِ فَانآدا",19,"د",2,0],["إذا سَخِطَتْ أُزْرٌ عليْهِنَّ تَلتَوي","وَجَدْنا إزارَ العامريّةِ راضِيا",20,"ي",2,0],["إِذا سَمِنَ الأَغَرُّ دَنا لِقاءٌ","يُغِصُّ الشَيخَ بِاللَبَنِ الحَليبِ",21,"ب",1,0],["إِذا سَرَّها أَمرٌ وَفيهِ مَسَاءَتي","قَضَيتُ لَها فيما تُحِبُّ عَلى نَفسي",22,"ي",1,1],["إِذا سَبَّني نَذلٌ تَزايَدتُ رِفعَةً","وَما العَيبُ إِلّا أَن أَكونَ مُسابِبُه",23,"ب",2,1],["إذا سحَبوا ذَيْلَ الدّروعِ إلى الوَغَى","كما تسْحَبُ السُّحْبَ البُدورُ الطّوالِعُ",24,"ع",1,0],["إِذَا سَمحَ الدَّهْرُ الضَّنِينُ بِسَاعَةٍ","فَعَضَّ عَلَيْهَا جَاهِداً أَيَّمَا عَضٍّ",25,"ض",1,0],["إذَا سَاعَدَتْهَا هَبَّةُ الَّريحِ أسْرَعَتْ","كَمَا انْسَابَ أيْمُ الَّروْضِ غِبّ انْسلاَلِهِ",26,"ل",2,0],["إذا سُئِلُوا أَعْطَوْا وإنْ نوزِعوا سَطَوْا","وإنْ واعَدوا وَفَوْا وإنْ عاهَدوْا برّوا",27,"ر",3,0],["إذا سافَرَ السّلطانُ نحوَ مُنكَّبٍ","ولمْ أتّبِعْهُ جاهِداً سقَطَ الحَرَجْ",28,"ج",1,1],["إذا سِرْتَ سارَ النّورُ حيثُ تَعوجُ","كأنّكَ بَدْرٌ والبِلادُ بُروجُ",29,"ج",1,1],["إِذا سِمتُها التَقبيلَ أَبدَت تَشامُساً","ولينَ كَلامٍ لَم يُشَب بِتَهَذُّرِ",30,"ر",1,0],["إِذا سُمتُ بائِعَها حَقَّهُ","عَنُفتُ وَأَغضَبتُ تُجّارَها",31,"ر",3,0],["إِذا سَمِعتُ بِذكرِ الحُبِّ ذَكَّرَني","هِنداً فَقَد عَلِقَ الأَحشاءَ ما عَلِقا",32,"ق",2,0],["إِذا سَلَت يا أَبا شادي مُطَوَّقَةٌ","ذِكرَ الهَديلِ فَثِق أَنّا سَلَوناكا",33,"ك",2,0],["إِذا سَكَتنا تَناجَوا تِلكَ عادَتُهُم","وَإِن نَطَقنا تَنادَوا فِتنَةٌ عَمَمُ",34,"م",1,0],["إِذا سِرتَ يَوماً حَذَّرَ النَملُ بَعضَهُ","مَخافَةَ جَيشٍ مِن مَواليكَ يَغشاهُ",35,"ا",2,0],["إِذا سَطَعَ الغُبارُ خَرَجنَ مِنهُ","سَواكِنَ بَعدَ إِبساسٍ وَنَقرِ",36,"ر",1,0],["إِذا سُمتُ نَفسي هَجَرَها وَاِجتِنابَها","رَأَت غَمَراتِ المَوتِ في ما أَسومُها",37,"م",3,0],["إِذا سَلَفٌ مِنّا مَضى لِسَبيلِهِ","حَمى عَذِراتِ الحَيِّ مَن يَتَخَلَّفُ",38,"ف",1,0],["إِذا سَقى حَسَناً سُمّاً مُعَيَّةُ أَو","عَلى حُسَينٍ يَزيدٌ شَنَّ غاراتِ",39,"ت",1,0],["إِذا سَفَرَت كانَت لِعَينَيكَ سُخنَةً","وَإِن بُرقِعَت فَالقَفرُ في غايَةِ القَفرِ",40,"ر",1,0],["إِذَا سَارَ الوَلِيدُ بنا وَسِرنا","إِلَى خَيلِ نَلُفُّ بِهنَّ خَيلا",41,"ل",2,0],["إِذا سَمِعَت وَطءِ الرِكابِ تَنَغَّشَت","حُشاشاتُها في غَيرِ لَحمٍ وَلا دَمِ",42,"م",1,0],["إِذا ساقِيانا أَفرَغا في إِزائِهِ","عَلى قُلُصٍ بِالمُقفِراتِ حِيامِ",43,"م",1,0],["إِذا سُهَيلٌ لاحَ كَالوُقودِ","فَردٌ كَشاةِ البَقَرِ المَطرودِ",44,"د",1,0],["إِذا سَرَحَت مِن حُبِّ مَيٍّ سَوارِحٌ","عَلى القَلبِ آبَتهُ جَميعا عَوازِبُه",45,"ب",2,0],["إِذا سَيَّرَ الَهيفُ الَصهيلَ وَأَهلَهُ","مِنَ الصَيفِ عَنهُ أَعقَبَتهُ نَوازِبُه",45,"ب",2,0],["إذا سار سار المجد في طيّ بُرْده","يرافقه أكرم به من مرافق",46,"ق",1,0],["إِذا سَرَّكُم أَن تَمسَحوا وَجهَ سابِقٍ","جَوادٍ فَمُدّوا وَاِبسُطوا مِن عِنانِيا",47,"ي",2,0],["إِذا سَعَرَ الخَليفَةُ نارَ حَربِن","رَأى الحَجّاجَ أَثقَبَها شِهابا",48,"ب",2,0],["إِذا سَمِعَت نُمَيرٌ مَدَّ صَوتي","حَسِبتَهُمُ نِساءً مُنصِتاتِ",49,"ت",1,0],["إِذا سايَرَت أَسماءُ يَوماً ظَعائِناً","فَأَسماءُ مِن تِلكَ الظَعائِنِ أَملَحُ",50,"ح",1,0],["إِذا سَوَّموا لَم تَمنَعِ الأَرضُ مِنهُمُ","حَريداً وَلَم تَمنَع حَريزاً مَعاقِلُه",51,"ل",2,0],["إِذا سَفَرَت فَمَسفَرُها جَميلٌ","وَيُرضي العَينَ مَرجِعُها اللِثاما",52,"م",2,0],["إذا سِمْتُ نفسي عن بني النَّضْر سلوةً","عصتني فلم يسلسْ لطوع جنيبُها",53,"ب",3,0],["إذا سُمتُ نَفسِي نَصرَهُم وَتَطجَلَّعَت","الى بَعضِ ما فيه الذُّعَافُ المُثَمَّلُ",54,"ل",1,0],["إِذا سارَ الأَميرُ فَلا هُدوءٌ","لِنَفسي أَو يَأوبُ وَلا قَرارا",55,"ر",2,0],["إِذا سَمِعوا الغَيَّ آدوا لَهُ","تُيوسٌ تَنِبُّ إِذا تَضرِبُ",56,"ب",1,0],["إِذا ساوَرَ القَومُ أَقرانَهُم","قَصَدتَ إِلى الفارِسِ الأَهدَجِ",57,"ج",1,0],["إذا سامَ مولانا الممالكَ حافظاً","أعزَّ نواحِيها وأعلا جنابها",58,"ب",3,0],["إذا سألوني عن هوى قد كتمته","سكتُّ أراعي واشياً ورقيبا",59,"ب",2,1],["إذا سفراً قصدنا أو مقاماً","فإنَّ قِرَى الفتى منه وزاده",60,"د",2,0],["إذا سلكوا نحوه عرّفوا","برفع وإن تركوا نكّروا",61,"ر",3,0],["إذا سرت من دمشق الواردون بها","لكلّ مصرٍ فأحداقُ العدى عور",62,"ر",1,0],["إذا سحبت جدوى المؤيد ذيلها","تغطى فخار الفضل من ذلك الفضل",63,"ل",1,0],["إذا سقى ماله الظمآن أتبعه","جاهاً فيا لك من علٍّ على نهل",64,"ل",1,0],["إذا سار سار النصر تلو يراعه","وإن حلّ حلّ الفضل صدر دنيه",65,"ي",2,0],["إِذا سَكَن الحَقُّ السَريرَةَ ضوعِفَت","ثَلاثَةَ أَحوالٍ لِأَهلِ البَصائِرِ",66,"ر",1,0],["إذا سقطت خشيت لها هُبوباً","وإن هبت جَزعتُ من الهبوبِ",67,"ب",1,0],["إذا ساء ظنٌّ بمسترفَدٍ","أطال القصيدَ له المادحُ",68,"ح",1,1],["إذا سَمعتُ بِذِكْرِ الشمْسِ آسَفَنِي","فَصَعَّدَتْ زَفَراتي أيَّ تصْعِيدٍ",69,"د",1,0],["إذا سخط المؤدب خيف منهُ","فكيف تُرى من السخط المبيرِ",70,"ر",1,0],["إذا سعى لهلاك الناس لم ترهُ","يخشى رئيساً ولا يأوي لمرؤوس",71,"س",1,0],["إذا سرّها أمرٌ وفيه مآثمٌ","قضيتُ لها فيما تريد على نفسي",72,"ي",1,1],["إذا سُمته هجراً رأى بك راعياً","بصيراً بما يرعى أخلَّ وأحمضا",73,"ض",2,0],["إذا سرى في الجيش أغناهُمُ","ضريطُهُ جُبناً عن الطَّبْلِ",74,"ل",1,0],["إذا ساورته الراح في الصحن لألأتْ","وجوهُ الندامى بالبروق العواملِ",75,"ل",1,0],["إذا سئل استحيا من اللَّه أن يُرى","بموضعِ مَرْجُوٍّ وراجيه يُحرمُ",76,"م",1,0],["إذا سكناتُ صاحبه أملَّتْ","على حركاته سكنَ الأنامُ",77,"م",1,0],["إذا سارَ غُضَّتْ كُلُّ عينٍ مهابةً","وأُسكتَتِ الأفواهُ مِنْ غيرِ ما بكمْ",78,"م",1,0],["إِذا سَطَعَ الغُبارُ خَرَجنَ مِنهُ","بِأَسحَمَ مِثلِ خافِيَةِ العُقابِ",79,"ب",1,0],["إِذا سَمِعتَ بِمَوتٍ لِلبَخيلِ فَقُل","سُحقاً وَبُعداً لَهُ مِن هالِكٍ مودي",80,"ي",1,0],["إِذا سُقِيَت زادَت ذُبولاً كَأَنَّما","يَرُشُّ عَلَيها في المِياهِ لَهيبُ",81,"ب",1,0],["إِذا سَتَرَت نَحَبَّتِها قُلوبٌ","فَحُبّي لا أُطيقُ لَهُ اِستِتارا",82,"ر",2,0],["إِذا سَحَقَت أَرضَنا القُنبُلَه","كَما يَسحَقُ الحَجَرُ الخَردَلَه",83,"ل",2,1],["إِذا سَأَلتَ فَسَل مَن فيهِ مَكرُمَةٌ","لا تَطلِبِ الماءَ إِلّا مِن مَجاريهِ",84,"ي",2,0],["إِذا سَدِرَت مَدامِعُهُنَّ يَوماً","رَأَت إِجلاً تَعَرَّضَ أَو صِوارا",85,"ر",2,0],["إِذا سَرَحَت مِن مَنزِلٍ نامَ خَلفَها","بِمَيثاءَ مِبطانُ الضُحى غَيرَ أَروَعا",86,"ع",2,0],["إِذا سَئِمَت كَفّي نَوالاً تُفيضُهُ","عَلى مُعتَفيها أَو عَدُوّا تُقارِعُهْ",87,"ع",2,0],["اذا سمت قبيلة","فانما هو السبب",88,"ب",1,0],["إذا سمعت لقلبي زاد بي كلَفى","وإن سمعت لغير القلب لم أخَل",89,"ل",1,0],["إِذا سَمِعتُ صَرخَةً","طِرتُ إِلَيها طَرَبا",90,"ب",2,0],["إِذا سَلِمَ الدُستورُ هانَ الَّذي مَضى","وَهانَ مِنَ الأَحداثِ ما كانَ آتِيا",91,"ي",2,0],["إِذا سِرنَ في الأَرضِ نَسَّينَها","رِكابَ السَماءِ وَأَفضالَها",92,"ل",3,0],["إِذا سارَ فيهِ سارَتِ الناسُ خَلفَهُ","وَشَدَّت مَغاويرَ المُلوكِ رَكائِبُه",93,"ب",2,0],["إِذا سَأَلَ الإِنسانُ أَيّامَهُ الغِنى","وَكُنتَ عَلى بُعدٍ جَعَلنَكَ مَوعِدا",94,"د",2,0],["إِذا سارَتِ الأَحداجُ فَوقَ نَباتِهِ","تَفاوَحَ مِسكُ الغانِياتِ وَرَندُهُ",95,"د",2,0],["إِذا سَمِعَ الناسُ أَلفاظَهُ","خَلَقنَ لَهُ في القُلوبِ الحَسَد",96,"د",1,0],["إِذا سَلَكَ السَماوَةَ غَيرُ هادٍ","فَقَتلاهُم لِعَينَيهِ مَنارُ",97,"ر",1,0],["إِذا سَعَتِ الأَعداءُ في كَيدِ مَجدِهِ","سَعى جَدُّهُ في كَيدِهِم سَعيَ مُحنَقِ",98,"ق",1,0],["إِذا سارَ في مَهمَهٍ عَمَّهُ","وَإِن سارَ في جَبَلٍ طالَهُ",99,"ل",2,0],["إِذا سَأَلوا شَكَرتَهُمُ عَلَيهِ","وَإِن سَكَتوا سَأَلتَهُمُ السُؤالا",100,"ل",2,0],["إِذا سِرنا عَلى الفُسطاطِ يَوماً","فَلَقِّني الفَوارِسَ وَالرِجالا",101,"ل",2,0],["إِذا ساءَ فِعلُ المَرءِ ساءَت ظُنونُهُ","وَصَدَّقَ ما يَعتادُهُ مِن تَوَهُّمِ",102,"م",1,0],["إِذا سايَرَتهُ بايَنَتهُ وَبانَها","وَشانَتهُ في عَينِ البَصيرِ وَزانَها",103,"ن",3,0],["إِذا سمتُ قلبي الغيَّ فيها أطاعني","وإنْ سمتهُ فيها الرشادَ عَصاني",104,"ي",1,0],["إِذا سافرَ الألحاظُ في وجَناتِه","تضاءلَ عنه الطرفُ وهو كليلُ",105,"ل",1,0],["إِذا سَمعِوا بالفضلِ يوماً تربَّدَتْ","وجوهُهمُ سُوداً قسائِمُها غُبْرَا",106,"ر",2,0],["إِذا سامَ فيها المُجتَدونَ مَراتِعٌ","وَإِن عاثَ فيها المُعتَدونَ مَآسِدُ",107,"د",1,0],["إِذا سَمَحَ الوَزيرُ لَنا بِإِذنٍ","تَعَرَّضَ فيهِ دَجّالُ النَصارى",108,"ر",2,0],["إِذا سُهَيلُ بَدا رَوَّحنَ مِن لَهَبٍ","مُسَعَّرٍ في كِفافِ الأُفقِ مَشبوبِ",109,"ب",1,0],["إِذا سَكَبَت سَماءٌ ثُمَّ أَجلَت","ثَنَت بِسَماءِ مُغدِقَةٍ سَكوبِ",110,"ب",1,0],["إِذا سارَ سَهباً عادَ ظُهراً عَدُوَّهُ","وَكانَ الصَديقَ غُدوَةً ذَلِكَ السَهبُ",111,"ب",1,0],["إِذا سَوَّمتُ شُذّانَ القَوافي","عَدَلتُ بِها عَنِ المَرعى الجَديبِ",112,"ب",1,0],["إِذا سادَ شَيبانَ بنِ ثَعلَبَةَ اِرتَضَت","رِياسَةَ عالي البَيتِ يَفرَعُها مَجدا",113,"د",2,0],["إِذا سَجَعَ الحَمامُ هُناكَ قالوا","لِفَرطِ الشَوقِ أَينَ ثَوى الوَليدُ",114,"د",1,0],["إِذا سَوَّمتُهُنَّ مُسَيَّراتٍ","كَما اِتَّضَحَت نُجومُ اللَيلِ تَسري",115,"ي",1,0],["إِذا سارَ كُفَّ اللَحظُ عَن كُلِّ مَنظَرٍ","سِواهُ وَغُضَّ الصَوتُ عَن كُلِّ مَسمَعِ",116,"ع",1,0],["إِذا سَبَقَت مِنهُ يَدٌ فَتُشوهِرَت","أَبَرَّت عَلَيها مِن نَداهُ يَدٌ تَقفو",117,"ف",2,0],["إِذا سارَ في اِبنَي مالِكٍ قَلِقَ القَنا","عَلى جَبَلٍ يَغشى الجِبالَ فَتَقلَقُ",118,"ق",1,0],["إِذا سُؤدُدٌ دانى لَهُ مَدَّ هِمَّةً","إِلى سُؤدُدٍ نابي المَحَلِّ يُزاوِلُه",119,"ل",2,0],["إِذا سِرتُ عَنهُم لَيلَةً أَوتَلِيَّها","عَرَفتُ اِغتِرابي في حَنينِ جِمالي",120,"ل",2,0],["إِذا سَبَقَت يَداكَ إِلى عَطاءٍ","أَمِنّا الخُلفَ عِندَكَ وَالمِطالا",121,"ل",2,0],["إِذا سُئِلوا جاءَت سَيولُ أَكُفِّهِم","نَظائِرَ جَمّاتِ التِلاعِ السَوائِلِ",122,"ل",1,0],["إِذا سَرايا عَطاياهُ سَرَت أَسرَت","يَدَ المَكارِمِ وَاِستَغنَت عَنِ العُقُلِ",123,"ل",1,0],["إِذا سارَتِ الصَهباءُ في أُمِّ رَأسِهِ","يُؤَسِّفُ كَفّاً بَينَ دَنٍّ وَمَنزِلِ",124,"ل",1,0],["إِذا سَفَرَت رَأَيتَ الظَرفَ بَحتاً","وَنارَ الحُسنِ ساطِعَةَ الضِرامِ",125,"م",1,0],["إِذا سُئِلَت عَنهُ عِندَ الفَخارِ","قالَت بِأَصدَقِ عِرفانِها",126,"ن",3,0],["إِذا سَعدُ بنُ زَيدِ مَناةَ سالَت","بِأَكثَرِ في العَديدِ مِنَ التُرابِ",127,"ب",1,0],["إِذا سَأَلوهُنَّ العِناقَ مَنَعنَهُم","وَفَدَّينَ حَيَّي مالِكٍ حينَ أَصبَحوا",128,"ح",3,0],["إِذا سَمِعَت قَرعَ المَساحِلِ نازَعَت","أَيامِنُهُم شَزراً مِنَ القِدِّ أَيسَرا",129,"ر",2,0],["إِذا سَوَّمَت لِلبَأسِ أَغشى صُدورَها","أُسودٌ عَلَيها المَوتُ عادَتُها الهَصرُ",130,"ر",1,1],["إِذا سَمَكوها بِالمُعَلّى تَضَمَّنَت","رَبيعَةَ طُرّاً خائِفينَ وَمُعتَري",131,"ر",2,0],["إِذا سُقنا الفَرائِضَ لَم يُرِدها","وَصَدَّ عَنِ الشُوَيهَةِ وَالبَعيرِ",132,"ر",1,1],["إِذا سَدَفُ الصُبحِ اِنجَلى عَن جَبينِهِ","وَلَمحُ قَطائِيٍّ عَلى السَرجِ واقِعِ",133,"ع",1,0],["إِذا سَلَّ السُيوفَ بَني لُجَيمٍ","فَلَيسَ لَهُنَّ حينَ يَقَعنَ واقِ",134,"ق",1,0],["إِذا سَأَلوني ما يُداوي عُيونَهُم","بِوَقعَةِ بازٍ لا تَحِلُّ لَهُم رِجلا",135,"ل",2,0],["إِذا سَبَقَت قُرَيشٌ يَومَ مَجدٍ","فَهُم خَيلٌ وَأَنتَ مِنَ البِغالِ",136,"ل",1,0],["إِذا سامَت تَميمٌ يَومَ هَيجا","سَمَوا بي لا أَلَفَّ وَلا كَهاما",137,"م",2,0],["إِذا سَمَتِ القُرومُ لَهُم عَلَتهُم","شَقاشِقُ بَينَ أَشداقٍ وَهامِ",138,"م",1,0],["إذا سَقى اللهُ مَنْزِلاً فسقَى","بغدادَ ما حاولَتْ منَ الدِّيَمِ",139,"م",1,0],["إذا سجَدَتْ في الطُّرْسِ أقلامُه اغتَدى","سُجودُ العِدا جَمّاً لَهُ ورُكوعُها",140,"ع",3,0],["إذا سارَتْ مُشنِّعَةً عليكم","فرُدُّوا ذلك الخَبَرَ الشَّنيعا",141,"ع",2,0],["إذا سترَتْ غُرُّ السَّحابِ وقد سرَتْ","جوانِبَها خِلْتَ السَّحابَ سُتورَها",142,"ر",3,0],["إذا سُئِلُوا عمَّا يَلوحُ تبلَّدوا","كأنَّهمُ عندَ السُؤالِ جَلامِدُ",143,"د",1,0],["إذا سَرتْ حنَّتِ الجُردُ العِتاقُ به","وغرَّدَتْ في أعالي سُمْرِه العَذَبُ",144,"ب",1,0],["إِذا سيلَ عُرفاً كَسا وَجهَهُ","ثِياباً مِنَ المَنعِ صُفراً وَسودا",145,"د",2,0],["إِذا سَمِعَ السُوّاسُ صَوتَ تَحَمحُمي","يَقولونَ لا تَهلِك أَسىً وَتَجَمُّلِ",146,"ل",1,0],["إِذا سَفَرَ الصَباحُ لَها أَضاءَت","بِماءٍ مِثلِ مَسرودِ الأَضاءِ",147,"ا",2,0],["إِذا سَأَلوا عَن سِرِّكُم فَهوَ كاتِمٌ","وَإِن سَأَلوا عَن فَضلِكُم فَهوَ بائِحُ",148,"ح",1,0],["إذا سمعَ الحادي بها السِّمْعُ ظَنّهُ","كريماً على نَشْزٍ لمأدُبَةٍ يدعو",149,"ع",2,0],["إِذا سُلّ واهتزّتْ مضاربُهُ حكى","أخا السلّ هزّته بأُفْكلها الرِّبْعُ",149,"ع",1,0],["إذا سَرَحَتْ للسقي من كلّ جانبٍ","رأيتَ بقاعَ الأرض منها تُرَوِّضُ",150,"ض",1,0],["إذا سكتوا في غمرةِ الموْتِ أنْطقوا","على البيض بيضَ المرهفاتِ القواضِبِ",151,"ب",1,0],["إِذا ساءَ يَومٌ في الكَريهَةِ مَنظَراً","تَصَلّاهُ عِلماً أَن سَيَحسُنُ مَسمَعا",152,"ع",2,0],["إِذا سارَ فيهِ الظَنُّ كانَ بِكُلِّ ما","يُؤَمَّلُ مِن جَدواهُ أَوَّلَ قادِمِ",153,"م",1,0],["إِذا سَيفُهُ أَضحى عَلى الهامِ حاكِماً","غَدا العَفوُ مِنهُ وَهوَ في السَيفِ حاكِمُ",154,"م",1,0],["إِذا سيلَ سُدَّ العُذرُ عَن صُلبِ مالِهِ","وَإِن هَمَّ لَم تُسدَر عَلَيهِ المَسالِكُ",155,"ك",1,0],["إِذا سَفَكَ الحَياءَ الرَوعُ يَوماً","وَقى دَمَ وَجهِهِ بِدَمِ الوَريدِ",156,"د",1,0],["إِذا سَبَبٌ أَمسى كَهاماً لَدى اِمرِىءٍ","أَجابَ رَجائي عِندَكَ السَبَبُ العَضبُ",157,"ب",1,0],["إِذَا سَمِعْتَ صَوْتَ الصَّرِيخِ تَنَصَّبَتْ","فَتُدْرِكُ مَا لا تُبْصِرُ الْعَيْنُ بِالأُذْنِ",158,"ن",1,0],["إِذَا سَتَرَ الْفَقْرُ امْرَأً ذَا نَبَاهَةٍ","فَلا بُدَّ يَوْماً أَنْ يُشِيدَ بِهِ الْفَضْلُ",159,"ل",1,1],["إِذا سَلَكَت غَمرَ ذي كِندَةِ","مَعَ الرَكبِ قَصدٌ لَها الفَرقَدُ",160,"د",1,0],["إِذا سُمتُها التَقبيلَ صَدَّت وَأَعرَضَت","صُدودَ شَموسِ الخَيلِ صَلَّ لِجامُها",161,"م",3,0],["إِذا سَمِعَت ذِكرَ الحَبيبِ تَقَطَّعَت","عَلائِقُها مِمّا تَخافُ وَتَحذَرُ",162,"ر",1,0],["إِذا سَمِعا هُبوبَ الريحِ هَبّا","وَقالا أُمَّنا تَأتي الرَواحُ",163,"ح",1,0],["إذا سَعَتِ الوفودُ إليكَ فاحْذَرْ","عواقِبَ ما تقولُ لكَ الوُفودُ",164,"د",1,0],["إذا سادَ التخاذلُ في أُناسٍ","فأَعوزُ ما ترى شعبٌ يسودُ",164,"د",1,0],["إِذا سَطَعوا في دَياجي الخُطوبِ","جَرى النورُ مِن حَولِهِم يَنتَشِرْ",165,"ر",1,0],["إِذا سَأَلَ القوتَ قالوا أَساءَ","وَإن وَصَفَ الفَقرَ قالوا كَذِبْ",166,"ب",1,0],["إِذا سَرى الرَكبُ فيها لَم يَدُلَّهُمُ","بَعدَ الإِلهِ سِوى أَمٍ وَتَسديدِ",167,"د",1,0],["إِذا سَيِّدٌ مِنّا خَلا قامَ سَيِّدٌ","قَؤُولٌ لِما قالَ الكِرامُ فَعُولُ",168,"ل",1,0],["إِذا سَكَنَت قَلباً تَرَحَّلَ هَمُّهُ","وَطابَت لَهُ دُنياهُ وَاِنقَمَعَ الضَنكُ",169,"ك",1,0],["إذا سُئِلَ الإِبْرِيزُ جاشَ لُعابُهُ","ويَصْفُو بما يَطفو عليه ويَظْهَرُ",170,"ر",1,0],["إذا سارَ تحتَ النَّقْع جَلّى ظلامَهُ","ولو سارَ منه تحتَ أربَدَ أقْتَم",171,"م",1,0],["إذا سَطا بادَرَتْ هامٌ مصارِعَها","كأنّما تتلقّى الأرضَ للقُبَل",172,"ل",1,0],["إِذا سَما الخايِلُ لِلأَشباحِ","يَفتَرُّ عَن مِثلِ شَبا الرِماحِ",173,"ح",1,0],["إِذا سَنى ذا خَبا لِمَدَّتِهِ","أَضرَمَ مِن ذاكَ زاكِيَ القَبَسِ",174,"س",1,0],["إِذا سَلَّمَ المَسكينُ طارَ فُؤادُهُ","مَخافَةَ سُؤلٍ واعتَراهُ جُنونُ",175,"ن",1,1],["إِذا سامَني خَسفاً زَعيمُ قَبيلَةٍ","أَبَيتُ فَلَم أُعطِ المَقادَ عَلى القَسرِ",176,"ر",1,0],["إِذا سُئِلَت لَم تَكُن كَزَّةً","وَلَكِن تَذوبُ وَلا تَجمُدُ",177,"د",1,0],["إِذا سَناهُ اِنشَقَّ غَيرَ المُكدي","أَضاءَ لِلشامَةِ بَعدَ الرَقدِ",178,"د",1,0],["إِذا سَلَّيتَني أَوهَجتَ مِنها","فُؤاداً لا يُساعِفُ بِاِرتِياحِ",179,"ح",1,0],["إِذا سَفَرَت طابَ النَعيمُ بِوَجهِها","وَشُبِّهَ لي أَنَّ المَضيقَ فَضاءُ",180,"ا",2,0],["إِذا سَهَّدنَهُ بِطَويلِ هَجرٍ","فَما أَجفانُهُنَّ مُسَهَّداتُ",181,"ت",1,0],["إِذا سَكَتَ الإِنسانُ قَلَّت خُصومُهُ","وَإِن أَضجَعَتهُ الحادِثاتُ لِجَنبِهِ",182,"ب",2,1],["إِذا سَلِمَت فَنَصٌّ في المَوامي","فَواصَدَ ما بِهِ فَنِيَ القَصيدُ",183,"د",1,0],["إِذا سَنَةٌ بَكى تَشرينُ فيها","وَساعَدَهُ بِدَمعَتِهِ أَذارُ",184,"ر",1,1],["إِذا سَعِدَ البازي البَعيدُ مُغارُهُ","تَأَدّى إِلَيهِ رِزقُهُ وَهوَ في الوَكرِ",185,"ر",1,1],["إِذا سَرَّ الناسُ عَنكَ الأُمورَ","فَلا تَكُ عَن أَمرِهِم ذا تَقَص",186,"ص",1,0],["إِذا سَلَقَت عِرسُ الفَتى في كَلامِها","فَما هِيَ إِلّا سِلقَةٌ عارَضَت سِلقا",187,"ق",2,1],["إِذا سَمَحَت عادَت لِما سَمَحَت بِهِ","وَكَم أَذنَبَت وَالذَنبُ بِالرَرضِ يُعرَكُ",188,"ك",1,0],["إِذا سَخِطَت رُوحُ الفَتى فَلِيَقُل لَها","لَعَمرُكِ ما وُفِّقتِ أَن تَسكُني الجِسما",189,"م",2,1],["إِذا سَأَلوا عَن مَذهَبي فَهُوَ بَيِّنٌ","وَهَل أَنا إِلّا مِثلُ غَيري أَبلَهُ",190,"ل",2,0],["إذا سَئمُوا الرّحالَ فكُلّ غِرّ","يَرَى صَرَعَاتِه خُلَسَ اغْتِنامِ",191,"م",1,0],["إذا سقَتِ السماءُ الأرْضَ سَجْلاً","سَقاها من صَوارِمِهِ سِجالا",192,"ل",2,0],["إذا سَئِمَتْ مُهَنَّدَهُ يَمِينٌ","لِطُولِ الحَمْلِ بَدّلَه شِمالا",192,"ل",2,0],["إذا سُقِيَتْ ضُيوفُ الناسِ محضاً","سَقَوْا أضْيافَهُمْ شَبِماً زُلالا",192,"ل",2,0],["إذا سَمَيْتَهُ في أرْضِ جَدْبٍ","نَزَلْتَ وكلُّ رابيَةٍ خِوانُ",193,"ن",1,0],["إِذا سُلَّ مِن جَفنٍ تَأَكَّلَ أَثرُهُ","عَلى مِثلِ مِصحاةِ اللُجَينِ تَأَكُّلا",194,"ل",2,0],["إِذا سِيقَتِ الخَيلُ وَسَطَ النها","رِ يُضرَبنَ ضَرباً وَلَم يُضرَبِ",195,"ب",1,0],["إذا سَدَلتْ سِتراً على كلِّ كوكبٍ","كبا نورُه من نورِها فتستَّرا",196,"ر",2,0],["إذا سقم الرأي في أمة","من الجهل فالعلم يشفي السقاما",197,"م",2,0],["إذا سئلت عما تجن من الجوى","أَضر بها إقرارها وجحودها",198,"د",3,0],["إذا سجعت هبت تجيب حمائم","وَتكثر من أسجاعها لسجوع",199,"ع",1,0],["إذا سكت الإنسان فالهم والأسى","وإن هو لم يسكت فموت معجل",200,"ل",1,0],["إذا سرنا عن الفسطاط يوماً","فلقّني الفوارس والرّجالا",201,"ل",2,0],["إذا سعت الأعداء في كيد مجده","سعى مجده في جده سعى محنق",202,"ق",1,0],["إذا سَمعَ الحجَّاجُ رِزّ كَتِيبةٍ","أَعَدَّ لها قَبْلَ النزولِ قِراها",203,"ا",3,0],["إذا سِفْنَها أو سُفْنَها إضْنَ خُيَّباً","برَغْمٍ وقد يَرْدى الشُّجاعُ المُقامِس",204,"س",1,0],["إذا سألَتْها النّبْعُ عمّا تُجِنّهُ","أتَتْ شاعراً وافاهُ رَهْطٌ ليُنْشِدا",205,"د",2,0],["إذا سارَتْكَ شُهْبُ الليل قالت","أعانَ الُله أبْعَدَنا مُرادا",206,"د",2,0],["إذا سَمّرَ الحِرْباءُ في العُودِ نَفْسَه","على فَلَكِيٍّ بالسّرابِ مُدَرَّع",207,"ع",1,0],["إذا سحَلَتْ في القَفْرِ كان سَحِيلُه","صَليلاً يُريقُ العِزَّ من كلّ أخْدَع",207,"ع",1,0],["إِذا سَمِعَت مِنّي حَويزَةُ زَأرَةً","تَحَوَّزَ داءٌ في حَواياهُمُ الأُدرِ",208,"ر",1,0],["إِذا سِرتُ في الأَرضِ الفَضاءِ رَأَيتُني","أُصانِعُ رَحلي أَن يَميلَ حِيالِيا",209,"ي",2,0],["إِذَا سَارَ فِيهِ الطَّرْفُ قِيدَ بَنانَةٍ","تَعَثَّرَ مَا بَيْنَ الْقَنا وَالْقَوَاضِبِ",210,"ب",1,0],["إِذَا سِرْتُ فَالأَرْضُ الَّتِي نَحْنُ فَوْقَهَا","مَرَادٌ لِمُهْرِي وَالْمَعَاقِلُ دُورُ",211,"ر",1,0],["إِذَا سُدْتَ فِي مَعْشَرٍ فَاتَّبِعْ","سَبِيلَ الرَّشَادِ وَكُنْ مُخْلِصَا",212,"ص",2,1],["إِذَا سارَ عَنْهُمْ سَارَ وَهْوَ مُكَرَّمٌ","وَإِنْ عَادَ فِيهِمْ عَادَ وَهْوَ سَعِيدُ",213,"د",1,0],["إِذَا سَفَرَتْ وَالْبَدْرُ لَيلَةَ تَمِّهِ","وَلاحَا سَوَاءً قِيلَ أَيُّهُما الْبَدْرُ",214,"ر",1,0],["إِذا سَاءَ صُنْعُ الْمَرْءِ سَاءَتْ حَيَاتُهُ","فَمَا لِصُرُوفِ الدَّهْرِ يُوسِعُها سَبَّا",215,"ب",2,0],["إِذَا سَارَ عَنْ أَرْضٍ غَدَتْ وَهْيَ جَنَّةٌ","وَإِنْ حَلَّ عَمَّهَا مِنْهُ زُخْرُفُ",216,"ف",1,0],["إِذَا سَامَهُ خَسْفاً عَتِيٌّ وَمَارِد","ثَنَاهُ إِلَى المُثْلَى عَتِيٌّ وَمَارِدُ",217,"د",1,0],["إِذَا سِرْتُ بَحْراً أَرَاهُ بِهِ","أَنِيسِيَ عَنْ جَانِبِ المَرْكَبِ",218,"ب",1,0],["إذا سكن الروع عن ميّتٍ","بدهنا بآخرَ ينعى السكونا",219,"ن",2,0],["إذا سادَ في الأرض، جَبَّ الفسادَ","من الأرض، واستأصَلَ المُنكَرا",220,"ر",2,0],["إذا ساد في الأرضِ، قلّ الفسادُ","بها، وأظلّ السّلامُ الأمَم",221,"م",1,0],["إذا سبحن على أمواجه، فُتِحَتْ","للسابحات من الأمواج أحضان",222,"ن",1,0],["إذا سمعتم نُباحًا منه أطْرَبَكُم","كأنكم قد سمعتم منه مَزْمُورا",223,"ر",2,0],["إذا سلّ روحي سلّني من يد الشقا","وخلّصني من شرّه بيديه",224,"ي",2,0],["إذا سَلِمت كأسٌ يُروِّحُ مُغبّقاً","عليه بها الساقي ويغدو مبكِّرا",225,"ر",2,0],["إذا سُئِلُوا جاءَتْ سُيُولُ أكُفّهمْ،","نَطائرَ جُمّاتِ التّلاعِ السّوَائِلِ",226,"ل",1,0],["إذا سؤدَدٌ دانَى لَهُ مَدَّ هَمَّهُ","إلى سُؤدَدٍ نائي المَحَلّ، يُزَاوِلُهْ",227,"ل",2,0],["إذا سَألُوني مَا يُدَاوِي عُيُونَهُمْ","بوَقعَةِ بَازٍ لا تَحُلّ لِمْ رِجلا",228,"ل",2,0],["إذا سَلّ السّيُوفَ بَنُو لُجَيْمٍ،","فَلَيْسَ لَهُنّ حِينَ يَقَعْنَ وَاقِ",229,"ق",1,0],["إِذَا سَدِرَتْ مَدَامِعُهُنَّ يَوْماً","رأتْ إجلاً تعّضَ أوْ صوارا",230,"ر",2,0],["إِذا سَارَ عنْ أَرض غَدَتْ وهى جَنّة ٌ","وَإِنْ حَلَّ أُخْرَى عَمَّهَا مِنْهُ زُخْرُفُ",231,"ف",1,0]]}