.ae/diwan/poem/72806","الخفيف"],[4584,"","https://poetry.dctabudhabi.ae/diwan/poem/141865","المجتث"],[4631,"","https://poetry.dctabudhabi.ae/diwan/poem/198575","الخفيف"],[4778,"أهواكَا","https://www.poetsgate.com/ViewPoem.aspx?id=188197",""],[4783,"أ أسْلو؟","https://www.poetsgate.com/ViewPoem.aspx?id=185446",""],[4858,"سلام الضعفاء","https://www.poetsgate.com/ViewPoem.aspx?id=34883",""],[4927,"ضياع الرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=30179",""],[5050,"ألا دع خلة الكاس","https://www.poetsgate.com/ViewPoem.aspx?id=38215",""],[5131,"مكانَكِ يا نفسُ لا تنطقي","https://www.poetsgate.com/ViewPoem.aspx?id=53814",""],[5139,"مليط","https://www.poetsgate.com/ViewPoem.aspx?id=68956",""],[5145,"رجعت صبوته إن خطرا","https://www.poetsgate.com/ViewPoem.aspx?id=108110",""],[5147,"روح النفس فهي ضيف بمغناك","https://www.poetsgate.com/ViewPoem.aspx?id=166733",""],[5190,"الشرخ","https://www.poetsgate.com/ViewPoem.aspx?id=153358",""],[5200,"أبصرته غدوة سطيحا","https://www.poetsgate.com/ViewPoem.aspx?id=200801",""],[5285,"باقة ورد","https://www.poetsgate.com/ViewPoem.aspx?id=203581",""],[592,"على قلة الداعي وقلة ذي الفهم","https://www.poetsgate.com/ViewPoem.aspx?id=128814",""],[592,"سفاسط أملاها الغبي وسطرا","https://www.poetsgate.com/ViewPoem.aspx?id=128722",""],[592,"جاس بن جرجيس بغياً من شقارته","https://www.poetsgate.com/ViewPoem.aspx?id=128821",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5351,"القادم أولاً وثانياً","https://www.poetsgate.com/ViewPoem.aspx?id=202236",""],[5431,"لا تغرها ببلاغة العرض....","https://www.poetsgate.com/ViewPoem.aspx?id=199881",""],[5444,"صفيُّ العِلم","https://www.poetsgate.com/ViewPoem.aspx?id=205525",""],[5550,"يا كثيرَ الصُّدُود","https://www.poetsgate.com/ViewPoem.aspx?id=211543",""],[5595,"لَقيتُها ، وكأنَّ الدّمْعَ يُؤنِسُها","https://www.poetsgate.com/ViewPoem.aspx?id=177969",""],[5596,"السحمية","https://www.poetsgate.com/ViewPoem.aspx?id=206361",""],[5861,"دع الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=188293",""],[5956,"عيون الحب","https://www.poetsgate.com/ViewPoem.aspx?id=182112",""],[6046,"هاجر لتنشئ دولة الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=36938",""],[6102,"جُناح","https://www.poetsgate.com/ViewPoem.aspx?id=183610",""],[6202,"استبد الهوى عشقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86702&r=&rc=3",""],[6213,"نداء العجوز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76265&r=&rc=22",""],[572,"جَاءَتْ بعودٍ كَأَنّ الحُبَّ أنْحَلَهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9205&r=&rc=62",""]],"verses":[["فَحَرَّكَ مِن أَفهامِهِم وَعُقولِهِم","وَعاوَدَهُم ذاكَ الذَكاءُ المُضَيَّعُ",0,"ع",1,0],["فَحِرِ امّ مُلكٍ أَنتَ مالِكُ أَمرِهِ","مَن أَنتَ يا هذا وَما بيسانُ",1,"ن",1,0],["فحركته على فتك الكلال به","وأذهبت بسرور الملتقى نَصَبَهْ",2,"ب",2,0],["فحركت حزناً كان في الشرق ساكناً","وجدّدت عهداً منه في الشرق أو جال",3,"ل",1,0],["فحرّموا وأحَلّوا حسب عادتهم","وشَوّهوا وَجه أحكام الديانات",4,"ت",1,0],["فحرام عليك تبدية الأذ","ناب حتى تقدم الأعرافا",5,"ف",2,0],["فَحُرِمتُ حُسنَ قَضائِها","إِذ لَم يَكُن حَسَنَ البَلاغِ",6,"غ",1,0],["فَحَرَّكَ بَثّي رَبعُها وَهوَ ساكِنٌ","وَجَدَّدَ وَجدي رَسمُها وَهوَ مُخلِقُ",7,"ق",1,0],["فَحَرَّقَ ما بَينَ الدُروبِ أَتِيُّهُ","إِلى مَجمَعِ البَحرَينِ حينَ تَخَرَّقا",8,"ق",2,0],["فَحَربَةُ وَحشِيٍّ سَقَت حَمزَةَ الرَدى","وَحَتفُ عَلِيٍّ في حُسامِ ابنِ مُلجَمِ",9,"م",1,0],["فَحَرَّكَ أَعلى حَبلِهِ بِحُشاشَةٍ","وَمِن فَوقِهِ خَضراءُ طامٍ بُحورُها",10,"ر",3,0],["فَحِرتُ مِن دُرِّ عَبراتي وَمَبسِمِها","ما بَينَ مُشتَبِهٍ مِنها وَمُشتَبِكِ",11,"ك",1,0],["فَحَرّ لَظاها يَلذَعُ الهمّ في الحشا","وطيب شَذاها للعَرانينِ يَنْفَحُ",12,"ح",1,0],["فَحَرامٌ عَلَيكَ أَن لا تَنالَ ال","دَهرَ مِنّي غَيرَ الَّذي كُنتَ نِلتا",13,"ت",2,0],["فَحَرَّكَ مِن ساكِنٍ كامِنٌ","تَعاطي حَديثٍ يَحُلُّ الحُبى",14,"ب",2,0],["فَحَرّانَ صادٍ ذيدَ عَن بَردِ مَشرَبٍ","وَعَن بَلَلاتِ الماءِ وَهوَ يَحومُ",15,"م",1,0],["فَحَرَّمَ أَرضَ الحائِرينَ وَمائَها","فَهَيهاتَ مَن يَغدو عَلَيها وَمَن يَسري",16,"ر",2,0],["فَحَرَّكَت عودَها ثُمَّ اِنثَنَت طَرَباً","تَشدو بِهِ ثُمَّ لا تُخفيهِ كِتمانا",17,"ن",2,0],["فَحَرجَي ذِروَةٍ فَقَفا ذَيالٍ","يُعَفّي آيَهُ سَلَفُ السِنينِ",18,"ن",1,0],["فحرَّقوا ومَزَّقوا الحُصونا","وأسْخنوا من أَهلها العُيونَا",19,"ن",2,0],["فحِرت وعيني ترمق الباب خلسةً","وللنفس في كشف الحقيقة مَطمَع",20,"ع",1,0],["فَحُرِمْتُ رَؤْيَةَ مَنْ أَوَدُّ","ورَاحَ ميَعادِي هَبَاءْ",21,"ا",2,0],["فحرقنا نفوسنا","في جحيم من القبل",22,"ل",1,0],["فَحُرتَ إِلى الحورِ لَم","يُلِمَّ بِها من طَمَث",23,"ث",1,0],["فحرَّكَ الرأس ذو القرنين من أسفٍ","وصاح بالطفل -في عُنفٍ- يؤنُّبه",24,"ب",2,0],["فحرَّكَتْ شَجَنِي رغْمَ السرورِ بها","فأعجَبْ لمبتهجٍ في ثوبِ مُبْتَئِسِ!",25,"س",1,0],["فحَرْبَةُ وَحشِيٍّ سَقَتْ حَمزَةَ الرّدى،","وحَتْفُ عَليٍّ عَن حُسامِ ابنِ مُلجِمِ",26,"م",1,0],["فَحَرَامٌ عَلَيْكَ أنْ لا تَنَالَ الدَّهْ","هرَ، مني غيرَ الذي كنتَ نلتا!",27,"ت",2,0],["فَحَرَّمْتُ كَأْسِي عَلَى لَذَّتِي","وَأَزْمَعْتُ كُلَّ وِصَالٍ صُدُودَا",28,"د",2,0],["فحرَت مدامع جفنه في خدّه","مثل المعين بسيل من أطواده",29,"د",2,0],["فَحَرامٌ أَن يُوارى","في تُرابِ الكائِناتِ",30,"ت",1,0],["فحَرَّقَ مُجتاحاً وغرَّمَ ناهِباً","وقتَّلَ سفّاحاً وعاثَ ودمّرا",31,"ر",2,0],["فحرّضيهم على تقطيعِ سلسلةٍ","هم راسفون بها ما بين أشراك",32,"ك",1,0],["فَحُرِمتُ ذَلِكَ مِنهُ مَع شُكري لَهُ","وَرُميتُ مِنهُ بِضِدِّ ما أَمَّلتُهُ",33,"ت",2,0],["فَحَرَّكتَ جَناحَ الصَب","رِ لَمّا مَسَّكَ الضُرُّ",34,"ر",1,0],["فَحَرْسُ المَالِ يَشكي مِن يَدَيهِ","وَلا عَتْبٌ علَى شَاكٍ يَصيِحُ",35,"ح",1,0],["فَحَرُّها مُستَعَرٌ بِبَردِها","وَبَردُها لِلأَبحُرِ السَبعِ سَجَر",36,"ر",1,0],["فحَرْفا أوَّلِ التّلقيبِ كافٍ","بثاني الاِسْمِ أنَ يَجِدَ اتّصالا",37,"ل",2,0],["فحرِّرْ لآدابي سُطورَ عنايةٍ","هيَ الوَسْمُ في ضاحي سَوالفِ عُلْطها",38,"ط",3,0],["فحرّكَتْنا هذي الزّلازلُ أنْ","تيقَّظوا كَم يَنامُ من ناما",39,"م",2,0],["فَحُرِمْنا من بَينِهِم رَيْعَ ما كُنْ","نَا زَرعنا وقال زيدٌ وعمرُو",40,"ر",2,0],["فحرّكها وأَينَ لها بنجد","لهيبُ الشَّوق والدَّمع المذالُ",41,"ل",1,0],["فحرَّم سَرحها وحنا عليها","وضمَّ سُروحها بَدداً 