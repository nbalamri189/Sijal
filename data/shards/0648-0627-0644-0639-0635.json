{"poems":[[95,"لقيتك مصر بثغرها المتبسم","https://www.aldiwan.net/poem11335.html","الكامل"],[93,"أنت والكأس في يدي فلمن أنت في غد","https://www.aldiwan.net/poem8801.html","عموديه"],[87,"في ذي الجفون مصارع الأكباد","https://www.aldiwan.net/poem6821.html","الكامل"],[87,"يا مصر سماؤك جوهرة","https://www.aldiwan.net/poem7882.html","المتدارك"],[48,"كل ذكر من بعده نسيان","https://www.aldiwan.net/poem23463.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85382","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54772","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54750","الخفيف"],[102,"كلّنا في انتظار ميلاد الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=50117",""],[214,"هل لصب قد غير السقم حاله","https://www.aldiwan.net/poem13303.html","الخفيف"],[255,"والعصر إن عداك في العصر","https://www.aldiwan.net/poem14970.html","أحذ الكامل"],[406,"للحب قلب نابض","https://www.aldiwan.net/poem6705.html","عموديه"],[409,"عدة الصابرين إن ناب خطب","https://www.aldiwan.net/poem34120.html","الخفيف"],[438,"هي دولة موصولة الإقبال","https://www.aldiwan.net/poem12698.html","الكامل"],[520,"العلم مذ كان محتاج إلى العلم","https://www.aldiwan.net/poem12262.html","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38042","المجتث"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56697","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141268","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27822","البسيط"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47152","الخفيف"],[2308,"","https://poetry.dctabudhabi.ae/diwan/poem/138926",""],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88666","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132720","الخفيف"],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76543","المديد"],[3318,"","https://poetry.dctabudhabi.ae/diwan/poem/138757",""],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112319","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91197","البسيط"],[3793,"","https://poetry.dctabudhabi.ae/diwan/poem/124786","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94547","الكامل"],[4291,"","https://poetry.dctabudhabi.ae/diwan/poem/142468","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72517","الرمل"],[4883,"طعم حلوى","https://www.poetsgate.com/ViewPoem.aspx?id=48371",""],[4883,"عتب","https://www.poetsgate.com/ViewPoem.aspx?id=48362",""],[3271,"وطن الفأس","https://www.poetsgate.com/ViewPoem.aspx?id=104126",""],[5084,"يا راكب ٍ حمراء","https://www.poetsgate.com/ViewPoem.aspx?id=177781",""],[5121,"أُنْشُودَةُ الطُّيُورْ","https://www.poetsgate.com/ViewPoem.aspx?id=33500",""],[5183,"الفتوح","https://www.poetsgate.com/ViewPoem.aspx?id=186380",""],[5216,"ابكِ يوما","https://www.poetsgate.com/ViewPoem.aspx?id=187650",""],[5491,"أنت علمتني بألا أبالي","https://www.poetsgate.com/ViewPoem.aspx?id=215041",""],[5533,"اِرْتفاعُ ضَغْطِ الدَّم","https://www.poetsgate.com/ViewPoem.aspx?id=176252",""],[5690,"لما أعاد مليكنا","https://www.poetsgate.com/ViewPoem.aspx?id=172280",""],[402,"تحية يا حماة البلج يا أسد","https://www.poetsgate.com/ViewPoem.aspx?id=35506",""],[161,"ربيعَا للأمة زَعَمُوا !","https://www.poetsgate.com/ViewPoem.aspx?id=211185",""],[6102,"اغضبي","https://www.poetsgate.com/ViewPoem.aspx?id=182847",""],[6102,"ماخُور !!","https://www.poetsgate.com/ViewPoem.aspx?id=185041",""],[6102,"يَفعَلُ البُعدُ ..","https://www.poetsgate.com/ViewPoem.aspx?id=185335",""],[6124,"نكتب الأوتار","https://www.poetsgate.com/ViewPoem.aspx?id=121830",""],[6261,"تباريحُ الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82137&r=&rc=9",""],[6285,"هذه الشام لا تقولي كفانا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86807&r=&rc=0",""]],"verses":[["وَالعَصْرُ قَدْ يَجِدُ التَّحَوُّلُ فِطْنَةً","وَيَرَى الحِفَاظَ لُزُومَ مَا لَمْ يَلْزَمِ",0,"م",1,0],["وَالعَصافيرِ أَقبَلَت","نَحوَها لِلتَبَرُّدِ",1,"د",1,0],["والعصر يرعد والملوك حنيقة","والفلك رابحة الشراع غوادي",2,"د",2,0],["والعصر إليك تقرّبه","وإلى حاميك تودّده",3,"د",2,0],["وَالعَصا لِلضَريرِ خَيرٌ مِنَ القا","ئِدِ فيهِ الفُجورُ وَالعِصيانُ",4,"ن",1,0],["وَالعَصافير يا ابنتي تتغنّى","للضحى فوق كل غصن رَشيق",5,"ق",1,0],["وَالْعِصْبَةِ الْجَبَلِيِّينَ الَّذِينَ أَرَوْا","كَيْفَ انْتِقَامَ أَبِيٍّ وَهْوَ مضْطَهَدُ",6,"د",1,0],["وَالعَصَا فِي يَمِينهِ لاَ تُضَاهَى","مَلْمِساً نَاعِماً وَغِلْظَةَ عُودِ",7,"د",1,0],["والعصافير تنفض الريش في الوكر","وتنفي النعاس من كلّ وكر",8,"ر",1,0],["والعصا اورقت بلمس يديه","وزها عودها ومدّ وزلاله",9,"ل",2,0],["والعَصر إنَّ عدَاك في العَصرِ","وقد انتَهَوا لِهدَاية الخسرِ",10,"ر",1,1],["والعصر بحر هائج متلاطم","تقتات فيه بمن هوى الحيتان",11,"ن",1,0],["والعصا ترحم اليراع بكفي","وتنادي قم يا مطيل المغيب",12,"ب",1,0],["والعصرُ من إشراقِ دولةِ ياسرٍ","متشعشع الغَدواتِ والآصالِ",13,"ل",1,0],["والعصر يعلم أني فيه جوهرة","رخيصة السعر بالغالي من القيم",14,"م",1,0],["وَالعَصرُ يَحيا بِعلمٍ","وعالِمُ العَصرِ يحيى",15,"ي",2,0],["والعصر جافٍ والخطوب شديدة","والباب من دون السلامة موصدُ",16,"د",1,0],["والعصب في الوافر إضمارٌ علم","في كامل كما تراه قد رسم",17,"م",1,0],["والعصر عصر مذاهبٍ وتعصّب","فاجري مع التيّار دون تماد",18,"د",1,0],["والعصر يهمز فيلاً بالحجارة إذ","جاءتْ قريشٌ بدينِ الحوضِ تنشيه",19,"ي",2,0],["والعصا خُصّصَتْ بموسى ولكن","عمّ كلَّ العبادِ نفعُ المثال",20,"ل",1,0],["والعصا أورقت لديه ولا غرو","بأن أورقت لديه عصاها",21,"ا",3,0],["والعصر هَذا امام العصر","من ضل عن نهجه في خسر",22,"ر",1,0],["والعصا أورقت بكفك لما","صافحت من نداك غيثا سجاما",23,"م",2,0],["وَالعِصامِيُّ الَّذي اِعتَصَمَت","بِعُلاهُ سَوفَ يَعصِمُها",24,"م",3,0],["وَالعِصمَةُ المأمُونُ ظُلمُ قَرينِهَا","أَدنّى فَضَائِلِهِ وَأَيسَرُ فَخرِهِ",25,"ر",2,0],["والعصا هذي التي تَنظرُها","فهيَ عُكّازي قِياماً وقُعود",26,"د",1,0],["وَالعَصر وَالمَصر ذا زاه وَذي فَرحت","وَاستبشرت بَين تَزيين وَتَأنيق",27,"ق",1,0],["والعصر مثله وطاب الحالُ","وانتظم الموقف والمقالُ",28,"ل",1,0],["والعصر أصبح ضاحكاً مترنماً","لما بمئزره السرور قد ايتزر",29,"ر",1,0],["والعصر يرفضه في كل موقعة","والعجز في قلبه المحرون يلتصق",30,"ق",1,0],["والعصا ما قرعت إلا لمن","يعتريه عته عن كبر",31,"ر",1,0],["والعصافير كانت في المكان","بعض رُزنامة الوان وصْوَر",32,"ر",1,0],["والعصافير جايلها شدو","فوق قمح ٍ رعى فيه الجراد!",33,"د",1,0],["والعصافير شادياتٌ على الدو","حِ تناغي بشدوها شجراته",34,"ت",2,0],["والعصر تبدى لك هضاب ٍ لحاليح","قور ٍ رست في مزعج عبيثراني",35,"ن",2,0],["وَالْعَصَافِيِرُ تَحْنُو عَلَى ذِي الرُّبَى","دَنْدَنَتْ غِنْوَتِي صَفْوَةً سَبِّحِي",36,"ح",2,0],["والعصر ويل العصر إن يحمل على","ذي حيرة ألقاه في خسرانه",37,"ن",2,0],["والعصافيرُ تُغنّي","حينَ ينقُصُها الغِناءُ",38,"ا",2,0],["والعصافير حولنا تتغنى","لاعتناق المروج والشلَّالِ",39,"ل",1,0],["والعَصَبُ يُؤَرِّقُ صاحِبَهُ","إِنْ حُرمِ دِماءَ الشِّرْيانِ",40,"ن",1,0],["والعصر أضحى باسماً","يختالُ في حللٍ زهيَّةْ",41,"ي",2,0],["والعصبة الجبايين الذين أروا","كيف انتقام أبي وهو مضطهد",42,"د",1,0],["والعَصْفُ دَمْدَمَ أشْتَاتًا وَ كَانَ لَهُ","بَأْسُ انْتِقَامٍ فَسَادَ الجَدْبُ وَ الغَبَنُ",43,"ن",1,0],["وَ العَصافِيرُ الْ: أَطرَبَتْ كُلَّ حِبٍّ","مِنْ قَصِيدِي تَجُرُّ لَحنًا فَتَطرَبْ",44,"ب",1,0],["وَ العُصبَةُ الحَمقاءُ تَدفَعُني","دَفعًا لِبَعضِ الغَمزِ وَ اللَّمسِ !!",45,"س",1,0],["وَالعَصافِيرُ مِن ثُقُوبِ قَمِيصٍ","فَوقَ نَهدَيكِ صَوتُها رَنَّانُ",46,"ن",1,0],["والعصافيرُ الّتي من حُلمنا","ردّدتْ نبْضاً قدِماً ودّعكْ",47,"ك",1,0],["والعصافيرُ تنقُرُ الحُبَّ خجلى","ما أماطتْ غِطاءَهُ ولثامَهْ",48,"م",2,0],["والعصافير حولنا أغنياتٌ","رتل الحب لحنها نشوانا",49,"ن",2,0]]}