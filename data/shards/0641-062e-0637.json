{"poems":[[79,"لمن علم في هضبة الملك خفاق","https://www.aldiwan.net/poem35918.html","الطويل"],[93,"دار السلام وأرض الهنا","https://www.aldiwan.net/poem62784.html","عموديه"],[72,"أحبابنا حاشاكم","https://www.aldiwan.net/poem42787.html","مجزوء الرجز"],[108,"أدب الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=179476",""],[186,"روزا فتاة بني الجاويش قد رحلت","https://www.aldiwan.net/poem61047.html","البسيط"],[186,"رمس لأسحاق روته بنو صدقه","https://www.aldiwan.net/poem61104.html","البسيط"],[186,"لقد مضى سعد رزوق الكريم إلى","https://www.aldiwan.net/poem61143.html","البسيط"],[186,"زر تربة لنقولا رعد قد مطرت","https://www.aldiwan.net/poem61167.html","البسيط"],[186,"من آل يارد شهم قد قضى فثوى","https://www.aldiwan.net/poem61193.html","البسيط"],[186,"هذا ابن قطب علوم الشرق عاجله","https://www.aldiwan.net/poem66978.html","البسيط"],[186,"بدر توارى بطي الترب مندرجا","https://www.aldiwan.net/poem67035.html","البسيط"],[275,"لئن ذبلت كالزهر يوما قريحتي","https://www.aldiwan.net/poem35607.html","الطويل"],[287,"يا لائمي ما للخلي وللشجى","https://www.aldiwan.net/poem32836.html","الكامل"],[303,"إذا الشعر لم ينفث به ربه السحرا","https://www.aldiwan.net/poem36848.html","عموديه"],[369,"أطاعك مني القلب العصي","https://www.aldiwan.net/poem60562.html","الوافر"],[369,"عدد لكم أن سرت في تشييعي","https://www.aldiwan.net/poem60845.html","الكامل"],[411,"إذا اقتسمت أقاليم المعالي","https://www.aldiwan.net/poem50121.html","الوافر"],[443,"أين الديار فهذه الجرعاء","https://www.aldiwan.net/poem2589.html","الكامل"],[445,"قل للربيع اسحب ملاء سحائب","https://www.aldiwan.net/poem34876.html","الكامل"],[487,"أسرت بدور أم بدت هالات","https://www.aldiwan.net/poem24292.html","الكامل"],[567,"أعطي خليل لسابا باز موهبة","https://www.aldiwan.net/poem52687.html","البسيط"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110460","البسيط"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110469","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53910","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54132","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38270","الطويل"],[1485,"","https://poetry.dctabudhabi.ae/diwan/poem/97608","الطويل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141305","الرمل"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126664","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52120","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124726","الوافر"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114772","الطويل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2252,"","https://poetry.dctabudhabi.ae/diwan/poem/198476",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204885","الوافر"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87664","البسيط"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139923","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67988","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62745","الطويل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132093","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119728","الخفيف"],[4163,"","https://poetry.dctabudhabi.ae/diwan/poem/106739","الوافر"],[4315,"","https://poetry.dctabudhabi.ae/diwan/poem/143032","المتقارب"],[4501,"","https://poetry.dctabudhabi.ae/diwan/poem/100705","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52133","الرمل"],[5038,"الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=190147",""],[5183,"ذات الخمارين","https://www.poetsgate.com/ViewPoem.aspx?id=180182",""],[592,"يلوم أناس أن نظمت رواية","https://www.poetsgate.com/ViewPoem.aspx?id=128818",""],[5751,"حزنٌ بلون الفَرَح","https://www.poetsgate.com/ViewPoem.aspx?id=214719",""],[6134,"هنئت يا أمها في طفلة بزغت","https://www.poetsgate.com/ViewPoem.aspx?id=169581",""],[5190,"وليمة رفضت تناولها أعشاب البحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78294&r=&rc=7",""]],"verses":[["فخُطّتْ لتقْويمِ القَوامِ جداوِلٌ","وصحّتْ منَ التّوفيقِ واليُمْنِ أوْفاقُ",0,"ق",1,0],["فَخَطبُ فِلِسطينَ خَطبُ العُلى","وَما كانَ رِزءُ العُلى هَيِّنا",1,"ن",2,0],["فَخَطُّها كَأَنَّهُ","مَشِيُ ضِعافِ العَلَقِ",2,"ق",1,0],["فخطرن في بردين من:","نسج الفصاحة، والدلال",3,"ل",1,0],["فَخطَّ تاريخَهُ فيها يَقولُ بِهِ","يا تُربةَ الوَردِ حَيّاكِ النَدى سَحَرا",4,"ر",2,0],["فَخَطَّ في صفحةِ التّاريخِ زائِرَها","سَقاكَ عَهدُ الرِّضى يا مَنزِلَ الصدَقَهْ",5,"ق",2,0],["فَخَطَّ أَحرُفَ تاريخٍ يَقولُ بِها","عَن مَنزلِ السَعدِ زالَت طَلعَةُ القَمَرِ",6,"ر",1,0],["فَخَطَّ مِن فَوقِ مَثواهُ مُؤرِّخُهُ","وَيحِي عَلى غُصنِ بانٍ في الصِّبا اِنقَصَفا",7,"ف",2,0],["فَخَطَّ سَطراً عَلى التاريخ دَلَّ بِهِ","بِرَحمةِ اللَّهِ فَضلُ اللَّهِ مَصحوبُ",8,"ب",1,0],["فَخَطَّ مِن فَوقِ مَثواهُ مُؤرِّخُهُ","إِني غَريبٌ إِلى مَأوى البَتولِ لَجا",9,"ج",2,0],["فَخَطَّ أَحرُفَ تَأريخٍ يَنوحُ بِها","أَمسى الفَريدُ لَهُ في اللَّحدِ أَمثالُ",10,"ل",1,0],["فخطُّ يراعي مثلُ ضَربِ شِفارِهم","وفوقَ شعارِ الصيدِ شعرُ قصيدتي",11,"ي",1,0],["فَخِطابُهُ وَغِناؤُهُ وَجَوابُهُ","أَشهى إِلى قَلبي مِنَ اللَوزينَجِ",12,"ج",1,0],["فَخَطْأَ من قد صوب الفَنُّ صنعه","كأَرمد ذمَّ الشمسَ وانتقص البدرا",13,"ر",2,0],["فخَطُّ الفَصِّ مَعكوسٌ عَجيبٌ","ويَصدُرُ عنه مَقْرؤٌ سَويّ",14,"ي",1,0],["فخطَطْتُ تحت ظِلالِ عزْك مَنْزلي","وجَعلْتُ وسْطَ حمَى عُلاكَ رُتوعي",15,"ع",2,0],["فَخطُّ الاسْتِواءِ ومَا يليهِ","لحُسنِ العَهدِ مِنها والوَفاءِ",16,"ا",2,0],["فخطيت من زور الخيال بخطرةٍ","في رقدة فله إليّ حباء",17,"ا",2,0],["فَخَطَبْتُ والعَوَّاءُ بَعْضُ منابِرِي","وأَمَمتُ والجوزَاءُ بعض محَاربي",18,"ب",2,0],["فخطبتها من آلها قطب النهى","يسمى لدينا جعفراها صفات",19,"ت",1,0],["فخطَّ راثيهِ تأريخاً يقولُ بهِ","لمثلِهِ ملكوتُ اللهِ قد كُتِبا",20,"ب",2,0],["فخطى قويم الأصل ميل فروعه","يخط خطوطاً أخطأت أصل خطتي",21,"ي",1,0],["فخطَّ من حول مثواهُ مؤَرخُهُ","يا رحمةَ اللهِ حلَّي فوقَ مضجعِه",22,"ه",1,0],["فخطَّت لها أَيدي مؤَرخها دعا","تقول بأَسمى العيش لا بَرحَت أَسمَا",23,"م",2,0],["فخطبي عظيم لو حُبيتُ بِفدْيةٍ","لَصِرْتُ يسيرَ الخطبِ في الأُسراءِ",24,"ا",2,0],["فخطيبهم والقاض ما لهما","كوزيرهم ندٌّ إذا انتقدوا",25,"د",3,0],["فَخطِّئْ حِجىً بِالوردِ شَبَّه خَدَّهُ","وصَوِّبْ حِجىً مَنْ شَبّه الوردَ بالخدِّ",26,"د",1,0],["فَخطّت بأبيات ثلاث نظمتُها","ليبدو لَها خطّي وقلت لها اِنظري",27,"ر",2,0],["فخطا خطوة شهمٍ حازمٍ","وغدا بالعقل والمال غنيّا",28,"ي",2,0],["فخططت في صحف الهوى شطراً شدا","من فرط رقة الفظه القرطاس",29,"س",1,0],["فخطت إليك ودونها","حيٌّ لقاحٌ ايّدُ",30,"د",1,0],["فخطَّ عدادها خطاً وصلى","وقد برت بما فعل النذور",31,"ر",1,0],["فخُطَّ بضاحِي ذلكَ التُّربِ مَضجعي","وذَرني فجارُ القَومِ غَيرُ مُرَوَّعِ",32,"ع",1,0],["فَخِطَابُه نَصٌ لَدَيهم قَاطِعٌ","فِيمَا أُريدَ بِهِ مِنَ التِّبيَانِ",33,"ن",1,0],["فخُطَاكَ في الإصْلاَحِ مَكْرُمَةٌ","وَرشَادُكَ المعهُودُ لَمْ يَخِبِ",34,"ب",1,0],["فخط الشعر واضطربت يداه","لدنْ هزته بالأشعار روحي",35,"ح",2,0],["فخطَّ في اسطر التأريخ راسمُها","من فوق عرش العُلى هيلانةٌ مَلِكَه",36,"ك",2,0],["فخطبْنَ لي في بيتِ حُسنٍ قلنَ لي","وكذبنَ بلْ هوَ بيت قبحٍ شائعِ",37,"ع",1,0],["فخطتي فِي الهوى بَيْنَ الورى مثلاً","من دونها هِممُ العشاقِ تزدحِم",38,"م",1,0],["فخُطّةَ ضيمٍ أبَيْتُ وليلَةً","سريتُ فكانَ المجدُ ما أنا صانِعُ",39,"ع",1,0],["فخط كلاماً في الصحيفة نصه","لقد مات شخص في البلاد كبير",40,"ر",1,0],["فخطابي له وليس بغيب","فإن كل مسلمٍ مرحومُ",41,"م",1,0],["فَخطُّكَ فيهِ أَبهى مِن سَوادٍ","يَروقُ الطَرفَ مِن حَدَقٍ مِراضِ",42,"ض",1,0],["فخط تسنن في زيه","وخد من الشيع الغاليه",43,"ه",1,0],["فخططنا إلى منازل قوم","صرعتهم قبل المذاق الشمول",44,"ل",1,0],["فخطَبناك لذي مالٍ كثير","لتكوني ملجأ نأوي إليه",45,"ه",1,0],["فخُطى الشّهيدِ تجسّدتْ مثلاً","أخّرْ هواكَ وقدّمِ الصّبْرا",46,"ر",2,0],["فخطوا ولكن من كريم نجيعه","على الكون درساً من تلقاه يبهر",47,"ر",1,0],["فخطب جسيم وهو ليس بواحد","فكم لامه من جاهل غير عالم",48,"م",1,0],["فَخَطا مَسافاتٍ طوالاً عندَما","أغْرَتْ حُلولُ الاختصارِ سِواءَهُ",49,"ا",3,0],["فخط مولدها بالسعد مقترن","سقياً لها نعمة تمت بها النعم",50,"م",1,0],["فَخُطُّوا باليراعةِ قولَ حقٍّ","تزينونَ الصحيفةُ والكتابا",51,"ب",2,0]]}