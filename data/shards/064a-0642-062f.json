 أرقي","https://www.poetsgate.com/ViewPoem.aspx?id=143426",""],[5866,"مدح القبيلة","https://www.poetsgate.com/ViewPoem.aspx?id=182810",""],[5956,"بنيَّ سعادتَه المنجزاتُ","https://www.poetsgate.com/ViewPoem.aspx?id=192380",""],[5956,"انتبه يا جدّي","https://www.poetsgate.com/ViewPoem.aspx?id=193954",""],[5961,"مريد الحق","https://www.poetsgate.com/ViewPoem.aspx?id=199770",""],[6102,"تحاميل","https://www.poetsgate.com/ViewPoem.aspx?id=183310",""],[406,"أنشودة الفجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1117&r=&rc=61",""],[463,"يا وحشة َ المجدِ ثقي بالأنسِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60105&r=&rc=161",""]],"verses":[["يَقُدُّ إِذا ما نَبا العاجِزونَ","وَضَربُ الظُبى غَيرُ ضَربِ القُدُم",0,"م",1,0],["يُقدِمُ الباسِلُ الأَبِيُّ عَلى الحَت","فِ وَفيهِ عَنِ الهَوانِ نُكوصُ",1,"ص",1,0],["يُقَدِّرُ أَنَّ المُلكَ طوعُ يَمينِهِ","وَمِن دونِ ما يَرجو المُقَدِّرُ أَقدارُ",2,"ر",1,0],["يُقدِمنَ إِقدامَ الجُيوشِ وَباطِلٌ","أَن يَنهَزِمنَ هَزائِمَ الأَجنادِ",3,"د",1,0],["يَقدُّونَ الدُّروعَ بمُرْهَفاتٍ","تُجَعْجِعُ بالخَميسِ الأُدْجُوانِ",4,"ن",1,0],["يُقَدِّمُ مَنْ يَنالُ النَّقْصُ مِنْهُ","ويَحرِمُ كُلَّ مَنْ رُزِقَ الكَمالا",5,"ل",2,0],["يُقَدِّمُهُ فَتىً مِن خَيرِ عَبسٍ","أَبوهُ وَأُمُّهُ مِن آلِ حامِ",6,"م",1,0],["يُقَدِّمُ أَفواهَ الكُؤوسِ بِتُفّاحِ","إِذا طَلَعَت في راحِهِ أَنجُمُ الراحِ",7,"ح",1,0],["يُقَدِّمُها لِلمَوتِ حَتَّى لَبانُها","مِنَ الطَعنِ نَضّاحُ الجَدِيّاتِ أَحمَرٌ",8,"ر",1,0],["يُقَدُّ عَلى مُعَرقَبِها سَلاها","كَقَدِّ البُردِ أَنهَجَ فَاِستَطارا",9,"ر",2,0],["يَقدُمها طائر قوادمه","تلمع كالبرق حين يلتهب",10,"ب",1,0],["يقدَّم فيهم الشِرّير دفعاً","لشِرَّته ويُحتقَر الأديب",11,"ب",1,0],["يقدحُ في أفقِ العلى زنده","وليسَ من يقدح في زنده",12,"د",2,0],["يقدّم في أهل العلى شرف اسمه","كما قدَّم الاسم النحاةُ على الفعل",13,"ل",1,0],["يقد وضعَ الأسى دمعاً عليها","وقد طلعت شجون من ثنايا",14,"ا",3,0],["يقدحُ الصبحَ في الظلام ويأبى","أن يُرى في فِنائه الإمساءُ",15,"ا",2,0],["يقدح في أثْلَتي وينحتُها","من غير وتْرٍ علمته حَقَدَهْ",16,"د",2,0],["يَقُدنَ وَلا يُقَدنَ لِكُلِّ غَيثٍ","وَفي رَأسٍ يَسِرنَ وَيَنتَوينا",17,"ن",2,0],["يُقَدِّمُها وَقَد خُضِبَت شَواها","فَتىً تَرمي الحُروبُ بِهِ الحُروبا",18,"ب",2,0],["يَقُدنَ الفَناءَ غَداةَ اللِقاءِ","إِلى كُلِّ جَيشٍ كَثيرِ العَديدِ",19,"د",1,0],["يَقُدُّ عِداها بِلا ضارِبٍ","وَيَسري إِلَيهِم بِلا حامِلِ",20,"ل",1,0],["يقدِّمُها والجدُّ يَضمنُ أنه","متى ما التقَى الزحفانِ أوّلُ غالبِ",21,"ب",1,0],["يُقَدِّرُ فيها صانِعٌ مُتَعَمِّلٌ","لِإِحكامِها تَقديرَ داوُدَ في السَردِ",22,"د",1,0],["يُقَدِّرُ الإِنسانُ في نَفسِهِ","أَمراً وَيَأباهُ عَلَيهِ القَضا",23,"ا",1,0],["يقدّمُ الأبطال في جحفلٍ","والطيرُ والوحشُ له جحفلان",24,"ن",1,0],["يُقدِمُ ما بين العوالي إذا","ما نكلَ المقدامُ عنه وَخَام",25,"م",1,0],["يَقدحُ ناراً من زنادِ بَرْقِهِ","ويطفئُ الغيثُ سريعاً ما قَدَح",26,"ح",1,0],["يقدّمُهُ للوغى مِحْرَبٌ","كأنّ الغَضنْفَرَ في نَثْلَته",27,"ت",2,0],["يَقُدْنَ زِمَامَ النَّفْسِ وَهْيَ أَبِيَّةٌ","وَيَخْدَعْنَ لُبَّ الْمَرْءِ وَهْوَ حَكِيمُ",28,"م",1,0],["يَقْدِرُ العلمُ إذا سَالَمَهُ","وَهْوَ إن عَادَاه ذُو عجزٍ وأَيْنْ",29,"ن",1,0],["يُقَدّمُهَا للطّعْنِ كلّ شَمَرْدَلٍ","على كُلّ خَوّارِ العِنانِ مطَهَّم",30,"م",1,0],["يُقَدنَ مَعَ اِمرِئٍ يَدَعُ الهُوَينا","وَيَعمِدُ لِلمُهِمّاتِ العِظامِ",31,"م",1,0],["يَقدِرُ أَن يُسكِنَني رَوضَةً","فيها تَرامى بِالمِياهِ العِذاب",32,"ب",1,0],["يَقدِرُ اللَهُ أَن تَرى كِفرَ طابٍ","حَولَها العاصي أَو المَيّاسِ",33,"س",1,0],["يقدر لي كفوا فإن جئته نكى","وكان إلى وادي جهنم سائقي",34,"ق",2,0],["يَقدُرُ الشيءَ مُعَانِي كَسْبِهِ","فَإِذَا مَا هَانَ كَسْباً هَانَ خسْرَا",35,"ر",2,0],["يُقَدْنَ مَعَ امرىء ٍ يَدَعُ الهُوَيْنا،","ويعمدُ للمهماتِ العظامِ",36,"م",1,0],["يَقدحُ نارا من زِنادِ بَرْقِهِ","ويطفىء الغيث سريعاً ما قدحْ",37,"ح",1,0],["يَقدُمُهُنَّ الرَأسُ في قَناتِهِ","هَدِيَّةً إِلى الدَعِيِّ اِبنِ الدَعِي",38,"ع",2,0],["يُقدِمُ وَالأَقدامُ مِن","خَوفِ الرَدى تَزَلزَلُ",39,"ل",1,0],["يقدم تيها فنستوي ادبا","ليت حمامي قبيل مقدمه",40,"م",2,0],["يقدمني عزمي وحظي مؤخري","ويوصلني حزمي ودهري يقطع",41,"ع",1,0],["يقدمها السعد حيث يقدمها","أنت ونجح الدباق بالأسد",42,"د",1,0],["يَقُدُّ قُلوبَهُمُ حُبُّهُ","بِسَيفِ اللَواحِظِ قَدَّ الشِّراكِ",43,"ك",1,0],["يقدس لذة الألم","ويعبد بهجة الكدر",44,"ر",1,0],["يُقدِّرُ قومٌ أنّه فَتْحُ مَعْقِلٍ","وما هو إلاّ فَتْحُ كُلِّ المَعاقل",45,"ل",1,0],["يقدّ به الهام ممَّن عَصاه","وَيَفلق في شفرتيه القمم",46,"م",1,0],["يُقَدِّمُ لْلمَقْدُورِ دَهْرٌ مُعانِدٌ","سِواكَ إلَيْها ظالِماً وَيُؤَخِّرُكْ",47,"ك",1,0],["يقدر الشياء قدرا صادقا","ويرى الوقت تراثا كشفه",48,"ف",2,0],["يقدُمها يُهدي السرو","رَ ملئَها واليُمنا",49,"ن",2,0],["يقدحُ زَندُ الجَنوب جذوتَها","وسُدفةُ الليل تحتها فحمُ",50,"م",1,0],["يقدَمُ فخرُ الملكِ ثمّ تنجلي","غاشيةُ الليل إذا الصبُح قدِمْ",51,"م",1,0],["يقدُمن واضحةَ الجبي","ن تشُقُّ غرَّتُها الظلاما",52,"م",2,0],["يقدَحُ للوفد بها بشرَه","شعشعةَ البارقِ في الوابلِ",53,"ل",1,0],["يقدُمها منكم همامُ غابةٍ","يعلِّم الطعنَ الأشلَّ الأعزلا",54,"ل",2,0],["يُقدِمُ إما مبلغاً نفسَه","معذرةً أو بالغاً ما أرادْ",55,"د",1,0],["يَقُدُّ شَباهُ كلَّ تَركٍ ونَثْرةٍ","ويجْلو سَناهُ كلَّ داجٍ وماتِع",56,"ع",1,0],["يَقُدُّ قَلبي بِالَّذي","يَهُزُّهُ مِن قَدِّهِ",57,"د",2,0],["يقدمه في رتبة البأس والندى","لسان إذا عد الكرام وخنصر",58,"ر",1,0],["يُقَدِّمونَ قَضا حَاجِ الصَّديقِ عَلَى","حاجَاتِهِمْ إِذْ رَأَوْهُ بَعْضَ ما يَجِبُ",59,"ب",1,0],["يُقَدْن إلى أرضِ العدوّ عوارياً","فتدخل في نسج الثّرى في غلائلِ",60,"ل",1,0],["يقدِّر وصْلاً بعْد فصْل لِذاتِه","وفرض مسافات يجذلها الدهنا",61,"ن",2,0],["يُقَدّمُ جيشَ الرُعبِ قبلَ جيُوشهِ","نذيراً وإن عادت فغيرُ مرافقِ",62,"ق",1,0],["يَقُدُّ إِنْ أَعْمَلْتَهُ","طُوَلاً وَإِنْ عَارَضَ قَطْ",63,"ط",1,0],["يقدمه في البيض والدلاص","عمرو بن سعد بن أبي وقاص",64,"ص",1,0],["يقدر ما أَهلَكْتَ من كافرٍ","أَو فكما أَحيَيْتَ من مُسْلِمِ",65,"م",1,0],["يُقَدَّرُ فيها العِلمُ ما هُوَ كاسِبٌ","وَيَعرِفُ فيها الفَضلَ ما هُوَ غانِمُ",66,"م",1,0],["يُقَدِّمُها عَمرو القَنا في الفَجرِ","إِلى أُناسِ لَهَجوا بِالكُفرِ",67,"ر",1,0],["يقدح النجم لعيني شررا","ولزند الشوق في الاحشاء قدح",68,"ح",1,0],["يقدّم الرفدَ قبل الوعدِ مبتدئاً","يخالُ تأخيرَهُ من بعده فُحُشا",69,"ش",2,0],["يَقدُّ الهِزَبرَ الضّخمَ طولاً بِضَربةٍ","فَتُبصِرُه نِصفَينِ مِن ذَلكَ القدِّ",70,"د",1,0],["يُقَدِّمُهُ المُحِبُّ لأَريَحيِّ","تَناوَل مِن ذُرا العَليا مَرامَه",71,"م",2,0],["يقدح اللهو زنده في رباها","ويضاهي نسرينها القداحُ",72,"ح",1,0],["يَقدرُ اللَهَ فارِجُ اللَهَ وَاِرضَ بِهِ","فَفي اِرادَتِهِ الغَماءُ تَنفَرِجُ",73,"ج",1,0],["يقدَحُ فِكراً ما خَبتْ ناره","قطُّ ولا تَصْلِد منه الزِّناد",74,"د",1,0],["يقدمهم أسدٌ ضرغامٌ","في الحرب مكيدٌ قهارُ",75,"ر",1,0],["يُقَدِّسُ تقديساً أوامرَكَ التي","يُنَفِّذها مِن بعدِ تَقبيلِهَ عَشرا",76,"ر",2,0],["يُقْدي ويَقْري بِالأصائِلِ والضُّحا","فَأعجَبْ لِفَخْرِ غُدُوِّهِ وَرَوَاحِهِ",77,"ح",2,0],["يقدم الأصغر في قومه","ويرفع المنقوس من قدره",78,"ر",2,0],["يقدمهم كل أخي ذلة","على حمار دابر أعور",79,"ر",1,0],["يقدّسون مليكَ النيلِ في قُدُسٍ","من الجوانح يحكي طور سينينا",80,"ن",2,0],["يُقَدِّمُ جَعفَر أنساً","عَلى أَصحابِهِ قَحما",81,"م",2,0],["يقدم الوفد فيها الحمد منتظماً","نظم الجمان لمولاها ومولانا",82,"ن",2,0],["يقدم وغداً لا مروءة عنده","بتأخير حر فاز بالعلم والأدب",83,"ب",1,1],["يقدمنا فيه إلى المشهد ال","محمود لا نكساً ولا ناكلا",84,"ل",2,0],["يقدك شهمٌ بيوم الروع همته","أن يترك الخصم طعم البوم والصقر",85,"ر",1,0],["يقدمهم أربعون لبسهُمُ","مع حلية الحرب حلة النمر",86,"ر",1,0],["يقدحُ الدَّهرُ في شماريخ رضوى","ويحط الصُّخورَ من هبودِ",87,"د",1,0],["يقدحُ الخطبَ وهو يبْدُو ابتساماً","يقصُرُ الخطبُ عنه وهو الوفيُّ",88,"ي",1,0],["يقد مشك المعضلات مهند","بيمناه من فيض المكارم قابس",89,"س",1,0],["يُقَدِّرُ باللُقيا سريعاً فأنثَنى","وقَد قَرَّ من لُقيا حبيبِ الحشا عينا",90,"ن",2,0],["يقدمها أروع ذو نجدة","إذا غدا في طلب المجد راحْ",91,"ح",1,0],["يقدمه يوم كل معركة","أغلب عادات جيشه الغلب",92,"ب",1,0],["يقدمها الغازي الغياث الذي","شاد لدين الله أركانا",93,"ن",2,0],["يُقَدَّمون للعذاب أولاً","وربما أتيت في الأخير",94,"ر",1,0],["يُقدِمُني مِنكَ عَصاً ضَخمَةٌ","مَلَساءُ ما في قَدِّها مِن أَوَد",95,"د",1,0],["يُقَدِّمُ دونَ مَوقِفِ صاحِبَيهِ","بِقَدرِ جَمالِ ذاكَ وَقُبحِ ذَينِ",96,"ن",1,0],["يُقدِ