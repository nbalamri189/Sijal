{"poems":[[87,"حف كأسها الحبب","https://www.aldiwan.net/poem63726.html","المقتضب"],[47,"دع دموعي في ذلك الاشتياق","https://www.aldiwan.net/poem65177.html","الخفيف"],[63,"أخلق بغائب رشده أن يقدما","https://www.aldiwan.net/poem51455.html","الكامل"],[104,"هادئ القلب مطبق الأجفان","https://www.aldiwan.net/poem33126.html","الخفيف"],[48,"أنوار تحسب من سنا الأنوار","https://www.aldiwan.net/poem22703.html","الكامل"],[102,"شاعر الكأس والرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=50185",""],[47,"دَعْ دُمُوعي في ذَلِكَ الإشْتِياقِ","https://www.poetsgate.com/ViewPoem.aspx?id=32834",""],[132,"من لصب تصاعدت حسراته","https://www.aldiwan.net/poem50653.html","الخفيف"],[136,"فت بين الرباب في العين صابا","https://www.aldiwan.net/poem54893.html","الطويل"],[141,"أشهد الله والملائكة الأبرار","https://www.aldiwan.net/poem68020.html","الخفيف"],[164,"بشراك بشراك هبت نسمة الفلق","https://www.aldiwan.net/poem59101.html","البسيط"],[230,"كم تهيم كم تجب","https://www.aldiwan.net/poem55209.html","المقتضب"],[333,"رتل البلبل الطروب لحونه","https://www.aldiwan.net/poem55066.html","الخفيف"],[369,"أسعداني في الحب ما تعلمان","https://www.aldiwan.net/poem60609.html","الخفيف"],[369,"سل صدور الركاب ماذا الحنين","https://www.aldiwan.net/poem60627.html","الخفيف"],[376,"ما لريم الكناس ليس يريم","https://www.aldiwan.net/poem57152.html","الخفيف"],[376,"لمن العيس أصبحت مستقله","https://www.aldiwan.net/poem57189.html","الخفيف"],[415,"لقد عم جود الأفضل السيد الورى","https://www.aldiwan.net/poem32227.html","الطويل"],[422,"طرقت أسماء في جنح الظلام","https://www.aldiwan.net/poem54040.html","الرمل"],[438,"نزلوا فادعوا نزال نزال","https://www.aldiwan.net/poem12343.html","الخفيف"],[469,"ولهي في الهوى حديث قديم","https://www.aldiwan.net/poem3279.html","عموديه"],[469,"لله كانون وقانا لفحه","https://www.aldiwan.net/poem3561.html","عموديه"],[500,"اذهب الكاس فعرف الفجر","https://www.aldiwan.net/poem9813.html","مجزوء الرمل"],[556,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70921","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70890","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62504","الرمل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96717","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127989","الخفيف"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131337","الرجز"],[2437,"","https://poetry.dctabudhabi.ae/diwan/poem/127804","الكامل"],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105407","الكامل"],[2565,"","https://poetry.dctabudhabi.ae/diwan/poem/103764","الرمل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100924","الكامل"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121153","السريع"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93811","الخفيف"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112409","الرمل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108409",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91640","الخفيف"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/89996","الكامل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29303","الخفيف"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75712","الرمل"],[3977,"","https://poetry.dctabudhabi.ae/diwan/poem/99146","الوافر"],[4085,"","https://poetry.dctabudhabi.ae/diwan/poem/105155","السريع"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35056","الرمل"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35047","الرمل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133115","المجتث"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66154","الرجز"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139522",""],[3591,"هي الحسان أراقت مهجة البطل","https://www.poetsgate.com/ViewPoem.aspx?id=149410",""],[5121,"مَسَاءُ الشُّعُورِ","https://www.poetsgate.com/ViewPoem.aspx?id=56463",""],[5213,"أترى شملنا يكون جميعا","https://www.poetsgate.com/ViewPoem.aspx?id=170499",""],[5582,"قِفْ وَسَلِّمْ فِي مَغانِي ذِي سَلَمْ","https://www.poetsgate.com/ViewPoem.aspx?id=63570",""],[5743,"رمال عطشى","https://www.poetsgate.com/ViewPoem.aspx?id=202314",""],[6134,"ذو العقل يسمو بالحجى ويسود","https://www.poetsgate.com/ViewPoem.aspx?id=169542",""],[469,"السحب رايات ولمع بروقها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574778",""],[6251,"الرِّسَالَة ُالخَامِسَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76491&r=&rc=31",""],[5396,"الميلاد ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65508&r=&rc=7",""]],"verses":[["وَالنَدى سَجِيَّتُهُ","وَالحَنانُ وَالحَدَبُ",0,"ب",1,0],["وَالنَدى الصامِتِيُّ وَالمَلِكُ الأَبلَ","جُ في أُخرَياتِ الرِواقِ",1,"ق",1,0],["والنَّدبُ من لَقِيَ الأسنَّةَ سافراً","وثَنى الأعنَّةَ بالعَجاجِ مُلَثَّما",2,"م",2,0],["وَالنَدامى بَينَ الكُؤوس قيام","رَنحتهم مدامة الغدران",3,"ن",1,0],["وَالنَدبُ في حُكمِ الهِدانِ وَذو الصِبا","كَأَخي النُبهى وَالذِمرُ كَالعُوّارِ",4,"ر",1,0],["والندامى الصباح بين يديه","وكؤوس تنأى وأخرى تدانى",5,"ن",2,0],["وَالنّدَى الصّامِتيَّ وَالمَلِكَ الأبْ","لَخَ في أُخْرَياتِ ذاكَ الرُّوَاقِ",6,"ق",1,0],["والنَّدَى والإنعامُ والفضلُ والإ","حسانُ والمجدُ والعُلا عاداتُه",7,"ت",2,0],["والندىَّ المُفَرِّجَ الكُرَبَ الدَّا","فِعَ ما يُختَشَى المصيبَ الصَّوابَا",8,"ب",2,0],["وَالنَديمَ الكَريمَ وَالخادِمَ الفا","رِهِ يَسعى عَلَيَّ بِالأَقداحِ",9,"ح",1,0],["والند غيم وماء الورد وابله","والراح في الكأس يحكى البرق في اللهق",10,"ق",1,0],["وَالنَدِيُّ تَمرَحُ في","هِ القَصائِدُ القُشُبُ",11,"ب",1,0],["والندى من مدامع الغيب مسكو","ب على هامة الخيال الحنونه",12,"ن",2,0],["والنَّدامَى في مَجْلسٍ أَدَبيٍّ","غائبِ الرّاحِ شاهِدِ الرَّيْحان",13,"ن",1,0],["والنّدى من أَمامِه راكبٌ يَحْ","جُبُ والشَّأْوُ في العطاء بَطين",14,"ن",1,0],["والنَّدى كالهَوى إِذا مَلَكَ الإن","سانُ لم يَثنِ عَزمَه مَن يَلومُ",15,"م",1,0],["والنّدى والعُلى خَلائِقُ قَومٍ","جُبلَت في طِباعِهم والجِبِلَّه",16,"ل",2,0],["والنّدى طبعُك الكريمُ فما أه","نى نوالاً تُنيلُه وتُثيبُ",17,"ب",1,0],["والندامى مثل أزهار الرُّبا","يُجتَنى من لفظها زَهْرُ الكلام",18,"م",1,0],["والنَّدِيُّ الذي يرِفُّ عليهِ","نَضْرَةٌ من أَزاهِرِ الآمالِ",19,"ل",1,0],["والندامى تبني سماءَ مدامٍ","طلعت للحباب فيها نجوم",20,"م",1,0],["والندُّ قسطلهُ وزهرُ شموعنا","صمُّ القنا والفحم نبيلٌ مذهب",21,"ب",1,0],["والندى والخلق الطا","هر والوجه الصبيح",22,"ح",1,0],["والنّدْبُ فسلٌ في الزّمان إذا","أهوى له والواهنُ الجَلْدُ",23,"د",1,0],["والندل يرغب أن يقهقر نفسه","عن طبعها لولا المشقة في الفِطام",24,"م",1,0],["والندامى فيهم عزيزٌ يدارى","وغريرٌ في أمرنا لا يدارَى",25,"ر",2,0],["والنّدى ما انهل إلا","رفرفت بين النَّدامى",26,"م",2,0],["وَالندى في الروضِ كاللؤلؤ والر","روضِ في الزهرِ منير مُبتسم",27,"م",1,0],["والندى عادَ إلى منبعِه","بسِراجي شرفٍ قد أذهبا",28,"ب",2,0],["والندا جاده سحير فأضحى","جيد أغصانه بدر مقلد",29,"د",1,0],["والنّدُّ والعَنْبَرُ والمِسْكُ السّحيقْ","مشتعلٌ بالنّارِ في طولِ الطَّرِيقْ",30,"ق",1,0],["والندب اسماعيل امسى نادبا","يبكي ترجى النصر منهُ ودرهمُ",31,"م",1,0],["والندب جعفر ذو العلى عن نعته","قصرت لعمري دونه الأوهام",32,"م",1,0],["والندى في الزهر منثو","ر على عقم منظم",33,"م",1,0],["والندوةُ البيضاءُ وهى مباحةُ","مُلِكت مذاهبُها على الضيفان",34,"ن",1,0],["والنَّدبُ لا يصرف عن مقصدٍ","وجهاً وكان الخير في المقصد",35,"د",1,0],["والندامى تظل شمس الحميا","بينهم تنجلي وهم في ظلال",36,"ل",1,0],["والنّدى من فوقِ أغصان الشجر","لؤلؤ تجمعهُ شمسُ الصَباح",37,"ح",1,0],["والندبُ من عصفت به نكباؤُهُ","فرمتهُ من اعلى مقام سعوده",38,"د",2,0],["وَالندامى وَمجلسِ الأنسِ يَزهى","بتدانٍ وَغرّةٍ وَتهانِ",39,"ن",1,0],["وَالنَديمُ المديرُ بدرٌ بهيٌّ","مشرقٌ وَجهُه عَلى غُصنِ بان",39,"ن",1,0],["والند مضروب السَّرادق","بالعبير حشوتُه",40,"ت",2,0],["وَالنَدى وَالظِلالُ تَنعِسُ في الما","ءِ وَهذا الشُعاعُ خَلفَ الغِمامِ",41,"م",1,0],["وَالنَدى الساقِط من جو السَما","صارَ دَمعاً في عيون النرجس",42,"س",1,0],["وألندّ الغرام المحض منه","وأستحلي به حتى كروبي",43,"ب",2,0],["والندب إبراهيم أسخى فتى","يمنّ قبل السؤل مناً بلا",44,"ل",2,0],["وَالندى مِن فوقه حسير","إِن كالدّمعِ تصعّب",45,"ب",1,0],["وَالندى مِن فَوقهِ حي","رانَ كالدمعِ تَصعّب",46,"ب",1,0],["والندب الخطيب","ذي الوعل صافي مكمل",47,"ل",1,0],["والنَّدْبُ مَنْ كانَ المعالي هَمُّهُ","يَسْعَى اليها تَحْتَ اطْباقِ الدُّجا",48,"ا",1,0],["والندى انهال كودقٍ واكف","بالأماني من أعالي الكثب",49,"ب",1,0],["والندب تعقله عن زلة شيم","بقيدهنَّ جهول غيرُ معتقلِ",50,"ل",1,0],["وَالنَّدَى يَحْبُو مِثْلَ طِفْلٍ فَيَغْفُو","طَيَّ حِضْنٍ مِنَ الْخَمِيِلِ يَحُورُ",51,"ر",1,0],["والندامى تتلو الاناشيد فيها","بمديح الهادي وكنت السميعا",52,"ع",2,0],["وَالنَّدَى فِي الرَّوْضِ كاللُّؤْلُؤِ وَال","رَّوْضُ بِالزَّهْرِ مُنِيرٌ مُبْتَسِمْ",53,"م",1,0],["والندى في الرياض فيضُ دموع","من جفون لنا أبت أن تناما",54,"م",2,0],["والندب من نال الفخار وزانه","بالجد اباء له وجدود",55,"د",1,0],["والندُّ قسطله وزُهر شموعِنا","صمُّ القنا والفحمُ نَبلٌ مُذهبُ",56,"ب",1,0],["والنَّدَامَاتُ لنْ تَعُودَ بِحُبٍ","سُحُبِيٍ في غَيْمِهِ قد نَدِيْنَا",57,"ن",2,0],["والنّدى الإنسان في سنبلة","حلمه في ساقها يقتتل",58,"ل",1,0]]}