{"poems":[[85,"زار الخيال بأيمن الزوراء","https://www.aldiwan.net/poem54344.html","الطويل"],[53,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[50,"ومعتد بالذي تحوي أنامله","https://www.aldiwan.net/poem64499.html","البسيط"],[308,"نادمته والثريا في مطالعها","https://www.aldiwan.net/poem57853.html","البسيط"],[354,"ما أومض البرق بين الطلع والبان","https://www.aldiwan.net/poem15981.html","البسيط"],[435,"لما بدا بدر الجمال بعجبه","https://www.aldiwan.net/poem41050.html","الكامل"],[445,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[558,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[567,"زر تربة في الحمى يا أيها المطر","https://www.aldiwan.net/poem52838.html","البسيط"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2446","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86639","الكامل"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100147","البسيط"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75784","البسيط"],[2172,"","https://poetry.dctabudhabi.ae/diwan/poem/18697","البسيط"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81288","المنسرح"],[4767,"مرايا الحب","https://www.poetsgate.com/ViewPoem.aspx?id=215048",""],[4935,"إني تخذت من العفاف شعاراً","https://www.poetsgate.com/ViewPoem.aspx?id=129338",""],[4994,"ريّانةُ الأثرِ","https://www.poetsgate.com/ViewPoem.aspx?id=211225",""],[5213,"ما كنت أحسب والأيام غالبة","https://www.poetsgate.com/ViewPoem.aspx?id=170441",""],[5410,"يا قلب","https://www.poetsgate.com/ViewPoem.aspx?id=152253",""],[5956,"أحسِنْ إلى الفقراء وابعدْ عنهمو","https://www.poetsgate.com/ViewPoem.aspx?id=207268",""],[5724,"بيارق النصر رفي فوق وادينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55137&r=&rc=4",""],[6318,"لغتي الجميلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66157&r=&rc=7",""],[5190,"وصية شهيد فلسطيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78343&r=&rc=56",""]],"verses":[["حتى أفاقَ الصبحُ من غمراتِهِ","وتجاذبَتُ أَيْدي النسيم ردائي",0,"ا",2,0],["حتى أفأتَ عليهم ظلَّ نعمتهم","عَوداً كما فاء ظلٌّ بعدما مَصحا",1,"ح",2,0],["حَتّى اِفتَدى حَياتَهُ وَأَدّى","مالاً يَهُدُّ الحامِلينَ هَدّا",2,"د",2,0],["حَتّى أَفاقَ وَثَوبُ اللَيلِ مُنخَرِقٌ","وَغارَ نَجمُ الثُرَيّا وَاِعتَلى زُحَلُ",3,"ل",1,0],["حتى أفاق صباح الأفق ثم بدا","بوجه زنجيةٍ باللاذ منتقب",4,"ب",1,0],["حَتّى اِفتَرَقنا فيا لِلَّهِ ما سَفَحَت","بِجَفوَةِ البَينِ يَومَ السَفحِ أَجفاني",5,"ن",2,0],["حتى أفوز بقبلة من ثغره","عند الوداع ومثلها عند اللقا",6,"ق",2,0],["حَتَّى افْتَتَحْتُ عَنِ الأَحِبَّةِ مَعْقِلاً","وَعْر المسالِكِ مُبْهَم الأَبْوَابِ",7,"ب",1,0],["حَتّى اِفتَرَعتَ بِها السِهامَ وَدونَها","طَعنٌ بِأَعجازِ القَنا المُتَقَصِّدِ",8,"د",1,0],["حتى أفاضوا إلى أرضٍ مباركةٍ","تُتْلَى بها فوقَهُ الأورادُ والسُّوَرُ",9,"ر",1,0],["حَتّى أُفَجِّعَهُم بِإِخوَتِهِم","وَأَسوقَ نِسوَتَهُم بِنِسوَتِيَه",10,"ي",2,0],["حَتّى اِفتَخرتُ بِمَدح أَعلى سَيدٍ","حامي حِمى أَقطارنا عالي الحَسَب",11,"ب",1,0],["حتى أفاض عليها من غلائله","عزاً وزر عليها حلية الحلل",12,"ل",1,0],["حَتّى أَفوز بحج غير ذي رفث","محيّيا خير من يمشي عَلى قدم",13,"م",1,0],["حَتّى أَفيءَ بِها تَدمي مَناسِمُها","مِثلُ البَليَّةِ مِن حلي وَمِن رحَلي",14,"ي",1,1],["حَتّى أَفاضَ الضِياء وَاِنفَجَرَت","عَين مِن النُور شَرَدَت بدعه",15,"ع",2,0],["حتى أفوزَ بجنةٍ","غنَّاءَ طيبةِ الجنَى",16,"ن",2,0],["حتى أفوز من المهيمن بالرضا","في جنة أقضي بها الأوطارا",17,"ر",2,0],["حتّى أفَقنا وحِبرُ الصَّحوِ يَكتُبنا","عَلى أكُفَّ المَدى وَشمَينِ للسَّفَرِ",18,"ر",1,0],["حتى افترقنا فبان الخلف معذرة","هو الشآم افتفى خلف المواعيد",19,"د",1,0],["حتى أفقتَ على خداعٍ لم يَزَلْ","جُرحاً تكابد نزفه مترنِّما",20,"م",2,0],["حتى افتقرتُ إلى السعادة والشِّفا","حتى غدوت وليس لي مَن يُطْعِمُ",21,"م",1,0],["حتى أفقنا وقد صحت عزائمنا","لننشد الحق والأخلاق والدينا",22,"ن",2,0],["حتى أفاءتْ شُعوبُ الأرْضِ تَسألُها","ثوباً لتستُرَ مِنْها السُّوءَ والعِلَلا",23,"ل",2,0],["حتّى أفاءَ الذي نفسي بقبضتِهِ","بها عليَّ ، وجودُ اللهِ يُذَّكَرُ",24,"ر",1,0]]}