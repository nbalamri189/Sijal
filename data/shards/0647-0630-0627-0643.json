{"poems":[[57,"هذا كتاب بدمع عيني","https://www.aldiwan.net/poem26056.html","مجزوء البسيط"],[57,"هذا كتاب فتى لغيبك حافظ","https://www.aldiwan.net/poem26237.html","الكامل"],[57,"يا من شقيت بحبه","https://www.aldiwan.net/poem26464.html","مجزوء الكامل"],[57,"كتب المحب إلى الحبيب رسالة","https://www.aldiwan.net/poem26558.html","الكامل"],[88,"قلم إذا ركب الأنامل أو جرى","https://www.aldiwan.net/poem68880.html","الكامل"],[88,"هذا كتاب مذ بدا سره","https://www.aldiwan.net/poem68884.html","السريع"],[73,"اثنان في الجامع المعمور","https://www.aldiwan.net/poem3774.html","البسيط"],[49,"كيف السبيل إلى طيف يزاوره","https://www.aldiwan.net/poem25289.html","البسيط"],[74,"بث المشيب على الشجي بزاته","https://www.aldiwan.net/poem18390.html","الكامل"],[74,"هل بعد وجهك للرجاء نجاح","https://www.aldiwan.net/poem18487.html","الكامل"],[74,"أستغفر الله لا مالي ولا ولدي","https://www.aldiwan.net/poem18543.html","البسيط"],[74,"لله ظبي كنيسة لاحظته","https://www.aldiwan.net/poem19033.html","الكامل"],[74,"محراب صدغيه يحث توجهي","https://www.aldiwan.net/poem20511.html","الكامل"],[53,"أأبي يوسف دعوة المستصغر","https://www.aldiwan.net/poem63998.html","الكامل"],[53,"هذا كتاب من أخ شاكر","https://www.aldiwan.net/poem66481.html","البسيط"],[72,"هذا كتاب محب","https://www.aldiwan.net/poem42719.html","المجتث"],[72,"هذا كتابي وهو يط","https://www.aldiwan.net/poem42915.html","مجزوء الكامل"],[64,"جاريت في مضمار عمري عصبة","https://www.aldiwan.net/poem52415.html","الكامل"],[47,"هذا كتابك فيه الجهل والعنف","https://www.aldiwan.net/poem65156.html","البسيط"],[47,"أريتك الآن ألمع البروق","https://www.aldiwan.net/poem65178.html","السريع"],[68,"هذا كتاب المثل السائر","https://www.aldiwan.net/poem38508.html","السريع"],[68,"عانده في الحب أعوانه","https://www.aldiwan.net/poem40966.html","السريع"],[46,"هذا كتاب فتى له همم","https://www.aldiwan.net/poem29683.html","الكامل"],[107,"تلك العروبة جرحها يجري دما","https://www.aldiwan.net/poem42060.html","الكامل"],[107,"أقبل عليك من الشعوب سلام","https://www.aldiwan.net/poem42067.html","الكامل"],[107,"ودع ذويك وسر في شأنك الجلل","https://www.aldiwan.net/poem44046.html","البسيط"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[54,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[50,"يا لاعبا بحياتي","https://www.aldiwan.net/poem62469.html","المجتث"],[50,"يا عربيا من صنعة السوق","https://www.aldiwan.net/poem64452.html","المنسرح"],[50,"زنبور يا خنزير يا ابن الزانية","https://www.aldiwan.net/poem66238.html","الكامل"],[48,"قلتم لنا خالق حكيم","https://www.aldiwan.net/poem23137.html","مجزوء البسيط"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30455","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54691","البسيط"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/116946","الكامل"],[111,"مولاي أبشر لن تزال مجيدا","https://www.poetsgate.com/ViewPoem.aspx?id=22693",""],[47,"أرَيْتُكَ الآنَ ألَمْعُ البُرُوقْ","https://www.poetsgate.com/ViewPoem.aspx?id=32839",""],[96,"فلسفة الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=15614",""],[119,"هذا كتاب منزل وزبور","https://www.aldiwan.net/poem41746.html","الكامل"],[139,"ويك اتئد فالحق في الدنيا أحق","https://www.aldiwan.net/poem49039.html","الكامل"],[139,"يا سيدا مهجة المملوك في يده","https://www.aldiwan.net/poem49048.html","البسيط"],[159,"لو قيل هل رجل طالت بليته","https://www.aldiwan.net/poem55512.html","البسيط"],[159,"هذا كتابي إليكم فيه معذرتي","https://www.aldiwan.net/poem55548.html","البسيط"],[164,"أحسنت في تدبير أمرك يا حسن","https://www.aldiwan.net/poem58795.html","الكامل"],[164,"من قلدت عينه في أمره الاذنا","https://www.aldiwan.net/poem59020.html","البسيط"],[186,"هذا كتاب من محب هائم","https://www.aldiwan.net/poem67015.html","الكامل"],[186,"أمقلدا جيدي بعقد نظامه","https://www.aldiwan.net/poem67020.html","الكامل"],[186,"هذا كتاب فصلت آياته","https://www.aldiwan.net/poem67064.html","الكامل"],[189,"لقيت في الحب ما لاقاه من هممى","https://www.aldiwan.net/poem14659.html","البسيط"],[193,"أموا المدينة حيث جل المغنم","https://www.aldiwan.net/poem35107.html","الكامل"],[203,"هذا كتابي قد جعلت مداده","https://www.aldiwan.net/poem45189.html","الكامل"],[208,"قل للغزال الذي في سكة الآسي","https://www.aldiwan.net/poem53113.html","البسيط"],[216,"هذا كتاب شريف رائق حسن","https://www.aldiwan.net/poem37916.html","البسيط"],[243,"الله ربي والحنيفةُ ديني","https://www.aldiwan.net/poem1095.html","الكامل"],[243,"بمحمد صلوا عليه وسلموا","https://www.aldiwan.net/poem23835.html","الكامل"],[263,"هذا كتاب أم بشير سعاد","https://www.aldiwan.net/poem35761.html","الكامل"],[263,"هذا كتاب من محب مغرم","https://www.aldiwan.net/poem35763.html","الرجز"],[301,"هذا كتاب في معانيه حسن","https://www.aldiwan.net/poem32930.html","أحذ الكامل"],[324,"يا أيها الخل الذي لم ينسني","https://www.aldiwan.net/poem61704.html","الكامل"],[324,"الدهر أصبح مشرقا بتجليه","https://www.aldiwan.net/poem67199.html","الكامل"],[357,"هذا كتاب في الحساب لقد حوى","https://www.aldiwan.net/poem40570.html","الكامل"],[357,"يا روضة الأدب التي فيها الأرب","https://www.aldiwan.net/poem40572.html","الكامل"],[370,"عذاره قد سبى طرفي تطرفه","https://www.aldiwan.net/poem17035.html","البسيط"],[370,"شوقا إلى ذاك الجلال ومجتنى","https://www.aldiwan.net/poem17166.html","الكامل"],[381,"أذكرت مسكا من مديحك صائكا","https://www.aldiwan.net/poem59303.html","الكامل"],[407,"هذا كتاب كله جهل","https://www.aldiwan.net/poem33466.html","الكامل"],[407,"الحمد كل الحمد للخلاق","https://www.aldiwan.net/poem33620.html","الكامل"],[413,"هذا كتاب فتى أحلته النوى","https://www.aldiwan.net/poem32249.html","الكامل"],[436,"بأبي وغير أبي الفدا","https://www.aldiwan.net/poem12513.html","مجزوء الكامل"],[445,"هذا هو الرزء الجن والبشرا","https://www.aldiwan.net/poem14454.html","البسيط"],[456,"العيد أنتم إذا ما النجح حالفكم","https://www.aldiwan.net/poem61688.html","البسيط"],[471,"ماذا رميت به من","https://www.aldiwan.net/poem59755.html","المجتث"],[503,"جدي بواسط أوسط القوم الألى","https://www.aldiwan.net/poem38041.html","الكامل"],[541,"أهلا بجرح ليته يتكرر","https://www.aldiwan.net/poem48144.html","عموديه"],[565,"هذا كريم باسم أحمد قد أتى","https://www.aldiwan.net/poem52637.html","الكامل"],[589,"ما بين هجرك والنوى","https://www.aldiwan.net/poem18025.html","مجزوء الكامل"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/12036","البسيط"],[1185,"","https://poetry.dctabudhabi.ae/diwan/poem/20866","البسيط"],[880,"يا دار عمرة","https://www.poetsgate.com/ViewPoem.aspx?id=1423",""]],"verses":[["هَذا كِتابٌ بِدَمعِ عَيني","أَملاهُ قَلبي عَلى بَناني",0,"ن",2,1],["هَذا كِتابُ فَتىً لِغَيبِكِ حافِظٍ","كَلِفٍ بِذِكرِكِ يا ظُلَيمَةُ مُدنَفِ",1,"ف",1,1],["هَذا كِتابي قَد أَتا","كِ بِما أُرَدِّدُ في الكِتابِ",2,"ب",1,0],["هَذا كِتابٌ نَحوَكُم أَرسَلتُهُ","يَبكي السَميعُ لَهُ وَيَبكي مَن قَرا",3,"ا",1,0],["هَذا كِتابُكَ قَد حَكَت آياتُهُ","آياتِ موسى التِسعِ في الإِكبارِ",4,"ر",1,0],["هَذا كِتابٌ مَذ بَدا سِرُّهُ","لِلناسِ قالوا مُعجِزٌ ثاني",5,"ي",1,1],["هَذاكَ قَد أَنِفَ الفُسّاقُ مِنهُ وَذا","تُتلى عَلَيهِ مَساويهِ فَيَبتَهِجُ",6,"ج",1,0],["هَذا كِتابُ مَشوقِ القَلبِ مُكتَئِبٍ","لَم يَألُ ناظِمُهُ جُهداً وَناثِرُهُ",7,"ر",2,0],["هذاك قد خصف الحيا أوراقه","وأنا الذي هشم الجفاءُ نباته",8,"ت",2,0],["هذاك عوَّام بدمعِه وذا","حدّ الهموم لقلبهِ جراح",9,"ح",1,0],["هذا كلامي وذا حظِّي فيا عجباً","منِّي لثروةِ لفظٍ وافْتقارِ يدِ",10,"د",1,0],["هذاك أحيى الناس من موتٍ وذا","في الحبِّ قد وافى بموت الناس",11,"س",1,0],["هذاك أصلهم وهذا فرعهم","أعظم بفضلِ المبتدِي والمنتهي",12,"ه",2,0],["هَذاكَ ديْدَنُها وذلك دَيْدَني","حتى بدا فلقُ الصباح المسفرِ",13,"ر",1,0],["هذا كتابٌ من أخ شاكرٍ","نُعماك يرجوك لريبِ الزمانْ",14,"ن",1,1],["هَذا كِتابُ مُحِبٍّ","قَد زادَ فيكَ غَرامُه",15,"م",2,1],["هَذا كِتابي وَهُوَ يُط","لِعُكُم عَلى حالي وَضَرّي",16,"ر",2,1],["هذاكَ مركوبي وتلكَ جنيبتي","بهما قطعتُ مسافةَ العُمْرِ",17,"ر",1,0],["هَذا كِتابُكَ فيهِ الجَهلُ وَالعُنفُ","قَد جاءَنا فَفَهِمنا كُلَّ ماتَصِفُ",18,"ف",1,1],["هَذاكَ قَد بَرَّزَ حُسنِهِ","سَبقاً وَهَذا مُسرِعٌ في اللُحوق",19,"ق",1,0],["هَذا كِتابُ المَثَلِ السائِرِ","في أَدَبِ الكاتِبِ وَالشاعِرِ",20,"ر",1,1],["هَذا كِتابٌ ناطِقٌ بِالعُلى","وَهَذِهِ الرُتبَةُ عُنوانُه",21,"ن",2,0],["هَذا كِتابُ فَتىً لَهُ هِمَمٌ","ساقَت إِلَيكَ رَجاءَهُ هِمَمُه",22,"م",2,1],["هذا كِتابُكِ ليس يبلغُ شأوَهُ","مَن نَمَّقَ الكُتْبَ الحِسانَ ونمنما",23,"م",2,0],["هذا كتابٌ للحياةِ مُفصَّلٌ","وَضُحَتْ به الآياتُ والأحكامُ",24,"م",1,0],["هذا كتابُ رَسولِ اللهِ يُنذره","فاذهبْ إليه وخُذْهُ غيرَ مُحتفلِ",25,"ل",1,0],["هَذا كِتابُ سِيَرِ الإِمامِ","مُهَذَّباً مِن جَوهَرِ الكَلامِ",26,"م",1,0],["هَذا كَذا وَما تَرَكتُ أَكثَرُ","فَجَرَّبوا ما قُلتُهُ وَفَكَّروا",27,"ر",3,0],["هَذا كِتابي إِلَيكُم","مِدادُهُ عَبَراتي",28,"ت",2,0],["هَذا كَذاكُم وَفي الهِياجِ إِذا","هيجَ فَما شِئتَ مِن بَواشيقِ",29,"ق",1,0],["هذاكَ وسط البيتِ يُنكح باركاً","قدَماً وتُنكح أمُّهُ في الزاويه",30,"ي",2,0],["هَذا كَلامٌ لَهُ خَبيءٌ","مَعناهُ لَيسَت لَنا عُقولُ",31,"ل",1,0],["هذا كِتابِي وكَفُّ الموْتِ تُزْعِجُنِي","عن الحياةِ وفي قَلْبِي لكم ذِكَرُ",32,"ر",1,1],["هّذَا كِتَابِيَ تَنْبِيهَا لِطَائِفَةٍ","مِنْكُمْ تُؤوِّدُهَا الأَحْقَادُ تَأْوِيدَا",33,"د",2,0],["هذا كتابُ اللَه ينطق بينَنا","ليس الشهيدُ بمَيّتٍ لا يكذبُ",34,"ب",1,0],["هذا كتابي قد تركت لذا الحجى","مفاتحه في قفله معقودا",35,"د",2,0],["هَذاكَ قَدْ بَزّزَ في حُسْنِهِ","سَبْقاً، وَهذا مُسرِعٌ في اللُّحُوقْ",36,"ق",1,0],["هذا كتاب الغيب فيه رحمة","تسع البريّة نترفا ومعيلا",37,"ل",2,0],["هذا كتاب منزل وزبور","فيه طروس إشارةٍ وسطور",38,"ر",1,1],["هذا كتاب أدهش الألباب في","ترصيفهِ وسبى البصائر واسترقْ",39,"ق",1,0],["هذا كتابٌ أتى يرجو بكم شرفاً","فقل له برضىً إنا قبلناكا",40,"ك",2,0],["هذا كِتابُ فَتَىً طالَتْ صَبَابَتُهُ","مُكَبَّلٍ في الهَوى وَقْفٍ لِكُلِّ ضَنى",41,"ن",2,0],["هَذا كِتابي إِلَيْكُمْ فِيهِ مَعْذِرَتي","يُنْبِيكُمُ اليَوْمَ عَنْ شَوْقي وَعَنْ سَقَمِي",42,"م",2,1],["هذاك في يمنٍ وما سلمت له","يمن وذا في الشام لم يدعِ اليمنْ",43,"ن",1,0],["هذا كتابي فمن يسمع بمقدمه","والسدر في رأسه فليغسلنه هنا",44,"ن",2,0],["هَذا كِتابٌ مِن مُحبٍّ هائِمٍ","قَد طالَ بَعدَ فِراقِكُم تَعذيبُهْ",45,"ه",1,1],["هَذا كِتابُ مُتَيَّمٍ أَلقى بِهِ","نيرانَ صَبوتِهِ وَبَردَ سَلامِهْ",46,"م",2,0],["هذا كِتابٌ فُصِّلت آياتُهُ","بِفَرائدٍ أَزرَت عُقودَ الجَوهَرِ",47,"ر",1,1],["هَذاكَ ملْكُ يديه والملوكُ له","والدهرُ والفَلَك الجاري من الخدم",48,"م",1,0],["هَذاك ساعدهُ وهذا المعصمُ","بِحياتهِ صلّوا عليهِ وسلّموا",49,"م",3,0],["هذا كتابي قد جعلتُ مدادهُ","عيني وأقلامي ضلوعٌ تخفقُ",50,"ق",1,1],["هذا كتابيَ لما قلَّ مصطبري","أشكو اليك صباباتي ووسواسي",51,"س",2,0],["هذا كتابٌ شريفٌ رائقٌ حَسَنٌ","ما قد وجدتُ له شِبْهاً من الكتبِ",52,"ب",1,1],["هذا كتاب الله ما شئتم به","للرشد من شرح ومن تبين",53,"ن",1,0],["هذا كتاب الله في إعجازه","لن يأتينَّ بمثله متكلم",54,"م",1,0],["هذا كتابٌ أم بشير سعادِ","يروي الحديث بأرفع الإسنادِ",55,"د",1,1],["هذا كتابٌ من محبٍّ مغرمٍ","يرى الوفا مشربَهُ ومطعمَهْ",56,"م",2,1],["هَذا كِتابٌ في مَعانيه حَسَن","للديلميِّ أَبي محمَّدٍ الحَسَن",57,"ن",1,1],["هَذاكَ أَنتَ فَقَد مَدَّدتَ مِنَ الخَطا","مُتَوَسِّعاً في حَلبَةِ المَيدانِ",58,"ن",1,0],["هَذاكَ خَيري أَحمَدَ المَشكورَ مِن","رِفعَتٍ لَهُ في المَجدِ أَرفَعُ رايَة",59,"ه",1,0],["هَذا كِتاب في الحِساب لَقَد حَوى","مِن كُلِّ مسألة أَتَت بِصَوابِ",60,"ب",1,1],["هَذا كِتاب رَقَّ طَبعاً لُطفهُ","فَهوَ الحريُّ بِأَن يموَّهَ بِالذَهَب",61,"ب",1,0],["هَذا كِتابٌ بِعَينِ القَلبِ تُقرَؤُهُ","تَدِقُّ عَن أَعيُنِ القارينَ أَحرُفُهُ",62,"ف",2,0],["هَذا كِتابي وَهوَ طَيفُ زِيارَةٍ","مِنّي وَنَومي في الفِراقِ لِلَيلَتي",63,"ي",1,0],["هذا كتابُ اللَه في عرصاتها","يتلَى فصار الوَغدُ فيها ناسكا",64,"ك",2,0],["هذا كتاب كله جهل","وخلاف ما جاءت به الرسل",65,"ل",1,1],["هذا كتاب كل داهية","فيه فلا عقل ولا نقل",65,"ل",1,0],["هذا كما أمر الإِله تحدث","بالفضل والإِنعام والإِنفاق",66,"ق",1,0],["هَذَا كتابُ فتىً أَحَلَّتهُ النَّوَى","أَوطَانَهَا ونَبَتْ بهِ أوطَانُهُ",67,"ن",2,1],["هذاكَ يدعو للجِنا","نِ وأنتَ تدعو للجحيمِ",68,"م",1,0],["هذا كأن أبا بكر لصاحبه","وذاك عاضده في أمره عمرا",69,"ر",2,0],["هذا كتابُكِ عَدلُ لا مثيلَ له","وذاك عهُدكِ يأبى كل طُغيانِ",70,"ن",1,0],["هَذا كَما قالَ قَومٌ","ما تَمَّ سَمّوهُ فَضلُ",71,"ل",1,0],["هذا كتابُ العارفينَ اقْرأ به","وترى أبا العَلَميْنِ في الفاتحهْ",72,"ح",2,0],["هذاك يَنظِمُ مِن عُقودِ بَيانِهِ","وسِواهُ مِن دُرَرِ البلاغة يَنثُرُ",73,"ر",1,0],["هذا كريمٌ باسِمِ أحمدَ قد أتى","فَجلا على الأبصارِ صُورَةَ يوسفِ",74,"ف",1,1],["هَذاك حَرَّكَهُ الهَوا","ءُ وأَنْتَ حَرَّكْتَ الهَوى",75,"و",2,0],["هَذا كِتابي إِلَيكُم وَالنَذيرُ لَكُم","فَمَن رَأى رَأيَهُ مِنكُم وَمَن سَمِعا",76,"ع",2,0],["هذا كليب على الرمضاء منجدلٌ","بين الخزامى علاه اليوم أرماحا",77,"ح",2,0],["هذا كتابي إليكم والنذير لكم","لمن رأى رأيه منكم ومن سمعا",78,"ع",2,0]]}