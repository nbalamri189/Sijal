لله يارب الخلايق يامعبود","https://www.poetsgate.com/ViewPoem.aspx?id=186844",""],[5606,"مايستحق الحب مثلك وشرواك","https://www.poetsgate.com/ViewPoem.aspx?id=196449",""],[5608,"العيد من دونه","https://www.poetsgate.com/ViewPoem.aspx?id=33322",""],[5648,"مايخلفون القلب والعقل ميزان","https://www.poetsgate.com/ViewPoem.aspx?id=155192",""],[5672,"كتاب وداد","https://www.poetsgate.com/ViewPoem.aspx?id=215349",""],[5720,"اقرأْ فديتُكَ *","https://www.poetsgate.com/ViewPoem.aspx?id=199236",""],[5720,"أبنائي الطلاب","https://www.poetsgate.com/ViewPoem.aspx?id=202125",""],[5732,"يامرجع ليعقوب غاليه","https://www.poetsgate.com/ViewPoem.aspx?id=177866",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5756,"فخر الامجاد","https://www.poetsgate.com/ViewPoem.aspx?id=5383",""],[5756,"خطاك السو","https://www.poetsgate.com/ViewPoem.aspx?id=5364",""],[5764,"حبيت أنبّه !","https://www.poetsgate.com/ViewPoem.aspx?id=159090",""],[5792,"يا ظالمة","https://www.poetsgate.com/ViewPoem.aspx?id=180335",""],[5829,"هل الهلال فهللوا","https://www.poetsgate.com/ViewPoem.aspx?id=180665",""],[5848,"الشيخ عبدالعزيز بن جامع","https://www.poetsgate.com/ViewPoem.aspx?id=53333",""],[5848,"تمتير","https://www.poetsgate.com/ViewPoem.aspx?id=53167",""],[5866,"مدح القبيلة","https://www.poetsgate.com/ViewPoem.aspx?id=182810",""],[5877,"فتل الاشناب","https://www.poetsgate.com/ViewPoem.aspx?id=37471",""],[5894,"كل الحواسد راعوا ما أنا فيه","https://www.poetsgate.com/ViewPoem.aspx?id=131407",""],[5910,"ماذا يقولُ الشِّعرُ","https://www.poetsgate.com/ViewPoem.aspx?id=206521",""],[5936,"هذاك إبن ناشي","https://www.poetsgate.com/ViewPoem.aspx?id=184773",""],[1920,"جدّدْ لنا عمرا فالقدس تنتظرُ","https://www.poetsgate.com/ViewPoem.aspx?id=192531",""],[5976,"الوقت والناس","https://www.poetsgate.com/ViewPoem.aspx?id=30351",""],[5977,"نبع الهداية","https://www.poetsgate.com/ViewPoem.aspx?id=212716",""],[6008,"الصدر ضاق","https://www.poetsgate.com/ViewPoem.aspx?id=59160",""],[6008,"رثاء بالشيوخ (مهل القعقاع -مساعد البنيه )","https://www.poetsgate.com/ViewPoem.aspx?id=60996",""],[6031,"لي إنْ تَحَامَاني أَخٌ وحَميمُ","https://www.poetsgate.com/ViewPoem.aspx?id=46275",""],[6113,"حالتي حاله","https://www.poetsgate.com/ViewPoem.aspx?id=137095",""],[6115,"من رافق الأنذال لو هومن مطانيخ الرجال","https://www.poetsgate.com/ViewPoem.aspx?id=196476",""],[5075,"موتوا لأجل القدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82754&r=&rc=0",""],[5190,"يا قارئ القرآن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85083&r=&rc=158",""]],"verses":[["هَذا كِتابٌ بِدَمعِ عَيني","أَملاهُ قَلبي عَلى بَناني",0,"ن",2,1],["هَذا كِتابُ فَتىً لِغَيبِكِ حافِظٍ","كَلِفٍ بِذِكرِكِ يا ظُلَيمَةُ مُدنَفِ",1,"ف",1,1],["هَذا كِتابي قَد أَتا","كِ بِما أُرَدِّدُ في الكِتابِ",2,"ب",1,0],["هَذا كِتابٌ نَحوَكُم أَرسَلتُهُ","يَبكي السَميعُ لَهُ وَيَبكي مَن قَرا",3,"ا",1,0],["هَذا كِتابُكَ قَد حَكَت آياتُهُ","آياتِ موسى التِسعِ في الإِكبارِ",4,"ر",1,0],["هَذا كِتابٌ مَذ بَدا سِرُّهُ","لِلناسِ قالوا مُعجِزٌ ثاني",5,"ي",1,1],["هَذاكَ قَد أَنِفَ الفُسّاقُ مِنهُ وَذا","تُتلى عَلَيهِ مَساويهِ فَيَبتَهِجُ",6,"ج",1,0],["هَذا كِتابُ مَشوقِ القَلبِ مُكتَئِبٍ","لَم يَألُ ناظِمُهُ جُهداً وَناثِرُهُ",7,"ر",2,0],["هذاك قد خصف الحيا أوراقه","وأنا الذي هشم الجفاءُ نباته",8,"ت",2,0],["هذاك عوَّام بدمعِه وذا","حدّ الهموم لقلبهِ جراح",9,"ح",1,0],["هذا كلامي وذا حظِّي فيا عجباً","منِّي لثروةِ لفظٍ وافْتقارِ يدِ",10,"د",1,0],["هذاك أحيى الناس من موتٍ وذا","في الحبِّ قد وافى بموت الناس",11,"س",1,0],["هذاك أصلهم وهذا فرعهم","أعظم بفضلِ المبتدِي والمنتهي",12,"ه",2,0],["هَذاكَ ديْدَنُها وذلك دَيْدَني","حتى بدا فلقُ الصباح المسفرِ",13,"ر",1,0],["هذا كتابٌ من أخ شاكرٍ","نُعماك يرجوك لريبِ الزمانْ",14,"ن",1,1],["هَذا كِتابُ مُحِبٍّ","قَد زادَ فيكَ غَرامُه",15,"م",2,1],["هَذا كِتابي وَهُوَ يُط","لِعُكُم عَلى حالي وَضَرّي",16,"ر",2,1],["هذاكَ مركوبي وتلكَ جنيبتي","بهما قطعتُ مسافةَ العُمْرِ",17,"ر",1,0],["هَذا كِتابُكَ فيهِ الجَهلُ وَالعُنفُ","قَد جاءَنا فَفَهِمنا كُلَّ ماتَصِفُ",18,"ف",1,1],["هَذاكَ قَد بَرَّزَ حُسنِهِ","سَبقاً وَهَذا مُسرِعٌ في اللُحوق",19,"ق",1,0],["هَذا كِتابُ المَثَلِ السائِرِ","في أَدَبِ الكاتِبِ وَالشاعِرِ",20,"ر",1,1],["هَذا كِتابٌ ناطِقٌ بِالعُلى","وَهَذِهِ الرُتبَةُ عُنوانُه",21,"ن",2,0],["هَذا كِتابُ فَتىً لَهُ هِمَمٌ","ساقَت إِلَيكَ رَجاءَهُ هِمَمُه",22,"م",2,1],["هذا كِتابُكِ ليس يبلغُ شأوَهُ","مَن نَمَّقَ الكُتْبَ الحِسانَ ونمنما",23,"م",2,0],["هذا كتابٌ للحياةِ مُفصَّلٌ","وَضُحَتْ به الآياتُ والأحكامُ",24,"م",1,0],["هذا كتابُ رَسولِ اللهِ يُنذره","فاذهبْ إليه وخُذْهُ غيرَ مُحتفلِ",25,"ل",1,0],["هَذا كِتابُ سِيَرِ الإِمامِ","مُهَذَّباً مِن جَوهَرِ الكَلامِ",26,"م",1,0],["هَذا كَذا وَما تَرَكتُ أَكثَرُ","فَجَرَّبوا ما قُلتُهُ وَفَكَّروا",27,"ر",3,0],["هَذا كِتابي إِلَيكُم","مِدادُهُ عَبَراتي",28,"ت",2,0],["هَذا كَذاكُم وَفي الهِياجِ إِذا","هيجَ فَما شِئتَ مِن بَواشيقِ",29,"ق",1,0],["هذاكَ وسط البيتِ يُنكح باركاً","قدَماً وتُنكح أمُّهُ في الزاويه",30,"ي",2,0],["هَذا كَلامٌ لَهُ خَبيءٌ","مَعناهُ لَيسَت لَنا عُقولُ",31,"ل",1,0],["هذا كِتابِي وكَفُّ الموْتِ تُزْعِجُنِي","عن الحياةِ وفي قَلْبِي لكم ذِكَرُ",32,"ر",1,1],["هّذَا كِتَابِيَ تَنْبِيهَا لِطَائِفَةٍ","مِنْكُمْ تُؤوِّدُهَا الأَحْقَادُ تَأْوِيدَا",33,"د",2,0],["هذا كتابُ اللَه ينطق بينَنا","ليس الشهيدُ بمَيّتٍ لا يكذبُ",34,"ب",1,0],["هذا كتابي قد تركت لذا الحجى","مفاتحه في قفله معقودا",35,"د",2,0],["هَذاكَ قَدْ بَزّزَ في حُسْنِهِ","سَبْقاً، وَهذا مُسرِعٌ في اللُّحُوقْ",36,"ق",1,0],["هذا كتاب الغيب فيه رحمة","تسع البريّة نترفا ومعيلا",37,"ل",2,0],["هذا كتاب منزل وزبور","فيه طروس إشارةٍ وسطور",38,"ر",1,1],["هذا كتاب أدهش الألباب في","ترصيفهِ وسبى البصائر واسترقْ",39,"ق",1,0],["هذا كتابٌ أتى يرجو بكم شرفاً","فقل له برضىً إنا قبلناكا",40,"ك",2,0],["هذا كِتابُ فَتَىً طالَتْ صَبَابَتُهُ","مُكَبَّلٍ في الهَوى وَقْفٍ لِكُلِّ ضَنى",41,"ن",2,0],["هَذا كِتابي إِلَيْكُمْ فِيهِ مَعْذِرَتي","يُنْبِيكُمُ اليَوْمَ عَنْ شَوْقي وَعَنْ سَقَمِي",42,"م",2,1],["هذاك في يمنٍ وما سلمت له","يمن وذا في الشام لم يدعِ اليمنْ",43,"ن",1,0],["هذا كتابي فمن يسمع بمقدمه","والسدر في رأسه فليغسلنه هنا",44,"ن",2,0],["هَذا كِتابٌ مِن مُحبٍّ هائِمٍ","قَد طالَ بَعدَ فِراقِكُم تَعذيبُهْ",45,"ه",1,1],["هَذا كِتابُ مُتَيَّمٍ أَلقى بِهِ","نيرانَ صَبوتِهِ وَبَردَ سَلامِهْ",46,"م",2,0],["هذا كِتابٌ فُصِّلت آياتُهُ","بِفَرائدٍ أَزرَت عُقودَ الجَوهَرِ",47,"ر",1,1],["هَذاكَ ملْكُ يديه والملوكُ له","والدهرُ والفَلَك الجاري من الخدم",48,"م",1,0],["هَذاك ساعدهُ وهذا المعصمُ","بِحياتهِ صلّوا عليهِ وسلّموا",49,"م",3,0],["هذا كتابي قد جعلتُ مدادهُ","عيني وأقلامي ضلوعٌ تخفقُ",50,"ق",1,1],["هذا كتابيَ لما قلَّ مصطبري","أشكو اليك صباباتي ووسواسي",51,"س",2,0],["هذا كتابٌ شريفٌ رائقٌ حَسَنٌ","ما قد وجدتُ له شِبْهاً من الكتبِ",52,"ب",1,1],["هذا كتاب الله ما شئتم به","للرشد من شرح ومن تبين",53,"ن",1,0],["هذا كتاب الله في إعجازه","لن يأتينَّ بمثله متكلم",54,"م",1,0],["هذا كتابٌ أم بشير سعادِ","يروي الحديث بأرفع الإسنادِ",55,"د",1,1],["هذا كتابٌ من محبٍّ مغرمٍ","يرى الوفا مشربَهُ ومطعمَهْ",56,"م",2,1],["هَذا كِتابٌ في مَعانيه حَسَن","للديلميِّ أَبي محمَّدٍ الحَسَن",57,"ن",1,1],["هَذاكَ أَنتَ فَقَد مَدَّدتَ مِنَ الخَطا","مُتَوَسِّعاً في حَلبَةِ المَيدانِ",58,"ن",1,0],["هَذاكَ خَيري أَحمَدَ المَشكورَ مِن","رِفعَتٍ لَهُ في المَجدِ أَرفَعُ رايَة",59,"ه",1,0],["هَذا كِتاب في الحِساب لَقَد حَوى","مِن كُلِّ مسألة أَتَت بِصَوابِ",60,"ب",1,1],["هَذا كِتاب رَقَّ طَبعاً لُطفهُ","فَهوَ الحريُّ بِأَن يموَّهَ بِالذَهَب",61,"ب",1,0],["هَذا كِتابٌ بِعَينِ القَلبِ تُقرَؤُهُ","تَدِقُّ عَن أَعيُنِ القارينَ أَحرُفُهُ",62,"ف",2,0],["هَذا كِتابي وَهوَ طَيفُ زِيارَةٍ","مِنّي وَنَومي في الفِراقِ لِلَيلَتي",63,"ي",1,0],["هذا كتابُ اللَه في عرصاتها","يتلَى فصار الوَغدُ فيها ناسكا",64,"ك",2,0],["هذا كتاب كله جهل","وخلاف ما جاءت به الرسل",65,"ل",1,1],["هذا كتاب كل داهية","فيه فلا عقل ولا نقل",65,"ل",1,0],["هذا كما أمر الإِله تحدث","بالفضل والإِنعام والإِنفاق",66,"ق",1,0],["هَذَا كتابُ فتىً أَحَلَّتهُ النَّوَى","أَوطَانَهَا ونَبَتْ بهِ أوطَانُهُ",67,"ن",2,1],["هذاكَ يدعو للجِنا","نِ وأنتَ تدعو للجحيمِ",68,"م",1,0],["هذا كأن أبا بكر لصاحبه","وذاك عاضده في أمره عمرا",69,"ر",2,0],["هذا كتابُكِ عَدلُ لا مثيلَ له","وذاك عهُدكِ يأبى كل 