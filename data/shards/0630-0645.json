dctabudhabi.ae/diwan/poem/120350","الوافر"],[5117,"النبي","https://www.poetsgate.com/ViewPoem.aspx?id=12149",""],[5302,"ما أثلج الصدرا","https://www.poetsgate.com/ViewPoem.aspx?id=201896",""],[5522,"يا سادتي ما سلا قلبي محبتكم","https://www.poetsgate.com/ViewPoem.aspx?id=188704",""],[2110,"ذكر الغيد في بنود اللاذ","https://www.poetsgate.com/ViewPoem.aspx?id=156271",""],[402,"يا أيها الخافق فوق هامنا","https://www.poetsgate.com/ViewPoem.aspx?id=35433",""],[5897,"إلى ذات الحرير الأخضر","https://www.poetsgate.com/ViewPoem.aspx?id=160572",""],[6093,"مهما سَمِعْتُ عنِ الحياة (مجزوء الكامل المذيل )","https://www.poetsgate.com/ViewPoem.aspx?id=181713",""],[6152,"حسن العهد من الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=203304",""],[6152,"حُسم العهد من الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=203407",""],[463,"هل تحت ليلك بالغضا من رائد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60040&r=&rc=96",""]],"verses":[["ذَمَمنا كُلَّ مُرتَجِعٍ عَطاءً","وَلَم يُعطوا فَيَرتَجِعوا العَطايا",0,"ا",3,0],["ذَمَّ رِجالاً بِتَركِ المَديحِ","وَبَعضُ السُكوتِ عَنِ المَدحِ ذَم",1,"م",1,0],["ذَمَمتُ دَهراً لَم يَزَل صَرفُهُ","يَطرُقُني وَفدَ الفِعالِ الذَميم",2,"م",1,0],["ذَمَّتكَ رَبوَتُهُ وَوَهدَتُهُ","وَشَكاكَ فَدفَدُهُ وَسَملَقُهُ",3,"ق",2,0],["ذَمَروا قُلوبَ المادِحينَ وَإِنَّما","مَدحُ المُلوكِ شَجاعَةٌ لِلشاعِرِ",4,"ر",1,0],["ذُمَّ الزَّمَانُ وَأَهْلُهُ مِنْ قَبْلِنَا","فَمَتَى حَلاَ أَوْ لَذَّ هَذَا الْحَنْظَلُ",5,"ل",1,0],["ذَمَمتُ إِذاً عَهدَ الحَياةِ وَلَم يَزَل","مُمِرّاً عَلى الأَيّامِ طَعمُهُما المَحلِ",6,"ل",1,0],["ذَمَمتُكَ أَوَّلاً حَتّى إِذا ما","بَلَوتُ سِواكَ عادَ الذَمُّ حَمدا",7,"د",2,1],["ذَميلُ الناعِجاتِ بِكُلِّ خَرقٍ","شِفاءُ الطارِقاتِ مِنَ الهُمومِ",8,"م",1,0],["ذُمَّ المَنازِلَ بَعدَ مَنزِلَةِ اللِوى","وَالعَيشَ بَعدَ أُلائِكَ الأَقوامِ",9,"م",1,0],["ذماميَ تَرْعَى لا ذمامَ سفينة","وحَقِّيَ لا حقَّ القِلاصِ الذَّعالبِ",10,"ب",1,0],["ذمَّ الأخلاءُ صاحباً حفظ ال","مالَ وأضحى يُضيّع الذمما",11,"م",2,0],["ذَمَمتُ السَحابَ الغُرَّ يَومَ نَوالِهِ","وَحَقَّرَ عِندي وَبلَها المُتَدَفِّقا",12,"ق",2,0],["ذم دنيا غرارة ليس تخلو","من رزايا يسوء فيها المصير",13,"ر",1,0],["ذم المدافع للاسماع قارعة","كما تصادم جلمود وجلمود",14,"د",1,0],["ذم الجهالة انها","ما اورثت الا خرابا",15,"ب",2,0],["ذم التعصب في الجدال فانه","سقم يجر وراءه اسقاما",16,"م",2,0],["ذممت للناس دنياهم تزهدهم","وانت ان ذكر اسم الموت رعديد",17,"د",1,0],["ذَمَّ الزَمانُ إِلَيهِ مِن أَحِبَّتِهِ","ما ذَمَّ مِن بَدرِهِ في حَمدِ أَحمَدِهِ",18,"د",2,0],["ذَمَّ الدُمُستُقُ عَينَيهِ وَقَد طَلَعَت","سودُ الغَمامِ فَظَنّوا أَنَّها قَزَعُ",19,"ع",1,0],["ذَمَمنا عَهدَهُ لَمّا بَلَونا","لَئيمَ سَجِيَّةٍ لِحزٍ بَخيلِ",20,"ل",1,0],["ذَمّوا مُحَمَّداً المَحمودَ إِذ نَشِبوا","في مُصمَتٍ لَيسَ في أَرجائِهِ خَلَلُ",21,"ل",1,0],["ذَمَمْتُ عَهْدَ اللَّيالي في تَحَيُّفِكُمْ","ولم تَزَلْ في العُلى مذمومةَ الذِّمَمِ",22,"م",1,0],["ذَممتَ زَرْعَكَ خَوفاً من مُطالَبتي","والرَّزْعُ نُحلَةُ عامٍ غَيرِ مَذمومِ",23,"م",1,1],["ذَمَّ الهَوى لَمّا تَذَكَّرَ إِلفَهُ","بِالجامِعَينِ وَحَبلَهُ لَم يُجذَذِ",24,"ذ",1,0],["ذِمَمُ الزَمانِ بِعَدلِهِ مَحفوظَةٌ","فَذِمامُهُ مِن غَيرِهِ لَم يُؤخَذِ",24,"ذ",1,0],["ذِمْرُ حَرْبٍ له اقتحامُ هزبرٍ","وجوادٌ له يمينُ غَمامِ",25,"م",1,0],["ذِمْرٌ إذا عَلِقَتْ بالحرب عَزْمتُهُ","روّى القواضِبَ فيهِ وَالقنا عَلقا",26,"ق",2,0],["ذِمْرٌ له في ضمير الغِمْد ذو شطبٍ","كأنّه بارقٌ يسطو به قمرُ",27,"ر",1,0],["ذِمْرٌ تروحُ شموسُه وبدورُهُ","وبروجُها من معتَفيهِ الراحُ",28,"ح",1,0],["ذَمّا العُقوقَ وَرَدّا فَضلَ حِلمِهِما","وَراجَعا الوَصلَ وَاِستَثناهُما الكَرَمُ",29,"م",1,0],["ذَمَرتَ جَمعَ الهُدى فَاِنقَضَّ مُنصَلِتاً","وَكانَ في حَلَقاتِ الرُعبِ قَد رَسَفا",30,"ف",2,0],["ذَمَّت سَماحَتُهُ الدُنيا إِلَيهِ فَما","يُمسي وَيُصبِحُ إِلّا وَهوَ مَمدوحُ",31,"ح",1,0],["ذِمَامُكَ مَخْفُورٌ وَعَهْدُكَ ضَائِعٌ","وَرَأْيُكَ مَأْفُونٌ وَعَقْلُكَ مُخْتَلُّ",32,"ل",1,0],["ذَمُّ ولاةِ الأمورِ صعبٌ","في شرعِنا لا يجوزُ فعلُهْ",33,"ه",1,1],["ذمَّ المنازلَ بعدَ منزلةَ اللِّوى","والعيشَ بعدَ أولئكَ الأقوامِ",34,"م",1,1],["ذَمَمنا عَهدَكُم فَمَتى نَراكُم","تَشُدّونَ الرِحالَ مُوَدِّعينا",35,"ن",2,0],["ذِمَامٌ صادِقٌ ودَمٌ حَرَامُ","وَعِزٌّ من خُزاعَةَ لا يُرامُ",36,"م",1,0],["ذُمَّ الزَمانُ لِدِمنَةٍ","بَينَ المُشَقَّرِ وَالصَفا",37,"ف",2,1],["ذَمَّ الجزيرة وهي خِدْرُ ضَراغِمٍ","سامَتْهُ فيها الخَسْفَ وهو نَزيل",38,"ل",1,0],["ذَمّوا قَناكَ وقد ثارَتْ أسِنّتُها","فما تركْنَ وَريداً غيرَ مَورود",39,"د",1,0],["ذُمَّ اللياليَ بعدَ ليلتِنا التي","سَلَفَتْ كما ذمَ الفراقَ لقاء",40,"ا",2,0],["ذَمَمتُكِ أُمَّ دَفرٍ فَاِسمَعيني","وَجازيني بِذَلِكَ أَو دَعيني",41,"ن",2,1],["ذممت نهاري بعد صحبي وَلَيلَتي","فَلا أوجهٌ غرٌّ وَلا أَنجمٌ زهر",42,"ر",1,0],["ذممت سماء ما لها أنجمٌ زهرُ","وأرضاً خلاء ما بها أوجهٌ غرُّ",43,"ر",1,1],["ذممت من الأيام يا نفس إنها","تشابه منها الأمس وَاليَوم وَالغَد",44,"د",1,0],["ذمَّ السياسةَ أنها أبدت لنا","قمراً على الآفاق غير منير",45,"ر",1,0],["ذممت من الأيام فقدان عدلها","وَما أَكثرت من سادة وَعَبيد",46,"د",1,0],["ذمَّنا الناسُ لأنا","ما استجدنا ما اِستَجادوا",47,"د",3,1],["ذممت قَريضاً كنت تكثر مدحه","فَبَعضُك من لؤمٍ لبعضك ينقض",48,"ض",1,0],["ذم الحَياة فإنها","لَم تخل يوماً من أذاة",49,"ه",1,0],["ذَمَّ الوَليدُ ولم أذْمُمْ جِوارَكُمُ","فقال ما أنْصَفَتْ بَغدادُ حوشِيتا",50,"ت",2,0],["ذُ مَزَّةٍ خُطَّتْ عَلَى حَرْفِهِ","وَعَنْ مَعَانِي لَفْظِهَا لاَ تَسَلِ",51,"ل",1,0],["ذِمَّتُنَا ذِمَّتُنَا عِنْدَ الْعُلَى","وَالفَوْزُ كَانَ للثَّبَاتِ وَعْدَا",52,"د",2,0],["ذمَّت حَياتي أَمُتَّ برّاً","وَعاشَ مَن عَقَّني وَآذى",53,"ذ",2,0],["ذَمَمتُ حَياتي كَيفَ أَحمدُها وَقَد","تَرَكتُ مِنَ اللذّاتِ ما كُنتُ آخذُ",54,"ذ",1,0],["ذِمامُ الهَوى يُرعى فَهَلّا رَعيتهُ","وَكُنت بِقُربى مَن نَوى أَتَعَوَّذُ",54,"ذ",1,0],["ذممتَ لِيَ المشيبَ وفيه حَزْمٌ","وأطريتَ الشبابَ وفيه جهل",55,"ل",1,0],["ذمر حقوق نزيلهم والمستعي","ذ بهم حقوق لا يضاع ذمامها",56,"م",3,0],["ذَمَمْتُ منها محيطاً لا يلائمني","صعْبَ التقاليدِ مذمومَ الأساطير",57,"ر",1,0],["ذَم الفراقَ معاشرٌ جهلوكُمُ","من أجلكم حتى الفراقُ يُطاق",58,"ق",1,0],["ذممَتُ اصطبارَ العاجزينَ وراقني","على الضُرِّ صبرُ الواثبِ المتطلِّعِ",59,"ع",1,1],["ذَمَّ الحياةَ أُناسٌ لم تُواتِهُمُ","ولا دَروا غيرَ دَرَّ الإبْل والشاء",60,"ا",2,0],["ذممتُ مُقامي في العراقِ وعلَّني","متى أعتزمْ مسرايَ أن أحمَدَ المسري",61,"ر",2,0],["ذَمَمْنَا عَهْدَهُ لَمَّا بَلَوْنَا","للَئيمَ سَجِيّةٍ لِحْزٍ بَخِيلِ",62,"ل",1,0],["ذمَّها كلُّ البرايا","في دواوين القَضيّهْ",63,"ي",2,0],["ذَمائِيَ مَسفُوحٌ بمَدرَجَةِ الهَوى","وقَلبي بنِيرانِ الصَّبَابَةِ يُنبَذُ",64,"ذ",1,0],["ذِمَامُكَ مَحفُوظٌ وَحَقُّكَ واجبٌ","وَحكمُكَ مَحتُوم وأنتَ المُنَفِّذٌُ",64,"ذ",1,0],["ذِمارَكُم إِن تَصرِفوا عَنهُ حَدَّكُم","يَكُن رَهنَ أَيدٍ لِلأَعادي هَوائِثِ",65,"ث",1,0],["ذِمَاماً إِذا طَاوعتِ بى قَولَ كاشِحٍ","مِنَ الغَيظِ يَفرِى كِذبَهُ وَيَعِيبُ",66,"ب",1,0],["ذِممٌ ظَفرتُ بِها لَديهِ وَإِنَّها","إَرثٌ قَديمٌ مِن أَجلِّ ذَخائِري",67,"ر",2,0],["ذمّ الزمان سفاهةٌ يتبشّع","والله يعطي من يشاء ويمنعُ",68,"ع",1,1],["ذَمْرٌ تخاف نجومُ القَذْفِ منه متى","تراه يُقْدِمُ للهيجاءِ بالصَمَمِ",69,"م",1,0],["ذمَمْناك يا صَرْفَ الحوادثِ فانتصِرْ","وسُؤْناك يا رَيبَ الزمانِ فخذ مِنّا",70,"ن",2,0],["ذَمَمتُ قَريضاً لا يكونُ بمدحه","يِنَظَّمُ فيه لؤلؤٌ وزَبرجَدُ",71,"د",1,0],["ذَمَمتُ زَماني إِذ رَماني بِمَعشَرٍ","يَرَونَ عُلُوَّ الشَأنِ في حَطِّهِم شاني",72,"ن",2,0],["ذَمَمتُ نَفسي حينَ وَلِيَ الزَمانُ","وَلَم أُشاهِد حُسنَهُم يا نَديمُ",73,"م",1,0],["ذمّموا من كرهتموه وحيّوا","بالتهاليلِ ن تحبّبتموهُ",74,"ه",1,0],["ذَمَمتُكَ أَوَّلاً حَتّى إِذا ما","بَلَوتُ سِواكَ عادَ اللَومُ حَمدا",75,"د",2,1],["ذمَمْتُ بها اللّئامَ فقال صَحْبي","أأيّاماً تُخاطِبُ أم أناما",76,"م",2,0],["ذَماؤُكَ فيها لا دِماؤُكَ فَاِنتَصِفُ","وَإِلّا فَكُن مِن ذَمِّها مُتَذَمِّما",77,"م",2,0],["ذمَّةٌ قد وفيت فيها لديهم","وعلى الحرِّ أن يفي بالذّمام",78,"م",1,0],["ذُمَّ الفِراقُ وما علقْتَ بذمّةٍ","من سلوةٍ فمتى يُذمّ لقاءُ",79,"ا",2,0],["ذُمَّتْ لِعَيْنِكَ أَعْيُنُ الْغِزْلانِ","قَمَرٌ أَقَرَّ لِحُسْنِهِ الْقَمَرانِ",80,"ن",1,1],["ذُمَّ الحِفاظَ فذو الصرامة عندهم","معطي الخلابِ ومانعُ الماعونِ",81,"ن",1,0],["ذممتك فيها بالشجاعة مقدِماً","ولو قد جبُنتَ اخترتُ حمدي على الجُبنِ",82,"ن",1,0],["ذِمَمٌ لو اعتَصَمَ العُداةُ بمثلها","عقدوا بهنّ لديك خير