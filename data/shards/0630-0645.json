{"poems":[[53,"أتذهل بعد إنذار المنايا","https://www.aldiwan.net/poem29623.html","الوافر"],[53,"أما آن للدمع أن يستجم","https://www.aldiwan.net/poem29769.html","المتقارب"],[53,"لا عادت الكأس عليل النسيم","https://www.aldiwan.net/poem29774.html","السريع"],[53,"لو صح أن البين يعشقه","https://www.aldiwan.net/poem29955.html","السريع"],[53,"ما عند عينك في الخيال الزائر","https://www.aldiwan.net/poem30448.html","الكامل"],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[73,"ألم يأن أن يبكي الغمام على مثلي","https://www.aldiwan.net/poem11932.html","الطويل"],[54,"ذممتك أولا حتى إذا ما","https://www.aldiwan.net/poem27603.html","الوافر"],[27,"عرفت ببرقة الوداء رسما","https://www.aldiwan.net/poem5983.html","الوافر"],[27,"سرت الهموم فبتن غير نيام","https://www.aldiwan.net/poem6021.html","الكامل"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[70,"أخذت عليه بالمحبة موثقا","https://www.aldiwan.net/poem42800.html","الطويل"],[89,"أحمد كان مثل بحر رحيب","https://www.aldiwan.net/poem44619.html","الخفيف"],[89,"قد عدت بعد ذهاب منك يا عيد","https://www.aldiwan.net/poem44645.html","البسيط"],[89,"من بعد ما انتظرت حقابا","https://www.aldiwan.net/poem44746.html","مجزوء الكامل"],[89,"يا موطنا قد ذبت فيه غراما","https://www.aldiwan.net/poem44748.html","الكامل"],[89,"الشعر كالفارس المغوار ذو جرة","https://www.aldiwan.net/poem44787.html","البسيط"],[43,"وشادن روح من يهواه في يده","https://www.aldiwan.net/poem9560.html","البسيط"],[43,"غيري بأكثر هذا الناس ينخدع","https://www.aldiwan.net/poem9719.html","البسيط"],[45,"رأيت الفضل من فرض وقرض","https://www.aldiwan.net/poem65552.html","الوافر"],[45,"لا دمنة بلوى خبت ولا طلل","https://www.aldiwan.net/poem65579.html","البسيط"],[61,"ها إنها خطط العلياء والكرم","https://www.aldiwan.net/poem51423.html","البسيط"],[61,"ذممت زرعك خوفا من مطالبتي","https://www.aldiwan.net/poem51451.html","البسيط"],[66,"ذكر العهود فأسهر الطرف القذي","https://www.aldiwan.net/poem38493.html","الكامل"],[80,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[80,"ما للوشاة عليها أذكت الحدقا","https://www.aldiwan.net/poem31358.html","البسيط"],[80,"هذا ابتداء له عند العلى خبر","https://www.aldiwan.net/poem31433.html","البسيط"],[80,"ما للوشاة غدوا علي وراحوا","https://www.aldiwan.net/poem31513.html","الكامل"],[44,"لا يحمد السجل حتى يحكم الوذم","https://www.aldiwan.net/poem29707.html","البسيط"],[44,"أما الرسوم فقد أذكرن ما سلفا","https://www.aldiwan.net/poem30404.html","البسيط"],[44,"قل للأمير لقد قلدتني نعما","https://www.aldiwan.net/poem30562.html","البسيط"],[87,"وصالك لي هجر وهجرك لي وصل","https://www.aldiwan.net/poem8344.html","الطويل"],[69,"ذم ولاة الأمور صعب","https://www.aldiwan.net/poem28774.html","مخلع البسيط"],[69,"ذم المنازل بعد منزلة اللوى","https://www.aldiwan.net/poem29312.html","الكامل"],[105,"أتلك مصارع المستضعفينا","https://www.aldiwan.net/poem43397.html","الوافر"],[105,"بني بكر وما يغني الملام","https://www.aldiwan.net/poem44045.html","الوافر"],[52,"ذم الزمان لدمنة","https://www.aldiwan.net/poem26825.html","مجزوء الكامل"],[75,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[75,"أقوى المحصب من هاد ومن هيد","https://www.aldiwan.net/poem69092.html","الطويل"],[75,"الحب حيث المعشر الأعداء","https://www.aldiwan.net/poem69109.html","الكامل"],[46,"ذممتك أم دفر فاسمعيني","https://www.aldiwan.net/poem23527.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85449","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85313","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85318","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85539","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85475","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85616","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85480","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85372","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16636","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55146","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54694","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43840","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43638","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54232","الوافر"],[90,"وحي الرستمية","https://www.poetsgate.com/ViewPoem.aspx?id=179135",""],[90,"بريد الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=179052",""],[90,"الصَبر الجَميل","https://www.poetsgate.com/ViewPoem.aspx?id=179152",""],[90,"شباب يذوي !","https://www.poetsgate.com/ViewPoem.aspx?id=179111",""],[90,"المحرقة","https://www.poetsgate.com/ViewPoem.aspx?id=179110",""],[45,"رَاَيْتُ الفَضْلَ مِنْ فَرْضِ وقَرْضٍ","https://www.poetsgate.com/ViewPoem.aspx?id=32067",""],[126,"عجلة الإنسان لوم","https://www.aldiwan.net/poem50478.html","مجزوء الرمل"],[148,"ذكرتك فارتاح الفؤاد صبابة","https://www.aldiwan.net/poem68568.html","الطويل"],[162,"أماطت لثاما عن أقاح الدمائث","https://www.aldiwan.net/poem67812.html","الطويل"],[179,"أمنك أميم الدار غيرها البلى","https://www.aldiwan.net/poem58861.html","الطويل"],[180,"ما مر ذكرك خاطرا في خاطري","https://www.aldiwan.net/poem67068.html","الكامل"],[184,"ذم الزمان سفاهة يتبشع","https://www.aldiwan.net/poem43639.html","الكامل"],[210,"يا حادي العيس قف بالجزع والعلم","https://www.aldiwan.net/poem37834.html","البسيط"],[227,"أقول لسرب من حمام عرضن لي","https://www.aldiwan.net/poem50765.html","الطويل"],[248,"ذخرت مديحي في النبي محمد","https://www.aldiwan.net/poem15062.html","الطويل"],[280,"أرقت لبرق من أهاضيب لبنان","https://www.aldiwan.net/poem32343.html","الطويل"],[302,"يا من هواهم في فؤادي مقيم","https://www.aldiwan.net/poem16774.html","الخفيف"],[326,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[336,"ذممتك أولا حتى إذا ما","https://www.aldiwan.net/poem68795.html","الوافر"],[362,"إذا ضربوا بكاظمة الخياما","https://www.aldiwan.net/poem60656.html","الوافر"],[364,"وقفنا على قصر العزيز وقد عفا","https://www.aldiwan.net/poem17353.html","الطويل"],[413,"من لصب متيم مستهام","https://www.aldiwan.net/poem53989.html","الخفيف"],[429,"هذا اللوى لا حط منه لواء","https://www.aldiwan.net/poem12549.html","الكامل"],[431,"ذمت لعينك أعين الغزلان","https://www.aldiwan.net/poem25693.html","الكامل"],[456,"من طالب بي في الظباء العين","https://www.aldiwan.net/poem55833.html","الكامل"],[456,"كم النحت في جنبي والحز في متني","https://www.aldiwan.net/poem55835.html","الطويل"],[456,"هل تحت ليلك بالغضا من رائد","https://www.aldiwan.net/poem56217.html","الكامل"],[456,"أغش بآمالي كأني أنصح","https://www.aldiwan.net/poem56254.html","البسيط"],[456,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[459,"يعجز في مدحه وقد علمت","https://www.aldiwan.net/poem15447.html","المنسرح"],[459,"أجأ وسلمى أم بلاد الزاب","https://www.aldiwan.net/poem15904.html","الكامل"],[459,"منازلكم للخائفين عصام","https://www.aldiwan.net/poem16033.html","الطويل"],[462,"أماط لثاماً فاجتلِ القمر الأدنى","https://www.aldiwan.net/poem3203.html","عموديه"],[462,"ما سرت عن جلق أبغي البديل بها","https://www.aldiwan.net/poem3222.html","عموديه"],[462,"ما لطيف زار منكم موهنا","https://www.aldiwan.net/poem3343.html","عموديه"],[462,"مضى صاحب الصدر الذي حازه الصدر","https://www.aldiwan.net/poem3394.html","عموديه"],[462,"تباً لما اختلق الواشي وما نقلا","https://www.aldiwan.net/poem3504.html","عموديه"],[477,"ذمم تباع وتشترى","https://www.aldiwan.net/poem37604.html","مجزوء الكامل"],[513,"أيها الناس والخطاب إلى من","https://www.aldiwan.net/poem12291.html","الخفيف"],[538,"ألم تر أن القول يخلص صدقه","https://www.aldiwan.net/poem56712.html","الطويل"],[549,"دعوا اليوم ما عودتم من تصبر","https://www.aldiwan.net/poem47699.html","الطويل"],[556,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[556,"ذو العلم يعرف أن أصل المأخذ","https://www.aldiwan.net/poem33551.html","الكامل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[571,"ألبستنا العدل أبراداً مفوفة","https://www.aldiwan.net/poem3647.html","البسيط"],[573,"ما ضر من أهدى إلي الخيال","https://www.aldiwan.net/poem3039.html","السريع"]],"verses":[["ذَمَمنا كُلَّ مُرتَجِعٍ عَطاءً","وَلَم يُعطوا فَيَرتَجِعوا العَطايا",0,"ا",3,0],["ذَمَّ رِجالاً بِتَركِ المَديحِ","وَبَعضُ السُكوتِ عَنِ المَدحِ ذَم",1,"م",1,0],["ذَمَمتُ دَهراً لَم يَزَل صَرفُهُ","يَطرُقُني وَفدَ الفِعالِ الذَميم",2,"م",1,0],["ذَمَّتكَ رَبوَتُهُ وَوَهدَتُهُ","وَشَكاكَ فَدفَدُهُ وَسَملَقُهُ",3,"ق",2,0],["ذَمَروا قُلوبَ المادِحينَ وَإِنَّما","مَدحُ المُلوكِ شَجاعَةٌ لِلشاعِرِ",4,"ر",1,0],["ذُمَّ الزَّمَانُ وَأَهْلُهُ مِنْ قَبْلِنَا","فَمَتَى حَلاَ أَوْ لَذَّ هَذَا الْحَنْظَلُ",5,"ل",1,0],["ذَمَمتُ إِذاً عَهدَ الحَياةِ وَلَم يَزَل","مُمِرّاً عَلى الأَيّامِ طَعمُهُما المَحلِ",6,"ل",1,0],["ذَمَمتُكَ أَوَّلاً حَتّى إِذا ما","بَلَوتُ سِواكَ عادَ الذَمُّ حَمدا",7,"د",2,1],["ذَميلُ الناعِجاتِ بِكُلِّ خَرقٍ","شِفاءُ الطارِقاتِ مِنَ الهُمومِ",8,"م",1,0],["ذُمَّ المَنازِلَ بَعدَ مَنزِلَةِ اللِوى","وَالعَيشَ بَعدَ أُلائِكَ الأَقوامِ",9,"م",1,0],["ذماميَ تَرْعَى لا ذمامَ سفينة","وحَقِّيَ لا حقَّ القِلاصِ الذَّعالبِ",10,"ب",1,0],["ذمَّ الأخلاءُ صاحباً حفظ ال","مالَ وأضحى يُضيّع الذمما",11,"م",2,0],["ذَمَمتُ السَحابَ الغُرَّ يَومَ نَوالِهِ","وَحَقَّرَ عِندي وَبلَها المُتَدَفِّقا",12,"ق",2,0],["ذم دنيا غرارة ليس تخلو","من رزايا يسوء فيها المصير",13,"ر",1,0],["ذم المدافع للاسماع قارعة","كما تصادم جلمود وجلمود",14,"د",1,0],["ذم الجهالة انها","ما اورثت الا خرابا",15,"ب",2,0],["ذم التعصب في الجدال فانه","سقم يجر وراءه اسقاما",16,"م",2,0],["ذممت للناس دنياهم تزهدهم","وانت ان ذكر اسم الموت رعديد",17,"د",1,0],["ذَمَّ الزَمانُ إِلَيهِ مِن أَحِبَّتِهِ","ما ذَمَّ مِن بَدرِهِ في حَمدِ أَحمَدِهِ",18,"د",2,0],["ذَمَّ الدُمُستُقُ عَينَيهِ وَقَد طَلَعَت","سودُ الغَمامِ فَظَنّوا أَنَّها قَزَعُ",19,"ع",1,0],["ذَمَمنا عَهدَهُ لَمّا بَلَونا","لَئيمَ سَجِيَّةٍ لِحزٍ بَخيلِ",20,"ل",1,0],["ذَمّوا مُحَمَّداً المَحمودَ إِذ نَشِبوا","في مُصمَتٍ لَيسَ في أَرجائِهِ خَلَلُ",21,"ل",1,0],["ذَمَمْتُ عَهْدَ اللَّيالي في تَحَيُّفِكُمْ","ولم تَزَلْ في العُلى مذمومةَ الذِّمَمِ",22,"م",1,0],["ذَممتَ زَرْعَكَ خَوفاً من مُطالَبتي","والرَّزْعُ نُحلَةُ عامٍ غَيرِ مَذمومِ",23,"م",1,1],["ذَمَّ الهَوى لَمّا تَذَكَّرَ إِلفَهُ","بِالجامِعَينِ وَحَبلَهُ لَم يُجذَذِ",24,"ذ",1,0],["ذِمَمُ الزَمانِ بِعَدلِهِ مَحفوظَةٌ","فَذِمامُهُ مِن غَيرِهِ لَم يُؤخَذِ",24,"ذ",1,0],["ذِمْرُ حَرْبٍ له اقتحامُ هزبرٍ","وجوادٌ له يمينُ غَمامِ",25,"م",1,0],["ذِمْرٌ إذا عَلِقَتْ بالحرب عَزْمتُهُ","روّى القواضِبَ فيهِ وَالقنا عَلقا",26,"ق",2,0],["ذِمْرٌ له في ضمير الغِمْد ذو شطبٍ","كأنّه بارقٌ يسطو به قمرُ",27,"ر",1,0],["ذِمْرٌ تروحُ شموسُه وبدورُهُ","وبروجُها من معتَفيهِ الراحُ",28,"ح",1,0],["ذَمّا العُقوقَ وَرَدّا فَضلَ حِلمِهِما","وَراجَعا الوَصلَ وَاِستَثناهُما الكَرَمُ",29,"م",1,0],["ذَمَرتَ جَمعَ الهُدى فَاِنقَضَّ مُنصَلِتاً","وَكانَ في حَلَقاتِ الرُعبِ قَد رَسَفا",30,"ف",2,0],["ذَمَّت سَماحَتُهُ الدُنيا إِلَيهِ فَما","يُمسي وَيُصبِحُ إِلّا وَهوَ مَمدوحُ",31,"ح",1,0],["ذِمَامُكَ مَخْفُورٌ وَعَهْدُكَ ضَائِعٌ","وَرَأْيُكَ مَأْفُونٌ وَعَقْلُكَ مُخْتَلُّ",32,"ل",1,0],["ذَمُّ ولاةِ الأمورِ صعبٌ","في شرعِنا لا يجوزُ فعلُهْ",33,"ه",1,1],["ذمَّ المنازلَ بعدَ منزلةَ اللِّوى","والعيشَ بعدَ أولئكَ الأقوامِ",34,"م",1,1],["ذَمَمنا عَهدَكُم فَمَتى نَراكُم","تَشُدّونَ الرِحالَ مُوَدِّعينا",35,"ن",2,0],["ذِمَامٌ صادِقٌ ودَمٌ حَرَامُ","وَعِزٌّ من خُزاعَةَ لا يُرامُ",36,"م",1,0],["ذُمَّ الزَمانُ لِدِمنَةٍ","بَينَ المُشَقَّرِ وَالصَفا",37,"ف",2,1],["ذَمَّ الجزيرة وهي خِدْرُ ضَراغِمٍ","سامَتْهُ فيها الخَسْفَ وهو نَزيل",38,"ل",1,0],["ذَمّوا قَناكَ وقد ثارَتْ أسِنّتُها","فما تركْنَ وَريداً غيرَ مَورود",39,"د",1,0],["ذُمَّ اللياليَ بعدَ ليلتِنا التي","سَلَفَتْ كما ذمَ الفراقَ لقاء",40,"ا",2,0],["ذَمَمتُكِ أُمَّ دَفرٍ فَاِسمَعيني","وَجازيني بِذَلِكَ أَو دَعيني",41,"ي",1,1],["ذممت نهاري بعد صحبي وَلَيلَتي","فَلا أوجهٌ غرٌّ وَلا أَنجمٌ زهر",42,"ر",1,0],["ذممت سماء ما لها أنجمٌ زهرُ","وأرضاً خلاء ما بها أوجهٌ غرُّ",43,"ر",1,1],["ذممت من الأيام يا نفس إنها","تشابه منها الأمس وَاليَوم وَالغَد",44,"د",1,0],["ذمَّ السياسةَ أنها أبدت لنا","قمراً على الآفاق غير منير",45,"ر",1,0],["ذممت من الأيام فقدان عدلها","وَما أَكثرت من سادة وَعَبيد",46,"د",1,0],["ذمَّنا الناسُ لأنا","ما استجدنا ما اِستَجادوا",47,"د",3,1],["ذممت قَريضاً كنت تكثر مدحه","فَبَعضُك من لؤمٍ لبعضك ينقض",48,"ض",1,0],["ذم الحَياة فإنها","لَم تخل يوماً من أذاة",49,"ه",1,0],["ذَمَّ الوَليدُ ولم أذْمُمْ جِوارَكُمُ","فقال ما أنْصَفَتْ بَغدادُ حوشِيتا",50,"ت",2,0],["ذُ مَزَّةٍ خُطَّتْ عَلَى حَرْفِهِ","وَعَنْ مَعَانِي لَفْظِهَا لاَ تَسَلِ",51,"ل",1,0],["ذِمَّتُنَا ذِمَّتُنَا عِنْدَ الْعُلَى","وَالفَوْزُ كَانَ للثَّبَاتِ وَعْدَا",52,"د",2,0],["ذمَّت حَياتي أَمُتَّ برّاً","وَعاشَ مَن عَقَّني وَآذى",53,"ذ",2,0],["ذَمَمتُ حَياتي كَيفَ أَحمدُها وَقَد","تَرَكتُ مِنَ اللذّاتِ ما كُنتُ آخذُ",54,"ذ",1,0],["ذِمامُ الهَوى يُرعى فَهَلّا رَعيتهُ","وَكُنت بِقُربى مَن نَوى أَتَعَوَّذُ",54,"ذ",1,0],["ذممتَ لِيَ المشيبَ وفيه حَزْمٌ","وأطريتَ الشبابَ وفيه جهل",55,"ل",1,0],["ذَمَمْتُ منها محيطاً لا يلائمني","صعْبَ التقاليدِ مذمومَ الأساطير",56,"ر",1,0],["ذَم الفراقَ معاشرٌ جهلوكُمُ","من أجلكم حتى الفراقُ يُطاق",57,"ق",1,0],["ذممَتُ اصطبارَ العاجزينَ وراقني","على الضُرِّ صبرُ الواثبِ المتطلِّعِ",58,"ع",1,1],["ذَمَّ الحياةَ أُناسٌ لم تُواتِهُمُ","ولا دَروا غيرَ دَرَّ الإبْل والشاء",59,"ا",2,0],["ذممتُ مُقامي في العراقِ وعلَّني","متى أعتزمْ مسرايَ أن أحمَدَ المسري",60,"ر",2,0],["ذَمَمْنَا عَهْدَهُ لَمَّا بَلَوْنَا","للَئيمَ سَجِيّةٍ لِحْزٍ بَخِيلِ",61,"ل",1,0],["ذمَّها كلُّ البرايا","في دواوين القَضيّهْ",62,"ي",2,0],["ذَمائِيَ مَسفُوحٌ بمَدرَجَةِ الهَوى","وقَلبي بنِيرانِ الصَّبَابَةِ يُنبَذُ",63,"ذ",1,0],["ذِمَامُكَ مَحفُوظٌ وَحَقُّكَ واجبٌ","وَحكمُكَ مَحتُوم وأنتَ المُنَفِّذٌُ",63,"ذ",1,0],["ذِمارَكُم إِن تَصرِفوا عَنهُ حَدَّكُم","يَكُن رَهنَ أَيدٍ لِلأَعادي هَوائِثِ",64,"ث",1,0],["ذِمَاماً إِذا طَاوعتِ بى قَولَ كاشِحٍ","مِنَ الغَيظِ يَفرِى كِذبَهُ وَيَعِيبُ",65,"ب",1,0],["ذِممٌ ظَفرتُ بِها لَديهِ وَإِنَّها","إَرثٌ قَديمٌ مِن أَجلِّ ذَخائِري",66,"ي",1,0],["ذمّ الزمان سفاهةٌ يتبشّع","والله يعطي من يشاء ويمنعُ",67,"ع",1,1],["ذَمْرٌ تخاف نجومُ القَذْفِ منه متى","تراه يُقْدِمُ للهيجاءِ بالصَمَمِ",68,"م",1,0],["ذمَمْناك يا صَرْفَ الحوادثِ فانتصِرْ","وسُؤْناك يا رَيبَ الزمانِ فخذ مِنّا",69,"ن",2,0],["ذَمَمتُ قَريضاً لا يكونُ بمدحه","يِنَظَّمُ فيه لؤلؤٌ وزَبرجَدُ",70,"د",1,0],["ذَمَمتُ زَماني إِذ رَماني بِمَعشَرٍ","يَرَونَ عُلُوَّ الشَأنِ في حَطِّهِم شاني",71,"ي",1,0],["ذَمَمتُ نَفسي حينَ وَلِيَ الزَمانُ","وَلَم أُشاهِد حُسنَهُم يا نَديمُ",72,"م",1,0],["ذمّموا من كرهتموه وحيّوا","بالتهاليلِ ن تحبّبتموهُ",73,"ه",1,0],["ذَمَمتُكَ أَوَّلاً حَتّى إِذا ما","بَلَوتُ سِواكَ عادَ اللَومُ حَمدا",74,"د",2,1],["ذمَمْتُ بها اللّئامَ فقال صَحْبي","أأيّاماً تُخاطِبُ أم أناما",75,"م",2,0],["ذَماؤُكَ فيها لا دِماؤُكَ فَاِنتَصِفُ","وَإِلّا فَكُن مِن ذَمِّها مُتَذَمِّما",76,"م",2,0],["ذمَّةٌ قد وفيت فيها لديهم","وعلى الحرِّ أن يفي بالذّمام",77,"م",1,0],["ذُمَّ الفِراقُ وما علقْتَ بذمّةٍ","من سلوةٍ فمتى يُذمّ لقاءُ",78,"ا",2,0],["ذُمَّتْ لِعَيْنِكَ أَعْيُنُ الْغِزْلانِ","قَمَرٌ أَقَرَّ لِحُسْنِهِ الْقَمَرانِ",79,"ن",1,1],["ذُمَّ الحِفاظَ فذو الصرامة عندهم","معطي الخلابِ ومانعُ الماعونِ",80,"ن",1,0],["ذممتك فيها بالشجاعة مقدِماً","ولو قد جبُنتَ اخترتُ حمدي على الجُبنِ",81,"ن",1,0],["ذِمَمٌ لو اعتَصَمَ العُداةُ بمثلها","عقدوا بهنّ لديك خيرَ مَعاقدِ",82,"د",1,0],["ذممتُ فؤادي فيك والحزنُ محرقٌ","وعاتبتُ جفنَ العين والدمعُ مُقرِحُ",83,"ح",1,0],["ذمَّ الأحاظِي طالبٌ لم يَجِدْ","فكيف وِجداني ولم أَطلُبِ",84,"ب",1,0],["ذِمْرٌ إِذا ما الخميسُ نازلَهُ","فللخميسِ الويْلاتُ والحَرَبُ",85,"ب",1,0],["ذِمْرٌ يُقَحِّمُ في الغِمار ومحجم","عَفٌّ عن الاُسَراءِ والأسْلابِ",86,"ب",1,0],["ذِماماً أميرَ المؤمنينَ وعَطْفَةً","فسُخطك موتٌ للنفوسِ زُؤامُ",87,"م",1,0],["ذممنا على حكم الصدود ذمامهُ","وكم حاز حسناً ما حمدنا له حسنى",88,"ن",2,0],["ذم الورى كل محمود وما تبعوا","غير الأوائل فيما قبل والسلفا",89,"ف",2,0],["ذمَّ دمعي خيفةً من بوحهِ","أسمعتم من يذمُّ المزنا",90,"ن",2,0],["ذمتُ به غدر الليالي ولم تكن","بأوَّلِ أنثى من خلائقها الغدر",91,"ر",1,0],["ذمَّ النوى كلُّ مخلوقٍ وربَّ نوى","شكرتُ فيها جيادَ الخيل وإلا بلا",92,"ل",2,0],["ذمم تباع وتشترى","تعرى وتنبذ بالعرا",93,"ر",2,1],["ذمنا للزمان ذم لمن في","ه وحق أن لا يذم الزمان",94,"ن",1,0],["ذَمَمتُ امرَأً لم يَطبَعِ الذَمُّ عرضَهُ","قَليلاً لَدى تَحصيلِهِ مَن يُشاكِلُهْ",95,"ل",2,0],["ذَمَمْتُ سواك المالكين لأنّهمْ","تولَّوْا وما أوْلَوْا جميلَ صنيعِ",96,"ع",1,0],["ذمي بمشبه مدحي فيك أكد","ان لا تقى لك غير الغش والتهم",97,"م",1,0],["ذموا على مقدار جهل نفوسهم","واستثقلوا قول الهمام الأحوذي",98,"ي",1,0],["ذم الذي كان أراد ذمة","فقد يكون حين ذم الأمة",99,"ه",1,0],["ذُمَّ الزَمانُ فَأَبداكُم لِنَحمَدَه","وَتِلكَ حُجَّةُ صِدقٍ لَيسَ يَدفَعُها",100,"ع",3,0],["ذَمِّي لأَيامِيَ من بعدهِ","يَشْغَلُني عن شُكرِ تلك الليالْ",101,"ل",1,0]]}