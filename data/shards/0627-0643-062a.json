بالمكيال فضل هباته","وأبيحه الأمداح بالأوزان",4,"ن",1,0],["اكتَهلتْ همَّتي فأصبحتُ لا","أبهَجُ بالشيء كنت أبهجُ بِهْ",5,"ه",1,1],["أَكِتابٌ مِن فاضِلٍ","قالَ قَولاً فَأَسهَبا",6,"ب",2,1],["اِكتُشِفَت فَاِمَّحَت","غَيرَ شَذاً أَو ضَرَم",7,"م",1,0],["اِكتُب بِنا أَبَداً بَعدَ الكِتابِ بِهِ","فَإِنَّما نَحنُ لِلأَسيافِ كَالخَدَمِ",8,"م",1,0],["اكتب لوجه الفَنِّ لا تعدل به","عَرَض الحياة ولا الحطام الفاني",9,"ن",2,0],["اكتمِ الغيظَ إنْ هُجيتَ وإلا","زادَ هاجيكَ في الهجاءِ وقبَّحْ",10,"ح",1,1],["اكْتُبْ وَقُلْ وارْفَعْ لِقومكَ ذِكرَهُمْ","هذا هو القَصصُ البديعُ السّامي",11,"م",2,0],["اكتبِ العَهدَ بَينَنا وَاِجعَلِ المُص","حَفَ خَيرَ الشُهودِ فيهِم وَفينا",12,"ن",2,0],["اكتُبْ عَليُّ فلن ترى من جامحٍ","إلا يُزَمُّ على الزّمانِ وَيُخطَم",13,"م",1,0],["اِكتُبي وَاِنظُري إِلى شَبَهِ الأَح","رُفِ ثُمَّ اِجمَعيهِما في الحِسابَه",14,"ب",2,0],["اِكتَسى ريشَ جَناحَي","جَعفَرٍ ثُمَّ تَرَقّى",15,"ق",2,0],["اِكتُبي إِن كَتَبتِ يا مُنيَةَ النَف","سِ بِنُصحٍ وَرِقَّةٍ وَبَيانِ",16,"ن",1,1],["أكتُم حَديثَكَ عَن أَخيكَ وَلا تَكُن","أَسرارُ قَلبَكَ مِثلَ أَسرارِ اليَدِ",17,"د",1,1],["اُكْتُمْ ضَمِيرَكَ مِنْ عَدُوِّكَ جَاهِداً","وَحَذَارِ لا تُطْلِعْ عَلَيْهِ رَفِيقَا",18,"ق",2,1],["اكتُبْ وألِّف كيف شئ","تَ؛ فأنْتَ من أهل الجُدود",19,"د",1,0],["أكتب على أيدين الزمان البخيله","أن البخل؟؟ ماهو بشح الكرامات",20,"ت",1,0],["أكتّمُ في الأضلاع ما لو نشرته","تعجبت الأوجاع مني.. ومن صبري",21,"ر",2,0],["أَكتُبها وَالدُموع تَنقطها","بِعبرة لا أَزال أُهملها",22,"ل",3,0],["اكْتَسى الخوفُ وَجْهَهَ وتَعالتْ","في حَناياهُ زَفْرَةٌ وكآبَةْ",23,"ب",2,0],["أكتمُ ما حلَّ بي لأني","أخاف أن يشمت الحسودُ",24,"د",1,1],["اكتب في جِسمِهِ بخطِّي","نوناً وياءً لها وكافا",25,"ف",2,0],["أَكتَسي مِنها جَمالاً","رائِعاً في كُلِّ نَدوَه",26,"و",2,0],["أَكتَسي رَونَقاً بِمَلبَسِها الضا","في فَتُمسي صوراً إِلَيَّ العُيونُ",27,"ن",1,0],["أكتفي بالصَّدِّ حيناً","منكِ قَهْراً، فاعذريني",28,"ن",2,0],["أكتوي ظلماً وزوراً","كل يومٍ في نحيبِ",29,"ب",1,0],["أَكْتَوي ليلاً بنارٍٍ","ثُمَّ صُبحاً أَسْتَدينُ",30,"ن",1,0],["أكتوي بال