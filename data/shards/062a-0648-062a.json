{"poems":[[95,"هانت معالم مات سيدها","https://www.aldiwan.net/poem11139.html","أحذ الكامل"],[95,"ألتاج تاج مملكين عظام","https://www.aldiwan.net/poem11386.html","الكامل"],[29,"يا صاحبي هل الصباح منير","https://www.aldiwan.net/poem5778.html","الكامل"],[74,"لسائل دمعي من هواك جواب","https://www.aldiwan.net/poem18231.html","الطويل"],[87,"في ذي الجفون مصارع الأكباد","https://www.aldiwan.net/poem6821.html","الكامل"],[30,"ستبلغ عني غدوة الريح أنها","https://www.aldiwan.net/poem5558.html","الطويل"],[107,"سيري الهوينى دومة الجندل","https://www.aldiwan.net/poem44201.html","السريع"],[107,"طف بالمصارع واستمع نجواها","https://www.aldiwan.net/poem44218.html","الكامل"],[52,"يا حب إن دواء الحب مفقود","https://www.aldiwan.net/poem63939.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55197","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54858","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138404",""],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66747","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100953","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74158","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74064","الكامل"],[5431,"أخافُ نهايةً لاضوء فيها ...","https://www.poetsgate.com/ViewPoem.aspx?id=210680",""],[5829,"هل الهلال فهللوا","https://www.poetsgate.com/ViewPoem.aspx?id=180665",""],[5841,"شهريار وشهرزادي","https://www.poetsgate.com/ViewPoem.aspx?id=34907",""],[5956,"قناديل عينيكِ","https://www.poetsgate.com/ViewPoem.aspx?id=182182",""]],"verses":[["تَوَتِ العَزَائِمُ غَيْرَ أَنَّ لَهَا","بَيْنَ الوَرَى سِيَراً تُخَلِّدُهَا",0,"د",3,0],["تؤْتَى المُلُوك الحَزْمَ بَعْدَ تَجَارِبٍ","وَكَأَنَّمَا تُؤْتَاهُ بِالإِلْهَامِ",1,"م",1,0],["تُؤتى الكِرامُ مُهورَهُنَّ سِياقَةً","وَنِساءُ بارِقَ ما لَهُنَّ مُهورُ",2,"ر",1,0],["توترَ لفظاً كالجمانِ سحابهُ","على جانب الملك العقيم سِحاب",3,"ب",1,0],["تؤتى رعيتك الوفية سؤلها","وتبلغ الأوطان كل مراد",4,"د",1,0],["تُوَتِّرُ لي قَيسٌ قِياسَ حِظائِها","وَما أَنا عَمّا ساءَ قَيساً بِنائِمِ",5,"م",1,0],["تُؤتي الجَنى كالأرْيِ طِيباً إذا","كان الجنَى كالصّابِ والحنظل",6,"ل",1,0],["تُؤْتِي الممالكَ والشُّعوبَ حيَاتَها","وتُقيمُ من أمجادِها وعُلاها",7,"ا",3,0],["تُؤتيكَ ما شِئتَ مِن عَهدٍ وَمِن عِدَةٍ","فَالوَعدُ دانٍ وَبابُ النَيلِ مَسدودُ",8,"د",1,0],["تُؤتِي الغِنَى وَيَعِيشُ فِي أَكْنَافِهَا","آلاَفُ آلافٍ مِنَ العُمَّالِ",9,"ل",1,0],["تُؤْتِي صَحَائِفُهَا طَرَائِفَهَا","مَا الطرْفُ مَرَّ بِهَا وَمَا كَرَّا",10,"ر",2,0],["توت عنخ آمون كليوبطرا وغيرهما","من العواهل مصريّ ويوناني",11,"ن",2,0],["تُؤتى هواكَ إذا نطقتَ بحاجةٍ","فيهِ وتَشفعُ عنده فيشفِّعُ",12,"ع",1,0],["توتَنخَمون أعِد حديثك في الورى","عجباً فأمر بني أبيك عُجاب",13,"ب",1,0],["تُؤتوا الزكاة وَأَنتُم راكِعون فَمن","رامَ اللحوق بسامي مجدكم حصرا",14,"ر",2,0],["توت عنخ آمونَ الَّذي","ذهبَ الزَمانُ بهِ وَعاد",15,"د",1,0],["توترُ موجة الإبداع صفرٌ","كأنّا ما تعاهدنا النشاطا",16,"ط",2,0],["تؤتي ثمارا لا يضاهى طرحها","علما وفكرا مُثقَلَ الأغصان",17,"ن",1,0],["توته توته توته توته انتهت يا قارئين","قصة(ن)فضْحت خيالي جوهرة هي في قلادي",18,"د",2,0],["تَوَتَّر قَلْبُك، والعطْفُ ين","زفُ منّي عليك لما قد دهاكْ",19,"ك",1,0]]}