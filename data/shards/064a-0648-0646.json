{"poems":[[53,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[53,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[91,"سلام على عهد الرقي المحبب","https://www.aldiwan.net/poem44927.html","الطويل"],[87,"اخترت يوم الهول يوم وداع","https://www.aldiwan.net/poem62860.html","الكامل"],[47,"كلفني فوق الذي أستطيع","https://www.aldiwan.net/poem64668.html","الرجز"],[124,"عباس إن ابني لي مفزع","https://www.aldiwan.net/poem49262.html","السريع"],[190,"ومستبطئ موتي لعل حمامه","https://www.aldiwan.net/poem43367.html","الطويل"],[302,"أما والشفاه اللعس والأعين النعس","https://www.aldiwan.net/poem33235.html","الطويل"],[310,"على مثلها من أنعم يجب الشكر","https://www.aldiwan.net/poem56549.html","الطويل"],[396,"قلت الراحة في هذا الزمن","https://www.aldiwan.net/poem54536.html","عموديه"],[408,"ملكتم فؤادا ليس يدخله العذل","https://www.aldiwan.net/poem46985.html","الطويل"],[422,"أعالج قلبا في هواكم معذبا","https://www.aldiwan.net/poem54034.html","الطويل"],[466,"سألت إله العرش رب محمد","https://www.aldiwan.net/poem16158.html","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[817,"","https://poetry.dctabudhabi.ae/diwan/poem/145553","الوافر"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199559","الصخري"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145820","المتقارب"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119959","السريع"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138083",""],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144127","السريع"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18462","الرجز"],[1762,"","https://poetry.dctabudhabi.ae/diwan/poem/89628","السريع"],[2462,"","https://poetry.dctabudhabi.ae/diwan/poem/144709","المنسرح"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201740","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204744","الطويل"],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145539","الخفيف"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100165","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62903","الطويل"],[4929,"مجارة لعمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=199244",""],[5320,"حب يحتضر","https://www.poetsgate.com/ViewPoem.aspx?id=42995",""],[592,"ألا قل لأهل الجهل من كل من قد طغى","https://www.poetsgate.com/ViewPoem.aspx?id=128809",""],[5957,"للتسامح ِ ضفافٌ","https://www.poetsgate.com/ViewPoem.aspx?id=183596",""],[6144,"باريس خلاص","https://www.poetsgate.com/ViewPoem.aspx?id=21847",""]],"verses":[["يُونقُ العينَ حسنُ ما في أَكُفٍّ","ثَمَّ تَسقي وحُسْنُ ما في رقابِ",0,"ب",1,0],["يؤنِسُهُ حُسنهُ ويوحشهُ","قبحُ أفاعيله إذا ذكره",1,"ر",2,0],["يؤنب في تجديدي الشعر صاحبي","فيا صاحبي بعد التفكر أنب",2,"ب",1,0],["يونانُ لَو بيعَت بِهوميرٍ لَما","خَسِرَت لَعَمرُكَ صَفقَةُ المُبتاعِ",3,"ع",1,0],["يُؤنَسُ بِالسَيفِ اِغتِراراً بِهِ","وَفي غِرارِ السَيفِ مَوتٌ ذَريع",4,"ع",1,0],["يؤنسني في وحشتي هذره","فلا عدمت الأنس من هذره",5,"ر",2,0],["يؤنّبني عيبا جناه لي الهوى","ولا عيب لي في حادث ليس من فعلي",6,"ل",2,0],["يؤنِّبني اللوّامُ فيها سَفاهةً","وَلا وَحشَتي للائمين ولا أنسي",7,"س",2,0],["يؤنِّقهُ روضُ المكارِمِ يانعاً","وَأَزهاره شكرٌ وَأَثماره أجرُ",8,"ر",1,0],["يؤنسك في حين موتك والكفن","وكذا في القبر فاذكر ياغفول",9,"ل",1,0],["يؤنَبني في حُبّكمْ كلُّ فارغٍ","ولي بهواكم عَنْ ملامَتهم شغلُ",10,"ل",1,0],["يؤنّبني اللاّحون فيك ولم أكن","لأسْمَعَ في الحبّ العذول المؤَنِّبا",11,"ب",2,0],["يُؤنِّسُ بالألطافِ كلَّ مُنَفَّرٍ","ويحوي من الإحسان كلَّ مُشرَّدِ",12,"د",1,0],["يؤنس أوهام العقول تأنسي","وبسرى بسر الفهم لطف تحسى",13,"س",2,0],["يؤنبني بغيبة مستطيل","ويلقاني بصفحة مستكين",14,"ن",1,0],["يون سعيد من عوقٍ شديد","وإلى ون المشقّوى ما يلامي",15,"م",2,1],["يُؤنِّقُ هدأتَنَا كُلَّما","لَمَسْنَا جَبينَ الضَّجيج ِاسْتَكانَا",16,"ن",2,0],["يونس محيى الدين مجيي النَّدى","وقاتل الأعدام والمحلِ",17,"ل",1,0],["يؤنبني الواشي بحبي وحبكم","ولو عقل الواشي بنا لم يؤنب",18,"ب",1,0],["يؤنسُه إنْ ملّهُ صاحبٌ","فهو على الوحدة في أهلِ",19,"ل",1,0],["يُؤنِسُها مِن رَوعَةِ التَجَفُّلِ","بِذاتِ أَثناءٍ خَريقِ الأَسفَلِ",20,"ل",1,0],["يؤنسُ مَعروفي نَزيلي وَقَد","أُخرِجُ ضَبَّ الخَصمِ الأَجدَلِ",21,"ل",1,0],["يونس قلبي عليك يلتهف","والعين عبرى دموعها تكف",22,"ف",1,1],["يؤنّبني أَني جلبت له العنا","بشعر يطوف البر لا يدخل البحرا",23,"ر",2,0],["يؤنبني كيف الدخول بدونها","وتلك جواز للدخول مقرر",24,"ر",1,0],["يؤنس البعض منه بعض جلاه","وجهك الطلق لا الصباح الجلي",25,"ي",1,0],["يؤنبني جهلاً وما بين أضلعي","لهيب الغضا يزداد وقداً على وقد",26,"د",1,1],["يُؤنبني أَني وفيتُ لصاحبٍ","فلا ماتَ حتى لا يَفي ويُؤنبَا",27,"ب",2,0],["يُؤَنَّبُ من يُسيئُ إلى نبِيْنا","ويقتل من هجا الوالي اللعينا",28,"ن",2,0],["يؤنسنى الجفو والذكريات","وأحيا جريحا على أى حال",29,"ل",1,0],["يؤنب فيها من رأى منه غلظةً","ويأمر أن يدعى بلين ويحلما",30,"م",2,0],["يؤنبني ضميريَ رُغم إني","وضعتُ لديكم ُ أدب اعترافي",31,"ف",2,0],["يوناني ويحب الغارة ورخره زيه ام منارة","جبار وعاشق جباره طلع هواه وفق هواها",32,"ا",3,0]]}