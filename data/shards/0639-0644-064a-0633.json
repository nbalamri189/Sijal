wan/poem/67357","المتقارب"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67309","المتقارب"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43881","الطويل"],[74,"شجونٌ نحوها العشاقُ فاؤا","https://www.poetsgate.com/ViewPoem.aspx?id=3031",""],[111,"خذوا بجميل الصبر وارضوا وسلموا","https://www.poetsgate.com/ViewPoem.aspx?id=524",""],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[111,"تكب على دنياك وهي تبيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545632",""],[111,"قد اهتزت الأكوان وارتعد الملا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66832&r=&rc=11",""],[128,"إذا داعبه الحب","https://www.aldiwan.net/poem23742.html","الهزج"],[159,"أمغنى الهوى غالتك أيدي النوائب","https://www.aldiwan.net/poem55797.html","الطويل"],[202,"دعاك خليل والأصيل كأنه","https://www.aldiwan.net/poem51848.html","الطويل"],[236,"حكاه من الغصن الرطيب وريقه","https://www.aldiwan.net/poem14810.html","الطويل"],[243,"فعالك تسهتوي القلوب فتطرب","https://www.aldiwan.net/poem23839.html","الطويل"],[263,"على ساكني القلمون مني تحية","https://www.aldiwan.net/poem35770.html","الطويل"],[263,"أدر خمرة الأسرار في الحان يا سعد","https://www.aldiwan.net/poem35808.html","الطويل"],[263,"تبدت هلالا وارتدت بالبها مرطا","https://www.aldiwan.net/poem35934.html","الطويل"],[265,"ترى أي داء من فراقك أعضل","https://www.aldiwan.net/poem38214.html","الطويل"],[279,"ظهيراك التوكل والمضاء","https://www.aldiwan.net/poem25645.html","الوافر"],[308,"يا خيرة الحي عليكم سلام","https://www.aldiwan.net/poem16888.html","السريع"],[407,"سيان من يعذر أو يعذل","https://www.aldiwan.net/poem33487.html","السريع"],[409,"يا قمرا في الفؤاد حلا","https://www.aldiwan.net/poem49813.html","مخلع البسيط"],[420,"إلى العز خوري يا نياقي وأنجدي","https://www.aldiwan.net/poem54159.html","الطويل"],[443,"لعلك يا شمس عند الأصيل","https://www.aldiwan.net/poem34889.html","المتقارب"],[445,"بني راشد الزاكي ابن سالم","https://www.aldiwan.net/poem14480.html","الطويل"],[461,"تموق الليالي فيكم ثم تعقِل","https://www.aldiwan.net/poem55908.html","الطويل"],[461,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[461,"حماها بأطراف الرماح حماتها","https://www.aldiwan.net/poem56261.html","الطويل"],[468,"على سناك سلام الله","https://www.aldiwan.net/poem36230.html","عموديه"],[471,"وغادة تخطو كخوط البان","https://www.aldiwan.net/poem59594.html","الرجز"],[473,"رمى أهل نهري بابل إذ أضلهم","https://www.aldiwan.net/poem4739.html","الطويل"],[541,"إذا كانت على هدي تسير","https://www.aldiwan.net/poem48160.html","عموديه"],[541,"ملامكما كفا فقد قضي الأمر","https://www.aldiwan.net/poem48170.html","عموديه"],[554,"لقد ضل من يسترق الهوى","https://www.aldiwan.net/poem48120.html","المتقارب"],[561,"له الغرب من أوج العلى ولنا الشرق","https://www.aldiwan.net/poem34316.html","الطويل"],[561,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[564,"جاري لا تستنكري عذيري","https://www.aldiwan.net/poem27842.html","الرجز"],[564,"وبلدة بعيدة النياط","https://www.aldiwan.net/poem27843.html","الرجز"],[576,"رضى بقضاء الله فهو مصيب","https://www.aldiwan.net/poem3660.html","الطويل"],[578,"مدحت السرى وهي الحقيقة بالم","https://www.aldiwan.net/poem3019.html","الطويل"],[708,"","https://poetry.dctabudhabi.ae/diwan/poem/97630","الوافر"],[138,"أَلا مَن لهمٍّ آخِرَ الليلِ مُنْصِبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17335&r=&rc=9",""]],"verses":[["عَلَيَّ سَدادُ نَبلي يَومَ أَرمي","وَرَبُّ النَبلِ أَعلَمُ بِالمُصيبِ",0,"ب",1,0],["على ساعَةٍ يُضحي الفِرارُ مُحَبّباً","ويُمْسي الحِفاظُ المُرُّ فيها مُبَغّضا",1,"ض",2,0],["عَلى سَمعِ باقِعَةٍ حاضِرٍ","يَميزُ القَديمَ مِنَ المُبتَكَر",2,"ر",1,0],["عَلى سِنِّها رِفقٌ يَسيلُ وَرَحمَةٌ","وَرَوحٌ لِمَن يَأسى وَذِكرى لِمَن يَعي",3,"ع",2,0],["عَلى سَراةِ مِسحَل مَزؤودِ","ذي جُدَّتَينِ آبِدِ الشَرودِ",4,"د",1,0],["عَلى سابِحٍ نَهدٍ يُشَبَّهُ بِالضُحى","إِذا عادَ فيهِ الرَكضُ سيداً عَمَرَّدا",5,"د",2,0],["عَلى ساعَةٍ لَيسَت بِساعَةِ مَنظِرٍ","رَمَينَ قُلوبَ القَومِ بِالحَدَقِ النُجلِ",6,"ل",1,0],["على ساق سعتْ شجرةٌ وقامت","حروبُ النصرِ وازدَحمَ الظماء",7,"ا",2,0],["عليّ سيوف لشأوِ العلى","وحاتم في القوم من لاحق",8,"ق",1,0],["على سَوَاهِمَ يذرَعْنَ الفلا عَنقَاً","بأذرعٍ شَدَنِيَّاتٍ وأعضادِ",9,"د",1,0],["على سماعٍ مُطربٍ معجِبٍ","ألذَّ من نُجح المواعيدِ",10,"د",1,0],["على ساحِلِ البَحْرِ أَنَّى يضجُّ","صُراخُ الصَّباحِ ونَوْحُ المَسَا",11,"س",2,1],["عَلى سابِحٍ مَوجَ المَنايا بِنَحرِهِ","غَداةَ كَأَنَّ النَبلَ في صَدرِهِ وَبلُ",12,"ل",1,0],["عَلى ساقِ مِقحادٍ جَعَلنا عَشاءَهُ","شَطائِبَ مِن حُرِّ السَنامِ المُسَرهَدِ",13,"د",1,0],["عَلى سَورَةٍ حَتّى كَأَنَّ عَزيزَها","تَرامى بِهِ مِن بَينِ نيقَينِ نَفنَفُ",14,"ف",1,0],["عَلى سُفُنِ الفَلاةِ مُرَدَّفاتٍ","جُناةَ الحَربِ بِالذَكَرِ الحُسامِ",15,"م",1,0],["عَلى ساعَةٍ لَو كانَ في القَومِ حاتِمٌ","عَلى جودِهِ ضَنَّت بِهِ نَفسُ حاتِمِ",16,"م",1,0],["على سَبَجٍ من أرْضِهِ وجُيوشُه","قِيامٌ على أرجائِها وهي خُشَّعُ",17,"ع",1,0],["عَلى سَيِّدِ البَطحاءِ وَابنِ رَئيسِها","وَسَيدَةِ النِسوانِ أَوَل مَن صَلّى",18,"ل",2,0],["عَلى سُرعَةِ الشَمسِ في مَرِّها","دَبيبُ الخُلوقَةِ في الجِدَّةِ",19,"ه",1,1],["عَلى سُرُرٍ تُرى مُتَقابِلاتٍ","أَلا ثَمَّ النَضارَةُ وَالنَعيمُ",20,"م",1,0],["عَلى سَوداءَ مُشرِفَةٍ بِسُوقٍ","بَناها القَمحُ مُزلَقَةِ المَراقي",21,"ق",2,0],["عَلى سَفَرٍ هَذا الأَنامُ فَخَلِّنا","لِأَبعَدِ بَينَ واقِعٍ نَتَحَوَّجُ",22,"ج",1,0],["على سِنِينَ تَقَضّتْ عند غيرِهِمِ","أسِفْتُ لا بلْ على الأيّام والسّاعِ",23,"ع",1,0],["على سَيٍّدٍ ماجدٍ جَحْفَلٍ","وَخَيْرِ الأَنَامِ وخَيْرِ اللُّها",24,"ا",1,0],["على سَيّدٍ هَدَّنَا هُلْكُهُ","كريمِ المشَاهدِ والعُنْصُرِ",25,"ر",1,0],["على سَلْسَلٍ من ذِي غُروبٍ وإِن غَدَتْ","رِمالُ الفَيافي كالروَاءِ المُسلسَلِ",26,"ل",1,0],["على ساق سعت شجرٌ وقامت","حروبُ النصرِ وازدحمَ الظماء",27,"ا",2,0],["على سورة في المجد قر أساسه","له شرف فوق السماكين ينجم",28,"م",1,0],["على سراة شامس مطهم","معترق في جريه عبل الشوى",29,"ا",1,0],["على سيد لو عاش عاشت حياتنا","وإذ مات ماتت أنفس وجدود",30,"د",1,0],["على سيرة الفاروق...عدلا ًوحكمة","ً يسير بها لله ليس لما خلا",31,"ل",2,0],["على سنة ذاهمة مشمخرة","لاظهار حكم الله حتى تهللا",31,"ل",2,0],["على سوق مزيفة","مذ الكسحان ما دبوا",32,"ب",3,0],["عَلَى سافراتٍ للطِّعان نحورُها","أَقَلُّ حياءً من صروف النوائبِ",33,"ب",1,0],["على سطحِ خيرٍّ ذكرتُكَ فانثنى","يميلُ بأعناقٍ ويرنو بأحداق",34,"ق",1,0],["عَلى سالِفَيهِ لِلعِذارِ جَديدُهُ","وَفي شَفَتَيهِ لِلسُلافِ عَتيقُهُ",35,"ق",2,0],["على سبلة الزلفي أفاق طغاتهم","وليس لهم بعد الهزيمة مهرب",36,"ب",1,0],["على ساكني القلمون منّي تحيّةً","تفوح بنفح الطيب والمسلك والندِّ",37,"د",1,1],["على سررٍ مرفوعةٍ ونمارقٍ","وريح الصَّبا بالنشر في حيّها تعدو",38,"د",2,0],["عليّ سواءٌ وصلها وصدودها","كما يستوي عندي لها المنع والإعطا",39,"ط",2,0],["على سفر في الدهر نحن وانما","نخيم في الدنيا قليلا ونرحل",40,"ل",1,0],["عَلى سِير الإمارَة لم تَرِمْها","لَدَيْها يَشْفَعُ البَأس الحياءُ",41,"ا",2,0],["على سبيل المصطفى المجتبي","محمد الهادي لدار السلام",42,"م",1,0],["على سوى برق الحمى إن شرا","من أفقه قلبي لا يقبل",43,"ل",1,0],["علَّي سيفَ الصُّدودِ سَلاّ","والقَلبُ مِنهُ للوَصلِ سَلاّ",44,"ل",2,0],["على سنن الماضيين من غرِّ قومه","بآبائه الغرِّ الميامين يقتدي",45,"د",2,0],["عَلَى سابِقٍ فِي قُيودِ الخُطُوبِ","ونجمِ سَناً فِي غُثاءِ السُّيولِ",46,"ل",1,0],["على سالم ابكى وتبكي جمايع","بدمع عيون في الخدود سواجم",47,"م",1,0],["على سرجهِ إن أركبتْهُ حميَّةٌ","أخو لِبَدٍ بادي الطوَى متبسّلُ",48,"ل",1,0],["على سبيلي في مُوالاتِكُمُ","أمرّ فرداً لا أخاف الخطَرا",49,"ر",2,0],["على ساعةٍ جِنُّ الفلاةِ ووحشُها","تريها الشخوصَ الزُّورَ عنا فلاتُها",50,"ت",3,0],["على سَناكَ سَلامُ اللهِ ما مَطَرَتْ","وَما الضُّحى وَظلامَ الليلِ يَختَلِفُ",51,"ف",1,0],["عَلى سَماءِ جيدِها الفِتيانِ","جَوزاءُ عِقدٍ وَهِلالُ جانِ",52,"ن",1,0],["عَلَى سَاعَةٍ لا عُذرَ فيها لِظالِمٍ","وَلا لَهُمُ مِن سَطوَةِ اللَهِ مانِعُ",53,"ع",1,0],["على سَبكِ المَعاني والمَباني","قَدرَتَ ومثلُكَ الشَّهمُ القَديرُ",54,"ر",1,0],["على سادةٍ غُرٍّ تَضَوَّعَ مِنهُمُ","منَ المِسكِ نَشرٌ لا يُافاوِحُه نَشرُ",55,"ر",1,0],["عَلى سابِحٍ في بِحارِ المنونِ","كفيلٍ بِوَطء الشَّوى بالشّوى",56,"ا",1,0],["على سره منه الرضى وهو سرنا","فمنا علينا ذاك ما غنت الوُرْق",57,"ق",1,0],["علي سلامي في الورى يوم مولدي","وموتي وبعثي ماهمى الدهر هامع",58,"ع",1,0],["عَلى سَراةِ رائِحٍ مَمطورِ","ظَلَّ بِذاتِ الحاذِ وَالجُذورِ",59,"ر",1,0],["عَلى سَراةِ ناشِطٍ خَطّاطِ","يُقَلِّبُ الطَرفَ بِذي أَراطِ",60,"ط",1,0],["عَلى سَفَرٍ لا زادَ فيهِ سِوى التُقى","وَلا ظاعِنَ الأَقوامِ عَنهُ يَؤوبُ",61,"ب",1,0],["على سُنَّةِ العُشَّاقِ أَو بِدْعةِ الهوى","حَمَلْتُ بجهْلي إِذْ جهِلْتُ على حِلْمِي",62,"م",2,0],["عَلى سَهلِ الخليقةِ أبطحيٍّ","كَريمِ الخيم شيمَتهُ العلاءُ",63,"ا",2,0],["على ساخطٍ مِنْ قَومِنا غيرِ مُعتَبِ","فأمسى ابنُ عبدِ اللهِ فينا مُصَدَّقاً",64,"ق",2,0]]}