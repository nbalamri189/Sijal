{"poems":[[53,"ألان جوانبي غمز الخطوب","https://www.aldiwan.net/poem30752.html","الوافر"],[63,"خضاب على فودي للدهر ما نضا","https://www.aldiwan.net/poem46185.html","الطويل"],[86,"نعاك النعاة وحم القدر","https://www.aldiwan.net/poem10471.html","المتقارب"],[86,"بلابل وادي النيل بالمشرق اسجعي","https://www.aldiwan.net/poem68896.html","الطويل"],[30,"هل تعرف المنزل بالوحيد","https://www.aldiwan.net/poem29596.html","الرجز"],[27,"غدا باجتماع الحي نقضي لبانة","https://www.aldiwan.net/poem5735.html","الطويل"],[27,"عوجي علينا واربعي ربة البغل","https://www.aldiwan.net/poem5972.html","الطويل"],[72,"شجون نحوها العشاق فاؤا","https://www.aldiwan.net/poem18162.html","الوافر"],[72,"بطيفك يا بدر والطارق","https://www.aldiwan.net/poem19351.html","المتقارب"],[51,"قل للأمير أدام الله غبطته","https://www.aldiwan.net/poem10869.html","البسيط"],[51,"عيدان مجموعان في عيد","https://www.aldiwan.net/poem11441.html","السريع"],[92,"على ساحل البحر أنى يضج","https://www.aldiwan.net/poem38936.html","المتقارب"],[43,"عزيز أسى من داؤه الحدق النجل","https://www.aldiwan.net/poem9987.html","الطويل"],[28,"وليلة ليل قد رفعت سناءها","https://www.aldiwan.net/poem5000.html","الطويل"],[28,"منازيل عن ظهر القليل كثيرنا","https://www.aldiwan.net/poem5340.html","البسيط"],[28,"ألستم عائجين بنا لعنا","https://www.aldiwan.net/poem5607.html","الوافر"],[28,"ما نحن إن جارت صدور ركابنا","https://www.aldiwan.net/poem5609.html","الطويل"],[61,"ولما اصطحبنا والخمار يصدنا","https://www.aldiwan.net/poem51564.html","الطويل"],[58,"أعيني جودا بارك الله فيكما","https://www.aldiwan.net/poem30897.html","الطويل"],[49,"على سرعة الشمس في مرها","https://www.aldiwan.net/poem64139.html","الطويل"],[21,"جهنم تلك لا تبقي بغيا","https://www.aldiwan.net/poem36164.html","الوافر"],[40,"فكم من كاعب حوراء رود","https://www.aldiwan.net/poem42292.html","الوافر"],[46,"لقد جاءنا هذا الشتاء وتحته","https://www.aldiwan.net/poem22239.html","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16623","البسيط"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67357","المتقارب"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67309","المتقارب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43881","الطويل"],[72,"شجونٌ نحوها العشاقُ فاؤا","https://www.poetsgate.com/ViewPoem.aspx?id=3031",""],[124,"إذا داعبه الحب","https://www.aldiwan.net/poem23742.html","الهزج"],[155,"أمغنى الهوى غالتك أيدي النوائب","https://www.aldiwan.net/poem55797.html","الطويل"],[198,"دعاك خليل والأصيل كأنه","https://www.aldiwan.net/poem51848.html","الطويل"],[232,"حكاه من الغصن الرطيب وريقه","https://www.aldiwan.net/poem14810.html","الطويل"],[239,"فعالك تسهتوي القلوب فتطرب","https://www.aldiwan.net/poem23839.html","الطويل"],[259,"على ساكني القلمون مني تحية","https://www.aldiwan.net/poem35770.html","الطويل"],[259,"أدر خمرة الأسرار في الحان يا سعد","https://www.aldiwan.net/poem35808.html","الطويل"],[259,"تبدت هلالا وارتدت بالبها مرطا","https://www.aldiwan.net/poem35934.html","الطويل"],[261,"ترى أي داء من فراقك أعضل","https://www.aldiwan.net/poem38214.html","الطويل"],[275,"ظهيراك التوكل والمضاء","https://www.aldiwan.net/poem25645.html","الوافر"],[304,"يا خيرة الحي عليكم سلام","https://www.aldiwan.net/poem16888.html","السريع"],[403,"سيان من يعذر أو يعذل","https://www.aldiwan.net/poem33487.html","السريع"],[405,"يا قمرا في الفؤاد حلا","https://www.aldiwan.net/poem49813.html","مخلع البسيط"],[416,"إلى العز خوري يا نياقي وأنجدي","https://www.aldiwan.net/poem54159.html","الطويل"],[439,"لعلك يا شمس عند الأصيل","https://www.aldiwan.net/poem34889.html","المتقارب"],[441,"بني راشد الزاكي ابن سالم","https://www.aldiwan.net/poem14480.html","الطويل"],[458,"تموق الليالي فيكم ثم تعقِل","https://www.aldiwan.net/poem55908.html","الطويل"],[458,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[458,"حماها بأطراف الرماح حماتها","https://www.aldiwan.net/poem56261.html","الطويل"],[465,"على سناك سلام الله","https://www.aldiwan.net/poem36230.html","عموديه"],[468,"وغادة تخطو كخوط البان","https://www.aldiwan.net/poem59594.html","الرجز"],[470,"رمى أهل نهري بابل إذ أضلهم","https://www.aldiwan.net/poem4739.html","الطويل"],[538,"إذا كانت على هدي تسير","https://www.aldiwan.net/poem48160.html","عموديه"],[538,"ملامكما كفا فقد قضي الأمر","https://www.aldiwan.net/poem48170.html","عموديه"],[551,"لقد ضل من يسترق الهوى","https://www.aldiwan.net/poem48120.html","المتقارب"],[558,"له الغرب من أوج العلى ولنا الشرق","https://www.aldiwan.net/poem34316.html","الطويل"],[558,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[561,"جاري لا تستنكري عذيري","https://www.aldiwan.net/poem27842.html","الرجز"],[561,"وبلدة بعيدة النياط","https://www.aldiwan.net/poem27843.html","الرجز"],[573,"رضى بقضاء الله فهو مصيب","https://www.aldiwan.net/poem3660.html","الطويل"],[575,"مدحت السرى وهي الحقيقة بالم","https://www.aldiwan.net/poem3019.html","الطويل"]],"verses":[["عَلَيَّ سَدادُ نَبلي يَومَ أَرمي","وَرَبُّ النَبلِ أَعلَمُ بِالمُصيبِ",0,"ب",1,0],["على ساعَةٍ يُضحي الفِرارُ مُحَبّباً","ويُمْسي الحِفاظُ المُرُّ فيها مُبَغّضا",1,"ض",2,0],["عَلى سَمعِ باقِعَةٍ حاضِرٍ","يَميزُ القَديمَ مِنَ المُبتَكَر",2,"ر",1,0],["عَلى سِنِّها رِفقٌ يَسيلُ وَرَحمَةٌ","وَرَوحٌ لِمَن يَأسى وَذِكرى لِمَن يَعي",3,"ع",2,0],["عَلى سَراةِ مِسحَل مَزؤودِ","ذي جُدَّتَينِ آبِدِ الشَرودِ",4,"د",1,0],["عَلى سابِحٍ نَهدٍ يُشَبَّهُ بِالضُحى","إِذا عادَ فيهِ الرَكضُ سيداً عَمَرَّدا",5,"د",2,0],["عَلى ساعَةٍ لَيسَت بِساعَةِ مَنظِرٍ","رَمَينَ قُلوبَ القَومِ بِالحَدَقِ النُجلِ",6,"ل",1,0],["على ساق سعتْ شجرةٌ وقامت","حروبُ النصرِ وازدَحمَ الظماء",7,"ا",2,0],["عليّ سيوف لشأوِ العلى","وحاتم في القوم من لاحق",8,"ق",1,0],["على سَوَاهِمَ يذرَعْنَ الفلا عَنقَاً","بأذرعٍ شَدَنِيَّاتٍ وأعضادِ",9,"د",1,0],["على سماعٍ مُطربٍ معجِبٍ","ألذَّ من نُجح المواعيدِ",10,"د",1,0],["على ساحِلِ البَحْرِ أَنَّى يضجُّ","صُراخُ الصَّباحِ ونَوْحُ المَسَا",11,"س",2,1],["عَلى سابِحٍ مَوجَ المَنايا بِنَحرِهِ","غَداةَ كَأَنَّ النَبلَ في صَدرِهِ وَبلُ",12,"ل",1,0],["عَلى ساقِ مِقحادٍ جَعَلنا عَشاءَهُ","شَطائِبَ مِن حُرِّ السَنامِ المُسَرهَدِ",13,"د",1,0],["عَلى سَورَةٍ حَتّى كَأَنَّ عَزيزَها","تَرامى بِهِ مِن بَينِ نيقَينِ نَفنَفُ",14,"ف",1,0],["عَلى سُفُنِ الفَلاةِ مُرَدَّفاتٍ","جُناةَ الحَربِ بِالذَكَرِ الحُسامِ",15,"م",1,0],["عَلى ساعَةٍ لَو كانَ في القَومِ حاتِمٌ","عَلى جودِهِ ضَنَّت بِهِ نَفسُ حاتِمِ",16,"م",1,0],["على سَبَجٍ من أرْضِهِ وجُيوشُه","قِيامٌ على أرجائِها وهي خُشَّعُ",17,"ع",1,0],["عَلى سَيِّدِ البَطحاءِ وَابنِ رَئيسِها","وَسَيدَةِ النِسوانِ أَوَل مَن صَلّى",18,"ل",2,0],["عَلى سُرعَةِ الشَمسِ في مَرِّها","دَبيبُ الخُلوقَةِ في الجِدَّةِ",19,"ه",1,1],["عَلى سُرُرٍ تُرى مُتَقابِلاتٍ","أَلا ثَمَّ النَضارَةُ وَالنَعيمُ",20,"م",1,0],["عَلى سَوداءَ مُشرِفَةٍ بِسُوقٍ","بَناها القَمحُ مُزلَقَةِ المَراقي",21,"ق",2,0],["عَلى سَفَرٍ هَذا الأَنامُ فَخَلِّنا","لِأَبعَدِ بَينَ واقِعٍ نَتَحَوَّجُ",22,"ج",1,0],["على سِنِينَ تَقَضّتْ عند غيرِهِمِ","أسِفْتُ لا بلْ على الأيّام والسّاعِ",23,"ع",1,0],["على سَيٍّدٍ ماجدٍ جَحْفَلٍ","وَخَيْرِ الأَنَامِ وخَيْرِ اللُّها",24,"ا",1,0],["على سَيّدٍ هَدَّنَا هُلْكُهُ","كريمِ المشَاهدِ والعُنْصُرِ",25,"ر",1,0],["على سَلْسَلٍ من ذِي غُروبٍ وإِن غَدَتْ","رِمالُ الفَيافي كالروَاءِ المُسلسَلِ",26,"ل",1,0],["على ساق سعت شجرٌ وقامت","حروبُ النصرِ وازدحمَ الظماء",27,"ا",2,0],["على سوق مزيفة","مذ الكسحان ما دبوا",28,"ب",3,0],["عَلَى سافراتٍ للطِّعان نحورُها","أَقَلُّ حياءً من صروف النوائبِ",29,"ب",1,0],["على سطحِ خيرٍّ ذكرتُكَ فانثنى","يميلُ بأعناقٍ ويرنو بأحداق",30,"ق",1,0],["عَلى سالِفَيهِ لِلعِذارِ جَديدُهُ","وَفي شَفَتَيهِ لِلسُلافِ عَتيقُهُ",31,"ق",2,0],["على سبلة الزلفي أفاق طغاتهم","وليس لهم بعد الهزيمة مهرب",32,"ب",1,0],["على ساكني القلمون منّي تحيّةً","تفوح بنفح الطيب والمسلك والندِّ",33,"د",1,1],["على سررٍ مرفوعةٍ ونمارقٍ","وريح الصَّبا بالنشر في حيّها تعدو",34,"د",2,0],["عليّ سواءٌ وصلها وصدودها","كما يستوي عندي لها المنع والإعطا",35,"ط",2,0],["على سفر في الدهر نحن وانما","نخيم في الدنيا قليلا ونرحل",36,"ل",1,0],["عَلى سِير الإمارَة لم تَرِمْها","لَدَيْها يَشْفَعُ البَأس الحياءُ",37,"ا",2,0],["على سبيل المصطفى المجتبي","محمد الهادي لدار السلام",38,"م",1,0],["على سوى برق الحمى إن شرا","من أفقه قلبي لا يقبل",39,"ل",1,0],["علَّي سيفَ الصُّدودِ سَلاّ","والقَلبُ مِنهُ للوَصلِ سَلاّ",40,"ل",2,0],["على سنن الماضيين من غرِّ قومه","بآبائه الغرِّ الميامين يقتدي",41,"د",2,0],["عَلَى سابِقٍ فِي قُيودِ الخُطُوبِ","ونجمِ سَناً فِي غُثاءِ السُّيولِ",42,"ل",1,0],["على سالم ابكى وتبكي جمايع","بدمع عيون في الخدود سواجم",43,"م",1,0],["على سرجهِ إن أركبتْهُ حميَّةٌ","أخو لِبَدٍ بادي الطوَى متبسّلُ",44,"ل",1,0],["على سبيلي في مُوالاتِكُمُ","أمرّ فرداً لا أخاف الخطَرا",45,"ر",2,0],["على ساعةٍ جِنُّ الفلاةِ ووحشُها","تريها الشخوصَ الزُّورَ عنا فلاتُها",46,"ت",3,0],["على سَناكَ سَلامُ اللهِ ما مَطَرَتْ","وَما الضُّحى وَظلامَ الليلِ يَختَلِفُ",47,"ف",1,0],["عَلى سَماءِ جيدِها الفِتيانِ","جَوزاءُ عِقدٍ وَهِلالُ جانِ",48,"ن",1,0],["عَلَى سَاعَةٍ لا عُذرَ فيها لِظالِمٍ","وَلا لَهُمُ مِن سَطوَةِ اللَهِ مانِعُ",49,"ع",1,0],["على سَبكِ المَعاني والمَباني","قَدرَتَ ومثلُكَ الشَّهمُ القَديرُ",50,"ر",1,0],["على سادةٍ غُرٍّ تَضَوَّعَ مِنهُمُ","منَ المِسكِ نَشرٌ لا يُافاوِحُه نَشرُ",51,"ر",1,0],["عَلى سابِحٍ في بِحارِ المنونِ","كفيلٍ بِوَطء الشَّوى بالشّوى",52,"ا",1,0],["على سره منه الرضى وهو سرنا","فمنا علينا ذاك ما غنت الوُرْق",53,"ق",1,0],["علي سلامي في الورى يوم مولدي","وموتي وبعثي ماهمى الدهر هامع",54,"ع",1,0],["عَلى سَراةِ رائِحٍ مَمطورِ","ظَلَّ بِذاتِ الحاذِ وَالجُذورِ",55,"ر",1,0],["عَلى سَراةِ ناشِطٍ خَطّاطِ","يُقَلِّبُ الطَرفَ بِذي أَراطِ",56,"ط",1,0],["عَلى سَفَرٍ لا زادَ فيهِ سِوى التُقى","وَلا ظاعِنَ الأَقوامِ عَنهُ يَؤوبُ",57,"ب",1,0],["على سُنَّةِ العُشَّاقِ أَو بِدْعةِ الهوى","حَمَلْتُ بجهْلي إِذْ جهِلْتُ على حِلْمِي",58,"ي",1,0]]}