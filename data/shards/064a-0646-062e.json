{"poems":[[164,"ما جود راحتيك والأنواء","https://www.aldiwan.net/poem58975.html","الرجز"],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140259",""],[4988,"سلايل هبس / قبيلة بني خالد","https://www.poetsgate.com/ViewPoem.aspx?id=186506",""],[5364,"المرجلة ماهي ب خواريف واوهام","https://www.poetsgate.com/ViewPoem.aspx?id=177124",""]],"verses":[["ينخدع الكريم إن خادعته","تغابيا ذلك لا غباء",0,"ا",2,0],["ينخسها بالرجل يبغي لحاقها","يقول له إني حللت بواديا",1,"ي",2,0],["ينخاكم اللي هقوته فيكم عضيد","ولا نموت ولا رضينا بالفشيله",2,"ل",2,0],["ينخاك شيخن صاح اردته الاسقام","وصوت العذارى بالبيوت انتّخنا",3,"ن",2,0]]}