 أَنَّكَ قَد جَدَّدتَه","وَلَقَد أَضَعت قَديمُه بِجَديدُه",134,"د",2,0],["وزعمت أنك كالمُهَلب نجدةً","فَحُرمتَها والبيتِ ذي الأركانِ",135,"ن",1,0],["وَزعي يا قَمَر الحُسن كَما","وَزَع البَدر عَلى القَوم الشُعاعا",136,"ع",2,0],["وزعمتم أن لا يكون له التعل","يم أصلاً والقول فيه عناءُ",137,"ا",2,0],["وزعمتم بأن كل نبي","لم يرث منه ماله الأقرباء",138,"ا",2,0],["وزع لك الأوقات ينتظم لك","حالك ويجمع في الدوام شملك",139,"ك",1,0],["وَزَعَمتِ أَنَّكِ تَبخَلينَ وَشَفَّهُ","شَوقٌ إِلَيكِ وَإِن بَخَلتِ أليمُ",140,"م",1,0],["وزعزع منها كلَ ولهي فزعزعت","وأوجع منها كلَ ثكلى وأفجعا",141,"ع",2,0],["وزعت أحشاي أيدي هجركم","أفهل أحشاءكم من جلمد",142,"د",1,0],["وزعمت أن له شريكاً في العلا","وجحدته في فضله التوحيدا",143,"د",2,0],["وزَعَمْتُ زَعمَكِ لَحظَةَ الهَذَيَانِ","ورَمَيتُ حُبَّكِ _مازِحًا_ ورَمَانِي",144,"ن",2,1],["وزعت قلبي عادلا بين الورى","وخَصَصتُ روحَكَ بالمحلِّ الأرفعِ",145,"ع",1,1],["وزعمتم عن الحياة أموراً","تفضح الأدعياء والأقطابا",146,"ب",2,0],["وزّع قصايد ل بلد سلطان","وازرع لأجلا ياسمين وفل",147,"ل",1,0],["وزعمت أن المصطفى هبنا نفا","عنه لفعل الأمرد المتمرد",148,"د",1,0],["وزعمت أنك تبخلن وشفهُ","شوقٌإلك وإنْ بخلتِ أليمُ",149,"م",1,0],["وزعيمها خير الأنام محمد","وبه جميع الكائنات مصدقه",150,"ق",2,0],["وَزَّعُونَا فِي بِلاَدِ اللهِ ظُلْمًا","ثُمَّ قالُوا أُسْكُنوهَا كَالأَسِيرْ",151,"ر",1,0],["وزعمك أني للذي قد نسبته","أريد به مدحاً وما أنا نائله",152,"ل",2,0],["وزعمك أني قد أنزل قولهم","بكل امرئ قد خالف الحق باطله",152,"ل",2,0],["وزعت القنا لهم جسوما","ومزقها بضرب القضب حد",153,"د",1,0],["وزّعتُ نفسي في بيت ٍ وقافية","فراحَ يأكلُ مِنْ أعصابيَ الورَقُ",154,"ق",1,0],["وزعتمُ هذي الضلوعَ (عواضدا) \"2\"","بالباسقاتِ، كجنةٍ خضراء",155,"ا",2,0],["وزَعَمْتِ أَهلكِ يَمنَعُونكِ رَغبَةً","عَنِّي ، وأَهلِي بِي أَضَنُّ وَأَرغَبُ",156,"ب",1,0],["وزَّع القتلَ في المخيم رهطٌ","كان في وَهْمِنا رسولَ العنايهْ",157,"ا",3,0],["وَزَعِيمُها وَكَلِيمُها وَعَلِيمُها","وَحُسامُها وَرَئِيسُها وَعَظِيمُها",158,"م",3,0],["وزعيق أطفال يلاعب بعضهم","بعضا وصيحة بائع جواب",159,"ب",1,0],["وَزَعَمْت أَنَّكَ قَدْ رَضِيتَ فَسَيِّدي","أَرِني عَلىَ الرِّضْوانِ منْكَ عَلاَمَةً",160,"ه",1,0],["وزعيمها خير الأنامِ محمد","نور القلوب وسيّد الثقلانِ",161,"ن",1,0],["وزعمتِ أني ظالمٌ فهجرتنيِ","ورميتِ في قلبي بسهمٍ نافذِ",162,"ذ",1,1],["وزعمت إطلاق العدالة في الورى","يا أيها الملعون كيدك ظاهر",163,"ر",1,0],["وزَّعتهم كفُّ الرّياح فهلاّ","جمعتهم يدُ النسيم الهادي",164,"د",2,0],["وزِّع الأحلامَ في أمواج بحْري","كلُّ بحرٍ في دمي يشرَب بحرَا",165,"ر",2,0],["وَ زَعَمْتَ أَنَّ اللاّجِئِينَ مَكَانُهُمْ","مَنْفىً،يَهِيمُ شِرَاعُهُمْ فِي بَحْرِه",166,"ر",2,0],["وَزَعَمْتَ أَنَّكَ في الكتابة ِ مدركٌ","شأوي وقلتَ سلاحُنَا الأقلامُ",167,"م",1,1]]}