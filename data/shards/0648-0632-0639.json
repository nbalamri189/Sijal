om/ViewPoem.aspx?id=18416",""],[5582,"نَفْسُ المُتَيَّمِ لَوْ ظَلَلْتَ تَلُومُها","https://www.poetsgate.com/ViewPoem.aspx?id=187301",""],[5701,"ذهب الشباب فلات حين شباب","https://www.poetsgate.com/ViewPoem.aspx?id=164620",""],[5733,"لَمَّا غَضِبْتَ حَرَمْتَنِي وَجَفَوْتَني","https://www.poetsgate.com/ViewPoem.aspx?id=201112",""],[5887,"رُغمَ الجراح الداميات بغزّةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=27996",""],[5948,"وزعمتِ أني ظالمٌ فهجرتنيِ","https://www.poetsgate.com/ViewPoem.aspx?id=100593",""],[6106,"سقوط العاهر : امريكا","https://www.poetsgate.com/ViewPoem.aspx?id=6848",""],[6118,"عودة الشراع","https://www.poetsgate.com/ViewPoem.aspx?id=12625",""],[6147,"رقاد في جوف الجنون","https://www.poetsgate.com/ViewPoem.aspx?id=213050",""],[5190,"عودة بلفور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78348&r=&rc=61",""],[572,"وَزَعَمْتَ أَنَّكَ في الكتابة ِ مدركٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9453&r=&rc=310",""]],"verses":[["وَزَعزَعَ نَظمَ الرَمحِ حَتّى يَرُدُّهُ","نِثاراً عَلى الأَعداءِ بِالحَطمِ وَالقَصدِ",0,"د",1,0],["وَزَعتُ رَعيلَها بِالرُمحِ شَذر","عَلى رَبِذٍ كَسِرحانِ الظَلامِ",1,"م",1,0],["وَزَعَمتِ أَنّي لا أُحِبُّكِ صادِقاً","وَاللَهُ يَعلَمُ ما تُجِنُّ ثيابي",2,"ب",2,0],["وَزَعيمٌ بِأَن يُذَلِّلَ لي الصَعبَ","مَثابي إِلى الهُمامِ الزَعيمِ",3,"م",1,0],["وَزَعَمتَ أَمَّكُمُ حَصاناً حُرَّةً","كَذِباً قُفَيرَةُ أُمُّكُم وَالقَوبَعُ",4,"ع",1,0],["وَزَعَمتَ وَيلَ أَبيكَ أَنَّ مُجاشِعاً","لَو يَسمَعونَ دُعاءَ عَمروٍ وَرَّعوا",4,"ع",3,0],["وَزَعفَرانٍ كَدَمِ الأَذباحِ","وَقَينَةٍ وَمِزهَرٍ صَدّاحِ",5,"ح",1,0],["وزعمتَ فيك طبيعةً أرضيةً","يا سابق التقرير بالإقرارِ",6,"ر",1,0],["وزعفرانيةٍ في اللون تحسبها","إذا تأملتها في ثوب كافورِ",7,"ر",1,1],["وزعت يداه ما يحاذره","من دهرنا فأجادتا وزعه",8,"ع",2,0],["وزعمتَ سيدَنا الأمير سما","بالجود حتى صافح الهَقعه",8,"ع",2,0],["وزعمت صرتك اغتدت عطلاً","لا درهم فيها ولا قطعه",8,"ع",2,0],["وَزَعتَهُمُ حَتّى إِذا ما تَبَدَّدوا","سِراعاً وَلاحَت أَوجُهٌ وَكُشوحُ",9,"ح",1,0],["وَزَعَمنَ أَنّي قَد ذَهَلتُ عَنِ الصِبا","وَمَضى لِذَلِكَ أَعصُرٌ وَدُهورُ",10,"ر",1,0],["وَزَّعتُ نَفسي في النُفوسِ مَحبَّةً","لا شاكِياً أَلَما وَلا مُتَضَجِّرا",11,"ر",2,0],["وَزَعَمتَ أَنَّكَ زائِري","فَتَرَكتَ عَيني لِلطَريقِ",12,"ق",1,0],["وَزَعَمتِ أَنَّكِ حُرَّةٌ","ما هَذِهِ شِيَمُ الحَرائِر",13,"ر",1,0],["وزعيمٍ أجلَّهُ النَّاسُ حتَّى","ظنَّ في نفسِهِ إلهاً صغيرا",14,"ا",1,0],["وزعزع ركنَهُ بلوى زمانٍ","تحيَّف بدرَهُ قبلَ التمامِ",15,"م",1,0],["وَزَعزَعنَ دُنباوَندَ مِن كُلِّ وُجهَةٍ","وَكانَ وَقوراً مُطمَئِنَّ الجَوانِبِ",16,"ب",1,0],["وَزَّعتَهُم بَينَ الأَسِنَّةِ وَالظُبا","حَتّى أَبَدتَ جُموعَهُم تَوزيعا",17,"ع",2,0],["وَزَعَمتَ أَنَّكَ خَثعَمِيٌّ بَعدَما","عَرَفوا أَباكَ فَبَعضَ ذا الإِرجافِ",18,"ف",1,0],["وَزَعَمتِ أَنّي لَستُ أَصدُقُ في الَّذي","عِندي مِنَ البُرَحاءِ وَالأَشجانِ",19,"ن",1,0],["وَزَعَمتَ أَنَّكَ قَد رَضيتَ بِما بَنى","فَاِصبِر فَما لَكَ عَن أَبيكَ مُحَوَّلُ",20,"ل",1,0],["وَزَعَمتَ أَنّي ذاهِلٌ فَمَنِ الَّذي","يُدعى خَليفَةَ عُروَةٍ وَمُرَقِّشِ",21,"ش",1,0],["وَزَعَمتَ أَنَّكَ مُعطِبي وَمُسَلَّمٌ","مِنّي فَأَيري في حِرِ أُمِّ الكاذِبِ",22,"ب",1,0],["وَزَعوا الزَمانَ وَهُم كُهولٌ جِلَّةٌ","وَسَطَوا عَلى أَحداثِهِ أَحداثا",23,"ث",2,0],["وَزَعَمتِ أَنّي قَد ظَلَمتُكُمُ","كَلّا وَأَنتِ بَدَأتِ بِالظُلمِ",24,"م",1,0],["وَزَعَمتِ لي أَن لا يَحولُ فَإِنَّهُ","ساعٍ طَوالَ حَياتِهِ لي بِالرِضا",25,"ض",2,0],["وَزَعَمنَ أَنَّ وِصالَ عَبدَةَ عائِدٌ","عاراً عَلَيَّ وَلَيسَ ذَلِكَ عارا",26,"ر",2,0],["وزَعَمْنَاك ولم تَبْرقْ سناً","وكسوناك ولم تلمع برِيقا",27,"ق",2,0],["وزَعزعتْ كتائبُ السلطانِ","لكُلِّ ما فِيها منَ البُنْيانِ",28,"ن",1,0],["وزعمت أن لها معاداً ثانياً","ما كان أغناها عن الحالين",29,"ن",1,0],["وَزَعتُ رَعيلَها بِالرُمحِ شَذراً","عَلى رَبِذٍ كَسِرحانِ الظَلامِ",30,"م",1,0],["وزعت بين الدين والوطن الأسى","توزيعك الطاعات في الأطوار",31,"ر",1,0],["وزعمتم بأنّني كنت وحلا","آدميّا أما شريتم عصيره ؟",32,"ر",2,0],["وزعيمُ قومٍ كالغُراب به","صِغَرٌ وفي خُطُواتِه كِبْر",33,"ر",1,0],["وزعيمٌ شعَّ فيمنْ حولَه","قبسٌ منه فكانوا الزعماء",34,"ا",2,0],["وزعتُ رعيلها بالرمحِ شذراً","على ربدٍ كسرحان الظلام",35,"م",1,0],["وزعمت أَن هناك فتوى نصها","باسم الأحبة يندب التأذين",36,"ن",1,0],["وَزَعفٌ دِلاصٌ كَماءِ الغَديرِ","تَوارَثَهُ قَبلَهُ حِميَرُ",37,"ر",1,0],["وزعزعَ ركنُ الدينِ وانهّد سُورهُ","وعطّل آثارُ التقى والمصاحِفُ",38,"ف",1,0],["وزعمتُ حقّا أنّ بدرَ جَماله","زانت مطالعَه نجومُ خِصالهِ",39,"ل",2,0],["وَزَعتُ رَجائي عَن سِواكَ بِبَعضِها","وَلَولاكَ أَضحى في الوَرى مُتَوَزِّعا",40,"ع",2,0],["وَزَعتُ رَجائي عَن نَدى كُلِّ باخِلٍ","يُنَوِّلُ بِاليُسرى وَيَسلُبُ بِاليُمنا",41,"ن",2,0],["وزعزعت بالأعدا الصياصي ورعتهم","بسمر القنا والشر يدفع بالشر",42,"ر",1,0],["وزعمت أن لكل ما قالوا به","وجها يؤوله به من قد قرا",43,"ر",2,0],["وزعمت أن له اصطلاحا بينكم","أبدا به معنى وأخرى أخرا",43,"ر",2,0],["وزعمت أني كنت أرضى قتله","وسعيت لا وان ولا متواني",44,"ن",2,0],["وَزَعَمتِ أَهلَكِ يَمنَعُونَكِ رَغبَةً","عَنّى فَقَومِى بى أَضَنُّ وأَرغَبُ",45,"ب",1,0],["وَزَعَمتِ أَنِّى منكِ أَهلُ كَرَامةٍ","فَرَجَوتُهُ أملَ الحَيا في قابِلِ",46,"ل",1,0],["وزعَّمني صدفاً خاوياً","من الدرِّ مثل الذي صرَّفَه",47,"ف",2,0],["وزعتم ان أشواقا لكم","تملأ الأرضين سهلا وربا",48,"ب",2,0],["وزعفران وهي في المطاوعة","تزاد مطلقاً وفي المضارعة",49,"ه",1,0],["وزعمت ان الشح ابقى","لي من المنن الكثيره",50,"ر",2,0],["وزعمت ان الطيف يعقبه لقا","كالسحب تردف بالغيوث الهمع",51,"ع",1,0],["وزَعمنَ هزءاً أنهنَّ رَحَمنَهُم","ولهم جَعَلنَ من الخصورِ نصيبا",52,"ب",2,0],["وَزعمت أَنك في الهَوى مستنجد","صَبرا فَكانَ الصبر منك محالا",53,"ل",2,0],["وزعيمُ كندةَ لو رآها مرّةً","للوى لواءَ الشِّعر أو القاه",54,"ا",2,0],["وَزَعَمتِ أَهلكِ يَمنَعونَكِ رَغبَةً","عَنّي فَأَهلي بي أَضَنُّ وَأَرغَبُ",55,"ب",1,0],["وزعزعتْه رِياحُ الأريحيّةِ إذ","مَدَّ المُلمَّ إليه الكَفَّ مُجتديا",56,"ي",2,0],["وَزَعَمتَ أَنَّ الغَيظَ أَوقَدَ جَمرَهُ","أَفَلا صَبَرتَ عَسى يَصيرُ رَمادا",57,"د",2,0],["وزعمت أن الحق عندك ملغزٌ","بالحرف لما فيه سرك قد حصل",58,"ل",1,0],["وزعمت أني خلت عن","عهدي وأني جئت نُكْرا",59,"ر",2,0],["وزعيم القوم ما ري","ع وغالى الموت حمَّه",60,"م",2,0],["وَزَعَمْتَ طرفَك سِنَّ رُمْحٍ ذابلٍ","قُلْنَا صَدَقْتَ فأَيْنَ لِينُ الذَّابلِ",61,"ل",1,0],["وزّعتهم بين بيض الهند مصلتة","وبين سمر القنا والموت معتكر",62,"ر",1,0],["وزّع على الشعب آلافا له نهبت","قبل انتقام وشيك كامن فيه",63,"ي",2,0],["وزعمتا أن المغرّر عاثرٌ","تعِدُ العلا غيرَ الذيِ تعدانِ",64,"ن",1,0],["وزعمتِ أنَّكِ بالمحب رؤوفةٌ","والغدرُ يخبرُ أنَّ زعمكِ باطل",65,"ل",1,0],["وزعمتِ أن العهد باق ثابت","ونعمْ فأين لذاذةُ الإدراك",66,"ك",1,0],["وَزُعفِرَت عَصائِبُ الحَواذِنِ","وَلَوَّنتَ عَمائِمُ الرَيحانِ",67,"ن",1,0],["وزَّعتُه بين هجرٍ أو أليمِ هوًى","ما بين ساكبِ تَهماعٍ وتَهمالِ",68,"ل",1,0],["وزعمت أنك لا تكلمني","عشراً فمن لك أنني أبقى",69,"ق",2,0],["وزعيمُنا عبدُ العزِيز مثِيلُكُم","قاسَى مِرَار النفي والإبعَاد",70,"د",1,0],["وَزَعَمْتَ أَنَّكَ فِي الكِتَابَةِ مُدْرِكٌ","سَعْيِي وَقُلْتَ سِلاَحُنَا الأَقْلاَمُ",71,"م",1,1],["وزعموا بأنه إمام","وأن سفك دمه حرام",72,"م",1,0],["وزعموا أن بين البتول","كلهم في العلم كالرسول",72,"ل",1,0],["وزعموا بأنهم إذ علموا","إمامهم فإنهم لن يلزموا",72,"م",3,0],["وَزَعَمتُ أَنَّ العَهْدَ لَيْسَ بِضَائِعٍ","وَأَرى الصُّدُودَ لِضدِّ ذَاكَ دَلِيلا",73,"ل",2,0],["وَزَعيماً محنّكاً ورئيساً","كانَ في العرب بالزعامةِ أحرى",74,"ر",2,0],["وزعمتم أني صبور بعدكم","هيهات، لا لقيتم ما قلتم",75,"م",1,0],["وَزَعيم الخَوارج الشَهم سَعد ب","نُ جزاءٍ زلَّت بِهِ قَدَماه",76,"ا",2,0],["وَزَعيم العصاة أَقسم أَن لا","يَتَوانى عَن أَسره وَاِستباه",76,"ا",2,0],["وَزعمتُ أَني راحلٌ فتجهزت","يَوم الوَداع لرحلَتي أَفراسي",77,"س",2,0],["وَزِّعْ على الكومبارسِ أدواراً كما","شَاءَتْ عَصَاكَ ليُتقِنوا الأدوَارا",78,"ر",2,0],["وزعتهم بيد الصوارم والقنا","يا من أباد جموعهم بتوزّع",79,"ع",1,0],["وزعموا أن النجوم صانعة","وأنها ضائرة ونافعة",80,"ه",1,0],["وزعيم خواص سعادته","كالباز براحتهِ يرمي",81,"م",2,0],["وزعيم أبناء الزمان","ومن لخالقه وزر",82,"ر",1,0],["وزَعْفَرانِيَّةٍ في اللَّوْنِ والطّيبِ","طيِّبةِ الخَمْرِ دَكْناءِ الجَلابيبِ",83,"ب",1,1],["وَزَعَمتِ أَنَّكِ تُضمِرينَ لَنا","وُدّاً فَهَلّا يَنفَعُ الوُدُّ",84,"د",1,0],["وزعتها المشرفيات الحداد","والعوالي والعوادي والنبال",85,"ل"