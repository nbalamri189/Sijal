ابدات المال","https://www.poetsgate.com/ViewPoem.aspx?id=180112",""],[5815,"كَفَاكَ","https://www.poetsgate.com/ViewPoem.aspx?id=190008",""],[5818,"يحِبّك","https://www.poetsgate.com/ViewPoem.aspx?id=196562",""],[5848,"الفيصليه والمملكه والوليد بن طلال","https://www.poetsgate.com/ViewPoem.aspx?id=53171",""],[5853,"عيناكِ.. عيناكِ","https://www.poetsgate.com/ViewPoem.aspx?id=175688",""],[5899,"سابي","https://www.poetsgate.com/ViewPoem.aspx?id=31520",""],[5956,"إليك تفتحتْ ورداتُ حبٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=182073",""],[5956,"رشادٌ مستديم","https://www.poetsgate.com/ViewPoem.aspx?id=192321",""],[5956,"تشبيه بلا تشويه","https://www.poetsgate.com/ViewPoem.aspx?id=192411",""],[5956,"أحبك يا إلهي","https://www.poetsgate.com/ViewPoem.aspx?id=192500",""],[5956,"رؤى وإيهاب ونسلهما","https://www.poetsgate.com/ViewPoem.aspx?id=193108",""],[5956,"دعوتُ للإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=194884",""],[5956,"نجاحُ عملية حفيدي أرتين الجراحية","https://www.poetsgate.com/ViewPoem.aspx?id=202749",""],[5956,"رضيعٌ يزحف كسُلْحُفاةٍ حلوة","https://www.poetsgate.com/ViewPoem.aspx?id=205158",""],[5956,"سقطَ الجنينُ من بطنِ آنَ الحنون","https://www.poetsgate.com/ViewPoem.aspx?id=207114",""],[5956,"يحب الأقاربُ أبهَى حفيدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=210841",""],[5975,"وداعاً","https://www.poetsgate.com/ViewPoem.aspx?id=52976",""],[6078,"ياأيُّها المتعبون","https://www.poetsgate.com/ViewPoem.aspx?id=202779",""],[6093,"سُكَارَى","https://www.poetsgate.com/ViewPoem.aspx?id=204997",""],[6093,"تقصير لفظ","https://www.poetsgate.com/ViewPoem.aspx?id=206279",""],[6213,"دنان العشق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85492&r=&rc=95",""],[406,"مهرجان الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1119&r=&rc=63",""],[2696,"بَعْضُ القَوْلِ لَيْسَ لهُ عِيَاجٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27405&r=&rc=9",""],[572,"يا رُبَّ مُهْدٍ هَدِيَّة ً لَطُفَتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9443&r=&rc=300",""],[572,"الحمدُ للهِ قَدْ وَجَدْتُ أَخاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9238&r=&rc=95",""]],"verses":[["يَحبوكَ بِالزَعفِ الفَيوضِ عَلى","هَميانِها وَالدَهمِ كَالغَرسِ",0,"س",1,0],["يُحِبُّ دُنُوَّ الإِنسِ مِنهُ وَما بِهِ","إِلى أَحَدٍ يَوماً مِنَ الإِنسِ مَنزِلُ",1,"ل",1,0],["يحب أفراخ حمام له","ولا يني مفقتداً عجله",2,"ه",1,0],["يُحِبُّكِ حَتَّى أَنْتِ مَعْنَى حَيَاتِهِ","إِذَنْ هُوَ أَوْلَى أَنْ يُسَاءَ وَيُظْلَمَا",3,"م",2,0],["يُحبُّ الخميصَ البطن من أكلائه","ويُضحي ويُمسي بطنهُ بطنَ مقرِب",4,"ب",1,0],["يُحِبُّني المالِكُ وَالمَملوكُ","وَالسَيّدُ المُطاعُ وَالصُعلوكُ",5,"ك",1,0],["يُحِبُّ الغَواني البيضُ ظِلَّ لِواءَنا","إِذا ما أَتانا الصارِخُ المُتَلَهِّفُ",6,"ف",1,0],["يحبرها ذو قدرة بيراعه","ويسلكها المثلى ويجنبها الزورا",7,"ر",2,0],["يَحبِسُ اللَحنَ عَن غِنىً مُدِلٍّ","وَيُذيِقُ الفَقيرَ مِن مُختارِهِ",8,"ر",2,0],["يُحِبُّ المَرءُ نَبشَ أَخيهِ حَيّاً","وَيَنبُشُهُ وَلَو في الهالِكينا",9,"ن",2,0],["يُحِبُّ العاقِلونَ عَلى التَصافي","وَحُبُّ الجاهِلينَ عَلى الوَسامِ",10,"م",1,0],["يُحِبُّ البِلادَ وَهيَ شَرقٌ لِشَخصِهِ","وَيُذعَرُ مِنها وَهيَ مِن فَوقِهِ غَربُ",11,"ب",1,0],["يُحَبُّ أَن يَتَراءى مِن طَلاقَتِهِ","إِذا اللَئيمُ كَريمُ الوَجهِ قاطِبُهُ",12,"ب",2,0],["يُحَبِّبُهُ عِندَ الرَعِيَّةِ أَنَّهُ","يُدافِعُ عَن أَطرافِها وَيُحامي",13,"م",2,0],["يُحبى الأَتاوي مِن شُكرِنا مَلِكٌ","مَعقودَةٌ في رِقابِنا مِنَنُه",14,"ن",2,0],["يُحَبِّسُها جَنبَي سُفَيرٍ وَيَتَّقي","عَلَيها ضَغابيسَ الحِمى أَن تُعَقَّرا",15,"ر",2,0],["يُحِبُّ السَعيدُ العَدلَ عِندَ احتِجاجِهِ","وَيَبغي الشَقِيُّ البَغيَ وَالبَغيُ يَصرَعُ",16,"ع",1,0],["يُحِبُّنَا وَيُحَابِينَا وَيَرْحَمُنَا","وَيَمْنَحُ الأَضْعَفِينَ المَنْصِبَ الحَتِدَا",17,"د",2,0],["يحبسُ في الردةِ مَنْ","شاءَ بغير شاهدِ",18,"د",1,1],["يحبُّ من كلِّ علمٍ","السينَ والقافَ والطا",19,"ط",2,0],["يُحبُّونَهُ حُبَّ الذي ضلَّ رأيُهُ","فقاطِعُه مِنْهُمْ سَواءٌ وواصلُهْ",20,"ل",2,0],["يُحِبُّ حَياتَهُ وَيَزيدُ حِرصاً","فَيَلقى المَوتَ مِن خَوفٍ وَذُعرِ",21,"ر",1,0],["يُحبِّونَهُ حُبّاً تَلينُ قلوبُهم","بهِ وَهْوَ فيها مِثلُ إيمانِها صُلْبُ",22,"ب",1,0],["يَحبو المُطيعَ وَيُبيدُ العاصِيا","وَيَخضِبُ السُيوفَ وَالعَوالِيا",23,"ي",2,0],["يُحِبُّ النِكاحَ وَيَأبى الصَلاحَ","كَذاكَ النَباطِيُّ لا يَصلُحُ",24,"ح",1,0],["يُحِبُّ أَزواجَ مُنجابٍ وَيُكرِمُهُم","وَلا يُجاوِزُهُم باباً إِلى بابِ",25,"ب",1,0],["يُحَبِّبُ دُنيانا إِلَينا قَطينُها","فَمَن يَنَأَ عَنهُم يَسلُ عَنها وَيَسلَمِ",26,"م",1,0],["يحبو شعابَكِ في الضحى قبلاته","ويرفُّ أنفاساً بهن مساءَ",27,"ا",2,0],["يحبوكِ من صفوِ الزمانِ وأنسه","ما شئتِ من مَرحِ الحياةِ وشاءَ",27,"ا",2,0],["يحبه الأقوام منذ كانا","ولا يساوون به مكانا",28,"ن",2,0],["يُحَبُّ دَماثةً ويُهاب خوفاً","كغَمْرِ السيلِ خيف وطاب وِرْدا",29,"د",2,0],["يحبها المرء على آفاتها","وتظهر الآفة عند المنتهى",30,"ا",1,0],["يحبّ لذات البذل ، بالقلب كلّه","يحبّ ولا يدري ، ولا غيره درى",31,"ر",2,0],["يحبو على أهدابها ، موعد","طفل ، ويسترخي عليه الخمول",32,"ل",1,0],["يحب أزواج منجابٍ ويكرمهم","ولا يجازوهم باباً إلى باب",33,"ب",1,0],["يُحبُّ \" السلامةَ \" مشفوعةً","بدَعوى \" الجْبانِ \" بحُبِّ الوَغى",34,"ا",1,0],["يَحْبِسُ العينَ لانتشار الدياجي","في السَّما منظرٌ لطيفٌ مَهيب",35,"ب",1,0],["يُحِبُّ أنْ يَترَاءى مِنْ طَلاقتِهِ،","إذا اللَئِيمٌ كَرِيهُ الوَجْهِ، قاطِبُهُ",36,"ب",2,0],["يحبّ قلبي خباياه ويعبدها","إذا تبرّأ قلب من خباياه",37,"ا",2,1],["يحب النّاظرون في الأفق منه","حمرة الورس أو مزيج السّلاف",38,"ف",1,0],["يحبُوكَ بالزَّغفِ الفيُوضِ على","هِميانِهَا والدُّهمِ كالغَرسِ",39,"س",1,0],["يحب الذي يبنى من المجد دهره","وليس الذي يبني كمن هو أهدما",40,"م",2,0],["يحب الفتى منا البقاء وما درى","بأن الذي يهوى البقا بالبقا يفنا",41,"ن",2,0],["يحبك فيها كل من ليس جائرا","ويخشاك فيها كل صاحب فتنة",42,"ه",1,0],["يحب المعالي والمعالي تحبه","فكل قد استولى عليه غرام",43,"م",1,0],["يحب المعالي والمعالي تحبه","وبالحب منها ما ناله عفوا",44,"و",2,0],["يحبون فرعونا عدو إلهنا","فبئس محبوه وبئس المحبب",45,"ب",1,0],["يُحِبُّكُم كُلُّ مَن صَحَّت عَقِيدَتُهُ","حَتماً وَيُبغضُ مَن فِي قَلبِهِ مَرَضُ",46,"ض",1,0],["يُحب الفتى أوطانه وبها العِدا","فكيف بأحبابٍ علىَّ كِرام",47,"م",1,0],["يحبّب نفسه ويريك ودّا","ويضمر ضدّ ذلك ما استطاعا",48,"ع",2,0],["يحبّ الصغير لإقباله","ويقصى الكبير لإدباره",49,"ر",2,0],["يحبّ الفتى المال الجزيل وإنما","لنفس الفتى ممّا حواه نصيبُ",50,"ب",1,0],["يحب ضعيف الروح في الخلد أنسَهُ","إلى غادةٍ مأمونة الغيب بلهاء",51,"ا",2,0],["يُحب كفاحَ الدارعين لأنَّه","تُصاغ له منه العُلا والمحامدُ",52,"د",1,0],["يحبك إي وجمال الغضب","يحبك إي والهوى الملتهب !",53,"ب",1,0],["يُحِبُّ إدامَته الآكلون","ويُصبي بلَذَّتِهِ الأَلْسُنا",54,"ن",2,0],["يُحَبَّب لي فيك الغرامُ فلم أكد","أشبِّهه إلا بحسنك في شعري",55,"ر",2,0],["يُحب الراحَ رائِحَةً بِكأسٍ","وَيَهوى الكأس كاسيَة بِراحِ",56,"ح",1,0],["يُحبِّبها حبُّ الذين تحمّلوا","ومنهم عليها ذمّةٌ ووفاء",57,"ا",2,0],["يُحبّر كُتْباً أو يَجُرُّ كتائِبا","وحَسبُك بالحِبْر المغامر في الحَرْبِ",58,"ب",1,0],["يُحَبَّبُ لِي مِنْ أَجْلِهِ كُلُّ ضَيْغَمٍ","هَصُورٍ وَتُصْبينِي إِلى قُرْبِها الأُسْدُ",59,"د",1,0],["يحبُّ المَرءُ أن يَلقى نَعيماً","ويأبى اللَهُ إلا ما يَشاءُ",60,"ا",2,0],["يحبُّ جَهلاً فعلَه","وأن تكونَ مثلَه",61,"ه",1,0],["يحبو وَينمو وما ينفكُ مطرداً","بغرّةٍ ذات لألآءٍ وَأوضاح",62,"ح",1,0],["يُحِبُّ الفَتى طولَ البَقاءِ وَإِنَّهُ","عَلى ثِقَةٍ أَنَّ البَقاءَ فَناءُ",63,"ا",2,1],["يَحْبو ويَقْرأ أنه يَجنْى فَعن","دَ حِبائه يتَغْشاهُ فَضْلُ حيَائه",64,"ا",3,0],["يُحِبُّكَ الناسُ إِن أَمسَكتَ عَن طَلَبِ","وَاللَهُ يَمقُتُ إِن أَمسَكتَ عَن طَلَبِ",65,"ب",1,0],["يُحبُّ العَطايا كحبِّ العُلى","وكلٌّ بَغيضٌ إِلى الباخِلِ",66,"ل",1,0],["يحبوه مولاه بخير جزائه","عما سعى في عمره المتقدم",67,"م",1,0],["يحبُّها المُخلِصُ الشِيعِيُّ ان رُوِيَت","كَحُبِّ يَعقوب لِلزاكي بنَ يامينا",68,"ن",2,0],["يحبُ الماء ذو ظمأٍ ليروي","ويكره لجة الماء الغريق",69,"ق",1,0],["يحب لكم أن تبلغوا كل رتبة","وأن ترتقوا فوق السها والنعائم",70,"م",1,0],["يحبب لي المقابر قبر أمي","فأمزج عندها دمعاً بدمي",71,"ي",1,0],["يحبّ الحيا للحلم والزادَ للقِرى","وكسبَ العلا للخلد والمالَ للفنا",72,"ن",2,0],["يُحبَى بها يقظانُ منكم حاضرٌ","وغائبٌ عن البلاد حالمُ",73,"م",1,0],["يُحَبُّ وهو فتنةٌ","ربَّ حبيبٍ ق