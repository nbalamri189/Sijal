{"poems":[[72,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[91,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16626","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42495","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55046","البسيط"],[106,"الطبيب الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=179681",""],[113,"يا سائق الجمال","https://www.aldiwan.net/poem40600.html","عموديه"],[140,"ماذا يعيب رجال الحى في النادي","https://www.aldiwan.net/poem58426.html","البسيط"],[183,"حكم العيون على القلوب يجوز","https://www.aldiwan.net/poem14549.html","الكامل"],[221,"لا لقوم ولا لدين","https://www.aldiwan.net/poem39694.html","مجزوء الخفيف"],[237,"بمحمد صلوا عليه وسلموا","https://www.aldiwan.net/poem23835.html","الكامل"],[268,"سل الشواطئ ما أبقين من جسدي","https://www.aldiwan.net/poem35626.html","البسيط"],[268,"تعال نفرح فالشتاء هربا","https://www.aldiwan.net/poem35675.html","الرجز"],[303,"رسل البشائر ورد وصدور","https://www.aldiwan.net/poem56545.html","الخفيف"],[346,"للطواشي الرشيد بركة ماء","https://www.aldiwan.net/poem20094.html","الخفيف"],[362,"للطيف بحر بكاي ينفرق","https://www.aldiwan.net/poem60833.html","أحذ الكامل"],[369,"ما بين أجفاني ملاحم","https://www.aldiwan.net/poem57111.html","مجزوء الكامل"],[456,"دل عى الخير وأنبائه","https://www.aldiwan.net/poem56160.html","السريع"],[512,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[584,"نمت بما تحنو عليه ضلوعه","https://www.aldiwan.net/poem17586.html","الكامل"]],"verses":[["للطيرِ في مياههِ مواقع","كأنَّها من فوقه فواقع",0,"ع",1,0],["لِلطَيرِ هائِمَةً بِهِ مَفتونَةً","لا لِلَّذين يُرَوِّعونَ طُيورَهُ",1,"ه",1,0],["للطِّيب في حِنْدِسِها سوْرَةٌ","مَنَاخِرُ البَدرِ به تُفْعَمُ",2,"م",1,0],["لِلطَّيْرِ في أَيْكِها هَدِيلٌ","وَلِلصَّبا بَيْنَها مُكَاءُ",3,"ا",2,0],["لِلْطُّبِّ فِيهِ مُعِدَّاتٌ وَأَجْهِزَةٌ","صِيغَتْ وَصَيَّرَهَا إِتْقَانُهَا تحَفَا",4,"ف",2,0],["للطِّبِّ كنتَ، وللقريض، وللنَّدى","يا كوكبًا متعدد الآفاق",5,"ق",1,0],["للطفه سكارى","مرقرق الجريال",6,"ل",1,0],["للطارقِ الحكمُ في أعناقِ هَجمِته","ولو تقراَّه ذئبُ الرَّدهةِ العادي",7,"د",2,0],["للطيرِ فيها بالغصونِ تَصارُخٌ","وتَصايُحٌ وتفَاصحٌ ورموز",8,"ز",1,0],["لِلطُغاةِ المُهَدَّمين","لِلبُناةِ المُشَيَّدين",9,"ن",1,0],["للطيبات محلل يدعو إلى ال","قصد الوسيط وللخبيث محرم",10,"م",1,0],["للطيرِ حَبٌّ وأوكارٌ وأفرخةٌ","أليسَ للمرءِ ما للطائر الغرد",11,"د",1,0],["للطيرِ ترنيمٌ يهيجُ الطربا","والزَّهرُ ينمو في المروج والربى",12,"ب",2,0],["لِلطَيرِ فَوقَ مَنابِرِ اِبنِ مَعينِها","مِن آلِ داوودَ اِعتَرى مَزمورُ",13,"ر",1,0],["لِلطَّواشي الرَّشِيدِ بِرْكَةُ مَاءٍ","زيّنتْها دَساتِرٌ كالهّوُدِ",14,"د",1,1],["للطَّيفِ بَحرُ بُكايَ يَنْفَرِقُ","وإذا تقحّمَ عُذَّلي غَرِقوا",15,"ق",3,1],["لَلطَّيفُ أعشقُ منك إذ","يَسري إليكَ وأنتَ نائِم",16,"م",1,0],["للطالبين الوِترَ عوناً إذا","ثاروا ومأخوذ بلا وِترِ",17,"ر",1,0],["للطّالبينَ كُنوزٌ في أنامِلها","وللزّمانِ عُقودٌ من سجاياها",18,"ا",3,0],["لِلطَّرْفِ فيهِ سَناً وَفيهِ بَارِقٌ","هَذا وذَاكَ يَرُوقُهُ وَيَروعُهُ",19,"ع",2,0]]}