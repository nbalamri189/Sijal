{"poems":[[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[93,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16626","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42495","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55046","البسيط"],[108,"الطبيب الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=179681",""],[119,"يا سائق الجمال","https://www.aldiwan.net/poem40600.html","عموديه"],[146,"ماذا يعيب رجال الحى في النادي","https://www.aldiwan.net/poem58426.html","البسيط"],[189,"حكم العيون على القلوب يجوز","https://www.aldiwan.net/poem14549.html","الكامل"],[228,"لا لقوم ولا لدين","https://www.aldiwan.net/poem39694.html","مجزوء الخفيف"],[244,"بمحمد صلوا عليه وسلموا","https://www.aldiwan.net/poem23835.html","الكامل"],[275,"سل الشواطئ ما أبقين من جسدي","https://www.aldiwan.net/poem35626.html","البسيط"],[275,"تعال نفرح فالشتاء هربا","https://www.aldiwan.net/poem35675.html","الرجز"],[310,"رسل البشائر ورد وصدور","https://www.aldiwan.net/poem56545.html","الخفيف"],[353,"للطواشي الرشيد بركة ماء","https://www.aldiwan.net/poem20094.html","الخفيف"],[369,"للطيف بحر بكاي ينفرق","https://www.aldiwan.net/poem60833.html","أحذ الكامل"],[376,"ما بين أجفاني ملاحم","https://www.aldiwan.net/poem57111.html","مجزوء الكامل"],[463,"دل عى الخير وأنبائه","https://www.aldiwan.net/poem56160.html","السريع"],[519,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[591,"نمت بما تحنو عليه ضلوعه","https://www.aldiwan.net/poem17586.html","الكامل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39220","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64295","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64122","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63998","الكامل"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/74009","السريع"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87867","البسيط"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46743","الكامل"],[2852,"","https://poetry.dctabudhabi.ae/diwan/poem/142919","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100293","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199932","الكامل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112562","البسيط"],[3100,"","https://poetry.dctabudhabi.ae/diwan/poem/124293","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88890","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205589","السريع"],[4166,"","https://poetry.dctabudhabi.ae/diwan/poem/203266","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136473",""],[4788,"خلاص جزنا من المحبه وتبنا","https://www.poetsgate.com/ViewPoem.aspx?id=132246",""],[4791,"للطير طبع","https://www.poetsgate.com/ViewPoem.aspx?id=37109",""],[4916,"بقايا انسانه","https://www.poetsgate.com/ViewPoem.aspx?id=152166",""],[5064,"ثقة الهوينى","https://www.poetsgate.com/ViewPoem.aspx?id=199155",""],[5151,"سكب الزُلالُ بثغرها فِنجانا","https://www.poetsgate.com/ViewPoem.aspx?id=186002",""],[5324,"يازائرا قبر الحسين.","https://www.poetsgate.com/ViewPoem.aspx?id=210987",""],[5461,"كلٍ يعوّد لاصل جدّه ومرباه","https://www.poetsgate.com/ViewPoem.aspx?id=5307",""],[5464,"فضح الهوى سري","https://www.poetsgate.com/ViewPoem.aspx?id=698",""],[5732,"فات الشباب ولا بقى فيه لذات","https://www.poetsgate.com/ViewPoem.aspx?id=177834",""],[5848,"أي دمعة حزن","https://www.poetsgate.com/ViewPoem.aspx?id=51960",""],[5851,"ظنون","https://www.poetsgate.com/ViewPoem.aspx?id=175301",""],[5952,"يا ذا الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=210795",""],[5956,"طيف محمد يزورني في عملي","https://www.poetsgate.com/ViewPoem.aspx?id=192370",""],[5957,"للطفل الغارق في حلمه","https://www.poetsgate.com/ViewPoem.aspx?id=181646",""],[6082,"الطفل","https://www.poetsgate.com/ViewPoem.aspx?id=58947",""]],"verses":[["للطيرِ في مياههِ مواقع","كأنَّها من فوقه فواقع",0,"ع",1,0],["لِلطَيرِ هائِمَةً بِهِ مَفتونَةً","لا لِلَّذين يُرَوِّعونَ طُيورَهُ",1,"ه",1,0],["للطِّيب في حِنْدِسِها سوْرَةٌ","مَنَاخِرُ البَدرِ به تُفْعَمُ",2,"م",1,0],["لِلطَّيْرِ في أَيْكِها هَدِيلٌ","وَلِلصَّبا بَيْنَها مُكَاءُ",3,"ا",2,0],["لِلْطُّبِّ فِيهِ مُعِدَّاتٌ وَأَجْهِزَةٌ","صِيغَتْ وَصَيَّرَهَا إِتْقَانُهَا تحَفَا",4,"ف",2,0],["للطِّبِّ كنتَ، وللقريض، وللنَّدى","يا كوكبًا متعدد الآفاق",5,"ق",1,0],["للطفه سكارى","مرقرق الجريال",6,"ل",1,0],["للطارقِ الحكمُ في أعناقِ هَجمِته","ولو تقراَّه ذئبُ الرَّدهةِ العادي",7,"د",2,0],["للطيرِ فيها بالغصونِ تَصارُخٌ","وتَصايُحٌ وتفَاصحٌ ورموز",8,"ز",1,0],["لِلطُغاةِ المُهَدَّمين","لِلبُناةِ المُشَيَّدين",9,"ن",1,0],["للطيبات محلل يدعو إلى ال","قصد الوسيط وللخبيث محرم",10,"م",1,0],["للطيرِ حَبٌّ وأوكارٌ وأفرخةٌ","أليسَ للمرءِ ما للطائر الغرد",11,"د",1,0],["للطيرِ ترنيمٌ يهيجُ الطربا","والزَّهرُ ينمو في المروج والربى",12,"ب",2,0],["لِلطَيرِ فَوقَ مَنابِرِ اِبنِ مَعينِها","مِن آلِ داوودَ اِعتَرى مَزمورُ",13,"ر",1,0],["لِلطَّواشي الرَّشِيدِ بِرْكَةُ مَاءٍ","زيّنتْها دَساتِرٌ كالهّوُدِ",14,"د",1,1],["للطَّيفِ بَحرُ بُكايَ يَنْفَرِقُ","وإذا تقحّمَ عُذَّلي غَرِقوا",15,"ق",3,1],["لَلطَّيفُ أعشقُ منك إذ","يَسري إليكَ وأنتَ نائِم",16,"م",1,0],["للطالبين الوِترَ عوناً إذا","ثاروا ومأخوذ بلا وِترِ",17,"ر",1,0],["للطّالبينَ كُنوزٌ في أنامِلها","وللزّمانِ عُقودٌ من سجاياها",18,"ا",3,0],["لِلطَّرْفِ فيهِ سَناً وَفيهِ بَارِقٌ","هَذا وذَاكَ يَرُوقُهُ وَيَروعُهُ",19,"ع",2,0],["للطَّيْرِ فيهِ مع الأنين تَراجُعٌ","يُنْبيكَ كَيْفَ تفتُّتُ الأكبادِ",20,"د",1,0],["لِلطُّلَى تحتَ قَسْطَلِ الحَرْبِ ضَرّا","باً ولِلهامِ في الوَغَى شَدّاخا",21,"خ",2,0],["للطافٍ آذانها والخراطي","مُ حدادِ لأظفاء والأنياب",22,"ب",1,0],["للطيرِ فيه صنوفُ أصواتِ فذا","يدعو وذا يحدو وهذا يَسْجَع",23,"ع",1,0],["للطرف من تذكاره عبرةٌ","والقلبِ شوقٌ أرقَ المستهام",24,"م",1,0],["للطعةٍ شقَّ ظرفاً بئس فعلتُهُ","الانس انسٌ بعشقٍ لا يخامرُهُ",25,"ه",1,0],["لِلطَّيرِ مِنها وَالسِّباعِ ذَخيرَةٌ","في كُلِّ مُعتَركٍ لَها وَمَجالِ",26,"ل",1,0],["للطير في الليل أوكار تعود لها","فأين يا ليل في دنياك أوكاري",27,"ر",2,0],["للطوق أذهب لا التي","ذهباً تصاغ لها الأساور",28,"ر",1,0],["للطير أسمع جوقة لكن بها","أنت المعلم رغم كل مكابر",29,"ر",1,0],["للطار والطبل دقات منغمة","كالقلب في شغف تسبيه حسناء",30,"ا",2,0],["للطائعين دواء للبغاء دوى","للمظلمين ضياء في دجى الظلَل",31,"ل",1,0],["للطرف مطلع بدر الحسن قال رُمِ","حتى استهل وقلبي بالغرام رُمِي",32,"م",2,1],["للطفل، من للطفل في ضعفه","للشيخ، من للشيخ حاني الجبينْ",33,"ن",1,0],["للطعن والضرب أرداف تحل به","في موضع العقل تحكيه ذوو الحكم",34,"م",1,0],["للطير خلفَ لوائه عدوٌ كما","تعدو فوارسُه بيوم زُحام",35,"م",1,0],["للطيب باب وللكرامات مبنا","وفرخ الصقر ماتنتجه بيضة غراب",36,"ب",1,0],["للطير طبع وللأوادم عوايد","وكلٍ على طبعه له الباب مفتوح",37,"ح",1,0],["للطيب طاري وللردى كم طاري؟","كلآ يعود لاصله وجدانه",38,"ن",2,0],["للطَّريقِ الكَذُوبِ وَعدٌ أجِيرٌ","زخرَفُتهُ الظُّنونُ لمَّا أتَينَا",39,"ن",2,1],["للطول بين الخَيْزُرانِ شَقائق ٌ","دُعيت بنصبِ قتيلها النُعْمانا",40,"ن",2,0],["للطّف في كلّ المفاوز مشهد","لابيت من جور المصائب قد خلا",41,"ل",2,0],["للطّير يالصقّار بالرّيش مغواه","الجاهل الّلي باكثر الريش مفتون",42,"ن",1,0],["للطين وهو دمى طفولتنا","ليت «السماوة» تتقن الهربا",43,"ب",2,0],["للطيب حط بهامة المجد رايات","فيها مضيعة البصاير يدلون",44,"ن",1,0],["للطعون اللي تمادت في طعوني","يوم شفت الضيق ف احضانه رماني",45,"ن",2,0],["للطين أسرار تأجل وجهها","حتى يعود لنخله الزيتونُ",46,"ن",1,0],["للطير (كورالٌ) وللناس انتشا","من صوتِ (فيروزٍ) وشعر (نزار)",47,"ر",1,0],["للطيفِ طبع الظل في تَبِعاتهِ","مهما سناهُ ناصعٌ ميمونُ",48,"ن",1,0],["للطفل الغارق في حلمه","أحلامٌ تُنقشُ من وهمه",49,"م",2,1],["للطفل ملامحُ سحرية","وامور تبدو عفْوية",50,"ي",2,1]]}