["يَتَلَقَّى الخُطُوبَ غَيْرَ أَبِيٍّ","وَعَلَى نَفْسِهِ يَكَادُ يَهُونُ",4,"ن",1,0],["يَتَلَقَّاهَا بِرِفْقٍ صَدْرُهُ","وَيُحَيِّي عَنْ شِمَالٍ وَيَمِينْ",5,"ن",1,0],["يَتَلَقَّى الأَحْدَاثَ عُسْراً وَيُسْراً","وَعَلَى الثَّغْرِ مِنْهُ وَشْكُ ابْتِسَامِ",6,"م",1,0],["يتلو بصَرف الحادثا","ت لنا فصولاً من كتابه",7,"ب",2,0],["يَتَلاوَمونَ وَقَد أَباحَ حَريمَهُم","قَينٌ أَحَلَّهُمُ بِدارِ بَوارِ",8,"ر",1,0],["يَتلو عَلَينا النورَ فيها مُحكَماً","قِسماً لَعَمرُكَ لَيسَ كَالأَقسامِ",9,"م",1,0],["يتلقّاهُمُ بسيفٍ من الفك","رِ ورمح من صَنعة الآراءِ",10,"ا",2,0],["يتلقَّى المُدفَّعينَ عن الأب","واب بالبشر منه والترحيبِ",11,"ب",1,0],["يتلقَّى مسائلَ الناس منهُ","عَرَضٌ سالمٌ وعِرْضٌ مُصابُ",12,"ب",1,0],["يتلقاك في الغلائل منها","وجه شمسٍ وجسم دميةِ عاجِ",13,"ج",1,0],["يتلظَّى بين وَصْلَيْ شاعرٍ","لُدُّ قَوْل الشعر والشعر لَدودُ",14,"د",1,0],["يَتلاومون وينشدو","ن من الهوادةِ ما أضلّوا",15,"ل",3,0],["يتلظَّوْن حدةً وذكاءً","كتلظّي ثوائر الأصلالِ",16,"ل",1,0],["يتلقَّى فيَّ ما يأذَى به","وأُكافيه بأنواع الظِّنَنْ",17,"ن",1,0],["يتلقّاهمُ بقولٍ حَفيٍّ","مرحباً مرحباً بكم رُكبانا",18,"ن",2,0],["يَتَلَظّى الخالُ في وَجَنَتِهِ","أَرَأَيتُم كَيفَ يُصلى المُغرَمُ",19,"م",1,0],["يَتَلَمَّسونَ مِنَ المَنِيَّةِ مَهرَباً","هَيهاتَ إِنَّ المَوتَ كُلَّ مَكانِ",20,"ن",1,0],["يتلاشى فَوْقَ الخضَمِّ ويبقى ال","يَمُّ كالعهدِ مُزْبدُ الأَمواهِ",21,"ه",1,0],["يتلو في الغابِ مَرَاثيهِ","وجُذُوعُ السَّرْوِ تُسانِدُهُ",22,"د",2,0],["يتلو على سَمْعي","أَغاريدَ الحَيَاةِ الطَّاهرَهْ",23,"ه",1,0],["يَتْلو أَقاصيصَ التَّعاسَةِ والأَسى","ويُصِيرُ أَفراحَ الحَيَاةِ هُمُوما",24,"م",2,0],["يَتلو الرِجالُ عَلَيهُمُ شَهَواتِهِم","فَالناجِحونَ أَلَدُّهُم تَرتيلا",25,"ل",2,0],["يَتَلاشى نَزَواتٍ في حُرَق","كَذُبالٍ آخِرَ اللَيلِ اِستَعَر",26,"ر",1,0],["يَتَلَفَّتونَ مُوَدِّعينَ دِيارَهُم","وَاللَحظُ ماءٌ وَالدِيارُ ضِرامُ",27,"م",1,0],["يَتَلَبَّسُ الحُلُمُ اللَذي","ذُ عَلَيهِ بِالحُلُمِ الأَثيمِ",28,"م",1,0],["يَتلو الزَمانُ صَحيفَةً","غَرّا مُذَهَّبَةَ السُطور",29,"ر",1,0],["يَتَلَوَّنُ الخِرّيتُ مِن خَوفِ 