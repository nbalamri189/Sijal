ml","السريع"],[401,"رجوتك يا حبيب","https://www.aldiwan.net/poem6720.html","عموديه"],[401,"أنا وريشتي","https://www.aldiwan.net/poem6732.html","عموديه"],[403,"ملك به عز الشريعة مظهر","https://www.aldiwan.net/poem46933.html","الكامل"],[404,"ألم بجسمي عارض طال مكثه","https://www.aldiwan.net/poem33451.html","الطويل"],[404,"أحقا جرى ما يسبل العبرات","https://www.aldiwan.net/poem34106.html","الطويل"],[430,"من الصبابة تثني القد نيروز","https://www.aldiwan.net/poem40501.html","البسيط"],[430,"جرى الصفاء بفوار الهنا العذب","https://www.aldiwan.net/poem40791.html","البسيط"],[440,"عزم حداه السعد والإقبال","https://www.aldiwan.net/poem34802.html","الكامل"],[440,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[440,"محلك بالدنيا وبالدين آهل","https://www.aldiwan.net/poem34914.html","الطويل"],[442,"سعدي ونحسي بأحكام القضا سبقا","https://www.aldiwan.net/poem14290.html","البسيط"],[442,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[444,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[453,"ثلاثين قاض عد من بعد أربع","https://www.aldiwan.net/poem13645.html","الطويل"],[459,"نقيل مع الدنيا وقد أورقت لنا","https://www.aldiwan.net/poem55852.html","الطويل"],[459,"وجد الجميم فعافه وتبقلا","https://www.aldiwan.net/poem55960.html","الكامل"],[459,"دعوها ترد بعد خمس شروعا","https://www.aldiwan.net/poem56122.html","المتقارب"],[459,"أغش بآمالي كأني أنصح","https://www.aldiwan.net/poem56254.html","البسيط"],[462,"سل الحي عني هل أناخت خسيفة","https://www.aldiwan.net/poem15293.html","الطويل"],[462,"وصوب حيا جاشت غوارب سيبه","https://www.aldiwan.net/poem16396.html","الطويل"],[464,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[465,"أعيا وقد عاينتم الآية العظمى","https://www.aldiwan.net/poem3135.html","عموديه"],[466,"يا صبر أيوب","https://www.aldiwan.net/poem36227.html","عموديه"],[469,"يا من له سيف لحظ","https://www.aldiwan.net/poem60289.html","المجتث"],[469,"وقائل ما الملك قلت الغنى","https://www.aldiwan.net/poem60484.html","السريع"],[480,"على ضفة الوادي بقتة شاهق","https://www.aldiwan.net/poem37574.html","الطويل"],[480,"أناديها وما لي لا أنادي","https://www.aldiwan.net/poem37581.html","الوافر"],[506,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[516,"لو اطلعت على سري وإضماري","https://www.aldiwan.net/poem12126.html","البسيط"],[552,"كم ذا نخيب وتكذب الأطماع","https://www.aldiwan.net/poem47724.html","الكامل"],[552,"أمنك الشوق أرقني فهاجا","https://www.aldiwan.net/poem47908.html","الوافر"],[552,"لم يبق لي بعد المشيب تصابي","https://www.aldiwan.net/poem48055.html","الكامل"],[559,"طريقتنا قل بأقوالها","https://www.aldiwan.net/poem33500.html","المتقارب"],[559,"لذاتي بذاتي لا لكم أنا ظاهر","https://www.aldiwan.net/poem34556.html","الطويل"],[568,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[576,"نعم هذه دار النعيم المعجل","https://www.aldiwan.net/poem2735.html","الطويل"],[577,"ألك السدير وبارق","https://www.aldiwan.net/poem1782.html","مجزوء الكامل"]],"verses":[["وَصَولاتٍ أَمَرَّ مِنَ المَنايا","عَلى بَشَرٍ أَلَذَّ مِنَ المُدامِ",0,"م",1,0],["وَصَوَّحَ النَبتُ حَتّى كادَ مِن سَغَبٍ","فيهِم يُصَوِّحُ نَبتُ الهامِ وَاللَمَمِ",1,"م",1,0],["وَصوني عَنِ السُكرِ مَن لا يَزالُ","يُنَدّي المُدامَ بِماءِ القَراحِ",2,"ح",1,0],["وصَوارِمٍ عُرِّينَ منْ أغْمادِها","حتى ارْتَدَيْنَ منَ الطُّلى بغُمودِ",3,"د",1,0],["وصَوارِمٌ مَشْحوذَةٌ وأسِنَّةٌ","مَذروبَةٌ وكَتيبَةٌ جَأواءُ",4,"ا",2,0],["وَصولٌ الى الغاياتِ يُرْجَى ويُتّقى","كريمُ السّجايا لمْ يشُبْهُ التّكلّفُ",5,"ف",1,0],["وَصُوِّرُ النُّجُبُ الأَحْرَارُ فِي مُثُلٍ","صِيغَتْ قَبْلَهُ الأَتْبَاعُ وَالْحَشَمُ",6,"م",1,0],["وَصَوَّحَ الَبقلَ نَأّاجٌ تَجيءُ بِهِ","هَيفٌ يَمانِيَةٌ في مَرِّها نَكَبُ",7,"ب",1,0],["وصوَّرَ فكره للبين ركباً","فبادرَ جفن عينيه المزاده",8,"د",2,0],["وصولات قوم بالكثيرِ تقسَّمت","لديكم وما لي وصول",9,"ل",1,0],["وصَوْني عن التهجين عُرفَك موجِبٌ","مَزيدَك لي في الرفد يا ابن المَرازِبِ",10,"ب",1,0],["وَصولُ الخُطى بالسيف والسيف بالخطى","إذا الطعن حُشَّتْ نارهُ بالسوافلِ",11,"ل",1,0],["وَصَوَّروا المَجدَ وَلَألائِهِ","عَسى يُفيقُ الهاجِعُ الغافِلُ",12,"ل",1,0],["وَصَوارِماً قَد أُغمِدَت يَومَ الوَغى","شُهِرَت عَلى الأَضيافِ وَالقُطّانِ",13,"ن",1,0],["وصوتك عذب على كل سمع","ووجهك في كل عين جميل",14,"ل",1,0],["وَصولٌ إِلى المُستَصعَباتِ بِخَيلِهِ","فَلَو كانَ قَرنُ الشَمسِ ماءً لَأَورَدا",15,"د",2,0],["وصونوهما من كل شيء وأحكموا","له من زجاج ناصع اللون معدنا",16,"ن",2,0],["وصَوَّبَ الإبريقُ في ال","كاسِ مُداماً عَنْدَما",17,"م",2,0],["وصَوبُ يَدَيكَ ما جَرَتَا حياةٌ","تَعُمُّ بها البَرِيَّةَ أو حِمامُ",18,"م",1,0],["وصَوارمٍ خُضْرٍ مَضارِبُها","تَكْسو الرِّجالَ عَمائماً حُمْرا",19,"ر",2,0],["وَصولٌ عَبوسٌ قاطِعٌ مُتَبَسِّمٌ","يُخافُ وَيُرجى عِندَهُ الحَتفُ وَالجَدوى",20,"و",2,0],["وَصَوارِمٍ حَمَتِ البِلادَ حُدودُها","وَأَرَتكَ في حَدِّ الزَمانِ فُلولا",21,"ل",2,0],["وصورةٌ أعجزت في الوصفِ شاعرَهَا","وتاهَ في وصفها شارد ورَسَّامُ",22,"م",1,0],["وصورة القيد في المعَاصم","ووصمةَ الذل في الجباه",23,"ه",1,0],["وصَوَارمُ للأقدارِ فلا","تقفُ الكفّارُ لها جُنَنَا",24,"ن",2,0],["وَصُولوا ببيضٍ في العَجاج كأنّها","بُرُوقٌ بضربِ الهام محمَرّةُ السّجْمِ",25,"م",1,0],["وصواهلٍ مثل العواسل عَدْوُهَا","أبداً لحربِ عدوّك المحروبِ",26,"ب",1,0],["وصَوْنَاً لمجدِكَ مِنْ أَنْ يُذَال","بما أنتَ تأباهُ مِنْ مُبْدَعِ",27,"ع",1,0],["وَصُونوا الشَّعبَ عن أهواءِ قَومٍ","أضَاعوهُ بِمُنقَطعِ الرّجاءِ",28,"ا",2,0],["وَصواراً مِنَ النَواشِطَ عيراً","وَنَعاماً خَواضِباً وَحَميراً",29,"ر",2,0],["وَصَوتِ حَمامَةٍ سَجَعَت بِلَيلٍ","وَقَد حَنَّت إِلى إِلفٍ بَعيدِ",30,"د",1,1],["وَصَولَجانُ الصُدغِ مُستَمكِنٌ","لِلضَربِ مِن تُفّاحَةِ الخَدِّ",31,"د",1,0],["وصَوْمُنا في اتِّباعٍ","لهُ صِيامُ البَهائمْ",32,"م",1,0],["وصواهلٌ لا الهَضْبُ يومَ مَغارها","هَضْبٌ ولا البِيدُ الحُزون حُزون",33,"ن",1,0],["وصوّرَ اللَهُ آدماً فَصَبا","إلى الغواني وكُنّ من أمله",34,"ل",2,0],["وصورة مريم العُليا","وبالشلّاق في الصبح",35,"ح",1,0],["وَصَومي لَكِ عَنهُنَّ","وَلَولا أَنتِ ما صُمتُه",36,"ت",2,0],["وَصَوَّرَ لَيثَ الشُهبِ في مُستَقَرِّهِ","وَلَو شاءَ أَمسى فَوقَ غَبرائِهِ كَلبا",37,"ب",2,0],["وَصَومُهُ الشَهرَ ما لَم يَجنِ مَعصِيَةً","يُغنيهِ عَن صَومِهِ شَعبانَ أَو رَجَبا",38,"ب",2,0],["وَصوت المدافع بين الصفو","ف كالرعد في قصفه يهزم",39,"م",1,0],["وصوته ملء كل سمع","تهفو لإيقاعه القلوب",40,"ب",1,0],["وصوني الحسنَ من ثَورَ","ةِ هذا العاشق المُضنى",41,"ن",2,0],["وصوَّرتهُ مَلَكاً ناقماً","على آدميتهِ الجائره",42,"ه",1,0],["وصورةٌ مشرقةٌ سمحةٌ","إطارُها الحبُّ ونورُ اليقينْ",43,"ن",1,0],["وصوتٌ بأسرارِ الطبيعةِ ناطقٌ","ولكنه روحٌ وإبداعُ خاطرِ",44,"ر",1,0],["وصورة سمحةَ الإشراقِ ملهِمةً","أرقَّ من خَطراتِ الشاعر الغَزِلِ",45,"ل",1,0],["وصُوَيْحِباتُكِ بالفَلاةِ ثِيابُها","أوْبارُها وحُلِيّها الأرْواق",46,"ق",1,0],["وَصَوْتُهَا المَسْموعُ فِي مِصْرَ قَدْ","دَوَّى لَه فِي كُلِّ مِصْرٍ صَدَى",47,"د",2,0],["وَصَوَابٌ أَنَّ المَدِيحَ إِذَا مَا","جَاوَزَ الحَدَّ جَاوَرَ التَّجْرِيحا",48,"ح",2,0],["وَصَوَّرَ فِي إِشارَاتٍ","رَفِيفَ خَوَالِجِ الصَّدْرِ",49,"ر",1,0],["وَصُونُوا المُوَاطِنَ مِنْ عِلَّةٍ","إِذَا مَا تفَشَّتْ أَتَتْ بِالْعِبَرْ",50,"ر",1,0],["وَصُورٍ تَجْلُو بِهَامَا غَيَّبَتْ","أَيْدي البِلَى فَكُلُّ خَاف بَادِ",51,"د",1,0],["وصوارمٍ نَزَعَ الصَّيَاقِلُ غَلبَها","وَبِكلِّ أرْوَعَ ماجدِ الأَنْسَابِ",52,"ب",1,0],["وَصَوتِ فَتّانَةِ التَغريدِ ناظِرَةٍ","بِعَينِ ظَبيٍ تُريدُ النَومَ حَوراءِ",53,"ا",2,0],["وصَوّحتْ دوحتي ومالت","ولم يزل صادحاً غريدا",54,"د",2,0],["وصَوَّرَه عَضْباً تَفِرُّ لِهَوْلِهِ","ذِئابُ الدَّنَايا شُرَّداً وَهْو شَاهِرهْ",55,"ر",2,0],["وصوَّرُوهُ فَتىً أعْمَى إِذا رَشَقَتْ","يَدَاهُ بالنَّبْل أصْمَى كُلَّ جَبَّار",56,"ر",1,0],["وصولة حازم ما حاد يوْماً","عن القصد السويِّ ولا استبدا",57,"د",2,0],["وصولي صولةَ الرئبالِ يعدو","على من حام من حوْل العرين",58,"ن",1,0],["وصُوِّرَ شخصُك فوقَ الضفافِ","هنالك، لا هيكلاً من حَجَر",59,"ر",1,0],["وصوَّرتْهُ لعين الشرق أمثلةً","عليا، وصوَّرنا الرحمن أمثالا",60,"ل",2,0],["وصَوتاً لمجدِكَ مِنْ أنْ يُذالَ","بما أنت تأباهُ مِن مُبّدع",61,"ع",1,0],["وصوتها....؟ أأأخر شموخ الطراز.؟ المملكي","وبحته.؟ تقمع ضهور الحروف الغاديه",62,"د",3,0],["وصوّروا المجد بلألائه","عسى يفيق الهاجع الغافل",63,"ل",1,0],["وصوْمُه الشهرَ، ما لم يجنِ مَعصيِتَةً","، يُغنيهِ عن صَومه شعبانَ، أو رَجَبا",64,"ب",2,0],["وصوّرَ ليثَ الشُّب في مستقَرِّهِ","، ولوشاء أمسى، فوقَ غبرائه، كلْبَا",65,"ب",2,0],["وصوغيه لي وحدي فريدا وأشفقي","على سرّه المكنون أن يتسرّبا",66,"ب",2,0],["وصوغيه مشبوب اللّظى وتخيّري","لآلامه ما كان أقسى وأغربا",66,"ب",2,0],["وصوغيه كالفنّان يبدع تحفه","ويرمقها نشوان هيمان معجبا",66,"ب",2,0],["وصوتُك للنفسِ حادي النَجاة","ولَمسُ يديكِ كَلَمسِ إِله",67,"ه",1,0],["وصُومٌ صِّيمٌ مِن ذَاكَ أيضاً","وَصُوَّامٌ وصِيَّامٌ صُيَامُ",68,"م",1,0],["وَصَوارِمٌ ذُلُقٌ سَواءٌ عِندَها","يَومَ الكَريهَةِ حاسِرٌ وَمُقَنَّعُ",69,"ع",1,0],["وصُوِّرت في مِراةِ الأُفق صورتُها","فلي إليها برُسلِ اللحظِ تَرديدُ",70,"د",1,0],["وَصَونُ عِرضِ المَرءِ أَن يَبذُلَ ما","ضَنَّ بِهِ مِمّا حَواهُ وَاِنتَصى",71,"ا",1,0],["وصوتُها نغمٌ يسري به هدلٌ","تَشدو بِبَحَّتِه أُهْزُوجَةُ السَّمَرِ",72,"ر",1,0],["وصوت الطبل كردم طع","وصوت النأي طلير",73,"ر",1,0],["وصوفيّ له سمت","يهذ القول في الزهد",74,"د",1,0],["وَصوابُ كلِّ الخلقِ بعضُ صوابهِ","قرآنهُ مُتشابهٌ أو محكمُ",75,"م",1,0],["وصوَّحَ غصنٌ من ذرى المجدِ ناضرٌ","وأَقوى من القصرِ الرفيع مكين",76,"ن",1,0],["وصوَّح أصلُ المَعْلُواتِ وفَرْعُها","وقد يتبعُ الأصلَ الفروعُ الأطايب",77,"ب",1,0],["وصوت بغوم في الصباح سمعته","فأيقظ قلبا كان بالهجر غافيا",78,"ي",2,1],["وصوت رخيم اللحن في نبراته","أغاريد يهديها إلى القلب بلبل",79,"ل",1,0],["وصولوا آثمين بنار حرب","تحيل المزهرات إلى يباب",80,"ب",1,0],["وصولةٍ تتركُ السِّرحانَ خِرْنَقَةً","وتترك اللَّيْثَ مثل الضانِ والغَنَنمِ",81,"م",1,0],["وصورتُه كالعَتْرِ فازَ وإنْ سعى","هو العُثْرُ في جوِّ السماءِ يطيرُ",82,"ر",1,0],["وصوغه من غير ما تقررا","بكسر ما يلاصق المؤخرا",83,"ر",2,0],["وصوغها من ذي ثلاث كفعل","مكسور عين لازم على فعل",83,"ل",1,0],["وصوغها من ذي العيوب والحلا","وكل ذي لون كأفعل جلا",83,"ل",2,0],["وصوغها من فعل المضموم","على فعيل شاع كالكريم",83,"م",1,0],["وصوغها من فعيل من فعل","بفتح عينه وافعل وقل",83,"ل",1,0],["وصوغها من كل ما تقدّما","أتى على فعلان حيثما انتمى",83,"م",2,0],["