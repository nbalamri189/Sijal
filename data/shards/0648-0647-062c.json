{"poems":[[53,"أي طود دك من أي جبال","https://www.aldiwan.net/poem29889.html","الرمل"],[55,"أظلوم لما أن مللت وحلت عن","https://www.aldiwan.net/poem26058.html","الكامل"],[34,"ألا يا غراب البين هل أنت مخبري","https://www.aldiwan.net/poem4895.html","الطويل"],[91,"أنا لست بالحسناء أول مولع","https://www.aldiwan.net/poem8980.html","عموديه"],[91,"ليت الذي خلق الحياة جميلة","https://www.aldiwan.net/poem62628.html","عموديه"],[32,"ألم خيال من بثينة طارق","https://www.aldiwan.net/poem27778.html","الطويل"],[85,"وهذه واقعة مستغربه","https://www.aldiwan.net/poem8047.html","الرجز"],[43,"كفرندي فرند سيفي الجراز","https://www.aldiwan.net/poem9609.html","الخفيف"],[62,"أما الشباب فقد تقض","https://www.aldiwan.net/poem52278.html","مجزوء الكامل"],[45,"أما وهواك حلفة ذي اجتهاد","https://www.aldiwan.net/poem63502.html","الوافر"],[61,"تهيبه ورد الردى لو تهيبا","https://www.aldiwan.net/poem51811.html","الطويل"],[31,"أرسلت خلتي إلي بأنا","https://www.aldiwan.net/poem42604.html","الخفيف"],[74,"أسجايا كما ترق المدامه","https://www.aldiwan.net/poem13256.html","الخفيف"],[81,"هاتها كالمنار لاح النهار","https://www.aldiwan.net/poem61524.html","الخفيف"],[67,"ذو يراع يروع كالسيف إما","https://www.aldiwan.net/poem18069.html","الخفيف"],[46,"يغدو إلى كسب قيراط أخو عمل","https://www.aldiwan.net/poem22623.html","البسيط"],[46,"أدين برب واحد وتجنب","https://www.aldiwan.net/poem23440.html","الطويل"],[46,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140903",""],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16661","الكامل"],[100,"ثرثرات محموم","https://www.poetsgate.com/ViewPoem.aspx?id=50376",""],[18,"أَهَاجَ قَذَاءَ عَيْنِي الإِذِّكَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=22981",""],[90,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[91,"تأملات","https://www.poetsgate.com/ViewPoem.aspx?id=53220",""],[86,"يارَئيسَ الشِّعرِ قُل لي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13059&r=&rc=14",""],[31,"أرسلتْ خلتي إليّ بأنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18799&r=&rc=62",""],[118,"جزائري","https://www.aldiwan.net/poem24036.html","الكامل"],[143,"لجاجة قلب ما يفيق غرورها","https://www.aldiwan.net/poem58440.html","الطويل"],[144,"سل عن فضائلك الزمان لتخبرا","https://www.aldiwan.net/poem11760.html","الكامل"],[156,"أهلا بنمام ينم بطيبه","https://www.aldiwan.net/poem55518.html","الكامل"],[161,"جرى لك في خرق العوائد والعرف","https://www.aldiwan.net/poem58901.html","الطويل"],[161,"لقد حكمت بأمر فيه بعد","https://www.aldiwan.net/poem58903.html","الوافر"],[161,"أتخشى بأن يغشى صوارمه الظما","https://www.aldiwan.net/poem58941.html","الطويل"],[182,"إلى أى حين أنت ضارب غمرة","https://www.aldiwan.net/poem58865.html","الطويل"],[186,"وبيضاء العوارض قابلتها","https://www.aldiwan.net/poem14096.html","الوافر"],[187,"ذهب الشباب وطيبه","https://www.aldiwan.net/poem43623.html","مجزوء الكامل"],[187,"حسبي ضجرت من الأدب","https://www.aldiwan.net/poem44151.html","مجزوء الكامل"],[212,"يا قلب هذا نعيم","https://www.aldiwan.net/poem46564.html","المجتث"],[224,"حين أقبلت والهوى فيك يحبو","https://www.aldiwan.net/poem39723.html","الخفيف"],[238,"كم ذا تقرطسني بسمر نبالها","https://www.aldiwan.net/poem18851.html","الكامل"],[323,"ذرفت عيني دموعا","https://www.aldiwan.net/poem56351.html","مجزوء الرمل"],[354,"يقولون لي اهج الطبل لكنهم كنوا","https://www.aldiwan.net/poem39973.html","الطويل"],[358,"هنيئا لك الإقبال واليمن والنجح","https://www.aldiwan.net/poem4174.html","الطويل"],[372,"إن تخطاني زماني","https://www.aldiwan.net/poem57086.html","مجزوء الرمل"],[392,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[401,"وهج الحب","https://www.aldiwan.net/poem6703.html","عموديه"],[404,"أخبرونا تفضلا ما الذي كان","https://www.aldiwan.net/poem33912.html","الخفيف"],[407,"نفسي الفِداء لِلحظِها من رامِ","https://www.aldiwan.net/poem50116.html","الكامل"],[421,"كالخط في كتب الغلام أجاده","https://www.aldiwan.net/poem4859.html","الكامل"],[428,"وفد البيان","https://www.aldiwan.net/poem42145.html","عموديه"],[442,"العذل يقلق والصبابة تلبس","https://www.aldiwan.net/poem14308.html","الكامل"],[442,"ألا كم مدع لله تائب","https://www.aldiwan.net/poem14349.html","الوافر"],[442,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[442,"ألا مبلغ عني بشير بن جمعة","https://www.aldiwan.net/poem14425.html","الطويل"],[442,"الرزء من قلقي أجل وأعظم","https://www.aldiwan.net/poem14482.html","الكامل"],[459,"أمن كل حظ قل قسمي أقله","https://www.aldiwan.net/poem56071.html","الطويل"],[465,"شهرت علي صوارم العذل","https://www.aldiwan.net/poem3349.html","عموديه"],[478,"أذال على بالي الرسوم المدامعا","https://www.aldiwan.net/poem15322.html","الطويل"],[478,"تمنى فكنتم جل ما يتمناه","https://www.aldiwan.net/poem15345.html","الطويل"],[501,"سألت آرام نجد","https://www.aldiwan.net/poem38059.html","المجتث"],[515,"شرف الوجه في تراب زرود","https://www.aldiwan.net/poem20806.html","الخفيف"],[530,"مكحولة الحدقات وطفا","https://www.aldiwan.net/poem37321.html","مجزوء الكامل"],[530,"هذا العقيق فقف على أبوابه","https://www.aldiwan.net/poem37529.html","الكامل"],[545,"ثمالة الأمل","https://www.aldiwan.net/poem67253.html","عموديه"],[552,"يا مالكا رقي بلا ثمن","https://www.aldiwan.net/poem47157.html","أحذ الكامل"],[552,"قباء لها أعلى الربى وخيام","https://www.aldiwan.net/poem47236.html","الطويل"],[552,"وأعرضت حتى لا أراك وإنما","https://www.aldiwan.net/poem47769.html","الطويل"],[554,"قطعت قتول قرينة الحبل","https://www.aldiwan.net/poem68394.html","الكامل"],[554,"اهلا بكيت ظعائنا وحمولا","https://www.aldiwan.net/poem68428.html","الكامل"]],"verses":[["وَهَجَرناكَ عَلى ضَنِّ الهَوى","رُبَّ هِجرانٍ عَلى غَيرِ تَقالي",0,"ل",2,0],["وَهَجَرتِني هَجرَ اِمرِئٍ مُتَعَتِّبٍ","أَمسى رِضاهُ عَلى الهَوى غَضبانا",1,"ن",2,0],["وَهِجتَ قَذى عَينٍ بِلُبنى مَريضَةٍ","إِذا ذُكِرَت فاضَت مَدامِعُها تَجري",2,"ر",2,0],["وَهَجَعتُ أَحسَبُ أَنَّها بِنتَ الرُأى","فَصَحَوتُ أَسخَرُ بِالنِيامِ الهُجَّعِ",3,"ع",1,0],["وَهَجَرتُ رَوضَتُهُ فَأَصبَحَ وَردُها","لِليَأسِ كَالأَشواكِ في أَدغالِها",4,"ل",3,0],["وَهَجرُكَ مِن تَيما بَلاءٌ وَشِقوَةٌ","عَلَيكَ مَعَ الشَوقِ الَّذي لا يُفارِقُ",5,"ق",1,0],["وَهَجَعَت عَلى الطَريقِ هَجعَه","فَخَرَجَت ضَرَّتُها بِسُرعَه",6,"ه",1,0],["وَهِجانٍ عَلى هِجانٍ تَآيَت","كَ عَديدَ الحُبوبِ في الأَقوازِ",7,"ز",1,0],["وهجرتُ إِخوانَ البطَا","لةِ والندامَى والمُدَامَا",8,"م",2,0],["وَهَجرُ القُربِ مِنها كانَ أَشهى","إِلى المُشتاقِ مِن وَصلِ البِعادِ",9,"د",1,0],["وَهَجْرٍ تردُّ الخيلُ رأْدَ ضَحائِه","بأرهاجها قِطْعاً من الليلِ غَيهَبا",10,"ب",2,0],["وَهَجَرتَ الرَبابَ مِن حُبِّ سُعدى","وَنَسيتَ الَّذي لَها كُنتَ قُلنا",11,"ن",2,0],["وَهُجومٌ عَلَيهِ غُرَّةُ نَصرٍ","وَنُجومٌ عَلَيهِ بُشرى سَلامَه",12,"م",2,0],["وَهَجيرُ الأَيّامِ مِنهُ مَقيلٌ","وَاللَيالي بِطيبِها أَسحارُ",13,"ر",1,0],["وَهَجَرْتُ الكِرامَ حتى شَكانِي","منهمُ كلُّ عاشِقٍ مَهْجورِ",14,"ر",1,0],["وَهَجرُ لَذَّةٍ حينٍ غَيرِ دائِمَةٍ","يَرُدُّ بِالمَنطِقِ المُتَفالَ مِعطارا",15,"ر",2,0],["وَهَجَّنَ لَذّاتِ المُلوكِ زَوالُها","كَما غَدَرَت بِالمُنذِرينَ الهَجائِنُ",16,"ن",1,0],["وهَجَرْنا شُرْبَ الكؤوسِ احْتقاراً","وشَرِبْنا مَسَرّةً بالدّنَانِ",17,"ن",1,0],["وهجانٍ على هجانٍ تأتي","ك عديد الحبوب في الأقواز",18,"ز",1,0],["وهَجيرَةٍ كالهَجْرِ موْجُ مَرابِها","كالبَحرِ ليس لمائها مِن طُحلُب",19,"ب",1,0],["وهجمنا .. متنا قليلا أفقنا","موتنا كان مولدا لا إرادي",20,"د",2,0],["وَهَجْرِي الْغَانِيَاتِ وَشُرْبَ كَأْسٍ","وَلُبْسِي جُبَّة ً لاَتُسْتَعَارُ",21,"ر",1,0],["وهجرنا الكؤوسَ لكن لعُرسٍ","هو اصفى كأساً واطيبُ أُنسا",22,"س",2,0],["وهجرت روضته فأصبح وردها","لليأس كالأشواك في أذغالها",23,"ل",3,0],["وهَجَرْتَ الناسَ حتّى","ساءَلُوا أين الأنيسُ",24,"س",1,0],["وَهَجَرْتَ الرَّبابَ مِنْ حُبِّ سُعْدَى","ونسيتَ الذي لها كنتَ قلتا",25,"ت",2,0],["وهَجَرْتَ أحلامي وأقلامَ الهوى","وذَهَبْتَ عِندَ خُوارِ عِجْلِ السَّامِرِي",26,"ر",2,0],["وهجهجَ بي عن أرض بغدادَ ذِلةٌ","كوخز سنانِ السمهرىّ حُصورُها",27,"ر",3,0],["وَهَجَرتُ أَملاكَ الزَمانِ مُواصِلاً","هَذا الجَنابَ وَحُقَّ لي أَن أَهجُرا",28,"ر",2,0],["وَهِجاءُ نَمَّامٍ إِذا نَكَّسْتَهُ","لَكَ طَارِفٌ مِنْ طَارِقِ الحَدَثانِ",29,"ن",1,0],["وهجر بلاد أنت سلطان أهلها","إلى بلد للهسف لاقاه والخسف",30,"ف",1,0],["وهجرٌ من وصولٍ غيرِ جافٍ","لمن لم يحك وداً منه ودُّ",31,"د",1,0],["وهِجتُم خزبراً لا يطاق نزالهُ","وأقبل يجتاب الخميسَ العر مرما",32,"م",2,0],["وهَجرُ سُلَيمَى مُستَبِينٌ طرِيقُهُ","وَمَسلَكُهُ وَعرٌ إِذا رُمتَهُ صَعبُ",33,"ب",1,0],["وهَجْرُك آكَدُ الأسبابِ فيها","فمُوجِبها ذنُوبك لا ذنوبِي",34,"ب",2,0],["وهجرت لذات النفو","س عنا وجهلا بالغا",35,"غ",2,0],["وهجَرت إعراب الكلا","م وما حفظت من الخطب",36,"ب",1,0],["وهجتني للقتال","يا أفعوانَ الغياض",37,"ض",1,0],["وَهَجَّرَ مُشتاقٌ وَصَلّى مُفَكِّرُ","وَحَقِّ هَوى غَلوا أُحَسُّكِ في دَمي",38,"ي",1,0],["وَهَجَرْتُ سُعْدَى وَالرَّبَابَ وَعَزَّةً","وَرَدَعْتُ نَفْسِي عَنْ قَبِيحِ جِدَالِهَا",39,"ل",3,0],["وَهِجانٍ وَقِيانٍ","وَقِبابٍ كَالقُصورِ",40,"ر",1,0],["وَهَجو لَئيم القَوم أَنفى لذلّه","كَنفي غبار النَعل ينفضُ بِالنَعلِ",41,"ل",1,0],["وَهِجتُم لِكَي تُنحُوا عَلَى الثَّغرِ هَيجَةً","فَنَاحَ صَدَى أروَاحِكُم قَبلَ أَن تُنحُوا",42,"ح",3,0],["وهِجانُ البُزلِ لا تَب","رُكُ إلا بهِجانِ",43,"ن",1,0],["وهجرته للمدينه ثم فيها الوفاه","وعلم أحكام شرع الله مما نهاه",44,"ا",2,0],["وَهَجَ الحُبِّ لا تزدْني حَنين","لا تزدْني فوق الأَنين أَنينا",45,"ن",2,1],["وَهَجَ الحُبِّ لا تسلني فإني","في زمانٍ يُثير فينا الظنونا",45,"ن",2,0],["وَهَجَ الحُبِّ، لا تكرِّرْ سؤال","يُشعل القلب، يستثير الشُّجونا",45,"ن",2,0],["وَهَجَ الحُبِّ، لا تَسَلْ عن ضعيفٍ","لا تَراه الأحداثُ إِلاَّ مَهينا",45,"ن",2,0],["وَهَجَ الحُبِّ، لا تَدَعْني وحيد","حين أدعو مَنْ أَمرُهم يَعنينا",45,"ن",2,0],["وهجمتم ما شيدوا من ضلال","وأشدتم ما شاده الأخيار",46,"ر",1,0],["وَهَجَرتُ رَشفَ رِضابهنَّ لأَنَّهُ","خَمرٌ وَلَستُ بِراشف لِمُدامِ",47,"م",1,0],["وَهِجاؤُهُ قاف وَلام بَعدَها","ميم مُعَلَّقَةٌ بِأَسفَلِ لامِه",48,"م",2,0],["وهج الجهاد يشع من أقلامكم","فيزيد من عزم الشباب تضرما",49,"م",2,0],["وهجيرة قالت بها غزلانها","فوق الحزون صوافنا لا تشمس",50,"س",1,0],["وهجران الكرى حيث البرايا","بهم مال الكرى والليل كاثب",51,"ب",1,0],["وهجايم ملء المعاطن قد حمت","عنها المضاوي بالهدير جمالها",52,"ل",3,0],["وهجران طيب النوم والليل أَليل","ووصل الضحى بالليل تقرا وتصلح",53,"ح",1,0],["وهجير صيف قد خلعت عذاره","صوما وأنت المستغاث المطعم",54,"م",1,0],["وهجَّرَ بالأحرارِ إلا فتًى له","فتًى من بني عبد الرحيم يُظِلُّهُ",55,"ل",2,0],["وهجرت كل العالمين إلى","ملكٍ ظفرتُ لديهِ بالكلِّ",56,"ل",1,0],["وهَجْلٍ به تُنضَى القَطا الكُدْرُ جُبْتُهُ","بأعيسَ يُدينهِ واِنْ كانَ شاسِعا",57,"ع",2,0],["وهَجْلٌ إذا ما قلتُ للعيسِهذه","أواخرُه كانتْ مِن البعدِ أُولاهُ",58,"ا",2,0],["وهَجمةُ السَّيل منها","صبَّ السَّحابِ اسْتَعارتْ",59,"ت",1,0],["وهجرْتَ الرُقادَ هَجراً جَميلاً","ووصلْتَ الجُفونَ بالتّسهيدِ",60,"د",1,0],["وهَجَرْتَني وضرَبْتَ دُو","نَ الْوَصْلِ واللُّقياءِ سِجْفا",61,"ف",2,0],["وهَجَرْتُ فيهِ مَلاعِبي ولَقِيتُ في","هِ مَتَاعِبي ومُنيتُ مِنْ أَوْصابِهِ",62,"ب",2,0],["وهج القباب أم المصير المُتعبُ","ذاك الذي لكِ شدّني يا يثربُ",63,"ب",1,1],["وهَجَرتني فطردت معتمداً","عن مُقْلَتَيَّ لَذاذَةَ الوَسَنِ",64,"ن",1,0],["وهجرُكِ صِرْفٌ لا لقاءَ يشوبُهُ","فإنْ عَنَّ يوماً فاللّقاءُ لِمامُ",65,"م",1,0],["وهجرُكِ منّي ليس إلّا لِعلّةٍ","ولكنّ هجراً جاء منكِ بلا عذرِ",66,"ر",1,0],["وَهَجيرَةٍ أَدرَجتُ مَوقِدَها","وَبُطونُها وَظُهورُها تَغلي",67,"ل",2,0],["وَهَجيرَةٍ كَلَّفتُ طَيَّ مَقيلِها","ظُهراً وَقَد طَلَبَ الكَنيسُ مَقيلا",68,"ل",2,0]]}