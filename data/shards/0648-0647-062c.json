12889",""],[5111,"غَيْمُ الْخَلِيجِ","https://www.poetsgate.com/ViewPoem.aspx?id=212608",""],[5174,"لغة الضاد ليلة الزفاف","https://www.poetsgate.com/ViewPoem.aspx?id=184937",""],[5183,"كؤس الحب","https://www.poetsgate.com/ViewPoem.aspx?id=185677",""],[5219,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=194939",""],[5299,"ارجعْ","https://www.poetsgate.com/ViewPoem.aspx?id=210537",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5410,"أمل","https://www.poetsgate.com/ViewPoem.aspx?id=142234",""],[5447,"مطر وموسيقى","https://www.poetsgate.com/ViewPoem.aspx?id=210814",""],[5512,"بوحي مهيض","https://www.poetsgate.com/ViewPoem.aspx?id=204169",""],[5607,"قد نهانا عن الغرام نهانا","https://www.poetsgate.com/ViewPoem.aspx?id=181269",""],[5612,"قالَتْ ... وقُلْت","https://www.poetsgate.com/ViewPoem.aspx?id=186317",""],[5650,"عَائِشَة... وَحْيُ الْقَصِيد!","https://www.poetsgate.com/ViewPoem.aspx?id=131223",""],[5660,"يا قُنبُلُةَ الهَجرِ انفَجِري","https://www.poetsgate.com/ViewPoem.aspx?id=37065",""],[5691,"أطبق الصمت...!","https://www.poetsgate.com/ViewPoem.aspx?id=206739",""],[5700,"خريف","https://www.poetsgate.com/ViewPoem.aspx?id=207501",""],[5804,"تمنّيت","https://www.poetsgate.com/ViewPoem.aspx?id=181662",""],[5847,"وهَجُ الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=6938",""],[5853,"كلاسيكية على جدار التجريد","https://www.poetsgate.com/ViewPoem.aspx?id=175721",""],[5855,"مَا أردْت الْأَرَاك إِلَّا لِأَنِّي","https://www.poetsgate.com/ViewPoem.aspx?id=188721",""],[5956,"سخرية","https://www.poetsgate.com/ViewPoem.aspx?id=193527",""],[6069,"يا مالك القلب أنت أعلم من","https://www.poetsgate.com/ViewPoem.aspx?id=105646",""],[6131,"عَينايَ زرقاءُ اليَمامةْ","https://www.poetsgate.com/ViewPoem.aspx?id=189287",""],[1333,"أأحور عن قصدي وقد برح الخفا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=56028&r=&rc=6",""],[6202,"سبعون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86728&r=&rc=29",""],[6225,"محاسبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80910&r=&rc=179",""],[6287,"عزوز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66138&r=&rc=2",""],[6337,"آنَستُ وجهك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81399&r=&rc=11",""]],"verses":[["وَهَجَرناكَ عَلى ضَنِّ الهَوى","رُبَّ هِجرانٍ عَلى غَيرِ تَقالي",0,"ل",2,0],["وَهَجَرتِني هَجرَ اِمرِئٍ مُتَعَتِّبٍ","أَمسى رِضاهُ عَلى الهَوى غَضبانا",1,"ن",2,0],["وَهِجتَ قَذى عَينٍ بِلُبنى مَريضَةٍ","إِذا ذُكِرَت فاضَت مَدامِعُها تَجري",2,"ر",2,0],["وَهَجَعتُ أَحسَبُ أَنَّها بِنتَ الرُأى","فَصَحَوتُ أَسخَرُ بِالنِيامِ الهُجَّعِ",3,"ع",1,0],["وَهَجَرتُ رَوضَتُهُ فَأَصبَحَ وَردُها","لِليَأسِ كَالأَشواكِ في أَدغالِها",4,"ل",3,0],["وَهَجرُكَ مِن تَيما بَلاءٌ وَشِقوَةٌ","عَلَيكَ مَعَ الشَوقِ الَّذي لا يُفارِقُ",5,"ق",1,0],["وَهَجَعَت عَلى الطَريقِ هَجعَه","فَخَرَجَت ضَرَّتُها بِسُرعَه",6,"ه",1,0],["وَهِجانٍ عَلى هِجانٍ تَآيَت","كَ عَديدَ الحُبوبِ في الأَقوازِ",7,"ز",1,0],["وهجرتُ إِخوانَ البطَا","لةِ والندامَى والمُدَامَا",8,"م",2,0],["وَهَجرُ القُربِ مِنها كانَ أَشهى","إِلى المُشتاقِ مِن وَصلِ البِعادِ",9,"د",1,0],["وَهَجْرٍ تردُّ الخيلُ رأْدَ ضَحائِه","بأرهاجها قِطْعاً من الليلِ غَيهَبا",10,"ب",2,0],["وَهَجري الغانِياتِ وَشُربَ كَأسٍ","وَلُبسي جُبَّةً لا تُستَعارُ",11,"ر",1,0],["وَهَجَرتَ الرَبابَ مِن حُبِّ سُعدى","وَنَسيتَ الَّذي لَها كُنتَ قُلنا",12,"ن",2,0],["وَهُجومٌ عَلَيهِ غُرَّةُ نَصرٍ","وَنُجومٌ عَلَيهِ بُشرى سَلامَه",13,"م",2,0],["وَهَجيرُ الأَيّامِ مِنهُ مَقيلٌ","وَاللَيالي بِطيبِها أَسحارُ",14,"ر",1,0],["وَهَجَرْتُ الكِرامَ حتى شَكانِي","منهمُ كلُّ عاشِقٍ مَهْجورِ",15,"ر",1,0],["وَهَجرُ لَذَّةٍ حينٍ غَيرِ دائِمَةٍ","يَرُدُّ بِالمَنطِقِ المُتَفالَ مِعطارا",16,"ر",2,0],["وَهَجَّنَ لَذّاتِ المُلوكِ زَوالُها","كَما غَدَرَت بِالمُنذِرينَ الهَجائِنُ",17,"ن",1,0],["وهَجَرْنا شُرْبَ الكؤوسِ احْتقاراً","وشَرِبْنا مَسَرّةً بالدّنَانِ",18,"ن",1,0],["وهجانٍ على هجانٍ تأتي","ك عديد الحبوب في الأقواز",19,"ز",1,0],["وهَجيرَةٍ كالهَجْرِ موْجُ مَرابِها","كالبَحرِ ليس لمائها مِن طُحلُب",20,"ب",1,0],["وهجمنا .. متنا قليلا أفقنا","موتنا كان مولدا لا إرادي",21,"د",2,0],["وهجرنا الكؤوسَ لكن لعُرسٍ","هو اصفى كأساً واطيبُ أُنسا",22,"س",2,0],["وهجرت روضته فأصبح وردها","لليأس كالأشواك في أذغالها",23,"ل",3,0],["وهَجَرْتَ الناسَ حتّى","ساءَلُوا أين الأنيسُ",24,"س",1,0],["وَهَجَرْتَ الرَّبابَ مِنْ حُبِّ سُعْدَى","ونسيتَ الذي لها كنتَ قلتا",25,"ت",2,0],["وهَجَرْتَ أحلامي وأقلامَ الهوى","وذَهَبْتَ عِندَ خُوارِ عِجْلِ السَّامِرِي",26,"ر",2,0],["وهجهجَ بي عن أرض بغدادَ ذِلةٌ","كوخز سنانِ السمهرىّ حُصورُها",27,"ر",3,0],["وَهَجَرتُ أَملاكَ الزَمانِ مُواصِلاً","هَذا الجَنابَ وَحُقَّ لي أَن أَهجُرا",28,"ر",2,0],["وَهِجاءُ نَمَّامٍ إِذا نَكَّسْتَهُ","لَكَ طَارِفٌ مِنْ طَارِقِ الحَدَثانِ",29,"ن",1,0],["وهجر بلاد أنت سلطان أهلها","إلى بلد للهسف لاقاه والخسف",30,"ف",1,0],["وهجرٌ من وصولٍ غيرِ جافٍ","لمن لم يحك وداً منه ودُّ",31,"د",1,0],["وهِجتُم خزبراً لا يطاق نزالهُ","وأقبل يجتاب الخميسَ العر مرما",32,"م",2,0],["وهَجرُ سُلَيمَى مُستَبِينٌ طرِيقُهُ","وَمَسلَكُهُ وَعرٌ إِذا رُمتَهُ صَعبُ",33,"ب",1,0],["وهَجْرُك آكَدُ الأسبابِ فيها","فمُوجِبها ذنُوبك لا ذنوبِي",34,"ب",2,0],["وهجرت لذات النفو","س عنا وجهلا بالغا",35,"غ",2,0],["وهجَرت إعراب الكلا","م وما حفظت من الخطب",36,"ب",1,0],["وهجتني للقتال","يا أفعوانَ الغياض",37,"ض",1,0],["وَهَجَّرَ مُشتاقٌ وَصَلّى مُفَكِّرُ","وَحَقِّ هَوى غَلوا أُحَسُّكِ في دَمي",38,"ي",1,0],["وَهَجَرْتُ سُعْدَى وَالرَّبَابَ وَعَزَّةً","وَرَدَعْتُ نَفْسِي عَنْ قَبِيحِ جِدَالِهَا",39,"ل",3,0],["وَهِجانٍ وَقِيانٍ","وَقِبابٍ كَالقُصورِ",40,"ر",1,0],["وَهَجو لَئيم القَوم أَنفى لذلّه","كَنفي غبار النَعل ينفضُ بِالنَعلِ",41,"ل",1,0],["وَهِجتُم لِكَي تُنحُوا عَلَى الثَّغرِ هَيجَةً","فَنَاحَ صَدَى أروَاحِكُم قَبلَ أَن تُنحُوا",42,"ح",3,0],["وهِجانُ البُزلِ لا تَب","رُكُ إلا بهِجانِ",43,"ن",1,0],["وهجرته للمدينه ثم فيها الوفاه","وعلم أحكام شرع الله مما نهاه",44,"ا",2,0],["وَهَجَ الحُبِّ لا تزدْني حَنين","لا تزدْني فوق الأَنين أَنينا",45,"ن",2,1],["وَهَجَ الحُبِّ لا تسلني فإني","في زمانٍ يُثير فينا الظنونا",45,"ن",2,0],["وَهَجَ الحُبِّ، لا تكرِّرْ سؤال","يُشعل القلب، يستثير الشُّجونا",45,"ن",2,0],["وَهَجَ الحُبِّ، لا تَسَلْ عن ضعيفٍ","لا تَراه الأحداثُ إِلاَّ مَهينا",45,"ن",2,0],["وَهَجَ الحُبِّ، لا تَدَعْني وحيد","حين أدعو مَنْ أَمرُهم يَعنينا",45,"ن",2,0],["وهجمتم ما شيدوا من ضلال","وأشدتم ما شاده الأخيار",46,"ر",1,0],["وَهَجَرتُ رَشفَ رِضابهنَّ لأَنَّهُ","خَمرٌ وَلَستُ بِراشف لِمُدامِ",47,"م",1,0],["وَهِجاؤُهُ قاف وَلام بَعدَها","ميم مُعَلَّقَةٌ بِأَسفَلِ لامِه",48,"م",2,0],["وهج الجهاد يشع من أقلامكم","فيزيد من عزم الشباب تضرما",49,"م",2,0],["وهجيرة قالت بها غزلانها","فوق الحزون صوافنا لا تشمس",50,"س",1,0],["وهجران الكرى حيث البرايا","بهم مال الكرى والليل كاثب",51,"ب",1,0],["وهجايم ملء المعاطن قد حمت","عنها المضاوي بالهدير جمالها",52,"ل",3,0],["وهجران طيب النوم والليل أَليل","ووصل الضحى بالليل تقرا وتصلح",53,"ح",1,0],["وهجير صيف قد خلعت عذاره","صوما وأنت المستغاث المطعم",54,"م",1,0],["وهجَّرَ بالأحرارِ إلا فتًى له","فتًى من بني عبد الرحيم يُظِلُّهُ",55,"ل",2,0],["وهجرت كل العالمين إلى","ملكٍ ظفرتُ لديهِ بالكلِّ",56,"ل",1,0],["وهَجْلٍ به تُنضَى القَطا الكُدْرُ جُبْتُهُ","بأعيسَ يُدينهِ واِنْ كانَ شاسِعا",57,"ع",2,0],["وهَجْلٌ إذا ما قلتُ للعيسِهذه","أواخرُه كانتْ مِن البعدِ أُولاهُ",58,"ا",2,0],["وهَجمةُ السَّيل منها","صبَّ السَّحابِ اسْتَعارتْ",59,"ت",1,0],["وهجرْتَ الرُقادَ هَجراً جَميلاً","ووصلْتَ الجُفونَ بالتّسهيدِ",60,"د",1,0],["وهَجَرْتَني وضرَبْتَ دُو","نَ الْوَصْلِ واللُّقياءِ سِجْفا",61,"ف",2,0],["وهَجَرْتُ فيهِ مَلاعِبي ولَقِيتُ في","هِ مَتَاعِبي ومُنيتُ مِنْ أَوْصابِهِ",62,"ب",2,0],["وهج القباب أم المصير المُتعبُ","ذاك الذي لكِ شدّني يا يثربُ",63,"ب",1,1],["وهَجَرتني فطردت معتمداً","عن مُقْلَتَيَّ لَذاذَةَ الوَسَنِ",64,"ن",1,0],["وهجرُكِ صِرْفٌ لا لقاءَ يشوبُهُ","فإنْ عَنَّ يوماً فاللّقاءُ لِمامُ",65,"م",1,0],["وهجرُكِ منّي ليس إلّا لِعلّةٍ","ولكنّ هجراً جاء منكِ بلا عذرِ",66,"ر",1,0],["وَهَجيرَةٍ أَدرَجتُ مَوقِدَها","وَبُطونُها وَظُهورُها تَغلي",67,"ل",2,0],["وَهَجيرَةٍ كَلَّفتُ طَيَّ مَقيلِها","ظُهراً وَقَد طَلَبَ الكَنيسُ مَقيلا",68,"ل",2,0],["وَهَجَرتَها هَجرَ اِمرِئٍ","لَم يَقلُ صَفوَ صَفائِها",69,"ا",3,0],["وَهَجَرنَني وَهَجَرتُهُنَّ وَقَد","غَنِيَت كَرائِمُها يَطُفنَ بِيَه",70,"ي",2,0],["وهجرى وقد صح الوداد تواصل","وبعد النأي للقلب منه اقترابه",71,"ب",2,0],["وهجرتَ من دُور النعيم مرابعاً","والفتَ من دور الشقاء ربوعا",72,"ع",2,0],["وَهَجرٌ لِفَقدِ الحَبرِ ثَكلَى حَزِينَةٌ","وَحُقَّ لها تَبكِي دَماً فهيَ مَنشَاهُ",73,"ا",2,0],["وَهجرتني وَنقضت حبل مودّتي","وَبِذاكَ لي شَهدت شُهود قِلاكا",74,"ك",2,0],["وَهَجَرنا سِواهُ وَهوَ مُنيلٌ","وَهَويناهُ وَهوَ غَيرُ مُنيلِ",75,"ل",1,0],["وهجرتُ راحتيَ التي لولاك ما","ذهبت ولو حمِّلت طوداً عاليا",76,"ي",2,0],["وهجوماً على هجائي كما قد","عاينَ الليثُ من هجومِ الحمار",77,"ر",1,0],["وَهِجْرَانُهُمْ صَعْبٌ عَلَيَّ وَلَمْ يَهُنْ","لَقَدْ صُنْتُ سِرَّ الْحُبِّ وَالدَّمْعُ لَمْ يَصُنْ",78,"ن",1,0],["وهجوم يوم البين صعبٌ هولهُ","والكاس مرٌ فيه ذا المشروبُ",79,"ب",1,0],["وهَجَرْتُ في وَصْلِ الكَعابِ مُناصِحي","وأَخَذْتُ في رَدْعِ العِتابِ ودَحْضِهِ",80,"ض",2,0],["وهُجْرٌ كُنْتُ أُنعشُ فيهِ روحي","بِقُرْبِكَ جانياً صاباً وشَهْدا",81,"د",2,0],["وَهجَرْتُمُ فَقَبَضْتُمُ نَفْسي","وَوَصَلْتُمُ فَشَرَحْتُمُ صَدْري",82,"ر",2,0],["وهجرهم صعب فأي مماثل","له عند عبد صار صبا متيما",83,"م",2,0],["وَهَجَرتُ دُنيا لَم تَزَل غَدّارَةً","بِمُؤَمِّليها المُمحِضينَ لَها الوَفا",84,"ف",2,0],["وهجعت في جوف الضريح وطالما","كانت عيونك في الدجى لا تهجع",85,"ع",1,0],["وَهَجُ الشمسِ لا يُحَسُّ ونورُ الشْ","شَمْسِ عندي ما كان بالمتضائل",86,"ل",1,0],["وهجرتُ الشعرَ لمَّا اهتضمَ","العمرَ اهتضاما",87,"م",2,0],["وهجرتني هجر الرقاد لناظري","وعزوت لي السلوان يا مولائي",88,"ي",1,0],["وَهَجمَةٌ صُهبٌ طِوالُ الأَعناق","تُباكِرُ العِضاهَ قَبلَ الإِشراق",89,"ق",1,0],["وهِجّيَرَاهُ ذكر اللَهِ دوماً","فلا يَعرُوهُ في الذكر الفُتُورُ",90,"ر",1,0],["وهجوم ذو وابتزاز ملابس","وقران شيب واستباء نساء",91,"ا",2,0],["وَهَجَّنتَ كَعباً في السَماحِ وَحاتِماً","كَما هُجِّنَت في الراحَتين الزَوائدُ",92,"د",1,0],["وهجرتُ القرائح المستهلَّا","تِ قُراحاً في الربْع والأقوازِ",93,"ز",1,0],["وهجرتَني وثناكَ عنِّي كذبُهمْ","أشبهتَ أعدائي فصرتُ أحبُّهم",94,"م",1,0],["وهجوم برسيلوف شدَّد عزمها","لتشقَّ منطقة الحيادِ وتهجما",95,"م",2,0],["وهجومُ برسيلوف أوقف رافعاً","عن عاتق النمسا العناءَ الاعظما",95,"م",2,0],["وهجرنا الحسان هجراً جميلا","وخلعنا الصبا على أخدانه",96,"ن",2,0],["وَهَجَّدَهُ عَوراءُ مِن ذي قَرابَةٍ","عَلى رِيبَةٍ في سالِفٍ مُتَقادِمِ",97,"م",1,0],["وهجران من أبدى المعاصيَ سنّة","وقد قيل إن يردعه أوجب وأكّد",98,"د",1,1],["وهجران من يدعو لأمر مضلّ أو","مفسّق احتمه بغير تردد",98,"د",1,0],["وهجتَ وهاج الكونُ حولك ناقماً","يغاصبك الدنيا وأَنت تغاصبه",99,"ب",2,0],["وهجرتُ دارَ العَامرية مِثلَ مَا","هجر الحسينُ الماءَ تحميه القنا",100,"ن",2,0],["وهجرت فيكم من نأي ومن دنا","وجعلت حبكم لنفسي ديدنا",101,"ن",2,0],["وَهِجاءٍ سارَ في الن","ناسِ لا يَمحوهُ ماحي",102,"ح",2,0],["وَهَجرك الدائم","قَد طالَ بِالهيمان",103,"ن",1,0],["وهجرت اهلي في سبيل","وصالها ذات النفور",104,"ر",1,0],["وهجرك فيه تشويف الأماني","ووصلك باعثٌ نور اليقين",105,"ن",1,0],["وهجرت عذالي وما طاوعتهم","وهتكت في شرع الهوى استاري",106,"ر",2,0],["وَهَجرت الأَهل وَالأَولاد وَالر","ربع يا خَير كَريم قَصدا",107,"د",2,0],["وَهجا الناسُ من هَجاهُ وَما زا","ل الى الآن للهِجا موضوعا",108,"ع",2,0],["وهجر الاتراب والأقرانا","وفي قليل حفظ القرآنا",109,"ن",2,0],["وهجرتَ الرقادَ تمْنعُ ملكاً","كان لولاكَ عُرضَةً للضّيَاعِ",110,"ع",1,0],["وهجرك تعذيب الموحد يقتضي","ويرجو التلاقي أم عذاب ذوي الكفر",111,"ر",1,0],["وهجرنا من الكلام الذي يُه","جر حتى نُبينَ في التعبير",112,"ر",1,0],["وهجرته فبكاك من جزع","متهدماً كالمربع الدرس",113,"س",1,0],["وهجر خلان الصبا","مسألة فيها نظر",114,"ر",1,0],["وهجرُ ذوي عَهدٍ وتركُ معاهدٍ","وفرقةُ أَصحابٍ وَفقدُ حَبيبِ",115,"ب",1,0],["وهجر به استولت على القلب غمّة","من الغم لا تقوى الرواسي لها حملا",116,"ل",2,0],["وهجرةٌ قالت رحيل للشامْ","فقال سيفٌ وأنا مَعْكَ أرامْ",117,"م",1,0],["وهجرُ أربعةٍ قل من أربعهْ","مخلّصٌ فخذ لذا ولتسمعهْ",118,"ه",1,0],["وهجر عصيان من النار مِلاصْ","وهجر مالٍ من عداوةٍ خلاصْ",118,"ص",1,0],["وهج جوبي المزدان في حلق الذهب","فلا يبق في الإغريق إلا من ارتعب",119,"ب",1,0],["وهجرت الصبا وصمت هجيرا","بعيون تندي البكا وهي عطشى",120,"ش",2,0],["وهجرتُ أَوطاني إليه ومَن رأَى","شرفاً له في أَنْ يفارقها هَجَرْ",121,"ر",1,0],["وهَجْرُ الَّتي اهْوَى مُدامٌ ودَلُّها","هُوَ النَّقْلُ فاصْبِرْ لِلْهَوى صَبْرَ راغِمِ",122,"م",1,0],["وَهِجرانُ أَوطاني وَفَرطُ تَوَلُّهي","وَشِدَّةُ إِحراقِ الحَشا وَتَفَجُّعي",123,"ع",2,0],["وهَجرتُ خِلاّنَ الصَّبابة والصِّبا","وهوى مغازَلة الغزال الأكْحَلِ",124,"ل",1,0],["وَهَجِينٌ عَابِرَاتٌ لِلصَّحارٍي","بَعْدَهَا نَنْظُرُ فِي شَأْنِ الرِّعَاَيا",125,"ا",3,0],["وهجَرتُ رَغْدَ معيشتي","حتّى التَّجمُّلَ والخِضابْ",126,"ب",1,0],["وَهْجُ الأنوثةِ في خُصرَيْهِ مُتَّقدٌ","يوري الحشاشةَ حتى يبلُغَ العُنُقا",127,"ق",2,0],["وهجرتُهُ وقطعتُ أسبابَ الهوى","وجعلتَ سلواني لهنَ بمرصدِ",128,"د",1,0],["وهجرت الرقاد إلا لزور","من خيال أذوقه تهجاعا",129,"ع",2,0],["وهجرك وصل ومواصل الناس فرقا","لكن تراك ان غبت باموت كتمه",130,"م",2,0],["وهجروا لذيذ المنامْ","وزادَ التقي قدمُوا",131,"و",2,0],["وهجرتُ حيّي مُذْ عرفتِ طريقه","بل كل حي تعرفين هجرتُهُ",132,"ت",2,0],["وَهِجْ يَا شِعْرُ ، فَالأوْطَانُ أضْحَتْ","مَرَابِضُ أسْدِهَا سَجْنًا وَشْنقَا",133,"ق",2,0],["وهْج العروبة من نداها دافئ","صَنعَتْ من المستصعبات مَجَاسا",134,"س",2,0],["وهجر ولا هجر الشتيتين عن قلى","ولكنه هجر اللقاء إلى حدّ",135,"د",1,0],["وهجرت مفاتنها زمنا","لأصون النفس من الزلل",136,"ل",1,0],["وهجرتُ بعدَكَ زينتي وتجمُّلي","لا شيء عندي اليوم أصبح يلمعُ",137,"ع",1,0],["وهجرانه لاشك فيه لديهمو","على ذلك الأمر الذي ليس يحتمل",138,"ل",1,0],["وهج اشتياقي إلى عينيكِ ليس","ما قد يشوب صلاحاً صانه العَمَلُ",139,"ل",1,0],["وهجرتُ عرّابَ الحنين بخافقي","إذ قال ما خطبُ المولّهِ.. ما نوى؟!",140,"و",2,0],["وَهْجُ الضُّحى كانَ من إشراقِ وجنتِها","والصُّبحُ من بعدِها قد صارَ مجهولا",141,"ل",2,0],["وهجرنا الحبيب خيفة أن يهجر","بدءا فيستمر عنانا",142,"ن",2,0],["وهَجَرْتَ قالتْ .. قُلْتُ : لا تَتَسَرَّعي","في الحُكْمِ يا مَحْبوبَتي .. وكَفاكِ",143,"ك",1,0],["وَهَجُ الْعُرُوشِ تَنَفّسَتْ جَمَرَاتُهُ","كَيداً تَسَوّرَ جَمْعَهمْ فَتَعَبّدَا",144,"د",2,0],["وَهِجائي إِن أُبدي حُبّي","وَ أَنا أُهدي أَعذَبَ شِعري",145,"ر",2,0],["وهَجَرْنا البَيْتَ العَتيقَ إلى","( الأبْيَض ِ) سَعْياً لِبابِهِ حُجّاجا !",146,"ج",2,0],["وَ هَجيرُ الشَقاءِ أَلهَبَ قَلبِي","لَم يُجِرْ رُوحيَ مِنهُ اليَومَ ظِلُّ!",147,"ل",1,0],["وهجّرتُ في تلكِ الفيافي وفي الدجى","سريتُ وكان الذئبَ في الليلِ عاويا",148,"ي",2,0],["وهجُ الحروف ِ بلحظة ِالإشراقِ","متألقاً بمعارجٍ وطباقِ",149,"ق",1,1],["وهجٌ يئنُّ صبابةً في داخلي","قد لا عهُ الغيدُ الذي فطم المنى",150,"ن",2,0],["وهجرت السِّوَاك إِلَّا لِأَنِّي","إِن ذكرت السِّوَاك قلت سواكا",151,"ك",2,0],["وهجْوك زوجتي قدّام ناس","تدافع عن حقوق لن تبورا..",152,"ر",2,0],["وهجرك المر إن رضيت به","أطيب عندي من وصلك العذب",153,"ب",1,0],["وَ هجرتَ ذاكَ الجُبَّ رغمَ ضيائِهِ","كيْ تُطفِئَ الأنوارَ كيْ تَتَحسَّرَا",154,"ر",2,0],["وهجرت دنيا لم تزل غرارة","بمؤمليها الممحضين لها الوفا",155,"ف",2,0],["وهجوت حين هجوت غير مكابر","إلا على الطاغين والأشرار",156,"ر",1,0],["وهجرْتِه يا نفسُ بعد تذوُّقٍ","غسَلَ الجوارحَ بالصفاءِ الأطهَرِ",157,"ر",1,0],["وهج الليالي إذا ما الحزن يبديه","أم طيف جنة بت الليل أحكيه",158,"ي",2,1],["وهجُ الحروف مع المدامع لا يُرى","إلاّ خيالاً باهتاً وغباشا",159,"ش",2,0]]}