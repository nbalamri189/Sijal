{"poems":[[53,"أي طود دك من أي جبال","https://www.aldiwan.net/poem29889.html","الرمل"],[55,"أظلوم لما أن مللت وحلت عن","https://www.aldiwan.net/poem26058.html","الكامل"],[34,"ألا يا غراب البين هل أنت مخبري","https://www.aldiwan.net/poem4895.html","الطويل"],[91,"أنا لست بالحسناء أول مولع","https://www.aldiwan.net/poem8980.html","عموديه"],[91,"ليت الذي خلق الحياة جميلة","https://www.aldiwan.net/poem62628.html","عموديه"],[32,"ألم خيال من بثينة طارق","https://www.aldiwan.net/poem27778.html","الطويل"],[85,"وهذه واقعة مستغربه","https://www.aldiwan.net/poem8047.html","الرجز"],[43,"كفرندي فرند سيفي الجراز","https://www.aldiwan.net/poem9609.html","الخفيف"],[62,"أما الشباب فقد تقض","https://www.aldiwan.net/poem52278.html","مجزوء الكامل"],[45,"أما وهواك حلفة ذي اجتهاد","https://www.aldiwan.net/poem63502.html","الوافر"],[61,"تهيبه ورد الردى لو تهيبا","https://www.aldiwan.net/poem51811.html","الطويل"],[31,"أرسلت خلتي إلي بأنا","https://www.aldiwan.net/poem42604.html","الخفيف"],[74,"أسجايا كما ترق المدامه","https://www.aldiwan.net/poem13256.html","الخفيف"],[81,"هاتها كالمنار لاح النهار","https://www.aldiwan.net/poem61524.html","الخفيف"],[67,"ذو يراع يروع كالسيف إما","https://www.aldiwan.net/poem18069.html","الخفيف"],[46,"يغدو إلى كسب قيراط أخو عمل","https://www.aldiwan.net/poem22623.html","البسيط"],[46,"أدين برب واحد وتجنب","https://www.aldiwan.net/poem23440.html","الطويل"],[46,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140903",""],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16661","الكامل"],[18,"أَهَاجَ قَذَاءَ عَيْنِي الإِذِّكَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=22981",""],[90,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[91,"تأملات","https://www.poetsgate.com/ViewPoem.aspx?id=53220",""],[86,"يارَئيسَ الشِّعرِ قُل لي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13059&r=&rc=14",""],[31,"أرسلتْ خلتي إليّ بأنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18799&r=&rc=62",""]],"verses":[["وَهَجَرناكَ عَلى ضَنِّ الهَوى","رُبَّ هِجرانٍ عَلى غَيرِ تَقالي",0,"ي",1,0],["وَهَجَرتِني هَجرَ اِمرِئٍ مُتَعَتِّبٍ","أَمسى رِضاهُ عَلى الهَوى غَضبانا",1,"ن",2,0],["وَهِجتَ قَذى عَينٍ بِلُبنى مَريضَةٍ","إِذا ذُكِرَت فاضَت مَدامِعُها تَجري",2,"ر",2,0],["وَهَجَعتُ أَحسَبُ أَنَّها بِنتَ الرُأى","فَصَحَوتُ أَسخَرُ بِالنِيامِ الهُجَّعِ",3,"ع",1,0],["وَهَجَرتُ رَوضَتُهُ فَأَصبَحَ وَردُها","لِليَأسِ كَالأَشواكِ في أَدغالِها",4,"ل",3,0],["وَهَجرُكَ مِن تَيما بَلاءٌ وَشِقوَةٌ","عَلَيكَ مَعَ الشَوقِ الَّذي لا يُفارِقُ",5,"ق",1,0],["وَهَجَعَت عَلى الطَريقِ هَجعَه","فَخَرَجَت ضَرَّتُها بِسُرعَه",6,"ه",1,0],["وَهِجانٍ عَلى هِجانٍ تَآيَت","كَ عَديدَ الحُبوبِ في الأَقوازِ",7,"ز",1,0],["وهجرتُ إِخوانَ البطَا","لةِ والندامَى والمُدَامَا",8,"م",2,0],["وَهَجرُ القُربِ مِنها كانَ أَشهى","إِلى المُشتاقِ مِن وَصلِ البِعادِ",9,"د",1,0],["وَهَجْرٍ تردُّ الخيلُ رأْدَ ضَحائِه","بأرهاجها قِطْعاً من الليلِ غَيهَبا",10,"ب",2,0],["وَهَجَرتَ الرَبابَ مِن حُبِّ سُعدى","وَنَسيتَ الَّذي لَها كُنتَ قُلنا",11,"ن",2,0],["وَهُجومٌ عَلَيهِ غُرَّةُ نَصرٍ","وَنُجومٌ عَلَيهِ بُشرى سَلامَه",12,"م",2,0],["وَهَجيرُ الأَيّامِ مِنهُ مَقيلٌ","وَاللَيالي بِطيبِها أَسحارُ",13,"ر",1,0],["وَهَجَرْتُ الكِرامَ حتى شَكانِي","منهمُ كلُّ عاشِقٍ مَهْجورِ",14,"ر",1,0],["وَهَجرُ لَذَّةٍ حينٍ غَيرِ دائِمَةٍ","يَرُدُّ بِالمَنطِقِ المُتَفالَ مِعطارا",15,"ر",2,0],["وَهَجَّنَ لَذّاتِ المُلوكِ زَوالُها","كَما غَدَرَت بِالمُنذِرينَ الهَجائِنُ",16,"ن",1,0],["وهَجَرْنا شُرْبَ الكؤوسِ احْتقاراً","وشَرِبْنا مَسَرّةً بالدّنَانِ",17,"ن",1,0],["وهجانٍ على هجانٍ تأتي","ك عديد الحبوب في الأقواز",18,"ز",1,0],["وهَجيرَةٍ كالهَجْرِ موْجُ مَرابِها","كالبَحرِ ليس لمائها مِن طُحلُب",19,"ب",1,0],["وَهَجْرِي الْغَانِيَاتِ وَشُرْبَ كَأْسٍ","وَلُبْسِي جُبَّة ً لاَتُسْتَعَارُ",20,"ر",1,0],["وهجرنا الكؤوسَ لكن لعُرسٍ","هو اصفى كأساً واطيبُ أُنسا",21,"س",2,0],["وهجرت روضته فأصبح وردها","لليأس كالأشواك في أذغالها",22,"ل",3,0],["وهَجَرْتَ الناسَ حتّى","ساءَلُوا أين الأنيسُ",23,"س",1,0],["وَهَجَرْتَ الرَّبابَ مِنْ حُبِّ سُعْدَى","ونسيتَ الذي لها كنتَ قلتا",24,"ت",2,0]]}