],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79913","الخفيف"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141313","الرمل"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105433","الرمل"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177829","الكامل"],[2231,"","https://poetry.dctabudhabi.ae/diwan/poem/124053","الخفيف"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137000",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138466",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110110","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132129","الكامل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101390","الخفيف"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119606","البسيط"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105119","الخفيف"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147266","الكامل"],[4702,"سواليف المزون","https://www.poetsgate.com/ViewPoem.aspx?id=155105",""],[4926,"كيف يحصى عليك منا ثناء","https://www.poetsgate.com/ViewPoem.aspx?id=171114",""],[5038,"قطر الندى","https://www.poetsgate.com/ViewPoem.aspx?id=190095",""],[5183,"السِّمَات","https://www.poetsgate.com/ViewPoem.aspx?id=186460",""],[5213,"أشبه البدر طلعة وجمالا","https://www.poetsgate.com/ViewPoem.aspx?id=170532",""],[5358,"يا أم سالم","https://www.poetsgate.com/ViewPoem.aspx?id=202449",""],[5387,"الراقصة","https://www.poetsgate.com/ViewPoem.aspx?id=53792",""],[5444,"مجد القلم","https://www.poetsgate.com/ViewPoem.aspx?id=205506",""],[5864,"يا أبي","https://www.poetsgate.com/ViewPoem.aspx?id=190488",""],[5953,"طوس يا طوس لا عد مناك طوسا","https://www.poetsgate.com/ViewPoem.aspx?id=93790",""],[4442,"نزعت تخط بكل نفنف","https://www.poetsgate.com/ViewPoem.aspx?id=171225",""],[6237,"الليل والشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77881&r=&rc=23",""],[3984,"بابل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64407&r=&rc=13",""]],"verses":[["وَعَلِيٌّ وَاِبنُهُ الباقِرُ وَال","صادِقُ القَولِ وَموسى وَالرِضا",0,"ا",1,0],["وَعَلِيٌّ وَأَبوهُ وَاِبنُهُ","وَالَّذي يَنتَظِرُ القَومُ غَدا",0,"ا",1,0],["وعلى وجنتيه نارٌ أراني","إن تسلَّيتُ عن هواها شقيّا",1,"ي",2,0],["وعلى وجهيها نهار وليل","فهي لا تستغني عن الاضداد",2,"د",1,0],["وَعَلى وُجوهِ الثاكِلينَ كَآبَةٌ","وَعَلى وُجوهِ الثاكِلاتِ رُغامُ",3,"م",1,0],["وَعَلى وُجوهٍ كَالأَهِلَّةِ رُوِّعَت","بَعدَ السُفورِ بِبُرقُعٍ وَخِمارِ",4,"ر",1,0],["وعلى وجهك للبشرِ سنا","وعلى قَصْدِكَ للنّجْمِ ضَمان",5,"ن",1,0],["وعليٌّ وابن عمّارٍ هما","عُدَّةُ الحربِ لهولِ المأزق",6,"ق",1,0],["وعلى وجهٍ غزالٍ","أحورِ العين كحيل",7,"ل",1,0],["وَعَلى وَجهِكَ المُحَتَّتِ سيما","خَبَّرَتنا عَن اِستِهِ خَبُثَ اِستا",8,"ت",2,0],["وَعَلى وَجهِهِ الأَغَرِّ قَبولٌ","وَكَأَنَّ المَعروفَ فيهِ كِتابُ",9,"ب",1,0],["وَعَلى وَرزَنٍ هَجَمتَ المَنايا","وَالمَنايا في دورِهِم أَسرابُ",9,"ب",1,0],["وعلى ودٍّ وبرٍّ وهدى","لهمو فيها فراقٌ ولقاءْ",10,"ا",2,0],["وَعَلَى وجْهِكَ الْمُحَتَّتِ سِمَا","خبرتنا عن استه خبث استا",11,"ت",2,0],["وعلى وجهك في غيبته","من رحيق العشق والود شربتُ",12,"ت",1,0],["وعلى وجنا وفي مقلتنيا","بهجة العين من جمال الأزاهر",13,"ر",1,0],["وَعَلى وادي أُشيِّ سَرحَةٌ","تُجتَنى اللَوعَةُ مِن أَغصانِها",14,"ن",3,0],["وَعلى وُفورِ ثَرايَ لي وَلَها","ذلُّ الفَقير وعزَّةُ المُثري",15,"ر",2,0],["وَعَلى وَجهِكَ الصَبيحُ رَقيمٌ","بِصَفا قَلبِكَ الرَحيمُ تُحَرِّرُ",16,"ر",1,0],["وعلى واسِطَةِ النَّظمِ بهم","أَحمدُ القومِ الإمامَ الأَكبَرُ",17,"ر",1,0],["وَعَلِيٌّ وَجَعفَرٌ ذو الجَناحَي","نِ هُناكَ الوَصِيُّ وَالشُهَداءُ",18,"ا",2,0],["وَعَلى وَجنَتَيكِ ماءٌ ونارٌ","أم مِن الحُسنِ فيكِ ضِدٌّ وضِدُّ",19,"د",1,0],["وعلى وجوه الشعب ألف حكاية","تحكي لواعجها ويمُّ معانِ",20,"ن",1,0],["وعلى وليكم بمالي","لم أكن ألفي ضنينا",21,"ن",2,0],["وَعليٌّ وصِيُّه قاِصمُ الكُفْ","ر وَليْثُ الَهَياجِ والضِّرْغام",22,"م",1,0],["وعلى وجهك النقيّ شحوب","كالصبح النقيّ غام ضياه",23,"ا",2,0],["وعليٌ وهو من أهل الصفا","وقديم الود يا أكرم آل",24,"ل",1,0],["وَعَلى وُدَّكَ السَلامُ فَإِنّي","بِكَ مِن بَعدِها عَليمٌ خَبيرُ",25,"ر",1,0],["وعلى وجهِها إذا اغبرَّ جدباً","أنداهُ أم الغمامِ أدرُّ",26,"ر",1,0],["وعلى وجه الثّرى يحيا الألى","عفّروا من وطأة الذّل الجباها",27,"ا",3,0],["وعلى وجه الثرى جثمانه","وطأته الخيل حتى رضضا",28,"ض",2,0],["وعلى وجوههم البهية نضرة ال","إجلال موصول بها الإكرام",29,"م",1,0],["وعلى وجهها المنير سلام","مثل روض الخميلة المرهوم",30,"م",1,0],["وعلى وداد حبيبهم انا ثابت","وبشعر شبلي لي شذا وطلاء",31,"ا",2,0],["وعلى وجه الثرى جثمانه","عافر والرأس في السمر تراه",32,"ا",2,0],["وعلى وَلائك أَلِّفَنَّ قلوبنا","واسمَح لنا بالفوزِ والرُضوانِ",33,"ن",1,0],["وعلى وجوه نسائهم من نسجه","وعلى عقول رجالهن لثام",34,"م",1,0],["وعلى وجنتيك خط يراع ال","حسن حرفاً بمسكة الخال معجم",35,"م",1,0],["وعلّ يوماً ظلال النخل مجلسنا","في كرخنا وعلينا يسقط الرطبُ",36,"ب",1,0],["وعلى وجنتيه ماء ونار","وبمعسول فيه شهد وخمر",37,"ر",1,0],["وعلى وميض الوهم تبهرنا","فنظن أن العمر لم يزدِ",38,"د",1,0],["وْعلى وزنة هدب عينه مشفّر رقمها السري","ليا ارسلّي رماح الشوق فكّتها مضاريبه",39,"ب",2,0],["وعلى وجنتي قتادة سالت","ملقاه وما لفقأ دوآء",40,"ا",2,0],["وَعَلى وَجيبِ الرَّوعِ أُغْنِيَةٌ","تَنْسابُ مِنْ فِيها وَتَنْتَثِرُ",41,"ر",1,0],["وعلى (وامعةٍ) وقع القضا","بين أولى آيها والاخربات",42,"ت",1,0],["وعلى وجنتيه انسان عيني","لاح يوم اللقا فحالوه خالا",43,"ل",2,0],["وعَلى وحيدِكِ في الحَياةِ","مُصيبةٌ تتلو مُصيبَةْ",44,"ب",2,0],["وعلى وجوه السيدات سحابة","من غيرةٍ أو همهماتٍ من شرر",45,"ر",1,0],["وعلى وريقاتٍ بعَز","مٍ كان حلميَ يرتسم",46,"م",1,0],["وعلى وجهِكَ البشوشِ انعِكاسٌ","لنُفُوسٍ مُرَادُها في السَّمَاءِ",47,"ا",2,0],["وعلي وباقر العلم منهم","وكذا جعفر من بعد موسى",48,"س",2,0],["وعلى وريديه انتحى","بحسامه (شمر) فارهف",49,"ف",1,0],["وعليٌّ وطلحةٌ والمثنى","وأبو حفصَ والشهيدُ ابن ياسرْ",50,"ر",1,0],["وعلى وقعُ خطانا التفتت","أمم أغضت هواناً واكتئابا",51,"ب",2,0]]}