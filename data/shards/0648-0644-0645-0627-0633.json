{"poems":[[53,"كذا يهجم القدر الغالب","https://www.aldiwan.net/poem30740.html","المتقارب"],[63,"بني جشم ردوا فؤادي إنه","https://www.aldiwan.net/poem45683.html","الطويل"],[63,"إذا المزن أغفى والكلال يمسه","https://www.aldiwan.net/poem45829.html","الطويل"],[63,"أصاخ إلى الواشي فلباه إذ دعا","https://www.aldiwan.net/poem46191.html","الطويل"],[77,"تبلج بالشبيبة صبح شيبي","https://www.aldiwan.net/poem35721.html","الوافر"],[77,"لعل خيالا منك يطرق مضجعي","https://www.aldiwan.net/poem35993.html","الطويل"],[0,"ألا عم صباحاً أيها الطلل البالي","https://www.aldiwan.net/poem51.html","الطويل"],[88,"أرى الأيام ظامئة وليست","https://www.aldiwan.net/poem45005.html","الوافر"],[88,"هل الدهر إلا أعجمي أخاطبه","https://www.aldiwan.net/poem45012.html","الطويل"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"لي صاحب قد كنت آمل نفعه","https://www.aldiwan.net/poem8496.html","الكامل"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[14,"إلى حكم تناجل منسماها","https://www.aldiwan.net/poem38284.html","الوافر"],[89,"ولما سعى الساعون أن نهجر الوغى","https://www.aldiwan.net/poem45088.html","الطويل"],[85,"خطونا في الجهاد خطى فساحا","https://www.aldiwan.net/poem7108.html","الوافر"],[43,"تذكرت ما بين العذيب وبارق","https://www.aldiwan.net/poem9734.html","الطويل"],[62,"نصيحكما فيما يقول مريب","https://www.aldiwan.net/poem52505.html","الطويل"],[45,"بعينيك ضوء الأقحوان المفلج","https://www.aldiwan.net/poem62674.html","الطويل"],[66,"لثمت مقاطر أقلامه","https://www.aldiwan.net/poem38442.html","المتقارب"],[66,"رأيت طريق اليأس منكم بعيدة","https://www.aldiwan.net/poem38457.html","الطويل"],[66,"حويت الحمد إرثا واكتسابا","https://www.aldiwan.net/poem39044.html","الوافر"],[66,"ولما سطرت الطرس أشفق ناظري","https://www.aldiwan.net/poem40326.html","الطويل"],[80,"رويدك يا معذبة القلوب","https://www.aldiwan.net/poem31537.html","الوافر"],[69,"أيا علو دمع العين يغني عن الورد","https://www.aldiwan.net/poem28807.html","الطويل"],[74,"ألا هل أطل الأمير الأجل","https://www.aldiwan.net/poem13225.html","المتقارب"],[13,"ألا تلكما عرسي منيعة ضمنت","https://www.aldiwan.net/poem2198.html","الطويل"],[46,"أقاتلي الزمان قصاص عمد","https://www.aldiwan.net/poem22628.html","الوافر"],[46,"سباك الله يا دنيا عروسا","https://www.aldiwan.net/poem22964.html","الوافر"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/66002","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55154","المجتث"],[13,"وَلَمَّا سَمِعْتُ العَوْضَ تَدْعُو تَنَفَّرَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=180828",""],[13,"أَلاَ تِلْكُمَا عِرْسِي مَنِيعَةُ ضُمِّنَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=180795",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[113,"علمتم بأني مغرم بكم صب","https://www.aldiwan.net/poem41234.html","عموديه"],[118,"سأهدل كالحمائم في رياض","https://www.aldiwan.net/poem49286.html","الوافر"],[126,"عليكم وإن طال البعاد سلام","https://www.aldiwan.net/poem50501.html","الطويل"],[130,"أبرق ما لمحت له ائتلاقا","https://www.aldiwan.net/poem54791.html","الوافر"],[130,"لقاؤك يا عبد الإله هو الشفا","https://www.aldiwan.net/poem54799.html","الطويل"],[141,"ظلامة من أعدك لليالي","https://www.aldiwan.net/poem11796.html","الوافر"],[167,"أفي كل دار لي عدو أصاوله","https://www.aldiwan.net/poem1645.html",""],[187,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[210,"عنطنطة غنجاء غرثاء بضة","https://www.aldiwan.net/poem37849.html","الطويل"],[227,"أسرب مها عن أم سرب جنه","https://www.aldiwan.net/poem50754.html","المتقارب"],[227,"نعت بالبين غربان","https://www.aldiwan.net/poem50762.html","مجزوء الوافر"],[227,"أعذلا وما عذلتني النهى","https://www.aldiwan.net/poem51276.html","المتقارب"],[230,"علمتم بأني مغرم بكم صب","https://www.aldiwan.net/poem14836.html","الطويل"],[253,"فدى لكُما رجلي أمي وخالتي","https://www.aldiwan.net/poem709.html",""],[280,"إذا ما رأينا حسن وجه أبي الفتح","https://www.aldiwan.net/poem32823.html","الطويل"],[295,"وأبرزتها بطحاء مكة بعدما","https://www.aldiwan.net/poem33162.html","الطويل"],[302,"ألا يا نازلين على الكثيب","https://www.aldiwan.net/poem16770.html","الوافر"],[303,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[303,"أعيذ صفاء الود من كدر العتب","https://www.aldiwan.net/poem56604.html","الطويل"],[318,"أكذب طريفي فيك والطرف صادق","https://www.aldiwan.net/poem61752.html","الطويل"],[364,"قضى نحبه الصوم بعد المطال","https://www.aldiwan.net/poem17310.html","المتقارب"],[369,"ولما سألت الزمان الأمان","https://www.aldiwan.net/poem57042.html","المتقارب"],[369,"تولى بتهويمة الهائم","https://www.aldiwan.net/poem57151.html","المتقارب"],[402,"ولما سقاني صرف الهموم","https://www.aldiwan.net/poem49709.html","المتقارب"],[407,"أرى القلب أمسى بالأوانس مولعا","https://www.aldiwan.net/poem67492.html","الطويل"],[413,"محوت بسيف سطوتك الفسادا","https://www.aldiwan.net/poem53896.html","الوافر"],[413,"ليهنك ما بلغت من الأماني","https://www.aldiwan.net/poem54133.html","الوافر"],[413,"ألا إن هذا الفؤاد اضطرم","https://www.aldiwan.net/poem54173.html","المتقارب"],[426,"بما نلت يا من قد تسامى محامدا","https://www.aldiwan.net/poem39842.html","الطويل"],[426,"جمالك ليس يمنعه قناع","https://www.aldiwan.net/poem40059.html","الوافر"],[429,"علمنا وقد مات الكمال التساويا","https://www.aldiwan.net/poem12769.html","الطويل"],[438,"تسر النوى ما الحب أبداه معلنا","https://www.aldiwan.net/poem14322.html","الطويل"],[451,"حلمت ولم أعلم أحلمى يقظة","https://www.aldiwan.net/poem61799.html","الطويل"],[456,"أما وهواها عذرة وتنصلا","https://www.aldiwan.net/poem55919.html","الطويل"],[456,"سلا من سلا من بنا استبدلا","https://www.aldiwan.net/poem56005.html","المتقارب"],[456,"لمن صاغيات في الحبل طلائح","https://www.aldiwan.net/poem56246.html","الطويل"],[462,"أطاع فما إلى صبر سبيل","https://www.aldiwan.net/poem3168.html","عموديه"],[466,"إذا ما كان في بيتي رغيف","https://www.aldiwan.net/poem59931.html","الوافر"],[498,"أتانا الهوى العذري من حيث لا ندري","https://www.aldiwan.net/poem37700.html","الطويل"],[498,"هنيئا لعبد طيب الحب قلبه","https://www.aldiwan.net/poem37822.html","الطويل"],[513,"يا أسد الدين بدت حاجة","https://www.aldiwan.net/poem12124.html","السريع"],[513,"لله من يوم أغر مجمل","https://www.aldiwan.net/poem12208.html","الكامل"],[549,"هي الدار موقوف عليك بكاها","https://www.aldiwan.net/poem47143.html","الطويل"],[549,"هل الشيب إلا غصة في الحيازم","https://www.aldiwan.net/poem47203.html","الطويل"],[549,"أمن أجل أن أعفاك دهرك تطمع","https://www.aldiwan.net/poem47720.html","الطويل"],[549,"ألا هل أتاها كيف حزني بعدها","https://www.aldiwan.net/poem47860.html","الطويل"],[549,"أضن بنفسي عن هوى البيض كلما","https://www.aldiwan.net/poem48038.html","الطويل"],[560,"أمير المجد عبد الله أضحى","https://www.aldiwan.net/poem52615.html","الوافر"]],"verses":[["وَلَمّا سَبَقتَ عُيوبَ الرِجالِ","تَعَلَّلَ مِن بَعدِكَ العائِبُ",0,"ب",1,0],["ولم أَستَطِبْ شَمَّ العَرارِ ولا أَتى","بيَ الرَّملُ حبِّي أَهلَهُ سُقِيَ الرَّملُ",1,"ل",1,0],["وَلَم أَستَدِرَّ المُزنَ يَقدُمُ وَدقَهُ","بُرَيقٌ كَما يَفتَرُّ عَن سِقطِهِ الزِّندُ",2,"د",1,0],["ولَم أستَفِدْ منْ نَظْمِها غيْرَ حاسِدٍ","إذا ما رَمى لم يُبْقِ في القَوْسِ مِنْزَعا",3,"ع",2,0],["ولمْ أسْتُرْ بُدورَ الصُّبْحِ جَهْلاً","وهلْ يَخْفى الصّباحُ إذا تجلّى",4,"ل",2,0],["ولمّا سرَتْ واللّيلُ قدْ مالَ وانقَضَى","وأعْجَلَها ضَوْءُ الصّباحِ المُلمَّعِ",5,"ع",1,0],["وَلَم أَسبَإِ الزِقَّ الرَويَّ وَلَم أَقُل","لِخَيلِيَ كُرّي كَرَّةً بَعدَ إِجفالِ",6,"ل",1,0],["ولما سرت في جبل وسهل","وكابدت السمائم والعرِيا",7,"ر",3,0],["ولم أستشر في الناس إلاّ تجاربي","وهل يَصْدُق الأنسانَ إلاّ تجاربه",8,"ب",2,0],["ولَمَا سرَّ جائعاً رِفْدُ كفٍّ","أَطعمتْه من شِلْوهِ أعضاءَ",9,"ا",2,0],["ولم أُسْقَها بل ساقَها لمكيدتي","تَحامُق دهرٍ جَدَّ بي كالمُلاعبِ",10,"ب",1,0],["ولَما سألتُ زمانَهُ إعناتَهُ","لكن سألتُ زمانه تأديبَهُ",11,"ب",2,0],["وَلَم أُسائِلِ كَوكَباً طالِعاً","مالَكَ تَبدو وَلِماذا تَغيب",12,"ب",1,0],["وَلَم أَسأَلكِ شَيئاً قَبلَ هاتي","وَلَكِنّي عَلى أَثَرِ الدَليلِ",13,"ل",1,0],["ولما سعى الساعون أن نهجر الوغى","ونمنح للمغلوب من فضلنا مهلا",14,"ل",2,1],["ولما سلّت البيض المواضي","تقلدنا لها الحق الصراحا",15,"ح",2,0],["وَلَمّا سَقى الغَيثَ الَّذي كَفَروا بِهِ","سَقى غَيرَهُ في غَيرِ تِلكَ البَوارِقِ",16,"ق",1,0],["ولما سما للبغي ثانِيَ عِطْفِه","طَموعٌ لأقصَى ما يُرامُ طَلوبُ",17,"ب",1,0],["وَلَم أَسرِ في أَعراضِ قَومٍ أَعِزَّةٍ","سُرى النارِ شُبَّت في أَلاءٍ وَعَرفَجِ",18,"ج",1,0],["ولم أستطع بعد نشر الثنا","ء إلا الدعاء لأيامه",19,"ه",1,0],["ولما سلكنا عمق حارم وصلكم","رأينا الطريق الصعب والمسلك الوعرا",20,"ر",2,0],["وَلَمّا ساقَنا نَظمٌ بَديعٌ","يَسَرُّ النَفسَ خَطّاً أَو خِطابا",21,"ب",2,0],["وَلَمّا سَطَرتُ الطِرسَ أَشفَقَ ناظِري","وَقالَ لِطِرسي سَوفَ أَمحوكَ بِالهَطلِ",22,"ل",1,1],["ولم أسمع بأنّ عيونَ عِينٍ","تُفيضُ سهامَهُنَّ على القلوبِ",23,"ب",1,0],["ولم أستطعْ حملَ النسيمِ رسالتي","مخافةَ رجعاه برائحةِ الندِ",24,"د",1,0],["وَلَمّا سَقى الغَربَ فيما سَقى","وَحَلَّ بِهِ الغَربُ مِمّا أَقَل",25,"ل",1,0],["وَلَمّا سَمِعتُ العَوصَ تَدعو تَنَفَّرَت","عَصافيرُ رَأسي مِن بَواً فَعَوايِنا",26,"ن",2,0],["وَلَم أَسفِك دِماءَهُمُ وَلَكِن","عَرَفتُ شُؤونَهُم كَشفاً وَسَبرا",27,"ر",2,0],["وَلَم أَستَغلِ مِنكَ فِداءَ نَفسي","بِشَيءٍ فَاِعجِبي لِرَقوءِ دَمَعي",28,"ي",1,0],["ولمَّا سألْتُ الرِّيحَ عنها أجابَني","تَلَقَّفَها سَيْلُ القَضا والنَّوائبُ",29,"ب",1,0],["ولَمْ أَسُمْكِ عِنَاءً","إِجَابَةً أَوْ سُؤُالاَ",30,"ل",2,0],["وَلَمَّا سَمِعْتُ العَوْضَ تَدْعُو تَنَفَّرَتْ","عَصَافِيرُ رَأْسِي مِنْ نَوىً وَتَوَانِيَا",31,"ي",2,1],["وَلَما سَمِعْتُ العَوْصَ تَدْعُو تَنعَّرتْ","عَصَافِيرُ رَأسِي مِنْ غُوَاةِ فَراتِنَا",32,"ن",2,0],["ولم استباحَ \" الوغدُ \" حُرمةَ من سَقى","هذي الديارَ دماً زكِيّاً سارِبا",33,"ب",2,0],["ولما سكنت القلب لم يبق موضع","سقيم به الا وادركه طب",34,"ب",1,0],["ولم أسى على قوم أسفت","بهم أحلامهم دون النعال",35,"ل",1,0],["ولما سمعنا أنكم قد نصبتمُ","إماماً سُرِرْنا والسرور لِزامُ",36,"م",1,0],["ولَم أسطَع وَدَاعاً غَيرَ وَمءٍ","بِطَرفٍ قَد رَمَيتُ بِهِ إستِرَاقَا",37,"ق",2,0],["ولَم أستَطِب مِن بَعدِكَ لَذَّةً","ولَم أُرَ إِلاَّ حَائِراً مُتَأسِّفَا",38,"ف",2,0],["وَلَمّا سيلَ فِيَّ وَفاضَ جوداً","أَحالَ عَلى التَعَلُّلِ وَالمِطالِ",39,"ل",1,0],["وَلَم أَسَتشِر قَلبي عَلى بَتِّ حَبلِهِ","مِنَ اليَأسِ إِلّا كادَ لُبّي يُزايِلُه",40,"ل",2,0],["وَلَم أَستَمِع دَعواهُ إلّا مقتّهُ","وَإلّا قرأتُ الحمقَ في وجههِ سطرا",41,"ر",2,0],["ولما سَعَتْ رجلاي في موطئ الثَّرى","تَكَاثَرَ في الأرضِ الحَيا والفَضائِلُ",42,"ل",1,0],["ولمّا سَفَرْن صَبَغْنَ الضُّحا","بماءِ الخدودِ وتَوْرِيدِهِنّه",43,"ن",2,0],["ولمَا سارتِ البُزْلُ","بِهمْ والليلُ نَوْمانُ",44,"ن",1,0],["ولم أستشْر في مُلمٍّ يَنوبُ","مشيراً أَرى منه ما لا أَرى",45,"ا",1,0],["وَلَمّا سَكَنتَ القَلبَ لَم يَبقَ مَوضِعٌ","بِجِسمِيَ إِلّا وَدَّ لَو أَنَّه قَلبُ",46,"ب",1,0],["وَلَمَّا سَمِعْتُ الخَيْلَ تَدعو مُقاعِساً","تَطالَعَنِي مِن ثُغرَةِ النَّحْرِ جائِرُ",47,"ر",1,0],["وَلَمّا سَعى في الخَدِّ نَملُ عِذارِهِ","تعوَّضَ حَبّاتِ القُلوبِ عَنِ القَمحِ",48,"ح",1,0],["وَلَمّا سرت للركب نفحةُ طيبها","تغنّى لها حاديهُمُ وترنَّما",49,"م",2,0],["وَلَم أَسلوكُم يا أَهلِ وُدّي","فَلا تَصغوا لِإِرجافِ الكَذوبِ",50,"ب",1,0],["وَلَمّا سَما للملكِ غير معرّجٍ","عَلى غيرِ مَن مِن عندهِ النصرُ يُستبطا",51,"ط",2,0],["وَلَم أَستَجِز إرجاءها لتأنّقٍ","عَلى وفق ما أرضى لمدحك من نحبِ",52,"ب",1,0],["وَلَم أَسكُنِ الأَرضَ الَّتي تَسكُنيها","وَما ذاكَ أُذُني مِن شَيءٍ لَهُ كُنتُ أَفزَعُ",53,"ع",1,0],["وَلَم أَستَغِث تَحتَ ظِلِّ الخُطو","بِ جَرجَرَةَ البُزلِ تَحتَ الرِحالِ",54,"ل",1,0],["ولمَّا سَألتُ الزَّمانَ الأما","نَ ولم يَكُ يقبلُ مُستَأمِنا",55,"ن",2,1],["ولما سَمِعتُ بهِ حازِماً","أتَيتُ بِها فُرصَةَ الحازِمِ",56,"م",1,0],["ولّما سَقاني صِرْفَ الهُمومِ","وصِرفَ المَصائبِ صَرْفُ الزَّمانِ",57,"ن",1,1],["وَلَمّا سَرى الهَمُّ الغَريبُ قَرَيتُهُ","قِرى مَن أَزالَ الشَكَّ عَنهُ وَأَزمَعا",58,"ع",2,0],["ولمَّا ساءَت الأَحوال فيهم","ولا نَفَعَ الحِفاظُ ولا أفادا",59,"د",2,0],["ولم أسمَعْ مقالاً فيك إلاَّ","مقالَ الخير آناً بعد آن",60,"ن",1,0],["ولما سرى موهِناً في الدجى","بكيت له عن جوىً وابتسمْ",61,"م",1,0],["ولما سموت المجد قال مؤرخٌ","وعدلية الأحكام صارم راقيا",62,"ي",2,0],["ولم أسألك عن قلبٍ رهينٍ","لديك فقد تناوله الضياعُ",63,"ع",1,0],["ولما سرى بي نحوَه الوجدُ قاعِداً","ولم أستطِعْ عَقْراً عقرتُ القوافيا",64,"ي",2,0],["ولما سعينا بالصفاء ومروة","وبالعلمين الخضر جزنا بلا ونى",65,"ن",2,0],["ولم أستطع تفسيره من تجاربي","ولا من مناجاتي لشهبٍ وأجرام",66,"م",1,0],["ولما سعَى الساعي فجاءك كاذباً","عليَّ بجَوْرٍ كنتَ أعلَى وأعدلا",67,"ل",2,0],["ولما سرى أمرُ تيم أطا","ل بيتُ عديٍّ لها الأحبلا",68,"ل",2,0],["ولم أستزدْ نُعماك إلا ضرورةً","وقد تُستزادُ المزنُ وهي دوالحُ",69,"ح",1,0],["ولما سار عنها قيل كادت","تصاحبه الخزونة والسهول",70,"ل",1,0],["وَلَم أَسحَب لِثَوبِ القَصدِ ذَيلاً","وَلَو سَحَبَ الطَوى جِسمي لِرَمسي",71,"س",2,0],["ولمّا سَرى الحادي وَغَنَّى بِنَعتِكُم","شَرِبنَا منَ الأَلفاظِ باعِثَةَ السُّكرِ",72,"ر",1,0],["ولمَّا سَرَيْنا والدَّياجي طَموسَةٌ","وللطَّيرِ ما بينَ الغُصونِ زِجَالُ",73,"ل",1,0],["ولم أسم وجه القوافي بها","رفعاً لمقدارك عن قدرها",74,"ر",3,0],["ولما سمعت بأرض مصر قائلاً","إن النبي الطهر نص على علي",75,"ل",2,0],["ولمّا سَرَتْ لم تخشَ وَهْناً ضلالةً","ولا عرف العُذّالُ كيف سُراها",76,"ا",3,0],["ولمّا سقانِيهِ الزّمانُ شربتُهُ","كما أُوجِرَ المَأْسورُ مُرَّ العلاقمِ",77,"م",1,0],["ولم أسْلُهُ لكنْ تجلّدت كي يرى","شَموتٌ بِحُزْنِي أنّ صدرِيَ أوسعُ",78,"ع",1,0],["وَلَم أَستطعْ في رُزْئِها عَطَّ مُهجتِي","وأجللتُه عن أنْ أُمزِّق بُردَها",79,"د",3,0],["ولمّا سقاني الدّهرُ صِرْفاً صروفَهُ","كِرَعتُ شراباً لا يَلَذّ لشارِبِهْ",80,"ب",2,0],["ولمَّا سارَ نحوَ العرشِ فوراً","ونالَ المجدَ في دارِ البَقاءِ",81,"ا",2,0]]}