],[5212,"شموخُ العلم","https://www.poetsgate.com/ViewPoem.aspx?id=212107",""],[5278,"يا زوجُ ، يومُكَ قد حَلَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=202550",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[5431,"تاء الأنوثة !","https://www.poetsgate.com/ViewPoem.aspx?id=207717",""],[5596,"الكيذاوي","https://www.poetsgate.com/ViewPoem.aspx?id=206478",""],[5616,"آسام","https://www.poetsgate.com/ViewPoem.aspx?id=204837",""],[5655,"تحيّةُ ربّي كلَّ يومٍ مجدَّدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=107216",""],[5691,"شدّوا الحزام...!","https://www.poetsgate.com/ViewPoem.aspx?id=207057",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5956,"سارقُ الطبيعة","https://www.poetsgate.com/ViewPoem.aspx?id=183309",""],[5956,"ولم يك فيها سوى وسختينِ","https://www.poetsgate.com/ViewPoem.aspx?id=193852",""],[5724,"أحجاج بيت الله ألف تحية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55154&r=&rc=21",""],[6202,"وقفة رجاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86759&r=&rc=60",""],[4960,"محاولة للتي لن تعود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87991&r=&rc=3",""],[6251,"أتيتك بالبشر لا بالعزاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76474&r=&rc=14",""],[6327,"مَرْثيّةُ الغَريب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86570&r=&rc=5",""]],"verses":[["وَلَمّا سَبَقتَ عُيوبَ الرِجالِ","تَعَلَّلَ مِن بَعدِكَ العائِبُ",0,"ب",1,0],["ولم أَستَطِبْ شَمَّ العَرارِ ولا أَتى","بيَ الرَّملُ حبِّي أَهلَهُ سُقِيَ الرَّملُ",1,"ل",1,0],["وَلَم أَستَدِرَّ المُزنَ يَقدُمُ وَدقَهُ","بُرَيقٌ كَما يَفتَرُّ عَن سِقطِهِ الزِّندُ",2,"د",1,0],["ولَم أستَفِدْ منْ نَظْمِها غيْرَ حاسِدٍ","إذا ما رَمى لم يُبْقِ في القَوْسِ مِنْزَعا",3,"ع",2,0],["ولمْ أسْتُرْ بُدورَ الصُّبْحِ جَهْلاً","وهلْ يَخْفى الصّباحُ إذا تجلّى",4,"ل",2,0],["ولمّا سرَتْ واللّيلُ قدْ مالَ وانقَضَى","وأعْجَلَها ضَوْءُ الصّباحِ المُلمَّعِ",5,"ع",1,0],["وَلَم أَسبَإِ الزِقَّ الرَويَّ وَلَم أَقُل","لِخَيلِيَ كُرّي كَرَّةً بَعدَ إِجفالِ",6,"ل",1,0],["ولما سرت في جبل وسهل","وكابدت السمائم والعرِيا",7,"ر",3,0],["ولم أستشر في الناس إلاّ تجاربي","وهل يَصْدُق الأنسانَ إلاّ تجاربه",8,"ب",2,0],["ولَمَا سرَّ جائعاً رِفْدُ كفٍّ","أَطعمتْه من شِلْوهِ أعضاءَ",9,"ا",2,0],["ولم أُسْقَها بل ساقَها لمكيدتي","تَحامُق دهرٍ جَدَّ بي كالمُلاعبِ",10,"ب",1,0],["ولَما سألتُ زمانَهُ إعناتَهُ","لكن سألتُ زمانه تأديبَهُ",11,"ب",2,0],["وَلَم أُسائِلِ كَوكَباً طالِعاً","مالَكَ تَبدو وَلِماذا تَغيب",12,"ب",1,0],["وَلَم أَسأَلكِ شَيئاً قَبلَ هاتي","وَلَكِنّي عَلى أَثَرِ الدَليلِ",13,"ل",1,0],["ولما سعى الساعون أن نهجر الوغى","ونمنح للمغلوب من فضلنا مهلا",14,"ل",2,1],["ولما سلّت البيض المواضي","تقلدنا لها الحق الصراحا",15,"ح",2,0],["وَلَمّا سَقى الغَيثَ الَّذي كَفَروا بِهِ","سَقى غَيرَهُ في غَيرِ تِلكَ البَوارِقِ",16,"ق",1,0],["ولما سما للبغي ثانِيَ عِطْفِه","طَموعٌ لأقصَى ما يُرامُ طَلوبُ",17,"ب",1,0],["وَلَم أَسرِ في أَعراضِ قَومٍ أَعِزَّةٍ","سُرى النارِ شُبَّت في أَلاءٍ وَعَرفَجِ",18,"ج",1,0],["ولم أستطع بعد نشر الثنا","ء إلا الدعاء لأيامه",19,"ه",1,0],["ولما سلكنا عمق حارم وصلكم","رأينا الطريق الصعب والمسلك الوعرا",20,"ر",2,0],["وَلَمّا ساقَنا نَظمٌ بَديعٌ","يَسَرُّ النَفسَ خَطّاً أَو خِطابا",21,"ب",2,0],["وَلَمّا سَطَرتُ الطِرسَ أَشفَقَ ناظِري","وَقالَ لِطِرسي سَوفَ أَمحوكَ بِالهَطلِ",22,"ل",1,1],["ولم أسمع بأنّ عيونَ عِينٍ","تُفيضُ سهامَهُنَّ على القلوبِ",23,"ب",1,0],["ولم أستطعْ حملَ النسيمِ رسالتي","مخافةَ رجعاه برائحةِ الندِ",24,"د",1,0],["وَلَمّا سَقى الغَربَ فيما سَقى","وَحَلَّ بِهِ الغَربُ مِمّا أَقَل",25,"ل",1,0],["وَلَمّا سَمِعتُ العَوصَ تَدعو تَنَفَّرَت","عَصافيرُ رَأسي مِن بَواً فَعَوايِنا",26,"ن",2,0],["وَلَم أَسفِك دِماءَهُمُ وَلَكِن","عَرَفتُ شُؤونَهُم كَشفاً وَسَبرا",27,"ر",2,0],["وَلَم أَستَغلِ مِنكَ فِداءَ نَفسي","بِشَيءٍ فَاِعجِبي لِرَقوءِ دَمَعي",28,"ع",2,0],["ولَمْ أَسْرِ في قَوْمٍ كِرَامٍ أَعِزَّةٍ","غَطَارِفَةٍ شُمِّ العَرَانِين مِنْ كَلْبِ",29,"ب",1,0],["ولمَّا سألْتُ الرِّيحَ عنها أجابَني","تَلَقَّفَها سَيْلُ القَضا والنَّوائبُ",30,"ب",1,0],["ولَمْ أَسُمْكِ عِنَاءً","إِجَابَةً أَوْ سُؤُالاَ",31,"ل",2,0],["ولما سمعنا انفجار الشعوب","أفقنا نرى الفجر قبل طلوع",32,"ع",1,0],["وَلَمَّا سَمِعْتُ العَوْضَ تَدْعُو تَنَفَّرَتْ","عَصَافِيرُ رَأْسِي مِنْ نَوىً وَتَوَانِيَا",33,"ي",2,1],["وَلَما سَمِعْتُ العَوْصَ تَدْعُو تَنعَّرتْ","عَصَافِيرُ رَأسِي مِنْ غُوَاةِ فَراتِنَا",34,"ن",2,0],["ولم استباحَ \" الوغدُ \" حُرمةَ من سَقى","هذي الديارَ دماً زكِيّاً سارِبا",35,"ب",2,0],["ولما سكنت القلب لم يبق موضع","سقيم به الا وادركه طب",36,"ب",1,0],["ولم أسى على قوم أسفت","بهم أحلامهم دون النعال",37,"ل",1,0],["ولما سمعنا أنكم قد نصبتمُ","إماماً سُرِرْنا والسرور لِزامُ",38,"م",1,0],["ولَم أسطَع وَدَاعاً غَيرَ وَمءٍ","بِطَرفٍ قَد رَمَيتُ بِهِ إستِرَاقَا",39,"ق",2,0],["ولَم أستَطِب مِن بَعدِكَ لَذَّةً","ولَم أُرَ إِلاَّ حَائِراً مُتَأسِّفَا",40,"ف",2,0],["وَلَمّا سيلَ فِيَّ وَفاضَ جوداً","أَحالَ عَلى التَعَلُّلِ وَالمِطالِ",41,"ل",1,0],["وَلَم أَسَتشِر قَلبي عَلى بَتِّ حَبلِهِ","مِنَ اليَأسِ إِلّا كادَ لُبّي يُزايِلُه",42,"ل",2,0],["وَلَم أَستَمِع دَعواهُ إلّا مقتّهُ","وَإلّا قرأتُ الحمقَ في وجههِ سطرا",43,"ر",2,0],["ولما سَعَتْ رجلاي في موطئ الثَّرى","تَكَاثَرَ في الأرضِ الحَيا والفَضائِلُ",44,"ل",1,0],["ولمّا سَفَرْن صَبَغْنَ الضُّحا","بماءِ الخدودِ وتَوْرِيدِهِنّه",45,"ن",2,0],["ولمَا سارتِ البُزْلُ","بِهمْ والليلُ نَوْمانُ",46,"ن",1,0],["ولم أستشْر في مُلمٍّ يَنوبُ","مشيراً أَرى منه ما لا أَرى",47,"ا",1,0],["وَلَمّا سَكَنتَ القَلبَ لَم يَبقَ مَوضِعٌ","بِجِسمِيَ إِلّا وَدَّ لَو أَنَّه قَلبُ",48,"ب",1,0],["وَلَمَّا سَمِعْتُ الخَيْلَ تَدعو مُقاعِساً","تَطالَعَنِي مِن ثُغرَةِ النَّحْرِ جائِرُ",49,"ر",1,0],["وَلَمّا سَعى في الخَدِّ نَملُ عِذارِهِ","تعوَّضَ حَبّاتِ القُلوبِ عَنِ القَمحِ",50,"ح",1,0],["وَلَمّا سرت للركب نفحةُ طيبها","تغنّى لها حاديهُمُ وترنَّما",51,"م",2,0],["وَلَم أَسلوكُم يا أَهلِ وُدّي","فَلا تَصغوا لِإِرجافِ الكَذوبِ",52,"ب",1,0],["وَلَمّا سَما للملكِ غير معرّجٍ","عَلى غيرِ مَن مِن عندهِ النصرُ يُستبطا",53,"ط",2,0],["وَلَم أَستَجِز إرجاءها لتأنّقٍ","عَلى وفق ما أرضى لمدحك من نحبِ",54,"ب",1,0],["وَلَم أَسكُنِ الأَرضَ الَّتي تَسكُنيها","وَما ذاكَ أُذُني مِن شَيءٍ لَهُ كُنتُ أَفزَعُ",55,"ع",1,0],["وَلَم أَستَغِث تَحتَ ظِلِّ الخُطو","بِ جَرجَرَةَ البُزلِ تَحتَ الرِحالِ",56,"ل",1,0],["ولمَّا سَألتُ الزَّمانَ الأما","نَ ولم يَكُ يقبلُ مُستَأمِنا",57,"ن",2,1],["ولما سَمِعتُ بهِ حازِماً","أتَيتُ بِها فُرصَةَ الحازِمِ",58,"م",1,0],["ولّما سَقاني صِرْفَ الهُمومِ","وصِرفَ المَصائبِ صَرْفُ الزَّمانِ",59,"ن",1,1],["وَلَمّا سَرى الهَمُّ الغَريبُ قَرَيتُهُ","قِرى مَن أَزالَ الشَكَّ عَنهُ وَأَزمَعا",60,"ع",2,0],["ولمَّا ساءَت الأَحوال فيهم","ولا نَفَعَ الحِفاظُ ولا أفادا",61,"د",2,0],["ولم أسمَعْ مقالاً فيك إلاَّ","مقالَ الخير آناً بعد آن",62,"ن",1,0],["ولما سرى موهِناً في الدجى","بكيت له عن جوىً وابتسمْ",63,"م",1,0],["ولما سموت المجد قال مؤرخٌ","وعدلية الأحكام صارم راقيا",64,"ي",2,0],["ولم أسألك عن قلبٍ رهينٍ","لديك فقد تناوله الضياعُ",65,"ع",1,0],["ولما سرى بي نحوَه الوجدُ قاعِداً","ولم أستطِعْ عَقْراً عقرتُ القوافيا",66,"ي",2,0],["ولما سعينا بالصفاء ومروة","وبالعلمين الخضر جزنا بلا ونى",67,"ن",2,0],["ولم أستطع تفسيره من تجاربي","ولا من مناجاتي لشهبٍ وأجرام",68,"م",1,0],["ولما سعَى الساعي فجاءك كاذباً","عليَّ بجَوْرٍ كنتَ أعلَى وأعدلا",69,"ل",2,0],["ولما سرى أمرُ تيم أطا","ل بيتُ عديٍّ لها الأحبلا",70,"ل",2,0],["ولم أستزدْ نُعماك إلا ضرورةً","وقد تُستزادُ المزنُ وهي دوالحُ",71,"ح",1,0],["ولما سار عنها قيل كادت","تصاحبه الخزونة والسهول",72,"ل",1,0],["وَلَم أَسحَب لِثَوبِ القَصدِ ذَيلاً","وَلَو سَحَبَ الطَوى جِسمي لِرَمسي",73,"س",2,0],["ولمّا سَرى الحادي وَغَنَّى بِنَعتِكُم","شَرِبنَا منَ الأَلفاظِ باعِثَةَ السُّكرِ",74,"ر",1,0],["ولمَّا سَرَيْنا والدَّياجي طَموسَةٌ","وللطَّيرِ ما بينَ الغُصونِ زِجَالُ",75,"ل",1,0],["ولم أسم وجه القوافي بها","رفعاً لمقدارك عن قدرها",76,"ر",3,0],["ولما سمعت بأرض مصر قائلاً","إن النبي الطهر نص على علي",77,"ل",2,0],["ولمّا سَرَتْ لم تخشَ وَهْناً ضلالةً","ولا عرف العُذّالُ كيف سُراها",78,"ا",3,0],["ولمّا سقانِيهِ الزّمانُ شربتُهُ","كما أُوجِرَ المَأْسورُ مُرَّ العلاقمِ",79,"م",1,0],["ولم أسْلُهُ لكنْ تجلّدت كي يرى","شَموتٌ بِحُزْنِي أنّ صدرِيَ أوسعُ",80,"ع",1,0],["وَلَم أَستطعْ في رُزْئِها عَطَّ مُهجتِي","وأجللتُه عن أنْ أُمزِّق بُردَها",81,"د",3,0],["ولمّا سقاني الدّهرُ صِرْفاً صروفَهُ","كِرَعتُ شراباً لا يَلَذّ لشارِبِهْ",82,"ب",2,0],["ولمَّا سارَ نحوَ العرشِ فوراً","ونالَ المجدَ في دارِ البَقاءِ",83,"ا",2,0],["ولما سرت عنها القناع متيم","تروح منها العنبري متيما",84,"م",2,1],["وَلما ساءَنا مِن غَير قَصد","كَما طَلب بشرّ حكم",85,"م",1,0],["وَلما سَما بالامتياز وَأَشرَقَت","كَواكبه بِالسَعد وَاِنحَط حاسد",86,"د",1,0],["ولم أستفد غير صبرٍ على ال","هموم وعلم بها واعتيادْ",87,"د",1,0],["وَلَمّا سَرى نَملُ العِذارِ بِخَدِّهِ","فَقُلتُ لَهُ ما أَنتَ أَوّلُ ساري",88,"ي",1,1],["وَلَمّا سَريتَ إِلى القدسِ تَبغي","زِيارَتَهُ نِلتَ برَّ الكريمِ",89,"م",1,1],["ولم أستفد غير ما قد جمعت","لقيل هو العالم المقنع",90,"ع",1,0],["ولمْ أسأل الدربَ أن تنتهي","ومَنْ يسلكُ الدربَ لنْ يَسْألا",91,"ل",2,0],["وَلَمَّا سَقَانَا مِنْ لّذِيذِ شَرَابِهِ","كَلاَنَا جَمِيعاً حِينَ لُذْنَا بِبَابهِ",92,"ه",1,0],["وَلَم أَسكُنِ الأَرضَ الَّتي تَسكُنينَها","لِكَي لا يَقولوا صابِرٌ لَيسَ يَجزَعُ",93,"ع",1,0],["ولما سرت في النفس زكت وطهرت","وطارت بروح البر في منهج البر",94,"ر",1,0],["وَلَمَّا سَقَتْنِيهِ حُدِدْتُ بِلَحْظِهَا","وَمَنْ يَشْرَبِ الصَّهْبَاءَ يَلْزَمُهُ الحَدُّ",95,"د",1,0],["ولما سرت أخباره للعدى نأت","ومن بعد أن كانوا تدانوا تأخّروا",96,"ر",3,0],["ولم أَسْتَثِرْ لِلْمَجْدِ كلَّ سَمَيْدَعٍ","له القَتْلُ دِينٌ والحُسامُ إِمامُ",97,"م",1,0],["وَلَم أَسحَب ذُيولي في التَصابي","وَلَم أَطرَب بِغانِيَةٍ رَداحِ",98,"ح",1,0],["ولما سرت للمأزمين قلائص","تطوي بأديها الفلاة وتقطع",99,"ع",1,0],["ولمَّا سرى الناعي بكم فاستفزَّني","ونادى منادي البين أنْ لا تدانيا",100,"ي",2,0],["ولم أُسهِرِ الفِتيانَ ليلَ مَلَذَّةٍ","طويلاً ألا يا رُبَّ ليلٍ قد اسأما",101,"م",2,0],["وَلَمْ اسْكُنِ الأرْضَ التِي تَسْكُنِينَهَا","لَئِلاَّ يَقُولُوا صَابِرٌ لَيْسَ يَجْزَعُ",102,"ع",1,0],["ولما سرى جنده نحوها","تزلزلت الأرض زلزالها",103,"ل",3,0],["ولمَّا سما فوق السماك بهمَّةٍ","يغضُّ لها طَرفُ الحسودِ ويُطرَفُ",104,"ف",1,0],["ولما سمعت الركب حنت حداته","وهي جلدي من هول ما أنا سامعه",105,"ع",2,0],["ولما سمعتُ الحاديينِ ترنّما","وَقائلهم وَالعيسُ تُحدى بهم حُثُّوا",106,"ث",3,1],["ولم أَسْتَكِنْ للحادثات وإِنَّما","صَبَرتُ لطاريها فثابَ وزَالا",107,"ل",2,0],["ولما سألتُ البانَ عنه تلاطمت","اماليدُهُ تحكي جوانح ثكلان",108,"ن",1,0],["ولم أسَلْ في هَوَاهُمْ إِنْ هَوَتْ وسَطَتْ","عليَّ من نائباتِ الدهرِ أهوالُ",109,"ل",1,0],["ولما سقيناها العكيس تمذحت","خصواصرها وازداد رشحاً وريدها",110,"ه",2,1],["ولما سألتُ الله عوناً على الذي","يكلفني من فرضِه كان في عَوني",111,"ن",2,0],["ولم استتم الدين أوفى نصابه","وشِيدَت مبانيه وأحكم سوره",112,"ر",2,0],["ولما سريَنا الرمل رمل عنيزةٍ","وصار فريقٌ مُشئمون ومُعْرق",113,"ق",1,0],["ولم أسكنِ الأرض التي تسكنونها","لئلا يقولوا إنني بِكَ مولعُ",114,"ع",1,0],["ولم أسمع غليظ القول ممن","وظيفته يخاطبني بلين",115,"ن",1,0],["ولم أستطع أن أهن عزّ منصبي","وأجمع مالاً لست منه أنيل",116,"ل",1,0],["ولم أستطع إلا الوفاء لغادرٍ","ويا ليتني لما وفيت له رفق",117,"ق",1,0],["وَلَم أَسألك إِلا النَزر إِني","بِذاك النزر مغتبطٌ وَراضِ",118,"ض",1,0],["وَلَم أَسمَع غِناءً مِن خَليلٍ","وَصَوتَ مُقَرطَقٍ خَلَعَ العِذارا",119,"ر",2,0],["وَلَما سَرَى مِن أَرض طيبةَ طَيِّباً","مجابَ دعاءٍ بالإفاضة حال",120,"ل",1,1],["ولم أستثر حرب الفجار ولم أُطع","مسيلمةً إذ رام آلفة الحجبِ",121,"ب",1,0],["ولم أستفد شيئاً من الغيد ما عدا","ضمائرهن المتعبات لدى الوزن",122,"ن",1,1],["ولم اسعَ نحو المال إلا لعيشةٍ","وما المال لو أمّنت في غيره الرزقا",123,"ق",2,0],["وَلما سَأَلتُ النَّفسَ ما الدَّهرُ فاعِلٌ","بِحَشدِ أَمانينا أَجابَت أَنا الدَّهرُ",124,"ر",1,0],["ولما سقط المجد المعلى","جذبوا ضبعه",125,"ع",2,0],["ولما سرت العيس","بهم يوم اللوى تخدي",126,"د",2,0],["ولما سرت سيرته","غدوت عميد كل سري",127,"ر",2,0],["ولم أستوف قدرك إذ","غلا قدري على قدري",127,"ر",2,0],["ولما سرت في سرهم بسروها","تطهرت الأرواح من دنس الرجس",128,"س",1,0],["ولما سئمناه غدا مثل حائر","بسقط اللوى بين الدخول فحومل",129,"ل",1,0],["ولمّا سرى الرَّكْبُ الحِجازيُّ لم نزَلْ","نُردِّدُ لوْ تُجْدي عَسى ولعلَّما",130,"م",2,0],["وَلما سَما قَدراً عَلى هامَة النُهى","وَعَمت لَهُ في العالَمينَ مَكارِم",131,"م",1,0],["ولم أستطع مدحاً اليك وانما","أقول مقالا لم أكن فيه بالغالي",132,"ل",2,0],["ولما سلبت الغي منها كسوتها","ينسج العوالي ارجو انا وعندما",133,"م",2,0],["ولما سألت الله برءا من الضنى","سمعت دوي الرعد قد زلزل القفرا",134,"ر",2,0],["ولما سرهم أن يشهدوا","كل يومٍ لانتخاباتٍ زحاما",135,"م",2,0],["ولما سرى الأحباب سايرت ركبهم","وشيعتهم والقلب يلهب ثاقبه",136,"ب",2,1],["وَلَم أَسبَإِ الزِقَّ الرَوِيَّ وَلَم أَقُل","لِأَيسارِ صِدقٍ أَعظِموا ضَوءَ نارِيا",137,"ي",2,0],["ولم استهنتم بالعهود فأصبحت","ما بيننا نقط لكم وحصون",138,"ن",1,0],["ولم أسأم الراح لكنني","تركت الرقيق بأخذ الأرق",139,"ق",1,0],["ولمّا سَكرنا بخمر الرضاب","وكان الرقيب الخبيث وفد",140,"د",1,0],["ولم استطع في الدهر دفعاً لحادث","ولم أملك الأمر الذي فيه اطمع",141,"ع",1,0],["وَلَم أَسلُبِ البيضَ أَبدانَها","وَلَم يَكُن اللّهوُ مِن باليَه",142,"ه",1,0],["ولما سلَّ عارضُهُ حساماً","وفَوقَ لحظُه سهمَ المنونِ",143,"ن",1,0],["ولمّا سموت الأفق أرّختُ همة","مجيديةً أُهديتَ من رتبةٍ أولى",144,"ل",2,0],["ولما سما طور العقول مديحهُ","ففيِ حمام الأيك أرّخ تناغتِ",145,"ت",1,0],["وَلمّا سامَني الأَعداءُ ضيماً","سَجيناً حلَّ في سجن القلاعِ",146,"ع",1,0],["ولمّا سمعتَ بأني برِئتُ","وأَبلى الإلهُ بلاءً جميلا",147,"ل",2,0],["ولما سار ذا الظبي عني","دلالا قد ترنح بالمسير",148,"ر",1,0],["ولما سمعنا بشيراً به","حبانا كما الحبور كلامه",149,"م",2,0],["ولما سرى الهم الغربي قريتهُ","قَرِى مَنْ أزالَ الشَّكَّ عَنْهُ وأزْمَعَا",150,"ع",2,0],["ولمّا سليمانُ البِساطُ به سرى","أُسيلتْ لهُ عينٌ يَفيضُ لها القَطرُ",151,"ر",1,0],["ولما سرى الوفد العراقي نحوكم","وأعوزني المسرى إليكم مع الركب",152,"ب",1,0],["ولمْ أستطع نسيانَ ذلك يقظةً","وحتى الكرى، لم أنسَ ذلك في الكرى",153,"ر",2,0],["ولم أستطع يوم النوى ردّ عبرة","فؤادي أسى من حرّها يتقطع",154,"ع",1,0],["وَ لَمْ أَسِرْ،فَجِهَاتِي كُلُّهَا شَرَرٌ","وَ لَمْ أَصِلْ،فَدُرُوبِي كُلُّهَا حُفَرُ",155,"ر",1,0],["وَلَمّا سارَ ذاكَ الضَّوءُ وانهَدَمَتْ","أتى موجٌ ومِنْ أقصاهُ يَعتَذِرُ",156,"ر",1,0],["وَلَمَا سلكْتَ مَسالِكاً","قَدْ تاهَ فيها مَنْ سَلَكْ",157,"ك",1,0],["ولم أسل عن تذكاركم وإدكاركم","على البعد واللؤى وفي العسر واليسر",158,"ر",1,0],["ولم أسمع عواء الذئب ليلا","ولا وقع العويل على الشعور",159,"ر",1,0],["ولَماس من شجر الأراك غصونها","حتى أباحت عاشقيك دِثارها",160,"ر",3,0],["ولم أسمع مِن المذياع عتْباً","ولا دمعتْ لمصرعهم عيونُ!",161,"ن",1,0],["ولمّا سألتُ القلبَ سلوةَ حُبِّكم","وشاورتُه فيما أُحاوِلهُ أبى",162,"ب",2,0],["ولمّا سألنا عن رواتبِنا ادعى","(بشارةُ) أنْ عجْزُ الخَزينَةِ لازِبُ",163,"ب",1,0],["ولم أسال بانبساطي لغنيمة","ولم أنقبض خوف الفوات لخلة",164,"ه",1,0],["ولما سرت فيه الحقائق وانبرت","له سبحات الوجه أبقت وأفتنتي",165,"ت",2,0],["ولم أسرقْ بعمري فوق هذا","سوى بعض الهوى من مقلتيها",166,"ي",3,0],["ولم أستطع أنا تنظيف قطري","وتنظيف مصرٍ ولا النيربينِ",167,"ن",1,0],["ولما سعيتم بين مروة والصفا","صفا قلبكم مما يرين ويطبع",168,"ع",1,0],["ولم أسع تفريطا لبعض منافع","أبيع لديني تارة ومباديا",169,"ي",2,0],["ولم أستجب حاشا لعدوان جاهل","وسامحت عما جاء غيري معاديا",169,"ي",2,0],["ولَمْ أستدِنْ أيَّ مالٍ مِنَ القا","حِلينَ، لِأُهدِيَها المُستحيلا",170,"ل",2,0],["ولَمْ أَسْتَطِعْ أَنْ أَذلَّ الحُرُوْفَ","فَتَأتِيْ إلَيْكَ بِمَعْنَى البُكَاءِ",171,"ا",1,0],["ولما سارَ في خيط الأماني","تَمطّى الأفْقُ مُحْتَرِقاً وَذابا",172,"ب",2,0]]}