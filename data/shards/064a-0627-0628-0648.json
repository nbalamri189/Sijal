9,"رثاء الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=198842",""],[5976,"يا بو سعد ..","https://www.poetsgate.com/ViewPoem.aspx?id=35084",""],[5993,"تميم ماقصرت وابوك رباك","https://www.poetsgate.com/ViewPoem.aspx?id=189008",""],[6100,"الا يا بدر من ينشد هك الغربه ثمنها كم","https://www.poetsgate.com/ViewPoem.aspx?id=52590",""],[6100,"والدي","https://www.poetsgate.com/ViewPoem.aspx?id=52481",""],[6113,"عتاب ابوي","https://www.poetsgate.com/ViewPoem.aspx?id=137093",""],[6127,"سقطَ النصيفُ","https://www.poetsgate.com/ViewPoem.aspx?id=198388",""],[6331,"حلم موت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82023&r=&rc=4",""]],"verses":[["يا بُؤسَ مُقتَنِصِ الغَزالِ طَماعَةً","ذَهَبَ الغَزالُ بِلُبِّ ذاكَ القانِصِ",0,"ص",1,1],["يا بُؤسَ لِلدَّهرِ أَلقاني بِمَسبَعَةٍ","وَقالَ لي عِندَ غيلِ الضَيغَمِ اِحتَرِسِ",1,"س",1,0],["يَأبونَ أَن يَلبَسَ الإِظلامُ رَبعَهُمُ","لَيلاً وَما عَذَّبوا طَرفاً بِتَسهيدِ",2,"د",1,0],["يا بُؤسَ لِلفَضلِ لَو لَم يَأتِ ما عابَهُ","يَستَفرِغُ السُمَّ مِن صَمّاءَ قِرضابَه",3,"ب",2,1],["يا بؤسَ للشعراءِ يسهرُ ليلُهمْ","ويُلقَّبون بأسوَأِ الألقابِ",4,"ب",1,0],["يا بؤسَ للدهر ذي السفاهِ أما","يَفْرقُ بين القيانِ والجِزَرِ",5,"ر",1,0],["يا بُؤسَ منتزَعٍ من ثَدْي والدةٍ","حفيَّةٍ مالَهُ من دونِها والي",6,"ل",2,1],["يا بُؤسَ نَفسٍ عَلَيها جِدِّ آسِفَةٍ","وَشَجوَ قَلبٍ إِلَيها جِدِّ مُرتاحِ",7,"ح",1,0],["يا بُؤسَ لِلدَهرِ الَّذي","ما زالَ مُختَلِفاً طِباعُهُ",8,"ع",2,0],["يا بُؤسَ لِلناسِ ما دَهاهُم","صاروا وَما يُنكِرونَ مُنكَر",9,"ر",1,0],["يا بُؤسَ لِلغافِلِ المُضَيِّعِ عَن","أَيِّ عَظيمٍ مِن أَمرِهِ غَفَلا",10,"ل",2,0],["يا بُؤسَ لِلجاهِلِ المَغرورِ كَيفَ أَبى","أَن يُخطِرَ المَوتَ في الدُنيا عَلى بالِه",11,"ل",2,0],["يا بُؤسَ للرأي المُضلَّلِ إنّهم","طلبوا دماً مِن كَيْدِهم معصوما",12,"م",2,0],["يا بُؤسَ كَلبي سَيِّدِ الكِلابِ","قَد كانَ أَعناني عَنِ العُقابِ",13,"ب",1,1],["يا بُؤسَ جِلدٍ عَلى عَظمٍ مُخَرَّقَةٍ","فيهِ الخُروقُ إِذا كَلَّمتَهُ تاها",14,"ا",3,0],["يا بؤسَ زنبورِ لهُ من صُفرةٍ","في المُسترادِ رأى لها القنّاصُ",15,"ص",1,0],["يا بويرق الحمى","هات اخبار من به",16,"ب",2,1],["يا بؤس للحب كيف تجنى","من جنة الحسن ذي الجحيم",17,"م",1,0],["يا بؤس للناس هل تغنوا","بالبغض لو يحمد الذميم",17,"م",1,0],["يا بؤس للنائبات كيفَ أرت","أُخوّة الفرقديْنِ تنفصلُ",18,"ل",1,0],["يا بُؤسَ لِلدَهرِ أَيّ خَطبٍ","وَهابَهُ الدَهرُ في اِبنِ حامد",19,"د",1,1],["يا بول صبيان الفطا","م ويا خراهم في الحجور",20,"ر",1,0],["يا بؤسَ للدنيا الدنية ضرّجَت","بدمائه مستبسلاً وجبانا",21,"ن",2,0],["يا بُؤْسَ للصبّ شَام البَرْقَ مُبتَسما","فباتَ يُزْري بصَوْبِ المُزْن مُنْتَحبا",22,"ب",2,0],["يا بؤسه تسمو به اشواقه","حيناً ويصعقه الهوى في حين",23,"ن",1,0],["يا بُؤس ما فَعل الفرا","ق وَوَيحَهُ ماذا ظَلم",24,"م",1,0],["يا بؤس مقْدَمها من نكبة طرقت","وشؤم مُصْبحه من حادث وقعا",25,"ع",2,0],["يا بُؤسَ للدّهرِ غُرّ العالِمون به","والجاهلون معاً في الأعصر الأُوَلِ",26,"ل",1,0],["يا بؤسَ للإنسان في عيشه","يُسلُّ منه أوّلاً أوّلا",27,"ل",2,0],["يا بُؤْسَ للدَّهْرِ حينَ آلُ رسو","لِ الله تجتاحُهُمْ جَوَائِحُهْ",28,"ح",2,0],["يا بو ثمانٍ وأربع سْنين","عندك احتاز سعيد وانزاح",29,"ح",1,1],["يابو نهيداتٍ كما التّين","والخد ْ برّاقٍ لضى ولاح",29,"ح",1,0],["يا بو محمد يا عضيدي وْمسندي","وإن اشتكلت حالتي يا وجودها",30,"د",3,0],["يا بو العيله شمّر كُمَّك","وَاوعى للبَيت اللَه يسمّك",31,"ك",1,1],["يا بو العَدَل موز الأَوزان","وَاصغي لِطَيب القصايد",32,"د",1,0],["يا بؤس من كانت بيوت قصيده","شُعَبَ الفؤاد ومدمعَ الآماق",33,"ق",1,0],["يا بؤسَ بَغداد دار مَملَكة","دارَت عَلى أَهلِها دَوائرها",34,"ر",3,0],["يا بوخليفه يا كبير المروّات","يا مسندي نفسي لنفسك فِداها",35,"ا",3,0],["يا بو جبينٍ كالبدر نور صافي","ومبيسمٍ جيونٍ شرينه مناضيد",36,"د",1,0],["يا بؤس نفس أولعت بسعادها","لعبت سعاد بمقلها وفؤادها",37,"د",3,0],["يا بو خليفه لبركه فيك","كم شاعر مثلي شهرته",38,"ت",2,0],["يا بؤس من يمنى بدمع ساجم","يهمي على حجب الفؤاد الواجم",39,"م",1,1],["يا «بوحسن» دَبّر لي اسبابْ","في دْواي يا نَسْل المذاريبْ",40,"ب",1,1],["يا بو حسن الله الاعجاب","كيف الغزِّيل يفَرْس الذيب",40,"ب",1,0],["يا بو سعيد السَّبْق حِزْتوه","لي في ختام الرّيس كِلَّه",41,"ل",2,1],["يا بو خليفة يا زبون المخيفين","يا حاكمٍ حكمه بعز وشجاعه",42,"ع",2,1],["يَا بوظبي سيري عَلَى عِزِّكْ سِنِيْن","خَلِّكْ لِمِن يبغاه دربك يدلّه",43,"ل",2,1],["يا بو خالد جدد بقلبي جروح","شوق ادمالي قديمات الجراح",44,"ح",1,1],["يا بؤس حظ المستفيد","بعيد فقد المستفاد",45,"د",1,0],["يا بؤس صبح أبي قابوس إذ شهروا","عليه كل طريد الحد ذي شُطَبِ",46,"ب",1,0],["يا بو ثمانٍ ذبّل اعذاب","في مبسمٍ كالحصّ ياضي",47,"ض",2,0],["يا بو محمد يوم مَرّيت","منازله في وقت الآفراح",48,"ح",1,0],["يا بوخليفه يا رَجا كلّ محتار","إنتَ رجانا ومنّك الخير نرجيه",49,"ي",2,0],["يَا بُوْ عيانٍ سِمْر دِعْجات","والخد بَرْقٍ وِسْط لْمِغيب",50,"ب",1,0],["يا بو سويعيّه ومِلْفَع","هُوِّس عَلَى قَلْبِيْ تَهَوِّيس",51,"س",1,0],["يَا بُوْ عَليّ عقلي مْطَيَّر","مَا اروم اوضّح لِكْ بتِبْيان",52,"ن",1,0],["يا بؤس قوم ليس جرم عدوهم","إلا تظاهر نعمة الرحمن",53,"ن",1,0],["يا بؤس حامل رجسٍ ليسَ يغسِلُهُ","بِالماءِ عنهُ إِذا كلَّمتَهُ تاها",54,"ا",3,0],["يا بُؤسَ لِلشَيخِ عَبّادِ بنِ شَدّادِ","أَضحى رَهينَةَ بَيتٍ بَينَ أَعوادِ",55,"د",1,1],["ياَبؤُسَ لِلحَربِ الَّتي","وَضَعَت أَراهِطَ فَاِستَراحوا",56,"ح",3,1],["يَا بُوْ حِسَنْ حِزْني مْنَطَّل","وِدّي ووِدَّهْ طَيّ فِيْ طَيّ",57,"ط",2,0],["يا بُؤسَ مُغتَبِطٍ بِالدَهرِ يَأمَنُهُ","بَعدَ الَّذي قَد جَرى في أَمرِ عَبّاسِ",58,"س",1,1],["يا بؤرة الآمال ماذا الذي","أرجو غداً من حظى العاثر",59,"ر",1,0],["يا بؤس من لا يستقر فؤاده","يا سعد من يهديه الاستسلام",60,"م",1,0],["يا بؤس أرض لا نرى فوقها","إلا طغاة أو مرائينا",61,"ن",2,0],["يا بوركت خطرات دجلة كلما","حل المصيف وحل ليل مقمر",62,"ر",1,0],["يا بُؤسَ ما صَنعَ الزَّمانُ بِمَنزِلٍ","أَمسى بِهِ زُحل بَديلَ المُشتري",63,"ي",1,0],["يا بولسٌ ضاع ما أوصيتَ عن ثقةٍ","فالخِدن في الغمِّ والملّاقُ مَسرورُ",64,"ر",1,1],["يا بولساً جاءَ يَحكي بولساً حِكماً","مَن حكمت منهجَ الإيمان حِكمتهُ",65,"ت",2,0],["يَأْبَوْنَ أَنْ يَسْتَكيِنُوا للعِدَى ولَهُمْ","أَنْفٌ حَمِيٌّ وقلبٌ غيرُ مُضْطَرِبِ",66,"ب",1,0],["يا بُؤْسَ لِلْحَرْبِ يُذْكي نارَها شَرَهٌ","يَدْعُو إلى مُوبِقاتٍ كُلُّها نِقَم",67,"م",1,0],["يا بؤس يوم لهم به التبست","نعال أفراسه مع الق