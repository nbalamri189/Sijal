لَّقتْ","https://www.poetsgate.com/ViewPoem.aspx?id=186600",""],[5232,"أنوثة","https://www.poetsgate.com/ViewPoem.aspx?id=211784",""],[5239,"قامت تودعني فقلت لها امهلي","https://www.poetsgate.com/ViewPoem.aspx?id=190938",""],[5302,"يا عجولا","https://www.poetsgate.com/ViewPoem.aspx?id=201222",""],[5387,"عجوزٌ مراهق","https://www.poetsgate.com/ViewPoem.aspx?id=53104",""],[5414,"صرخة من وراء الأسوار","https://www.poetsgate.com/ViewPoem.aspx?id=12936",""],[5561,"هو خيرةٌ من خيرةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193807",""],[5804,"مساجلة مع جار الهنا","https://www.poetsgate.com/ViewPoem.aspx?id=190655",""],[5887,"أحيمد","https://www.poetsgate.com/ViewPoem.aspx?id=35261",""],[5956,"لمن تثور العاصفة","https://www.poetsgate.com/ViewPoem.aspx?id=181909",""],[5956,"اتّق شرّ من أحسنت إليه","https://www.poetsgate.com/ViewPoem.aspx?id=192409",""],[186,"دع عنك ذكر المنحنى وزرود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55750&r=&rc=13",""],[572,"من شَكَّ في فضلِ الكُميتِ فَبَيْنَهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9299&r=&rc=156",""]],"verses":[["فَإِذا عَبيدٌ عُكَّفٌ","مُسَكٌ عَلى أَنصابِها",0,"ب",3,0],["فَإِذا عَلَت فَكَدَعوَةِ ال","مُضطَرِّ تَختَرِقُ السِتار",1,"ر",1,0],["فَإِذَا عُنِينَا بِالْحَيَا","ةَ خَلاَ أَلْطَّعَامَ أَوِ الشَّرَابَا",2,"ب",2,0],["فإذا عشت عشت ملكاً مطاعاً","مالكاً في البلاد نهياً وأمرا",3,"ر",2,0],["فإذا عطلْن من الحُلْي","ي فلسْن منه بالعواطلْ",4,"ل",1,0],["فَإِذا عَلَت حَسِبَ الوَرى","أَنّا نُصَعِّدُ في الأَثيرِ",5,"ر",1,0],["فَإِذا عَشِقتَ فَلا تَلُم أَحداً سِوى","عَينَيكَ إِنَّ العُيونِ قَتولا",6,"ل",2,0],["فَإِذا عَدَدتُكِ في الكِلا","بِ حَطَطتُ مِن قَدرِ الكِلابِ",7,"ب",1,0],["فَإِذا عُدِّدَت صَنائِعُ قَومٍ","كُنتَ فيها صَنيعَةَ البَظراءِ",8,"ا",2,0],["فَإِذا عَزَمتَ عَلى مَساءَتِهِم","فَاِجهَر بِلَم يولَد وَلَم يَلِدِ",9,"د",1,0],["فَإِذا عَدا وَالدَهرُ ذو غِيَرٍ","دَهرٌ عَلَيكَ عَدا مَعَ الدَهرِ",10,"ر",1,0],["فَإِذا عَلا جَدّي فَقَلبي جُنَّتي","وَإِذا دَنا أَجَلي فَدِرعي مَقتَلي",11,"ل",2,0],["فإذا عدت فللنجوى أعود","ثم أمضي بعد ما أفرغ كأسي",12,"ي",1,0],["فَإِذَا عَلا حَزْناً أَطَارَ شَرَارَهُ","وَإِذَا أَتَى سَهْلاً أَطَارَ دُخَانَا",13,"ن",2,0],["فأَذاعَ الذِّراعُ مَا فيه مَن شر","رٍ بِنُطْقٍ إخفاؤُهُ إبداءُ",14,"ا",2,0],["فإذَا عزمْتَ على اتِّباعِ سَبِيلِهِ","فَاسْمَعْ كلامَ أَخِي النَّصيحَةِ ترْشُدِ",15,"د",1,0],["فإذا عَفَا لم تَلْقَ غيرَ مُمَلَّكٍ","وإذا سطا لم تَلْقَ غيرَ مُعفَّر",16,"ر",1,0],["فَإِذا عَلاها الماءُ أَلبَسَها","حَبَباً كَمِثلِ جَلاجِلِ الحِجلِ",17,"ل",1,0],["فَإِذا عُدَّ جَوادٌ","مَعَهُ كانَ مُحالا",18,"ل",2,0],["فإذا عبرت فإنني في جنة","وإذا سقطت ففي حضيض جهنم",19,"م",1,0],["فَإِذَا عَلَتْ سَكَنَتْ مَظَلَّةَ أَيْكَةٍ","وَإِذَا هَوَتْ وَرَدَتْ قَرَارَةَ مَنْبَعِ",20,"ع",1,0],["فَإِذَا عُدَّ في بَلاَءٍ فَخَارٌ","لَمْ يُجَاوِزْ فخَارَ ذَاكَ البَلاَءِ",21,"ا",2,0],["فَإِذا عَلاَ أَزْرَى عَلَى","سِرْبِ السَّفِينِ المُقْلِعِ",22,"ع",1,0],["فَإِذَا عُصَيْفِيرٌ هَوَى","مِنْ شُرْفَة بِيَدِ الْقَضَاءْ",23,"ا",2,0],["فَإذَا عَيِيتُ وَلَمْ أَقُمْ بِحُقُوقِهَا","فَلَقَدْ يَقُومُ الْعُذْرُ بالإِبْلاءِ",24,"ا",2,0],["فإذا عرفْتُمْ أين يَكمُن دَاؤها","فاستأصِلُوه أيَّما استِئْصالِ",25,"ل",1,0],["فإذا عابدُو التماثيلِ لل","ه يخِرُّون ركَّعًا وسجودا",26,"د",2,0],["فإذا على أسلاكه مهزوزةً","نبأ يرِن الحزن في أثنائه",27,"ا",3,0],["فإذا عشقت فلا تلم أحدا سوى","عينيك ، إنّ من العيون قتولا",28,"ل",2,0],["فاذا عدّت أساطين النّهى فاذكر أخاه","وإذا الميدان جلّى الشوط كان ابن جلاه",29,"ا",2,0],["فإذاعةُ الأسرار عندي راحة","للقلب كن للقائنا مرتاحا",30,"ح",2,0],["فإذا عميدُ الملك حلاَّ ربعه","ظَفِرَا بفال الطائر الميمونِ",31,"ن",1,0],["فإذا عزمتَ فلا تكُن متردداً","فسدَ الهوى بتَردُدِ الأنْفاسِ",32,"س",1,0],["فإذا علمت بحالتي","يبكيك ما أبكاني",33,"ن",2,0],["فَأَذاعَ بِالتَصديقِ لَم يَرهَب وَلَم","يَرتَب مِنَ الحَقِّ المُبينِ بِشانِ",34,"ن",1,0],["فإذا علمت بما يجرّعني","دهري الشقي بكأسه المر",35,"ر",1,0],["فَإِذا عَزَمتَ فَأَمضِ هَمَّ","كَ بَينَ مَحمودٍ وَذامِ",36,"م",1,0],["فإذا عشْتَ فالدّيارُ جِنانٌ","لذوي الفضْلِ والحياةُ خُلود",37,"د",1,0],["فإِذا عذتُ بالتجلُّدِ عنكُم","كذَّبتني نواظرُ الأجفانِ",38,"ن",1,0],["فَإِذا عَبَّ مِن الرا","ح اِحتَسى لُب النَديم",39,"م",1,0],["فإذا عنَّ ذكرهم لفؤادي","قَعدَ الوجدُ بالفؤادِ وقاما",40,"ا",1,0],["فإذا عَدَّتِ الأماجد يوماً","كنت بدءاً لها وكنتَ الختاما",41,"م",2,0],["فإِذا عوَانُ المَجدِ رَدَّ خطيبُها","فَلَكَ الأَيامى مِنهُ والأَبكارُ",42,"ر",1,0],["فإذا عدمتُ ندَى يديك تعلَّلت","خَلَّاتُ حالي بالغمام الماطرِ",43,"ر",1,0],["فإذا عيون الحاسديك على العلى","وسرت سحائبها إلى سرواتها",44,"ت",3,0],["فإذا علقت بربع قلبي حيه","إن الفؤاد رهين ربع الفؤاد",45,"د",1,0],["فإذا عددنا أولاً أو آخراً","في البأس والإحسان كنت الأولا",46,"ل",2,0],["فإذا عروسٌ ذَيَّلَتْ فستانَها","بالمغرياتِ وغازَلَتْهُ بذَيْلِهِ",47,"ل",2,0],["فإذا عنا غفلنا","فيه كنا كالشياه",48,"ه",1,0],["فإذا عرفت فإنما","معنى لمعنى مستديم",49,"م",1,0],["فإذا عرفت لمن يؤثر منك في","كل الشئون فإنك المترائس",50,"س",1,0],["فإذا عَفوتَ فقد وَفى حُسْنُ الرِّضى","وإذا اعتذرتُ فقد وَفَى التَّسليمُ",51,"م",1,0],["فإذا علينا الأنس رفرف مدة","فالفضل في هذا إليه يرجع",52,"ع",1,0],["فَأَذاع سرّي في الهَوى بَعد الخَفا","لَونٌ لهاتيك المَدامع قاني",53,"ن",2,0],["فَإِذا عَلاهُ شِمتهُ فَخراً بِهِ","قَد كادَ رَأساً أَن يَطولُ الأَنجُما",54,"م",2,0],["فَإِذا عَلاهُ خِلتهُ مُتناولاً","رَأسَ الثّريّا إِذ لها يتعمّدُ",55,"د",1,0],["فَإِذا عَلا فَوقَ الجَوادِ رَأَيتَهُ","لَيثاً عَلى فَلَكِ الثريّا يَقعُدُ",55,"د",1,0],["فَإِذا عَدا فَوقَ الجَوادِ وَشَتمِهِ","لم تَدْرِهِ أَبِمُدبرٍ أَم مُقبلِ",56,"ل",1,0],["فإذا على الخيل استوى تاهت به","مَرَحاً وذلَّلها وإن تك عاتية",57,"ي",2,0],["فإذا عقربُ صُدغَيْه","حُمىً رُمتُ احتماءَ",58,"ا",2,0],["فإذا عهده انقضى","وإذا نوره خبا",59,"ب",2,0],["فإذا عقود المجد فُصِّل نظمُها","كانت مناقبه لهنَّ فريدا",60,"د",2,0],["فَإِذا عَلِمتَ بِأَنَّهُ مُتَفاضِل","فَاِشغَل فُؤادَكَ بِالَّذي هُوَ اِفضَل",61,"ل",1,0],["فإِذا عزَمتَ فَكُلُّ صَعبٍ رُمْتَهُ","سَهْلٌ علَيك وكُلُّ قُطْر مُزُدَهِ",62,"ه",1,0],["فإذا علة ملك أعضلت","فلها من سيفه العَضْب طبيب",63,"ب",1,0],["فإذا علمت ذا","فلكوني فارجعي",64,"ع",2,0],["فإذا عجزتَ عن المنال علمتَه","بالعجز ليس بما اعتبرتَ مثالا",65,"ل",2,0],["فإذا عَجزنَا عَنهُ ألقَينَاهُ لَم","نَعبَأ بِهِ قَصداً إلَى الإِحسَانِ",66,"ن",1,0],["فإذا عويصات المسائل أبهمت","يجلي بثاقب فكره إبهامها",67,"م",3,0],["فإذا عليٌّ رأيتمُوه فانشُروا","أنْ قد رأيتم يثرباً ومُحمَّدا",68,"د",2,0],["فإذا عصيت فبالقوا","مش في البواطن والظواهر",69,"ر",1,0],["فأذاع الانس منا","كل ما قد كان مكتم",70,"م",1,0],["فأذاعا الذي كتمت من الوجد","وباحا بما يكن جناني",71,"ن",2,0],["فاذا عاش للانام وصيف","وبغا فالملك ثبت القرار",72,"ر",1,0],["فاذا عنيت سعيدها بتهائ","فلقد اصبت وقد مدحت نبيلا",73,"ل",2,0],["فاذا عذرتَ فانتَ أَوَّل عاذِرٍ","وإِذا عذلتَ فانت من عذّالِهِ",74,"ل",2,0],["فإذا علا صوت الأراذل فانتبه","نبح الكلاب ينبه الحراسا",75,"س",2,0],["فَإِذا عَلَينا اَن نُفيق","من سَكرة النَوم العَميق",76,"ق",1,0],["فاذا عَدِمْتَهما معاً","فاشربْ على وجهِ الشَّريفِ",77,"ف",1,0],["فَإِذا عَمِلتَ الخَيرَ لا تَمنُن بِهِ","لا خَيرَ في مُتَمَدِّحٍ مَنّانِ",78,"ن",1,0],["فإذا عشت له عشت به","في بواكير من العيش الينيع",79,"ع",1,0],["فإذا عهدت المحض من عاداته","لم تلقَ يومًا منه ما لم تعهد",80,"د",1,0],["فإذا عارض المطاف طريقيْ","نا فتسليمنا وداع الرحيل",81,"ل",1,0],["فَإذا عُصارةُ ذاكَ حو","ب في المغَبَّةِ أو طَفَس",82,"س",1,0],["فَإِذا عادَهُ مِنَ الشَطِّ طَيفٌ","شَذَّ مِن قَلعِهِ يُساري الحوتا",83,"ا",1,0],["فَاذَا عُدتُ سالِماً لِبلادي","ثَمَّ فِيلا كُفءٌ لِكُلِّ مُرَادي",84,"ي",1,0],["فإذا عطفتَ فتلك منكَ سَجيَّةٌ","عن سُنَةٍ أُورِثتَها وقياس",85,"س",1,0],["فإذا عثرت فلا لعالك عاثرا","إنَّ الجهول كثيرة عثراته",86,"ت",2,0],["فإذا عطا قل كيفض فارقَ سريَه","وإذا سطا قل كيفَ أخلى الغِيلا",87,"ل",2,0],["فاذا عُدَّتِ المُلوكُ قصيداً","كان مِنهمْ في الفخرِ بيتَ القَصيدِ",88,"د",1,0],["فإذا عادَ فإن شِئتَ فَعُد","وتهيا للبكا والسهَرِ",89,"ر",1,0],["فاذا عدت نحوكم جئت منها","بالهدايا لكم متى أبت راجع",90,"ع",1,0],["فإذا عجزت عن المؤونة واستقل","ت وجدت في أعقابهن الهيفا",91,"ف",2,0],["فاذا عدلت عن ابتغاي لم يقل","احد اراه عادلا لا طاغيا",92,"ي",2,0],["فإذا عُدّت الصنائع يوماً","كنت فيها صنيعة البظراء",93,"ا",2,0],["فإذا على ظهر الطريق مغذة","سوداء قد عرفت أوان ذهابي",94,"ب",2,0],["فإذا عاد همُّ ركب رشادٍ","شرّد الوهْم وانْتضى الصمت وهْنا",95,"ن",2,0],["فإذا عجزتَ عن احتوائي فارتحلْ","وكفاكَ عن نبلِ الغرامِ كلاما!",96,"م",2,0],["فإذا عطشنا نرتوي من دمعِنا","والهمُّ في كلّ المآقي يبصقُ",97,"ق",1,0],["فإذا عَلا لَوحٌ لَهُم مع موجَةٍ","يَعلو بهِم زَبَدٌ من الأضْغان ِ",98,"ن",1,0],["فإذا عشقنا لا نعير قلوبنا","إلَّا شعاع النور حين تفرَّقا",99,"ق",2,0],["فِإِذَاْ عَشِقْتَ، فَكُنْ صَبُوْراً حَيْثُمَاْ","ثَاْرَ الْهَوَىْ، أَوْ وَسْوَسَ الشَّيْطَاْنُ",100,"ن",1,0],["فَإِذَاْ عَشِقْتَ فَكُنْ بِعِشْقِكَ صَاْدِقاً","حَتَّىْ تُحَقَّقَ فِي الْهَوَى الأَحْلاْمُ",101,"م",1,0],["فَإِذَاْ عَشِقْتَº فَكُنْ لَبِيْباًº وَانْتَبِهْ","كَيْ لاْ تُسَاْقَ بِمَوْجَةِ الأَشْوَاْقِ",102,"ق",1,0],["فَإِذَاْ عَشِقْتِ، تَجَنَّبِيْ طُرُقَ الأَذَىْ","إِنَّ الإِذِيَّةَ عَقْرَبٌ صَفْرَاْءُ",103,"ا",2,0],["فَإِذَاْ عَشِقْتَ، فَلاْ تَسَلْ أَيْنَ الْهَوَىْ؟","وَالْحُبُّº وَالإِخْلاْصُº وَالآلاْءُ؟",104,"ا",2,0],["فإذا على سور الحسين وصنوه","حسن هم للرقص أول مبتد",105,"د",1,0],["فإذا عجِزتُمْ أن تصونوا عدلَكمْ","عن منبرِ العدلِ المُقدَّسِ كالحرمْ",106,"م",1,0],["فإذا عالم السماوات حسن","وإذا عالم الأراضين سوء",107,"و",2,0],["فإذا عوى ذئبُ الرياحِ ،","وأرعدتْ لا تفزعي",108,"ع",2,0],["فإذا عزمت على الرحيل تركتني","رهن البلى ومجاور الأموات",109,"ت",1,0],["فإذا عدت من مرامك صفرا","فاعلم اليوم أن في الأمر إنا",110,"ن",2,0],["فإذا عجزت عن العطاء فربما","زلت بها رغباتها المتحررة",111,"ر",2,0],["فإذا عدٍلكم ظلام.. وظلم","وكفًاياتكمٍ.. أرتٍنا الخَسارا",112,"ر",2,0],["فإذا على الأرضِ الذليلةِ ينتشي","فخرا ويُفسدها بنفسٍ راضيا",113,"ي",2,0],["فإذا عزيمةُ مهجتي لا تنطفي","فتقهقروا في كلِّ ما قد راموا",114,"م",3,0],["فإذا عرفت اليوم سنة أحمد","وزهدت في دنيا الثعالب واللئام",115,"م",1,0],["فإذاً عرَفتِ لمن تثور العاصفةْ","لتطير بالنجوى لتخلق عاصفةْ",116,"ف",2,0],["فإذاً علمتِ لمن تثور العاصفةْ","لتطير بالنجوى وتخلق عاصفةْ",116,"ف",2,0],["فإذا عطفتَ على شريدٍ إذْ به","يسبي نقودك ما ضميره عاصمُ",117,"م",1,0],["فإذا عذرت ففي أناتك مذهب","وإذا اعتذرت فمبلغ المجهود",118,"د",1,0],["فإذا عَطَفْتَ بهِ على بَارودة ٍ","لتَرُدَّهُ فكأنَّهُ بركَارُ",119,"ر",1,0]]}