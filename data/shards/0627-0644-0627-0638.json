{"poems":[[32,"ألا ظعنت مي فهاتيك دارها","https://www.aldiwan.net/poem29534.html","الطويل"],[32,"أدارا بحزوى هجت للعين عبرة","https://www.aldiwan.net/poem29554.html","الطويل"],[76,"شراب الأماني لو علمت سراب","https://www.aldiwan.net/poem12869.html","الطويل"],[254,"أحق ما رأيت أم احتلام","https://www.aldiwan.net/poem2096.html","الوافر"],[254,"ألا ظعن الخليط غداة ريعوا","https://www.aldiwan.net/poem2107.html","الوافر"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59784","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59412","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93392","الطويل"],[5667,"الطبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=214892",""]],"verses":[["أَلا ظَعنَت مَيٌّ فَهاتيكَ دارُها","بِها السُحمُ تَردي وَالحَمامُ المُوَشَّمُ",0,"م",1,1],["أَلا ظَعَنَت مَيٌّ فَهاتيكَ دارُها","بِها السُحمُ تَردي وَالحَمامُ المُطَوَّقُ",1,"ق",1,0],["أَلا ظَعَنا مِن صاحِبٍ وَشَبيبَةٍ","فَهَل لَهُما مِن ظاعِنينَ إِيابُ",2,"ب",1,0],["أَلا ظَعَنَت لِنِيَّتِها إِدامُ","وَكُلُّ وِصالِ غانِيَةٍ رِمامُ",3,"م",1,0],["أَلا ظَعَنَ الخَليطُ غَداةَ ريعوا","بِشَبوَةَ فَالمَطِيُّ بِنا خُضوعُ",4,"ع",1,1],["ألا ظعنت ليلى وشط مزارُها","ولا وصل إلا أن يواتيك مضجع",5,"ع",1,0],["الأظهر الأسرى الحيبيب المصطفى","الأطهر الأزكى الإمام الأكمل",6,"ل",1,0],["أَلإظهارِ دينِ طه وهل أم","ركِ قد جاء عن دين طاها",7,"ا",3,0],["ألا ظَعنت لَيلى وَبان قطينُها","وَلكنَّني باقٍ فَلوموا وَعَنِّفوا",8,"ف",3,0],["ألا ظَلِّي ( أُسَّيةَ ) لي حبيباً","يُناجيني ببَسمتِهِ الطَّروبَه",9,"ب",2,0]]}