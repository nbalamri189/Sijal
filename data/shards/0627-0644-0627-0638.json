{"poems":[[30,"ألا ظعنت مي فهاتيك دارها","https://www.aldiwan.net/poem29534.html","الطويل"],[30,"أدارا بحزوى هجت للعين عبرة","https://www.aldiwan.net/poem29554.html","الطويل"],[74,"شراب الأماني لو علمت سراب","https://www.aldiwan.net/poem12869.html","الطويل"],[247,"أحق ما رأيت أم احتلام","https://www.aldiwan.net/poem2096.html","الوافر"],[247,"ألا ظعن الخليط غداة ريعوا","https://www.aldiwan.net/poem2107.html","الوافر"]],"verses":[["أَلا ظَعنَت مَيٌّ فَهاتيكَ دارُها","بِها السُحمُ تَردي وَالحَمامُ المُوَشَّمُ",0,"م",1,1],["أَلا ظَعَنَت مَيٌّ فَهاتيكَ دارُها","بِها السُحمُ تَردي وَالحَمامُ المُطَوَّقُ",1,"ق",1,0],["أَلا ظَعَنا مِن صاحِبٍ وَشَبيبَةٍ","فَهَل لَهُما مِن ظاعِنينَ إِيابُ",2,"ب",1,0],["أَلا ظَعَنَت لِنِيَّتِها إِدامُ","وَكُلُّ وِصالِ غانِيَةٍ رِمامُ",3,"م",1,0],["أَلا ظَعَنَ الخَليطُ غَداةَ ريعوا","بِشَبوَةَ فَالمَطِيُّ بِنا خُضوعُ",4,"ع",1,1]]}