"مِن وَزَرٍ وَمِعتَصِم",2,"م",1,0],["كَم فَجَّعَتني اللَيالي قَبلَهُ بِفَتىً","مُشَمَّرٍ بِغُروبِ المَجدِ نَزّاعِ",3,"ع",1,0],["كَم فُرجَةٍ لِلأَعادي بِتَّ تَكلَؤُها","لَولاكَ فاهَت بِذي وَدقَينِ مِنباعِ",3,"ع",1,0],["كَم فيكِ مِن خَرقٍ لِأَظفارِهِ","كَمَلغَمِ الأَشدَقِ لَم يُرقَعِ",4,"ع",1,0],["كَم فَقيدٍ لَنا طَوَتهُ اللَيالي","ذُقنَ مِنهُ حُلواً وَذَوَّقنَ مُرّا",5,"ر",2,0],["كَم في سُراها مِن سُروبِ مَدامِعٍ","تَقفو سُروبَ رَبارِبٍ وَجَآذِرِ",6,"ر",1,0],["كَم فيكِ مِن صاحي الشَمائِلِ مُنتَشٍ","بِالذُلِّ أَو مَرضى العُيونِ صِحاحِ",7,"ح",1,0],["كَم فارِسٍ بَينَ الصُفوفِ أَخَذتُهُ","وَالخَيلُ تَعثُرُ بِالقَنا المُتَكَسِّرِ",8,"ر",1,0],["كَم فارِسٍ غادَرتُ يَأكُلُ لَحمَهُ","ضاري الذِئابِ وَكاسِراتُ الأَنسُرِ",8,"ر",1,0],["كَم في المَقابِرِ مِن قَتيلِ لِسانِهِ","كانَت تَهابُ لِقاءَهُ الأَقرانُ",9,"ن",1,0],["كَمْ فَتْكَةٍ لَكَ فِي الْعِدَى مَشْهُورَةٍ","يُزْرِي حَدِيثُ تَلِيدِهَا بِالأَقْدَمِ",10,"م",1,0],["كمْ فيهِ منْ ليْثٍ هِزَبْرٍ ما سَطا","إلا ومِنْ بيضِ الظُّبا أظْفارُهُ",11,"ر",2,0],["كَمْ فِضَّةٍ فُضَّتْ وَكَمْ مِنْ ضَيْعَةٍ","ضَاعَتْ وَكَمْ ذَهَبٍ رَأَيْنَا يَذْهَبُ",12,"ب",1,0],["كَم فيهِمُ مِن فارِسٍ يَومَ الوَغى","ثَقفِ اليَدَينِ يَهِلُّ بِالإِقصادِ",13,"د",1,0],["كَم فيهِمُ مِن شَطبَةٍ خَيفَقٍ","وَسابِحٍ ذي مَيعَةٍ ضابِرِ",14,"ر",1,0],["كَم فيهِمُ مِن شَطبَةٍ","وَمُقَلِّصٍ نَهدِ المَراكِل",15,"ل",1,0],["كَم فيكِ جَرّاحٌ كَأَنَّ يَمينَهُ","عِندَ الجِراحَةِ بَلسَمٌ وَسَلامُ",16,"م",1,0],["كَم في الكِنانَةِ مِن فَتىً","نَدبٍ وَكَم في الشَأمِ قادِر",17,"ر",1,0],["كَم فيهِ مِن نَهرٍ جَرى بِطَريقَةٍ","تَرِدُ النُهى مِنهُ أَلَذَّ شَرابِ",18,"ب",1,0],["كَم في نَواحي رُبوعِ النيلِ مِن طُرَفٍ","لِليازِجِيِّ وَصَرّوفٍ وَزَيدانِ",19,"ن",1,0],["كَم فارِسٍ في راحَتَيكَ ثِيابُهُ","وَجَوادُهُ وَالمَشرفِيُّ المُنتَضى",20,"ض",2,0],["كم في شمائلهم كم في فضائلهم","فخر لمصر وسوريا ولبنان",21,"ن",1,0],["كم فاض في أثر الهلال العاثر","من مدمع باللؤلؤ المتناثر",22,"ر",1,1],["كَم فِي سَنَى الكَوْكَبِ الوَهَّاجِ مَهْلَكَةٍ","فِي كُلِّ لَمْحٍ لأَضْوَاءٍ وَأَلوَانِ",23,"ن",1,0],["كَمْ فِي القَضَاءِ تَلُوحُ لِلفَطِنِ الَّذِي","وَلِيَ القَضَاءَ وَمَعانِ",24,"ن",1,0],["كَمْ فَتىً فِيكَ يَا حَمِيدَ السَّجَايَا","فَقَدْ البَأْسُ وَالنَّدَى وَالدِّينُ",25,"ن",1,0],["كَمْ فِي حَيَاتِكَ مِنْ مِثَالٍ وَاعِظٍ","لِلنَّاسِ مِنْ شِيبٍ وَمِنْ شُبَّانِ",26,"ن",1,0],["كَمْ فِي مَسَاعِيكَ الجِسَامِ مَفَاخِرٌ","حَمَدَ الزَّمَان بِهَا وَكَانَ ذَمِيمَا",27,"م",2,0],["كَمْ فِي الشُّيُوخِ وَفِي الشَّبَابِ مُرُةءةٌ","صَوَّرَتْهَا فِي اللَّحْمِ مِنْهُمْ وَالدَّمِ",28,"م",1,0],["كَمْ فِي البَوَادِي وَالحَوَاضِ بَعْدَهُ","عَيْنٌ مُؤَرَّقَةٌ وَقَلْبٌ دَامِ",29,"م",1,0],["كَمْ فِيهِ مِنْ بُشْرَى تَوَسَّمُهَا المُنَى","لِفَخَارِ مِصْرَ وَعِزَّةِ الإِسْلامِ",30,"م",1,0],["كَم فيهِمُ مِن أَشَمِّ الأَنفِ ذي مَهَلٍ","يَأبى الظُلامَةَ مِنهُ الضَيغَمُ الضاري",31,"ي",1,1],["كم فتحت من مدينا","كن لها من سعد مفتاح",32,"ح",1,0],["كم فيه من مُلَح لمرتاد الهوى","تركَتْ فؤاد مُحِبِّهِ مَتُبُولا",33,"ل",2,0],["كم فيهم من قارِ ضيفٍ طارقِ","وضحت شواهدُ فضله للقارِ",34,"ر",1,1],["كم في الحوادث من نذير قد أتى","فيكم بأسرار الزمان يبوح",35,"ح",1,0],["كم في معادن سعيه","لبني المواطن من ركيزه",36,"ز",2,0],["كم في ُبيوت القوم من حرّة","تبكي من البؤس بعينَيْ أمه",37,"م",2,0],["كَم فيهِمِ مِن ماجِدٍ ذي سَورَةٍ","بَطَلٍ بِمَكرَهَةِ المَكانِ المُحرِجِ",38,"ج",1,0],["كم فضَّلت آلاؤهُ فاضلاً","واسْتعبدت ألفَ ابن عبَّاد",39,"د",1,0],["كم في حروفك من عيون فرائدٍ","لكنَّها لعيوننا كالإثمد",40,"د",1,0],["كم في ملوك الورى فضل ومعرفة","كانوا ومثلك في ذا النحو ما كانوا",41,"ن",3,0],["كم فيهم من مقيمٍ كُلَّ ذي حَدَبٍ","من الأمورِ بِرأيٍ غيرِ ذي حَدَبِ",42,"ب",1,0],["كم فيهمُ من مُقيمٍ كلَّ ذي حَدَبٍ","من الأمور على الإسلام ذي حَدبِ",43,"ب",1,0],["كم فُرِّجَتْ غَمَّاءُ عمن فَرَّجا","فلينتظرْ مُثْرٍ مُضِيقاً مُحْرَجَا",44,"ج",2,0],["كم فيكُمُ من شديد الدَّرْء يومئذٍ","يَصْلى الوغى بشهابٍ منه وقادِ",45,"د",1,0],["كم فيك من مِدحةٍ تظل على","ألسنة المنشدين مُعتَوره",46,"ر",2,0],["كم فيه من جدِّيَةٍ عَذَرتْ","مشتقُّ كنيَتِهِ من العبس",47,"س",1,0],["كم فيهمُ من نحلةٍ مجاجةٍ","عسلَ الشفاء وأفعوانٍ ناهش",48,"ش",1,0],["كم فيهمُ من آمرٍ برشيدةٍ","لم يأْتِها ومُرَغِّبٍ رفَّاض",49,"ض",1,0],["كم فَعال لك أضحى","لعبيد القوت عتقا",50,"ق",2,0],["كم فعلةٍ لك بي أرسلتَها مثلاً","ومدحةٍ فيك لي أرسلتُها مثلا",51,"ل",2,0],["كم في احتيالي وتدبيري لذي فزعٍ","من ملجأ ومُغاراتٍ ومُدّخلِ",52,"ل",1,0],["كم فتاةٍ بخاتِم الله بِكرٍ","فضحوها جَهْراً بغير اكتتام",53,"م",1,0],["كم فتاةٍ مصونة قد سبوْها","بارزاً وجهها بغير لثام",53,"م",1,0],["كم فَعلة لك في الأنام سَنيَّةٍ","ولدى الإله ثقيلةُ الميزان",54,"ن",1,0],["كَم فَتاةٍ مِثلِ لَيلى وَفَتىً كَاِبنِ المُلَوَّح","أَنفَقا الساعاتِ في الشاطِءِ تَشكو وَهوَ يَشرَح",55,"ح",1,0],["كَم في السَوائِلِ مِن شَبيهٍ بِالطَلا","فَعَلامَ لَيسَ لَها مُقامُ الراحِ",56,"ح",1,0],["كَم في السَوائِلِ مِن شَبيهٍ لِلطَلا","فَعَلى ما لَيسَ لَها مَقامَ الراحِ",57,"ح",1,0],["كم فتاةٍ جميلةٍ مدحوها","وتغنَّوْا بها لكيْ يُسْقِطوها",58,"ا",1,0],["كم فيه من مثَل يسير وحكمة","تبقى على الدنيا بقاء عسيب",59,"ب",1,0],["كَم في التُرابِ إِذا فَتَّشتَ عَن رَجُلٍ","مَن ماتَ بِالعَهدِ أَو مَن ماتَ بِالقَسَمِ",60,"م",1,0],["كَم في الخَمائِلِ وَهيَ بَعضُ إِمائِها","مِن ذاتِ خِلخالٍ وَذاتِ سِوارِ",61,"ر",1,0],["كَم في الحَياةِ مِنَ الصَحراءِ مِن شَبَهٍ","كِلتاهُما في مُفاجاةِ الفَنى شَرَعُ",62,"ع",1,0],["كَم فَقيدٍ مِنَ التِلادِ إِذا نَق","قَبَ عَن شَأنِهِ فَعِندَكَ ثارُه",63,"ر",2,0],["كَم في بَني الرومِ مِن أُعجوبَةٍ مَثَلِ","وَفي بَني العُربِ مِن ذي نَجدَةٍ بَطَلِ",64,"ل",1,1],["كَم فيهِمُ مِن حاتِمٍ في النَدى","يُبِرُّ أَفضالاً عَلى حاتِمِ",65,"م",1,0],["كَم فِيَّ مِن مَلِكٍ أَغَرَّ وَسوقَةٍ","حَكَمٍ بِأَردِيَةَ المَكارِمِ مُحتَبي",66,"ب",2,0],["كَم فَرَّقَ اللَهُ مِن كَيدٍ وَجَمَّعَهُ","بِهِم وَأَطفَأَ مِن نارٍ لَها شَرَرُ",67,"ر",1,0],["كَم فيكَ إِن مَلَكَت يَداكَ لَنا","يَوماً نَواصينا مِنَ النَذرِ",68,"ر",1,0],["كَم فيكَ إِن عُدِّدَ المَعروفُ مِن كَرَمٍ","وَنائِلٍ كَخَليجِ المُزبِدِ الجاري",69,"ر",2,0],["كَم فَرَّجَ اللَهُ عَنّا كَربَ مُظلِمَةٍ","بِسَيفِ مَسلَمَةَ الضَرّابِ لِلبُهَمِ",70,"م",1,0],["كَم فيهِمُ مِن كُهولٍ راجِحينَ بِهِم","يَومَ اللِقاءِ وَشُبّانٍ ذَوي سُنَنِ",71,"ن",1