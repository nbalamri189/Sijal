{"poems":[[95,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[45,"فديناك من ربع وإن زدتنا كربا","https://www.aldiwan.net/poem9455.html","الطويل"],[63,"أتكتم أسرار الهوى أم تذيعها","https://www.aldiwan.net/poem51571.html","الطويل"],[99,"سألتك يا صخرة الملتقى","https://www.aldiwan.net/poem24403.html","المتقارب"],[46,"ألم ترني خليت نفسي وشانها","https://www.aldiwan.net/poem30298.html","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43743","المتقارب"],[102,"كلمة كل نهار","https://www.poetsgate.com/ViewPoem.aspx?id=50427",""],[185,"متى الدين يا أم العلاء فقد أنى","https://www.aldiwan.net/poem59081.html","الطويل"],[234,"مجيرك من سقم ومن وصب","https://www.aldiwan.net/poem51212.html","البسيط"],[354,"قالوا ترى ما به لما رأوا ولهي","https://www.aldiwan.net/poem15531.html","البسيط"],[422,"سألتك عن منازلنا بنجد","https://www.aldiwan.net/poem53908.html","الوافر"],[422,"أقول لصاحبي ورضيع كأسي","https://www.aldiwan.net/poem54079.html","الوافر"],[466,"شربت دما ان حال ودي ساعة","https://www.aldiwan.net/poem15480.html","الطويل"],[556,"قد زرت ليلة هومنا على العيس","https://www.aldiwan.net/poem47744.html","البسيط"],[556,"أهاجك ذكر منهم ووساوس","https://www.aldiwan.net/poem47756.html","الطويل"],[556,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122592","الطويل"],[1138,"","https://poetry.dctabudhabi.ae/diwan/poem/100656","المتقارب"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64446","الطويل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114731","السريع"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46487","الوافر"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96028","الطويل"],[2833,"","https://poetry.dctabudhabi.ae/diwan/poem/204992","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132684","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89398","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103931","البسيط"],[3524,"","https://poetry.dctabudhabi.ae/diwan/poem/124598","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138700",""],[4926,"تحيّات إجلال عن الحصر جلَّت","https://www.poetsgate.com/ViewPoem.aspx?id=171107",""],[5351,"السراب","https://www.poetsgate.com/ViewPoem.aspx?id=202285",""],[5358,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=21890",""],[5397,"تخادعك الدنيا وتبدي اغترارها","https://www.poetsgate.com/ViewPoem.aspx?id=157907",""],[5393,"لماذا أتيتَ بهذا الزمانْ ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85467&r=&rc=34",""]],"verses":[["وَكَيْفَ عَادُوا وَ رَمْسِيسٌ مُقَدَّمُهُمْ","إِلَى الرُّبُوعِ بِأَوْسَاقٍ وَغِلْمَانِ",0,"ن",1,0],["وَكَيفَ عَرَفنا رَسمَ مَن لَم يَدَع لَنا","فُؤاداً لِعِرفانِ الرُسومِ وَلا لُبّا",1,"ب",2,0],["وكيفَ على هَزِّ السُّيوفِ بَقاؤُها","إذا كانَ مُهتَزُّ اليَراعِ يَروعُها",2,"ع",3,0],["وكيف على رُحبِ هذا المجا","ل ننزلُها منزلاً ضيِّقَا",3,"ق",2,0],["وَكَيفَ عَلى نارِ اللَيالي مُعَرَّسي","إِذا كانَ شَيبُ العارِضَينِ دُخانَها",4,"ن",3,0],["وَكَيفَ عَزائي وَقَد","مَضى القَلبُ مَع سولِهِ",5,"ه",1,0],["وكيف عاد (لصنعاء) العجوز ، صبا","أطرى ، وأشمس ، في ارجائها السمر",6,"ر",1,0],["وكيفَ عَزاءُ النَّفسِ عنها وحبُّهَا","يزيدُ إِذَا ما رثَّ وَصلُ الكَواعِبِ",7,"ب",1,0],["وكيف عقّك دهرٌ أنت بهجتُه","وأنت جَنَّتُه للعُجْم والعُربُ",8,"ب",1,0],["وَكَيفَ عَن مُحكَمِ الآياتِ مِنهُ أَرى","زَيغاً وَأَتبَعُ تُبّاعاً لِمُشتَبِهِ",9,"ب",2,0],["وكيفَ عَهِدْتُ أقواماً مرامي","لديهم أَنْ أراهم واقتراحي",10,"ح",2,0],["وكيفَ عَدَلْتَ عن حالات سَوْءٍ","تَصيرُ بها إلى بئسَ المصير",11,"ر",1,0],["وكيف عُدولي أقْتَضي المجد غيره","وعَلياؤه والقولُ مني بلا مِثْلِ",12,"ل",1,0],["وَكَيفَ عاجَ شبابٌ لا اِزوِرارَ بهِ","وَلا اِعوِجاجَ على شَيْبٍ وتقويسِ",13,"س",1,0],["وَكَيفَ عَجَمْتُمْ هاتماً كلَّ عاجمٍ","ومارستُمُ مَن كَلَّ عنه الممارسُ",14,"س",1,0],["وَكَيف عَلِقْتُم عَلى ما بِكمْ","من العَجْزِ بالحُوَّلِ القُلَّبِ",15,"ب",1,0],["وكَيفَ عقدتِ الحِقفَ عندض ارتِكامِه","بِعطفٍ كَعطفِ الخَيزرانةِ مائِدٍ",16,"د",1,0],["وكيف عجزت بحمل القميص","وتقوى على حمل حق الملا",17,"ا",1,0],["وكيف عنائي في المواطن كلها","وظلمة قلبي وانطماس بصيرتي",18,"ي",1,0],["وكَيفَ عاثَ التُّربُ في أَنمُلٍ","قد كُنَّ يَدمَين مِنَ اللَّمسِ",19,"س",1,0],["وَكَيفَ عَلى السَرى اِجتَرَأت وَعَهدي","بِها تَرتاعُ مِن ظلّ القِوام",20,"م",1,0],["وكيف عوادي الخيل تركض فوقه","فلم يبق منه مفصل لا يفصل",21,"ل",1,0],["وكيف عَزَاء المَرْء عن أهل بَيْتِه","وليس له في الغَابرين حَبِيب",22,"ب",1,0],["وكيف عشقت في وجه ذميم","مليحا دونه السمر الرقاق",23,"ق",1,0],["وكيف على الباقي لغيري إذا فنى","ونفسي ستفنى بعدُ يا طول أحزاني",24,"ن",2,0],["وكيف عني وعن أنسي تصبره","أم كيف بعد بعادي عنه أربعه",25,"ع",2,0],["وكيف عموا عن نوره بعدما لهم","تبين ماضي ءاية وجديدها",26,"د",3,0],["وكيف عرنين المعالي هشمت","وطالما اضافها ورحبا",27,"ب",2,0],["وكيف على الأسفار يقدر من له","عيالٌ وقد أعياه أعباء عيلة",28,"ه",1,0],["وكيف عزفن ركوعاتهن","وشيطنَ رأسكَ لما ركع",29,"ع",1,0],["وكيف على هذا الفراق ِ ألومُها","وللدهر ِ في هذا الفراق ِِِِِِِِِ سبيلُ",30,"ل",1,0],["وكيف عرين الليث تجمع حوله","ثعالب منه لم تفارق نفارها",31,"ر",3,0],["وكيف عبرت الظلام إلينا","ولما يحن للضياء أوانْ..؟",32,"ن",1,0]]}