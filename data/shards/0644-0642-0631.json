{"poems":[[53,"قل للأمير إذا مثلت له","https://www.aldiwan.net/poem64651.html","أحذ الكامل"],[53,"ذق أبا جعفر مغبة جرمك","https://www.aldiwan.net/poem65807.html","الخفيف"],[53,"فلو أني وليت الحكم يوما","https://www.aldiwan.net/poem66375.html","الوافر"],[63,"غنت تحاوره بطرف أحور","https://www.aldiwan.net/poem51605.html","الكامل"],[22,"أتاني وأهلي بذات الدماخ","https://www.aldiwan.net/poem21688.html","المتقارب"],[53,"ذُقْ أبا جعفر مغبَّة َ جُرْمِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=30082",""],[369,"خطبن وأيمان الكماة المنابر","https://www.aldiwan.net/poem60906.html","الطويل"],[398,"حدق الحسان رمينني بتململ","https://www.aldiwan.net/poem53677.html","الكامل"],[463,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138221",""],[1353,"","https://poetry.dctabudhabi.ae/diwan/poem/124300","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64534","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87324","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112693","الوافر"],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140290",""],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32804","الرمل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95354","الرجز"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/107042","المتقارب"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81701","الوافر"],[4814,"طعم الغزل","https://www.poetsgate.com/ViewPoem.aspx?id=195095",""],[4926,"كيف يحصى عليك منا ثناء","https://www.poetsgate.com/ViewPoem.aspx?id=171114",""],[307,"مساءُ البهاء","https://www.poetsgate.com/ViewPoem.aspx?id=213699",""],[5409,"يومٌ بزغت بأفقه مولودا","https://www.poetsgate.com/ViewPoem.aspx?id=155488",""],[6093,"دَعْني لشأنيَ إنِّي قَدْ غَضِبْتُ لِمَنْ","https://www.poetsgate.com/ViewPoem.aspx?id=176179",""]],"verses":[["لقريع مجدٍ لا كِفاءَ لَهُ","من مُصعب للرأس فالرأس",0,"س",1,0],["لقَرِيضي يا ابن الزّواني معانٍ","قصُرَتْ دونها مذاهبُ فهْمِك",1,"ك",1,0],["لقرَّتْ عينُ من يهوى الجواري","وعاقبتُ الذي يهوى الغُلاما",2,"م",2,0],["لقَرينِه بينَ الصُّفوفِ سَحائبٌ","مَوصولَةٌ بِسَحابِ ريحٍ صرَصَرِ",3,"ر",1,0],["لِقِرمٍ إِذا ما تَسامى القُرومُ","يُقَطِّعُ ظَهرَ البَعيرِ الأَزَبّ",4,"ب",1,0],["لقَرِيضي يا بن الزّواني معانٍ","قصُرَتْ دونها مذاهبُ فهْمِك",5,"ك",1,0],["لِقُرْبيَ منهمْ لا لِقُرْبي برحلتي","إليهم يُباهِي كُلُّهم ويُفاخر",6,"ر",1,0],["لقريحةٍ عَدلِيَّةٍ شيعِيَّةٍ","أَزرَت بِشعرِ مُزرِّدٍ وَمُهَلهل",7,"ل",1,0],["لَقرّتْ عيونٌ أو لسُرَّتْ مَضاجِعٌ","بأنّك ميراثٌ لها وعقيبُ",8,"ب",1,0],["لقران زوجين اغتدت نفساهما","كالراح بالماء الزلال قد امتزج",9,"ج",1,0],["لقرنه مشبرَقا","مختضبا بالعلق",10,"ق",1,0],["لقربك قربني نجياً مخلصاً","من البعد عن ربي لسوء طريقتي",11,"ي",1,0],["لِقُربِ جُزرِ الخالداتِ قيل لي","وَيَرَونَ جُزرَ دونَها في المَدخَلِ",12,"ل",1,0],["لِقُربِ مَقدَشُوهَ أَمَّا بالمَطَر","أو في غُبَارٍ لَم تَرَاهُ بالنَّظَر",13,"ر",1,0],["لِقُربِ وَازينَا وَهُم أقوامُ","في البرِّ كالسَّارِقِ يَا هُمَامُ",13,"م",1,0],["لقرع السمهري به دوي","ووقع المشرفي له صليل",14,"ل",1,0],["لقر خر من فوق المجرة في الثرى","دفيناً به والترب بالفضل عارف",15,"ف",1,0],["لِقُرى كَركينَ وَالقَفَ","صِ وَعِصيانِ اللَواحي",16,"ح",2,0],["لقرية معروفة والبحر","مِلح فأَما مالح فنزر",17,"ر",1,0],["لقرط أسماعنا صوته","بلحن التهاني وأحيى الضميرا",18,"ر",2,0],["لقرطاجَنّةٍ برٌّ وبحرُ","سرى لهما على الآفاق ذكرُ",19,"ر",1,1],["لقربكَ أدنو فيدنو الغمامُ","ويحلو بثغري مذاقُ البللْ",20,"ل",1,1],["لقريشٍ ذكرت أوصاف قدسٍ","ما لشيءٍ منها عليك خفاء",21,"ا",2,0],["لقُربك روحي تنوحُ حنيناً","بدمعِ من العينِ لم يَهمُلِ",22,"ل",1,0],["لقريشٍ عند النبي تراثٌ","فلذا اقتص منكم الغرماء",23,"ا",2,0],["لقَرْنِ أحْمَدَ مني الحُبّ خالصهُ","لمْ يخذلِ الصًّحبُ ديْنَ المصطفى أبدا",24,"د",2,0]]}