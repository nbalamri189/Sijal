َفتُ العَلايَةَ فَوقَكُم","بُحورٍ وَمِنّا حامِلونَ وَدافِعُ",133,"ع",1,0],["نَمَتهُ فُروعُ الزَبرِقانِ وَقَد نَمى","بِهِ مِن قُرَيشِ الأَبطَحَينِ أَوائِلُه",134,"ل",2,0],["نَمَتهُ بَطاحِيّو قُرَيشٍ كَأَنَّهُ","حُسامٌ جَلا الأَطباعَ عَنهُ صَياقِلُه",134,"ل",2,0],["نَمَتهُ النَواصي مِن قُرَيشٍ وَقَد نَمى","بِهِ مِن تَميمٍ رَأسُ عِزٍّ وَكاهِلُه",134,"ل",2,0],["نَمَتهُ قُرَيشٌ أَكرَموها وَدارِمٌ","وَسَعدٌ إِلى المَجدِ الكَريمِ قَبايِلُه",135,"ل",2,0],["نَماهُ أَبو موسى إِلى حَيثُ تَنتَهي","مِنَ الأَرضِ مِن دونِ السَماءِ جِبالُها",136,"ل",3,0],["نَماكَ إِلى مَجدِ المَكارِمِ وَالعُلى","بُيوتٌ إِلَيها العِزُّ عِندَ المَعاقِلِ",137,"ل",1,0],["نَماكَ عَظيمُ القَريَتَينِ فَأَصبَحَت","لَكَ العُروَةُ الوُثقى الشَديدُ دِخالُها",138,"ل",3,0],["نَمَتكَ العَرانينُ الطِوالُ وَلا أَرى","لِسَعيِكَ إِلّا جاهِداً غَيرَ لائِمِ",139,"م",1,0],["نَمَتكَ مَنافٌ ذِروَتاها إِلى العُلى","وَمِن آلِ مَخزومٍ نَماكَ عِظامُها",140,"م",3,0],["نَماهُ أَبوهُ في حَيثُ اِستَقَرَّت","قُضاعَةُ فَوقَ عادِيٍّ جَسيمِ",141,"م",1,0],["نَماني بَنو سَعدِ اِبنِ ضَبَّةَ فَاِنتَسِب","إِلى مِثلِهِم أَخوالِ هاجٍ مُزاحِمِ",142,"م",1,0],["نَمى بِكَ مِن رَبيعَةَ غَيرُ فَحلٍ","وَسَعَّدَ ساعِدَيكَ بَنو تَميمِ",143,"م",1,0],["نَماهُم إِلى عِرنَينِ سَعدٍ مُحَرِّقٌ","وَمِن وائِلٍ أَهلُ النُهى وَالعَظائِمِ",144,"م",1,0],["نَمَتهُ بَنو تَيمِ اِبنِ مُرَّةَ لِلعُلى","وَحاطَت حِماهُ مِن قُرَيشٍ قُرومُها",145,"م",3,0],["نَمَتكَ قُرومُ أَولادِ المُعَلّى","وَأَبناءُ المَسامِعَةِ الكِرامِ",146,"م",1,1],["نَماني بَنو سَعدِ اِبنِ ضَبَّةَ فَاِنتَسِب","إِلى مِثلِهِم أَخوالِ هاجٍ مُراجِمِ",147,"م",1,0],["نمضي ونترُكُ من ألفاظِنا تُحَفاً","تَسبي ريَاحِينُها الشَّرْبَ الرَّياحِينا",148,"ن",2,0],["نَمَتْهُ من الأزدِ صِيدُ المُلوكِ","وما زال يَنْمِي النَّجيب ُالنَّجيبا",149,"ب",2,0],["نمُدُّ إليها أكفَّ الرِّجالِ","فترجِعُ مثلَ أكُفِّ النِّساءِ",150,"ا",2,0],["نَموتُ جَميعاً كُلُّنا غَيرَ ما شَكٍ","وَلا أَحَدٌ يَبقى سِوى مالِكِ المُلكِ",151,"ك",1,1],["نَموتُ وَنُنسى غَيرَ أَنَّ ذُنوبَنا","وَإِن نَحنُ مِتنا لا تَموتُ وَلا تُنسى",152,"س",2,1],["نَمَتهُ إِلى القَومِ الَّذينَ رِماحُهُم","قَضَت في الوَغى أَن لا يَضيقَ طَعينُ",153,"ن",1,0],["نُمتُم وَلَم تَحلَموا بي في رُقادِكُمُ","وَمَع سُهادي بِكُم يَقظانُ أَحتَلِمُ",154,"م",1,0],["نِمتَ عَن حاجَتي فَأَحدَثتَ عِندي","لِتَنائيكَ مُقعِداً وَمُقيما",155,"م",2,0],["نَمَّ بِسِرِّ الرَوضِ خَفقُ الرِياح","وَاِقتَدَحَ الشَرقُ زِنادَ الصَباح",156,"ح",1,1],["نَمضي إليه فنستَقي","ونَعُبُّ منه كما نشاء",157,"ا",2,0],["نمشي وقد طال الطريق بنا","ونود لو نمشي إلى الأبدِ",158,"د",1,0],["نَمَتْهُ من الأملاكِ صِيدٌ تَقَدّمَتْ","لهم قَدَمُ الإعظام عند الأعاظمِ",159,"م",1,0],["نماهُ منَ الأشرافِ أهلُ مفاخرٍ","يُديرونَ في الأفواه ألسنةً لُدّا",160,"د",2,0],["نَم فَما زارَكَ الخَيالُ وَلَ","كِنَّكَ بِالفِكرِ زُرتَ طَيفَ الخَيالِ",161,"ل",1,0],["نَم وَإِن لَم أَنَم كَرايَ كَراكا","شاهِدٌ مِنكَ أَنَّ ذاكَ كَذاكا",162,"ك",2,1],["نَمَّت دُموعي عَلى عَذابي","مُذ غابَ عَنّي جَميلُ صَبري",163,"ي",1,0],["نَميلُ إِلى شَمائِلَ مِنهُ ميثٍ","قَليلاتِ الأَماعِزِ وَالبِراقِ",164,"ق",1,0],["نَمَوكَ قِنعاسَ دَهرٍ حينَ يَحزُبُهُ","أَمرٌ يُشابِهُ آباءً قَناعيسا",165,"س",2,0],["نَمَّتْ عَلَى فَضْلِهِ شَمَائِلُهُ","وَنَفْحَةُ الْوَرْدِ سِرُّهَا عَلَنُ",166,"ن",1,0],["نمومٌ نؤومٌ ماكرٌ غيرُ شاكرٍ","حقودٌ نقودٌ مائنٌ خائنٌ غمرُ",167,"ر",1,0],["نمتُ وإبليسُ أتى","بحيلةٍ منتدبهْ",168,"ب",2,1],["نَمتِ الممالكُ في ظلالِكَ واجتلتْ","أُممُ الزّمانِ سَناكَ والأقوامُ",169,"م",1,0],["نَمضِي على هُونٍ بكلّ مَضَلَّةٍ","حتّى كأنّا في البلادِ سَوامُ",169,"م",1,0],["نَمْ غيرَ مكفورِ الجهادِ فإنّها","أيامُ كُلِّ مُشاغبٍ كفّارِ",170,"ر",1,0],["نَمْتهُنَّ المنابتُ مُمرعاتٍ","يطيبُ بها غِراسُ المُنبِتينا",171,"ن",2,0],["نَمتْهُنَّ المَناسبُ مُشرِقاتٍ","سُلِلْنَ من القواضبِ وانْتُضينا",171,"ن",2,0],["نَمتْهُ السّابقاتُ من الأيادي","وَجَرَّبه الثِّقاتُ مُبالغينا",171,"ن",2,0],["نمضِي على خُطّةٍ للحقِّ واضحةٍ","ما فاز شَعبٌ يُجافيها ولا نجحا",172,"ح",2,0],["نَماها العِلمُ وَالحَسبُ المُصَفّى","وَأَخلاقٌ هِيَ الذُخرُ الثَمينُ",173,"ن",1,0],["نَما الناس حَولي مِن مُحِبٍّ وَحاقدٍ","فَما غَرَّني حُبٌّ وَلا هاجَني حِقدُ",174,"د",1,0],["نُمارسُ أَنواع الشَقاءِ وَغيرُنا","بِما نَحن نَجنِي دُوننا يَتنعَّمُ",175,"م",1,0],["نَموت أَو نُكرم","فِدى البراق وَالحَرَم",176,"م",1,0],["نَمشي يَفُوتُ مُخِفُّ القَومِ مَثقَلَهُم","مَشى الجِمالِ المَصاعِيبِ المَطارِيقِ",177,"ق",1,0],["نَمشي إِلى ضَوءِ أَحسابٍ أَضَأنَ لَنا","ما ضَوَّأَت لَيلَةُ القَمراءِ لِلساري",178,"ي",1,0],["نَمَتني إِلى عَمِّ النَبيِّ خَلائِقٌ","عَلَوا فَوقَ أَفلاكِ الكَواكِبِ وَالبَدرِ",179,"ر",1,0],["نَمَّ الوَشاةُ بِنا إلاَ إنَّ الهَوَى","لَمْ يَخْلُ مِنْ وَاشٍ ولا نَمَّامِ",180,"م",1,0],["نَمْ هَنِيئاً مُحَمَّدَ بنَ عَلِيٍّ","بِجَميلٍ قَدَّمْتَ بَيْنَ يَدَيْكَا",181,"ك",2,1],["نَمَّت عَلى نُدَمائِها بِنَسيمِها","وَضِيائِها في اللَيلَةِ الظَلماءِ",182,"ا",2,0],["نَمَّ بِما كُنتُ لا أَبوحُ بِهِ","عَلى لِسانٍ بِالدَمعِ مِنطيقِ",183,"ق",1,0],["نُمتُ إِلى الصُبحِ وَإِبليسُ لي","في كُلِّ ما يُؤثِمُني خَصمُ",184,"م",1,1],["نَمَت في الكِرامِ بِني عامِرٍ","فُروعي وَأَصلي قُرَيشُ العَجَم",185,"م",1,0],["نَمَينَ قِلالَهُ مِن بَيتِ راسٍ","إِلى لُقمانَ في سوقٍ مُقامِ",186,"م",1,0],["نِمنا عَلى الشَيبِ فَهَل زارَنا","طَيفٌ لِأَصلِ الشَرخِ مُنتابُ",187,"ب",1,0],["نَمتارُ مِن أُمِّنا الغَبراءِ حاجَتَنا","وَلِلبَسيطَةِ مِن أَجسادِنا مِيَرُ",188,"ر",1,0],["نِمنا وَما رَقَدَت وَحَلَّ مُقيمُنا","وَالنَجمُ في أُفُقِ السَماءِ يُسَيَّرُ",189,"ر",1,0],["نَمضي وَنَتَّرِكُ البِلادَ عَريضَةً","وَالصُبحُ أَنوَرَ وَالنُجومَ زَواهِرا",190,"ر",2,0],["نَمُرُّ سِراعاً بَينَ عُدمَينِ ما لَنا","لَباثٌ كَأَنّا عابِرونَ عَلى جِسرِ",191,"ر",1,0],["نَموتُ لِأَنَّنا حُلَفاءُ نَقصٍ","وَيَبقى مَن تَفَرَّدَ بِالكَمالِ",192,"ل",1,0],["نَمَمنَ بِما يَخفيهِ حَيٌّ وَمَيِّتٌ","وَمِن شَرِّ أَفعالِ الرِجالِ النَمائِمُ",193,"م",1,0],["نُمسِكُ الخَيلَ عَلى مَكروهِها","حينَ لا يُمسِكُها إِلّا الصُبُر",194,"ر",1,0],["نُمسِكُ الخَيلَ عَلى مَكروهِها","حينَ لا يُمسِكُ إِلّا ذو كَرَم",195,"م",1,0],["نُميتُ وَلا نُحيِي كَذَلِكَ صُنعُنا","إِذا البَطَلُ الحَامِي إِلى الموتِ أَهجَرا",196,"ر",2,0],["نَماهُ إلى العلياءِ خيرُ خليفةٍ","تَتيهُ به الدنيا ويزهَى به القَصْرُ",197,"ر",1,0],["ن مسالكي خير المسالك","فأجبتها إني كذلك",198,"ك",1,0],["نمَّ من مجثمه","هبّ يعطو حذرا",199,"ر",2,0],["نم بعيداً في خلوة الأجداثِ","من رغاء الخطوب والأحداثِ",200,"ث",1,1],["نم بها واترك النزاع مثاراً","من جراء الأموال للوراث",200,"ث",1,0],["نمَتْ زهرةٌ في غصون الخريف","كحُلمٍ من الماءِ والخضرةِ",201,"ه",1,0],["نماهُمْ على البأس آباؤهم","قساورةً وسيوفاً صِقالا",202,"ل",2,0],["نمَتْ فيه بين بناتِ السديمِ","وشبَّتْ مع الفلكِ الدائرِ",203,"ر",1,0],["نَمانيَ إقليمٌ نماكَ وأطلعتْ","سماءَكَ شمسٌ أطلعتْ فجرَ مولدي",204,"د",2,0],["نَمى يا بابِلِيُّ إِلَيكَ شَوقي","وَعَيني لازَمَت سَكبَ الدُموعِ",205,"ع",1,1],["نمت عن الأخرى فلم تنتبه","وفي سوى الدين هجرت الكرى",206,"ر",2,0],["نماهمو كما نماهُ فهرُ","فبينهم واشجةٌ وصهرُ",207,"ر",1,0],["نَمَّتْ شَمائِلُهُ عَلَى أَعْراقِهِ","نَمَّ النَّسِيمِ عَلَى أَرِيجِ الطِّيبِ",208,"ب",1,0],["نَمَانِي إِلَى الْعَلْيَاءِ فَرْعٌ تَأَثَّلَتْ","أَرُومَتُهُ فِي الْمَجْدِ وافْتَرَّ سَعْدُهُ",209,"د",2,0],["نَمَّ الصَّبَا وَانْتَبَهَ الطَّائِرُ","وَاسْتَحَرَ الصَّاهِلُ وَالْهَادِرُ",210,"ر",1,1],["نَمَتْ أَدْوَاحُها وسَمَتْ فَكَانَتْ","عَلَى السَّاحاتِ أَمْثَالَ الْقِبابِ",211,"ب",1,0],["نَمِيلُ مِنَ الدُّنْيَا إِلَى ظِلِّ مُزْنَةٍ","لَهَا بَارِقٌ فِيهِ الْمَنِيَّةُ تَلْمَعُ",212,"ع",1,0],["نَمْشِي بِهِ بَيْنَ أَشْجَارٍ كَأَنَّ عَلَى","أَفْنَانِهَا مِنْ بُرُودِ الْيَمْنَةِ الرِّيَطُ",213,"ط",1,0],["نِمْنَا عَلَى جَهْلٍ وَقَدْ","عَاشَ الكِرَامُ وَنَحْنُ لَمْ",214,"م",1,0],["نَمْ إِن مصْراً عنْكَ رَاضِيَةٌ وَفُزْ","مِنْ شُكْرِهَا بِمَثُوبَةِ الأَخْيَار",215,"ر",1,0],["نَمَاهُ عَصْرٌ وَكلُّ عَصْرٍ","يَوَد لَوْ أَنَّهُ العَتِيدُ",216,"د",1,0],["نَمُرُّ بِخَضْرَاءَ فَتَّانَةَ","لَها مِنْ زُمُرُّدِهَا مُنْتَقَبْ",217,"ب",1,0],["نَمْ عَنْهُمُو وَمَقَامُكَ ال","عَالي وَجَانِبُكَ المَهِيبُ",218,"ب",1,0],["نِمَرٌ مِنَ فرْطِ مَا حَاقَ بِهِ","دَارَ آناً فِي مَدَارٍ ثمَّ خَرَّا",219,"ر",2,0],["نَمْ وَلاَ يُشْمِتَنَّهُ أنْ رُ","حْتَ شَهِيداً فِي إِثْرِ أَلْفِ شَهِيدِ",220,"د",1,0],["نَمْ وَحَسْبُ الأَجْيَالِ بَعْدَكَ مَا أَذْ","كَيْتَ مِنْ شُعْلَةٍ لِغَيْرِ خُمُود",220