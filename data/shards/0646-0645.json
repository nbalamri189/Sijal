 بسلمى","https://www.poetsgate.com/ViewPoem.aspx?id=21953",""],[28,"ستبلغ عني غدوة الريح أنها","https://www.poetsgate.com/ViewPoem.aspx?id=20997",""],[28,"ألم تريا أن الجواد ابن معمر","https://www.poetsgate.com/ViewPoem.aspx?id=20978",""],[99,"سؤال","https://www.poetsgate.com/ViewPoem.aspx?id=7380",""],[51,"يا لائمي في الرَّاح غيرَ مُقَصِّرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=27408",""],[48,"اكْسِرْ بمائكَ سَوْرَةَ الصهباءِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24840&r=&rc=10",""],[88,"أرى عيشنا تأبى المنون امتداده","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19566&r=&rc=69",""],[53,"أيَا لِلَّهِ! أيُّ هَوًى أضَاءَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9805&r=&rc=2",""]],"verses":[["نَماهُ أَبٌ وَلودٌ لِلمَعالي","وَأُمُّ أَراقِمٍ تُدهي البَنينا",0,"ن",2,0],["نَمُرُّ وَراءَ اللَيلِ نَكتُمُهُ السُرى","وَقَد فَضَحَتنا بِالبُغامِ الرَواسِمُ",1,"م",1,0],["نَميلُ عَلَيها بِالسِياطِ نَوازِعاً","إِلى كُلِّ بَيداءٍ يُرِمُّ دَليلُها",2,"ل",3,0],["نَماني كُلُّ مُمتَعِضٍ أَبيٍّ","جَرى طَلَقَ الجَموحِ إِلى المَعالي",3,"ي",1,0],["نَمُرُّ عَلى الظِباءِ مُكَنِّساتٍ","كَما قَطَنَ العَذارى في الخُدورِ",4,"ر",1,0],["نَماني قُرومٌ مِن ذَوائِبِ غالِبٍ","يَمُدّونَ بي في كُلِّ طَودِ عُلىً مَدّا",5,"د",2,0],["نُميتَ مِنَ العُقوقِ إِلى المَخازي","كَما يُنمى الهَريرُ إِلى النَباحِ",6,"ح",1,0],["نَماني مِن أُباةِ الضَيمِ نامٍ","أَفاضَ عَلَيَّ تِلكَ الكِبرِياءَ",7,"ا",2,0],["نَمانِيَ مِنْهُمْ كُلُّ أَبْيَضَ ماجِدٍ","على صَفْحَتَيْهِ بَهْجَةٌ وَحَياءُ",8,"ا",2,0],["نَموْني لِلْعُلا فَحَلَلْتُ مِنْها","بِحيْثُ يُرَى مِنَ الأُذُنِ المُناجِي",9,"ج",2,0],["نَماهُ إِلى فَرْعَيْ أُمَيَّةَ عُصْبَةٌ","تَذِلُّ لَها طَوْعاً رِقابُ القبائِلِ",10,"ل",1,0],["نَمْشِي بِمُنْعَرَجِ الوادِي عَلى وَجَلٍ","وَالنَّوْمُ مِنْ أَعْيُنِ الواشِينَ يَنْتَقِمُ",11,"م",1,0],["نَماني كُلُّ أبْيَضَ عَبْشَميٍّ","تُعَدُّ النّيِّراتُ لهُ قَبيلا",12,"ل",2,0],["نَمَتْكَ منْ غالِبٍ أقمارُ داجِيَةٍ","تَحِلُّ منْ ظُلَلِ الهَيْجا بأبْراجِ",13,"ج",1,0],["نَماهُمْ أبو المِظْفارِ وهْوَ الذي احتَمى","بهِ حاتِمٌ إذْ شُلَّ للحَيِّ أظْعانُ",14,"ن",1,0],["نَماكَ من غالِبٍ بِيضٌ غَطارِفَةٌ","بَثُّوا الندىً فإلَيهِمْ مُنتَهى السُّبُلِ",15,"ل",1,0],["نَماني مِنْ أمَيَّةَ كُلُّ قَرْمٍ","تَرُدُّ البُزْلَ هَدْرَتُهُ إفالا",16,"ل",2,0],["نمَتْهُ أمْلاكَ صِدْقٍ بلْ ملائِكَةً","منْ كلِّ مُحْتَزِمٍ بالحَزْمِ منْتَطِقِ",17,"ق",1,0],["نَمْ فِي جِوَارِ اللهِ مَسْرُوراً بِمَا","قّدَّمْتَ يَوْمَ تُزَلْزَلُ الأَقْدَامُ",18,"م",1,0],["نمْ وادِعاً واهْنأ جِواركَ في جَوا","رِ اللهِ قدْ نالَ السّعادَةَ جارُهُ",19,"ر",2,0],["نَما سيّدُ الأنْصارِ سعْدٌ وسدّدَتْ","يدُ اللهِ في أغراضِهِ النّصْرَ والسّعْدا",20,"د",2,0],["نَمَتْهُ منَ الخَلائِفِ آلِ نَصْرٍ","أولي الغاياتِ منْ بأسِ وَجُودِ",21,"د",1,0],["نَمتْكَ إِلَى الْمَجْدِ الأَصِيلِ خَصَائِصٌ","يُقَصِّرُ عَنْهَا نَجْلُ زَيْدٍ وَحَاجِبِ",22,"ب",1,0],["نَماهُ الإِلَهُ فَوقَ كُلَّ قَبيلَةٍ","أَباً فَأَباً يَأبى الدَنِيَّةَ أَينَما",23,"م",2,0],["نَم هَنيئاً فَقَد سَهِدتَ طَويلاً","وَسَئِمتَ السَقامَ وَالأَوصابا",24,"ب",2,0],["نَم أَنتَ يَكفيكَ ما عانَيتَ مِن تَعَبٍ","فَنَحنُ في يَقظَةٍ وَالشَملُ مُلتَئِمُ",25,"م",1,0],["نَم هانِئاً مُطمَئِنّاً","فَلَم تَنَم أَحقادي",26,"ي",1,0],["نَمَتكُما مِصرٌ وَرَبّاكُما","أَبٌ كَريمٌ جَدَّ حَتّى عَلا",27,"ل",2,0],["نَمَتكَ ظِلالٌ وارِفاتٌ وَأَنعُمٌ","وَلَيِّنُ عَيشٍ في مَصيفٍ وَمَربَعِ",28,"ع",1,0],["نَمُشُّ بِأَعرافِ الجِيادِ أَكُفَّن","إِذا نَحنُ قُمنا عَن شِواءٍ مُضَهَّبِ",29,"ب",1,0],["نَمى بِكَ في الذَؤابَةِ مِن قُرَيشٍ","بِناءُ العِزِّ وَالمَجدُ الأَثيلُ",30,"ل",1,0],["نَمَت لِأَبي بَكرٍ لِسانٌ تَتابَعَت","بِعارِفَةٍ مِنهُ فَخَصَّت وَعَمَّتِ",31,"ت",1,0],["نَمْ هَانِئاً كَمْ سَاهِدٍ فِي ثَرَى","غُرْبَتِهِ وَدِّ بِهِ مَدفَنَهْ",32,"ن",2,0],["نَمَّقْتُهَا وَكَأَنَّنِي صَوَّرْتُهَا","عَنْ صُورَةٍ مَرْسُومَةٍ بِجِنَانِي",33,"ي",1,0],["نَمَا وَزَكَا عَلَى أَرْقَى مِثَالٍ","كَمَا يَبْغِي مُنْشِئْهُ العَلِيمُ",34,"م",1,0],["نَمْ عَنْ مَتَاعِبِهَا الجِسَامِ وَذَرْ","آلامَهَا غُنْماً لِمُغْتَنِمِ",35,"م",1,0],["نَمْلأُ الصُّحُفَ بِالثِّمَارِ الدَّوَانِي","مِنْ مَجَانِي قَرَائِحٍ وَعُلُومِ",36,"م",1,0],["نميلُ على جوانبه كأنَّا","إذا مِلنا نميل على أبينا",37,"ن",2,0],["نَمى بَعدَ قَيظٍ قاظَهُ بِسُوَيقَةٍ","عَلَيهِ وَأَن لَم يَطعَمِ الماءَ قاصِرِ",38,"ر",1,0],["نَماكَ أَبو موسى إِلى الخَيرِ وَاِبنُهُ","أَبوكَ وَقَيسٌ قَبلَ ذاكَ وعامِرُ",39,"ر",1,0],["نمّت لنا ألحانه بجميع ما","قد أودعت فيه القلوب من الفكرْ",40,"ر",1,0],["نِمتم إلى نوب الزمان فإن أتت","قمتم كما يتململ المذبوح",41,"ح",1,0],["نمَتْكم إلى المجد المُؤثَّل تغلبٌ","كما قد نمتكم للمكارم غَسّان",42,"ن",1,0],["نَم أيها البطل الفادي بمهجته","أوطانه نومة تستيقظ العبرا",43,"ر",2,0],["نم نومة تجعل التأريخ محتفياً","بها لنضهة أهل الشرق مدّكرا",43,"ر",2,0],["نم مستريحاً فإن الشعب مرتقب","ماذا ستفعله من بعدك الوزرا",43,"ر",2,0],["نماه إلى المجد الصراع متمماً","به فخره السيف الآلهيّ خالد",44,"د",1,0],["نمدّ إلى قطب المنى وهي","جمّة من العمر كفاً لا تكاد تنوش",45,"ش",1,0],["نَمَتهُ القُرومُ الصيدُ مِن آلِ جَعفَرٍ","وَأَورَثَ مَجداً في رِياحٍ وَسُؤدَدا",46,"د",2,0],["نَمَتكَ إِلى العُليا فَوارِسُ داحِسٍ","وَصيدُ مَنافٍ المُقرَماتُ المَطارِفُ",47,"ف",1,0],["نَماكَ الحارِثانِ وَعَبدُ شَمسٍ","إِلى العَليا فَعِزُّكَ لَن يُراما",48,"م",2,0],["نَما بِكَ خالِدٌ وَأَبو هِشامٍ","مَعَ الأَعياصِ في الحَسَبِ الجَسيمِ",49,"م",1,0],["نَمضي بِها حَتّى تُصيبَ عَدُوَّنا","وَتُرَدَّ مِنها غانِمٌ وَكَليمُ",50,"م",1,0],["نَمَتهُ إِمامَةُ وَالحارِثانِ","حَتّى تَمَهَّلَ سَبقاً جَديدا",51,"د",2,0],["نَمُتُّ بأرحامنا الداخلا","ت من حيث لا يُنكر المدخلُ",52,"ل",1,0],["نَمُدُّ بُيوتُنا في كُلِّ فَجٍّ","بِهِ بَينَ الأَراقِمِ وَالصِلالِ",53,"ل",1,0],["نم يا محمد مع أبيكَ فإنه","ما رثَّ لا وأبيكَ عهدُ رثائي",54,"ي",1,0],["نمْ في مقامِ نعيمٍ غيرِ منقطعٍ","ونحنُ في نارِ حزنٍ غير متَّئِب",55,"ب",1,0],["نمْ وادعاً فلقد تقرح ناظري","سهراً ونامت أعينُ السمار",56,"ر",1,0],["نمتَ عنها وما لمثلك عُذْرٌ","عند ذي نُهيةٍ على الإغفاءِ",57,"ا",2,0],["نم يا رقيبي فقد تَنبَّه لي","خَطْبٌ من الدهر كنت أرتقِبُهْ",58,"ب",2,0],["نَمْتَاحُ منه حَاتميَّاً ماجداً","ونُثير منه هاشمياً قُلَّبَا",59,"ب",2,0],["نُمشةٌ فوق صُفرةٍ فتراه","كَوَنيمِ الذباب في اللفَّاحِ",60,"ح",1,0],["نَمَتْهُ من العَلْيا جبالُ صُقُورها","وحفّت جَنَابيْهِ غِيَاضُ أُسُودها",61,"د",3,0],["نمْ هنيئاً فمقلتي","فيك بالشوق تسْهَدُ",62,"د",1,0],["نمْتني ملوك الروم في رأس باذخٍ","من المجد يعلو كل مجد ويقهر",63,"ر",1,0],["نمَّتْ وقد غطيته لحيةٌ","كأنها رايةُ بيطار",64,"ر",1,0],["نُمسي ونُصبح لا واشٍ يُطيف بنا","ولا رقيبٌ خفيُّ اللحظ محذورُ",65,"ر",1,0],["نِمتَ عن عرسك الحصانِ إلى الصُب","ح وباتت براكب النيكِ تمطو",66,"ط",2,0],["نمتاحه والجور في توظيفنا","ويسوسنا والعدل في توظيفه",67,"ف",2,0],["نمَّتْ بذاك شواهدٌ","فيه أنمُّ من الجلاجلْ",68,"ل",1,0],["نَمَّ على نقصِه ويا أسفي","عليه يا ليت أنه كتما",69,"م",2,0],["نَمْ يا أخا الحاجاتِ إنَّ له","كرماً إذا ما نِمْتَ لم يَنَمِ",70,"م",1,0],["نمَّامةُ المِسْكِ تُلقى وهي نائيةٌ","فنأيُها بنميم المسكِ لقيان",71,"ن",1,0],["نَمْ كيف شِئْتَ فما البناءُ بخاشع","كلّا ولا أسُّ البناء بواهي",72,"ه",2,0],["نَماهُ مِن الحَيَّينِ قِردٍ وَمازِنٍ","لُيوثٌ غَداةَ البَأسِ بيضُ مَصادِقُ",73,"ق",1,0],["نَماكَ هِشامٌ لِلفِعالِ وَنَوفَلٌ","وَآلُ أَبي العاصي لِخَيرِ أَنامِ",74,"م",1,0],["نَمَتهُ الذُرى مِن مالِكٍ وَتَعَطَّفَت","عَلَيهِ الرَوابي فَرعُها وَأُصولُها",75,"ل",3,0],["نَماكَ إِلى الرَباءِ فُحولُ صِدقٍ","وَجَدٌّ قَصَّرَت عَنهُ الجُدودُ",76,"د",1,0],["نَمشي عَلى تِلكَ الهِضاب وَدونَنا","بَحرٌ مِنَ الأَغراس وَالأَشجارِ",77,"ر",1,0],["نَم تَحرُسِ الأَملاكُ قَبرَكَ إِنَّهُ","فيهِ الوَقارُ وَحَولَهُ التَبجيلُ",78,"ل",1,0],["نَم آمِناً فَالمَرءُ بَعدَ الرَدى","كَالفِكرِ لا يُزرى بِهِ لا يُضام",79,"م",1,0],["نِمتُمُ وَقَد سَهَر الأَعادي حَولَكُم","وَسَكَنتُمُ وَالأَرضُ في جَيشانِ",80,"ن",1,0],["نَمُرُّ بِرَهوِ الماءِ صَفحاً وَقَد طَوَت","ثَمائِلُنا وَالزادُ ظَنٌّ مُغَيَّبُ",81,"ب",1,0],["نُمَيرٌ جَمرَةُ العَرَبِ الَّتي لَم","تَزَل في الحَربِ تَلتَهِبُ اِلتِهابا",82,"ب",2,0],["نَمَت كَتِفاها إِلى حارِكٍ","أَشَمَّ كَما أَوفَدَ المِنبَرُ",83,"ر",1,0],["نَمَت في الرَوابي مِن مَعَدٍّ وَأَفلَجَت","عَلى الخَفِراتِ البيضِ وَهِيَ وَليدُ",84,"د",1,1],["نمقته يراعة ذات حول","وبه لوّحت يد بيضاء",85,"ا",2,0],["نم بعيداً في جوف قبرك عمن","يتصدى