غيا","https://www.aldiwan.net/poem24336.html","عموديه"],[494,"سقت العهاد خليط ذاك المعهد","https://www.aldiwan.net/poem67392.html","الكامل"],[501,"عوجا إلى الوادي المقدس بالسرى","https://www.aldiwan.net/poem37817.html","الكامل"],[501,"أهل الحجاب مع الثياب عيونهم","https://www.aldiwan.net/poem38061.html","الكامل"],[515,"خفرت بسيف الغنج ذمة مغفري","https://www.aldiwan.net/poem20789.html","الكامل"],[515,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[515,"لما نهج النوى بالسير شديتم","https://www.aldiwan.net/poem20903.html","المواليا"],[516,"قصدتك من أرض الحطيم قصائد","https://www.aldiwan.net/poem12029.html","الكامل"],[539,"الله بالذكر الجميل حباه","https://www.aldiwan.net/poem47509.html","عموديه"],[539,"مراكش متفاخر متباه","https://www.aldiwan.net/poem47519.html","عموديه"],[539,"قد غاب عبد الله عني من غدا","https://www.aldiwan.net/poem47575.html","عموديه"],[539,"يا ظبية مازلت أتبع ظلها","https://www.aldiwan.net/poem47911.html","عموديه"],[539,"يا طيب الإسم والأفعال والشيم","https://www.aldiwan.net/poem47937.html","عموديه"],[539,"لم أستمع لشكاية من شاك","https://www.aldiwan.net/poem48003.html","عموديه"],[539,"شبل القساور من أبناء مزوار","https://www.aldiwan.net/poem48190.html","عموديه"],[554,"أما النحيب فإني سوف أنتحب","https://www.aldiwan.net/poem68401.html","البسيط"],[554,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[576,"هذا الغرام غرمت آخره","https://www.aldiwan.net/poem2878.html","أحذ الكامل"],[576,"أضحى هلالاً بدر ذاك النادي","https://www.aldiwan.net/poem2962.html","الكامل"],[576,"يا من تجنيه جنايات","https://www.aldiwan.net/poem2981.html","السريع"],[576,"أسير عنك بقلب عن هواك سلا","https://www.aldiwan.net/poem3033.html","البسيط"],[587,"يا ذا الذي يروي الحدي","https://www.aldiwan.net/poem17753.html","مجزوء الكامل"],[587,"لم أنسه لما أتى مقبلا","https://www.aldiwan.net/poem17846.html","السريع"],[588,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"]],"verses":[["لم أَنسَ إن أَنسَ نَعيَ السبطِ مقتلَهُ","غداةَ نكَّسَ وسطَ الخيمةِ العَمَدا",0,"د",2,0],["لَم أَنا مِثلُ الفاطِنِ المُبِنِّ","أَسحَبُ بُردَي ضَرَعٍ وَأَفنِ",1,"ن",1,0],["لَم أَنسَ مَوقِفَنا وَقَد طَلَعَت","كَالشَمسِ تَحتَ حَواجِبِ الدَجنِ",2,"ن",1,0],["لَمّا نَظَرتُ إِلى عُلاكَ غَريبَةٍ","وَمُضَيَّعٌ راعي المَناقِبِ مُهمَلُ",3,"ل",1,0],["لَم أَنسَ مَوقِفَنا وَوَقفَتَهُم","بَعدَ النَوى وَدُموعُنا تَكِفُ",4,"ف",1,0],["لِمَ أَنتَ في هِبَةِ القَليلِ مُناقِشٌ","أَبَداً وَفي عِدَةِ الوِصالِ مُغالِطُ",5,"ط",1,0],["لَمّا نَعاكَ الناعِيانِ مَشى الجَوى","بَينَ القُلوبِ وَضَعضَعَ الأَحشاءَ",6,"ا",2,0],["لمّا نَعَتْهُ المَكْرُماتُ إِلى العُلا","لبِسَ الحِدادَ شَريعَةُ الإسْلامِ",7,"م",1,0],["لمْ أنْسَها منْ وحْشَةٍ والحيُّ قدْ","زجَرَ الحُمولَ وآثَرَ التّغْليسا",8,"س",2,0],["لَم أَنسَ نَحتي لِاِصطِلا","حٍ دونَهُ نَحتُ المَحاجِر",9,"ر",1,1],["لَم أَنسَ ما سالَت بِهِ","مِن خاطِري تِلكَ المَقاطِر",10,"ر",1,1],["لم أنسَ أمركَ للمِقدادِ يَحمِلُه","إلى الجَماعةِ إنذاراً وتَنبيها",11,"ي",3,0],["لَم أَنسَ إِذ باتَت يَدي لَيلَةً","وِشاحَهُ اللاصِقَ دونَ الوِشاح",12,"ح",1,0],["لَم أَنسَهُ إِذ قامَ يَكشِفُ عامِداً","عَن ساقِهِ كَاللُؤلُؤِ البَرّاقِ",13,"ق",1,1],["لم أنسَهُ ليلَ ارتقاب هلاله","والقلب من شك الظهور على غَررْ",14,"ر",1,0],["لم أنس في قلبي صعود غرامها","إذ نحن نصعد في ربا لبنان",15,"ن",1,0],["لم أنس قرب الأعظمية موقفي","والشمس دانية تريد افولا",16,"ل",2,0],["لَمّا نَبَذنا سَلاماً في مُخالَسَةٍ","نَخشى العُيونَ وَبَعضُ القَومِ مَرهوبُ",17,"ب",1,0],["لَمّا نَزَلتُ بِكُم عَرَفتُم حاجَتي","فَجَبَرتَ عَظمي وَاِستَجَدَّ أَديمي",18,"م",2,0],["لم أنسَ ألسنةَ الأحوالِ قائلةً","عوّذْ بياسينَ حسناً للعقولِ سبا",19,"ب",2,0],["لم أنسَ لم أنسَ من إنشائِهِ سُحباً","بآية النظم يتلو قبلها سحبا",20,"ب",2,0],["لم أنسَ إذ وافى يعاتبني","أشهى معاتبةً لذي ذنب",21,"ب",1,0],["لم أنس مخطوبة الأطراف في يدِها","كأس لطرفِي وروحِي منهما قوت",22,"ت",1,1],["لم أنسه كالشيب لما أضا","في الرأس أو في الجلد لما جرح",23,"ح",1,0],["لم أنسَ موقفنا بكاظمةٍ","والعيشُ مثل الدَّار مسوَدّ",24,"د",1,1],["لم أنسَ إذ زارني طيف الخيال بها","يخطو ويخطر بين الحلي والحلل",25,"ل",1,0],["لم أنس في حبه كم ليلةٍ","خلّفني أرعى دجاها البهيم",26,"م",1,0],["لما نال كفي منهمُ نصف درهم","بلى نال قلبي منهم نصف درهم",27,"م",1,0],["لِمْ أنْتَ أصْيَدُ تَزْهَاهُ نظافته","ولِمْ أبُوكَ عليهِ الذُّلُّ والوَسَخُ",28,"خ",1,0],["لم أنلْ منكِ مذ هَوَيتُك حظّاً","من نوالٍ سراً ولا إعلانا",29,"ن",2,0],["لَمّا نَعوهُ نَعَوا إِلَينا سَيِّداً","شَرُفَت خَلائِقُه وَطابَ نِجارُ",30,"ر",1,0],["لَم أَنسَ لَيلاً سَهرَتَهُ مَعَها","تَحنو عَلَينا الأَفنان وَالشَجَرُ",31,"ر",1,0],["لَم أَنسَ طاغِيَةَ المُلوكِ وَقَد هَوى","عَن عَرشِهِ وَأَسيرُهُ لَمّا اِرتَقى",32,"ق",2,0],["لَم أَنسَ حينَ مَشَت إِلَيَّ تَلومَني","لَمّا رَأَتني باسِماً مُتَهَلِّلا",33,"ل",2,1],["لَم أَنسَ قَولَتَها الَّتي مَلَأَت","نَفسي أَسىً وَجَوانِحي شَجَنا",34,"ن",2,0],["لَمّا نَزَلنَ بِجَنبَيهِ دَلَفنَ لَهُ","جَوادِفَ المَشيِ مِنها البُطءُ وَالسَرَعُ",35,"ع",1,0],["لَمّا نأيتَ نأى الكرى عَن ناظِري","وَصرفته لَمّا انصرفتَ عَلَيهِ",36,"ه",1,1],["لَمّا نَماهُم لِلعُلى عمّارُهُم","تَرَكوا قَصيرَةَ الأَعمارِ",37,"ر",1,0],["لَمّا نُعيتَ إِلى الحِجازِ مَشى الأَسى","في الزائِرينَ وَرُوِّعَ الحَرَمانِ",38,"ن",1,0],["لم أَنْسَ من هِبَةِ الزمانِ عَشِيَّةً","سَلَفَتْ بظلِّكِ وانقضَتْ بِذَراكِ",39,"ك",1,0],["لَمّا نَزَلتَ عَلى خَمائِلِهِ ثَوى","نَبعُ البَيانِ وَراءَ نَبعِ الماءِ",40,"ا",2,0],["لَمّا نَزَلتُم في الثَرى","تاهَت عَلى الشُهُبِ القُبور",41,"ر",1,0],["لَمّا نَبا الخُلدُ نابَت عَنهُ نُسخَتُهُ","تَماثُلَ الوَردِ خِيرِيّاً وَنَسرينا",42,"ن",2,0],["لَمّا نَظَرتَ إِلى الدِيا","رِ صَدَفتَ بِالقَلبِ الحَزين",43,"ن",1,0],["لَما نُعيتِ إِلى المَنازِلِ غودِرَت","دَكّاً وَمِثلُكِ في المَنازِلِ ما نُعي",44,"ع",2,0],["لَمّا نَزَلنا عَنهُ في أُمِّ الذُرى","قُمنا عَلى فَرعِ السَليفِ لِنَنظُرا",45,"ر",2,0],["لَمّا نَفَرتِ إِلى القِتالِ جَماعَةً","أَصلَوكِ نارَ تَلَصُّصٍ وَفُتوكِ",46,"ك",1,0],["لَمّا نَظَرْتِ إِلَيَّ عَنْ حَدَقِ المَهَا","وَبَسَمْتِ عن مُتَفَتّحِ النُّوَّارِ",47,"ر",1,1],["لَمّا نُسِبتَ فَكُنتَ اِبناً لِغَيرِ أَبٍ","ثُمَّ اِمتُحِنتَ فَلَم تَرجِع إِلى أَدَبِ",48,"ب",1,1],["لم أنسَهُ والقوسُ في يدِهِ","يرمي غَزالاً مثلَهُ فَرِقَا",49,"ق",2,1],["لم أنسَ والمَيَدانُ ينهَبُ حسنَهُ","نُظَّارَهُ إذ لاحَ فوق الأبرشِ",50,"ش",1,0],["لَم أَنأَ عَمّا كُنتُ فيهِ وَلَم أَغِب","عَن حَظِّ مَكرُمَةٍ وَرَأيُكَ شاهِدُ",51,"د",1,0],["لَم أَنسَهُ وَقَصارُ مَن عَلِقَ الهَوى","أَن يَستَعيدَ الوَجدَ أَو يَتَذَكَّرا",52,"ر",2,0],["لَم أَنسَهُ موشِكاً عَلى عَجَلٍ","مُدامِجاً في الحَديثِ يَختَصِرُه",53,"ر",2,0],["لَم أَنسَ ما سَبَقا إِلَيهِ وَلَم أَكُن","لِيَدِ الصَديقِ المُستَماحِ بِناسِ",54,"س",1,0],["لَم أَنسَ إِذ نوديتُ ما قالَ مالِكٌ","وَنَحنُ قِيامٌ بَينَ أَيدي الرَكايِبِ",55,"ب",1,1],["لَم أَنَل مِنهُ نَوالاً","غَيرَ أَن كَدَّرَ شُربي",56,"ب",2,0],["لَم أَنَل مِنكَ الَّذي قَد","نالَ غَيري مِن نَوالِ",57,"ل",1,0],["لَمّا نَضَت عَنهُ اللَيالي صِبغَها","خَلَعَت عَلَيهِ شَبابَها الأَيّامُ",58,"م",1,0],["لَم أَنسَ ما عِشتُ حَمّاماً دَخَلتُ بِهِ","ما بَينَ كُلِّ رَخيمِ الدَلِّ فَتّانِ",59,"ن",1,1],["لَم أَنسَ في ثَوبٍ شَليلٍ بَرزَتي","بَينَ ثِقافٍ مِن رُماةِ الحِلَّةِ",60,"ه",1,0],["لِما نَجتَني وَما نَجتَلي","مِنَ الشَمسِ وَالبَدرِ",61,"ر",1,0],["لَم أَنسَ إِذ نادَمتُهُ في لَيلَةٍ","عَدَلَ الزَمانُ بِمِثلِها لَم يَمنُنِ",62,"ن",1,0],["لَم أَنسَ لَيلَةَ زارَني وَرَقيبُهُ","يُبدي الرِضا وَهوَ المَغيظُ المُحنَقُ",63,"ق",1,0],["لَم أنس مُهديَتي جلبابَها وعلى","جسمي من السقم منها أيُّ جلبابِ",64,"ب",1,0],["لم أنْتَفِع بالنفسِ عندَ عزائها","فكَأَنّها عينٌ بِغيرِ سوادِ",65,"د",1,0],["لَم أَنسَها وَصُروفُ البَينِ تَظلِمُها","وَلا مُعَوَّلَ إِلّا الواكِفُ السَرِبُ",66,"ب",1,0],["لم أنسَ لا أنسى رسولاً أتى","بنقلتي لا أعدمُ المرسِلا",67,"ل",2,0],["لَم أَنسَ مَوقِفَنا وَمَوقِفَها","لِتَراجُعٍ وَلَحَينُنا يَقِفُ",68,"ف",1,0],["لَم أَنسَ لَيلَةَ رُعتُ سِربَكَ زائِراً","فَكَأَنَّما رَوَّعتُ فيها جُؤذُرا",69,"ر",2,1],["لمّا نُعِيتَ إليَّ في وَضَحِ المُنى","سَدَّ الظّلامُ عليَّ مَطلعَ داري",70,"ر",2,0],["لمّا نُعِيتَ إلى الممالكِ أَجفلتْ","أمُّ القُرى وتفزّعتْ بغدادُ",71,"د",1,0],["لَمْ أَنْتَحِلْها ولَمْ أَغصِبْ مَعانِيها","وَغيرُ مَدْحِكَ مَغْصُوبٌ وَمَنْحُولُ",72,"ل",1,0],["لَمّا نَظَرتُ إِلى الكَرى في عَينِهِ","قَد عَقَّدَ الجَفنَينِ بِالإِغفاءِ",73,"ا",2,0],["لَمّا نَدَبتُكَ لِلمُهِمِّ أَجَبتَني","لَبَّيكَ وَاِستَعذَبتَ ماءَ كَلامي",74,"م",2,0],["لَمّا نَزَعتُ عَنِ الغِوايَةِ وَالصَبا","وَخَدَت بِيَ الشَدَنِيَّةُ المِذعانُ",75,"ن",1,0],["لَم أَنسَها أُصُلاً وَقَد رَكِبَت","شَمسُ النَهارِ لأَرذَلِ العُمرِ",76,"ر",1,0],["لَم أَنسَ ما قالَت وَأَترابُها","في مَعرِكٍ يَنظِمنَ مِسباحا",77,"ح",2,0],["لَم أَنسَ مَجلِسَنا وَقَينَتَها","وَنُباحَ مِزهَرِها إِذا نَبَحا",78,"ح",2,0],["لَم أَنسَها طالَعَت مِن تَحتِ كِلَّتِها","فَأَعلَقَت عامِرِيّاً بَعدَ ما شابا",79,"ب",2,0],["لَم أَنسَ قَولَتَها أَراكَ مُشَيَّعاً","عَبِثَ اليَدَينِ مُوَلَّعاً كَالشارِبِ",80,"ب",1,0],["لَما نَجّاكَ مِن غَيرِ اللَيالي","سَناءٌ فارِعٌ وَغِنىً مُرِبُّ",81,"ب",1,0],["لم أنسَ وقد قُلْتُ لُه الوَصْلُ مَتى","مَولايَ إذا مُتُّ أسى قالَ إذا",82,"ذ",2,0],["لمّا نَزَلَ الشَّيْبُ بِرَأْسِي وَخَطَا","والعُمْرُ معَ الشَبَابْ ولّى وخَطَا",83,"ط",2,1],["لِم أَنت ساكتةٌ بربك أَخبري","هَل عض أَحمدَ للحَوادِث ناب",84,"ب",1,0],["لمّا نعاه ليَ الناعي يخبرني","سكتُّ من دَهشي حيناً وَلَم أُجب",85,"ب",1,0],["لما نعيت لها تزايل حسنها","وصغا الربيع بوجهه وأشاحا",86,"ح",2,0],["لم أنسكم قطُّ أصدقائي","ولم يحُلْ عنكمُ إخائي",87,"ي",1,0],["لَم أَنَل مِنهُم فَسيطاً وَلا","زُبُداً وَلا فُوقَهُ وَلا قَطميرا",88,"ر",2,0],["لَمَا نَازَعَتْنِي النَّفْسُ فِي غَيْرِ حَقِّهَا","وَلا ذَلَّلَتْنِي لِلرِّجَالِ المَطَامِعُ",89,"ع",1,0],["لمْ أَنْسَ حِينَ التَقيْنَا","وَالرَّوْضُ زاهٍ نَضِيرُ",90,"ر",1,0],["لَمَّا نَعَوْهُ نَعَوْا هُمَاماً مَاجِداً","مَلأ النُّهَى بِصِفَاتِهِ إِعْجَابا",91,"ب",2,0],["لَمْ أَنمْ لَيْلتِي ولَمْ أَرَ لِي","راحَةً أَوْ أُفَارِقَ الْفَرْشَا",92,"ش",2,0],["لم أنس حين دخلت روضك غدوة","والزهر بين مزور ومشقق",93,"ق",1,0],["لَمّا نَمى وَاِنتَمى لِفَضلٍ","وَقيلَ مُستَنبطٌ نَبيلُ",94,"ل",1,0],["لَم أَنسَ إِذ قامَت النَواعي","وَجاءَ في قَبضِهِ الرَسولُ",94,"ل",1,0],["لم أنس أسماء النساء وإنما","للحسن أسباب ولي أسباب",95,"ب",1,0],["لمَّا نعى شيخَ القُضاةِ نعاتُه","