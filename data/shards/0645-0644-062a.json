{"poems":[[53,"توقعي أن يقال قد ظعنا","https://www.aldiwan.net/poem29653.html","المنسرح"],[53,"ما للبياض والشعر","https://www.aldiwan.net/poem30486.html","مجزوء الرجز"],[55,"يا إخوتي إني لموضع رحمة","https://www.aldiwan.net/poem26113.html","الكامل"],[77,"إن تورعت أصبحت حوزة","https://www.aldiwan.net/poem36427.html","الخفيف"],[77,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[93,"ألتاج تاج مملكين عظام","https://www.aldiwan.net/poem11386.html","الكامل"],[72,"يا بروقا على ربى يبرين","https://www.aldiwan.net/poem20165.html","الخفيف"],[43,"أحق عاف بدمعك الهمم","https://www.aldiwan.net/poem10537.html","المنسرح"],[62,"إن العيون إذا نطقت تخاوصت","https://www.aldiwan.net/poem52341.html","الكامل"],[45,"بأبي أنت يا ابن وهب وأمي","https://www.aldiwan.net/poem65685.html","الخفيف"],[61,"قم بنا قبل غرة الإصباح","https://www.aldiwan.net/poem51736.html","الخفيف"],[44,"أحسن بأيام العقيق وأطيب","https://www.aldiwan.net/poem30589.html","الكامل"],[69,"ملت بالعقل معرضا","https://www.aldiwan.net/poem28366.html","مجزوء الخفيف"],[69,"له قباء خلت تطريزه","https://www.aldiwan.net/poem29287.html","السريع"],[74,"سمح الخيال على النوى بمزار","https://www.aldiwan.net/poem12955.html","الكامل"],[105,"يا أيها الناس إن الله يأمركم","https://www.aldiwan.net/poem43081.html","البسيط"],[52,"قد أغتدي في صبح ليل فاش","https://www.aldiwan.net/poem26892.html","الرجز"],[48,"قد أغتدي والليل في إهابه","https://www.aldiwan.net/poem62456.html","الرجز"],[48,"وأنمر الجلدة صيرته","https://www.aldiwan.net/poem64451.html","السريع"],[46,"أشهد أني رجل ناقص","https://www.aldiwan.net/poem23271.html","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42503","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54813","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43847","البسيط"],[106,"تأميم القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179582",""],[77,"ما على القلب بعدكم من جناح","https://www.poetsgate.com/ViewPoem.aspx?id=33823",""],[51,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""],[133,"وبأني قد تصفحت الورى","https://www.aldiwan.net/poem54780.html","الخفيف"],[161,"من سلم الحق إلى أربابه","https://www.aldiwan.net/poem59193.html","الرجز"],[162,"ملت عني لما حكاه العذول","https://www.aldiwan.net/poem4115.html","الخفيف"],[230,"وصامت الجو بعيد الفرقد","https://www.aldiwan.net/poem51126.html","الكامل"],[233,"أحبابنا بلوى تهامة ما لكم","https://www.aldiwan.net/poem14842.html","الكامل"],[255,"حبيب العمر","https://www.aldiwan.net/poem36222.html","مجزوء الرمل"],[304,"أشكو إلى دهري خيانة غادة","https://www.aldiwan.net/poem58191.html","الكامل"],[372,"ملتمسا صلح الليالي ومن","https://www.aldiwan.net/poem57510.html","السريع"],[433,"خبراني بهول يوم الفراق","https://www.aldiwan.net/poem12469.html","الخفيف"],[459,"عِمي صباحا بعدنا واسلمي","https://www.aldiwan.net/poem55887.html","السريع"],[459,"الليل بعد اليأس أطمع ناظري","https://www.aldiwan.net/poem56175.html","الكامل"],[459,"ساهرة الليل نؤوم الضحى","https://www.aldiwan.net/poem56309.html","السريع"],[519,"عربي أنا","https://www.aldiwan.net/poem13728.html","عموديه"],[559,"نحن ضياء الغارب الطالع","https://www.aldiwan.net/poem34396.html","السريع"],[559,"إن ديني وملتي واعتقادي","https://www.aldiwan.net/poem34642.html","الخفيف"],[563,"من عاشر الدهر لا يخلو من الهوس","https://www.aldiwan.net/poem52815.html","البسيط"],[568,"وزائر زار وقد تعطرا","https://www.aldiwan.net/poem69669.html","الرجز"],[568,"جد لي ببركارك الذي صنعت","https://www.aldiwan.net/poem69811.html","المنسرح"],[574,"يا من لصبح الشيب كيف تنفسا","https://www.aldiwan.net/poem3649.html","الكامل"]],"verses":[["مُلتَفُّ أَعياصِنا إِلى مُضَرٍ","أَمَرَّ عيدانَنا لِعاجِمِنا",0,"ن",2,0],["مُلتَفِعاً بِشَملَةٍ","فيها البُجاري وَالبُجَر",1,"ر",1,0],["مَلَّت ظَلومُ مَوَدَّتي وَتَخَلَّقَت","لَيتَ التَخَلُّقَ مِن ظَلومَ يَدومُ",2,"م",1,0],["ملْتُ للصّلْحِ سمّوا الصّلْحَ شَرّاً","عكْسَ قوْلِ المُهيْمِنِ الجبّارِ",3,"ر",1,0],["مُلْتَقى حِكْمَةٍ ومَلعَبُ إلْها","مٍ ومَغْنى السّرورِ والأفْراحِ",4,"ح",1,0],["مُلْتَفَّةً بِشيُوخِهَا وَشَبَابِهَا","حَوْلَ الرَّكَائِبِ فِي أَشَدِّ زِحَامِ",5,"م",1,0],["ملتقى القصد مرتقى المدح مهوى ال","رفد غيث الولي غيظ القرين",6,"ن",1,0],["مِلتُ إِلى مَن يَكادُ بَينَكُما","إِن كُنتُما السائِلَينِ يَنقَسِمُ",7,"م",1,0],["ملَّتْ عرانينُ القُنِيِّ رُعافَها","وشكا أناملكَ الحسامُ القاطعُ",8,"ع",1,0],["مِلتَ عَنّي إِلى سِوايَ بِأَفوا","فِ حَديثٍ كَالجَوهَرِ المَنظومِ",9,"م",1,0],["مِلْتَ من رَبْعِهِ إلى رَغَدِ العَي","شِ غُدُوَّاً مُواصَلاً برَواح",10,"ح",1,0],["مُلتَفُّ أَعراقِ الوَشيجِ إِذا اِنتَمى","يَومَ الفَخارِ ثَرِيُّ تَربِ المَنصِبِ",11,"ب",1,0],["مِلْتَ بالعقلِ معْرِضاً","عنْ أحاديثَ كالغررْ",12,"ر",1,1],["ملتفتٌ نحوي كظبي النقا","لا ما لظبيٍ غنجُ عينيهِ",13,"ه",1,0],["مُلتَفَّةٍ أَعطافُهُ بِحَبيَرَةٍ","مَكحولَةٍ أَجفانُهُ بِنُضارِ",14,"ر",1,0],["مِلتُم عَنِ النورِ يَمحو كُلَّ داجِيَةٍ","وَاِنصاعَ رائِدُكُم في الأَرضِ حَيرانا",15,"ن",2,0],["مُلتَقِطٍ لِلكَلَإٍ المُنحاشِ","كَلَقطِكَ المَشيبَ بِالمِنقاشِ",16,"ش",1,0],["مُلتَهِباً يَستَنُّ في التِهابِهِ","كَأَنَّما البَيداءُ مِن نِهابِهِ",17,"ب",2,0],["مُلتَفِتاً يَسحَبُ مِن خَلفِهِ","أَزِمَّةً تَترى وَأَرباقا",18,"ق",2,0],["مَلَّت وَإِن أَحسَنَ أَيّامَهُ","تَقولُ في النَفسِ مَتى يَرتَحِل",19,"ل",1,0],["مُلْتَفِّ أَفْنَانِ الْحَدَائِقِ لَوْ سَرَتْ","فيها السَّمُومُ لَشَابَهَتْ رِيحَ الصَّبَا",20,"ا",1,0],["مُلْتَهِبَانِ ظَمَأً فَذَاقَا","كَأْساً مِزَاجُهَا الْهَوَى وَالسَّعْدُ",21,"د",1,0],["مِلتُ فَعانَقتُكَ اِشتِياقاً","وَلَم أُعانِق سِوى العِظامِ",22,"م",1,0],["مُلْتَقَى البحرين نيلٌ آخَرٌ","في الحمى أحْلَى من الشهد جَناهْ",23,"ا",2,0],["ملتقى حكمة وملقب الهام","ومغنى السرور والأفراح",24,"ح",1,0],["ملتحفِ المكرِ على نَياطِل","مشتمل الشوطِ على مَقاولِ",25,"ل",1,0],["مُلتَظَى الشَّرِّ قَلَّمَا يَحكِهِ","يَومُ صَفِّيَن ولاَ يَومُ الجَمَل",26,"ل",1,0],["ملته من ملة ابن عربي","وليس منك أحد أدرى به",27,"ب",2,0],["مِلتِ عنّي لِما حكاه العذولُ","أيُّ غُصن مع الصَبا لا يَميلُ",28,"ل",1,1],["ملتزِماً هِيفَ الخصورِ المُيَّد","ما أنتِ يا لَيْلي سوى غُصْنٍ ندِ",29,"د",1,0],["مِلتُم عَلَيَّ بِهَجرِكُم وَلَطالَما","أَسرَفتُم بِالوَصلِ في إِسعافي",30,"ف",2,0],["ملتَ عني ثم مالت","كل أحلامي وجِدّي",31,"د",2,0],["ملت ومالت للجفا وأظنها","نسيت عهوداً بالحمى ومنازلا",32,"ل",2,0],["ملتَمساً صلح الليالي ومن","ما بيننا بعد من الصلحِ",33,"ح",1,1],["مِلْتُ إذ ودّعَتْ وقلبيَ في نا","رٍ تلظّى ودمعتي في اندفاقِ",34,"ق",1,0],["ملتقطا سمعُك من جوهر ال","كلام ما أنثره من فمي",35,"م",2,0],["ملَّتْ فكان الغادرُ الناسي بها","أحظَى لديَّ من الوفيِّ الذاكرِ",36,"ر",1,0],["مُلتئمٌ فوها وإن لم يكن","في شفتيها ما لها من لَمَى",37,"ا",1,0],["ملّت من جبني أوردتى","غصّت بالخوف شراييني",38,"ن",2,0],["ملتنا ملة طه الذي","جاء بحال الفارق الجامع",39,"ع",1,0],["ملت عني به إليه لأني","دائماً منه طوع كل مراد",40,"د",1,0],["مَلَّتْ نُجومُ الدُّجى مِمَّا أُراقبُها","حَتَّى كأَنِّي منَ الأَرصادِ والحَرَسِ",41,"س",1,0],["مُلتحِفاً للحرّ ثَوْباً أَصْفَرا","مُعَمّداً مِنَ الحرِيْرِ أخْضَرا",42,"ر",2,0],["ملْتئُم الشفرتيْن معتدلٌ","ما شينَ من جانبٍ ولا عيبا",43,"ب",2,0],["مَلَّت بِطاريقَ الرِجالِ وَشاقَها","صُعلوكُ حَيٍّ لَيسَ يُبقي مُنفِسا",44,"س",2,0]]}