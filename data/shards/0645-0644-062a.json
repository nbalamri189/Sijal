قَد ظَهَرا","لَهُ لِما أَفعَل مِمّا حَظَرا",78,"ر",2,0],["ملتوتة بسمنها","وسمسم مقشر",79,"ر",1,0],["ملت لَيالي مصابى من جَوى وَأَما","وَحملتني أَثقالا عَلى عُنُقي",80,"ق",2,0],["ملته سمحة وأمّته","آمنة اذ همو فدوا بشرا",81,"ر",2,0],["مُلتَقطينَ لِسَقيطِ زَهرٍ","مِن شَجَرٍ في سَحَرٍ قَد اعتَلَى",82,"ا",1,0],["مِلُتُمْ إلى الدنيا لذلك فَاتكُمْ","دنياكمُ والدينُ يا إخوان",83,"ن",1,0],["ملت ارتياحاً اليه لما","كرر لي ذكره وردد",84,"د",1,0],["ملت من الأثقال عن قلب شاور","نوائب لا يقوى بهن يلملم",85,"م",1,0],["ملتقط الجوهر من أيمن ال","وادي سناه للسنا خاطف",86,"ف",1,0],["ملتم عن الإبريق بعد وفائكم","وطرحتموه على الصعيد الأجرد",87,"د",1,0],["ملتكَ من عذلٍ نفسي ولو سبق ال","سيفُ استرحتُ به عن لا وعن نعمِ",88,"م",1,0],["ملتيله بلحظة كبر واعتدلتى","لحظة وقوفه فى شموخ ولباقه",89,"ق",2,0],["ملت وأيم الله نَفسِي نَفسِي","يَا حبذا يَوْم حُلُول رمسى",90,"س",2,1],["ملّتْ سنينُ العمرِ بوحَ جوانحٍ","تبكي..وتضحك حولَها الأتراحُ",91,"ح",1,0],["ملّتْ ربابُ اليلِ أغنيتي","والشمسُ عفَّرَ وجهَها الغِلُْ",92,"ل",1,0],["ملَّتْ دروبُ الصَّبر ِ أن تتحملكْ","ياقلبُ حسبُك صارَ نبلكَ مقتلكْ",93,"ك",1,1],["ملَّتْ قوافي الشِّعرُ تقبسُ جمرَها","من فوق ِخديّ ظالم ٍكي يقبلكْ",93,"ك",1,0],["ملّتْ دروبُ الصَّبر ِ أنْ تتحملكْ","ملّتْ قوافي الشِّعر ِ أن تتهلّلَكْ",93,"ك",1,0],["ملَّتْ أفاعي الكون ِ تنفثُ سمَّها","في جوفِكَ الخاوي لكيما تقتلَكْ",93,"ك",1,0],["ملّتْ جراحُكَ، لا يجفُّ نزيفُها","أترى يُسرُّ الدهرُ أنْ ينكيها",94,"ي",3,0],["ملّت نفوسٌ من الأوجاع وانكسرتْ","أصابها اليأس منْ قتلٍ وتدميرِ",95,"ر",1,1],["ملت عن الذلة في حلوة","للعزة القعساء في المر",96,"ر",1,0],["ملت عيوني من الشوق بكاي","بكية يتيمن ومنهوب دله",97,"ل",2,0],["ملت امانيي على الوجد تختار","متى اشوفك للقى تحتويني",98,"ن",2,0],["ملت ضلوعه ترجف الصدر ضربه","ديسمبره ماسلفه سعر كوته",99,"ت",2,0],["ملتقانا ببطن مكة شعْبا","حيث مسرى الجروح عند الحجونِ",100,"ن",1,0],["ملتاعةٌ والنوى للعمقِ يجذبها","يردي حثيثَ الخطى والوصلُ منعطفُ",101,"ف",1,0],["ملّت العيس حاديها يحطّ ويشيل","ودّها تستريح وترمي أثقالها",102,"ل",3,0],["ملتهم حباً بهذا أو بذا","فهيام القلب للقلب وقوده",103,"د",2,0],["ملتني ، الأ يام ، عَد ٍ وتحسّيب","الله ، من شهر ٍ مضى له ، أعدّه",104,"د",2,0],["ملتهبٌ يا شجرَ الأشواقِ","وكفيفٌ كدموعِ الأحداقِ",105,"ق",1,1],["ملَّت يداي تباريح الأسى ووعت","عيناي قاتِلَها ما خانَها بَصَرُ",106,"ر",1,0]]}