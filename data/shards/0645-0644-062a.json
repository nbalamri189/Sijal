,"هواجس في طقس الوطن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80710&r=&rc=16",""]],"verses":[["مُلتَفُّ أَعياصِنا إِلى مُضَرٍ","أَمَرَّ عيدانَنا لِعاجِمِنا",0,"ن",2,0],["مُلتَفِعاً بِشَملَةٍ","فيها البُجاري وَالبُجَر",1,"ر",1,0],["مَلَّت ظَلومُ مَوَدَّتي وَتَخَلَّقَت","لَيتَ التَخَلُّقَ مِن ظَلومَ يَدومُ",2,"م",1,0],["ملْتُ للصّلْحِ سمّوا الصّلْحَ شَرّاً","عكْسَ قوْلِ المُهيْمِنِ الجبّارِ",3,"ر",1,0],["مُلْتَقى حِكْمَةٍ ومَلعَبُ إلْها","مٍ ومَغْنى السّرورِ والأفْراحِ",4,"ح",1,0],["مُلْتَفَّةً بِشيُوخِهَا وَشَبَابِهَا","حَوْلَ الرَّكَائِبِ فِي أَشَدِّ زِحَامِ",5,"م",1,0],["ملتقى القصد مرتقى المدح مهوى ال","رفد غيث الولي غيظ القرين",6,"ن",1,0],["مِلتُ إِلى مَن يَكادُ بَينَكُما","إِن كُنتُما السائِلَينِ يَنقَسِمُ",7,"م",1,0],["ملَّتْ عرانينُ القُنِيِّ رُعافَها","وشكا أناملكَ الحسامُ القاطعُ",8,"ع",1,0],["مِلتَ عَنّي إِلى سِوايَ بِأَفوا","فِ حَديثٍ كَالجَوهَرِ المَنظومِ",9,"م",1,0],["مِلْتَ من رَبْعِهِ إلى رَغَدِ العَي","شِ غُدُوَّاً مُواصَلاً برَواح",10,"ح",1,0],["مُلتَفُّ أَعراقِ الوَشيجِ إِذا اِنتَمى","يَومَ الفَخارِ ثَرِيُّ تَربِ المَنصِبِ",11,"ب",1,0],["مِلْتَ بالعقلِ معْرِضاً","عنْ أحاديثَ كالغررْ",12,"ر",1,1],["ملتفتٌ نحوي كظبي النقا","لا ما لظبيٍ غنجُ عينيهِ",13,"ه",1,0],["مُلتَفَّةٍ أَعطافُهُ بِحَبيَرَةٍ","مَكحولَةٍ أَجفانُهُ بِنُضارِ",14,"ر",1,0],["مِلتُم عَنِ النورِ يَمحو كُلَّ داجِيَةٍ","وَاِنصاعَ رائِدُكُم في الأَرضِ حَيرانا",15,"ن",2,0],["مُلتَقِطٍ لِلكَلَإٍ المُنحاشِ","كَلَقطِكَ المَشيبَ بِالمِنقاشِ",16,"ش",1,0],["مُلتَهِباً يَستَنُّ في التِهابِهِ","كَأَنَّما البَيداءُ مِن نِهابِهِ",17,"ب",2,0],["مُلتَفِتاً يَسحَبُ مِن خَلفِهِ","أَزِمَّةً تَترى وَأَرباقا",18,"ق",2,0],["مَلَّت وَإِن أَحسَنَ أَيّامَهُ","تَقولُ في النَفسِ مَتى يَرتَحِل",19,"ل",1,0],["مُلْتَفِّ أَفْنَانِ الْحَدَائِقِ لَوْ سَرَتْ","فيها السَّمُومُ لَشَابَهَتْ رِيحَ الصَّبَا",20,"ا",1,0],["مُلْتَهِبَانِ ظَمَأً فَذَاقَا","كَأْساً مِزَاجُهَا الْهَوَى وَالسَّعْدُ",21,"د",1,0],["مِلتُ فَعانَقتُكَ اِشتِياقاً","وَلَم أُعانِق سِوى العِظامِ",22,"م",1,0],["مُلْتَقَى البحرين نيلٌ آخَرٌ","في الحمى أحْلَى من الشهد جَناهْ",23,"ا",2,0],["ملتقى حكمة وملقب الهام","ومغنى السرور والأفراح",24,"ح",1,0],["ملتحفِ المكرِ على نَياطِل","مشتمل الشوطِ على مَقاولِ",25,"ل",1,0],["مُلتَظَى الشَّرِّ قَلَّمَا يَحكِهِ","يَومُ صَفِّيَن ولاَ يَومُ الجَمَل",26,"ل",1,0],["ملته من ملة ابن عربي","وليس منك أحد أدرى به",27,"ب",2,0],["مِلتِ عنّي لِما حكاه العذولُ","أيُّ غُصن مع الصَبا لا يَميلُ",28,"ل",1,1],["ملتزِماً هِيفَ الخصورِ المُيَّد","ما أنتِ يا لَيْلي سوى غُصْنٍ ندِ",29,"د",1,0],["مِلتُم عَلَيَّ بِهَجرِكُم وَلَطالَما","أَسرَفتُم بِالوَصلِ في إِسعافي",30,"ف",2,0],["ملتَ عني ثم مالت","كل أحلامي وجِدّي",31,"د",2,0],["ملت ومالت للجفا وأظنها","نسيت عهوداً بالحمى ومنازلا",32,"ل",2,0],["ملتَمساً صلح الليالي ومن","ما بيننا بعد من الصلحِ",33,"ح",1,1],["مِلْتُ إذ ودّعَتْ وقلبيَ في نا","رٍ تلظّى ودمعتي في اندفاقِ",34,"ق",1,0],["ملتقطا سمعُك من جوهر ال","كلام ما أنثره من فمي",35,"م",2,0],["ملَّتْ فكان الغادرُ الناسي بها","أحظَى لديَّ من الوفيِّ الذاكرِ",36,"ر",1,0],["مُلتئمٌ فوها وإن لم يكن","في شفتيها ما لها من لَمَى",37,"ا",1,0],["ملّت من جبني أوردتى","غصّت بالخوف شراييني",38,"ن",2,0],["ملتنا ملة طه الذي","جاء بحال الفارق الجامع",39,"ع",1,0],["ملت عني به إليه لأني","دائماً منه طوع كل مراد",40,"د",1,0],["مَلَّتْ نُجومُ الدُّجى مِمَّا أُراقبُها","حَتَّى كأَنِّي منَ الأَرصادِ والحَرَسِ",41,"س",1,0],["مُلتحِفاً للحرّ ثَوْباً أَصْفَرا","مُعَمّداً مِنَ الحرِيْرِ أخْضَرا",42,"ر",2,0],["ملْتئُم الشفرتيْن معتدلٌ","ما شينَ من جانبٍ ولا عيبا",43,"ب",2,0],["مَلَّت بِطاريقَ الرِجالِ وَشاقَها","صُعلوكُ حَيٍّ لَيسَ يُبقي مُنفِسا",44,"س",2,0],["ملتبساً بخفضِه ذا كسرِ","معلَّق القلبِ بفعل الأمرِ",45,"ر",1,0],["ملتقى النيرين يحتفل الوا","دي به في السماء والأرض عيدا",46,"د",2,0],["مِلتُ إِلى تَعليمه المَعقولا","وَالتبنَ لا يَعرفه وَالفولا",47,"ل",2,0],["ملتُ إليه وهْو مستسْلِمٌ","ميْلولةَ البازى إلى وكره",48,"ر",2,0],["مِلتِ إِلى غَيري وَإِنّي اِمرُوءً","إِن مالَت الروحُ فَعَنها أَميلْ",49,"ل",1,0],["ملتف أعراف الوشيج إذا أنتمي","أي المنابت والثرى والسؤدد",50,"د",1,0],["ملتف أغصان الفخار إذا أنتمى","زاكي