{"poems":[[108,"تأبط شرا","https://www.shoaraa.com/p12775",""],[53,"أسائل سيفي أي بارقة تجدي","https://www.aldiwan.net/poem30621.html","الطويل"],[53,"خذوا نفثات من جوى القلب نافث","https://www.aldiwan.net/poem30663.html","الكامل"],[93,"نهاية الفخر لي في هذا الكلم","https://www.aldiwan.net/poem11309.html","البسيط"],[88,"تبلج أفق الشرق من بعدما اغبرا","https://www.aldiwan.net/poem44824.html","الطويل"],[51,"لعمرك ما ضيف ابن موسى بصائم","https://www.aldiwan.net/poem66067.html","الطويل"],[43,"ما أنصف القوم ضبه وأمه الطرطبه","https://www.aldiwan.net/poem9511.html","المجتث"],[61,"أكف تغلب أنواء الحيا الجاري","https://www.aldiwan.net/poem51679.html","البسيط"],[74,"كفاني شكوى أن أرى المجد شاكيا","https://www.aldiwan.net/poem13277.html","الطويل"],[81,"أضاع وقاري من علقت جماله","https://www.aldiwan.net/poem61447.html","الطويل"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54771","المتقارب"],[161,"أنحن بهذا الموت أم غيرنا يعنا","https://www.aldiwan.net/poem58708.html","الطويل"],[230,"أبا عبد الإله ووجه ودي","https://www.aldiwan.net/poem50960.html","الوافر"],[236,"ألا من لمسجون بغير جناية","https://www.aldiwan.net/poem31758.html","الطويل"],[238,"لي الله قلبي كم يذوب من الذكرى","https://www.aldiwan.net/poem18191.html","الطويل"],[271,"تصبته ريحا شمأل وجنوب","https://www.aldiwan.net/poem35639.html","الطويل"],[298,"ولما التقينا بالغوير عشية","https://www.aldiwan.net/poem33211.html","الطويل"],[299,"تسر الناظرين فراشتان","https://www.aldiwan.net/poem36854.html","عموديه"],[305,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[362,"تفكرت في جود الاله وعفوه","https://www.aldiwan.net/poem68131.html","الطويل"],[365,"دع العين مني تسكب الدمع أو تفنى","https://www.aldiwan.net/poem60624.html","الطويل"],[365,"خيال زائر مني خيالا","https://www.aldiwan.net/poem60676.html","الوافر"],[367,"وصل كتاب مولا ي بعدما","https://www.aldiwan.net/poem17899.html","الطويل"],[411,"رأيت ابن معن أنطق الناس جوده","https://www.aldiwan.net/poem67471.html","الطويل"],[417,"يهنا أبو عيسى وإخوانه","https://www.aldiwan.net/poem53876.html","السريع"],[417,"هذه يا صاح أوقات الهنا","https://www.aldiwan.net/poem54091.html","الرمل"],[459,"أَصاب أو أخطأني راميا","https://www.aldiwan.net/poem55810.html","السريع"],[459,"لو حملت عتبي الليالي","https://www.aldiwan.net/poem56006.html","مخلع البسيط"],[478,"تمنى فكنتم جل ما يتمناه","https://www.aldiwan.net/poem15345.html","الطويل"],[483,"نسيم الصبا عنعن وسلسل بنافح الت","https://www.aldiwan.net/poem24378.html","عموديه"],[483,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[516,"قدومك أفرح قلب الهدى","https://www.aldiwan.net/poem12068.html","المتقارب"],[530,"وما ذات أفراح جياع بعشها","https://www.aldiwan.net/poem37456.html","الطويل"],[552,"وزور زارني والليل داج","https://www.aldiwan.net/poem47311.html","الوافر"]],"verses":[["وأرخت على جثمانه الكف فاطمٌ","تداوي جراحاتٌ وتنزع أسهما",0,"م",2,0],["وَأَرخى بِعِطفَيهِ حَواشي نِجادِهِ","وَجَرَّ عَلى أَعقابِهِ فاضِلَ البُردِ",1,"د",1,0],["وَأَرخَوا خِناقي بَعدَما كانَ فَتلُهُ","يُغارُ عَلى عُنُقي بِأَيدٍ عَوابِثِ",2,"ث",1,0],["وَأَرْخِصُوا قِيمَ الطَّهْيِ النَّفِيسِ لَهُ","فَرُبَّ غَارِمِ شَيْءٍ جِدُّ مُغَتَنِمِ",3,"م",1,0],["وأرخت بأرض الشام منها على الرُبا","سدولاً بها جوّ السماء قد اغبرّا",4,"ر",2,0],["وأرّخ بالحلواءِ تأريخَ مُحسنٍ","وخيرُ المساعي خيرهُنَّ خواتِما",5,"م",2,0],["وَأَرخَصَ الناسِ أُمّاً","تَبيعُ أَلفاً بِحَبَّه",6,"ب",2,0],["وأرخصَاهُ فقُلْ في العِطرِ مُنْتَهَبَاً","لديهِما يُشتَرى من غَيرِ عَطَّارِ",7,"ر",1,0],["وَأُرخِصُ أَعلاقَ الدُموعِ صَبابَةً","وَعَهدي بِأَعلاقِ الدُموعِ غَوالِيا",8,"ي",2,0],["وَأَرخَصتُ عُمُري فيهِ وَهوَ ذَخيرَتي","وَأَنفَقتُ فيهِ كَنزَ صَبري وَإِناسي",9,"س",2,0],["وَإِرخاءِ سِيدٍ إِلى هَضبَةٍ","يُوائِلُ مِن بَرَدِ مُهذِبِ",10,"ب",1,0],["وَأَرْخَتْ ضَفَائِرَهَا فَارْتَمَتْ","إِلى مَنْكِبَيْهَا مِنَ المَعْقدِ",11,"د",1,0],["وارخوا شابيب الدموع وكاثروا","بها الوبل حتى يسكب الحسب الجفنا",12,"ن",2,0],["وأَرْخُصُ إن غَلوتَ وكلُّ عِلْقٍ","إذا ما ضاع تاجره مضاع",13,"ع",1,0],["وَأَرخَصَ مِنهُ الدَهرُ ما كانَ غالِياً","عَلى مُشتَري الأَحزانِ في الناسِ سَومُهُ",14,"م",2,0],["وَأَرْخَى عَلَى ضَوْءِ النَّهَارِ سُتُورَهُ","وَبَاتَتْ نُجُومُ الأُفْقِ تَزْجُرُهُ زَجْرَا",15,"ر",2,0],["وأرخَت عليهِ ليلةُ الصّيفِ سدلَها","مُوشّىً بلوني لامعٍ ورَطيب",16,"ب",1,0],["وأَرخى أَثيثاً أَوهمَ الليلَ لونُه","ومن أَينَ للَّون البَهيم مَفارِقُ",17,"ق",1,0],["وأَرختْ منهما فبدت كحليٍ","تلأْلأَ فوق لَبّاتِ الحسان",18,"ن",1,0],["وأرخ بهاء الدر أسنا وجوهنا","فعم في مراسيها لالباس صبيان",19,"ن",1,0],["وَأَرخته يا رب جودك واسِع","وَعبدك اسماعيل يرجوك يا رَبّي",20,"ب",2,0],["وأرخَى وقد أجرَى عِنانَ ابْن همّةٍ","أبَى دونَ أقصَى غايةِ الهمّ أن يُثْنى",21,"ن",2,0],["وأُرخِصُ في امتِداحِكَ دُرَّ فكري","وفي دُرّي حَقيقٌ أَن يُغالى",22,"ل",2,0],["وَأَرَّختُ وُصولَهُ","فَكانَ لِأَيّامِ المَواسِمِ مَوسِما",23,"م",2,0],["وَأَرخَصَ بِالعَدلِ السِلاحِ بِأَرضِنا","فَما يَبلُغُ السَيفُ المُهَنَّدُ دِرهِما",24,"م",2,0],["وأرَّخوه المصطفى عَقْدُهُ","عَقْدُ نكاحٍ بالهنا والسرور",25,"ر",1,0],["وأرخني إنَّما ألقى العنا","من خليلٍ مغرم بالعذلِ",26,"ل",1,0],["وأرْخت الأيّام عن رِبقتي","أمرَحُ أو أقطعُ أرسانيا",27,"ي",2,0],["وأرخَصُ الناسِ بي سماحاً","من أنا في حبّه أغالي",28,"ل",2,0],["وأرخصَ في يومِ التفرُّقِ دمعَهُ","بحكمِ النوى والهجرِ ما كانَ أغلاهُ",29,"ا",2,0],["وأرخى زمان البين راووق فرقة","فأٌصى قلوبا عن مشاهدة السر",30,"ر",1,0],["وأرخى زمان الول راووق سجفه","فغنى وأغنى عن وصال قيان",31,"ن",1,0],["وأرخى على الدجى أبيضاً","وقد كان نور الضحى أسودا",32,"د",2,0],["وأَرْخَتْ جَنَاحَيْها مِنَ الضَّعْفِ والْتَوَتْ","عَلَى فَرْعِ دَوْحٍ مِنْ بَنيها بِمَشْهَدِ",33,"د",1,0],["وأرخص قربَه باللّيل مَن لو","سألنا قربه بالصّبحِ أغلى",34,"ل",2,0]]}