{"poems":[[110,"تأبط شرا","https://www.shoaraa.com/p12775",""],[55,"أسائل سيفي أي بارقة تجدي","https://www.aldiwan.net/poem30621.html","الطويل"],[55,"خذوا نفثات من جوى القلب نافث","https://www.aldiwan.net/poem30663.html","الكامل"],[95,"نهاية الفخر لي في هذا الكلم","https://www.aldiwan.net/poem11309.html","البسيط"],[90,"تبلج أفق الشرق من بعدما اغبرا","https://www.aldiwan.net/poem44824.html","الطويل"],[53,"لعمرك ما ضيف ابن موسى بصائم","https://www.aldiwan.net/poem66067.html","الطويل"],[45,"ما أنصف القوم ضبه وأمه الطرطبه","https://www.aldiwan.net/poem9511.html","المجتث"],[63,"أكف تغلب أنواء الحيا الجاري","https://www.aldiwan.net/poem51679.html","البسيط"],[76,"كفاني شكوى أن أرى المجد شاكيا","https://www.aldiwan.net/poem13277.html","الطويل"],[83,"أضاع وقاري من علقت جماله","https://www.aldiwan.net/poem61447.html","الطويل"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54771","المتقارب"],[164,"أنحن بهذا الموت أم غيرنا يعنا","https://www.aldiwan.net/poem58708.html","الطويل"],[234,"أبا عبد الإله ووجه ودي","https://www.aldiwan.net/poem50960.html","الوافر"],[240,"ألا من لمسجون بغير جناية","https://www.aldiwan.net/poem31758.html","الطويل"],[242,"لي الله قلبي كم يذوب من الذكرى","https://www.aldiwan.net/poem18191.html","الطويل"],[275,"تصبته ريحا شمأل وجنوب","https://www.aldiwan.net/poem35639.html","الطويل"],[302,"ولما التقينا بالغوير عشية","https://www.aldiwan.net/poem33211.html","الطويل"],[303,"تسر الناظرين فراشتان","https://www.aldiwan.net/poem36854.html","عموديه"],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[366,"تفكرت في جود الاله وعفوه","https://www.aldiwan.net/poem68131.html","الطويل"],[369,"دع العين مني تسكب الدمع أو تفنى","https://www.aldiwan.net/poem60624.html","الطويل"],[369,"خيال زائر مني خيالا","https://www.aldiwan.net/poem60676.html","الوافر"],[371,"وصل كتاب مولا ي بعدما","https://www.aldiwan.net/poem17899.html","الطويل"],[416,"رأيت ابن معن أنطق الناس جوده","https://www.aldiwan.net/poem67471.html","الطويل"],[422,"يهنا أبو عيسى وإخوانه","https://www.aldiwan.net/poem53876.html","السريع"],[422,"هذه يا صاح أوقات الهنا","https://www.aldiwan.net/poem54091.html","الرمل"],[463,"أَصاب أو أخطأني راميا","https://www.aldiwan.net/poem55810.html","السريع"],[463,"لو حملت عتبي الليالي","https://www.aldiwan.net/poem56006.html","مخلع البسيط"],[482,"تمنى فكنتم جل ما يتمناه","https://www.aldiwan.net/poem15345.html","الطويل"],[487,"نسيم الصبا عنعن وسلسل بنافح الت","https://www.aldiwan.net/poem24378.html","عموديه"],[487,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[520,"قدومك أفرح قلب الهدى","https://www.aldiwan.net/poem12068.html","المتقارب"],[534,"وما ذات أفراح جياع بعشها","https://www.aldiwan.net/poem37456.html","الطويل"],[556,"وزور زارني والليل داج","https://www.aldiwan.net/poem47311.html","الوافر"],[966,"","https://poetry.dctabudhabi.ae/diwan/poem/146425","المتقارب"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62493","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1282,"","https://poetry.dctabudhabi.ae/diwan/poem/105279","الرجز"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102323","الطويل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93090","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122027","المتقارب"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128706","البسيط"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111832","الطويل"],[1616,"","https://poetry.dctabudhabi.ae/diwan/poem/206236",""],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114777","الطويل"],[2027,"","https://poetry.dctabudhabi.ae/diwan/poem/101857","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71073","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71069","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53115","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93595","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93926","الطويل"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113874","الرجز"],[2912,"","https://poetry.dctabudhabi.ae/diwan/poem/178171","الطويل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109838","البسيط"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112564","المتقارب"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112648","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89065","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89049","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138562",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138554",""],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129338","المتقارب"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129468","السريع"],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140276",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105557","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119619","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90798","الطويل"],[4286,"","https://poetry.dctabudhabi.ae/diwan/poem/123472","الطويل"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67636","الوافر"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136566",""],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33152","الطويل"],[4679,"أما لأبي البرية أن يعادا","https://www.poetsgate.com/ViewPoem.aspx?id=142720",""],[4755,"إِذا سَلَّطَ اللهُ فَردًا على","https://www.poetsgate.com/ViewPoem.aspx?id=193474",""],[4119,"رنا وكأن البابلي المصفقا","https://www.poetsgate.com/ViewPoem.aspx?id=16197",""],[5038,"تراءى","https://www.poetsgate.com/ViewPoem.aspx?id=190109",""],[5213,"لهوّن بعد اليوم ما يفعل الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=170487",""],[5219,"شدوا الرحال","https://www.poetsgate.com/ViewPoem.aspx?id=195038",""],[592,"لعمرك ما يدري الغبي بأنه","https://www.poetsgate.com/ViewPoem.aspx?id=128805",""],[5397,"سقيت ربوعا بالحمى ومعالما","https://www.poetsgate.com/ViewPoem.aspx?id=157964",""],[5480,"لزيم القلب","https://www.poetsgate.com/ViewPoem.aspx?id=21011",""],[5956,"مرحلة مُمْتِعة معَ عِرْق السُّوس","https://www.poetsgate.com/ViewPoem.aspx?id=184840",""],[5956,"أخاف عليه من جِلْدي","https://www.poetsgate.com/ViewPoem.aspx?id=193083",""],[5997,"وصايا","https://www.poetsgate.com/ViewPoem.aspx?id=214221",""],[5997,"وحي المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=214233",""],[6056,"كأس المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=130314",""],[6068,"ورثنا المجد ميراث فرض -15-","https://www.poetsgate.com/ViewPoem.aspx?id=175886",""],[6102,"هاتِف","https://www.poetsgate.com/ViewPoem.aspx?id=185295",""],[5190,"صوتٌ من القدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78349&r=&rc=62",""]],"verses":[["وأرخت على جثمانه الكف فاطمٌ","تداوي جراحاتٌ وتنزع أسهما",0,"م",2,0],["وَأَرخى بِعِطفَيهِ حَواشي نِجادِهِ","وَجَرَّ عَلى أَعقابِهِ فاضِلَ البُردِ",1,"د",1,0],["وَأَرخَوا خِناقي بَعدَما كانَ فَتلُهُ","يُغارُ عَلى عُنُقي بِأَيدٍ عَوابِثِ",2,"ث",1,0],["وَأَرْخِصُوا قِيمَ الطَّهْيِ النَّفِيسِ لَهُ","فَرُبَّ غَارِمِ شَيْءٍ جِدُّ مُغَتَنِمِ",3,"م",1,0],["وأرخت بأرض الشام منها على الرُبا","سدولاً بها جوّ السماء قد اغبرّا",4,"ر",2,0],["وأرّخ بالحلواءِ تأريخَ مُحسنٍ","وخيرُ المساعي خيرهُنَّ خواتِما",5,"م",2,0],["وَأَرخَصَ الناسِ أُمّاً","تَبيعُ أَلفاً بِحَبَّه",6,"ب",2,0],["وأرخصَاهُ فقُلْ في العِطرِ مُنْتَهَبَاً","لديهِما يُشتَرى من غَيرِ عَطَّارِ",7,"ر",1,0],["وَأُرخِصُ أَعلاقَ الدُموعِ صَبابَةً","وَعَهدي بِأَعلاقِ الدُموعِ غَوالِيا",8,"ي",2,0],["وَأَرخَصتُ عُمُري فيهِ وَهوَ ذَخيرَتي","وَأَنفَقتُ فيهِ كَنزَ صَبري وَإِناسي",9,"س",2,0],["وَإِرخاءِ سِيدٍ إِلى هَضبَةٍ","يُوائِلُ مِن بَرَدِ مُهذِبِ",10,"ب",1,0],["وَأَرْخَتْ ضَفَائِرَهَا فَارْتَمَتْ","إِلى مَنْكِبَيْهَا مِنَ المَعْقدِ",11,"د",1,0],["وارخوا شابيب الدموع وكاثروا","بها الوبل حتى يسكب الحسب الجفنا",12,"ن",2,0],["وأَرْخُصُ إن غَلوتَ وكلُّ عِلْقٍ","إذا ما ضاع تاجره مضاع",13,"ع",1,0],["وَأَرخَصَ مِنهُ الدَهرُ ما كانَ غالِياً","عَلى مُشتَري الأَحزانِ في الناسِ سَومُهُ",14,"م",2,0],["وَأَرْخَى عَلَى ضَوْءِ النَّهَارِ سُتُورَهُ","وَبَاتَتْ نُجُومُ الأُفْقِ تَزْجُرُهُ زَجْرَا",15,"ر",2,0],["وأرخَت عليهِ ليلةُ الصّيفِ سدلَها","مُوشّىً بلوني لامعٍ ورَطيب",16,"ب",1,0],["وأَرخى أَثيثاً أَوهمَ الليلَ لونُه","ومن أَينَ للَّون البَهيم مَفارِقُ",17,"ق",1,0],["وأَرختْ منهما فبدت كحليٍ","تلأْلأَ فوق لَبّاتِ الحسان",18,"ن",1,0],["وأرخ بهاء الدر أسنا وجوهنا","فعم في مراسيها لالباس صبيان",19,"ن",1,0],["وَأَرخته يا رب جودك واسِع","وَعبدك اسماعيل يرجوك يا رَبّي",20,"ب",2,0],["وأرخَى وقد أجرَى عِنانَ ابْن همّةٍ","أبَى دونَ أقصَى غايةِ الهمّ أن يُثْنى",21,"ن",2,0],["وأُرخِصُ في امتِداحِكَ دُرَّ فكري","وفي دُرّي حَقيقٌ أَن يُغالى",22,"ل",2,0],["وَأَرَّختُ وُصولَهُ","فَكانَ لِأَيّامِ المَواسِمِ مَوسِما",23,"م",2,0],["وَأَرخَصَ بِالعَدلِ السِلاحِ بِأَرضِنا","فَما يَبلُغُ السَيفُ المُهَنَّدُ دِرهِما",24,"م",2,0],["وأرَّخوه المصطفى عَقْدُهُ","عَقْدُ نكاحٍ بالهنا والسرور",25,"ر",1,0],["وأرخني إنَّما ألقى العنا","من خليلٍ مغرم بالعذلِ",26,"ل",1,0],["وأرْخت الأيّام عن رِبقتي","أمرَحُ أو أقطعُ أرسانيا",27,"ي",2,0],["وأرخَصُ الناسِ بي سماحاً","من أنا في حبّه أغالي",28,"ل",2,0],["وأرخصَ في يومِ التفرُّقِ دمعَهُ","بحكمِ النوى والهجرِ ما كانَ أغلاهُ",29,"ا",2,0],["وأرخى زمان البين راووق فرقة","فأٌصى قلوبا عن مشاهدة السر",30,"ر",1,0],["وأرخى زمان الول راووق سجفه","فغنى وأغنى عن وصال قيان",31,"ن",1,0],["وأرخى على الدجى أبيضاً","وقد كان نور الضحى أسودا",32,"د",2,0],["وأَرْخَتْ جَنَاحَيْها مِنَ الضَّعْفِ والْتَوَتْ","عَلَى فَرْعِ دَوْحٍ مِنْ بَنيها بِمَشْهَدِ",33,"د",1,0],["وأرخص قربَه باللّيل مَن لو","سألنا قربه بالصّبحِ أغلى",34,"ل",2,0],["وأرخصتَ دمعي يوم النوى","لأجل سوالفك الغاليه",35,"ي",2,0],["وأرخى علينا الأنس بُرداً موشحاً","بحالية من طيّبات اعتداله",36,"ل",2,0],["وأرخصهم لما على الفوز فاشتروا","سعير هوان سعرته جهنم",37,"م",1,0],["وأرخصوا ما هو غال فيهم","لديهم العسجد مثل الخزف",38,"ف",1,0],["وأرخص دمع العين وجداً بمبسم","يقابله من دره بثمينه",39,"ن",2,0],["وأرخِ لها فضل الزمام وخلها","تدوس لدى الإدلاج هام المتارب",40,"ب",1,0],["وَأَرْخَتْ سُتُوراً عَلَيْهَا الغَمَامُ","تَمَارَى بِمَكَّةَ مَنْ قَدْ تَمَارَى",41,"ر",2,0],["وأرخصوا مهج الأطفال فاشتريت","بحبة واستبيح اللحم والعصب",42,"ب",1,0],["وأُرخص دمعى للضعيف اذا شكا","ودمعي لنفسي في النوازل غالِ",43,"ل",1,1],["وارخص سبيل السعر حقّ الدكاكين","كم واحدٍ فيها تربّح متاعه",44,"ع",2,0],["وأرّخ آلُ اللَه دهراً بمَوتِهِ","سِنين سُدىً يُتعِبنَ كَفَّ المُحَسِّبِ",45,"ب",1,0],["وأرخصت نفسا لا توازن قيمة","بجملة هذا الكون للواحد الفرد",46,"د",1,0],["وإِرخاصُ نفسي كلَّ يومِ كَرِيهَةٍ","على الموت أَعلاها على الثَّقَلان",47,"ن",1,0],["وأًرْخِىَ عنه والغلاصِمُ ضيقةٌ","بحَوْباه من دون الأَنام خِناقُ",48,"ق",1,1],["وأرخى على ديباجة الخدّ صدغه","فسبحان كاسيه الجمال مشهرا",49,"ر",2,0],["وَأرخ قلوصك أَنَّهُ","قَد غابَ منتجع الوَرى",50,"ر",2,0],["وأرخت لي بالدر نظم فأرخي","أيا دولة فاقت مآثرها الدول",51,"ل",1,0],["وأرخ لها زمامها يا صاحبي","وخلها تنساب في السباسب",52,"ب",1,0],["وأرخت نقاباً بين طرفي وجهها","فخلت بأن الشمس تحت نقابها",53,"ه",2,0],["وارخصوا ادمعاً تؤاماً","من دونها اللؤلؤ التوام",54,"م",1,0],["وأرخصت الذادة الروح كبرا","وهان عليهم عزيز الدماء",55,"ا",2,0],["وأرخَصوا النُفوسَ والأرواحا","وصافَحوا الصفاحَ والرِماحا",56,"ح",2,0],["وأرخت في شطر زواج أخيكم","وفي الشطر ختن المفردين بمفرد",57,"د",1,0],["وأرخْ فبشرى بالخديوي مؤرخاً","مضى عني محمود وعبد المجيد جد",58,"د",1,0],["وارخص النفس التي تفدى بما","حوى الوجود مشرق ومغرب",59,"ب",1,0],["وارخص شيء عندها في طلابها","مراتب عز بالحسام المصمم",60,"م",1,0],["وأرخ وناد بورادها","هنيئا مريئا لمن يشرب",61,"ب",1,0],["وأرخن اكرم به مسجداً","على تقى أسس بنيانه",62,"ن",2,0],["وأرخى له فوق المتون ذوائباً","وناط عليه كف مارية القرطا",63,"ط",2,0],["وَأَرخُوا مِنَ الزَّرقا سََلاسِلَ عَسجَدٍ","وَكُلُّكُمُ في مُنتَهاها تَأَلَّفُوا",64,"ف",3,0],["وأرخى بذاك الحي صوب سحابةٍ","ترواح في ساحاته وتؤوب",65,"ب",1,0],["وأرخ لحب العز والعزُّ طيّب","لفي كل شطر ما يسرُّك فاجمل",66,"ل",1,0],["وارخت على الأرداف شقر ذوائب","فدبت على الكثبان رقش الأراقم",67,"م",1,0],["وأرِّخهُ شامَ البدر مِن بعدِ ستَّةٍ","وخمسين مَن أضحى بَصيرا مُؤيَّدا",68,"د",2,0],["وأرخصتُ الثناء فعفتموهُ","وربَّتَما غلا الشيء الرخيصُ",69,"ص",1,0],["وأرخت على صُبح المحيّا براقعاً","من الليل إلاّ أنّهن غَدائر",70,"ر",1,0],["وأرخى جفوناً متن من جفوة الكرى","يجدّدن دماً لا يزالُ غريبا",71,"ب",2,0],["وأرخت فوق دنيانا جناحاً","يظللها فيلبسها حدادا",72,"د",2,0],["وأَرخَت لَهُ الحَبلَ.. لا خَشيَةً","ولكن كما تُخدَعُ الماشِية",73,"ش",3,0],["وأرخص شوقي في الهوى صدق خلتي","ويهدي النفاق من أراد التنفقا",74,"ق",2,0],["وأرْخى بضُّ كفٍّ عنْ خِمارٍ","أحالَ الْجيدَ جُمّاراً مَريّا",75,"ي",2,0],["وأرخى على الدنيا ثياب حداده","فلست ترى شمسا وقد أفل البدر",76,"ر",1,0],["٣- وأرخصت دمعي لأرض تنادي","تئنّ الليالي الليالي الطوال",77,"ل",1,0],["وأرخى عنان الجهل والظلم خالياً","من العقل والبرهان والشرع مأتما",78,"م",2,0],["وأرخى جعادا فوق صدر قناته","تظن بها الأعداء سودا أراقما",79,"م",2,0],["وأرخص مذ أعطاه للموت رخصة","به أدمعا أضحى لها الغر ناظما",79,"م",2,0],["وأرخيت الضعن مطلب ودادك","خضع لك قلب مولع باتساعه",80,"ع",2,0],["وأرَّخت فنِّي وفقَ وحْيِ طفولتي","وليس كبعضِ الناس مِمَّا تطالعُ",81,"ع",1,0],["وأرّخ عطر سيرته","فقيرٌ فاز بالرِّفدِ",82,"د",1,0],["وَأَرْخَى دُجَى الْإِظْلَامِ فِينَا سُدُولَهُ","وَصَلَّى إمَامُ الْخَوْفِ فِينَا مُجَدَّدا",83,"د",2,0],["وَأَرْخَى سُهَيْلُ الْعِبْرُ دلماْ حزينةً","وَغَابَتْ رُؤَى الأنجاْم فَوَاحَةَ الأدبْ",84,"ب",1,0],["وأرخص بحالي ومالي وكل عمري له رهيني","قلت أناال ..! وطالعتني واغمزت قالت لي إيه",85,"ي",2,0],["وأرخى للطفولة كل سيف","يُذبّح طهرهم غلا وحقدا",86,"د",2,0],["وَأَرخَى سُدُولَ الهَمِّ حَولِي قَنابِلًا","فَبِتُّ كَأَنَّ الهَمَّ- صَبريَ - ناسِفُ",87,"ف",1,0],["وأرخت على مقلتيهِ سدولاً","فما عاد يُبصرُ أو يستجيب",88,"ب",1,0]]}