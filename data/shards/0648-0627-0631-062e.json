{"poems":[[53,"أسائل سيفي أي بارقة تجدي","https://www.aldiwan.net/poem30621.html","الطويل"],[53,"خذوا نفثات من جوى القلب نافث","https://www.aldiwan.net/poem30663.html","الكامل"],[93,"نهاية الفخر لي في هذا الكلم","https://www.aldiwan.net/poem11309.html","البسيط"],[88,"تبلج أفق الشرق من بعدما اغبرا","https://www.aldiwan.net/poem44824.html","الطويل"],[51,"لعمرك ما ضيف ابن موسى بصائم","https://www.aldiwan.net/poem66067.html","الطويل"],[43,"ما أنصف القوم ضبه وأمه الطرطبه","https://www.aldiwan.net/poem9511.html","المجتث"],[61,"أكف تغلب أنواء الحيا الجاري","https://www.aldiwan.net/poem51679.html","البسيط"],[74,"كفاني شكوى أن أرى المجد شاكيا","https://www.aldiwan.net/poem13277.html","الطويل"],[81,"أضاع وقاري من علقت جماله","https://www.aldiwan.net/poem61447.html","الطويل"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54771","المتقارب"],[160,"أنحن بهذا الموت أم غيرنا يعنا","https://www.aldiwan.net/poem58708.html","الطويل"],[229,"أبا عبد الإله ووجه ودي","https://www.aldiwan.net/poem50960.html","الوافر"],[235,"ألا من لمسجون بغير جناية","https://www.aldiwan.net/poem31758.html","الطويل"],[237,"لي الله قلبي كم يذوب من الذكرى","https://www.aldiwan.net/poem18191.html","الطويل"],[270,"تصبته ريحا شمأل وجنوب","https://www.aldiwan.net/poem35639.html","الطويل"],[297,"ولما التقينا بالغوير عشية","https://www.aldiwan.net/poem33211.html","الطويل"],[298,"تسر الناظرين فراشتان","https://www.aldiwan.net/poem36854.html","عموديه"],[304,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[361,"تفكرت في جود الاله وعفوه","https://www.aldiwan.net/poem68131.html","الطويل"],[364,"دع العين مني تسكب الدمع أو تفنى","https://www.aldiwan.net/poem60624.html","الطويل"],[364,"خيال زائر مني خيالا","https://www.aldiwan.net/poem60676.html","الوافر"],[366,"وصل كتاب مولا ي بعدما","https://www.aldiwan.net/poem17899.html","الطويل"],[410,"رأيت ابن معن أنطق الناس جوده","https://www.aldiwan.net/poem67471.html","الطويل"],[416,"يهنا أبو عيسى وإخوانه","https://www.aldiwan.net/poem53876.html","السريع"],[416,"هذه يا صاح أوقات الهنا","https://www.aldiwan.net/poem54091.html","الرمل"],[458,"أَصاب أو أخطأني راميا","https://www.aldiwan.net/poem55810.html","السريع"],[458,"لو حملت عتبي الليالي","https://www.aldiwan.net/poem56006.html","مخلع البسيط"],[477,"تمنى فكنتم جل ما يتمناه","https://www.aldiwan.net/poem15345.html","الطويل"],[482,"نسيم الصبا عنعن وسلسل بنافح الت","https://www.aldiwan.net/poem24378.html","عموديه"],[482,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[515,"قدومك أفرح قلب الهدى","https://www.aldiwan.net/poem12068.html","المتقارب"],[529,"وما ذات أفراح جياع بعشها","https://www.aldiwan.net/poem37456.html","الطويل"],[551,"وزور زارني والليل داج","https://www.aldiwan.net/poem47311.html","الوافر"]],"verses":[["وَأَرخى بِعِطفَيهِ حَواشي نِجادِهِ","وَجَرَّ عَلى أَعقابِهِ فاضِلَ البُردِ",0,"د",1,0],["وَأَرخَوا خِناقي بَعدَما كانَ فَتلُهُ","يُغارُ عَلى عُنُقي بِأَيدٍ عَوابِثِ",1,"ث",1,0],["وَأَرْخِصُوا قِيمَ الطَّهْيِ النَّفِيسِ لَهُ","فَرُبَّ غَارِمِ شَيْءٍ جِدُّ مُغَتَنِمِ",2,"م",1,0],["وأرخت بأرض الشام منها على الرُبا","سدولاً بها جوّ السماء قد اغبرّا",3,"ر",2,0],["وأرّخ بالحلواءِ تأريخَ مُحسنٍ","وخيرُ المساعي خيرهُنَّ خواتِما",4,"م",2,0],["وَأَرخَصَ الناسِ أُمّاً","تَبيعُ أَلفاً بِحَبَّه",5,"ب",2,0],["وأرخصَاهُ فقُلْ في العِطرِ مُنْتَهَبَاً","لديهِما يُشتَرى من غَيرِ عَطَّارِ",6,"ر",1,0],["وَأُرخِصُ أَعلاقَ الدُموعِ صَبابَةً","وَعَهدي بِأَعلاقِ الدُموعِ غَوالِيا",7,"ي",2,0],["وَأَرخَصتُ عُمُري فيهِ وَهوَ ذَخيرَتي","وَأَنفَقتُ فيهِ كَنزَ صَبري وَإِناسي",8,"ي",1,0],["وَإِرخاءِ سِيدٍ إِلى هَضبَةٍ","يُوائِلُ مِن بَرَدِ مُهذِبِ",9,"ب",1,0],["وَأَرْخَتْ ضَفَائِرَهَا فَارْتَمَتْ","إِلى مَنْكِبَيْهَا مِنَ المَعْقدِ",10,"د",1,0],["وارخوا شابيب الدموع وكاثروا","بها الوبل حتى يسكب الحسب الجفنا",11,"ن",2,0],["وأَرْخُصُ إن غَلوتَ وكلُّ عِلْقٍ","إذا ما ضاع تاجره مضاع",12,"ع",1,0],["وَأَرخَصَ مِنهُ الدَهرُ ما كانَ غالِياً","عَلى مُشتَري الأَحزانِ في الناسِ سَومُهُ",13,"م",2,0],["وَأَرْخَى عَلَى ضَوْءِ النَّهَارِ سُتُورَهُ","وَبَاتَتْ نُجُومُ الأُفْقِ تَزْجُرُهُ زَجْرَا",14,"ر",2,0],["وأرخَت عليهِ ليلةُ الصّيفِ سدلَها","مُوشّىً بلوني لامعٍ ورَطيب",15,"ب",1,0],["وأَرخى أَثيثاً أَوهمَ الليلَ لونُه","ومن أَينَ للَّون البَهيم مَفارِقُ",16,"ق",1,0],["وأَرختْ منهما فبدت كحليٍ","تلأْلأَ فوق لَبّاتِ الحسان",17,"ن",1,0],["وأرخ بهاء الدر أسنا وجوهنا","فعم في مراسيها لالباس صبيان",18,"ن",1,0],["وَأَرخته يا رب جودك واسِع","وَعبدك اسماعيل يرجوك يا رَبّي",19,"ب",2,0],["وأرخَى وقد أجرَى عِنانَ ابْن همّةٍ","أبَى دونَ أقصَى غايةِ الهمّ أن يُثْنى",20,"ن",2,0],["وأُرخِصُ في امتِداحِكَ دُرَّ فكري","وفي دُرّي حَقيقٌ أَن يُغالى",21,"ل",2,0],["وَأَرَّختُ وُصولَهُ","فَكانَ لِأَيّامِ المَواسِمِ مَوسِما",22,"م",2,0],["وَأَرخَصَ بِالعَدلِ السِلاحِ بِأَرضِنا","فَما يَبلُغُ السَيفُ المُهَنَّدُ دِرهِما",23,"م",2,0],["وأرَّخوه المصطفى عَقْدُهُ","عَقْدُ نكاحٍ بالهنا والسرور",24,"ر",1,0],["وأرخني إنَّما ألقى العنا","من خليلٍ مغرم بالعذلِ",25,"ل",1,0],["وأرْخت الأيّام عن رِبقتي","أمرَحُ أو أقطعُ أرسانيا",26,"ي",2,0],["وأرخَصُ الناسِ بي سماحاً","من أنا في حبّه أغالي",27,"ي",1,0],["وأرخصَ في يومِ التفرُّقِ دمعَهُ","بحكمِ النوى والهجرِ ما كانَ أغلاهُ",28,"ا",2,0],["وأرخى زمان البين راووق فرقة","فأٌصى قلوبا عن مشاهدة السر",29,"ر",1,0],["وأرخى زمان الول راووق سجفه","فغنى وأغنى عن وصال قيان",30,"ن",1,0],["وأرخى على الدجى أبيضاً","وقد كان نور الضحى أسودا",31,"د",2,0],["وأَرْخَتْ جَنَاحَيْها مِنَ الضَّعْفِ والْتَوَتْ","عَلَى فَرْعِ دَوْحٍ مِنْ بَنيها بِمَشْهَدِ",32,"د",1,0],["وأرخص قربَه باللّيل مَن لو","سألنا قربه بالصّبحِ أغلى",33,"ل",2,0]]}