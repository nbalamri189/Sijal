{"poems":[[53,"يا أراك الحمى تراني أراكا","https://www.aldiwan.net/poem29922.html","الخفيف"],[53,"لن تشقوا لذا الجواد غبارا","https://www.aldiwan.net/poem30482.html","الخفيف"],[93,"في رضى المربوب والرب","https://www.aldiwan.net/poem9791.html","عموديه"],[78,"قبح الدهر فماذا صنعا","https://www.aldiwan.net/poem14203.html","الرمل"],[85,"لم يمت من له أثر","https://www.aldiwan.net/poem62861.html","مجزوء الخفيف"],[45,"أريحيات صبوة ومشيب","https://www.aldiwan.net/poem62638.html","الخفيف"],[143,"ضل من يستزير طيف الخيال","https://www.aldiwan.net/poem11795.html","الخفيف"],[185,"يا خليلي الهوى برح بي","https://www.aldiwan.net/poem14115.html","الرمل"],[285,"قل لمن تاه دلالا وهوى","https://www.aldiwan.net/poem39393.html","الرمل"],[303,"لا قبلنا في ذا المصاب عزاء","https://www.aldiwan.net/poem58419.html","الخفيف"],[353,"من لصب لم ينل أربا","https://www.aldiwan.net/poem40782.html","المديد"],[353,"مستهل الدمع هاطله","https://www.aldiwan.net/poem40785.html","المديد"],[353,"مستهل الدمع ساكبه","https://www.aldiwan.net/poem40788.html","المديد"],[353,"مستهام رق وانتحبا","https://www.aldiwan.net/poem40811.html","المديد"],[402,"فيك أما في سواك فلا","https://www.aldiwan.net/poem46911.html","المديد"],[406,"حازك البين حين أصبحت بدرا","https://www.aldiwan.net/poem50175.html","الخفيف"],[464,"غير سهل فيك يا لمياء حزني","https://www.aldiwan.net/poem3194.html","عموديه"],[464,"ما على الركب من تلافي تلافي","https://www.aldiwan.net/poem3215.html","عموديه"],[551,"من على هذه الديار أقاما","https://www.aldiwan.net/poem47232.html","الخفيف"]],"verses":[["مَن إِذا غالَنا الضَلالُ رَأَينا","هُ قِواماً لِدينِنا أَو مِساكا",0,"ك",2,0],["مَن إِذا عَرَضّوا تَعَرَّضَ جوداً","وَإِذا جارَتِ اللَيالي أَجارا",1,"ر",2,0],["مَنْ إذَا دَاعِي الوَلاَءِ دَعَا","قَالَ إحْسَاسٌ لَهُ لَبِّ",2,"ب",1,0],["مَن إِذا قيل الخَنا صَمّ وَإِن","نطقَ العافون هَمسا سَمِعا",3,"ع",2,0],["مَن إِذا الغَيثُ هَمى مُنهِمراً","أَخجَلته كَفّه فاِنقَطَعا",3,"ع",2,0],["مَن إِذا عاشَ لَم يُفِد","وَإِذا ماتَ لَم يَضِر",4,"ر",1,0],["مَن إِذا قُلتُ يا أَبا زَكَرَيّا","سالَمَتني الأَيّامُ وَهِيَ حُروبُ",5,"ب",1,0],["مَن إِذا ما الكَمالُ أَعلى مُلوكاً","طالَ بِالإِزدِيادِ فَوقَ الكَمالِ",6,"ل",1,0],["من إذا رام السُّها مقتصِدا","طاعنا أو راشِقا لم يُعْزِب",7,"ب",1,0],["من اذا ما جئته زائره","تلق بحرا منه تزداد ارتوا",8,"و",2,0],["من إذا ا الحقوق للهِ نادت","قاضيا راعيا أجاب النداءَ",9,"ا",2,0],["مَن إِذا أَتلو لَدَيهِ ثَنا","رَتّلت مَدحي مآثرُه",10,"ر",2,0],["مَن إِذا أَتلو لَدَيهِ ثَنا","رَتّلت مَدحي شَمائلُه",11,"ل",2,0],["مَن إِذا أَتلو لَدَيهِ ثَنا","رَتّلت مَدحي مناقبُه",12,"ب",2,0],["مَن إِذا أَتلو لَديهِ ثَنا","مَدحهُ يَتلو الثَنا كتبا",13,"ب",2,0],["من إذا جادَتْ أناملُه","قالتِ العَلْياءِ لاَ شلَلاَ",14,"ل",2,0],["مَن إِذا شِمتُ وَجهَهُ بَعدَ عُسرٍ","قلب اللَه ذَلِكَ العُسرَ يُسرا",15,"ر",2,0],["من إذا أوجسَ خوفاً مالهُ","من نداه لم يعوذه بخزن",16,"ن",1,0],["من إذا أينعت رؤوس الأعاد","حيث سمر القنا نجوم قذاف",17,"ف",1,0],["من إذا مال جانبٌ من بناءِ الد","دين كانتْ له يداه دِعاما",18,"م",2,0]]}