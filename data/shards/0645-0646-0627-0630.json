{"poems":[[55,"يا أراك الحمى تراني أراكا","https://www.aldiwan.net/poem29922.html","الخفيف"],[55,"لن تشقوا لذا الجواد غبارا","https://www.aldiwan.net/poem30482.html","الخفيف"],[95,"في رضى المربوب والرب","https://www.aldiwan.net/poem9791.html","عموديه"],[80,"قبح الدهر فماذا صنعا","https://www.aldiwan.net/poem14203.html","الرمل"],[87,"لم يمت من له أثر","https://www.aldiwan.net/poem62861.html","مجزوء الخفيف"],[47,"أريحيات صبوة ومشيب","https://www.aldiwan.net/poem62638.html","الخفيف"],[147,"ضل من يستزير طيف الخيال","https://www.aldiwan.net/poem11795.html","الخفيف"],[189,"يا خليلي الهوى برح بي","https://www.aldiwan.net/poem14115.html","الرمل"],[290,"قل لمن تاه دلالا وهوى","https://www.aldiwan.net/poem39393.html","الرمل"],[308,"لا قبلنا في ذا المصاب عزاء","https://www.aldiwan.net/poem58419.html","الخفيف"],[358,"من لصب لم ينل أربا","https://www.aldiwan.net/poem40782.html","المديد"],[358,"مستهل الدمع هاطله","https://www.aldiwan.net/poem40785.html","المديد"],[358,"مستهل الدمع ساكبه","https://www.aldiwan.net/poem40788.html","المديد"],[358,"مستهام رق وانتحبا","https://www.aldiwan.net/poem40811.html","المديد"],[408,"فيك أما في سواك فلا","https://www.aldiwan.net/poem46911.html","المديد"],[412,"حازك البين حين أصبحت بدرا","https://www.aldiwan.net/poem50175.html","الخفيف"],[469,"غير سهل فيك يا لمياء حزني","https://www.aldiwan.net/poem3194.html","عموديه"],[469,"ما على الركب من تلافي تلافي","https://www.aldiwan.net/poem3215.html","عموديه"],[556,"من على هذه الديار أقاما","https://www.aldiwan.net/poem47232.html","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48810","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63935","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63944","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119916","الرمل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203784","الخفيف"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122889","الخفيف"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49984","المتقارب"],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124027","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80023","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79913","الخفيف"],[1611,"","https://poetry.dctabudhabi.ae/diwan/poem/106719","الكامل"],[1996,"","https://poetry.dctabudhabi.ae/diwan/poem/82848","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53226","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53050","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53076","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27804","الخفيف"],[2714,"","https://poetry.dctabudhabi.ae/diwan/poem/199885","الخفيف"],[3187,"","https://poetry.dctabudhabi.ae/diwan/poem/138787",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205681","الخفيف"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32670","المديد"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40103","الخفيف"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81291","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81300","الخفيف"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81942","الخفيف"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28618","الرجز"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33675","الخفيف"],[5338,"لا تعذل العين أن أرخت عزاليها","https://www.poetsgate.com/ViewPoem.aspx?id=187832",""],[402,"في رضى المربوب والرب","https://www.poetsgate.com/ViewPoem.aspx?id=35118",""],[6046,"أنا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=35208",""]],"verses":[["مَن إِذا غالَنا الضَلالُ رَأَينا","هُ قِواماً لِدينِنا أَو مِساكا",0,"ك",2,0],["مَن إِذا عَرَضّوا تَعَرَّضَ جوداً","وَإِذا جارَتِ اللَيالي أَجارا",1,"ر",2,0],["مَنْ إذَا دَاعِي الوَلاَءِ دَعَا","قَالَ إحْسَاسٌ لَهُ لَبِّ",2,"ب",1,0],["مَن إِذا قيل الخَنا صَمّ وَإِن","نطقَ العافون هَمسا سَمِعا",3,"ع",2,0],["مَن إِذا الغَيثُ هَمى مُنهِمراً","أَخجَلته كَفّه فاِنقَطَعا",3,"ع",2,0],["مَن إِذا عاشَ لَم يُفِد","وَإِذا ماتَ لَم يَضِر",4,"ر",1,0],["مَن إِذا قُلتُ يا أَبا زَكَرَيّا","سالَمَتني الأَيّامُ وَهِيَ حُروبُ",5,"ب",1,0],["مَن إِذا ما الكَمالُ أَعلى مُلوكاً","طالَ بِالإِزدِيادِ فَوقَ الكَمالِ",6,"ل",1,0],["من إذا رام السُّها مقتصِدا","طاعنا أو راشِقا لم يُعْزِب",7,"ب",1,0],["من اذا ما جئته زائره","تلق بحرا منه تزداد ارتوا",8,"و",2,0],["من إذا ا الحقوق للهِ نادت","قاضيا راعيا أجاب النداءَ",9,"ا",2,0],["مَن إِذا أَتلو لَدَيهِ ثَنا","رَتّلت مَدحي مآثرُه",10,"ر",2,0],["مَن إِذا أَتلو لَدَيهِ ثَنا","رَتّلت مَدحي شَمائلُه",11,"ل",2,0],["مَن إِذا أَتلو لَدَيهِ ثَنا","رَتّلت مَدحي مناقبُه",12,"ب",2,0],["مَن إِذا أَتلو لَديهِ ثَنا","مَدحهُ يَتلو الثَنا كتبا",13,"ب",2,0],["من إذا جادَتْ أناملُه","قالتِ العَلْياءِ لاَ شلَلاَ",14,"ل",2,0],["مَن إِذا شِمتُ وَجهَهُ بَعدَ عُسرٍ","قلب اللَه ذَلِكَ العُسرَ يُسرا",15,"ر",2,0],["من إذا أوجسَ خوفاً مالهُ","من نداه لم يعوذه بخزن",16,"ن",1,0],["من إذا أينعت رؤوس الأعاد","حيث سمر القنا نجوم قذاف",17,"ف",1,0],["من إذا مال جانبٌ من بناءِ الد","دين كانتْ له يداه دِعاما",18,"م",2,0],["من أذى كاتبين عانتْ بلادي","ما يعاني من حاكم محكوم",19,"م",1,0],["من إذا ما تجاحشَ القومُ بالآ","راءِ بذَّ المجاحشينَ جِحاشا",20,"ش",2,0],["من إذا فاضَ بحرُ خندفَ لا يَغْ","رَقُ في فيض بحرِها الفيَّاض",21,"ض",1,0],["من إذا طارت مني لي بينهم","فهم في قضِّها عندي طير",22,"ر",1,0],["مَنْ إذا ثارت الخطوب على الشرْ","ق وألقته حائراً مكفهرا",23,"ر",2,0],["من اذا ما روعت أمن روعي","واذا ما شرقت سوَّغَ ريقي",24,"ق",2,0],["من إذا أيسر أغنى قومَهُ","وإذا أعسَر لم يُبدِ الضَّجَرْ",25,"ر",1,0],["من إذا ضنت الجماد بغيث","عده الممحلون غيث الجماد",26,"د",1,0],["مَن إذا جادَ واهباً جاد وبلاً","وإذا قال ناطقاً قال فصلا",27,"ل",2,0],["مَن إذا حلبةُ الخَطابةِ فيها","ضمَّه والخصومَ سبقٌ وحضر",28,"ر",1,0],["مَن إِذا تَجَلَّت في مَشاهِدِ قُدسِها","أَجلَت هُمومَ شُهودِ ذاكَ المَعهَدِ",29,"د",1,0],["مَن إِذا مشكل عَرى في مهم","قامَ يَسعى لحله بِالدَّليلِ",30,"ل",1,0],["من إذا هبّ هبّ ريح سداد","وإذا سلَّ سلَّ سيف ابن هان",31,"ن",1,0],["من إذا ما الملوك شكّ ذوو الأنس","اب في نقل أصلها المنسوبِ",32,"ب",1,0],["من إذا شقت الجياد مثار النق","ع والمُلْد داميات الكعوبِ",32,"ب",1,0],["من إذا شقت به بحر الوغى","سابحات في عجاج كالدُّؤاد",33,"د",1,0],["من أذى باطل وعصمة حق","ولأشبالٍ أسدِه فعرينا",34,"ن",2,0],["من إذا سيل: من أبوه؟ بدامن","ه حياء يحميه رجع الجواب",35,"ب",1,0],["مَن إذَا غَمَّتِ المسَائِلُ جَلَّى","ابنُ جَلا فِكرَهُ لَهَا فَجلاهَا",36,"ا",3,0],["من أذاب الشقاء عينيه شهراً","في ارتقاب النعيم غير شقيِّ",37,"ي",1,0],["مَن إِذا خَطبٌ أَطَلَّ عَلَيهِ","فَلَهُ صَبرٌ عَلَيهِ مُطِلُّ",38,"ل",1,0],["مَن إِذا قويسَ الوَرى كانَ مِن أَصْ","غرِ غِلمانِهِ بَنو حَمدانِ",39,"ن",1,0],["مَن أذعَنَت لِقَهرِهِ الأَملاكُ","وَانتَظَمَت عن أمرِهِ الأَسلاَكُ",40,"ك",1,0],["مَن أَذابَ الضِياء فيهِ وَمِن نَغَ","م شَجو الهَوى عَلى أَوتاره",41,"ر",2,0],["مَن إِذا شاءَ أَن يَكون كَما شا","ء فَما بَينَهُ وَذاكَ اِعتِياق",42,"ق",1,0],["مَن إِذا شاءَ أَن يَكون هزاراً","كَأَنيس يَشدو فَتَشدو العِراق",42,"ق",1,0],["من إذا استوحش الورى","يوم لم يبق منصف",43,"ف",1,0],["مِن أَذُنَينِ يَطَّبي سَمعهما","مِنَ السُّكونِ حَرَكاتٍ تَعتَمِلْ",44,"ل",1,0],["من إذا أنتَ لم تكن وإلى من","أشتكي حَسرتي وشدَّةَ حزني",45,"ن",2,0],["مَنْ أَذْهَبَ الرِّجْسَ عَنْهُمْ ثُمَّ طَهَّرَهُمْ","مِنْ كُلِّ مُوبِقَةٍ لُطْفًا وَتَنْزِيهَا",46,"ي",3,0],["من إذا داعي الولاء دعا","قال إحساب له لب",47,"ب",1,0],["مَنْ أَذَلَّ الزَّنْجَ في دَوْلَتِهِ","وَإِذَا هُمْ خَدَمُ الشَّعْبِ الْمَجِيدْ؟",48,"د",1,0]]}