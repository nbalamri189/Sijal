{"poems":[[95,"بالعلم يدرك أقصى المجد من أمم","https://www.aldiwan.net/poem11392.html","البسيط"],[26,"أبالصرم من أسماء حدثك الذي","https://www.aldiwan.net/poem24096.html","الطويل"],[47,"إني لفعلك يا محمد حامد","https://www.aldiwan.net/poem63455.html","الكامل"],[164,"غبطت جوارحنا عليك الأعينا","https://www.aldiwan.net/poem58876.html","الكامل"],[168,"لا تركنن إلى الهوى","https://www.aldiwan.net/poem67809.html","مجزوء الكامل"],[240,"قوادة فارهة","https://www.aldiwan.net/poem31777.html","مجزوء الرجز"],[287,"ومفترة عن كالجمان المنظم","https://www.aldiwan.net/poem32422.html","الطويل"],[408,"سرى طيفها وهنا إلي فحياني","https://www.aldiwan.net/poem46755.html","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48680","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65094","المنسرح"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136105","الطويل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76548","الطويل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104229","المتقارب"],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26993","الوافر"],[4764,"قلبي وزعلاته","https://www.poetsgate.com/ViewPoem.aspx?id=35867",""],[4991,"عطر الليل","https://www.poetsgate.com/ViewPoem.aspx?id=190437",""],[5691,"بوم وغربان","https://www.poetsgate.com/ViewPoem.aspx?id=205929",""],[5848,"اهوا دا اللي مش معقول","https://www.poetsgate.com/ViewPoem.aspx?id=53357",""],[5956,"أ نعرف صالحاً ونشيم رهْقا؟","https://www.poetsgate.com/ViewPoem.aspx?id=194600",""],[5956,"الناي بِنْتي ما لها تكرارُ","https://www.poetsgate.com/ViewPoem.aspx?id=203444",""],[5969,"مؤامرة","https://www.poetsgate.com/ViewPoem.aspx?id=205051",""],[5986,"أيا بدر المعارف والمعالي","https://www.poetsgate.com/ViewPoem.aspx?id=162953",""]],"verses":[["تُوصِينَنَا بِتُرَاثٍ نَامَ صَاحِبُهُ","عَنْهُ اضْطِراراً وَعَيْنُ الدَّهْرِ لم تَنَمِ",0,"م",1,0],["تَوَصَّلُ بِالرُكبانِ حيناً وَتُؤلِفُ ال","جِوارَ وَيُغشيها الأَمانَ رِبابُها",1,"ب",3,0],["توصيكَ بي عَطفُ القَريبِ وَمَذهَبٌ","في الرُشدِ سَهَّلَهُ أَمامَكَ راشِدُ",2,"د",1,0],["توصي بغض الطرف عمن لو بدتْ","لجعلت مدَّ الطرف فيها ديدَنا",3,"ن",2,0],["توصي وَعَقلُكَ في بَذا","فَلِذاكَ رَأيُكَ ذو بَذاءِ",4,"ا",2,0],["تَوَصَّلَت في الصُلحِ ما","بَينَ اِبنِ هِندٍ وَعَلي",5,"ل",2,0],["تَوَصَّل إِلى المَلكِ بنِ أَيّوبَ أَف","ضَلِ المُلوكِ صَلاحِ الدينِ تَغنَ وَتَغنَمِ",6,"م",1,0],["توصلتَ في مدحي إلى مدح ماجدٍ","به افتخرتْ أَبنا معدٍّ وعدنانِ",7,"ن",1,0],["توصيك بالميعاد وهو فريضة","ذكرى مخلدة لهم ومعالم",8,"م",1,0],["تُوصِلُ سُرَّاقها إِذا وَصَلُوا","إِليهِ والقَطْعُ مُقْتضَى السَّرِقَهْ",9,"ق",2,0],["توصل به ان رمت نجحا فانه","لراجيه بالاقبال ليس يخيب",10,"ب",1,0],["تُ وصوّبت نحو الاصابة سهمي","ترومين اني فراراً",11,"ر",2,0],["تَوَصَّل بِإِخلاص المَحبَّةِ نَحوَهُم","تُلاقِ لَدَيِهم كُلَّ عَطفٍ وَتَحنانِ",12,"ن",1,0],["توصل إليها بحجابها","فإن الأمور بأسبابها",13,"ب",3,1],["تُوَصّيني بِهِ وَتَقولُ أَخشى","عَلَيهِ البَردَ في اللَيلِ الطَويلِ",14,"ل",1,0],["توصى لا خطيت ابعيد / تذكر (غَيّر اسلوبك)","ترى والله / ما تلقى مثل قلبي وزعلاته",15,"ت",2,0],["توصف مدى حبي وشوقي بالعيون","يا نور عينيني ورشفة شفاياي",16,"ا",2,0],["توصف جمالك طلتك يوم يلفون","صوبي وتعزف مهجتي لحن بالناي",16,"ا",2,0],["توصَفُ البومَةُ بالحِكْمَةِ في","أُمَمٍ واعْتُبِرَتْ مُحْتَشِمَهْ",17,"م",2,0],["توصيني امشي بالهداوه وتبلاني","الى كلمتني من جنوني عكست السير",18,"ر",1,0],["توصّل نحو رتبة أولياء","بجيلٍ جُلّه أدهى وأشقى",19,"ق",2,0],["توصي بأغذيتي وتخشى مِيتتي","وأطيع ما أوصت.. فما أنهارُ",20,"ر",1,0],["تؤصلُ ما قد غاب عنه مُؤَصلٌ","وَتضبط ما قد شط فيه الأَوائِلُ",21,"ل",1,0],["توصل للعلى بأبي علي","وحط ببابه يكفيك زاده",22,"د",2,0]]}