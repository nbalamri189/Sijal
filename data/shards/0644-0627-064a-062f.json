413",""],[5790,"الله أكبر أي طرف يطمح","https://www.poetsgate.com/ViewPoem.aspx?id=111868",""],[5873,"المجالدة على الآمال","https://www.poetsgate.com/ViewPoem.aspx?id=215413",""],[5879,"يا راكب البحر","https://www.poetsgate.com/ViewPoem.aspx?id=215462",""],[5908,"لي لا لغيري آلت نوبة الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=170970",""],[5952,"جمرٌ على الجمر","https://www.poetsgate.com/ViewPoem.aspx?id=202360",""],[6045,"وجمة غضب ونغمة طرب","https://www.poetsgate.com/ViewPoem.aspx?id=162864",""],[6102,"رَسولُ الهَوى...","https://www.poetsgate.com/ViewPoem.aspx?id=182740",""],[6124,"قصد السبيل","https://www.poetsgate.com/ViewPoem.aspx?id=193053",""],[6125,"تُدمِي بقلبي هِجرَةٌ وجَفَاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=208593",""],[4245,"وأبيك لم يخفق حشاي وإنما","https://www.poetsgate.com/ViewPoem.aspx?id=188795",""],[6189,"مسافرٌ بلا بوصلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83586&r=&rc=53",""],[6217,"يا ابْنَ حَبيبَ أَنتَ في غَفلَة ٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23127&r=&rc=4",""],[6288,"الحاضر ... ليس النهاية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76849&r=&rc=12",""]],"verses":[["لا يَدَّعِ العُذّالُ نَزعَ صَبابَتي","بِيَدي حَسَرتُ عَنِ الغَرامِ لِثامي",0,"م",2,0],["لا يُدفَعُ الأَضيافُ مِنهُم إِلى","مَمنونِ زادٍ وَقِرىً مُعتِمِ",1,"م",1,0],["لا يَدخَرُ الضَيغَمُ مِن قوتِهِ","ما يَدخَرُ النَملُ مِنَ المَطعَمِ",1,"م",1,0],["لا يَدَعُ الذابِلَ مَن طَعمُهُ","عَلى صَبوحٍ بِدَمٍ أَو غَبوق",2,"ق",1,0],["لا يُدرِكُ الحِكمَةَ مَن عُمرُهُ","يَكدَحُ في مَصلَحَةِ الأَهلِ",3,"ل",1,1],["لا يَدخُلُنَّ عَلَيكَ إِنَّ دُخولَهُم","رِجسٌ وَإِنَّ خُروجَهُم تَطهيرُ",4,"ر",1,0],["لا يُدانيه في الشجاعة بِسطا","مُ بن قيس وفارسُ الضحياءِ",5,"ا",2,0],["لا يَدبُّ الملالُ فيها ولا يَنْ","قُص من عَقْد سحْرِها تَوْكيدُ",6,"د",1,0],["لأيدي البلى فيها سطور مبينة","عبارتُها أنْ كلُّ بيت سيُهجَر",7,"ر",1,0],["لأيديكُمُ في الموْطنين كليهما","نقائذُ من أيدي الردى وفرائس",8,"س",1,0],["لا يُدرِكُ الهرِمُ النُجومَ","وَأَنتَ في الدُنيا شَهاب",9,"ب",1,0],["لا يَدخُلَنَّ جَهَنَّماً ذي مَطمَعٍ","بِالمَجدِ أَو بِالأَصفَرِ الرَنّانِ",10,"ن",1,0],["لا يَدَّعيهِ مُدَّعٍ","لَو عاشَ ما قَد عاشَ نوحُه",11,"ح",2,0],["لا يدانيك ناقد قد تحدى","انه هادم وانت الباني",12,"ي",1,0],["لا يدركنّه وإن","طاوله مطاول",13,"ل",1,0],["لا يُدرِكُ المَجدَ إِلّا سَيِّدٌ فَطِنٌ","لِما يَشُقُّ عَلى الساداتِ فَعّالُ",14,"ل",1,0],["لا يُدعَيانِ إِلى اِختِنالِ مُقاتِلِ","يَومَ اللِقاءِ وَلا اِحتِيالِ مُدَبِّرِ",15,"ر",1,0],["لا يَدفَعونَ هَواماً عَن وُجوهِهِمُ","كَأَنَّهُم خَشَبٌ بِالقاعِ مُنجَدِلُ",16,"ل",1,0],["لا يَدعُوَنَّ عَلى الأَعداءِ مُجتَهِداً","إِلّا بِأَن يَجِدوا بَعضَ الَّذي يَجِدُ",17,"د",1,0],["لا يَدهَمَنَّكَ مِن دَهمائِهِم عَدَدٌ","فَإِنَّ جُلَّهُمُ بَل كُلَّهُم بَقَرُ",18,"ر",1,0],["لا يُدْرِكُ الْمَجْدَ إِلَّا مَنْ إِذَا نَهَضَتْ","بِهِ الْحَمِيَّةُ لَمْ يَقْعُدْ عَلَى رَغَمِ",19,"م",1,0],["لا يَدَّعِي الإملاقَ والفَقرَ امْرُؤٌ","كَزُّ اليَدَيْنِ فما بِمصرَ فقيرُ",20,"ر",1,0],["لا يَدَّعِ القَومُ أَنّا أُمَّةٌ هَمَلٌ","فَلا وَرَبِّكَ ما بَرّوا وَلا صَدَقوا",21,"ق",3,0],["لا يَدلِفونَ إِلى ماءٍ بِآنِيَةٍ","إِلّا اِغتِرافاً مِنَ الغُدرانِ بِالراحِ",22,"ح",1,0],["لا يُدِلَّنَّ عَلى الإِخ","وانِ بَعدي مَن رَآني",23,"ن",2,0],["لا يُدرِكُ اليَومَ الَّذي خَلَّفتَهُ","تَقريبُ سابِقَةٍ وَلا إِحضارُ",24,"ر",1,0],["لا يُدرِكُ الخُلدَ أَوعالٌ مُخَلَّدَةٌ","فَاِسأَل بِصَحَّةِ هَذا أُمَّ أَوعالِ",25,"ل",1,0],["لا يَدينونَ بِالعُقولِ وَلَكِن","بِأَباطيلِ زُخرُفٍ كَذَّبوهُ",26,"ب",3,0],["لا يدرك الجمهور ثورته","إلا إذا انطفأت مع الزَمَن",27,"ن",1,0],["لا يُدْرِكُ الحاجاتِ إلّا نافِذٌ","إنْ عَجِزَتْ قِلاصُه لم يَعْجَزِ",28,"ز",1,0],["لا يد خوفو أرهقت فيها البشر","ولا سليمان لها الجنّ حشر",29,"ر",1,0],["لا يُدْرِكُ الْمَجْدَ إِلاَّ مَنْ إِذَا هَتَفَتْ","بِهِ الْحَمِيَّةُ هَزَّ الرُّمْحَ وَانْتَصَبَا",30,"ب",2,0],["لا يَدْفَعُونَ يَداً عَنْهُمْ وَلَوْ بَلَغَتْ","مَسَّ الْعَفَافَةِ مِنْ جُبْنٍ وَمِنْ خَزَلِ",31,"ل",1,0],["لا يُدْرِكُ الْغَايَةَ الْقُصْوَى سِوَى رَجُلٍ","ثَبْتِ الْعَزِيمَةِ مَاضٍ حَيْثُ يَنْخَرِطُ",32,"ط",1,0],["لا يَد لي كَيفَ عِشتُ وَقَد","حَكَمَت لِلمَوتِ فيكَ يَدُ",33,"د",1,0],["لا يدركُ السؤْلَ غير عزمٍ","مثابرٍ يقرَع الحديدا",34,"د",2,0],["لا يُدْعَيَانِ إلى اخْتِتَالِ مُقَاتِلٍ،","يَوْمَ اللّقَاءِ، وَلا احْتِيالِ مُدَبِّرِ",35,"ر",1,0],["لا يدخلنّ جهنّما ذو مطمع","بالمجد أو بالأصفر الرّنّان",36,"ن",1,0],["لا يَدبُّ الملالُ فيها ولا يُنْ","قِض من عَقْد سحْرِها تَوْكيدُ",37,"د",1,0],["لاَ يُدْعَىْ ذَاكَ وَلاَ هَذَا","بَلْ يُدْعَىْ أَزْرَىْ مِنْ مُزْرِيْ",38,"ر",2,0],["لا يدخل النار أَسير الهَوى","إِذ لا يَرى الجَنة أَهل العَذاب",39,"ب",1,0],["لا يدرك العقل من مديحه لسوى","أن المدائح فيه كلها انحصروا",40,"ر",3,0],["لا يدخلُ الفقر لي بيتاً فيخرجُني","إلى سواه فجودٌ منه يعتبِني",41,"ن",2,0],["لا يدعي إرثَ نيلِ العلم ويحك مَن","قد غير الأصلَ منه الجهلُ إِذ جَهِلاَ",42,"ل",2,0],["لا يداني قلبه فزعٌ","لا ولا يهتزّ من وجلِ",43,"ل",1,1],["لا يدّعِى إقدامَه أحدٌ","وإن ادعاه فوالدُ الشِّبلِ",44,"ل",1,0],["لا يَدَّعِ المَجدَ المُؤَثَّلَ مُدَّعٍ","فَالمَجدُ مِن هَذي الخِلالِ مُرَكَّبُ",45,"ب",1,0],["لا يَدَّعوا النُصحَ بِاِعتِرافِهِمُ","لَو وَجَدوا الجَحدَ مُمكِناً جَحَدوا",46,"د",3,0],["لا يَدَّعِ الآنَ ما أوتيتَ مِن شَرَفٍ","مَن لا يُقيمُ عَلى دَعواهُ بُرهانا",47,"ن",2,0],["لا يدفع الفقر تقتير يواظبه","بل يكسف الفقر إقبال يشاغبه",48,"ب",2,0],["لا يدخل العذل الملوم بسمعه","حاشا مسامعه عن الفحشاء",49,"ا",2,0],["لا يَدخُل التَبديلُ في آياتِهِ","كَلّا وَما إِعجازُهُ بِالفاني",50,"ن",2,0],["لا يُدرِكُ العَلياءَ إِلّا فَتىً","آبٍ عَلى حَملِ الأَسى عازِفُ",51,"ف",1,0],["لا يدبر البقال إلا إذا","تصالح السنور والفاره",52,"ه",1,0],["لا يدّعي مثلاً له","في الناس غير الأحول",53,"ل",1,0],["لا يدركون بغاية في المجد","من ماض وباق",54,"ق",1,0],["لا يَدْعُونَّكَ بِالْجَوادِ مُقَصِّرٌ","وأَقَلُّ حَقِّكَ أَنْ يُقالَ جَوادُ",55,"د",1,0],["لا يُدْرِكُ الْجارُونَ غايَةَ مَجْدِهِ","مَنْ يَسْتَطِيعُ إِلى السَّماءِ تَسَلُّقا",56,"ق",2,0],["لا يُدْرِكُ المجدَ إلا كُلُّ مُدَّلِجٍ","يَدْرِي ويَعْلَمُ أَنَّ العِزَّ في النَّقَلِ",57,"ل",1,0],["لا يُدنِيَنك منه رقَّة خُلقه","فالسيفُ يقطعُ إذ يرقُّ حديدُهُ",58,"د",2,0],["لا يدرك العالمُ الكلي حقيقتَه","ولا تَجسُّدَه العالي عن المثَل",59,"ل",1,0],["لأَيديهِ في كلِّ عنقٍ يدٌ","ومنها أُفيضَتْ لنا أنعُم",60,"م",1,0],["لا يدركها نظر كلّا","بل تسبق عين المرتقب",61,"ب",1,0],["لا يدّعي الطيفُ أنّ الليلَ يُتلِفُه","أما هدَتْهُ من الأشواقِ نيرانُ",62,"ن",1,0],["لا يدرك المجد من لم يجعل السببا","جرد المذاكي وسمر الخط والقضبا",63,"ب",2,1],["لا يدرك المجد من جدٍ زكٍ وأب","بغير جدٍ وإقبال السعادات",64,"ت",1,0],["لا يدرك الفوز إلا بعد أربعةٍ","وهن هن إلى الجنات كالدرج",65,"ج",1,0],["لا يدي تُعطى على الهون ولا","نَخَواتي بعصا الضيم مَسوقَهْ",66,"ق",2,0],["لا يُدرك الحيُّ عيباً فيه ينْقَمُه","وفي قميصيْهِ ذو نِيقٍ وشؤْبوبُ",67,"ب",1,0],["لا يُدرك الأملَ الأسنى سوى رجلٍ","يشقُّ بحرَ الرّدى عن جوهرِ الأملِ",68,"ل",1,0],["لا يُدركنَّ مديحَهُ لسِنٌ ولو","نظمَ الكواكبِ في قلائِدِ شِعرِهِ",69,"ر",2,0],["لا يدرك المجد إلا كل مقتحم","في موج ملتطم أو فوج مضطرم",70,"م",1,0],["لا يُدرك العزَّ إلّا كلُّ ذي أَنَفٍ","نابٍ عن العجزِ شَرّادٍ عن الوَهَنِ",71,"ن",1,0],["لا يَدفَعُ الأَمَلَ القَريبَ لِعَودِهِ","في حينِ دَفعِ الغَيثِ حَمدَ الرُوَّدِ",72,"د",1,0],["لا يدعي أمراً فلا التحوُّل","له ولا القوة فيما يجعل",73,"ل",1,0],["لا يدانيه سواه وهل","عسل يشبهه الأَقَط",74,"ط",1,0],["لا يَدَّعِي العاشِقُونَ مَرْتَبتي","مَتَى تَساوَى التُّرابُ والذَّهبُ",75,"ب",1,0],["لا يدرك الطرف أقصاها على كلل","حتى تعود له لحظات حولاء",76,"ا",2,0],["لا يدوم الصديق إلا إذا كا","ن مفيداً بوده مستفيدا",77,"د",2,0],["لا يدعى بدر لوجهك نسبة","فاخاف ان يسود وجه المدعى",78,"ع",2,1],["لا يدفعُ الحادثَ عن نفسه","ولو أتاه الخيرُ لا يشكر",79,"ر",1,0],["لا يدعي العلم من","الجَهْلُ عليه غَلَبا",80,"ب",2,0],["لا يدخل الجنة امروَ أبدا","لم يأت بالإذن في بطاقته",81,"ت",2,0],["لا يدرك العلوم شخص قصَّرا","لا والذي في نفسه تكبرا",82,"ر",2,0],["لا يدرك الفكر بها مطلباً","فكل ما يطلبه يهرب",83,"ب",1,0],["لا يَدْفَعُ الإِنْسانُ خَيْتامَهُ","إِلاَّ لِيَقْضي حَاحَةً غائبَهْ",84,"ب",2,0],["لا يداجى ولا يحيد عن الح","ق ويأبى خديعة المارفينَا",85,"ن",2,0],["لا يُدركُ القوتَ مما أنت واهبُهُ","حت