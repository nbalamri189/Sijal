{"poems":[[53,"هي سلوة ذهبت بكل غرام","https://www.aldiwan.net/poem29797.html","الكامل"],[53,"يا من رأى البرق على الأنعم","https://www.aldiwan.net/poem29815.html","السريع"],[53,"تعيف الطير فأنبأنه","https://www.aldiwan.net/poem29951.html","السريع"],[57,"لا يدرك الحكمة من عمره","https://www.aldiwan.net/poem24648.html","السريع"],[27,"يا صاحبي هل الصباح منير","https://www.aldiwan.net/poem5778.html","الكامل"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[51,"يا خليلي تيمتني وحيد","https://www.aldiwan.net/poem61914.html","الخفيف"],[51,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[51,"ألم تسأل اليوم الظباء الكوانس","https://www.aldiwan.net/poem64666.html","الطويل"],[91,"يا شاعرا حلو المودة","https://www.aldiwan.net/poem8762.html","عموديه"],[91,"مازال يمشي في الأمور بفكره","https://www.aldiwan.net/poem62771.html","عموديه"],[70,"أضنى الفؤاد فمن يريحه","https://www.aldiwan.net/poem42980.html","مجزوء الكامل"],[89,"أحمد كان مثل بحر رحيب","https://www.aldiwan.net/poem44619.html","الخفيف"],[89,"ليس البليد الجاهل","https://www.aldiwan.net/poem45078.html","مجزوء الرجز"],[43,"لا خيل عندك تهديها ولا مال","https://www.aldiwan.net/poem10136.html","البسيط"],[45,"أقصر فإن الدهر ليس بمقصر","https://www.aldiwan.net/poem63625.html","الكامل"],[49,"أضحت قبورهم من بعد عزهم","https://www.aldiwan.net/poem64274.html","البسيط"],[44,"نبئت عتبة يعوي كي أشاتمه","https://www.aldiwan.net/poem30053.html","البسيط"],[44,"يا هذه أقصري ما هذه بشر","https://www.aldiwan.net/poem30512.html","البسيط"],[87,"أعد على السمع ذكر البان والعلم","https://www.aldiwan.net/poem8243.html","البسيط"],[105,"قومي أهاب من الحياة بشير","https://www.aldiwan.net/poem42068.html","الكامل"],[105,"يا أيها القوم ماذا في حقائبكم","https://www.aldiwan.net/poem43072.html","البسيط"],[48,"يا دير حنة من ذات الأكيراح","https://www.aldiwan.net/poem62522.html","البسيط"],[48,"أحمد الله الذي أسكننى","https://www.aldiwan.net/poem66161.html","مجزوء الرمل"],[46,"ذهب الكرام فليتهم ذهب يرى","https://www.aldiwan.net/poem22567.html","الكامل"],[46,"نعشى عن الأمر حتى يعلو ابن ردى","https://www.aldiwan.net/poem23222.html","البسيط"],[46,"أسهب الناس في المقال وما يظ","https://www.aldiwan.net/poem23567.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85624","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16647","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202531","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42511","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42727","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42676","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43692","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54274","البسيط"],[45,"أقصِرْ، فإنّ الدّهرَ ليسَ بمُقْصِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=31214",""],[91,"الفردوس الضائع","https://www.poetsgate.com/ViewPoem.aspx?id=53312",""],[51,"يا خَلِيلَيَّ تَيَّمَتْني وَحيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=25883",""],[100,"قتيلان .. هما القاتل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85961&r=&rc=231",""],[110,"ما ضر طيفهم لو زار مشبهه","https://www.aldiwan.net/poem16620.html","البسيط"],[122,"بالواسعات أرى الأشواق تنهمر","https://www.aldiwan.net/poem23811.html","البسيط"],[129,"إني بفضل من الله ذو دعة","https://www.aldiwan.net/poem50491.html","البسيط"],[133,"لاحت عهود اللوى للعين منك ألا","https://www.aldiwan.net/poem54655.html","البسيط"],[136,"لا يداني قلبه فزع","https://www.aldiwan.net/poem48938.html","المديد"],[143,"شدوا على ظهر الصبا رحلى","https://www.aldiwan.net/poem58410.html","السريع"],[144,"ما لي مقال عن فعالك يعرب","https://www.aldiwan.net/poem11728.html","الكامل"],[144,"قصر عن سعيك الألى جهدوا","https://www.aldiwan.net/poem11756.html","المنسرح"],[144,"ظن الأراك لدى واديه أظعانا","https://www.aldiwan.net/poem11832.html","عموديه"],[187,"إني موصيك فاحفظ عن أخي ثقة","https://www.aldiwan.net/poem44158.html","البسيط"],[211,"هزم الصباح طلائع الظلماء","https://www.aldiwan.net/poem13414.html","الكامل"],[232,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[236,"يا زمن السوء الذي مسني","https://www.aldiwan.net/poem31814.html","السريع"],[257,"قد وقع الصلح على غلتي","https://www.aldiwan.net/poem48522.html","السريع"],[260,"دع نظم كل تغزل","https://www.aldiwan.net/poem35753.html","مجزوء الكامل"],[262,"لو لم أطل أمل التلاق","https://www.aldiwan.net/poem38226.html","مجزوء الكامل"],[281,"أيام دهرك كلها أعياد","https://www.aldiwan.net/poem60565.html","السريع"],[281,"لو كنت شاهد عبرتي يوم النقا","https://www.aldiwan.net/poem60695.html","الكامل"],[349,"كم شدة جاء في أعقابها فرج","https://www.aldiwan.net/poem20634.html","البسيط"],[372,"هذا الذي ثبتت عليك شهوده","https://www.aldiwan.net/poem57498.html","الكامل"],[378,"قلب يذوب إلى الأطلال والحلل","https://www.aldiwan.net/poem59287.html","البسيط"],[417,"متى يشتفي كبد مؤلم","https://www.aldiwan.net/poem53957.html","المتقارب"],[430,"نغم الأطيار على القضب","https://www.aldiwan.net/poem41430.html","المتدارك"],[433,"حيث التفت فكثبان وقضبان","https://www.aldiwan.net/poem12748.html","البسيط"],[442,"لا يدرك المجد من لم يجعل السببا","https://www.aldiwan.net/poem14345.html","البسيط"],[442,"ما حال حي ثوى ما بين أموات","https://www.aldiwan.net/poem14354.html","البسيط"],[442,"الموت في نفسي أغدو به وأجي","https://www.aldiwan.net/poem14360.html","البسيط"],[459,"يا ديار الحي من جنب الحمى","https://www.aldiwan.net/poem56095.html","الرمل"],[462,"وخاطر من حديث المجد ساورني","https://www.aldiwan.net/poem15908.html","البسيط"],[515,"ما حركت سكنات الأعين النجل","https://www.aldiwan.net/poem20788.html","البسيط"],[515,"كتم الهوى فوشى النحول بسره","https://www.aldiwan.net/poem20801.html","الكامل"],[516,"العلم مذ كان محتاج إلى العلم","https://www.aldiwan.net/poem12262.html","البسيط"],[552,"يا حادي العيس عرج بي على الدمن","https://www.aldiwan.net/poem47163.html","البسيط"],[554,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[559,"من يعرف الله فليس يسأل","https://www.aldiwan.net/poem34250.html","الرجز"],[559,"كل من بالناس يختلط","https://www.aldiwan.net/poem34409.html","المديد"],[587,"أضحى له في اكتئابه سبب","https://www.aldiwan.net/poem17411.html","المنسرح"]],"verses":[["لا يَدَّعِ العُذّالُ نَزعَ صَبابَتي","بِيَدي حَسَرتُ عَنِ الغَرامِ لِثامي",0,"م",2,0],["لا يُدفَعُ الأَضيافُ مِنهُم إِلى","مَمنونِ زادٍ وَقِرىً مُعتِمِ",1,"م",1,0],["لا يَدخَرُ الضَيغَمُ مِن قوتِهِ","ما يَدخَرُ النَملُ مِنَ المَطعَمِ",1,"م",1,0],["لا يَدَعُ الذابِلَ مَن طَعمُهُ","عَلى صَبوحٍ بِدَمٍ أَو غَبوق",2,"ق",1,0],["لا يُدرِكُ الحِكمَةَ مَن عُمرُهُ","يَكدَحُ في مَصلَحَةِ الأَهلِ",3,"ل",1,1],["لا يَدخُلُنَّ عَلَيكَ إِنَّ دُخولَهُم","رِجسٌ وَإِنَّ خُروجَهُم تَطهيرُ",4,"ر",1,0],["لا يُدانيه في الشجاعة بِسطا","مُ بن قيس وفارسُ الضحياءِ",5,"ا",2,0],["لا يَدبُّ الملالُ فيها ولا يَنْ","قُص من عَقْد سحْرِها تَوْكيدُ",6,"د",1,0],["لأيدي البلى فيها سطور مبينة","عبارتُها أنْ كلُّ بيت سيُهجَر",7,"ر",1,0],["لأيديكُمُ في الموْطنين كليهما","نقائذُ من أيدي الردى وفرائس",8,"س",1,0],["لا يُدرِكُ الهرِمُ النُجومَ","وَأَنتَ في الدُنيا شَهاب",9,"ب",1,0],["لا يَدخُلَنَّ جَهَنَّماً ذي مَطمَعٍ","بِالمَجدِ أَو بِالأَصفَرِ الرَنّانِ",10,"ن",1,0],["لا يَدَّعيهِ مُدَّعٍ","لَو عاشَ ما قَد عاشَ نوحُه",11,"ح",2,0],["لا يدانيك ناقد قد تحدى","انه هادم وانت الباني",12,"ي",1,0],["لا يدركنّه وإن","طاوله مطاول",13,"ل",1,0],["لا يُدرِكُ المَجدَ إِلّا سَيِّدٌ فَطِنٌ","لِما يَشُقُّ عَلى الساداتِ فَعّالُ",14,"ل",1,0],["لا يُدعَيانِ إِلى اِختِنالِ مُقاتِلِ","يَومَ اللِقاءِ وَلا اِحتِيالِ مُدَبِّرِ",15,"ر",1,0],["لا يَدفَعونَ هَواماً عَن وُجوهِهِمُ","كَأَنَّهُم خَشَبٌ بِالقاعِ مُنجَدِلُ",16,"ل",1,0],["لا يَدعُوَنَّ عَلى الأَعداءِ مُجتَهِداً","إِلّا بِأَن يَجِدوا بَعضَ الَّذي يَجِدُ",17,"د",1,0],["لا يَدهَمَنَّكَ مِن دَهمائِهِم عَدَدٌ","فَإِنَّ جُلَّهُمُ بَل كُلَّهُم بَقَرُ",18,"ر",1,0],["لا يُدْرِكُ الْمَجْدَ إِلَّا مَنْ إِذَا نَهَضَتْ","بِهِ الْحَمِيَّةُ لَمْ يَقْعُدْ عَلَى رَغَمِ",19,"م",1,0],["لا يَدَّعِي الإملاقَ والفَقرَ امْرُؤٌ","كَزُّ اليَدَيْنِ فما بِمصرَ فقيرُ",20,"ر",1,0],["لا يَدَّعِ القَومُ أَنّا أُمَّةٌ هَمَلٌ","فَلا وَرَبِّكَ ما بَرّوا وَلا صَدَقوا",21,"ق",3,0],["لا يَدلِفونَ إِلى ماءٍ بِآنِيَةٍ","إِلّا اِغتِرافاً مِنَ الغُدرانِ بِالراحِ",22,"ح",1,0],["لا يُدِلَّنَّ عَلى الإِخ","وانِ بَعدي مَن رَآني",23,"ن",2,0],["لا يُدرِكُ اليَومَ الَّذي خَلَّفتَهُ","تَقريبُ سابِقَةٍ وَلا إِحضارُ",24,"ر",1,0],["لا يُدرِكُ الخُلدَ أَوعالٌ مُخَلَّدَةٌ","فَاِسأَل بِصَحَّةِ هَذا أُمَّ أَوعالِ",25,"ل",1,0],["لا يَدينونَ بِالعُقولِ وَلَكِن","بِأَباطيلِ زُخرُفٍ كَذَّبوهُ",26,"ب",3,0],["لا يدرك الجمهور ثورته","إلا إذا انطفأت مع الزَمَن",27,"ن",1,0],["لا يُدْرِكُ الحاجاتِ إلّا نافِذٌ","إنْ عَجِزَتْ قِلاصُه لم يَعْجَزِ",28,"ز",1,0],["لا يد خوفو أرهقت فيها البشر","ولا سليمان لها الجنّ حشر",29,"ر",1,0],["لا يُدْرِكُ الْمَجْدَ إِلاَّ مَنْ إِذَا هَتَفَتْ","بِهِ الْحَمِيَّةُ هَزَّ الرُّمْحَ وَانْتَصَبَا",30,"ب",2,0],["لا يَدْفَعُونَ يَداً عَنْهُمْ وَلَوْ بَلَغَتْ","مَسَّ الْعَفَافَةِ مِنْ جُبْنٍ وَمِنْ خَزَلِ",31,"ل",1,0],["لا يُدْرِكُ الْغَايَةَ الْقُصْوَى سِوَى رَجُلٍ","ثَبْتِ الْعَزِيمَةِ مَاضٍ حَيْثُ يَنْخَرِطُ",32,"ط",1,0],["لا يَد لي كَيفَ عِشتُ وَقَد","حَكَمَت لِلمَوتِ فيكَ يَدُ",33,"د",1,0],["لا يدركُ السؤْلَ غير عزمٍ","مثابرٍ يقرَع الحديدا",34,"د",2,0],["لا يُدْعَيَانِ إلى اخْتِتَالِ مُقَاتِلٍ،","يَوْمَ اللّقَاءِ، وَلا احْتِيالِ مُدَبِّرِ",35,"ر",1,0],["لا يدخلنّ جهنّما ذو مطمع","بالمجد أو بالأصفر الرّنّان",36,"ن",1,0],["لا يَدبُّ الملالُ فيها ولا يُنْ","قِض من عَقْد سحْرِها تَوْكيدُ",37,"د",1,0],["لاَ يُدْعَىْ ذَاكَ وَلاَ هَذَا","بَلْ يُدْعَىْ أَزْرَىْ مِنْ مُزْرِيْ",38,"ر",2,0],["لا يدخل النار أَسير الهَوى","إِذ لا يَرى الجَنة أَهل العَذاب",39,"ب",1,0],["لا يدرك العقل من مديحه لسوى","أن المدائح فيه كلها انحصروا",40,"ر",3,0],["لا يدخلُ الفقر لي بيتاً فيخرجُني","إلى سواه فجودٌ منه يعتبِني",41,"ن",2,0],["لا يدعي إرثَ نيلِ العلم ويحك مَن","قد غير الأصلَ منه الجهلُ إِذ جَهِلاَ",42,"ل",2,0],["لا يداني قلبه فزعٌ","لا ولا يهتزّ من وجلِ",43,"ل",1,1],["لا يدّعِى إقدامَه أحدٌ","وإن ادعاه فوالدُ الشِّبلِ",44,"ل",1,0],["لا يَدَّعِ المَجدَ المُؤَثَّلَ مُدَّعٍ","فَالمَجدُ مِن هَذي الخِلالِ مُرَكَّبُ",45,"ب",1,0],["لا يَدَّعوا النُصحَ بِاِعتِرافِهِمُ","لَو وَجَدوا الجَحدَ مُمكِناً جَحَدوا",46,"د",3,0],["لا يَدَّعِ الآنَ ما أوتيتَ مِن شَرَفٍ","مَن لا يُقيمُ عَلى دَعواهُ بُرهانا",47,"ن",2,0],["لا يدفع الفقر تقتير يواظبه","بل يكسف الفقر إقبال يشاغبه",48,"ب",2,0],["لا يدخل العذل الملوم بسمعه","حاشا مسامعه عن الفحشاء",49,"ا",2,0],["لا يَدخُل التَبديلُ في آياتِهِ","كَلّا وَما إِعجازُهُ بِالفاني",50,"ن",2,0],["لا يُدرِكُ العَلياءَ إِلّا فَتىً","آبٍ عَلى حَملِ الأَسى عازِفُ",51,"ف",1,0],["لا يدبر البقال إلا إذا","تصالح السنور والفاره",52,"ه",1,0],["لا يدّعي مثلاً له","في الناس غير الأحول",53,"ل",1,0],["لا يدركون بغاية في المجد","من ماض وباق",54,"ق",1,0],["لا يَدْعُونَّكَ بِالْجَوادِ مُقَصِّرٌ","وأَقَلُّ حَقِّكَ أَنْ يُقالَ جَوادُ",55,"د",1,0],["لا يُدْرِكُ الْجارُونَ غايَةَ مَجْدِهِ","مَنْ يَسْتَطِيعُ إِلى السَّماءِ تَسَلُّقا",56,"ق",2,0],["لا يُدْرِكُ المجدَ إلا كُلُّ مُدَّلِجٍ","يَدْرِي ويَعْلَمُ أَنَّ العِزَّ في النَّقَلِ",57,"ل",1,0],["لا يُدنِيَنك منه رقَّة خُلقه","فالسيفُ يقطعُ إذ يرقُّ حديدُهُ",58,"د",2,0],["لا يدرك العالمُ الكلي حقيقتَه","ولا تَجسُّدَه العالي عن المثَل",59,"ل",1,0],["لأَيديهِ في كلِّ عنقٍ يدٌ","ومنها أُفيضَتْ لنا أنعُم",60,"م",1,0],["لا يدركها نظر كلّا","بل تسبق عين المرتقب",61,"ب",1,0],["لا يدّعي الطيفُ أنّ الليلَ يُتلِفُه","أما هدَتْهُ من الأشواقِ نيرانُ",62,"ن",1,0],["لا يدرك المجد من لم يجعل السببا","جرد المذاكي وسمر الخط والقضبا",63,"ب",2,1],["لا يدرك المجد من جدٍ زكٍ وأب","بغير جدٍ وإقبال السعادات",64,"ت",1,0],["لا يدرك الفوز إلا بعد أربعةٍ","وهن هن إلى الجنات كالدرج",65,"ج",1,0],["لا يدي تُعطى على الهون ولا","نَخَواتي بعصا الضيم مَسوقَهْ",66,"ق",2,0],["لا يُدرك الحيُّ عيباً فيه ينْقَمُه","وفي قميصيْهِ ذو نِيقٍ وشؤْبوبُ",67,"ب",1,0],["لا يُدرك الأملَ الأسنى سوى رجلٍ","يشقُّ بحرَ الرّدى عن جوهرِ الأملِ",68,"ل",1,0],["لا يُدركنَّ مديحَهُ لسِنٌ ولو","نظمَ الكواكبِ في قلائِدِ شِعرِهِ",69,"ر",2,0],["لا يدرك المجد إلا كل مقتحم","في موج ملتطم أو فوج مضطرم",70,"م",1,0],["لا يُدرك العزَّ إلّا كلُّ ذي أَنَفٍ","نابٍ عن العجزِ شَرّادٍ عن الوَهَنِ",71,"ن",1,0],["لا يَدفَعُ الأَمَلَ القَريبَ لِعَودِهِ","في حينِ دَفعِ الغَيثِ حَمدَ الرُوَّدِ",72,"د",1,0],["لا يدعي أمراً فلا التحوُّل","له ولا القوة فيما يجعل",73,"ل",1,0],["لا يدانيه سواه وهل","عسل يشبهه الأَقَط",74,"ط",1,0],["لا يَدَّعِي العاشِقُونَ مَرْتَبتي","مَتَى تَساوَى التُّرابُ والذَّهبُ",75,"ب",1,0]]}