habi.ae/diwan/poem/108649","الكامل"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106705","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118422","الوافر"],[1954,"","https://poetry.dctabudhabi.ae/diwan/poem/188168","الوافر"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69347","الوافر"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71079","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124777","الطويل"],[2521,"","https://poetry.dctabudhabi.ae/diwan/poem/110659","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200169","البسيط"],[2957,"","https://poetry.dctabudhabi.ae/diwan/poem/198411","المتقارب"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132577","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89268","الوافر"],[3508,"","https://poetry.dctabudhabi.ae/diwan/poem/20542","المتقارب"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131016",""],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59458","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77007","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54418","الطويل"],[4325,"","https://poetry.dctabudhabi.ae/diwan/poem/29462","المتقارب"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72476","السريع"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35093","الكامل"],[4930,"سمراء","https://www.poetsgate.com/ViewPoem.aspx?id=212978",""],[5189,"أنشودة ... تعالوا","https://www.poetsgate.com/ViewPoem.aspx?id=199860",""],[5364,"بلاد الشام تنخاكم","https://www.poetsgate.com/ViewPoem.aspx?id=177160",""],[5376,"وقامت أُخيَّة تلقي السلام......من حماه","https://www.poetsgate.com/ViewPoem.aspx?id=188421",""],[5431,"ذئبي...مازال يعوي جائعا متعففا","https://www.poetsgate.com/ViewPoem.aspx?id=199589",""],[5431,"سينقذنا همامٌ عنتريٌ ولا يخشى لعولمةٍ شِراكا","https://www.poetsgate.com/ViewPoem.aspx?id=201631",""],[5690,"لواؤك سيدي عبد الحميد","https://www.poetsgate.com/ViewPoem.aspx?id=172136",""],[6187,"أتذكر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82158&r=&rc=2",""]],"verses":[["بِعودِهِ عِندَ ضَنِّهِ يَبَسٌ","وَفي يَدَيهِ مِنَ النَدى بَلَلُ",0,"ل",1,0],["بِعُودٍ تَرَى وَقْعَ الأَنَامِلِ فَوْقَهُ","كَمَا اجْتَهَدْتَ فِي نَسْجِهِنْ العَنَاكِبُ",1,"ب",1,0],["بَعَونا فَاِلتَمَسنا ما لَدَيهِم","وَكادونا بِكَبشِهِمُ فَكيدوا",2,"د",3,0],["بعودة المولى","فالطالع المسعود",3,"د",1,0],["بعوارم لا ذنب لي في نسجها","إذ كان ما أسْدَتْ يداك لها سَدَى",4,"د",2,0],["بِعَودَةِ الدَولَةِ الغَرّاءِ ثانِيَةً","سَلَوتُ عَنكَ وَنامَ اللَيلَ ساهِرُهُ",5,"ر",2,0],["بِعُودٍ ترى وَقْعَ الأناملٍ فوْقَها","كما اجْتَهَدْتَ في نَسْجِهنَّ العناكبً",6,"ب",1,0],["بعودةِ عيد الفطر لا زالَ عائداً","عليك بتيسير الغِنَى والمواهِبِ",7,"ب",1,0],["بِع واسِطاً بِالنَأيِ وَالهَجرِ","وَدَعِ المُرورَ بِها إِلى الحَشرِ",8,"ر",1,1],["بِعَوْدِكَ يَا شَمْسَ العُلاَ بِالْحُلَى الأُلَى","عَهِدْنَا لبُرْجِ السعْدِ بلْ أَنتَ أَضْوَأُ",9,"ا",1,0],["بِعَونِ اللَه تَمَّ الشَرحُ نظماً","وَنَثراً مخجِلاً دُرَّ النِظامِ",10,"م",1,1],["بعودة الايام لا تحلمي","وفي خفوق القلب لا تطمعي",11,"ع",2,0],["بِعَوْدٍ كما عاد الكَليم بنُجْحِه","إذا جَدَّ بالعاشي إليه طِلاب",12,"ب",1,0],["بعوارفٍ ومعارفٍ ولطائفٍ","تُجلى القلوب بها من الأدران",13,"ن",1,0],["بعواطِفِ اليَمَنِ الَّتِي أَنتُمْ لَهَا","وهِيَ اليَمِينُ أَنامِلٌ وأَصابِعُ",14,"ع",1,0],["بعودةٍ من سَفرَةٍ","مُمتِعَةٍ أورُبيَه",15,"ي",2,0],["بِعواطفِ الإخلاصِ قَد ذابت عَوا","طِفُكُم وللإخلاصِ سِرٌّ مُسفِرُ",16,"ر",1,0],["بعواطفِ لي القضيب لو يتُمُ","عطفي إلى أن خلته يتكسرُ",16,"ر",1,0],["بِعودتكَ الحَمرَاء تمَّ لها القصدُ","فَذِي عودةٌ كالشمسِ يقُدمُها السَّعد",17,"د",1,1],["بعوازِبِ القَفَراتِ بين شقيقةٍ","وكثيبِها يتنظّرُ الحَدَثانا",18,"ن",2,0],["بعودك عادت دولة الكرم الغمر","وأصبح طيء الجود يؤذن بالنشرِ",19,"ر",1,1],["بِعودِ النّجوج أَضاءَ وَقودُها","مَهاً في ظِلالِ السِّدرِ حوراً جَوازِيا",20,"ي",2,0],["بعَودِ مولانا وهل من نعمة","أكثرُ من خلاصِه مما طرَقْ",21,"ق",1,0],["بعواسل وفواصل","وصواهل جُردٍ ضوآمِرْ",22,"ر",1,0],["بعَودِك عادَ فى مصرٍ مُزاحُ ال","حياةِ إلى نظام الاعتدال",23,"ل",1,0],["بِعونٍ عَلَيهِنَّ مِن بَهجَةٍ","وَحُسنِ غَضاضَةِ أَبكارِها",24,"ر",3,0],["بعوامل فيها الممات لعاملٍ","طاغٍ وفيها للعفاة الخِير",25,"ر",1,0],["بِعَوَازمٍ وَعَوَاسِلٍ وصَوارِمٍ","لِرَحَى النّوائبِ والعُجالَةِ دُفَّعِ",26,"ع",1,0],["بعوج كالخذاريب استمرت","يخذر فن الحصا سمر العجايا",27,"ا",3,0],["بعودة مصر قد عادت أمان","وعزم العرب أصبح في اشتعال",28,"ل",1,0],["بِعَودٍ لا يَزالُ يُهانُ حَتّى","يُناخَ بِمُدرِكِيٍّ لا يُهانُ",29,"ن",1,0],["بعَوْنِ وَلِّي الله أَبْلُغُ كلمَّا","اُحاوِلُهُ من شَيْدِ كلِّ مَعَالِ",30,"ل",1,0],["بعونك جئنا فوق كل مسخر","فجد بالرضا يا رب قبل التبعد",31,"د",1,0],["بعودة نوروز أعاد لنا الهنا","بأشرف عيد في الجديدن ماكراً",32,"ر",2,0],["بعوضة أنا في الدنيا وحين أرى","بعض الورى فكأني بينهم فيل",33,"ل",1,0],["بعوض جعلن دمي قهوة","وغنينني بضروب الأغان",34,"ن",1,1],["بعود القاسم الوفر","وعرس الماجد الرشدي",35,"د",2,0],["بعون اللَه سيدنا","تباهى الدين والملكُ",36,"ك",1,1],["بِعُودٍ مِنَ الهِند عِندَ التِجا","رِ غالٍ يُخالِطُ مِسكاً مُدافا",37,"ف",2,0],["بعودك قد بردت قلبا ملكته","وكان على نار النوي يتقلب",38,"ب",1,0],["بعون الله نَملُك كلَّ فَجِ","ونطفو بِالخضمِّ على البلادِ",39,"د",1,0],["بعويلٍ وقطع شهرٍ وندبٍ","جاءتا النعش تلمسان النطابا",40,"ب",2,0],["بِعَونِ إلهِ العَرشِ جَلَّ ثَناؤُه","وَتَأييدِه تاجَ المُلوكِ القَماقِم",41,"م",1,0],["بعودِكَ عادَ الحقُّ واتّضحَ الهدى","وهبَّ نسيمُ النّصرِ وانفرجَ الضّغْطُ",42,"ط",1,0],["بِعَوفِ بنِ كَعبٍ وَجَمعِ الرّبَا","بِ أَمراً قَوِيّاً وَجَمعاً كُثَارا",43,"ر",2,0],["بعون أصحاب العبا أرَّخوا","شاد سليم مرقد الفرقدين",44,"ن",1,0],["بِعَوارِفٍ عَمَرَ البِلادَ بِها","فَاِخضَرَّ مِنها الغَورُ وَالنَجدُ",45,"د",1,0],["بعواصمِ القلبِ امتلكتِ قلاعَا","ما حُزْتِ سيفًا أو أدرتِ صراعَا",46,"ع",2,1],["بعون الله نجتازُ الصعابا","فمن قصد النجاح فقد أصابا",47,"ا",1,0],["بعون الله ما نركع ولو يملى جسدنا رماح","مثل جذع الشجر ناقف نموت بعزّ لا متنا",48,"ن",2,0],["بعوز وقحط وسغب وجوع","كأن غدونا بشهر الصيام",49,"م",1,0],["بعوائه صوت المجاز كشحنةٍ","حمراء تقتنصُ الشعور تخطّفا",50,"ف",2,0],["بعوْلمةٍ تصيدُ كنوز عُمْرٍ","لنجترّ المذلةَ والهلاكا",51,"ك",2,0],["بعومٍ لو قذفت به جبالاً","لدكّت لا محالة للصعيد",52,"د",1,0],["بعون الله إنى عدت كلى","طموح الحر منتفضا نزيها",53,"ي",3,0]]}