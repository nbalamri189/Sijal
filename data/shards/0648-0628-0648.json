{"poems":[[53,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[53,"خصيم من الأيام لي وشفيع","https://www.aldiwan.net/poem30151.html","الطويل"],[53,"ما لذا الداني إلى القلب شحط","https://www.aldiwan.net/poem30161.html","الرمل"],[3,"بين العقيق وبين بُرقة ثهمد","https://www.aldiwan.net/poem152.html",""],[77,"حديث على رغم العلا غير كاذب","https://www.aldiwan.net/poem36768.html","الطويل"],[77,"سيدي أنت عمدتي فاحتملني","https://www.aldiwan.net/poem36788.html","الخفيف"],[24,"مسح النبي جبينه","https://www.aldiwan.net/poem21894.html","مجزوء الكامل"],[86,"أشرق فدتك مشارق الإصباح","https://www.aldiwan.net/poem10673.html","الكامل"],[73,"أما في نسيم الريح عرف معرف","https://www.aldiwan.net/poem11914.html","الطويل"],[93,"في حيكم لي قلب جد مرتهن","https://www.aldiwan.net/poem11218.html","البسيط"],[93,"فجع القريض وقد ثوى حسان","https://www.aldiwan.net/poem11217.html","البسيط"],[93,"يا حبيباً ما لي سواه حبيب","https://www.aldiwan.net/poem11285.html","الخفيف"],[83,"لك الله من فذ الجلالة أوحد","https://www.aldiwan.net/poem54297.html","الطويل"],[37,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[23,"بطيبة رسم للرسول ومعهد","https://www.aldiwan.net/poem21547.html","الطويل"],[72,"ما الطرف بعدكم بالنوم مكحول","https://www.aldiwan.net/poem19466.html","البسيط"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"مدحتك أكلأ النسرين ليلي","https://www.aldiwan.net/poem66705.html","الوافر"],[29,"طرق الكرى بالغانيات وربما","https://www.aldiwan.net/poem6174.html","الكامل"],[91,"دبت وقد أرخى الظلام ستارا","https://www.aldiwan.net/poem8861.html","عموديه"],[62,"الحمد لله الذي خصنا","https://www.aldiwan.net/poem52220.html","السريع"],[62,"يا بؤس منتزع من ثدي والدة","https://www.aldiwan.net/poem52310.html","البسيط"],[45,"يا أخا الأزد ما حفظت الإخاء","https://www.aldiwan.net/poem10196.html","الخفيف"],[45,"إن سير الخليط حين استقلا","https://www.aldiwan.net/poem65546.html","الخفيف"],[45,"لولا تعنفني لقلت المنزل","https://www.aldiwan.net/poem65578.html","الكامل"],[45,"هم ألى رائحون أم غادونا","https://www.aldiwan.net/poem66662.html","الخفيف"],[28,"وبواضح رتل تشف غروبه","https://www.aldiwan.net/poem5543.html","الكامل"],[61,"كبوة الهم بين كاس وكوب","https://www.aldiwan.net/poem51764.html","الخفيف"],[80,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[44,"وافى الحبيب الزائر","https://www.aldiwan.net/poem30250.html","مجزوء الكامل"],[44,"ما عهدنا كذا نحيب المشوق","https://www.aldiwan.net/poem30395.html","الخفيف"],[31,"قد صبا القلب صبا غير دني","https://www.aldiwan.net/poem38731.html","الرمل"],[31,"قد أصاب القلب من نعم","https://www.aldiwan.net/poem41325.html","المديد"],[74,"أرقت على الصبا لطلوع نجم","https://www.aldiwan.net/poem12871.html","الوافر"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85446","الخفيف"],[32,"","https://poetry.dctabudhabi.ae/diwan/poem/8239","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42493","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54820","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54898","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141964","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5138","الكامل"],[45,"هُمُ أُلَى رائِحُونَ، أو غَادُونَا","https://www.poetsgate.com/ViewPoem.aspx?id=32088",""],[51,"أخفُّ مناطاً في الرقاب وأوْكَدُ","https://www.poetsgate.com/ViewPoem.aspx?id=25837",""]],"verses":[["وَبِوُدِّهِ لَو كانَ قَرناً سالِفاً","أَو نُطفَةً ذَهَبَت بِداءٍ مُغيِلِ",0,"ل",1,0],["وَبَوضُ مَقالِ القائِلينَ مُكَذَّبٌ","وَبَعضُ وِرادِ الأَقرَبينَ خَدوعُ",1,"ع",1,0],["وَبَواقٍ غَيرُ باقينَ وَكَم","يَلبَثُ القارِبُ مِن بَعدِ الفَرَط",2,"ط",1,0],["وَبَوارِقُ البيضِ الرِقاقِ لَوامِعٌ","في عارِضٍ مِثلِ الغَمامَ المُرعِدِ",3,"د",1,0],["وَبَوَّاكَ مَنْ أَعْلَى الْجِنَانِ قُصُورَهُ","تُحَيِّيكَ فِيهَا مُسْبَلاتُ الذَّوَائِبِ",4,"ب",1,0],["وَبَوَادٍ يَجْري لَكَ الجِلْفُ مِنْهُمْ","بِكِسَاءٍ طَوْراً وَدُونَ كِسَاءِ",5,"ا",2,0],["وَبِوَجهِهِ ديَباجَةٌ","كَرَمُ النُبُوَةِ وَالجُدودِ",6,"د",1,0],["وَبَواسِقُ السودانِ تَشهَدُ أَنَّها","غُرِسَت بِعَهدِ جُدودِكَ الفُتّاحِ",7,"ح",1,0],["وَبَوَّأتَهُ دُنياكَ دارَ مُقامَةٍ","بِحَيثُ دَنا ظِلٌّ وَذُلِّلَ مَقطِفُ",8,"ف",1,0],["وَبُورِكَتْ فِي بُيُوتِ العِلْمِ مَدْرَسَةٌ","زَادَتْ مَدِينَتَهُ تِيهاً عَلَى الْمُدُنِ",9,"ن",1,0],["وَبَوَادِرٌ وَنَوَادِرٌ مِنْ قَوْلِهِ","لَيْسَتْ تَمَلُّ سَمَاعَهَا الآذَانُ",10,"ن",1,0],["وَبِوَدِّي لَوْ كُنْتَ لِي لِيَ وَحْدِي","أَنِّي أَقْصَرْتُ عَنْكَ مَلامِي",11,"ي",1,0],["وبوأتني من ذروة العز معتلّى","وشرفتني من حيث أدري ولا أدري",12,"ر",2,0],["وبُورِكتَ مَولُوداً وبُورِكتَ نَاشِئاً","وبُورِكتَ عِندَ الشَّيبِ إِذ أنتَ أشيَبُ",13,"ب",1,0],["وَبُورِكَ قَبرٌ أنتَ فِيهِ وبُورِكَت","بِهِ وَلَهُ أهلٌ لِذَلِكَ يَثرِبُ",13,"ب",1,0],["وَبورِكَ لَحدٌ مِنكَ ضُمِّنَ طَيِّباً","عَلَيهِ بِناءٌ مِن صَفيحٍ مُنَضَّدُ",14,"د",1,0],["وبورك الزاد إذ مسَّته راحته","فحبذا مشروب منها ومأكول",15,"ل",1,0],["وبُورِك طرفي فالشِّخَاصُ حياله","قَرَائن من أدنى مدىً وَهْيَ فُرَّدُ",16,"د",1,0],["وَبُؤْ بالذنب والعُتبى وإلا","فليسَ بضائري أَلا تَبُوّا",17,"و",2,0],["وَبِوارِدٍ رَجِلٍ كَأَنَّ قُرونَهُ","مِن طولِها مَوصولَةٌ بِحِبالِ",18,"ل",1,0],["وَبَوارِجٌ قَد سُيِّرَت كَالجَحفَلِ","الجَرّارِ تَحمِلُ جَحفَلاً جَرّارا",19,"ر",2,0],["وبؤتُ بالذنب ومن خالقني","أستوهبُ الذنبَ وأستغفرُ",20,"ر",1,0],["وبؤسَ منفردٍ عمَّنْ يُضاجِعُهُ","مشرّدِ النومِ بين الأهلِ والمالِ",21,"ل",1,0],["وَبِوُدِّ العَدُوِّ لَو تُضعِفُ الجَي","شَ عَلَيهِم وَتَصرِفُ الآراءَ",22,"ا",2,0],["وَبِوُدّي لَوِ اِستَطَعتُ فَخَفَّف","تُ بِصَبرٍ عَن سَيِّدي حينَ مَلّا",23,"ل",2,0],["وَبِوَقفَةٍ يُشفي غَليلُ صَبابَةٍ","وَيَقولُ صَبٌّ ما أَرادَ وَيَفعَلُ",24,"ل",1,0],["وَبِوُدِّ القُلوبِ يَومَ إِستَقَلَّت","ظُعُنُ الحَيِّ أَن تَكونَ عُيونا",25,"ن",2,0],["وَبِواضِحٍ رَتلٍ تَشِفُّ غُروبُهُ","عَذبٍ وَأَذلَفَ طَيِّبِ المُتَشَمَّمِ",26,"م",1,1],["وبواطٍ كأنَّهنَّ وِهادٌ","أتَرعَتها سِجالُ غيثٍ سكوبِ",27,"ب",1,0],["وبَوارِقٌ تَنسَلُّ مِنْ أجْفَانها","ورقٌ لزرعِ الهامِ ذاتُ حصادِ",28,"د",1,0],["وَبِوَجنَتَيهِ بَدائِعٌ","لِلجُلِّنارِ ضَرائِرُ",29,"ر",1,0],["وَبَوادي عَقَرقُسٍ لَم تُعَرِّد","عَن رَسيمٍ إِلى الوَغى وَعَنيقِ",30,"ق",1,0],["وَبِوَجهٍ حَسَنٍ صَورَتُهُ","واضِحِ السُنَّةِ ذي ثَغرٍ نَقي",31,"ي",1,0],["وَبِوَحفٍ مائِلٍ رَجَلٍ","كَعَناقيدِ مِنَ الكَرمِ",32,"م",1,0],["وَبُؤتُ بِحَملِها مِن غَيرِ خَطبٍ","كَأَنّي قَد حَمَلتُ بِها عَسيبا",33,"ب",2,0],["وبَوَّأها من أطَيبِ الأرضِ جَنّةً","وأجرى لها من أعذبِ الماءِ كوثرا",34,"ر",2,0],["وَبودي أن يفتحوا فيه باباً","ليهب الصبا عليك بَليلا",35,"ل",2,0],["وَبوحا بِذِكري عِندَ بُثنَةَ وَاِنظُرا","أَتَرتاحُ يَوماً أَم تَهَشَّ إِلى ذِكري",36,"ي",1,0],["وَبَوارِقٌ تَنْهَلُّ فينَا بالنَّدَى","وصَواعِقٌ تَنْقَضُّ في الأَعداءِ",37,"ا",2,0],["وَبِوُدِّكِ الْعَوْدُ الْقَريبُ","لِسِرْبِكِ الْمُسْتمْتِعِ",38,"ع",1,0],["وَبُورِك فِي كُلِّ سَمْحٍ كَرِيمٍ","أَجَابَ نِدَاءَ النَّدَى وَابْتَدَرْ",39,"ر",1,0],["وَبِوَصْفِكَ الأَسْفَارَ فِي أَسْفَارِهَا","أَحْضَرْتَهَا مَنْ فَاتَهُ أَنْ يحْضُرَا",40,"ر",2,0],["وبوالي حقائِقَ الأمس تهديما","ويبني على حقائق أخرى",41,"ر",2,0],["وَبِوُدّي لَو اِحتَمَلتُ فِداءً","عَنهُ ذاكَ الضَنى وَتِلكَ الكُروبا",42,"ب",2,0],["وَبِوُدِّ قَومِهُمُ الأُلى بَعَثوا بِهِم","لَو ضَمَّهُم بِالأَمسِ ذاكَ المَحفَلُ",43,"ل",1,0],["وَبِوِدّ القُلُوبِ، يَوْمَ استَقَلّتْ","ظُعُنُ الحَيّ، لَوْ تكونُ عُيُونا",44,"ن",2,0],["وبورك طرْفي فالشخوص حياله","قَرَائن من أدنى مدى ً وَهْيَ فُرَّدُ",45,"د",1,0]]}