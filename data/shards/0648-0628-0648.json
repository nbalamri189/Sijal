98,"قد تداعت من الأقاح خيوط","https://www.aldiwan.net/poem37784.html","الخفيف"],[498,"ما بين جرعاء اليلملم والعلم","https://www.aldiwan.net/poem37799.html","الكامل"],[503,"الوصيّة","https://www.aldiwan.net/poem27795.html","الطويل"],[504,"يحسب الناس بأني متعب","https://www.aldiwan.net/poem2437.html","الرمل"],[504,"بشراي أبصرتك خير إمام","https://www.aldiwan.net/poem2462.html","الكامل"],[513,"في مثل مدحك شرح القول مختصر","https://www.aldiwan.net/poem12117.html","البسيط"],[538,"إن سليمى والله يكلؤها","https://www.aldiwan.net/poem56917.html","المنسرح"],[549,"نولِينا منك الغداة قليلا","https://www.aldiwan.net/poem47318.html","الخفيف"],[549,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[549,"إن قطعتني علتي عن قصدي","https://www.aldiwan.net/poem47845.html","الرجز"],[549,"من عذيري من سقام","https://www.aldiwan.net/poem48076.html","مجزوء الرمل"],[549,"على مثل هذا اليوم تحنى الرواجب","https://www.aldiwan.net/poem48099.html","الطويل"],[551,"آثار أطلال برومة درس","https://www.aldiwan.net/poem68418.html","الكامل"],[556,"يا صدق القوم عن جمالك قد رووا","https://www.aldiwan.net/poem33584.html","الكامل"],[556,"نحن قوم نهوى الوجوه الحسانا","https://www.aldiwan.net/poem33816.html","الخفيف"],[584,"وحياتكم في عزكم وهواني","https://www.aldiwan.net/poem17795.html","الكامل"]],"verses":[["وَبِوُدِّهِ لَو كانَ قَرناً سالِفاً","أَو نُطفَةً ذَهَبَت بِداءٍ مُغيِلِ",0,"ل",1,0],["وَبَوضُ مَقالِ القائِلينَ مُكَذَّبٌ","وَبَعضُ وِرادِ الأَقرَبينَ خَدوعُ",1,"ع",1,0],["وَبَواقٍ غَيرُ باقينَ وَكَم","يَلبَثُ القارِبُ مِن بَعدِ الفَرَط",2,"ط",1,0],["وَبَوارِقُ البيضِ الرِقاقِ لَوامِعٌ","في عارِضٍ مِثلِ الغَمامَ المُرعِدِ",3,"د",1,0],["وَبَوَّاكَ مَنْ أَعْلَى الْجِنَانِ قُصُورَهُ","تُحَيِّيكَ فِيهَا مُسْبَلاتُ الذَّوَائِبِ",4,"ب",1,0],["وَبَوَادٍ يَجْري لَكَ الجِلْفُ مِنْهُمْ","بِكِسَاءٍ طَوْراً وَدُونَ كِسَاءِ",5,"ا",2,0],["وَبِوَجهِهِ ديَباجَةٌ","كَرَمُ النُبُوَةِ وَالجُدودِ",6,"د",1,0],["وَبَواسِقُ السودانِ تَشهَدُ أَنَّها","غُرِسَت بِعَهدِ جُدودِكَ الفُتّاحِ",7,"ح",1,0],["وَبَوَّأتَهُ دُنياكَ دارَ مُقامَةٍ","بِحَيثُ دَنا ظِلٌّ وَذُلِّلَ مَقطِفُ",8,"ف",1,0],["وَبُورِكَتْ فِي بُيُوتِ العِلْمِ مَدْرَسَةٌ","زَادَتْ مَدِينَتَهُ تِيهاً عَلَى الْمُدُنِ",9,"ن",1,0],["وَبَوَادِرٌ وَنَوَادِرٌ مِنْ قَوْلِهِ","لَيْسَتْ تَمَلُّ سَمَاعَهَا الآذَانُ",10,"ن",1,0],["وَبِوَدِّي لَوْ كُنْتَ لِي لِيَ وَحْدِي","أَنِّي أَقْصَرْتُ عَنْكَ مَلامِي",11,"ي",1,0],["وبوأتني من ذروة العز معتلّى","وشرفتني من حيث أدري ولا أدري",12,"ر",2,0],["وبُورِكتَ مَولُوداً وبُورِكتَ نَاشِئاً","وبُورِكتَ عِندَ الشَّيبِ إِذ أنتَ أشيَبُ",13,"ب",1,0],["وَبُورِكَ قَبرٌ أنتَ فِيهِ وبُورِكَت","بِهِ وَلَهُ أهلٌ لِذَلِكَ يَثرِبُ",13,"ب",1,0],["وَبورِكَ لَحدٌ مِنكَ ضُمِّنَ طَيِّباً","عَلَيهِ بِناءٌ مِن صَفيحٍ مُنَضَّدُ",14,"د",1,0],["وبورك الزاد إذ مسَّته راحته","فحبذا مشروب منها ومأكول",15,"ل",1,0],["وبُورِك طرفي فالشِّخَاصُ حياله","قَرَائن من أدنى مدىً وَهْيَ فُرَّدُ",16,"د",1,0],["وَبُؤْ بالذنب والعُتبى وإلا","فليسَ بضائري أَلا تَبُوّا",17,"و",2,0],["وَبِوارِدٍ رَجِلٍ كَأَنَّ قُرونَهُ","مِن طولِها مَوصولَةٌ بِحِبالِ",18,"ل",1,0],["وَبَوارِجٌ قَد سُيِّرَت كَالجَحفَلِ","الجَرّارِ تَحمِلُ جَحفَلاً جَرّارا",19,"ر",2,0],["وبؤتُ بالذنب ومن خالقني","أستوهبُ الذنبَ وأستغفرُ",20,"ر",1,0],["وبؤسَ منفردٍ عمَّنْ يُضاجِعُهُ","مشرّدِ النومِ بين الأهلِ والمالِ",21,"ل",1,0],["وَبِوُدِّ العَدُوِّ لَو تُضعِفُ الجَي","شَ عَلَيهِم وَتَصرِفُ الآراءَ",22,"ا",2,0],["وَبِوُدّي لَوِ اِستَطَعتُ فَخَفَّف","تُ بِصَبرٍ عَن سَيِّدي حينَ مَلّا",23,"ل",2,0],["وَبِوَقفَةٍ يُشفي غَليلُ صَبابَةٍ","وَيَقولُ صَبٌّ ما أَرادَ وَيَفعَلُ",24,"ل",1,0],["وَبِوُدِّ القُلوبِ يَومَ إِستَقَلَّت","ظُعُنُ الحَيِّ أَن تَكونَ عُيونا",25,"ن",2,0],["وَبِواضِحٍ رَتلٍ تَشِفُّ غُروبُهُ","عَذبٍ وَأَذلَفَ طَيِّبِ المُتَشَمَّمِ",26,"م",1,1],["وبواطٍ كأنَّهنَّ وِهادٌ","أتَرعَتها سِجالُ غيثٍ سكوبِ",27,"ب",1,0],["وبَوارِقٌ تَنسَلُّ مِنْ أجْفَانها","ورقٌ لزرعِ الهامِ ذاتُ حصادِ",28,"د",1,0],["وَبِوَجنَتَيهِ بَدائِعٌ","لِلجُلِّنارِ ضَرائِرُ",29,"ر",1,0],["وَبَوادي عَقَرقُسٍ لَم تُعَرِّد","عَن رَسيمٍ إِلى الوَغى وَعَنيقِ",30,"ق",1,0],["وَبِوَجهٍ حَسَنٍ صَورَتُهُ","واضِحِ السُنَّةِ ذي ثَغرٍ نَقي",31,"ي",1,0],["وَبِوَحفٍ مائِلٍ رَجَلٍ","كَعَناقيدِ مِنَ الكَرمِ",32,"م",1,0],["وَبُؤتُ بِحَملِها مِن غَيرِ خَطبٍ","كَأَنّي قَد حَمَلتُ بِها عَسيبا",33,"ب",2,0],["وبَوَّأها من أطَيبِ الأرضِ جَنّةً","وأجرى لها من أعذبِ الماءِ كوثرا",34,"ر",2,0],["وَبودي أن يفتحوا فيه باباً","ليهب الصبا عليك بَليلا",35,"ل",2,0],["وَبوحا بِذِكري عِندَ بُثنَةَ وَاِنظُرا","أَتَرتاحُ يَوماً أَم تَهَشَّ إِلى ذِكري",36,"ي",1,0],["وَبَوارِقٌ تَنْهَلُّ فينَا بالنَّدَى","وصَواعِقٌ تَنْقَضُّ في الأَعداءِ",37,"ا",2,0],["وَبِوُدِّكِ الْعَوْدُ الْقَريبُ","لِسِرْبِكِ الْمُسْتمْتِعِ",38,"ع",1,0],["وَبُورِك فِي كُلِّ سَمْحٍ كَرِيمٍ","أَجَابَ نِدَاءَ النَّدَى وَابْتَدَرْ",39,"ر",1,0],["وَبِوَصْفِكَ الأَسْفَارَ فِي أَسْفَارِهَا","أَحْضَرْتَهَا مَنْ فَاتَهُ أَنْ يحْضُرَا",40,"ر",2,0],["وبوالي حقائِقَ الأمس تهديما","ويبني على حقائق أخرى",41,"ر",2,0],["وَبِوُدّي لَو اِحتَمَلتُ فِداءً","عَنهُ ذاكَ الضَنى وَتِلكَ الكُروبا",42,"ب",2,0],["وَبِوُدِّ قَومِهُمُ الأُلى بَعَثوا بِهِم","لَو ضَمَّهُم بِالأَمسِ ذاكَ المَحفَلُ",43,"ل",1,0],["وَبِوِدّ القُلُوبِ، يَوْمَ استَقَلّتْ","ظُعُنُ الحَيّ، لَوْ تكونُ عُيُونا",44,"ن",2,0],["وبورك طرْفي فالشخوص حياله","قَرَائن من أدنى مدى ً وَهْيَ فُرَّدُ",45,"د",1,0],["وَبِوَجنَتَيهِ عَجائب مِن بَعضِها","نار يَشب ضرامها بِالماءِ",46,"ا",2,0],["وبوجد ما رحت انتشق الور","د دموي من مزلفي مجنته",47,"ه",1,0],["وبوجهك القمر استنا","ر مقدرا وله منازل",48,"ل",1,0],["وبودي الوادي الذي سكنته","فهو وادي روحي وداء مماتي",49,"ت",2,0],["وبوم يحيي الليل في حالك الدجى","بنعق له جأش المصاليت يجزع",50,"ع",1,0],["وَبُوِّىء مِقعَدُ المِغراجِ فِيهَا","وَصَوَّتَ شِربَ أذوَادٍ صَوَادِ",51,"د",1,0],["وبوائقُ الأيّام عاديةً","لاقَين منه دامِىَ الظُّفرِ",52,"ر",1,0],["وَبَواجِبٍ أَن أَعدَمَتكَ مِنَ الوَرى","مَثَلاً عُلىً بُنِيَت بِغَيرِ مِثالِ",53,"ل",1,0],["وبؤتُ بسخط ربك لا بحمدٍ","ولا أجر وعرضك مستباحُ",54,"ح",1,0],["وبورك في الميلاد منه وأصبحت","عليه المعالي وهو طفل يطفل",55,"ل",1,0],["وبَوَّءَ وفدَها كنفاً رَحيباً","مرودَ العُشبِ مَورودَ الزُّلالِ",56,"ل",1,0],["وَبِوَفدِهِ أَرِّخ مَلائكةَ العُلى","حَيَّت جَميعاً وَجهَ ميخائيلِ",57,"ل",1,0],["وَبِوَفدِهِ أَرِّخ ملائكةَ العُلا","وافَت فَحَيَّت وَجهَ جِبرائيلِ",58,"ل",1,0],["وبودّي لو اَنَّ في","حتف روحي لك الشِّفا",59,"ف",2,0],["وَبِوَصفِهِم أَضحى المُتوّجُ تُبَّع","بِالمُصطَفى العَرَبِيِّ ذا إيمانِ",60,"ن",1,0],["وَبِوَعدِهِ ظَفَروا بِكَنزَي فارِسٍ","وَالرّوم ينفقُ فيهِما الكَنزانِ",60,"ن",1,0],["وَبِوَجنَةٍ أَضحَت لَهيبَ جَهَنَّمٍ","فَاِعجَب وَذاكَ لَها عِذارُ سُندُسُ",61,"س",1,0],["وَبِوَجهِهِ بِشرٌ مَخا","ئِلُهُ لِشائِمِهِ صَوادِق",62,"ق",1,0],["وَبَوَّأَهُ يَوْمَ الْقِيَامَةِ مَرْبَعاً","تَهُبُّ بِهِ رِيحُ الْمُنَى عِطْرَ الشَّذَا",63,"ا",1,0],["وَبونٌ بَينَ مالِكِ بَيتِ مالٍ","وَمالِكِ رقِ أَملاكِ النَواحي",64,"ح",2,0],["وبؤسها دون ان يعاني","سهداً به جفنك القريح",65,"ح",1,0],["وبوحي على النّجوى بسرِّك لي كما","أبوحُ بسرّي في حرارةِ إيماني",66,"ي",1,0],["وَبورِكتَ مِن قائِلٍ فاعِلٍ","وَكَم قائِلٍ لَيسَ بِالفاعِلِ",67,"ل",1,0],["وَبَوِّئَنّي طَيبَةً مَوطِناً","فإنَّها لي سابقاً مَولِدُ",68,"د",1,0],["وَبِوادي الفَضلِ عاكِفٌ","فَأَدِم رَبّي عُكوفي",69,"ي",1,0],["وبوضعه الإحياء فاق فيا له","من واضع وكمثله لم يوضع",70,"ع",1,0],["وَبِوادي العقيقِ سرحة فيءٍ","قد سقاها العقيق من أجفاني",71,"ن",2,0],["وَبِوُشحٍ قَلِقاتٍ","في بُطرُنٍ وَظُهورِ",72,"ر",1,0],["وبوركتم من الاساد اقوى","قلوباً في الوغى واحد نابا",73,"ب",2,0],["وبورك ترب سوريا ترابا","حواكم يا ضحاياها الشبابا",73,"ب",2,0],["وَبَوَجدي فيهِ إِذ ضَيَّعَني","عَن وُجودي دَلَّني مِنّي عَلَي",74,"ي",1,0],["وبُورِكْتَ من غَيْثٍ مدَى الدَّهْرِ ماطرٍ","تَجودُ بما تَحْوِي وبالعِرْضِ باخل",75,"ل",1,0],["وبوَجْدٍ كوَجْدِ حُسّادِ مَوْلا","يَ أبي نَصْرٍ الكريمِ النِّجار",76,"ر",1,0],["وَبَوَّأَكَ الجودُ يَااِبنَ الكِرامِ","نَجائِبَ أَقوالِنا الخالِدَه",77,"د",2,0],["وبوَجهِها ماءُ الشَّبا","بِ خَليطُ نارِ الوَجنَتَينِ",78,"ن",1,0],["وبِوادٍ به النواقيسُ تتلو","نغماً طيباً وحمداً طويلا",79,"ل",2,0],["وَبودي لَو أَن لي أَلف نَفس","كُل نَفسٍ تَقيهِ أَلف هَلاك",80,"ك",1,0],["وبوّاني عند شمسِ الهدى","مَحَلاًّ تقاصرَ عنه زُحَل