{"poems":[[55,"ولقد دفنت هواكم","https://www.aldiwan.net/poem26485.html","مجزوء الكامل"],[71,"لو لم يخالط يوم بينك أدمعي","https://www.aldiwan.net/poem4029.html","الكامل"],[51,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[29,"كذبتك عينك أم رأيت بواسط","https://www.aldiwan.net/poem6031.html","الكامل"],[89,"أي قدس يضم هذا البناء","https://www.aldiwan.net/poem44981.html","الخفيف"],[62,"لجلال قدرك تخضع الأقدار","https://www.aldiwan.net/poem52392.html","الكامل"],[28,"ليست ترد ديات من قد قتلت","https://www.aldiwan.net/poem5440.html","الكامل"],[31,"ولقد دخلت الحي يخشى أهله","https://www.aldiwan.net/poem42660.html","الكامل"],[105,"أنا بنو عثمان أعلام الورى","https://www.aldiwan.net/poem43424.html","الكامل"],[105,"لمن الجموع كثيرة تتألب","https://www.aldiwan.net/poem44040.html","الكامل"],[48,"نزه صبوحك عن مقال العذل","https://www.aldiwan.net/poem64500.html","الكامل"],[106,"تحية الكويت","https://www.poetsgate.com/ViewPoem.aspx?id=179305",""],[4,"قَضِّ اللُّبانَة َ لا أبَا لكَ واذْهَبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10908&r=&rc=4",""],[144,"لا زال ملكك بالعلى مأهولا","https://www.aldiwan.net/poem11789.html","الكامل"],[161,"في كل يوم عارض لك يمطر","https://www.aldiwan.net/poem58991.html","الكامل"],[183,"رمس به من آل لطفي راحل","https://www.aldiwan.net/poem61080.html","الكامل"],[183,"أكرم بمولود لقد زار الحمى","https://www.aldiwan.net/poem61111.html","الكامل"],[183,"لخليل نحاس الأسيف مناحة","https://www.aldiwan.net/poem61125.html","الكامل"],[205,"ولقد دخلت الدير أطلب شخصه","https://www.aldiwan.net/poem53128.html","الكامل"],[223,"قالوا أدر ذكر الحبيب","https://www.aldiwan.net/poem55445.html","مجزوء الكامل"],[232,"ما بال أنفاس النسيم إذا سرت","https://www.aldiwan.net/poem44597.html","الكامل"],[232,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[321,"هذا ضريح أخي علا","https://www.aldiwan.net/poem61610.html","مجزوء الكامل"],[321,"في مطلع الأسعاد أشرق كوكب","https://www.aldiwan.net/poem67130.html","الكامل"],[323,"اليأس من طول الثواء رواح","https://www.aldiwan.net/poem56342.html","الكامل"],[378,"هذا سلام والصدور رحاب","https://www.aldiwan.net/poem66940.html","الكامل"],[403,"إن الكتابة شأنها","https://www.aldiwan.net/poem46934.html","مجزوء الكامل"],[433,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[465,"كم بين أكناف العذيب وحاجر","https://www.aldiwan.net/poem3505.html","عموديه"],[472,"ولقد دعوت طريفُ دعوة جاهلٍ","https://www.aldiwan.net/poem755.html",""],[496,"ولقد دخلت ديار فارس تاجرا","https://www.aldiwan.net/poem10226.html","الكامل"],[516,"إن السعادة قد أظل زمانها","https://www.aldiwan.net/poem12284.html","الكامل"],[552,"أطواد عزك لا ترام","https://www.aldiwan.net/poem47240.html","مجزوء الكامل"],[552,"أما الشباب فقد مضت أيامه","https://www.aldiwan.net/poem47253.html","الكامل"],[552,"نادمت طيفك ليلة الرمل","https://www.aldiwan.net/poem47275.html","أحذ الكامل"],[552,"من أين زرت خيال ذات البرقع","https://www.aldiwan.net/poem47707.html","الكامل"],[559,"كل وقت جمال وجهك بادي","https://www.aldiwan.net/poem34633.html","الخفيف"]],"verses":[["وَلَقَد دَفَنتُ هَواكُمُ","مِنّي بِمَقبَرَةِ القُلوبِ",0,"ب",1,1],["وَلَقَد دَعَوتُ نَدى الكِرامِ فَلَم يجِب","فَلَأَشكُرَنَّ نَدىً أَجابَ وَما دعي",1,"ع",2,0],["ولقد دعوتَ اللَّه مثلَ دعائهِ","عند البلاءِ فزلَّ عنك زليلا",2,"ل",2,0],["وَلَقَد دَخَلنَ عَلى شَقيقٍ بَيتَهُ","وَلَقَد رَأَينَ بِساقِ نَضرَةَ خالا",3,"ل",2,0],["ولقد دلّ أنّ مَن شيّدوه","سادة في طباعهم كُرَماء",4,"ا",2,0],["ولقد درى الرومي أن وراءه","خطراً تقاصَرُ دونه الأخطارُ",5,"ر",1,0],["وَلَقَد دَنَت لي في التَخَلُّبِ إِذ دَنَت","مِنها بِلا بَخَلٍ وَلا مَبذولِ",6,"ل",1,0],["وَلَقَد دَخَلتُ الحَيَّ يُخشى أَهلُهُ","بَعدَ الهُدوءِ وَبَعدَما سَقَطَ النَدى",7,"ا",1,1],["وَلَقد دَرى اليُونانُ أَنّا مَعشرٌ","في الرَوعِ ضرّابو الكُماةِ كِرامُ",8,"م",1,0],["ولقد دهاكمُ من دُرَيْدٍ أنّه","شَيخٌ تُساسُ به الأمورُ مُجرَّبُ",9,"ب",1,0],["وَلَقَد دَخَلتُ عَلى الكَواعِبِ حُسَّراً","فَلَقينَني بِتَبَسُّمٍ وَتَهَلُّلِ",10,"ل",1,0],["ولقد دخلتُك في الدُّجى","فأرَيْتنِي بيضَ الليالي",11,"ل",2,0],["ولقدْ دخلتُ على خميرَ بيتهُ","متنكراً في ملكِهِ كالأغلبِ",12,"ب",1,0],["وَلَقَد دَعاكَ إِلى الَّتي إِدراكُها","عَسِرٌ فَكُنتَ بِما أَرادَ كَفيلا",13,"ل",2,0],["ولقد دعوت بهم لعلمك أنهم","ألقوا بأيديهم وهم لم يشعروا",14,"ر",3,0],["وَلَقَد دَعاهُ اللَهُ نَحوَ جِوارِهِ","فَأَجابَ مُبتَدِراً وَفاتَ لَنا الجَسدْ",15,"د",1,0],["وَلَقد دَعاهُ مُؤرِّخاً داعي الهَنا","بُشراكَ فانعَم بِالخَليلِ الزائرِ",16,"ر",1,0],["وَلَقَد دَعَت جُرجَ العَزيزَ لِقُربِها","شَوقاً فَأَمسى نائِماً في حِجرها",17,"ر",3,0],["ولقد دخلتُ الدير أطلب شخصه","فرأيتُ ثمَّ أهِلَّةً وشموسا",18,"س",2,1],["ولقد دعوت وإنما","أسمعت لو ناديت حيا",19,"ي",2,0],["ولقد درت وتيقنت أن لو بغت","حصراً لبعض الفصل فيك لقصرت",20,"ت",1,0],["وَلَقَد دَنا كَالقابِ مِن قَوسَينِ أَو","أَدنى إِذا ما قُدِّرَ القَوسانِ",21,"ن",1,0],["وَلَقَد دَنا البَيت المَقدّس مِنهُ بِال","بَطحاءِ يَنعَتُهُ بِلا نِسيانِ",21,"ن",1,0],["وَلَقَد دَعاهُ رَبَّهُ","حَيثُ النَعيمُ لَهُ اِستَخارِ",22,"ر",1,0],["وَلَقَد دَعاهُ مُحَمَّداً مُتَيَمِّناً","بِاِسمِ الرَسولِ وَذاكَ أَشرَفُ مَقصَدِ",23,"د",1,0],["وَلَقَد دَعاني لِلبَطالَةِ رَبرَبٌ","هِيفٌ نَواعِمُ كَالظِباءِ صِباحُ",24,"ح",1,0],["ولقد دعاه اللَه دعوةَ منجبٍ","وسكوتُه عمن دعاه خطاب",25,"ب",1,0],["ولقَدْ دَخَلْنَا لِلصّنَاعةَِ","من قريبٍ ربِّ سلَّمْ",26,"م",1,0],["ولقد دُلِلْتُ على الكرامِ وإِنَّما","كان النَّدى والبأْسُ بعضَ أَدِلَّتي",27,"ي",1,0],["ولقد دهيت بلحظ طرفٍ فاترٍ","منها فما حرُّ الغرام بفاتر",28,"ر",1,0],["وَلَقَد دَعَوتَ طَريفُ دَعوَةَ جاهِلٍ","سَفَهاً وَأَنتَ بِمَنظَرٍ لَو تَعلَمُ",29,"م",1,1],["ولقد دخلت ديار فارس تاجراً","أبتاع ما فيها من الأعراض",30,"ض",1,1],["ولقد دفعت إلى ثلاث نوائب","كادت تشيب لهولها ولدانها",31,"ن",3,0],["ولقد درى كلّ الملو","كِ بأنّك الملك الهمامُ",32,"م",1,0],["ولقد درى من في الشبابِ حياتهُ","أنّ المشيبَ إذا علاه حِمامُهُ",33,"م",2,0],["وَلَقَد درى من لا يُخادعني","أنّي صريعُ الأعينِ النُّجْلِ",34,"ل",1,0],["وَلقد دُعيتُ فما سمعتُ ولم يكنْ","إلّا نِداؤك وحده في مَسْمعي",35,"ع",2,0],["ولقد دلني عليك محياً","لك قام الجمال فيه ينادي",36,"د",2,0]]}