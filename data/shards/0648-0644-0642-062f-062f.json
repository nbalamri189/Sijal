{"poems":[[57,"ولقد دفنت هواكم","https://www.aldiwan.net/poem26485.html","مجزوء الكامل"],[73,"لو لم يخالط يوم بينك أدمعي","https://www.aldiwan.net/poem4029.html","الكامل"],[53,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[31,"كذبتك عينك أم رأيت بواسط","https://www.aldiwan.net/poem6031.html","الكامل"],[91,"أي قدس يضم هذا البناء","https://www.aldiwan.net/poem44981.html","الخفيف"],[64,"لجلال قدرك تخضع الأقدار","https://www.aldiwan.net/poem52392.html","الكامل"],[30,"ليست ترد ديات من قد قتلت","https://www.aldiwan.net/poem5440.html","الكامل"],[33,"ولقد دخلت الحي يخشى أهله","https://www.aldiwan.net/poem42660.html","الكامل"],[107,"أنا بنو عثمان أعلام الورى","https://www.aldiwan.net/poem43424.html","الكامل"],[107,"لمن الجموع كثيرة تتألب","https://www.aldiwan.net/poem44040.html","الكامل"],[50,"نزه صبوحك عن مقال العذل","https://www.aldiwan.net/poem64500.html","الكامل"],[108,"تحية الكويت","https://www.poetsgate.com/ViewPoem.aspx?id=179305",""],[4,"قَضِّ اللُّبانَة َ لا أبَا لكَ واذْهَبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10908&r=&rc=4",""],[147,"لا زال ملكك بالعلى مأهولا","https://www.aldiwan.net/poem11789.html","الكامل"],[164,"في كل يوم عارض لك يمطر","https://www.aldiwan.net/poem58991.html","الكامل"],[186,"رمس به من آل لطفي راحل","https://www.aldiwan.net/poem61080.html","الكامل"],[186,"أكرم بمولود لقد زار الحمى","https://www.aldiwan.net/poem61111.html","الكامل"],[186,"لخليل نحاس الأسيف مناحة","https://www.aldiwan.net/poem61125.html","الكامل"],[208,"ولقد دخلت الدير أطلب شخصه","https://www.aldiwan.net/poem53128.html","الكامل"],[227,"قالوا أدر ذكر الحبيب","https://www.aldiwan.net/poem55445.html","مجزوء الكامل"],[236,"ما بال أنفاس النسيم إذا سرت","https://www.aldiwan.net/poem44597.html","الكامل"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[325,"هذا ضريح أخي علا","https://www.aldiwan.net/poem61610.html","مجزوء الكامل"],[325,"في مطلع الأسعاد أشرق كوكب","https://www.aldiwan.net/poem67130.html","الكامل"],[327,"اليأس من طول الثواء رواح","https://www.aldiwan.net/poem56342.html","الكامل"],[382,"هذا سلام والصدور رحاب","https://www.aldiwan.net/poem66940.html","الكامل"],[408,"إن الكتابة شأنها","https://www.aldiwan.net/poem46934.html","مجزوء الكامل"],[438,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[469,"كم بين أكناف العذيب وحاجر","https://www.aldiwan.net/poem3505.html","عموديه"],[476,"ولقد دعوت طريفُ دعوة جاهلٍ","https://www.aldiwan.net/poem755.html",""],[500,"ولقد دخلت ديار فارس تاجرا","https://www.aldiwan.net/poem10226.html","الكامل"],[520,"إن السعادة قد أظل زمانها","https://www.aldiwan.net/poem12284.html","الكامل"],[556,"أطواد عزك لا ترام","https://www.aldiwan.net/poem47240.html","مجزوء الكامل"],[556,"أما الشباب فقد مضت أيامه","https://www.aldiwan.net/poem47253.html","الكامل"],[556,"نادمت طيفك ليلة الرمل","https://www.aldiwan.net/poem47275.html","أحذ الكامل"],[556,"من أين زرت خيال ذات البرقع","https://www.aldiwan.net/poem47707.html","الكامل"],[563,"كل وقت جمال وجهك بادي","https://www.aldiwan.net/poem34633.html","الخفيف"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66808","الكامل"],[967,"","https://poetry.dctabudhabi.ae/diwan/poem/33097","الكامل"],[1075,"","https://poetry.dctabudhabi.ae/diwan/poem/200324","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64970","الكامل"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118130","الكامل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137868",""],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122094","الكامل"],[1476,"","https://poetry.dctabudhabi.ae/diwan/poem/72987","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79953","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80002","الكامل"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102071","الكامل"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105438","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109365","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77209","الكامل"],[2446,"","https://poetry.dctabudhabi.ae/diwan/poem/21204","الكامل"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99081","الكامل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100914","الكامل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104684","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66368","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86523","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59453","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125801","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86351","الرمل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35445","الكامل"],[4767,"مرايا الحب","https://www.poetsgate.com/ViewPoem.aspx?id=215048",""],[4984,"الأنباء","https://www.poetsgate.com/ViewPoem.aspx?id=180975",""],[5183,"بين الهيمنة والهينمة","https://www.poetsgate.com/ViewPoem.aspx?id=180155",""],[5212,"ربّانُ عشق","https://www.poetsgate.com/ViewPoem.aspx?id=212024",""],[5674,"لا ترحلي","https://www.poetsgate.com/ViewPoem.aspx?id=195124",""],[5809,"شاغل","https://www.poetsgate.com/ViewPoem.aspx?id=205938",""],[5829,"شاطئ النور","https://www.poetsgate.com/ViewPoem.aspx?id=165175",""],[6152,"أغلال الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=202348",""],[520,"إن السعادة قد اظل زمانها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577667",""],[186,"هذا الضريح لزين زين ثوى به","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55996&r=&rc=259",""],[4222,"بين أمر حلاوة العيش الشهي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52919&r=&rc=211",""]],"verses":[["وَلَقَد دَفَنتُ هَواكُمُ","مِنّي بِمَقبَرَةِ القُلوبِ",0,"ب",1,1],["وَلَقَد دَعَوتُ نَدى الكِرامِ فَلَم يجِب","فَلَأَشكُرَنَّ نَدىً أَجابَ وَما دعي",1,"ع",2,0],["ولقد دعوتَ اللَّه مثلَ دعائهِ","عند البلاءِ فزلَّ عنك زليلا",2,"ل",2,0],["وَلَقَد دَخَلنَ عَلى شَقيقٍ بَيتَهُ","وَلَقَد رَأَينَ بِساقِ نَضرَةَ خالا",3,"ل",2,0],["ولقد دلّ أنّ مَن شيّدوه","سادة في طباعهم كُرَماء",4,"ا",2,0],["ولقد درى الرومي أن وراءه","خطراً تقاصَرُ دونه الأخطارُ",5,"ر",1,0],["وَلَقَد دَنَت لي في التَخَلُّبِ إِذ دَنَت","مِنها بِلا بَخَلٍ وَلا مَبذولِ",6,"ل",1,0],["وَلَقَد دَخَلتُ الحَيَّ يُخشى أَهلُهُ","بَعدَ الهُدوءِ وَبَعدَما سَقَطَ النَدى",7,"ا",1,1],["وَلَقد دَرى اليُونانُ أَنّا مَعشرٌ","في الرَوعِ ضرّابو الكُماةِ كِرامُ",8,"م",1,0],["ولقد دهاكمُ من دُرَيْدٍ أنّه","شَيخٌ تُساسُ به الأمورُ مُجرَّبُ",9,"ب",1,0],["وَلَقَد دَخَلتُ عَلى الكَواعِبِ حُسَّراً","فَلَقينَني بِتَبَسُّمٍ وَتَهَلُّلِ",10,"ل",1,0],["ولقد دخلتُك في الدُّجى","فأرَيْتنِي بيضَ الليالي",11,"ل",2,0],["ولقدْ دخلتُ على خميرَ بيتهُ","متنكراً في ملكِهِ كالأغلبِ",12,"ب",1,0],["وَلَقَد دَعاكَ إِلى الَّتي إِدراكُها","عَسِرٌ فَكُنتَ بِما أَرادَ كَفيلا",13,"ل",2,0],["ولقد دعوت بهم لعلمك أنهم","ألقوا بأيديهم وهم لم يشعروا",14,"ر",3,0],["وَلَقَد دَعاهُ اللَهُ نَحوَ جِوارِهِ","فَأَجابَ مُبتَدِراً وَفاتَ لَنا الجَسدْ",15,"د",1,0],["وَلَقد دَعاهُ مُؤرِّخاً داعي الهَنا","بُشراكَ فانعَم بِالخَليلِ الزائرِ",16,"ر",1,0],["وَلَقَد دَعَت جُرجَ العَزيزَ لِقُربِها","شَوقاً فَأَمسى نائِماً في حِجرها",17,"ر",3,0],["ولقد دخلتُ الدير أطلب شخصه","فرأيتُ ثمَّ أهِلَّةً وشموسا",18,"س",2,1],["ولقد دعوت وإنما","أسمعت لو ناديت حيا",19,"ي",2,0],["ولقد درت وتيقنت أن لو بغت","حصراً لبعض الفصل فيك لقصرت",20,"ت",1,0],["وَلَقَد دَنا كَالقابِ مِن قَوسَينِ أَو","أَدنى إِذا ما قُدِّرَ القَوسانِ",21,"ن",1,0],["وَلَقَد دَنا البَيت المَقدّس مِنهُ بِال","بَطحاءِ يَنعَتُهُ بِلا نِسيانِ",21,"ن",1,0],["وَلَقَد دَعاهُ رَبَّهُ","حَيثُ النَعيمُ لَهُ اِستَخارِ",22,"ر",1,0],["وَلَقَد دَعاهُ مُحَمَّداً مُتَيَمِّناً","بِاِسمِ الرَسولِ وَذاكَ أَشرَفُ مَقصَدِ",23,"د",1,0],["وَلَقَد دَعاني لِلبَطالَةِ رَبرَبٌ","هِيفٌ نَواعِمُ كَالظِباءِ صِباحُ",24,"ح",1,0],["ولقد دعاه اللَه دعوةَ منجبٍ","وسكوتُه عمن دعاه خطاب",25,"ب",1,0],["ولقَدْ دَخَلْنَا لِلصّنَاعةَِ","من قريبٍ ربِّ سلَّمْ",26,"م",1,0],["ولقد دُلِلْتُ على الكرامِ وإِنَّما","كان النَّدى والبأْسُ بعضَ أَدِلَّتي",27,"ي",1,0],["ولقد دهيت بلحظ طرفٍ فاترٍ","منها فما حرُّ الغرام بفاتر",28,"ر",1,0],["وَلَقَد دَعَوتَ طَريفُ دَعوَةَ جاهِلٍ","سَفَهاً وَأَنتَ بِمَنظَرٍ لَو تَعلَمُ",29,"م",1,1],["ولقد دخلت ديار فارس تاجراً","أبتاع ما فيها من الأعراض",30,"ض",1,1],["ولقد دفعت إلى ثلاث نوائب","كادت تشيب لهولها ولدانها",31,"ن",3,0],["ولقد درى كلّ الملو","كِ بأنّك الملك الهمامُ",32,"م",1,0],["ولقد درى من في الشبابِ حياتهُ","أنّ المشيبَ إذا علاه حِمامُهُ",33,"م",2,0],["وَلَقَد درى من لا يُخادعني","أنّي صريعُ الأعينِ النُّجْلِ",34,"ل",1,0],["وَلقد دُعيتُ فما سمعتُ ولم يكنْ","إلّا نِداؤك وحده في مَسْمعي",35,"ع",2,0],["ولقد دلني عليك محياً","لك قام الجمال فيه ينادي",36,"د",2,0],["ولقد دعا العبّاسَ عند وفاتِهِ","بقَبولها فأضجّ بالإعدامِ",37,"م",1,0],["وَلَقَد دَنَوتِ وَكُنتِ غَيرَ بَخيلَةٍ","حَتّى إِذا أَطمَعتُ في الميعادِ",38,"د",1,0],["ولقد دعا حطم: النزال فبزه","بشر بن شلوة نفسه في العثير",39,"ر",1,0],["ولقد دَلَفْتَ لِفَتْحِ آمِدَ بَعْدَما","راعَ الوَرَى ما شادَ مِنْ تحصينِها",40,"ن",3,0],["ولقد دعوت الصبر حين ترحلوا","ليجيبني فدعوت غير سميعي",41,"ع",2,0],["ولقد دعاك الله نحو جلاله","فملئت نورا والثرى لك برقع",42,"ع",1,0],["وَلَقَدْ دَعَاكَ الفَتْحُ دَعْوَةَ طَائِعٍ","لِلْقَتْلِ أَوْ لإسَارِهِمْ مُتَشَوِّفِ",43,"ف",1,0],["ولقد دَفَعتُ إلى دريد طَعنَةً","نَجلاءَ تَزغلُ مثل غَطِّ المَنحَرِ",44,"ر",1,1],["ولقد دعوتُ وما دعوتُ مجيبةً","ودعَتْ بقلبي للهدى فأجابها",45,"ب",3,0],["ولقد دعوت الدينَ بعدك دعوةً","يستكُّ منها سمعُ كلِّ حقود",46,"د",1,0],["ولقد دنا كأس الحما","م وما قضيت أخي وطر",47,"ر",1,0],["ولقد دعوه للعنا فأجابهم","ودعاهم لهدى فردوا داعيه",48,"ي",2,0],["ولقد دروا أن السعادة كلها","خصت بطاعة عالم الأسرار",49,"ر",1,0],["وَلَقَد دَخَلتُ الرَوضَ يَعبِقُ رَوحُها","غَنّاءَ تَنفَحُها الصَبا وَالشَمأَلُ",50,"ل",1,0],["ولقد دخلتُ البيت يُخشى أهلهُ","بعدَ الهدُوِّ وبعدما سقطَ الندى",51,"ا",1,0],["ولقد دخلت على الصدي","ق البيت في اليوم المطير",52,"ر",1,0],["ولقد دعوتُك والزمانُ مطاردى","هل أستطيعُ من الزمان فرَارا",53,"ر",2,0],["ولقد دعوتك حين جلت كربتي","فأجب دعائي واستمع لندائي",54,"ا",2,0],["ولقد دعت شمراً تحزّ يمينه","رأس ابن فاطمة بحدّ يمان",55,"ن",1,0],["ولقد دفعنا للقضاء نفوسنا","بيد الخليفة من بني عثمان",56,"ن",1,0],["ولَقد دَعا فأجابهُ لمَّا دّعا","دمعٌ كمنصَلت الخليج المُخلجِ",57,"ج",1,0],["ولقد دعاهم للرجوع إلى الهدى","وهو الذي بالوعد ليس يمين",58,"ن",1,0],["ولقد دك به طوط العنا","إذ بدا في نوره المنبلج",59,"ج",1,0],["وَلَقَد دَعَوتُكَ حينَ جَلَّت كُربَتي","وَلَم أَلفَ غَيرَكَ كاشِفاً لِبَلائي",60,"ا",2,0],["ولقد دعَوتُكِ فاسمَعي","قلبي لقلبكِ قد دَنا",61,"ن",2,0],["ولقد دأبت على انتظار يقينكم","مما يعاد من القديم ولاحق",62,"ق",1,0],["ولقد دعاك فهبه يا وهاب ما","يدنيه منك بصبحه ومسائه",63,"ا",3,0],["وَلَقَدْ دَعَوْتَ المَوتَ حينَ دَنَوتَهُ","فَرَآكَ تَرْقَبُهُ وَأَنْتَ بَشيرُ",64,"ر",1,0],["ولقد دنوتُ لاستردَّ تبعثري","هل لي إلى وصلٍ لأحيا ثانية..!!",65,"ي",2,0],["ولقد دعوتُ بأن تبيتَ مُسَهَّداً","مثلي ويشغلَكَ الذي هو شاغلي",66,"ي",1,0],["ولقد دخلت النور في شطآنها","فتعمدت روحي بظل ضيائها",67,"ه",2,1],["ولقد دعوت الله وقت نزوله","أن لا تفرق بيننا الآجال",68,"ل",1,0],["ولقد دفعت إلى ثلاث يوائبٍ","كادت تشيب لهولها ولدانها",69,"ن",3,0],["ولقد دعاه الله نحو جواره","إذ كان ملتزماً تقاه كما اقتضى",70,"ض",2,0],["ولقد دهيت ببينكم فاشتقتكم","يا من لمشتاق ببينكم دهي",71,"ه",2,0]]}