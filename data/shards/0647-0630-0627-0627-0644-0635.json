{"poems":[[75,"هذا الصباح على سراك رقيبا","https://www.aldiwan.net/poem11919.html","الكامل"],[85,"هذا الصباح صباح الشيب قد وضحا","https://www.aldiwan.net/poem54333.html","الكامل"],[74,"وعد الفتى بلسانه","https://www.aldiwan.net/poem20188.html","مجزوء الكامل"],[64,"هذا الصغير الذي وافى على كبري","https://www.aldiwan.net/poem52419.html","البسيط"],[102,"عيد الجلوس","https://www.poetsgate.com/ViewPoem.aspx?id=50116",""],[154,"أما يمين محمد","https://www.aldiwan.net/poem68458.html","مجزوء الكامل"],[275,"كل الأزاهر في محياك","https://www.aldiwan.net/poem35663.html","أحذ الكامل"],[275,"لم أنس ليلا بالنجوم ترصعا","https://www.aldiwan.net/poem35676.html","الكامل"],[302,"أما الصبوح فإنه فرض","https://www.aldiwan.net/poem33232.html","أحذ الكامل"],[385,"هذا الصباح قد ابتسم","https://www.aldiwan.net/poem48800.html","مجزوء الكامل"],[484,"نبه لحاظك فالصباح قريب","https://www.aldiwan.net/poem36933.html","الكامل"],[484,"هذا الابى التونسي","https://www.aldiwan.net/poem36965.html","مجزوء الكامل"],[567,"هذه رسالة صب دائم القلق","https://www.aldiwan.net/poem52904.html","البسيط"],[567,"لا عين تثبت في الدنيا ولا أثر","https://www.aldiwan.net/poem52924.html","البسيط"],[572,"يا ريم كم أدنو وأنت تريم","https://www.aldiwan.net/poem69526.html","الكامل"],[659,"","https://poetry.dctabudhabi.ae/diwan/poem/76564","الكامل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101522","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77584","الرجز"],[1416,"","https://poetry.dctabudhabi.ae/diwan/poem/199211",""],[2224,"","https://poetry.dctabudhabi.ae/diwan/poem/126400","الدوبيت"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204906","الكامل"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99500","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108342",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216379","المجتث"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216374",""],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66532","الكامل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81927","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58032","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120363","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35095","الكامل"],[4755,"مأساة سُهَيل اليَمَاني ( 2 )","https://www.poetsgate.com/ViewPoem.aspx?id=210755",""],[4755,"مأساة سهيل اليماني كاملة","https://www.poetsgate.com/ViewPoem.aspx?id=211329",""],[4869,"المقفص","https://www.poetsgate.com/ViewPoem.aspx?id=151534",""],[4908,"\"طَقْطَقة\"!","https://www.poetsgate.com/ViewPoem.aspx?id=212786",""],[5038,"تيمتني","https://www.poetsgate.com/ViewPoem.aspx?id=195423",""],[5120,"لَيْلَةٌ فِي اَلْحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=179956",""],[5121,"هَذَا الصَّبَاحُ","https://www.poetsgate.com/ViewPoem.aspx?id=215123",""],[5122,"الكذب","https://www.poetsgate.com/ViewPoem.aspx?id=31517",""],[5190,"النيل يتحدث عن نفسه","https://www.poetsgate.com/ViewPoem.aspx?id=61840",""],[5199,"تضييع وقت","https://www.poetsgate.com/ViewPoem.aspx?id=146252",""],[5199,"قبيلة (بنى رشيد) عبس","https://www.poetsgate.com/ViewPoem.aspx?id=146780",""],[5274,"قهوة الصبح","https://www.poetsgate.com/ViewPoem.aspx?id=205058",""],[5277,"ومضةٌ بغدادية","https://www.poetsgate.com/ViewPoem.aspx?id=198473",""],[5431,"مريم","https://www.poetsgate.com/ViewPoem.aspx?id=207904",""],[5493,". القربان .","https://www.poetsgate.com/ViewPoem.aspx?id=197410",""],[5559,"الانتصار/زهير شيخ تراب","https://www.poetsgate.com/ViewPoem.aspx?id=152691",""],[5573,"دربي طويل وسكتي مالها زي","https://www.poetsgate.com/ViewPoem.aspx?id=201932",""],[5605,"من وحي رمضان 1436 ه","https://www.poetsgate.com/ViewPoem.aspx?id=177651",""],[5626,"أنا وأنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=189593",""],[5690,"هذا الصباح بدا أم ذا محياكِ","https://www.poetsgate.com/ViewPoem.aspx?id=172170",""],[5768,"لاحَ الصَّبَاحُ !","https://www.poetsgate.com/ViewPoem.aspx?id=215274",""],[5956,"استبشري يا زوجتي أنا قادمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=182383",""],[5956,"مهما اجتمعنا لا نطيق تباعداً","https://www.poetsgate.com/ViewPoem.aspx?id=193941",""],[5956,"مناضلٌ هاجم العدوانُ شوكتَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=194194",""],[5956,"الصديق النجْدُ","https://www.poetsgate.com/ViewPoem.aspx?id=194390",""],[5956,"ما نمتُ عن ذكرى الصديق الباهي","https://www.poetsgate.com/ViewPoem.aspx?id=194623",""],[5956,"أكمل صديق","https://www.poetsgate.com/ViewPoem.aspx?id=202393",""],[5956,"من أين تأتي الطيبة العصماءُ؟","https://www.poetsgate.com/ViewPoem.aspx?id=206925",""],[6115,"يشهد له اهل المعرفه والصحافه","https://www.poetsgate.com/ViewPoem.aspx?id=196468",""],[6213,"أرض ونجوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76296&r=&rc=44",""],[572,"ياريمُ كمْ أدنو وأنتَ ترِيمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9467&r=&rc=324",""],[572,"هذا الصَّباحُ فما الّذي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9283&r=&rc=140",""]],"verses":[["هَذا الصَباحُ عَلى سُراكِ رَقيبا","فَصِلي بِفَرعِكِ لَيلَكِ الغِربيبا",0,"ب",2,1],["هذا الصباحُ صباحُ الشيب قد وَضَحا","سَرعان ما كان ليلاً فاستنار ضُحى",1,"ح",2,1],["هذا الصغار بعينه","وبعونه وعيانه",2,"ن",2,0],["هذا الصغيرُ الذي وافَى على كِبَري","أقَرَّ عيني ولكنْ زادَ في فِكَرِي",3,"ر",2,1],["هذا الصباح الراقص المتأود","فتن مهفهفه وسحر أغيد",4,"د",1,1],["هذا الصباح الهاشم","يُّ بدا فليس به خفاء",5,"ا",2,0],["هذا الصباحُ بَدت طلائعُه","فكأنما منها ثناياكِ",6,"ك",1,0],["هذا الصبى يمضي ويتبَعُهُ الهوى","ما كانَ أطيَبَ مدة لن تَرجعا",7,"ع",2,0],["هَذا الصَباحُ بدت بشائِرُهُ","وَلخيله في ليله رَكضُ",8,"ض",1,0],["هَذا الصَباح قَد اِبتَسَم","فَأَزاحَ تَعبيس الظُلم",9,"م",1,1],["هذا الصباح شبيه فرق حبيبتي","فيلذّ فيه لفكرتي التشبيب",10,"ب",1,0],["هذا الصقيل يراعه","امضى من السيف المجرد",11,"د",1,0],["هذا الصَّديقُ الذي تَبقَى مَوَدَّتُهُ","للدَّهرِ خالصةً من شُبهةِ المَلَقِ",12,"ق",1,0],["هذا الصَّديقَ الذي كانت مَوَدَّتُهُ","كالكَوثَرِ العَذْبِ لا يَغتالُها الكَدَرُ",13,"ر",1,0],["هَذَا الصَّبَاحُ فَأَضْحِكِ الإِبْرِيْقَ عَنْ","شَمْسٍ تَحُفُّ بِهَا لَدَيَّ نُجُومُ",14,"م",1,0],["هذا الصباح فغادني بصبوح","وانهض براحك فهي راحةُ روحي",15,"ح",2,1],["هذا الصفاءُ مع النعيم تبارى","في بلدةٍ تهدي الهناءَ نثارا",16,"ر",2,1],["هَذا الصَوابُ فاِتبعوا الصَوابا","وَقامَ بَعدَ القَول ردَّ البابا",17,"ب",2,0],["هذا الصراط المستقيم فمن","يَسلكْ سِواه يَضِلُّ في السُّبْلِ",18,"ل",1,0],["هذا الصلف الزائر في معناه","قد حيَّرني فلست أدري ما هو",19,"و",1,1],["هذا الصراع هو الجهاد بعينه","لا في حروب قنابل وصوارم",20,"م",1,0],["هذا الصبوح وأنت","أنت وهذه بكر الحجالِ",21,"ل",1,0],["هذا الصديق اذا حل الجليل غدا","يرجى وعند نفادي خير مدخر",22,"ر",1,0],["هذا الصدار رقيب","على الفؤاد قريب",23,"ب",1,0],["هذا الصغير على غرارته","يدري النفاق ويحسن الأدبا",24,"ب",2,0],["هذا الصِّراطُ المُسْتَقيمُ حَقِيقَةً","مَنْ زَلَّ عَنْهُ فَفِي الجَحيمِ يُخَلَّدُ",25,"د",1,0],["هذا الصراط المستقيم لنا","هذا هو الميزان والعدل",26,"ل",1,0],["هذا الصراط قويمٌ والكتابُ به","دلالةٌ كضئيل الشمس والقمر",27,"ر",1,0],["هذا الصراط المستقيم فمن يحد","عنه يعد يوم المعاد خسيرا",28,"ر",2,0],["هذا الصَباحُ وَلا تَهُبّ إِلى مَتى","طالَ الرُقادِ وَلاتَ حينَ رقادِ",29,"د",1,0],["هذا الصُّداعُ غَريبٌ.. كيف يَحمِلُنِي","(قَوسًا).. وأَحمِلُهُ (حُوتًا) و(مِيزانا)؟!",30,"ن",2,0],["هذا الصُّداعُ غَريبٌ.. كيف يَحمِلُنِي","(قَوسًا).. وأَحمِلُهُ (ثَورًا) و(مِيزانا)؟!",31,"ن",2,0],["هذا الصحيح وعقبه اركب مقفص","اخير لك من واردٍ صنعه سبور",32,"ر",1,0],["هذا الصباحُ أتى كوجهِ حبيبتي","يغري الفؤادَ ويلهمُ الألبابا",33,"ب",2,0],["هذا الصّبا كمْ راقني صبْحُهُ","لمّا ندتْ أنْسامُهُ ميسمَكْ",34,"ك",1,0],["هَذَا اَلصِّرَاطُ إِلَى عَيْنَيْكِ أَنْكَرَنِي","وَ أَنْتِ أَنْتِ، كَأَنِّي لَمْ أَكُنْ بَشَرَا",35,"ر",2,0],["هَذَا الصَّبَاحُ مُشْرِقُ الْمَبْسَمِ","مِنْ شَمْسِ ثَغْرِي شَعَّ حَرْفِي الظَّمِي",36,"م",2,1],["هذا الصحيح اللي علي محسوبي","واراهن اللي له على القول تعقيب",37,"ب",1,0],["هَذَا الصَّلِيبُ عَلَى الأَعتَابِ حَطَّمَهُ","ولِلهِلالِ أَحَالَ الجُرمَ فَالتَصَقَا",38,"ق",2,0],["هذا الصحيح وزبدة الهرج مابيك","تضييع وقت وبيينا بالتساوى",39,"ا",3,0],["هذا الصحيح وقبل مسك الختامى","علمً موثق واسمع بعالى الحس",40,"س",1,0],["هذا الصّبَاحُ فراشَاتٌ ملونةٌ","في روعةِ البُوحِ لا صَمْتٌ ولا صَخَبُ",41,"ب",1,0],["هذا الصباحُ وهذهِ نسماتُهُ","ولأنتِ فيهِ الشعرُ والأوراقُ",42,"ق",1,0],["هذا الصراع صراع النفس محتسبٌ","عند الإله بفوزٍ شئتَه ويشا",43,"ش",2,0],["هذا الصباحُ سكونُه نسيانُ","والشمسُ في وَعْثائهَا خذلانُ",44,"ن",1,1],["هذا الصمود فلا والله ما شهدت","ساح الوغى أسداً في الحق تنكسر",45,"ر",1,0],["هذا الصحيح ومرجعه لا انتهى لي","دام الصواب يسدده جود باري",46,"ر",2,0],["هَذَا الصِّيَامُ اختِبَارُ العَامِ فِي زَمَنٍ","قَلَّ النَّجَاحُ بِهِ ، وَالحُلمُ يُفتقرُ",47,"ر",1,0],["هذا الصَّباحُ وَقَدْ بانَتْ ملامِحُهُ","والفَجْرُ خطَّ بِحبر المَجْدِ عُنْوانا",48,"ن",2,0],["هذا الصباح بدا أم ذا محياكِ","وذاك برق أم افترَّت ثناياكِ",49,"ك",1,1],["هَذَا الصَّباحُ هَدِيَّةُ الْمَوْلَى لَنَا","شُكْرًا لَهُ ؛ لِبَقَائِهِ وَنَقَائِهِ",50,"ا",3,0],["هذا الصباح فطورنا هو قبلة","وتفاهمٌ لا كِرْشةٌ ومقادمُ",51,"م",1,0],["هذا الصديق المفتدى رمز الإخا","وحَشاهُ ممتلىءٌ هُدىً وتراحما",52,"م",2,0],["هذا الصديق النجد ذو نفسيّة","أنقى من الأطفالِ مهما هاجَما",52,"م",2,0],["هذا الصلاحُ صلاحٌ مخلص أبداً","لله والشعبِ إخلاصَ المغاويرِ",53,"ر",1,0],["هذا الصلاحُ بْنُ هزاع يحررني","باْسمِ الصداقة والإخلاص من نيري",53,"ر",2,0],["هذا الصلاح بن هزاع يصادقني","في الله بغية تكريمي وتقديري",53,"ر",2,0],["هذا الصديق النجد ذو نفسيّة","أنقى من الأطفالِ يحيا راحما",54,"م",2,1],["هذا الصديقُ الشهمُ قمّةُ طيبةٍ","ودماثةٍ وحميَّةٍ ورفاهِ",55,"ه",1,0],["هذا الصلاحُ أحَبني من قلبه","ويحبُّ كلَّ الصحب حباً كامنا",56,"ن",2,0],["هذا الصديق علاءُ بدرٌ بازغٌ","يَهدي خُطاي كما الإله يشاءُ",57,"ا",2,0],["هذا الصديق علاؤنا الفدَّاءُ","يهتم بي وكأنه الأبناءُ",57,"ا",2,0],["هذا الصحيح مدقق العلم تدقيق","ماهي هروج اهل الحكا والخرافه",58,"ف",2,0],["هذا الصِّبا ولَهُ مَدَىً بحريبِ قلبِ،","أرْغَمَ التسهيدَ وجهٌ باخعُ",59,"ع",1,0],["هذا الصباحُ فأَضْحِكِ الإبريقَ عن","شمسٍ يَحِفّ بها لديَّ نُجومُ",60,"م",1,0],["هذا الصَّباحُ فما الّذي","بصبوحِ لو بك تنتَظرْ",61,"ر",1,1]]}