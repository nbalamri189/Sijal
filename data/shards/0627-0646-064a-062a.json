م صباحا","https://www.aldiwan.net/poem54093.html","الكامل"],[413,"انظر إلى الأشراف كيف تسود","https://www.aldiwan.net/poem54146.html","البسيط"],[413,"طرف يراعي النجم وهو مؤرق","https://www.aldiwan.net/poem54166.html","الكامل"],[426,"ما بالها تبدي علي دلالها","https://www.aldiwan.net/poem40047.html","الكامل"],[426,"أرج الصبابة من ثنائك عارف","https://www.aldiwan.net/poem40081.html","الكامل"],[426,"بسم السرور فسرت الأحياء","https://www.aldiwan.net/poem40833.html","الكامل"],[426,"غدر الزمان واظهر التفنيدا","https://www.aldiwan.net/poem41035.html","الكامل"],[434,"قد أعرب الدمع عن وجدي وكتماني","https://www.aldiwan.net/poem2565.html","البسيط"],[434,"يا حادياً هلا وقفت قليلا","https://www.aldiwan.net/poem2575.html","الكامل"],[434,"الحسن حيث المقلة الكحلاء","https://www.aldiwan.net/poem2578.html","الكامل"],[451,"الحب والحسن والأمان","https://www.aldiwan.net/poem61245.html","مخلع البسيط"],[451,"رف الربيع على الشتاء الماحل","https://www.aldiwan.net/poem61771.html","الكامل"],[456,"سافر بطرفك واشترف هل تعرف","https://www.aldiwan.net/poem56112.html","الكامل"],[456,"جاء بها والخير مجلوب","https://www.aldiwan.net/poem56277.html","السريع"],[498,"ما الفخر إلا للذين تواضعوا","https://www.aldiwan.net/poem38013.html","الكامل"],[512,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[535,"أنى تسدت نحونا أم يوسف","https://www.aldiwan.net/poem69412.html","الطويل"],[556,"أنت الذي طول عمري الهم تكفيني","https://www.aldiwan.net/poem33806.html","البسيط"],[560,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[565,"كلي إلى اللوم غيري ربة الكله","https://www.aldiwan.net/poem69555.html","البسيط"]],"verses":[["أَنّى تَهيبُ بِيَ البُقيا وَأَتبَعُها","فَلَم أُباقِ بِها مَن لا يُباقيني",0,"ي",1,0],["إِن يَتبَعوا عَقِبَيكَ في طَلَبِ العُلى","فَالذِئبُ يَعسُلُ في طَريقِ الضَيغَمِ",1,"م",1,0],["أَنّى تَسَرّى مِن حَقيقِ الحِمى","مَنازِلَ الحَيِّ عَلى لَعلَعِ",2,"ع",1,0],["أَنّى تُعَرِّسُ فَالرِياضُ مَطافِلٌ","لِسَوامِ إِبلِكَ وَالوُحوشُ جَآذِرُ",3,"ر",1,0],["أَنّى تَحاماهُ المَنونُ وَإِنَّما","خُلِقَت مَراعِيَ لِلرَدى خَضراؤُهُ",4,"ا",3,0],["أَنّى تَذَكَّرُ وُدُّها وَصَفاءَها","سَفَهاً وَأَنتَ بِصُوَّةِ الأَثمادِ",5,"د",1,0],["أَنّى تَخَيَّرتَ مِن لُبنانَ مَنزِلَةً","في كُلِّ مَنزِلَةٍ رَوضٌ وَعَينانِ",6,"ن",1,0],["إِنّي تَذَكَّرتُهُ وَاللَيلُ مُعتَكِرٌ","فَفي فُؤادِيَ صَدعٌ غَيرُ مَشعوبِ",7,"ب",1,0],["أَنّى تَأَوَّبَني الأَحزانُ وَالسَهَرُ","فَالعَينُ مِنّي هُدوءً دَمعُها دُرَرُ",8,"ر",1,1],["إِنّي تُذَكِّرُني صَخراً إِذا سَجَعَت","عَلى الغُصونِ هَتوفٌ ذاتُ أَطواقِ",9,"ق",1,0],["أَنَّى تَكُنْ تَلْحَقْ بِهَا لَفْظَةٌ","مُرِيبَةٌ أَوْ لَحْظَةٌ فَاجِرَهْ",10,"ر",2,0],["أَنَّى تَنَقَّلَ يَمْشِي","فِي زِينَةٍ وَغَرَابَهْ",11,"ب",2,0],["أَنَّى تَخَطَّى حُدُوداً أَنْتَ حَارِسُهَا","حَمْقَى الطَّلايِينِ لَمْ يَخْشَوا وَلَمْ يَجِمُوا",12,"م",3,0],["إني تُهَيِّجِنُي إِلَي","كِ حَمَامَتَانِ عَلى فَنَن",13,"ن",1,0],["إني تجرّدت من دنياي حاسرةً","مالي سوى طفليَ الباكي بها مال",14,"ل",1,0],["أَنّى تَحِنُّ إِلى المُوَقَّرِ بَعدَما","فَنِيَ العَرائِكُ وَالقَصائِدُ رارُ",15,"ر",1,0],["أَنّى تُكَلَّفُ بِالغُمَيِّمِ حاجَةً","نِهيا حَمامَةَ دونَها وَحَفيرُ",16,"ر",1,0],["إِنّي تُذَكِّرُني الزُبَيرَ حَمامَةٌ","تَدعو بِمَجمَعِ نَخلَتَينِ هَديلا",17,"ل",2,0],["إِن يُتلِفوا يُخلِفوا في كُلِّ مَنقَصَةٍ","ما أَتلَفوا لِاِبتِغاءِ الحَمدِ أَو عَقَروا",18,"ر",3,0],["إن يتَّزن بيت الفخار بذكره","فبنانه للمكرماتِ فعول",19,"ل",1,0],["إنّي تأمّلتُ لَهُ كُنيةً","إذا بدا مقلوبُها أعجبا",20,"ب",2,0],["إنِّي تسحّبتُ على طَوْلكم","بَدءاً فما استخشَنْتُه مَسحبا",20,"ب",2,0],["أنَّى تماطلني وأنت جَوَادُ","والشكر يُبْدأ تارةً ويُعادُ",21,"د",1,1],["أنّى تزوّجتَ على صَلْعةٍ","كأنها سِنْدانُ حدادِ",22,"د",1,0],["أنى تجشمت في الحداثة ما","جُشِّمتِ من كُره ذلك السفرِ",23,"ر",1,0],["أنَّى تكون كذا وأنت مُخَيَّرٌ","مُتَصرف في النقض والإمرارِ",24,"ر",1,0],["أنّى تَجَشَّمتِ نحو أرحلنا ال","هول ولم ترهبي أذى العسس",25,"س",1,0],["أنى تقاس شُعيلةٌ خمدت","بالشمس في الإشراق والرفعه",26,"ع",2,0],["أنى تروم يداك إحصاء الحصى","ويداه دائبتان في تضعيفه",27,"ف",2,0],["أنَّى تشاغلتَ عن أبي حَسَنِكْ","مُستفسداً ما امتننتَ من مِنَنِكْ",28,"ك",1,1],["أنَّى تزولون ونحن لم نَزُل","كيف يكونُ النقصُ أوْلى بالكُمُل",29,"ل",1,0],["أنَّى تُرادَى صخرةٌ","يُردَى بها الملِك الأجلُّ",30,"ل",1,0],["أنَّى تُجلّلُك الدجى يا بدرَها","لن تستطيع لك الدجى تجليلا",31,"ل",2,0],["أَنّى تَتيه وَقَد أَناخَ بِها","هَم وَبَعضُ الهَمِّ كَالوَقرِ",32,"ر",1,0],["إِنّي تَأَمَّلتُ الأَنامَ فَراعَني","كَيفَ الحَياةُ بِهِم تَجُدُّ وَتَهزُلُ",33,"ل",1,0],["إِنّي تَأَلَّيتُ ما يَنفَكُّ ما بَقِيَت","مِنها عَواسِرُ في الأَقرانِ أَو عُجُلُ",34,"ل",1,0],["اني تلمذت في بيتي عليك وان","ابلت عظامك ازمان وازمان",35,"ن",1,0],["إِنّي تَرَكتُ الصِبا عَمداً وَلَم أَكَدِ","مِن غَيرِ شَيبٍ وَلا عَمدٍ وَلا فَنَدِ",36,"د",1,1],["أَنّى تَنالَ بِها نَفعاً بِلا ضَرَرٍ","وَأَنَّها خُلِقَت لِلنَفعِ وَالضَرَرِ",37,"ر",1,0],["إِنّي تَرَكتُ الناسَ حينَ وَجَدتُهُ","تَركَ التَيَمُّمِ في وُجودِ الماءِ",38,"ا",2,0],["إِنّي تَأَمَّلتُ النَوى فَوَجَدتُها","سَيفاً عَلَيَّ مَعَ الهَوى مَسلولا",39,"ل",2,0],["أَنّى تُرى عاطِلاً مِن حَليِ مُكرَمَةٍ","وَكُلَّ يَومٍ تُرى في مالِكَ الغِيَرُ",40,"ر",1,0],["إني تركتُ عقودَهُمْ وفسوخَهم","وفروضَهم والحكمَ بينَ اثنينِ",41,"ن",1,1],["أَنّى تَذَكَّرَ زَينَبَ القَلبُ","وَطِلابُ وَصلِ غَريرَةٍ شَغبُ",42,"ب",1,1],["أَنّى تُطاوِلُني وَدوني بَسطَتا","جَدٍّ يُساعِدُني وَجَدٍّ يُسعِدُ",43,"د",1,1],["إن يَتبعِ النَّفَرُ الضِّعافُ سبيلَه","فَلَنحنُ أمنعُ بَيْضةً وحريما",44,"م",2,0],["إِنّي تَزوّدتُ قَبل اليَومِ داهيةً","دَهياءَ أَحملُ مِنها فَوقَ مَجهودي",45,"ي",1,0],["إنِّي تَرَكْتُ مِنَ الكلامِ نُخَالَهُ","وأَخَذْتُ منه لُبابَهُ المَنْخُولا",46,"ل",2,0],["أَنّى تُشافُ المَغاني وَهيَ أَدراسُ","كَأَنَّ باقِيَها في العَينِ أَطراسُ",47,"س",1,1],["أَنّى تَرُدُّ عَلَيَّ قَل","باً راحَ في غَلَقِ الرِهانِ",48,"ن",1,0],["أَنّى تُهَمِّمُ فِينا الناقِصاتُ وَقَد","كُنّا نُقَدِّمُ لِلظُلاّمِ أَنكالا",49,"ل",2,0],["إنيَ تاللَه خائف أن","يجتاحني حبها اجتياحا",50,"ح",2,0],["أَنَّى تَمُرُّ فَنَابِغٌ","يَصْدَى وَرَاسٍ يَنْهَدِمْ",51,"م",1,0],["إِنَّي تَرَكْتُكَ وَالسَّلاَمَةُ كُلُّهَا","فِي بُرْدَتَيْكَ وَنُورُ وَجْهِكَ سَاطِعُ",52,"ع",1,0],["إِنَّ يُتْمَ الأَوْطَانِ أَبْلَغُ مِنْ ثُكْلِ","الثَّكَالَى أَذىً وَشَرٌّ نَكِيرَا",53,"ر",2,0],["أَنَّى تَكُنْ لاَ غَروَ أنْ يُلْفَى الحِمى","وَبِهِ رَوَائِعُ مِنْ سَنىً وَسَنَاءِ",54,"ا",2,0],["أَنَّى تَجَنَّى وَلَمْ","يُوجِعْهُ أَنْ يُوجِعَك",55,"ك",1,0],["إنْ يُتْركُوا فَوْضَى يَكُنْ في دِينِهِمْ","أمراً يُضَيّقُ عنهُمُ البُلْدَانَا",56,"ن",2,0],["إني تمثَّلتُ الفضائلَ دوحة","فبدا لي الإِخلاصُ غصْنًا ذاويا",57,"ي",2,0],["إني تذكرت والذكرى مؤرقةٌ","مجدًا تليدًا بأيدينا أضعناه",58,"ا",2,0],["إني تخالفت وزهرَ الرُّبى","والكلُّ منا ذو مزاج رقيق",59,"ق",1,0],["إنّي تعشَّقتُ مِن قَبلِ المُصابِ به","بيتاً له جاء قبلَ الموتِ يَنعاه:",60,"ا",2,0],["إنّي تَرَكْتُ الصّبَا عَمداً، وَلمْ أكَدِ","مِن غَيرِ شَيبٍ وَلا عَذلٍ وَلا فَنَدِ",61,"د",1,1],["إنِّي تَأَلَّيْتُ لاَ يَنْفَكُّ مَا بَقِيتْ","منها عواسرُ في الأقرانِ أوْ عجلُ",62,"ل",1,0],["آنيتان ِ.. فتنة ُالأواني","أمْ لوحتان ِوالإطار دمعُ",63,"ع",1,0],["إني تأملتُ لَهُ كُنية ً","ولا إذا الضرس علاها نبا",64,"ب",2,0],["إني تبرأت من حولي ومن حيلي","تبرأ فيه للأحزان أفراح",65,"ح",1,0],["أَنّى تُضامُ وَلَم أَمُت","وَأَنا الشُجاعُ العِربِدُ",66,"د",1,0],["أَنّى تُمانِعُكَ الوُعولُ وَقَد رَأَت","أُسدَ الشَرى لا تَمنَعُ الآجاما",67,"م",2,0],["إني توسّلت يا رب الأنام بهم","أرجوك فضلا وغفرانا وإحسانا",68,"ن",2,0],["أنى تخونُ مودةٌ","كانت لها التقوى دعامه",69,"م",2,0],["أنّى تيسّرَ مَسرَاها وقد رسفَتْ","من الذوائبِ طولَ الليلِ في شَكَلِ",70,"ل",1,0],["أنّي توجّه هارب من ريبها","كانت له كالعقائد الأعناق",71,"ق",1,0],["إني تفكرت في حرفي على أدبي","وكل شيء له علم وتسبيب",72,"ب",1,1],["إِنّي تَغَدّيت صَدرَ يَومي","ثُمَّ تَأَذّيتُ بِالغَداءِ",73,"ا",2,1],["أنَّى تطاولَ من طا","لَ إنْ خُلِقْتَ قصيرا",74,"ر",2,0],["إني تمسَّكتُ بالبقيا عليك إلى","أن كدتُ أحرم طرفي لذَّةَ النظَرِ",75,"ر",1,0],["إني تعاطيتُ صبراً تحته حرجٌ","فصرتُ في حال مجهودٍ ومجتهدِ",76,"د",1,0],["إنى تحدّيتُه حيّا فآمن بي","أين الذي بمعانيه تحداني",77,"ي",1,0],["إني تركتك لاختيارِك والهوى","يَقْضِي عليك بأن تُذمَّ وتُتْرَكا",78,"ك",2,1],["أنى تصدق في أموالهم نفراً","والله يشهد فيهم أنهم كذبوا",79,"ب",3,0],["أنَّى تَضيرُ شِكايةٌ مِنْ جودِهِ","وَوُجودُهُ لِلخَلْقِ طُرّاً نافِعُ",80,"ع",1,0],["إني تَوسّلتُ بالمختارِ ملجئنا","الطاهرِ المجتبى من خيرةِ الأممِ",81,"م",1,0],["أنىّ تسكعتِ الإسلامُ في ظُلَمٍ","وَكان دينُهمُ نوراً وما برحا",82,"ح",2,0],["أنّى تطيقُ العينُ هجرَ سوادها","وَالروضُ هجر عهادهِ المتسجّمِ",83,"م",1,0],["أنى تفي الأقوال منك بمدحة","ومتى تقوم بوصفك الشعراءُ",84,"ا",2,0],["اِني تَوسلت بما فيكَ مِن","عِز وَمَجد شامِخ وَاِحتِشام",85,"م",1,0],["إنَّي تذكرَّتُ للأيَّام ما كانا","فصدَّني ما تصدَّت لي به الآنا",86,"ن",2,1],["أنى تشين كلامَ اللَه معتقداً","خلافَه ذاك خُلفٌ فيه يُتْجنَّى",87,"ن",2,0],["أنَّى تعيِّرنا وأنت معيَّرٌ","يا راقصاً في ظُلمة الأحلام",88,"م",1,0],["أنَّى توجَّهتُ امتثلتُ حِيالَها","ناهيكَ من نارٍ بقلبي تُحدِق",89,"ق",1,0],["أنَّى تروم الصفو من أكداره","وبنوه قد طبعوا على الأكدار",90,"ر",1,0],["أنَّى تحولت لا أنفكُّ مُلتفتاً","تِلْقا محياك حتى يهتدي النظر",91,"ر",1,0],["أنَّى تُفيدُ غزارةُ العلم الفتى","وفؤادُهُ عن حلمِهِ ، محجوبُ ؟!",92,"ب",1,0],["أن يترك الأمر العظيم لأهله","متسربلاً ثوبي هدى وعفاف",93,"ف",1,0],["أَنّى تُريدُ تَرَحُّلاً عَن أَرضِنا","نَفديك بالأَبَوَينِ وَالأَخَوَينِ",94,"ن",1,0],["أَنّى تَروم الروم حَربُكَ بَعدَما","صَلِيَت بِحَربِكَ محرباً مِلحاحا",95,"ح",2,0],["أنَّى تصيَّدني الغزالُ فريسةً","عَهدي الغزال فريسة الضرغام",96,"م",1,0],["أنَّى تفوزُ بما تُحاولُ همَّتي","والدَّهر مُلْتَفِتٌ إلى أنذاله",97,"ل",2,0],["أنَّى تطيب لي الحياة ولا أرى","صحبي لديَّ وأُسرتي ورفاقي",98,"ي",1,0],["أنَّى تحقّر بالفهاهة سيِّداً","من حقّه التعظيم والتمجيد",99,"د",1,0],["أنَّى تغيَّرت البلاد وأهلها","وأتى عليها الدهر وهو مفرق",100,"ق",1,0],["أنى تعارض من تملك حسنها","وجنى مباسمها وقبل خالها",101,"ل",3,0],["أنى ترى حسناً وكل مؤدبٍ","من روض فضلك غارفٌ أو قاطفُ",102,"ف",1,0],["أنّي تحَدُّ هبات راحتك التي","حجت لقبلة كفها الأنواءُ",103,"ا",2,0],["أنّى تودُّ من الحتوف سلامةً","هل أن ترى بالما لظىً موقودا",104,"د",2,0],["أنّى تقاس بقسّ إذ سحبت علا","ذيل الفخار على قسن وسحبان",105,"ن",1,0],["أنّى تروم من القواني ذمَةً","أم كيف تثأر عندهُنّ قتيلا",106,"ل",2,0],["أنّى تنوشدَ نظمها في مجلس","فيخال فيه مندل وكباء",107,"ا",2,0],["أنى تلفّت لم أجدني","إلا رؤى فاتها الحسان",108,"ن",1,0],["أنَّى ترحَّل أو أقام فَحوله","زُمَرٌ تَحَّدثُ عن نهىً وشمائلِ",109,"ل",1,0],["أنى تصرَّم قلبُها لك بعد ما","كانت تُراعُ بظلّها وتخوَّفُ",110,"ف",1,0],["أنَّى تسدَّيتَ لنا باللِّوى","وصارةٌ دارك فاللُّوبُ",111,"ب",1,0],["أنَّيْتُ عن لَهْفٍ فَقالَ عُوَيْذِلي","رِفقاً فقد أزْعَجْتَني يا جاري",112,"ي",1,0],["أنّى تُجارى في الكمال وإنّما","لُقمانُ في المِضمارِ خلفَك أعرَجُ",113,"ج",1,0],["أنَّى تَسَدَّت نحوَنا أُمُّ يُوسفٍ","ومِن دُونِ مَسراها فَيافٍ مجاهلٌ",114,"ل",1,1],["إني توسلت في الدنيا إليك بمن","جعلته سبباً في كل تدوين",115,"ن",1,0],["إنّي تَجاهَلتُ في دُنيايَ مَعرفةً","هل كانَ في أهلها مَسٌّ من اللَمَمِ",116,"م",1,0],["إِنِّي تَوَهَّمْتُ إِقْصَارِي وَمُنْحَرَفِي","بِالْوُدِّ عَنْكِ وَأَنْتِ الغَادَهُ الطِّفْلَهْ",117,"ل",2,0]]}