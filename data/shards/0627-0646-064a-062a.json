نَّما","خُلِقَت مَراعِيَ لِلرَدى خَضراؤُهُ",4,"ا",3,0],["أَنّى تَذَكَّرُ وُدُّها وَصَفاءَها","سَفَهاً وَأَنتَ بِصُوَّةِ الأَثمادِ",5,"د",1,0],["أَنّى تَخَيَّرتَ مِن لُبنانَ مَنزِلَةً","في كُلِّ مَنزِلَةٍ رَوضٌ وَعَينانِ",6,"ن",1,0],["إِنّي تَذَكَّرتُهُ وَاللَيلُ مُعتَكِرٌ","فَفي فُؤادِيَ صَدعٌ غَيرُ مَشعوبِ",7,"ب",1,0],["أَنّى تَأَوَّبَني الأَحزانُ وَالسَهَرُ","فَالعَينُ مِنّي هُدوءً دَمعُها دُرَرُ",8,"ر",1,1],["إِنّي تُذَكِّرُني صَخراً إِذا سَجَعَت","عَلى الغُصونِ هَتوفٌ ذاتُ أَطواقِ",9,"ق",1,0],["أَنَّى تَكُنْ تَلْحَقْ بِهَا لَفْظَةٌ","مُرِيبَةٌ أَوْ لَحْظَةٌ فَاجِرَهْ",10,"ر",2,0],["أَنَّى تَنَقَّلَ يَمْشِي","فِي زِينَةٍ وَغَرَابَهْ",11,"ب",2,0],["أَنَّى تَخَطَّى حُدُوداً أَنْتَ حَارِسُهَا","حَمْقَى الطَّلايِينِ لَمْ يَخْشَوا وَلَمْ يَجِمُوا",12,"م",3,0],["إني تُهَيِّجِنُي إِلَي","كِ حَمَامَتَانِ عَلى فَنَن",13,"ن",1,0],["إني تجرّدت من دنياي حاسرةً","مالي سوى طفليَ الباكي بها مال",14,"ل",1,0],["أَنّى تَحِنُّ إِلى المُوَقَّرِ بَعدَما","فَنِيَ العَرائِكُ وَالقَصائِدُ رارُ",15,"ر",1,0],["أَنّى تُكَلَّفُ بِالغُمَيِّمِ حاجَةً","نِهيا حَمامَةَ دونَها وَحَفيرُ",16,"ر",1,0],["إِنّي تُذَكِّرُني الزُبَيرَ حَمامَةٌ","تَدعو بِمَجمَعِ نَخلَتَينِ هَديلا",17,"ل",2,0],["إِن يُتلِفوا يُخلِفوا في كُلِّ مَنقَصَةٍ","ما أَتلَفوا لِاِبتِغاءِ الحَمدِ أَو عَقَروا",18,"ر",3,0],["إن يتَّزن بيت الفخار بذكره","فبنانه للمكرماتِ فعول",19,"ل",1,0],["إنّي تأمّلتُ لَهُ كُنيةً","إذا بدا مقلوبُها أعجبا",20,"ب",2,0],["إنِّي تسحّبتُ على طَوْلكم","بَدءاً فما استخشَنْتُه مَسحبا",20,"ب",2,0],["أنَّى تماطلني وأنت جَوَادُ","والشكر يُبْدأ تارةً ويُعادُ",21,"د",1,1],["أنّى تزوّجتَ على صَلْعةٍ","كأنها سِنْدانُ حدادِ",22,"د",1,0],["أنى تجشمت في الحداثة ما","جُشِّمتِ من كُره ذلك السفرِ",23,"ر",1,0],["أنَّى تكون كذا وأنت مُخَيَّرٌ","مُتَصرف في النقض والإمرارِ",24,"ر",1,0],["أنّى تَجَشَّمتِ نحو أرحلنا ال","هول ولم ترهبي أذى العسس",25,"س",1,0],["أنى تقاس شُعيلةٌ خمدت","بالشمس في الإشراق والرفعه",26,"ع",2,0],["أنى تروم يداك إحصاء الحصى","ويداه دائبتان في تضعيفه",27,"ف",2,0],["أنَّى تشاغلتَ عن أبي حَسَنِكْ","مُستفسداً ما امتننتَ من مِنَنِكْ",28,"ك",1,1],["أنَّى تزولون ونحن لم نَزُل","كيف يكونُ النقصُ أوْلى بالكُمُل",29,"ل",1,0],["أنَّى تُرادَى صخرةٌ","يُردَى بها الملِك الأجلُّ",30,"ل",1,0],["أنَّى تُجلّلُك الدجى يا بدرَها","لن تستطيع لك الدجى تجليلا",31,"ل",2,0],["أَنّى تَتيه وَقَد أَناخَ بِها","هَم وَبَعضُ الهَمِّ كَالوَقرِ",32,"ر",1,0],["إِنّي تَأَمَّلتُ الأَنامَ فَراعَني","كَيفَ الحَياةُ بِهِم تَجُدُّ وَتَهزُلُ",33,"ل",1,0],["إِنّي تَأَلَّيتُ ما يَنفَكُّ ما بَقِيَت","مِنها عَواسِرُ في الأَقرانِ أَو عُجُلُ",34,"ل",1,0],["اني تلمذت في بيتي عليك وان","ابلت عظامك ازمان وازمان",35,"ن",1,0],["إِنّي تَرَكتُ الصِبا عَمداً وَلَم أَكَدِ","مِن غَيرِ شَيبٍ وَلا عَمدٍ وَلا فَنَدِ",36,"د",1,1],["أَنّى تَنالَ بِها نَفعاً بِلا ضَرَرٍ","وَأَنَّها خُلِقَت لِلنَفعِ وَالضَرَرِ",37,"ر",1,0],["إِنّي تَرَكتُ الناسَ حينَ وَجَدتُهُ","تَركَ التَيَمُّمِ في وُجودِ الماءِ",38,"ا",2,0],["إِنّي تَأَمَّلتُ النَوى فَوَجَدتُها","سَيفاً عَلَيَّ مَعَ الهَوى مَسلولا",39,"ل",2,0],["أَنّى تُرى عاطِلاً مِن حَليِ مُكرَمَةٍ","وَكُلَّ يَومٍ تُرى في مالِكَ الغِيَرُ",40,"ر",1,0],["إني تركتُ عقودَهُمْ وفسوخَهم","وفروضَهم والحكمَ بينَ اثنينِ",41,"ن",1,1],["أَنّى تَذَكَّرَ زَينَبَ القَلبُ","وَطِلابُ وَصلِ غَريرَةٍ شَغبُ",42,"ب",1,1],["أَنّى تُطاوِلُني وَدوني بَسطَتا","جَدٍّ يُساعِدُني وَجَدٍّ يُسعِدُ",43,"د",1,1],["إن يَتبعِ النَّفَرُ الضِّعافُ سبيلَه","فَلَنحنُ أمنعُ بَيْضةً وحريما",44,"م",2,0],["إِنّي تَزوّدتُ قَبل اليَومِ داهيةً","دَهياءَ أَحملُ مِنها فَوقَ مَجهودي",45,"د",2,0],["إنِّي تَرَكْتُ مِنَ الكلامِ نُخَالَهُ","وأَخَذْتُ منه لُبابَهُ المَنْخُولا",46,"ل",2,0],["أَنّى تُشافُ المَغاني وَهيَ أَدراسُ","كَأَنَّ باقِيَها في العَينِ أَطراسُ",47,"س",1,1],["أَنّى تَرُدُّ عَلَيَّ قَل","باً راحَ في غَلَقِ الرِهانِ",48,"ن",1,0],["أَنّى تُهَمِّمُ فِينا الناقِصاتُ وَقَد","كُنّا نُقَدِّمُ لِلظُلاّمِ أَنكالا",49,"ل",2,0],["أني تذكرت والذكرى مؤرقة","مجداً تليدا بأيدينا أضعناه",50,"ا",2,0],["إنيَ تاللَه خائف أن","يجتاحني حبها اجتياحا",51,"ح",2,0],["أَنَّى تَمُرُّ فَنَابِغٌ","يَصْدَى وَرَاسٍ يَنْهَدِمْ",52,"م",1,0],["إِنَّي تَرَكْتُكَ وَالسَّلاَمَةُ كُلُّهَا","فِي بُرْدَتَيْكَ وَنُورُ وَجْهِكَ سَاطِعُ",53,"ع",1,0],["إِنَّ يُتْمَ الأَوْطَانِ أَبْلَغُ مِنْ ثُكْلِ","الثَّكَالَى أَذىً وَشَرٌّ نَكِيرَا",54,"ر",2,0],["أَنَّى تَكُنْ لاَ غَروَ أنْ يُلْفَى الحِمى","وَبِهِ رَوَائِعُ مِنْ سَنىً وَسَنَاءِ",55,"ا",2,0],["أَنَّى تَجَنَّى وَلَمْ","يُوجِعْهُ أَنْ يُوجِعَك",56,"ك",1,0],["إنْ يُتْركُوا فَوْضَى يَكُنْ في دِينِهِمْ","أمراً يُضَيّقُ عنهُمُ البُلْدَانَا",57,"ن",2,0],["إني تمثَّلتُ الفضائلَ دوحة","فبدا لي الإِخلاصُ غصْنًا ذاويا",58,"ي",2,0],["إني تخالفت وزهرَ الرُّبى","والكلُّ منا ذو مزاج رقيق",59,"ق",1,0],["إنّي تعشَّقتُ مِن قَبلِ المُصابِ به","بيتاً له جاء قبلَ الموتِ يَنعاه:",60,"ا",2,0],["إنّي تَرَكْتُ الصّبَا عَمداً، وَلمْ أكَدِ","مِن غَيرِ شَيبٍ وَلا عَذلٍ وَلا فَنَدِ",61,"د",1,1],["إنِّي تَأَلَّيْتُ لاَ يَنْفَكُّ مَا بَقِيتْ","منها عواسرُ في الأقرانِ أوْ عجلُ",62,"ل",1,0],["آنيتان ِ.. فتنة ُالأواني","أمْ لوحتان ِوالإطار دمعُ",63,"ع",1,0],["إني تأملتُ لَهُ كُنية ً","ولا إذا الضرس علاها نبا",64,"ب",2,0],["إني تبرأت من حولي ومن حيلي","تبرأ فيه للأحزان أفراح",65,"ح",1,0],["أَنّى تُضامُ وَلَم أَمُت","وَأَنا الشُجاعُ العِربِدُ",66,"د",1,0],["أَنّى تُمانِعُكَ الوُعولُ وَقَد رَأَت","أُسدَ الشَرى لا تَمنَعُ الآجاما",67,"م",2,0],["إني توسّلت يا رب الأنام بهم","أرجوك فضلا وغفرانا وإحسانا",68,"ن",2,0],["أنى تخونُ مودةٌ","كانت لها التقوى دعامه",69,"م",2,0],["أنّى تيسّرَ مَسرَاها وقد رسفَتْ","من الذوائبِ طولَ الليلِ في شَكَلِ",70,"ل",1,0],["أنّي توجّه هارب من ريبها","كانت له كالعقائد الأعناق",71,"ق",1,0],["إني تفكرت في حرفي على أدبي","وكل شيء له علم وتسبيب",72,"ب",1,1],["إِنّي تَغَدّيت صَدرَ يَومي","ثُمَّ تَأَذّيتُ بِالغَداءِ",73,"ا",2,1],["أنَّى تطاولَ من طا","لَ إنْ خُلِقْتَ قصيرا",74,"ر",2,0],["إني تمسَّكتُ بالبقيا عليك إلى","أن كدتُ أحرم طرفي لذَّةَ النظَرِ",75,"ر",1,0],["إني تعاطيتُ صبراً تحته حرجٌ","فصرتُ في حال مجهودٍ ومجتهدِ",76,"د",1,0],["إنى تحدّيتُه حيّا فآمن بي","أين الذي بمعانيه تحداني",77,"ن",2,0],["إني تركتك لاختيارِك والهوى","يَقْضِي عليك بأن تُذمَّ وتُتْرَكا",78,"ك",2,1],["أنى تصدق في