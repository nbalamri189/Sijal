.ae/diwan/poem/54714","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141956","الخفيف"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9510","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54288","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54244","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54196","الكامل"],[36,"كم هاتف بك من باك وباكية","https://www.poetsgate.com/ViewPoem.aspx?id=15866",""],[106,"أدب الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=179476",""],[106,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[106,"في مهرجان الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179637",""],[77,"النصر نصك والحسام دليله","https://www.poetsgate.com/ViewPoem.aspx?id=34198",""],[77,"سيدي أنت عمدتي فاحتَملْني","https://www.poetsgate.com/ViewPoem.aspx?id=33312",""],[77,"تألق نجديا فأذكرني نجدا","https://www.poetsgate.com/ViewPoem.aspx?id=33939",""],[100,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=50099",""],[90,"الى السعدون..","https://www.poetsgate.com/ViewPoem.aspx?id=179037",""],[90,"في طهران","https://www.poetsgate.com/ViewPoem.aspx?id=179053",""],[90,"بريد الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=179052",""],[90,"حالنا أو في سبيل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179149",""],[45,"أصَبَا الأصَائِلِ إنّ بُرْقَةَ مُنْشِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=32956",""],[45,"أَصُدُودٌ غَلاَ بِهَا أَمْ دَلاَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32056",""],[45,"أتَرَاهُ يَظُنُّني، أوْ يَرَانِي","https://www.poetsgate.com/ViewPoem.aspx?id=32077",""],[80,"غَيَّرَتْهُ غِيَرُ الدَّهْرِ فشابْ","https://www.poetsgate.com/ViewPoem.aspx?id=3021",""],[91,"فتنة 13 أبريل","https://www.poetsgate.com/ViewPoem.aspx?id=53245",""],[91,"فلسفة الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=53232",""],[51,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""],[101,"بَسَمَتْ تتيهُ مُدلّة ً بصباحها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62458&r=&rc=50",""],[31,"ما شَجَاكَ الغَدَاة َ مِنْ رَسْمِ دَارِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18869&r=&rc=132",""],[91,"فلسفة الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67913&r=&rc=193",""],[92,"لَسْتُ أبْكي لِعَسْفِ لَيْلٍ طَويلٍ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14563&r=&rc=9",""]],"verses":[["وَتَوَّجوا بِمَجدِهِم مَفرَقَها","عَن عَطَلٍ وَسَوَّروا ذِراعَها",0,"ع",3,0],["وَتوردُني وَالشَّمسُ ذابَ لُعابُها","وَقائِعَ تَحكيها مُتونُ الصَّفائِحِ",1,"ح",1,0],["وَتوهِي مَريراتِ العهودِ خِيانَةً","لِمُصفي الهَوى راعي المَوَدَّةِ وَالعَهدِ",2,"د",1,0],["وتودِعُ الدّهْرَ منْ شِعْرٍ أحَبِّرُهُ","مَدائِحاً لم تُوَشَّحْ بالأكاذيبِ",3,"ب",1,0],["وتُولِغُ في اللّبّاتِ بِيضاً فَتَنْثَني","مِنَ الدّمِ حُمْراً تَلْتَظي شَفَراتُها",4,"ت",3,0],["وتوغِلُ في البَيْداءِ حتى كأنّها","خَيالٌ أُناجيهِ خِلالَ الغَياهِبِ",5,"ب",1,0],["وتُومي إلَينا بالبَنانِ وقد أبَتْ","مَحاجِرُها أنْ لا يُخَضَّبَ بالدَّمِ",6,"م",1,0],["وَتُوجِفُ مَنِ فَصْلِ الْخِطَابِ لِغَايَةٍ","أَنَافَتْ وَجَلَّتْ أَنْ يُحِيطَ بِهَا وَهْمُ",7,"م",1,0],["وَتَوَشَّجَتْ أَغْصَانُ دَوْحَةِ خَزْرَجٍ","ذِمَماً وَحِيزَ لِكُلِّ مَجْدٍ سُولُهُ",8,"ل",2,0],["وتولّى عنْها فكانَ له الفتْ","حُ وطارَتْ في إثْرِهِ الأخْبارُ",9,"ر",1,0],["وتوّجَ منْ نُوّارِها قُنَنَ الرُّبى","وختّمَ منْ أزْهارِها القُضُبَ المُلْدا",10,"د",2,0],["وَتَوَخَّنِي بِالْعُذْرِ إِنَّ قَرِيحَتِي","كَالضَّرْعِ جَفَّ وَشَحَّ مِمَّا يُحْلَبُ",11,"ب",1,0],["وَتَوَلَّوْا عَلَى انْفِرَادٍ يَبُثُّو","نَ وَقَدْ أُسْعِفُوا حَمِيدَ الثَّنَاءِ",12,"ا",2,0],["وَتُوَلّي الأَرضَ خُفّاً مُجمَراً","فَإِذا ما صادَفَ المَروَ رَضَح",13,"ح",1,0],["وَتوصَلَ أَرحامٌ وَيُفَرَجَ مُغرَمٌ","وَتَرجِعَ بِالوُدِّ القَديمِ الرَواجِعُ",14,"ع",1,0],["وَتَواصَوا بِالصَبرِ فَالصَبرُ إِن فا","رَقَ قَوماً فَما لَهُ مِن مَسَدِّ",15,"د",1,0],["وَتَوَلَّت حِراسَةَ المَوكِبِ الأَس","نى نُجومُ السَماءِ وَالنَيِّرانِ",16,"ن",1,0],["وَتَواثَبنا إِلى مَشمولَةٍ","ذاتِ أَلوانٍ تَسُرُّ الناظِرين",17,"ن",1,0],["وَتَوَدُّ أَفئِدَةٌ هَتَكتَ شَغافَها","لَو أَنَّها بِذُيولِها تَتَعَلَّقُ",18,"ق",1,0],["وَتَوَسَّموهُم في القُيودِ فَقائِلٌ","هَذا فُلانٌ قَد وَشى بِفُلانِ",19,"ن",1,0],["وَتَوَهَّموكَ جَنَيتَ ذَنباً","بِالتَجَنّي لَيسَ يُغفَر",20,"ر",1,0],["وَتَوالي أَذِمَّةٍ نَظَمَتنا","نَظمَ عِقدِ الجُمانِ في نَحرِ بِكرِ",21,"ر",1,0],["وَتومِضُ أَحياناً بِعَينٍ مَريضَةٍ","وَتَبسِمُ عَن مِثلِ الجُمانِ المُنَظَّمِ",22,"م",1,0],["وَتُؤبَنُ مِن نَصِّ الهَواجِرِ وَالضُحى","بِقِدحَينِ فازا مِن قِداحِ المُقَعقِعِ",23,"ع",1,0],["وَتَوَخَّ الرَّأْيَ السَّدِيدَ عَلَى مَا","دُونَ تَسْدِيدِهِ الضْمِيرُ يُعَانِي",24,"ن",2,0],["وَتُوقِّيهِمُ الرَّدَى وَتُرِيهِمْ","مُعْجِزَاتِ الإِنْقَاذِ كَيْفَ تَكُونُ",25,"ن",1,0],["وَتُوسِعُ الضُّعَفَاءِ البّائِسِينَ جَدًى","بِأَرْيَحِيَّةِ سَمْحٍ غَيْرِ مَنَّانِ",26,"ن",1,0],["وَتُؤْمُّ العِرَاقَ فَأَظْفِرْ بِأَسْنَى","مَا يُلاقِي بِهِ الكَرِيمَ الكِرَامُ",27,"م",1,0],["وَتُوقِعُ حُكْمَكَ عَنْ حِكْمَةٍ","فَمَا مِنْ هَضِيمٍ وَلا هَاضِمِ",28,"م",1,0],["وَتودِعُ في الضَميرِ هَوىً وَوُدّاً","وَتَكسوهُم إِذا حَضَروا جَمالا",29,"ل",2,0],["وَتُوقِدُ حِيناً بِاليَلَنجُوجِ نَارَها","وَتُوقِدُ أَحيَاناً بِمِسكِ وَمَندَلِ",30,"ل",1,0],["وتوهمني الشمسَ المنيرة غُرَّةٌ","بوجهك صان اللهُ وجهك عن رَدِّ",31,"د",1,0],["وتوقّدت عند الهجيرة شمسه","فتلمّظت بلعابها الصحراء",32,"ا",2,0],["وتواري عن أعيني مضمحلاً","شرف في مواطني وضّاح",33,"ح",1,0],["وَتوقِدُ نارَ مَكرُمَةٍ وَأُخرى","إِذا ما المَحلُ أَخمَدَ كُلَّ نارِ",34,"ر",1,0],["وَتَوَجَّسَت رِزَّ الأَنيسِ فَراعَها","عَن ظَهرِ غَيبٍ وَالأَنيسُ سَقامُها",35,"م",3,0],["وَتَواعَدوا وِردَ القُرَيَّةِ غُدوَةً","وَحَلَفتُ بِاللَهِ العَزيزِ لَنُحبَسُ",36,"س",1,0],["وَتَوكَافُ الدُّمُوعِ على اكتِئَابٍ","أَحَلَّ الدَّهرُ مَوُجِعَهُ الضُّلُوعَا",37,"ع",2,0],["وتو كاف الدموع على اكتساب","أحلّ الله موجعة الضلوعا",38,"ع",2,1],["وَتَوَلَّينَ حينَ أَبصَرنَ شَخصاً","مُدمَجاً مَتنُهُ كَمَتنِ المِقاطِ",39,"ط",1,0],["وتوسَّلت بك مدحةٌ سيارةٌ","سيرَ النجوم من ابتداءِ المطلع",40,"ع",1,0],["وتواضع كالشمس دانٍ ضوءها","والقدر أرفع أن ينال ويكرم",41,"م",1,0],["وتواضع كالشمس دانٍ ضوءها","والقدر أرفع رتبةً ومراما",42,"م",2,0],["وَتَوحيدُكَ تَوحيدي","وَعِصيانُكَ عِصياني",43,"ن",2,0],["وتوزَنُ بالأموال آمالُ وفدِهِ","وإرفادُ قومٍ بالظنون الكواذبِ",44,"ب",1,0],["وتَوقَّ ذمَّك إنَّ ما خُوِّلتَهُ","كطلوع شمسٍ حان منهُ غروبُ",45,"ب",1,0],["وتَوَهَّمْه شافعاً فيَّ مكْرو","ثاً لضيق أصبحتُ فيه شديدِ",46,"د",1,0],["وتولّاها بعقلٍ راجحٍ","مثله قُلِّد إصلاحَ البلادِ",47,"د",1,0],["وتوكَّدْ على أبي الحسن المحْ","سِن في أن يكون في الخير نجدا",48,"د",2,0],["وتوقعوا فجآتِهم","كتوقُّع الوحش النوافر",49,"ر",1,0],["وتولَّى وزارتين فأضحى ال","حقُّ غضبانَ ظاهر التعبيس",50,"س",1,0],["وتوهّمتَ ذا وذاكَ شهابيْ","نِ بليلٍ تتابعا في انقضاض",51,"ض",1,0],["وتوجهت في الخفاء إلى الشط","ط ففي مثله لمثلي قناعه",52,"ع",2,0],["وتولَّى الشبابُ فازدَدْتُ ركضاً","في ميادينِ باطِلي إذ تولّى",53,"ل",2,0],["وتوقَّيتُ أن يقال غبينٌ","ومن النكر حازمٌ مغبون",54,"ن",1,0],["وتؤمُّ مقحمةُ السنين فناءه","فتُنيخ منه بواسعِ الأعطانِ",55,"ن",1,0],["وَتَوَهَّمَ القَمَرَ المُحَلِّقَ وَجهَ مَن","ضَنَّت وَجادَت بِاللِقاءِ وَبِالنَوى",56,"ا",1,0],["وَتَوالى هُجومُهُم وَالمَنايا","ضاحِكاتٌ فَيا لَها مِن صُيودِ",57,"د",1,0],["وَتَوَقَّفَت فَشَعَرتُ بَعدَ حَديثِها","أَنَّ الوُجودَ مُشَوَّشٌ مَبتورُ",58,"ر",1,0],["وَتَوارى عَنّي وَاِحتَجَبا","كَالمَوجَةِ في عَرضِ النَهرِ",59,"ر",1,0],["وَتَوَقَّع إِذا السَماءُ اِكفَهَرَّت","مَطَراً في السُهولِ يُحيِ السُهولا",60,"ل",2,0],["وَتَوَلَّ المُلكَ مِن أُمَمٍ","وَبِحَبلِ اللَهِ فَاِعتَصِمِ",61,"م",1,0],["وَتَوَهَمتُ الأَسى لَم يَجِدا","سَكَناً في غَيرِ قَلبي المُثخَنِ",62,"ن",1,0],["وَتَوالَتِ الأَجيالُ تَطَّرِدُ","جيلٌ يَغيبُ وَآخَرٌ يَفِدُ",63,"د",1,0],["وَتَوَهَّمتُ أَنَّني سَوفَ أَلقى","أَلفَ لَيلى وَطَلفَ هِندٍ سِواها",64,"ا",3,0],["وَتَوَدُّ لَو يَبقى عَلَيكَ نَعيمُها","أَجَهِلتَ أَنَّ عَلَيكَ رَدَّ الغانِيَه",65,"ي",2,0],["وَتَوَدُّ كُلُّ سَحابَةٍ مَرَّت بِهِ","لَو أَنَّهُ سُحُبٌ عَلَيها هامِيَه",65,"ي",2,0],["وَتَوَهَّمتُ أَنَّهُ","رَدَّ لي رَيِّقَ الصِبا",66,"ب",2,0],["وَتَوَخَّوْا طَرائِقَ العَسْفِ والإِرْ","هَاقِ تَوًّا وَمَا تَوَخَّوْا سَمَاحَهْ",67,"ح",2,0],["وتوارى الوُجُودُ عنَّا بما في","هِ وغبنا في عالمٍ مفتونِ",68,"ن",1,0],["وتوحي لهم نَظَرَاتُ الصَّبايا","أَناشيدَ عهدِ الشَّبابِ الرَّطيبْ",69,"ب",1,0],["وَتوراةٌ مُحَرَّقَةٌ أَعَزَّت","فَطالَت ذُلَّةُ السَبعِ المَثاني",70,"ي",1,0],["وتوسع الملك الذي اسطاعوا له","فتحا مبينا زاد في عمرانه",71,"ن",2,0],["وتوازنت أجرامها","فالكل مجذوب وجاذب",72,"ب",1,0],["وتودّ لو ردّت عليك سرابها","وهجيرها وزئيرها وعواءها",73,"ا",3,0],["وتوّج النبت رؤوس الربى","ومزقت شمس النهار النقاب",74,"ب",1,0],["وتوشك تجعله ديدنا","وتدعو الفضالي إليه فضولا",75,"ل",2,0],["وتؤول كل إمارة","لم يرعها في القوم آمر",76,"ر",1,0],["وَتَوفيقٍ مِنَ اللَهِ","وَتَيسيرٍ مِنَ السَعدِ",77,"د",1,0],["وَتَوَهَّجَت حَتّى تَقَلَّبَ في السَنا","وادي المُلوكِ حِجارَةً وَفَضاءَ",78,"ا",2,0],["وَتَواضَع في اِرتِفاعٍ تُعتَبَر","فَهُما ضِدّانِ كِبَرٌ وَكِبَر",79,"ر",1,0],["وَتَواصَوا بِخُطَّةٍ","وَتَداعَوا لِمُؤتَمَر",80,"ر",1,0],["وَتُؤَدّي القَولَ لا يَسبِقُها","رُسُلُ الأَرواحِ في نَقلِ الفِكَر",81,"ر",1,0],["وَتوقِدُ الذِكرى بِأَحشائِهِ","جَمراً مِنَ الشَوقِ حَثيثَ الضِرام",82,"م",1,0],["وَتَوارَيتُ بِدَمعي","عَن عُيونِ الرُقَباءِ",83,"ا",1,0],["وَتُؤخَذُ بِاِسمِهِ الدُنيا جَميعاً","وَما مِن ذاكَ شَيءٌ في يَدَيهِ",84,"ي",2,0],["وَتَوَلَّ في الهَيجاءِ جُندَ مُحَمَّدٍ","وَاِقعُد بِهِم في ذَلِكَ المُستَمطَرِ",85,"ر",1,0],["وَتَوَلَّت مِصراً يَمينٌ عَلى المِص","رِيِّ مِن دونِ ذا الوَرى عَسراءُ",86,"ا",2,0],["وَتَوَلّى عَلى النُفوسِ هَوى الأَو","ثانِ حَتّى اِنتَهَت لَهُ الأَهواءُ",86,"ا",2,0],["وَتَوَلّى بَني اليَزيدِيِّ بِالبَص","رَةِ حَتّى تَمَزَّقوا في البِلادِ",87,"د",1,0],["وَتَواضَعُ الأُمَراءُ حَولَ سَريرِهِ","وَتُري المَحَبَّةَ وَهيَ مِن آكالِهِ",88,"ل",2,0],["وَتُوافِيهِمِ بِها في القَنا السُم","رِ كَما وافَتِ العِطاشُ الصِلالا",89,"ل",2,0],["وَتَوَهَّموا اللَعِبَ الوَغى وَالطَعنُ