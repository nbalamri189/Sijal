{"poems":[[55,"أداري المقلتين عن ابن ليلى","https://www.aldiwan.net/poem30660.html","الوافر"],[36,"تكاد بلاد الله يا أم معمر","https://www.aldiwan.net/poem4918.html","الطويل"],[32,"ألا حي بالزرق الرسوم الخواليا","https://www.aldiwan.net/poem29520.html","الطويل"],[39,"ألا لا أرى الأيام يقضى عجيبها","https://www.aldiwan.net/poem6494.html","الطويل"],[53,"أيا غرة العليا ويا عينها اليمنى","https://www.aldiwan.net/poem7987.html","الطويل"],[31,"ألم تعرض فتسأل آل لهو","https://www.aldiwan.net/poem6055.html","الوافر"],[93,"هم ألم به مع الظلماء","https://www.aldiwan.net/poem8725.html","عموديه"],[72,"أحدثه إذا غفل الرقيب","https://www.aldiwan.net/poem43023.html","الوافر"],[47,"أأراك الحبيب خاطر وهم","https://www.aldiwan.net/poem65655.html","الخفيف"],[47,"نشدتك الله من برق على إضم","https://www.aldiwan.net/poem65663.html","البسيط"],[30,"إن تذعر الوحش من رأسي ولمته","https://www.aldiwan.net/poem5221.html","البسيط"],[30,"أبي الشيخ ذو البول الكثير مجاشع","https://www.aldiwan.net/poem5380.html","الطويل"],[63,"لحظ عينيك للردى أنصار","https://www.aldiwan.net/poem51681.html","الخفيف"],[60,"سيكفيني المليك وحد سيف","https://www.aldiwan.net/poem31141.html","الوافر"],[83,"أذوت سموم النوى ريحانة الأمل","https://www.aldiwan.net/poem61327.html","البسيط"],[83,"أذوق الهوى مر المطاعم علقما","https://www.aldiwan.net/poem61554.html","الطويل"],[42,"أقوى من آل ظليمة الحزم","https://www.aldiwan.net/poem42256.html","أحذ الكامل"],[42,"أراد اليوم جيرتك الغيارا","https://www.aldiwan.net/poem42293.html","الوافر"],[42,"يا صاح هذا العجب","https://www.aldiwan.net/poem42305.html","مجزوء الرجز"],[50,"أيها المنتاب عن عفره","https://www.aldiwan.net/poem63366.html","المديد"],[48,"أمذهبة التراس لرد كيد","https://www.aldiwan.net/poem22839.html","الوافر"],[48,"أتاني بإسناده مخبر","https://www.aldiwan.net/poem23265.html","المتقارب"],[48,"أمسي وأمسي في شحط وإن غدي","https://www.aldiwan.net/poem23515.html","البسيط"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[102,"السفر إلى الأيام الخضر","https://www.poetsgate.com/ViewPoem.aspx?id=50347",""],[47,"نَشَدْتُكَ الله مِنْ بَرْقٍ على إضَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=31833",""],[30,"أبي الشيخ ذو البول الكثير مجاشع","https://www.poetsgate.com/ViewPoem.aspx?id=21750",""],[119,"أذوب غراما والحبيب الذي أهوى","https://www.aldiwan.net/poem40429.html","عموديه"],[185,"سقى الله الدوافع من حفير","https://www.aldiwan.net/poem58835.html","الوافر"],[185,"أمنك أميم الدار غيرها البلى","https://www.aldiwan.net/poem58861.html","الطويل"],[190,"أرقت من الغروب إلى الشروق","https://www.aldiwan.net/poem43554.html","الوافر"],[190,"أقمت بجنبلا عشرين يوما","https://www.aldiwan.net/poem43643.html","الوافر"],[198,"لكل هم من الهموم سعه","https://www.aldiwan.net/poem635.html",""],[241,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[241,"شاقتك آرام إلف","https://www.aldiwan.net/poem19496.html","المجتث"],[275,"خيال سعد أسعف بالمزار","https://www.aldiwan.net/poem52064.html","الوافر"],[279,"أيا بشراي قد وضح القبول","https://www.aldiwan.net/poem25536.html","الوافر"],[301,"يا راحلين وهم في القلب سكان","https://www.aldiwan.net/poem33146.html","البسيط"],[309,"رسل البشائر ورد وصدور","https://www.aldiwan.net/poem56545.html","الخفيف"],[353,"جهل القياس وفاته القصد","https://www.aldiwan.net/poem15609.html","أحذ الكامل"],[357,"يا سرورا على القلوب تجلى","https://www.aldiwan.net/poem39588.html","الخفيف"],[367,"أذودهم عنكم وأنتم رئالة","https://www.aldiwan.net/poem1727.html","الطويل"],[381,"أذوب إذا رأيت يسوع يوما","https://www.aldiwan.net/poem59292.html","الطويل"],[407,"هذي الطريقة ليت شعري ما هي","https://www.aldiwan.net/poem33361.html","الكامل"],[409,"مررت بأمردين فقلت زورا","https://www.aldiwan.net/poem49703.html","الوافر"],[420,"أمن بعد الهمام القرم وادي","https://www.aldiwan.net/poem54153.html","الوافر"],[433,"نعم نعم النمام ذو ضرر","https://www.aldiwan.net/poem40071.html","البسيط"],[441,"قف إن شاني بهم أن يسفح الشان","https://www.aldiwan.net/poem2574.html","البسيط"],[443,"أنورك أم أوقدت بالليل نارك","https://www.aldiwan.net/poem34885.html","الطويل"],[445,"نيوب النائبات البائنات","https://www.aldiwan.net/poem14437.html","الوافر"],[445,"هيظت قلبي أبا الخرصي يسلوكا","https://www.aldiwan.net/poem14470.html","البسيط"],[461,"أمنها على أن المزار بعيد","https://www.aldiwan.net/poem56220.html","الوافر"],[464,"أقم يا حسامي في صوانك واهجم","https://www.aldiwan.net/poem15092.html","الطويل"],[467,"نسيم الصبا حدث بمن سكن الأثلا","https://www.aldiwan.net/poem3429.html","عموديه"],[480,"يا راقد الطرف طرفي في يد السهر","https://www.aldiwan.net/poem15249.html","البسيط"],[482,"أناديها وما لي لا أنادي","https://www.aldiwan.net/poem37581.html","الوافر"],[503,"أذوب لمكة الفيحاء حبا","https://www.aldiwan.net/poem37661.html","الوافر"],[503,"هو البدر أم وجه الحبيب الذي يبدو","https://www.aldiwan.net/poem38023.html","الطويل"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[1019,"","https://poetry.dctabudhabi.ae/diwan/poem/76773","المتقارب"],[1080,"","https://poetry.dctabudhabi.ae/diwan/poem/132045","الكامل"]],"verses":[["أَذودُ النَفسَ عَنهُ وَذاكَ مِنها","عِنانٌ ما مَلَكتُ لَهُ مَعاجا",0,"ج",2,0],["أَذودُ سَوامَ النَفسِ عَنكِ وَمالَهُ","عَلى أَحَدٍ إِلّا عَلَيكِ طَريقُ",1,"ق",1,0],["أَذو زَوجَةٍ بِالمِصرِ أَم ذو خُصومَةٍ","أَراكَ لَها بِالبَصرَةِ العامَ ثاويا",2,"ي",2,0],["إذ ودَّأتنا الأرض إن هي وأدت","وأفرخ من بين الأمور وَقُوبُها",3,"ب",3,0],["أَذو آلةٍ فاستخدِموني لآلتي","بقُوتيَ أوْ لا فارزُقوني مع الزَّمْنى",4,"ن",2,0],["أَذودُ اللَخلَخانِيّاتِ عَنهُ","وَأَمنِحُهُ المُصَرَّحِةِ العِرابا",5,"ب",2,0],["أَذوي اليَسارَ وَما اليَسارُ بِنافِعٍ","إِن لَم يَكُن أَهلوهُ أَهلُ سَخاءِ",6,"ا",2,0],["أَذوبُ إِذا سَمِعتُ لَهُ حَديثاً","تَكادُ حَلاوَةٌ فيهِ تَذوبُ",7,"ب",1,0],["إِذ وَدِدنا الحَجيجَ مِن أَجلِ ما تُف","تَنُ فيهِ أَرسالُ عُميٍ وَصُمِّ",8,"م",1,0],["إِذ وُدُّ لَيلى صَحيحٌ غَيرُ مُؤتَشِبٍ","وَحَبلُ لَيلى جَديدٌ غَيرُ مُنصَرِمِ",9,"م",1,0],["إِذ وَقَعَت كَوُقوعِ الطَيرِ وَاِنجَدَلَت","رُكبانُها حينَ لاقى الأَزرُعُ القَصَرا",10,"ر",2,0],["أَذودُ وَأَحمي عَن ذِمارِ مُجاشِعٍ","كَما ذادَ عَن حَوضي أَبوهُ المُخَبَّلُ",11,"ل",1,0],["إذ وجوهُ الأيَّامِ فيه رِياضٌ","ومياهُ السُّرورِ فيه خِمارُ",12,"ر",1,0],["أَذودُ بِهِ الكَتيبَةَ كُلَّ يَومٍ","إِذا ما الحَربُ تَضطَرِمُ اِلتِهابا",13,"ب",2,0],["أذوت سَمُومُ النَّوى ريحَانَة الأمَلِ","فَاسكُبب حَيَا الدَّمعِ في أجفانِها الذُّبُلِ",14,"ل",1,1],["أَذوقُ الهَوى مُرَّ المَطاعِمِ عَلقَماً","وَأَذكُرُ مِن فيهِ اللَمى فَيَطيبُ",15,"ب",1,1],["إِذ وُدُّها صافٍ وَرُؤيَتُها","أَمنِيَّةٌ وَكَلامُها غُنمُ",16,"م",1,0],["أَذُودُ النَفسَ وَهِيَ تَتُوقُ شَوقاً","وَأَمنَعُها حَياءً وَاِستِتارا",17,"ر",2,0],["إِذ وَرَّثُوني كَمَداً","فَالقَلبُ مِنّي يَضرِبُ",18,"ب",1,0],["أَذودُ الطَيرَ عَن شَجَرٍ","قَد بَلَوتُ المُرَّ مِن ثَمَرِه",19,"ر",2,0],["أَذودُ عَنِ الفرائِسِ ضارِياتٍ","وَأَعلَمُ أَنَّ غايَتَها اِفتِراسي",20,"س",2,0],["أَذو العِصمَةِ العاقِلُ الآدَميُّ","إِلّا كَذي العُصمَةِ العاقِلِ",21,"ل",1,0],["أَذوَينَ آلَ زُهَيرٍ وَاِرتَعَينَ بَني","نَبتٍ وَحَسَّينَ مَوتاً رَهطَ حَسّانِ",22,"ن",1,0],["أذود عن حريتي بحقها","واجهد النصر لحر مبتلى",23,"ا",1,0],["أذوب وأقسو كي أذوب لعلّي","أوجج من تحت الثلوج صباها",24,"ا",3,0],["إذْ وِدُّ لَيلى صَحيحٌ، غَيرُ مُؤتَشِبٍ،","وَخََبلاًُ لَيلى جَديدٌ، غَيرُ مُنصَرِمِ",25,"م",1,0],["أذُودُ وَأحْمي عَنْ ذِمارِ مُجاشِعٍ،","كمَا ذادَ عن حَوْضَيْ أبيهِ المُخَبَّلُ",26,"ل",1,0],["أذوب غراما والحبيب الذي أهوى","يعاملني بالهجر والقلب لا يقوى",27,"و",2,1],["أَذُودُ النَّفسَ عَن لَيلَى وَإِنِّى","لَتَعصِينِى شَوَاجِرُ قَد صَدِينَا",28,"ن",2,0],["أَذُودُ ارتداعُ الوُدِّ لا خَشيةَ الرّدَى","صَدَى هامَتِى عَمّا إِلَيهِ تَلُوبُ",29,"ب",1,0],["أذودُ الهمّ عني بالتمنّي","وفي كبدي كمضطرمِ الحريق",30,"ق",1,0],["أذود النفس عن كرم وجود","وأخفض هامتي بعد ارتفاع",31,"ع",1,0],["أَذودُ عَن حَوضِهِ وَيَدفَعُني","يا قَومِ مَن عاذِري مِنَ الخُدَعَه",32,"ع",2,0],["أَذْوَتْهُ إِعْصَارٌ تَهُ","بُّ عَلَيْهِ مِنْ لَفَحَاتِ حُقَّدْ",33,"د",1,0],["إِذْ وَاصَلَتْكَ الأَمَانِي","بَيْنَ ارْتِقَابٍ وَخَوْفِ",34,"ف",1,0],["أَذوب صبابة وأحن وَجدا","اليه يَفيض أَجفان غزار",35,"ر",1,0],["أَذوبُ إِذا أُحَجَّبُ عَنْهُ شَوْقاً","فَكَيْفَ بِهِ إِذا أَزِفَ الرَّحيلُ",36,"ل",1,0],["أَذوى وَريق شَبابي بعدَه ظمأٌ","وَغصنُه من مياهِ الحُسن ريّانُ",37,"ن",1,0],["إِذ واجَهته من المحرّمِ غرّةٌ","سَعدَت فأسعدنا بها المقدورُ",38,"ر",1,0],["إِذ وَردُ خَدِّكَ في الوُلوعِ بِهِ","يَزهو وَلَونُ الوَردِ يَرتَدُّ",39,"د",1,0],["إِذ وَرَدنا ورودَها فَظَللنا","نَتَهادى الرِياض ورداً وَظلّا",40,"ل",2,0],["أَذودُهُمُ عَنكُم وَأَنتُم رِئالَةٌ","شِلالاً كَما ذيدَ النِهالُ الخَوامِسُ",41,"س",1,1],["أذوب إذا رأيت يسوع يوماً","يدانُ كمجرمٍ بين الرجالِ",42,"ل",1,1],["إذ وضعها في الأصل ترجمتي وما","ألفت من كتب بفضل إلهي",43,"ي",1,0],["أذُو مالٍ فقلْتُ وذو يَسارٍ","فقالَ الأمْرَدانِ الأمرُدانِ",44,"ن",1,0],["أذوب عليك بالحزن إدّكاراً","وأشرقَ منك بالماء البراد",45,"د",1,0],["أذود عني أذى النمام مقتصراً","عنه الأحاديث لا أفضى إليه خبر",46,"ر",1,0],["أذود باليأس عن احواضهم أملا","يروى بريّ الأماني وهو عطشان",47,"ن",1,0],["أَذُو الحَظِّ من علم الكتاب حدَاك لي","أَم الفلكُ الدَّوار نحوي أَدارَكِ",48,"ك",1,0],["أَذوب أَسى ولوعات ووجداً","وأعلن بالزفير ثنى وفردا",49,"د",2,0],["أذوب كالشمع من حزن بليت به","إذا تذكرت معنى من معانيكا",50,"ك",2,0],["أذودُ بها عن سَرح عِرضك كلّما","تطلَّعَ فيه للفريسةِ سِيدُ",51,"د",1,0],["أذود الصبا عن مطمحٍ غير ماجدٍ","وأنهى الهوى عن موقف غير مكرم",52,"م",1,0],["أذوب على تلك الذوائب غيرة","إذا لاعبت أحيان ترسلها الحجلا",53,"ل",2,0],["أذوبُ شوقاً لكنّي أخو جَلَدٍ","فيه وانْ كانَ طعمُ الصَّبْرِ كالصَّبِرِ",54,"ر",1,0],["أذود بها عن الوطن المفدّى","وأحمي تونس الخضرا بلادي",55,"د",2,0],["أذوبُ لمكَّةَ الفيحاءِ حباً","لأَنَّ حبيب أهل الحالي مكي",56,"ي",1,1],["أَذوبُ له شوقاً وأَكتُمُ حالَتي","ومن عَجَبٍ أَن يعشقَ السَّيِّدَ العَبْدُ",57,"د",1,0],["إذ وافق الاسم تمسى مهدي","وهذه من الدواهي عندي",58,"ي",1,0],["إذ وافق الإسم وإذ تكنّى","بمثل ما ذكرته في المعنى",58,"ن",2,0],["أَذود القَوافيَ عَني ذيادا","ذيادَ غلامٍ جَرىءٍ جَوادا",59,"د",2,1],["أذؤاب إني لم أهبك ولم أقم","للبيع عند تحضّر الأجلاب",60,"ب",1,0],["أذؤاب صاب على صداك فجاده","صوب الرّبيع بوابلٍ سكاب",60,"ب",1,0]]}