{"poems":[[53,"أداري المقلتين عن ابن ليلى","https://www.aldiwan.net/poem30660.html","الوافر"],[34,"تكاد بلاد الله يا أم معمر","https://www.aldiwan.net/poem4918.html","الطويل"],[30,"ألا حي بالزرق الرسوم الخواليا","https://www.aldiwan.net/poem29520.html","الطويل"],[37,"ألا لا أرى الأيام يقضى عجيبها","https://www.aldiwan.net/poem6494.html","الطويل"],[51,"أيا غرة العليا ويا عينها اليمنى","https://www.aldiwan.net/poem7987.html","الطويل"],[29,"ألم تعرض فتسأل آل لهو","https://www.aldiwan.net/poem6055.html","الوافر"],[91,"هم ألم به مع الظلماء","https://www.aldiwan.net/poem8725.html","عموديه"],[70,"أحدثه إذا غفل الرقيب","https://www.aldiwan.net/poem43023.html","الوافر"],[45,"أأراك الحبيب خاطر وهم","https://www.aldiwan.net/poem65655.html","الخفيف"],[45,"نشدتك الله من برق على إضم","https://www.aldiwan.net/poem65663.html","البسيط"],[28,"إن تذعر الوحش من رأسي ولمته","https://www.aldiwan.net/poem5221.html","البسيط"],[28,"أبي الشيخ ذو البول الكثير مجاشع","https://www.aldiwan.net/poem5380.html","الطويل"],[61,"لحظ عينيك للردى أنصار","https://www.aldiwan.net/poem51681.html","الخفيف"],[58,"سيكفيني المليك وحد سيف","https://www.aldiwan.net/poem31141.html","الوافر"],[81,"أذوت سموم النوى ريحانة الأمل","https://www.aldiwan.net/poem61327.html","البسيط"],[81,"أذوق الهوى مر المطاعم علقما","https://www.aldiwan.net/poem61554.html","الطويل"],[40,"أقوى من آل ظليمة الحزم","https://www.aldiwan.net/poem42256.html","أحذ الكامل"],[40,"أراد اليوم جيرتك الغيارا","https://www.aldiwan.net/poem42293.html","الوافر"],[40,"يا صاح هذا العجب","https://www.aldiwan.net/poem42305.html","مجزوء الرجز"],[48,"أيها المنتاب عن عفره","https://www.aldiwan.net/poem63366.html","المديد"],[46,"أمذهبة التراس لرد كيد","https://www.aldiwan.net/poem22839.html","الوافر"],[46,"أتاني بإسناده مخبر","https://www.aldiwan.net/poem23265.html","المتقارب"],[46,"أمسي وأمسي في شحط وإن غدي","https://www.aldiwan.net/poem23515.html","البسيط"],[100,"السفر إلى الأيام الخضر","https://www.poetsgate.com/ViewPoem.aspx?id=50347",""],[45,"نَشَدْتُكَ الله مِنْ بَرْقٍ على إضَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=31833",""],[28,"أبي الشيخ ذو البول الكثير مجاشع","https://www.poetsgate.com/ViewPoem.aspx?id=21750",""],[116,"أذوب غراما والحبيب الذي أهوى","https://www.aldiwan.net/poem40429.html","عموديه"],[182,"سقى الله الدوافع من حفير","https://www.aldiwan.net/poem58835.html","الوافر"],[182,"أمنك أميم الدار غيرها البلى","https://www.aldiwan.net/poem58861.html","الطويل"],[187,"أرقت من الغروب إلى الشروق","https://www.aldiwan.net/poem43554.html","الوافر"],[187,"أقمت بجنبلا عشرين يوما","https://www.aldiwan.net/poem43643.html","الوافر"],[195,"لكل هم من الهموم سعه","https://www.aldiwan.net/poem635.html",""],[238,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[238,"شاقتك آرام إلف","https://www.aldiwan.net/poem19496.html","المجتث"],[272,"خيال سعد أسعف بالمزار","https://www.aldiwan.net/poem52064.html","الوافر"],[276,"أيا بشراي قد وضح القبول","https://www.aldiwan.net/poem25536.html","الوافر"],[298,"يا راحلين وهم في القلب سكان","https://www.aldiwan.net/poem33146.html","البسيط"],[306,"رسل البشائر ورد وصدور","https://www.aldiwan.net/poem56545.html","الخفيف"],[350,"جهل القياس وفاته القصد","https://www.aldiwan.net/poem15609.html","أحذ الكامل"],[354,"يا سرورا على القلوب تجلى","https://www.aldiwan.net/poem39588.html","الخفيف"],[364,"أذودهم عنكم وأنتم رئالة","https://www.aldiwan.net/poem1727.html","الطويل"],[378,"أذوب إذا رأيت يسوع يوما","https://www.aldiwan.net/poem59292.html","الطويل"],[404,"هذي الطريقة ليت شعري ما هي","https://www.aldiwan.net/poem33361.html","الكامل"],[406,"مررت بأمردين فقلت زورا","https://www.aldiwan.net/poem49703.html","الوافر"],[417,"أمن بعد الهمام القرم وادي","https://www.aldiwan.net/poem54153.html","الوافر"],[430,"نعم نعم النمام ذو ضرر","https://www.aldiwan.net/poem40071.html","البسيط"],[438,"قف إن شاني بهم أن يسفح الشان","https://www.aldiwan.net/poem2574.html","البسيط"],[440,"أنورك أم أوقدت بالليل نارك","https://www.aldiwan.net/poem34885.html","الطويل"],[442,"نيوب النائبات البائنات","https://www.aldiwan.net/poem14437.html","الوافر"],[442,"هيظت قلبي أبا الخرصي يسلوكا","https://www.aldiwan.net/poem14470.html","البسيط"],[459,"أمنها على أن المزار بعيد","https://www.aldiwan.net/poem56220.html","الوافر"],[462,"أقم يا حسامي في صوانك واهجم","https://www.aldiwan.net/poem15092.html","الطويل"],[465,"نسيم الصبا حدث بمن سكن الأثلا","https://www.aldiwan.net/poem3429.html","عموديه"],[478,"يا راقد الطرف طرفي في يد السهر","https://www.aldiwan.net/poem15249.html","البسيط"],[480,"أناديها وما لي لا أنادي","https://www.aldiwan.net/poem37581.html","الوافر"],[501,"أذوب لمكة الفيحاء حبا","https://www.aldiwan.net/poem37661.html","الوافر"],[501,"هو البدر أم وجه الحبيب الذي يبدو","https://www.aldiwan.net/poem38023.html","الطويل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["أَذودُ النَفسَ عَنهُ وَذاكَ مِنها","عِنانٌ ما مَلَكتُ لَهُ مَعاجا",0,"ج",2,0],["أَذودُ سَوامَ النَفسِ عَنكِ وَمالَهُ","عَلى أَحَدٍ إِلّا عَلَيكِ طَريقُ",1,"ق",1,0],["أَذو زَوجَةٍ بِالمِصرِ أَم ذو خُصومَةٍ","أَراكَ لَها بِالبَصرَةِ العامَ ثاويا",2,"ي",2,0],["إذ ودَّأتنا الأرض إن هي وأدت","وأفرخ من بين الأمور وَقُوبُها",3,"ب",3,0],["أَذو آلةٍ فاستخدِموني لآلتي","بقُوتيَ أوْ لا فارزُقوني مع الزَّمْنى",4,"ن",2,0],["أَذودُ اللَخلَخانِيّاتِ عَنهُ","وَأَمنِحُهُ المُصَرَّحِةِ العِرابا",5,"ب",2,0],["أَذوي اليَسارَ وَما اليَسارُ بِنافِعٍ","إِن لَم يَكُن أَهلوهُ أَهلُ سَخاءِ",6,"ا",2,0],["أَذوبُ إِذا سَمِعتُ لَهُ حَديثاً","تَكادُ حَلاوَةٌ فيهِ تَذوبُ",7,"ب",1,0],["إِذ وَدِدنا الحَجيجَ مِن أَجلِ ما تُف","تَنُ فيهِ أَرسالُ عُميٍ وَصُمِّ",8,"م",1,0],["إِذ وُدُّ لَيلى صَحيحٌ غَيرُ مُؤتَشِبٍ","وَحَبلُ لَيلى جَديدٌ غَيرُ مُنصَرِمِ",9,"م",1,0],["إِذ وَقَعَت كَوُقوعِ الطَيرِ وَاِنجَدَلَت","رُكبانُها حينَ لاقى الأَزرُعُ القَصَرا",10,"ر",2,0],["أَذودُ وَأَحمي عَن ذِمارِ مُجاشِعٍ","كَما ذادَ عَن حَوضي أَبوهُ المُخَبَّلُ",11,"ل",1,0],["إذ وجوهُ الأيَّامِ فيه رِياضٌ","ومياهُ السُّرورِ فيه خِمارُ",12,"ر",1,0],["أَذودُ بِهِ الكَتيبَةَ كُلَّ يَومٍ","إِذا ما الحَربُ تَضطَرِمُ اِلتِهابا",13,"ب",2,0],["أذوت سَمُومُ النَّوى ريحَانَة الأمَلِ","فَاسكُبب حَيَا الدَّمعِ في أجفانِها الذُّبُلِ",14,"ل",1,1],["أَذوقُ الهَوى مُرَّ المَطاعِمِ عَلقَماً","وَأَذكُرُ مِن فيهِ اللَمى فَيَطيبُ",15,"ب",1,1],["إِذ وُدُّها صافٍ وَرُؤيَتُها","أَمنِيَّةٌ وَكَلامُها غُنمُ",16,"م",1,0],["أَذُودُ النَفسَ وَهِيَ تَتُوقُ شَوقاً","وَأَمنَعُها حَياءً وَاِستِتارا",17,"ر",2,0],["إِذ وَرَّثُوني كَمَداً","فَالقَلبُ مِنّي يَضرِبُ",18,"ب",1,0],["أَذودُ الطَيرَ عَن شَجَرٍ","قَد بَلَوتُ المُرَّ مِن ثَمَرِه",19,"ر",2,0],["أَذودُ عَنِ الفرائِسِ ضارِياتٍ","وَأَعلَمُ أَنَّ غايَتَها اِفتِراسي",20,"س",2,0],["أَذو العِصمَةِ العاقِلُ الآدَميُّ","إِلّا كَذي العُصمَةِ العاقِلِ",21,"ل",1,0],["أَذوَينَ آلَ زُهَيرٍ وَاِرتَعَينَ بَني","نَبتٍ وَحَسَّينَ مَوتاً رَهطَ حَسّانِ",22,"ن",1,0],["أذوب وأقسو كي أذوب لعلّي","أوجج من تحت الثلوج صباها",23,"ا",3,0],["إذْ وِدُّ لَيلى صَحيحٌ، غَيرُ مُؤتَشِبٍ،","وَخََبلاًُ لَيلى جَديدٌ، غَيرُ مُنصَرِمِ",24,"م",1,0],["أذُودُ وَأحْمي عَنْ ذِمارِ مُجاشِعٍ،","كمَا ذادَ عن حَوْضَيْ أبيهِ المُخَبَّلُ",25,"ل",1,0],["أذوب غراما والحبيب الذي أهوى","يعاملني بالهجر والقلب لا يقوى",26,"و",2,1],["أَذُودُ النَّفسَ عَن لَيلَى وَإِنِّى","لَتَعصِينِى شَوَاجِرُ قَد صَدِينَا",27,"ن",2,0],["أَذُودُ ارتداعُ الوُدِّ لا خَشيةَ الرّدَى","صَدَى هامَتِى عَمّا إِلَيهِ تَلُوبُ",28,"ب",1,0],["أذودُ الهمّ عني بالتمنّي","وفي كبدي كمضطرمِ الحريق",29,"ق",1,0],["أذود النفس عن كرم وجود","وأخفض هامتي بعد ارتفاع",30,"ع",1,0],["أَذودُ عَن حَوضِهِ وَيَدفَعُني","يا قَومِ مَن عاذِري مِنَ الخُدَعَه",31,"ع",2,0],["أَذْوَتْهُ إِعْصَارٌ تَهُ","بُّ عَلَيْهِ مِنْ لَفَحَاتِ حُقَّدْ",32,"د",1,0],["إِذْ وَاصَلَتْكَ الأَمَانِي","بَيْنَ ارْتِقَابٍ وَخَوْفِ",33,"ف",1,0],["أَذوب صبابة وأحن وَجدا","اليه يَفيض أَجفان غزار",34,"ر",1,0],["أَذوبُ إِذا أُحَجَّبُ عَنْهُ شَوْقاً","فَكَيْفَ بِهِ إِذا أَزِفَ الرَّحيلُ",35,"ل",1,0],["أَذوى وَريق شَبابي بعدَه ظمأٌ","وَغصنُه من مياهِ الحُسن ريّانُ",36,"ن",1,0],["إِذ واجَهته من المحرّمِ غرّةٌ","سَعدَت فأسعدنا بها المقدورُ",37,"ر",1,0],["إِذ وَردُ خَدِّكَ في الوُلوعِ بِهِ","يَزهو وَلَونُ الوَردِ يَرتَدُّ",38,"د",1,0],["إِذ وَرَدنا ورودَها فَظَللنا","نَتَهادى الرِياض ورداً وَظلّا",39,"ل",2,0],["أَذودُهُمُ عَنكُم وَأَنتُم رِئالَةٌ","شِلالاً كَما ذيدَ النِهالُ الخَوامِسُ",40,"س",1,1],["أذوب إذا رأيت يسوع يوماً","يدانُ كمجرمٍ بين الرجالِ",41,"ل",1,1],["إذ وضعها في الأصل ترجمتي وما","ألفت من كتب بفضل إلهي",42,"ي",1,0],["أذُو مالٍ فقلْتُ وذو يَسارٍ","فقالَ الأمْرَدانِ الأمرُدانِ",43,"ن",1,0],["أذوب عليك بالحزن إدّكاراً","وأشرقَ منك بالماء البراد",44,"د",1,0],["أذود عني أذى النمام مقتصراً","عنه الأحاديث لا أفضى إليه خبر",45,"ر",1,0],["أذود باليأس عن احواضهم أملا","يروى بريّ الأماني وهو عطشان",46,"ن",1,0],["أَذُو الحَظِّ من علم الكتاب حدَاك لي","أَم الفلكُ الدَّوار نحوي أَدارَكِ",47,"ك",1,0],["أَذوب أَسى ولوعات ووجداً","وأعلن بالزفير ثنى وفردا",48,"د",2,0],["أذوب كالشمع من حزن بليت به","إذا تذكرت معنى من معانيكا",49,"ك",2,0],["أذودُ بها عن سَرح عِرضك كلّما","تطلَّعَ فيه للفريسةِ سِيدُ",50,"د",1,0],["أذود الصبا عن مطمحٍ غير ماجدٍ","وأنهى الهوى عن موقف غير مكرم",51,"م",1,0],["أذوب على تلك الذوائب غيرة","إذا لاعبت أحيان ترسلها الحجلا",52,"ل",2,0],["أذوبُ شوقاً لكنّي أخو جَلَدٍ","فيه وانْ كانَ طعمُ الصَّبْرِ كالصَّبِرِ",53,"ر",1,0],["أذود بها عن الوطن المفدّى","وأحمي تونس الخضرا بلادي",54,"د",2,0],["أذوبُ لمكَّةَ الفيحاءِ حباً","لأَنَّ حبيب أهل الحالي مكي",55,"ي",1,1],["أَذوبُ له شوقاً وأَكتُمُ حالَتي","ومن عَجَبٍ أَن يعشقَ السَّيِّدَ العَبْدُ",56,"د",1,0],["إذ وافق الاسم تمسى مهدي","وهذه من الدواهي عندي",57,"ي",1,0],["إذ وافق الإسم وإذ تكنّى","بمثل ما ذكرته في المعنى",57,"ن",2,0]]}