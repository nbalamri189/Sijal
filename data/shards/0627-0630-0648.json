{"poems":[[53,"أداري المقلتين عن ابن ليلى","https://www.aldiwan.net/poem30660.html","الوافر"],[34,"تكاد بلاد الله يا أم معمر","https://www.aldiwan.net/poem4918.html","الطويل"],[30,"ألا حي بالزرق الرسوم الخواليا","https://www.aldiwan.net/poem29520.html","الطويل"],[37,"ألا لا أرى الأيام يقضى عجيبها","https://www.aldiwan.net/poem6494.html","الطويل"],[51,"أيا غرة العليا ويا عينها اليمنى","https://www.aldiwan.net/poem7987.html","الطويل"],[29,"ألم تعرض فتسأل آل لهو","https://www.aldiwan.net/poem6055.html","الوافر"],[91,"هم ألم به مع الظلماء","https://www.aldiwan.net/poem8725.html","عموديه"],[70,"أحدثه إذا غفل الرقيب","https://www.aldiwan.net/poem43023.html","الوافر"],[45,"أأراك الحبيب خاطر وهم","https://www.aldiwan.net/poem65655.html","الخفيف"],[45,"نشدتك الله من برق على إضم","https://www.aldiwan.net/poem65663.html","البسيط"],[28,"إن تذعر الوحش من رأسي ولمته","https://www.aldiwan.net/poem5221.html","البسيط"],[28,"أبي الشيخ ذو البول الكثير مجاشع","https://www.aldiwan.net/poem5380.html","الطويل"],[61,"لحظ عينيك للردى أنصار","https://www.aldiwan.net/poem51681.html","الخفيف"],[58,"سيكفيني المليك وحد سيف","https://www.aldiwan.net/poem31141.html","الوافر"],[81,"أذوت سموم النوى ريحانة الأمل","https://www.aldiwan.net/poem61327.html","البسيط"],[81,"أذوق الهوى مر المطاعم علقما","https://www.aldiwan.net/poem61554.html","الطويل"],[40,"أقوى من آل ظليمة الحزم","https://www.aldiwan.net/poem42256.html","أحذ الكامل"],[40,"أراد اليوم جيرتك الغيارا","https://www.aldiwan.net/poem42293.html","الوافر"],[40,"يا صاح هذا العجب","https://www.aldiwan.net/poem42305.html","مجزوء الرجز"],[48,"أيها المنتاب عن عفره","https://www.aldiwan.net/poem63366.html","المديد"],[46,"أمذهبة التراس لرد كيد","https://www.aldiwan.net/poem22839.html","الوافر"],[46,"أتاني بإسناده مخبر","https://www.aldiwan.net/poem23265.html","المتقارب"],[46,"أمسي وأمسي في شحط وإن غدي","https://www.aldiwan.net/poem23515.html","البسيط"],[45,"نَشَدْتُكَ الله مِنْ بَرْقٍ على إضَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=31833",""],[28,"أبي الشيخ ذو البول الكثير مجاشع","https://www.poetsgate.com/ViewPoem.aspx?id=21750",""]],"verses":[["أَذودُ النَفسَ عَنهُ وَذاكَ مِنها","عِنانٌ ما مَلَكتُ لَهُ مَعاجا",0,"ج",2,0],["أَذودُ سَوامَ النَفسِ عَنكِ وَمالَهُ","عَلى أَحَدٍ إِلّا عَلَيكِ طَريقُ",1,"ق",1,0],["أَذو زَوجَةٍ بِالمِصرِ أَم ذو خُصومَةٍ","أَراكَ لَها بِالبَصرَةِ العامَ ثاويا",2,"ي",2,0],["إذ ودَّأتنا الأرض إن هي وأدت","وأفرخ من بين الأمور وَقُوبُها",3,"ب",3,0],["أَذو آلةٍ فاستخدِموني لآلتي","بقُوتيَ أوْ لا فارزُقوني مع الزَّمْنى",4,"ن",2,0],["أَذودُ اللَخلَخانِيّاتِ عَنهُ","وَأَمنِحُهُ المُصَرَّحِةِ العِرابا",5,"ب",2,0],["أَذوي اليَسارَ وَما اليَسارُ بِنافِعٍ","إِن لَم يَكُن أَهلوهُ أَهلُ سَخاءِ",6,"ا",2,0],["أَذوبُ إِذا سَمِعتُ لَهُ حَديثاً","تَكادُ حَلاوَةٌ فيهِ تَذوبُ",7,"ب",1,0],["إِذ وَدِدنا الحَجيجَ مِن أَجلِ ما تُف","تَنُ فيهِ أَرسالُ عُميٍ وَصُمِّ",8,"م",1,0],["إِذ وُدُّ لَيلى صَحيحٌ غَيرُ مُؤتَشِبٍ","وَحَبلُ لَيلى جَديدٌ غَيرُ مُنصَرِمِ",9,"م",1,0],["إِذ وَقَعَت كَوُقوعِ الطَيرِ وَاِنجَدَلَت","رُكبانُها حينَ لاقى الأَزرُعُ القَصَرا",10,"ر",2,0],["أَذودُ وَأَحمي عَن ذِمارِ مُجاشِعٍ","كَما ذادَ عَن حَوضي أَبوهُ المُخَبَّلُ",11,"ل",1,0],["إذ وجوهُ الأيَّامِ فيه رِياضٌ","ومياهُ السُّرورِ فيه خِمارُ",12,"ر",1,0],["أَذودُ بِهِ الكَتيبَةَ كُلَّ يَومٍ","إِذا ما الحَربُ تَضطَرِمُ اِلتِهابا",13,"ب",2,0],["أذوت سَمُومُ النَّوى ريحَانَة الأمَلِ","فَاسكُبب حَيَا الدَّمعِ في أجفانِها الذُّبُلِ",14,"ل",1,1],["أَذوقُ الهَوى مُرَّ المَطاعِمِ عَلقَماً","وَأَذكُرُ مِن فيهِ اللَمى فَيَطيبُ",15,"ب",1,1],["إِذ وُدُّها صافٍ وَرُؤيَتُها","أَمنِيَّةٌ وَكَلامُها غُنمُ",16,"م",1,0],["أَذُودُ النَفسَ وَهِيَ تَتُوقُ شَوقاً","وَأَمنَعُها حَياءً وَاِستِتارا",17,"ر",2,0],["إِذ وَرَّثُوني كَمَداً","فَالقَلبُ مِنّي يَضرِبُ",18,"ب",1,0],["أَذودُ الطَيرَ عَن شَجَرٍ","قَد بَلَوتُ المُرَّ مِن ثَمَرِه",19,"ر",2,0],["أَذودُ عَنِ الفرائِسِ ضارِياتٍ","وَأَعلَمُ أَنَّ غايَتَها اِفتِراسي",20,"ي",1,0],["أَذو العِصمَةِ العاقِلُ الآدَميُّ","إِلّا كَذي العُصمَةِ العاقِلِ",21,"ل",1,0],["أَذوَينَ آلَ زُهَيرٍ وَاِرتَعَينَ بَني","نَبتٍ وَحَسَّينَ مَوتاً رَهطَ حَسّانِ",22,"ن",1,0],["إذْ وِدُّ لَيلى صَحيحٌ، غَيرُ مُؤتَشِبٍ،","وَخََبلاًُ لَيلى جَديدٌ، غَيرُ مُنصَرِمِ",23,"م",1,0],["أذُودُ وَأحْمي عَنْ ذِمارِ مُجاشِعٍ،","كمَا ذادَ عن حَوْضَيْ أبيهِ المُخَبَّلُ",24,"ل",1,0]]}