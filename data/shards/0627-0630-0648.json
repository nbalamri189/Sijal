183426",""],[5376,"أذودُ عن الحوض ِالمنيعِ برفعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=188375",""],[5409,"مروا به وسط الدساكر","https://www.poetsgate.com/ViewPoem.aspx?id=155277",""],[5431,"كأنّك...","https://www.poetsgate.com/ViewPoem.aspx?id=183031",""],[5431,"حسبي حبيبيَ تسبيحي وأشجاني!!","https://www.poetsgate.com/ViewPoem.aspx?id=186469",""],[5431,"وكل جوارحي بهواك غرقى ..","https://www.poetsgate.com/ViewPoem.aspx?id=195240",""],[5431,"الكون أنت وبانعكاسك أشرقا","https://www.poetsgate.com/ViewPoem.aspx?id=200562",""],[5464,"طرقنا بابكم فأجاب صمت","https://www.poetsgate.com/ViewPoem.aspx?id=6677",""],[2229,"أُعِيدُُها هيفا بربّ الفَلَقِ","https://www.poetsgate.com/ViewPoem.aspx?id=49795",""],[5561,"ومضة شوق","https://www.poetsgate.com/ViewPoem.aspx?id=193806",""],[5582,"أَمِنْ ذِكْرِ أَطْلالٍ خَلَتْ وَتَعَفَّتِ","https://www.poetsgate.com/ViewPoem.aspx?id=63472",""],[5720,"حُبِّيْ لِلْهَادِيْﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=202095",""],[5720,"توأم الروح","https://www.poetsgate.com/ViewPoem.aspx?id=208744",""],[5842,"يا شام (د. جمال مرسي)","https://www.poetsgate.com/ViewPoem.aspx?id=65846",""],[5912,"لجة الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=205020",""],[5956,"بيت الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=182131",""],[5956,"نذوب","https://www.poetsgate.com/ViewPoem.aspx?id=182298",""],[5988,"يا قمر الكرخ ان عبدكم","https://www.poetsgate.com/ViewPoem.aspx?id=99725",""],[6031,"هَتَفَتْ بِدَمْعِ العَينِ وَهْي سَجُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=46292",""],[6102,"أُمنِياتٌ بَريئَة !!","https://www.poetsgate.com/ViewPoem.aspx?id=211861",""],[6125,"فُؤادِي جَذوَةٌ وَهَوَاكِ زَيتُ","https://www.poetsgate.com/ViewPoem.aspx?id=207909",""],[6125,"لَهَاهُ العِزُّ والمرتعْ","https://www.poetsgate.com/ViewPoem.aspx?id=210905",""],[6125,"فمن عينيكِ ألتمسُ المعاني","https://www.poetsgate.com/ViewPoem.aspx?id=210908",""],[242,"يا حسنه والحسن قيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563695",""],[6221,"عذبة النجوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64917&r=&rc=1",""],[5555,"قَمِيصُ التُّوت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87410&r=&rc=6",""],[5164,"ذُلُّ الهَوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75663&r=&rc=17",""],[6312,"البؤرُ المتحركةُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82949&r=&rc=4",""]],"verses":[["أَذودُ النَفسَ عَنهُ وَذاكَ مِنها","عِنانٌ ما مَلَكتُ لَهُ مَعاجا",0,"ج",2,0],["أَذودُ سَوامَ النَفسِ عَنكِ وَمالَهُ","عَلى أَحَدٍ إِلّا عَلَيكِ طَريقُ",1,"ق",1,0],["أَذو زَوجَةٍ بِالمِصرِ أَم ذو خُصومَةٍ","أَراكَ لَها بِالبَصرَةِ العامَ ثاويا",2,"ي",2,0],["إذ ودَّأتنا الأرض إن هي وأدت","وأفرخ من بين الأمور وَقُوبُها",3,"ب",3,0],["أَذو آلةٍ فاستخدِموني لآلتي","بقُوتيَ أوْ لا فارزُقوني مع الزَّمْنى",4,"ن",2,0],["أَذودُ اللَخلَخانِيّاتِ عَنهُ","وَأَمنِحُهُ المُصَرَّحِةِ العِرابا",5,"ب",2,0],["أَذوي اليَسارَ وَما اليَسارُ بِنافِعٍ","إِن لَم يَكُن أَهلوهُ أَهلُ سَخاءِ",6,"ا",2,0],["أَذوبُ إِذا سَمِعتُ لَهُ حَديثاً","تَكادُ حَلاوَةٌ فيهِ تَذوبُ",7,"ب",1,0],["إِذ وَدِدنا الحَجيجَ مِن أَجلِ ما تُف","تَنُ فيهِ أَرسالُ عُميٍ وَصُمِّ",8,"م",1,0],["إِذ وُدُّ لَيلى صَحيحٌ غَيرُ مُؤتَشِبٍ","وَحَبلُ لَيلى جَديدٌ غَيرُ مُنصَرِمِ",9,"م",1,0],["إِذ وَقَعَت كَوُقوعِ الطَيرِ وَاِنجَدَلَت","رُكبانُها حينَ لاقى الأَزرُعُ القَصَرا",10,"ر",2,0],["أَذودُ وَأَحمي عَن ذِمارِ مُجاشِعٍ","كَما ذادَ عَن حَوضي أَبوهُ المُخَبَّلُ",11,"ل",1,0],["إذ وجوهُ الأيَّامِ فيه رِياضٌ","ومياهُ السُّرورِ فيه خِمارُ",12,"ر",1,0],["أَذودُ بِهِ الكَتيبَةَ كُلَّ يَومٍ","إِذا ما الحَربُ تَضطَرِمُ اِلتِهابا",13,"ب",2,0],["أذوت سَمُومُ النَّوى ريحَانَة الأمَلِ","فَاسكُبب حَيَا الدَّمعِ في أجفانِها الذُّبُلِ",14,"ل",1,1],["أَذوقُ الهَوى مُرَّ المَطاعِمِ عَلقَماً","وَأَذكُرُ مِن فيهِ اللَمى فَيَطيبُ",15,"ب",1,1],["إِذ وُدُّها صافٍ وَرُؤيَتُها","أَمنِيَّةٌ وَكَلامُها غُنمُ",16,"م",1,0],["أَذُودُ النَفسَ وَهِيَ تَتُوقُ شَوقاً","وَأَمنَعُها حَياءً وَاِستِتارا",17,"ر",2,0],["إِذ وَرَّثُوني كَمَداً","فَالقَلبُ مِنّي يَضرِبُ",18,"ب",1,0],["أَذودُ الطَيرَ عَن شَجَرٍ","قَد بَلَوتُ المُرَّ مِن ثَمَرِه",19,"ر",2,0],["أَذودُ عَنِ الفرائِسِ ضارِياتٍ","وَأَعلَمُ أَنَّ غايَتَها اِفتِراسي",20,"س",2,0],["أَذو العِصمَةِ العاقِلُ الآدَميُّ","إِلّا كَذي العُصمَةِ العاقِلِ",21,"ل",1,0],["أَذوَينَ آلَ زُهَيرٍ وَاِرتَعَينَ بَني","نَبتٍ وَحَسَّينَ مَوتاً رَهطَ حَسّانِ",22,"ن",1,0],["أذود عن حريتي بحقها","واجهد النصر لحر مبتلى",23,"ا",1,0],["أذوب وأقسو كي أذوب لعلّي","أوجج من تحت الثلوج صباها",24,"ا",3,0],["إذْ وِدُّ لَيلى صَحيحٌ، غَيرُ مُؤتَشِبٍ،","وَخََبلاًُ لَيلى جَديدٌ، غَيرُ مُنصَرِمِ",25,"م",1,0],["أذُودُ وَأحْمي عَنْ ذِمارِ مُجاشِعٍ،","كمَا ذادَ عن حَوْضَيْ أبيهِ المُخَبَّلُ",26,"ل",1,0],["أذوب غراما والحبيب الذي أهوى","يعاملني بالهجر والقلب لا يقوى",27,"و",2,1],["أَذُودُ النَّفسَ عَن لَيلَى وَإِنِّى","لَتَعصِينِى شَوَاجِرُ قَد صَدِينَا",28,"ن",2,0],["أَذُودُ ارتداعُ الوُدِّ لا خَشيةَ الرّدَى","صَدَى هامَتِى عَمّا إِلَيهِ تَلُوبُ",29,"ب",1,0],["أذودُ الهمّ عني بالتمنّي","وفي كبدي كمضطرمِ الحريق",30,"ق",1,0],["أذود النفس عن كرم وجود","وأخفض هامتي بعد ارتفاع",31,"ع",1,0],["أَذودُ عَن حَوضِهِ وَيَدفَعُني","يا قَومِ مَن عاذِري مِنَ الخُدَعَه",32,"ع",2,0],["أَذْوَتْهُ إِعْصَارٌ تَهُ","بُّ عَلَيْهِ مِنْ لَفَحَاتِ حُقَّدْ",33,"د",1,0],["إِذْ وَاصَلَتْكَ الأَمَانِي","بَيْنَ ارْتِقَابٍ وَخَوْفِ",34,"ف",1,0],["أَذوب صبابة وأحن وَجدا","اليه يَفيض أَجفان غزار",35,"ر",1,0],["أَذوبُ إِذا أُحَجَّبُ عَنْهُ شَوْقاً","فَكَيْفَ بِهِ إِذا أَزِفَ الرَّحيلُ",36,"ل",1,0],["أَذوى وَريق شَبابي بعدَه ظمأٌ","وَغصنُه من مياهِ الحُسن ريّانُ",37,"ن",1,0],["إِذ واجَهته من المحرّمِ غرّةٌ","سَعدَت فأسعدنا بها المقدورُ",38,"ر",1,0],["إِذ وَردُ خَدِّكَ في الوُلوعِ بِهِ","يَزهو وَلَونُ الوَردِ يَرتَدُّ",39,"د",1,0],["إِذ وَرَدنا ورودَها فَظَللنا","نَتَهادى الرِياض ورداً وَظلّا",40,"ل",2,0],["أَذودُهُمُ عَنكُم وَأَنتُم رِئالَةٌ","شِلالاً كَما ذيدَ النِهالُ الخَوامِسُ",41,"س",1,1],["أذوب إذا رأيت يسوع يوماً","يدانُ كمجرمٍ بين الرجالِ",42,"ل",1,1],["إذ وضعها في الأصل ترجمتي وما","ألفت من كتب بفضل إلهي",43,"ي",1,0],["أذُو مالٍ فقلْتُ وذو يَسارٍ","فقالَ الأمْرَدانِ الأمرُدانِ",44,"ن",1,0],["أذوب عليك بالحزن إدّكاراً","وأشرقَ منك بالماء البراد",45,"د",1,0],["أذود عني أذى النمام مقتصراً","عنه الأحاديث لا أفضى إليه خبر",46,"ر",1,0],["أذود باليأس عن احواضهم أملا","يروى بريّ الأماني وهو عطشان",47,"ن",1,0],["أَذُو الحَظِّ من علم الكتاب حدَاك لي","أَم الفلكُ الدَّوار نحوي أَدارَكِ",48,"ك",1,0],["أَذوب أَسى ولوعات ووجداً","وأعلن بالزفير ثنى وفردا",49,"د",2,0],["أذوب كالشمع من حزن بليت به","إذا تذكرت معنى من معانيكا",50,"ك",2,0],["أذودُ بها عن سَرح عِرضك كلّما","تطلَّعَ فيه للفريسةِ سِيدُ",51,"د",1,0],["أذود الصبا عن مطمحٍ غير ماجدٍ","وأنهى الهوى عن موقف غير مكرم",52,"م",1,0],["أذوب على تلك الذوائب غيرة","إذا لاعبت أحيان ترسلها الحجلا",53,"ل",2,0],["أذوبُ شوقاً لكنّي أخو جَلَدٍ","فيه وانْ كانَ طعمُ الصَّبْرِ كالصَّبِرِ",54,"ر",1,0],["أذود بها عن الوطن المفدّى","وأحمي تونس الخضرا بلادي",55,"د",2,0],["أذوبُ لمكَّةَ الفيحاءِ حباً","لأَنَّ حبيب أهل الحالي مكي",56,"ي",1,1],["أَذوبُ له شوقاً وأَكتُمُ حالَتي","ومن عَجَبٍ أَن يعشقَ السَّيِّدَ العَبْدُ",57,"د",1,0],["إذ وافق الاسم تمسى مهدي","وهذه من الدواهي عندي",58,"ي",1,0],["إذ وافق الإسم وإذ تكنّى","بمثل ما ذكرته في المعنى",58,"ن",2,0],["أذَوي اليسار وما اليسار بنافعٍ","لمعاشرٍ قد أوذنوا بفناءِ",59,"ا",2,0],["اَذَوائِبَ الأَثلاتِ تَسحَبُها الصَّبا","فَوقَ الثَّرَى وَظٍِلالُهُنَّ غَداهُ",60,"ا",2,0],["إِذ وَقَع النَعش بِه وَالعَرَبَه","حَتّى أَصابا رَأسَهُ وَالرَقَبَه",61,"ه",1,0],["أِذُوبُ اشْتِياقاً وَالْفُؤَادُ بِحَسْرَةٍ","وَفي طَيِّ أحْشَائِي تَوَقُّدُ جَمْرَةٍ",62,"ه",1,1],["إذ وِرْدنا عذبٌ ومربع عيشنا","خِصب وحبل الشمل فيه متينُ",63,"ن",1,0],["أذَوَابِلٌ أم قَامَةٌ هيفَاءُ","وَمَنَاصلٌ أم مقلةٌ وَطْفَاءُ",64,"ا",2,1],["أَذوبُ صبابةً وجوىً وحقٌّ","لِمثلي في الصبابةِ أن يذوبا",65,"ب",2,0],["أَذوب جوىً في حبّها وودادها","وإن صرمت بالهجر حبلي تثبّتِ",66,"ت",1,0],["أذوب في صوت النفوس الحنونه","واحْيا على همسات عالين لاذْواقْ",67,"ق",1,0],["أذواقها مريرة","ونارها ذات لهب",68,"ب",1,0],["أذوب إذا ما غبتَ عني فإن دنت","دياركَ صارَ الصدُّ شرَّ رقيبِ",69,"ب",1,1],["أَذودُ لَئام الناسِ عنها وأتقي","على حَسَبي إن لم أَصُنهَا الَمعَايبا",70,"ب",2,0],["إذ وجدنا لديه من كل فجٍ","مسترادَ الغنى ومأوى الرّقاقِ",71,"ق",1,0],["اذ وفى بعد جفاءٍ ورعى","عهدَ صبٍّ دمعهُ قد وكفا",72,"ف",2,0],["اذوبُ اسىً كما شاءَ الغرامُ","شكا قلبي عذاباً يلتقيهِ",73,"ه",1,0],["أذُؤبانَ روما ليست الحرب مرقصا","بغاداته يلهو خليع ويلعب",74,"ب",1,0],["إذ وَفد وادي النيل ثَمةَ غادياً","في خير ما تغدو الوفود وترجع",75,"ع",1,0],["أذوبُ وأفنى رقةً وصبابةً","إذا ما ذكرتُ الله في السرِّ والجهر",76,"ر",1,0],["إذ ورثنا خُلق المظا","هر فينا الهاشميّ",77,"ي",1,0],["أذود الردى عن جناب الهدى","لا علم في الناس بالذائد",78,"د",1,0],["أذودُ عن القرابةِ كلَّ سوءٍ","بأرماحٍ مثقَّفَةٍ طوالِ",79,"ل",1,0],["أَذودُ العِدا عَنها وَأَقتَحِمُ الرَّدى","وَأَطفو عَلَى مَوجِ المَنايا وَأَرسُبُ",80,"ب",1,0],["أذويت عودي يا أميمة بِالجَفا","عُودي بِوَصلك لي لِيُورق عُودي",81,"د",2,0],["أذو طمع في العيش يبقى وحولَهُ","مدى الدهر أفعى لا تزالُ وعقرَبُ",82,"ب",1,0],["أَذوب لفقده والدار دان","فَمَن لي حين يحكم بالتَنائي",83,"ا",2,0],["أذوي الصلبان وراءكمو","خيل الملك الخبر الندس",84,"س",1,0],["اذوب وابلى من رسيس هواكم","وتسهر عيني والعيون هواجع",85,"ع",1,0],["إذ وجوه الخير فيه أسفرت","عن أبي هذي المعالي الجوهري",86,"ر",2,0],["أذو القلم السيال يقرعه الاذى","وذو الجهل نسر ما اليه وصول",87,"ل",1,0],["أذودُ النَّفسَ عن ليلَى وإنِّي","ليعصيني شواجرُ قد صدينا",88,"ن",2,0],["أذوق به الحياة وأجتليها","وفيها أتقى وقع النصال",89,"ل",1,0],["أذوب اشتياقاً ثم يحجب شخصه","وإنّي على ريب الزّمان لقاس",90,"س",1,1],["أذوق ما ذاقوا اسلافي","من العلوم اللدنيه",91,"ي",2,0],["أَذُوبُ لَها شَوقاً وَإِن لَم أُلاقِها","وَلَكِنّ أَوطاري لَدَيها وَأَوطانِي",92,"ن",2,0],["أذوب من الهوى وتذوب لطفاً","كمثل القند في الماء القراح",93,"ح",1,0],["إذ وائلٌ لا حي يعدلهم","في الناس، من عربٍ، ومن عجمِ",94,"م",1,0],["آذوه في آله وأحرقوا دمهم","وما عدا كل هذا شأنه شانوا",95,"ن",3,0],["أَذود القَوافيَ عَني ذيادا","ذيادَ غلامٍ جَرىءٍ جَوادا",96,"د",2,1],["إذ واعدهم بالطور الأي","من عند الشجر المبرور",97,"ر",1,0],["أَذوبُ عَلى جمرَيْ غَرامٍ وَفُرقةِ","وَ