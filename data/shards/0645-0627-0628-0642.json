{"poems":[[55,"كان قضاء الإله مكتوبا","https://www.aldiwan.net/poem30741.html","المنسرح"],[95,"شوقي نزيلٌ بكل قلبٍ","https://www.aldiwan.net/poem9837.html","مخلع البسيط"],[85,"لو تروا حب ما اجمل","https://www.aldiwan.net/poem54199.html","الخفيف"],[51,"قل لليل والنهار اكتراثي","https://www.aldiwan.net/poem62019.html","الخفيف"],[51,"شدة الحرص ما علمت وضاعه","https://www.aldiwan.net/poem62170.html","الكامل"],[51,"لن تقوم الدنيا بمر الأهله","https://www.aldiwan.net/poem63098.html","الخفيف"],[68,"يا بدورا تغيب تحت التراب","https://www.aldiwan.net/poem40292.html","الخفيف"],[99,"أمل ضائع ولب مشرد","https://www.aldiwan.net/poem24804.html","الخفيف"],[99,"السراب الخؤون والصحراء","https://www.aldiwan.net/poem24994.html","الخفيف"],[48,"كأنما دنياك وحشية","https://www.aldiwan.net/poem23002.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54917","الخفيف"],[133,"حدث الشاعر عن نور القمر","https://www.aldiwan.net/poem60382.html","الرمل"],[385,"دعك من نهي النهاة","https://www.aldiwan.net/poem48799.html","مجزوء الرمل"],[385,"أخلق الدار بالعقيق الدثور","https://www.aldiwan.net/poem49208.html","الخفيف"],[396,"خذ من الوقت ما سمح","https://www.aldiwan.net/poem54594.html","عموديه"],[409,"الحمامة إن أثارت بالهديل","https://www.aldiwan.net/poem32903.html","الرمل"],[409,"هل ينال القلب ما طلبا","https://www.aldiwan.net/poem34147.html","المديد"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2418","الخفيف"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122327","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64108","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62532","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62635","الرمل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16981","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79804","السريع"],[1680,"","https://poetry.dctabudhabi.ae/diwan/poem/81896","الخفيف"],[1840,"","https://poetry.dctabudhabi.ae/diwan/poem/216660",""],[2684,"","https://poetry.dctabudhabi.ae/diwan/poem/131452",""],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65450","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132637","السريع"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138657",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92026","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91874","المتقارب"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119602","الرجز"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97091","الخفيف"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133104","الرجز"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76695","السريع"],[4612,"","https://poetry.dctabudhabi.ae/diwan/poem/111234","الخفيف"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35100","الخفيف"],[4708,"صرخة غضب","https://www.poetsgate.com/ViewPoem.aspx?id=12191",""],[4728,"ما بقى من نار امس جمرة","https://www.poetsgate.com/ViewPoem.aspx?id=176972",""],[4728,"قال مشتاق لقصيدك","https://www.poetsgate.com/ViewPoem.aspx?id=179712",""],[4748,"شاطي العذاب","https://www.poetsgate.com/ViewPoem.aspx?id=4603",""],[4764,"غابت شموسك والأماني تحتريك","https://www.poetsgate.com/ViewPoem.aspx?id=25982",""],[4764,"شفوف الهاويه","https://www.poetsgate.com/ViewPoem.aspx?id=34132",""],[4988,"حلم وأماني","https://www.poetsgate.com/ViewPoem.aspx?id=198223",""],[5072,"زمن","https://www.poetsgate.com/ViewPoem.aspx?id=34351",""],[5122,"((( لمّا )))","https://www.poetsgate.com/ViewPoem.aspx?id=24718",""],[5277,"معارضة داليّة الحصري القيرواني","https://www.poetsgate.com/ViewPoem.aspx?id=198895",""],[5341,"أقرب لتلويحة قصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=185352",""],[5442,"اشرفت في السواد ذات الثور","https://www.poetsgate.com/ViewPoem.aspx?id=114768",""],[5442,"ليس بعد السبعين إلا الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=114787",""],[5461,"لايطول غيابك","https://www.poetsgate.com/ViewPoem.aspx?id=27709",""],[5461,"يزحف الموت","https://www.poetsgate.com/ViewPoem.aspx?id=5305",""],[5463,"ألف ونّه وسط قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=25292",""],[5463,"آآه يا حالي عليها","https://www.poetsgate.com/ViewPoem.aspx?id=31732",""],[5480,"بت ساهد","https://www.poetsgate.com/ViewPoem.aspx?id=4104",""],[5525,"البتول","https://www.poetsgate.com/ViewPoem.aspx?id=878",""],[5525,"ما بقى لي قلب","https://www.poetsgate.com/ViewPoem.aspx?id=7297",""],[5526,"مفردات الانعدام","https://www.poetsgate.com/ViewPoem.aspx?id=192429",""],[5582,"أَتِلْكَ لِلحَيِّ أَحْداجٌ وَأَظْعانُ","https://www.poetsgate.com/ViewPoem.aspx?id=63592",""],[5606,"سوق التداول كلما ينتفض طاح","https://www.poetsgate.com/ViewPoem.aspx?id=199201",""],[5694,"غرامي","https://www.poetsgate.com/ViewPoem.aspx?id=132097",""],[5739,"مضيق الموق ..!","https://www.poetsgate.com/ViewPoem.aspx?id=135077",""],[5756,"الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=5184",""],[5848,"تنطفي نجمه","https://www.poetsgate.com/ViewPoem.aspx?id=53175",""],[5848,"بقايا حلم","https://www.poetsgate.com/ViewPoem.aspx?id=53157",""],[5848,"القصيد وذكرياتي","https://www.poetsgate.com/ViewPoem.aspx?id=50628",""],[5848,"رباعيات","https://www.poetsgate.com/ViewPoem.aspx?id=48997",""],[5950,"حكاوي","https://www.poetsgate.com/ViewPoem.aspx?id=126265",""],[5970,"ما بقائي في العيش بعد الذي بي","https://www.poetsgate.com/ViewPoem.aspx?id=130636",""],[6102,"رسالة إلى \"موديل\" ...","https://www.poetsgate.com/ViewPoem.aspx?id=184870",""],[6115,"معكازي رفيقي","https://www.poetsgate.com/ViewPoem.aspx?id=180537",""]],"verses":[["ما بَقِيَت كَفُّكَ الصَناعُ لَنا","فَكُلُّ كَسرٍ يَكونُ مَرؤوبا",0,"ب",2,0],["ما بقي الشعر فهو باقٍ","كأن فقدانه وجود",1,"د",1,0],["ما بقى من غير طلول","وذبل قلب كاشعل",2,"ل",1,0],["ما بَقائي عَلى اِختِرامِ اللَيالي","وَدَبيبِ الساعاتِ بِالأَحداثِ",3,"ث",1,0],["ما بَقاءُ الدُنيا وَساعاتَها تَح","فِزُها بِالحَوادِثِ الفَجّاعَه",4,"ع",2,0],["ما بَقاءُ الإِخاءِ مِن مُتَجَنٍّ","يَبتَغي مِنكَ عَلَّةً بَعدَ عِلَّه",5,"ل",2,0],["ما بَقائي مِن بَعدِ فَقدِكَ إِلّا","كَبَقاءِ الرِياضِ بَعدَ السَحابِ",6,"ب",1,0],["ما بقائي أرى اطِّراد فنائي","وانتهائي في صورةٍ تتجدّد",7,"د",1,0],["ما بقائي وأجمل العمر ولّى","وانتظاري حتى يحين الشتاء",8,"ا",2,0],["ما بَقِيَ الواحِدُ مِن أَلفِها","بَل هُوَ مِن سِتَّةِ آلافِها",9,"ف",3,0],["مَا بَقائِي بَعْدَ الأَحِبَّاءِ إِلاَّ","كَمُقامِ الغَرِيبِ فِي دَارِ أَسْرِ",10,"ر",1,0],["ما بَقى من عِزٍّ أجدادٍ لهم","غيرُ ذِكرى مَن غَدا ضِمن الحُفَر",11,"ر",1,0],["ما بَقِيَ مني إِذ أَعرَضت","عَني يا حَياتي",12,"ت",2,0],["ما بَقِيَ مِنهُمُ عَلى شَعب الأَكوار","إِلّا دُموعَهُم وَالزَفيرُ",13,"ر",1,0],["ما بقى قط دابة","هكذا قد أتى وصح",14,"ح",1,0],["ما بقي في الناس من يزرع جميل","نحو بابه يحملوني",15,"ي",1,0],["ما بقلبي منكم ويكون","هجركم فيه هو السبب",16,"ب",1,0],["ما بَقا في البِلادِ عودٌ نَضيرٌ","في أَراكٍ أَو في سَلامٍ وَغافِ",17,"ف",1,0],["ما بقى في الانام والحمد لل","هِ مريض الّا الجفون السقام",18,"م",1,0],["ما بقائي من بعدِهِ ما بقائي","كل باقٍ على الأسى غير باق",19,"ق",1,0],["ما بقينا فعلى الحق وإن","نَقْضِ أحسنّا به المنقلبا",20,"ب",2,0],["ما بقاءُ الحجَر الصَّلْ","دِ بكرّات المعَاول",21,"ل",1,0],["ما بَقاءُ الحَجَرِ الصَلدِ","عَلى وَقعِ المَعاوِل",22,"ل",1,0],["ما بقيت فيكِ لمُستنهِضٍ","بقيَّةٌ للسيف تُدمي شَبا",23,"ب",2,0],["مَا بَقَى لِي حَبيبُ قَلْبِ سِوَاكُمْ","مَاتَ وَهْمِي بِكُمْ وَبَانَ خَيَالِي",24,"ل",2,0],["مَا بقى لَي قَلْب يتحمل جفاك","كِلّ مَا أبعدت يتولَّهْ عَلَيْك",25,"ك",1,1],["ما بقي لي حبيبيا ولا خلا يجاب","أوحشوني وقد كنت مرتاح",26,"ح",1,0],["ما بقبق الكوزُ إلا من تألّمه","يشكو إلى الماء ما قسى من النّار",27,"ر",1,1],["ما بقيت بعدك لي لذة","حتى على النغمة والكاس",28,"س",1,0],["ما بقعة الا اريق بها دمٌ","للمصطفين وعفرت أجسامها",29,"م",3,0],["ما بقى من أَتى فتطمع في الخل","دِ وَفكر أَباءنا وَالجُدود",30,"د",1,0],["ما بقي من لذة ما يُصطفَى","غَير شغل بفنون الأَدب",31,"ب",1,0],["ما بقي الإسلام في ظهور","كذا مدى الأحقاب والدهور",32,"ر",1,0],["ما بقي من رجالها الغلب إلا","من على جوده الوجود عيال",33,"ل",1,0],["ما بقي إلا انتظار ساعةِ","قد بدت أشراطها فيكم كفاح",34,"ح",1,0],["ما بقيت فيّ سوى نظرة","واقعة باطنُها من صلاح",35,"ح",1,0],["ما بقلبي للغانيات محل","لا ولا للهوى علي عهود",36,"د",1,0],["ما بِقَلبي حَوَتهُ مِنهُ ضُلوعي","كَالرَجاءِ اِنطَوى وَفيهِ شَرارَه",37,"ر",2,0],["ما بقت فيهم فضيلة ولا من الأخلاق شيا","افقدوا روح المبادي والحضارة المعنوية",38,"ي",2,0],["ما بقى يا بنت من نار امس جمرة","ودي بحضنك عن البرد اتدثّر",39,"ر",1,1],["ما بقى بعدك ركن هادي ولا شعرٍ جزل","وان ذكرتك قلت لي كم بيت فيك من الرصيد",40,"د",1,0],["ما بقالي قلب يدرك للصواب","تعصف بفكري متاهات الدروب",41,"ب",1,0],["مَا بَقى غَير أبتِهِل .. وأبقى عَليك","واللِقا بيني وبينه .. ألفِ باب",42,"ب",1,0],["ما بقى فيني مكانٍ يحتمل منه ضروب","للعنا ما عدت اقوى/ للجنون امخاويه",43,"و",3,0],["ما بقى للقول معنى ما بقى الا الهروب","يوم مالي بالأماني ولا دموعي / قاويه",43,"و",3,0],["ما بقى لي غير ذكرى مع بقايا من صروح","وانقشع حلم وأمآني في سجل المستحيل",44,"ل",1,0],["ما بقائي وقدْ أُهينَ الكبارُ","سوفَ أحدو قوافلي حيث ساروا",45,"ر",3,1],["مابقالي جلاده تحتمل ريثما","تنتظر في قرار لمقبلات السنين",46,"ن",1,0],["ما بَقيتْ لِلحرفِ مَعانٍ","اوتادُ العُجمةِ توئِدُهُ",47,"د",2,0],["ما بقى للعُمْر من شمعٍ نقيده","لا أماني/ لا مواعيد وْرفاق",48,"ق",1,0],["ما بقي في عصا بقائي سير","ضاق فتر في مدتي عن مسيري",49,"ر",2,0],["ما بقي في الزمان فسحة أمها","فجعل فقد مضى التأجيل",50,"ل",1,0],["مابقي بالعمر مقدر ماراح فيه","كل مازل يومٍ يوم بالعمر ولى",51,"ل",2,0],["ما بقى لك على الباطل نصير","شف تبيعك تنكّر وانقلب",52,"ب",1,0],["ما بقت أفراح فيني ولا بقت فيني سعاده","كل ما فيني [ دموع ] تهل من عيني حزينه",53,"ن",2,1],["ما بقالي في حياتي أي سعاده ما بقالي","غير دمعه وأحتريك ِ بكف إيدك تمسحيها",54,"ي",3,0],["ما بقى فالحال تحليلي","انهدم لي كنت باننه",55,"ن",2,0],["مابقى في ضلوعي كود ريح معمول","وثوب شاشٍ عليه من الندامه وحل",56,"ل",1,0],["ما بقالي قلب يشفع لك خطيّه","ذوبته اجروح صدّك والخطايا",57,"ا",3,1],["مابقى أرجو السموحه ماابوحه .. والسلام","كل شاعر لانظم محكوم باعراف وحدود",58,"د",1,0],["ما بُقْعَةٌ مِنْ بِقاعِ الأَرْضِ أَجْمَعِها","فِيها يَكُونانِ إِلاَّ وَهيَ خَفّانُ",59,"ن",1,0],["مابقي فيه إلاكوابيس وأشباح","والا غراب البين ينعق نذيره",60,"ر",2,0],["مابقى لهل الهوى قلبٍ عطوف","وينكم ياهل الهوى ، صفوا صفوف",61,"ف",1,0],["مابقى بالقلب من كثر الشجن.","غير تغريدة أمل ..! في فم وينه.؟",62,"ن",2,0],["مابقى الا سود الايام تحرمك الرقاد","كيف الاوهام اتجرأ اتسريك مغبون",63,"ن",1,1],["ما بقى بي غير كرهي للتنافر","واحترامي لي وتشتيت الضغينه",64,"ن",2,0],["مابقى للحياة فنظرتي مطمع","وين انا وانت ؟ والا حضنك الدافي !!",65,"ف",2,0],["ما بقى للعمر معنى دام الاحلام استخارت","والسنين الموغلة بالحزن تكتب لي وصاتي",66,"ت",2,0],["ما بقى عرقٍ بقلبي ما تجمّد","ولا لي الا افرك من الحسرات يدّي",67,"ي",1,0],["مابقى تمر لو هزيّت عذق النخيل","إقطفتها السنين وماتت آمالها",68,"ل",3,0],["ما بقائي في العيش بعد الذي بي","أأقضي الحياة في تعذيب",69,"ب",1,1],["ما بِقَلبِي؛ وَإِنَّما بِلِسانِي","قُلتُ ما قُلتُ؛ خائِنًا وِجدانِي",70,"ن",2,1],["مابقا بيدي ربط ولا حلي","يا زمان اظهرت خافي عذاريبي",71,"ب",2,0]]}