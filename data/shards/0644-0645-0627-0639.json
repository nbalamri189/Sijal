{"poems":[[57,"لما عفوت ولم أحقد على أحد","https://www.aldiwan.net/poem24721.html","البسيط"],[77,"حنت لخضر ربي وزرق مياه","https://www.aldiwan.net/poem35858.html","الكامل"],[77,"أدارهم بين الأجارع فالسدر","https://www.aldiwan.net/poem36515.html","الطويل"],[77,"قال لي صاحبي وقد بان زهدي","https://www.aldiwan.net/poem36578.html","الخفيف"],[77,"هب النسيم معطر الأراج","https://www.aldiwan.net/poem36664.html","الكامل"],[77,"لم أعد الحسام من أدواتي","https://www.aldiwan.net/poem36685.html","الخفيف"],[77,"لما علاني الشيب قال صواحبي","https://www.aldiwan.net/poem36708.html","الكامل"],[86,"ببابك النحس والسعود","https://www.aldiwan.net/poem68833.html","مخلع البسيط"],[71,"مثلي وقد وافيت أطلب رفدكم","https://www.aldiwan.net/poem3909.html","الكامل"],[41,"يا روضة الوضاح قد","https://www.aldiwan.net/poem42348.html","مجزوء الكامل"],[37,"انصرم الحبل حبل البيض أم تصل","https://www.aldiwan.net/poem7313.html","البسيط"],[47,"الشعر ديوان العرب","https://www.aldiwan.net/poem25378.html","مجزوء الكامل"],[51,"أحمد الله مبدئا ومعيدا","https://www.aldiwan.net/poem8322.html","الخفيف"],[91,"سيرت في فجر الحياة سفينتي","https://www.aldiwan.net/poem62730.html","عموديه"],[89,"حال بيني وبين شكري التراب","https://www.aldiwan.net/poem44618.html","الخفيف"],[89,"أذكى تعصب ثلة جهال","https://www.aldiwan.net/poem44909.html","الكامل"],[85,"أسخطت جدى الشاذلي","https://www.aldiwan.net/poem7288.html","مجزوء الكامل"],[85,"اليوم أصعد دون قبرك منبرا","https://www.aldiwan.net/poem62866.html","الكامل"],[43,"وشادن روح من يهواه في يده","https://www.aldiwan.net/poem9560.html","البسيط"],[45,"كفي الملامة أو دومي على العذل","https://www.aldiwan.net/poem65639.html","البسيط"],[28,"وإذا عددت بني كليب لم تجد","https://www.aldiwan.net/poem5482.html","الكامل"],[66,"لا زال ظلك للعفاة ظليلا","https://www.aldiwan.net/poem38745.html","الكامل"],[44,"بسطت إلي بنانة أسروعا","https://www.aldiwan.net/poem30022.html","الكامل"],[44,"خلاص","https://www.aldiwan.net/poem30225.html","الخفيف"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[105,"صونوا الذمام فإن الحر من صانا","https://www.aldiwan.net/poem42047.html","البسيط"],[52,"لما علمت بدأت بالهجر","https://www.aldiwan.net/poem27041.html","الكامل"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[67,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[50,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[76,"لما عدمت مؤانسا وجليسا","https://www.aldiwan.net/poem39284.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39586","الخفيف"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9495","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54281","الكامل"],[67,"وكتابُ شعيا مخبرٌ عن ربهِ","https://www.poetsgate.com/ViewPoem.aspx?id=14561",""],[90,"عقابيل داء","https://www.poetsgate.com/ViewPoem.aspx?id=179142",""],[99,"قطرة الندى","https://www.poetsgate.com/ViewPoem.aspx?id=570",""],[122,"ما قهوة البن إن قيست بصافية","https://www.aldiwan.net/poem23759.html","البسيط"],[141,"ما في المعالي علي منك يعتصم","https://www.aldiwan.net/poem11822.html","الطويل"],[165,"واحة الوجه","https://www.aldiwan.net/poem1035.html",""],[176,"لعل وعسى","https://www.aldiwan.net/poem50717.html","الرمل"],[183,"بكم آل وحي الله يفتخر المجد","https://www.aldiwan.net/poem14508.html","الطويل"],[184,"دنياي شر كلها","https://www.aldiwan.net/poem43835.html","مجزوء الكامل"],[187,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[209,"أين قلبي وأين آثار قلبي","https://www.aldiwan.net/poem46575.html","الخفيف"],[209,"شاعر البحر إلى البحر يعود","https://www.aldiwan.net/poem46604.html","الرمل"],[229,"خذ للحجاز إذا مررت بركبه","https://www.aldiwan.net/poem44598.html","الكامل"],[233,"أهلا بطلعة زائر","https://www.aldiwan.net/poem31608.html","مجزوء الكامل"],[249,"درة العشاق","https://www.aldiwan.net/poem65127.html","عموديه"],[252,"أعلنت ضعفي","https://www.aldiwan.net/poem24946.html","مجزوء الرمل"],[252,"قلب معذب","https://www.aldiwan.net/poem36216.html","مجزوء الرمل"],[268,"إن الجمال به عزاء الأنفس","https://www.aldiwan.net/poem35666.html","الكامل"],[278,"أظن الدهر جاءك مستثيرا","https://www.aldiwan.net/poem60698.html","الوافر"],[288,"يا جارتا رحماك في دنف","https://www.aldiwan.net/poem11659.html","أحذ الكامل"],[302,"طالت لياليك والأيام يا صاحي","https://www.aldiwan.net/poem16897.html","البسيط"],[318,"ما لي أرى غصن الهنا","https://www.aldiwan.net/poem67127.html","مجزوء الكامل"],[326,"يا حبيبي ملأ الفجر لنا كاسا","https://www.aldiwan.net/poem54928.html","مجزوء الرمل"],[369,"بعض بنات الزمن","https://www.aldiwan.net/poem57080.html","مجزوء الرجز"],[369,"هل هائم دنف كما أنا هائم","https://www.aldiwan.net/poem57114.html","الكامل"],[369,"شيم يلوح على مكارمها الشرف","https://www.aldiwan.net/poem57297.html","الكامل"],[402,"لو ارتاح الزمان إلى عتابي","https://www.aldiwan.net/poem50072.html","الوافر"],[403,"عبسن من شعر في الرأس مبتسم","https://www.aldiwan.net/poem50128.html","البسيط"],[403,"إن كنت تصدق في ادعاء وداده","https://www.aldiwan.net/poem50188.html","الكامل"],[406,"لا تفسدن نصيحتي بشقاق","https://www.aldiwan.net/poem32258.html","الكامل"],[413,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[418,"لما عنك غبنا ذاك العام فإننا","https://www.aldiwan.net/poem46396.html","الطويل"],[429,"ولقد رأيت البدر وهو كغرة","https://www.aldiwan.net/poem12732.html","الكامل"],[438,"أيا شارباً كأس خمر الرقاد","https://www.aldiwan.net/poem14364.html","المتقارب"],[446,"لما علمت بما ألقى من الوصب","https://www.aldiwan.net/poem53774.html","الطويل"],[477,"لله كل يرجع","https://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[480,"عرج أخي حمى ليلى ومنعرج","https://www.aldiwan.net/poem24331.html","عموديه"],[502,"ما لي إلى وصل الحبيب سبيل","https://www.aldiwan.net/poem38410.html","الكامل"],[512,"لما على وجنته نثر الحسن أوراق","https://www.aldiwan.net/poem20925.html","المواليا"],[513,"ما كل سجع بمعدود من الخطب","https://www.aldiwan.net/poem12020.html","البسيط"],[513,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[513,"رمى بنا الثغر كما ترمى الثغر","https://www.aldiwan.net/poem12162.html","الرجز"],[513,"لما أدار مدامة الأحداق","https://www.aldiwan.net/poem12187.html","الكامل"],[549,"ألا قل للوزير مقال مثن","https://www.aldiwan.net/poem47206.html","الوافر"],[549,"خيالك يا أميمة كيف زارا","https://www.aldiwan.net/poem47801.html","الوافر"],[551,"وصاحب لم يخيرني المنى أملا","https://www.aldiwan.net/poem68422.html","البسيط"],[556,"أحبني وأنا المعدوم في ذاتي","https://www.aldiwan.net/poem34699.html","المواليا"],[559,"يا رب إن أخطأت أو نسيت","https://www.aldiwan.net/poem27865.html","الرجز"],[573,"رأيت طرفك يوم البين حين همى","https://www.aldiwan.net/poem3020.html","البسيط"],[584,"لما عتبت فلانا حين وليته كذا","https://www.aldiwan.net/poem17555.html","الكامل"]],"verses":[["لَمّا عَفَوتُ وَلَم أَحقِد عَلى أَحَدٍ","أَرَحتُ نَفسي مِن هَمِّ العَداواتِ",0,"ت",1,1],["لمّا عرَفْتُكَ ما شككْتُ بأنّهُ","تَثْرَى يَدا أمَلي ويُعْظَمُ جاهِي",1,"ي",1,0],["لمّا عرَفوا منّي المَكانَ ولا بدَتْ","مُثولُ طُلولٍ فوْقَ كُثْبانيَ العُفْرِ",2,"ر",1,0],["لِمَ أعْرَضْتَ واسْتَهَنْتَ بهَذا","قلتُ أغْناني الغَنيُّ الحَميدُ",3,"د",1,0],["لمّا عَلِمْتُ مَكانَها وزَمانَها","أعْمَلْتُ في لَيْلِ السُّرَى إدْلاجي",4,"ي",1,0],["لَمْ أعُدَّ الحُسامَ منْ أدَواتِي","حَسْبُ نَفسي يَراعَتي ودَواتِي",5,"ي",1,1],["لَمَّا عَلاَنِي الشَّيْبُ قَالَ صَوَاحِبِي","لاَ نَبْتَغِي خِلاًّ يُصَيَّرُ أَشْيَبْ",6,"ب",1,1],["لَمّا عَلَت صَيحَةُ المُنادي","وَأَصبَحَ القَومُ في عَناء",7,"ا",2,0],["لَم أَعشُ عَن ذِكرِ الإِلهِ فَلَيتَني","أَدري عَلامَ قُرِنتُ بِالشَيطانِ",8,"ن",1,0],["لَم أَعدُ رَوضَةَ وَالَّذي","سَاقَ الحَجِيجُ لَهُ البُدنُ",9,"ن",1,0],["لما عبأت لقوس المجد أسهمها","حين الجدود عن الأحساب تنتضلُ",10,"ل",1,0],["لَم أَعدُ فيهِ مَفاخِري","وَمَديحَ آبائي النُجُب",11,"ب",1,0],["لم أعانِدْ به الطريقَ ولا أضْ","حى لدين المعاندينَ نسيبا",12,"ب",2,0],["لَمّا عَصاني أَن أُشِبَّ ضَرامَها","أَعيا عَلَيها أَن تَشِبَّ ضَرامي",13,"ي",1,0],["لم أعب منه خلة في حياتي","ولقد قل صاحب لا يعاب",14,"ب",1,0],["لما عتا دهري وددت زواله","وزواله لو صح فيه زوالي",15,"ي",1,0],["لما عجلت أضعته","يا ليتني لم أعجل",16,"ل",1,0],["لَم أُعطَ عَنكَ تَصَبُّراً وَأَنا الَّذي","عَزَّيتُ فيكَ عَنِ الأَميرِ المَعشَرا",17,"ر",2,0],["لَم أَعرِفِ الخَيرَ إِلّا مُذ عَرَفتُ فَتىً","لَم يولَدِ الجودُ إِلّا عِندَ مَولِدِهِ",18,"د",2,0],["لَمّا عَفَت جَدَّدَت شَوقي فَجَدَّدَها","دَمعٌ تَرَقرَقَ مِن جارٍ وَمُنهَمِلِ",19,"ل",1,0],["لَمّا عَرَفنَ وُجوهَنا وَتَحَدَّرَت","عَبَراتُ أَعيُنِهِنَّ بِالإِسبالِ",20,"ل",1,0],["لَمّا عَرَضتُ عَلى عُلاكَ لِذِكرِهِ","طَرفاً وَصادَفَ مِن نَداكَ قَبولا",21,"ل",2,0],["لَمّا عَدِمتُ نَوالَهُ أَعدَمتُهُ","شُكري فَرُحنا مُعدَمَينِ جَميعا",22,"ع",2,0],["لِمَ أَعرَضتَ إِذ تَقَنَّصتُ لَحظاً","مِنكَ سِرّاً وَأَنتَ لي قَنّاصُ",23,"ص",1,0],["لم أعْدُ أبوابَ ستينٍ، وأحسبني","هِمَّاً وقفتُ على أبواب تسعين",24,"ن",1,0],["لمّا عطفتم على القُرآنِ من نُسُكٍ","تدفَّقتْ جَنَباتُ النِّيل قُرآنا",25,"ن",2,0],["لَمّا عَلِمتَ بَدَأتَ بِالهَجرِ","وَرَمَيتَني مِن حَيثُ لا أَدري",26,"ي",1,1],["لَمَّا عَلِمْتَ بأنَّ الرِّفْقَ أَبْطَرَهمْ","والمُفْسِدُون إذا أَكْرَمْتَهُمْ بَطِرُوا",27,"ر",3,0],["لَمْ أُعْطِ ما أَعْطَيْتُهُ أَحَداً مِنَ ال","فَضْلِ العظيمِ وحَسْبُهُ تَخْوِيلا",28,"ل",2,0],["لَمَّا عَمِلْتَ بما عَلِمْتَ مُراقباً","للهِ في الإِقدامِ والإحْجامِ",29,"م",1,0],["لَمّا عَرَفناها جَرى دَمعُهُ","ما بَعدَ دَمعِ العانِسِ الأَشيَبِ",30,"ب",1,0],["لمّا عدِمتُ مُؤَانِساً وَجَليسا","نَادَمتُ بُقراطاً وجالينوسا",31,"س",2,1],["لم أعُدْ ذلك القويَّ فأحمي","هِ من الويلِ والبلاءِ المحيقِ",32,"ق",1,0],["لَم أَعرِفِ الإِصباحَ في ضَوإِهِ","لَمّا بَدا إِلّا بِسُكرِ النَديم",33,"م",1,0],["لمّا عَلَوتَ مَطَاهُ صَفَّقَ مَوجه","بِشْراً وأَسْكَتَ وَجْدَه برُغَائه",34,"ا",3,0],["لَمْ أُعْطِ ما أعْطَيْتُهُ أَحَداً مِنَ","فضلِ العظيمِ وحسبهُ تخويلا",35,"ل",2,0],["لما عَبِثَتْ فيه أكُفٌّ جَذيمةٌ","ولمْ يَعُلهُ هذا الهجينُ المهلَّب",36,"ب",1,0],["لم أعد داريا ألى اين أذهب","كل يوم أحس أنك أقرب",37,"ب",1,1],["لما عرفتم له رسماً ولا طللاً","ولم يكن اسمه أهلاً لتدوين",38,"ن",1,0],["لَمّا عَتَوا مَنَعَ الإِنعامَ واهِبُهُ","فَمُذ عَنَوا بَذَلَ الإِنعامَ مُنتَقِمُ",39,"م",1,0],["لمْ أعدْ أذكرُ كم مرَّ على","ناظري حسنٌ لمرقاه ُ حريّا",40,"ي",2,0],["لم أعُد تيهاً يباريهِ الضَّنَى","في فتونِ العينِ عِشقي قد رَسا",41,"س",2,0],["لَما عاش من أحياءِ سِنْبِسَ واحدٌ","ولو عاش أفنى عمَره القيد والقِدّ",42,"د",1,0],["لمّا عرضت لوصلها","تاهت عليّ فتهت أكثر",43,"ر",1,0],["لِما عَلِموهُ مِن تبلُّجِ دينهِ","فَلا أحدٌ إلّا يراهُ هو الأحرى",44,"ر",2,0],["لم أعد شاكياً فمات أنيني","لم أعد باكياً فمات نحيبي",45,"ي",1,0],["لم أعد أذكر والدنيا صروف","غير أوهامٍ سوار وطيوف",46,"ف",1,0],["لما علا عن مشبه مختاره","أضحى وليس لفضله من مشبه",47,"ب",2,0],["لَمّا عَلَوتَ سَريرَها","وَسَحَبتَ فَضلَ رِدائِها",48,"ا",3,0],["لمّا عرفت حبيب ربّي المصطفى","صارت صلاتي عدّتي وبراقي",49,"ي",1,0],["لم أعدْ نبعاً لصبر ٍ","من ذهولي كَلَّ رَجْفي",50,"ف",2,0],["لم أعدْ أرضي فؤاداً","واهناً بالحب ناء",51,"ا",2,0],["لمّا عرضتُ لها زكاةَ جمالِها","قالت أما أبصرتَ من في المجلِس",52,"س",1,0],["لَما عَزَّيْتُ قَلْبَكَ عَنْ حَبِيبٍ","وَكُنْتُ بِأَنْ أُحَرِّقَهُ بَصِيرا",53,"ر",2,0],["لما عرفتك والهوى قدر","أضحى خيالك في الدجا شغلي",54,"ي",1,0],["لما عصوا ربهم ذا البطش أسكنهم","دار البوار ومأوى كل مجتاح",55,"ح",1,0],["لَمّا عَلِمتُ بِهِ أَنا","وَاللَهُ حَقّاً راقَني",56,"ن",2,0],["لم أعد أملك إلا ذكرياتي","ودموعي وبقايا من أماني",57,"ي",1,0],["لمَّا عَلمتُ أنَّ ما","بي ما بهِ أطمَعَني",58,"ي",1,0],["لمَّا عزَمتُ عَليهِ أعلَمني الهَوى","أنِّي عَلى خَوضِ المَنيَّةِ عازِمُ",59,"م",1,0],["لمَّا عَلَت سِنِّي عَلَت سنُّ النَّدى","فخشِيتُ يَشمَلُني وإِيَّاهُ الخَرَف",60,"ف",1,0],["لما عاتبْتُهُ إلاَّ على ما","أغارَ عَليَّ من شَرخِ الشَّبابِ",61,"ب",1,0],["لَمّا علوت غَمرت العالمينَ نَدىً","وَالمزن يَعلو فَيَروي الأَرض بِالديمِ",62,"م",1,0],["لَمّا علوت الناس جدت عَلَيهم","وَالطود يَقذِف ماءه لوهادِهِ",63,"د",2,0],["لمّا علمتُ بعَجْزِهِ عن نَظمِ ما","يُنهِي إليكَ وذاكَ باستحقاقِ",64,"ق",1,0],["لما عليه عرضت أسئلة","وردّها إلى معاليه أتى",65,"ا",