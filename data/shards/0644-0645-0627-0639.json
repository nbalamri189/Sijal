ViewPoem.aspx?id=198052",""],[5135,"يا صفي الروح","https://www.poetsgate.com/ViewPoem.aspx?id=202016",""],[1420,"لما عظمت فليس مصر واسعي","https://www.poetsgate.com/ViewPoem.aspx?id=87638",""],[5145,"يا صاحبي مضى عنا الغرام مضا","https://www.poetsgate.com/ViewPoem.aspx?id=108197",""],[5190,"انشطار","https://www.poetsgate.com/ViewPoem.aspx?id=160934",""],[5206,"نور الله","https://www.poetsgate.com/ViewPoem.aspx?id=187361",""],[5277,"رسالة منها...","https://www.poetsgate.com/ViewPoem.aspx?id=190741",""],[5277,"أميرتي","https://www.poetsgate.com/ViewPoem.aspx?id=192119",""],[5277,"لولا ولمّا","https://www.poetsgate.com/ViewPoem.aspx?id=206223",""],[5284,"غيث الاشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=191798",""],[5324,"وجع ليلي.","https://www.poetsgate.com/ViewPoem.aspx?id=211466",""],[5363,"رثاء أبي","https://www.poetsgate.com/ViewPoem.aspx?id=199951",""],[5425,"لم أَعتَذِر","https://www.poetsgate.com/ViewPoem.aspx?id=207507",""],[5431,"تبارك الله أحسن الخالقين...","https://www.poetsgate.com/ViewPoem.aspx?id=203151",""],[5533,"ناجَيْتُ طَيْفَك","https://www.poetsgate.com/ViewPoem.aspx?id=185819",""],[5550,"وردةٌ أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=213309",""],[194,"ما بالُ عَينٍ شَوقُها استَبكاها","https://www.poetsgate.com/ViewPoem.aspx?id=51514",""],[5605,"حميمية لقاء..","https://www.poetsgate.com/ViewPoem.aspx?id=159461",""],[5628,"عيناك مرفئي","https://www.poetsgate.com/ViewPoem.aspx?id=179812",""],[5628,"الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=179817",""],[5660,"الجُرذُ الصَّغير","https://www.poetsgate.com/ViewPoem.aspx?id=25128",""],[5741,"لك طرفُ طرفٍ حمى من حسنك السرحه","https://www.poetsgate.com/ViewPoem.aspx?id=187440",""],[5776,"إليهم... هم","https://www.poetsgate.com/ViewPoem.aspx?id=199538",""],[5829,"زادني الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=164996",""],[5830,"هَلْ كَنْتُ جُرْماً","https://www.poetsgate.com/ViewPoem.aspx?id=200766",""],[5842,"دمشق .. بكّاؤوك كاذبون كاذبون ! .","https://www.poetsgate.com/ViewPoem.aspx?id=146614",""],[5854,"أمن تكاثر إشراك بذا الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=191752",""],[5906,"مَرَّ بي","https://www.poetsgate.com/ViewPoem.aspx?id=188228",""],[5956,"صحوةُ غرام","https://www.poetsgate.com/ViewPoem.aspx?id=185064",""],[5956,"يوم التقائك","https://www.poetsgate.com/ViewPoem.aspx?id=192932",""],[5956,"ما يضرّ اْبنَ النّشامى؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=193428",""],[5956,"هل يا تُرى هدفي بكل حياتي؟","https://www.poetsgate.com/ViewPoem.aspx?id=194708",""],[5956,"لم أعد أملك حباً مستجداً لبلادك","https://www.poetsgate.com/ViewPoem.aspx?id=213431",""],[6043,"مرثيّة الأرض العالقة","https://www.poetsgate.com/ViewPoem.aspx?id=215591",""],[6102,"قاتِلان !!","https://www.poetsgate.com/ViewPoem.aspx?id=184625",""],[6127,"لولاك عدنا في الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=188606",""],[6248,"قميص لأوراق بيضاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86025&r=&rc=2",""],[6259,"إن كنت تصدق في ادعاء وداده","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59365&r=&rc=13",""],[6268,"الليلة الأخيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82932&r=&rc=18",""],[2220,"من يتخذ غيرَ الإله جلياً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11481&r=&rc=355",""],[6355,"من نحن؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66552&r=&rc=12",""]],"verses":[["لَمّا عَفَوتُ وَلَم أَحقِد عَلى أَحَدٍ","أَرَحتُ نَفسي مِن هَمِّ العَداواتِ",0,"ت",1,1],["لمّا عرَفْتُكَ ما شككْتُ بأنّهُ","تَثْرَى يَدا أمَلي ويُعْظَمُ جاهِي",1,"ي",1,0],["لمّا عرَفوا منّي المَكانَ ولا بدَتْ","مُثولُ طُلولٍ فوْقَ كُثْبانيَ العُفْرِ",2,"ر",1,0],["لِمَ أعْرَضْتَ واسْتَهَنْتَ بهَذا","قلتُ أغْناني الغَنيُّ الحَميدُ",3,"د",1,0],["لمّا عَلِمْتُ مَكانَها وزَمانَها","أعْمَلْتُ في لَيْلِ السُّرَى إدْلاجي",4,"ج",2,0],["لَمْ أعُدَّ الحُسامَ منْ أدَواتِي","حَسْبُ نَفسي يَراعَتي ودَواتِي",5,"ت",2,1],["لَمَّا عَلاَنِي الشَّيْبُ قَالَ صَوَاحِبِي","لاَ نَبْتَغِي خِلاًّ يُصَيَّرُ أَشْيَبْ",6,"ب",1,1],["لَمّا عَلَت صَيحَةُ المُنادي","وَأَصبَحَ القَومُ في عَناء",7,"ا",2,0],["لَم أَعشُ عَن ذِكرِ الإِلهِ فَلَيتَني","أَدري عَلامَ قُرِنتُ بِالشَيطانِ",8,"ن",1,0],["لَم أَعدُ رَوضَةَ وَالَّذي","سَاقَ الحَجِيجُ لَهُ البُدنُ",9,"ن",1,0],["لما عبأت لقوس المجد أسهمها","حين الجدود عن الأحساب تنتضلُ",10,"ل",1,0],["لَم أَعدُ فيهِ مَفاخِري","وَمَديحَ آبائي النُجُب",11,"ب",1,0],["لم أعانِدْ به الطريقَ ولا أضْ","حى لدين المعاندينَ نسيبا",12,"ب",2,0],["لَمّا عَصاني أَن أُشِبَّ ضَرامَها","أَعيا عَلَيها أَن تَشِبَّ ضَرامي",13,"م",2,0],["لم أعب منه خلة في حياتي","ولقد قل صاحب لا يعاب",14,"ب",1,0],["لما عتا دهري وددت زواله","وزواله لو صح فيه زوالي",15,"ل",2,0],["لما عجلت أضعته","يا ليتني لم أعجل",16,"ل",1,0],["لَم أُعطَ عَنكَ تَصَبُّراً وَأَنا الَّذي","عَزَّيتُ فيكَ عَنِ الأَميرِ المَعشَرا",17,"ر",2,0],["لَم أَعرِفِ الخَيرَ إِلّا مُذ عَرَفتُ فَتىً","لَم يولَدِ الجودُ إِلّا عِندَ مَولِدِهِ",18,"د",2,0],["لَمّا عَفَت جَدَّدَت شَوقي فَجَدَّدَها","دَمعٌ تَرَقرَقَ مِن جارٍ وَمُنهَمِلِ",19,"ل",1,0],["لَمّا عَرَفنَ وُجوهَنا وَتَحَدَّرَت","عَبَراتُ أَعيُنِهِنَّ بِالإِسبالِ",20,"ل",1,0],["لَمّا عَرَضتُ عَلى عُلاكَ لِذِكرِهِ","طَرفاً وَصادَفَ مِن نَداكَ قَبولا",21,"ل",2,0],["لَمّا عَدِمتُ نَوالَهُ أَعدَمتُهُ","شُكري فَرُحنا مُعدَمَينِ جَميعا",22,"ع",2,0],["لِمَ أَعرَضتَ إِذ تَقَنَّصتُ لَحظاً","مِنكَ سِرّاً وَأَنتَ لي قَنّاصُ",23,"ص",1,0],["لم أعْدُ أبوابَ ستينٍ، وأحسبني","هِمَّاً وقفتُ على أبواب تسعين",24,"ن",1,0],["لمّا عطفتم على القُرآنِ من نُسُكٍ","تدفَّقتْ جَنَباتُ النِّيل قُرآنا",25,"ن",2,0],["لَمّا عَلِمتَ بَدَأتَ بِالهَجرِ","وَرَمَيتَني مِن حَيثُ لا أَدري",26,"ي",1,1],["لَمَّا عَلِمْتَ بأنَّ الرِّفْقَ أَبْطَرَهمْ","والمُفْسِدُون إذا أَكْرَمْتَهُمْ بَطِرُوا",27,"ر",3,0],["لَمْ أُعْطِ ما أَعْطَيْتُهُ أَحَداً مِنَ ال","فَضْلِ العظيمِ وحَسْبُهُ تَخْوِيلا",28,"ل",2,0],["لَمَّا عَمِلْتَ بما عَلِمْتَ مُراقباً","للهِ في الإِقدامِ والإحْجامِ",29,"م",1,0],["لَمّا عَرَفناها جَرى دَمعُهُ","ما بَعدَ دَمعِ العانِسِ الأَشيَبِ",30,"ب",1,0],["لمّا عدِمتُ مُؤَانِساً وَجَليسا","نَادَمتُ بُقراطاً وجالينوسا",31,"س",2,1],["لم أعُدْ ذلك القويَّ فأحمي","هِ من الويلِ والبلاءِ المحيقِ",32,"ق",1,0],["لَم أَعرِفِ الإِصباحَ في ضَوإِهِ","لَمّا بَدا إِلّا بِسُكرِ النَديم",33,"م",1,0],["لمّا عَلَوتَ مَطَاهُ صَفَّقَ مَوجه","بِشْراً وأَسْكَتَ وَجْدَه برُغَائه",34,"ا",3,0],["لَمْ أُعْطِ ما أعْطَيْتُهُ أَحَداً مِنَ","فضلِ العظيمِ وحسبهُ تخويلا",35,"ل",2,0],["لما عَبِثَتْ فيه أكُفٌّ جَذيمةٌ","ولمْ يَعُلهُ هذا الهجينُ المهلَّب",36,"ب",1,0],["لم أعد داريا ألى اين أذهب","كل يوم أحس أنك أقرب",37,"ب",1,1],["لما عرفتم له رسماً ولا طللاً","ولم يكن اسمه أهلاً لتدوين",38,"ن",1,0],["لَمّا عَتَوا مَنَعَ الإِنعامَ واهِبُهُ","فَمُذ عَنَوا بَذَلَ الإِنعامَ مُنتَقِمُ",39,"م",1,0],["لمْ أعدْ أذكرُ كم مرَّ على","ناظري حسنٌ لمرقاه ُ حريّا",40,"ي",2,0],["لم أعُد تيهاً يباريهِ الضَّنَى","في فتونِ العينِ عِشقي قد رَسا",41,"س",2,0],["لَما عاش من أحياءِ سِنْبِسَ واحدٌ","ولو عاش أفنى عمَره القيد والقِدّ",42,"د",1,0],["لمّا عرضت لوصلها","تاهت عليّ فتهت أكثر",43,"ر",1,0],["لِما عَلِموهُ مِن تبلُّجِ دينهِ","فَلا أحدٌ إلّا يراهُ هو الأحرى",44,"ر",2,0],["لم أعد شاكياً فمات أنيني","لم أعد باكياً فمات نحيبي",45,"ي",1,0],["لم أعد أذكر والدنيا صروف","غير أوهامٍ سوار وطيوف",46,"ف",1,0],["لما علا عن مشبه مختاره","أضحى وليس لفضله من مشبه",47,"ب",2,0],["لَمّا عَلَوتَ سَريرَها","وَسَحَبتَ فَضلَ رِدائِها",48,"ا",3,0],["لمّا عرفت حبيب ربّي المصطفى","صارت صلاتي عدّتي وبراقي",49,"ق",2,0],["لم أعدْ نبعاً لصبر ٍ","من ذهولي كَلَّ رَجْفي",50,"ف",2,0],["لم أعدْ أرضي فؤاداً","واهناً بالحب ناء",51,"ا",2,0],["لمّا عرضتُ لها زكاةَ جمالِها","قالت أما أبصرتَ من في المجلِس",52,"س",1,0],["لَما عَزَّيْتُ قَلْبَكَ عَنْ حَبِيبٍ","وَكُنْتُ بِأَنْ أُحَرِّقَهُ بَصِيرا",53,"ر",2,0],["لما عرفتك والهوى قدر","أضحى خيالك في الدجا شغلي",54,"ل",2,0],["لما عصوا ربهم ذا البطش أسكنهم","دار البوار ومأوى كل مجتاح",55,"ح",1,0],["لَمّا عَلِمتُ بِهِ أَنا","وَاللَهُ حَقّاً راقَني",56,"ن",2,0],["لم أعد أملك إلا ذكرياتي","ودموعي وبقايا من أماني",57,"ي",1,0],["لمَّا عَلمتُ أنَّ ما","بي ما بهِ أطمَعَني",58,"ن",2,0],["لمَّا عزَمتُ عَليهِ أعلَمني الهَوى","أنِّي عَلى خَوضِ المَنيَّةِ عا