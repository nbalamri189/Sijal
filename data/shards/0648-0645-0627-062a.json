habi.ae/diwan/poem/55026","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55018","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54594","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43811","المنسرح"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43686","الوافر"],[11,"","https://poetry.dctabudhabi.ae/diwan/poem/10384","الطويل"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9564","المتقارب"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/8990","المجتث"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116987","المتقارب"],[106,"مأتم الخلق!","https://www.poetsgate.com/ViewPoem.aspx?id=179664",""],[106,"في البصرة","https://www.poetsgate.com/ViewPoem.aspx?id=179307",""],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[11,"ألا أرِقَتْ عَيني، فبِتُّ أُديرُها","https://www.poetsgate.com/ViewPoem.aspx?id=16858",""],[90,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[57,"قلبي برحمتك اللهم ذو انسٍ","https://www.poetsgate.com/ViewPoem.aspx?id=3311",""],[45,"عَهْدي بِرَبْعِكَ مَأنوساً مَلاعِبُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=31545",""],[45,"حلي سعاد غروض العيس أو سيري","https://www.poetsgate.com/ViewPoem.aspx?id=31187",""],[51,"لا يُعدمُ اللهُ يديك الصَّولا","https://www.poetsgate.com/ViewPoem.aspx?id=30269",""],[39,"إِنْ تَخْتَلِفْ مُضَرٌ تَتْبَعْ عَدُوَّهُمُ","https://www.poetsgate.com/ViewPoem.aspx?id=4258",""],[75,"كَذبَ السلوُّ، العِشقُ أيسَرُ مركبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10785&r=&rc=5",""],[91,"تحيّة الدستور العثماني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67927&r=&rc=206",""],[27,"أهَاج البَرْقُ لَيْلَة أذْرِعاتٍ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=16344&r=&rc=8",""]],"verses":[["وَما تَنفَعُ المَرءَ الشِمالُ وَحيدَةً","إِذا فارَقَتها بِالمَنونِ يَمينُ",0,"ن",1,0],["وَما تَستَدِلُّ النَجمَ عَينايَ في الدُجى","ضَلالاً وَلَكِن مِثلُ عَينيَّ جِرمُهُ",1,"م",2,0],["وَما تُنجي الدُموعُ مِنَ المَنايا","فَتُرسِلَها بِأَربَعَةٍ سِجامِ",2,"م",1,0],["وَما تَفتَلينا المَنايا غُلاماً","يُؤَمَّلُ إِلّا اِفتَلَينا غُلاما",3,"م",2,0],["وَما تَرَكَ الرِماءَ قُصورَ باعٍ","وَلَكِن كَي تُراشَ لَهُ السِهامُ",4,"م",1,0],["وما تَلَوَّمَ جِسمي عَن لِقائِكُمُ","إِلّا وَقَلبي إِلَيكُم شَيِّقٌ عَجِلُ",5,"ل",1,1],["وَما تَغافَلَتِ الأَقدارُ عَن أَحَدٍ","وَلا تَشاغَلَتِ الأَيّامُ عَن أَجَلِ",6,"ل",1,0],["وَما تَسَعُ الأَضلاعُ رَيعانَ زَفرَةٍ","يَكادُ لَها قَلبُ الجَليدِ يَزولُ",7,"ل",1,0],["وَما تَرَكوا عِندَ الرِماحِ بَقِيَّةً","لِهَزٍّ إِلى يَومِ العَماسِ وَلا جَرِّ",8,"ر",1,0],["وَما تُجدي الدُموعُ عَلى فَقيدٍ","وَلَو غَسَلَت مِنَ العَينِ السَوادا",9,"د",2,0],["وَما تَدري الحَمائِمُ أَيُّ شَيءٍ","عَلى الأَثَلاتِ يُلهمُنا الرَّنينا",10,"ن",2,0],["وماتزال بحلقي ألف مبكيةٍ","من رهبة البوح تستحيي وتضطرب",11,"ب",1,0],["وَما تَذَكَّرتُ ما قاسَيتُ مِن جَزَعٍ","إِلّا وَكادَت نِياطُ القَلبِ تَنقَطِعُ",12,"ع",1,0],["وَما تَشتَفي عَينايَ مِن دائِمِ البُكا","عَلَيكِ وَلو أَنّي بَكَيتُ إِلى الحَشرِ",13,"ر",1,0],["وَما تَمَسَّكُ بِالوَصلِ الَّذي زَعَمَت","إِلّا كَما تُمسِكُ الماءَ الغَرابيلُ",14,"ل",1,0],["وَماتَ الَّذي أَحيا الشُعورَ وَساقَهُ","إِلى المَجدِ فَاِستَحيا النُفوسَ البَوالِيا",15,"ي",2,0],["وَما تُريدُ بِجِسمٍ لا حَياةَ لَهُ","مِن خُلصِ الزبدَ ما أَبقى لَكَ اللَبَنا",16,"ن",2,0],["وَما تَبَدَّلتُ حُبّاًّ غَيرَ حُبِّهِمِ","إِذاًّ تَبَدَّلتُ دينَ الكُفرِ مِن ديني",17,"ي",1,0],["وَمَا تَخَالُ سِوَى دُرٍّ مُنَثَّرَةٍ","أَلفاظَهَا دَارِجَاتٍ مِنَ ثَنَايَاهَا",18,"ا",3,0],["وَمَاتَ شَبْلٌ رَزْئَتُهُ أَعْلَى","قَدْرِ الهِبَاتِ الجَّلائِلِ النِّقِمُ",19,"م",1,0],["وَمَا تَنِي فِي جِهَادٍ","لَهُ الرَّجَاءُ مُلازِمْ",20,"م",1,0],["وَمَا تَحْتَهَا إِلاَّ رُؤًى مِنْ فَرَاغِهَا","طَغَتْ وَمُنىً مِنْ وَهْيِهَا تَتَكَهَّمُ",21,"م",1,0],["وَما تُضْمِرُونَ الإِخَاءَ الصَّحِيحَ","وَمَا تُظْهِرُونَ الوَفَاءَ الصَّمِيمَا",22,"م",2,0],["وَما تاهَ عَلى الناسِ","شَريفٌ يا أَبا سَعدِ",23,"د",1,1],["وما تعتريني فترة في مدى العلا","إلى أن أرى لحظاً عليه فتورُ",24,"ر",1,0],["وما ترك الإسلام للمرء ميزة","على مثله ممَّن لآدم ينَتمي",25,"م",2,0],["وَما تَدرونَ ما الطَعنانُ حَتّى","يُمَدَّ الجَريُ مِن طَبَقِ العِنانِ",26,"ن",1,0],["وَما تَعرِفونَ الشَمسَ إِلّا لِغَيرِكُم","وَلا مِن مُنيراتِ الكَواكِبِ كَوكَبا",27,"ب",2,0],["وَما تَيمٌ إِلى سَلَفي نِزارٍ","وَما تَيمٌ تَرَبَّبَتِ الرِبابا",28,"ب",2,0],["وَما تَيمٌ لِضَبَّةَ غَيرُ عَبدٍ","أَطاعَ القَودَ وَاِتَّبَعَ الجِنابا",28,"ب",2,0],["وَما تَدري حُوَيزَةُ ما المَعالي","وَجَلهَمُ غَيرَ أَطرِهِمُ العِلابا",28,"ب",2,0],["وَما تَنفَعُ الدارُ المُحيلَةُ ذا الهَوى","إِذا اِستَنَّ أَعرافاً عَلا الدارَ مورُها",29,"ر",3,0],["وَما تُلاقي قَدَمي وَساقي","مِنَ الحَفا وَعَدَمِ السُواقِ",30,"ق",1,0],["وَما تَشتَكي قِدري إِذا الناسُ أَمحَلَت","أُؤَثِّفُها طَوراً وَطَوراً أُميرُها",31,"ر",3,0],["وَما تَشتَكيني جارَتي غَيرَ أَنَّه","إِذا غابَ عَنها بَعلُها لا أَزورُها",31,"ر",3,0],["وما تَخَيَّف ألواناً مفنَّنةً","عن المحاسن من إِخْلاقِه الوطْبُ",32,"ب",1,0],["وَمَا تَرَكَت لِذِي مُرَّانَ بَيتاً","وَلَم تَذعَر حَمَائِمُهَا السَّكُونَا",33,"ن",2,0],["وَما تَوازَنَ يَوماً بَينَكُم شَرَفٌ","وَلا تَساوَت بِكُم في مَوطِنٍ قَدَمُ",34,"م",1,0],["وَما تَجني سَراةُ بَني أَبينا","سِوى ثَمَراتِ أَطرافِ العَوالي",35,"ي",1,0],["وَما تَعَرَّضَ لي يَأسٌ سَلَوتُ بِهِ","إِلّا تَجَدَّدَ لي في إِثرِهِ طَمَعُ",36,"ع",1,1],["وَما تُمَدُّ لَهُ الأَطنابُ في بَلَدٍ","إِلّا تَضَعضَعَ باديهِ وَحاضِرُهُ",37,"ر",2,0],["وما تنفع الآداب والعلم والحجى","وصاحبها عندَ الكمال يموت",38,"ت",1,0],["وما تخرج الأحكام عنكم لغيركم","فسيَّان من قد غاب منكم ومن بدا",39,"د",2,0],["وما تخيَّلت أنِّي","أشكو صدَاك وصدَّك",40,"ك",1,0],["وما تركَ ابن الخضر ميراثَ واجدٍ","سوى الذكر فيَّاحاً أو الأجر نيرا",41,"ر",2,0],["وما تقضت لبانات لطائفةٍ","قالت حلاوة ألفاظي لقد علكوا",42,"ك",3,0],["وما تنطوي الآمالُ عنه بخيبةٍ","ولكنْ إلى جدواهُ أقصى انتهائِها",43,"ا",3,0],["وما تُجدي عليك ليوثٌ غابٍ","بنُصرتها إذا دمَّاك ذيبُ",44,"ب",1,0],["وما تلك الدروعُ سوى هباتٍ","تجودُ عليَّ من يدِكَ الوَهوبِ",45,"ب",1,0],["وما تصامم عني إذ هتفتُ به","كالناظرين بصوت الهاتف البَحَحا",46,"ح",2,0],["وماتَ حُسَّادُكمُ حسْرَةً","من بين مَسْيُوفٍ ومَرْمُوحِ",47,"ح",1,0],["وما تشاجيك على شاعرٍ","بحشِّك الأبخر ذي البَربَخِ",48,"خ",1,0],["وما تعاقبُ إنْ عاقبْتَ من رَجُلٍ","بسَوْطه دُونَ سَوْط النَّقْم مَجْلُودِ",49,"د",1,0],["وما تعتريها آفةٌ بشريةٌ","من النوم إلا أنها تتخثرُ",50,"ر",1,0],["وما تأوّلتُ شتْماً","فيه سوى المنصوص",51,"ص",1,0],["وما تكلّمتَ إلا قُلتَ فاحشةً","كأن فكَّيكَ للأعراض مقراض",52,"ض",1,0],["وما تُفيضُ بعلمٍ لا ولا صفدٍ","وأنت بالسلح قبل السُّكرِ فياض",52,"ض",1,0],["وما تتقذّاكم عيونٌ جليّةٌ","ولا تلفِظُ التقريظَ فيكم مسامع",53,"ع",1,0],["وما تعديت بل ردعتك بال","وعظ وللصالحين مرتدع",54,"ع",1,0],["وما تلك الحقاق سوى ثُدِيٌّ","قُدِرن من الحقاق على وفاق",55,"ق",1,0],["وما تُعدمُ الدنيا الدنية أهلها","شواظَ حريق أو دخانَ حريقِ",56,"ق",1,1],["وما تعديتَ من محمدٍ ال","حلمَ إذا ما المميِّزُ انتقدكْ",57,"ك",1,0],["وما تخلفتَ عن خصال أبي","إسحاق من سعيه ولا جَهدكَ",57,"ك",1,0],["وما تنفكُّ مُرتضعاً مَنِيّاً","لعبدٍ تشتريه فيَشْتريكا",58,"ك",2,0],["وما تركُ عِلقٍ منفس كاقتنائه","ولا رفضُ فعل صالحٍ كامتثالهِ",59,"ل",2,0],["وما تَضْربُ الأكباد نحو فنائه","من العيس بل عفوا تَخُبُّ وَتَسْعَمُ",60,"م",1,0],["وما تلك إلا همَّةٌ طاهرِيَّةٌ","تميلُ إلى الأمر الذي هو أجْسَمُ",60,"م",1,0],["وما تتراءى في المرايا وُجوهُنا","بلى في صِفاح المرهفاتِ الصوارمِ",61,"م",1,0],["وما تنفكُّ تغلبُ كل شكرٍ","بعُرٍف ما لعُروته انفصامُ",62,"م",1,0],["وما تستفيقُ يدا قاسمٍ","كأنَّ يديْهِ يدا عائمِ",63,"م",1,0],["وما تأخَّرَ حَيٌّ بعَد مِيتته","إلا تأخُّرَ نقدٍ بعد عُربون",64,"ن",1,0],["وَما تَرَكنَ مِنَ الغَواضِرِ مُعصِراً","إِلّا قَصَمنَ بِساقِها خَلخالا",65,"ل",2,0],["وَما تَرَكَت أَسيافُنا حينَ جُرِّدَت","لِأَعدائِنا قَيسِ بنِ عَيلانَ مِن وِترِ",66,"ر",1,0],["وَما تَمنَعُ الأَعداءَ مِنّا هَوادَةٌ","وَلَكِنَّهُم يَلقَونَ مِنّا الدَواهِيا",67,"ي",2,0],["وَما تَنفَكُّ حَنكَلَةٌ زَموعٌ","تُواعِدُهُ إِلى أَدنى مَكانِ",68,"ن",1,0],["وَماتَ في أُذُنَيَّ لَحنُ الهَزار","لَمّا سَبَقتِ الصَمتَ لِلمُنشِدِ",69,"د",1,0],["وَما تَغَيَّرتُ عَن ذاكَ الوِدادِ لَكُم","خُذوا حَديثي عَن أَيّامِيَ الأُوَلِ",70,"ل",1,0],["وَما تَرَكَت رِماحُ بَني سُلَيمٍ","لِفَحلٍ في حَواصِنِهِم جَنينا",71,"ن",2,0],["ومَاتتْ وقد غادَرَتْها بقاعٍ منَ","الأَرضِ ضنْكٍ حَيَاةُ الصُّروفْ",72,"ف",1,0],["وما تلكم الآمال إلا خرافة","وتلك الرجايا غير أحلام هاجد",73,"د",1,0],["وما تنبأت في دين كما زعموا","بل في الفصاحة سباقا وفي الادب",74,"ب",1,0],["وما توهمت قلبي قبل فرقتكم","يهب مثل هبوب الركب والإبل",75,"ل",1,0],["وما تلك من هي بنت النقيب","فتاة هي البدر في ليلته",76,"ه",1,0],["ومات أبطالهم جياعا","في غير أوطانهم ظِماء",77,"ا",2,0],["وما تزال فتاة","مرجوة لوصال",78,"ل",1,0],["وما تصنع بالأسطو","ل مشحونا ومعمورا",79,"ر",2,0],["وما تيامن يبغى الشرق سابقها","إلا تياسر يبغى الغرب تاليها",80,"ي",3,0],["وَماتَ لا أَقولُ في أَثنائِها","بَل وَهِيَ عِندَ مُنتَهى بِنائِها",81,"ه",2,0],["وَما تَهَلَّلتَ إِذ وافاكَ ذو أَمَلٍ","إِلّا وَأَدهَشَهُ حُسنٌ وَإِحسانُ",82,"ن",1,0],["وَما تَوانى الرومُ يَفدونَها","وَالسَيفُ في المُفدِيِّ وَالمُفتَدي",83,"د",2,0],["وَما تِلكَ القِبابُ وَأَينَ كانَت","وَكَيفَ أَضَلَّ حافِرُها القُرونا",84,"ن",2,0],["وَما تَرَكوكَ مَعصِيَةً وَلَكِن","يُعافُ الوِردُ وَالمَوتُ الشَرابُ",85,"ب",1,0],["وَما تُنكِرُ الدَهماءَ مِن رَسمِ مَنزِلٍ","سَقَتها ضَريبَ الشَولِ فيها الوَلائِدُ",86,"د",1,0],["وَما تابَ حَتّى غادَرَ الكَرُّ وَجهَهُ","جَريحاً وَخَلّى جَفنَهُ النَقعُ أَرمَدا",87,"د",2,0],["وَماتوا قَبلَ مَوتِهِمُ فَلَمّا","مَنَنتَ أَعَدتَهُم قَبلَ المَعادِ",88,"د",1,0],["وَما تَقِرُّ سُيوفٌ في مَمالِكِها","حَتّى تُقَلقَلُ دَهراً قَبلُ في القَلَلِ",89,"ل",1,0],["وَما تَسَعُ الأَزمانُ عِلمي بِأَمرِها","وَلا تُحسِنُ الأَيّامُ تَكتُبُ ما أُملي",90,"ل",2,0],["وَما تَنقِمُ الأَيّامُ مِمَّن وُجوهُها","لِأَخمَصِهِ في كُلِّ نائِبَةٍ نَعلُ",91,"ل",1,0],["وَما تَنفَعُ الخَيلُ الكِرامُ وَلا القَنا","إِذا لَم يَكُن فَوقَ الكِرامِ كِرامُ",92,"م",1,0],["وَما تَرقى لُهاهُ مِن نَداهُ","وَلا المالُ الكَريمُ مِنَ الهَوانِ",93,"ن",1,0],["وما تدرك ما قلت","إذا لم تك ذا فهمِ",94,"م",1,0],["وما تحلل فينا واستحال دماً","من الغذاء ففي أجسادنا انعقدا",95,"د",2,0],["وما تروّح في تحليله جسد","إلا تجسّد روح منه فاتحدا",95,"د",2,0],["وما تروّح في تحليله جسد","إلا تجسّد في تركيبه روحُ",96,"ح",1,0],["وما ترتمي بي الأرضُ إلّا وخاطري","بذكراك مشغوفٌ ونحوَكَ نازعُ",97,"ع",1,0],["وَما تَبَرَّعتُ بِالتَقريظِ مُبتَدِئً","حَتّى اِقتَضَتني فَأَحفَتني مَواهِبُهُ",98,"ب",2,0],["وَما تَملَأُ الآماقَ مِن فَيضِ عَبرَةٍ","وَلَيسَ الهَوى البادي لِفَيضِ اِنسِكابِها",99,"ب",3,0],["وَما تَدري القَوافي مَن سَعيدٌ","وَلا عَمرٌو فَتُقصِرُ أَو تُهابُ",100,"ب",1,0],["وَما تُنبِتُ البَطحاءُ مِن غَيرِ وابِلٍ","وَلا يَستَديمُ الشُكرَ غَيرُ جَوادِ",101,"د",1,0],["وَما تَزالُ أَواخي المُلكِ ثابِتَةً","مِنهُم بِكُلِّ رَحيبِ الباعِ وَالبَلَدِ",102,"د",1,0],["وَما تَركي لِمَنبِجَ وَاِختِياري","لِرَأسِ العَينِ فِعلٌ مِن مَريدِ",103,"د",1,0],["وَما تَزالُ الفُتوحُ مُقبِلَةً","مِن كُلِّ أُفقٍ إِلَيكَ مُبتَدِرَه",104,"ر",2,0],["وَما تَثالُ دَواعي البَثِّ تَذهَبُ بي","إِلى غَليلٍ مِنَ الأَشجانِ مَسعورِ",105,"ر",1,0],["وَما تَكافا الحالُ إِن لَم يَقَع","رَدٌّ مِنَ الأَقوى عَلى الأَضعَفِ",106,"ف",1,0],["وَما تُلُدُ المَعروفِ بِالمُغنَياتِهِ","عَنِ المَجدِ أَن يَزدادَهُ بِالطَوارِفِ",107,"ف",1,0],["وَما تَرَكَ اِستِحقاقُهُ دونَ حَظِّهِ","وَإِن نالَ أَعلى مُرتَقىً وَمَنالِ",108,"ل",1,0],["وَما تَرَكَت في أَردَبِيلَ لُبانَةً","لِطُلّابِ ذَحلٍ في الدِماءِ نِهالِ",108,"ل",1,0],["وَما تَوَهَّمتُني أُعطي الزَمانَ رِضاً","بِأَن يَطولَ بِذاكَ العَهدِ إِخلالي",109,"ي",1,0],["وَما تَنفَكُّ أَحداثُ اللَيالي","تَميلُ عَلى النَباهَةِ لِلخُمولِ",110,"ل",1,0],["وَما تَكفيهِ مِن خَطبٍ عَظيمٍ","وَما توليهِ مِن نَيلٍ جَزيلِ",110,"ل",1,0],["وَما تَقَضَّت مِنكَ أُكرومَةٌ","في ثالِثِ الدَهرِ وَلا التالي",111,"ي",1,0],["وَما تَحسُنُ الدُنيا إِذا هِيَ لَم تُعَن","بِآخِرَةٍ حَسناءَ يَبقى نَعيمُها",112,"م",3,0],["وَما تَباعَدتُ إِلّا أَنَّ مُستَتِراً","مِنَ الزَمانِ نَأَتهُ الدارُ عَن جُنَنِه",113,"ن",2,0],["وَما تَعَرَّضتُ مِن شَينوخَ عارِفَةً","إِلّا تَعَرَّضَ عُثنونٌ عَلى ذَقَنِه",113,"ن",2,0],["وَما تَخفى المَكارِمُ حَيثُ كانَت","وَلا أَهلُ المَكارِمِ حَيثُ كانوا",114,"ن",3,0],["وَما تابِعٌ في المَجدِ نَهجَ عَدُوِّهِ","كَمُتَّبِعٍ في المَجدِ نَهجَ أَبيهِ",115,"ي",2,0],["وَما تَرَكَ الأَيّامُ وَالسَنَةُ الَّتي","تَعَرَّقَ ناباها السَنامَ المُصَعَّدا",116,"د",2,0],["وَما تَكُ يا اِبنَ عَبدِ اللَهِ فينا","فَلا ظُلماً نَخافُ وَلا اِفتِقارا",117,"ر",2,0],["وَما تَرَكَت رَأساً لِبَكرِ بنِ وائِلٍ","وَلا لِلُكَيزِيَّينَ إِلّا مُكَوَّرا",118,"ر",2,0],["وَما تَدعو حَنيفَةُ حينَ تَلقى","إِذا اِحمَرَّ الجِلادُ بِآلِ بَكرِ",119,"ر",1,0],["وَما تَرَكَت مُنكُم رِماحُ مُجاشِعٍ","وَفُرسانُها إِلّا أَكولَةَ مَنسِرِ",120,"ر",1,0],["وَماتَ الَّذي يَرعى عَلى الناسِ دينَهُم","وَيَضرِبُ بِالهِندِيَّ رَأسَ المُخالِفِ",121,"ف",1,0],["وَما تُبتَغى الحاجاتُ عِندَكَ بِالرُشى","وَلا تُقتَضى إِلّا بِما في الرَسائِلِ",122,"ل",1,0],["وَما تَرَكَت كَفّا هِشامٍ مَدينَةً","بِها عِوَجٌ في الدينِ إِلّا تَقَوَّما",123,"م",2,0],["وَماتَ أَبي وَالمُنذِرانُ كِلاهُما","وَعَمروُ اِبنُ كُلتومٍ شِهابُ الأَراقِمِ",124,"م",1,0],["وَماتَ مَعَ الجَرّاحِ مَن يَحشُدُ القِرى","وَمَن يَضرِبُ الأَبطالَ فَوقَ الجَماجِمِ",125,"م",1,0],["وَما تَرَكَت مِن قَيسِ عَيلانَ بِالقَنا","وَبِالهُندُوانِيّات غَيرِ الشَراذِمِ",126,"م",1,0],["وَما تَرَكَ الصُوّانُ وَالحَبسُ وَالسُرى","لَها مِن نِعالِ الجِلدِ غَيرَ الشَراذِمِ",127,"م",1,0],["وَما تَجعَلُ الظِربى القِصارَ أُنوفُها","إِلى الطِمِّ مِن مَوجِ البِحارِ الخَضارِمِ",128,"م",1,0],["وَما تَلقى العَبيدُ بَنو زِيادٍ","بِسَيفٍ لِلِّقاءِ وَلا سِنانِ",129,"ن",1,0],["وما تَحَكَّمَ في دارٍ فِراقُهُمُ","إلا غَدَتْ في دموعِ العَيْنِ تَحتَكِمُ",130,"م",1,0],["وما تَنَمَّرَ جِلبابُ الغَمامِ بِها","إلا كسا الرَّوْضَ من نَهرٍ جَلابيبا",131,"ب",2,0],["وَما تَرجو لِشَيءٍ لَيسَ يَبقى","وَشيكاً ما تُغَيِّرهُ اللَيالي",132,"ي",1,0],["وَما تَعمى العُيونُ عَنِ الخَطايا","وَلَكِن إِنَّما تَعمى القُلوبُ",133,"ب",1,0],["وَما تَعدِلُ الدُنيا جَناحَ بَعوضَةٍ","لَدى اللَهِ أَو مِقدارَ زَغبَةِ طائِرِ",134,"ر",1,0],["وَما تَنفَكُّ مِن دُوَلٍ تَراها","تَنَقَّلُ مِن أُناسٍ في أُناسِ",135,"س",1,0],["وَما تَنفَكُّ دائِرَةً بِخَطبٍ","وَما يَنفَكُّ جَمّاعٌ مَنوعُ",136,"ع",1,0],["وَما تَبحَثُ الساعاتُ إِلّا عَنِ البِلى","وَلا تَنطَوي الأَيامُ إِلّا عَلى ثُكلِ",137,"ل",1,0],["وَما تَنفَكُّ أَن تَكدَ","حَ أَشغالاً بِأَشغالِ",138,"ل",1,0],["وَما تَنَفَكُّ مِن مَثَلٍ","لِسَمعِكَ ضارِبٍ مَثَلا",139,"ل",2,0],["وَما تَزالُ صُروفُ الدَهرِ تَختُلُهُ","حَتّى تَقَنَّصَهُ مِن جَرفِ سِربالِه",140,"ل",2,0],["وَما تَنفَكُّ مِن زَمَنٍ عَقورٍ","بِقَلبِكَ مِن مَخالِبِهِ كُلومُ",141,"م",1,0],["وَما تَدرينَ مِن ذَلِ","كَ أَسماءَ جَواريكِ",142,"ك",1,0],["وَما تَأَخَّرتُ عَن مَلالٍ","بَل مَرَضُ العَينِ لا يُعادُ",143,"د",1,0],["وما تيَقّنتُ أنّي قبل رُؤيَتِهِ","ألْقَى كرامَ البرايا منه في رجلِ",144,"ل",1,0],["وما تَيَقّنْتُ أن الماءَ قبلهما","يكونُ للنار ما بينَ الحَشَا حطبا",145,"ب",2,0],["وَما تَبرَحُ الأَيّامُ تَحذِفُ مُدَّتي","بِعَدِّ حِسابٍ لا كَعَدِّ حِسابِيا",146,"ي",2,0],["وَماتَت نُفوسُ الغالِبِيّينَ كُلِّهِم","وَإِلّا فَصَبرُ الغالِبِيّينَ أَجمَعُ",147,"ع",1,0],["وَما تَنصُرُ الأَسيافُ نَصرَ مَديحَةٍ","لَها عِندَ أَبوابِ الخَلائِفِ مَحضَرُ",148,"ر",1,0],["وَمَا تَرَكَ الْهَاجُونَ فِيكَ بَقِيَّةً","يَدُورُ عَلَيْهَا فِي الْهِجَاءِ لِسَانِي",149,"ي",1,0],["وَمَا تَحْسُنُ الأَيَّامُ إِلا بِأَهْلِهَا","وَلا الدَّارُ إِلا بِالصَّدِيقِ الْمُلائِمِ",150,"م",1,0],["وما تركتَ بذاتِ الضالِ عاطلةً","من الظباءِ ولا عارٍ من البقرِ",151,"ر",1,0],["وما تنفعُ الآدابُ والعلمُ والحجا","وصاحبُها عندَ الكمالِ يموتُ",152,"ت",1,0],["وَما تَجزي بِقَرضِ الوُدِّ نُعمٌ","وَلا تَعِدُ النَوالَ إِلى قَريبِ",153,"ب",1,0],["وما تبقى القلوب ولا المآقي","إذا ذهب الأحبة والصحاب",154,"ب",1,0],["وما تبقى البلادُ إذا أُصِيبَتْ","بِمَنْ يبغي الزعامةَ يَستفيدُ",155,"د",1,0],["وما تخفى فُنونُ الحربِ يوماً","على الشَّعبِ الذي وَرِثَ الفُنونا",156,"ن",2,0],["وما تَضَعُ السّلاحَ بناتُ قومي","ولا تَدَعُ الحِمَى للواغِلينا",156,"ن",2,0],["وما تنأى فَروقُ إذا هممتم","ولا تأبى أدرنةُ أن تدينا",156,"ن",2,0],["وما تُبقِي الشُّعوبُ على مُلوكٍ","مَشائيمِ العهودِ مُبغَّضِينا",156,"ن",2,0],["وَما تَعصى خُطوبُ الدَهرِ حُرّاً","أَطاعَ اللَهَ مِثلَكَ وَالرَسولا",157,"ل",2,0],["وَما تَعمى قُلوبُ الناسِ يَوماً","إِذا عَمِيَت عَنِ الأَمرِ العُيونُ",158,"ن",1,0],["وَما تَدري السُقاةُ بِأَيِّ كَأسٍ","تَطوفُ وَأَيَّ ذي طَرَبٍ تَشوقُ",159,"ق",1,0],["وَما تُغني بَناتُ الشِعرِ شَيئاً","إِذا ما الشَرُّ بِالأَقوامِ حاقا",160,"ق",2,0],["وَما تَبَقى المَمالِكُ لاهِياتٍ","تُصَرِّفُها الخَلاعَةُ وَالمُجونُ",161,"ن",1,0],["وما تُغْنِي الخزائمُ حين تُلوَى","إذا انطلقَتْ لحاجتها الفُحولُ",162,"ل",1,0],["وَما تَطعمها الحَبَّ بَل","الكَرَمَ الَّذي يَقطف",163,"ف",1,0],["وَما تُبالي تَميمُ سَوؤَةً وَقَعَت","فيها إِذا حالَ دونَ السَوءَةِ العُذَرُ",164,"ر",1,0],["وَما تَراءَت لَنا عَمداً وَما شَعَرَت","لَكِن جَلَتها لَنا تِلكَ الأَخادِيرُ",165,"ر",1,0],["وَما تَطَيَّبُ إِلّا إِنَّ طِينَتَها","مِن عَنبَرٍ خُلِقَت مِن أَطيَبِ الطِينِ",166,"ن",1,0],["وَما تَرَكَت حَفائِظَها لِأَمرٍ","أَلَمَّ بِها وَما قَصُرَت لُهاها",167,"ا",3,0],["وَماتَ الاِفشينُ عَلَيهِ حَسرَه","وَما بَكَت عَينٌ عَلَيهِ قَطرَه",168,"ه",1,0],["وَماتَ بَعدَ مِأَتَينِ قَد خَلَت","في عامِ تِسعٍ وَثَمانينَ مَضَت",168,"ت",1,0],["وَمَأتَمٌ في السَماءِ يَبكي","وَالأَرضُ مِن تَحتِهِ عَروسُ",169,"س",1,0],["وَماتَتِ التَوبَةُ لَم","ما أَن بَدا مِن هَيبَتِه",170,"ت",2,0],["وما تَتَضاعفُ الأغلالُ إِلَّا","إذا قَسَتِ الرِّقابُ أوِ القلوبُ",171,"ب",1,0],["وَما تلكَ لِلإِسْلامِ إِلَّا بَواعِثٌ","على أنْ يجِلَّ الشَّوْقُ أوْ يَعْظُمَ الوَجْدُ",172,"د",1,0],["وما تلكَ للسلطانِ إِلَّا سعادَةٌ","يَدُومُ لهُ ذِكْرٌ بها وأُجُورُ",173,"ر",1,0],["وما تُذلِّلُ من أهلِ العِنادِ لهُمْ","وما تُداري من الدين الإباضيّ",174,"ي",1,0],["وما تُكابِدُ من تلك الغِمارِ وما","تَخُوضُ بالسيْفِ من تلك الأواذيّ",174,"ي",1,0],["وما تِلكَ أوضاحٌ عليها وإن بَدَتْ","ولكنّما حَيّتْكَ عنها المَباسم",175,"م",1,0],["وما تُطلِعُ الدّنيا شُموساً تُريكَها","ولا للرّياضِ الزُّهْرِ أيدٍ حَوائك",176,"ك",1,0],["وما تَعْدِلُ الأنواءُ صُغرى بَنانِهِ","فكيْفَ بشْيءٍ يعدِلُ الزَّند والكفّا",177,"ف",2,0],["وما تستوي الشَّغواءُ غيرَ حثيثةٍ","قوادمُها والكاسراتُ الحثائث",178,"ث",1,0],["وما تفْتأُ الحسناءُ تُهدي خَيالَها","ومن دونِها إسْآد خمسٍ وتأويب",179,"ب",1,0],["وَماتَوافى بِجَمعٍ","وَالشَعبُ في عَرَفاتِ",180,"ت",1,0],["وَماتَ مَرحَبُ لَمّا","رَأَيتَ مالِيَ قَلّا",181,"ل",2,0],["وَما تَنفَكُّ مَشغولاً","بِتَقليبِ الدَنانيرِ",182,"ر",1,0],["وَما تَرثينَ لي مِمّا أُلاقي","وَإِنَّكِ لَو عَشِقتِ إِذا رَثَيتُ",183,"ت",1,0],["وَما تُبصِرُ العَينانِ في مَوضِعِ الهَوى","وَلا تَسمَعُ الأُذنانِ إِلّا مِنَ القَلبِ",184,"ب",1,0],["وَما تُذكَرينَ الدَهرَ إِلّا تَهَلَّلَت","لِعَينَيَّ مِن شَوقٍ إِلَيكِ غُروبُ",185,"ب",1,0],["وَما تَنفَكُّ مَحلولاً عُراها","عَلى مُتَناذِرِ الأَكلاءِ طامِ",186,"م",1,0],["وَما تَهَذَّبَ يَومٌ مِن مَكارِهِها","أَو بَعضُ يَومٍ فَحُثّوا السَيرَ إِهذابا",187,"ب",2,0],["وَما تَشعُرُ الغَبراءُ ماذا تُجِنُّهُ","أَأَعظُمُ ضَأنٍ أَم عِظامُ لُيوثِ",188,"ث",1,0],["وَما تَمنَعُ الخَودَ الحَصانَ حُصونُها","وَلَو أَنَّ أَبراجَ السَماءِ بُروجُها",189,"ج",3,0],["وَما تَوَقّى سُيوفَ الهِندِ بيضُ طُلىً","بِأَن تُناطَ إِلى أَعناقِها النُجُدُ",190,"د",1,0],["وَما تَزالُ جُسومٌ في مَحابِسِها","حَتّى يُفَرَّجَ عَن أَكبادِها الكَبَدُ",191,"د",1,0],["وَما تَبَقّي سِهامَ المَرءِ كَثرَتُها","فَاِقضِ الحَياةَ وَأَنتَ الصارِمُ الفَردُ",192,"د",1,1],["وَما تَخَلَّصُ يَوماً مِن مَكارِهِها","وَأَنتَ لا بُدَّ فيها بالِغٌ أَمَدا",193,"د",2,0],["وَما تُشبِه الشَمسُ الرَوادِنُ مُرَّداً","كَخَيلٍ بِميدانِ الفُسوقِ رَوادِ",194,"د",1,0],["وَما تَمنَعُ الآدابُ وَالمُلكُ سَيِّداً","كَقابوسَ في أَيّامِهِ وَفَنا خُسَرِ",195,"ر",1,0],["وَما تَرَكَت بيضُ الزَمانِ وَسَودُه","كَراسيَّ عِزٍّ كُلُّهُنَّ كَراسِ",196,"س",1,0],["وَما تَستَوي الأَخدانُ قِيَّمُ هَذِهِ","مُسِنٌ وَلِلأُخرى وَليٌّ غُرانِقُ",197,"ق",1,0],["وَما تُحسِنُ الأَيّامُ أَن تَرزُقَ الفَتى","وَإِن كانَ ذا حَظٍّ صَديقاً يُوافِقُه",198,"ق",2,0],["وَما تُريدُ بِدارٍ لَستَ مالِكَها","تُقيمُ فيها قَليلاً ثُمَّ تَنطَلِقُ",199,"ق",1,0],["وَما تَعصِمُكَ الوَحدَ","ةُ أَن تَنزِلَ ناوُوسَك",200,"ك",1,0],["وَما تَزالُ لِأَهلِ الفَضلِ مَنقَصَةٌ","وَلِلأَصاغِرِ تَعظيمٌ وَتَبجيلُ",201,"ل",1,0],["وَما تَترُكُ الأَيّامُ وَهيَ كَثيرَةٌ","وِلايَةَ والٍ وَاِنصِرافَ عَزيلِ",202,"ل",1,0],["وَما تَثني المَقادِرُ عَن مُرادٍ","بِما جَمَّعَت مِن خَيلٍ وَرَجلِ",203,"ل",1,0],["وَما تَشعُرُ الإِبلُ أَنَّ الرِكابَ","أُعِمَّت إِلى الرَملِ أَم لَم تُعَم",204,"م",1,0],["وَما تَزالُ تُلاقي في دُجىً وَضُحىً","مُبَشِّرينَ بِلا بُشرى وَناعينا",205,"ن",2,0],["وَما تَرَكا تُركَ القِبابِ وَغادَرا","بِرُمحَينِ أَو جُرزَينِ أُسرَةَ جُرزانِ",206,"ن",1,0],["وَما تُفيدُ الغَواني مِن لَآليها","نَفَعاً إِذا جاءَ كَيدٌ مِن لَياليها",207,"ي",3,0],["وَما تَزالُ دَواليها نَوائِبَها","فَمِن شِدادِ خُطوبٍ أَو دَواليها",207,"ي",3,0],["وَما تَبقى الأَراقِمُ في حِماها","وَلا الأُسدُ الضَراغِمُ في شَراها",208,"ا",3,0],["وَما تَنفَكُّ تُرحَضُ كُلَّ يَومٍ","مِن السَوءاتِ كَالطِفلِ النَهيمِ",209,"م",1,0],["وَما تزال بقاع الأرض نامية","بِما عَلَيها من الأجسامِ يَنحَدِر",210,"ر",1,0],["وَما تُريكَ مَرائي العَينِ صادِقَةً","فَاِجعَل لِنَفسِكَ مِرآةً مِنَ الفِكرِ",211,"ر",1,0],["وما تلقى الرزق باليمين","في الناس مثل التاجر الأمين",212,"ن",1,0],["ومات من آوى وربّى واصطنع","وذاد عن خير البنين ومنع",212,"ع",1,0],["وَما تَألوا نَهارَكَ ذِكرَياتٍ","وَلا بُرهانَ عِزَّتِكَ اِلتِماحا",213,"ح",2,0],["وماتَ الَّذِي غابَ السُّرُورُ لمَوْتِهِ","فلَيْسَ وإِنْ طالَ السُّرَى منه آيِبَا",214,"ب",2,0],["وَمَا تِلْكَ مِنِّي نَبْوَةٌ غَيْرَ أَنَّنِي","أُنَزِّهُ نَفْسِي عَنْ مُلابَسَةِ الغَدْرِ",215,"ر",1,0],["وَما تُدْرِكُ الأَلْبَابُ مِنْ حَلِّ مُعْضِلٍ","إِذَا حَاجَتِ الأَقْدَارُ فِيمَا تُقَدِّر",216,"ر",1,0],["وَمَا تَتَشَظَّى شَمْسُهُ فِي اشْتِعَالِهَا","تَشَظِّيَ قَلْبِي وَهْوَ بِالشَّوْقِ مُشْعَلُ",217,"ل",1,0],["وَمَا تَشَاءُ المَعَالِي فِي تَنَوُّعِهَا","عَلَى اخْتِلاَفِ مَرَامِي النَّفْسِ أَعْلاَكِ",218,"ك",1,0],["وَمَا تِلْقَاءُ عَدْلِكَ مِنْ أَعَادٍ","تُبَالِيهُمْ وَمَا مِنْ أَوْلِياءِ",219,"ا",2,0],["وَمَا تُبَالِي كيْفَ كَانتْ سِوَى","مَا طاهِرُ الْوَحْيِ بِهِ يَأْمرُ",220,"ر",1,0],["وما تَرْضَى عَزَائِمُهُ المَوَاضِي","لَهُ شأْناً سِوَى الشَّأْنِ الخَطِيرِ",221,"ر",1,0],["وَمَا تَخَيَّرْتَ بَعْدَ الكَدِّ تَلْهِيَةً","إِلاَّ بِبَعْثِ بَقَايَا الْفَنِّ وَالتُّحَفِ",222,"ف",1,0],["وَمَا تَوَلَّيْتَ مِنْ صَنِيعٍ","لِلْخَيْرِ أَكْمَلْتَهُ صنِيعَا",223,"ع",2,0],["وَمَا تَبَوَّأْتَ مِنْ عَلْيَاءَ مَنْزِلَةٍ","زَادَتْ سَنَى الشَّرَفِ الوَضَّاحِ وَالنَّسَبِ",224,"ب",1,0],["وَما تَوَقّيهِ ذا الزَمان وَقَد","حَلَّ بِهِ مِنكَ ما تَوَقّاهُ",225,"ا",2,0],["وَماتَ اِبني فَها أَنا لا فُؤادٌ","وَلا بَصَرٌ وَلا مَوتٌ مُريحُ",226,"ح",1,0],["وَما تَشتَكيني جارَتي غَيرَ أَنَّها","إِذا غابَ عَنها بَعلُها لا أَزورُها",227,"ر",3,0],["وَماتَ اِبنُ وَهبٍ خَلِيَّ الخُطوبِ","عَوابِثَ فيهِنَّ دُنيا وَدينا",228,"ن",2,0],["وَماتَ أَيضاً عَلِيٌّ","وَجاوَرَ الأَمواتا",229,"ت",2,0],["وما تهدأ النفس حتى أصا","ب بأخرى حديدٍ تصيبُ الوتينا",230,"ن",2,0],["وما تغيَّرت الأشكالُ مذ خُلِقَت","إنّ التغَيُّر في الآماقِ والحَدَق",231,"ق",1,0],["وما تَعَثَّر مِنَّا قَاتِلٌ أبَدًا","إن أشْعَرَ الشِّعْر وَسْط الحَفْل، أو خطبا",232,"ب",2,0],["وما تلك الحياةُ؟ وكيف جئنا؟","خيارٌ ذا المجيءُ أم اضطرار؟",233,"ر",1,0],["وما تستكى قدري، إذا الناس امحلت","أوثقها طوراً، وطوراً اميرها",234,"ر",3,0],["وما تستكيني جارتي، غير أنها،","إذا غاب عنها بعلها، لا أزورها",234,"ر",3,0],["وما تَهَب الصنائع للبَرايا","كما يَهَبُ \" الشهيد \" لها اصطِناعا",235,"ع",2,0],["وما تقلبت من نومي وفي سنتي","إلا وذكرك بين النفس والنفس",236,"س",1,0],["وَما تَبَرّعْتُ بِالتقْرِيظِ مُبْتَدِئاً،","حتى اقتضَتْني، فأحْفَتني موَاهِبُهُ",237,"ب",2,0],["وما تزال دواعي البث تذهب بي","إلى غليل من الأشجان مسعور",238,"ر",1,0],["وما تهيبت هناك هَوْلا","حتى رأى الويلُ عليه العوْلا",239,"ل",2,0],["ومَا تبالي تميمٌ سوءة ً وقعَتْ","فيهِا إذا حالَ دونَ السَّوءة ِ العذرُ",240,"ر",1,0],["وما تفْتأُ الحسناءُ تُهدي خَيالَها","واخضرّ منه الأفقُ حتى أعشبا",241,"ب",2,0],["وما تمّ غير البغي والظلم والأذى","فقبّحت من عصر كثير السخائم",242,"م",1,0],["وَما تَدْري حُوَيْزَة ُ مَا المَعَالي","وجاهمُ غيرَ أطرقهمُ العلابا",243,"ب",2,0]]}