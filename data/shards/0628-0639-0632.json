iwan/poem/77190","الوافر"],[4011,"","https://poetry.dctabudhabi.ae/diwan/poem/45531","الطويل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78304","البسيط"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127072","المتقارب"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97096","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102755","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90834","الطويل"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93747","الطويل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135129","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81706","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72957","الوافر"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136383",""],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123850","الكامل"],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/201301","المتقارب"],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/199652","الرجز"],[4797,"جمايل وطنا","https://www.poetsgate.com/ViewPoem.aspx?id=178141",""],[4866,"رباه","https://www.poetsgate.com/ViewPoem.aspx?id=129542",""],[4869,"ارجل طفل . مرثيه","https://www.poetsgate.com/ViewPoem.aspx?id=139688",""],[4935,"تدل بدلها تيها","https://www.poetsgate.com/ViewPoem.aspx?id=129500",""],[3749,"رفاهية الشهم اقتحام العظائم","https://www.poetsgate.com/ViewPoem.aspx?id=134962",""],[5187,"تشرين","https://www.poetsgate.com/ViewPoem.aspx?id=29703",""],[5431,"من هلوسات الحمى (3)-وشعبي سيغلبُ","https://www.poetsgate.com/ViewPoem.aspx?id=198325",""],[5463,"بعزّة منهو سوّاها","https://www.poetsgate.com/ViewPoem.aspx?id=34325",""],[5544,"حاضرة المعالي","https://www.poetsgate.com/ViewPoem.aspx?id=213443",""],[402,"يا ناعيا فاجأ الربوعا","https://www.poetsgate.com/ViewPoem.aspx?id=36009",""],[5875,"مشتاق","https://www.poetsgate.com/ViewPoem.aspx?id=12145",""],[6069,"بعزمك أيها الملك العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=105705",""],[6086,"ذات همة !!","https://www.poetsgate.com/ViewPoem.aspx?id=29238",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"]],"verses":[["بِعَزمٍ كَبارِقَةِ المَشرَفِيِّ","يَأبى عَلى الهَزِّ إِلّا قِراعا",0,"ع",2,0],["بِعَزمِكَ يَمضي عَزمُهُ في عَدُوِّهِ","مَضاءَ طَريرٍ أَيَّدَتهُ كِعابُ",1,"ب",1,0],["بِعَزَّةَ مَتبولٌ إِذا هِيَ فارَقَت","مُعَنّى بِأَسبابِ الهَوى ما يَريمُها",2,"م",3,0],["بعزّ عاد حصناً منيع","يدروا بذا أهل الفطن",3,"ن",1,0],["بعزمة مضمون السعادة أوحد","وغرّة وضّاح المكارم والنّجرِ",4,"ر",1,0],["بعزمٍ إذا ما الليل مَدَّ رِواقَه","يكر على ظلمائه فينيرُ",5,"ر",1,0],["بِعَزمٍ تَخافُ الأَرضُ شِدَّةَ وَقعِهِ","وَيَرتاعُ ثَهلانٌ لَهُ وَهوَ ثَهلانُ",6,"ن",1,0],["بِعَزمٍ يَسيرُ الجِسمُ في السَرجِ راكِباً","بِهِ وَيَسيرُ القَلبُ في الجِسمِ ماشِيا",7,"ي",2,0],["بعزمٍ إِذا ما انسابَ في مدلَهِمَّةٍ","من الخطب لم يرتدَّ إلّا على فصلِ",8,"ل",1,0],["بعزائمٍ نقَّبْنَ في خِططِ العُلى","فبلغتُها حيث المحلُّ الشاسعُ",9,"ع",1,0],["بعزيمةٍ لو أنَّ هبَّتَها","للريح لم يَثْبُتْ لها هِضْبُ",10,"ب",1,0],["بِعَزمِ عُمومٍ مِن مَصابيحِ أَشعَرٍ","وَحَزمِ خُؤولٍ مِن لُؤَيِّ بنِ غالِبِ",11,"ب",1,0],["بِعَزمَةِ مَأمورٍ مُطيعٍ وَآمِرٍ","مُطاعٍ فَلا يُلفى لِحَزمِهِمُ مِثلُ",12,"ل",1,0],["بِعَزمٍ في الشَدائِدِ غَيرَ واهٍ","وَبَأسٍ في الوَقائِعِ غَيرَ واهِن",13,"ن",1,0],["بِعَزمٍ يُريني ما أَمامَ مَطالِبي","وَحَزمٍ يُريني ما وَراءَ العَواقِبِ",14,"ب",1,0],["بعزْمٍ يُجَرّدُ منه السيوفَ","ورأيٍ يفوّقُ منه السهاما",15,"م",2,0],["بِعَزْمٍ وَحَزْمٍ أَحْيَيَا مِنْ مَوَاتِهَا","وَرَدَّا مِنَ الْعِزِّ الَّذِي دَالَ مَارِدَا",16,"د",2,0],["بِعِزِّكُمُ نُعَزُّ وَحْيُثُ شِدْتُمْ","فَإِنَّ لِقَوْمِكُمْ فَخْراً يُشَادُ",17,"د",1,0],["بِعَزْمٍ لَهُ حِينَ المضَاءِ إِضَاءَةٌ","تَرُوعُ كَإِشْعَاعِ الحُسَامِ المُجَرَّدِ",18,"د",1,0],["بِعَزْمةٍ لا تَهِي وَنفْسِ","إِلَى الْعُلَى لاَ تنِي نُزُوعَا",19,"ع",2,0],["بعزائمٍ يَقْدَحْن ني","رانًا إذا نَبَتَ القداح",20,"ح",1,0],["بعزم امير المؤمنين ابي بكر","لقد خفقت للدين الوية النصر",21,"ر",1,1],["بعزائم وزعائم قد جربت","كل التجارب معزمات مزعما",22,"م",2,0],["بعزم باعك شادوا رتبةً عظُمت","ومِن جداولها أجريت أنهارا",23,"ر",2,0],["بعزم كما أطلقن أنشوطة الحبى","وجِدٍّ كما نفَّرتَ عن مَربإ صَقرا",24,"ر",2,0],["بِعَزمِكَ يا سَيفَ الخِلافَةِ يُقتَدى","فَلا تُرِ خَطباً أَنَّهُ لَكَ غاصِبُ",25,"ب",1,0],["بِعِزِّكَ لاذوا وَهوَ أَمنَعُ مَوئِلٍ","وَغَيثَكَ أَمّوا وَهوَ لِلبِرِّ ساكِبُ",26,"ب",1,0],["بِعِزٍّ مَطولٍ في عُلاً وَجَلالَةٍ","وَغَيرِ مَطولٍ في وَعيدٍ وَلا وَعدِ",27,"د",1,0],["بِعِزِّكَ سَرحُ المُسلِمينَ مُمَنَّعٌ","وَكانَ بِأَطرافِ الأَسِنَّةِ يُذعَرُ",28,"ر",1,0],["بعزم تفلُّ المرهفاَتُ بحدّةِ","وحزمٍ يوازي كلَّ قرب مكافحِ",29,"ح",1,0],["بعزم كالقضا المحتوم ماض","يرد بواعث القدر المتاح",30,"ح",1,0],["بِعَزمك لُذْ إِذا عَزَّ النَصيرُ","وَلا يَعبثْ بهمَّتِكَ الفُتورُ",31,"ر",1,1],["بعزٍّ يُسدّ الخافقين ودولةٍ","لها فوق أعنان السماء صعود",32,"د",1,0],["بِعَزيمَةٍ كَالنَجمِ لَم","تَتَعَدَّ في شَبَهٍ أَباها",33,"ا",3,0],["بعزائم دعمت على إيمانهم","يرتد عنها الضد وهو كليل",34,"ل",1,0],["بعز مكانة وَيجل قَدرا","برفعة منصب زاكي النصاب",35,"ب",1,0],["بِعَزْماتِ مَجْدٍ ثاقِباتٌ هُمُومُها","وَآراءِ مَلْكٍ مُحْصَداتِ الْمَرائِرِ",36,"ر",1,0],["بعزيزَيهمُ السّمَّيينِ يُفْدَى","من عيونٍ لهم ومن آباء",37,"ا",2,0],["بعزةٍ فاقت الأملاكَ قدرتُها","وسطوةٍ صيرت إبليس في وجل",38,"ل",1,0],["بِعَزم لا يَعوج عَلى فُتور","وَحَزم لا تَرى فيهِ إِعوِجاجا",39,"ج",2,0],["بعزم يهدّ الراسيات مُصَمّمِ","ورأي إذا يُنْضَى جلا ظُلمَ الجُلَّي",40,"ل",2,0],["بِعِزِّ أَبي الذَوّادِ عِزَّ ذَليلها","وَذَلَّت أَعاديها وَسَدَّت ثغورها",41,"ر",3,0],["بِعَزمِ أروعَ مِدراكٍ لِمَطْلَبِهِ","ماضٍ على الهَولِ مُستوطٍ لمَركَبِهِ",42,"ه",1,0],["بعزيمةٍ أمضَى على","حدِّ السُّيوفِ من السُّيوف",43,"ف",1,0],["بعز حسن مهيب","ودل صبٍّ كئيبِ",44,"ب",1,1],["بعزمِك طار العدل شرقاً ومغرباً","وأنجدَ في أعلى البلاد وأتهَما",45,"م",2,0],["بعزيمة أركانها بركونها","ثبتت فآذن سعدها بدوام",46,"م",1,0],["بعِزِّ لواءٍ يبلُغُ النجمَ إِنْ عَلا","وبَحْرِ عَطاءٍ يَرْغَبُ الأَرْضَ إِنْ طَمى",47,"م",2,0],["بعَزْمٍ يُذَكِّرُ أرْضَ الأعادي","هُبوبَ العواصفِ فِي أرضِ عادِ",48,"د",1,0],["بعزائِمٍ فِي الرَّوْعِ قحطانِيَّةٍ","تركَتْ ديارَ الشِّرْكِ قاعاً فَدْفَدَا",49,"د",2,0],["بعزائمٍ لا تنثنِي وبصائرٍ","لا تنتهي ووسائلٍ لا تَأْتَلِي",50,"ل",2,0],["بعزائِمٍ ومخائلٍ أَعْيَتْ عَلَى","بأْس الشجاعِ وحِيلَةِ المُتَحَيِّلِ",50,"ل",1,0],["بِعَزَائِمٍ كَلَّفْتَها أَعلى العُلا","فتسابَقَتْ شَأْواً إِلَيْهِ مُغَرِّبا",51,"ب",2,0],["بعزمٍ يعيدُ اليومَ أسودَ قاتماً","يخوضونَهُ الخيلُ الكرائمُ والرَّجْلُ",52,"ل",1,0],["بعزم يفسل المرهفات بحده","ويهزم في يوم الكريهة عسكرا",53,"ر",2,0],["بِعزَّةِ بأسٍ قد نَشَرْتَ شِراعَها","فَرَدَّتْ على الأشْياءِ جَلْجَلَةَ القَهْرِ",54,"ر",1,0],["بعزمك لاذ الملك واعتصم الهدى","وذلت صعاب الدهر وهي جوامح",55,"ح",1,0],["بعزمة الناصر بن الصالح انكشف","الأعداء عن حوزة الإسلام وانذعروا",56,"ر",3,0],["بعزيمة لولا تأخر عصرها","خلقت مضاء في الحسام الباتر",57,"ر",1,0],["بِعَزمٍ به مُستَسلَفُ النّصرِ كافلٌ","وَحزمٌ به مستأنَفُ النُّجحِ تابعُ",58,"ع",1,0],["بعزة الشان وما","لديه من فرط اللين",59,"ن",1,0],["بعزمه صعب الأمور يسهل","وهو الذي يقال فيه الرجل",60,"ل",1,0],["بعزك يا ذا الكبرياء والمراحم","ومعروفك المعروف بين العوالم",61,"م",1,1],["بعزيمة وبهمة أبلغتنا","أقصى المطالب حين عز المحدس",62,"س",1,0],["بعزمه أدرك الجوزاء معتلياً","وسهل الأمر مهما شق أو صعبا",63,"ب",2,0],["بِعَزائِمَ مَشبوبَةً وَمَكارِمٌ","عَنهُنَّ بيعانِ الكِرامِ قِصارُ",64,"ر",1,0],["بِعَزمِ مُحَمَّدِ المَهدي عَزَّت","بَنُو حَسَنٍ وَقَد ذَلُوا وَهانُوا",65,"ن",3,0],["بِعِزٍّ وَتأَييدٍ وَرِفعَةِ مَنصِبٍ","إِلَى أن عَلا فَوقَ السَّماءِ وَناجاهُ",66,"ا",2,0],["بعزازةٍ أَنوارُها","في المشرقين بَواهر",67,"ر",1,0],["بِعزمك يا رُكن العُلوم وَسُورَها","غلامُك يَلقى كُلَّ خطب بصدره",68,"ر",2,0],["بِعَزيمة لَيثٍ كرّارِ","أَصمى في جَيشٍ جرّارِ",69,"ر",1,0],["بعزم البخار تسيره","لكبح جماح عوادي المتالف",70,"ف",1,0],["بِعَزْمِ أَبِيٍّ لا يُرَدُّ مَضَاؤُه","وهل تُمْلَكُ الأفْلاكُ عَنْ حَرَكَاتِها",71,"ت",3,0],["بِعزَّةِ نَفسٍ تَمتَطي العزَّ وَالعُلى","وَقَد رَفَعَت شَأناً لَهُ المَجدُ منصبُ",72,"ب",1,0],["بعزّ به يقوى الضعيف ويغتني","أخو الفقر عن أجناسه البشريّة",73,"ي",2,0],["بعزائم مشحوذة","أمضى من القدر المتاع",74,"ع",1,0],["بعزيمة كالنجم ثاقبة","وصريمة تستخدم الأجلا",75,"ل",2,0],["بعزيمة لم تعترف بهزيمة","وبمرقم ما خاف صولة أرقم",76,"م",1,0],["بعزل وزير الشام مع ضبط مالِه","لأمر قضاه الله وهو المقدّرُ",77,"ر",1,0],["بعزمة يقلع الصم الصعاب بها","ما يفعل السيف ما تفعله آراه",78,"ا",2,0],["بعزمٍ يُجسِّد حزم الشيوخ","ويرسم أغلى معاني الثمن",79,"ن",1,0],["بعزة أمرك دار الفلك","حنانيك فالخلق والأمر لك",80,"ك",1,1],["بعزتك اعتصمت فلا أبالي","وإن نصبت مكائدها الخطوب",81,"ب",1,0],["بعز اللّه سلطاني عليهم","وعدل اللّه سلطان مهيب",81,"ب",1,0],["بعز لا إله إلا اللّه","وعز أسمائك عجل المدد",82,"د",1,0],["بعزك مجد يا مجيد مهابتي","يظل لها خصمي العنيد مذللا",83,"ل",2,0],["بعزتك العظمى اكسني عز ذلتي","اليك ولا تجعل لغيرك ذلتي",84,"ي",1,0],["بعزة مجد الماجد الحق سيدي","تدارك بأيد منك وهني وذلتي",85,"ي",1,0],["بعزم يراه السَّيف أولى بغِمدِهِ","إذا سلَّ لم يظفر به كفّ غامد",86,"د",1,1],["بِعَزيمة أَمضى وَأَسبَق في العِدى","مِن كُل خَطيء وَكُل يَماني",87,"ن",2,0],["بعزم امرئٍ عزمه ليس ينبو","ورأي امرئٍ حدُّه لن يُفلاّ",88,"ل",2,0],["بعَزْمةٍ قارعَ الأحداثَ مَنصْبُها","وهمةٍ جاوزَ الجوزاءِ مَذْهبُها",89,"ب",3,0],["بِعَزمٍ يَخَالُ البَحر شَربَةَ مُرتَوٍ","وَيَحسَب طُولَ الأَرضِ فِي سَعَةِ الشِّبرِ",90,"ر",1,0],["بعزم افعم الغبراء فخرا","وعدل اثقل الخضراء خضرا",91,"ر",2,0],["بعزم كظنِّ الأديبِ الأريبِ","وجيشٍ كَذَيْلِ الأَياةِ الخَصِل",92,"ل",1,0],["بعزمِها اجتزتُ تيارَ الغرامِ ولم","أحفل بوقع سهامِ الظَّنِّ والرِّيبِ",93,"ب",1,0],["بِعَزمٍ ثَنى صَدرَ القَناةِ مُحَطَّماً","وَرَدَّ غِرارَ المَشرَفيّ مُفَلَّلا",94,"ل",2,0],["بِعَزمِهِم بَلَغوا خَيرَ الأَنامِ فَقَد","فازوا وَما بَلَغوا إِلّا بِعَزمِهِمِ",95,"م",1,0],["بعزل عُبيد الله عنا فيه لهُ","بحيران عن قصد الطريق ترده",96,"د",2,0],["بعزَّةِ مَلْكٍ باسطِ الكفِّ أروعٍ","مُطاعٍ أمينٍ واسع الحِلْم صادقِ",97,"ق",1,0],["بعز الدين فارسها وحامي","حقيقتها وقسورها الصؤول",98,"ل",1,0],["بِعَزيزِ الدَّولَةِ امتَدت يَدي","فَعَلى فَرعِ السُّها أَسحَبُ رُدني",99,"ن