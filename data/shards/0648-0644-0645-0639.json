{"poems":[[53,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[68,"لا يوخذ الجار في الأعراض بالجار","https://www.aldiwan.net/poem38786.html","البسيط"],[71,"ما يقول المفتون في المفتون","https://www.aldiwan.net/poem28371.html","الخفيف"],[119,"رب دار بالغضا طال بلاها","https://www.aldiwan.net/poem40433.html","عموديه"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[276,"ودعتها والدمع يقطر بيننا","https://www.aldiwan.net/poem52117.html","الكامل"],[463,"ما للدسوت وللسروج تسائل","https://www.aldiwan.net/poem56069.html","الكامل"],[471,"ولما لحقنا بالحمول ودونها","https://www.aldiwan.net/poem50414.html","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38412","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59200","الوافر"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145158","الرجز"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104730","الطويل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104811","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100758","الكامل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26141","الرجز"],[3536,"","https://poetry.dctabudhabi.ae/diwan/poem/20616","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91350","البسيط"],[3861,"","https://poetry.dctabudhabi.ae/diwan/poem/73549","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75718","الوافر"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123517","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90890","الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90762","الرمل"],[5845,"ألسيعُ صلِّ مالهُ منْ راقِ","https://www.poetsgate.com/ViewPoem.aspx?id=16699",""]],"verses":[["ولمعشرٍ لا يُنعمون تطاولٌ","ولراحتيك الثَّرتين تطوُّلُ",0,"ل",1,0],["وَلِم عَذَقتُم بِنا ما قالَ ضِدُّكُمُ","عَنكُم وَإِن قُلتُهُ مِن غَيرِ إيثاري",1,"ر",2,0],["ولمعسولِ ريقِهِ مِنْ طريحٍ","ولعسَّالِ خدِّهِ منْ طعينِ",2,"ن",1,0],["ولمعنى من تصاريف القضا","سمح الدهر بها ثم محاها",3,"ا",3,0],["وَلِمُعجِزِ القَمَرِ الَّذي بَهَرَ العِدى","مِن أَكبَرِ الآياتِ وَالبُرهانِ",4,"ن",1,0],["وَلمعجزات الرسل باع قاصر","عَن معجزات اللاحق السياق",5,"ق",1,0],["ولمعشرٍ طَرْقُ العلوم ذنوبُهم","في الناس وهي لهم إليك وسائلُ",6,"ل",1,0],["وَلَمعٍ بِعَينَيها كَأَنَّ وَميضَهُ","وَميضُ الحَيا تُهدى لِنَجدٍ شَقائِقُه",7,"ق",2,0],["وَلَمعِ طرّتِهِ مِن بَدرِ غرّتِهِ","فَلا اِحتِياجَ بِها لِلدَّهنِ وَالدُّهُنِ",8,"ن",1,0],["وَلِمْ عَوَّضْتَ منْ تِبْرٍ لُجَيْنًا","وَأبْدَلْتَ القَرَنْفُلَ بِالْبَهَارِ",9,"ر",1,0],["ولمعة من صارم يسلُّ","كومضة من عارض ينهلُّ",10,"ل",1,0],["وَلَمعَة بَرقٍ أَم ضِياءُ جَبِينِها","تَقَطَّعَ مِنهُ النُّورُ إِذ تَتَلَطَّفُ",11,"ف",1,0],["وَلَمَعةُ بَدرِ التِّمِّ أَبدَت أَمِ الحِجَا","تَزَحزَحَ عَن لُبِّ وَصارَ مُرَدِّدَا",12,"د",2,0],["ولمعشر رتب العلاء تظنها","جاءت اليهم كابراً عن كابر",13,"ر",1,0],["وَلُمعَةٍ بَينَ قَساً وَالأَخرَمِ","تَحسِبُ مُجتَلَّ الإِماءِ الخُرَمِ",14,"م",1,0],["وَلِمَعشَرٍ لَم يَبلُغوا مِن وُدَّكُم","ما قَد بَلَغتُ يَقومونَ وَأدفَعُ",15,"ع",1,0],["وَلَمعةُ الكَأسِ عَن قابوس يُخبرُنا","نُعمانُها منذرٌ وَاللَونُ كافور",16,"ر",1,0],["وَلِمَعطِفَيكِ مِنَ التَّأَوُّدِ مِثلُهُ","وَزِيادَةٌ يَشقَى بِها المَغرورُ",17,"ر",1,0],["وَلَمعُ الدُروعِ وَغُرِّ التُروسٍ","وَزُهرُ التَرائِكِ فَوقَ الرُؤوسِ",18,"س",1,0],["وَلمع البرق يشجي كلّ قَلب","حَكاه في اِضطراب واِضطرام",19,"م",1,0],["ولمع برق أضا أم درّ مبتسم","وذى ظبا الهند أم ذا لحظ فتاك",20,"ك",1,0],["ولمعنى صيته صوت به","رقص الكون وغنى طربا",21,"ب",2,0],["ولمعنى صيته صون به","رقص الكون وغنى طربا",22,"ب",2,0],["ولمعجزاتِ الرسلِ باعٌ قاصرٌ","عنْ معجزاتِ اللاحقِ السباقِ",23,"ق",1,0]]}