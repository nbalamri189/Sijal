{"poems":[[51,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[66,"لا يوخذ الجار في الأعراض بالجار","https://www.aldiwan.net/poem38786.html","البسيط"],[69,"ما يقول المفتون في المفتون","https://www.aldiwan.net/poem28371.html","الخفيف"],[115,"رب دار بالغضا طال بلاها","https://www.aldiwan.net/poem40433.html","عموديه"],[231,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[271,"ودعتها والدمع يقطر بيننا","https://www.aldiwan.net/poem52117.html","الكامل"],[458,"ما للدسوت وللسروج تسائل","https://www.aldiwan.net/poem56069.html","الكامل"],[466,"ولما لحقنا بالحمول ودونها","https://www.aldiwan.net/poem50414.html","الطويل"]],"verses":[["ولمعشرٍ لا يُنعمون تطاولٌ","ولراحتيك الثَّرتين تطوُّلُ",0,"ل",1,0],["وَلِم عَذَقتُم بِنا ما قالَ ضِدُّكُمُ","عَنكُم وَإِن قُلتُهُ مِن غَيرِ إيثاري",1,"ي",1,0],["ولمعسولِ ريقِهِ مِنْ طريحٍ","ولعسَّالِ خدِّهِ منْ طعينِ",2,"ن",1,0],["ولمعنى من تصاريف القضا","سمح الدهر بها ثم محاها",3,"ا",3,0],["وَلِمُعجِزِ القَمَرِ الَّذي بَهَرَ العِدى","مِن أَكبَرِ الآياتِ وَالبُرهانِ",4,"ن",1,0],["وَلمعجزات الرسل باع قاصر","عَن معجزات اللاحق السياق",5,"ق",1,0],["ولمعشرٍ طَرْقُ العلوم ذنوبُهم","في الناس وهي لهم إليك وسائلُ",6,"ل",1,0],["وَلَمعٍ بِعَينَيها كَأَنَّ وَميضَهُ","وَميضُ الحَيا تُهدى لِنَجدٍ شَقائِقُه",7,"ق",2,0]]}