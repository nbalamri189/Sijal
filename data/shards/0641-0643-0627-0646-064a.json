],[4442,"بالأعالي فتنت لا بالأسافل","https://www.poetsgate.com/ViewPoem.aspx?id=171204",""],[199,"عن لسان كجثة الورل الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=20791",""],[5309,"ذلك البدر كنت ادري مصيره","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573542",""]],"verses":[["فَكَأَنّي وَجَدتُ ريحاً مِن الفِر","دَوسِ فاحَت مِن ريح ذاكَ اللُبانِ",0,"ن",1,0],["فَكَأَنّي كَسَوتُ ذَلِكَ رَحلي","أَو مُمَرَّ السَراةِ جَأباً دَريرا",1,"ر",2,0],["فَكَأَنّي وَقَد أَحاطَ بِجِسمي","في لِباسٍ مِنَ العُلا وَالبَهاءِ",2,"ا",2,0],["فَكَانَ يَوْمٌ لا شَمْسَ فِيهِ سِوَى","شَمْسِ وَلا نَيِّرٌ سِوَى قَمَرِي",3,"ر",2,0],["فكأني وقد نظرت لمعرا","ها من النور مبصر اسطوانه",4,"ن",2,0],["فكأني في النفس والطرس منها","ناظر في بنفسج وأقاحي",5,"ح",2,0],["فكأنِّي حملتُ رنك بن أيو","ب على وجنتي لفرط ولاء",6,"ا",2,0],["فكأنِّي بالأمن في ظل إسما","عيلَ ربّ العلى وربّ الوفاء",7,"ا",2,0],["فكأني في الناسِ لصٌ مريب","أتخفى وعملتي تحت إبطي",8,"ي",1,0],["فَكَأَنّي مُخاطِبٌ كُنتُ إِيّا","هُ عَلى خاطِري بِذاتي لِذاتي",9,"ت",2,0],["فكأني أراك في عَكِرِ الفك","ر تُوالي تَنفُّسَ الصُّعداءِ",10,"ا",2,0],["فكأني لديه من جَنَّةِ الفرْ","دوسِ في ظِلِّ سدْرِها المْخضُودِ",11,"د",1,0],["فكأنّي هَيَّأتُها لحمارَي","ن يَرُودان في خَلِيس الوديس",12,"س",1,0],["فكأني هناك قد صعقني","كهرباء أو مزقتني حراب",13,"ب",1,0],["فكان يوحي اليك الشعر عن شحط","وكان يوحي اليك الشعر عن كثيب",14,"ب",1,0],["فَكانَ يَأتي كُلَّ يَومِ جُمعَه","وَجُبنَةٌ في فَمِهِ أَو شَمعَه",15,"ه",1,0],["فَكانَ يُريدُ نُصحاً وَهوَ مُضبٍ","عَلى غِشٍّ كَأَطرافِ الرِماحِ",16,"ح",1,0],["فَكَأَنَّ يَومَ حَياتِهِ سَنَةٌ","وَكَأَنَّ ساعَةَ لَيلِهِ دَهرُ",17,"ر",1,0],["فَكَأَنّي أَرى المَراتِبَ وَالقَو","مَ إِذا ما بَلَغتُ آخِرَ حِسّي",18,"س",2,0],["فَكَأَنّي أُنادِمُ القَمَرَ البَد","رَ عَلَيها في ذَلِكَ الإيوانِ",19,"ن",1,0],["فكأني مُنادِمٌ منه لولا","حركاتٌ من جِسْمِه تِمثالا",20,"ل",2,0],["فكأني أرى السُّرورَ عَدوّاً","أَتحَامَاهُ والمُدامةَ ضِدَّا",21,"د",2,0],["فَكَأَنَّ يَومَكَ قَد أَتى","يَسعى إِلَيكَ عَلى عَجَل",22,"ل",1,0],["فكأنّي خُلِقْتُ جوّابَ أرْضٍ","أَصِلُ العزمَ حَشوَها وهيَ تَقطَع",23,"ع",1,0],["فَكَأنِّي ذو غليلٍ تَلتَظي","لَوعةٌ مِنهُ إِلى ماءِ الثُّغور",24,"ر",1,0],["فَكَأَنَّ يَومَ البَعثِ فاجَأَهُم فَلا","أَنسابَ بَينَهُمُ وَلا أَسبابُ",25,"ب",1,0],["فَكَأَنّي لَمّا حَطَطتُ إِلَيهِ الرَ","حلَ أَطلَقتُ حاجَتي مِن إِباضِ",26,"ض",1,0],["فَكانَ يَمضي لِيَرعى أُنسَ وَحشَتِهِ","في شاسِعٍ ما بِهِ لِلخَلقِ مِن أَرَمِ",27,"م",1,0],["فَكانَ يَوماً عَتِيدَ البَأسِ نالَ بِهِ","كِلا الفَريقَينِ جَهداً وَارِيَ الحَدَمِ",27,"م",1,0],["فَكانَ يَوم جَزاءٍ بَعدَ مُختَبَرٍ","لِمَن وَفا وَجَفا بِالعِزِّ وَالرَّغَمِ",27,"م",1,0],["فَكانَ يَوماً حَوى عِيدَينِ في نَسَقٍ","فَتحاً وَعَود كَرِيمٍ طاهِرِ الشِّيَمِ",27,"م",1,0],["فَكَأَنّي النُوّارُ يُجنيهِ ظَبيٌ","حينَ لا يَجتَنيهِ لَيثُ العَرينِ",28,"ن",1,0],["فكأَني بها أُرَحِّلُ منْ مَك","كَةَ شمساً سماؤُها البَيْداءُ",29,"ا",2,0],["فكأَنَّ يُوشَعَ بعدَ موسى قائمٌ","بِطَرِيقِهِ المُثْلَى قِيامَ مُؤَكِّدِ",30,"د",1,0],["فَكَأَنّي بِكُم غَداً","في ثِيابٍ مِنَ المَدَر",31,"ر",1,0],["فَكَأَنّي وَما أُزَيِّنُ مِنها","قَعَدِيٌّ يُزَيِّنُ التَحكيما",32,"م",2,0],["فَكَأَنّي تابِعٌ حُسنَ شَيءٍ","مِن أَمامي لَيسَ بِالمُستَبانِ",33,"ن",1,0],["فَكَأَنّي سَمِعتُ حِسَّ حَبيبٍ","نَقَرَ البابَ نَقرَةً ثُمَّ غابا",34,"ب",2,0],["فكأني ما قلْتُ والبدْرُ طِفْلٌ","وشَبابُ الظّلْماءِ في عُنْفُوانِ",35,"ن",1,0],["فَكَأَنّي أَشيمُ عاطِفَةَ البِر","رِ عِياناً تَجولُ بَينَ الجُلوسِ",36,"س",1,0],["فَكَانَ يَوْماً قَضَيْنا فِيهِ لَذَّتَنَا","كَمَا اشْتَهَيْنَا فَلا غِشٌّ وَلا دَغَلُ",37,"ل",1,0],["فكأنِّي بِقَطْرَةٍ مِنْ ندَى الرَّحْمَة","تحْيِي رَمِيمَهُ فِي القَبْرِ",38,"ر",1,0],["فَكَأَنّي قَبَّلتُ مِنهُ هِلالا","وَكَأَنّي عانَقتُ مِنهُ قَضيبا",39,"ب",2,0],["فَكَأَنّي صَعبٌ مِنَ الخَيلِ يَختا","لُ وَفي الأَربعِ الرَواكِضِ شَركُ",40,"ك",1,0],["فكأنِّي أَرَى الزَّمَانَ وَقَدْ دَا","رَ وَعادَ الصِّبا نَضِيرَ الإِهَاب",41,"ب",1,0],["فكأنّي أشتمّ في كلّ شبر","ميته تستثير كلبا ... وكلبا",42,"ب",2,0],["فكان يريد نصحاً وهو مضب","على غش كالأطراف الرماح",43,"ح",1,0],["فكأني لم أملأ الصدر لوزا","وعلى الثغر ما سكبت العقيقا",44,"ق",2,0],["فَكانَ يَومٌ باقي الحَديثِ وَزا","لَت أُمَّةٌ ثابِتٌ مَراتِبُها",45,"ب",3,0],["فكأني الوالي على بنُ مسعودٍ","بِحسنى أخْلاقهِ أَعْدَاهَا",46,"ا",3,0],["فَكَأني لِطِيبِ يَومِى جَلِيسٌ","لأبي الطِّيِّبِ الأَدِيبِ الشَّهِيرِ",47,"ر",1,0],["فكأني إذا تمضمضَ بالمد","ح لساني أديرُ في الفمِ خمرا",48,"ر",2,0],["فكان يقتلهم في كل معترك","ليؤمنوا ولتهواه قلوبهم",49,"م",1,0],["فَكَأَنّي نَقَلتهُ عَن فُؤادي","أَو كَأَنِّي جَعَلتُ فيهِ فُؤادي",50,"د",2,0],["فَكَأَنّي وَقَد تَمَتّعتُ مِنها","جالِسٌ بَينَ رَوضَةٍ وَغَديرٍ",51,"ر",1,0],["فَكَأَنّي مِن ذِكرِهِم خالَطَتني","مِن فِلَسطينَ خَمرُ جَلسٍ عُقارُ",52,"ر",1,0],["فكأني بحسن وجهك قد صا","حت به اللحيةُ الرحيلَ الرحيلا",53,"ل",2,0],["فكأني على صراطٍ من الصَّب","رِ أُرَجّي به حلولَ الجنانِ",54,"ن",1,0],["فكأني من حُسن وجهك أرعى","ناظري في حدائق البستانِ",55,"ن",1,0],["فكأني لدى عروض جفاه","بيت شعر وفيه بعض زحاف",56,"ف",1,0],["فَكَأَنّي بِكَ السَما","أودِعَت في لَظىً وَطين",57,"ن",1,0],["فَكَأَنّي بِهِنَّ أُحدِر","نَ مِن عَبقَرٍ أَثَر",57,"ر",1,0],["فَكَأَنّي لَمّا اِنتَهى مِنهُ","مُبدِعُ الخَلقِ ضَيَّعَ القالِب",58,"ب",1,0],["فَكَأَنّي وُجِدتُ في الكَون حَتّى","أَشربَ الكَأسَ مِن يَدي شيطانِه",59,"ن",2,0],["فَكَأَنّي عَبدٌ أَوَدُّ رِضاه","وَأَنا فاعِلٌ بِما يُرضيهِ",60,"ي",2,0],["فكأنِّي والشَّعْرَ والأوجُهَ البي","ضَ بدورٌ في ظُلْمةٍ في سماء",61,"ا",2,0],["فَكانَ يُقيمُ عِندي في زَمانِ ال","صِبى لَونُ الشَبيبَةِ في عِذاري",62,"ر",2,0],["فَكَأَنّي أَعلَقتُ كَفِّيَ لَمّا","أَن تَعَلَّقتُهُ بِرُكنَي ثَبيرِ",63,"ر",1,0],["فَكَأَنّي أُمدِدتُها مِن يَدِ القَر","مِ عِمادِ الدينِ الجَوادِ بِمَدِّ",64,"د",1,0],["فكأَني حينما أَبصرته","موبذٌ لاحت له نار السدق",65,"ق",1,0],["فَكَأَنّي بِروحِهِ","في السِياقِ تَقَعقَعُ",66,"ع",1,0],["فكأني مزّقتُ ثوبَ تُرابي","وطويتُ السماء روحاً عليّا",67,"ي",2,0],["فكأني بين كتما","ني وبوحي مستراب",68,"ب",1,0],["فكأنّي قَطّعتُ من حُرِّ وجْهي","ثُمّ سَطَّرتُها بماء بُكائي",69,"ا",2,0],["فَكَأنِّي بِهم يَودُّونَ لَو أنَّ ال","خَوالي مِن اللَّيالي البَواقي",70,"