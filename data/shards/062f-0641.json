n.net/poem44194.html","الكامل"],[39,"برت لك حماء العلاط سجوع","https://www.aldiwan.net/poem53769.html","الطويل"],[39,"طال في رسم مهدد أبده","https://www.aldiwan.net/poem53781.html","المنسرح"],[50,"تجاللت عن فهر وعن جارتي فهر","https://www.aldiwan.net/poem63803.html","الطويل"],[50,"يا سلم إن الرزق جم وقوت","https://www.aldiwan.net/poem64741.html","الكامل"],[46,"أعمارنا جاءت كآي كتابنا","https://www.aldiwan.net/poem22587.html","الطويل"],[46,"أسكت وخل مضلهم وشؤونه","https://www.aldiwan.net/poem23411.html","الكامل"],[46,"منون رجال خبرونا عن البلى","https://www.aldiwan.net/poem23507.html","الطويل"],[15,"نأتك سليمى فالفؤاد قريح","https://www.aldiwan.net/poem45279.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85453","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85730","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85578","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85387","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43839","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43637","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43755","الوافر"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116987","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54261","الخفيف"],[106,"هرم يهوي 2","https://www.poetsgate.com/ViewPoem.aspx?id=179486",""],[106,"صاحب آويته","https://www.poetsgate.com/ViewPoem.aspx?id=179660",""],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[90,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[90,"علموها!","https://www.poetsgate.com/ViewPoem.aspx?id=179031",""],[2,"صَحا القَلبُ عن سلمى وأقصرَ باطِلُهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19479&r=&rc=5",""]],"verses":[["دُفِعنَ فَمِن مُقلَةٍ بِالدُمو","عِ رَيّا وَمِن مُهجَةٍ صادِيَه",0,"ي",2,0],["دَفَنتُهُ وَالحُزنُ مِن بَعدِهِ","يَأبى عَلى الأَيّامِ أَن يُدفَنا",1,"ن",2,0],["دُفِعنَ عَلى غَفَلاتِ الظُنو","نِ يَمضَغنَ مَضغَ العَليقِ الحَكَم",2,"م",1,0],["دَفَعَ الزَمانُ لَكَ النَوائِبَ دَفعَةً","وَتَصَوَّبَ الوادي إِلَيكَ فَسالا",3,"ل",2,0],["دُفِعَت فَأَيُّ الحُزمِ عَنها لَم يَضِق","عَرَقاً وَأَيُّ اللُجمِ لَم يَتَصَلصَلِ",4,"ل",1,0],["دَفعاً بِصَدرِ السَيفِ لَمّا رَأى","أَلّا يَرُدَّ الضَيمَ دَفعاً بِراح",5,"ح",1,0],["دَفَعنَ بِخَضخَضَةٍ لِلمَزادِ","نَجاءً وَخَشخَشَةٍ لِلعِيابِ",6,"ب",1,0],["دَفَعتُ بِكَفّي زِمامي إِلَيكَ","وَقَد كُنتُ أُبطي عَلى مَن حَدا بي",6,"ب",2,0],["دُفِعنَ إِلى اِثنَينِ عِندَ الخُصو","صِ قَد حَبَسا بَينَهُنَّ الإِصارا",7,"ر",2,0],["دَفَنوا تاريخَهُم في قاعِها","وَرَمَوا في إِثرِهِ المَجدَ غُلاما",8,"م",2,0],["دَفَعتُ بِكَ الجَليلَ وَأَنتَ حَيٌّ","فَمَن ذا يَدفَعُ الخَطبَ الجَليلا",9,"ل",2,0],["دفناه مبكياً نضير شبابه","ومبكيةً آدابه وفضائله",10,"ل",2,1],["دِفَقَّةِ المِشيَةِ زَيّافَةٍ","تَهوي خَنوفاً في فُضولِ الزِمام",11,"م",1,0],["دَفنتَ النوى والتمر فيمن تحبه","ودفنُ النوى يا ميّ إحدى الفضائح",12,"ح",1,0],["دفنتكَ يا شخص الحبيب وقد بدا","لعينك حالي قلت إنك دافني",13,"ن",2,0],["دفَّاعُ جارِ حِفاظِهِ منَّاعُهُ","نَفَّاحُ ضيفِ سَمَاحِهِ منَّاحُهُ",14,"ح",2,0],["دُفِعْتُمْ إلى مُلكٍ كثيرٍ سدُودُه","فعادت فُتوح الملك ضِعْفَيْ سُدودِهِ",15,"د",2,0],["دفعتُ من أمك في طيزها","إن كان ما قلت الذي يدفع",16,"ع",1,0],["دفعْتُ لساني إلى صيْقلٍ","وأسلمتُ عِرضي إلى غاسل",17,"ل",1,0],["دُفعنا إليها وهْي زُهرٌ كأنها","خلالَ أنيقِ النَّوْرِ نورٌ مجسَّمُ",18,"م",1,0],["دَفَعنا الجِمالَ ثُمَّ قُلنا لِقَينَةٍ","صَدوحِ الغِناءِ مِن قَطينٍ مُوَلَّدِ",19,"د",1,0],["دَفَعتُ إِلَيهِ وَهوَ يَخنُقُ كَلبَهُ","أَلا كُلُّ كَلبٍ لا أَبا لَكَ نابِحُ",20,"ح",1,0],["دفن الشعب جسم فيصل في قبر","كما يدفن الخليل الخليل",21,"ل",1,0],["دفعته للورد","وبت تحت جلدي",22,"ي",1,0],["دَفَعوا العَوائِقَ بِالثَباتِ وَجاوَزوا","ما سَرَّ مِن قَدَرِ الأُمورِ وَساءَ",23,"ا",2,0],["دَفَنّا التَجارِبَ في حُفرَةٍ","إِلَيها اِنتَهى بِكَ طولُ السَفَر",24,"ر",1,0],["دَفَعتُم غارَةً شَعواءَ عَنهُ","وَذُدتُم عَن حَواضِرِهِ البَلاءَ",25,"ا",2,0],["دَفَعوا إِلى الجَلّادِ أَغلَبَ ماجِداً","يَأسو الجِراحَ وَيُعَتِقُ الأُسَراءَ",26,"ا",2,0],["دَفَعَ اللَهُ حُسَيناً في يَدٍ","كَيَدِ الأَلطافِ رِفقاً وَاِحتِضانا",27,"ن",2,0],["دَفَعَت بُنَيَّتَها لِأَشأَمَ مَضجَعٍ","وَرَمَت بِها في غُربَةٍ وَإِسارِ",28,"ر",1,0],["دُفِعنا وَبُردُ الشَمسِ أَصفَرُ فاقِعٌ","إِلى جِذمِ بابٍ ما يُبَجَّلُ حاجِبُه",29,"ب",2,0],["دَفَعتَ عَنِ الإِسلامِ ما لَو يُصيبُهُ","لَما زالَ شَخصاً بَعدَها مُتَضائِلا",30,"ل",2,0],["دِفاعُ اللَهِ عَنكَ أَقَرَّ مِنّا","قُلوباً جِدَّ طائِشَةِ العُقولِ",31,"ل",1,0],["دَفَعتَ وَمَخشِيٍّ رَداها مَهيبَةٍ","جَعَلتَ سَبيلي مِن مَطالِعِها سَهلا",32,"ل",2,0],["دَفَعوا إِلَيَّ كِتابَهُنَّ وَصِيَّةً","فَوَرِثتُهُنَّ كَأَنَّهُنَّ الجَندَلُ",33,"ل",1,0],["دَفَعتُ إِلى أَيديهِما فَتَقَبَّلا","عَصا مِئَةٍ مِثلَ الفَسيلِ المُكَمَّمِ",34,"م",1,0],["دَفَعْتَهم بِغِرارِ السَّيفِ عن بَلَدٍ","رَحْبٍ تَدافَعَ فيه سَيْلُكَ العَرِمُ",35,"م",1,0],["دفاعُ اللهِ عنك أعمُّ فضلاً","وأحلى في القلوبِ وفي الصُّدورِ",36,"ر",1,0],["دَفَعتَ بِمَعروفٍ مِنَ القَولِ صائِبٍ","إِذا ما أَضَلَّ الناطِقينَ مَفاصِلُه",37,"ل",2,0],["دَفَعَ الخُطوبَ عَنِ الأَنامِ بِعَدلِهِ","وَرعى العِبادَ بِمُقلَةٍ لا تَرقُدُ",38,"د",1,0],["دفعت به في اللظى كالخليل","وعدتِ مباركة ظافره",39,"ر",2,0],["دَفَعت بمركبنا المقا","دِيرُ الخفية والقسم",40,"م",1,0],["دُفِعْتُ ولم أمْلِكْ دفاعَ مُلِمّةٍ","إلى زَمَنٍ في كُلِّ حينٍ أُعاركُه",41,"ك",2,0],["دفنوا اللَّذةَ فيها حيّةً","وأتى الدّهرُ عليها وذهب",42,"ب",1,0],["دفعَ الحوادثَ فاعتزلن سبيلَه","ومضى إلى غاياتِه يَنثالُ",43,"ل",1,0],["دِفاعاً عن محارمكم دِفاعا","أقيموا الدّينَ والدُّنيا جميعا",44,"ع",2,0],["دَفَع اللّواءَ إليكَ لم يُؤثِرْ به","غيرَ الأعزِّ من الحُماةِ الأمنعِ",45,"ع",1,0],["دفعوا الحوادثَ والصرُّوفَ بأَنْفُسٍ","كانت حوادثَ تُتَّقَى وَصُروفا",46,"ف",2,0],["دَفعوا العدوَّ عن البلادِ مُناجزاً","وَرَمَوا به مُتغلِّباً قهّارا",47,"ر",2,0],["دَفَعُوا الجيادَ وصاح عمروٌ صَيحةً","هَاجَ الهزبرُ لها ومَاجَ ال