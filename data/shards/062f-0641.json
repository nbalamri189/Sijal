ل"],[438,"الرزء أفجع أن نسح دموعا","https://www.aldiwan.net/poem14461.html","الكامل"],[438,"الرزء من قلقي أجل وأعظم","https://www.aldiwan.net/poem14482.html","الكامل"],[456,"تركتك يا زمان قلى فدعني","https://www.aldiwan.net/poem55826.html","الوافر"],[456,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[462,"ما للخيال جفا وقد بعد المدى","https://www.aldiwan.net/poem3191.html","عموديه"],[462,"بين القدود وبين أعطاف القنا","https://www.aldiwan.net/poem3325.html","عموديه"],[462,"إلا يا دار لا أوحشت يوماً","https://www.aldiwan.net/poem3402.html","عموديه"],[462,"لولا صدودك يا أمامه","https://www.aldiwan.net/poem3491.html","عموديه"],[462,"رمتني بنجل والسهام جفون","https://www.aldiwan.net/poem3591.html","عموديه"],[462,"غصون الحمى شف المعنى قدودها","https://www.aldiwan.net/poem3618.html","عموديه"],[475,"عشية عجنا بالمطي الرواسم","https://www.aldiwan.net/poem15247.html","الطويل"],[513,"شأن الغرام أجل أن يلحاني","https://www.aldiwan.net/poem12277.html","الكامل"],[513,"أيا سفح المقطم كم سفحنا","https://www.aldiwan.net/poem12289.html","الكامل"],[527,"إن غضبوا جهلا لما قلته","https://www.aldiwan.net/poem37237.html","السريع"],[536,"عبد العزيز أنا فداك","https://www.aldiwan.net/poem48004.html","عموديه"],[549,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[549,"ماذا جنته ليلة التعريف","https://www.aldiwan.net/poem47387.html","الكامل"],[549,"لي من رضابك ما يغني عن الراح","https://www.aldiwan.net/poem47891.html","البسيط"],[549,"بلغنا ليلة الشعب","https://www.aldiwan.net/poem48050.html","الهزج"],[549,"على مثله تذرى العيون دماء","https://www.aldiwan.net/poem48115.html","الطويل"],[551,"نبا به الوساد","https://www.aldiwan.net/poem68396.html","مجزوء الرجز"],[551,"يا عين جودي بدمع منك مدرار","https://www.aldiwan.net/poem68400.html","البسيط"],[571,"بشراي دالت دولة المعصوم","https://www.aldiwan.net/poem3641.html","الكامل"],[573,"عرسكم يأيها الشرب طالق","https://www.aldiwan.net/poem2733.html","الطويل"],[573,"لقد عفت عيشي بعد العفيف","https://www.aldiwan.net/poem2791.html","المتقارب"]],"verses":[["دُفِعنَ فَمِن مُقلَةٍ بِالدُمو","عِ رَيّا وَمِن مُهجَةٍ صادِيَه",0,"ي",2,0],["دَفَنتُهُ وَالحُزنُ مِن بَعدِهِ","يَأبى عَلى الأَيّامِ أَن يُدفَنا",1,"ن",2,0],["دُفِعنَ عَلى غَفَلاتِ الظُنو","نِ يَمضَغنَ مَضغَ العَليقِ الحَكَم",2,"م",1,0],["دَفَعَ الزَمانُ لَكَ النَوائِبَ دَفعَةً","وَتَصَوَّبَ الوادي إِلَيكَ فَسالا",3,"ل",2,0],["دُفِعَت فَأَيُّ الحُزمِ عَنها لَم يَضِق","عَرَقاً وَأَيُّ اللُجمِ لَم يَتَصَلصَلِ",4,"ل",1,0],["دَفعاً بِصَدرِ السَيفِ لَمّا رَأى","أَلّا يَرُدَّ الضَيمَ دَفعاً بِراح",5,"ح",1,0],["دَفَعنَ بِخَضخَضَةٍ لِلمَزادِ","نَجاءً وَخَشخَشَةٍ لِلعِيابِ",6,"ب",1,0],["دَفَعتُ بِكَفّي زِمامي إِلَيكَ","وَقَد كُنتُ أُبطي عَلى مَن حَدا بي",6,"ب",2,0],["دُفِعنَ إِلى اِثنَينِ عِندَ الخُصو","صِ قَد حَبَسا بَينَهُنَّ الإِصارا",7,"ر",2,0],["دَفَنوا تاريخَهُم في قاعِها","وَرَمَوا في إِثرِهِ المَجدَ غُلاما",8,"م",2,0],["دَفَعتُ بِكَ الجَليلَ وَأَنتَ حَيٌّ","فَمَن ذا يَدفَعُ الخَطبَ الجَليلا",9,"ل",2,0],["دفناه مبكياً نضير شبابه","ومبكيةً آدابه وفضائله",10,"ل",2,1],["دِفَقَّةِ المِشيَةِ زَيّافَةٍ","تَهوي خَنوفاً في فُضولِ الزِمام",11,"م",1,0],["دَفنتَ النوى والتمر فيمن تحبه","ودفنُ النوى يا ميّ إحدى الفضائح",12,"ح",1,0],["دفنتكَ يا شخص الحبيب وقد بدا","لعينك حالي قلت إنك دافني",13,"ن",2,0],["دفَّاعُ جارِ حِفاظِهِ منَّاعُهُ","نَفَّاحُ ضيفِ سَمَاحِهِ منَّاحُهُ",14,"ح",2,0],["دُفِعْتُمْ إلى مُلكٍ كثيرٍ سدُودُه","فعادت فُتوح الملك ضِعْفَيْ سُدودِهِ",15,"د",2,0],["دفعتُ من أمك في طيزها","إن كان ما قلت الذي يدفع",16,"ع",1,0],["دفعْتُ لساني إلى صيْقلٍ","وأسلمتُ عِرضي إلى غاسل",17,"ل",1,0],["دُفعنا إليها وهْي زُهرٌ كأنها","خلالَ أنيقِ النَّوْرِ نورٌ مجسَّمُ",18,"م",1,0],["دَفَعنا الجِمالَ ثُمَّ قُلنا لِقَينَةٍ","صَدوحِ الغِناءِ مِن قَطينٍ مُوَلَّدِ",19,"د",1,0],["دَفَعتُ إِلَيهِ وَهوَ يَخنُقُ كَلبَهُ","أَلا كُلُّ كَلبٍ لا أَبا لَكَ نابِحُ",20,"ح",1,0],["دفن الشعب جسم فيصل في قبر","كما يدفن الخليل الخليل",21,"ل",1,0],["دفعته للورد","وبت تحت جلدي",22,"ي",1,0],["دَفَعوا العَوائِقَ بِالثَباتِ وَجاوَزوا","ما سَرَّ مِن قَدَرِ الأُمورِ وَساءَ",23,"ا",2,0],["دَفَنّا التَجارِبَ في حُفرَةٍ","إِلَيها اِنتَهى بِكَ طولُ السَفَر",24,"ر",1,0],["دَفَعتُم غارَةً شَعواءَ عَنهُ","وَذُدتُم عَن حَواضِرِهِ البَلاءَ",25,"ا",2,0],["دَفَعوا إِلى الجَلّادِ أَغلَبَ ماجِداً","يَأسو الجِراحَ وَيُعَتِقُ الأُسَراءَ",26,"ا",2,0],["دَفَعَ اللَهُ حُسَيناً في يَدٍ","كَيَدِ الأَلطافِ رِفقاً وَاِحتِضانا",27,"ن",2,0],["دَفَعَت بُنَيَّتَها لِأَشأَمَ مَضجَعٍ","وَرَمَت بِها في غُربَةٍ وَإِسارِ",28,"ر",1,0],["دُفِعنا وَبُردُ الشَمسِ أَصفَرُ فاقِعٌ","إِلى جِذمِ بابٍ ما يُبَجَّلُ حاجِبُه",29,"ب",2,0],["دَفَعتَ عَنِ الإِسلامِ ما لَو يُصيبُهُ","لَما زالَ شَخصاً بَعدَها مُتَضائِلا",30,"ل",2,0],["دِفاعُ اللَهِ عَنكَ أَقَرَّ مِنّا","قُلوباً جِدَّ طائِشَةِ العُقولِ",31,"ل",1,0],["دَفَعتَ وَمَخشِيٍّ رَداها مَهيبَةٍ","جَعَلتَ سَبيلي مِن مَطالِعِها سَهلا",32,"ل",2,0],["دَفَعوا إِلَيَّ كِتابَهُنَّ وَصِيَّةً","فَوَرِثتُهُنَّ كَأَنَّهُنَّ الجَندَلُ",33,"ل",1,0],["دَفَعتُ إِلى أَيديهِما فَتَقَبَّلا","عَصا مِئَةٍ مِثلَ الفَسيلِ المُكَمَّمِ",34,"م",1,0],["دَفَعْتَهم بِغِرارِ السَّيفِ عن بَلَدٍ","رَحْبٍ تَدافَعَ فيه سَيْلُكَ العَرِمُ",35,"م",1,0],["دفاعُ اللهِ عنك أعمُّ فضلاً","وأحلى في القلوبِ وفي الصُّدورِ",36,"ر",1,0],["دَفَعتَ بِمَعروفٍ مِنَ القَولِ صائِبٍ","إِذا ما أَضَلَّ الناطِقينَ مَفاصِلُه",37,"ل",2,0],["دَفَعَ الخُطوبَ عَنِ الأَنامِ بِعَدلِهِ","وَرعى العِبادَ بِمُقلَةٍ لا تَرقُدُ",38,"د",1,0],["دفعت به في اللظى كالخليل","وعدتِ مباركة ظافره",39,"ر",2,0],["دَفَعت بمركبنا المقا","دِيرُ الخفية والقسم",40,"م",1,0],["دُفِعْتُ ولم أمْلِكْ دفاعَ مُلِمّةٍ","إلى زَمَنٍ في كُلِّ حينٍ أُعاركُه",41,"ك",2,0],["دفنوا اللَّذةَ فيها حيّةً","وأتى الدّهرُ عليها وذهب",42,"ب",1,0],["دفعَ الحوادثَ فاعتزلن سبيلَه","ومضى إلى غاياتِه يَنثالُ",43,"ل",1,0],["دِفاعاً عن محارمكم دِفاعا","أقيموا الدّينَ والدُّنيا جميعا",44,"ع",2,0],["دَفَع اللّواءَ إليكَ لم يُؤثِرْ به","غيرَ الأعزِّ من الحُماةِ الأمنعِ",45,"ع",1,0],["دفعوا الحوادثَ والصرُّوفَ بأَنْفُسٍ","كانت حوادثَ تُتَّقَى وَصُروفا",46,"ف",2,0],["دَفعوا العدوَّ عن البلادِ مُناجزاً","وَرَمَوا به مُتغلِّباً قهّارا",47,"ر",2,0],["دَفَعُوا الجيادَ وصاح عمروٌ صَيحةً","هَاجَ الهزبرُ لها ومَاجَ الغابُ",48,"ب",1,0],["دَفَعتُ إِلَيهِ سَلجَمَ اللَحيِ نَصلُهُ","كَبادِرَةِ الحُوّاءِ وَهوَ وَقيعُ",49,"ع",1,0],["دَفعتُ فيها ذا مَيعَةٍ صَخِباً","مِغلاقَ قَمرٍ يَزينُهُ أَوَدُه",50,"د",2,0],["دَفَنتُ الهَوى حَيّاً فَلَستُ بِزائِرٍ","سُلَيمى وَلا صَفراءَ ما قَرقَرَ القُمري",51,"ي",1,0],["دَفَنتِني حَيّاً وَلا ذَنبَ لي","وَالحَيُّ لا يُدفَنُ حَتّى يَموت",52,"ت",1,0],["دَفَعَ الزَكاةَ إِلى الغَنِيِّ سَفاهَةً","وَغَدا يَحُجُّ فَرَدُّهُ الإِحصارُ",53,"ر",1,0],["دُفِنَ السُرورُ فَما يَبينُ لِعاقِلٍ","رُزءٌ يَكونُ المَوتُ في أَقسامِهِ",54,"م",2,0],["دَفَنّاهُمُ في الأَرضِ دَفنَ تَيَقُّنٍ","وَلا عَلِمَ بِالأَرواحِ غَيرَ ظُنونِ",55,"ن",1,0],["دَفوعٌ لِأَطرافِ الأَنامِلِ ثَرَّةٌ","لَها بَعدَ إِشرافِ العَبيطِ نَشيحُ",56,"ح",1,0],["دفنَّا الحزمَ وَالخلقا","دفنا الصبحَ وَالفلقا",57,"ق",2,1],["دفنا من إذا ما قا","ل يُبدي رأَيه صدقا",57,"ق",2,0],["دفنا من لعادات","لنا موروثة خرقا",57,"ق",2,0],["دفنا كوكباً في لَي","لنا قَد كانَ مؤتلقا",57,"ق",2,0],["دفنا سيداً حراً","بغير الحق ما نطقا",57,"ق",2,0],["دفعوها إلى مشا","نق فيها منونُها",58,"ه",2,1],["دفنوهن قبل موت مُريح","في قبور سود من الحجرات",59,"ت",1,0],["دفعتها يد الطَبيعة بالقو","وة منها قنابلاً في السماء",60,"ا",2,0],["دفَنوا العَروس بحفرة وَتَقهقَروا","متأسفين مقرَّحي الأجفان",61,"ن",1,0],["دَفَقَ التِّبْرُ ضِيَاءً وَدَماً","مُسْتَفِيضَ اللّجِّ ياقُوتاً وَتِبْرَا",62,"ر",2,0],["دَفَنتُ قَلبي وَحُسن صَبري","فَأَينَ مِنّي قُوى الجَليدِ",63,"د",1,0],["دَفَعتُ قَلبي إِلَيكَ رَهناً","أَودَعتُهُ غَيرَ مُستَعيدِ",63,"د",1,0],["دَفَعتُ إِلَيها في الوَداعِ وَديعَةً","وَقُلتُ اِحفَظيها إِنَّني سَأَعودُ",64,"د",1,0],["دَفَنتُ اِبني فَقالَ النا","سُ ربّ الشَمسَ أَدفَنَها",65,"ن",3,0],["دفنتُ الأحبةَ لم آلها","أهيل عليها ترابا وطينا",66,"ن",2,0],["دَفَعَ الشعْبَ للسبيل فكانت","من سَنا هَدْيه أماناً ورُشْدا",67,"د",2,0],["دَفَنَ اللَّهْوَ وَالصِّبا في ثَرَاهَا","وَطَوَى مِنْ شَبابِه عُنْفُوَانَه",68,"ن",2,0],["دفينٌ نناديه، ونهتف باسمه","وهل يسمع الميْتُ الدفين المناديا؟",69,"ي",2,0],["دُفِنَت دون احتفالٍ، ومضت","لم يُرَق في إثرِها الدمعُ سِجاما",70,"م",2,0],["دَفَنَّاه بأيدينا، وكُنَّا","نُرَاعُ إذا أَلمَّ به سُعَال!",71,"ل",1,0],["دفعتَ بما استطعتَ الضُرَّ عنه","فزده ما استطعتَ بك انتِفاعا",72,"ع",2,0],["دفعوا غُنْمَهمُ إليه وراحواً","يحمِلون الأثقالَ والأوزارا",73,"ر",2,0],["دَفَعْتَ بمَعرُوفٍ منَ القوْلِ صائبٍ","إذا ما أضلَّ، القائلينَ، مفاصلهْ",74,"ل",2,0],["دفنت فيها كل ما مر بي","وهل لما يدفن من نشر",75,"ر",1,0],["دَفَعتُ إِلى المُفيضِ إِذا اِستَقَلّوا","عَلى الرَكَباتِ مَطلَعَ كُلِّ شَمسِ",76,"س",1,0],["دَفَعناهُمُ حَتّى تَبَدَّدَ جَمعُهُم","وَحسّرَ عَنّا كُلُّ باغٍ وَجاهِلِ",77,"ل",1,0],["دفنوها فأيّ كوكبٍ مَجد","غيبّوه حتى ينير الظلاما",78,"م",2,0],["دَفَائنُ حُبٍّ في لُحودِ جَوانحٍ","لهابِكَ حَشرٌ كُلَّ يومٍ ومَوعِدُ",79,"د",1,0],["دفن الجود والندى","فسد العجم والعرب",80,"ب",1,0],["دَفَعتَ بِأَمرِ اللَهِ عَنهُم عَدُوَّهُم","وَجَرداءَ لَم تَترُك نِتاجاً وَلا ضَرعا",81,"ع",2,0],["دفتري صاحبي ولوحي رفيقي","وكتابي في كلِ فنٍ أمامي",82,"م",2,0],["دُفِنا كُلّ عاشِقٍ في ضَريحٍ","إِنَّما المَوتُ لَم يَكُن لِفِراقِ",83,"ق",1,0],["دَفَنتِ عدلَ اللَهِ في أَرضِه","فَاِستَوثِقي من شَرِّ ذاكَ المَآلِ",84,"ل",1,0],["دَفَنَت حَبائِلَ مَكرِها فَرَدَدتَها","تَدوى بِغَيظِ صُدورِها المَدفونِ",85,"ن",1,0],["دفاعُ إله الخلقِ عَمَّا يَسُوؤهُ","ويدفَعُ عنه اليأسَ مُذ كانَ في المَهدِ",86,"د",1,0],["دَفَعناكُمُ بِالحِلمِ حَتّى بَطِرتُمُ","وَبِالكَفِّ حَتّى كانَ رَفعُ الأَصابِعِ",87,"ع",1,1],["دفعتهما عصبيّةٌ وحفيظةٌ","والفرسُ يدفعُها شفاءُ غليل",88,"ل",1,0],["دُفِعوا لأبكارِ الخُطوب وعُونها","فَهُمُ الغَداةَ يُصابِرونَ عَنَاءَها",89,"ا",3,0],["دفنت به من فيه روحي وراحتي","فعاد أغض العيش من بعده يبسا",90,"س",2,0],["دفين في الفؤاد به حياتي","إذا صال الفناء على السويه",91,"ي",2,0],["دفنت عطرك الأعاصير يا بل","هاء فابكى واستمتعي بالدموع",92,"ع",1,0],["دَفَعنا ذَنوبَيها فَلَمّا تَفَسَّحَت","جَلَت عَن عَميقِ الرُفغِ جابي الأَباجِرِ",93,"ر",1,0],["دَفَعتَ الأَذى عَنّا وَمَتَّعتَ بِالمُنى","وَما كانَتِ الدُنيا لَنا بِمَتاعِ",94,"ع",1,0