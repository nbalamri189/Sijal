ps://www.poetsgate.com/ViewPoem.aspx?id=205045",""],[5660,"أَحَقُّ النّاسِ أَن تُهجى الشُعوبُ","https://www.poetsgate.com/ViewPoem.aspx?id=23712",""],[5725,"رهطي اعز به","https://www.poetsgate.com/ViewPoem.aspx?id=213595",""],[5781,"بحرٌ بما يكفي لحُبٍّ وعاشقة","https://www.poetsgate.com/ViewPoem.aspx?id=202850",""],[5809,"حروف","https://www.poetsgate.com/ViewPoem.aspx?id=205351",""],[5843,"وصندوق البريد","https://www.poetsgate.com/ViewPoem.aspx?id=51286",""],[5943,"إلهي أبعد الواشينَ عنِّي","https://www.poetsgate.com/ViewPoem.aspx?id=11096",""],[5953,"ألا يا رجال الحق بالحق أبشروا","https://www.poetsgate.com/ViewPoem.aspx?id=93852",""],[5956,"أنا وشعري","https://www.poetsgate.com/ViewPoem.aspx?id=185596",""],[5956,"علامَ تفرح يا قلبي؟","https://www.poetsgate.com/ViewPoem.aspx?id=193517",""],[5956,"المجد الجديد","https://www.poetsgate.com/ViewPoem.aspx?id=194172",""],[6045,"البشير عامر","https://www.poetsgate.com/ViewPoem.aspx?id=135938",""],[6066,"اللج العقيم","https://www.poetsgate.com/ViewPoem.aspx?id=36766",""],[6117,"مانعةُ الرَّخَاء","https://www.poetsgate.com/ViewPoem.aspx?id=182789",""],[6117,"أَبَى الْعِيْدُ إلاَّ ..","https://www.poetsgate.com/ViewPoem.aspx?id=182793",""],[5309,"أنصفت طول حياتي لم ادع احدا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573810",""],[469,"خلا الدست من ذاك الجلال الممنع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574819",""],[6212,"عيون الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1622&r=&rc=3",""],[2914,"أَودَى الشَّبابُ ، حَميدا ، ذو التَّعاجِيبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24234&r=&rc=0",""],[6260,"تمور البصرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68352&r=&rc=44",""],[2220,"سما فاعتلى في كلِّ حال مقام من","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11287&r=&rc=161",""],[6300,"مصير آخر فارس عربيّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82875&r=&rc=46",""],[6308,"صوتٌ من الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87726&r=&rc=4",""],[6320,"لَظَى غَيْظِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83622&r=&rc=3",""],[6324,"نجوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87950&r=&rc=15",""]],"verses":[["يُقارِعُني حَتّى إِذا كَلَّ غَربُهُ","نَسينا التَصافي وَاِندَمَلنا عَلى غَمرِ",0,"ر",1,0],["يُقالُ تَجاوَزوا يا قَومُ هَذا","فَهَذا مِن حَديثِ الرافِضِيَّه",1,"ي",2,0],["يقابلني منك الصباح بوجنةٍ","حَكى شَفَقاً فيها الحَيَاءُ الَّذي تُبدِي",2,"د",2,0],["يقال عن الأضواء في جوف ليله","ببيروت إذ يغشى من الليل دمسه",3,"س",2,0],["يقال انْظروا الممدوح وافقَ مادِحاً","فذا فاضلُ الدُّنيا وهذا سعيده",4,"د",2,0],["يقابل دمعِي باسماً فكأنما","ينظم ما أملت جفوني من النثر",5,"ر",1,0],["يقاسمنا في كلِّ يومٍ جميله","فنثر العطا منه ونثر الثنا منَّا",6,"ن",2,0],["يقال هل امتلأْت وكلُّ خلقٍ","بها فتقول لا هَلْ من مزيدِ",7,"د",1,0],["يُقاسي زفيراً دائباً في صعوده","يُراح ودمعاً دائباً في انحداره",8,"ر",2,0],["يقابلُ الحسنى بأمثالها","ويقرعُ الدهرِسَ بالدهرس",9,"س",1,0],["يقاسي المقاسي شجوه دون غيره","وكل بلاء عند لاقيه أوجع",10,"ع",1,0],["يقابلُ والعيونُ مُصحَّحاتٌ","ويدبِر والعيونُ إليه حُولُ",11,"ل",1,0],["يُقاتِل بِاللَحظِ مَحبوبُنا","وَبالسَيف وَالرُمح أَمضى قِتالِ",12,"ل",1,1],["يُقاسي فُؤادي الوَجدَ وَالحُبَّ واصِلٌ","فَكَيفَ تَراهُ إِن جَفاهُ حَبيبُ",13,"ب",1,0],["يُقالُ كانَ الكَلبُ ذاتَ يَومِ","بَينَ الرِياضِ غارِقاً في النَومِ",14,"م",1,0],["يُقالُ إِنَّ اللَيثَ في ذي الشِدَّه","رَأى مِنَ الذِئبِ صَفا المَوَدَّه",15,"ه",1,1],["يُقالُ كانَت فَأرَةُ الغيطانِ","تَتيهُ بِاِبنَيها عَلى الفيرانِ",16,"ن",1,1],["يُقاتِلُني عَلَيكَ اللَيلُ جِدّاً","وَمُنصَرَفي لَهُ أَمضى السِلاحِ",17,"ح",1,1],["يُقالُ إِذا أَبصَرتُ جَيشاً وَرَبُّهُ","أَمامَكَ رَبٌّ رَبُّ ذا الجَيشِ عَبدُهُ",18,"د",2,0],["يُقارِعُ الدَهرَ مَن يُقارِعُكُم","عَلى مَكانِ المَسودِ وَالسائِد",19,"د",1,0],["يُقاتِلُ الخَطوَ عَنهُ حينَ يَطلُبُهُ","وَيَطرُدُ النَومَ عَنهُ حينَ يَضطَجِعُ",20,"ع",1,0],["يقاتلُ عنك الرأيُ لا الرمحُ بلَّهُ","نجيعٌ ولا بالباتراتِ فُلولُ",21,"ل",1,0],["يقاربُ خطوَ النائباتِ بعقلهِ","وأنعمُه في الناس مستورةُ العقلِ",22,"ل",1,0],["يُقاتِلنَ عَن أَصلابِ لاصِقَةِ الذُرى","مِنَ الطَيرِ غِرباناً عَلَيها نَوازِلُه",23,"ل",2,0],["يُقابلُ الخَصْمُ منه مَنْطِقاً ذَرِباً","والقِرْنُ أزرقَ ماضي الحدِّ مَذْرُوبا",24,"ب",2,0],["يُقاسُ المَرءُ بِالمَرءِ","إِذا ما هُوَ ما شاهُ",25,"ه",1,0],["يُقابِلُني نَداكَ بِبِشرِ وَجهٍ","وَيَلقاني رِضاكَ بِوَجهِ بِشرِ",26,"ر",1,0],["يُقابِلُهُ بُخاريٌّ تَلَظّى","فَتَحسَبُ حَرَّ آبٍ مِنهُ آبا",27,"ب",2,0],["يقارع منهم حاسراً كلّ مُعْلَمٍ","أفاضَ عليه الفارسيَّ المضعفا",28,"ف",2,0],["يقالُ لهُ قاضي القضاةِ تعدِّياً","وظلماً وهذا القولُ للهِ أوجبُ",29,"ب",1,0],["يقايضُ ما يكون بما يُرَجَّى","ويَعطفُ ما يُراد لما يُريد",30,"د",1,0],["يُقادُ إِلى الهَيجاءِ مَن لا يُريدُها","فَيَمشي إِلَيها وَهوَ طَيّانُ ساغِبُ",31,"ب",1,0],["يُقَابِلُ البِشرَ مِنهُ بِالنَّدَى خُلُقٌ","زاكٍ عَلَى العَدْلِ والإِحسانِ مَجبولُ",32,"ل",1,0],["يقابلُ منكَ الدّهرُ فيها شبيهَ مَا","يقابل من شمس الضُّحى الأعين الرُّمد",33,"د",1,0],["يُقالُ لَهُ المُعَلَّلُ وَهوَ عِندي","كَما قالوا وَذاكَ مِنَ الصَوابِ",34,"ب",1,0],["يُقالُ لَهُ مَعنٌ فَإِمّا نَكَستَهُ","لَتَدعو اختَهُ يَوماً فَمَنكوسَهُ نُعمُ",35,"م",1,0],["يُقالُ إِنَّ زَماناً يَستَقيدُ لَهُم","حَتّى يُبَدِّلَ مِن بُؤسٍ بِنَعماءِ",36,"م",3,0],["يُقامِرونَ بِما أوتوهُ مِن حِكَمٍ","وَصاحِبُ الظُلَمِ مَقمورٌ إِذا قَمَرا",37,"ر",2,0],["يُقارِفُ مُستَكبَراتِ الذُنوبِ","وَيَغفُلُ عَن ذَنبِهِ المُقتَرَف",38,"ف",1,0],["يُقالُ أَن سَوفَ يَأتي بَعدَنا عَصرٌ","يُرضى فَتَضبِطُ أُسدَ الغابَةِ الخُطَمُ",39,"م",1,1],["يُقالُ فَيَهْتِمُ الأنْيابَ قَوْلٌ","يُباشِرُها بأنْبَاءٍ عِظَامِ",40,"م",1,0],["يُقال لهم هاكم خذوا ثمر الهدى","فتمتد أيدٍ يرتجفن من الرعب",41,"ب",1,0],["يقاسي القيود الشرق والغرب مطلق","فبين كلا القسمين هذا هُوَ الفرق",42,"ق",1,0],["يُقَالُ غَرْبٌ إِنْ كَانَ شَمْساً","يُقَالُ شَرْقٌ إِنْ كَانَ لَيْلاَ",43,"ل",2,0],["يُقَالُ الشَّعْر فِي النَّادِي","وَلاَ تُسْمَعُ أَقْوَالكْ",44,"ك",1,0],["يُقَالُ الرِّضَى بَعْضُ الغِنَى قُلْتُ كُلُّهُ","وَلَكِنْ لِجِسْمِ المَرْءِ لا لِفُؤَادِهِ",45,"د",2,0],["يقايسُ من يقايسهُ بِلُب","فمَن ذا يجعلون لهُ نظيرَا",46,"ر",2,0],["يُقَال للأمرد أَو غَيره","هَذَا لعمري شَرط ادخالك",47,"ك",1,0],["يقاسون حرًا ما لضب يحمله","يدانِ وبردًا ليس يحمله دُب",48,"ب",1,0],["يقال الأجربان ونحنُ حيٌّ","بنو عمٍّ تجمَّعنا صلاحا",49,"ح",2,0],["يقال : كانوا فهماء الحمى","واليوم لا ينسون أن يفهموا",50,"م",3,0],["يُقاتِلنَ عن أصْلابِ لاصِقَةِ الذُّرَى،","مِنع الطّيْرِ غِرْباناً عَلَيها نَوَازِلُهْ",51,"ل",2,0],["يُقَاوِمْن دُونَ العُمْرِ كُلَّ مُقَاوِمِ","يُجَاذِبْنَ بِالأَوْرَاقِ دَرَّ الغَمَائِمِ",52,"م",1,0],["يقال : كانوا فهماء الحمى","واليوم لا ينوون أن يفهموا",53,"م",3,0],["يقابل احساني بكل اساءة","فلو انني احببت ريما تذآبا",54,"ب",2,0],["يقاظى نُبصِرُ الرؤيا","وعميانٌ نرى الحُسنا",55,"ن",2,0],["يُقَالَ لِلشَّمسِ الكسوفُ والخُسوف","لِقَمَرٍ أمَّا الصَّلاَةُ لِلكُسُوف",56,"ف",1,1],["يقاسي مرار الموت من ألم الجوى","فما لي إلا أنةٌ وزفير",57,"ر",1,0],["يقال بأن الرب عدب وعبده","هو الرب والتكليف ليس بظاهر",58,"ر",1,0],["يُقابِلُ بِالتَسليمِ مِنهُنَّ طالِعٌ","وَيَومئُ بِالتَوديعِ مِنهُنَّ آفِلُ",59,"ل",1,0],["يُقالُ لِلمُدَّعي شِعراً يُعادِلُها","كَذَبتَ ما الضَرَبُ الطَّلحِيُّ كَالضَّرَبِ",60,"ب",1,0],["يُقالُ لي كُلُّ تَفريقٍ لَهُ سَبَبٌ","يَجري فَأورِد عَلَينا الأَمرَ وَالشانا",61,"ن",2,0],["يُقامُ بِها كُلُّ اِمرِئٍ في مَقامِهِ","وَفي السَهوِ شَرعاً قَد أَجازُوا التَلافيا",62,"ي",2,0],["يُقاتلُ عنه الرُّعبُ قبلَ قِتاله","ويضرِب عنه النصرُ قبلَ ضِرابه",63,"ب",2,0],["يُقابل منها كلَّ جنسٍ بآلةٍ","فما فات مطرودٌ هنالك طارِدا",64,"د",2,0],["يقاربني لحاجته لواذا","ملاذ الوفد بالبيت الحرام",65,"م",1,0],["يقال لهم وقد سبقوا أنيبوا","إلى سبل التأله والصيام",65,"م",1,0],["يقال له أيّام يأتي ويتّقي","وعشّاقه يعطونه ما تخيّرا",66,"ر",2,0],["يقابل بالاحسان من كان محسنا","بشاكل بالعدوان حقا من اعتدى",67,"د",2,0],["يقاتلني دهري عليك فلا تعن","ظلوماً مريد الروح يأخذ بالغصب",68,"ب",1,0],["يُقارِعُ مِن دونِ أَحسابِكُم","بِصارِمِ مِقوَلِهِ القاضِبِ",69,"ب",1,0],["يُقَابِلُهَا مِنْ دُونِ تَحْرِيقِ أُرَّمٍ","بِرَأْيٍ لأَِبْكَار ِالْحَوَادِثِ مُنْقَضِّ",70,"ض",1,0],["يقابلني على مدحي بشكرٍ","فأقنع بالمحال عن المُحَالِ",71,"ل",1,0],["يُقايِسُ بَينَ الناسِ حَتّى إِذا اِنتَهى","إِلى العَرَبِ القيّاس طاحَ المقايِسُ",72,"س",1,0],["يُقاتِلونَ بلا ثأرٍ ولا سَبَبٍ","ويهتكونَ فساداً حُرمَةَ الملك",73,"ك",1,0],["يُقَابِلُ السَّعْدُ عَنْهُ مَنْ يُنَاصِبُهُ","فَما صَوارِمُهُ أَو مَا عَوالِيهِ",74,"ي",2,0],["يُقَامُ الجِهَادُ بِهَا والجِلادُ","لِكلِّ فَتىً مِدْرَهٍ مِحْرَب",75,"ب",1,0],["يُقابِلُ وَردَ خَدَّيهِ أَقاحٌ","وَمَنظومُ الحَبابِ إِذا تَبَسَّم",76,"م",1,0],["يُقابِضُ أَرواحَ العِدا باسِطَ النَدى","فَلِلَهِ مِنهُ ذَلِكَ القَبضُ وَالبَسطُ",77,"ط",1,0],["يُقابِلُ الوَردَ بِوَردٍ مِثلِهِ","مِن وَجنَتَيهِ إِن صَحا وَإِن شَرِب",78,"ب",1,0],["يقاؤك للهدى عمراً طويلا","نجاة بل حياة العالمينا",79,"ن",2,0],["يقابل بدر التم منه بطلعةٍ","هي البدر لكن حسنها منه اشهر",80,"ر",1,1],["يُقارِنُ بِالحُباقِ لهُ نِهاقاً","هُمَا شَيْئانِ والسَّمْعانِ وَاحِدْ",81,"د",1,0],["يُقَاسي الأديبُ الأَدِيمَ الذي","تَكادُ الجِبالُ لهُ تَخْضَعُ",82,"ع",1,1],["يُقَاتِلُ عَنهُ الطَّمُّ والرِّمّ مَن عَصَى","وَيَغزُو لَهُ فِي المُلتَقَى الرِّيحُ والضِّحُّ",83,"ح",1,0],["يُقالُ له يا طِرْفُ لا طَرْفَ للورَى","يَنالُ إذا خَفّتْ خُطاكَ مَداكا",84,"ك",2,0],["يقال رُويهبٌ فيه رُهَيبٌ","عُجَيبي من شُرَيرٍ في خُوَيري",85,"ر",2,0],["يُقالُ تركتَ الَّذي حُسنُهُ","يَكادُ يُخَجِّلُ شَمسَ الضُحى",86,"ح",2,1],["يُقالُ لِماذا لَيسَ يسكرُ بَعدما","تَوالَت عَلَيهِ من نَداماهُ قَرقَفُ",87,"ف",1,1],["يُقالُ شِعرُ ابنِ عَبّادٍ فَيعبدُهُ","مَن يَطلُبُ الشعرَ يَدري ما مَعانيهِ",88,"ي",2,0],["يُقالُ أَسرَفتَ وَهَل","يُمكِنُ فيهِ سَرَفُ",89,"ف",1,0],["يُقاتِلُ باللحاظِ ولا سهامٌ","ويَطْعنُ بالقوام ولا سنانُ",90,"ن",1,0],["يقال له اقرأ وارق ما كنت تالياً","فقد فزت في العقبى من الأجر بالأسنا",91,"ن",2,0],["يُقالُ ما تستقِرُّ والهمَّ في","صدرٍ فَيا نِعمتَاهُ لو صَدَقُوا",92,"ق",3,0],["يُقاتِلُهُ كَيما يَحولَ خِضابُهُ","وَهيهاتَ لا يَخفى عَلى اللَحظِ ناصِلُه",93,"ل",2,0],["يُقارِعونَ عِنِ القَومِ الَّذينَ هُمُ","أَولى بِأَحمَدَ في الفُرقانِ إِن نُبِسوا",94,"س",3,0],["يقاتلون العدى صَفًّا فتحسبهم","في يو