{"poems":[[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[94,"ليت شعري","https://www.aldiwan.net/poem38945.html","الخفيف"],[50,"لا تبك رسما بجانب السند","https://www.aldiwan.net/poem62559.html","المنسرح"],[42,"","https://poetry.dctabudhabi.ae/diwan/poem/93167","الخفيف"],[102,"ذكريات شيخين","https://www.poetsgate.com/ViewPoem.aspx?id=50390",""],[101,"لحمُها .. وأظَافري","https://www.poetsgate.com/ViewPoem.aspx?id=16934",""],[199,"بانت حسينة وائتمت بمن بانا","https://www.aldiwan.net/poem54410.html","البسيط"],[203,"كنت أرجوك أن تعين على اله","https://www.aldiwan.net/poem45553.html","الخفيف"],[203,"لكم سادتي أجل احترامي","https://www.aldiwan.net/poem45668.html","الخفيف"],[228,"حمل الداء من شواطىء مصرا","https://www.aldiwan.net/poem41608.html","الخفيف"],[236,"سبح لربك في الظلام الداجي","https://www.aldiwan.net/poem44595.html","الكامل"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[353,"يا طيب شربي بأوقات الأصيل وقد","https://www.aldiwan.net/poem19951.html","البسيط"],[376,"كل من يستكفني يغريني","https://www.aldiwan.net/poem57066.html","الخفيف"],[376,"ثم أصبحت أكتم الناس ما أصبح","https://www.aldiwan.net/poem57112.html","البسيط"],[376,"نحن يوما وصل ويوما فراق","https://www.aldiwan.net/poem57277.html","الخفيف"],[409,"هل في القلوب بيوم الحشر إذعان","https://www.aldiwan.net/poem33388.html","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56126","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1399,"","https://poetry.dctabudhabi.ae/diwan/poem/143713","الخفيف"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77869","الكامل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102537","المواليا"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116494","الرجز"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205855","الخفيف"],[2827,"","https://poetry.dctabudhabi.ae/diwan/poem/144881","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204922","الرمل"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3008,"","https://poetry.dctabudhabi.ae/diwan/poem/103195","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74305","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110063","الخفيف"],[3715,"","https://poetry.dctabudhabi.ae/diwan/poem/17486","البسيط"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[5302,"بين خوف وهموم","https://www.poetsgate.com/ViewPoem.aspx?id=201379",""],[5431,"حول المذابح كم يطيب المرقصُ","https://www.poetsgate.com/ViewPoem.aspx?id=185558",""],[5431,"في بهو عشقك هذا القلب قد سجدا","https://www.poetsgate.com/ViewPoem.aspx?id=190123",""],[5596,"لطف الاعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=206379",""],[5910,"بردة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=208729",""]],"verses":[["ثُمَّ أَصدَرناهُما في وارِدٍ","صادِرٍ وَهمٍ صُواهُ قَد مَثَل",0,"ل",1,0],["ثُمَّ أُصْغِي عَلَّنِي","أُسمعُ ترديدَ أَنِيني",1,"ي",1,0],["ثُمَّ اِصطَبِح مِن أَميرَةٍ حُجِبَت","عَن كُلِّ عَينٍ بِالصَونِ وَالرَصَدِ",2,"د",1,0],["ثُمَّ أَصغَت لَهُ وَلَو كانَ عِندي","قالُهُ قُلتُ عَدِّهِ لِسِواها",3,"ا",3,0],["ثم اصبحنا نشازا ، صوتنا","في ضجيج اليوم ،كالهمس الأبح",4,"ح",1,0],["ثم أصبحت ، يا شقية ، بعدي","ربوة .. لا تزورها الأمطار",5,"ر",1,0],["ثُمَّ اِصطَفى اللَهُ لِلإِسلامِ بَعدَهُما","مِن أَهلِ بَيتِهِما نوراً وَبُرهانا",6,"ن",2,0],["ثمَّ أصبحتَ بالودادِ جواداً","وفتى الجودِ بالودادِ ضنينُ",7,"ن",1,0],["ثم أصبحتُ بعد ذلكَ طفلاً","لا أقاسي سوى عذاب الفِطام",8,"م",1,0],["ثُمَّ أَصغى لِنَغمَةٍ في حنايا","هُ تَلوّى لِذِكرِها وَاِقشَعرّا",9,"ر",2,0],["ثم اصطفى منهم عباداً خصّهم","بنبوة هي عصمة للآجي",10,"ج",2,0],["ثُمَّ اِصطَفى مِنهُم قُرَيشاً وَاِصطَفى","أَبناءَ هاشِم الفَتى المِطعانِ",11,"ن",1,0],["ثُمَّ اِصطَفى خَيرَ الأَنامِ مُحَمَّداً","مِن هاشِم فَسَمَت عَلى قَحطانِ",11,"ن",1,0],["ثُمَّ اِصطَفاهُ حَبيباً بارِئِ النَسَمِ","فَظاهِرُ الحُسنِ فيهِ مِثلُ باطِنِهِ",12,"ه",1,0],["ثُمَّ اصْطبْحنا فَدَرّتْ مِن أَبَارِقِها","والشَّمْسُ مِن شَرْقِها فارْتَحْتُ وارْتَاحَا",13,"ح",2,0],["ثمَّ أصبحتُ أشكرُ الكأسَ وال","مُهدي وإن كانَ شُكره يُعييني",14,"ن",2,0],["ثم أصبَحتُ أكتُم النَّاسَ ما أص","بَحَ فيه لكلِّ عَينٍ عَلامَه",15,"م",2,1],["ثمَّ أصبَحتُ أستَريحُ إِلى كَش","فِ حَديثي ويتعبُ العُشَّاقُ",16,"ق",1,0],["ثم أصلحوا بعد هذا ذات بينكم","واستنصحو وانصحوا من خين أو خانوا",17,"ن",3,0],["ثم اصطفوا شيخاً يوافقهم على","درسٍ خبيثٍ ليت لا يتوفقُ",18,"ق",1,0],["ثم أصول هذه ثمانيه","في اللفظ وزنا فاعبر مبانيه",19,"ه",1,0],["ثم أصبحتُ بعد خفضٍ ولهوٍ","مدنفاً مفرداً محالفَ عسرِ",20,"ر",1,0],["ثم اِصطَفى منه المني","فَصار ماء في الرحم",21,"م",1,0],["ثُمَّ اِصطَفى رَبُّكَ إِبراهيما","فَلَم يَزَل في خَلقِهِ رَحيما",22,"م",2,0],["ثم أصحابه وخربه ومواليه","ما سرى ركب إلى يثرب بحاديه",23,"ي",2,0],["ثم اصلى دائما مسلما","على النبى المصطفى معظما",24,"م",2,0],["ثم أصماه نابل في صميم ال","نحر فارتدّ للتراب حطاما",25,"م",2,0],["ثم أصبحت أشتكي عثر السك","ر وعزمي زيارتيك ابتكارا",26,"ر",2,0],["ثم أصحو ناظراً في واقعي","عائداً من سفرتي بالذكريات",27,"ت",1,0],["ثُمَّ اِصطَفاه حَبيبا بارئ النسم","جَمال ظاهره من نور باطنه",28,"ه",1,0],["ثم أصبحت قد أنخت ركابي","عند رحب الفناء والأعطان",29,"ن",1,0],["ثُم أَصبَحت عَن سِواه غَنياً","وَتَحصنت فيهِ مِن كُل حادث",30,"ث",1,0],["ثم أَصموا قلبَ الغَوِيّ فأَهوى","عن سُهادٍ لا عن قِسِيّ سِهامِ",31,"م",1,0],["ثُمَّ اِصطَبَحتُ كُمَيتاً قَرقَفاً أُنُفاً","مِن طَيِّبِ الراحِ وَاللَذّاتُ تَعليلُ",32,"ل",1,0],["ثُمّ اصْطَفاهُ حَبِيبَاً بارِىَُ النَّسَمِ","إِنْ قالَ فَالدُّرُّ يَزْهُو في مَعادِنِهِ",33,"ه",1,0],["ثم أصغى لنجمة أرجعته","نحو ما شده بغير اقتناع",34,"ع",1,0],["ثم اصطفى للنار قلبي راقصا","حول المذابح كم يطيب المرقصُ",35,"ص",1,0],["ثم اصطفيتك للنيران تطعمها","اركض برجلك هذا الصرح قد وقدا",36,"د",2,0],["ثم اصطفاك لأمر واصطفاك به","أبشر بفضلٍ من الرحمن موفور",37,"ر",1,0],["ثُمَّ اصطفاكَ فليس مِن أحَدٍ لِمَا","أوتيتَ أهلًا يَرتجِي أنْ يغنَمَهْ",38,"م",2,0]]}