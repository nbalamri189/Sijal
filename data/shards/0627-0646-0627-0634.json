{"poems":[[53,"إن أشر الخطب فلا روعة","https://www.aldiwan.net/poem29882.html","السريع"],[53,"أناشد أنت أطلالا بذي القور","https://www.aldiwan.net/poem30217.html","البسيط"],[53,"من شافعي وذنوبي عندها الكبر","https://www.aldiwan.net/poem30415.html","البسيط"],[53,"في كل يوم لأحبة مطرح","https://www.aldiwan.net/poem30650.html","الكامل"],[77,"وقف الغرام على ثناك لساني","https://www.aldiwan.net/poem36047.html","الكامل"],[77,"ألحظك أم سيف عمرو أعيدا","https://www.aldiwan.net/poem36612.html","المتقارب"],[77,"أبدى لداعي الفوز وجه منيب","https://www.aldiwan.net/poem36767.html","الكامل"],[73,"راحت فصح بها السقيم","https://www.aldiwan.net/poem11915.html","مجزوء الكامل"],[83,"معاذ الهوى أن أصحب القلب ساليا","https://www.aldiwan.net/poem54225.html","الطويل"],[88,"هو الليل يغريه الأسى فيطول","https://www.aldiwan.net/poem44837.html","الطويل"],[88,"حق للدمع أن يكون نشيدا","https://www.aldiwan.net/poem45032.html","الخفيف"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[51,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[51,"أنا شبه لخدكا","https://www.aldiwan.net/poem65776.html","مجزوء الخفيف"],[51,"قل لأيوب والكلام سجال","https://www.aldiwan.net/poem65887.html","الخفيف"],[51,"أنا صب مستهام","https://www.aldiwan.net/poem66023.html","مجزوء الرمل"],[51,"أيها الشاتمي في كل حين","https://www.aldiwan.net/poem66532.html","الخفيف"],[91,"سلام عليكم رجال الوفاء","https://www.aldiwan.net/poem8785.html","عموديه"],[91,"أنا لست في دنيا الخيال ولا الكرى","https://www.aldiwan.net/poem8868.html","عموديه"],[91,"أنا من أنا يا ترى في الوجود","https://www.aldiwan.net/poem8977.html","عموديه"],[70,"أيا باكيا لزمان الصبا","https://www.aldiwan.net/poem42382.html","المتقارب"],[89,"انا شيخ بذكرياتي احيا","https://www.aldiwan.net/poem44733.html","الخفيف"],[89,"أضاء ثم تدلى يأفل القمر","https://www.aldiwan.net/poem44783.html","البسيط"],[89,"أنا شاعر فاذا أطلت عنائي","https://www.aldiwan.net/poem44952.html","الكامل"],[85,"لا السهد يدنيني إليه ولا الكرى","https://www.aldiwan.net/poem63716.html","الطويل"],[45,"أناشد الغيث كي تهمي غواديه","https://www.aldiwan.net/poem66852.html","البسيط"],[61,"لي منزل كوجار الضب أنزله","https://www.aldiwan.net/poem51506.html","البسيط"],[61,"أناشد دهري أن يعود كما بدا","https://www.aldiwan.net/poem51709.html","الطويل"],[97,"قل للبخيل إذا ما عز مشرعه","https://www.aldiwan.net/poem24784.html","البسيط"],[97,"يا حبيب الروح يا روح الأماني","https://www.aldiwan.net/poem24800.html","الرمل"],[97,"أناشدك الهوى هل أنت مثلي","https://www.aldiwan.net/poem24874.html","الوافر"],[80,"هات كأس الراح أو خذها إليك","https://www.aldiwan.net/poem31354.html","الرمل"],[90,"أرح ركابك من أين ومن عثر","https://www.aldiwan.net/poem60154.html","عموديه"],[105,"يوم الشهيد رجعت أيمن مرجع","https://www.aldiwan.net/poem42070.html","الكامل"],[105,"أعدوا لأعلام البيان المنابرا","https://www.aldiwan.net/poem42086.html","الطويل"],[105,"نفرن أصيلا كسرب المها","https://www.aldiwan.net/poem43157.html","المتقارب"],[105,"بني عامر ردوا عن الشر عامرا","https://www.aldiwan.net/poem44014.html","الطويل"],[104,"رسالة المتنبي الأخيرة إلى سيف الدولة","https://www.aldiwan.net/poem26161.html","عموديه"],[81,"لست أنسى الأحباب ما دمت حيا","https://www.aldiwan.net/poem61296.html","الطويل"],[46,"ما لي رأيتك معرضا","https://www.aldiwan.net/poem22991.html","مجزوء الكامل"],[19,"ودع لميس وداع الصارم اللاحي","https://www.aldiwan.net/poem326.html",""],[15,"هبت تلوم وليست ساعة اللاحي","https://www.aldiwan.net/poem45277.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85322","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85384","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39662","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42607","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54913","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54274","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54244","الكامل"],[106,"تمثال فينوس","https://www.poetsgate.com/ViewPoem.aspx?id=179776",""],[90,"الوحدة العربية الممزقة","https://www.poetsgate.com/ViewPoem.aspx?id=178953",""],[80,"هات كأس الراح أو خذها إليكْ","https://www.poetsgate.com/ViewPoem.aspx?id=3480",""],[99,"إليه في يوم ميلاده","https://www.poetsgate.com/ViewPoem.aspx?id=211910",""],[51,"قُلْ لأيوبَ والكلامُ سجالُ","https://www.poetsgate.com/ViewPoem.aspx?id=30257",""]],"verses":[["إِن أَشِرَ الخَطبُ فَلا رَوعَةٌ","أَو عَظُمَ الأَمرُ فَصَبرٌ جَميل",0,"ل",1,1],["أَناشِدٌ أَنتَ أَطلالاً بِذي القورِ","أَضَلَّها جَوَلانُ القَطرِ وَالمورِ",1,"ر",1,1],["إِن أَشهَدِ القَومَ لا أَعلَم نَجِيَّهُمُ","ماذا قَضَوا وَيُجَمجِم دونِيَ الخَبَرُ",2,"ر",1,0],["إِن أَشكُ فِعلَكِ مِن فِراقِ أَحِبَّتي","فَلَسوءُ فِعلِكِ في عِذاري أَقبَحُ",3,"ح",1,0],["أَنَا شِيعَةٌ لَكَ حَيْثُ كُنْتَ قَضِيَّةٌ","لَمْ يَخْتَلف فِي حُكْمِهَا نَفْسَانِ",4,"ن",1,0],["أُناشِدُكَ اللّهَ في مُغْرَمٍ","أحَلْتَ عليْهِ الجَفا والصُّدودا",5,"د",2,0],["إن أشرقت شمس شَرِقتُ بِعَبرَتي","وَتَفِيضُ فِي وَقْتِ الْغُرُوبِ غُرُوِبي",6,"ب",2,0],["إِن أَشمَسَت تِلكَ الطَلاقَةُ","فَالنَدى مِنها مُقيم",7,"م",1,0],["أناشدكم والحرُّ أَوْفَى بعهده","ولن يعدم الإحسانُ والخيرُ جاريا",8,"ي",2,0],["أناشدكم أين المدارس إِنها","على الكون فيكم والحياة دليل",9,"ل",1,0],["أنا شاطرتك الأسى بدموع","كنّ للحزن في الفؤاد وقودا",10,"د",2,0],["أنا شاكٍ إليك بعضَ ثِقاتي","فافهم اللحنَ فهو كالإعرابِ",11,"ب",1,0],["إن أَشارتْ بطرفها فَسَحُورٌ","أَوْ أشارتْ بكفِّها فخلُوبُ",12,"ب",1,0],["أنا شِبهٌ لخدِّكا","ورسولٌ لعَبْدكا",13,"ك",2,1],["أنا شؤمي فيما تقولون عزَّا","لٌ ولكنَّ شؤمَكم قتَّالُ",14,"ل",1,0],["أنا شاكيك إلى مَنْ","هو للعدْل قَوامُ",15,"م",1,0],["أنا شيخٌ أنيك أمَّ مُهاجيْ","يَ وأَفْري أديمَهُ بلساني",16,"ي",1,0],["أَنا شاعِرٌ أَبَداً تائِقٌ","إِلى الحُسنِ في الناس وَالكائِنات",17,"ت",1,0],["أَنا شاعِرٌ ما لاحَ طَيفُ مَلاحَةٍ","إِلّا وَهَلَّلَ لِلجَمال وَكَبَّرا",18,"ر",2,0],["أَنا شَبَحٌ راكِضٌ مُسرِعٌ","مَعَ الزَمَنِ الراكِضِ المُسرِعِ",19,"ع",1,0],["أُناشِدُكَ اللَهَ قِف ساعَةً","أَقُل ما لَدَيَّ وَقُل ما لَدَيكَ",20,"ك",1,0],["انا شيخ بذكرياتي احيا","فهي ان لم تكن فاني قاض",21,"ض",1,1],["انا شبيهان في البلوى بمجتمع","فيه كلانا لقاء الموت ينتظر",22,"ر",1,0],["أنا شاعر فاذا أطلت عنائي","قامت عليك قيامة الشعراء",23,"ا",2,1],["إِن أَشرَقَت زَهراءَ تَسمو لِلضُحى","وَإِذا هَوَت حَمراءَ في تِلكَ الذُرى",24,"ر",2,0],["أُناشِدُ الغَيثَ كَي تَهمي غَواديهِ","عَلى العَقيقِ وَإِن أَقوَت مَغانيهِ",25,"ي",2,1],["أُناشِدُ الغَيْثَ أن يَجتازَه أبداً","ولامعَ البَرْقِ أن يَغْشاه إِحراقا",26,"ق",2,0],["أُناشِدُ دَهْري أن يَعودَ كما بَدا","فَقد غارَ بي في الحادثاتِ وأنجدَا",27,"د",2,1],["أنا شهيدك والقلب الضحوك إذا","أدميتَه والمغني إذ تقطّعُه",28,"ع",2,0],["أنا شاديك ولحني لك وحدك","فاقضِ ما ترضاه في يومي وأمسي",29,"ي",1,0],["أناشدك الهوى هل أنت مثلي","نهاري فيك أشجانٌ وليلي",30,"ل",2,1],["أَنا شَمسٌ وَبَعيدٌ فَلَكي","وَضِيائي نافِرٌ مِن راحَتَيك",31,"ك",1,0],["أناشدٌ أنت حتفاً صنعَ منتحرِ","أم شابكٌ أنت , مغتراً, يدَ القدر",32,"ر",1,0],["إنّا شَرَعنا لِلكنانةِ دِينَها","فَقَضَى على الدِّينِ الذي لم يُشرعِ",33,"ع",1,0],["أُناشِدُكم لا تَجْعَلوني كصائحٍ","يُنادِي صَدىً في مُلتَقى الرّيحِ حائرا",34,"ر",2,0],["أُناشِدُهُنَّ ذِمامَ الهَوى","وَلَو ذُقنَهُ لَشَفَينَ الصَدى",35,"ا",1,0],["أناشِدُكم هل صاحبَ الوفدُ منهما","بني عامرٍ إلا أثيماً وفاجرا",36,"ر",2,0],["أنا شاعر الدنيا ... تبطن ظهرها","شعري ... يشرق عبرها ويغرب",37,"ب",1,0],["أنا شاعر الأفلاك كل كليمة","مني ... على شفق الخلود تلهب",37,"ب",1,0],["أنَا شَيخُ الغَرَامِ مَن يَتَّبِعنِي","أهدِهِ فِي الهَوى سِرَاطاً سَوِيَّا",38,"ي",2,0],["إِنّا شَتَونا فَوقَها","وَلَعَلَّنا فيها نَصيفُ",39,"ف",1,0],["إِن أَشرَبِ الخَمرَ أَو أُرزَأ لَها ثَمَن","فَلا مَحالَةَ يَوماً أَنَّني صاحي",40,"ح",2,0],["إِن أَشرَبِ الخَمرَ أَو أُرزَأَ لَها ثَمَناً","فَلا مَحالَةَ يَوماً أَنَّني صاحي",41,"ي",1,0],["إنَّ أشقى البلاد ما كان يجري","في أراضيه دجلة والفرات",42,"ت",1,0],["إن اشتد أمر فادح بسموا له","كذاك النجوم الزهر في الليل تلمع",43,"ع",1,0],["أناشدكُمْ والشرقُ بينَ مطامعٍ","تُهددهُ في حوزةٍ وكيانِ",44,"ن",1,0],["أَنَاشِيدَ فِيهَا لِلْمَلِيحَةِ وَالْهَوَى","مَعَاذِيرُ أَحْوَالٍ يَلِينُ لَهَا الصَّخْرُ",45,"ر",1,0],["إِن أَشْبَالَكَ الأَعِزَّاءَ أَيقَا","ظٌ فَنَمْ عَنْهُمُ أَمِيناً قَرِيرَا",46,"ر",2,0],["إن اشتكى النيلُ مسَّ ضيمٍ","فحرِّموا حولَه الورودا",47,"د",2,0],["أنا شعري كالطَيْرِ يُفْزِعُهُ الَخُّ","ويرتاعُ من حَفيف النِبال",48,"ل",1,0],["إن أشكلت دُهْمُ الأمورِ وأغلقتْ","أبوابَها فسلوه عن مِفتاحها",49,"ح",3,0],["أنا شاعرٌ متحرِّرٌ","لا راهبٌ في ديره",50,"ر",2,0],["انا شاعرٌ يبغى الوفاق موِّحد","بين الشُّعوب سبيلُه الارشاد",51,"د",1,0],["أنا شمسٌ وبعيد فلكي","وضيائي نافرٌ من راحيتكْ",52,"ك",1,0],["أنا شجرُ الأحزان ، أنزفُ دائماً","وفى الثلج والأنواءِ .. أعطى وأُثمرُ",53,"ر",1,0],["أنا شؤمي فيما تقولون عزْ","زالٌ ولكن شؤمكمُ قتَّالُ",54,"ل",1,0]]}