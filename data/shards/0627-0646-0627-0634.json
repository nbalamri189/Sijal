,"تمرين يا ذات الملاء المزيل","https://www.aldiwan.net/poem35579.html","الطويل"],[268,"أحن إلى طيب الغدائر والفم","https://www.aldiwan.net/poem35634.html","الطويل"],[268,"أدمشق أين بنو أمية قولي","https://www.aldiwan.net/poem35651.html","الكامل"],[268,"أطالعة زهراء من ليل أحزان","https://www.aldiwan.net/poem35673.html","الطويل"],[278,"هبوا طيفكم أعدى على النأي مسراه","https://www.aldiwan.net/poem60774.html","الطويل"],[288,"أناشدك الله يا قاسيه","https://www.aldiwan.net/poem11684.html","المتقارب"],[301,"فتش حشاي تجدها","https://www.aldiwan.net/poem58223.html","المجتث"],[318,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[326,"فوق هذي الربا أقمت وحيدا","https://www.aldiwan.net/poem54989.html","الخفيف"],[364,"كفيت في البدر انتكاس الهلال","https://www.aldiwan.net/poem17071.html","السريع"],[364,"ما العجب في خلق ذاك الخلق بالعجب","https://www.aldiwan.net/poem17312.html","البسيط"],[374,"قدك البعاد فهل إليك سبيل","https://www.aldiwan.net/poem59293.html","الكامل"],[399,"كم ذا يذوب أسى وكم يتجلد","https://www.aldiwan.net/poem46938.html","الكامل"],[402,"يا مخلف الميعاد كم تجفوني","https://www.aldiwan.net/poem49706.html","الكامل"],[413,"جدد اللذة حتى نتجدد","https://www.aldiwan.net/poem54102.html","الرمل"],[418,"لست أنسى الأحباب ما دمت حيا","https://www.aldiwan.net/poem46398.html","الخفيف"],[429,"دون ما بيننا من الود يكفي","https://www.aldiwan.net/poem12384.html","الخفيف"],[429,"أصبحت من صرف الزمان الجاري","https://www.aldiwan.net/poem12527.html","الكامل"],[429,"ومسامر تسليك عن سنة الكرى","https://www.aldiwan.net/poem12628.html","الكامل"],[429,"أيجور الزمان يا ثقة المل","https://www.aldiwan.net/poem12784.html","الخفيف"],[434,"سقاه الصبا خمر الدلال المردد","https://www.aldiwan.net/poem2561.html","الطويل"],[438,"شوقي إليك على نواك أهامني","https://www.aldiwan.net/poem14321.html","الكامل"],[438,"نضحتك لو طاوعت من لك ينصح","https://www.aldiwan.net/poem14424.html","الطويل"],[451,"تحية مغترب حاضر","https://www.aldiwan.net/poem61733.html","المتقارب"],[456,"أجيراننا بالغور والركب متهِم","https://www.aldiwan.net/poem55875.html","الطويل"],[462,"سهادي وليلي فيك ما لها حد","https://www.aldiwan.net/poem3629.html","عموديه"],[498,"قل للذي فينا تمسك مخلصا","https://www.aldiwan.net/poem37724.html","الكامل"],[498,"للقلب في سبك الحروف معان","https://www.aldiwan.net/poem37757.html","الكامل"],[498,"ما للفؤاد بكم طرق","https://www.aldiwan.net/poem37946.html","مجزوء الكامل"],[556,"زر بنات القسوس في دير هنه","https://www.aldiwan.net/poem33712.html","الخفيف"],[556,"طلعت شمسنا على الأفلاك","https://www.aldiwan.net/poem34274.html","الخفيف"],[556,"اغسلوا بي نجاسة الوسواس","https://www.aldiwan.net/poem34440.html","الخفيف"],[556,"الله أنزل حكم أمري","https://www.aldiwan.net/poem34521.html","مجزوء الكامل"],[556,"حرم آمن لكعبة قلبي","https://www.aldiwan.net/poem34955.html","الخفيف"],[573,"رحلوا فلست مسائلاً عن دارهم","https://www.aldiwan.net/poem2861.html","الكامل"]],"verses":[["إِن أَشِرَ الخَطبُ فَلا رَوعَةٌ","أَو عَظُمَ الأَمرُ فَصَبرٌ جَميل",0,"ل",1,1],["أَناشِدٌ أَنتَ أَطلالاً بِذي القورِ","أَضَلَّها جَوَلانُ القَطرِ وَالمورِ",1,"ر",1,1],["إِن أَشهَدِ القَومَ لا أَعلَم نَجِيَّهُمُ","ماذا قَضَوا وَيُجَمجِم دونِيَ الخَبَرُ",2,"ر",1,0],["إِن أَشكُ فِعلَكِ مِن فِراقِ أَحِبَّتي","فَلَسوءُ فِعلِكِ في عِذاري أَقبَحُ",3,"ح",1,0],["أَنَا شِيعَةٌ لَكَ حَيْثُ كُنْتَ قَضِيَّةٌ","لَمْ يَخْتَلف فِي حُكْمِهَا نَفْسَانِ",4,"ن",1,0],["أُناشِدُكَ اللّهَ في مُغْرَمٍ","أحَلْتَ عليْهِ الجَفا والصُّدودا",5,"د",2,0],["إن أشرقت شمس شَرِقتُ بِعَبرَتي","وَتَفِيضُ فِي وَقْتِ الْغُرُوبِ غُرُوِبي",6,"ب",2,0],["إِن أَشمَسَت تِلكَ الطَلاقَةُ","فَالنَدى مِنها مُقيم",7,"م",1,0],["أناشدكم والحرُّ أَوْفَى بعهده","ولن يعدم الإحسانُ والخيرُ جاريا",8,"ي",2,0],["أناشدكم أين المدارس إِنها","على الكون فيكم والحياة دليل",9,"ل",1,0],["أنا شاطرتك الأسى بدموع","كنّ للحزن في الفؤاد وقودا",10,"د",2,0],["أنا شاكٍ إليك بعضَ ثِقاتي","فافهم اللحنَ فهو كالإعرابِ",11,"ب",1,0],["إن أَشارتْ بطرفها فَسَحُورٌ","أَوْ أشارتْ بكفِّها فخلُوبُ",12,"ب",1,0],["أنا شِبهٌ لخدِّكا","ورسولٌ لعَبْدكا",13,"ك",2,1],["أنا شؤمي فيما تقولون عزَّا","لٌ ولكنَّ شؤمَكم قتَّالُ",14,"ل",1,0],["أنا شاكيك إلى مَنْ","هو للعدْل قَوامُ",15,"م",1,0],["أنا شيخٌ أنيك أمَّ مُهاجيْ","يَ وأَفْري أديمَهُ بلساني",16,"ي",1,0],["أَنا شاعِرٌ أَبَداً تائِقٌ","إِلى الحُسنِ في الناس وَالكائِنات",17,"ت",1,0],["أَنا شاعِرٌ ما لاحَ طَيفُ مَلاحَةٍ","إِلّا وَهَلَّلَ لِلجَمال وَكَبَّرا",18,"ر",2,0],["أَنا شَبَحٌ راكِضٌ مُسرِعٌ","مَعَ الزَمَنِ الراكِضِ المُسرِعِ",19,"ع",1,0],["أُناشِدُكَ اللَهَ قِف ساعَةً","أَقُل ما لَدَيَّ وَقُل ما لَدَيكَ",20,"ك",1,0],["انا شيخ بذكرياتي احيا","فهي ان لم تكن فاني قاض",21,"ض",1,1],["انا شبيهان في البلوى بمجتمع","فيه كلانا لقاء الموت ينتظر",22,"ر",1,0],["أنا شاعر فاذا أطلت عنائي","قامت عليك قيامة الشعراء",23,"ا",2,1],["إِن أَشرَقَت زَهراءَ تَسمو لِلضُحى","وَإِذا هَوَت حَمراءَ في تِلكَ الذُرى",24,"ر",2,0],["أُناشِدُ الغَيثَ كَي تَهمي غَواديهِ","عَلى العَقيقِ وَإِن أَقوَت مَغانيهِ",25,"ي",2,1],["أُناشِدُ الغَيْثَ أن يَجتازَه أبداً","ولامعَ البَرْقِ أن يَغْشاه إِحراقا",26,"ق",2,0],["أُناشِدُ دَهْري أن يَعودَ كما بَدا","فَقد غارَ بي في الحادثاتِ وأنجدَا",27,"د",2,1],["أنا شهيدك والقلب الضحوك إذا","أدميتَه والمغني إذ تقطّعُه",28,"ع",2,0],["أنا شاديك ولحني لك وحدك","فاقضِ ما ترضاه في يومي وأمسي",29,"ي",1,0],["أناشدك الهوى هل أنت مثلي","نهاري فيك أشجانٌ وليلي",30,"ل",2,1],["أَنا شَمسٌ وَبَعيدٌ فَلَكي","وَضِيائي نافِرٌ مِن راحَتَيك",31,"ك",1,0],["أناشدٌ أنت حتفاً صنعَ منتحرِ","أم شابكٌ أنت , مغتراً, يدَ القدر",32,"ر",1,0],["إنّا شَرَعنا لِلكنانةِ دِينَها","فَقَضَى على الدِّينِ الذي لم يُشرعِ",33,"ع",1,0],["أُناشِدُكم لا تَجْعَلوني كصائحٍ","يُنادِي صَدىً في مُلتَقى الرّيحِ حائرا",34,"ر",2,0],["أُناشِدُهُنَّ ذِمامَ الهَوى","وَلَو ذُقنَهُ لَشَفَينَ الصَدى",35,"ا",1,0],["أناشِدُكم هل صاحبَ الوفدُ منهما","بني عامرٍ إلا أثيماً وفاجرا",36,"ر",2,0],["أنا شاعر الدنيا ... تبطن ظهرها","شعري ... يشرق عبرها ويغرب",37,"ب",1,0],["أنا شاعر الأفلاك كل كليمة","مني ... على شفق الخلود تلهب",37,"ب",1,0],["أنَا شَيخُ الغَرَامِ مَن يَتَّبِعنِي","أهدِهِ فِي الهَوى سِرَاطاً سَوِيَّا",38,"ي",2,0],["إِنّا شَتَونا فَوقَها","وَلَعَلَّنا فيها نَصيفُ",39,"ف",1,0],["إِن أَشرَبِ الخَمرَ أَو أُرزَأ لَها ثَمَن","فَلا مَحالَةَ يَوماً أَنَّني صاحي",40,"ح",2,0],["إِن أَشرَبِ الخَمرَ أَو أُرزَأَ لَها ثَمَناً","فَلا مَحالَةَ يَوماً أَنَّني صاحي",41,"ي",1,0],["إنَّ أشقى البلاد ما كان يجري","في أراضيه دجلة والفرات",42,"ت",1,0],["إن اشتد أمر فادح بسموا له","كذاك النجوم الزهر في الليل تلمع",43,"ع",1,0],["أناشدكُمْ والشرقُ بينَ مطامعٍ","تُهددهُ في حوزةٍ وكيانِ",44,"ن",1,0],["أَنَاشِيدَ فِيهَا لِلْمَلِيحَةِ وَالْهَوَى","مَعَاذِيرُ أَحْوَالٍ يَلِينُ لَهَا الصَّخْرُ",45,"ر",1,0],["إِن أَشْبَالَكَ الأَعِزَّاءَ أَيقَا","ظٌ فَنَمْ عَنْهُمُ أَمِيناً قَرِيرَا",46,"ر",2,0],["إن اشتكى النيلُ مسَّ ضيمٍ","فحرِّموا حولَه الورودا",47,"د",2,0],["أنا شعري كالطَيْرِ يُفْزِعُهُ الَخُّ","ويرتاعُ من حَفيف النِبال",48,"ل",1,0],["إن أشكلت دُهْمُ الأمورِ وأغلقتْ","أبوابَها فسلوه عن مِفتاحها",49,"ح",3,0],["أنا شاعرٌ متحرِّرٌ","لا راهبٌ في ديره",50,"ر",2,0],["انا شاعرٌ يبغى الوفاق موِّحد","بين الشُّعوب سبيلُه الارشاد",51,"د",1,0],["أنا شمسٌ وبعيد فلكي","وضيائي نافرٌ من راحيتكْ",52,"ك",1,0],["أنا شجرُ الأحزان ، أنزفُ دائماً","وفى الثلج والأنواءِ .. أعطى وأُثمرُ",53,"ر",1,0],["أنا شؤمي فيما تقولون عزْ","زالٌ ولكن شؤمكمُ قتَّالُ",54,"ل",1,0],["إِن أَشهَروا السَيفَ وَإِن أَغمَدوا","عَنهُ لَدى الهَيجاءِ لا يَعدِلُ",55,"ل",1,1],["إِن أَشهى مِن الحَياة تَجني","هِ لِقَلبي وَعَني اِستغناؤُه",56,"ا",3,0],["انا شبلكم والليث يحرس شبله","شمما وعنه كما يشاء يحامي",57,"م",2,0],["إن أشجار همتي وثباتي","أثمرت لي جمر التوله أحمر",58,"ر",1,0],["أنا شبيهان في شجوٍ وفي ظلع","وراء نجم من الأحلام لماع",59,"ع",1,0],["أناشدكم وادي الشتا وظباءه","وغزلان وادي السير والأعين الدعجا",60,"ج",2,1],["أناشدكم وادي الشتا وظباءه","وغزلان وادي السير وهو حبيب",61,"ب",1,0],["أنا شاكرٌ لك ما حَييت وذاكرٌ","فالُحر للحرّ الكريم شَكُورُ",62,"ر",1,0],["أنا شِبْهُ دهركمُ كأنَّ خلائقي","طُبِعَتْ من السَّرَّاءِ والضَّرَّاءِ",63,"ا",2,0],["إنَّ أشَهى مَا تَشتَهِى النَّفسُ بَنَّا","لَيتَ أنَّا بِهَا الحَلِيلَ غَبَنًَّا",64,"ن",2,1],["إن أشكُ نحوك من دهري شكوتُ إِلى","مصمتِ من شكا من دهره وَجَعا",65,"ع",2,0],["إِن أُشبِعَت نامَت وَإِن هِيَ جُوِّعَت","نَبَحَت وَتُشلِيها فَما تُجدي جَدا",66,"د",2,0],["أنا شاعرٌ شَحّ الغواةُ بركْبِهِ","والشِّعر في ورقي تبَنّاهُ الضَّجرْ",67,"ر",1,0],["أنا شاعرٌ أنا بائسٌ","أنا مستهامٌ فاعذُريني",68,"ي",1,0],["أَناشيدَ ما صَعِدَت قَبلَ عَهدِكَ","مِن حَلقِ إِنسٍ وَلا مِن وَتَر",69,"ر",1,0],["أَناشيدَ كانَت عَلى شَفَتَيكَ","رِضاعَ الهَوى مُنذُ كانَ الصِغَر",69,"ر",1,0],["أنا شاكرٌ لك في اقتضائك لي ومَنْ","لاقى الجميل بوده أن يشكرا",70,"ر",2,0],["أُناشِدُهُ الأَخبارَ عَنكُم وَكُلَّما","أَعادَ حَديثاً عَنكُمُ ظَلتُ أَشهَقُ",71,"ق",1,0],["أَنا شاكٍ في هَوى مَن","طَرفُهُ شاكي السِلاحِ",72,"ح",1,0],["أناشدك الله إلا نشد","ت وقفة حاديك بالهودج",73,"ج",1,0],["أُناشِدُك الله الذي هو شاهدٌ","كفاكِ دلالاً بعد طولِ التذلُّل",74,"ل",1,0],["أناشدُكَ الحبّ الذي هو بَيننا","وما فيهِ لي من لذَّة وتألُّم",75,"م",1,0],["أنا شاعرٌ يبكي عليهِ لِشعرهِ","ويفي حقوق الشاعرِ المقتول",76,"ل",1,0],["أنا شاعر يشكو الهوى لا مُنجِّمٌ","ولا أُنسَ لي بين الهمومِ بإنسان",77,"ن",1,0],["أُناشِدُ أَرْواحَ الْعَشِيّاتِ كُلَّما","نَسَبْنَ إِلى رَيّا الأَحْبَّةِ رَيّاهُ",78,"ا",2,0],["أَناشَتْ عَرارَ الرَّمْلِ أَمْ صافَحَتْ ثَرىً","أَغَذَّ بِهِ ذاكَ الْفَرِيقُ مَطاياهُ",78,"ا",2,0],["أناشدُك اللَه يا قاسيه","أأنتِ لعهد الهوى ناسيه",79,"ي",2,1],["إن اشتغليت قلبي","عدمت والله نقدك",80,"ك",1,0],["إِن اِشتَكَت قَدَماهُ الضُرَّ مِن أَلَمِ","أَحيا وَقامَ وَمِنهُ الذِكرُ حَيثُ ثَوى",81,"ث",3,0],["إن أشقى الأحياءِ والأمواتِ","آدميٌّ يعيش بالفلسفات",82,"ت",1,0],["أَنا شِمالٌ أَنتَ يُمنى لَها","لا أَعدَمَ اللَهُ يَميني الشِمال",83,"ل",1,0],["إِنَّ اِشتِعالَ ضِرامِ الشَيبِ يُخبِرُني","بِأَنَّ غُصنِيَ مِمّا عُدَّ في الحَطَبِ",84,"ب",1,0],["إن أشغل الحسادُ عنك قلوبَهم","فبك الفؤاد على المدى مشغول",85,"ل",1,0],["إن أشْهَروا جهلاً عليك سيوفَهمْ","فَلَسَوْفَ في الهامات مِنهم تُغْمَدُ",86,"د",1,0],["أنا شاكِرٌ للعُرْفِ نَشْرَ يَدٍ فكَمْ","عِندَ العَميدِ المُرتضى تَشكُوني",87,"ي",1,0],["إنَّ أشهى الرَّاح ما تأخذه","من يَدَيْ ساق نقي الخدّ أمرد",88,"د",1,0],["أنا شيخُ الغرام من يتَّبعني","اهلك في الهوى صراطاً سويّا",89,"ي",2,0],["إِنَّ أشْرَاكَكَ الصِّعابَ لَتَجْرِي","هَيِّناتِ التَّخْلِيصِ ما بَيْنَ كَفِّي",90,"ي",1,0],["أنا شاعرٌ أنا شاكرٌ أنا ناشرٌ","أنا راجلٌ أنا جائعٌ أنا عارِ",91,"ر",1,0],["إن أشكلتْ يوماً عليكَ قضيةٌ","فاسألْهُ تحْظَ فعندَهُ الأخبارُ",92,"ر",1,0],["أنا شاكي السَماحِ شكوى قتيلٍ","بيد البُخْلِ وهو شاكي السِلاحِ",93,"ح",1,0],["أناشد رسم الدار أين ترحلّوا","وأنشد قلبي عند برقة منشد",94,"د",1,0],["أنا شمعة العشتاق في نار الهوى","وأرى الهوى فوق اللهيب أذابني",95,"ن",2,0],["أَناشدك اللَه الَّذي جل ذكره","لتسمع مني ما أَقول وأَشرح",96,"ح",1,0],["أناشيدَ نابضةً بالحياةٍ","ولو من رؤىَ الزمنِ الغابرِ",97,"ر",1,0],["أُناشِدُ نَعمانَ الأخابيرَ عنهُمُ","كفَى خبرةً مستفصحٌ وهو أعجمُ",98,"م",1,0],["أناشد جفنيها السقيمين في دمي","وتأبى سوى السفك الأناملُ والخدُّ",99,"د",1,0],["أنا شَيْخُ من في الأرضِ أعْلَمُ عالِمٍ","في العَصرِ واحِدُ نَوْعِها الفَرْدي",100,"ي",1,0],["أَنا شيخُها ضمنَ الخَفاءِ بروْنَقٍ","لا بُدَّ يَجْلو ظاهِراً ميداني",101,"ي",1,0],["أنا شَيْخهُمْ وإمامُهمْ","وهُمُ على إثري فِرَقْ",102,"ق",1,0],["إن أشارت إلى الكيان أبانت","عنه أو لا فإنه في أكِنَّهْ",103,"ن",2,0],["أنا شاك لطولها من قصوري","عن مدى الشكر شاكر أنا شاكي",104,"ي",1,0],["أنا شعشاع نوركم فاعشقوني","لا تحولوا عن شرب كاسي وطاسي",105,"س",2,0],["أنا شمسهم والنور يب","دو لي بهم في كل بدر",106,"ر",1,0],["أنا شَرْقٌ لشمسها فاجتلوني","ليس عني يوماً تميل لغرب",107,"ب",1,0],["أَنا شيخُهم في عِشْقِها وعَليَّ قد","قَرَءوا الذَّي نَظَمُوهُ من أَشْعارِهم",108,"م",1,0]]}