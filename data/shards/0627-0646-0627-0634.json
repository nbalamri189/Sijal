as&qid=87580&r=&rc=5",""],[6325,"معراج روح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88021&r=&rc=3",""],[6333,"آخر رسالة حب مالم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7033&r=&rc=1",""],[5567,"صاغني الدهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82099&r=&rc=140",""]],"verses":[["إِن أَشِرَ الخَطبُ فَلا رَوعَةٌ","أَو عَظُمَ الأَمرُ فَصَبرٌ جَميل",0,"ل",1,1],["أَناشِدٌ أَنتَ أَطلالاً بِذي القورِ","أَضَلَّها جَوَلانُ القَطرِ وَالمورِ",1,"ر",1,1],["إِن أَشهَدِ القَومَ لا أَعلَم نَجِيَّهُمُ","ماذا قَضَوا وَيُجَمجِم دونِيَ الخَبَرُ",2,"ر",1,0],["إِن أَشكُ فِعلَكِ مِن فِراقِ أَحِبَّتي","فَلَسوءُ فِعلِكِ في عِذاري أَقبَحُ",3,"ح",1,0],["أَنَا شِيعَةٌ لَكَ حَيْثُ كُنْتَ قَضِيَّةٌ","لَمْ يَخْتَلف فِي حُكْمِهَا نَفْسَانِ",4,"ن",1,0],["أُناشِدُكَ اللّهَ في مُغْرَمٍ","أحَلْتَ عليْهِ الجَفا والصُّدودا",5,"د",2,0],["إن أشرقت شمس شَرِقتُ بِعَبرَتي","وَتَفِيضُ فِي وَقْتِ الْغُرُوبِ غُرُوِبي",6,"ب",2,0],["إِن أَشمَسَت تِلكَ الطَلاقَةُ","فَالنَدى مِنها مُقيم",7,"م",1,0],["أناشدكم والحرُّ أَوْفَى بعهده","ولن يعدم الإحسانُ والخيرُ جاريا",8,"ي",2,0],["أناشدكم أين المدارس إِنها","على الكون فيكم والحياة دليل",9,"ل",1,0],["أنا شاطرتك الأسى بدموع","كنّ للحزن في الفؤاد وقودا",10,"د",2,0],["أنا شاكٍ إليك بعضَ ثِقاتي","فافهم اللحنَ فهو كالإعرابِ",11,"ب",1,0],["إن أَشارتْ بطرفها فَسَحُورٌ","أَوْ أشارتْ بكفِّها فخلُوبُ",12,"ب",1,0],["أنا شِبهٌ لخدِّكا","ورسولٌ لعَبْدكا",13,"ك",2,1],["أنا شؤمي فيما تقولون عزَّا","لٌ ولكنَّ شؤمَكم قتَّالُ",14,"ل",1,0],["أنا شاكيك إلى مَنْ","هو للعدْل قَوامُ",15,"م",1,0],["أنا شيخٌ أنيك أمَّ مُهاجيْ","يَ وأَفْري أديمَهُ بلساني",16,"ن",2,0],["أَنا شاعِرٌ أَبَداً تائِقٌ","إِلى الحُسنِ في الناس وَالكائِنات",17,"ت",1,0],["أَنا شاعِرٌ ما لاحَ طَيفُ مَلاحَةٍ","إِلّا وَهَلَّلَ لِلجَمال وَكَبَّرا",18,"ر",2,0],["أَنا شَبَحٌ راكِضٌ مُسرِعٌ","مَعَ الزَمَنِ الراكِضِ المُسرِعِ",19,"ع",1,0],["أُناشِدُكَ اللَهَ قِف ساعَةً","أَقُل ما لَدَيَّ وَقُل ما لَدَيكَ",20,"ك",1,0],["انا شيخ بذكرياتي احيا","فهي ان لم تكن فاني قاض",21,"ض",1,1],["انا شبيهان في البلوى بمجتمع","فيه كلانا لقاء الموت ينتظر",22,"ر",1,0],["أنا شاعر فاذا أطلت عنائي","قامت عليك قيامة الشعراء",23,"ا",2,1],["إِن أَشرَقَت زَهراءَ تَسمو لِلضُحى","وَإِذا هَوَت حَمراءَ في تِلكَ الذُرى",24,"ر",2,0],["أُناشِدُ الغَيثَ كَي تَهمي غَواديهِ","عَلى العَقيقِ وَإِن أَقوَت مَغانيهِ",25,"ي",2,1],["أُناشِدُ الغَيْثَ أن يَجتازَه أبداً","ولامعَ البَرْقِ أن يَغْشاه إِحراقا",26,"ق",2,0],["أُناشِدُ دَهْري أن يَعودَ كما بَدا","فَقد غارَ بي في الحادثاتِ وأنجدَا",27,"د",2,1],["أنا شهيدك والقلب الضحوك إذا","أدميتَه والمغني إذ تقطّعُه",28,"ع",2,0],["أنا شاديك ولحني لك وحدك","فاقضِ ما ترضاه في يومي وأمسي",29,"ي",1,0],["أناشدك الهوى هل أنت مثلي","نهاري فيك أشجانٌ وليلي",30,"ل",2,1],["أَنا شَمسٌ وَبَعيدٌ فَلَكي","وَضِيائي نافِرٌ مِن راحَتَيك",31,"ك",1,0],["أناشدٌ أنت حتفاً صنعَ منتحرِ","أم شابكٌ أنت , مغتراً, يدَ القدر",32,"ر",1,0],["إنّا شَرَعنا لِلكنانةِ دِينَها","فَقَضَى على الدِّينِ الذي لم يُشرعِ",33,"ع",1,0],["أُناشِدُكم لا تَجْعَلوني كصائحٍ","يُنادِي صَدىً في مُلتَقى الرّيحِ حائرا",34,"ر",2,0],["أُناشِدُهُنَّ ذِمامَ الهَوى","وَلَو ذُقنَهُ لَشَفَينَ الصَدى",35,"ا",1,0],["أناشِدُكم هل صاحبَ الوفدُ منهما","بني عامرٍ إلا أثيماً وفاجرا",36,"ر",2,0],["أنا شاعر الدنيا ... تبطن ظهرها","شعري ... يشرق عبرها ويغرب",37,"ب",1,0],["أنا شاعر الأفلاك كل كليمة","مني ... على شفق الخلود تلهب",37,"ب",1,0],["أنَا شَيخُ الغَرَامِ مَن يَتَّبِعنِي","أهدِهِ فِي الهَوى سِرَاطاً سَوِيَّا",38,"ي",2,0],["إِنّا شَتَونا فَوقَها","وَلَعَلَّنا فيها نَصيفُ",39,"ف",1,0],["إِن أَشرَبِ الخَمرَ أَو أُرزَأ لَها ثَمَن","فَلا مَحالَةَ يَوماً أَنَّني صاحي",40,"ح",2,0],["إِن أَشرَبِ الخَمرَ أَو أُرزَأَ لَها ثَمَناً","فَلا مَحالَةَ يَوماً أَنَّني صاحي",41,"ح",2,0],["إنَّ أشقى البلاد ما كان يجري","في أراضيه دجلة والفرات",42,"ت",1,0],["إن اشتد أمر فادح بسموا له","كذاك النجوم الزهر في الليل تلمع",43,"ع",1,0],["أناشدكُمْ والشرقُ بينَ مطامعٍ","تُهددهُ في حوزةٍ وكيانِ",44,"ن",1,0],["أَنَاشِيدَ فِيهَا لِلْمَلِيحَةِ وَالْهَوَى","مَعَاذِيرُ أَحْوَالٍ يَلِينُ لَهَا الصَّخْرُ",45,"ر",1,0],["إِن أَشْبَالَكَ الأَعِزَّاءَ أَيقَا","ظٌ فَنَمْ عَنْهُمُ أَمِيناً قَرِيرَا",46,"ر",2,0],["إن اشتكى النيلُ مسَّ ضيمٍ","فحرِّموا حولَه الورودا",47,"د",2,0],["أنا شعري كالطَيْرِ يُفْزِعُهُ الَخُّ","ويرتاعُ من حَفيف النِبال",48,"ل",1,0],["إن أشكلت دُهْمُ الأمورِ وأغلقتْ","أبوابَها فسلوه عن مِفتاحها",49,"ح",3,0],["أنا شاعرٌ متحرِّرٌ","لا راهبٌ في ديره",50,"ر",2,0],["أنا شاعر يا \" ابن العمّ \" لي","من الحبّ نبع شهيّ غزير",51,"ر",1,0],["انا شاعرٌ يبغى الوفاق موِّحد","بين الشُّعوب سبيلُه الارشاد",52,"د",1,0],["أنا شمسٌ وبعيد فلكي","وضيائي نافرٌ من راحيتكْ",53,"ك",1,0],["أنا شجرُ الأحزان ، أنزفُ دائماً","وفى الثلج والأنواءِ .. أعطى وأُثمرُ",54,"ر",1,0],["أنا شؤمي فيما تقولون عزْ","زالٌ ولكن شؤمكمُ قتَّالُ",55,"ل",1,0],["إِن أَشهَروا السَيفَ وَإِن أَغمَدوا","عَنهُ لَدى الهَيجاءِ لا يَعدِلُ",56,"ل",1,1],["إِن أَشهى مِن الحَياة تَجني","هِ لِقَلبي وَعَني اِستغناؤُه",57,"ا",3,0],["انا شبلكم والليث يحرس شبله","شمما وعنه كما يشاء يحامي",58,"م",2,0],["إن أشجار همتي وثباتي","أثمرت لي جمر التوله أحمر",59,"ر",1,0],["أنا شبيهان في شجوٍ وفي ظلع","وراء نجم من الأحلام لماع",60,"ع",1,0],["أناشدكم وادي الشتا وظباءه","وغزلان وادي السير والأعين الدعجا",61,"ج",2,1],["أناشدكم وادي الشتا وظباءه","وغزلان وادي السير وهو حبيب",62,"ب",1,0],["أنا شاكرٌ لك ما حَييت وذاكرٌ","فالُحر للحرّ الكريم شَكُورُ",63,"ر",1,0],["أنا شِبْهُ دهركمُ كأنَّ خلائقي","طُبِعَتْ من السَّرَّاءِ والضَّرَّاءِ",64,"ا",2,0],["إنَّ أشَهى مَا تَشتَهِى النَّفسُ بَنَّا","لَيتَ أنَّا بِهَا الحَلِيلَ غَبَنًَّا",65,"ن",2,1],["إن أشكُ نحوك من دهري شكوتُ إِلى","مصمتِ من شكا من دهره وَجَعا",66,"ع",2,0],["إِن أُشبِعَت نامَت وَإِن هِيَ جُوِّعَت","نَبَحَت وَتُشلِيها فَما تُجدي جَدا",67,"د",2,0],["أنا شاعرٌ شَحّ الغواةُ بركْبِهِ","والشِّعر في ورقي تبَنّاهُ الضَّجرْ",68,"ر",1,0],["أنا شاعرٌ أنا بائسٌ","أنا مستهامٌ فاعذُريني",69,"ن",2,0],["أَناشيدَ ما صَعِدَت قَبلَ عَهدِكَ","مِن حَلقِ إِنسٍ وَلا مِن وَتَر",70,"ر",1,0],["أَناشيدَ كانَت عَلى شَفَتَيكَ","رِضاعَ الهَوى مُنذُ كانَ الصِغَر",70,"ر",1,0],["أنا شاكرٌ لك في اقتضائك لي ومَنْ","لاقى الجميل بوده أن يشكرا",71,"ر",2,0],["