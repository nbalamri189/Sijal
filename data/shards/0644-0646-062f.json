{"poems":[[51,"ليس للإنسان إلا ما رزق","https://www.aldiwan.net/poem64255.html","الرمل"],[50,"نادم العز الكراما","https://www.aldiwan.net/poem66609.html","مجزوء الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54708","المجتث"],[416,"لندبك أحزان وسابق عبرة","https://www.aldiwan.net/poem67460.html","الطويل"],[463,"لمن الطلول كأنهن رقوم","https://www.aldiwan.net/poem55864.html","الكامل"],[469,"وردت أحاديث العذيب مع الصبا","https://www.aldiwan.net/poem3181.html","عموديه"],[469,"لندى يديك ويمن رأيك","https://www.aldiwan.net/poem3314.html","عموديه"],[471,"يقول خليلي باللوى من حفارة","https://www.aldiwan.net/poem50474.html","الطويل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104577","الطويل"],[899,"","https://poetry.dctabudhabi.ae/diwan/poem/115105","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119955","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49035","الكامل"],[2537,"","https://poetry.dctabudhabi.ae/diwan/poem/132209","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74058","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48432","الرمل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45798","المتدارك"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117846","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[4816,"سابق الوقت","https://www.poetsgate.com/ViewPoem.aspx?id=8469",""],[5480,"متغنّم الشاره","https://www.poetsgate.com/ViewPoem.aspx?id=29630",""],[5725,"عشقت بعينيك","https://www.poetsgate.com/ViewPoem.aspx?id=181097",""],[6280,"لندبكَ أحزانٌ وسابقُ عبة ٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27924&r=&rc=79",""]],"verses":[["لَنَدى هارونَ فيكُم وَلَهُ","فيكُمُ صَوبٌ هَطولٌ وَوَرِق",0,"ق",1,0],["لنداماكَ المُداما","واسقهِ منَ لا ينافيهِ عتاباً أو مَلاما",1,"م",2,0],["لِنْدَا أَتَمُّ العَذَارَى","حُسْناً وَعِلْماً وَرُشْدَا",2,"د",2,0],["لَنَدبِكَ أَحزانٌ وَسابِقُ عَبرَةٍ","أَثَرنَ دَماً مِن داخِلِ الجَوفِ مُنقَعا",3,"ع",2,1],["لَنَدى بني عبد الرحيم ومجدِهم","من جِنَّةِ الدنيا رُقىً وتميمُ",4,"م",1,0],["لندى صفيّ الدين أخصب مربعي","قبل السؤال وكان يبساً مجدبا",5,"ب",2,0],["لندى يديك ويمن رأيك","نكص الأماجدُ من ورايك",6,"ك",1,1],["لِنُدرِكَ وَصلاً بانَ مِنكَ لِنِيَّةٍ","وَلا خَيرَ في وَصلٍ يُماديهِ طالِبُه",7,"ه",1,0],["لندركهُم مِن بأسِها في كتائبٍ","تهُدُّ صناديدَ الملوكِ وتَهدمُ",8,"م",1,0],["لندنو من ميلاءَ أو نُعقَبَ الذي","قَضَينا فَنُجزى يَومَ بُؤسٍ بأَنعُمِ",9,"م",1,0],["لنداك أهنا ما أرى","والعذر بعد نداك أهنا",10,"ن",2,0],["لندا وحكمة في كتابهما","حِكمٌ لها الآمال تبتسم",11,"م",1,0],["لندفع عن خلين من آل جرمن","على حين قد خان الخليل خليل",12,"ل",1,0],["لنداك يا شهبندر الد","دنيا تصيخ لِتسمعا",13,"ع",2,0],["لندىً أو لعُلىً","أو لجَمْعِ ما افْترَقْ",14,"ق",1,0],["لندوم مِن النَظر العالي","في ظل الأَمن المُشتَمل",15,"ل",1,0],["لندرك إحدى الحسنيين بنصره","منال الأماني أو منية مقدم",16,"م",1,0],["لندعوهُ موجهينَ قلوبنا","إلى من علا عن وجهِهِ تتوسَّمُ",17,"م",1,0],["لندائه ما رق يسمع بل","بحسامه ذاك الندا حسما",18,"م",2,0],["لن دق نجم السعد بيت فرحتله","كل البيوت وفرحها صار مقسوم",19,"م",1,0],["لن داس زله فزع من مصدر اخطوره","ويا بن خميس الغريب تثمّنه داره",20,"ر",2,0],["لندرأ عنك عراة الصدور","مغولا اتوك بجمعٍ جرادا",21,"د",2,0],["لندبكَ أحزانٌ وسابقُ عبة ٍ","أثرنَ دماً منْ داخلِ الجوفِ منقعا",22,"ع",2,1]]}