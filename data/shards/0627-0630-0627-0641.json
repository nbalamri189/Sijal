.dctabudhabi.ae/diwan/poem/54232","الوافر"],[106,"عرش هوى","https://www.poetsgate.com/ViewPoem.aspx?id=179587",""],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[50,"أقمت وأجريت الصبا ما وحى واح","https://www.poetsgate.com/ViewPoem.aspx?id=21639",""],[67,"جِوَارُكَ منْ جَوْرِ الزَّمانِ يُجِيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=14535",""],[90,"رابطة الآداب","https://www.poetsgate.com/ViewPoem.aspx?id=179137",""],[34,"أيا كبداً طارتْ صُدُوعاً نَوافذاً","https://www.poetsgate.com/ViewPoem.aspx?id=22453",""],[45,"تُرِيكَ الذي حُدّثتَ عَنهُ منَ السِّحْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=31341",""],[91,"ضيف ثقيل","https://www.poetsgate.com/ViewPoem.aspx?id=53124",""],[35,"أَلَمْ تَرْبَعْ فَتُخْبِرَكَ الطُّلُولُ","https://www.poetsgate.com/ViewPoem.aspx?id=22132",""],[28,"إني وإن كانت تميم عمارتي","https://www.poetsgate.com/ViewPoem.aspx?id=21964",""]],"verses":[["إِذا فَعَداني الضَيفُ في كُلِّ لَيلَةٍ","وَكُبَّت بِأَعجازِ البُيوتِ جِفاني",0,"ي",1,0],["إِذا فاحَ رَيَعانُ النَسيمِ رَأَيتَها","إِلى الجانِبِ الغَربي عوجَ الخَياشِمِ",1,"م",1,0],["إِذا فَغَرَت شَوهاءُ مِن جانِبِ العِدا","عَلى غَيرِ نَذرٍ لَقَّموها القَنا الذُبلا",2,"ل",2,0],["إِذا فَزِعوا لِلأَمرِ أَلجوا ظُهورَهُم","إِلى كُلِّ طَودٍ مِن نِزارٍ عَطَوَّدِ",3,"د",1,0],["إِذاً فَثَكِلتُ سابِحَتي وَسَيفي","غَداةَ وَغىً وَراحِلَتي وَزادي",4,"د",2,0],["إِذا فاضَ رَقراقُ المَحامِدِ صَيَّروا","لَهُ جودَهُم دونَ اللِئامِ نَصائِبا",5,"ب",2,0],["إذا فتّشَ التّجريبُ عنهُمْ تَشابَهَتْ","سَجايا كأطْرافِ الرِّماحِ شُكولُ",6,"ل",1,0],["إِذا في مَجلِسٍ نَذكُر عَلِيّاً","وَسِبتَيهِ وَفاطِمَةَ الزَكِيَّه",7,"ي",2,1],["إِذَا فَاتَنِي ظِلُّ الْحِمَى وَنَعِيمُهُ","كَفَانِي وَحَسْبِي أَنْ يَهُبّ نَسِيمُهُ",8,"م",2,1],["إِذَا فَكَّرْتَ فِي وَطَنٍ كَرِيمٍ","نَبَتْ بِكَ عَنْهُ نَائِبَةُ اغْتِرَابِ",9,"ب",1,1],["إِذا فاتَ شَيءٌ فَاصطَبِر لِذهابِهِ","وَلا تَتبَعَنَّ الشيءَ إِن فاتَكَ الجَزَع",10,"ع",1,0],["إِذا فَضَلَت مَعاقِدُ نِسعَتَيها","وَأَصبَحَ ضَفرُها قَلِقاً يَجولُ",11,"ل",1,0],["إذا فاق سادات الحمى آل سرسق","فإن نجيباً فيهم السيد الجعد",12,"د",1,0],["إِذا فارَقَتهُ تَبتَغي ما تَعيشُهُ","كَفاها رَذاياها الرَقيعُ الهَبَنَّقُ",13,"ق",1,0],["إِذاً فَرَماني اللَهُ مِن حَيثُ لا أَرى","وَلا زالَ في أَرضي عَدُوٌّ أُحارِبُه",14,"ب",2,0],["إذا فاض من يمناه بحر سماحة","وعَمَّ به الطوفان في النجد والوَهْدِ",15,"د",1,0],["إِذا فاضَلتَ مَدَّكَ مِن قُرَيشٍ","بُحورٌ غَمَّ زاخِرُها الثِمادا",16,"د",2,0],["إِذا فَوَّزَت عَن ذي جَراوِلَ أَنجَدَت","مِنَ الغَورِ وَاِعرَورَت حَزابِيَها الغُبرا",17,"ر",2,0],["إِذا فَوَّزَت عَن نَهرَبينَ تَقاذَفَت","بِحَدراءَ دارٌ لا تُريدُ لِتَجمَعا",18,"ع",2,0],["إِذا فَوَّزَت عَن مَسحُلانَ وَدافَعَت","بِشَيبانَ لاقى القَينُ مِن دونِها شُغلا",19,"ل",2,0],["إِذا فَزِعوا لَم تُعلَفِ القَتَّ خَيلُهُم","وَلَكِن صُدورَ الأَزأَنِيِّ نَسومُها",20,"م",3,0],["إِذا فَضلَةٌ مِن بَطنِ زِقٍّ وَنُطفَةٌ","وَقَعبٌ صَغيرٌ فَوقَ عَوجاءَ ضامِرِ",21,"ر",1,0],["إذا فرَّق الفاروقُ في الخلق ذكرهم","فيا حبَّذا الأطهارُ تعزَى إلى الطّهر",22,"ر",1,0],["إذا فتن الألباب حسنك ساذجاً","فما حاجة الخدّ البديع إلى الرّقم",23,"م",1,0],["إذا فاخر الأنداد جاءَ فخاره","بهذا الثنا يستوقف المتأمّلا",24,"ل",2,0],["إذا فعل السوء قال الخنا","ليشبه منظره المسمع",25,"ع",1,0],["إذا فقدت فسوها","فأنفاسها تخلف",26,"ف",1,0],["إذا فُقتَ الضئيل بحسن جسم","فلا يسبقك بالشيم الشريفه",27,"ه",1,1],["إذا فكروا في مدحه ذات بينهم","فمنهم أخو التغريد والمتلوِّمُ",28,"م",1,0],["إِذا فُضَّت خَواتِمُها وَفُكَّت","يُقالُ لَها دَمُ الوَدَجِ الذَبيحُ",29,"ح",1,0],["إِذا فَرَغَت مِن الراحِ الدِنانُ","تَوَهَّمَ أَنَّما فَرَغَ الزَمانُ",30,"ن",1,0],["إِذا فَعَلَ الأَقوامُ نَوعاً مِنَ النَدى","تَنَوَّعَ فيهِ جودُهُ وَتَجَنَّسا",31,"س",2,0],["إِذا فَزِعوا طارَت بِأَبيَضَ صارِمٍ","وَرامَت بِما في جَفرِها ثُمَّ سَلَّتِ",32,"ت",1,0],["إِذا فاطَنَتنا في الحَديثِ تَهَزهَزَت","إِلَيها قُلوبٌ دونَهُنَّ الجَوانِحُ",33,"ح",1,0],["إِذا فَضَحَ الأَملاكَ نَقصٌ فَإِنَّهُ","يُبَيِّنُهُ عِندَ الأَنامِ تَمامي",34,"ي",1,0],["إذا فنيت زهور أو نجوم","وزايلها البهاء بدا عليك",35,"ك",1,0],["إذا فاتتك قلت اختار دهري","وإن هي لم تفت قلت اختياري",36,"ي",1,0],["إِذا فَعَلوا فَخَيرُ الناسِ فِعلاً","وَإِن قالوا فَأَكرَمُهُم مَقالا",37,"ل",2,0],["إذاً فرماني الدَّهْرُ عن قَوْسِ هجركُمْ","بأَسْهُمِهِ ذاتِ الشُّجونِ الصَّوائبِ",38,"ب",1,0],["إِذا فَزِعَت قَدَّمَتها الجِيادُ","وَبيضُ السُيوفِ وَسُمرُ القَنا",39,"ا",1,0],["إِذا فاتوا الرِماحَ تَناوَلَتهُم","بِأَرماحٍ مِنَ العَطَشِ القِفارُ",40,"ر",1,0],["إِذا فَلَّ عَزمي عَن مَدىً خَوفُ بُعدِهِ","فَأَبعَدُ شَيءٍ مُمكِنٌ لَم يَجِد عَزما",41,"م",2,0],["إِذا فطمتْهُ الشمسُ فهو مُفَضَّضٌ","وإن حضنتهُ مَسَّ قُطْريهِ تذهيبُ",42,"ب",1,0],["إِذا فُرَصُ المَجدِ عَنَّت لَهُ","تَغَنَّمَ بِالحَزمِ إِمكانَها",43,"ن",3,0],["إِذاً فَأَصابَتكُم مِنَ اللَهِ جَزَّةٌ","كَما جَزَّ أَعلى سُنبُلٍ كَفُّ حاصِدِ",44,"د",1,0],["إِذا فَزِعَ النِساءُ فَلا تُبالي","لَها سوقاً خَرَجنَ وَلا خِمارا",45,"ر",2,0],["إِذا فَمُ كَبشِ القَومِ كانَ كَأَنَّهُ","لَهُ فَمُ كَلّاحٍ مِنَ الرَوعِ أَروَقِ",46,"ق",1,1],["إِذا فَزِعوا هَزّوا لِواءَ اِبنِ حابِسٍ","وَنادَوا كَريماً خَيمُهُ وَشَمائِلُه",47,"ل",2,0],["إِذا فَرَغوا مِن جانِبٍ مالَ جانِبٌ","عَلَيهِم فَذادوهُم ذِيادَ الحَوائِمِ",48,"م",1,0],["إذا فاجأتْنا الحادثاتُ بمصرَعٍ","فليس سِوى الجَنْبِ الكريمِ لنا جَنْبُ",49,"ب",1,0],["إِذا فَزِعوا طاروا إِلى مُستَغيثِهِم","طِوالَ الرِماحِ لا ضِعافٌ وَلا عُزلُ",50,"ل",1,0],["إِذا فَكَّرتُ في نَدَمي عَلَيها","عَضَضتُ أَنامِلي وَقَرَعتُ سِنّي",51,"ن",2,0],["إذا فرّتِ الأبطال كرّ وسيفُهُ","يُحِلّ بيمناهُ دمَ العلجِ محرمُ",52,"م",1,0],["إذا فتحت أبوابُها خلتَ أنَّها","تقولُ بترحيبٍ لداخلها أَهلا",53,"ل",2,0],["إذا فتحَ المزاجُ اللَّونَ منها","مضى وردٌ لها وأتى بَهَارُ",54,"ر",1,0],["إِذا فُقِدَ المَفقودُ مِن آلِ مالِكٍ","تَقَطَّعَ قَلبي رَحمَةً لِلمَكارِمِ",55,"م",1,0],["إِذا فَرَشوهُ النَصفَ ماتَت شَذاتُهُ","وَإِن رَتَعوا في ظُلمِهِ كانَ أَظلَما",56,"م",2,0],["إِذا فَضَلَت عَن رَأيِ غَيرِكَ أَصبَحَت","وَرَأيُكَ عَن جِهاتِها السِتِّ فاضِلُ",57,"ل",1,0],["إِذا فَقَدَتهُ ساعَةً عِندَ مَرتَعٍ","تَراها عَلَيهِ بِالبُغامِ تَفَجَّعُ",58,"ع",1,0],["إذا فَرِغُوا من فُنونٍ خَلَتْ","أَتوا بعدها بِفُنونٍ أُخَرْ",59,"ر",1,0],["إِذا فَدَحَت خُطوبُ الدَهرِ يَوماً","فَنِعمَ العَونُ فيها وَالرَفيقُ",60,"ق",1,0],["إذا فزعوا للظلمِ كنتَ لهم حِمىً","وإن أعوزَ الأنصارُ أَلْفَوْكَ ناصرا",61,"ر",2,0],["إِذا فُهتُ بِالشَكوى تَرَنَّمَ صاحِبي","كَما طارَحَ الغُصنَ الحَمامُ المُطَوَّقُ",62,"ق",1,0],["إِذا فِئَةُ العُذّالِ جاءَت بِسِحرِها","فَفي لَحظِ موسى آيَةٌ تُبطِلُ السِحرا",63,"ر",2,0],["إِذ أُفقُهُ كُلُّ البِلادِ وَعَصرُهُ","كُلُّ الزَمانِ وَشَخصُهُ كُلُّ الوَرى",64,"ر",2,0],["إِذا فارَقوا دُنياهُمُ فارَقوا الأَذى","وَصاروا إِلى مَوعودِ ما في المَصاحِفِ",65,"ف",1,0],["إِذا فَزَّعوا أُمَّ الصَبِيَّينِ نَفَّضوا","عَفارِيَ شُعثاً صافَةً لَم تُرَجَّلِ",66,"ل",1,0],["إِذا فَعَلتِ الَّذي فَعَلتِ فَقُولي","حَمدَ خَيراً وَأَتبَعي القَولَ فِعلا",67,"ل",2,0],["إذا فارق المرءُ الرفيعُ مكانُه","فليس له إلا عليك طريق",68,"ق",1,0],["إِذا فُؤادٌ شَجاهُ حُبٌّ","فَقَلَّما يَنفَعُ الطَبيبُ",69,"ب",1,0],["إِذا فَقَدَ الرَغيفَ بَكى عَلَيهِ","بُكا الخَنساءِ إِذ فُجِعَت بِصَخرِ",70,"ر",1,0],["إِذا فَكَّرتُ في عِرضِ","كَ أَشفَقتُ عَلى شِعري",71,"ي",1,0],["إِذا فارَقتُها صَبَّت","عَلَيَّ الهَمَّ وَالفِكرا",72,"ر",2,0],["إِذا فَرِحتِ فَخافي تَرحَةً عَجَلا","وَإِن تَرِحتِ فَرَجّي أُمَّ عَبّادِ",73,"د",1,0],["إِذا فَرَغَت كَأسُ اِمرِىءٍ خَرَّ ساجِداً","وَصَبَّ لَنا صَفراءَ في طيبِ تُفّاحِ",74,"ح",1,0],["إِذا فَزِعتَ يَوماً لُؤَيُّ بنُ غالَبٍ","رَمى دونَهُم بِالخَيلِ مُعتَرِضاتِ",75,"ت",1,0],["إِذا فَزَعَت بِلادُ بَني مَعَدٍّ","حَمَيناها بِأَغلِمَةٍ غِضابِ",76,"ب",1,0],["إِذا فُضَّت خَواتِمُهُ عَلاهُ","يَبيسُ القُمَّحانِ مِنَ المُدامِ",77,"م",1,0],["إِذاً فَعاقَبَني رَبّي مُعاقَبَةً","قَرَّت بِها عَينُ مَن يَأتيكَ بِالفَنَدِ",78,"د",1,0],["إِذا فَعَلَ الفَتى ماعَنهُ يَنهى","فَمِن جِهَتَينِ لا جِهَةٍ أَساءَ",79,"س",3,0],["إِذا فَزِعنا فَإِنَّ الأَمنَ غايَتُنا","وَإِن أُمِّنا فَما نَخلو مِنَ الفَزَعِ",80,"ع",1,1],["إِذا فاتَكَ الإِثراءُ مِن غَيرِ وَجهِهِ","فَإِنَّ قَليلَ الخَلِّ أَولى وَأَبرَكُ",81,"ك",1,0],["إِذا فاتَهُم طَعنُ الرِماحِ فَمَحفِلٌ","تَرى فيهِ مَطعوناً عَلَيهِ وَطاعِنا",82,"ن",2,0],["إِذاً فَعَدِمتُ المالَ إِلّا مُقَيَّراً","بِأَقرَابِهِ نَسفٌ مِنَ العَرِّ جالِبُ",83,"ب",1,0],["إذا فُتحتْ جنَّاتُ عَدْنٍ وأُزلفتْ","فأنتَ بها للأنبياءِ رَفيقُ",84,"ق",1,0],["إذا فقدت بِلادي","فَذاكَ أَكبر ثكل",85,"ل",1,0],["إذا فتح القوم المعادون لي قَلبي","رأوه سَليماً لَيسَ فيه سوى الحبِّ",86,"ب",1,1],["إذاً فما للناسِ ضلُّوا الهدى","وأخطأوا اليوم سبيلَ الرشادْ",87,"د",1,0],["إذا فُتحَ البابُ تحتَ الظلام","فكيف ارتماؤُك في صَدرِها",88,"ر",3,0],["إِذا فَكَّرَت قالَت قَدِ اِدرَكتُ وُدَّهُ","وَما ضَرَّني بُخلي فَكَيفَ أَجودُ",89,"د",1,0],["إذا فَتَرَتْ ضَرْبَ الجَناحَيْنِ عاقَبَتْ","عَلى شُزُنَيْها مَنْكِباً بَعْدَ مَنْكَبِ",90,"ب",1,0],["إذا فَنيَ الشّهْرُ الحَرامُ وجَدْتَني","وبُرْدُ هِلالٍ مَلْبَسي يوْمَ إهْلال",91,"ل",1,0],["إذا فَضّ منها الطّعْنُ مَعْقِدَ حَلْقَةٍ","أتى هالِكيٌّ للفَضِيضِ بأقْفال",91,"ل",1,0],["إِذا فاضَ دَمعي وَاِستَهَلَّ عَلى خَدّي","وَجاذَبَني شَوقي إِلى العَلَمِ السَعدي",92,"ي",1,1],["إِذا فَرَّقْتَ بَيْنِي وَبَيْنَهُمُ النَّوَى","فَإِنِّي بِعَيْنَيْهِ إِلَيْهِمْ لَنَاظِرُ",93,"ر",1,0],["إِذَا فَاخَروا بكَ فَاخِرْ بهمْ","فَهُمْ في بَني الشَّرْق غُرٌّ وَصيد",94,"د",1,0],["إِذَا فَاتَتِ العَافِينَ آيَةُ حُسْنِهَا","فَمَا فَاتَهُمْ أَنْ يَقْرَأُوا سُورَةَ الْحَمْدِ",95,"د",1,0],["إِذا فَرقَدُ المَوماةِ لاحَ اِنتَضَلنَهُ","بِمَكحولَةِ الأَرجاءِ بيضِ المَواكِفِ",96,"ف",1,0],["إِذا فاتَ شَيءٌ سَمعَهُ دَلَّ أَنفُهُ","وَإِن فاتَ عَينَيهِ رَأى بِالمَسامِعِ",97,"ع",1,0],["إِذا فَتَحَ القومُ أَفواهَهُم","لِغَيرِ كَلامٍ وَلا مَطعَمِ",98,"م",1,1],["إِذا فَاضَ بَيْنَ الزَّهْر تَحْسَبُ أنَّه","يَمَانيُّ بُرْدٍ أَذْهَلَ التَّجْرَ ناشِرُه",99,"ر",2,0],["إذا فاضت ينابعُه خطيباً","علمتَ بأن ماءَ البحرِ ضَحْل",100,"ل",1,0],["إذا فاض الثراء بمصرَ، غابوا","وإن نزل البلاءُ بمصرَ، لاحوا",101,"ح",3,0],["إذا فخر العصامِيُّون يومًا","بأنفسهم، فأَتْتَ له مثال",102,"ل",1,0],["إذا فرغت كأس امرئ خر ساجداً","وصب لنا صفراء في طيب تفاح",103,"ح",1,0],["إذا فصلتْ منهم لغزَّة عيرُ","تسُرُّهمْ عند القفول بضاعة",104,"ه",1,0],["إذا فَشِلَتْ كلُّ الروابطِ بيننا","فرابطةُ الآدابِ أمتنُ رابطه",105,"ط",2,0],["إذا کفْتَلَتَتْ مِنْكَ النَّوَى ذَا مَوَدَّة","ٍ حَبِيباً بِتَصْدَاعٍ مِنَ البَيْنِ ذي شَعْبِ",106,"ب",1,0],["إذا فتَتَحُوا أرْضاً أعَدّوا لمِثْلِها","كَتائبَ تَفرِي من أعاديكَ ما تَفرِي",107,"ر",2,0],["إذا فلت قال الدهر أحسنت يا فتى","ولو كان ذا حس لغاب عن الحسّ",108,"س",1,0],["إذا فضَلتْ نِسعتيها","وأصبحَ ضفرُها قلِقاً يجولُ",109,"ل",1,0],["إذا فَرَغُوا من جانبٍ مَالَ جَانهبٌ","عَلَيْهِمْ فذادُوهُمْ ذيادَ الحَوَائِمِ",110,"م",1,0]]}