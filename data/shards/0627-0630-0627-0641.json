"لقد فاز قوم باللباب من العلم","https://www.aldiwan.net/poem14385.html","الطويل"],[441,"نجمع والمجموع يكلا ويترك","https://www.aldiwan.net/poem14471.html","الطويل"],[458,"أدرك ما شاء غلام فطنا","https://www.aldiwan.net/poem55840.html","الرجز"],[458,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[458,"لها كل يوم نشطة وعقال","https://www.aldiwan.net/poem55906.html","الطويل"],[458,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[458,"تمنى رجال أن تزل بي النعل","https://www.aldiwan.net/poem55997.html","الطويل"],[458,"لعلك بالشعب تعلو اليفاعا","https://www.aldiwan.net/poem56128.html","المتقارب"],[458,"سل بالغوير السائق المغلسا","https://www.aldiwan.net/poem56152.html","الرجز"],[458,"ذكرت وما وفاي بحيث أنسى","https://www.aldiwan.net/poem56157.html","الوافر"],[458,"إذا فطمت قراره كل وادي","https://www.aldiwan.net/poem56229.html","الوافر"],[458,"إذا فاتها روض الحمى وجنوبه","https://www.aldiwan.net/poem56273.html","الطويل"],[458,"يا دار لا أنهج القشيب","https://www.aldiwan.net/poem56284.html","مخلع البسيط"],[461,"يغب الغيث أكناف البلاد","https://www.aldiwan.net/poem15141.html","الوافر"],[461,"دعوت الله رب العرش علما","https://www.aldiwan.net/poem15266.html","الوافر"],[461,"الام يراك المجد في زي شاعر","https://www.aldiwan.net/poem15927.html","الطويل"],[464,"متى لمتني في الغوزال الأغنِ","https://www.aldiwan.net/poem3326.html","عموديه"],[468,"إذا فت في عضدي صاحب","https://www.aldiwan.net/poem60392.html","المتقارب"],[514,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[515,"أأحبابنا كم تبخلون وكم نسخو","https://www.aldiwan.net/poem12057.html","الطويل"],[529,"أعن ذكرها يسلو الفؤاد المبلبل","https://www.aldiwan.net/poem37271.html","الطويل"],[538,"السحر هذا ما أرى","https://www.aldiwan.net/poem48280.html","عموديه"],[540,"صرمت حبائلا من حب سلمى","https://www.aldiwan.net/poem56867.html","الوافر"],[562,"لا تبك ميتا ولا تفرح بمولود","https://www.aldiwan.net/poem52979.html","البسيط"],[562,"نفارقكم ونضرب في البلاد","https://www.aldiwan.net/poem52988.html","الوافر"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[569,"إذا كنت في حمان في عقر دارهم","https://www.aldiwan.net/poem52025.html","البسيط"],[575,"غريمي ولكنه الماطل","https://www.aldiwan.net/poem3034.html","المتقارب"],[575,"مضى معهم قلبي فلله درره","https://www.aldiwan.net/poem3060.html","الطويل"],[586,"خذوا قودي من أسير الكلل","https://www.aldiwan.net/poem17697.html","المتقارب"]],"verses":[["إِذا فَعَداني الضَيفُ في كُلِّ لَيلَةٍ","وَكُبَّت بِأَعجازِ البُيوتِ جِفاني",0,"ي",1,0],["إِذا فاحَ رَيَعانُ النَسيمِ رَأَيتَها","إِلى الجانِبِ الغَربي عوجَ الخَياشِمِ",1,"م",1,0],["إِذا فَغَرَت شَوهاءُ مِن جانِبِ العِدا","عَلى غَيرِ نَذرٍ لَقَّموها القَنا الذُبلا",2,"ل",2,0],["إِذا فَزِعوا لِلأَمرِ أَلجوا ظُهورَهُم","إِلى كُلِّ طَودٍ مِن نِزارٍ عَطَوَّدِ",3,"د",1,0],["إِذاً فَثَكِلتُ سابِحَتي وَسَيفي","غَداةَ وَغىً وَراحِلَتي وَزادي",4,"د",2,0],["إِذا فاضَ رَقراقُ المَحامِدِ صَيَّروا","لَهُ جودَهُم دونَ اللِئامِ نَصائِبا",5,"ب",2,0],["إذا فتّشَ التّجريبُ عنهُمْ تَشابَهَتْ","سَجايا كأطْرافِ الرِّماحِ شُكولُ",6,"ل",1,0],["إِذا في مَجلِسٍ نَذكُر عَلِيّاً","وَسِبتَيهِ وَفاطِمَةَ الزَكِيَّه",7,"ي",2,1],["إِذَا فَاتَنِي ظِلُّ الْحِمَى وَنَعِيمُهُ","كَفَانِي وَحَسْبِي أَنْ يَهُبّ نَسِيمُهُ",8,"م",2,1],["إِذَا فَكَّرْتَ فِي وَطَنٍ كَرِيمٍ","نَبَتْ بِكَ عَنْهُ نَائِبَةُ اغْتِرَابِ",9,"ب",1,1],["إِذا فاتَ شَيءٌ فَاصطَبِر لِذهابِهِ","وَلا تَتبَعَنَّ الشيءَ إِن فاتَكَ الجَزَع",10,"ع",1,0],["إِذا فَضَلَت مَعاقِدُ نِسعَتَيها","وَأَصبَحَ ضَفرُها قَلِقاً يَجولُ",11,"ل",1,0],["إذا فاق سادات الحمى آل سرسق","فإن نجيباً فيهم السيد الجعد",12,"د",1,0],["إِذا فارَقَتهُ تَبتَغي ما تَعيشُهُ","كَفاها رَذاياها الرَقيعُ الهَبَنَّقُ",13,"ق",1,0],["إِذاً فَرَماني اللَهُ مِن حَيثُ لا أَرى","وَلا زالَ في أَرضي عَدُوٌّ أُحارِبُه",14,"ب",2,0],["إذا فاض من يمناه بحر سماحة","وعَمَّ به الطوفان في النجد والوَهْدِ",15,"د",1,0],["إِذا فاضَلتَ مَدَّكَ مِن قُرَيشٍ","بُحورٌ غَمَّ زاخِرُها الثِمادا",16,"د",2,0],["إِذا فَوَّزَت عَن ذي جَراوِلَ أَنجَدَت","مِنَ الغَورِ وَاِعرَورَت حَزابِيَها الغُبرا",17,"ر",2,0],["إِذا فَوَّزَت عَن نَهرَبينَ تَقاذَفَت","بِحَدراءَ دارٌ لا تُريدُ لِتَجمَعا",18,"ع",2,0],["إِذا فَوَّزَت عَن مَسحُلانَ وَدافَعَت","بِشَيبانَ لاقى القَينُ مِن دونِها شُغلا",19,"ل",2,0],["إِذا فَزِعوا لَم تُعلَفِ القَتَّ خَيلُهُم","وَلَكِن صُدورَ الأَزأَنِيِّ نَسومُها",20,"م",3,0],["إِذا فَضلَةٌ مِن بَطنِ زِقٍّ وَنُطفَةٌ","وَقَعبٌ صَغيرٌ فَوقَ عَوجاءَ ضامِرِ",21,"ر",1,0],["إذا فرَّق الفاروقُ في الخلق ذكرهم","فيا حبَّذا الأطهارُ تعزَى إلى الطّهر",22,"ر",1,0],["إذا فتن الألباب حسنك ساذجاً","فما حاجة الخدّ البديع إلى الرّقم",23,"م",1,0],["إذا فاخر الأنداد جاءَ فخاره","بهذا الثنا يستوقف المتأمّلا",24,"ل",2,0],["إذا فعل السوء قال الخنا","ليشبه منظره المسمع",25,"ع",1,0],["إذا فقدت فسوها","فأنفاسها تخلف",26,"ف",1,0],["إذا فُقتَ الضئيل بحسن جسم","فلا يسبقك بالشيم الشريفه",27,"ه",1,1],["إذا فكروا في مدحه ذات بينهم","فمنهم أخو التغريد والمتلوِّمُ",28,"م",1,0],["إِذا فُضَّت خَواتِمُها وَفُكَّت","يُقالُ لَها دَمُ الوَدَجِ الذَبيحُ",29,"ح",1,0],["إِذا فَرَغَت مِن الراحِ الدِنانُ","تَوَهَّمَ أَنَّما فَرَغَ الزَمانُ",30,"ن",1,0],["إِذا فَعَلَ الأَقوامُ نَوعاً مِنَ النَدى","تَنَوَّعَ فيهِ جودُهُ وَتَجَنَّسا",31,"س",2,0],["إِذا فَزِعوا طارَت بِأَبيَضَ صارِمٍ","وَرامَت بِما في جَفرِها ثُمَّ سَلَّتِ",32,"ت",1,0],["إِذا فاطَنَتنا في الحَديثِ تَهَزهَزَت","إِلَيها قُلوبٌ دونَهُنَّ الجَوانِحُ",33,"ح",1,0],["إِذا فَضَحَ الأَملاكَ نَقصٌ فَإِنَّهُ","يُبَيِّنُهُ عِندَ الأَنامِ تَمامي",34,"ي",1,0],["إذا فنيت زهور أو نجوم","وزايلها البهاء بدا عليك",35,"ك",1,0],["إذا فاتتك قلت اختار دهري","وإن هي لم تفت قلت اختياري",36,"ي",1,0],["إِذا فَعَلوا فَخَيرُ الناسِ فِعلاً","وَإِن قالوا فَأَكرَمُهُم مَقالا",37,"ل",2,0],["إذاً فرماني الدَّهْرُ عن قَوْسِ هجركُمْ","بأَسْهُمِهِ ذاتِ الشُّجونِ الصَّوائبِ",38,"ب",1,0],["إِذا فَزِعَت قَدَّمَتها الجِيادُ","وَبيضُ السُيوفِ وَسُمرُ القَنا",39,"ا",1,0],["إِذا فاتوا الرِماحَ تَناوَلَتهُم","بِأَرماحٍ مِنَ العَطَشِ القِفارُ",40,"ر",1,0],["إِذا فَلَّ عَزمي عَن مَدىً خَوفُ بُعدِهِ","فَأَبعَدُ شَيءٍ مُمكِنٌ لَم يَجِد عَزما",41,"م",2,0],["إِذا فطمتْهُ الشمسُ فهو مُفَضَّضٌ","وإن حضنتهُ مَسَّ قُطْريهِ تذهيبُ",42,"ب",1,0],["إِذا فُرَصُ المَجدِ عَنَّت لَهُ","تَغَنَّمَ بِالحَزمِ إِمكانَها",43,"ن",3,0],["إِذاً فَأَصابَتكُم مِنَ اللَهِ جَزَّةٌ","كَما جَزَّ أَعلى سُنبُلٍ كَفُّ حاصِدِ",44,"د",1,0],["إِذا فَزِعَ النِساءُ فَلا تُبالي","لَها سوقاً خَرَجنَ وَلا خِمارا",45,"ر",2,0],["إِذا فَمُ كَبشِ القَومِ كانَ كَأَنَّهُ","لَهُ فَمُ كَلّاحٍ مِنَ الرَوعِ أَروَقِ",46,"ق",1,1],["إِذا فَزِعوا هَزّوا لِواءَ اِبنِ حابِسٍ","وَنادَوا كَريماً خَيمُهُ وَشَمائِلُه",47,"ل",2,0],["إِذا فَرَغوا مِن جانِبٍ مالَ جانِبٌ","عَلَيهِم فَذادوهُم ذِيادَ الحَوائِمِ",48,"م",1,0],["إذا فاجأتْنا الحادثاتُ بمصرَعٍ","فليس سِوى الجَنْبِ الكريمِ لنا جَنْبُ",49,"ب",1,0],["إِذا فَزِعوا طاروا إِلى مُستَغيثِهِم","طِوالَ الرِماحِ لا ضِعافٌ وَلا عُزلُ",50,"ل",1,0],["إِذا فَكَّرتُ في نَدَمي عَلَيها","عَضَضتُ أَنامِلي وَقَرَعتُ سِنّي",51,"ن",2,0],["إذا فرّتِ الأبطال كرّ وسيفُهُ","يُحِلّ بيمناهُ دمَ العلجِ محرمُ",52,"م",1,0],["إذا فتحت أبوابُها خلتَ أنَّها","تقولُ بترحيبٍ لداخلها أَهلا",53,"ل",2,0],["إذا فتحَ المزاجُ اللَّونَ منها","مضى وردٌ لها وأتى بَهَارُ",54,"ر",1,0],["إِذا فُقِدَ المَفقودُ مِن آلِ مالِكٍ","تَقَطَّعَ قَلبي رَحمَةً لِلمَكارِمِ",55,"م",1,0],["إِذا فَرَشوهُ النَصفَ ماتَت شَذاتُهُ","وَإِن رَتَعوا في ظُلمِهِ كانَ أَظلَما",56,"م",2,0],["إِذا فَضَلَت عَن رَأيِ غَيرِكَ أَصبَحَت","وَرَأيُكَ عَن جِهاتِها السِتِّ فاضِلُ",57,"ل",1,0],["إِذا فَقَدَتهُ ساعَةً عِندَ مَرتَعٍ","تَراها عَلَيهِ بِالبُغامِ تَفَجَّعُ",58,"ع",1,0],["إذا فَرِغُوا من فُنونٍ خَلَتْ","أَتوا بعدها بِفُنونٍ أُخَرْ",59,"ر",1,0],["إِذا فَدَحَت خُطوبُ الدَهرِ يَوماً","فَنِعمَ العَونُ فيها وَالرَفيقُ",60,"ق",1,0],["إذا فزعوا للظلمِ كنتَ لهم حِمىً","وإن أعوزَ الأنصارُ أَلْفَوْكَ ناصرا",61,"ر",2,0],["إِذا فُهتُ بِالشَكوى تَرَنَّمَ صاحِبي","كَما طارَحَ الغُصنَ الحَمامُ المُطَوَّقُ",62,"ق",1,0],["إِذا فِئَةُ العُذّالِ جاءَت بِسِحرِها","فَفي لَحظِ موسى آيَةٌ تُبطِلُ السِحرا",63,"ر",2,0],["إِذ أُفقُهُ كُلُّ البِلادِ وَعَصرُهُ","كُلُّ الزَمانِ وَشَخصُهُ كُلُّ الوَرى",64,"ر",2,0],["إِذا فارَقوا دُنياهُمُ فارَقوا الأَذى","وَصاروا إِلى مَوعودِ ما في المَصاحِفِ",65,"ف",1,0],["إِذا فَزَّعوا أُمَّ الصَبِيَّينِ نَفَّضوا","عَفارِيَ شُعثاً صافَةً لَم تُرَجَّلِ",66,"ل",1,0],["إِذا فَعَلتِ الَّذي فَعَلتِ فَقُولي","حَمدَ خَيراً وَأَتبَعي القَولَ فِعلا",67,"ل",2,0],["إذا فارق المرءُ الرفيعُ مكانُه","فليس له إلا عليك طريق",68,"ق",1,0],["إِذا فُؤادٌ شَجاهُ حُبٌّ","فَقَلَّما يَنفَعُ الطَبيبُ",69,"ب",1,0],["إِذا فَقَدَ الرَغيفَ بَكى عَلَيهِ","بُكا الخَنساءِ إِذ فُجِعَت بِصَخرِ",70,"ر",1,0],["إِذا فَكَّرتُ في عِرضِ","كَ أَشفَقتُ عَلى شِعري",71,"ي",1,0],["إِذا فارَقتُها صَبَّت","عَلَيَّ الهَمَّ وَالفِكرا",72,"ر",2,0],["إِذا فَرِحتِ فَخافي تَرحَةً عَجَلا","وَإِن تَرِحتِ فَرَجّي أُمَّ عَبّادِ",73,"د",1,0],["إِذا فَرَغَت كَأسُ اِمرِىءٍ خَرَّ ساجِداً","وَصَبَّ لَنا صَفراءَ في طيبِ تُفّاحِ",74,"ح",1,0],["إِذا فَزِعتَ يَوماً لُؤَيُّ بنُ غالَبٍ","رَمى دونَهُم بِالخَيلِ مُعتَرِضاتِ",75,"ت",1,0],["إِذا فَزَعَت بِلادُ بَني مَعَدٍّ","حَمَيناها بِأَغلِمَةٍ غِضابِ",76,"ب",1,0],["إِذا فُضَّت خَواتِمُهُ عَلاهُ","يَبيسُ القُمَّحانِ مِنَ المُدامِ",77,"م",1,0],["إِذاً فَعاقَبَني رَبّي مُعاقَبَةً","قَرَّت بِها عَينُ مَن يَأتيكَ بِالفَنَدِ",78,"د",1,0],["إِذا فَعَلَ الفَتى ماعَنهُ يَنهى","فَمِن جِهَتَينِ لا جِهَةٍ أَساءَ",79,"س",3,0],["إِذا فَزِعنا فَإِنَّ الأَمنَ غايَتُنا","وَإِن أُمِّنا فَما نَخلو مِنَ الفَزَعِ",80,"ع",1,1],["إِذا فاتَكَ الإِثراءُ مِن غَيرِ وَجهِهِ","فَإِنَّ قَليلَ الخَلِّ أَولى وَأَبرَكُ",81,"ك",1,0],["إِذا فاتَهُم طَعنُ الرِماحِ فَمَحفِلٌ","تَرى فيهِ مَطعوناً عَلَيهِ وَطاعِنا",82,"ن",2,0],["إِذاً فَعَدِمتُ المالَ إِلّا مُقَيَّراً","بِأَقرَابِهِ نَسفٌ مِنَ العَرِّ جالِبُ",83,"ب",1,0],["إذا فُتحتْ جنَّاتُ عَدْنٍ وأُزلفتْ","فأنتَ بها للأنبياءِ رَفيقُ",84,"ق",1,0],["إذا فقدت بِلادي","فَذاكَ أَكبر ثكل",85,"ل",1,0],["إذا فتح القوم المعادون لي قَلبي","رأوه سَليماً لَيسَ فيه سوى الحبِّ",86,"ب",1,1],["إذاً فما للناسِ ضلُّوا الهدى","وأخطأوا اليوم سبيلَ الرشادْ",87,"د",1,0],["إذا فُتحَ البابُ تحتَ الظلام","فكيف ارتماؤُك في صَدرِها",88,"ر",3,0],["إِذا فَكَّرَت قالَت قَدِ اِدرَكتُ وُدَّهُ","وَما ضَرَّني بُخلي فَكَيفَ أَجودُ",89,"د",1,0],["إذا فَتَرَتْ ضَرْبَ الجَناحَيْنِ عاقَبَتْ","عَلى شُزُنَيْها مَنْكِباً بَعْدَ مَنْكَبِ",90,"ب",1,0],["إذا فَنيَ الشّهْرُ الحَرامُ وجَدْتَني","وبُرْدُ هِلالٍ مَلْبَسي يوْمَ إهْلال",91,"ل",1,0],["إذا فَضّ منها الطّعْنُ مَعْقِدَ حَلْقَةٍ","أتى هالِكيٌّ للفَضِيضِ بأقْفال",91,"ل",1,0],["إِذا فاضَ دَمعي وَاِستَهَلَّ عَلى خَدّي","وَجاذَبَني شَوقي إِلى العَلَمِ السَعدي",92,"ي",1,1],["إِذا فَرَّقْتَ بَيْنِي وَبَيْنَهُمُ النَّوَى","فَإِنِّي بِعَيْنَيْهِ إِلَيْهِمْ لَنَاظِرُ",93,"ر",1,0],["إِذَا فَاخَروا بكَ فَاخِرْ بهمْ","فَهُمْ في بَني الشَّرْق غُرٌّ وَصيد",94,"د",1,0],["إِذَا فَاتَتِ العَافِينَ آيَةُ حُسْنِهَا","فَمَا فَاتَهُمْ أَنْ يَقْرَأُوا سُورَةَ الْحَمْدِ",95,"د",1,0],["إِذا فَرقَدُ المَوماةِ لاحَ اِنتَضَلنَهُ","بِمَكحولَةِ الأَرجاءِ بيضِ المَواكِفِ",96,"ف",1,0],["إِذا فاتَ شَيءٌ سَمعَهُ دَلَّ أَنفُهُ","وَإِن فاتَ عَينَيهِ رَأى بِالمَسامِعِ",97,"ع",1,0],["إِذا فَتَحَ القومُ أَفواهَهُم","لِغَيرِ كَلامٍ وَلا مَطعَمِ",98,"م",1,1],["إِذا فَاضَ بَيْنَ الزَّهْر تَحْسَبُ أنَّه","يَمَانيُّ بُرْدٍ أَذْهَلَ التَّجْرَ ناشِرُه",99,"ر",2,0],["إذا فاضت ينابعُه خطيباً","علمتَ بأن ماءَ البحرِ ضَحْل",100,"ل",1,0],["إذا فاض الثراء بمصرَ، غابوا","وإن نزل البلاءُ بمصرَ، لاحوا",101,"ح",3,0],["إذا فخر العصامِيُّون يومًا","بأنفسهم، فأَتْتَ له مثال",102,"ل",1,0],["إذا فرغت كأس امرئ خر ساجداً","وصب لنا صفراء في طيب تفاح",103,"ح",1,0],["إذا فصلتْ منهم لغزَّة عيرُ","تسُرُّهمْ عند القفول بضاعة",104,"ه",1,0],["إذا فَشِلَتْ كلُّ الروابطِ بيننا","فرابطةُ الآدابِ أمتنُ رابطه",105,"ط",2,0],["إذا کفْتَلَتَتْ مِنْكَ النَّوَى ذَا مَوَدَّة","ٍ حَبِيباً بِتَصْدَاعٍ مِنَ البَيْنِ ذي شَعْبِ",106,"ب",1,0],["إذا فتَتَحُوا أرْضاً أعَدّوا لمِثْلِها","كَتائبَ تَفرِي من أعاديكَ ما تَفرِي",107,"ر",2,0],["إذا فلت قال الدهر أحسنت يا فتى","ولو كان ذا حس لغاب عن الحسّ",108,"س",1,0],["إذا فضَلتْ نِسعتيها","وأصبحَ ضفرُها قلِقاً يجولُ",109,"ل",1,0],["إذا فَرَغُوا من جانبٍ مَالَ جَانهبٌ","عَلَيْهِمْ فذادُوهُمْ ذيادَ الحَوَائِمِ",110,"م",1,0],["إذا في العلوم الناعسون تكلّموا","أو الدين أو أخرى تراه تسنَّما",111,"م",2,0],["إذا فيها استغاثُوا لم يغاثوا","ولم يجدُوا هناكَ لهم مجيرَا",112,"ر",2,0],["إذا فغرت أفواهها لكريهةٍ","تدك الرواسي والحصونَ تحطّمُ",113,"م",1,0],["إذا فُتنَ الإنسانُ يوما بمنظَرٍ","فإنى إلى النارنج مائلةٌ نفسى",114,"س",2,1],["إذا فرّقتهنّ البنانُ تشبَّثت","بمثل هَباء الشمسِ خوفا من البُعدِ",115,"د",1,0],["إذا فَذْلكَ العيشُ عمرَ الفتىَ","فسيّانِ ما خلفه والأمامُ",116,"م",1,0],["إِذا فاخَرَت بِالجودِ عُربٌ سِواكُمُ","فَفَخرُهُمُ ما تَمنَحُ الجَفنَةَ القِدرُ",117,"ر",1,0],["إِذا فاخَروا طابوا أَخيراً وَأَوَّلاً","وَإِن طاعَنوا طالوا رِماحاً وَأَذرُعا",118,"ع",2,0],["إذا فتقت روس النصال عشاءه","نثرن شعاع الشمس نثر الدراهم",119,"م",1,0],["إذا فما قوم المعوج من خلقي","ملك أقام اعوجاج الدهر فانتصبا",120,"ب",2,0],["إذا فارقت ثعلبة بن سعد","وإخوتهم نسبت إلى لؤيّ",121,"ي",1,1],["إِذا فَحلُ قَومٍ هاجَ وَاِنحَلَّ قَيدُهُ","فَفي سَيفِهِ قَيدٌ لَهُ وَخِزامُ",122,"م",1,0],["إذا فكرت في زمن عبوس","وفي جيلي من البشر الخسيس",123,"س",1,1],["إذا فتح امرؤ للوصل بابا","فقد حصلَ التتبع والعتاب",124,"ب",1,1],["إذا فات الفتى شيئان أضحى","بعيدا من ممازحةِ القلوب",125,"ب",1,1],["إذاً فقل أنا حشويٌّ بدون حياً","وَاِبرأ منَ الشافعي أنتَ الدعيّ بهِ",126,"ب",2,0],["إِذا فُرِسَ العَوالي لَم يُخالِج","هُمومي غَيرَ نَصرٍ وَاِقتِرابِ",127,"ب",1,1],["إذا فاز خلّ من خليل بنظرة","فعن أمرنا في الحب يحيا ويرزق",128,"ق",1,0],["إذا فرحوا بنوم الدهر عنهم","فيوم ذهابهم يومٌ قريب",129,"ب",1,0],["إذا فكرتُ فيك غلت دمائي","وآذن جمر حقدي بالتهاب",130,"ب",1,0],["إِذا فارَقتَ نَدماناً بِلَيلٍ","تُواعِدُهُ لِقاءَكَ ذا صَباحِ",131,"ح",1,0],["إِذا فَتحَ العداةُ عليكَ حرباً","وَخِفتَ بوادِرَ المُتَحَزِّبينا",132,"ن",2,1],["إذاً فلبِستُ البخلَ لُبْسَ محسِّنٍ","له ومَنَعت المنعِمِين من الشكرِ",133,"ر",1,0],["إذا فَرِقوا أبدَوْ وداداً وذلّة","وأنفسُهمْ حربٌ وألسُنُهمْ لُدُّ",134,"د",1,0],["إذا فزَّع الشوقُ حبَّ القلوبِ","كواها بشدّة تَلْهَابها",135,"ب",3,0],["إِذا فُضَّ يَوماً في يَدَيَّ خِتامُها","تَضَوَّعَ مِن إِنشادِها فيكُم التُربُ",136,"ب",1,0],["إِذا فالَ أَبدَعَ فيما يَقولُ","وَإِن جادَ أَجزَلَ فيما يَهَب",137,"ب",1,0],["إِذا فَكَّ هَذا اليَوم أَسوأ هجرها","ثَنَنتهُ بِيَومٍ مِن تجنّبها أَسوا",138,"و",2,0],["إذاً فلنُغَنِّ وننسَ الهمومَ","فإنَّ الحياةَ غداً لانصِرام",139,"م",1,0],["إذاً فنعلل بالفناءِ وجودَنا","ولا نكُ أشراراً لنغنم أو نظفر",140,"ر",1,0],["إذاً فاشقَ يا قلبي بحبٍّ ومَطمَعٍ","فمن يَشقَ يرحَم من يئنُّ ويُرحَم",141,"م",1,0],["إذا فاء الفتى لنهاه يوماً","رأى الأعمار للآجال فيّا",142,"ي",2,0],["إذا فخَروا لم يفخَروا بأُشابةٍ","ولا نسبٍ في صالحي القوم مُلْصَقِ",143,"ق",1,0],["إِذا فُتِحَتْ أَبْرَزَتْ أَنْصُلاً","كَما فَغَر اللَّيْثُ يَوْماً فَمَهْ",144,"م",2,0],["إِذا فرائدُ جيشٍ عنده اِتَّسقت","مَشى العُرَضنة والشعواءُ في ضَرمِ",145,"م",1,0],["إذا فاته في الدهر تاجٌ فما له","فوات نحورٍ من فواتن حورِ",146,"ر",1,0],["إذا فاتني قرب الأحبة واللقا","ففي ذكرهم أنس لوحشة خاطري",147,"ر",2,0],["إِذا فَغِمتَ بِقَومٍ جِئتَ أَرضَهُمُ","بِجَحفَلٍ أَرعَنِ الحافاتِ تَنتَقِلُ",148,"ل",1,0],["إِذا فُرَّقٌ في الدارِ خارَت فَنُتِّجَت","أَتى بَعدَها مِن دُلَّحِ العَينِ فُرَّقُ",149,"ق",1,0],["إِذا فيهِ يَخسَرُ ما يُؤَمِّلُ","رِبحَهُ مِن أَجلِهِ",150,"ل",2,0],["اِذا فاخر بهم عصبة قرشية","فجدّهم المُختار حسبُهُم فَخرا",151,"ر",2,0],["إِذا فَزِعوا طاروا بِجَنبَي لِوائِهِم","أُلوفٌ وَغاياتٌ مِنَ الخَيلِ تُقدَعُ",152,"ع",1,0],["إذا فَرَسُ المُعانِدِ رامَ رَكْضاً","تَراجعَت الحُجولُ له شِكالا",153,"ل",2,0],["إذا فَرّغْنَ كأسَ كرىً لعَيْني","ردَدْتُ الكأسَ من دَمْعي دِهاقا",154,"ق",2,0],["إذا فارقَتْ رُوحي سوى عُلْقةٍ لها","بقَلْبي من الذِّكرى ففي قَطْعِها فَقْدي",155,"د",2,0],["إذا فاتَه فضلٌ يُعنِّفُ سعيَه","على فَوته فهو الفَضيل المعنَّف",156,"ف",1,0],["إذا فاتني قرب الأحبة واللقا","ففي ذكرهم راحي وروحي وراحتي",157,"ي",1,0],["إذا فتحوا باب الجنان لوفدكم","وقلت أنا منهم فقل إنه منا",158,"ن",2,0],["إذ أفردوك لكشف كل خفية","حجبت عن الرجل اللبيب الناظر",159,"ر",1,0],["إذا فطمْتَ امرأ عن عادةٍ قَدُمَتْ","فاجعَلْ لهُ يا عقِيدَ الفَضلِ تَدريجا",160,"ج",2,0],["إِذا فاتَ مِن أَربى عَلى العُشرِ رُمحَهُ","مُناهُ فَقَد فاتَت فَتىً رُمحُهُ شِبرُ",161,"ر",1,0],["إِذا فَزِعَت أَفراسه نَحوَ جَحفَلٍ","تُقدَّمها الأقبالُ وَالخَوفُ وَالرُعبُ",162,"ب",1,0],["إذا فَراها المَزَاجُ أضْرَمَها","وقلتَ أيدِي السّقَاةِ تحتَرِقُ",163,"ق",1,0],["إِذا فكَّرتُ في إِنفاقِ عُمري","ضَياعاً في هَواكَ قَرعتُ سِنّي",164,"ي",1,0],["إِذا فَقَدَ الناسُ الغَمامَ تَتابَعَت","عَلَيهِم بِكَفَّيكَ الغُيومُ المَواطِرُ",165,"ر",1,0],["إذا فاضَ منه صدرُه ويمينه","فخذ من كلا البحرين درًّا منضَّدا",166,"د",2,0],["إذا فتكت فينا العيون فواتراً","أتتها القدود الهيف بالحث والحضِ",167,"ض",1,0],["إذا فتكت أهلٍ الجمال فإنما","لهنّ على أهل الهوى الملك والخال",168,"ل",1,0],["إذ افتخر الأمجاد يوما فإنه","على كل ذي فخر علي وراجح",169,"ح",1,0],["إذا فزت بالغفران يوم وداعها","فأحسن شيء ما رجوت اصطناعه",170,"ع",2,0],["إذا فكرت في طسم وعاد","وعمليق وفي عفرا جديس",171,"س",1,0],["إذا فرشت بسط الفتاوى لغيرنا","لنا بسطت فرش الموازين والحزم",172,"م",1,0],["إِذا فاتك الأَمر الذي أنت آمل","فعنه العزا والصبر أَولى وابرك",173,"ك",1,0],["إذا فلَى برمحه كتيبةً","حسبتَه يكتُب فيها بالقنا",174,"ن",2,0],["إذا فَرَّجتْ بين الأصابع غادرتْ","جوانفَ لا يُبْنَى لهنّ هَديمُ",175,"م",1,0],["إذا فارقتكم لم تكن عن خيانةٍ","نواها ولا جرّ الفراق مَلالُ",176,"ل",1,0],["إذا فات سعيُك شأوَ الرياح","فمن أين تلحقُكَ الأرجلُ",177,"ل",1,0],["اذا فُزِّعوا طاروا نفيراً فأكثروا","عديداً وإن نودوا لمطعمةٍ قلّوا",178,"ل",3,0],["إذا فضَّ نافلةَ الأعطياتِ","توهّم يَقسِم حقاً مشاعا",179,"ع",2,0],["إذا فرقن الموتَ لم يفرقَنْ ما","دُيِّثَ من أرضٍ وما توعَّسا",180,"س",2,0],["إذا فَجَع الفراقُ قبضن عشراً","وإن فجأ اللقاءُ بسطن خمسا",181,"س",2,0],["إذا فُطمتْ قَرارهُ كلِّ وادي","فدَرَّتْ باللوى حَلَمُ الغوادي",182,"ي",1,1],["إذا فاتها روضُ الحمى وجَنوبُهُ","كفاها النسيمُ البابليُّ وطِيبُهُ",183,"ب",2,1],["إذا فُروجُ الكلامِ ضاقتْ","تَمَّ بها باعُهُ الرحيبُ",184,"ب",1,0],["إذ افتخرت ملوك الأرض طُراً","بتعديد المساعي والأيادي",185,"د",2,0],["إذا فسدا فمهْلِكُ كل شيءٍ","وإن صَحَّا فداعيةٌ البَقاءِ",186,"ا",2,0],["اذا فاخرتْهُ في بَهاءٍ ومَنْظَرٍ","أباحَ حِمى أضْوائِها للْحوافرِ",187,"ر",1,0],["إذا فرعت قلماً كفهُ","تخيَّلتَ ورقاء من فوق غصن",188,"ن",1,0],["إِذا فَتَّ في عَضُدي صاحِبٌ","وَصَيَّرَني غَرَضُ الإِغتِيابِ",189,"ب",1,1],["إذا في إثْرِها الأفكارُ سارتْ","لتُدرِكَ ثارَها وقَفَتْ حَيارى",190,"ر",2,0],["إذا فرخت في رأس طاغ مكيدة","فصارمه في وكر هامته فرخ",191,"خ",1,0],["إِذَا فاقَ مَحْبوبُ الْفَتَى في جَمالِهِ","فكَيْفَ يَليقُ الصَّبْر أَمْ كَيْفَ يَجْمُلُ",192,"ل",1,0],["إذا فركتَ أذنَه","يُقلِّبنَّ جَفنَه",193,"ه",1,0],["إِذا فَخَّمتُ غَيرَكَ في ثَنائي","وَنُصحي في المَغيبَةِ واِمتِداحي",194,"ح",2,0],["إذا فُجِعتُ بمفقودٍ صَبَرتُ لهُ","إني سأتركُ مفجوعاً بمفقودِ",195,"د",1,0],["إذا فَدَتِ النفوسُ كرامَ قومٍ","فُديتَ بِكُلِ مَفدِيٍّ وفادِ",196,"د",1,0],["إذ أفردا من بعده بماله","من دون بنته ودون آله",197,"ه",1,0],["اذا فزعوا جاءوا بها غير عزل","فَلا أَجل واقٍ وكل دم هدر",198,"ر",1,0],["إِذا فاضَ منه مكانُ الجمال","فكلُّ مكانٍ له قَابِلُ",199,"ل",1,0],["إِذا فتَّن الأَعْداءَ حُسْنُ كَلامِه","أَقولُ لهم هذا البيانُ وسِحْرهُ",200,"ر",2,0],["إذا فَتكتْ فِيَّ ألحاظُهُ","بِقَدٍّ يَقُدُّ فكيفَ العَملْ",201,"ل",1,0]]}