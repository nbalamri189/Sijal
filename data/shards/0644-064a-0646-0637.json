{"poems":[[39,"طربت وهل بك من مطرب","https://www.aldiwan.net/poem7653.html","المتقارب"],[74,"مسلسل من حديث الدمع مذروف","https://www.aldiwan.net/poem19258.html","البسيط"],[47,"أما كان في تلك الدموع السوائل","https://www.aldiwan.net/poem65638.html","الطويل"],[30,"غر كليبا إذ اصفرت معالقها","https://www.aldiwan.net/poem5171.html","البسيط"],[71,"لئن طهرت ثوبا دون قلب","https://www.aldiwan.net/poem28906.html","الوافر"],[47,"بجُودِكَ يَدْنُو النّائلُ المُتَبَاعِدُ،","https://www.poetsgate.com/ViewPoem.aspx?id=31381",""],[173,"ألا رحلت نعم وأقفر نعمان","https://www.aldiwan.net/poem1683.html",""],[287,"شكوت فلم يرق لضعف حالي","https://www.aldiwan.net/poem32662.html","الوافر"],[371,"لعينيه على العشاق إمره","https://www.aldiwan.net/poem17205.html","الوافر"],[482,"حمام بأعلى الجلهتين ينوح","https://www.aldiwan.net/poem15261.html","الطويل"],[543,"بعودتك الحمراء تم لها القصد","https://www.aldiwan.net/poem48240.html","عموديه"],[569,"لئن طرحت بي النائبات فإنني","https://www.aldiwan.net/poem865.html",""],[580,"جلست ببستان الجليس وداره","https://www.aldiwan.net/poem2724.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122733","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64021","الهزج"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59430","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59176","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49960","المتقارب"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49987","الطويل"],[1679,"","https://poetry.dctabudhabi.ae/diwan/poem/27071","الطويل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108482","الوافر"],[2540,"","https://poetry.dctabudhabi.ae/diwan/poem/143458","البسيط"],[2565,"","https://poetry.dctabudhabi.ae/diwan/poem/103758","المتقارب"],[3098,"","https://poetry.dctabudhabi.ae/diwan/poem/131897","الطويل"],[3493,"","https://poetry.dctabudhabi.ae/diwan/poem/100575","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91452","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[4639,"","https://poetry.dctabudhabi.ae/diwan/poem/124662","الطويل"],[4755,"تَقُولُ الليالي الطِوَالْ:","https://www.poetsgate.com/ViewPoem.aspx?id=183545",""],[5085,"هواجس شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=188448",""],[6152,"قريبا ستمطر","https://www.poetsgate.com/ViewPoem.aspx?id=203422",""],[186,"وداع وما يغني الوداع من الوجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55748&r=&rc=11",""]],"verses":[["لَئِن طَالَ شِربيَ للآجِنَاتِ","لقد طَابَ عِندَهُم مَشرَبِي",0,"ب",2,0],["لينطق الجود بعد العيّ ذا مدحٍ","تأتي وما عندها في القولِ تكليف",1,"ف",1,0],["لَئِن طالَ لَيلى في هَواكَ وَلَوعَتي","لَما كانَ حَظّي في هَواكَ بِطائِلِ",2,"ل",1,0],["لَئِن طَلَبتُم بِهِ شَأوي لَقَد عَلِمَت","أَنّي عَلى العَقبِ خَرّاجٌ مِنَ القَتَرِ",3,"ر",1,0],["لئنْ طهَّرتَ ثوباً دونَ قلبٍ","فطُهرُ الثوبِ دونَ القلبِ حَيْضُ",4,"ض",1,1],["لَئنْ طَالَ حرْمَانُ الزّمانِ، فإنّهُ","سَيُسْليِهِ يَوْمٌ منْ عَطائكَ واحدُ",5,"د",1,0],["لَئِن طَلَبَت أَهلُ المَمالِكِ حَقَّها","وَسارَ بِهِم قَلبٌ إِلى المَجدِ حَرّانُ",6,"ن",1,0],["لَئِن طالَت بِهَجرِهِمُ لَيالٍ","لَقَد قَصُرَت بِوَصلِهِمُ لَيالي",7,"ل",2,0],["لَئِن طالَت لَقَد طابَت وَراقَت","عَلى نَظَرِ الخواطِرِ حُسنَ نَظرَه",8,"ر",2,0],["لئن طالَ عهدُ الحاجبيَّةِ باللَّوى","فما الموتُ إلا للمحبَّ مريحُ",9,"ح",1,0],["لئن طالَ من مولاي عنا مَغيبُه","فما كان إلا الجزرُ يعقُبه المَدُّ",10,"د",1,0],["لئن طرحت بي النائبات فإنني","وحق المعالي الغر لا أتزعزع",11,"ع",1,1],["لئن طِبْتُ في مُسْتَنْزَهٍ لم تَكُنْ بِهِ","فلا زلتُ أَلْقى عِنْدَكَ الصَّدَّ والهَجْرَا",12,"ر",2,0],["لَئِن طِبَتَ نَفساً عَن أَبيكَ بمَوعِدٍ","غُرُورٍ وَغَرسٍ آجِلٍ غَيرَ عامِلِ",13,"ل",1,0],["لئن طبتَ منَ الأصلِ","لما طبتَ من الفرع",14,"ع",1,0],["لئن طوحت أيدي النوى بك غيلة","فيمم محل الأمن فهو قريب",15,"ب",1,0],["لَئِنْ طِبْتِ نَفْساً عَنْ وِصَالِي فَإنَّنِي","لأطْيَبُ نَفْساً مِنْكِ إذ خُنْتِ صُحْبَتِي",16,"ي",1,1],["لئن طالَ بعدٌ وَبرَّح وجدٌ","ففي الكأس بَردٌ لحرّ الفؤآدِ",17,"د",1,0],["لئن طمست من ناضريَّ عهودها","فهنّ لقلبي ما لهنَّ طموسُ",18,"س",1,0],["لَئِن طالَ لَيلي بِالعِراقِ لَرُبَّما","أَتى لِيَ لَيلٌ بِالشَآمِ قَصيرُ",19,"ر",1,0],["لئن طرحوك في ظلمات غار","ففي روض العفاف شذاك فاحا",20,"ح",2,0],["لئنْ طغى الماءُ في أوطاننا وغدتْ","جُدرانُها بقضاء الله جُذْرانا",21,"ن",2,0],["لئن طال بي البعد عن لحظكم","فما في حياتي اذن طائل",22,"ل",1,0],["لئن طاب منها الليل فالويل في الضحى","اذا اتقدت رمداؤها في الظهيرة",23,"ر",2,0],["لئن طويت عنك المحاسن في البلا","فلم يطو ذكر في علاك جميل",24,"ل",1,0],["لَئن طالَ السقامُ وَلم تَعدني","وَمتُّ وَما رَأَيتُك يا حَبيبي",25,"ب",2,0],["لِيُنطُسٌ عِدُّ آريسٍ وَفولِفِتٌ","لِصَدِّهِ وَقَفا فيه وَما اِختَلَجا",26,"ج",2,0],["لئن طاب ما بين البرية فرعه","فلا عجب فالفرع من طيب الأصل",27,"ل",1,0],["لَئِنْ طالَ لَيلٌ فَكَم","مَضَت قَبلَهُ مِن لَيَالْ",28,"ل",1,0],["لَئِنْ طَاْلَ الجَّوَى لابُدَ يَوْماً","بَناتُ الدَّهْرِ ترْحَلُ بالحِمَامِ",29,"م",1,0],["لئن طال عني غياب الحبيب","وما تت حقولي وزاد الظمأ",30,"م",2,0],["لئن طاب هذا الشيق نفساً ببعدنا","فإن فؤاد الغور أحفظ للود",31,"د",1,0]]}