{"poems":[[88,"نعاك النعاة وحم القدر","https://www.aldiwan.net/poem10471.html","المتقارب"],[53,"إلهي أجرني من شنيف وزيرك","https://www.aldiwan.net/poem64922.html","الطويل"],[53,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[53,"سمعا أبا إسحق إنك ماجد","https://www.aldiwan.net/poem66524.html","الكامل"],[94,"أزنبقة السفح ما لي أراك","https://www.aldiwan.net/poem38887.html","المتقارب"],[45,"إلام طماعية العاذل","https://www.aldiwan.net/poem9759.html","المتقارب"],[77,"ألا أيها الوادي المقدس بالندى","https://www.aldiwan.net/poem69025.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54837","الكامل"],[92,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[234,"ألا من لنفسي وأوصابها","https://www.aldiwan.net/poem51210.html","المتقارب"],[371,"إذا قطعت بعض القلوب تقطعت","https://www.aldiwan.net/poem16942.html","الطويل"],[371,"أنوما وألحاظ الخطوب سواهر","https://www.aldiwan.net/poem17319.html","الطويل"],[458,"أيا حرقتي لجلالٍ مضى","https://www.aldiwan.net/poem61595.html","المتقارب"],[505,"هب نشر العرار من متكين","https://www.aldiwan.net/poem37763.html","الخفيف"],[794,"","https://poetry.dctabudhabi.ae/diwan/poem/101203","الرمل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63962","الوافر"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123371","المتقارب"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96679","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64411","البسيط"],[1652,"","https://poetry.dctabudhabi.ae/diwan/poem/67369","الطويل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87843","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118417","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199944","المتقارب"],[3042,"","https://poetry.dctabudhabi.ae/diwan/poem/96135","الطويل"],[3228,"","https://poetry.dctabudhabi.ae/diwan/poem/138837",""],[4516,"","https://poetry.dctabudhabi.ae/diwan/poem/66857","الهزج"],[5064,"ما لم تَستطِعْهُ المحابِرُ","https://www.poetsgate.com/ViewPoem.aspx?id=200052",""],[5106,"مِنْ أَيْنَ أَبْدَأُ يَاْ أُمَيُّ خِطَابِيْ ..","https://www.poetsgate.com/ViewPoem.aspx?id=156841",""],[5376,"بها عزةٌ والريمُ فيها حرائرُ","https://www.poetsgate.com/ViewPoem.aspx?id=205197",""],[5582,"أَأَوْجُهُ غِيدٍ زِلْنَ عَنْها البَراقِعُ","https://www.poetsgate.com/ViewPoem.aspx?id=63532",""],[5790,"من مبلغ عني المليك الأروعا","https://www.poetsgate.com/ViewPoem.aspx?id=111886",""],[6089,"يا سائلي","https://www.poetsgate.com/ViewPoem.aspx?id=213767",""],[6102,"نَدَم ..","https://www.poetsgate.com/ViewPoem.aspx?id=185209",""],[6142,"بديع كون تحلى بالوجود طلى","https://www.poetsgate.com/ViewPoem.aspx?id=155673",""]],"verses":[["أَأَوَّلَ يَومٍ لِعَهدِ الرَبيعِ","تَجِفُّ الرِياضُ وَيَذوي الزَهَر",0,"ر",1,0],["أأوعِده بالشعر وهو مُسلّطٌ","على الإنس والجنّان والطير والوحش",1,"ش",1,0],["أأُوحشها وقد نصلتْ نِبالي","وأُونسها وفي نبلي الحِمامُ",2,"م",1,0],["أَأواثِبُ الوزراءَ في ملكُوتِهِمْ","إنِّي إذاً لَإِوَزَّةُ الشاهين",3,"ن",1,0],["أَأَوْقَفَكِ الدَّهرُ حيثُ يُفجِّ","رُ نَوحُ الحَيَاةِ صُدُوعَ الصُّدورْ",4,"ر",1,0],["أَأَوَّلُ دَمعٍ جَرى فَوقَهُ","وَأَوَّلُ حُزنٍ عَلى راحِلِ",5,"ل",1,0],["أأوصي به من علم الناس برها","ولا يتقفى البرَّ منه عقوق",6,"ق",1,0],["أَأُولئِكَ المُرْدُ الأُولَى جَابُوا الصِّبَا","وَالخَطْوُ وَثْبٌ وَالرُّقَادُ غِرَار",7,"ر",1,0],["أأوجعُ مِن أنَّك المُزدرى","وأقتلُ مِن أنَّك المُعدِم",8,"م",1,0],["أأوسَاطُها مثل أطرافها","أَأَرؤُسها مِثلُ أذنابها",9,"ب",3,0],["أَأُونِسُهُ بِشراً فَفي النَفسِ هَيبَةٌ","وَأُلقي لَهُ سَمعاً فَعِندَ الهَوى عَتبُ",10,"ب",1,0],["أَأَومَضَ تَثرٌ لِلتَبَسُّمِ كاشِرٌ","وَسَلِّ لِساناص لِلعَليلِ يُنَضنِضُ",11,"ض",1,0],["أأودت به حرمة ما اتَّقت","فم ترعَ حرمةَ عهدٍ لسعدِ",12,"د",1,0],["أَأُوافي مِتْكينَ والعُمرُ وافٍ","ويَهيجُ الرُّكبانَ صوتُ حَنينِي",13,"ن",2,0],["أأواري مثل هذا","ولخلخالي اشارا",14,"ر",2,0],["أَأُومِضُ للسلوِّ بطرفِ سالٍ","وَفَوْقَ الأرضِ طَرْفٌ ذو وميض",15,"ض",1,0],["أَأَوَّلُ عاشٍ بغى جَذْوَةً","فآنَسَ من جانب الطُّور نارا",16,"ر",2,0],["أأول الليل موصول بآخره","أم النهار محاه الليل فانعدما",17,"م",2,0],["أَأوجهُ غيدٍ زلنَ عنها البراقعُ","تجلّين أَم هاذي بدورٌ طوالعُ",18,"ع",1,1],["أأوجبت علمه آثار قدرته","فيلزم الجهل لو لم يظهر الأثر",19,"ر",1,0],["أأوْصَى أبُوهُم بَيْنَهُمْ أن تَوَاصَلُوا","وَأوْصَى أبُوكُم بَيْنكُمْ أنْ تَدَابَرُوا",20,"ر",3,0],["أَأوسِعُهُ سَبكاً وَصَقلاً وَرِقَّةً","وَيوسِعُني يَأساً وَنَحساً مُجَسَّما",21,"م",2,0],["اأوب الى اوطاننا ام ترحل","لساحل خير ام اقامتنا هنا",22,"ن",2,0],["أأوقظهم من سبات حلا","وأحرمُهم من لذيذ الحلم",23,"م",1,0],["أأوقدت نار الحرب حتى إذا بدا","لنفسك ما تجني الحروب فهالها",24,"ل",3,0],["اأولاك أحبتي ولهم وِدادي","ومَن بهمُ غداً أرجو نجاحي",25,"ح",2,0],["أأوراد وأَذكار","وقلب ذاب إِيمانا",26,"ن",2,0],["أَأُوبُ إِلى صَمْتٍ علَى عتباتهِ","ستصعَدُ للمعنَى القَصيِّ المنَابِرُ",27,"ر",1,0],["أَأُوَدِّعُ الفَجْرَ الكَبِيرَ صَبَاحَهُ","وَيُغَادِرُ البَيتَ الحَرَامَ مَثَابِيْ",28,"ب",2,0],["أأوفى بها شعري وإني لقاصرٌ","وقد زادت الأرجاءَ منها مفاخرُ",29,"ر",1,0],["أَأَوْجُهُ غِيدٍ زِلْنَ عَنْها البَراقِعُ","تَجَلَّيْنَ أَمْ هذِي بُدُورٌ طَوالِعُ",30,"ع",1,1],["أأودكم من عنفوان شبيبتي","وأحولُ إذ عهد الشبيبة ودعا",31,"ع",2,0],["أأوي إلى صدر القصيدةِ إنهُ","نعم الملاذُ يليق بي ويطيبُ",32,"ب",1,0],["أَأُوازِي حَنانَها بِسِواها ؟","وَ هَلِ الذِّكرَياتُ - تَبًّا - عَزاءُ ؟",33,"ا",2,0],["أأوجدت نفسها أم صدفةً وجدت","فالعلم يرفض ذا والعقل والعقلا",34,"ل",2,0]]}