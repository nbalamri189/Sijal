{"poems":[[73,"عاذلي لو رأيت من أنا مغرى","https://www.aldiwan.net/poem3958.html","الخفيف"],[95,"صدقت في عتبكم أو يصدق الشمم","https://www.aldiwan.net/poem11361.html","البسيط"],[56,"عاذلي لو شئت لم تلم","https://www.aldiwan.net/poem27479.html","المديد"],[29,"لولا الحياء لعادني استعبار","https://www.aldiwan.net/poem5740.html","الكامل"],[53,"رب هب لي في أبي الفضل رذاذ","https://www.aldiwan.net/poem61988.html","الرمل"],[53,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[72,"هات يا صاح غنني","https://www.aldiwan.net/poem42432.html","مجزوء الخفيف"],[72,"سلم الله على من","https://www.aldiwan.net/poem42705.html","مجزوء الرمل"],[87,"طال عليها القدم","https://www.aldiwan.net/poem63695.html","مجزوء السريع"],[47,"ما يستفيق دد لقلبك من دد","https://www.aldiwan.net/poem63490.html","البسيط"],[47,"جمعت أمور الدين بعد تزيل","https://www.aldiwan.net/poem65538.html","الكامل"],[51,"عاذلي في المدام غير نصيح","https://www.aldiwan.net/poem64143.html","الخفيف"],[46,"إن بكاء في الدار من أربه","https://www.aldiwan.net/poem30574.html","المنسرح"],[71,"بي عروضي مليح","https://www.aldiwan.net/poem28302.html","مجزوء الرمل"],[71,"لست صخرا في حبي الخنساء","https://www.aldiwan.net/poem28873.html","الخفيف"],[41,"إن تختلف مضر تتبع عدوهم","https://www.aldiwan.net/poem53772.html","البسيط"],[13,"يا عيد ما لك من شوق وإيراق","https://www.aldiwan.net/poem2216.html","البسيط"],[42,"من لنفس عن الهوى لا تناهى","https://www.aldiwan.net/poem42329.html","الخفيف"],[50,"عاذلي في المدام لا أرضيكما","https://www.aldiwan.net/poem64463.html","الخفيف"],[50,"عاذلي فيها أطعني","https://www.aldiwan.net/poem65110.html","مجزوء الرمل"],[50,"عاذلي لوما أطعني","https://www.aldiwan.net/poem66622.html","مجزوء الرمل"],[78,"يا مليحة الدعج","https://www.aldiwan.net/poem39467.html","المقتضب"],[70,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[57,"","https://poetry.dctabudhabi.ae/diwan/poem/12745","السريع"],[111,"ريب المنون مقارض الأعمار","https://www.poetsgate.com/ViewPoem.aspx?id=521",""],[13,"يَا عيدُ مَا لَكَ مِنْ شَوْقٍ وَإيِراقِ","https://www.poetsgate.com/ViewPoem.aspx?id=180808",""],[56,"عاذِلي ! لو شئتَ لمْ تلمِ","https://www.poetsgate.com/ViewPoem.aspx?id=14488",""],[112,"رجالة","https://www.poetsgate.com/ViewPoem.aspx?id=8386",""],[147,"عاذ بالصفح من أَحب البقاء","https://www.aldiwan.net/poem11716.html","الخفيف"],[147,"فت الورى فعلام ذا الإجهاد","https://www.aldiwan.net/poem11754.html","الكامل"],[147,"ما ذي المساعي الغر في قدر الورى","https://www.aldiwan.net/poem11761.html","الكامل"],[147,"ما نرى للثناء عنك عدولا","https://www.aldiwan.net/poem11801.html","الخفيف"],[214,"هل لصب قد غير السقم حاله","https://www.aldiwan.net/poem13303.html","الخفيف"],[214,"لذ لي في حبكم كلفي","https://www.aldiwan.net/poem13357.html","المديد"],[214,"لا وعهد الصبا وعيش هواها","https://www.aldiwan.net/poem13367.html","الخفيف"],[259,"طيف","https://www.aldiwan.net/poem36223.html","مجزوء الرمل"],[287,"سقم جسم أعداه طرف سقيم","https://www.aldiwan.net/poem32441.html","الخفيف"],[295,"حسب قلبي من الحزن","https://www.aldiwan.net/poem11681.html","مجزوء الخفيف"],[409,"هل ينال القلب ما طلبا","https://www.aldiwan.net/poem34147.html","المديد"],[438,"بين اللوى فالجزع فالمتثلم","https://www.aldiwan.net/poem12473.html","الكامل"],[438,"عاذلي عاذري على حب بدر","https://www.aldiwan.net/poem12688.html","الخفيف"],[443,"ليس لي من بعدهم جلد","https://www.aldiwan.net/poem2546.html","المديد"],[443,"راح يخشى في حبه الرقباء","https://www.aldiwan.net/poem2550.html","الخفيف"],[445,"كم أستطيل تضللي وتلددي","https://www.aldiwan.net/poem34890.html","الكامل"],[453,"أترى أرضى أهيل الأجراع","https://www.aldiwan.net/poem53745.html","الرمل"],[463,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[556,"ما الحب إلا موئل المتعلل","https://www.aldiwan.net/poem47295.html","الكامل"],[572,"ضحكت من شيبة ضحكت","https://www.aldiwan.net/poem69551.html","الرمل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48732","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38658","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38767","الرمل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59745","المديد"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119943","البسيط"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72286","الرمل"],[1160,"","https://poetry.dctabudhabi.ae/diwan/poem/146182","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65056","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136297","الخفيف"],[1713,"","https://poetry.dctabudhabi.ae/diwan/poem/123322","البسيط"],[1949,"","https://poetry.dctabudhabi.ae/diwan/poem/105286","الرمل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104795","الرمل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48246","الخفيف"],[2075,"","https://poetry.dctabudhabi.ae/diwan/poem/204513","السريع"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177824","السريع"],[2176,"","https://poetry.dctabudhabi.ae/diwan/poem/69470","البسيط"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121931","الخفيف"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28539","الكامل"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99083","البسيط"],[2875,"","https://poetry.dctabudhabi.ae/diwan/poem/124045","الخفيف"],[2900,"","https://poetry.dctabudhabi.ae/diwan/poem/102163","الرمل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118927","الرمل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118784","المديد"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62940","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110134","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92286","الرمل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117978","الرمل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36785","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85079","الرمل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85235","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114405","الرمل"],[4110,"","https://poetry.dctabudhabi.ae/diwan/poem/101152","الخفيف"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35047","الرمل"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121279","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33654","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33580","الرمل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72786","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139762",""],[4929,"أثناء مرضي","https://www.poetsgate.com/ViewPoem.aspx?id=214197",""],[5136,"حبه بالروح ممتزج","https://www.poetsgate.com/ViewPoem.aspx?id=121535",""],[259,"ما لعيني لم تعني","https://www.poetsgate.com/ViewPoem.aspx?id=214199",""],[5953,"عاذلتي في الشيب لو تعلم ما","https://www.poetsgate.com/ViewPoem.aspx?id=93807",""],[5988,"عاذلي بت نائما","https://www.poetsgate.com/ViewPoem.aspx?id=99722",""],[3792,"دار من تهواه دار","http://www.aldiwanalarabi.com/poemDescription.do?poemId=613109",""],[6302,"النَّايُ الْ.. حَكَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86225&r=&rc=23",""],[572,"ضَحِكَتْ من مشيبة ٍ ضَحِكَتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9423&r=&rc=280",""]],"verses":[["عاذِلي لَو رَأَيتَ مَن أَنا مُغرى","بِهَواهُ بَدَّلتَ عَذلَكَ عُذرا",0,"ر",2,1],["عَاذَتْ بِآبَائِهَا المَاضِينَ دَوْلَتُنا","مِنْ أَنْ يُلِمَّ بِهَا فِي عَهْدِنَا يَتَمُ",1,"م",1,0],["عاذِلي لَو شِئتَ لَم تَلُمِ","فَبِسَمعي عَنكَ كَالصَمَمِ",2,"م",1,1],["عاذَت بِرَبِّكَ أَن يَكونَ قَرينُها","قَيناً أَحَمَّ لِفَسوِهِ إِعصارُ",3,"ر",1,0],["عاذ أهل الظرف منه بفتىً","مُثْقَب الزند ولاذوا بملاذِ",4,"ذ",1,0],["عاذِلي قد نزعتُ فانزع عن العَذْ","لِ وإن كنتَ في صواب حَذَام",5,"م",1,0],["عاذِلي فيهِ لا تُطِل","أَنا عَن عاذِلي غَني",6,"ن",2,0],["عاذِلي إِنَّ حَبيبي","حَسَنٌ فيهِ الغَرامُ",7,"م",1,0],["عاذِلَتي في الطِلى","لَو أَنصَفَت لَم أُلَم",8,"م",1,0],["عاذَت بَنو شَيبانَ مِنهُ بِطورِها","وَالطورُ مَنزِلَةُ القَصِيِّ الأَبعَدِ",9,"د",1,0],["عاذَت بِحَقوَيكَ الخِلافَةُ إِنَّها","قِسمٌ لِأَفضَلِ هاشِمٍ فَالأَفضَلِ",10,"ل",1,0],["عاذِلي في المُدامِ غَيرَ نَصيحَ","لا تَلُمني عَلى شَقيقَةِ روحي",11,"ح",2,1],["عاذَت صُدوعُ الفَلا بِهِ وَلَقَد","صَحَّ أَديمُ الفَضاءِ مِن جُلَبِه",12,"ب",2,0],["عاذلايَ في هواهُ","فاعلاتٌ فاعلاتِ",13,"ت",1,0],["عاذلي غيرُ عادلٍ في هواها","وإذا أحسنَ العذولُ أساءَ",14,"ا",2,0],["عاذَت تَميمٌ بِأَخفى الحُمسِ إِذ لَقيتُ","إِحدى القَناطِرِ لا يُمشى لَها الخَمَرُ",15,"ر",1,0],["عاذِلَتي إِنَّ بَعضَ اللَومِ مَعنَفَةٌ","وَهَل مَتاعٌ وَإٍ أَبقَيتُهُ باقِ",16,"ق",1,0],["عاذِلٌ في الهَوى بِنُصحٍ وَيَخشى","أَن يَسُوقُ الرَدى إِلَيها هَواها",17,"ا",3,0],["عاذِلي في المُدامِ لا أُرضيكُما","إِنَّ جَهلاً مُلامُ مَن يَعصيكا",18,"ك",2,1],["عاذِلي فيها أَطِعني","وَأَقِلَّ الآنَ لَومي",19,"م",2,1],["عاذلي لوماً أطِعني","وأقِلَّ الآن لومي",20,"م",2,1],["عاذِليَّ حَسْبُكُما","قَدْ غَرِقْتُ في لُجَجِ",21,"ج",1,0],["عاذِلي عن صَبْوَةٍ عُذْرِيّّةٍ","هيَ بي لا فَتِئَتْ هَيَّ بنُ بَي",22,"ي",1,0],["عَاذِرَةٌ لِلنَّاسُ وَالنَّاسُ قدْ","تَتَّهِمُ الْحُسْنَى وَلاَ تَعْذِرُ",23,"ر",1,0],["عاذِلَتي في حُبِّها أَقصِري","هَذا وَهَذا عَنكِ مَوضوعُ",24,"ع",1,0],["عاذت به فأعاذها واقامها","عمرية الميزان والمعيار",25,"ر",1,0],["عَاذِلَتِي إنَّ بَعْضَ اللَّوْمِ مَعْنَفةٌ","وَهَلْ مَتَاعٌ وَإنْ أَبْقَيْتُهُ بَاقِ",26,"ق",1,0],["عاذِلي ! لو شئتَ لمْ تلمِ","إِنَّ سَمْعي عَنْكَ في صَمَمِ",27,"م",1,1],["عاذرك ياقلب من كبر الخطا والهاله","أسجد أبعوج المحاني وأدع ربّك وأرجه",28,"ج",2,1],["عاذَ بِالصَفحِ مَن أَحَبَّ البَقاءَ","وَاِحتَمى جاعِلُ الخُضوعِ وِقاءَ",29,"ا",2,1],["عاذَت بِحَضرَتِكَ المُلوكُ وَلاذَتِ ال","فُقَراءِ فَاِجتَمَعَت بِها الأَضدادُ",30,"د",1,0],["عاذوا بِمُلكِكَ خاضِعينَ لِيَأمَنوا","صَرفَ الرَدى وَاِستَغفَروكَ لِتَغفِرا",31,"ر",2,0],["عاذِلاً في النَدى وَلَم يُرَ قَبلي","شاعِرٌ صارَ في السَماحِ عَذولا",32,"ل",2,0],["عاذل الصب خل عنك ودمعي","فعلى الخد قد كفى ما جرى له",33,"ل",2,0],["عاذلي مت حسرة واسى","لم تنل مني سوى الاسف",34,"ف",1,0],["عاذلاها تحدثا بي لما","علماني ان لا اخون هواها",35,"ا",3,0],["عاذلي لا ذنب لي في","ماجرى، حظي ألومُ",36,"م",1,0],["عاذِلي خَلِّني فَعَذلُكَ في الحُب","بِ سَفاهٌ عِندي وَلومُكَ لُومُ",37,"م",1,0],["عاذلي تلك أدمعي","تغسل الذنب والنقم",38,"م",1,0],["عاذلي خل الملام ولا","تكثر التنفيذ والعذلا",39,"ل",2,0],["عاذَتْ بها من خيبةٍ لمرامها","إذ قبّلَتْها فِعلةَ المتذمّمِ",40,"م",1,0],["عاذلي عاذري على حبِّ بدرٍ","باتَ حالي فيه على الرسم حالِكْ",41,"ك",1,1],["عاذلي في من أحبّ أفق","لا تردني فوق ما أجد",42,"د",1,0],["عاذل غادر الفؤاد عليلا","بملام أجرى الدموع دماء",43,"ا",2,0],["عاذُوا بلَمْعِ الآلِ فِي مَدِّ الضُّحى","مِنْ بَعدِ ظِلٍّ فِي القُصورِ مُمَدَّدِ",44,"د",1,0],["عاذلي عذلك من يسمعه","ولئن كنت سميعا من يعى",45,"ع",2,0],["عاذوا بعفوِ ماجدٍ معوّدٍ","للصبر حمّالٍ لهم على العللْ",46,"ل",1,0],["عاذوا بمنخرقِ اليمين مضاؤه","يكفي العُفاة ذريعةَ المتوسّلِ",47,"ل",1,0],["عَاذِلِي دَعْ عَنْكَ عَذْلَ فَتًى","لَجَّ فِي عِصْيَانِ مَنْ عَذَلَهْ",48,"ل",2,0],["عاذت بأمنك من عناء نازل","بمحامد ومسالم ومعاد",49,"د",1,0],["عاذِلي لَمّا رَآني عاشِقاً","بِنتي الحُسن وَكلّاً صنتُها",50,"ه",2,1],["عاذِلي إِنْ لُمتَني لَم أَفُتهم","أَيُّ فَهمٍ لِمُعنّىً لَيسَ يَصحو",51,"ح",2,0],["عاذلي دعني أُمت أسفاً","وأطيل الشجو والأرقَا",52,"ق",2,0],["عاذا إلى الله بل عادا وقولهما","ابعث إليه سوانا من يسائله",53,"ل",2,0],["عاذلي عذلك سهم في الحشا","كيف كتماني وسري قد فشى",54,"ش",2,1],["عاذلي اعذرا فإنّ عذاري","عانق الشيب حين طرّ عذاره",55,"ر",2,0],["عاذلِ المُسْتَطيلِ ويْ","حَكَ ماذا صَنَعْتَ بالْ",56,"ل",1,0],["عاذلي في الهوى يروم سلوى","ومحال اني اصدق قيله",57,"ل",2,0],["عاذوا بظل كريم العفو ذي لطفٍ","مبارك الوجه بالتوفيق مشتمل",58,"ل",1,0],["عاذلي دعني فما رأ","يك عندي بمصيب",59,"ب",1,0],["عاذلِى فِى حُبِّهِ خَفِّف وَفِق","كانَ لِآ فِى الحُبِّ ما قَد كانَ لَى",60,"ا",1,0],["عاذلي لا تَسَلْ عن الجارحِ الدا","مي فجرْحي من طرفهِ الجرَّازِ",61,"ز",1,0],["عاذلتي في جذعي أقصري","قد علق الرهن بما فيه",62,"ي",2,0],["عاذت بذياك الحمى وفسحت","لا تأتلي في رسمه ترددا",63,"د",2,0],["عاذت به وإن من عاذ به","مسترشدا فقد تحرى رشدا",63,"د",2,0],["عاذوا بِسَبعَةِ حيطانٍ فَسَوَّرَها",