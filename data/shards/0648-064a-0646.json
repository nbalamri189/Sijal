d=183582",""],[103,"وحى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=64546",""],[43,"كفى بك داء أن ترى الموت شافيا","https://www.poetsgate.com/ViewPoem.aspx?id=439",""],[67,"اسمعتم ان الاله لحاجة","https://www.poetsgate.com/ViewPoem.aspx?id=12949",""],[67,"شَهِدَتْ لهُ الرُّسْلُ الكِرامُ وَأشْفَقَوا","https://www.poetsgate.com/ViewPoem.aspx?id=14569",""],[90,"الحزبان المتآخيان","https://www.poetsgate.com/ViewPoem.aspx?id=179105",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[57,"إذا المرء لا يرعاك إلا تكلفاً","https://www.poetsgate.com/ViewPoem.aspx?id=3408",""],[91,"مستشفى تل شيحا","https://www.poetsgate.com/ViewPoem.aspx?id=53339",""],[51,"لازلْتَ تفخمُ والثناءُ ضئيلُ","https://www.poetsgate.com/ViewPoem.aspx?id=30333",""],[51,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[51,"وأما بلاءُ البحر عندي فإنه","https://www.poetsgate.com/ViewPoem.aspx?id=25877",""],[51,"أجنتْ لك الوجدَ أغصانٌ وكثبانُ","https://www.poetsgate.com/ViewPoem.aspx?id=25836",""],[100,"لا اكتراث","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67636&r=&rc=124",""],[91,"السجينة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=374&r=&rc=2",""]],"verses":[["وَيَنالُ بُغيَتَهُ وَما","أَنضى الذَميلَ وَلا الرَسيما",0,"م",2,0],["وَيَنصُلُ لَيلُها عَن كُلِّ عَنسٍ","غَضيضِ الطَرفِ فاتِرَةِ البُغامِ",1,"م",1,0],["وَيَنطِقُ بِالأَسرارِ حَتّى تَظُنُّهُ","حَواها وَصِفرٌ مِن ضَميرٍ أَضالِعُه",2,"ع",2,0],["وَينكُصُ رُمحُهُم في الطَعنِ حَتّى","كَأَنَّ كُعوبَهُ عَنّي قِصارُ",3,"ر",1,0],["وَيَنثُرُ طَعنَهُ شَزراً","إِذا اِنتَظَمَت مَفاخِرُه",4,"ر",2,0],["وَيَنهَضُ مُشتاقاً إِلى مَصرَخِ القَنا","فَيَحسَبُ بُردي فاسِقِ السَيفِ طاهِرِ",5,"ر",1,0],["وَيُنبِطُ مِحفاري بِأَرضِكُمُ الغِنى","إِذا ما نَبا عَن جانِبِ اللُؤمِ أَو أَكدى",6,"د",2,0],["وَيَنسَونَ مَن لَو قَدَّموهُ لَقَدَّموا","عِذارَ جَوادٍ في الجِيادِ مُقَلَّدِ",7,"د",1,0],["وَيُنسيهِ بَدءَ العَيشِ ما في عَقيبِهِ","وَجيئَتُهُ تُبدي لَنا عَن ذُهوبِهِ",8,"ب",2,0],["وَيَنمَى هَواها ثُمَّ يَزدادُ جِدَّةً","وَكُلُّ هَوىً يا سَعدُ يَبلى وَيَنقُصُ",9,"ص",1,0],["وَيُنْجِدُ بِي طَوْراً وَطَوْراً يَغُورُ بي","كَأَنِّي على ما في البِلادِ رَقِيبُ",10,"ب",1,0],["ويَنْتَضي الحِلْمُ منهُ عَفْوَ مُقْتَدِرٍ","عنْ كلِّ مُعْتَرِفٍ بالذّنْبِ مُقْتَرِفِ",11,"ف",1,0],["ويَنْتَضي كأبيهِ في مَقاصِدِهِ","عَزْماً يُفَلُّ بهِ الصّمْصامَةُ الخَذِمُ",12,"م",1,0],["ويَنْزِفُها رَبْعٌ تُرَوّي طُلولَهُ","بوَجْرَةَ عَيْنٌ في الدّيارِ أُجيلُها",13,"ل",3,0],["ويَنْسِبُهُ آلُ المُسَيّبِ في الذُّرا","إِلى كُلِّ مَشْبوحِ الذِّراعَيْنِ أبْلَجِ",14,"ج",1,0],["ويَنْحَلُ منْ نَحْلٍ وأفعَى مَشابِهاً","فيُحْيي ويُرْدي أرْيُهُ وسِمامُهُ",15,"م",2,0],["ويَنْمي ضِياءُ الدينِ منْ كُبَرائِهِمْ","إِلى خَيْرِ بادٍ في مَعَدٍّ وحاضِرِ",16,"ر",1,0],["ويَنظِمُ شَمْلَ المَجْدِ ما بَيْنَ مِنحَةٍ","عَوانٍ وتَصْميمٍ على فَتْكَةٍ بِكْرِ",17,"ر",1,0],["ويَنثَني مِشْيَةَ النّشوانِ مِن تَرَفٍ","كأنّما قَدُّهُ منْ طَرفِهِ ثَمِلُ",18,"ل",1,0],["ويَنْسِبُها شِعري بأكْنافِ بابِلٍ","كما انْتَسَبَتْ وَهْناً لِصَحْبي قَطاتُها",19,"ت",3,0],["ويَنحَرونَ مَكانَ القَعْبِ مِنْ لَبَنٍ","للطّارِقِ المُعْترِي وَجْناءَ مِقْحادا",20,"د",2,0],["وينأى ، فترنوا الكوى","يفتّشن عنه معي",21,"ع",2,0],["وَيُنكِرُ عَيشاً قَد تَقادَمَ عَهدُهُ","وَيُظهِرُ سِرّاً كانَ بِالأَمسِ قَد خَفا",22,"ف",2,0],["ويُنْشِدُ مَنْ يأتي لبابِكَ وافِداً","تلافَيْتَ نصْرَ الدّينِ إذْ كادَ يَتْلَفُ",23,"ف",1,0],["وَيَنْفِرُ عَنْ عَيْنِي الْمَنَامُ كَأَنَّمَا","قَطاً صَدَّهُ عَنْ وِرْدِ مَشْرِعِهِ سَهْم",24,"م",1,0],["وَيَنظُرُ لي رَبُّ الأَريكَةِ نَظرَةً","بِها يَنجَلي لَيلُ الأَسى وَيُنيرُ",25,"ر",1,0],["وَيَنتَضي كُلَّ سَيفٍ للفَناء وَلَو","كانَ ابنَ ذي يَزَن وَالغِمد غمدانُ",26,"ن",1,0],["ويَنْهَضُ للعُلْيا إذا الحَرْبُ شمّرَتْ","فيطفئها قهراً وانْ شاءَ اضرما",27,"م",2,0],["وينبغي أن يحضر الوليمة","عزيز نصرٍ لين الشكيمة",28,"ه",1,0],["وَيُنْمِ الأَمِيرَةَ فريالَ فِي","ذَرَا أَهْلِهَا أَشْرَفِ المُنْجِبِينْ",29,"ن",1,0],["وَيُنَزِّهُ الأَخْلاقَ مِنْ شُبَهٍ بِهَا","وَيُطَهِّرُ الآدَابَ مِنْ أَدْرَانِ",30,"ن",1,0],["وَيَنْسَى الغَرَانِيقُ زَيْنُ الشَّبَابِ","وَشَيْخَ الشَّبَابِ المُهِيبَ الرَّحِيمَا",31,"م",2,0],["ويُنخَس أحياناً فتعلوه رجفةٌ","فيمضي على رغم القُيود مهرولا",32,"ل",2,0],["وينوب عن أبناّئه","إن صادقوه على منابه",33,"ب",2,0],["وينشر فيه الصمت لِبداً مضاعفاً","فتَطويه منّي رنّة وعويل",34,"ل",1,0],["وينطقَ بالمجد المؤثل سعيكم","فيسكتَ عنكم لائم وعذول",34,"ل",1,0],["ويَنقضُّ أحياناً عليها فتارةً","يروح وفي بعض الأحايين يغتدى",35,"د",2,0],["وينصُبْن القدور مشمِّرات","يُخالسن العَجاهنة الرِئينا",36,"ن",2,0],["وَيَنفَذُ في راضٍ مُقِرٍ بِحُكمِهِ","وفي سَاخِطٍ مِنّا الكِتَابُ المُعَطَّلُ",37,"ل",1,0],["وَيَنفُذُ أَمرُنا في كُلِّ حَيٍّ","فَيُدنيهِ وَيُقصيهِ الكَلامُ",38,"م",1,0],["وَيَنمي رَواحَةَ آبائَهُ","إِلى كُلِّ ذي غُرَّةٍ أَبلَجِ",39,"ج",1,0],["وينزلُ اللثمُ خدَّيه فينشدها","هي المنازلُ لي فيها علامات",40,"ت",1,0],["وينكرني ليلي وما خلت أنه","إذا وضعَ المرءُ العمامةَ ينكر",41,"ر",1,0],["وينضب طام من بحيرة ساوة","ولم لا وقد فاضت بكفيه أبحر",41,"ر",1,0],["وينفذ الأمر كالسهم القويم فما","تحيد عن غرض التقوى أوامره",42,"ر",2,0],["وينتهي لضحى بشر مؤمله","إذا انتهى من بني الدنيا إلى عبس",43,"س",1,0],["وينشر العلم لا قول بمختلف","إذا رواه ولا معنى بملتبس",43,"س",1,0],["ويندى وقد أندى الحياء جبينه","فلم ندرِ من فينا طلوب نوال",44,"ل",1,0],["وينقضُ ألواحَ السفينِ فكُلُّها","مُنَجٍّ لدى نَوْبٍ من الكَسْر نائبِ",45,"ب",1,0],["ويَنْبُوتِ أرضٍ ترى شوكَهُ","يُطيلُ حماية خَرُّوبِهِ",46,"ب",2,0],["وينوبُ السَّماحُ عنه إذا غا","بَ فَيُغني في نائباتٍ تنوبُ",47,"ب",1,0],["ويَنْتَحِي في عِرْسِهِ","بِعُدَّةٍ من عُددِهْ",48,"د",2,0],["وينْدُر في الأحيان جِدَّ مُحَرَّرٍ","ويندر في الأحيان جِدُّ مُبَرَّدِ",49,"د",1,0],["وينالُ أجْرةَ نَيْكِهِمْ","من بعد ذلك كالمساعدْ",50,"د",1,0],["وينصرف العافُون تُثْني عيابُهُم","عليك ولم ينبسْ من القوم نابس",51,"س",1,0],["وينصرني عليك الناسُ نصراً","يطولُ به على الطاغي دلالي",52,"ي",1,0],["وينامُ عنا حينَ نلوي شُكرَهْ","فِعْلَ الكريمِ فشكرهُ تأجيلُ",53,"ل",1,0],["وينكص في الهيجاء إلا مباهياً","وإن كان للْحامي هنالك مَقدَمُ",54,"م",1,0],["ويُنطِقْن أهل الصمتِ في كل مَحْفلٍ","مهيبٍ كمِثلِ المأزقِ المتلاحِمِ",55,"م",1,0],["وينطقُ المنطقَ المفتونَ سامعُهُ","والمنطق الحسنُ المسموعُ فتَّان",56,"ن",1,0],["وَيَنفُضُ عَن أَعطافِها النورَ لُؤلُؤاً","مِنَ الطَلِّ ما ضُمَّت عَلَيهِ جُيوبُ",57,"ب",1,0],["وَيَنامُ لِيَحلَمَ بِالفَجرِ","وَالفَجرُ يُضيءُ لَهُ الدَربا",58,"ب",2,0],["وَيَنفُخُ في الجَمادِ قِوىً وَحِسّاً","فَيَركُضُ تارَةً وَيَطيرُ حينا",59,"ن",2,0],["وَيُنهي إِلى العِلمِ الشَريفِ بِأَنَّهُ","عَلى قَدَمِ الإِخلاصِ في السِرِّ وَالجَهرِ",60,"ر",1,0],["وينبثقُ اللَّيْلُ طيفاً كئيباً","رهيباً ويخفقُ حُزْنُ الدُّهُورْ",61,"ر",1,0],["ويَنُحْنَ حتَّى يُفْعِمُ","الآفاقَ صَوتُ الانْتِحابْ",62,"ب",1,0],["ويَنْضُبَ الدَّمع من لو","عَتي ومِنْ حَسَراتي",63,"ي",1,0],["ويُنْصِتونَ لصَوْتِ الأَشواكِ","وهْوَ مُريعُ",63,"ع",1,0],["ويُنضِّدون من الرُّبى","بَيْنَ التَّضاحُكِ والحُبورْ",64,"ر",1,0],["ويَنْتابُها في الصَّباحِ السَّديمُ وفي","اللَّيلِ حُلمٌ مُريعٌ مُخيفْ",65,"ف",1,0],["وينهدُّ ذاك القوامُ الرَّشيقُ","وينحلُّ صَدْرٌ بديعٌ وَجيدْ",66,"د",1,0],["وينجابُ سِحْرُ الغرامِ القويِّ","وسُكرُ الشَّبابِ الغريرِ السَّعيدْ",66,"د",1,0],["ويَنْثُرَها في الفراغِ المُخيفِ","كما تنثرُ الوردَ ريحٌ شَرودْ",66,"د",1,0],["وينتظرون الفجر في ليل قبرهم","ولكن ليالي القبر ليس لها فجر",67,"ر",1,0],["وينأى عن الروضِ الأنيق اخضراره","ويكتنف الأزهارَ فيه ذبول",68,"ل",1,0],["وينزلها الرفوف كجوهري","يصفف في خزائنها الحليا",69,"ي",2,0],["وينذرنا بويل بعد ويل","على ويل كما نعق أبن دايه",70,"ا",3,0],["وَيَنعَمُ فيهِ جيرانٌ كِرامُ","فَلَن تَجِدَ النَزيلَ بِنا شَقِيّا",71,"ي",2,0],["وَيَنبوعٌ مِنَ الإِنشادِ صافِ","صَدى المُتَأَدِّبينَ بِهِ يُقَلُّ",72,"ل",1,0],["وَيَنتَحِبُ الطَيرُ في ظِلِّها","وَيَخلَعُ فيها النَسيمُ الرَسَن",73,"ن",1,0],["وَيَندُبُ فَلّاحونَ أَنتَ مَنارُهُم","وَأَنتَ سِراجٌ غَيَّبوهُ مُنيرُ",74,"ر",1,0],["وَيُناجي النَجمَ وَيُتعِبُهُ","وَيُقيمُ اللَيلَ وَيُقعِدُهُ",75,"د",2,0],["وَيَنظُرونَ لِجَنبٍ لا هُدوءَ لَهُ","عَلى الفِراشِ وَلا يَدرونَ ما دائي",76,"ي",1,0],["وَيُنفِذُها مِن كُلِّ شِعبٍ فَتَلتَقي","كَما يَتَلاقى العارِضُ المُتَشَعِّبُ",77,"ب",1,0],["وَيُنيلُ الوَرى الحُقوقَ فَإِن نا","دَتهُ مِصرٌ فَأُذنُهُ صَمّاءُ",78,"ا",2,0],["وَيُنفِذُهُ في العَقدِ وَهوَ مُضَيَّقٌ","مِنَ الشَعرَةِ السَوداءِ وَاللَيلُ مُسوَدُّ",79,"د",1,0],["وَيُنذِرُ الرَكبَ بِكُلِّ سارِقٍ","يُريكَ خُرقاً وَهوَ عَينُ الحاذِقِ",80,"ق",1,0],["وينشر الأمواتَ دَبَّ البلى","فيها فصارت رِمَماً دُثَّرا",81,"ر",2,0],["وَيُناكُ أَيضاً وَالبَلِيَّةُ أَن يُرى","لَكَ صاحِبٌ مِن أَهلِ تِلكَ الجيزَه",82,"ز",2,0],["وَيَنقُلُ بَينَكُمُ جَعسَةً","إِذا كَظَّهُ القَدَحُ المُترَعُ",83,"ع",1,0],["وينسابً قًدَّامهَا جَدوَلٌ","كما ذُعِرَ الأَيْمُ أو نُفِّرا",84,"ر",2,0],["وينشرُ صيَّادُنا حولَنا","لُباباً من الصيدِ يُرضي اللَّبيبا",85,"ب",2,0],["وَيَنصرُ اللَهُ مَن لاقاهُ إِنَّ لَهُ","نَصراً يُمَثِّلُ بِالكُفّارِ ما عَنَدوا",86,"د",3,1],["وَيَنصُرُ اللَهُ مَن والاهُ إِنَّ لَهُ","نَصراً وَيَمثُلُ بِالكُفّارِ إِذ عَنَدوا",87,"د",3,0],["وَيَنصُرِ اللَهُ مَن والاهُ إِنَّ لَهُ","نَصراً يُمَثِّلُ بِالكُفّارِ إِن عَتَدوا",88,"د",3,0],["وَيَنسى القُرونَ وَرَيبَ المَنونِ","وَيَنسى الخُطوبَ وَيَنسى الغِيَر",89,"ر",1,0],["وَيَنسى شُهوراً تُحيلُ الأُمورَ","فَإِمّا بِخَيرٍ وَإِمّا بِشَرِّ",89,"ر",1,0],["وَيَنبُتُ عِندي نَخيلُ الوِدادِ","لِأَنَّكَ عِندي دَفَنتَ النَوى",90,"و",2,0],["وَيَنثُرُ لي حَبَّ الوَفاءِ تَمَلَّقاً","وَيَنصُبُ لي مِن تَحتِهِ شَرَكَ الغَدرِ",91,"ر",1,0],["وينشرُ في الأطلالِ ظِلا كأنَّه","خيالُ الأماني في محاجرِ نُوَّمِ",92,"م",1,0],["وينوءُ بالعبءِ الذي","هو عن أذاه في غَناء",93,"ا",2,0],["وينادينَ بالتّفجّعِ أمّاً","يا فداءً لها إجابةُ غتمِ",94,"م",1,0],["وينبو عنِ اللومِ المُعنِّفِ مَسمَعي","بِمَنْ حُسْنُها بَينَ الحِسانِ له سمعُ",95,"ع",1,0],["وينبضُ كالشريان إن عبثتْ به","وَجَسّتْهُ منها باللطافة إصبَعُ",96,"ع",1,0],["ويَنَالُ ما صَدَعَ الهواءَ بخافقٍ","موتٌ ومن قَطَع الفَلا بِسُهادِ",97,"د",1,0],["ويُنجدني على الحدثان عضْبٌ","يُذلل قرعه النوَبَ الصعابا",98,"ب",2,0],["وَيَنْصُرُنِي فِي كُلِّ جَمْعٍ ثَلاثَةٌ","لِسَانٌ وَبُرْهَانٌ وَرَأْيٌ مُحَكَّمُ",99,"م",1,0],["وَيَنْثُرُ لَفْظَهُ دُرّاً","عَلَى سَمْعِي فَأَنْظِمُهُ",100,"م",2,0],["وَيَنمى لَها حُبُّها عِندَنا","فَمَن قالَ مِن كاشِحٍ لَم يَضِر",101,"ر",1,0],["وَيَنحَرُ دوني جِنحَ دُجُنَّةٍ","سِنانٌ صَقيلٌ لِلذُبالَةِ أَزرَقُ",102,"ق",1,0],["وَيَنطِقُ عَن سَيفٍ بِفَكَّيهِ صارِمٌ","وَيَرمُقُ عَن سَهمٍ بِجَفنَيهِ يَمرُقُ",103,"ق",1,0],["وَيَنظُرُ إِلى جَنبِهِ","كَما نَظَرَ الظَبيُ مِن ظِلِّهِ",104,"ل",2,0],["وَيَنتزِعُ الغوايَةَ مِن نُفُوسٍ","ألحَّ ضَلالُها وطَغَى هَواها",105,"ا",3,0],["ويَنتزعُ الحكومةَ من ذويها","بَررتَ أبا دُجانة إذ تُريها",106,"ه",2,0],["وَيَنظُرُ حَولَهُ فَيَرى بَنيهِ","حِواءً مِن وَرائِهِمِ حِواءُ",107,"ا",2,0],["وَيُناجي بَناتِ نَعشٍ بِذِكرا","كِ إِذا اللَيلُ أَلبَسَ الأَرضَ قارا",108,"ر",2,0],["وَيَنقَضُّ بِالأَرواحِ روحُ مُدامَةٍ","يَكونُ بِأَفواهِ النَدامى مَعارِجُه",109,"ج",2,0],["ويَنَامُ مِنْ تَعَبٍ وَيَدْعُو رَبَّهُ","ويَرُومُ مِنْ حَرِّ الهَجِيرِ مَقِيلا",110,"ل",2,0],["وينوبُ عن شربِ الزلالِ شرابها","كَرَماً فخيرُ الناسِ إبراهيمُ",111,"م",1,0],["وينصب للهيجاء سمعا كأنه","سنان عتيد للطعان ذليق",112,"ق",1,0],["وينظر من عيني رؤوم على طلا","تراعيه بالوعساء فهوَ يروق",112,"ق",1,0],["وَيَنساقُ لِلجَدوى وَإِن كانَ مُمسِكاً","وَيُظهِرُ إِكثاراً وَإِن كانَ ذا عُدمِ",113,"م",1,0],["وَيُنبِتُ حَوذاناً وَعَوفاً مُنَوِّراً","سَأُتبِعُهُ مِن خَيرِ ما قالَ قائِلُ",114,"ل",1,0],["وَيُنَهِنِهُ الرَجُلُ الحَصيفُ بِسِنِّهِ","أَوطارَهُ فَتَضيقُ مُتَّسِعاتُها",115,"ت",3,0],["وَيَنفُضُ إِلفُها الراحاتِ حَتّى","تَعودَ مِنَ النَفائِسِ مُعدَماتِ",116,"ت",1,0],["وَيُنسي أَخا الأَشواقِ رَملَةَ عالِجٍ","وَيَبرينَ مِن هَولِ الرَدى ما يُعالِجُ",117,"ج",1,0],["وَيَنالُ طالِبُ حاجَةٍ بِفَلاتِهِ","ما لا تَجودُ بِمِثلِهِ الأَمصارُ",118,"ر",1,0],["وَيَنفُرُ عَقلي مُغضَباً إِن تَرَكتُهُ","سُدىً وَاِتَّبَعتُ الشافِعيّ وَمالِكا",119,"ك",2,0],["وَيَنالُهُ نَصَبٌ يُطيلُ عَناءَهُ","فَلَهُ كَساري المُدلِجينَ مَنازِلُ",120,"ل",1,0],["وَيَنصِبونَ لِوَحشِيِّ حَبائِلَهُم","أَو بِالسِهامِ عَلى عَمدٍ يَشُكّونَه",121,"ن",2,0],["وَيَنفُثُ في فَمِ الحَيّاتِ سُمّاً","وَيَملَأُ ذِلَّةً أَنفَ المِصِنِّ",122,"ن",1,0],["وَيَنشَأُ ناشِئُ الفِتيانِ مِنّا","عَلى ما كانَ عَوَّدَهُ أَبوهُ",123,"ب",3,0],["ويَنْفُرْنَ في الظّلْماءِ عن كلّ جدوَلٍ","نِفَارَ جَبَانٍ عن حُسامٍ مُجَرَّدِ",124,"د",1,0],["وَينكر الحق على أَهله","حتى إِذا ما كانَ ملموسا",125,"س",2,0],["وينقطع التجدُّد حين يودي","فلا يخضرُّ بعد اليبس عود",126,"د",1,0],["وينخَرُ الجرثومُ في عظمهِ","ومنهُ يُنْمي القبرُ ديدانُه",127,"ه",1,0],["وينشقُّ عن نَضرةٍ قلبُه","وإنْ طَمَرَتهُ ثلوجُ الشتاء",128,"ا",2,0],["ويُنبِئك أنَّا لا نطيق على الأذى","مُقَاماً وأنَّا أمةٌ ليس تُظلمُ",129,"م",1,0],["ويُنيلُ ضوءَ النجم عاليَ جبهةٍ","من وسْمِ إفريقية السمراءِ",130,"ا",2,0],["وَيَنشُرُ سِرّاً في الصَديقِ وَغَيرِهِ","يَعِزُّ عَلَينا نَشرُهُ حينَ يُنشَرُ",131,"ر",1,0],["وَيَندُبُ مِن فَرطِ الجَوى فَأَجَبتُهُ","بِحَسرَةِ قَلبٍ دائِمِ الخَفَقانِ",132,"ن",1,0],["وَيُنْشِيءُ أَرْبَابُ الْبَيَانِ تَجِلَّةً","لِقَدْرِكَ آيَاتٍ مِنَ النَّظْمِ وَالنَّثْرِ",133,"ر",1,0],["وَيَنْثَنِي حَائِراً جَزُوعاً","يَمْضِي وَيَأْتِي بِلاَ اخْتِيَارْ",134,"ر",1,0],["وَيَنْشُد غَايَاتِ الكَمَالِ مُثَابِراً","عَلَى مَا تُمِر الحَادِثَاتُ وَمَا تُحلِي",135,"ل",2,0],["وَيُنَشِّئْ فِي الشَّعْبِ جِيلاً جَدِيداً","بِالْمَرَاقِي فِي كُلِّ مَعْنىً جَدِيرَا",136,"ر",2,0],["وَيَنْصُرُهُ من كُلّ أمرٍ يَريبُهُ","يَجُودُ بِنَفْسٍ دُونَ نَفْسِ محمَّدِ",137,"د",1,0],["وينثر الروض سكرانا براعمهُ","كألسن الطير شقت نصف منقاد",138,"د",1,0],["وينشُرُ الوشي لم تنبِتهُ قِمّتُها","ويفجُرُ النهرَ لم ينبَعهُواديها",139,"ي",3,0],["وَيَنظِمُ الشِعرَ مِثلَ نَظمي","فَيَنتَهي غايَتي وَشاوي",140,"ي",1,0],["ويَنطق بالصوابِ ويصطفيه","إذا ما قال أهلُ الجور جورَا",141,"ر",2,0],["ويناجِي شعره نائح الطَلْ","حِ فيُبكيه مثلَما أبكاني",142,"ي",1,0],["ويَنْسَبُ حتى يَلينَ الهَوَى","وتَقْضي الصّبَابةُ أوْطارها",143,"ر",3,0],["وينالُ بالإسفاف منه غريمُهُ","وبغير ذاكَ ينالُ من غُرمائه",144,"ا",3,0],["وينقُذُ الشعرَ مثل الزَّهر مُتِّسِقًا","فإن يَصُغهُ، أَتَت أبياتُهُ حطبا",145,"ب",2,0],["ويَنطبَع الوليدُ على هوانٍ","إذا ما هان أستاذُ الوليد",146,"د",1,0],["وينفذ مثلَ النَّصل فيما يُريده","وإن كان غُصنًا في الوداعةِ أملَدا",147,"د",2,0],["وينير أشجان الهوى","والشوقِ في القلب العميد",148,"د",1,0],["وينادي: يا ذاك.. يصغي لهذا","وهو ذاك الذي ينادي، وهذا",149,"ذ",2,0],["وينظر الصادق الأحجار آلهة","والقوم فى مركب الخسران قد ركبوا",150,"ب",3,0],["وَينظُرْنَ مِن سودٍ صَوادِقَ في الدُجى","يَرَينَ بَعيداتِ الشُخوصِ كَما هِيَا",151,"ي",2,0],["ويَنَامُ مِنْ تَعَبٍ وَيَدْعُو رَبَّهُ","زُمراً ألم ترَ عِقدها محلولا",152,"ل",2,0],["ويَنَامُ مِنْ تَعَبٍ وَيَدْعُو رَبَّهُ","تخذتْ عزئمهُ الفضاءَ سبيلا",153,"ل",2,0],["وينقُلُهُ بعضٌ لبعضٍ تَمثُّلاً","إذا انفَضَّ عنه مَحفِلٌ عاد مَحْفِل",154,"ل",1,0],["وينتزعانِ الشُفوفَ التي","تدثَّرَ كَوْنٌ بها وارتدى",155,"ا",1,0],["وينكر عيشاً قد تقادم عهده","ويظهر سراً كان بالأمس في خفا",156,"ف",2,0],["وينفخ في الجماد قوى وحسّا","فيركش تارة ويطير حينا",157,"ن",2,0],["وينامُ عنا حينَ نلوي شُكرَهْ","فِعْلَ الكريمِ فكشرهُ تأجيلُ",158,"ل",1,0],["وينقض الأوتار والحقائدا","فلا تُثرْ من لم يُثرك عامدا",159,"د",2,0],["وينقضُ ألواحَ السفينِ فكُلُّها","فمن ساد قوماً أوجب الطولَ أن يُرى",160,"ر",2,0],["وينطقُ المنطقَ المفتونَ سامعُهُ","والمنطق الحسنُ المسوعُ فتَّان",161,"ن",1,0],["وينزوي ، كضريح يستعيد صدىّ","يبكي ويهزج (لا حزنا ولا فرحا)",162,"ح",2,0],["وينقض عن أعطافها النور لؤلؤا","من الطلّ ما ضمت عليه جيوب",163,"ب",1,0]]}