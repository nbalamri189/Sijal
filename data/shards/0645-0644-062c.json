{"poems":[[30,"تصابيت في أطلال مية بعدما","https://www.aldiwan.net/poem29578.html","الطويل"],[62,"الملك الشيخ العقيم الذي","https://www.aldiwan.net/poem52161.html","السريع"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20250","الرمل"],[361,"صاح في العاشقين بال كنانه","https://www.aldiwan.net/poem68049.html","الخفيف"],[377,"هذا التواضع إن أردت مواهبا","https://www.aldiwan.net/poem66936.html","الكامل"],[458,"در لها خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[500,"وحد الله ولا تشرك به","https://www.aldiwan.net/poem38033.html","الرمل"]],"verses":[["مُلَجَّجَةٌ في الماءِ يَعلو حَبابُهُ","حَيازيمَها السُفلى وَتَطفو سُطورُها",0,"ر",3,0],["ملجّجاً فيه ففي وسطه","جزيرة ضاق بها السيلُ",1,"ل",1,0],["مَلجَأً أَو مَصرِفاً أَو مَصنَعاً","أَو نِقاباتٍ لِزُرّاعِ القُرى",2,"ر",2,0],["ملجما مِن شَدا براغَة في","ها كانى بِها عقدت لِسانَه",3,"ن",2,0],["ملجاً يرى المترهبون بظلِّه","مرعىً خصيباً في الورى ومشاربا",4,"ب",2,0],["ملجَمَةٌ تركب من دهمائها","على مَتاعٍ من ضحاها غَسَقا",5,"ق",2,0],["ملجَأُ العَرْجاءِ مَعْقودُ اللِّوا","فارِسُ الهَيْجاءِ كشَّافُ الرَّدى",6,"د",2,0]]}