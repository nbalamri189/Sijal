{"poems":[[32,"تصابيت في أطلال مية بعدما","https://www.aldiwan.net/poem29578.html","الطويل"],[64,"الملك الشيخ العقيم الذي","https://www.aldiwan.net/poem52161.html","السريع"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/20250","الرمل"],[366,"صاح في العاشقين بال كنانه","https://www.aldiwan.net/poem68049.html","الخفيف"],[382,"هذا التواضع إن أردت مواهبا","https://www.aldiwan.net/poem66936.html","الكامل"],[463,"در لها خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[505,"وحد الله ولا تشرك به","https://www.aldiwan.net/poem38033.html","الرمل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107188","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136342","الخفيف"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46507","الرجز"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127989","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48230","البسيط"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74325","الخفيف"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134023","الخفيف"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133973","الخفيف"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87579","البسيط"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101236","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117867","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85053","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133234","الرمل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69971","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90800","الرمل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135117","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72428","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72356","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139520",""],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101937","الرجز"],[4764,"لا تعايرني بحاجه","https://www.poetsgate.com/ViewPoem.aspx?id=36431",""],[4926,"يا دليل الرَّكب إلى نجدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=171110",""],[5205,"أي عين بت محتجباً","https://www.poetsgate.com/ViewPoem.aspx?id=120997",""],[5461,"غلا الناس (سلطان بن عبد العزيز )","https://www.poetsgate.com/ViewPoem.aspx?id=5062",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""]],"verses":[["مُلَجَّجَةٌ في الماءِ يَعلو حَبابُهُ","حَيازيمَها السُفلى وَتَطفو سُطورُها",0,"ر",3,0],["ملجّجاً فيه ففي وسطه","جزيرة ضاق بها السيلُ",1,"ل",1,0],["مَلجَأً أَو مَصرِفاً أَو مَصنَعاً","أَو نِقاباتٍ لِزُرّاعِ القُرى",2,"ر",2,0],["ملجما مِن شَدا براغَة في","ها كانى بِها عقدت لِسانَه",3,"ن",2,0],["ملجاً يرى المترهبون بظلِّه","مرعىً خصيباً في الورى ومشاربا",4,"ب",2,0],["ملجَمَةٌ تركب من دهمائها","على مَتاعٍ من ضحاها غَسَقا",5,"ق",2,0],["ملجَأُ العَرْجاءِ مَعْقودُ اللِّوا","فارِسُ الهَيْجاءِ كشَّافُ الرَّدى",6,"د",2,0],["مَلجَأُ المُعتَفينَ بَرُّ الأَفضا","لِ من ظِلُّ عَدلِهِ مَمدُودُ",7,"د",1,0],["ملجاي مقصدي وذخري وحصني","وامامي وقبلتي فاسمعوني",8,"ن",2,0],["ملجأ كُل خائف مَلهوف","وَمَرتع الحَيران وَالضُّيوف",9,"ف",1,0],["ملجأ اللائذين في كل خطب","وعلى وده الختاصر تعقد",10,"د",1,0],["ملجا اللهيفِ ومأوىً للضيوفِ ولا","مَيْنٌ به أمِنَتْ سُوحٌ وبلدانُ",11,"ن",1,0],["مَلجا الضَعيف إذا وَلَّت جَماعته","عَروس يوم تُشيب الطفلَ ساعته",12,"ه",1,0],["مَلجأ اللائِذين مولي العَطايا","كُل عاف مِن الوَرى وَعَديما",13,"م",2,0],["ملجأ للفوز المبين ملاذا","للعنايات عرشه الشاهاني",14,"ن",2,0],["ملجأ العالمين في كل خير","وملاذ الندى لكل مريد",15,"د",1,0],["ملجأ الوباءِ وملجا الحرِّ يقصدهُ","مُصابُ هَذَين من قاصٍ ومن دانِ",16,"ن",1,0],["ملجأ اللاجئين من بأياديه","أقام المحمول والموضوعا",17,"ع",2,0],["ملجأ للكرام يزهو به في","منتدى الفضل صيفه والشتاءُ",18,"ا",2,0],["ملجأ الوافدين سامي العطايا","مكرم مكرم حسيب نسيب",19,"ب",1,0],["مَلجَأ العاصِي إنِ تَطايَرَتِ الصُّحفُ","وَفِيهَا ما كانَ مِنهُ وَفاءُ",20,"ا",2,0],["ملجىء دوما وذخرى","في الملمات الصعاب",21,"ب",1,0],["ملجا الخلافة والعدالةِ مَن غدا","في ما بهِ خير العِبادِ مفكِرا",22,"ر",2,0],["ملجاء المطرود ما وي الضعفا","مورد الجوى حمى المنذعر",23,"ر",1,0],["ملجا لنا في الندى من ام لم تجب","حبر غدا تاج جود صيغ للقمم",24,"م",1,0],["ملجا المريدين منجى اللائذين به","كنز المقلين منذخوري ومأمولي",25,"ل",2,0],["ملجأ العاجزين كهف اليتامى","مروة المرملين مأوى الضيوف",26,"ف",1,0],["ملجئآ كل نعمةٍ بحماها","أزهر المجدُ بل زها وتصابى",27,"ب",2,0],["ملجأ كل خائف","مقصده كل من قصد",28,"د",1,0],["ملجمه والحلم سارح/ ابتدت جلسه علاجي","والحكي ذربٍ يذوب لا تلبسني أزين",29,"ن",1,0],["ملجأ العافين ومنجاهم","لم يكن يألو أحداً نصحا",30,"ح",2,0],["ملجأ اللاجين كهف رجا","مقصد الأيتام والغربا",31,"ب",2,0],["ملجا الرفيق ومن بعد كان ضدّه","حتى العدو ينصاه لي ضاق به شان",32,"ن",1,0],["ملجا مثل سنجار من قبل لِلوَرى","رَمايا وَعَلى متن الحَريب ثقال",33,"ل",1,0]]}