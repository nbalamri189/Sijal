الظعن هل من نظرة تستزيدها","https://www.aldiwan.net/poem57501.html","الطويل"],[392,"إذا شئت الدواء لكل داء","https://www.aldiwan.net/poem54640.html","عموديه"],[404,"طال الوقوف على الأطلال والدمن","https://www.aldiwan.net/poem33399.html","البسيط"],[421,"يعاتبني في الدين قومي وإنما","https://www.aldiwan.net/poem4848.html","الطويل"],[430,"يهيجني تذكار خل كما البدر","https://www.aldiwan.net/poem41069.html","الطويل"],[433,"تقدم في الطب عبد العزيز","https://www.aldiwan.net/poem12667.html","المتقارب"],[438,"منازلهم بين اللوى فالدكادك","https://www.aldiwan.net/poem2528.html","الطويل"],[438,"أمن منزل بالجق أقوت معالمه","https://www.aldiwan.net/poem2537.html","الطويل"],[440,"أخو ظمأ يمص حشاه سبع","https://www.aldiwan.net/poem34835.html","الوافر"],[440,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[442,"أسير الهوى قل لي فما أنت صانع","https://www.aldiwan.net/poem14332.html","الطويل"],[449,"سقى ملث الغوادي","https://www.aldiwan.net/poem53731.html","المجتث"],[459,"أجاذبها لو أمكنت من زِمامها","https://www.aldiwan.net/poem55889.html","الطويل"],[459,"لها كل يوم نشطة وعقال","https://www.aldiwan.net/poem55906.html","الطويل"],[459,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[459,"لعمر الواشيات بأم عمرو","https://www.aldiwan.net/poem56176.html","الوافر"],[462,"يجلي العظيمة من غير فخر","https://www.aldiwan.net/poem15580.html","المتقارب"],[462,"يظن الهوى العذري وجدي بمجده","https://www.aldiwan.net/poem15650.html","الطويل"],[462,"ضروب قذال القرن فذا لدى الوغى","https://www.aldiwan.net/poem16039.html","الطويل"],[465,"نعم نفحة الوادي التي تتأرج","https://www.aldiwan.net/poem3143.html","عموديه"],[465,"لقد بوركت يا بن المبارك بلدة","https://www.aldiwan.net/poem3187.html","عموديه"],[465,"أقام الوجد بعدهم وساروا","https://www.aldiwan.net/poem3209.html","عموديه"],[465,"راح يستمطر الدموع الغزارا","https://www.aldiwan.net/poem3621.html","عموديه"],[478,"أقفر من سكانه المعهد","https://www.aldiwan.net/poem15224.html","السريع"],[480,"أرقت وما غير الشجون سمير","https://www.aldiwan.net/poem37571.html","الكامل"],[496,"سماء الدجى ما هذه الحدق النجل","https://www.aldiwan.net/poem10259.html","الطويل"],[537,"أشاقتك أطلال بوجرة درس","https://www.aldiwan.net/poem23852.html","الطويل"],[552,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[576,"نعم هي سعدي وهي لي قمر سعد","https://www.aldiwan.net/poem3086.html","الطويل"]],"verses":[["وَإِن ضافَهُ الهَمُّ النَزيعُ رَمى بِها","نَزائِعَ لا يُعلَفنَ غَيرَ الشَكائِمِ",0,"م",1,0],["وَإِن ضَرايحَكُم في الصَعيدِ","لَتَكسو الخَبيثَ مِنَ الأَرضِ طيبا",1,"ب",2,0],["وَإِن ضاقَ صَدرُ الخَطبِ وَسَّعَ بِأَسُهُم","لِسُمرِ القَنا بَينَ الضُلوعِ مَذاهِبا",2,"ب",2,0],["وَأَنضَينا المَدى طَرَباً وَهَمّاً","فَما بَقِيَ النَعيمُ وَلا الشَقاءُ",3,"ا",2,0],["وإِن ضلَّ عنكم فانشدوهُ على الحِمى","فثَمَّ مكانٌ مِن فؤاديَ لا يَخلو",4,"ل",2,0],["وإن ضِقْتُ ذَرْعاً بالمُنى فرَحيبَةٌ","بِها خُطُواتُ الأرحَبيّةِ والفَضا",5,"ض",2,0],["وَأَنْضَرُ الَّرْوضِ أَضْحَى وَهْوَ مُصْطَبِحٌ","وَالْغُصْنُ قَدْ مَالَ مَيْلَ الشَّارِبِ الثَّمِلِ",6,"ل",1,0],["وإنْ ضاقَ وُسْعي عنْ قِيامي ببَعْضِها","فَما ضاقَ عنْ عُذْرٍ لَها وُسْعُ مَجْدِهِ",7,"د",2,0],["وَإِن ضَيَّعتَ ذاكَ فَلا تَلُمهُ","عَلى أَن لَم يَكُن عَلِمَ الغيوبا",8,"ب",2,0],["وانضَمَّ للجُند يَمشي تحتَ رايَتِه","وبالحياةِ إذا مالَتْ يُفَدِّيها",9,"ي",3,0],["وَأَنَّ ضَمائِرَ هَذا الوُجودِ","تَبوحُ إِلَيكَ بِأَسرارِها",10,"ر",3,0],["وَإِن ضاقَ بِالمَوتِ صَدرُ اِمرِئٍ","فَصَدرُكَ بِالمَوتِ لَم يَحرَجِ",11,"ج",1,0],["وانْضحا من دمِي عليهِ فقد كا","ن دمِي من نداه لو تعلمان",12,"ن",1,0],["وإن ضلوا فمُرشدُهُم قريبٌ","وإن سألوه ألفوه يجيبُ",13,"ب",1,0],["وإنْ ضنَّ دهرٌ مرةً بعطيةٍ","تناولني في ضِيقتي بنواله",14,"ل",2,0],["وَأَنضاءٍ أُنِخنَ إِلى سَعيدٍ","طُروقاً ثُمَّ عَجَّلنَ اِبتِكارا",15,"ر",2,0],["وَأُنضيَتِ الصَوارِمُ خاطِياتٍ","فَكانَ قَضاؤها سِحرُ البَيانِ",16,"ن",1,0],["وَإِن ضاقَ رِزقُ اليَومِ فَاِصبِر إِلى غَدٍ","عَسى نَكَباتِ الدَهرِ عَنكَ تَزولُ",17,"ل",1,0],["وإن ضاقَ بالحرِّ المجالُ ببلدةٍ","فكمْ بلدَةٍ فيها المجالُ رحيبُ",18,"ب",1,0],["وإن ضاعَ التعاونُ في أُناسٍ","عَفتْ آثارُهم في الضّائعينا",19,"ن",2,0],["وَإِن ضَجَّ ما بَين القَواضبِ هالكٌ","أَرنَّت وَراءَ الخَيلِ شُعثاً تُجاوِبُهْ",20,"ب",2,0],["وَإِن ضَحِكَت سِنُّ الهُدى عَن إِمارَةٍ","فَعَنكُم وَعَن أَيّامُكُم يَضحَكُ الهُدى",21,"د",2,0],["وَإِن ضُرِبَت بِالسَوطِ صَرَّت بِنابِها","صَريرَ الصَياصي في النَسيجِ المُمَدَّدِ",22,"د",1,0],["وإنْ ضُرِبَتْ أطْنابُه بتَنُوفَةٍ","نَأى الضّبُّ عنها خِيفَةً من عُرامهِ",23,"م",2,0],["وإن ضَلِلْتُ بلَيْلٍ من ذوائِبهِ","أهدى لعيني الهدى صُبحٌ من البَلجِ",24,"ج",1,0],["وَإِنْ ضَاحَكَتْهَا الشَّمْسُ رَفَّتْ كَأَنَّهَا","مَنَاصِلُ سُلَّتْ لِلضِّرَابِ مِنَ الْغِمْدِ",25,"د",1,0],["وانضحوا من دمعة اليوم على","سجفِ النعشِ ومن عزّة أمس",26,"س",1,0],["وإن ضُرِبَتْ دونَ الخليجِ خِيامُه","فَمِنْ خَلفِهِ للرُّعْبِ جَيْشٌ مُخَيِّمُ",27,"م",1,0],["وإن ضاق وسعي عن قياسي ببعضها","فما ضاق عن عذر لها وسع مجده",28,"د",2,0],["وإن ضاعفتَه مسحةُ الحزن رَونقاً","فمن فضلِ أشجان أخذْن بمخنِقي",29,"ق",2,0],["وَإِن ضَنَ السَحاب فَلا أُبالي","وَفَيض نَداهُ قَد أَضحى سَكوبا",30,"ب",2,0],["وإن ضَرَبتَ عَدَداً في جِنس","فالخارجُ الجِنسُ بِغَيرِ لَبسِ",31,"س",1,0],["وإن ضلالاً ندب ما ليس راجعا","وإن عناء ما تحن الضمائر",32,"ر",1,0],["وَإِن ضاقَت بِلادُ اللَهِ جَمعاً","بِفَلِّهِمِ فَعَفوُكَ لَن يَضيقا",33,"ق",2,0],["وانضح بها كبدي فدي","تكَ فهيَ داميَةُ الكلوم",34,"م",1,0],["وانضَح بها كبداً نَهبَ الجوى واثر","باللَه غافيَ إحساسي وإيماني",35,"ن",2,0],["وَإِن ضاقَ هذا الشَعرُ وَهوَ مُحَرَّرٌ","فَما ضَرَّهُ إِنَّ الكَريمَ مُحَرَّرُ",36,"ر",1,0],["وَإِن ضَنَّت سَحائِبُهُ سَقانا","سَحابٌ مِن مَوارِدِهِ رُكامُ",37,"م",1,0],["وَإِن ضَنَّت بِآمالي فَأَضحَت","مَصاعِبُ لا يَلينُ لَها خِطامُ",37,"م",1,0],["وَإِن ضَنَّت غَوادي المُزنِ صابوا","حَيّاً وَإِذا دَجى خَطبٌ أَناروا",38,"ر",3,0],["وَأَنْضِجْ مَا رَأَيْتَ بِنَارِ فِكْرٍ","فَإِنَّ الأَكْلَ مِنْ بَعْدِ اطِّبَاخِ",39,"خ",1,0],["وَأَنْضَانِي كَمَا أَنْضَى","ذَوَاتَ الْخَبْزِ ذُو الْخَبْزِ",40,"ز",1,0],["وان ضاق الخناق عليك فانزل","بسيدنا ابن سيدنا النَهاري",41,"ر",2,0],["وان ضاق يوم الحشر بالناس جانبا","فَقل لا تخف عَبد الرَحيم المهاجري",42,"ر",2,0],["وان ضاق أَهل الحشر ذرعا بموقف","بك الكتب تعطى باليَمين وَباليسرى",43,"ر",2,0],["وإن ضاق أمر بالرِّجال توجَّهَتْ","عزائكه فاستوسعت كلَّ ضيِّقِ",44,"ق",1,0],["وإِن ضَنَّ بالغيث السحابُ تَهلَّلت","سحائبُ عَشرٌ من أَنامِله العَشرِ",45,"ر",1,0],["واِنض عنّي ثوب الوقارِ بكأسٍ","يَبعث الأنس فالكريم طروبُ",46,"ب",1,0],["وَإِن ضُرِبَت عَلى العِلّاتِ حَطَّت","إِلَيكَ حِطاطَ هادِيَةٍ شَنونِ",47,"ن",1,0],["وَإِن ضِياءَ الشَمسِ عِندَ طُلوعِها","لَمُحتَجِبٌ عَن كُلِ عَينٍ عَمِيَّةِ",48,"ه",1,0],["وإن ضُربَت يوماً من النقع خيمةٌ","وطالَ على الأبطالِ منها ركودُها",49,"د",3,0],["وإن ضاقت بك الأحوال فاحظ","أمورا خطها قلم القضاء",50,"ا",2,0],["وانضاف كل إلى من صار منتصباً","للأمر مرتفعاً في أرفع القنن",51,"ن",1,0],["وَإِن ضَيَّعوا غيبي حَفظتُ غيوبَهُم","وَإِن هُم هَوَوا غَييِّ هَوَيتُ لَهُم رُشدا",52,"د",2,0],["وإن ضمت القرطاس خطّاً تخاله","جبين مليح قد تلألأ بالشعر",53,"ر",1,0],["وإن ضاقَ من غيره مسلكٌ","رأيتَ له منهَجاً واسعا",54,"ع",2,0],["وإن ضنّ جود الغيث حينا فجادها","من الجفن صوب العارض المتدارك",55,"ك",1,0],["وإن ضن صوب الغيث جادت يمينه","على الناس ما لم تستطعه سواجمه",56,"م",2,0],["وإِنْ ضاقَتْ بِهِم أَرضٌ فأَرضٌ","فما بَكَّتْ لمثلِهِمُ السَّماءُ",57,"ا",2,0],["وإِنْ ضاقَ رَحْبُ الأَرْضِ عَنْ مُنْتَوَاهُمُ","فَرَحْبٌ لَهُمْ مَا بَيْنَ سَحْرِي إِلَى نَحْرِي",58,"ر",2,0],["وإن ضربوا الأقباب في حي عاصم","تجاوب قينات القباب السواطع",59,"ع",1,0],["وان ضلت هداني","من طيب ريّاه هادي",60,"د",2,0],["وإن ضاقَ بين القِرن والقِرن مأزِق","ضرابُ الكماةِ فيه مثلُ لِطامِها",61,"م",3,0],["وأنضو قناعَ السلْم بيني وبينه","كفاحاً وسلمُ الغادرين قتالُ",62,"ل",1,0],["وانضُ ثيابَ الصوم عن عاتق","من كلّ وِزرٍ في غدٍ معتَقِ",63,"ق",1,0],["وإن ضعُفتْ أواصرُ من رجال","شددتُ بأسرة الكرماءِ أَسري",64,"ر",2,0],["واِنْ ضاق بالأحداث صدرٌ فعنده","خواطر حلمٍ ما يضيقُ وسيعُها",65,"ه",2,0],["واِن ضاق قلبٌ بالصغيرة لامرىءٍ","فقلبُ عليًّ بالكبيرةِ أفْسَحُ",66,"ح",1,0],["وإنْ ضلَّ عن نحرٍ سنانٌ بمعركٍ","هديْن إلى اللبَّات رمحاً ومِعْصما",67,"م",2,0],["وان ضحكتْ في يوم بأسٍ سيوفهُ","رأيت الأعادي كيف تبكي وتنشِج",68,"ج",1,0],["وإن ضلَّ ساري المدح في قصد غيركم","سرى في صباحٍ من نداك مبين",69,"ن",1,0],["وإن ضنَّ الحيا فهمُ ربيعٌ","وإن ضلَّ الورى فهمُ منارُ",70,"ر",1,0],["وانضُ مني ماضي الشّبا أوجهُ","الأسفار تحلو لمثله إسفارا",71,"ر",2,0],["واِنْ ضلَّتْ سأهديها إذا ما","ألاحَ الركبُ من أرجِ الصعيدِ",72,"د",1,0],["وانضمت الأسمال عن منهوكة","ألف ارتعاشا جسمها المقرور",73,"ر",1,0],["وإن ضربت أعناقهم عاش ميتهم","فقتلهم أن لا يعمهم القتل",74,"ل",1,0],["وَأَنضوا إِلَيهِ كُلَّ جَأبٍ هَمَلَّعٍ","تُعارِضُهُ وَجناءُ كَالفَحلِ عِرمِسُ",75,"س",1,0],["وأنضَرَهُمْ وأطهرَهمْ ذُيولاً","وأمضاهمْ وأقضاهمْ ديونا",76,"ن",2,0],["وأَنْضمت عطاياه السُّرى لِعُفاتِه","فتِلْك العطايا لا يجِفُّ لها لبدُ",77,"د",1,0]]}