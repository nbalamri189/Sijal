32266",""],[5442,"أرحها فقد مل الظلام سراها","https://www.poetsgate.com/ViewPoem.aspx?id=114763",""],[5526,"الصحبه","https://www.poetsgate.com/ViewPoem.aspx?id=192528",""],[5563,"سيحكي الفوات","https://www.poetsgate.com/ViewPoem.aspx?id=212675",""],[5582,"يا بَرْقُ حَيِّ الأَبْرَقَيْنِ فَثَهْمَدَا","https://www.poetsgate.com/ViewPoem.aspx?id=63492",""],[5690,"يا طالب الأمن في الأقطار","https://www.poetsgate.com/ViewPoem.aspx?id=172235",""],[5690,"نادى البشير وصبح الخير قد سفرا","https://www.poetsgate.com/ViewPoem.aspx?id=172159",""],[5720,"موطني","https://www.poetsgate.com/ViewPoem.aspx?id=210881",""],[5732,"قلب صفق","https://www.poetsgate.com/ViewPoem.aspx?id=177942",""],[5736,"ضيق","https://www.poetsgate.com/ViewPoem.aspx?id=208455",""],[5809,"ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=205284",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5818,"إلى روح البردوني","https://www.poetsgate.com/ViewPoem.aspx?id=181721",""],[4615,"يا عمروُ أينَ عُمَيْرٌ من كُدَى يَمَنٍ","https://www.poetsgate.com/ViewPoem.aspx?id=17825",""],[5829,"جددي حبي","https://www.poetsgate.com/ViewPoem.aspx?id=148339",""],[5845,"لكَ الحمدُ حمداً نستلذُّ به ذكراً","https://www.poetsgate.com/ViewPoem.aspx?id=15449",""],[5873,"عيش الفخار","https://www.poetsgate.com/ViewPoem.aspx?id=215435",""],[6079,"أمِن بأسِ الفواجعِ تدمعينا","https://www.poetsgate.com/ViewPoem.aspx?id=208563",""],[6079,"سنن الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=212718",""],[6142,"سل عنه سلعا لدن ضاق الخناق بها","https://www.poetsgate.com/ViewPoem.aspx?id=155715",""],[6152,"قلبك موطني 2","https://www.poetsgate.com/ViewPoem.aspx?id=213169",""],[6152,"عيناكِ الهداية والطريق","https://www.poetsgate.com/ViewPoem.aspx?id=213221",""],[6237,"رمضان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77859&r=&rc=1",""],[5164,"لمن سأجمع أزهاري؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75666&r=&rc=20",""],[6331,"الشكوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82021&r=&rc=2",""]],"verses":[["وَإِن ضافَهُ الهَمُّ النَزيعُ رَمى بِها","نَزائِعَ لا يُعلَفنَ غَيرَ الشَكائِمِ",0,"م",1,0],["وَإِن ضَرايحَكُم في الصَعيدِ","لَتَكسو الخَبيثَ مِنَ الأَرضِ طيبا",1,"ب",2,0],["وَإِن ضاقَ صَدرُ الخَطبِ وَسَّعَ بِأَسُهُم","لِسُمرِ القَنا بَينَ الضُلوعِ مَذاهِبا",2,"ب",2,0],["وَأَنضَينا المَدى طَرَباً وَهَمّاً","فَما بَقِيَ النَعيمُ وَلا الشَقاءُ",3,"ا",2,0],["وإِن ضلَّ عنكم فانشدوهُ على الحِمى","فثَمَّ مكانٌ مِن فؤاديَ لا يَخلو",4,"ل",2,0],["وإن ضِقْتُ ذَرْعاً بالمُنى فرَحيبَةٌ","بِها خُطُواتُ الأرحَبيّةِ والفَضا",5,"ض",2,0],["وَأَنْضَرُ الَّرْوضِ أَضْحَى وَهْوَ مُصْطَبِحٌ","وَالْغُصْنُ قَدْ مَالَ مَيْلَ الشَّارِبِ الثَّمِلِ",6,"ل",1,0],["وإنْ ضاقَ وُسْعي عنْ قِيامي ببَعْضِها","فَما ضاقَ عنْ عُذْرٍ لَها وُسْعُ مَجْدِهِ",7,"د",2,0],["وَإِن ضَيَّعتَ ذاكَ فَلا تَلُمهُ","عَلى أَن لَم يَكُن عَلِمَ الغيوبا",8,"ب",2,0],["وانضَمَّ للجُند يَمشي تحتَ رايَتِه","وبالحياةِ إذا مالَتْ يُفَدِّيها",9,"ي",3,0],["وَأَنَّ ضَمائِرَ هَذا الوُجودِ","تَبوحُ إِلَيكَ بِأَسرارِها",10,"ر",3,0],["وَإِن ضاقَ بِالمَوتِ صَدرُ اِمرِئٍ","فَصَدرُكَ بِالمَوتِ لَم يَحرَجِ",11,"ج",1,0],["وانْضحا من دمِي عليهِ فقد كا","ن دمِي من نداه لو تعلمان",12,"ن",1,0],["وإن ضلوا فمُرشدُهُم قريبٌ","وإن سألوه ألفوه يجيبُ",13,"ب",1,0],["وإنْ ضنَّ دهرٌ مرةً بعطيةٍ","تناولني في ضِيقتي بنواله",14,"ل",2,0],["وَأَنضاءٍ أُنِخنَ إِلى سَعيدٍ","طُروقاً ثُمَّ عَجَّلنَ اِبتِكارا",15,"ر",2,0],["وَأُنضيَتِ الصَوارِمُ خاطِياتٍ","فَكانَ قَضاؤها سِحرُ البَيانِ",16,"ن",1,0],["وَإِن ضاقَ رِزقُ اليَومِ فَاِصبِر إِلى غَدٍ","عَسى نَكَباتِ الدَهرِ عَنكَ تَزولُ",17,"ل",1,0],["وإن ضاقَ بالحرِّ المجالُ ببلدةٍ","فكمْ بلدَةٍ فيها المجالُ رحيبُ",18,"ب",1,0],["وإن ضاعَ التعاونُ في أُناسٍ","عَفتْ آثارُهم في الضّائعينا",19,"ن",2,0],["وَإِن ضَجَّ ما بَين القَواضبِ هالكٌ","أَرنَّت وَراءَ الخَيلِ شُعثاً تُجاوِبُهْ",20,"ب",2,0],["وَإِن ضَحِكَت سِنُّ الهُدى عَن إِمارَةٍ","فَعَنكُم وَعَن أَيّامُكُم يَضحَكُ الهُدى",21,"د",2,0],["وَإِن ضُرِبَت بِالسَوطِ صَرَّت بِنابِها","صَريرَ الصَياصي في النَسيجِ المُمَدَّدِ",22,"د",1,0],["وإنْ ضُرِبَتْ أطْنابُه بتَنُوفَةٍ","نَأى الضّبُّ عنها خِيفَةً من عُرامهِ",23,"م",2,0],["وإن ضَلِلْتُ بلَيْلٍ من ذوائِبهِ","أهدى لعيني الهدى صُبحٌ من البَلجِ",24,"ج",1,0],["وَإِنْ ضَاحَكَتْهَا الشَّمْسُ رَفَّتْ كَأَنَّهَا","مَنَاصِلُ سُلَّتْ لِلضِّرَابِ مِنَ الْغِمْدِ",25,"د",1,0],["وانضحوا من دمعة اليوم على","سجفِ النعشِ ومن عزّة أمس",26,"س",1,0],["وإن ضُرِبَتْ دونَ الخليجِ خِيامُه","فَمِنْ خَلفِهِ للرُّعْبِ جَيْشٌ مُخَيِّمُ",27,"م",1,0],["وان ضريحة ضمتك فازت","ببحر ليس ينزف بالعيون",28,"ن",1,0],["وان ضيعتها أهلها فحقوقها","يغار لها للعدل بالقسط قائم",29,"م",1,0],["وإن ضاق وسعي عن قياسي ببعضها","فما ضاق عن عذر لها وسع مجده",30,"د",2,0],["وإن ضاعفتَه مسحةُ الحزن رَونقاً","فمن فضلِ أشجان أخذْن بمخنِقي",31,"ق",2,0],["وَإِن ضَنَ السَحاب فَلا أُبالي","وَفَيض نَداهُ قَد أَضحى سَكوبا",32,"ب",2,0],["وإن ضَرَبتَ عَدَداً في جِنس","فالخارجُ الجِنسُ بِغَيرِ لَبسِ",33,"س",1,0],["وإن ضلالاً ندب ما ليس راجعا","وإن عناء ما تحن الضمائر",34,"ر",1,0],["وَإِن ضاقَت بِلادُ اللَهِ جَمعاً","بِفَلِّهِمِ فَعَفوُكَ لَن يَضيقا",35,"ق",2,0],["وانضح بها كبدي فدي","تكَ فهيَ داميَةُ الكلوم",36,"م",1,0],["وانضَح بها كبداً نَهبَ الجوى واثر","باللَه غافيَ إحساسي وإيماني",37,"ن",2,0],["وَإِن ضاقَ هذا الشَعرُ وَهوَ مُحَرَّرٌ","فَما ضَرَّهُ إِنَّ الكَريمَ مُحَرَّرُ",38,"ر",1,0],["وَإِن ضَنَّت سَحائِبُهُ سَقانا","سَحابٌ مِن مَوارِدِهِ رُكامُ",39,"م",1,0],["وَإِن ضَنَّت بِآمالي فَأَضحَت","مَصاعِبُ لا يَلينُ لَها خِطامُ",39,"م",1,0],["وَإِن ضَنَّت غَوادي المُزنِ صابوا","حَيّاً وَإِذا دَجى خَطبٌ أَناروا",40,"ر",3,0],["وَأَنْضِجْ مَا رَأَيْتَ بِنَارِ فِكْرٍ","فَإِنَّ الأَكْلَ مِنْ بَعْدِ اطِّبَاخِ",41,"خ",1,0],["وَأَنْضَانِي كَمَا أَنْضَى","ذَوَاتَ الْخَبْزِ ذُو الْخَبْزِ",42,"ز",1,0],["وان ضاق الخناق عليك فانزل","بسيدنا ابن سيدنا النَهاري",43,"ر",2,0],["وان ضاق يوم الحشر بالناس جانبا","فَقل لا تخف عَبد الرَحيم المهاجري",44,"ر",2,0],["وان ضاق أَهل الحشر ذرعا بموقف","بك الكتب تعطى باليَمين وَباليسرى",45,"ر",2,0],["وإن ضاق أمر بالرِّجال توجَّهَتْ","عزائكه فاستوسعت كلَّ ضيِّقِ",46,"ق",1,0],["وإِن ضَنَّ بالغيث السحابُ تَهلَّلت","سحائبُ عَشرٌ من أَنامِله العَشرِ",47,"ر",1,0],["واِنض عنّي ثوب الوقارِ بكأسٍ","يَبعث الأنس فالكريم طروبُ",48,"ب",1,0],["وَإِن ضُرِبَت عَلى العِلّاتِ حَطَّت","إِلَيكَ حِطاطَ هادِيَةٍ شَنونِ",49,"ن",1,0],["وَإِن ضِياءَ الشَمسِ عِندَ طُلوعِها","لَمُحتَجِبٌ عَن كُلِ عَينٍ عَمِيَّةِ",50,"ه",1,0],["وإن ضُربَت يوماً من النقع خيمةٌ","وطالَ على الأبطالِ منها ركودُها",51,"د",3,0],["وإن ضاقت بك الأحوال فاحظ","أمورا خطها قلم القضاء",52,"ا",2,0],["وانضاف كل إلى من صار منتصباً","للأمر مرتفعاً في أرفع القنن",53,"ن",1,0],["وَإِن ضَيَّعوا غيبي حَفظتُ غيوبَهُم","وَإِن هُم هَوَوا غَييِّ هَوَيتُ لَهُم رُشدا",54,"د",2,0],["وإن ضمت القرطاس خطّاً تخاله","جبين مليح قد تلألأ بالشعر",55,"ر",1,0],["وإن ضاقَ من غيره مسلكٌ","رأيتَ له منهَجاً واسعا",56,"ع",2,0],["وإن ضنّ جود الغيث حينا فجادها","من الجفن صوب العارض المتدارك",57,"ك",1,0],["وإن ضن صوب الغيث جادت يمينه","على الناس ما لم تستطعه سواجمه",58,"م",2,0],["وإِنْ ضاقَتْ بِهِم أَرضٌ فأَرضٌ","فما بَكَّتْ لمثلِهِمُ السَّماءُ",59,"ا",2,0],["وإِنْ ضاقَ رَحْبُ الأَرْضِ عَنْ مُنْتَوَاهُمُ","فَرَحْبٌ لَهُمْ مَا بَيْنَ سَحْرِي إِلَى نَحْرِي",60,"ر",2,0],["وإن ضربوا الأقباب في حي عاصم","تجاوب قينات القباب السواطع",61,"ع",1,0],["وان ضلت هداني","من طيب ريّاه هادي",62,"د",2,0],["وإن ضاقَ بين القِرن والقِرن مأزِق","ضرابُ الكماةِ فيه مثلُ لِطامِها",63,"م",3,0],["وأنضو قناعَ السلْم بيني وبينه","كفاحاً وسلمُ الغادرين قتالُ",64,"ل",1,0],["وانضُ ثيابَ الصوم عن عاتق","من كلّ وِزرٍ في غدٍ معتَقِ",65,"ق",1,0],["وإن ضعُفتْ أواصرُ من رجال","شددتُ بأسرة الكرماءِ أَسري",66,"ر",2,0],["واِنْ ضاق بالأحداث صدرٌ فعنده","خواطر حلمٍ ما يضيقُ وسيعُها",67,"ه",2,0],["واِن ضاق قلبٌ بالصغيرة لامرىءٍ","فقلبُ عليًّ بالكبيرةِ أفْسَحُ",68,"ح",1,0],["وإنْ ضلَّ عن نحرٍ سنانٌ بمعركٍ","هديْن إلى اللبَّات رمحاً ومِعْصما",69,"م",2,0],["وان ضحكتْ في يوم بأسٍ سيوفهُ","رأيت الأعادي كيف تبكي وتنشِج",70,"ج",1,0],["وإن ضلَّ ساري المدح في قصد غيركم","سرى في صباحٍ من نداك مبين",71,"ن",1,0],["وإن ضنَّ الحيا فهمُ ربيعٌ","وإن ضلَّ الورى فهمُ منارُ",72,"ر",1,0],["وانضُ مني ماضي الشّبا أوجهُ","الأسفار تحلو لمثله إسفارا",73,"ر",2,0],["واِنْ ضلَّتْ سأهديها إذا ما","ألاحَ الركبُ من أرجِ الصعيدِ",74,"د",1,0],["وانضمت الأسمال عن منهوكة","ألف ارتعاشا جسمها المقرور",75,"ر",1,0],["وإن ضربت أعناقهم عاش ميتهم","فقتلهم أن لا يعمهم القتل",76,"ل",1,0],["وَأَنضوا إِلَيهِ كُلَّ جَأبٍ هَمَلَّعٍ","تُعارِضُهُ وَجناءُ كَالفَحلِ عِرمِسُ",77,"س",1,0],["وأنضَرَهُمْ وأطهرَهمْ ذُيولاً","وأمضاهمْ وأقضاهمْ ديونا",78,"ن",2,0],["وأَنْضمت عطاياه السُّرى لِعُفاتِه","فتِلْك العطايا لا يجِفُّ لها لبدُ",79,"د",1,0],["وإن ضيم ألم بنا فإنا","بتوفيق بن أحمد نستجير",80,"ر",1,0],["وَإن ضنَّ الغَمامُ فَراحَتاهُ","أبَرُ بِسائِليهِ مِنَ الغَمامِ",81,"م",1,0],["وإن ضاقت جِهاتُ الرِّزقِ أمسَى","فِراشُ ضُيُوفِهِ خُلُقاً وَسيعا",82,"ع",2,0],["وإن ضقت ذرعاً بالحياة لفاقة","فلي سعة من فضله وامتنانه",83,"ن",2,0],["وَإِن ضَرَبت ذَلِكَ الأَميرا","تَأخذ مِن فُلوسه كَثيرا",84,"ر",2,0],["وإن ضلت الاقوام عن منهج الهدى","فإنا بكم والحمد لله ارشدنا",85,"ن",2,0],["وإن ضلَّ لم يسمعْ مقالةَ واعظٍ","ولم يَقْفُ في دنياه دينا ولا شرعا",86,"ع",2,0],["وإن ضقت ذرعاً من تعاظم ما مضى","فلا تنس عفو اللَه فالعفو أرحب",87,"ب",1,0],["وانض الهموم فانها","خيل تشن على الوسن",88,"ن",1,0],["وإن ضقت ذرعا فأعمل العيس قاصدا","حمى المصطفى المختار فهو رحيب",89,"ب",1,0],["وَإنْ ضَحِكَتْ بِشْراً مَبَاسِمُ ثَغْرِهِ","رَأيْتَ وُجُوهَ السُّمْرِ كَيْفَ تُقَطِّبُ",90,"ب",1,0],["وإن ضاعف الدرع الكمي لحربه","ومثله في النفس مات توهما",91,"م",2,0],["وإن ضحكت أسنتهم تباكت","عيون جراح أعضاء المباري",92,"ر",2,0],["وَاِنضح بما في شؤنكَ اللّاتي هَمت","عَبراتُها تلك الطلول الهمّدا",93,"د",2,0],["وانضمّ منحازا مع الشهداء في","ذاك النعيم متوّجاً معهم كما",94,"م",2,0],["وانضم في عيد الظهور بلحدهِ","فاعجب لبدر قد خفي بظهور",95,"ر",1,0],["وَإِن ضَرَبَت بِلَحيَيها وَعامَت","تَفَصَّمَ عَنهما حَلقُ السِّفارِ",96,"ر",1,0],["وَإِن ضُنَّ بِالعِدّانِ كانَ قِراهُمُ","سَديفُ المَتالي لا عَتودٌ وَلا وَطبُ",97,"ب",1,0],["وإِنْ ضاقتِ الدُّنيا عليَّ وكُلُّها","إلى جُودٍ مَحْمودٍ فيُفرَجُ ضِيقُها",98,"ق",3,0],["وأنضو لثامًا على لحيتي","من الصبغ زورًا على منكر",99,"ر",1,0],["وإنّ ضلالي فيك أهدى من الهُدى","وإنّ سُهادي فيك أحلى من الكرى",100,"ر",2,0],["وَاِنضَح جَوانِبَ قَبرِهِ بِدِمائِها","فَلَقَد يَكونُ أَخا دَمٍ وَذَبائِحِ",101,"ح",1,0],["وَأَنْضَيْتُ ثَوْبَ الْهَوَى إِذْ دَنَا","إِليَّ النَّقَا وَالْتَمَسْتُ الدِّيَارَا",102,"ر",2,0],["وَإِن ضَنَّ صَوبُ المُزنِ يَوماً فَأَدمُعِي","تَنوبُ كَمَا نَابَ الجَمِيعُ عَنِ الفَردِ",103,"د",1,0],["وانضح من دم قلبي عليه","جفوني دماً ليس دمعاً مشوبا",104,"ب",2,0],["وأنضو على حكمِ الزمانِ وصرفه","شبابي ولا يُلْقي شبيبته الحِسْل",105,"ل",1,0],["وإن ضاعتْ لديك فأنتَ شمسٌ","يشبُّ تَعَسُّفي فيها الذُّيالا",106,"ل",2,0],["وانضح مِنْ الشيمه وفا دون تقْصير","واتبع جلالة شيمتي غصب وانقاد",107,"د",1,0],["وانضحي عنك ما مضى","واغسِلي اليومَ بالغَدِ",108,"د",1,0],["وأنَّ ضنكاً شفَّهم زالَ وال","صعابُ هانت وانجلى يذهبُ",109,"ب",1,0],["وإن ضاعت فلا عجبٌ لأنا","ليومك حافظونَ أجلَّ ذكرى",110,"ر",2,0],["وان ضربت بسهم في سبيل على","فكن معداً لها بالحزم أقواسا",111,"س",2,0],["وانض السرى حيث ترى بجلّق","تلك القصور البيض والجواشقا",112,"ق",2,0],["وإن ضللتُ يهديني","وإن مرضتُ يشفيني",113,"ن",2,0],["وان ضلوا به جهلاً فاني","أرى بك يا شريف الذات رشدي",114,"ي",1,0],["وإن ضاقَ صدري بأسرارهِ","وأودعتُهُ السرَّ لم يظهر",115,"ر",1,0],["وَإِن ضَرَبتَ بِهِ في وَجهِ نائِبَةٍ","فَفي يَمينِكَ مِنهُ صارِمٌ ذَكَرُ",116,"ر",1,0],["وإن ضحك البرق الشئامي أسبلت","جفوني بمنهل من الدمع هامر",117,"ر",1,0],["وَأنضب الزاخر القصوى سِواحله","ما لِلنَواتي بِأَن تَجتازه طَمع",118,"ع",1,0],["وَإِن ضَرب الظَلام علَيهِ سجفا","تَبدل ثَوب عزَّتهِ خُضوعا",119,"ع",2,0],["وإن ضلَّ ذو فكر فأنت حكيمها","وإن فُهَّ ذو قول فأنت خطيبها",120,"ب",3,0],["وانضم إلى صدر كالعطبه","وآفك الازرار والغانه",121,"ن",2,0],["وَإِن ضَنَّ السَحاب فَدَمعُ عَيني","لَكُم مِن دُون عارِضهُ قُطار",122,"ر",1,0],["وإنْ ضَرَبْتُ رِواقاً دونَ حُرْمَتِهِ","فإنَّها سُتُري مُدَّتْ عَلَى حُرَمِي",123,"م",2,0],["وإن ضيقوا منك الخناق فربما","تسوء على الأسماع نغمة منشد",124,"د",1,0],["وَإِن ضَيَّعَ الإِخوانُ سِرّاً فَإِنَّني","كَتومٌ لِأَسرارِ العَشيرِ أَمينُ",125,"ن