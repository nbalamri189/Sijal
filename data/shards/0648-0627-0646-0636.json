{"poems":[[53,"ألا ليت أذيال الغيوث السواجم","https://www.aldiwan.net/poem29766.html","الطويل"],[53,"أودع في كل يوم حبيبا","https://www.aldiwan.net/poem30733.html","المتقارب"],[53,"لأظما معلينا وأروى المصائبا","https://www.aldiwan.net/poem30735.html","الطويل"],[53,"خطوب لا يقاومها البقاء","https://www.aldiwan.net/poem30775.html","الوافر"],[63,"بني جشم ردوا فؤادي إنه","https://www.aldiwan.net/poem45683.html","الطويل"],[63,"خضاب على فودي للدهر ما نضا","https://www.aldiwan.net/poem46185.html","الطويل"],[77,"أبشر فقد نلت ما ترجو على عجل","https://www.aldiwan.net/poem36369.html","البسيط"],[77,"شغلت بيوم العرض عمن وسيلتي","https://www.aldiwan.net/poem36548.html","الطويل"],[42,"إذا أرسلت في أمر رسولا","https://www.aldiwan.net/poem50245.html","الوافر"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[86,"شجتنا مطالع أقمارها","https://www.aldiwan.net/poem68866.html","المتقارب"],[23,"عيني جودا على فارس","https://www.aldiwan.net/poem21497.html","المتقارب"],[72,"من عذيري من الطلا والأغاني","https://www.aldiwan.net/poem20180.html","الخفيف"],[51,"لغيرك لا لك التفسير أنى","https://www.aldiwan.net/poem8330.html","الوافر"],[51,"تلون أخلاق الفتى من ملاله","https://www.aldiwan.net/poem65972.html","الطويل"],[38,"ألم تسأل بعارمة الديارا","https://www.aldiwan.net/poem7721.html","الوافر"],[78,"أرية أنت فائدة الزمان","https://www.aldiwan.net/poem14271.html","الوافر"],[58,"صن النفس واحملها على ما يزينها","https://www.aldiwan.net/poem30912.html","الطويل"],[80,"فؤادي نجيب والجلال نجيب","https://www.aldiwan.net/poem31549.html","الطويل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"حميت لواء الملك فارتد طالبه","https://www.aldiwan.net/poem43425.html","الطويل"],[81,"أصيخوا فمن طور الهدى انبعث الندا","https://www.aldiwan.net/poem61537.html","الطويل"],[22,"آثرت إدلاجي على ليل حرة","https://www.aldiwan.net/poem21644.html","الطويل"],[46,"يرومك والجوزاء دون مرامه","https://www.aldiwan.net/poem23642.html","الطويل"],[68,"ما بين معترك الأحداق والمهج","https://www.aldiwan.net/poem1488.html",""],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42565","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142048","الرمل"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50447","الطويل"],[77,"شغلت بيوم العرض عمن وسيلتي","https://www.poetsgate.com/ViewPoem.aspx?id=33924",""],[90,"الملك حسين","https://www.poetsgate.com/ViewPoem.aspx?id=179040",""]],"verses":[["وَإِن ضافَهُ الهَمُّ النَزيعُ رَمى بِها","نَزائِعَ لا يُعلَفنَ غَيرَ الشَكائِمِ",0,"م",1,0],["وَإِن ضَرايحَكُم في الصَعيدِ","لَتَكسو الخَبيثَ مِنَ الأَرضِ طيبا",1,"ب",2,0],["وَإِن ضاقَ صَدرُ الخَطبِ وَسَّعَ بِأَسُهُم","لِسُمرِ القَنا بَينَ الضُلوعِ مَذاهِبا",2,"ب",2,0],["وَأَنضَينا المَدى طَرَباً وَهَمّاً","فَما بَقِيَ النَعيمُ وَلا الشَقاءُ",3,"ا",2,0],["وإِن ضلَّ عنكم فانشدوهُ على الحِمى","فثَمَّ مكانٌ مِن فؤاديَ لا يَخلو",4,"و",1,0],["وإن ضِقْتُ ذَرْعاً بالمُنى فرَحيبَةٌ","بِها خُطُواتُ الأرحَبيّةِ والفَضا",5,"ض",2,0],["وَأَنْضَرُ الَّرْوضِ أَضْحَى وَهْوَ مُصْطَبِحٌ","وَالْغُصْنُ قَدْ مَالَ مَيْلَ الشَّارِبِ الثَّمِلِ",6,"ل",1,0],["وإنْ ضاقَ وُسْعي عنْ قِيامي ببَعْضِها","فَما ضاقَ عنْ عُذْرٍ لَها وُسْعُ مَجْدِهِ",7,"د",2,0],["وَإِن ضَيَّعتَ ذاكَ فَلا تَلُمهُ","عَلى أَن لَم يَكُن عَلِمَ الغيوبا",8,"ب",2,0],["وانضَمَّ للجُند يَمشي تحتَ رايَتِه","وبالحياةِ إذا مالَتْ يُفَدِّيها",9,"ي",3,0],["وَأَنَّ ضَمائِرَ هَذا الوُجودِ","تَبوحُ إِلَيكَ بِأَسرارِها",10,"ر",3,0],["وَإِن ضاقَ بِالمَوتِ صَدرُ اِمرِئٍ","فَصَدرُكَ بِالمَوتِ لَم يَحرَجِ",11,"ج",1,0],["وانْضحا من دمِي عليهِ فقد كا","ن دمِي من نداه لو تعلمان",12,"ن",1,0],["وإن ضلوا فمُرشدُهُم قريبٌ","وإن سألوه ألفوه يجيبُ",13,"ب",1,0],["وإنْ ضنَّ دهرٌ مرةً بعطيةٍ","تناولني في ضِيقتي بنواله",14,"ل",2,0],["وَأَنضاءٍ أُنِخنَ إِلى سَعيدٍ","طُروقاً ثُمَّ عَجَّلنَ اِبتِكارا",15,"ر",2,0],["وَأُنضيَتِ الصَوارِمُ خاطِياتٍ","فَكانَ قَضاؤها سِحرُ البَيانِ",16,"ن",1,0],["وَإِن ضاقَ رِزقُ اليَومِ فَاِصبِر إِلى غَدٍ","عَسى نَكَباتِ الدَهرِ عَنكَ تَزولُ",17,"ل",1,0],["وإن ضاقَ بالحرِّ المجالُ ببلدةٍ","فكمْ بلدَةٍ فيها المجالُ رحيبُ",18,"ب",1,0],["وإن ضاعَ التعاونُ في أُناسٍ","عَفتْ آثارُهم في الضّائعينا",19,"ن",2,0],["وَإِن ضَجَّ ما بَين القَواضبِ هالكٌ","أَرنَّت وَراءَ الخَيلِ شُعثاً تُجاوِبُهْ",20,"ب",2,0],["وَإِن ضَحِكَت سِنُّ الهُدى عَن إِمارَةٍ","فَعَنكُم وَعَن أَيّامُكُم يَضحَكُ الهُدى",21,"د",2,0],["وَإِن ضُرِبَت بِالسَوطِ صَرَّت بِنابِها","صَريرَ الصَياصي في النَسيجِ المُمَدَّدِ",22,"د",1,0],["وإنْ ضُرِبَتْ أطْنابُه بتَنُوفَةٍ","نَأى الضّبُّ عنها خِيفَةً من عُرامهِ",23,"م",2,0],["وإن ضَلِلْتُ بلَيْلٍ من ذوائِبهِ","أهدى لعيني الهدى صُبحٌ من البَلجِ",24,"ج",1,0],["وَإِنْ ضَاحَكَتْهَا الشَّمْسُ رَفَّتْ كَأَنَّهَا","مَنَاصِلُ سُلَّتْ لِلضِّرَابِ مِنَ الْغِمْدِ",25,"د",1,0],["وانضحوا من دمعة اليوم على","سجفِ النعشِ ومن عزّة أمس",26,"س",1,0],["وإن ضُرِبَتْ دونَ الخليجِ خِيامُه","فَمِنْ خَلفِهِ للرُّعْبِ جَيْشٌ مُخَيِّمُ",27,"م",1,0],["وإن ضاق وسعي عن قياسي ببعضها","فما ضاق عن عذر لها وسع مجده",28,"د",2,0],["وإن ضاعفتَه مسحةُ الحزن رَونقاً","فمن فضلِ أشجان أخذْن بمخنِقي",29,"ق",2,0]]}