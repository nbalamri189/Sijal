om/ViewPoem.aspx?id=192349",""],[5539,"هامة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=192687",""],[5561,"الحوار الأول","https://www.poetsgate.com/ViewPoem.aspx?id=202041",""],[5573,"عديت لك سبعين بارق وشديت","https://www.poetsgate.com/ViewPoem.aspx?id=205474",""],[5573,"الا هُبي بغيثكِ فامطرينا","https://www.poetsgate.com/ViewPoem.aspx?id=215491",""],[5582,"لِمَنْ بِطُلُولِ الأَبْرَقَيْنِ مُقامُ","https://www.poetsgate.com/ViewPoem.aspx?id=187300",""],[5628,"ميادة الحناوي تألق دائم *","https://www.poetsgate.com/ViewPoem.aspx?id=182932",""],[5652,"كنتي وطن","https://www.poetsgate.com/ViewPoem.aspx?id=168821",""],[5664,"حفيف الجرح","https://www.poetsgate.com/ViewPoem.aspx?id=176687",""],[5725,"قولي لحسنك","https://www.poetsgate.com/ViewPoem.aspx?id=192489",""],[5745,"من وحي مهرجان بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=200061",""],[5751,"كل ما فيها يُغنّي","https://www.poetsgate.com/ViewPoem.aspx?id=215018",""],[5782,"تفاعل القصائد بالقوافي","https://www.poetsgate.com/ViewPoem.aspx?id=185762",""],[5813,"هذا خيالي","https://www.poetsgate.com/ViewPoem.aspx?id=176823",""],[5956,"أنا همت يا لبنى بحبك ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181935",""],[5956,"ماذا أقول لمن أردتُ زواجها؟","https://www.poetsgate.com/ViewPoem.aspx?id=182522",""],[5956,"الشر فينا منذ قابيلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=192436",""],[5956,"هنالك في عمق السعود كواكب","https://www.poetsgate.com/ViewPoem.aspx?id=193362",""],[5956,"وقى الله بيته شر الحريقْ","https://www.poetsgate.com/ViewPoem.aspx?id=194149",""],[5961,"الى حي المليحة سر","https://www.poetsgate.com/ViewPoem.aspx?id=199805",""],[5977,"مجنون ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=213250",""],[6259,"خليليَّ هل من رقدة أستعيرها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59381&r=&rc=29",""],[276,"إليهِ بهِ سبحانهُ أتوسلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59268&r=&rc=7",""],[4228,"قلب الفيلسوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69253&r=&rc=7",""],[5064,"شروحُ الفتوح على أسانيد بلقيس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87507&r=&rc=2",""]],"verses":[["وَأَحيا بِها لَكَ مَيتَ العُلى","وَأَردى بِها كُلَّ عابٍ وَعارِ",0,"ر",1,0],["وَأَحيَيتُ القُنوعَ وَكانَ مَيِّتاً","فَفي إِحيائِهِ عِرضٌ مَصونُ",1,"ن",1,0],["وأحْيَيْتَ للدّينِ الحَنيفِ شَرائِعاً","بأنْصارِ دينِ اللهِ تُحْيَى الشّرائِعُ",2,"ع",1,0],["وأحْيَى أبا يَحْيَى لعَيْنِكَ قُرّةً","قَريعُكَ في حَزْمٍ وعزْمٍ وسُؤدَدِ",3,"د",1,0],["وأحْيَى رُسومَ الفَضْلِ وهْيَ دَوارِسٌ","وأطْلَعَ منْ نورِ الهِدايَةِ ما يَهْدي",4,"د",2,0],["وأحْيَيْتَ آثارَ الخَلائِفِ سابِقاً","جِيادَ المَدى فِيما تُعيدُ وما تُبْدي",5,"د",2,0],["وَأَحييتَ مَن قَد كانَ مَوَّتَ مالَهُ","فِإِن مُت مَن يُدعى لَهُ فَيُجِيبُ",6,"ب",1,0],["وَأَحيا مِن مُخَبَّأَةٍ كَعابٍ","وَأَشجَعَ مِن أَبي شِبلٍ هِزَبرِ",7,"ر",1,0],["وَأَحيا بِبَلدَتِهِ بَلدَةً","عَفَت بَعدَ أَن قَد عَفاها الصَرى",8,"ر",2,0],["وأحييت يا يحيى بها نفس مغرم","يجيل جيادَ الدمع في ملعب السعدِ",9,"د",1,0],["وأحيت لشرق الشامِ وقت مسرةٍ","يصدّ كرى الأجفان فيه عن الغرب",10,"ب",1,0],["واحيلتي بظلام الطرَّة الدَّاجي","واشقوتي بنعيم الملمس العاجي",11,"ج",2,1],["وأحييت للآدابِ علماً ومعلماً","بنعماء تقري بالفوائدِ أو تقرِي",12,"ر",2,0],["واحْيى كما شئت يا ابن يحيى","في رُتبِ البرّ والإشاره",13,"ر",2,0],["وأحييت منه ومن لفظه","لمن قد يرى رمق الرامق",14,"ق",1,0],["وأحييتَ بالعزِّ عمَّالَها","ودرَّعتَها فيه جِلبابَها",15,"ب",3,0],["وأحيَيْتُمْ دينَ الصَّليبِ وقمْتُمُ","بتشيِيد أعْمارٍ وهدْمِ مساجدِ",16,"د",1,0],["وأحييتَ موتى الشعر بعد فنائها","وربَّ مسيحٍ لم تناسبه مريمُ",17,"م",1,0],["واحيائي أن لا يكون من اللَّ","هِ حيائي من غيره واحتشامي",18,"م",2,0],["وا حيائي منهُمْ إذا ما التقينا","وهُمُ عند حاكم الحُكّام",19,"م",1,0],["وا حيائي من النَّبيِّ إذا ما","لامني فيهم أشدَّ الملام",19,"م",1,0],["وَأَحيا المُنى في فُؤادِ الفَتى","وَرَدَّ إِلى الشَيخِ عَهدَ الصِبى",20,"ب",2,0],["وَأَحيا رَغائِبَنا الذابِلاتِ","فَعاشَت وَكانَت كَأَرضٍ مَوات",21,"ت",1,0],["وَأَحياناً تَواني سَي","رَها ساكِنَةَ الظِلِّ",22,"ل",1,0],["وَاحيرَةَ الصَبُّ الَّذي","لَم يَدرِ بَعدَكَ ما اِحتِيالُه",23,"ل",2,0],["وَأَحيا حُمَيداً عِزُّهُ وَإِباؤُهُ","وَنَجدَتُهُ وَجودُهُ وَفَوائِدُه",24,"د",2,0],["وَأَحياناً يُؤَخِّرُهُ","وَتاراتٍ يُعاجِلُهُ",25,"ل",2,0],["وَأَحيَيتَ أَثارَ الشَهيدِ بِنائِلٍ","مَعَ الناسِ مِنهُ سائِقٌ وَشَهيدُ",26,"د",1,0],["وأحيِّي ناصعَ الصب","ح وأهديه السلامَا",27,"م",2,0],["واحيرتي تُرى أصُبُّ الطِّلى","أم أنني فيه أصبّ النحيب",28,"ب",1,0],["وَأَحيا سَبيلَ العَدلِ بَعدَ دُثورِهِ","وَأَنهَجَ سُبلَ الجودِ حينَ تَعَفَّتِ",29,"ت",1,0],["وأحييتَها بالدرسِ بعدَ اندراسِها","وصارَ لذكرِ اللهِ في ربعها جَهْرُ",30,"ر",1,0],["وَأَحيا قِيامُكَ لَيلَ التَمامِ","وَأَحيا نَداكَ الثَرى المُمحَلا",31,"ل",2,0],["وَأَحيا حَياةً بَعدَ سَلمى مَريضَةً","لَها عاذِلٌ في حُبِّ سَلمى وَعاذِرُ",32,"ر",1,0],["وأحْيَتِ السُنَّةُ الشَهْبَاءُ دَعْوتُهُ","حتى حَكضتْ غُرَّةَ في الأعْصُرِ الدُّهُمِ",33,"م",1,0],["وَأُحَيِّيهِ إِلى أَن","مالَ مِن ثِقلِ النُعاسِ",34,"س",1,0],["وَأَحيانِيَ اللَهُ القَديرُ مَلاوَةً","فَهَلّا بِخَوفِ اللَهِ أَقطَعُ أَحياني",35,"ن",2,0],["وأحيّيكِ وأستحْيِي فماً","حَقُّهُ قُبْلَةُ رَبٍّ غافرِ",36,"ر",1,0],["وإحْيَاءٌ لأمْجَادِ الأوَالى","وأقوال تُعَزِّزُها فعَال",37,"ل",1,0],["وأحيا أبا يحيى لعينك قرة","قريعك في حزم وعزم وسؤدد",38,"د",1,0],["وأحييت للدين الحنيف شرائعا","بأنصار دين الله تحيا الشرائع",39,"ع",1,0],["وأحيى رسوم الفضل وهي دوارس","وأطلع من نور الهداية لمن يهدي",40,"د",2,0],["وأحييت آثار الخلائف سابقا","حياد المدى فيما تعيد وما تبدي",41,"د",2,0],["وأحيّيك وأيتحيي فما","حقّه قبلة ربّ غافر !!",42,"ر",1,0],["وأَحْيت السَنَةَ الشَّهباءَ دَعوَتُهُ","حتى حَكَتْ غُرَّةً في الأَعصُرِ الدُّهُمِ",43,"م",1,0],["واحيت القوم خلات وقد قتلت","اهل المروآت للمجد المروآت",44,"ت",1,0],["وإحيَاءِ اللَّيَالِى اللِّيَلِ دَاباً","بِصَادقِ نِيَّةٍ فِيهَا تَمِيمِ",45,"م",1,0],["وإحيَاءِ الأوَامِرِ بالتَّلَقِى","لَهَا بِمَسَرَّةش الدِّينِ الصَّمِيمِ",45,"م",1,0],["وإحيَاءِ البُديعَة والهوُوينَا","وإظهارِ العُوَيرَة بالجُهَيلِ",46,"ل",1,0],["وأحيا مهجة ذابت غراماً","مليح في الأنامِ بلا شبيهِ",47,"ي",2,0],["وأحْيِ من الأخلاق ما حم يومهِ","وحلّ بحكم الدور في عالم الرمسِ",48,"س",1,0],["وأحيوا بهذا العصر لهجة قومكم","فليس على نسيانها يحسن الصبرُ",49,"ر",1,0],["وَا حَيائي مِنَ العُيونِ إِذا ما","عايَنَتْني في هذهِ الأَسْلابِ",50,"ب",1,0],["وأحييتَ السخا واخترتَ منهُ","سخاء لا يدنسهُ سؤالُ",51,"ل",1,0],["وأحييت عدلاً مات واندرسَ اسمه","ولم يبق من آثاره في الورى رسمُ",52,"م",1,0],["وأحي بيحيى من تحت حياته","وأهلكّ به أهل الضلالة والأغوا",53,"ا",1,0],["وأحيا ليالي الصوم منكم بفتية","منيبين فيها للصلاة وللذكر",54,"ر",1,0],["وَأَحيَيتَ رُوحَ الجُودِ مِن بَعدِ ما قَضى","وَرَدَّ عَلَيهِ التُربَ حاثٍ وَهائِلُ",55,"ل",1,0],["وَأَحيا خِلالاً سَنَّها في زَمانِهِ","قُصَيٌّ أَبو ساداتِها وَالبَراجِمِ",56,"م",1,0],["وَأَحيا رُواتَ مِن بَني القَينِ تِسعَةً","وَكانَ عَلى تِلكَ الأَلِيَّةِ مُقسِما",57,"م",2,0],["وأحيا عزيزا لا أرى متعرضا","ورزقي يأتيني بغير سؤال",58,"ل",1,0],["وأحيا بفضل ميت الأرض بالحيا","وزينها من بعد ذل بالصحو",59,"و",1,0],["وَأَحيا مِن رُسومِ مَعا","لِمَ الإيمانِ ما طَمَسا",60,"س",2,0],["وأحييتَ شعباً صارَ في نكباتهِ","يرى القبرَ مهداً والنّذيرَ مُبشِّرا",61,"ر",2,0],["واحيا منار الدين في كل وجهة","وَذب عَن الاسلام بالسَيف وَالرمح",62,"ح",1,0],["واحيي مَغاني","ربع لَيلى شَفاها",63,"ا",3,0],["وأَحيا نَواحي الأَرض من بعد مَوتِها","بمنسجم غيث من السحب يهمل",64,"ل",1,0],["وَأَحْي مَا طَمَستْ مِنْهُ العُداةُ كَمَا","أَحيَيْتَ مِن دَعوَةِ المَهْدِيِّ ما طُمِسا",65,"س",2,0],["وأَحي بالراح أَشباحاً معطَّلةً","فإنَّما هي للأَشباح أَرواحُ",66,"ح",1,0],["وَأَحيِهِ لَكَ مُسلِماً","وَتوفِهِ بِكَ مُؤمِنا",67,"ن",2,0],["وأحياء ىنا من الدهر قد مضت","ضياعاً وكانت موسماً للرغائب",68,"ب",1,0],["وأحيلاه وألطفه","رائق الإقبال والقبل",69,"ل",1,0],["وَأَحيا بكَ الإحسانَ والعدلَ والهدى","وَإِيتاء ذي القربى وَأَردى بك النكرا",70,"ر",2,0],["وَأحييته من موتَتيهِ فكادَ أن","يَرى جدّ ما أوليت من عظم دعبا",71,"ب",2,0],["وَأَحيَيتَ بَيتَ المالٍ بَعدَ مَواتِهِ","فَأَصبَحتَ الوِراثَ تَشكُرُ أَفضالَك",72,"ك",1,0],["وَأَحيَيتَ العَطاءَ وَكانَ مَيتاً","وَلَولا اللَهُ ما حَيِيَ العَطاءُ",73,"ا",2,0],["واحَيرَتي عَنكَ إِذا لَم تَزِد","ني حَيرَتي فيكَ بِنورِ الدَليل",74,"ل",1,1],["وَاِحيرَتي اِن أَقل صلني بِصول وَاِن","أَرضَيتُه صَدّ أَولا يَنته شمخا",75,"خ",2,0],["وَأَحيَيتَ حَمداً كانَ بِالأَمسِ بائِداً","وَأَغلَيتَ شِعراً كانَ قَبلَكَ بائِرا",76,"ر",2,0],["وا حيْرتي إن فاز أقْراني غَداً","وَوَقَفتُ وَحْدي وقفَة المتحيرِّ",77,"ر",1,0],["وأحيا لي صفيُّ الدين فيها","من التحقيق ما قد كان أنسي",78,"س",2,0],["وأحيا رسوم الهدى والتقى","وجدد ما عمه قد خرب",79,"ب",1,0],["وأحييتَ بالآلاءِ أَموات طيىءٍ","بِذِكرِك مِن قَبل النُشورِ نُشورُها",80,"ر",3,0],["وأَحْيَيْتَ اسمَه من بعد موتٍ","وكانَ يُعَدُّ من أهل القبور",81,"ر",1,0],["وأَحْيَيْتَ رمَّةَ علم النبيّ","وقبلك كانتْ عظاماً رميما",82,"م",2,0],["وأحْيَيْتَ من أرض العراق علومَه","ولولاك كانَ الأَمر يا سيِّدي سدى",83,"د",2,0],["وأحيا بالعمارة كلَّ أرضٍ","وأجرى في ضواحيها المياها",84,"ا",3,0],["وأحيا دروس العلم في علم درسه","بدت فيه آثار الفضائل مذ بدا",85,"د",2,0],["وأَحيي بِرُوحِ الرّاحِ جِسْمَ زُجَاجةٍ","على يدِهِ منها قديمٌ وحادثُ",86,"ث",1,0],["وأَحيَيْتَ فِي الأَرضِ فَضْلاً وعدلاً","وعطفاً وعُرفاً ودُنيا ودِينا",87,"ن",2,0],["وَأُحْيِي نُفُوسَ الرَّكْبِ من مِيتَةِ الكَرى","وَقَدْ عَطَفَ الليلُ التَّمامُ طُلاها",88,"ا",3,0],["وأحيانا نهددهم","وأحيانا ذوو رحم",89,"م",1,0],["وأحياناً مَشاهدَ رائعاتٍ","وأطوارَ المعارِك والممات",90,"ت",1,0],["واحينا فضلاً حياةً بسلام","من دواهي الدهر يا مولى الأنام",91,"م",1,0],["وأحيا طريق الحقِّ بعد اندراسه","واترع في آيات حكمته الكتبا",92,"ب",2,0],["وأحياء كساها الحسن ثوبا","به انتظمت عقود الزهر نظما",93,"م",2,0],["وإحيا موات النفس بالذكر واجبٌ","ليسعد فيها بالحراثة زارع",94,"ع",1,0],["وأَحْيَيْتُ أَسْلافِيَ الأَقدمين","فقاموا وهم يَنْفُضُون اللِّمَم",95,"م",1,0],["وأَحييتَ فيها الدِّينَ بعد مَماتِه","فأَنْتَ ابْنُ يعقوبٍ وأَنت ابنُ مَرْيَما",96,"م",2,0],["وأَحْيَا صَبيحُ الْحَيَا نَشْرَهَا","فَأَصْبحَ مَيِّتهُ يُنْشرَ",97,"ر",1,0],["وأَحيا تَميمٍ في لَقيطِ وَحاجِبِ","وأحيا قُرَيشٍ في قُصَيّ وَهاشِم",98,"م",1,0],["وأحيانه أنوار أحيان فترة","عليك بروح للعلا مستعدة",99,"ه",1,0],["وأحيا نداه رياض 