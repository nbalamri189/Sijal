{"poems":[[53,"إلى أين مرمى قصدها وسراها","https://www.aldiwan.net/poem29634.html","الطويل"],[53,"خطوب لا يقاومها البقاء","https://www.aldiwan.net/poem30775.html","الوافر"],[63,"وحي من بني جشم بن بكر","https://www.aldiwan.net/poem45693.html","الوافر"],[55,"تجافى مرفقاي عن الوساد","https://www.aldiwan.net/poem26422.html","الوافر"],[77,"ألحظك أم سيف عمرو أعيدا","https://www.aldiwan.net/poem36612.html","المتقارب"],[35,"حي المنازل قد عفت أطلالها","https://www.aldiwan.net/poem39103.html","الكامل"],[30,"أللربع ظلت عينك الماء تهمل","https://www.aldiwan.net/poem29546.html","الطويل"],[88,"أرى الحسن في لبنان أينع غرسه","https://www.aldiwan.net/poem44445.html","الطويل"],[37,"الا حييت عنا يا مدينا","https://www.aldiwan.net/poem7642.html","الوافر"],[23,"بنى اللؤم بيتا على مذحج","https://www.aldiwan.net/poem21454.html","المتقارب"],[51,"قل للألى حرموني إذ مدحتهم","https://www.aldiwan.net/poem65042.html","البسيط"],[51,"لما تؤذن الدنيا به من شرورها","https://www.aldiwan.net/poem65430.html","الطويل"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[91,"ليطرب من شاء أن يطربا","https://www.aldiwan.net/poem8759.html","عموديه"],[85,"أقدم فليس على الإقدام ممتنع","https://www.aldiwan.net/poem63762.html","البسيط"],[43,"أغالب فيك الشوق والشوق أغلب","https://www.aldiwan.net/poem9508.html","الطويل"],[43,"رويدك أيها الملك الجليل","https://www.aldiwan.net/poem9757.html","الوافر"],[43,"ما أجدر الأيام والليالي","https://www.aldiwan.net/poem10139.html","الرجز"],[45,"عذيري فيك من لاح إذا ما","https://www.aldiwan.net/poem65672.html","الوافر"],[45,"سقى دار ليلى حيث حلت رسومها","https://www.aldiwan.net/poem65675.html","الطويل"],[45,"قد فقدنا الوفاء فقد الحميم","https://www.aldiwan.net/poem65689.html","الخفيف"],[45,"بعينك لوعة القلب الرهين","https://www.aldiwan.net/poem66785.html","الوافر"],[28,"ألستم عائجين بنا لعنا","https://www.aldiwan.net/poem5607.html","الوافر"],[66,"ألست ترى ما في العيون من السقم","https://www.aldiwan.net/poem41585.html","الطويل"],[74,"برعت فرعت فمن ذا حبيب","https://www.aldiwan.net/poem12875.html","المتقارب"],[105,"منايا القوم في جلد البعير","https://www.aldiwan.net/poem44061.html","الوافر"],[105,"أعدي النمل خيبر والذبابا","https://www.aldiwan.net/poem44062.html","الوافر"],[39,"ألا إن سلمى عن هوانا تسلت","https://www.aldiwan.net/poem53811.html","الطويل"],[75,"قفا فلأمر ما سرينا وما نسري","https://www.aldiwan.net/poem69081.html","الطويل"],[75,"ألا كل آت قريب المدى","https://www.aldiwan.net/poem69106.html","المتقارب"],[48,"رأيت قدور الناس سودا من الصلى","https://www.aldiwan.net/poem63379.html","الطويل"],[48,"عجبت لهارون الإمام وما الذي","https://www.aldiwan.net/poem64450.html","الطويل"],[48,"ودهماء ترسيها رقاش إذا شتت","https://www.aldiwan.net/poem65046.html","الطويل"],[46,"هل يفرح الناعب الغداف بسقيا ال","https://www.aldiwan.net/poem22913.html","المنسرح"],[68,"شربنا على ذكر الحبيب مدامة","https://www.aldiwan.net/poem1525.html",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16634","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54793","الوافر"],[90,"لعبة التجارب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66767&r=&rc=175",""],[130,"يا صاحبي لقد غفا","https://www.aldiwan.net/poem67428.html","مجزوء الكامل"],[151,"بحمد الله يفتتح الكلام","https://www.aldiwan.net/poem68494.html","الوافر"],[151,"حروب النوى والقرب فيك سجال","https://www.aldiwan.net/poem68535.html","الطويل"],[151,"أصفيتك الود مضطرا ومختارا","https://www.aldiwan.net/poem68542.html","البسيط"],[161,"شممت نسيما من وصالك لوهبا","https://www.aldiwan.net/poem58997.html","الطويل"],[170,"أظنك خلت الشوق والنأي أبكاني","https://www.aldiwan.net/poem1684.html",""],[170,"تخفي الصبابة والألحاظ تبديها","https://www.aldiwan.net/poem1690.html",""],[182,"أشاقتك الهوادج والخدور","https://www.aldiwan.net/poem58780.html","الوافر"],[182,"هل القلب عن ذكرى أميمة ذاهل","https://www.aldiwan.net/poem59086.html","الطويل"],[186,"يا ساحل الثغر كم أنأى وأغترب","https://www.aldiwan.net/poem14110.html","البسيط"],[186,"هل المجد إلا دون ما أنت رافع","https://www.aldiwan.net/poem14573.html","الطويل"],[190,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[205,"ولو جمل السقاية لقبوه","https://www.aldiwan.net/poem53055.html","الوافر"],[230,"سقى السفح من دير القصير إلى النهر","https://www.aldiwan.net/poem51045.html","الطويل"],[238,"أجزتكم مروينا مطلقا","https://www.aldiwan.net/poem18839.html","السريع"],[250,"أنية الغداة أم انتقال","https://www.aldiwan.net/poem2099.html","الوافر"],[263,"أبعد الخيل أركبها ورادا","https://www.aldiwan.net/poem68196.html","الوافر"],[306,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[306,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[306,"أعيذ صفاء الود من كدر العتب","https://www.aldiwan.net/poem56604.html","الطويل"],[350,"ليت حادي مطيهم يوم سار","https://www.aldiwan.net/poem15718.html","الخفيف"],[354,"دعوني بين ندمان وساقي","https://www.aldiwan.net/poem40026.html","الوافر"],[365,"قليل لهم أن يحن المشوق","https://www.aldiwan.net/poem60831.html","المتقارب"],[366,"ونحن هزمنا جيش صعدة بالقنا","https://www.aldiwan.net/poem44504.html","الطويل"],[367,"كلفت بتعنيفي بلا طلب عذري","https://www.aldiwan.net/poem17192.html","الطويل"],[372,"إذا ما عقد الكاتم","https://www.aldiwan.net/poem57155.html","الهزج"],[407,"تعاتب سعدى أن تنقل دارها","https://www.aldiwan.net/poem50172.html","الطويل"],[410,"وما سكنت نفسي إلى الصبر عنكم","https://www.aldiwan.net/poem32326.html","الطويل"],[438,"هناء أيها الملك السعيد","https://www.aldiwan.net/poem2544.html","الوافر"],[438,"أقيموا عمود الدين للّه تسعدوا","https://www.aldiwan.net/poem2621.html","الطويل"],[459,"أما وهواها عذرة وتنصلا","https://www.aldiwan.net/poem55919.html","الطويل"],[462,"إذا المرء لم يستخلص الحزم جنة","https://www.aldiwan.net/poem15140.html","الطويل"],[465,"أعيا وقد عاينتم الآية العظمى","https://www.aldiwan.net/poem3135.html","عموديه"],[480,"عتاب يا حطيئة أم هجاء","https://www.aldiwan.net/poem37174.html","الوافر"],[552,"لعل زمانا بالثوية راجع","https://www.aldiwan.net/poem47727.html","الطويل"],[552,"هل هاج شوقك صوت الطائر الغرد","https://www.aldiwan.net/poem47848.html","البسيط"],[552,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[576,"غريمي ولكنه الماطل","https://www.aldiwan.net/poem3034.html","المتقارب"]],"verses":[["وَلَو جَمَعَت لَونَينِ بُذلُ شِباكِها","لَطالَبَها الراجي بِمَنعِ جَناها",0,"ا",3,0],["وَلَو جاهَرتَهُ بِالبَأسِ يَوماً","لَأَبرَأَ ذَلِكَ الجَرَبَ الهِناءُ",1,"ا",2,0],["وَلَو جاوَرتهم لَنُشِغْتَ كِبراً","يُخَيِّمُ بَينَ جيدِكَ وَالنِّجادِ",2,"د",1,0],["وَلَو جَدَّ القِلى لَرَحلتُ عَنها","وَلَم نَسكُن جَميعاً في بِلادِ",3,"د",1,0],["ولَوَجَدْتَ بالقُرْبِ بعْدَ النّوى","أعَدْتَ مُعنّاكَ خَلْقاً جَديدا",4,"د",2,0],["وَلَوَجهُهُ عِندَ المَسائِل إِذ غَدا","وَغَدَت فَواضِلُ سَيبِهِ وَنَوالُها",5,"ل",3,0],["وَلَو جُعِلَ الكورُ العِلافِيُّ فَوقَها","وَراكِبُهُ أَعيَت بِهِ ما تُحَلحِلُ",6,"ل",1,0],["ولو جاءه من فَيه مسّ وجنّة","لما حلّه إلاّ وقد زال مسّه",7,"س",2,0],["ولو جهَّزت قافية شروداً","لقد دخلت بيوت الأشعرينا",8,"ن",2,0],["وَلَو جَمَعَت ما حَوَت مَذحِجٌ","مِنَ المَدِ ما أَثقَلَ الأَرنَبا",9,"ب",2,0],["ولو جُدِعْتُ على أني مدحتُكُمُ","ما شانني شينَ مدحي فيكُمُ جَدَعي",10,"ع",2,0],["ولو جهد الساعون في الرزق جهدهم","لما وقعت إلا بما هي وُقَّع",11,"ع",1,0],["ولَوجهُ الأمير أحسُن مما","يكتسيه من وشيه الألوان",12,"ن",1,0],["وَلَو جازَ بَينَ الضُحى وَالدُجى","لَقاتَلَ فيهِ الضُحى الغَيهَبا",13,"ب",2,0],["وَلَو جَزَتكَ الصَحارى جِئتَنا مَلِكاً","مِنَ المُلوكِ عَلَيكَ الريشُ وَالوَدَعُ",14,"ع",1,0],["وَلَو جازَ أَن يَحوُوا عُلاكَ وَهَبتَها","وَلَكِن مِنَ الأَشياءِ ما لَيسَ يوهَبُ",15,"ب",1,0],["وَلَو جازَ الخُلودُ خَلَدتَ فَرداً","وَلَكِن لَيسَ لِلدُنيا خَليلُ",16,"ل",1,0],["وَلَو جَعَلتَ مَوضِعَ الإِلالِ","لاّلِئاً قَتَلتَ بِاللَآلي",17,"ل",2,0],["وَلَو جُمِعَ الأَئِمَّةُ في مَقامٍ","تَكونُ بِهِ لَكُنتَ لَهُم إِماما",18,"م",2,0],["وَلَو جَحَدَتهُ ذَلِكَ الحَقَّ لَم تَكُن","لِتَبرَحَ إِلّا وَالنُجومُ رُجومُها",19,"م",3,0],["وَلَوَجهُ البَخيلِ أَحسَنُ في بَع","ضِ الأَحايينِ مِن قَفا المَحرومِ",20,"م",1,0],["وَلَو جازَيتِ صَبّاً عَن هَواهُ","لَكانَ العَدلُ أَلّا تَهجُريني",21,"ن",2,0],["وَلَو جَدّاتُهُنَّ سَأَلنَ عَنّي","رَجَعنَ إِلَيَّ أَضعافَ السَلامِ",22,"م",1,0],["وَلَو جَحَدوا فِعلي مَخافَةَ شامِتٍ","لَنَمَّ عَلَيهِم في جِباهِهِمُ وَسمي",23,"م",2,0],["وَلَو جارَياكَ إِلى غايَةٍ","لَفُزتَ وَكانا مِنَ الخُيَّبِ",24,"ب",1,0],["ولو جَحَدُوهُ أقبلتِ المنايا","تُؤذِّنُ في الرقابِ وفي النُّحورِ",25,"ر",1,0],["ولو جَعلوا السَّحابَ لهم مَحَلّاً","لَطَارَ الجيشُ يَقتحِمُ السَّحابا",26,"ب",2,0],["وَلَو جَمَعَت يَوماً تَميمٌ جُموعَها","عَلى ذَرَّةٍ مَعقولَةٍ لَاِستَقَلَّتِ",27,"ت",1,0],["ولو جاد قومٌ بالنفوس سماحةً","لَما منعتْكُمْ شيمةُ الجود بالعمر",28,"ر",1,0],["ولو جاوَرَ العرَبَ الأقدمينَ","وفي الذاهبينَ وفَى مَنْ وَفى",29,"ا",1,0],["وَلَو جِئتَها مَلأى عَبيطاً مُجَزَّلاً","لَأَخرَجتَ مافيها عَلى طَرَفِ الظُفرِ",30,"ر",1,0],["وَلَو جاءَ غَيرُ البُخلِ مِن عِندِ جَعفَرٍ","لَما حَسِبَتهُ الناسُ إِلّا مِنَ الحُمقِ",31,"ق",1,0],["وَلَو جِئتَها مَلأى عَبيطاً مُجَزَّلاً","لَأَخرَجتَ ما فيها بِعودِ خِلالِ",32,"ل",1,0],["وَلَو جُزينا عَلى خَلائِقِنا","أَمسَكَ عَنّا الحَيا فَما نَقَطا",33,"ط",2,0],["ولو جُليتْ سِرّاً على أَكمَهٍ غَدا","بَصيراً ومن راووقِها تَسْمَعُ الصّم",34,"م",1,0],["ولو جرَتْ بالصفوِ أيامهُ","ما كانَ بالرَّازي ولا الناقمِ",35,"م",1,0],["ولو جرت النباهة في طريق ال","خمول إليَ لاخترت الخمولا",36,"ل",2,0],["وَلَوْ جَمَعَتْ عَبِيرَ الرَّوْضِ تَمْضِي","بِهِ النَّسَمَاتُ لَمْ تَجْمَعْ مرَادِي",37,"د",2,0],["ولو جَرَّبوا أهل المناصب وحدَهم","لهانَ ، ولكنْ جُربّوا في المناصب",38,"ب",1,0],["ولو جَمَعتَ بِسفكِ دم","ما أسخَفا",39,"ف",2,0],["ولو جازاك بالأعمال عدلاً","مكان الفضل عاجلك انتقام",40,"م",1,0],["ولو جاز لي دعوى السُّلِّو ادَّعيتُهُ","عزاءً ولكنَّ السّلو محال",41,"ل",1,0],["ولو جعلتُ كلامي روضةً أُنفاً","وصُغتُ أحرف خطّي فيه أزهارا",42,"ر",2,0],["ولو جاءه داع بطرس مزور","لقاسمه فيها الخراج الذي يجبا",43,"ب",2,0],["وَلَو جاءَهُ مُغتالُهُ مِن أَمامِهِ","لَراحَ أَكيلاً بَينَ نَسرٍ وَسِرحانِ",44,"ن",1,0],["وَلَو جَرى عِندَ أَهلِ السَبقِ في طَلقٍ","مِنَ البَلاغَةِ أَجلى عَن مُجَلِّيها",45,"ي",3,0],["وَلَو جاوَبتَنِى لَقَصَرتَ عَنِّى","وَأَنتَ عَنِ المَدَى نَاءٍ حَسِيرُ",46,"ر",1,0],["وَلَو جِئتُ أَستَسقى شَرَاباً وَعِندَهُ","عُيُونٌ رَوِيّاتٌ لَهُنَّ جَدَاوِلُ",47,"ل",1,0],["ولو جَرى نيلُها لي فضةً وغَدا","سفحُ المُقطَّم منها وهو لي ذهَب",48,"ب",1,0],["ولو جاد جَدْواها على الخَلْق لاغْتَدى","لتيارِه فوقَ النجوم مَرافع",49,"ع",1,0],["وَلَو جاءَ في أعصارِهم آمنوا به","وَكانوا لهُ مِن خيرِ أجناده نصرا",50,"ر",2,0],["ولو جَمَل السقاية لقبَّوه","بمعشوقٍ تحرّى أخذَ روحي",51,"ي",1,1],["ولو جلَّ عن شكرٍ من الناس ماجدٌ","لأصبحتَ في الدّنيا جليلاً عن الشكر",52,"ر",1,0],["وَلَوْ جَرَى الْحُكْمُ عَلَى رَسْمِهِ","لَكُنْتَ إِذْ أَنْتَ الْأَجَلَّ الْمُجِيزْ",53,"ز",1,0],["وَلَو جاراكَ أَبيَضُ مُتلَئِبٌّ","قُرى نَبَطِ السَوادِ لَهُ عِيالُ",54,"ل",1,0],["ولَو جَمَّعتَ مِن هنَّا وهنَّا","مِنَ الأتبَانِ أمثالَ الجِبَالِ",55,"ل",1,0],["وَلَو جزيتُهم عَن سيّآتهم","بِمِثلها لم أكُن بالظلم أتّسمُ",56,"م",1,0],["وَلَو جُلّيَت لِلمشتَري منفساتهُ","لَضاقَ إِذاً عن سومها ذرعهُ رَبطا",57,"ط",2,0],["وَلَو جرّد المرّيخ فيه حسامَهُ","لأصبحَ ميديّاً بمخراقِه قمطا",57,"ط",2,0],["وَلَو جالَ فيهِ ممسكٌ لأعنّةٍ","لألقى إِذاً ما في يَديهِ بهِ فَلطا",57,"ط",2,0],["ولو جاز في الفادين أنّك حائزٌ","لأعمارهم أدخلتُ نفسي في الحسبِ",58,"ب",1,0],["وَلِوَجدي أَغارُ أَن تَقبَلَ الأَو","طانُ مِن بَعدِ أَهلِها الأَغيارَ",59,"ر",1,0],["وَلَو جارَت جِياد هَواه قَلبي","لَحارَت والفُؤاد عَلى براقِ",60,"ق",1,0],["ولو جَدّ في طلَبِ المأْثُراتِ","لَما عُنِيَتْ بالهمومِ الرَّحيق",61,"ق",1,0],["ولو جئنَ يحملنَ الحديد بنا معاً","ألا يا لَعمرو بعدها لِشَوارِ",62,"ر",1,0],["وَلَو جَحَدَ الرَوضُ السَحائِبَ قَطرَها","لَأَخجَلَهُ ما فاحَ عَنهُ مِنَ النَشرِ",63,"ر",1,0],["ولَو جاءَكَ يَستَسقي","بِما استَسقَى بنُو دارِم",64,"م",1,0],["وَلو جَرَّ نَفعاً دفعه النَفس لَم يَكُن","عَلى مالِها دونَ الحياةِ اقتِصارُها",65,"ر",3,0],["ولو جَمَعَتْنَا الدّارُ بعد تَفَرّقٍ","لكُنْتُم من الدّنيا ونِعمتِها حَسْبِي",66,"ب",2,0],["ولو جاز الخلود لنفس حي","من الدنيا لحقّ لك الخلود",67,"د",1,0],["ولو جاز في الدنيا خلود لفاضلٍ","لبشّرت الدنيا بأنّي مخلّد",68,"د",1,0],["وُلُوجٌ على الشرّ الذي يرصُدونه","متى وجدوا يوماً إلى الشرّ مَدخَلا",69,"ل",2,0],["ولوجي على أسدِ الأسرة مكرماً","يُباذلني مرهوبُهمْ وأباذله",70,"ل",2,0],["ولو جعلتُ لهُ طرساً جوىً وهوىً","خدّي وامددتهُ من ولعةٍ بدمي",71,"م",2,0],["ولو جنح الحجي مني لهجو","لكان لكم بما قلت اقتداء",72,"ا",2,0],["وَلوجٌ إلى قلبِي عَلوقٌ بخاطري","كما عَلِقَتْ بالرّاحتين الأصابعُ",73,"ع",1,0],["وَلَو جَنَتهُ يَدِي ما كنتُ طائعَها","لَكِنْ جَناهُ على فَوْدَيَّ غيرُ يدِي",74,"د",2,0],["وَلو جزيتُكُمُ سوءاً بسَوْءتِكُمْ","لَكُنتُ أنْبِحُ كلبَ الحيِّ إنْ نَبَحا",75,"ح",2,0],["ولو جاءَني أَمرُهُ بالمسيرِ","لسرْتُ ولو أَنَّنِي رَاجِل",76,"ل",1,0]]}