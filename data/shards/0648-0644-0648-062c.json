,""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5206,"أرى العدل عن لوم العذول هو العدل","https://www.poetsgate.com/ViewPoem.aspx?id=149039",""],[5302,"خوفي بأن تنأى","https://www.poetsgate.com/ViewPoem.aspx?id=204917",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5414,"زيارة فوق العادة للخيول العربية","https://www.poetsgate.com/ViewPoem.aspx?id=12930",""],[5419,"فيزياء ثورية","https://www.poetsgate.com/ViewPoem.aspx?id=71125",""],[5431,"لتعدمه الشفاه بلا رصاص...","https://www.poetsgate.com/ViewPoem.aspx?id=201132",""],[5518,"أمنية","https://www.poetsgate.com/ViewPoem.aspx?id=187173",""],[5639,"حوى المصريّ أنواع المخازي","https://www.poetsgate.com/ViewPoem.aspx?id=89879",""],[5725,"حفظتك في قلبي عراقا مبجلا","https://www.poetsgate.com/ViewPoem.aspx?id=179745",""],[5837,"بعيد الشبح","https://www.poetsgate.com/ViewPoem.aspx?id=179316",""],[5894,"كل الحواسد راعوا ما أنا فيه","https://www.poetsgate.com/ViewPoem.aspx?id=131407",""],[5956,"النساء ضحايا أحوالنا","https://www.poetsgate.com/ViewPoem.aspx?id=181848",""],[5956,"أصالة النقاء ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182271",""],[5956,"النبأ المُفْجع","https://www.poetsgate.com/ViewPoem.aspx?id=192921",""],[6093,"وَزْنٌ أَعْرَج","https://www.poetsgate.com/ViewPoem.aspx?id=190596",""],[6136,"عبرة إلى الشام","https://www.poetsgate.com/ViewPoem.aspx?id=36239",""],[5126,"ملل ويأس وأفكار سوداء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87789&r=&rc=4",""]],"verses":[["وَلَو جَمَعَت لَونَينِ بُذلُ شِباكِها","لَطالَبَها الراجي بِمَنعِ جَناها",0,"ا",3,0],["وَلَو جاهَرتَهُ بِالبَأسِ يَوماً","لَأَبرَأَ ذَلِكَ الجَرَبَ الهِناءُ",1,"ا",2,0],["وَلَو جاوَرتهم لَنُشِغْتَ كِبراً","يُخَيِّمُ بَينَ جيدِكَ وَالنِّجادِ",2,"د",1,0],["وَلَو جَدَّ القِلى لَرَحلتُ عَنها","وَلَم نَسكُن جَميعاً في بِلادِ",3,"د",1,0],["ولَوَجَدْتَ بالقُرْبِ بعْدَ النّوى","أعَدْتَ مُعنّاكَ خَلْقاً جَديدا",4,"د",2,0],["وَلَوَجهُهُ عِندَ المَسائِل إِذ غَدا","وَغَدَت فَواضِلُ سَيبِهِ وَنَوالُها",5,"ل",3,0],["وَلَو جُعِلَ الكورُ العِلافِيُّ فَوقَها","وَراكِبُهُ أَعيَت بِهِ ما تُحَلحِلُ",6,"ل",1,0],["ولو جاءه من فَيه مسّ وجنّة","لما حلّه إلاّ وقد زال مسّه",7,"س",2,0],["ولو جهَّزت قافية شروداً","لقد دخلت بيوت الأشعرينا",8,"ن",2,0],["وَلَو جَمَعَت ما حَوَت مَذحِجٌ","مِنَ المَدِ ما أَثقَلَ الأَرنَبا",9,"ب",2,0],["ولو جُدِعْتُ على أني مدحتُكُمُ","ما شانني شينَ مدحي فيكُمُ جَدَعي",10,"ع",2,0],["ولو جهد الساعون في الرزق جهدهم","لما وقعت إلا بما هي وُقَّع",11,"ع",1,0],["ولَوجهُ الأمير أحسُن مما","يكتسيه من وشيه الألوان",12,"ن",1,0],["وَلَو جازَ بَينَ الضُحى وَالدُجى","لَقاتَلَ فيهِ الضُحى الغَيهَبا",13,"ب",2,0],["وَلَو جَزَتكَ الصَحارى جِئتَنا مَلِكاً","مِنَ المُلوكِ عَلَيكَ الريشُ وَالوَدَعُ",14,"ع",1,0],["وَلَو جازَ أَن يَحوُوا عُلاكَ وَهَبتَها","وَلَكِن مِنَ الأَشياءِ ما لَيسَ يوهَبُ",15,"ب",1,0],["وَلَو جازَ الخُلودُ خَلَدتَ فَرداً","وَلَكِن لَيسَ لِلدُنيا خَليلُ",16,"ل",1,0],["وَلَو جَعَلتَ مَوضِعَ الإِلالِ","لاّلِئاً قَتَلتَ بِاللَآلي",17,"ل",2,0],["وَلَو جُمِعَ الأَئِمَّةُ في مَقامٍ","تَكونُ بِهِ لَكُنتَ لَهُم إِماما",18,"م",2,0],["وَلَو جَحَدَتهُ ذَلِكَ الحَقَّ لَم تَكُن","لِتَبرَحَ إِلّا وَالنُجومُ رُجومُها",19,"م",3,0],["وَلَوَجهُ البَخيلِ أَحسَنُ في بَع","ضِ الأَحايينِ مِن قَفا المَحرومِ",20,"م",1,0],["وَلَو جازَيتِ صَبّاً عَن هَواهُ","لَكانَ العَدلُ أَلّا تَهجُريني",21,"ن",2,0],["وَلَو جَدّاتُهُنَّ سَأَلنَ عَنّي","رَجَعنَ إِلَيَّ أَضعافَ السَلامِ",22,"م",1,0],["وَلَو جَحَدوا فِعلي مَخافَةَ شامِتٍ","لَنَمَّ عَلَيهِم في جِباهِهِمُ وَسمي",23,"م",2,0],["وَلَو جارَياكَ إِلى غايَةٍ","لَفُزتَ وَكانا مِنَ الخُيَّبِ",24,"ب",1,0],["ولو جَحَدُوهُ أقبلتِ المنايا","تُؤذِّنُ في الرقابِ وفي النُّحورِ",25,"ر",1,0],["ولو جَعلوا السَّحابَ لهم مَحَلّاً","لَطَارَ الجيشُ يَقتحِمُ السَّحابا",26,"ب",2,0],["وَلَو جَمَعَت يَوماً تَميمٌ جُموعَها","عَلى ذَرَّةٍ مَعقولَةٍ لَاِستَقَلَّتِ",27,"ت",1,0],["ولو جاد قومٌ بالنفوس سماحةً","لَما منعتْكُمْ شيمةُ الجود بالعمر",28,"ر",1,0],["ولو جاوَرَ العرَبَ الأقدمينَ","وفي الذاهبينَ وفَى مَنْ وَفى",29,"ا",1,0],["وَلَو جِئتَها مَلأى عَبيطاً مُجَزَّلاً","لَأَخرَجتَ مافيها عَلى طَرَفِ الظُفرِ",30,"ر",1,0],["وَلَو جاءَ غَيرُ البُخلِ مِن عِندِ جَعفَرٍ","لَما حَسِبَتهُ الناسُ إِلّا مِنَ الحُمقِ",31,"ق",1,0],["وَلَو جِئتَها مَلأى عَبيطاً مُجَزَّلاً","لَأَخرَجتَ ما فيها بِعودِ خِلالِ",32,"ل",1,0],["وَلَو جُزينا عَلى خَلائِقِنا","أَمسَكَ عَنّا الحَيا فَما نَقَطا",33,"ط",2,0],["ولو جُليتْ سِرّاً على أَكمَهٍ غَدا","بَصيراً ومن راووقِها تَسْمَعُ الصّم",34,"م",1,0],["ولو جارها اللجلاج أو لو أجارها","بنو باعث لم تنز في حبل صائد",35,"د",1,0],["ولو جرَتْ بالصفوِ أيامهُ","ما كانَ بالرَّازي ولا الناقمِ",36,"م",1,0],["ولو جرت النباهة في طريق ال","خمول إليَ لاخترت الخمولا",37,"ل",2,0],["وَلَوْ جَمَعَتْ عَبِيرَ الرَّوْضِ تَمْضِي","بِهِ النَّسَمَاتُ لَمْ تَجْمَعْ مرَادِي",38,"د",2,0],["ولو جَرَّبوا أهل المناصب وحدَهم","لهانَ ، ولكنْ جُربّوا في المناصب",39,"ب",1,0],["ولو جَمَعتَ بِسفكِ دم","ما أسخَفا",40,"ف",2,0],["ولو جازاك بالأعمال عدلاً","مكان الفضل عاجلك انتقام",41,"م",1,0],["ولو جاز لي دعوى السُّلِّو ادَّعيتُهُ","عزاءً ولكنَّ السّلو محال",42,"ل",1,0],["ولو جعلتُ كلامي روضةً أُنفاً","وصُغتُ أحرف خطّي فيه أزهارا",43,"ر",2,0],["ولو جاءه داع بطرس مزور","لقاسمه فيها الخراج الذي يجبا",44,"ب",2,0],["وَلَو جاءَهُ مُغتالُهُ مِن أَمامِهِ","لَراحَ أَكيلاً بَينَ نَسرٍ وَسِرحانِ",45,"ن",1,0],["وَلَو جَرى عِندَ أَهلِ السَبقِ في طَلقٍ","مِنَ البَلاغَةِ أَجلى عَن مُجَلِّيها",46,"ي",3,0],["وَلَو جاوَبتَنِى لَقَصَرتَ عَنِّى","وَأَنتَ عَنِ المَدَى نَاءٍ حَسِيرُ",47,"ر",1,0],["وَلَو جِئتُ أَستَسقى شَرَاباً وَعِندَهُ","عُيُونٌ رَوِيّاتٌ لَهُنَّ جَدَاوِلُ",48,"ل",1,0],["ولو جَرى نيلُها لي فضةً وغَدا","سفحُ المُقطَّم منها وهو لي ذهَب",49,"ب",1,0],["ولو جاد جَدْواها على الخَلْق لاغْتَدى","لتيارِه فوقَ النجوم مَرافع",50,"ع",1,0],["وَلَو جاءَ في أعصارِهم آمنوا به","وَكانوا لهُ مِن خيرِ أجناده نصرا",51,"ر",2,0],["ولو جَمَل السقاية لقبَّوه","بمعشوقٍ تحرّى أخذَ روحي",52,"ي",1,1],["ولو جلَّ عن شكرٍ من الناس ماجدٌ","لأصبحتَ في الدّنيا جليلاً عن الشكر",53,"ر",1,0],["وَلَوْ جَرَى الْحُكْمُ عَلَى رَسْمِهِ","لَكُنْتَ إِذْ أَنْتَ الْأَجَلَّ الْمُجِيزْ",54,"ز",1,0],["وَلَو جاراكَ أَبيَضُ مُتلَئِبٌّ","قُرى نَبَطِ السَوادِ لَهُ عِيالُ",55,"ل",1,0],["ولَو جَمَّعتَ مِن هنَّا وهنَّا","مِنَ الأتبَانِ أمثالَ الجِبَالِ",56,"ل",1,0],["وَلَو جزيتُهم عَن سيّآتهم","بِمِثلها لم أكُن بالظلم أتّسمُ",57,"م",1,0],["وَلَو جُلّيَت لِلمشتَري منفساتهُ","لَضاقَ إِذاً عن سومها ذرعهُ رَبطا",58,"ط",2,0],["وَلَو جرّد المرّيخ فيه حسامَهُ","لأصبحَ ميديّاً بمخراقِه قمطا",58,"ط",2,0],["وَلَو جالَ فيهِ ممسكٌ لأعنّةٍ","لألقى إِذاً ما في يَديهِ بهِ فَلطا",58,"ط",2,0],["ولو جاز في الفادين أنّك حائزٌ","لأعمارهم أدخلتُ نفسي في الحسبِ",59,"ب",1,0],["وَلِوَجدي أَغارُ أَن تَقبَلَ الأَو","طانُ مِن بَعدِ أَهلِها الأَغيارَ",60,"ر",1,0],["وَلَو جارَت جِياد هَواه قَلبي","لَحارَت والفُؤاد عَلى براقِ",61,"ق",1,0],["ولو جَدّ في طلَبِ المأْثُراتِ","لَما عُنِيَتْ بالهمومِ الرَّحيق",62,"ق",1,0],["ولو جئنَ يحملنَ الحديد بنا معاً","ألا يا لَعمرو بعدها لِشَوارِ",63,"ر",1,0],["وَلَو جَحَدَ الرَوضُ السَحائِبَ قَطرَها","لَأَخجَلَهُ ما فاحَ عَنهُ مِنَ النَشرِ",64,"ر",1,0],["ولَو جاءَكَ يَستَسقي","بِما استَسقَى بنُو دارِم",65,"م",1,0],["وَلو جَرَّ نَفعاً دفعه النَفس لَم يَكُن","عَلى مالِها دونَ الحياةِ اقتِصارُها",66,"ر",3,0],["ولو جَمَعَتْنَا الدّارُ بعد تَفَرّقٍ","لكُنْتُم من الدّنيا ونِعمتِها حَسْبِي",67,"ب",2,0],["ولو جاز الخلود لنفس حي","من الدنيا لحقّ لك الخلود",68,"د",1,0],["ولو جاز في الدنيا خلود لفاضلٍ","لبشّرت الدنيا بأنّي مخلّد",69,"د",1,0],["وُلُوجٌ على الشرّ الذي يرصُدونه","متى وجدوا يوماً إلى الشرّ مَدخَلا",70,"ل",2,0],["ولوجي على أسدِ الأسرة مكرماً","يُباذلني مرهوبُهمْ وأباذله",71,"ل",2,0],["ولو جعلتُ لهُ طرساً جوىً وهوىً","خدّي وامددتهُ من ولعةٍ بدمي",72,"م",2,0],["ولو جنح الحجي مني لهجو","لكان لكم بما قلت اقتداء",73,"ا",2,0],["وَلوجٌ إلى قلبِي عَلوقٌ بخاطري","كما عَلِقَتْ بالرّاحتين الأصابعُ",74,"ع",1,0],["وَلَو جَنَتهُ يَدِي ما كنتُ طائعَها","لَكِنْ جَناهُ على فَوْدَيَّ غيرُ يدِي",75,"د",2,0],["وَلو جزيتُكُمُ سوءاً بسَوْءتِكُمْ","لَكُنتُ أنْبِحُ كلبَ الحيِّ إنْ نَبَحا",76,"ح",2,0],["ولو جاءَني أَمرُهُ بالمسيرِ","لسرْتُ ولو أَنَّنِي رَاجِل",77,"ل",1,0],["وَلِوَجهِ أحمَدَ في القُلُوب مَخافَةٌ","فَصلُ الخِطابِ بِِها وَفَضلُ المَنطِقِ",78,"ق",1,0],["ولوجهه كل الجهات توجهت","وهو الذي في كل شفع يوتر",79,"ر",1,0],["ولوجهك الباقي المحيط توجهت","روح السجود بمظهر الإحسان",80,"ن",1,0],["ولو جُدْتُمُ بالمُنَى من كِتابِكُمْ","لَجُدْتُمْ على مُضْناكُمُ منه بالشِّفَا",81,"ف",2,0],["ولو جرى في نداه الناس أغرقهم","ما كل ماءٍ على شاط بزخّار",82,"ر",1,0],["ولوجه الشمس نوراً","هو من وجهك نارا",83,"ر",2,0],["وَلَوْ جَادَ يَوْماً لِلْمُحِبِّ بِنَظْرَةٍ","لَمَا صَارَ مِنْ فَرْطِ الضَّنى جِسْمُهُ يُكْوى",84,"ك",3,0],["وَلَوْ جَلاَ أكْمَهٌ سنَاهَا","أبْصَرَ فِي الْحَالِ مَا تَقَصَّدْ",85,"د",1,0],["وَلَو جَدواه غيثاً كا","نَ كالطوفانِ طوفانا",86,"ن",2,0],["وَلَو جودهُ ودق هطّاله","لأتبع نوحاً بطوفانهِ",87,"ن",2,0],["ولو جادَ مِنْ ذاكَ الرُّضابِ بِشُرْبةٍ","لأَطفأَ مِنْ هذا الحَريقِ رَحيقُها",88,"ق",3,0],["ولو جاءت الزهر من أفقها","لتجديه الفوز لم تجده",89,"د",2,0],["وَلَو جِبالُ الأَرضِ تَهوي بِها","ذابَت كَذَوبِ القِطرِ في النارِ",90,"ر",1,0],["ولو جاز الإحالة بعد عيسى","أحلت دمي إِلى كاسات خمر",91,"ر",1,0],["وَلَو جُمِعَت جَرمٌ عَلى رَأسِ نملَةٍ","لَباتوا شِباعاً يَضرطونَ مِنَ الشَّحمِ",92,"م",1,0],["ولو جلوتُ القذَى عن ناظرىَّ به","فإنَّ طلعتَهُ يُشفَى بها الرَّمدُ",93,"د",1,0],["ولو جاد من\"بعد المطال\" بزورة","لما شبَّ أشواقي وقلبيَ زندُهُ",94,"د",2,0],["ولو جاز عقلاً ما ادعوه لأصبحت","ذنوب الورى دَيناً على الناس يُشرع",95,"ع",1,0],["وَلَو جَلَّ عَن شُكرِ الصَنيعَةِ مُنعِمٌ","لَجَلَّ أَميرُ المُؤمِنينَ عَنِ الشُكرِ",96,"ر",1,0],["ولو جُلِّيَت ليلى على اللَيلِ مُظلِماً","لَجَلَّت ظلامَ الليلِ ليلى فأَقمَرا",97,"ر",2,0],["ولو جاءها خصم على مغرم له","لماد صريعا وانثنى وهو مغرم",98,"م",1,0],["ولو جرى البرق على آثاره","قال له فات السباق فأربع",99,"ع",1,0],["ولو جاز فالتفريق أولى وبعدهم","فمولى وعبد أسودُ اللون رمحُ",100,"ح",1,0],["ولو جاءه من غير ما جاءه به","لآب بخسر وانثنى وهو راهبه",101,"ب",2,0],["ولو جازَ أن تُحوى عُلاكَ وَهبتَها","ولكن من الأشياء ما ليسَ يُوهَبُ",102,"ب",1,1],["ولو جرت الخمسُ الرِّياحُ تضوَّعَت","بما استنشقته من ثنائي ومن ودي",103,"د",2,0],["ولوجاز هذا جاز بالتين حلفنا","كما حلف الباري قياس مماثل",104,"ل",1,0],["ولو جعلتُم على الأحرار نعمتُكم","حمَتكم السادةُ المذكورةُ الحُشُدُ",105,"د",1,0],["ولو جاز أن يبنى لك القبر عسجداً","بنته دهاقين العلا ورجاله",106,"ل",2,0],["ولو جرينا لدرى أينا","يحوز سبقاً قصب الخصل",107,"ل",1,0],["وَلَو جادَ إِنسانٌ عَلَيَّ بِدَرهِم","لَرُحتُ إِلى رَحلي وَفي الكَفِّ عَقرَبُ",108,"ب",1,0],["ولو جمعت هبات السابقين من","الكرام من اذخروا الاشعار والخطبا",109,"ب",2,0],["ولو جاءني للبين خطبٌ حَمَلْته","ولكنَّها بعدَ الخطوب خُطوبُ",110,"ب",1,0],["وَلَو جَمَّعتُم رُوس الأَعادي","بَنَيتُم بِالقفار بِها قِبابا",111,"ب",2,0],["وُلوجاً في الذي كَرهت قريشُ","ولَو عجّت بمكّتها عَجيجا",112,"ج",2,0],["ولو جئته تسعى إليه لحاجة","لأعرض إعراض البخيل أخي الشح",113,"ح",1,0],["ولو جهل الشاني وشان لشأنه","لأنبأه قطعاً مضا السيف إذ يشهر",114,"ر",1,0],["ولو جرى في الملك شرك لفسد","نزهه واقرأ قل هو الله احد",115,"د",1,0],["ولو جاءني الموت مستعجلا","لقلت تمّهل لأوفي بوعدي",116,"ي",1,0],["ولوجارها ابن المازنية ثابت","لروّح راعيها وندى وأوردا",117,"د",2,0],["ولو جئت للتحقيق انكرت مثلتي","ولو أنها في شرع احمد حوب",118,"ب",1,0],["ولو جنيتُ لأعواني سلامتهم","حتى يراني رحباً بالندى باعي",119,"ع",2,0],["ولو جاءك علم المعاني التي بدت","لكنت من أعظم هناء وراحة",120,"ه",1,0],["ولو جار جاري مدمعي ما هجوته","لأن نبيَّ الحسن وصَّى على الجار",121,"ر",1,0],["ولِوَجْهها مِنْ وَجْهِها قَمَرٌ","ولِعَيْنِها مِنْ عَيْنِها كُحْلُ",122,"ل",1,0],["ولو جاءَ أمرُكمُ لي بأن","أموتَ إذاً مِتُّ قبلَ الأجَل",123,"ل",1,0],["ولو جاورتْ وهباً لقصَّ حِبالَها","وأثقالَها عن منكبٍ وجِرانِ",124,"ن",1,0],["ولو جفتِ الغُدرانُ دونَ مسيرِه","لأنبطَ نَهراً في السّماوةِ جارِيا",125,"ي",2,0],["ولو جلدي في كل قلب ومهجةٍ","لما أثرت فيها العيون المرائض",126,"ض",1,0],["وَلَو جَفَوتُم لَنا أَملاً","وَاللَهُ ما طَلَبت اهواؤُنا بَدَلا",127,"ل",2,0],["ولو جلستُ إِلى هذا السريّ لما","أبقيتُ من لفظ تعظيم ولم أذر",128,"ر",1,0],["وَلَو جاءَكَ البَحر المُحيط مَكاثِراً","لَقُلت لَهُ لاقَيت للعلم كَوثَرا",129,"ر",2,0],["ولو جُسِّمَت اخلاقُهُ لرأَيَتها","عُقودَ لآلٍ ليس تُدرَك بالوَهمِ",130,"م",1,0],["وَلَو جعلتُ فداهُ كاشحيهِ لما","ودَيتُ غَيرَ ذَميمِ الخُلقِ مُسقَمهِ",131,"م",2,0],["وَلو جرت الأَقدار جاريت ما جَرَت","وَإِن تتجرأ بي عَلى الدَهر أَجرأِ",132,"ر",2,0],["ولو جاز الهواء الطلق أبقى","عليه من سماجته دليلا",133,"ل",2,0],["ولو جلون الوجودا","كما نحب سعودا",134,"د",2,0],["ولو جاء بجيش كا","نَ في تدبيره أحكَمْ!",135,"م",1,0],["ولو جاز في الدنيا الخلود استحقه","نبي محي بالحق دين البطاركه",136,"ك",2,0],["ولو جاز أن تفدى فدتك نفوسنا","ولا بد يوماً إن ترد الودائع",137,"ع",1,0],["ولو جاد لي من خمره وحبابه","لما بلبلتني في فؤادي بلابله",138,"ل",2,0],["ولو جربت ذا بطرٍ وبغلاً","وجدت البغل خيرهما طباعا",139,"ع",2,0],["ولو جفاني سواكم ما نشرت له","لواء عتبي في قول ولا عمل",140,"ل",1,0],["ولو جاريت قومك من معدٍّ","كفوت الطرف عيراً في النكال",141,"ل",1,0],["ولو جاء دهري بهذا السرور","وفينا حسين يزين السريرا",142,"ر",2,0],["ولو جاء دهري بهذا السرور","وكنت المهني له والبشيرا",142,"ر",2,0],["ولوجهك الوضّاح أبهى منظراً","منه وأبهر في الجمال وأنضَرُ",143,"ر",1,0],["وَلوجه الكَريم أَقبل بوجهٍ","فاقَ كُلّ الوجوه في نيّراتِه",144,"ت",2,0],["ولو جبلوا على خلق","لضاعت حكمة الفرد",145,"د",1,0],["وَلَو جَرَّدوا مِن نُقطَةِ الغَينِ عَينهُم","لَفازوا بِتَفريدٍ بِهِ الذاتُ جَلَّتِ",146,"ت",1,0],["ولِوجدٍ أقامَ مُذ غبتَ عنه","لكَ بينَ الحشا وبينَ الضلوعِ",147,"ع",1,0],["ولو جُسّمت آلاؤهم أو تُصوّرت","مواهبهم لم يبقَ في الخلقِ سائلُ",148,"ل",1,0],["ولو جاورتني قدر اعتقادي","لنلت بك المجرة والسماكا",149,"ك",2,0],["ولو جاز بعد الذكر تنزيل آية","لكانت قوافي مدحنا فيه تنزيلا",150,"ل",2,0],["ولو جمع الأنام على وئامٍ","لما عرفوا تباريح الكروبِ",151,"ب",1,0],["ولو جانبوها روم غير جنابها","لعدوا بحكم العدل ذا العدل مأثما",152,"م",2,0],["ولو جرتْ الأمورُ إلى مَداها","لبانَ التّبرُ من خبثِ الحديدِ",153,"د",1,0],["ولو جئتُ يومًا ب(كُوفي عَنانٍ)","وسيطًا لولّى بغير اتِّفاقْ!",154,"ق",1,0],["ولو جاع الفحول من المعاني","بحلقِ ثغورهم كلمي يقيتُ",155,"ت",1,0],["ولو جئْتَ إحْداها بغيرِ نباهةٍ","لما كان شفْعاً وتْرُها بالْحَوامدِ",156,"د",1,0],["ولو جمعت دموع اليتم فاتسقت","عقداً وكل أنين منه فانتظما",157,"م",2,0],["ولو جمعت العقل والنقل معا","من الجديد لاستويت بالذرا",158,"ا",1,0],["وَلَوْ جَادَ بالدُّنيَا وَضَنَّ بِرُوحِهِ","فَلَا مِريَةٌ فِي حُكمِهِ أنَّهُ بُخْلُ",159,"ل",1,0],["ولو جرى الحكم على رغبة","منا لقدرنا بأن نلتقي",160,"ق",2,0],["ولو جاءنا منكم جواب وجدتنا","على ثغرة المرمى قعوداً وجثما",161,"م",2,0],["ولو جُمِعَ العارُ حتى يُقاسَ","بعارهمو كان عارًا ضئيلا",162,"ل",2,0],["ولو جاء الحصى من كل صوبٍ","سيصنع عند وحدتِهِ جبالا",163,"ل",2,0],["ولو جُمعت خطايا الأرض عشقا","فلا يألوكَ سعيا لانتقاصِ",164,"ص",1,0],["ولو جُمعَتْ لدى قلبي الأماني","وقيل : تمنَّ ولْ توجزْ مُناكَ",165,"ك",1,0],["ولو جمعت مخازيه لزادت","بكثرتها على كتب المغازي",166,"ي",1,0],["ولو جرّبوا ماكان عيبا يرونه","لما نكروا راسا به الشيب قد علا",167,"ل",2,0],["ولو جارت الأيام ما عشت وسط القبح","ولا مرتجي خلق الله وراجي الغافر",168,"ر",1,0],["ولو جفاني وضيع لا أقاومه","ولم أنله اشتهارا جاء يشريه",169,"ي",2,0],["ولو جعل الإله الجنس فُرناً","لشاهدْنا الحرائق في المساجدْ",170,"د",1,0],["ولو جاز لي أن يضمّك صدري","لكنت جعلتك أبهَى كسائي",171,"ا",2,0],["ولوجهِ تعالى أبذل ما","عندي من ودٍّ مشتدِّ",172,"د",1,0],["وَلَو جَاءَ يَسْتهدي القَصِيْدَ وَ نَوْرَهُ","لأهْدَيْتَهُ شَمْسَاً لِفَجِّهِ تُنْضِجُ",173,"ج",1,0],["ولو جاءت حسانُ الكونِ تَتْرى","لما استهوى فؤادي عنكِ حَشْد",174,"د",1,0],["وَلَوْ جَاءَ هَذَا المَوْتُ قَبْلَ أَوَانِهِ","لأَلْفَى إِلَى ُروحِي السَّبِيلَ مُعَبَّدَا",175,"د",2,0]]}