{"poems":[[87,"سل يلدزا ذات القصور","https://www.aldiwan.net/poem63770.html","مجزوء الكامل"],[76,"وندي أنس هزني","https://www.aldiwan.net/poem12843.html","مجزوء الكامل"],[76,"ألا هل أطل الأمير الأجل","https://www.aldiwan.net/poem13225.html","المتقارب"],[69,"إن تحي آمالي برؤية عيسى","https://www.aldiwan.net/poem18073.html","الكامل"],[102,"بين ذهاب ومعاد","https://www.poetsgate.com/ViewPoem.aspx?id=50188",""],[33,"إنّ الحبيبَ تروحتْ اثقالهُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19025&r=&rc=288",""],[33,"فَلَمَّا کلْتَقَيْنَا، وکطْمَأَنَّتْ بِنَا النَّوَى ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18972&r=&rc=235",""],[113,"دنف مذاب القلب من فرط الأسا","https://www.aldiwan.net/poem16497.html","الكامل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[197,"سل الربيع على الشتاء صوارما","https://www.aldiwan.net/poem13025.html","الكامل"],[275,"فقن الخمائل نضرة وعبيرا","https://www.aldiwan.net/poem35469.html","الكامل"],[276,"أعد الوداع فما أراك تراني","https://www.aldiwan.net/poem52062.html","الكامل"],[280,"حملت براحتها شبيهة خدها","https://www.aldiwan.net/poem25640.html","الكامل"],[463,"طوى الليل راكب أخطاره","https://www.aldiwan.net/poem56164.html","المتقارب"],[469,"ما كنت بالباكي جآذر لعلع","https://www.aldiwan.net/poem3291.html","عموديه"],[469,"ما على ما لاقيته من مزيد","https://www.aldiwan.net/poem3440.html","عموديه"],[563,"زر بنات القسوس في دير هنه","https://www.aldiwan.net/poem33712.html","الخفيف"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104622","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38391","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64820","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112835","البسيط"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109057","الوافر"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124724","الخفيف"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104678","البسيط"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82824","الرمل"],[3569,"","https://poetry.dctabudhabi.ae/diwan/poem/105787","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[2052,"فقن الظباء سوالفاً ونحورا","https://www.poetsgate.com/ViewPoem.aspx?id=201386",""],[4927,"قصيدة لعيني عُروة وعَفْراء","https://www.poetsgate.com/ViewPoem.aspx?id=29954",""],[3591,"ما أطعمتنا حسانٌ في مغانينا","https://www.poetsgate.com/ViewPoem.aspx?id=149377",""],[5854,"ألا أيها السارونَ والليلُ مسدفُ","https://www.poetsgate.com/ViewPoem.aspx?id=191754",""],[6031,"يا مَنْ تَمَلَّكَني بِمَا","https://www.poetsgate.com/ViewPoem.aspx?id=46366",""]],"verses":[["فَقَنَصَت صَيّادَ الأُسو","دِ وَصِدتَ قَنّاصَ النُسور",0,"ر",1,0],["فَقَنَصتُ مِنهُ حَمامَةً","بَيضاءَ تَسنَحُ مِن غُرابِ",1,"ب",1,0],["فَقِنيَتُهُ لِلقَنا وَالظُبى","وَقُبِّ الخُيولِ وَبيضِ الخَوَل",2,"ل",1,0],["فَقَناةُ حَرْبِي لا أُرِد تَقْوِيمَها","لِلطَّعْنِ إلّا رَدَّها تَقْوِيسا",3,"س",2,0],["فقنّعت وجهيهما صفرة","كذكريات المذنب الآسف",4,"ف",1,0],["فَکقْنَ الحَيَاءَ، فَقَدْ بَكَيْتَ بِعَوْلَة ٍ","لو كان ينفعُ باكياً إعواله",5,"ل",2,0],["فقنَ: شهدنا أنّ ذا ليسَ كاذباً،","ولكنهُ فيما يقولُ مصدق",6,"ق",1,0],["فقن الرِياض غَضاضة وَنَضارة","وَالراح فعلاً وَالنَسيم تَنَفسا",7,"س",2,0],["فَقنّعَ خِزياً قينقاعَ بنفيهم","وَزوّدهم فَقراً وأسلمهم قفرا",8,"ر",2,0],["فَقُنو حُمرَتِها خِضابُ نَجيعِهِ","وَسَوادُ كِسوَتِها لِباسُ حِدادِ",9,"د",1,0],["فقنَ الخمائلَ نضرةً وعبيرا","والصّبحَ أنساً والنّسيمَ مُرورا",10,"ر",2,1],["فقني بجاهك من هموم الفقر في","الدنيا وَفي الاخرى من النيران",11,"ن",1,0],["فَقَنِعْتُ مِنها بالزّهيدِ تعلُّلاً","والحُبُّ يُقْنَع فِيه بِالإيماء",12,"ا",2,0],["فقنطارُ مالك دون الأذى","ومهجتُه قبلَ دينارِهِ",13,"ر",2,0],["فقناً لغير أكفُّهم لا تقتنى","وظبى لغير بنانهم لم تطبع",14,"ع",1,0],["فقنعنا من وصلكم بالتمنّي","ورضينا منكم بليَّ الوعودِ",15,"د",1,0],["فق نديمي من نوم عقلك واركع","لغواني الوجود واسجد لَهُنَّهْ",16,"ن",2,0],["فقنصتُ منها ظبيةً كانت الى","قلبي ألذَّ من المُدامِ وطيبهِ",17,"ب",2,0],["فَقنديلُ بِلّورٍ عَلَتهُ نَضارَةٌ","لَهُ الحسنُ ضَوءٌ في كَمالِ بَهاءِ",18,"ا",2,0],["فُقْنا الأَنامَ بمَذْهبٍ فَخْرِنا","وعَلائِنا مُتَنَوِّعٍ مُتَجَنِّسِ",19,"س",1,0],["فقنان من عدانا والفخار به","حزنا ومعشر صرنا به سعدا",20,"د",2,0],["فقنَّعه الغمام فصار يرنو","إِلى الاثنين بالطرف الحسير",21,"ر",1,0],["فقني السيئات منك وكن لي","ناصراً رب لا تكن خذالاً",22,"ل",2,0],["فقنا فخرنا الألى شادوا الفخار به","فالحمد لله نحن الفائزون به",23,"ه",1,0],["فَقِنا هذا البَلاء","يا عَزيزاً ذا اِنتِقام",24,"م",1,0],["فقناً يسيلُ من الدماء على قنا","بطوالهنَّ تُقَصَّرُ الاعمارُ",25,"ر",1,0],["فقناة قليونٍ به نفذت","والجوب ماد يصل منكسرا",26,"ر",2,0],["فقن الظباء سوالفاً ونحورا","والخيزران معاطفاً وخصورا",27,"ر",2,1],["فَقَنِعْتُ أَنِّيْ قَدْ بَلَغْتُ بِعِطْرِهَاْ","أَرَبِيْ، وَعَنْهَاْ مَا الْتَمَسْتُ بَرَاْحَاْ",28,"ح",2,0],["فقنا السوابح جرياً في محبتها","فمن لنا برياح أن تجارينا",29,"ن",2,0],["فقِنّة صبري وقتذاكَ تشقّقتْ","وقاع اتزاني حين ذلك صفصفُ",30,"ف",1,0],["فَقِني ذَلاَقَةَ حَدِّهِ","وأَتِحْ لَهُ بندَاكَ غِمْدَا",31,"د",2,0]]}