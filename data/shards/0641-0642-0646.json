{"poems":[[85,"سل يلدزا ذات القصور","https://www.aldiwan.net/poem63770.html","مجزوء الكامل"],[74,"وندي أنس هزني","https://www.aldiwan.net/poem12843.html","مجزوء الكامل"],[74,"ألا هل أطل الأمير الأجل","https://www.aldiwan.net/poem13225.html","المتقارب"],[67,"إن تحي آمالي برؤية عيسى","https://www.aldiwan.net/poem18073.html","الكامل"],[31,"إنّ الحبيبَ تروحتْ اثقالهُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19025&r=&rc=288",""],[31,"فَلَمَّا کلْتَقَيْنَا، وکطْمَأَنَّتْ بِنَا النَّوَى ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18972&r=&rc=235",""],[107,"دنف مذاب القلب من فرط الأسا","https://www.aldiwan.net/poem16497.html","الكامل"],[187,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[191,"سل الربيع على الشتاء صوارما","https://www.aldiwan.net/poem13025.html","الكامل"],[268,"فقن الخمائل نضرة وعبيرا","https://www.aldiwan.net/poem35469.html","الكامل"],[269,"أعد الوداع فما أراك تراني","https://www.aldiwan.net/poem52062.html","الكامل"],[273,"حملت براحتها شبيهة خدها","https://www.aldiwan.net/poem25640.html","الكامل"],[456,"طوى الليل راكب أخطاره","https://www.aldiwan.net/poem56164.html","المتقارب"],[462,"ما كنت بالباكي جآذر لعلع","https://www.aldiwan.net/poem3291.html","عموديه"],[462,"ما على ما لاقيته من مزيد","https://www.aldiwan.net/poem3440.html","عموديه"],[556,"زر بنات القسوس في دير هنه","https://www.aldiwan.net/poem33712.html","الخفيف"]],"verses":[["فَقَنَصَت صَيّادَ الأُسو","دِ وَصِدتَ قَنّاصَ النُسور",0,"ر",1,0],["فَقَنَصتُ مِنهُ حَمامَةً","بَيضاءَ تَسنَحُ مِن غُرابِ",1,"ب",1,0],["فَقِنيَتُهُ لِلقَنا وَالظُبى","وَقُبِّ الخُيولِ وَبيضِ الخَوَل",2,"ل",1,0],["فَقَناةُ حَرْبِي لا أُرِد تَقْوِيمَها","لِلطَّعْنِ إلّا رَدَّها تَقْوِيسا",3,"س",2,0],["فَکقْنَ الحَيَاءَ، فَقَدْ بَكَيْتَ بِعَوْلَة ٍ","لو كان ينفعُ باكياً إعواله",4,"ل",2,0],["فقنَ: شهدنا أنّ ذا ليسَ كاذباً،","ولكنهُ فيما يقولُ مصدق",5,"ق",1,0],["فقن الرِياض غَضاضة وَنَضارة","وَالراح فعلاً وَالنَسيم تَنَفسا",6,"س",2,0],["فَقنّعَ خِزياً قينقاعَ بنفيهم","وَزوّدهم فَقراً وأسلمهم قفرا",7,"ر",2,0],["فَقُنو حُمرَتِها خِضابُ نَجيعِهِ","وَسَوادُ كِسوَتِها لِباسُ حِدادِ",8,"د",1,0],["فقنَ الخمائلَ نضرةً وعبيرا","والصّبحَ أنساً والنّسيمَ مُرورا",9,"ر",2,1],["فقني بجاهك من هموم الفقر في","الدنيا وَفي الاخرى من النيران",10,"ن",1,0],["فَقَنِعْتُ مِنها بالزّهيدِ تعلُّلاً","والحُبُّ يُقْنَع فِيه بِالإيماء",11,"ا",2,0],["فقنطارُ مالك دون الأذى","ومهجتُه قبلَ دينارِهِ",12,"ر",2,0],["فقناً لغير أكفُّهم لا تقتنى","وظبى لغير بنانهم لم تطبع",13,"ع",1,0],["فقنعنا من وصلكم بالتمنّي","ورضينا منكم بليَّ الوعودِ",14,"د",1,0],["فق نديمي من نوم عقلك واركع","لغواني الوجود واسجد لَهُنَّهْ",15,"ن",2,0]]}