{"poems":[[85,"سل يلدزا ذات القصور","https://www.aldiwan.net/poem63770.html","مجزوء الكامل"],[74,"وندي أنس هزني","https://www.aldiwan.net/poem12843.html","مجزوء الكامل"],[74,"ألا هل أطل الأمير الأجل","https://www.aldiwan.net/poem13225.html","المتقارب"],[67,"إن تحي آمالي برؤية عيسى","https://www.aldiwan.net/poem18073.html","الكامل"],[100,"بين ذهاب ومعاد","https://www.poetsgate.com/ViewPoem.aspx?id=50188",""],[31,"إنّ الحبيبَ تروحتْ اثقالهُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19025&r=&rc=288",""],[31,"فَلَمَّا کلْتَقَيْنَا، وکطْمَأَنَّتْ بِنَا النَّوَى ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18972&r=&rc=235",""],[109,"دنف مذاب القلب من فرط الأسا","https://www.aldiwan.net/poem16497.html","الكامل"],[189,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[193,"سل الربيع على الشتاء صوارما","https://www.aldiwan.net/poem13025.html","الكامل"],[270,"فقن الخمائل نضرة وعبيرا","https://www.aldiwan.net/poem35469.html","الكامل"],[271,"أعد الوداع فما أراك تراني","https://www.aldiwan.net/poem52062.html","الكامل"],[275,"حملت براحتها شبيهة خدها","https://www.aldiwan.net/poem25640.html","الكامل"],[458,"طوى الليل راكب أخطاره","https://www.aldiwan.net/poem56164.html","المتقارب"],[464,"ما كنت بالباكي جآذر لعلع","https://www.aldiwan.net/poem3291.html","عموديه"],[464,"ما على ما لاقيته من مزيد","https://www.aldiwan.net/poem3440.html","عموديه"],[558,"زر بنات القسوس في دير هنه","https://www.aldiwan.net/poem33712.html","الخفيف"]],"verses":[["فَقَنَصَت صَيّادَ الأُسو","دِ وَصِدتَ قَنّاصَ النُسور",0,"ر",1,0],["فَقَنَصتُ مِنهُ حَمامَةً","بَيضاءَ تَسنَحُ مِن غُرابِ",1,"ب",1,0],["فَقِنيَتُهُ لِلقَنا وَالظُبى","وَقُبِّ الخُيولِ وَبيضِ الخَوَل",2,"ل",1,0],["فَقَناةُ حَرْبِي لا أُرِد تَقْوِيمَها","لِلطَّعْنِ إلّا رَدَّها تَقْوِيسا",3,"س",2,0],["فقنّعت وجهيهما صفرة","كذكريات المذنب الآسف",4,"ف",1,0],["فَکقْنَ الحَيَاءَ، فَقَدْ بَكَيْتَ بِعَوْلَة ٍ","لو كان ينفعُ باكياً إعواله",5,"ل",2,0],["فقنَ: شهدنا أنّ ذا ليسَ كاذباً،","ولكنهُ فيما يقولُ مصدق",6,"ق",1,0],["فقن الرِياض غَضاضة وَنَضارة","وَالراح فعلاً وَالنَسيم تَنَفسا",7,"س",2,0],["فَقنّعَ خِزياً قينقاعَ بنفيهم","وَزوّدهم فَقراً وأسلمهم قفرا",8,"ر",2,0],["فَقُنو حُمرَتِها خِضابُ نَجيعِهِ","وَسَوادُ كِسوَتِها لِباسُ حِدادِ",9,"د",1,0],["فقنَ الخمائلَ نضرةً وعبيرا","والصّبحَ أنساً والنّسيمَ مُرورا",10,"ر",2,1],["فقني بجاهك من هموم الفقر في","الدنيا وَفي الاخرى من النيران",11,"ن",1,0],["فَقَنِعْتُ مِنها بالزّهيدِ تعلُّلاً","والحُبُّ يُقْنَع فِيه بِالإيماء",12,"ا",2,0],["فقنطارُ مالك دون الأذى","ومهجتُه قبلَ دينارِهِ",13,"ر",2,0],["فقناً لغير أكفُّهم لا تقتنى","وظبى لغير بنانهم لم تطبع",14,"ع",1,0],["فقنعنا من وصلكم بالتمنّي","ورضينا منكم بليَّ الوعودِ",15,"د",1,0],["فق نديمي من نوم عقلك واركع","لغواني الوجود واسجد لَهُنَّهْ",16,"ن",2,0]]}