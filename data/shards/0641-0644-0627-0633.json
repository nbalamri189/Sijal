{"poems":[[53,"إلى أين مرمى قصدها وسراها","https://www.aldiwan.net/poem29634.html","الطويل"],[53,"إذا احتبى بالعشب الوادي","https://www.aldiwan.net/poem30630.html","السريع"],[77,"وهت مني القوى بطريق شاط","https://www.aldiwan.net/poem36481.html","الوافر"],[73,"لبيض الطلى ولسود اللمم","https://www.aldiwan.net/poem11934.html","المتقارب"],[73,"للحب في تلك القباب مراد","https://www.aldiwan.net/poem11948.html","الكامل"],[72,"بروضة حسن والعذار سياجها","https://www.aldiwan.net/poem18452.html","الطويل"],[72,"لعمري لقد حفت بأمن وصحة","https://www.aldiwan.net/poem18507.html","الطويل"],[72,"حمدت دموعي إذ وفت بوعودها","https://www.aldiwan.net/poem18562.html","الكامل"],[51,"أراحنا الله منك يا قذره","https://www.aldiwan.net/poem63010.html","البسيط"],[51,"أغر أناسا أن تجافيت عنهم","https://www.aldiwan.net/poem64685.html","الطويل"],[89,"إليك تتوق أيتها السماء","https://www.aldiwan.net/poem44967.html","الوافر"],[85,"صغار بحلوان تستبشر","https://www.aldiwan.net/poem8065.html","المتقارب"],[85,"فتى العقل والنغمة العاليه","https://www.aldiwan.net/poem8108.html","المتقارب"],[43,"عقبى اليمين على عقبى الوغى ندم","https://www.aldiwan.net/poem10529.html","البسيط"],[45,"أنبيك عن عيني وطول سهادها","https://www.aldiwan.net/poem63499.html","الطويل"],[45,"قالت أشدت بكل ما أخفيته","https://www.aldiwan.net/poem63536.html","الخفيف"],[45,"مرضت فأمرضت القلوب وجانبت","https://www.aldiwan.net/poem64554.html","الطويل"],[74,"شراب الأماني لو علمت سراب","https://www.aldiwan.net/poem12869.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42734","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42720","الطويل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/862","المتقارب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43811","المنسرح"],[77,"وهت مني القوى بطريق شاط","https://www.poetsgate.com/ViewPoem.aspx?id=34107",""],[100,"مسافرة بلا مهمة","https://www.poetsgate.com/ViewPoem.aspx?id=50437",""],[108,"انكساري","https://www.poetsgate.com/ViewPoem.aspx?id=34733",""],[51,"جرى لك الطائر السعيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=27669",""],[115,"لكل مقام في مقال الهوى سر","https://www.aldiwan.net/poem41118.html","عموديه"],[143,"دعوا القول فيمن جاد منا ومن ضنا","https://www.aldiwan.net/poem11826.html","الطويل"],[150,"تزودت من مدح النبي المؤيد","https://www.aldiwan.net/poem68589.html","الطويل"],[160,"كذا فليعاني الملك من أعطي الملكا","https://www.aldiwan.net/poem58826.html","الطويل"],[160,"جرى لك في خرق العوائد والعرف","https://www.aldiwan.net/poem58901.html","الطويل"],[160,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[182,"تصبر وإن لم تملك الصبر فاجزع","https://www.aldiwan.net/poem67051.html","الطويل"],[222,"لولا محياك والقوام","https://www.aldiwan.net/poem55463.html","مخلع البسيط"],[252,"سقى دمشق وأياماً مضت فيها","https://www.aldiwan.net/poem1480.html",""],[320,"لما تمادى على بعادي","https://www.aldiwan.net/poem61749.html","مخلع البسيط"],[342,"فلاسفة الأرض أزعجتم","https://www.aldiwan.net/poem55376.html","المتقارب"],[353,"تقارن النيران الشمس والقمر","https://www.aldiwan.net/poem40339.html","البسيط"],[364,"ألم تر أن الدهر يكتب ما تملي","https://www.aldiwan.net/poem60792.html","الطويل"],[364,"هو ما علمت فأقصري أو فاعذلي","https://www.aldiwan.net/poem60809.html","الكامل"],[364,"أثرها فقد طال الغداة وقوعها","https://www.aldiwan.net/poem60849.html","الطويل"],[364,"طربت لإلمام الخيال المعاود","https://www.aldiwan.net/poem60962.html","الطويل"],[365,"يا أسفا على خزز بن عمرو","https://www.aldiwan.net/poem44499.html","الوافر"],[366,"لكل مودة أجر وأجري","https://www.aldiwan.net/poem17316.html","الوافر"],[366,"أما فوقها إلا نجود وأنهم","https://www.aldiwan.net/poem17330.html","الطويل"],[406,"لنفسك لم لا عذر قد نفذ العذر","https://www.aldiwan.net/poem50166.html","الطويل"],[416,"ألا إن هذا الفؤاد اضطرم","https://www.aldiwan.net/poem54173.html","المتقارب"],[437,"فؤاد عصاه صبره وهو طالبه","https://www.aldiwan.net/poem2577.html","الطويل"],[439,"كفي شئونك ساعة فتأملي","https://www.aldiwan.net/poem34808.html","الكامل"],[449,"الجود والمجد","https://www.aldiwan.net/poem973.html",""],[458,"نعم هذه يا دهر أم المصائب","https://www.aldiwan.net/poem56291.html","الطويل"],[461,"كأن رياض الحزن هبت لها الصبا","https://www.aldiwan.net/poem15139.html","الطويل"],[461,"تعدتك أعراض الخطوب وجانبت","https://www.aldiwan.net/poem15441.html","الطويل"],[464,"عزاء فمن ودعته ليس يرجع","https://www.aldiwan.net/poem3395.html","عموديه"],[464,"سرت موهناً لا أبعد الله مسراها","https://www.aldiwan.net/poem3493.html","عموديه"],[495,"كذا من شام بارقة الثنايا","https://www.aldiwan.net/poem10288.html","الوافر"],[497,"ألا فابكي أعيني لا تملي","https://www.aldiwan.net/poem2034.html","الوافر"],[514,"إلى الله نشكو فادحات النوائب","https://www.aldiwan.net/poem20840.html","الطويل"],[529,"يا ناقدا لكلام ليس يفهه","https://www.aldiwan.net/poem37468.html","البسيط"],[551,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"],[551,"ألم تسأل الطلل الدارسا","https://www.aldiwan.net/poem47752.html","المتقارب"],[553,"عرفت بها الأشجان وهي خلية","https://www.aldiwan.net/poem68327.html","الطويل"],[553,"طلائع شيب سير أسرعها رسل","https://www.aldiwan.net/poem68424.html","الطويل"]],"verses":[["فَلا سُقِيَت إِلّا الصَوارِمَ وَالقَنا","وَلا صابَ إِلّا بِالدِماءِ حَياها",0,"ا",3,0],["فَلا سَقاكِ اللَهُ مِن صَفوِهِ","أَو تُنجِزي في السَيرِ ميعادي",1,"ي",1,0],["فلا سنّى الإلاهُ مَزارَ شاطٍ","إذا ما شاطَ شطَّ بِها المَزارُ",2,"ر",1,0],["فَلا سامِيَ الطَرفِ إِلّا أَذَلُّ","وَلا شامِخَ الأَنفِ إِلّا رَغَم",3,"م",1,0],["فَلِأَسحَبَن ذَيلَ المُنى في ساحَةٍ","إِلّا أُوَفَّ بِها المُنى فَأُزادُ",4,"د",1,0],["فلا سؤددٌ إلاَّ إليكَ معاده","ولا مدحةٌ إلاَّ إليكَ معاجها",5,"ج",3,0],["فلا سقمٌ إلاَّ بجفنِ مليحةٍ","ولا عارضٌ إلاَّ بخدِّ مليح",6,"ح",1,0],["فلأسْمعنَّك ما ترنمَ صادح","مدحاً يصغّر ماضيات وليدها",7,"د",3,0],["فلا سقى اللَّه ربع عاشقها","ما عاش صوبَ السحابة الهَمِره",8,"ر",2,0],["فلا سارق شخصي من العين رَهبةً","ولا خافضٌ رِزِّي لمن يتوجس",9,"س",1,0],["فلا سقيا ولا رعيا لأرضٍ","تُراق على جوانبها الدماءُ",10,"ا",2,0],["فَلاسِفَةٌ كُلُّهُم في اِتِّفاقٍ","كَما اِتَّفَقَ الآلُ وَالمَعشَرُ",11,"ر",1,0],["فَلا سوقَةٌ لَم تَكُن أُنسَهُ","وَلا مَلِكٌ لَم تَزِن نادِيَه",12,"ي",2,0],["فَلا سَقى الغَيثُ ما واراهُ مِن شَجَرٍ","لَو زَلَّ عَنهُ لَوارَت شَخصَهُ الرَخَمُ",13,"م",1,0],["فَلا سُقِيَت غَيثاً دِمَشقَ وَلا غَدَت","عَليها غَوادي مُزنَةٍ لِعِهادِها",14,"د",3,0],["فَلَأَسكُتَنَّ فَلا أَبوحُ بِسِرِّكُم","حَتّى كَأَنّي في سُكوتي صاعِدُ",15,"د",1,0],["فَلا سُقِيَت مِصرٌ وَلا مَدَّ نيلُها","وَلادَبَّ في أَغصانِها الوَرَقُ النَضرُ",16,"ر",1,0],["فَلا سَعيَ إِلّا أَن يَكونَ لِآجِلٍ","وَلا ذُخرَ إِلّا أَن يَكونَ ثَوابُ",17,"ب",1,0],["فَلا سِنَادٌ وَلا حَشْوٌ وَلا قَلَقٌ","وَلا سُقُوطٌ وَلا سَهْوٌ وَلا عِلَلُ",18,"ل",1,0],["فَلا سِرُّهُ يَبْدُو وَلا نَحْنُ نَرْعَوِي","وَلا شَأْوُهُ يَدْنُو وَلا نَحْنُ نَلْحَقُ",19,"ق",1,0],["فَلا سَلِمَت مُقلَةٌ لَم تَسُحُّ","وَلا بَقِيَت لِمَّةٌ لَم تَشِب",20,"ب",1,0],["فَلا سَقى رَبعِيَ الرَبيعُ وَلا","أَمرَعَ إِلّا بِالدَمعِ مَرعاهُ",21,"ا",2,0],["فلا سن الإله مزار شاط","إذا ما شاط شط بها المزار",22,"ر",1,0],["فلأسافر كعادتي ، كلّ قفر","ذبت في نبته سكنت صفيره",23,"ر",2,0],["فلا سكتت .. تروح بالطيش اتحكيني","رجعي بطبعك وبسلوبك حضاري",24,"ر",2,0],["فلا سُهِّل الوعْرُ وهو حَزْنٌ","فيك وقد هُوِّن الشديد",25,"د",1,0],["فلا سحت الانواء ان غاب نوركم","ولا اعشوشبت ارض ولا لمع البدر",26,"ر",1,0],["فَلا سَقَتِ الأَنواءُ رائِدَ نُجعَةٍ","رَأى الغَيثَ في كَفَّيكَ وَاِنتَجَعَ المُزنا",27,"ن",2,0],["فَلا سَهوَ في فِكرٍ وَلا وَهمَ مِن لَفظِ","سَناهُ عَلى نورِ الكَواكِبِ مُعتَلٍ",28,"ل",1,0],["فلا سعد إلا دون سعدك أنه","أذل لك الأعدا ودكهم دكا",29,"ك",2,0],["فلا سعد الا ما ينال به الفتى","امانيه من غير لوم ولا قذف",30,"ف",1,0],["فلاسفة باسم التصوف أبرزوا","عقائد كفر بالمهيمن ظاهر",31,"ر",1,0],["فَلا ساءَتِ الدُنيا بِهِم لَكَ مُهجَةً","وَلا كَدّرَت أَحداَثُها طيبَ مَنجعِ",32,"ع",1,0],["فلا سها والسهاد حظ","من لحظه والورى نيام",33,"م",1,0],["فَلا سَقى اللَهُ أَشواقي بِرؤيَتها","ان راقَ عَيني شيء بَعدَ فَقديها",34,"ي",3,0],["فَلا سَبيلاً إِلى خَلاصي","وَلا مَعيناً عَلى السُهّادِ",35,"د",1,0],["فلاسفة الأرض أزعجتمُ","بني الأرض سعياً وراء الحجر",36,"ر",1,1],["فَلا سرت عَن رُبوع الفَضل سارية","أَو تحمد الغايتان الوِرد وَالصَدرُ",37,"ر",1,0],["فلا سلَب الأيّامُ منك بَهاءها","فما أنت إلاّ حِليةُ الزَّمنِ العُطْل",38,"ل",1,0],["فلأسْمُونَّ إلى العَلاء بهِمّةٍ","طَمّاحةٍ تَرمي الكواكبَ من عَل",39,"ل",1,0],["فلا سَلِمَتْ نَفسٌ شديدٌ نِزاعُها","إذا هي لم تُصبِحْ شديداً نُزوعها",40,"ع",3,0],["فلا سَدَّدَ الأيامُ نَحوَك سَهْمَها","ولا رَمَتِ الأعداءَ إلا بصارد",41,"د",1,0],["فلا سُقِّيتِ يا كفّي الغَوَادي","ولاقَيتِ البلاءَ وكلَّ نَحسِ",42,"س",1,0],["فَلا سُبُلٌ إِلى البُقيا بِشَخصي","وَلا سُبُلٌ إِلى البُقيا بِذِكري",43,"ي",1,0],["فَلا ساءَني وَجهٌ مِنَ اللَيلِ قاطِبُ","وَلا سَرَّني وَجهٌ مِنَ الصُبحِ يَبسِمُ",44,"م",1,0],["فَلا سائِلٌ عَنّي فأعذر صاحِباً","وَلا لَكَ في تَركِ السُؤالِ بِنا عُذرُ",45,"ر",1,0],["فلا سَلِمَ الصَّبرُ من مغرم","إذا ذكر الحي في ذي سَلَم",46,"م",1,0],["فلا سوف للآداب إلا بأن ترى","مليّا بعز ليس يقلع راتبه",47,"ب",2,0],["فَلأُسْلِمَنَّ إِلَيْهِ هِمَّةَ نازِعٍ","وحبالَ منقطعٍ وكفَّ مُؤَمِّلِ",48,"ل",1,0],["فلا سجون ولا كبت ولا ضعة","ولا مؤاخذة إلا بما كسبوا",49,"ب",3,0],["فلا سَنَنٌ إلا محجَّةُ تائِهٍ","ولا أملٌ إلا مطيَّةُ خائبِ",50,"ب",1,0],["فلا سبق إلا من قصيٍّ ونازحٍ","ولا ضربَ إلا في طُلىً وجماجمِ",51,"م",1,0],["فلا سيف اِلا وهو للعزم مُذْعنٌ","ولا غيث الا شاهدٌ للرغائبِ",52,"ب",1,0],["فلا سُلَّ سيف البرق في غمد مزنةٍ","ولا هتفت ورقاء في الأيك تسجع",53,"ع",1,0],["فلا سمعتْ إلاَّ بكاءَ حمامة","ولا ضاحكت إلاَّ من البراق أفواها",54,"ا",3,0],["فلا سُقِيت نَداً تلك الثنايا","ولا وقيت ردى تلك النجايا",55,"ا",3,0],["فَلا سَلِمَت عَشيرتنا وَعادَت","إِذا صُرِعَ اِبنُ رُوحانَ النَّبِيلُ",56,"ل",1,0],["فلا سلِمَتْ نفْسٌ من الوَجدِ لم تَذُبْ","عليهِ ولا قلبٌ غَدا غيرَ واجِبِ",57,"ب",1,0],["فَلا سَقَى اللهُ أَرْضاً يُسْتَضَامُ بِها","أُسْدُ الشَّرَى وَبِها يَسْتأْسِدُ النَّقَدُ",58,"د",1,0],["فَلا سَقى اللَّهُ وادياً حلّه الس","سوءاتُ لمّا حللتَه الدِّيَما",59,"م",2,0],["فَلا سَكَنوا بَعدَهُ مَنزِلاً","ولا شمّتوا بعده عاطسا",60,"س",2,0],["فَلا سِيَّما العُذّالُ فيها مَلامَهُم","أَلَستُ إِذا لاموا أَبيتُ وَلي عِذرُ",61,"ر",1,0],["فَلا سَلِمَ حَتّى تَستَقيدُ إِلى الرِضى","وَيَحتَرِشُ الغِلَّ المَوَدَّةُ وَالبَذلُ",62,"ل",1,0]]}