,"الاقتراب الخطير","https://www.poetsgate.com/ViewPoem.aspx?id=180656",""],[5804,"كورونا والحدود","https://www.poetsgate.com/ViewPoem.aspx?id=214739",""],[5879,"السودان","https://www.poetsgate.com/ViewPoem.aspx?id=215936",""],[5943,"بهيُّ الشِّعرِ","https://www.poetsgate.com/ViewPoem.aspx?id=34291",""],[4442,"قبلت خديه وهو نائم","https://www.poetsgate.com/ViewPoem.aspx?id=171022",""],[6125,"جُنَاةُ الأمسِ","https://www.poetsgate.com/ViewPoem.aspx?id=210567",""],[6136,"عبرة إلى الشام","https://www.poetsgate.com/ViewPoem.aspx?id=36239",""],[6152,"العناق","https://www.poetsgate.com/ViewPoem.aspx?id=201768",""],[469,"تجلى لطرفي وجهها تحت شنفها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574801",""],[520,"أرى كل جمع بالردى يتفرق","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577582",""]],"verses":[["فَلا سُقِيَت إِلّا الصَوارِمَ وَالقَنا","وَلا صابَ إِلّا بِالدِماءِ حَياها",0,"ا",3,0],["فَلا سَقاكِ اللَهُ مِن صَفوِهِ","أَو تُنجِزي في السَيرِ ميعادي",1,"د",2,0],["فلا سنّى الإلاهُ مَزارَ شاطٍ","إذا ما شاطَ شطَّ بِها المَزارُ",2,"ر",1,0],["فَلا سامِيَ الطَرفِ إِلّا أَذَلُّ","وَلا شامِخَ الأَنفِ إِلّا رَغَم",3,"م",1,0],["فَلِأَسحَبَن ذَيلَ المُنى في ساحَةٍ","إِلّا أُوَفَّ بِها المُنى فَأُزادُ",4,"د",1,0],["فلا سؤددٌ إلاَّ إليكَ معاده","ولا مدحةٌ إلاَّ إليكَ معاجها",5,"ج",3,0],["فلا سقمٌ إلاَّ بجفنِ مليحةٍ","ولا عارضٌ إلاَّ بخدِّ مليح",6,"ح",1,0],["فلأسْمعنَّك ما ترنمَ صادح","مدحاً يصغّر ماضيات وليدها",7,"د",3,0],["فلا سقى اللَّه ربع عاشقها","ما عاش صوبَ السحابة الهَمِره",8,"ر",2,0],["فلا سارق شخصي من العين رَهبةً","ولا خافضٌ رِزِّي لمن يتوجس",9,"س",1,0],["فلا سقيا ولا رعيا لأرضٍ","تُراق على جوانبها الدماءُ",10,"ا",2,0],["فَلاسِفَةٌ كُلُّهُم في اِتِّفاقٍ","كَما اِتَّفَقَ الآلُ وَالمَعشَرُ",11,"ر",1,0],["فَلا سوقَةٌ لَم تَكُن أُنسَهُ","وَلا مَلِكٌ لَم تَزِن نادِيَه",12,"ي",2,0],["فَلا سَقى الغَيثُ ما واراهُ مِن شَجَرٍ","لَو زَلَّ عَنهُ لَوارَت شَخصَهُ الرَخَمُ",13,"م",1,0],["فَلا سُقِيَت غَيثاً دِمَشقَ وَلا غَدَت","عَليها غَوادي مُزنَةٍ لِعِهادِها",14,"د",3,0],["فَلَأَسكُتَنَّ فَلا أَبوحُ بِسِرِّكُم","حَتّى كَأَنّي في سُكوتي صاعِدُ",15,"د",1,0],["فَلا سُقِيَت مِصرٌ وَلا مَدَّ نيلُها","وَلادَبَّ في أَغصانِها الوَرَقُ النَضرُ",16,"ر",1,0],["فَلا سَعيَ إِلّا أَن يَكونَ لِآجِلٍ","وَلا ذُخرَ إِلّا أَن يَكونَ ثَوابُ",17,"ب",1,0],["فَلا سِنَادٌ وَلا حَشْوٌ وَلا قَلَقٌ","وَلا سُقُوطٌ وَلا سَهْوٌ وَلا عِلَلُ",18,"ل",1,0],["فَلا سِرُّهُ يَبْدُو وَلا نَحْنُ نَرْعَوِي","وَلا شَأْوُهُ يَدْنُو وَلا نَحْنُ نَلْحَقُ",19,"ق",1,0],["فَلا سَلِمَت مُقلَةٌ لَم تَسُحُّ","وَلا بَقِيَت لِمَّةٌ لَم تَشِب",20,"ب",1,0],["فَلا سَقى رَبعِيَ الرَبيعُ وَلا","أَمرَعَ إِلّا بِالدَمعِ مَرعاهُ",21,"ا",2,0],["فلا سن الإله مزار شاط","إذا ما شاط شط بها المزار",22,"ر",1,0],["فلأسافر كعادتي ، كلّ قفر","ذبت في نبته سكنت صفيره",23,"ر",2,0],["فلا سكتت .. تروح بالطيش اتحكيني","رجعي بطبعك وبسلوبك حضاري",24,"ر",2,0],["فلا سُهِّل الوعْرُ وهو حَزْنٌ","فيك وقد هُوِّن الشديد",25,"د",1,0],["فلا سحت الانواء ان غاب نوركم","ولا اعشوشبت ارض ولا لمع البدر",26,"ر",1,0],["فَلا سَقَتِ الأَنواءُ رائِدَ نُجعَةٍ","رَأى الغَيثَ في كَفَّيكَ وَاِنتَجَعَ المُزنا",27,"ن",2,0],["فَلا سَهوَ في فِكرٍ وَلا وَهمَ مِن لَفظِ","سَناهُ عَلى نورِ الكَواكِبِ مُعتَلٍ",28,"ل",1,0],["فلا سعد إلا دون سعدك أنه","أذل لك الأعدا ودكهم دكا",29,"ك",2,0],["فلا سعد الا ما ينال به الفتى","امانيه من غير لوم ولا قذف",30,"ف",1,0],["فلاسفة باسم التصوف أبرزوا","عقائد كفر بالمهيمن ظاهر",31,"ر",1,0],["فَلا ساءَتِ الدُنيا بِهِم لَكَ مُهجَةً","وَلا كَدّرَت أَحداَثُها طيبَ مَنجعِ",32,"ع",1,0],["فلا سها والسهاد حظ","من لحظه والورى نيام",33,"م",1,0],["فَلا سَقى اللَهُ أَشواقي بِرؤيَتها","ان راقَ عَيني شيء بَعدَ فَقديها",34,"ي",3,0],["فَلا سَبيلاً إِلى خَلاصي","وَلا مَعيناً عَلى السُهّادِ",35,"د",1,0],["فلاسفة الأرض أزعجتمُ","بني الأرض سعياً وراء الحجر",36,"ر",1,1],["فَلا سرت عَن رُبوع الفَضل سارية","أَو تحمد الغايتان الوِرد وَالصَدرُ",37,"ر",1,0],["فلا سلَب الأيّامُ منك بَهاءها","فما أنت إلاّ حِليةُ الزَّمنِ العُطْل",38,"ل",1,0],["فلأسْمُونَّ إلى العَلاء بهِمّةٍ","طَمّاحةٍ تَرمي الكواكبَ من عَل",39,"ل",1,0],["فلا سَلِمَتْ نَفسٌ شديدٌ نِزاعُها","إذا هي لم تُصبِحْ شديداً نُزوعها",40,"ع",3,0],["فلا سَدَّدَ الأيامُ نَحوَك سَهْمَها","ولا رَمَتِ الأعداءَ إلا بصارد",41,"د",1,0],["فلا سُقِّيتِ يا كفّي الغَوَادي","ولاقَيتِ البلاءَ وكلَّ نَحسِ",42,"س",1,0],["فَلا سُبُلٌ إِلى البُقيا بِشَخصي","وَلا سُبُلٌ إِلى البُقيا بِذِكري",43,"ر",2,0],["فَلا ساءَني وَجهٌ مِنَ اللَيلِ قاطِبُ","وَلا سَرَّني وَجهٌ مِنَ الصُبحِ يَبسِمُ",44,"م",1,0],["فَلا سائِلٌ عَنّي فأعذر صاحِباً","وَلا لَكَ في تَركِ السُؤالِ بِنا عُذرُ",45,"ر",1,0],["فلا سَلِمَ الصَّبرُ من مغرم","إذا ذكر الحي في ذي سَلَم",46,"م",1,0],["فلا سوف للآداب إلا بأن ترى","مليّا بعز ليس يقلع راتبه",47,"ب",2,0],["فَلأُسْلِمَنَّ إِلَيْهِ هِمَّةَ نازِعٍ","وحبالَ منقطعٍ وكفَّ مُؤَمِّلِ",48,"ل",1,0],["فلا سجون ولا كبت ولا ضعة","ولا مؤاخذة إلا بما كسبوا",49,"ب",3,0],["فلا سَنَنٌ إلا محجَّةُ تائِهٍ","ولا أملٌ إلا مطيَّةُ خائبِ",50,"ب",1,0],["فلا سبق إلا من قصيٍّ ونازحٍ","ولا ضربَ إلا في طُلىً وجماجمِ",51,"م",1,0],["فلا سيف اِلا وهو للعزم مُذْعنٌ","ولا غيث الا شاهدٌ للرغائبِ",52,"ب",1,0],["فلا سُلَّ سيف البرق في غمد مزنةٍ","ولا هتفت ورقاء في الأيك تسجع",53,"ع",1,0],["فلا سمعتْ إلاَّ بكاءَ حمامة","ولا ضاحكت إلاَّ من البراق أفواها",54,"ا",3,0],["فلا سُقِيت نَداً تلك الثنايا","ولا وقيت ردى تلك النجايا",55,"ا",3,0],["فَلا سَلِمَت عَشيرتنا وَعادَت","إِذا صُرِعَ اِبنُ رُوحانَ النَّبِيلُ",56,"ل",1,0],["فلا سلِمَتْ نفْسٌ من الوَجدِ لم تَذُبْ","عليهِ ولا قلبٌ غَدا غيرَ واجِبِ",57,"ب",1,0],["فَلا سَقَى اللهُ أَرْضاً يُسْتَضَامُ بِها","أُسْدُ الشَّرَى وَبِها يَسْتأْسِدُ النَّقَدُ",58,"د",1,0],["فَلا سَقى اللَّهُ وادياً حلّه الس","سوءاتُ لمّا حللتَه الدِّيَما",59,"م",2,0],["فَلا سَكَنوا بَعدَهُ مَنزِلاً","ولا شمّتوا بعده عاطسا",60,"س",2,0],["فَلا سِيَّما العُذّالُ فيها مَلامَهُم","أَلَستُ إِذا لاموا أَبيتُ وَلي عِذرُ",61,"ر",1,0],["فَلا سَلِمَ حَتّى تَستَقيدُ إِلى الرِضى","وَيَحتَرِشُ الغِلَّ المَوَدَّةُ وَالبَذلُ",62,"ل",1,0],["فَلا سِلمَ إِلّا أَن نَقودَ إِلَيهِمُ","عَناجيجَ يَتبَعنَ القِلاصَ الرَواتِكا",63,"ك",2,0],["فلا سهل إلاَّ فيه منه إغارة","ولا وعر إلا فوقه حلَّ ناهبُهْ",64,"ب",2,0],["فلا سمع الا أن يغرد بلبل","ولا شم الا أن يفوح خلوق",65,"ق",1,0],["فلا سَدوَ إِلاَّ سَدوُهُ وهو مدبر","ولا أَتوَ إِلاَّ أَتوُهُ وهو مقبلُ",66,"ل",1,0],["فلا سيف إلا ما هززت ولا فتى","سواك لها يرجى إذا صعب الأمر",67,"ر",1,0],["فلا سلم حتى تشجر الخيل بالقنا","وتُضرب هامات الرجال الأماثل",68,"ل",1,0],["فلا سكت على عجز كمن سكتوا","ولا سجعت بمطروق كمن سجعوا",69,"ع",3,0],["فَلا سِعَةُ الأَموالِ تَبلُغُ جودَه","وَلا ضيقُها يَنهاهُ أَن يَتَوَسَّعا",70,"ع",2,0],["فلأسر عن الى المعالى عزمتى","ولأرفضن تثبطى وقعودى",71,"د",2,0],["فلا سحنون شاكله بعلم","ولا لا في الحديث أبو الزناد",72,"د",1,0],["فلا سلم حتى تحفز الناس خيفةٌ","ويصبح طيرٌ كانساتٍ على لحم",73,"م",1,0],["فلا سمت بي المعالي أو سمت لي في","مدح ابن أحمد أوتاد وأوزان",74,"ن",1,0],["فلا سِنخَ إِلّا سِنخُهُ وَنِجارُهُ","وَلا فَرعَ إِلّا فَرعُهُ وَمَحاتِدُه",75,"د",2,0],["فلا سقت الأنواء إلا مفاوزًا","بطون ثراها لو وعت للعلى لحد",76,"د",1,0],["فلا سَقَتكَ من الوسمي غاديةٌ","ولا سقت ارض عِمرانَ بنِ حِطّانا",77,"ن",2,0],["فلا سُلَّ سيف البرق بين هضابه","ولا طُلَّ بعدي بانه المتناوح",78,"ح",1,0],["فلا سابقٌ يزهو لتاخيرِ ذكره","لإلحاقه فيه باهل المظالم",79,"م",1,0],["فَلَاسمكِ مِثلَها الخَمسونَ حَظّاً","بِمَن بِالجُمَّلِ اِعتَمَدَ الحِسابا",80,"ب",2,0],["فلاسمك في الأملاك سعد مجدد","وحسبك أخبار بها اتصل النقلُ",81,"ل",1,1],["فلاسفةٌ في البحث لجوا وأنما","رأوا لججاً في البحث ليس لها سبَر",82,"ر",1,0],["فلا سؤدد الا ونعلاه تاجه","ولا شامخ الا ويرنوه اسفلا",83,"ل",2,0],["فلأسرارِ النَجدَينِ دَعَت","وغيابُ الأسرار إجتَمَعت",84,"ت",1,0],["فلا سلب الأولاد ظلك سرمداً","فإنهم نبت وأنت لهم قطر",85,"ر",1,0],["فَلا سَبيلَ إِلى السُلوانِ عَن قَمَرٍ","بَل اَستعيذُ إِذا شَيطانه نَزَغا",86,"غ",2,0],["فلا سلمت أكف فتى كريم","يحيد عن القراع ويستحيل",87,"ل",1,0],["فلا سهرٌ في ليلها أو تشرُّدٌ","رقادٌ الى أن يأذن الصبح بالمسعى",88,"ا",1,0],["فلا سلمت من حذري وخوفي","متى سلمت صفاتك من لساني",89,"ن",2,0],["فلا سبيل إِلى صحوي وقد جليت","ولا أبالي بمن في شربها قدحا",90,"ح",2,0],["فلا سقاك الله الا القذي","بعد ولا ارع