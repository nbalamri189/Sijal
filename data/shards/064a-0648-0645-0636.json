{"poems":[[65,"أماط والليل أثيث الجناح","https://www.aldiwan.net/poem46168.html","السريع"],[107,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[50,"لضوء برق ظللت مكتإبا","https://www.aldiwan.net/poem10770.html","المنسرح"],[124,"يا حبذا أمسى من","https://www.aldiwan.net/poem49366.html","مجزوء الرجز"],[234,"وصامت الجو بعيد الفرقد","https://www.aldiwan.net/poem51126.html","الكامل"],[333,"بين همس الشفاه والأحداق","https://www.aldiwan.net/poem55024.html","الخفيف"],[369,"عدد لكم أن سرت في تشييعي","https://www.aldiwan.net/poem60845.html","الكامل"],[422,"من يحاول في الدهر مجدا أثيلا","https://www.aldiwan.net/poem54123.html","الخفيف"],[466,"وصاحب من بني الآمال خضت به","https://www.aldiwan.net/poem15303.html","البسيط"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88609","الخفيف"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113918","الخفيف"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29276","الخفيف"],[4679,"ما درت مثل عيدك الأعيادُ","https://www.poetsgate.com/ViewPoem.aspx?id=142749",""],[5360,"يانخيل العراق","https://www.poetsgate.com/ViewPoem.aspx?id=33241",""],[5795,"نصرت دولة المهى التركيه","https://www.poetsgate.com/ViewPoem.aspx?id=167910",""]],"verses":[["يومِضُ بالبَرْقِ وكمْ حارَدَتْ","بوَدْقِهِ أطْباؤُهُ حينَ لاحْ",0,"ح",1,0],["يَومَ ضَجّتْ جِبالُ مكّةَ ذُعراً","وَتَمنَّتْ هِضابُها أن تمورا",1,"ر",2,0],["يومِضُ في ضاحِكِ النَواجِذِ مَح","ذُوٌّ بِريحَينِ شَمأَلٍ وَصَبا",2,"ب",2,0],["يومض فيها طلها","مبتسماً إلى الغدر",3,"ر",1,0],["يُومِض في نِشاصِهِ المعمَّد","كصفحَة السيف إذا لم يُغْمَدِ",4,"د",1,0],["يوم ضاقت بما تكنُّ جفوني","من دموع على الصبا والشباب",5,"ب",1,0],["يُومضْنَ منه في الأناملِ جِرْيةً","إيماضَ برْقٍ في الحَبيِّ لَموع",6,"ع",1,0],["يوم ضاقَ الرَّحب الفسيح عليها","فتنادت عنك الرَّحيل الرَّحيلا",7,"ل",2,0],["يؤمُّ ضِيفانُه خِرْقاً أخا سَرَفٍ","لا يكْسعِ الشَّوْلَ من بخل بأغبارِ",8,"ر",1,0],["يوم ضمَّ الصَعيد منا هماماً","ملء برديه عفة واباءا",9,"ا",3,0],["يومَ ضاقَت علهيمُ سعَةُ الأر","ضِ فلاذوا بهِ ولاتَ لجاءُ",10,"ا",2,0],["يومِضُ اللَيلُ بِالسَنا مُستَطاراً","في اِصفِرارٍ يَحكي اِصفِرارِ الأَقاحى",11,"ح",2,0],["يومض البرق لمحة كشهابٍ","ثم يتلو وميضهُ الإرعادُ",12,"د",1,0],["يوم ضاقت بنا السنون ولج الكرب","فينا واحمرت الأحداق",13,"ق",1,0],["يومض الذهن من تلاق لإيجا","بية الحكم فيه والسلبيه",14,"ي",2,0]]}