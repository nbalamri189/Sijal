{"poems":[[74,"ما لظبي الحمى إليه التفاته","https://www.aldiwan.net/poem18387.html","الخفيف"],[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[87,"رأى قفاك الذي رآه","https://www.aldiwan.net/poem7550.html","مخلع البسيط"],[87,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[30,"ألم يك جهلاً بعد سبعين حجة","https://www.aldiwan.net/poem1285.html",""],[46,"أبو علي وسمي منتجعه","https://www.aldiwan.net/poem30461.html","المنسرح"],[13,"ألا أبلغ بني فهم بن عمرو","https://www.aldiwan.net/poem2203.html","الوافر"],[308,"رأى قصدكم في الهدى أبلجا","https://www.aldiwan.net/poem58222.html","المتقارب"],[463,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[484,"على ضفة الوادي بقتة شاهق","https://www.aldiwan.net/poem37574.html","الطويل"],[567,"رأى قصب السباق بنو الزمان","https://www.aldiwan.net/poem52896.html","الوافر"],[572,"اسلمي يا كثيرة الإعراض","https://www.aldiwan.net/poem69588.html","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119897","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48957","السريع"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28598","الوافر"],[2451,"","https://poetry.dctabudhabi.ae/diwan/poem/103339","الخفيف"],[2705,"","https://poetry.dctabudhabi.ae/diwan/poem/128644","المديد"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76023","الطويل"],[2825,"","https://poetry.dctabudhabi.ae/diwan/poem/130729","الخفيف"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140045",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131278",""],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123455","الخفيف"],[5121,"ناي","https://www.poetsgate.com/ViewPoem.aspx?id=215580",""],[5136,"شرف باذخ رفيع منيف","https://www.poetsgate.com/ViewPoem.aspx?id=121621",""],[6124,"نكتب الأوتار","https://www.poetsgate.com/ViewPoem.aspx?id=121830",""]],"verses":[["رائق الكأس غير أن عتاباً","طالما للمحبِّ كان قذاته",0,"ت",2,0],["رائقة المنظر زهراء الغرر","كأنها الروضات حيّت بالزهر",1,"ر",1,0],["رأى قفاك الذي رآه","سهلا وما كان بالممنّع",2,"ع",1,1],["رَأى قَضاؤُكَ فينا رَأيَ حِكمَتِهِ","أَكرِم بِوَجهِكَ مِن قاضٍ وَمُنتَقِمِ",3,"م",1,0],["رَأى قَومَهُ إِذ كانَ غَدواً جِلادُهُم","مَعَ الصُبحِ حَتّى كادَتِ الشَمسُ تَغرُبُ",4,"ب",1,0],["رائِقُ خَزٍّ يُلتَذُّ مَلمَسُهُ","سَكبٌ يَدينُ الصِبا لِمُدَّرِعِه",5,"ع",2,0],["رَأى قَدَمَيَّ وَقعُهُما حَثيثٌ","كَتَحليلِ الظَليمِ دَعا رِئالَه",6,"ل",2,0],["رأى قصدكم في الهدى أبلجا","فنحوكم عن رجا عرجا",7,"ج",2,1],["رأى قلقي تحتَ أرواقه","فدلَّ الخيال على مضجعِي",8,"ع",2,0],["رأى قصوة في أمره إن فشا به","لها وقبيح أن يرى غير صادق",9,"ق",1,0],["رَأى قَصَبَ السِّباقِ بَنُو الزَّمانِ","فَجدُّوا مثلَ أفرَاسِ الرِّهانِ",10,"ن",1,1],["رَائِقَاتِ الشَّبَابِ مُكْتَسِيَاتٍ","حُلَلاً مِنْ صَنِيْعَةِ الخَلاَّقِ",11,"ق",1,0],["رائق بشره هني نداه","طيب نشره زكي نجاره",12,"ر",2,0],["رأى قناتي بالنهى قُوِّمت","فشاقه في غمزها مصرَعي",13,"ع",2,0],["رَأَى قُربَ الحُسام وَغارَ مِنهُ","فَحاكَمَنا إِلى العَهدِ القَديمِ",14,"م",1,0],["رائقٌ منظراً وخُبراً وفدُّ","في حُلاهُ التي حَلَت وصفاته",15,"ت",2,0],["رائقَ الأمداحِ والغزلِ","جئت نجلَ أكرم الرسلِ",16,"ل",1,1],["رَأى قَمراً قَد صارَ شَمساً فَغَرَّهُ","تنقُّلُ لَونٍ في صَفاءٍ وَرونقِ",17,"ق",1,0],["رائق البشر كلما جئته أبدى","إليك طلاقة في ابتسام",18,"م",1,0],["رأى قلبي يطوف فجاء يسعى","فارمى في مشاعره جمارا",19,"ر",2,0],["رأى قدها غر يد أيكٍ فخاله","أراكاً فأضحى فوقه مترنما",20,"م",2,0],["رائقِ النصح مُستنير المعاني","فائق القول باهر البلغاء",21,"ا",2,0],["رَائِقُ الْحَرْفِ قَدْ أَسَرْتَ الْمَزَايَا","بانْهِمَارٍ أَثَارَ شِعْرَ الحْنَايَا",22,"ي",2,1],["رائقات كأنها قطع الرو","ضة صنع الزهور فيها صنوف",23,"ف",1,0],["رائِقٌ من عذبِ شعرِي والمُنى","في طَرِيقٍ ضَمَّنِي عُمراً معكْ",24,"ك",1,0]]}