"https://www.poetsgate.com/ViewPoem.aspx?id=200252",""],[5431,"تبارك الله أحسن الخالقين...","https://www.poetsgate.com/ViewPoem.aspx?id=203151",""],[5444,"سجن وكراسي","https://www.poetsgate.com/ViewPoem.aspx?id=205076",""],[5689,"أهبت فنلت من قلبي الجوابا","https://www.poetsgate.com/ViewPoem.aspx?id=143429",""],[5756,"الجمهرة","https://www.poetsgate.com/ViewPoem.aspx?id=5430",""],[5880,"بغداد ودمشق","https://www.poetsgate.com/ViewPoem.aspx?id=208577",""],[6102,"حطب الحقد","https://www.poetsgate.com/ViewPoem.aspx?id=183654",""],[6102,"عيد شديد","https://www.poetsgate.com/ViewPoem.aspx?id=184462",""],[6225,"نسيمُ الخلود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81328&r=&rc=355",""],[6244,"ربيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=509&r=&rc=2",""],[463,"أقريشُ لا لفمٍ أراك ولا يدِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60022&r=&rc=78",""]],"verses":[["أَهَبَّت عَلَيهِم قاصِفاً مِن رِياحِها","فَطاروا كَما وَلّى جُفاءُ المَذانِبِ",0,"ب",1,0],["أَهَبْتُ بِهِ وَالعِيسُ مِيلٌ رِقابُها","لِيَبْعُدَ مَسْرَى هَمِّهِ بُعْدَ صِيتِهِ",1,"ت",2,0],["أهَبْتُ بهِ حَيْثُ الهِدانُ منَ السُّرى","لِهامَتِهِ في غَمْرَةِ النّومِ غارِزُ",2,"ز",1,0],["أهَبْتُ وصَرْفُ الدّهْرِ يَحرِقُ نابَهُ","بهِ آمِناً أنْ أسْتَقيمَ ويَظْلَعا",3,"ع",2,0],["أَهَبتَ بِهَذا مِن قُرونٍ ثَلاثَةٍ","وَكُنتَ عَلى تِلكَ الطَبائِعِ تَنقِمُ",4,"م",1,0],["أَهَبتُم بِوِردٍ لَم تُطيقوا ذِيادَهُ","وَقَد يَحشِدُ الأَورادَ مَن لا يَذودُها",5,"د",3,0],["إِهبِطي أَو فَحَلِّقي أَو فَسيري","إِنَّما المُنتَهى إِلى الأَرزاءِ",6,"ا",2,0],["أَهَبتَ فَفَرَّ الظُلمُ بِالأَرضِ هارِباً","وَنَكَّسَ خِزياً رَأسَهُ كُلُّ ظالِمِ",7,"م",1,0],["أَهبَطَني أَمسُ إِلى حُضنِها","شَوقي إِلى سَجعِ قَماريها",8,"ي",3,0],["أَهَبْتُ بقلبي الهلوعِ الجزوعِ","وكانَ مِنْ قبلُ جَلْداً شَديدْ",9,"د",1,0],["آه بل أَنْتَ في الشُّعوبِ عجوزٌ","فيلسوفٌ محطَّمٌ في إهابِهْ",10,"ه",1,0],["أهبتُ بالحظِ لو ناديتُ مستمِعاً","والحظُّ عنِّيَ بالجُهَّالِ في شُغُلِ",11,"ل",1,0],["أهَبُ الفَدامةَ للمبرِّز قاصداً","حيثُ الذلاقةُ والفِناءُ الواسِعُ",12,"ع",1,0],["أَهِب يا اِبنَ راعي الإِبلَ إِنَّكَ لَم تَجِد","أَباً لَكَ في جَيشٍ يَسيرُ وَلا وَفدِ",13,"د",1,0],["أهَبَّ لنا فيه ريحَ النَّدى","رَخاءً تخبِّرنُا بالرَّخاءِ",14,"ا",2,0],["أَهَبتُ بِالحَظِّ لَو نادَيتُ مُستَمِعاً","وَأَسمَعَت كَلِماتي مَن بِهِ صَمَمُ",15,"م",1,0],["أهب ببيانِكَ الصافي تدفق","وقف بالقدس واهتف في رباهُ",16,"ه",1,1],["اهبط على الأزهار وامسح جفنها","واسكب نداك لظامئ صَديان",17,"ن",1,0],["أَهبَبتَ لي ريحَ الرَجاءِ فَأَقدَمَت","هِمَمي بِها حَتّى اِستَبَحنَ هُمومي",18,"م",2,0],["أَهَبَّ لَكُم ريحَ الصَفاءِ جَنائِباً","رُخاءً وَكانَت وَهيَ نُكبٌ سَواهِكُ",19,"ك",1,0],["أَهَبْتُ بِصَبْرِي أَنْ يَعُودَ فَعَزَّنِي","وَنَادَيْتُ حِلْمِي أَنْ يَثُوبَ فَلَمْ يُغْنِ",20,"ن",1,0],["أهَبْتَ بها رُدِّي عِنَانكِ وارْجِعي","فان يَكُ منها مَرجِعٌ فكأَنْ قَدِ",21,"د",1,0],["أَهِبْ بالغافلين وقُلْ بلادي","دَعوتُكِ باسمِ ربّكِ فاسْتَجيبي",22,"ب",2,0],["أَهَبَّ لَهُم فُرسانَ حَربٍ مُطِلَّةٍ","وَخُرساً تَباهى في السَنَوَّرِ حُشَّدا",23,"د",2,0],["أَهَبتُ بَناتِ الصَدرِ بَعدَ رُقادِها","فَأَصبَحنَ قَد وافَينَ غَيرَ رُقودِ",24,"د",1,0],["أَهَبْتَ بِقَوْمِكَ انطَلِقُوا وَرَائِي","فَتِلْكَ سَرِيَّةٌ تتلو سَرِيَّهْ",25,"ي",2,0],["أَهبَطتُه الرَّكبَ أَحبُوهُم أَخَا ثِقَةٍ","رَحب الَجوانِحِ صَلتَ الَخدِّ عَيَّارا",26,"ر",2,0],["أَهبَطتُهُ الرَّكبَ يُعديني وأُلجمُهُ","لِلنَّائباتِ بِسَيرٍ مِخذَمِ الأَكَمِ",27,"م",1,0],["أَهَبْتُ فَعَادَ الصَّوْتُ لَمْ يَقْضِ حَاجَةً","إِلَيَّ وَلَبَّانِي الصَّدَى وَهْوَ طَائِعُ",28,"ع",1,0],["إهبط الحقل والتهم ما تراهُ","وانشر الموت فهو عدلُ جزاء",29,"ا",2,0],["أهبْتُ بالشعر أن يعودا","إلى الصبا ناعماً رغيدَا",30,"د",2,1],["اِهْبطُوا مِصرَ كَمْ بِهَا مِن قلوبٍ","شَفَّها حبكم وكَم من كُبُود",31,"د",1,0],["أهَبْت به -إذ لُذْتُ بالرُّكن- قائلاً:","حَنَانَيْك مَدْعُوًّا، ولَبَيَّك داعيا!",32,"ي",2,0],["أهبَّ له الحواضر والبوادي","وعرِّفْه المَشارفَ والتِلاعا",33,"ع",2,0],["أهبتُ بشبانِ العراقِ وإنَّما","أردتُ بشعري أن أهيجَ سباعا",34,"ع",2,0],["أهبَطني أمسُ إلى حضنِها","شوقي إلى شَجْعِ قماريها",35,"ي",3,0],["اهبطْ على الأزهار وأمسح جفنَها","واسكب نداك لظامىءٍ صَدْيانِ",36,"ن",1,0],["أَهبَطَتَّهُ الرَكبَ يَعديني وَاُلجِمُهُ","لِلنائِباتِ بِسَيرٍ مَجذَمِ الأَكَمِ",37,"م",1,0],["أهبت بالشعر فاستفتحت مغلقه","كنجمة الصبح تحدو نوره الواني",38,"ن",2,0],["أهبت وهناً بذكراكم فما عبأت","شيئاً بصبٍ بجنح الليل دعاء",39,"ا",2,0],["أُهبِطتُ منها إلى قَرارٍ","أمسَت به الروحُ في اعتقال",40,"ل",1,0],["أَهبَطتَ أَقدارَهُم قَسراً وَآنُفَهُم","فَما تَرَكتَ سِوى أَنفاسِهِم صُعُدا",41,"د",2,0],["أَهْبَطْتَ قَلْبِي بَعْدَ ما","أَعْلى مَرَاتِبَهُ العُلُوُّ",42,"و",1,0],["أَهبَطتُهُ الرَكبَ يَعذيني وَأَلجُمُهُ","لِلنائِباتِ بِسَيرٍ مُخَدَّمِ الأَكَمِ",43,"م",1,1],["أَهَبَّ عَلَيْهِمُ الْحَدَثانُ رِيحاً","بِكُلِّ عَجاجَةٍ تُغْري مُثِيرا",44,"ر",2,0],["آه بمولدك الشريف تنوعت","طرق المعاصي في بلاد المسلمين",45,"ن",1,0],["أُهبِطت تستفيدُ منها علوماً","أودعت من طِباعها في صوانِ",46,"ن",1,0],["آه بل أوّاه","ما أروع ما كان خفيّا",47,"ي",2,0],["أَهبَطَهُ مِن راحَةِ الظِلالِ في","دارِ العَنا اِختِيارُهُ عِندَ النَظَر",48,"ر",1,0],["أهبْتُ إلى مَديحِك بالقوافي","فكاد يُسابِقُ الصَّدَرَ الرَّويّ",49,"ي",1,0],["أهبتُ بأشعاري إلى السَّيِّد النَّدْبِ","فجئنَ سِراعاً وانتُدِبْنَ إلى نَدْبي",50,"ب",2,1],["أَهَبُ الكَثيرَ من الكثيرِ فإن لَحَتْ","عُودي وهَبتُ من القَلِيلِ قَليلاَ",51,"ل",2,0],["اهبت وقد جعل الغمام ظليلها","فكانما هو قسطل مسبول",52,"ل",1,0],["أهبتُ به فلم أهزُز كَهاما","إلى غرضي ولم أزجر بطيَّا",53,"ي",2,0],["اِهبِط إلى مُضرٍ فسل حَمراءَهَا","مَن صاح بالبطحاء يا نارُ اخمدي",54,"د",2,0],["أهبتُ بشِعري فانبرت لك عيسُهُ","بما حملتْ وهي الخُضوعُ الخَوابتُ",55,"ت",1,0],["أهب اليراع جلالة","فيطول أطراف الرماح",56,"ح",1,0],["آهِ بُشرى لنا بِعودَة بَاشَا","نا التِّهامي الهمَام ضَيغَمِ غابِ",57,"ب",1,1],["أَهِب يا اِبنَ عِمَرانَ بِشُكري فَإِنَّني","سَميعٌ إِلى الداعي قَريبٌ عَلى البُعدِ",58,"د",1,0],["أَهْبِبْ وأَطِبْ يا رِيحَ وَادِي القُدْسِ","عَنْ جِيرَتِكَ الحُلولِ في نَابِلسِ",59,"س",1,1],["أهِب بي فَلي نَفسٌ إذا ما تَعزَّزت","مَشارِعُها في الوِردِ قَلَّ شُروعُها",60,"ع",3,0],["اهبِط إلى الأرضِ فخذْ جلمداً","ثمّ ارمِهم يا مزنُ بالجَلْمَدِ",61,"د",1,1],["أهبت به للقول وهو لما به","فلبّى ولم يسعده نطق ولا فم",62,"م",1,0],["أهببت لي ريح الرجاء تكرما","فجرت رخاء الخطو ذات نسيمِ",63,"م",1,0],["أهب الذي أوهبتَنيه من اللهى","ثقة بأنك مخلف ما أُتلفُ",64,"ف",1,0],["أهبت بذكريه فولىّ لذكره","قنوطي ولاذت بالفرار هموم",65,"م",1,0],["أهبطت أنوار النجوم إلى الهواء","فإلى الثرى بالماء كي يتجانسا",66,"س",2,0],["أَهِّب عَتاداً لِما تَرجو وَكن حَذِراً","مِن أَن يُفاجيكَ أَمرٌ غَيرُ مَعهودِ",67,"د",1,0],["أهبنا به فاستنَّ عايديه راجفاً","كما انتفض العصفور بلَّله القطر",68,"ر",1,0],["اهبن بها فما أجلين حتى","رأيت حبيكها سال انثماما",69,"م",2,0],["أَهَبتُ بِالشِعرِ فَاِنقادَت شَوارِدُهُ","في مَحفَلٍ بِعَذارى الوَحيِ مُزدَهِرِ",70,"ر",1,0],["أهبَّت به للاشتياق نوازعُ","بأيمن خفان الطلول البلاقع",71,"ع",1,1],["أُهبتُ بهِ يا حب بالله قف هنا","فإنى لا أدرى غداً ماوراءكا",72,"ك",2,0],["أهبت بالشعب يسعى في مودتها","بالمال والجهد إحياء لماضيها",73,"ي",3,0],["أهَّبوا للحرب أرماحاً طوالاً","زاعبياتٍ وأعماراً قصارا",74,"ر",2,0],["أهبت بهم إلى بعث فماتوا","كأن ديارهم منهم خراب",75,"ب",1,0],["أهبَّت لنا من حى لبنى نسائم ال","وصال فأبدت مابنا كان خافيا",76,"ي",2,0],["أهب يا بنَ المُراغَةِ مِن كُلَيبٍ","بِلُؤمٍ لَن تُغَيِّرَهُ طَويلِ",77,"ل",1,0],["أهبوب النسيم ذكّرك الحيّ","وأذكى منك الجوى تذكارا",78,"ر",2,0],["أَهَبَت بِغُرِّ الآبِداتِ فَراجَعَت","طَريقاً أَملَّتهُ القَصائِدُ مَهيَعا",79,"ع",2,0],["آه بالله خبرنيّ من إي","نَ جلبتَ الشفاه والابتساما",80,"م",2,0],["أهبْتَ بودي ولمّا يمتْ","فأسمعت حياً بذاك النداء",81,"ا",2,0],["أهب بأمان الله إن كنت مسلما","وقل أرايت العرش كيف تحطما",82,"م",2,1],["أهبت به ابغي سؤالا فلم يجب","وأقبلت أدعو من أحب فما لبي",83,"ب",2,0],["أهب الراجين ما أحرزته","وأخو البُخلِ بما حاز وثَقْ",84,"ق",1,0],["أهبتَ بالنيل حتى المومياء رنت","ومن أبي الهول حُلَّت عقدة البكم",85,"م",1,0],["أهب به لا لحرب بل لمجدٍ","فهذا يومه الضنك العصيب",86,"ب",1,0],["أَهَبُ الثّناءَ لمجدِ بيتكَ طائعاً","وأبيعُهُ لِسواكَ بَيْعَ المُكرَهِ",87,"ه",1,0],["اِهبِط إلى الأَرضِ وَجد جَلمَداً","ثُمَّ اِرمِهِم يا مُزنُ بِالجَلمَدِ",88,"د",1,0],["أهبّت نفحةً من أرض نجد","ينشر البان أم بانت خيام",89,"م",1,0],["أهبت بذا الدرب الطويل بأن يطوى","فقد طال فيه السير حتى غدا حَبْوَا",90,"و",2,1],["أهبت بهم من غيبهم فتجاوبت","لصوتك أجيال المدى المتطاول",91,"ل",1,0],["أهبت بهم أن يرفقوا فتفرقوا","وقد ضربوا لي ليلة الحشر موعدا",92,"د",2,0],["أهبن بنفسي في خفوتٍ وروعةٍ وسرنً","بهمس ، وهي مأخوذة سكرى",93,"ر",2,0],["آه بلادي أيُّ سلمٍ ترتجي","ونجاسُهم قد دنَّستْ أقداسَنا",94,"ن",2,0],["أهبت بابراهيم تحت رجامه","وهل يستجيب في المقابر جاثم",95,"م",1,0],["أهبت بالعهد القديم صارخا","فما ثنى عنانه ولا لوى",96,"ا",1,0],["آهٍ بلاد الشمس ضاعت فرحتي","تعلو وتهبط فكرة شمّاء",97,"ا",2,0],["أهبت ذذكريه فولّى لذكره","قنوطي ولاذت بالفرار همومُ",98,"م",1,0],["أهبُ المنامَ مبشّري برجوعهم","وأزيد فيه من الندى بثنائه",99,"ا",3,0],["آهٍ.. بنو أمي تذبَّحُ هاهنا","وبنو أبي نحو المنافي تلجأُ",100,"ا",1,0],["آه بها نطقتْ خوارس نظرتي","والقلب طال صداه في ألأحشاء",101,"ا",2,0],["آهٍ بوجدي كمْ يطوّحني الضنى","من ذا سواكِ يحنُّ أو يترفّقُ",102,"ق",1,0],["أهب الدفء للحياة كشمسٍ","أزرع الورد في المدى المعشوق",103,"ق",1,0],["أهبطتُ من علياء جنّته","حتى أكابدَ عيشةً مرّة!!؟",104,"ر",2,0],["(اهبطوا مصرَ) يا بؤسي، وهل بمُحيطِنا","سألقى عَدا هذا السرابَ لنا مصرا؟!",105,"ر",2,0],["أهبت فنلت من قلبي الجوابا","وناجيت الهوى مني فثابا",106,"ب",2,1],["أهب ياوجه الحسد وشلون جمعهم وغاب","كيف السنين اللي عطتني بعثرتهم بعثره",107,"ر",2,0],["آهِ بغدادُ، كم تئنِّين حزناً","تعبت من أنينكِ الأعوامُ",108,"م",1,0],["أَهَبُ الشِّعرَ نَضرَةً بِنَزِيفِي","فَأُلَاقِي مُنَدِّدًا ؛ وَ عُتُلَّا",109,"ل",2,0],["أَهُبُّ لَهُ بَعدَ الحِدادِ بِكَرَّةٍ","أَشُجُّ بِها رَأسًا ؛ فَيَنزِفُ فُودُ",110,"د",1,0],["أهبُّ , للشمس في يميني","يمينٌ , العمرُ للتحدِّي",111,"د",2,0],["أهبطتَ شاكسبير من عليائِه","وأزحت عن كرسيِّه مهيارا",112,"ر",2,0],["اهبطِ إلى مضرٍ فسلْ حمراءها","منَ ضاح بالبطحاء يا نارُ اخمدي",113,"د",2,0]]}