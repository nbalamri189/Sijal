لُهُ عِبْءَ المَعالي ومَنْكِبِ",5,"ب",1,0],["لأورِثَهُمْ مَآثِرَ صالحاتٍ","شَفَعْتُ طَريفَها لهُمُ بِتُلْدِ",6,"د",1,0],["لا وَضْعَ للرَّحْلِ عَن أصْلابِ ناجيَةٍ","أو تَشْتَكي أضْلُعاً تَدْمَى وأعْضادا",7,"د",2,0],["لا وَرَبِّ الوُفودِ لِلبَيتِ تَهوي","بِهِمُ العيسُ قَد بَراها الرَسيمُ",8,"م",1,0],["لا وَالَّذي سَمَكَ السَماءَ بِقُدرَةٍ","ما في العِبادِ لَكُم لَديَّ مُعادِلُ",9,"ل",1,0],["لا وَفاءٌ وَلا حِفاظٌ وَلَكِن","كُذَّبُ الوُدِّ ما لَهُنَّ عُهودُ",10,"د",1,0],["لا وَلا يُسئِمُهُ ذاكَ الَّذي","يُسئِمُ الأَحياءَ مِن عَيشٍ رَتيبِ",11,"ب",1,0],["لا وازِعٌ وَقَدِ اِنطَوَت","مَلَكٌ يَقيهِنَّ الضَرَر",12,"ر",1,0],["لا وَالأَسى وَتَلَهُّبِ الأَحشاءِ","ما باتَ بَعدَكَ مُعجَبٌ بِوَفاءِ",13,"ا",2,1],["لا وَلا يَعتَريهِ ما يُخرِسُ النا","بِحَ في الزَمهَريرِ بَينَ الخِيامِ",14,"م",1,0],["لا وَلا رَدٌّ يُعَلِّلُني","أَو عَلى التَسليمِ يَشتَمِلُ",15,"ل",1,0],["لِأَوَّلِ مَرَّةٍ قَد ذاقَ جَفني","عَلى ما ذاقَهُ دَمعَ السُرورِ",16,"ر",1,0],["لا وَأَبيكَ اِبنَةَ العامِرِيِّ","لا يَدَّعي القَومُ أَنّي أَفِر",17,"ر",1,0],["لا وَأَلحاظٍ لَها ساحِرَة","نَفَثَت في القَلبِ لا في العُقدِ",18,"د",1,0],["لا وحق الإخاء ما راقنا","العيش كأن الحرب الزبون سلام",19,"م",1,0],["لا وَلا خَلْطُ مَنْ إِلَى الفَضْلِ يَعْزُو","خَلْطُهُ بِالفَصَاحَةِ التَّهْجِينَا",20,"ن",2,0],["لا وَجْهَ أَبْهَى وَلا أَزْهَى بِرَوْنَقِهِ","مِنْ وَجَهْكَ النَّضْرِ فِي مَنْحُوتِ صَوَّانِ",21,"ن",1,0],["لا وَحَقِّ الَّذِي أَمَاتَكَ تَحْيَا","وَلَكَ الحُبُّ فِيهِ وَالتَّمْكِينُ",22,"ن",1,0],["لأُولِي العَزْمِ وَالنُّهَى","نَسَمٌ تُخْضِعُ النَّسَمْ",23,"م",1,0],["لا وَحَقَّ الإِخَاءِ مَا رَاقَنَا","العَيْشُ كَأَنَّ الأَمْنَ سَلامُ",24,"م",1,0],["لا وَلَمْ تَفْقُدِ الحَمِيَّةُ وَالأَشْبَالُ","فِي الغِيلِ صَوْلَةُ الضَّرْغَامِ",25,"م",1,0],["لا ولا لا حد منا","على شكر ذا الغنيما",26,"م",2,0],["لا وَصلَ إِذ صَرَّفَت هِندٌ وَلَو وَقَفَت","لَاِستَفتَنَتني وَذا المِسحَينِ في القَوسِ",27,"س",1,0],["لا وِردَ لِلقَومِ إِن لَم يَعزِفوا بَرَدى","إِذا تَجَوَّبَ عَن أَعناقِها السَدَفُ",28,"ف",1,0],["لِأَوسَعِهِم مَذانِبِ ماءِ وادٍ","وَأَغزَرِهِم مَدافِعِ سَيبِ راحِ",29,"ح",1,0],["لا وَسَّعَ اللَهُ لَهُ قَبرَهُ","بَل ضَيَّقَ اللَهُ عَلى القاطِعِ",30,"ع",1,0],["لا والذي أعلا وأعلن مجدَهُ","حتى تجاوز هامةَ الجوزاء",31,"ا",2,0],["لا ونعماكَ لم يكنْ سببُ التأ","خير قصدي ولم يكن عن رجائي",32,"ي",1,1],["لا وأجفانك المراض الصحاح","لست أدري ماذا تقول اللواحي",33,"ح",2,1],["لا ورشفِ اللّمى ولثم الخدود","ما عذولي عليك غير حسود",34,"د",1,1],["لا وعليائك ما عندِيَ ما","يدخل الوزن سوى نظم القريض",35,"ض",1,0],["لا وعيش اللقاء ما لدموعي","وقفةٌ بعد وقفةِ التَّوديع",36,"ع",1,1],["لا ولا الفائزي فإن بعليا","ك ولو فسح التمكّن سبله",37,"ل",2,0],["لا ولا خصبة ابن حنا كأفرا","حك بل نصله له بعد نصله",37,"ل",2,0],["لا وصل سعدى ولا الطيف الملم فيا","للقلب من ألمٍ باقٍ على ألم",38,"م",1,0],["لا وندى ابن الأفضل المرتجى","لا نكثت بيعة أشجاني",39,"ي",1,0],["لا ولا قال في القريض شقيقاً","لحلاها زياد في النعمان",40,"ن",1,0],["لا وشعرٍ لك داجٍ","وجبينٍ يتجلّى",41,"ل",2,0],["لا ولا استدفعت صدًّا","منك واستدعيتُ وصلا",41,"ل",2,0],["لا وخمر بابليَّه","في ثنايا لؤلؤيَّه",42,"ي",2,1],["لا ولا أخشى من الدن","يا عواديها الجريَّه",42,"ي",2,0],["لا ولا يكْسب المحامِد في النا","س ولا يشتري جميلَ الثناءِ",43,"ا",2,0],["لا ولا جاء بعد ذاك بشيرٌ","برِضاً ثابتٍ يقيم الذَّماء",44,"ا",2,0],["لا ولا جاء بين ذاك وهذا","مُتَرَتٍّ يُعلَّلُ الحَوْباءَ",44,"ا",2,0],["لا ولا في قَضاءِ حقِّ أبي شَيْ","بَةَ ما يوجبُ انتكاثَ إخائِكْ",45,"ك",1,0],["لا ولا ينحو مُثيبٌ بنُعمى","نَحْوهُ حتى يشيبَ الغُرابُ",46,"ب",1,0],["لا والذي بجفائهِ","وَصَلَ المدامعَ بالنحيبْ",47,"ب",1,0],["لا والذي قَدُمَتْ عنْدي صنَائِعه","لا بِتُّ إلّا على صَبْرٍ ومجلودِ",48,"د",1,0],["لا ولا حَقِّ من حَباك بإسعا","دك أن لا تزيد في إسعادِهْ",49,"د",2,0],["لا ولا سُمْتَ مجتديك إذا جدْ","تَ عليه بنائلٍ تَصْريدَكْ",50,"ك",1,0],["لا وألحاظِ العيون الساحرَهْ","بين أهدابِ الجفون الفاترَهْ",51,"ر",2,1],["لا والذي جعل البيانَ مقسماً","بين الورى وأجلَّ حظَّ البحتري",52,"ر",2,0],["لا ولا ممَّن إذا ما بُسِطَتْ","يده بالنَفع والدفع انقبض",53,"ض",1,0],["لا وعيداً أقول ذاك ولكن","قلت حاء من المقال وقافا",54,"ف",2,0],["لا ولا مثل زارعٍ في سباخٍ","غادرت جلَّ زرعه ماروقا",55,"ق",2,0],["لا ولا نفسَ محبٍّ","ترتقي بين التراقي",56,"ق",2,0],["لا وجُردانِكَ المُطلِّ عليه","ذلك البطنُ لا استطعتَ تنيك",57,"ك",1,0],["لا ولا خال أنَّ حقك يقضى","بيسير وذاك ما لنْ يخالا",58,"ل",2,0],["لا ولكنْ جلَّى هناك عليه","ما سيلقى من العجائب جالي",59,"ل",2,0],["لا ولا تغرس غرساً","يجتنَى منه نِدامُ",60,"م",1,0],["لا وذاك البطنِ لا جا","ور ذاك الترب عِلمُ",61,"م",1,0],["لا ولا كثرة التأفُّفِ منه","مثل ما يفعلُ الرِّغابُ البطون",62,"ن",1,0],["لا ولا حمدَ كفءُ نعماك إلا","حمدُ سبعٍ من الكتاب مثاني",63,"ن",2,0],["لا والذي لو شاء بَدَّلَ صَبْوَتي","بلهىً وطولَ صبابتي بتناه",64,"ه",1,0],["لا وَلَكِن راعَهُم عَصرٌ بِهِ","سادَ في الفِتيانِ حُبُّ الذَهَبِ",65,"ب",1,0],["لا وِعاءً يُقَيِّدُ الماءَ حَتّى","تَستَحيلَ المِياهُ فيهِ وُحولا",66,"ل",2,0],["لا وَمَن شاءَ لَنا أَن نَنعَما","ما كَذا يَجزي الأَبَ البَرَّ البَنون",67,"ن",1,0],["لا وَلا قالَ كُلُّ شَيءٍ إِلى المَح","وِ وَما خَصَّ بِالخُلودِ سِواهُ",68,"ا",2,0],["لا وَحَقِّ اللَهِ ماظَنُّ","كَ في حَقّي حَلالا",69,"ل",2,0],["لا ولا طافَ بها الثَّعْلَبُ","في بعضِ الصِّحابْ",70,"ب",1,0],["لا وَالَّذي تَسجُدُ الجِباهُ لَهُ","مالي بِما دونَ ثَوبِها خَبَرُ",71,"ر",1,1],["لا والذي أعطى القليل شجاعة","ما كنت خوارا ولا إجفيلا",72,"ل",2,0],["لا ويل للميت الذي انفسحت له","من كل قلب روضة محال",73,"ل",1,0],["لا وحدة في النظام اليوم تجمعهم","فان قومي عباديد عباديد",74,"د",1,0],["لا ويل للميت الذي انفسحت له","من كل قلب روضة محلال",75,"ل",1,0],["لا ويل في موت بعضو قد طحا","بل انه في ان يموت الراس",75,"س",1,0],["لا ولا ما شغله ما جاهه","في الدواوين ولا ما رتبته",76,"ه",1,0],["لا والزبيب ومزة من حمص","والورد والتسبيح من متبلبص",77,"ص",1,1],["لا والقوام الذي والأعين اللاتي","ما خنت رب القنا والمشرفيات",78,"ت",1,1],["لا وَراءَ الجِيادِ زيدَت جَلالاً","مُنذُ كانَت وَلا عَلى الأَجيادِ",79,"د",1,0],["لا وَالَّذي وَكَلَ البَيانَ إِلَيكَ لَم","أَكُ دونَ غاياتِ البَيانِ مُقَصِّرا",80,"ر",2,0],["لا وَعيدٌ لا صَولَةٌ لا اِنتِقامُ","لا حُسامٌ لا غَزوَةٌ لا دِماءُ",81,"ا",2,0],["لا وَمَكانِ الصَّليبِ في النّحْرِ","مِنْكِ ومَجْرَى الزُّنّارِ في الخَصْرِ",82,"ر",1,1],["لا وحُبِّيكَ ما مَللتُ سَقَاماً","لَكَ فيهِ مِنْ مُقْلَتَيْكَ نَصيبُ",83,"ب",1,1],["لا وارِثٌ جَهِلَت يُمناهُ ما وَهَبَت","وَلا كَسوبٌ بِغَيرِ السَيفِ سَئالُ",84,"ل",1,0],["لا ولا البيض والمَنى","لا ولا البول والقذر",85,"ر",1,0],["لا ولا سائر المعا","دن أعني بها المَدَر",85,"ر",1,0],["لا ولانابت ولا","حيوان وذي ثمر",85,"ر",1,0],["لا ولا ملحة العقا","ب التي شانها الكدر",85,"ر",1,0],["لا وَحُبّيكِ ما تَعَقَّبتُ وَصلاً","بِصُدودٍ وَلا وَفاءً بِعُذري",86,"ي",1,0],["لا وَظيفُ العَيرِ مَرقومٌ وَلا ال","عَجَبُ مَهضومٌ وَلا الوَجهُ خَلِق",87,"ق",1,0],["لَأَوشَكَ شَعبُ الحَيِّ أَن يَتَفَرَّقا","فَيَدمى الجَوى أَو يُصبِحَ الحُبُّ أَولَقا",88,"ق",2,1],["لا وَرَأيٍ بَتَّ بِالحَز","مِ حِبالي مِن حِبالِه",89,"ل",2,0],["لا وَمَن مَدَّ غايَتي في هَواهُ","وَبلاني مِنهُ بِما قَد بَلاني",90,"ن",2,0],["لا وَالَّذي هُوَ بِالإِسلامِ أَكرَمَنا","وَجاعِلُ المَيتِ بَعدَ المَوتِ في الجَنَنِ",91,"ن",1,0],["لا والِدٌ خالِدٌ وَلا وَلَدُ","كُلُّ جَليدٍ يَخونُهُ الجَلَدُ",92,"د",1,1],["لا وَالَّذي أَمسَيتُ عَبداً لَهُ","ما دامَ في الدُنيا لِعَبدٍ سُرور",93,"ر",1,0],["لاواكَ قَومٌ فَكانَ حَظَّهُمُ","طَلُّ دَمٍ في الوَغى وَضَربُ طُلى",94,"ل",2,0],["لا وَلا مَن شَدا أَقيموا بَني أُمَي","يَ إِذا ما أُديرَتِ الخَندَريسُ",95,"س",1,0],["لا وَالَّذي جَعَلَ المَوَدَّةَ مانِعي","مِن أَن أُجازي سَيِّدي بِجَفائِهِ",96,"ا",3,1],["لا وَمَن زانَ وَردَ خَدِّكَ بِالخا","لِ وَزانَ العُيونَ بِالتَلويزِ",97,"ز",1,0],["لا وَلا خِلتُ أَنَّ شُهبَ الدَراري","بَعدَ أَوجِ العُلى تَحِلُّ القُبورا",98,"ر",2,0],["لا وربي ليس في الدنيا ختام","حين يغدو البعث نجوى من حبيب",99,"ب",1,0],["لا ولا مُرْهَفَ المُدَى بين فَكّيْ","باطشِ البرثنَينِ وَرْدٍ جَريِّ",100,"ي",1,0],["لا وَعْدَ له بالجود وَمَنْ","يبدأ بعطاءٍ لا يَعِدِ",101,"د",1,0],["لا ولا شمساً بَدَتْ في غُصُنٍ","وهو في حقف يُنَدّى ويَراح",102,"ح",1,0],["لا وَقَدٍّ يَهتَزُّ كَالغُصنِ الغَضِّ","إِذا اِرتَجَّ فيهِ رِدفٌ وَثيرُ",103,"ر",1,0],["لا وَوَردٍ بِخَدِّهِ","وَاِعتِدالٍ بِقَدِّهِ",104,"د",2,1],["لا وَالَّذي رَتَكَت تَطوي الفِجاجَ لَهُ","سَفائِنُ البَرِّ في خَدِّ الثَرى تَخِدُ",105,"د",1,0],["لَأُوَدِّعَنَّكَ ثُمَّ تَدمَعُ مُقلَتي","إِنَّ الدُموعَ هِيَ الوَداعُ الثاني",106,"ي",1,0],["لا وَالَّذي هُوَ عالِمٌ أَنَّ النَوى","صَبِرٌ وَأَنَّ أَبا الحُسَينِ كَريمُ",107,"م",1,0],["لا وَالطُلولِ الدارِساتِ أَلِيَّةً","مِن مُعرِقٍ في العاشِقينَ صَميمِ",108,"م",1,0],["لا وطولِ القيامِ فيك ووجدي","ما لطَوْلِ الوزيرِ مِنْ تقصيرِ",109,"ر",1,0],["لا واخذَ الرحمنُ مصراً ولا","أزالَ عنها حسنَ ديباجهْ",110,"ه",1,1],["لا والذي أعطاكَ كلَّ فضيلةٍ","وحَبَاكَ بالإحسانِ والآدابِ",111,"ب",1,0],["لا وَالَّذي بَعَثَ النَبِيَّ مُحَمَّداً","بِالنورِ وَالإِسلامِ دينِ القَيِّمِ",112,"م",1,0],["لا وَقَبرِ النَبِيِّ يا عَبدَ وَالحَج","جِ وَمَن كانَ مُحرِماً وَمُحِلّا",113,"ل",2,0],["لا وَالَّذي أَحرَمَ العِبادُ لَهُ","بِكُلِّ فَجٍّ مِن حِجَّةٍ رُفَقُ",114,"ق",1,0],["لا وَالَّذي أَعلَقتُ مِن تَقديسِهِ","كَفّي بِحَبلَي عِصمَةٍ وَرَجاءِ",115,"ا",2,0],["لا وَالَّذي تُجلى الكُروبُ","بِهِ وَتَنفَرِجُ الخُطوب",116,"ب",1,1],["لا ومجرَى الوَحْيِ من مَقْدِسِها","لن تَرَوْها ليهودٍ مطعما",117,"م",2,0],["لا وربّي ما لشعبٍ رازحٍ","من سبيلٍ في الشُّعوبِ السُّبَّقِ",118,"ق",1,0],["لا وَمَن أَلقى إِلَينا أَمرَهُ","لا تَرَكناهُ بِأَيدي الخاذِلينْ",119,"ن",1,0],["لا ورَبِّي فإنّما طَلبَ الكف","فارُ بَسْلاً وحاولوا محظورا",120,"ر",2,0],["لا وَلا همةُ بَحرِ الظُلمات","أَشبَهَت هِمّةَ جَيشِ العَرَبِ",121,"ب",1,0],["لا وَرَبِّ المُكَبِّرينَ بِجَمعٍ","وَالمُنيخينَ بَعدَهُم بِالحِصابِ",122,"ب",1,0],["لا وُدَّ في آلِ عَمروٍ إِن أَطَفتَ بِهِم","خَرانِقٌ تَنفُضُ الأَعرافَ وَاللَمَما",123,"م",2,0],["لا وَالَّذي لا إِلَهَ إِلّا هو","أَنتَ بِهَذا عَلَيَّ تَيّاهُ",124,"ه",1,1],["لا وَلا أَرتَجي نَوالاً وَهَل تَس","تَمطِرُ الناسُ دَيمَةَ الأَمطارِ",125,"ر",1,0],["لا وَرُمّانِ النُهودِ","فَوقَ أَغصانِ القُدودِ",126,"د",1,1],["لا وَخَدٍّ مِن خُضرَةِ الشَعرِ جَدبِ","لامِعٍ نورَهُ كَصَفحَةِ عَضبِ",127,"ب",1,1],["لا وَمَن قَدَّرَ الشَقاءَ عَلى العُش","شاقِ ما خُنتُ ساعَةً في حِسابي",128,"ب",2,0],["لَأوسِعَنَّ بِحِلمي","عَبدَ الحَبيبِ وَكَلبَه",129,"ب",2,0],["لا وَلا أَذخَرُ عِندي","لِلأَخِلّاءِ العُيوبا",130,"ب",2,0],["لا وَبَهرامُ يَستَقِلُّ سَماءَ ال","غَربِ وَاللَيلُ زائِدٌ في الحِسابِ",131,"ب",1,0],["لا وَالَّذي وافى لِرِضوانِهِ","سارونَ حُجّاجٌ وَعُمّارُ",132,"ر",1,0],["لا والتفاتِ الظباءِ بالمُقلِ","وطيبِ غصنِ الخدودِ بالقُبَل",133,"ل",1,1],["لا وَالَّذي خَصَّ مِنكِ بِالحَزَنِ","وَخَصَّ لِلطَرفِ جَريَ الدَمعِ بِالوَسَنِ",134,"ن",1,1],["لا وَمَن سَبَّحَ الحَجيجُ لَهُ ما","كانَ ظَنّي اِتِّقاءَ عَينِ الرَقيبِ",135,"ب",1,0],["لا وَلا أَن يُقالَ شيمَتُهُ الجو","دُ وَلَكِن طَبائِعُ الآباءِ",136,"ا",2,0],["لا وارِدٌ مِنها يَحورُ لِمَصدَرٍ","عَنها وَلا صَدِرٌ يَحورُ لِمَورِدِ",137,"د",1,0],["لَأَوصِيَنَّ بِما أَوصَت بِهِ أُمَمٌ","في الدَهرِ وَالقَولُ مِثلَ الشُربِ مَعلولُ",138,"ل",1,1],["لا وِردَ لي وَالمَطايا في خَزائِمِها","وَكُلُّ صاحِبِ سِنٍّ حَبلُهُ خَزَمُ",139,"م",1,0],["لا وَالرَّحِيقِ المُصَفَّى مِنْ مَراشِفِهِ","وما بِخَدَّيْهِ مِنْ خالٍ وَمِنْ طُرَرِ",140,"ر",1,0],["لا واسْتِراقِ اللَّحظِ مِنْ","عينِ المُحبَّ إلى الحبيبْ",141,"ب",1,1],["لا واللحى والَّذي في الوجه أنبتها","ما إن تكون اللحى للفضل ميزانا",142,"ن",2,0],["لا وَلا كالفرات في الأرض نهراً","منعشاً للحيوان أَو للنبات",143,"ت",1,0],["لا وارثٌ جهلت يمناه ما وهبت","ولا كسوبٌ بغير السّيف سآل",144,"ل",1,0],["لا ولا أفلَتَ منها فاتنٌ","قرَّبَتْهُ واحتوتهُ قبضتاها",145,"ا",3,0],["لا وَلا باهِلاً سَليمَ النَواحي","لِلقَهاوي رَواحُهُ وَالبُكورُ",146,"ر",1,0],["لأونَس إن لَمْ يَقصُرِ الطّرفُ عَنْهُمُ","فَلمْ تَقْصُرِ الأخْبارُ والطَّرفُ قاصرِي",147,"ر",2,0],["لا وَضْعَ للرّحلِ إلاّ بعْدَ إيضَاعِ","فكيفَ شاهَدْتِ إمضائي وإزْماعي",148,"ع",2,1],["لا وحقِّ الهَوى وحقِّ لَيالِي","هِ ومن صاغَ حُسْن وجْهِك فَرْدا",149,"د",2,0],["لا ولا أَبكيكَ يا أَمسي","إِذا مَا قلتُ آهْ",150,"ا",2,0],["لا وَذِكْرَاهُ إِنَّهَا لَشُعَاعٌ","لَيْسَ يَغْشَاهُ فِي النُّفُوسِ قَتَامُ",151,"م",1,0],["لاَ وَلاَ عَهْدِي بِهَا خَاطِبَة","عَنْ ثُغُورٍ مِنْ نُحَاسٍ وَحُلُوقِ",152,"ق",1,0],["لاَ وَلَكِنَّ عِزَّةً أَخَذَتْهُ","عَنْ غُرُورٍ بِبَأْسِهِ وَاعْتِدَادِ",153,"د",1,0],["لا وَلَمْ يُفْعِمْهُ بِشْراً حَدَثٌ","كالَّذِي أَفْعَمَهُ إِذْ ذَاك بِشْرَا",154,"ر",2,0],["لا وَلا فِي ظُلْمِهِ مِنْ عَجَبٍ","إِن لِلظَّالِمِ عِنْدَ العَدْلِ وِتْرَا",154,"ر",2,0],["لاَ وَلاَ الْمَجْدُ بَاقياً عَنْ كبَار","من كرام الآبَاءِ وَالأَجْدَاد",155,"د",1,0],["لا وَلا يَأْتَلِي عَنِ الجُهْدِ فِي خِدْ","مَةِ مِصْرٍ وَحَقِّهَا المَغْبُونِ",156,"ن",1,0],["لاَ والَّذِي وَلاَّكَ نَا","صيَةَ البَيان بِلاَ مُكابرْ",157,"ر",1,0],["لا وزنَ للأرواح فيه، وإنما","صلَّى بنوه، وسبَّحُوا للزاد",158,"د",1,0],["لا وَزْنَ فيها للنُّبوغَ؛ وإنَّما","يَرْقَى السعيدُ بعمِّهِ وبخالِهِ؟!",159,"ل",2,0],["لا، ولا جاوَرَ إلا طاهرًا","ينظمُ الياقوتَ والدرَّ كلامًا",160,"م",2,0],["لا، ولكنْ دقَّ الفؤاد التياعًا","عند مرأى تلك الثنايا العذاب",161,"ب",1,0],["لا والذي خلق الأنامَ سواسيًا","ما عاد -بعد الله- ربٌّ يُتَقَى",162,"ق",2,0],["لأوشكُ أن أرتدَّ طفلاً؛ لطولِما","أمثِّل دَوْرَ الطفل بين يديهمو",163,"م",2,0],["لا وزن للأرواح فيه؛ وإِنما","ذهب الحُطَامُ وحُبُّه بصوابه",164,"ب",2,0],["لا، والنبيِّ محمد","خيرِ الأواخر والأوالي",165,"ل",2,0],["لا ولا تعشق النقود اللّواتي","نقشتها يد الحياة الذليلة",166,"ل",2,0],["لا وعاء يقيّد الماء حتى","تستحل المياه فيه وحولا",167,"ل",2,0],["لا ولا ممَّن إذا بُسطتْ يده","بالنَّفع والدفع انقبض",168,"ض",1,0],["لا ولا عن هواك لي من سُلِوٍّ","طردت مهجتي السلوَّ فوَلى",169,"ل",2,0]]}