{"poems":[[53,"أبينتها أم ناكرتك شياتها","https://www.aldiwan.net/poem30677.html","الطويل"],[53,"ما يصنع السير بالجرد السراحيب","https://www.aldiwan.net/poem30762.html","البسيط"],[55,"أيا من وجهه قمر","https://www.aldiwan.net/poem26292.html","مجزوء الوافر"],[86,"بلابل وادي النيل بالمشرق اسجعي","https://www.aldiwan.net/poem68896.html","الطويل"],[93,"حكوا لنا عن حمارٍ","https://www.aldiwan.net/poem11072.html","المجتث"],[93,"ألطائر العالي مراده","https://www.aldiwan.net/poem11144.html","السريع"],[93,"هو العيش جهد طائل وفتون","https://www.aldiwan.net/poem11186.html","الطويل"],[72,"دعوني لذكرى حسنه أقتضي العذلا","https://www.aldiwan.net/poem20545.html","الطويل"],[51,"عزمت على تطليق عرسي لعسرتي","https://www.aldiwan.net/poem66518.html","الطويل"],[29,"لعمر أبيك يا زفر ابن عمر","https://www.aldiwan.net/poem6066.html","الوافر"],[70,"لكم أينما كنتم مكان وإمكان","https://www.aldiwan.net/poem42683.html","الطويل"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[85,"سمعت أن فأرة أتاها","https://www.aldiwan.net/poem8003.html","الرجز"],[85,"سلو قلبي غداة سلا وثابا","https://www.aldiwan.net/poem63783.html","الوافر"],[43,"طوال قنا تطاعنها قصار","https://www.aldiwan.net/poem9568.html","الوافر"],[43,"في الخد أن عزم الخليط رحيلا","https://www.aldiwan.net/poem10125.html","الكامل"],[43,"على قدر أهل العزم تأتي العزائم","https://www.aldiwan.net/poem10524.html","الطويل"],[45,"أبعد الشباب المنتضى في الذوائب","https://www.aldiwan.net/poem10652.html","الطويل"],[45,"قربت من الفعل الكريم يداكا","https://www.aldiwan.net/poem65219.html","الكامل"],[28,"ولما رأيت النفس صار نجيها","https://www.aldiwan.net/poem5277.html","الطويل"],[28,"لها صاحبا فقر عليها وصادع","https://www.aldiwan.net/poem5391.html","الطويل"],[28,"وقائلة لي لم تصبني سهامها","https://www.aldiwan.net/poem5422.html","الطويل"],[49,"يسلم المرء أخوه","https://www.aldiwan.net/poem63192.html","مجزوء الرمل"],[66,"ألا قل لشر عبيد الإله","https://www.aldiwan.net/poem41383.html","المتقارب"],[80,"أعليت بين النجم والدبران","https://www.aldiwan.net/poem31266.html","الكامل"],[80,"هن الحسان وحربها الهجر","https://www.aldiwan.net/poem31452.html","أحذ الكامل"],[44,"متى يرعي لقولك أو ينيب","https://www.aldiwan.net/poem29679.html","الوافر"],[44,"ما في وقوفك ساعة من باس","https://www.aldiwan.net/poem30485.html","الكامل"],[44,"سرت تستجير الدمع خوف نوى غد","https://www.aldiwan.net/poem30547.html","الطويل"],[44,"قدك اتئب أربيت في الغلواء","https://www.aldiwan.net/poem30592.html","الكامل"],[69,"وكان بمصر السحر قدما فأصبحت","https://www.aldiwan.net/poem29220.html","الطويل"],[74,"ألا ساجل دموعي ياغمام","https://www.aldiwan.net/poem13249.html","الوافر"],[81,"طرقت منقبة تروع تحجبا","https://www.aldiwan.net/poem61559.html","الكامل"],[52,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[48,"كنت من الحب في ذرى نيق","https://www.aldiwan.net/poem64447.html","المنسرح"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85411","المتدارك"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202537","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55509","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67357","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141930","البسيط"],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[80,"أعليتَ بين النجم والدّبرانِ","https://www.poetsgate.com/ViewPoem.aspx?id=3771",""],[160,"إذا ابطات عنا من المحسن الحسنى","https://www.aldiwan.net/poem59008.html","الطويل"],[160,"ما فته حظه من أجل الطلبا","https://www.aldiwan.net/poem59115.html","البسيط"],[189,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[189,"رأى مدح خير الخلق صعبا فأحجما","https://www.aldiwan.net/poem35105.html","الرمل"],[189,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[195,"بانت حسينة وائتمت بمن بانا","https://www.aldiwan.net/poem54410.html","البسيط"],[210,"لقد كان لي بغل به رتبتي تعلو","https://www.aldiwan.net/poem13400.html","الطويل"],[210,"كفاني حزنا أن أضر بي الهجر","https://www.aldiwan.net/poem13494.html","الطويل"],[237,"سلام عليكم والحوادث ألوان","https://www.aldiwan.net/poem19283.html","الطويل"],[270,"إن الجمال به عزاء الأنفس","https://www.aldiwan.net/poem35666.html","الكامل"],[270,"يا دار أزهر حولك الورد","https://www.aldiwan.net/poem35667.html","أحذ الكامل"],[275,"الله عن تلك المناقب دافع","https://www.aldiwan.net/poem25488.html","الكامل"],[275,"بيني ثلاثا سلوة الأيام","https://www.aldiwan.net/poem25529.html","الكامل"],[287,"أرحلت من سلمى بغير متاع","https://www.aldiwan.net/poem1916.html","الكامل"],[304,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[305,"ربيع من جبينك قد أطلا","https://www.aldiwan.net/poem56437.html","الطويل"],[313,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[361,"بنظمك هذا العلم زاد ابتهاجه","https://www.aldiwan.net/poem68127.html","الطويل"],[364,"سهام نواظر تصمي الرمايا","https://www.aldiwan.net/poem60572.html","الوافر"],[364,"أتلك رياض أم خدود نواعم","https://www.aldiwan.net/poem60665.html","الطويل"],[364,"نزل الأحبة خطة الأعداء","https://www.aldiwan.net/poem61017.html","الكامل"],[400,"الأمل المورق","https://www.aldiwan.net/poem6715.html","عموديه"],[403,"تبين ثغر الفجر لما تبسما","https://www.aldiwan.net/poem33450.html","الطويل"],[409,"ديار الهوى حيا معالمك","https://www.aldiwan.net/poem31696.html","عموديه"],[409,"فما أنت إلا الشمس لولاك لم تزل","https://www.aldiwan.net/poem31712.html","عموديه"],[409,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[416,"سقى الله هذا القبر من صيب الحيا","https://www.aldiwan.net/poem53817.html","الطويل"],[416,"حثثت على عنيف السير نوقي","https://www.aldiwan.net/poem54111.html","الوافر"],[441,"عزاء يا بني شرف","https://www.aldiwan.net/poem14463.html","مجزوء الوافر"],[452,"لله إفريز كروضة خرم","https://www.aldiwan.net/poem13781.html","الكامل"],[452,"لو أن بيضة زاغ راح يحضنها","https://www.aldiwan.net/poem13955.html","البسيط"],[458,"إذا لم يقرب منك إلا التذلل","https://www.aldiwan.net/poem56075.html","الوافر"],[458,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[458,"إذا صاح وفد السحب بالريح أوحدا","https://www.aldiwan.net/poem56243.html","الطويل"],[464,"نعم نفحة الوادي التي تتأرج","https://www.aldiwan.net/poem3143.html","عموديه"],[464,"لله أية ليلة قضيتها","https://www.aldiwan.net/poem3510.html","عموديه"],[479,"سألت عليك القبر لو نطق القبر","https://www.aldiwan.net/poem37592.html","الطويل"],[515,"ثغر الزمان بنجم الدين مبتسم","https://www.aldiwan.net/poem12263.html","البسيط"],[529,"نظام هو الدر الثمين منضدا","https://www.aldiwan.net/poem37444.html","الطويل"],[538,"دعاني من ذكر السقام دعانيا","https://www.aldiwan.net/poem47498.html","عموديه"],[551,"بقاء ولكن لو أتى لا أذمه","https://www.aldiwan.net/poem47249.html","الطويل"],[558,"أدر صرفا خمور الأندرينا","https://www.aldiwan.net/poem33755.html","الوافر"],[562,"زر تربة في الحمى يا أيها المطر","https://www.aldiwan.net/poem52838.html","البسيط"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["وَكانَ بِدارِ الهونِ مُلقىً جُنوبُها","سَواءٌ عَلَيها مَوتُها وَحَياتُها",0,"ت",3,0],["وَكانَ بِالحَربِ يَلقى مَن يُنافِرُهُ","فَصارَ يَلقى الأَعادي بِالمَحاريبِ",1,"ب",1,0],["وَكانَ بَلِيَّةً أَنّي","نَظَرتُ فَشامَني النَظَرُ",2,"ر",1,0],["وَكانَ بَريدُ العِلمِ عيراً وَأَينُقاً","مَتى يُعيِها الإيجافُ في البيدِ تَظلَعِ",3,"ع",1,0],["وكان بغلٌ إليه","يدلي ببعض إتصال",4,"ل",1,0],["وكأن بين ضولعهم","كبدا ألم بها كباده",5,"د",2,0],["وَكَانَ بِكَ التَّوْفِيقُ لِلْعِلْمِ وَالحِجَى","فَمَاذَا دَهَى التَّوْفِيقَ حِينَ تَبِينُ",6,"ن",1,0],["وكانَ بودِّي لو أطقت تسلياً","فحققت عنهُ صبوتي كلما ملاّ",7,"ل",2,0],["وكان بها عشقٌ قديمٌ تُجنّهُ","فلما أُذيلتْ أظهرتْ ما أجنَّتِ",8,"ت",1,0],["وَكانَ بِنا يَحُلُّ فَلا يُعانى","وَيَرعى كُلَّ رَملٍ أَو عَزازِ",9,"ز",1,0],["وَكانَ بِها مِن أَهلِ شُعبَةَ شُعبَةٌ","مِنَ الجَورِ وَالعُدوانِ بَغيٌ وَعُدوانِ",10,"ن",1,0],["وَكانَ بَينَ جَيشِهِ بِأَخمرا","وَبَينَ إِبراهيم يَومٌ ذُو لَظى",11,"ا",1,0],["وَكانَ بِالقُربِ الَّذي تُريدُ","يَسمَعُ ما تُبدي وَما تُعيدُ",12,"د",1,0],["وَكانَ بَيانُهُ لِلهَديِ سُبلاً","وَكانَت خَيلُهُ لِلحَقِّ غابا",13,"ب",2,0],["وَكانَ بَنو كِلابٍ حَيثُ كَعبٌ","فَخافوا أَن يَصيروا حَيثُ صاروا",14,"ر",3,0],["وَكَأَنَّ بَرقاً في مُتونِ غَمامَةٍ","هِندِيُّهُ في كَفِّهِ مَسلولا",15,"ل",2,0],["وَكانَ بِها مِثلُ الجُنونِ فَأَصبَحَت","وَمِن جُثَثِ القَتلى عَلَيها تَمائِمُ",16,"م",1,0],["وَكانَ بَياضُ الرَأسِ شَخصاً مُذَمَّماً","إِلى كُلِّ بَيضاءِ الحَشا وَالتَرائِبِ",17,"ب",1,0],["وَكَأَنَّ بِشرَكَ في شُعاعِ كُؤوسِها","لَمّا تَوالَت في الأَكُفِّ دِراكا",18,"ك",2,0],["وَكانَ بَنو الدَيّانِ زَيناً لِقَومِهِم","وَأَركانَ طَودٍ بِالأَراكِ مَنيعِ",19,"ع",1,0],["وَكانَ بِمِصرَ اِثنانِ ما خافَ أَهلُها","عَدُوّاً وَلا جَدباً تُخافُ هَزايِلُه",20,"ل",2,0],["وَكانَ بِلالٌ حينَ يَستَلَّ سَيفَهُ","لَمَلحَمَةٍ بِالمُعلَمينَ يَنالُها",21,"ل",3,0],["وَكَأَن بِالمَرءِ قَد يَب","كي عَلَيهِ أَقرَبوهُ",22,"و",2,0],["وَكانَ بِصِفّينَ مِن حِزبِهِم","لِحَربِ الطُغاةِ وَأَحزابِها",23,"ب",3,0],["وكأنّ بَرْدَ الماءِ منها مُطفئٌ","ناراً مُضَرَّمَةً من العدوانِ",24,"ن",1,0],["وَكَأنَّ بَرْقاً في تَبَسّمِهِ","وكأنّما دَمْعي له قَطرُ",25,"ر",1,0],["وَكانَ بِهِ سَواحينٌ تُهَمّي","عَزالَيهِ الظَواهِرُ وَالغُيوبُ",26,"ب",1,0],["وَكَأَنَّ بَينَهُما رَضاعَ الثَدي مِن","فَرطِ التَصافي أَو رَضاعَ الكاسِ",27,"س",1,0],["وَكانَ بَعيدَ القَعرِ مِن كُلِّ ماتِحٍ","فَغادَرتَهُ يُسقى وَيُشرَبُ بِاليَدِ",28,"د",1,0],["وَكَأَنَّ بَهجَتَها وَبَهجَةَ كَأسِها","نارٌ وَنورٌ قُيِّدا بِوِعاءِ",29,"ا",2,0],["وكانَ بمصرَ السحرُ قدْماً فأصبحتْ","وأسحارها أشعارُها تترقرقُ",30,"ق",1,1],["وَكانَ بِها البَشامُ مَراحَ أُنسٍ","فَماذا بَعدَنا فَعَلَ البَشامُ",31,"م",1,0],["وَكَأَنَّ بابَكَ كَعبَةٌ يَمحو بِها","زَلّاتِهِ مَن قَد أَتاها مُذنِبا",32,"ب",2,0],["وَكانَ بَردٌ بِالنَسيمِ يَرتَعِد","وَريقُهُ عَلى الثَنايا قَد جَمَد",33,"د",1,0],["وكَأنّ بَينَ عِنانِهِ ولَبانِهِ","رَشَأً يَريعُ إلى الكنِاسِ خَذولا",34,"ل",2,0],["وكأنْ بهِ لم يُبْقِ وِتْراً ضائعاً","في كربلاءَ ولا دَماً مَطلولا",34,"ل",2,0],["وَكانَ بِالمُرهَفاتِ ضَربُهُمُ","ضَربَ بَني الحَيِّ بِالمَخاريقِ",35,"ق",1,0],["وَكانَ بين فؤادي","وَالعقل فيه نزاع",36,"ع",1,0],["وكأن بها جثث القَتلى","أَوراق الغابة تنتثر",37,"ر",1,0],["وكان بدرٌ مطلع الأيام","ورفعة الصلاة والصيام",38,"م",1,0],["وكان بالصّنعة ذا إلمام","وحسبه شهادة الإمام",39,"م",1,0],["وَكَأَنَّ بَيْنَ ضُلُوعِهِمْ","كَبِداً أَلَمَّ بِهَا كُبَادُهُ",40,"د",2,0],["وكانَ بَشِيراً لَنَا مُنْذِراً","وَنُوراً لَنَا ضَوْؤُهُ قَدْ أَضَا",41,"ا",1,0],["وَكانَ بِالقُرْبِ مِنْها كَوْكَبٌ غَزِلٌ","يُصْغِي فَلَما رَآها، سَبَّحَ الله",42,"ه",1,0],["وكان بها المُثُل الصالحاتُ","لا الطالحاتُ ، هي المُقتدى",43,"ا",1,0],["وكأن بَردَ الماءِ منها مُطفىء","ٌ نارا مُضَرّمَة ً من العدوان",44,"ن",1,0],["وكان بها من لاعج الشوق ما به","وقد ظفر أهناهما الله ما هنا",45,"ن",2,0],["وكان بحثي على مقدار همته","حتى ملكت صفايا العلم والنجبا",46,"ب",2,0],["وَكانَ بِها مِن تونس الغربِ صالحٌ","شَريفٌ فلمّا فاهَ أَلقمهُ فِهرا",47,"ر",2,0],["وَكانَ بِهم يُدعى الأمينُ المُحكّما","عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما",48,"م",2,0],["وَكانَ بعدَ الفردِ خير فردِ","فَحَملت بِالكاملِ المُكمّلِ",49,"ل",1,0],["وَكانَ بُزَّةُ ما أُعطيتَ مِن حَسَنٍ","نَصراً عَزيزاً وَتَثبيتاً وَبُرهانا",50,"ن",2,0],["وكان برجليه يخط اذا مشى","على الرمل شكلا حبذا ذلك الشكل",51,"ل",1,0],["وكان بنا برا وللجود منهلا","وما ذاك الا انه البر والبحر",52,"ر",1,0],["وَكَانَ بِكُمْ فَاللهُ يَجْمَعُهُ بِكُمْ","قَرِيباً يًسَلِّي الْهَمَّ وَالْهَمُّ غَضْبَانُ",53,"ن",1,0],["وكأنَّ بسمتَها على أحلى فمٍ","سقطُ الفراشة في الربيع المؤنِس",54,"س",1,0],["وكأنَّ بُرداً فيه قد رفلت","من زرقة الأفلاك ينقدُّ",55,"د",1,0],["وَكأَنَّ بَرْدَ الظِّلِّ قَيْظٌ لافِحٌ","وكأَنَّ عَذْبَ العَيْشِ سُمٌّ ناقِعُ",56,"ع",1,0],["وكأنَّ بِشْراً سَاطِعاً إشْرَاقُهُ","في وَجْهِهَا مِنْ وَجْهِهِ البسَّامِ",57,"م",1,0],["وَكَأَنَّ بُلقَ الخَيلِ في حافاتِهِ","يَرمي بِهِنَّ دَوالِيَ الزُرّاعِ",58,"ع",1,0],["وكان به الإسراء من خير مسجد","إلى المسجد الأقصى إلى أوج ذروة",59,"ه",1,0],["وَكانَ بِصَدرهِ وطنٌ وعرضٌ","فَضمّ إِلَيهما مِن تلكَ إلّا",60,"ل",2,0],["وكان بودي لو قبلت تقربي","إليك ولكن لست أهلاً لقربة",61,"ه",1,0],["وَكانَ بِهِ سوق التَعَلم كاسِدا","وَلكِنَّهُ الآن اِستَمَرّ رَواجَه",62,"ج",2,0],["وكان بكاؤها ضَحِكاً لقومٍ","فلمّا أَن رقَتْ بكَتِ البَرايا",63,"ا",3,0],["وَكانَ بِتَتويجٍ جَبينُكَ عِندَهُم","خَليقاً كَما اِعتادَ المُلوكُ الأَعاجِم",64,"م",1,0],["وكأنّ بدراً في أسرّة وجْهِه","للنّاظرِين يُمدُّهم بضياء",65,"ا",2,0],["وكانَ بحرُ الخوفِ مُسترسل","في رُعبِهِ يدعو إلى الأعمقِ",66,"ق",1,0],["وكان به الصديق خير مصدق","فصدق خير الرسل في خبر السما",67,"م",2,0],["وكان بها بحر أجاج فأصبحت","ومن جوده العذب النمير بها بحر",68,"ر",1,0],["وكان بها طغيان فرعون لم يزل","كما كان لما أن طغا وتمردا",69,"د",2,0],["وكانَ بالوصْلِ منهُم لَوْ رَعَوْه قَمِنْ","ولَوْ تعوَّضَ عنهُم بالشّباب غُبِنْ",70,"ن",1,0],["وكان بعلم الطبّ أعلمَ عالِمٍ","وللعَسكر المنصور كانَ انتسابُه",71,"ب",2,0],["وكان بنعمةٍ لو كانَ يرعى","لها حقًّا ويوفي بالحقوق",72,"ق",1,0],["وكان بكم أميركمو","بلغتم غاية الشرف",73,"ف",1,0],["وكأنَّ بَرْد الظل تحت رواقه","في القيظ مسترق من الاسحار",74,"ر",1,0],["وكان بالكوثرِ العذب الفرات لِدى","حَضيرة القدسِ مرباها ومطعمها",75,"م",3,0],["وكان بعيني شُعلةً وهو مظلمٌ","فصار بقلبي ظلمةً وهو مُشْعَلُ",76,"ل",1,0],["وكأنّ بابَك لم يكن لعُفاته","حَرَماً يُجير ولا حمىً يُمتارُ",77,"ر",1,0],["وكان بكائي أنني لا أرى الأخَ ال","ودودَ فمَن لي أن أرى المتودِّدا",78,"د",2,0],["وكان بفلجٍ شملُ صبري مجمَّعاً","فشتتهُ ذاك الشنيبُ المفًّج",79,"ج",1,0],["وكأنَّ بدرَ التمِّ ملكٌ أبلجٌ","ومن السماءِ لهُ رداءٌ أزرق",80,"ق",1,0],["وكان بك البيت الحسيني مفاخرا","كذاك كذاك الفخر يتبعه الفخر",81,"ر",1,0],["وكان بيني وبين القوم ملحمة","في حربها ألسن الأديان تختصم",82,"م",1,0],["وَكانَ بِهِ عِرْفانُ تَتْمِمِ فَرْصِهِ","كَذَلِكَ قالَ الحَبْرُ قَوْلاً مُجَوَّدا",83,"د",2,0],["وكانَ به بَراًّ شَفوقاً لأنَّه","بخُلُقِهِ ذو بِرِّ شَفوقٍ مُوَاسيا",84,"ي",2,0],["وكان بعيداً عن منازعةِ الرّدى","فألْقَتْهُ في كفّ المنيّة أُمُّهُ",85,"م",2,0],["وكان بجهله عبداً كفوراً","برب ظاهر في الجاهلينا",86,"ن",2,0],["وكانَ بحراً ولكنْ غيرَ مُضطربٍ","وكانَ فخراً ولكنْ ليسَ يَفتَخِرُ",87,"ر",1,0],["وكان بالعراق من أتباعه","أكثر ما يرجوه من أشياعه",88,"ه",1,0]]}