tsgate.com/ViewPoem.aspx?id=196813",""],[5376,"وكأنَّ بالشعراء رأساً أينعتْ","https://www.poetsgate.com/ViewPoem.aspx?id=188542",""],[5376,"أشكو السَقَامةَ بالهوى يا شامُ","https://www.poetsgate.com/ViewPoem.aspx?id=188933",""],[5413,"إنا بفراقكما لمحزونون","https://www.poetsgate.com/ViewPoem.aspx?id=208634",""],[5425,"في كُلِّ يَومٍ لنا من كَربَلاءَ دَمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=207513",""],[5431,"هل يرتوي الدهر من دمع المساكين","https://www.poetsgate.com/ViewPoem.aspx?id=193388",""],[5736,"ماذا جنينا","https://www.poetsgate.com/ViewPoem.aspx?id=208202",""],[5751,"شَكوى مُسافر","https://www.poetsgate.com/ViewPoem.aspx?id=214716",""],[402,"هو العيش جهد طائل وفتون","https://www.poetsgate.com/ViewPoem.aspx?id=36535",""],[5937,"باحثٌ عن أناهُ في مابعد الحداثة","https://www.poetsgate.com/ViewPoem.aspx?id=211893",""],[5956,"في الذكرى* الأولى لوفاة شقيقي محمد","https://www.poetsgate.com/ViewPoem.aspx?id=192406",""],[2575,"يا ناعس الطرف","https://www.poetsgate.com/ViewPoem.aspx?id=10276",""],[463,"إذا لم يقرِّبْ منك إلا التذلُّلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60184&r=&rc=240",""],[5567,"أبدو .. ولا أبدو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81749&r=&rc=21",""]],"verses":[["وَكانَ بِدارِ الهونِ مُلقىً جُنوبُها","سَواءٌ عَلَيها مَوتُها وَحَياتُها",0,"ت",3,0],["وَكانَ بِالحَربِ يَلقى مَن يُنافِرُهُ","فَصارَ يَلقى الأَعادي بِالمَحاريبِ",1,"ب",1,0],["وَكانَ بَلِيَّةً أَنّي","نَظَرتُ فَشامَني النَظَرُ",2,"ر",1,0],["وَكانَ بَريدُ العِلمِ عيراً وَأَينُقاً","مَتى يُعيِها الإيجافُ في البيدِ تَظلَعِ",3,"ع",1,0],["وكان بغلٌ إليه","يدلي ببعض إتصال",4,"ل",1,0],["وكأن بين ضولعهم","كبدا ألم بها كباده",5,"د",2,0],["وَكَانَ بِكَ التَّوْفِيقُ لِلْعِلْمِ وَالحِجَى","فَمَاذَا دَهَى التَّوْفِيقَ حِينَ تَبِينُ",6,"ن",1,0],["وكانَ بودِّي لو أطقت تسلياً","فحققت عنهُ صبوتي كلما ملاّ",7,"ل",2,0],["وكان بها عشقٌ قديمٌ تُجنّهُ","فلما أُذيلتْ أظهرتْ ما أجنَّتِ",8,"ت",1,0],["وَكانَ بِنا يَحُلُّ فَلا يُعانى","وَيَرعى كُلَّ رَملٍ أَو عَزازِ",9,"ز",1,0],["وَكانَ بِها مِن أَهلِ شُعبَةَ شُعبَةٌ","مِنَ الجَورِ وَالعُدوانِ بَغيٌ وَعُدوانِ",10,"ن",1,0],["وَكانَ بَينَ جَيشِهِ بِأَخمرا","وَبَينَ إِبراهيم يَومٌ ذُو لَظى",11,"ا",1,0],["وَكانَ بِالقُربِ الَّذي تُريدُ","يَسمَعُ ما تُبدي وَما تُعيدُ",12,"د",1,0],["وَكانَ بَيانُهُ لِلهَديِ سُبلاً","وَكانَت خَيلُهُ لِلحَقِّ غابا",13,"ب",2,0],["وَكانَ بَنو كِلابٍ حَيثُ كَعبٌ","فَخافوا أَن يَصيروا حَيثُ صاروا",14,"ر",3,0],["وَكَأَنَّ بَرقاً في مُتونِ غَمامَةٍ","هِندِيُّهُ في كَفِّهِ مَسلولا",15,"ل",2,0],["وَكانَ بِها مِثلُ الجُنونِ فَأَصبَحَت","وَمِن جُثَثِ القَتلى عَلَيها تَمائِمُ",16,"م",1,0],["وَكانَ بَياضُ الرَأسِ شَخصاً مُذَمَّماً","إِلى كُلِّ بَيضاءِ الحَشا وَالتَرائِبِ",17,"ب",1,0],["وَكَأَنَّ بِشرَكَ في شُعاعِ كُؤوسِها","لَمّا تَوالَت في الأَكُفِّ دِراكا",18,"ك",2,0],["وَكانَ بَنو الدَيّانِ زَيناً لِقَومِهِم","وَأَركانَ طَودٍ بِالأَراكِ مَنيعِ",19,"ع",1,0],["وَكانَ بِمِصرَ اِثنانِ ما خافَ أَهلُها","عَدُوّاً وَلا جَدباً تُخافُ هَزايِلُه",20,"ل",2,0],["وَكانَ بِلالٌ حينَ يَستَلَّ سَيفَهُ","لَمَلحَمَةٍ بِالمُعلَمينَ يَنالُها",21,"ل",3,0],["وَكَأَن بِالمَرءِ قَد يَب","كي عَلَيهِ أَقرَبوهُ",22,"و",2,0],["وَكانَ بِصِفّينَ مِن حِزبِهِم","لِحَربِ الطُغاةِ وَأَحزابِها",23,"ب",3,0],["وكأنّ بَرْدَ الماءِ منها مُطفئٌ","ناراً مُضَرَّمَةً من العدوانِ",24,"ن",1,0],["وَكَأنَّ بَرْقاً في تَبَسّمِهِ","وكأنّما دَمْعي له قَطرُ",25,"ر",1,0],["وَكانَ بِهِ سَواحينٌ تُهَمّي","عَزالَيهِ الظَواهِرُ وَالغُيوبُ",26,"ب",1,0],["وَكَأَنَّ بَينَهُما رَضاعَ الثَدي مِن","فَرطِ التَصافي أَو رَضاعَ الكاسِ",27,"س",1,0],["وَكانَ بَعيدَ القَعرِ مِن كُلِّ ماتِحٍ","فَغادَرتَهُ يُسقى وَيُشرَبُ بِاليَدِ",28,"د",1,0],["وَكَأَنَّ بَهجَتَها وَبَهجَةَ كَأسِها","نارٌ وَنورٌ قُيِّدا بِوِعاءِ",29,"ا",2,0],["وكانَ بمصرَ السحرُ قدْماً فأصبحتْ","وأسحارها أشعارُها تترقرقُ",30,"ق",1,1],["وَكانَ بِها البَشامُ مَراحَ أُنسٍ","فَماذا بَعدَنا فَعَلَ البَشامُ",31,"م",1,0],["وَكَأَنَّ بابَكَ كَعبَةٌ يَمحو بِها","زَلّاتِهِ مَن قَد أَتاها مُذنِبا",32,"ب",2,0],["وَكانَ بَردٌ بِالنَسيمِ يَرتَعِد","وَريقُهُ عَلى الثَنايا قَد جَمَد",33,"د",1,0],["وكَأنّ بَينَ عِنانِهِ ولَبانِهِ","رَشَأً يَريعُ إلى الكنِاسِ خَذولا",34,"ل",2,0],["وكأنْ بهِ لم يُبْقِ وِتْراً ضائعاً","في كربلاءَ ولا دَماً مَطلولا",34,"ل",2,0],["وَكانَ بِالمُرهَفاتِ ضَربُهُمُ","ضَربَ بَني الحَيِّ بِالمَخاريقِ",35,"ق",1,0],["وَكانَ بين فؤادي","وَالعقل فيه نزاع",36,"ع",1,0],["وكأن بها جثث القَتلى","أَوراق الغابة تنتثر",37,"ر",1,0],["وكان بدرٌ مطلع الأيام","ورفعة الصلاة والصيام",38,"م",1,0],["وكان بالصّنعة ذا إلمام","وحسبه شهادة الإمام",39,"م",1,0],["وَكَأَنَّ بَيْنَ ضُلُوعِهِمْ","كَبِداً أَلَمَّ بِهَا كُبَادُهُ",40,"د",2,0],["وكانَ بَشِيراً لَنَا مُنْذِراً","وَنُوراً لَنَا ضَوْؤُهُ قَدْ أَضَا",41,"ا",1,0],["وَكانَ بِالقُرْبِ مِنْها كَوْكَبٌ غَزِلٌ","يُصْغِي فَلَما رَآها، سَبَّحَ الله",42,"ه",1,0],["وكان بها المُثُل الصالحاتُ","لا الطالحاتُ ، هي المُقتدى",43,"ا",1,0],["وكأن بَردَ الماءِ منها مُطفىء","ٌ نارا مُضَرّمَة ً من العدوان",44,"ن",1,0],["وكان بها من لاعج الشوق ما به","وقد ظفر أهناهما الله ما هنا",45,"ن",2,0],["وكان بحثي على مقدار همته","حتى ملكت صفايا العلم والنجبا",46,"ب",2,0],["وَكانَ بِها مِن تونس الغربِ صالحٌ","شَريفٌ فلمّا فاهَ أَلقمهُ فِهرا",47,"ر",2,0],["وَكانَ بِهم يُدعى الأمينُ المُحكّما","عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما",48,"م",2,0],["وَكانَ بعدَ الفردِ خير فردِ","فَحَملت بِالكاملِ المُكمّلِ",49,"ل",1,0],["وَكانَ بُزَّةُ ما أُعطيتَ مِن حَسَنٍ","نَصراً عَزيزاً وَتَثبيتاً وَبُرهانا",50,"ن",2,0],["وكان برجليه يخط اذا مشى","على الرمل شكلا حبذا ذلك الشكل",51,"ل",1,0],["وكان بنا برا وللجود منهلا","وما ذاك الا انه البر والبحر",52,"ر",1,0],["وَكَانَ بِكُمْ فَاللهُ يَجْمَعُهُ بِكُمْ","قَرِيباً يًسَلِّي الْهَمَّ وَالْهَمُّ غَضْبَانُ",53,"ن",1,0],["وكأنَّ بسمتَها على أحلى فمٍ","سقطُ الفراشة في الربيع المؤنِس",54,"س",1,0],["وكأنَّ بُرداً فيه قد رفلت","من زرقة الأفلاك ينقدُّ",55,"د",1,0],["وَكأَنَّ بَرْدَ الظِّلِّ قَيْظٌ لافِحٌ","وكأَنَّ عَذْبَ العَيْشِ سُمٌّ ناقِعُ",56,"ع",1,0],["وكأنَّ بِشْراً سَاطِعاً إشْرَاقُهُ","في وَجْهِهَا مِنْ وَجْهِهِ البسَّامِ",57,"م",1,0],["وَكَأَنَّ بُلقَ الخَيلِ في حافاتِهِ","يَرمي بِهِنَّ دَوالِيَ ال