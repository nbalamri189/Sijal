","https://www.poetsgate.com/ViewPoem.aspx?id=130320",""],[6090,"قدمت فليهن فيك المجد والجود","https://www.poetsgate.com/ViewPoem.aspx?id=170911",""],[6102,"منفى \"المتنبي\" الأخير...","https://www.poetsgate.com/ViewPoem.aspx?id=182749",""],[6102,"نَفَقَ الحِمارُ ..","https://www.poetsgate.com/ViewPoem.aspx?id=185211",""],[6115,"اللى يحبون الهروج اللفايق","https://www.poetsgate.com/ViewPoem.aspx?id=180496",""],[6142,"سل كربلا والوغى والبيض والأسلا","https://www.poetsgate.com/ViewPoem.aspx?id=155747",""],[6343,"فاكهة الكلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86039&r=&rc=10",""]],"verses":[["بِالنورِ تُنزِلُ آيَا","تِ حُكْمِهَا المَرْهُوبِ",0,"ب",1,0],["بالنطق عذباً والرأي عضبا","يفري من الباطل الوتينا",1,"ن",2,0],["بِالنَّاصِحِينَ وَنُصْحًهًمْ بَلَجٌ","بِالنَّاهِجِينَ وَنَهْجُهُمْ سَنَنُ",2,"ن",1,0],["بالنصر والإقبال والبركات","سكنى القصور ومنزَهُ الحركات",3,"ت",1,1],["بالنفس أضربُ في نضارٍ ذائبٍ","والسيف يضرب في حديدٍ بارد",4,"د",1,0],["بالنصفِ والكسر معاً","فلا كَرا ولا كِرا",5,"ر",2,0],["بالنازعات ومهجتي عوّذتها","وحجبتها بالمرسلاتِ وأدمعي",6,"ع",2,0],["بالنصر يعلي سمائي عندَ مرتقبٍ","والعدل يخصب عند إقحالي",7,"ل",2,0],["بالنور يهدي المشرقين","الى الصراط المستقيم",8,"م",1,0],["بالنعامات اللاهيات بمنتدىً","يبدو أشمّ على المياه فخيما",9,"م",2,0],["بِالنَفسِ وَخالِقِها نَثِقُ","وَنَزيدُ وُثوقاً في المِحَنِ",10,"ن",1,0],["بالنار صنعتها وفيها","سرها وولادّها",11,"د",3,1],["بِالنَصرِ يَمتَثِلُ المُعادُ المُبتَدا","وَالمالُ يَتَّبِعُ الطَريفُ التالِدا",12,"د",2,0],["بِالنَهرَوانِ وَعاقَدوهُ فَأَكَّدوا","عَقداً لَهُ بَينَ القُلوبِ وَثيقا",13,"ق",2,0],["بِالنَظَرِ المُطمِعِ","أَطَعتُ فَعاصَيتِني",14,"ي",1,0],["بالنيل والنهر الأسود","ولو حكى ابن فرات",15,"ت",1,0],["بالنتفِ ثم النبات يبقى","عذارُهُ السكرَ المكررْ",16,"ر",1,0],["بِالنَظرَةِ العَجلى وَبِالحَولِ يَنقَضي","أَواخِرُهُ لا نَلتَقي وَأَوائِلُه",17,"ل",2,0],["بالنّفس تَستبقُ الحتوفَ كريمةً","بين السُّيوفِ وبالنّجيع القاني",18,"ن",2,0],["بِالنَجنَجِيّاتِ مَعَ الثِيابِ","فَداكَ كُلُّ مَلِقٍ خَيّابِ",19,"ب",1,0],["بالنفس والنفيس أيّدوه","وبالقنا والرأي شيدوه",20,"ه",1,0],["بِالنَّصرِ نِلتَ الُملكَ قَد عَلِمَ ال","أَقوامُ لَم تَغدِر ولَم تَخَبِ",21,"ب",1,0],["بِالنَّبِيهِ النَّزِيهِ عَنْ كلِّ كِبْرٍ","بِتِّ أَحْرَى البِلاَدِ بِالكِبْرِيَاءِ",22,"ا",2,0],["بالنهر فيَّاضَ الجوانبِ يزدهي","بالمُطْربَينِ : خريرهِ وصليله",23,"ل",2,0],["بالنّهْرَوانِ، وَعَاهَدُوهُ، فأكّدُوا","عَقْداً لهُ، بينَ القُلوبِ، وَثِيقَا",24,"ق",2,0],["بالنبيين كلهم وصحاب","تبعوا أثرهم وبالابناء",25,"ا",2,0],["بالنفس يا شيخ من تقواك أشياء","ضاقت بها من فسيح الصدر أرجاء",26,"ا",2,1],["بِالنَسايا تُلغى وَتُنسى كَسَروٍ","أَفضَلٍ يَشتَريهِ بِالإِسلافِ",27,"ف",1,0],["بِالنَدى حينَ أَوعَزَ الجودُ وَالإِق","دامِ في حَيثُ زَلَّتِ الأَقدامُ",28,"م",1,0],["بالنفس افديه لا مال ولا ولد","حتى رأى منه طرف الدهر مطروفا",29,"ف",2,0],["بالناب قبل تمكّني","في البيت من أركانه",30,"ن",2,0],["بالنار خوَّفني قومٌ فقلتُ لهم","النارُ ترحم مَن في قلبه النارُ",31,"ر",1,0],["بِالناصِرِ المَولى الإِما","مِ وَجودِهِ الجَمِّ الجَزيلِ",32,"ل",1,0],["بالنفسِ جدتَ لكي تصونَ مهابتي","وعلى جَلالي بالنفوسِ يُجاد",33,"د",1,0],["بِالنَزعِ تَركُضُ في الصُدورِ سِهامُهُ","كَالطِرفِ حينَ يُهَزُّ بِالمِهمازِ",34,"ز",1,0],["بِالنَجمِ في ظُلَمِ الدَياجي تَهتَدي","وَضَلالَتي في الحُبِّ لَيسَت تُرشَدُ",35,"د",1,0],["بالنبيء المصطفى خير الورى","احمد الامي ذو القدر الاجل",36,"ل",1,0],["بالنفخ والقبض ارواحنا","من ساكن منها ومنزعج",37,"ج",1,0],["بالنصف من رمضان نسق جامعا","عملا ببر ذاك فهو علاءُ",38,"ا",2,0],["بِالنَيِّرينَ إِذا ما قَسَتهُ نَظَراً","أَبدَت لَكَ الفَرقَ مِثلَ الصُبحِ غُرَّتُهُ",39,"ت",2,0],["بالنّارِ فَرّقتِ الحوادثُ بيننا","وبها نذَرْتُ أعودُ أقتُلُ روحي",40,"ح",2,0],["بِالنَهيِ عَن كُلِّ خَمرٍ لِلعُقولِ بِها","سُكرٌ وَأَسلبُ مِن خَمرِ اِبنَةِ العِنَبِ",41,"ب",1,0],["بالنور ملتحفاً يومَ الصعود كما","قد كان مكتنفاً بالجند والخول",42,"ل",1,0],["بالنار مبدَعةً بقدرة قادرٍ","جاءت وليس لهنَّ جسمٌ أو عضل",43,"ل",1,0],["بالنبي المصطفى خير الورى","أحمد المبعوث رحمه للأنام",44,"م",1,0],["بالنصح للمسلمين والسخا واحتمال","والحسنب للظن والش