{"poems":[[23,"أولئك قومي فإن تسألي","https://www.aldiwan.net/poem21241.html","المتقارب"],[48,"أمذهبة التراس لرد كيد","https://www.aldiwan.net/poem22839.html","الوافر"],[255,"يروحي نسيم هب من أرض طيبة","https://www.aldiwan.net/poem15055.html","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67832","الطويل"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101977","الرمل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117264","الوافر"],[5672,"مجمرة الوهن","https://www.poetsgate.com/ViewPoem.aspx?id=206449",""]],"verses":[["بِيَثرِبَ قَد شَيَّدوا في النَخيلِ","حُصوناً وَدَجَّنَ فيها النَعَم",0,"م",1,0],["بِيَثرِبَ حُفرَةٌ خَرِسَت وَنادى","مُغَيَّبُها فَأَسمَعَ ذا خُراسِ",1,"س",1,0],["بيثربَ قبر بغيتي لو رأيتُهُ","وقبل ثغري حول أرجائهِ التُّربا",2,"ب",2,0],["بِيَثْرِبَ سَلَّمْنَا عَلَى خَيْرِ مُرْسَلِ","وَكُلُّ أَتَيْنَا نَحْوَهُ بِتَذَلُّلِ",3,"ل",1,0],["بيث مجد ظاهر فيه الفخار","كظهور الشمس في قلب النهار",4,"ر",1,0],["بيثرب للعلا رفعت قباب","بها للجود قد هطلت سحاب",5,"ب",1,1],["بي ثقلُ مَنْ بانوا ومَنْ رحلوا","ومَنِ ارتموا للبعدِ بالضعنِ",6,"ن",1,0]]}