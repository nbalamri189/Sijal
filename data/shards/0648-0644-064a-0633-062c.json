{"poems":[[55,"حقيق أن تكاثرك التهاني","https://www.aldiwan.net/poem29651.html","الوافر"],[53,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[53,"أبا علي للناس ألسنة","https://www.aldiwan.net/poem65409.html","المنسرح"],[53,"غدا الدهر مفترا أغر المضاحك","https://www.aldiwan.net/poem65812.html","الطويل"],[12,"ومرقبة عنقاء يقصر دونها","https://www.aldiwan.net/poem1216.html",""],[45,"أتاني كلام الجاهل ابن كيغلغ","https://www.aldiwan.net/poem10133.html","الطويل"],[48,"يحق كساد الشعر في كل موطن","https://www.aldiwan.net/poem22319.html","الطويل"],[48,"يقولون إن الجسم ينقل روحه","https://www.aldiwan.net/poem23123.html","الطويل"],[53,"أبا عليَّ للناس ألسنة ٌ","https://www.poetsgate.com/ViewPoem.aspx?id=29593",""],[60,"ألا هل إلى طول الحياة سبيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15571&r=&rc=97",""],[382,"يا قلب طِر من وكنة الأحشاء","https://www.aldiwan.net/poem66956.html","الكامل"],[458,"أفى العرس تنعى يالها قسوة القدر","https://www.aldiwan.net/poem61712.html","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93697","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76022","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48314","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[4691,"محمد صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=146375",""],[4578,"سليم فؤادي لا تظن سلاماً","https://www.poetsgate.com/ViewPoem.aspx?id=49521",""],[4119,"أيا عاذلي في الحب مالي وللعذل","https://www.poetsgate.com/ViewPoem.aspx?id=16210",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5186,"ورد الربيع شذا من ربع غسان","https://www.poetsgate.com/ViewPoem.aspx?id=156440",""],[5186,"أرقت وهاجتني وقد هجع الركب","https://www.poetsgate.com/ViewPoem.aspx?id=156457",""],[592,"فليس بنظم مستقم ولم يكن","https://www.poetsgate.com/ViewPoem.aspx?id=128801",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5956,"وُعُود الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=192695",""],[6021,"أشقى القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=201663",""],[5724,"رسول العلى والفضل والخير والهدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55159&r=&rc=26",""],[6299,"بِكَفَّيِّ مِنْها لِلْبَغيضِ عُرَاضة ٌ وَمَرْقَبَة ٍ عَنْقَاءَ يَقْصُرُ دُونَها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19688&r=&rc=13",""]],"verses":[["وَلَيسَ جَوادُهُ في النَقعِ إِلّا","طَليعَةَ كُلِّ يَومٍ أَروَنانِ",0,"ن",1,0],["وليس جزائي أن أَخيب لأنني","جَبُنْتُ ولم أُخْلَق عتادَ مُحارِبِ",1,"ب",1,0],["وليس جهلي جهلاً يبلغني ال","ظلم وإن كان فيه ممتنع",2,"ع",1,0],["وليس جزاءً أنْ عفا إذ مَدَحْتُه","وقد كنتُ أهلاً للعِصيِّ الدَّمالك",3,"ك",1,0],["وَلَيسَ جِهازي غَيرُ نَعلَينِ أُسحِقَت","صُدورُها مَخصورَةً لا تُخَصَّفُ",4,"ف",1,0],["وَلَيسَ جَميلاً عِرضُهُ فَيَصونَهُ","وَلَيسَ جَميلاً أَن يَكونَ جَميلا",5,"ل",2,0],["وَلَيسَ جِسادٌ في تَرائِبِ كاعِبٍ","كَأَحمَرَ مِنهُ مَضرَبُ السَيفِ جاسِدُ",6,"د",1,0],["وَلَيسَ جُسومٌ كَالنَخيلِ وَإِن سَما","بِها الفَرعُ إِلّا مِثلَ ما نَبَت البَقلُ",7,"ل",1,0],["وليس جهليَ جهلاً يُبلِّغني الظ","ظُلم وإن كان فيه مُمتنِعُ",8,"ع",1,0],["وليس جليلا رزء مال وفقده","ولكن رزء الاكرمين جليل",9,"ل",1,0],["وليَسجُدَنَّ لديك يا ربَّ الورى","ما في السماء وفوقَ كل ثراء",10,"ا",2,0],["وليس جلالُ الموتِ ما هو قاهري","ولكن جلالٌ في تساميه ما قَهر",11,"ر",1,0],["وَلَيسَ جَنيُّ النَحلِ أَحلى مذاقه","مِن اسم عليٍّ في فم المتكلم",12,"م",1,0],["وَلَيسَ جودك مقصوداً على أحدٍ","بل أنتَ كالغَيثِ عَمَّ الترب والزَّلَقا",13,"ق",2,0],["وليسَ جُناحٌ على الدّهْرِ إذْ","أبى لِجناحِيَ أن يُخْفَضا",14,"ض",2,0],["وَلَيسَ جَديراً بِصيدِ الرِجالِ","مَغادَرَةُ الكَرِّ يَومَ النِزالِ",15,"ل",1,0],["وليسَ جنيناً تشتكي الطلقَ أمُّهُ","وَلكِنّهُ الرَّحماتُ جاءَتْ لِتُنْجِدا",16,"د",2,0],["وليس جديد الحب مما يزيل ما","بقلبي من حب الحسين أقاما",17,"م",2,0],["وليس جزيل الحمد إلا لمن له","دقيق معاني العلم في المنطق الجزل",18,"ل",1,0],["وليس جوى عهد الجواء أثاره","يداوي بمغنى في سحاء سحاء",19,"ا",2,0],["وليس جدرانها إلا مظاهرها","وما النظافة في تلوين جدران",20,"ن",1,0],["وليس جمال السرب إلا بجمعه","وأنتم لنا يا بهجة الأمة السرب",21,"ب",1,0],["وليس جميع الساكنين بدارهم","ولا جلهم ممن تسربل بالحلل",22,"ل",1,0],["وليس جليلاً عند كل موحدٍ","وكيف وقد أظهرت في قولك الشرا",23,"ر",2,0],["وليس جزاءُ سرابِ الوعود","سوى باجتثاثِ المحبة منّا",24,"ن",2,0],["وليس جهلاً بمن أقصاه عن كبدي","فإنّه ضلَّ عني عند مسراها",25,"ا",3,0],["وليس جديدا ما نرى من تصارع","هو البغي لكن بالأسامي تجددا",26,"د",2,0],["وليس جَهَازِي غَيْرُ نَعْلين أَسْحَقَتْ","صُدُورُهُما مَخْصُورَة ً لا تُخَصَّفُ",27,"ف",1,0]]}