داك الكون","https://www.poetsgate.com/ViewPoem.aspx?id=178772",""],[4816,"حورية","https://www.poetsgate.com/ViewPoem.aspx?id=8480",""],[4859,"عذب التهاني!","https://www.poetsgate.com/ViewPoem.aspx?id=204883",""],[4869,"مثلي مثل هالناس","https://www.poetsgate.com/ViewPoem.aspx?id=151518",""],[4869,"احتفال اليوم الوطني السعودي في الاردن","https://www.poetsgate.com/ViewPoem.aspx?id=151631",""],[4988,"كل عام وانتم يابني ادم بخير","https://www.poetsgate.com/ViewPoem.aspx?id=181123",""],[585,"صوتٌ تجاوب بين الهمس والعلن","https://www.poetsgate.com/ViewPoem.aspx?id=161884",""],[5072,"رهو ٌ هو العيد","https://www.poetsgate.com/ViewPoem.aspx?id=51900",""],[3591,"أشد عوادي الدهر خلق لئيم","https://www.poetsgate.com/ViewPoem.aspx?id=149432",""],[5184,"داريْ صِغاركِ","https://www.poetsgate.com/ViewPoem.aspx?id=186356",""],[5264,"نور عيونو","https://www.poetsgate.com/ViewPoem.aspx?id=176197",""],[5264,"لما واحد","https://www.poetsgate.com/ViewPoem.aspx?id=180139",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5409,"لم يبتهج لي قلبٌ فيك مكتئبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=155394",""],[5431,".حالة جميع السوريين ....ولو أنني ظلٌ ثقيل على الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=190607",""],[5431,"البردة -ريم","https://www.poetsgate.com/ViewPoem.aspx?id=190769",""],[2229,"أُعِيدُُها هيفا بربّ الفَلَقِ","https://www.poetsgate.com/ViewPoem.aspx?id=49795",""],[5690,"اللّه أكبرُ هذا عصر تجديدِ","https://www.poetsgate.com/ViewPoem.aspx?id=172153",""],[5690,"قم ودع الغرب أن الشرق ناداكا","https://www.poetsgate.com/ViewPoem.aspx?id=172169",""],[5786,"يميناً بها إن كنت للصبّ مُسعِدا","https://www.poetsgate.com/ViewPoem.aspx?id=50660",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5821,"رجل المواقف","https://www.poetsgate.com/ViewPoem.aspx?id=114116",""],[5956,"تفانيتَ من أجلي","https://www.poetsgate.com/ViewPoem.aspx?id=194014",""],[6225,"عيد ولكن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80907&r=&rc=176",""],[2220,"إني سألتكَ أسماءً وحصرتُها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11340&r=&rc=214",""]],"verses":[["وَكُلُّ عَقيلَةٍ لِلجودِ تُمسي","عَطولَ الجيدِ حالِيَةَ الفِعالِ",0,"ل",1,0],["وَكُلِّ عَتِيقٍ مِنْ تَمَاثِيلِ رُومةٍ","تَأَنَّقَ فِي اسْتِخْطَاطِهِ الْقَسُّ وَالْقُمْطُ",1,"ط",1,0],["وَكُلُّ عَبرى تَبيتُ اللَيلَ ساهِرَةً","تَبكي بُكاءَ حَزينِ القَلبِ مُشتاقِ",2,"ق",1,0],["وكلّ عافٍ بحرف الخطّ متّصلٌ","وكلّ عادٍ بحرف السيف محذوف",3,"ف",1,0],["وكلّ عضب ذرب المقاطع","يحرّف الهام عن المواضع",4,"ع",1,0],["وكلّ عبدٍ أراد الله عصمتهُ","لم يُخْله الله من وعظٍ وإذكار",5,"ر",1,0],["وكل عنْز دنا رَداها","لشفرة الذبح مستثيره",6,"ر",2,0],["وكل عاد فمنحلٌ ومنعقدٌ","دماً ولحما ففكِّر فيه واعتبرِ",7,"ر",1,0],["وكلُّ عقفاءَ إليه تُوصَفُ","مثلَ الهلالِ وهي منه أنحَفُ",8,"ف",1,0],["وَكُلَّ عُرْسٍ أَتَاهُ للعَرُوسِ أَبَاً","يُلْقِي التَّحِيَّةَ للأَضْيافِ وَالوُسُدَا",9,"د",2,0],["وكلّ عُقابٍ جانحٍ بقوادمٍ","مُعَقٍّ بطرف سابِحٍ بقوائِمِ",10,"م",1,0],["وكُلٌّ على مِقدارِ حَسْرَتِهِ بَكى","عليّ ولاقَى ما اقتضاه مِنَ الشكلِ",11,"ل",1,0],["وَكُلُّ عَريقٍ في الشجاعَةِ مقدمٌ","له الضربةُ الفرغاءُ والطعنةُ السُّلكى",12,"ك",2,0],["وكلُّ عميمٍ في النّجادِ كأنَّمَا","تمطّى بمتنَيْهِ على قَرنِه جِذع",13,"ع",1,0],["وَكُلُّ عُضوٍ لِأَمرٍ ما يُمارِسُهُ","لا مَشيَ لِلكَفِّ بَل تَمشي بِكَ القَدَمُ",14,"م",1,0],["وكُلَّ عَلَنْدَاةٍ جَعَلْنَا دَوَاءَهَا","عَلَى عهدِ عادٍ أَنْ تُقَاتَ وتُرْبَدَا",15,"د",2,0],["وكلّ عزٍّ في ظلال الباطل","نسج عناكب وخيط باطل",16,"ل",1,0],["وكُلُّ عِلْمٍ فلَهُ فُنُونُ","وكُلُّ فَنٍّ فَلهُ عُيونُ",17,"ن",1,0],["وكل على ذاك لاقى الردى","وبادوا جميعا فهم خامِدونا",18,"ن",2,0],["وكلُّ عقلٍ مُضِيءٍ","إلى خمودٍ وأَفْن",19,"ن",1,0],["وكل علم لمخلوق تقدمه","أو سوف يعقبه من بحره نبعا",20,"ع",2,0],["وكل عبد مرسل قد قضى","وكل صديق هداك اقتفي",21,"ف",2,0],["وكل عين حزيم الظبي قرتها","لا تستبيها رياض منك غناء",22,"ا",2,0],["وَكُلُّ عَصرِكَ أَعيادٌ مُجَدَّدَةٌ","فَما نُبالي مَضى ذا العيدُ أَم قَدِما",23,"م",2,0],["وَكُلٌّ عالِمٌ لَكِن خَضُوعي","لِغَيرِ عُلاكَ بَعدَ اللَهِ خَبلُ",24,"ل",1,0],["وَكُلُّ عَلياءَ في الإِسلامِ فَهيَ بِهِم","تُبنى وَقُطبُ الرَحى مِنهُم وَهادِيها",25,"ي",3,0],["وَكلُّ علومِ الخلقِ مِن كلّ عالمٍ","تُرى قطرةً إِن قابلت ذلك البحرا",26,"ر",2,0],["وَكلُّ علوٍّ فهو سفلٌ وعكسهُ","وَقُل نحوَ هَذا في اليمين وفي اليسرى",26,"ر",2,0],["وكلُّ عضبٍ إذا لم","يقع على اللينِ ينبو",27,"ب",2,0],["وكلُّ عتاب كانَ صعباً تضيَّقت","مسالكُه ألجا إلى الكَذِب السَّهلِ",28,"ل",1,0],["وكلُّ عزيزٍ بالوِصال منعّمِ","فإن غريرَ الحبِ فهو ذليلُ",29,"ل",1,0],["وكلّ عَيْنٍ بكَ مَفْتونَةٌ","وكُلُّ قلب لك مُشْتاقُ",30,"ق",1,0],["وَكُلُّ عَضبٍ كَأَنَّ رَونَقَهُ","جَدوَلُ ماءٍ في الغِمدِ مُطَّرِدُ",31,"د",1,0],["وكل على مقدار همة نفسه","وإبداعها يبدي الغريب ويبدع",32,"ع",1,0],["وكل على نهج السبيل السوي لمن","يخالف أمراً آخذاً بالشريعة",33,"ه",1,0],["وكل عبد منيب","وكل عبد شكور",34,"ر",1,0],["وكلّ على أسّ منَ العلمِ تنبنى","إِشادتهُ فيما يسوسُ وهدمهُ",35,"م",2,0],["وَكُلِّ عِبءٍ أَيَّدٍ ثَقيلِ","أَوَّلَ ما رُزِئتُ بِالرَسولِ",36,"ل",1,0],["وكُلُّ عَينٍ قابلَتْه فانْثنَتْ","مَملوءةً من الدّموعِ الذُّرّف",37,"ف",1,0],["وَكُلُّ عِتابٍ بَينَ وُدَّينِ داخِلٌ","وَإِلّا فَلا تَتعَب فَما يَأذَنُ الوُدُّ",38,"د",1,0],["وكُلٌّ عزمُه فيه قصورٌ","وكلٌّ نارُه فيها خمود",39,"د",1,0],["وَكُلُ عَذاب يَرتَضيهِ عُقوبَةً","لِنَفسي سِوى الأَعراض يَحمِلهُ القَلب",40,"ب",1,0],["وكلٌ عظّم الإسلام حتى","عرفناهم عمالقة عظاما",41,"م",2,0],["وكل على ظهر البسيطة شاهد","بصدق الذي فاهت به نفثاتي",42,"ت",2,0],["وكلُّ عزيزٍ يومَ رُحْنَ ذَليلُ","كَتَمْتُ هَوى ظَمياءَ كِتمانَ مُعْلِنِ",43,"ن",1,0],["وكلِّ عُقابِ شاهِقَةٍ تَجَلَّى","أناسيُّ الحتوفِ لما تُجَلِّي",44,"ل",2,0],["وكُلٌّ عليها شاهِدٌ غيرُ شاهِدٍ","وَلَيْسَ لَهَا حاشاكَ من حَكَمٍ عَدْلِ",45,"ل",1,0],["وكل عاقبةٍ إلا إلى سقر","أو جنةمع مليك جل مقتدر",46,"ر",1,0],["وكلُّ عُلاكُمْ من قديمٍ وحادثٍ","وما عُدَّ من فخرٍ مُقيمٍ وذاهبِ",47,"ب",1,0],["وكلُّ عفٍّ طليقٍ في فصاحته","لسانه بحريز العقل معقول",48,"ل",1,0],["وكل عنده أمل وحرص","وما هو غير زرع في حصاد",49,"د",1,0],["وكُلُّ عَبدٍ إذا ما","وافى بِسيرَةِ قارِفْ",50,"ف",1,0],["وكُلِّ عَرَّاصَةٍ مُثقّفةٍ","فيها سِنان كشُعلَةِ اللّهَبِ",51,"ب",1,0],["وكُلِّ عَضبٍ في متنهِ أثَرٌ","ومَشرَفِّي كالمِلحِ ذي شُطَبِ",51,"ب",1,0],["وكلُّ عظيمِ القدرِ شرقا ومضغرِبا","به عارِفٌ والنِّدُّ يَعرِفه النِّدُّ",52,"د",1,0],["وكلِّ عانٍ في إسارِ الهوى","يُحسب يَقظانَ من النُوَّمِ",53,"م",1,0],["وكل عقل وكل حسن","والمتمنين والأماني",54,"ن",2,0],["وكل عبد بما لديه","في محنة منه وافتتان",54,"ن",1,0],["وكل عبادةٍ فالشرط فيها","هو الإسلام حفظاً للعهود",55,"د",1,0],["وكلٌّ على ما كان فيه ولم يزل","قديماً وهذا قول أشرف قود",56,"د",1,0],["وكل علوم العالمين وإن علت","مظاهر تبدو بين روح ونفخة",57,"ه",1,0],["وكل عقول العالمين ضلاله","له الوهم وهم والخيال خياله",57,"ه",1,0],["وكل على كل تقدم في العلى","على قدر فضل السن غير مغالب",58,"ب",1,0],["وكل عوار وكل وغر","من كل ذي قلب نقي الصدر",59,"ر",1,0],["وكل عليل يسترد حياته","إذا ردّت الأيام ما أخذتْ منا",60,"ن",2,0],["وكلُّ عاصٍ من البريّةِ لي","وحديَ منْ كلِّ طائعٍ أطْوَع",61,"ع",1,0],["وَكُل عَضوٍ قابِلٌ لِلداءِ","وَيطلب الحَكيم لِلدَواءِ",62,"ا",2,0],["وَكُلُّ عَزيزٍ خاضِعاً مُتواضِعاً","وَكُلُّ يمانٍ عَن يَمينك يُمطِرُ",63,"ر",1,0],["وكلُّ عضوٍ يُشْتكى منه ألمْ","فذاكَ بالعضو احتقانُ خلْطِ دمّْ",64,"م",1,0],["وكلُّ عوراءَ فيه","نعم تُوارى وتُسْتَر",65,"ر",1,0],["وكل عسير بُرؤُه فعلاجه","على ذي الحجى سهلٌ بأدوية الصبرِ",66,"ر",1,0],["وكل عسّال وفضفاضه","ومطلق الحدَّين عريانا",67,"ن",2,0],["وَكُلُّ عَيْنٍ بِمَاءِ الدمع في غَرَقٍ","وَكُلُّ قَلْبٍ بِنَارِ الشَّوْقِ مُتَّقِدِ",68,"د",1,0],["وكل عارٍ كُسي من فيضها حللاً","من سندسٍ وانثنى يشدو بجدواها",69,"ا",3,0],["وكل عامٍ به تكسى الخلاع ترى","عزاً جديداً واقبالاً به التحقا",70,"ق",2,0],["وكل عضوٍ به سعد السعود لهُ","علامةٌ في سواه ما لها أثرُ",71,"ر",1,0],["وَكلُّ عضوٍ لهُ لسانٌ","يَقولُ ما قالِتِ الوُشاةُ",72,"ه",1,0],["وكل عبدٍ مرشدٍ وناصحِ","فاسلم وعش على طريقٍ صالحِ",73,"ح",1,0],["وكلُ علمٍ عشتَ عُمراً فيه","تموت قاصراً ولا تنهيه",73,"ه",1,0],["وكلٌّ على الباب يبغي الدّخو","لَ والبابُ كالصّخرةِ الجامده",74,"د",2,0],["وكلُّ عيشٍ دامت غضارَتُهُ","مُنقطِعٌ مرَّةً ومُنصرِمُ",75,"م",1,0],["وكل عتيكيّ العزيمة فاتك","شديد ثبات الجأش ليس بزمَّلِ",76,"ل",1,0],["وكلَّ عذْرآء من مكارمهِ","وهو بأغْلى المُهور يخطْبُهُا",77,"ب",3,0],["وكلَّ عام يعودُ العيدُ في نِعمٍ","منها نصيبُك موفورٌ بلا نَصَبِ",78,"ب",1,0],["وكل عتيكيّ إِذا ماسألته","تبَلّج كالمصباح واهتَزّ كالنصلِ",79,"ل",1,0],["وكلّ عنه لسانُ البرق ثم دعا","بالرعد أكرمتَ إنِّي عنك ذو قصر",80,"ر",1,0],["وكل عواصم الإسلام تبكي","ونسوتُه جميعاً نائحاتُ",81,"ت",1,0],["وكِلْ عِدَاك لما تَطْوي صُدُورُهُمُ","يكفيكَ منهمْ ويكفيهمْ ويكفيني",82,"ن",2,0],["وكلٌّ علينا أن نسبح باسمه","إذا نحن أهللنا ومن يعص بفسق",83,"ق",1,0],["وكل عاطش يزيد فيه العطش","للما إذا أبصر يباس الساقيه",84,"ي",2,0],["وكل عبدٍ ملكٍ عندهُ","والبعثُ بعد الموتِ والفصلِ",85,"ل",1,0],["وكل عشرٍ طلعت بعدها","فهي على حسبانها تتبعُ",86,"ع",1,0],["وكل عاف وذي قربى وأرملة","وبائس ويتيم خانه الزمن",87,"ن",1,0],["وكل عتبٍ وإعتابٍ جرى فله","بدائع حلوة عندي وآثار",88,"ر",1,0],["وكل عدو مسهم باذية","يعود عليهم بالردى ذلك المس",89,"س",1,0],["وكل على الإسلام غطى عيوبها","كما ان ضوء الشمس غطاه لعلعا",90,"ع",2,0],["وكل عين من الأعداء تطلبُه","ولا سبيل إلى فوزٍ بلا سندِ",91,"د",1,0],["وكلُّ عليٍّ في الوجودِ مقيَّدٌ","سوى مَن تعالى فالعليّ هو الله",92,"ل",2,0],["وكل علق إلى مراحي","أهدى من الطير للوكون",93,"ن",1,0],["وكل علم لم يكن دليله","عن قول ربّ العرش أو رسوله",94,"ه",1,0],["وَكُل عَظيم صارَ يَهدي لِمثله","وَهذا سمت آلاء مَعروفه الغرا",95,"ر",2,0],["وكل عافص شديد القَبْضِ","وَخِلْطُهُ مُنْتَسِبٌ لِلأَرْضِ",96,"ض",1,0],["وكل علمٍ وفنٍّ ظلّ ينشدهم","بدائع الشكر تقريظاً لما نالوا",97,"ل",3,0],["وكل عزيزٍ في علاه مذللٌ","وكل عظم القريتين حقير",98,"ر",1,0],["وكلّ على القلب مُستنكر","ثقيل كدين على مُعسر",99,"ر",1,1],["وكلّ عجماء لا تدري مطالبها","من المعاش بقفر الأرض في همج",100,"ج",1,0],["وكلُّ عَزيزٍ خَش