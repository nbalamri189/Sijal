ُم حِمامُ المَوتِ مِنّا","خِيارَ الزائِدِ اِعتَرَضَ النِماطا",3,"ط",2,0],["تَخَيَّلَ ضَوءَ دِرهَمِهِ الأَماني","مَضاجِعَ هامَةِ القَمَرِ المُنيرِ",4,"ر",1,0],["تُخَيِّرُني عِفَّتي وَالغِنى","وَمَن لِيَ أَنّي مَلَكتُ الخِيارا",5,"ر",2,0],["تُخَيَّبُ في جَوانِبِها المَساعي","وَيُنقَصُ في مَواطِنِها الإِباءُ",6,"ا",2,0],["تَخَيَّرَهَا فِكْرِي فَرَاقَ نِظَامُهَا","كَمَا رَاقَ مِنْ دُرِّ النُّحُورِ نَظِيمُهُ",7,"م",2,0],["تخيّرَ أعْظَمَهُ مَرْمَرا","فجاءوا بكُلِّ قويٍّ شَديدْ",8,"د",1,0],["تَخَيَّرَها أَخو عاناتَ شَهراً","وَرَجّى أَولَها عاماً فَعاما",9,"م",2,0],["تَخَيَّرَهَا الياسُ مِنْ كَرْمِهِ","وَمِنْ خَيْرِ صُنْفٍ لأَحْلَى العِنَبْ",10,"ب",1,0],["تخير في الأنساب أصدقها على","وأبعدها مرمىً فتم له القصد",11,"د",1,0],["تَخَيَّرَ الخُطَّةَ المُثْلَى لَهُ وَلَهَا","يَعْلُو فَتَعْلُو بِهِ وَالخَفْضُ لِلشَّانِي",12,"ن",2,0],["تَخَيَّرنَ مِنها قَيَسرِياً كَأَنَّهُ","وَقَد أَنهَجَت عَنهُ عَقيقَتُهُ قَصرُ",13,"ر",1,0],["تخيْلَ للعينين جرحاً وإنما","بدا كلفٌ منه على صفحة القمرْ",14,"ر",1,0],["تَخَيَّرَهُم مَروانُ مِن بَيتِ رِفعَةٍ","وَكانَ لَهُم كُفءً وَكانَ لَهُم صِهرا",15,"ر",2,0],["تَخَيَّرَتِ المَنايا يَومَ زارَت","نَواصِيَنا تُقَمِّعُها اِنقِماعا",16,"ع",2,0],["تَخَيَّرُ ما بَينَ الرِجامِ وَواسِطٍ","إِلى سِدرَةِ الرَسَّينِ تَرعى السَوابِلا",17,"ل",2,0],["تَخَيَّرنَ مِن غَولٍ عِذاباً رَوِيَّةً","وَمِن مَنعِجٍ بيضَ الجِمامِ عَدامِلا",17,"ل",2,0],["تَخَيَّر ثَلاثاً كُلُّهُنَّ مَهانَةٌ","سَلاسِلُ أَغلالٍ تَشينُ المَقادِما",18,"م",2,0],["تخيلتُ في إنشاءِ لفظيَ نجعة","فما نشأَت لي لمعةٌ بسحاب",19,"ب",1,1],["تخيَّرته أكفّ الموت عارفةٌ","بنقدِه وتنقته المقادير",20,"ر",1,0],["تخير طرفي قدَّها العدل شاهداً","فألفيته أيضاً أجلّ شروطي",21,"ي",1,0],["تخيَّرته دون الأنام ولذَّ لي","به بدل البعض الجميل من الكلّ",22,"ل",1,0],["تخيَّرَهُ الوزيرُ وزيرَ صدقٍ","وللوزراء خبطٌ واعتيامُ",23,"م",1,0],["تَخَيَّرُ مِن لَبَنِ الآرِكا","تِ بِالصَيفِ بادِيَةً وَالحَضَر",24,"ر",1,0],["تَخَيَّرَ أَحداثُ اللَيالي كِبارَنا","كَأَنَّ المَنايا صَبَّةٌ بِالأَكابِرِ",25,"ر",1,0],["تُخَيَّرُ مِن أَمرَينِ لَيسا بِغِبطَةٍ","هُوَ الثَكلُ إِلّا أَنَّها قَد تَجَمَّلُ",26,"ل",1,0],["تُخَيِّرنَ مِن أَثلِ الوَريعَةِ وَاِنتَحى","لَها القَينُ يَعقوبٌ بِفَأسٍ وَمِبرَدِ",27,"د",1,0],["تَخَيَّر إِفريقيا تاجَهُ","وَرَكَّبَ في التاجِ صومالَها",28,"ل",3,0],["تَخَيَّروا الأَرضَ قَبلَ الناسِ أَم عَمَروا","لَدى الدَساكِرِ تِلكَ الأَرضَ رُوّادا",29,"د",2,0],["تَخَيَّرَ دينارُ بنِ دينارٍ العُلا","لِزُهرٍ كَأَقمارِ الدُجُنَّةِ صيدِ",30,"د",1,0],["تَخَيَّرَ خَيرَ الناسِ لِلناسِ رَحمَةً","وَبَيتاً إِذا العادِيُّ عُدَّت أَوائِلُه",31,"ل",2,0],["تَخَيَّروا قَبلَ هَذا الناسِ إِذ خُلِقوا","مِنَ الخَلائِقِ أَخلاقاً مِنَ الكَرَمِ",32,"م",1,0],["تَخَيَّرَ أنوارَه جَامِعٌ","يَروحُ ويَغدو لها مَجمَعا",33,"ع",2,0],["تخيَّرتُ أفوافَ المديحِ فلم أُنِخْ","ببابِ بني العبّاسِ إلا لُبابَها",34,"ب",3,0],["تخيَّلَ شِعري أنه قَومُ صالحٍ","هلاكاً وأن الخالديَّ له السَّقْبُ",35,"ب",1,0],["تخيَّرَ المجدُ أعلى نسبةٍ فغَدا","إلى عليِّ بنِ عبد الله يَنتسِبُ",36,"ب",1,0],["تَخَيَّرَكَ الإِمامُ عَلى رِجالٍ","لِأُمَّتِهِ فَما حُرِمَ الخِيارا",37,"ر",2,0],["تَخَيَّرتُ مِن نَعمانَ عَودَ أَراكَةٍ","لِهِندٍ وَلَكِن مَن يُبَلِّغُهُ هِندا",38,"د",2,0],["تَخَيَّرتُهُ مِن رَهطِ أَعوَجَ سابِحاً","أَغَرَّ كَريمَ الوالِدَينِ نَجيبا",39,"ب",2,1],["تَخَيَّلنَ أَن هَبَّت لَهُنَّ عَشيَّةٌ","جَنوبٌ وَأَن لاحَت لَهُنَّ بُروقُ",40,"ق",1,0],["تخيّرتَ الرجالَ وقمتَ فيهم","تُدير الحكمَ سمحاً مُستطابا",41,"ب",2,0],["تَخَيَّرَ صنفَيها كُروبٌ وَموزَرٌ","لِحَصدِ البَرايا مِن أَخيرٍ وَأَوَّلِ",42,"ل",1,0],["تَخَيَّلَ مرْحَبٌ ما ليس حَقّاً","وَمنَّتْهُ الظُّنونُ مُنىً كِذابا",43,"ب",2,0],["تُخيِّرَ مِن سَرارَةِ أَثلِ حَجرٍ","وَلاحَكَ بَينَهُ نَحتُ القُيونِ",44,"ن",1,0],["تَخَيَّرَها لِكِسرى رائِداهُ","لَها حَظّانِ مِن لَونٍ وَريحِ",45,"ح",1,0],["تِخُيِّرَت وَالنُجومُ وَقفٌ","لَم يَتَمَكَّن بِها المَدارُ",46,"ر",1,0],["تَخَيُّلٌ مِن بَني الدُنيا غَدا عَجَباً","لِلمُفكِرينَ وَكُلُّ الناسِ مَحسورُ",47,"ر",1,1],["تَخَيَّرَتِ اللِباسَ بَناتُ سامٍ","وَنُسوَةُ حامَ لَم تُستَر بِإِزرِ",48,"ر",1,0],["تُخَيِّمُ يا اِبنَ آدَمَ في اِرتِحالٍ","وَتَرقُدُ في ذَراكَ وَأَنتَ ساري",49,"ر",2,1],["تُخُيِّرَ خَلقُنا وَالشَرُّ طَبعٌ","فَما نَحتاجُ فيهِ إِلى اِختِلافِ",50,"ف",1,0],["تَخَيَّر فَإِمّا وَحدَةٌ مِثلُ مَيتَةٍ","وَإِمّا جَليسٌ في الحَياةِ مُنافِقُ",51,"ق",1,0],["تخَيّلتِ الصّبَاحَ مَعِينَ مَاءٍ","فما صَدَقَتْ ولا كذَبَ العِيانُ",52,"ن",1,0],["تخَيّرْتُ جُهْدي لو وَجدْت خِيارَا","وطِرْتَ بعَزْمي لو أصَبْتُ مَطارا",53,"ر",2,1],["تُخُيِّرنَ أَنضاءً وَرُكِّبنَ أَنصُلاً","كَجَمرِ الغَضا في يَومِ ريحٍ تَزَيَّلا",54,"ل",2,0],["تَخَيَّرتُ أَمراً ذا سَواعِدَ إِنَّهُ","أَعَفُّ وَأَدنى لِلرَشادِ وَأَجمَلُ",55,"ل",1,0],["تُخُيِّرَ نَبْعَ العَيْكَتَيْن ودُونَهُ","مَتَالِفُ هَضْبٍ تَحْبِسُ الطَّيْرَ أَوْعَرَا",56,"ر",2,0],["تَخَيَّلَ فِيهَا ذُو وُسُومٍ كأنَّمَا","يُطَلَّى بِحُصٍّ أَوْ يُصَلى فَيُضْبَحُ",57,"ح",1,0],["تُخَيَّلُ للعينِ فيما ترى","فراشةَ روضٍ جَفَتْها الظلالْ",58,"ل",1,0],["تُخَيِّلُ أبْصارَ الدَّبَا فمُسَهَّدٌ","ومُغْفٍ وشيْءٌ بَيْنَ ذَيْنِكَ ناعس",59,"س",1,0],["تَخَيَّرُ سُودَها وتقول أحْلى","عُيونِ الخَلْقِ أكثرُها سَوادا",60,"د",2,0],["تخيّر السمحة غير دار","ما خلفها من عجب الأقدار",61,"ر",1,0],["تَخَيَّرَ لِلوزارةِ مَن رعَاه","بإِشفاقٍ ونُصحٍ في الأُمورِ",62,"ر",1,0],["تُخَيَّسُ فيها عِتَاقُ الجِمَا","لِ صُحْماً دَوَاجنَ حُمْراً وَجُونا",63,"ن",2,0],["تَخَيَّرتُهُم رُشداً لِأَمري فَإِنَّهُم","عَلى كُلِّ حالٍ خيرَةُ الخيراتِ",64,"ت",1,0],["تَخيَّرْتَ مِنْ وَادي الكنانة زهرةً","تَتِيهُ بِهَا جَنَّاتُهُ وَظَلاَئِلُهْ",65,"ل",2,0],["تَخَيَّرْتَهَا فوْقَ السَّحابِ مَكانةً","وَأَصْفَى مِنَ الماءِ الَّذي هُوَ حَامِلُه",65,"ل",2,0],["تخيّل للعين فيما ترى","فراشة روض جفنها الظّلال",66,"ل",1,0],["تخيَّلَه عقلٌ نشيطٌ أرادَه","دليلاً لقومٍ في الحياة تعثَّروا",67,"ر",3,0],["تخيَّر الكَلِمَ العالي فَسلَّطهُ","على القوافي فحَّلاها وحلاّه",68,"ا",2,0],["تَخيَّلتُ حِرصاً بأن الزمان","عدوُّ اللُبانةِ والمأرَب",69,"ب",1,0],["تُخَيّمُ، يا بنَ آدمَ، في ارتحالٍ،","وترقُدُ في ذَراكَ، وأنتَ ساري",70,"ر",2,1],["تُخِّيرَ من دَوحٍ مِنَ النَّبعِ غُصنَها","فَكَانَت كما يُهوَى ولاَحَت سُعُودُهَا",71,"د",3,0],["تخيلَ أن الناصِريَّةَ دارُهُ","يُ