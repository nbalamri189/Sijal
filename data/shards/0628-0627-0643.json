ارِ",8,"ر",1,0],["باكَرتُ في غَلَسِ الظَلامِ بِصُنتُعٍ","طِرفٍ كَعالِيَةِ القَناةِ سَليمِ",9,"م",1,0],["بِأَكثَرَ مِن نَفِير بني أُرَيش","إِذا جَمَعُوا الهَنَاتش إلى الهَنِينَا",10,"ن",2,0],["باكَرتُ لَذَّتَهُ وَما ماطَلتُها","بِزُجاجَةٍ مِن خَيرِ كَرمٍ أَهدَلِ",11,"ل",1,0],["باكٍ يرى كتم الغرام وإنما","عن شانه أضحى يعير شانه",12,"ن",2,0],["باكر إلى ذاكَ الحما العالي وصفْ","إذا درجت قائلاً ولم تقفْ",13,"ف",1,0],["باكَرنا بالصَّبوح مُدَّلجاً","لنشوةٍ شاءها فبكَّرها",14,"ر",3,0],["باكرْ صباحَ المهرجا","نِ بِقبضِ أرواح الدنانِ",15,"ن",1,1],["باكَرتُها عِندَ الصَباحِ عَلى نُجىً","وَوَضَعتُ غَيرَ جِلالِها أَثقالَها",16,"ل",3,0],["بِأَكنافِ شَمّاتٍ كَأَنَّ رُسومَها","قَضيمُ صَناعٍ في أَديمٍ مُنَمَّقُ",17,"ق",1,0],["باكَرتُهُ بِالمَطايا وَهيَ خامِسَةٌ","قَبلَ رِعالٍ مِنَ الكُدريِّ أَفواجِ",18,"ج",1,0],["باكَرنَهُ وَفُضولُ الريحِ تَنسُجُهُ","مُعانِقاً ساقَ رَيّا ساقُها خَرِعُ",19,"ع",1,0],["بِأَكثَرَ مِنّي غُلَّةً وَصَبابَةً","إِلَيكِ وَلَكِنَّ العَدُوَّ عَداني",20,"ن",2,0],["باكِراً كَالنَحلِ في أَسرابِها","كُلُّ سِربٍ قَد تَلاقى وَاِحتَشَد",21,"د",1,0],["باكِرَةٍ تَستَنهِضُ ال","عَصائِبَ المُبَكِّرَه",22,"ر",2,0],["باكَرْتُها قَبْلَ إِسْفَارِ الضُّحَى بِيَدِي","فما تَبَلّجَ حَتّى نَكّسَتْ رَاسِي",23,"ي",1,0],["باكَرتَ خَلَّتَنا وَرَأسُكَ أَشيَبٌ","وَلَوَيتَ حاجَتَنا وَأَنتَ غُلامُ",24,"م",1,0],["باكَرَتنا بَواكِرُ الوَسمِيِّ","ثُمَّ راحَت وَأَقبَلَت بِالوَلِيِّ",25,"ي",1,1],["باكية للشباب آسفة","عليه دام البكاء والأسف",26,"ف",1,0],["باك إذا عَقَّ زَهْرُ الرَّوْضِ والدَه","من الغَمامِ غدا فيه أباً حَدِبا",27,"ب",2,0],["باكِياتٍ عَلَيكَ يَندُبنَ شَجواً","خافِقاتِ القُلوبِ وَالأَكبادِ",28,"د",1,0],["باكَرتُها بِرِفاقٍ قَد زَهَت بِهِمُ","قَبلَ السُلافِ سُلافُ العِلمِ وَالأَدَبِ",29,"ب",1,0],["باكَرتُها وَعُيونُ الشُهبِ قَد غَمِضَت","خَوفَ الصَباحِ وَعَينُ الشَمسِ قَد فُتِحَت",30,"ت",1,0],["باكياتٍ على الصبا والأماني","والهوى والنوى وبعدِ المزارِ",31,"ر",1,0],["باكي الفؤاد مشرّد الأمل","وقف الزمان وبابه دوني",32,"ي",1,0],["باكرتُها والليلُ فيه حُشاشَةٌ","يستلّها بالرّفقِ منه المغربُ",33,"ب",1,0],["بأكبرَ يستخذي له كلّ أكبرٍ","فيُطرِقُ إطراقَ البُغاثَةِ للصَّقرِ",34,"ر",1,0],["باكِرْ إلى اللّذّاتِ وارْكَبْ لها","سَوابقَ اللّهوِ ذواتِ المِراح",35,"ح",1,0],["بَاكِر صَبوحَك مِن سُلافِ القَهوةِ","وامزج بسمعك صِرْفَها بالنغمةِ",36,"ه",1,1],["بِأَكُفِّ أَبدالٍ إِذا أَمّوا بِها","مَلمومَةً عَمِلوا بِما في المُصحَفِ",37,"ف",1,0],["بَاكَرْتُهُ سُحْرَةً وَالشَّمْسُ نَاعِسَةٌ","فِي خِدْرِهَا وَحَمَامُ الأَيْكِ مُنْتَبِهُ",38,"ه",1,0],["باكَرَتهُ وَالغَيمُ قِطعَةُ عَنبَرٍ","مَشبوبَةٌ وَالبَرقُ لَفحَةُ نارِ",39,"ر",1,0],["باكِياً ساهِياً نَحيلاً ذَليلاً","لَيسَ يَهدا وَلَيسَ يَطعَمُ غَمضا",40,"ض",2,0],["بِأَكثَرَ مِنّي حُرقَةً وَصَبابَةً","إِلى هَضَباتٍ بِاللَوى قَد أَظَلَّتِ",41,"ت",1,0],["باكٍ يَعَضُّ على البنانِ وراقصٌ","بين القِيانِ تهزّه النّشوَاتُ",42,"ت",1,0],["باكَرَ بِالغَداةِ وَالعَشِيِّ","ريقَ النَدى في شَبِمٍ غَدرِيِّ",43,"ي",1,0],["باكَرتُهُ وَالنُجومُ غائِرَةٌ","وَالصُبحُ قَد حانَ مِنهُ إِسفارُ",44,"ر",1,0],["باكِيَةٌ يَضحَكُ فيها بَرقُها","مَوصولَةٌ بِالأَرضِ مُرماةُ الطُنُب",45,"ب",1,0],["بأكثبة الدهناء منهم منازل","وأندية يغدو عليها المقاول",46,"ل",1,1],["بِأَكلُبٍ تَمرَحُ في قِداتِها","تَعُدُّ عينَ الوَحشِ مِن أَقواتِها",47,"ت",3,0],["باكِرِ اليَومَ الصَبوحا","وَاِعصِ في الخَمرِ النَصوحا",48,"ح",2,1],["باكِر صَبوحَكَ فَهوَ خَيرُ عَتادِ","وَاِخلَع قِيادَكَ قَد خَلَعتُ قِيادي",49,"د",2,1],["باكَرتُها مِن كَفِّ أَغيَدَ شادِنٍ","حَسَنِ التَنَغُّمِ فَوقَ سُؤلِ العاشِقِ",50,"ق",1,0],["باكرتُها من كفّ أغيدَ شادنٍ","حسنِ التنعّم فوق سُؤلِ العاشق",51,"ق",1,0],["باكَرنَ عِطرَ لَطيمَةٍ","وَغَمَسنَ في الجادِيِّ غَمسا",52,"س",2,0],["باكَرتُهُ أَعشو إِلى نارِهِ","شَوقاً وَما ضاقَت بِيَ الدُورُ",53,"ر",1,0],["باكَرتُها قَبلَ ما بَدا الصَباحُ لَنا","في بَيتِ مُنهَمِرِ الكَفَّينِ مِفضالِ",54,"ل",1,0],["بِأَكلُبٍ كَقِداحِ النَبعِ يُوسِدُها","طِملُ أَخُو قَفرَةٍ غَرثانُ قَد نَحَلا",55,"ل",2,0],["باكرِ الروضَ في رياضِ السُّرورِ","بينَ نظمِ الربيعِ والمنثورِ",56,"ر",1,1],["بأكثر هذا النّاس ينخدع","إن قاتلوا جبنوا أو حدّثوا شجعوا",57,"ع",3,1],["باكيَ الأحلامِ محزونَ المنى","ضاحكَ الآلام بسّامَ الجراحْ",58,"ح",1,0],["بِأَكثَرَ مِنّي حَسرَةً وَصَبابَةً","إِلَيها وَلَكِنَّ الفِراقَ عَراني",59,"ن",2,0],["باكَرتَهُنَّ قَرقَفٌ كَدَمِ الَجو","فِ تُرِيكَ القَذَى كُمَيتٌ رَحِيقُ",60,"ق",1,0],["بَاكِياً شَجْوَهُ تَرِنُّ قَوَافِي","هِ رَنِينَ النِّبَالِ فِي الأكْبَادِ",61,"د",1,0],["باكرتُها، والزهرُ يَشْرَقُ بالندى،","في فتيةٍ شُمِّ الأنوفِ صِباحِ",62,"ح",1,0],["باك أتى والدموع في يده","وبل من النار واكفٌ مطرهْ",63,"ر",2,0],["باكون ما حُرِّكَتْ في النفس عاطفةٌ","وضاحكون ولاشيءٌ من الطرب",64,"ب",1,0],["باكرتهُ وَالظلُ يَنثُر دَمعُهُ","مُتناسِقاً كَاللؤلؤ المَرصوف",65,"ف",1,0],["بأكابر الاقطاب اصبح ملحقا","وله مقام الحال في الحضرات",66,"ت",1,0],["باكرتها والوردُ يوقظُهُ النَّدى","وَتَبلُّ خَدّيه عيون النّرجسِ",67,"س",1,0],["بأكثر مني لكنةً وفهاهة","وأعجز عن تصريحه بمرامهِ",68,"ه",1,0],["بأكرم مولود لأكرم والد","وأنجب فرع شف منه أرومه",69,"م",2,0],["بأكذب من هذا وأكفر في الورى","وأجرى على غشيان هذي الفواطر",70,"ر",1,0],["باكي سحابِ الجودِ يضحك بشرُهُ","عن غرَّةٍ قَمَريّةِ التصويرِ",71,"ر",1,0],["باكَرنا وابلٌ سكوبُ","أدمعُه فوقَنا صَبيبُ",72,"ب",1,1],["بِأَكُفِّها بِيضٌ بِها ضَرَبَ العِدا","آباؤُها الماضونَ عَن أُمّاتِها",73,"ت",3,0],["باكَرَتا الصَيدَ بِحَدٍّ وَأَضَم","لَن يَرجِعا أَو يَخضِبا صَيداً بِدَم",74,"م",1,0],["بإِكسيرِ خيرِ الخلقِ صحّت طباعه","فصارَت نُضاراً بعد أن طُبعت صفرا",75,"ر",2,0],["باكرت روضة خدها متنزها","وظفرت من ورد لها بنصيب",76,"ب",1,0],["باكر إلى زهر الرياض واسقني","كاس الطلا فالراح راح الأنفس",77,"س",1,1],["باكر إلى الروض في عرس الرياض ضحى","فالورق غنت على العيدان في الورق",78,"ق",1,1],["باكورَة الحُبِّ أَبقى في مَراشِفِها","ثَديُ السَماءِ رَضاعَ الفاطِرِ الباري",79,"ر",2,0],["باكرتُ فيها الخَنْدَريسَ بِفتْيةٍ","مِن هاشمٍ شُمِّ الأُنوفِ كِرامِ",80,"م",1,0],["باكَرْتُها بِنَدَامَى كلّهمْ فَهِمٌ","تراضَعوا دِرَّةَ الآدابِ والطُّرف",81,"ف",1,0],["بأكْلُبٍ مخرنطِمات ضُمَّر","مهروتة أشداقُها للحنجرِ",82,"ر",1,0],["باكَرتُه والليلُ أدْعَجُ ما","في رأسه شَمطٌ ولا جَلَح",83,"ح",1,0],["باكِرْ أبا بَكْرٍ المُفَد