{"poems":[[398,"أتاني البدر باكيا خجلا","https://www.aldiwan.net/poem53536.html","المنسرح"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59565","المديد"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46516","الرجز"],[402,"","https://poetry.dctabudhabi.ae/diwan/poem/82785","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111407","الخفيف"],[308,"اخْتَلَفْنَا لبديع النّظم فِي","https://www.poetsgate.com/ViewPoem.aspx?id=189399",""],[5848,"بدون","https://www.poetsgate.com/ViewPoem.aspx?id=53182",""]],"verses":[["قالَ غَزالٌ أَتى لِيَعزلني","بِحُسنِهِ فَالفُؤادُ منفَطِرُ",0,"ر",1,0],["قال غيث السحب يا","جودَه ما أسمحا",1,"ح",2,0],["قال غَداً ألقاه ثُم نادى","جاراً لَهُ يَسأله الإِسعادا",2,"د",2,0],["قالَ غضباناً وَفي لَهجَتِهِ","ضَجَّة البَحر أَنا المَوتُ المُريع",3,"ع",1,0],["قال غالَيتِ في مُراقَبَتي وَي","كِ وأَكثَرتش ثِقلَةَ التَّمويهِ",4,"ي",2,0],["قَالَ غَيْرِي هُوَ زهر قَالَ لَا","قلت زهر قَالَ لي هَذَا الصَّحِيح",5,"ح",1,0],["قال غلطان قلت ادري ولكن سؤال :","وش تسوي ليا ضاقت عليك الدروب",6,"ب",1,0]]}