poetsgate.com/ViewPoem.aspx?id=124901",""],[5539,"اذكرو","https://www.poetsgate.com/ViewPoem.aspx?id=198945",""],[5539,"اذكروا شعري","https://www.poetsgate.com/ViewPoem.aspx?id=198946",""],[5542,"شموخ اليتيم","https://www.poetsgate.com/ViewPoem.aspx?id=10072",""],[5545,"أسرج خيول الراحلين","https://www.poetsgate.com/ViewPoem.aspx?id=185707",""],[5582,"سَلْ بُرْقَةَ العَلَمَيْنِ ثُمَّ البانا","https://www.poetsgate.com/ViewPoem.aspx?id=187309",""],[5628,"حديث مع البحر","https://www.poetsgate.com/ViewPoem.aspx?id=178548",""],[5725,"خمرية طيبة","https://www.poetsgate.com/ViewPoem.aspx?id=177436",""],[5725,"ميّاسة الرمح","https://www.poetsgate.com/ViewPoem.aspx?id=177621",""],[5809,"عبرة","https://www.poetsgate.com/ViewPoem.aspx?id=205236",""],[5829,"الصوم عن المفاسد","https://www.poetsgate.com/ViewPoem.aspx?id=212595",""],[5830,"يا ظبية تختال ما بين الربى","https://www.poetsgate.com/ViewPoem.aspx?id=200690",""],[5830,"هَلْ كَنْتُ جُرْماً","https://www.poetsgate.com/ViewPoem.aspx?id=200766",""],[5853,"دموعٌ وتوجع","https://www.poetsgate.com/ViewPoem.aspx?id=175615",""],[5853,"فلسفة دموع العيون","https://www.poetsgate.com/ViewPoem.aspx?id=175669",""],[5874,"قابيل","https://www.poetsgate.com/ViewPoem.aspx?id=201863",""],[5943,"هذا أنا بالآه أطلقُ صرختي","https://www.poetsgate.com/ViewPoem.aspx?id=34676",""],[5956,"بعد الشّيب ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182016",""],[5956,"أوقات الإلهام","https://www.poetsgate.com/ViewPoem.aspx?id=186120",""],[5956,"الطائرة المنكوبة","https://www.poetsgate.com/ViewPoem.aspx?id=193917",""],[5956,"اسمكم عمر يذكرني بقول عمر","https://www.poetsgate.com/ViewPoem.aspx?id=194192",""],[5956,"يسري النسيمُ العذب في الصحراءِ","https://www.poetsgate.com/ViewPoem.aspx?id=205124",""],[5956,"أرتين قد بدأ المسير مهللا","https://www.poetsgate.com/ViewPoem.aspx?id=205422",""],[5977,"حرر قيودك","https://www.poetsgate.com/ViewPoem.aspx?id=212738",""],[6031,"وَرَدَ الكتابُ من الجَنَابِ السَّامِي","https://www.poetsgate.com/ViewPoem.aspx?id=46376",""],[6102,"لُمْ نَفسَك!!","https://www.poetsgate.com/ViewPoem.aspx?id=186291",""],[6202,"الشعر والسيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86705&r=&rc=6",""]],"verses":[["فَلَرُبَّ مُبتَسِمٍ وَقَد","أَخَذَت مَآخِذَها الجُروحُ",0,"ح",1,0],["فَلَرُبَّ عَيشٍ فيكَ رَقَّ نَسيمُهُ","كَالماءِ رَقَّ عَلى جُنوبِ بِطاحِ",1,"ح",1,0],["فَلَرُبَّ أَملَحَ مِنكِ دَلّاً فَاِعلَمي","وَأَقَرَّ في الدُنيا لِعَينِ المُجتَلي",2,"ل",2,0],["فَلَرُبَّ أَبلَجَ مِثلِ بَعلِكِ بادِنٍ","ضَخمٍ عَلى ظَهرِ الجَوادِ مُهَيَّلِ",2,"ل",1,0],["فلرب بكر للفتوح خطبتها","بالمشرفية والقنا الخطّارِ",3,"ر",1,0],["فَلَرُبَّ جَبّارٍ قَصَرنا عَنوَةً","مَلِكٌ يَجُرُّ سَلاسِلاً وَقُيودا",4,"د",2,0],["فلربَّ ليلٍ شقّ طيفك جنحه","والصبح لم ينشقّ عنه رداؤه",5,"ا",3,0],["فَلِرَاهِب ألَّا يَرِيثَ أمانُهُ","ولراغب ألّا يريث نجاحُه",6,"ح",2,0],["فلربَّ تشميرٍ إليك رأيتُهُ","بالأمسِ أعقبَ أهلهُ تذييلا",7,"ل",2,0],["فَلَرُبَّما كانتْ أَنيناً صاعداً","في اللَّيلِ مِنْ متوجِّعٍ مَقْهُورِ",8,"ر",1,0],["فَلَرُبَّ عارِضَةٍ عَلَينا وَصلَها","بِالجِدِّ تَخلِطُهُ بِقَولِ الهازِلِ",9,"ل",1,0],["فَلَرُبَّ قَولٍ في الرِجالِ سَمِعتُمُ","ثُمَّ اِنقَضى فَكَأَنَّهُ ما قيلا",10,"ل",2,0],["فلربما أثنَى عليكَ بفعلهِ","من لستَ تعرفُ حين لا تدري",11,"ر",2,0],["فَلَرُبَّما لَبَّيتُ داعِيَةَ الصِبا","وَعَصَيتُ مِن عَذَلٍ وَمِن تَأنيبِ",12,"ب",1,0],["فَلَرُبَّ مَنزِلَةٍ هُناكَ مُحيلَةٍ","وَمَحَلَّةٍ قَفرٍ وَرَسمٍ داثِرِ",13,"ر",1,0],["فَلَرُبَّ يَومٍ قَد غَنينا نَجتَلي","مَغناكِ بِالرَشَإِ الأَنيقِ أَنيقا",14,"ق",2,0],["فَلَرُبَّما أَروَت دُموعاً مِن دَمٍ","فيها وَأَظمَت لائِماً وَمَلوما",15,"م",2,0],["فَلَرُبَّ عَيشٍ بِاللِوى لَم تُستَرَد","حُسناً لَياليهِ وَلا أَيّامُهُ",16,"م",2,0],["فَلَرُبَّما اِستَتَرَ الفَتى فَتنافَسَت","فيهِ العُيونُ وَإِنَّهُ لَمُمَوَّهُ",17,"و",2,0],["فَلَرُبَّ شَهوَةِ ساعَةٍ","قَدأَورَثَت حُزناً طَويلا",18,"ل",2,0],["فَلَرُبَّما عَثَرَ الجَوا","دُ وَرُبَّما حارَ الدَليلُ",19,"ل",1,0],["فَلَرُبَّما صَبَرَ الحَليمُ عَلى الأَذى","حَتّى يَرى وَكَأَنَّه يَتَدَلَّهُ",20,"ه",1,0],["فَلَرُبَّما اِعتَبَطَ السَليمُ فُجاءَةً","وَلَرُبَّما رُزِقَ السَقيمُ العافِيَه",21,"ي",2,0],["فلربما استخبرت عن","ه عَدُوَّهُ فسمعتَ ذَمّه",22,"ه",1,0],["فَلَرُبَّ سارِيَةٍ عَلَيكَ مَطيرَةٍ","قَد جادَ عارِضُها وَما يَتَهَلَّلُ",23,"ل",1,0],["فَلَرُبَّ نارٍ مِنكُمُ قَد أُنتِجَت","في اللَيلِ مِن قَبَسٍ مِنَ الأَقباسِ",24,"س",1,0],["فَلَرُبَّمَا رَجَحَ الْخَسِيسُ مِنَ الْحَصَى","بِالدُّرِّ عِنْدَ تَمَاثُلِ الْمِيزَانِ",25,"ن",1,0],["فلريَّاهُ في المعاطين عرفٌ","ولرؤياهُ بهجةٌ في العيونِ",26,"ن",1,0],["فَلَرُبَّ رَكبٍ لِلرَدى تَحتَ السُرى","ضَرَبوا قِبابَهُم بِها لِثَواءِ",27,"ا",2,0],["فَلَرُبَّما طَرَقَت جَنابي فِتيَةٌ","كَرُموا جِواراً في العُلا وَنِجارا",28,"ر",2,0],["فَلَرُبَّ سَمراءِ الأَديمِ طَويلَةٍ","حَسَدَت بِراحَتِهِ القَصيرَ الأَصفَرا",29,"ر",2,0],["فَلَرُبَّ يَومٍ قَد رَفَعتَ بِهِ المُنى","وَمَحَوتَ فيهِ سَوادَ ظَنِّ البائِسِ",30,"س",1,0],["فَلَرُبَّما نُثِرَ الجُمانُ تَعَمُّداً","لِيَكونَ أَحسَنَ في النِظامِ وَأَجمَلا",31,"ل",2,0],["فلربما انقطع الحما","ئم في الدُّجى عن شدوهنّه",32,"ن",2,0],["فَلَرُبَّ حادِثَةٍ نَهَضتَ بِها","مُتَقَدِّماً فَتَأَخَّرَ الدَهرُ",33,"ر",1,0],["فَلرُبَّمَا أَلْقَى عليكَ كِتابُهُ","قَولاً مِنَ السِّرِّ المَصُونِ ثَقِيلا",34,"ل",2,0],["فَلَرُبَّمَا هَزَمَ الْكَتِيبَةَ وَاحِدٌ","وَلَرُبَّمَا جَلَبَ الدَّنيئَةَ مَعْشَرُ",35,"ر",1,0],["فَلَرُبَّ صَعْبٍ حَادَ سَهْلاً بَعْدَمَا","قُطِعَتْ عَلَيهِ مَرَائِرُ الأَنْفَاسِ",36,"س",1,0],["فَلَرُبَّمَا انْقَلَبَ الصَّدِيقُ مُعَادِياً","وَلَرُبَّمَا رَجَعَ الْعَدُوُّ صَدِيقَا",37,"ق",2,0],["فلرُبّ رَوْضٍ للنّواظِر مُعْجِبٍ","كمَنتْ سُمومُ الصِّلِّ في زَهَراتِه",38,"ت",2,0],["فلرب أمر ما كر","هت وفي طواياه نجاح",39,"ح",1,0],["فلربما اتسع المضيق","وربما ضاق الفضا",40,"ض",2,0],["فلَرُبَّما نفَتِ الشَّكاةَ وقرَّبَتْ","يومَ الخلاصِ سياسةُ الإصرار",41,"ر",1,0],["فَلَرُبَّ عَيْشٍ بالِّلوَى لم تُسْتَزَدْ","حُسْناً لَيَالِيهِ ولا أَيّامُهُ",42,"م",2,0],["فَلَرُبّ منزلة، هُنَاكَ، مُحيلَةٍ،","وَمَحَلّةٍ قَفْرٍ، وَرَسْمٍ دائِرِ",43,"ر",1,0],["فلربما تجد العروبة نفسها","ويضيء في قلب الظلام شهاب",44,"ب",1,0],["فلَرُبَّما وهُوَ المُرَوِّعُ سحنةً","لو كانَ مِثْلي شاعراً لَرَثاني",45,"ن",2,0],["فَلَرُبَّ صَعْبٍ عَادَ سَهْلاً بَعْدَمَا","قُطِعَتْ عَلَيْهِ مَرَائِرُ الأَنْفَاسِ",46,"س",1,0],["فلرب آن فيه ينقلب الجفا","قربا يسر وتحضر الغياب",47,"ب",1,0],["فلرب شاك يأتني متذمراً","ليقول لي بصراحة المغبون",48,"ن",1,0],["فلربما حَسدوك أو حسدوكهُ","فتقوَّلوا كذباً عليه وحرّدُوا",49,"د",3,0],["فلربما اشتد الخيال وعاقه","دون الصواب هوى وأصبح غالبا",50,"ب",2,0],["فلرُبَّ ليْلٍ ضَلَّ عنهُ صَباحُهُ","فَكأَنَّهُ بكِ خطرةُ المتفكِّرِ",51,"ر",1,0],["فَلَرُبَّما وَدّى السَفا","نَحوَ السَفا أَهلَ السَفاءِ",52,"ا",2,0],["فَلَرُبَّما وَدّى الفَضا","مُتَزَوِّديهِ إِلى الفَضاءِ",52,"ا",2,0],["فَلَرُبَّما فَضَحَ الرِجا","لَ ذَوي اللِحى كَشفُ اللِحاءِ",52,"ا",2,0],["فلربّما عاديت بعد مودّة","ولربّما صافيت بعد تقالي",53,"ي",1,0],["فلرب ذنب قد أبرّ","على انتخابك واختصارك",54,"ك",1,0],["فلرُب حين كان آخر عه","د مشيك في ديارك",55,"ك",1,0],["فلرب ماسور بحب","لك صار يملك من إسارك",55,"ك",1,0],["فلرما عرض الصدا","ع فكان خيرا من رمد",56,"د",1,0],["فَلَرُبَّ قائِلَةٍ كَفاها وَقعُنا","أَزمَ الحُروبِ فِسِربُها لا يُفزَعُ",57,"ع",1,0],["فلريحه أذكى وأطيب مخبرا","من ريح مسك فضه عطاره",58,"ر",2,0],["فلرب ليل بت أشرب صرفها","مع شادن المي المباسم أبلجا",59,"ج",2,0],["فلربما قُبِلت شفاعةُ عاشقٍ","يوماً وحسنُكِ عندَهُ لم يَشفَع",60,"ع",1,0],["فلرُبّ ينبوعٍ تركتُ زلالهُ","طرَباً لصفرةِ بلبلٍ متغرَّد",61,"د",1,0],["فلربما نظروا إليّ فشاقَهم","نوري وصار أحبّةً أعدائي",62,"ا",2,0],["فلربي النعمى ولي","فخر بحمد الله جل",63,"ل",1,0],["فَلَرُبَّما كانَت سَعايَةَ ظالِمٍ","وَاللَهُ يَعلَمُ أَنَّهُ مَظلومُ",64,"م",1,0],["فَلَرُبَّما بَعدَ التَباعُدِ وَالجَفا","عادَ الوِصالُ وَلِلهَوى أَخلاقُ",65,"ق",1,0],["فلرُبّما لاقاك طيف مسهدٌ","حرم الهوى أوحاله من حالي",66,"ي",1,0],["فلَرُبَّ فتيانٍ صَبَحتُهمُ","من عاتِقٍ صَهباء في الخِرسِ",67,"س",1,0],["فَلربَّما غفل النَبيه وَربَّما","نبه الغفول فَكانَ أَبلَغ مَأمَلا",68,"ل",2,0],["فَلرُبَّ عَتبٍ لا يفيدُ سِوى العَنا","أَو أَن تُهان بِهِ النُفوس فَتبخَسا",69,"س",2,0],["فَلَرُبَّما يَسقي غَليلَكَ ماؤ