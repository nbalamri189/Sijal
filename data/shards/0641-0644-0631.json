s://www.aldiwan.net/poem30485.html","الكامل"],[87,"أخذ الكرى بمعاقد الأجفان","https://www.aldiwan.net/poem8239.html","الكامل"],[69,"صاح إن كنت في الغرام معيني","https://www.aldiwan.net/poem28372.html","الخفيف"],[74,"في مثله من طارق الأرزاء","https://www.aldiwan.net/poem12836.html","الكامل"],[74,"ماذا عليك وقد نأيت ديارا","https://www.aldiwan.net/poem12958.html","الكامل"],[74,"جفن تجافى للخلي عن الكرى","https://www.aldiwan.net/poem12960.html","الكامل"],[74,"جرر ملاءة كل يوم شامس","https://www.aldiwan.net/poem12971.html","الكامل"],[74,"وعسى الليالي أن تمن بجمعنا","https://www.aldiwan.net/poem13219.html","الكامل"],[102,"بيض الحمائم حسبهنه","https://www.aldiwan.net/poem33133.html","مجزوء الكامل"],[52,"ذهب الشباب وكدر العمر","https://www.aldiwan.net/poem27013.html","الكامل"],[67,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42608","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42654","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42718","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54224","البسيط"],[66,"كن عن همومك معرضاً","https://www.poetsgate.com/ViewPoem.aspx?id=178182",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[45,"عَهْدِي بِرَبْعِكَ مُثَّلاً آرَامُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=32042",""],[45,"لا زَالَ مُحْتَفِلُ الغَمَامِ الباكِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=31295",""],[99,"أنا يا صديقتي متعب بعروبتي","https://www.poetsgate.com/ViewPoem.aspx?id=24608",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""],[87,"هَل فى الخلاعة ِ والصِبا من باسِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23987&r=&rc=249",""]],"verses":[["فَلَرُبَّ مُبتَسِمٍ وَقَد","أَخَذَت مَآخِذَها الجُروحُ",0,"ح",1,0],["فَلَرُبَّ عَيشٍ فيكَ رَقَّ نَسيمُهُ","كَالماءِ رَقَّ عَلى جُنوبِ بِطاحِ",1,"ح",1,0],["فَلَرُبَّ أَملَحَ مِنكِ دَلّاً فَاِعلَمي","وَأَقَرَّ في الدُنيا لِعَينِ المُجتَلي",2,"ل",2,0],["فَلَرُبَّ أَبلَجَ مِثلِ بَعلِكِ بادِنٍ","ضَخمٍ عَلى ظَهرِ الجَوادِ مُهَيَّلِ",2,"ل",1,0],["فلرب بكر للفتوح خطبتها","بالمشرفية والقنا الخطّارِ",3,"ر",1,0],["فَلَرُبَّ جَبّارٍ قَصَرنا عَنوَةً","مَلِكٌ يَجُرُّ سَلاسِلاً وَقُيودا",4,"د",2,0],["فلربَّ ليلٍ شقّ طيفك جنحه","والصبح لم ينشقّ عنه رداؤه",5,"ا",3,0],["فَلِرَاهِب ألَّا يَرِيثَ أمانُهُ","ولراغب ألّا يريث نجاحُه",6,"ح",2,0],["فلربَّ تشميرٍ إليك رأيتُهُ","بالأمسِ أعقبَ أهلهُ تذييلا",7,"ل",2,0],["فَلَرُبَّما كانتْ أَنيناً صاعداً","في اللَّيلِ مِنْ متوجِّعٍ مَقْهُورِ",8,"ر",1,0],["فَلَرُبَّ عارِضَةٍ عَلَينا وَصلَها","بِالجِدِّ تَخلِطُهُ بِقَولِ الهازِلِ",9,"ل",1,0],["فَلَرُبَّ قَولٍ في الرِجالِ سَمِعتُمُ","ثُمَّ اِنقَضى فَكَأَنَّهُ ما قيلا",10,"ل",2,0],["فلربما أثنَى عليكَ بفعلهِ","من لستَ تعرفُ حين لا تدري",11,"ي",1,0],["فَلَرُبَّما لَبَّيتُ داعِيَةَ الصِبا","وَعَصَيتُ مِن عَذَلٍ وَمِن تَأنيبِ",12,"ب",1,0],["فَلَرُبَّ مَنزِلَةٍ هُناكَ مُحيلَةٍ","وَمَحَلَّةٍ قَفرٍ وَرَسمٍ داثِرِ",13,"ر",1,0],["فَلَرُبَّ يَومٍ قَد غَنينا نَجتَلي","مَغناكِ بِالرَشَإِ الأَنيقِ أَنيقا",14,"ق",2,0],["فَلَرُبَّما أَروَت دُموعاً مِن دَمٍ","فيها وَأَظمَت لائِماً وَمَلوما",15,"م",2,0],["فَلَرُبَّ عَيشٍ بِاللِوى لَم تُستَرَد","حُسناً لَياليهِ وَلا أَيّامُهُ",16,"م",2,0],["فَلَرُبَّما اِستَتَرَ الفَتى فَتنافَسَت","فيهِ العُيونُ وَإِنَّهُ لَمُمَوَّهُ",17,"و",2,0],["فَلَرُبَّ شَهوَةِ ساعَةٍ","قَدأَورَثَت حُزناً طَويلا",18,"ل",2,0],["فَلَرُبَّما عَثَرَ الجَوا","دُ وَرُبَّما حارَ الدَليلُ",19,"ل",1,0],["فَلَرُبَّما صَبَرَ الحَليمُ عَلى الأَذى","حَتّى يَرى وَكَأَنَّه يَتَدَلَّهُ",20,"ه",1,0],["فَلَرُبَّما اِعتَبَطَ السَليمُ فُجاءَةً","وَلَرُبَّما رُزِقَ السَقيمُ العافِيَه",21,"ي",2,0],["فلربما استخبرت عن","ه عَدُوَّهُ فسمعتَ ذَمّه",22,"ه",1,0],["فَلَرُبَّ سارِيَةٍ عَلَيكَ مَطيرَةٍ","قَد جادَ عارِضُها وَما يَتَهَلَّلُ",23,"ل",1,0],["فَلَرُبَّ نارٍ مِنكُمُ قَد أُنتِجَت","في اللَيلِ مِن قَبَسٍ مِنَ الأَقباسِ",24,"س",1,0],["فَلَرُبَّمَا رَجَحَ الْخَسِيسُ مِنَ الْحَصَى","بِالدُّرِّ عِنْدَ تَمَاثُلِ الْمِيزَانِ",25,"ن",1,0],["فلريَّاهُ في المعاطين عرفٌ","ولرؤياهُ بهجةٌ في العيونِ",26,"ن",1,0],["فَلَرُبَّ رَكبٍ لِلرَدى تَحتَ السُرى","ضَرَبوا قِبابَهُم بِها لِثَواءِ",27,"ا",2,0],["فَلَرُبَّما طَرَقَت جَنابي فِتيَةٌ","كَرُموا جِواراً في العُلا وَنِجارا",28,"ر",2,0],["فَلَرُبَّ سَمراءِ الأَديمِ طَويلَةٍ","حَسَدَت بِراحَتِهِ القَصيرَ الأَصفَرا",29,"ر",2,0],["فَلَرُبَّ يَومٍ قَد رَفَعتَ بِهِ المُنى","وَمَحَوتَ فيهِ سَوادَ ظَنِّ البائِسِ",30,"س",1,0],["فَلَرُبَّما نُثِرَ الجُمانُ تَعَمُّداً","لِيَكونَ أَحسَنَ في النِظامِ وَأَجمَلا",31,"ل",2,0],["فلربما انقطع الحما","ئم في الدُّجى عن شدوهنّه",32,"ن",2,0],["فَلَرُبَّ حادِثَةٍ نَهَضتَ بِها","مُتَقَدِّماً فَتَأَخَّرَ الدَهرُ",33,"ر",1,0],["فَلرُبَّمَا أَلْقَى عليكَ كِتابُهُ","قَولاً مِنَ السِّرِّ المَصُونِ ثَقِيلا",34,"ل",2,0],["فَلَرُبَّمَا هَزَمَ الْكَتِيبَةَ وَاحِدٌ","وَلَرُبَّمَا جَلَبَ الدَّنيئَةَ مَعْشَرُ",35,"ر",1,0],["فَلَرُبَّ صَعْبٍ حَادَ سَهْلاً بَعْدَمَا","قُطِعَتْ عَلَيهِ مَرَائِرُ الأَنْفَاسِ",36,"س",1,0],["فَلَرُبَّمَا انْقَلَبَ الصَّدِيقُ مُعَادِياً","وَلَرُبَّمَا رَجَعَ الْعَدُوُّ صَدِيقَا",37,"ق",2,0],["فلرُبّ رَوْضٍ للنّواظِر مُعْجِبٍ","كمَنتْ سُمومُ الصِّلِّ في زَهَراتِه",38,"ت",2,0],["فلربما اتسع المضيق","وربما ضاق الفضا",39,"ض",2,0],["فلَرُبَّما نفَتِ الشَّكاةَ وقرَّبَتْ","يومَ الخلاصِ سياسةُ الإصرار",40,"ر",1,0],["فَلَرُبَّ عَيْشٍ بالِّلوَى لم تُسْتَزَدْ","حُسْناً لَيَالِيهِ ولا أَيّامُهُ",41,"م",2,0],["فَلَرُبّ منزلة، هُنَاكَ، مُحيلَةٍ،","وَمَحَلّةٍ قَفْرٍ، وَرَسْمٍ دائِرِ",42,"ر",1,0],["فلربما تجد العروبة نفسها","ويضيء في قلب الظلام شهاب",43,"ب",1,0],["فلَرُبَّما وهُوَ المُرَوِّعُ سحنةً","لو كانَ مِثْلي شاعراً لَرَثاني",44,"ن",2,0],["فَلَرُبَّ صَعْبٍ عَادَ سَهْلاً بَعْدَمَا","قُطِعَتْ عَلَيْهِ مَرَائِرُ الأَنْفَاسِ",45,"س",1,0]]}