كامل"],[432,"سافر إذا حاولت قدرا","https://www.aldiwan.net/poem12635.html","مجزوء الكامل"],[439,"النصر حزبك في الضلالة فاحتكم","https://www.aldiwan.net/poem34807.html","الكامل"],[441,"إن المنية في الورى أسباب","https://www.aldiwan.net/poem14436.html","الكامل"],[452,"إني لمشتاق لربوة جلق","https://www.aldiwan.net/poem13808.html","الكامل"],[452,"أحبابنا عودوا علينا عودة","https://www.aldiwan.net/poem13932.html","الكامل"],[453,"غضي عيونك يا نجوم فإنني","https://www.aldiwan.net/poem61323.html","الكامل"],[458,"سل عن فؤادك بين منعقِد اللوى","https://www.aldiwan.net/poem55837.html","الكامل"],[458,"دع بين جِلدي والعظام مكانا","https://www.aldiwan.net/poem55851.html","الكامل"],[458,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[464,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[464,"أما الديار فتلك عين ظبائها","https://www.aldiwan.net/poem3213.html","عموديه"],[464,"حي الديار برامتين ونادها","https://www.aldiwan.net/poem3435.html","عموديه"],[529,"يا جاهلا في نصر سنة أحمد","https://www.aldiwan.net/poem37462.html","الكامل"],[540,"أحمامة حلبت شؤونك أسجما","https://www.aldiwan.net/poem56754.html","البسيط"],[551,"عل الهوى يهفو به العذل","https://www.aldiwan.net/poem47341.html","أحذ الكامل"],[551,"لا توعدني الشر ترهبني","https://www.aldiwan.net/poem47817.html","أحذ الكامل"],[551,"لم يبق لي بعد المشيب تصابي","https://www.aldiwan.net/poem48055.html","الكامل"]],"verses":[["فَلَرُبَّ مُبتَسِمٍ وَقَد","أَخَذَت مَآخِذَها الجُروحُ",0,"ح",1,0],["فَلَرُبَّ عَيشٍ فيكَ رَقَّ نَسيمُهُ","كَالماءِ رَقَّ عَلى جُنوبِ بِطاحِ",1,"ح",1,0],["فَلَرُبَّ أَملَحَ مِنكِ دَلّاً فَاِعلَمي","وَأَقَرَّ في الدُنيا لِعَينِ المُجتَلي",2,"ل",2,0],["فَلَرُبَّ أَبلَجَ مِثلِ بَعلِكِ بادِنٍ","ضَخمٍ عَلى ظَهرِ الجَوادِ مُهَيَّلِ",2,"ل",1,0],["فلرب بكر للفتوح خطبتها","بالمشرفية والقنا الخطّارِ",3,"ر",1,0],["فَلَرُبَّ جَبّارٍ قَصَرنا عَنوَةً","مَلِكٌ يَجُرُّ سَلاسِلاً وَقُيودا",4,"د",2,0],["فلربَّ ليلٍ شقّ طيفك جنحه","والصبح لم ينشقّ عنه رداؤه",5,"ا",3,0],["فَلِرَاهِب ألَّا يَرِيثَ أمانُهُ","ولراغب ألّا يريث نجاحُه",6,"ح",2,0],["فلربَّ تشميرٍ إليك رأيتُهُ","بالأمسِ أعقبَ أهلهُ تذييلا",7,"ل",2,0],["فَلَرُبَّما كانتْ أَنيناً صاعداً","في اللَّيلِ مِنْ متوجِّعٍ مَقْهُورِ",8,"ر",1,0],["فَلَرُبَّ عارِضَةٍ عَلَينا وَصلَها","بِالجِدِّ تَخلِطُهُ بِقَولِ الهازِلِ",9,"ل",1,0],["فَلَرُبَّ قَولٍ في الرِجالِ سَمِعتُمُ","ثُمَّ اِنقَضى فَكَأَنَّهُ ما قيلا",10,"ل",2,0],["فلربما أثنَى عليكَ بفعلهِ","من لستَ تعرفُ حين لا تدري",11,"ي",1,0],["فَلَرُبَّما لَبَّيتُ داعِيَةَ الصِبا","وَعَصَيتُ مِن عَذَلٍ وَمِن تَأنيبِ",12,"ب",1,0],["فَلَرُبَّ مَنزِلَةٍ هُناكَ مُحيلَةٍ","وَمَحَلَّةٍ قَفرٍ وَرَسمٍ داثِرِ",13,"ر",1,0],["فَلَرُبَّ يَومٍ قَد غَنينا نَجتَلي","مَغناكِ بِالرَشَإِ الأَنيقِ أَنيقا",14,"ق",2,0],["فَلَرُبَّما أَروَت دُموعاً مِن دَمٍ","فيها وَأَظمَت لائِماً وَمَلوما",15,"م",2,0],["فَلَرُبَّ عَيشٍ بِاللِوى لَم تُستَرَد","حُسناً لَياليهِ وَلا أَيّامُهُ",16,"م",2,0],["فَلَرُبَّما اِستَتَرَ الفَتى فَتنافَسَت","فيهِ العُيونُ وَإِنَّهُ لَمُمَوَّهُ",17,"و",2,0],["فَلَرُبَّ شَهوَةِ ساعَةٍ","قَدأَورَثَت حُزناً طَويلا",18,"ل",2,0],["فَلَرُبَّما عَثَرَ الجَوا","دُ وَرُبَّما حارَ الدَليلُ",19,"ل",1,0],["فَلَرُبَّما صَبَرَ الحَليمُ عَلى الأَذى","حَتّى يَرى وَكَأَنَّه يَتَدَلَّهُ",20,"ه",1,0],["فَلَرُبَّما اِعتَبَطَ السَليمُ فُجاءَةً","وَلَرُبَّما رُزِقَ السَقيمُ العافِيَه",21,"ي",2,0],["فلربما استخبرت عن","ه عَدُوَّهُ فسمعتَ ذَمّه",22,"ه",1,0],["فَلَرُبَّ سارِيَةٍ عَلَيكَ مَطيرَةٍ","قَد جادَ عارِضُها وَما يَتَهَلَّلُ",23,"ل",1,0],["فَلَرُبَّ نارٍ مِنكُمُ قَد أُنتِجَت","في اللَيلِ مِن قَبَسٍ مِنَ الأَقباسِ",24,"س",1,0],["فَلَرُبَّمَا رَجَحَ الْخَسِيسُ مِنَ الْحَصَى","بِالدُّرِّ عِنْدَ تَمَاثُلِ الْمِيزَانِ",25,"ن",1,0],["فلريَّاهُ في المعاطين عرفٌ","ولرؤياهُ بهجةٌ في العيونِ",26,"ن",1,0],["فَلَرُبَّ رَكبٍ لِلرَدى تَحتَ السُرى","ضَرَبوا قِبابَهُم بِها لِثَواءِ",27,"ا",2,0],["فَلَرُبَّما طَرَقَت جَنابي فِتيَةٌ","كَرُموا جِواراً في العُلا وَنِجارا",28,"ر",2,0],["فَلَرُبَّ سَمراءِ الأَديمِ طَويلَةٍ","حَسَدَت بِراحَتِهِ القَصيرَ الأَصفَرا",29,"ر",2,0],["فَلَرُبَّ يَومٍ قَد رَفَعتَ بِهِ المُنى","وَمَحَوتَ فيهِ سَوادَ ظَنِّ البائِسِ",30,"س",1,0],["فَلَرُبَّما نُثِرَ الجُمانُ تَعَمُّداً","لِيَكونَ أَحسَنَ في النِظامِ وَأَجمَلا",31,"ل",2,0],["فلربما انقطع الحما","ئم في الدُّجى عن شدوهنّه",32,"ن",2,0],["فَلَرُبَّ حادِثَةٍ نَهَضتَ بِها","مُتَقَدِّماً فَتَأَخَّرَ الدَهرُ",33,"ر",1,0],["فَلرُبَّمَا أَلْقَى عليكَ كِتابُهُ","قَولاً مِنَ السِّرِّ المَصُونِ ثَقِيلا",34,"ل",2,0],["فَلَرُبَّمَا هَزَمَ الْكَتِيبَةَ وَاحِدٌ","وَلَرُبَّمَا جَلَبَ الدَّنيئَةَ مَعْشَرُ",35,"ر",1,0],["فَلَرُبَّ صَعْبٍ حَادَ سَهْلاً بَعْدَمَا","قُطِعَتْ عَلَيهِ مَرَائِرُ الأَنْفَاسِ",36,"س",1,0],["فَلَرُبَّمَا انْقَلَبَ الصَّدِيقُ مُعَادِياً","وَلَرُبَّمَا رَجَعَ الْعَدُوُّ صَدِيقَا",37,"ق",2,0],["فلرُبّ رَوْضٍ للنّواظِر مُعْجِبٍ","كمَنتْ سُمومُ الصِّلِّ في زَهَراتِه",38,"ت",2,0],["فلربما اتسع المضيق","وربما ضاق الفضا",39,"ض",2,0],["فلَرُبَّما نفَتِ الشَّكاةَ وقرَّبَتْ","يومَ الخلاصِ سياسةُ الإصرار",40,"ر",1,0],["فَلَرُبَّ عَيْشٍ بالِّلوَى لم تُسْتَزَدْ","حُسْناً لَيَالِيهِ ولا أَيّامُهُ",41,"م",2,0],["فَلَرُبّ منزلة، هُنَاكَ، مُحيلَةٍ،","وَمَحَلّةٍ قَفْرٍ، وَرَسْمٍ دائِرِ",42,"ر",1,0],["فلربما تجد العروبة نفسها","ويضيء في قلب الظلام شهاب",43,"ب",1,0],["فلَرُبَّما وهُوَ المُرَوِّعُ سحنةً","لو كانَ مِثْلي شاعراً لَرَثاني",44,"ن",2,0],["فَلَرُبَّ صَعْبٍ عَادَ سَهْلاً بَعْدَمَا","قُطِعَتْ عَلَيْهِ مَرَائِرُ الأَنْفَاسِ",45,"س",1,0],["فلرب آن فيه ينقلب الجفا","قربا يسر وتحضر الغياب",46,"ب",1,0],["فلرب شاك يأتني متذمراً","ليقول لي بصراحة المغبون",47,"ن",1,0],["فلربما حَسدوك أو حسدوكهُ","فتقوَّلوا كذباً عليه وحرّدُوا",48,"د",3,0],["فلربما اشتد الخيال وعاقه","دون الصواب هوى وأصبح غالبا",49,"ب",2,0],["فلرُبَّ ليْلٍ ضَلَّ عنهُ صَباحُهُ","فَكأَنَّهُ بكِ خطرةُ المتفكِّرِ",50,"ر",1,0],["فَلَرُبَّما وَدّى السَفا","نَحوَ السَفا أَهلَ السَفاءِ",51,"ا",2,0],["فَلَرُبَّما وَدّى الفَضا","مُتَزَوِّديهِ إِلى الفَضاءِ",51,"ا",2,0],["فَلَرُبَّما فَضَحَ الرِجا","لَ ذَوي اللِحى كَشفُ اللِحاءِ",51,"ا",2,0],["فلربّما عاديت بعد مودّة","ولربّما صافيت بعد تقالي",52,"ي",1,0],["فلرب ذ