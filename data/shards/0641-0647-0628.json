ية الوعساء أين يمينها","https://www.aldiwan.net/poem39912.html","الطويل"],[438,"أيا رب قد ألقيت رحل رجائي","https://www.aldiwan.net/poem14287.html","الطويل"],[438,"بمثوى مسقط طال الثواء","https://www.aldiwan.net/poem14294.html","الوافر"],[438,"وداعا وحسبي الله يا عرفات","https://www.aldiwan.net/poem14298.html","الطويل"],[438,"أودع من لا أستطيع وداعه","https://www.aldiwan.net/poem14325.html","الطويل"],[438,"عذاب الهوى في قلب من رامه عذب","https://www.aldiwan.net/poem14329.html","الطويل"],[438,"بنفسي رسوم بين نفعي وغرب","https://www.aldiwan.net/poem14331.html","الطويل"],[438,"هو الحزن حتى ما يماثله حزن","https://www.aldiwan.net/poem14388.html","الطويل"],[438,"نيوب النائبات البائنات","https://www.aldiwan.net/poem14437.html","الوافر"],[450,"ويا ليلة أفنيت فاحم نفسها","https://www.aldiwan.net/poem13650.html","الطويل"],[456,"لعل الركب أن خلصوا نجيا","https://www.aldiwan.net/poem55813.html","الوافر"],[456,"ألا فتى يسأل قلبي ماله","https://www.aldiwan.net/poem55905.html","الرجز"],[456,"رعت من تبالة جعدا لفيفا","https://www.aldiwan.net/poem56111.html","المتقارب"],[456,"في كل دار عدو لي أقاذعه","https://www.aldiwan.net/poem56117.html","البسيط"],[456,"لعمر الواشيات بأم عمرو","https://www.aldiwan.net/poem56176.html","الوافر"],[459,"يا باذل المال في عدم وفي سعة","https://www.aldiwan.net/poem15323.html","البسيط"],[466,"لحقتك بالإقرار مني أحثه","https://www.aldiwan.net/poem59915.html","الطويل"],[477,"وذات محيا يخلق الله ما يشا","https://www.aldiwan.net/poem36913.html","الطويل"],[477,"دع الأيام تخطي أو تصيب","https://www.aldiwan.net/poem37044.html","الوافر"],[480,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[480,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[527,"العلم ما أوصل أربابه","https://www.aldiwan.net/poem37129.html","السريع"],[527,"أراني قد ضعفت فليت شعري","https://www.aldiwan.net/poem37397.html","الوافر"],[536,"وحقك يا منيتي ما أحب","https://www.aldiwan.net/poem48284.html","عموديه"],[549,"وسائلة لتعرف ما عراني","https://www.aldiwan.net/poem47165.html","الوافر"],[549,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[549,"ما أساء الزمان فيك الصنيعا","https://www.aldiwan.net/poem47714.html","الخفيف"],[549,"أمن أجل من سارت بهن الأباعر","https://www.aldiwan.net/poem47825.html","الطويل"],[556,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[562,"لإبراهيم إقبال وسعد","https://www.aldiwan.net/poem898.html",""],[565,"قفل الدجى وأتى الصباح حميدا","https://www.aldiwan.net/poem69716.html","الكامل"],[573,"كل خطب إذا تخطاك عمدا","https://www.aldiwan.net/poem2785.html","الخفيف"]],"verses":[["فَهَب لِيَ ذَنباً واحِداً كانَ قُلتُهُ","فَما زَلَلٌ مِن حازِمٍ بِعَجيبِ",0,"ب",1,0],["فَهَبَّ يُنادي صَاحِبيْهِ وَطَرْفُهُ","عَنِ النَّجْمِ مُزْوَرٌّ وَلِلْفَجْرِ لاحِظُ",1,"ظ",1,0],["فهبَّتْ كما ارْتاعَ الغَزالُ وأوْجَسَتْ","مِن ابْنِ أبيها خِيفَةً أيَّ إيجاسِ",2,"س",1,0],["فهَبَّ كما اسْتَتْلى القَرينَةَ شامِسٌ","بهِ وَجَلٌ منْ رَوْعَةِ السّوْطِ حافِزُ",3,"ز",1,0],["فَهَبْهُ لِي وَاغْتَفِرْ مَا كَانَ مِنْ خَطَإٍ","وَزَلَّةٍ وَارْعَ لِي حُبِّي عَلَى الْقِدَمِ",4,"م",1,0],["فَهَب لي مِن جذوعِكُمُ جذوعاً","وَأَكثَرُ لَيسَ خَيرَكُم الغَليلُ",5,"ل",1,0],["فَهَب لي ذُنوبي فَدَتكَ النُفوسُ","وَلا زِلتَ تَنمي وَلا تَنقُصُ",6,"ص",1,0],["فَهَبها جَنَّةً فُتِحَت لِخَيرٍ","وَأَدخِلنا مَعَ المَعفُوِّ عَنهُم",7,"م",1,0],["فَهُبّي رِياحَ المَوتِ نُكباً وَأَطفِئي","سِراجَ حَياتي قَبلَ أَن يَتَحَطَّما",8,"م",2,0],["فَهُبّوا مِن مَراقِدِكُم","فَإِنَّ الوَقتَ مِن ذَهَبِ",9,"ب",1,0],["فَهُبّوا إِلى خَمّارَةٍ قيلَ إِنَّها","قَعيدَةُ خَمرٍ تَمزُجُ الروحَ بِالراحِ",10,"ح",1,0],["فَهَب لَهُ روحَ راحٍ","يَنطِقُ بِأَحفَلِ حَمدِ",11,"د",1,0],["فَهَبَّتْ لِلزِّيَادِ وَلَمْ","يَرَعْهَا بَأْسُ غَازِيهَا",12,"ي",3,0],["فَهُبُّوا أَيُّهَا الأَبِطَالْ","وَسُلُّوهَا مِن الأَغْمَادْ",13,"د",1,0],["فَهَبكَ يَميني اِستَأكَلَت فَاِحتَسَبتُها","وَجَشَّمتُ قَلبي قَطعَها فَتَشَجَّعا",14,"ع",2,0],["فهُبوا إليه هُبوب الصَبا","عسى أن يسِح ويغدودقا",15,"ق",2,0],["فهبتْ في الظلامِ إلى مدامٍ","كأن شعاعها قبسٌ يلوح",16,"ح",1,0],["فَهَبْ لي مَحْضَراً يشْفِي ويكْفِي","إذا أبْدأْتَ فيه لا تُعِيد",17,"د",1,0],["فهبك أوتيتَ ما لم يؤته أحدٌ","من فضل جاهٍ ومن مالٍ ومن ولدِ",18,"د",1,0],["فهبنيَ قد أعفيتُه من مَثوبتي","أيُغضي له شعري على مضض الوِترِ",19,"ر",1,0],["فهبْ ذلك الدينار صَاحبَ طالعي","من الأنجُم السيارةِ السبعة الزُّهرِ",20,"ر",1,0],["فهبْ جُرمي لتأميلي فقِدْماً","وهبتَ الجُرمَ وهو دمٌ عبيط",21,"ط",1,0],["فهبْ لراجيكِ إذناً منك تلقَ به","مُؤدَّباً غيرَ ذي جهل ولا خطلِ",22,"ل",1,0],["فهبْ لي ذاتَ نفسِك ولْتُبِنها","من الإكرام آياتٌ مُثولُ",23,"ل",1,0],["فَهَبَّ كلٌّ يُناديهِ ويَنْشُدُهُ","كأَنَّما النَّاسُ مَا ناموا ولا حلمُوا",24,"م",3,0],["فهبني كنت خصما أو عدوّا","أليس الصفح مذهبك الرضيا",25,"ي",2,0],["فهب داعي النيل","من نومه الطويل",26,"ل",1,0],["فَهُبوا لِاِتِّقائِهِ الدَهرَ في يَو","مِ نِزالٍ وَلَيسَ يَومَ نِزالِ",27,"ل",1,0],["فهَبْ ليَ يوماً منك يُنْشَرُ ذِكْرُهُ","فأنتَ لما يرجو العُفاةُ وهوبُ",28,"ب",1,0],["فَهَب عِقابي لِهَذا اليَومِ مُحتَسِباً","لِلأَجرِ فيهِ فَهَذا أَعظَمُ السَبَبِ",29,"ب",1,0],["فَهَب لِيَ سَجلاً مِن سَجالِكَ يُروِني","وَأَهلي إِذا الأَورادُ طالَ لُؤوبُها",30,"ب",3,0],["فَهَب لي اِبنَها فيما وَهَبتَ فَرُبَّما","وَهَبتَ طَريفاتِ العَطاءِ مَعَ التُلدِ",31,"د",1,0],["فَهَبها مِدحَةً ذَهَبَت ضِياعاً","كَذَبتُ عَلَيكَ فيها وَاِفتَرَيتُ",32,"ت",1,0],["فَهُبَّ إِلى المُدامِ فَإِنَّ فيها","شِفاءً عِندَ مُنقَلِبِ الهَواءِ",33,"ا",2,0],["فَهُبّا بِنا نَحوَ الصَبوحِ وَبَردِهِ","فَإِنّي لَيُرضِني النَديمُ إِذا هَبّا",34,"ب",2,0],["فَهَبي جَرَحتُ الخَدَّ مِنكَ بِنَظرَةٍ","أَفَما لِأَسرِ القَلبِ مِنكَ خَلاصُ",35,"ص",1,0],["فَهَبَّ لي وَحُمَيّا النَومِ تَصرَعُهُ","وَالشُكرُ يُطبِقُ مِن جَفنَيهِ ما فَتَحا",36,"ح",2,0],["فهبيني ساعة الصفو التي","تقسمُ الأيامُ ما فيها سواها",37,"ا",3,0],["فهَبّ نزيفاً والنّسيم معطرٌ","فما خلتُهُ إلّا النّسيم الّذي هبّا",38,"ب",2,0],["فَهَبَّت تُطيعُ الصَوتَ نَشوى مِنَ الكَرى","كَمُغتَبِقِ الراحِ المُدامِ شَمولا",39,"ل",2,0],["فَهَبَّ وَريحُ الفَجرِ عاطِرَةُ الجَنى","لَطيفَةُ مَسِّ البَردِ طَيِّبَةُ المَسرى",40,"ر",2,0],["فَهَبَّ يركضُ وَارْتاعتْ حَلِيلَتُه","مَهْلاً فإنّ فُؤادي خائِفٌ يَجِفُ",41,"ف",1,0],["فَهَبْهُ رسولَ اللهِ لي إنّني به","على ما ترى من شأنهِ لَمُكَلَّفُ",42,"ف",1,0],["فهبُّوا للصلاةِ من الرِحالِ","وقاموا خلَف سيّدهم مُثولا",43,"ل",2,0],["فَهَب لي جَنَّةَ المَأوى","أَراها مِن مُحَيّاك",44,"ك",1,0],["فَهَبَّت الطَير تَدعو الطَير مُرسلة","مِن الأَغاريد أَحلاها وَأَشجاها",45,"ا",3,0],["فَهَبهُ تَسَمّى اِسمي وَسَمّانِيَ اِسمَهُ","فَأَينَ لَهُ صَبري عَلى مُعظَمِ الخَطبِ",46,"ب",1,0],["فَهَبَّ وَما هَبَّت مِنَ العَجزِ عَينُهُ","وَمِن سِنَةٍ أَوصالُهُ لا تُطَلَّقُ",47,"ق",1,0],["فَهَبْ لِي رسولَ اللَّهِ قُرْبَ مَوَدَّةٍ","تَقَرُّ بِهِ عَيْنٌ وتَرْوَى بِهِ كبدُ",48,"د",1,0],["فَهَبني كُنتُ في مَدحي رَزيناً","يَرومُ فَواضِلَ الحَسَنِ بنِ سَهلِ",49,"ل",1,0],["فَهبَطُوا من أَجمَعِ البُلدانِ","وأُسكنُوا مدينةَ السّلطانِ",50,"ن",1,0],["فهَبوُا عَينيّ ما أجدى البُكا","عَينَ ماء فَهْيَ إحدى مُنيَتي",51,"ي",1,0],["فهبّ أمامي من رُقاد وُجومه","كما هبّ مزعوبَ والجَنَان المهجِّع",52,"ع",1,0],["فهَبْ أنّي دَعَوْتُكَ للتّصافي","على غيرِ المُعَتَّقَةِ الشَّمول",53,"ل",1,0],["فَهُبِّي لِلصَّبُوحِ وَبَادِرِيهِ","سُلاَفَتُهُ النَّزَاهَةُ وَالضِّيَاءُ",54,"ا",2,0],["فهَبَّ يَحْفَظُهُ عَبْدُ الْحَفِيظِ بِمَا","أَقَرَّهُ وَالفُؤَادُ الثَّبْتُ مَخْلُوعُ",55,"ع",1,0],["فَهُبَّ إِلى اللَذاتِ مُؤثِرَ راحَةٍ","تُجِمُّ بِها النَفسَ النَفيسَةَ لِلكَدِّ",56,"د",1,0],["فهبك حَتَمْتَ أنّ له عقاباً","ألم يكُ دون عتبك من عقابِ",57,"ب",1,0],["فهبَّ أمامي من رقاد وُجومه","كما هبَّ مرعوبُ الجنان المهجِّع",58,"ع",1,0],["فَهَب آلَ يونانَ لَم يُخبَروا","فَأَبناءُ قَحطانَ مَن غَرَّهُم",59,"م",1,0],["فَهَب نَواها اِستَبَدَّت دونَنا عَبَثاً","بِها وَإِن بَعُدَت في القُربِ هِجرانا",60,"ن",2,0],["فهبني أسلو أرضها بتكلف","فلست بسالٍ للأهالي ولا أنسى",61,"س",2,0],["فهبّت في ريحٌ من هواه","لها ما بين أحشائي وهيفُ",62,"ف",1,0],["فهب لهم ارواحهم واصطنعهم","فوالله ما ينسونها من صنيعة",63,"ه",1,0],["فَهَبِ الدَهرَ لا يَثوبُ وَهبها","غَمرَةً لا يُميطُها مَن يُميطُ",64,"ط",1,0],["فهبني خِلالاً ثمَّ هبني تَداخُلاً","خلالَ ثناياكَ العذابِ المناهلِ",65,"ل",1,0],["فَهَبوا ناصِحَكُم رامَ الوَفا","هَل يُلاقي اللَيثَ سَرحٌ مِن نِقادِ",66,"د",1,0],["فَهُبوا بِالتَّعاضُدِ يا لِقَومي","ليحسُنَ مِن عَواقِبِنا المَصيرُ",67,"ر",1,0],["فهبني هوّنت الأمور وعظمها","فكيف وإني والمقابل مسجد",68,"د",1,0],["فهبكِ عيناً فما في الناسِ ذو نظرٍ","إلا ويؤلمهُ في عينهِ الرَّمدُ",69,"د",1,0],["فهب انه يحكيك معنى وصورة","فمن اين للبدر الرشاقة والطيف",70,"ف",1,0],["فَهَبَبتُ أَلثَمُها لِأَنَّ بِها","لِخيالِ حُمرِ خُدودِها أَثَرا",71,"ر",2,0],["فهبك طبعتَ السيف من لحظ مقلتي","وهبك قددتَ الذابلَ الرمحَ من قدّي",72,"ي",1,0],["فهب لي فيه خلعة الفوز والرضا","برؤياك يامن كان بالحق حاكما",73,"م",2,0],["فَهَب لَهُ أَنتَ ما تَسَنّى","وَهَبهُ مِن بَعضِ ما تُنيلُ",74,"ل",1,0],["فَهَب لي حَياتي فَالحَياةُ لِقائِمٍ","بِشُكرِكَ فيها خَيرُ ما أَنتَ واهِبُ",75,"ب",1,0],["فهبها قبولاً منك مولاي انها","نتيجة عضب قد تكهم حده",76,"د",2,0],["فهبها قبولا منك هب قبوله","وهاب العدا منه الرياح الحواشكا",77,"ك",2,0],["فَهَبِ السُّيُوفَ رَأيتُها مَشهُورةً","فَتَركتُها ومَضَيتُ في الهُرَّابِ",78,"ب",1,0],["فهبي المشوقَ من الوصالِ أقلَّهُ","واسقي من الينبوعِ بالإبريق",79,"ق",1,0],["فهبي لهُ مما وُهبت من السَّنى","فالنجمُ يؤنِسُنا بحسنِ المطلع",80,"ع",1,0],["فهبي الأمانَ لقائلٍ في أسرهِ","عيناكِ آسرتانِ للقوّاد",81,"د",1,0],["فهبَّ الشَّرقُ بعد خمورِ دهرٍ","لصرخةِ ذلك الشعبِ النخيِّ",82,"ي",1,0],["فهبَّ إليه والهواجرُ تلتظي","يجدُّ عَلَى الإِعياءِ سيراً وَيعنق",83,"ق",1,0],["فَهبها قبولاً فَهيَ مِن أَثَر الثَنا","لِعلياك وَالآثار تُهدى إِلى العينِ",84,"ن",1,0],["فَهبني فَدَتك النَفس عَفوك إن أَكُن","أَتيت بِما يَستَوجب الرَمي وَالطَرحا",85,"ح",2,0],["فَهَب من جنى في الخَلق جاها فَكَم نَجا","بِجاهِكَ مِثلي يا مُشفّع مذنبُ",86,"ب",1,0],["فَهُبّا صاحبيَّ إلى المطايا","ألَمّا تَسأما هذا المُقاما",87,"م",2,0],["فهَبْ نَجْداً لساكِنِهِ وأَعْرِضْ","فحَسْبُكَ من عَرارتِهِ شَميم",88,"م",1,0],["فهَبْ نظرةً عَدْلاً يَصِخْ لك ناظِراً","بَواطِنُ من أَحوالنا وظَواهر",89,"ر",1,0],["فهَبْ ليَ طِرْفاً يَسبِقُ الطَرْفَ إن 