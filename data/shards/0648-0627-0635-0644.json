"ب",3,0],["واصلتُ قولي في ثناهُ فحبذا","متوَحدٌ يثني على متوحد",4,"د",1,0],["واصل رجائي بعرف الدِّيك مقتبلاً","لن يذهب العرف عند الله والناس",5,"س",1,0],["وأصلح منِّي ظاهراً ثم باطناً","فلا أنا عريانٌ ولا أنا جائع",6,"ع",1,0],["واصلت قصدي باللهى وقطعت ما","بيني وبين بني الزمان من العُلَق",7,"ق",1,0],["واصل الملك بأسبا","بِ السعود الأبديَّه",8,"ي",2,0],["واصلٌ من صَدَّ عنه","فإذا أقبل صدّا",9,"د",2,0],["واصلت منها فتاة في خلائقها","غدر وفي خلقها روض وغدران",10,"ن",1,0],["وَأَصلَبَ عوداً حينَ ضاقَت أُمورُها","وَهَمَّت مَعَدٌّ أَن تَخيمَ وَتَخمُدا",11,"د",2,0],["واصِلْ مدامَكَ واهْجُرْ قَالةَ النّاسِ","وَرُحْ إلى صَدْرِ مَلْهَى خَيْرِ جُلاَّسِ",12,"س",1,1],["واصلنَ نحوَ البيتِ بالسير السُّرَى","يحملن رَكْبا",13,"ب",2,0],["واصِلٌ مَجدَهُ بِعَقدِ الثُرَيّا","وَيَداهُ بِالجودِ مَوصولَتانِ",14,"ن",1,0],["وَأَصلُهُمُ أَصلي وَفِرعي إِلَيهِمُ","وَقُدَّت سُيوري مِن أَديمِهِمُ قَدّا",15,"د",2,0],["واصَلَ العزَّ في مغانيك عِزٌّ","دائمُ المُلكِ وَالسرورَ سُرورُ",16,"ر",1,0],["وَأَصَّلتَ شِعري فَاِعتَلى رَونَقَ الضُحى","وَلَولاكَ لَم يَظهَر زَماناً مِنَ الغِمدِ",17,"د",1,0],["واصِل نَهارَكَ يا خَليلي","وَاِطرِد هُمومَكَ بِالشَمولِ",18,"ل",1,1],["واصَلَني مِن بَعدِكُم سَيِّدي","كَذاكَ أَيضاً لَكُمُ العُقبى",19,"ا",1,0],["وَأُصلِحَ النايُ وَرُمَّ الدَفُّ","وَاِختَلَفَت بَينَ الزُناةِ الصُحفُ",20,"ف",1,0],["واصِلاً لِلحَياةِ مِنها وَإِن عا","شَ وَماتَت بَكى عَلَيها وَناحا",21,"ح",2,0],["وأصلوا الشرك الحروب الغابرة","واستأصلوا شأفته ودابرهْ",22,"ه",1,0],["وَأَصْلَحَتْ عَنَتَ الأَيَّامِ حِكْمَتُهُ","مِنْ بَعْدِ مَا كَانَ صَدْعَاً غَيْرَ مَجْبُورِ",23,"ر",1,0],["واصَلَك القَلبُ هَوىً","فَما لِجِسمي هَجرَك",24,"ك",1,0],["واصلت الله أصليتا يحس به","سواعدا شدها بغي وكفران",25,"ن",1,0],["واصل مقامك في الصلاة وغيرها","عبدا على الاحسان وردك والصدر",26,"ر",1,0],["واصلته الجبار سيفا مهندا","على كل علج سيء القلب فاسد",27,"د",1,0],["واصلح الاحكام حتى رأى","رونق عز الاهل طرف الغريب",28,"ب",1,0],["وأصلتت من جفنها","نصل حسام باتر",29,"ر",1,0],["وأصلهم من ببطحا يثرب رفعوا","منار هدى وفيهم شرف الوادي",30,"د",2,0],["واصلح طريق النحو","وانف السوى تلق اللَه",31,"ه",1,0],["وإصلاَحِ الجَنَانِ وَبُرءِ مَا في","أَدِيمِ الجِسمِ مِن دَاءٍ دَوِيِّ",32,"ي",1,0],["وإصلاح أمر المسلمينَ اهتمامهُ","وأكثرُ همّ الناس في غادةِ خَوْدِ",33,"د",1,0],["واصَلَني ثمَّ بَدا هَجْرُهُ","تِلْكَ لَعَمرِي كَرَّةٌ خاسِرَهْ",34,"ر",2,0],["واصِلْهُما مِن قَبلِ أَنْ","يَرْميكَ وَصْلُهُما بِصَدِّ",35,"د",1,0],["وَاصَلْتُ فيكَ هَوائي","لمَّا قَطَعْتَ رَجائي",36,"ي",1,1],["واصلحت أطراف البلاد ولم تدع","وراءك طاغ يرفع الرأس أن صكا",37,"ك",2,0],["وأصلح حالا ذقت منه مرارة","بعيشي إِلى أن عاد كالعهد حالياً",38,"ي",2,0],["وأَصلخَ في مَنفذَيْ سمعِهِ","صمامٌ من الصَّممِ المُطبِقِ",39,"ق",1,1],["وَاصِلٌ بَعْدَ جَفَاءٍ","ضاحِكٌ بَعْدَ عُبُوسِ",40,"س",1,0],["واصَلتني ولَكم قبلُ هفا","نَحوَها قَلبي وزادَت شَجني",41,"ي",1,0],["واصلتني حتى ملكت حشاشتي","ورجعت من بعد الوصال هجرتني",42,"ن",2,0],["وَأَصْلِحْ بَيْنَ نَفْسِكَ وَالسَّجَايَا الْ","تِي تُرْجَى النَّجَاةَ بِهَا وَآخِ",43,"خ",1,0],["وَأَصْلِحِ الأَشْرَافَ سَادَتَنَا","إِنَّ لَنَا فِِي رُشْدِهِمْ بِغْيَهْ",44,"ي",2,0],["واصِل مَن حازَ كُلَّ حُزنٍ","يا حائِزَ غايَة الجَمالِ",45,"ل",1,0],["واصِل الراحَ ما حَييتَ ولا","تُصغ سَمعاً لعاذلٍ يُغويك",46,"ك",1,0],["وَأَصلحَ الدينَ والدُنيا بملَّتهِ","وأَقبلت في الوَرى تَترى مصالحُهُ",47,"ح",2,0],["وأَصلُها أَفعلاءُ ثمّ حوَّلها","أَفعاءَ حَذفٌ له في الصَرف إِبداءُ",48,"ا",2,0],["واصلتْ بأَلسنةٍ","من شواظِها كَتَدي",49,"د",2,0],["وَأَصَلتُ مِن غِمدِ السَجِيَّةِ مُرهَفاً","مِنَ العَزمِ ماضٍ قَد تَحاشا عَنِ الفُلِّ",50,"ل",1,0],["وَأَصلُ الحَزمِ أَن تُضحي","وَرَبُّكَ عَنكَ في الحالاتِ راضِ",51,"ض",1,1],["واصل ضلال الخلق من كل فرقة","هو الخوض في فعل الإله بعلة",52,"ه",1,0],["وَأَصل جُنوني وَالجُنون فُنونُ","عُيونٌ عَن السحر المُبين تَبينُ",53,"ن",1,0],["واصلته فَجَفا أَخلفتهُ فَوفَى","أَوجَبتهُ فَنَفى أَحببتهُ صَلفا",54,"ف",2,0],["وَأصلَتَ مِن عَزِيمَتِهِ حُساماً","تُقَدُّ بِهِ الجَوَاشِنُ وَالدُّروعُ",55,"ع",1,0],["واصلْتَ رِفْدَك بعد ما أغنيْتني","جَوْدَ الغمامِ على الغديرِ المُتْرَع",56,"ع",1,0],["واصَلْتُها والبِيضُ لم تَقطُرْ دماً","مِن دُونِها والسُّمْرُ لم تَتَكَسّر",57,"ر",1,0],["واصِلُ طَيفِ الحِبِّ كَالهاجِرِ","وَلا أُحِبُّ الزورَ مِن زائِرِ",58,"ر",1,1],["وَأَصلُ الهَوى في القَلبِ عَيني وَعَينُهُ","وَكُلُّ بَلاءٍ عَنهُما مُتَفَرِّعُ",59,"ع",1,0],["واصَلنَني حيثُ لا رَقيبٌ","إلا أبُو القاسِمِ الحُسَينُ",60,"ن",1,0],["واصَلَنني فرَأيتُ لَي","لَ البيضِ لَيلاً أبيَضا",61,"ض",2,0],["وأصلح عقلاً كان من قبل ناقصاً","وأفصح نطقاً كان من بعد لاثغا",62,"غ",2,0],["وَأَصل المَحبوب وَالقَدحا","وَأَهجر اللؤام وَالنصحا",63,"ح",2,1],["واصلح القلب واذهب","لفساده وسواده",64,"د",2,0],["واصلح الوالي أرشده","للعدل في البدوو البلدان",65,"ن",1,0],["واصلح القلب ليصلح أمرنا","كله دنيا وأخرى بالكمال",66,"ل",1,0],["وأصلح القلب تصلح به جميع الفصول","يشغل بيده ويترك كل ما هو فضول",67,"ل",1,0],["واصلح للفؤاد","تصلح به كل الأحوال",68,"ل",1,0],["وأصلح فؤادا أنت أعلم بدائه","وأمراضه يا عالما بالسريرة",69,"ه",1,0],["وأصلح أعمالي جميعاً وقادني","إلى كل خير عند خاتمة العمر",70,"ر",1,0],["وأصلحت ما بين الأئمة قد جرى","وأطفأت ناراً شَبَّها كل مفسد",71,"د",1,0],["واِصلح بِبعض القَومِ بَعضاً فَإِنَّهُ","يُداوي بلحم الصِل شر سِمامِهِ",72,"م",2,0],["وأصْلى لظى نار الأَسى كلَّما أرى","مكانك ما قد كانَ بالأَمس خاليا",73,"ي",2,0],["وأصل وجود العالمين جميعهم","هو المظهر المجلى هو المقصد الأسنى",74,"ن",2,0],["وأصل ذاك من دخان لؤلؤة","ومن حيالتها مذ أربدت فرقا",75,"ق",2,0],["وأصل عروق الفتى الرسخا","تٍ تظهر في الذوق أغصانه",76,"ن",2,0],["واصلني مصفَرَّ القضيب فمذْ","رَفَّ عليه غصنُ الغنى صَرَما",77,"م",2,0],["واصلةً ومَن يردُّ جنبَهُ","عن ليلها وإن سئمن العَرَقا",78,"ق",2,0],["واصلَتْ شاعرَهم نُعمَى لكم","لم تدعْ مفحمَهَم حتّى شَعَرْ",79,"ر",1,0],["واصلٌ قاطعٌ وما كلُّ سيفٍ","كبني يوسفٍ لوصلٍ وقطع",80,"ع",1,0],["وَأَصلُ هَذا حَسَدٌ مِنهُ لي","عَلى قَوافٍ هِيَ تيجانُ",81,"ن",1,0],["واصِل إِذَن بَعلي فَقُلتُ لَها","الغَدرُ شيءٌ لَيسَ مِن ضَربي",82,"ب",2,0],["واصلَ اللّهُ حُربةً أضمرَتْهُ","بصَلاةٍ كقَطرَةِ المُهراقِ",83,"ق",1,0],["واصْلِحْ لَهُ الأَحْوالَ وارْ","فَعْ ما عَرَاهُ مِنْ سَقَمْ",84,"م",1,0],["وأَصْلِحْ ما ت