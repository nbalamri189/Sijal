{"poems":[[29,"ودع أمامة حان منك رحيل","https://www.aldiwan.net/poem5975.html","الكامل"],[31,"حي المنازل بين السفح والرحب","https://www.aldiwan.net/poem6045.html","البسيط"],[82,"لله شمس كان أولها السها","https://www.aldiwan.net/poem31264.html","الكامل"],[46,"صرف النوى ليس بالمكيث","https://www.aldiwan.net/poem30564.html","مجزوء البسيط"],[42,"ما هاج قلبك يوم العرج من ظعن","https://www.aldiwan.net/poem42333.html","البسيط"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72225","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55505","الكامل"],[31,"حيِّ المنازِلَ بَينَ السّفْحِ والرُّحَبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17430&r=&rc=3",""],[147,"فت الورى فعلام ذا الإجهاد","https://www.aldiwan.net/poem11754.html","الكامل"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[240,"ألفجر ليلك بالبنية مطلع","https://www.aldiwan.net/poem31891.html","الكامل"],[257,"سقى دمشق وأياماً مضت فيها","https://www.aldiwan.net/poem1480.html",""],[369,"حيتك غادية الحيا من مربع","https://www.aldiwan.net/poem60850.html","البسيط"],[376,"ما طول الليل القصيرا","https://www.aldiwan.net/poem57394.html","مجزوء الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138342",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138266",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138403",""],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101513","الكامل"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44605","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38162","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56264","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56125","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79859","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79904","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79806","البسيط"],[1586,"","https://poetry.dctabudhabi.ae/diwan/poem/96346","البسيط"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202175","الكامل"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131333","الرجز"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109353","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53128","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77349","الكامل"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141206","الرجز"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100336","البسيط"],[4484,"","https://poetry.dctabudhabi.ae/diwan/poem/202509","الكامل"],[4935,"يروي لنا التاريخ أن النيلا","https://www.poetsgate.com/ViewPoem.aspx?id=129369",""],[5009,"يا أمتي وجب الكفاح","https://www.poetsgate.com/ViewPoem.aspx?id=24367",""],[5190,"العرافة","https://www.poetsgate.com/ViewPoem.aspx?id=179298",""],[5271,"نواقيس الرؤى","https://www.poetsgate.com/ViewPoem.aspx?id=123677",""],[5493,"هذا الحزين","https://www.poetsgate.com/ViewPoem.aspx?id=204450",""],[5596,"الكيذاوي","https://www.poetsgate.com/ViewPoem.aspx?id=206478",""],[5616,"حلب","https://www.poetsgate.com/ViewPoem.aspx?id=203437",""],[5776,"برقيّةٌ عاجلةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=199448",""],[5190,"فتجملي بالصبر يا بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85048&r=&rc=123",""],[5190,"عدتَ يا يوم مولدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85047&r=&rc=122",""]],"verses":[["مِن كُلِّ صادِقَةِ النِجادِ كَأَنَّها","قَرواءُ رافِعَةُ الشِراعِ جَفولُ",0,"ل",1,0],["مِن كُلِّ صَهباءَ مِعجالٍ مُجَمهَرَةٍ","بَعيدَةِ الضَفرِ مِن مَعطوفَةِ الحَقَبِ",1,"ب",1,0],["من كلّ صَبٍّ بالحروبِ حياتُهُ","مشغُوفَةٌ بمنيّةِ الأقرانِ",2,"ن",1,0],["مِن كُلِّ صُلبِ القَرا مَعوجٍ","وَكُلِّ عَيرانَةٍ دَلوثِ",3,"ث",1,0],["مِن كُلِّ صَفراءَ مِثلِ الرِيمِ خَرعَبَةٍ","في ناصِعِ اللَونِ تَحتَ الرَيطِ كَاللَبَنِ",4,"ن",1,0],["من كُلِّ صافيةٍ صِرْفٍ وقافِيَةٍ","مِثْلِ السّنانِ وأمْرٍ غَيْرِ مُقْتَسِمِ",5,"م",1,0],["مِنْ كُلِّ صَرْحٍ حَافِلٍ","كَمَدِينَةٍ جُمِعَتْ نَضِيدَهْ",6,"د",2,0],["من كلّ صهباءَ معجالٍ مجمهرة","بعيدة ِ الطَّفْرِ مِنْ معطوفة ِ الحَقَبِ",7,"ب",1,0],["مِن كُلِّ صَعّادٍ إِلى رُتَبِ العُلى","دَرَجاتُهُ أَبَداً ظُبىً وَصِعادُ",8,"د",1,0],["مِن كُلِّ صُلبٍ طاهِرٍ أَفضى إِلى","أَحشاءِ طاهِرَة الإِزارِ حصانِ",9,"ن",1,0],["مَن كُلُّ صَعبٍ عِندَهُ مُتَمَرِّدٍ","سَهلُ القِيادِ وَكُلُّ عاصٍ طَيِّعُ",10,"ع",1,0],["مِن كُلِّ صَفراء مثل الماء يانعة","تَخالها جمر نارٍ في تَلظّيها",11,"ي",3,0],["من كُلِّ صائدةِ الرّجالِ بمُقْلةٍ","منها وصائنةِ الجَمالِ ببُرقع",12,"ع",1,0],["من كلِّ صدرٍ مُوغرٍ","ملأَت ضَغائِنُه الصدورا",13,"ر",2,0],["من كل صقع قد سعوا لم يعبأوا","بعنا ولو كان المكان سحيقا",14,"ق",2,0],["من كل صوب قد نحونا نحوه","وإليه كم شد الرحال وفود",15,"د",1,0],["من كل صقع أتوا يهُدون من جذل","لك التهاني زرافات ووحدانا",16,"ن",2,0],["من كل صَرحٍ باذخٍ شرفاتُهُ","تبدي متى حان الأصيلُ عذارى",17,"ر",2,0],["مِن كُلِّ صافِيَةِ الصَفيرِ إِذا دَعَت","أَغنَتكَ عَن صَنجٍ هُناكَ وَجُلجُلِ",18,"ل",1,0],["مِن كلِّ صمصامٍ تَقلَّد صارِماً","مِن كلّ مُعتقِل بِأَسمرَ لَهذَمِ",19,"م",1,0],["من كل صنفٍ كالحبوب وغيرها","مما أعدَّ إلى الصيام وللزفرْ",20,"ر",1,0],["من كل صلداتٍ فتى","يوم القتال له اصطبارْ",21,"ر",1,0],["من كلّ صادقةِ المخيلةِ حلّقت","مِن نحو نجدٍ واغتديتَ مطافَها",22,"ف",3,0],["من كلِّ صاحيةِ الشمائل لم يزل","سكرُ الدلالِ بما يطيلُ مراحها",23,"ح",3,0],["من كلّ صادية الأحشاء ناهلةٍ","من دَمعها والشجى في صدرها اعتلجا",24,"ج",2,0],["من كل صهباء نستجري الزمام بها","تبري لها سهوة الضبعين علكوم",25,"م",1,0],["مِنْ كلِّ صَبٍّ بالطِّعان مُوَلَّهٍ","في مَتْن طاوٍ بالطِّراد مُوَلَّهِ",26,"ه",1,0],["من كُلّ صنفٍ صادقِ الحَلاوة","وفائقٍ في الحُسْنِ والطّلاوة",27,"ه",1,0],["من كل صادعة بالحق مشرقة","كالشمس تنشر اضواء البراهين",28,"ن",1,0],["من كل صلد اليدين لولا","فضيلة النطق كان صخرا",29,"ر",2,0],["مِن كُلِّ صَاحِبِ سُنَّةٍ شَهَدَت لَهُ","أهلُ الحَدِيثِ وَعَسكَرُ القُرآنِ",30,"ن",1,0],["مِن كُلِّ صافي الحُسنِ ذا","بَ الدُرُّ فَوقَ أَديمِهِ",31,"م",2,0],["من كل صنف ذكر وأنثى","وحرة وأمة وخنثى",32,"ث",2,0],["من كل صامتة الحجلين تفصح عن","نطق الوشاحين اشباعا واخطافا",33,"ف",2,0],["من كل صهصلق الوغى متوقد","وتراه عند قياده كالأبله",34,"ه",1,0],["من كل صورة فاضل إبداعها","ينيبك عن أوصافه تفضيلا",35,"ل",2,0],["من كل صافي الروح يوشك أن يطير بلا جناح","ممن يخف إلى صلاة الليل بادي الإرتياح",36,"ح",1,0],["مِن كُلِّ صَوبٍ أَقبَلُوا ، فَتَقَابَلُوا","فَتَقَاتَلُوا ، فَتَطَاوَلَت أَقزَامُ",37,"م",1,0],["مِنْ كُلّ صَوبٍ قَدْ أَتَيتُكِ هَائمًا","مَازلتُ أَبحَثُ في سَمَاكِ سنينَا",38,"ن",2,0],["منْ كلِّ صوبٍ أمطرتْ تلكَ السمَا","حتَّى تولَّى ذا البكاءُ لغيبِهِ",39,"ب",2,0],["من كل صوب من (عُمان) تآلفت","نبضاً فأجرى سيلُها أشعارها",40,"ر",3,0],["من كلّ صوب أتى الأوباش واندفعوا","وأنت وحدك والنيران واللهب",41,"ب",1,0],["منْ كلّ صَوْبٍ إلينا النصرُ قد حجّا","وعانقَ الصّبرُ فينا كلّ ما يُرجْى",42,"ج",2,1],["من كلِّ صَوبٍ ينسلونَ ، كأنهم","إذ جيَّشوا تلك الجيوشَ جرادُ",43,"د",1,0],["مِن كُلِّ صَوْبٍ أَقبَلَت أَعدَاؤُهَا","ورَمَت سِهَامَ شُرُورِهَا فِي الأَكبُدِ",44,"د",1,0]]}