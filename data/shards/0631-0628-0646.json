لبناء لو كنت حرا","https://www.poetsgate.com/ViewPoem.aspx?id=156469",""],[5213,"رب ناد دخلته واين نوا","https://www.poetsgate.com/ViewPoem.aspx?id=170539",""],[5409,"نحن في كل غدوةٍ ورواح","https://www.poetsgate.com/ViewPoem.aspx?id=155258",""],[5431,"لايضيعُ العُرْفُ..أنتم أهله","https://www.poetsgate.com/ViewPoem.aspx?id=185842",""],[5431,"ليس حبا من كان رهن انتهاء","https://www.poetsgate.com/ViewPoem.aspx?id=196612",""],[5431,"وفؤادي مشعشعٌ لا أفولُ","https://www.poetsgate.com/ViewPoem.aspx?id=197691",""],[5558,"يا رسولَ اللهِ يا خَيْرَ البشرْ","https://www.poetsgate.com/ViewPoem.aspx?id=212413",""],[243,"دجلة الغضبى","https://www.poetsgate.com/ViewPoem.aspx?id=50472",""],[5804,"لا تلم في الزمان حرا غريبا","https://www.poetsgate.com/ViewPoem.aspx?id=215193",""],[5900,"باسمكِ اللهمَّ يا ربَّ العبادْ","https://www.poetsgate.com/ViewPoem.aspx?id=150189",""],[5926,"خطوب الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=213829",""],[5953,"إن يوم الغدير يوم السرور","https://www.poetsgate.com/ViewPoem.aspx?id=93784",""],[5956,"الضيف الثقيل حالوش","https://www.poetsgate.com/ViewPoem.aspx?id=193420",""],[5956,"ابتسم للكون يمنحْك ابتساما","https://www.poetsgate.com/ViewPoem.aspx?id=194582",""],[6004,"عروسُ الشَّرق","https://www.poetsgate.com/ViewPoem.aspx?id=71985",""],[6143,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=34307",""],[4432,"ادكارا بعد ما ولى الشباب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=564221",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[6185,"ذاتُ الوشاح !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86946&r=&rc=6",""]],"verses":[["رُبَّ نائي المِلاطِ يُحسَبُ جيداً","حائِلاً بَينَ غَرضِهِ وَصِدارِه",0,"ر",2,1],["رُبُّ نَعيمٍ زالَ رَيعانُهُ","بِلَسعَةٍ مِن عَقرَبِ الحاسِدِ",1,"د",1,0],["رُبَّ نَعشٍ قَد شَيَّعَتهُ أُلوفٌ","مِن سَوادٍ تَعلوهُ سودُ الثِيابِ",2,"ب",1,0],["رَبَّنَا اغْفِرْ لِمِصْرَ بِالمَلِكِ الصَّا","لِحِ تِلكَ الذُّنُوبَ وَالآثَامَا",3,"م",2,0],["ربّ نفس كدرهم قد جلاها ال","علم حتى أعادها دينارا",4,"ر",2,0],["رُبَّ نحويّ بدَا في خدِّه","عارض كاللام ما أعلى وأسنى",5,"ن",2,1],["رُبَّ نُعمَى له عليَّ ونُعمَى","وأيادٍ له لديَّ جِسام",6,"م",1,0],["رُبَّ نفسٍ حرَّةٍ قد ألِفَتْ","وطنَ السُّوء فهَبْ أنَّي وطن",7,"ن",1,0],["رُبَّ نورٍ مُتَمَّمٍ","قَد أَتانا مِنَ الحُفَر",8,"ر",1,0],["رُبَّ نَقشٍ كَأَنَّما نَفَضَ الصا","نِعُ مِنهُ اليَدَينِ بِالأَمسِ نَفضا",9,"ض",2,0],["رُبَّ نَجيعٍ بِسَيفِ الدَولَةِ اِنسَفَكا","وَرُبَّ قافِيَةٍ غاظَت بِهِ مَلِكا",10,"ك",2,1],["ربِّ نعِّمهمُ فقدْ ألفوا مِنْ","شجرِ التوتِ جنَّةً وحريرا",11,"ر",2,0],["ربَّنا انْصُرْ قومَنا في المُزْدَحَمْ","واجْعَلِ الإسلامَ مرفوعَ العَلَمْ",12,"م",1,0],["ربَّنا لا تُخْزِنا بين الأُمَمْ","إنّه المجدُ وإرثُ الأنبياءْ",12,"ا",2,0],["ربّنا إنّا اهْتدينا","فَلَك الشُّكرُ عَلَيْنا",13,"ن",2,1],["رَبَّنا كُنْ لِلجَماعَهْ","إنّهم أهلُ اليمين",13,"ن",1,0],["رَبّنا اللّهمَّ نصرا","رَبَّنا أَنتَ المُعينْ",13,"ن",1,0],["رَبَّنا هَب لَها الجَزيلَ مِنَ الخَي","رِ وَوَفِّق أَبناءَها العامِلينا",14,"ن",2,0],["رُبَّ َنارٍ بتُّ أرمُقُها","تَقْضِمُ الهِنْدِيَّ والغارا",15,"ر",2,0],["ربنا لا ترسل علينا عذاباً","ليس فينا على العذاب صبور",16,"ر",1,0],["ربنا ارفق بنا فإنا ضعافٌ","ما لنا من حولٍ وأنت القدير",16,"ر",1,0],["ربَّ ناءٍ مدَّت إليهِ هواها","فهوى في شراكها القاتلاتِ",17,"ت",1,0],["ربَّ ناج أصابَ عمرًا جديدًا","فقضاهُ فريسةَ الأحزان!",18,"ن",1,0],["رُبَّ نثرٍ بَرْقعَتْهُ زينةٌ","هو زيفٌ حين يَنْضُو بُرْقُعَه",19,"ع",2,0],["رب نظم ما له من هدَف","ليس يدري ناظموه موقعَه",19,"ع",2,0],["رْ بَنِي عَمِّنا إنَّ الرِّكَاَب بأَهْلِها","إذا ساءها المولى تروحُوتبتكرْ",20,"ر",1,0],["ربنا غائم يغطّيه ليل","فكأنّا نسير في جوف قبر",21,"ر",1,0],["ربّ ! نعماك أن تنضّر قلبي","بمحيّاك فهو صاد محيل",22,"ل",1,0],["ربّ نعمى تضيع منّا إذا","زرت ولا ضجّة ولا ديدبان",23,"ن",1,0],["رَبَنا رَبّنا إِلَيكَ أَنينا","فَأَجرنا مِن حَر نار الجَحيمِ",24,"م",1,0],["رُبَّ نُجُومٍ في زَمانٍ أَوْرَقِ","راعَيْتُها في مَغْرِبٍ ومَشْرِقِ",25,"ق",1,1],["رَبَّنا إِنَّنا دَخَلنا لِحُصنِكْ","وَحَلَلنا بِالخَوفِ في كَهفِ أَمنِكْ",26,"ك",1,1],["رَبَّنا إِنَّنا لَهَجنا بِذِكرِكْ","وَوَقفنا بِالذُلِّ في بابِ بِرِّكْ",27,"ك",1,1],["ربنا بلهمه للسعدا","ودعاة الخلق سادات الأنام",28,"م",1,0],["رب نسألك تسترنا وتجبر وترحم","واغفر أوزارنا يا الله وجرم الذي اجرم",29,"م",1,0],["ربنا ياربنا ياربنا","رب ثبتنا إذا جا الانتقال",30,"ل",1,0],["ربنا يا ربنا اغفر ذنبنا","واعف عن أوزارنا الجم الثقال",31,"ل",1,0],["ربنا ياربنا ياربنا","كن لنا حال الإقامة والسفر",32,"ر",1,0],["ربنا يا ربنا إن عبدك بالفنا","كن به عند الفنا",33,"ن",2,0],["ربَّ نفوسٍ أرفدتْ من ألمٍ","نفسَك ما كنَّ له جوازعا",34,"ع",2,0],["ربنا لا تغير أولي","واسقني شربة بكف علي",35,"ي",1,0],["رَبَّنا أَنْفِذْ بِيَ الْحَ","قَّ بِرَغْمِ الْمُبْطِلينا",36,"ن",2,1],["رَبَّنا اشْهَدْ لي عَلَيْهِمْ","أَنْتَ خَيْرُ الشَّاهِدِينا",37,"ن",2,1],["رَبَّنَا فَلتُدِمهُ فَخراً وَذُخراً","رَبَّنَا فَلتُدِمهُ حِصناً حَصِينَا",38,"ن",2,0],["ربنا من لطفه لا يدركُ","حار من وحَّده والمشركُ",39,"ك",1,1],["ربنا الرب فيه والعبد عبد","ثم مع ذاك وحدة لا سواها",40,"ا",3,0],["ربنا الله وحده يتجلى","عندنا بالتقبيح والتحسين",41,"ن",1,0],["ربنا الله لا سواه هنا","وهو عين قديمة وعيونْ",42,"ن",1,0],["ربنا الله لم يلد لا ولم يو","لد كما جاء في الكتاب المبين",43,"ن",1,0],["ربنا الله لا سواه وأما","ربهم فهو عسجدٌ وجمان",44,"ن",1,0],["ربنا الله شارع الأحكامِ","محكم الخلق غاية الإحكامِ",45,"م",1,1],["ربنا رب السموا","ت العلى السبع الثقال",46,"ل",1,0],["ربنا الله ذلك المتعالي","عن جميع الأشباه والأمثالِ",47,"ل",1,1],["رب ناس رأيتهم ورأوني","وإذا فتشوا فليسوا بناس",48,"س",1,0],["ربنا الحق قد تنزه عنا","مستحيل الأولاد والأزواج",49,"ج",1,0],["رب ناس لهم جسوم رجال","ونفوس خلت من التأديب",50,"ب",1,0],["ربنا اللَهُ في جميع المجالي","ما على وجهنا الجميل غبار",51,"ر",1,0],["ربّنا اِجعل للعرب عزّا ونصراً","وفَخاراً ليُدركَ المأمولا",52,"ل",2,0],["ربنا اسمع منا الدعاء وهيىء","للعروسين كل فوز وغن