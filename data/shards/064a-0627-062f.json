0","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55075","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54965","المنسرح"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142021","الخفيف"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199494","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43747","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43675","البسيط"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/141749","البسيط"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/8990","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54255","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54239","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54264","الكامل"],[106,"تحية مولود","https://www.poetsgate.com/ViewPoem.aspx?id=179510",""],[106,"زمزم طليعة الأسطول المصري","https://www.poetsgate.com/ViewPoem.aspx?id=179646",""],[106,"فيلسوف الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179354",""],[106,"في مهرجان دار العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=179366",""],[106,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""],[90,"ذكرى الهاشمي","https://www.poetsgate.com/ViewPoem.aspx?id=179163",""],[90,"الذكرى أو دمعة تثيرها الكمنجة","https://www.poetsgate.com/ViewPoem.aspx?id=179143",""],[45,"لَوْلاَ تُعَنّفُني لَقُلْتُ: المُنْزِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32097",""],[55,"حتى متى انا مكروب بذكركم امسي واصبح حبا هائما دنفا","https://www.poetsgate.com/ViewPoem.aspx?id=8584",""],[99,"ترصيع بالذهب على سيف دمشقي","https://www.poetsgate.com/ViewPoem.aspx?id=587",""],[51,"أنَّى تشاغلتَ عن أبي حَسَنِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=30025",""],[51,"أبا عليٍّ طلبتُ عيبك ما اس","https://www.poetsgate.com/ViewPoem.aspx?id=29588",""],[30,"يَا دَارَ مَيَّة َ بَالْخَلْصَاءِ غيَّرَهَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20514&r=&rc=8",""]],"verses":[["يا دارُ قَلَّ الصَديقُ فيكِ فَما","أُحِسُّ وِدّاً وَلا أَرى سَكَنا",0,"ن",2,0],["يا دَهرُ كَم أَسهَرتَني مِن لَيلَةٍ","قَد كُنتُ فيكَ أَنامُها وَأُنيمُها",1,"م",3,0],["يا دينَ قَلبي لَكَ مِن لَوعَةٍ","تُعاوِدُ القَلبَ عِدادَ السَليم",2,"م",1,0],["يا دَهرُ دونَكَ قَد تَماثَلَ مُدنَفٌ","وَاِقتَصَّ مُهتَضَمٌ وَأَورَقَ مُعدِمُ",3,"م",1,0],["يا دَهرُ كَم تَحدو بِذي نُقبَةٍ","مُعتَرِقِ النَيِّ أَجَبِّ السَنام",4,"م",1,0],["يا دَهرُ ماذا الطُروقُ بِالأَلَمِ","حامٍ لَنا عَن بَقِيَّةِ الكَرَمِ",5,"م",1,1],["يا دَليلَ المَجدِ إِن ضَل","لَ عَنِ المَجدِ الكِرامُ",6,"م",1,0],["يا دِيارَ الأَحبابِ كَيفَ تَغَيَّر","تِ وَيا عَهدُ ما الَّذي أَبلاكا",7,"ك",2,0],["يا دارُ ما طَرِبَت إِلَيكِ النَوقُ","إِلّا وَرَبعُكِ شائِقٌ وَمَشوقُ",8,"ق",1,1],["يادَهرُ ما ذَنبُكَ في","ما رابَني بِمُغتَفَر",9,"ر",1,0],["يا دارُ مَن قَتَلَ الهَوى بَعدي","وَجَدوا وَلامِثلَ الَّذي عِندي",10,"ي",1,1],["يا دارَ ذُلٍّ لِمَن فارَقتِ قَعدَتَهُ","وَالعِزُّ أَولى بِمَن عُلِّقتِ يابيدُ",11,"د",1,0],["يا دَهرُ حَسبُكَ قَد أَصَبتَ مَقاتِلي","ما زِلتَ تَطلُبُ بِالمَقادِرِ غِرَّتي",12,"ي",1,0],["يا دَهرُ رَشقاً بِكُلِّ نائِبَةٍ","قَدِ اِنتَهى العَتبُ وَاِنقَضى العَجَبُ",13,"ب",1,0],["يا دينَ قَلبِكَ مِن با","رِقٍ يُنيرُ وَيَحبو",14,"ب",2,1],["يا دارَ قَومِيَ أَينَ ال","أولى بِرَبعِكَ لَبّوا",14,"ب",3,0],["يا دَهرُ هَبنيَ لا أَشكو إِلى أَحَدٍ","ما ظَلَّ مُنتَهَساً شِلوي مِنَ النُّوَبِ",15,"ب",1,0],["يا دَهْرُ حَتّامَ تَجْفو مَنْ تُزانُ بِهِ","أَمَا لَدَيْكَ بِما يَلْقاهُ مِنْ نَبَإِ",16,"ا",1,0],["يا دارَ عَبلَةَ بِالجَواءِ تَكَلَّمي","وَعَمي صَباحاً دارَ عَبلَةَ وَاِسلَمي",17,"م",2,0],["يا دَهرُ لا تُبقِ عَلَيَّ فَقَد دَن","ما كُنتُ أَطلُبُ قَبلَ ذا وَأُريدُ",18,"د",1,0],["يا دارُ أَينَ تَرَحَّلَ السُكّانُ","وَغَدَت بِهِم مِن بَعدِنا الأَظعانُ",19,"ن",1,1],["يا دارَ عَبلَةَ أَينَ خَيَّمَ قَومُه","لَمّا سَرَت بِهِمُ المَطيُّ وَبانوا",19,"ن",3,0],["يا دارُ أَرواحُ المَنازِلِ أَهلُه","فَإِذا نَأَوا تَبكيهِمُ الأَبدانُ",19,"ن",1,0],["يا دارَ فَوزٍ لَقَد أَورَثتِني دَنَفا","وَزادَني بُعدُ داري عَنكُمُ شَغَفا",20,"ف",2,1],["يا دارُ هَل تَفقَهينَ القَولَ عَن أَحَدٍ","أَم لَيسَ إِن قالَ يُغني عَنهُ إِكثارُ",21,"ر",1,0],["يا دارُ إِنَّ غَزالاً فيكِ بَرَّحَ بي","لِلَّهِ دَرُّكِ ما تَحوينَ يا دارُ",21,"ر",1,0],["يَادُرَّةً لِلْمَجْدِ مَكْنُونَةْ","حَاجَةُ مِثْلِي مِنْكِ مَضْمُونَهْ",22,"ه",1,1],["يا دائِمَ الحِقْدِ والفَظاظَةِ لا","يفَرِّقُ بيْنَ ظالِمٍ وبَري",23,"ر",2,0],["يا دَوحَةً لِلبَرِّ قَد نَشَرَت","في كُلِّ صالِحَةٍ لَها فَرعا",24,"ع",2,0],["يا دَولَةَ الأَخلاقِ رافِلَةً","مِن قاسِمٍ في أَبهَجِ الحُلَلِ",25,"ل",1,0],["يا دَولَةً فَوقَ أَعلامٍ لَها أَسَدٌ","تَخشى بَوادِرَهُ الدُنيا إِذا زَأَرا",26,"ر",2,0],["يا دَهرُ وَيحَكَ ما عَدا مِمّا بَدا","أَرسَلتَ سَهمَ الحادِثاتِ فَأَقصَدا",27,"د",2,1],["يا دَمعُ صُب ما شِئتَ أَن تَصوبا","وَيا فُؤادي آنَ أَن تَذوبا",28,"ب",2,1],["يا دارَ ماوِيَّةَ بِالحائِلِ","فَالسُهبِ فَالخَبتَينِ مِن عاقِلِ",29,"ل",1,1],["يا دعاة النادي ويا من أجابوا","فإذا صفوة البلاد حيالي",30,"ي",1,0],["يا دار أهلك بالسلامة عادوا","لا النفي أنساهم ولا الإبعاد",31,"د",1,1],["يَا دَهْرُ غِنْ كُنْتَ لَمْ تُمْهِلْ شَبِيبَتَنَا","حَتَّى أَدَلْتَ انْحِطَاطاً مِنْ مَعَالِينَا",32,"ن",2,0],["يَا دُعَاةَ العُلَى كَفَى مَا يُسَامُ","مِنْ مَسَاعٍ ذَاكَ السَّرِيُّ الهُمَامُ",33,"م",1,1],["يا دارَ مَيَّةَ بِالخَلصاءِ غَيَّرَها","سَحُّ العِجاجِ عَلى جَرعائِها الكَدَرا",34,"ر",2,1],["يا دارَ مَيَّةَ بِالخَلصاءِ فَالجَرَدِ","سُقيا وَإِن هِجتِ أَدنى الشَوقِ للِكَمَدِ",35,"د",1,1],["يا دارَ مَيَّةَ لَم يَترُك لَنا عَلَما","تَقادُمُ العَهدِ وَالهوجُ المَراويدُ",36,"د",1,1],["يا دولة النصر هل من مبلغ دولاً","مضينَ أنك تُحييها وتُنسيها",37,"ي",3,0],["يا دارَ هجرته يا أُفْقَ مطلعهِ","لي فيك بدرٌ بغير الفكر ما لُمِحَا",38,"ح",2,0],["يا درة في ضفاف البحر ضيّعها","قوم وكان بها البسفور مزدانا",39,"ن",2,0],["يا دار قسطنطين أنت فريدة","في الحسن لولا جوّكِ المتقلّب",40,"ب",1,0],["يا دارُ أَقوَت بِجانِبِ اللَبَبِ","بَينَ تِلاعِ العَقيقِ فَالكُثُبِ",41,"ب",1,1],["يا دارَ سَلمى خَلاءً لا أُكَلِّفُها","إِلّا المَرانَةَ حَتّى تَعرِفَ الدينا",42,"ن",2,1],["يا دَهرُ خُنتَ مَعَ الأَصادِقِ خُلَّتي","وَغَدَرتَ بي في 