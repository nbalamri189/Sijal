َيرِ وَعدٍ","وَاِنثَنى هاجِراً عَلى غَيرِ ذَنبِ",9,"ب",1,0],["زارَ بِذَيلِ الظَّلامِ مُنتَقِبا","ريمٌ إِذا سُمتُهُ الرِّضى غَضِبا",10,"ب",2,1],["زارَت سُليمى وَالخُطا يَقتَفي","آثارَها مِن ذَيلِها ماحِ",11,"ح",1,1],["زاهِرُ العُودِ وَطيبُه","وَلَياليهِ تُشيبُهْ",12,"ب",2,1],["زارَتْ أُمَيْمَةُ وَالظَّلْماءُ تَعْتَكِرُ","وَالنَّجْمُ يَخْطِرُ في أَلحاظِهِ السَّهَرُ",13,"ر",1,1],["زارَتْ بِناصِرَ الدّينِ الذي نَهَجَتْ","إِلى العُلا طُرُقاً شتّى صَنائِعُهُ",14,"ع",2,0],["زادَكَ اللَهُ سُروراً إِنَّ مَن","كُنتَ مُشتاقاً إِلَيهِ قَد قَدِم",15,"م",1,1],["زارتْ ونجْمُ الدُجَى يشْكو منَ الأرَقِ","والزّهْرُ سابِحَةٌ في لُجّةِ الأفُقِ",16,"ق",1,1],["زَارَتْ وَقَدْ جَارَتْ عَلَيَّ يَدُ الضَّنَى","وَالسُّقْمُ قَدْ أَنْحَى عَلَى جُثْمَانِي",17,"ي",1,0],["زَادَتْهُ فِي السُّوءِ بِنْتٌ","مِنَ الْمُسُوخِ الْقَديِمَهْ",18,"م",2,0],["زارَ في لَيْلَيْنِ ليْلٌ للدُّجى","حالِكُ الجُنْحِ وليْلٌ للسَّحَرْ",19,"ر",1,0],["زارَتْكَ مَزْرِيّةٌ تَرْجو عَوائِدَها","منْ لَثْمِ أنْمُلِكَ السُّبْطِ السّنِيّاتِ",20,"ت",1,0],["زَارَتْ وَقَدْ صَرَفَ العِنَانَ الغَيْهَبُ","وَالصُّبْحُ يُنْشَرُ مِنْهُ بَنْدٌ مُذْهَبُ",21,"ب",1,1],["زَالوا فَمازالَ أَنكاسٌ وَلا كُشُفٌ","عِندَ اللِقاءِ وَلا ميلٌ مَعازيلُ",22,"ل",1,0],["زانَتكَ أَلقابُ الرِجا","لِ العامِلينَ وَزِنتَها",23,"ه",2,0],["زالَت بَشاشَتُهُ وَزالَ وَأَقفَرَت","مِن أُنسِهِ الدُنيا وَمِن إِنسانِهِ",24,"ن",2,0],["زادَت مَواسِمُنا بِطَنطا مَوسِماً","لِمَليكِهِ التَقديسُ وَالتَبجيلُ",25,"ل",1,0],["زارَ وَهناً لا أَصغَرَ اللَهُ مَمشا","هُ وَحَيّا فَزادَهُ اللَهُ بِرّا",26,"ر",2,0],["زارَني بَعدَ هَجعَةٍ وَالثُرَيّا","راحَةٌ تَقدِرُ الظَلامَ بِشِبرِ",27,"ر",1,0],["زَايَلتَ بَيْتَاً عَتِيقاً أَنْتَ سَادِنُهُ","بِالإِرْثِ مِنْ عَهْدِ إِبْرَاهِيمَ والنَّسَبِ",28,"ب",1,0],["زَائِدَهُ طَائِلاً","مِنْ حَسَبٍ أَوْ نَسَبْ",29,"ب",1,0],["زارته قبل عيوننا آمالنا","وتقدمت أبدانها الأكباد",30,"د",1,0],["زادوا كنوز الشرق من تحف بما","في الغرب قصر دونه الأنداد",30,"د",1,0],["زَارَنِي صُبْحاً وَحَيَّى","بَاسِمٍ طَلقَ المُحَيا",31,"ي",2,1],["زَانَتْ لَهُ حَوْضَ الرّدَى زِينَةً","تَظْمَأُ بِالرّاوِي إلى وِرْدِهِ",32,"د",2,0],["زَارَتِ الدَّهْمَاءَ فِي أَخْصَاضِها","وَاسْتَزَارَتْهَا قُصُورُ المَالِكِينْ",33,"ن",1,0],["زَالَتْ وَمَا أَبْقَى الْهَوَى مِنْهَا سِوَى","عِطْرٍ يَضُوعُ هُنَيْهَةً وَدُخَانِ",34,"ن",1,0],["زَاهٍ بِأَفْصَحِ تَعْبِيرٍ وَأَبْلَغِهِ","سَهْلُ الأَدَاةِ سَلِيمُ اللَّفْظِ مِنَّ سَقَمِ",35,"م",1,0],["زَارَ الفِرنْجَةَ شِبْلُ مِصْرَ فَأَبْصَرَتْ","مَا سَوْفَ تَبْلُوهُ مِنَ الضِّرْغَامِ",36,"م",1,0],["زَالَ عَهْدٌ لَمْ يَرْعَ مَنْ سَادَ فِيهِ","حَقَّ شَعْبٍ يَفْنَى طَوىً وَأُوَامَا",37,"م",2,0],["زَانتْ بَدِيعَ حُلاَهَا","مَضَارِبُ الأَمْثَالِ",38,"ل",1,0],["زَادَ عِبْئِي أَخي سَلِيمٌ فَأي الشَّكْرِ","يَقْضِي مَا لِلأَخِ المِفْضَالِ",39,"ل",1,0],["زَائرٍ في قُصُورِ صَنعَاءَ يَسري","كُلَّ أَرضٍ مَخُوفَةٍ وَجِبَالِ",40,"ل",1,0],["زارَ الخَيالُ لِمَيٍّ بَعدَ ما رَحَلَت","عَنّا رَحى جابِرٍ وَالصُبحُ قَد جَشَرا",41,"ر",2,0],["زارَ الخَيالُ لَمَيّ هاجِعاً لَعِبَت","بِهِ التَنائِفُ وَالمَهرِيَّةُ النُجُبُ",42,"ب",1,0],["زان روضي أميره سعدٌ","وهو نجل الغني باللهِ",43,"ه",1,0],["زارَ الخيالُ بِأَيْمَنِ الزَّوْرَاءِ","فَجَلاَ سَناهُ غَياهبَ الظلماءِ",44,"ا",2,1],["زار العراق تفضّلاً","والفضل من كرم الغريزه",45,"ز",2,0],["زار المليك بلاد الروم حيث غدا","يُلقي الدسائس منكم كل هَمّاز",46,"ز",1,0],["زارَ الفَرَزدَقُ أَهلَ الحِجازِ","فَلَم يَحظَ فيهِم وَلَم يُحمَدِ",47,"د",1,1],["زانَ المَنابِرَ وَاِختالَت بِمُنتَجَبٍ","مُثَبَّتٍ بِكِتابِ اللَهِ مَنصورِ",48,"ر",1,0],["زارَ القُبورَ أَبو مالِكٍ","فَكانَ كَأَلأَمِ زُوّارِها",49,"ر",3,1],["زالَ الجِمالُ بِنَخلِ يَثرِبَ بِالضُحى","أَو بِالرَواجِحِ مِن إِباضَ العامِرِ",50,"ر",1,0],["زاكي الأُصولِ كَريمُ النَبعَتَينِ وَمَن","زَكَت أَوائِلُهُ طابَت أَواخِرُهُ",51,"ر",2,0],["زادَت هُمومٌ فَماءُ العَينِ مُنحَدِرُ","سَحّاً إِذا أَغرَقَتهُ عَبرَةٌ دِرَرُ",52,"ر",1,1],["زارني من هويته باسمَ الثغ","ر فجلى غياهبَ الظلماء",53,"ا",2,0],["زالَ الذي كانَ للعليا به سندٌ","وزالتِ الدَّارُ بالعلياءِ فالسندِ",54,"د",1,0],["زاد برداً فلو تولَّع بالشع","ر لقلنا الصَّلاح أو هو أشعر",55,"ر",1,0],["زاهى على غرر البلاد وأهلها","بأغر وضَّاع الخلائق أروع",56,"ع",1,0],["زادت شجوني فيه عن حدِّ السرف","وجرى عليه مدمعي حتى وقف",57,"ف",1,1],["زال الصبا ونأى الحبيب فعادني","أرقٌ على أرق ومثليَ يأرق",58,"ق",1,0],["زال عني ذاك الثنا فقضى قل","بي فرض الأحزان عند الزوال",59,"ل",1,0],["زاحف بين أسطرٍ وطروسٍ","لسطا عسكرين زنجٍ وروم",60,"م",1,0],["زادنا في صيامنا الشاهد الميّ","ت حتَّى تغيّظ الإسلام",61,"م",1,1],["زادت أياديك عن حدِّ القياس فما","ألفاظ قسٍّ وما ألفاظ سحبانِ",62,"ن",1,0],["زادت محاسن سلطان الورى حسن","إسماً وفعلاً وفاق السرّ والعلن",63,"ن",1,1],["زادكَ اللهُ بسطةً واقْتداراً","ومقاماً على السّهى ومحلاَّ",64,"ل",2,0],["زَادَ الغَرامُ بِهِم وَفي أَحشائِهِم","نارٌ وَفي أَكبادِهِم جَمراتُ",65,"ت",1,0],["زاد على عَيْلتِهِ زوجةً","يا لك من نَكْبٍ على نَكْبِ",66,"ب",1,0],["زانُوه زَيْنَ الفريد واسطةَ ال","عِقْدِ زها في النظام مُنْتَخَبُهْ",67,"ب",2,0],["زانتْهُ غُرٌّ من الخِلال لهُ","ما لم تَزِنْ متنَ مُنْصُلٍ شُطَبُهْ",67,"ب",2,0],["زانَها اللَّهُ بِخَدٍّ مُشْرِقٍ","لو مَشى الذَّرُّ عليه لَجُرحْ",68,"ح",1,0],["زادَكَ الله فوق صالِحِ ما أعْ","طاكَ شُكراً وغِبْطَةً في خُلودِ",69,"د",1,0],["زارتْكَ بعد النوم غيرَ زَوورِ","بين الظليم ومَكنِس اليعفورِ",70,"ر",1,1],["زاولتُ تمجيدَك في ساعةٍ","فأيُ معنى فيك لم يهجس",71,"س",1,0],["زارت على غفلةٍ من الحَرسِ","تُهدي إلي السلام في الغَلسِ",72,"س",1,1],["زاحت العِلَّتان عنك فلا بُخ","لٌ يعوق الندى ولا إعدامُ",73,"م",1,0],["زأرْتُ على عَدُوِّكَ غيرَ وانٍ","وأتبعتُ الزئيرَ له بكَلْم",74,"م",1,0],["زادَهُ اللَّهُ نعمةً وعلاءً","إنّه نعمةٌ على إخوانه",75,"ن",2,0],["زالَتِ الحَربُ وَوَلَّت إِنَّما","لَيسَ لِلذُعرِ مِنَ الحَربِ اِنقِضاء",76,"ا",2,0],["زادَت مَلاحَتَها فَزُدتُ بِها","كَلَفا وَموجَدَةً عَلى هِنري",77,"ي",1,0],["زارَتكَ لَم تَهتِك مَعانيها","غَرّاءَ يَهتِكُ نورُها الظُلَما",78,"م",2,0],["زايَلَ النورُ مُقلَتَيهِ وَغابَت","تَحتَ أَجفانِهِ المعاني المُبينَه",79,"ن",2,0],["زالوا مِنَ الدُنيا كَأَن لَم يولَدوا","سَحَقَتهُمُ كَفُّ القَضاءِ القاسِيَه",80,"ي",2,0],["زالَت وَما زِلتُ وَإِنَّ الشَقا","أَن تُطمَسَ الآيُ وَيَبقى الكِتاب",8