{"poems":[[396,"ذه عرشه مامثلها عرشه","https://www.aldiwan.net/poem54470.html","عموديه"],[3897,"","https://poetry.dctabudhabi.ae/diwan/poem/124049","الوافر"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33655","الرمل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120544","الخفيف"],[4987,"ماهى اول غلا","https://www.poetsgate.com/ViewPoem.aspx?id=49570",""],[5055,"حدثيني","https://www.poetsgate.com/ViewPoem.aspx?id=120914",""],[5074,"هذهِ قِصَّتي","https://www.poetsgate.com/ViewPoem.aspx?id=153510",""],[5277,"عراقُ البصرة","https://www.poetsgate.com/ViewPoem.aspx?id=199802",""],[5411,"للهِ أَنْتَ","https://www.poetsgate.com/ViewPoem.aspx?id=191286",""]],"verses":[["كن ذاكر وحامد شاكر","كن صابر تسلم من الخسران",0,"ن",1,0],["كنذا ان خط أحرفه يميني","بقرطاس يغار بها شمالي",1,"ل",2,0],["كُن ذليلاً للذي يشبهُهُ","رشأٌ أحوَى وَبدرٌ وغُصُن",2,"ن",1,0],["كن ذكورا إذا تعمدت إفكاً","فعوادي النسيان تأتي بحين",3,"ن",1,1],["كن ذيك الخدود بروق ماتنتخايل","لا كساهن شعرها شفت برق وظلام",4,"م",1,0],["كن ذاك الدهر في حكمه بلاني","لين صار الشوق مع حبه قرين",5,"ن",1,0],["كُنْ ذَلِكَ القَدَرَ العَصِيَّ عَلَى الأَذَى","وَ انْهَضْ فَإِنَّكَ جَارِفٌ مُتَجَمِّعُ",6,"ع",1,0],["كنْ ذلكَ الحاني على أولادِهِ","فهُمُ استطابوا في البلادِ نَداكا",7,"ك",2,0],["كُنْ ذا الَّذي تَنْقَدُّ مِنْكَ مَشارِقي","لِتَظَلَّ قُربي في الصَّدارَةِ ما اسْتَطَعتْ",8,"ت",1,0]]}