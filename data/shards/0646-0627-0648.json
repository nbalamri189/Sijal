{"poems":[[55,"كأنك لم تقد بعويرضات","https://www.aldiwan.net/poem30163.html","الوافر"],[65,"هي الصبابة من باد ومكتمن","https://www.aldiwan.net/poem46187.html","البسيط"],[53,"يا ناعي ابن رسول الله في البشر","https://www.aldiwan.net/poem64080.html","البسيط"],[94,"ينقضي العيش بين شوق ويأس","https://www.aldiwan.net/poem38933.html","الخفيف"],[47,"أمنك تأوب الطيف الطروب","https://www.aldiwan.net/poem10650.html","الوافر"],[101,"الشقيقتان","https://www.aldiwan.net/poem6547.html","عموديه"],[46,"ضاحكن من أسف الشباب المدبر","https://www.aldiwan.net/poem29983.html","الكامل"],[46,"أصغى إلى البين مغترا فلا جرما","https://www.aldiwan.net/poem30366.html","البسيط"],[46,"يا بعد غاية دمع العين إن بعدوا","https://www.aldiwan.net/poem30548.html","البسيط"],[54,"يا قلب قد جد بين الحي فانطلقوا","https://www.aldiwan.net/poem26817.html","البسيط"],[78,"بذمام الهوى أمت إليه","https://www.aldiwan.net/poem38857.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85558","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85386","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[130,"هذا الربيع بنور الحسن وافانا","https://www.aldiwan.net/poem805.html",""],[136,"أإن ظعن الخليط ضحى فبانا","https://www.aldiwan.net/poem54656.html","الوافر"],[159,"ناولني من كفه قهوة","https://www.aldiwan.net/poem55684.html","السريع"],[189,"أفى كل يوم لي إلى البين حسرة","https://www.aldiwan.net/poem14561.html","الطويل"],[190,"أصارني البقاء إلى زمان","https://www.aldiwan.net/poem43330.html","الوافر"],[190,"حصلت علقا ماجنا شاعرا","https://www.aldiwan.net/poem44093.html","السريع"],[208,"ناولته تفاحة بتحية","https://www.aldiwan.net/poem53109.html","الكامل"],[227,"وأهيف كالغصن لما رأى","https://www.aldiwan.net/poem55416.html","السريع"],[234,"نعت بالبين غربان","https://www.aldiwan.net/poem50762.html","مجزوء الوافر"],[234,"صبر المحب أحق بالإحجام","https://www.aldiwan.net/poem50808.html","الكامل"],[234,"أأعذر قلبي وهو لي غير عاذر","https://www.aldiwan.net/poem50956.html","الطويل"],[234,"ناولتها مثل خديها مشعشعة","https://www.aldiwan.net/poem50985.html","المنسرح"],[234,"نأت بعد ما بان العزاء سعاد","https://www.aldiwan.net/poem51154.html","الطويل"],[259,"أمل","https://www.aldiwan.net/poem24947.html","مجزوء الرمل"],[280,"أبين واشتياق وارتياع","https://www.aldiwan.net/poem25483.html","الوافر"],[280,"ناولتني العناب أنمل خود","https://www.aldiwan.net/poem25632.html","الخفيف"],[287,"بكاظمة قفوا وسلوا","https://www.aldiwan.net/poem32641.html","مجزوء الوافر"],[305,"عذبني ذو الجلال بالنار","https://www.aldiwan.net/poem45483.html","المنسرح"],[308,"وإخوان جفوني في بلائي","https://www.aldiwan.net/poem58255.html","الوافر"],[358,"ناولته وردة فاحمر من خجل","https://www.aldiwan.net/poem40226.html","البسيط"],[398,"بلغت نفسي مناها","https://www.aldiwan.net/poem53668.html","مجزوء الرمل"],[411,"صحت السلاح لشدة الحرب","https://www.aldiwan.net/poem49641.html","أحذ الكامل"],[415,"نأوا فأدنتك منهم الذكر","https://www.aldiwan.net/poem32461.html","المنسرح"],[422,"أرى هذي النياق لها حنين","https://www.aldiwan.net/poem53913.html","الوافر"],[422,"ألا من لأجفان أرقن رواء","https://www.aldiwan.net/poem54033.html","الطويل"],[435,"ناولتها وردة فافتر مبسمها","https://www.aldiwan.net/poem39852.html","البسيط"],[454,"مدى كتابك غابات وأنهار","https://www.aldiwan.net/poem983.html",""],[463,"طاف عليه بالرقمتينِ","https://www.aldiwan.net/poem55834.html","مخلع البسيط"],[473,"ناؤ كلون الناي","https://www.aldiwan.net/poem60523.html","المجتث"],[482,"كم دون مسراك من بيد وأخطار","https://www.aldiwan.net/poem15202.html","البسيط"],[482,"أقفر من سكانه المعهد","https://www.aldiwan.net/poem15224.html","السريع"],[487,"سأبكي عليكم بالدموع السواكب","https://www.aldiwan.net/poem24285.html","الطويل"],[520,"سقم الحاظ الحسان الخرد","https://www.aldiwan.net/poem12081.html","الرمل"],[568,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[591,"ناوليني الكأس في الصبح","https://www.aldiwan.net/poem17474.html","المديد"],[800,"","https://poetry.dctabudhabi.ae/diwan/poem/203852","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63935","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59419","الكامل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16776","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25308","الرجز"],[1172,"","https://poetry.dctabudhabi.ae/diwan/poem/111298","الرمل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112741","الوافر"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132826","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49995","المنسرح"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95540","الرمل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48945","الكامل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11896","المنسرح"],[1791,"","https://poetry.dctabudhabi.ae/diwan/poem/113902","الخفيف"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87858","الكامل"],[1924,"","https://poetry.dctabudhabi.ae/diwan/poem/102027","الرمل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123039","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27152","الرجز"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105067","السريع"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101700","الكامل"],[2501,"","https://poetry.dctabudhabi.ae/diwan/poem/198526","المنسرح"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140069",""],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140086",""],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74230","الوافر"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65347","الخفيف"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100828","البسيط"],[3265,"","https://poetry.dctabudhabi.ae/diwan/poem/89515","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74029","المتقارب"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103620","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126955","الوافر"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131984","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91345","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114359","البسيط"],[3916,"","https://poetry.dctabudhabi.ae/diwan/poem/122208","السريع"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75687","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86408","الطويل"],[4155,"","https://poetry.dctabudhabi.ae/diwan/poem/178113","الكامل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45927","الطويل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89576","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72518","المتقارب"],[4690,"أشعارُنا","https://www.poetsgate.com/ViewPoem.aspx?id=175472",""],[4701,"للقدس هدية عيد الميلاد","https://www.poetsgate.com/ViewPoem.aspx?id=48453",""],[4755,"نَحيَا عَلَيكَ كَأنَّنَا نُزَلَاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=199962",""],[4830,"رُبّانُ الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=207199",""],[5002,"رجع ُ الصَّدى....","https://www.poetsgate.com/ViewPoem.aspx?id=210619",""],[5145,"يا أكرم الناس لا مستثنياً أحداً","https://www.poetsgate.com/ViewPoem.aspx?id=108251",""],[5277,"أحلامُ اليقظة..في معارضة بيت لقائله","https://www.poetsgate.com/ViewPoem.aspx?id=211242",""],[5442,"نوى ولو أن الفعل وافق ما نوى","https://www.poetsgate.com/ViewPoem.aspx?id=114765",""],[5444,"حيث لهيب الجمر","https://www.poetsgate.com/ViewPoem.aspx?id=205073",""],[5460,"ناولتنى بنان كفك","https://www.poetsgate.com/ViewPoem.aspx?id=200736",""],[5533,"ذَهَبَ الذينَ أُحِبُّهمْ","https://www.poetsgate.com/ViewPoem.aspx?id=176668",""],[5628,"حديث العشق","https://www.poetsgate.com/ViewPoem.aspx?id=178443",""],[5691,"كتاب وريشة","https://www.poetsgate.com/ViewPoem.aspx?id=206594",""],[5725,"هاك قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=177424",""],[5818,"يقولون الكلام له مردّ","https://www.poetsgate.com/ViewPoem.aspx?id=193121",""],[5829,"تلك الفتاة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=190585",""],[1920,"نظارة الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=191732",""],[5953,"الله أكبر أكبر الله","https://www.poetsgate.com/ViewPoem.aspx?id=93797",""],[5956,"عندي وعند كل شاب طباع الهر","https://www.poetsgate.com/ViewPoem.aspx?id=209041",""],[6067,"بائع العسلية","https://www.poetsgate.com/ViewPoem.aspx?id=177158",""]],"verses":[["نَأَوا عَنّي فَضَعضَعَني نَواهُم","وَما كانوا فَقَد قَطَعوا النِياطا",0,"ط",2,0],["ناوَلْتُهُ طَرَفَ الذّكْرى فأقْلَقهُ","شوْقٌ يُصَرِّحُ عنهُ لَوْعَةُ الحَزَنِ",1,"ن",1,0],["نأوي إلى بيت مجدٍ لا كِفاءَ له","أوفت به السُّورة العُليا من السور",2,"ر",1,0],["ناولتني الحَيَاةُ كأساً دِهاقاً","بالأَماني فما تناولْتُ كأْسي",3,"س",2,0],["نَأَوا بِأَوانِسٍ يَرجِعنَ وَحشاً","إِذا فوجِئنَ بِالشَعَرِ الخَضيبِ",4,"ب",1,0],["ناوليني الثوب من مشجبه","ومن الديباج هاتي أروعه",5,"ع",2,0],["ناوَشنَ خَيلَ عَزيمَتي بِعَزيمَةٍ","تَرَكَت بِقَلبي وَقعَةً لَم تُنصَرِ",6,"ر",1,0],["نَأَوا فَظَلَّت لِوَشكِ البَينِ مُقلَتُهُ","تَندى نَجيعاً وَيَندى جِسمُهُ سَقَما",7,"م",2,0],["نَأَوا عَنِ المَصرَخِ الأَدنى فَلَيسَ لَهُم","إِلّا السُيوفَ عَلى أَعدائِهِم مَدَدُ",8,"د",1,0],["نَأوا بِلَيلٍ فَزَمّوا كُلَّ يَعمَلَةٍ","وَيَعمَلٍ جَمَلٍ في أَنفِهِ الحَلَقُ",9,"ق",1,0],["ناولَ الكأسَ واسْتمالَ بلحظٍ","فَسقَتْني عَيناهُ قَبلَ يَديهِ",10,"ي",2,0],["نأوله حتى تقول بينه","وبين طريق العلم فهو المقدم",11,"م",1,0],["نأوا بنديمي البر عني فلَيتَني","فداء له مِمّا أصابوا وأَوقعوا",12,"ع",3,0],["ناولاني باللّه ديوانَ شوقي","لأراه كعهده ويراني",13,"ن",2,0],["ناولتها العود والتقبيل يتبعه","حتى استفاقت تنادي ما الذي كانا",14,"ن",2,0],["نأوك وقد نأوك ضحى بأحوى","كلفت به وقد شغف الجَنانا",15,"ن",2,0],["ناولَني مِنْ كَفِّهِ قَهْوَةً","تُضيءُ منْ نارٍ ومِنْ نُورِ",16,"ر",1,1],["نَأَوا والأسى يُجرى غُروبَ مَدامِعي","على الخد حتى كدت فيه أغوص",17,"ص",1,0],["نأوا عن كل مكرمة فصاروا","حديثا للئام وللكرام",18,"م",1,0],["ناولته شيئا فأزرى به","وقال زدني ضعف وزناته",19,"ت",2,0],["ناولتُه تفّاحةً بتحيَّةٍ","يوماً فقال ولِم بها تخديشُ",20,"ش",1,1],["ناولني من يده وردة","كأنها من خده المشرقي",21,"ق",2,0],["نَأَوا وضَمائِرُ الأحدا","جِ آرامٌ وغِزْلانُ",22,"ن",1,0],["ناولتَنيه رافعا قدري به","ومبيّنا للناس عقد ذمامي",23,"م",2,0],["نَأَوْا والأسى عنَّي بهم غير مُنْتَأٍ","وودّعتهم والحبُّ غير مودّعِي",24,"ع",2,0],["ناولتها مثل خَدَّيها مشعشَعةً","صِرْفاً كأنّ سناها ضوء مقباس",25,"س",1,1],["نأوا بعد ما ألقتْ مكايِدها النوى","وقرَّت بهم دار وصحَّ ودادُ",26,"د",1,0],["ناوليني جُزْءَ وَعْدٍ","بعد يوم، جَرّبيني",27,"ن",2,0],["نَأَوْا حَقّاً ولا أَدْرِي أيُقْضَى","تَلاقٍ أوْ يُباحُ لنا اجْتِمَاعُ",28,"ع",1,0],["نَاوَلتني العُنّاب أنْمُلُ خَوْد","خَضَبَتْها بِحُمْرَة العُنّابِ",29,"ب",1,1],["نَأَوا فَأَقامَ في قَلبي ال","هَوى وَالوَجدُ وَالوَجَلُ",30,"ل",1,0],["ناوَلَنَهُ المَسحَ ثُمَّ قُلنَ لَهُ","بَيِّضهُ بِالنَهرِ نَهرِ بَشّارِ",31,"ر",1,0],["نأوا عنى وما سمحوا بقرضٍ","فها أنا لا أدان ولا أداني",32,"ي",1,0],["ناوَلته وَردة فَاِحمر مِن خَجل","وَلاحَ لُؤلؤ ذاكَ المَنظر النَضرِ",33,"ر",1,1],["ناوَشَتهُ عَطَّشَتهُ","جُرأَةً في مُلتَقاها",34,"ا",3,0],["ناولْتُهُمْ قَليي وقلتُ لُمْ","هّذا المُسئُ فَقَطِّعوا قلبي",35,"ب",2,0],["نأَوْا فأدنَتْكَ منهُمُ الذِّكَرُ","ومثَّلتْهُم لقلبِك الفِكَرُ",36,"ر",1,1],["نأَوْا عنها فكان لها التفاتٌ","إليهم تارةً ولها انثناء",37,"ا",2,0],["نأوا فحنيني لا يزال إليْهم","ويا ويحَ دانٍ يحنُّ لنائي",38,"ي",1,0],["ناولتها وردةٌ فافتر مبسمها","عن الأقاح وأبدت نرجس المقل",39,"ل",1,1],["ناولتنيها بكف الود جوهرة","لها على الدر أضواء وأنوار",40,"ر",1,0],["ناولها خالَها أبوها","بيضاءَ ملساءَ الجانبينِ",41,"ن",1,0],["ناؤٌ كَلَونِ النايِ","لِغادَةٍ غَيداءِ",42,"ا",2,1],["نأوا فلولا المنى ما عشتُ بعدَهمُ","وكم أعيشُ على وعدٍ وانظارِ",43,"ر",1,0],["نأوا فلا الدارُ كعهدي بها","ولا أحبائي كما أعهَدُ",44,"د",1,0],["نأوا فبقلبي من حراقهم","وهو من الوجد المبرح كارب",45,"ب",1,0],["ناولتنيها فلم أدر إلى","أي شمس منهما طالت يدي",46,"د",2,0],["نَأَوا بِخَريدَةٍ غَيداءَ رَأدٍ","وَنيمٍ لِلغَواني أَيِّ نيمِ",47,"م",1,0],["ناوليني الكَأس في الصُّبَحِ","ثُمَّ غنِّي لي على قَدَحِي",48,"ح",2,1],["ناولتني ما أسأرته بكأس","كمشيبي ونشوة كالشباب",49,"ب",1,0],["ناوَشُوهُ دونَ الفراتِ ولولا","سابقُ الحكم ما أَطاقوا النِّواشا",50,"ش",2,0],["ناومت فيها قطبها ومدامتي","دمعي ونقلي حسرتي وتفجّعي",51,"ع",2,0],["ناوَلَنيهِ مِثلُهُ في حُسنِهِ","فَحَلَّ في قَلبِيَ عَقدَ الكُرَبِ",52,"ب",1,0],["ناوَشْنَ مِنْ آجِنِ ماءٍ شِرْبا","حائِرَ غَيْل أَوْ يَرِدْنَ جُبّا",53,"ب",2,0],["ناوع أحيى بدبره","سنة الماضين مثله",54,"ه",1,1],["نأوا عن ساحة العصيان واستعذبوا","فيك التبتل والسماعا",55,"ع",2,0],["نأوا عِّني وعندهم فؤادي","وِغبتُ ولم يَغِب عنهم ودادي",56,"د",2,0],["ناؤا وفي كلّ هودج لهُمُ","غيداء جيداء كاعب فنقُ",57,"ق",1,0],["نأوأتنا لم ننل من وقفة","نحتسىِ الأَشعار من ستّ سنين",58,"ن",1,0],["ناؤا بأَعباء النوائب وانثنوا","يتعبدون إلى ذوي الإيسار",59,"ر",1,0],["ناوَلَني مَن أُحِبُّ نَرجِسَةً","أَحسَنَ في ناظِري مِنَ الوَردِ",60,"د",1,1],["ناولوني يدا بها أتسامى","إن قلبي لبالعلا مستهام",61,"م",1,0],["ناوَءتَهُ فَبَلَوتَ فيهِ قائِداً","لِلرَأيِ لَم يُعطِ القِيادَ لِقائِدِ",62,"د",1,0],["ناوحتني الورق شجواً","فوق أغصاني تدلى",63,"ل",2,0],["نأوا عني وعَنّ لهم فؤادي","يُنادي كلما عنّت همومي",64,"م",2,0],["نَأوا وَلَم أَشعُرهُمُ فَما دَرَوا","أَنَّ عَلَيهِم مِن ضَميري حارِسا",65,"س",2,0],["ناولني كأساً فناولته","كأساً فغنيت وغناني",66,"ن",2,0],["نأوى لخير حمى بعدلك كله","أمن وما للجور فيه جوار",67,"ر",1,0],["ناولني الماس بدرها بيدٍ","عنابها من طريف أنقال",68,"ل",1,0],["ناولته سوسنة غضة","معطارها أزكى من الند",69,"د",1,0],["ناولنيها فقلت دعني","لا ارتضيها فكيف أشرب",70,"ب",1,0],["نأوا عَنا فَفي الأَحشاء جمر","وَفي الأَجفان أَنهار غزار",71,"ر",1,0],["ناولتني يمينهُ ياسمينا","وعلى وجنتيه وردٌ مصونُ",72,"ن",1,0],["ناؤوا زماناً بعبء الظلم واحتملوا","من المذلة عبأً غير محتمل",73,"ل",1,0],["ناول برد السَقط","من فيه عين السِقط",74,"ط",1,0],["نَأوا فَنأى الأُنسُ عَن حَيِّنا","وَأَمسَت رُبوعُ الهَوى خاليَه",75,"ي",2,0],["نأوا بصموت الحجل عاطرة الشذا","بمبتلة الأعطاف معسولة اللمى",76,"م",2,0],["نأوا عن قاع الوعساء وهنا","بهم ياليت لاشط النزوح",77,"ح",1,0],["ناوله للطفل الصغير وقل له","اقرأ وميز أين هي الباء",78,"ا",2,0],["ناولتُه زَهرةً كَيما تَفوز بِهِ","وَكَيفَ أُهدي إِلى غُصنِ النَقا زَهَرا",79,"ر",2,0],["نَاوَلتَنِي كَأسَ آتَايٍ مُعَنبَرَةٍ","صَفرَاءَ فِيهَا انجَلَت لِلنَّفسِ آمَالُ",80,"ل",1,1],["ناولني خمرا لأشربها","كأنما ناولني جمرا",81,"ر",2,1],["نأوا وَرجونا ان يدوموا عَلى الهَوى","فَسلو الجَفا سَيفاً وَقَد ضَربوا صَفحا",82,"ح",2,0],["نأوا فتعرفت المنازل بعدهم","وما كنت لولاهم لها أتعرف",83,"ف",1,0],["ناولته كأسِي وكسرُ جُفونِهِ","يُوحي إليَّ أن ارتقبهم واصْطَبرْ",84,"ر",1,0],["نَأَوا فَنَأَى قَلبي وَشَخصي حاضِرٌ","وَوَدَّعَني الطَرفُ عِشيَةَ وَدَّعوا",85,"ع",3,0],["ناؤوا ةَناءَ زَمانُهُم","عَيني عَلَيهِم جارِيَه",86,"ي",2,0],["نأوا لا نأوا عن سواد العراق","وكانوا السواد من الناظر",87,"ر",1,0],["نأوي إليها منْ مَواجعِنا التّي","باتَتْ تُعَربِدُ في سَما الأوْطان",88,"ن",1,0],["نَأوي إلى أبديَّتينِ..بلحظةٍ","وشتاتُنا فينا سماءٌ حاشدةْ",89,"د",2,0],["نَاوَلْتَ لِلجُهَلاءِ أَمْرَكَ فانبَرَوْا","وكأنَّهُم -عَن شَعبِكَ- الوُكَلاءُ",90,"ل",3,0],["نأَوا فأبرى حنايا القلبِ نأيُهمُ","واستمطرَ العينَ من آماقِها قَطرا",91,"ر",2,0],["نأَوْا دونَ أَوبٕ وغِبْتُ أناَ","ورايةُ صَمْتي غَدتْ تُرْفَعُ",92,"ع",1,0],["نأوي إلى كهفك المأمون ساحته","نعم فهيئ لنا من أمرنا رشداً",93,"د",2,0],["نأوي لأطيافٍ يحاوطها الأسى","ونجومِ ليلٍ كلُّها متخاذلهْ",94,"ل",2,0],["نأوا وثنوه ظامياً وبجفته","مسيل لو أن الركب وارده توي",95,"و",2,0],["ناولتُها بيمينِ البَوحِ أغنيةً","بلحنِها أبصرَ الأعمى وأشجَانا",96,"ن",2,0],["ناولتنى بنان كف","ك بالأمس نرجسا",97,"س",2,1],["نَاؤُوا فَناءَ الحبُّ عن جَنَباتِنا","ولربَّما عَادُوا فَعادَتْ تُورِقُ",98,"ق",1,0],["ناوليني من خمرةِ الحبِّ كاسأ ً","فخمورُ الحاناتِ ما أسكَرتْني",99,"ن",2,0],["ناوَلوني صَحيفَةً كُتِبَتْ فيها","سُطورٌ جهِلْتُها مخْتومَهْ",100,"م",2,0],["ناوبَتْني في هجره زفرات","فيح نار من الجِنوب تهيلُ",101,"ل",1,0],["نأوا عنّي وبعض النأي لطْفٌ","ولطْف اللهِ للآلامِ سدّ",102,"د",1,0],["ناوشت أحزاني وقلت ترفقي","وجوابها: ما للشجون رضاءُ",103,"ا",2,0],["ناولتهُ نظّارتي فكأنّما","ملك السّماء وأرضها فتبسّما",104,"م",2,1],["ناواه في أسمائه فكفى بهم","يابن الخصيب بكل من يخشاه",105,"ا",2,0],["نأوي لطيبتك المجيدة ثم قد","ننسابُ كالسكينِ في نحريكِ",106,"ك",1,0],["ناولتْني النقودَ، ناولتُها أم","سي، فقالت: \"يا عَمِّ، هات البقيةْ!\"",107,"ي",2,0]]}