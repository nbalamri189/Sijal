649,"ركب الخير","https://www.poetsgate.com/ViewPoem.aspx?id=39018",""],[5704,"أغضبتموها٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=204222",""],[5718,"\"إلهى\"","https://www.poetsgate.com/ViewPoem.aspx?id=213785",""],[5732,"ذكرتني يا زين","https://www.poetsgate.com/ViewPoem.aspx?id=177946",""],[5736,"اغضب","https://www.poetsgate.com/ViewPoem.aspx?id=208475",""],[5957,"أحتاج أن تكون لي الصديق","https://www.poetsgate.com/ViewPoem.aspx?id=183295",""],[5977,"ابتسامة رغم الألم","https://www.poetsgate.com/ViewPoem.aspx?id=213251",""],[6142,"يا أول الناس للإسلام مرتبة","https://www.poetsgate.com/ViewPoem.aspx?id=155742",""],[6142,"أغضض اللحظ عن محبك غمزا","https://www.poetsgate.com/ViewPoem.aspx?id=155732",""],[243,"أراها غدا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68171&r=&rc=163",""],[6213,"بحار الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85491&r=&rc=94",""],[6259,"ألمتْ ودوني من تهامة بيدها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59367&r=&rc=15",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""]],"verses":[["أُغضي عَلى خِدَعِ النَوا","ئِبِ أَو تُظَنُّ بي الظُنونُ",0,"ن",1,0],["أَغضى لَها المُتَشَدِّقونَ وَسَلَّموا","لِهَديرِ شِقشِقَةِ الفَنيقِ المُقرَمِ",1,"م",1,0],["أَغضى لَهُم وَأَثارَ لَي","ثَ الغابِ يَقتَنِصُ النُفوسا",2,"س",2,0],["أَغضَيتُ عَن وَجهِ الحَبيبِ تَكَرُّماً","وَأَرَيتُهُ أَنَّ الجُفونَ كَواسِرُ",3,"ر",1,0],["أُغضي عَنِ المَرأى الأَنيقِ زَهادَةً","فيهِ وَأَدفَعُ لَذَّتي بِالراحِ",4,"ح",1,0],["أَغُضُّ جِماحَ الوَجدِ بَينَ الجوانِحِ","بِدَمعٍ مِنَ العَينِ الطَّليحَةِ سافِحِ",5,"ح",1,1],["أغُضُّ لهُ طَرْفي حَياءً منَ العُلا","وعَطفاً عليكُمْ والأواصِرُ تُعْطِفُ",6,"ف",1,0],["أَغَضِبتَ حينَ جَعَلتُ شَعرَكَ مُذهَباً","وَكَذبتُ فَهوَ كَما عَلِمتَ مُرَصَّصُ",7,"ص",1,0],["إغضاب نفسك فيما أنت فاعله","رِضى مليكك فأغضبها ولا تزِدِ",8,"د",1,0],["أغضبَني بالأمس ما سُمتَني","فأرضني منهُ ولا تَغْضَبِ",9,"ب",1,1],["إغضاؤُهُ عمَّن يُقرُّ بذنبه","وحلول نقمته بكلِّ مُداجي",10,"ج",2,0],["أغضبني الشعر فعاقبتُهُ","بوجهها فاعتدَّهُ حبسا",11,"س",2,0],["أغْضبك الكسعُ بالهجاء على","خزَّامةٍ للغضاب خشّاش",12,"ش",1,0],["أغضبه حتى طغا جهله","فلم يقل في لومه قذعه",13,"ع",2,0],["أُغضي الجفونَ عن السُّوءَى مراقبةً","لما يكونُ من الحُسنى وما كانا",14,"ن",2,0],["أغضَى أبو بكر على الهونِ","كأَنَّهُ ليسَ يبالينِي",15,"ن",2,1],["أغضبتُهُ فهجاني غيرَ منتصرٍ","كعاركٍ أنفه بالأرض غضبانا",16,"ن",2,0],["أَغضَيتُ ضَنّاً بِعِرضي أَن أَلَمَّ بِهِ","وَقَد يَروقُ العَمى لِلحُرِّ وَالصَمَمِ",17,"م",1,0],["أَغضَيتُ عَن بَعضِ الَّذي يُتَّقى","مِن حَرَجٍ في حُبِّهِ أَو جُناح",18,"ح",1,0],["أَغضِ عَنِ المَرءِ وَعَمّا لَدَيه","أَخوكَ مَن وَفَّرتَ ما في يَدَيه",19,"ي",2,1],["أُغضي إِذا صَرفُهُ لَم تُغضِ أَعيُنُهُ","عَنّي وَأَرضى إِذا ما لَجَّ في الغَضَبِ",20,"ب",1,0],["أَغضى عَلَيكَ جُفونَ شُكرِكَ إِنَّها","ثَقُلَت عَلَيَّ لِجودِكَ المَوجودِ",21,"د",1,0],["أغضبْتَهُمْ لمَّا رثيتُكَ فاغتدى","كلٌّ لهُ في العتْبِ سمٌّ منقعُ",22,"ع",1,0],["أغْضَبْتَني وغصبْتَ ديواني الذي","أنفقْتُ فيه شبيبتي وزماني",23,"ي",1,1],["أغَضِبْتُم إذ بَنَى إخوتُكم","في قباءٍ مَسجِداً يهدِي الحَيَارى",24,"ر",2,0],["اغْضَبْ دُرَيْدُ أوِ ارْضَ لستَ كمالكٍ","في القومِ إذ يَرضَى وإذ يَتَغَضَّبُ",25,"ب",1,0],["أَغَضَّت عَلَيكَ الشامَ قَحطانُ بِالقَنا","بِأَقطارِها عَن ظاعِنٍ وَمُقيمِ",26,"م",1,0],["أغُضُّ الجفونَ إذا ما بَدَتْ","وأكنّي إذا قيل لي سَمِّها",27,"م",3,0],["أَغْضَبْتُ في حُبِّها أَهْلِي فَمَا بَرِحُوا","إِلْباً عَلَيَّ وَكَانُوا لِي مِنَ الْعُدَدِ",28,"د",1,0],["أغضاضه ياروض إن","أنا شاقني فشممت وردك",29,"ك",1,0],["أَغُضّ لَها طَرفي وَأغضي عَلى القَذا","وَلا سَخطٌ حَسبي رِضاً وَقَبولُ",30,"ل",1,0],["أغضيتُ جفنَ العين فيه على القذى","وحملتُ فيه مضاضة التشريد",31,"د",1,0],["أُغضِي الجفونَ عن السوأى مراقبة","ً لمِا يكون من الحُسنى وما كانا",32,"ن",2,0],["أغضيت حلما فناموا عنك واحتملوا","ما غرهم بك إلا الحلم لا الحلم",33,"م",1,0],["أغضيت حلما ولم تعجل بسفك دم","حتى أتوك بعذر غير مختلق",34,"ق",1,0],["إِغضاءُ قَيسٍ في شَجاعَةِ وائِلٍ","وَسَخاءُ مَعنٍ في وَفاءِ سَمَوأَلِ",35,"ل",1,0],["أغضّ طرفي عن الملاح","مخافة الحادث المتاح",36,"ح",1,1],["اغضب لدينك وامنع من تهضّمهِ","فقد هوى كلّه للويل والعطب",37,"ب",1,0],["أُغضي عَليها وَالإِباءُ يُهِبُّ بي","قِوَّض خِيامَكَ عَن دِيارِ الهونِ",38,"ن",1,0],["أغضَينَ عن سيِّئاتي","لأنها حَسَنات",39,"ت",1,0],["أَغضَت وأَرضَت بما أَهوى وعفَّتُنا","تأبى لنا مأثماً في الحُبِّ يُجتَرَحُ",40,"ح",1,0],["أغضى زماناً عَلى ما كان مُهتضماً","منْ حقّه عند أهلِ الشَّكِّ والرّيب",41,"ب",1,0],["اِغضُض عِنانَكَ هَذا مُنتَهى السَفَرِ","وَاِمدُد بَنانَكَ هَذا مُجتَنى الثَمَرِ",42,"ر",1,1],["أغضَبَهُ أن أذمَّ دَهري","كأنَّ ذاكَ الكريم دهرُ",43,"ر",1,0],["اغضب على الهاجس المُردي ومُهجِسه","فهو الجدير بغيظٍ دَأبُه الرَأَب",44,"ب",1,0],["أَغَضَّ مِن الوَردِ الجَنيِّ خُدودها","وَأَرشَق مِن شَرقِ الرِياضِ قُدودُها",45,"د",3,0],["أغضيتُ منكَ على جمرِ الغَضَا زمناً","وخلتُ أنَّ الرِّضا بالجَوْرِ يُرضيكَا",46,"ك",2,0],["أغضيْتُ عيني عنهما حتى لقد","خلنا بجهل أنها عمياءُ",47,"ا",2,0],["أغْضوا على جَوْرِ المَنون وطالما","أغْضى للحْظِهمُ الخميسُ المعْلم",48,"م",1,0],["أغضى الجفون ولم يكن عن حادثٍ","يُغْضي ولا عن ناجِمٍ يَتَلَوَّمُ",49,"م",1,0],["أَغضى فَآمَنَ خائِفاً","لَولاهُ أَصبَحَ تالِفا",50,"ف",2,1],["أُغضي وَلَو أَنّي أَشاءُ كسوتُهُ","جَرَباً وكنتُ لَه كشوكِ العرفَطِ",51,"ط",1,1],["أَغضيتَ عَنهمْ فما اِرتابوا وما فطِنوا","إِنّ التغاضِيَ إِمْلاءٌ وإِهوانُ",52,"ن",1,0],["أُغضِي وَكَم أغضَى الفتى","على قذىً وأطْرَقا",53,"ق",2,0],["أَغضَت عَنِ الناسِ عَيني ما تَرى حَسَناً","في الناسِ حَتّى تَراهُم آخِرَ الأَبَدِ",54,"د",1,0],["أَغضى الزَمانُ لَهُ عَلى عَينِ الرِضى","وَعَلَيهِ حارِسٌ وَرَقيبُ",55,"ب",1,0],["اغْضَبِي إن أردب وارضَيْ فعندي","عَزَماتٌ مثلُ السيوفِ القضابِ",56,"ب",1,0],["أَغضَبَها الماءُ حينَ مازَجَها","فَأَزبَدَت في كُئوسِها أَنَفا",57,"ف",2,0],["أغضبتموه عليكم وعداتكم","أولى بغضبته وفادح حمله",58,"ل",2,0],["أغضبوه تجارة ثم دارو","ه عسى يعرفون أن يرضوه",59,"و",2,0],["أُغضي على حُرَقِ الغرام وأُطرقُ","وأخافُ رَوعات الفراق وأَفرَقُ",60,"ق",1,1],["أغْضَبْتُ مَنْ أهْوَى على السُّكْرِ","وقلتُ ما قلتُ وما أدري",61,"ر",2,1],["أغَضُّ غَضيضُ ألْحاظٍ وطَرْفٍ","كَساني جفْنُهُ ثَوْبَ اِصْفِرارِ",62,"ر",1,0],["اِغضُضي أَو صَعِّري خَدَّكِ لي","وَخُذي غَيري عُشاقاً جُدادا",63,"د",2,0],["أغضي علىالغضب الذي أرضى به","منه ويجفو في العتاب والطف",64,"ف",1,0],["أَغضَضت طَرفكَ رَأفَةً كَيلا تَرى","في حال مَصرعكَ الأَليم نَوائِبي",65,"ب",2,0],["اغضبوا إن شعرتم بخطاءٍ","وانفروا منه نفرة المتبرّي",66,"ر",2,0],["أَغضَبَ الْعاذِلَ فيهِ أَنَّني","لمْ أَبِعْ في حُبِّهِ رُشدي بِغَيْ",67,"ي",1,0],["أغضضت طرفك عن ربوعك بعدما","كنت الذي لصيانها لا يرقد",68,"د",1,0],["أغضَّ الشبيبة عنِّي إليك","فقضِّ بزهوك ريعانَها",69,"ن",3,0],["اغضض الطرف لانشم كل برق","ربما الفتك حيث لمع البروق",70,"ق",1,0],["أَغضَبتَ باكوسَ فَاِحذَر شَرَّ نِقمَتِهِ","أَو فَاِملأِ الكَأسَ تَأَمَنهُ وَلا تَثُرِ",71,"ر",1,0],["أغضبَ اللَه إذ أبى أن يلبي","أمرَ ربِّ العُلا عظيمِ الشانِ",72,"ن",1,0],["أَغضَفَ رِئبالٍ خِدَبٍ فَدغَمِ","مُنتَشِرُ العُرفِ هَضيم هَيصَمِ",73,"م",1,0],["أغضُّ الطرف دونك من حياءٍ","لبهجةِ ذلكَ الوجهِ الحييِّ",74,"ي",1,0],["أغضفُ عَطافٌ على الأصواتِ","يهوي هُوِيَّ الكوكبِ المُنصاتِ",75,"ت",1,0],["أغضف عطاف على الاصوات","يهوي هوي المُنصات",76,"ت",1,0],["أَغُضُّ عنه وبرئي في ملاحظه","خوفاً على ورد خديه من الألم",77,"م",1,0],["أغض على القذى جفناً واطوي","على نار الجوى قلباً عليلا",78,"ل",2,0],["أَغضيت عَنهُ كَأنني لَم أَستَمع","ماذا يَقول وَلا وَعيت كَلاما",79,"م",2,0],["أَغضى عَلى حَدِّ القَذى إِذ جِئتهُ","وَبأنفِهِ مِمّا أَقولُ وسومُ",80,"م",1,0],["أَغضت وَما تَغضي الجُفون عَلى القَذى","لَو تَستطيع لِشَجوِها كِتمانا",81,"ن",2,0],["أغضب لربك إن اللّه يغضبه","ظلم الظلوم وقد أحسبك غضبانا",82,"ن",2,0],["أغضضت ناظرتي عنها وقلت لها","ألقي القناع على الخدين واشتغلي",83,"ل",2,0],["أغضت وكم عقدت للمجد ألوية","فرق السماك وحلت مشكل العقد",84,"د",1,0],["أغَضبِت أن بات ابن أُمّكُمُ","بهم وأنّ أباكمُ سقطُ",85,"ط",1,0],["أغضُ شعاعي أن يصادف أرمداً","وأكتم ناري أن تصيب هشيما",86,"م",2,0],["أغضُّ الطرف عن ربي حياءً","لما أسلفت من ماضي الذنوب",87,"ب",1,1],["أُغضي ولا أُضيع وقتي بكم","لأن وقتي منكم أثمن",88,"ن",1,0],["أغضُّ طرفي حتى لا أشاهدهم","لكن أرى قدمي سهواً بهم عثرا",89,