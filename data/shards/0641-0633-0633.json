{"poems":[[290,"هنيئا عزت المختار فاسعد","https://www.aldiwan.net/poem39419.html","الوافر"],[466,"أظن ظلام الحظ حان نصوله","https://www.aldiwan.net/poem15389.html","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27840","المنسرح"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137003",""]],"verses":[["فسس بالعدل أمتها وشمر","وسدد والتمس أسمى الخصال",0,"ل",1,0],["فسُسْتَ له الصقع العيد بصائبٍ","من الرأي مَقرونٍ بعزمٍ مُظفَّرِ",1,"ر",1,0],["فس سَدلها نعيم","يعطيه مفضلُ",2,"ل",1,0],["فسس امر لبنان سياسة حازم","وانت الى كل القلوب محبب",3,"ب",1,0]]}