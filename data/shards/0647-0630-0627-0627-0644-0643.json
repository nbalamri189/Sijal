{"poems":[[79,"مولاي ثانية من ليلك انصرمت","https://www.aldiwan.net/poem36105.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54580","الكامل"],[105,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""],[128,"هل تذكرين وأنت من غزلانه","https://www.aldiwan.net/poem23738.html","الكامل"],[369,"ذكر المعسكر صاحبي ذكرا","https://www.aldiwan.net/poem60913.html","أحذ الكامل"],[382,"يا فضل للفضل معنى أنت شارحه","https://www.aldiwan.net/poem66883.html","البسيط"],[438,"أظنه حاذر سلوانا","https://www.aldiwan.net/poem12739.html","السريع"],[463,"كثر فيك اللوم","https://www.aldiwan.net/poem55885.html","مجزوء الرجز"],[473,"ما أحرج الباب بل ما أرحب الوادي","https://www.aldiwan.net/poem59455.html","البسيط"],[505,"وحي السماء منزل ببيوتنا","https://www.aldiwan.net/poem37804.html","الكامل"],[505,"جاء البشير ليعقوبي بيوسفه","https://www.aldiwan.net/poem38078.html","البسيط"],[505,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[563,"هذا الكثير الواحد","https://www.aldiwan.net/poem34631.html","مجزوء الكامل"],[567,"هذا الكريم حبيب ابن الجدي على","https://www.aldiwan.net/poem52691.html","البسيط"],[567,"هذا الكتاب الكبير النفع مع صغر","https://www.aldiwan.net/poem52728.html","البسيط"],[567,"لولا التفاوت في الأخلاق والأدب","https://www.aldiwan.net/poem52810.html","البسيط"],[567,"ماذا جلبت لنا يا ليلة العيد","https://www.aldiwan.net/poem52846.html","البسيط"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103080","الكامل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110397","البسيط"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110422","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70680","البسيط"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133839","الكامل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130614","الكامل"],[1553,"","https://poetry.dctabudhabi.ae/diwan/poem/144584","البسيط"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/78019","الكامل"],[1794,"","https://poetry.dctabudhabi.ae/diwan/poem/145410","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121230","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202730","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205056",""],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134202","الكامل"],[3102,"","https://poetry.dctabudhabi.ae/diwan/poem/113899","البسيط"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126279","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89052","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62874","المنسرح"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110139","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123486","الكامل"],[4297,"","https://poetry.dctabudhabi.ae/diwan/poem/102204","الرجز"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135124","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72932","المجتث"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72913","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72926","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72866","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120405","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120365","الكامل"],[4718,"يكفيه قلبي ياهوا البال ماجاه","https://www.poetsgate.com/ViewPoem.aspx?id=137086",""],[4718,"الجرح","https://www.poetsgate.com/ViewPoem.aspx?id=137100",""],[4869,"يامدوّر الزله","https://www.poetsgate.com/ViewPoem.aspx?id=151626",""],[5009,"مناجاة ليلة القدر","https://www.poetsgate.com/ViewPoem.aspx?id=24372",""],[5057,"أبي","https://www.poetsgate.com/ViewPoem.aspx?id=207363",""],[5150,"ارحلْ ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203386",""],[5280,"رثاء","https://www.poetsgate.com/ViewPoem.aspx?id=190764",""],[5281,"وفاءُ التَّاريخِ","https://www.poetsgate.com/ViewPoem.aspx?id=200243",""],[5596,"لطف الاعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=206379",""],[5690,"هذا الكتاب أتى بفضل محمدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=172211",""],[5693,"رباعيات . خفقات قلب.","https://www.poetsgate.com/ViewPoem.aspx?id=34848",""],[5694,"من العايدين","https://www.poetsgate.com/ViewPoem.aspx?id=132100",""],[5717,"هذا الكتاب معجز مشاهد","https://www.poetsgate.com/ViewPoem.aspx?id=170606",""],[5956,"من الجلوس اللّا سليم ظهر نجلي اْحدَودَب","https://www.poetsgate.com/ViewPoem.aspx?id=194784",""]],"verses":[["هَذَا الْكَمَالُ فَإِنْ تُلْمِمْ بِسَاحَتِهِ","وَسَلَّمَ اللهُ مِنْ غَوْلِ السُّرَى سَلِمَتْ",0,"ت",1,0],["هَذَا الكِتَابُ ذَخِيرَةٌ نَدَرَتْ","هِيَ مِنْ أَجَلِّ ذَخَائِرِ الكُتُبِ",1,"ب",1,0],["هذا الكتابُ إليكَ مِنْ زَنْزانَةٍ","مَقْرورَةٍ صَخْرِيَّةِ الجُدْرانِ",2,"ن",1,0],["هذا الكمان فأين عازفه الذي","يبكي حطام الكوخ شجو كمانه",3,"ن",2,0],["هذا الكمالُ على الحقيقةِ لا","ما كان يُذْكَرُ قبْلَه ذِكرا",4,"ر",2,0],["هذا الكمال الذي أبقيتَ منطقه","يثني عليك وشاهدْهُ جوارحه",5,"ح",2,0],["هذا الكمالُ قد حَوى سعدَهُ","يا بدرُ لن يُعْقِب نُقْصانا",6,"ن",2,0],["هذا الكثيب الفرد من","نجدٍ وهذا العلَمُ",7,"م",1,0],["هذا الكمال الذي تجري له أبداً","أبرار بري بلا ثوبٍ ولا زاد",8,"د",1,0],["هذا الكَمالُ الأَحْمَدِيُّ تلامَعَتْ","أَنوارُهُ وجَلا هُداهُ الكُمَّلُ",9,"ل",1,0],["هذا الكريمُ المُحَيَّا كم به فُرِجَتْ","من كُربَةٍ صعبَةٍ عن قلبِ مَكْروبِ",10,"ب",1,0],["هذا الكتابِ الذي جاءَ البشيرُ به","مَحَحَّةٌ في طريقِ الله سمْحاءُ",11,"ا",2,0],["هذا الكثير الواحدُ","فافرح به يا واجدُ",12,"د",1,1],["هذا الكريمُ حبيبُ ابنُ الجُديِّ عَلى","سِنِّ المسيحِ إلى إكليلِهِ ذَهَبا",13,"ب",2,1],["هذا الكتابُ الكبير النفعِ مع صِغَرٍ","في حَجْمهِ فهْوَ للسارينَ مِصباحُ",14,"ح",1,1],["هذا الكريمُ السَّليمُ القلبِ من دنَسٍ","وَهْوَ الصَّفِيُّ البرِيُّ النَّفسِ من رِيَبِ",15,"ب",1,0],["هذا الكريمُ الذي كانت مواهِبهُ","تُحيطُ بالنَّاسِ مثلَ العِقدِ بالجِيدِ",16,"د",1,0],["هذا الكتاب إذا تنافى ريبه","والصاد عين قام بالأعيان",17,"ن",1,0],["هذا الكتابُ بهِ ترقى بصائرنا","فهو الجديرُ بأن ندعوهُ معراجا",18,"ا",1,1],["هذا الكتاب الذي هام الفؤَادُ بهِ","يا ليتني قلمٌ في كفّ كاتبِهِ",19,"ه",1,1],["هذا الكريم الذي تشفيك رؤيتُه","مِنْ كلِّ داءِ ومن غمٍّ ومن حزَنِ",20,"ن",1,0],["هذا الكتاب وكل قولٍ قوله","فيه وهذاك البيان المفرد",21,"د",1,0],["هذا الكتاب هدية مني لكي","أعطى كتابي سيدي بيميني",22,"ن",2,0],["هذا الكلامُ الذي تَذْكو غَزالتُهُ","يغشى سَنا البدرِ في طَرْف الدُّجى الساجي",23,"ج",2,0],["هذا الكتاب وذا الرسول محمد","والحافظون لعلمه النساك",24,"ك",1,0],["هذا الكتاب وفي سواد مداده","مني سواد القلب خير معرس",25,"س",1,0],["هَذَا الكِتَابُ وَهَذِهِ الآثَارِ وَال","مَعقُولِ فِي الفطرَاتِ وَالأذهَانِ",26,"ن",1,0],["هذا الكتاب فما الأوراق ناقصة","ولا رأى غير ذي فضل ولا أدب",27,"ب",1,1],["هذا الكلام الذي للعقل يرشده","من الإذاعة والباقي يضلّله",28,"ل",2,0],["هذا الكتاب مزاحم","لي في هواك مضايق",29,"ق",1,0],["هذا الكتاب لديك من","أوقات أنسي سارق",29,"ق",1,0],["هذا الكمال ابن الهمام اخو العلا","سبط المكارم بل ابو البركات",30,"ت",1,0],["هذا الكتاب حوى ما الدهر شتته","بفضل صاحبه المقدام ذي الحسب",31,"ب",1,0],["هذا الكتاب يقول أين اوامرى","وزواجرى فأصخ فداكا",32,"ك",2,0],["هذا الكتاب كتبته","واللَه يحكم ما يريدْ",33,"د",1,1],["هذا الكلامُ الذي خُصِصْتَ به","أَخَصُّ بالخَلداتِ من أَحَدِ",34,"د",1,0],["هذا الكتاب الذي قد جاءَ مشتملاً","على اختلاف معانٍ في العباداتِ",35,"ت",1,1],["هذا الكريم ابن الكريم لآدم","الطيب الأجداد والجدّات",36,"ت",1,0],["هذا الكتابُ المنتقى والمجتبى","تحمله إلي أنفاسُ الصبا",37,"ب",2,1],["هذا الكتاب الذي يغني عن السمر","ولم يدع أبدا للفضل من أثر",38,"ر",1,1],["هذا الكتابَ المسمّى","بشرح نهج البلاغه",39,"غ",2,1],["هذا الكتاب ففاز من راحاته","طبق اسمه الحالي بفيض الواردِ",40,"د",1,0],["هذا الكتابُ قد حوى","من كل فنٍّ أنفسِ",41,"س",1,1],["هذا الكتاب الذي في دفتيه حوى","من الفتاوي التي تزهو بتصحيح",42,"ح",1,1],["هذا الكريم المقتدى","هذا الزعيم السيد",43,"د",1,0],["هذا الكريم الاريحي المفتدى","هذا الغيور على الحقوق الفادي",44,"د",2,0],["هذا الكلام اللي وصلك من اقصاه","موقف خذيته مثل حد الشطيري",45,"ر",2,0],["هذا الكلام ومابقى شي نعطيك","خذ ماتبي ان كان تاصله يمناك",46,"ك",1,0],["هذا الكلام اخذه وياقل ما جاك","واعذر قصيدي قصّر بكرهك وفيك",47,"ك",1,0],["هذا الكتاب غدا في الشرق واأسفا","شمساً تضيء ولكن بين عميان",48,"ن",1,0],["هذا الكرِيمُ وما في جودِهِ أَحَدٌ","تَغَارُ مِمّا ترى مِنْ بذلِهِ السُّحُبُ",49,"ب",1,0],["هذا الكلامُ تناقلٌ","عمّا رواهُ الناقلُ",50,"ل",1,0],["هذا الكريمُ الذي ما صافَ هاطلِهُ","ولا تلبَّدَ في عليائِه القمرُ",51,"ر",1,0],["هَذا الكِتابُ، وهَذهِ الأَصدَاءُ","نُورٌ يُشعُّ وَحِكمَةٌ وَضِيَاءُ",52,"ا",2,1],["هذا الكتاب فخذه إن فيه لنا","شرائعاً نسخت كل الدساتير",53,"ر",1,0],["هذا الكتاب أتى بفضل محمدٍ","يهدي الأنام مترجماً بالصحةِ",54,"ه",1,1],["هذا الكمال بقبضه وببسطه","يهدي السرور كمنحة التفضيل",55,"ل",1,0],["هذا الكلام اللي على الشارب جمد","منطق عقل يقنع به اللي له عقل",56,"ل",1,0],["هذا الكتاب معجز مشاهد","هلم يا عريف للتوسم",57,"م",1,1],["هذا الكسول يسوق عزمه للهُوى","ونهارَ أن يهوي سيفتقد الرّبى",58,"ب",2,0]]}