{"poems":[[45,"واحر قلباه ممن قلبه شبم","https://www.aldiwan.net/poem10521.html","البسيط"],[409,"قد رأينا ما دار في الريحان","https://www.aldiwan.net/poem33368.html","الخفيف"],[463,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[556,"يهون عندكم أني بكم أرق","https://www.aldiwan.net/poem47381.html","البسيط"],[556,"إن قطعتني علتي عن قصدي","https://www.aldiwan.net/poem47845.html","الرجز"],[566,"أنيخ مسحول مع الصبار","https://www.aldiwan.net/poem27822.html","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64796","الوافر"],[3227,"","https://poetry.dctabudhabi.ae/diwan/poem/143348","السريع"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62820","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109954","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94461","البسيط"],[6031,"يَا ذَا الذي أَلِفَ الثَّوَاءَ وذِكْرُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=46410",""],[463,"أدمعكَ أمْ عارضٌ ممطرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60076&r=&rc=132",""]],"verses":[["فَوتُ العَدُوِّ الَّذي يَمَّمتَهُ ظَفَرٌ","في طَيِّهِ أَسَفٌ في طَيِّهِ نِعَمُ",0,"م",1,0],["فوتوا للأحكام شرطاً وقالوا","صح ذا عندنا بغير توان",1,"ن",1,0],["فوِتر مضاعٌ به يستقاد","وفضلٌ مذالٌ به يُنصرُ",2,"ر",1,0],["فوتُ الأمانِيَ ما شادوا ولا كرموا","نُكْدُ السّحائبِ ما اِنهلّوا ولا بَرِقوا",3,"ق",3,0],["فوتَ الرّدى ممتّعاً بالخُلدِ","ثِقْ بِالإِلهِ المُتعالي الفَرْدِ",4,"د",1,0],["فَوتَ العِراقِ ضامِنَ السُفارِ","وَلاحَ ضوءُ مِن سُهَيلٍ سارِ",5,"ر",1,0],["فوتْرُ الوَصْلِ لم يُشفَعْ بثانِ","وهَجْرُكَ مَرَّةً في إثْرِ مَرَّهْ",6,"ر",2,0],["فوَّتّني الشمسَ التي اعتضتُها","منه فديتَ المُحزِنَ المبهِجا",7,"ج",2,0],["فوتَ الرماحِ فإن دنوتَ تَعِلّةً","عانقتَ سالفةَ المَهاةِ الخاذلِ",8,"ل",1,0],["فوتي وبالأماس والزُمَر التي","من حِزبهم فيكم لها آثارُ",9,"ر",1,0],["فوتين فاتنتي أَنّى تفوتينا","هل حلَّ فوتي بأَي الشرع تفتينا",10,"ن",2,1],["فَوْتُ المطَالِبِ بَعد أنْ وقَفْتُ علَى","حَدٍّ تَكادُ بِهِ المُنَى أن تَعْلقَا",11,"ق",2,0],["فوترٌ مضاعٌ بهِ يستقادْ","وفضلٌ مذارٌ بهِ ينصرُ",12,"ر",1,0]]}