id=132673",""],[5385,"قوس المنون بسهم البين قدر رشقا","https://www.poetsgate.com/ViewPoem.aspx?id=144222",""],[5397,"الدين في مثل هذا اليوم قد كملا","https://www.poetsgate.com/ViewPoem.aspx?id=157899",""],[5399,"دنيا مغبة من أثرى بها عدم","https://www.poetsgate.com/ViewPoem.aspx?id=181170",""],[5409,"خصها الله بالجمال الفريد","https://www.poetsgate.com/ViewPoem.aspx?id=155267",""],[5431,"أي صبرٍ على الطُوى رمضانُ","https://www.poetsgate.com/ViewPoem.aspx?id=198195",""],[5431,"جنون مثلي...3","https://www.poetsgate.com/ViewPoem.aspx?id=212848",""],[5461,"لا هنت","https://www.poetsgate.com/ViewPoem.aspx?id=8541",""],[5512,"الأم ( غفوت )","https://www.poetsgate.com/ViewPoem.aspx?id=204345",""],[5512,"لا يزهر القلب من غير الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=205392",""],[5628,"يقظة","https://www.poetsgate.com/ViewPoem.aspx?id=178452",""],[5688,"يا مَن لِحِبّ","https://www.poetsgate.com/ViewPoem.aspx?id=212999",""],[5707,"طرق الصَّوَاب بك استبان سَبِيلهَا","https://www.poetsgate.com/ViewPoem.aspx?id=189187",""],[5717,"لا در در الجهل كم جر على ال","https://www.poetsgate.com/ViewPoem.aspx?id=170595",""],[5764,"حيرة الجاني","https://www.poetsgate.com/ViewPoem.aspx?id=174653",""],[5829,"بلسم الروح","https://www.poetsgate.com/ViewPoem.aspx?id=180642",""],[5956,"ضياع طفل *","https://www.poetsgate.com/ViewPoem.aspx?id=184565",""],[5956,"الظلم والطيبون","https://www.poetsgate.com/ViewPoem.aspx?id=192334",""],[5956,"أطهرُ الأتراب","https://www.poetsgate.com/ViewPoem.aspx?id=193710",""],[5956,"إني لَمُختصّ بكم يا أشهمُ","https://www.poetsgate.com/ViewPoem.aspx?id=194262",""],[5963,"آخر ُ الأَلحان","https://www.poetsgate.com/ViewPoem.aspx?id=187414",""],[6093,"كالبُنِّ في المِغْلاةِ عانقَ هَيْلَا","https://www.poetsgate.com/ViewPoem.aspx?id=206941",""],[6142,"مدينة العلم طه والوصي لها","https://www.poetsgate.com/ViewPoem.aspx?id=155719",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6162,"مَا لمْ تَقلهُ المرَايْا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69309&r=&rc=2",""],[6202,"خواطر صائم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86720&r=&rc=21",""],[463,"علَّمتها الأيامُ أن تتجنَّى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60232&r=&rc=288",""],[463,"عمى صباحا بعدنا واسلمي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60311&r=&rc=367",""],[402,"لك في ارتجال جلائل الهمم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54014&r=&rc=866",""],[6318,"مواكب بدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66158&r=&rc=8",""],[6355,"إلى صاحب الفضل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66624&r=&rc=84",""],[6355,"حصاد الأيام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66593&r=&rc=53",""]],"verses":[["كَم خَليطٍ بانَ عَنّي","ما قَضى الدَمعُ حُقوقَه",0,"ق",2,0],["كَم خَمصَةٍ كانَ فيها العِزِّ آوِنَةً","وَشَبعَةٍ كانَ فيها العارُ وَالضَرَعُ",1,"ع",1,0],["كَم خَوَّضَ الناسُ في قَولي وَقائِلِهِ","وَكَم غَلا بِيَ إِغراقٌ وَتَجويدُ",2,"د",1,0],["كَم خَدَّرَت أَعصابَ مِصرَ نَوافِحٌ","لِوُعودِهِم كَنَوافِحِ التُفّاحِ",3,"ح",1,0],["كَم خَلَبتُم عُقولَنا بِعَجيبٍ","وَأَمَرتُم زَمانَكُم فَأَطاعا",4,"ع",2,0],["كم خِفتَ في الله مَضعُوفاً دَعاكَ بهِ","وكم أخَفتَ قويّاً يَنثَني تِيها",5,"ي",3,0],["كَم خارِجٍ عَن أُفقِهِ حَصَبَ الوَرى","بِقَريضِهِ وَالعُجبُ مِلءُ جَنانِهِ",6,"ن",2,0],["كَمْ خَافَ صَولَتَهَا فَغَلَّلَهَا","بَاغٍ إِلَى أَنْ بَاءَ فِي نَدَمِ",7,"م",1,0],["كم خضتُ دونك من غمار مفازةٍ","لا تهتدي فيها الليوث لمجْثَمِ",8,"م",1,0],["كم خضت طوع صلاحها من مهمةٍ","لا تهتدي فيه القطا للماءِ",9,"ا",2,0],["كم خلّد الدهر من أيامهم خبراً","زان الطُروس وليس الخُبْر كالخَبَر",10,"ر",1,0],["كم خلعةٍ قلت للاحي وقد حضرت","وعضّ لحيته للغيظ ذي صوف",11,"ف",1,0],["كم خفَّ نهضُك للدعاة وكم رَسَتْ","قدماك في يومٍ عَراك عماس",12,"س",1,0],["كم خُلةٍ لي صارمتني بعدَه","لو كان أوجدني بها أبدالَها",13,"ل",3,0],["كم خاضَ أُمَّكَ أيري وهْي وادعةٌ","وإنه لشديدُ الوعك مَحْمومُ",14,"م",1,0],["كم خذلنا من ناسكٍ ذي اجتهادٍ","وفقيهٍ في دينهِ علَّام",15,"م",1,0],["كَم خَفَضنا الجَناحَ لِلجاهِلينا","وَعَذَرناهُمُ فَما عَذَرونا",16,"ن",2,1],["كَم خَطَإٍ سَتَرتَهُ وَكَم خَطَل","مِثلُكَ مَن يُرجى إِذا الخَطبُ نَزَل",17,"ل",1,0],["كم خاض في حرب وكم","غالب جمعا فغلب",18,"ب",1,0],["كم خطوب من الخلا","ف امت وكم وكم",19,"م",1,0],["كَم خَفَقَ القَلبُ لَها","عِندَ البُكا وَالضَحِكِ",20,"ك",1,0],["كَمُخدِرٍ مِن لُيوثِ الغيلِ ذي لِبَدٍ","ضِرغامَةٍ يَحطِمُ الهاماتِ وَالقَصَرا",21,"ر",2,0],["كَم خالَةٍ لَكَ يا جَريرُ وَعَمَّةٍ","فَدعاءَ قَد حَلَبَت عَلَيَّ عِشاري",22,"ر",2,0],["كم خارجٍ مِن دارِه ومُخلِّفٍ","فيها قُبورَ بَناتِهِ وبَنيهِ",23,"ي",2,0],["كَم خُطبَةٍ لَكَ راعَ الخَطبَ مَوقِعُها","وَكَم تُقُلِّدَ مِنهُ الدَهرَ تَقليدُ",24,"د",1,0],["كم خيالٍ يبيتُ يمسحُ عطفي","لكِ يا أمّتا ويهتفُ باسمي",25,"م",2,0],["كم خلَّفوا متطلِّعاً بطويلعٍ","وبرامةٍ كم من صحيحٍ أمرضوا",26,"ض",3,0],["كَمُخَفِّقِ الحَشيَينِ باتَ تَلُفُّهُ","وَطفاءُ سارِيَةٌ وَهِفٌّ مُبرِدُ",27,"د",1,0],["كَمَخيلِ الكانونِ ضَرَّمتَ فيهِ","عامِداً فَاِستَطارَ ضَوءاً مُنيرا",28,"ر",2,0],["كَم خُلَّةٍ فيكَ يا حَمّادُ فاضِحَةٍ","وَرِثتَها والِداً عِلجاً وَأَجدادا",29,"د",2,0],["كم خاملٍ قد رفعتَ همَّتَهُ","ورُدَّ في مالهِ وفي أملِهْ",30,"ل",2,0],["كم خِفتُ من أن تذهبي","وخفتِ من أن أذهبا",31,"ب",2,0],["كم خانني الحظ ولا أنثني","أقضي زماني كلَّه في لعل",32,"ل",1,0],["كم خاض فى إثرك الأقوام واختلفوا","قدما! فما أوضحوا حقّا ولا تركوا.",33,"ك",3,0],["كمْ خِدْمَةٍ فِي كُلِّ جَمْعِيَّةٍ","لِلْخَيْرِ لاَ تَأْلُو وَلاَ تَفْتُرُ",34,"ر",1,0],["كمْ خاطِرٍ دَوَّنَهُ","كَاتِبُهُ حِينَ خَطَرْ",35,"ر",1,0],["كَم خَريدَةٍ لَمَحَ ال","بَرقُ مِن مُوَشّرِها",36,"ر",3,0],["كم خطّ من صوّر الحياة مدادهُ","ما لم يخطّ مصوّر بدهانه",37,"ن",2,0],["كم خادعته بزيف الوعد قادته","هيهات أن يخدع الفهّمة الفطن",38,"ن",1,0],["كم خطبتَ أليَّ أيري جاهداً","حتى إذا أعيا خطبْتَ لساني",39,"ن",2,0],["كم خلت بغداد إذ جئنا مضاربهم","شرقي ماحص عني قيد اشبار",40,"ر",1,1],["كَم خَليلٍ يَزينُهُ وَاِبنُ عَمٍّ","وَحَميمٌ قَضَت عَلَيهِ المَنونُ",41,"ن",1,0],["كم خلٍّى غدا إليه وأمسَى","وهو يَهذِى بعلَوةٍ أو بهندِ",42,"د",1,0],["كَم خُضتَ مِن دونها ناراً مُضَرَّمَةً","ما خاضَها مَن لَهُ في نَفسِهِ أَرَبُ",43,"ب",1,0],["كَم خُضتَ مَلحَمَةً تَروعُ عُيَينَةً","وَغَفَرتَ ذَنباً يَستَفِزُّ الأَحنَفا",44,"ف",2,0],["كَم خائِفٍ حصلَ التأمين منك له","وَآمنٍ كانَ منه فيك تأميلُ",45,"ل",1,0],["كم خطبَ المجدَ له صارمٌ","في منبرٍ من كفِّه يَخطَبُ",46,"ب",1,0],["كم خشينا عليه حين تحدى","طاعناً كل جسمه بسنان",47,"ن",1,0],["كَم خُلق في مَوطِني من خزف","تحطمه الغاي وَكَم مِن فُؤاد",48,"د",1,0],["كَم خَبَأَت مِن رَيبَةٍ","بُيوتُهُم وَالأَخبِيَه",49,"ي",2,0],["كم خاطرٍ أمسى يُقسِّم فكرهُ","فيها وغايةُ أمره التعجيزُ",50,"ز",1,0],["كم خارجٍ من عهودِ العربِ يشتمني","ولم أكن قط شتّاماً وسبّابا",51,"ب",2,0],["كَمَخْتُومَةِ الدّارِيِّ نَمَّ بِفَضْلهِا","إِلَيْكَ شَذاها قَبْلَ فَضِّكَ لِلْخَتْمِ",52,"م",1,0],["كَم خِلعَةٍ مِن دَمِ الأَعداءِ صِبغَتُها","تَوَّجتَها شَرَفاً تُزهى بِهِ القِمَمُ",53,"م",1,0],["كَم خازِنٍ لَكَ مِثلُ أَلفَي حاتَمٍ","كَرَماً وَمَملوكٍ كَأَلفَي عَنتَرِ",54,"ر",1,0],["كَم خَلَونا بِبَدرِ تمٍّ جَلوناه","وَلَقد تَمّم الجَميل وِصالا",55,"ل",2,0],["كم خَوَّفوا سَنةَ القِرانِ وخَيّلُوا","أنّا سنَخْرُجُ عندَ ذاكَ ونَظْهَر",56,"ر",1,0],["كم خاطبٍ لمّا اغتَربْتُ مِدْحَتْي","قلتُ له لوْ بأبانَيْنِ خَطَب",57,"ب",1,0],["كَم خادم في الهَون وَهُوَ أَحَق لَو","بَرَح الخِفاء بِرُتبة المَخدوم",58,"م",1,0],["كم خِلْتُ خِلاًّ صادقاً","فوجدته عين المداج",59,"ج",1,0],["كم خميس في الوغى اضحى خليل","من رديني نجله المولى الخليل",60,"ل",1,0],["كم خاضَ ضَحْضَاحَها من غارقٍ فَنَجَا","حتى أَفاضَ عليها سَيْبَهُ العَرما",61,"م",2,0],["كم خدودٍ لم تُعترف بنَقابٍ","ومُدامٍ لم تَدْرِ بالأقْداحِ",62,"ح",1,0],["كم خُدِ عنا قبلُ في أفعالهِ","وحسبناها مثالاً للكمال",63,"ل",1,0],["كم خضوعٍ وليس يُخجِلُ عينا","وعتابٍ وليس يخرُق أُذْنا",64,"ن",2,0],["كم خطَرٍ دونَكِ يا ذات اللَّمي","خِيضْت له الفِجاجُ والمخارِمُ",65,"م",1,0],["كم خَفَروا ذمةَ مستسلمٍ","واحتقروا قتلَ امرىءٍ مسلمِ",66,"م",1,0],["كم خطوةٍ لك في المُنى إزليقةٍ","لم تنتصرْ بِلَعاً على عثَراتِها",67,"ت",3,0],["كم خَلَّةٍ داويتُها بدوائها","منه