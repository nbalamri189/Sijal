{"poems":[[53,"خل دمعي وطريقه","https://www.aldiwan.net/poem29957.html","مجزوء الرمل"],[53,"قف موقف الشك لا يأس ولا طمع","https://www.aldiwan.net/poem30134.html","البسيط"],[53,"إلى كم الطرف بالبيداء معقود","https://www.aldiwan.net/poem30637.html","البسيط"],[86,"أشرق فدتك مشارق الإصباح","https://www.aldiwan.net/poem10673.html","الكامل"],[86,"أي رجال الدنيا الجديدة مدوا","https://www.aldiwan.net/poem10922.html","الخفيف"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[86,"ورد الكنانة عبقري زمانه","https://www.aldiwan.net/poem68904.html","الكامل"],[93,"لك في ارتجال جلائل الهمم","https://www.aldiwan.net/poem11336.html","أحذ الكامل"],[83,"أللمحة من بارق متبسم","https://www.aldiwan.net/poem54240.html","الكامل"],[83,"زار الخيال بأيمن الزوراء","https://www.aldiwan.net/poem54344.html","الطويل"],[88,"الشعر مفتقر مني لمبتكر","https://www.aldiwan.net/poem44991.html","البسيط"],[72,"مسلسل من حديث الدمع مذروف","https://www.aldiwan.net/poem19258.html","البسيط"],[51,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[51,"قد كنت أبكي من صريمة خلة","https://www.aldiwan.net/poem65924.html","الكامل"],[51,"سوار شكرا لأيري فضل نعمته","https://www.aldiwan.net/poem66297.html","البسيط"],[51,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[91,"كم خفضنا الجناح للجاهلينا","https://www.aldiwan.net/poem62791.html","عموديه"],[70,"يا سيدا ما منه في الناس بدل","https://www.aldiwan.net/poem42754.html","الرجز"],[89,"الشعر ديوان العرب","https://www.aldiwan.net/poem44780.html","مجزوء الرجز"],[89,"انما نهضة الامم","https://www.aldiwan.net/poem44855.html","مجزوء الخفيف"],[85,"أمينتي في عامها","https://www.aldiwan.net/poem8068.html","مجزوء الرجز"],[28,"يا عجبا للعذارى يوم معقلة","https://www.aldiwan.net/poem5098.html","البسيط"],[28,"كالسامري يقول إن حركته","https://www.aldiwan.net/poem5243.html","الكامل"],[61,"لا تصغين إلى مقال سفيه","https://www.aldiwan.net/poem51401.html","الكامل"],[66,"حبل المنى بحبال اليأس معقود","https://www.aldiwan.net/poem40133.html","البسيط"],[80,"أي خطب عن قوسه الموت يرمي","https://www.aldiwan.net/poem31283.html","الخفيف"],[69,"اترك بحقك ما يقول المبغض","https://www.aldiwan.net/poem28754.html","الكامل"],[39,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[50,"قم خليلي فانظر أراك بصيرا","https://www.aldiwan.net/poem63816.html","الخفيف"],[50,"يا ليلتي لم أنم شوقا وتسهادا","https://www.aldiwan.net/poem63896.html","البسيط"],[76,"خليفة الله وابن عم رسو","https://www.aldiwan.net/poem39006.html","المنسرح"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147464","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[100,"الحكم للشعب","https://www.poetsgate.com/ViewPoem.aspx?id=50179",""],[51,"يا قحطبي كما يقالُ وربما","https://www.poetsgate.com/ViewPoem.aspx?id=30756",""],[125,"كم خلت بغداد إذ جئنا مضاربهم","https://www.aldiwan.net/poem23724.html","البسيط"],[135,"ليت شعري مسافر بن أبي عمرو","https://www.aldiwan.net/poem21042.html","الخفيف"],[143,"النجاء النجاء من أرض نجد","https://www.aldiwan.net/poem58420.html","البسيط"],[144,"لا زلت تعلو وإن حسادك إكتأبوا","https://www.aldiwan.net/poem11721.html","البسيط"],[144,"لله قدرك ما أجل وأشرفا","https://www.aldiwan.net/poem11781.html","الكامل"],[190,"هواي طيبة لا بيضاء عطبول","https://www.aldiwan.net/poem35275.html","البسيط"],[199,"يا شمس خدر مالها مغرب","https://www.aldiwan.net/poem51986.html","السريع"],[222,"قد رأيت المحال رأي عيان","https://www.aldiwan.net/poem55292.html","الخفيف"],[224,"عرفت فيك النبل يا شاعري","https://www.aldiwan.net/poem41641.html","السريع"],[236,"يا قالة الشعر أما","https://www.aldiwan.net/poem31626.html","مجزوء الرجز"],[251,"وافي إليك بلهوه النيروز","https://www.aldiwan.net/poem14982.html","الكامل"],[271,"صافح من العرب الأمجاد أحبابا","https://www.aldiwan.net/poem35654.html","البسيط"],[281,"أيا بين ما سلطت إلا على ظلمي","https://www.aldiwan.net/poem60729.html","الطويل"],[283,"تظلموا وهم عقوا وهم ظلموا","https://www.aldiwan.net/poem32460.html","البسيط"],[283,"تبنى الممالك بالوشيج الأسمر","https://www.aldiwan.net/poem32790.html","الكامل"],[354,"من لصب صبا المعاهد أشجاه","https://www.aldiwan.net/poem40001.html","الخفيف"],[365,"قلب المشوق بأن يساعد أجدر","https://www.aldiwan.net/poem60910.html","الكامل"],[365,"أنصر أخاك مسعدا في ما حزب","https://www.aldiwan.net/poem60999.html","الطويل"],[381,"يا مكثرا من ذم كل ذميم","https://www.aldiwan.net/poem48760.html","الخفيف"],[404,"وافت على وفق احتياجي","https://www.aldiwan.net/poem34096.html","مجزوء الكامل"],[430,"لاح في مهد المعالي والسنا","https://www.aldiwan.net/poem40715.html","الرمل"],[433,"لم يشف طيفك لما زارني ألما","https://www.aldiwan.net/poem12372.html","البسيط"],[433,"أيجور الزمان يا ثقة المل","https://www.aldiwan.net/poem12784.html","الخفيف"],[454,"أرجال لا ولا شبه رجال","https://www.aldiwan.net/poem61613.html","الرمل"],[459,"علمتها الأيام أن تتجنى","https://www.aldiwan.net/poem55839.html","الخفيف"],[459,"أيقظني للبرقِ وهو نائم","https://www.aldiwan.net/poem55863.html","الرجز"],[459,"عِمي صباحا بعدنا واسلمي","https://www.aldiwan.net/poem55887.html","السريع"],[459,"دعها تكن كالسلف من أخواتها","https://www.aldiwan.net/poem56263.html","البسيط"],[459,"ما أنكرت إلا البياض فصدتِ","https://www.aldiwan.net/poem56266.html","الكامل"],[462,"لا يعجزنك المجد من بعده","https://www.aldiwan.net/poem16003.html","السريع"],[464,"الرب باق والخلائق فانيه","https://www.aldiwan.net/poem925.html",""],[483,"من يوم كنت عصا الوجدان تسيار","https://www.aldiwan.net/poem24372.html","عموديه"],[494,"لا تستكن لطوارق النوب","https://www.aldiwan.net/poem67415.html","أحذ الكامل"],[505,"حلت حين ما حلت على المصايب","https://www.aldiwan.net/poem38413.html","الطويل"],[516,"نطقت عنك ألسن الأغماد","https://www.aldiwan.net/poem12094.html","الخفيف"],[539,"حيثما سرت فالمعالي تسير","https://www.aldiwan.net/poem48186.html","عموديه"],[559,"أنتم هي الجوزة في قشرها","https://www.aldiwan.net/poem34468.html","السريع"],[576,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"]],"verses":[["كَم خَليطٍ بانَ عَنّي","ما قَضى الدَمعُ حُقوقَه",0,"ق",2,0],["كَم خَمصَةٍ كانَ فيها العِزِّ آوِنَةً","وَشَبعَةٍ كانَ فيها العارُ وَالضَرَعُ",1,"ع",1,0],["كَم خَوَّضَ الناسُ في قَولي وَقائِلِهِ","وَكَم غَلا بِيَ إِغراقٌ وَتَجويدُ",2,"د",1,0],["كَم خَدَّرَت أَعصابَ مِصرَ نَوافِحٌ","لِوُعودِهِم كَنَوافِحِ التُفّاحِ",3,"ح",1,0],["كَم خَلَبتُم عُقولَنا بِعَجيبٍ","وَأَمَرتُم زَمانَكُم فَأَطاعا",4,"ع",2,0],["كم خِفتَ في الله مَضعُوفاً دَعاكَ بهِ","وكم أخَفتَ قويّاً يَنثَني تِيها",5,"ي",3,0],["كَم خارِجٍ عَن أُفقِهِ حَصَبَ الوَرى","بِقَريضِهِ وَالعُجبُ مِلءُ جَنانِهِ",6,"ن",2,0],["كَمْ خَافَ صَولَتَهَا فَغَلَّلَهَا","بَاغٍ إِلَى أَنْ بَاءَ فِي نَدَمِ",7,"م",1,0],["كم خضتُ دونك من غمار مفازةٍ","لا تهتدي فيها الليوث لمجْثَمِ",8,"م",1,0],["كم خضت طوع صلاحها من مهمةٍ","لا تهتدي فيه القطا للماءِ",9,"ا",2,0],["كم خلّد الدهر من أيامهم خبراً","زان الطُروس وليس الخُبْر كالخَبَر",10,"ر",1,0],["كم خلعةٍ قلت للاحي وقد حضرت","وعضّ لحيته للغيظ ذي صوف",11,"ف",1,0],["كم خفَّ نهضُك للدعاة وكم رَسَتْ","قدماك في يومٍ عَراك عماس",12,"س",1,0],["كم خُلةٍ لي صارمتني بعدَه","لو كان أوجدني بها أبدالَها",13,"ل",3,0],["كم خاضَ أُمَّكَ أيري وهْي وادعةٌ","وإنه لشديدُ الوعك مَحْمومُ",14,"م",1,0],["كم خذلنا من ناسكٍ ذي اجتهادٍ","وفقيهٍ في دينهِ علَّام",15,"م",1,0],["كَم خَفَضنا الجَناحَ لِلجاهِلينا","وَعَذَرناهُمُ فَما عَذَرونا",16,"ن",2,1],["كَم خَطَإٍ سَتَرتَهُ وَكَم خَطَل","مِثلُكَ مَن يُرجى إِذا الخَطبُ نَزَل",17,"ل",1,0],["كم خاض في حرب وكم","غالب جمعا فغلب",18,"ب",1,0],["كم خطوب من الخلا","ف امت وكم وكم",19,"م",1,0],["كَم خَفَقَ القَلبُ لَها","عِندَ البُكا وَالضَحِكِ",20,"ك",1,0],["كَمُخدِرٍ مِن لُيوثِ الغيلِ ذي لِبَدٍ","ضِرغامَةٍ يَحطِمُ الهاماتِ وَالقَصَرا",21,"ر",2,0],["كَم خالَةٍ لَكَ يا جَريرُ وَعَمَّةٍ","فَدعاءَ قَد حَلَبَت عَلَيَّ عِشاري",22,"ر",2,0],["كم خارجٍ مِن دارِه ومُخلِّفٍ","فيها قُبورَ بَناتِهِ وبَنيهِ",23,"ي",2,0],["كَم خُطبَةٍ لَكَ راعَ الخَطبَ مَوقِعُها","وَكَم تُقُلِّدَ مِنهُ الدَهرَ تَقليدُ",24,"د",1,0],["كم خيالٍ يبيتُ يمسحُ عطفي","لكِ يا أمّتا ويهتفُ باسمي",25,"م",2,0],["كم خلَّفوا متطلِّعاً بطويلعٍ","وبرامةٍ كم من صحيحٍ أمرضوا",26,"ض",3,0],["كَمُخَفِّقِ الحَشيَينِ باتَ تَلُفُّهُ","وَطفاءُ سارِيَةٌ وَهِفٌّ مُبرِدُ",27,"د",1,0],["كَمَخيلِ الكانونِ ضَرَّمتَ فيهِ","عامِداً فَاِستَطارَ ضَوءاً مُنيرا",28,"ر",2,0],["كَم خُلَّةٍ فيكَ يا حَمّادُ فاضِحَةٍ","وَرِثتَها والِداً عِلجاً وَأَجدادا",29,"د",2,0],["كم خاملٍ قد رفعتَ همَّتَهُ","ورُدَّ في مالهِ وفي أملِهْ",30,"ل",2,0],["كم خِفتُ من أن تذهبي","وخفتِ من أن أذهبا",31,"ب",2,0],["كم خانني الحظ ولا أنثني","أقضي زماني كلَّه في لعل",32,"ل",1,0],["كم خاض فى إثرك الأقوام واختلفوا","قدما! فما أوضحوا حقّا ولا تركوا.",33,"ك",3,0],["كمْ خِدْمَةٍ فِي كُلِّ جَمْعِيَّةٍ","لِلْخَيْرِ لاَ تَأْلُو وَلاَ تَفْتُرُ",34,"ر",1,0],["كمْ خاطِرٍ دَوَّنَهُ","كَاتِبُهُ حِينَ خَطَرْ",35,"ر",1,0],["كَم خَريدَةٍ لَمَحَ ال","بَرقُ مِن مُوَشّرِها",36,"ر",3,0],["كم خطّ من صوّر الحياة مدادهُ","ما لم يخطّ مصوّر بدهانه",37,"ن",2,0],["كم خادعته بزيف الوعد قادته","هيهات أن يخدع الفهّمة الفطن",38,"ن",1,0],["كم خطبتَ أليَّ أيري جاهداً","حتى إذا أعيا خطبْتَ لساني",39,"ن",2,0],["كم خلت بغداد إذ جئنا مضاربهم","شرقي ماحص عني قيد اشبار",40,"ر",1,1],["كَم خَليلٍ يَزينُهُ وَاِبنُ عَمٍّ","وَحَميمٌ قَضَت عَلَيهِ المَنونُ",41,"ن",1,0],["كم خلٍّى غدا إليه وأمسَى","وهو يَهذِى بعلَوةٍ أو بهندِ",42,"د",1,0],["كَم خُضتَ مِن دونها ناراً مُضَرَّمَةً","ما خاضَها مَن لَهُ في نَفسِهِ أَرَبُ",43,"ب",1,0],["كَم خُضتَ مَلحَمَةً تَروعُ عُيَينَةً","وَغَفَرتَ ذَنباً يَستَفِزُّ الأَحنَفا",44,"ف",2,0],["كَم خائِفٍ حصلَ التأمين منك له","وَآمنٍ كانَ منه فيك تأميلُ",45,"ل",1,0],["كم خطبَ المجدَ له صارمٌ","في منبرٍ من كفِّه يَخطَبُ",46,"ب",1,0],["كم خشينا عليه حين تحدى","طاعناً كل جسمه بسنان",47,"ن",1,0],["كَم خُلق في مَوطِني من خزف","تحطمه الغاي وَكَم مِن فُؤاد",48,"د",1,0],["كَم خَبَأَت مِن رَيبَةٍ","بُيوتُهُم وَالأَخبِيَه",49,"ي",2,0],["كم خاطرٍ أمسى يُقسِّم فكرهُ","فيها وغايةُ أمره التعجيزُ",50,"ز",1,0],["كم خارجٍ من عهودِ العربِ يشتمني","ولم أكن قط شتّاماً وسبّابا",51,"ب",2,0],["كَمَخْتُومَةِ الدّارِيِّ نَمَّ بِفَضْلهِا","إِلَيْكَ شَذاها قَبْلَ فَضِّكَ لِلْخَتْمِ",52,"م",1,0],["كَم خِلعَةٍ مِن دَمِ الأَعداءِ صِبغَتُها","تَوَّجتَها شَرَفاً تُزهى بِهِ القِمَمُ",53,"م",1,0],["كَم خازِنٍ لَكَ مِثلُ أَلفَي حاتَمٍ","كَرَماً وَمَملوكٍ كَأَلفَي عَنتَرِ",54,"ر",1,0],["كَم خَلَونا بِبَدرِ تمٍّ جَلوناه","وَلَقد تَمّم الجَميل وِصالا",55,"ل",2,0],["كم خَوَّفوا سَنةَ القِرانِ وخَيّلُوا","أنّا سنَخْرُجُ عندَ ذاكَ ونَظْهَر",56,"ر",1,0],["كم خاطبٍ لمّا اغتَربْتُ مِدْحَتْي","قلتُ له لوْ بأبانَيْنِ خَطَب",57,"ب",1,0],["كَم خادم في الهَون وَهُوَ أَحَق لَو","بَرَح الخِفاء بِرُتبة المَخدوم",58,"م",1,0],["كم خِلْتُ خِلاًّ صادقاً","فوجدته عين المداج",59,"ج",1,0],["كم خميس في الوغى اضحى خليل","من رديني نجله المولى الخليل",60,"ل",1,0],["كم خاضَ ضَحْضَاحَها من غارقٍ فَنَجَا","حتى أَفاضَ عليها سَيْبَهُ العَرما",61,"م",2,0],["كم خدودٍ لم تُعترف بنَقابٍ","ومُدامٍ لم تَدْرِ بالأقْداحِ",62,"ح",1,0],["كم خُدِ عنا قبلُ في أفعالهِ","وحسبناها مثالاً للكمال",63,"ل",1,0],["كم خضوعٍ وليس يُخجِلُ عينا","وعتابٍ وليس يخرُق أُذْنا",64,"ن",2,0],["كم خطَرٍ دونَكِ يا ذات اللَّمي","خِيضْت له الفِجاجُ والمخارِمُ",65,"م",1,0],["كم خَفَروا ذمةَ مستسلمٍ","واحتقروا قتلَ امرىءٍ مسلمِ",66,"م",1,0],["كم خطوةٍ لك في المُنى إزليقةٍ","لم تنتصرْ بِلَعاً على عثَراتِها",67,"ت",3,0],["كم خَلَّةٍ داويتُها بدوائها","منه ونعمَى كان من أَدَواتِها",67,"ت",3,0],["كم خاطبٍ بأعزِّ ما تحوِي يدٌ","عذراءَ منه وعِرضُهُ دونَ ابنتي",68,"ي",1,0],["كم خامِلٍ صارَ بتدْبيرهِ","ما بن أبْناءِ العُلى تاجا",69,"ج",2,0],["كم خرقت كم غرقت كم حرقت","من بشرة حربية أو باغيه",70,"ي",2,0],["كم خضبت بدماء الدهر ما برح الته","ام يحملها والشوق غرار",71,"ر",1,0],["كَم خائِفٍ مِن هَلكَة سَبَباً","نالَ النَجاةَ بِذلِكَ السَبَبِ",72,"ب",1,0],["كم خشت في الدهر منه بدايع","بديع بدت في الكون