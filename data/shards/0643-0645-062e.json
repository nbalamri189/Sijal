{"poems":[[53,"خل دمعي وطريقه","https://www.aldiwan.net/poem29957.html","مجزوء الرمل"],[53,"قف موقف الشك لا يأس ولا طمع","https://www.aldiwan.net/poem30134.html","البسيط"],[53,"إلى كم الطرف بالبيداء معقود","https://www.aldiwan.net/poem30637.html","البسيط"],[86,"أشرق فدتك مشارق الإصباح","https://www.aldiwan.net/poem10673.html","الكامل"],[86,"أي رجال الدنيا الجديدة مدوا","https://www.aldiwan.net/poem10922.html","الخفيف"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[86,"ورد الكنانة عبقري زمانه","https://www.aldiwan.net/poem68904.html","الكامل"],[93,"لك في ارتجال جلائل الهمم","https://www.aldiwan.net/poem11336.html","أحذ الكامل"],[83,"أللمحة من بارق متبسم","https://www.aldiwan.net/poem54240.html","الكامل"],[83,"زار الخيال بأيمن الزوراء","https://www.aldiwan.net/poem54344.html","الطويل"],[88,"الشعر مفتقر مني لمبتكر","https://www.aldiwan.net/poem44991.html","البسيط"],[72,"مسلسل من حديث الدمع مذروف","https://www.aldiwan.net/poem19258.html","البسيط"],[51,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[51,"قد كنت أبكي من صريمة خلة","https://www.aldiwan.net/poem65924.html","الكامل"],[51,"سوار شكرا لأيري فضل نعمته","https://www.aldiwan.net/poem66297.html","البسيط"],[51,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[91,"كم خفضنا الجناح للجاهلينا","https://www.aldiwan.net/poem62791.html","عموديه"],[70,"يا سيدا ما منه في الناس بدل","https://www.aldiwan.net/poem42754.html","الرجز"],[89,"الشعر ديوان العرب","https://www.aldiwan.net/poem44780.html","مجزوء الرجز"],[89,"انما نهضة الامم","https://www.aldiwan.net/poem44855.html","مجزوء الخفيف"],[85,"أمينتي في عامها","https://www.aldiwan.net/poem8068.html","مجزوء الرجز"],[28,"يا عجبا للعذارى يوم معقلة","https://www.aldiwan.net/poem5098.html","البسيط"],[28,"كالسامري يقول إن حركته","https://www.aldiwan.net/poem5243.html","الكامل"],[61,"لا تصغين إلى مقال سفيه","https://www.aldiwan.net/poem51401.html","الكامل"],[66,"حبل المنى بحبال اليأس معقود","https://www.aldiwan.net/poem40133.html","البسيط"],[80,"أي خطب عن قوسه الموت يرمي","https://www.aldiwan.net/poem31283.html","الخفيف"],[69,"اترك بحقك ما يقول المبغض","https://www.aldiwan.net/poem28754.html","الكامل"],[39,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[50,"قم خليلي فانظر أراك بصيرا","https://www.aldiwan.net/poem63816.html","الخفيف"],[50,"يا ليلتي لم أنم شوقا وتسهادا","https://www.aldiwan.net/poem63896.html","البسيط"],[76,"خليفة الله وابن عم رسو","https://www.aldiwan.net/poem39006.html","المنسرح"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147464","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[51,"يا قحطبي كما يقالُ وربما","https://www.poetsgate.com/ViewPoem.aspx?id=30756",""]],"verses":[["كَم خَليطٍ بانَ عَنّي","ما قَضى الدَمعُ حُقوقَه",0,"ق",2,0],["كَم خَمصَةٍ كانَ فيها العِزِّ آوِنَةً","وَشَبعَةٍ كانَ فيها العارُ وَالضَرَعُ",1,"ع",1,0],["كَم خَوَّضَ الناسُ في قَولي وَقائِلِهِ","وَكَم غَلا بِيَ إِغراقٌ وَتَجويدُ",2,"د",1,0],["كَم خَدَّرَت أَعصابَ مِصرَ نَوافِحٌ","لِوُعودِهِم كَنَوافِحِ التُفّاحِ",3,"ح",1,0],["كَم خَلَبتُم عُقولَنا بِعَجيبٍ","وَأَمَرتُم زَمانَكُم فَأَطاعا",4,"ع",2,0],["كم خِفتَ في الله مَضعُوفاً دَعاكَ بهِ","وكم أخَفتَ قويّاً يَنثَني تِيها",5,"ي",3,0],["كَم خارِجٍ عَن أُفقِهِ حَصَبَ الوَرى","بِقَريضِهِ وَالعُجبُ مِلءُ جَنانِهِ",6,"ن",2,0],["كَمْ خَافَ صَولَتَهَا فَغَلَّلَهَا","بَاغٍ إِلَى أَنْ بَاءَ فِي نَدَمِ",7,"م",1,0],["كم خضتُ دونك من غمار مفازةٍ","لا تهتدي فيها الليوث لمجْثَمِ",8,"م",1,0],["كم خضت طوع صلاحها من مهمةٍ","لا تهتدي فيه القطا للماءِ",9,"ا",2,0],["كم خلّد الدهر من أيامهم خبراً","زان الطُروس وليس الخُبْر كالخَبَر",10,"ر",1,0],["كم خلعةٍ قلت للاحي وقد حضرت","وعضّ لحيته للغيظ ذي صوف",11,"ف",1,0],["كم خفَّ نهضُك للدعاة وكم رَسَتْ","قدماك في يومٍ عَراك عماس",12,"س",1,0],["كم خُلةٍ لي صارمتني بعدَه","لو كان أوجدني بها أبدالَها",13,"ل",3,0],["كم خاضَ أُمَّكَ أيري وهْي وادعةٌ","وإنه لشديدُ الوعك مَحْمومُ",14,"م",1,0],["كم خذلنا من ناسكٍ ذي اجتهادٍ","وفقيهٍ في دينهِ علَّام",15,"م",1,0],["كَم خَفَضنا الجَناحَ لِلجاهِلينا","وَعَذَرناهُمُ فَما عَذَرونا",16,"ن",2,1],["كَم خَطَإٍ سَتَرتَهُ وَكَم خَطَل","مِثلُكَ مَن يُرجى إِذا الخَطبُ نَزَل",17,"ل",1,0],["كم خاض في حرب وكم","غالب جمعا فغلب",18,"ب",1,0],["كم خطوب من الخلا","ف امت وكم وكم",19,"م",1,0],["كَم خَفَقَ القَلبُ لَها","عِندَ البُكا وَالضَحِكِ",20,"ك",1,0],["كَمُخدِرٍ مِن لُيوثِ الغيلِ ذي لِبَدٍ","ضِرغامَةٍ يَحطِمُ الهاماتِ وَالقَصَرا",21,"ر",2,0],["كَم خالَةٍ لَكَ يا جَريرُ وَعَمَّةٍ","فَدعاءَ قَد حَلَبَت عَلَيَّ عِشاري",22,"ر",2,0],["كم خارجٍ مِن دارِه ومُخلِّفٍ","فيها قُبورَ بَناتِهِ وبَنيهِ",23,"ي",2,0],["كَم خُطبَةٍ لَكَ راعَ الخَطبَ مَوقِعُها","وَكَم تُقُلِّدَ مِنهُ الدَهرَ تَقليدُ",24,"د",1,0],["كم خيالٍ يبيتُ يمسحُ عطفي","لكِ يا أمّتا ويهتفُ باسمي",25,"ي",1,0],["كم خلَّفوا متطلِّعاً بطويلعٍ","وبرامةٍ كم من صحيحٍ أمرضوا",26,"ض",3,0],["كَمُخَفِّقِ الحَشيَينِ باتَ تَلُفُّهُ","وَطفاءُ سارِيَةٌ وَهِفٌّ مُبرِدُ",27,"د",1,0],["كَمَخيلِ الكانونِ ضَرَّمتَ فيهِ","عامِداً فَاِستَطارَ ضَوءاً مُنيرا",28,"ر",2,0],["كَم خُلَّةٍ فيكَ يا حَمّادُ فاضِحَةٍ","وَرِثتَها والِداً عِلجاً وَأَجدادا",29,"د",2,0],["كم خاملٍ قد رفعتَ همَّتَهُ","ورُدَّ في مالهِ وفي أملِهْ",30,"ل",2,0],["كم خِفتُ من أن تذهبي","وخفتِ من أن أذهبا",31,"ب",2,0],["كم خانني الحظ ولا أنثني","أقضي زماني كلَّه في لعل",32,"ل",1,0],["كم خاض فى إثرك الأقوام واختلفوا","قدما! فما أوضحوا حقّا ولا تركوا.",33,"ك",3,0],["كمْ خِدْمَةٍ فِي كُلِّ جَمْعِيَّةٍ","لِلْخَيْرِ لاَ تَأْلُو وَلاَ تَفْتُرُ",34,"ر",1,0],["كمْ خاطِرٍ دَوَّنَهُ","كَاتِبُهُ حِينَ خَطَرْ",35,"ر",1,0],["كَم خَريدَةٍ لَمَحَ ال","بَرقُ مِن مُوَشّرِها",36,"ر",3,0],["كم خطّ من صوّر الحياة مدادهُ","ما لم يخطّ مصوّر بدهانه",37,"ن",2,0],["كم خطبتَ أليَّ أيري جاهداً","حتى إذا أعيا خطبْتَ لساني",38,"ن",2,0]]}