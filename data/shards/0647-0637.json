{"poems":[[66,"طاب السماع وهبت النسمات","https://www.aldiwan.net/poem67575.html","الكامل"],[53,"لعمري لقد سهلت ما ليس بالسهل","https://www.aldiwan.net/poem65942.html","الطويل"],[34,"ما هاج شوقك من بلى الأطلال","https://www.aldiwan.net/poem27704.html","الكامل"],[68,"لاقيتنا ملقى الكريم لضيفه","https://www.aldiwan.net/poem41368.html","الكامل"],[76,"سمح الخيال على النوى بمزار","https://www.aldiwan.net/poem12955.html","الكامل"],[107,"أعجزنا أن نجوب المشرقين","https://www.aldiwan.net/poem42090.html","الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85412","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54686","البسيط"],[164,"في كل يوم عارض لك يمطر","https://www.aldiwan.net/poem58991.html","الكامل"],[242,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[242,"قد حوينا كل ما شيء حسن","https://www.aldiwan.net/poem19277.html","الخفيف"],[276,"ضربت سعاد خيامها بفؤادي","https://www.aldiwan.net/poem52108.html","الكامل"],[276,"بمحمد خطر المحامد يعظم","https://www.aldiwan.net/poem52125.html","الكامل"],[422,"كف الملام فما يفيد ملامي","https://www.aldiwan.net/poem53993.html","الكامل"],[438,"نسخ الجد مقال اللعب","https://www.aldiwan.net/poem12556.html","الرمل"],[445,"كسيت بدولتك اليالي نورا","https://www.aldiwan.net/poem34851.html","الكامل"],[482,"بعد المزار فأنة وتذكر","https://www.aldiwan.net/poem15285.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138195",""],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146223","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96742","الرمل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96602","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55931","الكامل"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122890","الخفيف"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110645","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100358","الكامل"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110751","الخفيف"],[119,"","https://poetry.dctabudhabi.ae/diwan/poem/106035","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68016","الرمل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67997","الرمل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125822","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102742","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94784","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94533","الكامل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81916","الطويل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135117","البسيط"],[4755,"ووَقَعْتَ حِينَ وَقَعْتَ جَوَّا","https://www.poetsgate.com/ViewPoem.aspx?id=183780",""],[4767,"خطاب الحجة","https://www.poetsgate.com/ViewPoem.aspx?id=179652",""],[4818,"الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=203509",""],[4858,"نذير الثّلج","https://www.poetsgate.com/ViewPoem.aspx?id=155081",""],[4960,"السَّيِّد النُّبْل","https://www.poetsgate.com/ViewPoem.aspx?id=214474",""],[5002,"كل القلوب مع السودان","https://www.poetsgate.com/ViewPoem.aspx?id=215978",""],[5362,"هطل السحاب على الربى ملثاثا","https://www.poetsgate.com/ViewPoem.aspx?id=170329",""],[5431,"وكم ظنّتِ المرآةُ أنك أحمقُ !!","https://www.poetsgate.com/ViewPoem.aspx?id=197792",""],[5431,"أصابعه...","https://www.poetsgate.com/ViewPoem.aspx?id=198736",""],[5431,"الحسين -سبط رسول الله-","https://www.poetsgate.com/ViewPoem.aspx?id=199897",""],[5431,"أيحتاج ماء الغيم إنْ ظلّ بي يُروى !!","https://www.poetsgate.com/ViewPoem.aspx?id=201461",""],[3294,"خان الوفاء وإن أجرى الدموع دما","https://www.poetsgate.com/ViewPoem.aspx?id=173278",""],[5447,"سلاما أيها الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=208299",""],[5447,"هطول","https://www.poetsgate.com/ViewPoem.aspx?id=208328",""],[5540,"هطلت دموعي","https://www.poetsgate.com/ViewPoem.aspx?id=214104",""],[5582,"هذِي بِشاراتُ السُّرُورِ تَراها","https://www.poetsgate.com/ViewPoem.aspx?id=187331",""],[2110,"هلال حسن هل يا من يراه","https://www.poetsgate.com/ViewPoem.aspx?id=156288",""],[5633,"ضَوْءٌ وَتِلَاوَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=208630",""],[5672,"سلم له جل جلاله","https://www.poetsgate.com/ViewPoem.aspx?id=206543",""],[5674,"معذورة تلك الحروف تحن لي","https://www.poetsgate.com/ViewPoem.aspx?id=185909",""],[5782,"ما الشعر؟","https://www.poetsgate.com/ViewPoem.aspx?id=185756",""],[5818,"لعلّ الله أنْ يشفي سقامهْ","https://www.poetsgate.com/ViewPoem.aspx?id=193231",""],[5830,"وَ كُنْتُ السَّمَاءْ","https://www.poetsgate.com/ViewPoem.aspx?id=200774",""],[5897,".. وقلت لليل","https://www.poetsgate.com/ViewPoem.aspx?id=176471",""],[5937,"الثُّقب الأسود","https://www.poetsgate.com/ViewPoem.aspx?id=214121",""],[5956,"راعي","https://www.poetsgate.com/ViewPoem.aspx?id=184695",""],[5956,"صحوةُ غرام","https://www.poetsgate.com/ViewPoem.aspx?id=185064",""],[5956,"إني لأستجدي الحنان الطاهرا","https://www.poetsgate.com/ViewPoem.aspx?id=194639",""],[6089,"نهر السعادة","https://www.poetsgate.com/ViewPoem.aspx?id=213038",""],[6102,"هيت لك","https://www.poetsgate.com/ViewPoem.aspx?id=185305",""]],"verses":[["هَطَلَت مَدامِعُهُم عَلى وَجَناتِهِم","وَتَصاعِدَت مِن شَوقِهِم زَفَراتُ",0,"ت",1,0],["هطلتُ فأطفأتُ الصواعقَ عنكُمُ","فلم تَفْرِقوا بين الصواعقِ والهطلِ",1,"ل",1,0],["هَطِلٌ كغادِي السَّلمِ يجري صعدَهُ","فَوقَ الزّجَاجَةِ عَن أجبّ ثِقَالِ",2,"ل",1,0],["هَطَلَت عَلى العافينَ مِنكَ سَحائِبٌ","يُغني الوَليُّ وَليَّها عَن صَيفِهِ",3,"ف",2,0],["هَطلاءُ تَضحَكَُ كُلُّ زَهرَةِ صَفحَةٍ","عَنها وَتُعشِبُ كُلُّ ساحَةِ دارِ",4,"ر",1,0],["هَطلتْ حرَّى وراحت جهرةً","تتغَنّى فرحاً في المأتميْنْ",5,"ن",1,0],["هطلت ساعة تهول وَزالَت","غير أنا عَن الطَريق عدول",6,"ل",1,0],["هطَلْ لِنَجِيبٍ إِدْرَاكُ شَأْوٍ","فِي شَوْطِ علْيَائكَ الْفَسِيحِ",7,"ح",1,0],["هطلت وروت أرض حمير سحبه","فكأنهم لما عصوك استمطروا",8,"ر",3,0],["هَطْلاَءُ مِنْ رَوْحِ الذِي","أَبْقَى مَآثِرَهُ تُرَدَّدْ",9,"د",1,0],["هَطَلَتْ فِيهِ لَنَا سُحْبُ الْمُنَى","إِذْ جَرَى النَّهْرُ بِأَنْوَاعِ الْمِنَنْ",10,"ن",1,0],["هطل الغمام عَلى الحطيم وَزَمزَم","وَعَلى بقاع بالنقا وَوهاد",11,"د",1,0],["هطلت لعزته السحاب وَظللت","وَكَذا الرياح بنصر أَحمد أرسلت",12,"ت",1,0],["هَطَلَتْ لأرْبُعك الدوارس عبرتي","فكأنها يا ميُّ صَوْبَ غمام",13,"م",1,0],["هطل الغيث لها من فضة","فهي في قنواتها من ذهَب",14,"ب",1,0],["هَطِلاً بماءِ الوَرْدِ سَحَّ كَأَنَّما","والى فَرَوَّضَ سُنْدُساً وحريرا",15,"ر",2,0],["هطلتْ سحابةُ دمعِه فيها فما","حَفَلَتْ وقد بَخِلَ السحابُ الممطرُ",16,"ر",1,0],["هطلت عليهم أين كنت فأصبحوا","يدعونها بالديمة الهطلاء",17,"ا",2,0],["هطلتْ علينا بالسُّرورِ سماؤهُ","وجرتْ كواكبهُ بأسعدَ طائرِ",18,"ر",1,0],["هطلت كفّاه غيثاً","كاِنبجاسِ العارضينِ",19,"ن",1,0],["هَطلُ الغزالةِ مرجحنّ لم تزل","مُتواترات بالحيا أنواؤهُ",20,"ا",3,0],["هطلت غيوث نداك فاستحيى بها","عبد على ذا الفضل منك معوّدُ",21,"د",1,0],["هطلتنا السماء هطلا دراكا","عارضَ المرزمانِ فيها السماكا",22,"ك",2,1],["هطلت يداك على العفاة فأنعشت","بندى يديك على العفاة رمامها",23,"م",3,0],["هطلت بصوب البر راحته","فكأنما هي عارض هطلُ",24,"ل",1,0],["هطلت أدمع السحاب عليه","وقليل فيه دموع السحابِ",25,"ب",1,0],["هطلت دموع العين والقلب امتلا","جمراً وجسمي قد تناهبه البلا",26,"ل",2,1],["هطلت على أرجائه سحب الرضى","من حضرة الرحموت ما دام الملا",26,"ل",2,0],["هَطع البِشرُ علينا سَرْمداً","فَغَدونا للتهاني نَهْطع",27,"ع",1,0],["هَطَل المُزْنُ عَلَيْهِ","هَطَلاناً وانْسِكابا",28,"ب",2,0],["هطلت على ذاك الضريح برحمة","مزن الرضى وسحائب الغفران",29,"ن",1,0],["هطلت سحائب جوده لما غدا","في طيبها برق الثنايا يومض",30,"ض",1,0],["هطلت غياث الدمع من كبد السَما","هل تهطل الأكباد في الحزنِ العبر",31,"ر",1,0],["هطلَت سحائبُ جودهِ جودَ اللهى","جعلَ المراحم للبَريَّةِ منهَلا",32,"ل",2,0],["هطلنا بوادي المنحوان بليلنا","من المزن كل في أواخر مرزم",33,"م",1,0],["هطل العلى هاطل الأنعام كالسحب","ذا المكتفي غيث مجد ساكب الديم",34,"م",1,0],["هَطَلَت عَلَيكَ نُجُومُهَا","ويَدَاكَ مِن وَرَقٍ مُقَوَّى",35,"و",2,0],["هطلت منه سيولٌ أغرقتنا","فتدحرجنا شيوخاً وشبابا",36,"ب",2,0],["هَطْلُ الرّهامِ على وجوهِ ورودِنا","ريحُ الصّبا في الدّوحةِ الغنّاءِ",37,"ا",2,0],["هطلتْ سحائبُ رحمةٍ من ربّنا","فسَقَتْ مزارعَ , وانتشى العصفورُ",38,"ر",1,0],["هَطولونَ لا ينفكُّ غيثُ سَمائِكمْ","فإن لم يكن وبْلاً فأحقرُهُ طَلُّ",39,"ل",1,0],["هَطَلَتْ سيولٌ أمْ بَلاَ طُوفَانِها","جرفَ الدُّنى إذْ هَدَّ سَدَّ النَّهْضَهْ",40,"ض",2,1],["هطل السحاب على الربى ملثاثا","فغدت حبال المحل فيه رثاثا",41,"ث",2,1],["هَطولٌ على البحر الخفيف بغيمه","طروبٌ ومنه اللحن عذْبٌ مشوقُ",42,"ق",1,0],["هطلت عليه تحننا","وروى الوداد منابعه",43,"ع",2,0],["هطلتَ على الآفاق نورا لتعبرا","إلى ضفة الأزمان رمزا مسطّرا",44,"ر",2,1],["هطولٌ به قلبي شغوفٌ بزهره","ترانيمه قمحٌ ومزماره نجوى",45,"و",2,0],["هطلتم للورى يومي ندا ووغى","للمعتفي نعما والمعتدي نقما",46,"م",2,0],["هطولًا أيها المعنى علينا","ولا تسألْ لماذا، كيفَ، أينا!",47,"ن",2,1],["هطولًا يا سماءُ على المعنّى","وغني القطرَ أحسبُهُ يُغنّى",48,"ن",2,1],["هطولًا يا سماءُ، هرمتُ شوقًا","ويكفي الشوقُ كي نبدو هرمنا",48,"ن",2,0],["هطلت دموعي بالخدود غزارُ","وتوقدت بفؤاد زوجك نارُ",49,"ر",1,1],["هَطِلُ الأَنامِلِ تَسْتَهِلُّ هِباتُهُ","مِثْلَ السَّحابَةِ يَسْتَهِلُّ حَياها",50,"ا",3,0],["هطال جود لو رآه الحيا","لهام واستحيا لما قد رآه",51,"ا",2,0],["هَطَلَ الْجَمَالُ فَأَنْبَتَ التَبْدِيلَا","وَجَرَى بِأَسْرَارِ الخُلُودِ سُيُولَا",52,"ل",2,1],["هطلت عليك مصائب","وغدا عليك اليسر هاطلْ",53,"ل",1,0],["هطلتْ دموعي في رحيلكَ هادره","خطواتُ وصلكَ في دروبي حائره",54,"ر",2,1],["هطولُ سحابٍ وانتشاءُ جوانحٍ","ونَضْرَةُ ألوانٍ ونشوةُ عائمِ ؟",55,"م",1,0],["هطيلٌ مدنفٌ صبٌّ حريضٌ","عليلٌ منذ أنْ ألفى غرامهْ",56,"م",2,0],["هَطَلْتُ المَكَارِمَ فِي أُفْقِهَا","وَ كَنْتُ الرَّبِيعِ بُكُلِّ ارْتِواءْ",57,"ا",2,0],["هطلتْ على محرابهن سكينةٌ","لما بسطتَ على امتدادك معبدا",58,"د",2,0],["هطلتْ سكرتُ ، ولم أجد كشفاهها","سحباً تساقط في فمي أعنابا",59,"ب",2,0],["هطل الغيثُ غزيراً فوقهُ","واغتدت كلُّ الأراضي عارمة",60,"م",2,0],["هَطَل الغيثُ غزيراً عن مَدَاهُ","سابقاً ، والطير يشدو في النُّجودِ",61,"د",1,0],["هطل الهناء على البسيطة ماطرا","من قلبِ عبد الله كاملَ وافرا",62,"ر",2,1],["هطلت على قلبي الحروف فأورقا","وجرى به نهر السعادة مغدقا",63,"ق",2,1],["هَطَلَ الضِّيَاءُ بِمُقْلَتَيْكَ فَهَالَنِي","وَ ضِيَاءُ عَيْنِيَ لَوْ تَهَاطَلَ أَذْهَلَكْ",64,"ك",1,0]]}