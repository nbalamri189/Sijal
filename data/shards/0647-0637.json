{"poems":[[64,"طاب السماع وهبت النسمات","https://www.aldiwan.net/poem67575.html","الكامل"],[51,"لعمري لقد سهلت ما ليس بالسهل","https://www.aldiwan.net/poem65942.html","الطويل"],[32,"ما هاج شوقك من بلى الأطلال","https://www.aldiwan.net/poem27704.html","الكامل"],[66,"لاقيتنا ملقى الكريم لضيفه","https://www.aldiwan.net/poem41368.html","الكامل"],[74,"سمح الخيال على النوى بمزار","https://www.aldiwan.net/poem12955.html","الكامل"],[105,"أعجزنا أن نجوب المشرقين","https://www.aldiwan.net/poem42090.html","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85412","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54686","البسيط"],[160,"في كل يوم عارض لك يمطر","https://www.aldiwan.net/poem58991.html","الكامل"],[237,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[237,"قد حوينا كل ما شيء حسن","https://www.aldiwan.net/poem19277.html","الخفيف"],[271,"ضربت سعاد خيامها بفؤادي","https://www.aldiwan.net/poem52108.html","الكامل"],[271,"بمحمد خطر المحامد يعظم","https://www.aldiwan.net/poem52125.html","الكامل"],[416,"كف الملام فما يفيد ملامي","https://www.aldiwan.net/poem53993.html","الكامل"],[432,"نسخ الجد مقال اللعب","https://www.aldiwan.net/poem12556.html","الرمل"],[439,"كسيت بدولتك اليالي نورا","https://www.aldiwan.net/poem34851.html","الكامل"],[477,"بعد المزار فأنة وتذكر","https://www.aldiwan.net/poem15285.html","الكامل"]],"verses":[["هَطَلَت مَدامِعُهُم عَلى وَجَناتِهِم","وَتَصاعِدَت مِن شَوقِهِم زَفَراتُ",0,"ت",1,0],["هطلتُ فأطفأتُ الصواعقَ عنكُمُ","فلم تَفْرِقوا بين الصواعقِ والهطلِ",1,"ل",1,0],["هَطِلٌ كغادِي السَّلمِ يجري صعدَهُ","فَوقَ الزّجَاجَةِ عَن أجبّ ثِقَالِ",2,"ل",1,0],["هَطَلَت عَلى العافينَ مِنكَ سَحائِبٌ","يُغني الوَليُّ وَليَّها عَن صَيفِهِ",3,"ف",2,0],["هَطلاءُ تَضحَكَُ كُلُّ زَهرَةِ صَفحَةٍ","عَنها وَتُعشِبُ كُلُّ ساحَةِ دارِ",4,"ر",1,0],["هَطلتْ حرَّى وراحت جهرةً","تتغَنّى فرحاً في المأتميْنْ",5,"ن",1,0],["هطلت ساعة تهول وَزالَت","غير أنا عَن الطَريق عدول",6,"ل",1,0],["هطَلْ لِنَجِيبٍ إِدْرَاكُ شَأْوٍ","فِي شَوْطِ علْيَائكَ الْفَسِيحِ",7,"ح",1,0],["هطلت وروت أرض حمير سحبه","فكأنهم لما عصوك استمطروا",8,"ر",3,0],["هَطْلاَءُ مِنْ رَوْحِ الذِي","أَبْقَى مَآثِرَهُ تُرَدَّدْ",9,"د",1,0],["هَطَلَتْ فِيهِ لَنَا سُحْبُ الْمُنَى","إِذْ جَرَى النَّهْرُ بِأَنْوَاعِ الْمِنَنْ",10,"ن",1,0],["هطل الغمام عَلى الحطيم وَزَمزَم","وَعَلى بقاع بالنقا وَوهاد",11,"د",1,0],["هطلت لعزته السحاب وَظللت","وَكَذا الرياح بنصر أَحمد أرسلت",12,"ت",1,0],["هَطَلَتْ لأرْبُعك الدوارس عبرتي","فكأنها يا ميُّ صَوْبَ غمام",13,"م",1,0],["هطل الغيث لها من فضة","فهي في قنواتها من ذهَب",14,"ب",1,0],["هَطِلاً بماءِ الوَرْدِ سَحَّ كَأَنَّما","والى فَرَوَّضَ سُنْدُساً وحريرا",15,"ر",2,0],["هطلتْ سحابةُ دمعِه فيها فما","حَفَلَتْ وقد بَخِلَ السحابُ الممطرُ",16,"ر",1,0]]}