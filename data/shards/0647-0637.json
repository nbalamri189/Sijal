{"poems":[[64,"طاب السماع وهبت النسمات","https://www.aldiwan.net/poem67575.html","الكامل"],[51,"لعمري لقد سهلت ما ليس بالسهل","https://www.aldiwan.net/poem65942.html","الطويل"],[32,"ما هاج شوقك من بلى الأطلال","https://www.aldiwan.net/poem27704.html","الكامل"],[66,"لاقيتنا ملقى الكريم لضيفه","https://www.aldiwan.net/poem41368.html","الكامل"],[74,"سمح الخيال على النوى بمزار","https://www.aldiwan.net/poem12955.html","الكامل"],[105,"أعجزنا أن نجوب المشرقين","https://www.aldiwan.net/poem42090.html","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85412","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54686","البسيط"]],"verses":[["هَطَلَت مَدامِعُهُم عَلى وَجَناتِهِم","وَتَصاعِدَت مِن شَوقِهِم زَفَراتُ",0,"ت",1,0],["هطلتُ فأطفأتُ الصواعقَ عنكُمُ","فلم تَفْرِقوا بين الصواعقِ والهطلِ",1,"ل",1,0],["هَطِلٌ كغادِي السَّلمِ يجري صعدَهُ","فَوقَ الزّجَاجَةِ عَن أجبّ ثِقَالِ",2,"ل",1,0],["هَطَلَت عَلى العافينَ مِنكَ سَحائِبٌ","يُغني الوَليُّ وَليَّها عَن صَيفِهِ",3,"ف",2,0],["هَطلاءُ تَضحَكَُ كُلُّ زَهرَةِ صَفحَةٍ","عَنها وَتُعشِبُ كُلُّ ساحَةِ دارِ",4,"ر",1,0],["هَطلتْ حرَّى وراحت جهرةً","تتغَنّى فرحاً في المأتميْنْ",5,"ن",1,0],["هطلت ساعة تهول وَزالَت","غير أنا عَن الطَريق عدول",6,"ل",1,0],["هطَلْ لِنَجِيبٍ إِدْرَاكُ شَأْوٍ","فِي شَوْطِ علْيَائكَ الْفَسِيحِ",7,"ح",1,0]]}