et/poem37341.html","الكامل"],[536,"بمكتبة ابن زيدان حللت","https://www.aldiwan.net/poem47967.html","عموديه"],[536,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[549,"أمالك من غرام ما أمالا","https://www.aldiwan.net/poem47319.html","الوافر"],[549,"على مثل هذا اليوم تحنى الرواجب","https://www.aldiwan.net/poem48099.html","الطويل"],[556,"ظن الجهول بأنه مستيقظ","https://www.aldiwan.net/poem33543.html","الكامل"],[560,"هذا قران حسين قد كتبت له","https://www.aldiwan.net/poem52644.html","البسيط"],[560,"أرى الدهر يقضي كل يوم ديونه","https://www.aldiwan.net/poem52787.html","الطويل"],[560,"ألناس في الدهر لفظ أنت معناه","https://www.aldiwan.net/poem52808.html","البسيط"],[560,"أتعلم ما هاجت بقلبي من الشغل","https://www.aldiwan.net/poem52926.html","الطويل"],[573,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"]],"verses":[["ظَفِرتَ بِما اِشتَهَيتَ مِنَ اللَيالي","وَأُعطيتَ المُرادَ مِنَ الأَماني",0,"ي",1,0],["ظَفِرتُ بِالنَفَلِ المَطلوبِ في وَطَني","وَإِنَّما يَرجِعُ الغازونَ بِالنَفَلِ",1,"ل",1,0],["ظَفِرتَ بِما اِشتَهَيتَ وَأَنتَ وانٍ","وَنالَ البَعضُ غَيرَكَ وَهوَ ساعٍ",2,"ع",1,0],["ظَفِرٌ بِالأُمورِ جَلدٌ نَجيبٌ","وَإِذا ما سَما لِحَربٍ أَباحا",3,"ح",2,0],["ظفرت يدايَ بكلّ ما أمّلتُه","في النفس أو في الجاه أو في المالِ",4,"ل",1,0],["ظفرت على قران السعد فيه","بشمسِ الحسنِ من شمسِ السماح",5,"ح",1,0],["ظفرت على رغم الرَّقيب بطيفها","وقد طردت خلف الثريا النعائم",6,"م",1,1],["ظفرتْ بمالئِ ناظريها بهجةً","وضميرها نُبلاً وكفَّيْها كرمْ",7,"م",1,0],["ظفرتَ بما تبغي وسيفُك مغمدٌ","وما كان لو جرَّدته بكهامِ",8,"م",1,0],["ظفرت يداهُ في اللقا","ء بسهم فلّاجٍ سَهُوم",9,"م",1,0],["ظفِرتْ يداك من الوزير بقيِّم","تأتي نصيحتُه بلا استكراه",10,"ه",1,0],["ظَفِرنا بِما نَهوى مِنَ الأُنسِ وَحدَهُ","وَلَسنا إِلى ماخَلفَهُ نَتَطَرَّفُ",11,"ف",1,0],["ظَفَرتُ بِقُربِكِ بَعدَ اِمتِناعٍ","فَمِن ذاكَ سُمِّتُ بِالظافِرِ",12,"ر",1,0],["ظفر الروض بالهزار اخيرا","بعد طول انتظاره للهزار",13,"ر",1,0],["ظفرت بقرب من حيناً فسرني","ولكن سريعاً ما انقضت دولة القرب",14,"ب",1,0],["ظَفِرَت بِالكِبرِ مِن مُستَكبِرٍ","ظافِرِ الأَيّامِ مَنصورِ لِواها",15,"ا",3,0],["ظَفِرَت بِجَوهَرَةٍ فَذَّةٍ","مِنَ الشَرَفِ العَبقَرِيِّ اليُمُن",16,"ن",1,0],["ظَفَرَت بِيونانَ القَديمَةِ حِكمَتي","وَغَزا الحَديثَةَ ظافِراً غازيكِ",17,"ك",1,0],["ظَفِرنا بِهِ وَجهاً فَظَنَّ تَعَقُّباً","وَماذا يَزيدُ الظافِرينَ التَعَقُّبُ",18,"ب",1,0],["ظَفَرٌ أَذَلَّ لآلِ فارسَ منكمُ","بسيوفِ مَشرَفَ أو رِماحِ رُدَيْنِ",19,"ن",1,0],["ظَفَرَت يداك أبا المظفر بالتي","كانَ الزمانُ بها يَضَنُّ ويَبخَلُ",20,"ل",1,0],["ظَفِرَتْ يَداهُ بمُهجَةِ الدَّنِّ الذي","غَبَرَتْ وديعةُ صدرِه وصِدارِه",21,"ر",2,0],["ظَفِرَت سِهامُ فَواتِرِ الأَلحاظِ","فَرَمَت صَميمَ قُلوبِنا بِشُواظِ",22,"ظ",1,1],["ظِفري لِسِنّي قارِعٌ وَمَدامِعي","قَد خَدَّدَت خَدِّيَ بِالإِلظاظِ",22,"ظ",1,0],["ظَفرٌ بِهِ رَدَّ العُداةَ بِغَيظِهِم","مُذ أَنَّهُم عَلِموا بِمَن أَنا حاظي",22,"ي",1,0],["ظَفَروا بِظِلِّكَ يا مَليكُ فَإِنَّهُم","بِوَلاكَ قَد فازوا بِخَيرِ حِفاظِ",22,"ظ",1,0],["ظَفِرَت بِكَ الأَيّامُ بَعدَ تَمَنُّعٍ","ظَفَرَ الهُمومِ بِعاشِقٍ لَم يَظفَرِ",23,"ر",1,0],["ظَفِرُوا بِحربٍ مِن كَتائبِ طارقٍ","كانت لأنْدَلُسٍ بَشيرَ سَلامِ",24,"م",1,0],["ظَفرتِ به دُوني وإنّي بواحِدي","وَجَدِّكِ إلا أنْ تلومِي لَقَانعُ",25,"ع",1,0],["ظَفِرْتَ بِهِ يا توأمَ النَّصْرِ تَوْأمَاً","لما نِلتَ من مجدٍ على الدّهرِ دائبِ",26,"ب",1,0],["ظَفِرْتَ من النبيِّ بخيرِ نُعْمَى","تَطيبُ بها النُّفوسُ الصّالحاتُ",27,"ت",1,0],["ظفروا إذ قَبَّلوا خيرَ يَدٍ","وخِيارُ النّاسِ أوْلَى بالظَّفرْ",28,"ر",1,0],["ظَفرتَ وفازَ بالنُّعْمَى زُهَيْرٌ","وهل لكما سِوَى ما ترجوانِ",29,"ن",1,0],["ظَفِرتُ بِهِ وَنَجمُ الصُبحِ بادٍ","عِبادِيّاً عَلى دينِ المَسيحِ",30,"ح",1,0],["ظَفِرَت كَفَّ أَريبٍ","باعَ بِرّاً بِجُناحِ",31,"ح",1,0],["ظفرتُ بهِ وقد علِقَتهُ كفّي","على دهشٍ مقالة مستهام",32,"م",1,0],["ظفرت بالمنى","في ليلة هنا",33,"ن",2,1],["ظَفِرْتُ بها خالَ النّجاء وعمَّهُ","وجَدَّ الفتى عَصْرَ الشّبيبةِ والخال",34,"ل",1,0],["ظَفِرْتُ بِهِ في حِقْبَةٍ فَقَنَصْتُهُ","عَلَى غِرَّةِ الأَيَّامِ وَاللَّهْوُ يُقْنَصُ",35,"ص",1,0],["ظَفَرت أَظافِرَه بِأَصيدِ أَصيَدٍ","فَعَجِبتُ كَيفَ أَصابَهُ وَتَخَلَّصا",36,"ص",2,0],["ظفري يَدُ المَوتِ قَلَّمتَهُ","آهاً وَإِن كانَ لي اِتِّعاظُ",37,"ظ",1,0],["ظَفرت بي وَاِتَّقَيتُ رَبّي","فَلَم يَكُن بَينَنا مِظاظُ",37,"ظ",1,0],["ظَفرتُ بِقُربٍ مِنك حَتّى إِذا صَفَت","حَياتي وَأَدنَتني إِلَيك حُظوظُ",38,"ظ",1,1],["ظَفِرَتْ بالعَبْقَرِي المُرْتَجَى","فاسْتَجَابَتْ للعُلا لمَّا دَعاها",39,"ا",3,0],["ظفرتْ بماليء ناظريها بهجة ً","وضميرها نُبلا وكفَّيْها كرم",40,"م",1,0],["ظفرت تزال في اللقا","ء بسهم فلاجٍ سَهُوم",41,"م",1,0],["ظفرتْ بالكبر من مستكبرٍ","وسيوفُ الهندِ لم تصحُ ظباها",42,"ا",3,0],["ظَفرت بِمَدحِهِ فَعَلَوت قَدراً","وَسَماني الزَمان بِهِ أَديبا",43,"ب",2,0],["ظفرنا وأُبْنا سَالمِين بعونه","بنصرٍ عزيزٍ قد رجوناهُ قبل مَا",44,"م",2,0],["ظفِرتَ وويلُ امّها حُظوةً","ببدرٍ تُزرُّ عليه الجيوبُ",45,"ب",1,0],["ظَفِرَت بِالمُرادِ عِندَكَ آما","لي وَأَعيا عَلى الزَمانِ خِلافي",46,"ف",2,0],["ظَفَرٌ جَميعُ الطيبِ أَضحى كاسِداً","مُذ أَصبَحَت أَخبارُهُ تُتَنَسَّمُ",47,"م",1,0],["ظفروا بكنز العلم واتصفوا بحسن","الوصف وانصفتوا إلى الاحباب",48,"ب",1,0],["ظَفَرتُ بِوَصلٍ لَم يَدُم لِي زَمَانُهُ","وَيُذهِبُ لَذَّاتِ المَنَامِ التَّيَقّظُ",49,"ظ",1,0],["ظفرتْ يداك به وتلك دلالةٌ","تنبي بكونك في الحروب مظفّرا",50,"ر",2,0],["ظفرت بكفو ما ظفرت بمثلهِ","في ملك قالت ليحيى مكافيا",51,"ي",2,0],["ظفرَتْ يداها بالمنى فليهنها","ما قد هناكَ بوصلها وهَنانا",52,"ن",2,0],["ظفرت بها تبدى لك الحق واضحا","وتكشف أمراً كلفوك له حملا",53,"ل",2,0],["ظَفِرَت بِأَوفَرِ حَظِّها عَينٌ إِذا","ظَلَّت تُرامِقُ حِبَّها وَتُلاحِظُ",54,"ظ",1,0],["ظَفرتَ بالنّعمةِ الكُبرى بِأوجٍ عَلى","أَرِّختَهُ كُنتَ فيهِ لابسَ الظفَرِ",55,"ر",1,0],["ظفرٌ على ظفر ونابٌ ينتحي","ناباً فأين ترى التوحش يبعدُ",56,"د",1,0],["ظفرت بالسؤل منها بعدما","نابها رزئك اسراب النسور",57,"ر",1,0],["ظفرت لو أني تطفلت أو","لبست لكل زمان لبوس",58,"س",1,0],["ظفرت بلثم راحته وراحي","وفزت من الوصال براحتين",59,"ن",1,0],["ظفرنا به بعدَ الضَّلالة فاعتلى","بارشادهِ فوقَ السماء لنا حَظُّ",60,"ظ",1,0],["ظفرت على حكم المنى بمنائها","وحاولت منها صحتي وبها نكسي",61,"ي",1,0],["ظفروا لأن صُفوفَهم مَرصُوصَةٌ","في زَحفِها الإسداءُ والإلحام",62,"م",1,0],["ظَفِرَت وَما صَفِرَت لِمَن","يَمتاحُهُ في الدَهرِ راحَه",63,"ح",2,0],["ظَفِرت يدُ الأيّامِ منهُ بماجدٍ","حبرٍ سريٍّ أريحيٍّ أَلمعي",64,"ع",2,0],["ظَفِرَ الطَّالِبُونَ وَاتَّصَلَ الوصلُ","وَفَازَ الأَحبَابُ بالأحبَابِ",65,"ب",1,1],["ظَفرت بِما ظَفر الكِرام بِهِ عَلى","رَغم اللئام ترفّهاً وَتَنعّما",66,"م",2,0],["ظفّره اللَه بِنَيل المُنى","فَجاءَ تاريخ الهَنا ظَفّرَه",67,"ر",2,0],["ظُفْرٌ له ظَفَرٌ ونابٌ ما نَبا","حتّى أعادَ عَدُوَّه مَأكولا",68,"ل",2,0],["ظَفِرتُ عَلى رُغمِ اللَيالي بِكَوكَبٍ","يُقِرُّ لَهُ بَدرُ السَما وَالكَواكِبُ",69,"ب",1,1],["ظَفِرتْ بقتْلِ ابْنِ النّبيّ وإنّما","ذَهبَتْ بخزيٍ ظاهرٍ وبوارٍ",70,"ر",1,0],["ظفَرُ بنُ عبدِ اللهِ أك","رَمُ من يُصافِيهِ المُصافي",71,"ف",2,1],["ظَفَرَ الأَسى بِمُتَيَّم لَم يَظفَر","قَصُرَ المَنامُ وَليله لَم يقصُرِ",72,"ر",1,1],["ظَفِراً في يَدِ الأَمانيَ تَلقاهُ","وَتَلقاهُ لِلمَنِيَّةِ ظُفرا",73,"ر",2,0],["ظَفِرَت بَنو ساقي الحَجيجِ بِحَقِّهِم","وَغُرِرتُمُ بِتَوَهُّمِ الأَحلامِ",74,"م",1,0],["ظَفِرتَ فَلا شَلَّت يَدٌ بَر مَكِيَّةٌ","رَتَقتَ بِها الفَتقَ الَّذي بَينَ هاشِم",75,"م",1,1],["ظَفِرَتْ يدُ الأيام منه بجوهر","قَد حَيَّر الألباب جوهر فرده",76,"د",2,0],["ظفِرْتُ به حُساماً ليس ينبو","نُبُوَّ مضارب السَّيف الكهام",77,"م",1,0],["ظَفِرَتْ يدي منه بأكرم ماجدٍ","نظمت قوافي الشعر في تمجيده",78,"د",2,0],["ظَفِرنا من نَداك بما نرجّي","على أَنْ ما ظَفِرنا في مثالك",79,"ك",1,0],["ظفرتُ بهم غرَّ الوجوه أماجداً","بكلِّ جليل القدر وابن جليل",80,"ل",1,0],["ظفرت به دون الأنام بماجدٍ","قؤولٍ بما قالَ الكرام فعول",80,"ل",1,0],["ظفرنا رأينا كهلهم كفتيّهم","حماةٌ بماضيهم وفي سمهريِّهم",81,"م",1,0],["ظفرت يداه بالعلى","رغماً على كيد النظير",82,"ر",1,0],["ظفرت بهنّ يد المنو","ن وهيجت منا الخواطر",83,"ر",1,0],["ظَفِرَ الإِغْتِباقُ منها بحَظٍّ","لم يَخِبْ عنه وافِدُ الاصْطِباحِ",84,"ح",1,0],["ظفَروا لأن أبا المظفّرِ صائلٌ","فيهم بأطولِ ساعدٍ ومُساعدِ",85,"د",1,0],["ظفرَ اللئيمُ بها فمزّقَها","بالجهلِ بين النابِ والظُفْرِ",86,"ر",1,0],["ظفرت يداي بصاحب أنا واثق","منه بكل عجيبة أن يخلقا",87,"ق",2,0],["ظفرت يداه بمهجتي فتكاكا","ظفرت بجود الملك زنكيّ يدي",88,"ي",1,0],["ظُفْر تُرى ما أراه أم نابُ","أم تلك للدهر فيَّ أوصابُ",89,"ب",1,1],["ظفِرتُ منك بكنزٍ ما نَصِبْتُ له","سعيا ولا كدَّني معطيه بالمنن",90,"ن",1,0],["ظفِرتُ بحقّ المنى فيكُمُ","فما ليَ أرعى الخيالَ الخَدوعا",91,"ع",2,0],["ظَفِرتَ وها هو تحت الإسا","ر يأكل زائدَ أظفارِهِ",92,"ر",2,0],["ظفرت فأوف الله شكراً فإنه","يزدك علاءً أن تزدهُ تضرُّعا",93,"ع",2,0],["ظفرت كفُّها من الأصفها","ني عشياً بأوفر الأقسامِ",94,"م",1,0],["ظفرَ العفاة السائلوك بفاعلٍ","جمِّ النّوال وقد قنعتُ بقائل",95,"ل",1,0],["ظفرت مني بعلق","فلا تبعني ببخس",96,"س",1,0],["ظَفِرَتْ يَدَاكَ بِمَنْبَعِ الْعِلْمِ الّذِي","يُروَى عَنِ الْمَعْصُومِ رَأْيٌ خَادِعُ",97,"ع",1,0],["ظفِرتُ بها بِيَنبوعِ زُلالٍ","بِمَورِدِه نَهلتُ كما عَللتُ",98,"ت",1,0],["ظَفِرتَ بأربابِ الحَفائظِ بَعدَما","عفوتَ وبعدَ العفوِ أولَيتَهُم بِرَّا",99,"ر",2,0],["ظفرتَ بها وضيفك من بعيدٍ","يرى ما كان فيه إليك آلا",100,"ل",2,0],["ظَفرتُمْ بِما لَم نَحظَ مِنهُ بنَهْلةٍ","وَلَذَّت لَكُم دونَ الأَنامِ المَشاربُ",101,"ب",1,0],["ظفرت يدي بيد المدير وكاسنا","باق وقلبي بالطلا يتلمظ",102,"ظ",1,0],["ظَفِرتَ بالحُسنِ والحُسنَى على قدَرٍ","فلا بَرِحتَ مدَى التَّأريخِ في ظَفَرِ",103,"ر",1,0],["ظَفِرتِ من اللهِ الذي يَهَبُ المُنَى","بما أنتِ في تاريخِهِ تبتَغِينهُ",104,"ن",2,0],["ظَفِرْتَ في طاعةِ الباري بنعمتِهِ","والنَّاسُ تَدعُو جميعاً زادَكَ اللهُ",105,"ه",1,0],["ظَفِرنا بها من جُودِ أكرَمِ مُرسِلٍ","علينا فكانَتْ عِندنا أكرَمَ الرُسْلِ",106,"ل",1,0],["ظَفِرَ النَّاسُ بالقشورِ من السَّعْ","دِ وحَازَ الأَجَلُّ جُلَّ اللُّبِّ",107,"ب",1,0]]}