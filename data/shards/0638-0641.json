يل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123526","الخفيف"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45936","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81690","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73115","الخفيف"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104518","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33594","السريع"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33306","الرجز"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33521","الرمل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33734","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33690","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139598",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139707",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139695",""],[4674,"منصور","https://www.poetsgate.com/ViewPoem.aspx?id=207086",""],[4679,"حتى مَ نلهو والمنية تنذر","https://www.poetsgate.com/ViewPoem.aspx?id=142723",""],[4679,"مرحباً بالكرام أهل الحمَّية","https://www.poetsgate.com/ViewPoem.aspx?id=142757",""],[416,"طَافَ الخَيالُ وَحَيِّهِ بِسَلامِ","https://www.poetsgate.com/ViewPoem.aspx?id=22402",""],[4778,"بنات الحور","https://www.poetsgate.com/ViewPoem.aspx?id=190426",""],[4816,"ظفار","https://www.poetsgate.com/ViewPoem.aspx?id=199473",""],[4867,"خذو مكتوبي","https://www.poetsgate.com/ViewPoem.aspx?id=29063",""],[4966,"ظعنْتَ","https://www.poetsgate.com/ViewPoem.aspx?id=196585",""],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[460,"بَخِلَتْ رَقاشِ بوُدِّها ونَوالِها","https://www.poetsgate.com/ViewPoem.aspx?id=22213",""],[4119,"هي جنة المأوى فهل من خاطب","https://www.poetsgate.com/ViewPoem.aspx?id=16089",""],[5183,"ملغزه رق156م","https://www.poetsgate.com/ViewPoem.aspx?id=186397",""],[5213,"ظفرت أمير المؤمنين لك البشر","https://www.poetsgate.com/ViewPoem.aspx?id=170489",""],[5370,"البطاقه الشخصيه","https://www.poetsgate.com/ViewPoem.aspx?id=87464",""],[2110,"ظن المتيم قد سلا فاغتاظا","https://www.poetsgate.com/ViewPoem.aspx?id=156279",""],[5776,"فهارس الفراغ","https://www.poetsgate.com/ViewPoem.aspx?id=199335",""],[469,"جزتَ في المجد والفعال الشريفِ","https://www.poetsgate.com/ViewPoem.aspx?id=76859",""],[5861,"وألوذ بي","https://www.poetsgate.com/ViewPoem.aspx?id=193774",""],[5894,"ظبي بدا بفوائز الألحاظ","https://www.poetsgate.com/ViewPoem.aspx?id=131426",""],[199,"عَرَفَ الدِّيَارَ تَوَهُّماً فاعْتَادَهَا","https://www.poetsgate.com/ViewPoem.aspx?id=20775",""]],"verses":[["ظَفِرتَ بِما اِشتَهَيتَ مِنَ اللَيالي","وَأُعطيتَ المُرادَ مِنَ الأَماني",0,"ن",2,0],["ظَفِرتُ بِالنَفَلِ المَطلوبِ في وَطَني","وَإِنَّما يَرجِعُ الغازونَ بِالنَفَلِ",1,"ل",1,0],["ظَفِرتَ بِما اِشتَهَيتَ وَأَنتَ وانٍ","وَنالَ البَعضُ غَيرَكَ وَهوَ ساعٍ",2,"ع",1,0],["ظَفِرٌ بِالأُمورِ جَلدٌ نَجيبٌ","وَإِذا ما سَما لِحَربٍ أَباحا",3,"ح",2,0],["ظفرت يدايَ بكلّ ما أمّلتُه","في النفس أو في الجاه أو في المالِ",4,"ل",1,0],["ظفرت على قران السعد فيه","بشمسِ الحسنِ من شمسِ السماح",5,"ح",1,0],["ظفرت على رغم الرَّقيب بطيفها","وقد طردت خلف الثريا النعائم",6,"م",1,1],["ظفرتْ بمالئِ ناظريها بهجةً","وضميرها نُبلاً وكفَّيْها كرمْ",7,"م",1,0],["ظفرتَ بما تبغي وسيفُك مغمدٌ","وما كان لو جرَّدته بكهامِ",8,"م",1,0],["ظفرت يداهُ في اللقا","ء بسهم فلّاجٍ سَهُوم",9,"م",1,0],["ظفِرتْ يداك من الوزير بقيِّم","تأتي نصيحتُه بلا استكراه",10,"ه",1,0],["ظَفِرنا بِما نَهوى مِنَ الأُنسِ وَحدَهُ","وَلَسنا إِلى ماخَلفَهُ نَتَطَرَّفُ",11,"ف",1,0],["ظَفَرتُ بِقُربِكِ بَعدَ اِمتِناعٍ","فَمِن ذاكَ سُمِّتُ بِالظافِرِ",12,"ر",1,0],["ظفر الروض بالهزار اخيرا","بعد طول انتظاره للهزار",13,"ر",1,0],["ظفرت بقرب من حيناً فسرني","ولكن سريعاً ما انقضت دولة القرب",14,"ب",1,0],["ظَفِرَت بِالكِبرِ مِن مُستَكبِرٍ","ظافِرِ الأَيّامِ مَنصورِ لِواها",15,"ا",3,0],["ظَفِرَت بِجَوهَرَةٍ فَذَّةٍ","مِنَ الشَرَفِ العَبقَرِيِّ اليُمُن",16,"ن",1,0],["ظَفَرَت بِيونانَ القَديمَةِ حِكمَتي","وَغَزا الحَديثَةَ ظافِراً غازيكِ",17,"ك",1,0],["ظَفِرنا بِهِ وَجهاً فَظَنَّ تَعَقُّباً","وَماذا يَزيدُ الظافِرينَ التَعَقُّبُ",18,"ب",1,0],["ظَفَرٌ أَذَلَّ لآلِ فارسَ منكمُ","بسيوفِ مَشرَفَ أو رِماحِ رُدَيْنِ",19,"ن",1,0],["ظَفَرَت يداك أبا المظفر بالتي","كانَ الزمانُ بها يَضَنُّ ويَبخَلُ",20,"ل",1,0],["ظَفِرَتْ يَداهُ بمُهجَةِ الدَّنِّ الذي","غَبَرَتْ وديعةُ صدرِه وصِدارِه",21,"ر",2,0],["ظَفِرَت سِهامُ فَواتِرِ الأَلحاظِ","فَرَمَت صَميمَ قُلوبِنا بِشُواظِ",22,"ظ",1,1],["ظِفري لِسِنّي قارِعٌ وَمَدامِعي","قَد خَدَّدَت خَدِّيَ بِالإِلظاظِ",22,"ظ",1,0],["ظَفرٌ بِهِ رَدَّ العُداةَ بِغَيظِهِم","مُذ أَنَّهُم عَلِموا بِمَن أَنا حاظي",22,"ظ",2,0],["ظَفَروا بِظِلِّكَ يا مَليكُ فَإِنَّهُم","بِوَلاكَ قَد فازوا بِخَيرِ حِفاظِ",22,"ظ",1,0],["ظَفِرَت بِكَ الأَيّامُ بَعدَ تَمَنُّعٍ","ظَفَرَ الهُمومِ بِعاشِقٍ لَم يَظفَرِ",23,"ر",1,0],["ظَفِرُوا بِحربٍ مِن كَتائبِ طارقٍ","كانت لأنْدَلُسٍ بَشيرَ سَلامِ",24,"م",1,0],["ظَفرتِ به دُوني وإنّي بواحِدي","وَجَدِّكِ إلا أنْ تلومِي لَقَانعُ",25,"ع",1,0],["ظَفِرْتَ بِهِ يا توأمَ النَّصْرِ تَوْأمَاً","لما نِلتَ من مجدٍ على الدّهرِ دائبِ",26,"ب",1,0],["ظَفِرْتَ من النبيِّ بخيرِ نُعْمَى","تَطيبُ بها النُّفوسُ الصّالحاتُ",27,"ت",1,0],["ظفروا إذ قَبَّلوا خيرَ يَدٍ","وخِيارُ النّاسِ أوْلَى بالظَّفرْ",28,"ر",1,0],["ظَفرتَ وفازَ بالنُّعْمَى زُهَيْرٌ","وهل لكما سِوَى ما ترجوانِ",29,"ن",1,0],["ظَفِرتُ بِهِ وَنَجمُ الصُبحِ بادٍ","عِبادِيّاً عَلى دينِ المَسيحِ",30,"ح",1,0],["ظَفِرَت كَفَّ أَريبٍ","باعَ بِرّاً بِجُناحِ",31,"ح",1,0],["ظفرتُ بهِ وقد علِقَتهُ كفّي","على دهشٍ مقالة مستهام",32,"م",1,0],["ظفرت بالمنى","في ليلة هنا",33,"ن",2,1],["ظَفِرْتُ بها خالَ النّجاء وعمَّهُ","وجَدَّ الفتى عَصْرَ الشّبيبةِ والخال",34,"ل",1,0],["ظَفِرْتُ بِهِ في حِقْبَةٍ فَقَنَصْتُهُ","عَلَى غِرَّةِ الأَيَّامِ وَاللَّهْوُ يُقْنَصُ",35,"ص",1,0],["ظَفَرت أَظافِرَه بِأَصيدِ أَصيَدٍ","فَعَجِبتُ كَيفَ أَصابَهُ وَتَخَلَّصا",36,"ص",2,0],["ظفري يَدُ المَوتِ قَلَّمتَهُ","آهاً وَإِن كانَ لي اِتِّعاظُ",37,"ظ",1,0],["ظَفرت بي وَاِتَّقَيتُ رَبّي","فَلَم يَكُن بَينَنا مِظاظُ",37,"ظ",1,0],["ظَفرتُ بِقُربٍ مِنك حَتّى إِذا صَفَت","حَياتي وَأَدنَتني إِلَيك حُظوظُ",38,"ظ",1,1],["ظَفِرَتْ بالعَبْقَرِي المُرْتَجَى","فاسْتَجَابَتْ للعُلا لمَّا دَعاها",39,"ا",3,0],["ظفرتْ بماليء ناظريها بهجة ً","وضميرها نُبلا وكفَّيْها كرم",40,"م",1,0],["ظفرت تزال في اللقا","ء بسهم فلاجٍ سَهُوم",41,"م",1,0],["ظفرتْ بالكبر من مستكبرٍ","وسيوفُ الهندِ لم تصحُ ظباها",42,"ا",3,0],["ظفرت برحمتك الحياة وصنتها","عن كلّ ناعسة الجفون رداح",43,"ح",1,0],["ظَفرت بِمَدحِهِ فَعَلَوت قَدراً","وَسَماني الزَمان بِهِ أَديبا",44,"ب",2,0],["ظفرنا وأُبْنا سَالمِين بعونه","بنصرٍ عزيزٍ قد رجوناهُ قبل مَا",45,"م",2,0],["ظفِرتَ وويلُ امّها حُظوةً","ببدرٍ تُزرُّ عليه الجيوبُ",46,"ب",1,0],["ظَفِرَت بِالمُرادِ عِندَكَ آما","لي وَأَعيا عَلى الزَمانِ خِلافي",47,"ف",2,0],["ظَفَرٌ جَميعُ الطيبِ أَضحى كاسِداً","مُذ أَصبَحَت أَخبارُهُ تُتَنَسَّمُ",48,"م",1,0],["ظفروا بكنز العلم واتصفوا بحسن","الوصف وانصفتوا إلى الاحباب",49,"ب",1,0],["ظَفَرتُ بِوَصلٍ لَم يَدُم لِي زَمَانُهُ","وَيُذهِبُ لَذَّاتِ المَنَامِ التَّيَقّظُ",50,"ظ",1,0],["ظفرتْ يداك به وتلك دلالةٌ","تنبي بكونك في الحروب مظفّرا",51,"ر",2,0],["ظفرت بكفو ما ظفرت بمثلهِ","في ملك قالت ليحيى مكافيا",52,"ي",2,0],["ظفرَتْ يداها بالمنى فليهنها","ما قد هناكَ بوصلها وهَنانا",53,"ن",2,0],["ظفرت بها تبدى لك الحق واضحا","وتكشف أمراً كلفوك له حملا",54,"ل",2,0],["ظَفِرَت بِأَوفَرِ حَظِّها عَينٌ إِذا","ظَلَّت تُرامِقُ حِبَّها وَتُلاحِظُ",55,"ظ",1,0],["ظَفرتَ بالنّعمةِ الكُبرى بِأوجٍ عَلى","أَرِّختَهُ كُنتَ فيهِ لابسَ الظفَرِ",56,"ر",1,0],["ظفرٌ على ظفر ونابٌ ينتحي","ناباً فأين ترى التوحش يبعدُ",57,"د",1,0],["ظفرت بالسؤل منها بعدما","نابها رزئك اسراب النسور",58,"ر",1,0],["ظفرت لو أني تطفلت أو","لبست لكل زمان لبوس",59,"س",1,0],["ظفرت بلثم راحته وراحي","وفزت من الوصال براحتين",60,"ن",1,0],["ظفرنا به بعدَ الضَّلالة فاعتلى","بارشادهِ فوقَ السماء لنا حَظُّ",61,"ظ",1,0],["ظفرت على حكم المنى بمنائها","وحاولت منها صحتي وبها نكسي",62,"س",2,0],["ظفروا لأن صُفوفَهم مَرصُوصَةٌ","في زَحفِها الإسداءُ والإلحام",63,"م",1,0],["ظَفِرَت وَما صَفِرَت لِمَن","يَمتاحُهُ في الدَهرِ راحَه",64,"ح",2,0],["ظَفِرت يدُ الأيّامِ منهُ بماجدٍ","حبرٍ سريٍّ أريحيٍّ أَلمعي",65,"ع",2,0],[