{"poems":[[53,"أمن شوق تعانقني الأماني","https://www.aldiwan.net/poem29668.html","الوافر"],[53,"أهلا بهن على التنويل والبخل","https://www.aldiwan.net/poem29905.html","البسيط"],[53,"طلاب العز من شيم الشجاع","https://www.aldiwan.net/poem30155.html","الوافر"],[10,"لا تخل أنني لقيت رواحا","https://www.aldiwan.net/poem21066.html","الخفيف"],[83,"ما للحمول تحن للأطلال","https://www.aldiwan.net/poem54250.html","الكامل"],[72,"وبأيمن طالع عقد سني","https://www.aldiwan.net/poem18492.html","الوافر"],[72,"ظفرت على رغم الرقيب بطيفها","https://www.aldiwan.net/poem20143.html","الطويل"],[51,"يا سيد العرب الذي قدرت له","https://www.aldiwan.net/poem66048.html","الكامل"],[51,"قدمت قدوم البرء بعد سقام","https://www.aldiwan.net/poem66059.html","الطويل"],[51,"شغل المحب عن الرسوم","https://www.aldiwan.net/poem66332.html","مجزوء الكامل"],[51,"يا طول غلة نفسي المبلاه","https://www.aldiwan.net/poem66717.html","الكامل"],[70,"أأحبابنا ما ذا الرحيل الذي دنا","https://www.aldiwan.net/poem42814.html","الطويل"],[78,"مشمك أفوح في معطسي","https://www.aldiwan.net/poem13990.html","المتقارب"],[89,"الأغاني تصبي ولست بدار","https://www.aldiwan.net/poem44756.html","الكامل"],[89,"كتاب رثاء يحمل البث من قلبي","https://www.aldiwan.net/poem44958.html","الطويل"],[85,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[85,"مضى الدهر بابن إمام اليمن","https://www.aldiwan.net/poem8111.html","المتقارب"],[85,"قم ناد أنقرة وقل يهنيك","https://www.aldiwan.net/poem63757.html","الكامل"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[61,"سدت سيوفك خلة الثغرين","https://www.aldiwan.net/poem51413.html","الكامل"],[61,"سعد حبيت به وجد مقبل","https://www.aldiwan.net/poem51472.html","الكامل"],[61,"ما سره أن ذاع من أسراره","https://www.aldiwan.net/poem51672.html","الكامل"],[66,"ظفرت سهام فواتر الألحاظ","https://www.aldiwan.net/poem38485.html","الكامل"],[44,"أغزال قولي للغزال الأحور","https://www.aldiwan.net/poem30038.html","الكامل"],[105,"أدر الحديث وطف على الأقوام","https://www.aldiwan.net/poem42048.html","الكامل"],[105,"هو الحكم أمضته السيوف القواطع","https://www.aldiwan.net/poem43054.html","الطويل"],[105,"بني مرة اقضوا أمركم قبل غالب","https://www.aldiwan.net/poem43576.html","الطويل"],[105,"أمنك فزارة انبعث الغزاة","https://www.aldiwan.net/poem43992.html","الوافر"],[105,"مرحبا بالوفد وافى من هجر","https://www.aldiwan.net/poem44012.html","المتقارب"],[105,"هوازن أقبلي ماذا التواني","https://www.aldiwan.net/poem44036.html","الطويل"],[48,"شريت الفتك بالثمن الربيح","https://www.aldiwan.net/poem62512.html","الوافر"],[48,"لاح إشراق الصباح","https://www.aldiwan.net/poem62518.html","مجزوء الرمل"],[48,"طربت إلى الفسوق مع المدام","https://www.aldiwan.net/poem66279.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85304","المنسرح"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16684","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42665","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43762","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43844","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43646","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[51,"يا سيِّدَ العربِ الذي قُدِرْت له","https://www.poetsgate.com/ViewPoem.aspx?id=30380",""],[51,"شغَلَ المُحبَّ عن الرسو","https://www.poetsgate.com/ViewPoem.aspx?id=30515",""],[85,"شيَّعوا الشمس ومالوا بضحاها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9634&r=&rc=124",""]],"verses":[["ظَفِرتَ بِما اِشتَهَيتَ مِنَ اللَيالي","وَأُعطيتَ المُرادَ مِنَ الأَماني",0,"ي",1,0],["ظَفِرتُ بِالنَفَلِ المَطلوبِ في وَطَني","وَإِنَّما يَرجِعُ الغازونَ بِالنَفَلِ",1,"ل",1,0],["ظَفِرتَ بِما اِشتَهَيتَ وَأَنتَ وانٍ","وَنالَ البَعضُ غَيرَكَ وَهوَ ساعٍ",2,"ع",1,0],["ظَفِرٌ بِالأُمورِ جَلدٌ نَجيبٌ","وَإِذا ما سَما لِحَربٍ أَباحا",3,"ح",2,0],["ظفرت يدايَ بكلّ ما أمّلتُه","في النفس أو في الجاه أو في المالِ",4,"ل",1,0],["ظفرت على قران السعد فيه","بشمسِ الحسنِ من شمسِ السماح",5,"ح",1,0],["ظفرت على رغم الرَّقيب بطيفها","وقد طردت خلف الثريا النعائم",6,"م",1,1],["ظفرتْ بمالئِ ناظريها بهجةً","وضميرها نُبلاً وكفَّيْها كرمْ",7,"م",1,0],["ظفرتَ بما تبغي وسيفُك مغمدٌ","وما كان لو جرَّدته بكهامِ",8,"م",1,0],["ظفرت يداهُ في اللقا","ء بسهم فلّاجٍ سَهُوم",9,"م",1,0],["ظفِرتْ يداك من الوزير بقيِّم","تأتي نصيحتُه بلا استكراه",10,"ه",1,0],["ظَفِرنا بِما نَهوى مِنَ الأُنسِ وَحدَهُ","وَلَسنا إِلى ماخَلفَهُ نَتَطَرَّفُ",11,"ف",1,0],["ظَفَرتُ بِقُربِكِ بَعدَ اِمتِناعٍ","فَمِن ذاكَ سُمِّتُ بِالظافِرِ",12,"ر",1,0],["ظفر الروض بالهزار اخيرا","بعد طول انتظاره للهزار",13,"ر",1,0],["ظفرت بقرب من حيناً فسرني","ولكن سريعاً ما انقضت دولة القرب",14,"ب",1,0],["ظَفِرَت بِالكِبرِ مِن مُستَكبِرٍ","ظافِرِ الأَيّامِ مَنصورِ لِواها",15,"ا",3,0],["ظَفِرَت بِجَوهَرَةٍ فَذَّةٍ","مِنَ الشَرَفِ العَبقَرِيِّ اليُمُن",16,"ن",1,0],["ظَفَرَت بِيونانَ القَديمَةِ حِكمَتي","وَغَزا الحَديثَةَ ظافِراً غازيكِ",17,"ك",1,0],["ظَفِرنا بِهِ وَجهاً فَظَنَّ تَعَقُّباً","وَماذا يَزيدُ الظافِرينَ التَعَقُّبُ",18,"ب",1,0],["ظَفَرٌ أَذَلَّ لآلِ فارسَ منكمُ","بسيوفِ مَشرَفَ أو رِماحِ رُدَيْنِ",19,"ن",1,0],["ظَفَرَت يداك أبا المظفر بالتي","كانَ الزمانُ بها يَضَنُّ ويَبخَلُ",20,"ل",1,0],["ظَفِرَتْ يَداهُ بمُهجَةِ الدَّنِّ الذي","غَبَرَتْ وديعةُ صدرِه وصِدارِه",21,"ر",2,0],["ظَفِرَت سِهامُ فَواتِرِ الأَلحاظِ","فَرَمَت صَميمَ قُلوبِنا بِشُواظِ",22,"ظ",1,1],["ظِفري لِسِنّي قارِعٌ وَمَدامِعي","قَد خَدَّدَت خَدِّيَ بِالإِلظاظِ",22,"ظ",1,0],["ظَفرٌ بِهِ رَدَّ العُداةَ بِغَيظِهِم","مُذ أَنَّهُم عَلِموا بِمَن أَنا حاظي",22,"ي",1,0],["ظَفَروا بِظِلِّكَ يا مَليكُ فَإِنَّهُم","بِوَلاكَ قَد فازوا بِخَيرِ حِفاظِ",22,"ظ",1,0],["ظَفِرَت بِكَ الأَيّامُ بَعدَ تَمَنُّعٍ","ظَفَرَ الهُمومِ بِعاشِقٍ لَم يَظفَرِ",23,"ر",1,0],["ظَفِرُوا بِحربٍ مِن كَتائبِ طارقٍ","كانت لأنْدَلُسٍ بَشيرَ سَلامِ",24,"م",1,0],["ظَفرتِ به دُوني وإنّي بواحِدي","وَجَدِّكِ إلا أنْ تلومِي لَقَانعُ",25,"ع",1,0],["ظَفِرْتَ بِهِ يا توأمَ النَّصْرِ تَوْأمَاً","لما نِلتَ من مجدٍ على الدّهرِ دائبِ",26,"ب",1,0],["ظَفِرْتَ من النبيِّ بخيرِ نُعْمَى","تَطيبُ بها النُّفوسُ الصّالحاتُ",27,"ت",1,0],["ظفروا إذ قَبَّلوا خيرَ يَدٍ","وخِيارُ النّاسِ أوْلَى بالظَّفرْ",28,"ر",1,0],["ظَفرتَ وفازَ بالنُّعْمَى زُهَيْرٌ","وهل لكما سِوَى ما ترجوانِ",29,"ن",1,0],["ظَفِرتُ بِهِ وَنَجمُ الصُبحِ بادٍ","عِبادِيّاً عَلى دينِ المَسيحِ",30,"ح",1,0],["ظَفِرَت كَفَّ أَريبٍ","باعَ بِرّاً بِجُناحِ",31,"ح",1,0],["ظفرتُ بهِ وقد علِقَتهُ كفّي","على دهشٍ مقالة مستهام",32,"م",1,0],["ظفرت بالمنى","في ليلة هنا",33,"ن",2,1],["ظَفِرْتُ بها خالَ النّجاء وعمَّهُ","وجَدَّ الفتى عَصْرَ الشّبيبةِ والخال",34,"ل",1,0],["ظَفِرْتُ بِهِ في حِقْبَةٍ فَقَنَصْتُهُ","عَلَى غِرَّةِ الأَيَّامِ وَاللَّهْوُ يُقْنَصُ",35,"ص",1,0],["ظَفَرت أَظافِرَه بِأَصيدِ أَصيَدٍ","فَعَجِبتُ كَيفَ أَصابَهُ وَتَخَلَّصا",36,"ص",2,0],["ظفري يَدُ المَوتِ قَلَّمتَهُ","آهاً وَإِن كانَ لي اِتِّعاظُ",37,"ظ",1,0],["ظَفرت بي وَاِتَّقَيتُ رَبّي","فَلَم يَكُن بَينَنا مِظاظُ",37,"ظ",1,0],["ظَفرتُ بِقُربٍ مِنك حَتّى إِذا صَفَت","حَياتي وَأَدنَتني إِلَيك حُظوظُ",38,"ظ",1,1],["ظَفِرَتْ بالعَبْقَرِي المُرْتَجَى","فاسْتَجَابَتْ للعُلا لمَّا دَعاها",39,"ا",3,0],["ظفرتْ بماليء ناظريها بهجة ً","وضميرها نُبلا وكفَّيْها كرم",40,"م",1,0],["ظفرت تزال في اللقا","ء بسهم فلاجٍ سَهُوم",41,"م",1,0],["ظفرتْ بالكبر من مستكبرٍ","وسيوفُ الهندِ لم تصحُ ظباها",42,"ا",3,0]]}