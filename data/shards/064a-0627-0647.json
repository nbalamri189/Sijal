ps://www.aldiwan.net/poem48295.html","عموديه"],[545,"أنّى التفتّ فثمّ إسمك","https://www.aldiwan.net/poem67251.html","عموديه"],[552,"عل البخيلة أن تجود لعاشق","https://www.aldiwan.net/poem47359.html","الكامل"],[552,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[559,"لمتى تموه بالمهاة وبالرشا","https://www.aldiwan.net/poem34430.html","الكامل"],[559,"غلب الهوى واستحوذ استحواذا","https://www.aldiwan.net/poem34561.html","الكامل"],[559,"قل هو الله أحد","https://www.aldiwan.net/poem34576.html","مجزوء الرمل"],[559,"كل وقت جمال وجهك بادي","https://www.aldiwan.net/poem34633.html","الخفيف"],[563,"ضاق السبيل على الباكي الحزين فلا","https://www.aldiwan.net/poem52765.html","البسيط"],[563,"أخذت نحوي سبيلا","https://www.aldiwan.net/poem52909.html","مجزوء الرمل"],[565,"يا هاجري بالهجر مه","https://www.aldiwan.net/poem908.html",""],[568,"يا هند لا تنكري في الأرض مضطربي","https://www.aldiwan.net/poem69560.html","البسيط"],[568,"شمس الضحى في الغمام مستتره","https://www.aldiwan.net/poem69650.html","الطويل"],[576,"لهفي من العاذل والعاذر","https://www.aldiwan.net/poem3072.html","السريع"],[587,"بان الخيال وإن أبان نزيلا","https://www.aldiwan.net/poem17663.html","الكامل"]],"verses":[["يا هَل لِدائي مِن هَواكَ إِفراق","هَيهاتَ ما أَعضَلَ داءَ العُشّاق",0,"ق",1,0],["ياهَل تَبُلُّ مِنَ الغَليلِ إِلَيهِم","إِشرافَةٌ لِلرَكبِ فَوقَ نِجادِها",1,"د",3,0],["يا هَل أَرى مِن حاجَةٍ","حَقِفَ النَقا وَالجَمُدا",2,"د",2,0],["ياهَل يُمانِعُ بَعدَ طولِ قِيادِهِ","قَلبٌ يُطاوِعُ في القِيادِ وَيَسمَحُ",3,"ح",1,0],["يا هَمَّ نَفسي وَيا سَمعي وَيا بَصَري","حَتّى مَتى حُبُّكُم بِالقَلبِ قَد كَلِفا",4,"ف",2,0],["يا هَجرُ كُفَّ عَنِ الهَوى وَدَعِ الهَوى","لِلعاشِقينَ يَطيبُ يا هَجرُ",5,"ر",1,1],["يا هاتِكاً حُرَمَ الرِجالِ وَقاطِعاً","سُبُلَ المَوَدَّةِ عِشتَ غَيرَ مُكَرَّمِ",6,"م",1,0],["يا هِلالاً يا قَضيباً يا رَشا","إنْ تبَدّى أو تثنّى أو مشَى",7,"ش",2,1],["يا هاجِري إِذ جِئتُ زائِرَهُ","ما كانَ مِن عاداتِكَ الهَجرُ",8,"ر",1,0],["يا هَوذَ إِنَّكَ مِن قَومٍ ذَوي حَسَبٍ","لا يَفشَلونَ إِذا ما آنَسوا فَزَعا",9,"ع",2,0],["يا هَوذُ يا خَيرَ مَن يَمشي عَلى قَدَمٍ","بَحرَ المَواهِبِ لِلوُرّادِ وَالشَرَعا",9,"ع",2,0],["يا هُماماً في الزَمانِ لَهُ","هِمَّةٌ دَقَّت عَنِ الفِطَنِ",10,"ن",1,0],["ياهِبَةَ اللَهِ لَقَد","ماتَ المُسَمّي وَاِفتَرى",11,"ر",2,1],["يا هِلالاً تَتَرا","أَهُ نُفوسٌ لا عُيونُ",12,"ن",1,0],["يا هاجِري كَم أَستَفيدُ","الصَبرَ عَنكَ فَلا أُفادُ",13,"د",1,0],["يا هَل أَتى مَن ظَنَّ بي فَظُنونُهُ","شَتّى تَرَجَّعُ بَينَها الأَضدادُ",14,"د",1,0],["يَا هَاجِرَ الأَقْلامِ كَادَتْ مِنْ أَسىً","تَجْرِي نُفُوساً بَعْدَكَ الأَقْلامُ",15,"م",1,0],["يا هَلْ تبلّغني مثواهُ ناجيةٌ","تطوي بيَ القفر مهما امتدّ وانْفَسَحا",16,"ح",2,0],["يا هَل تَرى البَرقُ بِتُّ أَرقُبُهُ","يُزجي حَبِيّاً إِذا خَبا ثَقَبا",17,"ب",2,0],["يا هاجرِي لا ماتَ من","يلحي عليك وعاشَ عيشي",18,"ي",1,0],["يا هلالاً يحلُّ من","كبدِي في منازل",19,"ل",1,0],["يا هاجرين بلا ذنبٍ سوى شجنٍ","بين الجوانح لا ينفكّ يشجينا",20,"ن",2,0],["يا هاجرين ترفَّقوا بمتيمٍ","ذي مدمعٍ سارٍ ووجدٍ قاطن",21,"ن",1,1],["يا هِلالاً بِدا لِأَربَع عَشرٍ","فَثَمانٍ وَأَربَعٌ وَاِثنَتانِ",22,"ن",1,0],["يا هلْ من الحادثات من وَزَرِ","للخائف المستجير أم عَصَرِ",23,"ر",1,1],["يا هل أحسَّت ليلة المنحنَى","أم ذهلت عني فلم تحسس",24,"س",1,0],["يا هارباً والصباحُ فاضحُهُ","هلا ترحّلْتَ تحت إغباشي",25,"ش",2,0],["يا هارباً منه إن الليل غاشية","لا بد منها وإن أوشكت إحصافا",26,"ف",2,0],["يا هل يُخلَّدُ منظرٌ حَسنُ","لممتَّع أو مَخْبرٌ حسنُ",27,"ن",1,1],["يا هل تعود سوالفُ الأزمانِ","أم لا فمنصرفٌ إلى السلوانِ",28,"ن",1,1],["يا هَل أُريكَ حُمولَ الحَيِّ غادِيَةً","كَالنَخلِ زَيَّنَهُ يَنعٌ وَإِفضاحُ",29,"ح",1,0],["يا هِندُ قَد أَفنى المَطالُ تَصَبُّري","وَفَنَيتُ حَتّى ما أَخافُ مَزيدا",30,"د",2,0],["يا هَواها قُل مَتى تَترُكُني","قالَ أَو تَصفَرَّ هاتيكَ الخُدود",31,"د",1,0],["يا هِندُ كَم ذا الأَنامُ تَعذُلُنا","وَما أَثِمنا وَلا بِنا وَزَرُ",32,"ر",1,0],["يا هَذِهِ إِنّي عَيِّتُ بِوَصفِهِ","وَعَجِزتُ عَن إِدراكِ مَكنوناتِهِ",33,"ه",1,0],["يا هَولَ ما أَبصَرَت يا هَولَ ما سَمِعَت","كادَت تُكَذِّبُ فيهِ السَمع وَالبَصَرا",34,"ر",2,0],["يا هَذِهِ كَم تَشحَذينَ غِرارَهُ","أَوَ ما خَشيتِ حَدَّهُ يُؤذيكِ",35,"ك",1,0],["يا هَذِهِ أَإِذا بَكَيتُ لِبُعدِهِم","يَتَبَسَّمونَ أَجابَتِ الحَسناءُ لا",36,"ل",2,0],["يا هَذِهِ لا تَجحَدي حَقِّ فَقَد","أَصلَيتِ قَلبي بَِلنَوى فَصِليني",37,"ن",2,0],["يا هِندُ هَذي مُعجِزاتُ الهَوى","وَإِنَّها فين كَما فيها",38,"ي",3,0],["يا هاجِرينَ وَحَقِّكُم","هَوَّنتُمُ ما لا يَهونُ",39,"ن",1,0],["يا هاجِري لا عَن قِلىً","هَجرَ اِبنَةِ المَهدِيُّ طَلّا",40,"ل",2,0],["يا هاجِري يَحُقُّ لَك","وَجَدتُ غَيري شَغَلَك",41,"ك",1,1],["يا هَذِهِ لا تَغلَطي","وَاللَهِ ما لي فيكِ خاطِر",42,"ر",1,1],["ياهَذِهِ ذَهَبَ الصِبا","فَإِلى مَتى هَذا التَصابي",43,"ب",2,0],["يا هَمْسَ أَمْواجِ المَسَاءِ","البَاسِماتِ الحَائرَهْ",44,"ه",1,0],["يا هَلالاً إِذا بَدا لي تَجَلّت","عَن فُؤادي دُجُنَّة الكُرُباتِ",45,"ت",1,1],["يا هِلالا حُسنَ خدّ يا رَشا","غُنجَ لَحظٍ يا قَضيباً لينَ قَدْ",46,"د",1,0],["يا هَذِهِ كفِّي فَإِنّي عاشِقٌ","مَن لا يَرُدُّ هَوايَ عَنها عاذِلُ",47,"ل",1,0],["يا هاجرينَ قَد اشتَفَيتُم فارفَقوا","وَهَبوا لِعَثرَةِ عاشِقٍ لَكُم لعا",48,"ع",2,0],["يا همّ ان ما جرى","من ادمعي ما غسلك",49,"ك",1,0],["يا هلال الشرق حيث سرى","وسماء البدو والحضر",50,"ر",1,0],["يا هلال الصيام مثلك في السا","مين للعز من طوى الأفلاكا",51,"ك",2,1],["يا هَل تُرى الأَلفانِ وَق","فٌ لا يُمَسُّ وَمَحرَمُ",52,"م",1,0],["يا هَل تُرى مُدنِيَةٌ لِلهَوى","بِمَنبِجٍ أَيامُهُ المُبعَدَة",53,"د",2,0],["يا هِلالاً أَوفى بِأَعلى قَضيبٍ","وَقَضيباً عَلى كَثيبٍ مَهيلِ",54,"ل",1,0],["يا هلالَ الآدابِ يا ابْنَ هلالٍ","صَرَفَ اللهُ عنكَ صَرْفَ المَحاقِ",55,"ق",1,0],["يا هؤلاءِ تَفَكَّروا","لِلمَوتِ يَغدو مَن غَذا",56,"ذ",2,0],["يا هِلالاً مِن سُلطَةِ العَيِّ حَيّي","أَشرَقَ الصُبحُ تَحتَ لَيلٍ دَجِيِّ",57,"ي",1,1],["يا هِلالاً لَمّا اِستَتَمَّ ضِياءً","قَد أَغارَت فيهِ المَنونَ فَغارا",58,"ر",2,0],["يا هِلالاً أَودى بِهِ الخَسفُ لَمّا","صارَ عِندَ الكَمالِ بَدراً وَسيما",59,"م",2,0],["يا هَيكل الحسنِ المباركِ ركنُه","الساحرَ النورِ الطهورَ رحابِ",60,"ب",1,0],["يا هاتفاً باسمي فُدِيتَ منادياً","ردَّ الند