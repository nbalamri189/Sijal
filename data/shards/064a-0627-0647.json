د لله هذا أعجب العجب","https://www.aldiwan.net/poem62431.html","البسيط"],[48,"يا هاشم ابن حديج ليس فخركم","https://www.aldiwan.net/poem62612.html","البسيط"],[48,"ما منك سلمى ولا أطلالها الدرس","https://www.aldiwan.net/poem64339.html","البسيط"],[48,"وشاعر ما يفيق من خطله","https://www.aldiwan.net/poem66556.html","المنسرح"],[48,"قل للذي إن قلت من يا فتى","https://www.aldiwan.net/poem66561.html","السريع"],[46,"قد يسروا لدفين حان مصرعه","https://www.aldiwan.net/poem22124.html","البسيط"],[46,"فرق بدا ومن الحوادث يفرق","https://www.aldiwan.net/poem23023.html","الكامل"],[46,"نفضت عني ترابا وهو لي نسب","https://www.aldiwan.net/poem23348.html","البسيط"],[46,"قد خف جرمي وصار جرمي","https://www.aldiwan.net/poem23610.html","مجزوء البسيط"],[76,"يا هلالا في تجنيه","https://www.aldiwan.net/poem38858.html","مخلع البسيط"],[76,"يا طويل الهجر لا تنس وصلي","https://www.aldiwan.net/poem39008.html","الكامل"],[76,"يا هلالا قد تجلى","https://www.aldiwan.net/poem39330.html","مجزوء الرمل"],[68,"قف بالديار وحي الأربع الدرسا","https://www.aldiwan.net/poem1503.html",""],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42491","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42696","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55437","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55022","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54774","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67336","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141983","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43731","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43733","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43884","المتدارك"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/204512",""],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10083","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54264","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54208","الكامل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205801","الخفيف"],[106,"شعر الماحي","https://www.poetsgate.com/ViewPoem.aspx?id=179364",""],[77,"يا هلالا يا قضيبا يا رشا","https://www.poetsgate.com/ViewPoem.aspx?id=34195",""],[90,"المجلس المفجوع","https://www.poetsgate.com/ViewPoem.aspx?id=179038",""],[90,"عُدنا وقودا","https://www.poetsgate.com/ViewPoem.aspx?id=179221",""],[90,"الخريف في فارس","https://www.poetsgate.com/ViewPoem.aspx?id=179054",""],[54,"يا هَيْثَما يابنَ عُثمانَ الَّذِي افَتَخَرَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=14267",""],[73,"هَلْ تذكُرونَ غريباً عادَهُ شَجَنُ","https://www.poetsgate.com/ViewPoem.aspx?id=201341",""],[91,"أخت البلجيك","https://www.poetsgate.com/ViewPoem.aspx?id=53153",""],[91,"أخت ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=53317",""],[87,"ظنَّ الظنونَ فباتَ غيرَ موسَّدِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23838&r=&rc=100",""]],"verses":[["يا هَل لِدائي مِن هَواكَ إِفراق","هَيهاتَ ما أَعضَلَ داءَ العُشّاق",0,"ق",1,0],["ياهَل تَبُلُّ مِنَ الغَليلِ إِلَيهِم","إِشرافَةٌ لِلرَكبِ فَوقَ نِجادِها",1,"د",3,0],["يا هَل أَرى مِن حاجَةٍ","حَقِفَ النَقا وَالجَمُدا",2,"د",2,0],["ياهَل يُمانِعُ بَعدَ طولِ قِيادِهِ","قَلبٌ يُطاوِعُ في القِيادِ وَيَسمَحُ",3,"ح",1,0],["يا هَمَّ نَفسي وَيا سَمعي وَيا بَصَري","حَتّى مَتى حُبُّكُم بِالقَلبِ قَد كَلِفا",4,"ف",2,0],["يا هَجرُ كُفَّ عَنِ الهَوى وَدَعِ الهَوى","لِلعاشِقينَ يَطيبُ يا هَجرُ",5,"ر",1,1],["يا هاتِكاً حُرَمَ الرِجالِ وَقاطِعاً","سُبُلَ المَوَدَّةِ عِشتَ غَيرَ مُكَرَّمِ",6,"م",1,0],["يا هِلالاً يا قَضيباً يا رَشا","إنْ تبَدّى أو تثنّى أو مشَى",7,"ش",2,1],["يا هاجِري إِذ جِئتُ زائِرَهُ","ما كانَ مِن عاداتِكَ الهَجرُ",8,"ر",1,0],["يا هَوذَ إِنَّكَ مِن قَومٍ ذَوي حَسَبٍ","لا يَفشَلونَ إِذا ما آنَسوا فَزَعا",9,"ع",2,0],["يا هَوذُ يا خَيرَ مَن يَمشي عَلى قَدَمٍ","بَحرَ المَواهِبِ لِلوُرّادِ وَالشَرَعا",9,"ع",2,0],["يا هُماماً في الزَمانِ لَهُ","هِمَّةٌ دَقَّت عَنِ الفِطَنِ",10,"ن",1,0],["ياهِبَةَ اللَهِ لَقَد","ماتَ المُسَمّي وَاِفتَرى",11,"ر",2,1],["يا هِلالاً تَتَرا","أَهُ نُفوسٌ لا عُيونُ",12,"ن",1,0],["يا هاجِري كَم أَستَفيدُ","الصَبرَ عَنكَ فَلا أُفادُ",13,"د",1,0],["يا هَل أَتى مَن ظَنَّ بي فَظُنونُهُ","شَتّى تَرَجَّعُ بَينَها الأَضدادُ",14,"د",1,0],["يَا هَاجِرَ الأَقْلامِ كَادَتْ مِنْ أَسىً","تَجْرِي نُفُوساً بَعْدَكَ الأَقْلامُ",15,"م",1,0],["يا هَلْ تبلّغني مثواهُ ناجيةٌ","تطوي بيَ القفر مهما امتدّ وانْفَسَحا",16,"ح",2,0],["يا هَل تَرى البَرقُ بِتُّ أَرقُبُهُ","يُزجي حَبِيّاً إِذا خَبا ثَقَبا",17,"ب",2,0],["يا هاجرِي لا ماتَ من","يلحي عليك وعاشَ عيشي",18,"ي",1,0],["يا هلالاً يحلُّ من","كبدِي في منازل",19,"ل",1,0],["يا هاجرين بلا ذنبٍ سوى شجنٍ","بين الجوانح لا ينفكّ يشجينا",20,"ن",2,0],["يا هاجرين ترفَّقوا بمتيمٍ","ذي مدمعٍ سارٍ ووجدٍ قاطن",21,"ن",1,1],["يا هِلالاً بِدا لِأَربَع عَشرٍ","فَثَمانٍ وَأَربَعٌ وَاِثنَتانِ",22,"ن",1,0],["يا هلْ من الحادثات من وَزَرِ","للخائف المستجير أم عَصَرِ",23,"ر",1,1],["يا هل أحسَّت ليلة المنحنَى","أم ذهلت عني فلم تحسس",24,"س",1,0],["يا هارباً والصباحُ فاضحُهُ","هلا ترحّلْتَ تحت إغباشي",25,"ش",2,0],["يا هارباً منه إن الليل غاشية","لا بد منها وإن أوشكت إحصافا",26,"ف",2,0],["يا هل يُخلَّدُ منظرٌ حَسنُ","لممتَّع أو مَخْبرٌ حسنُ",27,"ن",1,1],["يا هل تعود سوالفُ الأزمانِ","أم لا فمنصرفٌ إلى السلوانِ",28,"ن",1,1],["يا هَل أُريكَ حُمولَ الحَيِّ غادِيَةً","كَالنَخلِ زَيَّنَهُ يَنعٌ وَإِفضاحُ",29,"ح",1,0],["يا هِندُ قَد أَفنى المَطالُ تَصَبُّري","وَفَنَيتُ حَتّى ما أَخافُ مَزيدا",30,"د",2,0],["يا هَواها قُل مَتى تَترُكُني","قالَ أَو تَصفَرَّ هاتيكَ الخُدود",31,"د",1,0],["يا هِندُ كَم ذا الأَنامُ تَعذُلُنا","وَما أَثِمنا وَلا بِنا وَزَرُ",32,"ر",1,0],["يا هَذِهِ إِنّي عَيِّتُ بِوَصفِهِ","وَعَجِزتُ عَن إِدراكِ مَكنوناتِهِ",33,"ه",1,0],["يا هَولَ ما أَبصَرَت يا هَولَ ما سَمِعَت","كادَت تُكَذِّبُ فيهِ السَمع وَالبَصَرا",34,"ر",2,0],["يا هَذِهِ كَم تَشحَذينَ غِرارَهُ","أَوَ ما خَشيتِ حَدَّهُ يُؤذيكِ",35,"ك",1,0],["يا هَذِهِ أَإِذا بَكَيتُ لِبُعدِهِم","يَتَبَسَّمونَ أَجابَتِ الحَسناءُ لا",36,"ل",2,0],["يا هَذِهِ لا تَجحَدي حَقِّ فَقَد","أَصلَيتِ قَلبي بَِلنَوى فَصِليني",37,"ن",2,0],["يا هِندُ هَذي مُعجِزاتُ الهَوى","وَإِنَّها فين كَما فيها",38,"ي",3,0],["يا هاجِرينَ وَحَقِّكُم","هَوَّنتُمُ ما لا يَهونُ",39,"ن",1,0],["يا هاجِري لا عَن قِلىً","هَجرَ اِبنَةِ المَهدِيُّ طَلّا",40,"ل",2,0],["يا هاجِري يَحُقُّ لَك","وَجَدتُ غَيري شَغَلَك",41,"ك",1,1],["يا هَذِهِ لا تَغلَطي","وَاللَهِ ما لي فيكِ خاطِر",42,"ر",1,1],["ياهَذِهِ ذَهَبَ الصِبا","فَإِلى مَتى هَذا التَصابي",43,"ب",2,0],["يا هَمْسَ أَمْواجِ المَسَاءِ","البَاسِماتِ الحَائرَهْ",44,"ه",1,0],["يا هَلالاً إِذا بَدا لي تَجَلّت","عَن فُؤادي دُجُنَّة الكُرُباتِ",45,"ت",1,1],["يا هِلالا حُسنَ خدّ يا رَشا","غُنجَ لَحظٍ يا قَضيباً لينَ قَدْ",46,"د",1,0],["يا هَذِهِ كفِّي فَإِنّي عاشِقٌ","مَن لا يَرُدُّ هَوايَ عَنها عاذِلُ",47,"ل",1,0],["يا هاجرينَ قَد اشتَفَيتُم فارفَقوا","وَهَبوا لِعَثرَةِ عاشِقٍ لَكُم لعا",48,"ع",2,0],["يا همّ ان ما جرى","من ادمعي ما غسلك",49,"ك",1,0],["يا هلال الشرق حيث سرى","وسماء البدو والحضر",50,"ر",1,0],["يا هلال الصيام مثلك في السا","مين للعز من طوى الأفلاكا",51,"ك",2,1],["يا هَل تُرى الأَلفانِ وَق","فٌ لا يُمَسُّ وَمَحرَمُ",52,"م",1,0],["يا هَل تُرى مُدنِيَةٌ لِلهَوى","بِمَنبِجٍ أَيامُهُ المُبعَدَة",53,"د",2,0],["يا هِلالاً أَوفى بِأَعلى قَضيبٍ","وَقَضيباً عَلى كَثيبٍ مَهيلِ",54,"ل",1,0],["يا هلالَ الآدابِ يا ابْنَ هلالٍ","صَرَفَ اللهُ عنكَ صَرْفَ المَحاقِ",55,"ق",1,0],["يا هؤلاءِ تَفَكَّروا","لِلمَوتِ يَغدو مَن غَذا",56,"ذ",2,0],["يا هِلالاً مِن سُلطَةِ العَيِّ حَيّي","أَشرَقَ الصُبحُ تَحتَ لَيلٍ دَجِيِّ",57,"ي",1,1],["يا هِلالاً لَمّا اِستَتَمَّ ضِياءً","قَد أَغارَت فيهِ المَنونَ فَغارا",58,"ر",2,0],["يا هِلالاً أَودى بِهِ الخَسفُ لَمّا","صارَ عِندَ الكَمالِ بَدراً وَسيما",59,"م",2,0],["يا هَيكل الحسنِ المباركِ ركنُه","الساحرَ النورِ الطهورَ رحابِ",60,"ب",1,0],["يا هاتفاً باسمي فُدِيتَ منادياً","ردَّ النداءَ عليه حَرُّ نُواحي",61,"ي",1,0],["يا هاجِري يا من هجرتَ بلا سبب","أترى العقاب بغير إثم قد وجب",62,"ب",1,1],["يا همّ قلبي في صبا أيامه","وسهاد عيني في الليالي الأولى",63,"ل",2,0],["يا هند أين رجولتي وعزيمتي","في قرب وجه ساحرٍ فتَّان",64,"ن",1,0],["يا هند ما الحسن إني","أُجِلُّ حسنك وصفا",65,"ف",2,0],["يا هند من يُعيد لي","آماليَ المُزعزعه",66,"ع",2,0],["يا هند إن يك قلبُك ال","وافي تغيَّرَ أو سلا",67,"ل",2,0],["يا هند هذي شهاده","لو أنَّها مطلوبه",68,"ه",1,0],["يا هاته الأقدار عينك لا ترى","تحت الدجى سأمان ممتنع الكرى",69,"ر",2,0],["يا هذه إنْ أراكِ الدهرُ فيّ بلىً","فَجدّةُ الثَّوبِ تَبْلى كلما قدُما",70,"م",2,0],["يا هَذِهِ ونِدائي دُمْيَةً طَمَعٌ","في نطقها من فقيدِ اللبِّ مُخْتَبِلِ",71,"ل",1,0],["يا هَذِهِ لَقَدِ انفَرَدتِ بِصورَةٍ","لِلحُسنِ صُوِّرَ خَلقُها تِمثالا",72,"ل",2,0],["يا هَذِهِ استَبقي على رَجُلٍ","أفحمتِهِ بالفاحمِ الرّجِلِ",73,"ل",1,0],["يا هَذهِ تَدَّعينَ الوجدَ عاريَةً","مِنَ الضنى فَدَعي الشكوى لِمَن عَشِقا",74,"ق",2,0],["يا هَذِهِ لا تَسألي عن عَبرَتي","عَيني على عَيني عَلَيكِ تَغارُ",75,"ر",1,0],["يا هذه أصَدىً دعَوت مُرَدّداً","ليجيب منكَ فكان غير مجيبِ",76,"ب",1,0],["يا هَذِهِ هَذِهِ عَيني الَّتي نَظَرتْ","تَبلّ بالدَّمْعِ إِصباحي وَإِمسائي",77,"ا",2,0],["يا هَولَ ما أَبصَرَت عَيني وَما سَمِعَت","أُذني فَلا بَقِيَت عَيني وَلا أُذُني",78,"ن",2,0],["يا هِلالاً غَدا عَلَيهِ المُحاقُ","أَينَ ذاكَ الضِياءُ وَالإِشراقُ",79,"ق",1,1],["يا هَذِهِ أَقصِري ما هَذِهِ بَشَرُ","وَلا الخَرائِدُ مِن أَترابِها الأُخَرُ",80,"ر",1,1],["يَا هَلْ يَعُودُ إِلَى الْجَوَانِحِ بَعْدَمَا","سَلَبَتْ فَتَاةُ الْحَيِّ ثِنْيَ لِجَامِهِ",81,"م",2,0],["يَا هَاجِرِي ظُلْماً بِغَيْرِ خَطِيئَةٍ","هَلْ لِي إِلَى الصَّفْحِ الْجَمِيلِ سَبِيلُ",82,"ل",1,1],["يا هندُ ما في زماني","مساعفٌ أو مساعدْ",83,"د",1,1],["يا هندُ لي نفسٌ بكم مشغولةٌ","سياقُها إلى هواكم ساقَها",84,"ق",3,0],["يا هِندُ لا تَبخَلي بِنائِلِكُم","عَن عاشِقٍ ظَلَّ مِنكِ في نَصَبِ",85,"ب",1,0],["يا هِندُ عاصي الوُشاةَ في رَجُلٍ","يَهتَزُّ لِلمَجدِ ماجِدِ الحَسَبِ",85,"ب",1,0],["يا هِندُ لا تَبخَلي بِنائِلِكُم","عَنّا فَلَم أَقضِ مِنكُمُ أَرَبي",86,"ي",1,0],["يَأَهلَ أَندَلُسٍ لِلَّهِ دَرُّكُمُ","ماءٌ وَظِلٌّ وَأَنهارٌ وَأَشجارُ",87,"ر",1,1],["ياهِزَّةَ الغُصنِ الوَريقِ","وَبَشاشَةَ الرَوضِ الأَنيقِ",88,"ق",1,1],["يا هَمَّ قَلبي مِن حَياةٍ مُرَّةٍ