{"poems":[[30,"ديار بالأجيفر كان فيها","https://www.aldiwan.net/poem5591.html","الوافر"],[208,"نسيم عبير في غلالة ماء","https://www.aldiwan.net/poem53079.html","الطويل"],[280,"أمبتسم الأضحى ومطلع الفطر","https://www.aldiwan.net/poem25567.html","الطويل"],[371,"أهذه سير في المجد أم سور","https://www.aldiwan.net/poem17202.html","البسيط"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104564","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67827","الطويل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115994","المتقارب"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79809","المتقارب"],[1544,"","https://poetry.dctabudhabi.ae/diwan/poem/111124","الوافر"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45813","الطويل"],[4764,"قلبي وزعلاته","https://www.poetsgate.com/ViewPoem.aspx?id=35867",""],[5409,"ألا يا دار كم لي فيك ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=155434",""]],"verses":[["تَرى غُلبَ الفِحالِ لَنا خُضوعاً","إِذا نَهَضَت لِمُفتَخَرٍ قُرومي",0,"م",2,0],["تُرى غُيِّرت عن عهدها تربة الهوى","فأخرج بذرُ الوصل زرعَ جفاءِ",1,"ا",2,0],["تَرى غَدَها يَسْمُو إلَيْهَا وأمسَها","يُديمُ إليها اللحْظَ كَرّاً عَلى كَرِّ",2,"ر",1,0],["تَرى غَرائِبَ مِن أَفعالِ مَجدِهِمُ","يَرُدُّها الفِكرُ لَو لَم يَشهَدِ النَظَرُ",3,"ر",1,0],["تُريغُ كلاهُ بينَ ذاوٍ ويانعٍ","بأصهبِ عافيهِ وجَونِ عفيّهِ",4,"ي",2,0],["تُرى غُمَّةَ الْهِجْرَانِ بِالْوَصْلِ تَنْجَلي","وَيَبْرَا بِهِ قَلْبُ الْمُحِبِّ الْمُعَلَّلِ",5,"ل",1,0],["تُرى غيَّرَ البُعدُ أحوالكم","كما غيَّرَ البُعدُ أحوالَنا",6,"ن",2,0],["ترى غيلةَ الشرك أنَّى تحلّ","بنجدٍ من الأرض أو غائرِ",7,"ر",1,0],["ترى غيث المكارم مبتهلا","بساحته وروض المجد نضرا",8,"ر",2,0],["تَرى غرر الأَقمار بَينَ غَياضها","وَتَسمع قَمَرَيها شَجواً كُلَما قَد تَكَلَما",9,"م",2,0],["ترى غلطان يا كلي ذبحته حرف مكتوبك","انا انسانةٍ حُره / وكلن حُر في ذاته",10,"ت",2,0],["تريغ لكل حادثةٍ توالت","من الأحداث تعليلاً جميلا",11,"ل",2,0]]}