,[6068,"قَدْ جُزْتُ بالسلفيّ عَادِلْ -09-","https://www.poetsgate.com/ViewPoem.aspx?id=175812",""],[6075,"في صفحة الماء","https://www.poetsgate.com/ViewPoem.aspx?id=190530",""],[6115,"يازينها صدفة ماكنت قاصدها","https://www.poetsgate.com/ViewPoem.aspx?id=196477",""],[6125,"قد أضرمَ الشَّوقُ في جنبيَّ نِيرَانا","https://www.poetsgate.com/ViewPoem.aspx?id=210958",""],[6212,"أميرة الماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1629&r=&rc=10",""]],"verses":[["لَكِنَّ عيدَكَ يا عَبّاسُ أَنطَقَني","كَالبَدرِ أَطلَقَ صَوتَ البُلبُلِ الطَرِبِ",0,"ب",1,0],["لكن علمي ببنك مصر ونفعه","لم يزل يقينا",1,"ن",2,0],["لَكِنَّ عَاصِفَةً أَغَارَتْ فَجْأَةً","بِالهُوجِ مِنْ لَدَدِ الرِّيَاحِ وَقُتْمهَا",2,"م",3,0],["لَكِنْ عَدَانَا الْبَيْنُ دون عِنَاقِهِمْ","فَتَولَّ وَلْيَتَعَانَقِ الدَّمْعَانِ",3,"ن",1,0],["لَكِنْ عصَيْتُ اليَوْمَ أَمْرَكَ مَرَّةً","مِنْ حَيْثُ حُرِّمَ أَنْ يَكُونَ كَلاَمُ",4,"م",1,0],["لَكِن عَصاهُم ذِمَّةً وَقَدرا","باتَ وَباتَت لَيلَها مُقوَرّا",5,"ر",2,0],["لَكِنَّ عادَتَكَ الجَمي","لَةَ أَن تَغُضَّ عَلى بَصيرَه",6,"ه",1,0],["لكن عَجِبنا لعُرفٍ لا نُكافئُهُ","ونستزيدُك منه أكثر العَجَبِ",7,"ب",1,0],["لكن على كل حالٍ","إذا تَيَمَّمَ رُشْدَهْ",8,"د",2,0],["لكن عَتاد أبي الخرطوم سيدنا","كبيرة صغُرت في جنبها الكُبر",9,"ر",1,0],["لك نُعمى عليه تخنع للحقْ","ق مُقرّاً بها أشَدَّ الخُنُوعِ",10,"ع",1,0],["لكن على غيره البكاء ولا","زالت أمانيه طوع سائقها",11,"ق",3,0],["لَكِن عَدَتني نائِباتُ النَوى","في دَوحِهِ وَالشادنُ الأَحوَرُ",12,"ر",1,0],["لكن عقلي اليوم وا","هي الحبل رخو المفصل",13,"ل",1,0],["لكن عمر السر عندي ساعة","يستوطن الأحشاء ثم يموت",14,"ت",1,0],["لكنّ عزمك عن حزم يثورُ به","بالقَدْحِ يَظْهَرُ ما في الزندِ ينْكتِمُ",15,"م",1,0],["لَكِن عَدَوتَ عَلى جِسمي فَبِنتَ بِهِ","يا مَن رَأى الظَبيَ عَدّاءً عَلى الذيبِ",16,"ب",1,0],["لَكِنَّ عَدْلاً لاَ يَنِي مُتَعَقًِّباً","لِلْظُلْمِ بَيْنَ مُصَابِرٍ وَمُعَاقَبِ",17,"ب",1,0],["لَكِن عَلى حُبِّ الحِسا","نِ البيضِ قَلبي قَد طُبِع",18,"ع",1,0],["لكِنَّ عَيناً طَرَقَت","وَطَرفَ دَهرٍ غَدَرَك",19,"ك",1,0],["لَكِن عُوَيرٌ وَفى بِذِمَّتِهِ","لا عُوَرٌ شانُهُ وَلا قِصَرُ",20,"ر",1,0],["لكن على ملّةِ الإسلامِ ليس لَنا","اسمٌ سواهُ بذاك اللَه سمّانا",21,"ن",2,0],["لك نعتٌ يجوزُ وصْفي ونعتي","ببلاغي عن المقال وظني",22,"ن",2,0],["لكنَّ عدْوىَ الموت عدوى لم تزل","من آدمٍ تسري إلى أبنائه",23,"ا",3,0],["لكن على الجد والاخلاص في عمل","وفي ثبات واخبات وكشف عمى",24,"م",2,0],["لكن عهود حياة قمت أذكرها","وانتقي الدر مكنونا لها كلما",24,"م",2,0],["لكن عليك وظائف مشروعة","سفرت بها سنن كما سفر القمر",25,"ر",1,0],["لَكنَّ عُذري عِندَ غَيرك وَاضِحٌ","إِذ كانَ باب جئتُهُ مَسدودُ",26,"د",1,0],["لَكن عُبَيدك يَخشى أَن يُقالَ لَهُ","لا خَيلَ عِندَكَ تَهديها وَلا مالُ",27,"ل",1,0],["لكن على نَظَرٍ له وبصيرةٍ","أن لا يُقِلَّ ويفرحُ الخُصماءُ",28,"ا",2,0],["لكن على المحبِ قد","سُدت جميع السبلِ",29,"ل",1,0],["لَكِنَّ عَبدَكَ عاثَ فيها موقِناً","أَن سَوفَ يُرزَقُ بَعدَها أَو يُقطَعُ",30,"ع",1,0],["لكنْ عجبتُ لمن يظل بحدِّها","جهلاً على حوبائهِ يستنصرُ",31,"ر",1,0],["لكن عند الملك لم اسمع بمن","بهزبره أو ذيبه أوذي به",32,"ب",2,0],["لَكِن عِصامِيٌّ كَفَتهُ نَفسُهُ","شَرَفَ الجُدودِ وَمَفخَرَ الآباءِ",33,"ا",2,0],["لَكِن عَلى دُرَرٍ تَزهُو جَواهِرُها","في عِقدِ كُلِّ نِظامٍ غَيرِ مُنقَطِعِ",34,"ع",1,0],["لَكِن عَفَونا وَكانَ العَفوُ عادَتَنا","وَلَم نُؤاخِذ أَخا جُرمٍ بِما اِجتَرَما",35,"م",2,0],["لكنْ عَداكَ عن الأحبة مِثلُها","قَدٌّ ولحظٌ ذابلٌ وسِنان",36,"ن",1,0],["لَكن عليهِ اِستوى لا كيفَ نعلمهُ","للاِستواء أوِ القهر المراد بهِ",37,"ب",2,0],["لكنَّ عينَ المرءِ مفتاحُ الهوى","فإذا رنا فتحتْ لهُ الأبوابُ",38,"ب",1,0],["لكن عليّ الدهر اخنى واعتدى","ظلما وبالغ في البعاد وطولا",39,"ل",2,0],["لكن عفوت واهل الحلم ان قدروا","يوما عفوا وعظيم العفو مقتدر",40,"ر",1,0],["لَكِن عَدَتكِ صَبابَتي فَأَطَعتِهِم","شَتّانَ خالٍ قَلبُهُ وَمُتَيَّمُ",41,"م",1,0],["لَكِنْ عَجَْزْتُ وَحُقَّ لِي عَنْ مَدْحِ مَنْ","مُدِحَتْ بِهِ زُمَرٌ مِنَ الأَمْجَادِ",42,"د",1,0],["لكنّ عينكِ لم تفقد حلاوتها","والقلبُ تحتَ رَمادٍ لم يزل نارا",43,"ر",2,0],["لكِنْ عَلَيّ بأن أقومَ بِشكرها","غَرِداً عَلَى أفْنانِها صَدّاحا",44,"ح",2,0],["لكن عَسى قد آن إِبّانُ اللِقا","والشيء يُقبِلُ إِن أَتى إِبّانُهُ",45,"ن",2,0],["لكن عشقي غاب سلطانه","وما يجيء إلا على الطائع",46,"ع",1,0],["لكن عوادٍ مِن دواعٍ دونه","منبثّةٌ بِمفاوز ورعونِ",47,"ن",1,0],["لَكن عشوتُ لَها وطرفي حاسرٌ","ثمّ اِنثَنيت وطرف فكري أحسرُ",48,"ر",1,0],["لَكِن عَساهُ يكونُ عندَ لِقائكم","برداً يُصاحبه السلام الأوفرُ",48,"ر",1,0],["لَكِن عَلَيهِ تَصبيري فَرُقتَهُ","لَمّا أَقَمتُ عَلى وِدادِكَ حِقبَةً",49,"ه",1,0],["لَكِن عَبّاسَنا قَد زادَها شَرَفاً","وَزانَها مِنهُ إِكرامٌ وَإِعزازُ",50,"ز",1,0],["لَكِن عَلى فَضلِهِ أَلقى مَطامِحُهُ","وَمُنذُ أَلزَمتُ أَفكاري مَدائِحُهُ",51,"ه",1,0],["لكن عطفك ليس يكفي مغرماً","بسناً ضياكِ يعلّل الآمالا",52,"ل",2,0],["لكن عليها طائفٌ خائفٌ","في طول هذا الليل سَهَّارُ",53,"ر",1,0],["لكن عند الموت لن تمتنعا","فَحُلَّ ممنوعاً ومُدنِفاً معا",54,"ع",2,0],["لكن عاد ليَ الشبا","ب ولي بذا برهان لمي",55,"م",2,0],["لكنّ عقد الوصال منا","منفصم إذا نأيت قطعا",56,"ع",2,0],["لكن على جلدي وخوضي معركا","يرتاع فيه الموت من إقدامي",57,"م",2,0],["لكن عتابي على الحظوظ وشك","واي إليكم تَحيُّفُ القِسَمِ",58,"م",1,0],["لكنّ عذلاً كالنَّصح ضاعت","سلوكه في رقوع بالي",59,"ل",2,0],["لكن عميد الدولة الشمسُ التي","عنت النجومُ لنورها المتشعشعِ",60,"ع",1,0],["لكن عيون الكاشحي","نَ الشُّزْرُ منها والخُزُرْ",61,"ر",1,0],["لَكِن عَبُوسٌ غَيرُ مُستَشَاطِ","هذا عَلِيٌّ جَاءَ فِي الأَسبَاطِ",62,"ط",1,0],["لكن عَلِمَت تكَاسُلاً مِن شاعرٍ","يشكُو التَكاسُلَ في ابتِلاعِه رِيقُ",63,"ق",1,0],["لكن علا شوقه عليه","منه عدا مالك العنان",64,"ن",1,0],["لكن عيونك عن مرادك في عمى","وتظل تنكر ذاته وتعاند",65,"د",1,0],["لكن عقول الجاهلين تضلهم","فيكذبون بأبلغ الكذاب",66,"ب",1,0],["لكنْ عَهدِنا البينَ في غَفَلاتهِ","يَنسَى الذينَ حياتُهم لا تَنفَعُ",67,"ع",1,0],["لكنْ عَصاهُ بزَلَّةٍ لا تنمحي","إلَّا بإِرسال ابنِهِ المتُجسِّمِ",68,"م",1,0],["لكنَّ عهداً قديماً منكَ أَذكرُه","ورُبَّما نُسي العهدُ الذي قَدُما",69,"م",2,0],["لَكِن عَلى المَرءِ عِراكُ الدَهرِ طاقَتُهُ","وَلَو تَحمِل ذو الهِمّاتِ كُلَّ شَقا",70,"ق",2,0],["لَكِن عَكَفتَ عَلى اِستنباط مَسألة","أَو حَ