{"poems":[[47,"بات عهد الصبا وباقي جديده","https://www.aldiwan.net/poem63465.html","الخفيف"],[52,"قل لسعدى تحرجي","https://www.aldiwan.net/poem63989.html","مجزوء الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123501","الخفيف"]],"verses":[["مِنكِ طَيفٌ أَلَمَّ وَالأُفقُ مَلآ","نَ مِنَ الفَجرِ وَاِعتِراضِ عَمودِه",0,"د",2,0],["مِنكِ طيفٌ يَزورُني","وَيَرى كُلَّ مَنهَجِ",1,"ج",1,0],["من كطه صلَّت عليه البرايا","أيدتهُ السماءُ بالقرآنِ",2,"ن",1,0],["من كطه في الفضل أو من كصحب","صحبوه فما لهم من موازى",3,"ز",2,0]]}