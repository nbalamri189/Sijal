","https://www.poetsgate.com/ViewPoem.aspx?id=36105",""],[5302,"وسبت فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=201220",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5370,"العيد باكر","https://www.poetsgate.com/ViewPoem.aspx?id=87431",""],[5436,"لهيب الثأر ماخمدا / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177642",""],[5674,"حريق الذاكرة","https://www.poetsgate.com/ViewPoem.aspx?id=190554",""],[5725,"لهيب الثأر ماخمدا","https://www.poetsgate.com/ViewPoem.aspx?id=177488",""],[5725,"كذب العنادل","https://www.poetsgate.com/ViewPoem.aspx?id=193671",""],[5759,"رحلت","https://www.poetsgate.com/ViewPoem.aspx?id=213550",""],[5881,"تلقاء مدين","https://www.poetsgate.com/ViewPoem.aspx?id=184317",""],[5897,"همسة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=156356",""],[5897,"بين الخوف والرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=156850",""],[5906,"عَدالة","https://www.poetsgate.com/ViewPoem.aspx?id=188215",""],[5956,"طيوفك","https://www.poetsgate.com/ViewPoem.aspx?id=182323",""],[5956,"لم ألقَ حسناءً عليّ تجودُ","https://www.poetsgate.com/ViewPoem.aspx?id=182620",""],[5956,"قصة‎ ‎اللص والبَصَل","https://www.poetsgate.com/ViewPoem.aspx?id=184623",""],[6131,"قلبي الصغير","https://www.poetsgate.com/ViewPoem.aspx?id=189337",""],[6147,"أم الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=151698",""],[6167,"هذا المساء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85537&r=&rc=20",""],[6242,"لغة الخلود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87552&r=&rc=0",""],[2638,"بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87865&r=&rc=22",""],[6341,"أسئلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87275&r=&rc=4",""],[5190,"طَرَقات على باب الرحيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78319&r=&rc=32",""]],"verses":[["ودفء صريع يحن","إلى لمسه المبدع",0,"ع",1,0],["وَدَفٌّ لَها مِثلُ الصَفاةِ وَمِرفَقٌ","عَنِ الزَورِ مَفتولُ المُشاشَةِ أَفتَلُ",1,"ل",1,0],["وَدَفواءَحَدباءِ الذِراعِ يَزينُها","مِلاطٌ تَعادى عَن رَحا الزورِ أَدفَقُ",2,"ق",1,0],["ودفّ أشجار سمعنا به","ناعورة مطربة الوصف",3,"ف",1,1],["ودفين على بقايا دفين","مثل ما قال من سرت أمثاله",4,"ل",2,0],["ودفاعي خلالَ ذلك نفسي","عن خلاط الحرام بالإلمام",5,"م",1,0],["وَدَفّاعُ ضَيمٍ لا يُسامُ دَنِيَّةً","وَقَطّاعُ أَقرانِ الأُمورِ وَصولُها",6,"ل",3,0],["وَدَفَعْتُها وهيَ الهزيلَةُ","في مُغالَبَةِ الكُروبْ",7,"ب",1,0],["ودفنتها ودفنت خير قصائدي","معها وطال بقبرها إنشادي",8,"د",2,0],["وَدَفينٍ لَكَ فيهِ كَرُما","تَذرِفُ الدَمعَ لِذِكراهُ دَما",9,"م",2,0],["وَدَفعي بِكَ الأَعداءَ عَنّي وَإِنَّما","دَفَعتُ بِرُكنٍ مِن شَرَورى وَمَنكِبِ",10,"ب",1,0],["وَدَفَعتَ العَظيمَ عَنها وَلا يَد","فَعُ كُرهَ العَظيمِ غَيرُ العَظيمِ",11,"م",1,0],["ودَفْنَكِ بالأيدي الغريبةِ والْتَقَتْ","مع المَوتِ في إِخفاءِ شَخصِك في حدبِ",12,"ب",1,0],["وَدَفَعتُ في صَدرِ الدُجى عَن مَطلَبٍ","بَيني وَبَينَ الدَهرِ فيهِ قِراعُ",13,"ع",1,0],["وَدَفعِ الضَعيفِ وَأَكلَ اليَتيم","ونَهكِ الحُدودِ فَكُلٌّ حَرُم",14,"م",1,0],["وَدَفَعنا خَلفَهُ","صَلَتاناً هَيكَلا",15,"ل",2,0],["وَدَفنٌ وَالحَوادِثُ فاجِعاتٌ","لِإِحداهُنَّ إِحدى المَكرُماتِ",16,"ت",1,0],["وَدَفنُ الغانِياتِ لَهُنَّ أَوفى","مِنَ الكِلَلِ المَنيعَةِ وَالخُدورِ",17,"ر",1,0],["وَدَفِينٍ عَلى بَقايا دَفِينٍ","في طَويلِ الأزْمانِ وَالآباءِ",18,"ا",2,0],["وَدَفَّاعُ رَجلٍ كموجِ الفُرا","تِ يَقْدُمُ جَأْوَاءَ جُولاً طَحونَا",19,"ن",2,0],["ودُفوفٍ عَزَفْنَ لابْنَةِ فِرْعَو","نَ فماسَتْ بين الهَوى والدلالِ",20,"ل",1,0],["ودفّنا حكم الشذوذ رفاتا","واحتشدنا نتوّج الشعب حاكم",21,"م",1,0],["ودفعتَ للدار الحصينةِ أمةً","وقَفَتْ سياستُها على الأبواب",22,"ب",1,0],["ودفنتُه لا القَلبُ يُنشده","أسفاً ولا دَمْعي بمنسَكِب",23,"ب",1,0],["ودِفْنَ زُعافاً في حياتي يُحيلُها","إلى بُؤرةٍ من قسوةٍ وتقاطُع",24,"ع",1,0],["ودفنّا الكنوز يوم دفنّا","في ثراها الآباء جدّا فجدّا",25,"د",2,0],["ودفتر أعمالي تطرز بالخطا","وزادت عن التعداد حصراً شوائبه",26,"ب",2,0],["وَدِفاعٍ عَنهُم يَراهُ لَكَ اللَ","هُ وَيُثني بِهِ عَلَيكَ الإِمامُ",27,"م",1,0],["ودفعت إِذا جازى ثنائي جوده","لينال منه ولاتَ حينً جزاءِ",28,"ا",2,0],["ودفعَت في صدرِ الزمان براحةً","ألقته عنا للقفا والهامَ",29,"م",1,0],["ودفنته دفنَ الكلا","ب بذله وهوانه",30,"ن",2,0],["ودفقت فيه الحب ثم مرسته","وضربته عشرا وكنت أدوم",31,"م",1,0],["ودَفَنتُ شتّى الذكرياتِ","بِغورِ خافِقيَ الطعينِ",32,"ن",1,0],["ود في العمر لو يراكم طريقا","فتقضى وعينه في الطريق",33,"ق",1,0],["ودفاعه بمدافع الطرز الذي","كادت تمور الأرض من زلزاله",34,"ل",2,0],["وَدَفَنتُ شَرخَ شَبيبَتي في شَيبَتي","دَفنَ الحَبيبِ فَلي عَلَيهِ نَواحُ",35,"ح",1,0],["وَدَفينُ الشَوق يُبديه الجَوى","مِثلُ سِرِّ الزَند إذ يوريه قَدحُ",36,"ح",1,0],["ودَفعُ الحقِّ بالباطِ","لِ يا مَولايَ بُهتانُ",37,"ن",1,0],["وَدَفعَهُمُ الجَعدِيَّ إِذ يَطرُدونَهُ","وَأَدرَكَهُ التَحكيمُ وَالقَصَبُ السُمرُ",38,"ر",1,0],["ودفع صدر قوله بالعجز","عسى يتوب عن عراض المعجز",39,"ز",1,0],["ودَفَعْتَ في صدرِ الخطوبِ","وقد أَلْقَتْ كلاكِلَ صدرِها كَلاَّ",40,"ل",2,0],["ودفّفي وبعدَ ذا","فإنْ أردتِ صفّقي",41,"ق",2,0],["ودفَعَتْ حُماتُهم عن نُوبٍ","عظائمٍ تُكشَفُ بالعظائمِ",42,"م",1,0],["ودفَّعَت البَصرةُ المجدَ عن","ك حتّى ضعُفتِ فلم تدفعي",43,"ع",2,0],["ودفينٌ من الفضائل نادا","ك من التُّربِ مَيْتُه المقبورُ",44,"ر",1,0],["ودفينٌ مُلجيء الجاني إذا","أسْلمتهُ ذممُ الصيدِ المَوالي",45,"ل",2,0],["ودفنت في قبر الهموم وضمني","كفنان ضيقُ الصدر والتفكيرُ",46,"ر",1,0],["ودفاعُهمْ عنّي يُرفّهني","عن أنْ أمُدَّ يداً إلى نَصْلي",47,"ل",2,0],["ودفاعُ ربّك عنك شرَّ عقابهِ","عن سيّئٍ خيرٌ من الدّفَّاعِ",48,"ع",1,0],["وَدِفاعُهمْ وَقِراعُهمْ أدراعهمْ","يومَ الوغى من طعنِ كلّ وريدِ",49,"د",1,0],["ودفاعٌ عنّي العدا ونزاعٌ","أرتضيهِ وهدنةٌ وحروبُ",50,"ب",1,0],["ودفاعٌ ونزالٌ","وسؤالٌ وجوابُ",51,"ب",1,0],["ودفوف الحق من نق","رتها زالت سناتي",52,"ت",2,0],["ودفاعا عن الهضيم وذوداً","عن حماه بهمة قعساه",53,"ا",2,0],["وَدفعت عَنها كل سوء نالَها","فِيما مَضى مِن ملحد وَأَثيم",54,"م",1,0],["ودفاعه عنا الخطوب وكشفه","ظلم الكروب وعفوه وإبائه",55,"ا",3,0],["ودفاعٌ عن البلاد القوَى المل","أَى بها أم على البلاد هجوم",56,"م",1,0],["وَدَفعَ الخُدّام حَولَ الوَحش","وَهوَ غَدا مُنحَصِراً لا يَمشي",57,"ي",1,0],["ودُفنتَ في الأضلاعِ حيّاً شامخاً","إن العزيزَ بغيرِها لن يُدفنا",58,"ن",2,0],["وَدفِّقِ السَّيْلَ في آكامِها سَحَرًا","يَشْتَاقُ ثَغْرَكَ فِي كانُونَ وَادِيهَا",59,"ي",3,0],["ودفق فناك وحقق فناك","وطلق شذاك إذا ما رعد",60,"د",1,0],["وَدَفَنَّاهُ وَسطَ قَبرٍ حَوا","لَيهِ قُبُورٌ مِن أَهلِهِ آهِلاتُ",61,"ت",1,0],["وَدَفْنُهُ أوْ جَعْلُهُ أمانَهْ","يَخُلُّ بِالاِيْمانِ وَالدِّيانَهْ",62,"ه",1,0],["ودفع صائل على معصوم أو","خيف انفجار ميت لو التهوا",63,"ه",3,0],["ودفنُهُ فيهِ صَلاحُ لهُ","معْ أَنَّه مِنْ نَجْلِ قَومٍ كِرامْ",64,"م",1,0],["ودفع أسمائك عجل المدد","والنصر والتفريج والفتح القريب",65,"ب",1,0],["ودفيناً دفنتُ منه حساماً","كنتُ أعددته لحرب الزمان",66,"ن",1,0],["ودفاتر الكتاب أكثرها بها ال","تصحيح والتصليح والتنقير",67,"ر",1,0],["ودفين به كمية لحم","أبيض الرز لامع النور",68,"ر",1,0],["ودفين على بقايا دفين","في ظلام عنه اختفى النيرانِ",69,"ن",1,0],["ودفعي الهم بالأماني","فارقت روحي مع الفراق",70,"ق",1,0],["وَدَفَعتُمُ صَرفَ الزَمانِ وَريبَهُ","عَنّا وَحامَيتُم عَنِ الأَحسابِ",71,"ب",1,0],["ودَفَقْنَ لي وردَ القُدُودِ وراودتْ","ثغري الصديِّ بشربِ أعذبِ موردِ",72,"د",1,0],["ودَفْتَدار السَّعْدِ في القَصْرِ جَلَسْ","لازال مَحْرُوساً بآياتِ الحَرَسْ",73,"س",1,0],["ودفتدارُ السَّعدِ والمجدِ حَضَرْ","والكُدْخَدا حضورهُ فيه الوطَرْ",74,"ر",1,0],["ودف ومزمار وجارية الغنا","وعود وعن إيجار ذلك فاصدد",75,"د",1,0],["ودفاعهم فتح الإله لهم","قاموا به للحق واجتهدوا",76,"د",3,0],["ودفعنا النقود حمرا فكانت","ليس إلا أرواحنا ودمانا",77,"ن",2,0],["ودفوف المزكلشين وللنا","س عليهم تزاحم ودخول",78,"ل",1,0],["ودفنُ الحيّ للموتى قديم","فليس له ولا للموت آخر",79,"ر",1,0],["وَدَفَنْتُمْ شِرارَكُمْ بِوِدادِ","أيُّ شَيءٍ جَوابُكُمْ لِلرَسولِ",80,"ل",1,0],["ودفتر الحب أمسى في الهوا مزقاً","لكنما فيك تحيا تلكم المزق",81,"ق",1,0],["وَدَفَعنَ عاديَةَ الهُذَيلِ فَلَم يُرِد","جَيشٌ لِتَغلِبَ بَعدَها ليَعودا",82,"د",2,0],["ودفعها جائز لو كان نافلة","وليس تحتاج أن تستأذن الرجلا",83,"ل",2,0],["وَدَفَعْتُ منه في سَوَا","دِ الخَطْبِ ثَقَّاباً شِهابُهْ",84,"ب",2,0],["ودفقتَ من فَمِكَ المِياهَ ليَنهَلُوا","منها كما قد جاءَ في الجليانِ",85,"ن",1,0],["وَدفعت عَن جاهٍ وَملكٍ باذخٍ","وَظُباك أَدوى وَالتدافع أَدوَم",86,"م",1,0],["وَدَفعته دَفع الهزبر عدوَّه","عَن شبله ببراثن لا تُثلَم",86,"م",1,0],["وَدَفعي مَنكِبَ الاَسدِيِّ عَني","عَلَى عَجَلٍ بِنَاحيةٍ زَبُونِ",87,"ن",1,0],["وَدَفعُ مَا قَد يَكُونُ مشن تَوَهُّمِ تَخ","صِيصٍ يَبِينُ لِمَن لَم يُعطِهِ نَظَرَه",88,"ر",2,0],["ودفئ الإنسان فهو دفآن","وامرأة دفأى فقس يا إنسان",89,"ن",1,0],["ودفع الإغريق بدء الأمر","فانهزموا عن ميتهم بالقسر",90,"ر",1,0],["ودفاع البلا عن به","م طروادٍ ونسوتها",91,"ه",2,0],["ودفع ذاك ليس في قوى البشر","فليس لي مما قضى الله مضر",92,"ر",1,0],["وَدَفَعَتَ الأَنامَ دَفعاً قَوياً","فَتَجَنّوا عَلى ضِعاف العِبادِ",93,"د",1,0],["ودفعتم عن بيضكم بل سُمرِكم","بالبيض بل بالسَّمرة الصعداء",94,"ا",2,0],["ودفعت السلال يقصف مني","زهرة لم يشق عنها الكمام",95,"م",1,0],["ودفارُنا بالترهات كذوبَةٌ","فالعز فيها والبَقاءُ غرورُ",96,"ر",1,0],["ودفاتري حولي تُسامرني وما","غيرُ الحروف بخاطري تتجمعُ",97,"ع",1,0],["ودفن الحق صار حليف قومي","وقلب العرْب في الأوهام يغفو",98,"ف",2,0],["ودفنتها بثرى التجاهلِ عِندَما","ذرَفتْ هواكَ من المحاجرِ عَنْدَمَا",99,"م",2,0],["ودفعت أيام السنين رخيصة","وأذقت شعبي لوعة الحرمان",100,"ن",1,0],["ودفاعٌ عن الحمى كنت فيه","ما لغير الحمى تروم وتقصد",101,"د",1,0],["ودفنت في وضر الجحود ضياءهُ","دفنَ الثرى للجوهر الشفّاف",102,"ف",1,0],["ودفتريَ المليئُ بذكرياتي","كأنَّ الحزنَ للأقلامِ يُمْلي",103,"ل",2,0],["ودفعت مخزون لمواهب وعززت","خيالي اللي مابقاله بقيه",104,"ي",2,0],["ودفعنا عنك الزمان إلى أن","يغدتي طايعا اليك منيبا",105,"ب",2,0],["ودفنت روحك يوم ورق شببها","وأصبحت وحدك وانت بي دوم مصحوب",106,"ب",1,0],["ودفعت نفسا في محاسنها ولم","أحجم ومالي في البدار عداء",107,"ا",2,0],["ودفعاً لما قد حل من فادح دها","وكشف الضر وانتصاراً على ض",108,"ض",1,0],["ودفتر قصيدٍ كل يوم يترجّاك","ما فيه يومٍ ما سهرت ودرسته",109,"ت",2,0],["ودفعُ الريح تدفعكم","طواحين دور سدئ",110,"د",2,0],["ودفاتري فيها شهيق حائر","تبكي ضياعي والهموم مسافرة",111,"ر",2,0],["ودفعُ الريح تدفعكم","طواحينٌ