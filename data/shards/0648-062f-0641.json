{"poems":[[100,"اليوم الجنين","https://www.aldiwan.net/poem43675.html","عموديه"],[24,"ألا بكرت عرسي تلوم وتعذل","https://www.aldiwan.net/poem21876.html","الطويل"],[30,"أدارا بحزوى هجت للعين عبرة","https://www.aldiwan.net/poem29554.html","الطويل"],[72,"ودف أشجار سمعنا به","https://www.aldiwan.net/poem19337.html","السريع"],[72,"كل حي قاض عليه زواله","https://www.aldiwan.net/poem19528.html","الخفيف"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[29,"ألا طرقت أروى الرحال وصحبتي","https://www.aldiwan.net/poem6158.html","الطويل"],[92,"مهما تأملت الحياة","https://www.aldiwan.net/poem38971.html","مجزوء الكامل"],[85,"بعثوا الخلافة سيرة في النادى","https://www.aldiwan.net/poem7110.html","الكامل"],[85,"أحمدك الله وأطري الأنبياء","https://www.aldiwan.net/poem8099.html","الرمل"],[45,"بنا أنت من مفجوة لم تعتب","https://www.aldiwan.net/poem10896.html","الطويل"],[45,"أيما خلة ووصل قديم","https://www.aldiwan.net/poem66652.html","الخفيف"],[80,"خطاب الرزايا إنه جلل الخطب","https://www.aldiwan.net/poem31550.html","الطويل"],[74,"من ليلة للرعد فيها صرخة","https://www.aldiwan.net/poem13176.html","الكامل"],[21,"لك الحمد والمن رب العباد","https://www.aldiwan.net/poem36163.html","المتقارب"],[52,"أسألت طللا","https://www.aldiwan.net/poem26765.html","مجزوء الرمل"],[46,"ترنم في نهارك مستعينا","https://www.aldiwan.net/poem22214.html","الوافر"],[46,"أفي الإحسان غربا جاء جذبا","https://www.aldiwan.net/poem22689.html","الوافر"],[46,"غير مجد في ملتي واعتقادي","https://www.aldiwan.net/poem23625.html","الخفيف"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67349","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[100,"مآتم وأعراس","https://www.poetsgate.com/ViewPoem.aspx?id=50173",""],[90,"إلى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179104",""],[90,"أنا !","https://www.poetsgate.com/ViewPoem.aspx?id=179156",""],[90,"أجب أيُّها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=179171",""],[94,"من كسعد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66301&r=&rc=19",""],[116,"دع الفكر واصبر فالزمان صعائبه","https://www.aldiwan.net/poem41944.html","الطويل"],[144,"لا تجز في الذي بلغت الأنام","https://www.aldiwan.net/poem11812.html","الخفيف"],[161,"بي من فتور المقلة الكحلاء","https://www.aldiwan.net/poem58775.html","الكامل"],[161,"ما للعلى عتب على الأيام","https://www.aldiwan.net/poem58895.html","الكامل"],[187,"هذا المورث قال لي","https://www.aldiwan.net/poem43233.html","مجزوء الكامل"],[187,"وأخذت من دبس العراق ومثله","https://www.aldiwan.net/poem43309.html","الكامل"],[198,"كفي الملام وعلليني","https://www.aldiwan.net/poem39948.html","مجزوء الكامل"],[211,"يا أهيل الحمى وعرب الفريق","https://www.aldiwan.net/poem13300.html","الخفيف"],[223,"قمر تجلى في سماء كماله","https://www.aldiwan.net/poem55413.html","الكامل"],[283,"سري بألسنة الدموع يباح","https://www.aldiwan.net/poem32814.html","الكامل"],[298,"لمن العيس لها في البيد نفح","https://www.aldiwan.net/poem33307.html","الرمل"],[372,"على طرفك برهان","https://www.aldiwan.net/poem57032.html","الهزج"],[384,"فلم أنسهم يوم الخميس وكرهم","https://www.aldiwan.net/poem24192.html","الطويل"],[404,"أحسن ما يبدي به الكلام","https://www.aldiwan.net/poem33344.html","الرجز"],[433,"آيات جدك لم تزل تتلى","https://www.aldiwan.net/poem12379.html","الكامل"],[433,"يا هذه لا تنطقي","https://www.aldiwan.net/poem12812.html","مجزوء الرجز"],[459,"أتعلمين يا ابنة الأعاجم","https://www.aldiwan.net/poem55879.html","الرجز"],[459,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[459,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[462,"لمن الخيل كأمثال السعالي","https://www.aldiwan.net/poem15101.html","الرمل"],[528,"يا دهر إنك بالرجال بصير","https://www.aldiwan.net/poem45971.html","الكامل"],[552,"خذ صاحبي عني الذي أملي","https://www.aldiwan.net/poem47284.html","أحذ الكامل"],[552,"إني الشجاع وقد جزعت كما ترى","https://www.aldiwan.net/poem47701.html","الكامل"],[552,"بالله يا أيام يثرب عودي","https://www.aldiwan.net/poem47844.html","الكامل"],[552,"ليس للقلب في السلو نصيب","https://www.aldiwan.net/poem48092.html","الخفيف"],[552,"من لداع لا يجاب","https://www.aldiwan.net/poem48097.html","مجزوء الرمل"],[559,"ظهرت ذاتي لذاتي","https://www.aldiwan.net/poem34729.html","مجزوء الرمل"]],"verses":[["ودفء صريع يحن","إلى لمسه المبدع",0,"ع",1,0],["وَدَفٌّ لَها مِثلُ الصَفاةِ وَمِرفَقٌ","عَنِ الزَورِ مَفتولُ المُشاشَةِ أَفتَلُ",1,"ل",1,0],["وَدَفواءَحَدباءِ الذِراعِ يَزينُها","مِلاطٌ تَعادى عَن رَحا الزورِ أَدفَقُ",2,"ق",1,0],["ودفّ أشجار سمعنا به","ناعورة مطربة الوصف",3,"ف",1,1],["ودفين على بقايا دفين","مثل ما قال من سرت أمثاله",4,"ل",2,0],["ودفاعي خلالَ ذلك نفسي","عن خلاط الحرام بالإلمام",5,"م",1,0],["وَدَفّاعُ ضَيمٍ لا يُسامُ دَنِيَّةً","وَقَطّاعُ أَقرانِ الأُمورِ وَصولُها",6,"ل",3,0],["وَدَفَعْتُها وهيَ الهزيلَةُ","في مُغالَبَةِ الكُروبْ",7,"ب",1,0],["ودفنتها ودفنت خير قصائدي","معها وطال بقبرها إنشادي",8,"د",2,0],["وَدَفينٍ لَكَ فيهِ كَرُما","تَذرِفُ الدَمعَ لِذِكراهُ دَما",9,"م",2,0],["وَدَفعي بِكَ الأَعداءَ عَنّي وَإِنَّما","دَفَعتُ بِرُكنٍ مِن شَرَورى وَمَنكِبِ",10,"ب",1,0],["وَدَفَعتَ العَظيمَ عَنها وَلا يَد","فَعُ كُرهَ العَظيمِ غَيرُ العَظيمِ",11,"م",1,0],["ودَفْنَكِ بالأيدي الغريبةِ والْتَقَتْ","مع المَوتِ في إِخفاءِ شَخصِك في حدبِ",12,"ب",1,0],["وَدَفَعتُ في صَدرِ الدُجى عَن مَطلَبٍ","بَيني وَبَينَ الدَهرِ فيهِ قِراعُ",13,"ع",1,0],["وَدَفعِ الضَعيفِ وَأَكلَ اليَتيم","ونَهكِ الحُدودِ فَكُلٌّ حَرُم",14,"م",1,0],["وَدَفَعنا خَلفَهُ","صَلَتاناً هَيكَلا",15,"ل",2,0],["وَدَفنٌ وَالحَوادِثُ فاجِعاتٌ","لِإِحداهُنَّ إِحدى المَكرُماتِ",16,"ت",1,0],["وَدَفنُ الغانِياتِ لَهُنَّ أَوفى","مِنَ الكِلَلِ المَنيعَةِ وَالخُدورِ",17,"ر",1,0],["وَدَفِينٍ عَلى بَقايا دَفِينٍ","في طَويلِ الأزْمانِ وَالآباءِ",18,"ا",2,0],["وَدَفَّاعُ رَجلٍ كموجِ الفُرا","تِ يَقْدُمُ جَأْوَاءَ جُولاً طَحونَا",19,"ن",2,0],["ودُفوفٍ عَزَفْنَ لابْنَةِ فِرْعَو","نَ فماسَتْ بين الهَوى والدلالِ",20,"ل",1,0],["ودفّنا حكم الشذوذ رفاتا","واحتشدنا نتوّج الشعب حاكم",21,"م",1,0],["ودفعتَ للدار الحصينةِ أمةً","وقَفَتْ سياستُها على الأبواب",22,"ب",1,0],["ودفنتُه لا القَلبُ يُنشده","أسفاً ولا دَمْعي بمنسَكِب",23,"ب",1,0],["ودِفْنَ زُعافاً في حياتي يُحيلُها","إلى بُؤرةٍ من قسوةٍ وتقاطُع",24,"ع",1,0],["ودفنّا الكنوز يوم دفنّا","في ثراها الآباء جدّا فجدّا",25,"د",2,0],["ودفتر أعمالي تطرز بالخطا","وزادت عن التعداد حصراً شوائبه",26,"ب",2,0],["وَدِفاعٍ عَنهُم يَراهُ لَكَ اللَ","هُ وَيُثني بِهِ عَلَيكَ الإِمامُ",27,"م",1,0],["ودفعت إِذا جازى ثنائي جوده","لينال منه ولاتَ حينً جزاءِ",28,"ا",2,0],["ودفعَت في صدرِ الزمان براحةً","ألقته عنا للقفا والهامَ",29,"م",1,0],["ودفنته دفنَ الكلا","ب بذله وهوانه",30,"ن",2,0],["ودفقت فيه الحب ثم مرسته","وضربته عشرا وكنت أدوم",31,"م",1,0],["ودَفَنتُ شتّى الذكرياتِ","بِغورِ خافِقيَ الطعينِ",32,"ن",1,0],["ود في العمر لو يراكم طريقا","فتقضى وعينه في الطريق",33,"ق",1,0],["ودفاعه بمدافع الطرز الذي","كادت تمور الأرض من زلزاله",34,"ل",2,0],["وَدَفَنتُ شَرخَ شَبيبَتي في شَيبَتي","دَفنَ الحَبيبِ فَلي عَلَيهِ نَواحُ",35,"ح",1,0],["وَدَفينُ الشَوق يُبديه الجَوى","مِثلُ سِرِّ الزَند إذ يوريه قَدحُ",36,"ح",1,0],["ودَفعُ الحقِّ بالباطِ","لِ يا مَولايَ بُهتانُ",37,"ن",1,0],["وَدَفعَهُمُ الجَعدِيَّ إِذ يَطرُدونَهُ","وَأَدرَكَهُ التَحكيمُ وَالقَصَبُ السُمرُ",38,"ر",1,0],["ودفع صدر قوله بالعجز","عسى يتوب عن عراض المعجز",39,"ز",1,0],["ودَفَعْتَ في صدرِ الخطوبِ","وقد أَلْقَتْ كلاكِلَ صدرِها كَلاَّ",40,"ل",2,0],["ودفّفي وبعدَ ذا","فإنْ أردتِ صفّقي",41,"ق",2,0],["ودفَعَتْ حُماتُهم عن نُوبٍ","عظائمٍ تُكشَفُ بالعظائمِ",42,"م",1,0],["ودفَّعَت البَصرةُ المجدَ عن","ك حتّى ضعُفتِ فلم تدفعي",43,"ع",2,0],["ودفينٌ من الفضائل نادا","ك من التُّربِ مَيْتُه المقبورُ",44,"ر",1,0],["ودفينٌ مُلجيء الجاني إذا","أسْلمتهُ ذممُ الصيدِ المَوالي",45,"ل",2,0],["ودفنت في قبر الهموم وضمني","كفنان ضيقُ الصدر والتفكيرُ",46,"ر",1,0],["ودفاعُهمْ عنّي يُرفّهني","عن أنْ أمُدَّ يداً إلى نَصْلي",47,"ل",2,0],["ودفاعُ ربّك عنك شرَّ عقابهِ","عن سيّئٍ خيرٌ من الدّفَّاعِ",48,"ع",1,0],["وَدِفاعُهمْ وَقِراعُهمْ أدراعهمْ","يومَ الوغى من طعنِ كلّ وريدِ",49,"د",1,0],["ودفاعٌ عنّي العدا ونزاعٌ","أرتضيهِ وهدنةٌ وحروبُ",50,"ب",1,0],["ودفاعٌ ونزالٌ","وسؤالٌ وجوابُ",51,"ب",1,0],["ودفوف الحق من نق","رتها زالت سناتي",52,"ت",2,0]]}