{"poems":[[0,"ألا عم صباحاً أيها الطلل البالي","https://www.aldiwan.net/poem51.html","الطويل"],[93,"يا مصر أنت الأهل والسكن","https://www.aldiwan.net/poem11174.html","أحذ الكامل"],[27,"ألا زارت وأهل منى هجود","https://www.aldiwan.net/poem5731.html","الوافر"],[26,"ألا زعمت أسماء أن لا أحبها","https://www.aldiwan.net/poem24103.html","الطويل"],[89,"اذكري إذ كنا صغيرين نلعب","https://www.aldiwan.net/poem44865.html","الخفيف"],[85,"الأزبكية فيها درة عجب","https://www.aldiwan.net/poem7748.html","البسيط"],[85,"شرفاً نصير ارفع جبينك عالياً","https://www.aldiwan.net/poem8081.html","الكامل"],[45,"أما معين على الشوق الذي غريت","https://www.aldiwan.net/poem63500.html","البسيط"],[28,"ألا زعمت عرسي سويدة أنها","https://www.aldiwan.net/poem1243.html",""],[58,"الأزد سيفي على الأعداء كلهم","https://www.aldiwan.net/poem31152.html","البسيط"],[74,"ألا زاحم الليل بي أشقر","https://www.aldiwan.net/poem12859.html","المتقارب"],[33,"ألا يا عقاب الوكر وكر ضرية","https://www.aldiwan.net/poem25910.html","الطويل"],[52,"ومما شجاني بارق لاح موهنا","https://www.aldiwan.net/poem26880.html","الطويل"],[7,"وأعيار صوادر عن حماتا","https://www.aldiwan.net/poem1958.html","الوافر"],[8,"فمن يك سائلا عني فإني","https://www.aldiwan.net/poem21851.html","الوافر"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16664","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54238","الرمل"],[0,"ألا عِمْ صَبَاحاً أيّهَا الطّلَلُ البَالي","https://www.poetsgate.com/ViewPoem.aspx?id=4731",""],[94,"إيه حكيم الدّهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66311&r=&rc=29",""],[276,"بشراك نصر الله مقتبل","https://www.aldiwan.net/poem25538.html","أحذ الكامل"],[365,"صوت حمام الأيك عند الصباح","https://www.aldiwan.net/poem60968.html","السريع"],[501,"قف بالركاب فهذه الأطلال","https://www.aldiwan.net/poem37628.html","الكامل"],[564,"هو الموت عضب لا تخون مضاربه","https://www.aldiwan.net/poem13604.html","الطويل"]],"verses":[["أَلا زَعَمَت بَسباسَةُ اليَومَ أَنَّني","كَبِرتُ وَأَن لا يُحسِنُ اللَهوَ أَمثالي",0,"ل",2,0],["أَلأَزْهَرُ الأَزْهَى لَهُ مِنَنٌ","عَظُمَتْ وَهَذِي دُونَهَا المِنَنُ",1,"ن",1,0],["أَلا زارَت وَأَهلُ مِنىً هُجودُ","وَلَيتَ خَيالَها بِمِنىً يَعودُ",2,"د",1,1],["أَلا زَعَمَت أَسماءُ أَن لا أُحِبُّها","فَقُلتُ بَلى لَولا يُنازِعُني شُغلي",3,"ل",2,1],["الازاهير تحتنا تتلوى","والعصافير فوقنا تتوثب",4,"ب",1,0],["الأزبكية فيها درة عجب","والنجم في الأفق كالنقاد يفليها",5,"ي",3,1],["الأَزمَةَ اِشتَدَّت وَرانَ بَلاؤُها","فَاِصدِم بِرُكنِكَ رُكنَها لِيَميلا",6,"ل",2,0],["أَلازِمي الكُفرُ إِن لَم أَجزِها كَمَلاً","أَم لاحِقي العَجزُ إِن لَم أُحصِها عَدَدا",7,"د",2,0],["أَلا زَعَمَت عِرسي سُوَيدَةُ أَنَّها","سَريعٌ عَلَيها حِفظَتي لِلمُعاتِبِ",8,"ب",1,1],["الأَزدُ سِيَفي عَلى الأَعداءِ كُلِّهِمُ","وَسيفُ أَحمَدَ مَن دانَت لَهُ العَرَبُ",9,"ب",1,1],["الأَزدُ أَزيَدُ مَن يَمشي عَلى قَدَمٍ","فَضلاً وَأَعلاهُمُ قَدراً إِذا رَكِبوا",9,"ب",3,0],["أَلا زاحَمَ اللَيلَ بي أَشقَرٌ","تَصَوَّبَ تَحتَ الدُجى كَوكَبا",10,"ب",2,1],["أَلا زَعَمَت لَيلى بِأَن لا أُحِبُّها","بَلى وَاللَيالي العَشرِ وَالشَفعِ وَالوَترِ",11,"ر",1,0],["أَلا زَوِّدي يا رَبَّةَ الخِدرِ راجِلاً","تَتَبَّعَ أَرضاً قَد دَعَت شَخصُهُ رَضّا",12,"ض",2,0],["أَلا زَعَمَت بَنو عَبسٍ بِأَنّي","أَلا كَذَبوا كَبيرُ السِنِّ فانِ",13,"ن",1,0],["أَلا زَعَمَت بَنُو كَعبٍ بأَنّي","أَلا كَذَبُوا كَبِيرُ السِنِّ فاني",14,"ن",2,0],["ألا زَوِّدُوني شَرْبَةً ولو أنّني","قَدَرْتُ إذا أفنَيْتُ دِجلةَ بالجَرْع",15,"ع",1,0],["الأزاهيرُ به من قُبَلٍ","والينابيعُ رَحيقُ العِنب",16,"ب",1,0],["ألا زعمت بسبابة ُ اليوم أنني","كبرت وأن لا يحسنُ اللهو أمثالي",17,"ل",2,0],["الأزرق الرجراج حنّ لرملة","في الدّجلتين نديّة مسماح",18,"ح",1,0],["الأَزْرُ مَشْدُودٌ فَلا وَهَنٌ","وَالثَّغْرُ مَسْدُودٌ فَلا خَلَلُ",19,"ل",1,0],["أُلازِمُ الحَضْرةَ دهْراً إلى","أن يَتأنّى لي أوانُ السَّراح",20,"ح",1,0],["الأزهير الرحب الذراع المرتجي","إن ضاق من صدم الحوادث حال",21,"ل",1,0],["ألازِمُهُ المَكتوبُ أَن حَلَّ رابَنا","وَلَكِن نِظامُ العالَمِ اِنحَلَّ كاتِبُه",22,"ب",2,0]]}