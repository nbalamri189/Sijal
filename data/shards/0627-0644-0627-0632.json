{"poems":[[0,"ألا عم صباحاً أيها الطلل البالي","https://www.aldiwan.net/poem51.html","الطويل"],[95,"يا مصر أنت الأهل والسكن","https://www.aldiwan.net/poem11174.html","أحذ الكامل"],[29,"ألا زارت وأهل منى هجود","https://www.aldiwan.net/poem5731.html","الوافر"],[26,"ألا زعمت أسماء أن لا أحبها","https://www.aldiwan.net/poem24103.html","الطويل"],[91,"اذكري إذ كنا صغيرين نلعب","https://www.aldiwan.net/poem44865.html","الخفيف"],[87,"الأزبكية فيها درة عجب","https://www.aldiwan.net/poem7748.html","البسيط"],[87,"شرفاً نصير ارفع جبينك عالياً","https://www.aldiwan.net/poem8081.html","الكامل"],[47,"أما معين على الشوق الذي غريت","https://www.aldiwan.net/poem63500.html","البسيط"],[30,"ألا زعمت عرسي سويدة أنها","https://www.aldiwan.net/poem1243.html",""],[60,"الأزد سيفي على الأعداء كلهم","https://www.aldiwan.net/poem31152.html","البسيط"],[76,"ألا زاحم الليل بي أشقر","https://www.aldiwan.net/poem12859.html","المتقارب"],[35,"ألا يا عقاب الوكر وكر ضرية","https://www.aldiwan.net/poem25910.html","الطويل"],[54,"ومما شجاني بارق لاح موهنا","https://www.aldiwan.net/poem26880.html","الطويل"],[7,"وأعيار صوادر عن حماتا","https://www.aldiwan.net/poem1958.html","الوافر"],[8,"فمن يك سائلا عني فإني","https://www.aldiwan.net/poem21851.html","الوافر"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16664","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54238","الرمل"],[0,"ألا عِمْ صَبَاحاً أيّهَا الطّلَلُ البَالي","https://www.poetsgate.com/ViewPoem.aspx?id=4731",""],[96,"إيه حكيم الدّهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66311&r=&rc=29",""],[280,"بشراك نصر الله مقتبل","https://www.aldiwan.net/poem25538.html","أحذ الكامل"],[369,"صوت حمام الأيك عند الصباح","https://www.aldiwan.net/poem60968.html","السريع"],[505,"قف بالركاب فهذه الأطلال","https://www.aldiwan.net/poem37628.html","الكامل"],[568,"هو الموت عضب لا تخون مضاربه","https://www.aldiwan.net/poem13604.html","الطويل"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107246","الوافر"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107232","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122823","الوافر"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101474","الكامل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104596","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/39001","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38962","البسيط"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107196","الوافر"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126184","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46568","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49997","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49931","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79928","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48937","الوافر"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111842","الطويل"],[1820,"","https://poetry.dctabudhabi.ae/diwan/poem/128132","الطويل"],[1828,"","https://poetry.dctabudhabi.ae/diwan/poem/89635","المنسرح"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125423","البسيط"],[1873,"","https://poetry.dctabudhabi.ae/diwan/poem/73007","الطويل"],[1929,"","https://poetry.dctabudhabi.ae/diwan/poem/110698","الوافر"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100466","الوافر"],[2074,"","https://poetry.dctabudhabi.ae/diwan/poem/33088","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100761","الكامل"],[3369,"","https://poetry.dctabudhabi.ae/diwan/poem/117037","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205579",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205676",""],[3975,"","https://poetry.dctabudhabi.ae/diwan/poem/75825","الطويل"],[4243,"","https://poetry.dctabudhabi.ae/diwan/poem/122432","الطويل"],[4280,"","https://poetry.dctabudhabi.ae/diwan/poem/130533","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58077","الطويل"],[4617,"","https://poetry.dctabudhabi.ae/diwan/poem/116528","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139522",""],[4623,"","https://poetry.dctabudhabi.ae/diwan/poem/140153",""],[5206,"مناهج الله","https://www.poetsgate.com/ViewPoem.aspx?id=187391",""],[3975,"أَلا زعمت أَبناء يشكر اننا","https://www.poetsgate.com/ViewPoem.aspx?id=8292",""],[5701,"أين المعز الفاطمي وجوهر","https://www.poetsgate.com/ViewPoem.aspx?id=164689",""],[402,"يا مصر أنت الهل والسكن","https://www.poetsgate.com/ViewPoem.aspx?id=36539",""],[6027,"وأحرز في الجوى السبقا","https://www.poetsgate.com/ViewPoem.aspx?id=187669",""]],"verses":[["أَلا زَعَمَت بَسباسَةُ اليَومَ أَنَّني","كَبِرتُ وَأَن لا يُحسِنُ اللَهوَ أَمثالي",0,"ل",2,0],["أَلأَزْهَرُ الأَزْهَى لَهُ مِنَنٌ","عَظُمَتْ وَهَذِي دُونَهَا المِنَنُ",1,"ن",1,0],["أَلا زارَت وَأَهلُ مِنىً هُجودُ","وَلَيتَ خَيالَها بِمِنىً يَعودُ",2,"د",1,1],["أَلا زَعَمَت أَسماءُ أَن لا أُحِبُّها","فَقُلتُ بَلى لَولا يُنازِعُني شُغلي",3,"ل",2,1],["الازاهير تحتنا تتلوى","والعصافير فوقنا تتوثب",4,"ب",1,0],["الأزبكية فيها درة عجب","والنجم في الأفق كالنقاد يفليها",5,"ي",3,1],["الأَزمَةَ اِشتَدَّت وَرانَ بَلاؤُها","فَاِصدِم بِرُكنِكَ رُكنَها لِيَميلا",6,"ل",2,0],["أَلازِمي الكُفرُ إِن لَم أَجزِها كَمَلاً","أَم لاحِقي العَجزُ إِن لَم أُحصِها عَدَدا",7,"د",2,0],["أَلا زَعَمَت عِرسي سُوَيدَةُ أَنَّها","سَريعٌ عَلَيها حِفظَتي لِلمُعاتِبِ",8,"ب",1,1],["الأَزدُ سِيَفي عَلى الأَعداءِ كُلِّهِمُ","وَسيفُ أَحمَدَ مَن دانَت لَهُ العَرَبُ",9,"ب",1,1],["الأَزدُ أَزيَدُ مَن يَمشي عَلى قَدَمٍ","فَضلاً وَأَعلاهُمُ قَدراً إِذا رَكِبوا",9,"ب",3,0],["أَلا زاحَمَ اللَيلَ بي أَشقَرٌ","تَصَوَّبَ تَحتَ الدُجى كَوكَبا",10,"ب",2,1],["أَلا زَعَمَت لَيلى بِأَن لا أُحِبُّها","بَلى وَاللَيالي العَشرِ وَالشَفعِ وَالوَترِ",11,"ر",1,0],["أَلا زَوِّدي يا رَبَّةَ الخِدرِ راجِلاً","تَتَبَّعَ أَرضاً قَد دَعَت شَخصُهُ رَضّا",12,"ض",2,0],["أَلا زَعَمَت بَنو عَبسٍ بِأَنّي","أَلا كَذَبوا كَبيرُ السِنِّ فانِ",13,"ن",1,0],["أَلا زَعَمَت بَنُو كَعبٍ بأَنّي","أَلا كَذَبُوا كَبِيرُ السِنِّ فاني",14,"ن",2,0],["ألا زَوِّدُوني شَرْبَةً ولو أنّني","قَدَرْتُ إذا أفنَيْتُ دِجلةَ بالجَرْع",15,"ع",1,0],["الأزاهيرُ به من قُبَلٍ","والينابيعُ رَحيقُ العِنب",16,"ب",1,0],["ألا زعمت بسبابة ُ اليوم أنني","كبرت وأن لا يحسنُ اللهو أمثالي",17,"ل",2,0],["الأزرق الرجراج حنّ لرملة","في الدّجلتين نديّة مسماح",18,"ح",1,0],["الأَزْرُ مَشْدُودٌ فَلا وَهَنٌ","وَالثَّغْرُ مَسْدُودٌ فَلا خَلَلُ",19,"ل",1,0],["أُلازِمُ الحَضْرةَ دهْراً إلى","أن يَتأنّى لي أوانُ السَّراح",20,"ح",1,0],["الأزهير الرحب الذراع المرتجي","إن ضاق من صدم الحوادث حال",21,"ل",1,0],["ألازِمُهُ المَكتوبُ أَن حَلَّ رابَنا","وَلَكِن نِظامُ العالَمِ اِنحَلَّ كاتِبُه",22,"ب",2,0],["أَلا زَعمت بأَنَّ الكاسَ يَصبو","إِلى الساقِي ويجنِي ما جَنَيتُ",23,"ت",1,0],["ألا زمنٌ يبلِّغُنِي مُرادِي","ويُسعِدُني بيومٍ مِن سُعادِ",24,"د",1,1],["أُلازِمُ هَديَهُ طِفلاً وَكَهلا","وَأسلُكُ نَهجَهُ مَيتاً وَحَيّا",25,"ي",2,0],["الأزبكيَّةُ جنَّةُ ال","فردَوسِ قل لي أم حَديقَه",26,"ه",1,1],["ألا زارت سُحيراً وهي سَكرى","وقد كادت عيونُ اللّيلِ تكرىَ",27,"ر",2,1],["الأَزهَر الوَجهِ مَنْ أَنوارُ غُرَّتِهِ","تَجلو البُدورَ بِها الدّيجور والغَسَما",28,"م",2,0],["الأَزهَر الوَجهِ بادي البِشرِ مُبتَسِماً","فَطابَ صيتاً يَفوقُ المِسكَ وَالنَّدَّا",29,"د",2,0],["أَلا زارَتكَ في جُنحِ الظَّلامِ","وقَد شُغِلَ الحَواسِدُ بِالمَنامِ",30,"م",1,1],["الأزهري الذي عز الزمان به","وأبدلت ظلمات الجهل عرفانا",31,"ن",2,0],["إِلا زَمان صدقه","ذي الهمم الموفقه",32,"ه",1,1],["ألا زعم الواشون أنك عاشِقُ","حَديثٌ لعَمر العامريّة صَادقُ",33,"ق",1,1],["أَلا زَعَموا اني ملَلْتُ ومَلَّتِ","واْبلَلْتُ من داءِ الجَوى وابلَّتِ",34,"ت",1,1],["الأزهر الغطريف نجلُ الأزهر ال","غطريفِ نجل الأزهر الغطريف",35,"ف",1,0],["أَلاَ زُمي الركائب واصحبيني","لنسكن حيث عيشُ المرء طابا",36,"ب",2,0],["الا زُر مسُّوقاً قد اضرَّ بهِ الظما","لريقكَ وانعم بعد سخطك بالرضا",37,"ض",2,0],["ألا زوديني منك آخر نظرة","تركت بها أهل الغرام عبيدا",38,"د",2,1],["الأَزدُ قَومي وَهُم إِذا نزلت","بالناسِ هيجاءُ في عُرى الكُربِ",39,"ب",1,1],["ألازم السهد طول الليل في أرقٍ","حتى أرى الصبح يحييني تدانيه",40,"ي",2,0],["أَلا زارَ مِن أُمِّ الخُشَيفِ خَيالُها","وَمِن دُونِها البَيدآءُ يَخفُقُ آلُها",41,"ل",3,1],["ألا زك الجمال لنا بوصل","فإن الحسن قد بلغ النصابا",42,"ب",2,0],["ألا زارتك سافرة لثاما","مكارم قد صبوت لها غلاما",43,"م",2,1],["أَلا زَعَمَت عَفراءُ بِالشامِ أَنَّني","غُلامُ جَوارٍ لا غُلامُ حُروبُ",44,"ب",1,1],["الأزهر المعمور بعدك دارس","صفر من العقلاء والحكماء",45,"ا",2,0],["إلا زعيق ونفض كم","ولا ولم لا ولا نسلم",46,"م",1,0],["الأزاهير في الشجَرْ","لا اختلاف ولا صُوَرْ",47,"ر",1,1],["الأزرق الساحر بالصفاء","تجربةٌ في البحر والسماء",48,"ا",2,1],["ألا زَعمتْ أبناءُ يَشْكُرَ أننا","بِربْعِهم باءوا هنالِك ناضِلُ",49,"ل",1,1],["ألا زادَ أعداءً وعقَّ ابن حاتِمٍ","أباهُ وأمسى بالفريقين ناكِسا",50,"س",2,0],["آل ازبير خيار الناس قد علموا","وأنت فيهم سنام المجد والحسب",51,"ب",1,0],["ألاَ زحزحُوا بالسيفِ من كان جائِراً","ألا بكِّتُوا رؤوسَ النفاق وقَطِّعُوا",52,"ع",3,0],["الأزهرى بن عبدالله ذا عمر","الصاردى فعامله باحسان",53,"ن",1,1],["الأزهرى الصادرى عمر الذى","زانت بمدحك فى الورى أوزانه",53,"ه",1,0],["آل أزكى مرسل كم شُيدت","في المعالي لهم من قبب",54,"ب",1,0],["ألا زاحموا أهل العلى بالمناكب","ولا تقعدوا من بعد نيل المراتب",55,"ب",1,1],["إلا زَكِيُّ القَلبِ ذَلكَ طَاهِرٌ","حَبرٌ تَقِيٌّ ألمَعِيٌّ فَاضِلُ",56,"ل",1,0],["أَلا زعمت أَبناء يشكر اننا","بربعهم باؤا هنالك ناضل",57,"ل",1,1],["الآزهريون الغداة تفيئوا","لله نعمته التي لا تكفر",58,"ر",1,0],["الأزهر الزهى له منن","عظمت وهذي دونها المنن",59,"ن",1,0],["ألا زد مدنفاً ألماً","وأحرز في الجوى السبقا",60,"ق",2,0]]}