"https://www.aldiwan.net/poem3476.html","عموديه"],[466,"رمتني بنجل والسهام جفون","https://www.aldiwan.net/poem3591.html","عموديه"],[470,"وستر له منظر مونق","https://www.aldiwan.net/poem59805.html","المتقارب"],[479,"أقفر من سكانه المعهد","https://www.aldiwan.net/poem15224.html","السريع"],[479,"كفى حزنا أني أبثك ما عندي","https://www.aldiwan.net/poem15281.html","الطويل"],[495,"صفحت لهذا الدهر عن سيئاته","https://www.aldiwan.net/poem67407.html","الطويل"],[502,"لا تشوش لك سرا","https://www.aldiwan.net/poem37924.html","مجزوء الرمل"],[507,"البديل","https://www.aldiwan.net/poem56766.html","مخلع البسيط"],[507,"الحساب","https://www.aldiwan.net/poem56767.html","الطويل"],[517,"يا أحسن الناس وجهاً","https://www.aldiwan.net/poem12067.html","المجتث"],[526,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[550,"بكى صُرد لما رأى الحي أعرضت","https://www.aldiwan.net/poem1171.html",""],[553,"فجعة ما احتسبتها في زماني","https://www.aldiwan.net/poem47168.html","الخفيف"],[553,"ألا عوجا لمجتمع السيال","https://www.aldiwan.net/poem47286.html","البسيط"],[560,"أنا في الملاح على اليقين","https://www.aldiwan.net/poem33819.html","مجزوء الكامل"],[577,"أيا دمع عيني لا تكن بعد إخواني","https://www.aldiwan.net/poem2776.html","الطويل"],[629,"","https://poetry.dctabudhabi.ae/diwan/poem/132056","الطويل"],[958,"","https://poetry.dctabudhabi.ae/diwan/poem/22535","الوافر"],[1050,"","https://poetry.dctabudhabi.ae/diwan/poem/200314","الوافر"]],"verses":[["وَخوصٍ قَد سَرَيتُ بِهِنَّ حَتّى","تَقَوَّضَتِ النُجومُ إِلى الغُيوبِ",0,"ب",1,0],["وخَوْضي إلَيْكِ اللّيلَ أرْكَبُ هَوْلَهُ","وإنْ بَعُدَ المَسْرى فلَسْتُ أبالي",1,"ل",2,0],["وخَوّلني ما ضاقَ ذَرْعُ المُنى بهِ","منَ البِشْرِ في أثناءِ نائِلهِ الغَمْرِ",2,"ر",1,0],["وَخَوَّلَنِي الْفَضَلَ الَّذِي هُوَ أَهْلُهُ","وَشِيكاً وَأَعْطَانِي فَأَفْعَمَ أَعْطَانِي",3,"ن",2,0],["وَخَوَّفُوا النَّاسَ مِنْ دَهْيَاءَ دَاهِيَةٍ","إِذَا بَدَا الْكَوْكَبُ الْغَربِيِّ ذُو الذَّنَبِ",4,"ب",1,0],["وَخَوَت جِربَةُ النُجومِ فَما تَش","رَبُ أُروِيَّةٌ بِمَريِ الجَنوبِ",5,"ب",1,0],["وَخُوصٍ خَوامِسٍ أَورَدتُها","قُبَيلَ الكَوَاكِبِ وِردًا مُلاثا",6,"ث",2,0],["وَخوداً إِذا ما الشاةُ لاذَ مِنَ اللَظى","بِعُبرِيَّةٍ أَو ضالَةٍ لا يَريمُها",7,"م",3,0],["وَخَوصاءَ قَد كَلَّفتُها الهَمَّ دونَهُ","مِنَ البُعدِ شَهراً لِلمَراسيلِ مُجذِمُ",8,"م",1,0],["وَخَوصاءَ قَد نَفَّرتُ عَن كورِها الكَرى","بِذِكراكِ وَالأَعناقُ ميلٌ قِلالُها",9,"ل",3,0],["وَخورُ مُجاشِعٍ تَرَكوا لَقيطاً","وَقالوا حِنوَ عَينِكَ وَالغُرابَ",10,"ب",1,0],["وَخوصٍ قَد قَرَنتُ بِهِنَّ خوصاً","تَجافى الغَيثُ عَنها وَالخُضورُ",11,"ر",1,0],["وَخَوَّدَ فَحلُها مِن غَيرِ شَلٍّ","بِدارَ الريحِ تَخويدَ الظَليمِ",12,"م",1,0],["وَخوصٍ دِقاقٍ قَد حَدَوتُ لِفِتيَةٍ","عَلَيهِنَّ إِحداهُنَّ قَد حَلَّ كورُها",13,"ر",3,0],["وخوفي بالظن إلاَّ ائتلا","ف أو يتناسى الأزبّ النفورا",14,"ر",2,0],["وَخَوَّضَها بَطنَ السَلَوطَحِ رَيثَما","أُديرَت بِمِلحانَ الشُهورُ الدَوائِرُ",15,"ر",1,0],["وخِوَاني مُلَكَّكُ وقِصَاعي","وَبرامي فكلُّها مَشْعُوبُ",16,"ب",1,0],["وخولك الصهيل وكان منه","كثيراً أن يسمِّعك النهاقا",17,"ق",2,0],["وخوفُه العَتْبَ منكَ يُفْرِشُهُ","جمر الغضا ليلَهُ أو الحَسَكا",18,"ك",2,0],["وَخِوانٌ يَعبَقُ المِس","كُ بِرَيّاهُ وَطَعمُه",19,"م",2,0],["وَخودٌ مِنَ اللائي يُسَمَّعنَ بِالضُحى","قَريضَ الرُدافى بِالغِناءِ المُهَوَّدِ",20,"د",1,0],["وخَوْضُ لَيْلٍ تَهابُ الجِنُّ لُجّتَهُ","ويَنْطَويْ جَيْشُها عن جَيْشِه اللّجِبِ",21,"ب",1,0],["وَخَوفُ كُلِّ رَفيقٍ","أَباتَكَ اللَيلُ جَنبَه",22,"ب",2,0],["وَخَوضِهِ غَمرَ كُلِّ مَهلَكَةِ","لِلذِمرِ فيها فُؤادُ رِعديدِ",23,"د",1,0],["وَخُؤولَةٌ في هاشِمٍ وَدَّ العِدى","أَن لَم تَكُن وَلَهُم بِها ما شاؤوا",24,"ا",1,0],["وَخُؤولَتي فَالحَوفَزانُ وَحاتِمٌ","وَالخالِدانِ الرافِدانِ حُماتي",25,"ت",2,0],["وَخُؤولَةٌ مِن عَمرِهِ وَيَزيدِهِ","وَوَليدِهِ وَسَعيدِهِ وَهِشامِهِ",26,"م",2,0],["وَخَوقاءِ أَرضٍ مِن بَعيدٍ رَمَت بِنا","إِلَيكَ مَعَ الصُهبِ المَهاري سُهوبُها",27,"ب",3,0],["وخَوضُ دمٍ إذا جفَّت أعالي","قَوائِمها أتاحَ لها بَلالا",28,"ل",2,0],["وَخوطِيَّةٍ شَمسِيَّةٍ رَشَئِيَّةٍ","مُهَفهَفَةِ الأَعلى رَداحِ المُحَقَّبِ",29,"ب",1,0],["وَخَوَّفوا الناسَ مِن دَهياءَ مُظلِمَةٍ","إِذا بَدا الكَوكَبُ الغَربِيُّ ذو الذَنَبِ",30,"ب",1,0],["وخُوضوا الحربَ بالأَهوالِ تَرْمِي","كَفَى ما امْتدَّ من دَعَةٍ وسِلْمِ",31,"م",1,0],["وَخَوِيِّ سَهلٍ يُثيرُ بِهِ القَو","مُ رِباضاً لِلعَينِ بَعدَ رِباضِ",32,"ض",1,0],["وخوَّلَني ما بينَ مَجدٍ إلى لُهىً","وأورثَني ما بينَ عُقْرٍ إلى عُقْرِ",33,"ر",1,0],["وَخَوضَهُ في نَفَيانِ الوَغى","عَلى طُموحِ الطَرفِ هَرّاجِ",34,"ج",1,0],["وخوْفُ الرّدى آوَى إلى الكَهفِ أهلَهُ","وكَلّفَ نوحاً وابنَهُ عَمَلَ السّفنِ",35,"ن",1,0],["وخَوْقَاءَ جَرْدَاءِ المَسَارِحِ هَوْجَلٍ","بِهَا لاِسْتِدَاءِ الشّعْشَعَانَاتِ مَسْبَحُ",36,"ح",1,0],["وخَوْدٍ خَرُودِ السُّرَى طَفْلَةٍ","تَنَقَّذْتُ مِنْهَا حَدِيثاً حَلاَلاَ",37,"ل",2,0],["وخوف المودّع غيب النوى","وسهد المنى في انتظار الإياب",38,"ب",1,0],["وخوت زرائبكم وكان على","جنباتهايتدفق اللبن",39,"ن",1,0],["وَخوَّفوها ب \" دُبٍ \" سوف ياكلُها","في حين \" تسعون عاما \" تألفُ السَبُعا",40,"ع",2,0],["وَخُؤولَةٌ في هاشِمٍ ودَّ العِدَى","أنْ لمْ تَكُنْ، وَلهُمْ بِهَا ما شاءوا",41,"ا",1,0],["وخوفُه العَتْبَ منكَ يُفْرِشُهُ","جرر الغضا ليله أو الحَسَكَا",42,"ك",2,0],["وخوافي اسرار غيب لقد غزت","بعين الجحود شوك القتاد",43,"د",1,0],["وخوافي الأسرار تنزل بالأق","دار من دار دورة الأقدار",44,"ر",1,0],["وخُودٍ رَاقَ مِنهَا مَا تَرَاهُ","تَرَدَّدُ في مَحَاسِنِهَا المَهَاهُ",45,"ا",2,1],["وَخَوَّفوا الناسَ فَاِرتاعَت مُلوكُهُمُ","تَرَوُّعَ السِربِ لَمّا عارَضَ السَرِبا",46,"ب",2,0],["وَخَوفُ حُذَيفَةَ عَمّى عَلَي","هِ بِالجَفرِ ما لَم يَغِب عَن حَمَل",47,"ل",1,0],["وَخَوَّلَهُ مَعَ التَقريبِ نَعتاً","لِيَرفَعَ ذِكرُهُ اللَقَبَ الأَجَلّا",48,"ل",2,0],["وخوفت من خوفت من شوم كفره","فما استشعروا خوفاً ولا استمعوا نهيا",49,"ا",1,0],["وخوَّفني ماءٌ منَ العينِ نازلٌ","عمىً هو من ماءٍ إلى العينِ نازِلِ",50,"ل",1,0],["وخَوفني فارتَحت جذلانَ آمِناً","وبِتُّ رخيَّ البالِ مُلتئمَ الشِّعب",51,"ب",1,0],["وَخَوفاً مِنَ الأَمرِ الَّذي يَشعَبُ العَصا","وَمَن خَذَل المَولى لَهُ كانَ أَخذَلا",52,"ل",2,0],["وَخُوضُوا لَظاها بِاِقتِحامٍ فَإِنَّما","يُكَشِّفُ غَمّاءَ الحُروبِ اِقتِحامُها",53,"م",3,0],["وَخُوطٍ مِن فُرُوعِ النَّبعِ ضاحِى","لَها فِى كَفِّ أَعسَرَ كالضُّباحِ",54,"ح",1,1],["وخوفِ مايلقاهُ من ربِّه","في آخر الأمرِ إذا ما حُشِر",55,"ر",1,0],["وخوفِه من ملكٍ غادرٍ","إذا رأى الفرصةَ فيه غدر",55,"ر",1,0],["وخوف دواهيها ومكر حماتها","وسطوة أهليها وهمّ سعاتها",56,"ت",3,0],["وخودٍ ضمَّ مئزرُها كثيباً","يهالَ وبُرْدُها غُصْناً يراحَ",57,"ح",1,1],["وخود في تثنيها","باغصان النقا تزري",58,"ر",2,0],["وخوض الوغَى للموت في كل مأْقِطٍ","بهيمٍ يَخاف الذعرُ فيه من الذّعر",59,"ر",1,0],["وخُوْنُ عهِدك عندي","أشدّ من كل كفرِ",60,"ر",1,0],["وخوفي على المجد الأثيل أضاعني","بأرض بها أم الوفاء هبيل",61,"ل",1,0],["وَخَوَّلَنِي رُعْياً بِها وَكلاءةً","فَخَوَّلَهُ اللَّهُ الكَفاءةَ وَالرَّعْيَا",62,"ي",2,0],["وَخَوَّلَهُ الرِّضَى ما لَمْ يَخَلْهُ","وَكَمْ نَطِفٍ لهُ فَلَجُ البَرِيِّ",63,"ي",1,0],["وخولوا رتباً أضحت تميزهم","وبالمجيدي تحلوا والحديث جرى",64,"ر",2,0],["وَخودٍ تُحاولُ وَصلي وَقَد","أَضاعَت حُقوقي وَمَلَّت جنابي",65,"ي",1,1],["وخوف ونعم الخوف للعبد سائق","ونعم الرجا من قائد للسعادة",66,"ه",1,0],["وخولة عن لبنى ولبنى تجيب عن","سعاد وعن سعدى وحفصةُ عن سلمى",67,"م",2,0],["وخَوَّفني تَصاريفَ اللّيالي","فقلتُ اللهُ حَسْبي والصَّفيّ",68,"ي",1,0],["وخوفاً على أعُينِ النّاظري","نَ نوراً لسائرِها ما أتَمّ",69,"م",1,0],["وخُوزسْتانُ أَوْلَى أن تُهنّا","بمَدِّكمُ عليها لكمْ ظِلالا",70,"ل",2,0],["وخُوّانُ إخوانٍ وحاشا كِرامَهمْ","وهمْ حُضّرٌ أَلْباً مَع الدّهرِ حُشَّد",71,"د",1,0],["وخُوصٍ طَويْنَ البِيدَ وهْي طلائحٌ","تَرامَى بها أغوارُها ونُجودها",72,"د",3,0],["وخوّاضةٍ ماءَ الرِّقابِ من العِدا","لها صَدرٌ ما ينْقَضِي وورُود",73,"د",1,0],["وخواطراً مَرحَتْ إليك صبابةً","وجوانحاً مُلئتْ عليك نُدوبا",74,"ب",2,0],["وخوفَ فراق النّجم قد صار سُحْرةً","لناصية اللّيل البهيم مشيب",75,"ب",1,0],["وَخَواطِرٍ عُدنا بِها يَوماً فَما","عُدنا بِها جَفنَ الحَبيبِ المُدنَفا",76,"ف",2,0],["وَخَوَّفَني مِنَ الأَوزارِ فيهِ","وَمَن لِمُحِبِّهِ لَو نالَ وِزرَه",77,"ر",2,0],["وَخَوالِفُ الأَولادِ تَر","بو في المَزايِلِ لا الحُجورِ",78,"ر",1,0],["وخَودٍ أتَى الفكرُ الصَّحيحُ يزفُّها","لها ذكرُكَ المَشهورُ بينَ الوَرى عِطرُ",79,"ر",1,0],["وخوض الناس في الأفعال شيء","تنزه عنه أرباب الحجال",80,"ل",1,0],["وَخوَّلَكِ النِفارُ وأي ريمٍ","يُرى أَبَداً وَلَيسَ لَهُ نِفارُ",81,"ر",1,0],["وَخَوَّلَهم ما يُنبَتونَ بِهِ العُلى","ويَغنَون ما تبقى عَليهم مآثِرُهُ",82,"ر",2,0],["وخود سبتنا باللحاظ فلم تدع","لناظر جفنيها فواداً بلا سحر",83,"ر",1,0],["وخواطرُ الإِنسانِ ما خَطَرَتْ ففي اس","تعلائِهِ يَمْضِي أَو اسْتِحْطَاطِهِ",84,"ط",2,0],["وخَوَّلَ فَأْلُهُمْ بِكَ فَانْتَحاهمْ","بِهِ أُكُلٌ وظِلٌّ واجْتِنَاءُ",85,"ا",2,0],["وخَوافِقٍ حَفَّتْ بوجهِكَ فاحْتَذَتْ","شَمْسَ النهارِ تَجَلَّلَتْ بسحابِ",86,"ب",1,0],["وخوفك عندي أنت دارٍ بحاله","ولو لم أقل خوف الجزا واقفٌ عندي",87,"د",2,0],["وخَوْدٍ ردحٍ ريشَ سَهْمُ لحاظها","بهدب جفون للصوارم أغمد",88,"د",1,1],["وخَوَّلوا من نِعمةٍ واغتنموا","جُلَّ السماح عن يمين غارمِ",89,"م",1,0],["وخُوِّل أعناقَ المطيّ فَساقَها","وراءَ التي يسمو بها ويصولُ",90,"ل",1,0],["وخودع عن خُلْقه في العقوق","وما خلتُها شيمةً تُنقَلُ",91,"ل",1,0],["وخوَّانينَ منفردين عنّي","فما نقصَ الوحيدُ عن الجميعِ",92,"ع",1,0],["وخوضي للأهوال غير محاذرٍ","أعاصي مرادي ثمَّ ألقاكَ طَيِّعاَ",93,"ع",2,0],["وخوْفُ اتِّهامِ الظَّنِّ أنيِّ مادحٌ","لرِفْدٍ وأني للمطامعِ ساهرُ",94,"ر",1,0],["وخوضي غِمار الموت فيكمْ مُقَحِّماً","وقد رهِبتْ أولى طلائعه الأُسْدُ",95,"د",1,0],["وخواطر مثل البحار خطوطه","أبداً تكنُّ الدرّ في ظلماتها",96,"ت",3,0],["وخودُ الغيد تدمى خجلاً","والرُّبى تبهر زنداً وبهارا",97,"ر",2,0],["وخوّفتماني غارةً عامريّةً","يخفُّ بها الغيران وهو رصين",98,"ن",1,0],["وَخوذَةٌ هَذا لَها بَهجَةٌ","وَجَوشَنُ هَذا لَهُ رَونَقُ",99,"ق",1,0],["وخَوضي بحرَ كلَّ سرابِ قفرٍ","عليها واعتسافي كلَّ بيدِ",100,"د",1,0],["وخوصُ النياقِ الواخداتِ بواركٌ","لوشكِ النوى مابينَ حَلِّ إلى شَدِّ",101,"د",1,0],["وخوفني منه فخلت صليبه","لشدة ما يخشاه بعض وشاته",102,"ت",2,0],["وخَؤونٍ وأمينٍ","ومُعادٍ ومُخالِلْ",103,"ل",1,0],["وخوْفُ من ساءَنِي أكيدُ","وظنُّه فيّ لا يخيبُ",104,"ب",1,0],["وخوفٌ يداهمُ الرّجاءَ مُزلزلِا","أربّاً عبدْتَ أمْ عبَدْتَ رُبوبا؟",105,"ب",2