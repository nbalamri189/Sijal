bi.ae/diwan/poem/59485","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135865","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135457","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111505","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69902","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77115","الرجز"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105133","الرجز"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81734","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81694","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58154","الطويل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136440",""],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/201301","المتقارب"],[4657,"","https://poetry.dctabudhabi.ae/diwan/poem/140148",""],[4657,"","https://poetry.dctabudhabi.ae/diwan/poem/140149",""],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204235","البسيط"],[4717,"كفرتُ بأمنها القومي","https://www.poetsgate.com/ViewPoem.aspx?id=199698",""],[4727,"ذكرتك والأقوام رقد","https://www.poetsgate.com/ViewPoem.aspx?id=214426",""],[4797,"طيبك يابوخالد هماليل وبروق","https://www.poetsgate.com/ViewPoem.aspx?id=132242",""],[4926,"تحيّات إجلال عن الحصر جلَّت","https://www.poetsgate.com/ViewPoem.aspx?id=171107",""],[4119,"هي جنة المأوى فهل من خاطب","https://www.poetsgate.com/ViewPoem.aspx?id=16089",""],[5061,"الخوه الخوه","https://www.poetsgate.com/ViewPoem.aspx?id=153974",""],[1372,"ألم تَرَ مُذْ عامينِ أملاكَ عصرِنا","https://www.poetsgate.com/ViewPoem.aspx?id=15769",""],[5183,"فخري","https://www.poetsgate.com/ViewPoem.aspx?id=186477",""],[5183,"من مُلح الرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=180281",""],[5186,"ليت شعري أي المصائب أشكو","https://www.poetsgate.com/ViewPoem.aspx?id=156468",""],[5199,"قبيلة (بنى رشيد) عبس","https://www.poetsgate.com/ViewPoem.aspx?id=146780",""],[5277,"بقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=200588",""],[5304,"الخيل والصحراء","https://www.poetsgate.com/ViewPoem.aspx?id=155914",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[5397,"أهل بسط كف تحجب الشمس والبدرا","https://www.poetsgate.com/ViewPoem.aspx?id=157931",""],[5431,"طوفان عروبي...","https://www.poetsgate.com/ViewPoem.aspx?id=215568",""],[5452,"صدام","https://www.poetsgate.com/ViewPoem.aspx?id=119185",""],[5476,"وَاسْتَقَالَ الْمَلَّاحُ","https://www.poetsgate.com/ViewPoem.aspx?id=194683",""],[3912,"كفى حَزَنًا بالهائم الصبِّ أن يرى","https://www.poetsgate.com/ViewPoem.aspx?id=136749",""],[5493,"دربُ الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=208780",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5582,"أَلا هَلْ تَوَلَّتْ نَوارٌ نَوارا","https://www.poetsgate.com/ViewPoem.aspx?id=186999",""],[5582,"أَبَدْرٌ فِي الكَنِيسَةِ أَمْ بَراحُ","https://www.poetsgate.com/ViewPoem.aspx?id=186831",""],[469,"أعاذلتي كُفّي ثكلتِ عن العذلِ","https://www.poetsgate.com/ViewPoem.aspx?id=76855",""],[5939,"أنا جدّا عليكِ أغار","https://www.poetsgate.com/ViewPoem.aspx?id=178598",""],[6069,"سرى موهناً واستكتمته المهالك","https://www.poetsgate.com/ViewPoem.aspx?id=105697",""],[6074,"صرت من حبس دنا مطلقا","https://www.poetsgate.com/ViewPoem.aspx?id=200375",""],[6102,"غيبوبة","https://www.poetsgate.com/ViewPoem.aspx?id=184544",""],[6115,"يازين جلسه على دله وبرادي","https://www.poetsgate.com/ViewPoem.aspx?id=180529",""],[6124,"حتى ألاقيك","https://www.poetsgate.com/ViewPoem.aspx?id=201231",""],[520,"يا اكرم الناس وجها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577477",""],[5377,"رثاء شعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79547&r=&rc=1",""]],"verses":[["وَخوصٍ قَد سَرَيتُ بِهِنَّ حَتّى","تَقَوَّضَتِ النُجومُ إِلى الغُيوبِ",0,"ب",1,0],["وخَوْضي إلَيْكِ اللّيلَ أرْكَبُ هَوْلَهُ","وإنْ بَعُدَ المَسْرى فلَسْتُ أبالي",1,"ل",2,0],["وخَوّلني ما ضاقَ ذَرْعُ المُنى بهِ","منَ البِشْرِ في أثناءِ نائِلهِ الغَمْرِ",2,"ر",1,0],["وَخَوَّلَنِي الْفَضَلَ الَّذِي هُوَ أَهْلُهُ","وَشِيكاً وَأَعْطَانِي فَأَفْعَمَ أَعْطَانِي",3,"ن",2,0],["وَخَوَّفُوا النَّاسَ مِنْ دَهْيَاءَ دَاهِيَةٍ","إِذَا بَدَا الْكَوْكَبُ الْغَربِيِّ ذُو الذَّنَبِ",4,"ب",1,0],["وَخَوَت جِربَةُ النُجومِ فَما تَش","رَبُ أُروِيَّةٌ بِمَريِ الجَنوبِ",5,"ب",1,0],["وَخُوصٍ خَوامِسٍ أَورَدتُها","قُبَيلَ الكَوَاكِبِ وِردًا مُلاثا",6,"ث",2,0],["وَخوداً إِذا ما الشاةُ لاذَ مِنَ اللَظى","بِعُبرِيَّةٍ أَو ضالَةٍ لا يَريمُها",7,"م",3,0],["وَخَوصاءَ قَد كَلَّفتُها الهَمَّ دونَهُ","مِنَ البُعدِ شَهراً لِلمَراسيلِ مُجذِمُ",8,"م",1,0],["وَخَوصاءَ قَد نَفَّرتُ عَن كورِها الكَرى","بِذِكراكِ وَالأَعناقُ ميلٌ قِلالُها",9,"ل",3,0],["وَخورُ مُجاشِعٍ تَرَكوا لَقيطاً","وَقالوا حِنوَ عَينِكَ وَالغُرابَ",10,"ب",1,0],["وَخوصٍ قَد قَرَنتُ بِهِنَّ خوصاً","تَجافى الغَيثُ عَنها وَالخُضورُ",11,"ر",1,0],["وَخَوَّدَ فَحلُها مِن غَيرِ شَلٍّ","بِدارَ الريحِ تَخويدَ الظَليمِ",12,"م",1,0],["وَخوصٍ دِقاقٍ قَد حَدَوتُ لِفِتيَةٍ","عَلَيهِنَّ إِحداهُنَّ قَد حَلَّ كورُها",13,"ر",3,0],["وخوفي بالظن إلاَّ ائتلا","ف أو يتناسى الأزبّ النفورا",14,"ر",2,0],["وَخَوَّضَها بَطنَ السَلَوطَحِ رَيثَما","أُديرَت بِمِلحانَ الشُهورُ الدَوائِرُ",15,"ر",1,0],["وخِوَاني مُلَكَّكُ وقِصَاعي","وَبرامي فكلُّها مَشْعُوبُ",16,"ب",1,0],["وخولك الصهيل وكان منه","كثيراً أن يسمِّعك النهاقا",17,"ق",2,0],["وخوفُه العَتْبَ منكَ يُفْرِشُهُ","جمر الغضا ليلَهُ أو الحَسَكا",18,"ك",2,0],["وَخِوانٌ يَعبَقُ المِس","كُ بِرَيّاهُ وَطَعمُه",19,"م",2,0],["وَخودٌ مِنَ اللائي يُسَمَّعنَ بِالضُحى","قَريضَ الرُدافى بِالغِناءِ المُهَوَّدِ",20,"د",1,0],["وخَوْضُ لَيْلٍ تَهابُ الجِنُّ لُجّتَهُ","ويَنْطَويْ جَيْشُها عن جَيْشِه اللّجِبِ",21,"ب",1,0],["وَخَوفُ كُلِّ رَفيقٍ","أَباتَكَ اللَيلُ جَنبَه",22,"ب",2,0],["وَخَوضِهِ غَمرَ كُلِّ مَهلَكَةِ","لِلذِمرِ فيها فُؤادُ رِعديدِ",23,"د",1,0],["وَخُؤولَةٌ في هاشِمٍ وَدَّ العِدى","أَن لَم تَكُن وَلَهُم بِها ما شاؤوا",24,"ا",1,0],["وَخُؤولَتي فَالحَوفَزانُ وَحاتِمٌ","وَالخالِدانِ الرافِدانِ حُماتي",25,"ت",2,0],["وَخُؤولَةٌ مِن عَمرِهِ وَيَزيدِهِ","وَوَليدِهِ وَسَعيدِهِ وَهِشامِهِ",26,"م",2,0],["وَخَوقاءِ أَرضٍ مِن بَعيدٍ رَمَت بِنا","إِلَيكَ مَعَ الصُهبِ المَهاري سُهوبُها",27,"ب",3,0],["وخَوضُ دمٍ إذا جفَّت أعالي","قَوائِمها أتاحَ لها بَلالا",28,"ل",2,0],["وَخوطِيَّةٍ شَمسِيَّةٍ رَشَئِيَّةٍ","مُهَفهَفَةِ الأَعلى رَداحِ المُحَقَّبِ",29,"ب",1,0],["وَخَوَّفوا الناسَ مِن دَهياءَ مُظلِمَةٍ","إِذا بَدا الكَوكَبُ الغَربِيُّ ذو الذَنَبِ",30,"ب",1,0],["وخُوضوا الحربَ بالأَهوالِ تَرْمِي","كَفَى ما امْتدَّ من دَعَةٍ وسِلْمِ",31,"م",1,0],["وَخَوِيِّ سَهلٍ يُثيرُ بِهِ القَو","مُ رِباضاً لِلعَينِ بَعدَ رِباضِ",32,"ض",1,0],["وخوَّلَني ما بينَ مَجدٍ إلى لُهىً","وأورثَني ما بينَ عُقْرٍ إلى عُقْرِ",33,"ر",1,0],["وَخَوضَهُ في نَفَيانِ الوَغى","عَلى طُموحِ الطَرفِ هَرّاجِ",34,"ج",1,0],["وخوْفُ الرّدى آوَى إلى الكَهفِ أهلَهُ","وكَلّفَ نوحاً وابنَهُ عَمَلَ السّفنِ",35,"ن",1,0],["وخَوْقَاءَ جَرْدَاءِ المَسَارِحِ هَوْجَلٍ","بِهَا لاِسْتِدَاءِ الشّعْشَعَانَاتِ مَسْبَحُ",36,"ح",1,0],["وخَوْدٍ خَرُودِ السُّرَى طَفْلَةٍ","تَنَقَّذْتُ مِنْهَا حَدِيثاً حَلاَلاَ",37,"ل",2,0],["وخوف المودّع غيب النوى","وسهد المنى في انتظار الإياب",38,"ب",1,0],["وخوت زرائبكم وكان على","جنباتهايتدفق اللبن",39,"ن",1,0],["وَخوَّفوها ب \" دُبٍ \" سوف ياكلُها","في حين \" تسعون عاما \" تألفُ السَبُعا",40,"ع",2,0],["وَخُؤولَةٌ في هاشِمٍ ودَّ العِدَى","أنْ لمْ تَكُنْ، وَلهُمْ بِهَا ما شاءوا",41,"ا",1,0],["وخوفُه العَتْبَ منكَ يُفْرِشُهُ","جرر الغضا ليله أو الحَسَكَا",42,"ك",2,0],["وخوافي اسرار غيب لقد غزت","بعين الجحود شوك القتاد",43,"د",1,0],["وخوافي الأسرار تنزل بالأق","دار من دار دورة الأقدار",44,"ر",1,0],["وخُودٍ رَاقَ مِنهَا مَا تَرَاهُ","تَرَدَّدُ في مَحَاسِنِهَا المَهَاهُ",45,"ا",2,1],["وَخَوَّفوا الناسَ فَاِرتاعَت مُلوكُهُمُ","تَرَوُّعَ السِربِ لَمّا عارَضَ السَرِبا",46,"ب",2,0],["وَخَوفُ حُذَيفَةَ عَمّى عَلَي","هِ بِالجَفرِ ما لَم يَغِب عَن حَمَل",47,"ل",1,0],["وَخَوَّلَهُ مَعَ التَقريبِ نَعتاً","لِيَرفَعَ ذِكرُهُ اللَقَبَ الأَجَلّا",48,"ل",2,0],["وخوفت من خوفت من شوم كفره","فما استشعروا خوفاً ولا استمعوا نهيا",49,"ا",1,0],["وخوَّفني ماءٌ منَ العينِ نازلٌ","عمىً هو من ماءٍ إلى العينِ نازِلِ",50,"ل",1,0],["وخَوفني فارتَحت جذلانَ آمِناً","وبِتُّ رخيَّ البالِ مُلتئمَ الشِّعب",51,"ب",1,0],["وَخَوفاً مِنَ الأَمرِ الَّذي يَشعَبُ العَصا","وَمَن خَذَل المَولى لَهُ كانَ أَخذَلا",52,"ل",2,0],["وَخُوضُوا لَظاها بِاِقتِحامٍ فَإِنَّما","يُكَشِّفُ غَمّاءَ الحُروبِ اِقتِحامُها",53,"م",3,0],["وَخُوطٍ مِن فُرُوعِ النَّبعِ ضاحِى","لَها فِى كَفِّ أَعسَرَ كالضُّباحِ",54,"ح",1,1],["وخوفِ مايلقاهُ من ربِّه","في آخر الأمرِ إذا ما حُشِر",55,"ر",1,0],["وخوفِه من ملكٍ غادرٍ","إذا رأى الفرصةَ فيه غدر",55,"ر",1,0],["وخوف دواهيها ومكر حماتها","وسطوة أهليها وهمّ سعاتها",56,"ت",3,0],["وخودٍ ضمَّ مئزرُها كثيباً","يهالَ وبُرْدُها غُصْناً يراحَ",57,"ح",1,1],["وخود في تثنيها","باغصان النقا تزري",58,"ر",2,0],["وخوض الوغَى للموت في كل مأْقِطٍ","بهيمٍ يَخاف الذعرُ فيه من الذّعر",59,"ر",1,0],["وخُوْنُ عهِدك عندي","أشدّ من كل كفرِ",60,"ر",1,0],["وخوفي على المجد الأثيل أضاعني","بأرض بها أم الوفاء هبيل",61,"ل",1,0],["وَخَوَّلَنِي رُعْياً بِها وَكلاءةً","فَخَوَّلَهُ اللَّهُ الكَفاءةَ وَالرَّعْيَا",62,"ي",2,0],["وَخَوَّلَهُ الرِّضَى ما لَمْ يَخَلْهُ","وَكَمْ نَطِفٍ لهُ فَلَجُ البَرِيِّ",63,"ي",1,0],["وخولوا رتباً أضحت تميزهم","وبالمجيدي تحلوا والحديث جرى",64,"ر",2,0],["وَخودٍ تُحاولُ وَصلي وَقَد","أَضاعَت حُقوقي وَمَلَّت جنابي",65,"ي",1,1],["وخوف ونعم الخوف للعبد سائق","ونعم الرجا من قائد للسعادة",66,"ه",1,0],["وخولة عن لبنى ولبنى تجيب عن","سعاد وعن سعدى وحفصةُ عن سلمى",67,"م",2,0],["وخَوَّفني تَصاريفَ اللّيالي","فقلتُ اللهُ حَسْبي والصَّفيّ",68,"ي",1,0],["وخوفاً على أعُينِ النّاظري","نَ نوراً لسائرِها ما أتَمّ",69,"م",1,0],["وخُوزسْتانُ أَوْلَى أن تُهنّا","بمَدِّكمُ عليها لكمْ ظِلالا",70,"ل",2,0],["وخُوّانُ إخوانٍ وحاشا كِرامَهمْ","وهمْ حُضّرٌ أَلْباً مَع الدّهرِ حُشَّد",71,"د",1,0],["وخُوصٍ طَويْنَ البِيدَ وهْي طلائحٌ","تَرامَى بها أغوارُها ونُجودها",72,"د",3,0],["وخوّاضةٍ ماءَ الرِّقابِ من العِدا","لها صَدرٌ ما ينْقَضِي وورُود",73,"د",1,0],["وخواطراً مَرحَتْ إليك صبابةً","وجوانحاً مُلئتْ عليك نُدوبا",74,"ب",2,0],["وخوف