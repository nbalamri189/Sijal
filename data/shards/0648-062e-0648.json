[364,"زمان قليل من بنيه نجيب","https://www.aldiwan.net/poem60998.html","الطويل"],[366,"أرأيت ما أخطا الزمان وما هفا","https://www.aldiwan.net/poem17037.html","الكامل"],[366,"لعينيه على العشاق إمره","https://www.aldiwan.net/poem17205.html","الوافر"],[366,"ماذا يوسوس في الصدور","https://www.aldiwan.net/poem17372.html","مجزوء الكامل"],[371,"فؤاد صحا حتى تعقبه السكر","https://www.aldiwan.net/poem57381.html","الطويل"],[403,"لقد سار الإِمام أبو المعالي","https://www.aldiwan.net/poem33478.html","الوافر"],[406,"سقى دمعي الأحبة حيث ساروا","https://www.aldiwan.net/poem50161.html","الوافر"],[406,"علا بك نجم الدين فاشتد ناصره","https://www.aldiwan.net/poem50168.html","الطويل"],[429,"يهيجني تذكار خل كما البدر","https://www.aldiwan.net/poem41069.html","الطويل"],[432,"الشعر للشعراء مغنم معرك","https://www.aldiwan.net/poem12336.html","الكامل"],[439,"أخو ظمأ يمص حشاه سبع","https://www.aldiwan.net/poem34835.html","الوافر"],[439,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[441,"وقيت ببردي ظهر جلدي على البرد","https://www.aldiwan.net/poem14365.html","الطويل"],[452,"وخود ردح ريش سهم لحاظها","https://www.aldiwan.net/poem13745.html","الطويل"],[458,"أتعلمين يا ابنة الأعاجم","https://www.aldiwan.net/poem55879.html","الرجز"],[458,"لمن طالعات في السراب أفول","https://www.aldiwan.net/poem55924.html","الطويل"],[458,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[458,"إذا رضيت رباك عن الربيع","https://www.aldiwan.net/poem56133.html","الوافر"],[461,"تمنى مقامي والمطالع ضلة","https://www.aldiwan.net/poem15107.html","الطويل"],[461,"رعى الله مجدا صاحبيا تنقلت","https://www.aldiwan.net/poem16031.html","الطويل"],[461,"ولما أناخ الدهر كلكل بأسه","https://www.aldiwan.net/poem16369.html","الطويل"],[464,"هي ظبية الوادي وعين لداتها","https://www.aldiwan.net/poem3345.html","عموديه"],[464,"سفرت والليل داج فأنارا","https://www.aldiwan.net/poem3476.html","عموديه"],[464,"رمتني بنجل والسهام جفون","https://www.aldiwan.net/poem3591.html","عموديه"],[468,"وستر له منظر مونق","https://www.aldiwan.net/poem59805.html","المتقارب"],[477,"أقفر من سكانه المعهد","https://www.aldiwan.net/poem15224.html","السريع"],[477,"كفى حزنا أني أبثك ما عندي","https://www.aldiwan.net/poem15281.html","الطويل"],[493,"صفحت لهذا الدهر عن سيئاته","https://www.aldiwan.net/poem67407.html","الطويل"],[500,"لا تشوش لك سرا","https://www.aldiwan.net/poem37924.html","مجزوء الرمل"],[505,"البديل","https://www.aldiwan.net/poem56766.html","مخلع البسيط"],[505,"الحساب","https://www.aldiwan.net/poem56767.html","الطويل"],[515,"يا أحسن الناس وجهاً","https://www.aldiwan.net/poem12067.html","المجتث"],[524,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[548,"بكى صُرد لما رأى الحي أعرضت","https://www.aldiwan.net/poem1171.html",""],[551,"فجعة ما احتسبتها في زماني","https://www.aldiwan.net/poem47168.html","الخفيف"],[551,"ألا عوجا لمجتمع السيال","https://www.aldiwan.net/poem47286.html","البسيط"],[558,"أنا في الملاح على اليقين","https://www.aldiwan.net/poem33819.html","مجزوء الكامل"],[575,"أيا دمع عيني لا تكن بعد إخواني","https://www.aldiwan.net/poem2776.html","الطويل"]],"verses":[["وَخوصٍ قَد سَرَيتُ بِهِنَّ حَتّى","تَقَوَّضَتِ النُجومُ إِلى الغُيوبِ",0,"ب",1,0],["وخَوْضي إلَيْكِ اللّيلَ أرْكَبُ هَوْلَهُ","وإنْ بَعُدَ المَسْرى فلَسْتُ أبالي",1,"ي",1,0],["وخَوّلني ما ضاقَ ذَرْعُ المُنى بهِ","منَ البِشْرِ في أثناءِ نائِلهِ الغَمْرِ",2,"ر",1,0],["وَخَوَّلَنِي الْفَضَلَ الَّذِي هُوَ أَهْلُهُ","وَشِيكاً وَأَعْطَانِي فَأَفْعَمَ أَعْطَانِي",3,"ي",1,0],["وَخَوَّفُوا النَّاسَ مِنْ دَهْيَاءَ دَاهِيَةٍ","إِذَا بَدَا الْكَوْكَبُ الْغَربِيِّ ذُو الذَّنَبِ",4,"ب",1,0],["وَخَوَت جِربَةُ النُجومِ فَما تَش","رَبُ أُروِيَّةٌ بِمَريِ الجَنوبِ",5,"ب",1,0],["وَخُوصٍ خَوامِسٍ أَورَدتُها","قُبَيلَ الكَوَاكِبِ وِردًا مُلاثا",6,"ث",2,0],["وَخوداً إِذا ما الشاةُ لاذَ مِنَ اللَظى","بِعُبرِيَّةٍ أَو ضالَةٍ لا يَريمُها",7,"م",3,0],["وَخَوصاءَ قَد كَلَّفتُها الهَمَّ دونَهُ","مِنَ البُعدِ شَهراً لِلمَراسيلِ مُجذِمُ",8,"م",1,0],["وَخَوصاءَ قَد نَفَّرتُ عَن كورِها الكَرى","بِذِكراكِ وَالأَعناقُ ميلٌ قِلالُها",9,"ل",3,0],["وَخورُ مُجاشِعٍ تَرَكوا لَقيطاً","وَقالوا حِنوَ عَينِكَ وَالغُرابَ",10,"ب",1,0],["وَخوصٍ قَد قَرَنتُ بِهِنَّ خوصاً","تَجافى الغَيثُ عَنها وَالخُضورُ",11,"ر",1,0],["وَخَوَّدَ فَحلُها مِن غَيرِ شَلٍّ","بِدارَ الريحِ تَخويدَ الظَليمِ",12,"م",1,0],["وَخوصٍ دِقاقٍ قَد حَدَوتُ لِفِتيَةٍ","عَلَيهِنَّ إِحداهُنَّ قَد حَلَّ كورُها",13,"ر",3,0],["وخوفي بالظن إلاَّ ائتلا","ف أو يتناسى الأزبّ النفورا",14,"ر",2,0],["وَخَوَّضَها بَطنَ السَلَوطَحِ رَيثَما","أُديرَت بِمِلحانَ الشُهورُ الدَوائِرُ",15,"ر",1,0],["وخِوَاني مُلَكَّكُ وقِصَاعي","وَبرامي فكلُّها مَشْعُوبُ",16,"ب",1,0],["وخولك الصهيل وكان منه","كثيراً أن يسمِّعك النهاقا",17,"ق",2,0],["وخوفُه العَتْبَ منكَ يُفْرِشُهُ","جمر الغضا ليلَهُ أو الحَسَكا",18,"ك",2,0],["وَخِوانٌ يَعبَقُ المِس","كُ بِرَيّاهُ وَطَعمُه",19,"م",2,0],["وَخودٌ مِنَ اللائي يُسَمَّعنَ بِالضُحى","قَريضَ الرُدافى بِالغِناءِ المُهَوَّدِ",20,"د",1,0],["وخَوْضُ لَيْلٍ تَهابُ الجِنُّ لُجّتَهُ","ويَنْطَويْ جَيْشُها عن جَيْشِه اللّجِبِ",21,"ب",1,0],["وَخَوفُ كُلِّ رَفيقٍ","أَباتَكَ اللَيلُ جَنبَه",22,"ب",2,0],["وَخَوضِهِ غَمرَ كُلِّ مَهلَكَةِ","لِلذِمرِ فيها فُؤادُ رِعديدِ",23,"د",1,0],["وَخُؤولَةٌ في هاشِمٍ وَدَّ العِدى","أَن لَم تَكُن وَلَهُم بِها ما شاؤوا",24,"ا",1,0],["وَخُؤولَتي فَالحَوفَزانُ وَحاتِمٌ","وَالخالِدانِ الرافِدانِ حُماتي",25,"ي",1,0],["وَخُؤولَةٌ مِن عَمرِهِ وَيَزيدِهِ","وَوَليدِهِ وَسَعيدِهِ وَهِشامِهِ",26,"م",2,0],["وَخَوقاءِ أَرضٍ مِن بَعيدٍ رَمَت بِنا","إِلَيكَ مَعَ الصُهبِ المَهاري سُهوبُها",27,"ب",3,0],["وخَوضُ دمٍ إذا جفَّت أعالي","قَوائِمها أتاحَ لها بَلالا",28,"ل",2,0],["وَخوطِيَّةٍ شَمسِيَّةٍ رَشَئِيَّةٍ","مُهَفهَفَةِ الأَعلى رَداحِ المُحَقَّبِ",29,"ب",1,0],["وَخَوَّفوا الناسَ مِن دَهياءَ مُظلِمَةٍ","إِذا بَدا الكَوكَبُ الغَربِيُّ ذو الذَنَبِ",30,"ب",1,0],["وخُوضوا الحربَ بالأَهوالِ تَرْمِي","كَفَى ما امْتدَّ من دَعَةٍ وسِلْمِ",31,"م",1,0],["وَخَوِيِّ سَهلٍ يُثيرُ بِهِ القَو","مُ رِباضاً لِلعَينِ بَعدَ رِباضِ",32,"ض",1,0],["وخوَّلَني ما بينَ مَجدٍ إلى لُهىً","وأورثَني ما بينَ عُقْرٍ إلى عُقْرِ",33,"ر",1,0],["وَخَوضَهُ في نَفَيانِ الوَغى","عَلى طُموحِ الطَرفِ هَرّاجِ",34,"ج",1,0],["وخوْفُ الرّدى آوَى إلى الكَهفِ أهلَهُ","وكَلّفَ نوحاً وابنَهُ عَمَلَ السّفنِ",35,"ن",1,0],["وخوف المودّع غيب النوى","وسهد المنى في انتظار الإياب",36,"ب",1,0],["وخوت زرائبكم وكان على","جنباتهايتدفق اللبن",37,"ن",1,0],["وَخوَّفوها ب \" دُبٍ \" سوف ياكلُها","في حين \" تسعون عاما \" تألفُ السَبُعا",38,"ع",2,0],["وَخُؤولَةٌ في هاشِمٍ ودَّ العِدَى","أنْ لمْ تَكُنْ، وَلهُمْ بِهَا ما شاءوا",39,"ا",1,0],["وخوفُه العَتْبَ منكَ يُفْرِشُهُ","جرر الغضا ليله أو الحَسَكَا",40,"ك",2,0],["وخوافي اسرار غيب لقد غزت","بعين الجحود شوك القتاد",41,"د",1,0],["وخوافي الأسرار تنزل بالأق","دار من دار دورة الأقدار",42,"ر",1,0],["وخُودٍ رَاقَ مِنهَا مَا تَرَاهُ","تَرَدَّدُ في مَحَاسِنِهَا المَهَاهُ",43,"ا",2,1],["وَخَوَّفوا الناسَ فَاِرتاعَت مُلوكُهُمُ","تَرَوُّعَ السِربِ لَمّا عارَضَ السَرِبا",44,"ب",2,0],["وَخَوفُ حُذَيفَةَ عَمّى عَلَي","هِ بِالجَفرِ ما لَم يَغِب عَن حَمَل",45,"ل",1,0],["وَخَوَّلَهُ مَعَ التَقريبِ نَعتاً","لِيَرفَعَ ذِكرُهُ اللَقَبَ الأَجَلّا",46,"ل",2,0],["وخوفت من خوفت من شوم كفره","فما استشعروا خوفاً ولا استمعوا نهيا",47,"ا",1,0],["وخوَّفني ماءٌ منَ العينِ نازلٌ","عمىً هو من ماءٍ إلى العينِ نازِلِ",48,"ل",1,0],["وخَوفني فارتَحت جذلانَ آمِناً","وبِتُّ رخيَّ البالِ مُلتئمَ الشِّعب",49,"ب",1,0],["وَخَوفاً مِنَ الأَمرِ الَّذي يَشعَبُ العَصا","وَمَن خَذَل المَولى لَهُ كانَ أَخذَلا",50,"ل",2,0],["وَخُوضُوا لَظاها بِاِقتِحامٍ فَإِنَّما","يُكَشِّفُ غَمّاءَ الحُروبِ اِقتِحامُها",51,"م",3,0],["وَخُوطٍ مِن فُرُوعِ النَّبعِ ضاحِى","لَها فِى كَفِّ أَعسَرَ كالضُّباحِ",52,"ح",1,1],["وخوفِ مايلقاهُ من ربِّه","في آخر الأمرِ إذا ما حُشِر",53,"ر",1,0],["وخوفِه من ملكٍ غادرٍ","إذا رأى الفرصةَ فيه غدر",53,"ر",1,0],["وخوف دواهيها ومكر حماتها","وسطوة أهليها وهمّ سعاتها",54,"ت",3,0],["وخودٍ ضمَّ مئزرُها كثيباً","يهالَ وبُرْدُها غُصْناً يراحَ",55,"ح",1,1],["وخود في تثنيها","باغصان النقا تزري",56,"ي",1,0],["وخوض الوغَى للموت في كل مأْقِطٍ","بهيمٍ يَخاف الذعرُ فيه من الذّعر",57,"ر",1,0],["وخُوْنُ عهِدك عندي","أشدّ من كل كفرِ",58,"ر",1,0],["وخوفي على المجد الأثيل أضاعني","بأرض بها أم الوفاء هبيل",59,"ل",1,0],["وَخَوَّلَنِي رُعْياً بِها وَكلاءةً","فَخَوَّلَهُ اللَّهُ الكَفاءةَ وَالرَّعْيَا",60,"ي",2,0],["وَخَوَّلَهُ الرِّضَى ما لَمْ يَخَلْهُ","وَكَمْ نَطِفٍ لهُ فَلَجُ البَرِيِّ",61,"ي",1,0],["وخولوا رتباً أضحت تميزهم","وبالمجيدي تحلوا والحديث جرى",62,"ر",2,0],["وَخودٍ تُحاولُ وَصلي وَقَد","أَضاعَت حُقوقي وَمَلَّت جنابي",63,"ي",1,1],["وخوف ونعم الخوف للعبد سائق","ونعم الرجا من قائد للسعادة",64,"ه",1,0],["وخولة عن لبنى ولبنى تجيب عن","سعاد وعن سعدى وحفصةُ عن سلمى",65,"م",2,0],["وخَوَّفني تَصاريفَ اللّيالي","فقلتُ اللهُ حَسْبي والصَّفيّ",66,"ي",1,0],["وخوفاً على أعُينِ النّاظري","نَ نوراً لسائرِها ما أتَمّ",67,"م",1,0],["وخُوزسْتانُ أَوْلَى أن تُهنّا","بمَدِّكمُ عليها لكمْ ظِلالا",68,"ل",2,0],["وخُوّانُ إخوانٍ وحاشا كِرامَهمْ","وهمْ حُضّرٌ أَلْباً مَع الدّهرِ حُشَّد",69,"د",1,0],["وخُوصٍ طَويْنَ البِيدَ وهْي طلائحٌ","تَرامَى بها أغوارُها ونُجودها",70,"د",3,0],["وخوّاضةٍ ماءَ الرِّقابِ من العِدا","لها صَدرٌ ما ينْقَضِي وورُود",71,"د",1,0],["وخواطراً مَرحَتْ إليك صبابةً","وجوانحاً مُلئتْ عليك نُدوبا",72,"ب",2,0],["وخوفَ فراق النّجم قد صار سُحْرةً","لناصية اللّيل البهيم مشيب",73,"ب",1,0],["وَخَواطِرٍ عُدنا بِها يَوماً فَما","عُدنا بِها جَفنَ الحَبيبِ المُدنَفا",74,"ف",2,0],["وَخَوَّفَني مِنَ الأَوزارِ فيهِ","وَمَن لِمُحِبِّهِ لَو نالَ وِزرَه",75,"ر",2,0],["وَخَوالِفُ الأَولادِ تَر","بو في المَزايِلِ لا الحُجورِ",76,"ر",1,0],["وخَودٍ أتَى الفكرُ الصَّحيحُ يزفُّها","لها ذكرُكَ المَشهورُ بينَ الوَرى عِطرُ",77,"ر",1,0],["وخوض الناس في الأفعال شيء","تنزه عنه أرباب الحجال",78,"ل",1,0],["وَخوَّلَكِ النِفارُ وأي ريمٍ","يُرى أَبَداً وَلَيسَ لَهُ نِفارُ",79,"ر",1,0],["وَخَوَّلَهم ما يُنبَتونَ بِهِ العُلى","ويَغنَون ما تبقى عَليهم مآثِرُهُ",80,"ر",2,0],["وخود سبتنا باللحاظ فلم تدع","لناظر جفنيها فواداً بلا سحر",81,"ر",1,0],["وخواطرُ الإِنسانِ ما خَطَرَتْ ففي اس","تعلائِهِ يَمْضِي أَو اسْتِحْطَاطِهِ",82,"ط",2,0],["وخَوَّلَ فَأْلُهُمْ بِكَ فَانْتَحاهمْ","بِهِ أُكُلٌ وظِلٌّ واجْتِنَاءُ",83,"ا",2,0],["وخَوافِقٍ حَفَّتْ بوجهِكَ فاحْتَذَتْ","شَمْسَ النهارِ تَجَلَّلَتْ بسحابِ",84,"ب",1,0],["وخوفك عندي أنت دارٍ بحاله","ولو لم أقل خوف الجزا واقفٌ عندي",85,"ي",1,0],["وخَوْدٍ ردحٍ ريشَ سَهْمُ لحاظها","بهدب جفون للصوارم أغمد",86,"د",1,1],["وخَوَّلوا من نِعمةٍ واغتنموا","جُلَّ السماح عن يمين غارمِ",87,"م",1,0],["وخُوِّل أعناقَ المطيّ فَساقَها","وراءَ التي يسمو بها ويصولُ",88,"ل",1,0],["وخودع عن خُلْقه في العقوق","وما خلتُها شيمةً تُنقَلُ",89,"ل",1,0],["وخوَّانينَ منفردين عنّي","فما نقصَ الوحيدُ عن الجميعِ",90,"ع",1,0],["وخوضي للأهوال غير محاذرٍ","أعاصي مرادي ثمَّ ألقاكَ طَيِّعاَ",91,"ع",2,0],["وخوْفُ اتِّهامِ الظَّنِّ أنيِّ مادحٌ","لرِفْدٍ وأني للمطامعِ ساهرُ",92,"ر",1,0],["وخوضي غِمار الموت فيكمْ مُقَحِّماً","وقد رهِبتْ أولى طلائعه الأُسْدُ",93,"د",1,0],["وخواطر مثل البحار خطوطه","أبداً تكنُّ الدرّ في ظلماتها",94,"ت",3,0],["وخودُ الغيد تدمى خجلاً","والرُّبى تبهر زنداً وبهارا",95,"ر",2,0],["وخوّفتماني غارةً عامريّةً","يخفُّ بها الغيران وهو رصين",96,"ن",1,0],["وَخوذَةٌ هَذا لَها بَهجَةٌ","وَجَوشَنُ هَذا لَهُ رَونَقُ",97,"ق",1,0],["وخَوضي بحرَ كلَّ سرابِ قفرٍ","عليها واعتسافي كلَّ بيدِ",98,"د",1,0],["وخوصُ النياقِ الواخداتِ بواركٌ","لوشكِ النوى مابينَ حَلِّ إلى شَدِّ",99,"د",1,0],["وخوفني منه فخلت صليبه","لشدة ما يخشاه بعض وشاته",100,"ت",2,0],["وخَؤونٍ وأمينٍ","ومُعادٍ ومُخالِلْ",101,"ل",1,0],["وخوْفُ من ساءَنِي أكيدُ","وظنُّه فيّ لا يخيبُ",102,"ب",1,0],["وخوفٌ يداهمُ الرّجاءَ مُزلزلِا","أربّاً عبدْتَ أمْ عبَدْتَ رُبوبا؟",103,"ب",2,0],["وخولوني ولكن","خلطت جاهاً ونقدا",104,"د",2,0],["وَخَوّلونيَ مُلكاً فيهِ فُزتُ بِهم","فَوزَ العُفاةِ بِوافي فَيضِ فَضلِهِمِ",105,"م",1,0],["وُخَوَّفَهُ رَيبِ الزَمانِ وَفَقرُهُ","بِلادَ عَدُوٍّ حاضِرٍ وَجَدوبُ",106,"ب",1,0],["وخَوافٍ قد فارقتْ لونَها الأظ","هرَ فيها بمنظرٍ أُرجُوانِي",107,"ي",1,0],["وخوّفني العُداةُ الشَّرَّ منهمْ","فما خطرتْ مخافتُهمْ ببالي",108,"ل",2,0],["وخواطري رأت الهدى","في حب وضاح الجبين",109,"ن",1,0],["وخوفي أَنْ أَمْضِي إِلى عند مالك","فيَغْتَمَّ منه قَلْبُه عند رِضْوَان",110,"ن",1,0]]}