{"poems":[[53,"زار والركب حرام","https://www.aldiwan.net/poem29819.html","مجزوء الرمل"],[53,"كل شيء من الزمان طريف","https://www.aldiwan.net/poem29965.html","الخفيف"],[53,"مرضت بعدكم صدور الصعاد","https://www.aldiwan.net/poem30618.html","الخفيف"],[5,"ألا هبي بصحنك فاصبحين","https://www.aldiwan.net/poem311.html","الوافر"],[23,"ألا أبلغا عني أسيدا رسالة","https://www.aldiwan.net/poem21475.html","الطويل"],[12,"إن بالشعب الذي دون سلع","https://www.aldiwan.net/poem1231.html",""],[89,"ألا إنما هذا الذي لك أنقل","https://www.aldiwan.net/poem44963.html","الطويل"],[45,"أرسوم دار أم سطور كتاب","https://www.aldiwan.net/poem11430.html","الكامل"],[45,"أما الشباب فقد سبقت بغضه","https://www.aldiwan.net/poem64623.html","الكامل"],[61,"وجد الحب لي فؤادا علوقا","https://www.aldiwan.net/poem51502.html","الخفيف"],[67,"ذو يراع يروع كالسيف إما","https://www.aldiwan.net/poem18069.html","الخفيف"],[50,"أأرقت بعد رقادك الأواب","https://www.aldiwan.net/poem64844.html","الكامل"],[5,"","https://poetry.dctabudhabi.ae/diwan/poem/6821","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54815","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67334","الوافر"],[100,"منها وإليها","https://www.poetsgate.com/ViewPoem.aspx?id=50159",""],[13,"إنَّ بِالْشِّعْبِ الَّذِي دُونَ سَلْعٍ","https://www.poetsgate.com/ViewPoem.aspx?id=180818",""]],"verses":[["وَعِتابُ القَومِ إِلّا","بِالمَعاريضِ خِصامُ",0,"م",1,0],["وَعِتابي هَزّاً لِعِطفِكَ وَالأَغ","صانُ ما لَم تَهُزُّهُنَّ وُقوفُ",1,"ف",1,0],["وَعِتابُ الزَمانِ مِثلُ عِتابِ ال","عَينِ تُنهى وَدَمعُها بِاِزدِيادِ",2,"د",1,0],["وَعَتّاباً وَكُلثوماً جَميع","بِهِم نِلنا تُراثَ الأَكرَمينا",3,"ن",2,0],["وَعَتّابُ عَبدٌ غَيرُ موفٍ بِذِمَّةٍ","كَذوبُ شُؤُونِ الرَأسِ قِردٌ مُؤَدَّبُ",4,"ب",1,0],["وَعِتَاقُ الطَّيرِ تَهفُو بِطَاناً","تَتَخَطّاهُمُ فَما تَستَقِلُّ",5,"ل",1,0],["وعتبي على الأقدار فهي بما جرت","به لم تكن أستغفر اللَه تعدل",6,"ل",1,0],["وَعَتَبتِ مِن حُبّيكِ حَتّى إِنَّني","أَخشى مَلامَكِ أَن أَبُثَّكِ مابي",7,"ب",2,0],["وَعِتابِ خِلٍّ قَد سَمِعتُ فَلَم أَكُن","جَلدَ الضَميرِ عَلى استِماعِ مُمِضِّهِ",8,"ض",2,0],["وعَتيقِ النَّجارِ ماضٍ وهل يَم","ضي شَبا السَّيفِ أو يكونَ عَتيقا",9,"ق",2,0],["وعَتَتْ أُمُّهُمْ عليَّ وَلَجَّتْ","في عُتُوٍّ مِنْ كَبْرَتِي ونُفُورِ",10,"ر",1,0],["وَعِتابِ يَومٍ لَو أَجَبتُكَ طائِعاً","قَصُرَ الوِصالُ بِهِ وَطالَ عِتابي",11,"ي",1,0],["وَعَتّاباً وَكُلثوماً جَميعاً","بِهِم نِلنا تُراثَ الأَكرَمينا",12,"ن",2,0],["وَعَتْ بَدِيعَ البَدِيعِ فَهيَ تَلِي","فِي سُورَةِ الكَوْنِ آيَةَ القمَرِ",13,"ر",1,0],["وَعِتَاباً لَوْلاَ البَرَاءَةُ مِنْهُ","عَاجِلاً كَانَ سُبَّةَ الآبادِ",14,"د",1,0],["وَعُتْبَةُ وابنُهُ خَرَّا جَمِيعاً","وَشَيْبَةُ عَضَّهُ السَّيْفُ الصَّقِيلُ",15,"ل",1,0],["وعتاب يفضي إليك فإنّ لا","قاك أغضى وذاب في القلب شكوى",16,"و",2,0],["وَعِتَاقُ الطَّيْرِ تَغْدُو بِطاناً","تَتَخَطَّاهُمْ فَمَا تَسْتَقِلُّ",17,"ل",1,0]]}