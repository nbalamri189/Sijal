diwan/poem/114052","الخفيف"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133247","الوافر"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133228","الوافر"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133216","الوافر"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95332","الرجز"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44683","البسيط"],[3982,"","https://poetry.dctabudhabi.ae/diwan/poem/18398","الوافر"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125805","الكامل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101372","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102741","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102743","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133191","الوافر"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133128","الوافر"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121261","الطويل"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104514","الكامل"],[4478,"","https://poetry.dctabudhabi.ae/diwan/poem/18828","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72423","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72428","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72509","الطويل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204192","الكامل"],[4755,"التَّمِيمة","https://www.poetsgate.com/ViewPoem.aspx?id=208979",""],[4836,"أمى","https://www.poetsgate.com/ViewPoem.aspx?id=203611",""],[5183,"ذكرى الأخوة","https://www.poetsgate.com/ViewPoem.aspx?id=180230",""],[5206,"تسكين الرّمل","https://www.poetsgate.com/ViewPoem.aspx?id=187401",""],[5237,"رويدكم فما سمعي بقابل","https://www.poetsgate.com/ViewPoem.aspx?id=113117",""],[5277,"نجوى قلم","https://www.poetsgate.com/ViewPoem.aspx?id=185263",""],[5277,"عتائقُ البثِّ القديمِ","https://www.poetsgate.com/ViewPoem.aspx?id=211158",""],[5397,"بمد العمر قد ذهب الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=157906",""],[5409,"خسرتك البلادُ ركنا قويا","https://www.poetsgate.com/ViewPoem.aspx?id=155487",""],[5411,"وِعَساكَ تَسْمَعُ","https://www.poetsgate.com/ViewPoem.aspx?id=185348",""],[5616,"انا","https://www.poetsgate.com/ViewPoem.aspx?id=207396",""],[5638,"شعري","https://www.poetsgate.com/ViewPoem.aspx?id=198121",""],[5722,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=12685",""],[5790,"أما وبدور الكلل","https://www.poetsgate.com/ViewPoem.aspx?id=112122",""],[6256,"كلمات إليها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65934&r=&rc=22",""],[6315,"بيروت وأحاديث العرَّاف ... قراءة لأقداح الأنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87583&r=&rc=8",""]],"verses":[["وَعِتابُ القَومِ إِلّا","بِالمَعاريضِ خِصامُ",0,"م",1,0],["وَعِتابي هَزّاً لِعِطفِكَ وَالأَغ","صانُ ما لَم تَهُزُّهُنَّ وُقوفُ",1,"ف",1,0],["وَعِتابُ الزَمانِ مِثلُ عِتابِ ال","عَينِ تُنهى وَدَمعُها بِاِزدِيادِ",2,"د",1,0],["وَعَتّاباً وَكُلثوماً جَميع","بِهِم نِلنا تُراثَ الأَكرَمينا",3,"ن",2,0],["وَعَتّابُ عَبدٌ غَيرُ موفٍ بِذِمَّةٍ","كَذوبُ شُؤُونِ الرَأسِ قِردٌ مُؤَدَّبُ",4,"ب",1,0],["وَعِتَاقُ الطَّيرِ تَهفُو بِطَاناً","تَتَخَطّاهُمُ فَما تَستَقِلُّ",5,"ل",1,0],["وعتبي على الأقدار فهي بما جرت","به لم تكن أستغفر اللَه تعدل",6,"ل",1,0],["وَعَتَبتِ مِن حُبّيكِ حَتّى إِنَّني","أَخشى مَلامَكِ أَن أَبُثَّكِ مابي",7,"ب",2,0],["وَعِتابِ خِلٍّ قَد سَمِعتُ فَلَم أَكُن","جَلدَ الضَميرِ عَلى استِماعِ مُمِضِّهِ",8,"ض",2,0],["وعَتيقِ النَّجارِ ماضٍ وهل يَم","ضي شَبا السَّيفِ أو يكونَ عَتيقا",9,"ق",2,0],["وعَتَتْ أُمُّهُمْ عليَّ وَلَجَّتْ","في عُتُوٍّ مِنْ كَبْرَتِي ونُفُورِ",10,"ر",1,0],["وَعِتابِ يَومٍ لَو أَجَبتُكَ طائِعاً","قَصُرَ الوِصالُ بِهِ وَطالَ عِتابي",11,"ب",2,0],["وَعَتّاباً وَكُلثوماً جَميعاً","بِهِم نِلنا تُراثَ الأَكرَمينا",12,"ن",2,0],["وَعَتْ بَدِيعَ البَدِيعِ فَهيَ تَلِي","فِي سُورَةِ الكَوْنِ آيَةَ القمَرِ",13,"ر",1,0],["وَعِتَاباً لَوْلاَ البَرَاءَةُ مِنْهُ","عَاجِلاً كَانَ سُبَّةَ الآبادِ",14,"د",1,0],["وَعُتْبَةُ وابنُهُ خَرَّا جَمِيعاً","وَشَيْبَةُ عَضَّهُ السَّيْفُ الصَّقِيلُ",15,"ل",1,0],["وعتاب يفضي إليك فإنّ لا","قاك أغضى وذاب في القلب شكوى",16,"و",2,0],["وعتابا يكاد من رقّة الأل","فاظ يجري على الشفاه دموعا",17,"ع",2,0],["وَعِتَاقُ الطَّيْرِ تَغْدُو بِطاناً","تَتَخَطَّاهُمْ فَمَا تَسْتَقِلُّ",18,"ل",1,0],["وعتاب كالجمر صنتك عنه","جزعا أن ينال منك عذول",19,"ل",1,0],["وَعَتهُ جَوادٌ لا يُباعُ جَبينُها","بِمَنسوبَةٍ أَعراقُهُ غَيرِ مُحمِقِ",20,"ق",1,0],["وعتيقٍ أثار بالسَّبقِ نقعا","فغدا فوقه يُهال ويُبنَى",21,"ن",2,0],["وَعِتاقٌ مُقوَرَّةٌ تَسبِقُ الأَو","هامَ إِذ غَيرُها يُباري الجِيادا",22,"د",2,0],["وَعَتا الزَمانُ فَكَفَّ مِن غُلوائِهِ","فَعَنا وَصارَ لِما يُريدُ مُريدا",23,"د",2,0],["وعَتَبت حين صحَحتِ وَهوَ بِدَائِهِ","شَتَّى العِتابِ مُصَحَّحٌ وَسَقِيمُ",24,"م",1,0],["وَعِتابُ الأَحبابِ حُلوٌ وَأَحلا","هُ مَذاقاً ما جاءَ مِن أَحلاها",25,"ا",3,0],["وعتابٍ كنتُ أحسَبُه","نَفَثاتِ السحرِ في العُقَدِ",26,"د",1,0],["وعِتْرة صفْوَةِ اللهِ المُسمَّى","إذا بَدتِ الإقامة والأذان",27,"ن",1,0],["وعترته والطاهرات نساءه ال","لواتي جميعاً كن غير خبائث",28,"ث",1,0],["وعتابُ الأقدار لا يَنفَعُ المرءَ","ولكن ما الصبرُ في الإمكان",29,"ن",1,0],["وعترة الأعاظِم الأماجِد","يَنْميهِ في أُرومَةِ الْمَحَامِد",30,"د",1,0],["وعترتُه الغرُّ الهداةُ ومن لهم","مَناقبُ لا تَفنى وإِن فَنيَ الدهرُ",31,"ر",1,0],["وَعُتبةُ السلميُّ لَم يزل عبقاً","بِالطيب مُذ مَسَحته مِن شرىً يرمُ",32,"م",1,0],["وَعِتاقُ الأَحبابِ يَشغَلُ عَنهُ","هِمَّةٌ هَمُّها عِناقُ السُيوفِ",33,"ف",1,0],["وَعَتبي لِلزَمانِ بِغَيرِ ذَنبٍ","كَما عُتِبَ الصَباحُ مِنَ البَصيرِ",34,"ر",1,0],["وعُترةِ خيرِ الورى من قضَى","سعيداً على مَنهج المرْتَضَى",35,"ض",2,0],["وعُترتِه الهداة الغُرّ حقّاً","جميعاً ما تَعاقبتِ الدَهورُ",36,"ر",1,0],["وعتَبْتَه فأنَلْتَه","شرَفاً ومجداً لن يُنالا",37,"ل",2,0],["وعت الأزهار في ظل دوحها","فيا حبذا عرف من النشر فائح",38,"ح",1,0],["وعترته القادة التابعين","بحور النوادي أسود الجلاد",39,"د",1,0],["وعترته أَولي الشرف الرفيع","صلاة منك تمحو السيئات",40,"ت",1,0],["وعَتوا وكلّ عزيزِ قو","مٍ تحت أرجلهم مهانُ",41,"ن",1,0],["وعتبٌ طال والأيامُ صُمٌّ","كما يشكو إلى الموج الغريقُ",42,"ق",1,0],["وعتادي الذي به ادرأ الأعدا","ء عن حوزتي وأردي الحسودا",43,"د",2,0],["وعَتبي على دهري قديمٌ وكلَّما","تقادمَ داءٌ فهوَ لا شكَّ قاتل",44,"ل",1,0],["وعتبنا الأيام بعدُ وما تز","داد إلا حقداً علينا وضغنا",45,"ن",2,0],["وعتاقُ الجيادِ وهيَ بحارٌ","تتبارى ما بين سخٍّ ومزع",46,"ع",1,0],["وعِتادي وحُجَّتي وعِمادي","وظَهيري وناصِري ووَلِيِّي",47,"ي",1,0],["وعتابي بالصّفح عم","مَن جنى كان أبلغا",48,"غ",2,0],["وعتاد الجنودِ لا يحفظ الدو","لة إلا بعدة الألباب",49,"ب",1,0],["وَعِتْرَتِهِ وَالْمُرْتَضى خَيْرِ حِزْبِهِ","سَيُسْقى غَداً كَأْساً يَلَذُّ بِشُرْبِهِ",50,"ه",1,0],["وعتاقا لكل قفر وبيد","لا يجيب الدليل غيرُ صداها",51,"ا",3,0],["وعتاده الحرب أبيض صارم","ومثقف لدن ونهد مشرف",52,"ف",1,0],["وعترته والصحب ما ألبس الحيا","عرائس روض الزهر أثواب سندس",53,"س",1,0],["وَعِتْرَتِهِ وَالآلِ وَالصَّحْبِ كُلَّمَا","تَذكَّرَ مشتَاقٌ أحِبَّاهُ فَاهْتَزَّا",54,"ز",2,0],["وعترته عترة قد عَلَتْ","بأنسابها وبأحسابها",55,"ب",3,0],["وَعُتَهِيِّ الجِنِّ ذِي الفُحَامِ","أَسْكَتَ أَهْلَ الكَمَدِ الوَجّامِ",56,"م",1,0],["وعتب كحيلة العينين رود","يذوب لعتبها الحجر الصلود",57,"د",1,0],["وعتابَنا وكأنه بَرَدٌ","ومزاحَنا وكأنّها شَهْدُ",58,"د",1,0],["وَعِتاقُ الطَيرِ عاكِفَةٌ","وَضِباعُ الجِزعِ مُتَّخِمَة",59,"م",2,0],["وعتبةُ الشر لم يعتب فتعطفه","منك العواطفُ قبل الحين من مهَلِ",60,"ل",1,0],["وعترته بالطف صرعى تزورهم","وحوش الفلا حتى احتوتهم ضرائحه",61,"ح",2,0],["وَعِتيَرِ مُعتَركٍ قائِمٍ","خلُوقاً ومِسكا ودُهنَ العَوَال",62,"ل",1,0],["وعتقُ أعود عين في الظهار فقد","أجيز والعبدُ ذي الأشراك والدغل",63,"ل",1,0],["وَعَتَبتَ لي صَرفَ الزَمانِ فَأَعتَبَت","أَخلاقُهُ وَتَبَدَّلَت تَبديلا",64,"ل",2,0],["وعَتْباً وتعنيفاً ولَوْماً على الذي","جَرَى ذِكْرُهُ في الخافقيَنْ وبَالا",65,"ل",2,0],["وَعِتابٍ أَرَقَّ من بِسمَة الفَجْ","ر تَمنّتْ مَا هُنَّ ماءٍ وظِلِّ",66,"ل",1,0],["وعتبةُ أقصى مُنيتي وأعزّ منْ","عليّ وأشهى منْ إليه أثوبُ",67,"ب",1,0],["وعتبة يعوي بالعراق وإن يكن","عوى عرضا (1) من داره لا يبدل",68,"ل",1,1],["وعترة المختار طه الطاهر","ما هام بالملاح صب عاشق",69,"ق",1,0],["وَعُتُوِّ الاََراذِلِ وَالاََوْغادِ","بِالنَّبِيِّ وَآلِهِ الاََمْجادِ",70,"د",1,0],["وعترة المختار ساداتنا","بحبهم تقبل طاعاتنا",71,"ن",2,0],["وِعِتْرَتِه أولي القدرِ الجليلِ","وسائرِ صحبِه السَّامينَ قدرا",72,"ر",2,0],["وَعَتٌّ الى سِلْمِي وَرمتَ نَصِيْحتَي","ولم يدرِ أَنَّ الذابلاتِ تُدِيلُ",73,"ل",1,0],["وعتاد خصمك حلف الأطلس كله","يزجي بأسلحة له وجنود",74,"د",1,0],["وعِترةُ مَرء في الأَنام وصَحبُهُ","وأَنصارُهُ الأَخيارُ في الغَم والطَرَب",75,"ب",1,0],["وَعتبُ المرء من لم يختبره","وَيَعلمُ ودّه خَطرٌ جسيم",76,"م",1,0],["وعترتك المستودعي سر علمك ال","مصون عن الأغيار عرب وأعجم",77,"م",1,0],["وَعِتابُ الإلاَهِ غالِبُهُ مِن","نَحوِهِ لاَ تَغُرَّكَ الأهواءُ",78,"ا",2,0],["وعترتك الكرام ومن يليهم","حماة الحق من صحب وصهر",79,"ر",1,0],["وعترته ومن نصروا وآووا","وصحب ما لفضلهم انتهاء",80,"ا",2,0],["وعترته وأصحابه كرام","نجوم الفضل في أفق السعاده",81,"د",2,0],["وعتق العبدُ وأبغضت الرجل","وبغض البغيض بالضم فقل",82,"ل",1,0],["وَعترة المُصطفى في الكَون حائِرةٌ","وَمن حسين لَقَد غضَّت مآقيها",83,"ي",3,0],["وَعَتّاباً فَلا تَنسى وَعَمرواً","وَأَربابَ الزَميلِ بَني الرَقوبِ",84,"ب",1,0],["وعتا ابو الخيل النكوث بفتنة","عميا لأرجاء القصيم شمول",85,"ل",1,0],["وعت الملائك في السماء صراخهم","ومن التجوا في الأرض غير وعاة",86,"ه",1,0],["وعترته والصحب من كل من زكا","له مغرس نامي الفروع وعيص",87,"ص",1,0],["وعترته والصحب ما لاح في الدجى","بريق شجاني والدجى لمم شمط",88,"ط",1,0],["وعترته مع آلٍ وصحبٍ","هداة الدين سادات دعاته",89,"ت",2,0],["وعترته مع الأصحاب جمعاً","أهيل الدين والأمر الرشيد",90,"د",1,0],["وعترَةُ قنطوراء في كل منزلٍ","تصيحُ بأولادِ البرامك من يشرى",91,"ر",2,0],["وعتا القوي على الضعيف","وبدل الإيمان كفرا",92,"ر",2,0],["وَعَتِبتِ حينَ صَحِحتِ وَهوَ بِدائِهِ","شَتّانَ ذاكَ مُصَحَّحٌ وَسَقيمُ",93,"م",1,0],["وعترة أنزع شثن بطين","فهم من غير شك عن يقين",94,"ن",1,0],["وعت من الملأ الأعلى لها أذن","فشنفتها بتكبير وتهليل",95,"ل",1,0],["وعت كل اعظام حوت جلَّ مفخر","زكت مغرس الجدوى طوت شقة البخل",96,"ل",1,0],["وعتيدة للطيب إن تستدعها","تبعث إليك أمامها ببشيرها",97,"ر",3,1],["وعَتَادٍ مع المَجَاعَةِ يَنمُو","وعِنَادٍ مِن الشَّجاعَةِ يُضعِف",98,"ف",1,0],["وعتا عجاج الموت ثار بخافقى","ومضى حثيثا بالمكاره يوجفُ",99,"ف",1,0],["وعترة وبنو صلب وحاشية","يُزجون في ختمها ما شاء مزجيها",100,"ي",3,0],["وعَتبَى خروجٍ في طريق دُخولِهَا","بِجَمعِ نَقيِّ الخدِّ في رَوْمِ إرباحِ",101,"ح",1,0],["وعترتك الكرام أولي المعالي","شموس الفضل والصحب الأفاضل",102,"ل",1,0],["وعتّقِ الصمتَ إنّ الصمتَ مدرسةٌ","وارتقْ ثيابَ الأسى من خيطِ حنجرتي",103,"ت",2,0],["وعتائقُ البثِّ القديمِ تؤودهُ","كجنى الربيعِ وقدْ نأى عنْ مغرسِ",104,"س",1,0],["وعت منه لوحي الله إذن","بنى بالنص بينه الخطاب",105,"ب",1,0],["وعتاةً من نسل قابيل لا تت","رك في الأرض صالحاً أو تقيا",106,"ي",2,0],["وَعَتا الْهَوى وَتَغَبَّشَتْ فيهِ الرُّؤى","وتَحَيَّنوا حَوْلَ الوُرودِ شِباكا",107,"ك",2,0],["وعتقني الزمان فصرت ضربا","من الصهباء تشربها. حلالا",108,"ل",2,0],["وَعُتَاةُ الطُّغَاةِ قَدْ عَلِمُوهُ","كَوَقُودِ الأَحْرَارِ بَلْ نِيرَانِ",109,"ن",1,0],["وعِتابُ الأيام شِبهُ صلاةٍ","فاتركاهُ مُستغرقاً في صَلاتِهْ",110,"ت",2,0],["وعتب يزيل الجوى","ورشف يزيل العلل",111,"ل",1,0],["وعتاباً صامتاً يأخذ مني شفتيّا","ثم لا يُبقي سوى الودِّ بعمق القلب حيّا",112,"ي",2,0],["وعَتِّقْهما .. قد تدفن الأرض وجهها","بكَفّيكَ .. خجلى .. تشعل الفن والشِّعرا",113,"ر",2,0]]}