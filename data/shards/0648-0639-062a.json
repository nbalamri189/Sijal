{"poems":[[53,"زار والركب حرام","https://www.aldiwan.net/poem29819.html","مجزوء الرمل"],[53,"كل شيء من الزمان طريف","https://www.aldiwan.net/poem29965.html","الخفيف"],[53,"مرضت بعدكم صدور الصعاد","https://www.aldiwan.net/poem30618.html","الخفيف"],[5,"ألا هبي بصحنك فاصبحين","https://www.aldiwan.net/poem311.html","الوافر"],[23,"ألا أبلغا عني أسيدا رسالة","https://www.aldiwan.net/poem21475.html","الطويل"],[12,"إن بالشعب الذي دون سلع","https://www.aldiwan.net/poem1231.html",""],[89,"ألا إنما هذا الذي لك أنقل","https://www.aldiwan.net/poem44963.html","الطويل"],[45,"أرسوم دار أم سطور كتاب","https://www.aldiwan.net/poem11430.html","الكامل"],[45,"أما الشباب فقد سبقت بغضه","https://www.aldiwan.net/poem64623.html","الكامل"],[61,"وجد الحب لي فؤادا علوقا","https://www.aldiwan.net/poem51502.html","الخفيف"],[67,"ذو يراع يروع كالسيف إما","https://www.aldiwan.net/poem18069.html","الخفيف"],[50,"أأرقت بعد رقادك الأواب","https://www.aldiwan.net/poem64844.html","الكامل"],[5,"","https://poetry.dctabudhabi.ae/diwan/poem/6821","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54815","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67334","الوافر"],[100,"منها وإليها","https://www.poetsgate.com/ViewPoem.aspx?id=50159",""],[100,"عندما ضمنا اللقاء","https://www.poetsgate.com/ViewPoem.aspx?id=50144",""],[13,"إنَّ بِالْشِّعْبِ الَّذِي دُونَ سَلْعٍ","https://www.poetsgate.com/ViewPoem.aspx?id=180818",""],[94,"أين أين الرعيل من أهل بدر","https://www.poetsgate.com/ViewPoem.aspx?id=13787",""],[128,"ألا طرقت أسماء في غير مطرق","https://www.aldiwan.net/poem24276.html","الطويل"],[143,"كل يوم خل يرحل عنا","https://www.aldiwan.net/poem58418.html","الخفيف"],[144,"عوضونا من السهاد الرقادا","https://www.aldiwan.net/poem11742.html","الخفيف"],[144,"طاول بهمتك الزمان وحيدا","https://www.aldiwan.net/poem11746.html","الكامل"],[182,"وإذا عتبت على بت كأننى","https://www.aldiwan.net/poem59053.html","الكامل"],[183,"عرجا في ربوعها وسلاها","https://www.aldiwan.net/poem67021.html","الخفيف"],[186,"يا محل الروح من جسدي","https://www.aldiwan.net/poem14498.html","أحذ الكامل"],[186,"هناؤك ليس يعدمه زمان","https://www.aldiwan.net/poem14678.html","الوافر"],[232,"لمن طلل دون الربا والتنائث","https://www.aldiwan.net/poem44596.html","الطويل"],[251,"يا وزير العلا ومن حاز مجدا","https://www.aldiwan.net/poem15040.html","الخفيف"],[276,"أشدو بها وسط الندي الحاشد","https://www.aldiwan.net/poem25593.html","الرجز"],[298,"سلا دارها أن أنبأ الطلل القفر","https://www.aldiwan.net/poem33254.html","الطويل"],[306,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[367,"كيف يخلو وما خلا من عفاف","https://www.aldiwan.net/poem17233.html","الخفيف"],[367,"أبا قرب النعي من البشير","https://www.aldiwan.net/poem17345.html","الوافر"],[403,"بحب الرسول وحب البتول","https://www.aldiwan.net/poem46954.html","الطويل"],[403,"هي الدنيا وأنت بها خبير","https://www.aldiwan.net/poem47006.html","الوافر"],[410,"قالوا ترشفت الليالي ماءه","https://www.aldiwan.net/poem32170.html","الكامل"],[430,"سل البان هل مرت عليه النوافح","https://www.aldiwan.net/poem41406.html","الطويل"],[442,"أيا شارباً كأس خمر الرقاد","https://www.aldiwan.net/poem14364.html","المتقارب"],[442,"نيوب النائبات البائنات","https://www.aldiwan.net/poem14437.html","الوافر"],[459,"إن تسأليني بعد قومي","https://www.aldiwan.net/poem55856.html","مجزوء الكامل"],[459,"أيا سكر الزمان متى تفيق","https://www.aldiwan.net/poem56099.html","الوافر"],[465,"ظبيات الحمى تخيف الأسودا","https://www.aldiwan.net/poem3169.html","عموديه"],[465,"لقد سل سيفا والغدار الحمائل","https://www.aldiwan.net/poem3189.html","عموديه"],[465,"يا زماناً بالخيف كان وكنا","https://www.aldiwan.net/poem3416.html","عموديه"],[465,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[501,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[552,"لا رعى الله من إلى","https://www.aldiwan.net/poem47407.html","مجزوء الخفيف"]],"verses":[["وَعِتابُ القَومِ إِلّا","بِالمَعاريضِ خِصامُ",0,"م",1,0],["وَعِتابي هَزّاً لِعِطفِكَ وَالأَغ","صانُ ما لَم تَهُزُّهُنَّ وُقوفُ",1,"ف",1,0],["وَعِتابُ الزَمانِ مِثلُ عِتابِ ال","عَينِ تُنهى وَدَمعُها بِاِزدِيادِ",2,"د",1,0],["وَعَتّاباً وَكُلثوماً جَميع","بِهِم نِلنا تُراثَ الأَكرَمينا",3,"ن",2,0],["وَعَتّابُ عَبدٌ غَيرُ موفٍ بِذِمَّةٍ","كَذوبُ شُؤُونِ الرَأسِ قِردٌ مُؤَدَّبُ",4,"ب",1,0],["وَعِتَاقُ الطَّيرِ تَهفُو بِطَاناً","تَتَخَطّاهُمُ فَما تَستَقِلُّ",5,"ل",1,0],["وعتبي على الأقدار فهي بما جرت","به لم تكن أستغفر اللَه تعدل",6,"ل",1,0],["وَعَتَبتِ مِن حُبّيكِ حَتّى إِنَّني","أَخشى مَلامَكِ أَن أَبُثَّكِ مابي",7,"ب",2,0],["وَعِتابِ خِلٍّ قَد سَمِعتُ فَلَم أَكُن","جَلدَ الضَميرِ عَلى استِماعِ مُمِضِّهِ",8,"ض",2,0],["وعَتيقِ النَّجارِ ماضٍ وهل يَم","ضي شَبا السَّيفِ أو يكونَ عَتيقا",9,"ق",2,0],["وعَتَتْ أُمُّهُمْ عليَّ وَلَجَّتْ","في عُتُوٍّ مِنْ كَبْرَتِي ونُفُورِ",10,"ر",1,0],["وَعِتابِ يَومٍ لَو أَجَبتُكَ طائِعاً","قَصُرَ الوِصالُ بِهِ وَطالَ عِتابي",11,"ب",2,0],["وَعَتّاباً وَكُلثوماً جَميعاً","بِهِم نِلنا تُراثَ الأَكرَمينا",12,"ن",2,0],["وَعَتْ بَدِيعَ البَدِيعِ فَهيَ تَلِي","فِي سُورَةِ الكَوْنِ آيَةَ القمَرِ",13,"ر",1,0],["وَعِتَاباً لَوْلاَ البَرَاءَةُ مِنْهُ","عَاجِلاً كَانَ سُبَّةَ الآبادِ",14,"د",1,0],["وَعُتْبَةُ وابنُهُ خَرَّا جَمِيعاً","وَشَيْبَةُ عَضَّهُ السَّيْفُ الصَّقِيلُ",15,"ل",1,0],["وعتاب يفضي إليك فإنّ لا","قاك أغضى وذاب في القلب شكوى",16,"و",2,0],["وعتابا يكاد من رقّة الأل","فاظ يجري على الشفاه دموعا",17,"ع",2,0],["وَعِتَاقُ الطَّيْرِ تَغْدُو بِطاناً","تَتَخَطَّاهُمْ فَمَا تَسْتَقِلُّ",18,"ل",1,0],["وعتاب كالجمر صنتك عنه","جزعا أن ينال منك عذول",19,"ل",1,0],["وَعَتهُ جَوادٌ لا يُباعُ جَبينُها","بِمَنسوبَةٍ أَعراقُهُ غَيرِ مُحمِقِ",20,"ق",1,0],["وعتيقٍ أثار بالسَّبقِ نقعا","فغدا فوقه يُهال ويُبنَى",21,"ن",2,0],["وَعِتاقٌ مُقوَرَّةٌ تَسبِقُ الأَو","هامَ إِذ غَيرُها يُباري الجِيادا",22,"د",2,0],["وَعَتا الزَمانُ فَكَفَّ مِن غُلوائِهِ","فَعَنا وَصارَ لِما يُريدُ مُريدا",23,"د",2,0],["وعَتَبت حين صحَحتِ وَهوَ بِدَائِهِ","شَتَّى العِتابِ مُصَحَّحٌ وَسَقِيمُ",24,"م",1,0],["وَعِتابُ الأَحبابِ حُلوٌ وَأَحلا","هُ مَذاقاً ما جاءَ مِن أَحلاها",25,"ا",3,0],["وعتابٍ كنتُ أحسَبُه","نَفَثاتِ السحرِ في العُقَدِ",26,"د",1,0],["وعِتْرة صفْوَةِ اللهِ المُسمَّى","إذا بَدتِ الإقامة والأذان",27,"ن",1,0],["وعترته والطاهرات نساءه ال","لواتي جميعاً كن غير خبائث",28,"ث",1,0],["وعتابُ الأقدار لا يَنفَعُ المرءَ","ولكن ما الصبرُ في الإمكان",29,"ن",1,0],["وعترة الأعاظِم الأماجِد","يَنْميهِ في أُرومَةِ الْمَحَامِد",30,"د",1,0],["وعترتُه الغرُّ الهداةُ ومن لهم","مَناقبُ لا تَفنى وإِن فَنيَ الدهرُ",31,"ر",1,0],["وَعُتبةُ السلميُّ لَم يزل عبقاً","بِالطيب مُذ مَسَحته مِن شرىً يرمُ",32,"م",1,0],["وَعِتاقُ الأَحبابِ يَشغَلُ عَنهُ","هِمَّةٌ هَمُّها عِناقُ السُيوفِ",33,"ف",1,0],["وَعَتبي لِلزَمانِ بِغَيرِ ذَنبٍ","كَما عُتِبَ الصَباحُ مِنَ البَصيرِ",34,"ر",1,0],["وعُترةِ خيرِ الورى من قضَى","سعيداً على مَنهج المرْتَضَى",35,"ض",2,0],["وعُترتِه الهداة الغُرّ حقّاً","جميعاً ما تَعاقبتِ الدَهورُ",36,"ر",1,0],["وعتَبْتَه فأنَلْتَه","شرَفاً ومجداً لن يُنالا",37,"ل",2,0],["وعت الأزهار في ظل دوحها","فيا حبذا عرف من النشر فائح",38,"ح",1,0],["وعترته القادة التابعين","بحور النوادي أسود الجلاد",39,"د",1,0],["وعترته أَولي الشرف الرفيع","صلاة منك تمحو السيئات",40,"ت",1,0],["وعَتوا وكلّ عزيزِ قو","مٍ تحت أرجلهم مهانُ",41,"ن",1,0],["وعتبٌ طال والأيامُ صُمٌّ","كما يشكو إلى الموج الغريقُ",42,"ق",1,0],["وعتادي الذي به ادرأ الأعدا","ء عن حوزتي وأردي الحسودا",43,"د",2,0],["وعَتبي على دهري قديمٌ وكلَّما","تقادمَ داءٌ فهوَ لا شكَّ قاتل",44,"ل",1,0],["وعتبنا الأيام بعدُ وما تز","داد إلا حقداً علينا وضغنا",45,"ن",2,0],["وعتاقُ الجيادِ وهيَ بحارٌ","تتبارى ما بين سخٍّ ومزع",46,"ع",1,0],["وعِتادي وحُجَّتي وعِمادي","وظَهيري وناصِري ووَلِيِّي",47,"ي",1,0],["وعتابي بالصّفح عم","مَن جنى كان أبلغا",48,"غ",2,0]]}