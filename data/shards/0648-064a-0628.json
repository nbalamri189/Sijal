ر"],[558,"كل شيء هو خيط أسود","https://www.aldiwan.net/poem34592.html","الرمل"],[559,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"],[562,"تذكرت صفو زمان عبر","https://www.aldiwan.net/poem52831.html","المتقارب"],[575,"لقد عفت عيشي بعد العفيف","https://www.aldiwan.net/poem2791.html","المتقارب"],[575,"تنزه طرفي بين زاه وزاهر","https://www.aldiwan.net/poem3073.html","الطويل"],[575,"دنوت وقد أبدى الكرى منه ما أبدى","https://www.aldiwan.net/poem3082.html","الطويل"],[586,"ويحمر شقيقها خجلا","https://www.aldiwan.net/poem18011.html","مجزوء الوافر"]],"verses":[["وَيَبقى عَلى رَيبِ الزَمانِ لَهِنَّهُ","عَلى ذي اللَيالي هَيِّناً لَكَريمُ",0,"م",1,0],["وَيَبدَأُ فيها لِلسِرابِ زَخارِفٌ","تُلاعِبُ لَحظَ المُجتَلي وَتُخادِعُ",1,"ع",1,0],["وَيُبكيني تَذَكُّرُهُ","فَيا لَهَفي عَلى نَجدِ",2,"د",1,0],["ويَبْسُطونَ بالنّوالِ أيْدياً","منها أفاويقُ الثّراءِ تُمْتَرى",3,"ا",1,0],["ويَبْسُطُ كفّاً للندىً أُمَويّةً","تُباري شآبيبَ الغَمامِ المُنَضَّدِ",4,"د",1,0],["وَيَبني بِحَدِّ السَيفِ مَجداً مُشَيَّد","عَلى فَلَكِ العَلياءِ فَوقَ الكَواكِبِ",5,"ب",1,0],["ويَبْلُغُ غاياتِ المُنى وهْوَ وادِعٌ","ويعْقِدُ في الأعْناقِ بيضَ أيادي",6,"ي",1,0],["ويبْدو لعَيْني شعْرُهُ وجَبينُهُ","إذا ما سَفَحْتَ الحِبْرَ في صَفْحِ قِرْطاسِ",7,"س",1,0],["وَيَبعُدُ بَيتُ المَرءِ عَن دارِ قَومِهِ","فَلَن يَعلَموا مُمساهُ إِلّا تَحَسُّبا",8,"ب",2,0],["ويُبْدِي مَا بِهِ إِبْدَاءَ صِدْقٍ","مِنَ الإِجْلالِ لِلْمَوْلَى العَظِيمِ",9,"م",1,0],["وَيَبْذُلُ جَاهِداً فِيهِ قُواهُ","لإِصْلاحٍ خَصِيصٍ أَوْ عَمِيمِ",10,"م",1,0],["وَيَبُثُّ الوَلاَءَ فِي تَهْئِنَاتٍ","فَضَّ عَنْ طِيبِهُنَّ خَتْمُ الغَوَالِي",11,"ي",1,0],["ويبلغ الأوطار","مقامك الأرضا",12,"ض",2,0],["ويبكيه معمورُ البسيطة كلَّها","وما ضم من داني البلاد وقاصيها",13,"ي",3,0],["ويَبرك أحياناً على الأرض رازحاً","له أنّةٌ من ثِقل ما قد تحملا",14,"ل",2,0],["ويَبُزّ في ثوب الأمانة خائن","كأبي براقش طبعه المرفوض",15,"ض",1,0],["وَيُبغِضُ سِترُ البَيتِ آلَ مُجاشِعٍ","وَحُجّابُهُ وَالعابِدُ المُتَطَوِّفُ",16,"ف",1,0],["ويبتذل النفس المصونة نفسَه","إذا ما رأى حقاً عليه ابتذالها",17,"ل",3,0],["ويبلغُ سُخنُها الاقدام منكم","إذا أرتَانِ هيجتا أرينا",18,"ن",2,0],["ويَبلُغُ شُخبُها الأَقدَامَ منكُم","إِذَا أرتَانِ هَيَّجَتَا إِرِينَا",19,"ن",2,0],["ويبثُّ ما يلقاه من ألم الجوى","قلبي وأنتِ الصعدةُ الصمَّاء",20,"ا",2,0],["ويبتاع لكن بالنفيس غوالياً","من الحمدِ إلا أنه عاطر النشر",21,"ر",1,0],["ويبعث كتبه في كلّ روعٍ","كتائب نقعها شكل السطور",22,"ر",1,0],["ويبعث من دهم السطور إلى العلى","محجلة في طيِّ أدراجه غرَّا",23,"ر",2,0],["ويبلعُ أفلاذَ الحديدِ جوامداً","فيسْكبها في قعرِ كيرٍ قد احتدمْ",24,"م",1,0],["وَيَبينَ لي كَنَهُ المَهابَةِ في الرُبى","وَالسِرُّ في جَذَلِ الغَديرِ الجاري",25,"ي",1,0],["وَيَبقى بِهِ ذِكرى إِذا غالَني الرَدى","حَسبُ الفَتى ذِكرٌ يَدومُ إِلى الحَشرِ",26,"ر",1,0],["وَيَبيعُها بِدَراهِمَ مَعدودَةٍ","وَلَوَ اِنَّها جاءَت مِنَ الخَنّاسِ",27,"س",1,0],["وَيَبعَثُ الحَقلُ إِلَينا الشَذى","وَنَحنُ لا نَنشُقُ إِلّا الرَغام",28,"م",1,0],["وَيَبكي أُخوَةٌ قَد غِبتَ عَنهُم","وَأُمٌّ تَأكُلُ وَأَبٌ حَزينُ",29,"ن",1,0],["وَيَبكي صاحِبي فَإِخالُ أَنّي","أَنا الجاني وَإِن لَم يَتَّهِمني",30,"ي",1,0],["وَيُبيحُ للتَعذيبِ في سَهَرِ الدُجى","طَرفَ المُحبِّ وَذاكَ مِن أَجنادِهِ",31,"د",2,0],["وَيَبتَذِلُ النَفسَ المَصونَةَ نَفسَهُ","إِذا ما رَأى حَقّاً عَلَيها اِبتِذالَها",32,"ه",2,1],["ويبعثَ فيها رَبيعَ الحَيَاةِ","ويُبْهِجُها بالصَّباحِ الفَرُوحْ",33,"ح",1,0],["ويبرم قبل الصبح امرا برغبة","وينقض قبل الصبح ما هو مبرم",34,"م",1,0],["ويبكي مع الباكي على ما أصابه","ويسعد بالمال الضعيف عن الكسب",35,"ب",1,0],["ويبيع الأثاث من ليس بالمث","رى ولكن حدا به التطفيل",36,"ل",1,0],["ويبعث نورُ العلم شعبا تضمه","من المجهلات الحالكات قبور",37,"ر",1,0],["ويبلغ البيت والقبر الذي دفنت","فيه المكارم خاليها وباقيها",38,"ي",3,0],["ويبلغ شاوها الأقصى رجال","لهم في الجهل قدر لا يسامى",39,"م",2,0],["وَيَبكي فَريقٌ تَخَيَّرتَهُ","شَريفَ المَرامِ شَريفَ الوَطَر",40,"ر",1,0],["وَيَبكي الأُلى أَنتَ عَلَّمتَهُم","وَأَنتَ غَرَستَ فَكانوا الثَمَر",40,"ر",1,0],["وَيَبكيكَ إِلفٌ فَوقَ لَيلى نَدامَةً","غَداةَ مَشى بِالعامِرِيِّ سَريرُ",41,"ر",1,0],["وَيَبقى الناسُ ما داموا رَعايا","وَيَبقى المُقدِمونَ هُمُ الرُعاةُ",42,"ه",1,0],["وَيَبيتُ الزَمانُ أَندَلُسِيّاً","ثُمَّ يُضحي وَناسُهُ أَعجامُ",43,"م",1,0],["وَيُبايِعونَكَ يا مُحَم","مَدُ في الضَمائِرِ وَالصُدور",44,"ر",1,0],["وَيَبينُ فيما مَسَّ مِنهُ بَنانُهُ","تيهُ المُدِلِّ فَلَو مَشى لَتَبَختَرا",45,"ر",2,0],["وَيَبقى عَلى مَرِّ الحَوادِثِ صَبرُهُ","وَيَبدو كَما يَبدو الفِرِندُ عَلى الصَقلِ",46,"ل",1,0],["وَيَبقى ضِعفُ ما قَد قيلَ فيهِ","إِذا لَم يَتَّرِك أَحَدٌ مَقالا",47,"ل",2,0],["وَيَبسِمنَ عَن دُرٍّ تَقَلَّدنَ مِثلَهُ","كَأَنَّ التَراقي وُشِّحَت بِالمَباسِمِ",48,"م",1,0],["ويبقى منه مافيه اجتماع","لشملن الخلط من جسد وراسِ",49,"س",1,0],["ويبُزُّ رَبَّ المُلْكِ قُلَّةَ أمنِهِ","حتى ينوءَ بركنِه المتضَعْضِعِ",50,"ع",1,0],["ويُبْلِغُه الإقبالُ ما هو ضَامِنٌ","ويُنْجِزُ فيه الجَدُّ ما هو واعدُ",51,"د",1,0],["وَيُبدي الرَضا في حالَةِ السُخطِ لِلعِدى","وَقورٌ مَتى يَقدَح بِزَندَيهِ يُثقِبِ",52,"ب",1,0],["وَيَبيَضُّ وَجهاً لِلسُؤالِ وَأَحسَنُ ال","غُيومِ إِذا اِستَوفاهُ لَحظٌ صَبيرُها",53,"ر",3,0],["وَيَبتَدِرُ الراءونَ مِنهُ إِذا بَدا","سَنا قَمَرٍ مِن سُدَّةِ المُلكُ مُطلَعي",54,"ع",2,0],["وَيُبهِجُني أَلّا تُخِلَّ بِثَروَةِ","وَما ذاكَ إِلّا أَنَّ مالَكَ مالي",55,"ل",2,0],["وَيَبيتُ يَحلُمُ بِالمَكارِمِ وَالعُلا","حَتّى يَكونَ المَجدُ جُلَّ مَنامِهِ",56,"م",2,0],["وَيَبيتُ في حَرَجٍ وَيُصبِحُ هَمَّهُ","بَردَ الشَرابِ وَتارَةً يَتَهَوَّعُ",57,"ع",1,0],["وَيَبيتُ فيهِ مِنَ المَخافَةِ عائِذاً","أَلفٌ عَلَيهِ قَوانِسُ الأَبدانِ",58,"ن",1,0],["ويَبذُلُ لي في النَّومِ ما لو طَلَبْتُه","على يَقْظَةٍ مني ومنه تمنَّعا",59,"ع",2,0],["وَيَبقى بَينَنا قَذَعٌ وَتُلفَوا","إِذاً قَوماً بِأَنفُسِهِم أَساؤوا",60,"ا",1,0],["وَيَبُشُّ بِالتَرحيبِ عِندَ قُدومِهِ","وَيُقامُ عِندَ سَلامِهِ وَيُقَرَّبُ",61,"ب",1,0],["وَيُبدي البَأسَ لِلأَعداءِ كيلا","تُؤَنِّبَهُ الشَوامِتُ أَو تَعيبُ",62,"ب",1,0],["ويبيتُ يُحرَمهُ قتيلُ صبابةٍ","قَضَّى الحياةَ إلى ظلالِكَ يطمحُ",63,"ح",1,0],["ويبدي علاهُ من أسرّةِ وجهه","سناءَ نسيم الخير للمتوسّمِ",64,"م",1,0],["ويبقى على ما كان من قبل خَلْقِهِ","إلهٌ هَدى أهلَ الضّلالةَ بالرُّسلِ",65,"ل",1,0],["وَيَبْعَثُ مَنْ تحتَ التراب وفوقه","نشوراً إليه الفضل يا لك من فَضلِ",65,"ل",1,0],["ويَبعثَ اللَّه مِن جَوْفِ الثَّرى أُممَاً","كانتْ عظامُهُمُ تبلى وتَنتَهكُ",66,"ك",1,0],["وَيُبلْي غَيْرَ مُستَبقٍ حيَاةً","لِقَشْعَمِ شاهِقٍ مَيْتِ النهوضِ",67,"ض",1,0],["وَيُبدي الهَوى رَكبٌ هُداةٌ وَأَينَقٌ","بِهِنَّ عَلَينا في رِضاكِ هَوانُ",68,"ن",1,0],["وَيَبوحُ بِالسِرِّ المَصونِ وَبِالهَوى","يُدري لِيُعلِمَها بِما لَم تَعلَمِ",69,"م",1,0],["وَيَبيتُ تَحتَ جَوانِحي حُبٌّ لَها","لَو كانَ تَحتَ فِراشِها لَأَقَلَّها",70,"ل",3,0],["وَيَبسِمُ إيماضَ الغَمامَةِ إِذ سَمَت","إِلَيها عُيونُ الناسِ حَتّى اِستَهَلَّتِ",71,"ت",1,0],["وَيُبدي الحَصى مِنها إِذا قَذِفَت بِهِ","مِنَ البُردِ أَطرافَ البَنانِ المُخَضَّبِ",72,"ب",1,0],["ويَبْعَثُهمْ شُمَّ الأنوفِ أَعِزَّةً","يُقيمون من بُنيانهِ ما تهدّما",73,"م",2,0],["وَيُبْعَثُ وَحْدَهُ مِن بعدِ هذا","وَسُبحانَ الذي يَختارُ عَبْدَهْ",74,"د",2,0],["وَيَبيتُ جُلُّهُمُ يَكِتُّ كَأَنَّهُ","وَطبٌ يَكونُ إِناهُ بِالأَسحارِ",75,"ر",1,0],["وَيَبني المَجدَ راحِلُ آلِ لَأيٍ","عَلى العَوجاءِ مُضطَمِراً حَشاها",76,"ا",3,0],["وَيَبريهِ فَقَد أَضناهُ سُقمٌ","كَأَنَّ بِوَجهِهِ مِنهُ خَلوقا",77,"ق",2,0],["وَيَبيتُ يُنهِضُ زَفرَةً في صَدرِهِ","مِنّي فَإِن دَمِيَت جِراحي يُولَغِ",78,"غ",1,0],["وَيَبدو لَنا في المَنامِ الخَيالُ","بِما نَشتَهيهِ فَتُنفى الكُرَب",79,"ب",1,0],["ويُبْهِجُ أرضَ الزّاب بهجةَ سؤددٍ","وتُبْهِجُه أفوافُ زَهْرٍ وتُونِقُه",80,"ق",2,0],["وَيُبدي لَنا مِن جَوفِها مَسُّ مَزجِها","كَأَلسِنَةِ الحَيّاتِ تَبدو مِنَ الذُعرِ",81,"ر",1,0],["وَيَبيتُ بَينَ جَوانِحي وَجدٌ بِها","لَو باتَ تَحتَ فِراشِها لَأَقَلَّها",82,"ه",2,0],["وَيَبلى المُحَيّا فَلا ضاحِكٌ","إِذا سَرَّ دَهرٌ وَلا عابِسُ",83,"س",1,0],["وَيُبدي لِدُنياهُ الفَتى وَجهَ ضاحِكٍ","وَما فَتِئَت تُبدي لَهُ وَجهَ عابِسِ",84,"س",1,0],["وَيبَ الحَوادِثِ كَم أَخرَجنَ مِن مَلِكٍ","عَنِ الدِيارِ وَكَم قَصَّرنَ مِن أَمَلِ",85,"ل",1,0],["وَيَبتِرَيانِ العَظمَ وَالنَحضَ ذائِباً","لِيَنتَقِياهُ وَالأَديمَ يَعِطّانِ",86,"ن",1,0],["وَيبَكُم إِن رَأَيتُمونِيَ يَوماً","حَبَّةً في الثَرى فَلا تَلقِطوني",87,"ن",2,1],["وَيَبتَزُّ فيهِ المَرءُ بَزَّ إِبنِ عَمِّهِ","رَهِيناً بِكَفَّي غَيرِهِ فَيُشاعِبُ",88,"ب",1,0],["وَيُبقِي وَجِيفُ الأَربَعِ السُودِ جَوزَهُ","كَما بُنِيَ التَابُوتُ أَجوفَ مُجفَرا",89,"ر",2,0],["وَيُبقي وَجيفُ الأَربَع السودِ لحمَهُ","كَما بُنِيَ التابوتُ أَحزَمَ مُجفَرا",90,"ر",2,0],["ويبتدرُ النجمَ في أفقه","فيرشُفُهُ قطرةً من ضِياء",91,"ا",2,0],["ويُبْعثُ في الحياةِ على صداها","فراعنُ أو حواريُّون عُرْبُ",92,"ب",1,0],["ويبين من غضب النفوس وصفوها","مثل الحياة كآبة ومراحا",93,"ح",2,0],["ويَبْكي رِقَّةً لكَ كلُّ نَوْْءٍ","فتَمْلأ مِن مَدامِعِهِ المَزادا",94,"د",2,0],["وَيَبني بِحَدِّ السَيفِ مَجداً مُشَيَّداً","عَلى فَلَكِ العَلياءِ فَوقَ الكَواكِبِ",95,"ب",1,0],["وَيَبصُرني الشُجاعُ يَفِرُّ مِنّي","وَيَرعَشُ ظَهرُهُ مِنّي وَيَسري",96,"ي",1,0],["وَيَبْغِي لأُمَّتِهِ خَيْرَ مَا","يَرُومُ الحَكِيمُ الَّذِي يَحْكُمُ",97,"م",1,0],["وَيَبْنِي الصُّرُوحَ لِعَليَائِهَا","بِنَاءً عَلَى الدَّهْرِ لا يَهْدَمُ",97,"م",1,0],["وَيَبْنِي لهُ مجْداً ويُضْحِي بِجِدِّهِ","مِنَ النفر الأَعِلينِ في الشَّرْقِ منزِلاَ",98,"ل",2,0],["وَيُبَارِكُ المَوْلَى لَهُ فِي عَهْدِهِ","وَيَدُمْ مَآثِرُهُ عَلَى الأَدْهَارِ",99,"ر",1,0],["وَيَبْعَثُ فِي شَبَابِ العَصْرِ رُوحاً","وَخَلَّفَ شُقْة دُونَ المُصَلِّي",100,"ي",1,0],["ويَبْدُو جَبِينُ الصُّبْحِ وَهْوَ مُعَصَّبٌ","بِتَاجٍ كَأَنَّ التِّبْرَ فيهِ مُخَضَّلُ",101,"ل",1,0],["وَيَبْسِمُ وَجْهُ الغُوْرِ مِنْ رِقَّةٍ لَهَا","وَمَا تَحتَهُ إِلاَّ دُجىً وَقُطُوبُ",102,"ب",1,0],["وَيَبْحَثُ عَمْا يُفْقِدُ الجَهْلُ أَهْلَهُ","فَيُهْدِي إِلَيْهِمْ زِينَةً وَثَرَاءَ",103,"ا",2,0],["وَيَبسِمُ عَن ثَغرٍ يَقولونَ أَنَّهُ","حَبابٌ عَلى صَهباءَ بِالمِسكِ تَنفَحُ",104,"ح",1,0],["وَيُبقي اللَبيبُ لَهُ عُدَّةً","لِوَقتِ الرِضا في أَوانِ الغَضَب",105,"ب",1,0],["ويَبْكِي فَيُبكي رُسومَ الديارِ","حَنَاناً عَليه وآثارها",106,"ر",3,0],["ويبش في وجهي، فأهمس قائلاً:","سبحان من خلق الجبال وصورا!",107,"ر",2,0],["ويبلغ في برودته","مئاتٍ عقبَ الصفْر",108,"ر",1,0],["ويبلغ غايات المنى وهو وادع","ويعقد في الأعناق بيض أياد",109,"د",1,0],["ويبدو مداه فيمضي العنيد","يحاول أن يسبق الأعندا",110,"د",2,0],["ويبتهج القصر في ظلّه","وينتحب الكوخ والمعدم",111,"م",1,0],["ويبنون دورا بأنقاض ما","أبادوا من الشعب أو هدّموا",112,"م",3,0],["ويبعث في الحياة على صداها","فراعين أو حواريّون عرب",113,"ب",1,0],["ويبعثَون قِتالاً أنَّ \" قُبَّرةً \"","ضيمَت وأن \" بَسوساً \" ذيلُها قُطِعا",114,"ع",2,0],["ويُبْرِدُ نَفسي بأنفاسهِ","إذا لَفَّني عاصفٌ يَلْفَح",115,"ح",1,0],["وَيَبْتَدِرُ الرّاءونَ منهُ، إذا بَدَا،","سَنَا قَمَرٍ من سُدّةِ المِلْكِ مُطلَعِ",116,"ع",1,0],["ويبعثه حبّي وفي كلّ خافق","صحيح الهوى بعث الأحبّة والنشر",117,"ر",1,0],["ويبده بالسقيا على غير موعد","فما هي إلاّ لمحة وتصبّبا",118,"ب",2,0],["ويبكيك صفصاف الشام ووردها","ويبكيك زهرُ الغوطتين ، ودُمَّرُ",119,"ر",1,0],["ويبكي لأمنحَهُ موعِدَا ..","شراعٌ أنا .. لا يطيقُ الوصولَ",120,"ل",1,0],["وَيَبْغُونَ طُرّاً بَغْيَهَا وَفَسَادَهَا","سَوَاءٌ لَدَيْهِمْ بِالحَرَامِ وَبِالحِلِّ",121,"ل",1,0],["وَيَبُوحُ بِکلسِّرِّ المَصُونِ، وبِکلهَوَى","يُدْري، لِيُعْلِمْهَا بِمَا لَمْ تَعْلَمِ",122,"م",1,0],["ويبكي فريقٌ تحيرته","شَريفَ المَرامِ، شَريفَ الوَطَر",123,"ر",1,0],["ويبكي أخوة قد غبت عنهم","وأمّ ثاكل وأب حزين",124,"ن",1,0],["وَيُبدي لَنا مِن قَلبِهِ الشَمس في الضُحى","وَيَطلَع فيها أَنجُماً بَعدَ أَنجُم",125,"م",1,0],["وَيَبسم ثَغرَهُ عَن اِقحوان","وَيَجلو خَدَهُ وَرداً وَآسا",126,"س",2,0],["ويبرز عاذلي بك لي مسيئا","بروز الشيخ في طور الغلام",127,"م",1,0],["ويبكي لي الصخر الاصم ترحما","ويشملني بالعدل من طبعه العذل",128,"ل",1,0],["ويبرز نور النصر من حضرة العلى","فتحصل آمالي ويعذب موردي",129,"ي",1,0],["ويبعث من سواد الطرف عضبا","ولست بجاهل بيض الصفاح",130,"ح",1,0],["ويبرز الحق منصورا وياخذ من","سفاسف القوم اهل الطيش ثارات",131,"ت",1,0],["ويَبْعَثُ مِنْ تحتِ التُّرابِ روائعًا","فأصبحَ للإبداعِ والشِّعرِ راعِيا",132,"ي",2,0],["ويَبقى المَلا ذاهِلين","فَطُوبى لعقلٍ عَرَف",133,"ف",1,0],["ويبثَّ في قلبي الحرارة بالقُبَل","ويقودني في إثرِهِ نحو الأمل",134,"ل",1,0],["ويَبِينُ لي فجرُ الرجاء","ونُورُه أملٌ ووعدُ",135,"د",1,0],["ويَبيتُ يَهتِفُ بالثُّبور","يَشكو اليك وَتشمتِين",136,"ن",1,0],["وَيَبقى بَعدَ حِلمِ القَومِ حِلمي","وَيَفنى قَبلَ زادَ القَومِ زادي",137,"ي",1,0],["ويبسم حين يبسم ويبدى","بأشنيه المنصب أقحوانا",138,"ن",2,0],["وَيُبدَلُ إبدَالاً رآهُ الأُلى مَضَوا","نُحَاةً ثَقِيلاً مَالَهُ مِن تَخفُّفِ",139,"ف",1,0],["ويَبكِى القُرَانُ وَيبكِى القِرَى","وتَبكِى عَلَيهِ القُرَى والفَضَا",140,"ض",2,0],["وَيَبني لِأَبناءِ العَشيرَةِ صالِحاً","إِذا نَحنُ طُفنا في البِلادِ وَيُمهِدُ",141,"د",1,0],["ويبكيكَ التدبُّر والتروّي","وترثيك الشهامة والإباءُ",142,"ا",2,0],["ويبث بين الخلق غرَّ خلائق","بعظاته وينبه الأغرارا",143,"ر",2,0],["وَيَبقى عَلى الأَحسابِ مِنها مَياسِمٌ","وَتَنفَعُ إِذ لا يَنفَعُ المالُ وَالوُلدُ",144,"د",1,0],["وَيَبغي تَناوُلَهُ الحاسِدونَ","عَلى ما بِأَبواعِهِم مِن قِصَر",145,"ر",1,0],["وَيَبلُغُ مِن قَبلِ البُلوغِ إِلى مَدىً","تَعَذَّرَ أَدناهُ عَلى غَيرِهِ كَهلا",146,"ل",2,0],["وَيَبذُلُ دونَ الدينِ نَفساً نَفيسَةً","عَزيزٌ عَلى العَلياءِ أَن تُتَبَذَّلا",147,"ل",2,0],["وَيَبُثُّ مِن كَلِماتِهِ الفِقَرَ الَّتي","مَلَأَت قُلوبَ الحاسِديهِ كُلوما",148,"م",2,0],["وَيَبينُ لِلرُوّادِ أَبيَضَ ساطِعاً","لَولا تَدَفُّقُهُ لَظُنَّ جَهاما",149,"م",2,0],["ويبكيه الدجى إن نام عنه","بنو الدنيا ويبكيه الصباحُ",150,"ح",1,0],["ويبرز بعد ذاك على وقاحٍ","مطهمة تفوت الريح كهلا",151,"ل",2,0],["ويبحث في الأمصار عن كل مارق","ويرسل رسلا بعد رسل ويندب",152,"ب",1,0],["ويبقى عليكم شاهد بفضيحة","تدوم ويلقيها إلى الولد الأب",152,"ب",1,0],["ويبدو لكم غير الذي يعدونكم","بأن عذاب الله ليس بضائر",153,"ر",1,0],["ويبُدعُ في بابِ الضيِّافةِ مَذهباً","فرغفْانَهُ يُعطي وأَثمانَها يجبْي",154,"ي",1,0],["وَيَبسِمنَ عَن نَورِ الأَفاحِيِّ لَم يَزَل","يُغَذّى بِدَرّاتِ الذِهابِ الرَكائِكِ",155,"ك",1,0],["وَيَبتَلِي مُقلَتَيهِ بِالبُكا وَكَفى","بِمَن بَكى قَبلَنا ناهٍ لَو اِمتَثَلا",156,"ل",2,0],["ويُبصر فيها كلَّ مَلْكٍ مُقبِّلا","لَدَيْك الثَّرَى معْ كبره واعْتِجابه",157,"ب",2,0],["ويبدو له منك الكمالُ الذي حَوَى","مَحاسنَ لا تُحْصَى على أنه فَرْد",158,"د",1,0],["ويُبادِرَ الْحَجرُ العظيمُ ومالَه","غيرُ استل