i.ae/diwan/poem/55195","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54943","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55164","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55140","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54556","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54537","الطويل"],[70,"","https://poetry.dctabudhabi.ae/diwan/poem/5577","الطويل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/842","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54209","المتقارب"],[106,"صاحب ثقيل","https://www.poetsgate.com/ViewPoem.aspx?id=179530",""],[106,"حديث خرافة","https://www.poetsgate.com/ViewPoem.aspx?id=179406",""],[77,"لقد زالت اللأواء وارتفع الجهد","https://www.poetsgate.com/ViewPoem.aspx?id=33938",""],[90,"اليأس المنشود","https://www.poetsgate.com/ViewPoem.aspx?id=179218",""],[90,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=179239",""],[45,"سُقيتِ الغَوادِي من طُلُولٍ وأرْبُعِ","https://www.poetsgate.com/ViewPoem.aspx?id=31223",""],[99,"إليه في يوم ميلاده","https://www.poetsgate.com/ViewPoem.aspx?id=211910",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[31,"من عاشقٍ، كلفِ الفؤادِ، متيمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19047&r=&rc=310",""],[85,"قِفوا بالقبور نُسائِلْ عُمَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9605&r=&rc=95",""]],"verses":[["وَيَبقى عَلى رَيبِ الزَمانِ لَهِنَّهُ","عَلى ذي اللَيالي هَيِّناً لَكَريمُ",0,"م",1,0],["وَيَبدَأُ فيها لِلسِرابِ زَخارِفٌ","تُلاعِبُ لَحظَ المُجتَلي وَتُخادِعُ",1,"ع",1,0],["وَيُبكيني تَذَكُّرُهُ","فَيا لَهَفي عَلى نَجدِ",2,"د",1,0],["ويَبْسُطونَ بالنّوالِ أيْدياً","منها أفاويقُ الثّراءِ تُمْتَرى",3,"ا",1,0],["ويَبْسُطُ كفّاً للندىً أُمَويّةً","تُباري شآبيبَ الغَمامِ المُنَضَّدِ",4,"د",1,0],["وَيَبني بِحَدِّ السَيفِ مَجداً مُشَيَّد","عَلى فَلَكِ العَلياءِ فَوقَ الكَواكِبِ",5,"ب",1,0],["ويَبْلُغُ غاياتِ المُنى وهْوَ وادِعٌ","ويعْقِدُ في الأعْناقِ بيضَ أيادي",6,"ي",1,0],["ويبْدو لعَيْني شعْرُهُ وجَبينُهُ","إذا ما سَفَحْتَ الحِبْرَ في صَفْحِ قِرْطاسِ",7,"س",1,0],["وَيَبعُدُ بَيتُ المَرءِ عَن دارِ قَومِهِ","فَلَن يَعلَموا مُمساهُ إِلّا تَحَسُّبا",8,"ب",2,0],["ويُبْدِي مَا بِهِ إِبْدَاءَ صِدْقٍ","مِنَ الإِجْلالِ لِلْمَوْلَى العَظِيمِ",9,"م",1,0],["وَيَبْذُلُ جَاهِداً فِيهِ قُواهُ","لإِصْلاحٍ خَصِيصٍ أَوْ عَمِيمِ",10,"م",1,0],["وَيَبُثُّ الوَلاَءَ فِي تَهْئِنَاتٍ","فَضَّ عَنْ طِيبِهُنَّ خَتْمُ الغَوَالِي",11,"ي",1,0],["ويبلغ الأوطار","مقامك الأرضا",12,"ض",2,0],["ويبكيه معمورُ البسيطة كلَّها","وما ضم من داني البلاد وقاصيها",13,"ي",3,0],["ويَبرك أحياناً على الأرض رازحاً","له أنّةٌ من ثِقل ما قد تحملا",14,"ل",2,0],["ويَبُزّ في ثوب الأمانة خائن","كأبي براقش طبعه المرفوض",15,"ض",1,0],["وَيُبغِضُ سِترُ البَيتِ آلَ مُجاشِعٍ","وَحُجّابُهُ وَالعابِدُ المُتَطَوِّفُ",16,"ف",1,0],["ويبتذل النفس المصونة نفسَه","إذا ما رأى حقاً عليه ابتذالها",17,"ل",3,0],["ويبلغُ سُخنُها الاقدام منكم","إذا أرتَانِ هيجتا أرينا",18,"ن",2,0],["ويَبلُغُ شُخبُها الأَقدَامَ منكُم","إِذَا أرتَانِ هَيَّجَتَا إِرِينَا",19,"ن",2,0],["ويبثُّ ما يلقاه من ألم الجوى","قلبي وأنتِ الصعدةُ الصمَّاء",20,"ا",2,0],["ويبتاع لكن بالنفيس غوالياً","من الحمدِ إلا أنه عاطر النشر",21,"ر",1,0],["ويبعث كتبه في كلّ روعٍ","كتائب نقعها شكل السطور",22,"ر",1,0],["ويبعث من دهم السطور إلى العلى","محجلة في طيِّ أدراجه غرَّا",23,"ر",2,0],["ويبلعُ أفلاذَ الحديدِ جوامداً","فيسْكبها في قعرِ كيرٍ قد احتدمْ",24,"م",1,0],["وَيَبينَ لي كَنَهُ المَهابَةِ في الرُبى","وَالسِرُّ في جَذَلِ الغَديرِ الجاري",25,"ي",1,0],["وَيَبقى بِهِ ذِكرى إِذا غالَني الرَدى","حَسبُ الفَتى ذِكرٌ يَدومُ إِلى الحَشرِ",26,"ر",1,0],["وَيَبيعُها بِدَراهِمَ مَعدودَةٍ","وَلَوَ اِنَّها جاءَت مِنَ الخَنّاسِ",27,"س",1,0],["وَيَبعَثُ الحَقلُ إِلَينا الشَذى","وَنَحنُ لا نَنشُقُ إِلّا الرَغام",28,"م",1,0],["وَيَبكي أُخوَةٌ قَد غِبتَ عَنهُم","وَأُمٌّ تَأكُلُ وَأَبٌ حَزينُ",29,"ن",1,0],["وَيَبكي صاحِبي فَإِخالُ أَنّي","أَنا الجاني وَإِن لَم يَتَّهِمني",30,"ي",1,0],["وَيُبيحُ للتَعذيبِ في سَهَرِ الدُجى","طَرفَ المُحبِّ وَذاكَ مِن أَجنادِهِ",31,"د",2,0],["وَيَبتَذِلُ النَفسَ المَصونَةَ نَفسَهُ","إِذا ما رَأى حَقّاً عَلَيها اِبتِذالَها",32,"ه",2,1],["ويبعثَ فيها رَبيعَ الحَيَاةِ","ويُبْهِجُها بالصَّباحِ الفَرُوحْ",33,"ح",1,0],["ويبرم قبل الصبح امرا برغبة","وينقض قبل الصبح ما هو مبرم",34,"م",1,0],["ويبكي مع الباكي على ما أصابه","ويسعد بالمال الضعيف عن الكسب",35,"ب",1,0],["ويبيع الأثاث من ليس بالمث","رى ولكن حدا به التطفيل",36,"ل",1,0],["ويبعث نورُ العلم شعبا تضمه","من المجهلات الحالكات قبور",37,"ر",1,0],["ويبلغ البيت والقبر الذي دفنت","فيه المكارم خاليها وباقيها",38,"ي",3,0],["ويبلغ شاوها الأقصى رجال","لهم في الجهل قدر لا يسامى",39,"م",2,0],["وَيَبكي فَريقٌ تَخَيَّرتَهُ","شَريفَ المَرامِ شَريفَ الوَطَر",40,"ر",1,0],["وَيَبكي الأُلى أَنتَ عَلَّمتَهُم","وَأَنتَ غَرَستَ فَكانوا الثَمَر",40,"ر",1,0],["وَيَبكيكَ إِلفٌ فَوقَ لَيلى نَدامَةً","غَداةَ مَشى بِالعامِرِيِّ سَريرُ",41,"ر",1,0],["وَيَبقى الناسُ ما داموا رَعايا","وَيَبقى المُقدِمونَ هُمُ الرُعاةُ",42,"ه",1,0],["وَيَبيتُ الزَمانُ أَندَلُسِيّاً","ثُمَّ يُضحي وَناسُهُ أَعجامُ",43,"م",1,0],["وَيُبايِعونَكَ يا مُحَم","مَدُ في الضَمائِرِ وَالصُدور",44,"ر",1,0],["وَيَبينُ فيما مَسَّ مِنهُ بَنانُهُ","تيهُ المُدِلِّ فَلَو مَشى لَتَبَختَرا",45,"ر",2,0],["وَيَبقى عَلى مَرِّ الحَوادِثِ صَبرُهُ","وَيَبدو كَما يَبدو الفِرِندُ عَلى الصَقلِ",46,"ل",1,0],["وَيَبقى ضِعفُ ما قَد قيلَ فيهِ","إِذا لَم يَتَّرِك أَحَدٌ مَقالا",47,"ل",2,0],["وَيَبسِمنَ عَن دُرٍّ تَقَلَّدنَ مِثلَهُ","كَأَنَّ التَراقي وُشِّحَت بِالمَباسِمِ",48,"م",1,0],["ويبقى منه مافيه اجتماع","لشملن الخلط من جسد وراسِ",49,"س",1,0],["ويبُزُّ رَبَّ المُلْكِ قُلَّةَ أمنِهِ","حتى ينوءَ بركنِه المتضَعْضِعِ",50,"ع",1,0],["ويُبْلِغُه الإقبالُ ما هو ضَامِنٌ","ويُنْجِزُ فيه الجَدُّ ما هو واعدُ",51,"د",1,0],["وَيُبدي الرَضا في حالَةِ السُخطِ لِلعِدى","وَقورٌ مَتى يَقدَح بِزَندَيهِ يُثقِبِ",52,"ب",1,0],["وَيَبيَضُّ وَجهاً لِلسُؤالِ وَأَحسَنُ ال","غُيومِ إِذا اِستَوفاهُ لَحظٌ صَبيرُها",53,"ر",3,0],["وَيَبتَدِرُ الراءونَ مِنهُ إِذا بَدا","سَنا قَمَرٍ مِن سُدَّةِ المُلكُ مُطلَعي",54,"ع",2,0],["وَيُبهِجُني أَلّا تُخِلَّ بِثَروَةِ","وَما ذاكَ إِلّا أَنَّ مالَكَ مالي",55,"ل",2,0],["وَيَبيتُ يَحلُمُ بِالمَكارِمِ وَالعُلا","حَتّى يَكونَ المَجدُ جُلَّ مَنامِهِ",56,"م",2,0],["وَيَبيتُ في حَرَجٍ وَيُصبِحُ هَمَّهُ","بَردَ الشَرابِ وَتارَةً يَتَهَوَّعُ",57,"ع",1,0],["وَيَبيتُ فيهِ مِنَ المَخافَةِ عائِذاً","أَلفٌ عَلَيهِ قَوانِسُ الأَبدانِ",58,"ن",1,0],["ويَبذُلُ لي في النَّومِ ما لو طَلَبْتُه","على يَقْظَةٍ مني ومنه تمنَّعا",59,"ع",2,0],["وَيَبقى بَينَنا قَذَعٌ وَتُلفَوا","إِذاً قَوماً بِأَنفُسِهِم أَساؤوا",60,"ا",1,0],["وَيَبُشُّ بِالتَرحيبِ عِندَ قُدومِهِ","وَيُقامُ عِندَ سَلامِهِ وَيُقَرَّبُ",61,"ب",1,0],["وَيُبدي البَأسَ لِلأَعداءِ كيلا","تُؤَنِّبَهُ الشَوامِتُ أَو تَعيبُ",62,"ب",1,0],["ويبيتُ يُحرَمهُ قتيلُ صبابةٍ","قَضَّى الحياةَ إلى ظلالِكَ يطمحُ",63,"ح",1,0],["ويبدي علاهُ من أسرّةِ وجهه","سناءَ نسيم الخير للمتوسّمِ",64,"م",1,0],["ويبقى على ما كان من قبل خَلْقِهِ","إلهٌ هَدى أهلَ الضّلالةَ بالرُّسلِ",65,"ل",1,0],["وَيَبْعَثُ مَنْ تحتَ التراب وفوقه","نشوراً إليه الفضل يا لك من فَضلِ",65,"ل",1,0],["ويَبعثَ اللَّه مِن جَوْفِ الثَّرى أُممَاً","كانتْ عظامُهُمُ تبلى وتَنتَهكُ",66,"ك",1,0],["وَيُبلْي غَيْرَ مُستَبقٍ حيَاةً","لِقَشْعَمِ شاهِقٍ مَيْتِ النهوضِ",67,"ض",1,0],["وَيُبدي الهَوى رَكبٌ هُداةٌ وَأَينَقٌ","بِهِنَّ عَلَينا في رِضاكِ هَوانُ",68,"ن",1,0],["وَيَبوحُ بِالسِرِّ المَصونِ وَبِالهَوى","يُدري لِيُعلِمَها بِما لَم تَعلَمِ",69,"م",1,0],["وَيَبيتُ تَحتَ جَوانِحي حُبٌّ لَها","لَو كانَ تَحتَ فِراشِها لَأَقَلَّها",70,"ل",3,0],["وَيَبسِمُ إيماضَ الغَمامَةِ إِذ سَمَت","إِلَيها عُيونُ الناسِ حَتّى اِستَهَلَّتِ",71,"ت",1,0],["وَيُبدي الحَصى مِنها إِذا قَذِفَت بِهِ","مِنَ البُردِ أَطرافَ البَنانِ المُخَضَّبِ",72,"ب",1,0],["ويَبْعَثُهمْ شُمَّ الأنوفِ أَعِزَّةً","يُقيمون من بُنيانهِ ما تهدّما",73,"م",2,0],["وَيُبْعَثُ وَحْدَهُ مِن بعدِ هذا","وَسُبحانَ الذي يَختارُ عَبْدَهْ",74,"د",2,0],["وَيَبيتُ جُلُّهُمُ يَكِتُّ كَأَنَّهُ","وَطبٌ يَكونُ إِناهُ بِالأَسحارِ",75,"ر",1,0],["وَيَبني المَجدَ راحِلُ آلِ لَأيٍ","عَلى العَوجاءِ مُضطَمِراً حَشاها",76,"ا",3,0],["وَيَبريهِ فَقَد أَضناهُ سُقمٌ","كَأَنَّ بِوَجهِهِ مِنهُ خَلوقا",77,"ق",2,0],["وَيَبيتُ يُنهِضُ زَفرَةً في صَدرِهِ","مِنّي فَإِن دَمِيَت جِراحي يُولَغِ",78,"غ",1,0],["وَيَبدو لَنا في المَنامِ الخَيالُ","بِما نَشتَهيهِ فَتُنفى الكُرَب",79,"ب",1,0],["ويُبْهِجُ أرضَ الزّاب بهجةَ سؤددٍ","وتُبْهِجُه أفوافُ زَهْرٍ وتُونِقُه",80,"ق",2,0],["وَيُبدي لَنا مِن جَوفِها مَسُّ مَزجِها","كَأَلسِنَةِ الحَيّاتِ تَبدو مِنَ الذُعرِ",81,"ر",1,0],["وَيَبيتُ بَينَ جَوانِحي وَجدٌ بِها","لَو باتَ تَحتَ فِراشِها لَأَقَلَّها",82,"ه",2,0],["وَيَبلى المُحَيّا فَلا ضاحِكٌ","إِذا سَرَّ دَهرٌ وَلا عابِسُ",83,"س",1,0],["وَيُبدي لِدُنياهُ الفَتى وَجهَ ضاحِكٍ","وَما فَتِئَت تُبدي لَهُ وَجهَ عابِسِ",84,"س",1,0],["وَيبَ الحَوادِثِ كَم أَخرَجنَ مِن مَلِكٍ","عَنِ الدِيارِ وَكَم قَصَّرنَ مِن أَمَلِ",85,"ل",1,0],["وَيَبتِرَيانِ العَظمَ وَالنَحضَ ذائِباً","لِيَنتَقِياهُ وَالأَديمَ يَعِطّانِ",86,"ن",1,0],["وَيبَكُم إِن رَأَيتُمونِيَ يَوماً","حَبَّةً في الثَرى فَلا تَلقِطوني",87,"ن",2,1],["وَيَبتَزُّ فيهِ المَرءُ بَزَّ إِبنِ عَمِّهِ","رَهِيناً بِكَفَّي غَيرِهِ فَيُشاعِبُ",88,"ب",1,0],["وَيُبقِي وَجِيفُ الأَربَعِ السُودِ جَوزَهُ","كَما بُنِيَ التَابُوتُ أَجوفَ مُجفَرا",89,"ر",2,0],["وَيُبقي وَجيفُ الأَربَع السودِ لحمَهُ","كَما بُنِيَ التابوتُ أَحزَمَ مُجفَرا",90,"ر",2,0],["ويبتدرُ النجمَ في أفقه","فيرشُفُهُ قطرةً من ضِياء",91,"ا",2,0],["ويُبْعثُ في الحياةِ على صداها","فراعنُ أو حواريُّون عُرْبُ",92,"ب",1,0],["ويبين من غضب النفوس وصفوها","مثل الحياة كآبة ومراحا",93,"ح",2,0],["ويَبْكي رِقَّةً لكَ كلُّ نَوْْءٍ","فتَمْلأ مِن مَدامِعِهِ المَزادا",94,"د",2,0],["وَيَبني بِحَدِّ السَيفِ مَجداً مُشَيَّداً","عَلى فَلَكِ العَلياءِ فَوقَ الكَواكِبِ",95,"ب",1,0],["وَيَبصُرني الشُجاعُ يَفِرُّ مِنّي","وَيَرعَشُ ظَهرُهُ مِنّي وَيَسري",96,"ي",1,0],["وَيَبْغِي لأُمَّتِهِ خَيْرَ مَا","يَرُومُ الحَكِيمُ الَّذِي يَحْكُمُ",97,"م",1,0],["وَيَبْنِي الصُّرُوحَ لِعَليَائِهَا","بِنَاءً عَلَى الدَّهْرِ لا يَهْدَمُ",97,"م",1,0],["وَيَبْنِي لهُ مجْداً ويُضْحِي بِجِدِّهِ","مِنَ النفر الأَعِلينِ في الشَّرْقِ منزِلاَ",98,"ل",2,0],["وَيُبَارِكُ المَوْلَى لَهُ فِي عَهْدِهِ","وَيَدُمْ مَآثِرُهُ عَلَى الأَدْهَارِ",99,"ر",1,0],["وَيَبْعَثُ فِي شَبَابِ العَصْرِ رُوحاً","وَخَلَّفَ شُقْة دُونَ المُصَلِّي",100,"ي",1,0],["ويَبْدُو جَبِينُ الصُّبْحِ وَهْوَ مُعَصَّبٌ","بِتَاجٍ كَأَنَّ التِّبْرَ فيهِ مُخَضَّلُ",101,"ل",1,0],["وَيَبْسِمُ وَجْهُ الغُوْرِ مِنْ رِقَّةٍ لَهَا","وَمَا تَحتَهُ إِلاَّ دُجىً وَقُطُوبُ",102,"ب",1,0],["وَيَبْحَثُ عَمْا يُفْقِدُ الجَهْلُ أَهْلَهُ","فَيُهْدِي إِلَيْهِمْ زِينَةً وَثَرَاءَ",103,"ا",2,0],["وَيَبسِمُ عَن ثَغرٍ يَقولونَ أَنَّهُ","حَبابٌ عَلى صَهباءَ بِالمِسكِ تَنفَحُ",104,"ح",1,0],["وَيُبقي اللَبيبُ لَهُ عُدَّةً","لِوَقتِ الرِضا في أَوانِ الغَضَب",105,"ب",1,0],["ويَبْكِي فَيُبكي رُسومَ الديارِ","حَنَاناً عَليه وآثارها",106,"ر",3,0],["ويبش في وجهي، فأهمس قائلاً:","سبحان من خلق الجبال وصورا!",107,"ر",2,0],["ويبلغ في برودته","مئاتٍ عقبَ الصفْر",108,"ر",1,0],["ويبلغ غايات المنى وهو وادع","ويعقد في الأعناق بيض أياد",109,"د",1,0],["ويبعثَون قِتالاً أنَّ \" قُبَّرةً \"","ضيمَت وأن \" بَسوساً \" ذيلُها قُطِعا",110,"ع",2,0],["ويُبْرِدُ نَفسي بأنفاسهِ","إذا لَفَّني عاصفٌ يَلْفَح",111,"ح",1,0],["وَيَبْتَدِرُ الرّاءونَ منهُ، إذا بَدَا،","سَنَا قَمَرٍ من سُدّةِ المِلْكِ مُطلَعِ",112,"ع",1,0],["ويبكيك صفصاف الشام ووردها","ويبكيك زهرُ الغوطتين ، ودُمَّرُ",113,"ر",1,0],["وَيَبْغُونَ طُرّاً بَغْيَهَا وَفَسَادَهَا","سَوَاءٌ لَدَيْهِمْ بِالحَرَامِ وَبِالحِلِّ",114,"ل",1,0],["وَيَبُوحُ بِکلسِّرِّ المَصُونِ، وبِکلهَوَى","يُدْري، لِيُعْلِمْهَا بِمَا لَمْ تَعْلَمِ",115,"م",1,0],["ويبكي فريقٌ تحيرته","شَريفَ المَرامِ، شَريفَ الوَطَر",116,"ر",1,0]]}