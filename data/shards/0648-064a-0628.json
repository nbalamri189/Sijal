صي كأنّها","ذئابُ الفَلا تُردي عليها الضّراغِمُ",231,"م",1,0],["ويبطِشُ بطشَ جبَّار على أنْ","له جأشٌ يَفِرُّ من الصفير",232,"ر",1,0],["ويبلُّ غلَّةَ وامقٍ مستغرم","بالرّيّ من صادي الحشا ظمآنها",233,"ن",3,0],["ويبسط راحةً تنهلّ جوداً","أحبّ مكارم الكرماء وفدا",234,"د",2,0],["ويبلغه على البعد اشتياقاً","من الداعي إلى الشَّهم الهمام",235,"م",1,0],["ويبعث إملاؤه نشوةً","فيهدي السرور لنشوانها",236,"ن",3,0],["ويبتدي التعليل والمعلولُ","في نسقٍ إذ يبتدي أيلولُ",237,"ل",1,0],["ويبدو لنا من رقمه كل مطرف","نوادر انشاء أرق من السحر",238,"ر",1,0],["ويبسُط العُذْرَ عن مُقَصِّرِهِ","بطُولِ طَوْلٍ عليه مَمْدودِ",239,"د",1,0],["ويبتعدُ الأعارِب ناعماتٍ","ويستَدْني المُضمّرةَ العِرابا",240,"ب",2,0],["ويبقى ملجأً للناس طرّاً","وكهفاً للأقاصي والأداني",241,"ي",1,0],["ويَبْخَسُني الزمانُ ولو وَفى لي","بِحَظّي لاشتكى جُهْدَ المُقِلِّ",242,"ل",1,0],["ويَبْعَثْنَ الرَّغامَ إِلَى أُنوفٍ","وَقَدْ عَفَرَتْ أُنوفاً بالرَّغامِ",243,"م",1,0],["ويبكي وما إن له راحمٌ","وأدمعه أو كفت كالجساد",244,"د",1,0],["ويبكي عليك الدَهر والوَفد والقِرى","إِذا الليلة المشتاة أَثلجها القطر",245,"ر",1,0],["ويبكي عليك الندى والعلا","بدمع على الخد هام مراق",246,"ق",1,0],["ويبكي عليك صحيح الرجا","وآمال قوم عليك مناق",246,"ق",1,0],["ويبكيك ضيف آخر الليل طارق","طوى الكشح سعياً عن لذيذ المطاعم",247,"م",1,0],["ويبعث فينا نشوة بعد نشوة","وما نحن في سكر ولا نحن في وجد",248,"د",1,0],["ويبل حر جوانحى","من ماء كاظمة ببرد",249,"د",1,0],["ويباشرُ الأوطارَ إن جَمَحتْ على","طَرَفِ التمامِ فيستقيمِ جِماحُها",250,"ح",3,0],["ويبرأ من هذا وذلك مجرم","فمن يا ترى الجاني الذي ليس يبرأ",251,"ا",1,0],["ويبغضون فِكاكاً","من الطغاة الجناةِ",252,"ه",1,0],["ويبطىءُ الرمح الأصم","مُ فيخفُّ القلمُ",253,"م",1,0],["ويُبدِنُهُ عَرْقُ الهواجرِ لحمَهُ","وأسمنُ مجدٍ ما اقتناه هزالُ",254,"ل",1,0],["ويبيح السنَّ البنان إذا ما","غاله من ندامةٍ ما غالَهْ",255,"ل",2,0],["ويبين عندهم الإمامة نازعاً","فيها الحجاجَ من الكتاب المُنزَلِ",256,"ل",1,0],["ويبكي نازلُ الطُّرَّاق منّا","فيصبغها دموعاً من نجيعِ",257,"ع",1,0],["ويبرد من أعاديكم وشيكاً","زفيرُ جوانح بالهمّ رُمْضِ",258,"ض",1,0],["ويبلُغُ مني الوجد والشعر باسلٌ","ويأخذ مني الحب والحزمُ كاتمُ",259,"م",1,0],["ويبيتُ منهُ جارهُ وضيوفُهُ","رُغداً وأمْناً في حمىً ومَلاعبِ",260,"ب",1,0],["ويبعثُها رأدَ الضُّحى أسَديَّةً","تُغادر مُغْبَرَّ المَعارِكِ أحْمَرا",261,"ر",2,0],["ويَبعدُ بُعْدَ الشمس قدراً وإنه","إلى نُصْرة المُسْتصرخين قريبُ",262,"ب",1,0],["ويبْسِمُ والخطوبُ مُكَلِّحاتٌ","لها ظُفُرٌ تَصولُ به ونابُ",263,"ب",1,0],["ويبرد من عذرانه إثمد الدجى","حرار عيون هدبهن الخمائل",264,"ل",1,0],["ويبسم عن خمر عراني خمارها","تحول على درٍ عداني ثمينه",265,"ن",2,0],["ويبدو لنا من كأسه وجبينهُ","وطرَّتهِ في النجم والبدر والجنح",266,"ح",1,0],["ويبيتُ مسلوبَ الفؤادِ مولّهاً","مِمّا عراهُ مسهَّداً لا يَهجعُ",267,"ع",1,0],["ويبسط لي من كل حرف سرادق","وفيه أرى سر المواد الثلاثيه",268,"ي",2,0],["ويبرز سره أملي","ويطلع قوسه قُزَح",269,"ح",1,0],["وَيْبَ الليالي لقد ألفيتها غدراً","ويل الأماني لقد لاقيتها خدعا",270,"ع",2,0],["وَيَبِتنَ بِالثَغرِ المَخوفِ طَوالِعاً","وَيُثِبنَ لِلصُعلوكِ جَمَّةَ ذي الغِنى",271,"ا",1,0],["ويبعث الغرة من قلب القضا","فتصر الباغي وتحفظ الحمى",272,"م",2,0],["ويبدي لنا في سدرة العزِّ رونقاً","ويبلج في لوح السقيم جبالنا",273,"ن",2,0],["ويَبرُزُ من حُبابِ الكأْسِ نورٌ","فيقْذِفُ كلَّ شيْطانٍ رَجيمِ",274,"م",1,0],["ويبْرُزُ للميدانِ كلُّ مُلَثَّمٍ","بسِبْقٍ ويُلوَى بالعَجاجِ مُهَيَّمُ",275,"م",1,0],["ويُبْهَتُ جاحدٌ ويُذَلُّ باغٍ","ويَتَّعِظُ المُخالِفُ والمُوافِقْ",276,"ق",1,0],["ويبْدو في زَمانٍ ذي شُؤُنٍ","وكلٌّ حسبَما يَنْويهِ يُجْزى",277,"ز",2,0],["ويُبْكي العينَ منهُ الهجرُ حتَّى","يمُدُّ سَحابُها السَّيَّالُ لُجَّا",278,"ج",2,0],["ويبيت بيت المال يشكو جورهم","مما يراق به دم ومدام",279,"م",1,0],["ويَبْقَى الأَمْرُ فيمَنْ قَالَ جَهْلاً","مَقالاً مَالَهُ فيهِ قُصُودُ",280,"د",1,0],["ويَبِينُ عِنْدَكَ فَضْلُ عَيْنٍ أَبْصَرَتْ","حَقّاً عَلَى عَيْنِ الْجَهُولِ الأَرْمَدِ",281,"د",1,0],["ويُبْعِدُني الْقَريبُ بلا احْتِشامٍ","ويِزْدادُ الْبَعيدُ مِنَ البعادِ",282,"د",1,0],["ويَبْعُدُ إنْ رَامَ الْقَريبُ فِراقَها","ويَقْرُبُ إنْ مَا أَلْسُنُ الْعَذْلِ لَجّتِ",283,"ت",1,0],["ويبذُلُ في إرضائِهِم كلَّ جَهدِه","وَفاءً وإخلاَصا لِمَولاَه نَامِيا",284,"ي",2,0],["ويُبْصَرْنَ من بعد الكَلالِ نواحلاً","وقد كنّ من قبل الرّحيلِ توامكا",285,"ك",2,0],["ويبلغ مِنِّي ما يشاء من الهوى","وما أنا شيئاً من هواي ببالغِ",286,"غ",1,0],["وَيَبيت يحرسُهُ وإن دفعتْ","عنه الكرامُ الطِّفْلُ والعبْدُ",287,"د",1,0],["وَيَبكِكَ شاعِرٌ لَم يُبقِ دَهرٌ","لَهُ نَشَباً وَقَد كَسَدَ القَصيدُ",288,"د",1,0],["ويبقى ولا تبقى إلهك وحده","له الخلق والأمر الجميع به انفلق",289,"ق",1,0],["ويبطل كل شيء كان حتى","مقالي ذا وفهمي مع مذاقي",290,"ي",1,0],["ويبقى مثل ما قد كان ربي","على ما كان وهو أجل واقي",290,"ي",1,0],["ويبات الآن كلي عنده","حيث لا عندَ لكلي يوجد",291,"د",1,0],["ويُبْصر عبْداً عنْد طورِ بقائِهِ","ويرجِع موْلى بالفَنا وهوَ لا يَفْنى",292,"ن",2,0],["ويبحث عن أسباب ما قد سمعتم","وبالبحث غطى العين إذ رده غينا",292,"ن",2,0],["ويَبغِي لألفاظِهِ رِقّةً","كما تَبتغِي شُعَراءُ الحَضَرْ",293,"ر",1,0],["ويبكي عليكَ فَمِي بالقَريضِ","إِذا قلَّ مِنْ مقلتيَّ البُكَاءُ",294,"ا",2,0],["ويَبْغُون ما حاولْتُ مِنْه بجَهلهم","وهزُّ الْعَوالي غيرُ هَزِّ المْخَاصِر",295,"ر",1,0],["ويبصرُ جَدّاً يَحْسُدُ الإِبنُ جَدَّه","عَليه فأَعْلَى رَبه ذلك الجَدَّا",296,"د",2,0],["وَيَبْدُو حُسْنُهَا خَضِراً","وَيَبْدو زَهْرُهَا خَضِلا",297,"ل",2,0]]}