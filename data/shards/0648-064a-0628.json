","شٍ بِالفُجورِ مُوَطَّدِ",183,"د",1,0],["وَيَبيتُ هَذا في مَقا","مِ الخاشِعِ المُتَهَجِّدِ",183,"د",1,0],["وَيَبعَدُ خَيرُكُمُ إِن دَنَوتُ","عَنّي وَالشَرُّ لا يَبعَدُ",184,"د",1,0],["وَيَبْلُغُ حُسْنُهَا أَقْصَاهُ","وَيَخْلُفُ ذُلَّهَا الْعِزُّ",185,"ز",1,0],["ويُبْرِئُ قَلْبِيَ مِنْ سُقْمِهِ","بِلَسْعِ الأَسَى شَدْوُهُمْ إِنْ شَدَوْا",186,"و",2,0],["وَيُبْهِجُهُ التَّهَانِي بِالأَمَانِي","وَإِبْقَاءُ الْغَلِيِّ عَلَى الْوَلِيِّ",187,"ي",1,0],["ويبرزُ من ثوبها ساقُها","دقيقاً فأهوى الثيابَ القِصارا",188,"ر",2,0],["وَيبنى دون دين اللَه سورا","بيوت علا مسامية القباب",189,"ب",1,0],["وَيبكى غمام الغيث طوعا لامره","فتَضحَك مِمّا يَفعَل الغَيث أَزهار",190,"ر",1,0],["ويَبيتُ بَينَ تَشَوُّقٍ يَقْتَادُهُ","وَلَعاً وبَيْنَ تأرُّقٍ يَعْتَادُهُ",191,"د",2,0],["وَيَبلُغُ ما يَهواهُ في كُلِّ مَأزِقٍ","وَلا هُزَّ عَسّالٌ وَلا سُلَّ مِخذَمُ",192,"م",1,0],["وَيَبسِمُ عَن أَقاحٍ فَوقَ راحٍ","وَعَن حبَبِ الكُؤسِ وَعَن لَآلِ",193,"ل",1,0],["وَيُبدينَ من غرِّ الوجوه أَهلَّةً","وَينشُرنَ من سود الفروع لَياليا",194,"ي",2,0],["وَيَبكي بطَرفٍ يمتَري الشَوقُ دمعَهُ","إذا ما شدَت ورقٌ عَلى فنني رندِ",195,"د",1,0],["ويبصر المحبوب من نورها","شيئاً فيخرجه من الظلم",196,"م",1,0],["وَيَبرُد حرا بِالهَجير يَمده","سُموم إِذا هاجَت تزعزع للكتب",197,"ب",1,0],["وَيبدلَ عسراً قَد دَهاهم وشدّةً","بِيسرٍ وتنفيسٍ يعمّانها منّا",198,"ن",2,0],["وَيبلغَ كلّاً ما ترجّاه راغباً","مِنَ الفوزِ في الدارِ منَ المقصد الأسنى",198,"ن",2,0],["ويبكونهُ عندَ المماتِ جهالَةً","ومن حقهِ إظهار كُلِّ مسرَّةِ",199,"ه",1,0],["ويبلغ منه الجهل ما ليس يبلغ","العدو بحد السيف عند الحضيضة",200,"ه",1,0],["ويبكونه عند الممات جهالة","ومن حقه أطهار كل مسرة",200,"ه",1,0],["ويبدي أولا منه وآخر","فقد شف جسمي سر عودٍ وبدأةٍ",200,"ه",1,0],["وَيُبعِدُ عَنهُ ما اِستَطاعَ تَحَرُّزاً","وَتَجمَعُ الأَيّامُ وَالزَمَنُ النَكَدُ",201,"د",1,0],["ويبكون كثيرا","ظنه الناس قليلا",202,"ل",2,0],["ويبيحون ما الضمائر تأبا","ه وعقل الغوِيِّ مثل اليباب",203,"ب",1,0],["ويبتغي حجباً","فتسدل الحجب",204,"ب",1,0],["ويبكي عليك الوفاء الجميل","وقلبي عليك أخي موجع