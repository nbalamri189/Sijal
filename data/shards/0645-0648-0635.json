{"poems":[[90,"كل ما في البلاد من أموال","https://www.aldiwan.net/poem44984.html","الخفيف"],[47,"إليك ما أنا من لهو ولا طرب","https://www.aldiwan.net/poem10655.html","البسيط"],[63,"عفر الظباء لدى الكثيب الأعفر","https://www.aldiwan.net/poem51686.html","الكامل"],[50,"الدار أطبق إخراس على فيها","https://www.aldiwan.net/poem66195.html","البسيط"],[111,"مدد الحق للقلوب الصواردي","https://www.poetsgate.com/ViewPoem.aspx?id=528",""],[185,"يا للرجال هوى أميمة قاتلى","https://www.aldiwan.net/poem58883.html","الكامل"],[276,"طيف الخيال من النيابتين سرى","https://www.aldiwan.net/poem52115.html","البسيط"],[276,"لكل خطب مهم حسبي الله","https://www.aldiwan.net/poem52129.html","البسيط"],[354,"لبيت لما دعتني ربة الحجب","https://www.aldiwan.net/poem15534.html","البسيط"],[354,"بدت لعيني بالستور والكلل","https://www.aldiwan.net/poem15861.html","الرجز"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101474","الكامل"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146221","المجتث"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48676","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48690","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56182","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64543","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69330","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71066","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47175","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47172","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47193","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106856","البسيط"],[2583,"","https://poetry.dctabudhabi.ae/diwan/poem/128118","الرمل"],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3569,"","https://poetry.dctabudhabi.ae/diwan/poem/105827","الرجز"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78295","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72573","السريع"],[585,"تلك القبور وماثل الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=161873",""],[5956,"الحمد لله حمداً لا يفارقني","https://www.poetsgate.com/ViewPoem.aspx?id=193794",""],[6142,"حضن الطفل جده شيبة الحم","https://www.poetsgate.com/ViewPoem.aspx?id=155705",""]],"verses":[["موصلات إلى السعادة في العي","ش هوادٍ إلى طريق التعالي",0,"ل",2,0],["مَوصوفَةٍ بِاللَآلي مِن نَوادِرِها","مَسبوكَةِ اللَفظِ وَالمَعنى مِنَ الذَهَبِ",1,"ب",1,0],["موصولةً بشمائلِ الأدبِ التي","إن فاخَرَتْ جاءَتْ بأفضلِ مَفْخَرِ",2,"ر",1,0],["مَوصوفَةٌ بِفُنونِ الطيبِ طالَ لَها","عُمرٌ فَلَم تَعدُ أَن رَقَّت حَواشيها",3,"ي",3,0],["موصل السالكين بالحق لل","حق ومجلي مشارق الامداد",4,"د",1,0],["مَوصُولةٍ بِتَنائفٍ مَوصُولةٍ","أَقطَارُهُنَّ بِسَبسَبٍ مُتَماحِلِ",5,"ل",1,0],["مَوصولة بسلام اللَه دائِمة","ما البرق من علويات الحجاز سرى",6,"ر",2,0],["موصولة بِسَلام اللَه دائمة","تؤتيه من نسمات المسك أَذكاه",7,"ا",2,0],["مَوصوفَةٌ لَم أَصِف إِلّا وَصيفَتُها","وَهيَ العَلِيَّةُ عَن نَظمي وَعَن خَطبي",8,"ب",2,0],["مَوصوفَةٌ بَينَ الوَرى وَحُسنُها","تَحتَ النُعوتِ وَالصِفاتُ ما دَخَل",9,"ل",1,0],["موصولةٌ بجوانحٍ","خفقَت على قلب عميد",10,"د",1,0],["موصَلٌ بذراعي","ه حَبْلُهُ المعقود",11,"د",1,0],["موصىً بمصرَ تلطُّفاً وتجمُّلاً","لا يحسبن لها سواك زعيما",12,"م",2,0],["موصي الممالك بالسماحة والندى","نقّادها ورقيبها وحسيبها",13,"ب",3,0],["موصّل الجد نجديٌّ مؤرّخه","مهما به قد نهى مدحاً فمقتصرُ",14,"ر",1,0],["موصولها الذي لوصل يفتقر","بجملة وعائد طبقا ذكر",15,"ر",1,0],["موصل الفيض باللطائف يا اللّه","يا اللّه صِل بفيضك وَصلي",16,"ل",2,0],["مَوصولَةٌ بِالجَوِّ تَحسَبُ ضوءَها","ساري الدُجُنَّةِ كَوكَباً أَو فَرقَدا",17,"د",2,0],["موصولةٌ بحبالها يبقى على","مرِّ الزمان وصَرْفِهِ إِمْرارُها",18,"ر",3,0],["موصىً بتقوى اللّه جلّ جلاله","وبدعوة تجلو عن القلب العمى",19,"م",2,0],["مُوصٍ كما أُوصيت بالتّقوى التي","أوصى بها القرآن نصّاً مُحْكَمَا",20,"م",2,0],["موصىً لإِبراهيمَ منه بدعوةٍ","يرجو الرّياحي بها أمان الخائف",21,"ف",1,0],["موصولةٌ بالأواخر","وهي بناءٌ تفردا",22,"د",2,0],["موصليّ الوعد كوفيِّ الوفا","يمنيُّ العهد شاميُّ الوقار",23,"ر",1,0],["موصدةٌ في عمدٍ ممدَّده","لكنها مذ وافقت تولده",24,"ه",1,0],["مَوصُولُ الأسماءِ الَّذى الأُنثَى الَّتِى","وَاليَا إِذَا ما ثُنِّيا لاَ تُثبِتِ",25,"ت",1,0],["موصدةٌ على الورى ابوابُها","كالنار لا يخرجُ منها من دَخَل",26,"ل",1,0],["مَوصول لُطفك لا أَفيكَ بِشُكرِه","صلتي اِلى نُعماكَ خَيرُ جَزائي",27,"ي",1,1],["مؤصدة كالنار في دنها","تسجد مهما شاهدتها المجوس",28,"س",1,0],["موصولة حجراتها بفنائها","نقراً على عمد لهن طوال",29,"ل",1,0],["مؤصَّلُ الجود والتقدير والفطن","لأنه من ثرى سيف بن ذي يزنِ",30,"ن",1,0],["موصياً بعده به عمه الند","ب أبا طالبٍ صليب العود",31,"د",1,0]]}