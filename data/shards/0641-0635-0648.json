poem/66097","المتقارب"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89584","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72471","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72480","البسيط"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4767,"راية الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=179929",""],[4862,"فصول الحب قد جاءت كغيثٍ","https://www.poetsgate.com/ViewPoem.aspx?id=135807",""],[4984,"يوم العلم","https://www.poetsgate.com/ViewPoem.aspx?id=180154",""],[4994,"رحيل رجل يشبهني","https://www.poetsgate.com/ViewPoem.aspx?id=208925",""],[5002,"رجع ُ الصَّدى....","https://www.poetsgate.com/ViewPoem.aspx?id=210619",""],[4119,"عن خاطري نبأ الخيال الخاطر","https://www.poetsgate.com/ViewPoem.aspx?id=16155",""],[5038,"الزّمان المرّ","https://www.poetsgate.com/ViewPoem.aspx?id=189330",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5050,"لشغلي بأهل الدهر إحدى العجائب","https://www.poetsgate.com/ViewPoem.aspx?id=38188",""],[585,"يا صاحب التاج ما للقوم في وصب","https://www.poetsgate.com/ViewPoem.aspx?id=161843",""],[585,"يا شيب إن أوان الشيب لم يحن","https://www.poetsgate.com/ViewPoem.aspx?id=161874",""],[5183,"لشيخ الشريعة","https://www.poetsgate.com/ViewPoem.aspx?id=180209",""],[5216,"إهداء لأبي القاسم الشابي","https://www.poetsgate.com/ViewPoem.aspx?id=186824",""],[5302,"والظبي راتع","https://www.poetsgate.com/ViewPoem.aspx?id=201661",""],[5305,"الاستسعاد بمدح سيد الأسياد","https://www.poetsgate.com/ViewPoem.aspx?id=187378",""],[592,"على قلة الداعي وقلة ذي الفهم","https://www.poetsgate.com/ViewPoem.aspx?id=128814",""],[5376,"للقدس آهٍ ولبغدادَ آهات","https://www.poetsgate.com/ViewPoem.aspx?id=188467",""],[5459,"لقاء بعد هجر ..","https://www.poetsgate.com/ViewPoem.aspx?id=197303",""],[5649,"ركب الخير","https://www.poetsgate.com/ViewPoem.aspx?id=39018",""],[5674,"روحي منك ترتشف","https://www.poetsgate.com/ViewPoem.aspx?id=197552",""],[5725,"ونالت من الروح ما لا ينال","https://www.poetsgate.com/ViewPoem.aspx?id=209167",""],[5771,"بطاقة زائر","https://www.poetsgate.com/ViewPoem.aspx?id=189060",""],[5776,"فراغُ الفهارس","https://www.poetsgate.com/ViewPoem.aspx?id=199333",""],[5853,"لماذا ..؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=175630",""],[5912,"أفعى","https://www.poetsgate.com/ViewPoem.aspx?id=202306",""],[5943,"بهيُّ الشِّعرِ","https://www.poetsgate.com/ViewPoem.aspx?id=34291",""],[6046,"فصل لربك وانحر","https://www.poetsgate.com/ViewPoem.aspx?id=36742",""],[6093,"ربابٌ ( الوافر)","https://www.poetsgate.com/ViewPoem.aspx?id=176208",""],[6102,"أُمنِياتٌ بَريئَة !!","https://www.poetsgate.com/ViewPoem.aspx?id=211861",""],[6147,"غضبة شعبي","https://www.poetsgate.com/ViewPoem.aspx?id=151695",""]],"verses":[["فَصَوِّر هاهُنا فَوزاً","وَصَوِّر ثَمَّ عَبّاسا",0,"س",2,0],["فصولي على مرّ الزّمانِ وفاخِري","بهَذا النّبيِّ الحالَ والقَبْلَ والبَعْدا",1,"د",2,0],["فَصَوَّتَ إِذ نادى بِباقٍ عَلى الطَوى","مُحَنَّبِ أَطرافِ العِظامِ هَبوعِ",2,"ع",1,0],["فَصُوائِقٌ إِن أَيمَنَت فَمَظِنَّةٌ","فيها وِحافُ القَهرِ أَو طِلخامُها",3,"م",3,0],["فَصَوَّرَ الفَضلَ مِن نَدىً وَحِجىً","وَأَنتَ مِن حِكمَةٍ وَتَوفيقِ",4,"ق",1,0],["فَصَوِّب مِنَ الإِبريقِ في الكَأسِ شُربَةً","يُعَلُّ بِها قَلبانِ مُختَلِفانِ",5,"ن",1,0],["فُصُولُهَا أَرْبَعَةٌ قُدِّرَتْ","مْنِ أَوَّلِ الدَّرْسِ إِلى الآخِرْ",6,"ر",1,0],["فَصَوَّرَتْ فِي ابْنَتِهَا نَفْسَهَا","وَفِي ابْنِهَا مَنْجَبَةُ الاصْيَدَا",7,"د",2,0],["فُصُولٌ عَلَى تَنوِيعِهَا اجْتَمَعَتْ بِهَا","إِلَى طُرَفٍ مِنْ كُلِّ ضَرْب فَوَائِدُ",8,"د",1,0],["فصول بدأناها، وسوف نعيدها","دواليْكَ، واللحنُ المكرَّرُ يُسأم",9,"م",1,0],["فصول في الهيجا بأسد لها","عزم بهذا الجبل الراسي",10,"س",2,0],["فصوني جمالك عن فتية","أبرهمُ قلبه يأثم",11,"م",1,0],["فَصَوتُكَ شِعرٌ يَجولُ بِفِكريَ","موحى مِنَ اللَهِ أَو مُنزَلُ",12,"ل",1,0],["فَصَوادي التُربِ مِن دَم","عِكَ قَد عُدنَ رَواءا",13,"ا",3,0],["فصوَّبتُم مدافعَكم إلينا","لترشُقَنا بأنواعِ الشظيِّ",14,"ي",1,0],["فَصَوَّبتُهُ كَأَنَّهُ صَوبُ غَبيَةٍ","عَلى الأَمعَزِ الضاحي إِذا سيطَ أَحضَرا",15,"ر",2,1],["فصوَّرَ هذا له الأَوّلِينَ","وَصَوَّرَهُ ذاك للآخِرينا",16,"ن",2,0],["فصَومُك صَومٌ عن تُقىً وهو الّذي","لدَى اللهِ يَزداد المُطيعُ به زُلَف",17,"ف",1,0],["فُصوصُ بَلّورٍ عَلى فَيروزَجٍ","تُشرِقُ في الجَوِّ بِنورٍ مُبهَجِ",18,"ج",1,0],["فصورتي محفوظة عنده","يشهدها مشهد ممدوح",19,"ح",1,0],["فصواعق دوارة بنوابض","وزلازل سيارة بزناد",20,"د",1,0],["فصوصُ زمرّدٍ في غُلْفِ درِّ","بأقماعٍ حَكَتْ تقليمَ ظُفْر",21,"ر",1,1],["فَصَواريها تَسامَت لِلسَّما","فَتَراها لِلسّما صارَت دعامَه",22,"م",2,0],["فصوصُ زمردٍّ في كيسِ درٍّ","حكَت أقماعُها تقليمَ ظُفرِ",23,"ر",1,1],["فصولها عشر جلاها العرف","الاسم ثم الفعل ثم الحرف",24,"ف",1,0],["فصوَّبت هاماتها","كصيّب السحائب",25,"ب",1,0],["فصوب الحيا \"في جوده\" برقه الظبَى","يريك \"هشيم\" الكفر مما يقدُّه",26,"د",2,0],["فصوب نحوي فاِنصرعت فشقني","بنصفين حَتّى شك مخلبه قَلبي",27,"ب",2,0],["فصوته وهزار الروض حين شدا","قد وافقا نغمة الشادى على الوتر",28,"ر",1,0],["فَصوَّر السُوسنَ مِن","دائِرَةٍ مُسَدَّسه",29,"س",2,0],["فصوح من زفيرك كل زهرٍ","وعاد يدمعك الزهر المندى",30,"د",2,0],["فَصُوى حَرَّةٍ وَأَرعَنُ في الجَوْ","ومُنيفٌ وَقُبَّةٌ عَنقاءُ",31,"ا",2,0],["فصولوا كما صالوا وخبّوا لذبهم","وسُدُّوا عن الدين الحنيف كما سَدُّوا",32,"د",3,0],["فصوغي فيه من درر التهاني","ومن در البيان الحر عقدا",33,"د",2,0],["فصوص نظامى في عقود مديحه","مرصعة فيها الزَمان يشنف",34,"ف",1,0],["فصولُها يا صاحبي أحَد عَشَرَا","إحسِب تَجدهُنَّ وتَسمَع وتَرى",35,"ر",2,0],["فَصوغُهُ للنظم قَد","أَعجَزَ كُلَّ صائِغِ",36,"غ",1,0],["فصورة فينوس في وسطه","لكل فنون البها جامعه",37,"ع",2,0],["فصور اسرافيل في صوتها","وعمر عزرائيل من عمرها",38,"ر",3,0],["فصَوتُه الرَّعدُ والأوتارُ صوبُ حيا","والغادةُ الشمسُ حسنا وهو قوس قزح",39,"ح",1,0],["فُصوص ألْماسٍ على","بِساطِ خَزٍ وذَهَبْ",40,"ب",1,0],["فصورتم الإسلام كالليل قاتما","من الزيغ والإسلام كالصبح أو أجلى",41,"ل",2,0],["فصوب طرفاً نحو شبليه قائلاً","علام البكا فالصبر أجمل بالحر",42,"ر",1,0],["فصور وهمها الوجود ولم يكن","وما كان هذا قبل إلا لعلة",43,"ه",1,0],["فصوله من بني نزارٍ","بها المعاني بنو البتول",44,"ل",1,0],["فصونوا يدي عن شَلِّها بِعطائِكم","فما أنا في أخْذِ الرغائبِ راغِبُ",45,"ب",1,0],["فَصَوَّبْنَ أعناناً وأدنَيْنَ أذرُعاً","إليهنَّ والجَرْع انتهازاً تُداخلُهْ",46,"ل",2,0],["فصولها تشرق كالشموس","عدا الذي يختص بالمجوس",47,"س",1,0],["فصوغي إلى البدر من وجهك","حلى يتباهى بها القمر",48,"ر",1,0],["فصونوا العِرض إن العرض بيضٌ","وأبيضُ لا يُدَنَّسُ حيث كانا",49,"ن",2,0],["فصوح ذاكَ الرَونَق الغَض وَالنَوى","مُهَفهَف ذاكَ الغُصن وَاِستَملَح الوَرد",50,"د",1,0],["فَصَوَّبَهُ العَبدُ في إِثرِها","فَطَوراً يَغيبُ وَطَوراً يُرى",51,"ا",1,0],["فَصَوْبُ التَّهاني مثلُ دائِرَةٍ غَدَا","فما تَنْتَهي حَتَّى أراهُ تَجَّدَّدَا",52,"د",2,0],["فصوموا أحيبابي وصونوا صيامكم","عن المبطل المذكور تجدوه وافيا",53,"ي",2,0],["فُصُولٌ بِالعِظاتِ مُفَصَّلاتٌ","ضَوافٍ لَم يَشُبهنَّ اِقتِضابُ",54,"ب",1,0],["فَصَوْتُ الجُدُّودِ يَنادي البَنِينا","فَلَبِّ النِّداءَ لِيَحْيا الوَطَنْ",55,"ن",1,0],["فُصولُ العامِ أَربَعَةٌ","أَبانَتهُنَّ أَشعارُ",56,"ر",1,0],["فصوَّبها صوب الحيا من سحابنا","فلا تعتجب من سيبنا وانصبابنا",57,"ن",2,0],["فصوصه فصلت في ضمنها حكم","تتلى فتنداح أبواب الفتوحات",58,"ت",1,0],["فَصَوَّرَ شَخصي بِاليَدَينِ مُصَوِّري","لِيَطبَعَ لِلضِدَّينِ فِيَّ طَوابِعُ",59,"ع",1,0],["فَصَوت دُعاتِها يعلو","وقرعُ طبولِها أعلَى",60,"ل",2,0],["فصول الحب قد جاءت كغيثٍ","إلى قلبٍ يتوق لها ارتشافا",61,"ف",2,1],["فصورة ماض قد أعيدت كأننا","جلسنا كما كنا بطاولة القسم",62,"م",1,0],["فَصوتي خانَ حَنجَرَتي","وَصمتي قالَ خَيباتي",63,"ت",2,0],["فصُولُ التَّنائي خَريفٌ جلاَ","بهِ اصْفَرَّ وَصْلّ....فما أَصنَعُ؟",64,"ع",1,0],["فصوادق الآحاد من أخباره","نسخت وجوب العلم بالمتواتر",65,"ر",1,0],["فَصَولَةُ الْأبْطالِ كَالْبَواشِقِ","وَصَولَةُ اللِّئامِ كَالْنَوافِقِ",66,"ق",1,0],["فصون الخطا عن ذي الخطاء التزم وهب","صفاك لمهدي من لديه صفاء",67,"ا",2,0],["فصوبت فكري أي حال يكون لي","منارا به أسمو لأعلى المراتب",68,"ب",1,0],["فصورت لي في أسبانيا رجلاً","ما زال في جسمه يغلي دم العرب",69,"ب",1,0],["فصور القبح تهويشاً على ورق","هش عليه بقايا اللطخ من عفن",70,"ن",1,0],["فصول الأصول جلا بهجة