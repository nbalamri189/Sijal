{"poems":[[55,"هي سلوة ذهبت بكل غرام","https://www.aldiwan.net/poem29797.html","الكامل"],[31,"قد كشف الحلم عني الجهل فانقشعت","https://www.aldiwan.net/poem6059.html","البسيط"],[99,"بالروح باكية تقبلني","https://www.aldiwan.net/poem24412.html","مجزوء الكامل"],[99,"دينٌ وهذا اليومُ يومُ وفاءِ","https://www.aldiwan.net/poem24752.html","الكامل"],[107,"نهض الغزاة فأين تمضي العير","https://www.aldiwan.net/poem43998.html","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16649","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54722","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54196","الكامل"],[108,"تأميم القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179582",""],[147,"يا غابرا وجد الندى","https://www.aldiwan.net/poem11797.html","مجزوء الكامل"],[155,"هي قذ وتوأم ورقيب","https://www.aldiwan.net/poem1411.html",""],[342,"بانت سعاد فنوم العين مملول","https://www.aldiwan.net/poem45422.html","البسيط"],[369,"أتراها تظنني الطيف لطفا","https://www.aldiwan.net/poem60838.html","الخفيف"],[406,"للحب قلب نابض","https://www.aldiwan.net/poem6705.html","عموديه"],[458,"يا أيها الموتى ويا من خلدوا","https://www.aldiwan.net/poem61635.html","الكامل"],[463,"قالوا عساك مرجم فتبين","https://www.aldiwan.net/poem55859.html","الكامل"],[520,"يا سيداً في أوصافه","https://www.aldiwan.net/poem12111.html","مجزوء الكامل"],[563,"هي قامت بنفسها لذويها","https://www.aldiwan.net/poem33637.html","الخفيف"],[580,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145792","الكامل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138076",""],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80185","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126155","الكامل"],[1277,"","https://poetry.dctabudhabi.ae/diwan/poem/200283","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109253","الخفيف"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102301","الكامل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93129","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79928","الكامل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141268","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110333","الكامل"],[2315,"","https://poetry.dctabudhabi.ae/diwan/poem/198762","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87326","الرجز"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76000","الكامل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205786","الخفيف"],[2843,"","https://poetry.dctabudhabi.ae/diwan/poem/124682","الكامل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109788","الخفيف"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115417","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74232","الكامل"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101648","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100831","الكامل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130088","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87452","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108338",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91181","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114330","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81298","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139651",""],[5005,"موائد الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=208146",""],[5064,"ظمأ الرّوح","https://www.poetsgate.com/ViewPoem.aspx?id=199113",""],[585,"أنا في انتظارك مدنف ولهان","https://www.poetsgate.com/ViewPoem.aspx?id=161936",""],[585,"الكاس واحدةٌ ونحن اثنان","https://www.poetsgate.com/ViewPoem.aspx?id=161930",""],[5102,"عيوني","https://www.poetsgate.com/ViewPoem.aspx?id=12900",""],[5121,"مُسْكِرَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=33588",""],[5271,"قد خاب ظني","https://www.poetsgate.com/ViewPoem.aspx?id=65380",""],[5277,"فنجان قهوة بطعم العراق","https://www.poetsgate.com/ViewPoem.aspx?id=185397",""],[5277,"ضلالُ الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=191475",""],[5277,"حديثُ الدموعِ..","https://www.poetsgate.com/ViewPoem.aspx?id=202790",""],[5285,"مريم","https://www.poetsgate.com/ViewPoem.aspx?id=203654",""],[5358,"معكم فؤادٌ","https://www.poetsgate.com/ViewPoem.aspx?id=202325",""],[5392,".. للقافياتِ عيون","https://www.poetsgate.com/ViewPoem.aspx?id=132112",""],[5411,"كفّي الّتي","https://www.poetsgate.com/ViewPoem.aspx?id=185428",""],[5413,"هي قصتي!","https://www.poetsgate.com/ViewPoem.aspx?id=200673",""],[5533,"يا أُمَّةَ المِلْيَار","https://www.poetsgate.com/ViewPoem.aspx?id=180269",""],[5559,"بيننا شغاف الروح ( محمود أسد )","https://www.poetsgate.com/ViewPoem.aspx?id=60738",""],[5638,"ديمة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=197900",""],[5638,"حنين إلى القدس","https://www.poetsgate.com/ViewPoem.aspx?id=200124",""],[5638,"رثاء البطل عمر أبو ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=203607",""],[5850,"بانتْ سُعادُ فنوْمُ العينِ مملولُ","https://www.poetsgate.com/ViewPoem.aspx?id=19713",""],[5956,"أنا محرومٌ","https://www.poetsgate.com/ViewPoem.aspx?id=181915",""],[5956,"مودة ورحمة","https://www.poetsgate.com/ViewPoem.aspx?id=182435",""],[5956,"أستاذتي","https://www.poetsgate.com/ViewPoem.aspx?id=194456",""],[5957,"هي قصة","https://www.poetsgate.com/ViewPoem.aspx?id=214638",""],[6093,"شهمٌ على ظَهرِ المآذن صادحٌ","https://www.poetsgate.com/ViewPoem.aspx?id=176426",""],[6093,"قُبْلَةُ المِلْيَارِ","https://www.poetsgate.com/ViewPoem.aspx?id=199427",""],[6247,"الراحلون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80266&r=&rc=5",""]],"verses":[["هِيَ قَولَةٌ لا يُستَطاعُ رُجوعُها","كَالسَهمِ يَخرُجُ عَن بَنانِ الرامي",0,"م",2,0],["هَيقٌ خَفيفٌ يُباريها إِذا نَهَضَت","وَهوَ لَها بَعدَ جِدٍّ مِنهُما تَبَعُ",1,"ع",1,0],["هي قُبلةُ التوديعِ مي","ثاقُ المحبةِ والوفاءِ",2,"ا",2,0],["هي قصةُ الطيف الحزين وصورة ال","قلب الطعين مجللاً بدماءِ",3,"ا",2,0],["هي قصة الدنيا وكم من آدم","منا له دمعٌ على حوّاءِ",3,"ا",2,0],["هِيَ قُوَّةٌ لِلمُسْلِمينَ وَمَظهرٌ","للقائِمينَ على الجهادِ خَطيرُ",4,"ر",1,0],["هيَ قالتْ لمّا رَأَتْ شَيْبَ رأسي","وأرادَتْ تَنَكّراً وازوِرَارا",5,"ر",2,0],["هِيَ قُدْرَةٌ لَمْ يُؤْتَهَا مَنْ لَمْ يُذِبْ","فِيهَا قُوَاهُ وَلَمْ يَكُدَّ وَيَجْهَدِ",6,"د",1,0],["هِيَ قُدْوَةٌ للعامِلِينَ وَأُسْوَةُ الْمُسْتَبْسِلِينَ","وَقِصَّةُ الأَطْفال",7,"ل",1,0],["هي قلبُ النيل، إلا أنهمْ","وضعوها بين أضلاع سِواهْ",8,"ا",2,0],["هِيَ قِصَّةٌ أَعرَبتَ في","ها عَن سَجِيَّتِكَ البَخيلَه",9,"ل",2,0],["هي قذ وتوأم ورقيب","ثم حلس ونافس ثم مسبل",10,"ل",1,1],["هَيقٌ هِزَفٌّ وَزَفّانِيَّةٌ مَرَطى","زَعراءُ ريشُ ذُناباها هَراميلُ",11,"ل",1,0],["هي قَيسيّةٌ ونحن يَمانو","نَ ولا غَرْو أن نَبِرَّ ونُجْفَى",12,"ف",2,0],["هي قصة الوطن الكبير تعانقت","في ظله الواحات والكثبان",13,"ن",1,0],["هي قصَّةُ الوحشِ الضرير وما دَرَى","بطشَ الزَّمانِ بِظفرهِ وبنابه",14,"ب",2,0],["هي قِبلةٌ صلَّى القريضُ لها فمن","لم يَعْنُ منه لَها فليس بمؤمنِ",15,"ن",1,0],["هي قصة نتفت سبا","ل الشعر بل سلبت شعاري",16,"ر",2,0],["هي قامت بنفسها لذويها","ليس في كاسها ولا الكاس فيها",17,"ي",3,1],["هي قد كفتكم ما أراد","تُم بالصُّدودِ والاجْتِنَابِ",18,"ب",1,0],["هيَ قبضة ٌشُدَّتْ على عُنق ِال","مطعُون ظنا ًأنها تلوَى",19,"و",2,0],["هي قرب الفؤاد في كل حين","ولها في الضلوع أي مهاد",20,"د",1,0],["هِيَ قاعَةُ الأَطيارِ كُنتُ أَرى بِها","حالَ التَوحد مَجلس الندمانِ",21,"ن",1,0],["هي قرية تدعى بدير عطية","مشهورة في بدوها والحاضرة",22,"ه",1,0],["هي قصَّةٌ مَروِيَّة أحدَاثُها","بقصِيدة أبياتُهَا تَروينِي",23,"ن",2,0],["هي قطر الندى ولؤلؤة الطهر","ودمع الصباح في نيسان",24,"ن",1,0],["هي قوت أرواح عنت بحصادها ال","أيدي كما اكتنف الدياس الأرجل",25,"ل",1,0],["هي قصوى عني ولكن بقربي","قد رآها من قبل عيني قلبي",26,"ي",1,0],["هي قِبلةٌ صلَّى لها غَزَلي كما","صلَّى ثنايَ لقبلةِ المعروف",27,"ف",1,0],["هي قسمة ضيزى ولكن هكذا","شاءت فتاة الحيّ يا أسيادي",28,"د",2,0],["هي قامت بنصبها كيف كانت","خلفاء النبي بل خلفاها",29,"ا",3,0],["هي قوةٌ سحريةٌ حصرت زما","م الكونِ بين يراعة ودواةِ",30,"ه",1,0],["هي قصة وقصيدة عربية","كتبت بزايد حين عز المنطقُ",31,"ق",1,0],["هي قِبلَةُ القُمريِّ والسفالي","والحَبشَةِ وما لها يوالي",32,"ي",1,0],["هِيَ قُدرةُ الخَلّاقِ يَفعَلُ ما يَشا","في خَلقِهِ بِتَوافُقٍ وَخلافِ",33,"ف",1,0],["هي قلبي يذوب في اللحن وجداً","ودموعي جرت على قرطاسي",34,"س",2,0],["هي قطرةُ الماءِ الزلالِ تلوّنت","بدمٍ على الوادي المقدّس يُهرقُ",35,"ق",1,0],["هي قلب الدنيا أصيب بسهم","فاصابات الامه الاعضاء",36,"ا",2,0],["هي قامةُ أم صعدُةُ سمراءُ","وذُؤابَةُ أم حيَّةٌ رقطاءُ",37,"ا",2,1],["هِيَ قينة لَكنها مُذ أَصبَحَت","في بَيتكم صارَت مِن الأَسياد",38,"د",1,0],["هي قبَّةُ الدنيا ونحن نجومُها","وهي العرينُ ونحن نحنُ أُسُودُها",39,"ه",2,0],["هي قرحة نغرت فسال صديدها","والداء ينغر جرحه اذ يقدم",40,"م",1,0],["هيَ قطرةٌ من بحر جودك أنبتت","غُصناً بهيّ الشكل مرغوب الثمَر",41,"ر",1,0],["هيَ قُبَّةُ الأَغصانِ والأَوراقِ قد","قد حَجَبت عن النظر الحديدِ سَماهُ",42,"ا",2,0],["هي قد سبته بالجمال ودونه","هو قد سباها بالنفيس وقد بدا",43,"ا",1,0],["هِيَ قامة السَمراء إِلّا أَنها","مَخلوقة مِن دُرة بَيضاء",44,"ا",2,0],["هِيَ قُبلَةُ الرُّكنِ الاسوَدِ لَثمٌ","قَد حَلاَ لِي عَن كُلِّ لَثمٍ حَلاَلِ",45,"ل",1,1],["هِيَ قَسطي مِن السَماء فَما أَض","يع في العالم التُرابي قَسطي",46,"ط",2,0],["هي قصر غمدانٍ وفيها قد غدا","مشحوذ سيفٍ بالمكارم مغمد",47,"د",1,0],["هي قصَّةُ الأمسِ المُخيفِ إذا","لَبستْ ثيابَ الهَمِّ والكدرِ",48,"ر",1,0],["هِيَ قَصْرٌ أبوابُهُ مِنْ حَدِيدٍ","تتبدَّى جُدْرانُهُ لكَ قَشَّا",49,"ش",2,0],["هي قصةٌ خطرت وكنت أظنها","غبرت وخيم فوقها النسيان",50,"ن",1,0],["هي قصة امرأةٍ يدين لها امرؤٌ","في الحب منفردين في بستان",51,"ن",1,0],["هي قلعةٌ للناكرين ذواتهمْ","هي للعِدى بطّاشة نكراءُ",52,"ا",2,0],["هِيَ قَطْرَةٌ ذَابَتْ بِقَلْبِي فَاسْتَوَتْ","كَالْبَحْرِ مَدّاً وَانْحِسَاراً بِالنَّوَى",53,"و",2,0],["هيَ قصةٌ قَدْ ذبتِ فيها","مَا عادَ يُجديكِ التَأني !!",54,"ن",2,0],["هي قهوتي من ريحها عبقٌ","ضاهى الورود وسابق الزهرَهْ",55,"ر",2,0],["هي قربةُ الرحمن في توحيدهِ","لا تنسَه أبدا وكن بهِ أشعبا",56,"ب",2,0],["هي قصّةٌ كلماتُها لا تنتهي","بين القبورِ وروضةِ الشهداءِ",57,"ا",2,0],["هي قطرةُ الزهرِ النديِّ","إذا تساقطَ قطرُها",58,"ر",3,0],["هي قِصّةُ الحرْبِ التي ما بيننا","أبطالُها الشَّيطانُ والإنْسانُ",59,"ن",1,0],["هي قالتْ: أنا الحَبيبة وحدي","وأنا الحُبُّ مِنْ يَديَّ ..يَكونُ",60,"ن",1,0],["هيَ قُبْلَةٌ وَبِها تَثُورُ مَدارِكٌ","وَنَسيْتُ زُهْدي عِندَ ظِلِّ مَعابِدي",61,"د",2,0],["هي قصةٌ لا تنتهي حلقاتُها","حتى تراني في التراب دفينا",62,"ن",2,1],["هِيَ قَوْلةٌ لا بدَّ من صِدْقٍ بها","دِينُ الإِلهِ مَقاصِدٌ وكَلامُ",63,"م",1,0],["هي قصَّتي يا إخوتي لا تعجبوا؟","غربالُ تاريخِ الأخوَّةِ أعورُ",64,"ر",1,0],["هِيَ قِصَّةٌ فِي كُلِّ حَرْفٍ سَكْرَةٌ","كَالْحُلْمِ يَحْكِي لَذَّةً لَمْ تُقْمَعِ",65,"ع",1,0],["هِيَ قَلْبُ أُمَّتِنَا وَقُرَّةُ عَيْنِهَا","فَحَيَاتُهَا بِحَيَاتِهَا تَلْتَامُ",66,"م",1,0],["هِيَ قِصَّةٌ مَفْتُوحَةٌ","مِنْ فَجْرِ تَارِيخِ الْبَشَرْ",67,"ر",1,0],["هَيْقٌ هِزَقٌّ وزَفّانيّة ٌ مَرَطى","زَعْراءُ رِيشُ ذُناباها هَراميلُ",68,"ل",1,0],["هي قد ضاعت أمانيها سدى","وأنا ضاعت فما هذا الوئام؟",69,"م",1,0],["هي قمة الإصلاح صالحةٌ كما","شاء الذي وفقي يفصِّل كلَّها",70,"ل",3,0],["هي قوةٌ علميةٌ روحيّةٌ","قد أرخصت بسبيلها أغلى الغلا",71,"ل",2,0],["هي قصة والحزن أثثها","أبطالها دمعٌ وأحداقُ",72,"ق",1,0],["هي قُبلةُ الثُّعبانِ أقْصَى جُهْدِه","جهدُ المقلِّ ويَشكرُ الرَّحمانُ",73,"ن",1,0],["هِيَ قُبْلَةُ المِلْيَارِ أَطْ","بَعُهَا عَلَى الوَجْهِ الحَسَنْ",74,"ن",1,0],["هي قصتي وقصيدتي.. ألحانُها","تحدو مسيري في دروب الدعوةِ",75,"ه",1,0],["هي قصتي يا إخوتي ..عنوانُها","أحيا وأقضي في سبيل عقيدتي",75,"ي",1,0]]}