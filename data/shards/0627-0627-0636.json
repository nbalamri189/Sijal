{"poems":[[102,"منزغ الشياطين","https://www.aldiwan.net/poem6546.html","عموديه"],[49,"دعوتك للجفن القريح المسهد","https://www.aldiwan.net/poem25322.html","الطويل"],[64,"فيم المقام على الهوان وهمتي","https://www.aldiwan.net/poem52291.html","الكامل"],[47,"ضلالا لها ماذا أرادت إلى الصد","https://www.aldiwan.net/poem63507.html","الطويل"],[71,"أأضيع سحر جفونه","https://www.aldiwan.net/poem28938.html","مجزوء الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85411","المتدارك"],[133,"يا نفس مالك والانين","https://www.aldiwan.net/poem67456.html","مجزوء الكامل"],[275,"سأتبع ظل الموت بين الكتائب","https://www.aldiwan.net/poem35630.html","الطويل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130201","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70920","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59620","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59576","الطويل"],[1119,"","https://poetry.dctabudhabi.ae/diwan/poem/116744","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79815","الكامل"],[1590,"","https://poetry.dctabudhabi.ae/diwan/poem/98055","الطويل"],[1661,"","https://poetry.dctabudhabi.ae/diwan/poem/67815","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100963","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27190","الطويل"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141183","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74181","الكامل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104246","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88981","الكامل"],[4729,"لأُرحِلَنَّ مَطيتي عَنْ بَلدَةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=109431",""],[1012,"فتوحات الإمام عزان بن قيس","https://www.poetsgate.com/ViewPoem.aspx?id=124503",""],[3591,"ضجّت بحسن عيونك الآنام","https://www.poetsgate.com/ViewPoem.aspx?id=149536",""],[5431,"أضاجع الحزن اللصيق وأندبُ","https://www.poetsgate.com/ViewPoem.aspx?id=183240",""],[5561,"راهبة","https://www.poetsgate.com/ViewPoem.aspx?id=192905",""],[6033,"أنا والشعر","https://www.poetsgate.com/ViewPoem.aspx?id=215798",""]],"verses":[["أأضحى الصدى المشقوقُ صوتاً مشقّقاً؟","بحلق الذي يوحي، يدسُّ المُبلَّغا",0,"غ",2,0],["أَأَضحَوا عَلى أَسراهُمُ بِيَ عُوَّداً","وَأَنتُم عَلى أَسراكُمُ غَيرُ عُوَّدِ",1,"د",1,0],["أأُضامُ في دارٍ وأقعدُ راضِياً","إني لنفسي إنْ فعلتُ لأظلمُ",2,"م",1,0],["أَأَضرِبُ أَكبادَ المَطايا إِلَيهِمِ","مُطالَبَةً مِنّي وَحاجاتُهُم عِندي",3,"د",2,0],["أأُضِيعُ سحرَ جفونِهِ","وأُهينُ مبسَمَهُ وخمرَهْ",4,"ه",1,1],["أَأَضاع القَوم رويتهم","أَم قَد بطروا لما اِنتصروا",5,"ر",3,0],["أَأَضعتِ فِكراً في الفَضاء","فتبعته فوقَ الهَواء",6,"ا",2,0],["أأضحكُ من نفسي وأرضى بغبنِها","وقد شاقها علمُ الحكميمِ المراقب",7,"ب",1,0],["أأضل عن طرق الغرام بطرة","ليلية لا والظلام إذا سجا",8,"ج",2,0],["أأضربُ قلْ لي أم أعيشُ مُذَلّلا","بأرض ولى مها محيص ومهرب",9,"ب",1,0],["أأضمرُتم غدراً لإظهاري الوفا","وأظهرتمُ ضِداً لما أنا أضْمر",10,"ر",1,0],["أأُضمر عزمي أم أبوح بمقصدي","واكتم حالي أم أصول وأعتدي",11,"د",2,1],["أأضربها في غير ذنبٍ أتَت بهِ","فما العدلُ مني ضربُ من ليس مذنبا",12,"ب",2,0],["أأضعتِ حافظَ دينه","وحفظتِ جاهلةً مُضيعه",13,"ع",2,0],["أَأُضربُ في يَحيى وَبيني وبينهُ","تَنايف لو تَسري بها الريح كلّتِ",14,"ت",1,1],["أأضربهن كي يبعدن عنها","أشل الله يومئذ يَميني",15,"ن",2,0],["أأضيافَنا إن التحية عندنا","قلوب تُفرّى أو رقاب تُقضَّب",16,"ب",1,0],["أَأَضغاثُ أَحلامٍ أَبُشرى مَنامَةٍ","أَنُطقُ زَمانٍ كانَ في نُطقِهِ سَعدي",17,"د",2,0],["أأضرع للبلوى وأغضي على القذى","وأرضى بما يرضى به كل خوّار",18,"ر",1,0],["أَأضام عَبد اللَه دَعوة صارخ","مِن رَيب ذا الزمَن الخؤون وَأَنتَ لي",19,"ل",2,0],["أأضمر البعد عنك يوما","سحقا لها خطة وبعدا",20,"د",2,0],["أأضام يا مولى وأنت وسيلتي","وتطول أمراضي وأنت طبيبي",21,"ب",2,1],["أَأضامُ والأملاك تَرجُو أن تَرَى","ظِلَّي وَلي في العالَمينَ وَلاؤُهَا",22,"ا",3,0],["أأضاء برق في الدياجي مشعشعُ","بضاحكة أبكى كذا العين أدمعُ",23,"ع",1,1],["أأضام يا ميمون في نجدٍ وهل","من عاش في كنف العزيز يضام",24,"م",1,0],["أأضام منك وأين ما عاهدتني","أن لا يفارق جانبي الإعظام",24,"م",1,0],["أأضاجع الحزن اللصيق وأندبُ","هل للصباح بوادرٌ وتأهبُ!؟",25,"ب",1,1],["أ أضاجعُ حُزني أوهامي","وأشاطرُ حبّي مَن أنكر",26,"ر",1,0],["أأضمها قسراً وألَْثَمُ ثغرها؟","والخصرُ غصنٌ ينثني برُخاءِ؟",27,"ا",2,0]]}