{"poems":[[79,"سلام الله بورك من سلام","https://www.aldiwan.net/poem36096.html","الوافر"],[79,"برابعة الساعات جئت أخبر","https://www.aldiwan.net/poem36505.html","الطويل"],[53,"عسى ولعل طيبتا حياتي","https://www.aldiwan.net/poem65449.html","الوافر"],[53,"جرى الأضحى رسيل المهرجان","https://www.aldiwan.net/poem66393.html","الوافر"],[72,"لئن صدقتني في الحديث ظنوني","https://www.aldiwan.net/poem42435.html","الطويل"],[72,"طريقتك المثلى أجل وأشرف","https://www.aldiwan.net/poem42807.html","الطويل"],[69,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[108,"تحيْة الرسالة","https://www.poetsgate.com/ViewPoem.aspx?id=179503",""],[79,"برابعة الساعات جئت أخبر","https://www.poetsgate.com/ViewPoem.aspx?id=34125",""],[53,"جَرَى الأضحى رَسِيل المِهرجانِ","https://www.poetsgate.com/ViewPoem.aspx?id=30686",""],[164,"إلى أى باب غير بابك أقرع","https://www.aldiwan.net/poem59097.html","الطويل"],[226,"أرت أم عباس أعجوبة","https://www.aldiwan.net/poem55282.html","المتقارب"],[234,"ألا هل لألفاظي طريق إلى العذر","https://www.aldiwan.net/poem51104.html","الطويل"],[234,"شرى البرق فالتاع الفؤاد المعذب","https://www.aldiwan.net/poem51254.html","الطويل"],[236,"شواهد قلب الصب لا تقبل الرشا","https://www.aldiwan.net/poem44563.html","الطويل"],[240,"عسى قاعد الحظ يوما يثب","https://www.aldiwan.net/poem32180.html","المتقارب"],[342,"طاف خيال من سليمى فاعترى","https://www.aldiwan.net/poem45338.html","الرجز"],[406,"موازين الرجال","https://www.aldiwan.net/poem6777.html","عموديه"],[422,"عفت أرسم من دار مي وأطلال","https://www.aldiwan.net/poem53921.html","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61253","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64985","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128722","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108645","المجتث"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101042","الطويل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109281","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89416","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62855","المتقارب"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108378",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111410","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94386","الطويل"],[4578,"بأفق العز أشرق بدرُ سعدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=49395",""],[4984,"فَتَلْتَ خُيُوطَ الظَّنِ","https://www.poetsgate.com/ViewPoem.aspx?id=215863",""],[5363,"مفخرة الإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=144431",""],[5409,"أهزةٌ أيقظت من روعها البلدا","https://www.poetsgate.com/ViewPoem.aspx?id=155458",""],[5419,"خيرٌ وأبقى","https://www.poetsgate.com/ViewPoem.aspx?id=39918",""]],"verses":[["تُبَشِّرُ بِالرِّضَى مغْدىً وَمَمْسىً","فَتَبْسِمُ عَنْهُ أَزْهَارُ الْكِمَامِ",0,"م",1,0],["تبَشِّرُ منْهُ العارِفونَ بوارِدٍ","قَريبِ المَدى يا لَلّهِ فيما تُبشِّرُ",1,"ر",1,0],["تبشرني بروح الله بشرى","تشوف عن القلوب الهم شوفا",2,"ف",2,0],["تُبَشِّرُني الظنون بصوْت غيثٍ","مُغيثٍ منك في هذا الأوان",3,"ن",1,0],["تُبَشِّرُ عَنّي بِالوَفاءِ بَشاشَتي","وَيَنطِقُ نورُ الصِدقِ فَوقَ جَبيني",4,"ن",2,0],["تُبَشِّرُني الآمالُ مِنكَ بِنَظرَةٍ","تُزَفُّ لِيَ الدُنيا بِها وَتُزَخرَفُ",5,"ف",1,0],["تُبَشّرُ مِصْر دائماً بِقُدُومِهِمْ","إذا فَصَلَتْ منهم لِغزَّة عِيرُ",6,"ر",1,0],["تبشِّر بالضاد بين بينها","وأكرِمْ بحرمة هذا النسب!",7,"ب",1,0],["تبشر منه العارفون بوارد","قريب المدى بالله فيما تبشر",8,"ر",1,0],["تُبَشِّرُني الظنون بصوْب غيثٍ","مُغيثٍ منك في هذا الأوان",9,"ن",1,0],["تبشرني عنك الأماني بالعلا","وفي غير جدواك الأماني تخدع",10,"ع",1,0],["تبشرني وعلى وجهها","بريق السرور بحظي لمع",11,"ع",1,0],["تبشِّرني عنه البشاشة بالرضا","وطيِّ الخطاب المتر والنظر الشَزْر",12,"ر",1,0],["تُبَشِّر طَوْرا بالإِلهِ وتارةً","تُخَوِّف من عِصْيانه وتُرَهِّب",13,"ب",1,0],["تبشبش وجه الأرض مذ حلها كما","بطلعته وجه السماء تبشبشا",14,"ش",2,0],["تُبَشِّرُ مُلكَكَ أَعوامُهُ","بِكَرِّ السِنينَ وَمَرِّ الحِقَب",15,"ب",1,0],["تُبَشَّري بِالرِفهِ وَالماءِ الرِوى","وَفَرَجٍ مِنكِ قَريبٍ قَد أَتى",16,"ا",1,0],["تبشِّرنا بنصر الله، إِني","لأسمعُه على شفتَيْ (بلالِ)",17,"ل",1,0],["تُبشّرُ بالنَّعْماء منك بشاشَةٌ","وعطفٌ على من يرتجيك وإقبال",18,"ل",1,0],["تبشر بِالغُفران مَن باتَ لَيله","حَليف سهاد خَوف نار تسعر",19,"ر",1,0],["تُبَشِّرُني الأَلطافُ بالقُرْبِ مِنْكمُ","فصَدْريَ ما أَفْضَى وعَيْشيَ ما أَهْنا",20,"ن",2,0],["تبشرنا بخيرات حسان","وتزلقنا من الفردوس جنه",21,"ن",2,0],["تبشُّ في خير عامٍ","كأنه وجه عامر",22,"ر",1,0],["تبشر آمالي بحسن مآلي","كأن الليالي آذنت بوصالي",23,"ل",2,1],["تبشّرنا ان سوف ترسل نورها","على شرقنا الشمس التي أحيت الغربا",24,"ب",2,0],["تبشر الدنيا بها صباحاً","مسفرة عن وجهه الندي",25,"ي",1,0],["تُبَشِّرُ فالاتُه بالسُّعُو","دِ وتخفِق رَاياتُهُ بالظَّفَرْ",26,"ر",1,0],["تبش وجوهٌ منهم عند زورتي","وفي وجد قيس يسمعون ندائيا",27,"ي",2,0],["تُبَشِّرُهُم بِطّرِ الصُّبحِ لمَّا","اَغامَمنُونُ بَينَ القَومِ جالا",28,"ل",2,0],["تبشرت الأكوان في نيلها المنى","وفي مثل هذا كم تُسِرُّ البشائرُ",29,"ر",1,0],["تبشرنا بمولودٍ ذي كمال","به الأيام وفَّت أي وعدِ",30,"د",1,0],["تبشرك الأنواء بالغيث بعدما","أثار رذاذ الفأل في الجدب ما أغرى",31,"ر",2,0],["تبشِّره بخيرٍ ثمّ قالت","وصولَ الرحمِ يا سيلَ العطاءِ",32,"ا",2,0],["تبش في وجه من يلقاك متخذاً","من البشاشة كي تخفي الأسى ضمدا",33,"د",2,0],["تبشين للضيفِ رغم جراحكِ","والجودُ من فضلِ كفّكِ يُسقى",34,"ق",2,0]]}