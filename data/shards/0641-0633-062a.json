{"poems":[[79,"قسما بالليل وما وسقا","https://www.aldiwan.net/poem35922.html","المتدارك"],[75,"لست بالجاحد آلاء العلل","https://www.aldiwan.net/poem11941.html","الرمل"],[32,"فلو كان عمران بن موسى أتمها","https://www.aldiwan.net/poem29592.html","الطويل"],[53,"يا ابن شهر الصيام أنت رقيع","https://www.aldiwan.net/poem65424.html","الخفيف"],[53,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[93,"سمعت عويل النائحات عشية","https://www.aldiwan.net/poem8833.html","عموديه"],[30,"لو شئت لمت بني زبينة صادقا","https://www.aldiwan.net/poem5605.html","الكامل"],[46,"بأبي وغير أبي وذاك قليل","https://www.aldiwan.net/poem30307.html","الكامل"],[46,"أحسن بأيام العقيق وأطيب","https://www.aldiwan.net/poem30589.html","الكامل"],[71,"فستق ساء الأعادي","https://www.aldiwan.net/poem29119.html","مجزوء الرمل"],[77,"رأيت بعيني فوق ما كنت أسمع","https://www.aldiwan.net/poem69065.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42658","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43803","الكامل"],[33,"نَادِ الَّذينَ تَحَمَّلُوا كَيْ يَرْبُعُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18942&r=&rc=205",""],[199,"عرف الديار توهما فاعتادها","https://www.aldiwan.net/poem54421.html","الكامل"],[287,"شابت ذوائب لوز بقين","https://www.aldiwan.net/poem32317.html","أحذ الكامل"],[295,"يا منية القلب الكسير","https://www.aldiwan.net/poem11708.html","مجزوء الكامل"],[409,"الحمد كل الحمد للخلاق","https://www.aldiwan.net/poem33620.html","الكامل"],[558,"قطعت قتول قرينة الحبل","https://www.aldiwan.net/poem68394.html","الكامل"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2465","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122796","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122696","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86618","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87271","الرمل"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129521","الخفيف"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96356","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56572","الكامل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6769","الكامل"],[1467,"","https://poetry.dctabudhabi.ae/diwan/poem/136778",""],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203760","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53097","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53238","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53198","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53138","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204825","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132158","الكامل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128948","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128932","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128953","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128918","الخفيف"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34630","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135992","الرجز"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119658","الكامل"],[4767,"مرايا الحب","https://www.poetsgate.com/ViewPoem.aspx?id=215048",""],[4830,"جراحات النوى","https://www.poetsgate.com/ViewPoem.aspx?id=194984",""],[4862,"ولم تزل العبرات مخنوقه","https://www.poetsgate.com/ViewPoem.aspx?id=55632",""],[4883,"بنت_تهز الأسئله","https://www.poetsgate.com/ViewPoem.aspx?id=48368",""],[4904,"كانَ الْقِرى لَحْمي","https://www.poetsgate.com/ViewPoem.aspx?id=175727",""],[585,"أيها الموت كيف أفجعت بالغم","https://www.poetsgate.com/ViewPoem.aspx?id=161859",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[5442,"مادون رامة من معرس","https://www.poetsgate.com/ViewPoem.aspx?id=114778",""],[5596,"غزة فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=205674",""],[5660,"ألا فَابْكِ يا عَيْنايَّ ما سَحَّ دَمْعُكِ","https://www.poetsgate.com/ViewPoem.aspx?id=23707",""],[5978,"التيه","https://www.poetsgate.com/ViewPoem.aspx?id=191362",""],[463,"ليلُ السُّرى مثلُ نهارِ المقامْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60312&r=&rc=368",""],[6310,"الزَّحف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=71996&r=&rc=1",""]],"verses":[["فسَتَمْلِكُ أرْضَ الرّومِ فَما","أبْقَيْتَ بِها إلاّ رمَقا",0,"ق",2,0],["فَسَتَلقاهُ اللَيالي طَلقَةً","بِتَفاريقِ أَمانيهِ جُمَل",1,"ل",1,0],["فَسَت أُمُّ موسى فَوقَهُ حينَ طَرَّقَت","فَما زالَ مِنها مُنتِنَ الريحِ أَبخَرا",2,"ر",2,0],["فستلهيك إبرة وخيوط","وإلى الأصل ما تؤول الفروع",3,"ع",1,0],["فسُتِرتَ دونهمُ بسترِ كثافةٍ","حتى خفيتَ وما خفيتَ ضئيلا",4,"ل",2,0],["فَسَتَرجُعينَ خَميلَةً مِعطارَةً","أَنا في ذُراها بُلبُلٌ مَسحورُ",5,"ر",1,0],["فَسَتَعلَمونَ إِذا نَطَقتُ بِحُجَّتي","أَنّي وَأَيُّ بَني زَبينَةَ أَظلَمُ",6,"م",1,0],["فَسَتَذكُرُ الخَيلُ اِنصِلاتَكَ في السُرى","وَالقَفرُ مَعروفُ الرَدى مَجهولُ",7,"ل",1,0],["فَسَتَخرَبُ الدُنيا وَأَبنِيَةُ العُلى","وَقِبابُها جُدُدٌ بِها لَم تَخرَبِ",8,"ب",1,0],["فستقٌ ساءَ الأعادي","ويسرُّ الأصدقاءَ",9,"ا",2,1],["فسِتْرٌ عليهم في المُلِمّاتِ مُسْبَلٌ","وكَنْزٌ لهم عند الأئمّة مُودَع",10,"ع",1,0],["فَسَتَرْنَهَا عَنِّي وَسِرْنَ بِهَا","فِي رَوْضَةٍ فَيْنَانَةِ الْغَرْسِ",11,"س",1,0],["فَسَتَرتُها لكِن بَدَت","فَأَنا بِها عارٍ وَكاسي",12,"س",2,0],["فَکسْتَرْجَعَتْ وَبَكَتْ لِمَا قَدْ غَالَها","إنَّ المُوَفِّقَ فَکعْلَمُوا مُسْتَرجَعُ",13,"ع",1,0],["فَسَتَرتُ عَيبَ مَعيشَتي بِتَكَرُّمٍ","وَأَتَيتُ في سَعَةِ النَعيمِ سَدادَها",14,"د",3,0],["فَسَتُخلِفُ الأَيّامُ ما وَعَدَت","وَتَشوبُ صِدقَ القَولِ بِالمَينِ",15,"ن",1,0],["فستلمحين فتى أضرّ به","الهوى يخفي شجونه",16,"ن",2,0],["فسترتها فضلاً وأظهرت الذي","ألبستني فلك الثناء الباقي",17,"ق",2,0],["فَسَتَرنَها بِأَكُفِهِنَّ وَقَد","نَفَذَت مَرامِيَ صائِبِ النَبلِ",18,"ل",1,0],["فَسَتَأتيكَ مِدحَةٌ مِن كَريمٍ","نالَهُ مِن نَدى سِجالِكَ باعُ",19,"ع",1,0],["فَسَتَفَقِدُ الخَيلُ انصِبابِك لِلردَّى","تَحتَ العجاجِ إذا التَقَى الصَّفانِ",20,"ن",1,0],["فَسَتَقتُلُونَ غَداً فَريقاً مِنهُمُ","تَحتَ العَجاجِ وتأسِرُونَ فَريقا",21,"ق",2,0],["فَستون شَهراً في البِطالة أَذهَبَت","أَثاثي وَقَد سدّت عَليّ المَسارب",22,"ب",1,0],["فَستحظى مِن سعيدِ","بِفتوحات جَديدهْ",23,"ه",1,0],["فستدري الشهباء من فارقته","ولمن في غد تزم الرحال",24,"ل",1,0],["فستعلمينَ أصادِقٌ روّادُهُ","عنه وأيُّ فتىً فتى غَطَفانا",25,"ن",2,0],["فستظلمين كنا ظلمت بعشر","سادوا وأكثرهم بأرضك أعبد",26,"د",1,0],["فَسَتَستَبينُ مَكانَهُ بِضَجيعِهِ","وَيَنِمُّ مِنهُ إِلَيكَ عَرفُ العاطِرِ",27,"ر",1,0],["فسترُ عفوِ إلهِ العالمين على","جميع أمتكَ الغراءِ منسدلُ",28,"ل",1,0],["فستبكّي إن أضحكتْ وستعري","إن كستْ في قيامها المستتبّ",29,"ب",1,0],["فسَتُلقى منها بأهل وسهل","وتُلقَّى الرضا بعُشْر ورحب",29,"ب",1,0],["فستصفو عليه غدر من الس","رد وتضفو ظلال خفق البنود",30,"د",1,0],["فستثني عما قليل على تل","ك الأيادي أنفاسه المندليّه",31,"ي",2,0],["فستعملون إذا نحاكم معلماً","تهفو عليه خوافق الأعلام",32,"م",1,0],["فستَثْني كل طِرْف ظامئ","وهو في ماء الطُّلى قد خوضا",33,"ض",2,0],["فستحكم الرقباء طراً بالعمى","وتسل للواشين كل لسان",34,"ن",1,0],["فستسمعون جوابهم","والحرب أولها شرر",35,"ر",1,0],["فستبقى تعيش دهراً طويلاً","ان سقته أيدي الردى أكوابا",36,"ا",1,0],["فستصغي لصوتك العذب روحي","من سماها والجسم تحت الرغام",37,"م",1,0],["فستصغي لصوتك العذب روحي","من سماها برغم كأس المنون",38,"ن",1,0],["فستبقى بغير أمٍ كئيبا","وحزينا مثلي ليوم القيام",39,"م",1,0],["فستعرفون غداً بعاقبةٍ","عز الإله فأوردوا وقفوا",40,"ف",3,0],["فسترى فوق الذي يُرادُ","والحمد لله به يُزادُ",41,"د",1,0],["فستذكروني عند مشتبك القنا","كالبدر يُذكرُ ليلة الظلماء",42,"ا",2,0],["فَستَسأليني لو رأي","تِ الحالَ مِنِّي مَن أنا",43,"ن",2,0],["فسترسلا كلٌّ على دربه","والقلبُ يبكي خلَّه مولَعُ",44,"ع",1,0],["فستشهدنَّ عليكمُ أعضاؤكم","وستصبحون بألسنٍ خرساءِ",45,"ا",2,0],["فستانها كان التفات","تشعر بحده ف اوله!",46,"ل",2,0],["فَسَتَغْرُبينَ إِذا أَتَيْتُكِ آخَرًا","وَسَتَدْخُلينَ دُجًى أَبى إِشْراقَنا",47,"ن",2,0],["فستحيا روحاً وإن غبت جسماً","وسيفني بقاؤك الآبادا",48,"د",2,0],["فست مئين فترة الدين قد مضت","فلست ترى من يعبد الله أو تلقىد",49,"ق",3,0],["فستحمدون سراكم","ليلاً إذا ما الليل أشمس",50,"س",1,0],["فستدخلون المسجد الأقصى كما","وعد المهيمن في الكتاب الأنور",51,"ر",1,0],["فَسِتُّونَ عَاماً مَا عَقِمْتِ وإنّمَا","جَزَعْتِ فَمَا أنْجَبْتِ إلا ابْنَ هَاْلِكِ",52,"ك",1,0],["فستانُ فقدكِ فوق القلب علَّقني","الحزنُ أسودُ والأشواقُ بيضاءُ",53,"ا",2,0],["فستقبلوها غررا طلقة ً","مع التهاني ووجوهاً وسامْ",54,"م",1,0],["فستنْدمون .. وترجعون بغَصَّة المَوت المماثل","موتوا إذن .. إنَّ الكتائبَ أَعْلنّتْها لا تَنازُل",55,"ل",1,0]]}