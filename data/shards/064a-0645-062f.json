16,"الجوع.. الجوع!","https://www.poetsgate.com/ViewPoem.aspx?id=205221",""],[402,"لذكراك يا حفني في النفس أشجان","https://www.poetsgate.com/ViewPoem.aspx?id=36492",""],[5851,"المدينة الضائعة","https://www.poetsgate.com/ViewPoem.aspx?id=175306",""],[5881,"تبصّر","https://www.poetsgate.com/ViewPoem.aspx?id=184139",""],[6031,"مَعَاهِدُهُمْ بالأبْرقَيْنِ هَوَامِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=46280",""],[6093,"مُشَرَّدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=198050",""],[6096,"من دون وداع","https://www.poetsgate.com/ViewPoem.aspx?id=177528",""],[6171,"ثورة الأيام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84674&r=&rc=4",""],[2220,"توهمت من أهواه خارجَ صورتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11429&r=&rc=303",""],[6318,"رسالة المسجد الأَقصى إلى المسلمين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66163&r=&rc=13",""],[6355,"الطين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66628&r=&rc=88",""],[572,"لستُ على عذلِكَ صَبَّارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9316&r=&rc=173",""]],"verses":[["يَمُدُّ لِلجَرَسِ مِثلَ الآسِتَينِ إِذا","خانَ التَوَجُّسَ أَبصارٌ وَآذانُ",0,"ن",1,0],["يَمُدُّ يَداً مَخبولَةً لِيَنالَني","وَقَد أَعجَزَ الأَيدي الصِحاحَ مَنالي",1,"ل",2,0],["يَمُدُّ بِدُفّاعِ الدِماءِ غُثاؤُها","وَيَجري بِأَعناقِ الرِجالِ حَميلُها",2,"ل",3,0],["يمُدُّ للمَجْدِ باعاً ما بهِ قِصَرٌ","ولا تَخونُ خُطاهُ نحوَهُ القَدَمُ",3,"م",1,0],["يَمُدُّ بِمَا فِالرَّبِيعِ جَامِعَتَيْهِمَا","وَكُلٌّ لَهُ مَرْمَى وَكُلٌّ لَهُ شَانُ",4,"ن",1,0],["يَمُدُّ حِبالَ الأَخدَعَينِ بِسَرطَمٍ","يُقارِبُ مِنهُ تارَةً وَيُطاوِلُه",5,"ل",2,0],["يمدُّ لها الكفٌُّ الخضيب بساعدٍ","ويشكي السماك الأعزل الرمح عاملُ",6,"ل",1,0],["يَمُدُّ عَلى أَكابِرِنا جَناحاً","وَيَكفُلُ في مَواطِنِنا الصِغارا",7,"ر",2,0],["يمدُّ زنداً إلى العلياءِ واريةً","أنوارها وهي ما عيبت وما قدحت",8,"ت",1,0],["يمدُّ آمالها شوقٌ قد اقْتصرت","على هواه فممدود ومقصور",9,"ر",1,0],["يمدّ على الآفاقِ بيضَ خيوطه","فينسج منها للثرى حلةً خضرا",10,"ر",2,0],["يمدُّ لك الله التمكُّن والبقا","ويعطيك ما ترجوه من رتب الفضل",11,"ل",1,0],["يمدُّ بساعدين إلى المعالي","ويتعب في النوال براحتين",12,"ن",1,0],["يَمدُّ إليه حسنُه وجمالُه","خلال بنات الماء عيناً وإصبعا",13,"ع",2,0],["يَمدُدنَ مِن هَفَواتِهِنَّ إِلى الصِبا","سَبَباً يَصِدنَ بِهِ الغُواةُ طُوالا",14,"ل",2,0],["يَمُدُّ المَدى لِلقَومِ حَتّى تَقَطَّعَت","حِبالُ القُوى وَاِنشَقَّ مِنهُ سَبائِبُه",15,"ب",2,0],["يَمُدُّ الدُجى في لَوعَتي وَيَزيدُ","وَيُبدِئُ بَثّي في الهَوى وَيُعيدُ",16,"د",1,1],["يَمُدُّ يَديهِ في المُفاضَةِ ضَيغَمٌ","وَعَينَيهِ مِن تَحتِ التَريكَةِ أَرقَمُ",17,"م",1,0],["يَمُدّونَ أطرافَ القَنَا بخوادِرٍ","كأنّ القَنَا فيها خُطوطُ الرَّواجبِ",18,"ب",1,0],["يَمُدُّ عُبَيدَ اللَهِ فينا سِتارَةً","قَليلاً عَلى سَمعِ الجَليسِ صَوابُها",19,"ه",2,1],["يَمُدّونَ أَنفاسَ الظِلالِ عَلَيهِمُ","بِأَبنِيَةٍ تَعلو سُموكَ قِبابِها",20,"ب",3,0],["يَمُدُّ بِباعٍ مِن تَميمٍ وَيَنتَمي","إِلى سَروِ آباءٍ لَهُ وَجُدودِ",21,"د",1,0],["يَمدَحُهُ القَومُ وَيَهجوهُم","ما شَكَرَ النِعمَةَ هاجيها",22,"ي",3,0],["يُمدُّ بأطرافِ النهارِ وما افتَرى","ولا كانَ خِدْناً للزُّناةِ ولا تِربا",23,"ب",2,0],["يَمُدّهُ المَدْحُ لبذلِ النّدى","كمدّهِ المرهفَ يوم اقتحام",24,"م",1,0],["يمدّ كجيشٍ زاحفٍ فإذا رأى","عَطاءَ عَلِيٍّ كان من مَدّهِ جزرُ",25,"ر",1,0],["يمُدّ كفّاً إليه ضاربةً","أعناقَ أحزانِنا إذا ضرَبَه",26,"ب",2,0],["يَمُدّونَ بِالبيضِ القَواطِعِ أَيدِياً","وَهُنَّ سَواءٌ وَالسُيوفُ القَواطِعُ",27,"ع",1,0],["يَمُدُّ زِمامَهُ طَمَعٌ مُقيمٌ","تَدَرَّعَ ثَوبَهُ رَجُلٌ عَديمُ",28,"م",1,0],["يَمدُدنَ لِلشَرَفِ المُنيفِ صَوادِياً","أَعناقَهُنَّ إِلى حِياضِ السُؤدُدِ",29,"د",1,0],["يَمُدّونَ مِن أَيدٍ عَواصٍ عَواصِمٍ","تَصولُ بِأَسيافٍ قَواضٍ قَواضِبِ",30,"ب",1,0],["يَمُدُّ بِغُرِّ الأَيادي يَداً","تَصاحَبَ فيها النَدى وَالقَلَم",31,"م",1,0],["يُمَدُّ الشَرابُ بِبَردِ الرُضابِ","وَجِنحُ الظَلامِ بِسودِ اللِمَم",31,"م",1,0],["يَمُدُّ إِلَيها البَيتُ كَفَّ مُسَلِّمٍ","وَيُبدي لَها المُختارُ صَفحَةَ باسِمِ",32,"م",1,0],["يَمُدُّ إليها الحاسدُ الطَّرْفَ حَسْرَةً","فَيَرْجِعُ عنها الطَّرْفُ وهْوَ حَسيرُ",33,"ر",1,0],["يُمِدُّكَ عزْمٌ في شَبا السيف قاطعٌ","وبُرثُنُ سَطْوٍ في طُلى الليثِ شابك",34,"ك",1,0],["يَمُدُّهُ كُلُّ وادٍ مُترَعٍ لَجِبٍ","فيهِ رِكامٌ مِنَ اليَنبوتِ وَالخَضَدِ",35,"د",1,0],["يَمُدّونَ لِلطَعنِ الثَعالِبَ في الوَغى","وَآسادُهُم عِندَ اللِقاءِ ثِعالِ",36,"ل",1,0],["يَمِدْنَ إذا أُسْقِينَ منه كأنما","شَرِبنَ به قَبْلَ الضّياء عُقارا",37,"ر",2,0],["يمد عيني عَلى إسبال عبرتها","قَلب أبى الحب أَن يَسطيع سلوانا",38,"ن",2,0],["يمدُّ ذراعيه ويُرسلُ صوتَه","بلوعةِ قلبٍ ذابَ في نبراتِهِ",39,"ه",1,0],["يَمُدُّ فوقَ القبرِ منه الجناحْ","ويرسل المنقارَ في ركنهِ",40,"ه",1,0],["يمد له الظن آماله","ولكنها عن قليل تجذ",41,"ذ",1,0],["يَمُدُّ يَداً دُونَ الثِّمَارِ كَأَنَّمَا","يُحَاوِلُ مِنْهَا غَايَةً ثُمَّ يَنْكُصُ",42,"ص",1,0],["يَمُدُّ شُعَاعُ الشَّمْسِ فِي حَجَراتِهَا","سَلاسِلَ مِنْ نُورٍ لَهُنَّ بَرِيقُ",43,"ق",1,0],["يَمُدُّ فَدْمٌ إِلى شَخْ","صِهِ يَداً عَسْرَاءَ",44,"ا",2,0],["يَمْدَحُ الْمُصْطَفَى فَتَلْمَحُ حُبّاً","عَاصِفاً آخِذاً عَلَيْهِ كِيَانَه",45,"ن",2,0],["يمدُّ يَدَيه نحوكِ في حنانٍ","ويغمرُكِ اعتناقاً واستلاما",46,"م",2,0],["يُمِدُّ الشعوب بكل قواها","وتذهبُ شوكتُها إن ذهب",47,"ب",1,0],["يمد إلى الأرواح كفيه خلسة","فلا الرأس مقطوع ولا الدم منصب",48,"ب",1,0],["يمدّ رؤياه الى لا مدىّ","ويذرع الأوهام عرضا وطول",49,"ل",1,0],["يُمدُّكُمُ بروح من خُطوبٍ !","تعوَّدَ انْ يمدَّ بها الصِراعا",50,"ع",2,0],["يَمُدُّ يداً تُعطي الضّعافَ حُقوقَهُمْ","ويَسْطو بأخرى باطشاً غيرَ راحم",51,"م",1,0],["يمدُّ الدُّجى في لوعتي ويزيدُ","ويُبدِىء ُ بَثِّي في الهوى ويُعيدُ",52,"د",1,1],["يَمُدّهُ كلُّ وادٍ مُتْرَعٍ، لجِبٍ،","فيه ركامٌ من الينبوتِ والحضدِ",53,"د",1,0],["يَمدُّ لِصَيد المَدح مِني حِبالَهُ","عَلى الغَدر مَعقود بِأَطرافِهِ الكذب",54,"ب",1,0],["يمدحُ العجلةَ يا ذَا","وهي أسبابُ المَنيِّه",55,"ي",2,0],["يُمَدُّ بِفَيضٍ صَادِرٍ عَن بِصَيرَةٍ","سَجَنجَلُهَا صَافٍ مُضِىءٌ ومُقمِرُ",56,"ر",1,0],["يمد يد الراجي المحدث نفسه","بنيل الأماني منك يا جبر الكسر",57,"ر",1,0],["يَمُدُ مُدىً تُلَّقب بالمجَارِي","وليس لمُدْيَةٍ منْها قِراب",58,"ب",1,0],["يمدُّ يدي