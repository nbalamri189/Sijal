4,"قل لعيني لا تملا الدموعا","https://www.aldiwan.net/poem47711.html","الخفيف"],[554,"لا تلمني على الهوى","https://www.aldiwan.net/poem47828.html","مجزوء الخفيف"],[554,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"],[561,"تبارك الله ما في الدار ديار","https://www.aldiwan.net/poem34533.html","البسيط"],[561,"كتاب الله جامع كل شيء","https://www.aldiwan.net/poem34669.html","الوافر"],[566,"غرام سقى قلبي مدامته صرفا","https://www.aldiwan.net/poem13596.html","الطويل"],[566,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[570,"أي حراك غال منك السكون","https://www.aldiwan.net/poem69478.html","السريع"],[570,"له شغل عن سؤال الطلل","https://www.aldiwan.net/poem69529.html","المتقارب"],[570,"حبذا الزائر في وقت السحر","https://www.aldiwan.net/poem69697.html","الرمل"],[578,"لا تسل عنه كيف أصبح حاله","https://www.aldiwan.net/poem3028.html","الخفيف"],[578,"عاد قلب الشوق إذ عدت عيده","https://www.aldiwan.net/poem3077.html","الخفيف"],[589,"يا أقتل الناس ألحاظا وأعذبهم","https://www.aldiwan.net/poem18009.html","البسيط"]],"verses":[["أَيَمنَعُني خَوفُ الرَّدى أَن أَزورَها","وَأَروَحُ مِن صَبري عَلى هَجرِها القَتلُ",0,"ل",1,0],["أَيَمْشِي بِعِرْضِي في الأَراذِلِ خامِلٌ","خَفِيُّ مَساري العِرْقِ مُؤْتَشَبُ النَّسَبْ",1,"ب",1,0],["أَيَمضِي الشَّبابُ الغَضُّ قَبْلَ وَقَائِعٍ","يَكادُ حِجابُ الشَّمسِ فيهنَّ يُهْتَكُ",2,"ك",1,0],["اَيّما خُطَّةٍ أَرَدتُم فَأَدّ","ها إِلَينا تَمشي بِها الأَملاءُ",3,"ا",2,0],["أَئِمَّةُ قَومٍ يُهتَدى بِهُداهُم","لَحى اللَهُ مَن إِيّاهُمُ يَتَنَقَّصُ",4,"ص",1,0],["أَئِمَّةُ عَدْلٍ أَوْضَحُوا سُبُلَ الْهُدَى","وَسُحْبُ نَوَالٍ لاَ تَشِحُّ غُيُومُهُ",5,"م",2,0],["أيُّ مجْدٍ أُحْكِمَتْ آياتُهُ","فهْيَ تُتْلى مثْلَما تُتْلي السُّوَرْ",6,"ر",1,0],["أَيُّ مَكرٍ يَدِقُّ عَن ذِهنِ سَعدٍ","أَيُّ خَتلٍ يُريغُ مِنهُ اِضطِرابا",7,"ب",2,0],["أَي مَكمَهونُ قَدِمتَ بِال","قَصدِ الحَميدِ وَبِالرِعايَه",8,"ا",3,1],["أَيَموتُ سَعدٌ قَبلَ أَن نَحيا بِهِ","خَطبٌ عَلى أَبناءِ مِصرَ جَليلُ",9,"ل",1,0],["أي ماء عذبٍ وأي هواءٍ","أرج في الرياض والأدغال",10,"ل",1,0],["أَيْ مُصْطَفَى أَلْقَيْتَ دَرْساً عَلَّهُ","يَبْقَى لَدَى الْفِتْيَانِ نُصْبَ عُيُونِ",11,"ن",1,0],["أَيَّمْتَ نَائِحَةً عَلَيْكَ وَفِيَّةً","فَهْيَ الغَدَاةُ جَلِيلَةُ الأَحْزَانِ",12,"ن",1,0],["أيْ مُصْطَفَى مَا لِلْوفُودِ تَبَدَّلُوا","من طَيِّبَاتِ قِرَاكَ بِالأَحْزَانِ",13,"ن",1,0],["إيمانُهُ الوَضَّاحُ نَجْمٌ ثَابِتٌ","فِي القُطْبِ وَالأَفْلاَكِ فِي الدَّوَرَانِ",14,"ن",1,0],["أيْ مُصطَفَى يَبْكِيكَ قَوْمُكَ كُلَّمَا","عَادَتْهُمُو ذِكْرَى فَتَى الفِتْيَانِ",15,"ن",1,0],["إِيمَانُهَا لا تَسْتَقِلُّ بِهِ الرُّبَى","كَيْفَ اسْتَقَلَّ بِهِ مَزَاجُ نَسِيمِ",16,"م",1,0],["أَي مَدْحٍ مُبْلِغٍ قَائِلِيهِ","بَعْضُ مَا تَقْتَضِي مَنَاقِبُ هَاشِمْ",17,"م",1,0],["إِيمانُنَا بِخُلُودِ نَفْسِكَ فِي العُلَى","يَأْسُو جَوَانِحَنَا وَهُنَّ دَوَامِ",18,"م",1,0],["أَيُّ مَجْدٍ أَنْشَأْتَهُ يَا فَتَى الرأْ","يِ فَبَاهَى بِكَ المُلُوكَ العِظَامَا",19,"م",2,0],["أي مجال فيه للنزيها","وام يجمع من مرافق",20,"ق",1,0],["أئمة الكفر ما يَمَّمْتَ ساحتها","إلا وقد زُلزلتْ قسراً صياصيها",21,"ي",3,0],["أي مقام هيجاؤه احتدمت","بالشعر يوماً ولم يكن بطله",22,"ل",2,0],["أيُمسي لشِرك العدى مَلعَباً","وكان لتَوحيدنا مَعَبقا",23,"ق",2,0],["إيمان حبٍّ إلى الأوطانِ حرَّكهُ","حتَّى قضى نحبه يا طول منتحب",24,"ب",1,0],["أيُّ مصباح قادحٍ زاد في الإص","باح نُوراً إن لم نكن جُهَلاءَ",25,"ا",2,0],["أيّما روضةٍ رأيتَ يدَ الأي","يام في عبقريةٍ خضراءِ",26,"ا",2,0],["أي مَغْنىً سواك بعدك يُؤْوِي","نِيَ والناس يطردونَ طريدَكْ",27,"ك",1,0],["أيُّما كَوْسَج يراها فيلقَى","ربه بعدها صحيحَ الضميرِ",28,"ر",1,0],["أيُمطَرُ من صُغرَى بنانك جانبي","وقد أمطرَتْ قوماً أناملُك العشر",29,"ر",1,0],["أيمانٌ وتشتُمُ الفرسَ أوْلى","لك لا يلتقي رُقيُّ وهَبْط",30,"ط",1,0],["أيّما منظرٍ تزودْتُ منه","يومَ رُدّت جِمالُها لاحتمالِ",31,"ل",1,0],["أيمنُ ذي طائر وأَجْدرُه","أن تلزَم الصالحاتُ مَنْ لزما",32,"م",2,0],["أيُمينُهُمْ أسفاً ويطلب رِفْدَهُمْ","لقد اغتدى في الظُّلْم والعُدُوان",33,"ن",1,0],["أَيَمرَحُ البومُ في الخَلاءِ","وَتُمسِكُ البُلبُلَ الهُمومُ",34,"م",1,0],["ايمل يوسف فوق دجلة قصره","وينام تحت الارض ثم ينام",35,"م",1,1],["أيموت زهر الروض وهو معزز","ويعيش شوك الروض وهو مهان",36,"ن",1,0],["أيُمنح منك القرب من سار ذمه","ويمنع منك اللفظ من سار حمده",37,"د",2,0],["أَيُّ ملُكٍ مِن بِناياتِ الهِمَم","أَسَّسَ الداخِلُ في الغَربِ وَشاد",38,"د",1,0],["أَي ماءٍ يَدورُ في وجهكَ الحُ","ر إذا ما امْتَهَنْتَهُ بالسؤالِ",39,"ل",1,0],["إيما لِإِبقاءٍ عَلى فَضلِهِ","إيما لِتَسليمٍ إِلى رَبِّهِ",40,"ب",2,0],["أَيَموتُ مِثلُ أَبي شُجاعٍ فاتِكٌ","وَيَعيشُ حاسِدُهُ الخَصِيُّ الأَوكَعُ",41,"ع",1,0],["أَيَّ مَحَلٍّ أَرتَقي","أَيَّ عَظيمٍ أَتَّقي",42,"ق",2,1],["أَيَملِكُ المُلكَ وَالأَسيافُ ظامِئَةٌ","وَالطَيرُ جائِعَةٌ لَحمٌ عَلى وَضَمِ",43,"م",1,0],["أيمنُ مولود رأيناه في","علومنا مولودنا الأخضر",44,"ر",1,1],["أَيُّما خُطَّةٍ تَعودُ بِضَرٍّ","فَهُوَ لِلمُسلِمينَ مِنها جارُ",45,"ر",1,0],["أَيُّ مَحلٍ عَرا فَكَفُّكَ غَيثٌ","أَو ظَلامٍ دَجا فَوَجهُكَ نورُ",46,"ر",1,0],["أَيُّما خُلَّةٍ وَوَصلٍ قَديمِ","صَرَمَتهُ مِنّا ظِباءُ الصَريمِ",47,"م",1,1],["أيمينُكَ البحرُ الخضمُّ إذا طمتْ","أمواجُهُ أم صدرُكَ الدَّهناءُ",48,"ا",2,0],["أَيُّ مُلكٍ كانَ فيها لِقَومٍ","قَبلَنا لَم يُسلَبوهُ استِلابا",49,"ب",2,0],["أي مكان بهوانا يضيق","فامض بنا إن زحام الطريق",50,"ق",1,0],["أَيُّما حُرَّةٍ مِنَ الناسِ جادَت","لِخَليلٍ بِالمَهرِ بَعدَ الطلاقِ",51,"ق",1,0],["أَيُّ مُنادٍ إِلى النَدى وَإِلى الهَي","جاءِ ناداهُمُ فَلَم يُجَبِ",52,"ب",1,0],["أَيُّ مُحِبٍّ تَمَّ السُرورُ لَهُ","لَم يَلقَ مِن لَوعَةِ الهَوى طُرَفا",53,"ف",2,0],["أَيُّ مُداوٍ لِلمَحلِ نائِلُهُ","وَهانِئٍ لِلزَمانِ مِن جَرَبِه",54,"ب",2,0],["أَيُّ مَرعى عينٍ وَوادي نَسيبِ","لَحَبَتهُ الأَيّامُ في مَلحوبِ",55,"ب",1,1],["أيمضي لي نهارٌ لم يرعْني","ويتركني الزمانُ بلا زفيرِ",56,"ر",1,0],["أيُّ مريضٍ طبَّهُ طمَّهُ","وأيُّ طرْفٍ ذرَّهُ ضرَّهُ",57,"ر",2,0],["أَيُّ مَن تَجمَعُ المَواسِمُ قَولي","وَأَبيني لَنا وَلا تَكتُمينا",58,"ن",2,0],["أَيَّما أَن يَكونَ كانَ هَوىً مِن","كَ فَزادَ الإِلَهُ فيهِ وَتَمّا",59,"م",2,0],["أَيُّ مَلكٍ كانَ لَولا","عارِضٌ وافى فَوَلّى",60,"ل",2,0],["أيّ مُلكٍ مِثْلُ ذا المُلْكِ العظيمْ","يتجلىَّ في سَلامٍ وَنَعيمْ",61,"م",1,0],["أَيُمْسِي عبيدُ العجلِ للنّاسِ سادةً","وما عرفوا منهم على الدّهر سيّدا",62,"د",2,0],["أئمَّةُ الرُّشدِ جاءتهم رسالتُهم","فلا عَمىً حين جاءتهم ولا صَمَمُ",63,"م",1,0],["إيمانُ أحبارٍ وفِقهُ أئمّةٍ","ذَهبوا فَضاعَ على يدِ الفُقهاءِ",64,"ا",2,0],["أئِمَّةُ نَجدةٍ ودُعاةُ حقِّ","أقاموا المجدَ مُمتَنِعَ البناءِ",65,"ا",2,0],["أَيُّ مُلكٍ لَم يُزَلزِل رُكنَهُ","مُلكُ خوفو وَرَعمسيسَ الأَغَرّْ",66,"ر",1,0],["إيماءَةُ المَوتِ في عُنوانِهِ وَضَحَت","وَالمَوتُ أَبلَغُ مَن يُومي بِعُنوانِ",67,"ن",1,0],["أَيملِكُ باطِلُكُم أَن يَسودَ","وَقَد وَضَحَ الحَقُّ ذو البَيِّناتِ",68,"ت",1,0],["أَيَمنَحُ البائِسُ المِسكينُ بُردَتَهُ","وَيَمنَعُ المالَ مُثرٍ عَيشُهُ خَضِلُ",69,"ل",1,0],["أيَّما خُطَّةٍ أردتَ فلا مَعْ","دَلَ عنها وحيثما كنتَ كانوا",70,"ن",3,0],["أيُّ مجدٍ في الأرضِ أو أيُّ فضلٍ","لم يكونوا له أساساً وَجِذْما",71,"م",2,0],["إيمانُ حُرٍّ لا يُبالي كلّما","ركبَ العظائِمَ أن يهولَ المركب",72,"ب",1,0],["أَي مَجد مثله مَهما سَما","إِنَّهُ نور يُضيء الأَنجُما",73,"م",2,0],["أَيُّما شاطِنٌ عَصاهُ عَكاهُ","ثُمَّ يُلقى في السِجنِ وَالأَغلالِ",74,"ل",1,0],["أَئِمَّةُ الدِّينِ كلٌّ في محاوَلَةٍ","إلى صوابِ اجتهادِ منه مَوْكُولُ",75,"ل",1,0],["أيَّ مَفْقُودَيكَ تبكيه أبٌ","هِبْرِزِيٌّ أنتَ منه أمْ وَلد",76,"د",1,0],["أَيَّما طارِقٍ أَصابَكَ يا طا","رِقُ حَتّى مَساكَ لِلغَيِّ ماسي",77,"س",2,0],["أيُّ مَن وافى حَزيناً حَزْنَها","سُرّ لو رَوّحَ سِرّي سِرّ أيّ",78,"ي",1,0],["إيمانُ ذي الإيمانِ أَعظَمُ ثَروَةٍ","وَيَقينُ ذي الوِجدانِ أَفضَلُ مَنجَمِ",79,"م",1,0],["إيما لإبقاءٍ على فضله","إيما لتسليمٍ على ربّه",80,"ب",2,0],["أيمرحُ في الكونِ شيطانُهُ","بلا وازعٍ وبلا زاجرِ",81,"ر",1,0],["أَيُّ مِثَالٍ غال وَعَالٍ","لِلْصُدْقِ فِي الرَّأْيِ وَالجِّهَادِ",82,"د",1,0],["إِيمَانُكِ الحَيِّ وَهّذَا وَقْتُهُ","يُهِّنُ الْبَلْوَى وَيَأْتِي العَجَبَا",83,"ب",2,0],["أَيُّ مَجْدٍ لِمِثْلِهِ فَوْقَ هَذَا","بَيْنَ قَوْمٍ كَقَوْمِهِ مَأْمُولُ",84,"ل",1,0],["أَيُّ مُلْقٍ إِلَى الفَصَاحَةِ سَمْعاً","لَمْ يُخامِرْهُ مِنْ بَيَانِكَ سُكْرُ",85,"ر",1,0],["أَيَّ مُسْتَشْرِفٍ ش