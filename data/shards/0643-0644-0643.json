{"poems":[[41,"كل كرب أنت لاق","https://www.aldiwan.net/poem42378.html","مجزوء الرمل"],[51,"للحريثي أبي بكر غبب","https://www.aldiwan.net/poem8500.html","الرمل"],[51,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[91,"أعلى عيني من الدمع غشاء","https://www.aldiwan.net/poem62753.html","عموديه"],[85,"إن تسألي عن مصر حواء القرى","https://www.aldiwan.net/poem8089.html","الكامل"],[66,"كل كأس من غير خم","https://www.aldiwan.net/poem38520.html","مجزوء الخفيف"],[102,"شيعي الليل وقومي استقبلي","https://www.aldiwan.net/poem32992.html","الرمل"],[102,"لا تبالي بألف خطب عراها","https://www.aldiwan.net/poem32997.html","الخفيف"],[102,"هاجر أمنا ولود رؤوم","https://www.aldiwan.net/poem33099.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85593","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85322","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85555","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30449",""],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[142,"ما ضاع من أيامنا هل يغرم","https://www.aldiwan.net/poem58446.html","الكامل"],[147,"أنا حق أنا خلق","https://www.aldiwan.net/poem47618.html","مجزوء الرمل"],[185,"عندنا كيزان فقا","https://www.aldiwan.net/poem14540.html","مجزوء الرمل"],[229,"يأيها المعشوق لا فارقت","https://www.aldiwan.net/poem50918.html","السريع"],[285,"لامني بعض رجال العلم","https://www.aldiwan.net/poem39356.html","مجزوء الرمل"],[361,"سيدي بالذي اصطفاك وحيدا","https://www.aldiwan.net/poem68134.html","الخفيف"],[400,"حداء على أسطول الحرية","https://www.aldiwan.net/poem6743.html","عموديه"],[403,"غصن شوق علاه قلبي وغرد","https://www.aldiwan.net/poem33977.html","الخفيف"],[405,"كلكم قد أخذ الجام","https://www.aldiwan.net/poem49459.html","مجزوء الرمل"],[458,"أتراها يوم صدت أن أراها","https://www.aldiwan.net/poem55814.html","الرمل"],[458,"لله ساع بلغته قدمه","https://www.aldiwan.net/poem55865.html","الرجز"],[458,"يا دار ما أبقت الليالي","https://www.aldiwan.net/poem55948.html","مخلع البسيط"],[458,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[458,"تمد بالآذان والمناخر","https://www.aldiwan.net/poem56185.html","الرجز"],[458,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[529,"دمت رب الإصدار والإيراد","https://www.aldiwan.net/poem37449.html","الخفيف"],[561,"الحمد لله الذي استقلت","https://www.aldiwan.net/poem27845.html","الرجز"],[562,"تحت الثرى سيصير من فوق الثرى","https://www.aldiwan.net/poem52774.html","الكامل"],[575,"ويح نفس مغطره","https://www.aldiwan.net/poem2948.html","مجزوء الخفيف"]],"verses":[["كُلُّ كَربٍ أَنتَ لاَقٍ","بَعدَ بَلوَاهُ انفِرَاجَا",0,"ج",2,1],["كلُّكُمْ آل حُريثٍ عُرَّةٌ","لعن الله حريثاً وكَتَبْ",1,"ب",1,0],["كلُّكُمْ ماجِدٌ ولم يُرَ فيكم","ماجدٌ قَطُّ ذُو أبٍ مَمْجُودِ",2,"د",1,0],["كُلُّكُم يا قَومُ في البَلوى سَواء","لا أَرى في الرُزءِ لُبناناً وَشام",3,"م",1,0],["كُلٌّ كَأَهلِ الكَهفِ فَوقَ سَريرِهِ","وَالدَهرُ دونَ سَريرِهِ بِهِجارِ",4,"ر",1,0],["كُلُّ كَأسٍ مِن غَيرِ خَم","رَةِ مَعناكَ لي قَدَح",5,"ح",1,1],["كلكم يَنشأُ قَلباً وَيداً","وَلِساناً في جِهاد المبطلِ",6,"ل",1,0],["كلكم بارعٌ بليغٌ بحمد ال","لَهِ طَبٌّ بحالنا ودواها",7,"ا",3,0],["كُلكم شاهد عَلى الحَق زوراً","هَل أَتاكُم مِن شَأنِهِ تَحريم",8,"م",1,0],["كلكم قد فزتم برحمة لَيلى","غير أني منيت بالإخفاق",9,"ق",1,0],["كل كرب يا أيها الحي فاصبر","ينتهي عند ما يجيءُ الممات",10,"ت",1,0],["كل كون فانه لفسادٍ","كل جمعٍ فإنه لشتات",11,"ت",1,0],["كُلٌّ كأَنْ لم يكُنْ تَقَضَّى","وشُؤمُه حاضِرٌ عَتِيدُ",12,"د",1,0],["كُلٌّ كَرُبَّانٍ يُدِيرُ","زِمَامَ فلْكٍ طَيِّعِ",13,"ع",1,0],["كلُّ كِتْرٍ فِي المَبَانِي رَفَعَتْ","فوْقَه سُخْرِيَة الشَّعْلولِ كِتْرَا",14,"ر",2,0],["كلٌّ كنَى عن شوقِه بلغاتهِ","ولربّما أبكَى الفصيحَ الأعجمُ",15,"م",1,0],["كل كون ذاك كوني","أنا وحدي أنا فرد",16,"د",1,0],["كلُّ كوزٍ قد تَزَيَّى","وَتَردَّى وتَعطَّر",17,"ر",1,0],["كُلُّكَ يا معشوقُ مما غدا","إليه كُلُّ اللّحظ تَوّاقُ",18,"ق",1,0],["كلكم عندي اخوا","ن أجلاء الجناب",19,"ب",1,0],["كل كرب قاساه مثلي محب","لَيسَ يحكي وَلا يُقارِب كُربك",20,"ك",1,0],["كلكم واللهِ في مستنقعٍ","من تداعيكم علينا تغرقون",21,"ن",1,0],["كُلُّكُم حاصرها في سجنِه","كلكم في ظلمها تجتمعون",21,"ن",1,0],["كل كأس من الخلاعة والجه","ل وعار من الكمال مجرد",22,"د",1,0],["كُلُّكُمْ قدْ أخذَ الجا","مَ ولا جامَ لَنا",23,"ن",2,1],["كلّ كفّ قد براها الله من","طينةٍ ليّنةٍ يومَ براها",24,"ا",3,0],["كلُّ كريم منطقٍ شاعرُهُ","وأنتَ من فَرْط السماح تُفحِمُهْ",25,"م",2,0],["كلّ كريم الوجهين يرمي","سؤدُدَ عمٍّ بمجد خالِ",26,"ل",1,0],["كلّ كنزٍ في الأرض تأكلُه الأر","ضُ وكنزي مؤبَّد مذخورُ",27,"ر",1,0],["كلّ كريم لاسمه في مجدها","مالأسانيد الحديث السائرِ",28,"ر",1,0],["كلُّ كريمٍ أو فتىً كاملٍ","وفاعلٍ أو قائلٍ مُعربِ",29,"ب",1,0],["كُلُّ كَرْبٍ يَتْلوهُ فيما عَلِمْنا","فَرَجٌ كافِلٌ بِنَيْلِ الْمُرادِ",30,"د",1,0],["كَلكَلَها لَولا الإِلَهُ ضَرَّتِ","في ظُلَمٍ أَزَلَّها فَزَلَّتِ",31,"ت",1,0],["كلٌّ كصاحِبهِ يموتُ وإنَّما","شَتَّانَ ما بينَ الثُّرَيَّا والثَّرَى",32,"ا",1,0],["كُلُّ كُحْلٍ سوى التَّكَحُّ","لِ في جَفْنِها مَرَه",33,"ر",2,0]]}