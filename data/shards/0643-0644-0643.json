{"poems":[[43,"كل كرب أنت لاق","https://www.aldiwan.net/poem42378.html","مجزوء الرمل"],[53,"للحريثي أبي بكر غبب","https://www.aldiwan.net/poem8500.html","الرمل"],[53,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[93,"أعلى عيني من الدمع غشاء","https://www.aldiwan.net/poem62753.html","عموديه"],[87,"إن تسألي عن مصر حواء القرى","https://www.aldiwan.net/poem8089.html","الكامل"],[68,"كل كأس من غير خم","https://www.aldiwan.net/poem38520.html","مجزوء الخفيف"],[104,"شيعي الليل وقومي استقبلي","https://www.aldiwan.net/poem32992.html","الرمل"],[104,"لا تبالي بألف خطب عراها","https://www.aldiwan.net/poem32997.html","الخفيف"],[104,"هاجر أمنا ولود رؤوم","https://www.aldiwan.net/poem33099.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85593","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85322","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85555","الخفيف"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30449",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[146,"ما ضاع من أيامنا هل يغرم","https://www.aldiwan.net/poem58446.html","الكامل"],[151,"أنا حق أنا خلق","https://www.aldiwan.net/poem47618.html","مجزوء الرمل"],[189,"عندنا كيزان فقا","https://www.aldiwan.net/poem14540.html","مجزوء الرمل"],[234,"يأيها المعشوق لا فارقت","https://www.aldiwan.net/poem50918.html","السريع"],[290,"لامني بعض رجال العلم","https://www.aldiwan.net/poem39356.html","مجزوء الرمل"],[366,"سيدي بالذي اصطفاك وحيدا","https://www.aldiwan.net/poem68134.html","الخفيف"],[406,"حداء على أسطول الحرية","https://www.aldiwan.net/poem6743.html","عموديه"],[409,"غصن شوق علاه قلبي وغرد","https://www.aldiwan.net/poem33977.html","الخفيف"],[411,"كلكم قد أخذ الجام","https://www.aldiwan.net/poem49459.html","مجزوء الرمل"],[463,"أتراها يوم صدت أن أراها","https://www.aldiwan.net/poem55814.html","الرمل"],[463,"لله ساع بلغته قدمه","https://www.aldiwan.net/poem55865.html","الرجز"],[463,"يا دار ما أبقت الليالي","https://www.aldiwan.net/poem55948.html","مخلع البسيط"],[463,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[463,"تمد بالآذان والمناخر","https://www.aldiwan.net/poem56185.html","الرجز"],[463,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[534,"دمت رب الإصدار والإيراد","https://www.aldiwan.net/poem37449.html","الخفيف"],[566,"الحمد لله الذي استقلت","https://www.aldiwan.net/poem27845.html","الرجز"],[567,"تحت الثرى سيصير من فوق الثرى","https://www.aldiwan.net/poem52774.html","الكامل"],[580,"ويح نفس مغطره","https://www.aldiwan.net/poem2948.html","مجزوء الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138420",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48795","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48559","الرمل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48804","الرمل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48797","الخفيف"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99983","الخفيف"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145808","الخفيف"],[1026,"","https://poetry.dctabudhabi.ae/diwan/poem/73563","البسيط"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126148","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46561","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79854","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66286","الكامل"],[1840,"","https://poetry.dctabudhabi.ae/diwan/poem/216639",""],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125402","الرمل"],[2053,"","https://poetry.dctabudhabi.ae/diwan/poem/132441","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53130","المنسرح"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77362","الخفيف"],[2420,"","https://poetry.dctabudhabi.ae/diwan/poem/95961","الرجز"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60892","الخفيف"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60880","السريع"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118804","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65421","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89118","الرجز"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216363","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128922","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111427","الخفيف"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102738","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73406","الخفيف"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58179","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72912","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72468","الخفيف"],[4702,"انتي عن اربع وبعدك يحرم الطاري","https://www.poetsgate.com/ViewPoem.aspx?id=155324",""],[4702,"وردة الساقي","https://www.poetsgate.com/ViewPoem.aspx?id=155328",""],[4728,"خشف ريم","https://www.poetsgate.com/ViewPoem.aspx?id=176880",""],[4764,"حَضرة معاليك","https://www.poetsgate.com/ViewPoem.aspx?id=29533",""],[4858,"انصروا الله تنالوا نصره","https://www.poetsgate.com/ViewPoem.aspx?id=30637",""],[4869,"البرد","https://www.poetsgate.com/ViewPoem.aspx?id=151569",""],[5055,"حب الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=101652",""],[5198,"كلّك نظر","https://www.poetsgate.com/ViewPoem.aspx?id=135393",""],[5213,"أعلى السفح تعرفت الديارا","https://www.poetsgate.com/ViewPoem.aspx?id=170459",""],[5264,"عذاب","https://www.poetsgate.com/ViewPoem.aspx?id=177738",""],[5335,"غطرسه","https://www.poetsgate.com/ViewPoem.aspx?id=35191",""],[5377,"الأمن الزائف","https://www.poetsgate.com/ViewPoem.aspx?id=61898",""],[5431,"لن تضيع الأصول عند الحصاد","https://www.poetsgate.com/ViewPoem.aspx?id=196628",""],[5526,"شابت وجيه الليالي في مخيل الصبر","https://www.poetsgate.com/ViewPoem.aspx?id=215489",""],[5749,"لي ضربتو يدو","https://www.poetsgate.com/ViewPoem.aspx?id=46505",""],[5790,"كل كليل الذهن إن قدته","https://www.poetsgate.com/ViewPoem.aspx?id=111938",""],[5848,"ارتباك وضياع","https://www.poetsgate.com/ViewPoem.aspx?id=53096",""],[5848,"ابعد نافذة","https://www.poetsgate.com/ViewPoem.aspx?id=53450",""],[5848,"كسرة وسكون وضمة وفتحة","https://www.poetsgate.com/ViewPoem.aspx?id=49224",""],[5848,"لا صار خلك عسل","https://www.poetsgate.com/ViewPoem.aspx?id=53365",""],[5956,"البلدة السعيدة","https://www.poetsgate.com/ViewPoem.aspx?id=185792",""],[5956,"كلكم ذوقٌ","https://www.poetsgate.com/ViewPoem.aspx?id=194455",""],[5997,"لَا تلُوْمِيْنِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=214225",""],[6001,"كلمه ومعناها","https://www.poetsgate.com/ViewPoem.aspx?id=411",""],[6052,"بشرى النبوة","https://www.poetsgate.com/ViewPoem.aspx?id=34805",""],[6127,"صوتك النور","https://www.poetsgate.com/ViewPoem.aspx?id=191300",""]],"verses":[["كُلُّ كَربٍ أَنتَ لاَقٍ","بَعدَ بَلوَاهُ انفِرَاجَا",0,"ج",2,1],["كلُّكُمْ آل حُريثٍ عُرَّةٌ","لعن الله حريثاً وكَتَبْ",1,"ب",1,0],["كلُّكُمْ ماجِدٌ ولم يُرَ فيكم","ماجدٌ قَطُّ ذُو أبٍ مَمْجُودِ",2,"د",1,0],["كُلُّكُم يا قَومُ في البَلوى سَواء","لا أَرى في الرُزءِ لُبناناً وَشام",3,"م",1,0],["كُلٌّ كَأَهلِ الكَهفِ فَوقَ سَريرِهِ","وَالدَهرُ دونَ سَريرِهِ بِهِجارِ",4,"ر",1,0],["كُلُّ كَأسٍ مِن غَيرِ خَم","رَةِ مَعناكَ لي قَدَح",5,"ح",1,1],["كلكم يَنشأُ قَلباً وَيداً","وَلِساناً في جِهاد المبطلِ",6,"ل",1,0],["كلكم بارعٌ بليغٌ بحمد ال","لَهِ طَبٌّ بحالنا ودواها",7,"ا",3,0],["كُلكم شاهد عَلى الحَق زوراً","هَل أَتاكُم مِن شَأنِهِ تَحريم",8,"م",1,0],["كلكم قد فزتم برحمة لَيلى","غير أني منيت بالإخفاق",9,"ق",1,0],["كل كرب يا أيها الحي فاصبر","ينتهي عند ما يجيءُ الممات",10,"ت",1,0],["كل كون فانه لفسادٍ","كل جمعٍ فإنه لشتات",11,"ت",1,0],["كُلٌّ كأَنْ لم يكُنْ تَقَضَّى","وشُؤمُه حاضِرٌ عَتِيدُ",12,"د",1,0],["كُلٌّ كَرُبَّانٍ يُدِيرُ","زِمَامَ فلْكٍ طَيِّعِ",13,"ع",1,0],["كلُّ كِتْرٍ فِي المَبَانِي رَفَعَتْ","فوْقَه سُخْرِيَة الشَّعْلولِ كِتْرَا",14,"ر",2,0],["كلٌّ كنَى عن شوقِه بلغاتهِ","ولربّما أبكَى الفصيحَ الأعجمُ",15,"م",1,0],["كل كون ذاك كوني","أنا وحدي أنا فرد",16,"د",1,0],["كلُّ كوزٍ قد تَزَيَّى","وَتَردَّى وتَعطَّر",17,"ر",1,0],["كُلُّكَ يا معشوقُ مما غدا","إليه كُلُّ اللّحظ تَوّاقُ",18,"ق",1,0],["كلكم عندي اخوا","ن أجلاء الجناب",19,"ب",1,0],["كل كرب قاساه مثلي محب","لَيسَ يحكي وَلا يُقارِب كُربك",20,"ك",1,0],["كلكم واللهِ في مستنقعٍ","من تداعيكم علينا تغرقون",21,"ن",1,0],["كُلُّكُم حاصرها في سجنِه","كلكم في ظلمها تجتمعون",21,"ن",1,0],["كل كأس من الخلاعة والجه","ل وعار من الكمال مجرد",22,"د",1,0],["كُلُّكُمْ قدْ أخذَ الجا","مَ ولا جامَ لَنا",23,"ن",2,1],["كلّ كفّ قد براها الله من","طينةٍ ليّنةٍ يومَ براها",24,"ا",3,0],["كلُّ كريم منطقٍ شاعرُهُ","وأنتَ من فَرْط السماح تُفحِمُهْ",25,"م",2,0],["كلّ كريم الوجهين يرمي","سؤدُدَ عمٍّ بمجد خالِ",26,"ل",1,0],["كلّ كنزٍ في الأرض تأكلُه الأر","ضُ وكنزي مؤبَّد مذخورُ",27,"ر",1,0],["كلّ كريم لاسمه في مجدها","مالأسانيد الحديث السائرِ",28,"ر",1,0],["كلُّ كريمٍ أو فتىً كاملٍ","وفاعلٍ أو قائلٍ مُعربِ",29,"ب",1,0],["كُلُّ كَرْبٍ يَتْلوهُ فيما عَلِمْنا","فَرَجٌ كافِلٌ بِنَيْلِ الْمُرادِ",30,"د",1,0],["كَلكَلَها لَولا الإِلَهُ ضَرَّتِ","في ظُلَمٍ أَزَلَّها فَزَلَّتِ",31,"ت",1,0],["كلٌّ كصاحِبهِ يموتُ وإنَّما","شَتَّانَ ما بينَ الثُّرَيَّا والثَّرَى",32,"ا",1,0],["كُلُّ كُحْلٍ سوى التَّكَحُّ","لِ في جَفْنِها مَرَه",33,"ر",2,0],["كل كريم فاضل شهمٌ أخو","خلق بكل دماثة مزدان",34,"ن",1,0],["كلكم يطلب الزعامة في مص","ر ولو كان في الحياة ابنَ عشر",35,"ر",1,0],["كلكم أصبح في غفلتِهِ","حائراً لم يدر من حيرتهِ",36,"ه",1,0],["كلكم مارس في الح","كم عناء الحاكمينا",37,"ن",2,0],["كلكم يبتغي نصيباً من السل","طان والجاه والغريم يساومْ",38,"م",1,0],["كُلُّكُمْ فِي مُعَجَّلِ الدَّهْرِ والآ","جِلِ جَمُّ الْعُلَى مُعَافىً سَلِيمُ",39,"م",1,0],["كلُّ كفٍّ سيفٌ إذا أحكمَ المو","تُ عُراها وكلُّ هامٍ لِوَاءُ",40,"ا",2,0],["كُلُّ كَمالٍ إِلى مُحاقِ","وَكُلُّ جَمعٍ إِلى اِفتِراقِ",41,"ق",1,1],["كل كلام حسن ذكرته","تمَلَّه القلوب إن كررته",42,"ه",1,0],["كُلُّ كَبير يتبع","شين الرجال في الطمَع",43,"ع",1,0],["كلّ كاسٍ من الجميل ففخراً","نسجُ بردي علاه حمد وشكر",44,"ر",1,0],["كل كتاب الله هذا صامت","خاف وهذا ناطق ومبين",45,"ن",1,0],["كِلّكْ حَلَى لكِنْ زعَلْ وجْهك احلاك","محلاك مِنْ بَعْد الزعَلْ يَوْم تَهْدِين",46,"ن",1,0],["كلكم عُرقٌ كرامٌ","كلكم ابى الخضُوع",47,"ع",1,0],["كل كتاب لغة وعيتُ","وكل شعر لهم رويتُ",48,"ت",1,0],["كلُّ كثيب من فوقه غصن","عليه ليل من تحته قمر",49,"ر",1,0],["كُلُّ كَأسٍ مِنَ المُدامِ بِها وِر","دُ هَوانٍ يَدُبُّ فيهِ القَضاءُ",50,"ا",2,0],["كُلَّ كريم في الوغى مهصارِ","أَهلِ النّدَى والحِلمِ والوَقارِ",51,"ر",1,0],["كل كَسبٍ يبيدُه قِدَمُ الدَّهرِ","ويَبقى الثناءُ في تجديد",52,"د",1,0],["كل كريمٍ قد سَمِعْنا به","أما كعونٍ بن حسينٍ فلاَ",53,"ل",2,0],["كلٌّ كلّي بحبكم مستهامٌ","والسويدا تشتاقكم والسوادُ",54,"د",1,0],["كلُّ كسب من العلى ما عناني","ما لغير العلى ثنيتُ عناني",55,"ن",2,1],["كل كبيرٍ في الملوك يصغرُ","كل اِمبراطور وكسرى قيصرُ",56,"ر",1,0],["كلكم كلكم مع الغالب الظا","لم لا تعدموا من الظلم رغما",57,"م",2,1],["كل كون مآله لزوال","كل حي مصيره للفناء",58,"ا",2,0],["كُلُّكم للحَضِيضِ أَلقُوا سِلاحاً","وإِلى الحَربِ يَبرُزُ القِرنانِ",59,"ن",1,0],["كل كسر لديهم بانتصار","كل ذل في حبهم باعتزاز",60,"ز",1,0],["كُلُّكُم مَعشرَ العَواذِلِ في نه","جٍ على العاشقينَ ضاقَ انفِساحُه",61,"ح",2,0],["كلُّ كَفورٍ لشمُولِ النِّعمِ","فإنَّهُ مستوجِبٌ للنِّقَمِ",62,"م",1,0],["كل كتابٍ نادرٍ أرختَه","قُلدَ في نوادرِ التعريفِ",63,"ف",1,0],["كل كبرى من القضايا حواها","فتراءى نتيجة الكبراء",64,"ا",2,0],["كلك غلا والمحبة فيك مرسومه","وانا عيوني مرايا القلب لاسراري",65,"ر",2,0],["كلّك على بعضك درر في عقده المنظّما","في نحر بدرٍ فوق سطح البحر لك شرك وشريك",66,"ك",1,0],["كلك حلا جلّ من كمّل بعيني حلاك","الزين من منهلك والسحر من منهلك",67,"ك",1,0],["كلك على بعضك اماني عنيده","وانا عنيده / حضرتك ما ادانيك",68,"ك",1,0],["كُلُّكُمْ حَاربتُم الدِّينَ فكنتمْ ظَالمينْ","حبّذا لو عِشْتُمُ القرآنَ نَهْجَ المتقينْ",69,"ن",1,0],["كلك حياه ودفا وبدونك الرعشه","يالكوت في لمستك ياجوّي الزآخر",70,"ر",1,0],["كلّك وفاء ناديت ( يا يونس الحوت )","ثورة غَضب تَعْمي عيون المغاوير",71,"ر",1,0],["كلك نظر يامغرقِ قلبي اغراق","في بحر من شعر وفصاحة وتعبير",72,"ر",1,1],["كل كحلاء اذا ما وطأت","تحسب الهضب تدكدكن انهيارا",73,"ر"