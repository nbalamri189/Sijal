يادي","https://www.aldiwan.net/poem37053.html","المجتث"],[480,"حللت قلبي يا ابني","https://www.aldiwan.net/poem37055.html","المجتث"],[483,"أقول لأقوام رمونا بأسهم العقول","https://www.aldiwan.net/poem24466.html","عموديه"],[483,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[510,"هل عرفت الغداة رسماً محيلا","https://www.aldiwan.net/poem751.html",""],[515,"رنا فسل على العشاق أحوره","https://www.aldiwan.net/poem20792.html","البسيط"],[515,"لله منزلها على الروحاء","https://www.aldiwan.net/poem20827.html","الكامل"],[516,"خطبتني الخطوب بالهم لما","https://www.aldiwan.net/poem12295.html","الخفيف"],[517,"وما في الأرض أشقى من محب","https://www.aldiwan.net/poem48645.html","الوافر"],[539,"إسألوني عما رأيت بعيني","https://www.aldiwan.net/poem47588.html","عموديه"],[539,"كيف المآل إذا تكون الحال","https://www.aldiwan.net/poem47997.html","عموديه"],[539,"اسال من الأجفان عن صدره نهرا","https://www.aldiwan.net/poem48140.html","عموديه"],[539,"في بذلة النوم قد تبدى","https://www.aldiwan.net/poem48249.html","عموديه"],[552,"من لي بمن إن سمته حاجة","https://www.aldiwan.net/poem47262.html","السريع"],[559,"طريقتنا قل بأقوالها","https://www.aldiwan.net/poem33500.html","المتقارب"],[562,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[563,"اليوم قبة بيت القدس قد رفعت","https://www.aldiwan.net/poem52525.html","البسيط"],[563,"لجرجس العيد دار طاب منزلها","https://www.aldiwan.net/poem52630.html","البسيط"],[563,"زوروا حمى بيعة كالنجم طالعة","https://www.aldiwan.net/poem52652.html","البسيط"],[588,"بعزك يا ذا الكبرياء والمراحم","https://www.aldiwan.net/poem11517.html","عموديه"]],"verses":[["فيبسط باسم الله أرضاً بصارم","تكاد له تطوى الطباق الشدائد",0,"د",1,0],["في بَلدَةٍ حَرَمٌ عَلى أَعدائِهِ","وَعَلى النَوائِبِ رَبوَةٌ إِزليقُ",1,"ق",1,0],["في بُيوتِ الحَيِّ أَدنى مَنزِلاً","وَمَقاماتٌ مِنَ البيضِ العَذارى",2,"ر",2,0],["في بَلدَةٍ فِها العُيونُ حَوافِلٌ","وَالرَوضُ غَضٌّ وَالرِياحُ لَواعِبُ",3,"ب",1,0],["فَيُبْصِرُ الْوِتْرَ دُونَ شَفْعٍ","وَيُبْصِرُ الْفَرْدَ دُونَ ثَانِي",4,"ن",2,0],["في بَيتِ مَكرُمَةٍ آباؤهُ نُجُبٌ","كانوا رؤوساً فَأَمسى بَعدهُم ذَنَبا",5,"ب",2,0],["فَيَبرُزَ جَمعُنا وَبَنو عَدِيٍّ","فَيُعلَمَ أَيُّنا مَولى صُحارِ",6,"ر",1,0],["فَيَبِتنَ يَنهَسنَ الجَبوبَ بِه","وَأَبيتُ مُرتَفِقاً عَلى رَحلي",7,"ل",2,0],["في بلادٍ ردت إليها فؤادي","كل أرضٍ حططت فيها رحالي",8,"ل",2,0],["فَيُبَلُّغُ غَايَةَ نُجْحِهَا","بِالْقَصْدِ وَالتَّدْبِيرِ وَالتَّحْسِينِ",9,"ن",1,0],["فِي بِلادٍ كَمَا تُحِبُّ تَرَاهَا","بَاقِيَاتٍ وَحَيْثُ شِئْتَ تَريمُ",10,"م",1,0],["في بشرها وبشارة الدنيا بها","مستمتع الأسماع والأبصارِ",11,"ر",1,0],["فيبوء المستعمرون بخُسرٍ","وتضيء البلاد بالعُمران",12,"ن",1,0],["فيبقى به الأقوى قرين ارتقائه","كما يسقط الأوهى رهين اندثاره",13,"ر",2,0],["فيُبصرها من مارست عينه عمىً","ويسمعها من كابدت أذنه وَقرا",14,"ر",2,0],["فيبصر كالنجوم لها علوّ","ويسمع كالرعود لها رغاء",15,"ا",2,0],["في بلاد يكون سيرك تأوي","باً على أنه سرىً في بلاد",16,"د",1,0],["في باذِخٍ مِن رُكنِ سَلمى أَو أَجا","نَحنُ حَمَينا السَرحَ أَن يُهَيَّجا",17,"ج",2,0],["في بابِك العلم وفيض الندى","فلا خلا بابك من طالب",18,"ب",1,0],["في بحر يمناه منافع للورى","تجرِي بقلكِ يراعه المشحون",19,"ن",1,0],["فيبصر وجهاً في الورى زانَ خاله","وعهدِي بأن الخال للوجه زائن",20,"ن",1,0],["في بيت فضلٍ على الجوزاء مرتفع","تعنو القصائد عن أدنى مبانيه",21,"ي",2,0],["في بَذْلِه وشْكٌ وفي بطشه","بُطءٌ ولكنْ أمْرُهُ لَمْحُ",22,"ح",1,0],["في بقاعٍ دَمثاتٍ","عطراتِ المستثار",23,"ر",1,0],["في بظرها ألفُ ألفِ رطلٍ","وإنما وزنها شعيره",24,"ر",2,0],["في بُلَغِ الإخوان لي عصمةٌ","وفي رجاء الله لي شبعه",25,"ع",2,0],["في بيتها والذي حجَّ الحجيجُ له","وهل جنى الغيّ عن جانيه معدولُ",26,"ل",1,0],["في بَيتِ مُنخَرِقِ السِربالُ مُعتَمِلٍ","ما إِن عَلَيهِ ثِيابٌ غَيرُ أَطمارِ",27,"ر",1,0],["في بُردَةٍ كَاللَيلِ حالِكَةٍ","لَهَفي عَلى أَثوابِها الحُمرِ",28,"ر",1,0],["فيبثها آلامه","بث الكليم الى الكليم",29,"م",1,0],["في بِساطِ الرَشيدِ يَوماً وَيَوماً","في حِمى جَعفَرٍ وَضافي سِتارِهِ",30,"ر",2,0],["في بِرِّ عَمِّكِ ما يَقومُ مَكانَهُ","في عَطفِهِ وَحَنانِهِ وَدِعابِه",31,"ب",2,0],["فَيَبيتُ خِصباً في ثَراهُ وَنِعمَةٍ","وَيَعُمُّهُ ماءُ الحَياةِ الموسِقِ",32,"ق",1,0],["في بُكورِ الطَيرِ لِلرِز","قِ مَجيئاً وَذَهابا",33,"ب",2,0],["في بَلَدٍ تُضرَبُ الحِجالُ بِهِ","عَلى حِسانٍ وَلَسنَ أَشباها",34,"ا",3,0],["في باطن الأرواح كبريتة","تجتذب الأنثى إلى نفسِها",35,"س",3,1],["في باطن الألوان وهي خفية","وبها تتجسد الأرواح",36,"ح",1,0],["فيبدأُ عفواً لم تُعِنْهُ شفاعةٌ","ويُبدي رضا لم يعترِضْهُ ملامُ",37,"م",1,0],["في بِلادٍ تَرى الكَريمَ أَكيلاً","ثَمَّ لِلجَدبِ وَالزَمانُ خَصيبُ",38,"ب",1,0],["في بُدُوٍ مِنَ الشَبابِ عَلَيها","وَرَقٌ مِن جَديدِهِ المُسبَكِرِّ",39,"ر",1,0],["في بُكاءٍ عَلى الأَحِبَّةِ شُغلٌ","لِأَخي الحُبِّ عَن بُكاءِ الطُلولِ",40,"ل",1,0],["في بَني الحارِثِ بنِ كَعبِ بنِ عَمرٍ","سَيِّدُ الناسِ بَينَ عُربٍ وَعُجمِ",41,"م",1,0],["في بَرارٍ تكشَّفَ النَّقْعُ عنها","وهيَ من رَوْنَقِ الحديدِ بِحارُ",42,"ر",1,0],["فَيَبدَءُهُ بِضَربَةٍ أَو يَشُكُّهُ","بِنافِذَةٍ تَصفَرُّ مِنهُ الأَنامِلُ",43,"ل",1,0],["في بُيوتٍ سُقوفُها اللَبنُ فيها","أَسكَنَ المَوتُ جَوفَها أَحبابي",44,"ب",2,0],["في باسق للماء منعطف","في رائعات الصخر ناتئة",45,"ه",1,0],["في بركةٍ قامتْ على حافاتها","أُسْدٌ تذلُّ لعزّة السلطانِ",46,"ن",1,0],["فَيَبيتُ ناجودٌ وعودٌ حَولَهم","ويَبيتُ حَولَكَ شزَّبٌ وَسَنَوّرُ",47,"ر",1,0],["في بَطْنِ الفُلكِ مُصارَعَةً","زَمَني وعلى ظَهْرِ الأُجُدِ",48,"د",1,0],["في بُيوتٍ بُنِيَتْ شِعْرِيّةٍ","لِثَناءِ المَرءِ فيهِنَّ خُلود",49,"د",1,0],["في بُيوتٍ أَذِنَت فيها العُلى","لَكَ بِالتَقريظِ في كُلِّ نَدِ",50,"د",1,0],["في بَلدَةٍ مِثلِ جَوفِ العَير لَستُ أَرى","فيها سِوى أُمَمٍ تَحنُو عَلى صَنَمِ",51,"م",1,0],["فِي بُلْجَةٍ لا تَكَادُ الْعَيْنُ تُنْكِرُهَا","وَسُمْرَةٍ رُبَّمَا شَفَّتْ نَوَاحِيهَا",52,"ي",3,0],["فَيَبخَلنَ أَو يُخبِرنَ بِالعِلمِ بَعدَما","نَكَأنَ فُؤاداً كانَ قِدماً مُفَجَّعا",53,"ع",2,0],["في بُكاءٍ فَقُلتُ ما ذا الَّذي أَب","كاكِ قالَت فَتاتُها ما فَعَلتا",54,"ت",2,0],["في بَراحٍ مِنَ المَكارِمِ جَزلٍ","لَم تُعَلِقهُم بِلَقطِ حَصاكا",55,"ك",2,0],["فَيَبني مَجدَها وَيُقيمَ فيها","وَيُمشي إِن أُريدَ بِهِ المَشا