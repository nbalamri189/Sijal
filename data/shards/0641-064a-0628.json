{"poems":[[53,"يا دار ما طربت إليك النوق","https://www.aldiwan.net/poem29956.html","الكامل"],[53,"قربوهن ليبعدن المغارا","https://www.aldiwan.net/poem30447.html","الرمل"],[53,"مثواي إما صهوة أو غارب","https://www.aldiwan.net/poem30756.html","الكامل"],[77,"مولاي لازلت في أمان","https://www.aldiwan.net/poem36032.html","مخلع البسيط"],[42,"العيش لا عيش إلا ما اقتصدت فإن","https://www.aldiwan.net/poem50246.html","البسيط"],[5,"أنهدياً إذا ما جئت نهداً","https://www.aldiwan.net/poem317.html",""],[0,"حي الحمول بجانب العزل","https://www.aldiwan.net/poem82.html","الكامل"],[93,"يا لعهد الصبا تقضي وشيكا","https://www.aldiwan.net/poem9159.html","الخفيف"],[93,"قف خاشعاً بضريح عز الدين","https://www.aldiwan.net/poem11214.html","الكامل"],[93,"إن بكى الشرق فالمصاب أليم","https://www.aldiwan.net/poem11409.html","الخفيف"],[83,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[88,"صاح إن الخطوب في غليان","https://www.aldiwan.net/poem44456.html","الخفيف"],[88,"هو الدهر لم يترك مشن غواره","https://www.aldiwan.net/poem45014.html","الطويل"],[88,"كتبت لنفسي عهد تحريرها شعرا","https://www.aldiwan.net/poem45026.html","الطويل"],[88,"قضوا شهداء ليس لهم بواء","https://www.aldiwan.net/poem45035.html","الوافر"],[88,"نحن من أرضنا على منطاد","https://www.aldiwan.net/poem45072.html","الخفيف"],[27,"قد أرقصت أم البعيث حججا","https://www.aldiwan.net/poem5697.html","الرجز"],[72,"يا ملكا تقصر عن وصفه","https://www.aldiwan.net/poem18335.html","السريع"],[72,"جسمي أبو ذر الضنا فذروني","https://www.aldiwan.net/poem20182.html","الكامل"],[72,"سقى الجدث العزي صوب غمامة","https://www.aldiwan.net/poem20467.html","الطويل"],[72,"بدا وقامته تختال بالتيه","https://www.aldiwan.net/poem20562.html","البسيط"],[51,"مستقبل خائفه الصفح مستقبل آمنه المنح","https://www.aldiwan.net/poem9400.html","السريع"],[51,"دار أمن وقرار","https://www.aldiwan.net/poem62849.html","مجزوء الرمل"],[51,"تخلفت شنطف فقلنا","https://www.aldiwan.net/poem64013.html","مخلع البسيط"],[51,"بدعة عندي كاسمها بدعه","https://www.aldiwan.net/poem65395.html","السريع"],[51,"يا أحمد بن سعيد لا تمت جزعا","https://www.aldiwan.net/poem65873.html","البسيط"],[29,"تغير الرسم من سلمى بأحفار","https://www.aldiwan.net/poem6035.html","البسيط"],[91,"أبصرتها في الخمس والعشر","https://www.aldiwan.net/poem8851.html","عموديه"],[89,"هتف العراق مرحبا","https://www.aldiwan.net/poem44847.html","مجزوء الكامل"],[85,"ساجع الشرق طار عن أوكاره","https://www.aldiwan.net/poem62880.html","الخفيف"],[85,"أرأيت زين العابدين مجهزا","https://www.aldiwan.net/poem62921.html","الكامل"],[85,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[85,"أيها العمال أفنوا العمر","https://www.aldiwan.net/poem63778.html","مجزوء الرمل"],[43,"أوه بديل من قولتي واها","https://www.aldiwan.net/poem10603.html","المنسرح"],[62,"في باطن الأرواح كبريتة","https://www.aldiwan.net/poem52167.html","السريع"],[62,"قد جاءنا في حكمة مكنونة","https://www.aldiwan.net/poem52204.html","الكامل"],[62,"هو العتب حتى ما يرد سلام","https://www.aldiwan.net/poem52295.html","الطويل"],[45,"أريحيات صبوة ومشيب","https://www.aldiwan.net/poem62638.html","الخفيف"],[45,"شد ما أغرمت ظلوم بهجري","https://www.aldiwan.net/poem63602.html","الطويل"],[45,"يا ابنة العامري عما قليل","https://www.aldiwan.net/poem65557.html","الخفيف"],[45,"أأراك الحبيب خاطر وهم","https://www.aldiwan.net/poem65655.html","الخفيف"],[61,"لحظ عينيك للردى أنصار","https://www.aldiwan.net/poem51681.html","الخفيف"],[2,"لسلمى بشرقي القنان منازل","https://www.aldiwan.net/poem25022.html","الطويل"],[49,"قل لأهل القبور كيف وجدتم","https://www.aldiwan.net/poem64119.html","الخفيف"],[97,"من شاطئ لشواطئ جدد","https://www.aldiwan.net/poem24763.html","أحذ الكامل"],[80,"أعليت بين النجم والدبران","https://www.aldiwan.net/poem31266.html","الكامل"],[80,"في كنه قدرك للعقول تحير","https://www.aldiwan.net/poem31455.html","الكامل"],[80,"صادتك مهاة لم تصد","https://www.aldiwan.net/poem31480.html","المتدارك"],[80,"أين مني عتب أحباب هجود","https://www.aldiwan.net/poem31481.html","الرمل"],[80,"أنكرت سقم مذاب الجسد","https://www.aldiwan.net/poem31487.html","الرمل"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[87,"ما لي وللدار من ليلى أحييها","https://www.aldiwan.net/poem8204.html","مجزوء البسيط"],[31,"ألم تسأل الأطلال والمتربعا","https://www.aldiwan.net/poem42466.html","الطويل"],[31,"عجبا ما عجبت مما لو أبصرت","https://www.aldiwan.net/poem42603.html","الخفيف"],[21,"نهرا جاريا وبيتا عليا","https://www.aldiwan.net/poem36186.html","الطويل"],[22,"ألا أبلغ بني عوف بن كعب","https://www.aldiwan.net/poem21645.html","الوافر"],[52,"أنعم بتين طاب طعما واكتسى","https://www.aldiwan.net/poem26969.html","الرجز"],[75,"قامت تميس كما تدافع جدول","https://www.aldiwan.net/poem69047.html","الكامل"],[48,"دع الوقوف على رسم وأطلال","https://www.aldiwan.net/poem64512.html","البسيط"],[48,"لقبلة الراحِ إذ تصلي","https://www.aldiwan.net/poem66577.html","مخلع البسيط"],[50,"بأبي وأمي من يقاربني","https://www.aldiwan.net/poem64843.html","الكامل"],[46,"لا تلبس الدنيا فإن لباسها","https://www.aldiwan.net/poem22351.html","الكامل"],[46,"أعوز الشث والسلم","https://www.aldiwan.net/poem23436.html","مجزوء الخفيف"],[46,"أف لدنيانا وأحزانها","https://www.aldiwan.net/poem23533.html","السريع"],[46,"يا ساهر البرق أيقظ راقد السمر","https://www.aldiwan.net/poem23634.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85469","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85578","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85555","الخفيف"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/1237","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16647","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54907","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54756","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54941","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54522","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141976","الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141930","البسيط"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1944","الكامل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116994","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54280","البسيط"],[106,"هرم يهوى","https://www.poetsgate.com/ViewPoem.aspx?id=179481",""],[106,"تحية الكويت","https://www.poetsgate.com/ViewPoem.aspx?id=179305",""],[22,"ولما كنتُ جَارَهُمُ حَبَوْنِي","https://www.poetsgate.com/ViewPoem.aspx?id=18932",""],[100,"كانت وكان","https://www.poetsgate.com/ViewPoem.aspx?id=50424",""],[31,"ألم تسألِ الأطلالَ والمتربعا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18932&r=&rc=195",""]],"verses":[["في بَلدَةٍ حَرَمٌ عَلى أَعدائِهِ","وَعَلى النَوائِبِ رَبوَةٌ إِزليقُ",0,"ق",1,0],["في بُيوتِ الحَيِّ أَدنى مَنزِلاً","وَمَقاماتٌ مِنَ البيضِ العَذارى",1,"ر",2,0],["في بَلدَةٍ فِها العُيونُ حَوافِلٌ","وَالرَوضُ غَضٌّ وَالرِياحُ لَواعِبُ",2,"ب",1,0],["فَيُبْصِرُ الْوِتْرَ دُونَ شَفْعٍ","وَيُبْصِرُ الْفَرْدَ دُونَ ثَانِي",3,"ي",1,0],["في بَيتِ مَكرُمَةٍ آباؤهُ نُجُبٌ","كانوا رؤوساً فَأَمسى بَعدهُم ذَنَبا",4,"ب",2,0],["فَيَبرُزَ جَمعُنا وَبَنو عَدِيٍّ","فَيُعلَمَ أَيُّنا مَولى صُحارِ",5,"ر",1,0],["فَيَبِتنَ يَنهَسنَ الجَبوبَ بِه","وَأَبيتُ مُرتَفِقاً عَلى رَحلي",6,"ي",1,0],["في بلادٍ ردت إليها فؤادي","كل أرضٍ حططت فيها رحالي",7,"ل",2,0],["فَيُبَلُّغُ غَايَةَ نُجْحِهَا","بِالْقَصْدِ وَالتَّدْبِيرِ وَالتَّحْسِينِ",8,"ن",1,0],["فِي بِلادٍ كَمَا تُحِبُّ تَرَاهَا","بَاقِيَاتٍ وَحَيْثُ شِئْتَ تَريمُ",9,"م",1,0],["في بشرها وبشارة الدنيا بها","مستمتع الأسماع والأبصارِ",10,"ر",1,0],["فيبوء المستعمرون بخُسرٍ","وتضيء البلاد بالعُمران",11,"ن",1,0],["فيبقى به الأقوى قرين ارتقائه","كما يسقط الأوهى رهين اندثاره",12,"ر",2,0],["فيُبصرها من مارست عينه عمىً","ويسمعها من كابدت أذنه وَقرا",13,"ر",2,0],["فيبصر كالنجوم لها علوّ","ويسمع كالرعود لها رغاء",14,"ا",2,0],["في بلاد يكون سيرك تأوي","باً على أنه سرىً في بلاد",15,"د",1,0],["في باذِخٍ مِن رُكنِ سَلمى أَو أَجا","نَحنُ حَمَينا السَرحَ أَن يُهَيَّجا",16,"ج",2,0],["في بابِك العلم وفيض الندى","فلا خلا بابك من طالب",17,"ب",1,0],["في بحر يمناه منافع للورى","تجرِي بقلكِ يراعه المشحون",18,"ن",1,0],["فيبصر وجهاً في الورى زانَ خاله","وعهدِي بأن الخال للوجه زائن",19,"ن",1,0],["في بيت فضلٍ على الجوزاء مرتفع","تعنو القصائد عن أدنى مبانيه",20,"ي",2,0],["في بَذْلِه وشْكٌ وفي بطشه","بُطءٌ ولكنْ أمْرُهُ لَمْحُ",21,"ح",1,0],["في بقاعٍ دَمثاتٍ","عطراتِ المستثار",22,"ر",1,0],["في بظرها ألفُ ألفِ رطلٍ","وإنما وزنها شعيره",23,"ر",2,0],["في بُلَغِ الإخوان لي عصمةٌ","وفي رجاء الله لي شبعه",24,"ع",2,0],["في بيتها والذي حجَّ الحجيجُ له","وهل جنى الغيّ عن جانيه معدولُ",25,"ل",1,0],["في بَيتِ مُنخَرِقِ السِربالُ مُعتَمِلٍ","ما إِن عَلَيهِ ثِيابٌ غَيرُ أَطمارِ",26,"ر",1,0],["في بُردَةٍ كَاللَيلِ حالِكَةٍ","لَهَفي عَلى أَثوابِها الحُمرِ",27,"ر",1,0],["فيبثها آلامه","بث الكليم الى الكليم",28,"م",1,0],["في بِساطِ الرَشيدِ يَوماً وَيَوماً","في حِمى جَعفَرٍ وَضافي سِتارِهِ",29,"ر",2,0],["في بِرِّ عَمِّكِ ما يَقومُ مَكانَهُ","في عَطفِهِ وَحَنانِهِ وَدِعابِه",30,"ب",2,0],["فَيَبيتُ خِصباً في ثَراهُ وَنِعمَةٍ","وَيَعُمُّهُ ماءُ الحَياةِ الموسِقِ",31,"ق",1,0],["في بُكورِ الطَيرِ لِلرِز","قِ مَجيئاً وَذَهابا",32,"ب",2,0],["في بَلَدٍ تُضرَبُ الحِجالُ بِهِ","عَلى حِسانٍ وَلَسنَ أَشباها",33,"ا",3,0],["في باطن الأرواح كبريتة","تجتذب الأنثى إلى نفسِها",34,"س",3,1],["في باطن الألوان وهي خفية","وبها تتجسد الأرواح",35,"ح",1,0],["فيبدأُ عفواً لم تُعِنْهُ شفاعةٌ","ويُبدي رضا لم يعترِضْهُ ملامُ",36,"م",1,0],["في بِلادٍ تَرى الكَريمَ أَكيلاً","ثَمَّ لِلجَدبِ وَالزَمانُ خَصيبُ",37,"ب",1,0],["في بُدُوٍ مِنَ الشَبابِ عَلَيها","وَرَقٌ مِن جَديدِهِ المُسبَكِرِّ",38,"ر",1,0],["في بُكاءٍ عَلى الأَحِبَّةِ شُغلٌ","لِأَخي الحُبِّ عَن بُكاءِ الطُلولِ",39,"ل",1,0],["في بَني الحارِثِ بنِ كَعبِ بنِ عَمرٍ","سَيِّدُ الناسِ بَينَ عُربٍ وَعُجمِ",40,"م",1,0],["في بَرارٍ تكشَّفَ النَّقْعُ عنها","وهيَ من رَوْنَقِ الحديدِ بِحارُ",41,"ر",1,0],["فَيَبدَءُهُ بِضَربَةٍ أَو يَشُكُّهُ","بِنافِذَةٍ تَصفَرُّ مِنهُ الأَنامِلُ",42,"ل",1,0],["في بُيوتٍ سُقوفُها اللَبنُ فيها","أَسكَنَ المَوتُ جَوفَها أَحبابي",43,"ب",2,0],["في باسق للماء منعطف","في رائعات الصخر ناتئة",44,"ه",1,0],["في بركةٍ قامتْ على حافاتها","أُسْدٌ تذلُّ لعزّة السلطانِ",45,"ن",1,0],["فَيَبيتُ ناجودٌ وعودٌ حَولَهم","ويَبيتُ حَولَكَ شزَّبٌ وَسَنَوّرُ",46,"ر",1,0],["في بَطْنِ الفُلكِ مُصارَعَةً","زَمَني وعلى ظَهْرِ الأُجُدِ",47,"د",1,0],["في بُيوتٍ بُنِيَتْ شِعْرِيّةٍ","لِثَناءِ المَرءِ فيهِنَّ خُلود",48,"د",1,0],["في بُيوتٍ أَذِنَت فيها العُلى","لَكَ بِالتَقريظِ في كُلِّ نَدِ",49,"د",1,0],["في بَلدَةٍ مِثلِ جَوفِ العَير لَستُ أَرى","فيها سِوى أُمَمٍ تَحنُو عَلى صَنَمِ",50,"م",1,0],["فِي بُلْجَةٍ لا تَكَادُ الْعَيْنُ تُنْكِرُهَا","وَسُمْرَةٍ رُبَّمَا شَفَّتْ نَوَاحِيهَا",51,"ي",3,0],["فَيَبخَلنَ أَو يُخبِرنَ بِالعِلمِ بَعدَما","نَكَأنَ فُؤاداً كانَ قِدماً مُفَجَّعا",52,"ع",2,0],["في بُكاءٍ فَقُلتُ ما ذا الَّذي أَب","كاكِ قالَت فَتاتُها ما فَعَلتا",53,"ت",2,0],["في بَراحٍ مِنَ المَكارِمِ جَزلٍ","لَم تُعَلِقهُم بِلَقطِ حَصاكا",54,"ك",2,0],["فَيَبني مَجدَها وَيُقيمَ فيها","وَيُمشي إِن أُريدَ بِهِ المَشاءُ",55,"ا",2,0],["في بَردِ ثَلجٍ في نَقا تِبرٍ وَفي","ريحِ العَبيرِ وَطيبِ طَعمِ السُكَّرِ",56,"ر",1,0],["فَيُبَثُّ فوْقَ البَدْرِ منها عَنبرٌ","ويُذَرُّ فوقَ الشمس منها صَنْدَل",57,"ل",1,0],["في بَيتِ كافِرَةٍ بِالخَمرِ تاجِرَةٍ","شَمطاءَ شاطِرَةٍ تَعتَزُّ بِالوالي",58,"ي",1,0],["في بيتِ لهوٍ وشِربِ صفوٍ","وصوتِ ناي وضربِ عودِ",59,"د",1,0],["فَيَبيتُ يَشعَبُ صَدعَ أُلفَتِنا","وَأَبيتُ بِالعُتبى أُشاعِبُهُ",60,"ب",2,0],["في بَيتِهِ الحَكَمُ الَّذي هُوَ صادِقٌ","فَأتوا بُيوتَ القَومِ مِن أَبوابِها",61,"ب",3,0],["في بِلادٍ مُضِلَّةٍ","لَيسَ في أَرضِها عَلَم",62,"م",1,0],["في بُقعَةٍ مِن رُقعَةٍ يَسّ