{"poems":[[49,"لمثلها يستعد البأس والكرم","https://www.aldiwan.net/poem25146.html","البسيط"],[74,"يا سائلي بدمشق عن أحوالي","https://www.aldiwan.net/poem19484.html","الكامل"],[128,"وادته بعد تجاذب وتدافع","https://www.aldiwan.net/poem23745.html","الكامل"],[164,"للصبر في مهجتي والهم معترك","https://www.aldiwan.net/poem58994.html","البسيط"],[228,"أشكو إلى قلبك يا سيدي","https://www.aldiwan.net/poem41616.html","السريع"],[302,"تبدي السلو وأنت مرتهن","https://www.aldiwan.net/poem33145.html","أحذ الكامل"],[438,"سافر إذا حاولت قدرا","https://www.aldiwan.net/poem12635.html","مجزوء الكامل"],[484,"ظلموك يا جدي ولست ظلوما","https://www.aldiwan.net/poem37194.html","الكامل"],[484,"إن كنت مثلي على الأحوال مطلعا","https://www.aldiwan.net/poem37575.html","البسيط"],[484,"روضا غرسته في الحياة نضيرا","https://www.aldiwan.net/poem37591.html","الكامل"],[510,"ذو الأوتاد","https://www.aldiwan.net/poem27895.html","البسيط"],[629,"","https://poetry.dctabudhabi.ae/diwan/poem/100589","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48738","الكامل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61059","الكامل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141288","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100971","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66233","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27498","البسيط"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47151","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106899","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137549",""],[3206,"","https://poetry.dctabudhabi.ae/diwan/poem/145872","المتدارك"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89105","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74039","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91491","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91244","المجتث"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133288","البسيط"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127083","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83452","الكامل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104926","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120468","الكامل"],[4717,"جنازة بيريز","https://www.poetsgate.com/ViewPoem.aspx?id=199585",""],[4767,"سيف الله","https://www.poetsgate.com/ViewPoem.aspx?id=179611",""],[5031,"دموع أهلي من ياقوت","https://www.poetsgate.com/ViewPoem.aspx?id=165141",""],[5187,"فرسان ميونيخ","https://www.poetsgate.com/ViewPoem.aspx?id=29246",""],[5216,"أحزانُ أمَّتِنا","https://www.poetsgate.com/ViewPoem.aspx?id=186987",""],[5271,"أجهلُكْ","https://www.poetsgate.com/ViewPoem.aspx?id=64038",""],[5277,"لا تعجبوا","https://www.poetsgate.com/ViewPoem.aspx?id=191253",""],[5320,"قلعة الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=40442",""],[5370,"أفكار","https://www.poetsgate.com/ViewPoem.aspx?id=87409",""],[5595,"أمطرت قبلاتها","https://www.poetsgate.com/ViewPoem.aspx?id=176713",""],[5596,"مجلس الدولة","https://www.poetsgate.com/ViewPoem.aspx?id=206753",""],[5829,"وتوقف التاريخ والازمان","https://www.poetsgate.com/ViewPoem.aspx?id=210215",""],[6124,"أرق المنسرح","https://www.poetsgate.com/ViewPoem.aspx?id=104137",""],[5075,"الإسلام هو الحل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82759&r=&rc=5",""],[557,"كأن العمر ماكان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69242&r=&rc=148",""],[6333,"آخر رسالة حب مالم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7033&r=&rc=1",""]],"verses":[["هَذي شُيوخُ بَني حَمدانَ قاطِبَةً","لاذوا بِدارِكَ عِندَ الخَوفِ وَاِعتَصَموا",0,"م",3,0],["هذي شكاية مستغيثٍ موجعٍ","أنهى قضيّته ورأيك عالي",1,"ل",2,0],["هذي شعوب فقف حيال قضائها","وقفات مشدوه ببزة خاشع",2,"ع",1,0],["هذي شباك رجاي الآن قد نصبت","والنفس ترقب ما يأتي به الشبك",3,"ك",1,0],["هذي شَكاتي يا خَطيبَ العُلى","أَرفَعُها لِلرَجُلِ الأَوحَدِ",4,"د",1,0],["هَذي شهودُ الحبِّ ناطقة","لا الروحُ تُكذبُها ولا البَدنُ",5,"ن",1,0],["هذي شرابٌ وهي تج","عَلُ فيه مثلَ البحرِ دُرّا",6,"ر",2,0],["هذي شرائطها لدي شهيدة","بقيت وقد ذهب العصير كروما",7,"م",2,0],["هذي شمائلهم فلينح مهتديا","نحو الذي للصراط المستقيم سعي",8,"ع",2,0],["هذي شمائلك التي خلدتها","تحيى بذكرك للنفوس شعورا",9,"ر",2,0],["هذي شعوبٌ اذا أسقيتها البلَها","شرّتْ وأغنتْ حديثَ الناس والجدَلا",10,"ل",2,0],["هذي شموس من وجوه","في ليالٍ من جعود",11,"د",1,0],["هذي شروطهمُ مفصلة فلا","إكراهكم ملكوا ولا الإرغاما",12,"م",2,0],["هَذي شَمائل من جفاه حَبيبه","أَتحب أَن أمضي إِلَيهِ رَسولا",13,"ل",2,0],["هذي شؤون الورى في الأرض قاطبةً","أمر يسّرك والثاني يبكّيك",14,"ك",1,0],["هذي شباب المسلمين وهذه","عبراتهم تجري دماً أفلاجا",15,"ج",2,0],["هذي شبيهة أُم عيسى","واعتبر في الانتماء",16,"ا",2,0],["هذي شبيبته هذي كهولته","هذا هو الهرم ما ينفك عن حدث",17,"ث",1,0],["هذي شهادتُنا ذُخْرِي لديك وَمَنْ","يستودعِ المصطفى ما خاب في أمل",18,"ل",1,0],["هَذِي شَهَادَتُهُم عَلَى مَحصُولِهِم","عِندَ المَمَاتِ وَقَولُهُم بِلِسَانش",19,"ن",2,0],["هذي شفاعة كل ذي شرك فلا","تعقد عليها يا أخا الايمان",19,"ن",1,0],["هذي شواطئك الطويلة أنها","مسرى الغرام ومسرح الغزلان",20,"ن",1,0],["هذي شموس الحسن تسطع بهجة","أم أنجم تزهوا بها أوقاتي",21,"ت",2,1],["هذي شكواي ومظلمتي","جد بالإنصاف وصافيني",22,"ن",2,0],["هذي شموسٌ في ليالي القدرِ","طلعت وإلا ذا ابتسام الدهرِ",23,"ر",1,1],["هَذي شَمائِل عبّاس فَلا عجبٌ","إِذا تَعالى أَبوها الضيغم الهصرُ",24,"ر",1,0],["هَذي شؤونُ العاشقين وَمَن هَوى","وَلوَ اَنَّهم جهلوا الهَوى فتستّروا",25,"ر",3,0],["هذي شؤوني وَتدري","أَني صَحيح ادّعائي",26,"ي",1,0],["هذي شهادة حق وهي عادلة","لا جرح فيها ولا في الصدق إعلال",27,"ل",1,0],["هذي شموس حميا شهبها الحبب","أم ذي بروق ثغور زانها الشنب",28,"ب",1,1],["هذي شُؤوني في هواكَ فما تَرى","ما الشَأن فيها ما الَّذي أَنا أَفعلُ",29,"ل",1,0],["هذي شريعة في تدلّلها","ضنت على العشاق في قبله",30,"ه",1,1],["هذي شهور قد تقضت والذي","اهواء ليس يلوح في آثارها",31,"ر",3,0],["هذي شياطينُ العروبةِ حْولهُ","جاءتْ توارِي هالكاً زهْرا",32,"ر",2,0],["هذي شكوانا نرفعها","للقاضي في يوم الدين",33,"ن",1,0],["هذي شُمُوسُ أبي ها جِئْتُ أُشْعِلُهَا","بَحْرَاً لِتُوقَدَ مِنْ خُصْلاتِهَا الجُزُرُ",34,"ر",1,0],["هذي شبابٌ تضمُّ الموتَ راضيةً","إنْ نالتِ الوصلَ قد نامتْ أمانيها",35,"ي",3,0],["هذي شعوبكَ يا مُختارُ حائِرَةٌ","والحلُّ عِندَكَ أنقِذْهم منَ العَدَمِ",36,"م",1,0],["هذي شظايا الحب سُلّت في دمي","فتحولت ورداتَ حب تثمِلُكْ",37,"ك",1,0],["هذي شفاهٌ بالجمالِ تزيَّنتْ","تلقي عليكَ الخيرَ من طيب الفمِ",38,"م",1,0],["هَذِى شُعوبُ الأَرضِ فِى أَحضانَهِ","أَنعمْ بِكلِّ الخَلقِِ تَحتَ لواء",39,"ا",2,0],["هذي شطبنا عليها تحز عايلتي","وهذي ما بيها سبقني شخص قايلها",40,"ل",3,0],["هذي شفاهٌ أمطرتْ قُبلاتِها","يا ليتَ دُنيانا شفاهٌ تُمْطرُ",41,"ر",1,1],["هذي شهادةُ عضوٍ منكمُ انْتفَضتْ","مجروحةَ الروحِ من صافي مَودتهِ",42,"ت",2,0],["هذي شفاه الورد ألقت نغمة","فترنم القيثار والألحان",43,"ن",1,0],["هذي شَئوني في بحرِ مُنْسَرِحٍ","أعيتْ على بيتٍ راجِزَ العَرَبِ",44,"ب",1,0],["هذى شوارعنا تبكى بلا أمل","لم يرحموا ضعفها يوما وما نظروا",45,"ر",3,0],["هَذِى شُعُُوبٌ رَأتْ فى الصَّمْتِ رَاحَتَها","وَاسْتَبْدَلَتْ عِيرَهَا بِالخَيْلِ أَزْمَانَا",46,"ن",2,0],["هَذِى شُعُوبٌ رَأتْ فى الموتِ غَايَتَهَا","وَاسْتَسْلَمَتْ للرَّدَى ذُلاً.. وَطُغْيَانَا",46,"ن",2,0],["هذي شجوني لعلي اليومَ أنثرها","على السطورِ فلا تستلطفي الغضبا",47,"ب",2,0]]}