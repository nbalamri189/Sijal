يط"],[4701,"الحسين","https://www.poetsgate.com/ViewPoem.aspx?id=176660",""],[4737,"متى الذهاب إلى الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=212154",""],[4755,"غُصَصُ البلادِ فَصِيحَةٌ بِفَمِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=184670",""],[4797,"يالله يا عالم خفا كل ماكان","https://www.poetsgate.com/ViewPoem.aspx?id=180551",""],[4984,"عرَّى بريد الصبح","https://www.poetsgate.com/ViewPoem.aspx?id=215655",""],[3271,"عارية ستانلي باي","https://www.poetsgate.com/ViewPoem.aspx?id=102703",""],[3271,"الشادوف","https://www.poetsgate.com/ViewPoem.aspx?id=104129",""],[3591,"رأيتُ ثوباً على الأعراس قد نشرا","https://www.poetsgate.com/ViewPoem.aspx?id=149390",""],[5147,"أطار النسيم الغض قلبي بمسراه","https://www.poetsgate.com/ViewPoem.aspx?id=166755",""],[5150,"تموز رمز الشهادة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=204037",""],[5232,"العيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=213707",""],[5277,"خيمةُ أمّ معبد..","https://www.poetsgate.com/ViewPoem.aspx?id=200203",""],[5320,"بنت الحور","https://www.poetsgate.com/ViewPoem.aspx?id=41647",""],[5431,"حول الحرام ترى اللسان مطقطقا","https://www.poetsgate.com/ViewPoem.aspx?id=197841",""],[5431,"موت الضمير...","https://www.poetsgate.com/ViewPoem.aspx?id=201304",""],[5442,"نسم آن أن تسري الرفاق إلى الحمى","https://www.poetsgate.com/ViewPoem.aspx?id=114747",""],[5444,"رسالةٌ إلى نجم آفل","https://www.poetsgate.com/ViewPoem.aspx?id=205071",""],[5690,"من آل سلوم غصنٌ جف مورده","https://www.poetsgate.com/ViewPoem.aspx?id=172275",""],[5690,"كنيسةٌ لبني مارون قد بنيت","https://www.poetsgate.com/ViewPoem.aspx?id=172259",""],[5725,"عربسان","https://www.poetsgate.com/ViewPoem.aspx?id=207284",""],[5781,"قلبٌ وذرَّاتُ رماد ...","https://www.poetsgate.com/ViewPoem.aspx?id=176650",""],[5837,"سيرة وطن","https://www.poetsgate.com/ViewPoem.aspx?id=179315",""],[5943,"بلاؤك بالهوى قدرٌ فصابرْ","https://www.poetsgate.com/ViewPoem.aspx?id=34675",""],[6035,"رَغِبْتُ بفضحِكمْ في بعضِ شِعْرٍ !","https://www.poetsgate.com/ViewPoem.aspx?id=177506",""],[572,"بَكَرَتْ بلومُ ومثلُها لكَ لائِمَهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9460&r=&rc=317",""]],"verses":[["عُريانُ خَيلِ الغَدرِ مِن دَنَسٍ","لا يَستَطيعُ الغَدرُ يَعلُقُهُ",0,"ق",2,0],["عُريانُ تَطرُدُ كُلُّ ريحٍ تُربَهُ","وَتُطيعُ أَوَّلَ أَمرِها حَصباؤُهُ",1,"ا",3,0],["عَريضٍ تَعجِزُ الصَحراءُ عَنهُ","وَيَشرَبُ قَبلَ آخِرِهِ الجِماما",2,"م",2,0],["عَريضَةُ بوصٍ إِذا أَدبَرَت","هَضيمُ الحَشاشَختَةُ المُحتَضَن",3,"ن",1,0],["عَرِيَت عَنِ الحَقِّ المُطَهَّرِ نَفسُهُ","فَحَياتُهُ ثِقلٌ عَلى الأَعناقِ",4,"ق",1,0],["عَرِيضُ الجَبْهَةِ الغَرَّاءِ يَبْدُو","بِهَا شَعْرٌ كَمَا رَقَّ الغَمَامُ",5,"م",1,0],["عَريضُ بِساطِ المِسحِ مِن صَهَواتِهِ","نَبيلُ العَسيبِ أَصهَبُ الهُلبِ ذابِلُه",6,"ل",2,0],["عَرينٌ مِن عُرَينَةَ لَيسَ مِنّا","بَرِئتُ إِلى عُرَينَةَ مِن عَرينِ",7,"ن",1,1],["عَرِيَت وَكانَ بِها الجَميعُ فَأَبكَروا","مِنها وَغودِرَ نُؤيُها وَثُمامُها",8,"م",3,0],["عريق التقى وفي السيادةَ حقها","فيا حبَّذا منه قديمٌ وحادث",9,"ث",1,0],["عريق العلى ألفاظهُ كدُروعهِ","غدا والوغى والسلم يحكمه سرْد",10,"د",1,0],["عريت وجوّعت الفؤاد فحبَّذا","مساكن فيها لا تجوعُ ولا تعرى",11,"ر",2,0],["عَرينُهُ مُذ كانَ لا","يَحميهِ إِلّا قَسوَرَه",12,"ر",2,0],["عريكةٌ لا يُلينُ الدهرُ شِدَّتَها","تقيكَ قالةَ حُسَّادٍ وتحميكا",13,"ك",2,0],["عَريقونَ في الإِفضالِ يُؤتَنَفُ النَدى","لِناشِئِهِم مِن حَيثُ يُؤتَنَفُ العُمرُ",14,"ر",1,0],["عَريتُ مِنَ الشَبابِ وَكانَ غَضّاً","كَما يَعرى مِنَ الوَرَقِ القَضيبُ",15,"ب",1,0],["عَريتُ مِنَ الهَوى وَبَرِئتُ مِنهُ","لَئِن أَنا لَم أُعاقِب مُقلَتَيكا",16,"ك",2,1],["عَرِيَ المُحِبُّ مِنَ الضَنا فَقَميصُهُ","طولُ التَأَوُّهِ وَالسَقامُ رِداؤُهُ",17,"ا",3,0],["عُريانُ لا يَكبو دَليلٌ مِن عَمىً","فيهِ وَلا يَبغي عَلَيهِ شُهودا",18,"د",2,0],["عريانَ يحمل مِنقاراً وأجنحةً","أخفَّ ما لمَّ من زادٍ أخو سَفَرِ",19,"ر",1,0],["عَرِيض الوَظيفِ مُكرَبُ القَصِّ لَم يَذُق","حَديداً وَلَم يَسهَر لَهُ اللَيل أَبجَلُ",20,"ل",1,0],["عُريانُ مِن حُلَلِ الجَلالَةِ وَالتُقى","لَم يَحوِ مِن كَرَمِ الخَلائِفِ مورِثا",21,"ث",2,0],["عرِيتْ أرضُه من العُشبِ الأخ","ضرِ والدوحِ سابغ الأليافِ",22,"ف",1,0],["عَرِيَ الشَّوى مِنها وأرْدَفَ نَحْضَها","جُرْدُ المُتونِ وسائِرُ الآرابِ",23,"ب",1,0],["عُرّي اليَومَ العَرينُ مِنَ الش","شبلِ فَليُبدِ الأَسى الأَسَدُ",24,"د",1,0],["عُرْيانَ إِنْ مَسَّهُ بَرْدُ الشتاءِ فما","له سِوَى زَفَراتِ الوَجْدِ منْ نار",25,"ر",1,0],["عريض الجاه مبيض الأيادي","رحيب الصدر وضاح الجبين",26,"ن",1,0],["عريتُ منَ الشّبابِ وكنتُ غضاً","كمَا يَعرَى منَ الوَرَقِ القَضيبُ",27,"ب",1,0],["عريان يلبسني أحسني ... كالنعش ، كالبئر العميق الحالي","كسرير ماخور ، يجفّف بعضه ... بعضا ، وينتظر النزيف التالي",28,"ل",2,0],["عُريان يلتحف السكينة والدجا","وتئن تحت جذوعه الأعراق",29,"ق",1,0],["عريضُ بساطِ المسحِ في صهواتهِ","نبيلُ العسيبِ أصهبُ الهلبِ ذائلهْ",30,"ل",2,0],["عُريانَ : لا خَتَلا ، ولا وَغَراً","ضَحْيانَ : لا صَلَفاً ، ولا مَلَقا",31,"ق",2,0],["عرّيت فقري عند بابيهما","وتعذّب الشكوى ويحلو الهوان",32,"ن",1,0],["عريان يلبسني أحسني","كالنعش ، كالبئر العميق الحالي",33,"ل",2,0],["عرّى السرائر والنّفوس ممزّقا","عنهنّ كلّ غلالة ووشاح",34,"ح",1,0],["عريض الجاه علة خلق كل ال","وجود ودولة الرب القريب",35,"ب",1,0],["عُرَيفُ تُغَيرِهِ يَحكِى شُمَيماً","عُرَيفَ رُوَيضَةٍ أثَرَ الوُبِيلِ",36,"ل",1,0],["عُرِّيَت حَقَبَةً أو أكثَرَ مِنها","مَا اَكتَسَت غَيرَ جِلدِهَا كَالرَّضِيعِ",37,"ع",1,0],["عَريضِ سِتٍّ لَهَبٌ حُضرُهُ","يُصانُ بِالتَذليقِ في مجدَلِ",38,"ل",1,0],["عُرىً أَعرَبَت عَن ذاتِها في اِبتِدائِها","فَلَم يَخفَ مَغزاها عَلى مَن تَأَمَّلا",39,"ل",2,0],["عَرِيقَةٌ نَاسَبَتْ أَخْوالَها فَلَها","بِالْعِتْقِ مِنْ أَكْرَمِ الجِنْسَيْنِ فَاخِرُهُ",40,"ر",2,0],["عريقون في الملك العقيم فلا ترى","إصالتهم في الملك عن أحد تروى",41,"و",2,0],["عُرَيبٌ لهم في مقلة السفح منزل","ومن دمع عيني بالعقيق تجثموا",42,"م",3,0],["عريب بروحي منهم ابتعت نظرة","فقلبي على حكم الهوى اتخذوا رهنا",43,"ن",2,0],["عريب بذكراهم اهيم صبابة","كأني نشوان وما ذقت إسفنطا",44,"ط",2,0],["عريق الندى من نسل اكرم والد","ويحر وفاء قد تولد من بحر",45,"ر",1,0],["عُرَيبَ الحِمى عَهدي نَزيلُكُم يُحمى","فَما بالُ قَلبي قَد أُبيحَ لَكُم ظَ