{"poems":[[55,"لله جيد ما تمه","https://www.aldiwan.net/poem29762.html","مجزوء الكامل"],[53,"يا رب شوهاء لجوج الزنا","https://www.aldiwan.net/poem63995.html","السريع"],[87,"يا أيها الدمع الوفي بدار","https://www.aldiwan.net/poem62872.html","الكامل"],[52,"خشاب هل لمحب عندكم فرج","https://www.aldiwan.net/poem63988.html","البسيط"],[108,"الشهيد الأول","https://www.poetsgate.com/ViewPoem.aspx?id=179492",""],[108,"جندي يحمل سلاحين","https://www.poetsgate.com/ViewPoem.aspx?id=179404",""],[147,"أما الزمان فقد ألزمته الجددا","https://www.aldiwan.net/poem11751.html","البسيط"],[186,"جاد الحيا كل روض في طرابلس","https://www.aldiwan.net/poem67053.html","البسيط"],[189,"صلى الإله عليك يا بن رسوله","https://www.aldiwan.net/poem14639.html","الكامل"],[280,"غزو على النصر والتمكين منشؤه","https://www.aldiwan.net/poem25646.html","البسيط"],[286,"لله أبعث رغبتي متيقناً","https://www.aldiwan.net/poem1401.html",""],[302,"لمن الكتائب في العجاج الأكدر","https://www.aldiwan.net/poem33273.html","الكامل"],[303,"مالي أرى القوم بعد الحزن في طرب","https://www.aldiwan.net/poem36814.html","عموديه"],[362,"يا خيل محيي ملة الإسلام","https://www.aldiwan.net/poem4147.html","الكامل"],[438,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[469,"بين القدود وبين أعطاف القنا","https://www.aldiwan.net/poem3325.html","عموديه"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138186",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48509","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48506","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62576","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62534","الكامل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61015","الكامل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11858","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108646","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100958","البسيط"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105421","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48253","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2562,"","https://poetry.dctabudhabi.ae/diwan/poem/141693","البسيط"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65994","البسيط"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11243","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74056","البسيط"],[3830,"","https://poetry.dctabudhabi.ae/diwan/poem/122298","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36266","الدوبيت"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90906","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90882","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90830","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54495","المجتث"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54393","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54369","الكامل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136428",""],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99121","البسيط"],[1547,"هذا الحبيبُ وهذه الصهباءُ","https://www.poetsgate.com/ViewPoem.aspx?id=16709",""]],"verses":[["لِلَّهِ جيدٌ ما تَمَه","هَدَ غَيرَ أَحشاءِ المَكارِم",0,"م",1,1],["للَّه جيلٌ كلُّهم صالحٌ","يزدرع البر ولو في الصخورْ",1,"ر",1,0],["لِلَّهِ جامِعَةٌ نَهَضتَ بِأَمرِها","هِيَ في المَشارِقِ مَصدَرُ الأَنوارِ",2,"ر",1,0],["لِلهَجرِ نارٌ عَلى قَلبي وَفي كَبِدي","إِذا نَأَيتِ وَرُؤيا وَجهِكِ الثَلَجُ",3,"ج",1,0],["لله جنديٌّ أغرُّ","جبينُه كالصبح ضاح!",4,"ح",1,0],["لله جنديٌّ بَدَا","من وجهه فلقُ الصَّبَاح!",5,"ح",1,1],["لِلَّهِ جَدُّكَ ما أَعلى وَحَدُّكَ ما","أَمضى وَجِدُّكَ ما وَطّى وَما مَهَدا",6,"د",2,0],["لِلّهِ جَمعيةٌ صَحَّت وَقَد جَمَعَت","في سلكِها كُلّ نَدبٍ بارعٍ نَدِسِ",7,"س",1,0],["للهِ جيشٌ مثلُ جيشك مُعْلَم","فالنصرُ يرحل دائبا برحيله",8,"ل",2,0],["للهِ جيْشُك والأسْطول قد ضَمِنا","لِلْمُقْتدي بالهُدى سيْراً يُهدّئُهُ",9,"ا",2,0],["لله جودٌ لا تغيضُ بحارُه","لا جودَ إلاّ ما انتمى للّه",10,"ل",2,0],["لِلَّه جدُّكَ أَيُّ مَجدٍ حُزتَه","فَشأوتَ كُلَّ مقدَّم ومؤخَّرِ",11,"ر",1,0],["للهِ جيش أمينِ اللهِ منتصراً","يدني جيوشَ العدى من موردِ العطب",12,"ب",1,0],["لِلَّهِ جَيشُ خَلِيفَةً رَايَاتُهُ","مَحفُوفَةٌ بالنُّجحِ فِي الإقدَامِ",13,"م",1,0],["لله جُلْبَتُهُ التي نَهَضَتْ بما","قد حَمَّلَتْهُ وصَمَّمَتْ في الحَمْلَةِ",14,"ه",1,0],["لله جودك ما اسحَّك مملقاً","كفَّا وحلمك مغضياً ما أرصنا",15,"ن",2,0],["لله جامعة أنشأتها فنمت","ونافست جامعات الغرب عرفانا",16,"ن",2,0],["للّه جيشك سلطان البرية من","بحرٍ خضم بموج البأس ملتطم",17,"م",1,0],["للّه جيشك وهو بحر تغتدي","وتروح فيه سفائن من نار",18,"ر",1,0],["لله جمعة إذ بدا كالبدر أو","كالغيث أقبل خائِض الغمرات",19,"ت",1,0],["لله جاد بنفسه وبماله","وسما ولاتَ منازل ومناصلِ",20,"ل",1,0],["لِلَّه جَأشك وَالصَّوارم تَنتَضي","وَالخَيل تردي وَالأَسنة تشرع",21,"ع",1,0],["لِلَّهِ جيراني بِجيرونٍ وَلي","بِلِحاظِهِم وَبِهِم ظُبىً وَظِباءُ",22,"ا",2,0],["للَه جنة ورد تحت حاجبها","يصافح الورد فيها نرجس الحور",23,"ر",1,0],["للَه جيدٌ به تزهو قلائدُها","كالكأس يمرح في حافاتها الحَبَب",24,"ب",1,0],["للَه جاشك ما أشد ثباته","في الحرب إذ أفردت في عرصاتها",25,"ت",3,0],["للهِ جوهرُهُ كادتْ بمَصْقَلِهِ","جواهرُ الشمسِ والأقمارِ تنطبعُ",26,"ع",1,0],["للَّهِ جَلَّ جَلالُهُ لاَ غَيرِهِ","إذ ذَاكَ إشرَاكٌ مِنَ الإِنسَانِ",27,"ن",1,0],["لله جيشك والرحمن ناصره","فقد تسامى عَلَى الجوزاء والشهبِ",28,"ب",1,0],["للّه جل جلالاً جده وعلا","سبحانه قدساً سبحان سبحانا",29,"ن",2,0],["لِلَّهِ جَوهَرَةٌ يَرو","قُ العَينَ حُسنُ صَفائِها",30,"ا",3,1],["لِلَّه جمعيّة للشرق جامعة","شتات عزمٍ لغيرِ الشرقِ ما جمعا",31,"ع",2,0],["للّه جاهد في عمارة مسجد","فيه النبي وسيد وحصور",32,"ر",1,0],["لِلَّهِ جَنى الحَديث ما أَطيَبَهُ","أَجنَتكَ بَواسِقُ النَخيلِ الرُطَبا",33,"ب",2,0],["للَه جنة عفة وصيانة","منه حواسده بنار سعير",34,"ر",1,0],["للَه جد جد في طلب الرضى","من ربه فحباه حسن المطلب",35,"ب",1,0],["للَه جوهر جسمه المائي كم","أشكو قساوة قلبه الصواني",36,"ن",2,0],["للّهِ جَمُّ أَيادٍ","عَنْ شُكْرِها قد عَجَزْنا",37,"ن",2,0],["للهِ جيشٌ للخليفةِ قادَهُ","ربُّ الخليفة بالميامنِ والظّفَر",38,"ر",1,0],["للهِ جيشٌ بالمروجِ عرضتَهُ","أُسدُ العرين رجالُهُ ورماحُهُ",39,"ح",2,0],["لله جامعنا المشهور بالعمري","مشهود أنواره يزهو على القمر",40,"ر",1,1],["لله جسمي فما أبقى حشاشته","على الحوادث والأسقام والوجل",41,"ل",1,0],["للهِ جيراني بجيرون ولي","بلحاظهم، وبهم ظبى ً وظباءؤُ",42,"ا",2,0]]}