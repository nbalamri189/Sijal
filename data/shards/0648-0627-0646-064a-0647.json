{"poems":[[55,"أداري المقلتين عن ابن ليلى","https://www.aldiwan.net/poem30660.html","الوافر"],[47,"رددت بعيسى الروم من حيث أقبلت","https://www.aldiwan.net/poem62750.html","الطويل"],[47,"ليالينا بين اللوى فمحجر","https://www.aldiwan.net/poem63636.html","الطويل"],[47,"ألمت وهل إلمامها لك نافيع","https://www.aldiwan.net/poem64706.html","الطويل"],[33,"أتحذر وشك البين أم لست تحذر","https://www.aldiwan.net/poem42506.html","الطويل"],[7,"وإن يرجع النعمان نفرح ونبتهج","https://www.aldiwan.net/poem1981.html","الطويل"],[47,"رددت بعيسى الروم من حيث أقبلت","https://www.poetsgate.com/ViewPoem.aspx?id=32921",""],[47,"لَيَالينا بَينَ اللّوَى، فمُحَجَّرِ،","https://www.poetsgate.com/ViewPoem.aspx?id=31220",""],[188,"أرى الناس قد أغروا ببغى وغيبة","https://www.aldiwan.net/poem14801.html","الطويل"],[367,"لها في حمى مني وراء الترائب","https://www.aldiwan.net/poem60994.html","الطويل"],[442,"نجوم الصبا أين تلك النجوم","https://www.aldiwan.net/poem34849.html","المتقارب"],[507,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[560,"وجودي جل عن جسمي","https://www.aldiwan.net/poem34248.html","الهزج"]],"verses":[["وَآنِيَةِ اللُحومِ مِنَ القَضايا","أَعَدتَ لَهُنَّ كَيّاً أَو نُضاجا",0,"ج",2,0],["وَإِنّي هَجَرتُ الراحَ حَولاً مُجَرَّماً","لَهُ وَشُهودي بِالَّذي قُلتُ شُهَّدُ",1,"د",1,0],["وَإِنِّيَ هَجرٌ لِلمُدامِ وَقَد جَلا","لَنا الصُبحَ مِن قُطرُبُّلٍ وَبَلَشكَرِ",2,"ر",1,0],["وَأَن يَهزِمَ الصَفَّ الكَثيفَ بِطَعنَةٍ","لَهُ عامِلٌ في إِثرِها مُتَتابِعُ",3,"ع",1,0],["وَإِنّي هَداكِ اللَهُ صَرمي سَفاهَةٌ","وَفيمَ بِلا ذَنبٍ أَتَيتُهُ أُهجَرُ",4,"ر",1,0],["وَإِن يَهلِكِ النُعمانُ تُعرَ مَطِيَّهُ","وَيُلقَ إِلى جَنبِ الفِناءِ قُطوعُها",5,"ع",3,0],["وإني هجرت الراحة حولا مجرماً","له وشهودي بالذي قلت شهد",6,"د",1,0],["وأني هجر للمدام وقد جلى","لنا الصبح من قطربل وبلشكر",7,"ر",1,0],["وإِن يَهْو للنسوان سمَّوه عاصيا","وإِن عفَّ قالوا ذاك خبث وباطل",8,"ل",1,0],["وإن يَهْرُبِ الباغي فكم من مُهالكٍ","مَصائدُها مَنصوبةٌ في المَهارِب",9,"ب",1,0],["وإِنْ يَهْنِكَ اليومَ عيدٌ يَعودُ","فَيَهْنِ لَنَا مِنْكَ عيدٌ يُقيمُ",10,"م",1,0],["وأنّي هالني استكبا","رُهم في الأرضِ عُميانا",11,"ن",2,0],["وإني هدهدُ الأخبا","ر للقوم الأُلَى قبلي",12,"ل",2,0]]}