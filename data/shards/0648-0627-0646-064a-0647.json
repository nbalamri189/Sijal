{"poems":[[55,"أداري المقلتين عن ابن ليلى","https://www.aldiwan.net/poem30660.html","الوافر"],[47,"رددت بعيسى الروم من حيث أقبلت","https://www.aldiwan.net/poem62750.html","الطويل"],[47,"ليالينا بين اللوى فمحجر","https://www.aldiwan.net/poem63636.html","الطويل"],[47,"ألمت وهل إلمامها لك نافيع","https://www.aldiwan.net/poem64706.html","الطويل"],[33,"أتحذر وشك البين أم لست تحذر","https://www.aldiwan.net/poem42506.html","الطويل"],[7,"وإن يرجع النعمان نفرح ونبتهج","https://www.aldiwan.net/poem1981.html","الطويل"],[47,"رددت بعيسى الروم من حيث أقبلت","https://www.poetsgate.com/ViewPoem.aspx?id=32921",""],[47,"لَيَالينا بَينَ اللّوَى، فمُحَجَّرِ،","https://www.poetsgate.com/ViewPoem.aspx?id=31220",""],[189,"أرى الناس قد أغروا ببغى وغيبة","https://www.aldiwan.net/poem14801.html","الطويل"],[369,"لها في حمى مني وراء الترائب","https://www.aldiwan.net/poem60994.html","الطويل"],[445,"نجوم الصبا أين تلك النجوم","https://www.aldiwan.net/poem34849.html","المتقارب"],[510,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[563,"وجودي جل عن جسمي","https://www.aldiwan.net/poem34248.html","الهزج"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203678","الهزج"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124726","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27476","البسيط"],[2630,"","https://poetry.dctabudhabi.ae/diwan/poem/107319","الرجز"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86274","البسيط"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104922","الطويل"],[5189,"طيبة","https://www.poetsgate.com/ViewPoem.aspx?id=208519",""],[5277,"وطن الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=190100",""],[5376,"سيذكرني قومي اذا كنت ثاويا","https://www.poetsgate.com/ViewPoem.aspx?id=188256",""],[5605,"مصائب حب","https://www.poetsgate.com/ViewPoem.aspx?id=159789",""],[5638,"قيدي يحدثني","https://www.poetsgate.com/ViewPoem.aspx?id=198120",""],[243,"وحي النيروز","https://www.poetsgate.com/ViewPoem.aspx?id=20962",""]],"verses":[["وَآنِيَةِ اللُحومِ مِنَ القَضايا","أَعَدتَ لَهُنَّ كَيّاً أَو نُضاجا",0,"ج",2,0],["وَإِنّي هَجَرتُ الراحَ حَولاً مُجَرَّماً","لَهُ وَشُهودي بِالَّذي قُلتُ شُهَّدُ",1,"د",1,0],["وَإِنِّيَ هَجرٌ لِلمُدامِ وَقَد جَلا","لَنا الصُبحَ مِن قُطرُبُّلٍ وَبَلَشكَرِ",2,"ر",1,0],["وَأَن يَهزِمَ الصَفَّ الكَثيفَ بِطَعنَةٍ","لَهُ عامِلٌ في إِثرِها مُتَتابِعُ",3,"ع",1,0],["وَإِنّي هَداكِ اللَهُ صَرمي سَفاهَةٌ","وَفيمَ بِلا ذَنبٍ أَتَيتُهُ أُهجَرُ",4,"ر",1,0],["وَإِن يَهلِكِ النُعمانُ تُعرَ مَطِيَّهُ","وَيُلقَ إِلى جَنبِ الفِناءِ قُطوعُها",5,"ع",3,0],["وإني هجرت الراحة حولا مجرماً","له وشهودي بالذي قلت شهد",6,"د",1,0],["وأني هجر للمدام وقد جلى","لنا الصبح من قطربل وبلشكر",7,"ر",1,0],["وإِن يَهْو للنسوان سمَّوه عاصيا","وإِن عفَّ قالوا ذاك خبث وباطل",8,"ل",1,0],["وإن يَهْرُبِ الباغي فكم من مُهالكٍ","مَصائدُها مَنصوبةٌ في المَهارِب",9,"ب",1,0],["وإِنْ يَهْنِكَ اليومَ عيدٌ يَعودُ","فَيَهْنِ لَنَا مِنْكَ عيدٌ يُقيمُ",10,"م",1,0],["وأنّي هالني استكبا","رُهم في الأرضِ عُميانا",11,"ن",2,0],["وإني هدهدُ الأخبا","ر للقوم الأُلَى قبلي",12,"ل",2,0],["وان يهجرني أنسي","ولينُ المنطق العذب",13,"ب",1,0],["وإن يهوى الصيام فصوم نومٍ","إلى يومين مر له مريرُ",14,"ر",1,0],["وأنْ يهيىء لي من أمرنا رشَداً","وأنْ يليّن مني قلبيَ القاسي",15,"س",2,0],["وإن يهب داراً لهُ شخصانِ","يجوزُ لا العكسُ لدَى النُعمانِ",16,"ن",1,0],["وَان يَهزَّ يراعاً في انامِلِهِ","خِلنا العَوالي بِها وَالصارِم الذكرا",17,"ر",2,0],["وان يهو قلبي غير ما تهويانه","تركت هواه واتبعت هواكما",18,"م",2,0],["وإني هائمٌ لا همَّ عندي","سوى أزدانُ فيضًا من بهاكِ",19,"ك",1,0],["وإنْ يَهُبَّ نسيمُ الشّرقِ أوْصِ بِنا","علَّ النّسيمَ بِشوقِ الوجدِ يأتينا",20,"ن",2,0],["وإنَّي هلالُ الليلِ ارجو محاقَهُ","ففي القبرِ وحشُ الليلِ ما كان باديا",21,"ي",2,0],["وأن يهديك دار الخلد يوما","ويحسن عوننا في دار حسن",22,"ن",1,0],["وَإِنْ يَهْلِكْ فَلِلأَحْرَا","رِ رَمْزٌ فِي الدُّجَى بَدْرُ",23,"ر",1,0],["وأن يهب إلى الأغلال يحطمها","شعب وتنشق عن عينه أستار",24,"ر",1,0]]}