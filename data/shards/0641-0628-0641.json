{"poems":[[95,"فوجئت فيك بأنكر الأنباء","https://www.aldiwan.net/poem9849.html","الكامل"],[95,"أليوم عيد البائس المتألم","https://www.aldiwan.net/poem11290.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54897","الخفيف"],[119,"يا آل الرسول ويا طه","https://www.aldiwan.net/poem41955.html","مجزوء الكامل"],[164,"لك كل يوم خارقات تبهر","https://www.aldiwan.net/poem58926.html","الكامل"],[230,"عش للعلا مولى وذخرا","https://www.aldiwan.net/poem55229.html","مجزوء الكامل"],[237,"ما للدموع تسيل سيل الوادي","https://www.aldiwan.net/poem14701.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138340",""],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104571","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62557","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119941","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112814","الخفيف"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203760","الخفيف"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126231","المتدارك"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93718","الكامل"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70339","الكامل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130826",""],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67973","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126984","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138657",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110110","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111389","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123497","الكامل"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105533","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83527","الكامل"],[4858,"إلى كل معلم فاضل","https://www.poetsgate.com/ViewPoem.aspx?id=30114",""],[4984,"هي مهلة","https://www.poetsgate.com/ViewPoem.aspx?id=178907",""]],"verses":[["فبفضل آية شيمة طاح الردى","قبل الأوان ونور آي ذكاء",0,"ا",2,0],["فَبِفَضْلِ مَا صَنَعُوا تَقَضَّتْ حَاجَةٌ","فِي كُلِّ طَارِئَةٍ لِكُلِّ مُيَمِّمِ",1,"م",1,0],["فَبِفضْلِ الزَّعِيمِ طَلْعَتَ حَرْبٍ","صُلِحَ الأَمْرُ بَعْدَ أَنْ كَان أَمْرَا",2,"ر",2,0],["فبفضله وبفضل أم","مكم المعظم مرتقاها",3,"ا",3,0],["فبفعله يُجزى ويرجعُ خاسئاً","من كان للقدرِ المقدَّر يُنكرُ",4,"ر",1,0],["فَبِفَضلِ ذا وَبِمِثلِ ذا","حقٌّ لِعَينِك أَن تَقَرّا",5,"ر",2,0],["فَبِفَضلِكَ المَحروسِ أَصبَحَ لي عُلاً","تَرنو إِلَيهِ أَعيُنُ الأَضدادِ",6,"د",1,0],["فبفضلهم وبنبلهم أوطاننا","نهضت وكان للعلاء الاسبقا",7,"ق",2,0],["فبفضلِكم نطقَ الكتابُ مبرهناً","وبهديكُم فيما تشابه يُقتدى",8,"د",2,0],["فبفضله يعِدُ الورى","وببأسه يتوعدُ",9,"د",1,0],["فبفيه مدبغه إذا ضمَّنتها","فضلت قِحاباًُ عنده ودِنانا",10,"ن",2,0],["فبفضل على يا رب فامنن","بالرضى منك واهد نفسا كسيره",11,"ر",2,0],["فبفكري في أمرها طار عقلي","وبخوفي من شرها طاش لبي",12,"ب",2,0],["فَبِفَضلِك بينَ الكُربَةِ حَل","وإذا بكَ ضاقَ الذرعُ فَقُل",13,"ل",1,0],["فَبفلكك العالي نَعُدُّك أَشيَباً","وَتُعَدُّ في قُرب الولود جَنينا",14,"ن",2,0],["فبفرط صدك بل بفرط محبتي","إلا نظرت إلي نظرة مشفق",15,"ق",1,0],["فبفضل الجد ادراك المنى","وبحسن السبك قد ينفي الزغل",16,"ل",1,0],["فبفيصلٍ رسختْ عَلَى أعتابِها","قدمُ للمَالكِ إِذ بِهِ تَتَرَتَّب",17,"ب",1,0],["فبفضله يعقوب ضاع بقومه","وكذاك صالح ضاغ بين ثمود",18,"د",1,0],["فبفقده غصبت خلافة آله","وتأمرت في المسلمين لئامها",19,"م",3,0],["فبفُلك نوحٍ رسمُها وهو المدبرُها","الوحيدُ وما لهُ من ثانِ",20,"ن",1,0],["فَبِفيبُوسَ فَرعِ زَفسَ المُعَلَّى","مَن سِهَامَ الرَّدَى يَهِيلُ هُمُولا",21,"ل",2,0],["فبفضله سأل الحميدى لمحة","يهدى اليه بها الهدى والمنقذ",22,"ذ",1,0],["فبفتح من مقلتيه وغمض","تجد الكون أقمر اللون أقتم",23,"م",1,0],["فَبِفَضلِكَ اللَهُمَّ جَمِّلني بِها","حَسّاً وَمَعنىً فَهيَ لِلتَقوى سَبب",24,"ب",1,0],["فبفضل جهدكَ يا معلمُ ذللتْ","هذي القطوفِ بروضتي تذليلاً",25,"ل",2,0],["فبفضل ربي قد شُفِيت وعدت في","عِزِّ النوائب في المباح محنَّكا",26,"ك",2,0]]}