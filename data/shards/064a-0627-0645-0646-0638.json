{"poems":[[90,"البحر رهو والسما صاحيه","https://www.aldiwan.net/poem44450.html","السريع"],[52,"يا منظرا حسنا رأيته","https://www.aldiwan.net/poem64743.html","مجزوء الكامل"],[92,"في الأربعين","https://www.poetsgate.com/ViewPoem.aspx?id=179041",""],[236,"ما بال أنفاس النسيم إذا سرت","https://www.aldiwan.net/poem44597.html","الكامل"],[371,"هذا عذاب لا يفتر","https://www.aldiwan.net/poem16991.html","مجزوء الكامل"],[382,"السيف والحيف في حرب وفي حربِ","https://www.aldiwan.net/poem66948.html","البسيط"],[382,"عج بالحمى يا راكب الوجناء","https://www.aldiwan.net/poem66977.html","الكامل"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/128258","الدوبيت"],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76545","الكامل"],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76550","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114550","الكامل"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103546","المنسرح"],[4772,"وشاح الغواية","https://www.poetsgate.com/ViewPoem.aspx?id=190803",""],[4856,"كوفية الياسر/لضياء عواد","https://www.poetsgate.com/ViewPoem.aspx?id=36096",""],[5191,"يا من ظلمتَ","https://www.poetsgate.com/ViewPoem.aspx?id=211975",""],[5285,"نجم المجرة","https://www.poetsgate.com/ViewPoem.aspx?id=203532",""],[5942,"هزي بجذع حنيني","https://www.poetsgate.com/ViewPoem.aspx?id=215683",""],[5956,"أنا لم أعد لك هاويا","https://www.poetsgate.com/ViewPoem.aspx?id=182510",""],[5977,"إلى معلم الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=213299",""],[6125,"أينَ المُدامُ وأينَ الكأسُ والسَّاقي","https://www.poetsgate.com/ViewPoem.aspx?id=211074",""]],"verses":[["يا منظراً أضحك ثغر الدجى","ورد سحبان إلى باقل",0,"ل",1,0],["يا مَنظَراً حَسَناً رَأَيتُه","مِن وَجهِ جارِيَةٍ فَدَيتُه",1,"ت",2,1],["يا منظراً يَشتهِي فيه العَمى بَصَرٌ","ويانَعِيّاً عليه ُ يُحمَدُ الصَمَم",2,"م",1,0],["يا من ظلال المكرمات به صفت","وصفت مشارب بالضلال تكدرت",3,"ت",1,0],["يا مُنظِري بِوُعودِهِ","أَتَظُنُّني بِالحَتفِ أُنظَر",4,"ر",1,0],["يا منظراً ترشق الألحاظُ أسهمَه","فاعجب به هدفاً يُصمَى ولم يُصَبِ",5,"ب",1,0],["يا منظراً لم يَخفَ رَسمُ ضِيائِهِ","يومَ اعتِلانِ السِرِّ في البيداءِ",6,"ا",2,0],["يا من ظلم النفس وأخطا وأسا","هذا حرم يغسل عنك الدنسا",7,"س",2,1],["يا مَنظَراً لِلحُسنِ فيهِ بَدائِعُ","شَهِدَت بِإِبداعِ القَديرِ الواحِدِ",8,"د",1,0],["يا مَنظَراً إِن بَدا كانَت مَحاسِنُهُ","لِلحِبّ عُذراً وَلِلاحِي لَهُ خَجَلا",9,"ل",2,0],["يا من ظُهُورُهُ رحمةٌ للعالمين","وبرهُ سارٍ مع الأنفاسِ",10,"س",1,0],["يا منظراً إن رمقت بهجته","أذكرني حسن جنَّةِ الخلد",11,"د",1,1],["يا من ظننت بأنني تلميذةٌ","علّمتُ في بوحِ الجمال ملاحا",12,"ح",2,0],["يا مَنْ ظننتمْ أنّنا أُلعوبةً","فإذا بنا جيشٌ أَشد دعائِما",13,"م",2,0],["يا مَنْ ظَلمتَ، تَلذّذاً، أَسرَاكا","غَفَرَ الإِلهُ، بِرفقِهِ، ظُلماكا",14,"ك",2,1],["يا مَنْ ظننتُ بأن يداوي علَّتي","حمَّلتَني ما لا أُطيقُ من العللْ",15,"ل",1,0],["يا مَنْ ظلمتم من الأحبابِ وصلَهمُ","توبوا وجِدُّوا ليرضى اللهُ واعتذروا",16,"ر",3,0],["يا من ظلمتَ مشاعري","سأعيش عمري باكيا",17,"ي",2,0],["\"يا من ظننت بي الهوان تجنياً\"","إني لأنشىء في الأنام عقولا",18,"ل",2,0],["يَا مَنْ ظَفَرتِ بقلبٍ أستَعِينُ بهِ","أمَامَ كلِّ خَيَالاتي وآفَاقِي",19,"ق",2,0]]}