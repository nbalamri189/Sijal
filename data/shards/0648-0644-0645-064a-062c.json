{"poems":[[65,"واها لأيامي بأكناف اللوى","https://www.aldiwan.net/poem46135.html","الرجز"],[79,"سبع مضت من زمان الليل وا أسفي","https://www.aldiwan.net/poem35926.html","البسيط"],[88,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[10,"كأن ابن عمرو لم يصبح لغارة","https://www.aldiwan.net/poem21085.html","الطويل"],[95,"علمتنا بالمثال والقلم","https://www.aldiwan.net/poem11355.html","المنسرح"],[53,"من ذا رأت عيناه مثلي في الشجا","https://www.aldiwan.net/poem9239.html","الرجز"],[72,"تعشقتها مثل الغزال الذي رنا","https://www.aldiwan.net/poem42811.html","الطويل"],[33,"أرقت وآبني همي","https://www.aldiwan.net/poem41329.html","مجزوء الوافر"],[50,"دع الرسم الذي دثرا","https://www.aldiwan.net/poem63390.html","مجزوء الوافر"],[48,"هل آن للقيد أن تفكه","https://www.aldiwan.net/poem23093.html","مجزوء البسيط"],[48,"لقد آن أن يثني الجموح لجام","https://www.aldiwan.net/poem23643.html","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62219","الطويل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30460","الطويل"],[111,"لن ترضي الله حتى تخلص الورعا","https://www.poetsgate.com/ViewPoem.aspx?id=106",""],[92,"إلى الباجة جي \" في نكبته\"","https://www.poetsgate.com/ViewPoem.aspx?id=179138",""],[92,"العَدل","https://www.poetsgate.com/ViewPoem.aspx?id=179159",""],[136,"وبعد كالنفي إتباع الذي اتصلا","https://www.aldiwan.net/poem54670.html","البسيط"],[146,"عساها تنجلى وخلاك ذم","https://www.aldiwan.net/poem58401.html","الوافر"],[147,"بقيت لذا العز الذي عز مطلبا","https://www.aldiwan.net/poem11733.html","الطويل"],[190,"إذا المصدور لم ينفث لما قد","https://www.aldiwan.net/poem43343.html","الوافر"],[234,"تميط الأذى عن حامليها الصوارم","https://www.aldiwan.net/poem50832.html","الطويل"],[234,"بذلة اللين من ألفاظك الخفرة","https://www.aldiwan.net/poem51086.html","البسيط"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[366,"مهلا فمالك في هذا الجمال شبه","https://www.aldiwan.net/poem68135.html","البسيط"],[368,"بالعفر دار من جميلة هيجت","https://www.aldiwan.net/poem1718.html","الطويل"],[369,"أأحبابنا قد شقتمونا فأسعدوا","https://www.aldiwan.net/poem60942.html","الطويل"],[409,"خلعت ردا التشبيب عن منكب الفكر","https://www.aldiwan.net/poem33905.html","الطويل"],[415,"فيا أخا العزم يطوي البيد منصلتا","https://www.aldiwan.net/poem32225.html","البسيط"],[422,"أعالج قلبا في هواكم معذبا","https://www.aldiwan.net/poem54034.html","الطويل"],[422,"اليوم أصبح فيك الوقت منتظما","https://www.aldiwan.net/poem54127.html","البسيط"],[438,"مالك قلبي عن يد","https://www.aldiwan.net/poem12587.html","مجزوء الرجز"],[463,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[469,"جد الغرام وزاد القال والقيل","https://www.aldiwan.net/poem3635.html","عموديه"],[543,"حبيبة بحبها الحسن أمر","https://www.aldiwan.net/poem48126.html","عموديه"],[556,"ما لك في ربة الغلائل","https://www.aldiwan.net/poem47285.html","الرجز"],[572,"أخوك الذي إن أفسد الدهر وده","https://www.aldiwan.net/poem69503.html","الطويل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48812","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48729","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48573","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77663","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77535","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77503","المنسرح"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77597","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77486","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70783","المنسرح"],[469,"","https://poetry.dctabudhabi.ae/diwan/poem/205216","البسيط"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72309","البسيط"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72310","المتقارب"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64964","الطويل"],[136,"","https://poetry.dctabudhabi.ae/diwan/poem/118523","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112870","البسيط"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109267","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47500","البسيط"],[1533,"","https://poetry.dctabudhabi.ae/diwan/poem/105653","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108631","البسيط"],[1798,"","https://poetry.dctabudhabi.ae/diwan/poem/114919","الطويل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137932",""],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109745","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124777","الطويل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121184","السريع"],[2899,"","https://poetry.dctabudhabi.ae/diwan/poem/107125","الوافر"],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100725","البسيط"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121372","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48282","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48276","السريع"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92193","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91287","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133247","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135719","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77067","الطويل"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17776","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123512","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54495","المجتث"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103253","الوافر"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146756","الطويل"],[4767,"عين الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=93516",""],[4767,"ساعة الصفر","https://www.poetsgate.com/ViewPoem.aspx?id=179844",""],[4828,"سيرةُ ضوء","https://www.poetsgate.com/ViewPoem.aspx?id=193407",""],[4984,"\" ليس الأدل \" 1","https://www.poetsgate.com/ViewPoem.aspx?id=175797",""],[5277,"سفيرةُ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=185437",""],[5277,"الحبُ بعيونٍ بغدادية..","https://www.poetsgate.com/ViewPoem.aspx?id=202674",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5885,"نتقاتل","https://www.poetsgate.com/ViewPoem.aspx?id=194800",""],[5939,"الرجل الحديدي","https://www.poetsgate.com/ViewPoem.aspx?id=188441",""]],"verses":[["ولم يُجِلْ فيها الكَميُّ طَرْفَهُ","إلا تلقَّتْ ناظِرَيْهِ بالعَشا",0,"ا",1,0],["ولمْ يجُدْ بتَلافِيها علَى عجَلٍ","ما أمْرُها صائِرٌ إلا الى تلَفِ",1,"ف",1,0],["ولم يَجُزْ بَلدَةً إلا سَمِعْتَ بها","اللهُ أكبرُ تَدوي في نَواحيها",2,"ي",3,0],["وَلَم يُجزِ إِخوانَ الصَفاءِ وَيَكتَسي","عَجاجاً أَثارَتهُ السَنابِكُ أَكدَرا",3,"ر",2,0],["وَلَمْ يُجْنِّبْكَ مَا خُصِصْتَ بِهِ","مِنَ النَّعِيمِ الشَّعورَ بِالأَلَمِ",4,"م",1,0],["ولم يجِدْهُ الجهلاءُ أهوجا","وانظر ولا تَغْشَ الطريق الأعوجا",5,"ج",2,0],["وَلَم يَجحَدوها مالَها مِن مَلاحَةٍ","لِعِلمِهِمُ ما في مَلاحَتِها خُلفُ",6,"ف",1,0],["وَلَم يُجازِنا بِالوُد","دِ أَحفى بي وَلَم يَكمِ",7,"م",1,0],["وَلَم يَجعَل مَصايِدَها","يَرابيعاً وَلا وَحَرا",8,"ر",2,0],["وَلَم يَجِد سائِلٌ عَليماً","يُزيلُ بِالموضِحاتِ شَكَّه",9,"ك",2,0],["ولم يَجْلِبُوهَا من وَرَاءِ مَلَطْيَةٍ","تَصَدَّعُ أجْبَالٌ بها وإكامُ",10,"م",1,0],["ولَمْ يَجْرِ بِالأَخْبَارِ بَيْنِي وبَيْنَهُمْ","أَشَقُّ سَبُوحٌ لَحْمُهُ قَدْ تَحَسَّرَا",11,"ر",2,0],["ولم يَجْتَنِبْ للبَطْشِ مُهْجةَ قادِرٍ","قوىٍّ ولا للضَّعْفِ مُهْجةَ صافِرِ",12,"ر",1,0],["ولم يجد صانع اتقان صنعته","حتى يكون على علم بما صنعا",13,"ع",2,0],["ولم يجدِ الواشون للكيدِ مَطْمَعاً","لديكَ ولم يَخْدِشْ مساعيك واصم",14,"م",1,0],["ولم يجدوا مَندوحةً عن قَبوله","لإرضاءِ مخدوعينَ بالعدل غَّرروا",15,"ر",3,0],["وَلَم يَجِىء بَعدَ مَا تَمَّ الكلامُ وَلَم","يُنقُض بِإلا وإِلا النَّصبُ فِيهِ عَلا",16,"ل",2,0],["ولم يَجرِ السؤالُ على لسانى","ولا ندَّى يدى بحرٌ خِضمٌ",17,"م",1,0],["وَلَم يَجِدوا غَيمَ المَواعيدِ زِبرِجاً","لَدَيهِ وَلا بَرقَ الطَلاقَةِ خُلَّبا",18,"ب",2,0],["ولم يجد السبيل إلى التشاكي","كما يشكو الخيل إلى الخليل",19,"ل",1,0],["ولم يَجُلْ بالقنا والخيلُ ساهمةٌ","فَتىً ولم يَجْر بين الجَحْفَلَيْن دم",20,"م",1,0],["ولم يجِد ناصراً يقوى عليك به","لمّا غَدَوْتِ بسحر الطرِف منتصِره",21,"ر",2,0],["وَلَم يُجرِني صَديقٌ في تَغَلُّبِهِ","هَيهاتَ مِن مُنجِدٍ مِنهُم بِصَيبِهِ",22,"ه",1,0],["وَلَم يَجِد بابَ سَلوان يُريح بِهِ","من لامَه في صُروف الحُبّ أَوعيته",23,"ه",1,0],["وَلَم يَجِدِ الأَقوامُ فينا مَسَبَّةً","إِذا اِستُدبِرَت أَيّامُنا بِالتَعَقُّبِ o",24,"ب",1,0],["ولم يَجتمْع في الأفْقِ بَدْرٌ وأنجمٌ","كما اجتَمعا للمرء نَفْسٌ وَمحْتِد",25,"د",1,0],["ولم يجر في البحر الذي قد ركبته","خشى غرقاً إن كان في بحركم بحري",26,"ر",2,0],["ولَم يَجُدْ لي بطَرفٍ من مواهِبهِ","وكم حَبانِي وكم أسْنَى ليَ المِنَحَا",27,"ح",2,0],["ولم يُجْدِني إرهافي العزمَ في المنى","وما حيلتي بالصارم العضب إنْ نبا",28,"ب",2,0],["ولم يجد سلَّما يرقى السماء به","ولو رمى نفسه في البحر لالتُقما",29,"م",2,0],["ولم يجُدْ بربّةٍ","لغُلّةِ القلبِ الصدي",30,"د",2,0],["ولم يجد حاسدُه","عيباً له تعلّلا",31,"ل",2,0],["ولم يجبْ آدمٌ في حال دعوته","نعم لم يكُ قابيلٌ وهابيل",32,"ل",1,0],["ولم يَجِد لِدائِه يَوماً دَوا","إلا اللّقا مع ابتسام الثَّغرِ",33,"ر",1,0],["ولم يَجُزْ همُّ الفتى عن نفسه","وذُهِلَ الحيُّ عن العقائلِ",34,"ل",1,0],["وَلَمْ يَجْفُهُ مُسْتَأْنِفَاً وُدَّ صَاحِبٍ","لَعَلَّكَ تَلْقَاهُ أَعَقَّ وَأَظْلَمَا",35,"م",2,0],["ولم يجد في الناس للخلافة","أهلا سوى مولى أبي حذيفة",36,"ه",1,0],["ولم يجد عليه من جناح","إلا الذي قال من المزاح",36,"ح",1,0],["ولم يجز لحال ما قد فعلا","من جوزه في حكمه أن يقتلا",36,"ل",2,0],["ولم يجئ بجديد في سياسته","غير الوسيلة والمعيار والسبب",37,"ب",1,0],["ولم يجن أعدائي على كل ما جنى","زماني وأحبابي وهذي المواطن",38,"ن",1,0],["ولم يجد عنكمُ يوماً به خبراً","فينثني وسعير الشوق يكويهِ",39,"ي",2,0],["وَلَم يَجد لِحلّها مِن بابِ","وَضَلَّ في الرَأي عَنِ الصَوابِ",40,"ب",1,0],["وَلَم يَجد قِرناً لَهُ في الغابه","وَلا نَغيصا يَشتكي عَذابه",41,"ه",1,0],["وَلَم يَجد نَحوَها سَبيلا","مِن رُمح قَدٍّ لَهُ سِنانُ",42,"ن",1,0],["وَلَم يَجد كُلٌّ منغصا بَدا","كلا وَلا ذاقَ الأَذى وَالنكدا",43,"د",2,0],["وَلَم يَجد كَنزاً وَلا لَقيَّه","بَل رمَّة في حجره مرميَّه",44,"ه",1,0],["ولم يجد نصفَ قوت ليلته","وليس يبغي سوى جواركمُ",45,"م",1,0],["ولم يجبْ آدمٌ في حال دعوته","نعم ولم يكُ قابيلٌ وهابيل",46,"ل",1,0],["ولم يجز ذاك الا للنبي وما","في غيره حجة يوماً لذي جدل",47,"ل",1,0],["ولم يجدوا في الورى غير من","يمالي على القوم أو يجذل",48,"ل",1,0],["ولم يَجْوَ صَفْوَ العَيشِ إِلاّ مُطلِّقٌ","لدُنياهُ أَو مَلْكٌ أَعَزُّ هُمامُ",49,"م",1,0],["ولم يَجعَلُوا الأحسَابَ لِلوَفرِ جُنَّةً","ولَكِن عَنِ الأحسَابِ يَفنُونَ بالوَفرِ",50,"ر",1,0],["ولم يجد نهضة للصالحات ولا","حالا يوافق في الابكار والاصل",51,"ل",1,0],["ولم يجن غير المرّ من ثمراتها","وما شب حتى بات يرجو محاقها",52,"ق",3,0],["ولم يجز في شعرهم أن تجمعا","بحرين في قصيدة أصلا معا",53,"ع",2,0],["ولم يجيء بذاك شعر عربي","ولم يجزه عالم بالأدب",53,"ب",1,0],["ولم يجز إيراده مع مطوي","لأن ذاك الردف فيه مروي",53,"ي",1,0],["وَلَمْ يَجُدْ بِقَناطِيرٍ مُقَنْطَرَةٍ","قَدْ أَرعبت باسْمِهِ ابْرِيزَها السِّكَكُ",54,"ك",1,0],["ولم يجر الدموع حداء حاد","ولا ذكرى ليالي لا تعود",55,"د",1,0],["ولم يجب دعوة الداعي لمظلمةٍ","ولم يبع نصرة المظلوم بالبُدَر",56,"ر",1,0],["ولم يجعل اللَه الأمور إذا اجتَدَت","عليك رِتاجاً لا يرامُ مُضَبَّبا",57,"ب",2,0],["ولم يجنِ منها غير غلبٍ لاجله","دعا مستغيثاً قيصر الروس مرغما",58,"م",2,0],["ولم يجعل الرحمن قلبين لامرءٍ","لئلا يرى في جسم شخصٍ رئيسانِ",59,"ن",1,0],["ولم يجتمع في منخر المرء يا فتى","غبار جهاد مع دخان لظى الصدي",60,"د",2,0],["ولم يجب الا ابو يوسف","مسألة لعلها شافيه",61,"ي",2,0],["ولم يجر الأمور على قياسٍ","فليست دارنا دار الجزاء",62,"ا",2,0],["ولم يجيبوا بعد لا بجير","عنه تولوا حسداً وشركا",63,"ك",2,0],["ولم يجد معركا الا أناف به","والموت ما بين إقبال وإدبار",64,"ر",1,0],["ولم يجترم للنفس عزّاً يصونها","فلا فرقَ بين العبدِ والرجلِ الحرّ",65,"ر",1,0],["ولم يجْنِ من روْضِ المُنَى زهْرَ رِفْدِهِ","فأيَّ ظِلالٍ للنّدَى يتفيّأُ",66,"ا",1,0],["ولم يجُدْ للجودِ غيثٌ بها","فلا جَنابٌ عندَها مخْصِبُ",67,"ب",1,0],["ولم يجد المعزز من زمانٍ","فقم نشكو الجميعَ إلى الكؤوس",68,"س",1,0],["وَلم يُجعَلِ التفريق من بَعد وَصلة","لِأَمر سِوى أَن لا يُهمَّ نَعيم",69,"م",1,0],["ولم يجد التنصل من ذنوبي","ولا الإصرار في كتمان إصري",70,"ر",2,0],["ولم يجىء فعّال من أفعل قيلْ","سوى ثلاثٍ قالها كل نبيلْ",71,"ل",1,1],["ولم يجر بل فار متقدا","فهيرا دعا يطلب المددا",72,"د",2,0],["وَلَم يَجِدوا إِلّا السُيوفَ مَعاقِلاً","وَرَأيِكَ فيهِمُ كانَ جُنداً مُجَنَّدا",73,"د",2,0],["وَلَم يَجِد لِقُراهُم غَيرَ مُربِعَةٍ","مِن العِشارِ تُزَجّي تَحتَها رُبَعاً",74,"ع",2,0],["ولم يجد مخلصا الامدائح من","عنا العناء وكل الاصر قد جعظا",75,"ظ",2,0],["ولم يَجُزْ من أُمورِ الدُّ","نيا سِوى ما أَجَزْنا",76,"ن",2,0],["ولم يجر الزمان وكل حي","تعاقبه الشدائدُ والرخاء",77,"ا",2,0],["وَلَم يَجُد كَجُودِهِ شَقيقُهُ","فَأَظهَرَ الخجلَةَ مِنهُ واستَحَى",78,"ا",1,0],["ولم يجتمع كفاه والمال ساعة","كأني وريا ماله وأنامله",79,"ل",2,0],["ولم يجزع له قلبٌ ولو كا","نَ جيشُ الغادرين له عُبابا",80,"ب",2,0],["ولم يجد في الورى للحق منتصراً","لِما تبَقى من الأشلاء ينتشلُ",81,"ل",1,0],["ولمْ يجدْ غيرَ قلبٍ تاقَ معرفةً","للغيبِ ، يرقى عُروجاً في تساميهِ",82,"ي",2,0],["ولم يجد للذات رسما سوى","رجع الصدى في صرخة من جبل",83,"ل",1,0],["ولمْ يجدك سِواي السرّ منْكشِفاً","وكلّ سرٍّ بقلبي منْك منْكشفُ",84,"ف",1,0],["ولم يجحدك من عشقٍ وَليٌّ","وفي صوبيْكِ محرابُ المُريدِ",85,"د",1,0],["ولم يجر في هذا خصومة من خلا","من الأمم الماضين والرسل ذي الرشد",86,"د",1,0],["وَلَمْ يَجْتَرِمْ مِنْ حُرْمَةٍ غَيْرَ أَنَّهُ","يُصَلِّي وَيَدْعُو اللهَ وَاللهُ كَافِلُ",87,"ل",1,0],["ولم يَجذبْكِ يوما مغنطيسي","كأنكِ كنتِ في وادٍ بعيدِ",88,"د",1,0]]}