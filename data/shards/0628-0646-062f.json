{"poems":[[55,"من رأى البرق بغوري السند","https://www.aldiwan.net/poem30636.html","الرمل"],[47,"غال صبري إما سألت بصبري","https://www.aldiwan.net/poem63641.html","الخفيف"],[63,"هل سبيل إلى تقاصر ليل","https://www.aldiwan.net/poem51466.html","الخفيف"],[46,"صدفت لهيا قلبي المستهتر","https://www.aldiwan.net/poem29984.html","الكامل"],[23,"","https://poetry.dctabudhabi.ae/diwan/poem/6557","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54511","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55060","الخفيف"],[147,"من عف عن ظلم العباد تورعا","https://www.aldiwan.net/poem11773.html","الكامل"],[147,"لا زال ملكك بالعلى مأهولا","https://www.aldiwan.net/poem11789.html","الكامل"],[147,"يا ديمتي نوء الثريا دوما","https://www.aldiwan.net/poem11820.html","الكامل"],[240,"لمن الركائب تستقي","https://www.aldiwan.net/poem31796.html","مجزوء الكامل"],[240,"شكري لسيب نوالك الغمر","https://www.aldiwan.net/poem31998.html","الكامل"],[240,"وبخيلة سمح الرقا","https://www.aldiwan.net/poem32174.html","مجزوء الكامل"],[242,"ما لمن مسه من الفقر داء","https://www.aldiwan.net/poem18031.html","الخفيف"],[287,"حلفت لي هند فخانت يميني","https://www.aldiwan.net/poem32333.html","الخفيف"],[290,"بنداوكم جبل به شوك الكلا","https://www.aldiwan.net/poem39380.html","الكامل"],[438,"نسخ الجد مقال اللعب","https://www.aldiwan.net/poem12556.html","الرمل"],[445,"عيد ووعد صادق لك بالمنى","https://www.aldiwan.net/poem34852.html","الكامل"],[457,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[519,"سطعت شموس قبابهم بزرود","https://www.aldiwan.net/poem20810.html","الكامل"],[519,"سفرت فبرقعها حجاب جمال","https://www.aldiwan.net/poem20814.html","الكامل"],[614,"","https://poetry.dctabudhabi.ae/diwan/poem/105275","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126821","الخفيف"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101549","الكامل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34405","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63938","الخفيف"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199609","المسحوب"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120130","الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133784","الرمل"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117798","الرمل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144121","الكامل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78113","الرمل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50019","الكامل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113930","الخفيف"],[1616,"","https://poetry.dctabudhabi.ae/diwan/poem/206242",""],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128004","الكامل"],[1910,"","https://poetry.dctabudhabi.ae/diwan/poem/116562","الكامل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87791","البسيط"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137044",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137183",""],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87320","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87330","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89085","الكامل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61268","الخفيف"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129377","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36716","الكامل"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202340","الخفيف"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75709","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81713","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58003","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33267","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139658",""],[4119,"كيف قلتم ما عند عينيه ثار","https://www.poetsgate.com/ViewPoem.aspx?id=16142",""],[5145,"من رأى البرق تعالى وسنا","https://www.poetsgate.com/ViewPoem.aspx?id=108060",""],[5409,"كلما اجتاز بعدك الدهر ميلا","https://www.poetsgate.com/ViewPoem.aspx?id=155494",""],[5431,"قصيدة وجودية ...","https://www.poetsgate.com/ViewPoem.aspx?id=207830",""],[5840,"فيك برحت بالعذول إباء","https://www.poetsgate.com/ViewPoem.aspx?id=181437",""],[5956,"وصلتْ إليّ رسالةٌ من درِّ","https://www.poetsgate.com/ViewPoem.aspx?id=193810",""]],"verses":[["بِنَدى غُصنَينِ غُصنٍ وَنَقاً","وَجَنى عَذبَينِ شَهدٍ وَبَرَد",0,"د",1,0],["بِنَدى أَحمَدَ اِبنِ أَيّوبَ أَجلى","لَيلُ عُسري وَلاحَ لي وَجهُ يُسري",1,"ر",2,0],["بنديمٍ يواصلُ الصَّمتَ لاَ يس","ألُ عنَّا ولا يُجيبُ سؤالا",2,"ل",2,0],["بِنَداكَ يوسى كُلُّ جُرحٍ يَعتَلى","رَأبَ الأُساةِ بِدَردَبيسٍ قِنطَرِ",3,"ر",1,0],["بِنَدوَةٍ مِن قُصَيٍ كانَ وَرَّثَها","وَبِاللِواءِ وَحُجّابٍ قَماقيمِ",4,"م",1,0],["بِنَدَاهُ وَادِي النِّيلِ سَالَ وَبِالذِي","أسْدَاهُ طَالَ عَلَى الذُّرَى الشَّمَّاءِ",5,"ا",2,0],["بِنَدَاهُ سَقَى فَأَرْوَى ثُرَاهَا","وَحَمَى بِالنُّهَى مِنَ الإِغْرَاقِ",6,"ق",1,0],["بِنَداكَ واصَلَ حَمدَهُ مَن ذَمَّهُ","وَسُطاكَ قَد حَفِظَت لَهُ ما ضَيَّعا",7,"ع",2,0],["بِنَداكَ أَنجَزَ وَعدَهُ الزَمَنُ الَّذي","قَد كُنتُ أَعهَدُهُ أَلَدَّ مَطولا",8,"ل",2,0],["بِنَداكَ أَصبَحَ حاسِدي مَن كانَ لي","مِن قَبلِ إِفضائي إِلَيكَ رَحيما",9,"م",2,0],["بِنَدى أَبي العَبّاسِ أَن","جَزَ واعِدُ الأَمَلِ المَطولِ",10,"ل",1,0],["بِنَداكَ يا اِبنَ أَبي المَضاءِ مَضى","عَنّا زَمانُ البُؤسِ وَالعُسرِ",11,"ر",1,0],["بِنَداكَ يا اِبنَ مُحَمَّدٍ","رَفَّ الحَديثُ وَأَعشَبا",12,"ب",2,0],["بِنَدَى جُودِكَ الذِي غَرِقَتْ فِي","بَحْرِهِ الأَقْصِيَاءُ وَالْقُرَبَاءُ",13,"ا",2,0],["بنداهُ خَلَصتُ مِن هَمِّ دُنيا","يَ وفُرّغتُ لاستِقامَةِ ديني",14,"ن",2,0],["بنداوكم جبل به شوك الكلا","متنوع متشتت متعادي",15,"د",2,1],["بندى آل فُراتٍ غرسَتْ","فسقَوْها بفراتٍ عذِبِ",16,"ب",1,0],["بنَدىً إِذَا غَصَّ الغمامُ يَعُمُّنا","ويدٍ إِذَا شعِثَ الزمانُ تلُمُّنا",17,"ن",2,0],["بندامٍ ألذ من زورة الحِ","بِّ وأبهى من روضةٍ في قراره",18,"ر",2,0],["بِنداهُ يخضرُّ الحصى فكأنّما","أثَرُ الصّعيدِ له بكلِّ صَعيدِ",19,"د",1,0],["بنداهُ علّمني القريضَ فصُغتُه","فأتيتُ فيه مرصَّعَ الأقوالِ",20,"ل",1,0],["بنداك أخجلت الغمام وإنما","تعطي الجزيل ولم تكن تتعلم",21,"م",1,0],["بنداهُ قد أخجَلَ الأبحُرَ السب","عَ ولَم يبق للسحابِ مَجالا",22,"ل",2,0],["بنداك أصبحَ حاتمٌ في قبرهِ","حسداً يئنُّ وما لهُ تأساءُ",23,"ا",2,1],["بندى العلي القدر وَالنسب الزكي","المعتلي بن المعتلي بن المعتلي",24,"ل",2,0],["بندى بني حمدانَ سُدَّ خَصاصُنا","فمضى الخَصاصُ فما يُحَسُّ خصاصُ",25,"ص",1,0],["بندب مع الطرّاشي","سلامٍ ينعرب",26,"ب",1,1],["بندى وزير العصر اكتب مطلبي","وبه صفا ودّي وأَورق عودي",27,"د",2,1],["بندى أولِ فجرٍ","ذرّ في أفق بتول",28,"ل",1,0],["بندهُ الأزرقُ لما","شده من قد سباني",29,"ي",1,1],["بنَدى الرّئيس أبي المكا","رِمِ سوف تظفَرُ عن قريبِ",30,"ب",1,0],["بُندِها المُوَشى بِالوَرَق","مثل قَلبي دايم الخَفق",31,"ق",1,0],["بندى أبي الحسن الجواد المرتجى","وجَدَى بي العرب الكريم الكاملِ",32,"ل",1,0],["بِنَداهُم شُمُّ المناخرِ صيدٌ","محمدٌ جارُهم عزيزُ الجنابِ",33,"ب",1,0],["بندر لِمَنْ هبّت عليه العواصيف","شوق الهنوف الّلي كستها ثيابها",34,"ب",3,0],["بندى وجنته ولين قوامه","كم سهلت نيل المنى أوهامى",35,"م",2,0],["بنداك يصبغ ثوب شرَّته الغنى","أبداً ويصبغ صبغه الايقاض",36,"ض",1,0],["بَندٌ لِقَحطان قَد عَزَّزت جانبه","وَقَد طَوى عزَّه فِيما طَوى القِدَمُ",37,"م",1,0],["بندى ليندا الملاجئ اخصبت","وغصون الفضل باتت مورقه",38,"ق",2,1],["بندى ليند الملاجئ اخصبت","وغصون الفضل باتت مورقه",39,"ق",2,1],["بَندَر هَدودَه ثمَّ بندر كوري","ثمَّ رفاتي خَمسُ في المذكورِ",40,"ر",1,0],["بندرُ كوسَ ثمَّ بندر قاسِمِ","وكَندلي أربعةٌ للعالِمِ",40,"م",1,0],["بَندَرُ كُوسَ ثُمَّ غُبَّة كوري","مع بندرِ الشَجرةِ ذا المَشهورِ",40,"ر",1,0],["بَندَرُهَا الأعلَى في المَشَارِق","راسَ الكثيبِ قَد يَرَاهُ الخَارِق",41,"ق",1,0],["بَندَرُهَا عَلِيّ منها الرَّابِعِ","مِن أيٍِّ صَوبٍ جِيتَهُ فَوَاضِعِ",42,"ع",1,0],["بَندَر بِكُلِّ رِيحِ عِندَ العَارِفِ","إفهَم صِفَاتِهَا وَلا تُخَالِفِ",42,"ف",1,0],["بَندَر بِكلِّ رِيحِ فِيهَا يَلتَقِي","وَالنَّعشُ عَن خَمسَه وَنِصفٍ ضَيِّقِ",42,"ق",1,0],["بنداء بشرى المؤمنين مؤرخاً","قام المنادي مصطفى في الخلد",43,"د",1,0],["بِنداهُ تَأَدبَ الغَيثُ حَتّى","عمَّ إِذا جادَ صادِياتِ البيدِ",44,"د",1,0],["بندى علي ماء وجهي صنته","وأرحت قلبي عن معانات السرى",45,"ر",2,0],["بِنَداه أَمسى الجود مُلقٍ رَحلَهُ","لَما اِغِتَدى فيهِ مَحَطَّ الأَرحُلِ",46,"ل",1,0],["بندى يخجل الغيوث انهمالاً","وشذا ينهل الرماح الظماء",47,"ا",2,0],["بنديّ أنس قام يسرح شمعه","يغني سنا خديه عَن إِسراجها",48,"ج",3,0],["بندى أمير المؤمنين تَبَجَّسَتْ","سُحُبُ المكارمِ والسَّماح المُغْدَق",49,"ق",1,0],["بنداء يونس نادِهِ سحراً إذا","نام الخليُّ تجده غير بعيد",50,"د",1,0],["بِندَّاتِ دَمعِ العينِ مزدحم الصَّبرِ","فَخدُكَ ما ينفكُّ من عَبرةٍ تَجرِي",51,"ر",2,1],["بنداه كم قد قلَّد الدهرَ الندى","فزهت قلائد جوده في جيده",52,"د",2,0],["بندى من مؤيد الدولة الأروع","حبل على الوفاء مغار",53,"ر",1,0],["بنداه الجمّ عادت غزراً","قلب الجود وكان دفنا",54,"ن",2,0],["بنداء كأنه نفخةُ الصو","ر وقد كنت فيه إسرافيلا",55,"ل",2,0],["بندائه ترتدّ زوبعة","كادت تصبّ الشك بالزورق",56,"ق",1,0],["بندىً يخجل الغيوث انهمالاً","وجدىً ينهل الرماح الظماء",57,"ا",2,0],["بِنَداك طرتُ أردُّ دَيناً مؤلماً","ما كنت أقدر ردّهُ في القبرِ",58,"ر",1,0]]}