{"poems":[[55,"أي العيون تجانب الأقذاء","https://www.aldiwan.net/poem30780.html","الكامل"],[74,"تحلو الثغور بذكرك المتردد","https://www.aldiwan.net/poem18546.html","الكامل"],[74,"جسمي أبو ذر الضنا فذروني","https://www.aldiwan.net/poem20182.html","الكامل"],[53,"فيم التنازع والشقاق","https://www.aldiwan.net/poem65714.html","مجزوء الكامل"],[47,"يا أخا الحارث بن كعب بن عمر","https://www.aldiwan.net/poem65660.html","الخفيف"],[30,"هتمت قريبة يا أخا الأنصار","https://www.aldiwan.net/poem5194.html","الكامل"],[51,"يا ساكن الدنيا لقد أوطنتها","https://www.aldiwan.net/poem62017.html","الكامل"],[51,"لا عيش إلا الموت يقطعه","https://www.aldiwan.net/poem62171.html","السريع"],[18,"لابنة حطان بن عوف منازل","https://www.aldiwan.net/poem23912.html","الطويل"],[46,"ليت الظباء أبا العميثل خبرت","https://www.aldiwan.net/poem30345.html","الكامل"],[77,"صدق الفناء وكذب العمر","https://www.aldiwan.net/poem69076.html","أحذ الكامل"],[108,"الذئب","https://www.poetsgate.com/ViewPoem.aspx?id=179565",""],[108,"كرموه","https://www.poetsgate.com/ViewPoem.aspx?id=179708",""],[164,"كانت أحادا عند غيرك لا ثنا","https://www.aldiwan.net/poem58919.html","الكامل"],[189,"لمن الشموس غربن في الأحداج","https://www.aldiwan.net/poem14137.html","الكامل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[247,"لي حشى ما بليت شب سعيره","https://www.aldiwan.net/poem1343.html",""],[266,"يا ابن السرى والليل والبيداء","https://www.aldiwan.net/poem38377.html","الكامل"],[276,"سجعت بأيمنذي الاراك حمائمه","https://www.aldiwan.net/poem52099.html","الكامل"],[286,"صلوا على خير البريةِ خيما","https://www.aldiwan.net/poem1386.html","الكامل"],[287,"عدم الإسلام معدوم المثال","https://www.aldiwan.net/poem32634.html","الرمل"],[310,"سيان أن لبس التجمل أو عري","https://www.aldiwan.net/poem56550.html","الكامل"],[353,"ماذا على شؤم الدرا","https://www.aldiwan.net/poem20722.html","مجزوء الكامل"],[358,"منهل العشاق مورود","https://www.aldiwan.net/poem40392.html","المديد"],[369,"قربا لي يا صاحبي بعيدا","https://www.aldiwan.net/poem60938.html","الخفيف"],[463,"لو كنت دانيت المودة قاصيا","https://www.aldiwan.net/poem55811.html","الكامل"],[463,"دع بين جِلدي والعظام مكانا","https://www.aldiwan.net/poem55851.html","الكامل"],[463,"دعها تكن كالسلف من أخواتها","https://www.aldiwan.net/poem56263.html","البسيط"],[482,"ما الدمع بعد نوى الأحبة عار","https://www.aldiwan.net/poem15339.html","الكامل"],[505,"الخب ميال مع الشبهات","https://www.aldiwan.net/poem37714.html","الكامل"],[520,"إجر النسيم إلى السمائم","https://www.aldiwan.net/poem12266.html","مجزوء الكامل"],[556,"خلها إنها تريد الغميما","https://www.aldiwan.net/poem47231.html","الطويل"],[556,"شعر ناصع ووجه كئيب","https://www.aldiwan.net/poem48094.html","الخفيف"],[580,"سلام عليه لا على الدهر بعده","https://www.aldiwan.net/poem3075.html","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126784","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87214","الخفيف"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96640","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56088","الرمل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108679","الكامل"],[1859,"","https://poetry.dctabudhabi.ae/diwan/poem/142266","الطويل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96031","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53212","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53100","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28491","الكامل"],[2363,"","https://poetry.dctabudhabi.ae/diwan/poem/20704","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93651","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93631","الخفيف"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45688","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137081",""],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130051","الكامل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130096","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45738","الكامل"],[3625,"","https://poetry.dctabudhabi.ae/diwan/poem/204076","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216831","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131059",""],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133296","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97077","الكامل"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105530","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28727","الكامل"],[4929,"جنازة أيلول","https://www.poetsgate.com/ViewPoem.aspx?id=199973",""],[4935,"أضحى خطيب العلم فوق المنبر","https://www.poetsgate.com/ViewPoem.aspx?id=129451",""],[5121,"قَلَمِي","https://www.poetsgate.com/ViewPoem.aspx?id=33498",""],[5338,"أين الحميا من لمى من أرتجي","https://www.poetsgate.com/ViewPoem.aspx?id=187696",""],[5338,"في رثاء أستاذي الأول قدس الله سره","https://www.poetsgate.com/ViewPoem.aspx?id=187778",""],[5573,"سالفة وجد","https://www.poetsgate.com/ViewPoem.aspx?id=200346",""],[6069,"خير ما أصبحت مخلوع العذار","https://www.poetsgate.com/ViewPoem.aspx?id=105669",""],[6093,"يا لشهد ليتني من رشفه","https://www.poetsgate.com/ViewPoem.aspx?id=203797",""],[6345,"مايد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78663&r=&rc=34",""]],"verses":[["وَلَخَوضِ سَيفِكَ وَالفَوارِسُ تَدَّعي","حَرباً يَجُرُّ نِداؤُها الأَسماءَ",0,"ا",2,0],["ولخدك القاضي بمنع زكاته","عني وقد أثرت يداه بعسجد",1,"د",1,0],["ولخاطِري كسرُوا ولكن كلما","ظفروا بلحمِي مأكلاً جبروني",2,"ن",2,0],["ولخصمه فيها ولا","دة من بكفيه الطلاق",3,"ق",1,0],["وَلَخَيرٌ مِنَ السَلامَةِ عِندي","عِلَّةٌ لِلفَتى تُحِلُّ الحَراما",4,"م",2,0],["وَلَخافَ فَرسَتَهُ وَهَزَّتَنا بِهِ","وَشَباةَ مِخلَبِهِ الهِزَبرُ الضاري",5,"ر",2,0],["وَلَخَيرُ ما قَدَّمتَ سُنَّةُ صالِحٍ","لِلصالِحينَ فَعَلتَها وَسَنَنتَها",6,"ت",3,0],["وَلَخَيرُ قَولِ المَرءِ أَصدَقُهُ","وَلَخَيرُ فِعلِ المَرءِ أَنفَعُهُ",7,"ع",2,0],["وَلَخمٌ مُلوكُ الناسِ يُجبى إِلَيهِمُ","إِذا قالَ مِنهُم قائِلٌ فَهوَ واجِبُ",8,"ب",1,0],["وَلَخِفتُ في تَفريقِهِ ما بَينَنا","ما قيلَ في عَمرٍو وَفي الصَمصامِ",9,"م",1,0],["ولَخَيرُ عيشٍ أنتَ لابِسُهُ","عيشٌ جنى ثمراتِهِ الكِبَر",10,"ر",1,0],["ولخيرٌ للشاة: مِخلَبُ ذئبٍ","من شفار المُدَي، وشَيِّ النار",11,"ر",1,0],["ولَخيرٌ لصاغر لبسَ الذُّلَّ","رداءً: أن يَلبَسَ الأكفانا",12,"ن",2,0],["ولخير ما ظفرَت يداكَ به هوى","جمع الإله الأجر فيه والثنا",13,"ن",2,0],["ولخدّها لونُ السُّلافِ وفِعْلُها","ونَسيمُها لكنْ بغيرِ مِزاج",14,"ج",1,0],["وَلخيرِ الرسلِ الكرامِ أبي القا","سمِ صارَت أَموالُهم والنساءُ",15,"ا",2,0],["ولخط بخده غير مقرو","ء وبالخال معجم مسطوره",16,"ر",2,0],["ولخيرُ ما تعتاضه منا ثنا","يبقى وإن بقاءنا لفناء",17,"ا",2,0],["وَلخصمه يَرجو الجزا وَشهوده ال","اعضاء وَالملك المهيمن حاكمه",18,"م",2,0],["ولخير ما أهدى امرؤٌ لنبيه","أرجُ الصلاة مع السلام جسيما",19,"م",2,0],["وَلَخاضَت لجَجَ الحَربِ رِجالٌ","يَشرَبونَ المَوتَ كَالماءِ الزُلالِ",20,"ل",1,0],["وَلخيرِ مسؤولٍ بخيرِ وسيلةٍ","قُدِّمت فاِبشر بنجاح وأجدرِ",21,"ر",1,0],["وَلِخَوْفِها مِن ذا وَذا","كَ تَفِرُّ مِن أَيدِى الكِرامِ",22,"م",1,0],["وَلِخَدّ الراح مِن خَجَل","مِن لماه العَذب تَوريدُ",23,"د",1,0],["ولخَلَّفْتَ حين سِرْتَ ثناءً","ولأصبحْتَ كيف دُرْتَ حميدا",24,"د",2,0],["ولخَطبُ صِفِّينٍ أجلُّ وعندك ال","خبَرُ اليقينُ إذا سألتَ مُعاويا",25,"ي",2,0],["ولخفتُ غَيْرتَهن في تنفِيرها","والحزمُ ألَّا آمنَ الغَيرانا",26,"ن",2,0],["ولخُطَّةٍ خَسْفٍ عصبتُ بِعَارِها","رأسَ العلا وحططتُ من درجَاتِها",27,"ت",3,0],["ولخمرِ شِعري في العقولِ تسرُّعٌ","ما نالَ أيسرَ ما يَنالُ عقارُ",28,"ر",1,0],["ولخبثه ينسى عظائم فعله","ويآخذ الأمجاد بالكلمات",29,"ت",1,0],["ولخافقات نوائب","تهدي الحمام إلى الحمائم",30,"م",1,0],["ولَخَيْرٌ مِن أنْ تعيش غبيّاً","باخسَ الحَظِّ أن تموت كريما",31,"م",2,0],["وَلَخَيرٌ مِن لَونك اليقِقِ المُشْ","رِقِ عندي وعندهنّ الشُّحوبُ",32,"ب",1,0],["ولخوفٍ من بأْسِه حين يَسْطُو","أَصبحَ الطَّيشُ في صُدور الصِّعادِ",33,"د",1,0],["وَلِخَيلهم هام الفوارسِ أنفلوا","فإذا دُعوا لكريهةٍ لم يسألوا",34,"ل",3,0],["وَلخمس مِنهُ وَعشرين أَضحَت","مصر تَزهو بِذاتها اليوسفيهْ",35,"ي",2,0],["وَلخير زادِك من حياتك ما بهِ","تَنجو غداةَ إِقامة الأشهادِ",36,"د",1,0],["ولخلي وهبة المولى الأديبْ","كم تراني حامداً اشكرهُ",37,"ه",1,0],["ولخلت عنبر خالها من نورها","كحشاشتي في مارج من نار",38,"ر",1,0],["ولخّصتَ ما يوعى إليه عذوبةً","وضمَّنت في الألفاظ معنًى يُؤَوَّل",39,"ل",1,0],["ولخير خير يصم حديثه","سمع العدى ويفجر الجلمودا",40,"د",2,0],["ولخيفة العار الملمِّ تلفتت","نحو التنصر همة ابن الأيهم",41,"م",1,0],["ولخطة شنعاء لاحظها الهدى","دامي الجفوف فغض طرفاً أرمدا",42,"د",2,0],["وَلِخَلِّكَ الخَمرِيِّ عُذرٌ واضِحٌ","عِندي فَلَستُ أَلومُهُ في الجَفوَةِ",43,"ه",1,0],["ولخم ملوك الناس، يجبى إليهم","وإن قال منهم حاكم فهو واجب",44,"ب",1,0],["وَلخوف أَهليك القبائل تَنزوي","فَالزرق تَنب في الصُدور فَتلتوي",45,"ي",1,0],["وَلخوفي بان تراها عُيون الن","ناس عوذتها برب الناس",46,"س",1,0],["وَلِخُضرة الجَو إِخضِرار رِياضها","وَلِزَهره زَهر وَنور ينجم",47,"م",1,0],["ولخير لبنان جفونك لم تذق","طيب المنام وقد أُقض المضجع",48,"ع",1,0],["ولَخيرُ ما تعلو به أوطاننا","علمٌ تواليه الفتاة فيثمرُ",49,"ر",1,0],["ولَخير مدحٍ للملوك فِعالهم","لا الإفك يُخفيها ولا التضليلُ",50,"ل",1,0],["وَلَخَلَدوا فيهِ الثَناءَ وَخَلَدوا","لِبَقائِهِ فيهِ لِيَوم لِقاءِ",51,"ا",2,0],["ولخير من أن نعيش لئاماً","مستذلين إن نموت كراما",52,"م",2,0],["ولخالجت تلك الجوانح نشوة","فاهتز هيكلها الرميم ومادا",53,"د",2,0],["ولخدّها لون العقي","ق بدا على صفحات مرمر",54,"ر",1,0],["ولخصمه قد أعجزا","وأراه آيات العبر",55,"ر",1,0],["ولخاض دون سفائن","لدما نبي حربٍ مواخر",56,"ر",1,0],["ولخالها عيسى لمعجزها","فرقان أحمد ناسخ السفر",57,"ر",1,0],["وَلَخلتُ مِنهُ ذاكَ فائِدَةً","لكِن أَبى إِلَّا تحاملَهُ",58,"ل",2,0],["ولخدِّك عُذراً من حرفي","إن لم يُلْفِتْهُ تَوَرُّدُهُ",59,"د",2,0],["ولخير تعليم صحيح منتقى","من خطة الدين الجنيف النير",60,"ر",1,0],["وَلِخِبْرَةٍ شَرِبَتْ مَزَيِجَ عُصَارَتِي","خَلَجَاتُ قَلْبِ مَسِيِرَتِي بِرَسَائِلِي",61,"ل",2,0],["وَلَخَيْرُ ذُخْرٍ فِي الحَيَاةِ مَوَدَّةٌ","لِلْمُصطَفَى الْهَادِي الْعَظِيمِ الْمَنْهَجِ",62,"ج",1,0],["وَلَخَيْرَ مَا نَرْجوا مَوَدَّةَ أَحْمَدٍ","وَبَنيهِ صِفْوَتِهِ وَعِدْلِ كِتَابِهِ",63,"ب",2,0],["ولخوله اطلالٍ لها صحبه اوقوف","اصحاب طرفه بالوشم تنعي افراق",64,"ق",1,0],["ولخيرٌ منه أن أشربها","في سنا الصبح على صوت القماري",65,"ر",2,0],["ولِخَصْرٍ كان مِنْ دِقَّتِهِ","مثلَ بانٍ في يدي مَنْ عَسَفَهْ",66,"ف",2,0],["ولخالد العلياء من رسم الدنا","عزا متوجة به جلفارُ",67,"ر",1,0]]}