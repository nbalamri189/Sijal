{"poems":[[53,"أي العيون تجانب الأقذاء","https://www.aldiwan.net/poem30780.html","الكامل"],[72,"تحلو الثغور بذكرك المتردد","https://www.aldiwan.net/poem18546.html","الكامل"],[72,"جسمي أبو ذر الضنا فذروني","https://www.aldiwan.net/poem20182.html","الكامل"],[51,"فيم التنازع والشقاق","https://www.aldiwan.net/poem65714.html","مجزوء الكامل"],[45,"يا أخا الحارث بن كعب بن عمر","https://www.aldiwan.net/poem65660.html","الخفيف"],[28,"هتمت قريبة يا أخا الأنصار","https://www.aldiwan.net/poem5194.html","الكامل"],[49,"يا ساكن الدنيا لقد أوطنتها","https://www.aldiwan.net/poem62017.html","الكامل"],[49,"لا عيش إلا الموت يقطعه","https://www.aldiwan.net/poem62171.html","السريع"],[44,"ليت الظباء أبا العميثل خبرت","https://www.aldiwan.net/poem30345.html","الكامل"],[75,"صدق الفناء وكذب العمر","https://www.aldiwan.net/poem69076.html","أحذ الكامل"],[106,"الذئب","https://www.poetsgate.com/ViewPoem.aspx?id=179565",""],[106,"كرموه","https://www.poetsgate.com/ViewPoem.aspx?id=179708",""],[161,"كانت أحادا عند غيرك لا ثنا","https://www.aldiwan.net/poem58919.html","الكامل"],[186,"لمن الشموس غربن في الأحداج","https://www.aldiwan.net/poem14137.html","الكامل"],[190,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[243,"لي حشى ما بليت شب سعيره","https://www.aldiwan.net/poem1343.html",""],[262,"يا ابن السرى والليل والبيداء","https://www.aldiwan.net/poem38377.html","الكامل"],[272,"سجعت بأيمنذي الاراك حمائمه","https://www.aldiwan.net/poem52099.html","الكامل"],[282,"صلوا على خير البريةِ خيما","https://www.aldiwan.net/poem1386.html","الكامل"],[283,"عدم الإسلام معدوم المثال","https://www.aldiwan.net/poem32634.html","الرمل"],[306,"سيان أن لبس التجمل أو عري","https://www.aldiwan.net/poem56550.html","الكامل"],[349,"ماذا على شؤم الدرا","https://www.aldiwan.net/poem20722.html","مجزوء الكامل"],[354,"منهل العشاق مورود","https://www.aldiwan.net/poem40392.html","المديد"],[365,"قربا لي يا صاحبي بعيدا","https://www.aldiwan.net/poem60938.html","الخفيف"],[447,"لابنة حطان بن عوف منازل","https://www.aldiwan.net/poem23912.html","الطويل"],[459,"لو كنت دانيت المودة قاصيا","https://www.aldiwan.net/poem55811.html","الكامل"],[459,"دع بين جِلدي والعظام مكانا","https://www.aldiwan.net/poem55851.html","الكامل"],[459,"دعها تكن كالسلف من أخواتها","https://www.aldiwan.net/poem56263.html","البسيط"],[478,"ما الدمع بعد نوى الأحبة عار","https://www.aldiwan.net/poem15339.html","الكامل"],[501,"الخب ميال مع الشبهات","https://www.aldiwan.net/poem37714.html","الكامل"],[516,"إجر النسيم إلى السمائم","https://www.aldiwan.net/poem12266.html","مجزوء الكامل"],[552,"خلها إنها تريد الغميما","https://www.aldiwan.net/poem47231.html","الطويل"],[552,"شعر ناصع ووجه كئيب","https://www.aldiwan.net/poem48094.html","الخفيف"],[576,"سلام عليه لا على الدهر بعده","https://www.aldiwan.net/poem3075.html","الطويل"]],"verses":[["وَلَخَوضِ سَيفِكَ وَالفَوارِسُ تَدَّعي","حَرباً يَجُرُّ نِداؤُها الأَسماءَ",0,"ا",2,0],["ولخدك القاضي بمنع زكاته","عني وقد أثرت يداه بعسجد",1,"د",1,0],["ولخاطِري كسرُوا ولكن كلما","ظفروا بلحمِي مأكلاً جبروني",2,"ن",2,0],["ولخصمه فيها ولا","دة من بكفيه الطلاق",3,"ق",1,0],["وَلَخَيرٌ مِنَ السَلامَةِ عِندي","عِلَّةٌ لِلفَتى تُحِلُّ الحَراما",4,"م",2,0],["وَلَخافَ فَرسَتَهُ وَهَزَّتَنا بِهِ","وَشَباةَ مِخلَبِهِ الهِزَبرُ الضاري",5,"ر",2,0],["وَلَخَيرُ ما قَدَّمتَ سُنَّةُ صالِحٍ","لِلصالِحينَ فَعَلتَها وَسَنَنتَها",6,"ت",3,0],["وَلَخَيرُ قَولِ المَرءِ أَصدَقُهُ","وَلَخَيرُ فِعلِ المَرءِ أَنفَعُهُ",7,"ع",2,0],["وَلَخِفتُ في تَفريقِهِ ما بَينَنا","ما قيلَ في عَمرٍو وَفي الصَمصامِ",8,"م",1,0],["ولَخَيرُ عيشٍ أنتَ لابِسُهُ","عيشٌ جنى ثمراتِهِ الكِبَر",9,"ر",1,0],["ولخيرٌ للشاة: مِخلَبُ ذئبٍ","من شفار المُدَي، وشَيِّ النار",10,"ر",1,0],["ولَخيرٌ لصاغر لبسَ الذُّلَّ","رداءً: أن يَلبَسَ الأكفانا",11,"ن",2,0],["ولخير ما ظفرَت يداكَ به هوى","جمع الإله الأجر فيه والثنا",12,"ن",2,0],["ولخدّها لونُ السُّلافِ وفِعْلُها","ونَسيمُها لكنْ بغيرِ مِزاج",13,"ج",1,0],["وَلخيرِ الرسلِ الكرامِ أبي القا","سمِ صارَت أَموالُهم والنساءُ",14,"ا",2,0],["ولخط بخده غير مقرو","ء وبالخال معجم مسطوره",15,"ر",2,0],["ولخيرُ ما تعتاضه منا ثنا","يبقى وإن بقاءنا لفناء",16,"ا",2,0],["وَلخصمه يَرجو الجزا وَشهوده ال","اعضاء وَالملك المهيمن حاكمه",17,"م",2,0],["ولخير ما أهدى امرؤٌ لنبيه","أرجُ الصلاة مع السلام جسيما",18,"م",2,0],["وَلَخاضَت لجَجَ الحَربِ رِجالٌ","يَشرَبونَ المَوتَ كَالماءِ الزُلالِ",19,"ل",1,0],["وَلخيرِ مسؤولٍ بخيرِ وسيلةٍ","قُدِّمت فاِبشر بنجاح وأجدرِ",20,"ر",1,0],["وَلِخَوْفِها مِن ذا وَذا","كَ تَفِرُّ مِن أَيدِى الكِرامِ",21,"م",1,0],["وَلِخَدّ الراح مِن خَجَل","مِن لماه العَذب تَوريدُ",22,"د",1,0],["ولخَلَّفْتَ حين سِرْتَ ثناءً","ولأصبحْتَ كيف دُرْتَ حميدا",23,"د",2,0],["وَلَخمٌ مُلوكُ الناسِ يُجبى إِلَيهِمُ","إِذا قالَ مِنهُم قائِلٌ فَهوَ واجِبُ",24,"ب",1,0],["ولخَطبُ صِفِّينٍ أجلُّ وعندك ال","خبَرُ اليقينُ إذا سألتَ مُعاويا",25,"ي",2,0],["ولخفتُ غَيْرتَهن في تنفِيرها","والحزمُ ألَّا آمنَ الغَيرانا",26,"ن",2,0],["ولخُطَّةٍ خَسْفٍ عصبتُ بِعَارِها","رأسَ العلا وحططتُ من درجَاتِها",27,"ت",3,0],["ولخمرِ شِعري في العقولِ تسرُّعٌ","ما نالَ أيسرَ ما يَنالُ عقارُ",28,"ر",1,0],["ولخبثه ينسى عظائم فعله","ويآخذ الأمجاد بالكلمات",29,"ت",1,0],["ولخافقات نوائب","تهدي الحمام إلى الحمائم",30,"م",1,0],["ولَخَيْرٌ مِن أنْ تعيش غبيّاً","باخسَ الحَظِّ أن تموت كريما",31,"م",2,0],["وَلَخَيرٌ مِن لَونك اليقِقِ المُشْ","رِقِ عندي وعندهنّ الشُّحوبُ",32,"ب",1,0],["ولخوفٍ من بأْسِه حين يَسْطُو","أَصبحَ الطَّيشُ في صُدور الصِّعادِ",33,"د",1,0]]}