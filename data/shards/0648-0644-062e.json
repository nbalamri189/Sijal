{"poems":[[53,"أي العيون تجانب الأقذاء","https://www.aldiwan.net/poem30780.html","الكامل"],[72,"تحلو الثغور بذكرك المتردد","https://www.aldiwan.net/poem18546.html","الكامل"],[72,"جسمي أبو ذر الضنا فذروني","https://www.aldiwan.net/poem20182.html","الكامل"],[51,"فيم التنازع والشقاق","https://www.aldiwan.net/poem65714.html","مجزوء الكامل"],[45,"يا أخا الحارث بن كعب بن عمر","https://www.aldiwan.net/poem65660.html","الخفيف"],[28,"هتمت قريبة يا أخا الأنصار","https://www.aldiwan.net/poem5194.html","الكامل"],[49,"يا ساكن الدنيا لقد أوطنتها","https://www.aldiwan.net/poem62017.html","الكامل"],[49,"لا عيش إلا الموت يقطعه","https://www.aldiwan.net/poem62171.html","السريع"],[44,"ليت الظباء أبا العميثل خبرت","https://www.aldiwan.net/poem30345.html","الكامل"],[75,"صدق الفناء وكذب العمر","https://www.aldiwan.net/poem69076.html","أحذ الكامل"],[106,"الذئب","https://www.poetsgate.com/ViewPoem.aspx?id=179565",""],[106,"كرموه","https://www.poetsgate.com/ViewPoem.aspx?id=179708",""]],"verses":[["وَلَخَوضِ سَيفِكَ وَالفَوارِسُ تَدَّعي","حَرباً يَجُرُّ نِداؤُها الأَسماءَ",0,"ا",2,0],["ولخدك القاضي بمنع زكاته","عني وقد أثرت يداه بعسجد",1,"د",1,0],["ولخاطِري كسرُوا ولكن كلما","ظفروا بلحمِي مأكلاً جبروني",2,"ي",1,0],["ولخصمه فيها ولا","دة من بكفيه الطلاق",3,"ق",1,0],["وَلَخَيرٌ مِنَ السَلامَةِ عِندي","عِلَّةٌ لِلفَتى تُحِلُّ الحَراما",4,"م",2,0],["وَلَخافَ فَرسَتَهُ وَهَزَّتَنا بِهِ","وَشَباةَ مِخلَبِهِ الهِزَبرُ الضاري",5,"ر",2,0],["وَلَخَيرُ ما قَدَّمتَ سُنَّةُ صالِحٍ","لِلصالِحينَ فَعَلتَها وَسَنَنتَها",6,"ت",3,0],["وَلَخَيرُ قَولِ المَرءِ أَصدَقُهُ","وَلَخَيرُ فِعلِ المَرءِ أَنفَعُهُ",7,"ع",2,0],["وَلَخِفتُ في تَفريقِهِ ما بَينَنا","ما قيلَ في عَمرٍو وَفي الصَمصامِ",8,"م",1,0],["ولَخَيرُ عيشٍ أنتَ لابِسُهُ","عيشٌ جنى ثمراتِهِ الكِبَر",9,"ر",1,0],["ولخيرٌ للشاة: مِخلَبُ ذئبٍ","من شفار المُدَي، وشَيِّ النار",10,"ر",1,0],["ولَخيرٌ لصاغر لبسَ الذُّلَّ","رداءً: أن يَلبَسَ الأكفانا",11,"ن",2,0]]}