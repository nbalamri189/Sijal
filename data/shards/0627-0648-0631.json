{"poems":[[53,"أعاد لي عيد الضنى","https://www.aldiwan.net/poem29729.html","مجزوء الرجز"],[53,"ما عند عينك في الخيال الزائر","https://www.aldiwan.net/poem30448.html","الكامل"],[53,"مثواي إما صهوة أو غارب","https://www.aldiwan.net/poem30756.html","الكامل"],[63,"بشراك قد ظفر الراعي بما ارتادا","https://www.aldiwan.net/poem46210.html","البسيط"],[6,"ولو ان ما يأوي إليي","https://www.aldiwan.net/poem381.html",""],[3,"هل غادر الشعراء من متردم","https://www.aldiwan.net/poem85.html","الكامل"],[55,"ما تردون على هذا المحب","https://www.aldiwan.net/poem26475.html","الرمل"],[55,"أصبحت في هم وفي كرب","https://www.aldiwan.net/poem26541.html","السريع"],[55,"ما أنكأ البين لقرح القلوب","https://www.aldiwan.net/poem26542.html","السريع"],[77,"عجبا لوجد لا يلين شديده","https://www.aldiwan.net/poem36606.html","الكامل"],[86,"ثمن المجد والمحامد غالي","https://www.aldiwan.net/poem10352.html","الخفيف"],[86,"مسدي الجميل بلا من يكدره","https://www.aldiwan.net/poem10374.html","البسيط"],[30,"يا دار مية بالخلصاء غيرها","https://www.aldiwan.net/poem29593.html","البسيط"],[83,"أهدي أبا العباس","https://www.aldiwan.net/poem54278.html","مجزوء الكامل"],[83,"حياك يا دار الهوى من دار","https://www.aldiwan.net/poem54294.html","الكامل"],[88,"هي دنيا بقاؤها مستحيل","https://www.aldiwan.net/poem45050.html","الخفيف"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[37,"أو روايا التؤام في المهمه القفر","https://www.aldiwan.net/poem7062.html","الخفيف"],[37,"أورثته الحصان أم هشام","https://www.aldiwan.net/poem7072.html","الخفيف"],[47,"كأنما تساقط الثلج","https://www.aldiwan.net/poem25385.html","مجزوء الرجز"],[23,"سقتم كنانة جهلا من عداوتكم","https://www.aldiwan.net/poem21325.html","البسيط"],[72,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[72,"لله خال على خد الحبيب له","https://www.aldiwan.net/poem18447.html","البسيط"],[72,"ما البرق في كانونه قد قدح","https://www.aldiwan.net/poem18480.html","السريع"],[72,"يا شاهر اللحظ حبي فيك مشهور","https://www.aldiwan.net/poem18695.html","البسيط"],[72,"لله نظمك للطروس لقد","https://www.aldiwan.net/poem18973.html","أحذ الكامل"],[72,"محراب صدغيه يحث توجهي","https://www.aldiwan.net/poem20511.html","الكامل"],[72,"له إذا غازلتك عيناه","https://www.aldiwan.net/poem20512.html","المنسرح"],[51,"هل تعرف الدار بذي الأثأب","https://www.aldiwan.net/poem8512.html","السريع"],[51,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[51,"شجو قلبي من سائر الخلق شاجي","https://www.aldiwan.net/poem9250.html","الخفيف"],[51,"ازجر القلب إذا القلب جمح","https://www.aldiwan.net/poem9414.html","الرمل"],[51,"دار أمن وقرار","https://www.aldiwan.net/poem62849.html","مجزوء الرمل"],[51,"أنا صب مستهام","https://www.aldiwan.net/poem66023.html","مجزوء الرمل"],[29,"بانت سعاد ففي العينين ملمول","https://www.aldiwan.net/poem6024.html","البسيط"],[29,"طرق الكرى بالغانيات وربما","https://www.aldiwan.net/poem6174.html","الكامل"],[16,"وشامت بي لا تخفى عداوته","https://www.aldiwan.net/poem27687.html","البسيط"],[91,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[91,"هيهات بعدك ما يفيد تصبر","https://www.aldiwan.net/poem8822.html","عموديه"],[91,"بأبي خيال لاح لي متلففا","https://www.aldiwan.net/poem62779.html","عموديه"],[38,"بان الأحبة بالعهد الذي عهدوا","https://www.aldiwan.net/poem7699.html","البسيط"],[78,"أتتك أم الحسن","https://www.aldiwan.net/poem14285.html","مجزوء الرجز"],[85,"أهلا وسهلا بحاميها وفاديها","https://www.aldiwan.net/poem7586.html","البسيط"],[85,"أمن البحر صائغ عبقري","https://www.aldiwan.net/poem8086.html","الخفيف"],[85,"أيها العمال أفنوا العمر","https://www.aldiwan.net/poem63778.html","مجزوء الرمل"],[43,"أزائر يا خيال أم عائد","https://www.aldiwan.net/poem9559.html","المنسرح"],[43,"أحق عاف بدمعك الهمم","https://www.aldiwan.net/poem10537.html","المنسرح"],[45,"إليك ما أنا من لهو ولا طرب","https://www.aldiwan.net/poem10655.html","البسيط"],[45,"أصبحت في جهد وفي كرب","https://www.aldiwan.net/poem11485.html","السريع"],[45,"إن شعري سار في كل بلد","https://www.aldiwan.net/poem63530.html","البسيط"],[45,"لامت علي أنها في الدمع لم تلم","https://www.aldiwan.net/poem66653.html","البسيط"],[61,"ردي الخيال يجد معنى واجدا","https://www.aldiwan.net/poem51370.html","الكامل"],[49,"كل حي إلى الممات يصير","https://www.aldiwan.net/poem62086.html","الخفيف"],[66,"أترى البارق الذي لاح ليلا","https://www.aldiwan.net/poem40649.html","الخفيف"],[66,"جلت الظلماء بللهب","https://www.aldiwan.net/poem40672.html","المديد"],[66,"ما بين طيفك والجفون مواعد","https://www.aldiwan.net/poem41369.html","الكامل"],[80,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[44,"ما عهدنا كذا نحيب المشوق","https://www.aldiwan.net/poem30395.html","الخفيف"],[44,"دنف بكى آيات ربع مدنف","https://www.aldiwan.net/poem30401.html","الكامل"],[44,"أهلوك أضحوا شاخصا ومقوضا","https://www.aldiwan.net/poem30471.html","الكامل"],[31,"أخطأت أنت بدأت بالصرم","https://www.aldiwan.net/poem41327.html","الكامل"],[74,"حدر القناع عن الصباح المسفر","https://www.aldiwan.net/poem12956.html","الكامل"],[74,"أورى بأفقك بارق يتألق","https://www.aldiwan.net/poem13195.html","الكامل"],[105,"سرية أنت وحدك","https://www.aldiwan.net/poem43585.html","المجتث"],[81,"سقى الهوى فانتشى العميد","https://www.aldiwan.net/poem61401.html","مجزوء البسيط"],[81,"يوم تضاحك نوره الوضاء","https://www.aldiwan.net/poem61561.html","الكامل"],[102,"ضمها الطير مطبقا بجناحي","https://www.aldiwan.net/poem32972.html","الخفيف"],[52,"ألا من لقلب في الهوى غير منته","https://www.aldiwan.net/poem26587.html","الطويل"],[48,"وبلدة فيها زور","https://www.aldiwan.net/poem63368.html","مجزوء الرجز"],[48,"ما منك سلمى ولا أطلالها الدرس","https://www.aldiwan.net/poem64339.html","البسيط"],[48,"إن لي أيرا خبيثا","https://www.aldiwan.net/poem66216.html","مجزوء الرمل"],[50,"ظل اليسار على العباس ممدود","https://www.aldiwan.net/poem63880.html","البسيط"],[46,"لقد فنيت وهل تبقى إذا عمرت","https://www.aldiwan.net/poem23055.html","البسيط"],[46,"عش بخيلا كأهل عصرك هذا","https://www.aldiwan.net/poem23188.html","الخفيف"],[46,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[15,"أقفر من مية الدوافع من","https://www.aldiwan.net/poem45255.html","المنسرح"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85489","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85587","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85559","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85323","البسيط"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140856",""],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16673",""],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30451","الرمل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9850","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42608","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55071","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54855","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55017","الكامل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13598","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24207","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54261","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54270","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54254","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54264","الكامل"],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[84,"اصبيح شيم أم برق بدا","https://www.poetsgate.com/ViewPoem.aspx?id=26319",""],[47,"كأنما تساقطُ الثلجِ","https://www.poetsgate.com/ViewPoem.aspx?id=14641",""],[51,"لازلتَ تبلغُ أقصى السُؤْلِ والأملِ","https://www.poetsgate.com/ViewPoem.aspx?id=30336",""]],"verses":[["أَو رُمحِ مَحبوكِ القَرا","باتِ شَموعاً أَرِنا",0,"ن",2,0],["أَورَدنَني فَعَلِمتُ أَنَّ مَوارِدي","لَولا النُهى لَم أَدرِ أَينَ مَصادِري",1,"ر",2,0],["أَورَدنَهُ أَطرافَ كُلِّ فَضيلَةٍ","شِيَمٌ تُسانِدُها عُلىً وَمَناقِبُ",2,"ب",1,0],["أورَدْتُهُ العِيسَ والظَّلْماءُ وارِسَةٌ","يَحمِلْنَ مِن سَرَواتِ العُرْبِ أمجادا",3,"د",2,0],["أَو رَأسَ رَهوَةَ أَو رُؤو","سَ شَوامِخٍ لِهُدِدنَ هَدّا",4,"د",2,0],["أَو رَوضَةً أُنُفاً تَضَمَّنَ نَبتَه","غَيثٌ قَليلُ الدِمنِ لَيسَ بِمَعلَمِ",5,"م",1,0],["أَورِدوني مَنهَلاً أَروي بِهِ","ظَمَئي أَو عَلِّلوي بِالكَذِب",6,"ب",1,0],["أَورَثَني الحُبُّ جَوىً داخِلاً","أَستَنصِر اللَهُ عَلى الحُبِّ",7,"ب",1,0],["أَورَثَ قَلبي مِن جَوى حُبِّهِ","داءً عَياءً ما لَهُ مِن طَبيب",8,"ب",1,0],["أوْرَى بِجُنْحِ اللّيلِ في سِقْطِ اللِّوى","سِقْطاً ورَتْ خَلَلَ السَّحابِ زُنودُهُ",9,"د",2,0],["أَو رَأى قُوَّةَ العَزيمَةِ فيهِ","وَهوَ فَوقَ الفِراشِ بادي الهُزالِ",10,"ل",1,0],["أَورَثتَهُم شَمَماً هَشَّ الإِباءُ لَهُ","وَأَورَقَت في ذُراهُ عِزَّةُ الشانِ",11,"ن",1,0],["أَورَدتُهُ قَلِقاتِ الضُفرِ قَد جَعَلَت","تُبدي الأَخِشَّةُ في أَعناقِها صَعَرا",12,"ر",2,0],["أوراقها توريقها","بقضيبها الميّاسِ",13,"س",1,0],["أوردتنا فيها لجودك مورداً","مستعذبَ الإيراد والإِصدارِ",14,"ر",1,0],["أو رمى حدهّ الردى بفلول","فمعاليه ما بهنّ فلول",15,"ل",1,0],["أَو رَجعُ واشِمَةٍ أُسِفَّ نُؤورُها","كِفَفاً تَعَرَّضَ فَوقَهِنَّ وِشامُها",16,"م",3,0],["أو روايا التُؤام في المهمه القف","ر تناولن من سراة العويرا",17,"ر",2,1],["أورثته الحَصانُ أم هِشام","حسباً ثاقباً ووجهاً نضيرا",18,"ر",2,1],["أَوراقُ وَردٍ أَبيَضٍ","وَالناسُ في شاذِكُلى",19,"ل",2,0],["أَورَدتُموها حِياضَ المَوتِ ضاحِيَةً","فَالنارُ مَوعِدُها وَالقَتلُ لاقيها",20,"ي",3,0],["أوردت سؤددك الأعلى مواردَها","وللسها في بحارِ الأُفقِ عبَّات",21,"ت",1,0],["أورثته حبَّة القلب القتيل به","وكان عهديَ أنَّ الحالَ لا يرِث",22,"ث",1,0],["أورى نداك الذهن زنداً على","أنَّ امرأً في فضله ما قدح",23,"ح",1,0],["أو راكع الظهر شكراً في الظلام على","من فضله في السما والأرض مشكور",24,"ر",1,0],["أوراق حظ كلها ثمر","وبحور شعرٍ كلّها درر",25,"ر",1,0],["أوْرَوْا زناد معاجز ما مسَّها","قدح وظنُّوا كلّ دهر أدْرَهِ",26,"ه",1,0],["أورى برغمي نار الجفا عوضاً","عن بردٍ كنتُ لاثماً فاه",27,"ا",2,0],["أو رَفَعَ الصوتَ بشدوٍ لهُ","مثلَ سَقيطِ الدَمَق الأشهبِ",28,"ب",1,0],["أو رأى اللهوَ مُسْتَجِمٌّ حكيمٌ","ذو وقارٍ إذاً عراهُ اللُّغُوبُ",29,"ب",1,0],["أورث القلبَ سحرُ عينيه داءً","ماله غيرَ ريقِهِ من علاجِ",30,"ج",1,0],["أو رآها البدرُ في مَطْلَعِهِ","لاكْتَسَى ذُلّاً وهَوْناً وافْتَضَحْ",31,"ح",1,0],["أو رماة في طِرادٍ","خلف سربٍ أو صُوار",32,"ر",1,0],["أو رعيلٍ من حمير ال","وحش مشبوبِ الحِضار",32,"ر",1,0],["أورثتْ قلبي سقاماً","نظرة فيها سقامُ",33,"م",1,0],["أَورَدَها مَنهَلاً زُرقاً شَرائِعُهُ","وَقَد تَعَطَّشَتِ الجِحشانُ وَالحولُ",34,"ل",1,0],["أَو راحَ ذي نَطَفٍ يَظَلُّ مُتَوَّجاً","لِلشَربِ أَصهَبَ قالِصِ السِربالِ",35,"ل",1,0],["أَورَدتُها وَصُدورُ العيسِ مُسنَفَةٌ","وَالصُبحُ بِالكَوكَبِ الدُرِيِّ مَنحورُ",36,"ر",1,0],["أَوراءَ القَبرِ بَعدَ المَوتِ بَعث وَنُشورُ","فَحَياةٌ فَخُلودُ أَم فَناء وَدُثورُ",37,"ر",1,0],["أَورَدَتهُ عَذباً فَأَورَدَكَ الرَدى","تَبَّت يَداهُ فَذَنبُهُ لا يُغفَرُ",38,"ر",1,0],["أَوَرَدتُمُ كَمَناهِلي أَنَشَقتُمُ كَأَزا","هيري في الحُسنِ وَالتَلوينِ",39,"ن",1,0],["أَو رَعلَةٌ مِن قَطا فَيحانَ حَلَّأَها","عَن ماءِ يَثبَرَةَ الشُبّاكُ وَالرَصَدُ",40,"د",1,0],["أَوراقُها أَستارُها","إِذا شدت في فَنَنِ",41,"ن",1,0],["أوردتها الموت لم تبلغ بها شرفا","ولا توخيت بالأوطان تنويها",42,"ي",3,0],["أَو رَبيعٌ مِن ريشَةِ الفَنِّ أَبهى","مِن رَبيعِ الرُبى وَأَفتَنُ زَهرا",43,"ر",2,0],["أَو رَأى أُمِّيَّةً فَاِخ","تَلَب الجَهلَ اِختِلابا",44,"ب",2,0],["أَو رَعَتِ الوَحشُ وَهيَ تَذكُرُهُ","ما راعَها حابِلٌ وَلا طارِد",45,"د",1,0],["أَو رَكِبوا الخَيلَ غَيرَ مُسرَجَةٍ","فَإِنَّ أَفخاذَهُم نَها حُزُمُ",46,"م",1,0],["أَورَدتُ صادِيَةَ الآمالِ فَاِنصَرَفَت","بِرَيِّها وَأَخَذتُ النُجحَ مِن كَثَبِ",47,"ب",1,0],["أَورَثَني الحُبُّ جَوىً لازِماً","أَستَنصِرُ اللَهَ عَلى الحُبِّ",48,"ب",1,0],["أَو رُكوبي الفَرَسَ الموجَ الَّذي","كُلَّما رَكَّضَ بي قُلتُ أَجِدّ",49,"د",1,0],["أَورَثتَهُم نَدَماً عَن غِبِّ ما فَعَلوا","إِن كُنتَ أَبقَيتَ فيه