ئلا","https://www.aldiwan.net/poem12388.html","الرجز"],[435,"يوم قضى لك بالحبور","https://www.aldiwan.net/poem12395.html","مجزوء الكامل"],[435,"تيم قلبي أغيد","https://www.aldiwan.net/poem12484.html","مجزوء الرجز"],[435,"عرضت لمعترض الصباح الأبلج","https://www.aldiwan.net/poem12577.html","الكامل"],[435,"وأغن تسكره فتور جفونه","https://www.aldiwan.net/poem12630.html","الكامل"],[440,"لك ذروة المجد الذي لا يرتقى","https://www.aldiwan.net/poem2535.html","الكامل"],[440,"أما الفراق فإن موعده غد","https://www.aldiwan.net/poem2552.html","الكامل"],[440,"قد أعرب الدمع عن وجدي وكتماني","https://www.aldiwan.net/poem2565.html","البسيط"],[440,"قف إن شاني بهم أن يسفح الشان","https://www.aldiwan.net/poem2574.html","البسيط"],[440,"نصر من الله وافانا به الخبر","https://www.aldiwan.net/poem2611.html","البسيط"],[442,"أي شراع لأي بحر","https://www.aldiwan.net/poem34854.html","مخلع البسيط"],[442,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[442,"هل تثنين غروب دمع ساكب","https://www.aldiwan.net/poem34884.html","الكامل"],[444,"ألق العصي فهذا مقتضى الأرب","https://www.aldiwan.net/poem14330.html","البسيط"],[446,"أنا مثلما شئت وشاء دلالك","https://www.aldiwan.net/poem55972.html","عموديه"],[454,"أورى الهوى بحشاي زندا","https://www.aldiwan.net/poem13712.html","مجزوء الكامل"],[455,"غطست فيه حين بعثرت","https://www.aldiwan.net/poem61334.html","الخفيف"],[455,"سيدي الفارس المجلى أتأذن","https://www.aldiwan.net/poem61737.html","الخفيف"],[455,"قبل الأرض وناجاها هياما","https://www.aldiwan.net/poem61806.html","الرمل"],[460,"أين ظباء المنحنى","https://www.aldiwan.net/poem55827.html","مجزوء الرجز"],[460,"ردوا لها أيامها بالغميم","https://www.aldiwan.net/poem55888.html","السريع"],[460,"هل عند هذا الطلل الماحِلِ","https://www.aldiwan.net/poem55907.html","السريع"],[460,"لعلهم لو وقفوا","https://www.aldiwan.net/poem56108.html","مجزوء الرجز"],[460,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[463,"يا هازم القوم بآرائه","https://www.aldiwan.net/poem15460.html","السريع"],[463,"أرج النسيم فقلت نشر خميلة","https://www.aldiwan.net/poem16338.html","الكامل"],[467,"شدوا اليك نياط القلب والعصبا","https://www.aldiwan.net/poem54193.html","عموديه"],[470,"أورق جميلا يعيش المستطيل به","https://www.aldiwan.net/poem60167.html","البسيط"],[502,"أورد الدلو لعقد الكرب","https://www.aldiwan.net/poem38069.html","الرمل"],[516,"هذا العقيق وتلك شم رعانه","https://www.aldiwan.net/poem20784.html","الكامل"],[516,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"],[516,"ميلوا بنا نحو الحجون ونكبوا","https://www.aldiwan.net/poem20800.html","الكامل"],[516,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[532,"أوردها سعد وسعد مشتمل","https://www.aldiwan.net/poem2019.html","الرجز"],[540,"لله يومان تحكي غمض أجفان","https://www.aldiwan.net/poem47920.html","عموديه"],[540,"في شخص فاطمة نحيي النيلا","https://www.aldiwan.net/poem47971.html","عموديه"],[540,"هل أريك النجوم صارت بدورا","https://www.aldiwan.net/poem48187.html","عموديه"],[553,"ما كان يومك يا أبا إسحاق","https://www.aldiwan.net/poem47355.html","الكامل"],[553,"من رأى الأظعان فوق","https://www.aldiwan.net/poem47903.html","مجزوء الرمل"],[553,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[555,"قل لمن تاه إذ بنا عز جهلا","https://www.aldiwan.net/poem68326.html","الخفيف"],[566,"أزهر نجومٍ أم سعودية","https://www.aldiwan.net/poem847.html",""],[577,"أوردته قبلي على عطش","https://www.aldiwan.net/poem2939.html","أحذ الكامل"],[577,"أبى صدها أن يجمع الحسن والحسنى","https://www.aldiwan.net/poem3005.html","الطويل"],[577,"يا ليلة الوصل بل يا ليلة العمر","https://www.aldiwan.net/poem3063.html","البسيط"],[577,"صدوا فإنساني إليهم صدى","https://www.aldiwan.net/poem3087.html","السريع"],[588,"إن تبدوا أو تثنوا","https://www.aldiwan.net/poem17813.html","مجزوء الرمل"],[736,"","https://poetry.dctabudhabi.ae/diwan/poem/97760","الخفيف"],[860,"","https://poetry.dctabudhabi.ae/diwan/poem/17736","الكامل"],[1056,"","https://poetry.dctabudhabi.ae/diwan/poem/17486","البسيط"]],"verses":[["أَو رُمحِ مَحبوكِ القَرا","باتِ شَموعاً أَرِنا",0,"ن",2,0],["أَورَدنَني فَعَلِمتُ أَنَّ مَوارِدي","لَولا النُهى لَم أَدرِ أَينَ مَصادِري",1,"ر",2,0],["أَورَدنَهُ أَطرافَ كُلِّ فَضيلَةٍ","شِيَمٌ تُسانِدُها عُلىً وَمَناقِبُ",2,"ب",1,0],["أورَدْتُهُ العِيسَ والظَّلْماءُ وارِسَةٌ","يَحمِلْنَ مِن سَرَواتِ العُرْبِ أمجادا",3,"د",2,0],["أَو رَأسَ رَهوَةَ أَو رُؤو","سَ شَوامِخٍ لِهُدِدنَ هَدّا",4,"د",2,0],["أَو رَوضَةً أُنُفاً تَضَمَّنَ نَبتَه","غَيثٌ قَليلُ الدِمنِ لَيسَ بِمَعلَمِ",5,"م",1,0],["أَورِدوني مَنهَلاً أَروي بِهِ","ظَمَئي أَو عَلِّلوي بِالكَذِب",6,"ب",1,0],["أَورَثَني الحُبُّ جَوىً داخِلاً","أَستَنصِر اللَهُ عَلى الحُبِّ",7,"ب",1,0],["أَورَثَ قَلبي مِن جَوى حُبِّهِ","داءً عَياءً ما لَهُ مِن طَبيب",8,"ب",1,0],["أوْرَى بِجُنْحِ اللّيلِ في سِقْطِ اللِّوى","سِقْطاً ورَتْ خَلَلَ السَّحابِ زُنودُهُ",9,"د",2,0],["أَو رَأى قُوَّةَ العَزيمَةِ فيهِ","وَهوَ فَوقَ الفِراشِ بادي الهُزالِ",10,"ل",1,0],["أَورَثتَهُم شَمَماً هَشَّ الإِباءُ لَهُ","وَأَورَقَت في ذُراهُ عِزَّةُ الشانِ",11,"ن",1,0],["أَورَدتُهُ قَلِقاتِ الضُفرِ قَد جَعَلَت","تُبدي الأَخِشَّةُ في أَعناقِها صَعَرا",12,"ر",2,0],["أوراقها توريقها","بقضيبها الميّاسِ",13,"س",1,0],["أوردتنا فيها لجودك مورداً","مستعذبَ الإيراد والإِصدارِ",14,"ر",1,0],["أو رمى حدهّ الردى بفلول","فمعاليه ما بهنّ فلول",15,"ل",1,0],["أَو رَجعُ واشِمَةٍ أُسِفَّ نُؤورُها","كِفَفاً تَعَرَّضَ فَوقَهِنَّ وِشامُها",16,"م",3,0],["أو روايا التُؤام في المهمه القف","ر تناولن من سراة العويرا",17,"ر",2,1],["أورثته الحَصانُ أم هِشام","حسباً ثاقباً ووجهاً نضيرا",18,"ر",2,1],["أَوراقُ وَردٍ أَبيَضٍ","وَالناسُ في شاذِكُلى",19,"ل",2,0],["أَورَدتُموها حِياضَ المَوتِ ضاحِيَةً","فَالنارُ مَوعِدُها وَالقَتلُ لاقيها",20,"ي",3,0],["أوردت سؤددك الأعلى مواردَها","وللسها في بحارِ الأُفقِ عبَّات",21,"ت",1,0],["أورثته حبَّة القلب القتيل به","وكان عهديَ أنَّ الحالَ لا يرِث",22,"ث",1,0],["أورى نداك الذهن زنداً على","أنَّ امرأً في فضله ما قدح",23,"ح",1,0],["أو راكع الظهر شكراً في الظلام على","من فضله في السما والأرض مشكور",24,"ر",1,0],["أوراق حظ كلها ثمر","وبحور شعرٍ كلّها درر",25,"ر",1,0],["أوْرَوْا زناد معاجز ما مسَّها","قدح وظنُّوا كلّ دهر أدْرَهِ",26,"ه",1,0],["أورى برغمي نار الجفا عوضاً","عن بردٍ كنتُ لاثماً فاه",27,"ا",2,0],["أو رَفَعَ الصوتَ بشدوٍ لهُ","مثلَ سَقيطِ الدَمَق الأشهبِ",28,"ب",1,0],["أو رأى اللهوَ مُسْتَجِمٌّ حكيمٌ","ذو وقارٍ إذاً عراهُ اللُّغُوبُ",29,"ب",1,0],["أورث القلبَ سحرُ عينيه داءً","ماله غيرَ ريقِهِ من علاجِ",30,"ج",1,0],["أو رآها البدرُ في مَطْلَعِهِ","لاكْتَسَى ذُلّاً وهَوْناً وافْتَضَحْ",31,"ح",1,0],["أو رماة في طِرادٍ","خلف سربٍ أو صُوار",32,"ر",1,0],["أو رعيلٍ من حمير ال","وحش مشبوبِ الحِضار",32,"ر",1,0],["أورثتْ قلبي سقاماً","نظرة فيها سقامُ",33,"م",1,0],["أَورَدَها مَنهَلاً زُرقاً شَرائِعُهُ","وَقَد تَعَطَّشَتِ الجِحشانُ وَالحولُ",34,"ل",1,0],["أَو راحَ ذي نَطَفٍ يَظَلُّ مُتَوَّجاً","لِلشَربِ أَصهَبَ قالِصِ السِربالِ",35,"ل",1,0],["أَورَدتُها وَصُدورُ العيسِ مُسنَفَةٌ","وَالصُبحُ بِالكَوكَبِ الدُرِيِّ مَنحورُ",36,"ر",1,0],["أَوراءَ القَبرِ بَعدَ المَوتِ بَعث وَنُشورُ","فَحَياةٌ فَخُلودُ أَم فَناء وَدُثورُ",37,"ر",1,0],["أَورَدَتهُ عَذباً فَأَورَدَكَ الرَدى","تَبَّت يَداهُ فَذَنبُهُ لا يُغفَرُ",38,"ر",1,0],["أَوَرَدتُمُ كَمَناهِلي أَنَشَقتُمُ كَأَزا","هيري في الحُسنِ وَالتَلوينِ",39,"ن",1,0],["أَو رَعلَةٌ مِن قَطا فَيحانَ حَلَّأَها","عَن ماءِ يَثبَرَةَ الشُبّاكُ وَالرَصَدُ",40,"د",1,0],["أَوراقُها أَستارُها","إِذا شدت في فَنَنِ",41,"ن",1,0],["أوردتها الموت لم تبلغ بها شرفا","ولا توخيت بالأوطان تنويها",42,"ي",3,0],["أَو رَبيعٌ مِن ريشَةِ الفَنِّ أَبهى","مِن رَبيعِ الرُبى وَأَفتَنُ زَهرا",43,"ر",2,0],["أَو رَأى أُمِّيَّةً فَاِخ","تَلَب الجَهلَ اِختِلابا",44,"ب",2,0],["أَو رَعَتِ الوَحشُ وَهيَ تَذكُرُهُ","ما راعَها حابِلٌ وَلا طارِد",45,"د",1,0],["أَو رَكِبوا الخَيلَ غَيرَ مُسرَجَةٍ","فَإِنَّ أَفخاذَهُم نَها حُزُمُ",46,"م",1,0],["أَورَدتُ صادِيَةَ الآمالِ فَاِنصَرَفَت","بِرَيِّها وَأَخَذتُ النُجحَ مِن كَثَبِ",47,"ب",1,0],["أَورَثَني الحُبُّ جَوىً لازِماً","أَستَنصِرُ اللَهَ عَلى الحُبِّ",48,"ب",1,0],["أَو رُكوبي الفَرَسَ الموجَ الَّذي","كُلَّما رَكَّضَ بي قُلتُ أَجِدّ",49,"د",1,0],["أَورَثتَهُم نَدَماً عَن غِبِّ ما فَعَلوا","إِن كُنتَ أَبقَيتَ فيهِم مَوضِعَ النَدَمِ",50,"م",1,0],["أو راحلا يحدو رواحل جوده","أو قاصدا يزجي إليك قصائدا",51,"د",2,0],["أَورَدَتنا الدُنيا وَما أَصدَرَتنا","إِنَّ هَذا مِن فِعلِها لَغُرورُ",52,"ر",1,0],["أورِدُ العيسَ نَهرَ عيسى وَطَوراً","أورِدُ الخَيلَ دِجلَةً وَدُجَيلا",53,"ل",2,0],["أَو رِماحاً في العِدى طُعِنَت","فَغَدَت مُحمَرَّةَ العَذَبِ",54,"ب",1,0],["أورِثتَ مَجدَ سَراةِ أُرتُقَ إِذ خَلَت","وَبَنيتَهُ فَهُوَ الطَريفُ التالِدُ",55,"د",1,0],["أو رماهمْ إقدامُهُم بكلومٍ","قَطَرَتْ منهم على الأقدامِ",56,"م",1,0],["أَورَثَت صاغِرى صَغاراً وَرَغماً","وَقَضَت أَو قَضى قُبَيلَ الشُروقِ",57,"ق",1,0],["أَورَيتَ زَندَي رَأفَةٍ وَتَأَلُّقٍ","فَتَقَصَّدا بِالنازِعِ المُتَعَسِّفِ",58,"ف",1,0],["أَورَدتَني العِدَّ الخَسيفَ وَقَد أُرى","أَتَبَرَّضُ الثَمدَ البَكِيَّ تَبَرُّضا",59,"ض",2,0],["أَورَثتِني داءً أُخامِرُهُ","أَسماءُ بَزَّ اللَحمَ عَن عَظمي",60,"م",2,0],["أَورَدتُهُ نُطَفَ الأَسِنَّةِ أَشهَباً","وَنَزَلتُ مِنهُ ظافِراً عَن أَشقَرِ",61,"ر",1,0],["أَورى بِأُفقِكَ بارِقٌ يَتَأَلَّقُ","وَسَقى دِيارَكَ وابِلٌ يَتَدَفَّقُ",62,"ق",1,1],["أَوردتَهُ القَولَ حُلواً","ولو دَرَى عَافَ وِرْدَكْ",63,"ك",1,0],["أَو رِقَّةَ في أَديمِ خَدِّه","سَرَت إِلى قَلبِهِ فَرَقّ",64,"ق",1,0],["أَورَقنَ أَو أَشرَقنَ حَتّى إِنَّهُ","تَجري الصِلادُ وَتُقبَسُ الظَلماءُ",65,"ا",2,0],["أَوردتها قَلباً إِذا رَفَّ يَوماً","خافِقاً لِلهَوى فَذاكَ هَواها",66,"ا",3,0],["أُوَرِّثُ نَفسي مالَها قَبلَ وارِثي","وَأُنفِقُهُ فيما تُحِبُّ وَتَشتَهي",67,"ي",1,0],["أَو رَهِبوا الأَمرَ جَسَر","ثُمَّ تَسامى فَفَغَر",68,"ر",1,0],["أَو رُحتَ مِثلَ حُوَيٍّ في مَكارِمِهِ","هَيهاتَ مِنكَ حُوَيٌّ حينَ يُلتَمَسُ",69,"س",1,0],["أو رأى في السّقفِ دِبراً","يتحوّل عنكبوتا",70,"ت",2,0],["أو رآه جوفُ بحرٍ","صارَ للأنعاظِ حوتاً",70,"ت",2,0],["أَورِق بِخَيرٍ تُرَجّى لِلنَوالِ فَما","تُرجى الثِمارُ إِذا لَم يورِقِ العودُ",71,"د",1,0],["أَورَقتُ عَصراً فَإِن أَورَقتُ في طَلَبٍ","فَإِنَّ إيراقَ كَفّي هاجَ إيراقي",72,"ق",2,0],["أَورَدوكَ الأَذى لِتَغرَقَ فيهِ","وَأَروكَ الخَنى لِتَعرِفَ سُبُلَه",73,"ل",2,0],["أو رَمَتْها قَوْس الكواكبِ زال العَج","سُ منها وخانَها الأبْهَرانِ",74,"ن",1,0],["أَورَدَها شَربَةً بِلينَةَ لَم","تُحمِض عَلَيها مِن دونِها رِجَلُ",75,"ل",1,0],["أَو رقصة طابَ منها","للمنصتين السماع",76,"ع",1,0],["أَوراقه في عين عش","شاق الهدى بيض كواعب",77,"ب",1,0],["أو روح هوجو وبشا","ر قد ألمَّا لأمر",78,"ر",1,0],["أَوردتها حججاً كالشمس ساطعة","والمنكرون بغير السب ما دحضوا",79,"ض",3,0],["أَورَثَني السأم من حَياتي","تعاقب اللَيل وَالنَهار",80,"ر",1,0],["أو ركبوا الخيل غير مسرجةٍ","فإن أفخاذهم لها حزم",81,"م",1,0],["أو راكِباً وَجْنَاءَ تَشْ","كُو بالفَلاةِ كَلالَها",82,"ل",3,0],["أَوْرَدتهُ لُطُفا آيتُهُ","صفْوةَ العيْشِ وأَرْعتْهُ ددا",83,"د",2,0],["أَو رَوضَةً أُنُفاً تَضَمَّنَ نَبتَها","غَيثٌ قَليلُ الدِمنِ لَيسَ بِمَعلَمِ",84,"م",1,0],["أَوْرَدْتَنِي بلِحاظِ عَيْنِكَ مَوْرِداً","لِلْحُبِّ مَا لِلْقَلْبِ عَنْهُ مَصْدَرُ",85,"ر",1,0],["أَوْرَثْتَ أُسْرَتَكَ الوَفِيَّةَ حَسْرَةً","رَاعَتْ بِقُسْوَتِهَا وَأَنْتَ رَفِيقُ",86,"ق",1,0],["أَوْرَدْتَهُ مِنْ نِيلِهِ مَاءً صَفَا","لِلوَارِدِينَ وَطَابَ طِيْبَ الكَوْثَرِ",87,"ر",1,0],["أَوْرَدَ الفَضْل كُلَّ صَادٍ وَخَ","صَّ الجزْل مِنُه بِالعِلمِ وَالعُلَمَاءِ",88,"ا",2,0],["أَوْ رُوِميُو وَهْوَ الدَّمُ المَهْدُورُ فِي","ثارٍ تخَلَّفَ عَنْ قَدِيمِ نِزَاعِ",89,"ع",1,0],["أَورِق أَمينَ اللَهِ عودي إِنَّما","أَغراسُ أَصلِكَ في العُلى أَغراسي",90,"س",2,0],["أو راحَ إلى أُمنيتِهِ","ظمآن فحَوْضُكَ يُورِدُهُ",91,"د",2,0],["أو رقع المدح الذي قلته","وهي استه الواهية الريق",92,"ق",1,0],["أوْ رَأَيتُم رَوْضَ الْقَريضِ هَشِيماً","بعْدَ مَا قَصَّف الرَّدَى ريحانَه",93,"ن",2,0],["أوْ رَأيتَ الْقَدَّ في هَيَفٍ","فاتَّخِذْ ما شِئْتَ مِنْ جُنَن",94,"ن",1,0],["أو روضُ حَزْنٍ أعار المِسْكَ نفحتَه","إذا بكَى الغَيثُ في أنحائِه ابتسما",95,"م",2,0],["أو رَغْوةٌ من سُلافٍ","تفيضُ من رأس دَنّ",96,"ن",1,0],["أو رام نِسْيانَ الهموم فها هنا","تُنْسَى الهمومُ وتذهَبُ الآلام",97,"م",1,0],["أو رأسِ إنسان يطير","كأنه كرة الوليد",98,"د",1,0],["أو رمى عابر إلّي التفاتا","واختفى في لحاق بج