تَنَا مِنْ بَعْدِ مَا أَوْجَدْتَنَا","بَحْراً غَلَتْ أَصْدَافُهُ وَفُصُوصُهُ",131,"ص",2,0],["أورِدكَ أَقلِبَةً إِذا حافَلتَها","خَوضَ القَعودِ خَبيئَةَ الأَخصامِ",132,"م",1,0],["اوردتهن دموعي من لظي نفسي","فأبن من حُرق فوضي إلى غرق",133,"ق",1,0],["أَورّى بذكر الركب وَهو مشرق","وأَبكي فَيَبكيني الفَريق المغرب",134,"ب",1,0],["أَوردني الحوض الَّذي أَوصافه","من دونها لبن وشهد أَبيض",135,"ض",1,0],["أوْرَثتَني دَنَفاً أقَامَ لِرِحْلَةٍ","أزْمَعْتَها فَكأَنّهُ لِيَ عَائِد",136,"د",1,0],["أَورَدَ الراياتِ صُفراً طَعنُهُ","وَبِهِ أُصدِرنَ في الهَيجاءِ دُكنا",137,"ن",2,0],["أَورَدت أَطرافَ الرِماحِ صُدورَهُم","فَوَلَغنَ في عَلَقِ النَجيعِ الأَحمَرِ",138,"ر",1,0],["أَوردتُه ليُحتَذى","إذا عرا الخلَّ أَذى",139,"ذ",2,0],["أَورَت عليه من الصَبابة وقدها","حتّى إِذا ما جرَّعته صدَّها",140,"ه",2,0],["أَو رمتَ تنسبُ يوماً سيِّداً لعُلاً","فاِنسب إِلى مُنتَهاها سادَة النَجفِ",141,"ف",1,0],["أَوردتُها حين جاءَت تَشتَكي ظمأ","منّي مَناهلَ ودٍّ عذبة خَصِرَه",142,"ر",2,0],["أوردتها السلم في حبي فغرَّرها","بالحرب غيريَ حتى ضرَّجتْ بدم",143,"م",1,0],["أَورى وأَرّثَ جمرةً","بين الجوانِح ليس تهدا",144,"د",2,0],["أَوروا بزندِ الإجتهاد لكشفها","ناراً وشبّوها على كثبانِ",145,"ن",1,0],["أَورَت لسبعِ المُنشآت بها لنا","بحرَ القريضِ وَإنّهنّ لأبحرُ",146,"ر",1,0],["أَورى لِيروي كلّ صادٍ ودقهُ","جوداً ويثلجُ غلّةً وأوارا",147,"ر",2,0],["أَورت يَمينك عَزمي بعد ما صلدا","وَقرطس القصد سَهمي إثرما صردا",148,"د",2,1],["أَورى الجوانح ثمّ أَظلَمها أسى","عَميت به سبل الأسى المنهوجه",149,"ج",2,0],["أوريت زند العزم في طلبي","وقضيت حق المجد من قصدي",150,"د",2,0],["أَو رُمتَ فَضلَ جَميلٍ مِن مَعودِهِ","وَلا التَمَسَت غِنى الدارَينِ مِن يَدِهِ",151,"ه",1,0],["أَو رَعى صُحبَةَ الجُسومِ الَّتي اِستَ","صحَبَ مِنها الأَسماعَ وَالأَبصارا",152,"ر",2,0],["أَورَدَهُ العَدلُ بِسوءِ ظَنِّهِ","مِنَ الرَدى ما صَدَّهُ عَنِ الصَدَر",153,"ر",1,0],["أَو رَقص الغُصن بِأَيدي الصبا","حَيث غَدَت تَهصر مِنهُ القوام",154,"م",1,0],["أَو رَأَينا الثَناء يجزي مكافاه","لَم نملّك سِواه مِنهُ عِقالا",155,"ل",2,0],["أَوردتنا الوَرد وَجنته","