n.net/poem12395.html","مجزوء الكامل"],[433,"تيم قلبي أغيد","https://www.aldiwan.net/poem12484.html","مجزوء الرجز"],[433,"عرضت لمعترض الصباح الأبلج","https://www.aldiwan.net/poem12577.html","الكامل"],[433,"وأغن تسكره فتور جفونه","https://www.aldiwan.net/poem12630.html","الكامل"],[438,"لك ذروة المجد الذي لا يرتقى","https://www.aldiwan.net/poem2535.html","الكامل"],[438,"أما الفراق فإن موعده غد","https://www.aldiwan.net/poem2552.html","الكامل"],[438,"قد أعرب الدمع عن وجدي وكتماني","https://www.aldiwan.net/poem2565.html","البسيط"],[438,"قف إن شاني بهم أن يسفح الشان","https://www.aldiwan.net/poem2574.html","البسيط"],[438,"نصر من الله وافانا به الخبر","https://www.aldiwan.net/poem2611.html","البسيط"],[440,"أي شراع لأي بحر","https://www.aldiwan.net/poem34854.html","مخلع البسيط"],[440,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[440,"هل تثنين غروب دمع ساكب","https://www.aldiwan.net/poem34884.html","الكامل"],[442,"ألق العصي فهذا مقتضى الأرب","https://www.aldiwan.net/poem14330.html","البسيط"],[444,"أنا مثلما شئت وشاء دلالك","https://www.aldiwan.net/poem55972.html","عموديه"],[453,"أورى الهوى بحشاي زندا","https://www.aldiwan.net/poem13712.html","مجزوء الكامل"],[454,"غطست فيه حين بعثرت","https://www.aldiwan.net/poem61334.html","الخفيف"],[454,"سيدي الفارس المجلى أتأذن","https://www.aldiwan.net/poem61737.html","الخفيف"],[454,"قبل الأرض وناجاها هياما","https://www.aldiwan.net/poem61806.html","الرمل"],[459,"أين ظباء المنحنى","https://www.aldiwan.net/poem55827.html","مجزوء الرجز"],[459,"ردوا لها أيامها بالغميم","https://www.aldiwan.net/poem55888.html","السريع"],[459,"هل عند هذا الطلل الماحِلِ","https://www.aldiwan.net/poem55907.html","السريع"],[459,"لعلهم لو وقفوا","https://www.aldiwan.net/poem56108.html","مجزوء الرجز"],[459,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[462,"يا هازم القوم بآرائه","https://www.aldiwan.net/poem15460.html","السريع"],[462,"أرج النسيم فقلت نشر خميلة","https://www.aldiwan.net/poem16338.html","الكامل"],[466,"شدوا اليك نياط القلب والعصبا","https://www.aldiwan.net/poem54193.html","عموديه"],[469,"أورق جميلا يعيش المستطيل به","https://www.aldiwan.net/poem60167.html","البسيط"],[501,"أورد الدلو لعقد الكرب","https://www.aldiwan.net/poem38069.html","الرمل"],[515,"هذا العقيق وتلك شم رعانه","https://www.aldiwan.net/poem20784.html","الكامل"],[515,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"],[515,"ميلوا بنا نحو الحجون ونكبوا","https://www.aldiwan.net/poem20800.html","الكامل"],[515,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[531,"أوردها سعد وسعد مشتمل","https://www.aldiwan.net/poem2019.html","الرجز"],[539,"لله يومان تحكي غمض أجفان","https://www.aldiwan.net/poem47920.html","عموديه"],[539,"في شخص فاطمة نحيي النيلا","https://www.aldiwan.net/poem47971.html","عموديه"],[539,"هل أريك النجوم صارت بدورا","https://www.aldiwan.net/poem48187.html","عموديه"],[552,"ما كان يومك يا أبا إسحاق","https://www.aldiwan.net/poem47355.html","الكامل"],[552,"من رأى الأظعان فوق","https://www.aldiwan.net/poem47903.html","مجزوء الرمل"],[552,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[554,"قل لمن تاه إذ بنا عز جهلا","https://www.aldiwan.net/poem68326.html","الخفيف"],[565,"أزهر نجومٍ أم سعودية","https://www.aldiwan.net/poem847.html",""],[576,"أوردته قبلي على عطش","https://www.aldiwan.net/poem2939.html","أحذ الكامل"],[576,"أبى صدها أن يجمع الحسن والحسنى","https://www.aldiwan.net/poem3005.html","الطويل"],[576,"يا ليلة الوصل بل يا ليلة العمر","https://www.aldiwan.net/poem3063.html","البسيط"],[576,"صدوا فإنساني إليهم صدى","https://www.aldiwan.net/poem3087.html","السريع"],[587,"إن تبدوا أو تثنوا","https://www.aldiwan.net/poem17813.html","مجزوء الرمل"]],"verses":[["أَو رُمحِ مَحبوكِ القَرا","باتِ شَموعاً أَرِنا",0,"ن",2,0],["أَورَدنَني فَعَلِمتُ أَنَّ مَوارِدي","لَولا النُهى لَم أَدرِ أَينَ مَصادِري",1,"ر",2,0],["أَورَدنَهُ أَطرافَ كُلِّ فَضيلَةٍ","شِيَمٌ تُسانِدُها عُلىً وَمَناقِبُ",2,"ب",1,0],["أورَدْتُهُ العِيسَ والظَّلْماءُ وارِسَةٌ","يَحمِلْنَ مِن سَرَواتِ العُرْبِ أمجادا",3,"د",2,0],["أَو رَأسَ رَهوَةَ أَو رُؤو","سَ شَوامِخٍ لِهُدِدنَ هَدّا",4,"د",2,0],["أَو رَوضَةً أُنُفاً تَضَمَّنَ نَبتَه","غَيثٌ قَليلُ الدِمنِ لَيسَ بِمَعلَمِ",5,"م",1,0],["أَورِدوني مَنهَلاً أَروي بِهِ","ظَمَئي أَو عَلِّلوي بِالكَذِب",6,"ب",1,0],["أَورَثَني الحُبُّ جَوىً داخِلاً","أَستَنصِر اللَهُ عَلى الحُبِّ",7,"ب",1,0],["أَورَثَ قَلبي مِن جَوى حُبِّهِ","داءً عَياءً ما لَهُ مِن طَبيب",8,"ب",1,0],["أوْرَى بِجُنْحِ اللّيلِ في سِقْطِ اللِّوى","سِقْطاً ورَتْ خَلَلَ السَّحابِ زُنودُهُ",9,"د",2,0],["أَو رَأى قُوَّةَ العَزيمَةِ فيهِ","وَهوَ فَوقَ الفِراشِ بادي الهُزالِ",10,"ل",1,0],["أَورَثتَهُم شَمَماً هَشَّ الإِباءُ لَهُ","وَأَورَقَت في ذُراهُ عِزَّةُ الشانِ",11,"ن",1,0],["أَورَدتُهُ قَلِقاتِ الضُفرِ قَد جَعَلَت","تُبدي الأَخِشَّةُ في أَعناقِها صَعَرا",12,"ر",2,0],["أوراقها توريقها","بقضيبها الميّاسِ",13,"س",1,0],["أوردتنا فيها لجودك مورداً","مستعذبَ الإيراد والإِصدارِ",14,"ر",1,0],["أو رمى حدهّ الردى بفلول","فمعاليه ما بهنّ فلول",15,"ل",1,0],["أَو رَجعُ واشِمَةٍ أُسِفَّ نُؤورُها","كِفَفاً تَعَرَّضَ فَوقَهِنَّ وِشامُها",16,"م",3,0],["أو روايا التُؤام في المهمه القف","ر تناولن من سراة العويرا",17,"ر",2,1],["أورثته الحَصانُ أم هِشام","حسباً ثاقباً ووجهاً نضيرا",18,"ر",2,1],["أَوراقُ وَردٍ أَبيَضٍ","وَالناسُ في شاذِكُلى",19,"ل",2,0],["أَورَدتُموها حِياضَ المَوتِ ضاحِيَةً","فَالنارُ مَوعِدُها وَالقَتلُ لاقيها",20,"ي",3,0],["أوردت سؤددك الأعلى مواردَها","وللسها في بحارِ الأُفقِ عبَّات",21,"ت",1,0],["أورثته حبَّة القلب القتيل به","وكان عهديَ أنَّ الحالَ لا يرِث",22,"ث",1,0],["أورى نداك الذهن زنداً على","أنَّ امرأً في فضله ما قدح",23,"ح",1,0],["أو راكع الظهر شكراً في الظلام على","من فضله في السما والأرض مشكور",24,"ر",1,0],["أوراق حظ كلها ثمر","وبحور شعرٍ كلّها درر",25,"ر",1,0],["أوْرَوْا زناد معاجز ما مسَّها","قدح وظنُّوا كلّ دهر أدْرَهِ",26,"ه",1,0],["أورى برغمي نار الجفا عوضاً","عن بردٍ كنتُ لاثماً فاه",27,"ا",2,0],["أو رَفَعَ الصوتَ بشدوٍ لهُ","مثلَ سَقيطِ الدَمَق الأشهبِ",28,"ب",1,0],["أو رأى اللهوَ مُسْتَجِمٌّ حكيمٌ","ذو وقارٍ إذاً عراهُ اللُّغُوبُ",29,"ب",1,0],["أورث القلبَ سحرُ عينيه داءً","ماله غيرَ ريقِهِ من علاجِ",30,"ج",1,0],["أو رآها البدرُ في مَطْلَعِهِ","لاكْتَسَى ذُلّاً وهَوْناً وافْتَضَحْ",31,"ح",1,0],["أو رماة في طِرادٍ","خلف سربٍ أو صُوار",32,"ر",1,0],["أو رعيلٍ من حمير ال","وحش مشبوبِ الحِضار",32,"ر",1,0],["أورثتْ قلبي سقاماً","نظرة فيها سقامُ",33,"م",1,0],["أَورَدَها مَنهَلاً زُرقاً شَرائِعُهُ","وَقَد تَعَطَّشَتِ الجِحشانُ وَالحولُ",34,"ل",1,0],["أَو راحَ ذي نَطَفٍ يَظَلُّ مُتَوَّجاً","لِلشَربِ أَصهَبَ قالِصِ السِربالِ",35,"ل",1,0],["أَورَدتُها وَصُدورُ العيسِ مُسنَفَةٌ","وَالصُبحُ بِالكَوكَبِ الدُرِيِّ مَنحورُ",36,"ر",1,0],["أَوراءَ القَبرِ بَعدَ المَوتِ بَعث وَنُشورُ","فَحَياةٌ فَخُلودُ أَم فَناء وَدُثورُ",37,"ر",1,0],["أَورَدَتهُ عَذباً فَأَورَدَكَ الرَدى","تَبَّت يَداهُ فَذَنبُهُ لا يُغفَرُ",38,"ر",1,0],["أَوَرَدتُمُ كَمَناهِلي أَنَشَقتُمُ كَأَزا","هيري في الحُسنِ وَالتَلوينِ",39,"ن",1,0],["أَو رَعلَةٌ مِن قَطا فَيحانَ حَلَّأَها","عَن ماءِ يَثبَرَةَ الشُبّاكُ وَالرَصَدُ",40,"د",1,0],["أَوراقُها أَستارُها","إِذا شدت في فَنَنِ",41,"ن",1,0],["أوردتها الموت لم تبلغ بها شرفا","ولا توخيت بالأوطان تنويها",42,"ي",3,0],["أَو رَبيعٌ مِن ريشَةِ الفَنِّ أَبهى","مِن رَبيعِ الرُبى وَأَفتَنُ زَهرا",43,"ر",2,0],["أَو رَأى أُمِّيَّةً فَاِخ","تَلَب الجَهلَ اِختِلابا",44,"ب",2,0],["أَو رَعَتِ الوَحشُ وَهيَ تَذكُرُهُ","ما راعَها حابِلٌ وَلا طارِد",45,"د",1,0],["أَو رَكِبوا الخَيلَ غَيرَ مُسرَجَةٍ","فَإِنَّ أَفخاذَهُم نَها حُزُمُ",46,"م",1,0],["أَورَدتُ صادِيَةَ الآمالِ فَاِنصَرَفَت","بِرَيِّها وَأَخَذتُ النُجحَ مِن كَثَبِ",47,"ب",1,0],["أَورَثَني الحُبُّ جَوىً لازِماً","أَستَنصِرُ اللَهَ عَلى الحُبِّ",48,"ب",1,0],["أَو رُكوبي الفَرَسَ الموجَ الَّذي","كُلَّما رَكَّضَ بي قُلتُ أَجِدّ",49,"د",1,0],["أَورَثتَهُم نَدَماً عَن غِبِّ ما فَعَلوا","إِن كُنتَ أَبقَيتَ فيهِم مَوضِعَ النَدَمِ",50,"م",1,0],["أو راحلا يحدو رواحل جوده","أو قاصدا يزجي إليك قصائدا",51,"د",2,0],["أَورَدَتنا الدُنيا وَما أَصدَرَتنا","إِنَّ هَذا مِن فِعلِها لَغُرورُ",52,"ر",1,0],["أورِدُ العيسَ 