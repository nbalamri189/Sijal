"أوردت أنفسهم حوض الردى فغدا","ورودهُم بارتواء ماله صدر",183,"ر",1,0],["أَو روضَةٌ في الهواءِ حُفَّتْ","من طِيبِ أخلاقه بزَهْرِ",184,"ر",1,0],["أَورَدتها المِصرَ والأَبصارُ طامِحةٌ","لِصنعِ مَا لَكَ ربُّ العرشِ صانِعُهُ",185,"ع",2,0],["أَوْ رُمْتُ حظِّي فِي السماء وَقَدْ جرى","لمداهُ فِي فَلَكِ الفضاءِ الغائِبِ",186,"ب",1,0],["أوردتهن قلوصاً طال ما مرحت","شوقاً إليك ولكن بالنوى طلحت",187,"ت",1,0],["أو رمت أن أدو فاطوع عابد","أو شئت هجرا قلت جل جلالك",188,"ك",1,0],["أورى الهوى بحشاي زندا","وحسبت فيه الغيَّ رشدا",189,"د",2,1],["أو رذاذا من الحبور تراءى","قطرات فصار معنى تجسم",190,"م",1,0],["أو رأينا التحَّرر الذهبي","لعبيدٍ تأبونَ للفكرِ رَبَّا",191,"ب",2,0],["أو رجعت اليوم عبدا صاغرا","أتلقَّى عنك علما واحتكاما",192,"م",2,0],["أو ركِبوا إلى الصفو","ف يحملون الإحَنا",193,"ن",2,0],["أو ركبوا الخيل إلى مأزق","تبدّلوا الهام بفُوس الشكيم",194,"م",1,0],["أو ركِبوا جرياً إلى معشرٍ","تبادروا بالقدَرِ النازلِ",195,"ل",1,0],["أورق لو أزفَّ لي","ذاك القضيب المخطَفُ",196,"ف",1,0],["أو ركبوا البغيَ إلى غارةٍ","طعنتَ حتى قيل لم يَكتُبِ",197,"ب",1,0],["أوردتها النَّصْرَ بلا معْركٍ","والعِزَّةَ القَعساءَ قبل الصِّياحْ",198,"ح",1,0],["أو رُفْقةٍ يَمَنيَّةٍ عَدنيَّةٍ","فَضُّوا عِيابَهُمُ بليْلٍ شامِلِ",199,"ل",1,0],["أورَيْتَ أنتَ زِنادي فاحتَرَقتُ بِهِ","عشرينَ عاماً صَبوراً، شامِخاً ،شَحِبا",200,"ب",2,0],["أَورِق جَميلاً يَعيشَ المُستَطيلُ بِهِ","فَهَكَذا غَرسٍ عودُهُ عودُ",201,"د",1,1],["أَورِدِ الدَّلوَ لعَقْدِ الكَرَبِ","واحْكِ لي أَخبارَ قوم العَرَبِ",202,"ب",1,1],["أو رامَ منْ أفُقِ المجرّةِ مَسْلكاً","لجَرَتْ بحَلْبَتهِ خُيولُ رِهانهِ",203,"ن",2,0],["أورّي عنْ هواهُ بحبِّ ليلى","وفيه تغزُّلي وبهِ اِشتغالي",204,"ل",2,0],["أورَدْتَ فيه السيفَ وهْو حديدةٌ","وصدرْتَ وهْو من النّجيع مذهّبُ",205,"ب",1,0],["أوراقُهُ تُشْجي ورَجْعُ قيانِهِ","أشْجى وأوقَعُ في النّفوسِ وأوهَجُ",206,"ج",1,0],["أَورَدَها سَعدٌ وَسَعدٌ مُشتَمِل","ما هَكَذا تورَدُ يا سَعدُ الإِبِل",207,"ل",1,1],["اُوريكةَ بِجَنابِ القائدِ ابتَهِجى","بِه فَإِفتَخِري عَن كُلِّ بُلدانِ",208,"ن",1,0],["أو راهبٌ في ديرِهِ مُتَعَبِّدٌ","يَروي به التَّوارةَ والإنجيلا",209,"ل",2,0],["أو رئيساً أو قائداً لجُيوشٍ","أو مُقيماً أو حاكماً أو سفيرا",210,"ر",2,0],["أو راكبٌ في القفر دَفَّيْ جَسْرَةٍ","غَرْثي بلا شَثٍّ ولا طُبّاقِ",211,"ق",1,0],["أو رِئالٍ راتِكاتٍ","ليس فيهنّ طَليحُ",212,"ح",1,0],["أَو رَكِبوا الهولَ قالَ قائِلهم","أَكرمُنا مَن حياتَه وَهبا",213,"ب",2,0],["أَو رَجا أَن يَفوتَ قَوماً بِوَترٍ","لَم تَزَل تَمتَطيهُمُ الأَوتارُ",214,"ر",1,0],["أوربية إن قيدت أبدت الرضى","وان أطلقت للشر في طيها نشر",215,"ر",1,0],["أَوردته قُبَلي على عَطَشٍ","مِنْهَا ولَمْ أَعْزِم على الصَّدَر",216,"ر",1,1],["أُوَرِّي بنَجْدٍ والصبابةُ بالحِمَى","وأَكْنِي بسُعْدي واللُّبَانَةُ في لُبْنى",217,"ن",2,0],["أوردتُ صدري وِرْداً من مُعانقةٍ","وحينَ أَوردتُ لم أَعْزِم عَلَى الصَّدَرِ",218,"ر",1,0],["أَوْ ردَّ نَفْساً لي ولم يَرْضَها","فالشَّرع قد جَاءَ برَدِّ الرَّدِي",219,"د",2,0],["أو رَنوْا ظَبْيَ كِناسٍ","أو سَطوْا لَيْثَ عَرينِ",220,"ن",1,0]]}