20",""],[5136,"أسموط در فصلت بالعسجد","https://www.poetsgate.com/ViewPoem.aspx?id=121799",""],[5183,"روض الاخاء","https://www.poetsgate.com/ViewPoem.aspx?id=180204",""],[5183,"تخميس","https://www.poetsgate.com/ViewPoem.aspx?id=185994",""],[5183,"الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=186490",""],[5183,"بين القبر والمنبر","https://www.poetsgate.com/ViewPoem.aspx?id=180164",""],[5186,"يا طيب ليل بالأنس مرا","https://www.poetsgate.com/ViewPoem.aspx?id=156570",""],[5186,"ورد الربيع شذا من ربع غسان","https://www.poetsgate.com/ViewPoem.aspx?id=156440",""],[5187,"نغم عذري","https://www.poetsgate.com/ViewPoem.aspx?id=33002",""],[5198,"عطر العطور","https://www.poetsgate.com/ViewPoem.aspx?id=139712",""],[5198,"الصعاليك","https://www.poetsgate.com/ViewPoem.aspx?id=143702",""],[5206,"مناهج الله","https://www.poetsgate.com/ViewPoem.aspx?id=187391",""],[5277,"الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=186873",""],[5277,"حكايةٌ عتيقة","https://www.poetsgate.com/ViewPoem.aspx?id=199270",""],[5320,"حى راق","https://www.poetsgate.com/ViewPoem.aspx?id=43263",""],[5335,"اكحل عينها","https://www.poetsgate.com/ViewPoem.aspx?id=36041",""],[5356,"كيفَ لا أشتاقُ","https://www.poetsgate.com/ViewPoem.aspx?id=212097",""],[5365,"الوصيّة","https://www.poetsgate.com/ViewPoem.aspx?id=190421",""],[5376,"دَهُرْتَ أمْ بَلَغَتْ روحٌ تراقيها","https://www.poetsgate.com/ViewPoem.aspx?id=197734",""],[5397,"لا تسألن معالم الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=157918",""],[5431,"لن تضيع الأصول عند الحصاد","https://www.poetsgate.com/ViewPoem.aspx?id=196628",""],[5442,"عز قرب الدار إلا في الكرا","https://www.poetsgate.com/ViewPoem.aspx?id=114789",""],[5530,"ترتيلةٌ على حدّ المُحال","https://www.poetsgate.com/ViewPoem.aspx?id=197855",""],[5605,"ملحمة المسيلة","https://www.poetsgate.com/ViewPoem.aspx?id=160024",""],[5616,"كلمات","https://www.poetsgate.com/ViewPoem.aspx?id=203238",""],[5628,"لحن الانتظار","https://www.poetsgate.com/ViewPoem.aspx?id=178524",""],[5628,"الشوق والمستحيل","https://www.poetsgate.com/ViewPoem.aspx?id=178554",""],[5815,"رفراف","https://www.poetsgate.com/ViewPoem.aspx?id=190767",""],[5853,"بيادق الروح","https://www.poetsgate.com/ViewPoem.aspx?id=188365",""],[5908,"هل لقلب المتيم المتبول","https://www.poetsgate.com/ViewPoem.aspx?id=170976",""],[5956,"رقابة المطبوعات","https://www.poetsgate.com/ViewPoem.aspx?id=185617",""],[5957,"سكت الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=182458",""],[5975,"عيناكِ .. أم نجم الصباحِ !!","https://www.poetsgate.com/ViewPoem.aspx?id=53291",""],[6031,"يا غَادِياتِ السُّحْبِ لا تتَجاوزِي","https://www.poetsgate.com/ViewPoem.aspx?id=46319",""],[6031,"عُجْ بالمَطِيِّ علَى مَعَالمِ بُورِي","https://www.poetsgate.com/ViewPoem.aspx?id=46320",""],[6034,"خطب ألم فسار في الآفاق","https://www.poetsgate.com/ViewPoem.aspx?id=169608",""],[3304,"حواء أم جنية البحر","https://www.poetsgate.com/ViewPoem.aspx?id=135617",""],[6093,"كلُّ العيونِ إلى قوامك ترمقُ","https://www.poetsgate.com/ViewPoem.aspx?id=205775",""],[6331,"الشكوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82021&r=&rc=2",""]],"verses":[["روْضٌ تأرّجَ عرْفُهُ وترنّمَتْ","أطْيارُهُ وتهدّلَتْ أشْجارُهُ",0,"ر",2,0],["رَوْضٌ منَ العِلْمِ هَمَى فوْقَهُ","منْ صَيِّبِ الفِكْرِ الغَمامُ السَّفوحْ",1,"ح",1,0],["روض المنايا قضبها السمر التي","من فوقها الرايات كالأزهار",2,"ر",1,0],["روض حسن غنى لنا فوقهُ الحل","يُ فأهلاً بالرَّوضةِ الغناء",3,"ا",2,0],["روضٌ يزفّ ومعشوقٌ وكأس طلا","لقد ظفرت بعيشٍ غير ذي عوَز",4,"ز",1,0],["روضة نرد كم هزار بها","نغمته في الطاس مسموعه",5,"ع",2,0],["روضةُ الليلِ عاطرُ النَّشر فيه","حين تعتلُّ نكهةُ المِتفالِ",6,"ل",1,0],["رَوضٌ إِذا زُرتَهُ كَئيبا","نَفَّسَ عَن قَلبِكَ الكُروبا",7,"ب",2,1],["رَوضٌ جَنَيتُ الفَضلَ مِنهُ يانِعاً","وَهَجَرتُهُ حَتّى عَلاهُ ذُبولُ",8,"ل",1,0],["رَوضَةٌ ذاتُ حَنوَةٍ وَخُزامى","جادَ فيها الرَبيعُ مِن سَبَلِه",9,"ل",2,0],["رَوضَتي اِزَّيَّنَت وَأَبدَت حُلاها","حينَ قالوا رِكابُكُم في الطَريقِ",10,"ق",1,0],["رُوِّضَت بَعدَ جِماحٍ وَجَرَت","طَوعَ سُلطانَينِ عِلمٌ وَذَكاء",11,"ا",2,0],["روضٌ تُزَخرِفُه العقولُ ورَوضةٌ","باتَت تُزَخرِفُها الغُيوثُ هَواطِلا",12,"ل",2,0],["روضةٌ تعبقُ نشراً ما لها","غُمِسَتْ في ماءِ وردٍ وَمَلاب",13,"ب",1,0],["روضُ المحاسنِ خدُّهُ","مِنْ حقِّهِ يُسقى ويُرعى",14,"ع",2,0],["روضوا المَطالِبِ بِالرَوِيَّةِ وَاِعلَموا","أَنَّ السَكينَةَ أَنجَحُ الأَسبابِ",15,"ب",1,0],["رَوضٌ حُرِمتُ ثِمارَهُ وَقَصائِدي","مِن وُرقِهِ وَالآسُ نَبتُ عِذارِهِ",16,"ر",2,0],["رَوضاً تَغَنَّت مِن ثَنائِكَ وَسطَهُ","وُرقٌ جَعَلنَ غُصونَهُنَّ الأَسطُرا",17,"ر",2,0],["رَوضنا مِن رِياضكم فينان","وَثَرانا مِن نيلكُم رَيانُ",18,"ن",1,1],["روضتُكِ الغنّاءُ يا وردتي","قد أَنبتتْ من كل زوْجٍ بهيجْ",19,"ج",1,0],["رَوضَةٌ مِن قَرقَفٍ أَنهارُها","وَغِناءُ الوَرقِ فيها في اِرتِفاعِ",20,"ع",1,1],["رَوضاً جَديداً وَنَهَر","وَهُنَّ يَسأَلنَ النَظَر",21,"ر",1,0],["رَوْضُ المَنايا على أنّ الدّماءَ به","وإنْ تَخَالَفْنَ أبْدالٌ من الزّهرِ",22,"ر",1,0],["رَوضَ القَطا مِن جَنوبِ السِدرِ مِن خِيَمِ","فَالمُحتَبي فَأَجازوا الدَوَّ أَو هَبَطوا",23,"ط",3,0],["روض وَبستانُ","ورد وَريحانُ",24,"ن",1,1],["رُوضُوا النُّفُوسَ عَلَى الحِسَا","بِ فَلاَ نَجَاحَ بِلاَ حِسَابِ",25,"ب",1,0],["رَوْضَةٌ زُرْتهَا وَفِيَّ جَوىً","كاللَّظَى فِي الْهَشِيمِ أَوْ أَمْشَى",26,"ش",2,0],["روض من اللذات، طيبة","أثماره، خلو من الرصد",27,"د",1,0],["رَوضٌ شَفى ناظِري بِناضِره","عَطَّلَهُ الدَهرُ حينَ حَلّاهُ",28,"ا",2,0],["رَوضَةٌ غُيِّرَ مِن أَزهارِها","كُلُّ قانٍ وَغَضيضٍ وَيقَق",29,"ق",1,0],["روضةٌ من محاسنٍ غالها الإعْ","صارُ حتى غَدَتْ خمائلَ جُرْدَا",30,"د",2,0],["رَوْضَةٌ قد لَقَّبُوها كَلِماً","تُخْجِلُ الْحُسْنَ إِذا الْحُسْنُ رَآها",31,"ا",3,0],["روض العلى بأكوان","شقائِقاً وحوذان",32,"ن",1,0],["روضة البحتريِّ منبتُ ريشي","وبها قد نَشأتُ، واشتدَّ عودي",33,"د",2,0],["روَّضت نفسي على السؤال، وما","حَمَلْتُ ذلَّ السؤال من أحد",34,"د",1,0],["رُوضِّت كُّفه فلولا رجامُ","الناس اقرى بها الطيور وعسا",35,"س",2,0],["رَوض الوُجودِ بِكُمُ زاهر","يَشهدهُ الغائب وَالحاضرُ",36,"ر",1,1],["روض قد لألأ عسجده","وامال الزهر زبرجده",37,"د",2,1],["روضةٌ من سُفْليها جناتٌ","من نخيلٍ أفكارُنا تَرْعامَا",38,"ا",3,0],["رَوضٌ عَلى الأَفواهِ يَعسُرُ رَعيُهُ","لَكِنَّ لِلأَبصارِ فيهِ مَرتَعُ",39,"ع",1,0],["رَوضٌ سَقَت سُحُبُ العِرفانِ مَنبَتَهُ","بِكُل وَدَق هتونِ الدُرِّ مُنبَجِسِ",40,"س",1,0],["روضٌ كمُخْضرِّ العِذار وجَدْول","نَقَشت عليه يدُ النسيم مَباردا",41,"د",2,0],["روضٌ له أَرَجٌ يَسْرى الثناء به","فيَخْجل الوردُ والنَّسْرين والآس",42,"س",1,0],["روضةُ العينِ لَذّةُ العقلِ والحس","نِ جِلاءُ القلوبِ والأجسام",43,"م",1,0],["روضالندى ينبت زهر الندى","وهذه تنبت زهر القلوب",44,"ب",1,0],["رَوضاً يَرُوضُ هُمُومَ قَلبي حُسنُهُ","فيهِ لِكَأسِ اللَهوِ أيُّ مَساغِ",45,"غ",1,0],["رَوضَةٌ ظاهَرَ الرَبيعُ ثَراها","بِسُيولٍ وَزانها النُوّارُ",46,"ر",1,0],["روضةٌ باكرتها في فتيةٍ","خصّصوا للهوِ ما قد خصّصوا",47,"ص",3,1],["روضُ المحاسنِ نزهةُ الأبصارِ","والعيشُ تحت معاقِدِ الأزرارِ",48,"ر",1,1],["روضة من ياسمينٍ","حول أصلَي جلَّنارِ",49,"ر",1,0],["روضة العلم ومن منهاجه","مطلب الروض به قد اينعا",50,"ع",2,0],["روضة حسن في ربيع بدت","ترفع من ابياتها في جنان",51,"ن",1,0],["روض بدا بل سحاب جود","قد عمنا وابلا وطلا",52,"ل",2,0],["روضة العلم جامع الفضل حلو","ذو بيان محرر كشاف",53,"ف",1,0],["روض يسمّى نَفُوساً زان منبتَه","بفضلهِ اللهُ أحْيَاهُ ومنتِهِ",54,"ت",2,0],["روضة الذكر بها نشأتنا","حيث ربّى الربُّ فيها غرسنا",55,"ن",2,0],["رَوضَةُ الذِكرِ أَينَعتُ بِغُصونٍ","مِن قُلوبٍ قَد جادَها غَيثُ مُزنِك",56,"ك",1,0],["روضة الجنة في أَوطانهم","وَثَرى آثارهم يبرى الجذاما",57,"م",2,0],["رَوضُ الرَبيعِ مُفَوَّفٌ وَمُدَبَّجُ","هَل كانَ في صَنعاءَ قِدماً يُنسَجُ",58,"ج",1,1],["رَوضٌ بِه تأوي النهى للوارفِ ال","مسكون حولَ المشرع الملزونِ",59,"ن",1,0],["رَوضٌ مِنَ الآدابِ أزهارهُ","تَحسنُ لِلناظر والناشقِ",60,"ق",1,0],["رَوضَة المَجد وَالمَفاخِر أَنتُم","وَعَلَيكُم طير المَكارِمِ غَرّد",61,"د",1,0],["رَوضَة راضِا النَسيم محيرا","بِاِعتِلال صحت بِهِ وَاِعتَلاء",62,"ا",2,0],["روضُ الهوى مرتعٌ وخيم","في القلب من رعيه كلوم",63,"م",1,1],["روضتي كنت بها أسمع لحن","وأرى الزهرة فيها والغزالا",64,"ل",2,0],["روضةٌ أزهارُها ضاحكةٌ","والشَّذا في لا بَتَيها سطعَا",65,"ع",2,0],["روضٌ محاسنُ أَرضِه كسما