{"poems":[[53,"ألا خبر عن جانب الغور وارد","https://www.aldiwan.net/poem29768.html","الطويل"],[53,"أما ذعرت بنا بقر الخدور","https://www.aldiwan.net/poem30468.html","الوافر"],[30,"خليلي عوجا اليوم حتى تسلما","https://www.aldiwan.net/poem29528.html","الطويل"],[30,"أتعرف أطلالا بوهبين والحضر","https://www.aldiwan.net/poem29583.html","الطويل"],[27,"أهوى أراك برامتين وقودا","https://www.aldiwan.net/poem5732.html","الكامل"],[27,"بان الخليط غداة الجناب","https://www.aldiwan.net/poem5783.html","المتقارب"],[47,"أبت عبراته إلا انسكابا","https://www.aldiwan.net/poem25381.html","الوافر"],[51,"لي صاحب قد كنت آمل نفعه","https://www.aldiwan.net/poem8496.html","الكامل"],[51,"يا ذا الذي كنيته كنيتي","https://www.aldiwan.net/poem64998.html","السريع"],[51,"ما القلب في إثرهم بمختطف","https://www.aldiwan.net/poem65441.html","المنسرح"],[51,"أبا حسنٍ حمدي متى ما بغيته","https://www.aldiwan.net/poem65959.html","البسيط"],[51,"ولقد يؤلفنا اللقاء بليلة","https://www.aldiwan.net/poem66032.html","الكامل"],[91,"تلك المازل كيف حال مقيمها","https://www.aldiwan.net/poem62713.html","عموديه"],[70,"عتب الحبيب ولم أجد","https://www.aldiwan.net/poem42985.html","مجزوء الكامل"],[38,"أمن آل وسنى آخر الليل زائر","https://www.aldiwan.net/poem7713.html","الطويل"],[92,"أتفنى ابتسامات تلك الجفون","https://www.aldiwan.net/poem38959.html","المتقارب"],[43,"ملامي النوى في ظلمها غاية الظلم","https://www.aldiwan.net/poem10536.html","الطويل"],[45,"تظن شجوني لم تعتلج","https://www.aldiwan.net/poem62675.html","المتقارب"],[45,"ونكثر أن نستودع الله ظاعنا","https://www.aldiwan.net/poem64682.html","الطويل"],[45,"ضاعف من بثي وأحزاني","https://www.aldiwan.net/poem66820.html","السريع"],[28,"إنا لننصف منا بعد مقدرة","https://www.aldiwan.net/poem5334.html","البسيط"],[80,"ودجنة كالنقس صب على الثرى","https://www.aldiwan.net/poem31573.html","الكامل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"بني الآمال قد وضح اليقين","https://www.aldiwan.net/poem43095.html","الوافر"],[105,"يقول دعاة الشر ليت محمدا","https://www.aldiwan.net/poem44020.html","الطويل"],[102,"يا أيها البلد الكئيب","https://www.aldiwan.net/poem33097.html","مجزوء الكامل"],[48,"نك ابن العم ذا القربى","https://www.aldiwan.net/poem66212.html","الهزج"],[48,"ولا تبكين على ناسك","https://www.aldiwan.net/poem66616.html","المتقارب"],[46,"يرومك والجوزاء دون مرامه","https://www.aldiwan.net/poem23642.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54851","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[106,"قالوا أحيل","https://www.poetsgate.com/ViewPoem.aspx?id=179396",""],[90,"بديعة","https://www.poetsgate.com/ViewPoem.aspx?id=179133",""],[91,"تلك المنازل","https://www.poetsgate.com/ViewPoem.aspx?id=53242",""],[51,"ولقد يُؤلفُنا اللقاءُ بليلة","https://www.poetsgate.com/ViewPoem.aspx?id=30372",""],[128,"حي المعاليم والرسوما","https://www.aldiwan.net/poem50515.html","مجزوء الكامل"],[132,"أدينك أن تذمى الخيزرانا","https://www.aldiwan.net/poem54721.html","الوافر"],[132,"أجدك أن بينهم أن آنا","https://www.aldiwan.net/poem54722.html","الوافر"],[143,"ليهنك ما أنالتك الجدود","https://www.aldiwan.net/poem11748.html","الوافر"],[143,"قفوا في القلى حيث انتهيتم تذمما","https://www.aldiwan.net/poem11819.html","الطويل"],[144,"بك ذا الجلال أدعو فارحمني وقل","https://www.aldiwan.net/poem4457.html","الكامل"],[150,"أهلا بغرتك السعيده","https://www.aldiwan.net/poem68462.html","مجزوء الكامل"],[150,"يهن الجزيرة منك أي حسام","https://www.aldiwan.net/poem68464.html","الكامل"],[155,"رب نجوم في زمان أورق","https://www.aldiwan.net/poem55604.html","الرجز"],[160,"حكم مضى وقضاء لا نغالبه","https://www.aldiwan.net/poem58710.html","الطويل"],[160,"أزلت عن الإسلام ما أوجب الشكوى","https://www.aldiwan.net/poem59202.html","الطويل"],[189,"رأى مدح خير الخلق صعبا فأحجما","https://www.aldiwan.net/poem35105.html","الرمل"],[195,"طال الكرى وألم الهم فاكتنعا","https://www.aldiwan.net/poem54402.html","البسيط"],[223,"ألا تبصر الأغصان بللها القطر","https://www.aldiwan.net/poem41891.html","الطويل"],[237,"صلاة السميع العليم","https://www.aldiwan.net/poem19788.html","المتقارب"],[261,"عدوك مقتول بسيء فعله","https://www.aldiwan.net/poem38146.html","الطويل"],[270,"شربناها على ذكر الوليد","https://www.aldiwan.net/poem35590.html","الوافر"],[270,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[271,"أنسمة طيب أم صبا طيبة هبا","https://www.aldiwan.net/poem52104.html","الطويل"],[304,"ليس دين الله بالحبل","https://www.aldiwan.net/poem16852.html","المديد"],[328,"فلسطين يا كعبة العالمين","https://www.aldiwan.net/poem54916.html","المتقارب"],[328,"اشغليني بما تريدين مني","https://www.aldiwan.net/poem54939.html","الخفيف"],[377,"أذوب إذا رأيت يسوع يوما","https://www.aldiwan.net/poem59292.html","الطويل"],[377,"اليوم يخفق كل نجم مرجف","https://www.aldiwan.net/poem59331.html","الكامل"],[391,"سلام على أهل الظنون الجميلة","https://www.aldiwan.net/poem54605.html","عموديه"],[416,"على مثله تجري الدموع السواجم","https://www.aldiwan.net/poem54054.html","الطويل"],[437,"أبى الدهر إلا أن تلم نوازله","https://www.aldiwan.net/poem2576.html","الطويل"],[437,"عدتنا عواد من تناء ومن هجر","https://www.aldiwan.net/poem2588.html","الطويل"],[439,"أقدمت دون معالم الإسلام","https://www.aldiwan.net/poem34781.html","الكامل"],[441,"هذي المنازل ها هيه","https://www.aldiwan.net/poem14399.html","مجزوء الكامل"],[453,"يا من يوكل للأجانب ملكه","https://www.aldiwan.net/poem61598.html","البسيط"],[458,"أعينوني على طلب المعالي","https://www.aldiwan.net/poem56066.html","الوافر"],[458,"هل بعد مفترق الأظعان مجتمع","https://www.aldiwan.net/poem56135.html","البسيط"],[464,"عزاء فمن ودعته ليس يرجع","https://www.aldiwan.net/poem3395.html","عموديه"],[465,"قدمت وعفوك عن مقدمي","https://www.aldiwan.net/poem59035.html","عموديه"],[468,"تشتت شمل الصبر واتصل الضد","https://www.aldiwan.net/poem60222.html","الطويل"],[482,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[500,"رأت رفرف الأكوان هند فولت","https://www.aldiwan.net/poem37718.html","الطويل"],[515,"أراد علو منزلة وقدر","https://www.aldiwan.net/poem12233.html","الوافر"],[524,"الله أكبر كم وافت بشارات","https://www.aldiwan.net/poem13287.html","البسيط"],[551,"ما للقلوب غداة السبت مزعجة","https://www.aldiwan.net/poem47250.html","البسيط"],[551,"ألا إني وهبت اليوم نفسي","https://www.aldiwan.net/poem47748.html","الوافر"],[551,"إذا سارت بنا خوص الركاب","https://www.aldiwan.net/poem48058.html","الوافر"],[558,"نحن معاني الوجود فيه","https://www.aldiwan.net/poem33671.html","مخلع البسيط"],[558,"أدر صرفا خمور الأندرينا","https://www.aldiwan.net/poem33755.html","الوافر"],[558,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[561,"يا رَبِّ إِذ شَدَدَتني عِقالاً","https://www.aldiwan.net/poem27837.html","الرجز"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"ليل الحمى بات بدري فيك معتنقي","https://www.aldiwan.net/poem3047.html","البسيط"]],"verses":[["وَنِ كُلِّ وَضّاحِ الحُسامِ مُشَمِّراً","إِذا شَحَبَت فينا وُجوهُ المَظالِمِ",0,"م",1,0],["وَنِكسٍ شاطَرَتهُ مِنَ اللَيالي","يَدٌ عَن شيمَتي كَرَمٍ وَخَيرِ",1,"ر",1,0],["وَنَكباءُ مِهيافٌ كَأَنَّ حَنينَها","تَحَدُّثُ ثَكلى تَركَبُ البَوَّ رائِمِ",2,"م",1,0],["وَنَكَّلتَ فُسّاقَ العِراقِ فَأَقصَروا","وَغَلَّقتَ أَبوابَ النِساءِ عَلى سَترِ",3,"ر",1,0],["وَنَكُرُّ مَحمِيَةً وَتَمنَعُ سَرحَنا","جُردٌ تَرى لِمُغارِها أُخدودا",4,"د",2,0],["وَنَكفيهِمُ ثُمَّ لا يَشكُرونَ","مِراسَ الحُروبِ وَأَضرارَها",5,"ر",3,0],["وَنَكَّبنا الفُرُقلُسَ لَم نَرِدهُ","كَأَنَّ بِنا عَنِ الماءِ اِجتِنابا",6,"ب",2,0],["ونَكِرتُمُ أنْ كان صدرُ قصيدةٍ","ذِكرَايَ غُصْنَ مُنعَّمٍ وكثيبَهُ",7,"ب",2,0],["ونكهةٍ تلذعُ أنف الفتى","كأنها في أنفهِ شرطهْ",8,"ط",2,0],["ونكَّل الباعة التي عمرت","تجمع بين التطفيف والحشف",9,"ف",1,0],["ونكِّبْ سبيلاً أنت فيها فقد غدتْ","سبيلُك في أمري سبيلَ ضلالِ",10,"ل",1,0],["ونكافئ الآذانَ وهي حقيقةٌ","أن لا تزالَ تكايدُ اللوَّاما",11,"م",2,0],["ونكافئ الأفواه عن كتمانها","إذ لا يزالُ لها الصُّماتُ لجاما",11,"م",2,0],["وَنَكادُ نَعشَقُ في الأَزاهيرِ الدُمى","ئزهارَها وَنُحِسُّ نَفحَ شَميمِها",12,"م",3,0],["وَنَكَثتَ عَهداً في الهَوى","ما خِلتُ أَنَّكَ فيهِ ناكِث",13,"ث",1,0],["وَنَكَّبنَ زوراً عَن مُحَيّاةَ بَعدَما","بَدا الأَثلُ أَثلُ الغينَةِ المُتَجاوِرُ",14,"ر",1,0],["ونَكْسَبَ مِنْ عَثَراتِ الطَّريقِ","قُوًى لا تُهدُّ بدأْبِ الصُّعودْ",15,"د",1,0],["وَنَكهَتَها وَالمَندَلِيُّ وَقَرقَفٌ","مُعَتَّقَةٌ صَهباءُ في الريحِ وَالطَعمِ",16,"م",1,0],["وَنِكتَ عَجوزَكَ حَتّى تَرُدَّ","في رَحمِها داخِلاً ما خَرَج",17,"ج",1,0],["وَنُكثِرُ أَن نَستَودِعَ اللَهَ ظاعِناً","يُوَدِّعُ صافي العَيشِ حينَ يُوَدَّعُ",18,"ع",1,1],["وَنَكبَةٌ تُجرى عَقابيلُها","مَضامِعَ الباقي عَلى الفاني",19,"ي",1,0],["وَنَكتَفي مِن سِوانا في الحُروبِ بِنا","إِذا تَداعى عَلَينا الناسُ فَأتَلَفوا",20,"ف",3,0],["ونكادُ نَشْرَبُ من تَسامي جيدها","ماءً تسوقُ بهِ الرّياحُ سَحَابا",21,"ب",2,0],["ونكتبُ في الملاحمِ ما أَردنا","إذا التحمتْ صُفوفُ الكاتبينا",22,"ن",2,0],["ونَكتُمُ ما نقولُ فإنْ فعلنا","فخيرُ بني الكنانةِ فاعلينا",22,"ن",2,0],["وَنُكرِمُ قَومَهُ وَنَكونُ مِنهُم","بِحَيثُ يَكونُ ذو الرَحِمِ الضَنينُ",23,"ن",1,0],["ونكَّر كلٌّ وَجْهَهُ بِلثَامِهِ","وما نَكَّروا إلا الخيانةَ والغَدْرا",24,"ر",2,0],["وَنَكون في إِعلاء شَأ","نك عاملين عَلى الدَوام",25,"م",1,0],["ونِك شيخَ الثمانينِ","ولا تخشَ به شُنعه",26,"ع",2,0],["ونك مَن لقيتَ من العال","مينَ فإنّ الحزامةَ في نيكِهِ",27,"ك",2,0],["ونكّبَ إلاّ عن قُوَيْقٍ كأنّهُ","يظُنّ سِواهُ زائداً في أُوامِهِ",28,"م",2,0],["وَنَكُنْ أَبْهَى هَدَايَا الوُدِّ","وَالذِّكْرِ فِي المَهْرِ",29,"ر",1,0],["وَنَكَادُ نَسْمَعُ لِلقِتَالِ دَوِيَّهُ","ونَرَى الْفَوَارِسَ فِي لَقاً وَطِرَادِ",30,"د",1,0],["ونكاد نَقْضِي العام أجْ","مَعه بِسرْوَال وحيد؟",31,"د",1,0],["ونَكِلُّ عن هذا فنَطْرَحُهُ","ونُحِلُّ هذا الجيبَ والرفا",32,"ف",2,0],["ونكاد نعشق في الأزاهير الدمى","أزهارها ، ونحسّ نفخ شميمها",33,"م",3,0],["ونكافىء الآذانَ وهي حقيقة ٌ","أن لا تزالَ تكايدُ اللواما",34,"م",2,0],["ونكافىء الأفواه عن كتمانها","إذ لا يزالُ لها الصُّماتُ لجاما",34,"م",2,0],["ونكَادُ من جدْوى يد","يه لا نرى شخصاً لئيما",35,"م",2,0],["ونُكرِمُهُم ونُعلِيهُم مَقَاماً","وِإن أَلِفُوا الحَقارَةَ والهَوَانَا",36,"ن",2,0],["ونَكَّبتُ المَخَازِىَ والهُوَينَا","وَجانَبتُ الخَدِيعَةَ والهُوَانَا",37,"ن",2,0],["وَنَكَّبَتِ الجِبالَ بِهِم جِبالٌ","ضَوامِرُ لا تَجِفُّ لَها لُبودُ",38,"د",1,0],["وَنَكَّبتُ أَمواهاً يَعِزُّ وُرودُها","فَأَنقَعُ لِلظَمآنِ مِن وِردِها الظَما",39,"م",2,0],["ونكون في قرب النبي محمد","ومن الكرام الآل أهل النعمة",40,"ه",1,0],["ونكاية ذَلَّ العدوُّ","لها وَوَطأَتُهُ شديده",41,"د",2,0],["ونكاية تدع المعارف للعدا","في غاية التنكير والإِبهام",42,"م",1,0],["وَنُكِّسَتْ لِلْغَرْبِ في تَفَرُّق","كَأَنَّها عُودٌ بِغَيْرِ بُخْنُقِ",43,"ق",1,0],["ونكبةٌ ذم صبر الصابرين بها","والصبرُ قد كان محموداً عواقبهُ",44,"ب",2,0],["ونكس حزنا رأسه كل مارق","هنالك لما عاد سكرهم صحوا",45,"و",2,0],["وَنُكّست الأصنامُ من كلِّ جانب","وَقَد أعظَمت في وقتهِ أن تعظّما",46,"م",2,0],["وَنَكبَةٍ لَو رَمى الرامي بِها حَجَرا","أَصَمَّ مِن جَندَلِ الصَوّانِ لَاِنصَدَعا",47,"ع",2,0],["وَنَكهَة عودِ المندَلِيِّ شَذِيَّة","عَلى ضِفَّةِ النَهرِ الجَميلِ لَها نَشرُ",48,"ر",1,0],["وَنَكْشِفُ عَنَّا الظَّلاَمْ","بِنُورِ لُحُونِ النَّشِيدْ",49,"د",1,0],["ونكثهم تلك العهود دناءة","من الأصل والإنسان يزكو بأصله",50,"ل",2,0],["ونكهتُها كأنفاسِ العذارى","إذا فاغَمتَهنَّ على صدود",51,"د",1,0],["ونكظمُ غيظاً مُظهرينَ تجلُّداً","وننهضُ شعباً حائراً مُتَعثَّرا",52,"ر",2,0],["ونكست الاصنام في كل وجهة","وَغلت يد الشَيطان تبا له تبا",53,"ب",2,0],["ونكير القبر منكره","بهما زيغ الذي دخل",54,"ل",1,0],["ونكتب بالسيف تاريخنا","ونبعث مجد الجدود القديم",55,"م",1,0],["ونكات حفظتها عن أبي النوا","س أو عن جحا الحكيم المِفَنّ",56,"ن",1,0],["ونكَّس رأسه المرفوع طوعاً","لأمر أبيه عن أهل الضلال",57,"ل",1,0],["ونكلِّفُ العزماتِ فيه لأنه","لا يهتدي بالفوز من لم يَكْلَف",58,"ف",1,0],["ونكسي بها الخيرات والبر والرضا","ونحمي بها من كل هول وفتنة",59,"ه",1,0],["ونَكَّسْتُ رأسي للزَّمان وخطبه","فلا وُضعت فوقَ الرُّؤوس العمائم",60,"م",1,0],["ونكّر عرف الكرمات ورنّقت","من الجود بعد الصفونية مذاهله",61,"ل",2,0],["ونكّر وجه العرف في الناس وانطوت","على الرغم منهم ألسن النظم والنثر",62,"ر",1,0],["ونَكِرْتَ من جَوْرِ الحوادِثِ أنَّني","ظامٍ وبَحْرُ الجودِ فَوْقِيَ طَامِ",63,"م",1,0],["ونكرت منهم أوجهاً","بالحسن كانت زاهيه",64,"ي",2,0],["ونكادُ نسمعه فقد قربَ المدى","مستهزئاً بالسالفِ المستمهلِ",65,"ل",1,0],["ونكَّس رايتي منه نصيري","وميَّل صعدتي ربُّ اعتدالِ",66,"ل",1,0],["ونكثهم بك ميلاً عن وصيّتهم","شرعٌ لعمرك ثانٍ بعده شرعوا",67,"ع",3,0],["ونكره ذكر الموت في كل حالةٍ","وليس لنا إلا إلى الموت مرجع",68,"ع",1,0],["وَنَكتمُ الآهَ عُمْقَ الجُرح ِنَدفُنُها","لِنَحفَظ َ الزُّغُبَ الغافينَ غافينا !",69,"ن",2,0],["وَنَكهَتِها عِندَ التَنَفُّسِ عَنبَرٌ","وَريقَتُها في كُلِّ أَوقاتِها شُهدُ",70,"د",1,0],["ونكرع من علم اليقين لعينه","إلى حقّه حتى أفضّ مواهيّه",71,"ي",2,0],["ونكتة يس السرارة في العما","ومعنى نظام الدولة الأبدية",72,"ه",1,0],["ونكس رأسه لعتاب قلب","دعاه إلى الغواية والضلال",73,"ل",1,0],["وَنكست سائر الأَصنام وَاِنقَلَبَت","كَأَنَّها لَم تَكُن إِلّا هباآت",74,"ت",1,0],["ونكتم النّاسَ وَجْداً في جوانحنا","وكيف نكتم شيئاً ليس ينكتمُ",75,"م",1,0],["وَنكّبَ فيه عَن قَلبي الرّزايا","فأُصبِحُ آمناً أبداً وأُمسِي",76,"ي",1,0],["ونكّب عاذلي عن دارِ عَذْلِي","فتاركني وأقصرَ عن عتابي",77,"ي",1,0],["ونكشف الحق في المعاني","وفي المباني التي تقيه",78,"ي",2,0],["ونكشف وجهها لرجال صدق","محارمِها وليسوا أجنبينا",79,"ن",2,0],["ونكست أصنام الضلال وفي الورى","أزلت ظلام الظلم من فرط سطوتي",80,"ي",1,0],["وَنُكثِرُ الإِنعامَ وَالإِفضالا","نَلهزُ ذا الدَرءِ إِذا ما مالا",81,"ل",2,0],["ونكثا بيعته وكانا","فيمن على عثمان قد أعانا",82,"ن",2,0],["ونكهةِ لك تُحيي نفسَ ناشِقها","بمسترقٍّ من الفِردَوْس مُستَرق",83,"ق",1,0]]}