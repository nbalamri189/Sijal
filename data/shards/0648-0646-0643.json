َد",105,"د",1,0],["وَنَكُرُّ في يَومِ الوَغى وَرِماحُنا","حُمرُ الأَسِنَّةِ حينَ يُغشى المُنكَرُ",106,"ر",1,0],["وَنَكُرُ مَحمِيَةً وَيَمنَعُ سِربَنا","جُردٌ تُلَوِّحُها المَقانِبُ ضُمَّرُ",106,"ر",1,0],["ونَكوي بالعداوة مَن بغانا","ونُسعِدُ بالمودّة مَن وَدِدنا",107,"ن",2,0],["وَنِك مِن لَقيتَ الدَهرَ مِنهُم وَلا يَكُن","عَلَيكَ إِذا أَعطَوكَ مِنكَ إِباءُ",108,"ا",2,0],["وَنُكرِمُ جارَنا ما دامَ فينا","وَنُتبِعُهُ الكَرامَةَ حَيثُ مالا",109,"ل",2,1],["ونكرمهم طورا بذوق سلاحهم","ومن ضر يجرى مثل فعلته ضرا",110,"ر",2,0],["ونكست ضرُفاتٌ باللوى ملئت","اضحت أكاسرها من الأسى همَلا",111,"ل",2,0],["ونكست الأعلام بعد ارتفاعها","وذا شأن من لم ينظروا في العواقب",112,"ب",1,0],["ونكبة عم الأنام حزنها","إذ خص فيها آل بيت المرتضى",113,"ض",2,0],["وَنَكَيْتُمْ مُساعِدي وَسِنادي","وَنَهَبْتُمْ طَريفَهُ مَعْ تَليدِ",114,"د",1,0],["وَنَكَأْتُمْ جُرْحي بِقَتْلِهِ صَبْراً","وَكَفاني بِذاكَ أفْضَلَ فَخْرِ",114,"ر",1,0],["ونكرم جارنا ما دام فينا","ونتبعه الكرامة حيث كانا",115,"ن",2,1],["ونكسب في تجاربنا المعالي","وترك سوق كسبكم كسادا",116,"د",2,0],["وَنَكِّل بِفَضلٍ وَأَشياعِهِ","وَصَلِّبهُمُ حَولَ هَذيِ الجُسور",117,"ر",1,0],["ونكدا يضيق المرء عن حمل جزئه","فلحظته يوم وأيامه دهر",118,"ر",1,0],["ونكبة عمت الأقطار قاطبة","ما مثلها نكبة في سالف الحقب",119,"ب",1,0],["ونكس الرأس طورا وارمقن الى","نحو السماء يطرف منك منسجم",120,"م",1,0],["وَنَكلُؤُهُم بِالغَيبِ مِنّا حَفيظةً","وَأَكبادُنا وَجداً عَلَيهِم تَضَرَّمُ",121,"م",1,0],["ونكَّب عنا من نُريد وِدادَه","وسالمنا من لا نريد نُسالمه",122,"م",2,0],["وَنَكَسَت رَأسَها الأَقلام باكية","عَلى القَراطيس لَما ناحَت الخطب",123,"ب",1,0],["ونَكبةٌ قد ادركت فجأَةً","من أجلها كاد النُهى يَذهَلُ",124,"ل",1,0],["ونَكبةً مُصمِيَةً","مثلَ السِهام الراشقه",125,"ق",2,0],["ونكسوها من الإبداع ثوبا","فشيبا من نسيج النيرات",126,"ت",1,0],["ونكث عهد سابق","جريمة لا تغتفر",127,"ر",1,0],["ونكتم الوَجد حزماً في أَكنَّتنا","عَسى اللَيالي التي أَمضت بفرقتِنا",128,"ن",2,0],["وَنُكِّست أَعلامُهم","لما اِعتَلَت أَعلامنا",129,"ن",2,0],["ونكستمُ آياتِه","فنسختموها أجمعينا",1