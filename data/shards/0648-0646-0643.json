وَنَكباءُ مِهيافٌ كَأَنَّ حَنينَها","تَحَدُّثُ ثَكلى تَركَبُ البَوَّ رائِمِ",2,"م",1,0],["وَنَكَّلتَ فُسّاقَ العِراقِ فَأَقصَروا","وَغَلَّقتَ أَبوابَ النِساءِ عَلى سَترِ",3,"ر",1,0],["وَنَكُرُّ مَحمِيَةً وَتَمنَعُ سَرحَنا","جُردٌ تَرى لِمُغارِها أُخدودا",4,"د",2,0],["وَنَكفيهِمُ ثُمَّ لا يَشكُرونَ","مِراسَ الحُروبِ وَأَضرارَها",5,"ر",3,0],["وَنَكَّبنا الفُرُقلُسَ لَم نَرِدهُ","كَأَنَّ بِنا عَنِ الماءِ اِجتِنابا",6,"ب",2,0],["ونَكِرتُمُ أنْ كان صدرُ قصيدةٍ","ذِكرَايَ غُصْنَ مُنعَّمٍ وكثيبَهُ",7,"ب",2,0],["ونكهةٍ تلذعُ أنف الفتى","كأنها في أنفهِ شرطهْ",8,"ط",2,0],["ونكَّل الباعة التي عمرت","تجمع بين التطفيف والحشف",9,"ف",1,0],["ونكِّبْ سبيلاً أنت فيها فقد غدتْ","سبيلُك في أمري سبيلَ ضلالِ",10,"ل",1,0],["ونكافئ الآذانَ وهي حقيقةٌ","أن لا تزالَ تكايدُ اللوَّاما",11,"م",2,0],["ونكافئ الأفواه عن كتمانها","إذ لا يزالُ لها الصُّماتُ لجاما",11,"م",2,0],["وَنَكادُ نَعشَقُ في الأَزاهيرِ الدُمى","ئزهارَها وَنُحِسُّ نَفحَ شَميمِها",12,"م",3,0],["وَنَكَثتَ عَهداً في الهَوى","ما خِلتُ أَنَّكَ فيهِ ناكِث",13,"ث",1,0],["وَنَكَّبنَ زوراً عَن مُحَيّاةَ بَعدَما","بَدا الأَثلُ أَثلُ الغينَةِ المُتَجاوِرُ",14,"ر",1,0],["ونَكْسَبَ مِنْ عَثَراتِ الطَّريقِ","قُوًى لا تُهدُّ بدأْبِ الصُّعودْ",15,"د",1,0],["وَنَكهَتَها وَالمَندَلِيُّ وَقَرقَفٌ","مُعَتَّقَةٌ صَهباءُ في الريحِ وَالطَعمِ",16,"م",1,0],["وَنِكتَ عَجوزَكَ حَتّى تَرُدَّ","في رَحمِها داخِلاً ما خَرَج",17,"ج",1,0],["وَنُكثِرُ أَن نَستَودِعَ اللَهَ ظاعِناً","يُوَدِّعُ صافي العَيشِ حينَ يُوَدَّعُ",18,"ع",1,1],["وَنَكبَةٌ تُجرى عَقابيلُها","مَضامِعَ الباقي عَلى الفاني",19,"ن",2,0],["وَنَكتَفي مِن سِوانا في الحُروبِ بِنا","إِذا تَداعى عَلَينا الناسُ فَأتَلَفوا",20,"ف",3,0],["ونكادُ نَشْرَبُ من تَسامي جيدها","ماءً تسوقُ بهِ الرّياحُ سَحَابا",21,"ب",2,0],["ونكتبُ في الملاحمِ ما أَردنا","إذا التحمتْ صُفوفُ الكاتبينا",22,"ن",2,0],["ونَكتُمُ ما نقولُ فإنْ فعلنا","فخيرُ بني الكنانةِ فاعلينا",22,"ن",2,0],["وَنُكرِمُ قَومَهُ وَنَكونُ مِنهُم","بِحَيثُ يَكونُ ذو الرَحِمِ الضَنينُ",23,"ن",1,0],["ونكَّر كلٌّ وَجْهَهُ بِلثَامِهِ","وما نَكَّروا إلا الخيانةَ والغَدْرا",24,"ر",2,0],["وَنَكون في إِعلاء شَأ","نك عاملين عَلى الدَوام",25,"م",1,0],["ونِك شيخَ الثمانينِ","ولا تخشَ به شُنعه",26,"ع",2,0],["ونك مَن لقيتَ من العال","مينَ فإنّ الحزامةَ في نيكِهِ",27,"ك",2,0],["ونكّبَ إلاّ عن قُوَيْقٍ كأنّهُ","يظُنّ سِواهُ زائداً في أُوامِهِ",28,"م",2,0],["وَنَكُنْ أَبْهَى هَدَايَا الوُدِّ","وَالذِّكْرِ فِي المَهْرِ",29,"ر",1,0],["وَنَكَادُ نَسْمَعُ لِلقِتَالِ دَوِيَّهُ","ونَرَى الْفَوَارِسَ فِي لَقاً وَطِرَادِ",30,"د",1,0],["ونكاد نَقْضِي العام أجْ","مَعه بِسرْوَال وحيد؟",31,"د",1,0],["ونَكِلُّ عن هذا فنَطْرَحُهُ","ونُحِلُّ هذا الجيبَ والرفا",32,"ف",2,0],["ونكاد نعشق في الأزاهير الدمى","أزهارها ، ونحسّ نفخ شميمها",33,"م",3,0],["ونكافىء الآذانَ وهي حقيقة ٌ","أن لا تزالَ تكايدُ اللواما",34,"م",2,0],["ونكافىء الأفواه عن كتمانها","إذ لا يزالُ لها الصُّماتُ لجاما",34,"م",2,0],["ونكَادُ من جدْوى يد","يه لا نرى شخصاً لئيما",35,"م",2,0],["ونُكرِمُهُم ونُعلِيهُم مَقَاماً","وِإن أَلِفُوا الحَقارَةَ والهَوَانَا",36,"ن",2,0],["ونَكَّبتُ المَخَازِىَ والهُوَينَا","وَجانَبتُ الخَدِيعَةَ والهُوَانَا",37,"ن",2,0],["وَنَكَّبَتِ الجِبالَ بِهِم جِبالٌ","ضَوامِرُ لا تَجِفُّ لَها لُبودُ",38,"د",1,0],["وَنَكَّبتُ أَمواهاً يَعِزُّ وُرودُها","فَأَنقَعُ لِلظَمآنِ مِن وِردِها الظَما",39,"م",2,0],["ونكون في قرب النبي محمد","ومن الكرام الآل أهل النعمة",40,"ه",1,0],["ونكاية ذَلَّ العدوُّ","لها وَوَطأَتُهُ شديده",41,"د",2,0],["ونكاية تدع المعارف للعدا","في غاية التنكير والإِبهام",42,"م",1,0],["وَنُكِّسَتْ لِلْغَرْبِ في تَفَرُّق","كَأَنَّها عُودٌ بِغَيْرِ بُخْنُقِ",43,"ق",1,0],["ونكبةٌ ذم صبر الصابرين بها","والصبرُ قد كان محموداً عواقبهُ",44,"ب",2,0],["ونكس حزنا رأسه كل مارق","هنالك لما عاد سكرهم صحوا",45,"و",2,0],["وَنُكّست الأصنامُ من كلِّ جانب","وَقَد أعظَمت في وقتهِ أن تعظّما",46,"م",2,0],["وَنَكبَةٍ لَو رَمى الرامي بِها حَجَرا","أَصَمَّ مِن جَندَلِ الصَوّانِ لَاِنصَدَعا",47,"ع",2,0],["وَنَكهَة عودِ المندَلِيِّ شَذِيَّة","عَلى ضِفَّةِ النَهرِ الجَميلِ لَها نَشرُ",48,"ر",1,0],["وَنَكْشِفُ عَنَّا الظَّلاَمْ","بِنُورِ لُحُونِ النَّشِيدْ",49,"د",1,0],["ونكثهم تلك العهود دناءة","من الأصل والإنسان يزكو بأصله",50,"ل",2,0],["ونكهتُها كأنفاسِ العذارى","إذا فاغَمتَهنَّ على صدود",51,"د",1,0],["ونكظمُ غيظاً مُظهرينَ تجلُّداً","وننهضُ شعباً حائراً مُتَعثَّرا",52,"ر",2,0],["ونكست الاصنام في كل وجهة","وَغلت يد الشَيطان تبا له تبا",53,"ب",2,0],["ونكير القبر منكره","بهما زيغ الذي دخل",54,"ل",1,0],["ونكتب بالسيف تاريخنا","ونبعث مجد الجدود القديم",55,"م",1,0],["ونكات حفظتها عن أبي النوا","س أو عن جحا الحكيم المِفَنّ",56,"ن",1,0],["ونكَّس رأسه المرفوع طوعاً","لأمر أبيه عن أهل الضلال",57,"ل",1,0],["ونكلِّفُ العزماتِ فيه لأنه","لا يهتدي بالفوز من لم يَكْلَف",58,"ف",1,0],["ونكسي بها الخيرات والبر والرضا","ونحمي بها من كل هول وفتنة",59,"ه",1,0],["ونَكَّسْتُ رأسي للزَّمان وخطبه","فلا وُضعت فوقَ الرُّؤوس العمائم",60,"م",1,0],["ونكّر عرف الكرمات ورنّقت","من الجود بعد الصفونية مذاهله",61,"ل",2,0],["ونكّر وجه العرف في الناس وانطوت","على الرغم منهم ألسن النظم والنثر",62,"ر",1,0],["ونَكِرْتَ من جَوْرِ الحوادِثِ أنَّني","ظامٍ وبَحْرُ الجودِ فَوْقِيَ طَامِ",63,"م",1,0],["ونكرت منهم أوجهاً","بالحسن كانت زاهيه",64,"ي",2,0],["ونكادُ نسمعه فقد قربَ المدى","مستهزئاً بالسالفِ المستمهلِ",65,"ل",1,0],["ونكَّس رايتي منه نصيري","وميَّل صعدتي ربُّ اعتدالِ",66,"ل",1,0],["ونكثهم بك ميلاً عن وصيّتهم","شرعٌ لعمرك ثانٍ بعده شرعوا",67,"ع",3,0],["ونكره ذكر الموت في كل حالةٍ","وليس لنا إلا إلى الموت مرجع",68,"ع",1,0],["وَنَكتمُ الآهَ عُمْقَ الجُرح ِنَدفُنُها","لِنَحفَظ َ الزُّغُبَ الغافينَ غافينا !",69,"ن",2,0],["وَنَكهَتِها عِندَ التَنَفُّسِ عَنبَرٌ","وَريقَتُها في كُلِّ أَوقاتِها شُهدُ",70,"د",1,0],["ونكرع من علم اليقين لعينه","إلى حقّه حتى أفضّ مواهيّه",71,"ي",2,0],["ونكتة يس السرارة في العما","ومعنى نظام الدولة الأبدية",72,"ه",1,0],["ونكس رأسه لعتاب قلب","دعاه إلى الغواية والضلال",73,"ل",1,0],["وَنكست سائر الأَصنام وَاِنقَلَبَت","كَأَنَّها لَم تَكُن إِلّا هباآت",74,"ت",1,0],["ونكتم النّاسَ وَجْداً في جوانحنا","وكيف نكتم شيئاً ليس ينكتمُ",75,"م",1,0],["وَنكّبَ فيه عَن قَلبي الرّزايا","فأُصبِحُ آمناً أبداً وأُمسِي",76,"س",2,0],["ونكّب عاذلي عن دارِ عَذْلِي","فتار