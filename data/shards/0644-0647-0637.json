{"poems":[[65,"بَدَتْ عَقِداتُ الرّمْلِ والجَرَعُ العُفْرُ","https://www.aldiwan.net/poem46213.html","الطويل"],[74,"عذول لست أسمع منه عذلا","https://www.aldiwan.net/poem20102.html","الوافر"],[30,"فما فاضلت بيتا ببيتك عامر","https://www.aldiwan.net/poem5462.html","الطويل"],[63,"حبيب حباك بلينوفر","https://www.aldiwan.net/poem51819.html","المتقارب"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29336","الطويل"],[132,"سقى بالمنحنى رسما وربعا","https://www.aldiwan.net/poem50581.html","الوافر"],[276,"دم المحب على الاطلال مطلول","https://www.aldiwan.net/poem52067.html","البسيط"],[368,"تأوبني هم مع الليل منصب","https://www.aldiwan.net/poem1719.html","الطويل"],[369,"لها في حمى مني وراء الترائب","https://www.aldiwan.net/poem60994.html","الطويل"],[457,"أجب ما اسم خماسي","https://www.aldiwan.net/poem13642.html","مجزوء الوافر"],[457,"سواي استمالته الظباء الأوانس","https://www.aldiwan.net/poem13805.html","الطويل"],[543,"تجلت معاني الطعن من قدك اللدن","https://www.aldiwan.net/poem47919.html","عموديه"],[567,"أقول اليوم صار الشرق شرقا","https://www.aldiwan.net/poem52881.html","البسيط"],[572,"كتبت وعندنا ورد وراح","https://www.aldiwan.net/poem69747.html","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62493","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62578","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120098","المتقارب"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59291","الوافر"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96672","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56098","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64720","الوافر"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64716","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112830","الوافر"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79959","الطويل"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45370","المتقارب"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66270","الرجز"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69360","الوافر"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89522","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53140","الوافر"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110637","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93683","الطويل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106991","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93826","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204792","البسيط"],[3162,"","https://poetry.dctabudhabi.ae/diwan/poem/142893","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48445","المتقارب"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102382","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86253","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45766","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117863","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118005","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111461","المتقارب"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107537","المتقارب"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127241","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94567","الطويل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136389",""],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101937","الرجز"],[4578,"لبدرٍ زفاف الشمس والنجم شاهد","https://www.poetsgate.com/ViewPoem.aspx?id=49397",""],[5225,"أذهلتني","https://www.poetsgate.com/ViewPoem.aspx?id=24310",""],[5431,"إنَّ الحب فردوسٌ وروحي بابها التاسع","https://www.poetsgate.com/ViewPoem.aspx?id=185122",""],[5431,"على لوحٍ بنور الله يُسقى...","https://www.poetsgate.com/ViewPoem.aspx?id=200032",""],[5704,"رحْمَاكَ٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=198799",""],[5956,"بكل جلاله يأتي إلينا","https://www.poetsgate.com/ViewPoem.aspx?id=194012",""],[5956,"يحب الأقاربُ أبهَى حفيدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=210841",""]],"verses":[["لهُ طَعَناتٌ إنْ سُبِرْنَ تَخاوَصَتْ","إِلى مَن يُداويهِنَّ أعْيُنُها الخُزْرُ",0,"ر",1,0],["له طرفٌ ضريرٌ عن سناها","ولي أذنٌ عن الفحشاء صمَّا",1,"م",2,0],["لَهُ طُرُقٌ عادِيَّةٌ يُهتَدى بِها","وَهُم خَيرُ قَيسٍ آخِرِيّاً وَأَوَّلا",2,"ل",2,0],["له طَلْعَةٌ بين أوراقِه","ضُحىً ثم يكمُنُ في مائِه",3,"ا",3,0],["له طحر عوج كأن مضيغها","قداح براها صائع الكف نابل",4,"ل",1,0],["له طرفٌ يراعِى الناس طُرّاً","بنفسى مَنْ جميعَ الناس يَرْعَى",5,"ع",2,0],["له طَلائع ربانية مزجت","بالنور وَالعلم مَعقول وَمَنقول",6,"ل",1,0],["لَهُ طَرَبٌ في إِثرِهِنَّ وَرَبُّهُ","إِلى ما يَرى مِن غارَةِ الخَيلِ أَطرَبُ",7,"ب",1,0],["له طَرْفُ رأْيٍ لم تَزل تَجْتلِي بهِ","وُجوهُ المَساعي في مَرايا العَجائب",8,"ب",1,0],["له طرفان قد رفعا","إِذا ما راح متصبا",9,"ب",2,0],["له طيبُ أعراق وحُسْنُ خلائق","وأخلاقه روضٌ به الغُصْنُ مائسُ",10,"س",1,0],["له طَلعَةٌ يُحيى النفوسَ بَهاؤُها","وتَجلو عَنِ المَحزونِ ما بِهِ من حُزنِ",11,"ن",1,0],["لهُ طَرَفٌ بأقصَى الشام يبدو","وأخَرُ في أقاصي مِصرَ يُلقَى",12,"ق",2,0],["لَهُ طُرَرٌ تُصَفُّ على جَبِيْنٍ","كَمِثْلِ اللَّيْلِ قَابَلَهُ الصَّبَاحُ",13,"ح",1,0],["لهُ طَرَب عالٍ بنغمة مرهَف","إذا ما شدا بالهام حادي نصاله",14,"ل",2,0],["له طول باخراج","المحامد من زواياها",15,"ا",3,0],["له طرة كظلام الدجى","على غرة كضياء الصّباحِ",16,"ح",1,0],["لَهُ طرفٌ أعَادَ الجفنَ سيفاً","والحاظٌ أعَدْنَ السيفَ جفنَا",17,"ن",2,0],["لَهُ طلعةٌ مسعودةٌ طلعت بها","سعودٌ وَمالَت للمغيب نحوسُ",18,"س",1,0],["له طلعةٌ يبهي العقول جلالها","ويرعب ملقاها المهيب الضياغما",19,"م",2,0],["لهُ طَرْفٌ يقولُ الحربُ أَولى","ولي قَلْبٌ يقولُ الصُّلحُ أَصْلَحْ",20,"ح",1,0],["لَهُ طُوْدُ حِلْمٍ لِلْجَرائِمِ ساتِرٍ","وَفائِضُ جُوْدٍ لِلأَكارِمِ فاضِحُ",21,"ح",1,0],["له طرب بذكر واشتياق","ووصل للحبيب ومكرمات",22,"ت",1,0],["له طلعةٌ غرّاء دائمة السنا","هي الشمس لو تمسي هي البدر لو يضحي",23,"ح",2,0],["لَهُ طَعنَةٌ يَدخُلُ الفيلُ مِنها","إِذا الطَعنُ مَزَّقَت الزَغفَ نَقدا",24,"د",2,0],["له طوائل إذا استنطقها","تنطق عن طول البطين الأنزع",25,"ع",1,0],["لَهُ طَعمانِ مِن نُعمى وَبُوسى","فَذا صَبِرٌ وَذا عَسَلٌ جَنِيُّ",26,"ي",1,0],["لَهُ طُهورٌ وَنورٌ ثُمَّ عافِيَةٌ","وَزالَ عَنهُ إِلى اَعدائِهِ الضَرَرُ",27,"ر",1,0],["له طربات نشوان الحميا","إلى الجدوى وصولات السباع",28,"ع",1,0],["له طيب أخلاق ذكي طيب نشرها","كأن فتيق المسك منها تفتقا",29,"ق",2,0],["لَهُ طأطأت صيد المُلوك رِقابها","فَهاتيك تَخشاه وَذي مِنهُ تَأمل",30,"ل",1,0],["له طلعة البدر المنير ولفتة ال","غزال وعباق العبير لناشق",31,"ق",1,0],["له طرف لباقي الود يرعى","وليس بطامح نحو الحطام",32,"م",1,0],["له طريقا ذهولٍ مرأةٌ وطلىً","لكن اشدهما في الصرعة الأولى",33,"ل",2,1],["له طائر إن مد يوما جناحه","مضى حيث يبغي دون قيد ولا أسر",34,"ر",1,0],["له طلعةٌ لو حَكاها الضُحى","لما ظلَّ منهُ السّنا يختَفي",35,"ف",2,0],["لهُ طلّةٌ شابَتْ وما مس جيبَها","ولا راحتَيْها الشَّثْنَتَيْنِ عبيرُ",36,"ر",1,0],["لَهُ طيبُ ذِكرٍ يَحسد النَدُّ نَفحَهُ","كَزَهر الرُبى مِنهُ يَطيبُ شَميمُ",37,"م",1,0],["لَهُ طالع البَدر المُنير الَّذي بَدا","سَعيداً وَإِن عَدوه بَعدَ عَطارِدِ",38,"د",1,0],["له طأطأت أعناقهم كمل الورى","ولم ير منهم من أبى وتكبّرا",39,"ر",2,0],["له طرائق شتّى لا يحيط بها","عدٌّ وكل وجود فهو واديه",40,"ي",2,0],["لَهُ طُرَرٌ أَربَعٌ بِاتِّقادِ","يَقي مِئَةً مِن جُيُوشِ البِلادِ",41,"د",1,0],["له طلعةٌ ان رأتها النساء","خلعنَ العذارَ وبعنَ الحيا",42,"ا",1,0],["له طرف سقيم شبه صبري","ولكن فيه قد صح الغرام",43,"م",1,0],["لهُ طلعةٌ مذ أخجل الشمس نورها","فحار بأخذ النور بينهما البدرُ",44,"ر",1,0],["له طارف المجد الرفيع بفضله","وتالده السامي الذي منهما يسري",45,"ر",2,0],["له طباع حكت ال","عذبين شهداً وبرد",46,"د",1,0],["لهُ طلعةٌ غراء يمتد نورها","إذا أشرقت بدر الدجا والفرقدُ",47,"د",1,0],["له طروق الشعر فكري مذهله","منّهله وأرويه من غزرٍ زلال",48,"ل",1,0],["له طفلي محباتي","وإني الحلمُ لاالواقعْ!",49,"ع",1,0],["له طعم المرارة من حروبٍ","وأشواقٌ من النفحاتِ أنقى",50,"ق",2,0],["له طرف بدمع بات يهمي","على الوٓجْناتِ.. ينتحب انتحابا",51,"ب",2,0],["له طبع الملائك والدَّراري","وإني في صداقتهِ فخورُ",52,"ر",1,0],["له طلعةٌ ذات مجدٍ عريقٍ","وكم عظَّموه وما همُ غالوا",53,"ل",3,0]]}