{"poems":[[63,"بَدَتْ عَقِداتُ الرّمْلِ والجَرَعُ العُفْرُ","https://www.aldiwan.net/poem46213.html","الطويل"],[72,"عذول لست أسمع منه عذلا","https://www.aldiwan.net/poem20102.html","الوافر"],[28,"فما فاضلت بيتا ببيتك عامر","https://www.aldiwan.net/poem5462.html","الطويل"],[61,"حبيب حباك بلينوفر","https://www.aldiwan.net/poem51819.html","المتقارب"],[129,"سقى بالمنحنى رسما وربعا","https://www.aldiwan.net/poem50581.html","الوافر"],[272,"دم المحب على الاطلال مطلول","https://www.aldiwan.net/poem52067.html","البسيط"],[364,"تأوبني هم مع الليل منصب","https://www.aldiwan.net/poem1719.html","الطويل"],[365,"لها في حمى مني وراء الترائب","https://www.aldiwan.net/poem60994.html","الطويل"],[453,"أجب ما اسم خماسي","https://www.aldiwan.net/poem13642.html","مجزوء الوافر"],[453,"سواي استمالته الظباء الأوانس","https://www.aldiwan.net/poem13805.html","الطويل"],[539,"تجلت معاني الطعن من قدك اللدن","https://www.aldiwan.net/poem47919.html","عموديه"],[563,"أقول اليوم صار الشرق شرقا","https://www.aldiwan.net/poem52881.html","البسيط"],[568,"كتبت وعندنا ورد وراح","https://www.aldiwan.net/poem69747.html","الوافر"]],"verses":[["لهُ طَعَناتٌ إنْ سُبِرْنَ تَخاوَصَتْ","إِلى مَن يُداويهِنَّ أعْيُنُها الخُزْرُ",0,"ر",1,0],["له طرفٌ ضريرٌ عن سناها","ولي أذنٌ عن الفحشاء صمَّا",1,"م",2,0],["لَهُ طُرُقٌ عادِيَّةٌ يُهتَدى بِها","وَهُم خَيرُ قَيسٍ آخِرِيّاً وَأَوَّلا",2,"ل",2,0],["له طَلْعَةٌ بين أوراقِه","ضُحىً ثم يكمُنُ في مائِه",3,"ا",3,0],["له طرفٌ يراعِى الناس طُرّاً","بنفسى مَنْ جميعَ الناس يَرْعَى",4,"ع",2,0],["له طَلائع ربانية مزجت","بالنور وَالعلم مَعقول وَمَنقول",5,"ل",1,0],["لَهُ طَرَبٌ في إِثرِهِنَّ وَرَبُّهُ","إِلى ما يَرى مِن غارَةِ الخَيلِ أَطرَبُ",6,"ب",1,0],["له طَرْفُ رأْيٍ لم تَزل تَجْتلِي بهِ","وُجوهُ المَساعي في مَرايا العَجائب",7,"ب",1,0],["له طرفان قد رفعا","إِذا ما راح متصبا",8,"ب",2,0],["له طيبُ أعراق وحُسْنُ خلائق","وأخلاقه روضٌ به الغُصْنُ مائسُ",9,"س",1,0],["له طَلعَةٌ يُحيى النفوسَ بَهاؤُها","وتَجلو عَنِ المَحزونِ ما بِهِ من حُزنِ",10,"ن",1,0],["لهُ طَرَفٌ بأقصَى الشام يبدو","وأخَرُ في أقاصي مِصرَ يُلقَى",11,"ق",2,0],["لَهُ طُرَرٌ تُصَفُّ على جَبِيْنٍ","كَمِثْلِ اللَّيْلِ قَابَلَهُ الصَّبَاحُ",12,"ح",1,0]]}