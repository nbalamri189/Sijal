{"poems":[[53,"ومروع لي بالسلام كأنما","https://www.aldiwan.net/poem30097.html","الكامل"],[97,"قالت تعال فقلت لبيك","https://www.aldiwan.net/poem25091.html","أحذ الكامل"],[31,"ردوا التحية أيها السفر","https://www.aldiwan.net/poem42513.html","الكامل"],[74,"وظلام ليل لا شهاب بأفقه","https://www.aldiwan.net/poem13246.html","الكامل"],[7,"يا دار مية بالعلياء فالسند","https://www.aldiwan.net/poem2003.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54993","الطويل"],[197,"ثوب السماء مطرز بالعسجد","https://www.aldiwan.net/poem45645.html","الكامل"],[413,"أكرم بطيف خيالكم من زائر","https://www.aldiwan.net/poem54150.html","الكامل"],[436,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"]],"verses":[["وَكَأَنَّ ضَربَ بَنانِهِ ضَربُ الطُلى","وَكَأَنَّما إيقاعُهُ إيقاعُ",0,"ع",1,0],["وكأن ضحكتها وقد طربت","قطرات ماء فوق بلور",1,"ر",1,0],["وَكَأَنَّ ضَوءَ الشَمسِ تَحتَ قِناعِها","أَو مُزنَةً أَدنى بِها القَطرُ",2,"ر",1,0],["وَكَأَنَّ ضَوءَ الصُبحِ رايَةُ ظافِرٍ","نَفَضَت بِهِ الهَيجاءُ نَضحاً مِن دَمِ",3,"م",1,0],["وَكانَ ضُمرانُ مِنهُ حَيثُ يوزِعُهُ","طَعنَ المُعارِكِ عِندَ المُحجَرِ النَجُدِ",4,"د",1,0],["وَكانَ ضَعِيفَ الرَّأْيِ فِي أَمْرِ نَفْسهِ","رَقِيقَ حَوَاشِي الطَّبْعِ سَهْلَ التَّطَبُّعِ",5,"ع",1,0],["وكأنَّ ضوءَ الفجرِ رونقُ صارمٍ","نضيتْ صفيحتهُ ولما تغمدِ",6,"د",1,0],["وكأنَّ ضوءَ في أثر الدجى","إظهارُ حُجّةِ مسلمٍ للكافر",7,"ر",1,0],["وَكَانَ ضَياعِي حَسْرَةً وَتَنَدُّمَا","إذَا لَمْ يُفِدْ شَيْئاً وَلَمْ يُغْنِنِي شَيَّا",8,"ي",2,0]]}