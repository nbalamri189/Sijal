{"poems":[[55,"أي دموع عليك لم تصب","https://www.aldiwan.net/poem30737.html","المنسرح"],[0,"سما لك شوق بعدما كان أقصر","https://www.aldiwan.net/poem53.html","الطويل"],[91,"الما بشعر قام كالطلل البالي","https://www.aldiwan.net/poem44841.html","الطويل"],[33,"أفي رسم دار دارس أنت واقف","https://www.aldiwan.net/poem42225.html","الطويل"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[12,"","https://poetry.dctabudhabi.ae/diwan/poem/11812","الطويل"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1915","الطويل"],[135,"النائب المفعول إن يلقه","https://www.aldiwan.net/poem54884.html","السريع"],[406,"إن كان من يبغضنا كارها","https://www.aldiwan.net/poem33906.html","السريع"],[455,"أبا البلاد الذي تسمو البلاد به","https://www.aldiwan.net/poem61352.html","البسيط"],[507,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[507,"المقاوم","https://www.aldiwan.net/poem56770.html","الطويل"]],"verses":[["وَإِن يَزُر طالِعُ البَياضِ أَقُل","يا لَيتَ لَيلَ الشَبابِ لَم يَغِبِ",0,"ب",1,0],["وَإِنّي زَعيمٌ إِن رَجِعتُ مُمَلَّك","بِسَيرٍ تَرى مِنهُ الفُرانِقَ أَزوَرا",1,"ر",2,0],["وان يزك معناه ولم يزك لفظه","فذاك كخود في دريس واسمال",2,"ل",1,0],["وَإِنّي زَعيمٌ أَن تُقَرِّبَ فِتيَةً","إِليكِ مُعيداتُ السَفارِ عَواطِفُ",3,"ف",1,0],["وإنْ يَزُلْ خامسُهُ المسكَّنُ","فذلكَ المَقبوضُ فهو يحسُنُ",4,"ن",1,0],["وإنْ يَزُل رابعُهُ والثّاني","ذاكَ وذا في الجُزءِ ساكِنانِ",4,"ن",1,0],["وإنْ يَزُل من آخرِ الجُزء وَتَدْ","إن كانَ مجموعاً فذلكَ الأحَدْ",4,"د",1,0],["وَإنّي زَعيمٌ أَن تَلُفَّ عَجاجَتي","عَلى ذِي كِساءٍ مِن سَلامانَ أَو بُردِ",5,"د",1,0],["وَإِنّي زَعيمٌ إِن رَجِعتُ مُمَلَّكاً","بِسَيرٍ تَرى مِنهُ الفُرانِقَ أَزوَرا",6,"ر",2,0],["وإِن يُزاحِم نائبا فاعِلٌ","يَفِرَّ خَوفَ الفاعلِ النائِبُ",7,"ب",1,0],["وأن يُزَكُّوا وأن يصوموا وأن","يصوموا المسنون في الأشهر",8,"ر",1,0],["وأن يزيل جهالات مضلّلة","ويهزم الجمع مهما عم إجراما",9,"م",2,0],["وأنّي زرْتُ نقمادَ","وأوغاريتَ أحْيانا",10,"ن",2,0],["وأنّي زمانُ ال(لا) أقضُّ مضاجعَ الن","(نعمْ) في زمانِها وألجمُ فاها",11,"ا",3,0]]}