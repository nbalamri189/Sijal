{"poems":[[55,"أي دموع عليك لم تصب","https://www.aldiwan.net/poem30737.html","المنسرح"],[0,"سما لك شوق بعدما كان أقصر","https://www.aldiwan.net/poem53.html","الطويل"],[91,"الما بشعر قام كالطلل البالي","https://www.aldiwan.net/poem44841.html","الطويل"],[33,"أفي رسم دار دارس أنت واقف","https://www.aldiwan.net/poem42225.html","الطويل"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[12,"","https://poetry.dctabudhabi.ae/diwan/poem/11812","الطويل"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1915","الطويل"],[136,"النائب المفعول إن يلقه","https://www.aldiwan.net/poem54884.html","السريع"],[409,"إن كان من يبغضنا كارها","https://www.aldiwan.net/poem33906.html","السريع"],[458,"أبا البلاد الذي تسمو البلاد به","https://www.aldiwan.net/poem61352.html","البسيط"],[510,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[510,"المقاوم","https://www.aldiwan.net/poem56770.html","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64773","البسيط"],[1568,"","https://poetry.dctabudhabi.ae/diwan/poem/202667","الطويل"],[1687,"","https://poetry.dctabudhabi.ae/diwan/poem/138028","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118306","الرجز"],[1993,"","https://poetry.dctabudhabi.ae/diwan/poem/199033","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133264","الوافر"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88520","الطويل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107512","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141683","البسيط"],[6299,"كأنْ قَدْ فلا يَغْرُرْكِ مِنِّي تَمَكُّثِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19680&r=&rc=5",""]],"verses":[["وَإِن يَزُر طالِعُ البَياضِ أَقُل","يا لَيتَ لَيلَ الشَبابِ لَم يَغِبِ",0,"ب",1,0],["وَإِنّي زَعيمٌ إِن رَجِعتُ مُمَلَّك","بِسَيرٍ تَرى مِنهُ الفُرانِقَ أَزوَرا",1,"ر",2,0],["وان يزك معناه ولم يزك لفظه","فذاك كخود في دريس واسمال",2,"ل",1,0],["وَإِنّي زَعيمٌ أَن تُقَرِّبَ فِتيَةً","إِليكِ مُعيداتُ السَفارِ عَواطِفُ",3,"ف",1,0],["وإنْ يَزُلْ خامسُهُ المسكَّنُ","فذلكَ المَقبوضُ فهو يحسُنُ",4,"ن",1,0],["وإنْ يَزُل رابعُهُ والثّاني","ذاكَ وذا في الجُزءِ ساكِنانِ",4,"ن",1,0],["وإنْ يَزُل من آخرِ الجُزء وَتَدْ","إن كانَ مجموعاً فذلكَ الأحَدْ",4,"د",1,0],["وَإنّي زَعيمٌ أَن تَلُفَّ عَجاجَتي","عَلى ذِي كِساءٍ مِن سَلامانَ أَو بُردِ",5,"د",1,0],["وَإِنّي زَعيمٌ إِن رَجِعتُ مُمَلَّكاً","بِسَيرٍ تَرى مِنهُ الفُرانِقَ أَزوَرا",6,"ر",2,0],["وإِن يُزاحِم نائبا فاعِلٌ","يَفِرَّ خَوفَ الفاعلِ النائِبُ",7,"ب",1,0],["وأن يُزَكُّوا وأن يصوموا وأن","يصوموا المسنون في الأشهر",8,"ر",1,0],["وأن يزيل جهالات مضلّلة","ويهزم الجمع مهما عم إجراما",9,"م",2,0],["وأنّي زرْتُ نقمادَ","وأوغاريتَ أحْيانا",10,"ن",2,0],["وأنّي زمانُ ال(لا) أقضُّ مضاجعَ الن","(نعمْ) في زمانِها وألجمُ فاها",11,"ا",3,0],["وإن يَزُرْكمْ على قربٍ فذُو كَلَفٍ","لو أفرطَ البعدُ لم يستَبعدِ الدارَا",12,"ر",2,0],["وإني زعيم والقوافي ضوامن","بشكر تعاطيه الزمان القصائد",13,"د",1,0],["وإنَّ يَزيداً رامَ أنْ يَتَسَفَّلوا","وأنْ يَتَرَدَّوْا في مَهاوي الْمَعاطِبِ",14,"ب",1,0],["وان يزيد من عوالي الرتب","مقامكم دون عنا ورتب",15,"ب",1,0],["وإن يزعموا أن الكتاب دليله","فكل فريق بالكتاب يجادل",16,"ل",1,0],["وأنى زرت بيت الله لكن","وحقك لم أزره ولو لسماما",17,"م",2,0],["وأن يزيداً ليس يطلب عندنا","كتاباً ولا حقاً وذو الحق يطلب",18,"ب",1,0],["وأن يزيداً كان في متنَزَهٍ","وفي معزلٍ عمّا تزاول تغلب",18,"ب",1,0],["وان يزه إعجاباً سواك بمثله","فمثلك لا يُزهى ولا يتعجب",19,"ب",1,0],["وإن يزرني أمرؤ غطّى على بصري","إذ عنده رؤية الزوَّار كالسقم",20,"م",1,0],["وإنِّي زَعِيمُ أنْ ألُفَ عَجَاجَتِي","عَلَى ذِي كِسَاءٍ، مِنْ سَلاَمَانَ، أوْ بُرْدِ",21,"د",1,0]]}