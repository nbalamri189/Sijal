{"poems":[[49,"يا حسرة ما أكاد أحملها","https://www.aldiwan.net/poem25170.html","المنسرح"],[68,"يا من فضح الغصون في مشيته","https://www.aldiwan.net/poem39626.html","الدوبيت"],[240,"يا منفقا أيامه","https://www.aldiwan.net/poem32110.html","مجزوء الكامل"],[347,"يوم الهوان وصيحة المرتاب","https://www.aldiwan.net/poem55365.html","الكامل"],[358,"حمدا لك اللهم يا من قد قضى","https://www.aldiwan.net/poem40828.html","الرجز"],[369,"هل أنت بطولك مسعده","https://www.aldiwan.net/poem60943.html","المتدارك"],[411,"يا منفق العمر في لغو وفي عبث","https://www.aldiwan.net/poem49596.html","البسيط"],[458,"ألقاك في وطني الحبيب الأول","https://www.aldiwan.net/poem61630.html","الكامل"],[466,"يا من فخار تميم","https://www.aldiwan.net/poem15327.html","المجتث"],[563,"إشرب من العين لا تشرب من الكاس","https://www.aldiwan.net/poem34434.html","المواليا"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53860","البسيط"],[703,"","https://poetry.dctabudhabi.ae/diwan/poem/122950","السريع"],[823,"","https://poetry.dctabudhabi.ae/diwan/poem/198756","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37859","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56215","المتدارك"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/198736","البسيط"],[1389,"","https://poetry.dctabudhabi.ae/diwan/poem/102247","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77821","الكامل"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101913","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118380","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53222","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53160","الكامل"],[2258,"","https://poetry.dctabudhabi.ae/diwan/poem/198783","البسيط"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105026","الدوبيت"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28617","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137188",""],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65307","المجتث"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74060","البسيط"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129452","السريع"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129329","الكامل"],[3827,"","https://poetry.dctabudhabi.ae/diwan/poem/139841",""],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94896","الكامل"],[4227,"","https://poetry.dctabudhabi.ae/diwan/poem/144291","البسيط"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81290","السريع"],[4508,"","https://poetry.dctabudhabi.ae/diwan/poem/146838","البسيط"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136415",""],[4716,"يا أيها الحبر وبحر الندى","https://www.poetsgate.com/ViewPoem.aspx?id=125956",""],[4775,"المنفى","https://www.poetsgate.com/ViewPoem.aspx?id=175265",""],[4862,"قسما مازلت أؤكده","https://www.poetsgate.com/ViewPoem.aspx?id=55514",""],[4929,"القدس في آجامها أُسْدُ","https://www.poetsgate.com/ViewPoem.aspx?id=199469",""],[4940,"كذبٌ مُحَلَّى بالدموع","https://www.poetsgate.com/ViewPoem.aspx?id=214425",""],[5219,"منة الرحمن في بردة النبي العدنان","https://www.poetsgate.com/ViewPoem.aspx?id=195106",""],[5277,"معارضة داليّة الحصري القيرواني","https://www.poetsgate.com/ViewPoem.aspx?id=198895",""],[5292,"العلم أبقى لأهل العلم آثاراً","https://www.poetsgate.com/ViewPoem.aspx?id=122673",""],[5545,"أهواكَ مُلهَمةً","https://www.poetsgate.com/ViewPoem.aspx?id=185001",""],[5582,"سَلْ بُرْقَةَ العَلَمَيْنِ ثُمَّ البانا","https://www.poetsgate.com/ViewPoem.aspx?id=187309",""],[5691,"أطفال العراق","https://www.poetsgate.com/ViewPoem.aspx?id=207065",""],[5704,"يا روح الروح","https://www.poetsgate.com/ViewPoem.aspx?id=195152",""],[5784,"حكايا","https://www.poetsgate.com/ViewPoem.aspx?id=213093",""],[5909,"تَلُفَ الحِجا لمّا ولجتُ حِماكا","https://www.poetsgate.com/ViewPoem.aspx?id=210245",""],[5956,"فاجعُ المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=182538",""],[5956,"المنيرُ الرّوحيُّ المفضال","https://www.poetsgate.com/ViewPoem.aspx?id=194141",""]],"verses":[["يامُنفِقَ المالِ لايُريدُ بِهِ","إِلّا المَعالي الَّتي يُؤَثِّلُها",0,"ل",3,0],["يا مَن فَضَحَ الغُصونَ في مَشيَتِهِ","وَالبَدرَ فَما أَفاقَ مِن غَشيَتِهِ",1,"ه",1,1],["يا مُنفِقاً أَيّامَهُ","في لَهوِهِ وَمِزاحِهِ",2,"ح",2,1],["يا من فتحت القدس مهلا ما انتهت","ما زال في الميدان بعض صعاب",3,"ب",1,0],["يا مَن فَدى إِسحاق بالذبح وَقد","كانَ ذَبيحاً ما لَدَيهِ مِن فدى",4,"ا",1,0],["يا مَنْ في الدّهرِ على نَظَري","لا شَيءَ سواهُ يَحمَده",5,"د",2,0],["يا مَن في اليوم يَظَلُّ له","مِما للجود تَعَوّده",5,"د",2,0],["يا مُنفِقَ العُمرِ في لَغْوٍ وفي عَبَثِ","أشفِقْ على زَمَنٍ إن مّرَّ لم يَعُدِ",6,"د",1,1],["يا من فَتنت الجيلَ غيرَ مدافعٍ","بجنانه وحديثه المتهلل",7,"ل",1,0],["يا منْ فَخارُ تميمٍ","بهِ وكلِّ القَبائلْ",8,"ل",1,1],["يا من فُتِنْ في الهوى بالسالف الآسِ","اطلب لدائكْ دوا شافي من الآسي",9,"ي",1,0],["يا من فدت نفسه نفسي ومن جُعلتْ","له وقاء لما يخشى واخشاهُ",10,"ه",1,1],["يا من فدت انفسنا نفسه","موعدنا بالأمس لا تنسه",11,"ه",1,1],["يَا مَنْ فَتَحتَ على الحياةِ عيوننا","وبنيتَ جيلاً صادقاً متفاني",12,"ن",2,0],["يا مَن فَرَضت جَفاكَ ناوي فِعله","فَالصّبرُ فَرضُ العاشِقينَ وَقد نَوي",13,"و",2,0],["يا من في حمد مزاياهُ","وذكاه تتيه الأذهانُ",14,"ن",1,0],["يا مِنْ فُتِنْتُ بهِ حُبّاً بِمَنْطِقِهِ","الدُّرُّ والشَّهْدُ نَفْحُ الطِّيْبِ فِيْ فِيْهِ",15,"ي",2,0],["يا من فؤادي في وصال جمالهم","ما زال في طمعٍ وفي إشفاقِ",16,"ق",1,0],["يا من فؤادي حيث كانوا ربعهم","لخيالهم قصر عليه مشيد",17,"د",1,0],["يا من فرائد نظمه","أمست قلائد في النحور",18,"ر",1,0],["يا من فؤادي وثقا","برعيه للموؤق",19,"ق",1,1],["يا من فُجِعْتُ به وكنت أُعِدُّه","عوناً إذا طرقت صروف زماني",20,"ن",2,0],["يا من فرعتُ بمدحه قُنَنَ العُلا","وغدوتُ في هضباتها أتنقل",21,"ل",1,0],["يا من فطرت على الإقدام قد نشأت","فيك الخلال على عدل وإقدام",22,"م",1,0],["يا من فضح الأراك عطفاً","والريم سوالفاً وطرفا",23,"ف",2,1],["يا مُنفِذاً ماء الجُفو","نِ وَكُنتُ أنفِقُهُ عَلَيهِ",24,"ه",1,1],["يا من فتنت بني باريس قاطبة","بما يزينك من خلق واخلاق",25,"ق",1,1],["يا من فُؤادي يُصلي","بحرّ شمس جمالك",26,"ك",1,1],["يا مَن فدت نفسه أَوطانه كرما","هَلّا فداك لدن حمّ القَضا فادِ",27,"د",1,0],["يا من فلا غير أخلاقه","ولا تناهى في علو المقام",28,"م",1,1],["يا من فلا يثنيه إلا صفحه","لو رام يجزي ناكثا ومريبا",29,"ب",2,0],["يا من فقدت اصطباري بعدهم وجنى","عيشي لبعدهم مرت مطاعمه",30,"م",2,1],["يا مَن فضائلهُ بتاريخٍ رَقت","عند المسيح اشفع بنا مع مريما",31,"م",2,0],["يا من فؤادي أسير في بيوتهم","يعل فيهم بكاسات الأسى جرعا",32,"ع",2,0],["يا مَن فَجَرت الحُسن في عالم","مِن جُندك القَلب وَمِن جُنده",33,"د",2,0],["يا من فقدتُ سروري بعدَ بُعدهمُ","قد صارَ بعدَكُمُ طولُ الأسى سَكَنا",34,"ن",2,1],["يا من فؤادك من هم الهوى فاضي","ولم تري ما أقاسيه بحببك",35,"ك",1,1],["يا من فتاويه إذا أبرزت","يكاد ذا فهم بها أن يهم",36,"م",1,0],["يا من فرشت له الفؤاد منابرا","يصطاد فيها رقتي وجوارحي",37,"ح",2,0],["يامن في قلبي مسكنه","لن تخشى يوما تفقده",38,"د",2,0],["يامن فتحتُم لإسرائيل أذرعكم","أختًا وذاعَ لكم في وصلها وُدُّ",39,"د",1,0],["يا منفقًا كذبًا مُحَلَّى بالدموع",".. غسلتَهُ وملأتَ منه جِراركْ",40,"ك",1,0],["يَا مَنْ فَلَقْتَ لِمُوسَى البَحْرَ فَانْفَجَرتْ","مِنْهُ العُيُونُ أَيَا رَبَّاهُ فَانْتَقِمِ",41,"م",1,0],["يا مَنْ في الروحِ توسّدُهُ","وغرامُ القلبِ يهدْهِدُهُ",42,"د",2,1],["يا من في الكيدِ لهُ سُبُلٌ","المكرُ الماحقُ يَحسدُهُ",42,"د",2,0],["يا من فضيلة نِعمَ الذخر تورثه","في نفسك اليوم إن أحسنت آثارا",43,"ر",2,0],["يامن فُتنت بهِ طيفًا يُسامرني","أمسى بعيدًا ... قَريبًا من لظى الوجدِ",44,"د",1,0],["يا مَنْ فَسِيحُ الدَّهْرِ فِي غاياتِهِ","أَضْحَى لِسابِقِ مَجْدِهِ مَيْدانا",45,"ن",2,0],["يا مَنْ فتَحْتُمْ لأمْريكا منازلَنا","قفوا على مِنْبر التاريخ ِواعْتَرِفوا...!",46,"ف",3,0],["يا مِنْ في الروح أداريه","والقلب ملاذ يؤييه",47,"ي",2,1],["يا من فتنت بحسنها وجمالها","الله أعلم كمْ شقيتُ وأدرَى ؟",48,"ر",2,0],["يا من فضضت تنسُّكي أوقعت بي","وأراك تدعو للهوى النُسَّاكا",49,"ك",2,0],["يا مَن فَجَعْتَ محبتي بِقِلاكا","اعطف قليلاً ريثما أنساكا",50,"ك",2,1],["يا من فهمتَ الدَّين فَهماً كاملاً","وتَبعْتَ عقلك واشتعلْتَ نِضالا",51,"ل",2,0]]}