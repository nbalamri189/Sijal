{"poems":[[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58453","الخفيف"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112298","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85031","المديد"],[5943,"اهطلْ فنبضُ القلبِ صوتَكَ يعشقُ","https://www.poetsgate.com/ViewPoem.aspx?id=34655",""]],"verses":[["أهطُلُ الكدَّ والسّماقينِ بالفَيْ","سِ وما أَن أكيفهم شطرَ مَرْد",0,"د",1,0],["آهِ طِيبُ العيش عني نَزَحَا","وَجيوشُ الهمّ سَدّت طُرُقي",1,"ي",1,1],["آهٍ طولَ البُعدِ عَن غَنَجٍ","كادَ يَحكي الطولَ مِن شِعرِهِ",2,"ر",2,0],["اهطلْ فنبضُ القلبِ صوتَكَ يعشقُ","والحلْمُ بينَ خيوط ِهطلِكَ يُورِِقُ",3,"ق",1,1]]}