{"poems":[[93,"تحيّة الشام","https://www.poetsgate.com/ViewPoem.aspx?id=53441",""],[99,"الجمال الضنين","https://www.poetsgate.com/ViewPoem.aspx?id=17270",""],[406,"خير أمة","https://www.aldiwan.net/poem10301.html","عموديه"],[482,"با أدمعي في رسمها الجاري","https://www.aldiwan.net/poem15193.html","الرجز"],[1354,"","https://poetry.dctabudhabi.ae/diwan/poem/205981",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100246","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69907","البسيط"],[4692,"على لسانها","https://www.poetsgate.com/ViewPoem.aspx?id=186876",""],[4988,"الخوالد تاريخ وبطولات","https://www.poetsgate.com/ViewPoem.aspx?id=182806",""],[5045,"سيرة نظالي","https://www.poetsgate.com/ViewPoem.aspx?id=185176",""],[5431,"أهواك حيّا ..","https://www.poetsgate.com/ViewPoem.aspx?id=196754",""],[709,"خَلَطَ الْغَرَامُ الشَّجْوَ فِي أَمْشَاجِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=2934",""],[5525,"زلة المحبوب","https://www.poetsgate.com/ViewPoem.aspx?id=908",""],[5748,"طَرَقَتْ على عِلل الكرى أَسماءُ","https://www.poetsgate.com/ViewPoem.aspx?id=26031",""],[6056,"الجادل المختال","https://www.poetsgate.com/ViewPoem.aspx?id=130360",""]],"verses":[["با أدمع حور الجنان ذرفنها","شوقا ، ولم تملك لهنّ إيابا",0,"ب",2,0],["با أيها الكوكب المحبوس في فلكٍ","مبددٌ مجده فيه مضيّعُه!",1,"ع",2,0],["با ابنَ هذي الأرضِ حيَّاكَ حَيَاها","ودعاكَ الزَّهْرُ فيها أنْ تَشُمَّهْ",2,"م",2,0],["با أدمُعي في رسمِها الجاري","أوضحتِ للّوامِ أخباري",3,"ر",2,1],["با الا هِي ابفضلك اتمده","لين يدرك كِلّْ غاياته",4,"ت",2,0],["با ابن الأولى نشأوا جوارح للعلى","توسي الجراح وللعدو جراحا",5,"ح",2,0],["با آلَ غَنطوز دُمتم بِالحبور عَلى","كرِّ الدهورِ بِصَفوٍ لا يَرى كَدرا",6,"ر",2,0],["با الله ماذا صار منذ تركتني","وأنا أكابد في الهوى لقياكَا",7,"ك",2,0],["با ارض الحسا دارت رحى الموت والويل","مع ماجد عريعر شبابٍ وشيبان",8,"ن",1,0],["بااغير واثور واهجم ياجناحي صف","نزحف على المعتدي لاحيث أواكيرة",9,"ر",2,0],["بااشتهاءات المراعي","راعدا تأتي دويّا",10,"ي",2,0],["با ابنَ الّذي سادَ الأنامَ ونجلَ منْ","فاقَ الملائكَ في علا أدراجهِ",11,"ج",2,0],["با أخطي .. وأعيد الخطا وأتوب","والصاحب .. اللي علي يصبر",12,"ر",1,0],["با ابن الذي علمت معد فضله","وسوى معدّ فيه وهي سواءُ",13,"ا",2,0],["با أدوّر لي على فيّ ٍ زهقت الحِلّ والترحال","تعبت من الظعون وشيلها ومن كثرة الوقفه",14,"ف",2,0]]}