{"poems":[[74,"سرى والدجى كالصدر بالهم ملآن","https://www.aldiwan.net/poem20168.html","الطويل"],[53,"لعدوك الحد الأفل","https://www.aldiwan.net/poem65918.html","مجزوء الكامل"],[45,"ما أجدر الأيام والليالي","https://www.aldiwan.net/poem10139.html","الرجز"],[46,"نوار في صواحبها نوار","https://www.aldiwan.net/poem30523.html","الوافر"],[146,"شدوا على ظهر الصبا رحلى","https://www.aldiwan.net/poem58410.html","السريع"],[193,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[281,"هل عند عمرة من بتات مسافر","https://www.aldiwan.net/poem2239.html","الكامل"],[290,"قدر تم فبسطتم سحب حلمكم","https://www.aldiwan.net/poem39426.html","البسيط"],[358,"لعدل إله العرش أشكو ظلامتي","https://www.aldiwan.net/poem39788.html","الطويل"],[369,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[408,"لعدلك قد وجهت يا بن محمد","https://www.aldiwan.net/poem46922.html","الطويل"],[443,"بين العذيب فبانه المتناوح","https://www.aldiwan.net/poem2620.html","الكامل"],[463,"لعدو حسنك ما لسمع العاذل","https://www.aldiwan.net/poem56068.html","الكامل"],[556,"ما أساء الزمان فيك الصنيعا","https://www.aldiwan.net/poem47714.html","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87245","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64521","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64417","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108710","الوافر"],[2705,"","https://poetry.dctabudhabi.ae/diwan/poem/128652","المنسرح"],[3022,"","https://poetry.dctabudhabi.ae/diwan/poem/120164","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65147","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92071","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125808","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54391","المجتث"],[4806,"حبيبي وحياتي","https://www.poetsgate.com/ViewPoem.aspx?id=188630",""],[5749,"اصل لمحبة","https://www.poetsgate.com/ViewPoem.aspx?id=177112",""],[5790,"قدست من ملكٍ عظيم الشان","https://www.poetsgate.com/ViewPoem.aspx?id=111870",""]],"verses":[["لعدلهمُ صلح الضراغم والظبا","وبين الندى والوفر عبسٌ وذبيان",0,"ن",1,0],["لعدوّك الحدُّ الأفلُّ","ما عِشْتَ والخدُّ الأذلُّ",1,"ل",1,1],["لَعَدَّها مِن شَبَكاتِ المالِ","بَينَ قُضاةِ السَوءِ وَالأَطفالِ",2,"ل",1,0],["لَعَدَّلَ قِسمَةَ الأَرزاقِ فينا","وَلَكِن دَهرُنا هَذا حِمارُ",3,"ر",1,0],["لعدوّه وما للصديق به","والغيثُ رزقُ الحَزِن والسهلِ",4,"ل",1,0],["لَعَدلت آلافَ ألفٍ زائده","فَاِنظر إذاً كم ذا بِها مِن فائده",5,"ه",1,0],["لِعِداتِ ذي أَرَبٍ وَلا لِمَواعِدٍ","خُلُفٍ وَلَو حَلَفَت بِأَسحَمَ مائِرِ",6,"ر",1,0],["لعدلكم هاشم قد هشم الجور وام","تد الهناء وصار الصيت للسلم",7,"م",1,0],["لِعَدل إله العَرش أَشكو ظلامتي","بِأَحكام عادٍ مِن بَقيّة عادِ",8,"د",1,1],["لَعِدلِهِ مُستَأسِرُ آسادُهُ","وَعرُ السُطا بَحرُ النَدى بَدرُ النَدى",9,"د",2,0],["لِعدْلِكَ قد وجَهتُ يا بن محمّدٍ","شكاتي عن حُزنٍ مراجلُه تَغْلي",10,"ل",2,1],["لعدوّه ووليّه من كفّه","سعد السعود وذاك سعد الذابح",11,"ح",1,0],["لعدوِّ حسنِكِ ما لسمعِ العاذلِ","منّى إذا ما قام فيكِ مجادلي",12,"ل",2,1],["لَعَددنا منهُ العطاءَ اِبتزازاً","وحسبنا الغروبَ منه الطُّلوعا",13,"ع",2,0],["لِعَدلك يَشكو ما يُلاقي نِيابةً","عَن العَبد يا صَدرَ الصُدورِ كِتابُ",14,"ب",1,1],["لعدلك أشكو يا قدير مظالماً","عجزتُ لها من ظالم ذات قدرتي",15,"ي",1,1],["لعدوه تقصيراً وجرماً ومأثما","إلى الحق اخلاصاً وأخذا بحبله",16,"ه",1,0],["لعدوا بحكم العدل ذا العدل مأثما","وتلك بفضل العلم أهنى الموارد",16,"د",1,0],["لعدلك يا نديم الملك نشكو","فعدلك ناصرٌ لمن استجارا",17,"ر",2,0],["لعدلِها وصفاءِ مَورِدها","اللَهُ كافِلُها وناصِرُها",18,"ر",3,0],["لعدمتُ آدابى وحسن تجلدى","إن صدنى قول البغيض الأحمق",19,"ق",1,0],["لعدلك أشتكي من جُور دهر","يُبالغ في مُعاندتي اجتهاده",20,"د",2,0],["لعداك عيش مثل عيشي آسفاً","إني ذكرتُ على الزَمان تدانيا",21,"ي",2,0],["لعدوهِ في ذلة عن قومه","في شاغل من جهله في قالب",22,"ب",1,0],["لَعَدَمْتَ عمرَكَ حتّى","عَمَرْتَ هذي الدارْ",23,"ر",1,0],["لَعَد لو وصفتك ملاك اشيصير","وِلونك حليبي وبياضك زبد",24,"د",1,0],["لعداوة فلاصل محبة","ملي تظهر وتبان",25,"ن",1,1],["لعداه يوم عبيد عند لقائه","وله عليهم قدرةُ النعمان",26,"ن",1,0]]}