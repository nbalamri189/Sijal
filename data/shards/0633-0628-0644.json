{"poems":[[91,"وقفة ثم عتاب","https://www.aldiwan.net/poem44887.html","مجزوء الرمل"],[45,"إثلث فإنا أيها الطلل","https://www.aldiwan.net/poem10138.html","الكامل"],[107,"من يسعد الأوطان غير بنيها","https://www.aldiwan.net/poem43401.html","الكامل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/5177","الرمل"],[108,"رثاء طيارين!","https://www.poetsgate.com/ViewPoem.aspx?id=179490",""],[409,"وافى نظامك يا سعيد","https://www.aldiwan.net/poem33945.html","مجزوء الكامل"],[469,"ظبيات الحمى تخيف الأسودا","https://www.aldiwan.net/poem3169.html","عموديه"],[473,"وأهيف ان تثنى","https://www.aldiwan.net/poem60367.html","مجزوء الرمل"],[556,"يا طيف ألا زرتنا بسواد","https://www.aldiwan.net/poem47852.html","الكامل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101539","الكامل"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123365","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59395","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59393","الكامل"],[1166,"","https://poetry.dctabudhabi.ae/diwan/poem/131353","الخفيف"],[2234,"","https://poetry.dctabudhabi.ae/diwan/poem/111077","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109954","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83126","الكامل"],[4684,"حلاوة الإيثار","https://www.poetsgate.com/ViewPoem.aspx?id=201034",""],[4978,"تشعير","https://www.poetsgate.com/ViewPoem.aspx?id=177534",""],[5009,"جيل الصحوة","https://www.poetsgate.com/ViewPoem.aspx?id=68820",""],[5010,"شابت عزائمكم","https://www.poetsgate.com/ViewPoem.aspx?id=189866",""],[5072,"أنا ذاهب","https://www.poetsgate.com/ViewPoem.aspx?id=34444",""],[5419,"هي وقطتها","https://www.poetsgate.com/ViewPoem.aspx?id=52033",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5829,"شدو المستهام في مدح خير الأنام","https://www.poetsgate.com/ViewPoem.aspx?id=155538",""],[5829,"ما سواها زائل","https://www.poetsgate.com/ViewPoem.aspx?id=204861",""],[5977,"ضيف عزيز","https://www.poetsgate.com/ViewPoem.aspx?id=213258",""]],"verses":[["سبل العيش امامي","اينما سرت رحاب",0,"ب",1,0],["سَبَلٌ تَطولُ المَكرُماتُ بِهِ","وَالمَجدُ لا الحَوذانُ وَالنَفَلُ",1,"ل",1,0],["سُبُلُ المَكارِمِ لِلكِرامِ قَويمَةٌ","فَعَلامَ يُخطِئُها الَّذي يَبغيها",2,"ي",3,0],["سُبُلُ الآفاقِ تَنحو نَحوَها","بِاختِلافٍ مِن مَسافاتِ السُبُل",3,"ل",1,0],["سبل العلا قفراءُ مو","حشة كثيرةُ الالتواء",4,"ا",2,0],["سبل السلام مؤلف","جزءان يعشقه الرشيد",5,"د",1,0],["سبلٌ واحدٌ يعيد بنا ال","آمال والمال قائماً وحصيدا",6,"د",2,0],["سُبلُ المَلاحَةِ مِنهُ","تَضِلُّ فيها الصِفاتُ",7,"ت",1,0],["سَبَلٌ من الآباءِ لمّا غُيّبوا","في الأرض عنه أقامَ في الأولادِ",8,"د",1,0],["سبلتَ فوق العارضَين دموعاً","وأذبتَ من وهج الزفير ضلوعا",9,"ع",2,1],["سُبْل النجاة والمُناجاةِ ومَن","آوى إلى الفُلك وطورِ سِينا",10,"ن",2,0],["سَبَّلْتَ يَا مَوْلاَيَ سَبَّالَةً","ترجو بها الفَوْزَ بِدارِ السَّلاَمْ",11,"م",1,1],["سَبَّلْتَ مِنْ أجْلِ الرَّسُولِ وَقَوْلِهِ","مَاءً يُرَوِّي الصَّادِيَ المَتْبُولاَ",12,"ل",2,1],["سبلٌ سُدّدت عليك إذا ما","رحت من بردة الشباب سليبا",13,"ب",2,0],["سبل الهوى كم تاه سالكها","بهوى المهاة الكاعب الخود",14,"د",1,0],["سُبِلت على شمس الهُدَى الأَستارُ","واحتَفَّها رأدَ الضُحَى الإِسرارُ",15,"ر",1,1],["سُبُل العُلا ما تسلُكونَ وَإِنَّما","تَأوي الصعابَ مسالكُ العَلياءِ",16,"ا",2,0],["سبل التقرب للاله كثيرة","طوبى لمن سلك الفجاج وأبحرا",17,"ر",2,0],["سبُلُ الغيّ للقلوبِ شتاتٌ","ولها فيه رحمةٌ وإخاءُ",18,"ا",2,0],["سبل الغرب كلها جُحر ضب","وسبيل الإسلام كانت فجاجا",19,"ج",2,0],["سُبُلُ الْهُدَاةِ نَبَذْتُمُوْهَا خَلْفَكُمْ !","وَجَعَلْتُمُ سُبُلَ الْهَوَانِ هَوَاكُمُ !",20,"م",1,0],["سُبلُ البقاءِ أمامنا سُدَّتْ ولا..","يُجدي البقاءُ.. ولا المشاعرُ تنفعُ",21,"ع",1,0],["سبل السيادة والريا","دة والعتو مذللةْ",22,"ل",2,0],["سبلوا للمعركه صف اعجال","ممتطين للمهار السابقات",23,"ت",1,0],["سبل ٌ مفّرقة تلمّ شتاتها","والرب ُّ فرد والسبيل وحيد",24,"د",1,0],["سبل السماء تفتحت فاعرج بها","لم يبق دونك مانع أو حائل",25,"ل",1,0],["سبل الغواية والضلالة والردى","سدد إلهي خطوتي فيما بقي",26,"ق",2,0]]}