{"poems":[[65,"وحي من بني جشم بن بكر","https://www.aldiwan.net/poem45693.html","الوافر"],[79,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[79,"إليك مددت الكف في كل لأواء","https://www.aldiwan.net/poem36786.html","الطويل"],[32,"أراح فريق جيرتك الجمالا","https://www.aldiwan.net/poem29550.html","الوافر"],[74,"برغم العلى تاج تحلى به الثرى","https://www.aldiwan.net/poem18719.html","الطويل"],[74,"نعتوك حقا بالإمام لما حوت","https://www.aldiwan.net/poem19222.html","الكامل"],[53,"يبتُ أخو البلوى إذا الخلو غمضا","https://www.aldiwan.net/poem64946.html","الطويل"],[53,"أيها السيد الذي جل عن شكري","https://www.aldiwan.net/poem66516.html","الخفيف"],[47,"بين الشقيقة فاللوى فالأجرع","https://www.aldiwan.net/poem64692.html","الكامل"],[35,"ليالي أصبو بالعشي وبالضحى","https://www.aldiwan.net/poem25837.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85640","الطويل"],[47,"بين الشقيقة فاللوى فالأجرع","https://www.poetsgate.com/ViewPoem.aspx?id=2816",""],[41,"أَمِنْ دِمَنٍ بِشاجِنَة ٍ الحَجُونِ","https://www.poetsgate.com/ViewPoem.aspx?id=4310",""],[119,"لا تنبه بلوعتي اللواما","https://www.aldiwan.net/poem40595.html","عموديه"],[119,"مد من عينيك للقلب شرك","https://www.aldiwan.net/poem41101.html","عموديه"],[119,"عتبت على الدنيا عتاب لبيب","https://www.aldiwan.net/poem41243.html","عموديه"],[119,"مرض الطرف زاد لي أمراضي","https://www.aldiwan.net/poem41656.html","الخفيف"],[119,"نقشت في جبينها والمحيا","https://www.aldiwan.net/poem41658.html","الخفيف"],[119,"يا نبيا على الأنبياء","https://www.aldiwan.net/poem42164.html","الخفيف"],[151,"أمسعود جاء السعد والخير واليسر","https://www.aldiwan.net/poem47624.html","الطويل"],[173,"بع واسطاً بالنأي والهجر","https://www.aldiwan.net/poem1629.html",""],[203,"سائلوه متى يفيق الذي جن","https://www.aldiwan.net/poem45613.html","الخفيف"],[210,"سرور أزاح الهمّ والغمّ مذ بدا","https://www.aldiwan.net/poem916.html",""],[210,"لقد الجأتني دائرات الدوائر","https://www.aldiwan.net/poem922.html",""],[216,"عنطنطة غنجاء غرثاء بضة","https://www.aldiwan.net/poem37849.html","الطويل"],[216,"أرى قلمي فوق الصحائف يعبث","https://www.aldiwan.net/poem37902.html","الطويل"],[266,"لا تدعني فردا إلهي وحيدا","https://www.aldiwan.net/poem38355.html","الخفيف"],[309,"إذا شئت أن تحيا سعيدا مدى العمر","https://www.aldiwan.net/poem16761.html","الطويل"],[371,"شوقا إلى ذاك الجلال ومجتنى","https://www.aldiwan.net/poem17166.html","الكامل"],[396,"ياطالبا للوصيه","https://www.aldiwan.net/poem54448.html","عموديه"],[409,"سلام على أهل الحديث فإنني","https://www.aldiwan.net/poem33953.html","الطويل"],[438,"كتبت ومن لي أن تكون أناملي","https://www.aldiwan.net/poem12554.html","الطويل"],[443,"لهم طلل ما بين يبرين والحمى","https://www.aldiwan.net/poem2616.html","الطويل"],[447,"أحمل نفسي فوق ما لا تطيقه","https://www.aldiwan.net/poem14396.html","الطويل"],[463,"قالوا عساك مرجم فتبين","https://www.aldiwan.net/poem55859.html","الكامل"],[463,"مالي ولم أسبِق إلى الغنمِ","https://www.aldiwan.net/poem55868.html","أحذ الكامل"],[463,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[463,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[466,"عفا ضارج من آل ليلى فعاقل","https://www.aldiwan.net/poem15298.html","الطويل"],[505,"لا تعنف مولها أحمديا","https://www.aldiwan.net/poem37649.html","الخفيف"],[556,"ألا يا أيها الحادي","https://www.aldiwan.net/poem47850.html","الهزج"],[556,"أسخطتني فرضيت من كلف","https://www.aldiwan.net/poem48074.html","أحذ الكامل"],[563,"من مات يعلم أنك الحق المبين","https://www.aldiwan.net/poem33797.html","الكامل"],[563,"أتعبتني بقر الشام","https://www.aldiwan.net/poem34182.html","المديد"],[592,"لك الحمد اللهم يا ذا الحامد","https://www.aldiwan.net/poem11497.html","عموديه"],[592,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"],[592,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67829","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59410","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59433","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56196","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136197","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136336","الطويل"],[1500,"","https://poetry.dctabudhabi.ae/diwan/poem/146137","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77409","الخفيف"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46742","الوافر"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/83062","الخفيف"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107179","الوافر"],[2897,"","https://poetry.dctabudhabi.ae/diwan/poem/122225","الرجز"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74197","الكامل"],[119,"","https://poetry.dctabudhabi.ae/diwan/poem/105953","الخفيف"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131986","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36763","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114310","الرمل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102957","الوافر"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40104","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119667","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90847","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90800","الرمل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133187","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133111","الوافر"],[4858,"دعاء بلسان ولدي ( إسلام ) وهو في السحن","https://www.poetsgate.com/ViewPoem.aspx?id=137669",""],[4929,"وضيفة الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=199553",""],[4935,"وقائلة أرك مع العذارا","https://www.poetsgate.com/ViewPoem.aspx?id=129279",""],[5121,"لذيذ الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=33869",""],[5173,"نزلنا بهذا القصر والنيل تحته","https://www.poetsgate.com/ViewPoem.aspx?id=169631",""],[5183,"رباه","https://www.poetsgate.com/ViewPoem.aspx?id=186597",""],[5183,"بين الهيمنة والهينمة","https://www.poetsgate.com/ViewPoem.aspx?id=180155",""],[5230,"أوصاف الخيل","https://www.poetsgate.com/ViewPoem.aspx?id=12271",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"على الحبر بحر العلم الحقائق","https://www.poetsgate.com/ViewPoem.aspx?id=128858",""],[592,"يلوم أناس أن نظمت رواية","https://www.poetsgate.com/ViewPoem.aspx?id=128818",""],[592,"إن الأمور التي الأعداء تبديها","https://www.poetsgate.com/ViewPoem.aspx?id=128826",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5956,"صوت البشير","https://www.poetsgate.com/ViewPoem.aspx?id=194402",""],[5956,"السجين برضائه","https://www.poetsgate.com/ViewPoem.aspx?id=207195",""],[4442,"نظرت فخانني حدسي وفكري","https://www.poetsgate.com/ViewPoem.aspx?id=171205",""],[6211,"أَعنِيهِ، لَيْسَ عَنْهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78533&r=&rc=15",""],[5490,"أهذا الصبح..؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81929&r=&rc=15",""]],"verses":[["وأَعناقٌ بِها صَيَدٌ قَديمٌ","تُواري العِزَّ بِاللَّمَمِ الجِعادِ",0,"د",1,0],["وأعَنْتَ أنْدَلُساً بكلِّ سَبيكةٍ","موسومَةٍ لا تعرِفُ التّدْليسا",1,"س",2,0],["وأَعِنِّي وَطَهِّرْنِي وَخَلِّصْ حَقِيقَتِي","إِلَيْكَ وَأَيِّدْ نُورَ سِرِّي وَمَعْنَائِي",2,"ي",1,0],["وَأَعناقَ الِظباءِ رَأَينَ شَخصاً","نَصَبنَ لَهُ السَوالِفَ أَو خَيالا",3,"ل",2,0],["وأعناق أحرارٍ تملك رقّها","وأحوال قوم قبل ما مات دبرا",4,"ر",2,0],["وأعنت أرباب المقاصد شافعاً","لهم فأهلاً بالإمام الشافع",5,"ع",1,0],["وأُعنَى وأُغرى بالخضابِ ممرِّضاً","شباباً مريضاً حقُه أن يُمَرَّضا",6,"ض",2,0],["وأَعنِّي على قضاء ديونٍ","فَرَّقَتْ بين طَعْم نَوْمي وجَفْني",7,"ن",2,0],["وَأَعِنَّةُ الإِسلامِ في يَدِ حازِمٍ","قَد قادَها زَمَناً وَلَم يَتَزَعزَعِ",8,"ع",1,0],["وَأَعناقُها أَعناقُ غِزلانِ رَملَةٍ","وَأَعيُنُها مِن أَعيُنِ البَقَرِ النُجلِ",9,"ل",1,0],["وأعني بليلى موطناً ما ذكرته","على البعد إلا كان دَمعي له دفق",10,"ق",1,0],["وَأعِنّةُ الإسْلامِ في يَدِ حازِمٍ،","قَدْ قادَها زَمَناً، وَلمْ يتَرَعْرَعِ",11,"ع",1,0],["وأعناقٍ حنينَ لغيرِ أونِ","قطَا قربٍ تروَّحَ عنْ فراخٍ",12,"خ",1,0],["واعنائي من معرض ذي دلال","متأب عن ان يرد السلاما",13,"م",2,0],["واعنائي من تثنى خصره","هو والرمح على طعني اشترك",14,"ك",1,0],["واعنت فؤادي باللئام ولم ازل","لهم هدفا يرمي بكل عجيب",15,"ب",1,0],["وأعنائي من جؤيذر شيخ","مكثر العتب مكثر الأعراض",16,"ض",1,0],["وأعنائي منها غزالة سرح","أخذت مذهب الهوى مالكيا",17,"ي",2,0],["وأعني على زماني فإني","لك دون الوجود صح التجائي",18,"ا",2,0],["وأعني به شيخ الأنام وشيخ من","له عمة في عذبة وله الصدر",19,"ر",1,0],["وَأَعَنتَ قُطّاعَ الطَريقِ عَلى","فَقرِ التِجارِ وَخَيبَةِ السَفرِ",20,"ر",1,0],["وأعني على العزاءِ فقلبي","ثاكلٌ واصطبارهُ مثكولُ",21,"ل",1,0],["وأعني به عبد العزيز الفتى الذي","بدُرِّ المعاني والعلوم تقلدا",22,"د",2,0],["وأعني به إبراهيم بن محمّد","حميد السجايا بل جميل العناصر",23,"ر",1,0],["وأعني سليمان بن يحيى فلا لَهُ","حياءٌ ولا تدنو حِماه القَبائِلُ",24,"ل",1,0],["واعني ابنَ مسعود علياً وناصراً","أميرين ذا عمرو وهذا المرغَّثُ",25,"ث",1,0],["وأعني على زمان كأن ال","حظ في ليل همه أضغاث",26,"ث",1,0],["وَأَعنى بِهِ مَن لَيسَ يَنعَتُ غَيرَهُ","بِحَجَّةِ إِسلامٍ فَيا لَكَ مِن فَخرِ",27,"ر",1,0],["وَأَعَنتُهُ بِمَدامِعي مِن خيفَةٍ","أَن يَستَخِفَّ الريحُ مَحمَلَ تُربَةِ",28,"ه",1,0],["واعن بتطهير سر من كل عجب وكبر","ومن رياء ومكر وحب هذى الدنيه",29,"ه",1,0],["وأعني بهم أسلاف أمةِ أحمد","أولئك في بيت القصيد هُمُ قصدي",30,"د",2,0],["وأعني أبا عبد الإله فإنه","أبرُّ وأوفى في الأصادِق والصّحْبِ",31,"ب",1,0],["وأعناض أرض الشام دارا وإنما","بها الفضل منّاع الفتى أن تقدّما",32,"م",2,0],["وأعنق للحسنى امرأ غير محسن","ومن سوء تدبيري كأني عتيقه",33,"ق",2,0],["وأعن على إدراكها فبمثلها","فرّقتُ بين موفَّق ومحيَّنِ",34,"ن",1,0],["وأعِن ضميري فيه يا لَسَني","بغرائبٍ يُفصحنَ بالعُجْمِ",35,"م",1,0],["وأعنْ على دنيا حملتُ ثقيلَها","بك مع تلاشي بنيتي وتهدُّمي",36,"م",2,0],["وأعِنْ وتمّمْ ما ابتدأتَ به","فالبعض مرتَهَنٌ على الكُلِّ",37,"ل",1,0],["وإعناقُهُم إثْرَ القنيص وعندهُمْ","خواذلُ منْ غِزلانهمٍ ومَطافلُ",38,"ل",1,0],["وأعنتُ المحبِّ باللهِ حتى","ثار من ضعفه المُلحّ قويّا",39,"ي",2,0],["وأعناقُ المطايا مِنْ","كلالٍ بين إعضادِ",40,"د",1,0],["وَأَعَنْتُمُ عَمداً وَعَن خطأٍ","غِيَرَ الزّمان عليَّ والنُّوَبا",41,"ب",2,0],["وأعن وثبتنا عن سنن الهدى","دنياً وآخرةً كما ترضى ودينْ",42,"ن",1,0],["وا عنائي كم أعلمهم","ثم ألقى جهلهم نامي",43,"م",2,0],["وأعني بهم من هاجروا وتبؤوا","بدخنة داراً قد زهت بالمساجد",44,"د",1,0],["وأعني ابا العباس حيث نظمته","وذا حاصل التقرير من قول أحمد",45,"د",1,0],["وأعني به الحبر بن يتيمة الرضى","وفي بعضها جاءت عضال الزلازل",46,"ل",1,0],["وَأعْنَاقُهُمْ ذَلَّتْ فَأَنْجَزَهَا الْمَطُّ","عَطُوفٌ عَنِ الْجَاني يَجُودُ بِحِلْمِهِ",47,"ه",1,0],["وأعني على تعلل صبري","ربما ساعد العليل العليلا",48,"ل",2,0],["واعنه وانصره نصرا عزيزا","وأنله النوال والتنويلا",48,"ل",2,0],["وأعنه وانصره نصرا عزيزا","وأجره من كيد كل معادي",49,"د",2,0],["وأعنه على القيام بأمر","شئته منه واعضد الأنصارا",50,"ر",2,0],["وأعنت لنا عن فضل مولىً أعارها","بهاءً وأولاها سناءً وزوّدا",51,"د",2,0],["واعني بمن قدمت حامل سر من","تقدم من اسلافه القادة الغر",52,"ر",1,0],["واعني به نجل المهذب سالم","عليا له من خمرة الحب كاسان",53,"ن",1,0],["وأعنّ على برد الشتاء بحبةّ","تذر الشتاء مقّيداً مسجونا",54,"ن",2,1],["وا عَنااي لزعمها نهجها الح","ق فيا ليت لاعداها عناها",55,"ا",3,0],["وَأعَنتُمُ أعدَاءَكُم بِوفَاقِكُم","لَهُمُ عَلَى شَيءٍ مِنَ البُطلاَنِ",56,"ن",1,0],["وَأَعِنّي عَلى العَدُوِّ الغَريبِ","وَأَجِرني مِنَ العَدوِّ الغَريبِ",57,"ب",1,0],["وَأَعناقاً عَلَيها الدرُّ بيضاً","وأعجازاً لَها رُدُحاً ثِقالا",58,"ل",2,0],["وَأَعِنّي على رِضاكَ وَخِر لي","في أُموري وَعافِني واعفُ عَنِّي",59,"ي",1,0],["وَأَعنِي عِلمَ شَرعِ اللَّهِ فينا","وَلا أَعنِي بهِ عِلماً لِعَصرِ",60,"ر",1,0],["واعن بقول الشعر فالشعر كما","لٌ للفتى إن به لم يرتزق",61,"ق",1,0],["وَأَعنه في الدارين وَاجعل سيدي","بِجوار خَير الأَنبياء دِياره",62,"ر",2,0],["وأعنه بهمةٍ وأمان","وشهود بنظرة وعيان",63,"ن",1,0],["وأعنهم بنور سر وعقل","وأكرم المسلمين طرا بفضل",63,"ل",1,0],["وأعنه عند بكائه","إن شح جفنه أو نضب",64,"ب",1,0],["وَأَعني بِهِ شَيخَ الفَتاوى أَبو ال","سعُود سَقاهُ اللَهُ مُرفِدَ آلِهِ",65,"ل",2,0],["وَاعْنَ بِالإنِصَافِ فَإلاِنْصَافُ مِنْ","شِيَمِ الأشْرَافِ مِنْ دُونِ الجَدَلْ",66,"ل",1,0],["وأعناق بها صعر قديم","تواري الغر باللم الجعاد",67,"د",1,0],["وأَعَنْتُ ضُلّالَ الشّآ","مِ عَلى الضَّلالِ المُشتهرْ",68,"ر",1,0],["وأعِن فتىً يرجوكم لملمّةٍ","ولأنت بعد اللَه خير معين",69,"ن",1,0],["واعنهم بالنصر منك على العدا","إذ أنت يا اللَه خير معين",70,"ن",1,0],["وأعنائي بقسي من حوا","جب ترمي بسهام القدر",71,"ر",1,0],["وأعني به الموت الفظيع فآنه","ملاقيكم تباً لعاص وشارد",72,"د",1,0],["وأعنى الغانيات به فكلا","بل الملحوظ ما قصدي انكتامه",73,"م",2,0],["وَأَعِنّي أرفعْ بينَهُمُ","للحقِّ مشاعِلَ أَعلاما",74,"م",2,0],["وأَعَنُ مَنْ قَدَّسُوْهُ ومَنْ","بِهِ سَبَّحُو ا بُكْرَةً وأَصِيْلَا",75,"ل",2,0],["واعني بالنهار جمال خد","حوى في روضه ماء نارا",76,"ر",2,0],["وأعنابٌ على ثغري","كأنّي ذقْتُ ترياقا",77,"ق",2,0],["وأعني به شيخي البراوي من به","تحلى زمان العز في الجيد بالعقد",78,"د",1,0],["وأعنه للنهج القويم لعله","يفضي إليك بزمرة الشهداء",79,"ا",2,0],["وأعنه يا متعاليا في عزه","ما قام للقرآن في عليائه",80,"ا",3,0],["واعناقها ماهن عراض وقصيرات","طويلة ٍ والكتف مالصّقن ٍ له",81,"ل",2,0],["وأعني به البدر المنير محمد","ووافق أهل الزيغ والطرد والجحد",82,"د",1,0],["وأعني به من كان للناس قدوة","إذا دهتهم من ملحد أو منافق",83,"ق",1,0],["وأعنى به البحر الخضم بن حنبل","إماماً هماماً عالماً أي عالم",84,"م",1,0],["وأعنقوا لهوى من ليس عندهمو","علم بخافظها يوماً وساميها",85,"ي",3,0],["وأعنى به من كان يغلو بدينه","دع القول بالمكروه والفحش والزلل",86,"ل",1,0],["وأعنى به ذاك الإمام ابن قيم","وقرر في الأعلام ذاك فأحكما",87,"م",2,0],["واعٍ نبيلٌ يحب الخير يشمله","ويشمل الناس في أبها وفي صفَدِ",88,"د",1,0],["وأعنابٌ وعِنّابٌ وتِينٌ","وللآفاق عندكمُ انطلاقُ",89,"ق",1,0],["وأعناق البرية في قيادي","وأصناف الخليقة طوع أمري",90,"ر",2,0],["وأعني الذي أفضالُهُ نَسْتَزيدُها","ولا فضْلَ مِنْ كَفِّ الذي زادُهُ البُخْلُ",91,"ل",1,0],["وأعنقَ صبحُنا حتى اشرأبّا","وصبّ النورَ من فوديه صَبّا.",92,"ب",2,0]]}