","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44722","الرجز"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119633","الرجز"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119615","السريع"],[4085,"","https://poetry.dctabudhabi.ae/diwan/poem/105155","السريع"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127248","السريع"],[4122,"","https://poetry.dctabudhabi.ae/diwan/poem/111114","الرجز"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105133","الرجز"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93774","المنسرح"],[4233,"","https://poetry.dctabudhabi.ae/diwan/poem/143564","البسيط"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138723","البسيط"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35055","السريع"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4465,"","https://poetry.dctabudhabi.ae/diwan/poem/146405","السريع"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35459","المجتث"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33449","السريع"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120556","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120516","السريع"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102009","البسيط"],[4680,"وهبتك العمر","https://www.poetsgate.com/ViewPoem.aspx?id=185008",""],[4722,"وأول الفرض إيمان الفؤاد كذا","https://www.poetsgate.com/ViewPoem.aspx?id=26471",""],[4755,"صَدَاكِ ما أَبقَيتِ مِن عَافِيَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=183621",""],[4755,"قَصِيدةٌ أُخرَى وجُرحٌ جَدِيدْ","https://www.poetsgate.com/ViewPoem.aspx?id=184116",""],[4755,"عَوْدٌ على بَدءٍ فَصَبرٌ جَمِيلْ","https://www.poetsgate.com/ViewPoem.aspx?id=184682",""],[4755,"فَتِّشْ معي يا ابنَ أمِّي عَن ظِلالِ أبي","https://www.poetsgate.com/ViewPoem.aspx?id=184808",""],[4755,"قَصِيدةٌ أُخرَى وجُرحٌ جَدِيدْ","https://www.poetsgate.com/ViewPoem.aspx?id=191250",""],[4755,"قالت: تَوَضَّأْ مِن دُمُوعِي.. وصَلّْ","https://www.poetsgate.com/ViewPoem.aspx?id=200782",""],[4755,"مأساة سُهَيل اليَمَاني ( 5 )","https://www.poetsgate.com/ViewPoem.aspx?id=210758",""],[4767,"مخابز","https://www.poetsgate.com/ViewPoem.aspx?id=180939",""],[1663,"الى امرئ نصبت قحطان رايتها","https://www.poetsgate.com/ViewPoem.aspx?id=93229",""],[4578,"يا من سمت بمعانيه قوافينا","https://www.poetsgate.com/ViewPoem.aspx?id=49532",""],[5135,"رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=203352",""],[5147,"مددنا بصائرنا لا العيونا","https://www.poetsgate.com/ViewPoem.aspx?id=166673",""],[308,"سلوا الدموع فإن الصب مشغول","https://www.poetsgate.com/ViewPoem.aspx?id=118851",""],[5477,"حمداً من ردّ أهل الزيغ والزلل","https://www.poetsgate.com/ViewPoem.aspx?id=124908",""],[5582,"بَكَى وَناحَ غَراماً فِي الهَوَى ناحَا","https://www.poetsgate.com/ViewPoem.aspx?id=186790",""],[5582,"عُوجُوا فَحَيُّوا مَغانِي رَبَّةِ الخالِ","https://www.poetsgate.com/ViewPoem.aspx?id=63561",""],[5759,"نشيدُ الغُربة","https://www.poetsgate.com/ViewPoem.aspx?id=214175",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5953,"عاذلتي في الشيب لو تعلم ما","https://www.poetsgate.com/ViewPoem.aspx?id=93807",""],[6088,"اقباس","https://www.poetsgate.com/ViewPoem.aspx?id=207586",""],[6142,"هي القلاص المراسيم المراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=155707",""],[6180,"عشرون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81083&r=&rc=17",""],[6221,"رحلة في دروب الذكريات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64919&r=&rc=3",""],[6225,"تلعثم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80962&r=&rc=231",""],[6344,"حرّ في قبضة العزلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87983&r=&rc=23",""]],"verses":[["وَلَم يَزَل بَعدَ يَومي","مِنّي عَلى الدَهرِ عَتبُ",0,"ب",1,0],["وَلَم يَزَل بِالمِحالِ يَخدَعُهُ","حَتّى أَتاها بِهِ عَلى قَدرِ",1,"ر",1,0],["وَلَمْ يَزَلْ خَيْرَ مَنْ صَانَ الجِوَارَ وَمَنْ","رَعَى الخَلِيقَ بِأَنْ يُرْعَى مِنَ الْحُرَمِ",2,"م",1,0],["ولم يزل تنويه تنويله","حتَّى حمى وجهي وأغناني",3,"ن",2,0],["ولم يزل يَضْمنُ عن ربّهِ","مذ كان رِزقَ الخائب الأَخيبِ",4,"ب",1,0],["ولم يزلْ جَلْداً شديدَ النحت","يُرْهِزُها من فوقها والتحتِ",5,"ت",1,0],["ولم يزل في مرج شكري مُمْرِجا","وفي ودادٍ لم يكن مُمَزَّجا",6,"ج",2,0],["ولم يزل عيبُ من قلَّت معايِبُهُ","يُحْصَى ويُترك ما قد أعجز العددا",7,"د",2,0],["ولم يزل يسبق الرجالَ ولا","يشقُّ ذو جُهدهم له غَبَره",8,"ر",2,0],["ولم يزل للإمام سَعْيٌ","بمثله تُحْرَز الرهان",9,"ن",1,0],["وَلَم يَزَل بِكَ واشيهِم وَمَكرُهُمُ","حَتّى أَشاطوا بِغَيبٍ لَحمَ مَن يَسَروا",10,"ر",3,0],["وَلَم يَزَل بِسُلَيمٍ أَمرُ جاهِلِها","حَتّى تَعَيّا بِها الإيرادُ وَالصَدَرُ",10,"ر",1,0],["وَلَم يَزل مُتَّبَعاً حَيث دَعا","لِلفاطِميِّ ظافِراً حَيث غَزا",11,"ا",1,0],["وَلَم يَزَل أَبو تَميم يَشتَهي","بَغدادَ وَالأَقدارُ دُونَ ما اِشتَهى",11,"ا",1,0],["وَلَم يَزَل إِسعافُهُم","لِيَ الحَياةَ مَذهَبا",12,"ب",2,0],["وَلَم يَزَل سَجِيَّتي","وَعَمَلي المُحَبَّبا",12,"ب",2,0],["وَلَم يَزَلِ المُحَبَّبَ وَالمُفَدّى","وَمَرهَمَ كُلِّ جُرحٍ وَالضِمادا",13,"د",2,0],["وَلَم يَزِدكَ كَرَسمِ الأَرضِ مَعرِفَةً","بِالأَرضِ داراً وَبِالأَحياءِ جيرانا",14,"ن",2,0],["وَلَم يَزَل لَكَ مُذ وُلّيتَ حَوزَتَها","غَوثٌ لِلَهفانَ أَو نَصرٌ لِمُهتَضَمِ",15,"م",1,0],["ولم يَزل مالُنا مُباحاً","من غيرِ ذُلٍّ ولا اهتِضامِ",16,"م",1,0],["ولم يُزرْ بغدادَ حتى إنَّها","بحرُ ندىً يحيا به روضُ الادب",17,"ب",1,0],["وَلَمْ يَزَلْ مُمْسِكَاً بِالدِّينِ جَمْرَتَهُ","حَتَّى يَمُوتَ عَلَى مَا اْخْتَارَ وَاْعْتَقَدَا",18,"د",2,0],["وَلَم يَزَل أَهلُ دِين اللَّهِ في نَصَبٍ","مِمّا يُلاقُونَ مِن كَربٍ وَمِن زَأَمِ",19,"م",1,0],["وَلَم يَزَل سَيِّدُ الكَونَينِ مُنتَصِباً","لِدَعوَةِ الدِّين لَم يَفتر وَلَم يَجِمِ",19,"م",1,0],["وَلَم يَزَل سائِراً حَتّى أَنافَ عَلى","أَعلامِ طَيبَةَ ذاتِ المَنظَرِ العَمَمِ",19,"م",1,0],["وَلَم يَزَل ذَلِكَ دَأبَ الناسِ","حَتّى أُغيثوا بِأَبي العَبّاسِ",20,"س",1,0],["وَلَم يَزَل في أَضيَقِ الحُبوسِ","حَتّى رَمى إِلَيهِمُ بِالكيسِ",20,"س",1,0],["وَلَم يَزَل دَهراً عَلى ضَلالِهِ","ذا بَطَرٍ لِجُندِهِ وَمالِهِ",20,"ه",1,0],["وَلَم يَزَل سُكّانُها فُجّارا","مُستَبصِراً في الشِركِ أَو سَحّارا",20,"ر",2,0],["وَلَم يَزَل لِلقَومِ شُغلاً شاغِلاً","وَأَصبَحَت جِبابُهُم مَناخِلا",21,"ل",2,0],["ولم يزل جلداً شديدَ النحتِ","ينيكها تحتاً وغير تحتِ",22,"ت",1,0],["ولم يَزلْ حتى انْتَحى جَيَّانا","فلم يَدَعْ بأَرْضِها شَيطانا",23,"ن",2,0],["ولم يَزَلْ لكَ صوتٌ كلما شرعوا","لها ذمَ البغي ثنَّاها على خجلِ",24,"ل",1,0],["ولم يزل للمنون جيش","تفل من ذكره الجيوش",25,"ش",1,0],["ولم يزلْ نزوله مفرقا","مشرقا به الحجاز مشرقا",26,"ق",2,0],["ولم يزل إسعافهم","لي في الحياة مذهبا",27,"ب",2,0],["ولم يزل تاجهم الكلامُ","والأمراء الصاغة الأعلامُ",28,"م",1,0],["ولم يَزَلْ قابضُ الدُّنيا وباسِطها","فيما يشاء له مَحْوٌ وإِثْباتُ",29,"ت",1,0],["ولم يزل لهمُ في كلِّ زاويةٍ","مُنوِّهٌ بمخازيهم ومُفَتخر",30,"ر",1,0],["ولم يزل واطىءُ أعقابهم","ينهَض حتى لم يجد مَنهَضا",31,"ض",2,0],["ولم يزل أمره ينمو بقدرته","حتى بدا واضمحل الكفر واستترا",32,"ر",2,0],["ولم يزل حاكما بالحق يمضيه","ومن أبي حكمه روى الثرى بدمه",33,"م",2,0],["ولم يزهك الملك الذي قد ملكته","ولا الجيش وافي خافقات بنوده",34,"د",2,0],["وَلَم يَزَل هَمُّهُ تَشييدَ مَجدِكُمُ","يَوَدُّ لَو أَنَّهُ أَوفى عَلى زُحَلِ",35,"ل",1,0],["وَلَم يَزَل صائِماً طَوعاً لِخالِقِهِ","وَبِالدُجى قائِماً في حِندِسِ الظُلَمِ",36,"م",1,0],["وَلَمْ يَزَلْ حُبُّها صَعْباً عَلَى أَرَبِي","فِيهِ المَنِيَّةُ إيراداً بِلا صَدَرِ",37,"ر",1,0],["وَلَم يَزَل لِصَنيعِ الخَيرِ مُلتَزِماً","فَنالَ أَرِّخ بِهِ غُفرانَ آثامِ",38,"م",1,0],["وَلَم يَزل نورُ النبيِّ الأكملُ","مِن سيّدٍ لسيّدٍ ينتقلُ",39,"ل",1,0],["ولم يزل ذلك الحق المبين به","يعلو وتسفل هاتيك الاباطيل",40,"ل",1,0],["ولم يزل نجمك شمس العلا","يبقى ويحيا ابد الدهر",41,"ر",1,0],["ولم يزل يشتري اعلى المحامد في","سوق الثناء باغلى الروح والثمن",42,"ن",1,0],["وَلم يَزَل إِلّا خَيالانِ","حَيّينِ وَالباقون أَشباحُ",43,"ح",1,0],["ولم يزل فيها عذاب المُجْتَرِي","فسل بنا آيَ الكِتاب تُخْبَرِ",44,"ر",1,0],["ولم يزل في معد ثم في مضر","وهاشم بك