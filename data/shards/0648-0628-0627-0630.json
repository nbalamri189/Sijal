{"poems":[[53,"وباذنجان محسي تراه","https://www.aldiwan.net/poem66702.html","الوافر"],[104,"يقولون في بيروت أنتم بنعمة","https://www.aldiwan.net/poem32940.html","الطويل"],[309,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[358,"أأنت أم أنا أم ما نلت من رتب","https://www.aldiwan.net/poem40818.html","البسيط"],[469,"لنا بسمر الحمى في الحي أسمار","https://www.aldiwan.net/poem3186.html","عموديه"],[469,"سرى وأقبل يقفو إثره القمر","https://www.aldiwan.net/poem3626.html","عموديه"],[556,"يوم الحمى ما أنت من همي","https://www.aldiwan.net/poem47212.html","أحذ الكامل"],[556,"شطت عليك لبانة الصدر","https://www.aldiwan.net/poem47783.html","أحذ الكامل"],[572,"متى تنشط للأكل","https://www.aldiwan.net/poem69479.html","الهزج"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104105","الوافر"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100147","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56360","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49580","البسيط"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96503","البسيط"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95395","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143855","الوافر"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28618","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83202","الرجز"],[4858,"مصر الحبيبة شيعي قتلاك","https://www.poetsgate.com/ViewPoem.aspx?id=144475",""],[4908,"مَهْد العُروبَة","https://www.poetsgate.com/ViewPoem.aspx?id=207384",""],[5338,"جفني لفقدك سهده فرض","https://www.poetsgate.com/ViewPoem.aspx?id=187597",""],[5956,"أتصور شقيقي المرحوم يقول لي:","https://www.poetsgate.com/ViewPoem.aspx?id=193451",""]],"verses":[["وباذنجان مَحْسِيٌّ تراهُ","يعومُ كعنبرٍ في دُهنِ بانِ",0,"ن",1,1],["وباذلُ هذا المال يعلم أنَّه","يسِّلم باليمنى إلى يده اليسرى",1,"ر",2,0],["وباذلها جواداً بها وسماحة","بكف نداها كالسحاب المواطر",2,"ر",1,0],["وَباذِلاً نَفسَ حرٍّ باسِلٍ أَنفٍ","نَدبٍ لِصَون حِمى العَلياء مُنتَدبِ",3,"ب",1,0],["وباذل المال فيه ما يضر به","وصاحب الصيت في الآفاق طيار",4,"ر",1,0],["وبإذلاه الكرى والفكر أعملهُ","ومانعاهُ حياءُ الوجه والخفر",5,"ر",1,0],["وَبِأذرُعٍ تَنهلُّ حامِلَةً","إمّا لِبيضٍ أو قناً صمِّ",6,"م",1,0],["وَبأذرعٍ تَهوي بمُصْلَتَةٍ","بيضٍ وطائشةِ الخُطا سُمْرِ",7,"ر",1,0],["وَبَاذِنْجَانِ بُورَانِ","بِهِ نَفْسُكَ مَفْتُونَهْ",8,"ن",2,0],["وباذنجان مثلِ كُراتِ ضَربٍ","تَضمّنها لُبابُ الجُلجُلانِ",9,"ن",1,0],["وباذل لفضاء الحكم خاتمه","جهلاً وفي نشر سر الكائنات ملي",10,"ل",2,0],["وباذل الجهد في الاقدام ممتدحٌ","والمبتغي راحةً بالذل ذاك غبي",11,"ب",2,0],["وباذخٌ لا تنالُ الطيرُ ذِرْوَتَهُ","حتى سَوَاءٌ به العِقْبَانُ والحجل",12,"ل",1,0],["وباذغيس التي من حل ذروتها","عز الملوك فأن شاجار أو ظلما",13,"م",2,1],["وباذنجاننا مصري وشامي","وبامتنا ولوبتنا البهيا",14,"ي",2,0],["وباذلَ أموالٍ لهُ الكفُّ مطلقٌ","وماسكَ أقوالٍ له الفمُ مُلجَمُ",15,"م",1,0],["وباذنجانةٍ حشيت حشاها","صغار الدرّ باللبن الحليب",16,"ب",1,1],["وَباذلو الخَيرَ لما يُسْأَلوا","وَباذلو الخَيرَ إِذا الخَيرُ سئلْ",17,"ل",1,0],["وَباذِلُ الآدابِ","كَباذِلِ التُرابِ",18,"ب",1,0],["وبإذن ربّي قاهرِ الأعداء","سيعود \" مُرسي \" رافعاً للواكِ",19,"ك",1,0],["وبإذنهِ يا مِصر يرجعُ مَجْدُنا","حَتَّى نَسُودَ الأرْضَ والأيَّامَا",20,"م",2,0],["وَبِإِذْنِه صَمَمٌ فَلِي شَرَفٌ","فِيمَا أَقُولُ وَإِنْ أَبَى البَعْضُ",21,"ض",1,0],["وبإذن ربك سوف يرزقنا معاً","جنات عدْن بعد دنيا خّيرةْ",22,"ر",2,0]]}