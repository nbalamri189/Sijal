{"poems":[[88,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[71,"مشتملا بالسيف قد زارني","https://www.aldiwan.net/poem28265.html","السريع"],[79,"جلا الحق قلبي حتى أنارا","https://www.poetsgate.com/ViewPoem.aspx?id=34133",""],[125,"بالواسعات أرى الأشواق تنهمر","https://www.aldiwan.net/poem23811.html","البسيط"],[208,"أكلت رمانة فعاتبني","https://www.aldiwan.net/poem53222.html","المنسرح"],[457,"لقد سقاني الحبيب كأسا","https://www.aldiwan.net/poem13789.html","مخلع البسيط"],[466,"وفتيان صدق من تميم تناثلوا","https://www.aldiwan.net/poem15083.html","الطويل"],[614,"","https://poetry.dctabudhabi.ae/diwan/poem/105270","السريع"],[1419,"","https://poetry.dctabudhabi.ae/diwan/poem/116692","المتقارب"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79969","البسيط"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128047","البسيط"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52103","المجتث"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103515","الطويل"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/141516","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114455","البسيط"],[5086,"تذكّرت ليلى حين شطّ مزارها","https://www.poetsgate.com/ViewPoem.aspx?id=202466",""],[351,"نَالَتْ عَلَى يَدِهَا مَا لَمْ تَنَلْهُ يَدِي","https://www.poetsgate.com/ViewPoem.aspx?id=4528",""],[5790,"سألت من أمرضني","https://www.poetsgate.com/ViewPoem.aspx?id=112144",""]],"verses":[["فقال: خِفتُ افتِتانِ المُسلمين به","وفِتنةُ النَّفسِ أعيَت مَن يُداويها",0,"ي",3,0],["فقالَ خائفاً كلامَ العدى","فيكَ وقدْ زرْتكَ بالسيفِ",1,"ف",1,0],["فقال خبأت لكم خمرة","تشح عليها النفوس الغيارا",2,"ر",2,0],["فقال خِِلِّيَ لا تُبْهِمْ لها حَذَرَاً","فقُلْتُ خُذْهَا جُزيتَ أنت لا حَذِرُ",3,"ر",1,0],["فقال خدُّ الحبيب تأكُلُه","فقلت لا بل أمصُّ من ريقِهْ",4,"ه",1,0],["فقال خُذْ ما بقى بكأسي","سُؤراً وأحسن بذاك سؤرا",5,"ر",2,0],["فقال خبيرُ القوم عامٌ بغبطةٍ","نديُّ الثرى والجوِّ غضُّ المراتعِ",6,"ع",1,0],["فقال خذ حذرك ما في البقا","من نظرة آنا ولا من نصير",7,"ر",1,0],["فَقَال خَرَجتُ وَقَاضِي القُضَا","ةِ مُنفَكَّةٌ رِجلُهُ مُؤلِمَه",8,"م",2,0],["فقالَ خذْ منصباً أُمُّ العُلى نصبتْ","أسرةً لكَ فيه الأنجم الزهرا",9,"ر",2,0],["فقال خلفته لو مات من ظما","والمنهل العذب منه بامتداديد",10,"د",1,0],["فقال خيراً تراهُ","واسمع لقوليَ هذا",11,"ذ",2,0],["فقال خليلي ما لخطِّك هكذا","دقيقاً ضيئلاً ما يكاد يبين",12,"ن",1,0],["فقال: خمرةُ ريقي كيف أبذُلُها","وأنت في الخمرِ بالتَّحريم تقترفُ؟!",13,"ف",1,0],["فقال خيرُ الورى اقطعُوا لسانَهُ عني","بالعطاءِ عطاءٍ غير ممنُونِ",14,"ن",1,0],["فقال خليلي إذ رأى الدمع دائما","يفيض دما من مقلتي ليس يدفع",15,"ع",1,0],["فَقَالَ : خَلَّفْتُهُ لَوْ مَاتَ مِنْ ظَمَأٍ","وَقُلْتِ : قِفْ عَنْ وَرُودِ المَاءِ لَمْ يَرِدِ",16,"د",1,0],["فقال خذها بالرضا","مني حلالا وابتسم",17,"م",1,0]]}