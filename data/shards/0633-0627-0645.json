,"البسيط"],[517,"إن حارت الأفكار كيف تقول","https://www.aldiwan.net/poem12199.html","الكامل"],[540,"صنعة الشعر لقد عافتك","https://www.aldiwan.net/poem47428.html","عموديه"],[553,"ما الحب إلا موئل المتعلل","https://www.aldiwan.net/poem47295.html","الكامل"],[555,"ما ضر من شغل الفؤاد ببخله","https://www.aldiwan.net/poem68347.html","الكامل"],[560,"ما اصطكاك الأجرام عند السماع","https://www.aldiwan.net/poem34384.html","الخفيف"],[569,"سامعة للهوى مطيعة","https://www.aldiwan.net/poem69603.html","مجزوء الكامل"],[577,"قالوا قضيب البان قد بانا","https://www.aldiwan.net/poem2840.html","السريع"],[577,"وصفتك واللاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"],[577,"تنسك شيطاني فيا ليته غدا","https://www.aldiwan.net/poem3081.html","الطويل"],[708,"","https://poetry.dctabudhabi.ae/diwan/poem/1908","الطويل"],[878,"","https://poetry.dctabudhabi.ae/diwan/poem/204420","الوافر"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/27094","الوافر"]],"verses":[["سامِحاً بِالقَليلِ مِن عَهدِ نَجدٍ","رُبَّما أَقنَعَ القَليلُ وَأَرضى",0,"ض",2,0],["سامٍ بِفَضلِ حَيائِهِ","وَالطَرفُ يوصَفُ بِالفُتورِ",1,"ر",1,0],["سَأَمضَغُ بِالأَقوالِ أَعراضَ قَومِكُم","وَلِلقَولِ أَنيابٌ لَدَيَّ حِدادُ",2,"د",1,0],["سامِحاً لي عَلى البِعادِ بِنَيلٍ","كانَ يَلويهِ في زَمانِ القُربِ",3,"ب",1,0],["سَأَمضي لِلَّتي لا عَيبَ فيها","وَإِن لَم أَستَفِد إِلّا عَناءَ",4,"ا",2,0],["سَامِي الذَّرَى مُتَمَنِّعٍ أَرْكَانُهُ","يَرْتَدَّ عَنْهُ الطَّرْفُ وَهْوَ ذَلُولُ",5,"ل",1,0],["سامَحتُ كُتبَكَ في القَطيعَةِ عالماً","أَنَّ الصَحيفَةَ أَعوَزَت من حامِلِ",6,"ل",1,1],["سامرتها الكواكب الزهز حتى","سمرت وسطها كواكب عسجد",7,"د",1,0],["سَأَملكُ نَفسي عَنكُم إِن مَلَكتُها","وَهَل أَغلِبَن إِلا الذي أَنا غالِبُ",8,"ب",1,0],["سَامِعُ آيَاتِهِ","يَأْخُذُ مِنْهُ الطَّرَبْ",9,"ب",1,0],["سَأَمْدَحُ هَذَا الْعِقْدَ مِنْكُمْ بِأَنَّهُ","عَدَتْهُ الْعَوَادِي وَهْوَ لا يَتَفَصَّمُ",10,"م",1,0],["سَامِي النَّقِيبَةِ مُغْرَمٌ","بَالبِرِّ مُغْرَى بِالمَكَارِمْ",11,"م",1,0],["ساموه خسفاً فاستجار بموته","كي لا تشان حياته بالعار",12,"ر",1,0],["سَإِمتُ مِنَ المُواصَلَةِ العِتابا","وَأَمسى الشَيبُ قَد وَرِثَ الشَبابا",13,"ب",2,1],["سَأَمتاحُ البُحورَ فَجَنِّبيني","أَذاةَ اللَومِ وَاِنتَظِري اِمتِياحي",14,"ح",2,0],["سَأَمنَحَهُ عَلى العِلّاتِ حَتّى","أَرى ماوِيِّ أَن لا يَشتَكيني",15,"ن",2,0],["سامح الله حسنكم يوم تأتو","ن وتلك الدماء في الأعناق",16,"ق",1,0],["سام وحام الثنا لكم صحفاً","وجاءَ في سامه وفي حامه",17,"م",2,0],["سامَ بهِ أهل العلا جميعاً","وادْفع ولا ردًّا ولا تفريعا",18,"ع",2,0],["سامعة لما تشير الأمّ","مع أنَّها مثل الحجار صمّ",19,"م",1,0],["سأمنحُهُ ذمِّي وأختصُّ حِزبَهُ","بأوفَى نصيب من قبيحِ ثنائِهِ",20,"ا",3,0],["سامَتْ قوافيك السما","ء ورُمتَ أمراً ذا مَهابَهْ",21,"ب",2,0],["سأمدح بعض الباخلين لعلَّه","إن اطّرَدَ المقياسُ أن يتَسمّحا",22,"ح",2,0],["سأُمْجدُ من هجائي في","هِ حُفَّاظاً ونُسَّاخا",23,"خ",2,0],["سامح أبا العبر المسكين في ولدٍ","يُعزَى إليه وكُنْه أيها العبر",24,"ر",1,0],["سامعٌ كل نبضةٍ في فؤادٍ","بفؤادٍ سمَعْمَعٍ نبَّاض",25,"ض",1,0],["سأمجِده من آجلٍ بعد عاجلٍ","ويمجدني من آجلٍ بعد عاجلِ",26,"ل",1,0],["سامية في مآربي هممي","نافذة في هواي أحكامي",27,"م",2,0],["سَإِمتُ الحَياةَ فَلَيتَ الحِمامَ","يُعيدُ إِلى أَصلِهِ سائِري",28,"ر",2,0],["سَإِمتُ لَذاذاتِ الحَياةِ جَميعَها","وَلَو رَضِيَت هِندُ سَإِمتُ شَبابِيا",29,"ي",2,0],["سَأَمُ هذه الحَيَاةُ معَادٌ","وصباحٌ يكرُّ في إثرِ ليلِ",30,"ل",1,0],["سَأَمضي وَالسَلامُ عَلَيكَ مِنّي","مَغيبي لَيلَتي وَغَداً إِيابي",31,"ب",2,0],["سأمنحُكمْ لِيناً إِذا ما قصدتُمُ","جنابيَ بالأيدي الطِوال الغواشمِ",32,"م",1,0],["سامٍ على صَهَواتِ مجدي والعِدى","متأخِّرٌ أو مُلجَمٌ أو شافِعُ",33,"ع",1,0],["سامَ بِالمَجدِ فَاشتَراهُ وَقَد با","تَ عَلَيهِ مُزايِداً لِلسَحابِ",34,"ب",1,0],["سامَرتُها بَرَشاً كَالغُصنِ يَجذِبُهُ","حِقفانِ مِن هائِلٍ بِالرَملِ رَجراجِ",35,"ج",1,0],["سامِرِيُّ الضُيوفِ مِن دونِ خُبزٍ","مَعَ بَيضِ الأَنوقِ لَيسَ يُمَسُّ",36,"س",1,0],["ساموكَ مِن حَسَدٍ فَأَفضَلُ مِنهُمُ","غَيرُ الجَوادِ وَجادَ غَيرُ المُفضِلِ",37,"ل",1,0],["سَأَمنَحُكَ الهَجرَ لا عَن قِلىً","وَلا أَنَّني لَكَ مُستَثقِلُ",38,"ل",1,0],["سأمنَحُ حَلْيَ الشِّعْرِ صائِغَ حَلْيِه","وإن لم يَصُغْهُ لارتيادِ العَوارفِ",39,"ف",1,0],["سامٍ إذا القومُ راموا نَيْلَ سُؤدُدِه","عَلا سُمُواً فحَطَّ القومَ إسفافا",40,"ف",2,0],["سَأَمنَحُ مالي كُلَّ مَن جاءَ طالِباً","وَأَجعَلُهُ وَقفاً عَلى القَرضِ وَالفَرضِ",41,"ض",1,1],["سامِحِ الناسَ فَإِنّي أَراهُم","أَصبَحوا إِلّا قَليلاً ذِئابا",42,"ب",2,0],["سامِح أُمورَكَ رِفقاً","وَاجعَل مَعاشَكَ قَصدا",43,"د",2,0],["سَأَمضي وَمَن بَعدي فَغَيرُ مُخَلَّدٍ","كَما لَم يُخَلَّدبَعدُ مَن قَد مَضى قَبلي",44,"ل",2,0],["سَأَمنَعُ قَلبي أَن يَحِنَّ إِلَيهِمُ","وَأَحجُبُ عَنهُم ناظِري وَجُفوني",45,"ن",2,0],["سَأُمسِكُ عَن جَوابِكَ لا لَعَيِّ","وَرَبُّ الأَمرِ مَمنوعُ الجَوابِ",46,"ب",1,1],["سَأَمضي لَهُ قِدماً وَلَو شابَ في الَّذي","أَهِمُّ بِهِ فيما صَنَعتُ المَقادِمُ",47,"م",1,1],["سامٍ كَأَنَّ العِزَّ يَجذِبُ ضَبعَهُ","وَسُمُوُّهُ مِن ذِلَّةٍ وَسَفالِ",48,"ل",1,0],["سامٍ إِذا اِستَعرَضتَهُ زانَهُ","أَعلى رَطيبٌ وَقَرارٌ يَبيس",49,"س",1,0],["سامي القَذالَينِ وَالجَبينِ إِذا","نَكَّسَ مِن لُؤمِ فِعلِهِ النِكسُ",50,"س",1,0],["سامرْتُ سامريَّةً","كأنها الغصنُ النضرْ",51,"ر",1,1],["سَإِمونا وَما سَإِمنا بِبَينٍ","وَأَرادوا دِماثَةً وَسُهولا",52,"ل",2,0],["سَأَملِكُ نَفسي ما اِستَطَعتُ فَإِن تَصِل","أَصِلكَ وَإِن تَصرِم حِبالِكَ مِن حَبلي",53,"ل",2,0],["سَامٍ يمدُّ إلى السِّماكِ يَمينَهُ","وَيُريكَ شَأوَ النَّسرِ كيفَ يُنالُ",54,"ل",1,0],["سامٍ يُزِلُّ الثَبتَ كَرُّ لِحاظِهِ","وَيَخِرُّ بِالجَبّارِ رَجعُ كَلامِهِ",55,"م",2,0],["سامَهُ حُبُّهُ شَقاء وَلَكن","نعمة الحب أَن يَكون شَقيّا",56,"ي",2,0],["سامى جَسيماتِ الأُمو","رِ فَنالَها عِندَ التَناوُل",57,"ل",1,0],["سامٍ سَناهُ لِلمَصانيعِ أَو","مُزاوِرٍ أَو مُحسَرٍ أَخفَضا",58,"ض",2,0],["سامتْهُ بعضَ الظلم وهي غريرةٌ","لا ظُلمُها يُخْشَى ولا عُدوانها",59,"ن",3,0],["سأميطُ عن وجهي اللِّثامَ وأعتزي","وأُري الحوادثَ صَفحةً لا تُجهَل",60,"ل",1,0],["سامٍ لِزَلزَلَةِ الحُرو","بِ يُظِلُّهُ خَرقُ المَطارِد",61,"د",1,0],["سامى بِرِجلَيها وَطابَت لَهُ","عَجزاءَ مِنها الأَنَثُ الآنِثُ",62,"ث",1,0],["سامِح أَخاكَ إِذا غَدَوتَ لِحاجَةٍ","وَاِترُك مَساخ