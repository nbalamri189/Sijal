{"poems":[[55,"أراك ستحدث للقلب وجدا","https://www.aldiwan.net/poem30614.html","المتقارب"],[32,"دنا البين من مي فردت جمالها","https://www.aldiwan.net/poem29539.html","الطويل"],[90,"هو النصر معقود برايتنا الحمرا","https://www.aldiwan.net/poem44470.html","الطويل"],[90,"تبلج أفق الشرق من بعدما اغبرا","https://www.aldiwan.net/poem44824.html","الطويل"],[90,"أجدك يا كواكب لا ترينا","https://www.aldiwan.net/poem45071.html","الوافر"],[53,"تأمل أبا عبد الإله فإنه","https://www.aldiwan.net/poem66003.html","الطويل"],[93,"ما وعظ الإنسان مثل الحمام","https://www.aldiwan.net/poem62748.html","عموديه"],[91,"لقد كان سعد خير قوم مجاهد","https://www.aldiwan.net/poem44614.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85390","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55161","الوافر"],[111,"معاهدة تذكاري سقتك الغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=102",""],[69,"جَنابكِ منه تُسْتَفَادُ الفَوائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13730&r=&rc=6",""],[121,"حنين","https://www.aldiwan.net/poem24037.html","الطويل"],[128,"إذا داعبه الحب","https://www.aldiwan.net/poem23742.html","الهزج"],[147,"لك السعي ما ينفك يخدمه السعد","https://www.aldiwan.net/poem11747.html","الطويل"],[164,"كذا فليكن سعى الملوك إلى المجد","https://www.aldiwan.net/poem58974.html","الطويل"],[185,"خليلى ما يغنى التدانى من النوى","https://www.aldiwan.net/poem59042.html","الطويل"],[203,"مكانك يا بدر وإن كنت واشيا","https://www.aldiwan.net/poem45229.html","الطويل"],[203,"تميل بالأفلاك مثلي آمال","https://www.aldiwan.net/poem45367.html","الطويل"],[203,"أحقا رأيت الموت دامي المخالب","https://www.aldiwan.net/poem45410.html","الطويل"],[215,"أموج البحر أسعفني فإني","https://www.aldiwan.net/poem46226.html","الوافر"],[318,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[435,"جمالك ليس يمنعه قناع","https://www.aldiwan.net/poem40059.html","الوافر"],[438,"حيث التفت فكثبان وقضبان","https://www.aldiwan.net/poem12748.html","البسيط"],[438,"أعن وسن ترنو عيونك أم سكر","https://www.aldiwan.net/poem12797.html","الطويل"],[454,"إن العروبة بالإسلام عزتها","https://www.aldiwan.net/poem996.html",""],[534,"مسامع من ناديت يا عمرو سدت","https://www.aldiwan.net/poem37501.html","الطويل"],[556,"أجيرتنا لا جمع الله شملنا","https://www.aldiwan.net/poem47753.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122801","الوافر"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59668","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59111","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96664","الطويل"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69201","الطويل"],[1320,"","https://poetry.dctabudhabi.ae/diwan/poem/198175",""],[1385,"","https://poetry.dctabudhabi.ae/diwan/poem/178071","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100968","الطويل"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144759","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109435","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77233","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202600","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204909",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205051","الوافر"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62893","المنسرح"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66369","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91783","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92012","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117856","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40124","الوافر"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97063","البسيط"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102743","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141675","الطويل"],[4984,"التكامل","https://www.poetsgate.com/ViewPoem.aspx?id=175601",""],[5032,"أرجوحة الحُلم","https://www.poetsgate.com/ViewPoem.aspx?id=188909",""],[5147,"يا شعب شرق العراق قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=166756",""],[592,"لك الحمد اللهم يا واسع المجد","https://www.poetsgate.com/ViewPoem.aspx?id=128838",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[5348,"مرثية قصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=59575",""],[5582,"أَلا كُلُّ عَيْشٍ صَفْوُهُ يَتَكَدَّرُ","https://www.poetsgate.com/ViewPoem.aspx?id=187148",""],[5582,"أَسِيرُ غَرامٍ ذائِبُ القَلْبِ مَعْمُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=63499",""],[5626,"هيا ارجعي","https://www.poetsgate.com/ViewPoem.aspx?id=189691",""],[5689,"باتت اليك يد الأشواق تدفعه","https://www.poetsgate.com/ViewPoem.aspx?id=143392",""],[6152,"صبا نجد","https://www.poetsgate.com/ViewPoem.aspx?id=201750",""]],"verses":[["وَهَل حَلَبَ الغَيثُ أَخلافَهُ","عَلى مَحضَرٍ مِن زُرودَ وَمَبدا",0,"د",2,0],["وَهَل حَدثانٌ أَن تَجوبَ بِنا السُرى","إِلَيكِ المَطايا نوقُها وَجِمالُها",1,"ل",3,0],["وهل حسِبوا قتل النساء شجاعة","وقد تركوا عند الرجال لهم ثأرا",2,"ر",2,0],["وهل حسِبوا أن العروبة في الورى","من العَرّ حتى أنكروا ذلك العرّا",3,"ر",2,0],["وهل حُسِبت بك الأيام حتى","تألَّف من تعاقبها السنونا؟",4,"ن",2,0],["وهل حقُّ سلطانٍ يطالبُ أهله","أبو القاسم المحتاطُ إلا مُحَصَّلُ",5,"ل",1,0],["وَهَل حَقيقٌ أَنَّ أَهلَ العُلى","وَالفَضلِ بَعدَ المَوتِ مِثلُ الطَغام",6,"م",1,0],["وهل حافل بالقبر من كان سيدا","له ألف قبر من قلوب الأماجد",7,"د",1,0],["وَهَل حيُّنا منه بذي الأثل نازلٌ","كَما كانَ أَم هَل غادر الحيُّ ذا الأثل",8,"ل",1,0],["وَهَلْ حَقّ إِلَيْهِ الشَّعْبُ يَسْعَى","بِإِيمَانٍ وَصَبْرٍ لاَ يُنَالُ",9,"ل",1,0],["وهل حمدت في الأرض بعد (محمد)","وأصحابه الا الشراة الصماصم",10,"م",1,0],["وَهل حُبُّكُمْ لِلنَّاسِ إلاَّ عَقِيدة ٌ","عَلَى أُسِّهَا في الله تُبْنَى القَواعِدُ",11,"د",1,0],["وهل حَمَلَتْ بِيضُ الخُدُودِ وسُمْرُها","أمانةَ ما حَمَّلْتُها إنْ وَعَتْ سَمْعا",12,"ع",2,0],["وهل حرج عليه وإن","يكن قد شاخ أن يصبو",13,"ب",2,0],["وَهَل حَلَبٌ إِلّا السُهى مُنذُ أَصبَحَت","لِأَروَعَ أَيامُ الزَمانِ لَهُ جُندُ",14,"د",1,0],["وهل حركات مثلها تجبر الورى","لما في محياك الكريم من السعد",15,"د",1,0],["وهل حُرِّمت تلكَ المِياهُ عَلى فتىً","سواىَ وَهَل خِيطَت بِرَنقٍ ثِمالُها",16,"ل",3,0],["وهلْ حدثتها نفسُها أنني بها","شديدُ الهوى أو أنني بتُّ ساليا",17,"ي",2,0],["وهل حالَ منكِ الوجدُ فازددتِ صفرةً","وحولكِ من هذي النسائمِ عذالُ",18,"ل",1,0],["وهل حملوا التقوى إلى إلى حفرةِ الثرى","وساروا بذاكَ الطودِ فوقَ المناكبِ",19,"ب",1,0],["وهل حرام وهذا الشيب مزدهر","أن يصبح المرء تمثالا من العوج",20,"ج",1,0],["وهل حسرة في النفس أعظم غصة","من البعد عن أهل ودار وجيرة",21,"ه",1,0],["وهل حجز الأزار قناة قدٍ","لها بين الورى فتكٌ مشاعُ",22,"ع",1,0],["وهل حوى اليُمْنَ إلا الصيدُ من يَمَنٍ","بذاكَ قد جاءَ إسلامٌ وإيمانُ",23,"ن",1,0],["وهلْ حملَتْ تلك الروادفُ أغصناً","تأوّدَ في أوراقِ أبرادِها الخُضْرِ",24,"ر",1,0],["وهل حتى تاجه الإيوان حين أتى","سعد ومن خلف سعد قادة نجب",25,"ب",1,0],["وهل حط قدر البدر عند طلوعه","إذا ما كلاب أنكرته فهرت",26,"ت",1,0],["وَهَل حَسَدُ الأقوامِ طاروا إلى العُلا","وَأَنتمْ بِطاءُ الخَطْو إلّا وَساوسُ",27,"س",1,0],["وَهًل حُدِّثتَ أنّي في زَماني","أُدَرِّجُ عَنكَ نَفسي بِالتَّمَنّي",28,"ن",2,0],["وهل حكت الأزهار حُسن مُقبّل","يُداوي الجوى لو جاد يوماً بخيلها",29,"ل",3,0],["وَهَلْ حَنَّتِ الأنْوَار شَرْقاً لِتُرْبِها","فَصِيغَتْ لَهَا بِالبَارِقَاتِ بَلاَبِل",30,"ل",1,0],["وَهل حمّ هَذاك الفريق فراقه","وَهَل منهُ أقوى حاجر ومحجّرُ",31,"ر",1,0],["وَهَل حازِمٌ إِلّا كآخرَ عاجِزٍ","إِذا حَلَّ بالإِنسان ما يتوقّع",32,"ع",1,0],["وهل حاملٌ منّي إليكم تحيَّةً","إذا تُليَتْ يوماً يضوعُ عبيرها",33,"ر",3,0],["وهل حَرَجات الحَيّ بدّلن أدمعاً","عن السُّحْب لم ترقع لهنّ خروق",34,"ق",1,0],["وهل حملت نجب الردى مثل راحل","بكته المعالي من بني بركات",35,"ت",1,0],["وهل حققوا مني حنيناً مبرحاً","يزيد بأشجاني إذا ما الدجى جنا",36,"ن",2,0],["وهل حمدت بهذا العصر من أحد","قلت الأمير ابن هول الدهر أحمده",37,"د",2,0],["وَهَل حُمِّلَت أَهرامُ مِصرَ فَلَم تَسُخ","مِنَ الوَجدِ ما حَمَّلتِ قَلباً مُعَذَّبا",38,"ب",2,0],["وهل حُسنٌ يعيش بلا حسودٍ","وهل مجد إذا لم تلق خصما",39,"م",2,0],["وهل حمار بدون رفس","والحمر أشكالها كِثار",40,"ر",1,0],["وهل حررت نفسك من عداة","لهم أسلست من بعد الشماس",41,"س",1,0],["وَهَل حديقته جفت خُضيرتها","أَم يا تُرى كَيفَ ما كانته سيرتُها",42,"ه",2,0],["وهلْ حياةٌ للمرءِ نافعةٌ","تنفُدُ في كدِّهِ وفي تَعبِهْ",43,"ب",2,0],["وهل حيّاكم عني","نسيم البان والرّند",44,"د",1,0],["وَهَل حَسُنت أَرضٌ بغير سمائها","وَهَل تِلكَ إلا بالشموس المضيئة",45,"ه",1,0],["وَهَل حرّكت بَعد السُكون يَدُ المُنى","نُفوساً تقوّت بِالهَوى إِذ تقوّت",46,"ت",1,0],["وهل حول بازي وإن جاع يجتري","غراب كثير الشحم يزهو ويختال",47,"ل",1,0],["وَهَل حلَبٌ سِوى نفسٍ شَعَاعٍ","تَقَسَّمها التّمادي والتّعادي",48,"د",2,0],["وهل حملن ليحيى في السبا حرم","كزينب ويتاماها على القتب",49,"ب",1,0],["وهل حجلها غصان من ماء ساقها","وهل جيدها باق به العقد والقرط",50,"ط",1,0],["وهل حُور عين في منازهها تُرَى","وإلا فكل حين تخطر بلقيس",51,"س",1,0],["وهل حقق الآمال من بات شاكيا","وهل غيًّر الأقدار بالبرج طالعه",52,"ع",2,0],["وهَلْ حَدِيثُكَ إلّا أنَّ حُجَّتَهُ","وَهمٌ وأنَّ القَضايا كُلّها خُدَعُ",53,"ع",1,0],["وهَلْ حَدِيثُكَ إلاَّ أنَّ أُمَّتَنا","حُضُورُها في كَراسي الرأي مُنْقَطِعُ",53,"ع",1,0],["وهل حزون الفلاة جازوا","يوم حزون الفلاة جزنا",54,"ن",2,0],["وهل حذر يجدي عن القدر الذي","يسابق علم الله قد كان مستبدي",55,"د",2,0],["وهل حذر يغني عن القدر الذي","يسابق علم الله لابد أن يجري",56,"ر",2,0],["وهل حصن زهوان الحصين وجيرة","حواليه في عز أطيد وفي فخر",56,"ر",1,0],["وهل حلَّقَتْ في سَماءِ الضبابِ","حروف تَجرُّ ظلالَ الغَسَقْ؟",57,"ق",1,0],["وَهَلْ حَذَرٌ يُنْجِي الفَتَى مِنْ حِمامِهِ","وَذَلِكَ أَمْرٌ لِلْبَرايا مُقَدَّرُ",58,"ر",1,0],["[ وَهَلْ حاسِدٌ تَخْشاهُ فِي النَّاسِ بَعْدَما","أَتاكَ مِنَ الخَلاَّقِ نَصْرٌ وَتَأْيِيدُ ]",59,"د",1,0],["وَهَل حفِظتَ شغافَ القلبِ من سَقَمٍ ؟؟","فالقلبُ ممتلئٌ بالضّيمِ والبؤسِ",60,"س",1,0],["وهل حديث لكم عنه يلم لنا","شتاتنا في حمى الذكرى ويجمعه",61,"ع",2,0],["وهل حالت الأيام دون وصالنا","إذا خانها شوق وعاتبها وعد",62,"د",1,0]]}