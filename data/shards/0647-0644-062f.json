{"poems":[[55,"ردوا الغليل لقلبي المشغوف","https://www.aldiwan.net/poem29970.html","الكامل"],[55,"منابت العشب لا حام ولا راع","https://www.aldiwan.net/poem30149.html","البسيط"],[95,"في رضى المربوب والرب","https://www.aldiwan.net/poem9791.html","عموديه"],[29,"حي الهدملة من ذات المواعيس","https://www.aldiwan.net/poem5787.html","البسيط"],[87,"أما العتاب فبالأحبة أخلق","https://www.aldiwan.net/poem61200.html","عموديه"],[87,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[87,"قف على كنز بباريس دفين","https://www.aldiwan.net/poem63736.html","الرمل"],[47,"أخفي هوى لك في الضلوع وأظهر","https://www.aldiwan.net/poem63638.html","الكامل"],[107,"تلك القضية هل لها ميعاد","https://www.aldiwan.net/poem42073.html","الكامل"],[107,"ردوا بني قينقاع الأمر إذ نزلا","https://www.aldiwan.net/poem44215.html","البسيط"],[83,"سقى الهوى فانتشى العميد","https://www.aldiwan.net/poem61401.html","مجزوء البسيط"],[104,"لذة العيش بسفح الكرمل","https://www.aldiwan.net/poem33109.html","الرمل"],[52,"حال حب الذلفاء دون الرقاد","https://www.aldiwan.net/poem63901.html","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43822","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/205861","الكامل"],[108,"فيلسوف الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179354",""],[108,"مولد الهادي الأمين","https://www.poetsgate.com/ViewPoem.aspx?id=179620",""],[108,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[108,"الركب المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=179288",""],[47,"أُخْفي هَوًى لكِ في الضّلوعِ، وأُظهِرُ","https://www.poetsgate.com/ViewPoem.aspx?id=31199",""],[123,"يا أيها المنصور بأسك رحمة","https://www.aldiwan.net/poem4364.html","الكامل"],[215,"يا قلب هذا هوى جديد","https://www.aldiwan.net/poem46563.html","مخلع البسيط"],[230,"كم تهيم كم تجب","https://www.aldiwan.net/poem55209.html","المقتضب"],[275,"يا ورد تونس ما الربيع بمؤنس","https://www.aldiwan.net/poem34993.html","الكامل"],[287,"هل دهرنا الماضي يعود","https://www.aldiwan.net/poem32804.html","مجزوء الكامل"],[303,"سامح الله الحمامه","https://www.aldiwan.net/poem36251.html","عموديه"],[303,"ما له في عظم الشأن قري","https://www.aldiwan.net/poem36860.html","عموديه"],[310,"سيدي شأوك أعيى المحتذي","https://www.aldiwan.net/poem56495.html","الكامل"],[310,"صاح ها شمل السرور انتظما","https://www.aldiwan.net/poem56500.html","الرمل"],[412,"لمن الرسوم بعرصة البردان","https://www.aldiwan.net/poem50100.html","الكامل"],[422,"من لصب مستطار القلب هائم","https://www.aldiwan.net/poem53954.html","الرمل"],[484,"أناخ في قلب ليلى هاجس الشجن","https://www.aldiwan.net/poem37572.html","البسيط"],[580,"صح من دهرنا وفاة الحياء","https://www.aldiwan.net/poem2790.html","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138396",""],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80234","البسيط"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80192","الكامل"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101990","الخفيف"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141253","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101053","الرمل"],[2085,"","https://poetry.dctabudhabi.ae/diwan/poem/202201","الخفيف"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109346","الرمل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109296","الرمل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67205","الرمل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132620","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74059","البسيط"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126968","الرمل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138518",""],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66472","المديد"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66373","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86451","الخفيف"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136804",""],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81944","الخفيف"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35058","الخفيف"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35126","الرمل"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102020","الرمل"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102000","الرمل"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102014","الرمل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52183","الرمل"],[1703,"ماذا المصاب الذي اهتزّت له الأمم","https://www.poetsgate.com/ViewPoem.aspx?id=49834",""],[4829,"الجابريّة","https://www.poetsgate.com/ViewPoem.aspx?id=35605",""],[4830,"خطَّ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=200443",""],[4830,"يالِقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=213988",""],[5136,"قمت ليل الوداع إلا قليلا","https://www.poetsgate.com/ViewPoem.aspx?id=121943",""],[5206,"مناهج الله","https://www.poetsgate.com/ViewPoem.aspx?id=187391",""],[5409,"إن علاك المشيب لم يبق شيء","https://www.poetsgate.com/ViewPoem.aspx?id=155378",""],[5409,"قل لمن عاش كما عا","https://www.poetsgate.com/ViewPoem.aspx?id=155319",""],[5461,"يبكي الصوت والنظرات تشكي","https://www.poetsgate.com/ViewPoem.aspx?id=1308",""],[5952,"هل كمثلي","https://www.poetsgate.com/ViewPoem.aspx?id=202222",""],[6125,"قَابَ قَوسَينِ","https://www.poetsgate.com/ViewPoem.aspx?id=210207",""],[6177,"معراج العاشقين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79590&r=&rc=26",""]],"verses":[["هَل دارُنا بِالرَملِ غَيرُ نَزيعَةِ","أَم حَيُّنا بِالجِزعِ غَيرُ خُلوفِ",0,"ف",1,0],["هَل دَمعَةٌ حَذَفَتها العَينُ شافِيَةٌ","داءً حَنَوتُ عَليهِ بَينَ أَضلاعي",1,"ع",2,0],["هَلْ دُمُوعُ العَيْنِ مُغْنِيَةٌ","في العُلَى مِنْ هَابِطِ الشُّهْبِ",2,"ب",1,0],["هَل دَعوَةٌ مِن جِبالِ الثَلجِ مُسمِعَةٌ","أَهلَ الإِيادِ وَحَيّاً بِالنَباريسِ",3,"س",1,0],["هَل دونَ أَيّامِ الشَبيبَةِ لِلفَتى","صَفوٌ يُحيطُ بِهِ وَأُنسٌ يُحدِقُ",4,"ق",1,0],["هَل دَرى أَندَلُسٌ مَن قَدِما","دارَهُ مِن نَحوِ بَيتِ المَقدِسِ",5,"س",1,0],["هَل دَرى المَرمَرُ ماذا تَحتَهُ","مِن قُوى نَفسٍ وَمِن خَلقٍ مَتين",6,"ن",1,0],["هَل دَينُ عَلوَةَ يُستَطاعُ فَيُقتَضى","أَم ظُلمُ عَلوَةَ يَستَفيقُ فَيُقصِرُ",7,"ر",1,0],["هل دَانَ للهِمَمِ الرَّواكدِ مَطْلَبٌ","أم صَحَّ للأُمَمِ الضِّعافِ مُرادُ",8,"د",1,0],["هل دولةُ الحقّ إلا قُوةٌ غَلبْت","فافتحْ بها الأرضَ أو فامسَحْ بها الدُّولا",9,"ل",2,0],["هَل دَبَّ في لَحظِهِ سَقامي","أَو نارُ قَلبي في وَجنَتَيهِ",10,"ه",1,0],["هَل دَرى يا وَيحه أَن المُنى","في الهَوى لا تَجتَني بِالخدع",11,"ع",1,0],["هَل دَعا شَوقُهُ الوِسادَ فَإِنّي","لَم أَنَل بَعدَهُ اِشتِياقَ وِسادِ",12,"د",1,0],["هَل دَرى القَبرُ المُضيءُ سَناهُ","أَيَّ غِطريفٍ مِنَ القَومِ آوى",13,"ا",3,1],["هل دولة الحب التي أسستها","سقطت علي وسدت الأبواب",14,"ب",1,0],["هل درى الشمَّاخُ في صحرائه:","أن قومًا ألبسوه قُبَّعة؟",15,"ع",2,0],["هل دَرَتْ يومَ وضْعه بنتُ وهْبٍ:","أنها اطلعَتْ صباحًا جديدا؟",16,"د",2,0],["هل دَرَتْ: أيُّ دولةٍ وسريرٍ","آذَنَا يومَ وضعِهِ أن يَمِيدَا؟",16,"د",2,0],["هل دَرَتْ: أنها على هَامةِ التَّا","ريخ شادَتْ للعُرْبِ مُلْكًا وطيدا؟",16,"د",2,0],["هل درى البُحتري أن القوافي","سُوقها اليوم أصبحت في ركود؟",17,"د",1,0],["هل درى البحتريُّ أن أناسًا","بعده شوَّهوا جمال القصيد؟",17,"د",1,0],["هل دَرَتْ من طاردتْه أُمةٌ","هُبَلٌ معبودُها؟ شاهَتْ وشاه!",18,"ا",2,0],["هَلْ دَينُ عَلْوَةَ يُستَطَاعُ، فيُقتَضَى،","أوْ ظُلْمُ عَلْوَةَ يَستَفيقُ فَيُقْصَرُ",19,"ر",1,0],["هل دبّ منهم في حِماكم دارجٌ","إلا وصُبَّ عليه منك عِقابُ",20,"ب",1,0],["هل دارة الحب لا تجيب","ولا على لوعتي تثيب",21,"ب",1,0],["هَل دَرَت بِمَن حَمَلَت","في المَهامهِ النُجُبُ",22,"ب",1,0],["هَل دَرَت مَكانةَ عَبّا","سَ بينَ مَن رَكِبوا",22,"ب",3,0],["هَل دولةٌ للأغلَبيِّينَ الأُلى","لبسوا حديدَ الدرعِ أشرفَ ملبس",23,"س",1,0],["هَل دَهرُنا الماضي يَعودُ","وَيَصُدُّ عَنّا ذا الصُدودُ",24,"د",1,1],["هل درى أنْ سوف يرعى ال","خلقَ إِذْ يرعى سوامه",25,"م",2,0],["هلْ درتْ أَن عَلَى النأْيِ فتى","كادَ يرديه إِلى الشام الحنين",26,"ن",1,0],["هل درى ظبي الحمى أن قد حمى","قلب صب حله عن مكنس",27,"س",1,0],["هل دَرى صوبُ الرّبيعِ إِذ هَمى","أَنّه أَحيا جميعَ الأنفسِ",28,"س",1,0],["هَل دارُ علوةَ إِن سأَلتَ مُجيبَةٌ","أَو هَل يُجيبك غَيرَ ذاتِ لِسانِ",29,"ن",1,0],["هل دَرى السَّيِّد فيما قد درى","أَمْ هو الآن بما أَعْلَمُ عالم",30,"م",1,0],["هل درّت الشاة فالأحشاء في ضرم","أو فاسقني جرعة من حوضنا الأجن",31,"ن",1,0],["هل دَرَى القبرُ ما حُواهُ وما أَخ","فاهُ من ذلِكَ السَّنى والسَّنَاءِ",32,"ا",2,0],["هل دار في خلديهما ان الذي","رأياه أصبح ناطقاً يتكلم",33,"م",1,0],["هَل دار عُرسٌ بِها دَقَت بَشائِرُهُ","أَم قامَ يا وَيح قَلبي مَأتَم الحَربِ",34,"ب",1,0],["هَل دامَ قَلبُكِ حافِظاً لِعُهودِهِ","فَعَلى فُؤادي الحُبُّ خَطَّ صُكوكي",35,"ك",2,0],["هل درت أنها تبدد شمل ال","دين ظلما وشمله مجموع",36,"ع",1,0],["هل دكّ طود المعالي بعد منعته","أم هل قضى العالم العلاّمة العلم",37,"م",1,0],["هل درى أهل المصلى أننا","نرد العيش بوادينا سماما",38,"م",2,0],["هل دمعي لفرقة الأحباب","واغترابي عن معشر بالحضاب",39,"ب",1,1],["هل درى أيّ دم قد سفكا","يا لقومي ريم وادي الاجرع",40,"ع",1,0],["هل درى أي دم قد سفكا","جفنك الفاتر يا ظبي النقا",41,"ق",2,0],["هل دَرت يومَ حسينٍ هاشمٌ","أيَّ ركنٍ هدَّ من أركانها",42,"ن",3,0],["هل درى لا استقل فيه عمود","انه قد نعى العميد الاغرا",43,"ر",2,0],["هَل دام في الأَرض حكم شعب","إِذا أَبى الشعب أَن يَدوما",44,"م",2,0],["هل درت فهر به الشم الأنوف","نهبت اشلاءه البيض الحداد",45,"د",1,0],["هل درت فاطمة الزهرا بأن","عمم الرجس عليا بشباه",46,"ا",2,0],["هل دريتم يوم فرقتكم","كيف أمسى الحين منتظري",47,"ر",2,0],["هل درت بالذي درت سايقوها","فغدت بالمسير ذات استباق",48,"ق",1,0],["هل درى حاملوك أن ثبيرا","فوق أكتافهم أجد زماعا",49,"ع",2,0],["هل دوى للهوى يوجد وهل له تطباب","إن قلب المعنى ذاب من عشقه ذاب",50,"ب",1,0],["هل دعاهم ليستجيبوا لغير اللّه","أم كان قوله منكوسا",51,"س",2,0],["هَل دَريتُم بما جَنَيتم فَمَظلو","مونَ أَنتم وأَنتمُ الظالمونا",52,"ن",2,0],["هَل دَرَت بابِلُ أَنّا فِئَةٌ","تَجعَلُ السِحرَ مِنَ السِحرِ رُقى",53,"ق",2,0],["هل درى يوم نواه أي ما","غارة شعواء في أحشائنا شن",54,"ن",1,0],["هل درتني اليوم من صبوتها","هائما أطوي الفلا بيداً فبيدا",55,"د",2,0],["هل درت تلك الدراري أنني","أجرع الصاب لها جاماً فجاما",56,"م",2,0],["هل درت ما صنعت بالعيلم ال","علم السجاد من ساد الأناما",56,"م",2,0],["هل دَرى القادرُ في قُدرَتِه","أنَّ عبد الأمسِِ صار اليومَ حُرّاً",57,"ر",2,0],["هل دكّ طود من المعالي بعد منعته","أم هل قضى العالم العلاّمة العلم",58,"م",1,0],["هل دمعهم الا كدمع المشرك","الوائد الي استنصب الازلامي",59,"م",2,0],["هل دَنَتِ الساعةُ من وصلنا","فانَّني للشوقِ عبدٌ مُنيبْ",60,"ب",1,0],["هل دَنَتْ ساعةُ لُقيانا فقد","شفَّني النّأيُ وأضناني الشَجَنْ",61,"ن",1,0],["هل درى من أحب أني إليه","أرسل الريح إذ عدمت الرسولا",62,"ل",2,0],["هَل دَافعٌ لوُرُودِهَا أو مَانِعٌ","أم ذَابِلٌ قَد رَدَّهَا ومَنَاصِلُ؟",63,"ل",1,0],["هل درى بعدما دهته المنايا","أنه مات واستحال ترابا",64,"ب",2,0],["هل درى الآكل لحمي","أنه يأكل لحمه",65,"م",2,0],["هل دمعي وقام الليل يبكي","والقمر نشّ من فرقى جليسه",66,"س",2,0],["هل دَرَتْ يوماً بما صَنَعَتْ","بالذي قد خانهُ الرَّشَدُ",67,"د",1,0],["هَلْ دَرَتْ حِينَ جَرجَرَتنَا الأمَانِي","فِي دُرُوبٍ نَسِيرُ فِيهَا أُسَارىٰ",68,"ر",2,0],["هَلْ دَرَتْ حِينَ قَاسَمَتنِي عُيُونًا","شِبْتُ مِنهَا، شَبَّبْتُ فِيهَا جِهَارا",68,"ر",2,0],["هل دارت الأيامُ دورتها بنا","وتناثر الفرسان في العثرات؟",69,"ت",1,0]]}