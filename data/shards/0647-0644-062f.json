{"poems":[[53,"ردوا الغليل لقلبي المشغوف","https://www.aldiwan.net/poem29970.html","الكامل"],[53,"منابت العشب لا حام ولا راع","https://www.aldiwan.net/poem30149.html","البسيط"],[93,"في رضى المربوب والرب","https://www.aldiwan.net/poem9791.html","عموديه"],[27,"حي الهدملة من ذات المواعيس","https://www.aldiwan.net/poem5787.html","البسيط"],[85,"أما العتاب فبالأحبة أخلق","https://www.aldiwan.net/poem61200.html","عموديه"],[85,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[85,"قف على كنز بباريس دفين","https://www.aldiwan.net/poem63736.html","الرمل"],[45,"أخفي هوى لك في الضلوع وأظهر","https://www.aldiwan.net/poem63638.html","الكامل"],[105,"تلك القضية هل لها ميعاد","https://www.aldiwan.net/poem42073.html","الكامل"],[105,"ردوا بني قينقاع الأمر إذ نزلا","https://www.aldiwan.net/poem44215.html","البسيط"],[81,"سقى الهوى فانتشى العميد","https://www.aldiwan.net/poem61401.html","مجزوء البسيط"],[102,"لذة العيش بسفح الكرمل","https://www.aldiwan.net/poem33109.html","الرمل"],[50,"حال حب الذلفاء دون الرقاد","https://www.aldiwan.net/poem63901.html","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43822","المديد"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205861","الكامل"],[106,"فيلسوف الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179354",""],[106,"مولد الهادي الأمين","https://www.poetsgate.com/ViewPoem.aspx?id=179620",""],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[106,"الركب المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=179288",""],[45,"أُخْفي هَوًى لكِ في الضّلوعِ، وأُظهِرُ","https://www.poetsgate.com/ViewPoem.aspx?id=31199",""],[119,"يا أيها المنصور بأسك رحمة","https://www.aldiwan.net/poem4364.html","الكامل"],[211,"يا قلب هذا هوى جديد","https://www.aldiwan.net/poem46563.html","مخلع البسيط"],[225,"كم تهيم كم تجب","https://www.aldiwan.net/poem55209.html","المقتضب"],[270,"يا ورد تونس ما الربيع بمؤنس","https://www.aldiwan.net/poem34993.html","الكامل"],[282,"هل دهرنا الماضي يعود","https://www.aldiwan.net/poem32804.html","مجزوء الكامل"],[298,"سامح الله الحمامه","https://www.aldiwan.net/poem36251.html","عموديه"],[298,"ما له في عظم الشأن قري","https://www.aldiwan.net/poem36860.html","عموديه"],[305,"سيدي شأوك أعيى المحتذي","https://www.aldiwan.net/poem56495.html","الكامل"],[305,"صاح ها شمل السرور انتظما","https://www.aldiwan.net/poem56500.html","الرمل"],[406,"لمن الرسوم بعرصة البردان","https://www.aldiwan.net/poem50100.html","الكامل"],[416,"من لصب مستطار القلب هائم","https://www.aldiwan.net/poem53954.html","الرمل"],[479,"أناخ في قلب ليلى هاجس الشجن","https://www.aldiwan.net/poem37572.html","البسيط"],[575,"صح من دهرنا وفاة الحياء","https://www.aldiwan.net/poem2790.html","الخفيف"]],"verses":[["هَل دارُنا بِالرَملِ غَيرُ نَزيعَةِ","أَم حَيُّنا بِالجِزعِ غَيرُ خُلوفِ",0,"ف",1,0],["هَل دَمعَةٌ حَذَفَتها العَينُ شافِيَةٌ","داءً حَنَوتُ عَليهِ بَينَ أَضلاعي",1,"ع",2,0],["هَلْ دُمُوعُ العَيْنِ مُغْنِيَةٌ","في العُلَى مِنْ هَابِطِ الشُّهْبِ",2,"ب",1,0],["هَل دَعوَةٌ مِن جِبالِ الثَلجِ مُسمِعَةٌ","أَهلَ الإِيادِ وَحَيّاً بِالنَباريسِ",3,"س",1,0],["هَل دونَ أَيّامِ الشَبيبَةِ لِلفَتى","صَفوٌ يُحيطُ بِهِ وَأُنسٌ يُحدِقُ",4,"ق",1,0],["هَل دَرى أَندَلُسٌ مَن قَدِما","دارَهُ مِن نَحوِ بَيتِ المَقدِسِ",5,"س",1,0],["هَل دَرى المَرمَرُ ماذا تَحتَهُ","مِن قُوى نَفسٍ وَمِن خَلقٍ مَتين",6,"ن",1,0],["هَل دَينُ عَلوَةَ يُستَطاعُ فَيُقتَضى","أَم ظُلمُ عَلوَةَ يَستَفيقُ فَيُقصِرُ",7,"ر",1,0],["هل دَانَ للهِمَمِ الرَّواكدِ مَطْلَبٌ","أم صَحَّ للأُمَمِ الضِّعافِ مُرادُ",8,"د",1,0],["هل دولةُ الحقّ إلا قُوةٌ غَلبْت","فافتحْ بها الأرضَ أو فامسَحْ بها الدُّولا",9,"ل",2,0],["هَل دَبَّ في لَحظِهِ سَقامي","أَو نارُ قَلبي في وَجنَتَيهِ",10,"ه",1,0],["هَل دَرى يا وَيحه أَن المُنى","في الهَوى لا تَجتَني بِالخدع",11,"ع",1,0],["هَل دَعا شَوقُهُ الوِسادَ فَإِنّي","لَم أَنَل بَعدَهُ اِشتِياقَ وِسادِ",12,"د",1,0],["هَل دَرى القَبرُ المُضيءُ سَناهُ","أَيَّ غِطريفٍ مِنَ القَومِ آوى",13,"ا",3,1],["هل دولة الحب التي أسستها","سقطت علي وسدت الأبواب",14,"ب",1,0],["هل درى الشمَّاخُ في صحرائه:","أن قومًا ألبسوه قُبَّعة؟",15,"ع",2,0],["هل دَرَتْ يومَ وضْعه بنتُ وهْبٍ:","أنها اطلعَتْ صباحًا جديدا؟",16,"د",2,0],["هل دَرَتْ: أيُّ دولةٍ وسريرٍ","آذَنَا يومَ وضعِهِ أن يَمِيدَا؟",16,"د",2,0],["هل دَرَتْ: أنها على هَامةِ التَّا","ريخ شادَتْ للعُرْبِ مُلْكًا وطيدا؟",16,"د",2,0],["هل درى البُحتري أن القوافي","سُوقها اليوم أصبحت في ركود؟",17,"د",1,0],["هل درى البحتريُّ أن أناسًا","بعده شوَّهوا جمال القصيد؟",17,"د",1,0],["هل دَرَتْ من طاردتْه أُمةٌ","هُبَلٌ معبودُها؟ شاهَتْ وشاه!",18,"ا",2,0],["هَلْ دَينُ عَلْوَةَ يُستَطَاعُ، فيُقتَضَى،","أوْ ظُلْمُ عَلْوَةَ يَستَفيقُ فَيُقْصَرُ",19,"ر",1,0],["هل دبّ منهم في حِماكم دارجٌ","إلا وصُبَّ عليه منك عِقابُ",20,"ب",1,0],["هل دارة الحب لا تجيب","ولا على لوعتي تثيب",21,"ب",1,0],["هَل دَرَت بِمَن حَمَلَت","في المَهامهِ النُجُبُ",22,"ب",1,0],["هَل دَرَت مَكانةَ عَبّا","سَ بينَ مَن رَكِبوا",22,"ب",3,0],["هَل دولةٌ للأغلَبيِّينَ الأُلى","لبسوا حديدَ الدرعِ أشرفَ ملبس",23,"س",1,0],["هَل دَهرُنا الماضي يَعودُ","وَيَصُدُّ عَنّا ذا الصُدودُ",24,"د",1,1],["هل درى أنْ سوف يرعى ال","خلقَ إِذْ يرعى سوامه",25,"م",2,0],["هلْ درتْ أَن عَلَى النأْيِ فتى","كادَ يرديه إِلى الشام الحنين",26,"ن",1,0],["هل درى ظبي الحمى أن قد حمى","قلب صب حله عن مكنس",27,"س",1,0],["هل دَرى صوبُ الرّبيعِ إِذ هَمى","أَنّه أَحيا جميعَ الأنفسِ",28,"س",1,0],["هَل دارُ علوةَ إِن سأَلتَ مُجيبَةٌ","أَو هَل يُجيبك غَيرَ ذاتِ لِسانِ",29,"ن",1,0],["هل دَرى السَّيِّد فيما قد درى","أَمْ هو الآن بما أَعْلَمُ عالم",30,"م",1,0],["هل درّت الشاة فالأحشاء في ضرم","أو فاسقني جرعة من حوضنا الأجن",31,"ن",1,0],["هل دَرَى القبرُ ما حُواهُ وما أَخ","فاهُ من ذلِكَ السَّنى والسَّنَاءِ",32,"ا",2,0]]}