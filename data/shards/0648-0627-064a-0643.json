{"poems":[[45,"لقد أصبح الجرذ المستغير","https://www.aldiwan.net/poem9510.html","المتقارب"],[30,"إن رجال الروم يعرف أهلها","https://www.aldiwan.net/poem5460.html","الطويل"],[107,"بني لحيان لوذوا بالجبال","https://www.aldiwan.net/poem44068.html","الوافر"],[376,"عيون منعن الرقاد العيونا","https://www.aldiwan.net/poem57058.html","المتقارب"],[457,"لنا المشرب الأهنا من المورد الأصفى","https://www.aldiwan.net/poem13841.html","الطويل"],[556,"على الربع ربع الراحلين سلامي","https://www.aldiwan.net/poem47207.html","الطويل"],[556,"لك الليل بعد الذاهبين طويلا","https://www.aldiwan.net/poem47299.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122754","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122759","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122623","الوافر"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84506","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80067","المتقارب"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/109022","الطويل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47188","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87736","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66486","الوافر"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85234","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131094",""],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125916","الطويل"],[4163,"","https://poetry.dctabudhabi.ae/diwan/poem/106741","الوافر"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83401","الطويل"],[5038,"شهرزاد","https://www.poetsgate.com/ViewPoem.aspx?id=190268",""],[5409,"ذكرت الجنان وأنهارها","https://www.poetsgate.com/ViewPoem.aspx?id=155274",""],[5587,"الحديث يجيب","https://www.poetsgate.com/ViewPoem.aspx?id=196870",""],[5689,"لا تنس أنا بأفق الغرب في قلق","https://www.poetsgate.com/ViewPoem.aspx?id=143417",""],[6202,"وقفة رجاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86759&r=&rc=60",""]],"verses":[["وَأَيُّكُما كانَ مِن خَلفِهِ","فَإِنَّ بِهِ عَضَّةً في الذَنَب",0,"ب",1,0],["وَأَيُّكُمُ إِذ جَدَّ جِدّي وَجَدُّكُم","يُنيخُ مَعاً عِندَ اِعتِراكِ الكَلاكِلِ",1,"ل",1,0],["وأَيُّكما القتيلُ وَمَنْ سيبقى","حياةٌ للأواخِرِ والأوالي",2,"ل",2,0],["وأيُّكم كانَ بَعد النَّبِيِّ","وَصِيّاً ومَن كانَ فيكُم أَمينا",3,"ن",2,0],["وأيُّكم نامَ في فَرشِهِ","وأنتُم لمهجَتِه طالِبونا",3,"ن",2,0],["وأيكيّة باتت تساهمني الجوَى","وبتّ على وجْدٍ أُجرَّعه صِرفا",4,"ف",2,0],["وأيُّ كلامٍ لم يكنْ بمفَاخرٍ","سبقت بها سِلْكاً فليس كلامي",5,"م",2,0],["وأَيُّكُمُ ما عزّ فينا بدينه","وقد عاش دهراً قبل ذاك ذليلا",6,"ل",2,0],["وَأيُّ كَوكَبِ حَقٍ يُستَضاءُ بِهِ","وَقَد تَشابَهَتِ الأنوارُ والظُّلَمُ",7,"م",1,0],["وَأَيُّ كَريمٍ بَعدَ دَولَةِ قاسِمٍ","يُخَلَّى سُدىً لا تُستَحَلُّ مَحارِمُه",8,"م",2,0],["وأيُّكما أبُتُّ عليهِ قَلبي","لِبَتَّةِ ذلِك السَّبَبِ المُغار",9,"ر",1,0],["وأي كربٍ لركبٍ ينزلون بها","حاشا وكلاّ ولكن ساحة الكَرَمِ",10,"م",1,0],["وأيكة مجدكَ قد غرَّدتْ","حمامُ الثناء على ساقِها",11,"ق",3,0],["وأيكما المعطي الحقوق لأهلها","بأعدل قسط لا يلم به زِحل",12,"ل",1,0],["وأيكما سيف الإله وظله ال","لذي بيديه العقد أجمع والحل",12,"ل",1,0],["وأيّ كمالٍ يبتغى فيه كاملٌ","وأيّ جَداً يُبْغَى من النّاس نافع",13,"ع",1,0],["وَأَيّ كلوم في فؤادك لَم تَزَل","بَعيدةَ غَورٍ لا تَطيق لَها سَبرا",14,"ر",2,0],["وأي كريمةٍ في المجد والي","تايمّها سواك ولم يغركا",15,"ك",2,0],["وإيكم وابتداع فإنه","ضلال وفي نار الجحيم يكبكب",16,"ب",1,0],["وأيّ كئيب لا يقول لأمه","ووالده لولاكما لم يطل خطبي",17,"ب",2,0],["وأَيُّ كريمٍ ليس يَطربُ للندى","خصوصاً إذا ما هزه رائقُ الشعر",18,"ر",1,0],["وأَيُّ كَتائبٍ جالَدَت إِلّا","تَركتَ كُماتَها جَزَرَ النِصالِ",19,"ل",1,0],["وَأيّ كَريم إِن كبا عاد ناهِضاً","بغير اِنعِطافٍ من كَريم حلاحلِ",20,"ل",1,0],["وأيْكَةُ الصّحبِ قدْ حَنّتْ إلى فلَقٍ","وزاجلُ الشّوقِ في مِرْسالهِ الخَبَرُ",21,"ر",1,0],["وأيك تعانق أغصانها","كما عانق الطلع نوارها",22,"ر",3,0],["وَ أَيَّ كَلَامٍ يَسْتَحِقُّ بوَصْفِهِ","عَلَى كُلِّ صَدْرِ المَكْرُمَاتِ يُصِيبُ",23,"ب",1,0],["وأي كأس تسر النفس شهدتها","كمثل كأس الهوى في هدأة الغسق",24,"ق",1,0],["وأي كريم نال دائم نعمة","وأي كريم ظل فى الناس باقيا",25,"ي",2,0]]}