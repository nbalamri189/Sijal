id=180160",""],[5186,"جحدوا فضل بني العرب جحودا","https://www.poetsgate.com/ViewPoem.aspx?id=156479",""],[5302,"وعلى هواه بما يرى ذهبا","https://www.poetsgate.com/ViewPoem.aspx?id=201380",""],[5362,"فلق الفجر هامة الظلماء","https://www.poetsgate.com/ViewPoem.aspx?id=170369",""],[5397,"أبسفح حاجر منك يسفح محجر","https://www.poetsgate.com/ViewPoem.aspx?id=157963",""],[5397,"أجريت قلبي بالدموع مذابا","https://www.poetsgate.com/ViewPoem.aspx?id=157905",""],[475,"صرمتْ حبلكَ الغداة َ نوارُ","https://www.poetsgate.com/ViewPoem.aspx?id=20561",""],[5542,"يا قدس","https://www.poetsgate.com/ViewPoem.aspx?id=10200",""],[5582,"قَدْكَ يا عاذِلُ تُبْدِي اللَّوْمَ قَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=186907",""],[5582,"كَمْ أَنْتَ تَجْحَدُ وَالمَدامِعُ تَشْهَدُ","https://www.poetsgate.com/ViewPoem.aspx?id=63498",""],[5689,"حطمت لي يد القضا كل فلس","https://www.poetsgate.com/ViewPoem.aspx?id=143434",""],[5691,"جلد النمر","https://www.poetsgate.com/ViewPoem.aspx?id=206665",""],[5691,"بشائر النور","https://www.poetsgate.com/ViewPoem.aspx?id=206731",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[5747,"موعد غيابك","https://www.poetsgate.com/ViewPoem.aspx?id=61668",""],[5795,"نصرت دولة المهى التركيه","https://www.poetsgate.com/ViewPoem.aspx?id=167910",""],[5956,"كل يوم نحن في حب جديد","https://www.poetsgate.com/ViewPoem.aspx?id=182078",""],[4442,"منطق الفن وهو بعض الأدلة","https://www.poetsgate.com/ViewPoem.aspx?id=171201",""],[6127,"يا ماشياً نحو الطفوف","https://www.poetsgate.com/ViewPoem.aspx?id=192767",""],[523,"هل لُغْزِي هذا مَفْهُومٌ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=100021",""],[6142,"أغضض اللحظ عن محبك غمزا","https://www.poetsgate.com/ViewPoem.aspx?id=155732",""],[6223,"أعتقيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1205&r=&rc=12",""],[6225,"شهر الهدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80903&r=&rc=172",""],[5080,"عن حجّ شريان الحروف لقدسه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88136&r=&rc=6",""]],"verses":[["وَأَقامَ أَسواقَ الضِرابِ فَلِلرَدى","فيهِنَّ مِن سَبيِ النُفوسِ رَقيقُ",0,"ق",1,0],["وَأَقارِبٌ جَعَلوا العُقوقَ سَجِيَّةً","يَتَوارَثونَ سَفاهَةً عَن قُعدُدِ",1,"د",1,0],["وأقامَ الحَقَّ وجاءَ بهِ","فإذا بالباطِلِ قدْ زهَقا",2,"ق",2,0],["وأقامَ بيْنَ ظُهورِه لا يتّقي","وقْعَ الرّدى وقد ارْتَمى بشَرارِ",3,"ر",1,0],["وَأَقامَ البَيانُ في كُلِّ نادٍ","مَأتَماً لِلبَدائِعِ الرَائِعاتِ",4,"ت",1,0],["وَأَقامَ إِبراهيمُ أَبلَغَ حُجَّةٍ","أَنَّ العَرينَ يَحُلُّهُ ضِرغامُ",5,"م",1,0],["وَأَقاموا لِلبِرِّ داراً فَكانَت","خَيرَ وِردٍ يَؤُمُّهُ كُلُّ ظامي",6,"م",2,0],["وَأَقامَ دينَ عِبادَةِ ال","دينارِ بَينَ الأَظهُرِ",7,"ر",1,0],["وَأَقَامَتْ دَارَ عِلْمٍ نَشَّأَتْ","خَيْرَ جِيلٍ مِنْ بَنَاتٍ وَبَنِينْ",8,"ن",1,0],["وأقام مفروض الجهاد بعزمةٍ","تركت بأفئدة العداة فلولا",9,"ل",2,0],["وأقاموا لهم لها كلّ صرح","مشمخرّ بناؤه اشمخرارا",10,"ر",2,0],["وأقاموا بها قواعد جوٍّ","لاحتشاد الجنود والطيران",11,"ن",1,0],["وأقام منها للنفوس حوافزاً","تدع الأسير من القلوب طليقا",12,"ق",2,0],["وأقاموا أعلى الجفان ملاءً","قَمَعاً وارياً كسوه الخميرا",13,"ر",2,1],["وَأَقاموا حَتّى أُزيروا شُعوباً","وَالقَنا في نُحورِهِم مَحطومُ",14,"م",1,0],["وَأَقامَ العِزُّ فينا وَالغِنى","فَلَنا مِنهُ عَلى الناسِ الكُبُر",15,"ر",1,0],["وأقامَ في أوقاتِ خدمتهِ","فرضَ الثنا ودَعا إلى ندْب",16,"ب",1,0],["وأقامَ سهرانَ اليراعِ إذا","ما نامَ جفنُ الصارم العضَب",16,"ب",1,0],["وأقامت يد الزمان عليًّا","لقضايا قرَعنَ سنَّ الرّماح",17,"ح",1,0],["وأقاما في الغار والملأ العلوي","يرنو إليهما بالرعاء",18,"ا",2,0],["وأقال جَدّي بعد طولِ عِثارهِ","لا زلتَ للجدِّ العثورِ مُقيلا",19,"ل",2,0],["وَأَقامَت بَعدَنا مِن أَرضِنا","في نَعيمٍ لَم تَجِدهُ في الغُيوم",20,"م",1,0],["وَأَقامَ يَقرَعُهُ فَأَقبَلَ بُطرُسٌ","ذو الأَمرِ في الفِردَوسِ وَالسُلطانِ",21,"ن",1,0],["واقام حرص الجاه بي","ن الحق والابصار سدا",22,"د",2,0],["وأَقَامَهُ صِنْواً لأَحْ","مَدَ دَوْحُهُ لَنْ يُنْحَتا",23,"ت",2,0],["وأقامَ للأجنادِ هيبتَه","حتى صَفا للدولة الشرْبُ",24,"ب",1,0],["وَأَقامَ مِن صَعَرِ الأُمو","رِ وَقَد أَبَت إِلّا التَأَوُّد",25,"د",1,0],["وَأَقامَت بِجَوِّ بِطياسَ حَتّى","كَثُرَ اللَيلُ دونَها وَالنَهارُ",26,"ر",1,0],["وَأَقامَ يُنفِذُ في الجَزيرَةِ حُكمُهُ","وَيَظُنُّ وَعدَ الكاذِبينَ صَدوقا",27,"ق",2,0],["وَأَقامَ يَطمَعُ في تَهَضُّمِ جانِبي","مَن لَم يَكُن مِن قَبلُ فيهِ يَطمَعُ",28,"ع",1,0],["وأقامَ مشهورَ المَكا","نِ غريبَ مشهورِ الفَضائل",29,"ل",1,0],["وأقامَ يُعمِلُ في العَدوْ","وِ ظُبا العواسلِ والبَواتر",30,"ر",1,0],["وأقامَ يقظانَ العزيمةِ ساهراً","بالثَّغرِ يكلأُ نائماً لم يَسهَرِ",31,"ر",1,0],["وَأَقامَت لِلعاشِقينَ دَليلاً","واضِحاً في جَوازِ نَهبِ النُفوسِ",32,"س",1,0],["وإقامَةُ الأسطولِ تؤذنُ بَغْتَةً","بِقِيامةِ الأعداءِ والحُسّادِ",33,"د",1,0],["وَأَقاحٍ مُنَوَّرٌ في بِطاحٍ","هَزَّهُ في الصَباحِ رَوضٌ أَريضُ",34,"ض",1,0],["وَأَقامَ فَوقَهُمُ العَجاجَةَ كِلَّةً","وَأَدارَ بَينَهُمُ الرَدى أَقداحا",35,"ح",2,0],["وأقام الحقَّ يَهْوي حولَهُ","كلُّ عالٍ من قِلاعِ المبطِلينْ",36,"ن",1,0],["وأقامَ للأحزانِ من صَلَواتها","نُسْكَ الهُداةِ وسُنّةَ الأبرارِ",37,"ر",1,0],["وأقامَ للشركِ المذمَّمِ مَأتماً","يَستعذِبُ الإسلامُ رَجْعَ أنينِهِ",38,"ه",1,0],["وأقامَ للَّهِ الولائمَ كلّما","زَادتْ وفودُ القومِ قال لها ازْدَدِي",39,"د",2,0],["واقاحٍ وسوسَنٌ مسبطرُّ","يسطع المسكُ منه عند الشمام",40,"م",1,0],["وَأَقالَ مِن عَنَتِ الزَما","نِ وَقَد يَئِستُ مِنَ المَقيلِ",41,"ل",1,0],["وَأَقامَ يُشفِقُ أَن يُجَنَّ صَبابَةً","وَيَخافُ مَوتَةَ قَلبِهِ إِن عادا",42,"د",2,0],["وأقاموا لفتحهم حفلةً أع","قبها منهم الهتافُ الكثير",43,"ر",1,0],["وَأَقَامَ أَصْحَابُ البِلاَدِ مَآتِماً","وَكَسَوْا عَلَى القَتْلى ثِيَابَ حَدَادِ",44,"د",1,0],["وَأَقَامُوا زِينةً جُنحَ الدُّجَى","جَعَلَت رُومَا سَمَاوَاتٍ وَزُهْرَا",45,"ر",2,0],["وَأَقَالَ الأَعْرَاضَ مِنْ عَثَرَاتٍ","مُسْتَعَانٌ مَا ضَنَّ بِالإِنْجَادِ",46,"د",1,0],["وأقابِلَ منك سنى قمرٍ","لو قابلَه الأَعمَى لهُدِي",47,"د",2,0],["واقامتك في مقامات ذي التح","قيق حتى نزلت وادي طواها",48,"ا",3,0],["وأقاضى وأجنحتي","وأقماري وغيماتي",49,"ت",2,0],["وأقامت بعدنا من أرضنا","في نعيم لم يجده في الغيوم",50,"م",1,0],["وأقام يفرعه فأقبل ((بطرس))","ذو الأمر في الفردوس والسّلطان",51,"ن",1,0],["وأقام جدران الحقيقة في الورى","بيد الكمال لحاضر ولباد",52,"د",1,0],["وأقامه عنه خليفة أمره","وأعانه بسكونه ومروره",53,"ر",2,0],["وأقام بنيان الهدى","وأبان منهاج الورود",54,"د",1,0],["وأقام ركن الدين بالعزم الذي","ذلت له الآساد في البيداء",55,"ا",2,0],["وأقامنا في عزةٍ ومسرةٍ","وأجارنا من شدةِ الأزمانِ",56,"ن",1,0],["وأقام في منجٍ نعيّاً دائماً","في كل منزلة وكلِّ مقامِ",57,"م",1,0],["وأقام فيما بين أضلعنا","فبطونُنا من أجْلهِ بِرَكُ",58,"ك",1,0],["وأقام في دار النعيم فأرخوا","في جنةِ الفردوسِ أسكن بيرمُ",59,"م",1,0],["وَأَقامَ لِلدينِ الحَنيفِ عِمادَهُ","فَأَقامَ عُبّادَ المَسيحِ وَأَقعَدا",60,"د",2,0],["وَأَقامَ هَذا المُلكُ أَخضَرَ لائِذاً","بِفِنائِهِ الوُرّادُ وَالرُوّادُ",61,"د",1,0],["وأقام في بيت الفقيه فما بقى","لخيارهم بيت الفقيه بقية",62,"ه",1,0],["وأقام ملتمسا لفضلكم الذي","ما خاب ظنا فيه ملتمسوه",63,"و",2,0],["وَأَقامَ بِحُسنِ سِياسَتِهِ","شُوسَ الأَملاكِ عَلى النِّقَمِ",64,"م",1,0],["وَأَقامَ في رَمسٍ مَلائكةُ العُلى","أَبَداً عَلَيهِ بِالرضى تَتَرَدَّدُ",65,"د",1,0],["وَأقاموا بِها ثلاثاً وطافوا","حلّقوا قصّروا وَسيقت دماءُ",66,"ا",2,0],["وأقاسي من الضنا والسقام","ما أقاسي وأنت تلهو أمامي",67,"م",2,0],["وأقامَ أحزاني وأقعدَها","في جانِحَيَّ تَرَنُّمُ الوَتَرِ",68,"ر",1,0],["وأقاحِ ثَغرِ كم نظَم","تُ ببنتهِ إكليلَ غاري",69,"ر",2,0],["وأقامَ هرونُ الرشيدُ وإبنُهُ","المأمونُ صرحَ العلم في بغدان",70,"ن",1,0],["وأقام في يوم اليمامة دينه","بقواضب وبعامل وزجاج",71,"ج",1,0],["وَأَقامَ يَعرِضُ نَفسَهُ حَتّى اِلتَقى","مِن خَزرَجٍ بِالسَّتَّةِ الشُجعانِ",72,"ن",1,0],["وَأَقامَ مُصطَبِراً وَعُيِّرَ صَحبهُ","حيناً لِمُرِّ الهَجرِ وَالهِجرانِ",72,"ن",1,0],["وَأَقامَ سَبعاً لا يريمُ فَجاءَه","شاكٍ يَخافُ تَهَدُّمَ الحيطانِ",72,"ن",1,0],["وَإِقالَةٍ عَثَراتِ دَهرٍ لَم تَكُن","لِتُقالَ إِلّا عِندَهُ عَثَراتُهُ",73,"ت",2,0],["وأقام مؤتمر الكويت لكي يرى","هل للهدى بين الغرور سبيل",74,"ل",1,0],["وَأقَامَهُ للنَّاسِ يَجْمَعُهُمْ عَلَى","سُلْطَانِهِ وَرَآهُ خَيْرَ قِوَامِ",75,"م",1,0],["وَأَقامَ بِحَيثُ يُفَضِّلُ بُر","جَ الشَمسِ عَلى بُرجِ الحَمَلِ",76,"ل",1,0],["وَأَقامَ السُنورُ فيهِ بشر","يَسأَلُ اللَهَ ذا العُلا وَالجَلالَه",77,"ل",2,0],["وَأَقامَ السِنَورُ في البَيتِ حَولاً","ما يَرى في جَوانِبِ البَيتِ فارَةِ",78,"ر",2,0],["وأقام به شعائر الدين","المرتضى عنده لكل الأنام",79,"م",1,0],["وأقامه داع إليه بقوله","وبفعله من غير ما إنكارا",80,"ر",2,0],["وَأَقاموا عَلى الجَوازِ بَراهي","نٌ وَمِنها أَبراؤُهُ لِلشَعفَه",81,"ف",2,0],["وَأَقَامُوا الحَدِيثَ بَينُهُمُ واندَ","فَعُوا في غَرائبِ الأَخْبارِ",82,"ر",1,0],["وَأَقام الدَليل كَالشَمس يَبدو","نورها مُشرِقاً بِدون حِجابِ",83,"ب",1,0],["وإقامةٌ للعُذْرِ منكم خِيفةً","أن يَشْمَتَ المُتتَبِّع العَيّاب",84,"ب",1,0],["وأقام مَنكِبَ أرضٍ استَبْطنتَها","وعليه من وَشْيِ الرّياض رِداء",85,"ا",2,0],["وَأَقاح الرَوض في الوَصف","ثُغور الغانيات",86,"ت",1,0],["وَأَقامَ الرَأسَ وَقعٌ صادِقٌ","بعدَ ما صافَ وَفي الخَدِّ صَعَر",87,"ر",1,0],["وأقام في الساحاتِ أَلْفَ مجسَّمٍ","تسبي برونق حُسْنها الأبصارا",88,"ر",2,0],["وأقاحٍ وورودِ","مِن ثغورٍ وخُدودُ",89,"د",1,0],["وأقاموا الشراع يستجلبوا الري","ح وأبدى هناك احتياله",90,"ل",2,0],["وَأَقامَ في شيرازَ سَبعَةَ أَشهُرِ","وَأَناب مِن كُلِّ بِخُفِّ حُنَينِ",91,"ن",1,0],["وَأَقامَ مُعتَكِفاً عَلى هِجرانِهِ","فَهَجَرتُ صَبري حينَ عَزَّ غَرامي",92,"م",2,0],["وأَقاموا حِيالَ قلبِيَ عَيْناً","أَلْقَحَتْ حَرْبَ حُبِّهِمْ عن حِيالِ",93,"ل",1,0],["وأَقامَتْ لثَغْرِ دِمْيَاطَ ثغراً","ضاحكاً عن كُمَاتِها يَتَلالا",94,"ل",2,0],["وأَقاماهُ للوزارةِ كهفاً","مانعاً كلَّ ناهضٍ أَن يقوما",95,"م",2,0],["وأَقامَني أَرعى جبينَك ثانياً","فَسَجَدْتُ أُلْصِقُ بالترابِ جبيني",96,"ن",2,0],["وأقامتهُ حائراً لا يُحقُّ ال","وهْدَ وهداً ولا البِطاحَ بِطاحا",97,"ح",2,0],["وأقامَ بنيانَ الفَخارِ مشيَّداً","ما بينَ بِيضِ ظُبىً وسُمرِ عَوال",98,"ل",1,0],["وأقامَ يمسحُ عِطْفَ شوقٍ جامحٍ","في راحةِ العَبَراتِ ثُنْيُ عِنانِه",99,"ن",2,0],["وإِقالَةُ العَثَراتِ أَحْ","يا لِلنُّفوسِ مِنَ الرَّدى",100,"ا",1,0],["وأقام في قلبي وأوقد ناره","فيه ورد فقيره عن برّه",101,"ر",2,0],["وأقام الراضي يفرق ما بي","ن الندامى في كل وقت نثاره",102,"ر",2,0],["وأقامَ م