{"poems":[[53,"إنما يبكي شجي شجنه","https://www.aldiwan.net/poem66464.html","الرمل"],[47,"صنت نفسي عما يدنس نفسي","https://www.aldiwan.net/poem64601.html","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[47,"صُنْتُ نَفْسِي عَمّا يُدَنّس نفسي","https://www.poetsgate.com/ViewPoem.aspx?id=31225",""],[53,"إنما يبكي شجيُّ شَجَنَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=30804",""],[240,"وأغن معسول المراشف","https://www.aldiwan.net/poem31819.html","مجزوء الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204703","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110112","الكامل"],[5689,"ذره يرن بضوء ذا السحر","https://www.poetsgate.com/ViewPoem.aspx?id=143405",""],[6032,"طنب الجريحة","https://www.poetsgate.com/ViewPoem.aspx?id=181528",""]],"verses":[["يتظنَّى دُهْنَه في شَعَثِي","شَعَّثَ اللَّه له ما دهنه",0,"ن",2,0],["يُتَظَنّى مِنَ الكَآبَةِ إِذ يَب","دو لِعَينَي مُصَبِّحٍ أَو مُمَسّي",1,"س",2,0],["يَتَظَاهَرْن بالْحِجَأب وَهَلْ أَذ","كَى الجَوَى غَيْرُ لُؤْمِ ذاك الحِجابِ",2,"ب",1,0],["يُتَظَنّى منَ الكَآبَةِ أنْ يَبْ","دُو لعَيْني مُصَبِّحٌ، أوْ مُمَسّي",3,"س",2,0],["يتظنَّى دُهنَه في شَعَثِي","شَعَّثَ الله ما دهنه",4,"ن",2,0],["يَتَظَلَّمُ الخَصرُ الضَعيفُ","إِلَيهِ مِن ثِقَلِ الرَوادِف",5,"ف",1,0],["يتظاهرن فرحة بقدومي","مفصحات بالزقزقات كلاما",6,"م",2,0],["يتظاهرونَ بغَيرةٍ إِيليَّةٍ","هم كهنةُ الالصون أَغوَوا وانغَوَوا",7,"و",3,0],["يتظاهرون بكل مكرمة","ولطافة في النطق والنظر",8,"ر",1,0],["يتظاهرون بدين رب محمد","وفعالهم تأبى على الأديان ِ",9,"ن",1,0]]}