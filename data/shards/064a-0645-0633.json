iewPoem.aspx?id=204917",""],[5362,"قالوا التمدن قلت ذاك سراب","https://www.poetsgate.com/ViewPoem.aspx?id=170372",""],[5491,"أشكو غيابك","https://www.poetsgate.com/ViewPoem.aspx?id=215158",""],[5582,"شاقَتْكَ هِنْدٌ وَأَمْسَى الحَبْلُ مُنْصَرِمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63568",""],[5596,"من وحي \"بون\"","https://www.poetsgate.com/ViewPoem.aspx?id=206482",""],[5616,"قومي","https://www.poetsgate.com/ViewPoem.aspx?id=203485",""],[5642,"الدمع والدم","https://www.poetsgate.com/ViewPoem.aspx?id=144554",""],[5786,"إن رمتَ منّي السلوَّ بالفند","https://www.poetsgate.com/ViewPoem.aspx?id=50657",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[6008,"بمناسبة شفاء الملك عبدالله بن عبدالعزيز","https://www.poetsgate.com/ViewPoem.aspx?id=61399",""],[5309,"مهارة المرء في الدنيا استقامته","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573833",""],[5014,"عاطفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76221&r=&rc=17",""],[6288,"فضاء وانطلاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78108&r=&rc=32",""]],"verses":[["يُمَسَّحُ أَضغانَ العَدوِّ وَإِنَّما","يُقَبِّلُ ثَغراً مِن ثُغورِ الأَراقِمِ",0,"م",1,0],["يُمسونَ شُعثاً وَيُمسي في بَلَهنِيَةٍ","كَأَنَّما جَدُّهُ عَدنانُ أَو مُضَرُ",1,"ر",1,0],["يُمسي بَطيناً مِن دَمِ ال","عَداءِ وَهوَ مُضطَمِر",2,"ر",1,0],["يُمسي وَمَنزِلُ ضَيفِهِ لا يُحتَوى","كَرَماً وَبَيتُ نُضارِهِ لا يُقلَدُ",3,"د",1,0],["يُمَسِّحُ خَلفَ الشَرِّ ذاكَ بِخيفَةٍ","وَهَذا طَويلُ الباعِ يَمري فَيَحلُبُ",4,"ب",1,0],["يُمسي وَلينُ مِهادِهِ حَصباؤُهُ","فيهِ وَمُؤنِسُ لَيلِهِ ظَلماؤُهُ",5,"ا",3,0],["يُمْسي إذا الليلُ ارْجَحَنَّ ظِلُّهُ","في شُغُلٍ عنِ الرُّقادِ شاغِلِ",6,"ل",1,0],["يُمسي وَيُصبِحُ مُعرِضاً مُتَغَضِّباً","وَإِذا قَصَدتُ إِلَيهِ فَهوَ يَحيدُ",7,"د",1,0],["يُمَسِّحنَ عَن أَعطافِهِ حَسَكَ اللِوى","كَما تَمسَحُ الرُكنَ الأَكُفُّ العَوابِدُ",8,"د",1,0],["يُمَسِّحنَ يا رُخمانُ في كُلِّ بيعَةٍ","وَما نِلنَ مِن قُربانِهِنَّ المُقَرَّبِ",9,"ب",1,0],["يُمسي إِذا طَرَقَ الضِو","فُ فِناؤُها بِفِنائِيَه",10,"ي",2,0],["يُمسي وَكُلُّ بِلادٍ حَلَّها وَطَنٌ","وَكُلُّ قَومٍ غَدا فيهِم عَشائِرُهُ",11,"ر",2,0],["يُمْسي ويُصْبِحُ من وَضاءة أمرِهِ","وكأنِّما إمساؤه إصباحُهُ",12,"ح",2,0],["يُمْسِي ويُصبح في رياضَةِ نفسه","لتطيبَ عن رِفْدٍ وليس برافدِ",13,"د",1,0],["يُمسي وَيُصبِحُ وَهوَ مُنطَرِحٌ عَلى","أَقدامِهِ طَمَعاً بِما يَحويهِ",14,"ي",2,0],["يُمسي ضَجيعَ خَريدَةٍ وَمُضاجِعي","عَضبٌ رَقيقُ الشَفرَتَينِ حُسامُ",15,"م",1,1],["يُمسي وَيُصبِحُ في أَوامِرِ دينِهِ","وَأُمورِ دُنياهُ بِكُم مُستَبصِرا",16,"ر",2,0],["يُمسِكُ فاهُ خَشيَةَ السُعالِ","مِن مَطلَعِ الشَمسِ إِلى الزَوالِ",17,"ل",1,0],["يُمسي السَحابُ عَلى أَجبالِها فِرَقاً","وَيُصبِحُ النَبتُ في صَحرائِها بَدَدا",18,"د",2,0],["يُمسي قَريباً مِنَ الأَعداءِ لَو وَقَعوا","بِالصينِ في بُعدِها ما اِستَبعَدَ الصينا",19,"ن",2,0],["يُمْسي به الحُسْنُ والإِحْسانُ في قَرَنٍ","ويُصبحُ الخِيمُ في مَعناه والخِيَمُ",20,"م",1,0],["يَمسحْنَ جَعدَ غَدائري وكأنَّما","يَمسَحْنَ بالمِسكِ الذكيِّ سَلاسِلا",21,"ل",2,0],["يُمسِّحُ بالمِسكِ الذَّكيَّ مُرَجَّلاً","يَرُفُّ على المتنينِ مِثلَ السَّلاسلِ",22,"ل",1,0],["يُمسي وَيُصبِحُ طالِبُ الدُن","يا مُعَنّى مُتعَبا",23,"ب",2,0],["يُمسي وَيُضحي مُقيماً في مَبائَتِهِ","وَبَأسُهُ في كُلى الأَقوامِ مُرتَحِلُ",24,"ل",1,0],["يُمسي وَيُصبِحُ عَرضُهُ في صَخرَةٍ","دَمَغَت شَواةَ العائِبِ العَضّاهِ",25,"ه",1,0],["يُمسي لِما صنع الحُسَينُ ورهطُه","في مأتمٍ بين الضُّلوع مُقام",26,"م",1,0],["يَمسَحُ الأَرضَ بِمُعنَوِنسٍ","مِثلِ مِئلاةِ النِياحِ الفِئام",27,"م",1,0],["يُمسي وَيُصبِحُ جَوفُهُ مِن قوتِهِ","وَبِهِ لِمُختَلِفِ الهُمومِ مَجاري",28,"ر",2,0],["يُمسي بِعَقوَتِها الهِجَفُّ كَأَنَّهُ","حَبَشِيُّ حازِقَةٍ غَدا يَتَهَبَّدُ",29,"د",1,0],["يُمسِي ويُصْبِحُ مُتْهِماً أَوْ مُنْجِداً","لِمعادِهِ معَ مُتْهِمٍ أَوْ مُنْجِدِ",30,"د",1,0],["يُمْسِي وَيُصْبِحُ في تَدْبِيرِ مَمْلَكَةٍ","أعْيا الخلائقَ فيها بعضُ ما يَزِرُ",31,"ر",1,0],["يُمْسِي وَيُصبِحُ طاوِياً أحْشاءَهُ","كَرَماً عَلَى سَغَبٍ وحَرِّ أُوَامِ",32,"م",1,0],["يمسح أيري كلّما نكتهُ","كأنما يمسحُ رأسَ اليتيم",33,"م",1,0],["يُمسي وَيُصبِحُ هائِماً بِكُمُ","وَيُهالُ بِالتَرويعِ وَالسَهَدِ",34,"د",1,0],["يُمسي كَبَعضِ الرَومِ أَبيَضَ بارِداً","وَلَقَد يَكونُ كَأَنَّهُ بَعضُ الحَبَش",35,"ش",1,0],["يُمسي وَقَد مَلَّ البَقاءَ وَيَغتَدي","وَلَهُ رَجاءٌ فيهِ لَيسَ يَمَلُّهُ",36,"ل",2,0],["يُمسي عَلى حَدِّ المُهَنَّدِ أَخمَصي","فَتَرى اليَسيرَ مَن مِنَ الأُمورِ يُزِلُّهُ",36,"ل",2,0],["يُمْسي الطّريدُ أمامَها وكأنّهُ","أسَدُ الشَّرَى أوْ طائرٌ بشَرَافِ",37,"ف",1,0],["يُمْسي ويُصْبِحُ كوزُنا من فِضّةٍ","مَلأتْ فَمَ الصّادي كُسُورَ دراهِم",38,"م",1,0],["يمْسحُ النَّعْسةَ مِنْ عيْنَيْ رشا","صائِدٍ في كُلِّ يوْمٍ أَسدا",39,"د",2,0],["يَمَسُّ جَبينَ النيل في رِفْقِ عاشقٍ","وتفْتَحُ أكمامَ الزهورِ مَسَاحِلُهْ",40,"ل",2,0],["يمس أوتاره مسًّا؛ فينطقها","كأنما هي أرواح تناجيه",41,"ي",2,0],["يُمسي ويُصبح يستظلُّ بِخِدنه","بَقَر الزَريب، ويرتَعي ويَنام",42,"م",1,0],["يمسهّر النوّيم ومحضضّ النوم","الله يكافيك الليال وسهرها",43,"ر",3,1],["يُمسي الجَليس بهم في روض كل تَقي","من العلوم حكت الحان مطربهِ",44,"ب",2,0],["يُمسى ويُصبح في المضي","قِ ودمعُه في الخَدِّ ساكبْ",45,"ب",1,0],["يمسي الفتى يتمنى العام يقطعه","وذلك العام محسوب من العمرِ",46,"ر",1,0],["يمسى يعضُّ يمينه ندماً ويأ","كلُ كفه وفؤاده يتلهّبُ",47,"ب",1,0],["يمسي كتاب الله منشوراً له","ليرى ويقرا ناظراً ما قالا",48,"ل",2,0],["يمسي يخيل لي ابتسامك خاطري","مهما رأيت وميضَ برق قد سرى",49,"ر",2,0],["يمسي الفتى المملوك لاقى أرضكم","ملكاً قريب العهد بالإِرغامِ",50,"م",1,0],["يمسي على بعد المدى ولنارهِ","في كلِّ أرضٍ لذعةٌ وشرَارُ",51,"ر",1,0],["يمسي الخليُّ وقلبه مستأمنٌ","والخوفُ للقلب الشجيِّ شِعارُ",51,"ر",1,0],["يمسي ويصبح قادرا","بين المواكب والعساكر",52,"ر",1,0],["يمسي ومعتل النسيم مدامه","والنجم في أفق السماء نديمه",53,"م",2,0],["يمسي ويصبح وهو يخشى فتنة","صماء للصعب اللواتي تدنخ",54,"خ",1,0],["يُمسي الفَتى فيهِ يَرومُ زِيادَةً","ترضي فَيُصبِحُ وَهوَ في نُقصانِ",55,"ن",1,0],["يُمسي بِمَن يُمسي بِهِ","مُتَيَّماً مُتَيَّما",56,"م",2,0],["يُمسي عَلى المُوَرِّقِي","يِ عَينُهُ مُؤَرَّقَه",57,"ق",2,0],["يُمسي وَسُلطانُهُ مُطاعٌ","وَهوَ لِسُلطانِ