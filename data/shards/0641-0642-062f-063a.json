{"poems":[[55,"تكشف ظل العتب عن غرة العهد","https://www.aldiwan.net/poem30623.html","الطويل"],[88,"دعاني رفاقي والقوافي مريضة","https://www.aldiwan.net/poem10483.html","الطويل"],[88,"ماذا أصبت من الأسفار والنصب","https://www.aldiwan.net/poem10508.html","البسيط"],[88,"بلابل وادي النيل بالمشرق اسجعي","https://www.aldiwan.net/poem68896.html","الطويل"],[37,"لقد كنت للمظلوم عزا وناصرا","https://www.aldiwan.net/poem38820.html","الطويل"],[37,"عفت غيقة من أهلها فحريمها","https://www.aldiwan.net/poem38833.html","الطويل"],[29,"تعللنا أمامة بالعدات","https://www.aldiwan.net/poem5692.html","الوافر"],[45,"أعيدوا صباحي فهو عند الكواعب","https://www.aldiwan.net/poem9506.html","الطويل"],[64,"تجربة المرء عن يقين","https://www.aldiwan.net/poem52144.html","مخلع البسيط"],[47,"أرى بين ملتف الأراك منازلا","https://www.aldiwan.net/poem65533.html","الطويل"],[33,"قل للذي يهوى تفرق بيننا","https://www.aldiwan.net/poem41860.html","الطويل"],[77,"ألا أيها الوادي المقدس بالندى","https://www.aldiwan.net/poem69025.html","البسيط"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140929",""],[53,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[131,"يا من لقلب شديد الهم محزون","https://www.aldiwan.net/poem24221.html","البسيط"],[146,"ما زال يكشف عنى كل طارقة","https://www.aldiwan.net/poem58377.html","البسيط"],[164,"عيد حظى بك والأعياد تقتتل","https://www.aldiwan.net/poem58929.html","البسيط"],[173,"دع الدار بالبحرين تعفو ربوعها","https://www.aldiwan.net/poem1634.html",""],[214,"كفاني حزنا أن أضر بي الهجر","https://www.aldiwan.net/poem13494.html","الطويل"],[234,"كللت ودك لي بالبر والنفل","https://www.aldiwan.net/poem50842.html","البسيط"],[234,"وزنجية الآباء كرخية الجلب","https://www.aldiwan.net/poem51235.html","الطويل"],[268,"إما ترينا وقد خفت مجالسنا","https://www.aldiwan.net/poem453.html",""],[287,"أدر يا صاح كاسات العقار","https://www.aldiwan.net/poem32776.html","الوافر"],[308,"مخايل قد بدت عليه","https://www.aldiwan.net/poem58054.html","مخلع البسيط"],[327,"بان السفاء وأودى الجهل والسرف","https://www.aldiwan.net/poem56340.html","البسيط"],[369,"سهام نواظر تصمي الرمايا","https://www.aldiwan.net/poem60572.html","الوافر"],[369,"عهد هوى كنا عهدناه","https://www.aldiwan.net/poem60599.html","السريع"],[369,"لولا طروق خيال منك منتظر","https://www.aldiwan.net/poem60919.html","البسيط"],[376,"بعض بنات الزمن","https://www.aldiwan.net/poem57080.html","مجزوء الرجز"],[382,"قلب يذوب إلى الأطلال والحلل","https://www.aldiwan.net/poem59287.html","البسيط"],[409,"فقد غش في الأديان من كان عالما","https://www.aldiwan.net/poem33445.html","الطويل"],[409,"ثوى جبل العلم الذي طال واندكا","https://www.aldiwan.net/poem33612.html","الطويل"],[422,"بكت بدم من بعد عيسى وبندر","https://www.aldiwan.net/poem54120.html","الطويل"],[447,"أيا رب قد ألقيت رحل رجائي","https://www.aldiwan.net/poem14287.html","الطويل"],[447,"أرى بدرا فصار به هلالا","https://www.aldiwan.net/poem14472.html","الوافر"],[463,"خذ من يدي صفقة الأماني","https://www.aldiwan.net/poem55855.html","مخلع البسيط"],[471,"ألا طرقت ليلى فأحزن ذكرها","https://www.aldiwan.net/poem50373.html","الطويل"],[498,"نحن بجود الأمير في حرم","https://www.aldiwan.net/poem67320.html","المنسرح"],[534,"يا حبذا كلام","https://www.aldiwan.net/poem37445.html","مجزوء الرجز"],[543,"دعوني فإني لا أطيق التكلما","https://www.aldiwan.net/poem47949.html","عموديه"],[558,"يا ليلة نلت فيها اللهو والوطرا","https://www.aldiwan.net/poem68404.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138331",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138227",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83296","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122679","الطويل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96975","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86669","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37931","البسيط"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21667","البسيط"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109333","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53166","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53168","الرجز"],[2491,"","https://poetry.dctabudhabi.ae/diwan/poem/115066","الهزج"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83220","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202989","الخفيف"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/132081","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100725","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89149","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48313","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126920","الطويل"],[3810,"","https://poetry.dctabudhabi.ae/diwan/poem/18732","الطويل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44905","الطويل"],[4030,"","https://poetry.dctabudhabi.ae/diwan/poem/20891","البسيط"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/107044","الطويل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45013","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28619","الطويل"],[5145,"سقى السرح من وادي الآراك هطول","https://www.poetsgate.com/ViewPoem.aspx?id=108051",""],[5190,"إن تُتهمي أو تُنجدي","https://www.poetsgate.com/ViewPoem.aspx?id=153359",""],[5320,"تحية نصر","https://www.poetsgate.com/ViewPoem.aspx?id=42037",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[5413,"رفقًا بهِ","https://www.poetsgate.com/ViewPoem.aspx?id=200553",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6004,"الخَطِيئة","https://www.poetsgate.com/ViewPoem.aspx?id=59138",""],[6004,"شَكوَى الحَمَامِ","https://www.poetsgate.com/ViewPoem.aspx?id=71984",""]],"verses":[["فَقَد غاضَ سُخطانا فَهَل مِن صَبابَةٍ","بِرَأيِكَ إِنّي قَد تَصَرَّمَ ما عِندي",0,"د",2,0],["فَقَد غابَ عَنّا يَومَ غابَ وَلَم يَكُن","لَهُ بَينَ هالاتِ النَوابِغِ ثاني",1,"ن",2,0],["فَقَد غَدَت مِصرُ في حالٍ إِذا ذُكِرَت","جادَت جُفوني لَها بِاللُؤلُؤِ الرَطِبِ",2,"ب",1,0],["فَقَد غَمَرَتها مِحنَةٌ فَوقَ مِحنَةٍ","وَأَنتَ لَها يا شاعِرَ الشَرقِ فَاِدفَعِ",3,"ع",1,0],["فَقَد غَنِيَت إِذ كُنتَ فيها رَخِيَّةً","وَلَكِنَّها قِدماً كَثيرٌ فُنونُها",4,"ن",3,0],["فَقَد غادَرَت في القَلبِ مِنّي زَمانَةً","وَلِلعَينِ عَبراتٍ سَريعاً سُجومُها",5,"م",3,0],["فَقَد غَرِقَ الفَرَزدَقُ إِذ عَلَتهُ","غَوارِبُ يَلتَطِمنَ مِنَ الفُراتِ",6,"ت",1,0],["فَقَد غَيَّبَ الشُهّادَ عَن كُلِّ مَوطِنٍ","وَرَدَّ إِلى أَوطانِهِ كُلَّ غائِبِ",7,"ب",1,0],["فقد غدا في الطريق يمشي","لا هو أعمى ولا بصير",8,"ر",1,0],["فَقَد غُرتَ بِالغاراتِ في وَهَداتِهِم","وَلِيّا وَوَسمِيّاً رَذاذاً وَوابِلا",9,"ل",2,0],["فَقَد غَنِيَت نَفسي وَأَنتَ بِهَمِّها","فَقَد جَعَلَت وَالحَمدُ لِلَّهِ تَذهَلُ",10,"ل",1,0],["فقد غدتِ الآجام وهي حدائق","وعاد زئير الليث وهو شهيق",11,"ق",1,0],["فقد غيب الشهاد عن كل موطنٍ","ورداً إلى أوطانه كل غائب",12,"ب",1,0],["فقد غدا حلمي لجهلي غامدا","وحصّن العهدَ بسورٍ آمِدا",13,"د",2,0],["فَقَد غَنَينا وَشَملُ الدَهرِ يَجمَعُنا","أُطيعُ رَيّا وَرَيّا لا تُعاصيني",14,"ن",2,0],["فقُدْ غلىَّ جيادا من ضوامرِها","صمَّ السنابكِ سَبْطاتِ الظَّنابيبِ",15,"ب",1,0],["فقد غنيت بكم عن علقة بفتى","يلفق القول في وصفي وينتحلُ",16,"ل",1,0],["فَقَد غَرَّها شُعٌّ يُسَدّيهِ جَهلُها","وَهَل عَن ضِعافِ المُولِ يُغني شُعُوعُها",17,"ع",3,0],["فقد غاب ليث الغاب واغتاله الردى","وافرده من بين اشباله الدهر",18,"ر",1,0],["فقد غَدا لك قلبي اليومَ أَجمعُه","يُصْفيك ودّا مقيما غيرَ مُنْتَقِل",19,"ل",1,0],["فقد غَصَّت الخُلجان حتى كأنّها","مَدائُن تَدعو من جيوشك بالحَرَب",20,"ب",1,0],["فقد غنينا وفينا سامرٌ غنجٌ","وساكنٌ وكأني الليلَ مرهُوبُ",21,"ب",1,0],["فَقَد غَنَّت عَلى الباناتِ فيهِ ال","حَمائِمُ وَالبَلابِلُ وَالقَماري",22,"ر",2,0],["فقد غدا وصله يقينا","أحسن ما كان في الخيال",23,"ل",1,0],["فَقَد غَشِيتُ لَها داراً تُشَوِّقُني","فَالعَينُ ساكِبَةٌ بِمِلئِها تَكِفُ",24,"ف",1,0],["فقد غَدَتِ المَمالكُ وهْي تُزْهَى","بعَدْلك من خَلائقِك الوَضايا",25,"ا",3,0],["فقد غدا النّصْرُ لدينِ الهُدَى","أُخْراه منّا بَعْدُ أُولاه",26,"ا",2,0],["فقد غدا الدّينُ يُغضي طَرْفَ مُضطَهَدٍ","وأَصبحَ الحقُّ يُخْفي شخصَ مُستَتِر",27,"ر",1,0],["فقَد غَدا مُؤتَمَناً","وليسَ بالمؤتَمِنِ",28,"ن",1,0],["فقد غدا بعماد الحق متصلاً","كما غدا باعتمادٍ غير منفصل",29,"ل",1,0],["فقد غش في الأديان من كان عالماً","وصوب من أخطى السلام وسلما",30,"م",2,1],["فقد غاض بحر الجود بعد اضطرابه","بأمواج بذل لا تحاي ولن تحكى",31,"ك",2,0],["فقد غاض بحر كلَّما مدّ راحة","إلى الوفد فاضت منه خمسة أبحر",32,"ر",1,0],["فقد غلقت أبواب خلقك سيدي","وبابك مفتوح ولست بناء",33,"ا",2,0],["فقد غاردنني بيدي هواها","تقلبني يميناً أو شمالا",34,"ل",2,0],["فقد غدت في أَبي المعالي","أسماؤهم تَصدُق المعاني",35,"ن",2,0],["فَقَد غَضِبَت أَن قُلتُ إِذ لَيسَ حاجَتي","إِلَيها وَقالَت لَم يُرِد أَن يُحِبَّنا",36,"ن",2,0],["فَقَد غَدَت بِاِسمِهِ وَصورَتِهِ","في دَهرِنا عوذَةً مِنَ العَدَمِ",37,"م",1,0],["فَقَدْ غَدا مُطَّرِحَا","جَميعَ ما قَدْ صَحَّحا",38,"ح",2,0],["فقد غابَ مَن نَهوَى وأضرمَ لوعتي","وزادَ بذِكراهُ الوُلُوعُ تَضَرُّما",39,"م",2,0],["فَقَد غَفَرتُ لَكَ الذَنبَ الَّذي زَعَموا","لا بارَكَ اللَهُ فيمَن بَعدَ ذا غَدَرا",40,"ر",2,0],["فقد غدوت لمرؤوسيك خير أب","بحبه قلب كل بينهم شغفا",41,"ف",2,0],["فقد غدا لبنيهم معهدا ادب","قاما ببر كرام طالما منحت",42,"ت",1,0],["فَقَد غُيِّبَت تِلكَ الفَضائِلُ كُلَّها","وَدارَت عَلى ذاكَ النُبوغُ دَوائِرُه",43,"ر",2,0],["فَقَد غاضَ عَنها بأسُها وسَماحُها","وأقطَعَ عَنها صَيفُها وخَريفُها",44,"ف",3,0],["فقد غاب منها في ثرى القبر نير","متى هي تستقبل محياه تشرق",45,"ق",1,0],["فَقَد غَردت فَوقَ الغُصون بَلابلٌ","وَغَنَت لَكَ الوَرقا عَلى أَثلات",46,"ت",1,0],["فَقَد غَزا ريحُه في ريحِ ذي نتَنٍ","فَفَرَّ مُنهَزِماً في خَوفِ مضطربِ",47,"ب",1,0],["فَقَد غَنينا زَماناً وُدُّنا حَسَنٌ","عَلى مَعاريضَ مِن لَومٍ وَإِهجارِ",48,"ر",1,0],["فقد غصبتهم الثوّار ملكاً","غدا الغوبة للغاصبينا",49,"ن",2,0],["فقد غدت صحته صحتها","وأصبح اعتلاله اعتلالها",50,"ل",3,0],["فقد غدا يهده","تهديده بالنقله",51,"ل",2,0],["فقد غدت أمواهها","لنار قلبي شعله",51,"ل",2,0],["فَقَد غَيَّرَ مَغناها","سُيُولُ الرِّيح والقَطرِ",52,"ر",1,0],["فَقَد غالَ الفُؤادَ هَوىً دَفينٌ","وَبَرَّحَ وَجدُكُم بِي في الخِتامِ",53,"م",1,0],["فقد غيري يزيد نفسي حتى","لو فقدت الوجود صرت وجودا",54,"د",2,0],["فقد غردت ورق المسرة بالهنا","وأصبح روض الأنس غضا نواره",55,"ر",2,0],["فقد غرست بوادي النيل نابتة","علمّها كيف تأتينا بأثمار",56,"ر",1,0],["فقد غدا حجراً يزري السماء سنا","لأن بانيَه ذا الكوكب الزاهرْ",57,"ر",1,0],["فقد غادرَتْهُ حالُه واهِيَ القُوى","وفي وَحَلٍ منْ غدرِه متورّطا",58,"ط",2,0],["فقد غربت منكم كواكب مجدكم","غداة تهاوت كوكبا بعد كوكب",59,"ب",1,0],["فَقَد غادَرَت لِلطِيرِ لَيلَةَ خَمسَها","حِواراً بِرَملِ النَغلِ لما يشعّر",60,"ر",1,0],["فَقَد غَصَّ حَلقي الغَربُ بِالسَخفِ وَالهَوى","وَآلمتموني أنتمُ بِالتكالبِ",61,"ب",1,0],["فقد غنينا وشمل الدار يجمعنا","أطيع ريا وريا لا تعاصيني",62,"ن",2,0],["فقد غردت فوق المسرة بالهنا","وأصبح روض الانس غضاً نواره",63,"ر",2,0],["فَقَد غُفرَت آثامُكُم وَسَعدتُمُ","وَلَم يَثنهم ما قَد حبوهُ مِنَ الشكر",64,"ر",1,0],["فَقَد غَدا غيرَ جَبيرٍ عِندَما","هِيضَ أَبو الجبرِ بِسمٍّ مُحتَسى",65,"ا",1,0],["فَقَد غَلَطوا لِلنَّاسِ في نَصْبٍ مِثله","وَمن لَيسَ لِلمَنصورِ بِابن وَلا المَهْدي",66,"د",2,0],["فقد غمرتها ذلّة ومهانة","وقد شملتها خسّة وخمول",67,"ل",1,0],["فَقَد غَدَوتِ ليَ المَاضِي بِرُمَّتِهِ","وقَد تَعَكَّرَ فِي رَوضَاتِيَ الوِردُ",68,"د",1,0],["فقد غدوت على الأ","عادى قوة مدمرة",69,"ر",2,0],["فقد غاظه نصر لدين محمد","وقد هاظه لما علا كل من عقا",70,"ق",2,0],["فقد غشاكِ كليمَ القلبِ مرتجيا","منكِ الدواءَ فهلْ يحظى بيمناكِ",71,"ك",1,0],["فَقَد غَدَا النوُّاح ُ مِنْ عَلَزٍ","ثمُّ دَعَاكَ الغَوثَ من غَمَمِ",72,"م",1,0],["فَقَد غَدَا العَيشُ جَحِيِمًا يَغتَلِي","وَالمَرءُ يلهُو لَا يُباَلي بَاكِيَا",73,"ي",2,0],["فقَد غَابَ عنهُ صفَاءُالخَوَالي","ودَربُ الوُعُودِ ، وَسِحرُ الأَجَامِ",74,"م",1,0]]}