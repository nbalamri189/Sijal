87016",""],[3271,"وطن الفأس","https://www.poetsgate.com/ViewPoem.aspx?id=104126",""],[5129,"حكايتنا","https://www.poetsgate.com/ViewPoem.aspx?id=122674",""],[5351,"تراجيديا","https://www.poetsgate.com/ViewPoem.aspx?id=202052",""],[5397,"سالمت دهرا لا يريك التهانيا","https://www.poetsgate.com/ViewPoem.aspx?id=157960",""],[5431,"عصيٌ على الإبداع جوٌ ملغم...","https://www.poetsgate.com/ViewPoem.aspx?id=212343",""],[5442,"قد براها جذب البرى والأزمة","https://www.poetsgate.com/ViewPoem.aspx?id=114766",""],[5442,"ألف الصبوة واستحلى الغرما","https://www.poetsgate.com/ViewPoem.aspx?id=114748",""],[5628,"المخادعة","https://www.poetsgate.com/ViewPoem.aspx?id=178801",""],[5660,"أَحَقُّ النّاسِ أَن تُهجى الشُعوبُ","https://www.poetsgate.com/ViewPoem.aspx?id=23712",""],[6068,"لعارضة ذاك القوام -20-","https://www.poetsgate.com/ViewPoem.aspx?id=177500",""],[6178,"مرافي محطمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85529&r=&rc=5",""],[454,"إن العروبة بالإسلام عزتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82660&r=&rc=24",""],[2220,"الله يعلمُ نفسي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11246&r=&rc=120",""]],"verses":[["فحكّمَ سيْفَ اللحْظِ في عسْكَرِ الهَوى","فكَمْ مُهْجةٍ مطْلولَةٍ فوقَ خدِّه",0,"د",2,0],["فحكى شعرها على الرأس تاجاً","وحكت في جلالها خاقانه",1,"ن",2,0],["فحكى قرطها بقرب المحيّا","زهرة الجوّ قارنت زبرقانه",1,"ن",2,0],["فحكت أشعتها حراباً أشرعت","بيضاً فما بحديدها أصداء",2,"ا",2,0],["فحكتْ هذه وتلك يَمينَي","كَ إذا ما تبارتا إعطاءَ",3,"ا",2,0],["فحكى منك نَعمة الخُلُقِ النا","عم في كُلِّ حالةٍ إثناءَ",3,"ا",2,0],["فحكت كفّك التي تَخْلُفُ المُزْ","نَ علينا فتُرغمُ الأَنواءَ",3,"ا",2,0],["فحكتْ لجانيها وقاحتَهُ","بالنَّكْتِ في الوَجَناتِ لا النَّغمِ",4,"م",1,0],["فحكى غائبه شاهدَه","وحكى المكنونُ منه عَلَنه",5,"ن",2,0],["فَحِكايَتي كَحِكايَةِ الظَمآ","نِ في قَفرٍ يَباب",6,"ب",1,0],["فَحَكَى لَحظُهُ لَنا سَيفَ عَبّا","دٍ وَلَحظي لَهُ سَحابَ يَدَيهِ",7,"ه",1,0],["فحكى شخصها الخَيالة إذ لا","ح ذبول بجسمها وأرتخاء",8,"ا",2,0],["فحكم الله على الرومان","وأدركتهم سنّة الزمان",9,"ن",1,0],["فَحُكمُكَ يا مُهاجِرُ حُكمُ عَدلٍ","وَلَو كَرِهَ المُنافِقُ وَالمُريبُ",10,"ب",1,0],["فَحُكْمُكَ شَمْسُ الحَقِّ فِينَا إِضَاءَةً","وَكُلُّ مُضِيءٍ مَا سِوَى الحَقِّ كَاذِبُ",11,"ب",1,0],["فحكموا الله واختاروك أنت لها","فكان قولهم نوعا من الهذر",12,"ر",1,0],["فحكم سيف اللحظ في عسكر الهوى","فكم مهجة مطلولة فوق حده",13,"د",2,0],["فحكى قصة تململ فيها","كل حرف ، كأنه قلب حاقد",14,"د",1,0],["فَحَكَى لَحظُهُ لَنا سَيفَ عَبّا","دٍ، ودمعي لَهُ سَحابَ يَدَيهِ",15,"ه",1,0],["فَکحْكُمي بَيْنَنَا وَقولي بِعَدْلٍ","هل جزاءُ المحبّ إلا الوصالا",16,"ل",2,0],["فَحَكَّم سَيفاً لا تزالُ ظُباتُهُ","مُحَكَّمَةً في الناوِياتِ المَثائِثِ",17,"ث",1,0],["فَحَكَتْ ثَناكَ وَذِي عُجالةُ قاصرٍ","لَو راحَ يَقضي دَهرَهُ لَاِستَعجَلا",18,"ل",2,0],["فحُكِّمت الأسيافُ فيهم وسُلِّطت","عليهم رِماح للنفاق حِدَاد",19,"د",1,0],["فَحُكمُكَ عِندَهُمُ ساقِطٌ","وَقَولُكَ مُطَّرَحٌ يُنبَذُ",20,"ذ",1,0],["فَحَكَيْتِ يَوْمَ الوَصْلِ فِي رَأَدِ الضُّحَى","مَعَ الْغُرُوبِ حَكَيْتِ يَوْمَ بِعَادِي",21,"د",2,0],["فَحُكْ فِيهِ مِنْ حَرِّ الثَّنَاءِ مَطَارِفاً","مُنَمْنَمَةَ الأَعْلاَمِ بَاهِرَةَ الصَّبْغِ",22,"غ",1,0],["فحَكت وجهَ فتاتي نضرةً","وفؤادي نفحةً فالحبُّ طيب",23,"ب",1,0],["فحكمنا وسلمنا اعترافا","بأن الحكم ماض من أديب",24,"ب",1,0],["فَحَكَت لِلعُيون بِهجَة مَجلاه","قَمَراً أودعَ الشُموس هِلالا",25,"ل",2,0],["فحكتَ لها ثوب المفاخر بالنَّدى","وألبَستها من بأسك الحُلَّةَ الخضرا",26,"ر",2,0],["فحكّم في قطْعِ أصلِ السَقامِ","مهنّدُ صحّتِه القاطِعا",27,"ع",2,0],["فحكتْ طلعةُ الإمام المُرجّى","مَنْ بيُمناهُ حلّ كلَّ وِثاقِ",28,"ق",1,0],["فَحَكَمْتَ فِي حَكَمٍ بشملٍ جامعٍ","نورَيْن زادَهُما التألُّفُ نورا",29,"ر",2,0],["فَحَكَّمْتَ فِيهِ حَدَّ سَيْفِكَ فَاقْتَضى","وشاوَرْتَ فِيهِ الفَضْلَ فاسْتَعجمَ الفُتيا",30,"ي",2,0],["فحكم الموت يا أمي عموم","بما فيه ولا منه ملوم",31,"م",1,0],["فحكاها إذ حكنه في المغيب","كمغر وله قلب خفوق",32,"ق",1,0],["فحكموا العدل فيهم حينما حكمو","والناس لا شكل نحو العدل تنجذب",33,"ب",1,0],["فحكَّ على أرض العراق سنابك ال","جياد وقد غودرن بالسَّير ظُلَّعا",34,"ع",2,0],["فَحَكِّموا بَيْنَنا الأَزْهارَ فَنَّكُم","تَلْقَوْا بِهِ إن فَهِمْتُوهُ جَلا الرِّيَبِ",35,"ب",1,0],["فَحَكَى عَنْ ضَمِيْرِهِ","مَا جَرَى فِي خَوَاطِرِهْ",36,"ر",2,0],["فحكمت مملكة بحسن سياسة","وبحكمة كل الصعاب تذلل",37,"ل",1,0],["فحكومة الدستور خير حكومة","يحيا بها مجد لمصر تليد",38,"د",1,0],["فَحَكَّمَ في كِتابِ اللَهِ عَمراً","وَذاكَ الأَشعَرِيَّ أَخا الضَلالِ",39,"ل",1,0],["فَحَكمت في وَجهة السرحان","شَكلت الأَسنان بِاللِسان",40,"ن",1,0],["فَحَكَتْ أنِينَ الوُرْقِ فِي تَمْدِيدِهَا","وَجَرَتْ عَنِ الأوْجَاعِ وَالأزْجَالِ",41,"ل",1,0],["فحكم تحريم به يختص","كما عليه الفقهاء نصوا",42,"ص",3,0],["فحكمنا الرز فاعترضَ النيلُ","فقلنا في الصُّلحِ قولاً جميلا",43,"ل",2,0],["فحكتْ فتاةَ العصرِ مائسةً","أَردانُها بنوافِحِ العِطْر",44,"ر",1,0],["فحكَّمه الباري ببر وفاجر","ودرَّعه بالعدل والأريحية",45,"ه",1,0],["فحكمك كله عدلٌ وفضلٌ","وحلمك كله شرفٌ وسؤدد",46,"د",1,0],["فَحُكْمُكَ حَسْبِي يَا حَسِيبُ تَوَلَّنِي","وَأَنْتَ جَلِيلٌ كُنْ لِخَصْمِي مُنَكِّلاَ",47,"ل",2,0],["فَحِكْ ليَ من نَعْماك بُرْداً أجُرُّهُ","فإني لأبرادِ المدائح حائك",48,"ك",1,0],["فحكَتْ لنا طيباً خلائقَك التي","أُورِثْتَها من رابع الخلفاء",49,"ا",2,0],["فحكمه ليس في تصريفه علل","وفعله فيه تصحيح وإعلال",50,"ل",1,0],["فحكت مدامِعُها الغزا","رُ مِن الغيوم الغُرِّ عينا",51,"ن",2,0],["فحكت عزمك في إنقاذها","وحكتها من أعاديك قلوب",52,"ب",1,0],["فحكمُ الشيءِ مقصورٌ عليه","وما أدَّاه ذاك إلى القصورِ",53,"ر",1,0],["فحكمُ الفصلِ بها والقضا","فصيراها حكمة فتقا",54,"ق",2,0],["فحكمة الله لما","طلبتُها ما تجنب",55,"ب",1,0],["فحكمه ذلك لا عينه","فلتعتبر قولي حتى ترى",56,"ر",2,0],["فحكمي عليها إن تأملته بها","فمنها أمانُ الخائفين مع الحذرِ",57,"ر",1,0],["فحكمةُ الصدِّ لا يراها","سوى حكيم لها وسادي",58,"د",2,0],["فَحَكَوا بِمَا ظَنُّوهُ يَلزَمُهُم فَقَا","لُوا مَذهَبُهُم بِلاَ بُرهَانِ",59,"ن",1,0],["فَحَكَى المُعَطِّلُ عَن أولِي الإِثبَاتِ قَو","لَهُمُ بِأنَّ اللهَ ذُو جُثمَانِ",59,"ن",1,0],["فحكمت فيها العدل في الناس كلها","لأنّك تدري أن تعود نصيبها",60,"ب",3,0],["فَحَكاهُ غَيرَ مُخالِفٍ