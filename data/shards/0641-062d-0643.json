,[290,"ظننا الجو خال من مجيب","https://www.aldiwan.net/poem39383.html","الوافر"],[358,"من لصب صبا المعاهد أشجاه","https://www.aldiwan.net/poem40001.html","الخفيف"],[422,"سعيت لهذا الملك بالهمة الكبرى","https://www.aldiwan.net/poem53949.html","الطويل"],[438,"تقدم في الطب عبد العزيز","https://www.aldiwan.net/poem12667.html","المتقارب"],[438,"ما لمن في الهوى من خلاق","https://www.aldiwan.net/poem12686.html","الخفيف"],[445,"كسيت بدولتك اليالي نورا","https://www.aldiwan.net/poem34851.html","الكامل"],[445,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[447,"نيوب النائبات البائنات","https://www.aldiwan.net/poem14437.html","الوافر"],[449,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[454,"إن العروبة بالإسلام عزتها","https://www.aldiwan.net/poem996.html",""],[466,"تمنى مقامي والمطالع ضلة","https://www.aldiwan.net/poem15107.html","الطويل"],[534,"ما بال بري بتعليم الفنون غدا","https://www.aldiwan.net/poem37538.html","البسيط"],[572,"مخطف الخصر أجوف","https://www.aldiwan.net/poem69655.html","مجزوء الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138350",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138256",""],[626,"","https://poetry.dctabudhabi.ae/diwan/poem/32347","الوافر"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77483","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59129","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126173","الرجز"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49022","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48972","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108539","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108600","الوافر"],[1680,"","https://poetry.dctabudhabi.ae/diwan/poem/81895","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49574","الطويل"],[234,"","https://poetry.dctabudhabi.ae/diwan/poem/52405","الكامل"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/1