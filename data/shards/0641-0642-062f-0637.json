{"poems":[[55,"وفى بمواعيد الخليط وأخلفوا","https://www.aldiwan.net/poem29968.html","الطويل"],[55,"إذا ضافني هم أمل طروقه","https://www.aldiwan.net/poem30420.html","الطويل"],[37,"ألم تربع فتخبرك الطلول","https://www.aldiwan.net/poem39107.html","الوافر"],[32,"لمية أطلال بحزوى دوائر","https://www.aldiwan.net/poem29586.html","الطويل"],[85,"أحافد عبد التين يملأ بطنه","https://www.aldiwan.net/poem54299.html","الطويل"],[39,"ألا هل عم في رأيه متأمل","https://www.aldiwan.net/poem7652.html","الطويل"],[93,"يا رب ليل بلا سناء","https://www.aldiwan.net/poem62711.html","عموديه"],[40,"ألم يسأل الركب الديار العوافيا","https://www.aldiwan.net/poem7821.html","الطويل"],[34,"قفي تسل عنك النفس بالخطة","https://www.aldiwan.net/poem27746.html","الطويل"],[82,"نعيمك أن تزف لك العقار","https://www.aldiwan.net/poem31437.html","الوافر"],[33,"خليلي مرا بي على رسم منزل","https://www.aldiwan.net/poem41841.html","الطويل"],[35,"ألا طالما لاعيت ليلى وقادني","https://www.aldiwan.net/poem25878.html","الطويل"],[83,"أصيخوا فمن طور الهدى انبعث الندا","https://www.aldiwan.net/poem61537.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42577","الطويل"],[146,"ترى رائح يأتى بأخبار من غدا","https://www.aldiwan.net/poem58445.html","الطويل"],[147,"تفردت بالمجد دون الأمم","https://www.aldiwan.net/poem11809.html","المتقارب"],[154,"قضى القلب من عهد الشباب ديونه","https://www.aldiwan.net/poem68583.html","الطويل"],[185,"خليلى زورا بي أميمة فاجلوا","https://www.aldiwan.net/poem58750.html","الطويل"],[186,"ليهنك ما وافاك من فيض نعمة","https://www.aldiwan.net/poem61123.html","الطويل"],[190,"ليالي الصبا درت عليك السحائب","https://www.aldiwan.net/poem44142.html","الطويل"],[203,"أراك الحمى هل قبلتك ثغورها","https://www.aldiwan.net/poem45651.html","الطويل"],[210,"سرور أزاح الهمّ والغمّ مذ بدا","https://www.aldiwan.net/poem916.html",""],[227,"دعاك الهوى فاجب من دعاك","https://www.aldiwan.net/poem55466.html","المتقارب"],[234,"رضيت بحكم سابقة القضاء","https://www.aldiwan.net/poem51267.html","الوافر"],[302,"سل البان عنهم أين بانوا ويمموا","https://www.aldiwan.net/poem33179.html","الطويل"],[309,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[385,"إذا ما نسيم الريح من نحوكم أسرا","https://www.aldiwan.net/poem48830.html","الطويل"],[409,"يسر بما يهوى المحب ويهلك","https://www.aldiwan.net/poem33600.html","الطويل"],[409,"إلى كم أداري عاذلي ومفندي","https://www.aldiwan.net/poem33969.html","الطويل"],[445,"اقبل ثناء وشكرا","https://www.aldiwan.net/poem34832.html","المجتث"],[447,"أريحي الوجا يا ناق ما بعد ذا وجا","https://www.aldiwan.net/poem14299.html","الطويل"],[473,"عندي تبر عنبي المعدن","https://www.aldiwan.net/poem59553.html","الرجز"],[556,"أهاجك ذكر منهم ووساوس","https://www.aldiwan.net/poem47756.html","الطويل"],[556,"ألا يا أيها الحادي","https://www.aldiwan.net/poem47850.html","الهزج"],[556,"أتمضي كذا أيدي الردى بالمصاعب","https://www.aldiwan.net/poem48057.html","الكامل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83317","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122610","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122711","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122679","الطويل"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90547","الطويل"],[966,"","https://poetry.dctabudhabi.ae/diwan/poem/146425","المتقارب"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61029","الوافر"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112720","الوافر"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48955","المتقارب"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52072","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69368","الطويل"],[2000,"","https://poetry.dctabudhabi.ae/diwan/poem/198753","الوافر"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109337","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28502","المتقارب"],[2517,"","https://poetry.dctabudhabi.ae/diwan/poem/99901","الطويل"],[2622,"","https://poetry.dctabudhabi.ae/diwan/poem/32971","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130760","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130097","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88970","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62874","المنسرح"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108091","الطويل"],[3705,"","https://poetry.dctabudhabi.ae/diwan/poem/145357","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117858","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117973","الطويل"],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21381","الطويل"],[3896,"","https://poetry.dctabudhabi.ae/diwan/poem/45541","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77027","الطويل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44692","الوافر"],[4085,"","https://poetry.dctabudhabi.ae/diwan/poem/105141","الوافر"],[4122,"","https://poetry.dctabudhabi.ae/diwan/poem/111117","المتقارب"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66141","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120280","الوافر"],[4675,"دفاع عن علامة الصومال عبد الكريم حسن حوش","https://www.poetsgate.com/ViewPoem.aspx?id=192203",""],[4767,"عطر الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=177230",""],[3271,"راهب النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=104128",""],[5305,"الاستسعاد بمدح سيد الأسياد","https://www.poetsgate.com/ViewPoem.aspx?id=187378",""],[592,"بهجر أضاء الفجر واستعلن الرشد","https://www.poetsgate.com/ViewPoem.aspx?id=128846",""],[5582,"أَلا هَلْ رأَتْ عَيْناكَ لِلْحَيِّ أَظْعانَا","https://www.poetsgate.com/ViewPoem.aspx?id=63594",""],[5870,"إِلَى","https://www.poetsgate.com/ViewPoem.aspx?id=60836",""],[5873,"أنبل الأقوام","https://www.poetsgate.com/ViewPoem.aspx?id=215303",""],[5964,"أعيجي بنا قبل انبتات حبالك","https://www.poetsgate.com/ViewPoem.aspx?id=181303",""],[6052,"روضة الايمان","https://www.poetsgate.com/ViewPoem.aspx?id=35138",""]],"verses":[["فَقَد طالَما ضَيَّعتُ في العَيشِ فُرصَةً","وَهَل يَنفَعُ المَلهوفُ ما يَتَلَهَّفُ",0,"ف",1,0],["فَقَد طالَ ما أَحدَثتُ عَهداً بِطيبَةٍ","فَرُدّا عَلَيَّ القَولَ أُحدِث بِهِ ذِكرا",1,"ر",2,0],["فَقَد طَلَبَ المَكارِمَ فَاِحتَواها","أَغَرُّ كَأَنَّهُ سَيفٌ صَقيلُ",2,"ل",1,0],["فَقَد طالَ ما رَجَّيتُ مَيّاً وَشاقَني","رَسيسُ الهَوى مِنهُ دَخيلٌ وَظاهِرُ",3,"ر",1,0],["فقد طبت من طير العصير بنسبة","فخرت بها بين القضاة على الغير",4,"ر",1,0],["فَقَد طَالَ هذا النَّومُ واستَخرَج الكَرَى","مَسَاويَهم لو أنَّ ذا المَيلِ يَعدِلُ",5,"ل",1,0],["فَقَد طالَ يا لَيلُ فيكَ صَبري","وَأَشبَهَت ساعُكَ القُرونا",6,"ن",2,0],["فَقَد طالَ أَيّامِ الصَفاءِ عَلَيهِمُ","وَأَيُّ صَفاءٍ لا يَحورُ تَغاوِيا",7,"ي",2,0],["فَقَد طالَما مِن غَيرِ شَكوى قَبيحَةٍ","رَضينا بِحُكمٍ مِنكِ غَيرِ سَديدِ",8,"د",1,0],["فَقَد طَردَ الكرى عنّا خطيبٌ","رفيعُ الصَّوتِ مِنْبَرُهُ الجدارُ",9,"ر",1,0],["فَقَد طالَ لَو تَبكي إِلى مُتَجَوَّدٍ","بُكاكَ إِلى شَنباءَ يا قَلبُ فَاِحتَلِ",10,"ل",1,0],["فَقَد طالَ إِمساكي عَلى الكَبِدِ الَّتي","بِها مِن هَوى لَيلى الغَداةِ صُدوعُ",11,"ع",1,0],["فَقَد طَلَعَ البَدرانِ بِالسَعدِ وَالسَنا","وَقَد مُزِجَ البَحرانِ بِالبَأسِ وَالنَدى",12,"د",2,0],["فَقَدْ طَالَمَا جَرَّبْتُ خِلاً فَمَا رَعَى","وَحِلْفاً فَمَا أَوْفَى وَعَوْنَاً فَمَا أَجْدَى",13,"د",2,0],["فقد طال ما أبصرتُما ظبىَ رملةٍ","فشبّهتُماه ذا دَمالجَ أغيدا",14,"د",2,0],["فَقَد طالَما نَزَلوا بِالرَقيمِ","فَصَبَّحتَ أَحياءَهُم بِالرَقِم",15,"م",1,0],["فَقَد طابَ مِنهُ الطَبعُ وَالفَرعُ وَالأَصلُ","فَأَمّا عُقودُ المُشرِكينَ فَحَلَّها",16,"ه",2,0],["فَقَد طالَ هِجرَانِي أُمَيمَةَ أَبتَغِي","رِضَى النَّاسِ لا أَلقَى مِنَ النّاسِ راضِيَا",17,"ي",2,0],["فَقَد طالَما رُضتَ الفَضائلَ وَاِنَبرت","لَتَعزيزِ شَأنِ العلمِ مِنكَ يَدانِ",18,"ن",1,0],["فقد طابت الدنيا وطاب نعيمها","فمن كان فيها زاهدا فهو راغب",19,"ب",1,0],["فقد طارح البوسفورُ مصر تحيةً","أضاءتْ لها في جانبَيها قصورها",20,"ر",3,0],["فقد طابت الأوقات حسناً وبهجةٍ","وبلبل أنس الوصل في الحين غرّدا",21,"د",2,0],["فقد طال فيك مطال الأماني","ونلت من السقم فوق مناك",22,"ك",1,0],["فقد طيّبتَ عيشي في سرورٍ","وقد أنعمتَ بالي في رخاء",23,"ا",2,0],["فَقَد طالَ بُعدي عن جَنابك سيِّدي","وَقَلبيَ بالأَشواق نحوكَ مُفعَمُ",24,"م",1,0],["فقد طال هذا البعد وامتد وقته","وطال انتظار حجة بعد حجة",25,"ه",1,0],["فَقَد طالَما قَد كُنت تَستَعجلينهُ","إِذا ما تَجافوا عَنكَ أَو أَظهَروا هَجرا",26,"ر",2,0],["فقد طاب لي عيش وقرت نواظري","بنجل الضيا بل بدر كل كمال",27,"ل",1,0],["فقد طالما ضيعت في الحب مهجتي","وألقيت في كف الصبابة مِقْوَدِي",28,"د",2,0],["فقد طَلَعْتَ هِلالاً","واليوم أَمْسَيْتَ بَدْرا",29,"ر",2,0],["فقد طالما سرت الدفق وفوز من","مسيرك قد سار الدفقي وهملجا",30,"ج",2,0],["فَقَد طَغا في مائِهِ المُزَيَّنِ","فَصارَ فيهِ أَحمَراً في أَدكَنِ",31,"ن",1,0],["فَقد طالَما قضَّيتُ مأْرَبَةَ الصِّبا","بهنَّ ونُدماني الظّباءُ الأوانسُ",32,"س",1,0],["فقد طُلنَ مدَى شكرِي","وبرّحنَ بأحمادِي",33,"د",2,0],["فقد طُوِيَتْ منه الصفائحُ عَنْوةً","على سامقِ الأعراقِ ضخم الضّرائبِ",34,"ب",1,0],["فَقَد طالَ وَصفي نَكدَها غَيرَ كاذِبُ","أَلا لَيتَها تَسعى بِرَدٍّ وَأَكذَبُ",35,"ب",1,0],["فقد طالَ مِن بَعدِ النوى ما التقت به","أسُودٌ علي حُكمِ الهوى وجَآذر",36,"ر",1,0],["فَقَد طالَ ما أمستَ وَظَلَّت وَدَوحُها","مَبيتٌ لِغِزلانِ الحِمَى وَمَقيلُ",37,"ل",1,0],["فَقَد طالَ مَشتاها وَطالَ خَريفُها","وَمَربعُها في أرضِكُم وَمَصيفُها",38,"ف",3,0],["فقد طالَما عانيتُ بُعدَ مَزارِها","وَبِتُّ أراعي شِبهها في الدَّياجرِ",39,"ر",1,0],["فقد طال سقمي، فقل لي متى","تجيء الى عبدك العافيه",40,"ي",2,0],["فَقَد طَلعت لمفخركن شَمس","يدور بِسعدها فلك المَعالي",41,"ل",2,0],["فقد طالت مقارعة البلايا","لعبدك والتشبه بالسفال",42,"ل",1,0],["فقد طلع الفجرُ في موكب","يشقّ عمودَ الدُّجى مُسفِرا",43,"ر",2,0],["فَقَدْ طَالَ لَيلِي في انتِظَارِ حُصُولِهِ","أمَا أنَّ لَيلَ المُبتَلِينَ طَوِيلُ",44,"ل",1,0],["فَقَد طالَما قَرَّت بِهِ العَينُ مَنظَراً","وَلَذَّت بِنَجوى أَهلِهِ الأُذنُ مَسمَعا",45,"ع",2,0],["فقد طال المدى مذ رحت عنا","ومات النّاسُ في الهجر احتضارا",46,"ر",2,0],["فقد طال ما بالغت بالضر فاتئد","وان زدت تنشق العصا ويك فاحذر",47,"ر",1,0],["فَقَد طالَما أَنقَذَتني يَداكَ","وَقَد عَلِقَتني حِبالُ الرَّدى",48,"د",2,0],["فقد طالما سؤتُ الغيورَ وطالما","نما حُبها يعتادُ مكنُونُه القَلبَا",49,"ب",2,0],["فَقَد طالَ عَيشي في الضَلالِ وَأَهلِهِ","أَخافُ الَّتي يَخشى التَقِيُّ وَأَحذَرُ",50,"ر",1,0],["فقد طُبعت نفسي غداة ربيعها","على حب هاتيك الربوع بطابع",51,"ع",1,0],["فقد طوّق الأعناق في مصر برّهُ","فطاب لنا فيه الثناء المطوّلُ",52,"ل",1,0],["فقد طالت يد الطاعون فينا","وأعيا الطب واشتد البلاء",53,"ا",2,0],["فقد طلبنا سِوَاكَ من يَعشقُ ال","ذكر ويشتاقُهُ فلم نَجِدِ",54,"د",1,0],["فقد طمعت من حسن سعيك جدة","بماءٍ شربناه لطاب له الظما",55,"م",2,0],["فقد طال ما ناديت سراً وجهرة","عسى وطن يدنو بهم ولعلما",56,"م",2,0],["فقد طالما أملتُ أن أرمق الحمى","بعين يروي الترب منها غديرها",57,"ر",3,0],["فقد طال لما أن جفوت حنينه","وقد زاد ما بين الوشاة ملامه",58,"م",2,0],["فَقَد طالَ ما عُلِّقتَ لَيلى مُغَمَّراً","وَليداً إِلى أَن صارَ رأَسُكَ أَشيبا",59,"ب",2,0],["فَقَد طالَ ما مَيَّلتُ بِالغَيِّ حِقبَةً","وَبِالرُشدِ وَالأَخلاقُ جَمٌّ ضُروبُها",60,"ب",3,0],["فَقَد طالَ نَبذي بِالعَراءِ كَأَنَّني","أَطَعت عذولي وَاِدرَعت التَجَلدا",61,"د",2,0],["فَقَد طالَ الزَمانُ وَساءَ حالي","وَقَد فَسَدت مِنَ الناس القُلوبُ",62,"ب",1,0],["فقد طالوا بقشر القشر باعا","فكيف بمن حوى لب اللباب",63,"ب",1,0],["فقد طرق الدين بعد الطفوف","شجى مثله الذكر لم يذكر",64,"ر",1,0],["فَقَدْ طالَتْ لَيالي الهَجْرِ حَتَّى","عَلاَ وَجْهَ الأَمانِيِّ الشُّحُوبُ",65,"ب",1,0],["فقد طبعت على اخلاق انثى","وما خلب النساء سوى الجريء",66,"ي",2,0],["فقد طعنوا شيخ الشيوخ تكلفا","ودافع هذا الطعن حقد مذيل",67,"ل",1,0],["فقد طابت عواقبُ من أطاعوا","وللعاصين قد ساء المصير",68,"ر",1,0],["فقد طال نسيان الورى لأنينها","ورنّت بشكواها الطلولُ الدّواثرُ",69,"ر",1,0],["فقد طغت موجة الالحاد حين بدت","للالمغرضين ودعواهم اقاويل",70,"ل",1,0],["فقد طال ما كنا بأيدي عداتنا","أذلا والأعداء يسمو لهم جد",71,"د",1,0],["فَقَدْ طالَما ذُبْنا وَذابَتْ قُلُوبُنا","وَزِدْنا لَها بَعْدَ الأَحِبَّةِ تَحْنانا",72,"ن",2,0],["فَقَد طَالَ شَوقِي لِلُقيَاكِ حُبَّاً","وَغَنَّى عَلَى الغُصنِ شَوقِي الحَمَامُ",73,"م",1,0],["فقد طال الرقاد على البلايا","وكاس الذلّ منه قد روينا",74,"ن",2,0],["فقد طلعت شمس الضحى بأوارها","على مستظلات بفيئ ظلالك",75,"ك",1,0],["فقد طغى مرج البهتان يجرفنا","وبات كاس الهدى بالطيش ينسكبُ",76,"ب",1,0]]}