diwan.net/poem54015.html","الكامل"],[413,"هلا نظرت إلى الكئيب الواله","https://www.aldiwan.net/poem54023.html","الكامل"],[413,"جاء الربيع بورده وبهاره","https://www.aldiwan.net/poem54045.html","الكامل"],[413,"جدد اللذة حتى نتجدد","https://www.aldiwan.net/poem54102.html","الرمل"],[413,"إن الأكارم والمكارم","https://www.aldiwan.net/poem54148.html","مجزوء الكامل"],[413,"طرف يراعي النجم وهو مؤرق","https://www.aldiwan.net/poem54166.html","الكامل"],[426,"بسم السرور فسرت الأحياء","https://www.aldiwan.net/poem40833.html","الكامل"],[429,"هذا مقام أبيك فاسم بمجده","https://www.aldiwan.net/poem12593.html","الكامل"],[434,"عم الندى وتواتر الإنعام","https://www.aldiwan.net/poem2560.html","الكامل"],[436,"اليوم نادتك السيادة هيت لك","https://www.aldiwan.net/poem34848.html","الكامل"],[436,"الشمس شاهدة وإن تك واحده","https://www.aldiwan.net/poem34857.html","الكامل"],[436,"أنضيت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34916.html","الكامل"],[438,"خل الكئيب بدائه في ذاته","https://www.aldiwan.net/poem14341.html","الكامل"],[438,"الرزء أفجع لو أطلت بكائي","https://www.aldiwan.net/poem14434.html","الكامل"],[441,"سادت بهذا الكون حكمة قاهر","https://www.aldiwan.net/poem55964.html","الخفيف"],[441,"لله رب العرش والأكوان","https://www.aldiwan.net/poem56035.html","عموديه"],[441,"يا عشير الصبا الكريم السجيه","https://www.aldiwan.net/poem56046.html","عموديه"],[450,"ما الروض نديان الثرى متعطرا","https://www.aldiwan.net/poem13759.html","الكامل"],[451,"لج الحنين إليك حتى خلتني","https://www.aldiwan.net/poem61336.html","الكامل"],[451,"مهلا وريقات الخريف تمتعى","https://www.aldiwan.net/poem61662.html","الكامل"],[456,"سل بسلع شجنا كان وكنا","https://www.aldiwan.net/poem55822.html","الرمل"],[456,"الليل بعد اليأس أطمع ناظري","https://www.aldiwan.net/poem56175.html","الكامل"],[456,"سل في الغضا وصبا الأصائل تنفح","https://www.aldiwan.net/poem56248.html","الكامل"],[459,"نبأ عاد له الصبح دجى","https://www.aldiwan.net/poem16016.html","الرمل"],[462,"جزت حد المديح قولاً وفعلا","https://www.aldiwan.net/poem3134.html","عموديه"],[462,"سر الحسود بما أساء وارجفا","https://www.aldiwan.net/poem3261.html","عموديه"],[462,"بالله يا رسل الرياح","https://www.aldiwan.net/poem3515.html","عموديه"],[472,"فلكم هريرة ماتجف دموعها","https://www.aldiwan.net/poem2154.html","الكامل"],[475,"حي عني منحني الوادي وأثله","https://www.aldiwan.net/poem15200.html","الخفيف"],[475,"أما هواك وان تقادم عهده","https://www.aldiwan.net/poem15208.html","الكامل"],[475,"قلب كما شاء التفرق موجع","https://www.aldiwan.net/poem15245.html","الكامل"],[475,"دمن حبسن على الغرام وأربع","https://www.aldiwan.net/poem15253.html","الكامل"],[475,"حييت من دمن ومن أطلال","https://www.aldiwan.net/poem15352.html","الكامل"],[477,"طال المدى في خطة الأعراض","https://www.aldiwan.net/poem37181.html","الكامل"],[498,"قف بالركاب فهذه الأطلال","https://www.aldiwan.net/poem37628.html","الكامل"],[498,"القلب يفزع في المهمة ضارعا","https://www.aldiwan.net/poem37696.html","الكامل"],[498,"لله موقفنا بأم عبيدة","https://www.aldiwan.net/poem38028.html","الكامل"],[498,"جدي بواسط أوسط القوم الألى","https://www.aldiwan.net/poem38041.html","الكامل"],[508,"حيا الحيا وطناً بإربل دارساً","https://www.aldiwan.net/poem1592.html",""],[512,"هذا العقيق وتلك شم رعانه","https://www.aldiwan.net/poem20784.html","الكامل"],[512,"ما الراح إلا روح كل حزين","https://www.aldiwan.net/poem20791.html","الكامل"],[512,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[512,"أمن البروج تعد أكناف الحمى","https://www.aldiwan.net/poem20815.html","الكامل"],[512,"حيدري عم نائله","https://www.aldiwan.net/poem20843.html","المديد"],[513,"جاوز بمجدك أنجم الجوزاء","https://www.aldiwan.net/poem11996.html","الكامل"],[536,"يا طاهر والله إنك طاهر","https://www.aldiwan.net/poem48188.html","عموديه"],[556,"نور هذا الوجود بالإيمان","https://www.aldiwan.net/poem33844.html","الخفيف"],[560,"كنا نؤمل أن نهنئ نعمة","https://www.aldiwan.net/poem52689.html","الكامل"],[560,"ما بال تلك الشامة الخضراء","https://www.aldiwan.net/poem52869.html","الكامل"],[560,"يا أيها القلب الخفوق بجانبي","https://www.aldiwan.net/poem52943.html","الكامل"],[562,"عنوان مجدك ظاهر وضاح","https://www.aldiwan.net/poem833.html",""],[573,"صح من دهرنا وفاة الحياء","https://www.aldiwan.net/poem2790.html","الخفيف"],[573,"رب شخص سمج مستقذر","https://www.aldiwan.net/poem2811.html","الرمل"],[573,"لست أدري بأي فتح تهنا","https://www.aldiwan.net/poem3001.html","الخفيف"],[573,"قمر بات بين سحري ونحري","https://www.aldiwan.net/poem3061.html","الخفيف"],[584,"قبل المحبوب من قب","https://www.aldiwan.net/poem17601.html","مجزوء الرمل"]],"verses":[["فلَكَمْ هَزَزْتُ إلَيكِ أعْطافَ الدُّجى","ورَكِبْتُ هاديَةَ الصّباحِ المُسْفِرِ",0,"ر",1,0],["فَلَكُمْ أَيَادِي الرِّقِّ فِي أَعْنَاقِنَا","وَلَنَا حُقُوقُ نَصَائِحِ الْعُبْدَانِ",1,"ن",1,0],["فَلِكُلِّ غادٍ رَوحَةٌ","وَلِكُلِّ وُضّاءٍ سِرار",2,"ر",1,0],["فَلَكِ العُذرُ إِن قَسَوتِ وَإِن خُن","تِ وَإِن كُنتِ مَصدَراً لِلشَقاءِ",3,"ا",2,0],["فَلِكُلِّ حُسنٍ حِليَةٌ يُزهى بِها","وَأَرى اليَراعَةَ حِليَةَ الكُتّابِ",4,"ب",1,0],["فَلَكٌ تُمَثِّلُ شَمْسُهُ وَنُجُومُهُ","أَفْلاكَنَا فِي السَّيْرِ وَالدَّوَرَانِ",5,"ن",1,0],["فلكم أقمت غداةَ زُمَّتْ عيسُهم","أبغي القرار ولات حين قرارِ",6,"ر",1,0],["فلكم بعثتُ مع النسيم تحيَّتي","عوّدْتُ ساري البرق من أرسالي",7,"ل",2,0],["فلك دائر على الشمس طوراً","في اقتراب وتارة في ابتعاد",8,"د",1,0],["فَلَكَ البَلاطُ مِنَ المَدينَةِ كُلِّها","وَالأَبطَحُ الغَربِيُّ عِندَ حِراءِ",9,"ا",2,0],["فلكل ذلك قد أعدَّ عَتادَه","أَنَفُ الكريم وحيلةُ المحتالِ",10,"ل",1,1],["فلكٌ يدورُ على المجرَّةِ مطلقاً","أسنى الكواكب وهي ذاتُ ذوائب",11,"ب",1,0],["فلكفّيه والثراء حروب","نحن منها في غاية الإصلاح",12,"ح",1,0],["فلك إذا شمت برقاً من أسرته","علمت أنَّ مرادَ القصد ممطور",13,"ر",1,0],["فلكلّ قطرة وابلٍ فمُ زهرةٍ","مفترّةٍ عن باسمٍ متضوّع",14,"ع",1,0],["فلكَ الحُجَّةُ الصحيحة إن قل","تَ كذا تُحلِبُ البحورَ الشِّعابُ",15,"ب",1,0],["فلكونِكُم في صُلبِ آدمَ نُطفةً","كانت محورةُ أمرهِ إهباطا",16,"ط",2,0],["فلكم نطقتُ من الصوابِ بخطبةٍ","فيها البيان إذا أحال محِيلُ",17,"ل",1,0],["فلكم مُعْوِرٍ سترتَ فما أعْ","ور مكسورُه ولا ملحونه",18,"ن",2,0],["فلكم من ماء وجهٍ صانه","ودمٍ قد كان يجري حَقنَه",19,"ن",2,0],["فَلَكَم نَظَرتُ إِلى الرُبى فَلَمَحتَهُ","في الأُقحُوانِ الخَيِّرِ المِعطاءِ",20,"ا",2,0],["فَلَكٌ واحِدٌ يُظِلُّ كِلَينا","حارَ طَرفي بِه وَطَرفُكَ أَرمَد",21,"د",1,0],["فَلَكَم نَظَرتُ إِلى الجَمالِ فَخِلتُهُ","أَدنى إِلى بَصَري مِنَ الأَشفارِ",22,"ر",1,0],["فَلَكَم قَطَعتَ اللَيلَ خافٍ نَجمُهُ","مُتَجَهِّداً وَالساهِرونَ قَليلُ",23,"ل",1,0],["فَلَكَ العَزا فيما مَضى","وَلَنا الهَنا فيما تَجَدَّد",24,"د",1,0],["فَلَكَ الحَمدُ إِذا ما","قُلتَ ياعَبدَ الحَميدِ",25,"د",1,0],["فَلَكَم فِيَّ مِن مَكاِمِ أَخلا","قٍ وَكَم فِيَّ مِن حَميدِ صِفاتِ",26,"ت",1,0],["فَلَكَمْ أَرَقْتُ مَدَامِعِي","حتَّى تَقَرَّحَتِ الجُفُونْ",27,"ن",1,0],["فلك القطر دواما","حافظ حق الجميل",28,"ل",1,0],["فَلَكٌ بِالسَعدِ وَالنَحسِ يَدور","لا تُعارِض أَبَداً مَجرى الأُمور",29,"ر",1,0],["فَلَكَم سَقاهُ الوُدَّ حينَ وِدادُهُ","حَربٌ لِأَهلِ الحُكمِ وَالإِشرافِ",30,"ف",1,0],["فَلَكٌ بِالسَعدِ وَالنَحسِ مُدار","صَرَعَ الجامَ وَأَلوى بِالمُدير",31,"ر",1,0],["فَلَكَم رَجَعتُ مِنَ الأَسِنَّةِ سالِماً","وَصَدَرتُ عَن هيفِ القُدودِ طَعينا",32,"ن",2,0],["فَلَكِيٌّ هُوَ إِلّا أَنَّهُ","لَم يَنَل فَهماً وَلَم يُعطَ الكَلاما",33,"م",2,0],["فُلكُ نوحٍ تَعوذُ مِنهُ بِنوحٍ","لَو رَأَتهُ وَتَستَجيرُ زِمامَه",34,"م",2,0],["فَلَكٌ يَكسِفُ الشُموسَ نَهاراً","وَيَسومُ البُدورَ لَيلَةَ وَكسِ",35,"س",1,0],["فَلَكٌ جارٍ وَدُنيا لَم يَدُم","عِندَها السَعدُ وَلا النَحسُ اِستَمَر",36,"ر",1,0],["فَلَكٌ يَدورُ سُعودُهُ","وَنُحوسُهُ بِيَدِ المُدير",37,"ر",1,0],["فَلِكُلِّ مَفجوعٍ سِواكُم مُشبِهٌ","وَلِكُلِّ مَفقودٍ سِواهُ نَظيرُ",38,"ر",1,0],["فلكٌ يدورُ على ذؤابةِ تاجهِ","ويكون أنَّى دار حيثُ يكونُ",39,"ن",1,0],["فَلَكُم مَواقِفُ في الوَغى مَشهورَةٌ","بِوِراثَةٍ عَن كُلِّ لَيثٍ مِحرَبِ",40,"ب",1,0],["فَلِكُلِّ أَمرٍ حادِثٍ","ضَربٌ مِنَ التَدبيرِ أَوحَد",41,"د",1,0],["فَلَكُ السَيفُ وَالعَمامَةُ وَالخا","تَمُ وَالبُردُ وَالعَصا وَالسَريرُ",42,"ر",1,0],["فَلَكَ الفَضائِلُ مِن فُنونِ مَحاسِنٍ","بيضاً لِإِفراطِ الخِلافِ وَشيما",43,"م",2,0],["فلَكَمْ مُشْفٍ على الحَتْفِ نَجا","ومَريضٍ قد رَأيناه أبلّ",44,"ل",1,0],["فَلَكٌ أنجُمُهُ اللَّي","مونُ من بِيضٍ وخُضْرِ",45,"ر",1,0],["فَلَكَمْ عدوٍّ قد أطلْتُ عَذابَه","بِكُلومِ رَيِّقَةِ الكلامِ عِذابِ",46,"ب",1,0],["فَلَكٌ يدورُ بأنجمٍ جُعِلَت له","كالعِقدِ فهي شَوارِقٌ وغَواربُ",47,"ب",1,0],["فَلَكَم نَعِمتُ بِوَصلِهِ في مَنزِلٍ","قَد طابَ فيهِ مَربَعي وَمَصيَفي",48,"ف",2,0],["فَلَكَم سَأَلتُ الثَغرَ وَصفَ رُضابِهِ","فَأَبى وَصَرَّحَ لي سَفيهُ سِواكِ",49,"ك",1,0],["فَلَكَ اللَهُ مِن كَريمٍ بَخيلٍ","مانِحٍ مانِعٍ شُجاعٍ جَبانِ",50,"ن",1,0],["فَلَكَ الشَفاعَةُ في مُحِبّيكُم إِذا","نُصِبَ الصِراطُ وَعُلِّقَ الميزانُ",51,"ن",1,0],["فَلَكَم ذُقتُ عَذاباً","لِلهَوى كانَ غَراما",52,"م",2,0],["فلك الرأي قاطعاً","ما به من تردد",53,"د",1,0],["فَلَكٌ من الأفلاكِ إلّا أنّهُ","حَقَرَ البدورَ فأطلعَ المنصورا",54,"ر",2,0],["فلك اللّه من كريم السجايا","معرِقِ المجدِ في الملوكِ الكرامِ",55,"م",1,0],["فَلَكَ الوَيلُ مِنَ النارِ إِذا","مُقلَةُ الرحمَنِ لَم تَنظُرْ إِلَيك",56,"ك",1,0],["فَلَكَم نَظرَةٍ تُسَرُّ بِها مِن","كِ لَها رَوعَةٌ تَسوءُ القُلوبا",57,"ب",2,0],["فَلَكٌ لا يَزَالُ يَجْرِي عَلَى النَّا","سِ بِضِدَّيْنِ مِنْ عُلاً وَهَوَانِ",58,"ن",1,0],["فَلَكٌ يَدُورُ وَأَنْجُمٌ لا تَأْتَلِي","تَبْدُو وَتَغْرُبُ فِي فَضَاءٍ أَقْتَمِ",59,"م",1,0],["فَلَكِ اللَهُ وَالأَمانَةُ وَالمي","ثاقُ أَن لا نَخونَكُم ما بَقينا",60,"ن",2,0],["فَلَكَم شَكوى هُناكَ لَنا","وَلَكَم نَجوى بِها وَكَمِ",61,"م",1,0],["فلكلِّ قومٍ من سفاهةِ رأيهم","ربٌّ يُعظَّمُ أو إلهٌ يُعبَدُ",62,"د",1,0],["فلكلِّ عصرٍ منه وِردٌ سائغٌ","ولكلِّ جِيلٍ منه كَنْزُ رائعُ",63,"ع",1,0],["فَلكَ الحمدُ وَافراً مُستمِراً","ولَك الفضلُ باقياً مذكورا",64,"ر",2,0],["فَلَكَ الدَّلاَلُ وَأنتَ بَدرٌ كَامِلٌ","وَيَحِقُّ لِلمَحبُوبِ أن يَتَدَلَّلاَ",65,"ل",2,0],["فَلِكُلٍّ عَلامَةٌ","وَهوَ يَحوي عَلامَتَين",66,"ن",1,0],["فلكلِّ سارِ مِنْ هُداهُ هِدايَةٌ","ولكلِّ عافٍ مِنْ نَداه مَشْرَبُ",67,"ب",1,0],["فَلَكَ المالُ المُلَقّى","وَلَكَ العِرضُ المُوَقّى",68,"ق",2,0],["فَلَكٌ يَدورُ بِحِكمَةٍ","وَلَهُ بِلا رَيبٍ مُديرُ",69,"ر",1,0],["فَلَكٌ يَدورُ عَلى مَعاشِرَ جَمَّةٍ","وَكَأَنَّهُ سِجنٌ عَلَيهِم مُطبَقُ",70,"ق",1,0],["فَلَكٌ دائِرٌ أَبى فَتَياهُ","وَنيَةً أَو يُفَرَّقَ الفِتيانُ",71,"ن",1,0],["فَلَكَم ظَلِلتُ عَلى طَوىً","يَومي وَبِتُّ عَلى تَباب",72,"ب",1,0],["فَلَكَ الله من فؤادٍ رَحيمٍ","ولكَ الله من فؤادٍ كئيبِ",73,"ب",1,0],["فَلِكُلِّ لَفْظٍ رَوْنَقٌ مُتَجَدِّدٌ","وَلِكُلِّ قَافِيَةٍ جَدِيدُ رُوَاءِ",74,"ا",2,0],["فَلَكٌ لا يُحَدُّ إِلاَّ إِذَا مَا","كَانَ حَدَّ قُصُورِ طَرَفِ الرَّائِي",75,"ا",2,0],["فَلَكُ الكَنَانَةِ وَهْوَ جَوْهَرَةُ الْعُلَى","يَجْلُو سَنَاهُ كَوَاكِبَ الأَحْيَاءِ",76,"ا",2,0],["فلَكَمْ رَأينا في المَعابد أَشْعَباً","للختْل يَلْبَسُ بُرْدَةَ الزُّهّاد",77,"د",1,0],["فلكم تَمنَّى ابنُ الوليد مَنِيةً","بينَ الصواهِل والقَنا الرعّافِ",78,"ف",1,0],["فَلكَم تَمنَّى الدينُ طالِعَ صُبْحِه","واهْتزَّ من شَوْقٍ إِليه الْمِنْبَرُ",79,"ر",1,0],["فَلكَمْ بَعَثْتُ مَعَ الأَثِيرِ وَحِيدَةً","في فَنِّهَا تَشْدُو بِمُلْكِ وَحِيدِ",80,"د",1,0],["فَلَكَمْ تَنَقَّلَ في الْعُلاَ","مِنْ مَهْدِ مَكْرُمَةٍ لِمَهْدِ",81,"د",1,0],["فل كلِّ أغيدَ ناهدٍ","نَمت الثمارُ بصدره",82,"ر",2,0],["فلكم ذهبتُ إليك طيَّا","رًا بِأجنحة الخيال",83,"ل",1,0],["فلكم يدهي الرق في أعناقها","ولنا حقوق نصائح العبدان",84,"ن",1,0],["فلكِ التعزي عن سياستكِ التي","عادتْ عليكِ بصفقة الافلاس",85,"س",1,0],["فلكَمْ تَخالَفُ في المسيلِ جداولٌ","فاضَتْ معاً وتفجرَّتْ ينبوعا",86,"ع",2,0],["فلكم مواقف في الوغى مشهورة","بوارثة عن كل ليث محرب",87,"ب",1,0],["فلكم قطعت اللّيل خاف نجمه","متهجّدا، والسّاهرون قليل",88,"ل",1,0],["فلكم من ماء وجهٍ ضانه","ودمٍ قد كان يجري حَقنَه",89,"ن",2,0],["فَلَكِ کللَّهُ وَکلأَمَانَة ُ وَکلْمي","قُ، أنْ لا نخونكمْ ما بقينا",90,"ن",2,0],["فَلَكُ السَعادة دونَ قَدرك رُتبة","وَعَلى الحَضيض عَدوك المَطروحُ",91,"ح",1,0],["فُلك القُلوب نَسيم اللُطف سَيّرها","مِن بَعد ما وَقَفت في ساحل المِحَن",92,"ن",1,1],["فلك الفخر بهجة الدهر معنى","دولة الاولياء في كل محفل",93,"ل",1,0],["فلكل شيء باطن","في محكم المعنى وظاهر",94,"ر",1,0],["فلكم هذه المناقب قدما","ورتتها الاباء للاولاد",95,"د",1,0],["فلكم أبو ج