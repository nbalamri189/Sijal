{"poems":[[63,"لمعت كناصية الحصان الأشقر","https://www.aldiwan.net/poem46196.html","الكامل"],[77,"حيى ربوع الحي من نعمان","https://www.aldiwan.net/poem36079.html","الكامل"],[86,"أهلا بأول مسلم","https://www.aldiwan.net/poem10681.html","مجزوء الكامل"],[86,"ألبسوك الدماء فوق الدماء","https://www.aldiwan.net/poem10925.html","الخفيف"],[86,"شيخان قد خبرا الوجود وأدركا","https://www.aldiwan.net/poem68877.html","الكامل"],[93,"أرأيت صوغ الدر في العقيان","https://www.aldiwan.net/poem11278.html","الكامل"],[83,"لولا تألق بارق التذكار","https://www.aldiwan.net/poem54296.html","الكامل"],[83,"ما للحمول تحن للأطلال","https://www.aldiwan.net/poem54250.html","الكامل"],[88,"نحن من أرضنا على منطاد","https://www.aldiwan.net/poem45072.html","الخفيف"],[27,"بكر الأمير لغربة وتنائي","https://www.aldiwan.net/poem5658.html","الكامل"],[37,"فلكل ذلك قد أعد عتاده","https://www.aldiwan.net/poem7472.html","الكامل"],[72,"ناعورة بمنازل البحر اقتضت","https://www.aldiwan.net/poem18340.html","الكامل"],[72,"لا وأجفانك المراض الصحاح","https://www.aldiwan.net/poem18482.html","الخفيف"],[72,"يا شاهر اللحظ حبي فيك مشهور","https://www.aldiwan.net/poem18695.html","البسيط"],[72,"يا دار جيرتنا بسفح الأجرع","https://www.aldiwan.net/poem19161.html","الكامل"],[51,"وهب يا واهب الهبات اللواتي","https://www.aldiwan.net/poem8310.html","الخفيف"],[51,"هبت لوهب ريح سوء عاصف","https://www.aldiwan.net/poem65016.html","الكامل"],[51,"لا زلت تفخم والثناء ضئيل","https://www.aldiwan.net/poem65988.html","الكامل"],[51,"غابن الحمد حقه مغبونه","https://www.aldiwan.net/poem66432.html","الخفيف"],[51,"إنما يبكي شجي شجنه","https://www.aldiwan.net/poem66464.html","الرمل"],[91,"لله من عبث القضاء وسخره","https://www.aldiwan.net/poem8730.html","عموديه"],[91,"نسي الطين ساعة أنه طين","https://www.aldiwan.net/poem8817.html","عموديه"],[91,"يا ليتني لص لأسرق في الضحى","https://www.aldiwan.net/poem8846.html","عموديه"],[91,"أودى فنور الفرقدين ضئيل","https://www.aldiwan.net/poem9056.html","عموديه"],[70,"الله أكبر يامحمد","https://www.aldiwan.net/poem42930.html","مجزوء الكامل"],[70,"دمت في أرغد عيش","https://www.aldiwan.net/poem42945.html","مجزوء الرمل"],[70,"أنا في الحب صاحب المعجزات","https://www.aldiwan.net/poem42992.html","الخفيف"],[92,"أيها الحب أنت سر بلائي","https://www.aldiwan.net/poem38975.html","الخفيف"],[85,"يا مليكا شاد فينا","https://www.aldiwan.net/poem7362.html","مجزوء الرمل"],[85,"أحمدك الله وأطري الأنبياء","https://www.aldiwan.net/poem8099.html","الرمل"],[85,"أجل وإن طال الزمان موافي","https://www.aldiwan.net/poem62840.html","الكامل"],[85,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[85,"من صور السحر المبين عيونا","https://www.aldiwan.net/poem63011.html","الكامل"],[85,"قم سليمان بساط الريح قاما","https://www.aldiwan.net/poem63696.html","الرمل"],[85,"قف بطوكيو وطف على يوكاهامه","https://www.aldiwan.net/poem63698.html","الخفيف"],[85,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[85,"ناشئ في الورد من أيامه","https://www.aldiwan.net/poem63769.html","الرمل"],[85,"سل يلدزا ذات القصور","https://www.aldiwan.net/poem63770.html","مجزوء الكامل"],[43,"غاضت أنامله وهن بحور","https://www.aldiwan.net/poem9574.html","الكامل"],[62,"نظري إلى لمع الوميض حنين","https://www.aldiwan.net/poem52265.html","الكامل"],[45,"لامت ملامة مشفق متعتب","https://www.aldiwan.net/poem11495.html","الكامل"],[45,"طلا سألت بجو ثهمد","https://www.aldiwan.net/poem63467.html","مجزوء الكامل"],[45,"لك في المجد أول وأخير","https://www.aldiwan.net/poem63574.html","الخفيف"],[45,"أحرى الخطوب بأن يكون عظيما","https://www.aldiwan.net/poem65661.html","الكامل"],[61,"نحن للأيام غنم ونفل","https://www.aldiwan.net/poem51477.html","الرمل"],[61,"واصطبحناها على نهر","https://www.aldiwan.net/poem51660.html","مجزوء الرمل"],[61,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[61,"الماء يلعب كالأراقم موجه","https://www.aldiwan.net/poem51795.html","الكامل"],[66,"فتك اللواحظ والقدود الهيف","https://www.aldiwan.net/poem38482.html","الكامل"],[66,"يا من حمت عنا مذاقة ريقها","https://www.aldiwan.net/poem39935.html","الكامل"],[66,"كثر الله مثل مجدك في الأرض","https://www.aldiwan.net/poem40952.html","الخفيف"],[66,"خمدت لفضل ولادك النيران","https://www.aldiwan.net/poem41545.html","الكامل"],[66,"بلغي الأحباب يا ريح","https://www.aldiwan.net/poem41564.html","مجزوء الرمل"],[97,"عش مديدا وجدد","https://www.aldiwan.net/poem24978.html","مجزوء الخفيف"],[80,"واعمر بقصر الملك ناديك الذي","https://www.aldiwan.net/poem31233.html","الكامل"],[80,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[80,"ما الذي أعددت للموت فقد","https://www.aldiwan.net/poem31350.html","الرمل"],[44,"اجعلي في الكرى لعيني نصيبا","https://www.aldiwan.net/poem30286.html","الخفيف"],[87,"أي شيء يبقى على الحدثان","https://www.aldiwan.net/poem8231.html","الخفيف"],[87,"كم غادر الشعراء من متردم","https://www.aldiwan.net/poem8260.html","الكامل"],[31,"أصبح القلب بالقتول حزينا","https://www.aldiwan.net/poem41279.html","الخفيف"],[74,"قل لمسرى الريح من إضم","https://www.aldiwan.net/poem13255.html","المديد"],[105,"لا اليوم يومك إذ ولدت ولا الغد","https://www.aldiwan.net/poem41933.html","الكامل"],[105,"خطب الرسول فكل سمع منصت","https://www.aldiwan.net/poem44021.html","الكامل"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[81,"قلب المعنى من خيالك مأ خلا","https://www.aldiwan.net/poem61330.html","الكامل"],[81,"كيف أصغي للعاذلين","https://www.aldiwan.net/poem61482.html","مجزوء الخفيف"],[67,"وافاك بالذنب العظيم المذنب","https://www.aldiwan.net/poem18038.html","الكامل"],[48,"عجبا لي كيف أبقى","https://www.aldiwan.net/poem64457.html","مجزوء الرمل"],[46,"إن غاض بحر مدة","https://www.aldiwan.net/poem22591.html","مجزوء الكامل"],[46,"الدهر يزبق من حواه كأنهم","https://www.aldiwan.net/poem23024.html","الكامل"],[46,"كل ذكر من بعده نسيان","https://www.aldiwan.net/poem23463.html","الخفيف"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20248","الكامل"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/66003","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54531","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54524","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54297","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54283","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54288","الكامل"],[106,"تمثال فينوس","https://www.poetsgate.com/ViewPoem.aspx?id=179776",""],[106,"تحية الكويت","https://www.poetsgate.com/ViewPoem.aspx?id=179305",""],[77,"حيى ربوع الحي من نعمان","https://www.poetsgate.com/ViewPoem.aspx?id=34207",""],[90,"الى الخاتون المسبل","https://www.poetsgate.com/ViewPoem.aspx?id=179039",""],[90,"ساعة مع البحتري في سامراء ...","https://www.poetsgate.com/ViewPoem.aspx?id=179035",""],[45,"لامت ملامة مشفق متعتب","https://www.poetsgate.com/ViewPoem.aspx?id=33096",""],[91,"رثاء","https://www.poetsgate.com/ViewPoem.aspx?id=53186",""],[51,"إنما يبكي شجيُّ شَجَنَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=30804",""],[31,"أصبحَ القلبُ بالقتولِ حزينا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19121&r=&rc=383",""]],"verses":[["فلَكَمْ هَزَزْتُ إلَيكِ أعْطافَ الدُّجى","ورَكِبْتُ هاديَةَ الصّباحِ المُسْفِرِ",0,"ر",1,0],["فَلَكُمْ أَيَادِي الرِّقِّ فِي أَعْنَاقِنَا","وَلَنَا حُقُوقُ نَصَائِحِ الْعُبْدَانِ",1,"ن",1,0],["فَلِكُلِّ غادٍ رَوحَةٌ","وَلِكُلِّ وُضّاءٍ سِرار",2,"ر",1,0],["فَلَكِ العُذرُ إِن قَسَوتِ وَإِن خُن","تِ وَإِن كُنتِ مَصدَراً لِلشَقاءِ",3,"ا",2,0],["فَلِكُلِّ حُسنٍ حِليَةٌ يُزهى بِها","وَأَرى اليَراعَةَ حِليَةَ الكُتّابِ",4,"ب",1,0],["فَلَكٌ تُمَثِّلُ شَمْسُهُ وَنُجُومُهُ","أَفْلاكَنَا فِي السَّيْرِ وَالدَّوَرَانِ",5,"ن",1,0],["فلكم أقمت غداةَ زُمَّتْ عيسُهم","أبغي القرار ولات حين قرارِ",6,"ر",1,0],["فلكم بعثتُ مع النسيم تحيَّتي","عوّدْتُ ساري البرق من أرسالي",7,"ل",2,0],["فلك دائر على الشمس طوراً","في اقتراب وتارة في ابتعاد",8,"د",1,0],["فَلَكَ البَلاطُ مِنَ المَدينَةِ كُلِّها","وَالأَبطَحُ الغَربِيُّ عِندَ حِراءِ",9,"ا",2,0],["فلكل ذلك قد أعدَّ عَتادَه","أَنَفُ الكريم وحيلةُ المحتالِ",10,"ل",1,1],["فلكٌ يدورُ على المجرَّةِ مطلقاً","أسنى الكواكب وهي ذاتُ ذوائب",11,"ب",1,0],["فلكفّيه والثراء حروب","نحن منها في غاية الإصلاح",12,"ح",1,0],["فلك إذا شمت برقاً من أسرته","علمت أنَّ مرادَ القصد ممطور",13,"ر",1,0],["فلكلّ قطرة وابلٍ فمُ زهرةٍ","مفترّةٍ عن باسمٍ متضوّع",14,"ع",1,0],["فلكَ الحُجَّةُ الصحيحة إن قل","تَ كذا تُحلِبُ البحورَ الشِّعابُ",15,"ب",1,0],["فلكونِكُم في صُلبِ آدمَ نُطفةً","كانت محورةُ أمرهِ إهباطا",16,"ط",2,0],["فلكم نطقتُ من الصوابِ بخطبةٍ","فيها البيان إذا أحال محِيلُ",17,"ل",1,0],["فلكم مُعْوِرٍ سترتَ فما أعْ","ور مكسورُه ولا ملحونه",18,"ن",2,0],["فلكم من ماء وجهٍ صانه","ودمٍ قد كان يجري حَقنَه",19,"ن",2,0],["فَلَكَم نَظَرتُ إِلى الرُبى فَلَمَحتَهُ","في الأُقحُوانِ الخَيِّرِ المِعطاءِ",20,"ا",2,0],["فَلَكٌ واحِدٌ يُظِلُّ كِلَينا","حارَ طَرفي بِه وَطَرفُكَ أَرمَد",21,"د",1,0],["فَلَكَم نَظَرتُ إِلى الجَمالِ فَخِلتُهُ","أَدنى إِلى بَصَري مِنَ الأَشفارِ",22,"ر",1,0],["فَلَكَم قَطَعتَ اللَيلَ خافٍ نَجمُهُ","مُتَجَهِّداً وَالساهِرونَ قَليلُ",23,"ل",1,0],["فَلَكَ العَزا فيما مَضى","وَلَنا الهَنا فيما تَجَدَّد",24,"د",1,0],["فَلَكَ الحَمدُ إِذا ما","قُلتَ ياعَبدَ الحَميدِ",25,"د",1,0],["فَلَكَم فِيَّ مِن مَكاِمِ أَخلا","قٍ وَكَم فِيَّ مِن حَميدِ صِفاتِ",26,"ت",1,0],["فَلَكَمْ أَرَقْتُ مَدَامِعِي","حتَّى تَقَرَّحَتِ الجُفُونْ",27,"ن",1,0],["فلك القطر دواما","حافظ حق الجميل",28,"ل",1,0],["فَلَكٌ بِالسَعدِ وَالنَحسِ يَدور","لا تُعارِض أَبَداً مَجرى الأُمور",29,"ر",1,0],["فَلَكَم سَقاهُ الوُدَّ حينَ وِدادُهُ","حَربٌ لِأَهلِ الحُكمِ وَالإِشرافِ",30,"ف",1,0],["فَلَكٌ بِالسَعدِ وَالنَحسِ مُدار","صَرَعَ الجامَ وَأَلوى بِالمُدير",31,"ر",1,0],["فَلَكَم رَجَعتُ مِنَ الأَسِنَّةِ سالِماً","وَصَدَرتُ عَن هيفِ القُدودِ طَعينا",32,"ن",2,0],["فَلَكِيٌّ هُوَ إِلّا أَنَّهُ","لَم يَنَل فَهماً وَلَم يُعطَ الكَلاما",33,"م",2,0],["فُلكُ نوحٍ تَعوذُ مِنهُ بِنوحٍ","لَو رَأَتهُ وَتَستَجيرُ زِمامَه",34,"م",2,0],["فَلَكٌ يَكسِفُ الشُموسَ نَهاراً","وَيَسومُ البُدورَ لَيلَةَ وَكسِ",35,"س",1,0],["فَلَكٌ جارٍ وَدُنيا لَم يَدُم","عِندَها السَعدُ وَلا النَحسُ اِستَمَر",36,"ر",1,0],["فَلَكٌ يَدورُ سُعودُهُ","وَنُحوسُهُ بِيَدِ المُدير",37,"ر",1,0],["فَلِكُلِّ مَفجوعٍ سِواكُم مُشبِهٌ","وَلِكُلِّ مَفقودٍ سِواهُ نَظيرُ",38,"ر",1,0],["فلكٌ يدورُ على ذؤابةِ تاجهِ","ويكون أنَّى دار حيثُ يكونُ",39,"ن",1,0],["فَلَكُم مَواقِفُ في الوَغى مَشهورَةٌ","بِوِراثَةٍ عَن كُلِّ لَيثٍ مِحرَبِ",40,"ب",1,0],["فَلِكُلِّ أَمرٍ حادِثٍ","ضَربٌ مِنَ التَدبيرِ أَوحَد",41,"د",1,0],["فَلَكُ السَيفُ وَالعَمامَةُ وَالخا","تَمُ وَالبُردُ وَالعَصا وَالسَريرُ",42,"ر",1,0],["فَلَكَ الفَضائِلُ مِن فُنونِ مَحاسِنٍ","بيضاً لِإِفراطِ الخِلافِ وَشيما",43,"م",2,0],["فلَكَمْ مُشْفٍ على الحَتْفِ نَجا","ومَريضٍ قد رَأيناه أبلّ",44,"ل",1,0],["فَلَكٌ أنجُمُهُ اللَّي","مونُ من بِيضٍ وخُضْرِ",45,"ر",1,0],["فَلَكَمْ عدوٍّ قد أطلْتُ عَذابَه","بِكُلومِ رَيِّقَةِ الكلامِ عِذابِ",46,"ب",1,0],["فَلَكٌ يدورُ بأنجمٍ جُعِلَت له","كالعِقدِ فهي شَوارِقٌ وغَواربُ",47,"ب",1,0],["فَلَكَم نَعِمتُ بِوَصلِهِ في مَنزِلٍ","قَد طابَ فيهِ مَربَعي وَمَصيَفي",48,"ف",2,0],["فَلَكَم سَأَلتُ الثَغرَ وَصفَ رُضابِهِ","فَأَبى وَصَرَّحَ لي سَفيهُ سِواكِ",49,"ك",1,0],["فَلَكَ اللَهُ مِن كَريمٍ بَخيلٍ","مانِحٍ مانِعٍ شُجاعٍ جَبانِ",50,"ن",1,0],["فَلَكَ الشَفاعَةُ في مُحِبّيكُم إِذا","نُصِبَ الصِراطُ وَعُلِّقَ الميزانُ",51,"ن",1,0],["فَلَكَم ذُقتُ عَذاباً","لِلهَوى كانَ غَراما",52,"م",2,0],["فلك الرأي قاطعاً","ما به من تردد",53,"د",1,0],["فَلَكٌ من الأفلاكِ إلّا أنّهُ","حَقَرَ البدورَ فأطلعَ المنصورا",54,"ر",2,0],["فلك اللّه من كريم السجايا","معرِقِ المجدِ في الملوكِ الكرامِ",55,"م",1,0],["فَلَكَ الوَيلُ مِنَ النارِ إِذا","مُقلَةُ الرحمَنِ لَم تَنظُرْ إِلَيك",56,"ك",1,0],["فَلَكَم نَظرَةٍ تُسَرُّ بِها مِن","كِ لَها رَوعَةٌ تَسوءُ القُلوبا",57,"ب",2,0],["فَلَكٌ لا يَزَالُ يَجْرِي عَلَى النَّا","سِ بِضِدَّيْنِ مِنْ عُلاً وَهَوَانِ",58,"ن",1,0],["فَلَكٌ يَدُورُ وَأَنْجُمٌ لا تَأْتَلِي","تَبْدُو وَتَغْرُبُ فِي فَضَاءٍ أَقْتَمِ",59,"م",1,0],["فَلَكِ اللَهُ وَالأَمانَةُ وَالمي","ثاقُ أَن لا نَخونَكُم ما بَقينا",60,"ن",2,0],["فَلَكَم شَكوى هُناكَ لَنا","وَلَكَم نَجوى بِها وَكَمِ",61,"م",1,0],["فلكلِّ قومٍ من سفاهةِ رأيهم","ربٌّ يُعظَّمُ أو إلهٌ يُعبَدُ",62,"د",1,0],["فلكلِّ عصرٍ منه وِردٌ سائغٌ","ولكلِّ جِيلٍ منه كَنْزُ رائعُ",63,"ع",1,0],["فَلكَ الحمدُ وَافراً مُستمِراً","ولَك الفضلُ باقياً مذكورا",64,"ر",2,0],["فَلَكَ الدَّلاَلُ وَأنتَ بَدرٌ كَامِلٌ","وَيَحِقُّ لِلمَحبُوبِ أن يَتَدَلَّلاَ",65,"ل",2,0],["فَلِكُلٍّ عَلامَةٌ","وَهوَ يَحوي عَلامَتَين",66,"ن",1,0],["فلكلِّ سارِ مِنْ هُداهُ هِدايَةٌ","ولكلِّ عافٍ مِنْ نَداه مَشْرَبُ",67,"ب",1,0],["فَلَكَ المالُ المُلَقّى","وَلَكَ العِرضُ المُوَقّى",68,"ق",2,0],["فَلَكٌ يَدورُ بِحِكمَةٍ","وَلَهُ بِلا رَيبٍ مُديرُ",69,"ر",1,0],["فَلَكٌ يَدورُ عَلى مَعاشِرَ جَمَّةٍ","وَكَأَنَّهُ سِجنٌ عَلَيهِم مُطبَقُ",70,"ق",1,0],["فَلَكٌ دائِرٌ أَبى فَتَياهُ","وَنيَةً أَو يُفَرَّقَ الفِتيانُ",71,"ن",1,0],["فَلَكَم ظَلِلتُ عَلى طَوىً","يَومي وَبِتُّ عَلى تَباب",72,"ب",1,0],["فَلَكَ الله من فؤادٍ رَحيمٍ","ولكَ الله من فؤادٍ كئيبِ",73,"ب",1,0],["فَلِكُلِّ لَفْظٍ رَوْنَقٌ مُتَجَدِّدٌ","وَلِكُلِّ قَافِيَةٍ جَدِيدُ رُوَاءِ",74,"ا",2,0],["فَلَكٌ لا يُحَدُّ إِلاَّ إِذَا مَا","كَانَ حَدَّ قُصُورِ طَرَفِ الرَّائِي",75,"ا",2,0],["فَلَكُ الكَنَانَةِ وَهْوَ جَوْهَرَةُ الْعُلَى","يَجْلُو سَنَاهُ كَوَاكِبَ الأَحْيَاءِ",76,"ا",2,0],["فلَكَمْ رَأينا في المَعابد أَشْعَباً","للختْل يَلْبَسُ بُرْدَةَ الزُّهّاد",77,"د",1,0],["فلكم تَمنَّى ابنُ الوليد مَنِيةً","بينَ الصواهِل والقَنا الرعّافِ",78,"ف",1,0],["فَلكَم تَمنَّى الدينُ طالِعَ صُبْحِه","واهْتزَّ من شَوْقٍ إِليه الْمِنْبَرُ",79,"ر",1,0],["فَلكَمْ بَعَثْتُ مَعَ الأَثِيرِ وَحِيدَةً","في فَنِّهَا تَشْدُو بِمُلْكِ وَحِيدِ",80,"د",1,0],["فَلَكَمْ تَنَقَّلَ في الْعُلاَ","مِنْ مَهْدِ مَكْرُمَةٍ لِمَهْدِ",81,"د",1,0],["فل كلِّ أغيدَ ناهدٍ","نَمت الثمارُ بصدره",82,"ر",2,0],["فلكم ذهبتُ إليك طيَّا","رًا بِأجنحة الخيال",83,"ل",1,0],["فلكم يدهي الرق في أعناقها","ولنا حقوق نصائح العبدان",84,"ن",1,0],["فلكِ التعزي عن سياستكِ التي","عادتْ عليكِ بصفقة الافلاس",85,"س",1,0],["فل