{"poems":[[96,"بدعة الذل","https://www.poetsgate.com/ViewPoem.aspx?id=12816",""],[303,"إِن الذين تجافى عنهم الشرف","https://www.aldiwan.net/poem36822.html","عموديه"],[3024,"","https://poetry.dctabudhabi.ae/diwan/poem/138037","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114050","الخفيف"],[4931,"هموم القلب","https://www.poetsgate.com/ViewPoem.aspx?id=30868",""],[5370,"ذبحني غلاه","https://www.poetsgate.com/ViewPoem.aspx?id=86516",""],[5526,"لا صرت تغلي شخص","https://www.poetsgate.com/ViewPoem.aspx?id=204498",""],[5677,"(بتزين باكر)","https://www.poetsgate.com/ViewPoem.aspx?id=139686",""],[6056,"البارعة","https://www.poetsgate.com/ViewPoem.aspx?id=156701",""]],"verses":[["سبّة الدّهر أن يحاسب فكر","في هواه وأن يغلّ لسان",0,"ن",1,0],["سبّةُ الدهرِ فالأَسلافُ تلعنهم","وَسوفَ يخزى بما جاؤا به الخلف",1,"ف",1,0],["سَبِّهِ لِلْوَصِيِّ وَالاَوْلادِ","بِكَلامٍ مُفَتِّتِ الاَكْبادِ",2,"د",1,0],["سِ بِهِ آذَانُ المُحِبِّ تُشَنَّف","لاَحَ فَضلٌ لَهُ وَالأورَاقُ تَخصَف",3,"ف",1,0],["سبّة هذاك اللي بعد .. بعد ما فاق","حبّه رمال لقلب .. كلّ لفيافي",4,"ف",2,0],["سِبه عقلي الراجح وضل الفكر والراي","يا خبل الذي هاقيته.. نزوه وتنزالي",5,"ل",2,0],["سبّة هنوف ٍ وصفها بنت الألماس","عروق قلبه تلّته من محلّه",6,"ل",2,0],["سبة عشيرٍ غاب طيفه ولا حام","لا اقول ناسيني ولا اقول ناكر",7,"ر",1,0],["سبة اللي ذاوي ٍ بين الضلوع","ينتظر منك ، الحلول الشافية",8,"ف",3,0]]}