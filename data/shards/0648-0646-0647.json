 خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[458,"تمد بالآذان والمناخر","https://www.aldiwan.net/poem56185.html","الرجز"],[458,"من الغادي تحط به وتعلو","https://www.aldiwan.net/poem56250.html","الوافر"],[464,"أنظر إلى نسج الربيع وحوكه","https://www.aldiwan.net/poem3207.html","عموديه"],[464,"متى لمتني في الغوزال الأغنِ","https://www.aldiwan.net/poem3326.html","عموديه"],[468,"ونهر من الأنهار ألقت يد الصبا","https://www.aldiwan.net/poem59662.html","الطويل"],[505,"أقلّوا","https://www.aldiwan.net/poem61087.html","الطويل"],[515,"ونهج سعت إليك فيه طرائف","https://www.aldiwan.net/poem12046.html","الطويل"],[515,"هنئت مفتتح الصيام السافر","https://www.aldiwan.net/poem12120.html","الكامل"],[529,"إلى الدرعية الغراء تسري","https://www.aldiwan.net/poem37443.html","الوافر"],[538,"طال مني لذا النهار ارتقابي","https://www.aldiwan.net/poem48296.html","عموديه"],[543,"عجلا اليوم صاحبي رواحا","https://www.aldiwan.net/poem1764.html","الخفيف"],[551,"سئمت مقامي في الغبينة مغمدا","https://www.aldiwan.net/poem47869.html","الطويل"],[551,"أجر المدامع كيف شيتا","https://www.aldiwan.net/poem48033.html","مجزوء الكامل"],[551,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"],[558,"عالم الدنيا كفجر كاذب","https://www.aldiwan.net/poem34193.html","الرمل"],[562,"إن كان يلبس ما أفاد تجملا","https://www.aldiwan.net/poem52963.html","الكامل"],[575,"من فر منك فما يلام","https://www.aldiwan.net/poem3009.html","مجزوء الكامل"],[575,"ليل وصل منيرة أقماره","https://www.aldiwan.net/poem3059.html","الخفيف"],[575,"نعم هي سعدي وهي لي قمر سعد","https://www.aldiwan.net/poem3086.html","الطويل"]],"verses":[["وَنَهَصتُ مِنها غَيرَ مُكتَرِثٍ","مِثلَ الحُسامِ نَزا مِنَ الغِمدِ",0,"د",1,0],["وَنَهجو ذا الزَمانِ بِغَيرِ ذَنبٍ","وَلَو نَطَقَ الزَمانُ لَنا هَجانا",1,"ن",2,0],["ونهجْتَ طُرْقَ العَدْلِ مُهْتَدياً بِما","شهِدَتْ علَيْهِ صَحائِحُ الأخْبارِ",2,"ر",1,0],["ونُهْدي الى الأجْفانِ إثْمِدَ تُرْبِها","فَما اكْتَحَلَتْ منْ بَعْدِهِ بسِوى السُّهْدِ",3,"د",1,0],["وَنَهنَهَ مِنهُ لَهُ الوازِعو","نَ حَتّى إِذا حانَ إِرسالُها",4,"ل",3,0],["وَنَهِلتُ مِن أَخلاقِهِ","فَوَرَدتُ أَعذَبَ مَنهَلِ",5,"ل",1,0],["وَنَهَضنا في ظِلِّ عَرشِ فُؤادٍ","وَرَفَعنا لِعَهدِهِ تِمثالا",6,"ل",2,0],["وَنَهى الحَوادِثَ أَن تُلِمَّ بِمَنزِلي","وَصُروفَ دَهري أَن تَطوفَ بِمَربَعي",7,"ع",2,0],["وَنَهجُكَ سُبلَ الرُشدِ في قَمعِ مَن غَوى","وَعَدلُكَ في اِستِئصالِ مَن جارَ وَاِعتَدى",8,"د",2,0],["وَنَهَجْتَ النَّهْجَ الَّذِي اخْتَرْتَ لا تَثْ","نِيكَ عَنْهُ أَخْطَارُهُ وَالدُّجُونُ",9,"ن",1,0],["وَنَهَجْتَ لِلطُّلاَّبِ نَهْجاً وَاضِحاً","يُدْنِي أَقَاصِيَهَا إِلَى الأَذْهَانِ",10,"ن",1,0],["وَنَهبٍ كَجَمّاعِ الثُرَيّا حَوَيتُهُ","بِأَجرَدَ مَحتوتِ الصَفاقَينِ خَيفَقِ",11,"ق",1,0],["ونهر حسامٍ كلما أغرق العدا","تلقتهم منه سريعاً جهنّمُ",12,"م",1,0],["وَنَهَيتُ نَفسي فَاِنتَهَت","وَزَجَرتُ قَلبي فَاِنزَجَر",13,"ر",1,0],["ونهار كأنما الآل فيه","مرهفٌ في الوغى بكفِّ جبان",14,"ن",1,0],["ونُهيةً عصمتْني أن أُرى حَمِقاً","من باعةِ الرَّوحةِ الروحاءِ بالنصبِ",15,"ب",1,0],["ونهيت نفسي عن هوا","ك فسمَّحَت بعد النزاع",16,"ع",1,0],["ونهى الشيبُ بعد ذاك فسلَّمْ","تُ وأحجمتُ أيما إحجام",17,"م",1,0],["وَنَهرٍ إِذا والى التَجَعُّدَ مائُهُ","ذَكَرتُ الأَفاعي إِذ تَلوي عَلى الجَمرِ",18,"ر",1,0],["وَنَهُزُّ الأَغصُنَ وَالعُمُدا","وَنَذودُ عَنِ الثَمَرِ",19,"ر",1,0],["وَنَهارٍ كِدتَ فيهِ لَهُ","غَيرَ خاشٍ كَيدَ مُنتَقِمِ",20,"م",1,0],["وَنَهَضَت في ذِروَةِ الدِماغِ","وَاِستَرسَلَت في مُؤلِمِ التَلداغِ",21,"غ",1,0],["وَنَهَضتَ يَزهو الكَونُ مِنكَ بِمَنظَرٍ","ضاحٍ وَيَحمُلُ مِنكَ تاجَ فَخارِ",22,"ر",1,0],["وَنَهارٍ لَيسَ فيهِ غِبطَةٌ","وَلَيالٍ لَيسَ فيهِنَّ سَمَر",23,"ر",1,0],["وَنَهبُ نُفوسِ أَهلِ النَهبِ أَولى","بِأَهلِ المَحدِ مِن نَهبِ القُماشِ",24,"ش",1,0],["وَنَهَيتُ آشوطَ بنِ حَمزَةَ لَو نَهى","أَمَلاً كَبارِقَةِ الجَهامِ كَذوبا",25,"ب",2,0],["وَنَهنَهَ كَلباً عَنكُمُ بَعدَما سَمَت","لِخالِدِها في يَومِ ضَنكٍ فَعَرَّدا",26,"د",2,0],["وَنَهنَهتُ نَفسي عَن مُعاذٍ وَقَد بَدَت","مُقاتِلُ مَجهورِ الرَكِيَّةِ مُسلَمِ",27,"م",1,0],["وَنَهنُ تَرَكنا مِن هِلالِ اِبنِ عامِرٍ","ثَمانينَ كَهلاً لِلنُسورِ القَشاعِمِ",28,"م",1,0],["ونهز الرؤوس مثل الدراويش","...و بالنار تكتوي سيناء",29,"ا",2,0],["وَنَهَتني عَنِ النِساءِ وَحَلَّت","مَنزِلاً مِن حِمى الفُؤادِ مَكينا",30,"ن",2,0],["وَنَهراً كَما اِبيَضَّ المُقَبِّلُ سَلسَلاً","وَجِزعاً كَما اِخضَرَّ العِذارُ خَصيبا",31,"ب",2,0],["وَنَهَضنا نَهضةً تُحيي البِلاد","ديننا حُبك يا هَذا الوَطَن",32,"ن",1,0],["ونهيتُ قلبي عن خفو","قٍ فاضحٍ فتجنَّبه",33,"ب",2,0],["وَنَهاني الإِمامُ عَن سَفَهِ الكَأ","سِ فَرُدَّت عَلى السُقاةِ المُدامُ",34,"م",1,0],["وَنَهى عَنّيَّ العُيونَ المَريضا","تِ وَأَنضى رَكبَ الهَوى فَأَرَذّا",35,"ذ",2,0],["وَنَهَتْهُم وما انتهت عنه قوم","فأُبيدَ الأَمَّارُ والنَّهاءُ",36,"ا",2,0],["ونَهَتْنِي عَنِ المَسِيرِ إليهمْ","شِدَّةُ البَأْسِ مِنْ سَخاً في مَسِيرِ",37,"ر",1,0],["وَنَهَتني النُهى فَمِلتُ إِلى العَد","لِ وَأَشفَقتُ مِن مَقالَةِ ناهِ",38,"ه",1,0],["وَنَهاني المَلِكُ الهُما","مُ عَنِ النِساءِ وَما عَصَيتُه",39,"ت",2,0],["وَنَهوى العَيشَ فيكِ مَعَ الرَزايا","وَما طَوَّلتِ مِن خِمسٍ وَعِشرِ",40,"ر",1,0],["وَنُهينُ في لَذّاتِها","عُظمَ التِلادِ إِذا اِنتَشَينا",41,"ن",2,0],["وَنَهنَهتُهُ حَتّى لَبِستُ مُفَاضَةً","مُضَاعَفَةً كالنِهيِ رِيحَ وَأُمطِرا",42,"ر",2,0],["ونَهَى المَشيبُ عن الصِّبا لو أنَّهُ","يُدْلي بحُجَّتهِ إلى مَن يَلْقَنُ",43,"ن",1,0],["ونهب نفوس أهل النهب أولى","بأهل المجد من نهب القماش",44,"ش",1,0],["ونهزُّ أجنحةَ الحياةِ ونعتلي","بخفافهنَّ مناكبَ العقبانِ",45,"ن",1,0],["ونَهَتْ ذا الفَقارِ لولا قَضاءٌ","بُتَّ مِن غالِبٍ على مَغْلوب",46,"ب",1,0],["ونهيةٌ كالجوهر الوقّاد","لم تبد للصائغ والنّقّاد",47,"د",1,0],["وَنَهْجُرُ مَا أَلِفْنَاهُ اخْتِيَاراً","إِذَا مَا اعْتَاقَنَا أَدْنَى اعْتِياقِ",48,"ق",1,0],["وَنِهَايَةُ الإِبْدَاعِ مَعْنىً جَيِّدٌ","تَزْهَى بِهِ قَسِمَاتُ مَبْنىً جَيِّدِ",49,"د",1,0],["ونهضنا اليومَ كالأطوادِ في وجهِ العِدى","ندفعُ الضيمَ ونبني للعُلى صَرْحاً مَجيدْ",50,"د",1,0],["ونَهْضَةٌ كان فيها","للّهِ قَبْلَكَ سِرُّ",51,"ر",1,0],["ونهد إلى الأجفان إثمد تربها","فما اكتحلت من بعده بسوى السهد",52,"د",1,0],["ونهنّي مستبدا ، زاده","جثث القتلى وأكباد الأيامى",53,"م",2,0],["ونَهَانِيَ الْملك الْهم","م عنِ النِّسَاءِ وما عصيْتُهْ",54,"ت",2,0],["ونهوى السفينَ الحائراتِ كأنْها","سفينتُه إذ تشتكي الأينَ والضَّلْعا",55,"ع",2,0],["ونهارٌ مشمِشٌ نَقْطَعُهُ","بالأحاديثِ كليلٍ مقمر",56,"ر",1,0],["ونهى طُيوفَ المُغرياتِ عرائساً","عنْ أنْ يعودَ لها كرايَ ملاعبا",57,"ب",2,0],["ونهجوا ذا الزمان بغير ذنبٍ","ولو نطق الزمان لما هجانا",58,"ن",2,0],["وَنَهَيْتَ آشُوطَ بنَ حَمْزَةَ أوْ نهَى","أمَلاً كَبَارِقَةِ الجَهامِ كَذُوبَا",59,"ب",2,0],["وَنهْنَهْتَ عنْهُ السْيفَ فارْتدّ نَصْلُهُ","كَلِيلَ الشّذا عَنْهُ حَرْونَ المضَارِبِ",60,"ب",1,0],["ونهر إذا والى التجعّد ماؤه","ذكرت الأفاعي إذ تلوي على الجمر",61,"ر",1,0],["ونهرا تعرّى البدر فيه كرامة","لبعض القدود العاريات الموائس",62,"س",1,0],["ونهز الرؤوس مثل الدروايش","وبالنار تكتوي سيناء",63,"ا",2,0],["ونهضت عن شعب الكنانة كله","بالأمر فرداً غير ذي أنصار",64,"ر",1,0],["ونهضة همة بطويل باع","ترد اخا الفراق الى الفريق",65,"ق",1,0],["ونهلة الخير من إحسان خيركم","جئنا إليكم ومذ جزنا بديركم",66,"م",1,0],["وَنَهبٍ كَجُمّاعِ الثُرَيّا حَوَيتُهُ","غِشاشاً بِمُحتاتِ القَوائِمِ خَيفَقِ",67,"ق",1,0],["ونَهْوَى بأن نمشى حُفاةً نزوركم","ولكنْ فَلاةٌ دون ذاك وسَبْسَبُ",68,"ب",1,0],["وَنَهى دَريساً فَاِنتَهى لَمّا نُهي","عَن قَولِ حبرٍ ناطِق بِسَدادِ",69,"د",1,0],["ونهاية الدنيا مضِيقٌ مثل ذا","طوبَى لمن لفسيحِ عدنٍ يطلبُ",70,"ب",1,0],["وَنَهارٍ أَلَذَّ مِنْ نَظْرَةِ المَعْشُو","قِ بدّلْتُهُ بِبُؤْسِ عِتَابِ",71,"ب",1,0],["ونهضت بالإسلام نهضة ثائر","حتى تطاول واستقام الدين",72,"ن",1,0],["ونهصر من روض الإحاديث مجتنىً","تجاذبني اطرافه واجاذب",73,"ب",1,0],["ونهوا عنه البرايا","ورضوا الجهل اختيارا",74,"ر",2,0],["وَنَهَرٌ شَقَّ الرِّيَاضَ جَرْيُهُ","مَنْفَجِرٌ يَحْكِي لَنَا شَقَّ الطَّرَبْ",75,"ب",1,0],["ونهيتَ فارتاع الزمانُ تَهيُّبا","فكأنك الهيجاء وهْو جنان",76,"ن",1,0],["ونهر مريج فيه كل أذيّة","ورائحة جيفاء في تصعّد",77,"د",1,0],["وَنِهاياتُهُم قُبَيلَ بِدايا","تٍ عَلاها فَوقَ الوَرى الأَنبِياءُ",78,"ا",2,0],["وَنَهاهُم فَما اِنتهوا فَأتاهم","ما ثَناهُم فكان بعدُ اِنتهاءُ",78,"ا",2,0],["ونهديكِ بالرُّمانِ والخدَ بالمها","وريقك بالصَّهْبَا وعينَكِ بالسِحْرِ",79,"ر",1,0],["ونَهديةً شَمطاءَ أَو حرثيَّةً","تُؤَمِّلُ سَيباً من بَنيها يُغيرُها",80,"ر",3,0],["ونهضنا ورب من","جد في الأمر يهذر",81,"ر",1,0],["ونهارٍ أَرَقَّ صُبْحاً من الرّا","حِ وأَحْلَى من الأَمانِي أصيلا",82,"ل",2,1],["وَنَهى الصَّحابَةَ أَن يُقامَ لَهُ وَأَن","يُطرى وَأَن يُطوى لَهُ عَقبانِ",83,"ن",1,0],["وَنَهَضتَ مُضطَلِعاً بِما","حُمِّلتَ مِن أَعبائِها",84,"ا",3,0],["وَنَهَضتَ لِلإِسلامِ نَهضَةَ صادِقِ ال","عَزَماتِ تَرأَبُ مَن ثَآهُ وَتَشعَبُ",85,"ب",1,0],["وَنَهْرٌ بَيْنَ جَنَّاتٍ","وَوَرْدٌ بَيْنَ خَامَاتِ",86,"ت",1,0],["وَنَهَاراً مُشْمِساً لِمُحِبٍّ","وَهِزيعاً مُظْلِماً لِلْعَنِيدِ",87,"د",1,0],["ونهضتَ بالعرَب اُلأولى ملكوا الورى","ليعودَ منهم ذلك التمثيل",88,"ل",1,0],["ونهارُ الشتاء أطولُ عندي","من نهار الصيام في شهر آب",89,"ب",1,0],["ونهتهُ هِمَّتُهُ عن العَجز الذي","قد كان سَلَّمَ للخمول زِمامَهُ",90,"م",2,0],["ونهايةُ الجبروتِ في الجيشِ الذي","منها يطوفُ كما تطوفُ الأنهر",91,"ر",1,0],["وَنهنهت الغَرام فيجتَني","سواجع في الأراك لَها نَشيد",92,"د",1,0],["ونَهْرٍ كَما ذابَتْ سَبَائِكُ فِضَّةٍ","حَكَتْ بِمَحانيهِ انْعِطافَ الأراقِمِ",93,"م",1,1],["وَنُهودٍ كَحِقاقِ العاجِ إِذ","مُلِئَت حَبّاً مِنَ الدُرِّ الثَمين",94,"ن",1,0],["وَنَهداك في الصَدرِ مُذ أُقعِدا","أَقاما قِيامَةَ صَبٍّ يَراكِ",95,"ك",1,0],["ونهلنا من نبعه الزاخر العذب","لبان العلوم والعرفان",96,"ن",1,0],["ونهرٍ إذا ما ألبسته يد الصبا","جواشن جلت عن يد المتعاطي",97,"ي",1,1],["ونهَبنا العمر أحلام","ليالٍ نابغيّه",98,"ي",2,0],["وَنَهَتني إِذ نَبَّهَتني عَن بَثِّ","هَواها إِلى ذَوي الأَهواءِ",99,"ا",2,0],["وَنُهىً عَن سِوى المَحامد تَنهاه","هَكَذا هَكَذا وَإِلّا فَلا لا",100,"ل",2,0],["وَنَهنهت أَجفاني لِتَنفيس كُربَتي","فَسالَت دَماً فَاِزددتُ كَرباً عَلى كَربِ",101,"ب",1,0],["وَنَهَضتُ مِعثاراً بِدَمعِيَ وَالخُطا","مَقصودها وَمُعَثِّري ذَمَلاني",102,"ي",1,0],["ونهزُّ أعطافَ القلوب مسرّةً","ونزيح أضغاث الضمير المُدنِف",103,"ف",1,0],["ونهنهَ عنه عبءَ إثمٍ أقلَّهُ","لقد كان يوهيه أسىً إقواؤه",104,"ا",3,0],["وَنَهاري مُنذُ فارقت","مَحياهُ ظَلام",105,"م",1,0],["وَنَهاني عَن لَثمِهِ غَيرَتي من","ي وَلَم يَسمَح التَقي بِعِناق",106,"ق",1,0],["وَنَهلة مِن عُطر","حُلو المَذاق خَصر",107,"ر",1,0],["ونهرٌ لم يزلْ يجري نقيَّ","يُسَلْسِلُ ماؤُه خَرَزَ الرِّمالِ",108,"ل",1,0],["ونهضْنا بلا توانٍ وما","فاز بإدراكِ سُؤلِه مَنْ توانى",109,"ن",2,0],["ونهي للعصاة عن المعاصي","وحدهم على شرب المدام",110,"م",1,0],["ونهيت عن جمع الصلا","ة بخارج الأوقات عمدا",111,"د",2,0],["ونهيت عن بدع القبو","ر عَنْ نِدَا من حلَّ لحدا",111,"د",2,0],["ونَهْنَهْتُ دمعاً عاصياً غير مُذْعِنِ","وقَدْ قالت الأظعانُ للسَّلوةِ اظعَني",112,"ي",1,0],["وَنَهنَهتُ رَيعانَ العَديِّ كَأَنَّهُ","غَوارِبُ تَيّارٍ من اليَمِّ يُجنَبُ",113,"ب",1,0],["ونَهْضَةَ مَنْ راعَ الأَعادِيَ ناشِئاً","بفتكاته مِنْ قبلِ أَن يَتَرَعْرَعَا",114,"ع",2,0],["ونهى منه النُهى مزدَجِراً","نسخَ الآخرُ عنه الأوّلا",115,"ل",2,0],["ونهضت إذ عجز الانام بأرعن","ملأالملا عدداً بغزر عديد",116,"د",1,0],["ونهضتَ والإِسلامُ يَهتِفُ معلناً","يَا مُنْذِراً قرَّة عينٍ لِي وَلَكْ",117,"ك",1,0],["ونهتم منها بالذي لم نفز به","ونفرح بالفاني ونذهب عقبانا",118,"ن",2,0],["ونهلن كاسات الولاء وقد تبا","دلن الحديث تبادل الاقران",119,"ن",1,0],["ونهدي تحايا للشذا نستديمها","مع النأي لم نحتج لتعريفها كشفا",120,"ف",2,0],["ونهى الفراهيدي الذي أحيا اللغى","بعروضه وبحذقه في شكلها",121,"ل",3,0],["ونهضتَ بالملك الذي لُوِيتْ","منه ظهورُ الجِلَّةِ البُزْلِ",122,"ل",1,0],["ونهضَتْ عنّي بما أوليته","رواحلُ الشعر تجوب الأفقا",123,"ق",2,0],["ونهض الفضلُ له في مَزلَقٍ","مُسَنَّمٍ يُكسَرُ بالعوابرِ",124,"ر",1,0],["ونَهزةُ نهلةٍ لم تَحْلُ حتّى","تأجَّن ماؤها الشِبمُ القَراحُ",125,"ح",1,0],["ونهايةُ الدنيا وغاية أهلها","ملكٌ يزول وسترُ قومٍ يهتك",126,"ك",1,0],["ونهنهتُ بوحي لهُ بالعتابِ","وان كانَ أقطعَ من سرّ جفني",127,"ي",1,0],["وَنَهرٍ مِنَ الأَنهارِ أَلقَت يَدُ الصَّبا","عَلَيهِ شَقيقاً نارُهُ تَتَضَرَّمُ",128,"م",1,1],["ونهْجاً مُمّدناً وجِنساً مُسلسَلا","وحِبراً وأقلاماً ورأْياً مؤيّدا",129,"د",2,0],["ونهج سعت إليك فيه طرائف","فبرزت إذ خافت وخابت سعاته",130,"ت",2,1],["ونهيت جوادك أن يخص بفيضه","فسقى ثرى البادي وريف الحاضر",131,"ر",1,0],["ونَهْجُ الْحَقِّ لا نَبْغي سِواهُ","إليْهِ جُلُّ مَقْصِدِنا يَعُودُ",132,"د",1,0],["ونُهَنِّيكَ يا حبِيبُ ونَرجُو الله","زيدَ النُّعمَى بغيرِ حِسابِ",133,"ب",1,0],["وَنَهاهُم نَبِيُّهُم يَومَ ذاكُم","وَدَعاهُم إِلى الإِلَهِ صُراحا",134,"ح",2,0],["وَنَهَينا عَن حَربِنا تَغلِبَ العُش","وَ فَما عافتِ البَلا وَالمَتاحا",134,"ح",2,0],["وَنَهضةِ أَبناءِ اللقاءِ لخُطّةٍ","تجرُّ مَماتاً أو تقلِّدُ سُؤْدُدا",135,"د",2,0],["ونهاكَ عن جزعٍ فلا","تجزعْ فدعْهُ كما نُهيتا",136,"ت",2,0],["وَنهشةَ مَسموم اللِّثاثِ لعابُهُ","خَروقٌ إلى الأرداءِ كلّ حجابُ",137,"ب",1,0],["ونهار الحشر فجر صادق","ليس فيه إن تحققت كلامْ",138,"م",1,0],["ونَهَبتَ قلباً ليس فيهِ سوِىَ الهَوَى","وسَلَبتَ جسماً ما عليهِ سِوَى البلَى",139,"ل",2,0],["ونَهَضْتَ إِذْ قَعَدَ الملُو","كُ وقُمْتَ إِذْ نَامَ الأَنامُ",140,"م",1,0],["ونهم إِنَّها تعودُ إِذا عا","دَ نوالُ الوزير لي وادِّكَارُه",141,"ر",2,0],["ونهرٍ بظلِّ الكرم أَسودَ فاحِم","كشَعْرِك حَتَّى أَنَّه مِثْلُه جَعْد",142,"د",1,0]]}