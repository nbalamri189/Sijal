96767",""],[5582,"خَلِّ الكَئِيبَ يُقاسِي ما يُقاسِيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63602",""],[5582,"قُمْ يا نَدِيمِي أَدِرْ ما فِي القَوارِيرِ","https://www.poetsgate.com/ViewPoem.aspx?id=63506",""],[5626,"أنا وأنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=189593",""],[5720,"صُوَرُ مِنْ مُعْجَِزاتِهِﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=204628",""],[5725,"سرّ منْ رأى","https://www.poetsgate.com/ViewPoem.aspx?id=177530",""],[2546,"قد كان ما كلّفته زمنا","https://www.poetsgate.com/ViewPoem.aspx?id=201422",""],[2546,"قَدْ كانَ ما كُلِّفْتُه زَمَناً","https://www.poetsgate.com/ViewPoem.aspx?id=17216",""],[402,"جاءت صفيحتكم ولم ار شكلها","https://www.poetsgate.com/ViewPoem.aspx?id=36461",""],[5784,"يا زارع الورد","https://www.poetsgate.com/ViewPoem.aspx?id=189851",""],[5829,"انت الشآم","https://www.poetsgate.com/ViewPoem.aspx?id=150260",""],[5829,"دعوة الى الستر","https://www.poetsgate.com/ViewPoem.aspx?id=157070",""],[5829,"تحية الى اهل العلم","https://www.poetsgate.com/ViewPoem.aspx?id=159310",""],[5887,"شعبي المغوار","https://www.poetsgate.com/ViewPoem.aspx?id=35364",""],[5948,"كُنَّا نَقيِسُ النحوَ فيما مضى","https://www.poetsgate.com/ViewPoem.aspx?id=100607",""],[5956,"بيني وبين الموت","https://www.poetsgate.com/ViewPoem.aspx?id=205159",""],[6068,"أَمِنَ اللُّبَانَاتِ الَّتِي أَتَحَمَّلُ -10-","https://www.poetsgate.com/ViewPoem.aspx?id=175808",""],[6068,"رشيد تونس -18-","https://www.poetsgate.com/ViewPoem.aspx?id=177481",""],[6068,"عصفور بيّة","https://www.poetsgate.com/ViewPoem.aspx?id=179264",""],[6069,"حي كتاباً فضضت خاتمه","https://www.poetsgate.com/ViewPoem.aspx?id=105655",""],[6093,"أنَسيتَ عهداً في الغرام جميلا","https://www.poetsgate.com/ViewPoem.aspx?id=176446",""],[6093,"إنَّ السَّلامَ على المُختارِ قدْ وَجَبَا","https://www.poetsgate.com/ViewPoem.aspx?id=211222",""],[6093,"عودتنا اللطف يا ألله في القدر","https://www.poetsgate.com/ViewPoem.aspx?id=211355",""],[6127,"خوفُ الهلال","https://www.poetsgate.com/ViewPoem.aspx?id=198260",""],[6142,"ولادة المرتضى لم يحوها أحد","https://www.poetsgate.com/ViewPoem.aspx?id=155710",""],[6339,"وطن النماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87894&r=&rc=6",""],[6352,"هي دار غيبته فحي قبابها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22743&r=&rc=4",""]],"verses":[["حَتّى اِتَّقَوا بِكَ ثَمَّ فاغِرَةَ الرَدى","فَنَجَوا وَأَنتَ عَلى طَريقِ المَزرَدِ",0,"د",1,0],["حَتّى أُتيحَ لَهُ وَذاكَ لِحَينِهِ","رَكبٌ رَمَت بِهِمُ الفِجاجُ تِجارُ",1,"ر",1,0],["حَتّى أَتى الماءَ بَعدَ اليَأسِ تُحرِزُهُ","رَبداءُ مَكسُوَّةٌ أَطواقَ أَحجارِ",2,"ر",1,0],["حَتّى أَتاحَ اللَهُ أَن تَتَجَمَّلي","بِيَدِ الكَريمِ وَراحَةِ الأُدَباءِ",3,"ا",2,0],["حَتَّى أتَى مِصْراً بِهَا فَتَطَوَلَتْ","أَيْدٍ لِتَحْمِلَهَا بِغَيْرِ تَوَانِ",4,"ن",1,0],["حَتّى أَتى فَلَكُ الخَلصآءِ دُونَهُمُ","وَاِعتَمَّ قورُ الضُحى بِالآلِ وَاِختَدَرا",5,"ر",2,0],["حَتّى أَتَتكَ مُلوكُ الرومِ صاغِرَةً","مُقَرَّنينَ بِأَغلالٍ وَأَصفادِ",6,"د",1,0],["حَتّى أَتَينا رَحَلنا بِلَيلٍ","وَقَد سُبِقنا بِجِيادِ الخَيلِ",7,"ل",1,0],["حَتّى أَتَوكُم في مَحَلِّ بِلادِكُم","فَسَقَوكُمُ حَتفاً بِبيضٍ قَرقَفِ",8,"ف",1,0],["حتَّى أتى عربيٌّ يستضاء به","مهند من سيوف الله مسلول",9,"ل",1,0],["حتى أتاه رسولُ الموت يُؤْذِنُهُ","أن البقاء لوَجْه الواحِد الصَّمَد",10,"د",1,0],["حتى أتتهم بابنِ زانيةٍ","سلَّتْ سلالته على عجلِ",11,"ل",1,0],["حتى أتاني بالمغيب هجاؤه","فعلمتُ أني عندَهُ بمكان",12,"ن",1,0],["حَتّى أَتَينا أَبا بَكرٍ بِمِدحَتِهِ","وَما تَجَهَّمَني بُعدٌ وَلا حَصَرُ",13,"ر",1,0],["حتى أتُّهمت فقيل تركىّ الهوى","صدقوا هوى الأبطال ملء فؤادي",14,"د",2,0],["حتى أتى الصبح فولى أبي","وأقبلت بعد العناء إبنتي",15,"ي",1,0],["حَتّى أَتى الجَزّارُ ذاتَ يَومِ","وَقَلبَ النَعجَةَ دونَ القَومِ",16,"م",1,0],["حَتّى أَتى الشَطَّ فَبَش","شَ مَن بِهِ وَرَحَّبا",17,"ب",2,0],["حَتّى أَتى الدارَ الَّتي أَعَدَّها","لِمِصرَ تَبني في ذَراها مَجدَها",18,"د",3,0],["حَتّى أَتى العِلمُ الجَسو","رُ فَفَضَّ خاتَمَهُ المَصون",19,"ن",1,0],["حَتّى أَتَوا جَدَثاً كَأَنَّ ضَريحَهُ","في قَلبِ كُلِّ مُوَحِّدٍ مَحفورُ",20,"ر",1,0],["حَتّى أَتى الدُنيا اِبنُ بَجدَتِها","فَشَكا إِلَيهِ السَهلُ وَالجَبَلُ",21,"ل",1,0],["حَتّى أَتَتهُ يَقودُها اِستِحقاهُهُ","وَيَسوقُها حَظٌّ إِلَيهِ مُقبِلُ",22,"ل",1,0],["حَتّى أَتَت أَرضَ هاروتٍ لِعاشِرَةٍ","فيها اِبنُ دَحمَةَ في الحَمراءِ كَالأَجَمِ",23,"م",1,0],["حتى اتُّهمتَ فقالَ قومٌ شاعرٌ","ناجى الطلولَ وطاف بالآثارِ",24,"ر",1,0],["حَتّى أُتيحَ لِظَبيِنا رَجُلٌ","مِن أَهلِ مَكَّةَ زانَهُ حُلَلُه",25,"ل",2,0],["حَتى أَتَى بِبَني الأَحرارَ يَقدُمُهُم","تَخالُهُم فَوقَ مَتنِ الأَرضِ أَجيالا",26,"ل",2,0],["حَتّى أَتيتُكِ يا عُثَيمَةُ زائِراً","أَمشي عَلى عَمدٍ إِلى حَتفي",27,"ف",2,0],["حَتّى اِتَّقوهُ كُلُّهُم بِالطاعَةِ","وَصارَ فيهِم مَلِكَ الجَماعَه",28,"ه",1,0],["حَتّى أَتى المَوصِلَ فَاِستَهَلَّتِ","لَو قَدِرَت صامَت لَهُ وَصَلَّتِ",28,"ت",1,0],["حتّى أتَوْكَ على الأقتابِ من بُهَمٍ","خُزْرِ العيونِ ومن شُوسٍ مذاويد",29,"د",1,0],["حَتّى أَتى مِنكَ ما قَد كُنتُ أَحذَرُهُ","يُردي إِلَيَّ فَأَرداني وَنَكَّلَ بي",30,"ب",2,0],["حَتّى أَتَتكُم تَهادى وَهيَ صافِيَةٌ","عَفواً يُصَفِّقُ فيها الراعِدُ الغَرِدُ",31,"د",1,0],["حَتّى أُتيحَ لَهُ أَخو قَنَصٍ","شَهمٌ يُطِرُّ ضَوارِياً كُثُبا",32,"ب",2,0],["حَتّى أَتَى أَحمَدُ الفُرقانُ يَقرَأُهُ","فِينا وَكُنّا بِغَيبِ الأَمرِ جُهّالا",33,"ل",2,0],["حتى أتانا الغوثُ من ضِياءِ","طَبَّقَ بينَ الأَرْضِ والسماءِ",34,"ا",2,0],["حتى أَتاهُ باشِرٌ من بَلَدَهْ","يعدو برأَسِ رأسِها في صَعدَهْ",34,"ه",1,0],["حتى أتوا تَوّاً لوادِي دَيِّ","ففيهِ عفَّى الرُّشدُ سُبْلَ الغَيِّ",34,"ي",1,0],["حتى أتى حِصْنَ بني عِمارَهْ","والحرْبُ بالتَّدْبير والإدَارَهْ",34,"ه",1,0],["حتّى أتى الحصنَ الّذي تقلَّعا","يحيى بن ذي النُّون به وامتنعا",34,"ع",2,0],["حتّى أتى بهِ الإمامَ راغبا","في الصَّفح عن ذُنوبهِ وتائبا",34,"ب",2,0],["حتَّى أتاهُ المَارقُ التّجيبي","مُستجدياً كالتائِب المُنيبِ",34,"ب",1,0],["حَتَّى أَتَتْ مَرْبِضَ المِسْكِينِ تَبْحَثُهُ","وحَوْلَهَا قِطَعٌ مِنْهُ رَعَابِيلُ",35,"ل",1,0],["حتى أتاها فتىً من مصر تعرفهُ","في الروعِ مقتحما في النقع كرّارا",36,"ر",2,0],["حتى أتتْ وكأنّ الَله قال لها","حُوطي المَمالِكَ تَمْكِيناً وتَشْبيتا",37,"ت",2,0],["حتى أتى الفتح وجاء النصر","واستقبل النبا العظيم العصر",38,"ر",1,0],["حَتَّى أَتَاحَ اللّهُ تِلْقَاءَهَا","نُجُومَ سَعْدٍ نَوْءُهَا خَيِّرُ",39,"ر",1,0],["حَتَّى أُتِيح الفَتْحُ يَجْلُو حُسْنَهُ","فِي يَوْمِهِ إِحْسَانُ يَوْمٍ خَالِ",40,"ل",1,0],["حتى أتيتك فامسح بالنسيم على","آهات جرحي ورش الموج في شرري",41,"ر",2,0],["حتى أتيت؛ فكنت أبلغَ حجةٍ","أدلى بها الأدب الرفيع فأحما",42,"م",2,0],["حتى اتى النصر خفاقاً برايته","كما أشارت إليه الآى والكتب",43,"ب",1,0],["حتّى أتَتْهُ يَقُودُها استِحْقَاقُهُ،","وَيَسُوقُهَا حَظٌّ إلَيْهِ مُقْبِلُ",44,"ل",1,0],["حتى أتيحَ لهُ أخُو قنصٍ","شهمٌ يُطرّ ضوارياً كشُبَا",45,"ب",2,0],["حتى أتى الشطَّ ، فب","شَّ من به ورحَّبا",46,"ب",2,0],["حتى أتى ملك الملوك أمامنا","عبد الحميد الظافر المنصور",47,"ر",1,0],["حَتَّى أَتَاهَا صَوْتُ جِيلِ يَنَايِرَ","فَغَدَتْ تُلَمْلِمُ حُسْنَها وتُجَمِّعُ",48,"ع",1,0],["حَتّى أَتَيتَ مِنِ اِرتِياحِكَ ما كَفى","ذُلَّ السُؤالِ وَخَيبَةَ الآمالِ",49,"ل",1,0],["حَتّى أَتاحَ اللَهُ لي نَيلَ العُلى","بِقُدومِ مَولىً كانَ يَرقُبُ مَقدَمي",50,"م",2,0],["حتى أتى دهرنا في خير منتخب","من آل عثمان أملاكاً وأقيالا",51,"ل",2,0],["حتى أتيتَ مصلى لَو أطاق بأن","يسعى إليك على هاماته فعلا",52,"ل",2,0],["حتى آتيت المصلى خاشعاً وجلاً","وللمصلى ابتهاج حين تقبلُهُ",53,"ل",2,0],["حَتّى أَتى اللَهُ بِالإِسلامِ وَاِفتَتَحَت","كُلَّ البِلادِ وَأَضحَت لِلأَنامِ سَما",54,"م",2,0],["حتى أتى في غاية الصواب","ليس بذي مَيْل ولا اضطراب",55,"ب",1,0],["حتى أتى بعد يأسٍ وهْي في يده","كأنه أسد في جوف عرّيس",56,"س",1,0],["حتّى أتاهُ فضمّه فتصبّرا","وَحَكى الذراعُ لهُ الحديثَ كما جرى",57,"ر",2,0],["حتّى أَتى السدرةَ العلياءَ قال هنا","عَن غيركَ البابُ يا مقبول مقفولُ",58,"ل",1,0],["حَتّى أَتَيتُ مُرِيّاً وَهوَ مُنكَرِسٌ","كَاللَيثِ يَضرِبُهُ في الغابَةِ السَعَفُ",59,"ف",1,1],["حتى أتى الصبحُ وابيضَّت مفارِقُه","والنجمُ بالغربِ فوقَ الجبْل مُنْهَدِفُ",60,"ف",1,0],["حتى أتاك بأُسْد في الكريهة لا","يثنِهم الخوفُ عن خَطْبٍ ولا الحَذَرُ",61,"ر",1,0],["حَتّى أَتى البَيتَ المُقَدَّسَ وَاِرتَقى","نَحوَ السَماءِ فَجازَ كُلَّ عَنانِ",62,"ن",1,0],["حَتّى أَتى إِذنٌ فَسارَ مُهاجِراً","نَحوَ المَدينَةِ هِجرَةَ القُطّانِ",62,"ن",1,0],["حتى أَتاهم قارعا أَسماعهم","بنداءِ حق بالدليل مبين",63,"ن",1,0],["حتى أتاه اصدع بما تؤمر به","فبدوا برغم القوم لم يتكتموا",64,"م",3,0],["حَتّى أَتوكم وَلا الماذيُّ مِن أَمَمٍ","وَلا الظُبى كَثَبٌ من مُرهَقٍ عِجِلِ",65,"ل",1,0],["حتّى أَتى بابَك مُستَبشِراً","ومن أَتى بابَك لا يَيأسُ",66,"س",1,0],["حَتّى أَتَتهُ فَياقٌ طافِحٌ","لا تَتَّقي الزَجرَ وَلا تَنزَجِر",67,"ر",1,0],["حَتّى أَتَيتُ غُلامي وَهوَ مُمسِكُها","يَدعو يَساراً وَقَد جَرَّعتُهُ غَضَبا",68,"ب",2,0],["حتى أتاه من المقدر مزعج","والكون دوار مع الأقدار",69,"ر",1,0],["حتّى أتاهُ يومهُ فدنا لها","وَزواهُ عنها نورها المتلمّعُ",70,"ع",1,0],["حتّى أُتيحَ وللأمورِ عواقبٌ","إقبالُ مَنْصورِ اللِواء مُظفّر",71,"ر",1,0],["حتّى أتَى مِلْءَ الضُّفُر","يُلاعِبُ الظِّلَّ أَشر",72,"ر",1,0],["حتَّى أتَتنا وهيَ ذاتُ قَلائِدٍ","جَعلَ الإمامُ فَريدَهُنَّ فَريدَنا",73,"ن",2,0],["حتَّى أتى الناسُ فَطافُوا به","واستَلمُوا راحَتهُ اليُمنَى",74,"ن",2,0],["حتى أتى الصومُ على فِتيةٍ","لم يعرفوا الصومَ من الفِطرِ",75,"ر",1,0],["حتى أتاح اللَهُ لي علّامَها","وأنا إلى أمثاله أتطلَّب",76,"ب",1,0],["حتى أتتني بالثناء رقاع مَنْ","أدري ولا أدري بلا استحقاق",77,"ق",1,0],["حتَّى أتاني كِتابٌ مِنكَ مُبتسِماً","عن كُلِّ لَفظٍ ومعنىً أشبَهَ الدُّرَرا",78,"ا",1,0],["حتى أتتْ مثلَ القِسيّ تحنّياً","شمسَ البلادِ بدرَها وهلالَها",79,"ل",3,0],["حتى أتيتَ المُعلّى ناشراً سبباً","رآكَ فيها على ضيقٍ سُليمانِ",80,"ن",1,0],["حَتَّى أَتيتُكَ طِيباً طابَ مرتَعُهُ","وَسْطَ الرِّياضِ الَّتِي جادَتْ لَهَا دِيَمُكْ",81,"ك",1,0],["حتى أتاني وحياتي بها ولها","نشر على الأفق من أنفاسها عبقا",82,"ق",2,0],["حتى أتوا زمزماً من مائها شربوا","وما بقى فعلى أثياجهم هرقا",82,"ق",2,0],["حتى أتى المسجد الأقصى وفاء إلى","ليلى بليلته والصبح ما انفلقا",82,"ق",2,0],["حتى أتينا طيبة بعد التي","ثم اللتيا والهموم المبليه",83,"ي",2,0],["حتى أتى البطل الأشمّ كأنّه","تُّل الخرائبِ جَفَّ فيه النَّاضرُ",84,"ر",1,0],["حتى أتاها اللهُ من عميدها","بكاشف الغمّاء من خلالها",85,"ل",3,0],["حتى أتي الز