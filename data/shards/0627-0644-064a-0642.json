{"poems":[[53,"لن تشقوا لذا الجواد غبارا","https://www.aldiwan.net/poem30482.html","الخفيف"],[53,"ألا حيها رب العلى من غوارب","https://www.aldiwan.net/poem30755.html","الطويل"],[77,"رأت والليل قد سدل الرواقا","https://www.aldiwan.net/poem35908.html","الوافر"],[93,"بناء لآل الصيدناوي حققوا","https://www.aldiwan.net/poem11389.html","الطويل"],[93,"بحمدون إن تنشق عليل نسميها","https://www.aldiwan.net/poem11393.html","الطويل"],[30,"دنا البين من مي فردت جمالها","https://www.aldiwan.net/poem29539.html","الطويل"],[37,"أنخن أوما فصرن دهما وما","https://www.aldiwan.net/poem7673.html","المنسرح"],[51,"أبو عثمان والرومي","https://www.aldiwan.net/poem64019.html","الهزج"],[85,"ماذا تريد بإبعادي وإيعادي","https://www.aldiwan.net/poem7801.html","البسيط"],[2,"ألا أبلغ لديك بني تميم","https://www.aldiwan.net/poem25053.html","الوافر"],[80,"بلى جر أذيال الصبا فتصابى","https://www.aldiwan.net/poem31242.html","الطويل"],[44,"أجل أيها الربع الذي خف آهله","https://www.aldiwan.net/poem30388.html","الطويل"],[33,"ألا أيها الطير المحلق غاديا","https://www.aldiwan.net/poem25747.html","الطويل"],[105,"بمثلكما تعلو الديار وتسعد","https://www.aldiwan.net/poem43404.html","الطويل"],[105,"إلى ذات السلاسل من بلي","https://www.aldiwan.net/poem43574.html","الوافر"],[40,"إني زائر ظبيا","https://www.aldiwan.net/poem42304.html","الهزج"],[48,"وعود كرمة كرخ","https://www.aldiwan.net/poem62558.html","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[80,"بلى ، جرّ أذيال الصبا وتصابى","https://www.poetsgate.com/ViewPoem.aspx?id=3019",""],[115,"قرطبة","https://www.aldiwan.net/poem24050.html","الطويل"],[209,"إذا اعتكرت دياجى الظلم حينا","https://www.aldiwan.net/poem46282.html","الوافر"],[209,"إلى القاضي وعينيه سلام","https://www.aldiwan.net/poem46304.html","الوافر"],[259,"إلام اصطباري لا يرى غير خائب","https://www.aldiwan.net/poem38372.html","الطويل"],[278,"أبعدك أتقي نوب الزمان","https://www.aldiwan.net/poem60705.html","الوافر"],[280,"هلموا اسمعوا أحجية أبت النقصا","https://www.aldiwan.net/poem32725.html","الطويل"],[307,"فإن سدوره أمسى غرورا","https://www.aldiwan.net/poem50248.html","الوافر"],[362,"ألم تريا أن الحمول تسير","https://www.aldiwan.net/poem60891.html","الطويل"],[413,"ألا إن هذا الفؤاد اضطرم","https://www.aldiwan.net/poem54173.html","المتقارب"],[426,"خليلي جروح القلب شتى","https://www.aldiwan.net/poem41054.html","الوافر"],[456,"حمام اللوى رفقا به فهو لبه","https://www.aldiwan.net/poem56306.html","الطويل"],[462,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[468,"عفا مزج إلى لصق","https://www.aldiwan.net/poem4717.html","مجزوء الوافر"],[477,"متى يا دهر تجمع شمل أنسى","https://www.aldiwan.net/poem36931.html","الوافر"]],"verses":[["أَليَقُ الناسِ بِالسَماحِ أَكُفّاً","وَالمَعالي شَمائِلاً وَنِجارا",0,"ر",2,0],["إِلى قائِمٍ بِالمَجدِ يَحمي فُروجَهُ","وَيَطعَنُ عَنهُ بِالقَنا وَالرَغائِبِ",1,"ب",1,0],["إلى قمَرِ الوِزارَةِ جلّلَتْهُ","إياةُ السّعْدِ نوراً واتّساقَا",2,"ق",2,0],["إِلَى قَوْمِهِمْ أَسْدُوا جمِيلاً مُؤرَّخاً","بِمَا شَيَّدُوهُ لِلْفَضِيلَةِ وَالعِلْمِ",3,"م",1,0],["إِلَى قِمَمٍ شُمٍّ ذَوَاهِبَ فِي الْعُلَى","يُؤَخِّرُهَا حُسْنٌ وَحُسْنٌ يُقَدِّمُ",4,"م",1,0],["إِلى قُنَّةٍ فَوقَ السَرابِ كَأَنَّها","كُمَيتٌ طَواها القَودُ فَاِقوَرَّ آلُها",5,"ل",3,0],["الى قوام كأنها قردا","ببيداء لامها الزغب",6,"ب",1,0],["إلى قفْرٍ من الأرض","وما يُصنَعُ بالقفْر",7,"ر",1,0],["إلى قفار إلى سهل إلى جبل","إلى غلام من الفجار مصطاد",8,"د",1,0],["إِلى قَلَهى تَكونُ الدارُ مِنّا","إِلى أَكنافِ دومَةَ فَالحَجونُ",9,"ن",1,0],["إلى قمرٍ تسري إليه كأنّما","عليه سماءُ اللّه تُغلِقُ بابا",10,"ب",2,0],["إِلى قُطُبِ الدُنيا الَّذي لَو بِفَضلِهِ","مَدَحتُ بَني الدُنيا كَفَتهُم فَضائِلُه",11,"ل",2,0],["إِلى قَفرَةٍ مِن نَحوِ لَيلى مَضَلَّةٍ","بِها القَلبُ مِنّي موثَقٌ وَفُؤادِيا",12,"د",3,0],["إِلى قاتِمِ الأَعماقِ ما فيهِ مُشرِقٌ","يُضيءُ وَلا مِنهُ إِلى عَلوَ مَصعَدُ",13,"د",1,0],["إلى قومٍ من الأعداءِ تُطوَى","جَوانِحُهُم على الدّاءِ الدَوِيِّ",14,"ي",1,0],["إِلى قَلتٍ بِشاهِقَةٍ","مِنَ الوُرّادِ يَحوِيهِ",15,"ي",2,0],["إِلى قَنانٍ تِلالاً","مُدَملَجاتِ القِلادِ",16,"د",1,0],["إلى قِمَّةِ الزَّمنِ الغابرِ","سَمَتْ رَبَّةُ الشعر بالشاعرِ",17,"ر",1,1],["إلى قمرٍ تسري إليه كأنَّما","ترى قلما منها يخطّ كتابا",18,"ب",2,0],["إلى (قاعةِ الزَّهراءِ) لَبَّيْتُ مُحْرِمًا","ووَلّادَتي بَيْتُ القَصيدِ المُرَّصَعِ",19,"ع",1,0],["إلى قلبي تعالى لا تهابى","فإني بالشدائد قد أنست",20,"ت",1,0],["إلى قاضى القضاة أبث شوقى","ونار الوجد تأخذ بالوتين",21,"ن",1,0],["إلى قمر الدنيا إلى فارس الوغى","إلى أسد الهيجاء يوم التجارب",22,"ب",1,0],["أَلِي قَلْبٌ أَلِي لُبٌّ فَأَمْضِي","مَضاءَ السَّيْفِ فِهِ وَالسِّنانِ",23,"ن",1,0],["إِلى قُرصِها جَرَّت يَدُ الشَمسِ نارَها","لِتَحمي بِهِ مِن بَردِ أَمواهِها القُرصا",24,"ص",2,0],["إِلى قَبرٍ يُغادَرُ فيهِ فَرداً","نَأى مِنهُ الأَقارِبُ وَالمَوالي",25,"ي",1,0],["إلى قُطْبِ مَلكٍ لم يَزلْ فلَكُ العُلا","عليه بشُهْبِ المكرماتِ يَدور",26,"ر",1,0],["إلى قائد عسكر المسلمين","ومقدامهم في الحروب الدهم",27,"م",1,0],["إلى قاضي المحبة تشتكيني","سألت وصالها فأبت وآلت",28,"ت",1,0],["إلى قمرٍ طرفي تعلَّلَ دونه","وكم قمرٍ غطَّته دونِيَ سُحْبُهُ",29,"ب",2,0],["اليقظ الندب الأبي المصعب","السمح الوفي القلبي الحول",30,"ل",1,0],["إِلى قاعِ النقيرِ إِلى","قَرارِ حِلال ذي حَدَرِ",31,"ر",1,0],["إلى قصر الذبيح تبث وجدا","إلى الملك العزيز وأنت منسي",32,"ي",1,0]]}