{"poems":[[55,"لن تشقوا لذا الجواد غبارا","https://www.aldiwan.net/poem30482.html","الخفيف"],[55,"ألا حيها رب العلى من غوارب","https://www.aldiwan.net/poem30755.html","الطويل"],[79,"رأت والليل قد سدل الرواقا","https://www.aldiwan.net/poem35908.html","الوافر"],[95,"بناء لآل الصيدناوي حققوا","https://www.aldiwan.net/poem11389.html","الطويل"],[95,"بحمدون إن تنشق عليل نسميها","https://www.aldiwan.net/poem11393.html","الطويل"],[32,"دنا البين من مي فردت جمالها","https://www.aldiwan.net/poem29539.html","الطويل"],[39,"أنخن أوما فصرن دهما وما","https://www.aldiwan.net/poem7673.html","المنسرح"],[53,"أبو عثمان والرومي","https://www.aldiwan.net/poem64019.html","الهزج"],[87,"ماذا تريد بإبعادي وإيعادي","https://www.aldiwan.net/poem7801.html","البسيط"],[2,"ألا أبلغ لديك بني تميم","https://www.aldiwan.net/poem25053.html","الوافر"],[82,"بلى جر أذيال الصبا فتصابى","https://www.aldiwan.net/poem31242.html","الطويل"],[46,"أجل أيها الربع الذي خف آهله","https://www.aldiwan.net/poem30388.html","الطويل"],[35,"ألا أيها الطير المحلق غاديا","https://www.aldiwan.net/poem25747.html","الطويل"],[107,"بمثلكما تعلو الديار وتسعد","https://www.aldiwan.net/poem43404.html","الطويل"],[107,"إلى ذات السلاسل من بلي","https://www.aldiwan.net/poem43574.html","الوافر"],[42,"إني زائر ظبيا","https://www.aldiwan.net/poem42304.html","الهزج"],[50,"وعود كرمة كرخ","https://www.aldiwan.net/poem62558.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[82,"بلى ، جرّ أذيال الصبا وتصابى","https://www.poetsgate.com/ViewPoem.aspx?id=3019",""],[121,"قرطبة","https://www.aldiwan.net/poem24050.html","الطويل"],[215,"إذا اعتكرت دياجى الظلم حينا","https://www.aldiwan.net/poem46282.html","الوافر"],[215,"إلى القاضي وعينيه سلام","https://www.aldiwan.net/poem46304.html","الوافر"],[266,"إلام اصطباري لا يرى غير خائب","https://www.aldiwan.net/poem38372.html","الطويل"],[285,"أبعدك أتقي نوب الزمان","https://www.aldiwan.net/poem60705.html","الوافر"],[287,"هلموا اسمعوا أحجية أبت النقصا","https://www.aldiwan.net/poem32725.html","الطويل"],[314,"فإن سدوره أمسى غرورا","https://www.aldiwan.net/poem50248.html","الوافر"],[369,"ألم تريا أن الحمول تسير","https://www.aldiwan.net/poem60891.html","الطويل"],[422,"ألا إن هذا الفؤاد اضطرم","https://www.aldiwan.net/poem54173.html","المتقارب"],[435,"خليلي جروح القلب شتى","https://www.aldiwan.net/poem41054.html","الوافر"],[463,"حمام اللوى رفقا به فهو لبه","https://www.aldiwan.net/poem56306.html","الطويل"],[469,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[475,"عفا مزج إلى لصق","https://www.aldiwan.net/poem4717.html","مجزوء الوافر"],[484,"متى يا دهر تجمع شمل أنسى","https://www.aldiwan.net/poem36931.html","الوافر"],[609,"","https://poetry.dctabudhabi.ae/diwan/poem/198597","الوافر"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96982","المتقارب"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87244","الوافر"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129525","المنسرح"],[969,"","https://poetry.dctabudhabi.ae/diwan/poem/145607","الرجز"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124337",""],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/121993","الطويل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115943","الطويل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114777","الطويل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108435","الوافر"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137078",""],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87324","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87317","الرجز"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100893","الطويل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116503","الوافر"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65939","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201950","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202398","الطويل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115628","المتقارب"],[3383,"","https://poetry.dctabudhabi.ae/diwan/poem/34989","الطويل"],[3552,"","https://poetry.dctabudhabi.ae/diwan/poem/27131","الوافر"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108089","البسيط"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128919","المجتث"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133287","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111465","المتقارب"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54394","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94573","الوافر"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81948","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133096","الوافر"],[4473,"","https://poetry.dctabudhabi.ae/diwan/poem/130599","الوافر"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33220","الوافر"],[4791,"دموع الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=35898",""],[4902,"مريض اللي فقد \"سلطان\"","https://www.poetsgate.com/ViewPoem.aspx?id=22951",""],[5064,"سُحُبُ الإبريز","https://www.poetsgate.com/ViewPoem.aspx?id=199176",""],[5111,"غَيْمُ الْخَلِيجِ","https://www.poetsgate.com/ViewPoem.aspx?id=212608",""],[5246,"إني لفي أسف مما له انقلبوا","https://www.poetsgate.com/ViewPoem.aspx?id=187030",""],[5277,"سلامٌ إلى طبّ القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=200957",""],[5277,"من يصدقُ يغار","https://www.poetsgate.com/ViewPoem.aspx?id=206846",""],[5323,"انسكاب الشعور","https://www.poetsgate.com/ViewPoem.aspx?id=207292",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5363,"إلى قلبه يأوي غزالٌ وقسوَرهْ","https://www.poetsgate.com/ViewPoem.aspx?id=144295",""],[5431,"ارفق بقلبه .....","https://www.poetsgate.com/ViewPoem.aspx?id=210357",""],[5563,"غيداء لعوب","https://www.poetsgate.com/ViewPoem.aspx?id=211741",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5751,"بيت الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=214721",""],[5956,"الجمال الحنون","https://www.poetsgate.com/ViewPoem.aspx?id=184945",""],[5956,"أنهكتَ نفسك لتنفعني وتنفعَ العالم","https://www.poetsgate.com/ViewPoem.aspx?id=206262",""],[2575,"فمان الله","https://www.poetsgate.com/ViewPoem.aspx?id=24770",""],[6124,"يأسي","https://www.poetsgate.com/ViewPoem.aspx?id=160053",""],[6142,"مذ صلصل الله من طين خليقته","https://www.poetsgate.com/ViewPoem.aspx?id=155709",""]],"verses":[["أَليَقُ الناسِ بِالسَماحِ أَكُفّاً","وَالمَعالي شَمائِلاً وَنِجارا",0,"ر",2,0],["إِلى قائِمٍ بِالمَجدِ يَحمي فُروجَهُ","وَيَطعَنُ عَنهُ بِالقَنا وَالرَغائِبِ",1,"ب",1,0],["إلى قمَرِ الوِزارَةِ جلّلَتْهُ","إياةُ السّعْدِ نوراً واتّساقَا",2,"ق",2,0],["إِلَى قَوْمِهِمْ أَسْدُوا جمِيلاً مُؤرَّخاً","بِمَا شَيَّدُوهُ لِلْفَضِيلَةِ وَالعِلْمِ",3,"م",1,0],["إِلَى قِمَمٍ شُمٍّ ذَوَاهِبَ فِي الْعُلَى","يُؤَخِّرُهَا حُسْنٌ وَحُسْنٌ يُقَدِّمُ",4,"م",1,0],["إِلى قُنَّةٍ فَوقَ السَرابِ كَأَنَّها","كُمَيتٌ طَواها القَودُ فَاِقوَرَّ آلُها",5,"ل",3,0],["الى قوام كأنها قردا","ببيداء لامها الزغب",6,"ب",1,0],["إلى قفْرٍ من الأرض","وما يُصنَعُ بالقفْر",7,"ر",1,0],["إلى قفار إلى سهل إلى جبل","إلى غلام من الفجار مصطاد",8,"د",1,0],["إِلى قَلَهى تَكونُ الدارُ مِنّا","إِلى أَكنافِ دومَةَ فَالحَجونُ",9,"ن",1,0],["إلى قمرٍ تسري إليه كأنّما","عليه سماءُ اللّه تُغلِقُ بابا",10,"ب",2,0],["إِلى قُطُبِ الدُنيا الَّذي لَو بِفَضلِهِ","مَدَحتُ بَني الدُنيا كَفَتهُم فَضائِلُه",11,"ل",2,0],["إِلى قَفرَةٍ مِن نَحوِ لَيلى مَضَلَّةٍ","بِها القَلبُ مِنّي موثَقٌ وَفُؤادِيا",12,"د",3,0],["إِلى قاتِمِ الأَعماقِ ما فيهِ مُشرِقٌ","يُضيءُ وَلا مِنهُ إِلى عَلوَ مَصعَدُ",13,"د",1,0],["إلى قومٍ من الأعداءِ تُطوَى","جَوانِحُهُم على الدّاءِ الدَوِيِّ",14,"ي",1,0],["إِلى قَلتٍ بِشاهِقَةٍ","مِنَ الوُرّادِ يَحوِيهِ",15,"ي",2,0],["إِلى قَنانٍ تِلالاً","مُدَملَجاتِ القِلادِ",16,"د",1,0],["إلى قِمَّةِ الزَّمنِ الغابرِ","سَمَتْ رَبَّةُ الشعر بالشاعرِ",17,"ر",1,1],["إلى قمرٍ تسري إليه كأنَّما","ترى قلما منها يخطّ كتابا",18,"ب",2,0],["إلى (قاعةِ الزَّهراءِ) لَبَّيْتُ مُحْرِمًا","ووَلّادَتي بَيْتُ القَصيدِ المُرَّصَعِ",19,"ع",1,0],["إلى قلبي تعالى لا تهابى","فإني بالشدائد قد أنست",20,"ت",1,0],["إلى قاضى القضاة أبث شوقى","ونار الوجد تأخذ بالوتين",21,"ن",1,0],["إلى قمر الدنيا إلى فارس الوغى","إلى أسد الهيجاء يوم التجارب",22,"ب",1,0],["أَلِي قَلْبٌ أَلِي لُبٌّ فَأَمْضِي","مَضاءَ السَّيْفِ فِهِ وَالسِّنانِ",23,"ن",1,0],["إِلى قُرصِها جَرَّت يَدُ الشَمسِ نارَها","لِتَحمي بِهِ مِن بَردِ أَمواهِها القُرصا",24,"ص",2,0],["إِلى قَبرٍ يُغادَرُ فيهِ فَرداً","نَأى مِنهُ الأَقارِبُ وَالمَوالي",25,"ل",2,0],["إلى قُطْبِ مَلكٍ لم يَزلْ فلَكُ العُلا","عليه بشُهْبِ المكرماتِ يَدور",26,"ر",1,0],["إلى قائد عسكر المسلمين","ومقدامهم في الحروب الدهم",27,"م",1,0],["إلى قاضي المحبة تشتكيني","سألت وصالها فأبت وآلت",28,"ت",1,0],["إلى قمرٍ طرفي تعلَّلَ دونه","وكم قمرٍ غطَّته دونِيَ سُحْبُهُ",29,"ب",2,0],["اليقظ الندب الأبي المصعب","السمح الوفي القلبي الحول",30,"ل",1,0],["إِلى قاعِ النقيرِ إِلى","قَرارِ حِلال ذي حَدَرِ",31,"ر",1,0],["إلى قصر الذبيح تبث وجدا","إلى الملك العزيز وأنت منسي",32,"س",2,0],["إلى قِمَم المَفَاخِرِ جِئتَ تَسْعَى","فما اسْطَاعُوا بِجَانِبِكَ الظُّهُورَا",33,"ر",2,0],["إلى قول قائلهم صادقاً","كأنا رياض ومنك السحب",34,"ب",1,0],["إِلى قَوم أَزالوا عَق","لَهُ بِالعَقل وَالصَلب",35,"ب",1,0],["إلى قرار العلا ومصدره","ورد الأماني وبغية القاصد",36,"د",1,0],["إلى قدورٍ هي أقصى عقل","لم يك فيها قط غير البقل",37,"ل",1,0],["إلى قاضٍ تأنَّى في القضايا","ورام القيسَ فيها والدَّليلا",38,"ل",2,0],["إِلَى قَصْدِ قطب الدِّينِ وَافَيْتُ عِنْدَمَا","أَقَمْتُ عَلَى التَّرْحَالِ فِي الشَّرْقِ وَالغَرْبِ",39,"ب",1,1],["إلى قمر قد كان فى الجوِّ طالعاً","فأفضى به ريبُ المنونِ إلى الفضا",40,"ض",2,0],["إلى قَنَصٍ تَنميه سوادءُ نَبتهُ","كِلا طرَفَيهِ في مَعَدّ لِمَنسَبِ",41,"ب",1,0],["إلى قاضي المحبة تشتكيني","فتاة من عهود الحب حالت",42,"ت",1,0],["الى قطب الزمان الى مليك","الى حبر ينوب عن الرسول",43,"ل",1,1],["إلى قَريب جَزيرةِ المَشوِي","وَهيَ على اليَسارِ يَا حُبِّي",44,"ي",1,0],["إلى قفاصي افهمِ المجاري","في مَطلعِ السُّهيل لا تُمارِ",45,"ر",1,0],["إلى قبة الزباءِ والشرفِ الذى","يعزُّ على عزم السيوفل البواترِ",46,"ر",1,0],["الى قوم يقيمون القوافى","بقافية النوال ويكرمونا",47,"ن",2,0],["الى قوم بهم يحمى حمانا","ومن اهل الجراءة يحفظونا",47,"ن",2,0],["الى قوم اذا باع البرايا","مكارمهم لها هم يشترونا",47,"ن",2,0],["إلى قوله سبحانه جل ولتكن","إلي الخير منكم أمة يا بريتي",48,"ي",1,0],["اليّ قبل انطفاء السمْع والبصر","يا نجمَ أُفقي ويا شمسي ويا قمري",49,"ي",1,1],["إلى قوتها تسعى وتسعى لغيرها","فتلقى دروساً في التعاون لا تنسى",50,"ا",1,0],["إلى قدّك اللدن يعزى الهيف","فما هبّت الريح إلا انعطَف",51,"ف",1,1],["إِلى قَطَرِيٍّ في الشَراةِ مُعالِجاً","وَلَستُ إِلى غَيرِ الشَراةِ بِعائِجِ",52,"ج",1,0],["إِلى قَومٍ إِذا سَمِعوا بِنَعيي","بَكى شُبّانُهُم وَبَكى الغَواني",53,"ن",2,0],["إِلى قوامِكَ هذا الصبُّ يشتاقُ","وتنهمي منه يومَ البينِ آماقُ",54,"ق",1,1],["الى قرين همام","كان الأبي السخيا",55,"ي",2,0],["إلى قريش وفهر ينتمى نسبا","فهو ابن عم رسول الله والآل",56,"ل",1,0],["إِلى قُدسِ إِليُون حَثَّت خُطَاها","وفِيبُوسُ مِن فَرغَمُوسَ اقتَفاها",57,"ه",2,0],["إلى قلّةِ الرَّاعي إلى نابعٍ إلى","جراولَ فالنخلِ الذي لم يزل قفرا",58,"ر",2,0],["إلى قلبي الهناءُ بجوق أنسٍ","تألَّف حوريٍّ وخوري",59,"ر",2,0],["إلى قاسمٍ ما بين حق وباطل","وجئنا إلى سرمين في غيث هاطل",60,"ل",1,0],["إلى قبرٍ تصير فيه وحيداً","فريداً دايماً حتى النشور",61,"ر",1,0],["إلى قفراء موحشة","تهيج بلابل الصدر",62,"ر",1,0],["إلى قمرٍ منايا النا","ظِرين إليه في يده",63,"د",2,0],["إلى قعد هاجوس قلبي معك قام","تامرني ابعد عنك اقول عاصيك",64,"ك",1,0],["إلى قالوا مريض قل .. مريض اللي فقد سلطان","وإلى قالوا بعيدٍ قل .. قريب الهمّ لسنافي",65,"ف",2,0],["إِلى قِبَابِكِ فِي أُفْقِ اللُّجَينِ أرَى","وجَهًا بهِ سُحُبُ الإبْريزِ تُسْتَسقَى",66,"ق",2,0],["إلى قُدُسِ الْقَصِيدِةِ يَنْتَمِيْ","إلَى قُدْس ِالْقَصِيدةِ طَابَ عِرْقَا",67,"ق",2,0],["إلى قطيع فحيتهم برقصتها","واستجمع الركب في مشياتها الطرب",68,"ب",1,0],["إلى قبرِكَ الغالي ومنبرِكِ الَّذَيْ","هما روضةٌ غنَّاءُ..طابتْ مُقاما",69,"م",2,0],["إلى قابِ شوقيْها دنوتُ وأقربُ","فصافحتُ جفنيها..وكادتْ لتهربُ",70,"ب",1,1],["إلى قائلٍ دعْ حديثَ العقولِ","وجسدْ شعورَ الهنا والألمْ",71,"م",1,0],["إلى قبر خير العالمين محمدٍ","وأصحابه والصالحين 