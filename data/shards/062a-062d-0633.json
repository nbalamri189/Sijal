://www.poetsgate.com/ViewPoem.aspx?id=16498",""],[5409,"خصها الله بالجمال الفريد","https://www.poetsgate.com/ViewPoem.aspx?id=155267",""],[1134,"تَحسبُ فوقَ الشولِ منه أخْشَبَا","https://www.poetsgate.com/ViewPoem.aspx?id=98402",""],[5461,"شرهة العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=28441",""],[5461,"من عذابي","https://www.poetsgate.com/ViewPoem.aspx?id=28440",""],[5463,"نامي وزيدي المنام","https://www.poetsgate.com/ViewPoem.aspx?id=25790",""],[5525,"تخير","https://www.poetsgate.com/ViewPoem.aspx?id=837",""],[5606,"مانت ذيب","https://www.poetsgate.com/ViewPoem.aspx?id=202702",""],[5628,"صورة مؤلمة","https://www.poetsgate.com/ViewPoem.aspx?id=178520",""],[5667,"آهِ من أرضِ دبي","https://www.poetsgate.com/ViewPoem.aspx?id=214804",""],[5730,"قميص الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=210352",""],[5739,"الوتين ...!","https://www.poetsgate.com/ViewPoem.aspx?id=155469",""],[5756,"ثامن السبع العجايب","https://www.poetsgate.com/ViewPoem.aspx?id=5422",""],[5776,"الغلام والملكة","https://www.poetsgate.com/ViewPoem.aspx?id=199336",""],[402,"عشت كالطفل أصاب اللما","https://www.poetsgate.com/ViewPoem.aspx?id=36299",""],[5848,"تنهيدة قتيل","https://www.poetsgate.com/ViewPoem.aspx?id=50601",""],[5848,"تصطفل يا قلب","https://www.poetsgate.com/ViewPoem.aspx?id=50599",""],[5881,"وهاجر","https://www.poetsgate.com/ViewPoem.aspx?id=183798",""],[161,"أخيرا أثلجت","https://www.poetsgate.com/ViewPoem.aspx?id=176767",""],[6056,"ساعة الصبر","https://www.poetsgate.com/ViewPoem.aspx?id=130358",""],[4442,"أرني في العلا نجوم سمائك","https://www.poetsgate.com/ViewPoem.aspx?id=170993",""],[6142,"يا أول الناس للإسلام مرتبة","https://www.poetsgate.com/ViewPoem.aspx?id=155742",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""],[159,"وغادة ٍ ترفلُ في الشبابِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26940&r=&rc=11",""],[6225,"حسد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80895&r=&rc=164",""],[463,"تغربْ فالبدار الحبيبة ِ دارُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60062&r=&rc=118",""],[2220,"رأيتُ ذكوراً في إناثٍ سواجرٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11432&r=&rc=306",""]],"verses":[["تُحَسِّبُ أَيّامَ الحَياةِ وَإِنَّها","لَأَعذَبُ مِن طَعمِ الخُلودِ لِطاعِمِ",0,"م",1,0],["تَحسَبُها الوَرهاءَ ريعَت فَنَجَت","مِنَ الأَذى طارِحَةً قِناعَها",1,"ع",3,0],["تُحسَبُ الأَرماحُ مِن قَعقاعِها","شَجَراً لِلطَيرِ فيهِنَّ لَغَط",2,"ط",1,0],["تَحسِبُ الشوسَ عَلى أَكتادِها","فِلَقَ الجَندَلِ في ماءِ الزَرَد",3,"د",1,0],["تَحسُدُ عَيني عَينَ مَن يَرقُدُ","وَمُسهِري أَوَّلُ مَن أَحسُدُ",4,"د",1,1],["تَحَسَّسُ عَنّي أُمُّ سَكنٍ وَأَهوَنُ الش","شَكاةِ شِفاءً ظِنَّةُ المُتَحَسِّسِ",5,"س",1,1],["تَحسِبُ الزِقَّ لَدَيها مُسنَداً","حَبَشِيّاً نامَ عَمداً فَاِنبَطَح",6,"ح",1,0],["تَحسَبُ الأُفقَ بَينَها لازَوَرداً","نُثِرَت فَوقَهُ دَنانيرُ تِبرِ",7,"ر",1,0],["تَحسَبُهُ غَضبانَ مِن عِزِّهِ","ذَلِكَ مِنهُ خُلُقٌ ما يَحول",8,"ل",1,0],["تحِسُّ لِلأَبْصَارِ فِي نَفْسِهَا","وَقْعَ النَّدَى مِنْ نَبْتَةٍ نَاضِرَهْ",9,"ر",2,0],["تَحْسَبُ الدُّنْيَا مَثِيراً جَيداً","وَتَرَى الدَّهْرَ نَظِيماً مُحْكَمَا",10,"م",2,0],["تحسُدُ الأفلاكُ منه","قوسَهُ السهل المنيعا",11,"ع",2,0],["تحسب العسابرين فيه سكارى","من هواء تنسّسموه غبارا",12,"ر",2,0],["تحسَبني في مضاجعي حَسَك","يقلبني وخزه فأنقلب",13,"ب",1,0],["تَحُسُّهُمُ السُيوفُ كَما تَسامى","حَريقُ النارِ في أَجَمِ الحَصيدِ",14,"د",1,0],["تَحسُرُ الديباجَ عَن أَذرُعِهِم","عِندَ ذي تاجٍ إِذا قالَ فَعَل",15,"ل",1,0],["تَحسِبُها مَجنونَةٌ تَغتَلي","إِذ لَفَّعَ الآلُ رُؤوسَ الأَكام",16,"م",1,0],["تحْسَبُ العينُ بشْرَهُ في نداه","لَمْعَ بَرْقٍ في عارضٍ مَنْضُودِ",17,"د",1,0],["تحسن في البدأة لكنها","أحسن من بدأتها الرجعه",18,"ع",2,0],["تَحَسَّرنَ وَاِستَقبَلنَ لِلصَيفِ وَقدَةً","تُغَيِّرُ أَلوانَ الرِجالِ سَمومُها",19,"م",3,0],["تَحسَبُ الأَرضُ قَد جَرَت حينَ يَجر","وَتَراهُ كَأَنَّهُ في رُكودِ",20,"د",1,0],["تحسب النفس عنده انها في","عالم غير عالم الاوزار",21,"ر",1,0],["تحسبهم اما النهار عتلى","ملائكا في حضرة القدس",22,"س",1,0],["تحسب المكتوب منه","ذهباً فوق لُجين",23,"ن",1,0],["تَحسَبُهُم ضَفادِعاً","أَرسَلتَها في جَرَّةِ",24,"ه",1,0],["تَحسَبُها صُوِّرَت","مِن شَهَواتِ النَهَم",25,"م",1,0],["تَحسَبُ المَيتَ في نَواحيهِ يُعي","نَفخَةَ الصورِ أَن تَلُمَّ عِظامَه",26,"م",2,0],["تَحسَبُ الماءَ خَطَّ في لَهَبِ النا","رِ أَدَقَّ الخُطوطِ في الأَحرازِ",27,"ز",1,0],["تحسَّنتِ الأيامُ ثم تنكرتْ","فعفَّى على إحسانهنَّ ذنوبُها",28,"ب",3,1],["تَحسِبُها في كَأسِها ياقوتَةً","أَو قَبَساً أُلهِبَ عَمداً فَاِلتَهَب",29,"ب",1,0],["تُحسَبُ في وَفرِهِ يَداهُ يَدَي","عَدُوِّهِ أَو لِغَيرِهِ نَشَبُه",30,"ب",2,0],["تَحسِبُهُ نَشوانَ إِمّا رَنا","لِلفَترِ مِن أَجفانِهِ وَهوَ صاح",31,"ح",1,0],["تَحَسَّنَتِ الدُنيا بِعَدلِكَ فَاِغتَدَت","وَآفاقُها بيضٌ وَأَكنافُها خُضرُ",32,"ر",1,0],["تَحسِبُ الشيبَ في الوَقيعَةِ شُبّا","ناً إِذا صافَحَ الصَقيلُ الصَقيلا",33,"ل",2,0],["تحسبُ الريحَ جِنّةً تعتريه","فهو كالقَرْمِ شِدْقُهُ ذو لغامِ",34,"م",1,0],["تَحسبُ العينُ رجلَهُ نصب رحلٍ","أصلمٌ ليْتَ أنّه كان أجدَع",35,"ع",1,0],["تَحسِبُ البحرَ بَعضَ جَدواهُ لَولا","أَنَّهُ في الورودِ عَذبٌ نَميرُ",36,"ر",1,0],["تَحسِبُ الطَّيرَ وهيَ وَقفٌ عَلَيهِ","رُقِمَتْ منه في مُلاء الغبارِ",37,"ر",1,0],["تحسبُ الورد نثيراً حَوْلَهُ","وهو مُحْمَرّ مُجاجاتِ الرّماح",38,"ح",1,0],["تحسبُ لفظاً بأختها نغَماً","ويودعُ المسمعينَ ما حسبَه",39,"ب",2,0],["تُحَسَّنُ في عَينَيهِ إِن كُنتَ زائِراً","وَتَزدادُ حُسناً كُلَّما جِئتَ طالِبا",40,"ب",2,0],["تَحْسَبُهُ مِنْ نَضْحِ أَشْدَاقِهِ","رَكِيَّةً تَجْرِي دَمَاً أَوْ تَمُوهْ",41,"و",2,0],["تُحسَبُ مَطروفَةً وَما طُرِفَت","إِنسانُها مِن دُموعِها شَرِقُ",42,"ق",1,0],["تَحَسَّرَ عَنهُنَّ العَرائِكُ بَعدَما","بَدَأنَ وَهُنَّ المُقفِراتُ العَلائِفُ",43,"ف",1,0],["تَحسِبُهُ مِن عُلاكَ مُستَرِقاً","بَهجَةَ مَرأى وَحُسنَ مُختَبَرِ",44,"ر",1,0],["تَحسَبُهُ إِذا بَدا","سَماجَةَ النَزيزِ",45,"ز",1,0],["تَحسَبُ قَومي يُضَيّعونَ دَمي","ما ضاعَ قَبلي لِهاشِمٍ ثارُ",46,"ر",1,0],["تَحسَبُهُ يُزهى عَلى فارِسِهِ","وَإِنَّما يُزهى بِهِ إِذا رُكِب",47,"ب",1,0],["تَحْسَبُ فيها طَرَفَيْ رُمْحِهِ","قوسَ هلالٍ كرَّ في مَحق",48,"ق",1,0],["تَحَسَّنَتِ الدُنيا بِوَجهِ خَليفَةٍ","هُوَ الصُبحُ إِلّا أَنَّهُ الدَهرَ مُسفِرُ",49,"ر",1,0],["تَحسَبُ الوَردَ بِخَدَّي","هِ يُناغي الياسَمينا",50,"ن",2,0],["تحسبُها من لينها خزّة","أو فنَكاً من فنَكِ الصينِ",51,"ن",1,0],["تُحسِنُ المَشيَ في المَنامِ وَلا تُح","سِنُ يَقظى مَشيَ المُريبِ المُصادي",52,"د",2,0],["تَحسُدُها الجاراتُ مِن حُسنِها","وَمِثلُ عَبّادَةَ فَليُحسَدِ",53,"د",1,0],["تَحَسّاها فَمِن مَزجٍ وَصِرفٍ","يَعُلُّ كَأَنَّما وَرَدَ الحِساءَ",54,"س",3,0],["تَحُسُّ الحَياةِ عَلى الأَحياءِ مُشتَمِلٌ","وَساكِنو الأَرضِ مِن لُؤمٍ بِلا كَرَمِ",55,"م",1,1],["تَحَسَّمَت مِنهُ أَيّامٌ مُنَغِّصَةٌ","مِن بَعدِ ما وَدَّ في وَدّانَ أَو وَدَنا",56,"ن",2,0],["تَحسِبُ الطَرفَ عَلَيها نَجدَةٌ","يا لِقَومي لِلشَبابِ المُسبَكِر",57,"ر",1,0],["تحسِبُ الهجرَ حَلالاً لها","وتَرى الوصلَ عليها حرامْ",58,"م",1,0],["تحسب المبصرين أَعينُها النج","لُ سكارى وَما هُمُ بسكارى",59,"ر",2,0],["تحسب الفرقدين صنوين داما","لإخاء وَما هما لإخاء",60,"ا",2,0],["تحْسِبُها مِن رُضابِ غادِيَةٍ","مجْموعَةً أو دُمُوعِها السُّجُم",61,"م",1,0],["تَحْسَبُ الهَضْبَةَ منه جَبَلاً","وحُدُورَ الماءِ منه أَبْردَا",62,"د",2,0],["تَحَسَّى مَرَارَاتِ الْكُبُودِ فَلَمْ تَزَلْ","بِهِ صِبْغَةٌ مِنْ لَوْنِهَا فَهْوَ أَزْرَقُ",63,"ق",1,0],["تُحْسِنِينَ اللُّغَاتِ شَتَّى كِثَاراً","مَعَ لُطْفِ البَيَانِ وَالتَّبْيِينِ",64,"ن",1,0],["تحسك بالشادي إذا رق شجوه","وبالجدول الباكي على الحصبات",65,"ت",1,0],["تَحْسِبُ الطفلَ فِيه في كَفَنِ الموْ","تَى وقَدْ ضمَّه الرِّدَاء البالي",66,"ل",2,0],["تُحس أزيزَ النار في نبراتِها","وتلمحُ فيها قوّةَ العَزْمِ والجزْمِ",67,"م",1,0],["تحس كل حادث بسيفه","فان نبا حينا فأحيانا مضى",68,"ا",1,0],["تحسّ جلدك ثلجا","مطيّنا وهو كاوي",69,"ا",3,0],["تحسّهم في يد المستعمرين كما","تحسّ مسبحة في كفّ سحّار",70,"ر",1,0],["تُحِسُّ الطبيعةَ في طيَّةِ","تَكشَّفُ عن حُسنها المستتر",71,"ر",1,0],["تحسبون الورى عقاربَ خضراً","وتَرَوْن الدُّروب ملأى ضِباعا",72,"ع",2,0],["تحسب 