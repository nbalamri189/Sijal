3,"","https://poetry.dctabudhabi.ae/diwan/poem/128231","الرمل"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113864","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100736","الطويل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112298","الرمل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66349","الرمل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34690","المقتضب"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123508","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28671","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72478","السريع"],[4684,"الطائر المهاجر","https://www.poetsgate.com/ViewPoem.aspx?id=201382",""],[4755,"مُتْ قَلِيلًا أَيُّها القَلَقُ","https://www.poetsgate.com/ViewPoem.aspx?id=183575",""],[4755,"نَمْ قَلِيلًا أيُّهَا الأَرَقُ","https://www.poetsgate.com/ViewPoem.aspx?id=191246",""],[4774,"تايه ( رباعيات )","https://www.poetsgate.com/ViewPoem.aspx?id=180390",""],[5064,"مدُنُ القلب الضّائع","https://www.poetsgate.com/ViewPoem.aspx?id=199173",""],[5324,"فأنا المصلوب من غير صليب.","https://www.poetsgate.com/ViewPoem.aspx?id=211384",""],[5353,"كن سوى ان تكون نفسك سجنا","https://www.poetsgate.com/ViewPoem.aspx?id=214881",""],[5431,"ليتني دوما معه!","https://www.poetsgate.com/ViewPoem.aspx?id=195413",""],[5431,"سنة الله نصره والتلاقي","https://www.poetsgate.com/ViewPoem.aspx?id=198541",""],[5431,"أنطقُ الضاد خائفا من زماني ...","https://www.poetsgate.com/ViewPoem.aspx?id=199742",""],[5455,"صالات المطار","https://www.poetsgate.com/ViewPoem.aspx?id=34424",""],[5463,"نامي وزيدي المنام","https://www.poetsgate.com/ViewPoem.aspx?id=25790",""],[5561,"الحوار الخامس","https://www.poetsgate.com/ViewPoem.aspx?id=200442",""],[5587,"اليوم عيد الحب","https://www.poetsgate.com/ViewPoem.aspx?id=197788",""],[5587,"خدعوني لمعاني","https://www.poetsgate.com/ViewPoem.aspx?id=197794",""],[5763,"ِ شجيٌّ وخليٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=27066",""],[5957,"إنتظار","https://www.poetsgate.com/ViewPoem.aspx?id=26226",""],[5968,"سميت بالله من ياني الخبر جدام","https://www.poetsgate.com/ViewPoem.aspx?id=175413",""],[6125,"قَابَ قَوسَينِ","https://www.poetsgate.com/ViewPoem.aspx?id=210207",""],[6360,"صَهيلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87606&r=&rc=9",""]],"verses":[["تأيّدوا ألقدرا","وتسعدوا الأقدار",0,"ر",1,0],["تائه أقنع الهلال افتخاراً","أنه قد غدى مثال لثامه",1,"م",2,0],["تأيَّت صميم المتن حتى إذا انتهى","رضاها أمرَّته مرائرَ أربعا",2,"ع",2,0],["تائِهٌ ما أَصلَفَه","وَيحَ صَبٍّ أَلِفَه",3,"ف",2,1],["تَأَيّا قُوَيقُ لِتَدويرِها","فَنَكَّبَ عَن قَصدِها وَاِنعَرَج",4,"ج",1,0],["تَأَيّا مَعَ الإِمساءِ تَتبَعُ ضَوأَهُ","وَتَسبِقُهُ فَوتَ الصَباحِ فَيَتبَعُ",5,"ع",1,0],["تَأَيَّت قَليلاً ثُمَّ جاءَت بِمَذقَةٍ","مِنَ الظِلِّ في رَثِّ الأَباءِ ضَئيلِ",6,"ل",1,0],["تاييسُ لم تعبَثْ براهبها","لكنَّهُ أشفى على البُرَحِ",7,"ح",1,0],["تائهاً في بحاره لستُ أدري","لِمَ أُزجِي الشراعَ أو فِيمَ أُرسي",8,"س",2,0],["تَأَيَّيتُ مِنهُنَّ المصيرَ فَلم أَزَل","أُيَسِّرُ طِرفاً ساهِمَ الوَجهِ فارِعا",9,"ع",2,1],["تَأيّا مَعَ الإمْسَاءِ، تَتْبَعُ ضَوْءَهُ،","وَتَسْبُقُهُ، فَوْتَ الصّبَاحِ، فيَتبَعُ",10,"ع",1,0],["تائي الرجاء فلا أسير موثق","أرجو الفكاك ، ولست حرا مطلقا",11,"ق",2,0],["تائبٌ من كل بيع فاسدِ","تائبٌ من كل وزن زائدِ",12,"د",1,0],["تائبٌ من كل ذنبٍ عائدِ","تائبٌ من كلِّ فعلٍ عامِد",12,"د",1,0],["تائِهٌ يَزْدادُ تِيهاً","عِنْدَ ذُلِّي في سُؤَالِي",13,"ل",2,0],["تائه يبحث في جنحك","عن كنزٍ أضاعه",14,"ه",1,0],["تأيّم لا تساكنه عروس","فما يسمو إليه أيّ صهر",15,"ر",1,0],["تائهٌ، باكٍ، حزينٌ","أعطني من فيك قولا",16,"ل",2,0],["تائه الغايات مغلو","لا يرى كالمُطلق",17,"ق",1,0],["تَأَيَّى نَوَاصي الخَيْلِ مَعْقُودَةً بِهَا","عُهُودُ مَوَالِيها وحِلْفُ حَلِيفِها",18,"ف",3,0],["تأيَّدَ رَسمُها وَجَرى عَلَيها","سَفيُّ الريحِ وَالتُربُ الغَريبُ",19,"ب",1,0],["تَائِهٌ جَارَ عَلَى الْجَا","رِ فَمَا يَرْثي لِجَارِهْ",20,"ر",2,0],["تَأيَّدَ أمْرُ حَاجِبِهَا","بِمَاضِي الفِعْلِ فِي الحَالِ",21,"ل",1,0],["تائهاً بائساً ودهر الشقا يد","عوهُ في التيه أن يكون سميره",22,"ر",2,0],["تائبا عن جميع ماكان منى","مستقيلا حاشا أقابل بالرد",23,"د",1,0],["تائبا توبة اعتراف نصوحا","لا تقل تائب وانت مصر",24,"ر",1,0],["تايبٍ لله الفرد الصمد","وخايفٍ يا زين من يوم الوعود",25,"د",1,0],["تايه في الغي قد ضل الطريق","قط من سكر الهوى لا يستفيق",26,"ق",1,0],["تأييد الحسن فيه حيث لا برحت","تنهى وتأمر في عشاقها الغيد",27,"د",1,0],["تأيّ سليل الملك فاللَه شاهدٌ","بأنك للجيش اللهام كفيل",28,"ل",1,0],["تائِهاً في الليلِ ما بينَ الصّخور","عندَ شاطي البَحرِ في ضَوءِ القمر",29,"ر",1,0],["تايه في الحب عن نهج الطريق","بل سقيم الجسم ذو ودّ صحيح",30,"ح",1,0],["تائهٌ تزهده","في رغبتي فيهِ",31,"ي",2,0],["تأيدّ بالشرع المؤبد عرشه","فأثبت دين الحق والكفر أدحضا",32,"ض",2,0],["تَأَيَّدَ وَاِدَّعى القُربا","وَأَثرى وَاِستَفادَ أَبا",33,"ب",2,1],["تأييد سلطان ملوك الورى","ومن سما مجدا عليهم وفاق",34,"ق",1,0],["تائهاً ضلّ سبيلاً في مسارٍ","أو مصاباً إثر مقلاع ٍونقفةْ",35,"ف",2,0],["تائِهٌ مُذ قُلتُ: يا وطني","حَارَبَتنِي الناسُ والطُّرُقُ",36,"ق",1,0],["تائِهٌ مُذ قُلتُ: بي سَفَرٌ","حَارَبَتنِي الدُّورُ والطُّرُقُ",37,"ق",1,0],["تايه وفى الميادين بسأل على أمى","فينك يا مهد الخير تطبطبى تضمى",38,"ا",1,1],["تائِهٌ كالصَّمْتِ لَمْ يلْقَ لَهُ","مِنْ يَدٍ تطرُقُ أبوابَ المسامِعْ",39,"ع",1,0],["تائه يجترّ ماضيه ليحيا","والغد المقبل في عينيه مات",40,"ت",1,0],["تائها دربك الجنون ولكن","تانف الارض والسما ان تجنا",41,"ن",2,0],["تائه في نشوتي","بالجهات الأربعه",42,"ع",2,0],["تائهٌ أنت عن جميع السواقي","تشتهي الغيث والردى لك ساقِ",43,"ق",1,1],["تائهٌ خانني انكسارُ المرايا","فاقد الوزن مثقلٌ بالمنايا",44,"ا",3,1],["تايهة .. ما كنك الا ضحكةٍ وسط انكسار","ساكته .. ماكنك الا دمعةٍ فيها حنين",45,"ن",1,0],["تايه بدهليز قلبك بين سهرات وهيام","مادرا هل حبّه شرّ(ن) ولا صار الحب خير",46,"ر",1,0],["تائهٌ منذُ سنينٍ في ظِلالِهْ","ظَمَأٌ يشربُ مِن بحرِ ضَلالِهْ",47,"ل",2,1],["تَايْهَة فِيكْ بْكُلْ مْحَبَّة عْلِيكْ نْمُوتْ","وْمَا نَعْرَفشْ نْخَبِّي يَا نُورْعِينِي",48,"ن",2,1],["تَايْهَ فِي بَحرْ الخُوفْ","يَا ﭬَلْبِي وَاشْ بْلَانِي",49,"ن",2,0],["تائهٌ في جوف تيهٍ","لم تساعفْهُ المجادفْ",50,"ف",1,0],["تائه قلبي وروحي طفئتْ","فالهوى والحب في صدري خمدْ",51,"د",1,0],["تايب يربي في ليلةٍ وسط الصيام","في ليلة فيها الملايكة انزلت",52,"ت",1,0],["تايب ياربي من حريشا لِلحزام","وتمّ نذري عنّه الخيل اوقفتْ",52,"ت",1,0],["تايب يربي من راسي ايلين البهام","هي توبةٍ داخل ضميري ارتمت",52,"ت",1,0],["تَائِهٌ أَجرَعُ اللَيَالِي وَحِيدًا","كَيفَ تَستَحيِلُ اللَيَالِي نَهَارا",53,"ر",2,0],["تَائِه ٌ، أسْكُبُ حِبْرِي فِي يَبَابْ","لَاهِثٌ خَيْلِي ، وَمَا لِلرِّيحِ بَابْ",54,"ب",1,1]]}