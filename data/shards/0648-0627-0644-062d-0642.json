adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86082&r=&rc=2",""]],"verses":[["والحقُّ أنتَ وكُلُّ ما نُثْني بهِ","إلا عَليكَ منَ المَدائِحِ باطِلُ",0,"ل",1,0],["والحقُّ في أوْصافِها أنّها","خَرْقاءُ حُسْنٍ وجدَتْ صُوفا",1,"ف",2,0],["وَالْحَقُّ لَيْسَ لِمُنْصِفٍ مِنْ مَدْفَعٍ","فِيهِ فَإِنَّ الْحَقَّ أَعْظَمُ شَانَا",2,"ن",2,0],["وَالْحَقّ حَقٌّ مَا سِوَاهُ فَبَاطِلٌ","لَوْ حَقَّقَ الْمُسْتَبْصِرُ الْمُتَأَمِّلُ",3,"ل",1,0],["والْحَقّ يُغْنِي عَنْ شَهَادَةِ شاَهِدٍ","أَنَّى يُرَامُ عَلَى الصَّبَاحِ دَلِيلُ",4,"ل",1,0],["والحق لا يُجتَنى إلا بذي شُطَب","ماء المنيّة في غربَيْه منسجم",5,"م",1,0],["والحق والشُّبَهُ التي بإزائه","كالشمس جاوَرها هلالُ سِرارِ",6,"ر",1,0],["والحق منصورة حلائبه","تكثر أعوانُه ويُتَّبع",7,"ع",1,0],["والحقُّ يأمرُ أن يقال وحقُّه","أنْ لا يخالفَ أمره القُوّالُ",8,"ل",1,0],["وَالحَقل وَالفَلّاحَ فيهِ سائِراً","عِندَ المَسا يَرعى القَطيعَ السائِرا",9,"ر",2,0],["وَأَلحَقتُ أولاهُ بِأُخراهُ موفِياً","عَلى قُنَّةٍ أُقعي مِراراً وَأَمثِلُ",10,"ل",1,0],["والحقُّ مَقطوعُ اللّسان مُكَبَّلٌ","والظَّلمُ يمرح مُذْهَبَ الجِلبابِ",11,"ب",1,0],["والحق بان مضيئا لا خفاء به","والغي كان عجاجا زال وانقشعا",12,"ع",2,0],["والحق يُنصر حين ليس بنافع","بأس الجيوش ودُربة القوّاد",13,"د",1,0],["والحق والوسيلة","والسمحة الظليلة",14,"ه",1,0],["وَالحَقُّ أَرفَعُ مِلَّةً وَقَضِيَّةً","مِن أَن يَكونَ رَسولُهُ الإِضرارُ",15,"ر",1,0],["وَالحَقُّ في الخُرطومِ أَيضاً حَقّي","وَالدَرسُ لِلخادِمِ كَيفَ يَسقي",16,"ي",1,0],["وَالحَقُّ لَيسَ وَإِن عَلا بِمُؤَيَّدٍ","حَتّى يُحَوِّطَ جانِبَيهِ حُسامُ",17,"م",1,0],["وَأَلحَقنَ بِالصَفصافِ سابورَ فَاِنهَوى","وَذاقَ الرَدى أَهلاهُما وَالجَلامِدُ",18,"د",1,0],["والحِقْدُ كالنارِ في الزندين إنْ تُرِكا","تكمُن وإن أغرِيا بالقَدْحِ تستَعِرِ",19,"ر",1,0],["والحقْ بسِربِكَ تسلَمْ","من وحدةٍ واغترابِ",20,"ب",1,0],["وَأَلحَقَني بِالشَيبِ في عَقرِ دارِهِ","مَناقِلُ في عَرضِ الشَبابِ أَسيرُها",21,"ر",3,0],["وَالحَقُّ أَبلَجُ لا خَفاءَ بِهِ","مُذ كانَ يُبصِرُ نورَهُ الأَعمى",22,"ا",1,0],["وَالحَقُّ أَفضَلُ ما قَصَدتَ سَبيلَهُ","وَاللَهُ أَكرَمُ مِن تَزورُ وَتَنتَجِع",23,"ع",1,0],["وَالحَقُّ في المَجرى أَغَرُّ مُحَجَّلٌ","تَلقاكَ غُرَّتُهُ بِنورٍ ساطِعِ",24,"ع",1,0],["وَالحَقُّ مُتَّصِلٌ وَمُتَّصِلٌ بِهِ","فَإِذا سَمِعتَ بِمَيِّتٍ فَقَدِ اِنقَطَع",25,"ع",1,0],["وألحقها بالسرب جيدٌ ومقلةٌ","وإن لم يناسبْ دُرُّ مبسمها السربا",26,"ب",2,0],["وَالحِقدُ كَالنّارِ إِن أَخفَيتَهُ ظَهَرَت","مِنهُ عَلائِمُ فَوقَ الوَجهِ كَالحُمَمِ",27,"م",1,0],["والحقُّ ما عَرفَ الدُّعاةُ سبيلَهُ","حتّى أقمتَ بناءه المهدوما",28,"م",2,0],["والحقُّ إن جَرَحَ الغُواةُ جَلالَهُ","عَطفتْ عليه أئمَّةٌ ووُلاةُ",29,"ه",1,0],["والحقُّ ليس بناجٍ في جلالتِه","إلا إذا لاَذَ بالبيضِ المآثيرِ",30,"ر",1,0],["وَالحَقُّ إِن تَرَكَ المَليءُ قَضاءَهُ","ضاقَت عَلَيهِ مَنادِحُ الأَعذارِ",31,"ر",1,0],["وَالحَقُّ لَولا الأُنوفُ الشُمُّ تَرفَعُهُ","عَلاهُ كُلُّ وَضيعِ النَفسِ مَرذولِ",32,"ل",1,0],["وَالحَقُّ ما شَرَعَ الهُداةُ فَما عَسى","يَتَطَلَّبُ الغاوي وَيَبغي المُبطِلُ",33,"ل",1,0],["والحَقُّ أَبْلَجُ في شريعَتِهِ الّتي","جَمَعَتْ فروعاً لِلْوَرَى وأُصُولا",34,"ل",2,0],["وَالحَقُّ أَنّي وَأَنَّهُم هَدرٌ","لَستُ نَجيباً وَلا هُمُ نُجُبُ",35,"ب",1,0],["وَالحَقُّ كَالشَمسِ وارَتها حَنادِسُها","فَما لَها في عُيونِ الناسِ إِشراقُ",36,"ق",1,0],["وَالحَقُّ يُثقِلُ كُلَّ غاوٍ ظالِمٍ","وَأَخو الدِيانَةِ ما يُحِسُّ بِثِقلِهِ",37,"ل",2,0],["وَالحَقُّ أَن تُطلَبَ ما بَينَنا","جِنايَةُ الجُرمِ مِنَ الجارِمِ",38,"م",1,0],["والْحَقْ بتُبّاعِ الأميرِ فكُنْ له","تَبَعاً لتُصْبِحَ بالمحَلّ الأعظَمِ",39,"م",1,0],["وَالحَقُّ وَالإيمانُ إِن صُبّا عَلى","بُردٍ فَفيهِ كَتيبَةٌ خَرساءُ",40,"ا",2,0],["وَالحَقُّ لاَ يَعْلُو بِغَيْرِ خُصُومَةٍ","مَسْمُوعَةِ الإِتْهَامِ وَالإِسْنَادِ",41,"د",1,0],["والحقّ للحقّ شقَّ","اليراعُ عنهُ الحجابا",42,"ب",2,0],["والحقد فاطَّرِحوه، ما","للحِقْد إلا الأطِّراح",43,"ح",1,0],["والحق يعلو والموفق غالب","والبطل يرهق والملفق فاسد",44,"د",1,0],["وألحق أمير المسلمين برحمة","تبوئه دار المقامة والأجر",45,"ر",1,0],["والحقّ يثني الجبش وهو عرمرم","ويفلّ حدّ السيف وهو مهنّد",46,"د",1,0],["والحقُّ والسيفُ من طَبعٍ ومن نَسَبٍ","كلاهُما يتلقَّى الخَطبَ عُريانا",47,"ن",2,0],["والحق تبلغه ببأس حماتها","لا باستكانتها ولا استرحامها",48,"م",3,0],["والحق مطموس الشرافة فوقه","من لوث اقدام اللئام رمال",49,"ل",1,0],["والحق اعيان الفواطم ثائرا","اجرب فكري كيف يجري نجيبه",50,"ب",2,0],["والحق لا بد من إشراق طلعته","مهما استطالت على أهليه ظلماء",51,"ا",2,0],["والحق أضيع من يتيم","أم مأدبة اللئام",52,"م",1,0],["والحَقُّ لَمَّا جَاءَ مِن زَاخِرٍ","بالدُّرِّ عَن أرجَائِهِ قَاذِفِ",53,"ف",1,0],["والحقُّ أبلجُ والمعانِدُ عينُهُ","عمياءُ عَنهُ وأذنُهُ صَمَّاءُ",54,"ا",2,0],["والحق بادٍ للأنام وإنما","يحتاج صاحبه لأن يتفكرا",55,"ر",2,0],["وَأَلحَقَكَ اللَهُ الكَريمُ بِعُصبَةٍ","فَتَحتَ إِلى ضَربِ الرِقابِ لَهُم بابا",56,"ب",2,0],["وألحقوا بهم حفظا لعهدهم","أبناء مطلب في حرمة النسب",57,"ب",1,0],["والحق لا يقوله إلاَّ امرئ","فقا لَه عين الهوى فقالهُ",58,"ل",2,0],["والحقُّ إِن الحكم ذلك والقضا","كانا بسعدك فيهم فليعذروا",59,"ر",3,0],["والحق ان تقضى لها عن كل يو","م سنة وبكل شهر أشهر",60,"ر",1,0],["والحق فاعلمه ما قال النبي فلا","تخدع بزخرف أقوال وتمويه",61,"ي",2,0],["وَالحَقُّ أَصبَحَ عِندَ مَن","أَلِفَ الخَلاعةَ وَالخَلابِسْ",62,"س",1,0],["وَالحَقُّ وَالبُطل في ميزانِهم شرعٌ","فَلا يَميلُ سِوى ما ميَّل الذَّهَبُ",63,"ب",1,0],["والحقُّ أبلجُ والضرورة شاهدٌ","بقضيةٍ تقِضى العقولُ بعَدْلِها",64,"ل",3,0],["والحقُّ إن لانَ ولكنهُ","يودي بذاكَ الباطلِ الباسلِ",65,"ل",1,0],["وألحقوا من ذا باب فعلل","ستا كسلقى والذي كشملل",66,"ل",1,0],["وَالْحَقُّ مَفْلولُ الشَّبَا","وَالبَغْيُ صَارِمُهُ مُهَنَّدْ",67,"د",1,0],["وَأَلْحِقَنْهُ سَيِّدِي بِالصَّالِحِينْ","إِنِّي سَأَلْتُكَ بِأَزْكَى الْمُرْسَلِينْ",68,"ن",1,0],["والحقُّ يَصرَخُ قائلاً في ضِعفهِ","أهلُ البلادِ العربُ لا الأعجام",69,"م",1,0],["والحق يحكم الاعضاء شاهدة","وَالنار تؤصد للطاغين في عمد",70,"د",1,0],["وَالحَقُّ سُبحانه في عز عِزته","من قاب قَوسين أَو أَدنى يكلمه",71,"م",2,0],["وَالحَق متضح السَبيل بأَحمَد","وَلِمَذهَب الاسلام أَشرف مذهب",72,"ب",1,0],["والحق والصدق واحفظنا من الغير","واسأل من اللَه كشف البؤس والضرر",73,"ر",1,0],["وَالحقّ نهجاً وَالشريعةَ هادياً","وَالحزمَ عضباً وَالحجى خطّارا",74,"ر",2,0],["والحق عندك في الأمور مقدم","أبداً فماذا يدعيه المبطل",75,"ل",1,0],["وَالحَقُّ أَنّي وَعَيبي لَستُ أُنكُرُهُ","لَو كُنتُ أَعلَمُ أَنّي ما أوقِرُهُ",76,"ه",1,0],["وَالحَقُّ يَظهَرُ مِن مَعنى وَمِن كَلَمِ","وَالكافِرونَ تَغشاهُم هُناكَ ظُلمُ",76,"م",1,0],["والحق ان كليهما في فوزه","وهوانه عبث هو الانسان",77,"ن",1,0],["وَالحَقُّ فيما بَينَ ذاكَ وَذا","إِن كانَ عِندَكَ حَقُّنا يَجِبُ",78,"ب",1,0],["والحَق فلم يبقَ للنوائب بع","دَ القَرح إلا نكايةُ القَرحِ",79,"ح",1,0],["والحق منبجس الجوانب مُقمرٌ","والأرض يَطوي طيَّها الرضوان",80,"ن",1,0],["والْحَق بحزب بنيه المؤمنين به","والحقُّ تخدمه الأشباه والصور",81,"ر",1,0],["والحقَّ أنَّ الشرعَ عنه نَاهى","لكونِه من جُملةِ الملاهِي",82,"ي",1,0],["وَالحِقد لِلصَدر المُنا","سب لِلمَعالي لا يُناسب",83,"ب",1,0],["وَالحَقُ يَعلو عَلى الأَخصام قاطِبة","وَالعلم مُحتَرم وَالمال مُحتَقِرُ",84,"ر",1,0],["والحق يبقى ظاهراً متألق","في الناس لمّا يصدق الشهداء",85,"ا",2,0],["وألحقنا الأوائل بالتوالي","وأبرق حد صارمنا الخضيب",86,"ب",1,0],["وَأَلحَقت مِنَ أَلفَيتَ مِنهُم نَزاهَة","كَتائِب رَوعٍ أَلحَقَتهُم بِمَن نَجا",87,"ج",2,0],["وَأَلْحَقَهُمْ بِلُجِّ البَحْرِ سَيْلٌ","يَمُدُّ مُدَودَهُ فَيْضُ الدِّماءِ",88,"ا",2,0],["والحقُّ لم أطلب بمدحك شكرَهم","فيسوءني أن يجعلوه مِرائيا",89,"ي",2,0],["والحق حق ولكن في تعدده","أضر بالناس فاستجلوه نتفق",90,"ق",1,0],["والحَقَّ يَمْضِي وكَفَّ الدّينِ باسِطَةً","لا يُستَطاعُ لَهُ دَفْعٌ عَلَى حالِ",91,"ل",1,0],["والْحَقُّ أَبْلَحُ والدَّليلُ مُحْكَّمٌ","والْكُلُّ مِنْ نَهْرِ النُّبُوَّةِ كارِعُ",92,"ع",1,0],["والحَقُّ لا يَخْفَى عَلَى عالِمٍ","يَمْرَحُ في مِضْمارِ عِلْمٍ فَسيحْ",93,"ح",1,0],["والحَقُّ يَعْلو ويَعْلُو مَنْ يُناصِرُهُ","ويُخْفِضُ اللهُ أَرْبابَ الضّلالاَتِ",94,"ت",1,0],["والحق أصل وبعلمه بدا","وسائر الخلق له الأفياء",95,"ا",2,0],["والحق قيوم لمن هو باطل","وهو السوى بالوهم قام فأفتنا",96,"ن",2,0],["والحق بي هو عالم","وبنفسه فهو العليم",97,"م",1,0],["والحق ليس عبارةً","منّا له وهو النديم",97,"م",1,0],["والحق يوفي وغيرُهْ بالوفا ماطلْ","والغير ماحِلْ وربي غيثه هاطلْ",98,"ل",1,0],["والحق حق واحدٌ","وبه غبار الكون ساطل",99,"ل",1,0],["والحق عنها قد تنزه قبلها","وهو المنزه بعدها عنها العلي",100,"ل",2,0],["والحق واجهنا في كل ما علمت","حواسنا ثم لم نحتج لإجهاز",101,"ز",1,0],["والحق حاجبهم عنه بأنفسهم","مقيدين بألقاب وأنباز",101,"ز",1,0],["والحق في عين الجميع محقق","والنفس لاهية بذلك ساخره",102,"ر",2,0],["والحق حق قديم في مراتبه","عين المراتب والفاني هو الأثر",103,"ر",1,0],["والحق صوَّرها حتى تصورها","فيه فصارت بهذا الأمر موجوده",104,"د",2,0],["والحق ليس لنا إليه إشارة","نحن الإشارة منه والإيماء",105,"ا",2,0],["والحق في محمله ثقيل","وأهله إن ذكروا قليل",106,"ل",1,0],["والحق فيه قوة وشدّة","وباطل القول قصير المدّة",106,"ه",1,0],["والحقُّ ما أَقولُ ما","أَقولُ قَطُّ الكذِبَا",107,"ب",2,0],["والحقُّ أَنك نازلٌ","في منزلٍ سُكْنَاه هُونُ",108,"ن",1,0],["والحقُّ أَنِّي قد حَسَم","تُ صبابَتي عن ظَبى حَسْمَى",109,"م",2,0],["والحقُ من لدن الاله منائر","للمستضئ شعاعها جوال",110,"ل",1,0],["والحق ما في العيش غير كوارث","فكم الزمان صفا ملوك كدرا",111,"ر",2,0],["والحق أبهى جمال للفتى أدب","يبدو بحلته الحسناء مزدانا",112,"ن",2,0],["والحق ليس كأمنا مصر وقد","فقدتك يا خير البنين ثكول",113,"ل",1,0],["والحق تلك حلائل لم تحكها","ببهائهن جلائل السلفاء",114,"ا",2,0],["والحق افعال الاماجد قدوة","للعالمين إلى المراشد هاديه",115,"ي",2,0],["والحق وادى النيل شاد ملوكه","ما اعجز الانسان قبل الجان",116,"ن",1,0],["والحق ذاك تواضع يسمو به","شرفا على شرف نظيرك قائل",117,"ل",1,0],["والحق ان صفاته وفعاله","هي في الجمال لنا اغرّ وأنصع",118,"ع",1,0],["والحق تختلف الكؤوس فبعضها","قد يبتغي منها المزيد الحاسي",119,"س",2,0],["والحق أصبحت البلاد بحالة","قلب الكريم لها يذوب وينفطر",120,"ر",1,0],["والحق تلك فعالك البيضاء في","جيد العلا كالعقد لؤلؤه رطب",121,"ب",1,0],["والحق يعطى لذى حق ولا عجب","فقد اقام عليه جد يقظان",122,"ن",1,0],["والحق يانورنا قد كنت نابغة","مع الحداثة في علم وإنشاء",123,"ا",2,0],["وَالحَق جاءَ مؤيداً لِسياسةٍ","مِنها هَوى في الهاوِيات الباطل",124,"ل",1,0],["وَالحَق حصحص وَالمحق","قُ حظِي بحظ أَوفر",125,"ر",1,0],["والحقُّ عندهمُ أنوارُه خفِيَتْ","وعندهُمُ لِظَلامِ الظُّلْم إبْداءُ",126,"د",3,0],["والحقُّ يَشهدُ أنَّ عَقْدَ نِظامِها","ومِلاكِها كانَ الغَمامَ الصَّيِّبا",127,"ب",2,0],["والحق للعقبى فمن بلغ المدى","فهو الأحق بواجب الإطراء",128,"ا",2,0],["والحق في كل عصر فاقد سنداً","إن لم يجد طلباً بالبأس مقرونا",129,"ن",2,0],["والحق إن لجَّ الدعاة به استوى","في نفعه متشيِّعٌ ومقاوم",130,"م",1,0],["وَالحَقُّ كَالخَيرِ لَسنا فيهِ نَقبلهُ","وَالشرّ كالظّلمِ فيهِ غير مَردودِ",131,"د",1,0],["وَالحقّ يَحكُمُ في أَن لا نَظيرَ لَهُ","وَلَيسَ قَولُ المُضاهي غَير مُمتَحِقِ",132,"ق",1,0],["وَالحقد لا يَخفاك عَينُ الداء","وَلَم يَكُن يَعثر بِالدَواء",133,"ا",2,0],["والحق أن لكل شيء موقعا","كتعاقب الأنوار والأحلاك",134,"ك",1,0],["والحقُّ أوضحُ من شمسٍ ومِنْ قمرٍ","والعدلُ سيفُ ابن سلطانَ الذي سادا",135,"د",2,0],["والحقُّ غالبة أنصارُهُ أبداً","وإن تأخر في التقدير ميقاتُ",136,"ت",1,0],["والحق مملكة والجور مرزأة","والكذب مهلكة والصدق منجاةُ",136,"ه",1,0],["والحق أبلج والآثام مظلمة","وليس يبقى مع الصبح الدّجناتُ",136,"ت",1,0],["والحق قد ملأ النواحي نورُه","يهدي هداهُ لخابط الظلماءِ",137,"ا",2,0],["والحق أبلج والموفَّق","لا يضل ولا يهيمْ",138,"م",1,0],["والحق أبقى ومن ذا","بحبله أهل مَسْكِ",139,"ك",1,0],["والحق ان غصون مال لم يكن","لله تثمر حسرة ووبالا",140,"ل",2,0],["وألحقت صالحا بالصالحين وكم","أهدت لهود حروفا هن آيات",141,"ت",1,0],["وَالحقدُ تُخفيه القلوب كمثل ما","يُخفي الرمادُ الجمرَ تحت كمينهِ",142,"ن",2,0],["وألحَقني عنده نعمةً","وقلّدني منه مَنّاً وفضلا",143,"ل",2,0],["وَألحَقني ناراً بنارٍ قديمة","فَما برحا في القلبِ يتّقدانِ",144,"ن",1,0],["والحق يبدو للنواظر طالعاً","كالشمس بين جلاده وجداله",145,"ل",2,0],["وَالحَقُّ يَلزَمُ في الكَثيرِ","وَلَيسَ يَسقُطُ في اليَسيرِ",146,"ر",1,0],["والحقد تعتور التراب سمومه","فيجفّ عرق الخصب فيه ويجمد",147,"د",1,0],["والحق قام ولم يُعد للبطل من","عزمٍ وأخذل من تظلّم أو جرمْ",148,"م",1,0],["والحق عاد إلى الشبيبة بعدما","قدا كان هرماً ماشياً بعصاءِ",149,"ا",2,0],["والحق اظهره البيان لأهله","فيما سعوا في شأنه بشواهده",150,"د",2,0],["والحقنا بقوم محسنينا","وجدوا نحونا فالخطب جدا",151,"د",2,0],["والحق بالكرام على رضاء","وحب وافر في القلب خيم",152,"م",1,0],["وَالحَق نَجى بَيت باز الأَولياء","كَرَماً وَأَبدَل خَوفَهُم بِأَمان",153,"ن",1,0],["والحَقّ عِنْد الرَّب تَدْبير","وشِمْنا وسِرْنا وِسْط لَنْشات",154,"ت",1,0],["والحقُّ سيفُكَ إن نشدتَ","لساكني لبنانَ رَغدا",155,"د",2,0],["والحقُّ للقوَّةِ لا","يعطاهُ الاَّ مَن ظفر",156,"ر",1,0],["وَأَلحَقَت أُختَها طسماً وَعاد عَلى","عادٍ وَجُرهُم مِنها ناقِض المِرَرِ",157,"ر",1,0],["وَألحقَت بِعَدِيٍّ بِالعِراقِ عَلى","يَدِ اِبنِهِ أَحمَرَ العَينَينِ وَالشعرِ",157,"ر",1,0],["والحق بين حديثه وكلاهما","ما بين نور الشمس والظلماء",158,"ا",2,0],["وألحق ساقطاً ونفا سواه","فألحقه بقوم أبعدينا",159,"ن",2,0],["والحق بين القنا والبيض مختدِرٌ","أو مُضمَر في بطون الغيب مستتر",160,"ر",1,0],["والحق أيد لأهليه وإن عَجَزوا","والمبطلون على وَهن وإن قَدَروا",160,"ر",3,0],["وألحقتهم أبا يَعلَى عَزيمَتُهُ","وهمَّةٌ طلعَت والنَّجم في قَرَنِ",161,"ن",1,0],["والحق به قاوونة وارجع إلى","الجبسي النبيل مغسل الأجواف",162,"ف",1,0],["والحق بادٍ تُتلى حقائِقُه","بكلّ ناد كأنَّها سُوَرُ",163,"ر",1,0],["والحقل والزبن ما لم يأن تحسبه","تمراً وحمراً أبسراً كان أو عنبا",164,"ب",2,0],["والحقن في قبل المرأةِ لعلةٍ","حل وتكرهُ حقنةُ الدبرِ",165,"ر",1,0],["وَالحَق بِمَن كاسَ واحتُث كاسَ كُلِّ سُرى","فالدَّهرُ إِن جارَ راعى جارَ بَيتِهِمِ",166,"م",1,0],["والحقُّ سيفٌ بذا التاريخِ أهلكَهمْ","والسيفُ أصدقُ أنباءً من الكتبِ",167,"ب",1,0],["والحقُّ أصبحَ صائلاً متبختراً","بينَ الأنامِ وما عليهِ عناءُ",168,"ا",2,0],["وألحق بهم أهل السوابق والنهى","صحابته فامحض لكلهم الودا",169,"د",2,0],["والحقُّ حقٌ والتناقضُ حاصلٌ","في نفسه وهو السبيل الأقوم",170,"م",1,0],["والحق بي قد أشار نحوي","فقلتُ ماذا فقال لطف",171,"ف",1,0],["والحق ليس له مثلٌ فكيف يرى","هذا الذي جاء في سمعي من التالي",172,"ل",2,0],["وألحقَ أرواحَ العُلى بنفوسِها","وأعطاك من نور السَّناء ضياء",173,"ا",2,0],["والحق بعزم منك جزماً ولا تزل","مصراً عليه فهو للحزم أقرب",174,"ب",1,0],["والحَقُّ مَنصُورٌ ومُمتَحَنٌ فَلاَ","تَعجَب فَهَذِي سُنَّةُ الرَّحمَنِ",175,"ن",1,0],["والحَقُّ عِندَهُم فَفِيمَا قَالَهُ","أتبَاعُ صَاحِبِ مَنطِقِ اليُونَانِ",175,"ن",1,0],["والحقُّ أنَ العرشَ قبلُ لأنَّه","قَبلَ الكِتَابَةِ كَانَ ذَا أركَانِ",175,"ن",1,0],["وَالحَقُ أنَّ كلَيهمَا فِي الذهنِ مَف","رُوض فَلاَ تَحكُم عَلَيهِ وَهُوَ فِي الأذهَانِ",175,"ن",1,0],["وَالحَقُّ رُكنٌ لاَ يَقُومُ لِهَدِّهِ","أحَدٌ وَلَو جُمِعَت لَهُ الثَّقَلاَنِ",175,"ن",1,0],["وَالحَقُّ فِيهِ لَيسَ تَحمِلُهُ عُقُو","لُ بَنِي الزَّمَانِ لِغِلظَةِ الأذهَانِ",175,"ن",1,0],["وَالحَقُّ أنَّ الجِسمَ لَيسَ مُرَكَّباً","مِن وَلاَ هَذَا هُما عَدَمَانِ",175,"ن",1,0],["وَالحَقُّ لاَزِمُهُ فَحَقٌّ مِثلُهُ","أنَّى يَكُونُ الشَّيءُ ذَا بُطلاَنِ",175,"ن",1,0],["والحَقْ بقوم قد عنوا بتجارة","نفقت لهم يوم القيامة سوق",176,"ق",1,0],["وَالحَقُّ مِن ماءٍ إِذا لايَنتَه","وَإِن اِعتَرَضتَ لَهُ فَمِن صَوّانِ",177,"ن",1,0],["والحَقُّ يَدمَغُ باطِلا لَو لَم يَكُن","حَقاً بأهواءِ النُّفُوسِ مَشُوبا",178,"ب",2,0],["وَالحَق يُؤخذ مِن حَدّ السُيوف وَلا","يُعطى كَإِعطاء بَعض السؤل وَالحاج",179,"ج",1,0],["والحق يعلو ولا يعلى عليه ومن","يهوى الأباطيلَ يومَ الفصل لا يعلو",180,"ل",2,0],["وَالحَقي بائِناً بِأَهلِكِ أَو أَن","تَ عَتيقٌ مُحَرَّرٌ يا غُلامُ",181,"م",1,0],["والحق لا بد له مرجعٌ","والله غالب على أمره",182,"ر",2,0],["والحق نور واضح لمخالف","ومؤالفٍ كالصبح مهما أسفرا",183,"ر",2,0],["والحق ليس يصونه من ظالم","إلا سيوف أصلت ورماح",184,"ح",1,0],["والحق بأهلك بالحجاز وخلني","أبدي لأهلي السر أو أخفيه",185,"ي",2,0],["والحق ما قد قاله أصحابنا","المسلمون وعللوا بأدلة",186,"ه",1,0],["والحق قد صلى عليه بنفسه","في سورة الأحزاب بعد السجدة",187,"ه",1,0],["والحق يحملهم ويحمل عرشه","والكل محمول بايدي القدرة",188,"ه",1,0],["والحق ليس يلاقي باطلاً أبداً","لا يلتقي هازم يوما بمنهزم",189,"م",1,0],["والحق أوثره على نفعي وإن","يك مدخلي يوم الحساب جهنما",190,"م",2,0],["وَالحَقّ لِلعَزم وَالأَرواحُ إِن قويت","سادت وَإِن ضعفت حَلَّت بِها الغِيَرُ",191,"ر",1,0],["وَالحق يظهر من مَعنى ومن كلم","وافى الوجودَ وجهل الناس عمَّ وَطَم",192,"م",1,0],["والحق يبرأ غير مكترث بما","يرويه عنه الحانق المتحدم",193,"م",1,0],["والحق ان طريق الدور منقطعٌ","ومن يعلق به يحنث فلا تهم",194,"م",1,0],["والحقد مع غضب فاحذر ومن حسد","ومن فضول من الافعال والكلم",194,"م",1,0],["والحق تبعناه كما شئت وأمليت","لم نكتب بمداد بل علماً بمدد",195,"د",1,0],["وَأَلحَقهُنَّ أَقوامٌ سِواكُم","وَعِندَكَ ما أَخَذنَ وَهُنَّ حُولُ",196,"ل",1,0],["والحَق مَا يْمُوْت لو بِيمْرَضْ","مَا دَام شَيّ أوْرَاق وِشْهود",197,"د",1,0],["وَالحقد بَينَ رحابه مُتزايل","وَالذَنب تَحتَ ظِلاله مَغفورُ",198,"ر",1,0],["والحق بالأعاريب اعتلاء","بهم وأجيد مدحهم اهتماما",199,"م",2,0],["والحقُّ مرْتَقى السّبعِ الطِّباقِ لكُمْ","لا زُخْرُفٌ شادَهُ عادٌ وشدّادُ",200,"د",1,0],["وَألِحقَت بِإِنَّ لَكِنَّ وَأن","مِن دُونِ لَيتَ وَلَعَلَّ وَكَأَن",201,"ن",1,0],["وَالحقُوا مُعَلَّ لاَمٍ عَرِيَا","مِنَ المَثَالَينِ بِمَا التَّا أو لِيَا",201,"ي",2,0],["والحقد والغل والبغضاء بينهم","لا يفلحوا أبداً والخير ينهار",202,"ر",1,0],["وَالحَق مصباحُ العجا","ئب كلُّنا مشكاتُها",203,"ت",3,0],["وَالحَق وَالبُرهان فضلُ الفَتى","لا الفضل ما يُبديهِ جاهٌ وَمالْ",204,"ل",1,0],["وَالحق أَصبح باطلاً وَتحذّرت","نجَسَ المساجد في الوَرى الصهباء",205,"ا",2,0],["وَالحَقُّ لَولا العاذلون ضممتُه","وَخررتُ شكراً لاثمَ الأَقدام",206,"م",1,0],["وَالحَق يا مَولاي مذ بنتمُ","ما طاب لي سُهدٌ وَلا مضجع",207,"ع",1,0],["وَالحَق وَضاح الضيا","وَالغش داجي الحَظ دامس",208,"س",1,0],["والحقد في بعض الأمور فضيلة","فانشر مظالمهم بكل لسان",209,"ن",1,0],["وَالحَقُّ يَعرُسُ وَالطُغيانُ مُنتَحِبُ","وَالكَفرُ يَطمِسُ وَالإيمانُ مُزدَهِرُ",210,"ر",1,0],["والحقد والحسد الممقوت صاحبه","عم الأنام جماعات وآحادا",211,"د",2,0],["والحق أنه يخبر الصّحابْ","بوصفها في كلِّ عام لا ارتيابْ",212,"ب",1,0],["والحق في نصرك سبحانه","لانك العالم بالحق",213,"ق",1,0],["وَاَلحَقَ لِيقُوفُنطُساً وأَمُوفَنَا","وميلاَنِفاً تَنتَابُهُم غُصَصُ الفَنا",214,"ن",2,0],["وَالحَقَّ أَصدِقُكُم لَن يَنجوَنَّ بِنا","ناجٍ لإِليونَ يُنمي شَرَّ مِحنَتِهِ",215,"ه",1,0],["وَالحقُّ أن تُنسَبَ لِلذَّاتِ الَّتِى","قَد وُصِفَت بِذِى الصِّفَاتِ جَلَّتِ",216,"ت",1,0],["وَالحَقًّ لاَ يَخفَى عَلَى ذِى عَينِ","وَاللهَ نَرجُو عِصمَةً مِن مَينِ",216,"ن",1,0],["وَالحق في نفق وَالزيغ في قلق","وَالدين طلق المحيا في حمى حرب",217,"ب",1,0],["والحقُّ حقٌ واضحات سُبْلُهُ","كالشمس عمَّ بنورها الإشراق",218,"ق",1,0],["والحق سيف والأحق به امرؤُ","شهم بغير اللَه ليس يبالي",219,"ل",2,0],["والحق فاز به الأحق مؤرخا","ولقد جرت لمقرها النعماء",220,"ا",2,0],["والحق سيف والأحق","ق به ذوو تاهلا",221,"ل",2,0],["وألحق الألفَ الأسماءَ خَمْسَتها","في النصب تجلُ من الإلباس كل عمى",222,"م",2,0],["والحقُّ في كل بابٍ أن يبين ما","يحقُّ أن يُنْتَحَى فيه ويُلْتَزما",222,"م",2,0],["والحقْ بطائفةٍ بالحقِّ طائفةٍ","واسلكْ سبيلَهُمُ في كلّ ما سلكوا",223,"ك",3,0],["والحَقُّ يَظْهَرُ مِن مَعْنىً وَمِن كَلِمِ","كَم بُشِّرُوا لَو يُلَقَّوْنَ الهُدَى بِنِعَمْ",224,"م",1,0],["وألحقتُ أعجازَ الأمور صدورها","وقَوَّمها غَمزُ القِداحِ المقَلِّبُ",225,"ب",1,0],["والحقد والحسد المشوم والريا","والانقياد لطاعة الشيطان",226,"ن",1,0],["والحقل قد كان دارك","تجيد فيه الأغاني",227,"ي",1,0],["والحقُّ أقْوَمُ واضحٍ مُتَسَلِّحٍ","هل تستوي الظُّلمَاتُ والأنوارُ",228,"ر",1,0],["وَالحَقُّ لا يَتَناهى","لِذاكَ تابَ الأَكابِر",229,"ر",1,0],["والحَق بَيِّن ما يِبَا له منادي","كالشَّمس ضاءت ما غِباك اشتِعالها",230,"ل",3,0],["والحق مثل الشمس في فلك العلى","أنواره بالحجب ليست تستر",231,"ر",1,0],["والحق شمس ونورها منه محروم","والباطل ارخى سترته فوقها ونام",232,"م",1,0],["والحق يبقى لو تجي دونه غيوم","لا بدّ ما يظهر مع الوقت فرزه",233,"ز",2,0],["والحقيقة صورنا نار حول الغدير","بين حرق وغرق جسر السلامة سراب",234,"ب",1,0],["والحَقُّ ما جافاهُ أَصحَابُهُ","إِلَّا وكانَ اللّهُ في عَونِهِ",235,"ن",2,0],["والحِقدُ بابٌ يُلْقِي الضَّحَايَا","مِن كُلِّ صَوْبٍ باسمِ المَذَاهِبْ",236,"ب",1,0],["والحقايق لو غشاها ليل ذباحٍ يسود","كل ركن في حشاها يستحله .. يقتله",237,"ل",2,0],["والحق كالشمس في قلب السما سطعت","يرى جميعُ الورَى فوق الربا علمه",238,"م",2,0],["والحق يبحث عن وصي محمد","ويرى المناكر في الورى متصبرا",239,"ر",2,0],["والحَقْ بركب المهتدين إلى الهدى","نهجاً تجد بالمهتدين منافعَه",240,"ع",2,0],["والحقولُ التي لكم عاث فيها","كلُّ مَن كان فكرُه جاهليا",241,"ي",2,0],["والحقلَ مِن نَسج الربيع اكتسى","وازدان بالخضرةِ واعشوشبا",242,"ب",2,0],["والحقّ قام معزّزًا ومؤيّدًا","والبُطْلُ قد زلّت به الأقدام",243,"م",1,0],["والحقُّ بُهْرِجَ،من إفلاسهم، كَلِماً","ممَّا يُقالُ، بلا فعل ٍسوى الخُطَبِ",244,"ب",1,0],["والحق أن غصون مال لم تكن","لله تثمر حسرة ووبالا",245,"ل",2,0],["وَالْحِقْدُ شَنَّ عَلَى الْعِرَاْقِ حُرُوْبَهُ","فَالأَرْضُ قَفْرٌ، وَالْقُصُوْرُ يَبَاْبُ",246,"ب",1,0],["وَالْحَقُّ صُوْدِرَ وَالْعَدَاْلَةُ غُوْدِرَتْ","فِيْ عَهْدِهِمْ، وَتَحَطَّمَ الْمِيْزَاْنُ",247,"ن",1,0],["والحقيقه غير والله كذبهم ما له مدى","كل ابوهم ما وفاهم شكل وانواع القصيد",248,"د",1,0],["وَالْحَقُّ رائِدُهُ مَدى أيّامِهِ","وَالْعَدْلُ في الْأغْرابِ وَالقُرْباءِ",249,"ا",2,0],["والحقُّ لهُ مَنْ يحرسُهُ","مهما خدعوهُ فلن يُغوى",250,"و",2,0],["وَالحَقُّ فِيْ خَجَلٍ يَمشِيْ حِذَا جُدُرٍ","تَلاقَفَتْهُ يَدٌ وَإِنْ مَشَى سَحَرَا",251,"ر",2,0],["وَالْحَقْلُ أَفْتَىْ بِمَاْ فِيْ الرَّنْدِ مِنْ طِيَّبٍ","وَاسْتَشْهَدَ الضُّوْءُ مَاْسَاً مِنْ فَتَاْوِيْهِ",252,"ي",2,0],["والحق بين ما على وجهه غبار","كل بصم في صفحته باعترافه",253,"ف",2,0],["والحقل يبسمُ للجداول هاتفًا","إني يلوح لي الزمان المخصب",254,"ب",1,0],["والحق يجلو الحق في آياته","والأمر ثمة شدة في لين",255,"ن",1,0],["والحقُّ أنَّ جيوشَ اللهِ أجمعَها","تَستنكفُ الحربَ .. إنْ كنّا سنحتربُ",256,"ب",1,0],["والحق تستوقف الأرواع صيحته","ردوا إلى العرب ما قد كان للعرب",257,"ب",1,0],["والحق ممتهن وحر","الطبع غر مضطهد",258,"د",1,0],["وَالحَقُّ فَردٌ وَالشُّهُودُ كَثِيرةٌ","وَلِعَالَم الأَشهَادِ جَمٌّ رَاكِسُ",259,"س",1,0],["والحقد طبع ذميم عد عنه وعذ","بالله رب العلى من شر من حقدا",260,"د",2,0],["والحق على شعب راضى --- مخه فاضى","حكامه خصمه والقاضى - م الدار ع النار",261,"ر",1,0],["والحقُّ مرهونٌ بوحيِ (محمّدٍ)","من ذا سوى زين الخلائقِ يشفعُ",262,"ع",1,0],["والحق جاء لكل الناس ينقدهم","من الضياع فلم تبق الاباطيل",263,"ل",1,0],["والحق لا شك مردود لصاحبه","والظلم في الخزي منبود ومعزول !",263,"ل",1,0],["والحق أثبت أن تلك مكائد","ممن يود إدارة الأغراب",264,"ب",1,0],["والحق حتماً أنه سبحانه","عن كل مخلوق تعالى بائن",265,"ن",1,0],["والحق قد يعنى بها أيضاً فما","ندري بما يعني المهين الفاتن",265,"ن",1,0],["والحق أوضح لكن ليس يبصره","من كان في غمرة أو كان وسنانا",266,"ن",2,0],["والحق يعلو ولا يعلى عليه ومن","بالحق دان على من دان كفرانا",266,"ن",2,0],["والحق كالشمس لا تخفى دلائله","إلاَّ على جاهل بالعلم ما اتصفا",267,"ف",2,0],["والحق كالصبح كل الخلق شاهده","والسيف كالصبح في تفريق جمعهم",268,"م",1,0],["والحقُّ مبعثُه ثباتَ صنائعٍ","ما ضاع حقٌّ راسخٌ يتكلمُ",269,"م",1,0],["والحقد فيهم قد أتوها عنوةً","عاثوا بها الإفساد والتخريبا",270,"ب",2,0],["والحق يبدإ في آهات مُكتئبٍ","وينتهي بزئير مُلؤه نِقمُ",271,"م",1,0],["والحق أبلج مثل الشمس غرته","يهدي الضليل سنا أنواره السبلا",272,"ل",2,0],["والحقيقه ضايعه من رأسها للوركي","في فراااغ ونقطتين وفاصله مع داشي",273,"ش",2,0],["والحق أبلج لا يخفى سناه وإن","ساد الظلام وحالت دونه السحب",274,"ب",1,0],["والحقُّ في شرعِ التقيِّّ مناعة","والحبُّ في شرع المُحبِّ رقيبُ",275,"ب",1,0],["والحقُّ يبْقى وهذا الإفْك منْصرمٌ","وَقُوَّة الحَقِّ تُرْدي كلّ بتّارِ",276,"ر",1,0],["والحقُّ أنهمُ لولا تدخُّلُهُ","ما لُقِّبُواْ قادةً كلا ولا كُرَمَا",277,"م",2,0],["والحقد أكبرُ مايكون","تضخّما خلف القناع",278,"ع",1,0],["والحقُ ليلى للذئاب رهينة","والكل من أخطائه متفجّعُ",279,"ع",1,0],["والحَقُّ حقٌّ وإِنْ سُدَّتْ مَسَالكُه","وَإنْ غَفَا مَوْجُهُ هدْرًا ولمْ يَهُجِ",280,"ج",1,0],["والحقد والحقره وتقديم الحريم على الرجال","ومن قال ذي الحرمه رجل قيل الرجل هذا مره",281,"ر",2,0],["والحق ضايع مع اخواته","الصدق والود ياحافظ",282,"ظ",1,0],["والحق ماله صوت لو باطله طاش","جامل وخل الوضع لو فيه تحريش",283,"ش",1,0],["والحق واضح بالمعاني خطابه","بين وراع الفهم فهمه يكفيه",284,"ي",2,0],["والحق ابلج .. ماتخفا ولا لاج","والعيب تعرف بالخوافي مواريه",285,"ي",2,0],["والحق خير مشرق بنوره","وقائم بنفسه وقيّم",286,"م",1,0],["والحقتها تسعين ونه وتسعين","من عقب ما هي بالحشا مستكنه",287,"ن",2,0],["والحقُّ يحكمُ والأعضاءُ شاهدة ٌ","والنارُ تؤصدُ للطاغينَ في عمدِ",288,"د",1,0],["والحقُّ في كفَّيك يشرق بدره","إذ لن ترى أبدا عليه سحابا",289,"ب",2,0],["والحق أظهر ان يرى بشواهد","لم لا وقد قامت به الاسماء",290,"ا",2,0],["والحق يرضى من دعى لجنابه","وهدى له عبد من الفساد",291,"د",1,0],["والحق أن جميعهم","عن صفحة الدنيا نبا",292,"ب",2,0],["والحقير اللي على نفسه تمرَّد","أحقره وما همِّني واشي وداني",293,"ن",2,0],["والحق الأبلج ، مايمارى بلونه","متوهّج ٍ نوره على روس الأشهاد",294,"د",1,0],["والحقّ قلتَ فما عادت لنا سندا","الا فتاة تُسمّى الآن حُريّةْ",295,"ي",2,0],["وَ الحَقُّ مَصلُوبٌ عَلَى وَتَدٍ","وَ الزُّورُ فَعَّتْ رِيحُهُ نَشوى",296,"و",2,0],["والحقُّ أضحى نكتةً مكتوبةً","حيكت على كفِّ العواهر مذ جرى",297,"ر",2,0],["والحقُ يبدأُ من محمدٍ مثلما","فاض الضياء بروحه في الغارِ",298,"ر",1,0],["والحق بين الاتنين ضايع وهو داالشايع","مدير بيبلطج علي صايع عاطل كسلان",299,"ن",1,0],["وَالحَقُّ ما فَتَنَ الأنامَ جَمالُهُ","إِلاّ إِذا حَلاّهُ سِحرُ العاطِفَه",300,"ف",2,0],["وَالحَقُّ سِرٌّ خَطَيرٌ لَيسَ يُدرِكُه","مَن ظَنَّ عاقِبَةَ الأَرواحِ كَالرِّمَم",301,"م",1,0],["وَالحَقُّ أَبلَجُ لا يُقاوِمُ عامِلٌ","بَأسَ الغَنِيِّ يَعيشُ مِن أَطيانِهِ",302,"ن",2,0],["وَأَلحَقَها مِن مَحاسِنِهِ","بُروداً حَكَت سُندُساً وَحَريرا",303,"ر",2,0],["وألحقنا بأمّتنا نشيدا","عفيفا لا تخالطه العيوبُ",304,"ب",1,0],["والحقل يرفل بالأزهار ضاحكة","أريجها العبق الفواح يحيينا",305,"ن",2,0],["والحق أين الشعر بين قنابل","ترمي على بعد المسافة ترجم",306,"م",1,0],["والحق ما الإيمان ملء قلوبنا","فمنافقونا مضرب الأمثال",307,"ل",1,0],["والحق يدري أين كان ثواؤه","في العلم والأعمال في حمل الحسام",308,"م",1,0],["والحق كل الحق في توحيدنا","لقيام صرح يعتلي فض الخصام",308,"م",1,0],["والحقُّ يرسلُ غيمه ورعوده","تهدي إليه برحمةٍ وتجَبُّرِ",309,"ر",1,0],["والحقّ كالشمس في رأد الضحى سطعت","لن يمحقَ الحقَّ بالبهتان بهتان",310,"ن",1,0]]}