"],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5213,"أبا العلياء عز عليك اني","https://www.poetsgate.com/ViewPoem.aspx?id=170507",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5376,"سيذكرني قومي اذا كنت ثاويا","https://www.poetsgate.com/ViewPoem.aspx?id=188256",""],[5376,"كلٌّ يغني على ليلاه","https://www.poetsgate.com/ViewPoem.aspx?id=188474",""],[5376,"تأملت الهوى في كل درب","https://www.poetsgate.com/ViewPoem.aspx?id=188538",""],[5419,"قوة الضعف","https://www.poetsgate.com/ViewPoem.aspx?id=32261",""],[5452,"ألذّ السّكر","https://www.poetsgate.com/ViewPoem.aspx?id=112436",""],[5672,"أخاف...","https://www.poetsgate.com/ViewPoem.aspx?id=206515",""],[5762,"إقرأ كتابك","https://www.poetsgate.com/ViewPoem.aspx?id=13131",""],[5790,"يا أيها الناس اعملوا لمعادكم","https://www.poetsgate.com/ViewPoem.aspx?id=111963",""],[5849,"يا راحماً فوجَ الحجيج","https://www.poetsgate.com/ViewPoem.aspx?id=191080",""],[5956,"أريد يكون منها الاهتمامُ","https://www.poetsgate.com/ViewPoem.aspx?id=181845",""],[5956,"أريدك دائماً حولي","https://www.poetsgate.com/ViewPoem.aspx?id=194261",""],[5956,"أ تأتي الإمارات يا صالح؟","https://www.poetsgate.com/ViewPoem.aspx?id=194595",""],[6078,"بل أَكثر","https://www.poetsgate.com/ViewPoem.aspx?id=203412",""],[6102,"ذِكرى الأَمس !!","https://www.poetsgate.com/ViewPoem.aspx?id=184048",""],[6180,"رسالتي الأخيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81076&r=&rc=10",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""],[6269,"رحيل لم يحدث بعد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87854&r=&rc=16",""]],"verses":[["وَأَخْشَنُ الأَثْوَابِ مَا يَكْتَسِي","وَأَرْدَأَ الأَلْوَانِ مَا يَطْعَمُ",0,"م",1,0],["وأخشى الردى منه على كل شاربٍ","فكيف بأَمْنِيه على نفس راكبِ",1,"ب",1,0],["وَاِخشَع مَلِيّاً وَاِقضِ حَقَّ أَئِمَّةٍ","طَلَعوا بِهِ زُهراً وَماجوا أَبحُرا",2,"ر",2,0],["وَاِخشَ مُناقَشَةَ الحِسابِ فَإِنَّهُ","لا بُدَّ يُحصي ما جَنَيتَ وَيَكتُبُ",3,"ب",1,0],["وأخشى فتنةَ الدنيا","كما أخشى منَ اللصِّ",4,"ص",1,0],["وَاِخشَعي يَوشك أَن يَغشى الحمى","يا فَلسطين سنىً مِن فيصلِ",5,"ل",1,0],["وأخشى أن يرفَّ الجف","نُ يحرمني محيّاك",6,"ك",1,0],["وَاخْشَ الدَّسائِسَ مِنْ جُوعٍ وَمِنْ شَبَعٍ","فَرَبَّ مَخْمَصَةٍ شَرٌّ مِنَ التُّخَمِ",7,"م",1,0],["وَأَخشَعُ في نَفسي وَأَخفِضُ ناظِري","وَسَجّادَتي في الوَجهِ كَالدِرهَمِ المَطلي",8,"ل",2,0],["وَاِخشَ المُلوكَ وَياسِرها بِطاعَتِها","فَالمَلكُ لِلأَرضِ مِثلُ الماطِرِ الساني",9,"ن",2,0],["وَأَخشَى بَني عَمّي عَلَيكَ وَإِنَّما","يَخافُ وَيَتقي عِرضَهُ المُتَفَكِّرُ",10,"ر",1,0],["وَاخْشَ النَّمِيمَةَ وَاعْلَمْ أَنَّ قَائِلَهَا","يُصْلِيكَ مِنْ حَرِّهَا نَاراً بِلا شُعَلِ",11,"ل",1,0],["وَاخْشَ الدَّسائِسَ مِنْ جُوعٍ وَمِنْ شَبَعٍ","قَرَبَّ مَخْمَصَةٍ شَرٌّ مِنَ التُّخَمِ",12,"م",1,0],["واخشَعْ إذا حدَّثْتَ عن أَسلافهم","أو زرتَ ما تركوا من الآثار",13,"ر",1,0],["واخشَ الدخيلَ فلا تَمدُدْ إليه يَداً","فانَّه ايُّ نَفّاع وضَرّار",14,"ر",1,0],["وأخشى بني عمّي عليك وإنما","يخاف ويبقي عرضه المتفكّر",15,"ر",1,0],["واخشعوا بالصمت في محرابه","أفصح الألسن صمت الخاشعين",16,"ن",1,0],["واخشع فيه اعظاما وحبا","لمولانا الامام ابي علي",17,"ي",1,0],["واخشى يا ابا العلمين ضيماً","وتاكلني الذئاب وانت ليث",18,"ث",1,0],["وأخشى الكرى إذا كل حلم مروع","وأخشى الردى إذ كل شيءٍ مهدد",19,"د",1,0],["وأخشى أن يبوح بما رآه","سلوه لا ينم على أخيهِ",20,"ي",2,0],["وَأَخشَعَهُم إِذا صَلّى فُؤاداً","وَأَشجَعَهُم إِذا ما السَيفُ صَلّا",21,"ل",2,0],["واخشوا سطا يحي فصمصامه","مجرب ما قل ما قل ما",22,"م",2,0],["واخش الاذى عند اكرام اللئيم كما","يخشى الاذى من اهان الحر في حفل",23,"ل",1,0],["وأخشى عليها من شعاعكَ مثلما","يخافُ على النفسِ الجبانُ المواضيا",24,"ي",2,0],["واخشَ الدسائسَ من عدا","تكَ واحذرنَّ فعالها",25,"ل",3,0],["وَاِخشى عَلَيكِ هبوبَ النَسيم","وَإن هُوَ من جانِبِ الرَوضِ هبا",26,"ب",2,0],["وَأَخشى اللَيالي أَن تَجورَ خُطوبُها","وَما جارَ في عَصرِ الوَزيرِ لَها خَطبُ",27,"ب",1,0],["وَأَخشى وَرَبعي في جِوارِكَ ضَيعَةً","وَضيماً إِذاً يا ضَلَّتي وَشَقائي",28,"ي",1,0],["وَاخْشَ مِنْ مُفْسِدِ الصَّنِيعِ فَشَرُّ ال","خَلْقِ مَنْ رَمَّدُوا الذِي قَدْ شَوَوْهُ",29,"و",2,0],["واخش بِرّاً يكون محضَ عقوقٍ","ومن البرّ ما يكون عقوقا",30,"ق",2,0],["واخشوا عواقب مكر","أَبدى به وأعيد",31,"د",1,0],["وَأَخشى أَن تَزيدَ عَلَيَّ تيهاً","وَإِعراضاً بِهِ فَتَصُدَّ عَنّي",32,"ن",2,0],["وأخشى رجوعا إلى عدل توعد من","لا يتقيه بنار حشوها القصب",33,"ب",1,0],["واخش الإله لدينه متحافظا","إذ لا ينال العلم عاص مجرمُ",34,"م",1,0],["وأخشَى من الأرضِ تُعدي السما","فإن فعلَت خلتُ أن ليسَ تَمطر",35,"ر",1,0],["وَاخش أَن تَنهال إِن لَمَستَ","راحة لا تَحجب القَدحا",36,"ح",2,0],["وَأَخشَمَ إن مَثَّلتَ فَاهُ وَأَنفَهُ","فَإنَّهُمَا ضَِدَّانِ لِلمِسكِ وَالنَّدِّ",37,"د",1,1],["واخشن كما شئت أو فلن لي","فليس جنبي بمستلانِ",38,"ن",1,0],["وَأخشَع في الخطبِ الحقير ضراعةً","وقد كنت دفّاعاً صدورَ العظَائمِ",39,"م",1,0],["وَأَخٍ شِمتُهُ العَطاءَ فَأَكدَى","وَهوَ مَلآنُ مِن يَسارٍ بَطينُ",40,"ن",1,0],["واَخشَى زَئيرُكَ نَبحَ الكِلابِ","وَفَرَّقَ جَمعَهُمُ فافتَرَق",41,"ق",1,0],["واخش منه إذا تسامحت فيه","غائلات تجر إثماً ووزرا",42,"ر",2,0],["واخشَ الجديديْن أَنْ يَغُراك لو","بلغت منها منى وآمالا",43,"ل",2,0],["وأخشى العواذل أن يفطنوا","فأخفي من الوجد ما ليس يخفي",44,"ف",2,0],["وأخشعهم قلبا وأسمحهم يدا","وأفصحهم نطقا وأعطرهم فما",45,"م",2,0],["وأخشعهم قلبا وأنفهم دعا","وأطهرهم نفسا وأسلمهم صدرا",46,"ر",2,0],["واخشوا الضلالة عن طريق الحق إذ","من ضلَّ عنه يرى عقاب الضاللِ",47,"ل",1,0],["وأَخْشى مِنْهُ ما أَخْشى فَأَضْنى","عَلى أَنِّي أُرَجِّي ما أُرَجِّي",48,"ج",2,0],["واخشين كاتب الشمال فيا خس","ر امرئ في الشمال منه كتابه",49,"ب",2,0],["وأخشى الرّقيب وتضريبه","على اسمي بالمرقم الأحمر",50,"ر",1,0],["وأخشى على نفسي اختلافَ هوائِهِ","وما للفتى ممَّا قضَى مهرَبُ",51,"ب",1,0],["واخشى الظبا حياً ومسكنها القفرُ","وهنا انا في ذا الحبِّ رهنُ احتكامهِ",52,"ه",1,0],["واخش المنون من الحواجب إنها","أم العجائب سهمها لم يصرد",53,"د",1,0],["وأخشهُ إن لهوتَ فهوَ رقيبٌ","وقريبٌ للقلبِ والشريانِ",54,"ن",1,0],["واخشَ عينَ الرقيبِ فهوَ شهيدٌ","ليس يخفى عليه سرٌّ لجاني",54,"ن",2,0],["واخش الجمار لدى بئر الحجار إذا","سعيت منها إلى حمام زرقون",55,"ن",1,0],["وأَخْشَباه وودايه وأَبْطَحُه","جَديبُه، لا رأَى جَدْباً، وَمَرْبَعُهُ",56,"ع",2,0],["واخش إله السَّماءِ إنَّا","كلا إليه غدا نَصير",57,"ر",1,0],["وَأَخشى اللَيالِي الغادِراتِ عَلَيهِمُ","لِأَنَّ اللَيالي غَيرُ مَأمُونَةِ الغَدرِ",58,"ر",1,0],["واخشنوا في طلب الثأر فما","تدرك الأوتار كف الناعمين",59,"ن",1,0],["وَأَخشَعُ لِلمَولَى مِنَ النَّاسِ أخوَفُ","تَبِينُ إِذَا ما النَّاسُ آوضوا لِمَحشَرِ",60,"ر",1,0],["واخش سطاه ساخطاً","إن شنَّ درعاً أو نثل",61,"ل",1,0],["وَأَخشَعُ في مَشيي وَأَصرِفُ ناظِري","وَسجّادَتي في الوَجهِ كَالدِرهَمِ البَغلي",62,"ل",2,0],["وأخشن الشقين عني نفي","وشقه الألين ما عاش لي",63,"ل",2,0],["وأخشى إذا ما جئت حيّ كناسه","حذاراً عليه ان تذعر قرطاه",64,"ا",2,0],["واخش الذي عني يخاطبك غد","ذي يسال الوالي عن الرعيه",65,"ي",2,0],["واخشى أن تخاصمني عليكم","بدور الأفق أو أُسد البوادي",66,"د",2,0],["وأخشى إذا طال المدى هجمة النوى","وأعتاض عن غض الجنى ورق السدر",67,"ر",1,0],["واخش الظباء فإن قسورة الحمى","لكناسها بعرينه متجانف",68,"ف",1,0],["واخش العيون فسودها","كالبيض تجرح بالظبين",69,"ن",1,0],["واخش رمز الجفون فالسحر منها","دون كشف لسرها المرموز",70,"ز",1,0],["وأخشى أنها بالخبن تفنى","إذا واليت إخفاء الفتوق",71,"ق",1,0],["وأخشى بعضهم أن يتلفوه","وأخشى بعضهم أن يدّعوه",72,"و",2,0],["وأخشى بينهم جدلا وحربا","اشاهد نارها تعلو انتقادا",73,"د",2,0],["وأخشى ان نسيت الوعد فقدي","لعمري والتمتع في بهاكا",74,"ك",2,0],["وأخشى رجوع السكر لي بعد صحوتي","فيا ليت لي في عيشتي صحو تجار",75,"ر",1,0],["واخش الدَسائس من جوع وَمن شبع","كَم أَعجز الطب ما عاثت يد البَشم",76,"م",1,0],["وَاخش الدسائس مِن جوع وَمِن شبع","فَفي التَوسط فضل غَير منخرم",77,"م",1,0],["واخشي حوادث صرف الدهر في مهل","واستيقني لا تكوني كالذي انتجثا",78,"ث",2,0],["واخشوشنوا في الحرب إن أوقدت","بكل خطي وذي أثر",79,"ر",1,0],["واخش ابتكار بدائعٍ أحضرتها","في كل معنىً لاح لي في النوره",80,"ر",2,0],["واخشَع ولا تَتحكَّمَن","عُجباً بالفاظِ الخشوعِ",81,"ع",1,0],["وأخشى إن حجبت عن التلاقي","أموت بلوعتي موت السليم",82,"م",1,0],["وَاخش المصيبةَ في السلامة واعتصم","إن تلقها فالصبح بعد الواقبه",83,"ب",2,0],["وَأَخشى إِن أَصابك يَوم سوء","تَكون عدمتهم وَجلبت آفه",84,"ف",2,0],["وَاخش من حسرة الفؤاد انصداعاً","فهي من رأَفة بِها تَتَأَثّر",85,"ر",1,0],["وَاخشَ العُيون الدعجَ مِن عَين الحمى","وَإِذا مررتَ فَغُضَّ غَضَّ المُحرم",86,"م",1,0],["وَاخش الكَلام فَكم جنت","حرب البَسوس وَسَبق داحس",87,"س",1,0],["وأخشى ان تمادى الأمر هذا","بأن يستحكم الداء العضال",88,"ل",1,0],["وأخشى على جَمْرَتَيْ خَدِّهَا","بِمَرِّ النواسمِ أن تُلْهَبَا",89,"ب",2,0],["واخشَ العَجَّان ومن هو ذو","تحجيل الكلب وذا الرَّجلِ",90,"ل",1,0],["وَأَخشى إِذا ما رجعت غَدا","يعلمني النوح ازهاقها",91,"ه",2,0],["واخشَ الإلهَ على غيٍّ هممتَ بهِ","واعلم يَقيناً بأن اللَه جبّارُ",92,"ر",1,0],["وَاِخشَ الدسائِسَ من كيد الزَمانِ فَكَم","تَراهُ يَضرِبُ أَخماساً بِأَسداسِ",93,"س",1,0],["واخشوشنت كمعيشتي","منه خلائقه الدمائث",94,"ث",1,0],["واخش المهيمن وأت ما يدعو إليه","وانته عما نهى وتزهد",95,"د",1,0],["واخش الدناءة والطبع الذميم ولا","تنظر إلى قلمة الإنسان في الأكل",96,"ل",1,0],["وأخشى أحب بكل جنونٍ","فأشقى بجرحي ولا أحتمل",97,"ل",1,0],["وأخشى إذا لم يعد تائباً","بأن يلقيَ الروحَ للتّهلكة!",98,"ك",2,0],["وأخشى أن أقصر عن مداه","ومنه العذر ألفاظي عيِيّةٍ",99,"ي",2,0],["واخش الدسائس في قولٍ وفي عملٍ","من قبل أن تجرع التنغيص والندما",100,"م",2,0],["وَأَخْشَى أَنْ أَحُورَ مَعَ الْمَعَانِي","فَيَحْبِسُنِي مَحَارُكَ بِالفُتُونِ",101,"ن",1,0],["وَأَخْشَى عَلَى وَجْدِي مَشِيِخَ فَضَائِلِي","فَلَحْمُ خِصَالِي فِي انْسِلاَخِي وَشَائِقُ",102,"ق",1,0],["وأخشى على نفسي اختلافَ هوائِهِ","وما للفتى مما قضى اللهُ مهربُ",103,"ب",1,0],["وأخشنهم بأساً وأوفاهم تقىً","وأذهبهم صيتاً وأطيبهم ذكرا",104,"ر",2,0],["واخْشَ التزلُّق فهي جسر طالما","زلقت عليه أسِرّة وقباب",105,"ب",1,0],["واخش الرقيب على الح","بيب ولا تدعك تُرى كليما",106,"م",2,0],["واخش الدسائس من جوع ومن شبع","تسلم من الكيد في حرب وفي سلم",107,"م",1,0],["واخشى ان يقال وانت تدري","بأن الخلف من طبع الاليف",108,"ف",1,0],["وأخشى له من أن أكن متوسلاً","إليه بمخلوقٍ من الناس لا يجدي",109,"د",2,0],["واخشى على نفسي بُعَادَ أخلَّةٍ",