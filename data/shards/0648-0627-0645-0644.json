2324",""],[5121,"فِنْجَانُ الْقَهْوَة","https://www.poetsgate.com/ViewPoem.aspx?id=33581",""],[5135,"إنَّ رَبَّ الْكَوْنِ يَرْزُقْ","https://www.poetsgate.com/ViewPoem.aspx?id=202059",""],[5183,"المصاب المؤلم","https://www.poetsgate.com/ViewPoem.aspx?id=180255",""],[5183,"طوى","https://www.poetsgate.com/ViewPoem.aspx?id=180160",""],[5190,"الناعقون","https://www.poetsgate.com/ViewPoem.aspx?id=153357",""],[5282,"على ضفاف الروح.. نسري","https://www.poetsgate.com/ViewPoem.aspx?id=214051",""],[5290,"أعد الحديث فليس بالمملول","https://www.poetsgate.com/ViewPoem.aspx?id=113132",""],[5302,"جعلت فداكا","https://www.poetsgate.com/ViewPoem.aspx?id=205728",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5365,"دعوة إلى الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=190472",""],[5376,"قد سامك الشؤمُ ما في وجهِكَ البشْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=188445",""],[5376,"لستُ عنه من أنسِه ببعيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=191853",""],[5431,"خيمة بؤسٍ...وقصعةِ بردِ","https://www.poetsgate.com/ViewPoem.aspx?id=183414",""],[5442,"نسم آن أن تسري الرفاق إلى الحمى","https://www.poetsgate.com/ViewPoem.aspx?id=114747",""],[5442,"اعمل حساب النفس عن هفواتها","https://www.poetsgate.com/ViewPoem.aspx?id=114757",""],[5458,"يارب","https://www.poetsgate.com/ViewPoem.aspx?id=72281",""],[5459,"هذي الحشاشة تذوي","https://www.poetsgate.com/ViewPoem.aspx?id=190947",""],[5493,"ثورة القلم","https://www.poetsgate.com/ViewPoem.aspx?id=200826",""],[5518,"لا تعذلاه فما ذو الحب معذول","https://www.poetsgate.com/ViewPoem.aspx?id=187364",""],[5571,"إلام وفيم يظلمني شبابي","https://www.poetsgate.com/ViewPoem.aspx?id=182692",""],[5596,"من وحي \"بون\"","https://www.poetsgate.com/ViewPoem.aspx?id=206482",""],[5612,"فرْضُ عَيْن","https://www.poetsgate.com/ViewPoem.aspx?id=181417",""],[5718,"داو القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=214404",""],[4623,"لا تلوموني إني أطلت المقالا ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146608",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5849,"يا راحماً فوجَ الحجيج","https://www.poetsgate.com/ViewPoem.aspx?id=191080",""],[5953,"بإسماعيل تهتم يا رعاء","https://www.poetsgate.com/ViewPoem.aspx?id=93799",""],[5956,"هلال ونجمة ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182427",""],[5956,"ستجعل مني الصبايا مُهِمَّا","https://www.poetsgate.com/ViewPoem.aspx?id=185399",""],[5956,"منْعُ نشْر شعري كمنْع نور البدرِ","https://www.poetsgate.com/ViewPoem.aspx?id=192459",""],[5970,"إيه يا دنيا اخدعي من تخدعين","https://www.poetsgate.com/ViewPoem.aspx?id=130579",""],[5989,"يا راحلاً قد شاقهُ الغرقُ","https://www.poetsgate.com/ViewPoem.aspx?id=181565",""],[6027,"دهاء أنثى","https://www.poetsgate.com/ViewPoem.aspx?id=198422",""],[6046,"يا ذات الخمار","https://www.poetsgate.com/ViewPoem.aspx?id=35809",""],[6148,"الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=201684",""],[6152,"لا تيأس","https://www.poetsgate.com/ViewPoem.aspx?id=203272",""],[6237,"آذان الفجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77887&r=&rc=29",""]],"verses":[["وأملاكٌ له حرس وأنس","تظاهره بشهب أو نبال",0,"ل",1,0],["وَأَمَّلتَ ما عَكَسَتهُ الخُطوبُ","سَفاهاً أَجَرَّكَ هَذا الأَمَل",1,"ل",1,0],["وَأَمَّلَ أَن يَرعى حِمى المَلكِ سِربُهُ","وَبِالجِزعِ حَمضٌ عازِبٌ وَأَراكُ",2,"ك",1,0],["وَأَمَّلتُ أَن أَجري خَفيفاً إِلى العُلى","إِذا شِئتُمُ أَن تَلحَقوا فَتَخَفَّفوا",3,"ف",3,0],["وَأَملَأُ مُقلَتَيَّ مِنَ العَوالي","إِذا اِمتَلَأَت مِنَ العَلَقِ الغَزيرِ",4,"ر",1,0],["وَأَمَّلتُمُ أَن تُدرِكوها طَوالِعاً","دَعوها سَتَسعى لِلمَعالي سُعاتُها",5,"ت",3,0],["وَآمُلُ أَن تَقي الأَيّامُ نَفسي","وَفي جَنبي لَها ظِفرٌ وَنابُ",6,"ب",1,0],["وَأَملاكٌ يَرَونَ القَتلَ غُنماً","وَفي الأَموالِ لَو قَنِعوا فِداءُ",7,"ا",2,0],["وَأَمْلأُ مِنْ عَصِيِّ الدَّمْعِ قَسْرا","مَحاجِرَ كلِّ طَيّعَةِ التَّثَنّي",8,"ن",2,0],["وأمّلَ أن يَحْيَى لفَصْلٍ يُعيدُها","فَكَيفَ بمَنْ في جنّةِ الأرْضِ مَثْواهُ",9,"ه",1,0],["وَآمُلُ بُقْيَا فِي مَحِلَّة قُلْعَةٍ","لَقَدْ زِدْتُ فِي فَرْضِ الأَمَانِي عَلَى بَانِي",10,"ن",2,0],["وَآمُلُ أَنْ لاَ أَسْتَفِيقَ مِنَ الْكَرَى","إِذَا الْحُلْمُ أَوْطَانِي بِهَا تُرْبَ أَوْطَانِي",11,"ن",2,0],["وأمْلاكُ صِدْقٍ إنْ عَرا الناسَ رائِعٌ","منَ الخطْبِ جَدّوا أو عَرَتْ أزْمَةٌ جادُوا",12,"د",3,0],["وآمُلُ لُطْفَ اللهِ فِيهِ فإنّه","أبَرُّ بميثاقٍ وأوْفَى بقِسْطاسِ",13,"س",1,0],["وَاِملَئوا البَحرَ إِن أَرَدتُم سَفيناً","وَاِملَئوا الجَوَّ إِن أَرَدتُم رُجوما",14,"م",2,0],["وَأَملى عَلَيها الدَهرُ حَتّى تَرَبَّعَت","بِها الخُنسُ آجالُ المَها وَفَريُدها",15,"د",3,0],["واملكْ من العمرِ المؤيدِ خلعةً","ما تنتهي في العين حتى تبتدي",16,"د",2,0],["وأمَّلت أن تجلي عليَّ كنافةٌ","وأحسن ما تجلى الكنافة في صدر",17,"ر",1,0],["وأملأ أوصال الدروج رسائلاً","فتبخل هاتيك الشمائل بالوصل",18,"ل",1,0],["وأمّلت من إنعام أحمد مسلياً","فناجيت وجه النجح من صحة الوهم",19,"م",1,0],["وأمَّلت برّك دون الورَى","زمان يديْ عنهمُ نائيه",20,"ي",2,0],["واملك عليه جماح نفسك إنها","تأبى من المعروفِ غيرَ جزيلِهِ",21,"ل",2,0],["وَآمَلُ أَنّي إِن أَعِش لَكَ مُدَّةً","سَتَبقى لَكَ الأَيّامُ في طَيِّبِ الذِكرِ",22,"ر",1,0],["واملإِي الوادي ثُغاءً","ومِراحاً وحُبُورْ",23,"ر",1,0],["وَأَملَحَ الأُذنَ في الاِستِرسالِ","كَأَنَّها دائِرَةُ الغِربالِ",24,"ل",1,0],["وَاِملَأ رِماحاً غَورَها وَنَجدَها","وَاِفتَح أُصولَ النيلِ وَاِستَرِدَّها",25,"د",3,0],["وآمُلُ بُرءاً من جوىً خامرَ الحَشى","وكيف بداءٍ لا يراهُ طبيبُ",26,"ب",1,0],["وَآمُلُ دَولَةَ الأَيّامِ حَتّى","تَجيءَ بِما أُؤَمِّلُ أَو أَموتُ",27,"ت",1,0],["وَأَمَّلَ المَكروهَ في غَيرِهِ","فَنالَهُ مَكروهُ آمالِهِ",28,"ل",2,0],["وَأَمَّلَ الثَلجَ وَالجَوزاءَ مُلهِبَةٌ","في ناجِرٍ ساءَ هَذا الظَنُّ وَالأَمَلُ",29,"ل",1,0],["وَآمُلُ مِن حَسَنٍ رَجعَةً","بِعَدلِ الوَزيرِ وَإِحسانِهِ",30,"ن",2,0],["وأملَقَهُ وَشْكُ الفِراقِ فَدَمعُه","طريدُ هوىً في صَفْحَةِ الخَدِّ يَعلَقُ",31,"ق",1,0],["وآمُلُ أن يَجلو لذي اللُّبِّ بعدَما","ترَشَّفَهُ ذو الجَهْلِ حُلْوَ المَراشفِ",32,"ف",1,0],["وآمل أن تدنو الديار وشخصكم","بقلبي وطرفي قاب قوسين أو أدنى",33,"ن",2,0],["واملُكْ على جُندِ الملائكِ أمرَها","فَلأنتَ رَبُّ الجُندِ والأعلامِ",34,"م",1,0],["وَاملأ السّمْعَ مِن محَاسِنَ يُمْلِي","هَا عليك الإنشَادُ وَالإِنْشَاءُ",35,"ا",2,0],["وَأَملاكُ صِدقٍ أَلبَسَتني طِرازَهُم","قَصَائِدُ ما لي غَيرُهُنَّ شَفيعُ",36,"ع",1,0],["وَأَملاكٌ وَهَبتُ لَهُم ثَنائي","وَلَيسَ كَزاخِرِ النيلِ الثِمادُ",37,"د",1,0],["وَأَملاكٌ تُجَرَّأُ في غِناها","وَإِن وَرَدَ العُفاةُ فَهُم سَرابُ",38,"ب",1,0],["وَأَملَسَ صولِيّاً كَنَهيِ قَرارَةٍ","أَحَسَّ بِقاعٍ نَفحَ ريحٍ فَأَجفَلا",39,"ل",2,0],["واملأوا الأرضَ والسماءَ هُتافاً","عَلَّهُ لم يَرَ الصباحَ فنامَه",40,"م",2,0],["واملأ من الزهر المنور والجنى","كفيك واطرح عبئك الفداحا",41,"ح",2,0],["وَأُمٌ لأَحْلاسِ الْحُرُوبِ وَأُمَّةٌ","خَلِيقٌ بِهَا أَنْ تُتْبِعَ النَّصْرَ بِالنَّصْرِ",42,"ر",1,0],["وَاِملِك عَلى مَن كانَ قَبلَكَ شاؤُهُ","في فَرطِ تَقريبي وَفي إِيناسي",43,"س",2,0],["وَأَمَّلتُ الجَوابَ وَلَستُ أَدري","بِأَنَّ المَوتَ يَأتي في الجَوابِ",44,"ب",1,0],["وامْلأْ جُفونَكَ بالكَرَى في غِبْطةٍ","قد كنتَ أَحوجَ ساهدٍ لرُقاد",45,"د",1,0],["وأمليتَ دُسْتُوراً شَقِينا بتَرْكِه","فَثُرنا على الأيام نشكو ونعتبُ",46,"ب",1,0],["وامْلأ الأُفْقَ بالنَّشيدِ تُرَدِّدْ","رَجْعَ أنغامِهِ جميعُ النَّواحي",47,"ح",2,0],["واملأ البَرَّ، واملأ البحرَ، يا عي","د سلامًا؛ فأنتَ رمزُ السلام",48,"م",1,0],["واملئي كل مُسمع بأزيزٍ","هو أشجى من رنة الألحان",49,"ن",1,0],["واملئوا غارِب العُبَاب سفِينًا","ثم غُوصوا في جوفهِ حيتانا",50,"ن",2,0],["وأمْلاَكٌ وَهَبْتُ لَهُمْ ثَنَائِي","ولَيْسَ كَزَاجِرِ النِّيل الثِّمَادُ",51,"د",1,0],["وأملاكٌ تُجزّأُ في غناها،","وإن ورد العُفاةُ، فهم سَرابُ",52,"ب",1,0],["واملأوا هذه السجون إلى أن","تشتكي من ضيوفها الازدحاما",53,"م",2,0],["واملأو الأرض والسّماء هتافا","عله لم ير الصّباح فنامه",54,"م",2,0],["واملأ بفضل دلوا","مالي إلى عقد الكرب",55,"ب",1,0],["وَأَملاكٌ أَبادوا ما أَبادوا","مُضاعاً في القَناني وَالقِيانِ",56,"ن",1,0],["واملأ بها عرض الفيافي وانتصف","ممن بغى الإِفساد في بعض القرى",57,"ر",2,0],["واملأ بجيشك أرض من ضلَّ الهدى","واضرب بسيفك رأس من يتجبرُ",58,"ر",1,0],["وإملاءاتُ سامٍ حَدُّ سَيْفٍ","هو \" الأنْكِلْ \"يُبَدِّدُنا بِحيْفٍ",59,"ف",1,0],["وأملكُ شوقي أنْ يذيبَ جوانحي","ولي من جفونِ المالكيةِ مالك",60,"ك",1,0],["واملكْ سبيلَ لصبحِ فالحيُ إنْ","ناحتْ حمامٌ حسبوني الحمامْ",61,"م",1,0],["واملأ فؤادكَ رحمةً لذوي الأسى","لا يرحم الرحمنُ من لا يرحمُ",62,"م",1,0],["وَأَملِ تَعاليمَ الحَياةِ عَلى المَلا","فَإِنَّ يَدَ الأَجيالِ تَكتُبُ ما تَملي",63,"ل",2,0],["وَأَمَّلتُ حتى قيلَ ليسَ بخائِفٍ","من اللَهِ أن تَشوي الوجوهَ جهنَّمُ",64,"م",1,0],["وَأَملَأُ بِالآمالِ صَدري فيكُمُ","فَأَرجِعُ عَن أَبوابِكُم بِيَدٍ صِفرِ",65,"ر",1,0],["وَأُمٌّ لَم يُحَصِّنَها حَصاناً","أَبوكَ فَأَفرَخَتكَ عَلى الإِباحَه",66,"ح",2,0],["واملأ فؤادكَ من نَعِيمٍ زائلٍ","وامنَع جُفونَكَ أن تذوقَ كراها",67,"ا",3,0],["وأمل الى حرم الامين صدورها","فاذا بدا الحرم الامين فميم",68,"م",1,0],["وأَمَّلْتُ بالشكرِ المزيدَ من الرِّضى","وأَيّةُ نُعْمَى كالرِّضى تتزَيّدُ",69,"د",1,0],["واملأ مسامعهم بصيحة شاعر","فتحت يداه الخلد للشعراء",70,"ا",2,0],["واملئ كأسيَ من صفوِ المدام","واملئى كأسك من خمرِ التمنّى",71,"ن",2,0],["واملىء الليل غراماً من عيون وشفاه","إنّما نحن على الدنيا رحيق وشذاه",71,"ه",1,0],["واملأ الجوّ قبلات مغردة","ذوّبت في سحرها يا منيتي افاك",72,"ك",1,0],["واملأ الدنيا حنيناً وجوى","وفم الدهر مديحاً وثناء",73,"ا",2,0],["وآمُلُ من شُمولِ العَدلِ أنّي","أُعانُ على عجائبِ ما أُعاني",74,"ن",2,0],["وآمُلُ عنها أن أعودَ بجاهِها","على أثَرِ الإحرام في زيّ إكرام",75,"م",1,0],["وأمّلْنا برِيقتها شِفاءً","فأعْدتْنا بمُقْلتها سَقاما",76,"م",2,0],["وآمُلُ أن يَسْري الكرى بخيالِهم","وما كان جَفني بعدَهم لِيُغَمّضا",77,"ض",2,0],["وامْلأْ يداً منه وعَيْناً إنّه","بحْرُ النَّدى كَرماً وبَدْرُ النّادي",78,"د",2,0],["وأَمَّلتُ نَفعَ الكَتمِ فيهِ مُغالِطاً","غَليلي وَلَكِن قَلَّما نَفَعَ الكَتمُ",79,"م",1,0],["وَأُملي غَرامي لِلنَسيمِ رِسالَةً","فَهَل قالَ ما أَملَيتُهُ لَكُمُ أَم لا",80,"ل",2,0],["وَأملَّ سَقي عَوَّدي إِذا يَأست","مني الطَبيب وَطبهُ أَدوائي",81,"ا",2,0],["واملأْ سجونك ، ثم قُلْ :إني هنا","لأحارب الإرهابَ والتقطيعا",82,"ع",2,0],["وأمَّل العاذلون صبري","يا بُعْد ما أمّلوا ورامُوا",83,"م",3,0],["وَآمُلُ عَطفَكَ بعدَ الجفاءِ","وَ قَسوةَ قَلبِكَ لي أَن تَلِينا",84,"ن",2,0],["وأمَّلْتُ فيه النفع فيما يَسُرُّني","وقد سامني ضرٌّ وقد ساءني دهر",85,"ر",1,0],["وأمْلَيْتَ ما حارتْ عقولُ الورى به","وأصْبَحتِ الأَقلام تكتبُ ما تُملي",86,"ل",2,0],["وامْلأْ لنا أكبَر أقداحها","فالله يعفو عن ذنوبٍ كبار",87,"ر",1,0],["وأمَّل مجده فغدا كليلاً","ورام بلوغ همّته فأكدى",88,"د",2,0],["وآمل البذل قد أمسى بلا أملٍ","وخائف الدهر لم يستجد أنصارا",89,"ر",2,0],["وأملت علينا من محاسن أهلها","صحائف لا زالت يطالعها الفكر",90,"ر",1,0],["وأمل كاسا من الحديث وزدني","بحديث عن المها والغزال",91,"ل",1,0],["وأُمْلي عَلَى الأَيَّامِ آثارَ مُنْعِمٍ","عَلَيَّ بِعَيْنِ المَكْرُمَاتِ أَمَلَّها",92,"ل",3,0],["وَأملنا نقاضيها صلاحا","ونجزيها جزاء المحسنات",93,"ت",1,0],["واملينا عليه نص","عهد غير عهدهم",94,"م",1,0],["وأمَلَّتْ في الدَوْح مستحِراتُ الط","طَيرِ لحنَ الغَريض في أَرماله",95,"ل",2,0],["وأمَّلَتْ حمائُم الدَوْحِ ألحا","ناً أمالَتْ معاطِفَ الأغصانِ",96,"ن",1,0],["وأملأ العين من ألوان خمرته","كأنني شارب أكواب رضوان",97,"ن",1,0],["واملِلْ بجودك أهواءً موزَّعَةً","حتى تفيءَ لإذعانٍ وإقرارِ",98,"ر",1,0],["وأمَّلْتُ عود الصبح منك بلقْيةٍ","وصبحك قد سُدَّتْ عليه المطالعُ",99,"ع",1,0],["وأمَّلتُ ما فاتني منهُ فيك","مماتَ العدى وحياةَ الحسد",100,"د",1,0],["وأملتُ نعماهُ فلمَّا بلوته","بليتُ بممنون الندى مقرِ الورد",101,"د",1,0],["واملأ وطابك بالمعارف إنها","أس العلا واربأ عن الجهل الردي",102,"د",2,0],["وأمَّلَ مِنِّي القومُ في كُلِّ مَشهدٍ","من الواردِ الهَطَّالِ غَرْفَةَ غارفِ",103,"ف",1,0],["واملئي قلبه نو","راً بدا من طلعتك",104,"ك",1,0],["وأَمَلي في بُرئِها وطيدُ","وضيقُ صَدري لِىَ لا يَعودُ",105,"د",1,0],["وآمُلُ أنّي أفوتُ الحِمامَ","أمانٍ لعَمْرُك لِي ضُلَّلُ",106,"ل",1,0],["وَأُمُلٍ مَوصُولَةٍ بأمُلِ","تَنحى بِطولِ أَحبُلٍ وَأَحبُلِ",107,"ل",1,0],["واملئُوا أَصْداغَه قَلقاً","وافْتَحوا أَجْفانَه سَهَرا",108,"ر",2,0],["وأَمْلَى عِتاباً يُستَطابُ فلَيْتَني","أَطَلْتُ ذُنُوبِي كَيْ يَطولَ عِتَابُه",109,"ب",2,0],["واملأَنَّ التاريخ مجداً وفخراً","وانشُرنَّ الآثار فيه طُيوبا",110,"ب",2,0],["وَأَمَّل أَن تَبقى لِمصر وَأَهلِها","مَدى الدَهر مَسروراً بِجَيشٍ مؤيد",111,"د",1,0],["وَأَمَّلت مِنهُ نَظرةً في قَضيةٍ","بِها يَنجلي عَني سَحاب الغَياهب",112,"ب",1,0],["واملاَ الصغيرَ بعدهُ وهذي","تعودُ للأولى بلاَ انتباذ",113,"ذ",1,0],["وأملأُ الصَّدْرَ من أنْفاسِها كَلفاً","بِما أشُمُّ بها من طِيْبِ رَيَّاكِ",114,"ك",1,0],["وأملأ يومي صلاحا وبرّا","على سبل حق بغير التواء",115,"ا",1,0],["وآمُلُ من دَمعِي إلاَنَةَ قَلْبِهِ","ولا أَثَرٌ لِلْغَيْثِ في الحَجَرِ الصَّلْدِ",116,"د",1,0],["وأملأ الأرض نوراً من محامدهم","وإنني في زوايا الريف محتجب",117,"ب",1,0],["واملأ الواديَ بشراً ورضاً","لوفود الشكر من قاص ودان",118,"ن",1,0],["وَاِملَأ كؤُوسَ الصفوِ أُنساً وارتشِفْ","خَمرَ المَسرَّةِ مِن شِفاهِ الأَكؤسِ",119,"س",1,0],["وآمل يوماً أن تطيب جَناتُها","لقد شربت صرفا من الصبر ماهلا",120,"ا",1,0],["وامل شجوى على الحمام وطارح","بلبل الدوح واتخذه وسيلا",121,"ل",2,0],["وَأمَّلْنَا مَرَاحِمَكُم فَجُرتُم","فَهَلاَّ يَا قُضَاةُ رَحِمْتُمُونَا",122,"ن",2,0],["وَأمَّلْتُ جَدْوَاكَ المُرَجَّى نَوَالُهَا","وَمَا الآمِلُ الرَّاجِي نَدَاكَ بِخَائِبِ",123,"ب",1,0],["وَآملُ فضلاً ليس يدرك كونه","وَهل ردّ شخب الضرعِ في الضرع حالبُه",124,"ب",2,0],["وَاِملِك جَميعَ الأَرضِ فَهيَ وِراثَةٌ","وَإِلَيكُمُ بِالفَتحِ يُسنَدُ أَمرُها",125,"ر",3,0],["واملأ غد الدنيا وزيّن","بالأساطير العذاب",126,"ب",1,0],["وأملّي العين بالأل","وان من كل أصيل",127,"ل",1,0],["واملأ الدنيا بما عودتها","من حنين وابتهال ودعاء",128,"ا",2,0],["وَأَملأ عَيني مِن مَحاسن وَجهِها","وَأَشكو إِلَيها أَن أَطالَت عِتابها",129,"ب",3,0],["واملاهما ماءً نظيفاً طاهرْ","في كل يوم فيه تصحو باكرْ",130,"ر",1,0],["وأملكنَّك قاطنيّ الأرض قا","طبةً فترعاهم رعايةَ عادلِ",131,"ل",1,0],["واملأت هذا القطر أمناً وراحةً","وبددت عنه غيهب الهم فانجلى",132,"ل",2,0],["وأملاً آفاق السماء شكاية","وإن كنت أدري أن ذلك لا يجدي",133,"د",2,0],["واملأ بصاعقة الضبا","وجه البسيطة بالرجيف",134,"ف",1,0],["وأملت أياما تنوب ورجعة","من الدهر يأتينا بها اللَه في غد",135,"د",1,0],["واملأ السمع من مدايح فيه","واطلب المنشدين حسن ازدياد",136,"د",1,0],["واملو رضاكم واعلا","وابشروا بقصدكم واغلا",137,"ل",2,0],["وامّل حسن الرفد منك ولم يكن","بأهل لنيل من جميل ثوابكم",138,"م",1,0],["وأملت الحمايه من لدنه","واسعافي من الفضل العظيم",139,"م",1,0],["واملت برا منك يا بر أصطفى","به والعلا أعلوا واسعد بالسعد",140,"د",1,0],["واملت يهمى فيض فضلك دائما","على واحظى بالسماحة والود",140,"د",1,0],["واملت إكراما يليق بفضلكم","يعممني والوالدين ومن بعدي",140,"د",2,0],["واملت من احسانك اللَه رحمة","أفوز بها بالفوز في جنة الخلد",140,"د",1,0],["واملت النجاح وقلت ربي","اغثن وارحمني بالنوال",141,"ل",1,0],["واملأ الجسم هواء","وفقاقيعَ وسعلا",142,"ل",2,0],["وأَمَّلْتُ منه أن يُسَكِّنَ لوْعتي","فهيَّجَ بَلبالي وزادَ تلهُّبي",143,"ب",2,0],["وامل التمييز والمعمول في","تعجّب وفي توابع يفي",144,"ي",1,0],["واملأ بحبك قلبي واجتذب رمقي","من بين أبحر أوهامي وغفلاتي",145,"ي",1,0],["وأملي المزيد من يداه","بحق لا إله إلا اللّه",146,"ه",1,0],["وأملأ خطاك وقاراً","واملأ حديثك جدا",147,"د",2,0],["وَأَملاك الرِضا تَجري لِشان","وَتَأتيهِ يا رَزاق حسان",148,"ن",1,0],["وَأَملاك بِأَفلاك تَجول","ضَريح لِلدَخيل أَعَز حُصن",148,"ن",1,0],["وأملح ذاده عن عذب مورده","جور الزمان وظام عز مشرعه",149,"ع",2,0],["وَأَمِّلْ أَمِيرَ الْمُسْلِمِينَ مُحَمَّداً","تَجِدْ خَيْرَ مَأْمُولٍ وَأَكْرَمَ مُنْجِدِ",150,"د",1,0],["وأملني طول التصرف أنني","أبصرت بخس الحق في استمرار",151,"ر",1,0],["واملأُ نفوس الشاهدين جلالةً","وانقَعَ من الشعب المَشُوق غليلا",152,"ل",2,0],["واملأ السمع لذةً بقوافٍ","صاغها الشعر في بني مرداس",153,"س",1,0],["وَاِملَأ سَماءَ الشِعرِ أَلحاناً وَلا","تَكُ في وُجومِكَ كَالغُرابِ الأَسفَعِ",154,"ع",1,0],["واملأ الكائنات قسطاً وعدلاً","إنما الشرك منهما أخلاها",155,"ا",3,0],["واملئوا القَلبَ رحمةً ويقينا","تُبعِدُه عن غلظةِ النَّهمَانِ",156,"ن",1,0],["واملؤا القلبَ رحمةً وحناناً","ويقيناً إيمانُهُ لا يرُاء",157,"ا",