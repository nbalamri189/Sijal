,0],["واملأي الوديان من ذوب السما","بمُسِحٍّ كصبيب القرب",264,"ب",1,0],["وامْلأْ فؤادَكَ - ما حيِيتَ - بحُبِّهِ","واجْعَلْهُ دوْماً في الطّريقِ الرّايَةْ",265,"ا",3,0],["وَ امْلأْ عُيُونَكَ بِالضِّيَا","تَلْقَ الرِّيَاضَ الزَّاهِرَةْ",266,"ر",2,0],["وأملا الأيدي بالأيادي فانا","قد بسطناها نطلب الانفالا",267,"ل",2,0],["وأمْلّتْ آمالاً طوالاً عريضةً","فما خِلتُ أن تَبلى وتبقى بليتي",268,"ي",1,0],["واملأ ( صفا ) الأرواحِ ( مروة ) طهرِها","سعياً يفيضُ مودةً وصفاءَ",269,"ا",2,0],["وأملاك تخالطهم ودين","فراتيٌّ نميريٌّ هداء",270,"ا",2,0],["وأمْلي على الريح تلمس ثوبي","فَيَشْبَعُ باللمسِ عِنْديَ حُلْمُ",271,"م",1,0],["وآمَلُ منهنَّ يعرفْنَ أني","بعهدِ الوفاء سأبقَى مُلِمَّا",272,"م",2,0],["وأملكُ إرسالاً على الفور طارِداً","لأنواعِ الاستقبالِ مهما دعانيا",273,"ي",2,0],["واملأي الأشداق فخراً إنما","أنت من أذقاق كل تضحكين",274,"ن",1,0],["وأملتُ في زمنٍ يمرُ بنا","وكبارُنا فيه قد اتفقوا",275,"ق",3,0],["وأملأ قلبكَ الموهوم ..حباً","لتدرك بعد صدقي ..وهمَهنّ",276,"ن",1,0],["وامْلَئِي أَفْواهَ القَذارَةِ رُغْماً","بِرُجومٍ مِن الحصَى والطِّينِ",277,"ن",1,0],["واملأ فؤادك بالآمال إن لها","سحرا يسير إلى الآلام يشفيها",278,"ي",3,0],["واملأ فؤادك بالآمال إن لها","يوما إذا قدر الرحمن إشراقا",279,"ق",2,1],["واملأ النفس من شذاه عبيراً","واملأ الروح من صداه ملاحنْ",280,"ن",1,0]]}