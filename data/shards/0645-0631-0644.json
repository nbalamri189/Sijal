{"poems":[[93,"مازال يمشي في الأمور بفكره","https://www.aldiwan.net/poem62771.html","عموديه"],[71,"مربع يخلو ودمع يكف","https://www.aldiwan.net/poem28817.html","الرمل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[113,"وغزال كناسه المران","https://www.aldiwan.net/poem16387.html","الخفيف"],[463,"ياابنة القوم تراك","https://www.aldiwan.net/poem56083.html","مجزوء الرمل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17112","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204659","الرمل"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99498","الرمل"]],"verses":[["مُر لي بِزاوِيَةٍ أَزُجَّ بِمُهجَتي","فيها وَإِن تَكُ مِن حَميمٍ آنِ",0,"ن",1,0],["مرَّ لي فيه زمانٌ أهلاً","ثم أضحى وَهْوَ قاعٌ صفصفُ",1,"ف",1,0],["مَرَّ لَم يُكتب عَلَيهِ سَيّئٌ","فَنَجا مِن تَبِعاتٍ وَعَلَق",2,"ق",1,0],["مر لي بِالشَئام وَالشَوق غُصن","وَشَبابي يَزينهُ العُنفُوانِ",3,"ن",1,0],["مرَّ لا أرهفَ عينَي","كِ ولا أرشفَ فاكِ",4,"ك",1,0],["مَرَّ لي بَعضُها بِفِقهٍ وَبَعضٌ","بَينَ شِعرٍ أَخَذتُ فيهِ وَنَحوِ",5,"و",1,0],["مر لا ينزل في الدرب اليه","طارئ حتى مرور الجحفل",6,"ل",1,0],["مر لي في العمر يومً","لا أجازيه بشكر",7,"ر",1,0]]}