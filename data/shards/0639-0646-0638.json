{"poems":[[95,"في ذمة الله وفي عهده","https://www.aldiwan.net/poem11143.html","السريع"],[133,"حدث الشاعر عن نور القمر","https://www.aldiwan.net/poem60382.html","الرمل"],[463,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25345","الرجز"],[1586,"","https://poetry.dctabudhabi.ae/diwan/poem/96342","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126967","الرمل"],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5952,"عاشوا","https://www.poetsgate.com/ViewPoem.aspx?id=211568",""]],"verses":[["عَنْ ظَالِمِ القَاصِدِ فِي حُكْمِهِ","وَفَاطِمِ المَاجِدِ عَنْ مَجْدِهِ",0,"د",2,0],["عن ظلامِ العَيشِ عن سجنِ البقا","عن فَيافي التيهِ عن ظُلمِ القَدَر",1,"ر",1,0],["عن ظبيةٍ جائزة","تنشُد من وصلي طَلاَ",2,"ل",2,0],["عَنْ ظَهْرِ عُرْيان المَعَارِي أَعْمَقا","أَمَقَّ بِالرَكْبِ إِذَا تَمَقَّقا",3,"ق",2,0],["عن ظهر أجرد سابح ذي ميعة","نقل إذا ما خالط الاجر الا",4,"ل",2,0],["عن ظما كم فتية منكم قضت","وخيام لكم قد قوضت",5,"ت",1,0],["عن ظلمة الفرع من فوق الجبين وللض","ياء سبح طويل في دياجيها",6,"ي",3,0],["عن ظلالٍ لا كأصحابٍ لها","عن مقيمِ الحد لكن ما استقاما",7,"م",2,0]]}