 تلو النياق لحاسا","https://www.aldiwan.net/poem37995.html","الكامل"],[501,"ليل المحب إذا تطاول بالسهر","https://www.aldiwan.net/poem38019.html","الكامل"],[501,"خذ شهودا عن شهود الكائنات","https://www.aldiwan.net/poem38068.html","الرمل"],[515,"خلط الغرام الشجو في أمشاجه","https://www.aldiwan.net/poem20829.html","الكامل"],[516,"صرف النسيب إلى اللوى وزرود","https://www.aldiwan.net/poem12082.html","الكامل"],[528,"وإذا ابتدهت بديهة يا سيدي","https://www.aldiwan.net/poem46006.html","الكامل"],[552,"خلها إنها تريد الغميما","https://www.aldiwan.net/poem47231.html","الطويل"],[552,"اسعد سعدت بساعة التحويل","https://www.aldiwan.net/poem47276.html","الكامل"],[552,"قل للنوائب قد أصبت المقتلا","https://www.aldiwan.net/poem47316.html","الكامل"],[552,"قد كان يدرك عندكن السول","https://www.aldiwan.net/poem47333.html","الكامل"],[552,"لا توعدني الشر ترهبني","https://www.aldiwan.net/poem47817.html","أحذ الكامل"],[552,"بالله يا أيام يثرب عودي","https://www.aldiwan.net/poem47844.html","الكامل"],[552,"أجر المدامع كيف شيتا","https://www.aldiwan.net/poem48033.html","مجزوء الكامل"],[559,"يا نسيم الحي عني","https://www.aldiwan.net/poem33633.html","مجزوء الرمل"],[559,"في امتزاج الوجود بالعدم","https://www.aldiwan.net/poem33871.html","الخفيف"],[559,"قل لعباد الخيال","https://www.aldiwan.net/poem34200.html","مجزوء الرمل"],[559,"إن قولي مؤيد بالنقول","https://www.aldiwan.net/poem34243.html","الخفيف"],[559,"أنا كالحرف قائم بالمداد","https://www.aldiwan.net/poem34616.html","الخفيف"],[563,"ماذا يؤمله الحسود بجهده","https://www.aldiwan.net/poem52870.html","الكامل"],[565,"لو سلمنا من العمائم طراً","https://www.aldiwan.net/poem870.html",""],[576,"هيهات ما حالي كحالك","https://www.aldiwan.net/poem3043.html","مجزوء الرمل"],[576,"إن أكن أشجعا فأنت الرشيد","https://www.aldiwan.net/poem3083.html","الخفيف"]],"verses":[["وَإِذا قَرَعتُ فَهُم صُدورُ ذَوابِلي","وَمِنَ العَدوِّ مَعاقِلي وَكُهوفي",0,"ف",2,0],["وَإِذا قُلتُ يَنزِعُ الدَهرُ ناباً","مِن بَقايا ذَوِيَّ أَعلَقَ ظُفرا",1,"ر",2,0],["وَإِذا قَدَرتَ عَلى الوَفا","ءِ فَعَدِّ عَن غَدرٍ وَذَيبِه",2,"ب",2,0],["وَإِذا قُلوبٌ لَم تَكُن كَعُيونِنا","لَم يُغنِنا أَنَّ النُجومَ ثَواقِبُ",3,"ب",1,0],["وَإِذا قَلَّبَ الزَمانَ لَبيبٌ","أَبصَرَ الجَدَّ حَربَ عَقلٍ وَلُبِّ",4,"ب",1,0],["وإذا قطَعْتَ زَمانَهُ في كُرْبَةٍ","ضيّعْتَ في الأوْهامِ ما لا يرْجِعُ",5,"ع",1,0],["وَإِذَا قَضَيْتَ حَوَائِجِي وَأَرَيْتَنِي","أَمَلاً فَرَبُّكَ مَا أَرَدْتَ يُرِيكَا",6,"ك",2,0],["وإذا قبّلَها شارِبُها","قطّبَ الوجْهَ لَها وانْكَمشا",7,"ش",2,0],["وَإِذَا قُرَاهَا العَامِرَاتُ وَرَوضُهَا","يُقْوِينَ مِنْ حُسْنٍ وَمِنْ عُمْرَانِ",8,"ن",1,0],["وإذا قلت أنكم أنتم النا","س جميعاً فلا أكون المُغالي",9,"ل",2,0],["وَإِذا قَرُبنَ خَوامِساً مِن صَلصَلٍ","صَبَّحنَ دومَةَ وَالحَصى لَم يَرمَضِ",10,"ض",1,0],["وَإِذا قُرَيشٌ حُصِّلَت أَنسابُها","فَبِآلِ شِجعٍ فَاِفخَروا في المَجمَعِ",11,"ع",1,0],["وإذا قلَّتِ الفِلاحة في الأر","ضِ فعتبُ الفتى على الرُّؤساء",12,"ا",2,0],["وإذا قامت إلى مَلعبها","كمَهاةِ الرمل في رَبْرَبِها",13,"ب",3,0],["وإذا قال رسول ال","لَهِ مدّ الصوت مدّا",14,"د",2,0],["وإذا قام قائلُ الشعر أرسَلْ","تَ إليه مع اللُّهى تسديدَكْ",15,"ك",1,0],["وإذا قَدَرْتَ على المظالم فانزجِرْ","أوْ لا ففي الغِيرِ الحوادث زاجر",16,"ر",1,0],["وإذا قادرٌ تعرَّى من الحِل","مِ غدا في قميصه الفَضْفاض",17,"ض",1,0],["وإذا قد سلّموا المجد لكم","فحمى الحالبُ دوني لَبَنه",18,"ن",2,0],["وَإِذا قَضى أَمراً فَلَيسَ لِحُكمِهِ","بَينَ المَمالِكِ وَالشُعوبِ مُعَقَّبُ",19,"ب",1,0],["وَإِذا قُرَيشٌ أَوقَدَت نيرانَها","وَثَنَت ضَغائِنَ بَينَها وَذُحولا",20,"ل",2,0],["واذا قوة الارادة جلت","جل فيهم تأثيرها المعنةي",21,"ي",1,0],["واذا قصرّ القريض فدمعي","لك يغني عنه لدى الاهراق",22,"ق",1,0],["وَإِذا قَضَيتَ فَلا اِرتِيابَ كَأَنَّما","جاءَ الخُصومَ مِنَ السَماءِ قَضاءُ",23,"ا",2,0],["وَإِذا قَدَّروا الكَواكِبَ أَربا","باً فَمِنكِ السَنا وَمِنكِ السَناءُ",24,"ا",2,0],["وَإِذا قيلَتِ القَوافي تَهاوى","رَجَزٌ مِن بُيوتِها وَقَصيدُ",25,"د",1,0],["وَإِذا قَسَطتَ عَلى العَزيزِ صَغا بِهِ","ذُلٌّ إِلَيكَ وَطاعَ غَيرَ مُعانِدِ",26,"د",1,0],["وَإِذا قُرَيشٌ فاضَلَتكَ فَضَلتَها","بِأَبي خَلائِفِها وَعَمِّ رَسولِها",27,"ل",3,0],["وإذا قِسْتُ هجرَكَ المُرَّ بالدَّهْ","رِ وما قد جَناه كان أشَدَّا",28,"د",2,0],["وإذا قُوِّمَتْ رؤوسُ المطايا","للسُّرى قُوَّمَت من الأذنابِ",29,"ب",1,0],["وَإِذا قَنِعتَ فَأَنتَ أَغنى مَن مَشى","إِنَّ الفَقيرَ لَكُلُّ مَن لا يَقنَعُ",30,"ع",1,0],["وإذا قال نعم وهي له","عادةٌ أسبغَ بالبذل النِّعَم",31,"م",1,0],["وَإِذا قيلَ مَن تُحِبُّ تَخَطّا","كَ لِساني وَأَنتَ في القَلبِ ذاكا",32,"ك",2,0],["وَإِذا قالَ مَقالاً جِئتُهُ","وَإِذا قُلتُ تَأَبّى وَظَلَم",33,"م",1,0],["وإذا قَضَى أمراً فما لقضائهِ","رَدٌّ ولا في غيرِهِ مُتعلَّلُ",34,"ل",1,0],["وَإِذا قُلتُ اِركَبوا قَد حَضَروا","جُملَةُ الناسِ بِأَسيافٍ حِدادِ",35,"د",1,0],["وَإِذا قابَلَ بِالنِص","فِ مِنَ الجَردَقِ نِصفا",36,"ف",2,0],["وَإِذا قُلتُ لَها جودي لَنا","خَرَجَت بِالصَمتِ عَن لا وَنَعَم",37,"م",1,0],["وَإِذا قَرَنتَ بِلامِ مِلكٍ مُضمَراً","فُتِحَت بِهِ فَكَأَنَّها لَم تُكسَرِ",38,"ر",1,0],["وَإِذا قَطَعتَ رُؤوسَ تِلكَ فَجائِزٌ","يَوماً تَراجُعُها بِحُكمٍ جاري",39,"ر",2,0],["وَإِذا قامَت تَداعى قاصِفٌ","مالَ مِن أَعلى كَثيبٍ مُنقَعِر",40,"ر",1,0],["وَإِذا قَصَدتَ لِحاجَةٍ","فَاِقصِد لِمُعتَرِفٍ بِقَدرِكَ",41,"ك",1,0],["وَإِذا قامَ سوقُ حَربِ العَوالي","وَتَلَظّى بِالمُرهِفاتِ الصِقالِ",42,"ل",1,0],["وَإِذَا قَرَأْنَا وَصْفَهُ فَكَأَنَّهُ","بِدَمٍ زكِيٍّ خُطَّ لاَ بِمِدَادِ",43,"د",1,0],["وَإِذَا قَضَى يَوْماً قَضَاءً عَادِلا","ضَرَبَ الأَنَامُ بِعَدْلِهِ الأَمْثَالاَ",44,"ل",2,0],["وَإِذَا قَضَى أَمْضَى فَمَا مِنْ حَائِلٍ","دُونَ القَضَاءِ وَمَا لَهُ مِنْ دَافعِ",45,"ع",1,0],["وَأَذاقَت بَعدَ العِلاجِ لَذيذاً","كَجَنى النَحلِ شابَ صِرفاً عُقارا",46,"ر",2,0],["وَإذَا قَذَفْتَ لَهُ الْحَصَاةَ رَأَيْتَهُ","يَنْزُو لِوَقْعَتِهَا طُمُورَ الأخْيَلِ",47,"ل",1,0],["وإذا قيل جفا من سلوة","قلت : لا أسلو وإن عاف وصّدا",48,"د",2,0],["واذا قسوت على العروبة مرة","فلقد تضيق بكحلها الاهداب",49,"ب",1,0],["وإذا قال رسول الل","ه مدا الصوتَ مدا",50,"د",2,0],["واذا قلت اين داري قالوا","ما لمن غاب الفه من مكان",51,"ن",1,0],["واذا قلد الكرام بفعل","من فعال الكرام بالسر يندم",52,"م",1,0],["واذا قاطع الكريم لئيم العلب","ع عن غير موجب لا يلام",53,"م",1,0],["واذا قصرت النفع تعلو قاصرا","عن مجد ذي النفع العميم وحاله",54,"ل",2,0],["واذا قام بالظهور كريم","ناله من بني الفجور نكالا",55,"ل",2,0],["وإذا قلتَ نعمْ فاعملْ بها","إنما العاقلُ إن قال فَعَل",56,"ل",1,0],["وإذا قال خليّ أعرضوا","أو يقولوا ليس ذا إلاّ اختلاقْ",57,"ق",1,0],["وَإِذا قيلَ اِركَبوا قَد","غَلَبَ الجِدُّ المُزاحا",58,"ح",2,0],["وَإِذا قَرَأتَ كَلامَهُ قَدَّرتَهُ","سَحبانَ أَو يوفي عَلى سَحبانِ",59,"ن",1,1],["وَإِذا قُربُكَ لَم تَنفَع بِهِ","في حِمى قَومِكَ فَأذَن بِبِعادِ",60,"د",1,0],["وَإِذا قُبلت فبدرُ سعدك مشرقُ","وَعُصمتَ مِن نارٍ تشبّ فتحرقُ",61,"ق",1,0],["وَإِذا قَضى فَصلُ القَضاءِ فَلَم تَمِل","قُربى عَلَيهِ وَلا مَلامَةُ لائِمِ",62,"م",1,0],["وإذا قسوتَ تزيدُني طمعاً","كم يخرجُ الماءُ من الصخرِ",63,"ر",1,0],["وإذا قضى ربُّ الصبا","بة أن تصرَّ على جفاك",64,"ك",1,0],["وإذا قسوت على الكلا","ب سيرأف بالكلاب",65,"ب",1,0],["وَإِذا قينَةٌ تَخالجها السك","رُ عَلى مَشهَد من الجُمهورِ",66,"ر",1,0],["وإذا قربتِ تطلعت","نفسي إلى القرب الموالي",67,"ل",2,0],["وإذا قدَرْت على العدوّ فأَبقِه","إبقاءَ مَن وَجَد الإقالة أحزَما",68,"م",2,0],["وإذا قُبّلتْ رءوسُ الغواني","قبّلتْني أكابِرُ الظُّرَفاء",69,"ا",2,0],["وَإِذا قَضى بِالشَيءِ كانَ كَما قَضى","لا يَستَطيعُ مَرَدُّهُ الثَقَلانِ",70,"ن",1,0],["وإذا قيس لامرئ القيس معنى","بمعانيك ما له لمعان",71,"ن",1,0],["وَإِذا قُرَيشٌ سابَقَتكَ سَبَقتَها","بِقَديمِ أولاها وَأَنتَ قِوامُها",72,"م",3,0],["وَإِذا قَناةُ المَجدِ حاوَلَ أَخذَها","فَبِطولِ بَسطَتِهِ يُبَذُّ جِسامُها",72,"م",3,0],["وإذا قلت كيف مرّت أصاب القل","ب من حرّها شبيب الضرام",73,"م",1,0],["وَإِذا قيل تِلكَ هَمزة وَصلٍ","قُلت مَن لي بِأَن أَنال وِصاله",74,"ل",2,0],["وأذاقها ذاك العدو بِخُبثِه","صاباً ولكن ليس فيه صواب",75,"ب",1,0],["وَإِذا قامَ يُدير الرا","ح في اللَيل البَهيم",76,"م",1,0],["وَإِذا قَرَأنا هَل أَتى","قَرَأت وُجوهُهُمُ عَبَس",77,"س",1,1],["وَأَذاقَ عُتبَةَ بِالحُسامِ عُقوبَةً","حُسِمَت بِها الأَدواءُ وَهيَ تِلادُ",78,"د",1,0],["وإذا قسوتُ على مسامعكم بم","سأَبُثُّ من حزني ومن آلامي",79,"م",2,0],["وإذا قلت حديث المصطفى","قلتم المذهب أهدى السبل",80,"ل",1,0],["وإذا قلنا لزيد قلتم","بل عن الهادي هنا لم نعدل",81,"ل",1,0],["وإذا قلنا لهذا ولذا","فهما خير جميع الملل",81,"ل",1,0],["وإذا قد التبسا عليه وقد","عكس القضية عكسها الكلي",82,"ل",2,0],["وَإِذا قَلَّ نَيلُهُ كانَ بَحراً","وَإِذا ضاقَ صَدره كانَ بَرّا",83,"ر",2,0],["وإذا قضاءُ اللّهِ أخّرني إلى","أجَلِي المؤقَّتِ لِي فماذا أَعْملُ",84,"ل",1,0],["وإذا قال في المطالب شيئاً","صَدَقَتْني أقواله وفعاله",85,"ل",2,0],["وإذا قسا الخطب الملمُّ فلا تلم","حاربْ زمانك ما استطعت وجالد",86,"د",1,0],["وإذا قيل من لكر وفر","كنت ليا يد كدك البطحاء",87,"ا",2,0],["وإذا قيل في الأنام غني","اضرم القول في حشاك لهيبا",88,"ب",2,0],["وإذا قيل مَن توحَّد بالجو","د ومَن فهو واحد لا يُثنَّى",89,"ن",2,0],["وإذا قالَ دعيٌّ إنني","منهمُ قال له المجدُ وإنِّي",90,"ن",2,0],["وإذا قلوبٌ قارعت أحزانَها","ظهرَ الفلولُ على غُروب الألسنِ",91,"ن",1,0],["وإذا قيل سائلٌ ظنّها فَغْ","مَةَ مِسكٍ من طيبها أو نَغْمَهْ",92,"م",2,0],["وإذا قُذفتُ فقد قُتلتُ فكيف لي","بالصفح عنك وقد غَفرتَ لقاتلي",93,"ل",2,0],["وإذا قريشٌ طاولت بفخارها","في عصر إيمان وعهدِ فسوقِ",94,"ق",1,0],["وإذا قِيامةُ سؤدُدٍ","كذَبتك في الصُّوَر القِباحِ",95,"ح",1,0],["وإذا قنعتَ بما قنعتَ بهِ","منها فأين نتيجة الفضل",96,"ل",1,0],["وإذا قدماك وطئت بها","جدثا فاستغفر للقدم",97,"م",1,0],["وإذا قُلنا بتعْظيمِ امرءٍ","فهو تَعْظيمٌ لما قَدْ عظَّمَا",98,"م",2,0],["وإذا قَرأتَ من الشَّريعةِ نَصَّها","خُذْ منهُ عن حالِ الرَّسولِ قِياسا",99,"س",2,0],["وإذا قَطَعتَ اللَّيلَ بالسَّهَرِ انْتَبه","لله شأنُ قَريرِ عينٍ قد ذَكَرْ",100,"ر",1,0],["وإِذا قمتَ على بابِ الكَرَمْ","فامْتَثِلْ وامحَقْ صُدوداتَ الخِلافْ",101,"ف",1,0],["وإذا قصدْتُ سواكُمُ فيه فلم","تظفَرْ يَدي إلّا ببيضِ دَجاجِهِ",102,"ج",2,0],["وإذا قرنت مقالتي بفعاله","فاسمع مجيداً في صفات مجيد",103,"د",1,0],["وإذا قرصت الشعر في ميدانه","لا شك أنك يا أخي تتشقق",104,"ق",1,0],["وإذا قلتُ قد سلوتُ وخلّي ال","حبّ عنّي لقيتُ منه عظيما",105,"م",2,0],["وإذا قدمتَ على المسرّةِ فليكنْ","ذاك القدوم لنا بغير رحيلِ",106,"ل",1,0],["وَإِذا قَضى اللَّه القضاءَ فكنْ إلى","بَغْتاتِهِ مستأنساً مسترسلا",107,"ل",2,0],["وإذا قرنتَ بها سواها برّزتْ","غُرَرٌ لها لمّاعةٌ وحُجولُ",108,"ل",1,0],["وإذا قصرن به مطالبُهُ","عن راحتيه فلم يطلْ عُمُرُهْ",109,"ر",2,0],["وَإِذا قعدتُ فسوف تبصرُ أعينٌ","منِّي قيامِي في خلال قعودِي",110,"د",2,0],["وإذا قُريتَ أسىً فَقِدْ","ماً بالمسرّةِ ما قُريتا",111,"ت",2,0],["وإذا قلت انتبه لم","تر إلا الإنتباها",112,"ا",3,0],["وإذا قلت لو رويت بهم","قيل لي من بهم يهيم ظمي",113,"م",2,0],["وإذا قيل له رب","بك باد في الجبال",114,"ل",1,0],["وإذا قلت ذاك كان مرادي","صانع الشيء فاعل المفعول",115,"ل",1,0],["وإذا قلت ربنا يوجد المع","دوم قلنا ذا القول محض عناد",116,"د",1,0],["وإذا قَبَضْتَ مِنَ الصَداقةِ دِرْهماً","كَلِّفْ تجاريبَ الزَّمانِ بنَقْدِهِ",117,"د",2,0],["وإذا قام داعي الحق منا","كجمالٍ وجواهري وعارف",118,"ف",1,0],["وإِذا قتلتَ صِلِ المتيَّمَ","فيكَ واقْتلُ بَعْدَ ذلِك",119,"ك",1,0],["وإِذا قال فالقلوبُ خُشوعٌ","وإِذا قَام فالوُجُوهُ سجُودُ",120,"د",1,0]]}