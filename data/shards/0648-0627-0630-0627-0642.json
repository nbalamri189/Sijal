 للتقى سوى اللَه اعظم",186,"م",1,0],["وَإِذَا قَارَنَ الغَمَامَ بُرُوقٌ","فَهْيَ لَوْ تَعْلَمُونَ مِنْ نَارِ وَجْدِي",187,"د",2,0],["وإذا قرنت ابن اللبون وبازلا","ملّ القرين ولم يزل بخناق",188,"ق",1,0],["وإذا قيل من به أهلُ مصرٍ","سابقوا للعلا إليه أشرنا",189,"ن",2,0],["وإذا قمت عنك لم أمش إلا","مشي عانٍ يقاد نحو الغناء",190,"ا",2,1],["وَإِذا قُلتُ قَد مَلأتُ مَعالي","هِ مَديحاً يَقول هَل مِن مَزيدِ",191,"د",1,0],["واذا قضيت فلسرتي","للشكر من بعدي تلازم",192,"م",1,0],["وإذا قصر النهى فالتناهي","في طلاب الإدراك كالمستحيل",193,"ل",1,0],["وَإِذا قَرُبنا سالمَتنا صبوةٌ","وَمَدامةٌ تُحيي الصَفا وَتُرَوِّح",194,"ح",1,0],["وإذا قبلته مستضحكًا","في تخوم الكون، والكون سدامْ",195,"م",1,0],["وإذا قيل مُوسِر وفقير","فقصاراهما إلى استغلالِ",196,"ل",1,0],["وإذا قرار الراحلين لرجعة","ذاك القرار إلى مدى الأكوان",197,"ن",1,0],["وإذا قصدتُ حِماكَ يدْعونِي إلى","سَاحاتِ نائِلِه النعيمُ المُخْضَلُ",198,"ل",1,1],["وَإِذا قيلَ هَل تَقارَبَ مِنها","قالَتِ النارُ هَل لَدَيكُم مَزيدُ",199,"د",1,0],["وإذا قلت سلاماً لهم","بعد حينٍ لا يردون السلاما",200,"م",2,0],["وإذا قلتُ سُقتُ قولي بفعلٍ","ولكم قائلٍ بغيْر فعِالِ",201,"ل",1,0],["وأذاقه طعم المنون بضربة","تركته في بحر الدماء مضرّجا",202,"ج",2,0],["وإذا قربت إليه زاد تقرُّبي","شوقاً إليه واستزيد يزيدني",203,"ي",1,0],["وإذا قامت الصفوف أمام ال","حرب صلّى بالدارعين إماما",204,"م",2,0],["وإذا قيس بالملوك وقيسوا","كان كالقطب للأثير مديرا",205,"ر",2,0],["وأذاق إخْوَتَه الرَّدَى","وبَعيرَ أُمِّهم عَقَرْ",206,"ر",1,0],["وَإِذا قالَ عارِفاً قالَ سوءاً","وَإِذا قالَ مُنكِراً قُلتَ عُرفا",207,"ف",2,0],["وَإِذا قالَ عارِفاً قُلتَ سَواءاً","وَإِذا قالَ مُنكَراً قُلتَ عُرفا",208,"ف",2,0],["وَإِذا قُلتَ شاعرٌ هائج النَف","س كَثير الهَياجِ وَالثَورانِ",209,"ن",1,0],["وأذاق الدنيا جنونا ً من الحلم","فجن الجنون صحوا ً وعقلا",210,"ل",2,0],["وإذا قرضته معجبة","ظَنَّني هازئة أَنتقد",211,"د",1,0],["وإذا قضى أمراً مضنى فكأنما","في فيه قبل النون حرف الكاف",212,"ف",1,0],["وإذا قُدِّمَ ثاني شَطْرِهِ","فهو سلطانٌ لنا ذو عَظَمَهْ",213,"م",2,0],["وَإِذا قَطَعنَ مَسافَ 