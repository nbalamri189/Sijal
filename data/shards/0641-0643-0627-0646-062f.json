{"poems":[[79,"وافى لعطفتك البشير فلو غدت","https://www.aldiwan.net/poem36370.html","الكامل"],[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[47,"رحلت وأودعت الفؤاد لواحظا","https://www.aldiwan.net/poem66839.html","الكامل"],[77,"كفي فأيسر من مرد عناني","https://www.aldiwan.net/poem69028.html","الكامل"],[77,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[257,"طرف المحب موكل بعذابه","https://www.aldiwan.net/poem1450.html",""],[358,"هناء بالسلامة مستديم","https://www.aldiwan.net/poem39955.html","الوافر"],[463,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[473,"وشادن ظل يبكي يوم ودعني","https://www.aldiwan.net/poem60357.html","البسيط"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120678","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93695","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100335","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45771","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45784","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117963","الكامل"],[4852,"عندما","https://www.poetsgate.com/ViewPoem.aspx?id=214366",""],[5281,"مُقلةُ الحُسْنِ..رسولنا محمدٌ صلى الله عليه وسلَّم","https://www.poetsgate.com/ViewPoem.aspx?id=200143",""],[5486,"الدهشة الكبرى.","https://www.poetsgate.com/ViewPoem.aspx?id=210725",""],[6032,"خلب الغرام جنانا","https://www.poetsgate.com/ViewPoem.aspx?id=181523",""]],"verses":[["فَكَأَنَّ دَهْرِي لَمْ يَزَلْ لِيَ مُسْعِفاً","وَكَأَنَّ حَالِي بَعْدُ لَمْ يتَبَدَّلِ",0,"ل",1,0],["فَكَانَ دَمٌ أحَبَّ إِلَى نِزَار","شَوَارشع مِن وِطَابٍ مُعجِلِينَا",1,"ن",2,0],["فَكَأَنَّ دَيناً لِلسَماءِ عَلى الثَرى","سَلَفاً قَديماً حَلَّ في نَيسانِ",2,"ن",1,0],["فكَأنّ دينَكَ يوْمَ أرْدى كُفرَهُ","أجَلٌ بَطَشتَ لهُ بعمرٍ فانِ",3,"ن",1,0],["فكأنّ دَولَتَكَ المنيرةَ فيهمُ","ذَهَبٌ على أيّامِهِمْ مَحلول",4,"ل",1,0],["فَكأَنَّ داعيةَ الهَوى في جِسمِهِ","سَيفٌ يُقَطِّعه بحدِّ ذُبابِهِ",5,"ب",2,0],["فَكانَ دُعاؤُهُ ذُخراً وَفَوزاً","لَنا وَسَعادة أَبَداً تَدومُ",6,"م",1,0],["فكأنّ دمعي مُدَّ من أيدي بني","عبد الرحيم ومائها المتنبِّعِ",7,"ع",1,0],["فَكانَ دَمعِيَ يا قوتاً عَلى ذَهَبٍ","وَدَمعُهُ لُؤلُؤاً مِن فَوقِ ياقوتِ",8,"ت",1,0],["فكانَ دَرسُ كتابِ الله مُجتَهدا","أولى وأوَّل ما قَدَّمتُ في صِغَرِي",9,"ر",2,1],["فَكَأنَّ دارك كَعبة قَد أَكثَرَت","فيها المُلوك طَوافها وَسلامها",10,"م",3,0],["فكأن دون الناس كلهم","بيني وبينك ماردٌ نزغا",11,"غ",2,0],["فَكَأن دار المُلك رَوض جاده","صَوب السَحائب إِذ بهم قَد أَزهَرا",12,"ر",2,0],["فَكانَ دَمار القَوم بَعدَ حَياتَهُم","دَليلاً عَلى أَن الحَياةَ غُرور",13,"ر",1,0],["فكأن دهر السوء آلى برّة","أن لا أسف مدى الحياة السلسلا",14,"ل",2,0],["فكأنَّ ..دهرَ البُعدِ مِن ..","هولِ الكلامِ تقزَّما",15,"م",2,0],["فَكَانَ دَعْوَةَ إِبْرَاهِيْمَ يَرْفَعُهَا","مَعَ القَوَاعِدِ يَبْنِيْ البَيْتَ وَالحَرَمَا",16,"م",2,0],["فكان دقيقا في الحقائق كلها","يصورها حقا ويسبرها سبرا",17,"ر",2,0],["فكأن دنيا العشق لم يخلق لها","بين الخلائق مغرميْن سوانا",18,"ن",2,0]]}