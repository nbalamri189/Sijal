{"poems":[[87,"الله يحكم في المدائن والقرى","https://www.aldiwan.net/poem8096.html","الكامل"],[48,"ما ركب الخائن في فعله","https://www.aldiwan.net/poem23026.html","السريع"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54229","الكامل"],[108,"زمزم طليعة الأسطول المصري","https://www.poetsgate.com/ViewPoem.aspx?id=179646",""],[108,"جمال طرابلس","https://www.poetsgate.com/ViewPoem.aspx?id=179605",""],[230,"يا بنت روما لا تكوني كما","https://www.aldiwan.net/poem55110.html","السريع"],[409,"بالله هل نور شمس","https://www.aldiwan.net/poem33719.html","المجتث"],[412,"إن كنت تصدق في ادعاء وداده","https://www.aldiwan.net/poem50188.html","الكامل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39146","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48827","البسيط"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/44784","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109330","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27141","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106899","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87327","الرجز"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117965","الكامل"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202364","الكامل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199063","البسيط"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121262","البسيط"],[5008,"فاقد حنان","https://www.poetsgate.com/ViewPoem.aspx?id=27311",""],[5148,"ميراث الجهل","https://www.poetsgate.com/ViewPoem.aspx?id=187224",""],[5273,"الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=180073",""],[5277,"سحابةُ القلقِ","https://www.poetsgate.com/ViewPoem.aspx?id=206887",""],[5370,"مزاج","https://www.poetsgate.com/ViewPoem.aspx?id=85527",""],[5517,"أشجار وراء السياج","https://www.poetsgate.com/ViewPoem.aspx?id=199054",""],[5815,"رفقاً","https://www.poetsgate.com/ViewPoem.aspx?id=190221",""],[5956,"لا حَيَّ يَبقى بيننا","https://www.poetsgate.com/ViewPoem.aspx?id=193001",""],[5956,"حدثٌ أليم","https://www.poetsgate.com/ViewPoem.aspx?id=193104",""],[5956,"أصدقاء خالد مظلوم يسائلونه:","https://www.poetsgate.com/ViewPoem.aspx?id=201899",""],[5956,"هم لم يطيقوا أن يكونوا دولة واحدة","https://www.poetsgate.com/ViewPoem.aspx?id=205384",""],[5956,"أنهكتَ أمك لست تأكل جيدا","https://www.poetsgate.com/ViewPoem.aspx?id=205428",""],[5956,"يا سامِيا العظمى رعاك إلهُنا","https://www.poetsgate.com/ViewPoem.aspx?id=207489",""],[5956,"أ وَلم تضِق ذرعاً بعَون الناس؟","https://www.poetsgate.com/ViewPoem.aspx?id=215974",""],[6124,"عِِشرُونَ عَاماً","https://www.poetsgate.com/ViewPoem.aspx?id=103198",""]],"verses":[["هَذي طُلولُكِ أَنفُساً وَحِجارَةً","هَل كُنتِ رُكناً مِن جَهَنَّمَ مُسعَرا",0,"ر",2,0],["هَذي طِباعُ الناسِ مَعروفَةٌ","فَخالِطوا العالَمَ أَو فارِقوا",1,"ق",3,0],["هَذِي طَلاَئِعُ نَهْضَةٍ","ذَهَبَتْ بِآثارِ الركُودِ",2,"د",1,0],["هذي طلائعُ نهضةٍ بدأتْ","هذي نَوَى أسطولِنا المصري",3,"ر",2,0],["هذي «طرابُلُسٌ» أَم هذه«نَبُلى»؟","البرُّ مبتسمٌ، والبحر في جَذَل",4,"ل",1,1],["هذي طرابُلسٌ وَأَبناؤُها الشُج","عانُ يُزجونَ صُفوفَ القِتالِ",5,"ل",1,0],["هذي طلائع سعد","قد أذهبت كل نحس",6,"س",1,0],["هَذي طَرابلس وَما دونَ الغِنى","إِلّا نِداؤُكَ بِالحُسَينِ فَنادِهِ",7,"د",2,0],["هذِي طُروسٌ أمِ الطَّاووسُ أمْ قُزَحٌ","أمِ الحَدائقُ تُجْلَى نَصْبَ أحْداقِ",8,"ق",1,0],["هذي طريق إلى العدوان شائكة","وتلك أخرى إليكم من رياحين",9,"ن",1,0],["هذي طَريقُكَ لِلحَياةِ فَلا تَحِد","قَد سارَها مِن قَبلِكَ القَسّامُ",10,"م",1,0],["هذي طريق السبعة الاقلام","عني وعن أئمةٍ اعلامِ",11,"م",1,0],["هذي طرابلس وأبطالها","وبرقة الغرا وأشواسها",12,"س",3,0],["هَذي طُلولُهُمُ وَهَذي الأَدمُعُ","وَلِذِكرِهِم أَبَداً تَذوبُ الأَنفُسُ",13,"س",1,0],["هذي طيورك أنها ثرثارة","ضحكاً ولعباً فيك باطمئنان",14,"ن",1,0],["هذي طريقُ البرِّ بالتحقيقِ","واضحةٌ ما مِثَلُهَا طريقِ",15,"ق",1,0],["هذي طرائقهم وهذا شأنهم","تعسا لهم من خائن ومخاتل",16,"ل",1,0],["هذي طلولهم أطلن صبابتي","وتركن قلبي ما حييت طلولا",17,"ل",2,0],["هذي طريقة أهل العلم ما برحوا","أدلة وهم في الناس أحبار",18,"ر",1,0],["هذي طريقةُ مهديينَ من سلفس","هذي طويّةُ ساداتٍ وأمجادِ",19,"د",1,0],["هذي طبيعة حالتي دوم منقول","بين الحياة وبين لحد الكفوني",20,"ن",2,0],["هذي طبائعُ أهلِّ الشّرّ لا تهِنُوا","فعادةُ الجُهَلا أنْ يقْصدُوا الرّوثا!",21,"ث",2,0],["هذي طُقُوسُ وِلادَةٍ لقَصيدَةٍ","وعلى السُّطورِ يُقَرَّرُ الإنْجابُ",22,"ب",1,0],["هذي طقوس الحبِّ ليس بها","إلا بقايا الخوفِ والنّزقِ",23,"ق",1,0],["هذي طبوعي والغلا مو طلابه","يا نور عيني غير هالطبع ما فيه",24,"ي",2,0],["هذي طيورُ الجمرِ ثارَ رمادُها","حتى استحالَ قوادماً وخوافيا",25,"ي",2,0],["هذي طباعي روضةٌ فواحةٌ ‏‎","حيث الأريج فيوضه تنشيكِ‎",26,"ك",1,0],["هذي طبيعة عمرنا","نأتي ونمضي من هنا",27,"ا",1,0],["هذي طبيعة ربنا فيما فطرْ","لا يستطيع الغيم إخفاءَ المطرْ",28,"ر",1,0],["هذي طبيعة كل شهمٍ باذلٍ","ليُفيد غيره رافضاً أن يظهرا",29,"ر",2,0],["هذي طبيعة كل عاشقِ عرشِه","لا شعبِهِ والذمُّ سوف يطولُ",30,"ل",1,0],["هذي طبيعة والديك وكلنا","نفس الطباع نريد نغذو الأولُدا",31,"د",2,0],["هذي طبيعة كلِّ صاحبِ رحمةٍ","وتواضعٍ متلمِّسٍ حاجاتنا..",32,"ن",2,0],["هذي طبيعة كلِّ جاحدِ نعمةٍ","هذا وفاءُ الناكرِ المتناسي",33,"س",2,0],["هَذِي طُيُوري قد أتتْ صفواً إلى","أمْسِيْ تُنَادِي فِي هواكِِ شَافِعِيْ",34,"ع",2,0]]}