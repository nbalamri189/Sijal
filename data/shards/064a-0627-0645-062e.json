{"poems":[[53,"بيني وبين الصوارم الهمم","https://www.aldiwan.net/poem29775.html","المنسرح"],[3,"يا أيها الملك الذي راحاته","https://www.aldiwan.net/poem213.html","الكامل"],[71,"يا مخجل الغيث الملث إذا همى","https://www.aldiwan.net/poem4017.html","الكامل"],[73,"يا مخجل الغصن الفينان إن خطرا","https://www.aldiwan.net/poem11847.html","البسيط"],[30,"يا رب قد أشرفت نفسي وقد علمت","https://www.aldiwan.net/poem29475.html","البسيط"],[72,"صيرت نومي مثل عطفك نافرا","https://www.aldiwan.net/poem18698.html","الكامل"],[85,"طوي البساط وجفت الأقداح","https://www.aldiwan.net/poem62905.html","الكامل"],[97,"إن عدت أو أخلفت لم تعد","https://www.aldiwan.net/poem24792.html","أحذ الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42629","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54821","السريع"],[109,"علم الغايبيني","https://www.poetsgate.com/ViewPoem.aspx?id=8404",""],[97,"الميعاد","https://www.poetsgate.com/ViewPoem.aspx?id=17263",""],[116,"روض قد لألأ عسجده","https://www.aldiwan.net/poem41165.html","عموديه"],[156,"يا مخجلا للبدر في حسنه","https://www.aldiwan.net/poem55655.html","السريع"],[200,"يا مخلف الوعد كم","https://www.aldiwan.net/poem45555.html","مجزوء الرجز"],[212,"يا مخلفا ودموع القلب تتبعه","https://www.aldiwan.net/poem46292.html","البسيط"],[233,"ما لي وللاحي عليك يعنف","https://www.aldiwan.net/poem14814.html","الكامل"],[253,"أما كفاك تلافي في تلافيكما","https://www.aldiwan.net/poem1474.html",""],[365,"سرى كما يسري القمر","https://www.aldiwan.net/poem60914.html","مجزوء الرجز"],[403,"ملكتموا فاعدلوا في الصب أو جوروا","https://www.aldiwan.net/poem46753.html","البسيط"],[406,"يا مخلف الميعاد كم تجفوني","https://www.aldiwan.net/poem49706.html","الكامل"],[465,"يا مخجل القمر المنير","https://www.aldiwan.net/poem3502.html","عموديه"],[478,"كم رضت جامح قلبي عنكم فأبى","https://www.aldiwan.net/poem15242.html","البسيط"],[501,"يا كاشف الضر عن أيوب يا سندا","https://www.aldiwan.net/poem37561.html","البسيط"],[530,"لو تصلح النيات لم يفسد","https://www.aldiwan.net/poem37217.html","السريع"],[552,"يا حادي الأظعان عرج","https://www.aldiwan.net/poem47389.html","مجزوء الكامل"],[576,"طرفي عن وجهك لم يطرف","https://www.aldiwan.net/poem2912.html","السريع"],[587,"يا طائرا ناح إذ طاح الحمام به","https://www.aldiwan.net/poem17788.html","البسيط"]],"verses":[["يا مُخرِسَ الدَهرِ عَن مَقالَتِهِ","كُلُّ زَمانٍ عَلَيكَ مُتَّهَمُ",0,"م",1,0],["يا مُخجِلاً نَوءَ السَماءِ بِجودِهِ","يا مُنقِذَ المَحزونِ مِن أَحزانِهِ",1,"ن",2,0],["يا مُخجِلَ الغَيثِ المُلِثِّ إِذا هَمى","وَمُهَجِّنَ البَحرِ المُحيطِ إِذا طَما",2,"م",2,1],["يا مُخجِلَ الغُصُنِ الفَينانِ إِن خَطَرا","وَفاضِحَ الرَشإِ الوَسنانِ إِن نَظَرا",3,"ر",2,1],["يا مُخرِجَ الروحِ مِن جِسمي إِذا اِحتَضَرَت","وَفارِجَ الكَربِ زَحزِحني عِنِ النارِ",4,"ر",1,0],["يا مخرباً ربع السلوّ جعلتني","أدعى بأنساب الصبابة عامرا",5,"ر",2,0],["يا مُخلِفاً لِلوَعدِ وَعدُكَ مالَهُ","عِندي وَلا لَكَ في الضَميرِ بَراحُ",6,"ح",1,0],["يا مخلفَ الميعاد عد لترى","جزع الغريب وضيعة الرشدِ",7,"د",1,0],["يَا مُخْلِفَ الْوَعْدِ أَلا زَوْرَةٌ","أَقْضِي بِهَا الْحَقَّ مِنَ الزَّائِرِ",8,"ر",1,0],["يَا مَخْرَجاً مَا جَاشَ فِي صَدْرِهِ","وَجَالَ أَخْفَى جَوْلَةً فِي الضَّميرْ",9,"ر",1,0],["يامخلّي أمعقّدات الكيف .. فلّه","ينشغالة فكري وحرفة يديني",10,"ن",2,0],["يا مختلفَ الميعادِ عُدْ لترى","جزعَ الغريبِ وضيعةَ الرشدِ",11,"د",1,0],["يا مخلف وعد يطربني","وعد ما زال يردده",12,"د",2,0],["يا مُخْجِلاً لِلْبَدْرِ في حُسْنِهِ","وَزَائِداً نُوراً عَلَى الشَّمسِ",13,"س",1,1],["يا مخلفَ الوعدِ كمْ","تكذبُ فيما تنطقُ",14,"ق",1,1],["يا مخلفاً ودموع القلب تتبعه","بدافقات من الأشجان حمراء",15,"ا",2,1],["يا مُخلِفَ العُشّاقِ وَعَدَ وِصالِهِ","هَلّا مَواعيدُ التَجَنّي تَخلُفُ",16,"ف",1,0],["يا مُخجِلَ الغُصنِ ما يَثنيك عَن مَلَلٍ","هَوىً وَكُلُّ هَواءٍ هَبَّ يَثنيكا",17,"ك",2,0],["يا مُخجِلَ العَضْبِ الذَّكَر","من صَدْرِه رَأيٌ صَدَر",18,"ر",1,0],["يا مُخْربي رَبْع صَبري بالجفا عَبثَاً","الحمدُ لله رَبْعُ الودّ مَعْمورُ",19,"ر",1,0],["يا مُخلِفَ الميعادِ كْم تَجْفُوني","وَمُجَوِّدَ الإنشادِ كَمْ تَهْجُوني",20,"ن",2,1],["يا مخجلَ القمر المنيرَ","بوجههِ في الموهنِ",21,"ن",1,1],["يا مُخجلي الشمسَ كم أنضبتُ بعدكُمُ","نُجْباً مُزَمَّمةً لا تَعْرِفُ اللَّغَبا",22,"ب",2,0],["يا مخرجاً يوسفاً من جبِّه ومن ال","سجن العسيربحض الفضل إحسانا",23,"ن",2,0],["يا مُخْلِصاً للهِ كُنْ واثِقاً","باللهِ في الْعَقْدِ وفي الْحَلِّ",24,"ل",1,0],["يا مُخرجَ الآسادِ خا","شعَةَ الرؤوس من الغَريفِ",25,"ف",1,0],["يا مُخْجِلاً يوسفَ في حُسْنِهِ","قل لي أَما تخجلُ من يُوسُفِ",26,"ف",1,0],["يا مُخْجِلَ الغُصْنِ إذ يَهْتَزُّ ناعِمُهُ","لِيناً وَيُوسِعُ مَنْ نَهْواهُ إليانا",27,"ن",2,0]]}