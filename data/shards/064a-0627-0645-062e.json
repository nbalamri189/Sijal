{"poems":[[55,"بيني وبين الصوارم الهمم","https://www.aldiwan.net/poem29775.html","المنسرح"],[3,"يا أيها الملك الذي راحاته","https://www.aldiwan.net/poem213.html","الكامل"],[73,"يا مخجل الغيث الملث إذا همى","https://www.aldiwan.net/poem4017.html","الكامل"],[75,"يا مخجل الغصن الفينان إن خطرا","https://www.aldiwan.net/poem11847.html","البسيط"],[32,"يا رب قد أشرفت نفسي وقد علمت","https://www.aldiwan.net/poem29475.html","البسيط"],[74,"صيرت نومي مثل عطفك نافرا","https://www.aldiwan.net/poem18698.html","الكامل"],[87,"طوي البساط وجفت الأقداح","https://www.aldiwan.net/poem62905.html","الكامل"],[99,"إن عدت أو أخلفت لم تعد","https://www.aldiwan.net/poem24792.html","أحذ الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42629","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54821","السريع"],[112,"علم الغايبيني","https://www.poetsgate.com/ViewPoem.aspx?id=8404",""],[99,"الميعاد","https://www.poetsgate.com/ViewPoem.aspx?id=17263",""],[119,"روض قد لألأ عسجده","https://www.aldiwan.net/poem41165.html","عموديه"],[159,"يا مخجلا للبدر في حسنه","https://www.aldiwan.net/poem55655.html","السريع"],[203,"يا مخلف الوعد كم","https://www.aldiwan.net/poem45555.html","مجزوء الرجز"],[215,"يا مخلفا ودموع القلب تتبعه","https://www.aldiwan.net/poem46292.html","البسيط"],[237,"ما لي وللاحي عليك يعنف","https://www.aldiwan.net/poem14814.html","الكامل"],[257,"أما كفاك تلافي في تلافيكما","https://www.aldiwan.net/poem1474.html",""],[369,"سرى كما يسري القمر","https://www.aldiwan.net/poem60914.html","مجزوء الرجز"],[408,"ملكتموا فاعدلوا في الصب أو جوروا","https://www.aldiwan.net/poem46753.html","البسيط"],[411,"يا مخلف الميعاد كم تجفوني","https://www.aldiwan.net/poem49706.html","الكامل"],[469,"يا مخجل القمر المنير","https://www.aldiwan.net/poem3502.html","عموديه"],[482,"كم رضت جامح قلبي عنكم فأبى","https://www.aldiwan.net/poem15242.html","البسيط"],[505,"يا كاشف الضر عن أيوب يا سندا","https://www.aldiwan.net/poem37561.html","البسيط"],[534,"لو تصلح النيات لم يفسد","https://www.aldiwan.net/poem37217.html","السريع"],[556,"يا حادي الأظعان عرج","https://www.aldiwan.net/poem47389.html","مجزوء الكامل"],[580,"طرفي عن وجهك لم يطرف","https://www.aldiwan.net/poem2912.html","السريع"],[591,"يا طائرا ناح إذ طاح الحمام به","https://www.aldiwan.net/poem17788.html","البسيط"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34404","البسيط"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54013","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119977","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96739","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96715","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96663","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96645","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96621","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64882","السريع"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46568","الرجز"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78119","الرجز"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115888","الرجز"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11954","المنسرح"],[2173,"","https://poetry.dctabudhabi.ae/diwan/poem/142759","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105008","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88652","الخفيف"],[2382,"","https://poetry.dctabudhabi.ae/diwan/poem/101810","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93670","السريع"],[2447,"","https://poetry.dctabudhabi.ae/diwan/poem/198720","البسيط"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106972","البسيط"],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131689",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100371","البسيط"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58451","الكامل"],[2943,"","https://poetry.dctabudhabi.ae/diwan/poem/111342","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74219","الرجز"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132569","الكامل"],[3551,"","https://poetry.dctabudhabi.ae/diwan/poem/46049","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132147","الكامل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66582","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54453","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136452",""],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89579","المتدارك"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105178","السريع"],[4755,"بين الخوف والشجن","https://www.poetsgate.com/ViewPoem.aspx?id=183541",""],[5136,"قل للذي سفر اللثام","https://www.poetsgate.com/ViewPoem.aspx?id=121638",""],[5136,"غزيل خلف كله","https://www.poetsgate.com/ViewPoem.aspx?id=121769",""],[5213,"سل الأثيلات وأرمالها","https://www.poetsgate.com/ViewPoem.aspx?id=170530",""],[5582,"مُذْ حُلْنَ دُونَكِ يا سُعادُ فَراسِخُ","https://www.poetsgate.com/ViewPoem.aspx?id=186855",""],[5582,"أَسْيانُ نارُ غَرامِهِ تَتَسَعَّرُ","https://www.poetsgate.com/ViewPoem.aspx?id=187103",""],[5582,"ما لِلْحَمائِمِ لا يَنْفَكُّ نائِحُها","https://www.poetsgate.com/ViewPoem.aspx?id=186834",""],[5582,"قَلْبٌ بِنارِ الهَوَى قَدْ ذابَ وَاحْتَرَقَا","https://www.poetsgate.com/ViewPoem.aspx?id=187203",""],[5582,"شاقَتْكَ هِنْدٌ وَأَمْسَى الحَبْلُ مُنْصَرِمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63568",""],[5582,"أَتِلْكَ لِلحَيِّ أَحْداجٌ وَأَظْعانُ","https://www.poetsgate.com/ViewPoem.aspx?id=63592",""],[1547,"يا مخجل البدر كلما طلعا","https://www.poetsgate.com/ViewPoem.aspx?id=16794",""],[5780,"المرء بالأعمال","https://www.poetsgate.com/ViewPoem.aspx?id=187625",""],[6134,"يا مخلص الفضل أني قد أتيتك في","https://www.poetsgate.com/ViewPoem.aspx?id=169543",""]],"verses":[["يا مُخرِسَ الدَهرِ عَن مَقالَتِهِ","كُلُّ زَمانٍ عَلَيكَ مُتَّهَمُ",0,"م",1,0],["يا مُخجِلاً نَوءَ السَماءِ بِجودِهِ","يا مُنقِذَ المَحزونِ مِن أَحزانِهِ",1,"ن",2,0],["يا مُخجِلَ الغَيثِ المُلِثِّ إِذا هَمى","وَمُهَجِّنَ البَحرِ المُحيطِ إِذا طَما",2,"م",2,1],["يا مُخجِلَ الغُصُنِ الفَينانِ إِن خَطَرا","وَفاضِحَ الرَشإِ الوَسنانِ إِن نَظَرا",3,"ر",2,1],["يا مُخرِجَ الروحِ مِن جِسمي إِذا اِحتَضَرَت","وَفارِجَ الكَربِ زَحزِحني عِنِ النارِ",4,"ر",1,0],["يا مخرباً ربع السلوّ جعلتني","أدعى بأنساب الصبابة عامرا",5,"ر",2,0],["يا مُخلِفاً لِلوَعدِ وَعدُكَ مالَهُ","عِندي وَلا لَكَ في الضَميرِ بَراحُ",6,"ح",1,0],["يا مخلفَ الميعاد عد لترى","جزع الغريب وضيعة الرشدِ",7,"د",1,0],["يَا مُخْلِفَ الْوَعْدِ أَلا زَوْرَةٌ","أَقْضِي بِهَا الْحَقَّ مِنَ الزَّائِرِ",8,"ر",1,0],["يَا مَخْرَجاً مَا جَاشَ فِي صَدْرِهِ","وَجَالَ أَخْفَى جَوْلَةً فِي الضَّميرْ",9,"ر",1,0],["يامخلّي أمعقّدات الكيف .. فلّه","ينشغالة فكري وحرفة يديني",10,"ن",2,0],["يا مختلفَ الميعادِ عُدْ لترى","جزعَ الغريبِ وضيعةَ الرشدِ",11,"د",1,0],["يا مخلف وعد يطربني","وعد ما زال يردده",12,"د",2,0],["يا مُخْجِلاً لِلْبَدْرِ في حُسْنِهِ","وَزَائِداً نُوراً عَلَى الشَّمسِ",13,"س",1,1],["يا مخلفَ الوعدِ كمْ","تكذبُ فيما تنطقُ",14,"ق",1,1],["يا مخلفاً ودموع القلب تتبعه","بدافقات من الأشجان حمراء",15,"ا",2,1],["يا مُخلِفَ العُشّاقِ وَعَدَ وِصالِهِ","هَلّا مَواعيدُ التَجَنّي تَخلُفُ",16,"ف",1,0],["يا مُخجِلَ الغُصنِ ما يَثنيك عَن مَلَلٍ","هَوىً وَكُلُّ هَواءٍ هَبَّ يَثنيكا",17,"ك",2,0],["يا مُخجِلَ العَضْبِ الذَّكَر","من صَدْرِه رَأيٌ صَدَر",18,"ر",1,0],["يا مُخْربي رَبْع صَبري بالجفا عَبثَاً","الحمدُ لله رَبْعُ الودّ مَعْمورُ",19,"ر",1,0],["يا مُخلِفَ الميعادِ كْم تَجْفُوني","وَمُجَوِّدَ الإنشادِ كَمْ تَهْجُوني",20,"ن",2,1],["يا مخجلَ القمر المنيرَ","بوجههِ في الموهنِ",21,"ن",1,1],["يا مُخجلي الشمسَ كم أنضبتُ بعدكُمُ","نُجْباً مُزَمَّمةً لا تَعْرِفُ اللَّغَبا",22,"ب",2,0],["يا مخرجاً يوسفاً من جبِّه ومن ال","سجن العسيربحض الفضل إحسانا",23,"ن",2,0],["يا مُخْلِصاً للهِ كُنْ واثِقاً","باللهِ في الْعَقْدِ وفي الْحَلِّ",24,"ل",1,0],["يا مُخرجَ الآسادِ خا","شعَةَ الرؤوس من الغَريفِ",25,"ف",1,0],["يا مُخْجِلاً يوسفَ في حُسْنِهِ","قل لي أَما تخجلُ من يُوسُفِ",26,"ف",1,0],["يا مُخْجِلَ الغُصْنِ إذ يَهْتَزُّ ناعِمُهُ","لِيناً وَيُوسِعُ مَنْ نَهْواهُ إليانا",27,"ن",2,0],["يا مُخجلَ الشمسِ بالإِشراق إِنَّ فَتىً","طلعتَ في داره يَوماً لمسعودُ",28,"د",1,0],["يا مُخْجِلا نورَ الصباح بوجههِ","والبدرَ والأزهارَ في الأكْمَامِ",29,"م",1,1],["يا مخجل السحب الغَوادي","لا زلت بدر ندى ونادي",30,"د",2,1],["يا مُخبري عد وكرّر في حديثك عن","أهلِ المَغاني وما كانَت وما كانا",31,"ن",2,0],["يا مُخبري عُد وكرّر في حديثك عن","مَن حلّ وادي الغضا والسفح والعلما",32,"م",2,0],["يا مُخبري هل غيّرت طللُ النوى","عَن عهدهِ تبكاره والصرصرُ",33,"ر",1,0],["يا مُخبري كَيف الفريقُ أَشَملُهم","مُتجمّعٌ أَم شَملُهم متبدّدُ",34,"د",1,0],["يا مُخبري عن فريقٍ لست أطمع أن","أَحظى لديهم بتسهيل الزياراتِ",35,"ت",1,0],["يا مُخْلِفَ الصّادقِ في مَرْيمَ","ومُنْجِزَ الآخرِ مِنْ قافِ",36,"ف",1,0],["يا مخجل السحاب","بجوده السكاب",37,"ب",1,0],["يا مخجل الغُصن الرَطيب","يا مظهر الحُسن العَجيب",38,"ب",1,0],["يا مُخلفى فيما وَعَد","برَّح بى فيك الكمد",39,"د",1,1],["يا مُخجِلَ البَدرِ كُلَّما طَلَعا","وَفارِسَ الخَيلِ يَومَ كَلَّ وَعى",40,"ع",2,1],["يا مُخلِفي ما كانَ من وَعْدِ","ومُعَذِّبي بالهَجر والصَّدِّ",41,"د",1,1],["يا مخذم الإِسلام ليس يزال في","قلبي لفقدك مثل وخز سنان",42,"ن",1,0],["يا مخفا الى العلى غير وان","حاملا للإِسلام عبا ثقيلا",43,"ل",2,0],["يا مخرس العشر العقول فعاذر","أن يعجز الثقلان عن إدراكه",44,"ك",2,0],["يا مخجل الريم وَغُصن النَقا","في أَعيُن دعج وَقَد رَشيق",45,"ق",1,0],["يا مخرسي وقديما كان ينطقني","قلد حسام لساني حلية اللسن",46,"ن",1,0],["يا مخجل الريم جيد زانه جيد","قلبي وقرطك خفاق ومضطرب",47,"ب",1,0],["يا مخجل البان والقضبان","يا جامع الحسن يا أحوا",48,"و",2,0],["يا مخصب الشتوة الغبرا لسائله","حيّاً يمر على الاحياء سيالا",49,"ل",2,0],["يا مُخجلاً شَكْلَ الهِلالِ بِقَدَهِ","حاشاكَ أنْ تُعزى إلى نُقصانِ",50,"ن",1,0],["يا مخمداً يوم الوغى","لهب الوطيس إذا حمى",51,"م",2,0],["يا مخجل الغُزلان","هَيجت لي أَشجاني",52,"ي",1,0],["يا مخضع التيجان نهتف باسمه","فتذل تيجان الملوك وتسجد",53,"د",1,0],["يا مخجل البدر في التّمامِ","وَمشبهَ الشادِن الأَغَن",54,"ن",1,1],["يا مخلصاً بوداده في معشر","لم ألق فيهم مخلصاً بوداد",55,"د",1,0],["يا مُخْلِفاً ظَنَّ كِيكاوُوسَ حِينَ أَتَى","يَغْزُو مَعاقِلَ إِسْلامٍ وَتَوْحيدِ",56,"د",1,0],["يا مخجلَ البحرِ بالأيادي","قد آن أن تُفتحَ السواحلْ",57,"ل",1,0],["يا مُخرس الموت الزؤام لدى الوغى","ومُفرقّ الاحزاب حيث تجمعوا",58,"ع",3,0],["يا مُخجِلَها المُزري حَسَناً","آلُ الدارَينِ لَكَ اِشتَهَتِ",59,"ت",1,0],["يا مخجل الأقمار رفقاً بنا","لعل يروى كبد واغر",60,"ر",1,0],["يا مَخرَجَ اللهِ رُوحِي آخِرُ المُدُنِ","أَحْتاجُ أَلْفَيْ قَتِيلٍ كَي أُحَرِّرَنِي",61,"ن",2,1],["يا مَخْرَجَ اللهِ مُوسَى دُونَ مُرضِعَةٍ","والخِضْرُ في اليَمِّ تابُوتٌ بلا كَفَنِ",61,"ن",1,0],["يا مَخرَجَ اللهِ إِنِّي غَيرُ مُكتَرِثٍ","بالمَوتِ, ما دَامَ عَيشِي باهِظَ الثَّمَنِ",61,"ن",1,0],["يا مخجلا قمر السما","إذا سما فتألقا",62,"ق",2,0],["يا مخجل الغصن قدا","والظبي جيدا ومقله",63,"ل",2,0],["يا مخصب الدنيا اذا أجدبت","وماحيا بالجود امحالها",64,"ل",3,0],["يا مُخْجِلَ المَطَرِ الهَتُونِ وَمَنْ لَهُ","شَرَفٌ وَمَجْدٌ فِي المَعالِي باذِخُ",65,"خ",1,0],["يا مُخْبِرِي هَلْ غَيَّرَتْ طَلَلَ اللِّوَى","عَنْ عَهْدِهِ نَكْباؤُهُ وَالصَّرْصَرُ",66,"ر",1,0],["يا مُخْبِرِي عَنْ سُعادٍ هَلْ بِها بَكَرَتْ","كُومٌ يُمَسِّحُ وَجْهَ البِيدِ ماسِحُها",67,"ح",3,0],["يا مُخْبِرِي عَنْ دِيارٍ لِلأَحِبَّةِ هَلْ","أَرْخَى لَها البَرْقُ غَيْثاً واكِفاً غَدِقَا",68,"ق",2,0],["يا مُخْبِرِي عِدْ وَكَرِّرْ ( فِي ) حَدِيثِكَ عَنْ","مَنْ حَلَّ وادِي الغَضَى وَالسَّفْحَ وَالعَلَمَا",69,"م",2,0],["يا مُخْبِرِي عِدْ وَكَرِّرْ فِي حَدِيثِكَ عَنْ","أَهْلِ المَغانِي وَما كانَتْ وَما كانُوا",70,"ن",3,0],["يا مخجل البدر كلما طلعا","وفارس الخيل يوم كل وغى",71,"غ",2,1],["يا مُخلصاً في كلّ صنعٍ باهرٍ","والصنعُ بالإخلاص كم يزدان",72,"ن",1,0],["يا مخلص الفضل أني قد أتيتك في","أزهار فكر عليها حلية الثمر",73,"ر",1,1]]}