{"poems":[[53,"لمت يا وهب أهل دهرك فيما","https://www.aldiwan.net/poem65981.html","الخفيف"],[358,"من لصب صبا المعاهد أشجاه","https://www.aldiwan.net/poem40001.html","الخفيف"],[409,"أشغلت بالورقا عن الأوراق","https://www.aldiwan.net/poem33625.html","الكامل"],[484,"عاقبتني بالصد وهو عصيب","https://www.aldiwan.net/poem36947.html","الكامل"],[484,"لمتى الوقوف بجانب الأسطول","https://www.aldiwan.net/poem37199.html","الكامل"],[563,"نحن بالأمر الإلهي","https://www.aldiwan.net/poem33646.html","مجزوء الرمل"],[563,"لمتى أنت في الضلال المبين","https://www.aldiwan.net/poem33722.html","الخفيف"],[563,"يا أهل أسفل سافلين","https://www.aldiwan.net/poem33729.html","مجزوء الكامل"],[563,"إن هذا الأحد الديموم","https://www.aldiwan.net/poem33854.html","الرمل"],[563,"تب إلى الله من علوم الكلام","https://www.aldiwan.net/poem33868.html","الخفيف"],[563,"حولوا عني من الكون لثاما","https://www.aldiwan.net/poem33885.html","الرمل"],[563,"جسد في هوى المليح عليل","https://www.aldiwan.net/poem34252.html","الخفيف"],[563,"كن مع الله تر الله معك","https://www.aldiwan.net/poem34279.html","الرمل"],[563,"من به قد تكاثرت أمراضي","https://www.aldiwan.net/poem34413.html","الخفيف"],[563,"لمتى تموه بالمهاة وبالرشا","https://www.aldiwan.net/poem34430.html","الكامل"],[563,"فرحي يا فرحي يا فرحي","https://www.aldiwan.net/poem34662.html","الرمل"],[563,"من لصب متيم ملتاح","https://www.aldiwan.net/poem34681.html","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108429","الرمل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137435",""],[6278,"وغادر الطّفل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86867&r=&rc=20",""]],"verses":[["لُمْتَ يا وهبُ أهلَ دهركَ فيما","أنتَ أوجدتَهم إليه السبيلا",0,"ل",2,1],["لِمَتى تعتب الزَمان وَتلحاه","وَإِلى كَم تَذمُّ مِنهُ فِعالا",1,"ل",2,0],["لمتيم ما زال يفري قلبه","بقنا القدود وصارم الأحداق",2,"ق",1,0],["لمتى التغافل عن مطالبتي بما","أرجوه من عفو عساك تثوب",3,"ب",1,0],["لمتى الوقوف بجانب الأسطول","أنزل وإلا فاقتنع بقفول",4,"ل",1,1],["لمتى عينك عميا","لمتى قلبك ساهي",5,"ي",1,0],["لمتى أنت في الضلال المبينِ","سلم الأمر واعتصم باليقينِ",6,"ن",1,1],["لمتى الجهالة بينكم","بوقوعكم في العارفين",7,"ن",1,0],["لمتى الشرك الخفيْ يبقى إلى","موتكم لا كان هذا الشوم",8,"م",1,0],["لمتى أنت هكذا في غرور","ها هو الموت مسرع الإقدام",9,"م",1,0],["لمتَى نفسي بكم نفسي كما","لم أزل لحماً لديكم وعظاما",10,"م",2,0],["لمتى الجهل فيك هاهي لاحت","أين منك التكبير والتهليل",11,"ل",1,0],["لمتى تبني كنيسات الهوى","كسِّر الصلبان واهجر بيعك",12,"ك",1,0],["لمتى بالسواد نكتب فيها","وهي فينا كتابها بالبياض",13,"ض",1,0],["لمتى تُموِّهُ بالمهاة وبالرشا","وخفيُّ سرك في العوالم قد فشا",14,"ش",2,1],["لمتى أنت سواه لمتى","في نزاع أنت مت واسترح",15,"ح",1,0],["لِمَتى أنت هكذا في عناءٍ","أنا لا أرعوي إلى النصاح",16,"ح",1,0],["لمتى يا مالكي هذا الجفا","والى م الصد عن رب الوقا",17,"ق",2,1],["لمتيه في حبه جهلا بحالته","من حيث قدرت أن اللوم ينفعه",18,"ع",2,0],["لَمَّتْ يديكِ جداولاً من أدمُعي","إلّا دُموعاً رافقَتْكِ لِلثّرى",19,"ر",2,0]]}