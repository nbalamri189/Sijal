{"poems":[[9,"أجد بتيا هجرها وشتاتها","https://www.aldiwan.net/poem21916.html","الطويل"],[29,"ألا حي الديار بسعد إني","https://www.aldiwan.net/poem5772.html","الوافر"],[29,"أقمنا وربتنا الديار ولا أرى","https://www.aldiwan.net/poem5798.html","الطويل"],[29,"منا فتى الفتيان والجود معقل","https://www.aldiwan.net/poem5955.html","الطويل"],[29,"لمن طلل هاج الفؤاد المتيما","https://www.aldiwan.net/poem6019.html","الطويل"],[39,"ومنا ابن كوز والمنسم قبله","https://www.aldiwan.net/poem6859.html","الطويل"],[39,"ومنا إذا حزبتك الأمور","https://www.aldiwan.net/poem7379.html","المتقارب"],[49,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[23,"كنا ملوك الناس قبل محمد","https://www.aldiwan.net/poem21425.html","الطويل"],[30,"عرفت المنازل من مهدد","https://www.aldiwan.net/poem5043.html","المتقارب"],[30,"منا الذي اختير الرجال سماحة","https://www.aldiwan.net/poem5306.html","الطويل"],[30,"ومنا الذي لا ينطق الناس عنده","https://www.aldiwan.net/poem5341.html","البسيط"],[30,"ود جرير اللؤم لو كان عانيا","https://www.aldiwan.net/poem5620.html","الطويل"],[30,"وأقسم أن لولا قريش وما مضى","https://www.aldiwan.net/poem5621.html","الطويل"],[30,"وأطلس عسال وما كان صاحبا","https://www.aldiwan.net/poem5628.html","الطويل"],[22,"أفيما خلا من سالف العيش تدكر","https://www.aldiwan.net/poem21656.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85558","الطويل"],[190,"لقد هاج لي الوجد","https://www.aldiwan.net/poem43978.html","الهزج"],[234,"أعذلا وما عذلتني النهى","https://www.aldiwan.net/poem51276.html","المتقارب"],[280,"تهاب السيوف البيض والأسل السمر","https://www.aldiwan.net/poem25549.html","الطويل"],[303,"حماة الديار","https://www.aldiwan.net/poem36297.html","عموديه"],[305,"إذا قال سيف الله كروا عليهم","https://www.aldiwan.net/poem45457.html","الطويل"],[309,"على ميم وادي الرقمتين سلامي","https://www.aldiwan.net/poem16854.html","الطويل"],[376,"أتاني عنك إخوانك","https://www.aldiwan.net/poem57037.html","الهزج"],[422,"أينكر معروفنا المنكر","https://www.aldiwan.net/poem54039.html","المتقارب"],[466,"بني عمنا كفوا العضيهة أنها","https://www.aldiwan.net/poem15099.html","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38458","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59564","المتقارب"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96373","الوافر"],[1444,"","https://poetry.dctabudhabi.ae/diwan/poem/131377","الطويل"],[1603,"","https://poetry.dctabudhabi.ae/diwan/poem/117124","المتقارب"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100993","الطويل"],[1798,"","https://poetry.dctabudhabi.ae/diwan/poem/114921","الطويل"],[1918,"","https://poetry.dctabudhabi.ae/diwan/poem/99058","الهزج"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104741","الهزج"],[2347,"","https://poetry.dctabudhabi.ae/diwan/poem/89516","الطويل"],[2527,"","https://poetry.dctabudhabi.ae/diwan/poem/17710","الطويل"],[2696,"","https://poetry.dctabudhabi.ae/diwan/poem/10410","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83224","الطويل"],[2761,"","https://poetry.dctabudhabi.ae/diwan/poem/45537","الطويل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205435","الكامل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26118","الطويل"],[3619,"","https://poetry.dctabudhabi.ae/diwan/poem/33115","الطويل"],[3637,"","https://poetry.dctabudhabi.ae/diwan/poem/106772","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77167","الكامل"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17772","الطويل"],[4530,"","https://poetry.dctabudhabi.ae/diwan/poem/20950","الطويل"],[4984,"يوم العلم","https://www.poetsgate.com/ViewPoem.aspx?id=180154",""],[5232,"المعلقة السينية الحديثة","https://www.poetsgate.com/ViewPoem.aspx?id=212771",""],[5353,"ارح صوتك الدامي","https://www.poetsgate.com/ViewPoem.aspx?id=212647",""],[5353,"برقية عاجلة","https://www.poetsgate.com/ViewPoem.aspx?id=215398",""],[5411,"دُروب السَّالِكين","https://www.poetsgate.com/ViewPoem.aspx?id=185377",""],[5770,"إلى صديق","https://www.poetsgate.com/ViewPoem.aspx?id=178681",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[6093,"خُلقنا هكذا سودا وبيضا","https://www.poetsgate.com/ViewPoem.aspx?id=176237",""]],"verses":[["وَمِنّا الَّذي أَسرى إِلَيهِ قَريبُهُ","حَريباً وَمَن ذا أَخطَأَت نَكَباتُها",0,"ت",3,0],["وَمِنّا اِبنُ عَمروٍ يَومَ أَسفَلِ شاحِبٍ","يَزيدُ وَأَلهَت خَيلَهُ عُذَراتُها",0,"ت",3,0],["وَمِنّا اِمرُؤٌ يَومَ الهَمامَينِ ماجِدٌ","بِجَوٍّ نَطاعٍ يَومَ تَجني جُناتُها",0,"ت",3,0],["وَمِنّا الَّذي أَعطاهُ في الجَمعِ رَبُّهُ","عَلى فاقَةٍ وَلِلمُلوكِ هِباتُها",0,"ت",3,0],["وَمِنّا المَعقِلانِ وَعَبدُ قَيسٍ","وَفارِسُنا الَّذي مَنَعَ الذِمارا",1,"ر",2,0],["وَمِنّا الَّذي أَبلى صُدَيَّ بنَ مالِكٍ","وَنَفَّرَ طَيراً عَن جُعادَةَ وُقَّعا",2,"ع",2,0],["وَمِنّا أَميرا يَومِ صِفّينَ وَالَّذي","أَعادَ قَضاءَ الأَشعَرِيِّ مُغَربَلا",3,"ل",2,0],["وَمِنّا الَّذي ناجى فَلَم يُخزِ قَومَهُ","بِأَمرٍ قَوِيٍّ مُحرِزاً وَالمُثَلَّما",4,"م",2,0],["ومنَّا ابن كوز والمنسِّم قبله","وفارس يوم الفيلق العضب ذو العَضْبِ",5,"ب",1,1],["ومنا إذا حزبتك الأمور","عليك الملبلبُ والمُشبلُ",6,"ل",1,1],["وَمِنّا الَّذي ضافَ الإِمامَ وَجَيشِهِ","وَلا جودَ إِلّا أَن تَضيفَ العَساكِرُ",7,"ر",1,0],["وَمِنّا الفَتى يَحيى وَمِنّا اِبنُ عَمِّهِ","هُما ماهُما لِلعِزِّ سَمعٌ وَناظِرُ",7,"ر",1,0],["وَمِنّا أَبو اليَقظانِ مُنتاشَ خالِدٍ","وَمِنّا أَخوهُ الأُفعُوانُ المُساوِرُ",7,"ر",1,0],["وَمِنّا اِبنُ قَنّاصِ الفَوارِسِ أَحمَدٌ","غُلامٌ كَمِثلِ السَيفِ أَبلَجُ زاهِرُ",7,"ر",1,0],["وَمِنّا أَبو عَدنانَ سَيِّدُ قَومِهِ","وَمِنّا قَريعا العِزِّ جَبرٌ وَجابِرُ",7,"ر",1,0],["وَمِنّا الأَغَرَّ اِبنُ الأَغَرَّ مُهَلهَلٌ","خَليلِيَ إِن ذُمَّ الخَليلُ المُعاشِرُ",7,"ر",1,0],["وَمِنّا الحُسَينُ القَرمُ مُشبِهُ جَدِّهِ","حَمى نَفسَهُ وَالجَيشُ لِلجَيشِ غامِرُ",7,"ر",1,0],["وَمِنّا أَمينُ المُسلِمينَ حَياتَهُ","وَمَن غَسَّلَتهُ مِن جَنابَتِهِ الرُسلُ",8,"ل",1,0],["وَمِنّا الَّذي مَنَعَ الوائِدا","تِ وَأَحيا الوَئيدَ فَلَم يوأَدِ",9,"د",1,0],["وَمِنّا الَّذي أَعطى الرَسولُ عَطِيَّةً","أُسارى تَميمٍ وَالعُيونُ دَوامِعُ",10,"ع",1,0],["وَمِنّا الَّذي يُعطي المِئينَ وَيَشتَري ال","غَوالي وَيَعلو فَضلُهُ مَن يُدافِعُ",10,"ع",1,0],["وَمِنّا الَّذي أَحيا الوَئيدَ وَغالِبٌ","وَعَمروٌ وَمِنّا حاجِبٌ وَالأَقارِعُ",10,"ع",1,0],["وَمِنّا الَّذي قادَ الجِيادَ عَلى الوَجا","لِنَجرانَ حَتّى صَبَّحَتها النَزائِعُ",10,"ع",1,0],["وَمِنّا الَّذي لا يَنطِقُ الناسُ عِندَهُ","وَلَكِن هُوَ المُستَأذَنُ المُتَنَصَّفُ",11,"ف",1,1],["وَمِنّا الَّذي أَعطى يَدَيهِ رَهينَةً","لِغارَي مَعَدٍّ يَومَ ضَربِ الجَماجِمِ",12,"م",1,0],["وَمِنّا الَّذي أَحيا الوَئيدَ وَلَم يَزَل","أَبِيّاً عَلى الأَعداءِ أَن يَتَهَضَّما",13,"م",2,0],["وَمِنّا الَّذي سَلَّ السُيوفَ وَشامَها","عَشِيَّةَ بابِ القَصرِ مِنفَرَغانِ",14,"ن",1,0],["وَمِنّا المُحامي مِن وَراءِ ذِمارِكُم","وَنَمنَعُ أُخراكُم إِذا ضُيِّعَ الدُبُر",15,"ر",1,0],["ومنا الطلاق استقبحوه لأنه","يحل الرباط العائلي ويجذم",16,"م",1,0],["ومنّا البانوانيّ","إذا صنّف بالعقد",17,"د",1,0],["ومنّا الإمامُ العزيزُ الذي","به عادَ سيف الهدى مَنْتَضَى",18,"ا",1,0],["ومنّا الذي أرْضى النبوَّة مَنْطِقاً","وأطْلَعَهُ بَدْراً بأفْقِ الوَغى بَدْرُ",19,"ر",1,0],["وَمنّا (الوليدُ)","وَمنا (الرشيد)",20,"د",1,0],["وَمِنّا الَّذي يَحمي بِمُهجَةِ نَفسِهِ","بَني عامِرٍ يَومَ المُلوكِ القَماقِمِ",21,"م",1,0],["ومنا إمام حان حين خروجه","يقوم بأمر اللَه خير قيام",22,"م",1,0],["ومنَّا أبداً كانَ","يكونُ اللَّهوُ لا فِينا",23,"ن",2,0],["ومنَّا النبيُّ ومنَّا الوصيُّ","ومنَّا المبشّر والمنْذر",24,"ر",1,0],["ومنا الذي أحيْا الوئيد بماله","فوافق من قبلُ الكتابَ المحبرَّا",25,"ر",2,0],["وَمِنّا اِستَحَقّ اللّيلُ إِذ طالَ خِلعَةً","فَقُلنا لِشَرقِ الأفقِ يُلبسهُ الصُّبحا",26,"ح",2,0],["ومنا الوفاء ومنا العطاء","ومنا النجاءُ ومنا النجاح",27,"ح",1,0],["ومنا الأنبياءُ وكُلٌّ مَلكٍ","وحُكّامُ الائمةِ حيثُ صاروا",28,"ر",3,0],["ومنا الفتى دحمان والمسك وابنه","ومنا عليّ التوأمات ولا فخرا",29,"ر",2,0],["ومنا الكريم الشافعيّ أخو الندى","ومنا ابن مولودٍ حوى الجود والصبرا",29,"ر",2,0],["ومنا الذي شد أهل العراق","ولو غاب يحيى عن الثغر ضاعا",30,"ع",2,0],["ومنا أقرأ القُرَّا أبيٌّ","ومنا بعد رأسُ الفارضينا",31,"ن",2,0],["ومنا المكفنون وذاك فخر","بقمص المصطفى إذ يدفنونا",31,"ن",2,0],["ومنا الرائشان وذو رعين","ومن طحن البلاد لأن يدينا",31,"ن",2,0],["ومنا الحَبْر كعب ثم منا","إذا ذكروا خيارُ التابعينا",31,"ن",2,0],["ومنا القافة المبدون مهما","به شكلت عروق الناسبينا",31,"ن",2,0],["ومنا أسقفاً نجران كانت","برأيهما النصارى يصدرونا",31,"ن",2,0],["ومنا المُتَّلُون لكل فتح","ورائبُ صدعكم والراتقونا",31,"ن",2,0],["ومنّا الذي ساق الأساطيل شُرَّعاً","على البحر يستحي لصولتها البحر",32,"ر",1,0],["ومِنّا الذي للحمد أوقدَ نارَه","يَرى ضوءها مِن يافِعٍ مَن تَنَوَّرا",33,"ر",2,0],["ومنا الكاغ والكاغ","ة والشيشق في النحر",34,"ر",1,0],["ومنا العشيريون","بنو الحملة والكرّ",34,"ر",1,0],["ومنا المصطانيو","ن من ميزَقَ بالأسر",34,"ر",1,0],["ومنا النائح المبكي","ومنا المنشد المطري",34,"ر",2,0],["ومنّا الشيخ هفصويه","ويحيى وأبو زكر",34,"ر",1,0],["ومنا البشتداريو","ن تحت الرحل كالحمر",34,"ر",1,0],["ومنّا الكابليون","ومن يلعب بالجرّ",34,"ر",1,0],["ومنّا الزنج والزُّط","سوى الكبّاجة السُّمر",34,"ر",1,0],["وَمِنا المُصطفى جانَا","بِكُلِّ الفَضلِ أَرضانَا",35,"ن",2,0],["ومنا ابن مسعود أخو العلم والتقى","ومنا أبو ذر الغفاري جندب",36,"ب",1,0],["وَمِنّا الَّذي رَدَّ المُغيرةَ بَعدَما","بَدا جامِلٌ كَاللوبِ تَبدو شَواكِلُه",37,"ل",2,0],["وَمِنّا الَّذي آلى ثَلاثينَ لَيلَةً","عَنِ الخَمرِ حَتّى زارَكُم بِالكَتائِبِ",38,"ب",1,0],["وَمِنّا الفُوارِسُ أَينَ حَلَّت رِكابُهُم","تَخِرُّ لَهُم كُلُّ الجِباهِ لِقُوَّةِ",39,"ه",1,0],["وَمِنّا الَّذي رَدَّ المُلوطَ وَفاؤُهُ","بِعِجلِزَ وَالجاني مِنَ الشَرِّ مُشفِقُ",40,"ق",1,0],["وَمِنّا الَّذي فَخرٌ لِضَبَّةَ يُمنُهُ","إِذا ضَمَّ رُكبانَ المُعَرِّفِ مَأزِقُ",40,"ق",1,0],["وَمِنّا الَّذي أَدّى اِبنَ جَفنَةَ رُمحُهُ","إِلى الحَيِّ مَجنوناً يَخُبُّ وَيُعنِقُ",40,"ق",1,0],["وَمِنّا الَّذي سَدَّ الثَأى بَينَ مالِكٍ","وَقَد سَفِهَت أَحلامُهُم وَتَفَرَّقوا",40,"ق",3,0],["ومن االذي يوحي إليّ جماله","بدع الخيال ورنة الأوتار",41,"ر",1,0],["وَمِنّا الَّذي نَجيَّ بِدجلةَ جارَهُ","حِفاظاً وَنجَّتَهُ القُرومُ الضَوارِسُ",42,"س",1,0],["وَمِنّا اِبنُ عَبّاسٍ وَمِنَا اِبنُ عَمِّهِ","عَلِيٌّ إِمامُ الحَقِّ وَالحَسَنانِ",43,"ن",1,0],["ومِنَّا السَّلامُ العاطرُ الععرفِ كُلّنَا","عَن كُلِّكُم من غيرِ عَدٍّ وَلا حَصرِ",44,"ر",1,0],["وَمِنا العقوق المحض في نَقض الفَتى","أَمراً وَوالِده لِذلك أَبرَما",45,"م",2,0],["وَمِنّا الَّذي أَدّى مِنَ المُلكِ مازِناً","جَميعاً فَنَجّاها مِنَ القَتلِ وَالأَسرِ",46,"ر",1,0],["وَمِنّا الَّذي أَوصى بِثُلثِ تُراثِهِ","عَلى كُلِّ ذي باعٍ يَقِلُّ وَيَكثُرُ",47,"ر",1,0],["ومنا استقت جل الشعوب معارفا","وقد كان بعض في لياليهِمُ البهم",48,"م",1,0],["ومنا الأوفياءُ بكلِّ عهدٍ","ومنا الخائنُ الوغدُ الدسيس ُ",49,"س",1,0],["ومنا الجّسورُ الحمزة الفارس الذي","تفرُّ له الفرسان إن غاب وإن بدا",50,"د",2,0],["ومنّا الحسين بكربلاء أضاءها","دماءً وطيّب من ثراها المشهدا",50,"د",2,0],["ومنا الجّسورُ الحمزة الفارس الذي","تفرُّ له الفرسان إن غاب او بدا",51,"د",2,0],["وَمِنّا المُجدّونَ الَّذينَ تَعَدَّدوا","وَمِنَّا عَصِيٌّ كافِرٌ وَجَنوحُ",52,"ح",1,0],["ومنا الصعاليك في أمسهمْ","وصارو سلاطين حكم عُتاه",53,"ا",2,0],["ومنا الشهيد، ومنا الشريد","مضوا ما حنوا هامهم والجباه",53,"ا",2,0],["ومنا الذي مرّغتهُ الحياة","تجرَّع من مُّرها ما كفاه",53,"ا",2,0],["ومنَّا الأولى سادوا وشادوا وعمروا","فجاسوا خلال الدار بالأعوجيةِ",54,"ه",1,0],["ومنَّا أسودٌ وله فؤادٌ","كدرٍّ فائقٍ يبدي الوميضا",55,"ض",2,0]]}