لو كنتَ تعرف ما الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=182193",""],[5956,"مِثْل الفقير يرى القصور بعيدا","https://www.poetsgate.com/ViewPoem.aspx?id=182343",""],[5956,"شعرٌ يعدل في جانب من الأجانب","https://www.poetsgate.com/ViewPoem.aspx?id=192315",""],[5956,"أخَّرْتُ في أغلى الصحاب قصائدي","https://www.poetsgate.com/ViewPoem.aspx?id=214991",""],[4442,"فقه الشريعة أول","https://www.poetsgate.com/ViewPoem.aspx?id=171209",""],[199,"ما هاجَ شوقكَ من مغاني دمنة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=20777",""],[6213,"أرض ونجوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76296&r=&rc=44",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""],[463,"طرفُ نجديّة ُ وطرفُ عراقيُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60153&r=&rc=209",""],[463,"أنت على حالتيك محمودُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60016&r=&rc=72",""]],"verses":[["يَتَعاوَرونَ المَكرُماتِ وِلادَةً","مِن بَينِ جَدٍّ في المَكارِمِ وَاِبنِمِ",0,"م",1,0],["يتعب الليل نزيفا … وعلى","رغمه يدمى ، وينجرّ ويدمي",1,"م",2,0],["يَتَعَاقَبُ الرُّؤَسَاءُ وَالمَتَرَسِّمُو","آثَارِهِمْ فِي المَنْهَجِ المُتَرَسَّمِ",2,"م",1,0],["يَتَعَاطَى بُرْءَ النُّفُوسِ بِشِعْرٍ","خَالَطَ القَطْرُ فِيهِ بِنْتَ الدَّوَالِي",3,"ل",2,0],["يتعامى عنها الحياء حياءً","ليراها بحيلة المتعامي",4,"م",2,0],["يَتَعَرَّفنَ حُرَّ وَجهٍ عَلَيهِ","عُقبَةُ السَّروِ ظَاهِراً والوَسَامِ",5,"م",1,0],["يتعنّتُ المتعنِّتُون قصائدي","جَهلَ المرتِّبُ منطقي ترتيبَهُ",6,"ب",2,0],["يتعرَّضُ المتعرضون عدواتي","حتى يُهِرَّ ليَ المُهِرُّ كَلِيبَهُ",6,"ب",2,0],["يتعرَّضُ المتعرِّضُون وأنْتَئي","في ساحة المجد الفسيح وأنْتدِحْ",7,"ح",1,0],["يُتعِب جلاسَهُ ويُنصِبُهم","نَوْكاً فيودي بكل مصطَبر",8,"ر",1,0],["يتعاطى الكبيرَ بعد صغير","لم يُطقْ حَمْله بأقصى النَسيس",9,"س",1,0],["يتعاطَوْنَها سُلافاً شَمولاً","في جِنانٍ مجاورَاتٍ جِنانا",10,"ن",2,0],["يتعب الدهر في التخير حتى","يهب الناس شاعرا او اديبا",11,"ب",2,0],["يَتَعايا بِجَناحٍ وَيَنوء","بِجناحٍ مُذ وَهى ما صَلَحا",12,"ح",2,0],["يَتَعاوَنونَ كَأَهلِ دارٍ زُلزِلَت","حَتّى تَقَرَّ وَتَطمَئِنَّ الدارُ",13,"ر",1,0],["يَتَعَثَّرنَ بِالرُؤوسِ كَما مَر","رَ بِتاءاتِ نُطقِهِ التَمتامُ",14,"م",1,0],["يَتَعَثَّرنَ في النُحورِ وَفي الأَو","جُهِ سُكراً لَمّا شَرِبنَ الدِماءَ",15,"ا",2,0],["يَتَعاطى القَريضَ وَهوَ جَمادُ ال","ذِهنِ يَجفو عَنِ القَريضِ وَيَعسو",16,"س",2,0],["يَتَّعِظُ العاقِلُ مِن مِثلِهِ","وَيَحتَذي مِنهُ بِأَفعالِهِ",17,"ل",2,0],["يَتَعاوَرونَ مُدامَةً","صَهباءَ مِن حَلَبِ العَصيرِ",18,"ر",1,0],["يَتَعاطى حُبّي وَيَمزُجُ راحي","وَيُعاطي كَأسي وَيُنشِدُ شِعري",19,"ر",2,0],["يَتَعاوَنانِ عَلى النُفو","سِ فَذا الحِمامُ وَذا السِياقُ",20,"ق",1,0],["يَتَعَشَّقونَ نَضارَةً في وَجهِهِ","عُشقَ الفَتى وَجهَ الفَتاةِ الرودِ",21,"د",1,0],["يَتَعَجَّلونَ الأَمرَ شَرّاً كُلُّهُ","وَالشَعبُ يَصخَبُ وَالكِنانَةُ تَحردُ",22,"د",1,0],["يَتَعاوَوْنَ كالذِّئَابِ وَيَنْقَض","ضونَ مِنْ فَرْطِ جُوعِهِمْ كالنُّسُورِ",23,"ر",1,0],["يتعبُ ضوء النهار من الغيبةِ","والدير فاسق العتمه",24,"م",2,0],["يَتَعَرَّضنَ في البُرودِ لِذَيّا","لٍ يَجُرُّ الصِبا وَيَرعى السُتورا",25,"ر",2,0],["يَتَعَرَّضنَ لي بِفاتِرَةِ الطَر","فِ إِذا أَقبَلَت ثَناها الحَياءُ",26,"ا",2,0],["يتعثرن بالرؤوس كما مر","ر بتاآت نطقه التمتام",27,"م",1,0],["يتعانق الروحان فيه صبابة","ويعف ان يتعانق الجسدان",28,"ن",1,0],["يتعَثّرن تارةً بالذي جفّ","وحينا يطفونَ طفوَ الحَبابِ",29,"ب",1,0],["يتعلى حتى يجوز مدى الوهم","وحتى يهتك الأسرارا",30,"ر",2,0],["يَتَعَثَّرُونَ كأنَّهُمْ","يَمْشُونَ في حَلَقِ الْقُيُودِ",31,"د",1,0],["يتعاطى التخدير يحترف الرقص","ويدعو بالنصر للسّلطان",32,"ن",1,0],["يتعشَّقُ الأدبَ الرفيعَ، كأنما","هو من بني العباس في «بغداد»",33,"د",1,0],["يتعاوونَ كالذئابِ وينقض","ونَ من فرطِ جوعهم كالنسورِ",34,"ر",1,0],["يتعلَّلانِ بلَمح وجهِكَ","في الشُروق وفي الغُروب",35,"ب",1,0],["يتَعقَّبُ المسكينُ موجَتَها","عَبَثاً بمَوْجتهِ وتطْرُده",36,"د",2,0],["يَتَعَثّرْنَ في النّحُورِ وفي الأوْ","جُهِ سُكر ظماء لمّا شَرِبنَ الدّمَاءَ",37,"ا",2,0],["يتعاطَوْنَها سُلافاً شَمولاً","في جِنانٍ مجازِرَاتٍ جِنانا",38,"ن",2,0],["يتعرض المتعرضون عداوتي","حتى يُهِرَّ ليَ المُهِرُّ كَلِيبَهُ",39,"ب",2,0],["يَتَعاطُون أَكؤُس العَتب إِذ طا","فَ عَلَيهُم بِها المُنى وَالأَمان",40,"ن",1,0],["يتعب ويشقى ويتشحطط","ويظن إنه صادْ صيدَه",41,"ه",1,0],["يُتعِبُنا السَيرُ فَيَستَحِثُّنا","إِذا تَخَلَّفنا بِضَربٍ مُوجِعِ",42,"ع",1,0],["يَتَعجَّلونَ إِلى الإِكامِ فِرارَهم","وَإَلَيهِ تُسلمهم ذُرى الآكامِ",43,"م",1,0],["يِتَعاقَبنَهُ بِضَربِ وَلاءٍ","لا يَقي حاجِبَيهِ مِنه وَقاءُ",44,"ا",2,0],["يَتَعاوَرانِ مِنَ الغُبارِ مُلاءَةً","بَيضاءَ مُجدَثَةً هُما نَسَجاها",45,"ا",3,0],["يتعثّر الواشي بها","كالغيظ في صدر الحليم",46,"م",1,0],["يتعلم البحر السخا من جوده","والغيث من راحاته يتعود",47,"د",1,0],["يَتَعَزّى إِذ ذاكَ بَعضُ عَزاءٍ","ما تَراهُ يُفيدُ بَعض العَزاءِ",48,"ا",2,0],["يَتعلَّلونَ به إِلى أَن يَظفروا","بعَصائبِ الظُلَّام والرُّقباء",49,"ا",2,0],["يَتَعاقَبانِ بِكَ الرَدى","لا يَغفَلانِ وَأَنتَ غافِل",50,"ل",1,0],["يتَعرَّضُ العافِي للَثْمِ ظُهورها","حتّى يَغوصَ على نَفيسِ الجَوهر",51,"ر",1,0],["يتعذبن باضطرامِ أجيجٍ","وأُوارٍ يزيد بَلبالهنه",52,"ن",2,0],["يَتَعوذ المَلِكان مِن لَحظاتِهِ","وَالراح تَخشى فَتَكهن وَتَشفقُ",53,"ق",1,0],["يَتَعَطَّفونَ عَلى المَجاوِر فيهِم","بالمنفسات تعطُّف الآظارِ",54,"ر",1,0],["يتعاطون حياةَ الأنفسِ","في بديع اللفظ والمعنى الغريب",55,"ب",1,0],["يتعدى جميل فعلهم الناس","وإنْ كانَ ذلك الفعل لازم",56,"م",1,0],["يتعمَّمُ بالختم الطينيِّ اللمَّاع على عينيه الطيبتين","ينقش فوق نداوته المحبورة",57,"ه",1,0],["يتعثَّر في أيدينا مختارا","يهوي مسفوحا",57,"ح",2,0],["يتعاورُ الحسَّادُ أخذِي طائعا","بيدٍ لحقِّ الله من شيطاني",58,"ن",2,0],["يتعرَّضن مالهنّ من اللم","س نفورٌ ولا من الصيد واقي",59,"ق",2,0],["يتعبُ فيه الموفِّرون له","وهو مع المُسْهلين موءود",60,"د",1,0],["يتعَّوضُ العيْمانُ من مَذَقاتها","بَوْلاً ويقْدِرُ منْ هَبيد الحنظل",61,"ل",1,0],["يتعسَّف الوعْرَ القَصيَّ مخافةً","ويحيدُ عن سَنن الطريقِ الأمْثل",62,"ل",1,0],["يتعانقان وإنما","لا بالشمال ولا اليمين",63,"ن",1,0],["يتَعالى عن دَلالٍ","وبِذُلٍّ نَتَرامى",64,"م",2,0],["يتعاقَبانِ على الدّوامِ تعاقُبَ ال","مَلَوَينِ بالسّرّاءِ والضّرّاءِ",65,"ا",2,0],["يَتعَبُ في نَظمٍ لَهَا","يَحارُ إذ يُكمِلُها",66,"ه",2,0],["يتعالى الله عما","قلته يا ابن الحلال",67,"ل",1,0],["يتعاطى القبيح عمداً فيلقا","ه جميلاً وفلسه دينار",68,"ر",1,0],["يَتَعالى ولقد حُق","ق له أَنْ يَتَعالاَ",69,"ل",2,0],["يتعارف الجسمان والروحان في","ليل ويجمعها الغداة وعود",70,"د",1,0],["يتعجلون المستحيل عليهم","ولوَ اَنَّهم كانوا أسود الغاب",71,"ب",1,0],["يُتْعِبُ فِيهَا أَبداً جِسْمَهُ","وإنَّمَا الرَّاحَةُ كاَلخَلْسِ",72,"س",1,0],["يتعللان سويعة يدوي بها","صوت العناصر والطبيعة تسمع",73,"ع",1,0],["يَتعاضَدون على المكارم والعُلى","بِتشاكل الآداب والآراءِ",74,"ا",2,0],["يتعطَّفن عن غُصونٍ رشيقا","تٍ ويبسمن عن أغرٍّ شتيت",75,"ت",1,0],["يتعالى بجهله وهو يدري","أنَّ مِن مفرِقيه كعبَك أعلى",76,"ل",2,0],["يتعاطَينَ حنيناً موجِعاً","فهو لا يأتي ولا هي تمَل",77,"ل",1,0],["يتْعبُ النُّصحُ وَلاَ يَنْفَعُ في","فَاسد الأذهَان ضَربُ المَثَلِ",78,"ل",1,0],["يتعاطون بالصوارم كاسا","ت المنايا على غناء الصهيل",79,"ل",1,0],["يَتَعَطَّفُونَ عَلى المُجاوِرِ بَينَهَم","وَيَرَونَ كَسبَ الحَمدِ غَيرَ حَرامِ",80,"م",1,0],["يتعثر الغالي بهيبتهِ ومن","ذكراهُ تُزْهَقُ مهجَةُ الأفَّاكِ",81,"ك",1,0],["يتعب أنضاءً وتبعثه","عزائم لا يكلّ موجفها",82,"ف",3,0],["يتعمد العثرات وهي عظيمة","بعظيم حلمك والظنون تترجم",83,"م",1,0],["يتعالى الله في إيجاده","ما تراه من جميعِ الحدْثان",84,"ن",1,0],["يتعالى الله عن إدراكنا","وكذا نحن جلال في جمال",85,"ل",1,0],["يتعطَّر النادي بمدحتهِ إذا","نظم القصيدَ به الأديبُ وانشدا",86,"د",2,0],["يَتَعاوَنونَ عَلى الشَقاءِ بِكَأسِها ال","مَلأى بِمَحتومِ القَضاءِ الأَحمَرِ",87,"ر",1,0],["يُتعتعُها الساقي وما هي خمرةٌ","ولكنَّها روحي التي ضمَّها جنبي",88,"ب",2,0],["يُتعتها الساقي وما هي خمرةٌ","ولكنّها روحي التي ضمَّها الصدر",89,"ر",1,0],["يُتعتعُ رُوحها فتودُّ رُوحي","تُتَعتَع قبلها بيدِ الحِمام",90,"م",1,0],["يَتَعَطَّفونَ عَلى البَطيءِ تَعَطُّفَ ال","عوذِ المَطافِلِ في مُناخِ المَعقِلِ",91,"ل",1,0],["يَتَعاوَرانِ الشَوطَ حَتّى أَصبَحا","بِالجَزعِ بَينَ مُثَقِّبٍ وَمَطارِ",92,"ر",1,0],["يتعمَّد الأَمل البعيد وعنده","إن الحياة جميعها أوهام",9