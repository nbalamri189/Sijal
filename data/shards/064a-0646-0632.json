d=212160",""],[4797,"الصيدوالقيعان","https://www.poetsgate.com/ViewPoem.aspx?id=180549",""],[4888,"زمان مكفهر","https://www.poetsgate.com/ViewPoem.aspx?id=207771",""],[5061,"دمعة المغترب","https://www.poetsgate.com/ViewPoem.aspx?id=152992",""],[5096,"نسيم الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=206571",""],[5183,"مأساة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=186493",""],[5351,"الشعب العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=202103",""],[5431,"نبعة النور مصر أرض السجود","https://www.poetsgate.com/ViewPoem.aspx?id=198662",""],[5431,"لتخلصه ....","https://www.poetsgate.com/ViewPoem.aspx?id=210627",""],[5444,"غَزَّةٌ ... وَصَمْتُ المنَارة","https://www.poetsgate.com/ViewPoem.aspx?id=205078",""],[5525,"ذلني الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=946",""],[5756,"السفينة","https://www.poetsgate.com/ViewPoem.aspx?id=5180",""],[5776,"لحيةُ الصّبح","https://www.poetsgate.com/ViewPoem.aspx?id=199324",""],[5851,"شهقة السنديان","https://www.poetsgate.com/ViewPoem.aspx?id=175298",""],[5854,"ينزاح همي إن ذكرت محمدا","https://www.poetsgate.com/ViewPoem.aspx?id=192285",""],[6052,"بطاقات حمراء من غزة","https://www.poetsgate.com/ViewPoem.aspx?id=47578",""],[6093,"يذكر النَّاس ُ كلَّ مَيْتٍ بخيرٍ ( الخفيف)","https://www.poetsgate.com/ViewPoem.aspx?id=176024",""],[6102,"طَلَقَةُ الرَّحمَةِ","https://www.poetsgate.com/ViewPoem.aspx?id=186256",""],[1100,"أمن لهاثي ام لهاث الخمر جوي عطر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=612987",""],[170,"تزمُّ غداً للظاعنينَ الركائبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26727&r=&rc=2",""]],"verses":[["يَنزو بِهِ الفَرعُ الكَذوبُ وَيَتَّقي","مُرَّ الحَديثِ بِكُلِّ يَومٍ أَيوَمِ",0,"م",1,0],["يَنزو لَها عَلَقٌ تُمُطِّقَ خَلفَهُ","أَو عانِدٌ يَلقى النَواظِرَ شَلشَلُ",1,"ل",1,0],["يَنزِلُ مِنهُ مَنزِلَ الرَد","فِ الطَويلُ الذابِلُ",2,"ل",1,0],["يَنزِغُ مِن أُثعوبِ جَمٍّ باقي","حَمَّضَها في قُلَّصٍ عِتاقِ",3,"ق",1,0],["يَنْزل الهمُّ على أحكامها","فترى أحكام سعد بن مُعاذِ",4,"ذ",