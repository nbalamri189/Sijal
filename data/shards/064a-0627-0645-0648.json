ل"],[433,"إن جوى لو يذهب الأوجالا","https://www.aldiwan.net/poem12763.html","الرجز"],[440,"عادت عليك عوائد الأعوام","https://www.aldiwan.net/poem34806.html","الكامل"],[442,"سيان في الموت ذو العيلات والترف","https://www.aldiwan.net/poem14462.html","البسيط"],[444,"قف بالديار وحيها","https://www.aldiwan.net/poem56021.html","عموديه"],[453,"يا مؤثرا للهو طيب النعمه","https://www.aldiwan.net/poem13927.html","الكامل"],[459,"قالوا عساك مرجم فتبين","https://www.aldiwan.net/poem55859.html","الكامل"],[459,"نوازع الشوق والغليلِ","https://www.aldiwan.net/poem55990.html","مخلع البسيط"],[459,"لا لنوازي كبد هاجها","https://www.aldiwan.net/poem56080.html","السريع"],[459,"حاشاك من عارية ترد","https://www.aldiwan.net/poem56234.html","الوافر"],[459,"سل في الغضا وصبا الأصائل تنفح","https://www.aldiwan.net/poem56248.html","الكامل"],[462,"يا مودع السر سر الله خص به","https://www.aldiwan.net/poem16266.html","البسيط"],[469,"يا موردا من جود","https://www.aldiwan.net/poem60181.html","المجتث"],[469,"يا موقظ العتب الذي هو راقد","https://www.aldiwan.net/poem60254.html","الكامل"],[471,"يا موقد النار بالعلياء من إضم","https://www.aldiwan.net/poem4826.html","البسيط"],[501,"كثر الصنوف وأنت أنت الواحد","https://www.aldiwan.net/poem37565.html","الكامل"],[501,"هب نشر العرار من متكين","https://www.aldiwan.net/poem37763.html","الخفيف"],[516,"يا جامع الشمل المبدد","https://www.aldiwan.net/poem12066.html","مجزوء الكامل"],[516,"يا موقداً نار القرى للساري","https://www.aldiwan.net/poem12143.html","الكامل"],[552,"ما للقلوب غداة السبت مزعجة","https://www.aldiwan.net/poem47250.html","البسيط"],[552,"لا تلم الدهر ولا تعذل","https://www.aldiwan.net/poem47269.html","السريع"],[552,"لو كنت في مثل حالي لم ترد عذلي","https://www.aldiwan.net/poem47288.html","البسيط"],[552,"يا حادي الأظعان عرج","https://www.aldiwan.net/poem47389.html","مجزوء الكامل"],[552,"قدني إليك فقد أمنت شماسي","https://www.aldiwan.net/poem47745.html","الكامل"],[559,"يا مؤمنون بأن الله خالقكم","https://www.aldiwan.net/poem34369.html","البسيط"],[559,"لي رتبة العلامة الشهم الأَسد","https://www.aldiwan.net/poem34635.html","الكامل"],[568,"أي حراك غال منك السكون","https://www.aldiwan.net/poem69478.html","السريع"],[568,"ياعوضا من فائت","https://www.aldiwan.net/poem69617.html","مجزوء الرجز"],[587,"ما شئت من عبء الغرام وحمله","https://www.aldiwan.net/poem17688.html","الكامل"]],"verses":[["يا موعِدي بِذِنابِ مِخلَبِهِ","إِنَّ البَعوضَ أَذاتُهُ القَرصُ",0,"ص",1,0],["يا مُوقِدَ النارِ بِالهِندِيِّ وَالغارِ","هَيَّجتَ لي حَزَناً يا مُوقِدَ النارِ",1,"ر",1,1],["يَا مَوْقِعَ الْفَقْرِ الشَّدِيدِ عَلَى الْغِنَى","مِنْ ذِي ضَنىً تُغْرِي الْفَلاَ بِرِكَابِهِ",2,"ب",2,0],["يا مُورِدَ الرُمحِ ظَمآناً وَمُصدِرَهُ","يَومَ الكَريهَةِ رَيّاناً مِنَ العَلَقِ",3,"ق",1,1],["يَا مَوتُ ما إِن تَزَالُ مُعتَرِضَاً","لآِمِلٍ دُونَ مُنتَهى الأَمَلِ",4,"ل",1,0],["يا مورداً حامت عليه قلوبُنا","لو نيلَ لم تجرِ المدامع نيلا",5,"ل",2,0],["يا موطناً ما انتضيناها مُهَنّدةً","إلاّ لردع الأعادي عن إهانته",6,"ت",2,1],["يا موعداً منه بقرب اللقا","قابلتنا اليومَ بصبحٍ صبيح",7,"ح",1,0],["يا موثراً كتمَ الهباتِ وكتمها","كالمسك لا يزدادُ غيرَ نوافح",8,"ح",1,0],["يا مولعاً بملامِي حسبكَ الله","كم ذا تهيّج مغرى القلب مضناه",9,"ا",2,1],["يا مَوضِعَ الناظِرِ مِن ناظِري","وَيا مَكانَ السِرِّ مِن خاطِري",10,"ر",2,1],["يا مُؤثِرَ الناسِ بالثراء ومن","له عليهم بالسؤددِ الأثره",11,"ر",2,0],["يا مورداً صادقَ العذوبةِ أش","كوكَ وأشكو الحماةَ أنْ أردَكْ",12,"ك",1,0],["يا مؤنسَ الإنس والوحشِ التي ذُعرتْ","ومن أخافَ الأُسودَ السودَ والجبلا",13,"ل",2,0],["يا مُؤنِسَ الأَمواتِ في أَرماسِها","في الأَرضِ بَعدَكَ وَحشَةٌ وَخُمولُ",14,"ل",1,0],["يا مولِيَ النَعماءِ إِنّي شاكِرٌ","وَالشُكرُ حَقٌّ واجِبٌ لِلمُنعِمِ",15,"م",1,1],["ياموحِشي بِصُدودِهِ","وَسِوايَ مِنهُ الدَهرَ آنِس",16,"س",1,0],["يا مَوْتُ قدْ مزَّقْتَ صَدْري","وقَصَمْت بالأَرزاءَ ظَهْرِي",17,"ر",2,1],["يَا مَوْتُ قَدْ مَزَّقْتَ صَدْري","وقَصَمْتَ بالأَزراءِ ظهْرِي",17,"ر",2,0],["يَا مَوْتُ ماذا تبتغِي منِّي","وقدْ مزَّقتَ صَدْرِي",17,"ر",2,0],["يَا مَوْتُ قَدْ شاعَ الفؤادُ","وأقفرتْ عَرَصَاتُ صدْرِي",17,"ر",2,0],["يَا مَوْتُ نفسي ملَّتِ الدُّنيا","فهلْ لم يأْتِ دوْرِي",17,"ر",2,0],["يا موت اشرعت على","صدر شقيقي اسلك",18,"ك",1,0],["يا موطنا قد ذبت فيه غراما","أهدي إليك تحية وسلاما",19,"م",2,1],["يا موت حتى الطير ليست","مفلتات من ذئابك",20,"ك",1,0],["يا موت إنك أنت أنت الملتجى","وإليك من هول الحياة المفزع",21,"ع",1,0],["يا موت زر يا موت زر يا موت زر","ليست حياتي بعد فيها أطمع",21,"ع",1,0],["يا موت يا كلَّ النجاةِ يقول لي","قلبي فضاؤُك من فضائي أوسع",21,"ع",1,0],["يا موطئ الأقدام","يا فتنة الأقوام",22,"م",1,0],["يا مَوكِبَ العِلمِ قِف في أَرضِ مَنفَ بِهِ","يُناجِ مَهداً وَيَذكُر لِلصِبا شابا",23,"ب",2,0],["يا مَوعِداً مِنها تَرَقَّبتُهُ","وَالصُبحُ فيما بَينَنا مُسفِرُ",24,"ر",1,1],["يامَوعِداً فاتَ فَأَبقى الجَوى","مِن مُخلِفٍ لِلوَعدِ حَلّافِ",25,"ف",1,1],["يا موجِباً حقَّ السَّماحِ بنائلٍ","تتقاصَرُ الأنواءُ عن أنوائِه",26,"ا",3,0],["يا مُؤثِرَ الدُنيا عَلى دينِهِ","وَالتائِهَ الحَيرانَ عَن قَصدِهِ",27,"د",2,1],["يا مَوتُ يا مَوتُ كَم أَخي ثِقَةٍ","كَلَّفَني غَمضَ عَينِهِ بِيَدي",28,"د",2,0],["يا مَوتُ يا مَوتُ كَم أَضَفتَ إِلى ال","قِلَّةِ مِن ثَروَةٍ وَمِن كَبِدِ",28,"د",1,0],["يا مَوتُ يا مَوتُ كَم لِوَخزِكَ مِن","قَلبٍ جَريحٍ يَدمى وَمِن كَبِدِ",28,"د",1,0],["يا مَوتُ يا مَوتُ صَبَّحَتنا بِكَ ال","شَمسُ وَمَسَّت كَواكِبُ الأَسَدِ",28,"د",1,0],["يا مَوتُ يا مَوتُ لا أَراكَ مِنَ ال","خَلقِ جَميعاً تُبقي عَلى أَحَدِ",28,"د",1,0],["يا مَوتُ كَم زائِدٍ قَرَنتَ بِهِ ال","نَقصَ فَلَم يَنتَقِص وَلَم يَزِدِ",29,"د",1,0],["يا مُؤثِرَ الدُنيا وَطالِبَها","وَالمُستَعِدَّ لِمَن يُفاخِرُهُ",30,"ر",2,0],["يا مَوطِنَ الدارِ الَّتي","هُوَ مُسرِعٌ عَنها الرَحيلا",31,"ل",2,0],["يا مؤنس المصري في","حلب وما ننسى المنن",32,"ن",1,0],["يا مؤنس الدنيا فديتك موحشا","تهتاج وجداً أو تضيق ضلوعا",33,"ع",2,0],["يا مَوتَهُ لَم تَدَع ظَرفاً وَلا أَدَباً","إِلّا حَكَمتَ بِهِ لِلَّحدِ وَالكَفَنِ",34,"ن",1,0],["يا مَوسِمَ اللَذّاتِ غالَتكَ النَوى","بَعدي فَرَبعُكَ لِلصَبابَةِ مَوسِمُ",35,"م",1,0],["يا مَوضِعَ الشَدَنِيَّةِ الوَجناءِ","وَمُصارِعَ الإِدلاجِ وَالإِسراءِ",36,"ا",2,1],["يا مؤنسي في غربتي ومشاركي","في العلمِ أَسمعُهُ وطوراً أُسْمِعُ",37,"ع",1,0],["يا مَوقِدَ النارِ يُذكيها وَيُخمِدُها","قَرُّ الشِتاءِ بِأَرياحٍ وَأَمطارِ",38,"ر",1,1],["يا مَوْلِدَ النُّورِ الذي صَدَعَ الدُّجَى","فَرأَى السَّبيلَ الحائِرُ المُتَردِّدُ",39,"د",1,0],["يا مولدَ المختارِ أنت بَعَثْتَها","ذِكرى تُساجِلُ دمعيَ المسجوما",40,"م",2,0],["يا موقِدَ الحَربِ بَغياً في طَرابُلسٍ","بِأَيِّ عُذرٍ إِلى التاريخِ تَعتَذِرُ",41,"ر",1,0],["يا مُولَعَاً بالحربِ يَستقصِي المَدَى","في وصفها منه البيانُ المُسْهَبُ",42,"ب",1,0],["يا مُؤْتَةُ احْتَمِلي الأهوالَ صابِرةً","هيهاتَ ذلك شيءٌ غيرُ مُحتَمَلِ",43,"ل",1,0],["يا موطناً في ثراه غاب سادته","لو كان يخجل من باعوك ما باعوا",44,"ع",3,0],["يا مَوطِناً قرع العداة صِفاته","أَشجيتَني وِمِن الرَقاد مَنَعتَني",45,"ن",2,0],["يا مَوطِناً طَعَن العِداة فُؤاده","قَد كُنت مِن سكينهم في مَأمن",45,"ن",1,0],["يا مَوسِمَ العُشاقِ قُل لي مَتى","تَخلو مِنَ الغائِرِ وَالمُنجِدِ",46,"د",1,0],["يا مورِيَ الزَندِ قَد أَعيَت قَوادِحُهُ","اِقبِس إِذا شِئتَ مِن قَلبي بِمِقباسِ",47,"س",1,0],["يا موقِدَ النارِ قَد أَعيَت قَوادِحُهُ","اِقبِس إِذا شِئتَ مِن قَلبي بِمِقباسِ",48,"س",1,0],["يا موعِدي بِالقَتلِ قَد حالَفَ ال","خِنجَرُ في قَتلي يَمينَيكا",49,"ك",2,0],["يا مَوت يحيى لَقَدْ ذَهَبْتَ بِهِ","لَيْسَ بِزُمَّيْلةٍ ولا نَكِدِ",50,"د",1,0],["يا مَوْتَهُ لو أَقَلْتَ عَثْرَتَهُ","يا يَوْمَهُ لو تَرَكْتَهُ لِغَدِ",50,"د",1,0],["يا مَوْتُ لو لم تَكُنْ تُعَاجِلُهُ","لَكانَ لا شَكَّ بَيْضةَ البَلَدِ",50,"د",1,0],["يا موت إنك أَنت حلو فاِقترب","إنَّ الحَياة من المرارة صاب",51,"ب",1,0],["يا موت غيري إن يَهبَك فإنني","أنا لا أهابك والحياة أهاب",51,"ب",1,0],["يا موطناً عنه أنأى","مني عليك السلام",52,"م",1,0],["يا موت إني في اِشتياقك ناحل","قُل لي مَتى قل لي يَكون لقاء",53,"ا",2,0],["يا مَوتُ حَسبُكَ إِذ أَقصَدتَ مُهجَتَهُ","أَولا فَدونَكَ لا حَسَبٌ وَلابَجَلُ",54,"ل",1,0],["يا مَوتُ لَو في وَغىً عايَنتَهُ خَلَدَت","عَلَيهِ عَوضُ دُموعٌ مِنكَ تَنهَمِلُ",54,"ل",1,0],["يا مَوئِلاٌ كانَ مَأوى الآزِماتِ بِهِ","إِذا اِدلَهَمَّت بِمَكروهاتِها العُضُلُ",54,"ل",1,0],["يَا مُوفَدِي لُبْنَانَ مَا","أَحْلَى زِيَارَتَكُمْ وَأَنْدَى",55,"د",2,0],["يا موحِشي مِنهُ وَيا مُؤنِسي","إِن كُنتُ في الخَلوَةِ وَالاِنفِراد",56,"د",1,1],["يا مَوتُ لا أَشكوكَ إِنَّ مُصابَهُ","قَدَرٌ عَلَيَّ يرى وَحَقٌّ حَصحَصا",57,"ص",2,0],["يا مَوتُ كَم قَصَفت رِياحكَ قَبلَهُ","مِن غُصن بانٍ كانَ يَحمِلُ أَو عَسا",58,"س",2,0],["يا مَوتُ ما أَبقَيتَني","مِن بَعدِهِ إِلّا لِباسي",59,"س",2,1],["يَا مَوْطنَ الْحُبِّ الْمُقِيمِ","وَمَضْرِبَ الْمَثَلِ الشَرُودِ",60,"د",1,0],["يا موقعَ الفقرِ الشَّديد على الغنى","من ذي ضناً تُغري الفَلى بركابِه",61,"ب",2,0],["يا موطني من ذا تنادي هنا","أسكت لماذا ؟ أنت لا تعلم",62,"م",1,0],["يا موجةَ النيلِ احملي تيّارَهُ","علّ \" العراقَ \" تهزُّهُ عدواك",63,"ك",1,0],["يا موطِنَ السِحرَ إنَّ الشِعر يُنعْشُه","فيضٌ من الحُسْنِ في واديكَ معهود",64,"د",1,0],["يا موطن النُّجد الغزاة هضيمة","كيف ارتقت عن شأنك الأوطان",65,"ن",1,0],["يا موطناً عَزّت به \" خرطوشةٌ \"","ذُلاًّ وهانَ دمٌ له مسفوح",66,"ح",1,0],["يا مَوْعِداً مِنْها تَرَقّبْتُهُ،","وَالصّبْحُ فيمَا بَيْنَنَا يُسْفِرُ",67,"ر",1,1],["يا موضعَ الشَّذنيَّة ِ الوجناءِ","ومُصارعَ الإدلاجِ والإسراءِ",68,"ا",2,1],["يا مَورِداً حامَت عَلَيهِ غلَتي","إِذ جِئتُهُ مُستسقياً وَرَجائي",69,"ا",2,0],["يا مونس الغربا يا ملجأ الضعفا","يا من تجليت في برهان لاهوت",70,"ت",1,0],["يا موقد النار في قلبي وتاركها","تكوي حشاي وتوهي صرح بنياني",71,"ن",2,0],["يا موثل الضعفاء بل يا ملجأ","الفقراءِ بل يا موردَ الأيتامِ",72,"م",1,0],["يا موتُ يا مَلِكَ الحياةِ","وأميرَ كلِّ الكائناتِ",73,"ت",1,0],["يا مورِدَ الآمالِ بحرُ نوالِهِ","عذبُ الموارِدِ سلسبيلا سلسلا",74,"ل",2,0],["يا مولجَ الليلِ في النهارِ أما","آن لصبحٍ في الليل أن يَلِجا",75,"ج",2,0],["يا مَوْقِفاً تَرَكَ الفُؤا","دَ عَلى التَّلَهُّفِ موقفَا",76,"ف",2,0],["يا مُوْقِدَ النَّارِ في قلبي وفي كَبِدي","أَوقَدْتَ ما لَيْسَ يُطْفا آخِرَ الأَبَدِ",77,"د",1,1],["يا مؤمناً يُطلعُ شمساً إذا","ألقتْ ذُكاءُ اليد في كافِرِ",78,"ر",1,1],["يا موقد النار في صدرى مؤججةً","ولاهياً بين أزهار وأفنان",79,"ن",1,0],["يا مَوقِداً لِلحُبِّ لا يَحمَدُ","الحُبُّ نيرانٌ تُنيرُ السَما",80,"م",2,0],["ي