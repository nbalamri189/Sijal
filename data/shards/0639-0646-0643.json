563.html","الرجز"],[505,"كثر الصنوف وأنت أنت الواحد","https://www.aldiwan.net/poem37565.html","الكامل"],[505,"ما للقلوب عن الحبيب غطاء","https://www.aldiwan.net/poem38105.html","الكامل"],[519,"لله قوم بأكناف الحمى نزلوا","https://www.aldiwan.net/poem20817.html","البسيط"],[520,"صرف النسيب إلى اللوى وزرود","https://www.aldiwan.net/poem12082.html","الكامل"],[543,"صنعة الشعر لقد عافتك","https://www.aldiwan.net/poem47428.html","عموديه"],[563,"لمائه كلنا أواني","https://www.aldiwan.net/poem33828.html","مخلع البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[592,"سبحان من كون الأشياء تكوينا","https://www.aldiwan.net/poem11513.html","عموديه"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103083","الكامل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34411","الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25381","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56163","الكامل"],[1185,"","https://poetry.dctabudhabi.ae/diwan/poem/75734","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112710","الخفيف"],[1315,"","https://poetry.dctabudhabi.ae/diwan/poem/140226",""],[1315,"","https://poetry.dctabudhabi.ae/diwan/poem/140220",""],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18462","الرجز"],[1354,"","https://poetry.dctabudhabi.ae/diwan/poem/205982",""],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93086","الكامل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78182","البسيط"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122081","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79875","الرجز"],[1840,"","https://poetry.dctabudhabi.ae/diwan/poem/216640",""],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114700","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69401","الكامل"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76795","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77267","الكامل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poe