شبلُ *","https://www.poetsgate.com/ViewPoem.aspx?id=199718",""],[5736,"اعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=203920",""],[5829,"من نجيع المحبرة","https://www.poetsgate.com/ViewPoem.aspx?id=180636",""],[5956,"في الجحيم بدونِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=193302",""],[5956,"يَدُ بنيَّ مربوطةٌ كعقولنا","https://www.poetsgate.com/ViewPoem.aspx?id=193399",""],[5956,"نُواح الكون على محمد عبده يماني","https://www.poetsgate.com/ViewPoem.aspx?id=194549",""],[6024,"عارض الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=186345",""],[6056,"مفهوم الأذواق","https://www.poetsgate.com/ViewPoem.aspx?id=130522",""],[6089,"الظلام الضالعُ","https://www.poetsgate.com/ViewPoem.aspx?id=213035",""],[520,"صرف النسيب الى اللوى وزرود","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577489",""],[6268,"شاعر في المنفى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82919&r=&rc=5",""],[6352,"حزت بالكاظمين شأنا كبيرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22745&r=&rc=6",""]],"verses":[["عَنْ كُلِّ مَوْثُوقٍ بِهِ إِسْنَادُهُ","بِالْقَطْعِ أَو بِالوَضْعِ غَيْرَ مَعِيبِ",0,"ب",1,0],["عن كل بنت ربيع","بحسنها تنتابه",1,"ب",2,0],["عن كفه أو صدره","تروي البحار الزاخره",2,"ر",2,0],["عن كل وضَّاح يُجلِّي الحنْدِسا","تَمَّمَ بي من مَجده ما أسَّسا",3,"س",2,0],["عن كل مملكة يذود همامها","اما العراق فليس فيه همام",4,"م",1,0],["عَنكِ إِن تَسأَلي فِدىً لَكِ نَفسي","ثُمَّ تَأتينَ غَيرَ ما تَزعُمينا",5,"ن",2,0],["عن كل شيء إذا ضيعته عوض","إلا الحياة فَما عن هذه عوض",6,"ض",1,0],["عَن كافِرٍ يَتَمَرّى","بِالكُفرِ بِالرَحمَنِ",7,"ن",1,0],["عن كُلِّ قَوسٍ صُروف الدهرِ ترشُقُهُ","فما لَهُ في سوى التسليمِ مُنتفَعُ",8,"ع",1,0],["عَن كُلِّ بَيتٍ صادِرٍ مائَةٌ","وَجَزاءُ مِثلي لَيسَ بِالنَزرِ",9,"ر",1,0],["عَن كُلِّ أَشنَبَ كالأَقَاحِى وازدَهَت","شُرُقاً صَبِيحَةَ لَيلَةٍ مِهطالِ",10,"ل",1,0],["عَنكَ جبريلُ قائلٌ لِلبراقُ","مِثلهُ ما حملتَ قطّ كَريما",11,"م",2,0],["عَنكُمُ يُؤخَذُ الوَفاءُ وَمِنكُم","يَجتَدي الناسُ كُلَّ خَيرٍ وَخيرِ",12,"ر",1,0],["عَنكُم رَوى الناسُ أَخبارَ الكِرامِ وَفي","قَديمِكُم جاءَتِ الأَياتُ وَالسُوَرُ",13,"ر",1,0],["عنك لا تخفى خُطوبٌ","خوفه قد زاد عِظْما",14,"م",2,0],["عن كلّ ما ألقاهُ يشغلُني","ذكرٌ وطيفٌ منكِ في بالي",15,"ل",2,0],["عَنكُم رَويت حَديث المُكرَماتِ وَعَن","حُبّي لَكُم يا بَني الصَديق لَم أَحل",16,"ل",1,0],["عن كُلِّ معدومِ القرِينِ مُكَرَّمٍ","ومعظَّمٍ فِي المالكينَ مُبجَّلِ",17,"ل",1,0],["عن كيد إبليس يا مولاي معتصم","بكم مخافة يغويني ويرديني",18,"ن",2,0],["عن كل هُجرٍ لكم صومٌ أجل ولكم","على شهيِ الثنا والحمدِ إِفطار",19,"ر",1,0],["عنكم ما نشاء إلا من ال","إسعاد يوم اللقاء والإسعاف",20,"ف",1,0],["عن كل إنسان لهيتُ وبعض ما","لاقيتُ يلهي العين عن إنسانها",21,"ن",3,0],["عَنكُمُ في الأَرضِ إِنّا مَذحِجٌ","وَرُوَيداً يَفضَحُ اللَيلَ النَهارُ",22,"ر",1,0],["عن كنت ناصرها فإني سيفها","والقتل لا يرضى بغير حسام",23,"م",1,0],["عن كلِّ كربٍ منه تشتدُّ الغرى","بنشر سرِّ لطفك انطوينا",24,"ن",2,0],["عن كان نطقٌ أنت فاتقُ رتقه","أو كان سيرٌ أنت فيه مساعدُ",25,"د",1,0],["عن كلِّ شخصِكَ في شُؤُنِكَ قاصِرٌ","فاقْصِرْ فزَعْمُكَ فوقَ ذاك عَناءُ",26,"ا",2,0],["عنكم ومنكم رُواةُ المجدِ قد أخذوا","عِلمَ المَعالي ولولاكم به جهِلوا",27,"ل",3,0],["عن كل بيت بيت مال صامت","إذ كل بيت قلب كل قصيد",28,"د",1,0],["عنكِ قَلبي قَد تَخَلَّى","خَلِّني باللهَّ عَنكِ",29,"ك",1,0],["عن كل أوصافه أبانت","عند الورى مثل ترجمان",30,"ن",1,0],["عن كل من سميت من إمام","عن النبي الصادق التهامي",31,"ي",1,0],["عنكم مسل من الأقوام كلهمو","إذا نثموا أنجماً للناس تهدونا",32,"ن",2,0],["عن كل ذي وصف ترفع شأنه","قد حل لا وصف له يستشعر",33,"ر",1,0],["عَن كلّ بَيت جَيّدٍ","أَلفاً فيصرف عَنه همّا",34,"م",2,0],["عَنْكَ بِما أَوْلَيْتَ فِي تَأَثُّثِ","لا خَيْرَ في وُدٍّ امْرِئٍ مُلَثْلِثِ",35,"ث",1,0],["عن كل ما يزري بارباب النهى","ويسيء باللبباء والعقلاء",36,"ا",2,0],["عنك السلام أَيا دنياي بعد سَنا","عَيني نعم أَي شمل غير مفترق",37,"ق",1,0],["عن كثير عفوت أنت حنانا","فاتمم الفوز عدتي واسترّنا",38,"ن",2,0],["عن كنت تعشقه حقا فمت كلفا","موله القلب في معناه مشغول",39,"ل",1,0],["عن كلفة سمحوا يوما متى جنحوا","والسهل يعرفهم بالبخل والجبل",40,"ل",1,0],["عَن كُلِّ دَمَّاعِ الثَرى مُظَلَّلِ","مِن أَيمُنِ القَرنَةِ ذاتَ الأَهجُلِ",41,"ل",1,0],["عن كل مكروهٍ ينجّيك","او حاسدٍ تِجْرَح كِلِمْته",42,"ت",2,0],["عن كربلا وبلائها سل كربلا","سل كربلا عن كربلا وبلائها",43,"ا",3,0],["عَن كُلِ واشٍ وَعرف المسك يَصحَبَهُ","فَبت مِن لَثم خَدٍّ عزَّ مَطلبه",44,"ه",1,0],["عَنْ كُلِّ عِلْمٍ لَمْ يَزَلْ مُسْتَفْحِصاً","وَالجِدُّ جِدٌّ أَحْسَنَ اسْتِفْحَاصِ",45,"ص",1,0],["عنك كما الحاسدُ فيك يشتهي","يصبحُ في كفيك منزوعَ العَمد",46,"د",1,0],["عَنْ كِلّ شخصٍ ودَّعك خاطري غَيْر","كِنّي مَعْك ودّعْت بفراقك بلاد",47,"د",1,0],["عن كُلّ رجسٍ لحرِّ الجمرِ مفترشِ","واربأ بأعظُمِه عن ذلكَ اللّهَبِ",48,"ب",1,0],["عَنكُم وَعَن أَهلِ البِلادِ وَأَنتُمُ","أَدرى بِما دَفَعَ الإِلهُ وَأعلَمُ",49,"م",1,0],["عن كل أزواجهِ أرضى وأوثرُ من","أضحت براءتها في الذكرِ منتشرَه",50,"ر",2,0],["عَنكُم أَخَذتُ وَفي سَنا أَقمارِكم","أَسرى وَخَطوَ فُحولِكُم أَتَرَسَّمُ",51,"م",1,0],["عن كُلِّ كُربَةٍ يمنُّ بالفَرَجِ","يَسلَكُ بى إلى مَعَارِيجِ النَهَجِ",52,"ج",1,0],["عَنك المُلوك اِنثنوا عَجزاً وَما علموا","أَأَنت زدت علواً أَم هُم سَفلوا",53,"ل",3,0],["عَنكَ يَكُن في مَطلَعِ الحِمَارِ","كُن عَارِفاً وَصفيَ مَع أشواري",54,"ي",1,0],["عَن كُلِّ شيءٍ قَدْ خَفيتَ وإنَني","لأراكَ في الأشياء بالآيات",55,"ت",1,0],["عنكم غريب أنا وكلٌ","منكم غريب معي عجيب",56,"ب",1,0],["عنك ويأبى الله إلا سوقها","إليك حتى قلّدوك طوقها",57,"ه",2,0],["عنكم عدمت اصطباري","يا من همُ خير عُربِ",58,"ب",1,0],["عنك العلم في كل مجهل","وخصمك مبتور الدليل مهين",59,"ن",1,0],["عنكَ وعن فتيانِكَ الأبرارِ","ذوي الإبا والعزّ والفخارِ",60,"ر",1,0],["عَنْ كِلّ مَحَلْ مَحَلَّهْ اطْيَبْ","حَفّ التوازن وعَ البطين آل",61,"ل",1,0],["عَنْ كِلّ بِنايه خَلْفَهْ اقْرَب","وانسب إلى المرّيخْ تِرْحال",61,"ل",1,0],["عنكم وعَقْد اصطِباري صار مَحْلولا","قَدْ قادني كَلَفاً مَا فِي مودتِكم",62,"م",1,0],["عَنكُم وَأَحيوا المكرُمات","كَي تَغنَموا الأَجرَ الحَسَن",63,"ن",1,0],["عَنكَ آخِذٌ","كلّ من فهم",64,"م",1,0],["عن كل فلتسأل خيبر","من كر هناك ومن أدبر",65,"ر",1,0],["عنك يا مرضى رقيبي","عل في الروض هزارا",66,"ر",2,0],["عَنكَ الأَغاني وَالغَواني الكاعبَهْ","وَدع التمسك بالأَماني اللاعبهْ",67,"ب",2,1],["عَنكَ التَمنعُ وَالدَلال فَلي حَشاً","يُكوَى وَجسمٌ كاد ضعفاً يختفي",68,"ف",2,0],["عنك التعلق بالمطامع أن تُرَى","غيدٌ أعزُّ على المؤمل طيفُها",69,"ه",2,1],["عَنكَبَاءُ أبدَت مَطارِفَ نَسجٍ","فَحَمَت مِثلَمَا حَمَت وَرقَاءُ",70,"ا",2,0],["عنكم إلى الأوطان ينثنونا","فينزل الويل على إليونا",71,"ن",2,0],["عنك ذكر اللئام دعه وخذلي","ذكر من يمطر النوال دواما",72,"م",2,0],["عنكم لم أسل في شيءٍ وفي","قربكم عن كل شيء قد سلوت",73,"ت",1,0],["عن كثبٍ وتكثر الحجاب","في بابكم عن غير أهل الرفد",74,"د",1,0],["عنك الشذا أم عن كبا يروي","ولك السنا أم للسما الجلوى",75,"و",2,1],["عَن كُنْهِهِ السُّوَرُ العُظْمَى مُحَدِّثَةٌ","وَلِلْمَزايا لَهُ والفَضْلِ مُورِثَةٌ",76,"ه",1,0],["عن كان موسى بن الرضا قد قضى","نحبا وعن دار الفنا قوَّضا",77,"ض",2,1],["عن كنهها عجز الملا","حتى أولو العزم الأولى",78,"ل",2,0],["عن كنه ذاتك غير أن","ك أوحدي الذات سرمد",78,"د",1,0],["عنك بذكر عبق التضوع","قسمته في الفرض والتطوع",79,"ع",1,0],["عن كل ضبعٍ يجيك اليوم متسبّع","جنّب ترى لو زأر يبقى ولد ضبعة",80,"ع",2,0],["عَن كَوْنِهِم كانُوا ضَحَاياهُ، أَو","عَن كَونِنَا صِرنا، وعَن كَوْنِهِ",81,"ن",2,1],["عَنكِ, أَم عَن جَوَارِحِي أَرحَلُ الآ","نَ, احتِمالًا حُدُوثُهُ لا يُطِيعُ؟!",82,"ع",1,0],["عَن كَلامٍ مُؤرِّقٍ, واحتراقٍ","مُستَطَابٍ, وضِحكَةٍ فُستُقِيَّة",83,"ق",3,0],["عن كيفها لم تدر أحلام. ليلتها","بمثل ما سهرت بالشوق عيناها",84,"ا",3,0],["عَن كِثرِ هَمي ما أبي تِسألوني/","يِكفي لِِفاني الهَم/و الروحِ طِفله",85,"ل",2,1],["عنك العزا ما يعزي لو تعزيته","عزاي ودي مثل ما أغليك تغليني",86,"ن",2,0],["عن كل من صلحوا فيها ومن فسدوا","طوتهم الأرض إفساداً وإصلاحا",87,"ح",2,0],["عن كل خائنةٍ تَغَافلُ مُعرضا","وتقىً يزينُ وطاعة وتعففُ",88,"ف",1,0],["عن كل معضلة، وكل عجيبة","مقرونة بتنافر الأضداد",89,"د",1,0],["عن كثير الهرج يغنيك القليل","كان توحي وانت وافي ومحشوم",90,"م",1,0],["عنْ كلِّ حُبٍّ قد اختارتْ محبتهُ","كنزاً ليومِ اللقا والحشرِ مُدَّخرا",91,"ر",2,0],["عن كنت يا من مستهل نظامه","عز الحزين لرفض آل محمد",92,"د",1,0],["عنك اصرف النظرات لا يلمحوني","ناس فكرهم حاد بالحيل وانعاج",93,"ج",1,0],["عن كلّ سائمةِ المباذلِ ينتهي","وعن الخيانةِ طبعهُ يترفّعُ",94,"ع",1,0],["عن كل شئٍ يمكنُ الإغضاءَ لكن","ما إن توارى الخبزُ لا شئ يهابُ",95,"ب",1,0],["عن كثرة الاشغال ناخذ فاصل","ونكرر اللي يفرضه مبدانا",96,"ن",2,0],["عن كنه معناه كل المطنبون وقد","أوتي البلاغة والإيجاز في الكلم",97,"م",1,0],["عن كل قلبٍ أفصحت فكأنها","علمت بما تخفي الصدور عليها",98,"ي",3,0],["عن كل نجم ظهر بسدل أجفاني","لعل ما عيش حزني لحظة غروبه",99,"ب",2,1],["عَنْ كُلِّ ذَا قَدْ صَرَفْتُ القَلْبَ مِنْ زَمَنٍ","فَاعْتَاضَ حَبَا بَدِيلاً زَادَنِي وَصَبَا",100,"ب",2,0],["عَن كُلِّ فَهمٍ عُزَّفاً","لَم يَدرِ بَينَ مَعنَاهَا يَفَن",101,"ن",1,0],["عن كل قهقهة من صرخة ثمن","وما استجد دم إلا وضاع دم",102,"م",1,0],["عن كل الاشواق شوق اغلاك","مناه بالشرع والديني",103,"ن",2,0],["عن كل مايردع أعدانا تراخينا","نرجع وراء مانسوق الركب قدامي",104,"م",2,0],["عَن كلِّ وعدٍ قُلتَهُ فيما مَضى","تأتي ليَ الأعذارُ مِنكَ تباعا",105,"ع",2,0],["عنْ كلِّ ما خَصَّ ارتباطكَ بي أرى","حُجَجاً تقولُ وَتلعنُ الأوْضاعا",105,"ع",2,0],["عن كلِّ مبذولٍ يَمُجُّ سماعَه","مَنْ مَدَّه الرحمنُ .. بالرُجْحان",106,"ن",1,0],["عن كلِّ واردةٍ تروي بلا وَجَلٍ","في ظاهرٍ نغمًا، في باطنٍ ولعا",107,"ع",2,0],["عن كل هول مسفرة","وكذا تدور المعصرة",108,"ر",2,0],["عنك النوى حريّةٌ ممجوجة","نلقى الحياة جميلة بسجونِكْ",109,"ك",1,0],["عن كل مغمور لتُبرز مجدَهُ","فيصيرُ مشهوراً يدرُّ رُضابا",110,"ب",2,0],["عنك الفراق هو الفراغ من الهنا","للعائشين وفيك يهْنا القبرُ",111,"ر",1,0],["عنكم نصحي ضلالا أو هدى","إن مثلي لم يفده قط نصح",112,"ح",1,0],["عنكم يانورالعين أنا ما تخليّت","بس الظروف أحكامها بُعد وفراق",113,"ق",1,1],["عن كل شاردةٍ أفتشُ إنها","من كل قاصية إليَّ تسارعُ",114,"ع",1,0],["عن كل مالٍ بيت مال صامتٌ","إذا كل بينت قلب كل قصيد",115,"د",1,0],["عن كؤوسٍ من المآسي شربناها","بحلمٍ من الشعاراتِ وَرْدِي",116,"د",2,0],["عنكَ ردّا باعَ الزمان قصيرا","واستطالا بهمة يأسران ال",117,"ا",2,0]]}