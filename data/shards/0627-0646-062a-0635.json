{"poems":[[36,"بانت لبينى فهاج القلب من بانا","https://www.aldiwan.net/poem4941.html","البسيط"],[29,"هاج الهوى وضمير الحاجة الذكر","https://www.aldiwan.net/poem5773.html","البسيط"],[23,"إن تصلح فإنك عابدي","https://www.aldiwan.net/poem21390.html","الوافر"],[53,"إن تصطنعني تصطنعني شاكرا","https://www.aldiwan.net/poem62884.html","الرجز"],[53,"أستغفر الله من هجائيكا","https://www.aldiwan.net/poem65780.html","المنسرح"],[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[47,"كثرت وفري بعد إقلال","https://www.aldiwan.net/poem65595.html","السريع"],[68,"إن تصحب السلطان كن محترسا","https://www.aldiwan.net/poem38573.html","الرجز"],[99,"أنت وحي العبقرية","https://www.aldiwan.net/poem24802.html","مجزوء الرمل"],[33,"يا أيها العاذل في حبها","https://www.aldiwan.net/poem41863.html","السريع"],[107,"يا أبا العاص أي أرض تريد","https://www.aldiwan.net/poem43996.html","الخفيف"],[52,"اسمعي يا خليد أنت الخلود","https://www.aldiwan.net/poem63922.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85856","المجتث"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54704","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[108,"تمثال فينوس","https://www.poetsgate.com/ViewPoem.aspx?id=179776",""],[60,"اصبرن يا بني فالصبر أحجى","https://www.poetsgate.com/ViewPoem.aspx?id=10875",""],[119,"قل لمحبوب دني","https://www.aldiwan.net/poem41212.html","عموديه"],[138,"إصبرن يا بني فالصبر أحجى","https://www.aldiwan.net/poem20988.html","الخفيف"],[146,"إن لم أكن من راضعى الخمر","https://www.aldiwan.net/poem58375.html","السريع"],[146,"ما ضاع من أيامنا هل يغرم","https://www.aldiwan.net/poem58446.html","الكامل"],[189,"أنت صديق الناس ما لم تكن","https://www.aldiwan.net/poem14654.html","السريع"],[208,"ريح شوق للبين كانت سموما","https://www.aldiwan.net/poem53185.html","الخفيف"],[208,"وافى مرابعه الغزال الأحور","https://www.aldiwan.net/poem53309.html","الكامل"],[234,"جعل الله كل عصر جديدا","https://www.aldiwan.net/poem51171.html","الخفيف"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[333,"هجع الكون يا حبيبي وعادت","https://www.aldiwan.net/poem54980.html","الخفيف"],[369,"ماذا يهيج غدوة شجني","https://www.aldiwan.net/poem60626.html","أحذ الكامل"],[371,"ما تطيب الدنيا لفقد حبيب","https://www.aldiwan.net/poem17093.html","الخفيف"],[382,"يا لحى الله علة التنكيد","https://www.aldiwan.net/poem59448.html","الخفيف"],[422,"من يحاول في الدهر مجدا أثيلا","https://www.aldiwan.net/poem54123.html","الخفيف"],[435,"إن تصحب الناس فكن صابرا","https://www.aldiwan.net/poem40723.html","السريع"],[475,"أكرع الكرعة الروية منها","https://www.aldiwan.net/poem4796.html","البسيط"],[500,"إن لم يكن هذا الصدود فصالا","https://www.aldiwan.net/poem10260.html","الكامل"],[572,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[572,"أجل هو الرزء جل فادحه","https://www.aldiwan.net/poem69740.html","مجزوء البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48532","الخفيف"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122351","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63825","السريع"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38390","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37960","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38336","الرمل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120088","الخفيف"],[1239,"","https://poetry.dctabudhabi.ae/diwan/poem/128276","الخفيف"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56568","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56642","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109261","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109182","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80055","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80052","الخفيف"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104696","الكامل"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28101","البسيط"],[2452,"","https://poetry.dctabudhabi.ae/diwan/poem/141053","الكامل"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82881","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200487","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204457","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110004","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128882","الخفيف"],[3782,"","https://poetry.dctabudhabi.ae/diwan/poem/124273","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103011","الخفيف"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29303","الخفيف"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29273","الخفيف"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32470","الخفيف"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136956",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120410","الكامل"],[4767,"بهدلة","https://www.poetsgate.com/ViewPoem.aspx?id=212767",""],[5050,"قسمت همي في العلا حصصا","https://www.poetsgate.com/ViewPoem.aspx?id=38210",""],[3271,"أنت دير الهوى ، وشعري صلاة","https://www.poetsgate.com/ViewPoem.aspx?id=102362",""],[5277,"طيرُ الثماد","https://www.poetsgate.com/ViewPoem.aspx?id=191142",""],[5377,"تحية الخروج من العزلة","https://www.poetsgate.com/ViewPoem.aspx?id=61892",""],[5425,"يَا طَاعِنَاً ... والمُستَحِيْلُ حِرَابُهُ (جيش العراق)","https://www.poetsgate.com/ViewPoem.aspx?id=198923",""],[5431,"صفقة العهر ...ليس من خان منّا","https://www.poetsgate.com/ViewPoem.aspx?id=209119",""],[5431,"دورة الشرّ","https://www.poetsgate.com/ViewPoem.aspx?id=213762",""],[5464,"يا هند","https://www.poetsgate.com/ViewPoem.aspx?id=6842",""],[5531,"أذكريني يامنيتي","https://www.poetsgate.com/ViewPoem.aspx?id=128418",""],[5763,"صهيلُ الكبرياء على فمِ عنيزةَ","https://www.poetsgate.com/ViewPoem.aspx?id=27058",""],[5848,"اطيب قلب","https://www.poetsgate.com/ViewPoem.aspx?id=53168",""],[5939,"لم يكن للورد ذنب","https://www.poetsgate.com/ViewPoem.aspx?id=178580",""],[5956,"سبقوا هتلر في نشر الإرهاب","https://www.poetsgate.com/ViewPoem.aspx?id=194646",""],[6069,"صدقوا ما لأنفس العشاق","https://www.poetsgate.com/ViewPoem.aspx?id=105693",""],[4442,"ساء العراق فأحسن الهند","https://www.poetsgate.com/ViewPoem.aspx?id=171217",""],[6152,"أمطريني بحنانكِ","https://www.poetsgate.com/ViewPoem.aspx?id=203400",""],[6267,"بَانَتْ لُبَيْنَى فَهَاجَ القَلْبَ مَنْ بانا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=8334&r=&rc=43",""]],"verses":[["إِن تَصرِمِ الحَبلَ أَو تُمسي مُفارِقَةً","فَالدَهرُ يُحدِثُ لِلإِنسانِ أَلوانا",0,"ن",2,0],["إِن تَصبِرِ التَيمُ مُخضَرّاً جُلودُهُمُ","عَلى الهَوانِ فَقَبلَ اليَومِ ما صَبَروا",1,"ر",3,0],["إِن تَصلُح فَإِنَّكَ عابِدِيٌّ","وَصُلحُ العابِدِيِّ إِلى فَسادِ",2,"د",1,1],["إن تصطنعْني تصطنعني شاكرا","أو تختدِعْني تختدعني عاذرا",3,"ر",2,1],["أنت صريحُ اللئام لا كذباً","وهم إذا حُصّلوا مواليكا",4,"ك",2,0],["إن تُصِبْ يومَ لذَّةٍ فبيومٍ","بعد يوم شهدته أرْونانِ",5,"ن",1,0],["إِن تَصِلِ القُربى لِمُدلٍ بِها","فَإِنَّ أَعمامَكَ أَخوالي",6,"ل",2,0],["إِن تَصحَبِ السُلطانَ كُن مُحتَرِسا","مُتقِنَ آدابِ الصَباحِ وَالمَسا",7,"س",2,1],["أنت صهباء السماوا","ت وروحٌ قُدُسيه",8,"ي",2,0],["أَنتَ صَحيحٌ مِن جَوى حُبِّها","وَحُبُّها لي سَقَمٌ داخِلُ",9,"ل",1,0],["أنتَ صِهرُ النبيِّ لا الوُدُّ ممنو","عٌ ولا البابُ مُوصَدٌ مَسْدُودُ",10,"د",1,0],["إِن تَصُدّي عَنّي فَلَستُ بِراءٍ","وَجهَ نَومي حَتّى يَموتَ الصُدودُ",11,"د",1,0],["إن تصدقوا فلماذا","تستنكرون الهلاكا",12,"ا",1,0],["إِنْ تَصْدُقُوا فِي حبِّهَا فَصَدَاقَةٌ","صَفْوُ القُلُوبِ وَنَبْذُ كُلِّ تَعَادِ",13,"د",1,0],["أَنْتَ صَوْتُ الضَّمِيرِ يَسْأَلُ عَدْلاً","حَيْثُمَا العَدْلُ رَحْمَةٌ وَسَدَادُ",14,"د",1,0],["أنتِ صُورُ الحياةِ قد بَعَثَ النا","سَ وكانوا جماجماً وجُلودا",15,"د",2,0],["إنْ تصقُلوا ذوقَ الشبا","ب، أمنتمو من شره",16,"ر",2,0],["إن تصبك المنون فالنبل تبرى","فمصيب منها وغير مصيبِ",17,"ب",1,0],["ان تصدى لخطاب","لا يرى عنه جوابا",18,"ب",2,0],["إِن تُصِبكَ المَنونُ فَالنَبلُ تَتَرى","فَمُصيبٌ مِنها وَغَيرُ مُصيبِ",19,"ب",1,0],["أنتَ صَرِيفِنْىِ وقُطْرُبُّلِى","وموضعُ الشكر من الدهرِ",20,"ر",1,0],["إن تَصنع الحسنَى فإنك زائدٌ","أو تُسبغ النُّعمَى فأنت متمّمُ",21,"م",1,0],["أنت صديقُ الناسِ ما لم تكنْ","ترغبُ فيما عندهم من حُطامْ",22,"م",1,1],["أنتَ صَحَّحتَ لي مودَّةَ أيّا","مي وقد كان ودُّهنَّ سقيما",23,"م",2,0],["إن تصطنعه تجده عبدك في الورى","ووليَّ نعمتك التي لا تكفرُ",24,"ر",1,0],["أنتَ صيّرت لي بنُعماك في","كلّ صباحٍ من المكارم عيدا",25,"د",2,0],["اِنتَصِح بِجِدّي لَو أَنَّ الأَنفُسَ اِحتَفَظَت","بِهِ فَرَقَّت حَواشيها وَما غَلَظَت",26,"ت",1,0],["أنت صيّرتها من البعد ثكلى","تتساقى مع الظلام نحيبي",27,"ي",1,0],["أنْ تُصْبِحي عَيْنَ البلادِ وما","لي فيكِ إنسانٌ يُلاحظُني",28,"ن",2,0],["إِن تَصِل مَن قَطَعتَ فَالعامُ يَومٌ","أَو تَدَع مَن وَصَلتَ فَاليَومُ عامُ",29,"م",1,0],["إن تصُن ما عهدتَ من ضنكِ عيشٍ","صرتَ حقّا إلى جنان الخلود",30,"د",1,0],["إنْ تصادم بها قواعد رضوى","أوشكت في صدامهم أن تزولا",31,"ل",2,0],["إن تصحب الناس فكن صابراً","واحمل على النفس أذى الصبرِ",32,"ر",1,1],["إِن تَصرِمِ الحَبلَ أَو تُرضِ الوشاةَ بِنا","أو تُمسِ قَد رَضِيت مِنّا بِأَبدالِ",33,"ل",1,0],["إن تصرمي صباً فقد شجيت به","لعساءُ يشجي ساقها الخلخالا",34,"ل",2,0],["إِنْ تَصْطَنِعْهُ عَلَى اخْتِيَارٍ","مِنْكَ فَمَا ضَاعَ الاصْطِنَاعُ",35,"ع",1,0],["إن تصمُتُوا عن دعائِهِمْ فلكُمْ","يومُ وغىً لا يُجاب صائحُهْ",36,"ح",2,0],["انتصرنا وما الذي قد جنينا","ه من النصر بعد طول العناء",37,"ا",2,0],["ان تصطنعني تصطنع لك شاعرا","سجدت لمحكم شعره الافهام",38,"م",1,0],["إن تصبح المهجة مأسورةً","فإِن دمعي غيرُ مأسور",39,"ر",1,0],["إِنْ تَصِرْ في إِضَم ثمّ العَقيقْ","أَو تَصِرْ قُربَ بَقيعِ الغَرقَدِ",40,"د",1,0],["إِنْ تَصِرْ سَيِّداً وَجيهَ أناسٍ","فائتِ في نَفعِهم تُعَدُّ نَبيها",41,"ه",2,1],["إِنْ تَصِلني في الهَوى","فَبِوَصلي أَسعَدُ",42,"د",1,0],["أنت صيرت كل حرّبا حسا","نك عبدا لا يطلب الدهر عتقا",43,"ق",2,0],["أنت صورت لي بساط سليما","ن ووطأ السماك في اقدامي",44,"م",2,0],["إن تصبروا فلطالما صبروا","أو تجزعوا فلشد ما جزعوا",45,"ع",3,0],["إن تصبري عني فقلبك هكذا","أما أنا فأخاف أن لا أصبرا",46,"ر",2,0],["إن تصرخ الصوت هنا","بمصر يُسمَع في عدن",47,"ن",1,0],["أنت صيرتني به","شاعر الزهر والربى",48,"ب",2,0],["إن تصفَّحته بعقلٍ تجده","كيف يهدي لمن تفهَّم عقلا",49,"ل",2,0],["إن تصفَّحته تجد كلَّ شطرٍ","فيه يحوي من المحاسن شطرا",50,"ر",2,0],["أَن تُصلِحَ النِّيَّاتِ فِى الاقوَالِ وَال","أَفعَالِ مِنَّا يا عَلِيمُ بِمَن أَسَر",51,"ر",1,0],["إِن تُصلِحوا أَمرَكُم تَصلُح جَماعَتُكُم","وفي الجَماعةِ ما يَستَمسِكُ العَمَدُ",52,"د",1,0],["إن تصطبر فالمجد أول جازع","أو تسل فالعلياء آخر واله",53,"ل",2,0],["أَنتَ صونُ النَّفسِ بل أَن","تَ لروح النَّفسِ قوت",54,"ت",1,0],["أنت صعبُ الدخول في الكيسيا فل","سُ وسهل الخروج تشبه...",55,"ه",1,0],["إن تصلني أجدْك عندي تسمو","ثم تهوي متى تسمني الجفاء",56,"ا",2,1],["إِنَّ تصعيدَ زفرتي في هواها","قطَّرَت دمعتي بلا توقيفِ",57,"ف",1,0],["ان تصدى للحكم كان كفر","عون على جهله بسيط المعاني",58,"ن",2,0],["ان تصبنوا عني للؤم كأسكم","وتنبذوني نبَذَ مرقوع الحذا",59,"ذ",2,0],["إن تصلني فصل وغلا فعدني","ربّما علّل السراب الاواما",60,"م",2,0],["أَنتِ صَمتٌ مُخيمٌ فَفَضاءٌ","فَظَلامٌ مُكَوكَبٌ فَنَهارُ",61,"ر",1,0],["أَنتَ صِنوُ الحَياةِ واِرثَةُ المَو","تِ وَنورٌ عَلى الإِلهِ يَرِفُّ",62,"ف",1,0],["إِن تَصِلني فَمِثلُكَ اليَومَ يُرجى","عَفوُهُ الذَنبَ عَن أَخيهِ وَوَصلُه",63,"ل",2,1],["انت صداح فقل لي ما الذي","حرّف الاسم فامسى صيدحا",64,"ح",2,0],["إن تصف دنيا ذي منى","عن غصة يستفظع",65,"ع",1,1],["أن تصمتي عِبءٌ على مَنكِبي","لا أستطيع الدهرَ أن أحمِله",66,"ل",2,0],["إن تصبروا تؤتوا نصركم","والله يولي من يشا فرصا",67,"ص",2,0],["أنت صفو الظلال تسبح في النّهْ","ر وتلهو على ضفاف الجدولْ",68,"ل",1,0],["أنت صدقُ الحبّ عندي والهوى","أنت من تورين في العشقِ زنادْ",69,"د",1,0],["أنت صوت الشعب اليماني المدوي","انت أقوى أحداثه الرنانه",70,"ن",2,0],["إِنْ تَصْطَخِبْ فَالجَارِحَاتُ تَوَابِعٌ","تَرجُو بِجَزْرِكَ مِنْ عِدَاكَ قَتِيْلا",71,"ل",2,0],["إنْ تصير السماء فوقي ركاما","لست أخشى ركامها ..لست أُعنى",72,"ن",2,0],["إنْ تصافت نفوسهم وتسامت","حذف الراء : حاؤهم والباءُ",73,"ا",2,0],["إنْ تَصْدِقي وعداً فقد ضَحِكتْ","شمسي وَمَدَّ بساطَه الودُّ",74,"د",1,0],["أنتِ صَوْتٌ آتٍ من اللهِ أسْرى","في كياني ودارَ في أفْلاكي",75,"ك",2,0],["أنتِ صهيلُ الكبرياءِ على فمي","ولحونُ مجدٍ في دمي تتوقدُ",76,"د",1,0],["إنتصف ليلي وليلك ووقت الدمع حان !","طاب سوق الدمع فالعين من طيب الزبون !!",77,"ن",1,0],["أن تَصيري أنتِ أنثى لي، جديرٌ بافتخارِكْ","فَارْوِني بالحبِّ عُمرًا تاقَ زهري لانهمارِكْ",78,"ك",1,0],["انتصار الحق سلمٌ وضياء..","وانكسار البُطل مجد مستتبْ",79,"ب",1,0],["أنت صبٌ وتلك أولى المطايا","فامزج الدمع بالدم المهراق",80,"ق",1,0],["أن تصبح الأقدار حاكمة","فينا بحكم ماله رد",81,"د",1,0],["أنتِ صبحي ومشرقي وضيائي","وشفائي إذا غدوت سقيما",82,"م",2,0],["إن تصرمي الحبل أو تُمسي مُفارقة ً","فالدَّهْرُ يُحدِثُ للإنْسَانِ ألْوَانَا",83,"ن",2,0]]}