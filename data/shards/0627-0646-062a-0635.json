{"poems":[[34,"بانت لبينى فهاج القلب من بانا","https://www.aldiwan.net/poem4941.html","البسيط"],[27,"هاج الهوى وضمير الحاجة الذكر","https://www.aldiwan.net/poem5773.html","البسيط"],[23,"إن تصلح فإنك عابدي","https://www.aldiwan.net/poem21390.html","الوافر"],[51,"إن تصطنعني تصطنعني شاكرا","https://www.aldiwan.net/poem62884.html","الرجز"],[51,"أستغفر الله من هجائيكا","https://www.aldiwan.net/poem65780.html","المنسرح"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[45,"كثرت وفري بعد إقلال","https://www.aldiwan.net/poem65595.html","السريع"],[66,"إن تصحب السلطان كن محترسا","https://www.aldiwan.net/poem38573.html","الرجز"],[97,"أنت وحي العبقرية","https://www.aldiwan.net/poem24802.html","مجزوء الرمل"],[31,"يا أيها العاذل في حبها","https://www.aldiwan.net/poem41863.html","السريع"],[105,"يا أبا العاص أي أرض تريد","https://www.aldiwan.net/poem43996.html","الخفيف"],[50,"اسمعي يا خليد أنت الخلود","https://www.aldiwan.net/poem63922.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85856","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54704","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[106,"تمثال فينوس","https://www.poetsgate.com/ViewPoem.aspx?id=179776",""],[58,"اصبرن يا بني فالصبر أحجى","https://www.poetsgate.com/ViewPoem.aspx?id=10875",""],[115,"قل لمحبوب دني","https://www.aldiwan.net/poem41212.html","عموديه"],[134,"إصبرن يا بني فالصبر أحجى","https://www.aldiwan.net/poem20988.html","الخفيف"],[142,"إن لم أكن من راضعى الخمر","https://www.aldiwan.net/poem58375.html","السريع"],[142,"ما ضاع من أيامنا هل يغرم","https://www.aldiwan.net/poem58446.html","الكامل"],[185,"أنت صديق الناس ما لم تكن","https://www.aldiwan.net/poem14654.html","السريع"],[204,"ريح شوق للبين كانت سموما","https://www.aldiwan.net/poem53185.html","الخفيف"],[204,"وافى مرابعه الغزال الأحور","https://www.aldiwan.net/poem53309.html","الكامل"],[229,"جعل الله كل عصر جديدا","https://www.aldiwan.net/poem51171.html","الخفيف"],[320,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[328,"هجع الكون يا حبيبي وعادت","https://www.aldiwan.net/poem54980.html","الخفيف"],[364,"ماذا يهيج غدوة شجني","https://www.aldiwan.net/poem60626.html","أحذ الكامل"],[366,"ما تطيب الدنيا لفقد حبيب","https://www.aldiwan.net/poem17093.html","الخفيف"],[377,"يا لحى الله علة التنكيد","https://www.aldiwan.net/poem59448.html","الخفيف"],[416,"من يحاول في الدهر مجدا أثيلا","https://www.aldiwan.net/poem54123.html","الخفيف"],[429,"إن تصحب الناس فكن صابرا","https://www.aldiwan.net/poem40723.html","السريع"],[470,"أكرع الكرعة الروية منها","https://www.aldiwan.net/poem4796.html","البسيط"],[495,"إن لم يكن هذا الصدود فصالا","https://www.aldiwan.net/poem10260.html","الكامل"],[567,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[567,"أجل هو الرزء جل فادحه","https://www.aldiwan.net/poem69740.html","مجزوء البسيط"]],"verses":[["إِن تَصرِمِ الحَبلَ أَو تُمسي مُفارِقَةً","فَالدَهرُ يُحدِثُ لِلإِنسانِ أَلوانا",0,"ن",2,0],["إِن تَصبِرِ التَيمُ مُخضَرّاً جُلودُهُمُ","عَلى الهَوانِ فَقَبلَ اليَومِ ما صَبَروا",1,"ر",3,0],["إِن تَصلُح فَإِنَّكَ عابِدِيٌّ","وَصُلحُ العابِدِيِّ إِلى فَسادِ",2,"د",1,1],["إن تصطنعْني تصطنعني شاكرا","أو تختدِعْني تختدعني عاذرا",3,"ر",2,1],["أنت صريحُ اللئام لا كذباً","وهم إذا حُصّلوا مواليكا",4,"ك",2,0],["إن تُصِبْ يومَ لذَّةٍ فبيومٍ","بعد يوم شهدته أرْونانِ",5,"ن",1,0],["إِن تَصِلِ القُربى لِمُدلٍ بِها","فَإِنَّ أَعمامَكَ أَخوالي",6,"ي",1,0],["إِن تَصحَبِ السُلطانَ كُن مُحتَرِسا","مُتقِنَ آدابِ الصَباحِ وَالمَسا",7,"س",2,1],["أنت صهباء السماوا","ت وروحٌ قُدُسيه",8,"ي",2,0],["أَنتَ صَحيحٌ مِن جَوى حُبِّها","وَحُبُّها لي سَقَمٌ داخِلُ",9,"ل",1,0],["أنتَ صِهرُ النبيِّ لا الوُدُّ ممنو","عٌ ولا البابُ مُوصَدٌ مَسْدُودُ",10,"د",1,0],["إِن تَصُدّي عَنّي فَلَستُ بِراءٍ","وَجهَ نَومي حَتّى يَموتَ الصُدودُ",11,"د",1,0],["إن تصدقوا فلماذا","تستنكرون الهلاكا",12,"ا",1,0],["إِنْ تَصْدُقُوا فِي حبِّهَا فَصَدَاقَةٌ","صَفْوُ القُلُوبِ وَنَبْذُ كُلِّ تَعَادِ",13,"د",1,0],["أَنْتَ صَوْتُ الضَّمِيرِ يَسْأَلُ عَدْلاً","حَيْثُمَا العَدْلُ رَحْمَةٌ وَسَدَادُ",14,"د",1,0],["أنتِ صُورُ الحياةِ قد بَعَثَ النا","سَ وكانوا جماجماً وجُلودا",15,"د",2,0],["إنْ تصقُلوا ذوقَ الشبا","ب، أمنتمو من شره",16,"ر",2,0],["إن تصبك المنون فالنبل تبرى","فمصيب منها وغير مصيبِ",17,"ب",1,0],["ان تصدى لخطاب","لا يرى عنه جوابا",18,"ب",2,0],["إِن تُصِبكَ المَنونُ فَالنَبلُ تَتَرى","فَمُصيبٌ مِنها وَغَيرُ مُصيبِ",19,"ب",1,0],["أنتَ صَرِيفِنْىِ وقُطْرُبُّلِى","وموضعُ الشكر من الدهرِ",20,"ر",1,0],["إن تَصنع الحسنَى فإنك زائدٌ","أو تُسبغ النُّعمَى فأنت متمّمُ",21,"م",1,0],["أنت صديقُ الناسِ ما لم تكنْ","ترغبُ فيما عندهم من حُطامْ",22,"م",1,1],["أنتَ صَحَّحتَ لي مودَّةَ أيّا","مي وقد كان ودُّهنَّ سقيما",23,"م",2,0],["إن تصطنعه تجده عبدك في الورى","ووليَّ نعمتك التي لا تكفرُ",24,"ر",1,0],["أنتَ صيّرت لي بنُعماك في","كلّ صباحٍ من المكارم عيدا",25,"د",2,0],["اِنتَصِح بِجِدّي لَو أَنَّ الأَنفُسَ اِحتَفَظَت","بِهِ فَرَقَّت حَواشيها وَما غَلَظَت",26,"ت",1,0],["أنت صيّرتها من البعد ثكلى","تتساقى مع الظلام نحيبي",27,"ي",1,0],["أنْ تُصْبِحي عَيْنَ البلادِ وما","لي فيكِ إنسانٌ يُلاحظُني",28,"ي",1,0],["إِن تَصِل مَن قَطَعتَ فَالعامُ يَومٌ","أَو تَدَع مَن وَصَلتَ فَاليَومُ عامُ",29,"م",1,0],["إن تصُن ما عهدتَ من ضنكِ عيشٍ","صرتَ حقّا إلى جنان الخلود",30,"د",1,0],["إنْ تصادم بها قواعد رضوى","أوشكت في صدامهم أن تزولا",31,"ل",2,0],["إن تصحب الناس فكن صابراً","واحمل على النفس أذى الصبرِ",32,"ر",1,1],["إِن تَصرِمِ الحَبلَ أَو تُرضِ الوشاةَ بِنا","أو تُمسِ قَد رَضِيت مِنّا بِأَبدالِ",33,"ل",1,0],["إن تصرمي صباً فقد شجيت به","لعساءُ يشجي ساقها الخلخالا",34,"ل",2,0],["إِنْ تَصْطَنِعْهُ عَلَى اخْتِيَارٍ","مِنْكَ فَمَا ضَاعَ الاصْطِنَاعُ",35,"ع",1,0],["إن تصمُتُوا عن دعائِهِمْ فلكُمْ","يومُ وغىً لا يُجاب صائحُهْ",36,"ح",2,0]]}