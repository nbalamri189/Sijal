التقت أجناده","بالمفسد العاتي فرد مفللا",1,"ل",2,0],["فِي البَوَادِي وَفِي الحَوَاضِرِ عَهْدٌ","حَفَظَتْهُ لِهَاشِمٍ وَذِمَامُ",2,"م",1,0],["فِي البَحْرِ أَوْ فِي البَرِّ زِينَاتٌ إِلَى","أَقْصَى مَدًى وَتَأَلُّبٌ وَزِحَامُ",3,"م",1,0],["في البيت بعد وفاق في الهوى دعة","وفيه بعد خلاف في الهوى جدل",4,"ل",1,0],["في البِناءِ العَجيبِ وَالمَنزِلِ الآ","نِسِ وَالمَنظَرِ الجَميلِ البَهِيِّ",5,"ي",1,0],["في البحر، في تنفس المراعي","وفي غناء كل عندليب",6,"ب",1,0],["فيا لبضاعةٍ للكُفرِ تُزْجَى","ويا للشّوقِ يَجمعُ كُلَّ شارِ",7,"ر",1,0],["في البَدرِ مِن صَفحَتِهِ لَمحَةٌ","وَلَمحَةٌ في الظَبيِ مِن طَرفِهِ",8,"ف",2,0],["في البَدوِ خُرّابُ أَذوادٍ مُسَوَّمَةٍ","وَفي الجَوامِعِ وَالأَسواقِ خُرّابُ",9,"ب",1,1],["في البحر مد وجزر يعبثان به","والمد والجزر مفعولان للقمر",10,"ر",1,0],["في البر وَالبحر نارٌ","وَفي السَماء دويّ",11,"ي",1,0],["في البْبَرِّ في الْبَحْر ومِنْ فَوْقِهِمْ","لم يَتْرُكِ الْمَوْتُ لَهُمْ مَوْضِعا",12,"ع",2,0],["في البَدْوِ لوَّحها الهجيرُ فلم تجدْ","إلاّ ظِلالَكَ نُجعةَ المُلْتاح",13,"ح",1,0],["فيا لبني القرآن أين عقولكم","وقد عصفت هذي الرياح الزعازع",14,"ع",1,0],["في البدء كان النَهْدُ، والسَفْحُ هو استثناءْ","في البدءِ كنتِ أنتِ.. ثم كانتِ النساءْ",15,"ا",2,0],["في الْبَرِّ في الْبَحْر ومِنْ فَوْقِهِمْ","لم يَتْرُكِ الْمَوْتُ لَهُمْ مَوْضِعا",16,"ع",2,0],["في البيت في ظل الفناء كأنني","اسلمت حيا للفناء عناني",17,"ن",2,0],["في البر والبحر هَلْ تلقى له مثلا","في عَدْله من ملوكٍ أو سلاطينِ",18,"ن",1,0],["فَيا لبني فِهرٍ أَفيقوا وَلَم تَقُم","نَوائِحُ قَتلى تَدَّعي بِالتَنَدُّمِ",19,"م",1,0],["فيا لبدرِ تمامٍ بات في عضدي","حتى إذا طلعتْ شمسُ الضحى أَفلا",20,"ل",2,0],["في البحر والموج عات","سبحت حتى تعبت",21,"ت",1,0],["في البحر والبحر آفاق وأودية","شتى الأعاجيب من نور وظلماء",22,"ا",2,0],["في البَأْسِ أنت من المنصورِ مخترَع","وفي العلا من معز الدين مشقوق",23,"ق",1,0],["في البيت لي درة يحدث عن","أفعالها الموغلون في الشارع",24,"ع",1,1],["في البرتغالِ وإسبانيّةَ ازدهرت","آدابُنا وسمت دهراً مبانينا",25,"ن",2,0],["فِي البَحْرِ لَمْ تَبْرَحْ فَمَا جَدْوَى الحَيا","وَالبَحْرُ يُبْعَث بِالسحائِبِ فِيها",26,"ي",3,0],["في البُخل عن مُزيِّد","مع رَبربٍ لتَهتَدي",27,"ي",1,0],["في البثِّ شكرٌ بِاِعتِقادك أنّه","يُشكى فَمن لم يَشتكِ لم يشكرِ",28,"ر",1,0],["في البَحر ترجفُ دائِماً مِن خَوفِهِ","لَو تَرتَجيه مَأمَناً مِن حيفها",29,"ه",2,0],["في البِيِد بُعْدٌ وفي أحبابِنا بَخَلٌ","فمَن هَداهُ ومَن يا قومُ أهْداه",30,"ا",2,0],["في البعد عن الأفه والأصحاب","أهل المحبة واليقين",31,"ن",1,0],["فَيَا لِبُروقٍ لَمْ يَزَلْنَ صواعِقاً","عَلَى الكُفْرِ غَيْثُ الأَمْنِ منهُنَّ ساجِمُ",32,"م",1,0],["في البأس والنصر والاقدام جيش وغى","جَمُّ البنودِ وفي الحاظنا رجلُ",33,"ل",1,0],["في البَرايا صَاحَ شَهمٌ","طيِّبٌ ذو ألمَعِيَّه",34,"ه",1,1],["في البرايا كالتُّهامي","مُستحيلٌ في الأنامِ",35,"م",1,1],["في البَرايا نِدُّ فَخرِ","وعُلا ذَلِكَ ذُخري",36,"ي",1,1],["في البَرايا نِدُّ فَخرٍ وعُلا","ذلِك الحِصنُ تُهامِىُّ الأَنام",37,"م",1,1],["في البُعدِ نقدحُ نجوانا كما انْقَدَحَتْ","من شُعلةِ الغيبِ أحلامُ المُرِيدِينا",38,"ن",2,0],["في الباطن الكفر الذي","بظهور رب العالمين",39,"ن",1,0],["في الباطن كن لنا حفيظاً","والظاهر من يد استنادك",40,"ك",1,0],["في البَيتِ ذي الحَسَبِ الرَفيعِ وَمِن","أَهلِ التُقى وَالبِرِّ وَالصِدقِ",41,"ق",1,0],["في البدء كنت حسبتها ملكا ولم","تعلم تفوقها على الشيطان",42,"ن",1,0],["في البدء أسسه وقدسه لنا","ولذاك فهو مقدس ومكرّم",43,"م",1,0],["في البر نصف الجسم عار انما","في البحر كل مخبأ لك يظهر",44,"ر",1,0],["في البيتِ قد طافَ سَبعاً حول كعبتهِ","وفيهِ لبّى مُطيعاً مُحرماً وسَعى",45,"ع",2,0],["في البيتِ طُفتَ ببرد عزٍّ رافلاً","وَعَلى المكارمِ شدّ فيك المئزرُ",46,"ر",1,0],["في البراري مِثلُ البُزاةِ أو الكُد","ري تَهاوَى في مَهمَهٍ رحراح",47,"ح",1,0],["في البر يلقى وان فتشت عنه تجد","في لجة البحر يلقى خمسه الثاني",48,"ن",2,0],["فيا لبَني الإسلامِ كم من سعادةٍ","حَوَوْها بأيدي الأشقياءِ بني الكفر",49,"ر",1,0],["في البيت ما غاب عن جهاز رسو","ل الله في دفنه ولا الغسل",50,"ل",1,0],["في البانِياسِ إِذا أوطِئتَ ساحَتَها","خَوفٌ وَحيفٌ وَإِقلالٌ وَإِفلاسُ",51,"س",1,1],["في البعيد البعيد خلف مدى الابصار","طيفانِ يسحبانِ الهوانا",52,"ن",2,1],["في البدء كنتِ وكنتُ لم","يكن النهار ولا الليالي",53,"ل",2,0],["في البيت أو في روضة","أزهارها كالشهب",54,"ب",1,0],["في البُعد نشعر بالشوق ولوعته","به نغالب ما فيه وما فينا",55,"ن",2,0],["في البال يحملني الهوى","في الظنّ أخطرُ مثل ظنّ",56,"ن",1,0],["في البرد والربيع والخريف","أما المصيف فهو شيءٌ ثاني",57,"ي",1,0],["في البرتغال له يد مذكورة","وله بأرض الفرس أسوأ فال",58,"ل",1,0],["في الباقيات الصالحات زهت لها","بالخلد في لوح الوجود سطور",59,"ر",1,0],["في البيت بيت معد","فخم الذرى والمباني",60,"ن",2,0],["في البر والبحر لا ينسون أكلهم","كلا ولا شربهم في الحلّ والحرم",61,"م",1,0],["في البيت من هاشم العلياء نسبتهم","والنعت من احمد المبعوث للأمم",62,"م",1,0],["في الباب آثار عظيم شأنها","أعيت على العلماء في الأزمان",63,"ن",1,0],["فَيالَبَني ذُبيانَ بَكّوا عَميدَكُم","بِكُلِّ رَقيقِ الحَدِّ أَبيَضَ باتِرِ",64,"ر",1,0],["في البحر عنها اقليمُ كَندَلوسِ","نُظِّمَ في الكترةِ عن مالوسي",65,"ي",1,0],["في البَحرِ إلاّ القُمر وَالجَزَاير","مَا بَينَهُ وَالمُولِ بالأشَاير",66,"ر",1,0],["فيال بني سهل أضفتم جماعتي","وآويتموني يوم خرب موطني",67,"ن",2,0],["فيال بني عبد المدان عمومتي","ويال بني همدان يا آل منصبي",68,"ب",2,0],["في البر أو في البحر أو هذا وذا","يغشى الأعادي كالأذيّ المزبد",69,"د",1,0],["في البر قد فاق كل بر","وفيضه دونه البحور",70,"ر",1,0],["في البساتينِ والحدائقِ قد أص","بحنَ في حِلية منّ الألوانِ",71,"ن",1,0],["في البحر مَدٌّ بعده جزر","وبتلك مَدٌّ ما له جزر",72,"ر",1,0],["في البحر أحلم هانئا","والبحر مثلي يحلم",73,"م",1,0],["في البر نجمع آلاماً الى كدرٍ","وأنت تقبلها يا واسع الصدر",74,"ر",1,0],["في البحر آلاف بحر","لو كنت تمعن فكرا",75,"ر",2,0],["فِيْ البيض كي خيَّست لِعْيال؟","ما هوب هذا منّك باغين",76,"ن",1,0],["في البرايا من سوى أم الحسين","للنبي المصطفى قرة عين",77,"ن",1,0],["في البدء بالثاني على الأخير","وهو ألا واسمع من الخبير",78,"ر",1,0],["فِى البَاقِيَاتِ وَاضطِرَاراً خَفَّفا","مِنِّى وعَنِّى بَعضُ مَن قَد سَلَفَا",79,"ف",2,0],["فِى البُعدِ أو بِثَمَّ فُه أو هَنَّا","أو بِهُنَالِكَ انطِقَن أو هِنَّا",79,"ن",2,0],["في البطن مني جنين طاب رشدكم","فأحرزوا المال حتى نعرف الحبلا",80,"ل",2,0],["في الباس والهمة والاحسان","فاق سلاطين بني عثمان",81,"ن",1,0],["في البئر من قاتل الجن العتاة ومن","قد قاد عمرو بن معد يكرب للكرب",82,"ب",1,0],["في البدءِ صعبٌ كشفُها عَسِرٌ على","أَيِّ الفهومِ ومُبهَم الإِشعارِ",83,"ر",1,0],["في الباقيات الصالحات لَهم غداً","حورٌ مطهرَّةٌ وَقَصرٌ مُشرِفُ",84,"ف",1,0],["في البرايا وخلقهم أطواراً","حكمة تترك العقول حيارى",85,"ر",2,1],["في البحر فهي امان الفلك من غرقٍ","ان السفيند باسم اللَه مجراها",86,"ا",3,0],["في البرق لي شاغل عن لمعة البرق","بدا وكان متى ما يبد لي يشق",87,"ق",1,1],["فيا لبني قومي بذا الصقع هل يكن","خليفة والينا مثيلا يقاربه",88,"ب",2,0],["في البَعْثِ مُخْتَلِفٍ في الفَضْلِ مُفْتَرِقٍ","فَيا نَبِيّاً بَفَضْلٍ فيه مُتَّسِقٍ",89,"ق",1,0],["في البرّ وَالبَحر وجوفِ السَما","لَهيبُ نيرانِكِ لَم يَخمدِ",90,"د",1,0],["في البرايا نثرتَ غرَّ مزايا","نظمتها بمدحك الشعراء",91,"ا",2,0],["في البدء باسمك ربي والصلاة على","رسولك الأجر يا من جاد بالنّعَم",92,"م",1,0],["فى البدء قال: اقرأ ..قرأت فصاح بى","لقد اصطفاك الحزن للاسراء",93,"ا",2,0],["في الْبَيْتِ أمٌّ وَ هل تخفى أمُومَتُها ؟","فإِنَّ فى الشمسِ دفأً ليسَ في القمر",94,"ر",1,0],["في الباديه واحلامها في المدينه","ولها الفخر لو كل شيٍ خذلها",95,"ل",3,0],["في البابِ قَتلَى وجَرحَى لَستَ تَعرِفُهُم","عاشُوا وماتُوا لِزَرعِ الحُزنِ في الأُسَرِ",96,"ر",1,0],["في البَدءِ كانَ الحُبُّ لِي جَنَّةً","مِن ثَمَّ تَدعُونِي.. وتَأتِي.. وثَمْ",97,"م",1,0],["فِي البَالِ مَا لا يَنْحَكِيْ يَا (فِيْسُ)","نَحِّ التَّسَاؤُلَ .. فَالجَوَابُ حَبِيْسُ",98,"س",1,1],["فِي البَالِ قَافِيَةٌ تَطِييييرُ , وشَاعِرٌ","وَجْهُ السَّمَاءِ بمُقْلَتَيْهِ بَئِيسُ",98,"س",1,0],["فِي البَالِ أرْصِفَةٌ تَئِنُّ .. وحَوْلَهَا","وَطَنٌ يُحَاصِرُ صُبْحَهُ البُوْلِيسُ",98,"س",1,0],["فِي البَالِ أُغنِيَةٌ تَضَوَّرُ , والحَصَى","فِي القِدْرِ تَغْلِيْ , والعيونُ وَطِيسُ",98,"س",1,0],["فِي البَالِ نَافِذَةٌ .. وضِيْقٌ وَاسِعٌ","لا الضِّيْقُ يُعْتِقُهَا ولا التَّنْفِيسُ",98,"س",1,0],["فِي البَالِ إبلِيسٌ يُعَاتِبُ نَفسَهُ","مَاذَا لَدَيْكَ لِمَنْ بهِ إبْلِيسُ ؟",98,"س",1,0],["في البيت كانوا في ط