{"poems":[[88,"هذا صبي هائم","https://www.aldiwan.net/poem10861.html","مجزوء الكامل"],[91,"ما قلت شيئا بفمي","https://www.aldiwan.net/poem45093.html","الرجز"],[82,"أين مني عتب أحباب هجود","https://www.aldiwan.net/poem31481.html","الرمل"],[107,"أقبلوا أو فاتقوا سوء المرد","https://www.aldiwan.net/poem44205.html","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30500","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54243","الرمل"],[103,"يالواءَ الحسنِ أحزابُ الهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62457&r=&rc=49",""],[230,"يا لواء الحسن أحزاب الهوى","https://www.aldiwan.net/poem55176.html","الرمل"],[240,"ما لي أرضى والبحر معترض","https://www.aldiwan.net/poem32091.html","المنسرح"],[287,"فيك عذولي عذرا","https://www.aldiwan.net/poem32763.html","مجزوء الرجز"],[406,"وهج الحب","https://www.aldiwan.net/poem6703.html","عموديه"],[422,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[463,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[563,"أنا بالله عارف","https://www.aldiwan.net/poem34348.html","مجزوء الخفيف"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35358","البسيط"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145106","الرجز"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18455","الرجز"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44880","السريع"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27693","السريع"],[2496,"","https://poetry.dctabudhabi.ae/diwan/poem/100435","السريع"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88909","السريع"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136525",""],[4534,"","https://poetry.dctabudhabi.ae/diwan/poem/145385","السريع"],[5136,"لا يعود العدو فيك صديقاً","https://www.poetsgate.com/ViewPoem.aspx?id=121495",""]],"verses":[["يَقذى بِرُؤيَتِهِ فَلا","تَلوي عَلَيهِ عَينُ ناظِر",0,"ر",1,0],["يقذف من فوهته","قذائفاً من حمم",1,"م",1,0],["يَقذِفُ الحربَ بِجَيشٍ لَجِبٍ","مُشْرَعِ الأَرماحِ مِقدامِ الجُنود",2,"د",1,0],["يقذف الوادي بهم قَذْفَ الحصى","تبلغُ الريحُ بهِ أقصى الأمدْ",3,"د",1,0],["يقذِفُكِ التيَّار في لجِهِ","عشواءَ لا يهديكِ فيهِ شعاعْ",4,"ع",1,0],["يَقْذِفْنَ دُرَّ الدَّمْعِ في يَوْمِ النَّوَى","عن جُمّةٍ لَعِبَ الأَسَى بجُمانِهَا",5,"ن",3,0],["يقذف الشوق بها في مائجٍ","ماله من ساحلٍ إلاّ الّقَاء",6,"ا",2,0],["يقذف الشوق بها في مائجٍ","ماله من ساحلٍ إلاّ اللِّقَاء",7,"ا",2,0],["يَقذِفُ الشوقُ بها في مائجٍ","بين لُجَّينِ عناءٍ وَشَقاء",8,"ا",2,0],["يَقذِفُ لِلناسِ مِن جَواهِرِهِ","ما يَكفي مِنهُ سِوى الزَبَدِ",9,"د",1,0],["يَقذِفُ بحرُ صَدرِهِ","من لفظِ فيهِ الدّرَرا",10,"ر",2,0],["يَقْذِفُ الوَهْمَ للعقول، وَيُلْقي","رَحْلَه عند وَهْمِه مُستكينا",11,"ن",2,0],["يقذف من فيه الجمان لفظه","بحر ولكن بالعلوم قد طمى",12,"ا",1,0],["يُقذي علاه مقصِّرٌ لحِزٌ","لو قُيِّد الفضلُ زِيدَ فيه عَمَى",13,"م",2,0],["يقذف الله قلت بال","حق وهي اللطائف",14,"ف",1,0],["يَقذِفُ بِالدُرِّ وَهوَ البَحرُ مُنفَرِداً","وَالبَحرُ يَقذِفُ بِالدُرِّ وَبِالزَبَدِ",15,"د",1,0],["يقذف كل خادع محتال","ولم يزل يخطُر كالرئبال",16,"ل",1,0],["يَقذَمنَ جَرعاً يَقصَعُ الغَلائِلا","وَكَرِهَت أَحناشُها العَرازِلا",17,"ل",2,0],["يَقذِفُ بِالنارَنجِ في بِركَةٍ","كَلاطِخٍ بِالدَمِ سُودَ الدُّروع",18,"ع",1,0],["يقذف الرعب في القلوبِ ارتجافاً","والمساوى تَمُرُّ بالأذهانِ",19,"ن",1,0],["يقذفُ الرعبَ في قلوبِ الضواري","لتولي عن ساكنِ القيعانِ",19,"ن",1,0],["يقذفُ بالحق على باطلٍ","يدمغه وقتاً فلم يدمغ",20,"غ",1,0],["يقذف بالزورق من خاله","فليس يدري أين مرساه",21,"ا",2,0],["يقذي بغضّ جفن جنيّة","جبين زفت ضيفن في ظنيب",22,"ب",1,0],["يقِذفُه الوجد بكفّ الجوَى","ولو قضَى نحباً به لاستراح",23,"ح",1,0],["يقذف بالماء على حينه","كأنه عاف الذي قبله",24,"ه",1,0],["يقذف المرء حين يقدح بالنار","وإن حل برهة في الماء",25,"ا",2,0]]}