1],["مَن رَأى البارِقَ في مَجنوبَةٍ","هَبَّةَ البارِقِ قَد راعَ الظَلاما",1,"م",2,0],["مِن رِجالٍ رَكِبوا المَج","دَ فَما ذَمّوا عَنيقَه",2,"ق",2,0],["مِن رِجالٍ جَنَوا لَكُم ثَمَرَ المَج","دِ عَريضاً وَعاقَروا المَوتَ صِرفا",3,"ف",2,0],["مَن رَأى قَبلَكُم شُموساً مُضِيّا","تٍ جَمَعنَ الأَنوارَ وَالأَمطارا",4,"ر",2,0],["مَن رَأى البَرقَ بِغَورِيِّ السَنَد","في أَديمِ اللَيلِ يَفري وَيَقِد",5,"د",1,1],["مِن رِجالٍ أَسفَروا بِال","طولِ أَيّامَ الشُحوبِ",6,"ب",1,0],["مِن رَميضٍ يُمنَعُ الذِلَّ وَمِن","عاطِشٍ يُسقى أَنابيبَ القَنا",7,"ا",1,0],["مَنْ رامَ عِزّاً بغَيرِ السَّيفِ لم يَنَلِ","فارْكَبْ شَبا الهُندُوَانِيَّاتِ والأسَلِ",8,"ل",1,1],["مَنْ رأى أنّ للوُجودِ دَواماً","فهْوَ في الخَلْقِ ما لهُ منْ خَلاقِ",9,"ق",1,0],["مَنْ رامَ أمْراً لا يُنالُ مَرامُهُ","بالجُهْدِ كان الى القُصورِ قُصارُهُ",10,"ر",2,0],["مَنْ رَام نَيْلَ الشَّيْءِ قَبْلَ أَوَانِهِ","رَامَ انْتِقَالَ يَلَمْلَمٍ وَعَسِيبِ",11,"ب",1,0],["مَن رَأى عاطِفاً وَقَد وَصَلَ الأَش","غالَ بَعدَ الهُدُوِّ بِالأَشغالِ",12,"ل",1,0],["مَن رامَ وَصلَ الشَمسِ حاكَ خُيوطَها","سَبَباً إِلى آمالِهِ وَتَعَلَّقا",13,"ق",2,0],["مِن رَحيقٍ أُمُّهُ غادِيَةٌ","ساقَها تَحتَ الدُجى رَوحُ السَحَر",14,"ر",1,0],["مَن رَآها في وَغاها خالَها","صِبيَةً خَفَّت إِلى لِعبِ الأُكَر",14,"ر",1,0],["مَن راءَهُ يَومَ النِزا","لِ رَأى النُسورَ تَصيدُ أُسدا",15,"د",2,0],["مَن رامَ أَن يَشهَدَ الفِردَوسَ ماثِلَةً","فَليَغشَ أَحياءَكُم في شَهرِ نَيسانِ",16,"ن",1,0],["مَنْ رَابَهُ بَعْثٌ فَه","ذَا الْبَعْثُ لَمْ يَدَعِ ارْتِيَابَا",17,"ب",2,0],["مِنْ رَوْضَةٍ أَزْهَارُهَا عَرَبِيَّةٌ","وَلَهَا مِنَ الفَنِّ الرَّفِيعِ نِظَامُ",18,"م",1,0],["من ريه يقل عن ملك","من الجميل إلى عطيه",19,"ه",1,0],["من رأى التاج الرفيعا","قد حوى الشكر البديعا",20,"ع",2,1],["من روضة تنعش روح الفتى","وعيشة ممحوّة الشكوى",21,"ك",3,0],["من ريب دهر أرى حوادثه","تعتز حلواءَها شدائدُها",22,"ه",2,1],["من رأى قبلك الشهاب مضيئاً","مشرقاً في تألّقٍ وبياض",23,"ض",1,0],["من رامَ بالشهدِ أن يمثلها رشفا","فإنَّما رامَ أن يعسّلها وَصفا",24,"ف",2,0],["مَن رامَهُ بِالعَقلِ مُستَرشِداً","أُسَرِّحُهُ في حَيرَةٍ يَلهو",25,"و",1,1],["من رأى منتحِباً غي","ري على سوء الغناءِ",26,"ا",2,0],["من رآه رأى شواهد تُغْني","عن سماعِ الثناء والتجريبِ",27,"ب",1,0],["من رأى منزلي رأى خَيْرَ عِلْقٍ","فيه أنْ ليْسَ فيه لي مَنْهُوبُ",28,"ب",1,0],["منْ رَدَّني غير مَصْفُودٍ فإنَّ له","عندي عَفَافاً وعزْماً غيْرَ مَصْفُودِ",29,"د",1,0],["منْ رتل الآية ألفيتَها","ترتّلُ الشهقة ترتيلا",30,"ل",2,0],["مِن رجالٍ توقَّلوا في المعالي","بالمساعي توقُّلَ الأوعالِ",31,"ل",1,0],["من رماح إذا عَسَلْنَ تضَمَّنْ","نَ قِرا كلّ عاسل بسَّالِ",32,"ل",1,0],["من رأيتُم بعد طالو","تَ له عِلمٌ وجسمُ",33,"م",1,0],["من رآهُنَّ في المساقِ سبايا","دامياتِ الوجوهِ للأقدام",34,"م",1,0],["من رآهنَّ في المقاسم وسْطَ ال","زنج يُقسَمْنَ بينهم بالسِّهام",34,"م",1,0],["من رآهُنَّ يُتّخذنَ إماءً","بعد ملْكِ الإماء والخُدَّام",34,"م",1,0],["من رام سَكْر البحرِ عن طُرقاتِهِ","أرهنته بالعجز ألفَ رهين",35,"ن",1,0],["من رأى مثلَ خالدٍ فضلَ حلمٍ","وسماحٍ أم مَنْ يُقاسُ إليهِ",36,"ي",2,1],["مَن رَجَلٌ أَحبوهُ وَناقَتي","يُبَلِّغُ عَنّي الشِعرَ إِذ ماتَ قَائِلُه",37,"ل",2,1],["مَن رَأى قَبلَكَ دُنيا مِن شِيَم في كَفَن","خَلَصتَ روحَكَ مِن سِجنِ الأَلَم وَالشَجَن",38,"ن",1,0],["مَن رَآني يَرِقُّ لي","ضائِعاً في يَدَيكُمُ",39,"م",1,0],["من رتبة قد حازها","ليس لها معادل",40,"ل",1,0],["من رام يثبت صدق الدين بالحجج","جنى على العلم والأسماع والمهج",41,"ج",1,1],["من راح قال الهُجر أو نطق الخنا","هذا بياني عنهما نزهته",42,"ت",2,0],["من رآها قال قد سخّرها","لك من سخرها للأنبياء",43,"ا",2,0],["مَن رَمى الفارِسَ عَن صَهوَتِها","وَدَها الفُصحى بِما أَلجَمَ فاها",44,"ا",3,0],["مِن رِجالٍ بَنَوا لِمِصرَ حَديثاً","وَأَذاعوا مَحاسِناً لِلنيلِ",45,"ل",1,0],["مِن رِجالٍ خُلِقوا أَلوِيَةً","وَنُجوماً وَغُيوثاً وَرِعانا",46,"ن",2,0],["مَن رَأى جَلمَداً يَهُبُّ هُبوباً","وَحَميماً يَسُحَّ سَحَّ الغَمامَه",47,"م",2,0],["مَن رَآهُ يَقولُ قَد حُرِموا الفِر","دَوسَ لَكِن بِسِحرِهِم سَرَقوهُ",48,"ق",3,0],["مَن رَآكُم قالَ مِصرُ اِستَرجَعَت","عِزَّها في عَهدِ خوفو وَمِناء",49,"ا",2,0],["مَن رَآها يَقولُ هَذي مُلوكُ","الدَهرِ هَذا وَقارُهُم وَالرَزانَه",50,"ن",2,0],["مِن رَوضَةِ العِلمِ الصَحي","حِ وَرَبوَةِ الأَدَبِ السَليمِ",51,"م",1,0],["مَن رَآها بِعَينِها شاقَهُ القُط","طانُ فيها كَما تَشوقُ الحُمولُ",52,"ل",1,0],["مِن رِقبَةٍ أَدَعُ الزِيارَةَ عامِداً","وَأَصُدُّ عَنكِ وَعَن دِيارِكِ حائِدا",53,"د",2,1],["مِن راحَتَيكَ أَبا كُلثومٍ اِنبَجَسَت","يَنابِعُ الجودِ في اللَأواءِ وَالإِزَمِ",54,"م",1,0],["مَنْ رامَ في الشِّعرِ شأوي كَلَّ عنه ومَنْ","ناوَى أبا تغِلب في سُؤدُدٍ غُلِبا",55,"ب",2,0],["مَن رَأى عِبرَةً فَفَكَّرَ فيها","لَم يَزِدهُ التَفكيرُ إِلّا اِعتِبارا",56,"ر",2,0],["مَن رَأى الدُنيا بِعَينَي بَصيرٍ","لَم تَكَد تَخطُرُ مِنهُ بِبالِ",57,"ل",1,0],["مَن رَجَونا لَدَيهِ دُنيا وَصَلنا","هُ وَقُلنا لَهُ عَلَيكَ السَلامُ",58,"م",1,0],["مَن رَأى عِبرَةً فَفَكَّرَ فيها","آذَنَتهُ بِالشَيءِ حينَ يَراها",59,"ا",3,0],["مَن رأى البؤس إن عدا","مَن رأى الضنك إن هَجَم",60,"م",1,0],["مَن رأى العفةَ العري","قةَ بالدهر تصطدم",60,"م",1,0],["مَن رَأى بارِقاً سَرى صامِتِيّاً","جادَ نَجداً سُهولَها وَالحُزوما",61,"م",2,0],["مَنْ رامَ طولَ العمرِ يصبرْ على","مصائبٍ أهونُها ما تراهْ",62,"ه",1,1],["مَنْ رامَ طولَ العمرِ يصبرْ على","مصائبٍ أهونُها هذي",63,"ي",1,1],["مَنْ رامَ يحصي معجزاتِ محمدٍ","فيعدّ موجَ البحرِ حينَ تموَّجا",64,"ج",2,0],["منْ رامَ يجني الوردَ مشنْ خدِّهِ","فعقربُ الصدغِ لهُ تنظرُ",65,"ر",1,0],["مِنَ رضابي وعذاري","بينَ خمرٍ وحشيشِ",66,"ش",1,0],["مِن رُسومٍ بالِياتٍ وَدِمَن","عادَ لي هَمّي وَعاوَدتُ دَدَن",67,"ن",1,1],["مَن رَسولي إِلى الثُرَيّا فَإِنّي","ضافَني الهَمُّ وَاِعتَراني الغُمومُ",68,"م",1,1],["مَن رَسولٌ ناصِحٌ يُخبِرُنا","عَن مُحِبٍّ مُستَهامٍ قَد كَتَم",69,"م",1,0],["مَن رَسولي إِلى الثُرَيّا بِأَنّي","ضِقتُ ذَرعاً بِهَجرِها وَالكِتابِ",70,"ب",1,0],["مَن رَسولٌ إِلَيهِ يَعلَمُ حَقّاً","أَجمَعَ اليَومَ هِجرَةً وَاِجتِنابا",71,"ب",2,0],["مَن راحَ من قومِنا يُحيي مَراشده","أحيا بها أمماً شتَّى وأوطانا",72,"ن",2,0],["مَن راضَ في خِدَعِ السّياسةِ نفسَه","عِلماً بها فكأنّه لم يُخدَعِ",73,"ع",1,0],["من رأى الضَّعفَ على الضَّعْفِ انطوَى","فإذا القوةُ والعزمُ الأشدّ",74,"د",1,0],["مَن ر