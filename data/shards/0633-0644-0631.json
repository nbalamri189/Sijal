{"poems":[[90,"أدب العلم وعلم الأدب","https://www.aldiwan.net/poem45003.html","الرمل"],[77,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43855","البسيط"],[358,"سل ربة الخال إذ تخلو بها مددا","https://www.aldiwan.net/poem40381.html","البسيط"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129521","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108975","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48303","الخفيف"],[4163,"","https://poetry.dctabudhabi.ae/diwan/poem/106729","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120523","البسيط"],[4729,"أحاضرٌ وأُهيلُ المُنحنى غَيَبُ؟","https://www.poetsgate.com/ViewPoem.aspx?id=109432",""],[5081,"لَا تَبْتَئِسْ","https://www.poetsgate.com/ViewPoem.aspx?id=186715",""],[5213,"صنت سمعي عن عاذل فيك لاحي","https://www.poetsgate.com/ViewPoem.aspx?id=170433",""],[5442,"الذرك الشيب فهلا أرعويت","https://www.poetsgate.com/ViewPoem.aspx?id=114783",""],[6238,"لُباب الحُب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86777&r=&rc=6",""]],"verses":[["سل رُبا بغداد عما قد مضى","لبني العباس في تلك الديار",0,"ر",1,0],["سَلْ رَهطَ مَنويلٍ وأنْتَ غَرَرْتَهُ","في أيّ مَعركَةٍ ثَوى مَنويل",1,"ل",1,0],["سَل رَبَّكَ العَفوَ عَن ذُنوبي","وَاِذكُر وَإِن كُنتَ غَيرَ ناسِ",2,"س",1,0],["سَل رَبّة الخال إِذ تَخلو بِها مددا","بسرّها الماء مِن أَعطافِها جَمدا",3,"د",2,1],["سل رسوم الربوع عنها وما يج","دي سؤال عنه الجواب السؤال",4,"ل",1,0],["سل رحمة الباري له","يوليك ربك مثلها",5,"ه",2,0],["سَلْ ركابَ الحِمى غَداةَ استَقلَّتْ","مَنْ حَوتْ في رِحالِها وأقَلّتْ",6,"ت",1,1],["سَل رَسمَ دارِ الأُلى شَطّوا فَهَل شَرِقَت","بِالرَيِّ مِن عَندَمِ الدَمعِ الَّذي سُكِبا",7,"ب",2,0],["سل رهط احمد والنعمان ما جنبا","حتى اهينا وفي تقواهما سجنا",8,"ن",2,0],["سَل ركب رامة والأنباءُ سائرةٌ:","هل مُدّ بعد لحيٍ بالفضا طُنُبُ",9,"ب",1,0],["سَلْ رَاجِيَاً عَفْوَ مَنْ يَقْضِي بِحِكْمَتِهِ","فَلِكُلِّ كُنْ سِرُّهَا أَمْرٌ يُدَبِّرُهُ",10,"ر",2,0],["سل ربوع الغري هل لاح فيها","بعد فقد الحبيب ضوء الصباح",11,"ح",1,0],["سل ربك العفو تجد عفوه","أوفى على ظلمك مما جنيت",12,"ت",1,0],["سَلْ راحلاً كيفَ انطوى برحيلهِ","قلْبٌ لِعاشِقةٍ تُسائلُ: ما بهِ؟",13,"ب",2,0]]}