{"poems":[[108,"هوينك بالغيور من الرجال","https://www.shoaraa.com/p13817",""],[53,"نغالب ثم تغلبنا الليالي","https://www.aldiwan.net/poem29886.html","الوافر"],[63,"بدا والثريا في مغاربها قرط","https://www.aldiwan.net/poem46211.html","الطويل"],[55,"كان خروجي من عندكم قدرا","https://www.aldiwan.net/poem26078.html","المنسرح"],[82,"وناضر الخد في ألحاظه حور","https://www.aldiwan.net/poem29399.html","البسيط"],[35,"أأطلال دار من سعاد بيلبن","https://www.aldiwan.net/poem38818.html","الطويل"],[88,"من أين من أين يا ابتدائي","https://www.aldiwan.net/poem45073.html","مخلع البسيط"],[37,"طربت وهل بك من مطرب","https://www.aldiwan.net/poem7653.html","المتقارب"],[23,"عفت ذات الأصابع فالجواء","https://www.aldiwan.net/poem21233.html","الوافر"],[23,"ألم تنه خصيا الطابخي وأيره","https://www.aldiwan.net/poem21414.html","الطويل"],[51,"كأن خبوء الشمس ثم غروبها","https://www.aldiwan.net/poem64983.html","الطويل"],[51,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[91,"مرضت فأرواح الصحاب كئيبة","https://www.aldiwan.net/poem8812.html","عموديه"],[14,"تحن إلى سلمى بحر بلادها","https://www.aldiwan.net/poem38305.html","الطويل"],[85,"كان على بعض الدروب جمل","https://www.aldiwan.net/poem8008.html","الرجز"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[43,"ضروب الناس عشاق ضروبا","https://www.aldiwan.net/poem9501.html","الوافر"],[43,"إلام طماعية العاذل","https://www.aldiwan.net/poem9759.html","المتقارب"],[45,"عاد للصب شجوه واكتئابه","https://www.aldiwan.net/poem10654.html","الخفيف"],[45,"يا سعيد والأمر فيك عجيب","https://www.aldiwan.net/poem11045.html","الخفيف"],[28,"لقد هاج من عيني ماء على الهوى","https://www.aldiwan.net/poem5197.html","الطويل"],[61,"غدا تبدي مدامعنا الخفايا","https://www.aldiwan.net/poem51397.html","الوافر"],[97,"تعال نزف للثغرِ السلاما","https://www.aldiwan.net/poem24357.html","الوافر"],[80,"من شاء أن تسكر راح براح","https://www.aldiwan.net/poem31514.html","السريع"],[81,"أما لك في أمري إلى العدل مصرف","https://www.aldiwan.net/poem61456.html","الطويل"],[52,"دعني فما طاعة العذال من ديني","https://www.aldiwan.net/poem26610.html","البسيط"],[52,"وسكان دار لا تواصل بينهم","https://www.aldiwan.net/poem26877.html","الطويل"],[52,"وفتيان لهو غدوا للصبوح","https://www.aldiwan.net/poem26981.html","المتقارب"],[75,"رأيت بعيني فوق ما كنت أسمع","https://www.aldiwan.net/poem69065.html","الطويل"],[48,"لما غدا الثعلب من وجاره","https://www.aldiwan.net/poem63408.html","الطويل"],[48,"لا تبك ربعا عفا بذي سلم","https://www.aldiwan.net/poem65107.html","المنسرح"],[46,"ترنم في نهارك مستعينا","https://www.aldiwan.net/poem22214.html","الوافر"],[46,"يقول لك إنعم مصبحا متودد","https://www.aldiwan.net/poem22276.html","الطويل"],[46,"حبست كتاب العين في كل وجهة","https://www.aldiwan.net/poem22959.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[91,"في فراش المرض","https://www.poetsgate.com/ViewPoem.aspx?id=53028",""],[121,"إن وجها رأيته ليلة السب","https://www.aldiwan.net/poem49368.html","الخفيف"],[156,"أمغنى الهوى غالتك أيدي النوائب","https://www.aldiwan.net/poem55797.html","الطويل"],[190,"يا نسيماً سرى إلى قاسيونا","https://www.aldiwan.net/poem34874.html","الخفيف"],[190,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[200,"زمان عيشنا فيه اضطرار","https://www.aldiwan.net/poem45408.html","الوافر"],[213,"إن الليالي والأيام أطراق","https://www.aldiwan.net/poem37856.html","البسيط"],[230,"الآن قد الفؤاد نصفين","https://www.aldiwan.net/poem50780.html","المنسرح"],[230,"انظر إلى النيل قد عبا عساكره","https://www.aldiwan.net/poem50931.html","البسيط"],[236,"لا وجدتم يا أهل نعمان وجدي","https://www.aldiwan.net/poem32096.html","الخفيف"],[250,"ألا ظعن الخليط غداة ريعوا","https://www.aldiwan.net/poem2107.html","الوافر"],[323,"أرقت وشر الداء هم مؤرق","https://www.aldiwan.net/poem56359.html","الطويل"],[364,"بالعفر دار من جميلة هيجت","https://www.aldiwan.net/poem1718.html","الطويل"],[372,"طرة مسك وشارب أخضر","https://www.aldiwan.net/poem56936.html","المنسرح"],[378,"ذريني فجدي حيثما كنت مرشدي","https://www.aldiwan.net/poem66877.html","الطويل"],[440,"نجوم الصبا أين تلك النجوم","https://www.aldiwan.net/poem34849.html","المتقارب"],[440,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[454,"عزاء بهذا الموت يا من فدى مصرا","https://www.aldiwan.net/poem61244.html","الطويل"],[459,"جرت لها ببابلٍ يمينا","https://www.aldiwan.net/poem55838.html","الرجز"],[459,"ألا صاحب كالسيف حلو شمائله","https://www.aldiwan.net/poem55994.html","الطويل"],[459,"أصب برأيي أصاب الحظ أو غلطا","https://www.aldiwan.net/poem56141.html","البسيط"],[462,"عفا الله عنها هل يلم خيالها","https://www.aldiwan.net/poem15086.html","الطويل"],[462,"خذ ما تشاء من الأيام أو فذر","https://www.aldiwan.net/poem15097.html","البسيط"],[462,"إذا مدحت معز الدين آونة","https://www.aldiwan.net/poem15133.html","البسيط"],[462,"كأن خطوط الدمع في وجناته","https://www.aldiwan.net/poem16087.html","الطويل"],[465,"عثرة قلبي فيكم لا تقال","https://www.aldiwan.net/poem3558.html","عموديه"],[471,"وإني لأهواها وأهوى لقاءها","https://www.aldiwan.net/poem4658.html","الطويل"],[515,"لله قوم بأكناف الحمى نزلوا","https://www.aldiwan.net/poem20817.html","البسيط"],[563,"يا أيها السفح ماذا يصنع البان","https://www.aldiwan.net/poem52853.html","البسيط"],[576,"ببرقة ثغر لا ببرقة ثهمد","https://www.aldiwan.net/poem3084.html","الطويل"]],"verses":[["كأن خروجها منها وليداً","خروج الشمس من رحم الهلال",0,"ل",1,0],["كَأَنَّ خُدورَها أَصدافُ يَمٍّ","مُحَصَّنَةٌ ضُمِمنَ عَلى لَآلِ",1,"ل",1,0],["كأنَّ خِلالَ الغَيْمِ مِن لَمَعانِهِ","يَدَيْ قادِحٍ يَرفَضُّ مِن زَنْدِهِ سِقْطُ",2,"ط",1,0],["كانَ خُروجي مِن عِندِكُم قَدراً","وَحادِثاً مِن حَوادِثِ الزَمَنِ",3,"ن",1,1],["كأن خيلانه في حسن صفحته","كواكب كسفت في دارة القمر",4,"ر",1,0],["كَأَنَّ خَليفَي زَورِها وَرَحاهُما","بُنى مَكَوَينِ ثُلِّما بَعدَ صَيدَنِ",5,"ن",1,0],["كأن خط الشهاب مُدلٍ","لأسفل البئر بالرشاء",6,"ا",2,0],["كأَنَّ خُدُودَهُم الواضِحَا","تِ بَينَ المَجَرِّ الى المَسحَبِ",7,"ب",1,0],["كَأَنَّ خَبيأَةٍ مِن بَيتِ رَأسٍ","يَكونُ مِزاجَها عَسَلٌ وَماءُ",8,"ا",2,0],["كَأَنَّ خُصى الجيرانِ في كُلِّ صَيفَةٍ","بِأَيدي عَذاريهِم رُؤوسُ الأَرانِبِ",9,"ب",1,0],["كأن خبوءَ الشمسِ ثم غُروبَها","وقد جعلتْ في مَجنح الليل تَمرضُ",10,"ض",1,1],["كان خيراً من البقاء لحربي","بل أبى شؤمُ جَدِّك المشؤوم",11,"م",1,0],["كَأَنَّ خُيوطَ المَهدِ صارَت عَقارِباً","كَأَنَّ وِسادي قَد تَحَوَّلَ جامِدا",12,"د",2,0],["كَأَنَّ خَواتَ الرَعدِ رِزءُ زَئيرِهِ","مِنَ اللاءِ يَسكُنَّ العَرينَ بِعُثَّرا",13,"ر",2,0],["كَأَنَّ خَلفي أَلفَ أَلفِ أَرنَبِ","إِذا نَهَضتُ جاذَبتني ذَنَبي",14,"ي",1,0],["كَأَنَّ خِيامَ الجَيشِ في السَهلِ أَينَقُ","نَواشِزُ فَوضى في دُجى اللَيلِ شُزَّبُ",15,"ب",1,0],["كَأَنَّ خُيولَنا كانَت قَديماً","تُسَقّى في قُحوفِهِمِ الحَليباً",16,"ب",2,0],["كَأَنَّ خَلاصَ أَبي وائِلٍ","مُعاوَدَةُ القَمَرِ الآفِلِ",17,"ل",1,0],["كانَ خُلفاً ما قَد وَعَدنَ وَإِن طا","لَ بِذي الوَجدِ مَكثُهُ وَاِرتِقابُه",18,"ب",2,0],["كانَ خِلَّ الأَديبِ حَقّاً وَهَل يَع","رِفُ حَقَّ الأَديبِ إِلّا الأَديبُ",19,"ب",1,0],["كَأَنَّ خُزامى حَرَّكَت ريحَها الصَبا","وَحَنوَةَ رَوضٍ حينَ أَقلَعَ ماطِرُه",20,"ر",2,0],["كأنَّ خُدُودَهنَّ إذا استقلَّتْ","شَقِيقٌ فيه من طَلٍّ بَقايا",21,"ا",3,0],["كأن خُطى العبابِ خطى حبيبٍ","كأنَّ الموجَ أفئدةٌ تَرامى",22,"م",2,0],["كأنّ خُرْسَ الطيرِ قد لُقّنَتْ","مَدْحَ عليٍّ فتغنّتْ فِصَاح",23,"ح",1,0],["كَأَنَّ خَيالي لَيسَ يُظهِرُ غَيرَهُ","وَلا مُنصِفي يَدري خِلافَ اِسمِهِ حَرفا",24,"ف",2,0],["كَأَنَّ خَطَّ عِذارٍ شَقَّ عارِضَهُ","مَيدانُ آسٍ عَلى وَردٍ وَنِسرينِ",25,"ن",1,0],["كَأَنَّ خَواتيماً مِنَ الطينِ بَينَهُم","فَلَيسَ لَها حَتّى القِيامَةِ مِن فَضِّ",26,"ض",1,0],["كَأَنَّ خَراطيمَها في الزُجاجِ","خَراطيمُ فَحلٍ يُنَقّينَ ثَورا",27,"ر",2,0],["كأنّ خلاخِيلَ المطايا إذا غدتْ","تَجَاوَبُ أصْداءُ الفَلا تترجّع",28,"ع",1,0],["كَأَنَّ خَلفَ مُلتَقى أَشفارِهِ","جَمرَ غَضىً يُدمِنُ في اِستِعارِهِ",29,"ر",2,0],["كَأَنَّ خَدَّيهِ في بَياضِهِما","قَد أُشرِبَت وَجنَتاهُما بِدَمِ",30,"م",1,0],["كَأَنَّ خَواتِمَ الأَفواهِ فُضَّت","عَنِ الصُهبِ العِذابِ مُخَتَّماتِ",31,"ت",1,0],["كَأَنَّ خُطوبَ الدَهرِ بَحرٌ فَمَن يَمُت","بِفَرطِ صَداهُ فَهُوَ في اللُجِّ يَسبَحُ",32,"ح",1,0],["كَأَنَّ خَطيباً مُوَفِياً رَأسَ مِنبَرٍ","يَبُثُّ هُذاءً بِالكَلامِ المَسجَّعِ",33,"ع",1,0],["كان خيراً مني البهائمُ تثوي","حيث لا آمرٌ ولا مأمورُ",34,"ر",1,0],["كأنّ خيوط المهد صارت عقاربا","كأن وسادي قد تحوّل جلمدا",35,"د",2,0],["كان خيراً من السهاد رقادي","في حمى ظلك الوريف وأحلى",36,"ل",2,0],["كَأَنَّ خَفِيَّاتِ الكَواكبِ في الدُّجى","بياضُ ولاءٍ لاحَ في قلبِ ناصِبي",37,"ب",2,0],["كانَ خَتماً للأولياءِ تَبيعاً","بِهُداهُ لخاتمِ المرسلينا",38,"ن",2,0],["كانَ خيرَ الأنامِ خُلقاً فلا ال","فحشُ ملمٌّ بهِ ولا الفحشاءُ",39,"ا",2,0],["كانَ خيرَ الشجعانِ في كلّ حربٍ","كيفَ يَخشى واللَّه منه الكلاءُ",39,"ا",2,0],["كانَ خيرَ الأخيارِ رِفقاً وكلُّ الل","لطفِ منه قَد ناله اللطفاءُ",39,"ا",2,0],["كانَ خيرَ الأنامِ في كلِّ خيرٍ","ما لِخلقٍ سِواه معه اِستواءُ",39,"ا",2,0],["كأنَّ خزانةَ الأموالِ قبرٌ","ففي نفسِ الغنيِّ بها انكسارُ",40,"ر",1,0],["كأنَّ خَرَّ عليَّ السَّقْفُ مُرْتَمياً","لمّا على قَبْرِهِ الجُلاّءُ تَنْساقُ",41,"ق",1,0],["كأنّ خدّيه في سوادكما","صُبْحان قد طُرِّزا بليلين",42,"ن",1,0],["كأنّ خلجانه والماءُ يأخذُها","مدائنٌ فتحت فاحتازها الغرق",43,"ق",1,0],["كانَ خَصمي فَمُذ لَجَأتُ إِلى با","بِكَ أَضحَت أَيّامُهُ وَهيَ جُندي",44,"د",2,0],["كَأَنَّ خَوالِداً في الدارِ سُفعاً","بِعَرصَتِها حَماماتٌ وُقوعُ",45,"ع",1,0],["كَأَنَّ خَلايا فيهِ ضَلَّت رِباعُها","وَلَجَّةُ حُجّاجٍ وَغابٌ يُحَرَّقُ",46,"ق",1,0],["كَأَنَّ خَيالَ السَخلِ في كُلِّ مَنزِلٍ","يَضَعنَ بِهِ الأَسلاءَ أَطلاءُ طُحلُبِ",47,"ب",1,0],["كأنَّ خِيلانَه ووَجنَتَهُ","سَماءُ حُسنٍ نُجُومُها تَزهَر",48,"ر",1,0],["كأن خرير الماء والظل وارفٌ","عليه حكى واللَه أنغامَ مَعبَد",49,"د",1,0],["كَأَنَّ خوافِقَ أَعلامِهِنَّ","طيورٌ عَلَى الماءِ منها تَحُومُ",50,"م",1,0],["كَأَنَّ خُفُوقَ القَلْبِ مَدَّ جوانِحي","بأَجْنِحَةٍ رِيشَتْ منَ الرَّوْعِ والذُّعْرِ",51,"ر",1,0],["كأن خراب الكون رهن بذلة","يصاب بها العقل الذي عز واستذرى",52,"ر",2,0],["كأنَّ خرقاءَ الرياحِ شرَّعتْ","في لُجَّةِ الآلِ بها سفينا",53,"ن",2,0],["كأنّ خِلاطَ البين بين حُمولهم","لواعجُ قلبي بعدهم وبلابلُهْ",54,"ل",2,0],["كأنّ خمَّار بُصرَى بات يسكبها","أو فضَّ عطّار دارين بها سفَطا",55,"ط",2,0],["كأنَّ خوافي ناهضٍ متمطَّرٍ","غدتْ بفؤادي يومَ زُمَّتْ حبالُها",56,"ل",3,0],["كأن خمراً وورساً في رحالهمُ","من الشُّخوب وخفق القوم العذر",57,"ر",1,0],["كأنَّ خيلك في الغارات موجفةً","سيدانُ قفرٍ وفرسان العدى غَنمُ",58,"م",1,0],["كأنَّ خطوط الدمع في وجناتهِ","مَذانبُ روضٍ أفْعَمتها سُيولُها",59,"ه",2,1],["كأنَّ خدَّيه وأصداغه","صبحُ الهدى من تحت ليل الضلال",60,"ل",1,0],["كَأَنَّ خَذولاً فِي الكناسِ أَعارَها","غَداة تَبَدَّت عُنقَها وَالمقلدا",61,"د",2,0],["كأنّ خاتَمَهُ يومَ النّوالِ بها","قوسُ السّحابِ الغَوادي حينَ ينهَمِلُ",62,"ل",1,0],["كأنَّ خِضْرَ بنَ رَعدٍ حلَّ ساحتَهُ","فأرعَدَتْ مُزنةٌ واخضَرَّ بُستانُ",63,"ن",1,0],["كأَنَّ خِلالَ الطِّرسِ بين سُطورِه","مباسمُ دُرٍّ في شِفاه زَبرْجَد",64,"د",1,0]]}