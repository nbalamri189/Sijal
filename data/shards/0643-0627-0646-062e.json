{"poems":[[53,"نغالب ثم تغلبنا الليالي","https://www.aldiwan.net/poem29886.html","الوافر"],[63,"بدا والثريا في مغاربها قرط","https://www.aldiwan.net/poem46211.html","الطويل"],[55,"كان خروجي من عندكم قدرا","https://www.aldiwan.net/poem26078.html","المنسرح"],[82,"وناضر الخد في ألحاظه حور","https://www.aldiwan.net/poem29399.html","البسيط"],[35,"أأطلال دار من سعاد بيلبن","https://www.aldiwan.net/poem38818.html","الطويل"],[88,"من أين من أين يا ابتدائي","https://www.aldiwan.net/poem45073.html","مخلع البسيط"],[37,"طربت وهل بك من مطرب","https://www.aldiwan.net/poem7653.html","المتقارب"],[23,"عفت ذات الأصابع فالجواء","https://www.aldiwan.net/poem21233.html","الوافر"],[23,"ألم تنه خصيا الطابخي وأيره","https://www.aldiwan.net/poem21414.html","الطويل"],[51,"كأن خبوء الشمس ثم غروبها","https://www.aldiwan.net/poem64983.html","الطويل"],[51,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[91,"مرضت فأرواح الصحاب كئيبة","https://www.aldiwan.net/poem8812.html","عموديه"],[14,"تحن إلى سلمى بحر بلادها","https://www.aldiwan.net/poem38305.html","الطويل"],[85,"كان على بعض الدروب جمل","https://www.aldiwan.net/poem8008.html","الرجز"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[43,"ضروب الناس عشاق ضروبا","https://www.aldiwan.net/poem9501.html","الوافر"],[43,"إلام طماعية العاذل","https://www.aldiwan.net/poem9759.html","المتقارب"],[45,"عاد للصب شجوه واكتئابه","https://www.aldiwan.net/poem10654.html","الخفيف"],[45,"يا سعيد والأمر فيك عجيب","https://www.aldiwan.net/poem11045.html","الخفيف"],[28,"لقد هاج من عيني ماء على الهوى","https://www.aldiwan.net/poem5197.html","الطويل"],[61,"غدا تبدي مدامعنا الخفايا","https://www.aldiwan.net/poem51397.html","الوافر"],[97,"تعال نزف للثغرِ السلاما","https://www.aldiwan.net/poem24357.html","الوافر"],[80,"من شاء أن تسكر راح براح","https://www.aldiwan.net/poem31514.html","السريع"],[81,"أما لك في أمري إلى العدل مصرف","https://www.aldiwan.net/poem61456.html","الطويل"],[52,"دعني فما طاعة العذال من ديني","https://www.aldiwan.net/poem26610.html","البسيط"],[52,"وسكان دار لا تواصل بينهم","https://www.aldiwan.net/poem26877.html","الطويل"],[52,"وفتيان لهو غدوا للصبوح","https://www.aldiwan.net/poem26981.html","المتقارب"],[75,"رأيت بعيني فوق ما كنت أسمع","https://www.aldiwan.net/poem69065.html","الطويل"],[48,"لما غدا الثعلب من وجاره","https://www.aldiwan.net/poem63408.html","الطويل"],[48,"لا تبك ربعا عفا بذي سلم","https://www.aldiwan.net/poem65107.html","المنسرح"],[46,"ترنم في نهارك مستعينا","https://www.aldiwan.net/poem22214.html","الوافر"],[46,"يقول لك إنعم مصبحا متودد","https://www.aldiwan.net/poem22276.html","الطويل"],[46,"حبست كتاب العين في كل وجهة","https://www.aldiwan.net/poem22959.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[91,"في فراش المرض","https://www.poetsgate.com/ViewPoem.aspx?id=53028",""]],"verses":[["كَأَنَّ خُدورَها أَصدافُ يَمٍّ","مُحَصَّنَةٌ ضُمِمنَ عَلى لَآلِ",0,"ل",1,0],["كأنَّ خِلالَ الغَيْمِ مِن لَمَعانِهِ","يَدَيْ قادِحٍ يَرفَضُّ مِن زَنْدِهِ سِقْطُ",1,"ط",1,0],["كانَ خُروجي مِن عِندِكُم قَدراً","وَحادِثاً مِن حَوادِثِ الزَمَنِ",2,"ن",1,1],["كأن خيلانه في حسن صفحته","كواكب كسفت في دارة القمر",3,"ر",1,0],["كَأَنَّ خَليفَي زَورِها وَرَحاهُما","بُنى مَكَوَينِ ثُلِّما بَعدَ صَيدَنِ",4,"ن",1,0],["كأن خط الشهاب مُدلٍ","لأسفل البئر بالرشاء",5,"ا",2,0],["كأَنَّ خُدُودَهُم الواضِحَا","تِ بَينَ المَجَرِّ الى المَسحَبِ",6,"ب",1,0],["كَأَنَّ خَبيأَةٍ مِن بَيتِ رَأسٍ","يَكونُ مِزاجَها عَسَلٌ وَماءُ",7,"ا",2,0],["كَأَنَّ خُصى الجيرانِ في كُلِّ صَيفَةٍ","بِأَيدي عَذاريهِم رُؤوسُ الأَرانِبِ",8,"ب",1,0],["كأن خبوءَ الشمسِ ثم غُروبَها","وقد جعلتْ في مَجنح الليل تَمرضُ",9,"ض",1,1],["كان خيراً من البقاء لحربي","بل أبى شؤمُ جَدِّك المشؤوم",10,"م",1,0],["كَأَنَّ خُيوطَ المَهدِ صارَت عَقارِباً","كَأَنَّ وِسادي قَد تَحَوَّلَ جامِدا",11,"د",2,0],["كَأَنَّ خَواتَ الرَعدِ رِزءُ زَئيرِهِ","مِنَ اللاءِ يَسكُنَّ العَرينَ بِعُثَّرا",12,"ر",2,0],["كَأَنَّ خَلفي أَلفَ أَلفِ أَرنَبِ","إِذا نَهَضتُ جاذَبتني ذَنَبي",13,"ي",1,0],["كَأَنَّ خِيامَ الجَيشِ في السَهلِ أَينَقُ","نَواشِزُ فَوضى في دُجى اللَيلِ شُزَّبُ",14,"ب",1,0],["كَأَنَّ خُيولَنا كانَت قَديماً","تُسَقّى في قُحوفِهِمِ الحَليباً",15,"ب",2,0],["كَأَنَّ خَلاصَ أَبي وائِلٍ","مُعاوَدَةُ القَمَرِ الآفِلِ",16,"ل",1,0],["كانَ خُلفاً ما قَد وَعَدنَ وَإِن طا","لَ بِذي الوَجدِ مَكثُهُ وَاِرتِقابُه",17,"ب",2,0],["كانَ خِلَّ الأَديبِ حَقّاً وَهَل يَع","رِفُ حَقَّ الأَديبِ إِلّا الأَديبُ",18,"ب",1,0],["كَأَنَّ خُزامى حَرَّكَت ريحَها الصَبا","وَحَنوَةَ رَوضٍ حينَ أَقلَعَ ماطِرُه",19,"ر",2,0],["كأنَّ خُدُودَهنَّ إذا استقلَّتْ","شَقِيقٌ فيه من طَلٍّ بَقايا",20,"ا",3,0],["كأن خُطى العبابِ خطى حبيبٍ","كأنَّ الموجَ أفئدةٌ تَرامى",21,"م",2,0],["كأنّ خُرْسَ الطيرِ قد لُقّنَتْ","مَدْحَ عليٍّ فتغنّتْ فِصَاح",22,"ح",1,0],["كَأَنَّ خَيالي لَيسَ يُظهِرُ غَيرَهُ","وَلا مُنصِفي يَدري خِلافَ اِسمِهِ حَرفا",23,"ف",2,0],["كَأَنَّ خَطَّ عِذارٍ شَقَّ عارِضَهُ","مَيدانُ آسٍ عَلى وَردٍ وَنِسرينِ",24,"ن",1,0],["كَأَنَّ خَواتيماً مِنَ الطينِ بَينَهُم","فَلَيسَ لَها حَتّى القِيامَةِ مِن فَضِّ",25,"ض",1,0],["كَأَنَّ خَراطيمَها في الزُجاجِ","خَراطيمُ فَحلٍ يُنَقّينَ ثَورا",26,"ر",2,0],["كأنّ خلاخِيلَ المطايا إذا غدتْ","تَجَاوَبُ أصْداءُ الفَلا تترجّع",27,"ع",1,0],["كَأَنَّ خَلفَ مُلتَقى أَشفارِهِ","جَمرَ غَضىً يُدمِنُ في اِستِعارِهِ",28,"ر",2,0],["كَأَنَّ خَدَّيهِ في بَياضِهِما","قَد أُشرِبَت وَجنَتاهُما بِدَمِ",29,"م",1,0],["كَأَنَّ خَواتِمَ الأَفواهِ فُضَّت","عَنِ الصُهبِ العِذابِ مُخَتَّماتِ",30,"ت",1,0],["كَأَنَّ خُطوبَ الدَهرِ بَحرٌ فَمَن يَمُت","بِفَرطِ صَداهُ فَهُوَ في اللُجِّ يَسبَحُ",31,"ح",1,0],["كَأَنَّ خَطيباً مُوَفِياً رَأسَ مِنبَرٍ","يَبُثُّ هُذاءً بِالكَلامِ المَسجَّعِ",32,"ع",1,0],["كان خيراً مني البهائمُ تثوي","حيث لا آمرٌ ولا مأمورُ",33,"ر",1,0],["كأنّ خيوط المهد صارت عقاربا","كأن وسادي قد تحوّل جلمدا",34,"د",2,0]]}