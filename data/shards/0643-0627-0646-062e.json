عفراء","https://www.poetsgate.com/ViewPoem.aspx?id=29604",""],[5092,"تحت ظلال الحلم","https://www.poetsgate.com/ViewPoem.aspx?id=180066",""],[5136,"نفس على برحى الشوق أطويها","https://www.poetsgate.com/ViewPoem.aspx?id=121778",""],[5183,"إلى حادي العزائم","https://www.poetsgate.com/ViewPoem.aspx?id=180221",""],[5183,"الطعنة النجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=180183",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5183,"سباق الأعنة","https://www.poetsgate.com/ViewPoem.aspx?id=180222",""],[5190,"حتى حين","https://www.poetsgate.com/ViewPoem.aspx?id=153350",""],[5277,"طيف اليقضة","https://www.poetsgate.com/ViewPoem.aspx?id=186589",""],[5376,"دَهُرْتَ أمْ بَلَغَتْ روحٌ تراقيها","https://www.poetsgate.com/ViewPoem.aspx?id=197734",""],[5431,"أحبك....أحبك","https://www.poetsgate.com/ViewPoem.aspx?id=199836",""],[5431,"كل ابن آدم خطّاء","https://www.poetsgate.com/ViewPoem.aspx?id=214129",""],[709,"للهِ قَوْمٌ بِأَكْنَافِ الْحِمَى نَزَلُوا","https://www.poetsgate.com/ViewPoem.aspx?id=2921",""],[5891,"أحلام الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=39927",""],[5956,"الإمام علي (ع)","https://www.poetsgate.com/ViewPoem.aspx?id=192550",""],[6069,"أهلاً بشمس مدامٍ من يدي قمرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=105721",""],[6304,"الشمس الجريحة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1611&r=&rc=1",""],[6327,"مَرْثيّةُ الغَريب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86570&r=&rc=5",""]],"verses":[["كأن خروجها منها وليداً","خروج الشمس من رحم الهلال",0,"ل",1,0],["كَأَنَّ خُدورَها أَصدافُ يَمٍّ","مُحَصَّنَةٌ ضُمِمنَ عَلى لَآلِ",1,"ل",1,0],["كأنَّ خِلالَ الغَيْمِ مِن لَمَعانِهِ","يَدَيْ قادِحٍ يَرفَضُّ مِن زَنْدِهِ سِقْطُ",2,"ط",1,0],["كانَ خُروجي مِن عِندِكُم قَدراً","وَحادِثاً مِن حَوادِثِ الزَمَنِ",3,"ن",1,1],["كأن خيلانه في حسن صفحته","كواكب كسفت في دارة القمر",4,"ر",1,0],["كَأَنَّ خَليفَي زَورِها وَرَحاهُما","بُنى مَكَوَينِ ثُلِّما بَعدَ صَيدَنِ",5,"ن",1,0],["كأن خط الشهاب مُدلٍ","لأسفل البئر بالرشاء",6,"ا",2,0],["كأَنَّ خُدُودَهُم الواضِحَا","تِ بَينَ المَجَرِّ الى المَسحَبِ",7,"ب",1,0],["كَأَنَّ خَبيأَةٍ مِن بَيتِ رَأسٍ","يَكونُ مِزاجَها عَسَلٌ وَماءُ",8,"ا",2,0],["كَأَنَّ خُصى الجيرانِ في كُلِّ صَيفَةٍ","بِأَيدي عَذاريهِم رُؤوسُ الأَرانِبِ",9,"ب",1,0],["كأن خبوءَ الشمسِ ثم غُروبَها","وقد جعلتْ في مَجنح الليل تَمرضُ",10,"ض",1,1],["كان خيراً من البقاء لحربي","بل أبى شؤمُ جَدِّك المشؤوم",11,"م",1,0],["كَأَنَّ خُيوطَ المَهدِ صارَت عَقارِباً","كَأَنَّ وِسادي قَد تَحَوَّلَ جامِدا",12,"د",2,0],["كَأَنَّ خَواتَ الرَعدِ رِزءُ زَئيرِهِ","مِنَ اللاءِ يَسكُنَّ العَرينَ بِعُثَّرا",13,"ر",2,0],["كَأَنَّ خَلفي أَلفَ أَلفِ أَرنَبِ","إِذا نَهَضتُ جاذَبتني ذَنَبي",14,"ي",1,0],["كَأَنَّ خِيامَ الجَيشِ في السَهلِ أَينَقُ","نَواشِزُ فَوضى في دُجى اللَيلِ شُزَّبُ",15,"ب",1,0],["كَأَنَّ خُيولَنا كانَت قَديماً","تُسَقّى في قُحوفِهِمِ الحَليباً",16,"ب",2,0],["كَأَنَّ خَلاصَ أَبي وائِلٍ","مُعاوَدَةُ القَمَرِ الآفِلِ",17,"ل",1,0],["كانَ خُلفاً ما قَد وَعَدنَ وَإِن طا","لَ بِذي الوَجدِ مَكثُهُ وَاِرتِقابُه",18,"ب",2,0],["كانَ خِلَّ الأَديبِ حَقّاً وَهَل يَع","رِفُ حَقَّ الأَديبِ إِلّا الأَديبُ",19,"ب",1,0],["كَأَنَّ خُزامى حَرَّكَت ريحَها الصَبا","وَحَنوَةَ رَوضٍ حينَ أَقلَعَ ماطِرُه",20,"ر",2,0],["كأنَّ خُدُودَهنَّ إذا استقلَّتْ","شَقِيقٌ فيه من طَلٍّ بَقايا",21,"ا",3,0],["كأن خُطى العبابِ خطى حبيبٍ","كأنَّ الموجَ أفئدةٌ تَرامى",22,"م",2,0],["كأنّ خُرْسَ الطيرِ قد لُقّنَتْ","مَدْحَ عليٍّ فتغنّتْ فِصَاح",23,"ح",1,0],["كَأَنَّ خَيالي لَيسَ يُظهِرُ غَيرَهُ","وَلا مُنصِفي يَدري خِلافَ اِسمِهِ حَرفا",24,"ف",2,0],["كَأَنَّ خَطَّ عِذارٍ شَقَّ عارِضَهُ","مَيدانُ آسٍ عَلى وَردٍ وَنِسرينِ",25,"ن",1,0],["كَأَنَّ خَواتيماً مِنَ الطينِ بَينَهُم","فَلَيسَ لَها حَتّى القِيامَةِ مِن فَضِّ",26,"ض",1,0],["كَأَنَّ خَراطيمَها في الزُجاجِ","خَراطيمُ فَحلٍ يُنَقّينَ ثَورا",27,"ر",2,0],["كأنّ خلاخِيلَ المطايا إذا غدتْ","تَجَاوَبُ أصْداءُ الفَلا تترجّع",28,"ع",1,0],["كَأَنَّ خَلفَ مُلتَقى أَشفارِهِ","جَمرَ غَضىً يُدمِنُ في اِستِعارِهِ",29,"ر",2,0],["كَأَنَّ خَدَّيهِ في بَياضِهِما","قَد أُشرِبَت وَجنَتاهُما بِدَمِ",30,"م",1,0],["كَأَنَّ خَواتِمَ الأَفواهِ فُضَّت","عَنِ الصُهبِ العِذابِ مُخَتَّماتِ",31,"ت",1,0],["كَأَنَّ خُطوبَ الدَهرِ بَحرٌ فَمَن يَمُت","بِفَرطِ صَداهُ فَهُوَ في اللُجِّ يَسبَحُ",32,"ح",1,0],["كَأَنَّ خَطيباً مُوَفِياً رَأسَ مِنبَرٍ","يَبُثُّ هُذاءً بِالكَلامِ المَسجَّعِ",33,"ع",1,0],["كان خيراً مني البهائمُ تثوي","حيث لا آمرٌ ولا مأمورُ",34,"ر",1,0],["كَأَنَّ خَصِيفَ الجَمْرِ في عَرَصَاتِهَا","مَزَاحِفُ قَيْنَاتٍ تَجَاذَيْنَ إِثْمِدَا",35,"د",2,0],["كَأَنَّ خُزَامَى عَالِجٍ طَرَقَتْ بِهَا","شَمَالٌ رَسِيسُ المَسِّ بَلْ هِيَ أَطْيَبُ",36,"ب",1,0],["كأنّ خيوط المهد صارت عقاربا","كأن وسادي قد تحوّل جلمدا",37,"د",2,0],["كَأَنَّ خَصِيفَ الجَمْرِ في عَرَصَاتِهَا","مَزَاحِفُ قَيْنَاتٍ تَجَاذَبْنَ إِثْمِدَا",38,"د",2,0],["كان خيراً من السهاد رقادي","في حمى ظلك الوريف وأحلى",39,"ل",2,0],["كَأَنَّ خَفِيَّاتِ الكَواكبِ في الدُّجى","بياضُ ولاءٍ لاحَ في قلبِ ناصِبي",40,"ب",2,0],["كانَ خَتماً للأولياءِ تَبيعاً","بِهُداهُ لخاتمِ المرسلينا",41,"ن",2,0],["كانَ خيرَ الأنامِ خُلقاً فلا ال","فحشُ ملمٌّ بهِ ولا الفحشاءُ",42,"ا",2,0],["كانَ خيرَ الشجعانِ في كلّ حربٍ","كيفَ يَخشى واللَّه منه الكلاءُ",42,"ا",2,0],["كانَ خيرَ الأخيارِ رِفقاً وكلُّ الل","لطفِ منه قَد ناله اللطفاءُ",42,"ا",2,0],["كانَ خيرَ الأنامِ في كلِّ خيرٍ","ما لِخلقٍ سِواه معه اِستواءُ",42,"ا",2,0],["كأنَّ خزانةَ الأموالِ قبرٌ","ففي نفسِ الغنيِّ بها انكسارُ",43,"ر",1,0],["كأنَّ خَرَّ عليَّ السَّقْفُ مُرْتَمياً","لمّا على قَبْرِهِ الجُلاّءُ تَنْساقُ",44,"ق",1,0],["كأنّ خدّيه في سوادكما","صُبْحان قد طُرِّزا بليلين",45,"ن",1,0],["كأنّ خلجانه والماءُ يأخذُها","مدائنٌ فتحت فاحتازها الغرق",46,"ق",1,0],["كانَ خَصمي فَمُذ لَجَأتُ إِلى با","بِكَ أَضحَت أَيّامُهُ وَهيَ جُندي",47,"د",2,0],["كَأَنَّ خَوالِداً في الدارِ سُفعاً","بِعَرصَتِها حَماماتٌ وُقوعُ",48,"ع",1,0],["كَأَنَّ خَلايا فيهِ ضَلَّت رِباعُها","وَلَجَّةُ حُجّاجٍ وَغابٌ يُحَرَّقُ",49,"ق",1,0],["كَأَنَّ خَيالَ السَخلِ في كُلِّ مَنزِلٍ","يَضَعنَ بِهِ الأَسلاءَ أَطلاءُ طُحلُبِ",50,"ب",1,0],["كأنَّ خِيلانَه ووَجنَتَهُ","سَماءُ حُسنٍ نُجُومُها تَزهَر",51,"ر",1,0],["كأن خرير الماء والظل وارفٌ","عليه حكى واللَه أنغامَ مَعبَد",52,"د",1,0],["كَأَنَّ خوافِقَ أَعلامِهِنَّ","طيورٌ عَلَى الماءِ منها تَحُومُ",53,"م",1,0],["كَأَنَّ خُفُوقَ القَلْبِ مَدَّ جوانِحي","بأَجْنِحَةٍ رِيشَتْ منَ الرَّوْعِ والذُّعْرِ",54,"ر",1,0],["كأن خراب الكون رهن بذلة","يصاب بها العقل الذي عز واستذرى",55,"ر",2,0],["كأنَّ خرقاءَ الرياحِ شرَّعتْ","في لُجَّةِ الآلِ بها سفينا",56,"ن",2,0],["كأنّ خِلاطَ البين بين حُمولهم","لواعجُ قلبي بعدهم وبلابلُهْ",57,"ل",2,0],["كأنّ خمَّار بُصرَى بات يسكبها","أو فضَّ عطّار دارين بها سفَطا",58,"ط",2,0],["كأنَّ خوافي ناهضٍ متمطَّرٍ","غدتْ بفؤادي يومَ زُمَّتْ حبالُها",59,"ل",3,0],["كأن خمراً وورساً في رحالهمُ","من الشُّخوب وخفق القوم العذر",60,"ر",1,0],["كأنَّ خيلك في الغارات موجفةً","سيدانُ قفرٍ وفرسان العدى غَنمُ",61,"م",1,0],["كأنَّ خطوط الدمع في وجناتهِ","مَذانبُ روضٍ أفْعَمتها سُيولُها",62,"ه",2,1],["كأنَّ خدَّيه وأصداغه","صبحُ الهدى من تحت ليل الضلال",63,"ل",1,0],["كَأَنَّ خَذولاً فِي الكناسِ أَعارَها","غَداة تَبَدَّت عُنقَها وَالمقلدا",64,"د",2,0],["كأنّ خاتَمَهُ يومَ النّوالِ بها","قوسُ السّحابِ الغَوادي حينَ ينهَمِلُ",65,"ل",1,0],["كأنَّ خِضْرَ بنَ رَعدٍ حلَّ ساحتَهُ","فأرعَدَتْ مُزنةٌ واخضَرَّ بُستانُ",66,"ن",1,0],["كأَنَّ خِلالَ الطِّرسِ بين سُطورِه","مباسمُ دُرٍّ في شِفاه زَبرْجَد",67,"د",1,0],["كَأَنَّ خِلالَهُ أَن رَمَت مَدحاً","لِأَنواعِ الثَنا مِنها اِنتِهابُ",68,"ب",1,0],["كانَ خطيباً واعظاً مرشداً","إلى سبيلِ الرشدِ يهدي الأنام",69,"م",1,0],["كَأنَّ خَيلَكَ إذ أَردَتكَ وانصَرَفَت","قَد قَرَّبَت بِكَ عِندَ اللهِ قُربانا",70,"ن",2,0],["كان خَراجُ العقلِ أبقى لهم","مَن لَهمُ اليوم بِضِعفِ الخَراج",71,"ج",1,0],["كأن خديه ديناران قد وزنا","فحرر الصيرفي الوزن واحتاطا",72,"ط",2,1],["كأنّ خطيباً مُشرفاً من سموكها","وشمٌ الرُّبى من تحتها تتسمعُ",73,"ع",1,0],["كانَّ خريرَ الماء من لهواتها","تَبدّدُ دُرٌ ذابَ لو يتجمّعُ",73,"ع",1,0],["كأن خلفي إذا ما جد جدهما","إعصار عاصفةٍ مما تثيران",74,"ن",1,0],["كانَ خَطيبٌ قامَ فَوقَ المنبرِ","وَقالَ رَبِ اِرحَم وَسامح وَاِغفِر",75,"ر",1,0],["كان خَتْلاً منهم كَخْتَل ال