ttps://www.poetsgate.com/ViewPoem.aspx?id=31767",""],[6008,"رثاء بالشيوخ (مهل القعقاع -مساعد البنيه )","https://www.poetsgate.com/ViewPoem.aspx?id=60996",""],[6056,"نايض البرق","https://www.poetsgate.com/ViewPoem.aspx?id=130383",""],[6090,"البدر أشرق أم جبين سعيد","https://www.poetsgate.com/ViewPoem.aspx?id=170910",""],[2575,"مرحى فقد وضح الصواب","https://www.poetsgate.com/ViewPoem.aspx?id=1364",""],[6115,"احسن لي اعيش بين الناس وحداني","https://www.poetsgate.com/ViewPoem.aspx?id=180531",""],[6127,"أسد بابل","https://www.poetsgate.com/ViewPoem.aspx?id=188648",""],[6127,"يا ثورة الآس","https://www.poetsgate.com/ViewPoem.aspx?id=205889",""],[6147,"سوريا..لاءاتنا الحُمْر","https://www.poetsgate.com/ViewPoem.aspx?id=151697",""],[6237,"اليتيم السعيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77872&r=&rc=14",""],[6256,"الجلاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65927&r=&rc=15",""],[6261,"تباريحُ الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82137&r=&rc=9",""],[201,"أوقديها وذريها في حشايا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65300&r=&rc=9",""],[572,"لستُ على عذلِكَ صَبَّارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9316&r=&rc=173",""]],"verses":[["مُرَحِّلَ كُلَّ نائِبَةٍ مُقيماً","مُذيلاً لِلعِدا أَبَداً مَصونا",0,"ن",2,0],["مُرَحِّلي عَن بَلَدٍ","وَراجِماً بي بَلَدا",1,"د",2,0],["مَرَحَ الشَقراءِ في مِضمارِها","تَتَّقي الصَوتَ بِمَرٍّ عَجَبِ",2,"ب",1,0],["مَرحَباً بِالأَحِبَّةِ القادِمينا","فَلَعَمري لَطالَ ما أَوحَشونا",3,"ن",2,1],["مَرحَباً وَاللَهِ حَقّاً","بِحَبيبي وَأَميري",4,"ر",2,1],["مَرحَباً بِالًّتي تَجور عَلَينا","ثُمَّ أَهلاً بِحامِلٍ مَحمولِ",5,"ل",1,1],["مَرِحَت حُرَّةٌ كَقَنطَرَةِ الرو","مِيِّ تَفري الهَجيرَ بِالإِرقالِ",6,"ل",1,0],["مَرحَباً بِالخَطبِ يَبلوني إِذا","كانَتِ العَلياءُ فيهِ السَبَبا",7,"ب",2,0],["مَرْحَباً بِالفَضْلِ وَالنُّبْلِ مَعاً","طَلَعَا بِاليُمْنِ لِلْمُرْتَقِبِينْ",8,"ن",1,0],["مَرْحَباً أَيُّها الأمِيرُ الْجَلِيلُ","دُرَّةُ الْعِقْدِ وَالرَّئِيسُ النَّبِيلُ",9,"ل",1,1],["مَرْحَباً يَا هُدَاةَ مِصْرَ وَيَا قَا","دَتَهَا وَالسَّبِيلُ نِعْمَ السَّبِيِلُ",9,"ل",1,0],["مَرْحَباً يَا أَعِزَّةً بِنَدَاهُمْ","كُفِيَ المُعْتَفِي وَعَزَّ الذَّلِيلُ",9,"ل",1,0],["مَرْحَباً يَا عَقَائِلَ الطُّهْرِ والْبِرِّ","وَمَا ضَرَّ أَنَّهُنَّ قَلِيلُ",9,"ل",1,0],["مرحباً بالنظم يأتي","نفحةً من بعد نفحه",10,"ح",2,1],["مرحباً بالحيا لكلِّ جديبٍ","لا عدمنا نواله وظلاله",11,"ل",2,1],["مرحباً بالكفافِ يأتي هنيئاً","وعلى المُتعِبات ذيلُ العفاءِ",12,"ا",2,0],["مَرَحُ الأَزهارِ في غِنائِك وَالشَذى","وَطَلاقَةُ الغُدران وَالفَجر وَالنَدى",13,"د",2,0],["مَرَحُ الصِبا الجَذلانِ في أَسحارِها","وَمُنى الصِبا الوَلهانِ في آصالِها",14,"ل",3,0],["مَرحَباً بِالزائِرِ الوا","صِلِ وَالبَرِّ الشَفيقِ",15,"ق",1,1],["مرحب بك العرا","ق ريفه والحاضره",16,"ر",2,0],["مرحباً بالموت اني جاء ان","لم يكن بد من الموت لنا",17,"ن",2,0],["مرحبا بالفتى العظيم الشان","سيد الكل من بنى الألمان",18,"ن",1,1],["مرحبا بالثواب منك وأهلا","بليال جمالها لقياكما",19,"ك",3,0],["مَرحَباً بِالرَبيعِ في رَيعانِهِ","وَبِأَنوارِهِ وَطيبِ زَمانِه",20,"ن",2,1],["مَرحَباً بِالخَيالِ مِنكَ المُطيفِ","في شُموسٍ لَم تَتَّصِل بِكُسوفِ",21,"ف",1,1],["مرحباً يا عراق، جئت أغنيك","وبعضٌ من الغناء بكاء",22,"ا",2,1],["مرحباً، مرحباً.. أتعرف وجه","حفرته الأيام والأنواء؟",22,"ا",2,0],["مرحباً يا عراق،كيف العباءات","وكيف المها.. وكيف الظباء؟",22,"ا",2,0],["مرحباً يا عراق.. هل نسيتني","بعد طول السنين سامراء؟",22,"ا",2,0],["مرحباً يا جسور يا نخل يا نهر","وأهلاً يا عشب... يا أفياء",22,"ا",2,0],["مرحباً بالصَّبوحِ في الظَّلماءِ","وبعَذراءِ من يَدَيْ عذراءِ",23,"ا",2,1],["مَرحَباً مَرحَباً بِأَبطالِ لَهوٍ","شُهبُهُم سُمرُهُم إِذا اللَيلُ جَنّا",24,"ن",2,1],["مرحى ومرحى يا ربيع العام","أشرق فدتك مشارق الأيامِ",25,"م",1,1],["مرحباً بالهوى الكبير فإن يبق وإن تسلمي يطب لي البقاء","فهو القمة التي تهزم الموت ولا يرتقي إليها الفناء",26,"ا",2,0],["مَرحَباً ثُمَّ مَرهَباً بِالَّتي قا","لَت غَداةَ الوداعِ يَومَ الرَحيلِ",27,"ل",1,1],["مَرْحَى شبابَ النِّيلِ تلك جُهودُكم","ضَنّتْ بِوَحدتِه فلم تتصدَّعِ",28,"ع",1,0],["مَرْحباً بالموتِ يغشاه الفتى","فيراهُ للمعالي سُلَّما",29,"م",2,0],["مَرحَباً بِالإِخاءِ في حَرَمِ اللَ","هِ وَأَهلاً بِقَومِنا الصالِحينا",30,"ن",2,1],["مَرحى فَتى النيلِ لا ظُلمٌ وَلا جَنَفٌ","جازَيتَ قَومَكَ نِسياناً بِنِسيانِ",31,"ن",1,0],["مرحباً بالوفدِ وافى من هَجَرْ","يَبتغي الدِّينَ ويأبى من كَفَرْ",32,"ر",1,1],["مَرحباً بالأحبَّةِ المُقبلينا","أطفِئُوا شَوقَكم وقَضُّوا الحنينا",33,"ن",2,1],["مرحباً بالحقِّ يَحمِي جُندُهُ","ما استباحتْ تُرَّهاتُ المبطلين",34,"ن",1,0],["مرحباً بالوحي يجلو ما طَوتْ","ظُلماتُ الشكِّ من نُورِ اليقينْ",34,"ن",1,0],["مرحباً بالرُّوحِ يُلقي من عَلٍ","رحمةَ اللَّهِ تُغيثُ المؤمنين",34,"ن",1,0],["مرَّ حينٌ فكاد يق","تُلهُ اليأْسُ إنَّما",35,"م",2,0],["مرحباً بالحياةِ عادَ صاداها","وانجلى الليلُ عن صباحٍ مُبينِ",36,"ن",1,0],["مَرحَباً بِالثَقافَة الغَربيه","تَتَجلى في روحك الشَرقيه",37,"ي",2,1],["مَرحَباً بِالحَكيم محيي المَعري","مَرحَباً بِالنبوغ وَالعَبقَريه",37,"ي",2,0],["مَرحَباً بِالعَظيم أَكرَم ضَيف","لِمُلوك الجَزيرة العَربيه",37,"ي",2,0],["مَرحى لِشُبان البِلاد إِذا غَدا","كُل بِغير بِلاده لَم يَفتن",38,"ن",1,0],["مَرحى لِشبان البِلاد فَما لَهُم","إِلّا السمو إِلى العُلى مِن ديدن",38,"ن",1,0],["مَرحَباً مَرحَباً بِأُمِّ جُبَيرٍ","وَبِأَترابِها وَأَهلاً وَسَهلا",39,"ل",2,0],["مَرِحٌ مِسحَلُهُ","لا يَرومُ مَرحَلا",40,"ل",2,0],["مَرحَباً بِاِختِلاجِ جَفنِ عُيونٍ","بَشَّرَت عَينُها بِرُؤيَةِ شُرِّ",41,"ر",1,0],["مَرحَباً بِالمَلِكِ القا","دِمِ بِالجَدِّ السَعيدِ",42,"د",1,0],["مَرِحاتٍ يَحمِلنَ فِتيانَ لَهوٍ","لا يُطيعونَ في الهَوى فَنّادا",43,"د",2,0],["مَرحَباً يا سَمِيَ مَن كَلَّمَ اللَ","هُ وَأَدنى مَكانَهُ تَقريبا",44,"ب",2,1],["مَرحَباً مَرحَباً بِخَيرِ إِمامٍ","صيغَ مِن جَوهَرِ الخِلافَةِ بَحتا",45,"ت",2,1],["مَرحَباً وَاللَهِ لا أَكتُمُهُ","إِنَّ حُبّي عَلَنٌ لَيسَ يُسَر",46,"ر",1,0],["مَرحَباً بِالمَوتِ وَالعَيشُ دُجىً","وَحِمامُ المَرءِ كَالفَجرِ سَطَع",47,"ع",1,1],["مَرِحتَ كَالفَرَسِ الذَيّالِ آوِنَةً","ثُمَّ اِعتَراكَ أَبو سَعدٍ فَقَد شَكَلَك",48,"ك",1,0],["مَرِحتَ وَأَطرافُ الكَلاَليبِ تُتَّقى","فَقَد عَبَطَ الماءُ الحَميمُ فَأَسهَلا",49,"ل",2,0],["مرحّباً بك أشرافٌ غطارفة","وَلَيسَ ترحيبهم ميناً ولا فندا",50,"د",2,0],["مرحباً مصر مرحبا كُلٌّ أهلٍ","لك أهلُ وكُلُّ صدرٍ محلُّ",51,"ل",1,1],["مرحبا مِصْرُ يا شقيقتنا البك","ر ويحلو تَرْديد مصْر ويغلو",51,"ل",2,0],["مرحبا روح حافظ دونكِ الخلدُ","عيونا وأكؤُساً ورفاقا",52,"ق",2,0],["مَرحَبا بِالقَضاءِ هَل كُنتَ إِلّا","شَهدَةً لِلعَدِّ وَفيها سِمامُ",53,"م",1,0],["مَرْحَباً بِالشَّدَائِدِ الدُّهْمِ يَتْلُو","هَا صَبَاحٌ مِنْ نِعْمَةٍ وَرَخَاءِ",54,"ا",2,0],["مَرْحَى بمؤتمرٍ تبلّجَ نورهُ","في الشرقِ مثلَ تبلُّجِ الإصباح",55,"ح",1,0],["مَرْحَى بدولتهِمْ ماتت لمولدِها","فكانَ ميلادُها حُزْناً وتأبينَا",56,"ن",2,0],["مرحبا(سعيد) .. خذ نور عيني","اسكتي .. هات بندقي يا ( عبادي)..",57,"د",2,0],["مرحباً بالمتوج الغِطريفِ","حاملاً للعراق بُشرى جَنيفِ",58,"ف",1,1],["مرح الأزهار في غنائك والشّذى","وطلاقة الغدران والفجر الندي",59,"د",2,0],["مرحى لبائعة السرور ولا انطوت","ذكراك من نشوى الدّلال كعاب",60,"ب",1,0],["مرحى وإن عصر الشقاء سلافة","من وجنتيك أثيمة الأكواب",60,"ب",1,0],["مرحى وفي عينيك من صور الهوى","ما لا يعدّ ومن رؤى الأحباب",60,"ب",1,0],["مرحى لناشئة الشام ومرحبا","بالنشء إن عثرت أقال عثارها",61,"ر",3,0],["مرحبا مرحبا أتعرف وجها","حفرته الأيام والأنواء",62,"ا",2,0],["مَرِحٌ وَبلُهُ يَسُحُّ سُبوبَ الس","سَما مَجّاً كَأَنَّهُ مَنحورُ",63,"ر",1,0],["مرح على كيد الحياة وأهلها","يلقى شدائدها بأزهر ضاح",64,"ح",1,0],["مرحاً كما هبَّ النسيمُ مُجاذباً","أهدابَ خوط البانة المَيّاد",65,"د",1,0],["مَرحَباً بِالبَدر يَسرِي","مِن نُجُومٍ فِي وُفُودِ",66,"د",1,1],["مَرحَباً بالطُّلُوعِ بَعدَ أُفُولٍ","مَرحَباً بِالإِيَابِ بَعدَ المَغِيبِ",67,"ب",1,0],["مرحَباً بالهمّ بالأوجاعِ في","ساعةٍ تَغمُرُها ذكرى هوايا",68,"ي",2,0],["مرحَبا بالآهِ والالام في","صادقِ الحُبِّ وأهلاً بالرّزايا",68,"ي",2,0],["مرحباً مرحباً بطيفك يا من","لا يحل اللقاء في اليقظات",69,"ت",1,0],["مرحباً بالعَلاء وَفّى القَوافي","حَظُّها منه رِفعةٌ وَسناء",70,"ا",2,0],["مرحباً بالقَريضِ وَفّى المَعالي","قِسطُها منهُ رَونَقٌ وَسَناء",70,"ا",2,0],["مرحباً بِالمديحِ آياتِ صِدقٍ","لم يُخالِط رُواءَهُنّ