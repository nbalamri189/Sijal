{"poems":[[86,"علمان من أعلام مصر","https://www.aldiwan.net/poem10473.html","مجزوء الكامل"],[86,"من واجد منقر المنام","https://www.aldiwan.net/poem68846.html","الرجز"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[51,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[85,"لنا رقيب كان ما أثقله","https://www.aldiwan.net/poem7302.html","السريع"],[28,"إن تذعر الوحش من رأسي ولمته","https://www.aldiwan.net/poem5221.html","البسيط"],[80,"أنكرت سقم مذاب الجسد","https://www.aldiwan.net/poem31487.html","الرمل"],[44,"أرض مصردة وأخرى تثجم منها","https://www.aldiwan.net/poem30363.html","الكامل"],[105,"قومي أهاب من الحياة بشير","https://www.aldiwan.net/poem42068.html","الكامل"],[105,"مضت السيوف وولت الأرباب","https://www.aldiwan.net/poem44194.html","الكامل"],[105,"تعلموا كيف تبني مجدها الأمم","https://www.aldiwan.net/poem44217.html","البسيط"],[50,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85457","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55072","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141982","الخفيف"],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[107,"إن عبد الرحمن مولى المعالي","https://www.aldiwan.net/poem16509.html","الخفيف"],[113,"لاحظ المسكين بالمدد","https://www.aldiwan.net/poem42010.html","المديد"],[153,"رسم صبري في ربع شوقي محيل","https://www.aldiwan.net/poem55583.html","الخفيف"],[326,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[351,"يا أميرا حاز غايات العلى","https://www.aldiwan.net/poem40140.html","الرمل"],[362,"لمن الركائب سيرهن تهاد","https://www.aldiwan.net/poem60948.html","الكامل"],[403,"لج في حب من هويت العذول","https://www.aldiwan.net/poem50134.html","الخفيف"],[413,"كم دم فيك أيها الريم طلا","https://www.aldiwan.net/poem54000.html","الخفيف"],[456,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[511,"يا أخي كم يكون هذا الجفاء","https://www.aldiwan.net/poem67799.html","الخفيف"],[573,"لست أدري بأي فتح تهنا","https://www.aldiwan.net/poem3001.html","الخفيف"],[584,"قابلت عز هواكم بتذلل","https://www.aldiwan.net/poem17666.html","الكامل"]],"verses":[["إِن تَذكُروا هِمَمَ الرِجا","لِ فَقَدِّموا ذِكراهُما",0,"م",2,0],["أَن تَذكُروا ناظِمَ ذا الكَلامِ","إِذا جَلَستُم مَجلِساً لِلجامِ",1,"م",1,0],["أنت ذاك الذي إذا لاح عيبٌ","جعل السِّترَ دونَهُ الإغطاءَ",2,"ا",2,0],["أنت ذو السُّؤْدُدَيْنِ لم يَعْدُكَ المو","رُوثُ من سؤْددٍ ولا المكسوبُ",3,"ب",1,0],["أنتَ ذاك الذي عهدتك قِدْماً","لا يغاليك في المعالي مُعالي",4,"ل",2,0],["أنت ذاك الذي عهدتك قِدماً","لا يغاليك في المساعي مغالي",5,"ل",2,0],["أنت ذو الإمرتين لا شكَّ فيه","فهنيئاً دامت لك الإمرتان",6,"ن",1,0],["إن تذكر الخنجر لفظا تصب","من شدّة الذعر به مقتله",7,"ل",2,0],["إِن تُذعَرِ الوَحشُ مِن رَأسي وَلِمَّتِهِ","فَقَد أَصيدُ بِها الغِزلانَ وَالبَقَرا",8,"ر",2,1],["أَنتَ ذاكَ الأَسَدُ الوَرْدُ فَهَلْ","كانَ في رمحك سَمّ الأسْوَدِ",9,"د",1,0],["إِن تَذهَبوا عَن مالِكٍ أَو تَجهَلوا","نُعماهُ فَالرَحِمُ القَريبَةُ تَعلَمُ",10,"م",1,0],["إن تذكروا اسْتقلالَ مِصرَ فإنَّه","رَمزٌ إلى اسْتِقلالِ مِصرَ يُشيرُ",11,"ر",1,0],["إن تذهبوا نَاجينَ من غَمَراتِهِ","فَلَكُمْ إليه مَرجِعٌ ومآبُ",12,"ب",1,0],["إن تذكروا يوم بدرٍ فهو يذكركم","والحزنُ أيسر ما يلقاه والألمُ",13,"م",1,0],["إِن تَذهَب الدارُ وَسُكّانُها","فَإِنَّ ما في القَلبِ لَم يَذهَبِ",14,"ب",1,0],["إن تذرهم يا رب في غيهم لا","يلدوا إلا فاجراً كفارا",15,"ر",2,0],["إِنْ تُذِيبُوا هَكَذَا أَكْبَادَنَا","يَا بَنِينَا فَالرَّدَى أَقْسَى الْعُقُوقِ",16,"ق",1,0],["أنتَ ذَوّبْتَ فيمَحاجِرِها السّحْرَ","وَرَصّعْتَبِاللآلىء فَاهَا",17,"ا",3,0],["أنت ذئب الأكواخ تخطف أطفا","ل ذويها من حضنهم والحجور",18,"ر",1,0],["أنت ذو سلطان على كل نفس","أنت في الأرض حاكم والسماء",18,"ا",2,0],["إِن تَذَكرت عَنهُ تَأخير مَدحي","قُلت ما قيلَ في الزَمان الخالي",19,"ي",1,0],["أنت ذخري والغياث إذا","ضاق رحبي أو وهى جلدي",20,"ي",1,0],["إِنْ تَذَكَّرْتُهُ فَشَوْقي صَحِيحٌ","أَوْ تَناسَيْتُهُ فَصَبْري عَلِيلُ",21,"ل",1,0],["أنت ذاتي المجهولة الذات عني","وأنا منك مثل لمح السراب",22,"ب",1,0],["أَنتَ ذو مَجدٍ وَلَكن أَرّخوا","سُنَّة الهادي كَمال الشَرَفِ",23,"ف",1,0],["إن تذْكروني تُبصروني عندَكُم","ولَوَ انَّ دُوني صَرْفَ كلِّ بِعاد",24,"د",1,0],["إِن تَذَكَّرت رَوضة الحَزن جادَت","مِن جُفوني عليه تَترى هُمولُ",25,"ل",1,0],["أَنْتَ ذاتٌ تُرى لدى كلّ يوم","ترتقي منصباً وتعلو محلاّ",26,"ل",2,0],["أنت ذاك الذي أمتَّ شبابي","عَبطةً وهو ما تَملَّى العمرا",27,"ر",2,0],["أنت ذاك الأخ القديم ولكن","ليس هذا الإخاء ذاك الإخاء",28,"ا",2,0],["أَنت ذكِّيْتَه فوفَّيتَ نذراً","كنت قدَّمته فجوزيتَ حُسْنا",29,"ن",2,0],["إِنْ تَذْكُرُونَ فَإِنَّني لَمْ أَنْسَكُمْ","أَوْ تَسْمَحُونَ فَإِنَّني لَمْ أَبْخَلِ",30,"ل",1,0]]}