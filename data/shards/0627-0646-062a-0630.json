{"poems":[[88,"علمان من أعلام مصر","https://www.aldiwan.net/poem10473.html","مجزوء الكامل"],[88,"من واجد منقر المنام","https://www.aldiwan.net/poem68846.html","الرجز"],[53,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[53,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[53,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[87,"لنا رقيب كان ما أثقله","https://www.aldiwan.net/poem7302.html","السريع"],[30,"إن تذعر الوحش من رأسي ولمته","https://www.aldiwan.net/poem5221.html","البسيط"],[82,"أنكرت سقم مذاب الجسد","https://www.aldiwan.net/poem31487.html","الرمل"],[46,"أرض مصردة وأخرى تثجم منها","https://www.aldiwan.net/poem30363.html","الكامل"],[107,"قومي أهاب من الحياة بشير","https://www.aldiwan.net/poem42068.html","الكامل"],[107,"مضت السيوف وولت الأرباب","https://www.aldiwan.net/poem44194.html","الكامل"],[107,"تعلموا كيف تبني مجدها الأمم","https://www.aldiwan.net/poem44217.html","البسيط"],[52,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85457","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55072","المتقارب"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141982","الخفيف"],[91,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[113,"إن عبد الرحمن مولى المعالي","https://www.aldiwan.net/poem16509.html","الخفيف"],[119,"لاحظ المسكين بالمدد","https://www.aldiwan.net/poem42010.html","المديد"],[159,"رسم صبري في ربع شوقي محيل","https://www.aldiwan.net/poem55583.html","الخفيف"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[358,"يا أميرا حاز غايات العلى","https://www.aldiwan.net/poem40140.html","الرمل"],[369,"لمن الركائب سيرهن تهاد","https://www.aldiwan.net/poem60948.html","الكامل"],[412,"لج في حب من هويت العذول","https://www.aldiwan.net/poem50134.html","الخفيف"],[422,"كم دم فيك أيها الريم طلا","https://www.aldiwan.net/poem54000.html","الخفيف"],[463,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[518,"يا أخي كم يكون هذا الجفاء","https://www.aldiwan.net/poem67799.html","الخفيف"],[580,"لست أدري بأي فتح تهنا","https://www.aldiwan.net/poem3001.html","الخفيف"],[591,"قابلت عز هواكم بتذلل","https://www.aldiwan.net/poem17666.html","الكامل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39179","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48781","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38149","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38950","الرمل"],[942,"","https://poetry.dctabudhabi.ae/diwan/poem/123688","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59433","الخفيف"],[1058,"","https://poetry.dctabudhabi.ae/diwan/poem/198786","الخفيف"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202116","الخفيف"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133849","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136361","الخفيف"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56614","البسيط"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128698","الخفيف"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114709","الرمل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137013",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93778","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93919","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100363","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200049","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204693","الخفيف"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67986","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74062","الخفيف"],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104854","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205948","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216831","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117927","السريع"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36789","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85187","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85176","الخفيف"],[3771,"","https://poetry.dctabudhabi.ae/diwan/poem/67759","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131289",""],[3830,"","https://poetry.dctabudhabi.ae/diwan/poem/122249","الرمل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102981","الخفيف"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76500","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111397","الخفيف"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105258","الرمل"],[3975,"","https://poetry.dctabudhabi.ae/diwan/poem/75816","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54460","الكامل"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104520","الخفيف"],[4727,"من ديارِ بالقليبِ جديبِ","https://www.poetsgate.com/ViewPoem.aspx?id=208015",""],[4739,"ياهلا","https://www.poetsgate.com/ViewPoem.aspx?id=28120",""],[4578,"في ربيع عادنا عيد الجلوس","https://www.poetsgate.com/ViewPoem.aspx?id=49443",""],[5038,"وشم الدمع","https://www.poetsgate.com/ViewPoem.aspx?id=196717",""],[5163,"أمطري يا سماء","https://www.poetsgate.com/ViewPoem.aspx?id=33942",""],[5186,"يا بروحي لاعبات التنس","https://www.poetsgate.com/ViewPoem.aspx?id=156500",""],[5186,"والليالي ميدان ذا الدهر فيه","https://www.poetsgate.com/ViewPoem.aspx?id=156470",""],[5431,"متعة الشعر ...","https://www.poetsgate.com/ViewPoem.aspx?id=205267",""],[5480,"من لذي بالشعر","https://www.poetsgate.com/ViewPoem.aspx?id=1149",""],[4623,"ما ثنائي عليك إلا يسير ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146774",""],[6115,"يارصيف الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=180526",""],[6213,"إشراقة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79027&r=&rc=69",""],[6317,"أ معلّمي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86080&r=&rc=3",""]],"verses":[["إِن تَذكُروا هِمَمَ الرِجا","لِ فَقَدِّموا ذِكراهُما",0,"م",2,0],["أَن تَذكُروا ناظِمَ ذا الكَلامِ","إِذا جَلَستُم مَجلِساً لِلجامِ",1,"م",1,0],["أنت ذاك الذي إذا لاح عيبٌ","جعل السِّترَ دونَهُ الإغطاءَ",2,"ا",2,0],["أنت ذو السُّؤْدُدَيْنِ لم يَعْدُكَ المو","رُوثُ من سؤْددٍ ولا المكسوبُ",3,"ب",1,0],["أنتَ ذاك الذي عهدتك قِدْماً","لا يغاليك في المعالي مُعالي",4,"ل",2,0],["أنت ذاك الذي عهدتك قِدماً","لا يغاليك في المساعي مغالي",5,"ل",2,0],["أنت ذو الإمرتين لا شكَّ فيه","فهنيئاً دامت لك الإمرتان",6,"ن",1,0],["إن تذكر الخنجر لفظا تصب","من شدّة الذعر به مقتله",7,"ل",2,0],["إِن تُذعَرِ الوَحشُ مِن رَأسي وَلِمَّتِهِ","فَقَد أَصيدُ بِها الغِزلانَ وَالبَقَرا",8,"ر",2,1],["أَنتَ ذاكَ الأَسَدُ الوَرْدُ فَهَلْ","كانَ في رمحك سَمّ الأسْوَدِ",9,"د",1,0],["إِن تَذهَبوا عَن مالِكٍ أَو تَجهَلوا","نُعماهُ فَالرَحِمُ القَريبَةُ تَعلَمُ",10,"م",1,0],["إن تذكروا اسْتقلالَ مِصرَ فإنَّه","رَمزٌ إلى اسْتِقلالِ مِصرَ يُشيرُ",11,"ر",1,0],["إن تذهبوا نَاجينَ من غَمَراتِهِ","فَلَكُمْ إليه مَرجِعٌ ومآبُ",12,"ب",1,0],["إن تذكروا يوم بدرٍ فهو يذكركم","والحزنُ أيسر ما يلقاه والألمُ",13,"م",1,0],["إِن تَذهَب الدارُ وَسُكّانُها","فَإِنَّ ما في القَلبِ لَم يَذهَبِ",14,"ب",1,0],["إن تذرهم يا رب في غيهم لا","يلدوا إلا فاجراً كفارا",15,"ر",2,0],["إِنْ تُذِيبُوا هَكَذَا أَكْبَادَنَا","يَا بَنِينَا فَالرَّدَى أَقْسَى الْعُقُوقِ",16,"ق",1,0],["أنتَ ذَوّبْتَ فيمَحاجِرِها السّحْرَ","وَرَصّعْتَبِاللآلىء فَاهَا",17,"ا",3,0],["أنت ذئب الأكواخ تخطف أطفا","ل ذويها من حضنهم والحجور",18,"ر",1,0],["أنت ذو سلطان على كل نفس","أنت في الأرض حاكم والسماء",18,"ا",2,0],["إِن تَذَكرت عَنهُ تَأخير مَدحي","قُلت ما قيلَ في الزَمان الخالي",19,"ل",2,0],["أنت ذخري والغياث إذا","ضاق رحبي أو وهى جلدي",20,"د",2,0],["إِنْ تَذَكَّرْتُهُ فَشَوْقي صَحِيحٌ","أَوْ تَناسَيْتُهُ فَصَبْري عَلِيلُ",21,"ل",1,0],["أنت ذاتي المجهولة الذات عني","وأنا منك مثل لمح السراب",22,"ب",1,0],["أَنتَ ذو مَجدٍ وَلَكن أَرّخوا","سُنَّة الهادي كَمال الشَرَفِ",23,"ف",1,0],["إن تذْكروني تُبصروني عندَكُم","ولَوَ انَّ دُوني صَرْفَ كلِّ بِعاد",24,"د",1,0],["إِن تَذَكَّرت رَوضة الحَزن جادَت","مِن جُفوني عليه تَترى هُمولُ",25,"ل",1,0],["أَنْتَ ذاتٌ تُرى لدى كلّ يوم","ترتقي منصباً وتعلو محلاّ",26,"ل",2,0],["أنت ذاك الذي أمتَّ شبابي","عَبطةً وهو ما تَملَّى العمرا",27,"ر",2,0],["أنت ذاك الأخ القديم ولكن","ليس هذا الإخاء ذاك الإخاء",28,"ا",2,0],["أَنت ذكِّيْتَه فوفَّيتَ نذراً","كنت قدَّمته فجوزيتَ حُسْنا",29,"ن",2,0],["إِنْ تَذْكُرُونَ فَإِنَّني لَمْ أَنْسَكُمْ","أَوْ تَسْمَحُونَ فَإِنَّني لَمْ أَبْخَلِ",30,"ل",1,0],["إنْ تَذُمَّ الحَسُودَ ذَمَّكَ جَهْراً","أو تَنَلْ منهُ نالَ مِنْكَ وَغيّا",31,"ي",2,1],["أنت ذو الحق لا تبالي أحبو","ه على حالتيه أم كرهوه",32,"و",2,0],["أَنتَ ذاتي وَلا أُحِبُّ لذاتي","غَيرَ ثَوبِ الكَمالِ في كلِّ حالِ",33,"ل",1,1],["إِنْ تَذُقْهُ لَحظَةً كُنتَ تَجِدْ","أَنّ لَومَ الصبِّ في العِشقِ حَرامْ",34,"م",1,0],["أنت ذخر الضعيف أن يخش عند ال","بعث والحشر هول يوم عصيب",35,"ب",1,0],["أنت ذخري إذا دعيت لعرض","أنت عوني على الأمور الشداد",36,"د",1,0],["أنت ذخر وغيمة واحتضان","ويد - في فعالها - بيضاء",37,"ا",2,0],["أنت ذخري وعدتي لمعادي","ونجاتي حين اقتراب حمامي",38,"م",2,0],["أنت ذنوبي كل ذنوبي","تباركت كلها الذنوب",39,"ب",1,0],["إن تذكار وقتنا الميمون","في قديم الزمان أبكى عيوني",40,"ن",2,1],["أن تذو يا غصن مصر في حديقتها","فحسبها منك أن قد أينع الثمر",41,"ر",1,0],["أنت ذخري وعدتي وملاذي","وغياثي وعمدتي ورجائي",42,"ا",2,0],["أَنتَ ذو قَلبٍ سَلِيمٍ","فاحمَدِ اللَهَ وَإِلَّا",43,"ل",2,0],["انت ذو رأي على تفضيله","اجمع الناس وهل يخفى القمر",44,"ر",1,0],["أنت ذخري يا من يقول لك اللَ","ه حبيبي سل تعط كيف تشاء",45,"ا",2,0],["أنت ذخري وملجئي وملاذي","وغياثي وموئلي وثمالي",46,"ل",2,0],["انت ذاك الفتى المشار اليه","مفرد في الزمان قد عزَّ مثلا",47,"ل",2,0],["انت ذاك الحبيب روحا وحسنا","فيك يبدو ممثلا تمثيلا",48,"ل",2,0],["أنت ذاك المحكي بين طيور","وسواك الأصداء والنُظّام",49,"م",1,0],["إِنْ تذَرْها لدى الجهالةِ هامتْ","أَوْ تَرِدْها التُّقَى تَحِنُّ هُياما",50,"م",2,0],["أَنتَ ذاكَ العَضبُ الَّذي لَيسَ يَنبو","بتباع اِنتضائِهِ واِستلاله",51,"ل",2,0],["أنت ذاك المعنى المشار إليه","قدس اللَه سره أن يراما",52,"م",2,0],["أنت ذكرى وأنت بُشرى فهيها","ت لقلب عن أي نهجيك منحى",53,"ح",2,0],["إن تذكروه فما ذكرتم باسمه","الا الجدود الصيد والأحفادا",54,"د",2,0],["إن تذر بغياً في حمى حاكم","ظنت منال الربح في خسره",55,"ر",2,0],["أَنتَ ذاكَ الَّذي عَلا","ما بِهِ جاءَ وَاِنتَهَض",56,"ض",1,0],["أنت ذخري يا سيدي فك أسري","وأرحني من مهمه الحوباء",57,"ا",2,0],["أنت ذخري لها فديتك قم بي","ها أنا مقعد وعلمك حسبي",58,"ي",1,0],["إن تذره فما معاوية الده","رَ بمعطيك ما أراك تشاءُ",59,"ا",2,0],["ان تذكروا فلكل قلبٍ غبطةٌ","بكم وملء فم الزمان ثناء",60,"ا",2,0],["أنت ذخري أنت فخري","في ضلالي أنت رشدي",61,"ي",1,0],["أنت ذاك القضاء لا تعرف","التقديم في حالة ولا التأخيرا",62,"ر",2,0],["أَنتَ ذو حظ الى امثاله","عَن سَواد اللَيل دين وَسلف",63,"ف",1,0],["أنتَ ذا الشَّعبَ قد فرَستَ بظُلمٍ","حيثُ بَينَ الأَنذالِ كُنتَ المُفَضَّل",64,"ل",1,0],["ان تذكرت بها عصراً مضى","يذب القلب اشتياقاً وغراما",65,"م",2,0],["إِنْ تَذْكُروا يَوْمَ القَرِيِّ فإنَّهُ","بَواءٌ بأيامٍ كثيرٍ عَديدُها",66,"د",3,1],["إن تذهلوا عنّي فإنّي ذاهلٌ","بهواكم عن ذكركم لا أَذهلُ",67,"ل",1,0],["ان تذقه تجده خير طعام","وهوري إذا اعتراك اللوح",68,"ح",1,0],["إنْ تذرني معلقاًّ في الثُّرَيَّا","كَتَذرنِي مُعَلَّقاً في الصَّليبِ",69,"ب",1,0],["ان تذكرتك .. تذكرتك بخير","وان سليتك شفت بعيوني غلاك",70,"ك",1,0],["إن تذار جلوس ذاته","فوق تخت الملك معلٍ لرؤس",71,"س",1,0],["أنْت ذاكَ الوجْدُ أبْقى شعلةً","في فؤادي بضرامٍ يلْهبُ",72,"ب",1,0],["أنتِ ذاتَ النشيدِ تهدينَ دوماً","أطبق ِ الراحتين ِ أخْلِص ْ نَجِيّا",73,"ي",2,0],["أنت ذو عقل وحس فاتئد","وعلى الهديين طبق وقس",74,"س",1,0],["أنت ذخر الأخلاق فضلا ونبلا","واتداعا ورفعة واتضاعا",75,"ع",2,0],["أن تذوق انزياحه شهد نحل","حطّ بالروض موغلا بالكشوف!",76,"ف",1,0],["أنت ذوقي وأنت لي مدي","والشعر له تاج عربانه",77,"ن",2,0],["أنت ذخري الذي أذخرت بدنيا","ولاخراى وهو ذخر كبير",78,"ر",1,0],["انت ذبحك لا حرام ولا حلال","ياشبيه النايم اللى ماصحا",79,"ح",2,0],["إن تذهبي تهنو النضارة في دمي","ويريعني سوط اللهيب ويحرق",80,"ق",1,0],["إن تذهبي تخبو الحياة ووهجها","وأضيع في كهف الدهور وأُصعق",80,"ق",1,0],["إن تذهبي ينأى الفؤاد وينزوي","متقلباً فوق اللظى يتحرّق",80,"ق",1,0],["أن تذرف الأرض الدموع حزينةً","ويخرّ رضوى مصعقًا مشلولا",81,"ل",2,0]]}