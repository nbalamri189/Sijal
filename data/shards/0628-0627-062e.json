{"poems":[[53,"يا رفيقي قفا نضويكما","https://www.aldiwan.net/poem29724.html","الرمل"],[53,"أمير المؤمنين بثثت فينا","https://www.aldiwan.net/poem29796.html","الوافر"],[53,"لا يرعك الحي إن قيل هلك","https://www.aldiwan.net/poem29912.html","الرمل"],[53,"رجونا أبا الهيجاء إذ مات حارث","https://www.aldiwan.net/poem30665.html","الطويل"],[93,"كتابك في الرشيد كتاب صدق","https://www.aldiwan.net/poem11129.html","الوافر"],[72,"سل أسياف لحظه","https://www.aldiwan.net/poem19666.html","مجزوء الخفيف"],[72,"إن طيفا عن حال شجواي أملى","https://www.aldiwan.net/poem20543.html","الخفيف"],[51,"وصديق أجبته إذ دعاني","https://www.aldiwan.net/poem61866.html","الخفيف"],[51,"دع لباك رسومه وطلوله","https://www.aldiwan.net/poem65987.html","الخفيف"],[51,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[51,"أمسى دمشقي الأمير ودهره","https://www.aldiwan.net/poem66442.html","الكامل"],[62,"نظري إلى لمع الوميض حنين","https://www.aldiwan.net/poem52265.html","الكامل"],[45,"يا فضل فيما الصدود والغضب","https://www.aldiwan.net/poem11496.html","المنسرح"],[28,"رأيت بني مروان يرفع ملكهم","https://www.aldiwan.net/poem1276.html",""],[28,"إذا أثفروا كل خفاقة","https://www.aldiwan.net/poem5045.html","المتقارب"],[28,"عزفت بأعشاش وما كدت تعزف","https://www.aldiwan.net/poem5335.html","البسيط"],[61,"لنا مجلس لو لم تغب عنه كامل","https://www.aldiwan.net/poem51481.html","الطويل"],[74,"كفاني شكوى أن أرى المجد شاكيا","https://www.aldiwan.net/poem13277.html","الطويل"],[46,"إليك تناهى كل فخر وسؤدد","https://www.aldiwan.net/poem23640.html","الطويل"],[8,"ومولى جفت عنه الموالي كأنما","https://www.aldiwan.net/poem21767.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39601","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16638","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55143","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141988","الكامل"],[120,"يحييك الفؤاد على التنائي","https://www.aldiwan.net/poem49288.html","الوافر"],[150,"بمدح النبي اقطع زمانك ترشد","https://www.aldiwan.net/poem68596.html","الطويل"],[189,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[271,"وجد تحرك في قلبي فما سكنا","https://www.aldiwan.net/poem52053.html","البسيط"],[303,"روى حسنه عن عارض فوق خده","https://www.aldiwan.net/poem58320.html","الطويل"],[391,"يانوران شيئت النور","https://www.aldiwan.net/poem54446.html","عموديه"],[458,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[461,"يا لقومي من تيمي دعوة","https://www.aldiwan.net/poem15136.html","الرمل"],[464,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[500,"إلهي بنور الذات في القدم الأسمى","https://www.aldiwan.net/poem37803.html","الطويل"],[500,"رفعت بسري كل أمري لسيدي","https://www.aldiwan.net/poem38020.html","الطويل"],[540,"ألا ما لرسم الدار لا يتكلم","https://www.aldiwan.net/poem56668.html","الطويل"]],"verses":[["باخِلٌ بُخلَ الَّذي أَرسَلَهُ","سُئِلَ النَيلَ وَما جادَ لَنا",0,"ن",2,0],["بِأَخلاقٍ كَما دَجَتِ اللَيالي","وَأَحسابٌ كَمَ نَغِلَ الأَديمُ",1,"م",1,0],["باخِلٌ إِن ضافَهُ الحَقُّ فَلا","أَعتَقَ المالَ وَلا العَرضَ مَلَك",2,"ك",1,0],["بِأَخلاقِ أَبّاءٍ يَعودُ بِها الأَذى","وَعوراً عَلى الأَعداءِ وَهيَ دَمائِثُ",3,"ث",1,0],["بِأَخْذٍ عَنْ ثِقَاتِ الرَّأْيِ فِيهَا","هَدَاكِ إلى رَوَابِطِهَا الوَثِيقَهْ",4,"ق",2,0],["باخل لا يرقّ من","دمع عيني لسائل",5,"ل",1,0],["باخلٌ بالكلامِ لكن له سيَّا","ف لحظٍ تكلَّم الناس عنه طفلا",6,"ل",2,0],["باخلٌ حين يبذل القومُ رِفْداً","ماطلٌ حين يُنْجز القومُ وَعْدا",7,"د",2,0],["بأخي بل بوالدي بل بنفسي","ليتَ نفسي من قبله مثكولهْ",8,"ل",2,0],["بأخضر جادَهُ طلٌّ ووبْلٌ","وما جرمته بينهما الرِّهامُ",9,"م",1,0],["بأخ شقيقٍ بعد أُمٍّ برةٍ","بالأمس قطَّع منهما أقرانَهُ",10,"ن",2,0],["بأخيهِ شدَّ اللّهُ أزرَ جلالهِ","ووزيرُه من أهلِه هارونُ",11,"ن",1,0],["باخَ سَنا نارِ وُدِّهِ فَخَبا","وَكانَ حيناً لِنارِهِ لَهَبُ",12,"ب",1,0],["بِأَخلاقِ أَيدي المُطعِمينَ إِذا الصَبا","تَصَبَّبَ قُرّاً غَيرَ ماءٍ صَبيبُها",13,"ب",3,0],["بِأَخيَلَ مِنهُم إِذا زَيَّنوا","بِمَغرَتِهِم حاجِبَي مُؤجَدِ",14,"د",1,0],["بِأَخضَرَ مِن نَعمانَ ثُمَّ جَلَت بِهِ","عِذابَ الثَنايا طَيِّباً حينَ يُرشَفُ",15,"ف",1,0],["بأخضر تبدو منه للعين لجةٌ","تَلاقَتْ دَبورٌ فوقَها وقَبولُ",16,"ل",1,0],["بِأَخفَقَ أَحشاءً وَأَنبا حَشِيَّةً","وَأَضرَمَ أَنفاساً وَأَندى مَآقِيا",17,"ي",2,0],["بأخضَرَ مثلِ البحرِ ليس اخضرارُه","من الماء لكنْ من حديدٍ مُسَرَّدِ",18,"د",1,0],["بِأَخضَرَ كالقَهقَرِّ يَنفُضُ رَأسَهُ","أَمام رِعالِ الخَيلِ وَهي تُقَرِّبُ",19,"ب",1,0],["باخوس فيها وهو صاحبُها","لم يخْلُ حين أفاق من عَجبِ",20,"ب",1,0],["باخوسُ يروي عن غرائبهمْ","شتى أحاديثٍ وأنباءِ",20,"ا",2,0],["بإخْوَتِهِ الّذينَ هُمُ أُسودٌ","على آثارِ مَقْدَمِه عِجال",21,"ل",1,0],["بَاخُومُ لِلْرُهْبَانِ مِنْ قِدَمٍ بَنَى","دَيْراً فَكَانَ بِمَا بَنَاهُ الأَوَّلاَ",22,"ل",2,1],["بأخى هوى متماسك فى أضلعى","سمح على شيع الجمال مفرق",23,"ق",1,0],["بأخلاق كعهديها رقاق","يضيق بها الزمان ولا تضيق",24,"ق",1,0],["بِأَخفانفِ إِبلٍ أَو سَنابِكِ جَبهَةٍ","بِجاهِ المُعَلّى فَوقَ نَسرٍ وَجَبهَةٍ",25,"ه",1,0],["بِآخرِ شهرِ الصومِ من عام سبعةٍ","وَعشرينَ قد أَبدى المنارُ له ذِكرا",26,"ر",2,0],["باخائضا غمرات الشوق متخذا","حسن التوكل زادا وَالرضا سفنا",27,"ن",2,0],["بأخضر يعلو أحمرا فوق أبيض","فقلت لهم هذا الحديث المدبج",28,"ج",1,0],["باخلاص في ذي الدنيه","وكل خصله عليه",29,"ه",1,0],["باخلاص مع صدق نيه","في كل خصله عليه",29,"ه",1,0],["بأخي وتفضُله لقد جمعتْ","زِنةَ الوقارِ وخِفّةَ الحمْلِ",30,"ل",1,0],["باخلُ الخاطِرِ والكفِّ معاً","يحسبُ البذل عن العِرض غَبنْ",31,"ن",1,0],["بأخي الفصاحة ناطقاً بأبي المعالي","ساعياً بمجيدها ابن مجيدها",32,"د",3,0],["بإِخلاصِ أَلبابٍ بنورِكَ أَشرَقَتْ","جَلَوْتَ عليها من طِرازِ الهُدى رَقْمَا",33,"م",2,0],["بِإخْلاصِهمْ رَبِّي بِلُطفِ أنينِهم","بِرَشِّ دُموعٍ دونَها رَشَّةُ القَطْرِ",34,"ر",1,0],["بِأَخزَمَ أَو بِالمُنحَنى مِن سوَيقَةٍ","أَلا رُبَّما أَهدى لَكَ الشَوقَ أَخزَمُ",35,"م",1,0]]}