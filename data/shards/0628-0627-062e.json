{"poems":[[55,"يا رفيقي قفا نضويكما","https://www.aldiwan.net/poem29724.html","الرمل"],[55,"أمير المؤمنين بثثت فينا","https://www.aldiwan.net/poem29796.html","الوافر"],[55,"لا يرعك الحي إن قيل هلك","https://www.aldiwan.net/poem29912.html","الرمل"],[55,"رجونا أبا الهيجاء إذ مات حارث","https://www.aldiwan.net/poem30665.html","الطويل"],[95,"كتابك في الرشيد كتاب صدق","https://www.aldiwan.net/poem11129.html","الوافر"],[74,"سل أسياف لحظه","https://www.aldiwan.net/poem19666.html","مجزوء الخفيف"],[74,"إن طيفا عن حال شجواي أملى","https://www.aldiwan.net/poem20543.html","الخفيف"],[53,"وصديق أجبته إذ دعاني","https://www.aldiwan.net/poem61866.html","الخفيف"],[53,"دع لباك رسومه وطلوله","https://www.aldiwan.net/poem65987.html","الخفيف"],[53,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[53,"أمسى دمشقي الأمير ودهره","https://www.aldiwan.net/poem66442.html","الكامل"],[64,"نظري إلى لمع الوميض حنين","https://www.aldiwan.net/poem52265.html","الكامل"],[47,"يا فضل فيما الصدود والغضب","https://www.aldiwan.net/poem11496.html","المنسرح"],[30,"رأيت بني مروان يرفع ملكهم","https://www.aldiwan.net/poem1276.html",""],[30,"إذا أثفروا كل خفاقة","https://www.aldiwan.net/poem5045.html","المتقارب"],[30,"عزفت بأعشاش وما كدت تعزف","https://www.aldiwan.net/poem5335.html","البسيط"],[63,"لنا مجلس لو لم تغب عنه كامل","https://www.aldiwan.net/poem51481.html","الطويل"],[76,"كفاني شكوى أن أرى المجد شاكيا","https://www.aldiwan.net/poem13277.html","الطويل"],[48,"إليك تناهى كل فخر وسؤدد","https://www.aldiwan.net/poem23640.html","الطويل"],[8,"ومولى جفت عنه الموالي كأنما","https://www.aldiwan.net/poem21767.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39601","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16638","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55143","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141988","الكامل"],[124,"يحييك الفؤاد على التنائي","https://www.aldiwan.net/poem49288.html","الوافر"],[154,"بمدح النبي اقطع زمانك ترشد","https://www.aldiwan.net/poem68596.html","الطويل"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[276,"وجد تحرك في قلبي فما سكنا","https://www.aldiwan.net/poem52053.html","البسيط"],[308,"روى حسنه عن عارض فوق خده","https://www.aldiwan.net/poem58320.html","الطويل"],[396,"يانوران شيئت النور","https://www.aldiwan.net/poem54446.html","عموديه"],[463,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[466,"يا لقومي من تيمي دعوة","https://www.aldiwan.net/poem15136.html","الرمل"],[469,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[505,"إلهي بنور الذات في القدم الأسمى","https://www.aldiwan.net/poem37803.html","الطويل"],[505,"رفعت بسري كل أمري لسيدي","https://www.aldiwan.net/poem38020.html","الطويل"],[545,"ألا ما لرسم الدار لا يتكلم","https://www.aldiwan.net/poem56668.html","الطويل"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146215","المديد"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48823","المتقارب"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122370","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63944","الخفيف"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199592","المسحوب"],[879,"","https://poetry.dctabudhabi.ae/diwan/poem/107038","الكامل"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99982","الوافر"],[955,"","https://poetry.dctabudhabi.ae/diwan/poem/34999","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59624","الطويل"],[997,"","https://poetry.dctabudhabi.ae/diwan/poem/132404","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120021","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59247","الخفيف"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96585","الطويل"],[1378,"","https://poetry.dctabudhabi.ae/diwan/poem/216840",""],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115988","الخفيف"],[1467,"","https://poetry.dctabudhabi.ae/diwan/poem/136781",""],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49585","السريع"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66288","الوافر"],[1840,"","https://poetry.dctabudhabi.ae/diwan/poem/216655",""],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46437","الطويل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104791","الطويل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102122","الوافر"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199813","المسحوب"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27447","الطويل"],[3031,"","https://poetry.dctabudhabi.ae/diwan/poem/22557","الطويل"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67595","الكامل"],[3560,"","https://poetry.dctabudhabi.ae/diwan/poem/117146","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90801","الطويل"],[4221,"","https://poetry.dctabudhabi.ae/diwan/poem/132504","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73319","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73239","المديد"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73103","الرجز"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62145","السريع"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33415","الخفيف"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119523","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139750",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139499",""],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101933","الرمل"],[4578,"زفافٌ لبدر العز بالسعد أشرقا","https://www.poetsgate.com/ViewPoem.aspx?id=49491",""],[4869,"عاشق الريم","https://www.poetsgate.com/ViewPoem.aspx?id=151535",""],[4869,"مايعيش قلب الطيّب","https://www.poetsgate.com/ViewPoem.aspx?id=151564",""],[4884,"ثغر الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=205064",""],[585,"مغلغلة منشورةٌ في المحافل","https://www.poetsgate.com/ViewPoem.aspx?id=161901",""],[5136,"دعه يبكي فمن بكى يستريح","https://www.poetsgate.com/ViewPoem.aspx?id=121548",""],[5145,"يا أرض إن أردت أن تفاخري","https://www.poetsgate.com/ViewPoem.aspx?id=108178",""],[592,"لعمرك ما يدري الغبي بأنه","https://www.poetsgate.com/ViewPoem.aspx?id=128805",""],[5370,"كيفي ومزاجي","https://www.poetsgate.com/ViewPoem.aspx?id=81388",""],[5376,"علي الأذربيجاني ونينو الجورجية","https://www.poetsgate.com/ViewPoem.aspx?id=202463",""],[5431,"بات لثم الثغر أحلى","https://www.poetsgate.com/ViewPoem.aspx?id=189563",""],[5459,"سطور المجد","https://www.poetsgate.com/ViewPoem.aspx?id=196503",""],[5677,"مقادير","https://www.poetsgate.com/ViewPoem.aspx?id=179849",""],[5756,"رثاء الشيخ زايد","https://www.poetsgate.com/ViewPoem.aspx?id=8433",""],[5943,"سلام الله يلقيه السرورُ","https://www.poetsgate.com/ViewPoem.aspx?id=37262",""],[5956,"الرسالة المحمدية","https://www.poetsgate.com/ViewPoem.aspx?id=184653",""],[5956,"هبَّ الحجيج","https://www.poetsgate.com/ViewPoem.aspx?id=193699",""],[6229,"إنسان أي إنسان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65211&r=&rc=34",""]],"verses":[["باخِلٌ بُخلَ الَّذي أَرسَلَهُ","سُئِلَ النَيلَ وَما جادَ لَنا",0,"ن",2,0],["بِأَخلاقٍ كَما دَجَتِ اللَيالي","وَأَحسابٌ كَمَ نَغِلَ الأَديمُ",1,"م",1,0],["باخِلٌ إِن ضافَهُ الحَقُّ فَلا","أَعتَقَ المالَ وَلا العَرضَ مَلَك",2,"ك",1,0],["بِأَخلاقِ أَبّاءٍ يَعودُ بِها الأَذى","وَعوراً عَلى الأَعداءِ وَهيَ دَمائِثُ",3,"ث",1,0],["بِأَخْذٍ عَنْ ثِقَاتِ الرَّأْيِ فِيهَا","هَدَاكِ إلى رَوَابِطِهَا الوَثِيقَهْ",4,"ق",2,0],["باخل لا يرقّ من","دمع عيني لسائل",5,"ل",1,0],["باخلٌ بالكلامِ لكن له سيَّا","ف لحظٍ تكلَّم الناس عنه طفلا",6,"ل",2,0],["باخلٌ حين يبذل القومُ رِفْداً","ماطلٌ حين يُنْجز القومُ وَعْدا",7,"د",2,0],["بأخي بل بوالدي بل بنفسي","ليتَ نفسي من قبله مثكولهْ",8,"ل",2,0],["بأخضر جادَهُ طلٌّ ووبْلٌ","وما جرمته بينهما الرِّهامُ",9,"م",1,0],["بأخ شقيقٍ بعد أُمٍّ برةٍ","بالأمس قطَّع منهما أقرانَهُ",10,"ن",2,0],["بأخيهِ شدَّ اللّهُ أزرَ جلالهِ","ووزيرُه من أهلِه هارونُ",11,"ن",1,0],["باخَ سَنا نارِ وُدِّهِ فَخَبا","وَكانَ حيناً لِنارِهِ لَهَبُ",12,"ب",1,0],["بِأَخلاقِ أَيدي المُطعِمينَ إِذا الصَبا","تَصَبَّبَ قُرّاً غَيرَ ماءٍ صَبيبُها",13,"ب",3,0],["بِأَخيَلَ مِنهُم إِذا زَيَّنوا","بِمَغرَتِهِم حاجِبَي مُؤجَدِ",14,"د",1,0],["بِأَخضَرَ مِن نَعمانَ ثُمَّ جَلَت بِهِ","عِذابَ الثَنايا طَيِّباً حينَ يُرشَفُ",15,"ف",1,0],["بأخضر تبدو منه للعين لجةٌ","تَلاقَتْ دَبورٌ فوقَها وقَبولُ",16,"ل",1,0],["بِأَخفَقَ أَحشاءً وَأَنبا حَشِيَّةً","وَأَضرَمَ أَنفاساً وَأَندى مَآقِيا",17,"ي",2,0],["بأخضَرَ مثلِ البحرِ ليس اخضرارُه","من الماء لكنْ من حديدٍ مُسَرَّدِ",18,"د",1,0],["بِأَخضَرَ كالقَهقَرِّ يَنفُضُ رَأسَهُ","أَمام رِعالِ الخَيلِ وَهي تُقَرِّبُ",19,"ب",1,0],["باخوس فيها وهو صاحبُها","لم يخْلُ حين أفاق من عَجبِ",20,"ب",1,0],["باخوسُ يروي عن غرائبهمْ","شتى أحاديثٍ وأنباءِ",20,"ا",2,0],["بإخْوَتِهِ الّذينَ هُمُ أُسودٌ","على آثارِ مَقْدَمِه عِجال",21,"ل",1,0],["بَاخُومُ لِلْرُهْبَانِ مِنْ قِدَمٍ بَنَى","دَيْراً فَكَانَ بِمَا بَنَاهُ الأَوَّلاَ",22,"ل",2,1],["بأخى هوى متماسك فى أضلعى","سمح على شيع الجمال مفرق",23,"ق",1,0],["بأخلاق كعهديها رقاق","يضيق بها الزمان ولا تضيق",24,"ق",1,0],["بِأَخفانفِ إِبلٍ أَو سَنابِكِ جَبهَةٍ","بِجاهِ المُعَلّى فَوقَ نَسرٍ وَجَبهَةٍ",25,"ه",1,0],["بِآخرِ شهرِ الصومِ من عام سبعةٍ","وَعشرينَ قد أَبدى المنارُ له ذِكرا",26,"ر",2,0],["باخائضا غمرات الشوق متخذا","حسن التوكل زادا وَالرضا سفنا",27,"ن",2,0],["بأخضر يعلو أحمرا فوق أبيض","فقلت لهم هذا الحديث المدبج",28,"ج",1,0],["باخلاص في ذي الدنيه","وكل خصله عليه",29,"ه",1,0],["باخلاص مع صدق نيه","في كل خصله عليه",29,"ه",1,0],["بأخي وتفضُله لقد جمعتْ","زِنةَ الوقارِ وخِفّةَ الحمْلِ",30,"ل",1,0],["باخلُ الخاطِرِ والكفِّ معاً","يحسبُ البذل عن العِرض غَبنْ",31,"ن",1,0],["بأخي الفصاحة ناطقاً بأبي المعالي","ساعياً بمجيدها ابن مجيدها",32,"د",3,0],["بإِخلاصِ أَلبابٍ بنورِكَ أَشرَقَتْ","جَلَوْتَ عليها من طِرازِ الهُدى رَقْمَا",33,"م",2,0],["بِإخْلاصِهمْ رَبِّي بِلُطفِ أنينِهم","بِرَشِّ دُموعٍ دونَها رَشَّةُ القَطْرِ",34,"ر",1,0],["بِأَخزَمَ أَو بِالمُنحَنى مِن سوَيقَةٍ","أَلا رُبَّما أَهدى لَكَ الشَوقَ أَخزَمُ",35,"م",1,0],["بأخي المخلوع طلت يداً","لم يكن في باعها طول",36,"ل",1,0],["بأخلاقكم لا بما تكتبو","ن حسب الأجانب أن يحتموا",37,"م",3,0],["باخيك او بك اشرقت سبل","العلا وتبسمت بالبارق المتألق",38,"ق",1,0],["باخضرارٍ ملمَّعٍ باصفرارٍ","واحمرار ملمَّعٍ بابيضاض",39,"ض",1,0],["باخطّف بالبعايد","عن قربتك واحذاك",40,"ك",1,0],["بأخيه طود المجد باقرها الذي","جمع المكارم في الطراز الأول",41,"ل",1,0],["بأخَّاذٍ لِمَا يُرْجَى ألُوفٍ","وعَيَّافٍ لِمَا يُخْشَى تَرُوكِ",42,"ك",1,0],["بِأَخي ثَمودَ وَقُربِ ما أَخطَأنَهُ","وَلَقَد بَلَغنَ العُذرَ في الإِدلاجِ",43,"ج",1,0],["بإخلاصه للّه دَعوة مضطر","ويا عجباً من تارك حق ربة",44,"ه",1,0],["بإخلاصهم لا الهجو يوما يسوءهم","ولا سرهم مدح الذي راح يحمد",45,"د",1,0],["باخل سلَّمه الل","ه علينا بالسلام",46,"م",1,0],["بَاخِلٌ بِالْوِصَالِ وَهْوَ كَرِيمٌ","ضَيِّقُ الجفنِ وَاسع الأخلاَقِ",47,"ق",1,0],["بأخضَر مطرور الوقيعةِ سَنَّهُ","وحَشَّرَهُ بالأَمسِ فهو زليمُ",48,"م",1,0],["بآخاطبَه ولسانِي اخرَس","حَيران مِنْ شوفَه ومَغمور",49,"ر",1,0],["باخِلٌ بالذى أردتُ وقد جُد","تُ برُوحى فى حُبِّهِ وبمالى",50,"ل",2,0],["بأخلاقٍ علت قدراً","تعالى الله باريها",51,"ي",3,0],["باخلةٌ قد كِدْتُ مِنْ بخلها","وعِشْقِها أَكْلَفُ بالبُخْل",52,"ل",1,0],["بأخلاقٍ يضوع المسك منها","وعلياء تفوق على الرعان",53,"ن",1,0],["بأخلاقك وأوصافك ولينك","ملكتْ القَلْب يَا حِلْو الوصايف",54,"ف",1,0],["بِأَخدانِهِ تُدرى خَفيّات أَمره","أَلَم تَرَ أَن الشبهَ للشبهِ جاذِبُ",55,"ب",1,0],["بأَخمُصِهِ قَد داسَ لِلحُجبِ سَيِّدِى","وَمَقعَدُهُ يَعلُو علَى كُلِّ مَقعَدِ",56,"د",1,0],["بإخوان الخواص فكون داخل","وسل بخواص خوصى للعنايا",57,"ا",3,0],["باخسنّك في الهوى بخسا","وانت لي ما ينجهل باسه",58,"س",2,0],["بإخباره عن نفسِه لا بعقلنا","فيعلنُ ما عقلي به يتكتَّمُ",59,"م",1,0],["بأخفافها يدنو الفتى من حبيبه","وتُبعدهُ إن أذهلته الشدائدُ",60,"د",1,1],["بأخٍ يَحُلُّ من الفؤادِ بموضِعِ ال","بيضِ الصوارمِ من فؤادِ الأميَلِ",61,"ل",1,0],["بأخوالي وأعمامي أقامت","قريش ملكها وبنا تهابُ",62,"ب",1,0],["بأخر مبعوث إلى الخلق رحمة","بأخذك ميثاق النبيين أولا",63,"ل",2,0],["بأخذ مالٍ بلا حَقٍّ وأعظمُه","ختمُ البيوتِ بضيقٍ يوجبُ الضجرا",64,"ر",2,0],["باخِلٌ بالخَيالِ لَم يَرجُ مِنهُ","مُستَهامٌ يَستَرفِد الوَصلَ نَيلا",65,