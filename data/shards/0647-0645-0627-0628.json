{"poems":[[55,"دع الذميل إلى الغايات والرتكا","https://www.aldiwan.net/poem29920.html","البسيط"],[36,"فيا قلب صبرا واعترافا لما ترى","https://www.aldiwan.net/poem4903.html","الطويل"],[0,"ألا إِن قوماً كنتم أمس دونهم","https://www.aldiwan.net/poem56.html","الطويل"],[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[53,"ثلاثة أشياء ففي اثنين منهما","https://www.aldiwan.net/poem66372.html","البسيط"],[47,"تطلبت من أدعو لرد ظلامتي","https://www.aldiwan.net/poem63576.html","الطويل"],[89,"حي مغنى الهوى بوادي الشآم","https://www.aldiwan.net/poem8286.html","الخفيف"],[107,"أعدوا لأعلام البيان المنابرا","https://www.aldiwan.net/poem42086.html","الطويل"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[77,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[48,"أيأتي نبي يجعل الخمر طلقة","https://www.aldiwan.net/poem23498.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42707","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43824","المديد"],[107,"أعدوا لأعلام البيان المنابرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55073&r=&rc=243",""],[113,"من أي مولى ارتجي","https://www.aldiwan.net/poem16183.html","مجزوء الرمل"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[280,"أسلم للمقدور ثم أسلم","https://www.aldiwan.net/poem25531.html","الطويل"],[303,"تلاقوا بعد ما افترقوا طويلا","https://www.aldiwan.net/poem36818.html","عموديه"],[415,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[463,"على أي أخلاقِ الزمان أعاتبه","https://www.aldiwan.net/poem56287.html","الطويل"],[541,"أتذكر داراً بين دمخ ومنورا","https://www.aldiwan.net/poem23850.html","الطويل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122329","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63971","الرجز"],[181,"","https://poetry.dctabudhabi.ae/diwan/poem/81912","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59424","الطويل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72326","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49963","المتقارب"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106874","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93603","السريع"],[2530,"","https://poetry.dctabudhabi.ae/diwan/poem/96599","الوافر"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74203","الطويل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26113","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111520","الطويل"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107278","الوافر"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97100","المتقارب"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117177","الوافر"],[4526,"","https://poetry.dctabudhabi.ae/diwan/poem/75839","الطويل"],[4545,"","https://poetry.dctabudhabi.ae/diwan/poem/216346",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139522",""],[4935,"هنئو هذا الكريم الراقيا","https://www.poetsgate.com/ViewPoem.aspx?id=129513",""],[5145,"أما والزرق تخطر وهي سمر","https://www.poetsgate.com/ViewPoem.aspx?id=108061",""],[5186,"لا تعد بي إلى ربوع الخيام","https://www.poetsgate.com/ViewPoem.aspx?id=156442",""],[5320,"العامل","https://www.poetsgate.com/ViewPoem.aspx?id=40903",""],[5952,"وجْهُ فَلا","https://www.poetsgate.com/ViewPoem.aspx?id=214017",""],[6097,"نُورُ الأُخُوَّةِ","https://www.poetsgate.com/ViewPoem.aspx?id=190690",""],[6202,"أي يوم يكون للشعراء ..؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86712&r=&rc=13",""]],"verses":[["هُم أَبدَعوا المَجدَ لا أَن كانَ أَوَّلُهُم","رَأى مِنَ الجِدِّ فِعلاً قَبلَهُ فَحَكى",0,"ك",2,0],["هُما بَرَّحا بي مُعوِلينَ كِلاهُما","فُؤادٌ وَعَينٌ مَأقُها الدَهرَ دامِعُ",1,"ع",1,0],["هُمُ أَبلَغوا الحَيَّ المُضَلَّلَ أَهلَهُم","وَساروا بِهِم بَينَ العِراقِ وَنَجرانِ",2,"ن",1,0],["هُمُ أبنَاءُ عِمرَانَ بنِ عَمرو","مُضِيعِي نِسبَة أَو حَافِظِينَا",3,"ن",2,0],["هُمُ أبناءُ آدَمَ لَم أَجدهُم","إِلى نَسَبٍ سِوَاهُ مُجمعينَا",3,"ن",2,0],["هُما بَردُ يأسٍ أو حلاوةُ نائلٍ","وما أقبح الميعادَ عندي وألأما",4,"م",2,0],["هُما بانِيا أُكرومَةً يُعلِيانِها","إِذا اِمتَثَلا فيها فَعالَ أَبي الصَقرِ",5,"ر",1,0],["هُمْ أَبَاحُوا الْهَوَى حَرِيمَ فُؤَادِي","وَأَذَلُّوا لِلْعَاذِلِينَ خِطَامِي",6,"م",2,0],["همُ ابتعثوا مجدَ العُروبةِ هامداً","وهُمْ جَدَدَّوهُ دارسَ الرسمِ دائرا",7,"ر",2,0],["همُ ابتدروا العَرِينَ فأنقذوهُ","وهم كانوا الحُماةَ المانعينا",8,"ن",2,0],["هُمْ أباحوا كلَّ ممنوعِ الحِمَى","وأذلُّوا كلَّ جَبّارِ العِناد",9,"د",1,0],["هُما بَدَوَِيّانِ الطَريقَ تَعَرَّضا","وَبُردَيَّ مِن نَسجِ الشَبيبَةِ بَزّاني",10,"ن",2,0],["هَمَّا بِبَعْضِهِمَا فَمَاتَا مِيتَةً","لَهُمَا بِهَا حَتَّى الْمَعَادِ وِفَاقُ",11,"ق",1,0],["هَمَّ إِبلالاً فَلَجَّ دَمٌ","مِنهُ لا يَألو الثَرى بَلَلا",12,"ل",2,0],["هم ابتعثوا مجد العروبة هامدا","وهم جددوه دارس الرسم داثرا",13,"ر",2,0],["هُم أَبحر الفَضل الَّذي","نَ بِغَيرِهُم لَم تُفرجِ",14,"ج",1,0],["هَمّا بِكيدٍ عادَ مِنهُ عَلَيهِما","ما لَم يَكونا مِنهُ يَنتَظِرانِ",15,"ن",1,0],["هُمُ أبَداً هَمِّي فَلَيْلِي ألْيلٌ","بِمعْجزَتِي عَنْهُمْ ويَوْمِيَ أيْوَمُ",16,"م",1,0],["هُمُ أبلوا مهادنة وَعنفاً","فكانوا فيها أَهدى سبيلا",17,"ل",2,0],["هُم أباحوا الضَّنى جِسْمي وكانَ حِمى","وأمْطروا مُقْلَتِي بعدَ الدُّموعِ دَمَا",18,"م",2,0],["هما بيضتا كِنٍّ بجانبِ مُلبَسٍ","حماه الطروقَ تيهُهُ وسَباسِبُهْ",19,"ب",2,0],["هُمُ اِبتَدَروا في يَومِ بَدرٍ عَدُوَّهُم","بِكُلِّ اِمرِىءٌ في الرَوعِ لَيسَ بِأَوجَرا",20,"ر",2,0],["هم ابصروا من غرسك الغصن مثمرا","وما كان من غرس لهم صار فاويا",21,"ي",2,0],["هم إِبطُ الرَّوع إذا","كلَّت عن الرَّوع الإِبط",22,"ط",1,0],["هُما بَكْرَتانِ عائطانِ اشتراهما","مِنَ السُّوقِ عَبْدا نِسْوةٍ غَزِلانِ",23,"ن",1,0],["هم أبصروا نور الهدى فهدوا إلى","اشعته إذ أصبح الكون مظلما",24,"م",2,0],["هما بخصر كان لولا لينه","ينقذ تحت معاقد الهميان",25,"ن",1,0],["هما باشتراك بلوعة شاكٍ","ودمعة باكٍ طويل السِّهادِ",26,"د",1,0],["هم أبصروا للجهل جاهاً ورونقاً","وهم رفعوه بينهم فترفعا",27,"ع",2,0],["هم أبذل الناس إِذا ما دَعوا","نَفساً وَلَكن أَمنَع الناس جار",28,"ر",1,0],["همُ آباؤنا وهُم بَنونا","لنا جُبلوا كما لهم جُبلنا",29,"ن",2,0],["هُما بَطلا حَرب وَلَيثا بَسالة","وَغَيثا نَدى جود إِذا بخل القطر",30,"ر",1,0],["هُما بَحر علم إِن وَردت مِياهه","رويت وَفي كَفيك مِن فَضله در",30,"ر",1,0],["هم آباؤُهُم مَنَعوكَ قِدما","وَفَكَوّا مِن عَشيرَتِكِ الرِقابا",31,"ب",2,0],["هما بأن يوردا للنهر خيلهما","مع البغال فهب الفيج منزعجا",32,"ج",2,0],["هُما بَحرانِ بَينَهُما اشتِبَاهٌ","ولكِن ليسَ في كُلِّ الخِلالِ",33,"ل",1,0],["هم ابتدعوا غصب ميراثكم","وقام بهم ليزيد اللوا",34,"و",2,0],["همُ أبناءُ آخرَةٍ ودُنيا","وأهدافُ المراثي والمديح",35,"ح",1,0],["هُما بَطلانِ يَعثُرانِ كِلاهُما","يُريدُ رياسَ السَيفِ وَالسَيفُ نادِرُ",36,"ر",1,0],["هم ابعدوني واحرموني صِديجي","مِحيِي وِطَنْيَه بو نْهودٍ لِهَايج",37,"ج",1,0],["هم اباةٌ ورثوا كل علاً","وثناءٍ عن أب بعد أب",38,"ب",1,0],["هم اباظيون في مصر ابتنو","بيت عز دام فيهم ساميا",39,"ي",2,0],["هم آباؤه والمرء يدعى","بقدوته وهل في ذاك نكر",40,"ر",1,0],["هم أباحوا ولوج باب اجتهاد","هو نبراس دين خير الأنام",41,"م",1,0],["هما بعد من عطاء يفوق الخيال","ومازال يعطى ويأبى الملل",42,"ل",1,0],["هم أبصروا الوجهَ ليس مضطرباً","وما كها العيشُ إن صَفا وحَلا",43,"ل",2,0],["هُم أبعدُوه صَغيرًا عنْ أحِبَّتِهِ","أعْمَوا أبَاه وَحَاكُوا فِرْيَةَ النَّهْبِ",44,"ب",1,0],["هم أباة وعاهدوا من قديم","أن يكونوا الأباة يوم فداء",45,"ا",2,0]]}