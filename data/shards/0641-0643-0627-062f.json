{"poems":[[65,"كيف السلو وقلبي ليس ينساك","https://www.aldiwan.net/poem45732.html","البسيط"],[65,"أهاجك شوق بعدما هجع الركب","https://www.aldiwan.net/poem46205.html","الطويل"],[36,"نباكر أم تروح غدا رواحا","https://www.aldiwan.net/poem4878.html","الوافر"],[79,"عهد الشباب سقى أيامك الأولا","https://www.aldiwan.net/poem35728.html","البسيط"],[88,"مضيت ونحن أحوج ما نكون","https://www.aldiwan.net/poem10370.html","الوافر"],[53,"إذا أحدقوا بي في المكر حجزتهم","https://www.aldiwan.net/poem65735.html","الطويل"],[46,"أعتبة أجبن الثقلين عتبا","https://www.aldiwan.net/poem30071.html","الوافر"],[46,"أصغى إلى البين مغترا فلا جرما","https://www.aldiwan.net/poem30366.html","البسيط"],[76,"ألا زاحم الليل بي أشقر","https://www.aldiwan.net/poem12859.html","المتقارب"],[76,"وأهيف قام يسقي","https://www.aldiwan.net/poem12901.html","المجتث"],[42,"أقول غداة استقل الجمي","https://www.aldiwan.net/poem42301.html","المتقارب"],[54,"ءأمير المؤمنين فدتك نفسي","https://www.aldiwan.net/poem27014.html","الوافر"],[50,"ومائل الرأس نشوان شدوت له","https://www.aldiwan.net/poem62508.html","البسيط"],[50,"ونابه في الهوى لنا ناس","https://www.aldiwan.net/poem64318.html","المنسرح"],[50,"كأن ما بي في المجانين","https://www.aldiwan.net/poem66565.html","الوافر"],[48,"معان من أحبتنا معان","https://www.aldiwan.net/poem23635.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85422","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55073","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[36,"تُبَاكِرُ أمْ تَرُوحُ","https://www.poetsgate.com/ViewPoem.aspx?id=14396",""],[53,"إذا أحدقوا بي في المَكرِّ حجزتهم","https://www.poetsgate.com/ViewPoem.aspx?id=30009",""],[121,"قيثار2","https://www.aldiwan.net/poem24074.html","البسيط"],[164,"أزلت عن الإسلام ما أوجب الشكوى","https://www.aldiwan.net/poem59202.html","الطويل"],[190,"أقمت بجنبلا عشرين يوما","https://www.aldiwan.net/poem43643.html","الوافر"],[240,"تهن بها أشرف الأرض دارا","https://www.aldiwan.net/poem32007.html","المتقارب"],[275,"تذكرت ليلا في الخميلة مقمرا","https://www.aldiwan.net/poem35439.html","الطويل"],[275,"من غصن قلبك زهر الحب ينتثر","https://www.aldiwan.net/poem35472.html","البسيط"],[303,"عذيري من حليف ذي خصال","https://www.aldiwan.net/poem36815.html","عموديه"],[310,"ربيع من جبينك قد أطلا","https://www.aldiwan.net/poem56437.html","الطويل"],[310,"أفاطم لو شهدت ببطن","https://www.aldiwan.net/poem56516.html","الوافر"],[385,"لك الحمد يا من حصل","https://www.aldiwan.net/poem48754.html","مجزوء المتقارب"],[422,"حثثت على عنيف السير نوقي","https://www.aldiwan.net/poem54111.html","الوافر"],[463,"نديمي وما الناس إلا السكارى","https://www.aldiwan.net/poem56204.html","المتقارب"],[473,"رأت ذهب الخدين مني لبينها","https://www.aldiwan.net/poem59905.html","الطويل"],[482,"نوق براهن السرى","https://www.aldiwan.net/poem15219.html","مجزوء الرجز"],[519,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[580,"هلال ولكن السعود منازله","https://www.aldiwan.net/poem3023.html","الطويل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110373","الوافر"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96982","المتقارب"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137742",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48534","الوافر"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104626","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38242","البسيط"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96294","المتقارب"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101985","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64835","البسيط"],[1315,"","https://poetry.dctabudhabi.ae/diwan/poem/140224",""],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77814","المجتث"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108954","الوافر"],[2188,"","https://poetry.dctabudhabi.ae/diwan/poem/20908","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109431","البسيط"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104981","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100422","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100415","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201004","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202736","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202713","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203020","الطويل"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3353,"","https://poetry.dctabudhabi.ae/diwan/poem/80087","المتقارب"],[3469,"","https://poetry.dctabudhabi.ae/diwan/poem/13","الوافر"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45805","البسيط"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118748","المتقارب"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101348","الطويل"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/107042","المتقارب"],[4325,"","https://poetry.dctabudhabi.ae/diwan/poem/29462","المتقارب"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58034","البسيط"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35105","الوافر"],[4785,"حضن الأم","https://www.poetsgate.com/ViewPoem.aspx?id=129745",""],[4831,"غربة وفراق","https://www.poetsgate.com/ViewPoem.aspx?id=208036",""],[5135,"ستطلع أيها القمر","https://www.poetsgate.com/ViewPoem.aspx?id=201965",""],[5870,"سَطلُ الغَبَاء","https://www.poetsgate.com/ViewPoem.aspx?id=60864",""],[5997,"عيوني","https://www.poetsgate.com/ViewPoem.aspx?id=214289",""],[6344,"ملامح من فوضى الصَّدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87966&r=&rc=6",""]],"verses":[["فَكادَ الرُّعبُ يَطوينا وَيَنشُرُنا","يُحَدِّثُ الحَيَّ عَن مَسراكِ رَيّاكِ",0,"ك",1,0],["فكادَ بِتَرْجيعِ الحَنينِ يُجيبُني","حُسامي ورَحْلي والمَطِيَّةُ والصَّحْبُ",1,"ب",1,0],["فَكادَ يُذيقَهُ جُرَعَ المَنايا","وَلَو سَقّاهُ ذالِكَ لَاِستَراحا",2,"ح",2,0],["فكادَتِ الشّاءُ ترْعَى والذّيابُ مَعا","وكادَتِ الناسُ فيها تأمَنُ الأجَلا",3,"ل",2,0],["فَكادَ مُصابُها يَأتي عَلَيها","لِساعَتِها وَتَقتُلُها الشُجونُ",4,"ن",1,0],["فكادهم رب السما بمؤيَّدٍ","من الكيد أخّاذ بسمع ومنطق",5,"ق",1,0],["فَكادَ بِأَن يُرى لِلشَرقِ شَرقاً","وَكادَ بِأَن يَرى لِلغَربِ غَربا",6,"ب",2,0],["فَكادَ شَوقِيَ يَتلو الدَمعَ مُنسَجِماً","لَو كانَ في الأَرضِ شَوقٌ فاضَ فَاِنسَجَما",7,"م",2,0],["فَكادَ وَقَد طارَ بي شُعلَةً","عَلى فَحمَةِ اللَيلِ أَن تَلهَبا",8,"ب",2,0],["فَكادَ يَشرَبُ نَفسي","وَكُدتُ أَشرَبُ خَدَّه",9,"د",2,0],["فَكادَ لِمَوعِظَتي يَرعوى","عَنِ الجَهلِ وَالمُرعِوي المُفلِحُ",10,"ح",1,0],["فَكادَ يَطيرُ لِلإِشفاقِ قَلبي","فَضَمَّ جَناحَهُ قَلبي وَقَرّا",11,"ر",2,0],["فَكادَ أَو لَم يَكَد أَن يَستَفيقَ لَهُ","وَالنَفسُ في بَحرِ سُكرٍ عَبَّ طَفّاحِ",12,"ح",1,0],["فَكادَتِ النَفسُ لِلسُرورِ بِها","تَخرُجُ بَينَ المُدامِ وَالكاسِ",13,"س",1,0],["فكادت النفسُ لدى خُطّهِ","تخرجُ بين الواوِ والنونِ",14,"ن",1,0],["فكاد الفَجْرُ تَشْرَبُه المَطَايا","وتُمْلأ منه أسْقِيهٌ شِنانُ",15,"ن",1,0],["فَكادَ من دويِّها","ينشق طبل مَسمعي",16,"ع",2,0],["فَكَادَ النَّقْلُ يَحْكِي الأَصْلَ","حَتَّى لاَ أَرَى فَرْقَا",17,"ق",2,0],["فَكَادَ لاَ يَدْرِي مُحِبُّوكُم","أَيُّ السُّرُورَيْنِ هُوَ الأَوْفَرُ",18,"ر",1,0],["فَكَاَد يُذِيقُهُ جُرَعَ المَنَايَا","وَلَوْ سَقّاهُ ذلِكَ لاسْتَرَاحَا",19,"ح",2,0],["فكادُهُم رب السماء بمؤيدٍ","من الكيد أخاذٍ بسمع ومنطق",20,"ق",1,0],["فكاد لِلحُسْنِ، لولا اللهُ يَعْبُدُها","بُوذا، وقد يَعْبُدُ الإنسانَ إنسانُ",21,"ن",1,0],["فكادت تميل الناس معهم على الهدى","وتأخذه عُضواً بأسيافهم عُضوا",22,"و",2,0],["فكادحت الزمان أسى وضرّا","مضع الحظّ ذا أدب مضاع",23,"ع",1,0],["فَكادَت وَقَد رَمَقَتها السَماءُ","تُلقي النُجومَ عَليها نِثارا",24,"ر",2,0],["فكادت تذيبُ القلبَ ذكرى مليحةٍ","على جيدِها دَمعي الثمينُ تحدَّرا",25,"ر",2,0],["فكاد حبُّكِ يُبكيني وأرّقني","شوقي إليكِ فلذَّ الدمعُ والسهر",26,"ر",1,0],["فكاد يكون من مكرٍ وكيدٍ","ودسٍ عصر فوضى واختلال",27,"ل",1,0],["فَكادَ البحرُ يهدي ما حواهُ","لو اِنّ البحرَ يدري ما أقلّا",28,"ل",2,0],["فَكادَ يُريبهُ فَيخالُ منّي","مُحاذرةً فَقلت عقرتَ مهرا",29,"ر",2,0],["فَكادَ يَموت الحَما","م مِن بَأسِهِ لِلوَجل",30,"ل",1,0],["فكاد الشوق يحملني إليه","فيستشفي مشوقٌ من مشوق",31,"ق",1,0],["فكادت تُواريه ضنّاً به","ومن حسنها أنّه لا يُوارَى",32,"ر",2,0],["فَكادَت أَسىً روحي تَقَطَّعُ إِذا بَدا","عَلى خَدِّها سَلكُ الدُموعِ مُقَطَّعا",33,"ع",2,0],["فكادَ أن يُسكرَني","نسيمُها لمّا سَرى",34,"ر",2,0],["فكادَتْ لِما بي أن تُذيبَ سِوارَها","ضُلوعي وإن كانت حَشاهُ من الصّخْرِ",35,"ر",1,0],["فكاد يُرى وسْط النديِّ سريرُه","وكاد يُرى في سُدَّةِ البابِ سَائِلُهُ",36,"ل",2,0],["فكادت ترقصُ الاكبادُ تيهاً","بما نالتهُ أو كادت تطيرُ",37,"ر",1,0],["فكاد يحول مولودكم","عن المهد فوق ظهور النجب",38,"ب",1,0],["فكادت قلوب النعاج تذوب","وغار من الخوف عزم الحمل",39,"ل",1,0],["فكاد الأفق ينطبق انطباقاً","وكدت أرى الكواكب هاويات",40,"ت",1,0],["فكادت تطيرُ النفَّسُ مِن فرطِ شَوقِها","الى عالمٍ فيه النُّفوسُ سوابحُ",41,"ح",1,0],["فَكادَ ذيبٌ وَشاةٌ يرعَيانِ مَعاً","مِنَ الأمانِ بِلا جَورٍ ولا وجَلِ",42,"ل",1,0],["فكادَ بحَسرَة ما فاتَهُ","يُجَنُّ من الوجد أو يُكلَبُ",43,"ب",1,0],["فكاد يواريه الحيا عن وجوههم","فآونة يخفى وآونة يبدو",44,"د",2,0],["فكادَ يَقْضٍ على الإِسلامِ جاهلُهُمْ","ما ليسَ يطمعُ في إِبطالِهِ قاضِ",45,"ض",1,0],["فكاد فؤادي أن يطير صبابة","إلى زنجبار حبذا الجار والدار",46,"ر",1,0],["فَكادَ سر الأَسير","الواله المستطير",47,"ر",1,0],["فكاد يصدها عني اقتراحي","ويحرمني الورودَ على لماها",48,"ا",3,0],["فَكادَت تُبينُ الوَحيَ لَمّا سَأَلتُها","فَتُخبِرُنا لَو كانَتِ الدارُ تَنطِقُ",49,"ق",1,0],["فكاد فيه يطير القلب من أسفٍ","ويستقر عليه طائر الفتن",50,"ن",1,0],["فكاد يشبهني الصديان عنَّ له","وِردٌ فمدَّ إليه الكف مغترفا",51,"ف",2,0],["فكادت النفس تقضي في الضلال هوى","لولا عليٌّ امام الحق هاديها",52,"ي",3,0],["فكاد السير يمشقها حروفا","مرتلة ونقرأها لحونا",53,"ن",2,0],["فكاد يغيض الشعر تحت زخارف","ويخفى الجمال المحض تحت التجمّل",54,"ل",1,0],["فكاد يضيع شعري فيه لما","رأى بقديمه شيئاً جديدا",55,"د",2,0],["فكاد للطف جسمٍ منه يأتي","إليّ شعاعها ويثير حِسّي",56,"س",2,0],["فكادت هناك الكأس تسقط من يدي","وكادت يدي من جانب الكأس تسقط",57,"ط",1,0],["فكاد أن يقضى المليك عجبا","ويخجل البائس منه وبكى",58,"ك",2,0],["فكادَ يقرُّ بأمرِ الرسولِ","فَمالَ إلى البَدَلِ الأعْورِ",59,"ر",1,0],["فَكادَت مِن مَعارِفِها دُموعي","تَهُمُّ الشَأنَ ثُمَّ ذَكَرتُ حَيّا",60,"ي",2,0],["فَكادَ يَغرَق مِن أَبقَت صَوارمه","لَولا السَوابح بَحرٌ مِن دمائَهُم",61,"م",1,0],["فكاد لفرط سقامٍ به","إذا لم يئنّ بأن لا يُرى",62,"ر",2,0],["فكادت مع الألفاظ تلفظ نفسها","وتخرج من بين الكلى والحواصل",63,"ل",1,0],["فكادت تضيء وجوه الطروس","ويحسد عقد الجمان السطورا",64,"ر",2,0],["فَكَادَت فَزَارَةُ تَصلَى بِنَا","فَأَولى فَزَارةُ أَولَى فَزَارَا",65,"ر",2,0],["فكادت عمانُ يدُ الأعداءِ تأسرُها","لولا عزائِمهُ ما عفوُ مقتدرِ",66,"ر",1,0],["فَكادَ يَصُدُّنا عَن مُجتَلاهُ","رَقِيبٌ مِن مَهابَتِكُم غَيورُ",67,"ر",1,0],["فكاد إلى اللظى يُلقى جزاءً","لما من سيء الأعمال قدم",68,"م",1,0],["فَكادَتْ دُمُوعي تَهِلُّ لوجدٍ","وتَهْمي سَخاءً كعَيْن الوَليدِ",69,"د",1,0],["فكاد الْقلْبُ ينْشطرُ","وكانَ الْموْقِفُ الْخَطِرُ",70,"ر",1,0],["فَكَادَ « كُزلُكُهُ » مِن خَجلَةٍ يَثِبُ","لَولا يَدُ « البَرهُو» تُمسِكُهُ انهَزَمَا",71,"م",2,0],["فكادوا للهوى حيث افترقنا","وجادوا بالأسى لحظة دعوني",72,"ن",2,0],["فَكَادَ مِنْ فَرْطِ مَا يُخْفِيهِ .. يُظْهِرُهُ","هَجْسٌ .. عَلَى صَدْرِهِ مِنْ كَبْتِهِ جَثَمَا",73,"م",2,0]]}