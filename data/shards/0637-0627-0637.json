{"poems":[[55,"لو صح أن البين يعشقه","https://www.aldiwan.net/poem29955.html","السريع"],[55,"يا دار ما طربت إليك النوق","https://www.aldiwan.net/poem29956.html","الكامل"],[88,"لا رعى الله عهدها من جدود","https://www.aldiwan.net/poem10688.html","الخفيف"],[99,"فيم الغدو غداً وأين رواحي","https://www.aldiwan.net/poem24401.html","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43843","البسيط"],[124,"ودعته والليل يخفرنا","https://www.aldiwan.net/poem49364.html","أحذ الكامل"],[558,"قل لابن مي لا تكن جازعا","https://www.aldiwan.net/poem68374.html","السريع"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83274","الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25313","الرجز"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130620","الرمل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130629","المديد"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80009","البسيط"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136897","الرمل"],[2798,"","https://poetry.dctabudhabi.ae/diwan/poem/144168","الكامل"],[3984,"","https://poetry.dctabudhabi.ae/diwan/poem/147201","الخفيف"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97073","الخفيف"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198224","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139520",""],[5010,"شابت عزائمكم","https://www.poetsgate.com/ViewPoem.aspx?id=189866",""],[5096,"ليلنا المسكوب في الدرب","https://www.poetsgate.com/ViewPoem.aspx?id=209128",""],[5376,"حتَّام يا عربي","https://www.poetsgate.com/ViewPoem.aspx?id=190351",""],[5408,"أبي...وعاد أخي","https://www.poetsgate.com/ViewPoem.aspx?id=190865",""],[5452,"منتظر الزايدي","https://www.poetsgate.com/ViewPoem.aspx?id=119180",""],[6070,"القاضي والذئب","https://www.poetsgate.com/ViewPoem.aspx?id=188079",""]],"verses":[["طَأطَأتُ لَحظَ العَينِ حينَ خَطا","وَالبَينُ يَرمُقُني وَيَرمُقُهُ",0,"ق",2,0],["طَأطَأتَ فَرعَ المَجدِ ثُمَّ جَنَيتَهُ","فَاِرتَدَّ وَهوَ عَلى عِداكَ سَحوقُ",1,"ق",1,0],["طَأطِئي لِلجَلالِ يا أُمَمَ الأَر","ضِ سُجوداً هَذا مَقامُ السُجودِ",2,"د",1,0],["طأطأتُ للبين المشتِّتِ هامتي","وخفضتُ للقدَرِ المغيرِ جناحي",3,"ح",2,0],["طَأطَأتُ لِلحادِثاتِ رَأسي","لَمّا اِستَوَت قامَتي شطاطا",4,"ط",2,0],["طأطأت لا أرنو لرونقه","فالحسن يطغى الصب رونقه",5,"ق",2,0],["طَأطَأَ مِن تيهِكَ فُقدانُهُ","وَكُنتَ فيهِ عالِيَ الصَوتِ",6,"ت",1,0],["طَأَطَأتُ رَأسَ قَريحَتي في بابِهِ","وَلَكُم رَأَت عَتَباتِهِ مِن ساجِد",7,"د",1,0],["طَأْطَأَ منْ شَيْطانِهِ المُعَتِّي","صَكِّي عَرَانِينَ العِدَا وَصَتِّي",8,"ت",2,0],["طأطأت نحو الثرى بالارؤس","وغدت ترنو بعيني اخرس",9,"س",1,0],["طأطأوا الروس لديه ولكن","رفع الرحمن تلك الرؤوسا",10,"س",2,0],["طأطأتِ من هاشمٍ للأرض هام علًى","ما طأطأتها ظبا الهنديَّة البترِ",11,"ر",1,0],["طأطأ الغرب لهم هامته","يكبر الإبداع للمبتدعين",12,"ن",1,0],["طأطأتَ فيه الكفرَ بعدَ بُذوخِه","ورفعتَ فيه دعائمَ الإيمانِ",13,"ن",1,0],["طأطِئِ القلبَ للرَدى والهوانِ","يا شفيع الحياة والعنفوان",14,"ن",1,1],["طأطِئ القلبَ يا وريث المآسي","ومغيثَ الرمادِ بالنيرانِ",14,"ن",1,0],["طأطئ القلبَ بين موتٍ وموتٍ","وتقلَّبْ على لظى الفُقدانِ",14,"ن",1,0],["طأطئ القلبَ والعروبة تنعى","شيخَها الشهم شمعة الديوانِ",14,"ن",1,0],["طأطئ القلبَ يا شموخَ القوافي","وتجمَّلْ بالصبرِ قَبْلَ البيانِ",14,"ن",1,0],["طأطأوا الرؤس إن رأس حسين","رفعوه فوق القنا الخطار",15,"ر",1,0],["طَأْطَأَ المَجْدُ رَأْسَهُ عِندَما عا","يَنَ ثَغْرَ السُّعودِ يَلْثِمُ فاكَا",16,"ك",2,0],["طأطأت عندها الملائك رأساً","ولوت دونها الملوكُ الرقابا",17,"ب",2,0],["طَأْطَأْتمُ هَامَاتِكُمْ فَغَدَوْتمُ","أُمَما مُمَزَّقَةً ، فَمَا أَغْرَاكُمُ؟!",18,"م",1,0],["طأْطأتْ نزْواتها عنْ مضضٍ","فاسْتجابتْ... هوسًا يَنْفِي الهوَسْ",19,"س",1,0],["طأطئْ برأْسِكَ لنْ تنالَ مَوَّدةً","فالغدْرُ فيهم كامنٌ وعجيبُ",20,"ب",1,0],["طأطأت رأسي إجلالاً وتكرمة","والذكريات شريط فيّ ينعقدُ",21,"د",1,0],["طأطئ لكفّ رمت وجه الظّلوم وقبّل","من رمى إنّما التقبيل إكبار",22,"ر",1,0],["طأطَأَ القاضي برأسٍ","إنَّكَ المكرُ الكبيرْ",23,"ر",1,0]]}