{"poems":[[4,"أقوى وعري واسط فبرام","https://www.aldiwan.net/poem21194.html","الكامل"],[23,"إن النضيرة ربة الخدر","https://www.aldiwan.net/poem21240.html","الكامل"],[87,"يا أيها الدمع الوفي بدار","https://www.aldiwan.net/poem62872.html","الكامل"],[51,"إني أكاثر أعدائي مغالطة","https://www.aldiwan.net/poem64315.html","البسيط"],[52,"أفد الرحيل وحثني صحبي","https://www.aldiwan.net/poem64845.html","الكامل"],[108,"قالوا أحيل","https://www.poetsgate.com/ViewPoem.aspx?id=179396",""],[108,"فيم احتفالكم ؟","https://www.poetsgate.com/ViewPoem.aspx?id=179398",""],[96,"وفاء القبور","https://www.poetsgate.com/ViewPoem.aspx?id=13790",""],[208,"أنى أكلت طريا","https://www.aldiwan.net/poem53159.html","المجتث"],[228,"حين أقبلت والهوى فيك يحبو","https://www.aldiwan.net/poem39723.html","الخفيف"],[542,"الحمد لله نجاني وخلصني","https://www.aldiwan.net/poem69414.html","البسيط"],[1378,"","https://poetry.dctabudhabi.ae/diwan/poem/216847",""],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77289","الكامل"],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108277","البسيط"],[4087,"","https://poetry.dctabudhabi.ae/diwan/poem/131659",""],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90797","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90995","الكامل"],[4258,"","https://poetry.dctabudhabi.ae/diwan/poem/18978","الكامل"],[4997,"الأحول","https://www.poetsgate.com/ViewPoem.aspx?id=108085",""],[5032,"نوح الثاني","https://www.poetsgate.com/ViewPoem.aspx?id=200672",""],[3591,"ما غادرت باريس بدراً يشرق","https://www.poetsgate.com/ViewPoem.aspx?id=149452",""],[5358,"نطق العراق","https://www.poetsgate.com/ViewPoem.aspx?id=194832",""],[5408,"ظلان أنت","https://www.poetsgate.com/ViewPoem.aspx?id=190583",""],[5674,"أنت وجه قصيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=189929",""],[5956,"لا تخاليني تاركا","https://www.poetsgate.com/ViewPoem.aspx?id=182147",""],[5956,"رقابة المطبوعات","https://www.poetsgate.com/ViewPoem.aspx?id=185617",""],[5956,"البِرُّ بالوالدَيْن","https://www.poetsgate.com/ViewPoem.aspx?id=192713",""],[5956,"إن كان لا يُعطيك شعري بعضُهم","https://www.poetsgate.com/ViewPoem.aspx?id=194702",""],[5956,"كل أب يخشى على ابنه خَشيةً مشروعة","https://www.poetsgate.com/ViewPoem.aspx?id=215770",""],[6032,"شهيد الحب","https://www.poetsgate.com/ViewPoem.aspx?id=181525",""],[6331,"الشكوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82021&r=&rc=2",""]],"verses":[["أَنّي أُكاثِرُ في النَدى إِخوانَهُ","وَأَعِفُّ عِرضي إِن أَلَمَّ لِمامُ",0,"م",1,0],["إِنّي أُكارِمُ مَن يُكارِمُني","وَعَلى المُكاشِحِ يَنتَحي ظُفري",1,"ر",2,0],["إِنّي أَكادُ أَرى مَحَلِّيَ بَينَكُم","هَذا قَرارُكُمُ وَذاكَ قَراري",2,"ر",2,0],["إِنّي أُكاثِرُ أَعدائي مُغالَطَةً","وَفي الحَشا لَهَبٌ مِن غَيظِمِم ضَرَمٌ",3,"م",1,1],["أَنّي أُكِبُّ إِذا ذَكَرتُكُمُ","مِن مَجلِسِ القُرّاءِ وَالشَربِ",4,"ب",1,0],["إني أُكَرِّمُ فيك بعضَ","الحِلْم والرأي السَّديد",5,"د",1,0],["إِن يأكل الناسُ الدجاجَ، فإِنه","أضحى له لَحْمُ الأنام طعاما",6,"م",2,0],["إنّي أكرّم شعري في متارفه","كما تكرّم عند المؤمن السور",7,"ر",1,1],["أنَّى أكلتَ طَرِيّاً","أردتَ دفع أذاهُ",8,"ا",2,1],["أَن يَأكُلَ البُؤسُ جِسمِك","وَتُبذَلَ النَفسُ وَالجَبين",9,"ن",1,0],["إني أكُرُّ على الأُولى إذا فَزِعوا","يوماً وأحبِسُ تحتَ الراية الفَرَسَا",10,"س",2,0],["إن ياك بالِك تَرْحِبَه","اصفَح عَنَه وِإلا اكمرَه",11,"ر",2,0],["إِنّي أُكَذِّبُ في هَواك مَدامِعي","وَأَرُدُّهُنَّ وَقَد شَهِدنَ عُدولا",12,"ل",2,0],["أني أكونُ من أهالي التبرِ","قد أوبقتني اليوم سيئاتي",13,"ي",1,0],["إني أكرّر ذكرَ البان في كلمي","لأن قد حيبي يشبه البانا",14,"ن",2,0],["إن يأكلك فانت واحد مننا","وان قلت حقى بقى طبعه يفور",15,"ر",1,0],["أني أكافئك امتداحا يا ابن من","بمديحه القرآن خير مكافي",16,"ف",2,0],["أني أكافئك امتداحا إنما","حسب المكافيء جهده وكفاه",17,"ا",2,0],["أَنّي أَكونُ لَهُ شَجىً بِمَناقِلِ","ثَبتِ الجِنانِ وَيَعتَلي بِالقَردَدِ",18,"د",1,0],["إنّي اكتنزتُ من الحياة حقائباً","لا بدَّ يوماً في الزّمان تُبجَّلُ",19,"ل",1,0],["إنِّي أُكَذِّبُ جُرْحي لا لأُنْكِرَهُ،","لكنْ لأنَّي إذا صَدَّقْتُهُ اتّسَعا",20,"ع",2,0],["إني أكرّر ذكرها فرقاً من ال","هجر الذي منه يخاف ويفرق",21,"ق",1,0],["إني أكادُ أموتُ من وجعي لكم","قد متُّ لولا أنْ أكونَ صبورا",22,"ر",2,0],["إني اكتهلْتُ وطيفُ الليلِ متّكئ","على ضلوعِ الشّذا واستُبْعِدَ الليْلُ",23,"ل",1,0],["إني أكابرُ والبعادُ يٓهزُّني","وأصونُ عهدي رغمٓ قُرْبِ وفاتي",24,"ت",2,0],["إني اكتسبتُ هواك بعد تلوّع","ومن الغباوة أن تراني فاركا",25,"ك",2,0],["إني اكتفيت فكم حرقتُ كتابتي","صادرتُ روحي صرتُ جسماً مُجْهَدا",26,"د",2,0],["إني أكابدُ حباً جارفاً لهما","مثلَ الضفافِ إلى الأمواجِ تنجرِفُ",27,"ف",1,0],["إني اكتفيتُ بفضل ربي، بعدَه","نجلي فراس دائماً لي هارقا..",28,"ق",2,0],["إني اكتشفتُ روابطَ القربى لنا","بالشعرِ أو بسواه.. دمتُ أباكا",29,"ك",2,0],["إنّي اكتويتُ من الأسى فترفُّقاً","بذبيح حبك أيها المعبودُ",30,"د",1,0],["إني اكتفيتُ من الدنيا فلا أسفٌ","على الحياةِ إذا تقضي بإهلاكي",31,"ك",2,0]]}