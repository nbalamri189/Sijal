19,"حبيبي يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=193706",""],[4572,"أليس الزمان كما قدْ علمتَ","https://www.poetsgate.com/ViewPoem.aspx?id=15006",""],[5260,"أفق مَا معنى بِجمع الحطام","https://www.poetsgate.com/ViewPoem.aspx?id=190431",""],[5292,"العلم أبقى لأهل العلم آثاراً","https://www.poetsgate.com/ViewPoem.aspx?id=122673",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5376,"ولا تحزنْ إذا ضَحِكَ الظَلُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=204768",""],[5377,"هل يخاف الشعب من نفسه","https://www.poetsgate.com/ViewPoem.aspx?id=61891",""],[5409,"بلغت يا أيها النحات منزلة","https://www.poetsgate.com/ViewPoem.aspx?id=155284",""],[5431,"الريم ..لوحة ذاتية","https://www.poetsgate.com/ViewPoem.aspx?id=206889",""],[5431,"عادات ثقيلة ...","https://www.poetsgate.com/ViewPoem.aspx?id=213746",""],[5509,"محاولات لاصطياد شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=93490",""],[5512,"يا أيها الرمل","https://www.poetsgate.com/ViewPoem.aspx?id=204865",""],[5542,"غدا يتحدث الرطب","https://www.poetsgate.com/ViewPoem.aspx?id=10030",""],[5582,"تُلَوِّمُنِي فِي الحُبِّ وَالحِبُّ يُعْذَرُ","https://www.poetsgate.com/ViewPoem.aspx?id=187140",""],[5605,"دوى الرصاص","https://www.poetsgate.com/ViewPoem.aspx?id=161226",""],[5689,"أراك على مر الجديدين خاسرا","https://www.poetsgate.com/ViewPoem.aspx?id=143410",""],[5689,"أهبت فنلت من قلبي الجوابا","https://www.poetsgate.com/ViewPoem.aspx?id=143429",""],[5691,"بيادق","https://www.poetsgate.com/ViewPoem.aspx?id=206042",""],[5756,"قدها وقدود","https://www.poetsgate.com/ViewPoem.aspx?id=5439",""],[5908,"لي لا لغيري آلت نوبة الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=170970",""],[5961,"اضرب عن الناس","https://www.poetsgate.com/ViewPoem.aspx?id=199763",""],[6102,"هوان هوى","https://www.poetsgate.com/ViewPoem.aspx?id=185303",""],[6125,"هَوَىٰ قَلبي","https://www.poetsgate.com/ViewPoem.aspx?id=210718",""],[6148,"نصائح غالية","https://www.poetsgate.com/ViewPoem.aspx?id=203066",""],[6300,"أنا يا أنت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81626&r=&rc=3",""],[6336,"في ليلة غائمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73558&r=&rc=19",""],[572,"أَلاَ أَبْلِغْ أَبَا بَكْرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9291&r=&rc=148",""]],"verses":[["وَلا تَخطُبوها بِالرَجاءِ فَما أَرى","تُدَنَّسُ بِالبَعلِ الدَنِيِّ حَصانُها",0,"ن",3,0],["ولا تَخُبُّ هَوادي الخَيْلِ إنْ رَكِبوا","إِلى الوَغى بمعازيلٍ ولا كُشُفِ",1,"ف",1,0],["وَلا تَختَشوا مِمّا يُقَدَّرُ في غَدٍ","فَما جاءَنا مِن عالَمِ الغَيبِ مُخبِرُ",2,"ر",1,0],["وَلا تَختَر فِراشاً مِن حَريرٍ","وَلا تَبكِ المَنازِلَ وَالبِقاعا",3,"ع",2,0],["وَلا تَخطُر هُمومَ غَدٍ بِبالي","فَإِنَّ غَداً لَهُ رِزقٌ جَديدُ",4,"د",1,0],["وَلاَ تُخْلِيَا مِنْهَا عَلَى خَطَر السُّرَى","سُرُوجَ الْمَذَاكِي أَوْ ظُهُورَ النَّجَائِبِ",5,"ب",1,0],["ولا تخْشَ لُجّ الدّمْعِ يا خَطْرَةَ الكَرى","على الجَفْنِ بلْ قِيسي علَى صرْحِ بِلْقيسِ",6,"س",1,0],["وَلا تَخذُلَنَّ القَومَ إِن نابَ مُغرَمٌ","فَإِنَّكَ لا تَعدَم إِلى المَجدِ داعِيا",7,"ي",2,0],["وَلا تَخْفَ أَنْ تَعُوقَ عَثْرَةُ مَنْ","يَعْثُرُ تَيَّارَ حَادِثٍ عَمَمِ",8,"م",1,0],["وَلا تُخلِفُ الضَأنُ الغِزارُ أَخا الفَتى","إِذا نابَ أَمرٌ في الفُؤادِ فَظيعُ",9,"ع",1,0],["ولا تخشَ بينهما عسرةً","بديوان حشر دمشق العسير",10,"ر",1,0],["ولا تخلني سامعاً لومةً","أعوذ بالله السميع العليم",11,"م",1,0],["ولا تخيلت معنى السحر عندهمُ","حتَّى تقلَّب حبل الشعر ثعبانا",12,"ن",2,0],["ولا تختصُّ بالحَلَبِ العيامَى","إذا الحُلّاب قاموا بالعِلابِ",13,"ب",1,0],["ولا تخف من مَطْعَمٍ باردٍ","على امرئٍ صُوِّر من مارجِ",14,"ج",1,0],["ولا تُخلِفنِّي فإنّ الكري","م سيان وأْيٌ وآهُ ونذر",15,"ر",1,0],["ولا تُخسِسْهُ معتلّاً عليه","بإعجاليك حاشاك الضرار",16,"ر",1,0],["ولا تخَلْ عَوْدتي كبادئتي","سأُسْعِط السم من عصى الحُضضا",17,"ض",2,0],["ولا تخل أنها مُصادقةٌ","أخرى الليالي سوى مُصادقها",18,"ق",3,0],["ولا تخلطِ الحسنَى بسوءٍ فإنه","يجشّمُنا أن نخلطَ الشكر بالعذلِ",19,"ل",1,0],["ولا تَخْدعَنِّي ولا يَخْدَعَنْ","ك لفظٌ تُزَيِّنُه بالرقون",20,"ن",1,0],["ولا تخف أن أَضيعَ إن عدلت","عنك رِكابي فلستُ مجنونا",21,"ن",2,0],["وَلا تُخنوا عَلَيَّ وَلا تَشِطّوا","بِقَولِ الفَخرِ إِنَّ الفَخرَ حوبُ",22,"ب",1,0],["وَلَاِتَّخَذتُ أَخاً في الدَهرِ يُؤنِسُني","بَعدَ الجَليلِ سِوى الحُزنِ الَّذي وَجَدا",23,"د",2,0],["وَلا تُخدِشوا بِالعَتبِ وَجهَ مَحَبَّةٍ","لَهُ بَهجَةٌ أَنوارُها تَتَوَقَّدُ",24,"د",1,0],["ولا تخشى ممَّا وراءَ التِّلاعِ","فما ثَمَّ إلاَّ الضُّحى في صِبَاهْ",25,"ا",2,0],["وَلا تَخلُ مِن عَمَلٍ فَوقَهُ","تَعِش غَيرَ عَبدٍ وَلا مُحتَقَر",26,"ر",1,0],["ولا تخصَّ بمقتٍ بعض سيرتِه","فليس في الدهرِ شيءٌ غيرُ ممقوتِ",27,"ت",1,0],["وَلا تَخَف يَوماً عَلى","سَيِيءِ عَيشِ المُملِقِ",28,"ق",1,0],["وَلا تَخشَ مِن إِثمٍ إِذا ما شَرِبتَها","لِظاهِرِ قَولِ الناسِ إِنّ اِسمَها الإِثمُ",29,"م",1,0],["وَلا تَخَف ضَلَّةً وَاِنظُر فَسَوفَ تَرى","نُوراً يُريكَ مَدَبَّ الذَّرِ فِي الأَكَمِ",30,"م",1,0],["وَلا تَخَفْ وِرْدَ مَوْتٍ أَنْتَ وَارِدُهُ","مَنْ أَخْطَأَتْهُ الرَّزَايَا غَالَهُ الْهَرَمُ",31,"م",1,0],["وَلا تَخشى الخُطوبَ مُسَبِّحاتٌ","بِعِزَّةِ رَبِّهِنَّ مُمَجِّداتُ",32,"ت",1,0],["وَلا تُخبِر شُؤونَكَ وَاِجعَلَنها","سَرائِرَ في الضَميرِ مُكَتَّماتِ",33,"ت",1,0],["ولا تخالنّ أن الشعر أنقذني","من المصائب والآفات والكُرب",34,"ب",1,0],["وَلا تَخَافُوا نَكَالاً فِيهِ مَنْشَؤُكُمْ","فَالْحُوتُ فِي الْيَمِّ لا يَخْشَى مِنَ الْبَلَلِ",35,"ل",1,0],["وَلا تُخْجِلَنْهُ بِالْعِتَابِ فَإِنَّنِي","أَخَافُ إِذَا مَا احْمَرَّ أَنْ يَتَلَهَّبَا",36,"ب",2,0],["ولا تَخْلِطوا شَغباً عليكم مُبغَّضا","إلينا وحقاً لا نريدُ به شغْبا",37,"ب",2,0],["ولا تَخَلِ الجفاءَ فلم تُغَيَّبْ","يدٌ تُرعى ، ولا ذمم تُراعى",38,"ع",2,0],["ولا تخجَلْ فحيثُ وقفتَ ظلَّتْ","إلى غاياتِها تقفُ الأُلوف",39,"ف",1,0],["ولا تُخْدَعَنَّ بقولِ الضِعافِ","من الناس أنّك عَفُّ اليد",40,"د",1,0],["ولا تخف من مَطْعَم بارد","على امرىء صُوِّر من مارج",41,"ج",1,0],["ولا تخطيت ولو ظله","فما انتفاعي اليوم بالعمر",42,"ر",1,0],["ولا تخيلت أن النانس كلهم","في السر والجهر غيلان وذؤبان",43,"ن",1,0],["ولا تخالفْه في قولٍ وفي عملِ","ولا تخالفْه واحذرْ صولةَ البطرِ",44,"ر",1,0],["وَلا تَخفى الضَغينَةُ حَيثُ كانَت","وَلا النَظَرُ الصَحيحُ مِنَ السَقيمِ",45,"م",1,1],["ولا تخْشَ الرقيبَ ووافِ جهراً","فأن تخَف العيونَ فجِىء بفجرِ",46,"ر",1,0],["وَلا تُخلِ قَلباً في الوَرى مِن مَخافَةٍ","فَلولا حَياةُ الخَوفِ لَم يَمُتِ الحِقدُ",47,"د",1,0],["ولا تخدعوا عن ليلة قد تنزلت","بأرجائها الاملاك والروح بالأمر",48,"ر",1,0],["وَلا تَخَف عِندَها مِن بَأسِ صَولَتِهِ","فَلَيسَ يَملِكُ مِن نَفعٍ وَلا ضَرَرِ",49,"ر",1,0],["وَلا تَخَف فَالَّذي قَد كُنتَ تَعهَدُهُ","أَزالَهُ سَيِّدُ الأَملاكِ مُنذُ وَلي",50,"ل",2,0],["وَلا تَخَطّى بُيُوتَ الحَيِّ مُبتَجِحاً","جَذلانَ يَخطُرُ مُختالاً عَلى قَدَمِ",51,"م",1,0],["ولا تَخلَّص قلبي من يدَىْ حُزُنٍ","يوماً ولا مُقْلتي من دمعيَ الجاري",52,"ر",2,0],["ولا تخفْ نَقْلا فنسيانُه","في وقتِها يَمنعُه نقلها",53,"ل",3,0],["ولا تخش الصغائر ان ربي","رحيم بالكبار وبالصغار",54,"ر",1,0],["ولا تخلني في جنة الخلد من هوى","برعبوبَةٍ لا تعرف الرفقَ حمقاء",55,"ا",2,0],["ولا تُخَلَّدُ أجساهُ الورى أبَدَاً","وليس يبقى من الأرواحِ أرْمَاقُ",56,"ق",1,0],["ولا تخلعي عنك ثوب الحيا","ء ولا تبسمي لامرء يبسم",57,"م",1,0],["وَلا تَخافي عَذولاً فَالعَذول مَضى","وَالعَصر سَكران يا أَخت الشَقا تَعِبُ",58,"ب",1,0],["وَلا تَخَف من ضِيا صُبحِ الجَبينِ فقد","عَرفتَ فرطَ سوادِ الشَعرِ وَالحدقِ",59,"ق",1,0],["وَلا تُخدَعَنَّ بِمُغتَرَّةٍ","حَديثُ مَوَدَّتِها مُفتَرى",60,"ر",2,0],["وَلاَ تَخْضَمْ لِخَلْقٍ قَطُّ عِرْضاً","فَيَبْقَى الْعِرْضُ مِنْكَ بِلاَ اتِّسَاخِ",61,"خ",1,0],["وَلاَ تَخَطَّتْ مُحَلِّيهِ بِتَحْلَِيَةٍ","بَاهَى بِهَا الثَّقَلَيْنِ الْجِنَّ وَالْبَشَرَا",62,"ر",2,0],["ولا تخشَ عسراً في النضالِ وعَثرَةً","فما النَّصرُ إلا للفتى المُتَقَحِّم",63,"م",1,0],["ولا تُخلِ عجوزَكَ من سهامٍ","إذا ما اسطَعتَ إِعمالَ العجوزِ",64,"ز",1,0],["ولا تخالف له أمراً تبارك من","رب عظيم وسر في أقوم السبل",65,"ل",1,0],["ولا تختفى اخبار ما كان قد جرى","بمحو ايادي الكذب في جهد كتمان",66,"ن",1,0],["ولا تخرج الملقوم ثم ترده","ولا تنهشن العظم في دار خلان",66,"ن",1,0],["وَلا تَخل أَن عين الدَهر نائِمَة","الدَهر يَقظان وَالاِنسان وَسنان",67,"ن",1,0],["ولا تَخْرِقُ العاداتِ أنظارُ مُعْسِرٍ","شكا زمَناً حتّى تَعودَ مَياسر",68,"ر",1,0],["وَلا تُخدَعي بالدَمعِ فَالدَمعُ بَعضُهُ","سَرابٌ وَظَنّي نَحوَهُ ما سَرى بِيا",69,"ي",2,0],["ولا تَختصَّ فَحلاً دُونَ فَحلٍ","وصيَّةَ جاهِلٍ بهمُ غَبِيِّ",70,"ي",1,0],["ولا تَخَف ما يَصنَعُ الدهرُ بي","من بعدِ ما استَنصَرت مَنصورا",71,"ر",2,0],["ولا تخاطر ولا تأمنْ مكامنَه","ليس المُخاطِرُ محموداً ولو سَلِما",72,"م",2,0],["ولا تخف فالمُنَّه","موجودةٌ في التعب",73,"ب",1,0],["ولا تخدشنَّّ البرَّ منك بمطله","فكم ماطلٍ قد عيبَ منه نَداؤه",74,"ا",3,0],["ولا تخش إلا الله في كل مؤلم","وخذ باليقين في الأمور لتعتلي",75,"ل",2,0],["ولا تخالطهم تنالك أكدار","ولا تحصل غير اثم وأوزار",76,"ر",1,0],["ولا تخشى مواجهةَ الرَّزاي","ولا تخشى العَناءَ ولا تُبالي",77,"ل",2,0],["ولا تخص البشرى بعافية","من وصب مَسَّنِي به النصب",78,"ب",1,0],["ولا تخافوا زماناً حين يُؤْمِنُكُمْ","فليسَ يندؤُكُمْ من شَرِّهِ نادي",79,"د",2,0],["ولا تخفْ مني ضَياعاً فقد","حفظْتُ عند الحافظِ الأكرمِ",80,"م",1,0],["ولا تَخُبُّ مطاياهُمْ عَلَى بَلَدٍ","إِلّا استُنيرَتْ بأَدنى وَخْدِها اللِّمَمُ",81,"م",1,0],["ولا تخطَّتْ إليك طارقةٌ","لجُرحها في سعادةٍ كَلْمُ",82,"م",1,0],["ولا تخش من سيفٍ خَبَرتَ مضاءَه","وإن كان فَلّاً أن يكون نُكولُ",83,"ل",1,0],["ولا تخلْ ودَّ العميد مِنحةً","سيقتْ بقصدٍ أو عن اعتمادِ",84,"د",1,0],["ولا تخدعْك مسحةُ ظهرِ أفعَى","فتحتَ لثاتهِ نابٌ حديدُ",85,"د",1,0],["وَلا تَخشَ أَن يَلقاكَ لَومُ فُحولِنا","مِنَ الوَردِ ما فيهِ لِمُصطَبِحٍ عُذرُ",86,"ر",1,0],["ولا تخشَ منهنَّ الكَلالَ فاِنمَّا","أخو الشوقِ مِن كَدَّ المطيَّ وأوجَفا",87,"ف",2,0],["ولا تخنك الليالي","فيما تبيع بوكسِ",88,"س",1,0],["ولا تخف مللاً منا فنحن به","على التمكُّنه قد قامت معانينا",89,"ن",2,0],["ولا تخزني يا من إليك تضرُّعي","وسهل أموري انَّني حرت في أمري",90,"ر",2,0],["ولا تخفْ زورَهُمْ نمْ بالأَمانِ فما","طَوَوْا عليه الخَفايا كلُّهُ زُورُ",91,"ر",1,0],["ولا تخل حاضراً","لغائب ينتظر",92,"ر",1,0],["وَلا تَخشَ أَمراً أَنتَ فيهِ مفوِّضٌ","إِلى اللَّه غاياتٍ له ومصادرا",93,"ر",2,0],["وَلا تَخشَ اِلتواءَ الدّهر يوماً","فإنّ الدّهرَ يَرجعُ ما أعارا",94,"ر",2,0],["وَلا ت