53,"ب",1,0],["وَلا تَخْتَصِرْ فِيما ذَكَرْتَ فإِنَّما","حَدِيثُكَ لِي مِنْهُ المَسَرَّةُ تَظْهَرُ",254,"ر",1,0],["ولا تخاذل من بالبطش يحكمنا","فقصةالذئب لا تخفى عن الحمل",255,"ل",1,0],["ولا تخش منهم في الحياة إذاية","لقد عاش من يخشى أذي الناس صاغرا",256,"ر",2,0],["ولا تخشوا وعيدا من عتي","فللمظلوم أجدر أن يهابا",257,"ب",2,0],["ولا تَخْدَعَنْكَ الأمْنِياتُ ترَقْرُقاً","فرُبَّ سَرابٍ يخْدَعَنَّ تَرَقْرُقُهْ !",258,"ق",2,0],["ولا تخطي ترى لصبر الحليم اليا سلاك حدود","تروّى واعرف بضرب الحديد تفكك لحامه",259,"م",2,0],["ولا تخطى لنيل العز غيرهم","إلا ورد بخسران على العقب",260,"ب",1,0],["ولا تخاطب حداة الذاكرين بقل","ولا بزدنا وكن دوما مع الله",261,"ل",2,0],["وَ لَا تَخضَعْ فَمَا الَّلذَاتُ إِلَّا","كَدَربٍ لَاحَ مُعوَجًّا وَ أَمتَا",262,"ت",2,0],["ولا تَخشَ البُغَاةَ بأيِّ وَجهٍ","يُفَرِّجُ هَذِهِ المِحَنَ الإلهُ",263,"ا",3,0],["ولا تخفض لغير الله رأسا","فرأسك لن يقوم إذا تدلى",264,"ل",2,0],["ولا تخْلعْ ثِيابَكَ فِي سرِيري","ولا تنسِجْ حَمَاقَاتي ثِيَابَا",265,"ب",2,0],["ولا تختفي ، لم تبق لي غير ومضة","من النور أخشى ان تواريت فقدها",266,"د",3,0],["ولا تخطرُني منكَ","على بالٍ من الذِّكْرِ",267,"ر",1,0]]}