""],[5447,"محمد الصغير .. أنا والبيت الأول، والأخير","https://www.poetsgate.com/ViewPoem.aspx?id=208332",""],[5461,"فدوة عيونك","https://www.poetsgate.com/ViewPoem.aspx?id=6232",""],[5521,"سائل تميماً هل وقيت فإنني","https://www.poetsgate.com/ViewPoem.aspx?id=85035",""],[5536,"إهداء إلى كل امرأه ( المطلقه )","https://www.poetsgate.com/ViewPoem.aspx?id=37058",""],[5542,"مشاهد من يوم القيامة","https://www.poetsgate.com/ViewPoem.aspx?id=10202",""],[5573,"أشعلت لي في داجر الليل مصباح","https://www.poetsgate.com/ViewPoem.aspx?id=200076",""],[5608,"كل ليله","https://www.poetsgate.com/ViewPoem.aspx?id=33397",""],[5756,"الليالي السرمدية","https://www.poetsgate.com/ViewPoem.aspx?id=5438",""],[5842,"عصفورة الأمل \\محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=150624",""],[5848,"ظلم الشبابيك","https://www.poetsgate.com/ViewPoem.aspx?id=53097",""],[5848,"الهيل والنعناع والقرفه","https://www.poetsgate.com/ViewPoem.aspx?id=53166",""],[5851,"على مرايا الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=175279",""],[5956,"يعود القديم","https://www.poetsgate.com/ViewPoem.aspx?id=192371",""],[5956,"سيُنْصِفُها التاريخ إن شاء الله ولو ليس يهمها التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=207820",""],[6142,"هلم نصفق معا كفي مبايعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155725",""],[1333,"من ليس بالباكي ولا المتباكي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=56025&r=&rc=3",""],[6213,"غرام متجدد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85498&r=&rc=101",""],[6271,"عاشق التاريخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80707&r=&rc=13",""],[6353,"خواطر الوداع الأولى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64578&r=&rc=1",""],[572,"بلليتُ بأحسنِ الثّقْلينِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9398&r=&rc=255",""]],"verses":[["وَآخُذُ ثاري مِن زَمانٍ تَعَرَّضَت","مَغارِمُهُ بَيني وَبَينَ المَغانِمِ",0,"م",1,0],["وَآخَذَهُم بِعِنانِ الخُطوبِ","يُجيرُ عَلى الدَهرِ أَمراً مُطاعا",1,"ع",2,0],["وَآخُذُها وَإِن رُغِمَت أُنوفٌ","مُغالَبَةً وَإِن ذَلَّت رِقابُ",2,"ب",1,0],["وَآخُذُ ثَأرَ النَدبِ سَيِّدِ قَومِهِ","وَأُضرِمُها في الحَربِ ناراً تُؤَجَّجُ",3,"ج",1,0],["وَأَخَذنَ يَجتَزنَ الطَري","قَ وَدارُ سَعدٍ قَصدُهُنَّه",4,"ن",2,0],["وَأَخذُ الهَوى فَوقَ الحَلاقيمِ مُخرِسٌ","لَنا أَن نُحَيّي أَو نُسَلِّمَ مانِعُ",5,"ع",1,0],["وَأَخَذَ الدُرّاجُ في الصِياحِ","مُكتَنِفاً مِن سائِرِ النَواحي",6,"ي",1,0],["وآخذُ من قبل المديح جوائزاً","تقصر عن أدنى مداها الممادح",7,"ح",1,0],["وأخذت من ريب الزمان أمانه","وقبضت حقّ مآربي بالكامل",8,"ل",1,0],["وأخذنا الوحشَ من المسارب","وفعلنا بالطيرِ فوقَ الواجب",9,"ب",1,0],["وأخذٌ بحظٍّ من سماعٍ إذا التقى","وهمُّ الفتى المهموم ماتت هَواجِسه",10,"س",2,0],["وَأَخَذتُ أَحسَبُ كُلَّ شَيءٍ لَم يَكُن","مُتَجَلِيّاً في فِكرَتي مُتَخَيَّلا",11,"ل",2,0],["واخذنا من الرفاهة حظاً","وشربنا المنى بكأس دهاق",12,"ق",1,0],["واخذنا نصيبنا من دروس","لا غنى عنها للذي يتهذب",13,"ب",1,0],["وأخذت من عدل القضاء لفتية","ذاقوا السجون عذابها وبلاءها",14,"ا",3,0],["وَأَخَذَ اللَهُ لَهُم مِن حاسِدٍ","في النَسَبِ الطاهِرِ قالَ وَلَغا",15,"ا",1,0],["وَأَخَذتِ قِسطاً مِن مَناحَةِ ماجِدٍ","جَمِّ المَآثِرِ طَيِّبِ الأَنباءِ",16,"ا",2,0],["وَأَخذُكَ مِن فَمِ الدُنيا ثَناءً","وَتَركُكَ في مَسامِعِها طَنينا",17,"ن",2,0],["وَأَخَذتَ يَلدِزَ عَنوَةً","وَمَلَكتَ عَنقاءَ الثُغور",18,"ر",1,0],["وَأَخذٌ لِلحَواصِرِ وَالبَوادي","بِضَبطٍ لَم تُعَوَّدهُ نِزارُ",19,"ر",1,0],["وأخذتَ ثأرَ الدينِ منهمْ بعدَمَا","شاطَ الدماءُ وضاعفَ الأوتارُ",20,"ر",1,0],["وَأَخذي بِعِطفَيها وَقَد مالَ رِدفُها","بِلَيِّنَةِ العِطفَينِ مَهضومَةِ الحَقِّ",21,"ق",1,0],["وَأَخذُ يَدي مَنٌ عَلَيَّ وَإِنَّما","يُقالُ لِقَوّالِ الخَنا خُذ بِرِجلِهِ",22,"ل",2,0],["وَأَخَذتَ عَدلاً مِن أَبيكَ لَنا","وَقَلَعتَ عَنّا كُلَّ ذي كِبرِ",23,"ر",1,0],["وأخذْتَ كأسَكَ والشِّفاءُ قَرينُها","فلَوِ اسَتطاعَ تَحيَّةً حيَّاكا",24,"ك",2,0],["وَأَخذُ مَشيبٍ مِن شَبابٍ أَرى بِهِ","تَقاضِيَ دَينٍ أَو تَنَجُّزَ مَوعِدِ",25,"د",1,0],["وَآخِذُ الثَأرَ مِن عِداكَ وَلو","تَحَصَّنوا بِالحُصونِ وَاِعتَصَموا",26,"م",3,0],["وَأَخَذنا حُقوقَنا بِسُيوفٍ","غَنِيَت بِالدِما عَنِ الأَغمادِ",27,"د",1,0],["وأخذت أدفئ بردها بفمي","لو تنفعنَّ حرارة القبل",28,"ل",1,0],["وآخذةٍ في دورةٍ فلكيّةٍ","ترى القطبَ منها ثابتاً وهي تضْطَرِبْ",29,"ب",1,1],["وَأَخَذتَ بابَكَ حائِراً دونَ المُنى","وَمُنى الضَلالِ مِياهُهُنَّ أُجونُ",30,"ن",1,0],["وَأَخَذتُ بِالطِوَلِ الَّذي لَم يَنصَرِم","ثِنياهُ وَالعَقدُ الَّذي لَم يُحلَلِ",31,"ل",1,0],["وَأَخَذتِهِ بَعدَ الصُدودِ تَكَرُّهاً","وَأَشَعتِ عِندَ قِراتِهِ عِصيانا",32,"ن",2,0],["وَآخِذُ ما أَعطَيتِ عَفواً وَإِنَّني","لَأَزوَرُّ عَمّا تَكرَهينَ هَيوبُ",33,"ب",1,0],["وأخذناك إلى أضلاعنا","وسَقيناك مِن الحُبِّ رحِيقا",34,"ق",2,0],["وَأَخَذتَ قَمرَكَ بِاليَمي","نِ بِفَوزِ خَصلاتِ المُناضِل",35,"ل",1,0],["وَأَخَذتَ أَطرارَ الكَلامِ فَلَم تَدَع","شَتماً يَضُرُّ وَلا مَديحاً يَنفَعُ",36,"ع",1,0],["وَأَخَذوا وَقَتَلوا عَلِيّاً","العادِلَ البَرَّ التَقي الزَكِيّا",37,"ي",2,0],["وأخذَكَ قسراً من بني الأصفر الّذي","تذَبذَبَ كسرى عنه وهو عنيد",38,"د",1,0],["وأخذُ صبّينِ في عِتابٍ","يشكو عميدٌ إلى عميدِ",39,"د",1,0],["وآخذ في مذاهب قومٍ لوطٍ","ولا آلو تمرّدَ قومِ عادِ",40,"د",1,0],["وَأَخٍ ذي ثِقَةٍ آخَيتُهُ","ماجِدِ الأَعراقِ مَأمونِ الأَدَب",41,"ب",1,1],["وَأَخٍ ذي نيقَةٍ يَسأَلُني","عَن خَليطَيَّ وَلَيسا بِسَوا",42,"ا",1,0],["وَآخُذُ مالَ عَبلَةَ بِالمَواضي","وَيَعرِفُ صاحِبُ الإيوانِ قَدري",43,"ر",2,0],["وَآخُذُ مالَنا مِنهُم بِحَربٍ","تَخِرُّ لَها مُتونُ الراسِياتِ",44,"ت",1,0],["وأَخَذْتُ أَسْتَجْلي السَّنَا من نَوْرِه","وأشَمُّ رِيحَ الْخُلْدِ من نَفَحاتِه",45,"ت",2,0],["وأخذت كأمسيّي أهمسي","أترمّد أدمى أتعجّن",46,"ن",1,0],["وَأَخذٌ لِلحَواضِرِ وَالبَوادي","بِضَبطٍ لَم تُعَوَّدهُ نِزارُ",47,"ر",1,0],["وأخذتك؟ واللي حصل.شي.ماعمره؟؟حصل؟؟؟","تمدحك؟؟لاكن..كنهاا...؟تلعن واالديك",48,"ك",1,0],["وَأخذي بعِطفَيْها، وَقد مالَ رِدْفُها","بلَينه العِطفَينِ، مَهضُومةِ الخَصرِ",49,"ر",1,0],["وأَخْذٌ ثم ردّ ثم جذبٌ","ووصف ثم كشف ثم لبس",50,"س",1,0],["وأخذتهِ بعد الصدودِ تكرهاً،","وأشعثِ عند قراتهِ عصيانا",51,"ن",2,0],["وأخذنا القطب الرفاعي بابا","منقذاً بالرضا من الأخطار",52,"ر",1,0],["وأخذُها لَبَهَا لأنها لِبَها","نيل المعالي ودرُّ صيتها دررُ",53,"ر",1,0],["وأخذت مأخذها صرفت بصرفها","ودخلت مدخلها دخولاً أحزما",54,"م",2,0],["وأخذتُ أرشف من رحيقِ رضابها","وألفها معْ عفة بكسائي",55,"ا",2,0],["وأخذوا مجالساً رتبتهم","فيها كستهم من ثيابِ المفخرِ",56,"ر",1,0],["واخذل بأنعمك الكفور فكلما","في بيته منها عدو ظافر",57,"ر",1,0],["وأخذت منهم بالخطوط شهادة","ورحلت عنهم راضيا مستبشرا",58,"ر",2,0],["واخذ من صروف الدهر ثأري","ويسلو مني القلب الحزين",59,"ن",1,0],["وأخذتَ قلبي يا رسول فليتَني","قد كنتُ دونكَ للفؤاد رسولا",60,"ل",2,0],["وأخذت من دبس العراق ومثله","ماء الغمائم ظللته غيوم",61,"م",1,1],["وَأَخذ العهدَ عليهم أوّلُ","أَن يُؤمنوا وينصروا فقَبِلوا",62,"ل",3,0],["وَأَخذتَ رَأيَ النُهى مُستَوثِقا","مُستَوزِرا وَكذا الحَكيم يدقِّقُ",63,"ق",1,0],["وَآخُذُ عَنهُ حينَ يُقبِلُ جانِباً","حذار العِدا وَالشَوقُ يَلعَبُ بِالحَشا",64,"ش",2,0],["واخذري بحزم الأمران مر أو حلا","وصبري على حمر المنايا وجونها",65,"ن",3,0],["وآخذَ قوةً من ضِعفِ حبّي","تُصَيِّرُني دليلاً للحَيارى",66,"ر",2,0],["وَأَخْذِي مِنْكَ ميثاقاً كَرِيماً","وَعَهْداً ما لِعُرْوَتِهِ انْفِصامُ",67,"م",1,0],["واخذنا بعد سير ال","هيدبي نمشي الهوينا",68,"ن",2,0],["وَأَخَذَهُ بِالقَصدِ فيما اِقتَنى","وَتَرَكَهُ ما لَيسَ يُعناهُ",69,"ه",1,0],["وَأَخذتُ عَنهُ لا عَلَيهِ وَمَذهَبي","أَن يُقبَلَ القَولانِ وَالوَجهانِ",70,"ن",1,0],["وَأَخذِهِمُ أَلواحَ مُعجِزِ آيِهِ","كَما أَخَذَ الأَلواحَ موسى عَلى قَدرِ",71,"ر",1,0],["وَأَخذُكَ مِن رِجالٍ كَالمَنايا","وَأَخذُكَ مِن قُلوبٍ كَالصُخورِ",72,"ر",1,0],["وأخذك للِصَّحيفةِ يوم حشرٍ","إذا انتدبتْ لتَأخذَها اليَمينُ",73,"ن",1,0],["وأخَذتُ أُنشِدُ في الثناء قصائدي","بالسيّد السَنَد العظيم الشان",74,"ن",1,0],["وأخذت أذكرهم وبينَ جوانحي","كبدٌ تكادُ لما بها تتصدَّعُ",75,"ع",1,0],["وأَخَذْتَ سيفَ النصرِ منه بِحَقِّهِ","وحَمَلْتَ من أَعبائِهِ مَا حَمَّلَكْ",76,"ك",1,0],["وآخذ النصر والأيام مدبرة","والخصم يمعن تحقيرا وتسفيها",77,"ي",3,0],["وأخذت تبني من جديد حظّها","كالغيث يطلع في الربى النوارا",78,"ر",2,0],["وآخذٌ بيده وسيفه","نفائساً يسلُبها ما نوّلا",79,"ل",2,0],["وأخذا من الأيام أوفَى حظوظها","بخيرٍ تجدْ ما شئتَ منهنّ وارفضِ",80,"ض",1,0],["وأخَذُوا إلى فسيح لاحبٍ","بالناس من جهل المضيق المُلبِسِ",81,"س",1,0],["وَآخُذُ حَقّي مِن رِجالٍ أَعِزَّةٍ","وَإِن كَرُمَت أَعراقُهُم وَالمَناسِبُ",82,"ب",1,0],["وأخذت الطريق يا ابن الرفاعي","عنك في منهجِ الهدى شرعيّا",83,"ي",2,0],["وأخذتهم من هولها رعدةٌ","زلزلت الأرض بها زلزاها",84,"ه",2,0],["وأَخذْنا كلَّ المَشاهِدِ منهُ","أَلفُ حاشَا نقولُ منهُ ومِنَّا",85,"ن",2,0],["وأخذْتِ الظُّلمَ فيهم دَيْدَناً","وأخذْنا الصَّبرَ طوْعاً مذهَبا",86,"ب",2,0],["وآخذ منه العفو ما دام باخلاً","وأنهى لساني أن يعود لعذله",87,"ل",2,0],["وأخذتُموهُ في قِصاص خُدودِكم","وهو البَريُّ وطَرفُ عَيني المُذنِبُ",88,"ب",1,0],["وأخذُ الرّدى نفسي كأخذ أصادِقِي","فلم يَحمِنِي كُثْرُ الأذى بقليل",89,"ل",1,0],["وأخذتِنِي بذنوبِ شي","بٍ لم تكنْ لي فيه حِيلَهْ",90,"ل",2,0],["وأخذتُ ثاراتي من الزّمنِ الّذي","قَد طال منهُ تألُّمي وتوجُّعِي",91,"ع",2,0],["وَأَخذنَ منِّي ما سمحتُ به","في اليُسرِ من حالي وفي العُسرِ",92,"ر",1,0],["وَأَخَذتم عَمّا جرى يومَ بدرٍ","وَحُنينٍ فيما تخالونَ ثارا",93,"ر",2,0],["وأخذ لقيط القلب في مسجد الحجى","مهم له تسعى الكرام المصاقع",94,"ع",1,0],["وأخذنا طاعاتهم بازدراء","وعتوٍّ في حقنا وعناد",95,"د",1,0],["وأخذ العهد على الجماعة","منهم على السمع له والطاعة",96,"ه",1,0],["وأخذ العهد له علانية","عليهم فيما رووه ثانية",96,"ه",1,0],["وأَخَذْتُ نائلَه بكل بَنَانٍ","وشكرت أَنعُمَهُ بِكُلِّ لِساَنِ",97,"ن",1,0],["وأخذت حسن البدر منه وقد بدا","في أفقه بتمامه وكماله",98,"ه",1,0],["وأخذت من أولى صحائفك التي","للخير أول مبدئي وبياني",99,"ن",2,0],["وأخذت من ثمر السلام وظله","ما شاءت الآمال والأخلاق",100,"ق",1,0],["وأخذت عني اللهو غير محاذر","أعقابه فاربأ بنفسك وارفق",101,"ق",1,0],["وأخذت بالثأر الكبير لمعشر","وردوا بغلظته الحمام ورودا",102,"د",2,0],["وأخذت للشعب الأمين مصيره","من قُلَّب الأدوار والأطوار",103,"ر",1,0],["وأخذت شرع فروع أصل الدين من","تأصيلكم إذ تاهت الأفهام",104,"م",1,0],["وَأَخذتها مَعها وَاِرتَحَلَت","وَحَفظتها أَينما قَد حَلَّت",105,"ت",1,0],["وَأَخذ الربعَ وَقالَ ذاكَ لي","لِأَنَّني أَوّلُ كُلِّ أَوَّل"