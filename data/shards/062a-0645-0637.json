44,"","https://poetry.dctabudhabi.ae/diwan/poem/202775","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205069","الخفيف"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147327","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74203","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62823","المتقارب"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123932","الطويل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102382","الطويل"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32382","الطويل"],[3810,"","https://poetry.dctabudhabi.ae/diwan/poem/18716","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103021","الطويل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199111","الوافر"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136927",""],[4183,"","https://poetry.dctabudhabi.ae/diwan/poem/79693","المتقارب"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4737,"مثلها ليس يُنسى","https://www.poetsgate.com/ViewPoem.aspx?id=212160",""],[4797,"صلف الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=50253",""],[4859,"أخبروا الجوّال","https://www.poetsgate.com/ViewPoem.aspx?id=187006",""],[5409,"تخشع النفس هيبةً من جلال ال","https://www.poetsgate.com/ViewPoem.aspx?id=155478",""],[5447,"سليمى","https://www.poetsgate.com/ViewPoem.aspx?id=208383",""],[5564,"يالله بليلة من خيار الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=186846",""],[5795,"نصرت دولة المهى التركيه","https://www.poetsgate.com/ViewPoem.aspx?id=167910",""],[5931,"نديم الهمس وشعوره !!","https://www.poetsgate.com/ViewPoem.aspx?id=174779",""],[6131,"ارْتِدَادُ النُّورْ","https://www.poetsgate.com/ViewPoem.aspx?id=189266",""],[463,"تربَّعتْ بينَ العذيبِ فالنَّقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60164&r=&rc=220",""]],"verses":[["تَمَطى بِنا أَذوادُنا كُلَّ مَهمَهٍ","خَفائِفَ تُخفيها رُبىً وَرِمالُ",0,"ل",1,0],["تَمَطَّت بِيَ العُشرونَ حَتّى رَمَينَ بي","إِلى غايَةٍ مِن دونِها يُقطَعُ العُمرُ",1,"ر",1,0],["تمطّتْ إِلى حُزْوى بهِمْ غُرْبةُ النّوى","وعَيْشُ اليَماني بالسَّراةِ وَرِيقُ",2,"ق",1,0],["تَمطو الجَديلَ إِذا المَكاكي بادَرَت","جُحلَ الضِبابِ مَحافِرَ الأَدحالِ",3,"ل",1,0],["تَمَطّوا عَلى أكَوارِها كُلَّ ظُلَمةٍ","ويَهَماء تطَمي بِالنفُوسِ الفَواتِكِ",4,"ك",1,0],["تُمطِر ناباه عند نَهشتِهِ","وبلاً من الموتِ بعد إرشاش",5,"ش",1,0],["تَمَطَّت بِرَحلي وَهيَ رَهبٌ رَذِيَّةٌ","إِلَيكَ مِنَ الدَهنا أَتاكَ خَبيبُها",6,"ب",3,0],["تَمطو الرِشاءَ فَتَجري في ثِنايَتِها","مِنَ المَحالَةِ ثَقباً رائِداً قَلِقا",7,"ق",2,0],["تَمَطَّيْتُ أَخْلِيهِ اللِّجَامَ وبَذَّنِي","وشَخْصي يُسَامِي شَخْصَهُ وَيُطَاوِلُهْ",8,"ل",2,0],["تمطّى ليلُ محنتِنا فلمّا","سفرتَ سفرتَ صبحاً مستنيرا",9,"ر",2,0],["تمطّى الواغلون بها وَضاقتْ","عليَّ فلم أجدْ فيها مقيلا",10,"ل",2,0],["تُمطِرُ شَمسُ وَجهِهِ وَتُشرِقُ","وَلا يَغيمُ وَجهُهُ وَيَبرُقُ",11,"ق",1,0],["تمطّت به أمُّ النجابة واحدا","يطول عليها أن يُؤاخَى ويُقرَنا",12,"ن",2,0],["تُمطِر حُمراً لنا وبيضا","حياً من التبرِ واللجينِ",13,"ن",1,0],["تمطُلُ عيني أن ترى من فجرها","بين السواد أبيضاً وأزرقا",14,"ق",2,0],["تمطَّقوا السؤدُدَ في مهودهم","من حَلَمٍ ما أَرضعتْ من لم يَسُدْ",15,"د",1,0],["تمطُّر فَتْخاء الجناحين غادرت","على النِّيق زغْباً لا تطيق التَّهافيا",16,"ي",2,0],["تمطرُ في غَبراء يَظْما لحرِّها ال","رجالُ وتَروي المرهفات البوارد",17,"د",1,0],["تَمَطَّيتُ في طَودِ العُلا إِذ رَقيتُهُ","بِما لِيَ مِن بِشرٍ وَما لِيَ مِن بِرِّ",18,"ر",1,0],["تمطَّتْ في أعنَّتِها اليها","عتاقُ الخيلِ يَجرحُها الشكيمُ",19,"م",1,0],["تَمطو عَلى الزَجرِ وَتَنجو مِنَ ال","سَوطِ أَمونٌ غَيرُ مِظلاعِ",20,"ع",1,0],["تمطرنا كفه سجالا","من الغنى بعدها سجالُ",21,"ل",1,0],["تُمطرُ عيناهُ إذا","بَرقُ الشَّآمِ أومضَ",22,"ض",1,0],["تمطو جماحاً إذا المطي ونت","حتى تراخى لها من الجذل",23,"ل",1,0],["تّمّطّتْ بمَجْدٍ سَبْطَرِيٍّ وطالعتْ","وماذا من اللوْحِ اليَمانِي تُطالِعُ",24,"ع",1,0],["تمطر الدمع إن تشم برق ثغرٍ","وإذا ما دعا الغرام تجيبُ",25,"ب",1,0],["تمطر الترب جارحاً لوجوه","مبدلا للصفاء بالأكدار",26,"ر",1,0],["تَمطَّى بِدمْعي لُغزُ نجمٍ غسَلته","عَلى مذبحِ الركنِ القَديم بذاتِي",27,"ت",2,0],["تَمطيته وَاللَيل كَالبَحر مُظلم","سَفائنه الأَفلاك وَالأَنجُم الزُهر",28,"ر",1,0],["تَمطتْ به الفوتُ مذعورة","ينهنهُ من شَدّها الملتَهِبْ",29,"ب",1,0],["تمطي عليّ البر والبحر دونها","فما عاق عزمي البر عنها ولا البحر",30,"ر",1,0],["تمطَّتْ بهِ غُلْبٌ كأنَّ قُفِيَّها","بهنَّ وأقْراءُ الأخادعِ قِيرُ",31,"ر",1,0],["تَمَطَّت بِهِ بَيضاءَ فَرعُ نَجيبَةٌ","حَصانٌ وَبَعضُ الوالِداتِ غَرامُ",32,"م",1,0],["تَمَطَّت بِهِ قَوداءُ ذاتَ عُلالَةٍ","إِذا الصلدَمُ الخِنذيذ أَعيا وَبَلَّدا",33,"د",2,0],["تمطاه موار العنان مطهما","من الريح أجرى والغيوث السواجم",34,"م",1,0],["تمطى فوق كرسي ولما","يكن أهلا ليجلس في الثواني",35,"ن",2,0],["تمطر الزهر فوقهنَّ الأيادي","مثلما تمطر السماءُ الهتونا",36,"ن",2,0],["تمطّتْ بهِ أمُّهُ في النِّفَا","سِ ليْسَ بِيَتْنٍ ولا تَوْأَمِ",37,"م",1,0],["تُمطرُ للري ومن ذا رأَى","مطمورةً للري ممطورَهْ",38,"ر",2,0],["تمطرُ الغيمُ ثلجاً حليباً ولو","في حزيرانَ إنْ لامستْ جلدَها",39,"د",3,0],["تمطر عيوني وخفاقي سرى ساريه","ينعصر وانا دموعي للوفى عذروبي",40,"ب",2,0],["تمطرُ الأشواقَ زيفاً","تدّعي فرط الصبابة",41,"ب",2,0],["تمطر الطائرات فيها أديم ال","أرض ناراً كعارض هطال",42,"ل",1,0],["تمطُّ حروفَ علتنا نبالاً","وتجعل من سكون الحرف سهما",43,"م",2,0],["تمطر سبوعاً فوق روس المعالي","في موسمٍ في صادقات الهمايم",44,"م",1,0],["تمطر السحب من عيونك ما ثا","ر بخاراً عن نارك القلبيه",45,"ي",2,0],["تمطّى وامتطى صهوة خيال(ن) ممتليك اعجاب ..","وطاحت بالصدر بتلة ربيع(ن) فاحت زهوره ..",46,"ر",2,0],["تَمَطَّى هَاجِسيْ فَاحْتَلَّ وَردًا","يُحاصِرُني ظلَامٌ ثمَّ يَخبُو",47,"ب",2,0],["تمطلُ عيني أنْ ترى منْ فجرها","بينَ السَّوادِ أبيضاً أو أزرقا",48,"ق",2,0]]}