045,"","https://poetry.dctabudhabi.ae/diwan/poem/104741","الهزج"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48259","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204744","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112653","الرجز"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52970","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91272","السريع"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86527","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83495","البسيط"],[4638,"","https://poetry.dctabudhabi.ae/diwan/poem/204562","السريع"],[4943,"القطرة الغيثية والوسيلة الالهية","https://www.poetsgate.com/ViewPoem.aspx?id=125974",""],[5277,"أتدرين","https://www.poetsgate.com/ViewPoem.aspx?id=185290",""],[5277,"شعارُ الدموع","https://www.poetsgate.com/ViewPoem.aspx?id=204180",""],[592,"سفاسط أملاها الغبي وسطرا","https://www.poetsgate.com/ViewPoem.aspx?id=128722",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[6102,"شَظايا خَزَف ..","https://www.poetsgate.com/ViewPoem.aspx?id=184420",""],[463,"لمن صاغياتٌ في الحبلِ طلائحُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60011&r=&rc=67",""]],"verses":[["وَكَيفَ مَجرى الأَنوارِ في عَصَبِ ال","عَينِ إِذا ما اِنحَدَرنَ في الثُقبِ",0,"ب",1,0],["وكيفَ مَنّي وما رمَمْتُ بها","لكم بناءً وَهى ولا انثلما",1,"م",2,0],["وَكَيفَ مادَلَّكَ القِرانُ عَلى","مافيهِ مِن ذاهِبٍ وَمُؤتَنَفِ",2,"ف",1,0],["وَكَيْفَ مُقَامِي بَيْن أَرْضٍ أَرَى بِهَا","مِنَ الظُّلْمِ مَا أَخْنَى عَلَى الدَّارِ وَالسَّكْنِ",3,"ن",1,0],["وكيف منحت المجد روحي فباعها","فعدت بلا روح أعض على العشر",4,"ر",1,0],["وَكَيفَ مُتَّ وَلَم يَش","مَلِ النُجومَ اِنكِدارُ",5,"ر",1,0],["وكيفما خامرني الحب فما","قلت رشادي يا ترى أين وخى",6,"ا",1,0],["وكيف منه الحيا إلا الحياة به","إنزال غيثٍٍ به إكثار ذا الوشل",7,"ل",1,0],["وَكَيفَ مُقامي بَينَ أَوباشِ قَريَةٍ","أَرى الرَأسَ فيها مَن بِها كانَ أَسفَلا",8,"ل",2,0],["وكَيفَ معَ الحَبلِ الَّذِى بَقِيتَ لَهُ","قُوىً مُحكَماتٌ عَقدُهُنَّ مُؤَرَّبُ",9,"ب",1,0],["وكيف من العقيان نرجو تخلصا","وقد علقت منهنّ فيك المخالب",10,"ب",1,0],["وكيف ملكتَ من قد جَلّ عن أن","يُرَى مَلِكَ البريّة والزمان",11,"ن",1,0],["وكيفما قيل قلنا إنه نبأٌ","يجلّ موصوفه عما به وصفا",12,"ف",2,0],["وكيف مَطاري والخطوب تُحصُّني","وأخذِيَ شَوطي والليالي كوابحُ",13,"ح",1,0],["وكيف مدَّ القاع بين العلى","وبينه منها بساط الغبار",14,"ر",1,0],["وكيفما هم جاء إيجادهم","من نعمة المولى وجدواه",15,"ا",2,0],["وكيفما كنت أرى فضله","غامرني وهو الغفور الرحيم",16,"م",1,0],["وكيف مِن بعده آثارهُ اِندرست","وكان فيها الهمام الماجد الحسبُ",17,"ب",1,0],["وكيف مَرَرتَ ثُمَّ حلوتَ طعما","فكنتَ لِطاعمٍ صَبراً وشُهدا",18,"د",2,0],["وكيف مد الردى بالموت منه يداً","لقبض روحهما لم يخش من شلل",19,"ل",1,0],["وكيف من الوادي المقدس سورت","على طور سيناه بأيته الكبرى",20,"ر",2,0],["وكيف من الزوراء عند ضريحه","أهل علت الغبرا أم انحطت الخضرا",20,"ر",2,0],["وكيف ما نَفَضَ المخذولَ مِنْبرُهُ","ولو درى نَفَض المخذولَ وانتفضا",21,"ض",2,0],["وَكَيفَ مَنامي وَكَيفَ نعاسي","وَإِنّي أَرى العاشِقين سَهارى",22,"ر",2,0],["وَكَيفَ مِن غَير لِجام تَمشي","لا بُدَ ذا مِن مَرَضٍ في الكرشِ",23,"ش",1,0],["وكيفما شيت تقليباً لأشطرها","ترى التواريخ باهى حسن فحواها",24,"ا",3,0],["وكيفما جلت في القطرين لست أرى","إلا وجوها عن البأساء تنبيني",25,"ن",2,0],["وَكَيفَ ما يَكون كانَا","وَأَحمَدُ طهَ مِعوَانَأ",26,"ن",2,0],["وكيفَ مكافَاتي وجودُك واكفٌ","وشُؤْبُوبُه المبرومُ لا يتباتَكُ",27,"ك",1,0],["وكيف مماتي وهي بعدي حية","وفي كل حرف لي فؤاد معطر",28,"ر",1,0],["وكيفَ من بعدِكَ تُحمى الحُرَمُ","إن صِرن يَستَرحُمَن مَن لا يَرحَمُ",29,"م",1,0],["وكيف مدارس الخرطوم تُرجى","هناك ودونَها خَرطُ القتاد",30,"د",1,0],["وَكيفَ مثلي أَن يَفي بِالثَنا","وَأَنتَ أَوفَى ذي الوَفا ما رَعوا",31,"ع",3,0],["وكيف مع الطليان يرجون ألفةً","وقد أردت الأشياخ منهم والزمنى",32,"ن",2,0],["وَكَيفَما كانَ حسبُ العبدِ سيّدهُ","وَلِيُّه وَهو نعم الكافِل الوالي",33,"ل",2,0],["وكيف منجاي وقد حف بي","بحر هوى ليس له شط",34,"ط",1,1],["وكيف مقالي معربا ومترجماً","به لك عما في ضميري له حل (1)",35,"ل",1,0],["وكيف مواجعُ الغُيَّاب تندى","تئن الليلَ عِرقا مسَّ عِرقا",36,"ق",2,0],["وكيفَ مصارعُ الصوبينِ تهمي","غدونَ بصبِّهنَ دماً قطارا",37,"ر",2,0],["وكيف موالاه الذي أتت ذاكر","فو الله لن تلقى إلى ذاك مظهرا",38,"ر",2,0],["وكيفما مالت الأشجار قد سقطت","قول الإله العزيز الصادق الكلمِ",39,"م",1,0],["وَ كَيفَ مَا بَينَ فَكِّيِّ الصِّراعِ , عَلَى","جَمرِ الحَقِيقَةِ يَستَهوِينِيَ الخَرَفُ ؟",40,"ف",1,0],["وكيف مطاري والخطوب تحصني","وأخدي شوطي والليالي كوابحُ",41,"ح",1,0]]}