39,"أنورك أم أوقدت بالليل نارك","https://www.aldiwan.net/poem34885.html","الطويل"],[453,"إذن مصر عادت تقتفي مجدها الأسمى","https://www.aldiwan.net/poem61386.html","الطويل"],[458,"نعم من جميلة إحدى النعم","https://www.aldiwan.net/poem55877.html","المتقارب"],[458,"ألا فتى يسأل قلبي ماله","https://www.aldiwan.net/poem55905.html","الرجز"],[458,"خفف بذات البان من أثقالها","https://www.aldiwan.net/poem55951.html","الرجز"],[458,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[479,"أدرها على نخب المحامي صديقي","https://www.aldiwan.net/poem36889.html","الطويل"],[514,"رنا فسل على العشاق أحوره","https://www.aldiwan.net/poem20792.html","البسيط"],[538,"بلبل الأفراح غنى","https://www.aldiwan.net/poem48123.html","عموديه"],[551,"كذا تكشف الغماء بعد ظلامها","https://www.aldiwan.net/poem47193.html","الطويل"],[551,"أشاعرة بما نلقى ظلوم","https://www.aldiwan.net/poem47246.html","الوافر"],[551,"أمالك من غرام ما أمالا","https://www.aldiwan.net/poem47319.html","الوافر"],[551,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[558,"ما الشدة إلا للفرج","https://www.aldiwan.net/poem34692.html","المتدارك"],[562,"أليوم مات التقى والجود والكرم","https://www.aldiwan.net/poem52783.html","البسيط"],[563,"دع العيس والبيداء تذرعها شطحا","https://www.aldiwan.net/poem13597.html","الطويل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[586,"بلا غيبة للبدر وجهك أجمل","https://www.aldiwan.net/poem18010.html","الطويل"]],"verses":[["وَبَشَّرَ بِهِ البَيضَ الصَوارِمَ وَالقَنا","وَبَشَّرَهُ عَن قَولِ النَوائِبِ بِالجَلدِ",0,"د",1,0],["وَبِشرٌ يُهابُ عَلى حُسنِهِ","فَتَحسَبُهُ غَضباً أَو قُطوبا",1,"ب",2,0],["وبِشْرٌ يَلوحُ الجُودُ منه وهَيْبَةٌ","تَروعُ لِحاظَ المُجْتَلي وتَروقُ",2,"ق",1,0],["وَبَشَّرَهَا الأَمْلاَكُ أَنَّ وَلِيدَهَا","إِمَامُ النَّبِئِينَ الْكِرَامِ أُولِي الْعَزْمِ",3,"م",1,0],["وبُشْرى بمُلْكٍ قدْ طلَعْتَ بأفْقِهِ","هِلالاً لهُ سيْرٌ الى رُتْبَةِ البَدْرِ",4,"ر",1,0],["وبُشْرى لأرْضٍ قد سَلَكْتَ بأهْلِها","منَ السَّنَنِ الأرْضى على واضِحِ القَصْدِ",5,"د",1,0],["وَبَشائِر ٌتَصِلُ النُّفُوسَ كَأَنَّمَا","بَيْنَ النُّفُوسِ وَبَيْنَهَا أَنْسَابُ",6,"ب",1,0],["وَبَشَّرَهُم مِن وَجهِهِ وَجَبينِهِ","وَغُرَّتِهِ وَالناظِرينَ مُبَشِّرُ",7,"ر",1,0],["وَبَشَّرَ أَهلَ مِصرٍ بِاِحتِلالٍ","يَدومُ عَلَيهِمُ أَبَدَ الأَبيدِ",8,"د",1,0],["وَبُشراكَ عيدٌ بِالسُرورِ مُظَلَّلٌ","وَبِالحَظِّ في نَيلِ المُنى مُتَكَنَّفُ",9,"ف",1,0],["وَبُشراكَ أَعيادٌ سَيَنمي اِطِّرادُها","كَما اِطَّرَدَت في السَمهَرِيِّ كِعابُ",10,"ب",1,0],["وَبُشراكَ دُنيا غَضَّةُ العَهدِ طَلقَةٌ","كَما اِبتَسَمَ النُوّارُ عَن أَدمُعِ النَدى",11,"د",2,0],["وَبَشَّرَتْ آيَةٌ لِلحَقِّ ظَاهِرَةٌ","بِوَحْدَةٍ لِخُصُومِ الحَقِّ لَمْ تَطِبِ",12,"ب",1,0],["وبُشْرى لنا أن السعادة نُزْلُها","وأنّ رضا الله الكريم يُرضّيها",13,"ي",3,0],["وبشرى بعيد الفطر أيمن قادم","عليك بمجموع البشائر يَقْدّمُ",14,"م",1,0],["وبشرٌ لدى العافين أحلى من المنى","ورأيٌ إلى العلياء أهدى من القطا",15,"ط",2,0],["وبشرى من البِشْرِ الجميل فلم يزل","يبشّر بالصبْح انبلاجُ عمودِهِ",16,"د",2,0],["وبشيرٌ بلقاءٍ","منكُمُ أيمنُ طيرِه",17,"ر",2,0],["وبشيرُ من عاملْتَه ونذيرُهُ","في حالتَيْك تبسُّمٌ وتبسُّلُ",18,"ل",1,0],["وَبُشاشاتُ الزَمانِ الأَوَّل وَالصِبا","يا رَبيعاً مِن وَفاء وَكَرَم في بَدَن",19,"ن",1,0],["وَبَشاشَةُ المَرجِ الخَصيب وَوَحشَةُ","الوادي الكَئيب وَصَولَةُ التَيّارِ",20,"ر",1,0],["وَبِشامَةٍ في خَدِّهِ","أَصبَحتُ في العُشّاقِ شامَه",21,"م",2,0],["وَبَشَّرتَ بِاليَومِ الَّذي فيهِ نَلتَقي","أَلا إِنَّهُ يَومٌ يَكونُ لَهُ نَبا",22,"ب",2,0],["وبشرتني المنى فيما تحدثني","بمظهر لسرير النيل مقتبل",23,"ل",1,0],["وبشرها بك خفق الريا","ح وبعد الرياح يكون المطر",24,"ر",1,0],["وبشَّرنا وعدٌ من المُزْنِ صادقٌ","بواصٍ من الحَوذَانِ والنَّفَلِ الجَعْدِ",25,"د",1,0],["وَبِشاهِدٍ يَتلوهُ عَدلٌ مِثلَهُ","في كُلِّ أَمرٍ مُستَنيرٍ ساطِعِ",26,"ع",1,0],["وَبَشَّرَتِ السَماءُ الأَرضَ لَمّا","تَحَدَّثنا بِإِقبالِ الإِمامِ",27,"م",1,0],["وَبَشَّرَت بِوَفاةِ اللَيلِ ساجِعَةٌ","كَأَنَّها في غَديرِ الصُبحِ قَد سَبَحَت",28,"ت",1,0],["وَبِشُعلَةٍ نَبذٍ كَأَنَّ قَليلَها","في صَهوَتَيهِ بَدءُ شَيبِ المَفرِقِ",29,"ق",1,0],["وَبِشرٌ وَهِندٌ ثُمَّ سَعدٌ وَوامِقٌ","وَتَوبَةُ أَضناهُ الهَوى المُتَقَسِّمُ",30,"م",1,0],["وَبَشَّرونا بِما سَنَّ الرَئيسُ لَنا","مِن شِرعَةٍ ذاتِ تِبيانٍ وَتَفصيلِ",31,"ل",1,0],["وبَشِّرْ رعاكَ اللَّهُ صحبَكَ أنّهم","أصابوه غُنماً من هُدى اللهِ وافرا",32,"ر",2,0],["وَبِشَعبٍ بذلَ الروحَ وَمِن","يُنشد الملكَ وَطيداً يَبذُلِ",33,"ل",1,0],["وَبَشَّرَت أَرضُنا السَماءَ بِهِ","وَسَرَّ أَهلَ القُبورِ ما عَقَبا",34,"ب",2,0],["وَبِشرَهُمُ خَدَعاً وَفَقرَهُم غِنىً","وَعِلَمَهُم جَهلاً وَحِكمَتَهُم زَرقا",35,"ق",2,0],["وَبِشِعْرٍ لاَ يُطْرَفُ الجَفْنُ فِيهِ","صَادِرٍ عَنْ حَمِيَّةٍ وَاعْتقَادِ",36,"د",1,0],["وَبَشَاشَةُ الإِيمَانِ فِي قَسَمَاتِهِ","تُثْنِي إِلى الإيمَانِ قَلْبَ الْمُلْحِد",37,"د",1,0],["وَبَشِيرُ الصَّبَاحِ يُدْلِي الشُّعَاعَا","نَاشِراً رَايَاتِ الضِّيَاءِ تِبَاعَا",38,"ع",2,0],["وبشاعرِ الغيد ابن","مخزومٍ ونابغةِ القريض",39,"ض",1,0],["وبشّر الزهر بأخت الزّهْرِ واطربْ وانشدِ","وانقل إِلى الفَرقَدِ ما نمنمتهُ عن فَرْقَدى",40,"د",2,0],["وبَشَاشَةُ الدُّنيا إذا ما أقْبَلَتْ","ونجاةُ وَعْدٍ مِنْ أَكُفِّ وَعِيدِ",41,"د",1,0],["وبشرى لملك قد طلعت بأفقه","هلالا له سير إلى رتبة البدر",42,"ر",1,0],["وبشرها الأملاك أن وليدها","إمام النبيئين الكرام أولي العزم",43,"م",1,0],["وبشَّرْ بحُلْو \" الْجَنى \" كادحا","على \" الجِذر \" من شَجر يَضرِب",44,"ب",1,0],["وبشّرني بالفوز يا أمُّ أنها","على العلم تُبنى في حِماكِ الدعائم",45,"م",1,0],["وَبِشَيبة الصَديق صا","حب كل فَضل أَبهَجِ",46,"ج",1,0],["وَبش وَجه زَمان أَنتَ رَونَقَهُ","وَاِعتاضَ حسن شَباب مِنكَ عَن هَرَم",47,"م",1,0],["وبشكره أنميته بجماعة","درراً هواها هوى لنا متنظما",48,"م",2,0],["وبشمخون بآناف مروضة","على التمرغ في أعتاب جبار",49,"ر",1,0],["وَبشيخي أستَمسَكتُ أحمَدَ قُطبِ ال","أَرضِ مَن شَأنُه الإِلَهِىُّ شَانُ",50,"ن",1,0],["وبَشِّرهُ بِأَنَّ له مَقَاماً","عَظِيماً أعجَزَ الناسَ العِظَامَا",51,"م",2,0],["وَبشرٌ كَلَمعِ البارِق المُبتَسِمِ","وَحِلمُ حَليمٍ لَيسَ بِالمُتَحَلِّمِ",52,"م",1,0],["وبشرني بالحفظ حياً وميتاً","فقلت اشهدوا قال أشهدوا أنه منا",53,"ن",2,0],["وبشراك قد أدركت ما كنت ترتجي","فدونَك ما ترجوه مني وأرحبُ",54,"ب",1,0],["وبشرتني بنعما منك تطرقني","عما قريب وخيرات على عجل",55,"ل",1,0],["وَبَشَّرتُ أَهلي بِالغِنى حَيثُ مَرجِعي","إِلَيهِم عَلى أَنفٍ مِنَ الدَهرِ راغِمِ",56,"م",1,0],["وَبَشائرُ التاريخ تَهتفُ حَولَهُ","طُوبَى لِمَن بِالرَبِّ كانَ مَماتُهْ",57,"ت",2,0],["وَبشّرَ نَسطوراً بهِ ونظيرهُ","بَحيرا وكلٌّ كان في علمه بحرا",58,"ر",2,0],["وَبشّرتِ التوارةُ قوماً فأجحَفوا","وَلَو كانَ موسى والمسيحُ تخلّفوا",59,"ف",3,0],["وَبشهبٍ حمراء أشرقتِ الغب","راءُ لمّا رمتهمُ الخضراءُ",60,"ا",2,0],["وبِشركَ بشرّني بالمنى","وحُسنُ اللقاء افتتاحُ الكرَم",61,"م",1,0],["وبشراك قد وليت اشرف منصب","وبالصبر قد نلت المثوبة والاجرا",62,"ر",2,0],["وَبِشَعري عَقَدتِهِ وَعَلى عَي","ني طَبَعتِ اِبتِسامَةً لا تَغيبُ",63,"ب",1,0],["وبَشَّرتَ ترغيباً وأنذرتَ خَشْيةً","بإيجاز قولٍ ما حواه نذِيرُ",64,"ر",1,0],["وَبِشَيْخِكُمْ ذِي الْمَآثِرِ مَسْعُو","دِ الْفِلاَلِي مَا لَهُ أَكْفَاءُ",65,"ا",2,0],["وَبِشَيْخِهِ سَيِّدِي الْغَازِي غَازِي","جَيْشَ أَشْجَانِ مَنْ غَزَاهُ البَلاَءُ",65,"ا",2,0],["وَبَشَّرَهُ بِأَنْ سَيَنَالُ غَرْساً","بِدَارِ الْخُلْدِ مُخْضَرَّ الْفُنُونِ",66,"ن",1,0],["وبشعر الحسين غنوا المطايا","فبمعناه تنشط الأظعان",67,"ن",1,0],["وبشير العطاء في جهه البشر","ضحى والمنوع يضحى عبوسا",68,"س",2,0],["وبشِّي لذكرِ الموتِ فالموتُ راحةٌ","ولا تؤمني من بعده بالعواقب",69,"ب",1,0],["وَبشرنا المَسيح به رَسولا","وَحقق وَصفه وَسما وكنى",70,"ن",2,0],["وَبشرنا موسى وَعيسى بن مَريَم","به ومن الاحبار من قرأ الكُتبا",71,"ب",2,0],["وَبِشْرٌ إِلى الزُّوّارِ فِي كُلِّ لَزْبَةٍ","بِهِ تُلْقَحُ الآمالُ وَهْيَ حِيالُ",72,"ل",1,0],["وَبشَّر طيفُها بالوَصل لَيلاً","ووافاني يَقول لكَ البِشارَه",73,"ر",2,0],["وَبشرقيَّ الحِمى من ضارِجٍ","بَدرُ حُسنٍ منه في البدر شَبَه",74,"ب",2,0],["وبشره في العقبى بسكنى جهنم","وحرمان جنات الخلود ورؤية",75,"ه",1,0],["وَبَشّرَ الرَّوضَ عنه وهْو مُبتَسِمٌ","ثَغْرٌ من البَرِقِ لولا الرَّعْدُ ما نَطَقا",76,"ق",2,0],["وَبَشيرُ الرُضوانِ قَد قالَ اِرخِ","جاءَ في عَدنِ حَظِّ مَحمودٍ كامِلِ",77,"ل",1,0],["وَبَشيرُ حَظواهُ هُنا","يَسعى إِلَيهِ وَلا يَني",78,"ن",2,0],["وَبَشِّر أَنَّ مَولانا المُفَدّى","عَزيزَ القُطرِ مَلجَأُنا الوَحيدُ",79,"د",1,0],["وَبَشَّرَتني بِلُقْيا الطَّيْفِ قُلتُ ومَنْ","يَنامُ قَالتْ لَقَدْ أَجمَلْت في الَّطلَبِ",80,"ب",1,0],["وَبَشير الخَير نادى مُنشِداً","لا تَقل بُشرى وَلَكن بشريانِ",81,"ن",1,0],["وَبِشُكر اللَهِ نجم الرَوض وَالش","شجر الناضر قاما يَسجُدانِ",81,"ن",1,0],["وَبشرٌ بِهِ نجب البَشائر أَقبَلَت","فَيا حَبَّذا ما حُمِّلته نَجائبُه",82,"ب",2,0],["وبشِّر الناقِصَ بِالكَمالِ","فَعادَتِ الدُنيا إِلى اِعتِدالِ",83,"ل",1,0],["وبشَّر زائِريه منه بِشْرٌ","له احتقَر النّوالَ مَنِ اسْتَنالا",84,"ل",2,0],["وَبشحارٍ زَخَرَت في خاطِري","وَلهاني لَيسَ فيها مِن بَلَل",85,"ل",1,0],["وبشادٍ يُشيدُ صوتاً رخيماً","سَبِّحوا سَبِّحوا إلهاً جليلا",86,"ل",2,0],["وبشارة من صادق","قرت بها منا النواظر",87,"ر",1,0],["وبشيرٌ لمليكٍ همُّهُ","أنْ يرى النَّاس وما فيهم فقير",88,"ر",1,0],["وبشرتني فيه فقلت مؤرخاً","بمولد عبد الله نلت البشايرا",89,"ر",2,0],["وبِشُربها أضحى الخليلُ منادِما","فعهودُها عند الإله صحاحُ",90,"ح",1,0],["وبشِعْبِ رامَةَ مَعْرَكٌ يغدُو بِهِ","قَلْبُ الهِزَبْرِ أَسيرِ لَحْظِ الرِّيمِ",91,"م",1,0],["وبشَّرَهُ التَّأْمِيلُ منكَ بعَطْفَةٍ","تلقَّى بِهَا رَوْحَ الحياةِ تَنَسُّما",92,"م",2,0],["وبَشَّرَ بالفتحِ المُبينِ افْتِتاحُهُ","وأَحْرَزَتِ الصُّنعَ الجليلَ عواقِبُهْ",93,"ب",2,0],["وبشراكِ باستقبالِ أَرضٍ حَياتُها","بما فِي اسمِهِ من صادِقِ الظَّنِّ والفالِ",94,"ل",1,0],["وبُشْرَى أَخْلَّ بِهَا الشاكرونَ","إِلَى من فُجِعْنا من الأَقْرَبِينا",95,"ن",2,0],["وبَشَّرَني مِنْ قَبْلِهِ صَوْتُ حَلْيِهِ","تُجاوِبُهُ فَوْقَ الغصونِ الحمائِمُ",96,"م",1,0],["وَبُشرَاكِ قَدْ فازَتْ قِداحُكَ بالمُنى","وأُعطِيت من هَذَا الأَنامِ خِيارَكِ",97,"ك",1,0],["وبشّر بالأحلام حتى تفتقت","لنشوتها الأحلام أضعافها نغمى",98,"م",2,0],["وبشَّرها بالجبال الحصا","وكانت جبالا وكنا العُصُمْ",99,"م",1,0],["وبشرُ وجه لو سكبتَ ماءَه","في كأسه حسبته جِريالَه",100,"ل",2,0],["وبشّرتْك ماضياتُ فِقَرى","بأنه يكون في استقبالها",101,"ل",3,0],["وبشَّر الفضلُ بقايا أهلِهِ","لا تقنطوا في الناسِ