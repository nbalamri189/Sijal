{"poems":[[53,"أسائل سيفي أي بارقة تجدي","https://www.aldiwan.net/poem30621.html","الطويل"],[53,"أودع في كل يوم حبيبا","https://www.aldiwan.net/poem30733.html","المتقارب"],[63,"ترنح من برح الغرام مشوق","https://www.aldiwan.net/poem46136.html","الطويل"],[77,"إذا أنا لم أوثر هواي على عزمي","https://www.aldiwan.net/poem36126.html","الطويل"],[77,"هنيئا بما خولت من رفعة القدر","https://www.aldiwan.net/poem36504.html","الطويل"],[77,"دعاها تشم آثار نجد ففي نجد","https://www.aldiwan.net/poem36603.html","الطويل"],[77,"هي أسعد ما دونهن حجاب","https://www.aldiwan.net/poem36780.html","الطويل"],[86,"أطل على الأكوان والخلق تنظر","https://www.aldiwan.net/poem10689.html","الطويل"],[86,"بنات الشعر بالنفحات جودي","https://www.aldiwan.net/poem10690.html","الوافر"],[73,"أما في نسيم الريح عرف معرف","https://www.aldiwan.net/poem11914.html","الطويل"],[73,"أما علمت أن الشفيع شباب","https://www.aldiwan.net/poem11916.html","الطويل"],[73,"ليهن الهدى إنجاح سعيك في العدا","https://www.aldiwan.net/poem11949.html","الطويل"],[93,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[83,"سلام على الدنيا جميعا وما فيها","https://www.aldiwan.net/poem54233.html","الطويل"],[83,"هناء له ثغر الهدى يتبسم","https://www.aldiwan.net/poem54244.html","الطويل"],[72,"تعشقته ظبي الكناس إذا عطا","https://www.aldiwan.net/poem19139.html","الطويل"],[51,"قدمت قدوم البدر بيت سعوده","https://www.aldiwan.net/poem61823.html","الطويل"],[51,"سوءة للدهر إذ يخلط","https://www.aldiwan.net/poem62851.html","مجزوء الرمل"],[51,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[91,"عصفت ريح الندى بالمشعل فخبا","https://www.aldiwan.net/poem8756.html","عموديه"],[91,"يا ليتني لص لأسرق في الضحى","https://www.aldiwan.net/poem8846.html","عموديه"],[70,"خاف الرسول من الملامه","https://www.aldiwan.net/poem42701.html","مجزوء الكامل"],[70,"رسول الرضا أهلا وسهلا ومرحبا","https://www.aldiwan.net/poem43022.html","الطويل"],[85,"بين الملامة فيكم والهوى الجلل","https://www.aldiwan.net/poem6819.html","البسيط"],[85,"تحية عمرو لك بل عمر","https://www.aldiwan.net/poem7129.html","المتقارب"],[62,"أيا حادي الأظعان غرد فقد بدا","https://www.aldiwan.net/poem52444.html","الطويل"],[45,"إن الحكيم له مقال سائر","https://www.aldiwan.net/poem65137.html","الكامل"],[28,"ألستم عائجين بنا لعنا","https://www.aldiwan.net/poem5607.html","الوافر"],[66,"يا نسمة لأحاديث الحمى شرحت","https://www.aldiwan.net/poem41359.html","البسيط"],[44,"يا برق طالع منزلا بالأبرق","https://www.aldiwan.net/poem30397.html","الكامل"],[33,"أنا الوامق المشغوف والله ناصري","https://www.aldiwan.net/poem25825.html","الطويل"],[105,"حيوا الهلال وحيوا أمة النيل","https://www.aldiwan.net/poem43087.html","البسيط"],[105,"بني عامر ردوا عن الشر عامرا","https://www.aldiwan.net/poem44014.html","الطويل"],[102,"شيعي الليل وقومي استقبلي","https://www.aldiwan.net/poem32992.html","الرمل"],[50,"يا صاحبي العشية احتسبا","https://www.aldiwan.net/poem64817.html","المنسرح"],[46,"يباين شكل غيره في حياته","https://www.aldiwan.net/poem23032.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54700","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54674","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142014","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141957","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[77,"هنيئا بما خولت من رفعة القدر","https://www.poetsgate.com/ViewPoem.aspx?id=34123",""],[77,"إذا أنا لم أوثر هواي على عزمي","https://www.poetsgate.com/ViewPoem.aspx?id=34203",""],[90,"إلى المناضلين","https://www.poetsgate.com/ViewPoem.aspx?id=179212",""],[94,"عروس المشرقين","https://www.poetsgate.com/ViewPoem.aspx?id=15591",""]],"verses":[["وَبَشَّرَ بِهِ البَيضَ الصَوارِمَ وَالقَنا","وَبَشَّرَهُ عَن قَولِ النَوائِبِ بِالجَلدِ",0,"د",1,0],["وَبِشرٌ يُهابُ عَلى حُسنِهِ","فَتَحسَبُهُ غَضباً أَو قُطوبا",1,"ب",2,0],["وبِشْرٌ يَلوحُ الجُودُ منه وهَيْبَةٌ","تَروعُ لِحاظَ المُجْتَلي وتَروقُ",2,"ق",1,0],["وَبَشَّرَهَا الأَمْلاَكُ أَنَّ وَلِيدَهَا","إِمَامُ النَّبِئِينَ الْكِرَامِ أُولِي الْعَزْمِ",3,"م",1,0],["وبُشْرى بمُلْكٍ قدْ طلَعْتَ بأفْقِهِ","هِلالاً لهُ سيْرٌ الى رُتْبَةِ البَدْرِ",4,"ر",1,0],["وبُشْرى لأرْضٍ قد سَلَكْتَ بأهْلِها","منَ السَّنَنِ الأرْضى على واضِحِ القَصْدِ",5,"د",1,0],["وَبَشائِر ٌتَصِلُ النُّفُوسَ كَأَنَّمَا","بَيْنَ النُّفُوسِ وَبَيْنَهَا أَنْسَابُ",6,"ب",1,0],["وَبَشَّرَهُم مِن وَجهِهِ وَجَبينِهِ","وَغُرَّتِهِ وَالناظِرينَ مُبَشِّرُ",7,"ر",1,0],["وَبَشَّرَ أَهلَ مِصرٍ بِاِحتِلالٍ","يَدومُ عَلَيهِمُ أَبَدَ الأَبيدِ",8,"د",1,0],["وَبُشراكَ عيدٌ بِالسُرورِ مُظَلَّلٌ","وَبِالحَظِّ في نَيلِ المُنى مُتَكَنَّفُ",9,"ف",1,0],["وَبُشراكَ أَعيادٌ سَيَنمي اِطِّرادُها","كَما اِطَّرَدَت في السَمهَرِيِّ كِعابُ",10,"ب",1,0],["وَبُشراكَ دُنيا غَضَّةُ العَهدِ طَلقَةٌ","كَما اِبتَسَمَ النُوّارُ عَن أَدمُعِ النَدى",11,"د",2,0],["وَبَشَّرَتْ آيَةٌ لِلحَقِّ ظَاهِرَةٌ","بِوَحْدَةٍ لِخُصُومِ الحَقِّ لَمْ تَطِبِ",12,"ب",1,0],["وبُشْرى لنا أن السعادة نُزْلُها","وأنّ رضا الله الكريم يُرضّيها",13,"ي",3,0],["وبشرى بعيد الفطر أيمن قادم","عليك بمجموع البشائر يَقْدّمُ",14,"م",1,0],["وبشرٌ لدى العافين أحلى من المنى","ورأيٌ إلى العلياء أهدى من القطا",15,"ط",2,0],["وبشرى من البِشْرِ الجميل فلم يزل","يبشّر بالصبْح انبلاجُ عمودِهِ",16,"د",2,0],["وبشيرٌ بلقاءٍ","منكُمُ أيمنُ طيرِه",17,"ر",2,0],["وبشيرُ من عاملْتَه ونذيرُهُ","في حالتَيْك تبسُّمٌ وتبسُّلُ",18,"ل",1,0],["وَبُشاشاتُ الزَمانِ الأَوَّل وَالصِبا","يا رَبيعاً مِن وَفاء وَكَرَم في بَدَن",19,"ن",1,0],["وَبَشاشَةُ المَرجِ الخَصيب وَوَحشَةُ","الوادي الكَئيب وَصَولَةُ التَيّارِ",20,"ر",1,0],["وَبِشامَةٍ في خَدِّهِ","أَصبَحتُ في العُشّاقِ شامَه",21,"م",2,0],["وَبَشَّرتَ بِاليَومِ الَّذي فيهِ نَلتَقي","أَلا إِنَّهُ يَومٌ يَكونُ لَهُ نَبا",22,"ب",2,0],["وبشرتني المنى فيما تحدثني","بمظهر لسرير النيل مقتبل",23,"ل",1,0],["وبشرها بك خفق الريا","ح وبعد الرياح يكون المطر",24,"ر",1,0],["وبشَّرنا وعدٌ من المُزْنِ صادقٌ","بواصٍ من الحَوذَانِ والنَّفَلِ الجَعْدِ",25,"د",1,0],["وَبِشاهِدٍ يَتلوهُ عَدلٌ مِثلَهُ","في كُلِّ أَمرٍ مُستَنيرٍ ساطِعِ",26,"ع",1,0],["وَبَشَّرَتِ السَماءُ الأَرضَ لَمّا","تَحَدَّثنا بِإِقبالِ الإِمامِ",27,"م",1,0],["وَبَشَّرَت بِوَفاةِ اللَيلِ ساجِعَةٌ","كَأَنَّها في غَديرِ الصُبحِ قَد سَبَحَت",28,"ت",1,0],["وَبِشُعلَةٍ نَبذٍ كَأَنَّ قَليلَها","في صَهوَتَيهِ بَدءُ شَيبِ المَفرِقِ",29,"ق",1,0],["وَبِشرٌ وَهِندٌ ثُمَّ سَعدٌ وَوامِقٌ","وَتَوبَةُ أَضناهُ الهَوى المُتَقَسِّمُ",30,"م",1,0],["وَبَشَّرونا بِما سَنَّ الرَئيسُ لَنا","مِن شِرعَةٍ ذاتِ تِبيانٍ وَتَفصيلِ",31,"ل",1,0],["وبَشِّرْ رعاكَ اللَّهُ صحبَكَ أنّهم","أصابوه غُنماً من هُدى اللهِ وافرا",32,"ر",2,0],["وَبِشَعبٍ بذلَ الروحَ وَمِن","يُنشد الملكَ وَطيداً يَبذُلِ",33,"ل",1,0],["وَبَشَّرَت أَرضُنا السَماءَ بِهِ","وَسَرَّ أَهلَ القُبورِ ما عَقَبا",34,"ب",2,0],["وَبِشرَهُمُ خَدَعاً وَفَقرَهُم غِنىً","وَعِلَمَهُم جَهلاً وَحِكمَتَهُم زَرقا",35,"ق",2,0],["وَبِشِعْرٍ لاَ يُطْرَفُ الجَفْنُ فِيهِ","صَادِرٍ عَنْ حَمِيَّةٍ وَاعْتقَادِ",36,"د",1,0],["وَبَشَاشَةُ الإِيمَانِ فِي قَسَمَاتِهِ","تُثْنِي إِلى الإيمَانِ قَلْبَ الْمُلْحِد",37,"د",1,0],["وَبَشِيرُ الصَّبَاحِ يُدْلِي الشُّعَاعَا","نَاشِراً رَايَاتِ الضِّيَاءِ تِبَاعَا",38,"ع",2,0],["وبشاعرِ الغيد ابن","مخزومٍ ونابغةِ القريض",39,"ض",1,0],["وبشّر الزهر بأخت الزّهْرِ واطربْ وانشدِ","وانقل إِلى الفَرقَدِ ما نمنمتهُ عن فَرْقَدى",40,"د",2,0],["وبَشَاشَةُ الدُّنيا إذا ما أقْبَلَتْ","ونجاةُ وَعْدٍ مِنْ أَكُفِّ وَعِيدِ",41,"د",1,0],["وبشرى لملك قد طلعت بأفقه","هلالا له سير إلى رتبة البدر",42,"ر",1,0],["وبشرها الأملاك أن وليدها","إمام النبيئين الكرام أولي العزم",43,"م",1,0],["وبشَّرْ بحُلْو \" الْجَنى \" كادحا","على \" الجِذر \" من شَجر يَضرِب",44,"ب",1,0],["وبشّرني بالفوز يا أمُّ أنها","على العلم تُبنى في حِماكِ الدعائم",45,"م",1,0]]}