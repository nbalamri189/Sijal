{"poems":[[53,"ألوي حيازيمي عليك تحرقا","https://www.aldiwan.net/poem29950.html","الطويل"],[53,"يا قلب جدد كمدا","https://www.aldiwan.net/poem30611.html","مجزوء الرجز"],[63,"نهج الثناء إلى ناديك مختصر","https://www.aldiwan.net/poem46122.html","البسيط"],[55,"إذا اهتجرنا نهانا عن تهاجرنا","https://www.aldiwan.net/poem26295.html","البسيط"],[77,"إذا أهدي الإنسان وردة جنة","https://www.aldiwan.net/poem35850.html","الطويل"],[77,"محلك بالدنيا وبالدين معمور","https://www.aldiwan.net/poem36488.html","الطويل"],[85,"سقى الله بالكفر الأباظي مضجعا","https://www.aldiwan.net/poem8107.html","الطويل"],[45,"حذرت الحب لو أغنى حذاري","https://www.aldiwan.net/poem63588.html","الوافر"],[45,"حبيب سرى في خفية وعلى ذعر","https://www.aldiwan.net/poem63632.html","الطويل"],[105,"هو الحكم أمضته السيوف القواطع","https://www.aldiwan.net/poem43054.html","الطويل"],[105,"ذراني أقم للشعر في مصر مأتما","https://www.aldiwan.net/poem43370.html","الطويل"],[46,"أرادوا الشر وانتظروا إماما","https://www.aldiwan.net/poem23606.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85359","المجتث"],[45,"حَذَرْتُ الحُبّ، لَوْ أغْنى حِذاري","https://www.poetsgate.com/ViewPoem.aspx?id=31337",""],[170,"رويداً بعض نوحك يا حمام","https://www.aldiwan.net/poem1677.html",""],[183,"سلام من محب مستهام","https://www.aldiwan.net/poem67016.html","الوافر"],[205,"جعلت فداك من بؤس وضر","https://www.aldiwan.net/poem53090.html","الوافر"],[262,"عليل هوي الأحبة لن يعادا","https://www.aldiwan.net/poem38335.html","الوافر"],[281,"أبا حسن أنت أهل الجميل","https://www.aldiwan.net/poem60592.html","المتقارب"],[281,"أرى العلياء واضحة السبيل","https://www.aldiwan.net/poem60777.html","الطويل"],[365,"إذا لم يخن صب ففيم عتاب","https://www.aldiwan.net/poem61000.html","الطويل"],[367,"وبات يحييني على رغم كاشح","https://www.aldiwan.net/poem17138.html","الطويل"],[422,"تضيق بنا الدنيا إذا غبتمعنا","https://www.aldiwan.net/poem46402.html","الطويل"],[433,"تهز بك الخطوب من الخطاب","https://www.aldiwan.net/poem12383.html","الوافر"],[438,"إذا اهتز للجدوى اهتزاز مهند","https://www.aldiwan.net/poem2498.html","الطويل"],[465,"نسيم الصبا والليل منتظم العقد","https://www.aldiwan.net/poem3176.html","عموديه"]],"verses":[["إِذا اِهتَزَّ مِن خَلفِ السَنانِ حَسِبتَهُ","بِأَعلى النِجادِ الأَرقَمَ المُتَشَدِّقا",0,"ق",2,0],["إِذا اِهتَدى بِنارِهِم","طارِقُ لَيلٍ ما اِهتَدى",1,"د",2,0],["إذا أهَبْتُ بهِ والحَرْبُ لاقِحَةٌ","روّى القَنا مِنْ أعادِيكَ الدّمُ الهَدَرُ",2,"ر",1,0],["إِذا اِهتَجَرنا نَهانا عَن تَهاجُرِنا","مِنَ القُلوبِ شَقيقٌ حينَ نَهتَجِرُ",3,"ر",1,1],["إذا أُهْدِيَ الإنسانُ ورْدَةَ جنّةٍ","تهلّلَ منْ بعْدِ العُبوسِ مُحيّاهُ",4,"ه",1,1],["إذا اهْتزّ في روْضِ المَهارِقِ غُصْنُهُ","تَساقَطَ منْظومُ البَيانِ ومنثورُ",5,"ر",1,0],["إِذا اِهتَزَّ دونَ الحَقِّ يَحمي حِياضَهُ","تَأَخَّرَ عَنها باطِلُ القَومِ ظامِيا",6,"ي",2,0],["إِذا أَهوى لِمَرقِدِهِ بِلَيلٍ","فَيا خَزيَ البَراذِعِ وَالسَراري",7,"ر",2,0],["إِذا اِهتَزَّ غِبَّ الأَريَحِيَّةِ وَالنَدى","وَأَسفَرَ في ضَوءِ الطَلاقَةِ وَالبِشرِ",8,"ر",1,0],["إذا اهتزَّ فالدُّنيا قلوبٌ وأهلُها","عُيونٌ وأقطارُ السّماءِ مَسامعُ",9,"ع",1,0],["إِذا اِهتَزَمَت فيها الرَزايا حَسِبتَها","تُشَقِّقُ صَخّاباً مِنَ الرَعدِ مُرزِما",10,"م",2,0],["إِذا أَهلُ الدِيانَةِ لَم يُصَلوا","فَكُلُّ هُدىً لِمَذهَبِهِم أَبِيُّ",11,"ب",2,0],["إِذا أهين لَبيب","بالسب قال سلاما",12,"م",2,0],["إذَا أهْوى لِمَرْقَدِهِ بِلَيْلٍ،","فَيَا خِزْيَ البرَاقَعِ وَالسّرَاري",13,"ر",2,0],["إِذا أَهلُ المَكارِمِ ضَيَّعُوها","فَأَنتَ لِكُلِّ مَكرُمَةٍ نِظامُ",14,"م",1,0],["إِذا أَهدى لَكُم يَوماً سَلاماً","فَلَيسَ سَلامُهُ بِأَرَقَّ مِنهُ",15,"ه",1,0],["إذا أهدى الهديَّةَ مبتديها","فإسراعُ المُكافئِ ضِيقُ صَدرِ",16,"ر",1,0],["إذا اهتز الكريم له ارتياحاً","به انتفض ارتعاشا وارتعادا",17,"د",2,0],["إِذا أُهْدِيَتْ وَهْيَ صِفْرٌ رَأَيْ","تَ صُورَةَ مُتْأَقَةٍ مُفْعَمَهْ",18,"م",2,0],["إِذا أَهْلُ الثَّناءِ عَلَيْكَ أَثْنَوا","فَسِرْ فِي الْمَكْرُماتِ بِلا دَلِيلِ",19,"ل",1,0],["إذا اهتزّ رمْحٌ قال راوغَ ثعلبٌ","وإن صَلّ سَيْفٌ قال طَنّ ذباب",20,"ب",1,0],["إِذا اِهتَزَّ في حَلي وَقَبَّلَ ثَغرَهُ","مُحِبٌّ فَسُقياهُ سَقاهُ وَغَنّاهُ",21,"ا",2,0],["إذا اهتزَّت الأرواح شوقاً إلى اللقا","ترفصت الأشباح يا جاهلَ المعنى",22,"ن",2,0],["إِذا أُهَبُ القتال تناقَلُوها","أَقَلُّوها أَخَفَّ من الإِهابِ",23,"ب",1,0],["إذا اهتزّ للجدوى اهتزاز مهنّد","فأيّة وفرٍ لم يذل بالندى الوفر",24,"ر",1,1],["إذا اهتز في يومي سماح وسطوةِ","فأي محل للحيا وظبى الهند",25,"د",1,0]]}