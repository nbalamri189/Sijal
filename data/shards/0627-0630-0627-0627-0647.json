{"poems":[[55,"ألوي حيازيمي عليك تحرقا","https://www.aldiwan.net/poem29950.html","الطويل"],[55,"يا قلب جدد كمدا","https://www.aldiwan.net/poem30611.html","مجزوء الرجز"],[65,"نهج الثناء إلى ناديك مختصر","https://www.aldiwan.net/poem46122.html","البسيط"],[57,"إذا اهتجرنا نهانا عن تهاجرنا","https://www.aldiwan.net/poem26295.html","البسيط"],[79,"إذا أهدي الإنسان وردة جنة","https://www.aldiwan.net/poem35850.html","الطويل"],[79,"محلك بالدنيا وبالدين معمور","https://www.aldiwan.net/poem36488.html","الطويل"],[87,"سقى الله بالكفر الأباظي مضجعا","https://www.aldiwan.net/poem8107.html","الطويل"],[47,"حذرت الحب لو أغنى حذاري","https://www.aldiwan.net/poem63588.html","الوافر"],[47,"حبيب سرى في خفية وعلى ذعر","https://www.aldiwan.net/poem63632.html","الطويل"],[107,"هو الحكم أمضته السيوف القواطع","https://www.aldiwan.net/poem43054.html","الطويل"],[107,"ذراني أقم للشعر في مصر مأتما","https://www.aldiwan.net/poem43370.html","الطويل"],[48,"أرادوا الشر وانتظروا إماما","https://www.aldiwan.net/poem23606.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85359","المجتث"],[47,"حَذَرْتُ الحُبّ، لَوْ أغْنى حِذاري","https://www.poetsgate.com/ViewPoem.aspx?id=31337",""],[173,"رويداً بعض نوحك يا حمام","https://www.aldiwan.net/poem1677.html",""],[186,"سلام من محب مستهام","https://www.aldiwan.net/poem67016.html","الوافر"],[208,"جعلت فداك من بؤس وضر","https://www.aldiwan.net/poem53090.html","الوافر"],[266,"عليل هوي الأحبة لن يعادا","https://www.aldiwan.net/poem38335.html","الوافر"],[285,"أبا حسن أنت أهل الجميل","https://www.aldiwan.net/poem60592.html","المتقارب"],[285,"أرى العلياء واضحة السبيل","https://www.aldiwan.net/poem60777.html","الطويل"],[369,"إذا لم يخن صب ففيم عتاب","https://www.aldiwan.net/poem61000.html","الطويل"],[371,"وبات يحييني على رغم كاشح","https://www.aldiwan.net/poem17138.html","الطويل"],[427,"تضيق بنا الدنيا إذا غبتمعنا","https://www.aldiwan.net/poem46402.html","الطويل"],[438,"تهز بك الخطوب من الخطاب","https://www.aldiwan.net/poem12383.html","الوافر"],[443,"إذا اهتز للجدوى اهتزاز مهند","https://www.aldiwan.net/poem2498.html","الطويل"],[469,"نسيم الصبا والليل منتظم العقد","https://www.aldiwan.net/poem3176.html","عموديه"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96982","المتقارب"],[466,"","https://poetry.dctabudhabi.ae/diwan/poem/63578","البسيط"],[895,"","https://poetry.dctabudhabi.ae/diwan/poem/146013","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59620","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62472","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62503","الوافر"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17021","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100963","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100961","المتقارب"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96036","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109460","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93822","الوافر"],[3447,"","https://poetry.dctabudhabi.ae/diwan/poem/32730","الوافر"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108361",""],[4607,"","https://poetry.dctabudhabi.ae/diwan/poem/132191","الطويل"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67505","الوافر"],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/199661","الطويل"],[5756,"الحلم","https://www.poetsgate.com/ViewPoem.aspx?id=5179",""],[5851,"عودة الهزار","https://www.poetsgate.com/ViewPoem.aspx?id=175281",""],[5956,"لحن الحب","https://www.poetsgate.com/ViewPoem.aspx?id=186141",""],[6147,"جنوني ... بلا مدى.","https://www.poetsgate.com/ViewPoem.aspx?id=151491",""]],"verses":[["إِذا اِهتَزَّ مِن خَلفِ السَنانِ حَسِبتَهُ","بِأَعلى النِجادِ الأَرقَمَ المُتَشَدِّقا",0,"ق",2,0],["إِذا اِهتَدى بِنارِهِم","طارِقُ لَيلٍ ما اِهتَدى",1,"د",2,0],["إذا أهَبْتُ بهِ والحَرْبُ لاقِحَةٌ","روّى القَنا مِنْ أعادِيكَ الدّمُ الهَدَرُ",2,"ر",1,0],["إِذا اِهتَجَرنا نَهانا عَن تَهاجُرِنا","مِنَ القُلوبِ شَقيقٌ حينَ نَهتَجِرُ",3,"ر",1,1],["إذا أُهْدِيَ الإنسانُ ورْدَةَ جنّةٍ","تهلّلَ منْ بعْدِ العُبوسِ مُحيّاهُ",4,"ه",1,1],["إذا اهْتزّ في روْضِ المَهارِقِ غُصْنُهُ","تَساقَطَ منْظومُ البَيانِ ومنثورُ",5,"ر",1,0],["إِذا اِهتَزَّ دونَ الحَقِّ يَحمي حِياضَهُ","تَأَخَّرَ عَنها باطِلُ القَومِ ظامِيا",6,"ي",2,0],["إِذا أَهوى لِمَرقِدِهِ بِلَيلٍ","فَيا خَزيَ البَراذِعِ وَالسَراري",7,"ر",2,0],["إِذا اِهتَزَّ غِبَّ الأَريَحِيَّةِ وَالنَدى","وَأَسفَرَ في ضَوءِ الطَلاقَةِ وَالبِشرِ",8,"ر",1,0],["إذا اهتزَّ فالدُّنيا قلوبٌ وأهلُها","عُيونٌ وأقطارُ السّماءِ مَسامعُ",9,"ع",1,0],["إِذا اِهتَزَمَت فيها الرَزايا حَسِبتَها","تُشَقِّقُ صَخّاباً مِنَ الرَعدِ مُرزِما",10,"م",2,0],["إِذا أَهلُ الدِيانَةِ لَم يُصَلوا","فَكُلُّ هُدىً لِمَذهَبِهِم أَبِيُّ",11,"ب",2,0],["إِذا أهين لَبيب","بالسب قال سلاما",12,"م",2,0],["إذَا أهْوى لِمَرْقَدِهِ بِلَيْلٍ،","فَيَا خِزْيَ البرَاقَعِ وَالسّرَاري",13,"ر",2,0],["إِذا أَهلُ المَكارِمِ ضَيَّعُوها","فَأَنتَ لِكُلِّ مَكرُمَةٍ نِظامُ",14,"م",1,0],["إِذا أَهدى لَكُم يَوماً سَلاماً","فَلَيسَ سَلامُهُ بِأَرَقَّ مِنهُ",15,"ه",1,0],["إذا أهدى الهديَّةَ مبتديها","فإسراعُ المُكافئِ ضِيقُ صَدرِ",16,"ر",1,0],["إذا اهتز الكريم له ارتياحاً","به انتفض ارتعاشا وارتعادا",17,"د",2,0],["إِذا أُهْدِيَتْ وَهْيَ صِفْرٌ رَأَيْ","تَ صُورَةَ مُتْأَقَةٍ مُفْعَمَهْ",18,"م",2,0],["إِذا أَهْلُ الثَّناءِ عَلَيْكَ أَثْنَوا","فَسِرْ فِي الْمَكْرُماتِ بِلا دَلِيلِ",19,"ل",1,0],["إذا اهتزّ رمْحٌ قال راوغَ ثعلبٌ","وإن صَلّ سَيْفٌ قال طَنّ ذباب",20,"ب",1,0],["إِذا اِهتَزَّ في حَلي وَقَبَّلَ ثَغرَهُ","مُحِبٌّ فَسُقياهُ سَقاهُ وَغَنّاهُ",21,"ا",2,0],["إذا اهتزَّت الأرواح شوقاً إلى اللقا","ترفصت الأشباح يا جاهلَ المعنى",22,"ن",2,0],["إِذا أُهَبُ القتال تناقَلُوها","أَقَلُّوها أَخَفَّ من الإِهابِ",23,"ب",1,0],["إذا اهتزّ للجدوى اهتزاز مهنّد","فأيّة وفرٍ لم يذل بالندى الوفر",24,"ر",1,1],["إذا اهتز في يومي سماح وسطوةِ","فأي محل للحيا وظبى الهند",25,"د",1,0],["إذا اهتز من دوحةٍ ساقها","فلا عجب إن تهز العذب",26,"ب",1,0],["إذا اهْتدى بهما سارٍ إلى أملٍ","فالوعْرُ مُستَسْهَلٌ والمُنْتأى أمَمُ",27,"م",1,0],["إذا اهتز للتحرير خلت لسانه","سنان كمي في القتال مماصع",28,"ع",1,0],["إذا اهتاج من برْح الغرام غليله","تداعت شؤون الدمع عنه تُخبر",29,"ر",1,0],["إذا اهتم في أمرٍ تدانى بعيدُه","وباعد عنه مُضعِفاتِ العزائمِ",30,"م",1,0],["إِذا أَهوى مهنّدُه","بهامٍ قدَّهُ شفعا",31,"ع",2,0],["إِذا اِهتَزَّ لِلهَيجاءِ فَهوَ مُهَنَّدٌ","أَوِ اِهتَزَّ لِلإِفضالِ فَهُوَ غَمامُ",32,"م",1,0],["إذا اهتزّ في نصر الحنيف تساقطت","نفوس العدا من حَدّه تتحلّب",33,"ب",1,0],["إذا اهتزّ في طِرسه معجِبا","أذلّ شعوباً وأعلى شعوبا",34,"ب",2,1],["إذا اهتز ناجته القلوب كأنما","يفاوضها عن منطق الطعن أسرارا",35,"ر",2,0],["إذا اهتم بالأمر العظيم أتمه","ولم يتخلل فيه صعبٌ ولا عسر",36,"ر",1,0],["إذا أهملت فيه نثر دمعي","يهيج بلابلي سجع الحمام",37,"م",1,0],["إِذا أَهلُ الرُشا صاروا إِلَيهِ","فَأَحضى القَومِ أَو فَرُهُم بِضاعَه",38,"ع",2,0],["اذا اهتز ان يندي المكارم والندى","هو الودق يبدو من خلال نواله",39,"ل",2,0],["إذا اهتز غنى حليه فوق نحره","كغصن النقا غنت عليه سواجعه",40,"ع",2,0],["إذا أهل الرشا صاروا إليه","فاحظى القوم أوفرهم بضاعه",41,"ع",2,0],["إذا أهدرت أشداقها كفها الحيا","فمالي وقد أحسنت إلا التشدق",42,"ق",1,0],["إذا أهداك الزهر مره،فأنا اهديتك بساتينه","وإذا ألهاك بفرح ليله، فانا تهت لبكاك سنين",43,"ن",1,0],["إذا أهيلي استباحوا دمعتي ودمي","وفي المواجع كانوا اللحد والكفنا",44,"ن",2,0],["إذا اهتممتُ بنفسي وادَّخَرْتُ لها","فإنما لجميع الخَلْقِ مُدَّخَري",45,"ر",2,0],["إذا اهتز ثلجُ الارض هاجت ملاهِبي","وعَجّتْ مع النيران غمْرًا يُحَمّيها",46,"ي",3,0]]}