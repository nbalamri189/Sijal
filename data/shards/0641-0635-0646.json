{"poems":[[53,"عطفا بني وهب علي","https://www.aldiwan.net/poem66309.html","مجزوء الكامل"],[64,"لمثل معاليك تعنو الرقاب","https://www.aldiwan.net/poem52473.html","المتقارب"],[51,"لقد هان على الناس","https://www.aldiwan.net/poem62126.html","البسيط"],[46,"جعلت فداك أنت من لا ندله","https://www.aldiwan.net/poem30370.html","الطويل"],[46,"أقشيب ربعهم أراك دريسا","https://www.aldiwan.net/poem30481.html","الكامل"],[107,"وجدنا الحق عندك والصوابا","https://www.aldiwan.net/poem42096.html","الوافر"],[50,"أأدميت بالماء القراح جبينها","https://www.aldiwan.net/poem65302.html","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/1232","الكامل"],[121,"دمشق","https://www.aldiwan.net/poem24043.html","الوافر"],[124,"ما أنس لا أنس أياما نعمت بها","https://www.aldiwan.net/poem49318.html","البسيط"],[164,"ما الفخر في الطعن بالعسالة الذبل","https://www.aldiwan.net/poem58998.html","البسيط"],[266,"قفي ربة الوقف والدملج","https://www.aldiwan.net/poem38353.html","المتقارب"],[276,"كلام بلا نحو طعام بلا ملح","https://www.aldiwan.net/poem52102.html","الطويل"],[354,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[369,"دع العين مني تسكب الدمع أو تفنى","https://www.aldiwan.net/poem60624.html","الطويل"],[409,"أشير وإن كنت لا تقبلا","https://www.aldiwan.net/poem34176.html","المتقارب"],[411,"أحمد ربي على ضياء","https://www.aldiwan.net/poem49428.html","مخلع البسيط"],[412,"أتروم تغطية الهوى بجحوده","https://www.aldiwan.net/poem50187.html","الكامل"],[443,"إذا اهتز للجدوى اهتزاز مهند","https://www.aldiwan.net/poem2498.html","الطويل"],[445,"هو البدر في فلك المجد دارا","https://www.aldiwan.net/poem34793.html","المتقارب"],[447,"أما من بني حوا خليل محالم","https://www.aldiwan.net/poem14383.html","الطويل"],[463,"لمن ظعن سوائر لو","https://www.aldiwan.net/poem55846.html","مجزوء الوافر"],[463,"يلوم عليك لا عدم الملامه","https://www.aldiwan.net/poem55898.html","الوافر"],[469,"جد بقلبي وهزل","https://www.aldiwan.net/poem3313.html","عموديه"],[473,"يا أخا لا يمر حلو الإخاء","https://www.aldiwan.net/poem60521.html","الخفيف"],[518,"علام وقد أذبت القلب شوقا","https://www.aldiwan.net/poem67709.html","الوافر"],[591,"بلا غيبة للبدر وجهك أجمل","https://www.aldiwan.net/poem18010.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122779","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86870","الطويل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104565","الطويل"],[173,"","https://poetry.dctabudhabi.ae/diwan/poem/29577","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64709","الكامل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26426","المتقارب"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125477","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53163","الرجز"],[2406,"","https://poetry.dctabudhabi.ae/diwan/poem/100115","الطويل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102545","الوافر"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76145","الطويل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112581","المتقارب"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132601","الطويل"],[3124,"","https://poetry.dctabudhabi.ae/diwan/poem/141746","الخفيف"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99400","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86313","الطويل"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199156","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205692",""],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199022","الرجز"],[3768,"","https://poetry.dctabudhabi.ae/diwan/poem/130437","المتقارب"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76529","المتقارب"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77067","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86370","المتقارب"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127275","الكامل"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138723","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73156","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73198","الوافر"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139266","الوافر"],[308,"","https://poetry.dctabudhabi.ae/diwan/poem/199766","المتقارب"],[4767,"حصاد الخير","https://www.poetsgate.com/ViewPoem.aspx?id=88342",""],[4767,"عطر الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=177230",""],[4830,"خُلَّةُ الأخوان","https://www.poetsgate.com/ViewPoem.aspx?id=207234",""],[5140,"إذا اعتذر الصديق إليك يوماً","https://www.poetsgate.com/ViewPoem.aspx?id=181083",""],[5302,"ما أعذب العشق","https://www.poetsgate.com/ViewPoem.aspx?id=200599",""],[5410,"رسالة خاصة","https://www.poetsgate.com/ViewPoem.aspx?id=140759",""],[5431,"فبشرى لك صنعاء بشراكِ في غدٍ...","https://www.poetsgate.com/ViewPoem.aspx?id=197406",""],[5459,"مديح نبوي","https://www.poetsgate.com/ViewPoem.aspx?id=190900",""],[5725,"عراق شعلان وضاري","https://www.poetsgate.com/ViewPoem.aspx?id=177471",""],[5790,"أظن البدر لما لحت حارا","https://www.poetsgate.com/ViewPoem.aspx?id=112046",""],[5953,"أرى ألف الحروف هي الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=93806",""],[5956,"سرقوا دارة ابنتي هنادي","https://www.poetsgate.com/ViewPoem.aspx?id=210650",""],[6082,"حرفيَ المجنون","https://www.poetsgate.com/ViewPoem.aspx?id=59106",""],[5309,"جمال نفسي ضياء في طبيعتها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573676",""],[5957,"زرعت الحرف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82433&r=&rc=71",""],[4035,"تبسٌم كالبرق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1523&r=&rc=6",""],[6259,"أتروم تغطية َ الهوى بجحوده","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59366&r=&rc=14",""],[5190,"بلادي لم تزل للنور نبعاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85060&r=&rc=135",""],[6345,"ألم المسيح ردائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78632&r=&rc=3",""]],"verses":[["فَصُنِ الصنيعةَ أنْ يُدَنْ","نِسَها التذَمُّمُ والتجَرُّمْ",0,"م",1,0],["فصُنْ لي معاشي باجراءِ رسمي","وصُنْ ماءَ وجهيَ ذُلَّ الطِّلابْ",1,"ب",1,0],["فَصُن نَفسَكَ عَمّا كا","نَ عِندَ الناسِ بِالياسِ",2,"س",1,0],["فَصُنهُ فَإِنّا نَرتَجي في غِرارِهِ","شِفاءً مِنَ الأَعداءِ يَومَ تَسُلُّهُ",3,"ل",2,0],["فَصَنيعَةٌ تُسدى وَخَطبٌ يُعتَلى","وَعَظيمَةٌ تُكفى وَجُرحٌ يوسى",4,"س",2,0],["فَصنتَ حياتَه وكشفتَ عنه","خُطوبَ الدّهرِ تدفعها صعابا",5,"ب",2,0],["فَصُنها عَنِ الماءِ القَراحِ وَهاتِها","فَإِنَّكَ إِن لَم تَسقِني مِتُّ دونَها",6,"ن",3,0],["فَصَنيعَةٌ في يَومِها وَصَنيعَةٌ","قَد أَحوَلَت وَصَنيعَةٌ لَم تُحوِلِ",7,"ل",1,0],["فصنعاءُ الَّتي صَقَلَتْ سُيوفي","لها في وَجْنَةِ القَمَرَيْنِ شَقُّ",8,"ق",1,0],["فصن جمالك إما شئت في كللٍ","وادفنه إن شئت في قبر من الجهل",9,"ل",1,0],["فصنت سيفي وعفت عن دماك يدي","وقلت أي فخار أن قتلتك لي",10,"ل",2,0],["فصن من يدي وثمي ناطقا","بغير ثنائك لم يلهج",11,"ج",1,0],["فصني لمدحي فيك واقبل وَسيلَتي","اليك وقم بي في مَعادي وَفي منحى",12,"ح",2,0],["فَصُنتُ صَباباتي بِها عَن أَقارِبي","وَأَخفَيتُ أَمراضي بِها عَن أَطبَتي",13,"ي",1,0],["فصُنْتُك في الغِمْدِ ارْتقابَ وُرودِه","لعلَّك ذاك اليومَ تُصبحُ لي حِصْنا",14,"ن",2,0],["فصنها ولو في سواد العيو","ن وإياك تنبذها بالعرا",15,"ا",1,0],["فصنت عرضي وقلتُ قولاً","مصرحاً ليسَ بالمشوبِ",16,"ب",1,0],["فَصَنَعنَ عِندي مِنَّة فَجَحدتها","نيل الغَواني شكره كَجُحودِهِ",17,"د",2,0],["فصن ماء وجهي أن يراق إلى فتى","سواك وبدّل عسر حالي باليسر",18,"ر",1,0],["فصُنْتَ العُلا وأَبَحْتَ النَّدى","وحُطْتَ الهُدى وحميتَ الذِّمارا",19,"ر",2,0],["فصن عنهم النفس الأبية إنهم","ففي كنف الباري وأنت ضائم",20,"م",1,0],["فصن سرّي وسرَّك إن","بقيتَ بمطرَح الظِّنَنِ",21,"ن",1,0],["فصنْ غرساً إذا لم يجز فعلاً","على نعمى جزاك بها كلامَهْ",22,"م",2,0],["فصنعها بي ما نضا","وصبغها لي ما نصل",23,"ل",1,0],["فَصُنِ اليَومَ وَجهَ قَصدي وَإِلّا","لَم أَصُن عَن سِواكَ وَجهُ ثَنائي",24,"ا",2,0],["فصن نفساً علي أعز مني","وقاك السوء أهلي ثم مالي",25,"ل",2,0],["فَصُنْتُ مَديحي عن سُؤالٍ فَبَحْرُهُ","لِبَحْرِ نَداكَ اليَوْمَ يا حِبْرُ مُبْدِلُ",26,"ل",1,0],["فَصَنيعَةٌ في يَومِهِ وَصَنيعَةق","في شَهرِهِ وَصَنيعَةٌ في عامِهِ",27,"م",2,0],["فَصُن عَن سُؤال الذل وَجهي بِدَولة","بِها أَنتَ للعافين بِالبَذل جابر",28,"ر",1,0],["فصُن ماءَ وجهي عن سواكَ فإنّهُ","مصونٌ فصوناهُ الحيا والتكرّمُ",29,"م",1,0],["فَصُن حُرَّ وَجهي عَن سُؤالٍ فَإِنَّهُ","عَلَيَّ وَلَو عاشَ اِبنُ زائِدَةٍ صَعبُ",30,"ب",1,0],["فَصُنِ الهَوى عَنْ كلِّ مُخادعٍ","لا شَرْعُهُ شَرْعي ولا مِنْهاجُهُ",31,"ج",2,0],["فَصُن نِعمَةً أَنتَ أَنعَمتَها","وَشُكراً غَدا غائِراً مُنجِدا",32,"د",2,0],["فصنعت أعجبَ آلةٍ","مِقياس صوتٍ للطَّرَب",33,"ب",1,0],["فصن عن الأملاك","يا أشرفهم عِقائلي",34,"ل",2,0],["فصن ماء وجهي عن سواك وغطه","بجودك وانعشني بفيض نداكا",35,"ك",2,0],["فصنعاء العروس وليس يخفى","مثل أن ليس بعد العرس عطر",36,"ر",1,0],["فَصُنتُ بِماءِ الوَجه نَفساً أَبيةً","وَجادَت يَميني بِالَّذي كُنتُ أَملِكُ",37,"ك",1,0],["فصنعته تفيد الكفاف","وسلعته مرة بائرة",38,"ر",2,0],["فصن حسنها من ان يذال فقدرها","لدى ناقدي در الكلام خطير",39,"ر",1,0],["فصن النفس عن طلاب التصابي","وازجر القلب عن سؤال المغاني",40,"ن",2,0],["فصنعتي النفيسة في لساني","وصنعته الخسيسة في قذاله",41,"ل",2,0],["فَصُنها رعاكَ اللّهُ فَالاِنفس الَّتي","تَنازَعها اِضحَت مَطامِعُها تَترى",42,"ر",2,0],["فصنها وقيدها عليك بشكرها","وإلا تولت عنك ذاهبة قهرا",43,"ر",2,0],["فصنْ سرَّ السؤال لنا","ولا تخبر به أحدا",44,"د",2,0],["فصنع الاثنين اشتراك منهما","لا يخلوان من تغايرهما",45,"م",2,0],["فصن ذا المحيا الذي في سناه","دليل على قدرة المبدع",46,"ع",1,0],["فصن موضعا كان يسكنه","بقلبك وابق بغير خَليل",47,"ل",1,0],["فَصُنتُ بِلاداً أَسلَمتَها حَماتَها","وَنازَلَها مَن يَبتَغي الشَرَّ مُجهَداً",48,"د",2,0],["فصنه بهذين هب أنه","صلى نار خديك حتى احترق",49,"ق",1,0],["فصنعت صندوقا كروض زاهر","في ضمنه سر النبوة أسكنا",50,"ن",2,0],["فصنتها عن رخيص القدر مبتذل","والحر بالفعل يبدي طيب عنصره",51,"ه",1,0],["فصُن ناظري أَو عنه صُن مسرحَ الظبَّا","وإِلاَّ فهذا اللَّومُ والعَتبُ ما يجدي",52,"د",2,0],["فَصُن وجهاً فتَنَتَ به قُلوباً","أَجنَّت منكَ شَوقاً وادِّكار",53,"ر",1,0],["فصنه ما استطعت ولا","تكن في اللهو تعدمه",54,"م",2,0],["فصنف هذا وداواهم","فكان يقيناً شفاء السقام",55,"م",1,0],["فصن فؤادي خير ما نلته","وقر عيونا ثم طب نفسا",56,"س",2,0],["فصنها واسلُكَنْ لله درباً","طريق السالكين به منير",57,"ر",1,0],["فَصِنتَ اِخاءِنا وحَفظتَ عهداً","فلم أرَ مثلَ هذا القلبِ أصْفا",58,"ف",2,0],["فصنه عن جفائك وارض عنه","فإن الصفح شيمة كل حر",59,"ر",1,0],["فصن هواي تر الدنيا ببهجتها","مالت علينا بظل غامر ورف",60,"ف",1,0],["فَصُنْ في فعلكَ السامي ثواباً","وَخَلِّ الذكرَ في الدنيا وساما",61,"م",2,0],["فصنعاء نجمٌ بالحضارة ساطعٌ","وعرقٌ نقيٌ ماحقٌ للخبائث",62,"ث",1,0],["فصُنِ اللسانَ عَنِ الضَّلالِ ولا تكُنْ","بمَديح خيرِ الكائناتِ بَخيلا",63,"ل",2,0],["فصنتك إلهامٓ ارجوزتي","وثديا الى الان لن يلقما",64,"م",2,0],["فصن وجها فتنت به قلوبا","أجنت فيك شوقا وادكارا",65,"ر",2,0],["فصنه عن الإذاعة وادخره","ففي التبذير قد يقع الحتوف",66,"ف",1,0],["فصنعتِ خيرَ صناعة قتّالة","للنحس يهرب من زُعافك شاكيا",67,"ي",2,0],["فصنعت من شهب الفضاء قلادة","واقمت ما بين النجوم جسورا",68,"ر",2,0],["فَصُنتُها عَن رَخيصِ القَدرِ مُبتَذَلِ","وَاللهُ يَعلَمُ أَنَّ الحَقَّ رائِدُها",69,"ه",2,0],["فصن أرض الكنانة يا إلهي","وبارك شعبها الحر الأمينا",70,"ن",2,0],["فصُنه بنهديك هب إنٌهُ","صَلا نار خدّيك حتى احترق",71,"ق",1,0],["فصنعن عندي منّة ً فجحدتها","نيلَ الغواني شكره بجحوده",72,"د",2,0],["فَصُنهَا يا إِلَهِي ، واحمِ شعباً","على عِظَمِ الحوادِثِ قد تسامى",73,"م",2,0],["فصنعت من جور الزمان قلادتي","ونسجت من ألم المسيح ردائي",74,"ا",3,0]]}