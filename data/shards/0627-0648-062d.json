.html","المجتث"],[480,"جنحت للغروب شمس الأصيل","https://www.aldiwan.net/poem37184.html","الخفيف"],[491,"إما ترى رأسي أزرى به","https://www.aldiwan.net/poem658.html",""],[515,"نبتت رياحين العذار بورده","https://www.aldiwan.net/poem20790.html","الكامل"],[515,"ميلوا بنا نحو الحجون ونكبوا","https://www.aldiwan.net/poem20800.html","الكامل"],[539,"ألقلب من حذر النوى ملآن","https://www.aldiwan.net/poem47592.html","عموديه"],[552,"من رأى لي في الدجى ذا خطل","https://www.aldiwan.net/poem47224.html","الرمل"],[552,"إن كنت بالعفو ليس تعذرنا","https://www.aldiwan.net/poem47851.html","المنسرح"],[554,"آثار أطلال برومة درس","https://www.aldiwan.net/poem68418.html","الكامل"],[559,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[563,"طفح الأنس فوق ساحات جلق","https://www.aldiwan.net/poem52784.html","الخفيف"],[563,"ألحمد لله الذي خلق الورى","https://www.aldiwan.net/poem52937.html","الكامل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[570,"اتق الأحمق أَن تصحبه","https://www.aldiwan.net/poem51998.html","الرمل"],[576,"أوحشني الأوانس","https://www.aldiwan.net/poem3056.html","مجزوء الرجز"],[576,"إن أكن أشجعا فأنت الرشيد","https://www.aldiwan.net/poem3083.html","الخفيف"],[587,"أوحشتموا نظري فكم من عبرة","https://www.aldiwan.net/poem17613.html","الكامل"],[587,"لو رمت إبقاء الوداد بحاله","https://www.aldiwan.net/poem17687.html","الكامل"]],"verses":[["أَوحى الظَلامُ إِلى الإِصباحِ أَنَّ فَتىً","أَسرى وَما خَدَعَتهُ لَذَّةُ الحُلُمُ",0,"م",1,0],["أَو حَمِّلِ اللَومَ القَضاءَ فَإِنَّهُ","عَودٌ لِأَثقالِ المَلامِ مُذَلَّلُ",1,"ل",1,0],["أَو حَيَّةُ الرَعنِ ذَوى رَأسَهُ","مُشتَرِقَ الشَمسِ بِطَودٍ زَليق",2,"ق",1,0],["أَوْ حَاوَرَ الآدابَ مُبْتَدِعاً لَهَا","رَاضَ الْعُقُولَ وَرَوَّضَ الأَفْهَامَا",3,"م",2,0],["أَوحَرفُ حِنوٍ مِن غَبيطٍ ذابِلٍ","رَفَقَت بِهِ قَينِّيَةٌ مَعطوفُ",4,"ف",1,0],["أَوَ حينَ اِبتَزَّ دَهري قُوَّتي","وَذَوى عودي وَوافاني مَشيبي",5,"ب",2,0],["أَو حَلَّ فيكِ عَدُوٌّ","مُنازِلٌ ما اِتَّقَيتُ",6,"ت",1,0],["أَو حَلَّ عَقدَ عَزائي نَأيُهُ فَلَكَم","حَلَلتُ عَن خَصرِهِ عَقدَ الثَمانينِ",7,"ن",1,0],["أَوْحَشَتْ مِنْكَ دَارُهُ","فَهْيَ سُكْنَى بِلا سَكَنْ",8,"ن",1,0],["أَوْ حِمَامٌ مُفَاجِيءٌ","لا نَذِيرٌ وَلا سَقَمْ",9,"م",1,0],["أَو حُرَّةٌ عَيطَلٌ ثَبجاءُ مُجفَرَةٌ","دَعائِمَ الزَورِ نِعَمت زَورَقُ البَلَدِ",10,"د",1,0],["أَو حَلَّ أَمرُ اللَهِ فينا عاجِلاً","مِن يَومِنا في رَوحَةٍ أَو في غَدِ",11,"د",1,0],["أَوحَشَ الجُنبُذانَ فَالدَيرُ مِنها","فَقُراها فَالمَنزِلُ المَحظورُ",12,"ر",1,1],["أوحشه الغيث الذي قد نأى","وجاءه واللهِ في وقته",13,"ت",2,0],["أو حاجبٌ أشمطٌ ينبي بأن له","عمراً له في ظلال الملك تعمير",14,"ر",1,0],["أوحشتْني مخافتيهِ فأصبح","تُ حريباً من كل أُنسٍ سليبا",15,"ب",2,0],["أو حماريَّةٌ فمقدارُ حظّي","شَبعةٌ عندهُ بلا إتعابِ",16,"ب",1,0],["أو حُلى ظَرْفهِ التي نَحَستْهُ","فلو اسطاع باعها بجِرابِ",16,"ب",1,0],["أو حُلِّلَتْ فَبِحقِّهَا من نُشْرَة","تَنْفِي سَقَامَ قلوبنا بِصحاحِ",17,"ح",1,0],["أو حلم أنديةٍ أو خصب أوديةٍ","أو طيب أردية أو حسن أعطاف",18,"ف",1,0],["أو حنة من حنين النيب ما برحت","تهيج للصبِّ أبراحاً وأشعافا",19,"ف",2,0],["أو حنِينُ العُوذِ الروائم بالدهْ","ناء أفردتهنَّ من جيرانِ",20,"ن",1,0],["أو حُمِّلا من أمانةٍ طَرَفاً","كانا الظَّنينين لا الأمينيْن",21,"ن",1,0],["أَو حَيَّةٍ تَدُبُّ في مَنجَمٍ","تَرنو إِلى فَراشَةٍ حُرَّةِ",22,"ه",1,0],["أَوحَشتَني وَاللَهِ يا مالِكي","قَطَعتُ يَومي كُلَّهُ لَم أَرَك",23,"ك",1,1],["أوحى إلى الحزن اللجوج شُبوبها","وإلى الدموع سواكبا إطفاءها",24,"ا",3,0],["أَوحَت لِطَرفِكَ فَاِستَهَلَّ شُؤونا","دارٌ مَرَرتَ بِها عَلى قَيسونا",25,"ن",2,1],["أَوحَشَ السُؤدُدُ فيهِم وَسَما","لِلمَعالي مَن بِهِ لَم تانَسِ",26,"س",1,0],["أَوحَدنَني وَوَجَدنَ حُزناً واحِداً","مُتَناهِياً فَجَعَلنَهُ لي صاحِبا",27,"ب",2,0],["أَو حارَبَتهُ فَما تَنجو بِتَقدِمَةٍ","مِمّا أَرادَ وَلا تَنجو بِتَجبيبِ",28,"ب",1,0],["أَو حَلَّ في رومٍ فَفيها قَيصَرٌ","أَو حَلَّ في عُربٍ فَفيها تُبَّعُ",29,"ع",1,0],["أَو حَلَفوا بِالغَموسِ وَاِجتَهَدوا","فَقَولُهُم خابَ سائِلي القَسَمُ",30,"م",1,0],["أو حالَ ما بيني وبينَ مطالبي","خطبٌ فذلك حائلٌ متحوِّلُ",31,"ل",1,0],["أَوحَشتَ مُذ غِبتَ قَوماً كُنتَ أُنسَهُمُ","إِذا شَهِدتَهُمُ فَاِشهَد وَلا تَغِبِ",32,"ب",1,0],["أَوحَشَت أَربُعُ العَقيقِ وَدورُه","لِأَنيسٍ أَجَدَّ عَنها بُكورُه",33,"ر",2,1],["أَوحَدٌ خَسَّ دونَهُ الخَيرُ حَتّى","ما تَقولُ السَماءُ تُجدي بِقَطرِ",34,"ر",1,0],["أَوْحَشْنَ إلا من وُقوفِ متيَّمٍ","وعَطِلْنَ إلا من حُليِّ سَحائبِ",35,"ب",1,0],["أَوحى الرَّسولُ بِإِعدادِ الرَّحيلِ إِلى","مَن عِندَهُ السِّرُّ مِن خِلٍّ وَمِن حَشَمِ",36,"م",1,0],["أوحشَني يا صنعةُ الباري","جمالُكَ العاري منَ العارِ",37,"ر",1,1],["أوحدُ في الفضلِ لا نظيرَ لهُ","أيَّ الرجالِ المهذبُ الماجدْ",38,"د",1,0],["أَو حَديثٍ عَلى خَلاءٍ يُسَلّي","ما أَجَنَّ الضَميرَ مِنها وَمَنّا",39,"ن",2,0],["أَوحَت هُناكَ إِلى الرُبى أَن بَشِّري","بِالرِيِّ فَرعَ أَراكَةٍ وَبَشامِ",40,"م",1,0],["أَوْحَى إلى شُهدائِكم فَتقدَّموا","إنّ الحياةَ عِمادُها الإقدامُ",41,"م",1,0],["أَوحَشتِ شَهرَ الصَومِ حَتّى قَد بَدَت","لِلبَثِّ فيهِ وَلِلأَسى أَعلامُ",42,"م",1,0],["أَو حَسُودٍ بَغاكِ يَوماً بِسُوءٍ","كاشِحٍ مُبغِضٍ لِرِجلِكِ نَعلا",43,"ل",2,0],["أوحَشتَنا في صدرِ يوْمٍ واحِدٍ","وأطَلتَ شوقَ الصافناتِ القود",44,"د",1,0],["أَو حَوِّليها إِلى ما فَهيَ تَعدُلُها","إِن كُنتِ حاوَلتِ في لا قِلَّةِ الكَلِمِ",45,"م",1,0],["أَو حاتِمٍ بَلَغوا اليَفا","عَ وَضَوءُ نارِكَ غَيرُ خامِد",46,"د",1,0],["أَوحَشتَ مِن دَعدٍ وَنُؤيِ دَعدِ","بَعدَ زَمانٍ ناعِمٍ وَمَردِ",47,"د",1,0],["أَو حُرَّةٍ كَمَهاةِ الرَملِ قَد كُبِلَت","فَوقَ المَعاصِمِ مِنها وَالعَراقيبِ",48,"ب",1,0],["أَو حِمَلٌ نُزِّهَ في الجَوِّ أَن","يَغتالَهُ بِالمَديَّةِ الكائِدُ",49,"د",1,0],["أَوحى المَليكُ إِلى مَن في بَسيطَتِهِ","مِنَ البَريَّةِ جَوَسوا الأَرضَ أَو حَوسَوا",50,"س",3,1],["أَوحَشَت بَعدَ ضُمَّرٍ كَالسَعالي","مِن بَناتِ الوَجيهِ أَو حَلّابِ",51,"ب",1,0],["أو حَشا سالٍ وما أختارُهُ","إن تَروا ذاك بها مَنّاً عَلي",52,"ي",1,0],["أَو حكمة كان فيها","للسامعين انتفاع",53,"ع",1,0],["أو حسرة مني إليك وحسرة","مرتدة من ناظريك إليّا",54,"ي",2,0],["أوحدنني ووجدن حزناً واحدً","متناهياً فجعلنه لي صاحب",55,"ب",1,0],["أوَ حقاً دنياك زهرٌ وخمرٌ","وغوانٍ فواتنٌ وغِناءُ",56,"ا",2,0],["أو حُدِّثا عنها","ما هجرا الخُلدَا",57,"د",2,0],["أو حقّاً قَرُبتْ من منتهاها","هذه المحنةُ وانجاب دُجاها",58,"ه",2,0],["أَوحى له الشرقُ أنَّا من أحبَّتِهِ","وأننا في الهوى أهلٌ أودَّاءُ",59,"ا",2,0],["أوحَتْ إلى العُرْبِ الحُداءَ وألهمتْ","فُرسانهم تحت الوغى الإِنشادا",60,"د",2,0],["أوحى له المرح الوجود فصاغه","شدوا بأسرار القلوب وباحا",61,"ح",2,0],["أوحيتَ لي سرَّ الردى فانجلى","عن عينيَ الشكُّ وليلُ الضلالْ",62,"ل",1,0],["أوحى الى رسوله ما أوحى","من كلّ غراء تضيئ اللوحا",63,"ح",2,0],["أَوْحَى إِلَى القَلْبِ فانْقَادَتْ أَزِمَّتُهُ","طَوْعاً إِلَيْهِ وَخلَّانِي وَلَمْ يَعُجِ",64,"ج",1,0],["أَوْحَى إِلَيْكُمْ هَوَى لُبْنَانَ عَاطِفَةً","لَمْ تُبْقِ في الأَرْضِ تَقْرِيباً وَتَبْعِيدا",65,"د",2,0],["أَوْ حِكْمَةً تُؤْخَذُ عَنْ","مُتَّعِظٍ وَمُعْتَبِرْ",66,"ر",1,0],["أَوْحَشَنا تمْثِيلُهُ جَامِعاً","ما شاقَ مِنْ رَمْزٍ وَمِنْ نَبْسِ",67,"س",1,0],["أَوْ حَمَى الأَوْطَانَ وَالعِرْضَ مَعاً","فَهُوَ الدِّينُ كَمَا تَرْضَى الحَيَاةُ",68,"ه",1,0],["أَوْحَى إِلَيهِ قَلْبُهُ مِنْ فَوْرِهِ","أَنَّ انْتِقَاذَ الطِّفْلِ ضَرْبَةُ لاَزِبِ",69,"ب",1,0],["أوحيد أمّته تقىً وهدايةً","هلا سمعت وحيدها إنشادا",70,"د",2,0],["أوحيت للشعراء ما كتبوا","فخلدت الكتابة",71,"ب",2,0],["أَو حَطَّ البَدر رافِعُهُ","فَاِختَبا أَو عَقلي اِختَبَلا",72,"ل",2,0],["أو حاملاً أثقال أحماله","تلك التي لا في جواليق",73,"ق",1,0],["أوحشتَني يا رسمُ أم آنستني؟","وأقمتَ عُرسًا في الحشا أم مأتما؟",74,"م",2,0],["أو حاربَتْ معه أبا","لِسَةُ الجحيم مدجَّجين",75,"ن",1,0],["أو حاجب فظُّ من الحُجَّاب","وأنت جالسٌ على الأَعْتاب",76,"ب",1,0],["أو حرْبةٌ مَسْنُونَةً، أو مدْفَعًا","متفجرًا، أو صَارمًا، أوْ خِنْجَرا!",77,"ر",2,0],["أو حاول الأداب مبتدعا لها","راض العقول وروض الأفهاما",78,"م",2,0],["أو حاولي أن تصبحي ، لعبة","أخرى ، ومدّي نظرة كائده",79,"د",2,0],["أو حاولي يا سُحْبُ أن تُطفئي","قلبي عَسَى عَنْ قلبِهِ أنْ يَتُوب",80,"ب",1,0],["أوحى \" الزعيمُ \" إلى الجزيرةِ كلَّها","أنْ ليسَ يُدركُ بالكلام طِلاب",81,"ب",1,0],["أُوحِشَتْ أرْبُعُ العَقيقِ وَدُورُهْ،","لأنيسٍ أجَدّ مِنها بُكُورُهْ",82