"س",1,0],["أوْحَدٌ تَخْدُمُه أيّامُه","وتُواليهِ نَهَى أوْ أَمَرا",111,"ر",2,0],["أَو حنَّطوكَ فَلا تَزال مطيَّباً","طيباً تضوعُ به قُرىً وَفَيافي",112,"ف",2,0],["أَوحشته ظلماتٌ بعضها","فوق بعضٍ حجبتْ نجمَ السما",113,"ا",1,0],["أَوحى له اللّه ما أَوحى وأشهدهُ","ما لَيسَ تَسمو إِلى إدراكه الهممُ",114,"م",1,0],["أُوَحِّدُهُ بِإِخلاصٍ وَحَمدٍ","وَشُكرٍ بِالضَميرِ وَبِاللِسانِ",115,"ن",1,0],["أَو حَدُّ الناسِ أَكرَمُ الناسِ في البَأ","سِ وَفي الفَضلِ وَالنَدا وَالكَرامَه",116,"م",2,0],["أَوحَدَ العَصرَ أَهيَبُ القَدرِ ذو المَج","دِ أَخو المَجدِ مِن عِلمِنا خَصالَه",117,"ل",2,0],["أو حقير عُريان مزَّقَه الجو","عُ وأضنَتهُ لوعة الحرمان",118,"ن",1,0],["أوحى إليك على ظلام","اليأس خفّاق الأماني",119,"ي",1,0],["أَوحى بِتَحريمِها خَوفاً عَلَيهِ بِأَن","يُضحوا لَها سُجَّداً مِن دونِهِ تيها",120,"ي",3,0],["أَوحش الإنسي بِطَلعَتِهِ","ثُمَّ لَمّا أَن دَنا مِنّي",121,"ي",1,0],["أوحَدُ في دولةٍ","مُشْتَهِرُ الاتّحِاد",122,"د",1,0],["أَوحَشت بَعد أَهلها فَكَأنَّ لَم","يَكُ في الدار زائر وَمزورُ",123,"ر",1,0],["أو حرك الريح للأشجار","وما دعا داعي الير",124,"ر",1,0],["أو حُلْتَ عن ودّي وخُنتَ","فلا أحولُ ولا أَخونُ",125,"ن",1,0],["أو حصرت بلاغة الكلام","على أناس سالفي الأعوام",126,"م",1,0],["أو حفة من باغة قد طبقت","تناشد الناظر هلاَّ اجتليت",127,"ت",1,0],["أَو حَيثُ ما يَجِبُ الثَناء بِغَير ما","أَولى الوَزير القرب مِن إِنعامِهِ",128,"م",2,0],["أو حاربَ الكفرَ أضحى وهو متخذٌ","حِزْبَ الملائك أنصاراً وأعوانا",129,"ن",2,0],["أوحشونا من دخان مظلم","مقل الأجفان حب الفلفل",130,"ل",1,0],["أوحدٌ يهتزّ عند العطايا","للعطايا فرَحاً وارتياحا",131,"ح",2,0],["أوحى الضمير بها فجاءت وفق م","يهوى الصديق وفوق ما يتوقع",132,"ع",1,0],["أوحى بها قلب بحبك مفعم","والقلب حين يحب لا يتملق",133,"ق",1,0],["أوحى الفؤاد إلى اليراع الجوهر","فمضى يرصع بالنضار الأسطرا",134,"ر",2,1],["أوحى الضمير بها فجاءت عكس م","يهوى السود وفوق ما يتصور",135,"ر",1,0],["أو حباني بقربه","بعدما ذقتُ بُعْدَهُ",136,"د",2,0],["أوْ حكتها مناقِرٌ فتحت منها","الكراكي في الشطّ تمثال فِتر",137,"ر",1,0],["أو حقود شقوة الناس له","نعمة باهى بأ