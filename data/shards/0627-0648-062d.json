{"poems":[[53,"هذي الرماح عصي الضال والسلم","https://www.aldiwan.net/poem29765.html","البسيط"],[53,"ما ابيض من لون العوارض أفضل","https://www.aldiwan.net/poem29902.html","الكامل"],[53,"تعيف الطير فأنبأنه","https://www.aldiwan.net/poem29951.html","السريع"],[77,"قلدت من نصر الإلاه حساما","https://www.aldiwan.net/poem36124.html","الكامل"],[24,"أنى ألم بك الخيال يطيف","https://www.aldiwan.net/poem21870.html","الكامل"],[86,"ولدي قد طال سهدي ونحيبي","https://www.aldiwan.net/poem10476.html","الرمل"],[86,"ليلاي ما أنا حي","https://www.aldiwan.net/poem10682.html","المجتث"],[73,"هل راكب ذاهب عنهم يحييني","https://www.aldiwan.net/poem11849.html","البسيط"],[93,"انزل المنزل الحسن","https://www.aldiwan.net/poem11260.html","مجزوء الخفيف"],[93,"كيف قوضت يا علم","https://www.aldiwan.net/poem11343.html","مجزوء الخفيف"],[30,"يا دار مية بالخلصاء فالجرد","https://www.aldiwan.net/poem29598.html","البسيط"],[23,"ما بال عيني لا تنام كأنما","https://www.aldiwan.net/poem21397.html","الكامل"],[23,"أوحش الجنبذان فالدير منها","https://www.aldiwan.net/poem21573.html","الخفيف"],[72,"لاعب شطرنج بفصل الشتا","https://www.aldiwan.net/poem18403.html","السريع"],[72,"يا شاهر اللحظ حبي فيك مشهور","https://www.aldiwan.net/poem18695.html","البسيط"],[51,"أحمد الله مبدئا ومعيدا","https://www.aldiwan.net/poem8322.html","الخفيف"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[51,"ومدامة أغنت عن المصباح","https://www.aldiwan.net/poem9412.html","الكامل"],[51,"يا آل وهب ألا ينهى سماحكم","https://www.aldiwan.net/poem65447.html","البسيط"],[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[51,"خساسة البيهقي والبينِ","https://www.aldiwan.net/poem66485.html","المنسرح"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[70,"أوحشتني والله يا مالكي","https://www.aldiwan.net/poem42896.html","السريع"],[85,"هو مأتم الأخلاق فاتل رثاءها","https://www.aldiwan.net/poem7109.html","الكامل"],[85,"أوحت لطرفك فاستهل شؤونا","https://www.aldiwan.net/poem8112.html","الكامل"],[85,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[43,"بأبي الشموس الجانحات غواربا","https://www.aldiwan.net/poem9466.html","الكامل"],[43,"من الجآذر في زي الأعاريب","https://www.aldiwan.net/poem9507.html","البسيط"],[43,"الحزن يقلق والتجمل يردع","https://www.aldiwan.net/poem9724.html","الكامل"],[43,"أحق عاف بدمعك الهمم","https://www.aldiwan.net/poem10537.html","المنسرح"],[62,"إن يحل دهر أو يمر فإنني","https://www.aldiwan.net/poem52313.html","الكامل"],[45,"إن ترج طول عبيد الله لا تخب","https://www.aldiwan.net/poem11041.html","البسيط"],[45,"أوحشت أربع العقيق ودوره","https://www.aldiwan.net/poem63578.html","الخفيف"],[45,"شد ما أغرمت ظلوم بهجري","https://www.aldiwan.net/poem63602.html","الطويل"],[61,"شعف الحبائل من ربى وملاعب","https://www.aldiwan.net/poem51812.html","الكامل"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[69,"أوحشني يا صنعة الباري","https://www.aldiwan.net/poem28473.html","السريع"],[69,"يا بن أخينا أقمتنا أبدا","https://www.aldiwan.net/poem28602.html","المنسرح"],[31,"من لقلب أمسى حزينا معنى","https://www.aldiwan.net/poem41299.html","الخفيف"],[74,"ومقنع بخلا بنضرة حسنه","https://www.aldiwan.net/poem13241.html","الكامل"],[105,"أعلى المآتم تخفق الأعلام","https://www.aldiwan.net/poem42080.html","الكامل"],[81,"يلحى الزمان وما عليه ملام","https://www.aldiwan.net/poem61489.html","الكامل"],[40,"حمل القلب من حميدة ثقلا إن","https://www.aldiwan.net/poem42297.html","الخفيف"],[75,"قل للمليك ابن الملوك الصيد","https://www.aldiwan.net/poem69088.html","الكامل"],[48,"أنضيت أحرف لا مما لهجت بها","https://www.aldiwan.net/poem65119.html","البسيط"],[50,"يا دار أقوت بالأجالد","https://www.aldiwan.net/poem63942.html","مجزوء الكامل"],[50,"يا طلل الحي بذات الصمد","https://www.aldiwan.net/poem63943.html","الرجز"],[7,"إني كأني لدى النعمان خبره","https://www.aldiwan.net/poem2016.html","البسيط"],[46,"يا سابحا يصهل في غرة","https://www.aldiwan.net/poem22419.html","السريع"],[46,"أوحى المليك إلى من في بسيطته","https://www.aldiwan.net/poem22799.html","البسيط"],[15,"لمن الدار أقفرت بالجناب","https://www.aldiwan.net/poem45282.html","الخفيف"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125571","الكامل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140859",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39648","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39611","المنسرح"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39632","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39652","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39664","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39684","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39561","السريع"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202526","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42550","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54691","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54978","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54658","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54626","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141969","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43824","المديد"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24207","السريع"],[106,"خيال في يقظة","https://www.poetsgate.com/ViewPoem.aspx?id=179676",""],[106,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[106,"من وحي البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179317",""],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[77,"قلدت من نصر الإله حساما","https://www.poetsgate.com/ViewPoem.aspx?id=34200",""],[100,"خدعة","https://www.poetsgate.com/ViewPoem.aspx?id=50386",""],[90,"المجلس المفجوع","https://www.poetsgate.com/ViewPoem.aspx?id=179038",""],[45,"أُوحِشَتْ أرْبُعُ العَقيقِ وَدُورُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31336",""]],"verses":[["أَوحى الظَلامُ إِلى الإِصباحِ أَنَّ فَتىً","أَسرى وَما خَدَعَتهُ لَذَّةُ الحُلُمُ",0,"م",1,0],["أَو حَمِّلِ اللَومَ القَضاءَ فَإِنَّهُ","عَودٌ لِأَثقالِ المَلامِ مُذَلَّلُ",1,"ل",1,0],["أَو حَيَّةُ الرَعنِ ذَوى رَأسَهُ","مُشتَرِقَ الشَمسِ بِطَودٍ زَليق",2,"ق",1,0],["أَوْ حَاوَرَ الآدابَ مُبْتَدِعاً لَهَا","رَاضَ الْعُقُولَ وَرَوَّضَ الأَفْهَامَا",3,"م",2,0],["أَوحَرفُ حِنوٍ مِن غَبيطٍ ذابِلٍ","رَفَقَت بِهِ قَينِّيَةٌ مَعطوفُ",4,"ف",1,0],["أَوَ حينَ اِبتَزَّ دَهري قُوَّتي","وَذَوى عودي وَوافاني مَشيبي",5,"ب",2,0],["أَو حَلَّ فيكِ عَدُوٌّ","مُنازِلٌ ما اِتَّقَيتُ",6,"ت",1,0],["أَو حَلَّ عَقدَ عَزائي نَأيُهُ فَلَكَم","حَلَلتُ عَن خَصرِهِ عَقدَ الثَمانينِ",7,"ن",1,0],["أَوْحَشَتْ مِنْكَ دَارُهُ","فَهْيَ سُكْنَى بِلا سَكَنْ",8,"ن",1,0],["أَوْ حِمَامٌ مُفَاجِيءٌ","لا نَذِيرٌ وَلا سَقَمْ",9,"م",1,0],["أَو حُرَّةٌ عَيطَلٌ ثَبجاءُ مُجفَرَةٌ","دَعائِمَ الزَورِ نِعَمت زَورَقُ البَلَدِ",10,"د",1,0],["أَو حَلَّ أَمرُ اللَهِ فينا عاجِلاً","مِن يَومِنا في رَوحَةٍ أَو في غَدِ",11,"د",1,0],["أَوحَشَ الجُنبُذانَ فَالدَيرُ مِنها","فَقُراها فَالمَنزِلُ المَحظورُ",12,"ر",1,1],["أوحشه الغيث الذي قد نأى","وجاءه واللهِ في وقته",13,"ت",2,0],["أو حاجبٌ أشمطٌ ينبي بأن له","عمراً له في ظلال الملك تعمير",14,"ر",1,0],["أوحشتْني مخافتيهِ فأصبح","تُ حريباً من كل أُنسٍ سليبا",15,"ب",2,0],["أو حماريَّةٌ فمقدارُ حظّي","شَبعةٌ عندهُ بلا إتعابِ",16,"ب",1,0],["أو حُلى ظَرْفهِ التي نَحَستْهُ","فلو اسطاع باعها بجِرابِ",16,"ب",1,0],["أو حُلِّلَتْ فَبِحقِّهَا من نُشْرَة","تَنْفِي سَقَامَ قلوبنا بِصحاحِ",17,"ح",1,0],["أو حلم أنديةٍ أو خصب أوديةٍ","أو طيب أردية أو حسن أعطاف",18,"ف",1,0],["أو حنة من حنين النيب ما برحت","تهيج للصبِّ أبراحاً وأشعافا",19,"ف",2,0],["أو حنِينُ العُوذِ الروائم بالدهْ","ناء أفردتهنَّ من جيرانِ",20,"ن",1,0],["أو حُمِّلا من أمانةٍ طَرَفاً","كانا الظَّنينين لا الأمينيْن",21,"ن",1,0],["أَو حَيَّةٍ تَدُبُّ في مَنجَمٍ","تَرنو إِلى فَراشَةٍ حُرَّةِ",22,"ه",1,0],["أَوحَشتَني وَاللَهِ يا مالِكي","قَطَعتُ يَومي كُلَّهُ لَم أَرَك",23,"ك",1,1],["أوحى إلى الحزن اللجوج شُبوبها","وإلى الدموع سواكبا إطفاءها",24,"ا",3,0],["أَوحَت لِطَرفِكَ فَاِستَهَلَّ شُؤونا","دارٌ مَرَرتَ بِها عَلى قَيسونا",25,"ن",2,1],["أَوحَشَ السُؤدُدُ فيهِم وَسَما","لِلمَعالي مَن بِهِ لَم تانَسِ",26,"س",1,0],["أَوحَدنَني وَوَجَدنَ حُزناً واحِداً","مُتَناهِياً فَجَعَلنَهُ لي صاحِبا",27,"ب",2,0],["أَو حارَبَتهُ فَما تَنجو بِتَقدِمَةٍ","مِمّا أَرادَ وَلا تَنجو بِتَجبيبِ",28,"ب",1,0],["أَو حَلَّ في رومٍ فَفيها قَيصَرٌ","أَو حَلَّ في عُربٍ فَفيها تُبَّعُ",29,"ع",1,0],["أَو حَلَفوا بِالغَموسِ وَاِجتَهَدوا","فَقَولُهُم خابَ سائِلي القَسَمُ",30,"م",1,0],["أو حالَ ما بيني وبينَ مطالبي","خطبٌ فذلك حائلٌ متحوِّلُ",31,"ل",1,0],["أَوحَشتَ مُذ غِبتَ قَوماً كُنتَ أُنسَهُمُ","إِذا شَهِدتَهُمُ فَاِشهَد وَلا تَغِبِ",32,"ب",1,0],["أَوحَشَت أَربُعُ العَقيقِ وَدورُه","لِأَنيسٍ أَجَدَّ عَنها بُكورُه",33,"ر",2,1],["أَوحَدٌ خَسَّ دونَهُ الخَيرُ حَتّى","ما تَقولُ السَماءُ تُجدي بِقَطرِ",34,"ر",1,0],["أَوْحَشْنَ إلا من وُقوفِ متيَّمٍ","وعَطِلْنَ إلا من حُليِّ سَحائبِ",35,"ب",1,0],["أَوحى الرَّسولُ بِإِعدادِ الرَّحيلِ إِلى","مَن عِندَهُ السِّرُّ مِن خِلٍّ وَمِن حَشَمِ",36,"م",1,0],["أوحشَني يا صنعةُ الباري","جمالُكَ العاري منَ العارِ",37,"ر",1,1],["أوحدُ في الفضلِ لا نظيرَ لهُ","أيَّ الرجالِ المهذبُ الماجدْ",38,"د",1,0],["أَو حَديثٍ عَلى خَلاءٍ يُسَلّي","ما أَجَنَّ الضَميرَ مِنها وَمَنّا",39,"ن",2,0],["أَوحَت هُناكَ إِلى الرُبى أَن بَشِّري","بِالرِيِّ فَرعَ أَراكَةٍ وَبَشامِ",40,"م",1,0],["أَوْحَى إلى شُهدائِكم فَتقدَّموا","إنّ الحياةَ عِمادُها الإقدامُ",41,"م",1,0],["أَوحَشتِ شَهرَ الصَومِ حَتّى قَد بَدَت","لِلبَثِّ فيهِ وَلِلأَسى أَعلامُ",42,"م",1,0],["أَو حَسُودٍ بَغاكِ يَوماً بِسُوءٍ","كاشِحٍ مُبغِضٍ لِرِجلِكِ نَعلا",43,"ل",2,0],["أوحَشتَنا في صدرِ يوْمٍ واحِدٍ","وأطَلتَ شوقَ الصافناتِ القود",44,"د",1,0],["أَو حَوِّليها إِلى ما فَهيَ تَعدُلُها","إِن كُنتِ حاوَلتِ في لا قِلَّةِ الكَلِمِ",45,"م",1,0],["أَو حاتِمٍ بَلَغوا اليَفا","عَ وَضَوءُ نارِكَ غَيرُ خامِد",46,"د",1,0],["أَوحَشتَ مِن دَعدٍ وَنُؤيِ دَعدِ","بَعدَ زَمانٍ ناعِمٍ وَمَردِ",47,"د",1,0],["أَو حُرَّةٍ كَمَهاةِ الرَملِ قَد كُبِلَت","فَوقَ المَعاصِمِ مِنها وَالعَراقيبِ",48,"ب",1,0],["أَو حِمَلٌ نُزِّهَ في الجَوِّ أَن","يَغتالَهُ بِالمَديَّةِ الكائِدُ",49,"د",1,0],["أَوحى المَليكُ إِلى مَن في بَسيطَتِهِ","مِنَ البَريَّةِ جَوَسوا الأَرضَ أَو حَوسَوا",50,"س",3,1],["أَوحَشَت بَعدَ ضُمَّرٍ كَالسَعالي","مِن بَناتِ الوَجيهِ أَو حَلّابِ",51,"ب",1,0],["أو حَشا سالٍ وما أختارُهُ","إن تَروا ذاك بها مَنّاً عَلي",52,"ي",1,0],["أَو حكمة كان فيها","للسامعين انتفاع",53,"ع",1,0],["أو حسرة مني إليك وحسرة","مرتدة من ناظريك إليّا",54,"ي",2,0],["أوحدنني ووجدن حزناً واحدً","متناهياً فجعلنه لي صاحب",55,"ب",1,0],["أوَ حقاً دنياك زهرٌ وخمرٌ","وغوانٍ فواتنٌ وغِناءُ",56,"ا",2,0],["أو حُدِّثا عنها","ما هجرا الخُلدَا",57,"د",2,0],["أو حقّاً قَرُبتْ من منتهاها","هذه المحنةُ وانجاب دُجاها",58,"ه",2,0],["أَوحى له الشرقُ أنَّا من أحبَّتِهِ","وأننا في الهوى أهلٌ أودَّاءُ",59,"ا",2,0],["أوحَتْ إلى العُرْبِ الحُداءَ وألهمتْ","فُرسانهم تحت الوغى الإِنشادا",60,"د",2,0],["أوحى له المرح الوجود فصاغه","شدوا بأسرار القلوب وباحا",61,"ح",2,0],["أوحيتَ لي سرَّ الردى فانجلى","عن عينيَ الشكُّ وليلُ الضلالْ",62,"ل",1,0],["أوحى الى رسوله ما أوحى","من كلّ غراء تضيئ اللوحا",63,"ح",2,0],["أَوْحَى إِلَى القَلْبِ فانْقَادَتْ أَزِمَّتُهُ","طَوْعاً إِلَيْهِ وَخلَّانِي وَلَمْ يَعُجِ",64,"ج",1,0],["أَوْحَى إِلَيْكُمْ هَوَى لُبْنَانَ عَاطِفَةً","لَمْ تُبْقِ في الأَرْضِ تَقْرِيباً وَتَبْعِيدا",65,"د",2,0],["أَوْ حِكْمَةً تُؤْخَذُ عَنْ","مُتَّعِظٍ وَمُعْتَبِرْ",66,"ر",1,0],["أَوْحَشَنا تمْثِيلُهُ جَامِعاً","ما شاقَ مِنْ رَمْزٍ وَمِنْ نَبْسِ",67,"س",1,0],["أَوْ حَمَى الأَوْطَانَ وَالعِرْضَ مَعاً","فَهُوَ الدِّينُ كَمَا تَرْضَى الحَيَاةُ",68,"ه",1,0],["أَوْحَى إِلَيهِ قَلْبُهُ مِنْ فَوْرِهِ","أَنَّ انْتِقَاذَ الطِّفْلِ ضَرْبَةُ لاَزِبِ",69,"ب",1,0],["أوحيد أمّته تقىً وهدايةً","هلا سمعت وحيدها إنشادا",70,"د",2,0],["أَو حَطَّ البَدر رافِعُهُ","فَاِختَبا أَو عَقلي اِختَبَلا",71,"ل",2,0],["أو حاملاً أثقال أحماله","تلك التي لا في جواليق",72,"ق",1,0],["أوحشتَني يا رسمُ أم آنستني؟","وأقمتَ عُرسًا في الحشا أم مأتما؟",73,"م",2,0],["أو حاربَتْ معه أبا","لِسَةُ الجحيم مدجَّجين",74,"ن",1,0],["أو حاجب فظُّ من الحُجَّاب","وأنت جالسٌ على الأَعْتاب",75,"ب",1,0],["أو حرْبةٌ مَسْنُونَةً، أو مدْفَعًا","متفجرًا، أو صَارمًا، أوْ خِنْجَرا!",76,"ر",2,0],["أو حاول الأداب مبتدعا لها","راض العقول وروض الأفهاما",77,"م",2,0],["أو حاولي أن تصبحي ، لعبة","أخرى ، ومدّي نظرة كائده",78,"د",2,0],["أوحى \" الزعيمُ \" إلى الجزيرةِ كلَّها","أنْ ليسَ يُدركُ بالكلام طِلاب",79,"ب",1,0],["أُوحِشَتْ أرْبُعُ العَقيقِ وَدُورُهْ،","لأنيسٍ أجَدّ مِنها بُكُورُهْ",80,"ر",2,1]]}