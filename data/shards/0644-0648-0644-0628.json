{"poems":[[649,"","https://poetry.dctabudhabi.ae/diwan/poem/98028","السريع"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216556",""],[4987,"باب الرجى","https://www.poetsgate.com/ViewPoem.aspx?id=49557",""],[5002,"أحلامٌ مهاجرةٌ...","https://www.poetsgate.com/ViewPoem.aspx?id=207238",""],[5225,"يا غيث يا ليث","https://www.poetsgate.com/ViewPoem.aspx?id=27610",""],[5539,"الطموح","https://www.poetsgate.com/ViewPoem.aspx?id=192481",""]],"verses":[["لَو لَبِس القوهيَّ من رقّةٍ","أَوجعهُ القوهيُّ أو خدَّشا",0,"ش",2,0],["لو لَبَّسنيه فِيْ الأسد خام","بالبس وفِيْ الكِلّهْ مَرافيع",1,"ع",1,0],["لو لبسو ساقط الهرجه ثياب المديح","قلنا سحابة وبلة يابس حلوقها",2,"ق",3,0],["لوْلبستُ الظَّنَّ ماصُنْتُ عَهدًا","ماجَفَْيتُ الْحَالَ والآنَ ذَابا",3,"ب",2,0],["لو لبّسوهن عقودٍ للغراشيبي","تاهن على الغيدْ في ملبوسها السامي",4,"م",2,0],["لو لبسلك وشاح ولو عزف لك بناي","ولو ضحكلك ترى ضحكته ساعة صفاه",5,"ف",3,0]]}