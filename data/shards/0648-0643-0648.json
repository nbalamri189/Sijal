s://www.aldiwan.net/poem54775.html","البسيط"],[142,"إحدى الكواعب من بنى نصر","https://www.aldiwan.net/poem58404.html","أحذ الكامل"],[143,"أبى الدهر إلا أن تقول وتفعلا","https://www.aldiwan.net/poem11799.html","الطويل"],[169,"سائل ديار الحي من ماوان","https://www.aldiwan.net/poem1687.html",""],[181,"أمنك أميم الدار غيرها البلى","https://www.aldiwan.net/poem58861.html","الطويل"],[193,"يا من دعانا دعوة لم تتم","https://www.aldiwan.net/poem13134.html","الكامل"],[197,"عشق المجد والهوى فكرة تنمو","https://www.aldiwan.net/poem39874.html","الخفيف"],[209,"غار مثل النجم من خلف البحور","https://www.aldiwan.net/poem26480.html","عموديه"],[223,"غلواء ما أحلى المعطارا","https://www.aldiwan.net/poem39711.html","الرجز"],[223,"كعاب أتت في الحسن فخر الكواعب","https://www.aldiwan.net/poem41907.html","الطويل"],[225,"يا راميا من تحت أج","https://www.aldiwan.net/poem55195.html","مجزوء الكامل"],[229,"رب ليل وصلته بصبوح","https://www.aldiwan.net/poem50909.html","الخفيف"],[237,"أشكر لمندوصة خير الأخايير","https://www.aldiwan.net/poem18831.html","البسيط"],[237,"جمرات الوداع والله حسبي","https://www.aldiwan.net/poem19787.html","الخفيف"],[259,"رفع الآله مقام إبراهيما","https://www.aldiwan.net/poem35741.html","الكامل"],[270,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[270,"إذا غاب جسمي في الثرى رافقي ظلي","https://www.aldiwan.net/poem35631.html","الطويل"],[270,"رأيت الشرق ملكا للنبي","https://www.aldiwan.net/poem35655.html","الوافر"],[275,"تناضل عن دين الهدى وتدافع","https://www.aldiwan.net/poem25485.html","الطويل"],[280,"متى ارتجعت مواهبها الكرام","https://www.aldiwan.net/poem60717.html","الوافر"],[280,"أبا حسن لئن كانت أجابت","https://www.aldiwan.net/poem60736.html","الوافر"],[290,"ما لقصر الزهور أضحى كئيبا","https://www.aldiwan.net/poem11707.html","الخفيف"],[300,"ألم ترم الأطلال من حول جعشم","https://www.aldiwan.net/poem45455.html","الطويل"],[304,"قل للذي قد لامني","https://www.aldiwan.net/poem16785.html","مجزوء الرجز"],[304,"يا سائلي عن عبرتي ومدامي","https://www.aldiwan.net/poem16845.html","الخفيف"],[320,"لست أنسى يوما لمجلس أنس","https://www.aldiwan.net/poem61649.html","البسيط"],[349,"أقبل صبحي وسفر","https://www.aldiwan.net/poem15721.html","مجزوء الرجز"],[350,"أعرفت رسم الدار بالحبس","https://www.aldiwan.net/poem640.html",""],[377,"أيا وامقي ألبكر مريم لا تنوا","https://www.aldiwan.net/poem59131.html","الطويل"],[380,"استغر الله العظيم العفو","https://www.aldiwan.net/poem47411.html","الرجز"],[380,"يا مكثرا من ذم كل ذميم","https://www.aldiwan.net/poem48760.html","الخفيف"],[380,"يا من تناءت داره","https://www.aldiwan.net/poem48797.html","مجزوء الكامل"],[396,"أبينت رسم الدار أم لم تُبينِ","https://www.aldiwan.net/poem621.html",""],[400,"تلاميذ النبوة","https://www.aldiwan.net/poem6731.html","عموديه"],[402,"حيث روض الصبا أريض وغصن","https://www.aldiwan.net/poem46554.html","الخفيف"],[402,"فيك أما في سواك فلا","https://www.aldiwan.net/poem46911.html","المديد"],[403,"أتسأل عن رحيلي يا بن ودي","https://www.aldiwan.net/poem33966.html","الوافر"],[416,"أينكر معروفنا المنكر","https://www.aldiwan.net/poem54039.html","المتقارب"],[429,"صاح وافى داعي الهناء يشير","https://www.aldiwan.net/poem40995.html","الخفيف"],[432,"أي فؤاد فيك لم يكلف","https://www.aldiwan.net/poem12670.html","السريع"],[439,"كفي شئونك ساعة فتأملي","https://www.aldiwan.net/poem34808.html","الكامل"],[439,"قل للربيع اسحب ملاء سحائب","https://www.aldiwan.net/poem34876.html","الكامل"],[441,"إليك صبت أفيدتنا ولاها","https://www.aldiwan.net/poem14392.html","الوافر"],[441,"عزاء يا بني شرف","https://www.aldiwan.net/poem14463.html","مجزوء الوافر"],[453,"لماذا أعزي بل لماذا أهنىء","https://www.aldiwan.net/poem61308.html","الطويل"],[458,"أفاق بها من طول سكرته الدهر","https://www.aldiwan.net/poem56161.html","الطويل"],[461,"واني على همي بعصري وأهله","https://www.aldiwan.net/poem15938.html","الطويل"],[464,"لو كنت شاهد ليلة فضيتها","https://www.aldiwan.net/poem3126.html","عموديه"],[468,"لك عندي دستيجة مختومه","https://www.aldiwan.net/poem59675.html","الخفيف"],[468,"يا من قليب إخائه","https://www.aldiwan.net/poem60453.html","مجزوء الكامل"],[479,"الوافر","https://www.aldiwan.net/poem36955.html","الوافر"],[479,"ألا بالتعاضد فلنبتد","https://www.aldiwan.net/poem37579.html","المتقارب"],[529,"دعي لومي على فرط الهواء","https://www.aldiwan.net/poem37548.html","الوافر"],[538,"صنعة الشعر لقد عافتك","https://www.aldiwan.net/poem47428.html","عموديه"],[540,"وبنات نعش يستدرن كأنها","https://www.aldiwan.net/poem56829.html","الكامل"],[551,"خذوا من جفوني ماءها فهي ذرف","https://www.aldiwan.net/poem47400.html","الطويل"],[551,"خليلي ألا عجتما بالقلائص","https://www.aldiwan.net/poem47739.html","الطويل"],[558,"بيني وبينك يا قديم جدار","https://www.aldiwan.net/poem34529.html","الكامل"],[558,"غصن بان فوقه البدر بدا","https://www.aldiwan.net/poem34653.html","الرمل"],[567,"أي أب رزيته","https://www.aldiwan.net/poem69562.html","مجزوء الرجز"],[567,"شطت لليلى باللوى","https://www.aldiwan.net/poem69615.html","مجزوء الرجز"]],"verses":[["وَكَواعِبٍ تَشْكو الوُشاةَ كَما شَكَتْ","أَرْدافَها عِنْدَ القِيامِ خُصورُها",0,"ر",3,1],["وَكَواعِبٍ مِثلِ الدُمى أَصبَيتُه","يَنظُرنَ في خَفرٍ وَحُسنِ دَلالِ",1,"ل",1,0],["وَكَوى قَلبي بِما أَسمَعَني","مِن كَلامٍ وَقعُهُ وَقعُ السِهام",2,"م",1,0],["وكوْكَبُ أفْقِ الغَرْبِ لمْ يَبْقَ بعْدَهُ","وبعْدَ ابْنِهِ منْ كوْكَبٍ متوقِّدِ",3,"د",1,0],["وَكَورٍ عِلافِيٍّ وَقِطعٍ وَنُمرُقٍ","وَوَجناءَ مِرقالِ الهَواجِرِ عَيهَمِ",4,"م",1,0],["وَكونوا كَما كُنّا نَكونُ وَحافِظوا","عَلَينا كَما كُنّا نُحافِظُ عَن رُهمِ",5,"م",1,0],["وكؤوس المدام تجلو عروسا","اضحك المزج ثغرها عن لال",6,"ل",1,0],["وكونوا له عوناً على ما يَهُبّه","يكن لكم عوناً على ما يهدِّد",7,"د",1,0],["وكونوا كالبغايا إن خدعتم","وإن أقررتم ضيماً لوغدِ",8,"د",1,0],["وَكوني كَما كانَت بِأُحدٍ صَفِيَّةٌ","وَلَم يُشفَ مِنها بِالبُكاءِ غَليلُ",9,"ل",1,0],["وكوكب فضل قدرُه قد سما به","إلى أن بكى حزناً عليه عطارد",10,"د",1,0],["وَكونوا كَأَنَّ الذُعرَ لَم تَشعُروا بِهِ","إِذا لَقِيَت بَكرٌ عَلى حَنَقٍ بَكرا",11,"ر",2,0],["وَكونوا عَلى مَخشِيَّةٍ مِن رِماحِنا","بَني عَبدِ بَكرٍ فَاِنظُروا نَظَراً شَزرا",11,"ر",2,0],["وَكُؤوسي الأَوراقُ أَلقَت عَلَيها","الشَمسُ ذَوبَ النُضارِ عِندَ الغِيابِ",12,"ب",1,0],["وَكَوكَبٍ أَسمَعتُهُ زَفرَتي","فَباتَ مِثلِيَ ساهِياً ساهِرا",13,"ر",2,0],["وَكوفِئَ عَن قَتلِهِ القاتِلُ","بِمالٍ جَزيلٍ وَخَدٍّ أَسيل",14,"ل",1,0],["وكؤوسُ الغرامِ أَترعَهَا الفَجْ","رُ ولكنْ تَحَطَّمَتْ في يدَيَّا",15,"ي",2,0],["وَكونوا حائِطاً لا صَدعَ فيهِ","وَصَفّاً لا يُرَقَّعُ بِالكَسالى",16,"ل",2,0],["وَكَواكِبُ الجَوزاءِ تَخطُرُ في الرُبى","وَالنَسرُ مَطلَعُهُ مِنَ الأَشجارِ",17,"ر",1,0],["وكوّن الآثار علوية","والمعدن المكروه والطيّبُ",18,"ب",1,0],["وكوّن هذه الأكوان حر","وبرد منهما يبس ولين",19,"ن",1,0],["وَكَواكِبٍ أَشرَقنَ مِن أَبنائِهِ","لَولاكَ قَد أَفَلَ النَدى بِأُفولِها",20,"ل",3,0],["وَكَومٍ مَهاريسِ العَشاءِ مُراحَةٍ","عَلَينا أَتاها بَعدَ هَدءٍ خَبيبُها",21,"ب",3,0],["وَكَومٍ تَنعَمُ الأَضيافُ عَيناً","وَتُصبِحُ في مَبارِكِها ثِقالا",22,"ل",2,1],["وكوكبٌ في ذُرى سمراءَ مُغرِبَةٍ","إذا تمادَى القنا نَحرٌ وتَامورُ",23,"ر",1,0],["وكواكب ليست بمجدية","ظلم مكدسة وأحجار",24,"ر",1,0],["وُكورُ اليَتامى في السِنينَ فَمَن نَبا","بِفَرخٍ لَهُ وَكرٌ فَنَحنُ لَهُ وَكرُ",25,"ر",1,0],["وكونوا لابناءِ العمومةِ إخوةً","كراماً يَغيظون العدوَّ المُكابرا",26,"ر",2,0],["وكَواعِبٍ مَحفُوفَةٍ بعَصائِبٍ","قد كُلِّلَتْ بالدُّرّ والمَرْجانِ",27,"ن",1,0],["وَكَوكَبِ قَومٍ كانَ نَحساً عَلَيهِمُ","زَماناً فَلَمّا قُمتَ أَطلَعتَهُ سَعدا",28,"د",2,0],["وَكورُكَ فَوقَ طَويلِ المَطا","وَسَرجُكَ فَوقَ شَديدِ القَرا",29,"ر",2,0],["وَكَونُها في طَريحِ الجِسمِ أَحوَجَها","إِلى مَلابِسَ عَنَّتها وَأَقواتِ",30,"ت",1,0],["وَكَونُ الجِسمِ في جَسَدي خَبيّاً","أَشَقُّ عَلَيهِ مِن هَرَمٍ وَضُعفِ",31,"ف",1,0],["وَكَونُ الروحِ في الأَجسامِ أَلقى","نَفاراً في الخُدودِ مِنَ النِعالِ",32,"ل",1,0],["وَكَونُ الفَتى في رَهطِهِ نَيلُ عِزَّةٍ","عَلى أَنَّ داءَ الدَهرِ لَيسَ لَهُ حَسمُ",33,"م",1,0],["وَكونا كَريمَينِ بَينَ الأَني","سِ لا تَنمُلانِ وَلا تَأثُوانِ",34,"ن",1,0],["وَكَونَن لَها في كُلِّ أَمرٍ مُخالِفاً","فَما لَكَ خَيرٌ في بَنيها وَلا فيها",35,"ي",3,0],["وكَوْنُ جَوابِهِ في الوَزْنِ ذَنْبٌ","ولكِنْ لم تَزَلْ مَوْلىً صَفُوحا",36,"ح",2,0],["وكوْكَباً لِيَ منهمْ كانَ مَغْرِبُهُ","قَلْبِي ومَشْرِقُهُ مَا بَيْنَ أَطْواقِي",37,"ي",1,0],["وكؤوس من السماء تشهّت","حور رضوان عطرها والرّحيقا",38,"ق",2,0],["وَكَواعِبٍ مِثلِ الدُمى أَصبَيتُها","يَنظُرنَ في خَفرٍ وَحُسنِ دَلالِ",39,"ل",1,0],["وَكَوَالِحَ الأَصْلاَدِ نَمَّ نَبَاتُهَا","خِلَساً عَنِ التَّحْنَانِ فِي الأَصْلاَدِ",40,"د",1,0],["وَكَوْنُ هَذَا الأَمْيرِ ال","جَلِيلِ فِي الضَّيْمِ كَهْفَهْ",41,"ف",2,0],["وَكَوَصْفِهِ الوَصْفُ الَّذِي","عَنْ رُؤيَةِ الرَّائِي يَنُوبُ",42,"ب",1,0],["وَكَوْدِّهِ فَلْيَشْرَعِ الوُدَّ","النَّقِيَّ المُشْرَعِ",43,"ع",1,0],["وكُونُوا كَمَنْ يَشْرِي الحياةَ تَقرّباً","إلى ملِكٍ يُحيَا لَدَيْهِ ويُرجَعُ",44,"ع",1,0],["وكؤوسي مريرة مثل صحوي","واجتماعي بإخوتي كانفرادي",45,"د",2,0],["وكوني: من حَبَاب الماء، أو من","عَبِير الزَّهر، أو ألق النُّجوم",46,"م",1,0],["وكونوا في ادَّراء الخطب عنكم","يداً تَبني بها العَضُدُ الَّذراعا",47,"ع",2,0],["وكوت فؤاداً قد أضربه الجوى","ظلماً وقالت لن تراني فاسكن",48,"ن",1,0],["وكونوا جيمعاً كلكم لا تفرقوا","فتبدُو ملاماتٌ لكم وخِصامُ",49,"م",1,0],["وكونوا مِن اللهِ العزيز يكنْ لكمْ","ولا تعدلوا فالسيئاتُ عِظَامُ",49,"م",1,0],["وكَونُكَ إبنَ جَلاَ يَحتَاجُ بَيِّنَةً","إِذِ الصَّوابُ عِندَنَا أنَّكَ إبنُ خَلا",50,"ل",2,0],["وَكَونُ أُمِّكَ ما عَقَّت يُكَذِّبُهُ","ما عاشَ بَيٌّ مُهاناً جائِعاً وَجِلا",50,"ل",2,0],["وكَونُ بي أبِيكََ القدمِ شِيمَتهُ","بَينَ الوَرَى أَخذُهُ في كَفِّهِ أُكُلا",50,"ل",2,0],["وكوت مياسِمُهُ قلوبَهم","والكىُّ مشفاةٌ لذى العرِّ",51,"ر",1,0],["وَكونوا كَأَشياخٍ لَكُم غالَها الرَدى","تَرى المَوتَ مِن نَقضِ المَواثيقِ أَسهَلا",52,"ل",2,0],["وَكَواعِباً بِذَوي العُقُولِ لَواعِباً","بِيضَ الخُدودِ نَواعِمَ الأَبدانِ",53,"ن",1,0],["وَكُونِى عَلَى الوَاشِينَ لَدّاءَ شَغبةً","كما أَنَا لِلوَاشِى أَلَدُّ شَغُوبُ",54,"ب",1,0],["وَكُوزُ ماءٍ مِن قراحٍ شَبمِ","لَكِن جَبنتَ عَن طِراد اللُقَمِ",55,"م",1,0],["وكؤوس الردى يطوف بها الهو","ل فللّه سكرة الندمان",56,"ن",1,0],["وكؤوس تنعش الإنسان في","ظلم الأكواخ أو ظل القصور",57,"ر",1,0],["وَكُوَمَ الثَلج عَلى الرَوابي","تَطفو عَلَيها صُفرَةُ الغِيابِ",58,"ب",1,0],["وَكوني عَلى رُغمِ النَوائِبِ لبوةً","تَسيرُ معَ الأَشبالِ فَوقَ النَوائِبِ",59,"ب",1,0],["وَكواكبُ الجَوزاءِ وَه","ى العِقدُ في نَسَقٍ تُحلُّ",60,"ل",1,0],["وكؤوسُ المدامِ تحمل منها","نَسَمَ المِسكِ في لميع البروقِ",61,"ق",1,0],["وَكَوْنُهُ فيِ ذُرَى تِطْوَانَ مَطْلَعِهِ","بَدْرَ عَلاَءٍ حَبَاهَا خَيْرَ تَنْوِيرِ",62,"ر",1,0],["وَكَوَانِي الْفِرَاقُ بِالنَّارِ كَيَّا","أَهْلَ حُبِّي لَمْ تَزَلْ فِي ارْتِفَاعِ",63,"ع",1,0],["وكؤوس أنسي من مدامة حبّه","تجلَى وبات مزاجها تسنيما",64,"م",2,0],["وكونوا عليهِ عاكفين تنافساً","وباروا الألى فازوا بأكبرِ حصة",65,"ه",1,0],["وكُوني لمن يحمي العفافَ مُحبّةً","ولا تمزجي الخمرَ العتيقةَ بالخل",66,"ل",1,0],["وكونوا أُمّةً يومَ التنادي","على أُممٍ من الغَربِ الغوي",67,"ي",1,0],["وَكَوْنُكَ في أبْناءِ سَعْدٍ مُشايِعاً","لآل رَسولِ اللَّهِ فِيمَنْ يُشَايِعُ",68,"ع",1,0],["وَكَوْنِي مِنْ دِفاعِكَ فِي حُصُونٍ","مَنِيعاتِ الذَّوائِبِ لا تُرامُ",69,"م",1,0],["وَكَوْنُكَ وَالسَّماحُ إِلَيْكَ أَشْهى","مِنَ الْماءِ الزُّلالِ إِلى الظِّماءِ",70,"ا",2,0],["وكؤوس المنون في طلب العلياء","أشهى من عيشه في هوان",71,"ن",1,0],["وَكَوماءَ تَحبو ما تَشايَعَ ساقُها","لَدى مِزهَرٍ ضارٍ أَجَشَّ وَمَأتَمِ",72,"م",1,0],["وكوشفت أسراره","وحل في برج الوصول",73,"ل",1,0],["وكواكب وثواقب ومصابح","ومعالم وأدلة للمهيع",74,"ع",1,0],["وَكُؤوسُ الطِلا تُدارُ عَلَينا","مِن مَليحٍ لا تَنظُرَ الشَمسَ بَعدَه",75,"د",2,0],["وَكَونُهُ مِن نورِ نو","رِ مَن عَنِ الذاتِ اِنفَطَر",76,"ر",1,0],["وَكَواعبٍ هيفٍ مُخَصَّرَةِ ال","أَبدانِ من بيضٍ ومن لُعسِ",77,"س",1,0],["وكونوا بأمنٍ وارتياحٍ وبهجةٍ","وحظٍّ وسعدٍ زيَّنته الفضائل",78,"ل",1,0],["وكونُهُ رياضةٌ للفِكرِ","يَقبَلُهُ العقلُ بِغَير نُكرِ",79,"ر",1,0],["وَكَوامن الحُساد لا تَخفى وَكَم","زِند يَبوح بِسره المَكتوم",80,"م",1,0],["وَكُؤوسَهُ نوّاره","وَالطل فيهِ عِقاره",81,"ر",2,0],["وكور على أنماط بيضٍ مزخرف","مدينيّةٍ أوفى بها حجّ مسكن",82,"ن",1,0],["وكوّنتم لكم قاموس شتمٍ","صديد حروفه يؤذي الكراما",83,"م",2,0],["وكؤوس السرورِ بين النّدامى","دائراتٍ من كفٍّ ذات قِناعِ",84,"ع",1,0],["وكؤوسٍ مِنْ مَرَاشفِهِ","حوتِ الصَّهباءَ والعَسَلا",85,"ل",2,0],["وكونوا كيف شئتم إن عهدي","هو العهد القديم وإن وجدي",86,"ي",1,0],["وكونوا بَني رجلٍ واحدٍ","إذا أَنكروا منكراً غيَّروا",87,"ر",3,0],["وكؤوس الآمال أهدت نجاحا","حين دارت بنا ولذّ الحضورُ",88,"ر",1,0],["وكوكبُ غيّبَهُ حادث","كما بَدا في ليلِه المُسْدِفِ",89,"ف",1,0],["وكواكِبَ الجوزاءِ تَهْوِي جُنَّحاً","مِثْلَ الخوامِسِ قَدْ عَدَلْنَ لِمَنْهَلِ",90,"ل",1,0],["وكواكِبٌ ناءَتْ بِقرْبَتِها النَّوى","فَقَضَتْ مدامِعُهَا بِنَوءِ الغارِبِ",91,"ب",1,0],["وكونت العقول لها دليلاً","ضلالتها بها وبها هداها",92,"ا",3,0],["وكونوا طوع أمكم","لتجمع شمل لمكم",93,"م",1,0],["وكونوا كلكم نجبا","صبيكمو يكون أبا",93,"ب",2,0],["وكونوا رعايا بينه لا مواليا","فما كان مولى من يخون ويهزأ",94,"ا",1,0],["وكوشف حتى لم تحصِّنْه رِقْبةٌ","ولم يبق بابٌ للحياء ولا سِترُ",95,"ر",1,0],["وكونِ مديحي رُشْوةً أحتمي بها","من القوم لا شيْماً لصوْبِ عَطاءِ",96,"ا",2,0],["وكواكب الشَّمع المضاعف نوره","زهرٌ لجالستَ النجوم مع الفلك",97,"ك",1,0],["وَكُؤوسٌ مِنها النَحيفَةُ تُجلى","بِأَكاليلِها وَمِنها الجَسيمَه",98,"م",2,0],["وَكَوامِخٌ بَيتِيَّةٌ","كَمُخَمِّرِ المِسكِ المُذابِ",99,"ب",1,0],["وكونوا الروضة الغناء تزهو","بأنوار المعارف واليقين",100,"ن",1,0],["وكونوا لرايتنا رافعين","فهل للعزيمة من موقد",101,"د",1,0],["وكونوا رجالا يصان حماهم","فهل للحمية من عضد",101,"د",1,0],["وكُوني عَنْ سُلُوِّي في سُلُوٍّ","إِذا أَنْوَى الْحَبيبُ عَلَى النَّواءِ",102,"ا",2,0],["وكَوَى منه فُؤاداً","وانثَنى عنه ومَلَّه",103,"ه",1,0],["وَكَواكِبُ الجَوزاءِ مِثلُ عَوائِدٍ","تَمري لَهُنَّ قَوادِمٌ وأَواخِرُ",104,"ر",1,0],["وكونوا لنا إمّا عدوّاً مجاملاً","وإمّا صديقاً دهرَه يتلطّفُ",105,"ف",1,0],["وَكونوا اِبتِداءَ الفخرِ لا غايةً له","وثَبْتين في مرأىً وفي فحص فاحِصِ",106,"ص",1,0],["وكواكب الأفلاك قبل ظهورنا","أصل لنا تزجى بنا وتدار",107,"ر",1,0],["وكؤس الأنس بالقوم صفت","وبنا الورد إليه وردا",108,"د",2,0],["وَكَوْكَبِي بَاخَ فَقَدْ","دَجَا ظَلاَمِي وَحَلَكْ",109,"ك",1,0],["وَكَوكَبُ السُّرُورِ فِي اسْ","تِقَامَةٍ لَمْ يَنْهَبِطْ",110,"ط",1,0]]}