{"poems":[[63,"وكواعب تشكو الوشاة كما شكت","https://www.aldiwan.net/poem46092.html","الكامل"],[3,"عفت الديار وباقي الأطلال","https://www.aldiwan.net/poem190.html",""],[55,"بأبي من ضن عني بالسلام","https://www.aldiwan.net/poem26138.html","الرمل"],[77,"أهاجتك ذكرى من خليط ومعهد","https://www.aldiwan.net/poem36601.html","الطويل"],[9,"ألا قل لتيا قبل مرتها اسلمي","https://www.aldiwan.net/poem21979.html","الطويل"],[9,"بني عمنا لا تبعثوا الحرب بيننا","https://www.aldiwan.net/poem21980.html","الطويل"],[82,"عللاني بذكر تلك الليالي","https://www.aldiwan.net/poem29397.html","الخفيف"],[88,"سل الإنكليزي الذي لم يزل له","https://www.aldiwan.net/poem44790.html","الطويل"],[37,"ألا أبلغ جماعة أهل مرو","https://www.aldiwan.net/poem6907.html","الوافر"],[47,"مصابي جليل والعزاء جميل","https://www.aldiwan.net/poem25177.html","الطويل"],[72,"ألا في سبيل الله فرع كتابة","https://www.aldiwan.net/poem18575.html","الطويل"],[29,"هنيء أجيبي دعوة إن سمعتها","https://www.aldiwan.net/poem6046.html","الطويل"],[91,"سئمت نفسي الحياة مع الناس","https://www.aldiwan.net/poem8747.html","عموديه"],[91,"عيناك والسحر الذي فيهما","https://www.aldiwan.net/poem8855.html","عموديه"],[91,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[92,"نحن نمشي وحولنا هاته الأك","https://www.aldiwan.net/poem38888.html","الخفيف"],[85,"حياة ما نريد لها زيالا","https://www.aldiwan.net/poem62956.html","الوافر"],[85,"تلك الطبيعة قف بنا يا ساري","https://www.aldiwan.net/poem63715.html","الكامل"],[62,"قد كانت الأفلاك في بدئها","https://www.aldiwan.net/poem52238.html","السريع"],[62,"بدا الحركات ثم انفك عنها","https://www.aldiwan.net/poem52240.html","الوافر"],[45,"تلك الديار ودارسات طلولها","https://www.aldiwan.net/poem65581.html","الكامل"],[28,"يقول الأطباء المداوون إذ خشوا","https://www.aldiwan.net/poem1281.html",""],[28,"وكوم تنعم الأضياف عينا","https://www.aldiwan.net/poem5381.html","الوافر"],[61,"ناديك من مطر الإحسان ممطور","https://www.aldiwan.net/poem51687.html","البسيط"],[97,"قالت تعال فقلت لبيك","https://www.aldiwan.net/poem25091.html","أحذ الكامل"],[44,"تصدت وحبل البين مستحصد شزر","https://www.aldiwan.net/poem29676.html","الطويل"],[105,"أعدوا لأعلام البيان المنابرا","https://www.aldiwan.net/poem42086.html","الطويل"],[75,"كفي فأيسر من مرد عناني","https://www.aldiwan.net/poem69028.html","الكامل"],[50,"خليلي غضا ساعة وارحلا بردا","https://www.aldiwan.net/poem63877.html","الطويل"],[46,"سرينا وطالبنا هاجع","https://www.aldiwan.net/poem22047.html","المتقارب"],[46,"مر الزمان فأضحى في الثرى جسد","https://www.aldiwan.net/poem22210.html","البسيط"],[46,"غدونا مثقلين بما اكتسبنا","https://www.aldiwan.net/poem22996.html","الوافر"],[46,"تعالى الله وهو أجل قدرا","https://www.aldiwan.net/poem23232.html","الوافر"],[46,"سيسأل ناس ما قريش ومكة","https://www.aldiwan.net/poem23280.html","الطويل"],[46,"أواني هم فألقى أواني","https://www.aldiwan.net/poem23545.html","المتقارب"],[46,"إن كنت قد أوتيت لبا وحكمة","https://www.aldiwan.net/poem23568.html","الطويل"],[46,"ألاح وقد رأى برقا مليحا","https://www.aldiwan.net/poem23637.html","الوافر"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30474","البسيط"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9960","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55524","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54994","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67319","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142334","الخفيف"],[106,"صفاء النفس!","https://www.poetsgate.com/ViewPoem.aspx?id=179324",""],[90,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""]],"verses":[["وَكَواعِبٍ تَشْكو الوُشاةَ كَما شَكَتْ","أَرْدافَها عِنْدَ القِيامِ خُصورُها",0,"ر",3,1],["وَكَواعِبٍ مِثلِ الدُمى أَصبَيتُه","يَنظُرنَ في خَفرٍ وَحُسنِ دَلالِ",1,"ل",1,0],["وَكَوى قَلبي بِما أَسمَعَني","مِن كَلامٍ وَقعُهُ وَقعُ السِهام",2,"م",1,0],["وكوْكَبُ أفْقِ الغَرْبِ لمْ يَبْقَ بعْدَهُ","وبعْدَ ابْنِهِ منْ كوْكَبٍ متوقِّدِ",3,"د",1,0],["وَكَورٍ عِلافِيٍّ وَقِطعٍ وَنُمرُقٍ","وَوَجناءَ مِرقالِ الهَواجِرِ عَيهَمِ",4,"م",1,0],["وَكونوا كَما كُنّا نَكونُ وَحافِظوا","عَلَينا كَما كُنّا نُحافِظُ عَن رُهمِ",5,"م",1,0],["وكؤوس المدام تجلو عروسا","اضحك المزج ثغرها عن لال",6,"ل",1,0],["وكونوا له عوناً على ما يَهُبّه","يكن لكم عوناً على ما يهدِّد",7,"د",1,0],["وكونوا كالبغايا إن خدعتم","وإن أقررتم ضيماً لوغدِ",8,"د",1,0],["وَكوني كَما كانَت بِأُحدٍ صَفِيَّةٌ","وَلَم يُشفَ مِنها بِالبُكاءِ غَليلُ",9,"ل",1,0],["وكوكب فضل قدرُه قد سما به","إلى أن بكى حزناً عليه عطارد",10,"د",1,0],["وَكونوا كَأَنَّ الذُعرَ لَم تَشعُروا بِهِ","إِذا لَقِيَت بَكرٌ عَلى حَنَقٍ بَكرا",11,"ر",2,0],["وَكونوا عَلى مَخشِيَّةٍ مِن رِماحِنا","بَني عَبدِ بَكرٍ فَاِنظُروا نَظَراً شَزرا",11,"ر",2,0],["وَكُؤوسي الأَوراقُ أَلقَت عَلَيها","الشَمسُ ذَوبَ النُضارِ عِندَ الغِيابِ",12,"ب",1,0],["وَكَوكَبٍ أَسمَعتُهُ زَفرَتي","فَباتَ مِثلِيَ ساهِياً ساهِرا",13,"ر",2,0],["وَكوفِئَ عَن قَتلِهِ القاتِلُ","بِمالٍ جَزيلٍ وَخَدٍّ أَسيل",14,"ل",1,0],["وكؤوسُ الغرامِ أَترعَهَا الفَجْ","رُ ولكنْ تَحَطَّمَتْ في يدَيَّا",15,"ي",2,0],["وَكونوا حائِطاً لا صَدعَ فيهِ","وَصَفّاً لا يُرَقَّعُ بِالكَسالى",16,"ل",2,0],["وَكَواكِبُ الجَوزاءِ تَخطُرُ في الرُبى","وَالنَسرُ مَطلَعُهُ مِنَ الأَشجارِ",17,"ر",1,0],["وكوّن الآثار علوية","والمعدن المكروه والطيّبُ",18,"ب",1,0],["وكوّن هذه الأكوان حر","وبرد منهما يبس ولين",19,"ن",1,0],["وَكَواكِبٍ أَشرَقنَ مِن أَبنائِهِ","لَولاكَ قَد أَفَلَ النَدى بِأُفولِها",20,"ل",3,0],["وَكَومٍ مَهاريسِ العَشاءِ مُراحَةٍ","عَلَينا أَتاها بَعدَ هَدءٍ خَبيبُها",21,"ب",3,0],["وَكَومٍ تَنعَمُ الأَضيافُ عَيناً","وَتُصبِحُ في مَبارِكِها ثِقالا",22,"ل",2,1],["وكوكبٌ في ذُرى سمراءَ مُغرِبَةٍ","إذا تمادَى القنا نَحرٌ وتَامورُ",23,"ر",1,0],["وكواكب ليست بمجدية","ظلم مكدسة وأحجار",24,"ر",1,0],["وُكورُ اليَتامى في السِنينَ فَمَن نَبا","بِفَرخٍ لَهُ وَكرٌ فَنَحنُ لَهُ وَكرُ",25,"ر",1,0],["وكونوا لابناءِ العمومةِ إخوةً","كراماً يَغيظون العدوَّ المُكابرا",26,"ر",2,0],["وكَواعِبٍ مَحفُوفَةٍ بعَصائِبٍ","قد كُلِّلَتْ بالدُّرّ والمَرْجانِ",27,"ن",1,0],["وَكَوكَبِ قَومٍ كانَ نَحساً عَلَيهِمُ","زَماناً فَلَمّا قُمتَ أَطلَعتَهُ سَعدا",28,"د",2,0],["وَكورُكَ فَوقَ طَويلِ المَطا","وَسَرجُكَ فَوقَ شَديدِ القَرا",29,"ر",2,0],["وَكَونُها في طَريحِ الجِسمِ أَحوَجَها","إِلى مَلابِسَ عَنَّتها وَأَقواتِ",30,"ت",1,0],["وَكَونُ الجِسمِ في جَسَدي خَبيّاً","أَشَقُّ عَلَيهِ مِن هَرَمٍ وَضُعفِ",31,"ف",1,0],["وَكَونُ الروحِ في الأَجسامِ أَلقى","نَفاراً في الخُدودِ مِنَ النِعالِ",32,"ل",1,0],["وَكَونُ الفَتى في رَهطِهِ نَيلُ عِزَّةٍ","عَلى أَنَّ داءَ الدَهرِ لَيسَ لَهُ حَسمُ",33,"م",1,0],["وَكونا كَريمَينِ بَينَ الأَني","سِ لا تَنمُلانِ وَلا تَأثُوانِ",34,"ن",1,0],["وَكَونَن لَها في كُلِّ أَمرٍ مُخالِفاً","فَما لَكَ خَيرٌ في بَنيها وَلا فيها",35,"ي",3,0],["وكَوْنُ جَوابِهِ في الوَزْنِ ذَنْبٌ","ولكِنْ لم تَزَلْ مَوْلىً صَفُوحا",36,"ح",2,0],["وكوْكَباً لِيَ منهمْ كانَ مَغْرِبُهُ","قَلْبِي ومَشْرِقُهُ مَا بَيْنَ أَطْواقِي",37,"ي",1,0],["وَكَواعِبٍ مِثلِ الدُمى أَصبَيتُها","يَنظُرنَ في خَفرٍ وَحُسنِ دَلالِ",38,"ل",1,0],["وَكَوَالِحَ الأَصْلاَدِ نَمَّ نَبَاتُهَا","خِلَساً عَنِ التَّحْنَانِ فِي الأَصْلاَدِ",39,"د",1,0],["وَكَوْنُ هَذَا الأَمْيرِ ال","جَلِيلِ فِي الضَّيْمِ كَهْفَهْ",40,"ف",2,0],["وَكَوَصْفِهِ الوَصْفُ الَّذِي","عَنْ رُؤيَةِ الرَّائِي يَنُوبُ",41,"ب",1,0],["وَكَوْدِّهِ فَلْيَشْرَعِ الوُدَّ","النَّقِيَّ المُشْرَعِ",42,"ع",1,0],["وكُونُوا كَمَنْ يَشْرِي الحياةَ تَقرّباً","إلى ملِكٍ يُحيَا لَدَيْهِ ويُرجَعُ",43,"ع",1,0],["وكؤوسي مريرة مثل صحوي","واجتماعي بإخوتي كانفرادي",44,"د",2,0],["وكوني: من حَبَاب الماء، أو من","عَبِير الزَّهر، أو ألق النُّجوم",45,"م",1,0],["وكونوا في ادَّراء الخطب عنكم","يداً تَبني بها العَضُدُ الَّذراعا",46,"ع",2,0]]}