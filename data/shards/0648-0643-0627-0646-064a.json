1563.html","الخفيف"],[451,"وطن الدولار هذا أم ترى","https://www.aldiwan.net/poem61565.html","الرمل"],[451,"سألوني لم ارتحلت كأني","https://www.aldiwan.net/poem61618.html","الخفيف"],[456,"لنا من ليلنا بلِوى الصريمِ","https://www.aldiwan.net/poem55891.html","الوافر"],[456,"طوى الليل راكب أخطاره","https://www.aldiwan.net/poem56164.html","المتقارب"],[459,"أجل ما رمت في آت مقتبل","https://www.aldiwan.net/poem15134.html","البسيط"],[466,"أيها التيس الذي ما","https://www.aldiwan.net/poem59560.html","مجزوء الرمل"],[475,"أقفر من سكانه المعهد","https://www.aldiwan.net/poem15224.html","السريع"],[493,"دعا فأجابه القدح","https://www.aldiwan.net/poem9811.html","مجزوء الوافر"],[513,"ثغر الزمان بنجم الدين مبتسم","https://www.aldiwan.net/poem12263.html","البسيط"],[514,"وكان يقودني كلف بسعدى","https://www.aldiwan.net/poem48588.html","الوافر"],[527,"أقول من بعد حمد والصلاة على","https://www.aldiwan.net/poem37209.html","البسيط"],[549,"من على هذه الديار أقاما","https://www.aldiwan.net/poem47232.html","الخفيف"],[549,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[549,"ليس للقلب في السلو نصيب","https://www.aldiwan.net/poem48092.html","الخفيف"],[560,"نحن التراب إلى تراب نرجع","https://www.aldiwan.net/poem52741.html","الكامل"],[560,"ضاق الرثاء بنا من فرط ما اتسعا","https://www.aldiwan.net/poem52762.html","البسيط"],[573,"أخبروني عن مرهف القد مطبو","https://www.aldiwan.net/poem2698.html","الخفيف"],[573,"أمورد يا ناظري أم وريد","https://www.aldiwan.net/poem3088.html","الرجز"]],"verses":[["وَكانَ يَسوءُ السامِعينَ سَماعُها","فَصارَ يَهولُ الناظِرينَ عِيانُها",0,"ن",3,0],["وَكَأَنَّ يَومَ الإِذنِ يَبرُزُ مِنهُمُ","أَسدُ الثَرى وَأَساوِدُ الغيطانِ",1,"ن",1,0],["وَكَأَنّي خِلَلَ الغَيبِ أَرى","نَغرَةً مِن جُرحِها بَعدَ اِندِمالِ",2,"ل",1,0],["وَكأَنّي أَرى بِأَطلالِهِ وَش","ماً خَفيّاً بِمعصَمَيْ ظَمياءِ",3,"ا",2,0],["وكانَ يُحْمَلُ ما كُنّا نُكابِدُهُ","منَ المشقّةِ لوْ أنّ البَرى غِيثا",4,"ث",2,0],["وَكانَ يُحامي حينَ تَنزِلُ لَزبَةٌ","مِنَ الدَهرِ في ذُبيانَ إِن حَوضُها اِنهَدَم",5,"م",1,0],["وَكَأَنَّي بِالْغَرْبِ يَرْنُو إِلَيْكُمْ","لِيَرَى قِمَةَ الْحَيَاةِ لَدَيْكُمْ",6,"م",1,0],["وَكَأَنّي مُلجِمٌ سوذانِقاً","أَجدَلِيّاً كَرُّهُ غَيرُ وَكَل",7,"ل",1,0],["وكان يقال إن بني نزار","لَعلاَّت فأمسوا توأمينا",8,"ن",2,0],["وكَانَ يقال إنَّ ابني نِزَار","لَعلاَّت فأَمسَوا تَوأمِينَا",9,"ن",2,0],["وَكانَ يَعافُ حَملَ الضَيمِ قَلبي","فَقَرَّ عَلى تَحَمُّلِهِ قَراري",10,"ر",2,0],["وَكَأَنّي حينَ أَذكُرُها","مِن حُمَيّا قَهوَةٍ شارِبُ",11,"ب",1,0],["وكانَ يصيدُ الظبيَ فاحمُ لمَّتي","وأغربُ ما صادَ الظباءَ غراب",12,"ب",1,0],["وكأني غداً أراهم وكلٌّ","ينشر العذرَ طاوياً شَحناءَ",13,"ا",2,0],["وكأني أراك تهتف إيهٍ","تزجر الشعرَ حضرةَ الغوغاءِ",14,"ا",2,0],["وكأني في ظَنهِ ليس شأني","لَهْوُ ذي نُهيَةٍ ولا مُتصابِ",15,"ب",1,0],["وَكَأَنِّي بهم جِرَاءً تَضَاغَى","وعذابي عليهِمُ مصبوبُ",16,"ب",1,0],["وكأَنِّي لِوَحْشَتي","لك في وحشِ إصْمتِ",17,"ت",1,0],["وكأني وقد طويت إليك ال","ناس جاوزت نحو ماءٍ خروقا",18,"ق",2,0],["وَكانَ يُرى أَنَّ الجَزيرَةَ أَصبَحَت","مَواريثَ لِاِبنَي حاتِمٍ وَأَبي صَخرِ",19,"ر",1,0],["وَكَأَنَّي بِكَ حينَ تَهتِفُ قائِلٌ","لِلزَهرِ إِنَّ الحُسنَ غَيرُ مُخَلَّدِ",20,"د",1,0],["وكأني وراء سود المنايا","حمل يتبع الذئاب وديع",21,"ع",1,0],["وكأني من كل بيت بمصر","سامع رجع رنة وعويل",22,"ل",1,0],["وكأني كوخ عفته الاعاصير","فلم تبق منه الا طلول",23,"ل",1,0],["وكأن يوم ودعناهم","قد ركبنا للمنايا السفنا",24,"ن",2,0],["وكأني من العوا","صف جذع قد انقعر",25,"ر",1,0],["وكأني امرؤ غريب","عن الدار والاسر",25,"ر",1,0],["وكان يحييني نهارا شعاعها","وتبسم لي في ليلي الانجم الزهر",26,"ر",1,0],["وكأن يوم الغاصبين لحقهم","ليل وهذا الليل بحر مزبد",27,"د",1,0],["وكأني ارى حفيري بعيني","فاغراً فاه يبتغي لي ابتلاعا",28,"ع",2,0],["وَكانَ يَستَشيرُ في المَصائِبِ","وَهُوَ أَخو الرَأي السَديد الصائِبِ",29,"ب",1,0],["وَكانَ يُلقي الرُعبَ في القُلوبِ","بِكَثرَةِ السِلاحِ في الجُيوبِ",30,"ب",1,0],["وَكَأَنّي أَرى الجَزيرَةَ أَيكاً","نَغَمَت طَيرُهُ بِأَرخَمَ جَرسِ",31,"س",1,0],["وَكَأَنّي بَلَغتُ لِلعِلمِ بَيتاً","فيهِ ما لِلعُقولِ مِن كُلِّ دَرسِ",31,"س",1,0],["وكأنِّي أَرْمِي الهِضَابَ على حِينِ","وَنَاهُ بِقْطعَةٍ مِنْ هِضَابِ",32,"ب",1,0],["وكأنِّي رَفَعْتُ بالبَرْقِ شَمْلا","تي لَمّا ثَنَيْتُها بعقابِ",32,"ب",1,0],["وَكانَ يَدي شُلَّت وَنَفسي تُخُرِّمَت","وَدُنيايَ بانَت يَومَ بانَ وَديني",33,"ن",2,0],["وَكانَ يُجيرُ الناسَ مِن سَيفِ مالِكٍ","فَأَصبَحَ يَبغي نَفسَهُ مَن يُجيرُها",34,"ر",3,1],["وكأنيي لمّا ارتديتُ ظِلالَه","جارُ الوزيرِ المُرتدي بظِلالِه",35,"ل",2,0],["وكأنَّ يَومَ الدَّجْنِ من","هُ لِغُرَّةِ المَفقودِ شامِس",36,"س",1,0],["وَكانَ يَراني حُسنُ رَأيِكَ بِالَّتي","يُفَتِّتُ أَكبادَ العُداةِ مِنَ الغُبنِ",37,"ن",1,0],["وكأني في شاطئٍ مهجور","قد فارقتهُ سفينةٌ لا ترجعُ",38,"ع",1,0],["وكأني أرى بعين خيالي","ساهرَ المقلتين يغضي حياءَ",39,"ا",2,0],["وكأنَّ يومك في فجيعته","هو أول الأيامِ في الشَّجنِ",40,"ن",1,0],["وكأني محلق في سماء","ومطل منها على الأكوان",41,"ن",1,0],["وكأنّي في مِقْوَلٍ من زماني","مَشَلٌ وافدٌ على كلّ مسمع",42,"ع",1,0],["وكَأَنّي لعبةٌ في يَدها","ما لها تُتلفُ جِدّي بالمزاح",43,"ح",1,0],["وَكانَ يَرى سَمَّ الكَلامِ كَأَنَّما","يُقَشَّبُ أَحياناً بِسَمِّ الأَساوِدِ",44,"د",1,0],["وَكَانَ يَحْزُنُنِي شَيْبِي فَصِرْتُ أَرَى","أَنَّ الَّذِي بَعْدَهُ أَوْلَى بِإِحْزَانِي",45,"ي",1,0],["وكانَ يخافُ إبليسٌ سطاهُ","بوعظٍ للقلوبِ هوَ السياطُ",46,"ط",1,0],["وكان يهونُ ما نلقى ولكنْ","تعالَوا فانظروا مع مَنْ وقعنا",47,"ن",2,0],["وكانَ يَمُدْ زنداً للمنايا","فتتبعهُ مطاوعةٌ زنود",48,"د",1,0],["وَكَأَنّي قَد كُنتُ أَعلَمُ أَنّي","لَستُ إِلّا كَمَن بِهِ قَد غَدَرتا",49,"ت",2,0],["وكان يسومه شَططاً فيأبى","أحلَّ له الهجاءَ وكان خِبَّا",50,"ب",2,0],["وَكانَ يَراها بِعَين الأَريب","وَلَكنَّ للدَهر عينَ الرَقيب",51,"ب",1,0],["وَكَأَنّي بِعلمه البحر عمقاً","وَاِتِساعاً تَغشاه عَذب الوُرودِ",52,"د",1,0],["وكان يوم الثلاثا","شهدتُ فيه العجابا",53,"ب",2,0],["وَكَأَني بِهِ تجاذبه الأَو","هام رُعباً فَيَستوي اجفالا",54,"ل",2,0],["وَكَأَنّي مِنهُ بِأَلفِ كِتابٍ","وَرَسولٍ وَأَلفِ وَعدٍ مُزَوَّر",55,"ر",1,0],["وكانَ يُجيدُ صِفاتِ الجِيادِ","وإنّ بها اليْومَ عنهُ غِنَى",56,"ا",1,0],["وَكَأَنّي بُدِّلتُ بِالنَفسِ نَفساً","وَكَأَنَّ الفُؤادَ غَيرُ الفُؤادِ",57,"د",1,0],["وَكَأَنّي سُلِبتُ نَو","مي بِسِحرِ المُهَيِّجِ",58,"ج",1,0],["وَكَأَنّي مِن هَواها","بِبُكاءٍ وَصُماتِ",59,"ت",1,0],["وكان يَرجُو أنْ يُزيل العَسْكرا","عن جانبِ الحِصْن الذِي قد دُمِّرا",60,"ر",2,0],["وَكانَ يلبس أَرياشاً مزوقةً","كأَنَّه زهرة صفراء في الشجر",61,"ر",1,0],["وكأني اشيم من وجه ليلى","كوكباً في سمائه دريا",62,"ي",2,0],["وكأني بالقوم قد سمعوا ما قلته","موضحاً فثاروا غضابا",63,"ب",2,1],["وَكانَ يَعيش العَندَليبُ بمعزلٍ","عن الروض جم الهم إذ كانَ أجردا",64,"د",2,0],["وكانَ يبث الشجو في الناس شدوه","إلى أَن يهيج السمع والروح والذهنا",65,"ن",2,0],["وكانَ يُحمْحِمُ تَحْتَ العِذارِ","كحمْحمةِ الخَيْلِ تَحْتَ اللُّجمْ",66,"م",1,0],["وكانَ يوماً باقي الحديثِ وزا","لَت إمَّةٌ ثابِتُ مَراتُبها",67,"ب",3,0],["وَكَأَنِّي بِخَطْبِ أَحْمَدَ لَمْ يُبْ","قِ مَدىً لِلأَسَى أَذَاكَ الْخِتَامُ",68,"م",1,0],["وَكَأَنِّي بِه مِنَ الغَيْبِ يُمْلِي","فَتُعِيدُ الأصدَاءُ آيَاتِ شُكْرِ",69,"ر",1,0],["وَكَانَ يَسْعَى إِلَيْهَا","أَلِيفُهَا غَيْرَ هَادِي",70,"ي",1,0],["وَكَانَ يُغْنِيكُمْ جَمِيلُ الذِّكْرِ لَوْ","خَفَضْتُمُ اللَّحْدَ وَشِدتُمْ بِالهُدَى",71,"د",2,0],["وكان يحاول شيئا جديدا","وراح وخلف هذا الوجودا",72,"د",2,0],["وَكأَنّي يَعقوبُ بَثّاً وَحُزناً","فَإِلى اللَهِ مِثل شَكواهُ أَشكو",73,"ك",2,0],["وَكانَ يَرى الكُتّابَ قُرَّةَ عَينِهِ","إِذا صِبيةُ الكتّابِ مَلّوهُ لُوَّذا",74,"ذ",2,0],["وَكانَ يَدري حُلى الرفيقِ إِذا","لَم يَعلَم الناس أَيُّهُنَّ شَغا",75,"غ",2,0],["وَكَأَنّي عُلِّلتُ مِن نَشواتي","دونَ مَزٍّ مِنَ النَدامى بِمَزِّ",76,"ز",1,0],["وَكانَ يُصْغِي لِشِعْري","وَكانَ شِعْرِي عُجَابا",77,"ب",2,0],["وكأني بالماءِ سال على الغر","قى دموعًا من أعين الخزَّان",78,"ن",1,0],["وكأنِّي بظلها صار لفْحًا","كلما هب يَصْهَرُ الأبدانا",79,"ن",2,0],["وكأني بسلمها صار حربًا","واستحالت أنوارُها نيرانا",79,"ن",2,0],["وكان يُحمَلُ ما كنا نكابِدُهُ","من المشقة لو أن البراغيثا",80,"ث",2,0],["وكان يصغي فتدعو غيرها ابنتها","وجارة غيرها تخفي وتنكشف",81,"ف",1,0],["وكان يرنو ، وجوع الأربعين على","ذبول خدّيّه يستجدي و