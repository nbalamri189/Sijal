,"ني لعصري أو أنه لم يَسعني",149,"ي",1,0],["وكان يضيءُ لي أملي فأَسِري","فقد أضللتُ في الأملِ البهيمِ",150,"م",1,0],["وكان يلام فلما لجا","إلى العجز قام بأعذارِهِ",151,"ر",2,0],["وكان يهتزُّ للأشعارِ من طَربٍ","هزَّ القضيب بمر العاصف الزجِلِ",152,"ل",1,0],["وَكَأَنّي بِكَ تَغدو","آيَةً لِلسائِلينا",153,"ن",2,0],["وكانَ يرى فراقَ اليومِ صعباً","فكيف يكونُ في الأمدِ البعيدِ",154,"د",1,0],["وكان يقال إنهم","إذا بخل الورى سمحوا",155,"ح",3,0],["وكان يعرف مقداري وقد ذكروا","أن المعارف في أهل النهى ذمم",156,"م",1,0],["وَكانَ يَقودُني كلف بِسُعدى","وَهذا الشَيب أَصبَح قَد عَلاني",157,"ن",2,1],["وكانَ يَقْتُلُ في غَزْوِ الدّيارِ وَفي","سَفْكِ الدّماءَ في ذاكَ مِنْ لَوْمِ",158,"م",1,0],["وكأنّي لمّا رأيتُ بنى الدّه","ر غُفولاً رأيتُ منهمْ نياما",159,"م",2,0],["وكأنّي لما حملتُ به الثِّقْ","لَ تحمّلتُ يَذْبُلاً وشَماما",159,"م",2,0],["وَكأنّي أثنيكمُ عن قبيحٍ","بمقالي أزيدكم إصرارا",160,"ر",2,0],["وَكَأنّي بها مُعرَّقة الأوْ","صال قد شَفّها السُّرى والدُّؤوبُ",161,"ب",1,0],["وكان يَبقَى مَن تَوَدُّ الناسُ أنْ","يحيا بَقيتَ ولم يَمسَّكَ مَصرَعُ",162,"ع",1,0],["وكان يُبرِي مِن النَّاسِ الجِراحَ فهل","يُبري جِراحَ فُؤَادٍ بعدهُ انصَدَعا",163,"ع",2,0],["وكأَني بهم وقد عَلِمُوه","وقت أَن يَقْرَءُوه والله أَعْلم",164,"م",1,0],["وكان يَوْمَ العيد لي وجهه","فصار يوم العيد يوم الوعيد",165,"د",1,0]]}