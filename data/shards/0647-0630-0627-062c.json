{"poems":[[79,"زارت وقد صرف العنان الغيهب","https://www.aldiwan.net/poem36776.html","الكامل"],[95,"مجد الشآم أعدته فأعيدا","https://www.aldiwan.net/poem9162.html","الكامل"],[95,"خفقت لطلعة وجهك الأعلام","https://www.aldiwan.net/poem11374.html","الكامل"],[56,"من مبلغ عني إمام الهدى","https://www.aldiwan.net/poem27511.html","السريع"],[93,"أزف الرحيل وحان أن نتفرقا","https://www.aldiwan.net/poem8988.html","عموديه"],[72,"أوحشتني والله يا مالكي","https://www.aldiwan.net/poem42896.html","السريع"],[87,"عزيز من أهلا أخي","https://www.aldiwan.net/poem6966.html","مجزوء الرجز"],[87,"فلوس الشغل ما تأخير","https://www.aldiwan.net/poem7900.html","الكامل"],[87,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[64,"أصالة الرأي صانتني ( لامية العجم )","https://www.aldiwan.net/poem52315.html","البسيط"],[60,"هذا جناي وخياره فيه","https://www.aldiwan.net/poem30798.html","الرجز"],[46,"أمويس كيف رأيت نصب حبائلي","https://www.aldiwan.net/poem30010.html","الكامل"],[107,"ودع ذويك وسر في شأنك الجلل","https://www.aldiwan.net/poem44046.html","البسيط"],[107,"يا مطعم الجيش أشبعت السيوف دما","https://www.aldiwan.net/poem44069.html","البسيط"],[107,"سيري الهوينى دومة الجندل","https://www.aldiwan.net/poem44201.html","السريع"],[52,"أقبيص لست وإن جهلت ببالغ","https://www.aldiwan.net/poem63891.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85425","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85388","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85308","الرجز"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54643","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54636","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54729","الكامل"],[108,"ميلاد الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179497",""],[108,"من يد الرئيس","https://www.poetsgate.com/ViewPoem.aspx?id=179357",""],[92,"الخريف في فارس","https://www.poetsgate.com/ViewPoem.aspx?id=179054",""],[93,"وداع وشكوى","https://www.poetsgate.com/ViewPoem.aspx?id=53145",""],[96,"يا جارتي","https://www.poetsgate.com/ViewPoem.aspx?id=15618",""],[146,"من علم القلب ما يملى من الغزل","https://www.aldiwan.net/poem58449.html","البسيط"],[173,"بع واسطاً بالنأي والهجر","https://www.aldiwan.net/poem1629.html",""],[182,"أماه","https://www.aldiwan.net/poem50693.html","البسيط"],[182,"أرخى الضفائر","https://www.aldiwan.net/poem50716.html","البسيط"],[186,"هذا جمال الدين أمسى نازلا","https://www.aldiwan.net/poem67026.html","الكامل"],[202,"كذبت ظنونك ما العزاء جميلا","https://www.aldiwan.net/poem51898.html","الكامل"],[214,"رأى العقيق فأجرى دمعه لولو","https://www.aldiwan.net/poem13306.html","البسيط"],[215,"عدنا إلى الحب عدنا","https://www.aldiwan.net/poem46249.html","المجتث"],[229,"عش للعلا مولى وذخرا","https://www.aldiwan.net/poem55229.html","مجزوء الكامل"],[233,"يا نعمة أسبغها منعم","https://www.aldiwan.net/poem50937.html","السريع"],[274,"ها ردفها يأخذ من صدرها","https://www.aldiwan.net/poem35390.html","السريع"],[301,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[308,"نسيم حاجر يا نسيم حاجر","https://www.aldiwan.net/poem16790.html","الرجز"],[361,"أفدي الذي أرشف المقلين ريقته","https://www.aldiwan.net/poem4173.html","البسيط"],[381,"إني ودينك يا من جاد بالبعث","https://www.aldiwan.net/poem66896.html","البسيط"],[381,"شمس تسير مشارقا ومغاربا","https://www.aldiwan.net/poem66953.html","الكامل"],[443,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[443,"شكرا لمن أعطاك ما أعطاكا","https://www.aldiwan.net/poem34906.html","الكامل"],[451,"كل غرام لحسنكم تابع","https://www.aldiwan.net/poem53732.html","المنسرح"],[461,"يا مستضيم الملك أين الحامي","https://www.aldiwan.net/poem55873.html","الكامل"],[541,"للأرض شهب كالسما لا يرتجي","https://www.aldiwan.net/poem47988.html","عموديه"],[561,"لا معه نحن ولا معنا","https://www.aldiwan.net/poem33753.html","السريع"],[566,"هذا جواب غامض في كلمتي","https://www.aldiwan.net/poem13610.html","الكامل"]],"verses":[["هَذَا جَنَيَ غَرَسَتْهُ كَفّ رِضَاكَ لِي","فَهَصَرْتَهُ وَهْوَ الْكَثِيرُ الأَطْيَبُ",0,"ب",1,0],["هذا جميل من وفى كوفائه","أن يذكر القوم الفداة الصيدا",1,"د",2,0],["هَذَا جَزَاءُ الْمُخْلِصِينَ وَهَكَذَا","تُثْنِي عَلَى أَبْطَالِهَا الأَقْوَامُ",2,"م",1,0],["هَذا جَناحُ المُسلِمينَ الَّذي","قَد قَصَّهُ تَولِيَةُ الحاكَه",3,"ك",2,0],["هَذا جَزاءُ الجُمودِ ذَوي النُهى في أُمَّةٍ","أَخَذَ الجُمودُ عَلى بَنيها مَوثِقا",4,"ق",2,0],["هَذا جَفاءٌ مِنكَ ما اِعتَدتُهُ","وَلَيتَني أَعرِفُ مَن غَيَّرَك",5,"ك",1,0],["هذا جمال وحيد جَدّه","بخيلة يا عزيز جِلده",6,"ه",1,0],["هذا جفالك ذا عمارات كما","هذا مطابخ ثم يا مولاتي",7,"ت",2,0],["هَذا جَناهُ عَلَيكُمُ آباؤُكُم","صَبراً وَصَفحاً فَالجُناةُ كِرامُ",8,"م",1,0],["هذا جَزاءُ امرئٍ أقرانُه درَجُوا","من قَبْلهِ فتمنَّى فُسحةَ الأجلِ",9,"ل",1,0],["هَذا جَناي وَخَيارَهُ فيه","وَكُلُّ جانٍ يَدَهُ إِلى فيه",10,"ه",1,1],["هَذا جَزائي إِذ أُدَنِّسُ هِمَّتي","بِكَ جاهِلاً وَكَذا جَزاءُ الجاهِلِ",11,"ل",1,0],["هذا جَوادُكَ ما حَالتْ سَجِيَّتُه","ولا ارْتضَى بِوَفاءِ الحُرِّ من بَدَلِ",12,"ل",1,0],["هذا جَنَاهَا بأيدِي القومِ مُنْتَهَبٌ","واللَّهُ يكتبُ فَانْظُرْ هل تَرَى القَلَمَا",13,"م",2,0],["هذا جِوارُ اللَّهِ فاستبشري","وهذه جنّاتُه فادخلي",14,"ل",2,0],["هَذا جَزاؤُكَ يا قَبيصَ فَإِنَّهُ","جادَت يَداهُ وَأَنتَ قُفلُ حَديدِ",15,"د",1,0],["هَذا جزاء امرئٍ قَد كانَ في سعة","من المَعيشة إلا أنه كندا",16,"د",2,0],["هَذا جَزاء امرئٍ ملحِّ","غدا عَلى غيِّه وراحا",17,"ح",2,0],["هَذا جزاء شاعِر","مَع الهَوى مندفع",18,"ع",1,0],["هذا جميعُ الخرمِ لا سِواهُ","وهوَ قَبيحٌ عندَ من سَمَّاهُ",19,"ه",1,0],["هَذَا جَزَاؤُكَ فَاضِلاً فِي أُمَّةٍ","مَا زَالَ فِيهَا الأَلْمَعِيُّ غَرِيبَا",20,"ب",2,0],["هَذَا جَزَاؤُكَ يَا أَوْفَى","البَنِينَ لِمَنْ كَانَ الأَبَرُّ أَبَا",21,"ب",2,0],["هَذَا جَمِيلُ مَنْ وَفى كَوَفَائِه","أَنْ يَذْكُرَ الْقَوْمُ الغُدَاةَ الصيِّدا",22,"د",2,0],["هذا جهاد في سبيل الله ما","نضح الدم القاني على راياته",23,"ت",2,0],["هذا جمالٌ صافحتْ يدُهُ يَدِي","والقلب يخْفقُ عن جناحَيْ طائر",24,"ر",1,0],["هذا جمالٌ زانهُ نورُ الفضا","لا كجمالٍ حِفظُه يُضيعه",25,"ع",2,0],["هذا جزاء ذوي النّهى في أمّة","أخذ الجمود على بينها موثقا",26,"ق",2,0],["هذا جنون النفس في سكرها","والعقل من خدّام هذا الجنون",27,"ن",1,0],["هذا جَمال الورى تُطفى مناصلُه","نارَ القِرَى بدماء الأينُق البُزُلِ",28,"ل",1,0],["هَذا جَزاءُ النَظمِ فيكَ وَقَد","يُجزى الضِراطَ مُقَبِّلُ الحِجرِ",29,"ر",1,0],["هذا جَبينُكِ أطْلالٌ لذاكِرتي","عَليْهِ خَطَّ الضَّنَى مَرْثيةً تَنْعاهْ",30,"ا",2,0],["هذا جَبينكِ مِضيافٌ لأخيِلَتي","وفي لُجَيْنِهِ آياتٌ مِنَ الشَّفَقِ",31,"ق",1,0],["هَذا جَمالُ الدِّينِ أَمسى نازِلاً","جَدَثاً تَضمن مِنهُ أَيّ دَفينِ",32,"ن",1,1],["هذا جوادُ أبي شجاعٍ مخبرٌ","أن الجواد انقضَّ عنه قتيلا",33,"ل",2,0],["هذا جرى الماء عذبا من اصابعه","فما الفرات وما سيحون والنيل",34,"ل",1,0],["هذا جمال غريب","رأيته هل رأيتم",35,"م",1,0],["هذا جُلوسُك عيدهُ","مَلأَ المَلا بِشرا وَبُشرى",36,"ر",2,0],["هذا جوابٌ من فَتىً مُفْلسٍ","مُسوٍّف بالمَطْلِ للحُرْفِ",37,"ف",1,0],["هذا جناسٌ من جمالِ التي","سحرُ بياني كانَ من سِحرها",38,"ر",3,0],["هَذا جزاءُ من عَصى","نَصيحةً واِنتَقَصا",39,"ص",2,0],["هذا جمال الحق قد تجلى","ولم يكن محجوباً قبل كل",40,"ل",1,0],["هَذَا جَبِينِي مُوَارىً وَهوَ مُنفَلِت","فإِن يَكَن عِندَكُم كَيدٌ فَكيدوه",41,"د",3,0],["هذا جزاء الذي أدى مؤنتكم","نفساً وجسماً بأكل المن والشث",42,"ث",1,0],["هذا جهادُ أُولي البشارة والتقى","ملأوا النفوسَ من الحياة مواهبا",43,"ب",2,0],["هذا جَنايَ وغارَةٌ مشهودةٌ","عَدَلَتْ بِحُبِّ المُسْتَعينِ شُهُودُها",44,"د",3,0],["هذا جزاءُ الغَدْرِ لا عَدِمَ الهُدى","مولىً بسعيكَ فِي النفاق جزاكا",45,"ك",2,0],["هذا جمال الحبيب مقتدر","صيّر كل امرىء له طائع",46,"ع",1,0],["هذا جزايَ وليس ذلك نعمة","فيما مننتُ فكيفَ كان غرامي",47,"م",2,0],["هذا جزاءُ شَبيبةٍ فَعَّالَة","كانت تَرَى أقوالَها أقوى لَها",48,"ل",3,0],["هذا جنون الحق في عقلنا","يدريه من في الحق قد جنا",49,"ن",2,0],["هَذا جَوابٌ غامِضٌ في كِلمَتَي","شَرطٍ كَإِن وَإِذا مُرادُ تَكَلُّمي",50,"م",2,1]]}