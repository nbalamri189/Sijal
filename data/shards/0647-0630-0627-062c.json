e.com/ViewPoem.aspx?id=187361",""],[308,"أروضة تَبَسم عَن زهر","https://www.poetsgate.com/ViewPoem.aspx?id=189193",""],[5409,"أهزةٌ أيقظت من روعها البلدا","https://www.poetsgate.com/ViewPoem.aspx?id=155458",""],[5461,"كتبت لك","https://www.poetsgate.com/ViewPoem.aspx?id=5025",""],[5463,"ذا غرامك يا بنيّه فاق ماهم يوصفون","https://www.poetsgate.com/ViewPoem.aspx?id=33249",""],[5606,"ترى الزعل ممنوع يامودماني","https://www.poetsgate.com/ViewPoem.aspx?id=195382",""],[5652,"حظ / خايب","https://www.poetsgate.com/ViewPoem.aspx?id=177975",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[402,"ماذا أصاب أباك الشيخ واحربا","https://www.poetsgate.com/ViewPoem.aspx?id=35348",""],[402,"إربأ بنفسك أن تكون نجيبا","https://www.poetsgate.com/ViewPoem.aspx?id=35349",""],[5792,"حي الله اللي","https://www.poetsgate.com/ViewPoem.aspx?id=180354",""],[5823,"كم تقت للأقصى","https://www.poetsgate.com/ViewPoem.aspx?id=61555",""],[5837,"عبدالعزيز القنيدي","https://www.poetsgate.com/ViewPoem.aspx?id=181088",""],[5851,"عودة الهزار","https://www.poetsgate.com/ViewPoem.aspx?id=175281",""],[5862,"لوحة شقاوة حُ ب ... !!","https://www.poetsgate.com/ViewPoem.aspx?id=34637",""],[5939,"جحود","https://www.poetsgate.com/ViewPoem.aspx?id=178579",""],[5939,"تحذير شديد اللهجة لحبيبتي المتمردة","https://www.poetsgate.com/ViewPoem.aspx?id=178582",""],[5943,"يفوحُ عبيرا","https://www.poetsgate.com/ViewPoem.aspx?id=34645",""],[5943,"تشطير لقصيدة فات الأوان","https://www.poetsgate.com/ViewPoem.aspx?id=138274",""],[5956,"أشكو لمن ليخففَ الأحزانا؟","https://www.poetsgate.com/ViewPoem.aspx?id=215830",""],[5975,"في ولاء آل بيت الرسول","https://www.poetsgate.com/ViewPoem.aspx?id=53465",""],[6056,"قديمة نديمة","https://www.poetsgate.com/ViewPoem.aspx?id=130512",""],[6102,"سُحقًا لِقَلبكِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=184412",""]],"verses":[["هَذَا جَنَيَ غَرَسَتْهُ كَفّ رِضَاكَ لِي","فَهَصَرْتَهُ وَهْوَ الْكَثِيرُ الأَطْيَبُ",0,"ب",1,0],["هذا جميل من وفى كوفائه","أن يذكر القوم الفداة الصيدا",1,"د",2,0],["هَذَا جَزَاءُ الْمُخْلِصِينَ وَهَكَذَا","تُثْنِي عَلَى أَبْطَالِهَا الأَقْوَامُ",2,"م",1,0],["هَذا جَناحُ المُسلِمينَ الَّذي","قَد قَصَّهُ تَولِيَةُ الحاكَه",3,"ك",2,0],["هَذا جَزاءُ الجُمودِ ذَوي النُهى في أُمَّةٍ","أَخَذَ الجُمودُ عَلى بَنيها مَوثِقا",4,"ق",2,0],["هَذا جَفاءٌ مِنكَ ما اِعتَدتُهُ","وَلَيتَني أَعرِفُ مَن غَيَّرَك",5,"ك",1,0],["هذا جمال وحيد جَدّه","بخيلة يا عزيز جِلده",6,"ه",1,0],["هذا جفالك ذا عمارات كما","هذا مطابخ ثم يا مولاتي",7,"ت",2,0],["هَذا جَناهُ عَلَيكُمُ آباؤُكُم","صَبراً وَصَفحاً فَالجُناةُ كِرامُ",8,"م",1,0],["هذا جَزاءُ امرئٍ أقرانُه درَجُوا","من قَبْلهِ فتمنَّى فُسحةَ الأجلِ",9,"ل",1,0],["هَذا جَناي وَخَيارَهُ فيه","وَكُلُّ جانٍ يَدَهُ إِلى فيه",10,"ه",1,1],["هَذا جَزائي إِذ أُدَنِّسُ هِمَّتي","بِكَ جاهِلاً وَكَذا جَزاءُ الجاهِلِ",11,"ل",1,0],["هذا جَوادُكَ ما حَالتْ سَجِيَّتُه","ولا ارْتضَى بِوَفاءِ الحُرِّ من بَدَلِ",12,"ل",1,0],["هذا جَنَاهَا بأيدِي القومِ مُنْتَهَبٌ","واللَّهُ يكتبُ فَانْظُرْ هل تَرَى القَلَمَا",13,"م",2,0],["هذا جِوارُ اللَّهِ فاستبشري","وهذه جنّاتُه فادخلي",14,"ل",2,0],["هَذا جَزاؤُكَ يا قَبيصَ فَإِنَّهُ","جادَت يَداهُ وَأَنتَ قُفلُ حَديدِ",15,"د",1,0],["هَذا جزاء امرئٍ قَد كانَ في سعة","من المَعيشة إلا أنه كندا",16,"د",2,0],["هَذا جَزاء امرئٍ ملحِّ","غدا عَلى غيِّه وراحا",17,"ح",2,0],["هَذا جزاء شاعِر","مَع الهَوى مندفع",18,"ع",1,0],["هذا جميعُ الخرمِ لا سِواهُ","وهوَ قَبيحٌ عندَ من سَمَّاهُ",19,"ه",1,0],["هَذَا جَزَاؤُكَ فَاضِلاً فِي أُمَّةٍ","مَا زَالَ فِيهَا الأَلْمَعِيُّ غَرِيبَا",20,"ب",2,0],["هَذَا جَزَاؤُكَ يَا أَوْفَى","البَنِينَ لِمَنْ كَانَ الأَبَرُّ أَبَا",21,"ب",2,0],["هَذَا جَمِيلُ مَنْ وَفى كَوَفَائِه","أَنْ يَذْكُرَ الْقَوْمُ الغُدَاةَ الصيِّدا",22,"د",2,0],["هذا جهاد في سبيل الله ما","نضح الدم القاني على راياته",23,"ت",2,0],["هذا جمالٌ صافحتْ يدُهُ يَدِي","والقلب يخْفقُ عن جناحَيْ طائر",24,"ر",1,0],["هذا جمالٌ زانهُ نورُ الفضا","لا كجمالٍ حِفظُه يُضيعه",25,"ع",2,0],["هذا جزاء ذوي النّهى في أمّة","أخذ الجمود على بينها موثقا",26,"ق",2,0],["هذا جنون النفس في سكرها","والعقل من خدّام هذا الجنون",27,"ن",1,0],["هذا جَمال الورى تُطفى مناصلُه","نارَ القِرَى بدماء الأينُق البُزُلِ",28,"ل",1,0],["هَذا جَزاءُ النَظمِ فيكَ وَقَد","يُجزى الضِراطَ مُقَبِّلُ الحِجرِ",29,"ر",1,0],["هذا جَبينُكِ أطْلالٌ لذاكِرتي","عَليْهِ خَطَّ الضَّنَى مَرْثيةً تَنْعاهْ",30,"ا",2,0],["هذا جَبينكِ مِضيافٌ لأخيِلَتي","وفي لُجَيْنِهِ آياتٌ مِنَ الشَّفَقِ",31,"ق",1,0],["هَذا جَمالُ الدِّينِ أَمسى نازِلاً","جَدَثاً تَضمن مِنهُ أَيّ دَفينِ",32,"ن",1,1],["هذا جوادُ أبي شجاعٍ مخبرٌ","أن الجواد انقضَّ عنه قتيلا",33,"ل",2,0],["هذا جرى الماء عذبا من اصابعه","فما الفرات وما سيحون والنيل",34,"ل",1,0],["هذا جمال غريب","رأيته هل رأيتم",35,"م",1,0],["هذا جُلوسُك عيدهُ","مَلأَ المَلا بِشرا وَبُشرى",36,"ر",2,0],["هذا جوابٌ من فَتىً مُفْلسٍ","مُسوٍّف بالمَطْلِ للحُرْفِ",37,"ف",1,0],["هذا جناسٌ من جمالِ التي","سحرُ بياني كانَ من سِحرها",38,"ر",3,0],["هَذا جزاءُ من عَصى","نَصيحةً واِنتَقَصا",39,"ص",2,0],["هذا جمال الحق قد تجلى","ولم يكن محجوباً قبل كل",40,"ل",1,0],["هَذَا جَبِينِي مُوَارىً وَهوَ مُنفَلِت","فإِن يَكَن عِندَكُم كَيدٌ فَكيدوه",41,"د",3,0],["هذا جزاء الذي أدى مؤنتكم","نفساً وجسماً بأكل المن والشث",42,"ث",1,0],["هذا جهادُ أُولي البشارة والتقى","ملأوا النفوسَ من الحياة مواهبا",43,"ب",2,0],["هذا جَنايَ وغارَةٌ مشهودةٌ","عَدَلَتْ بِحُبِّ المُسْتَعينِ شُهُودُها",44,"د",3,0],["هذا جزاءُ الغَدْرِ لا عَدِمَ الهُدى","مولىً بسعيكَ فِي النفاق جزاكا",45,"ك",2,0],["هذا جمال الحبيب مقتدر","صيّر كل امرىء له طائع",46,"ع",1,0],["هذا جزايَ وليس ذلك نعمة","فيما مننتُ فكيفَ كان غرامي",47,"م",2,0],["هذا جزاءُ شَبيبةٍ فَعَّالَة","كانت تَرَى أقوالَها أقوى لَها",48,"ل",3,0],["هذا جنون الحق في عقلنا","يدريه من في الحق قد جنا",49,"ن",2,0],["هَذا جَوابٌ غامِضٌ في كِلمَتَي","شَرطٍ كَإِن وَإِذا مُرادُ تَكَلُّمي",50,"م",2,1],["هذا جزاؤك يا أبي في عالم","قد فر منه العدل وهو شريد",51,"د",1,0],["هذا جزاء الصالحين سعادة","ما أحرزتها في الحقيقة صيد",51,"د",1,0],["هذا جزاء الصالحين ففعلهم","عند الاله على الصحائف يرقم",52,"م",1,0],["هذا جزاءُ مُخالِفٍ مِثْلِي أبَى","تَقْوى الإلاه ودان بالعِصيانِ",53,"ن",1,0],["هذا جزاء امرىء أقرانه درجوا","من قبله فتمنى فسحة الأجل",54,"ل",1,0],["هذا جزاءُ الذي أَولَيتَ من حَسَنٍ","وإنما يحصدُ الإنسانُ ما زرَعا",55,"ع",2,0],["هذا جميلٌ على صناعتِهِ","ما صاغَ ما صُغْتُهُ ولا الأحوص",56,"ص",1,0],["هَذا جَزاؤُهُ وَأَما الذيب","فَاِشتَدَّ مِن جوعٍ بِهِ اللَهيب",57,"ب",1,0],["هَذا جَزاء مَن أَبى النَصيحه","وَمال بِالجَهل إِلى الفَضيحه",58,"ه",1,0],["هَذا جَزاء كُل بَطران","بِالحُكم يَطلب عَذابُه",59,"ه",1,0],["هذا جبين ابن حسام منشدي","عند الصباح بحمد القوم السرى",60,"ا",1,0],["هذا جميع كل ما في البيت","بلا دقيق يرتجي وزيت",61,"ت",1,0],["هذا جواب من لبو","س الجهل مخلوع الفِطَنْ",62,"ن",1,0],["هذا جزاء من قضى","ستينها من حجِج",63,"ج",1,0],["هَذا جَمالُكِ بازِغٌ بِجَلالِهِ","هَذا زَفيري بِالفُؤادِ تَسَعرا",64,"ر",2,0],["هذا جواد الخير عندك","مهمل لا يركب",65,"ب",1,0],["هذا جَسَدي عليكِ ثَوْبٌ","لا يَجْمُلُ أَنْ تُمَزِّقيهِ",66,"ي",2,0],["هَذا جحود ظاهر للصانع","وَقَصده بِالحَق وِالشرائع",67,"ع",1,0],["هذا جَزاءُ مُقَدّما","تي إِذ أَكون وَلَيسَ ثان",68,"ن",1,0],["هذا جنانك بالنوار مبتهجٌ","ومنيتي في جنان العز مأواها",69,"ا",3,0],["هذا جزاءُ فتىً تلاعبَ بالهوى","فاعتاض حلو العَيشِ بالأحزانِ",70,"ن",1,0],["هَذا جَنابُ المُعِزِّ لاحَ لَنا","قَد رُفِعَت نارُه عَلى عَلَمِه",71,"م",2,0],["هذا جزاء الصدق كل الصدق في","النيات والأقوال والافعال",72,"ل",1,0],["هذا جزاءُ ذوي المعارف فاقرأوا","بقصيدتي عظةً على الجهال",72,"ل",1,0],["هذا جَزاءُ الذي صَدَّ الأَنامَ عَن البَ","يتِ الحَرامِ عُتُوّاً مِنهُ أَو مَرَحا",73,"ح",2,0],["هَذَا جَزَاءُ المُعرِضِينَ عَن الهُدَى","مُتَعوِّضِينَ زَخَارِفَ الهَذَيَانِ",74,"ن",1,0],["هَذَا جَوَابُ الشَّافِعِي لأحمَدٍ","للهِ دَرُّكَ مِن إمَامِ زَمَانِ",74,"ن",1,0],["هَذا جَميلُكَ عِندي","أَعييَ ثَنائي عَلَيهِ",75,"ه",1,0],["هذا جَبينُ العيدِ مُؤْتَلِقٌ","متَوحّدٌ بالسَّبَعةِ النجُبِ",76,"ب",1,0],["هذا جَمَالُ العيدِ أَشْهَدُهُ","في وَجْهِكَ الوضَّاءِ عن كَثَبِ",76,"ب",1,0],["هذا جزائي إذ قصرت عليكم","صفو الوداد وسالف الأشواق",77,"ق",1,0],["هذا جَزا ما زرعتُم مِن مَكارمكم","وَزارع الكَرم يَجني طَيب العنب",78,"ب",1,0],["هذا جَميعاً صَرفوهُ عِندَنا","بِإِذن بارينا فَما أَضرّنا",79,"ن",2,0],["هَذَا جوابي كامِلٌ","عن لغزِكَ الملتَبِسِ",80,"س",1,0],["هَذَا جاهُك والمَالُ العَرِيضُ وأَه","لُ الأرضِ ما بينَ خُدَّامٍ وحُسَّادِ",81,"د",1,0],["هذا جمال نفوس الناس تدركه","وهماً وهذا جمال الوجه والجسد",82,"د",1,0],["هذا جمالك خمرتي","فأنا أُعربد منه سكرا",83,"ر",2,0],["هذا جوابي الحق أرسلته","شعرا كما أنتَ ترجّيته",84,"ت",2,0],["هذا جزاكم دائماً","عندي وأيّ الناس يجزِيَ",85,"ز",2,0],["هذا جنوني ولكن لا أعيش به","بلذة وهني عيش المجانين",86,"ن",1,0],["هذا جوابك كِلّه اهوال","«ثاني» اتثبَّت بالحكي الزين",87,"ن",1,0],["هذا جزاء رسول الله من فئة","قلوبهم ملؤها إثم ونيران",88,"ن",1,0],["هذا جلالُ الدين وهو أبو علي","هذا جليل الأصل ذو السر الجلي",89,"ي",1,0],["هذا جمالك فاحذر أيها القمرُ","إذا رنا لك خلق الله أو نظرُوا",90,"ر",3,1],["هذا جزائيَ من كل الألى فتنوا","قلبي قضاءُ النوى منهم بحرمان",91,"ن",1,0],["هذا جزاؤُك قلبي دع محبتها","وانت يا قلمي اوصافها اختصر",92,"ر",1,0],["هذا جمالي وذا عزي وذا شرفي","هذا دلالي وذا عيني وذا ورقي",93,"ق",2,0],["هَذَا جَوَابُ اللُّغزِ يَا نَبِيلُ","قد جَاءَ وَهوَ قَاطِعٌ دَلِيلُ",94,"ل",1,0],["هذا جَزاءُ الكِبرِ فانعَم","في جوائز كِبرِيائِك",95,"ك",1,0],["هذا جناه أبي عل","ى وما جنيت على حبيب",96,"ب",1,0],["هذا جلال الدين قد","خفقت بنوده في الوجود",97,"د",1,0],["هذا جزا فئةٍ خانَت بما فجرت","لم تَخشَ حَقاً وَلم تلزمه توقيرا",98,"ر",2,0],["هَذا جزاءٌ وفاقٌ طبق ما اجترموا","فَطال ما اجترحوا من سيِّئٍ جورا",98,"ر",2,0],["هذا جناه بنو التمدن فاعجبوا","كيف التمدن متلف ومبيد",99,"د",1,0],["هذا جَمالُكِ يَدعوني لِأَعشَقَه","لكِنَّ ثَغرَكِ يا دُنيايَ ما نَبَسا",100,"س",2,0],["هَذا جناني وَهَذي مُقلتي وَأَنا","منها إِليه أَجر الويل وَالفرجا",101,"ج",2,0],["هَذا جَزاء الَّذي امناتُه ريحَت","اضعاف اضعافها مُذ كانَ يتجرُ",102,"ر",1,0],["هذا جَوابي وَالجَوى بي كامِن","فَلِذا غَدا شَرحي بِهِ تَقصير",103,"ر",1,0],["هذا جَوابُكَ فَاِستُر لي مثالبه","فَلا بَرِحتَ مِنَ النُعمى عَلى سرر",104,"ر",1,0],["هذا جواب فضله لغيري","فإنني عنهم حملت ميري",105,"ي",1,0],["