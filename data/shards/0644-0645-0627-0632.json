.com/ViewPoem.aspx?id=178482",""],[5667,"آهِ من أرضِ دبي","https://www.poetsgate.com/ViewPoem.aspx?id=214804",""],[5956,"شوقي لك يزدادُ ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182224",""],[5956,"مولدِ الطفل أدهم إيهاب","https://www.poetsgate.com/ViewPoem.aspx?id=193097",""],[5956,"كل تقصير لديهم بأداء الضَّخِ","https://www.poetsgate.com/ViewPoem.aspx?id=194199",""],[5956,"الخيال وأفراح الإفراج","https://www.poetsgate.com/ViewPoem.aspx?id=194699",""],[6004,"جَنَّةٌ للنِّسَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=59595",""],[6052,"أنت المنار","https://www.poetsgate.com/ViewPoem.aspx?id=49595",""],[6102,"استِنزاف","https://www.poetsgate.com/ViewPoem.aspx?id=182845",""],[6125,"قَابَ قَوسَينِ","https://www.poetsgate.com/ViewPoem.aspx?id=210207",""],[6185,"ذاتُ الوشاح !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86946&r=&rc=6",""],[6202,"يا أبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86763&r=&rc=64",""]],"verses":[["لِمازِنٍ صَخرَةٌ صَمّاءُ راسِيَةٌ","تُنبي الصَفا حينَ تَرديهِنَّ صَيخادُ",0,"د",1,0],["لَم أَزَل ثابِتاً عَلى الهَجرِ حَتّى","خَفَّ صَبري وَقَلَّتِ الأَنصارُ",1,"ر",1,0],["لم أزل منذ غاب شخصك عني","أرتجي وصل كتبه والوصالا",2,"ل",2,1],["لما زاد في الشرب الذي قد تركته","من الراح خيرٌ منك في الشرب زائدا",3,"د",2,0],["لم أزَلْ قِدْماً وقلبي ويدي","ولساني لك مُذْ كنتُ جُنودُ",4,"د",1,0],["لم أزلْ ناسكاً فأصبحتُ في الحب","بِ خليعاً في حلبةِ الفُتَّاكِ",5,"ك",1,0],["لم أزل منك في نعيم مقيم","لم يزل عند رِحلتي ومُقامي",6,"م",2,0],["لَم أَزَل أَلمَحُ طَيفَ المَجدِ حَتّى في السَرابِ","لَم أَزَل أَستَشعِرُ اللَذَّةَ حَتّى في العَذابِ",7,"ب",1,0],["لَم أَزَل أَستَشرِفُ الحُسن وَلَو تَحتَ نِقابِ","ما بِنَفسي خَشيَةُ المَوت وَلا مِنهُ اِرتِهابي",7,"ب",2,0],["لَم أَزَل في رَبقَةِ اليَأسِ إِلى","أَن أَعادَ الحُبُّ لي بَعضَ الرَجا",8,"ج",2,0],["لم ازل شاعراً هد ركني","كبر لي وفت في اعضادي",9,"د",2,0],["لم ازل بالحياة صباً وان نؤ","ت بستين من سني وخمس",10,"س",1,0],["لم ازل هكذا إلى","أن بدا الحق واشتهر",11,"ر",1,0],["لَم أَزَل بِالخِداعِ أَسقيهِ حَتّى","وَضَعَ الكَأسَ مائِلاً يَتَكَفّا",12,"ف",2,0],["لَما زادَني مِن خَشيَةٍ إِذ حَبَستَني","عَلى الخَشيَةِ الأولى الَّتي كُنتَ تَعلَمُ",13,"م",1,0],["لَم أَزَل عالِماً بِأَن لَيسَ خَلقٌ","دامَ حُلواً إِلّا وَسَوفَ يُذاقُ",14,"ق",1,0],["لَم أَزَل أُبغِضُ الخَميسَ وَلَم أَد","رِ لِماذا حَتّى دَهاني الخَميسُ",15,"س",1,0],["لَم أَزَل في ذِمامِهِ المُعظَمِ المُك","رَمِ حَتّى ظَنَنتُهُ في ذِمامي",16,"م",2,0],["لَمّا زَهِدتَ زَهِدتَ في جَمعِ الغِنى","وَلَقَد رَغِبتَ فَكُنتَ فيهِ أَزهَدا",17,"د",2,0],["لَم أَزَل بارِدَ الجَوانِحِ مُذ خَض","خَضتُ دَلوي في ماءِ ذاكَ القَليبِ",18,"ب",1,0],["لَمّا زَكا غُصُناً في دَوحِ سُؤدُدِكُم","تاهَت قَنا الخَطِّ لَمّا قيلَ أَغصانُ",19,"ن",1,0],["لَم أَزَل آمُلُ المَزيدَ وَلا فَك","كَرتُ في ذا المِطالِ وَالحِرمانِ",20,"ن",1,0],["لَم أَزَل أَخلَعُ في الحُبِّ الرَسَن","وَفُؤادي عِندَ ظَبيٍ مُرتَهِن",21,"ن",1,1],["لَم أَزُر سَلمى وَلَم تُلمِم بِنا","غَيرَ رُؤياها أَنِم عَيناً تُزَر",22,"ر",1,0],["لَم أَزَل مِن هَوى عُبَيدَةَ أَهوى","ما يَليها حَتّى هَويتُ الرِياحا",23,"ح",2,0],["لم أزَل أقرأُ حتى سجدوا","وَجَعَلتُ الخُلدَ عُنوان الكتاب",24,"ب",1,0],["لم أزَلْ أرقبُ السماءَ إلى","أن أطَلَّ الشتاءُ بالسُّحُبِ",25,"ب",1,0],["لَم أَزَل آوي إِلى الرُكنِ مِنهُ","وَإلى الرُكنِ القَويمِ القَوِيِّ",26,"ي",1,0],["لما زاد حظُّك من عِيشة","على حظّ ذي العاهةِ المُقْعَد",27,"د",1,0],["لَمْ أَزَلْ بلخِداعِ أَسقِيهِ حتَّى","وضَع الكأسَ مَائلاً يَتَكَفَّا",28,"ف",2,0],["لم أزلْ ناسكاً فأصبحتُ في ال","حبّ خليعاً في حلبة ِ الفُتَّاكِ",29,"ك",1,0],["لم أَزَلْ في هواهُ طولَ زماني","وهو في ذلتي يزيدُ انتصارُه",30,"ر",2,0],["لم أزل سامعاً بفضلك حتى","حقق اللَّحظ عنك ما قد رواه",31,"ا",2,0],["لم أزل والوجد روحي متلف","مستهام في هواه مدنف",32,"ف",1,0],["لم أزل أحرز اللسان على الكت","مان حتّى تكلَّمت أنفاسي",33,"س",2,0],["لم ازل طوع الهوى احفظه","ما له حفظ عهودي ضيعا",34,"ع",2,0],["لم أَزل منكَ بين بِرٍّ وقُرْبٍ","أَيادٍ تَتْرَى بِغَيرِ امتِنانِ",35,"ن",1,0],["لم أزل لله عبداً","وبهذا أتزكّى",36,"ك",2,0],["لما زهى زهرُ الربيع بروضه","وغدا له فضلٌ يبين عليه",37,"ه",1,1],["لَم أَزَل بِالبابِ واقِفٌ","فَأَدِم رَبّي وُقوفي",38,"ي",1,0],["لم أزل في حال عشرته","نازلاً بالمنزل الخضل",39,"ل",1,0],["لم أزُرْ غيرَكم ولو لم أجِدْ ما","ءً تَيمّمْتُ بالفلاةِ صَعيدا",40,"د",2,0],["لم أزَلْ أشْفعُ فيكم طارِفاً","من مَديحي بتليدٍ من وَلائي",41,"ا",2,0],["لم أزل أستظلُّ بالصبر حتى","لا تراني عَيْنُ الحياةِ حزينا",42,"ن",2,0],["لم أزد إلا غراماً وجوى","وفؤاداً خافقاً مضطرباً",43,"ب",2,0],["لم أزل حتَّى أوارى في الثرى","مقصراً فيهم ثنائي ومطيلا",44,"ل",2,0],["لم أزلْ من بعدها أرجو لها","عَوْدَة تبري بقلبي الأَلما",45,"م",2,0],["لم أزل أحظى لديكم بالغنى","والعطاءِ الجمِّ والمال الجزيل",46,"ل",1,0],["لم أزل أرتجيك في هذه الد","نيا وأرجوك بعدها في المعاد",47,"د",1,0],["لما زال يُوسِعُ هَذَا وتلكَ","بفعلٍ كَريم وذكرٍ جميلِ",48,"ل",1,0],["لم أزل بالوفاء والعمل الحي","كأني في مصر أحمي الذمار",49,"ر",1,0],["لم أزل في الغنى وفي الفقر يخشا","ني زماني مذ قلتُمُ أنتَ مِنَّا",50,"ن",2,0],["لم أزلْ أصبرُ علماً أنه","أبداً يُعقَبُ خيراً من صَبَرْ",51,"ر",1,0],["لَمْ أَزَلْ أَرْقُبُ وَعْداً","مِنْكَ يا زَيْنَ الزَّمانِ",52,"ن",1,1],["لمَّا زمَاني عضَّنِي","وصِحتُ آهُ آهُ",53,"ا",2,0],["لم أزلْ مُغضِياً على هَفَواتٍ","منه لو جُزْنَني لكنتُ غبيا",54,"ي",2,0],["لم أزلْ أسأل فيهن","نَ على الفقر بخيلا",55,"ل",2,0],["لَم أَزَلْ مُبغضاً لكلِّ نذيرٍ","للمنايا حتّى نعاه النّاعي",56,"ع",2,0],["لَم أَزِدْهُ شيئاً وَبينَ ضُلوعي","كلُّ شَوقٍ على مَليحِ العتابِ",57,"ب",1,0],["لم أزل منه بالجوى أتقلَّى","ليته كان لي معيناً وهلا",58,"ل",2,0],["لم أزل بالله في هممِ","في وجود كنت أو عدمِ",59,"م",1,0],["لم أزل في الحب يا أملي","أخلط التوحيد بالغزلِ",60,"ل",1,1],["لم أَزلْ في كفِّ ساقٍ","أو على ثَغْرِ نديمِ",61,"م",1,0],["لَما زَها خَد بِحُسن تَورُّدِ","هامَ الفُؤاد بِهِ وَطابَ تَوردي",62,"د",2,1],["لم أزل أعذله أن يعتلي","صهوةَ الجُرْد وأن لا يأمنا",63,"ن",2,0],["لم أزل خائفاً عليكم وإن حا","سنتموه المخادع الغدارا",64,"ر",2,0],["لم أزلْ حاذراً عليكَ ولكنْ","ليس ينجو خَلْقٌ من المحذور",65,"ر",1,0],["لم أزل أُعملُ التلطُّفَ للور","دِ حِذاراً أن يُغْلَبَ النُوّار",66,"ر",1,0],["لَم أَزَل يا بَحرَ السّخاءِ فَقيراً","مُستَمدّاً أَخا الحِجى مِن مِدادِكْ",67,"ك",1,0],["لم أزل في شبه من عودها","فبدا الشيب مزيلا لاشتباهي",68,"ا",3,0],["لم أزل أطلعها في راحتي","وهي فيه غرب حتى سجد",69,"د",1,0],["لم أزل أذكرُ المروءةَ منهم","مدة العمر قِعْدةً وقياما",70,"م",2,0],["لَم أَزَل أخفي هَواه فَلَقَد","صارَ ما أَخفيت جُهدي عَلَنا",71,"ن",2,0],["لما زها طالع الأقبال وانتشرت","أعلامه البيض بالأفراح معتلنَهْ",72,"ن",2,0],["لم أزل ما دمت حياًّ انظمُ","حسن توشيح معانيه غرر",73,"ر",1,0],["لما زهى بالانس طالع سعده","أرخت عشت مصوّناً يا جرجسُ",74,"س",1,0],["لَمْ أَزْوِ مِنْ رِزْقِكَ يا مَاقتي","شَيْئاً فهذا المقْتُ لي ممَّهْ",75,"م",2,0],["لم ازل ادعكمو يا سادتي","قايلا يا سادتي عطفا علي",76,"ي",1,0],["لم أزل فيك أشكر الوصل حتى","أزف البعد فإغتدى الوصل هجرا",77,"ر",2,0],["لم أزل في الطلا سبع سنيني","أتأتى لذاك من كل باب",78,"ب",1,0],["لم أزل أصحَبُ في وَجدي به","جسداً مُضنىً وطَرفاً أَرِقا",79,"ق",2,0],["لم أزل ألهو به حتَّى غدت","أنجمُ الشرق إلى الغرب تَرامى",80,"م",2,0],["لم ازّينهُ بالجناس ولكن","زانهُ الصدق وهو جل مرامي",81,"م",2,0],["لما زهت بعدالتي عدليتي","أرختُ أعدلَ حاكمٍ خورشيدا",82,"د",2,0],["لما زواهم إلى كرمان وانصدعوا","وقد تقاربت الآجال والقدر",83,"ر",1,0],["لم ازل ابتغيه جهدي فلم اصطده","واصطادني بغير اقتناص",84,"ص",1,0],["لم أزل أُظهر التجلّدَ للناسِ","وأُخفي جوىً يُشيب الغريرا",85,"ر",2,0],["لم أزل لا عدمته من حبيب","أشتهي قربه وآبى نفاره",86,"ر",2,0],["لم أزره قط إلا","بت محمود الإياب",87,"ب",1,0],["لم أزل في تفكر وانقياد","لهموم تعلني بالسقام",88,"م",1,0],["لم أزل أقطعُ دهري هكذا","وكذا أقطعُ منه المرتقَب",89,"ب",1,0],["لم أزل حافظا لعهدك حبا","باللقا مغرما كما أنت أدرى",90,"ر",2,0],["لم أزركم من قبل هذي ولكن","سبقتني إليكم أنفاسي",91,"س",2,0],["لم أزل فيك مسهما ولما حُز","ت من الفضل دائم الأطناب",92,"ب",1,0],["لم أزل من حرٍّ فرقته","ساهر الأجفان واحربي",93,"ب",2,0],["لَمْ أَزَلْ باكِياً لِسَبْيِ بَناتِ","طاهِراتٍ تُساقُ فِي الْفَلَواتِ",94,"ت",1,0],["لَمْ أَزَلْ راثِياً لَكُمْ بِصَميمي","وَوِدادٍ مِنَ الْحَبيبِ قَديمِ",94,"م",1,0],["لم أزل بالشعر من قبل ضنين","غير اني اليوم بالشعر سخي",95,"ي",1,0],["لم أزل أُعمِلُ الزجاجة حتّى","كان منّي ما يَعملُ السكرانَ",96,"ن",1,0],["لما زاي الشمس والافلاك مال إلى","من بالبقاء تجلى قبل في القدم",97,"م",1,0],["لَم أَزَل هكَذا حَليفَ شُجونٍ","أَسلمتْني لِمُنتَهى الآلامِ",98,"م",1,0],["لَم أَزَل أصفي وَأَمحضهم","ماء ودٍّ غير مؤتشبِ",99,"ب",1,0],["لم أزل كاتماً به الحب خوفا","وحذارا من كل واش يشي بي",100,"ب",2,0],["لم أزل بالقريض أهدي إليه","من بعيد مدائحي وقريب",100,"ب",1,0],["لم أزل ساهراً لفرط شجون","وهموم تراكمت كالسحاب",101,"ب",1,0],["لم أزل أشعر بالوجد الذي","أشعلته نار تلك القبل",102,"ل",1,0],["لم أزل طفلة سوى أنني قد","زدت جهلا بكنه عمري ونفسي",103,"ي",1,0],["لَمّا زَنَت وَهيَ تَحتَ الأَمرِ مُحصَنَةٌ","رَجَمتُموها اتِّباعَ الشَّرعِ بِالحَصَبِ",104,"ب",1,0],["لم أزل في جميع يومي وليلى","من بحور العنا حليف الغطوس",105,"س",1,0],["لَم أَزَل طولَ لَيلَتي","ساهِراً في اِنخِداعِهِ",106,"ع",2,0],["لم أزل برهةً أجاذب نفسي","ثم ألقيت للزمان الزّماما",107,"م",2,0],["لم أزل أطوي الليالي في قلق","حين أبدلت عن الوصل الصدود",108,"د",1,0],["لما زاد ديوان القويضي بأسره","على نصف بيت غثه وسمينه",109,"ن",2,0],["لم أزل مُكثِراً عليهِ السُّؤالا","وجَواباً ما عندهُ لي سِوى لا",110,"ل",2,1],["لم أَزَل لاهياً بكلِّ رشيقٍ","يتثنَّى فَيُخجلُ الأغصانا",111,"ن",2,0],["لم أزل أرعَى نجومَ","الليل من هَذي الرزِّيه",112,"ي",2,0],["لم أزل صائماً من الوصل لكني","أصلي على أهيل الجمال",113,"ل",1,0],["لم أزل مشفقاً علَي","كَ من الدَّمعِ والسَّهَر",114,"ر",1,0],["لم أزل أكتُم الذي بيَ حتَّى","كان دَمعي على هوايَ دليلا",115,"ل",2,0],["لم أزل أدعوا بجاه الكاظمين","إن دونور باك وشمس مشرقين",116,"ن",1,0],["لم أزل أكرع من مر الهوى","وصبا اشجو نوى هجراً صدودا",117,"د",2,0],["لما زرعتُ الحب في رحم الضنى","قلبي ترعرع في هواك يتيما",118,"م",2,0],["لم أزلْ أرجوكَ عَونا لي إذا","أنا يوماً خفتُ من دهري إهتِضَاما",119,"م",2,0],["لم أزلْ للدار أصبو فاسأليها","إن طرفي نحو أرض العشق أطرق",120,"ق",1,0],["لمّا زرعْنا الهُدى كانَ العُلا ثمراً","وحيْن بذرِ الهوى كانَ الجنىَ غرقا",121,"ق",2,0],["لمْ أزلْ أبصرُ في ا