{"poems":[[27,"حي المنازل بالأجزاع غيرها","https://www.aldiwan.net/poem5720.html","البسيط"],[47,"قد عرفنا مغزاك ياعيار","https://www.aldiwan.net/poem25255.html","الخفيف"],[72,"لم أزل منذ غاب شخصك عني","https://www.aldiwan.net/poem20558.html","الخفيف"],[51,"أيا تارك الصهباء لا زلت تاركا","https://www.aldiwan.net/poem61897.html","الطويل"],[51,"طرقت أسماء والركب هجود","https://www.aldiwan.net/poem61906.html","الرمل"],[51,"حزني منك يا ابنة الأملاك","https://www.aldiwan.net/poem65829.html","الخفيف"],[51,"يا أبا الصقر إن شكري لمعروفك","https://www.aldiwan.net/poem66341.html","الخفيف"],[91,"ذات شوك كالحراب أو كأظفار العقاب","https://www.aldiwan.net/poem8752.html","عموديه"],[91,"بت أرعى في الظلام الأنجما","https://www.aldiwan.net/poem8872.html","عموديه"],[89,"هل لمن يرقدون في الالحاد","https://www.aldiwan.net/poem44644.html","الخفيف"],[89,"بعد اني اردى فاهبط رمسي","https://www.aldiwan.net/poem44926.html","الخفيف"],[62,"قل لمن يطلب الحجر","https://www.aldiwan.net/poem52140.html","مجزوء الخفيف"],[45,"ونديم حلو الشمائل كالدي","https://www.aldiwan.net/poem65164.html","الخفيف"],[28,"حلفت برب الجاريات إذا جرت","https://www.aldiwan.net/poem5560.html","الطويل"],[44,"يا هلالا غدا عليه المحاق","https://www.aldiwan.net/poem30017.html","الخفيف"],[44,"إن يوم الفراق يوم عبوس","https://www.aldiwan.net/poem30239.html","الخفيف"],[44,"أنا في ذمة الكريم سليما","https://www.aldiwan.net/poem30361.html","الخفيف"],[44,"يا دار دار عليك إرهام الندى","https://www.aldiwan.net/poem30539.html","الكامل"],[44,"أي مرعى عين ووادي نسيب","https://www.aldiwan.net/poem30586.html","الخفيف"],[81,"طاول بجدك فالأقدار عنوان","https://www.aldiwan.net/poem61481.html","البسيط"],[52,"ليت ما قد شربته في جمادى","https://www.aldiwan.net/poem26612.html","الخفيف"],[48,"لم أزل أخلع في الحب الرسن","https://www.aldiwan.net/poem66112.html","البسيط"],[50,"يا لقوم للحبيب المذكر","https://www.aldiwan.net/poem63802.html","الرمل"],[50,"طال ليلي وبات قلبي جناحا","https://www.aldiwan.net/poem63974.html","الخفيف"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125573","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39577","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43831","المديد"],[90,"عبادة الشر","https://www.poetsgate.com/ViewPoem.aspx?id=179136",""],[45,"ونَديمِ حُلْوِ الشَّمَائِلِ كالدِّينار","https://www.poetsgate.com/ViewPoem.aspx?id=32643",""],[51,"حزني منكِ يا بنة الأملاك","https://www.poetsgate.com/ViewPoem.aspx?id=30075",""],[126,"رحم الله من نأى ورمانى","https://www.aldiwan.net/poem50619.html","الخفيف"],[148,"يا أبا الفضل وابنه وأخاه","https://www.aldiwan.net/poem68472.html","الخفيف"],[195,"إغتال قلبي يا له من جائر","https://www.aldiwan.net/poem39812.html","الرمل"],[202,"إنني ذاكر لما أنت ناس","https://www.aldiwan.net/poem53133.html","الخفيف"],[208,"يا بريقاً بالحمى قد لمعا","https://www.aldiwan.net/poem13314.html","الرمل"],[227,"ما تقاضت منا ليالي الزمان","https://www.aldiwan.net/poem50777.html","الخفيف"],[257,"أنا الله اعتصامي","https://www.aldiwan.net/poem35814.html","مجزوء الرمل"],[301,"لما زهى زهر الربيع بروضه","https://www.aldiwan.net/poem57821.html","الكامل"],[302,"قد كفاني علم ربي","https://www.aldiwan.net/poem16762.html","مجزوء الرمل"],[302,"مرحباً بالشادن الغزل","https://www.aldiwan.net/poem16881.html","المديد"],[362,"قربا لي يا صاحبي بعيدا","https://www.aldiwan.net/poem60938.html","الخفيف"],[362,"قسما مني بأيام الصفاء","https://www.aldiwan.net/poem61005.html","الطويل"],[397,"وهج الحب","https://www.aldiwan.net/poem6703.html","عموديه"],[400,"مرحبا يا مرحبا يا مرحبا بنسيم","https://www.aldiwan.net/poem34146.html","الرمل"],[413,"كاد أن يقضي سقاما ونحولا","https://www.aldiwan.net/poem54027.html","الرمل"],[413,"هاتها حمراء تحكي العندما","https://www.aldiwan.net/poem54068.html","الرمل"],[413,"عد عن من لج في قال وقيل","https://www.aldiwan.net/poem54131.html","الرمل"],[413,"هل تركتم غير الجوى لفؤادي","https://www.aldiwan.net/poem54177.html","الخفيف"],[436,"ونيلوفر قمن بالذبول","https://www.aldiwan.net/poem34898.html","المتقارب"],[451,"منبري عالمي وليس بأرض","https://www.aldiwan.net/poem61277.html","الخفيف"],[456,"علمتها الأيام أن تتجنى","https://www.aldiwan.net/poem55839.html","الخفيف"],[456,"بلغت صبرا فقالت ما الخبر","https://www.aldiwan.net/poem56203.html","الرمل"],[527,"لم أزل أرقب وعدا","https://www.aldiwan.net/poem37113.html","مجزوء الرمل"],[536,"فضلك لا أنساه","https://www.aldiwan.net/poem47510.html","عموديه"],[549,"أيها اللائم الذي لا يمل اللوم","https://www.aldiwan.net/poem47139.html","الخفيف"],[549,"جلب البرق لقلبي","https://www.aldiwan.net/poem47298.html","مجزوء الرمل"],[549,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[549,"بأبي زائرا أتاني ليلا","https://www.aldiwan.net/poem48068.html","الخفيف"],[556,"إن سلمى لها جميع التمني","https://www.aldiwan.net/poem33872.html","الخفيف"],[556,"إنني قد شفني السقم","https://www.aldiwan.net/poem34089.html","المديد"],[556,"لم أزل في الحب يا أملي","https://www.aldiwan.net/poem34255.html","المديد"],[584,"أنا كاس في كيس","https://www.aldiwan.net/poem17755.html","مجزوء الرمل"]],"verses":[["لِمازِنٍ صَخرَةٌ صَمّاءُ راسِيَةٌ","تُنبي الصَفا حينَ تَرديهِنَّ صَيخادُ",0,"د",1,0],["لَم أَزَل ثابِتاً عَلى الهَجرِ حَتّى","خَفَّ صَبري وَقَلَّتِ الأَنصارُ",1,"ر",1,0],["لم أزل منذ غاب شخصك عني","أرتجي وصل كتبه والوصالا",2,"ل",2,1],["لما زاد في الشرب الذي قد تركته","من الراح خيرٌ منك في الشرب زائدا",3,"د",2,0],["لم أزَلْ قِدْماً وقلبي ويدي","ولساني لك مُذْ كنتُ جُنودُ",4,"د",1,0],["لم أزلْ ناسكاً فأصبحتُ في الحب","بِ خليعاً في حلبةِ الفُتَّاكِ",5,"ك",1,0],["لم أزل منك في نعيم مقيم","لم يزل عند رِحلتي ومُقامي",6,"م",2,0],["لَم أَزَل أَلمَحُ طَيفَ المَجدِ حَتّى في السَرابِ","لَم أَزَل أَستَشعِرُ اللَذَّةَ حَتّى في العَذابِ",7,"ب",1,0],["لَم أَزَل أَستَشرِفُ الحُسن وَلَو تَحتَ نِقابِ","ما بِنَفسي خَشيَةُ المَوت وَلا مِنهُ اِرتِهابي",7,"ي",1,0],["لَم أَزَل في رَبقَةِ اليَأسِ إِلى","أَن أَعادَ الحُبُّ لي بَعضَ الرَجا",8,"ج",2,0],["لم ازل شاعراً هد ركني","كبر لي وفت في اعضادي",9,"ي",1,0],["لم ازل بالحياة صباً وان نؤ","ت بستين من سني وخمس",10,"س",1,0],["لم ازل هكذا إلى","أن بدا الحق واشتهر",11,"ر",1,0],["لَم أَزَل بِالخِداعِ أَسقيهِ حَتّى","وَضَعَ الكَأسَ مائِلاً يَتَكَفّا",12,"ف",2,0],["لَما زادَني مِن خَشيَةٍ إِذ حَبَستَني","عَلى الخَشيَةِ الأولى الَّتي كُنتَ تَعلَمُ",13,"م",1,0],["لَم أَزَل عالِماً بِأَن لَيسَ خَلقٌ","دامَ حُلواً إِلّا وَسَوفَ يُذاقُ",14,"ق",1,0],["لَم أَزَل أُبغِضُ الخَميسَ وَلَم أَد","رِ لِماذا حَتّى دَهاني الخَميسُ",15,"س",1,0],["لَم أَزَل في ذِمامِهِ المُعظَمِ المُك","رَمِ حَتّى ظَنَنتُهُ في ذِمامي",16,"م",2,0],["لَمّا زَهِدتَ زَهِدتَ في جَمعِ الغِنى","وَلَقَد رَغِبتَ فَكُنتَ فيهِ أَزهَدا",17,"د",2,0],["لَم أَزَل بارِدَ الجَوانِحِ مُذ خَض","خَضتُ دَلوي في ماءِ ذاكَ القَليبِ",18,"ب",1,0],["لَمّا زَكا غُصُناً في دَوحِ سُؤدُدِكُم","تاهَت قَنا الخَطِّ لَمّا قيلَ أَغصانُ",19,"ن",1,0],["لَم أَزَل آمُلُ المَزيدَ وَلا فَك","كَرتُ في ذا المِطالِ وَالحِرمانِ",20,"ن",1,0],["لَم أَزَل أَخلَعُ في الحُبِّ الرَسَن","وَفُؤادي عِندَ ظَبيٍ مُرتَهِن",21,"ن",1,1],["لَم أَزُر سَلمى وَلَم تُلمِم بِنا","غَيرَ رُؤياها أَنِم عَيناً تُزَر",22,"ر",1,0],["لَم أَزَل مِن هَوى عُبَيدَةَ أَهوى","ما يَليها حَتّى هَويتُ الرِياحا",23,"ح",2,0],["لم أزَل أقرأُ حتى سجدوا","وَجَعَلتُ الخُلدَ عُنوان الكتاب",24,"ب",1,0],["لم أزَلْ أرقبُ السماءَ إلى","أن أطَلَّ الشتاءُ بالسُّحُبِ",25,"ب",1,0],["لَم أَزَل آوي إِلى الرُكنِ مِنهُ","وَإلى الرُكنِ القَويمِ القَوِيِّ",26,"ي",1,0],["لما زاد حظُّك من عِيشة","على حظّ ذي العاهةِ المُقْعَد",27,"د",1,0],["لَمْ أَزَلْ بلخِداعِ أَسقِيهِ حتَّى","وضَع الكأسَ مَائلاً يَتَكَفَّا",28,"ف",2,0],["لم أزلْ ناسكاً فأصبحتُ في ال","حبّ خليعاً في حلبة ِ الفُتَّاكِ",29,"ك",1,0],["لم أَزَلْ في هواهُ طولَ زماني","وهو في ذلتي يزيدُ انتصارُه",30,"ر",2,0],["لم أزل سامعاً بفضلك حتى","حقق اللَّحظ عنك ما قد رواه",31,"ا",2,0],["لم أزل والوجد روحي متلف","مستهام في هواه مدنف",32,"ف",1,0],["لم أزل أحرز اللسان على الكت","مان حتّى تكلَّمت أنفاسي",33,"ي",1,0],["لم ازل طوع الهوى احفظه","ما له حفظ عهودي ضيعا",34,"ع",2,0],["لم أَزل منكَ بين بِرٍّ وقُرْبٍ","أَيادٍ تَتْرَى بِغَيرِ امتِنانِ",35,"ن",1,0],["لم أزل لله عبداً","وبهذا أتزكّى",36,"ك",2,0],["لما زهى زهرُ الربيع بروضه","وغدا له فضلٌ يبين عليه",37,"ه",1,1],["لَم أَزَل بِالبابِ واقِفٌ","فَأَدِم رَبّي وُقوفي",38,"ي",1,0],["لم أزل في حال عشرته","نازلاً بالمنزل الخضل",39,"ل",1,0],["لم أزُرْ غيرَكم ولو لم أجِدْ ما","ءً تَيمّمْتُ بالفلاةِ صَعيدا",40,"د",2,0],["لم أزَلْ أشْفعُ فيكم طارِفاً","من مَديحي بتليدٍ من وَلائي",41,"ا",2,0],["لم أزل أستظلُّ بالصبر حتى","لا تراني عَيْنُ الحياةِ حزينا",42,"ن",2,0],["لم أزد إلا غراماً وجوى","وفؤاداً خافقاً مضطرباً",43,"ب",2,0],["لم أزل حتَّى أوارى في الثرى","مقصراً فيهم ثنائي ومطيلا",44,"ل",2,0],["لم أزلْ من بعدها أرجو لها","عَوْدَة تبري بقلبي الأَلما",45,"م",2,0],["لم أزل أحظى لديكم بالغنى","والعطاءِ الجمِّ والمال الجزيل",46,"ل",1,0],["لم أزل أرتجيك في هذه الد","نيا وأرجوك بعدها في المعاد",47,"د",1,0],["لما زال يُوسِعُ هَذَا وتلكَ","بفعلٍ كَريم وذكرٍ جميلِ",48,"ل",1,0],["لم أزل بالوفاء والعمل الحي","كأني في مصر أحمي الذمار",49,"ر",1,0],["لم أزل في الغنى وفي الفقر يخشا","ني زماني مذ قلتُمُ أنتَ مِنَّا",50,"ن",2,0],["لم أزلْ أصبرُ علماً أنه","أبداً يُعقَبُ خيراً من صَبَرْ",51,"ر",1,0],["لَمْ أَزَلْ أَرْقُبُ وَعْداً","مِنْكَ يا زَيْنَ الزَّمانِ",52,"ن",1,1],["لمَّا زمَاني عضَّنِي","وصِحتُ آهُ آهُ",53,"ا",2,0],["لم أزلْ مُغضِياً على هَفَواتٍ","منه لو جُزْنَني لكنتُ غبيا",54,"ي",2,0],["لم أزلْ أسأل فيهن","نَ على الفقر بخيلا",55,"ل",2,0],["لَم أَزَلْ مُبغضاً لكلِّ نذيرٍ","للمنايا حتّى نعاه النّاعي",56,"ي",1,0],["لَم أَزِدْهُ شيئاً وَبينَ ضُلوعي","كلُّ شَوقٍ على مَليحِ العتابِ",57,"ب",1,0],["لم أزل منه بالجوى أتقلَّى","ليته كان لي معيناً وهلا",58,"ل",2,0],["لم أزل بالله في هممِ","في وجود كنت أو عدمِ",59,"م",1,0],["لم أزل في الحب يا أملي","أخلط التوحيد بالغزلِ",60,"ل",1,1],["لم أَزلْ في كفِّ ساقٍ","أو على ثَغْرِ نديمِ",61,"م",1,0]]}