/poem61784.html","مجزوء الوافر"],[338,"بشر البخيل يكاد يصلح بخله","https://www.aldiwan.net/poem68785.html","الكامل"],[349,"هب منطقي سمعك يا وهب","https://www.aldiwan.net/poem15536.html","السريع"],[377,"أيدري الدهر أيم الله أني","https://www.aldiwan.net/poem59430.html","الكامل"],[380,"ودادي غير منتقل","https://www.aldiwan.net/poem48753.html","مجزوء الوافر"],[402,"أنخها فهذا مربع المجد والفضل","https://www.aldiwan.net/poem46924.html","الطويل"],[403,"لا فض من رب القوافي فوه","https://www.aldiwan.net/poem33367.html","الكامل"],[403,"سلا إن مررتم عن فؤادي على سلع","https://www.aldiwan.net/poem33647.html","الطويل"],[403,"يا فاضلا وافى إلينا شعره","https://www.aldiwan.net/poem33763.html","الرجز"],[415,"إنتشتكي عنا سمى فإننا","https://www.aldiwan.net/poem1936.html","الكامل"],[441,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[452,"وافى الربيع بترنام الفواخيت","https://www.aldiwan.net/poem13672.html","البسيط"],[458,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[458,"أبلاغور تشتاق تلك النجودا","https://www.aldiwan.net/poem56240.html","المتقارب"],[464,"ضلالاً لواشيها وتبت يمينه","https://www.aldiwan.net/poem3410.html","عموديه"],[464,"أتهويماً وليل الهم داجي","https://www.aldiwan.net/poem3585.html","عموديه"],[468,"يا من قليب إخائه","https://www.aldiwan.net/poem60453.html","مجزوء الكامل"],[468,"عندي طباهجة وجدي بارد","https://www.aldiwan.net/poem60498.html","الكامل"],[470,"قالت وقلت تحرجي وصلي","https://www.aldiwan.net/poem4643.html","أحذ الكامل"],[479,"أينفى الاعتصاب بنفي سبع","https://www.aldiwan.net/poem37607.html","الوافر"],[482,"ونقطة باء في الحقيقة عينه","https://www.aldiwan.net/poem24329.html","عموديه"],[500,"تدرع بدرع البغي يا طامس القلب","https://www.aldiwan.net/poem37709.html","الطويل"],[500,"سألت آرام نجد","https://www.aldiwan.net/poem38059.html","المجتث"],[514,"كشفت حجاب السجف عن بيضة الخدر","https://www.aldiwan.net/poem20816.html","الطويل"],[527,"وقينة أحسن من لقياها","https://www.aldiwan.net/poem45991.html","الرجز"],[529,"يا حبذا كلام","https://www.aldiwan.net/poem37445.html","مجزوء الرجز"],[538,"لم أستمع لشكاية من شاك","https://www.aldiwan.net/poem48003.html","عموديه"],[544,"ثمالة الأمل","https://www.aldiwan.net/poem67253.html","عموديه"],[551,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[558,"ظلمات تقدرت تقديرا","https://www.aldiwan.net/poem34518.html","الخفيف"],[561,"يا رَبِّ إِذ شَدَدَتني عِقالاً","https://www.aldiwan.net/poem27837.html","الرجز"],[567,"أمر عيش وحال خفض","https://www.aldiwan.net/poem69620.html","مخلع البسيط"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[586,"وصالك أنهى مطلبي ومرادي","https://www.aldiwan.net/poem17494.html","الطويل"],[587,"بحمد الله نبدأ في المقال","https://www.aldiwan.net/poem11558.html","عموديه"]],"verses":[["وَنُقبِلُها كَذِئابِ الرَدا","هِ تَمري عُلالَتَهُنَّ الجُذُم",0,"م",1,0],["وَنَقولُ فيكَ وَلَو سَكَتنا قا","لَتِ الأَيّامُ أَكثَرَ ما نَقولُ وَنَدَّعي",1,"ع",2,0],["وَنَقبِ ثَنِيَّةٍ سَدَدتُ فيها","أَصَمَّ كَأَنَّ لَهذَمَهُ شِهابُ",2,"ب",1,0],["وَنُقْطَةُ قَلْبٍ أَصْبَحَتْ مَنْشَأَ الْهَوَى","وَنَفْسٌ لِغَيْرِ اللَّهِ مَا خَضَعَتْ قَطُّ",3,"ط",1,0],["وَنَقُولُ كُنْ نَصْلاً بِهِ","تَسْطُو الْحِمِيَّةُ لاَ قِرَابَا",4,"ب",2,0],["وَنَقُولُ دَعْ فَخْراً يَكَا","دُ صَدَاهُ يُوسِعُنَا سِبَابَا",4,"ب",2,0],["وَنِقضٍ كَريمِ النَجرِ ناجٍ زَجَرتُهُ","إِذا العَينُ كادَت مِن سُرى اللَيلِ تَعسِمُ",5,"م",1,0],["ونقول اسقين حوحو","ونميل من حيط لأخر",6,"ر",1,0],["ونقص صلاة الظهر يوم عَروبةٍ","لمعنى كمال أوضحته الدلائلُ",7,"ل",1,0],["ونقص زكاة المال فيه وُفورُه","ومشق ذباب السيف يخشاه صاقلُ",7,"ل",1,0],["ونقودها خرساء يُنطقها الردى","فيصِل صمصمام ويصرخ مِدفع",8,"ع",1,0],["ونقول التوحيد قولاً وكلٌّ","هو للشرك عامد وفَعُول",9,"ل",1,0],["وَنَقفوهُمُ خَلفَ الخَليجِ بِضُمَّرٍ","تَخوضُ بِحاراً بَعضُ خُلجانِها دَمُ",10,"م",1,0],["وَنَقَضتُ عَهداً كَيفَ لي بِوَفائِهِ","وَسُقيتُ دونَكَ كَأسَ هَمٍّ صارِدِ",11,"د",1,0],["ونقدتَ صاحبَها الثوابَ مُعجّلاً","إذ ما سألتَ بنقدهِ تأجيلا",12,"ل",2,0],["ونقصي بعد رُجْحاني لديه","وقد يئسَ الموازنُ من عَدالي",13,"ي",1,0],["وَنَقضُ العُهودِ بِإِثرِ العُهودِ","يَأُزُّ الكَتائِبَ حَتّى حَمينا",14,"ن",2,0],["وَنَقيسُ ما بَينَ الثُرَيّا وَالثَرى","وَأُمورُنا تَجري بِغَيرِ قِياسِ",15,"س",1,0],["ونقمة لمن عن الحق المبين","قد نكب",16,"ب",1,0],["وَنقّلَ الدَولةَ في بَيت الهُدى","فَلَم تزُل عَن طُنُبِ إِلّا إِلى",17,"ا",1,0],["وَنقدوا الآراءَ وَالسُيوفا","فَنَفو الكُلولَ وَالزيوفا",18,"ف",2,0],["وَنَقصرُ خُطوَةً وَنَمُدُّ أُخرى","وَتُلجِئُنا المَسافَةُ وَالمَرامُ",19,"م",1,0],["ونقعٌ صفيقُ الطُّرَّتينِ كأنَّما","على صفحاتِ الشمس منه سُدُولُ",20,"ل",1,0],["وَنَقيصَةُ السيبِيِّ سَي","بَكَ وَالمُتَمَّمَ مِن عَطائِك",21,"ك",1,0],["وَنَقولُ تَيمٌ قَرَّبَت وَعَدِيُّها","أَمراً بَعيداً حَيثُ كانَ سَحيقا",22,"ق",2,0],["وَنَقَّبنَ عَن جَنبَي هَراةَ تَحَرِّياً","لِقَتلٍ عَلى أَبوابِها وَقِتالِ",23,"ل",1,0],["ونقشِ عَبيرٍ على وَجنةٍ","كما نُقِشَ الوَرد ُبالغاليه",24,"ي",2,0],["وَنَقصُ العُقولِ فَإِجراؤُهُنَّ","بِنِصفِ الشَهادَةِ في الشاهَدَينا",25,"ن",2,0],["وَنَقطِ خالٍ إِذا شاهَدتَ مَوقِعَهُ","خِلتَ الخَليلَ ثَوى في نارِ نَمرودِ",26,"د",1,0],["ونَقَضتُ عُهودَ الشَّربِ فَلا","ودّ أُصفيه لأهلِ دَدِ",27,"د",1,0],["وَنَقَلْتُ بعزمي من بَلَدٍ","قَدَمَ الإسْرَاءِ إِلى بَلَدِ",27,"د",1,0],["ونَقْرٌ خفيّ في الشخوص كأنّه","بكلّ مكان ينتحيه رقيبها",28,"ب",3,0],["وَنقلي أَقاحُ الثَغرِ أَو سَوسَنَ الطُلى","وَنَرجِسَةُ الأَجفانِ أَو وَردَةُ الخَدِّ",29,"د",1,0],["وَنَقُدُّ مِن مُهجاتِنا عَلَماً لَها","تُطوى وَتُنشَرُ تَحتَهُ الأَعلامُ",30,"م",1,0],["وَنَقَضتُم أَحكامها فَإِذا الما","ل مَقام الإِلَه فيكُم يَقوم",31,"م",1,0],["وَنَقنَقَ بَطنُهُ وَدَعا رُؤاساً","لِما قَد نالَ مِن شَبَعٍ وَناما",32,"م",2,0],["وَنَقولُ فَوقَ أَسِرَّةٍ وَمَنابِرٍ","عَجَباً مِنَ القَولِ المُصيبِ بَديعا",33,"ع",2,0],["وَنَقَّبتُ عِرسي بِالطَلاقِ مُصَمِّماً","وَكانَت حَصاةً بَينَ رِجلي وَأَخمَصي",34,"ي",1,1],["وَنُقِّرَتُ الأَرضُ عَن جَوهَرٍ","فَمُنتَظِمٍ مِنهُ أَو مُنتَثِر",35,"ر",1,0],["وَنَقلُنا مِن قَصَبٍ يابِسٍ","كَأَنَّنا نَعمَلُ آجُرّا",36,"ر",2,0],["وَنَقرُ عودٍ إِذا تُرَجِّعُهُ","بَنانُ رَودِ الشَبابِ مِعطارِ",37,"ر",1,0],["وَنَقارِسٌ قَد زانَها","حَلَقٌ غَدائِرُها تَصيدُ",38,"د",1,0],["ونَقْطُ حَرْفٍ فيه إنْ زالَ مَعْ","ألْفٍ بِه بِيعَ بِخرّوبَهْ",39,"ب",2,0],["ونقضُ ميثاقٍ خلا","وما بقيْ عندي خلدْ",40,"د",1,0],["ونقدوا الآراء والسيوفا","فنفوا الكلولَ والزيوفا",41,"ف",2,0],["وَنَقْعٍ كَلُجِّ الْبَحْرِ خُضْتُ غِمَارَهُ","ولا مَعْقِلٌ إِلَّا الْمَنَاصِلُ وَالْجُرْدُ",42,"د",1,0],["وَنَقِّبْ لِتَعْلَمَ غَيْبَ الأُمُورِ","فَإِنَّ مِنَ الْحَزْمِ أَنْ تَفْحَصَا",43,"ص",2,0],["وَنقَابَةٌ نِيطَتْ بِهِ أَعْبَاؤُهَا","نَاهِيكَ بِالتَّبِعَاتِ مِنْ أَحْمَالِ",44,"ل",1,0],["وَنقول يا دَهْرُ احْتَكِمْ","مَا أَنْتَ بَعْدَ الْيَوْمِ جَائِرْ",45,"ر",1,0],["ونقَاءُ سُكَّان السماء يحوطه","رَبُّ السماءِ بعزّةٍ وعَفافِ",46,"ف",1,0],["ونقّر خطو القطيع الحصى","كما ينقر السقف وقع المطر",47,"ر",1,0],["ونقول الجبان في الشرّ أنثى","ووفير الشرور وافى الرجوله",48,"ل",2,0],["ونقضتُ بيني والكوارثِ مَوثِقاً","وأخذت من عَنَتِ الزمان أمانا",49,"ن",2,0],["ونقلت الذين عاشوا بنعم","من قصور شمٍ إلى الارماس",50,"س",1,0],["وَنَقتَبل السُعود لَنا بِصرح","بَدَت بِبُروجِها أَقمار سَعدك",51,"ك",1,0],["ونقطة الكون في إجمال هيئتها","للعين ما ظهرت واللَه لولاه",52,"ه",1,0],["ونقىً راجحا وخُوطاً مَرُوحاً","وطلاً ناعِساً ورِيماً مَرُوما",53,"م",2,0],["ونقرى الوفد في الألوى وندني","إليه أكؤسا تحكى الدهانا",54,"ن",2,0],["ونقلت فضلك حيث يخلد نقله","بالوعي فاتصل الحديث مسلسلا",55,"ل",2,0],["وَنِقمَةٍ بِهِ مَن كانَ يُدلي بِقِدمَةٍ","فَخَرنا بِهِ مَن كانَ يَبأى بِقُدمَةٍ",56,"ه",1,0],["وَنَقتُلُ مِن أَعدائِهِ مَن يَسُبُّهُ","حَباهُ بِأَشتاتِ الفَضائِلِ رَبُّهُ",57,"ه",1,0],["ونقول يأتي بعد ذا","زمن سجيّته سليمه",58,"م",2,0],["ونقل الصخر فوق الظهر يوما","لأهوان من مجالسة الثقيل",59,"ل",1,0],["وَنَقى القُرَّحَ الصَلادِمَ حَتّى","تَرَكَت جُوَّةً لَهُ المُعَيراءُ",60,"ا",2,0],["ونقعٍ دجوجيٍّ ترى السُّحبَ فوقَهُ","لما راعها من برقهِ تتقطعُ",61,"ع",1,0],["ونقطةٌ من عبير فوقَ وجنته","كأنها رُمِيتْ في لُجَّةِ اللَّهَبِ",62,"ب",1,0],["وَنَقاءٌ عَلى جَبينِكِ يا لَي","لى كَأَنَّ المَلاكَ ما زالَ حائِم",63,"م",1,0],["وَنَقُولُ إِثْرَ تَنَهُّدٍ يُغْرِي الْجَوَى","طَلَباً لِمَا يُرْضِيهِ مِنْ رِضْوَانِ",64,"ن",1,0],["ونقّلتِ قلبي حيثُ نقَّلتِ أنملاً","كطيرٍ على غصنٍ تُثنِّيهِ هبّات",65,"ت",1,0],["ونُقسِمُ أننا نرعى عُهوداً","فنعقدُ للتعاهدِ خِنصَرينا",66,"ن",2,0],["وَنقضت عهدا قَد تقادم عهده","يا وافيا بالعهد والميثاق",67,"ق",1,0],["وَنَقولُ حينَ نَراهُ في إيوانِهِ","كَالشَمسِ مَن كِسرى وَما إيوانُهُ",68,"ن",2,0],["وَنُقسِمُ لَو أَنّا اِستَطَعنا زِيارَةً","عَلى الروسِ مِنّا وَالعُيونِ لَزُرناكُم",69,"م",1,0],["ونق جيبك من كل العيوب ولا","تدخل مداخل أهل الفسق والريب",70,"ب",1,0],["ونقيم فيها كالذي كتب اللَه","مهما تراخى الحجيج في الإلمام",71,"م",1,0],["وَنقاءٌ في ثوبِ عرضٍ فلو خو","لِطَ منه الطهورُ لم يعدُ أَصله",72,"ل",2,0],["وَنَقضي وَقتَنا طَرَباً","وَلا نَلقى بِأَيدينا",73,"ن",2,0],["وَنَقيصَةٌ تَبقى عَلى أَيامِهِ","وَمَسَبَّةٌ في الأَهلِ وَالأَولادِ",74,"د",1,0],["وَنُقطَتي سَطحٌ لِخَطٍّ غَدا","دائِرَةً شَكَّلَ لَها القُطبُ",75,"ب",1,0],["ونقمتُه إذا حلت بعبدٍ","يسيء فلا مَقرَّ ولا مفرا",76,"ر",2,0],["وَنَقل صَحَّ مَأخَذَهُ","وَتَعليل بِلا عِلل",77,"ل",1,0],["ونقضِ بهِ ما أوجَبَتْ شِرعةُ الندَى","عَلى الحُرِّ مِنْ فَرضٍ أكيدٍ ومن نَفْلِ",78,"ل",1,0],["ونقلت للمولى الوصي مقالة","في مثلها يتعذر التوجيه",79,"ه",1,0],["ونقطف من روض العلوم معارفاً","وفي طبق التعبير تبرز للدفع",80,"ع",1,0],["ونقله عند الجميع جائز","فكيف خص الشافعي دره",81,"ر",2,0],["وَنَقولُ إِن طَرَقَ المُثَوِّبُ أَصبِحوا","لِوَصاةِ والِدنا الَّذي أَوصانا",82,"ن",2,0],["ونقول يا رباه هذي وقفةٌ","ما خيبت منك الرضى سؤالها",83,"ل",3,0],["ونقترف طيب أوطار الصبا أنفاً","في ظل فصل بطيب العيش منعوت",84,"ت",1,0],["ونَقَبَتْ جسمي وقلبي صابرٌ","من زمني نيوبُهُ الحدائدُ",85,"د",1,0],["ونقصُ اهتمامٍ أُرَى مُكْرَهاً","لجودك من أجله مستزيدا",86,"د",2,0],["ونقَّط وجه الأرض لؤلؤ طلَّه","وزان حنين النهر منها غصونه",87,"ن",2,0],["ونقطة خالهِ والصدغُ نونٌ","تروقكَ بانفرادٍ وازدواج",88,"ج",1,0],["وَنَقانِقٌ حُشفُ الشَطا","طِ وَخَردَلٌ صافي الرُضابِ",89,"ب",1,0],["وَنَقانِقٌ ما مِنهُ واحِدَةٌ تُرى","إِلّا كَمِثلِ البُسرَةِ الحَمراءِ",90,"ا",2,0],["وَنَقل لَها فيمَ الصُدودُ وَلَم","نُذنِب بَل أَنتِ بَدأتِ بِالذَنبِ",91,"ب",1,0],["ونقطع للترام طلاق بت","تذاكر لم تسم بطلاق رجعي",92,"ع",2,0],["ونقرع سمعهم بصدى مقالي","أينفى الاعتصاب بنفي سبع",92,"ع",1,0],["ونقطة باء في الحقيقة عينه","فعين الورى باء وبائي نقطتي",93,"ت",2,1],["ونقطع مغروراً ونوصل عاجزاً","ونسقط مختالاً ونرفع ذا رعب",94,"ب",1,0],["ونُقْطةُ العزْمِ منِّي","به لَعَمْري اسْتَدارتْ",95,"ت",1,0],["ونُقطةُ خالٍ من عبيرٍ بخدّها","كحبّةِ قلبٍ أجّجَتْهُ يدُ الذِكْرِ",96,"ر",1,0],["ونقطه وشكله خداها","إذا اجتلاها أنشدناها",97,"ا",3,0],["ونُقْطَةَ الْبِيكارِ","في هَذهِ الأَعْصارِ",98,"ر",1,0],["ونَقُولُ ذَاك فَخَارُنا ومَنِ الَّذي","يَقوَى لِنَظمِ الدَرِّ فِي الأسلاَكِ",99,"ك",1,0],["ونُقشِّر الحق المُغَلَّف بالدجى","حتى يشعّ لُبابه المُتَلَهِّب",100,"ب",1,0],["ونقضٌ ثمّ إبرامٌ","وسرٌّ ثمّ إعلانُ",101,"ن",1,0],["ونقول الذي به الكل قالوا","فنساوي المحقق النحريرا",102,"ر",2,0],["وَنَقسِمُ النِهابَ وَالأَنفالا","نَكفي الثَأى وَنُعظِمُ الإِجزالا",103,"ل",2,0],["وَنَقَضَتْ فِيْهِمُ شُرُوْطَاً","لَمْ يَكُ مِنْهَا يُخَافُ نَقْضُ",104,"ض",1,0],["ونقضوا قولهم فزعموا","بأنهم إذا جاء ما لم يعلموا",105,"م",3,0],["وَنَقَّصْتَ في حَظِّي كَمَا زِدْتَ فِي الهَوَى","صُدُودِيَ يَا كُلَّ المُنَى وبُعَادِي",106,"د",2,0],["ونق القلب من درن الخطايا","ورشني من فواضلك الجزال",107,"ل",1,0]]}