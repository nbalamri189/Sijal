{"poems":[[55,"تأمل أن تفرح في دار الحزن","https://www.aldiwan.net/poem29747.html","الرجز"],[10,"ألا يا عين فانهمري وقلت","https://www.aldiwan.net/poem21063.html","الوافر"],[10,"ألا يا عين فانهمري بغدر","https://www.aldiwan.net/poem21078.html","الوافر"],[95,"من عذيري والدمع جار سخين","https://www.aldiwan.net/poem11202.html","الخفيف"],[29,"أصبح حبل وصلكم رماما","https://www.aldiwan.net/poem5987.html","الوافر"],[47,"خذا من بكاء في المنازل أو دعا","https://www.aldiwan.net/poem64674.html","الطويل"],[30,"ود جرير اللؤم لو كان عانيا","https://www.aldiwan.net/poem5620.html","الطويل"],[50,"عوجا صدور النجائب البزل","https://www.aldiwan.net/poem65038.html","المنسرح"],[52,"لمروان مواعد كاذبات","https://www.aldiwan.net/poem62259.html","الوافر"],[47,"خُذا مِنْ بُكاءٍ في المَنازِلِ، أوْ دَعَا","https://www.poetsgate.com/ViewPoem.aspx?id=31218",""],[128,"لانت قناتك للمنون","https://www.aldiwan.net/poem23735.html","الكامل"],[136,"ربع أسماء إذ هي الأنس آلا","https://www.aldiwan.net/poem54778.html","الطويل"],[146,"إحدى الكواعب من بنى نصر","https://www.aldiwan.net/poem58404.html","أحذ الكامل"],[186,"لمريم صعب رمس في صباها","https://www.aldiwan.net/poem61186.html","الوافر"],[264,"عليك سلام الله في الحي يا يحيى","https://www.aldiwan.net/poem35732.html","الطويل"],[369,"سرى كما يسري القمر","https://www.aldiwan.net/poem60914.html","مجزوء الرجز"],[556,"قل لقوم ما لكم في","https://www.aldiwan.net/poem47300.html","مجزوء الرمل"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/77445","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145826","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59421","البسيط"],[1406,"","https://poetry.dctabudhabi.ae/diwan/poem/116697","البسيط"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21661","المنسرح"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108846","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118417","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118341","البسيط"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109346","الرمل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137301",""],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87317","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133981","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87525","الطويل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123936","الوافر"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126976","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92198","الطويل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36792","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111520","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69963","الوافر"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70097","الوافر"],[4027,"","https://poetry.dctabudhabi.ae/diwan/poem/202661","المتقارب"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36572","الدوبيت"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78311","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94840","الوافر"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33747","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72549","الكامل"],[4882,"إن البلاغة في النهرين تزدحم","https://www.poetsgate.com/ViewPoem.aspx?id=34801",""],[5956,"إني امرؤ دون السمير أبيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=194267",""]],"verses":[["لِم راشَهُم رَيشَ السَهامِ لِلعِدا","ثُمَّ بَراهُم بِالرَدى بَريَ السَفَن",0,"ن",1,0],["لِمَرزِئَةٍ كَأَنَّ النَفسَ مِنها","بُعَيدَ النَومِ تُشعَلُ يَومَ غُلَّت",1,"ت",1,0],["لِمَرزِئَةٍ كَأَنَّ الجَوفَ مِنها","بُعَيدَ النَومِ يُشعَرُ حَرَّ جَمرِ",2,"ر",1,0],["لِمُرِيدِي سَرْكِيسَ فِي آخِرَ المَعْ","مُورِ نَوْحٌ مُرَدَّدُ وَأَنِينُ",3,"ن",1,0],["لِمَرِّ سِنينَ قَد لَبِسَت شَبابي","وَأَبلَت بَعدَ جِدَّتِها العِظاما",4,"م",2,0],["لَمَرَّ عَلَينا غَيمُهُ وَهوَ مُثقَلٌ","فَعَرَّجَ فينا وَبلُهُ وَتَصَرَّعا",5,"ع",2,0],["لَمِردى حُروبٍ مِن لَدُن شَدَّ أَزرَهُ","مُحامٍ عَنِ الأَحسابِ صَعبِ المَظالِمِ",6,"م",1,0],["لِمَرِّ حَنّانَةٍ تُلِمُّ بِهِ","تَجنُبُ طَوراً وَتارَةً تُشمِل",7,"ل",1,0],["لِمَروانٍ مَواعِدُ كاذِباتٍ","كَما بَرَقَ الحَياءُ وَما اِستَهَلا",8,"ل",2,1],["لَمَرَّ عَلَيْنا غَيْمُهُ، وَهْوَ مُثْقَلٌ،","وَعَرّجَ فينَا وَبْلُهُ، فتَسَرّعَا",9,"ع",2,0],["لمرابع عنها تسائل","زائريك بكل حين",10,"ن",1,0],["لَمُرِبٌّ بِالقَلبِ بل زَادَ قَلبي","رَغبَةً فِيكِ أَن صَرَمتِ الحِبَالا",11,"ل",2,0],["لَمرَقَت منها مثلما ما انكردت","فَتخاءُ ترِمى الطيرَ بالذُّعرِ",12,"ر",1,0],["لمريمَ صَعبَ رَمسٌ في صِباها","عَلَيهِ وَجهُ فاديها أَنارا",13,"ر",2,1],["لمرآتك اجلي بالجلالة كي ترى","جمالَ التجلي فاتحَ المقلة العَميا",14,"ي",2,0],["لمَرْجِعٍ ولا مَمَر","فخاطِري على خَطَر",15,"ر",1,0],["لمُرَدّيكمْ وشيكاً","مِنّةٌ فينا جزيلَهْ",16,"ل",2,0],["لمُرّاكشٍ فَضلٌ عَلى كُلّ بَلدةٍ","وَما أَبصَرَت عَينٌ لَها مِن مُشابِهِ",17,"ه",1,1],["لِمَرْقَى اللهِ تَصْعَدُ أيُّ شَمْعٍ","لهُ أمواجُ دَجلَة َسُلّمَانِ",18,"ن",1,0],["لمرفوع صدغيها على الخد نصبة","يجر بها قلب له اللحظ يجزم",19,"م",1,0],["لمرسل الصدغ في خديه آيات","قامت بتصديق دعواه الأدلات",20,"ت",1,1],["لمرملِ الزّادِ مَعنيٍّ بِحَاجتِهِ","من كان يكرَهُ ذَمًّا أو يقي حَسَبا",21,"ب",2,0],["لِمِرَّةِ الحَزمِ لا أُفَرِّطُها","أَنقُضُ ما دونَها وَأبرِمُها",22,"م",3,0],["لمراد العلى الذي أرّخوه","دام ظلّاً لله في الإسلام",23,"م",1,0],["لم رعى أرضها بمن حل فيها","وأتته تسعى وهلا آتاها",24,"ا",3,0],["لمرسله والمرسلين ومرسل","اليهم من الله الزيادة والحسنى",25,"ن",2,0],["لمرتضى الموج في حافاتهم لجب","هزم الرعود تزجي بالأعاصير",26,"ر",1,0],["لمريد شأوه من مطمع","لم يكن يزهى بمالٍ وبجاه",27,"ه",1,0],["لمرقمه القى البيان قياده","فكم فيه من حجب الغيوب جلا سرا",28,"ر",2,0],["لِمَرطَبانٍ ثمَّ سِر لفالي","مجراكَ صَحَّ القُطبُ لا محال",29,"ل",1,0],["لِمَركَةٍ ثُمَّ إلى بَرَاوَه","تَقطَعُهُا في يَومِ بِالتِّلاوَه",30,"ه",1,0],["لمركزنا من عين عدلك نظرة","لاحصاء تعداد البلاد وأهلها",31,"ل",3,1],["لمرتكبٍ ما العقل بكرههُ","يُناقضهُ الطبع السَليم من النُكرِ",32,"ر",1,0],["لمرتضع قد استوفى فطاما","بحد السهم عن حد الرضاع",33,"ع",1,0],["لمراقيه ليس يصعد راق","كيف يلقى الراقي الى النجم مصعد",34,"د",1,0],["لمرد بني الأعجام في القلب سطوةٌ","وحكمٌ له ذلَّ النُّهى وهو مدهوشُ",35,"ش",1,1],["لِمُرادِ اللَهِ يَجري","أَمرُهُ طَوع رِضاكا",36,"ك",2,0],["لمركبه شد الجياد وخلفه","لقد شد هكطورٌ على الترب يمتد",37,"د",1,0],["لمريم نصركم بللمعُ نادى","ملاكُ اللَهِ مِن لُبنان وافي",38,"ف",2,1],["لِمريم بيعةٌ زادَت جَمالاً","بِتَجديدٍ وَيسرٍ بعدَ عُسرِ",39,"ر",1,1],["لمرغت خدي وألفت بين","هشيم المشيب وروض الشباب",40,"ب",1,0],["لِم رَجَّعتِ الحَنينَ ذات الطَوقِ","هَل وَجديَ قاسَت فَغَدَت في ضيقِ",41,"ق",1,0],["لِمِرآة الجَمالِ وَوَجه بَدر","دَعاني يوسُف الثاني دَعاني",42,"ن",2,0],["لمريم قد حكَت باسم وطهرٍ","محاسن خلقها صنعَ الكريمُ",43,"م",1,0],["لمُرسِلٌ زفرةً من بعدِها نفسٌ","يا ليتَ شِعريَ هل يأتيكُمُ نفَسِي",44,"ي",1,0],["لمراصد العلماء عن","د ضريحه طالت مواقف",45,"ف",1,0],["لمريم اتّخذتْ شرْقيّ القرى بلدا","ميلاد ٌ عيسى بها من نخلها طعِمُ",46,"م",1,0],["لِمُراد عاطفة الصداقة قدرة","تغزو الوجود فما تُعِيق حدودُ",47,"د",1,0]]}