{"poems":[[53,"تأمل أن تفرح في دار الحزن","https://www.aldiwan.net/poem29747.html","الرجز"],[10,"ألا يا عين فانهمري وقلت","https://www.aldiwan.net/poem21063.html","الوافر"],[10,"ألا يا عين فانهمري بغدر","https://www.aldiwan.net/poem21078.html","الوافر"],[93,"من عذيري والدمع جار سخين","https://www.aldiwan.net/poem11202.html","الخفيف"],[27,"أصبح حبل وصلكم رماما","https://www.aldiwan.net/poem5987.html","الوافر"],[45,"خذا من بكاء في المنازل أو دعا","https://www.aldiwan.net/poem64674.html","الطويل"],[28,"ود جرير اللؤم لو كان عانيا","https://www.aldiwan.net/poem5620.html","الطويل"],[48,"عوجا صدور النجائب البزل","https://www.aldiwan.net/poem65038.html","المنسرح"],[50,"لمروان مواعد كاذبات","https://www.aldiwan.net/poem62259.html","الوافر"],[45,"خُذا مِنْ بُكاءٍ في المَنازِلِ، أوْ دَعَا","https://www.poetsgate.com/ViewPoem.aspx?id=31218",""]],"verses":[["لِم راشَهُم رَيشَ السَهامِ لِلعِدا","ثُمَّ بَراهُم بِالرَدى بَريَ السَفَن",0,"ن",1,0],["لِمَرزِئَةٍ كَأَنَّ النَفسَ مِنها","بُعَيدَ النَومِ تُشعَلُ يَومَ غُلَّت",1,"ت",1,0],["لِمَرزِئَةٍ كَأَنَّ الجَوفَ مِنها","بُعَيدَ النَومِ يُشعَرُ حَرَّ جَمرِ",2,"ر",1,0],["لِمُرِيدِي سَرْكِيسَ فِي آخِرَ المَعْ","مُورِ نَوْحٌ مُرَدَّدُ وَأَنِينُ",3,"ن",1,0],["لِمَرِّ سِنينَ قَد لَبِسَت شَبابي","وَأَبلَت بَعدَ جِدَّتِها العِظاما",4,"م",2,0],["لَمَرَّ عَلَينا غَيمُهُ وَهوَ مُثقَلٌ","فَعَرَّجَ فينا وَبلُهُ وَتَصَرَّعا",5,"ع",2,0],["لَمِردى حُروبٍ مِن لَدُن شَدَّ أَزرَهُ","مُحامٍ عَنِ الأَحسابِ صَعبِ المَظالِمِ",6,"م",1,0],["لِمَرِّ حَنّانَةٍ تُلِمُّ بِهِ","تَجنُبُ طَوراً وَتارَةً تُشمِل",7,"ل",1,0],["لِمَروانٍ مَواعِدُ كاذِباتٍ","كَما بَرَقَ الحَياءُ وَما اِستَهَلا",8,"ل",2,1],["لَمَرَّ عَلَيْنا غَيْمُهُ، وَهْوَ مُثْقَلٌ،","وَعَرّجَ فينَا وَبْلُهُ، فتَسَرّعَا",9,"ع",2,0]]}