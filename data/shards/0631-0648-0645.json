{"poems":[[72,"يا من لعين أرقت","https://www.aldiwan.net/poem43000.html","المجتث"],[87,"قف بروما وشاهد الأمر واشهد","https://www.aldiwan.net/poem63737.html","الخفيف"],[71,"رومية الأصل لها مقلة","https://www.aldiwan.net/poem28214.html","السريع"],[71,"في دير بيرة دادخين حور","https://www.aldiwan.net/poem28805.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202530","الرجز"],[113,"رومي ذاك الحمى راعي العيون الشهل","https://www.aldiwan.net/poem16732.html","البسيط"],[228,"ويل الضعيف من القدير","https://www.aldiwan.net/poem41921.html","مجزوء الكامل"],[310,"در أيادي التهاني فتحت صدفه","https://www.aldiwan.net/poem56474.html","البسيط"],[325,"يا أيها الرتب اركعي","https://www.aldiwan.net/poem67149.html","مجزوء الكامل"],[325,"قل للمعالي ترطب مسمعي طربا","https://www.aldiwan.net/poem67218.html","البسيط"],[438,"لم ترض أني قد حرمت وصالها","https://www.aldiwan.net/poem12711.html","الكامل"],[484,"رومية ريمية","https://www.aldiwan.net/poem36998.html","مجزوء الرجز"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44582","الرجز"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89517","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89019","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89170","البسيط"],[3768,"","https://poetry.dctabudhabi.ae/diwan/poem/130434","الرجز"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4578,"نشرت على رمح القوام عصائبا","https://www.poetsgate.com/ViewPoem.aspx?id=49349",""],[5186,"هون عليك ولا تضق صدرا","https://www.poetsgate.com/ViewPoem.aspx?id=156443",""],[5376,"في ادلب الحسناء لم تزلِ","https://www.poetsgate.com/ViewPoem.aspx?id=191851",""],[5431,"هانيبعل...","https://www.poetsgate.com/ViewPoem.aspx?id=201063",""],[5829,"جحود العرب","https://www.poetsgate.com/ViewPoem.aspx?id=187393",""],[5894,"رفقا بصب حليف والوجد والضجر","https://www.poetsgate.com/ViewPoem.aspx?id=131419",""]],"verses":[["رومِيَّةٌ أَلحاظُها","مِثلُ سِهامٍ رُشِقَت",0,"ت",1,0],["رَومَةُ الزَهوِ في الشَرائِعِ وَالحِك","مَةِ في الحُكمِ وَالهَوى وَالمَجانَه",1,"ن",2,0],["روميةُ الأصلِ لها مقلةٌ","تركيةٌ صارمُها هندي",2,"ي",1,1],["روميةُ الألفاظِ هاروتيةُ ال","ألحاظِ عقلُ مُحبِّها مسحورُ",3,"ر",1,0],["روما التي راع اتساق ملكها","وهت يواقيت القرى من سلكها",4,"ه",2,0],["رومي ذاكَ الحِمى راعي العُيون الشَهل","استر جَمالك عُقول الناس راحَت ذهل",5,"ل",1,1],["روما يودُّ اللَهُ أَن","يَمشي التَساوي في الصُدوب",6,"ب",1,0],["رَومُ السماكينِ أَدنى من مآثركم","لذي يدٍ أَصبحت لِلفضلِ مُقتطفه",7,"ف",2,0],["رَومَلي بِكاري زانِها","مِنشاوي باشا أَحمَدُ",8,"د",1,0],["رَومَلي بيلَر ناهيكُم بِها شِرَفا","وَإِن يَكُن قَدرُهُ قَد فاقَها حَسَبا",9,"ب",2,0],["رومُ الغِنى من راحتَيْهِ فإنّه","جعلَ الرؤوسَ من الملوكِ نِعالَها",10,"ل",3,0],["رومية ريمية","للشاذلي بن المنجي",11,"ي",1,1],["رومِيَّةٌ حُلَّتُها زَرقاءُ","في الجيدِ مِنها دُرَّةٌ بَيضاءُ",12,"ا",2,0],["رومٌ تُحَكِّمُ فيكُم رَايَ ذي سَفَهٍ","أَحكامَ مُعتَقِدِ التَثليثِ وَالصُلُبِ",13,"ب",1,0],["رومية جاءت إلى ال","رومي كي تحكي مزاجه",14,"ج",2,0],["رومية فتحت باب العطا كرماً","وكم به من حديد الترك تسمير",15,"ر",1,0],["روم أن يعطف من ذاك الحمى","عليه من بعد الصدود ريمه",16,"م",2,0],["رومٌ به وفرنجٌ","في شَفْعهم لكَ وترُ",17,"ر",1,0],["رومية تاوي لدبر كم به","من راهبٍ أمسى إليها طالبا",18,"ب",2,0],["روما، أثينا، نينوى، مصرا","بغداد، بابل، قيصرا، كسرى",19,"ر",2,0],["روما وما روما بناحيةٍ","من ادلبَ الخضراء والمؤلِ",20,"ل",1,0],["روما ستغرق قال البحر للشفقِ","مراكب الشرق قد لاحت من الأفق",21,"ق",1,1],["روم العرمرم قد ساحوا بمشرقنا..","من كل قاصية. أقصاهم الله",22,"ه",1,0],["رومي عذابي فما أخشى مبارزة","ولي رجاء لدى المصري في الأثر",23,"ر",1,0]]}