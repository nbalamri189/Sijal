النجوم","https://www.poetsgate.com/ViewPoem.aspx?id=175560",""],[5002,"أهزوجة الليل ،،،","https://www.poetsgate.com/ViewPoem.aspx?id=202975",""],[585,"يا قلب حسبك من جوى وتصدع","https://www.poetsgate.com/ViewPoem.aspx?id=161855",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5561,"انعدام مشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=195178",""],[5574,"في كنفِ الإلٰهِ مُهدهِداً بدراً","https://www.poetsgate.com/ViewPoem.aspx?id=206002",""],[5690,"فسما بظلمة طالعي","https://www.poetsgate.com/ViewPoem.aspx?id=172226",""],[5725,"اتصبوا في غرامك","https://www.poetsgate.com/ViewPoem.aspx?id=178278",""],[5786,"يا بارقاً لاحَ من أكتاف كوفانِ","https://www.poetsgate.com/ViewPoem.aspx?id=50655",""],[5809,"الكامل","https://www.poetsgate.com/ViewPoem.aspx?id=205338",""],[845,"إلى أبي تراب","https://www.poetsgate.com/ViewPoem.aspx?id=159622",""],[5879,"رتل هواك","https://www.poetsgate.com/ViewPoem.aspx?id=215459",""],[5881,"وسهمه عيناكِ","https://www.poetsgate.com/ViewPoem.aspx?id=183867",""],[5970,"أيها النائحون خلوا نواحا","https://www.poetsgate.com/ViewPoem.aspx?id=130607",""],[6102,"أحلام","https://www.poetsgate.com/ViewPoem.aspx?id=182838",""],[6142,"بديع كون تحلى بالوجود طلى","https://www.poetsgate.com/ViewPoem.aspx?id=155673",""],[6213,"غرام متجدد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85498&r=&rc=101",""],[6238,"غِيضَ الكَلامُ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86771&r=&rc=0",""],[463,"سلْ بالغويرِ السائقَ المغلِّسا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60106&r=&rc=162",""],[454,"الجمال اليعربي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82655&r=&rc=19",""],[2638,"دنيا الأذكياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87840&r=&rc=4",""],[572,"أعاذ الله شكواكَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9403&r=&rc=260",""]],"verses":[["فَسِم آخِراً مِنهُ كَوَسمِكَ أَوَّلاً","وَشُنَّ عَلَيهِ رَونَقاً وَجَمالا",0,"ل",2,0],["فَسَما وَحَلَّقَ كَالعُقابِ إِلى العُلى","وَعَدوُّهُ يَهوي هُوِيَّ الأَجدَلِ",1,"ل",1,0],["فَسَمَحْتُ حَتّى بِالْحُشاشَةِ في الهوى","وَبَخِلْتِ حَتّى بِالخَيالِ الطارِقِ",2,"ق",1,0],["فَسَمّيتُها فَوزاً وَلَو بُحتُ بِاِسمِها","لَسُمّيتُ بِاِسمٍ هائِلِ الذِكرِ أَشنَعِ",3,"ع",1,0],["فَسَمَت لِلمَجدِ تَبغي شَأوَهُ","وَقَضَت مِن كُلِّ شَيءٍ مَأرَبا",4,"ب",2,0],["فسَمَوا إلى أوج الَعلا ونحن لم","نبرح نَسوخ الحضيض الأسفل",5,"ل",1,0],["فسمعت من أقواله طرفا","ورأيت من أفعاله بدعا",6,"ع",2,0],["فَسَمْنَاهُمْ كعَجْفاهم","وأنَّى لهمُ السَّمنى",7,"ن",2,0],["فسَّماه اسمه الأعلى","ليُقْذي عين ذي حَسَدِهْ",8,"د",2,0],["فسمَتْ سموةً لجمعِ أبي يك","سومَ غُلبٌ من أُسد خفَّان ضُبطُ",9,"ط",1,0],["فسما إلى الزَّنْج الأخابثِ سَمْوةً","كانت لجمعهمُ هلاكاً مُهْلِكا",10,"ك",2,0],["فسمّنا أفضلَ اسمينا فحقّ لنا","إن كنت ممن بثوب الدين يشتملُ",11,"ل",1,0],["فَسَمِعَت نَبأَةً مِنهُ وَآسَدَها","كَأَنَّهُنَّ لَدى أَنسائِهِ البُرَدُ",12,"د",1,0],["فَسَماءُ الراعي كَما يَتَمَنّاها","مُروجٌ فَسيحَةٌ خَضراءُ",13,"ا",2,0],["فَسَمِعتُ صَوتاً مِن بَعيدٍ قائِلاً","يا أَيُّها الساري مَكانَكَ تُحمَدِ",14,"د",1,0],["فَسَمِعتُ الحَياةَ تَضحَكُ مِنّي","أَتَرَجّى مِنك وَتَأبى وَتُجحِد",15,"د",1,0],["فَسَمِعَ الماءُ فَهاجَ غَضَبا","وَقالَ مَهلاً بَلَغَ السَيلُ الزُبى",16,"ب",2,0],["فسمعتُ صوتاً ساحراً متموِّجاً","فوق المروج الفيحِ والأعشابِ",17,"ب",1,0],["فَسَمِعوهُ في الدُجى يَنوحُ","يَقولُ إِنّي هالِكٌ يا نوحُ",18,"ح",1,0],["فَسَمِعَ الماءَ يَقولُ مُفصِحا","طَلَبتَ يا ذا الظَبيُ ما لَن تُمنَحا",19,"ح",2,0],["فَسَمِعتَ مِن مُتَفَرِّدِ الأَنغامِ ما","فاتَ الرَشيدَ وَأَخطَأَ النُدَماءَ",20,"ا",2,0],["فَسَمَت فَكانَت نِصفَ طارٍ ما بَدا","حَتّى أَنافَ فَلاحَ طاراً أَكبَرا",21,"ر",2,0],["فَسَمِعنا عَنِ الصَبِيِّ الَّذي يَع","فو وَطَبعُ الصِبا الغَشومُ الإِباءُ",22,"ا",2,0],["فَسَما لِأَعلى رُتبَةٍ فَاِحتَلَّها","سَبقاً وَبُرجُ الشَمسِ أَعلى الأَبرُجِ",23,"ج",1,0],["فَسُمتُم هَوانَ الذُلِّ أَحرارَ فارِسٍ","وَلَم تَخفَ فيهِم غامِضاتُ المَقاتِلِ",24,"ل",1,0],["فسمعي إلى أخباركم متشوف","وطرفي إلى أبصاركم متشوق",25,"ق",1,0],["فَسَمِعنا مِنهُ نَدباً لِنَدبٍ","أَبعَدَ الصَبرَ وَأَدنى الخَيالا",26,"ل",2,0],["فسماؤه في سمكها علويَّةٌ","وقبابه فَلَكِيّةُ البنيانِ",27,"ن",1,0],["فَسَمْعُ أَنِينِ الْجَوْرِ قَدْ شَاكَ مِسْمَعِي","وَرُؤْيَةُ وَجْهِ الغَدْرِ حَلَّ عُرَا جَفْنِي",28,"ن",2,0],["فسمعُهُ عنْ مقالِ الصدقِ في صممٍ","وقلبُهُ عن فعالِ الجدِّ في لعبِ",29,"ب",1,0],["فَسَمَونا لِلحَزيزِ بِهِ","فَدَفَعناهُ عَلى أَظبِ",30,"ب",1,0],["فَسَمعٌ أَميرَ المُؤمِنينَ وَطاعَةٌ","وَإِن كُنتَ قَد جَشَّمتَني مَركَباً وَعرا",31,"ر",2,0],["فَسَمّاهُمُ الزُوارَ سِتراً عَلَيهِمُ","فَأَستارُهُ في المُهتَدينَ سُدولُ",32,"ل",1,0],["فَسَمَّحَت أُخرى وَقالَت لَها","لا تَحرِما ما كانَ إِصلاحا",33,"ح",2,0],["فسَمِعْتُ ما لم تسمَعِي ونَظَرْتُ ما","لم تنظُري وعَرَفْتُ ما لم تعرِفي",34,"ف",2,0],["فسمونا لخدْرها","زُمراً تلْوها زُمَرْ",35,"ر",1,0],["فسما الكليم فما توسم ثانيا","أنَّى لك الشركاء والنظراء",36,"ا",2,0],["فَسمِعْتُ الحياة في هيكل الأحزا","نِ تشدو بِلَحْنِها المحبوبِ",37,"ب",1,0],["فَسَمَا فَحَلَّقَ فَاسْتَدَارَ فَصَكَّهَا","بِمُذَرَّبٍ تَمْكُو لَهُ الأَعْنَاقُ",38,"ق",1,0],["فَسَمَا فَأَبْصَرَ رَاعِيَيْنِ تَخَلَّفَا","بِالْعِيرِ تَصْدَحُ بَيْنَهُنَّ نِيَاقُ",38,"ق",1,0],["فَسَمَا إِلَى مُتَبَوَّإٍ فِي دِينِهِ","أَدْنَى إِلَى اسْتِجْلاَءِ وَجْهِ الخَالِقِ",39,"ق",1,0],["فسمعت للأطيار موسيقى على","نغماتها يأتي النهار ويذحب",40,"ب",1,0],["فسمعنا من النشوز أفاني","نَ يروِّعْنَ صادحَ الأفنان",41,"ن",1,0],["فسمعت من الغرف الأخرى","أنفاس حنايا متبولة",42,"ل",2,0],["فسمعت للأطيار موسيقى على","نغماتها يأتي النهار ويذهب",43,"ب",1,0],["فسمعت الحياة تضحك منّي","أترجى ، ومنك تأبى وتجحد",44,"د",1,0],["فسمّنا أفضلَ اسمينا فحقّ لنا","إن كنت ممن بثوب الذين يشتمل",45,"ل",1,0],["فسمت للمجد تبغى شأوه","وقضت من كل شئ مأربا",46,"ب",2,0],["فسموا الى أوج العلآء ونحن لم","نبرحْ نسوجُ إلى الحضيض الأسفل",47,"ل",1,0],["فسمعتَ من متفرِّدِ الأنعامِ ما","فاتَ الرشيدَ، وأَخطأ النُّدَمَاءَ",48,"ا",2,0],["فسمعت فكانت نصف طار ، ما بدا","حتى أناف ، فلاح طاراً أكبرا",49,"ر",2,0],["فَسَمعاً وطَوعاً بالذي فِيهِ عَاجِلاً","وإلاَّ فَمَحواً بالدَّوَاةِ وبِالقَلَمِ",50,"م",1,0],["فَسُمرُ الرِماحِ تَشَكّى الظَما","وَبيضُ الصِفاحِ تَشَكّى القَرَم",51,"م",1,0],["فسما إلى الإيمان والطاعات في","ملمومة للكفر والآثام",52,"م",1,0],["فسما به وهو النها","ية في الجلالة والجزاله",53,"ل",2,1],["فسماه مخلوقا وسماه خالقا","وذلك من حيث الأبوة والبنوى",54,"و",2,0],["فَسَمعتُ حَتّى لَستُ أَحمَدُ مُسمَعي","وَنَظَرتُ حَتّى لَستُ أَحمَد ناظِري",55,"ر",2,0],["فَسَماؤه الوَحيُ الصَحي","حُ وَتربُهُ مَجدٌ وَفَخرُ",56,"ر",1,0],["فَسمعتُ الطَيرَ في مَجثَمِهِ","مُنشِداً يَستَقبِلُ الفَجرَ الجَديدا",57,"د",2,0],["فسما الدين مقبلاً وتولى ال","كفر حيران رامقاً بلحاظ",58,"ظ",1,0],["فسما به الإيمان بعد خموله","حتى تسم ذروة لا تهبط",59,"ط",1,0],["فَسَمَت وَزانَتها بِحِكمَةِ صُنعِهِ","زهرُ النُّجومِ وَزانَها القَمَرانِ",60,"ن",1,0],["فَسَمَت وَراقَت غَيرَ موَضِعِ لَبنَةٍ","وَمُحَمَّدٌ هُوَ مُكمِلُ البُنيانِ",60,"ن",1,0],["فَسَمعاً أَميرَ المُؤمِنينَ لِحُرَّةٍ","إِذا اِنتَسَبَت فاءَت إِلى حَسَبٍ عِدِّي",61,"د",2,0],["فَسَمِيُّهُ الْبَصْرِيُّ لَوْ","رُزِقَ الْحَيَاةَ لَهُ تَرَدَّدْ",62,"د",1,0],["فَسَمَا لَهَا فَأَمَالَهَا وَأَسَالَهَا","وَأَجَلَّهَا وَأَقَلَّهَا وَأَهَلَّهَا",63,"ل",3,0],["فسموتَ مُنتعِل السِماك وَتارِكاً","تَحتَ الثَرى مَن ماله تَحتَ السَرى",64,"ر",2,0],["فسمعت همّته تقو","لُ وتلك مثل المُنصُل",65,"ل",1,0],["فسميري بها السهى وضجيعاي","لديها السهاد والأشجان",66,"ن",1,0],["فسمُّكِ لا يُؤذي طبيباً مجرَّباً","وسيفُكِ يَنبو عن شجاعٍ مدرَّع",67,"ع",1,0],["فسمعت فيه هاتفاً لك قائلاً","إن المنايا من مناك لأقرب",68,"ب",1,0],["فسماعكمْ أخباره","فيه على الحال اطلاعْ",69,"ع",1,0],["فسما بالطرفِ يرنو فإِذا","طرفُهُ من شدةِ السكرِ كليل",70,"ل",1,0],["فَسَماها سَنِيَّةً حَيثُ جادَت","كَطَلعَتِهِ وَلَيسَ البَدرُ يَخفى",71,"ف",2,0],["فَسَمّاهُ مُحَمَّدٌ مُستَمِدّاً","بِيُمنٍ سَمِيُّهُ الهادي المُرَجَّحُ",72,"ح",1,0],["فَسَماعي بَعدَ مَعرِفَتي","سَفَهَ العُذّالِ إِنكارُ",73,"ر",1,0