{"poems":[[79,"لم في الهوى العذري أو لا تلم","https://www.aldiwan.net/poem35992.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54866","البسيط"],[147,"أما وهوى عصيت له العواذل","https://www.aldiwan.net/poem11798.html","الوافر"],[303,"فيم التقاطع والأرحام واشجة","https://www.aldiwan.net/poem36807.html","عموديه"],[369,"يا مودع السر درا عند أجفاني","https://www.aldiwan.net/poem60635.html","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63938","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33433","السريع"],[5956,"لِمَ فجأة يأتي القمرْ؟ ‏","https://www.poetsgate.com/ViewPoem.aspx?id=185477",""],[463,"مطلَ الدِّينَ ولو شاءَ قضى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60111&r=&rc=167",""]],"verses":[["لُمْ في الهَوى العُذْرِيّ أوْ لا تَلُمِ","فالعَذْلُ لا يدْخُلُ أسْماعِي",0,"ي",1,1],["لمُفْرَدٍ بَلَغَتْ بِالحَقِّ شُهْرَتُهُ","أَقْصَى مَبَالِغِهَا فِي الْبَدْوِ وَالحَضَرِ",1,"ر",1,0],["لِمُفغِمَةٍ بُيوتَ الحَيَّ طيباً","وَمُفعَمَةِ الأَساوِرِ وَالخَلاخِل",2,"ل",1,0],["لمفحص من أَفاحيص القطا حرج","حامتْ عَلَى سمْته العقبانُ والرخم",3,"م",1,0],["لِمْ فَتْلُ صُدغَيكَ طولَ الدَّهرِ تُلبسُه","أذْنَيْكَ قَيْداً وقلبي عندك العاني",4,"ن",2,0],["لمَ في عِراصِ الغانياتِ يَلُمْنَنا","وقلوبُنا للغانياتِ عِراص",5,"ص",1,0],["لمفرد نحو ارجعون ألقيا","وللمثنى جمع قلب رويا",6,"ي",2,0],["لمفرد مذكّر قل واحد","أو أحد واثنان عدّ زائد",6,"د",1,0],["لمفرد وغيره خير وشر","وشذّ أخير بهمز وأشر",6,"ر",1,0],["لمُفهِمِ اثنَينِ مُعَرَّفٍ بِلاَ","تفَرُّقٍ أُضِيفَ كِلتَا وَكِلاَ",7,"ل",2,0],["لم فيّ من أصبح لي لائماً","ما عذرُ من يعذِلُ في حبكا",8,"ك",2,0],["لِمَ فجأة يأتي القمرْ","من دون أن ننوي السَّهرْ؟",9,"ر",1,1],["لمُ فيهِ وقلتمْ رقبة ً","رمتمُ صعباً وقدتمْ ريِّضا",10,"ض",2,0]]}