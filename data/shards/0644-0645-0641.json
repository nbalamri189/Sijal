{"poems":[[77,"لم في الهوى العذري أو لا تلم","https://www.aldiwan.net/poem35992.html","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54866","البسيط"],[141,"أما وهوى عصيت له العواذل","https://www.aldiwan.net/poem11798.html","الوافر"],[296,"فيم التقاطع والأرحام واشجة","https://www.aldiwan.net/poem36807.html","عموديه"],[362,"يا مودع السر درا عند أجفاني","https://www.aldiwan.net/poem60635.html","البسيط"]],"verses":[["لُمْ في الهَوى العُذْرِيّ أوْ لا تَلُمِ","فالعَذْلُ لا يدْخُلُ أسْماعِي",0,"ي",1,1],["لمُفْرَدٍ بَلَغَتْ بِالحَقِّ شُهْرَتُهُ","أَقْصَى مَبَالِغِهَا فِي الْبَدْوِ وَالحَضَرِ",1,"ر",1,0],["لِمُفغِمَةٍ بُيوتَ الحَيَّ طيباً","وَمُفعَمَةِ الأَساوِرِ وَالخَلاخِل",2,"ل",1,0],["لمفحص من أَفاحيص القطا حرج","حامتْ عَلَى سمْته العقبانُ والرخم",3,"م",1,0],["لِمْ فَتْلُ صُدغَيكَ طولَ الدَّهرِ تُلبسُه","أذْنَيْكَ قَيْداً وقلبي عندك العاني",4,"ن",2,0]]}