{"poems":[[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39569","الخفيف"],[276,"تنبهوا يا رقود","https://www.aldiwan.net/poem52048.html","المجتث"],[484,"قالوا إلى الترك نمشي","https://www.aldiwan.net/poem37201.html","المجتث"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102503","البسيط"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140092",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216475","الرمل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83188","الرجز"],[4778,"قل حسبي الله","https://www.poetsgate.com/ViewPoem.aspx?id=191654",""],[4968,"أمّاه","https://www.poetsgate.com/ViewPoem.aspx?id=206754",""],[5324,"قل حسبي الله.","https://www.poetsgate.com/ViewPoem.aspx?id=211610",""],[5328,"إلى جريئة","https://www.poetsgate.com/ViewPoem.aspx?id=211983",""]],"verses":[["قلَّ حفظاً أن تذكري ليلةً","مرَّتْ وأنتِ الطبيعةُ الحسَّانُ",0,"ن",1,0],["قل حين يمحى شَفائي","عَبد الرَحيم سعيد",1,"د",1,0],["قل حبّذا الكور منهم","إذ كان بالماكرونه",2,"ه",1,0],["قل حارث من الثمار قد جنا","ويده قد قطعت لما جنى",3,"ن",2,0],["قل حسبي اللَه فيما هو عليّ ولي","نعم الوليّ فما بعد الوليّ ولي",4,"ل",2,1],["قل حضرموت وشحرها احقافها","تروي كذا جبل وراس الحفرة",5,"ه",1,0],["قل حديث الحرب والسلم معًا","رُبَّ حرب هي للسلم عبور",6,"ر",1,0],["قُل حَسَناً لِتَسلَما","أَو اِستَمع لِتَغنَما",7,"م",2,0],["قل حسبي الله واسفح عبرة السلوى","وابرأ إليه من الإسفاف والبلوى",8,"و",2,1],["قُل حَسْبُنَا فِي قَوْمِِ اخْتَلَسُوا الضِّيَا","وَاسْتَعْبَدُوا أَجْيَالَنَا وحَيَاتَنَا",9,"ا",1,1],["قل حسبي الله إن جارت يد الخطب","واستغفر الله مما خل بالعرب.",10,"ب",1,1],["قل حبيبي : أنظرة العين غيث","تمطر الحب عنوة ومشيئة",11,"ي",3,0]]}