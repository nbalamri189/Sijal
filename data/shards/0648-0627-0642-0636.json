{"poems":[[85,"لعل الصبا إن صافحت روض نعمان","https://www.aldiwan.net/poem54236.html","الطويل"],[74,"سيدي والذي له صدقات","https://www.aldiwan.net/poem18777.html","الخفيف"],[87,"قف حي شبان الحمى","https://www.aldiwan.net/poem8085.html","مجزوء الكامل"],[51,"اسلك من الطرق المناهج","https://www.aldiwan.net/poem62022.html","مجزوء الكامل"],[68,"إن ثنت عنكم الخطوب عناني","https://www.aldiwan.net/poem40972.html","الخفيف"],[89,"حي مغنى الهوى بوادي الشآم","https://www.aldiwan.net/poem8286.html","الخفيف"],[71,"يا سائلي عن الكلام المنتظم","https://www.aldiwan.net/poem28850.html","الرجز"],[54,"رثيت الحجيج فقال العداة","https://www.aldiwan.net/poem27263.html","المتقارب"],[48,"أُبيدُ، على التّناسُبِ، كلَّ يومٍ،","https://www.poetsgate.com/ViewPoem.aspx?id=18540",""],[170,"يا قوم إني رجل فاضل","https://www.aldiwan.net/poem46898.html","السريع"],[276,"ضحك تبروق الابرقين تبسما","https://www.aldiwan.net/poem52106.html","الكامل"],[302,"لو أبانت حجابها أسماء","https://www.aldiwan.net/poem33339.html","الخفيف"],[369,"رمتني بلحظ واتقتني بمعصم","https://www.aldiwan.net/poem60649.html","الطويل"],[396,"رب يا عالم بحالي يا عليم","https://www.aldiwan.net/poem54508.html","عموديه"],[463,"هل تقبلون إنابة الدهر","https://www.aldiwan.net/poem56194.html","أحذ الكامل"],[463,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[520,"نبهتني حمامة بسحير","https://www.aldiwan.net/poem12292.html","الخفيف"],[578,"قف بربع الأسى وقوف الطليح","https://www.aldiwan.net/poem3652.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122596","الوافر"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87165","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86854","الخفيف"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53957","المديد"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48775","الرمل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48746","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38019","الكامل"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99973","الخفيف"],[977,"","https://poetry.dctabudhabi.ae/diwan/poem/124597","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59410","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59439","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59408","الوافر"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96718","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96752","المتقارب"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96693","الرمل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72299","البسيط"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6770","الخفيف"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137861",""],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118430","البسيط"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118423","الرمل"],[1996,"","https://poetry.dctabudhabi.ae/diwan/poem/82848","الخفيف"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104824","الكامل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108426","الكامل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108429","الرمل"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32591","الطويل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100893","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93827","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93804","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94037","الرجز"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74210","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65362","الرمل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74098","الرمل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74075","السريع"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109928","الكامل"],[3655,"","https://poetry.dctabudhabi.ae/diwan/poem/205648","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91068","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117940","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117977","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135848","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135743","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135735","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135740","الرجز"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77006","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94678","الوافر"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83607","الخفيف"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136404",""],[4578,"رق النرجس في وجه الرياض","https://www.poetsgate.com/ViewPoem.aspx?id=49456",""],[5183,"السِّمَات","https://www.poetsgate.com/ViewPoem.aspx?id=186460",""],[5302,"كن لي رفيق الروح","https://www.poetsgate.com/ViewPoem.aspx?id=200552",""],[5900,"باسمكِ اللهمَّ يا ربَّ العبادْ","https://www.poetsgate.com/ViewPoem.aspx?id=150189",""],[5936,"النعيرية","https://www.poetsgate.com/ViewPoem.aspx?id=184770",""],[5956,"ريثما الموت يجىء","https://www.poetsgate.com/ViewPoem.aspx?id=181921",""],[6124,"الرسالة","https://www.poetsgate.com/ViewPoem.aspx?id=103197",""]],"verses":[["وأقضي لبانات الفؤاد بأن أُرى","أُعفِّرُ خدّي في ثراه وأجفاني",0,"ن",2,0],["وأقضي الدجى سهاداً ويمضي","في حديث الغنى حديث الفقير",1,"ر",1,0],["وَاِقضوا الشَبابَ فَإِنَّ سا","عَتَهُ القَصيرَةَ فانِيَه",2,"ي",2,0],["وَاقضِ الحَوائِجَ ما استَطَع","تَ وَكُن لِهَمِّ أَخيكَ فارِج",3,"ج",1,0],["وَاِقضِ عُمرَ الزَمانِ صَوماً وَفِطراً","خالِداً في مَسَرَّةٍ وَأَمانِ",4,"ن",1,0],["وَاقْضِ عَنِّي حَقَّ الزِّيَارَةِ وَاذْكُرْ","فَرْطَ وَجْدِي بِهِمْ وَطُولَ سَقَامِي",5,"م",2,0],["واقضِ قضاءً لا يُرَدُّ قائلُهُ","بأنَّ منْ يهوى فتى يواصلُهْ",6,"ه",1,0],["وَأَقضى القُضاةِ لِفَصلِ الخِطابِ","وَالمَنطِقِ الأَعدَلِ الأَصوَبِ",7,"ب",1,0],["وأقضائي، منَ الرّؤساءِ، كوني","وكونُهُمُ، لخالِقنا، عَبيدا",8,"د",2,0],["وأقضُم الفُنْدَ ولا أَشتكي","وآكلُ التّمرَ ولا أَبكي",9,"ك",2,0],["واقض الَّذي فرض الاله عليك من","تفث وعد نحو الحجاز ميمما",10,"م",2,0],["واِقضِ وَجداً في حُبِّها تحيَ ما شِئ","تَ فأَمواتُ حبِّها أَحياءُ",11,"ا",2,0],["وأقضَى قضاةِ الشّرقِ والغربِ كُلِّهمْ","فخاصِمْ به لُدَّ الحوادثِ تَخْصِم",12,"م",1,0],["واقض حاجاتي جميعا كلها","وأقنى في الصراط المستقيم",13,"م",1,0],["واقضوا نذورَ الشِّعر فِيَّ فقد","قَضَّيْتُ فيكم شاكراً نَذْري",14,"ر",2,0],["واقضِ ديونَ المجد فيها وارعَ لي","ما تقتضي الأواصرُ التوالدُ",15,"د",1,0],["وأقضي عمري بظن كذوب","وبقلبي ما لا يؤدي لساني",16,"ن",2,0],["وَاِقضِ مِن واجِبِ البُكاءِ فَعَينا","كَ تَجودانِ عَن فُؤادِ قَريحِ",17,"ح",1,0],["وأقضيهم ليوم غَدٍ وَضيىءٍ","كَما عَهدُوه مِن قُربٍ وبُعد",18,"د",1,0],["وَاقضِ لي حاجَتي وَخُذ بِيَميني","فَلَقَد جالَ في ثَناك لِساني",19,"ن",2,0],["وَاقض بِالسَبق لِلمَدارس وَاجعَل","ذكر مصر بِها رَفيع المَنار",20,"ر",1,0],["وأُقَضِّي من حُقُوقِ هَواهُمْ","كلَّ فَرْضٍ بالْتزام الخُضوعِ",21,"ع",1,0],["واقض بين الناس يأخذ حقه","كل إنسان حياة وانتفاعا",22,"ع",2,0],["واقضوا لأنفسكم فأنتم في غنى","عن سائر الأشهاد والأقدار",23,"ر",1,0],["وَاِقضِ الَّذي تَرضى بِمُهجَتِهِ","مِن غَير إِثمٍ لا ولا حرجِ",24,"ج",1,0],["وَاقْضِ حَقَّ النَّيْرُوزِ فيه بِكَأْسِ","مُزْعَجٍ سَقْيُهَا بكَأْسٍ وَكُوزِ",25,"ز",1,0],["واقض ما فات من صلاة وصوم","وحقوقٍ ضيعتها وزكاة",26,"ه",1,0],["واقض بالعود للحمى والمصلى","لرى البيت والمقام الحفيلا",27,"ل",2,0],["واقض بالعود للزيارة وامنن","برجوع لبيتك المعمور",28,"ر",1,0],["وأقضي في حماها كل حج","بتطواف وسعي واعتمار",29,"ر",1,0],["واِقضِ الفرائضَ واِسفح كلّ منسجم","في كلِّ رسمٍ قديم العهد منطسمِ",30,"م",1,0],["وأقضي هنالك من واجب الز","زياراتِ والوصلِ فرضاً ونفلا",31,"ل",2,0],["وَاِقضني تخليدَ جنّا","تكَ مِن تَعذيبِ نارك",32,"ك",1,0],["واقضوا ديون الهوى عن مدة سلفت","تشاكياً وعلى المستأنف استلفوا",33,"ف",3,0],["وَأُقَضّي لُبانَتي وَأُرَوّي","عامِلَ الرُمحِ مِن دَمِ العَذراءِ",34,"ا",2,0],["واقضم بنانك نادما متأسفا","لتزيل ما بيديك من رجفان",35,"ن",1,0],["واقض لنا ما كان من حوجاء","في حالنا هذا وذاك الجاء",36,"ا",2,0],["واقض حوائج الذين انتسبوا","لنا جميعا واعف عما اكتسبوا",36,"ب",3,0],["واقض كل الحاح يا بر لنا","واهد يا هادي الى النهج السوى",37,"س",3,0],["وَأَقضَت بِهِم مَضاجعهم حُز","ناً وَباتوا مِن الأَسى في ذُهولِ",38,"ل",1,0],["وَاقضُوا الَّذِى مِن حُبِّهِ","ما بِى لَهُ وَلِصَعبِهِ",39,"ه",1,0],["وأقضِ كريماً في الغرام فهكذا","يقضي الغرام بأن نموت كراما",40,"م",2,0],["واقض من بعد بما شئت وكن","ظالماً فاللَه حسبي وكفى",41,"ف",2,0],["وأقْضي على نفسي إذا الحقّ نابَني","وفي الناس من يُقْضى عليه ولا يَقْضي",42,"ض",2,0],["وأقضى بخير الشاطئينِ لبانةً","من المُلك لا تُقضَى بمثلِ الخناجر",43,"ر",1,0],["واقض في الزق بذبح","إذ دم العنقود يهدر",44,"ر",1,0],["واقضوا المنى في دولة عباسها","ضحكت ندى أيديه وهي كرائم",45,"م",1,0],["واقض المنى من نظم ذا الصوفي الذي","صوفي وفي القلوب جل وقعه",46,"ع",2,0],["وَاقض الحُقوق الواجِبات لعيدنا","فَإِذا فَرَغت فَقُم إِلى مسنونه",47,"ن",2,0],["وأقض من دهرك دينا","طالما جار وضاما",48,"م",2,0],["وَاِقض يا نَفسُ عليه جزعاً","وَتعزّي عنه أَو فاِقضي عزاءَ",49,"ا",2,0],["وَاِقض عَلى المذنب أَو جازِهِ","صَفحاً وَعاقبه بِغُفرانِ",50,"ن",1,0],["وأقضي بنوركِ ظلمتي وظلامتي","كرماً فزندُ الرُشدِ مني أَضلدا",51,"د",2,0],["واقضمته حب القلوب كرامة","وسقيته ماء الشبيبة عن ورد",52,"د",1,0],["وَاقض لي بِالقبول وَالعَفو وَاصفح","ليتمَّ المنى وَيَبدو الهَناء",53,"ا",2,0],["واقضي لبانته لديك وزحزحي","عن وجهك الحسن الصبيح البرقعا",54,"ع",2,0],["وأقضي حق بيعتك التي من","تخلف دونها يلق آثاما",55,"م",2,0],["واقضِ حوائجي براحة البدنْ","وجلبِ أفراحٍ تزيلُ للحَزَنْ",56,"ن",1,0],["واقضِ الديونَ عنا وابدلْ ذلّنا","بالعزِّ منك ربّنا أجلَّنا",57,"ن",2,0],["واقضِ حوائجي كلاً يا مجيبْ","ودمِّرنْ كلَّ عِدانا عن قريبْ",58,"ب",1,0],["واقضِ ديوني ربِّ لا تُتَعِّبُ","وكثِّرنْ أموالي لا تنضَّبُ",58,"ب",1,0],["واقضِ لي همي ظاهراً أو سُترا","بسرِّ فاتحةٍ ثم البقرا",59,"ر",2,0],["واقض على العكس بحكم الطرد","ولم يزل كل على هواه",60,"ه",1,0],["وَأَقضي لِبانات الفُؤادِ وَيَشتَفي","غَرامٌ بِقَلبي صارَ ضَربَة لازِب",61,"ب",1,0],["وأقضي في هدير الورق ليلي","وأسكبُ في مواطنهم دموعي",62,"ع",2,0],["وَاِقضِ ديني وَأَرضِ خَصمِيَ عنّي","إِذ أَرى الدين كلّ يومٍ يزيدُ",63,"د",1,0],["واقضي ان تصد ولو دلالاً","وان وصلت ترد الي روحي",64,"ح",2,0],["وأقضى الدهر ذلاً مضجعي","وبنا صبري بالأحزان قاض",65,"ض",1,0],["واقض لي بالسعد في حكم الرضا","يوم القاك على خير الهبات",66,"ت",1,0],["وأقضي سويعاتي بأكناف غادة","تجلت هنا كالنور في الظلمات",67,"ت",1,0],["وأقضي الليالي في هناء وبهجة","وتبقى بنار العشق مشتعلات",67,"ت",1,0],["واقضِ حاجاتٍ لنا بين الورى","بجلال المصطفى خير العباد",68,"د",1,0],["وا قض قلبي قض قضٍ على قض","شوقه على شوفة دياره يقضه",69,"ه",1,0],["وأُقَضِّي العمر نهلاً","من نجوم لا تضيىءُ",70,"ا",1,0],["وأقضي مسافاتِ الأناملِ تزدَهِي","خُضاباً على دمعٍ يهابُ نهارها",71,"ر",3,0]]}