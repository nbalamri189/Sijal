{"poems":[[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[87,"ضجت لمصرع غالب","https://www.aldiwan.net/poem62908.html","مجزوء الكامل"],[45,"لما نسبت فكنت ابنا لغير أب","https://www.aldiwan.net/poem9513.html","البسيط"],[64,"لمن في عراص البيد نوق مطاريب","https://www.aldiwan.net/poem52480.html","الطويل"],[64,"لقاء الأماني في ضمان القواضب","https://www.aldiwan.net/poem52506.html","الطويل"],[47,"لنا أبدا بث نعانيه من أروى","https://www.aldiwan.net/poem10213.html","الطويل"],[47,"عهدي بربعك مثلا آرامه","https://www.aldiwan.net/poem65681.html","الكامل"],[30,"أو تعطف العيس صعرا في أزمتها","https://www.aldiwan.net/poem5053.html","البسيط"],[46,"ما لي بعادية الأيام من قبل","https://www.aldiwan.net/poem30374.html","البسيط"],[107,"فزع الدجى لأنينه المتردد","https://www.aldiwan.net/poem43163.html","الكامل"],[54,"قد أغتدي والليل كالغراب","https://www.aldiwan.net/poem27237.html","الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39569","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39673","الخفيف"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16628","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[107,"فزع الدجى لأنينه المتردد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54897&r=&rc=67",""],[164,"من يعط كنز رضاك يغن ويغنم","https://www.aldiwan.net/poem59109.html","الكامل"],[203,"دجا الظلام فيا ليلى أما فينا","https://www.aldiwan.net/poem45159.html","البسيط"],[228,"ملقيه بحسنك المأجور","https://www.aldiwan.net/poem41602.html","الخفيف"],[308,"لا قبلنا في ذا المصاب عزاء","https://www.aldiwan.net/poem58419.html","الخفيف"],[369,"أشاكر أنا للأيام أم شاك","https://www.aldiwan.net/poem60816.html","البسيط"],[376,"إن النوائب في جوارك","https://www.aldiwan.net/poem57087.html","مجزوء الكامل"],[382,"تبا لمتورط في إثمه ورطا","https://www.aldiwan.net/poem59353.html","البسيط"],[422,"هل تركتم غير الجوى لفؤادي","https://www.aldiwan.net/poem54177.html","الخفيف"],[463,"لمن الطلول كأنهن رقوم","https://www.aldiwan.net/poem55864.html","الكامل"],[463,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[466,"قوم إذا أخذ المديح قصائدا","https://www.aldiwan.net/poem16447.html","الكامل"],[469,"دمعي بتلك الطول مطلول","https://www.aldiwan.net/poem3158.html","عموديه"],[469,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[469,"لنا بسمر الحمى في الحي أسمار","https://www.aldiwan.net/poem3186.html","عموديه"],[469,"قوامك اللدن لا ما يزعم الغصن","https://www.aldiwan.net/poem3196.html","عموديه"],[469,"لهفي على غصن النقا المتمايل","https://www.aldiwan.net/poem3200.html","عموديه"],[482,"قد حال عما تعهده","https://www.aldiwan.net/poem15187.html","مجزوء الرجز"],[484,"وحق سيف أنور","https://www.aldiwan.net/poem37204.html","مجزوء الرجز"],[519,"هل المحرم فاستهل مكبرا","https://www.aldiwan.net/poem20838.html","الكامل"],[556,"عل الهوى يهفو به العذل","https://www.aldiwan.net/poem47341.html","أحذ الكامل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96969","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48679","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63916","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63925","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64038","الخفيف"],[930,"","https://poetry.dctabudhabi.ae/diwan/poem/132402","الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25326","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126188","الكامل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130625","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64603","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64543","الخفيف"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132298","البسيط"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42448","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53085","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53084","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77288","الكامل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67202","الكامل"],[2840,"","https://poetry.dctabudhabi.ae/diwan/poem/101879","الرمل"],[2933,"","https://poetry.dctabudhabi.ae/diwan/poem/198220","الكامل"],[3239,"","https://poetry.dctabudhabi.ae/diwan/poem/145264","المنسرح"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112692","الكامل"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105622","الرجز"],[3456,"","https://poetry.dctabudhabi.ae/diwan/poem/206016","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138555",""],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36794","الطويل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36795","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40147","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40160","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111447","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125881","الرجز"],[4087,"","https://poetry.dctabudhabi.ae/diwan/poem/131667",""],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93292","الرمل"],[4241,"","https://poetry.dctabudhabi.ae/diwan/poem/138847",""],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4606,"","https://poetry.dctabudhabi.ae/diwan/poem/27024","الرجز"],[182,"انبجاسات روح","https://www.poetsgate.com/ViewPoem.aspx?id=71648",""],[5026,"منبطحون على رصيف الرؤى","https://www.poetsgate.com/ViewPoem.aspx?id=211278",""],[5151,"سميتها وضحاً","https://www.poetsgate.com/ViewPoem.aspx?id=184797",""],[5273,"تأويل الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=198353",""],[5338,"قالوا: تعزل قلت: هذي كربلا","https://www.poetsgate.com/ViewPoem.aspx?id=190099",""],[5353,"لعنة قابيل","https://www.poetsgate.com/ViewPoem.aspx?id=212463",""],[5431,"ولم أزل ممشيا!","https://www.poetsgate.com/ViewPoem.aspx?id=192762",""],[5431,"قصيدة وجودية ...","https://www.poetsgate.com/ViewPoem.aspx?id=207830",""],[5587,"قَلْبِي عَلِيلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=190229",""],[5126,"فكرة مُختلطة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87818&r=&rc=33",""]],"verses":[["مُلقماتٌ أطفالَهُنُّ ثُدِيَّاً","ناهداتٍ كأحسنِ الرمَّان",0,"ن",1,0],["مُلقي الدُروسَ المُسفِرا","تِ عَنِ الغُروسِ المُثمِراتِ",1,"ت",1,0],["مُلَقَّبٌ بِكَ ما لُقِّبتَ وَيكَ بِهِ","يا أَيُّها اللَقَبُ المُلقى عَلى اللَقَبِ",2,"ب",1,0],["مُلَقَّنُ غيبٍ يستوي في ضميرِهِ","قِياسٌ وإلهامٌ وظَنٌّ وتَجْريبُ",3,"ب",1,0],["ملقّي صدور الخيلِ كلَّ مرشَّةٍ","مهوَّرةِ الجُرْفينِ شَهْقَى الحوالبِ",4,"ب",1,0],["مُلَقّىً صَوابَ الرَأيِ بَغتَ بَديهَةٍ","وَمِنهُم مُخِلٌّ بِالصَوابِ وَقَد رَوّى",5,"و",2,0],["مُلقٍ يَدَيهِ إِلى ابتِناءِ مَكارِمٍ","تَنسى وَتَذكُرُ ما بَنى بِسِطامُهُ",6,"م",2,0],["مُلقَونَ بِاللَبَبِ الأَقصى مُقابِلُهُم","عِطفا قَساً وَبِراقٌ سَهلَةٌ عُفَرُ",7,"ر",1,0],["مُلقى الرَجاءِ وَمُلقى الرَحلِ في نَفَرٍ","الجودُ عِندَهُمُ قَولٌ بِلا عَمَلِ",8,"ل",1,0],["مُلقىً عَلى عادي الصَيعدِ مُلَحَّبٌ","في الحَربِ يَلتَحِفُ النَجيعَ وَيَرتَدي",9,"د",2,0],["مُلقى السُدولِ مُغلَقُ الأَبوابِ","حَتّى بَدا الصُبحُ مِنَ الحِجابِ",10,"ب",1,0],["ملقياً رغوَها على قدميها","ليّنَ المسِّ مستحبَّ الأنينِ",11,"ن",1,0],["ملقيا في الغدير شاهبَ ثوبِه","فاتحا في المساء سجنَ الليلِ",12,"ل",1,0],["مُلَقّي نَواصي الخيْلِ كلَّ مُرِشّةٍ","من الطّعْن لا يرجو البَقاءَ طَعينها",13,"ن",3,0],["ملقبا في البلد الأمين","دون بني الأعيان بالأمين",14,"ن",1,0],["ملقى الجناح إزاءه مقصوصه","والرسل من أن يدَّعوه براء",15,"ا",2,0],["مُلَقِياً جِسْماً إِلى أَمِتهِ","خَشِيَتْ حِرْمَانَهُ دَفْناً وَقبْرَا",16,"ر",2,0],["ملقًى على عادي الصعيد ملحب","في الحرب يلتحف النجيع ويرتدي",17,"د",2,0],["ملق ببحر نداك دلواً إذ ظما","كرما به يرد العفاة الخضرم",18,"م",1,0],["مُلقًى تطايرُ حولي الناس لا وَزَرٌ","منهم ولا ملجأٌ في الناس يؤوينا",19,"ن",2,0],["مُلّقيهِ بِحُسنِكِ المَأجورِ","وَاِدفَعيهِ لِلاِنتِقامِ الكَبيرِ",20,"ر",1,1],["ملقيهِ فَاللَيلُ سَكرانُ واهٍ","يَتَلّوّى في خِدرِهِ المَسحورِ",20,"ر",1,0],["ملّقيهِ فَفي أَشِعَّةِ عَينَي","كِ صباحُ الهَوى وَلَيلُ القُبورِ",20,"ر",1,0],["ملقيهِ فَبينَ نَهدَيكِ غامَت","هُوَّةُ المَوتِ في الفِراشِ الوَثيرِ",20,"ر",1,0],["ملّقيهِ فَفي مَلاغِمك الحُم","رِ مَساحيقُ معدنٍ مَصهورِ",20,"ر",1,0],["ملقياتِ العُوَّار فيهنّ سَجْلا","جاعلاتِ القذَى لهنَّ رِشاءَ",21,"ا",2,0],["مُلْقىً بأرضٍ وأخبارُ السّماءِ له","إن لم يَزُغْ مُدْرَكاتٌ أيَّ إدْراك",22,"ك",1,0],["مُلقٍ بِبابِكَ رَحلَهُ","فانظُر لِعَبدِ المُحسِنِ",23,"ن",1,0],["مُلقىً طريحاً يُصلِّي وهو منزعجٌ","وكان من عرق الآلام قد عَبَطا",24,"ط",2,0],["ملقيات أثقالها باذلات","ما لديها على الرُّبا والوهاد",25,"د",1,0],["مُلقىً تَنابذُني الأكفُّ كأنّني","قعبٌ تفاوتَ صدعُهُ مرجومُ",26,"م",1,0],["مُلقىً وراءَ نسيَّةٍ ومَضلّةٍ","تُخفِي ضريحَك والقبورُ تُزارُ",27,"ر",1,0],["مُلْقي عمود الشِّرْكِ بعد قيامِهِ","ومُبينِ دينِ اللّهِ بعدَ كُمونِ",28,"ن",1,0],["ملقومِ بيضُ الوجوهِ خضرُ ظلا","ل الجود سودُ الوغى مقاويل",29,"ل",1,0],["ملقوم يقضي العدم في ساحاتهم","وينشر الجود ويقضى المل",30,"ل",1,0],["مِلقوم كانوا بُناةَ المجد ثم قضوا","فطاب عنهم أحاديثٌ",31,"ث",1,0],["ملقوم سادوا بني الدنيا فشبَّ بما","شبّوا من العزم فيها ملكها اليفن",32,"ن",1,0],["ملقومِ خضرِ مناصلٍ ومنازلٍ","فإذا تكونُ وغىً فسودُ قساطل",33,"ل",1,0],["ملقًى على فُرْشِ الضنى","لِقًى تداعى جَلَدُه",34,"د",2,0],["ملقى الجنود في النعير","ما للهلال الأحمر",35,"ر",1,0],["مُلقىً على وجهِ التُرابِ تظنّه","داودَ في المحرابِ حينَ تسوّرا",36,"ر",2,0],["مُلقىً على طُرْقِ الخطوبِ له","من كَرِّها حلٌّ ومُرتَحَلُ",37,"ل",1,0],["ملقى على وجه الصعيد مجرداً","في فتيةٍ بيض الوجوه وضاء",38,"ا",2,0],["ملقاك موعدنا الخليق بكل ما","يروى البشير ويذكر المتفائل",39,"ل",1,0],["مُلْقِياً للمُشَاشِ من فيه في الصَّحْ","فةِ حتى يُعيده من راس",40,"س",1,0],["ملقىَ على فُرُشِ الأحزانِ ترجفُ بي","ولم تكن فُرُش الأحزانِ لي فُرُشا",41,"ش",2,0],["مُلْقياتٍ من الجوا","نبِ خَمْلَ القطائف",42,"ف",1,0],["ملقى النوى ملقٍ لبعض نوالكا","فاشف المحب ولو بطيف خيالكا",43,"ك",2,1],["مُلْقَيْنَ لا يَرْمُونَ أُمَّ الهِنْبِرِ","عَنْ جَرِّ هَزْلَى أَسْلَمَتْ لَمْ تُقْبَرِ",44,"ر",1,0],["مُلقىً على الميناء تخدعه الرؤى","وشراعُه يجترُّ حلم حياتهِ",45,"ت",2,0],["ملقى ثلاثاً في الهجير تزوره","الاملاك بين مقبل ومسلم",46,"م",1,0],["ملقى صريعاً وعزرائيل ينزعها","وغصة النزع والحلقوم تلويها",47,"ي",3,0],["ملقي النور والمعارف يا اللّه","يا اللّه اكشف بنورك جهلي",48,"ل",2,0],["ملقى ببابك لابباب غيرك مض","طرا فلا له سوى الله",49,"ل",2,0],["ملَقاهُ في السِّلمِ إذ حاطَ الجمالُ بهِ","مُقوَّمُ القدِّ ميّاسٌ بلا عِوجِ",50,"ج",1,0],["ملقيات أثقالها في جنابٍ","ليس يخلو من قاصد وقصيد",51,"د",1,0],["ملقيان أثقالها في جناب","ليس يخلو من قاصد وقصيد",52,"د",1,0],["مُلقٍ عَلى ساحاتِها","أَوراقه سَمحُ الخَلاقِ",53,"ق",1,0],["مُلقىً على وجه البَسي","طةِ وهو ذو المجد الرفيع",54,"ع",1,0],["ملق أبصر ما بي من ولوع","فأشاب الجد بعد الهزل",55,"ل",1,0],["ملقىً بدار مذلة مستوطنا","سجناً أسام الخسف فيه وأظلم",56,"م",1,0],["ملقى عصي العفاة عرصتها","موسم سوق الكفاة ناديها",57,"ي",3,0],["ملقى على وجه الصعيد","تدوس جرد الخيل جسمه",58,"م",2,0],["ملقي زمامي للهوى ولم أزل","أعدل عن طريقه حيث عدل",59,"ل",1,0],["ملقَّن ملهَمٌ فيما يحاوله","جَمٌّ خواطرُه جوّابُ آفاقِ",60,"ق",1,1],["ملقى تحامته العدى والردى","وليس عضو غير مجروح",61,"ح",1,0],["مُلَقّن ظِلِّ اللَهِ مُظهِرُ آيِهِ","بِرَقمٍ عَلى نَفسِ الذَواتِ يَلوحُ",62,"ح",1,0],["مُلَقِّن ظِلِّ اللَهِ أَسرارَ غَيبِهِ","كَما هِيَ في أُمّ الكِتابِ مِن الأَصلِ",63,"ل",1,0],["مُلقى بِوَحشِ الأَصرمينَ تَزَيَّلت","آراؤُهُ وَتَزايَلَت آلابُهُ",64,"ب",2,0],["مُلْقٍ بِأَطرافِ الفِرِنجَةِ كَلكَلاً","طرفاهُ ضَربٌ صَادِقٌ وَجِلادٌ",65,"د",1,0],["مُلقىً حَكى صَفصَافَةً مَمشُوقَةً","والرَّأسُ غَضٌّ يانِعُ الأَفنادِ",66,"د",1,0],["مُلْقَى كسائرِ ما هنالكَ","من رمالٍ أو محارِ",67,"ر",1,0],["ملقنى سنب وقوس وارتجل","وتمدق حين طعم مذغ العسل",68,"ل",1,1],["مَلِق الوعد متى","طالبه اللَّحظُ بجودِ",69,"د",1,0],["مُلقىً على حرّ الصَّعيد","مُجَدَّلاً فوق الرُّمُول",70,"ل",1,0],["مُلَقِّياً بَني سُرُورٍ بَعدَها","مَسَرَّةً وَمُرضِياً بَني رِضا",71,"ا",1,0],["مَلقوحَةً في بَطنِ نابٍ حائِلِ","وَمِن أَخي سوءٍ وَمَولى خاذِلِ",72,"ل",1,0],["