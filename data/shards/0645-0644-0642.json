{"poems":[[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[85,"ضجت لمصرع غالب","https://www.aldiwan.net/poem62908.html","مجزوء الكامل"],[43,"لما نسبت فكنت ابنا لغير أب","https://www.aldiwan.net/poem9513.html","البسيط"],[62,"لمن في عراص البيد نوق مطاريب","https://www.aldiwan.net/poem52480.html","الطويل"],[62,"لقاء الأماني في ضمان القواضب","https://www.aldiwan.net/poem52506.html","الطويل"],[45,"لنا أبدا بث نعانيه من أروى","https://www.aldiwan.net/poem10213.html","الطويل"],[45,"عهدي بربعك مثلا آرامه","https://www.aldiwan.net/poem65681.html","الكامل"],[28,"أو تعطف العيس صعرا في أزمتها","https://www.aldiwan.net/poem5053.html","البسيط"],[44,"ما لي بعادية الأيام من قبل","https://www.aldiwan.net/poem30374.html","البسيط"],[105,"فزع الدجى لأنينه المتردد","https://www.aldiwan.net/poem43163.html","الكامل"],[52,"قد أغتدي والليل كالغراب","https://www.aldiwan.net/poem27237.html","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39569","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39673","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16628","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[105,"فزع الدجى لأنينه المتردد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54897&r=&rc=67",""],[161,"من يعط كنز رضاك يغن ويغنم","https://www.aldiwan.net/poem59109.html","الكامل"],[200,"دجا الظلام فيا ليلى أما فينا","https://www.aldiwan.net/poem45159.html","البسيط"],[224,"ملقيه بحسنك المأجور","https://www.aldiwan.net/poem41602.html","الخفيف"],[304,"لا قبلنا في ذا المصاب عزاء","https://www.aldiwan.net/poem58419.html","الخفيف"],[365,"أشاكر أنا للأيام أم شاك","https://www.aldiwan.net/poem60816.html","البسيط"],[372,"إن النوائب في جوارك","https://www.aldiwan.net/poem57087.html","مجزوء الكامل"],[378,"تبا لمتورط في إثمه ورطا","https://www.aldiwan.net/poem59353.html","البسيط"],[417,"هل تركتم غير الجوى لفؤادي","https://www.aldiwan.net/poem54177.html","الخفيف"],[459,"لمن الطلول كأنهن رقوم","https://www.aldiwan.net/poem55864.html","الكامل"],[459,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[462,"قوم إذا أخذ المديح قصائدا","https://www.aldiwan.net/poem16447.html","الكامل"],[465,"دمعي بتلك الطول مطلول","https://www.aldiwan.net/poem3158.html","عموديه"],[465,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[465,"لنا بسمر الحمى في الحي أسمار","https://www.aldiwan.net/poem3186.html","عموديه"],[465,"قوامك اللدن لا ما يزعم الغصن","https://www.aldiwan.net/poem3196.html","عموديه"],[465,"لهفي على غصن النقا المتمايل","https://www.aldiwan.net/poem3200.html","عموديه"],[478,"قد حال عما تعهده","https://www.aldiwan.net/poem15187.html","مجزوء الرجز"],[480,"وحق سيف أنور","https://www.aldiwan.net/poem37204.html","مجزوء الرجز"],[515,"هل المحرم فاستهل مكبرا","https://www.aldiwan.net/poem20838.html","الكامل"],[552,"عل الهوى يهفو به العذل","https://www.aldiwan.net/poem47341.html","أحذ الكامل"]],"verses":[["مُلقماتٌ أطفالَهُنُّ ثُدِيَّاً","ناهداتٍ كأحسنِ الرمَّان",0,"ن",1,0],["مُلقي الدُروسَ المُسفِرا","تِ عَنِ الغُروسِ المُثمِراتِ",1,"ت",1,0],["مُلَقَّبٌ بِكَ ما لُقِّبتَ وَيكَ بِهِ","يا أَيُّها اللَقَبُ المُلقى عَلى اللَقَبِ",2,"ب",1,0],["مُلَقَّنُ غيبٍ يستوي في ضميرِهِ","قِياسٌ وإلهامٌ وظَنٌّ وتَجْريبُ",3,"ب",1,0],["ملقّي صدور الخيلِ كلَّ مرشَّةٍ","مهوَّرةِ الجُرْفينِ شَهْقَى الحوالبِ",4,"ب",1,0],["مُلَقّىً صَوابَ الرَأيِ بَغتَ بَديهَةٍ","وَمِنهُم مُخِلٌّ بِالصَوابِ وَقَد رَوّى",5,"و",2,0],["مُلقٍ يَدَيهِ إِلى ابتِناءِ مَكارِمٍ","تَنسى وَتَذكُرُ ما بَنى بِسِطامُهُ",6,"م",2,0],["مُلقَونَ بِاللَبَبِ الأَقصى مُقابِلُهُم","عِطفا قَساً وَبِراقٌ سَهلَةٌ عُفَرُ",7,"ر",1,0],["مُلقى الرَجاءِ وَمُلقى الرَحلِ في نَفَرٍ","الجودُ عِندَهُمُ قَولٌ بِلا عَمَلِ",8,"ل",1,0],["مُلقىً عَلى عادي الصَيعدِ مُلَحَّبٌ","في الحَربِ يَلتَحِفُ النَجيعَ وَيَرتَدي",9,"د",2,0],["مُلقى السُدولِ مُغلَقُ الأَبوابِ","حَتّى بَدا الصُبحُ مِنَ الحِجابِ",10,"ب",1,0],["ملقياً رغوَها على قدميها","ليّنَ المسِّ مستحبَّ الأنينِ",11,"ن",1,0],["ملقيا في الغدير شاهبَ ثوبِه","فاتحا في المساء سجنَ الليلِ",12,"ل",1,0],["مُلَقّي نَواصي الخيْلِ كلَّ مُرِشّةٍ","من الطّعْن لا يرجو البَقاءَ طَعينها",13,"ن",3,0],["ملقبا في البلد الأمين","دون بني الأعيان بالأمين",14,"ن",1,0],["ملقى الجناح إزاءه مقصوصه","والرسل من أن يدَّعوه براء",15,"ا",2,0],["مُلَقِياً جِسْماً إِلى أَمِتهِ","خَشِيَتْ حِرْمَانَهُ دَفْناً وَقبْرَا",16,"ر",2,0],["ملقًى على عادي الصعيد ملحب","في الحرب يلتحف النجيع ويرتدي",17,"د",2,0],["ملق ببحر نداك دلواً إذ ظما","كرما به يرد العفاة الخضرم",18,"م",1,0],["مُلقًى تطايرُ حولي الناس لا وَزَرٌ","منهم ولا ملجأٌ في الناس يؤوينا",19,"ن",2,0],["مُلّقيهِ بِحُسنِكِ المَأجورِ","وَاِدفَعيهِ لِلاِنتِقامِ الكَبيرِ",20,"ر",1,1],["ملقيهِ فَاللَيلُ سَكرانُ واهٍ","يَتَلّوّى في خِدرِهِ المَسحورِ",20,"ر",1,0],["ملّقيهِ فَفي أَشِعَّةِ عَينَي","كِ صباحُ الهَوى وَلَيلُ القُبورِ",20,"ر",1,0],["ملقيهِ فَبينَ نَهدَيكِ غامَت","هُوَّةُ المَوتِ في الفِراشِ الوَثيرِ",20,"ر",1,0],["ملّقيهِ فَفي مَلاغِمك الحُم","رِ مَساحيقُ معدنٍ مَصهورِ",20,"ر",1,0],["ملقياتِ العُوَّار فيهنّ سَجْلا","جاعلاتِ القذَى لهنَّ رِشاءَ",21,"ا",2,0],["مُلْقىً بأرضٍ وأخبارُ السّماءِ له","إن لم يَزُغْ مُدْرَكاتٌ أيَّ إدْراك",22,"ك",1,0],["مُلقٍ بِبابِكَ رَحلَهُ","فانظُر لِعَبدِ المُحسِنِ",23,"ن",1,0],["مُلقىً طريحاً يُصلِّي وهو منزعجٌ","وكان من عرق الآلام قد عَبَطا",24,"ط",2,0],["ملقيات أثقالها باذلات","ما لديها على الرُّبا والوهاد",25,"د",1,0],["مُلقىً تَنابذُني الأكفُّ كأنّني","قعبٌ تفاوتَ صدعُهُ مرجومُ",26,"م",1,0],["مُلقىً وراءَ نسيَّةٍ ومَضلّةٍ","تُخفِي ضريحَك والقبورُ تُزارُ",27,"ر",1,0],["مُلْقي عمود الشِّرْكِ بعد قيامِهِ","ومُبينِ دينِ اللّهِ بعدَ كُمونِ",28,"ن",1,0],["ملقومِ بيضُ الوجوهِ خضرُ ظلا","ل الجود سودُ الوغى مقاويل",29,"ل",1,0],["ملقوم يقضي العدم في ساحاتهم","وينشر الجود ويقضى المل",30,"ل",1,0],["مِلقوم كانوا بُناةَ المجد ثم قضوا","فطاب عنهم أحاديثٌ",31,"ث",1,0],["ملقوم سادوا بني الدنيا فشبَّ بما","شبّوا من العزم فيها ملكها اليفن",32,"ن",1,0],["ملقومِ خضرِ مناصلٍ ومنازلٍ","فإذا تكونُ وغىً فسودُ قساطل",33,"ل",1,0],["ملقًى على فُرْشِ الضنى","لِقًى تداعى جَلَدُه",34,"د",2,0],["ملقى الجنود في النعير","ما للهلال الأحمر",35,"ر",1,0],["مُلقىً على وجهِ التُرابِ تظنّه","داودَ في المحرابِ حينَ تسوّرا",36,"ر",2,0],["مُلقىً على طُرْقِ الخطوبِ له","من كَرِّها حلٌّ ومُرتَحَلُ",37,"ل",1,0]]}