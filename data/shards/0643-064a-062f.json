{"poems":[[55,"ردوا الغليل لقلبي المشغوف","https://www.aldiwan.net/poem29970.html","الكامل"],[55,"لو كان يرتدع القضاء بمردع","https://www.aldiwan.net/poem30148.html","الكامل"],[55,"لا ترقدن على الأذى","https://www.aldiwan.net/poem30194.html","مجزوء الكامل"],[95,"صدقت في عتبكم أو يصدق الشمم","https://www.aldiwan.net/poem11361.html","البسيط"],[39,"كيدوا نزارا بأوباش مؤلبة","https://www.aldiwan.net/poem7003.html","البسيط"],[74,"هن الوجوه الناضره","https://www.aldiwan.net/poem18696.html","مجزوء الكامل"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[47,"بين الشقيقة فاللوى فالأجرع","https://www.aldiwan.net/poem64692.html","الكامل"],[71,"ما للزمان عن المروءة عار","https://www.aldiwan.net/poem28776.html","الكامل"],[52,"يا سلم هل قيمكم ماكث","https://www.aldiwan.net/poem64721.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42491","الكامل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/9497","الرمل"],[146,"إحدى الكواعب من بنى نصر","https://www.aldiwan.net/poem58404.html","أحذ الكامل"],[369,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101529","الكامل"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99971","الخفيف"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129541","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95500","الكامل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111788","الخفيف"],[1948,"","https://poetry.dctabudhabi.ae/diwan/poem/29555","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100273","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65460","الكامل"],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145539","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89161","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62940","الكامل"],[5145,"ما على الجيرة لو صبروا","https://www.poetsgate.com/ViewPoem.aspx?id=108198",""],[5444,"أمة الخيرية","https://www.poetsgate.com/ViewPoem.aspx?id=185388",""],[5453,"البندق","https://www.poetsgate.com/ViewPoem.aspx?id=28017",""],[5528,"كيد النساء","https://www.poetsgate.com/ViewPoem.aspx?id=201194",""],[5660,"أَوَ كُلُّ ذاكَ الهَجرُّ شَوقٌ لِلقَصائِد","https://www.poetsgate.com/ViewPoem.aspx?id=37021",""],[5956,"إنْ كانت امرأةً توَدُّ فراقنا","https://www.poetsgate.com/ViewPoem.aspx?id=192231",""],[5956,"عجوزٌ يصف لي جانباً من حياته مع زوجته","https://www.poetsgate.com/ViewPoem.aspx?id=214990",""],[5970,"كيد النساء وكيدهن عظيم","https://www.poetsgate.com/ViewPoem.aspx?id=130646",""],[6115,"أخزاك يالحوثي وبيت الله حماه","https://www.poetsgate.com/ViewPoem.aspx?id=196453",""]],"verses":[["كَيداً يُري أَن لا دَعيَّ أُمَيَّةٍ","كادَ الرِجالَ وَلا دَعيَّ ثَقيفِ",0,"ف",1,0],["كَيدٌ كَمارِقَةِ النِصالِ وَدونَهُ","بِشرٌ كَبارِقَةِ النُصولِ اللُمَّعِ",1,"ع",1,0],["كَيداً سَرى لَكُمُ وَلَم","تَسمَع لَهُ أُذُنٌ حَسيسا",2,"س",2,0],["كَيْدٌ يُرَوِّعُ لَولا أَنَّ كَائِدَهُ","حَيْرَانُ أَوْطَانُهُ الأَوْهَامُ وَالسُّدُمُ",3,"م",1,0],["كيدوا نزاراً بأوباش مؤلًّبة","يرجون عثرة جَدٍّ غير عثَّارِ",4,"ر",1,1],["كيد المؤيد باليرا","ع وبالسيوف الباتره",5,"ر",2,0],["كيدُه كاد حدَّ كلّ سنانٍ","وشبا كلّ مُرهفٍ فصّال",6,"ل",1,0],["كَيدٌ كَفى الجَيشَ القِتالَ وَرَدَّهُم","بَينَ الغَنيمَةِ وَالإِيابِ المُسرِعِ",7,"ع",1,0],["كيدُ النساءِ ومكرُهُنَّ مروِّع","لا كانَ كلُّ مكايدٍ مكّارِ",8,"ر",1,0],["كَيدٌ مِنَ الخُرطومِ يُضحي بِهِ","كَأَنَّما يَبعَثُهُ باعِثُ",9,"ث",1,0],["كَيْدُ الْغَبِيِّ مَساءَةٌ لِضَمِيرِهِ","وَلِمَنْ يُحَاوِلُ كَيْدَهُ إِرْضَاءُ",10,"ا",2,0],["كَيَدٍ حَلَّت وَسَلَّت","مَشرَفِيّاً حُساما",11,"م",2,0],["كَيَدِ ابن فَضْلانٍ غمائمُها","تغدو ببذل الوفر أو تسرى",12,"ر",2,0],["كَيدُه للعدوِّ لا الطّعْنُ خَلْساً","يَتَّقي مثلَه ولا الضّرْبُ هَبرا",13,"ر",2,0],["كيداً بغضبتكَ التي","طالت ولم تنتج رضاك",14,"ك",1,0],["كَيْدُهُ وَافِدٌ عَلَيْهِمْ بِيَوْمٍ","قَمْطَرِيرٍ بِمَا يَشُقُّ عَبُوسِ",15,"س",1,0],["كيد النقابة عم رونقها","بالمصطفى في السادة الشرفا",16,"ف",2,0],["كَيَدِ الخبيرِ تصوغ كل","لَ قَناً وكلِ مهنَّدِ",17,"د",1,0],["كيدهنَّ العياذُ باللهِ منهُ","إنهُ كان بالعبادِ رحيما",18,"م",2,0],["كَيداً وَجَمعاً بِآناسٍ كَأَنَّهُمُ","أَفنادُ كَبكَبَ ذاتُ الشَثِّ وَالخَزَمِ",19,"م",1,0],["كيدٌ ولا فرعون كادبهِ","موسى بنفث السحر في العقدِ",20,"د",1,0],["كيد من المحبوب شفّ صفاؤها","قبضت على كرة من الإبريز",21,"ز",1,0],["كيده في العدى الفناء الذي","(...) فتأثيره سريع بطي",22,"ي",1,0],["كيدِ فظٍّ عُتُلِّ لفظٍ زنيمٍ","كاذبٍ دائماً بزورٍ شهيرْ",23,"ر",1,0],["كيداً حثيثاً لم يكن ليكيدَه","بأَناتِهِ كيوانُ ذو الأَدوَارِ",24,"ر",1,0],["كيد الصدر الهمام إذا","أخذت في الجود تبتدر",25,"ر",1,0],["كيدٌ أُريد بأمتي، فتربصي","يا أمَّتي بمكائدِ الأعداء",26,"ا",2,0],["كيد النسأ خبثه ربا بالتلافيق","مثل الجحور العتق لا دفنوها",27,"و",3,0],["كيْدُ النِّساءِ عَظِيمٌ ليْسَ يَعْدِلُهُ","كَيْدٌ تَرعْرعَ فِي أحْضَانِ إبْلِيسِ",28,"س",1,0],["كيدي لِتَحظي بِالقَصيدِ وَ عَذِّبيني","وَ دَعي فُؤادي في لَظى حُبّي يُكابِد",29,"د",1,0],["كيد الحرائر منذ كان مٌعَظَّما","إنْ تَحْنِ هامك لن تَسُودَ مُحالا",30,"ل",2,0],["كيد النساء عجيبٌ في تذبذبِهِ","فليس يترك فينا ما يعافينا",31,"ن",2,0],["كيد النساء وكيدهن عظيم","أضنى الفؤاد وإنه لكظيم",32,"م",1,1],["كيد ابرهه من قبل بأمر الله فسد","وارسل آله العرش له طيرٍ رماه",33,"ا",2,0]]}