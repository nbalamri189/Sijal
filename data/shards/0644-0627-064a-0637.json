رِمُ الخُذُمُ",1,"م",1,0],["لا يَطمَعُ الأَعداءُ مَطلَعَ نَجدِهِ","قَد ضاقَ إِلّا عَنهُ ذاكَ المَطلَعُ",2,"ع",1,0],["لا يَطبَعونَ وَلا يَبورُ فَعالُهُم","إِذ لا يَميلُ مَعَ الهَوى أَحلامُها",3,"م",3,0],["لايُطغِيَنَّ بَني العَبّاسِ مُلكُهُمُ","بَنو عَلِيٍّ مَواليهِم وَإِن زَعَموا",4,"م",3,0],["لا يطمع الطالبُ في شأوِهِ","وإنَّما يطمعُ في رفده",5,"د",2,0],["لا يطرد المحل إلا صوب نائِله","ولا يجول على أفكاره الندَمُ",6,"م",1,0],["لا يَطمِئنُّ لِجَنبي مَضجَعُ وَكَذا","لا يَطمَئِنُّ لَهُ مُذ بِنتُ مَضجَعُهُ",7,"ع",2,0],["لا يَطْمَئنُّ بجْنبِي لِينُ مُضْطَجَعٍ","وما فراشُ أخي شكْوى بممهودِ",8,"د",1,0],["لا يطمئن من الحِذا","رِ بهِ المبيتُ ولا المظلُّ",9,"ل",1,0],["لا يُطْفِئُ اللَّهبَ المؤجَّجَ في دمي","موجُ الأسى وعواصفُ الأَزراءِ",10,"ا",2,0],["لا يُطمِعونَ خُيولَهُم في جَولَةِ","إِن نيلَ كَبشُهُمُ فَخَرَّ صَريعا",11,"ع",2,0],["لايَطرِفُ الطَرفُ إِلى غَيرِهِ","في حُسنِهِ مِن غَيرِهِ مُقنِعُ",12,"ع",1,0],["لا يُطمِعِ العُذّالَ حُسنُ تَجَلُّدي","فَلِذاكَ خَوفَ شَماتَةِ الأَعداءِ",13,"ا",2,0],["لا يَطمَعُ المَرءُ أَن يَجتابَ غَمرَتَهُ","بِالقَولِ ما لَم يَكُن جِسراً لَهُ العَمَلُ",14,"ل",1,0],["لا يَطرُدُ الهَمَّ إِلّا الهَمُّ مِن رَجُلٍ","مُقَلقِلٍ لِبَناتِ القَفرَةِ النُعُبِ",15,"ب",1,0],["لا يطمعِ المغرورُ ما لِثوائهم","أَجَلٌ ولا لجلائهم ميعادُ",16,"د",1,0],["لا يَطعمُ الضرَّبَ إلا حين يَجْمَعُهُم","يَوْمٌ يُبَرِّحُ بالجُرْدِ المحاضيرِ",17,"ر",1,0],["لا يَطمَئِنَّ فَإنْ ظَفِرْ","ت بما يُريدُ لكَ اطمأنْ",18,"ن",1,0],["لا يَطا بِرِجلِهِ","كُلَّ أَرضٍ لِكَلا",19,"ل",2,0],["لا يَطمَعُ الصَبُّ فيهِ في دَرَكٍ","وَلَو حَباهُ بِعَرشِ بَلقيسِ",20,"س",1,0],["لا يَطعَمُ البِيضُ إلاّ رأسَ ذي صَيَدٍ","أو ساقَ أدماءَ فيها النِّقْيُ بُنيانُ",21,"ن",1,1],["لا يَطّبيهِ غيرُ كَبّةِ مَعْرَكٍ","أو هَبْوَةٌ من مَأقِطٍ ومَغار",22,"ر",1,0],["لا يَطرُقُ الأَسماعَ في أَرجائِهِ","إِلّا تَرَنُّمُ أَلسُنِ العيدانِ",23,"ن",1,0],["لا يُطيعُ العُذّالَ في هَجرِ سَلمى","أَو تَصوغوهُ صَخرَةً أَو حَديدا",24,"د",2,0],["لا يَطلُعُ الغَربُ شافِياً ظَمَأً","حَتّى يُرى قَبلُ وَهوَ مُنحَدِرُ",25,"ر",1,0],["لا يطيب الخلود في لجج النا","ر فإن الخلود شيءٌ كثير",26,"ر",1,0],["لا يطمئن الشعب بعد جهاده","إلا إذا لمس المراد فنالا",27,"ل",2,0],["لا يَطْلُبَنّ كلامَهُ مُتَشَبِّهٌ","فالدُّرّ مُمْتَنِعٌ على طُلاّبهِ",28,"ب",2,0],["لا يطلب الثأر لميت ولا","يودَى لعمر الله فيمن ودى",29,"د",2,0],["لا يطلبنّ الغاية الشعراء","لو نال كنه جلالك الكبراء",30,"ا",2,0],["لا يَطْمِسُ الْجَهْلُ مَا أَثْقَبْتُ مِنْ شَرَفٍ","وَكَيْفَ يَحْجُبُ نُورَ الْجَوْنَةِ الدَّخَنُ",31,"ن",1,0],["لا يُطلِقُونَ إلى السَّفَاهِ حُبَاهُمُ","ويُرى خَطِيبُهُمُ بِحَقٍّ يَفْصِلُ",32,"ل",1,0],["لا يُطرِبُهُ التَّغْريدُ ولَوْ","غَنَّى بالأَرْغُنِ مَعْبَدهُ",33,"د",2,0],["لا يطفئُ الماءُ نيرانَ العدوِّ إذا","ما فار؛ بل تطفئُ النيرانَ نيرانَ",34,"ن",1,0],["لا يطرق الوهن عماد مجدنا","وكم ثللنا عرش مجد فكبا",35,"ا",1,0],["لا يطرق الضيم عزيز ركنهم","ولا يضام عائذ به احتمى",35,"ا",1,0],["لا يطلبون سوى ارتخاءِ قُيودهِم","أتُراهُمُ لم يطمعوا بفكاك",36,"ك",1,0],["لا يطيرونَ من سرورٍ ولا حزنٍ","شَعاعاً ، لأنه محسوب",37,"ب",1,0],["لا يطرقِ النازلُ المحذورُ ساحتهُ","وَلا تَمُدّ إلَيْهِ الحَادِثَاتُ يَدَا",38,"د",2,0],["لا يطمعنَّ زمانٌ أن بضعضعَ لي","رُكْنا ولا بِسهامِ البؤسِ يَرْمِينِي",39,"ن",2,0],["لا يطمع العظماءُ في مدحى ولا","طمَعى على أبوابهم معقولُ",40,"ل",1,0],["لا يَطمَعَنَّ نَبيهٌ في مَكانِهِما","فَما المَجَرَّةُ مِمَّن رامَها كَثَبُ",41,"ب",1,0],["لا يَطلُبَنَّ الوَرى ما أَنتَ مُحرِزُهُ","أَجَلُّهُم خَطَراً مَن باشَرَ الخَطَرا",42,"ر",2,0],["لا يَطمَعَن في حُسنِ عَفوِكَ طامِعٌ","حَتّى يُماثِلَ سِرَّهُ إِعلانُهُ",43,"ن",2,0],["لا يَطَّبيني مَكانٌ بَعدَ ظِلَّكُما","حَتّى يَهُزَّ هُبوبُ الريحِ ثَهلانا",44,"ن",2,0],["لا يطغَينَّكَ سترُ الله مذ زمنٍ","فكم أتى دون تسويف وإصرار",45,"ر",1,0],["لا يطي همته حب رشاً","عن قصد ذى بغي على العليا رشن",46,"ن",1,0],["لا يطرق الإسلام منك بعدها","بقربه ما ليس في حسابه",47,"ب",2,0],["لا يَطَّبيني طَمَعٌ مُدَنّسٌ","إِذا اِستَمالَ طَمَعٌ أَوِ اِطَّبى",48,"ا",1,0],["لا يَطيبُ العِزُّ ما لَم تَجنِهِ","بِاللِدانِ السُمرِ وَالبيضِ الحِدادِ",49,"د",1,0],["لا يُطمِعَنَّكِ فِيَّ هُلكُ مُقَدَّمٍ","فَالقَوسُ قَوسي وَالسِهامُ سِهامي",50,"م",2,0],["لا يَطرُق القَمَران الدهرَ ساحتَه","بلِ البدورُ به والشمس والفَلك",51,"ك",1,0],["لا يُطيقُ الإفصاحَ بالحقِّ عبدٌ","روحهُ مِن ضلالهِ خرساءُ",52,"ا",2,0],["لا يَطمَعُ التَالي اللَحاقَ بِها","يَوماً وَلَيسَ يَفوتُها المُؤلي",53,"ل",2,0],["لا يَطمَعُ الأَعداءُ في إِطفائِهِ","أَبَداً وَنورُ اللَهِ لَيسَ بِطافِ",54,"ف",1,0],["لا يُطمِعِ الأَعداءَ يَوْمٌ سَرَّهُمْ","إِنَّ الرَّدى فِي طَيِّ ذاكَ الْمَطْمَعِ",55,"ع",1,0],["لا يطلب الديدان إل","لا خنفساء محتقر",56,"ر",1,0],["لا يَطعَم الماءَ إلّا بلَّ غلَّتِه","ولا يَذوق سِوى سَدِّ الطَوى قوتا",57,"ت",2,0],["لا يطبعون وهم على أحسابهم","يشفون بالأَحلامِ داءَ الجاهلِ",58,"ل",1,0],["لا يطبي قلبي","در ولا ذهب",59,"ب",1,0],["لا يَطمَعْنكُمْ إنْ أَناخُوا بُرْهَةً","فَأَمَامَهُمْ سَفَرٌ لِيَوْمِ المَحْشَرِ",60,"ر",1,0],["لا يَطغينَّك صيت بَط","شك في الأَنام وَصَوت جُندك",61,"ك",1,0],["لا يَطوِ مِن بَطنِكَ الطِرادُ وَلا","يَنشُرَن مِن كُراعِكَ الغَضَبُ",62,"ب",1,0],["لا يطلب الديان منا آيةً","بل يطلب النوح الذي أنا مادح",63,"ح",1,0],["لا يطيقُ الضّلّيل حصر مَعاليهِ","وإن بات في القريض وظَلاَّ",64,"ل",2,0],["لا يطرق العينين خوف مطارق","أو خوف أصوات من الحراس",65,"س",1,0],["لا يُطمعنَّك نورُ كَوكَبِ عامِرٍ","فَوَراءُ قُربِ سَناهُ بِعدُ سَنائِهِ",66,"ا",3,0],["لا يطمئنَّ بيَ الملام فما له","منِّي سوى ما خابَ فيه رجاؤه",67,"ا",3,0],["لا يطمع الدهرُ في رضاي ولا","يُسخطني إن أَلام أو كَرُما",68,"م",2,0],["لا يطرحُ الذلَّ وراءَ ظهرِها","إلا فتىً يُنْضي المطايا الذُّلُلا",69,"ل",2,0],["لا يطمع الكفءُ الشريفُ بسعيه","فيها ولو ساق المهورَ وغالى",70,"ل",2,0],["لا يُطعَمون مع العش","يّ حلاوةَ النَّعمِ المُراحِ",71,"ح",1,0],["لا يطمئنُّ على التواكُلِ قلبُهُ","فيما رعى إن نامَ راعي الثَّلَّةِ",72,"ه",1,0],["لا يطَّبيهِمْ وإنْ حَنُّوا لأرضهُم","إلى مواطنهم والأهلِ تَرْحالُ",73,"ل",1,0],["لا يُطْلِعونَ على ضَميرِ قُلوبِهِمْ","ملَكاً لكَيْلا يُعْمِلُ المَلَكُ القَلَمْ",74,"م",1,0],["لا يُطْمعُ الخصمَ فيه لِينُ جانبِه","فقد تَلينُ الأفاعي والقَنا الذُّبُلُ",75,"ل",1,0],["لا يطرق النوم أجفاناً لمقلته"