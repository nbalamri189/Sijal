{"poems":[[55,"أسل بدمعك وادي الحي إن بانوا","https://www.aldiwan.net/poem29743.html","البسيط"],[55,"بيني وبين الصوارم الهمم","https://www.aldiwan.net/poem29775.html","المنسرح"],[55,"تمضي العلى وإلى ذراكم ترجع","https://www.aldiwan.net/poem30156.html","الكامل"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[49,"الدين مخترم والحق مهتضم","https://www.aldiwan.net/poem25156.html","البسيط"],[74,"قدمت كالسيف إلى غمده","https://www.aldiwan.net/poem18559.html","السريع"],[74,"بكيت ليلا بوجدي وهي تبتسم","https://www.aldiwan.net/poem19675.html","البسيط"],[62,"لا تعذليه فإن العذل يولعه","https://www.aldiwan.net/poem13279.html","البسيط"],[53,"للناس عيد ولي عيدان في العيد","https://www.aldiwan.net/poem10864.html","البسيط"],[53,"لعدوك الحد الأفل","https://www.aldiwan.net/poem65918.html","مجزوء الكامل"],[94,"سأعيش رغم الداء والأعداء","https://www.aldiwan.net/poem38976.html","الكامل"],[47,"فيم ابتداركم الملام ولوعا","https://www.aldiwan.net/poem64665.html","الكامل"],[47,"يامعرضا يدعى فلا يسمع","https://www.aldiwan.net/poem65131.html","السريع"],[68,"أصفيح ماء أديم أم سماء","https://www.aldiwan.net/poem40129.html","الكامل"],[46,"فحواك عين على نجواك يا مذل","https://www.aldiwan.net/poem30389.html","البسيط"],[46,"أبدت أسى أن رأتني مخلس القصب","https://www.aldiwan.net/poem30587.html","البسيط"],[107,"أتنام عينك والعيون سهاد","https://www.aldiwan.net/poem42119.html","الوافر"],[107,"ناد القبور وبشر كل مقبور","https://www.aldiwan.net/poem43053.html","البسيط"],[104,"كفكف دموعك ليس ينفعك","https://www.aldiwan.net/poem33114.html","مجزوء الكامل"],[54,"أسألت طللا","https://www.aldiwan.net/poem26765.html","مجزوء الرمل"],[54,"إشرب بكأس من كف طاووس","https://www.aldiwan.net/poem26915.html","المنسرح"],[77,"لا يطعم البيض إلا رأس ذي صيد","https://www.aldiwan.net/poem69031.html","البسيط"],[77,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[50,"لا تحزنن لفرقة الأقران","https://www.aldiwan.net/poem65305.html","الكامل"],[52,"أنجزي يا سلامة الموعودا","https://www.aldiwan.net/poem63951.html","الخفيف"],[48,"ما جدري أمات صاحبه","https://www.aldiwan.net/poem22597.html","المنسرح"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85588","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16621","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147508","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42815","البسيط"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67336","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[108,"بين عهدين","https://www.poetsgate.com/ViewPoem.aspx?id=179345",""],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[92,"على سعد","https://www.poetsgate.com/ViewPoem.aspx?id=179079",""],[92,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[49,"يا طولَ شَوْقيَ إن قالوا: الرّحِيلُ غدا،","https://www.poetsgate.com/ViewPoem.aspx?id=14757",""],[132,"إني بفضل من الله ذو دعة","https://www.aldiwan.net/poem50491.html","البسيط"],[146,"ألكم إلى رد الشباب سبيل","https://www.aldiwan.net/poem58447.html","الكامل"],[147,"لا زلت تعلو وإن حسادك إكتأبوا","https://www.aldiwan.net/poem11721.html","البسيط"],[147,"لو أن شامخ قدر دافع قدرا","https://www.aldiwan.net/poem11764.html","البسيط"],[147,"أما الزمان ففي يديك عنانه","https://www.aldiwan.net/poem11830.html","الكامل"],[147,"ظن الأراك لدى واديه أظعانا","https://www.aldiwan.net/poem11832.html","عموديه"],[154,"يا شارب الراح في أوقات غفلته","https://www.aldiwan.net/poem68529.html","البسيط"],[164,"إن له فرط غرام وأسا","https://www.aldiwan.net/poem58976.html","الرجز"],[164,"من سلم الحق إلى أربابه","https://www.aldiwan.net/poem59193.html","الرجز"],[168,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[173,"خلياني من وطاء ووساد","https://www.aldiwan.net/poem1619.html",""],[173,"عني إليك حوادث الأيام","https://www.aldiwan.net/poem1669.html",""],[189,"بر وبحر جفاه الوحش والسمك","https://www.aldiwan.net/poem14757.html","البسيط"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[211,"أعددت صوبة والصموت ومارنا","https://www.aldiwan.net/poem27917.html","الكامل"],[239,"دار الهوى بين اللوى وشراف","https://www.aldiwan.net/poem31818.html","الكامل"],[284,"ويوم أخذنا به فرصة","https://www.aldiwan.net/poem60709.html","المتقارب"],[289,"بشرى السلامة أشرقت","https://www.aldiwan.net/poem39378.html","مجزوء الكامل"],[301,"يا حادي الظعن إن جزت المواقيتا","https://www.aldiwan.net/poem33317.html","البسيط"],[310,"صرمت ظليمة خلتي ومراسلي","https://www.aldiwan.net/poem25.html","الكامل"],[346,"قلبي يحدثني","https://www.aldiwan.net/poem55325.html","منهوك البسيط"],[352,"ما عائق المتقدمين إلى الردى","https://www.aldiwan.net/poem20242.html","الكامل"],[357,"زن بالفضائل مجد جدك","https://www.aldiwan.net/poem40385.html","مجزوء الكامل"],[370,"برذوننا اليوم ما به عجب","https://www.aldiwan.net/poem17361.html","المنسرح"],[381,"عقلي يحدثه لسان نائح","https://www.aldiwan.net/poem66885.html","الكامل"],[406,"طالع اليمن بالوصال استهلا","https://www.aldiwan.net/poem46915.html","الخفيف"],[407,"قضيت في الحبس الشريف لياليا","https://www.aldiwan.net/poem33711.html","الكامل"],[410,"قولا له هل دار في حوبائه","https://www.aldiwan.net/poem50212.html","الكامل"],[420,"عاد المتيم في غرامك داؤه","https://www.aldiwan.net/poem54182.html","الكامل"],[461,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[461,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[461,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[461,"لمن الحمول بجو ضاحي","https://www.aldiwan.net/poem56255.html","مجزوء الكامل"],[461,"ما أنكرت إلا البياض فصدتِ","https://www.aldiwan.net/poem56266.html","الكامل"],[464,"تنبو الظبى والقنا حينا وآونة","https://www.aldiwan.net/poem16097.html","البسيط"],[503,"ما بين جرعاء اليلملم والعلم","https://www.aldiwan.net/poem37799.html","الكامل"],[517,"لله قوم بأكناف الحمى نزلوا","https://www.aldiwan.net/poem20817.html","البسيط"],[518,"هذي مناجاة عبد رق حاسده","https://www.aldiwan.net/poem12097.html","البسيط"],[554,"خذ صاحبي عني الذي أملي","https://www.aldiwan.net/poem47284.html","أحذ الكامل"],[554,"عل الهوى يهفو به العذل","https://www.aldiwan.net/poem47341.html","أحذ الكامل"],[561,"انظر إلى الكون وتسطيره","https://www.aldiwan.net/poem34458.html","السريع"],[561,"أحزاننا بلقائكم أفراح","https://www.aldiwan.net/poem34674.html","الكامل"],[564,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[565,"عليك بالعلم فاطلبه بلا كسل","https://www.aldiwan.net/poem52715.html","البسيط"],[578,"أوقد الحسن فوق خديك نارا","https://www.aldiwan.net/poem3068.html","الخفيف"],[589,"يا ممرض صبه بكثر التيه","https://www.aldiwan.net/poem17839.html","الدوبيت"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/12036","البسيط"],[1163,"","https://poetry.dctabudhabi.ae/diwan/poem/28946","البسيط"]],"verses":[["لا يَطعَمُ الطُعمَ إِلّا مِن فَريسَتِهِ","إِن يَعدَمِ القِرنَ يَوماً فَهوَ طَيّانُ",0,"ن",1,0],["لا يَطمَعُ الذُلُّ في جِوارِ فَتىً","تَلمَعُ فيهِ الصَوارِمُ الخُذُمُ",1,"م",1,0],["لا يَطمَعُ الأَعداءُ مَطلَعَ نَجدِهِ","قَد ضاقَ إِلّا عَنهُ ذاكَ المَطلَعُ",2,"ع",1,0],["لا يَطبَعونَ وَلا يَبورُ فَعالُهُم","إِذ لا يَميلُ مَعَ الهَوى أَحلامُها",3,"م",3,0],["لايُطغِيَنَّ بَني العَبّاسِ مُلكُهُمُ","بَنو عَلِيٍّ مَواليهِم وَإِن زَعَموا",4,"م",3,0],["لا يطمع الطالبُ في شأوِهِ","وإنَّما يطمعُ في رفده",5,"د",2,0],["لا يطرد المحل إلا صوب نائِله","ولا يجول على أفكاره الندَمُ",6,"م",1,0],["لا يَطمِئنُّ لِجَنبي مَضجَعُ وَكَذا","لا يَطمَئِنُّ لَهُ مُذ بِنتُ مَضجَعُهُ",7,"ع",2,0],["لا يَطْمَئنُّ بجْنبِي لِينُ مُضْطَجَعٍ","وما فراشُ أخي شكْوى بممهودِ",8,"د",1,0],["لا يطمئن من الحِذا","رِ بهِ المبيتُ ولا المظلُّ",9,"ل",1,0],["لا يُطْفِئُ اللَّهبَ المؤجَّجَ في دمي","موجُ الأسى وعواصفُ الأَزراءِ",10,"ا",2,0],["لا يُطمِعونَ خُيولَهُم في جَولَةِ","إِن نيلَ كَبشُهُمُ فَخَرَّ صَريعا",11,"ع",2,0],["لايَطرِفُ الطَرفُ إِلى غَيرِهِ","في حُسنِهِ مِن غَيرِهِ مُقنِعُ",12,"ع",1,0],["لا يُطمِعِ العُذّالَ حُسنُ تَجَلُّدي","فَلِذاكَ خَوفَ شَماتَةِ الأَعداءِ",13,"ا",2,0],["لا يَطمَعُ المَرءُ أَن يَجتابَ غَمرَتَهُ","بِالقَولِ ما لَم يَكُن جِسراً لَهُ العَمَلُ",14,"ل",1,0],["لا يَطرُدُ الهَمَّ إِلّا الهَمُّ مِن رَجُلٍ","مُقَلقِلٍ لِبَناتِ القَفرَةِ النُعُبِ",15,"ب",1,0],["لا يطمعِ المغرورُ ما لِثوائهم","أَجَلٌ ولا لجلائهم ميعادُ",16,"د",1,0],["لا يَطعمُ الضرَّبَ إلا حين يَجْمَعُهُم","يَوْمٌ يُبَرِّحُ بالجُرْدِ المحاضيرِ",17,"ر",1,0],["لا يَطمَئِنَّ فَإنْ ظَفِرْ","ت بما يُريدُ لكَ اطمأنْ",18,"ن",1,0],["لا يَطا بِرِجلِهِ","كُلَّ أَرضٍ لِكَلا",19,"ل",2,0],["لا يَطمَعُ الصَبُّ فيهِ في دَرَكٍ","وَلَو حَباهُ بِعَرشِ بَلقيسِ",20,"س",1,0],["لا يَطعَمُ البِيضُ إلاّ رأسَ ذي صَيَدٍ","أو ساقَ أدماءَ فيها النِّقْيُ بُنيانُ",21,"ن",1,1],["لا يَطّبيهِ غيرُ كَبّةِ مَعْرَكٍ","أو هَبْوَةٌ من مَأقِطٍ ومَغار",22,"ر",1,0],["لا يَطرُقُ الأَسماعَ في أَرجائِهِ","إِلّا تَرَنُّمُ أَلسُنِ العيدانِ",23,"ن",1,0],["لا يُطيعُ العُذّالَ في هَجرِ سَلمى","أَو تَصوغوهُ صَخرَةً أَو حَديدا",24,"د",2,0],["لا يَطلُعُ الغَربُ شافِياً ظَمَأً","حَتّى يُرى قَبلُ وَهوَ مُنحَدِرُ",25,"ر",1,0],["لا يطيب الخلود في لجج النا","ر فإن الخلود شيءٌ كثير",26,"ر",1,0],["لا يطمئن الشعب بعد جهاده","إلا إذا لمس المراد فنالا",27,"ل",2,0],["لا يَطْلُبَنّ كلامَهُ مُتَشَبِّهٌ","فالدُّرّ مُمْتَنِعٌ على طُلاّبهِ",28,"ب",2,0],["لا يطلب الثأر لميت ولا","يودَى لعمر الله فيمن ودى",29,"د",2,0],["لا يطلبنّ الغاية الشعراء","لو نال كنه جلالك الكبراء",30,"ا",2,0],["لا يَطْمِسُ الْجَهْلُ مَا أَثْقَبْتُ مِنْ شَرَفٍ","وَكَيْفَ يَحْجُبُ نُورَ الْجَوْنَةِ الدَّخَنُ",31,"ن",1,0],["لا يُطلِقُونَ إلى السَّفَاهِ حُبَاهُمُ","ويُرى خَطِيبُهُمُ بِحَقٍّ يَفْصِلُ",32,"ل",1,0],["لا يُطرِبُهُ التَّغْريدُ ولَوْ","غَنَّى بالأَرْغُنِ مَعْبَدهُ",33,"د",2,0],["لا يطفئُ الماءُ نيرانَ العدوِّ إذا","ما فار؛ بل تطفئُ النيرانَ نيرانَ",34,"ن",1,0],["لا يطرق الوهن عماد مجدنا","وكم ثللنا عرش مجد فكبا",35,"ا",1,0],["لا يطرق الضيم عزيز ركنهم","ولا يضام عائذ به احتمى",35,"ا",1,0],["لا يطلبون سوى ارتخاءِ قُيودهِم","أتُراهُمُ لم يطمعوا بفكاك",36,"ك",1,0],["لا يطيرونَ من سرورٍ ولا حزنٍ","شَعاعاً ، لأنه محسوب",37,"ب",1,0],["لا يطرقِ النازلُ المحذورُ ساحتهُ","وَلا تَمُدّ إلَيْهِ الحَادِثَاتُ يَدَا",38,"د",2,0],["لا يطمعنَّ زمانٌ أن بضعضعَ لي","رُكْنا ولا بِسهامِ البؤسِ يَرْمِينِي",39,"ن",2,0],["لا يطمع العظماءُ في مدحى ولا","طمَعى على أبوابهم معقولُ",40,"ل",1,0],["لا يَطمَعَنَّ نَبيهٌ في مَكانِهِما","فَما المَجَرَّةُ مِمَّن رامَها كَثَبُ",41,"ب",1,0],["لا يَطلُبَنَّ الوَرى ما أَنتَ مُحرِزُهُ","أَجَلُّهُم خَطَراً مَن باشَرَ الخَطَرا",42,"ر",2,0],["لا يَطمَعَن في حُسنِ عَفوِكَ طامِعٌ","حَتّى يُماثِلَ سِرَّهُ إِعلانُهُ",43,"ن",2,0],["لا يَطَّبيني مَكانٌ بَعدَ ظِلَّكُما","حَتّى يَهُزَّ هُبوبُ الريحِ ثَهلانا",44,"ن",2,0],["لا يطغَينَّكَ سترُ الله مذ زمنٍ","فكم أتى دون تسويف وإصرار",45,"ر",1,0],["لا يطي همته حب رشاً","عن قصد ذى بغي على العليا رشن",46,"ن",1,0],["لا يطرق الإسلام منك بعدها","بقربه ما ليس في حسابه",47,"ب",2,0],["لا يَطَّبيني طَمَعٌ مُدَنّسٌ","إِذا اِستَمالَ طَمَعٌ أَوِ اِطَّبى",48,"ا",1,0],["لا يَطيبُ العِزُّ ما لَم تَجنِهِ","بِاللِدانِ السُمرِ وَالبيضِ الحِدادِ",49,"د",1,0],["لا يُطمِعَنَّكِ فِيَّ هُلكُ مُقَدَّمٍ","فَالقَوسُ قَوسي وَالسِهامُ سِهامي",50,"م",2,0],["لا يَطرُق القَمَران الدهرَ ساحتَه","بلِ البدورُ به والشمس والفَلك",51,"ك",1,0],["لا يُطيقُ الإفصاحَ بالحقِّ عبدٌ","روحهُ مِن ضلالهِ خرساءُ",52,"ا",2,0],["لا يَطمَعُ التَالي اللَحاقَ بِها","يَوماً وَلَيسَ يَفوتُها المُؤلي",53,"ل",2,0],["لا يَطمَعُ الأَعداءُ في إِطفائِهِ","أَبَداً وَنورُ اللَهِ لَيسَ بِطافِ",54,"ف",1,0],["لا يُطمِعِ الأَعداءَ يَوْمٌ سَرَّهُمْ","إِنَّ الرَّدى فِي طَيِّ ذاكَ الْمَطْمَعِ",55,"ع",1,0],["لا يطلب الديدان إل","لا خنفساء محتقر",56,"ر",1,0],["لا يَطعَم الماءَ إلّا بلَّ غلَّتِه","ولا يَذوق سِوى سَدِّ الطَوى قوتا",57,"ت",2,0],["لا يطبعون وهم على أحسابهم","يشفون بالأَحلامِ داءَ الجاهلِ",58,"ل",1,0],["لا يطبي قلبي","در ولا ذهب",59,"ب",1,0],["لا يَطمَعْنكُمْ إنْ أَناخُوا بُرْهَةً","فَأَمَامَهُمْ سَفَرٌ لِيَوْمِ المَحْشَرِ",60,"ر",1,0],["لا يَطغينَّك صيت بَط","شك في الأَنام وَصَوت جُندك",61,"ك",1,0],["لا يَطوِ مِن بَطنِكَ الطِرادُ وَلا","يَنشُرَن مِن كُراعِكَ الغَضَبُ",62,"ب",1,0],["لا يطلب الديان منا آيةً","بل يطلب النوح الذي أنا مادح",63,"ح",1,0],["لا يطيقُ الضّلّيل حصر مَعاليهِ","وإن بات في القريض وظَلاَّ",64,"ل",2,0],["لا يطرق العينين خوف مطارق","أو خوف أصوات من الحراس",65,"س",1,0],["لا يُطمعنَّك نورُ كَوكَبِ عامِرٍ","فَوَراءُ قُربِ سَناهُ بِعدُ سَنائِهِ",66,"ا",3,0],["لا يطمئنَّ بيَ الملام فما له","منِّي سوى ما خابَ فيه رجاؤه",67,"ا",3,0],["لا يطمع الدهرُ في رضاي ولا","يُسخطني إن أَلام أو كَرُما",68,"م",2,0],["لا يطرحُ الذلَّ وراءَ ظهرِها","إلا فتىً يُنْضي المطايا الذُّلُلا",69,"ل",2,0],["لا يطمع الكفءُ الشريفُ بسعيه","فيها ولو ساق المهورَ وغالى",70,"ل",2,0],["لا يُطعَمون مع العش","يّ حلاوةَ النَّعمِ المُراحِ",71,"ح",1,0],["لا يطمئنُّ على التواكُلِ قلبُهُ","فيما رعى إن نامَ راعي الثَّلَّةِ",72,"ه",1,0],["لا يطَّبيهِمْ وإنْ حَنُّوا لأرضهُم","إلى مواطنهم والأهلِ تَرْحالُ",73,"ل",1,0],["لا يُطْلِعونَ على ضَميرِ قُلوبِهِمْ","ملَكاً لكَيْلا يُعْمِلُ المَلَكُ القَلَمْ",74,"م",1,0],["لا يُطْمعُ الخصمَ فيه لِينُ جانبِه","فقد تَلينُ الأفاعي والقَنا الذُّبُلُ",75,"ل",1,0],["لا يطرق النوم أجفاناً لمقلته","ومقلة الموت من قرب تراصده",76,"د",2,0],["لا يَطْعَمون سوى القبيحِ ولا","يَرِدون إلّا قَهْوةَ الجهلِ",77,"ل",1,0],["لا يطمحون إلى بُلَهْنِيَةٍ","في طيّها التّأْنيبُ والعَذَلُ",78,"ل",1,0],["لا يطلب الله بصدق ولا","يشتاق أن يلقاه في سيره",79,"ر",2,0],["لا يطربون لغير ذكر حبيبهم","أبداً فكل زمانهم أفراح",80,"ح",1,0],["لا يَطَّبِيني العَمَلُ المَقذِيُّ","وَلا مِنَ الأَخلاقِ دَغمرِيُّ",81,"ي",1,0],["لا يَطلبُ المرْءُ عِلماً للغِنَى فإذا","طلبتَ علماً فعنْ دُنياكَ لا تَسَلِ",82,"ل",1,0],["لا يطيقُ الكلامُ حصرَ معالي","كَ وهَلْ يَحصُر الكلامُ البِحَارَا",83,"ر",2,0],["لا يَطْلُبُ مُضْنىً مُغْرَمٌ فِيهِ سِوَى","إِبْلاغُ حُويجةٍ لَهُ في فيهِ",84,"ه",1,0],["لا يَطعَمُ النَومَ إِلّا رَيثَ يَبعَثُهُ","هَمٌّ يَكادُ سَناهُ يَقصِمُ الضِلَعا",85,"ع",2,0],["لا يطبقون اذا هَبَّ النيام ولا","في مرقدٍ يحلمون الدهر احلاما",86,"م",2,0]]}