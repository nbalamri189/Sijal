{"poems":[[9,"ألم تغتمض عيناك ليلة أرمدا","https://www.aldiwan.net/poem21923.html","الطويل"],[88,"صونوا يراع علي في متاحفكم","https://www.aldiwan.net/poem10487.html","البسيط"],[74,"من مبلغ علماء الأعصر الأول","https://www.aldiwan.net/poem19527.html","البسيط"],[53,"تبارك الله خالق الكرم البارع","https://www.aldiwan.net/poem65517.html","المنسرح"],[53,"علج إذا قلم أظفاره","https://www.aldiwan.net/poem66759.html","السريع"],[30,"إذا وعد الحجاج أو هم أسقطت","https://www.aldiwan.net/poem5457.html","الطويل"],[107,"إلام تجن الحادثات وتظلم","https://www.aldiwan.net/poem43423.html","الطويل"],[52,"ألم يأن أن تسلى مودة مهددا","https://www.aldiwan.net/poem63919.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85837","المجتث"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42579","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54519","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54880","السريع"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43785","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54227","الطويل"],[113,"نزيح ديار لا أنيس ولا صحب","https://www.aldiwan.net/poem16507.html","الطويل"],[119,"عقول الورى تاهت بسلطانك الأعلى","https://www.aldiwan.net/poem42204.html","الطويل"],[154,"أيا ذا الفضل والمنن","https://www.aldiwan.net/poem68497.html","مجزوء الرمل"],[154,"بطيبة للعافين أكرم سيد","https://www.aldiwan.net/poem68590.html","الطويل"],[190,"نزعت إلى الغواية والفتون","https://www.aldiwan.net/poem43231.html","الوافر"],[190,"سهرت وما مثلي ينام ويرقد","https://www.aldiwan.net/poem43910.html","الطويل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[208,"مليح القد والحدقه","https://www.aldiwan.net/poem53220.html","مجزوء الوافر"],[234,"خذوا بدمي لؤلؤ المبتسم","https://www.aldiwan.net/poem50788.html","المتقارب"],[277,"بسمنان بول الجوع مستنقعاً به","https://www.aldiwan.net/poem512.html",""],[287,"لقد كنت من وشك الفراق أليح","https://www.aldiwan.net/poem32832.html","الطويل"],[310,"سما للعلى يقظان عين حديدها","https://www.aldiwan.net/poem56578.html","الطويل"],[369,"أنصر أخاك مسعدا في ما حزب","https://www.aldiwan.net/poem60999.html","الطويل"],[409,"لك الله هذا غاية الخلق يا قلبي","https://www.aldiwan.net/poem34141.html","الطويل"],[411,"قلبي مقيم بنيسابور عند أخ","https://www.aldiwan.net/poem50010.html","البسيط"],[438,"الحمد لله ليس لي نشب","https://www.aldiwan.net/poem12540.html","المنسرح"],[463,"وذي جسدين ألقى الصبح منه","https://www.aldiwan.net/poem55880.html","الوافر"],[463,"أما والنقا لولا هوى ظيبة النقا","https://www.aldiwan.net/poem56097.html","الطويل"],[466,"بلوت خلاله والدهر خصم","https://www.aldiwan.net/poem15600.html","الوافر"],[466,"وزير يفر المحل عن جو أرضه","https://www.aldiwan.net/poem15648.html","الطويل"],[466,"له صبر الدلاص على الرزايا","https://www.aldiwan.net/poem15680.html","الوافر"],[473,"إذا ما زارني بركات يوما","https://www.aldiwan.net/poem60169.html","الوافر"],[473,"لا بارك الله فيمن","https://www.aldiwan.net/poem60340.html","المجتث"],[505,"رأت رفرف الأكوان هند فولت","https://www.aldiwan.net/poem37718.html","الطويل"],[520,"سرت نفحة كالمسك أزهى وأعطر","https://www.aldiwan.net/poem12119.html","الطويل"],[563,"ربي الذي ليس له ماهيه","https://www.aldiwan.net/poem33561.html","الرجز"],[563,"لنا الدرة البيضاء والعلم والجاه","https://www.aldiwan.net/poem33591.html","الطويل"],[580,"على خاطري يا شغله منك أشغال","https://www.aldiwan.net/poem3029.html","الطويل"],[580,"وصفتك واللاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54126","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70834","الوافر"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145820","المتقارب"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67828","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62484","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62509","السريع"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120038","الطويل"],[1403,"","https://poetry.dctabudhabi.ae/diwan/poem/115356","الوافر"],[1534,"","https://poetry.dctabudhabi.ae/diwan/poem/206189",""],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108703","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49598","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69319","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109372","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137257",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100316","الهزج"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58491","الطويل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3224,"","https://poetry.dctabudhabi.ae/diwan/poem/199770","الطويل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/53014","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86262","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108342",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45807","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69956","الوافر"],[4091,"","https://poetry.dctabudhabi.ae/diwan/poem/141839","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94460","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94405","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94550","البسيط"],[4296,"","https://poetry.dctabudhabi.ae/diwan/poem/103318","الوافر"],[4755,"أَسَرَّت إِلى أُختِها","https://www.poetsgate.com/ViewPoem.aspx?id=190547",""],[4869,"المقفص","https://www.poetsgate.com/ViewPoem.aspx?id=151534",""],[4935,"لنا ثغر التهاني لا باسم","https://www.poetsgate.com/ViewPoem.aspx?id=129448",""],[4003,"قلبي رهين بنيسابور عند أخ","https://www.poetsgate.com/ViewPoem.aspx?id=181182",""],[5064,"أهازيجُ الغُبار","https://www.poetsgate.com/ViewPoem.aspx?id=199174",""],[3271,"راهب النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=104128",""],[5184,"صبرُ الزيتون","https://www.poetsgate.com/ViewPoem.aspx?id=189879",""],[5277,"غرور","https://www.poetsgate.com/ViewPoem.aspx?id=185285",""],[5338,"أخادع نفسي بالأماني الكواذب","https://www.poetsgate.com/ViewPoem.aspx?id=187713",""],[5431,"حبيبي ...","https://www.poetsgate.com/ViewPoem.aspx?id=189358",""],[5674,"فرات الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=189070",""],[5759,"مُسَهِّدَتي","https://www.poetsgate.com/ViewPoem.aspx?id=213782",""],[5804,"آخر أنسأم الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=180676",""]],"verses":[["لَهُ صَدَقاتٌ ما تُغِبُّ وَنائِلٌ","وَلَيسَ عَطاءُ اليَومِ مانِعَهُ غَدا",0,"د",2,0],["لَهُ صَريرٌ إِذا جَدَّ النِزالُ بِهِ","يُنسي الكُماةِ صَليلَ البيضِ وَالقُضُبِ",1,"ب",1,0],["له صفاتٌ بها الأقلام راكعةٌ","كأنها من قبيل الصحف في قبل",2,"ل",1,0],["له صريح كأنه ذهب","ورغوة كاللآلئ الفلق",3,"ق",1,0],["له صياصٍ من شقاقٍ به","في قَدَميْهِ ما يداويهِ",4,"ه",1,0],["لَهُ صَولَةٌ مَن يوقَها أَن تُصيبَهُ","يَعِش وَهوَ مِنها مُستَخَفُّ الخَصائِلِ",5,"ل",1,0],["لَهُ صِبيَةٌ خُمصُ البُطُونِ كَأَنَّهُم","جَوازِلُ وَكرٍ ما لَها فيهِ مُطعِمُ",6,"م",1,0],["لَهُ صَفَدٌ دانٍ وَشَعبٌ مُؤَخَّرٌ","وَإِن سيمَ خَسفاً قَذَّمَ المَوتَ أَسوَدا",7,"د",2,0],["له صراط كحد","السيف الجراز يبين",8,"ن",1,0],["له صرخة في اللَيل إن نام أَهله","تكاد لها صم الجبال تصدَّع",9,"ع",1,0],["لَهُ صِحَابٌ قَدْ أَحَاطَتْ بِهِ","تَنْقُلُ عَنْهُ نَبَرَاتِ الصَّدَى",10,"د",2,0],["لَهُ صُوَرٌ أَبَداً تَسْتَجِدُّ","وَجَوْهَرُهُ أَبَداً فِي صَفاءْ",11,"ا",2,0],["لَهُ صَدىً فِي القَلْبِ وَالفِكْرِ مِن","أَشْهَى مَتاعِ القَلبِ والفِكْرِ",12,"ر",1,0],["لَهُ صَبرُ أَيّوبٍ عَلى ما أَصابَهُ","وَإِن غَيَّرَت مِنهُ مَحاسِنُ يوسُفِ",13,"ف",1,0],["له صَوْتُ صِدْقٍ بالدُّعَاءِ مُجَلْجِلٍ","يُفَتِّحُ أبوابَ السَّمَواتِ صاخِبُه",14,"ب",2,0],["لَهُ صِبية عِندَ العداة رَهينة","وَمَدمعهم مِن فَرط لَهفِهم صَبُّ",15,"ب",1,0],["له صام شخص الكائنات تذللا","وناجاه تعظيما وفي بيته صلى",16,"ل",2,0],["له صحّ الكمال ولم","يكن إلاّ لِمَن ومَن",17,"ن",1,0],["لهُ صارَ كِسرى ما اِستَعَدَّ بِكَنزِهِ","وَإِذ هَزَّ سَيفَ الحَقِّ ماتَ لِهَزِّهِ",18,"ه",1,0],["له صدغان قد ضمنا وفاتي","كما ضمنت حميّاها الحنون",19,"ن",1,0],["له صبية من كل فج تجمّعوا","وما فيهم إلا مشوم منكد",20,"د",1,0],["لَهُ صنّفوا فِقهاً حَديثاً تصوّفاً","عَقائد تفسيراً بإِسنادها تُدرى",21,"ر",2,0],["له صُدغانِ من حُسنٍ","على الخدينِ كالحَلَقَه",22,"ق",2,0],["له صَوْلَجان كلون الظلامِ","على وجنة مثلِ لون العَنَم",23,"م",1,0],["له صُفرةٌ فوق العيونِ كأنها","بقايا شعاع الأفْقِ والليلُ شاملُهْ",24,"ل",2,0],["لَهُ صُورَةٌ أَضحَت تَروقُ وَسَورَةٌ","تَروقُ وَخَلقٌ كَالنَسيمِ سَجيحُ",25,"ح",1,0],["لَه صورةٌ في كلِّ نفسٍ فعولة","كَماليّةٌ معشوقُ كلّ شهودها",26,"د",3,0],["له صَلاةٌ من صِلاتٍ دائما","يُقيمها من واجبٍ ومُستَحب",27,"ب",1,0],["له صبر أيوب وطول مقامه","ولم يشتك الأسقام إلا إلى الرب",28,"ب",1,0],["لهُ صحائفُ أخلاقٍ مُهذَّبةٍ","مِنها العُلا والنُّهى والمَجدُ يُنتَسَخُ",29,"خ",1,0],["له صِفاتٌ لم تجتمِعْ لفتًى","سواهُ حقاً كذا العُلى رُتَبُ",30,"ب",1,0],["له صفةُ المباسِم والتراقي","وشِبْهُ في الأهلَّةِ والنجومِ",31,"م",1,0],["له صارمٌ ريّانُ من دمِ بعضهم","وآخرُ يحمي بعضه أن يمزَّقا",32,"ق",2,0],["له صبرُ الدُّروعِ على الرَّزايا","تخَطَّتْهُ واِقْدامٌ كَنَبْلِ",33,"ل",1,0],["له صادق من بِشْرِ جودٍ لشائمٍ","اذا كذَبتْ غُرُّ البروق اللَّوامعِ",34,"ع",1,0],["له صبرُ الدِّلاصِ على الرَّزايا","وعند الرَّوْعِ اِقْدامُ السِّهامِ",35,"م",1,1],["لَهُ صُدغٌ كَصَدٍّ بَعدَ وَصلِ","عَلى خَدٍّ كَوَصلٍ بَعدَ صَدِّ",36,"د",1,0],["لَهُ صَحيفَةُ وَجهٍ","خَلّابَةَ الأَلِفاتِ",37,"ت",1,0],["له صين علم الغيب فاللوح عنه قد","تلقى كنوز العلم من كل شكلة",38,"ه",1,0],["له صارم في أسود النقع أحمر","له جانب في أحمر الحديد أخضر",39,"ر",1,0],["له صفات مثله قديمة","قائمة بذاته العليه",40,"ي",2,0],["له صورة من علمه قد ترتبت","ظهوراً ولا موجود في الكون إلا هُوْ",41,"ه",2,0],["له صولةُ الرِّئْبالِ في مَائس القَنا","ولا ريْبَ أَنَّ ابْنَ الغَضَنْفَرِ رئْبالُ",42,"ل",1,0],["له صارِمٌ يَشْفي به الدينُ صدرَه","ويُنجِزُ وعدَ النَّصر مِنه بِلاَ مَطْل",43,"ل",1,0],["له صورةٌ تسبي القلوب جميلةٌ","له سيرةٌ تسلي النفوسَ وسؤددُ",44,"د",1,0],["له صوت يرجَّعُه","كترجيع ابن عمار",45,"ر",1,0],["لَه صُحبَةٌ معَنَا مُذْ ذُهِلنَا","بأشيائِنَا وَالذهُولُ اعْترَانَا",46,"ن",2,0],["لَهُ صِدْقُ وَعْدٍ زَانَهُ بِوَفَائِهِ","زَكَيْتُ بِمَا ألْفَيْتُهُ مِنْ ثَنَائِهِ",47,"ه",1,0],["له صَولة تفني العِداة ورحمة","يعيش بها مَن حَظُّه اليومَ خامدُ",48,"د",1,0],["له صفاةٌ شرفت حلبة","كأنه قد نظَم الفرقدا",49,"د",2,0],["له صفحة في جانبيها طلاقة","وبشر بادراك النجاح بشيرًُ",50,"ر",1,0],["له صدغان معقوفان منه","بنات القلب تجنح في السباق",51,"ق",1,0],["له صايبٍ من صيب به صار مفقود","وله شيمةٍ من رادها نال قَصَّاد",52,"د",1,0],["له صارمٌ من رأيه تخضعُ الظبى","له ويراعٌ تتقي بأسه السمر",53,"ر",1,0],["له صفتا بأسٍ وجودٍ تلاقتا","عليه وإن قالوا هما لقْبٌ واسْمُ",54,"م",1,0],["لَهُ صارِمٌ دَلَّت فُلولٌ بِحَدِّهِ","عَلى أَنَّهُ لِلجَيشِ بِالجَيشِ فَلّالُ",55,"ل",1,0],["له صرف مدحي لا يرد بمانعٍ","وللصرف في بعض الكلام موانع",56,"ع",1,0],["له صيت كفواح الخزامى","ورأي كم اقيل به عثار",57,"ر",1,0],["له صرح سليمان الذ","ي اوهم بلقيسا",58,"س",2,0],["له صورةٌ يَسْتَحِنُ القردُ عندها","على أَنَّ وجهَ القردِ أَحسنُ منظرا",59,"ر",2,1],["له صفات تعالت عن مضاددة","حياته ثم علم قدرة الكلم",60,"م",1,0],["له صورة في القلب لم يقصها النوى","ولم تتخطفها أكف النوائب",61,"ب",1,0],["له صيتٌ به الركبان سارتْ","لهذا أرخوه بافتخاره",62,"ه",1,0],["لَهُ صَبوَة حَنت لِمَجد كَمالَهُ","لِكَسبِ المَعالي وَالفخار حَنين",63,"ن",1,0],["له صفات كزهر الورد قد جملت","من دونها نسمات الورد في السحر",64,"ر",1,0],["لَهُ صارم أَن أبصر العمر متنه","يصرمهُ مِن حَيث لَم يَتَصَرم",65,"م",1,0],["لَهُ صَوت الحصور بَدا اعدواً","طَريق الرَب مِن قَبل الحِمامِ",66,"م",1,0],["لَهُ صعقات موسى في خطابٍ","وَغيرة قَلب ايليا الهمامِ",66,"م",1,0],["له صغت أبيات ثلاثا رمزتها","أوائل كلمات فهن مراتب",67,"ب",1,0],["لَهُ صِفاتٌ تسامت في محاسنها","ووصفهُ قد سما مدحاً يحاورُهُ",68,"ر",2,0],["لَهُ صفات تسامت في محامدها","لم يجزِ في وصفها نظمٌ ولا نثرُ",69,"ر",1,0],["لهُ صفاتٌ مباهيها مُوحَّدَةٌ","ما إن ترى مقلةٌ مولىً يباريهِ",70,"ي",2,0],["له صدغان من سبجٍ","على خَدَّيه كالحلقه",71,"ق",2,0],["لهُ صَفحةٌ أَصبَحَت مَرتَعًا","لِقَلبي, ونُورًا