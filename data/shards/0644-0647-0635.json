{"poems":[[9,"ألم تغتمض عيناك ليلة أرمدا","https://www.aldiwan.net/poem21923.html","الطويل"],[86,"صونوا يراع علي في متاحفكم","https://www.aldiwan.net/poem10487.html","البسيط"],[72,"من مبلغ علماء الأعصر الأول","https://www.aldiwan.net/poem19527.html","البسيط"],[51,"تبارك الله خالق الكرم البارع","https://www.aldiwan.net/poem65517.html","المنسرح"],[51,"علج إذا قلم أظفاره","https://www.aldiwan.net/poem66759.html","السريع"],[28,"إذا وعد الحجاج أو هم أسقطت","https://www.aldiwan.net/poem5457.html","الطويل"],[105,"إلام تجن الحادثات وتظلم","https://www.aldiwan.net/poem43423.html","الطويل"],[50,"ألم يأن أن تسلى مودة مهددا","https://www.aldiwan.net/poem63919.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85837","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42579","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54519","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54880","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43785","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54227","الطويل"],[107,"نزيح ديار لا أنيس ولا صحب","https://www.aldiwan.net/poem16507.html","الطويل"],[113,"عقول الورى تاهت بسلطانك الأعلى","https://www.aldiwan.net/poem42204.html","الطويل"],[148,"أيا ذا الفضل والمنن","https://www.aldiwan.net/poem68497.html","مجزوء الرمل"],[148,"بطيبة للعافين أكرم سيد","https://www.aldiwan.net/poem68590.html","الطويل"],[184,"نزعت إلى الغواية والفتون","https://www.aldiwan.net/poem43231.html","الوافر"],[184,"سهرت وما مثلي ينام ويرقد","https://www.aldiwan.net/poem43910.html","الطويل"],[187,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[202,"مليح القد والحدقه","https://www.aldiwan.net/poem53220.html","مجزوء الوافر"],[227,"خذوا بدمي لؤلؤ المبتسم","https://www.aldiwan.net/poem50788.html","المتقارب"],[270,"بسمنان بول الجوع مستنقعاً به","https://www.aldiwan.net/poem512.html",""],[280,"لقد كنت من وشك الفراق أليح","https://www.aldiwan.net/poem32832.html","الطويل"],[303,"سما للعلى يقظان عين حديدها","https://www.aldiwan.net/poem56578.html","الطويل"],[362,"أنصر أخاك مسعدا في ما حزب","https://www.aldiwan.net/poem60999.html","الطويل"],[400,"لك الله هذا غاية الخلق يا قلبي","https://www.aldiwan.net/poem34141.html","الطويل"],[402,"قلبي مقيم بنيسابور عند أخ","https://www.aldiwan.net/poem50010.html","البسيط"],[429,"الحمد لله ليس لي نشب","https://www.aldiwan.net/poem12540.html","المنسرح"],[456,"وذي جسدين ألقى الصبح منه","https://www.aldiwan.net/poem55880.html","الوافر"],[456,"أما والنقا لولا هوى ظيبة النقا","https://www.aldiwan.net/poem56097.html","الطويل"],[459,"بلوت خلاله والدهر خصم","https://www.aldiwan.net/poem15600.html","الوافر"],[459,"وزير يفر المحل عن جو أرضه","https://www.aldiwan.net/poem15648.html","الطويل"],[459,"له صبر الدلاص على الرزايا","https://www.aldiwan.net/poem15680.html","الوافر"],[466,"إذا ما زارني بركات يوما","https://www.aldiwan.net/poem60169.html","الوافر"],[466,"لا بارك الله فيمن","https://www.aldiwan.net/poem60340.html","المجتث"],[498,"رأت رفرف الأكوان هند فولت","https://www.aldiwan.net/poem37718.html","الطويل"],[513,"سرت نفحة كالمسك أزهى وأعطر","https://www.aldiwan.net/poem12119.html","الطويل"],[556,"ربي الذي ليس له ماهيه","https://www.aldiwan.net/poem33561.html","الرجز"],[556,"لنا الدرة البيضاء والعلم والجاه","https://www.aldiwan.net/poem33591.html","الطويل"],[573,"على خاطري يا شغله منك أشغال","https://www.aldiwan.net/poem3029.html","الطويل"],[573,"وصفتك واللاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"]],"verses":[["لَهُ صَدَقاتٌ ما تُغِبُّ وَنائِلٌ","وَلَيسَ عَطاءُ اليَومِ مانِعَهُ غَدا",0,"د",2,0],["لَهُ صَريرٌ إِذا جَدَّ النِزالُ بِهِ","يُنسي الكُماةِ صَليلَ البيضِ وَالقُضُبِ",1,"ب",1,0],["له صفاتٌ بها الأقلام راكعةٌ","كأنها من قبيل الصحف في قبل",2,"ل",1,0],["له صريح كأنه ذهب","ورغوة كاللآلئ الفلق",3,"ق",1,0],["له صياصٍ من شقاقٍ به","في قَدَميْهِ ما يداويهِ",4,"ه",1,0],["لَهُ صَولَةٌ مَن يوقَها أَن تُصيبَهُ","يَعِش وَهوَ مِنها مُستَخَفُّ الخَصائِلِ",5,"ل",1,0],["لَهُ صِبيَةٌ خُمصُ البُطُونِ كَأَنَّهُم","جَوازِلُ وَكرٍ ما لَها فيهِ مُطعِمُ",6,"م",1,0],["لَهُ صَفَدٌ دانٍ وَشَعبٌ مُؤَخَّرٌ","وَإِن سيمَ خَسفاً قَذَّمَ المَوتَ أَسوَدا",7,"د",2,0],["له صراط كحد","السيف الجراز يبين",8,"ن",1,0],["له صرخة في اللَيل إن نام أَهله","تكاد لها صم الجبال تصدَّع",9,"ع",1,0],["لَهُ صِحَابٌ قَدْ أَحَاطَتْ بِهِ","تَنْقُلُ عَنْهُ نَبَرَاتِ الصَّدَى",10,"د",2,0],["لَهُ صُوَرٌ أَبَداً تَسْتَجِدُّ","وَجَوْهَرُهُ أَبَداً فِي صَفاءْ",11,"ا",2,0],["لَهُ صَدىً فِي القَلْبِ وَالفِكْرِ مِن","أَشْهَى مَتاعِ القَلبِ والفِكْرِ",12,"ر",1,0],["لَهُ صَبرُ أَيّوبٍ عَلى ما أَصابَهُ","وَإِن غَيَّرَت مِنهُ مَحاسِنُ يوسُفِ",13,"ف",1,0],["له صَوْتُ صِدْقٍ بالدُّعَاءِ مُجَلْجِلٍ","يُفَتِّحُ أبوابَ السَّمَواتِ صاخِبُه",14,"ب",2,0],["لَهُ صِبية عِندَ العداة رَهينة","وَمَدمعهم مِن فَرط لَهفِهم صَبُّ",15,"ب",1,0],["له صام شخص الكائنات تذللا","وناجاه تعظيما وفي بيته صلى",16,"ل",2,0],["له صحّ الكمال ولم","يكن إلاّ لِمَن ومَن",17,"ن",1,0],["لهُ صارَ كِسرى ما اِستَعَدَّ بِكَنزِهِ","وَإِذ هَزَّ سَيفَ الحَقِّ ماتَ لِهَزِّهِ",18,"ه",1,0],["له صدغان قد ضمنا وفاتي","كما ضمنت حميّاها الحنون",19,"ن",1,0],["له صبية من كل فج تجمّعوا","وما فيهم إلا مشوم منكد",20,"د",1,0],["لَهُ صنّفوا فِقهاً حَديثاً تصوّفاً","عَقائد تفسيراً بإِسنادها تُدرى",21,"ر",2,0],["له صُدغانِ من حُسنٍ","على الخدينِ كالحَلَقَه",22,"ق",2,0],["له صَوْلَجان كلون الظلامِ","على وجنة مثلِ لون العَنَم",23,"م",1,0],["له صُفرةٌ فوق العيونِ كأنها","بقايا شعاع الأفْقِ والليلُ شاملُهْ",24,"ل",2,0],["لَهُ صُورَةٌ أَضحَت تَروقُ وَسَورَةٌ","تَروقُ وَخَلقٌ كَالنَسيمِ سَجيحُ",25,"ح",1,0],["لَه صورةٌ في كلِّ نفسٍ فعولة","كَماليّةٌ معشوقُ كلّ شهودها",26,"د",3,0],["له صَلاةٌ من صِلاتٍ دائما","يُقيمها من واجبٍ ومُستَحب",27,"ب",1,0],["له صبر أيوب وطول مقامه","ولم يشتك الأسقام إلا إلى الرب",28,"ب",1,0],["لهُ صحائفُ أخلاقٍ مُهذَّبةٍ","مِنها العُلا والنُّهى والمَجدُ يُنتَسَخُ",29,"خ",1,0],["له صِفاتٌ لم تجتمِعْ لفتًى","سواهُ حقاً كذا العُلى رُتَبُ",30,"ب",1,0],["له صفةُ المباسِم والتراقي","وشِبْهُ في الأهلَّةِ والنجومِ",31,"م",1,0],["له صارمٌ ريّانُ من دمِ بعضهم","وآخرُ يحمي بعضه أن يمزَّقا",32,"ق",2,0],["له صبرُ الدُّروعِ على الرَّزايا","تخَطَّتْهُ واِقْدامٌ كَنَبْلِ",33,"ل",1,0],["له صادق من بِشْرِ جودٍ لشائمٍ","اذا كذَبتْ غُرُّ البروق اللَّوامعِ",34,"ع",1,0],["له صبرُ الدِّلاصِ على الرَّزايا","وعند الرَّوْعِ اِقْدامُ السِّهامِ",35,"م",1,1],["لَهُ صُدغٌ كَصَدٍّ بَعدَ وَصلِ","عَلى خَدٍّ كَوَصلٍ بَعدَ صَدِّ",36,"د",1,0],["لَهُ صَحيفَةُ وَجهٍ","خَلّابَةَ الأَلِفاتِ",37,"ت",1,0],["له صين علم الغيب فاللوح عنه قد","تلقى كنوز العلم من كل شكلة",38,"ه",1,0],["له صارم في أسود النقع أحمر","له جانب في أحمر الحديد أخضر",39,"ر",1,0],["له صفات مثله قديمة","قائمة بذاته العليه",40,"ي",2,0],["له صورة من علمه قد ترتبت","ظهوراً ولا موجود في الكون إلا هُوْ",41,"ه",2,0],["له صولةُ الرِّئْبالِ في مَائس القَنا","ولا ريْبَ أَنَّ ابْنَ الغَضَنْفَرِ رئْبالُ",42,"ل",1,0],["له صارِمٌ يَشْفي به الدينُ صدرَه","ويُنجِزُ وعدَ النَّصر مِنه بِلاَ مَطْل",43,"ل",1,0]]}