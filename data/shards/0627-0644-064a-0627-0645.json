{"poems":[[55,"طلاب العز من شيم الشجاع","https://www.aldiwan.net/poem30155.html","الوافر"],[88,"أما أمين فقد ذقنا لمصرعه","https://www.aldiwan.net/poem10377.html","البسيط"],[29,"ما هاج شوقك من عهود رسوم","https://www.aldiwan.net/poem6009.html","الكامل"],[31,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[31,"يا مي هلا يجازي بعض ودكم","https://www.aldiwan.net/poem6157.html","البسيط"],[40,"طاف الخيال بأصحابي وقد هجدوا","https://www.aldiwan.net/poem7701.html","البسيط"],[47,"أنافعي عند ليلى فرط حبيها","https://www.aldiwan.net/poem66850.html","البسيط"],[30,"وجدنا الأزد من بصل وثوم","https://www.aldiwan.net/poem5076.html","الوافر"],[30,"ومنا الذي لا ينطق الناس عنده","https://www.aldiwan.net/poem5341.html","البسيط"],[107,"ركدت وهبت لوعة الحزن تدأب","https://www.aldiwan.net/poem42108.html","الطويل"],[50,"أصبحت محتاجا إلى ضرب","https://www.aldiwan.net/poem62441.html","الطويل"],[50,"كنت من الحب في ذرى نيق","https://www.aldiwan.net/poem64447.html","المنسرح"],[52,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16652","البسيط"],[137,"أحاطت بغايات العلا والمفاخر","https://www.aldiwan.net/poem4236.html","الطويل"],[240,"مولاي مجد الدين يا","https://www.aldiwan.net/poem31794.html","مجزوء الرجز"],[242,"من أفقر الخلق بذا الزمن","https://www.aldiwan.net/poem19296.html","السريع"],[358,"بشير لقا الأحبة حين حيا","https://www.aldiwan.net/poem39583.html","الوافر"],[369,"لولا طروق خيال منك منتظر","https://www.aldiwan.net/poem60919.html","البسيط"],[566,"الحمد لله الذي استقلت","https://www.aldiwan.net/poem27845.html","الرجز"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2454","الوافر"],[762,"","https://poetry.dctabudhabi.ae/diwan/poem/103648","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63840","الهزج"],[1116,"","https://poetry.dctabudhabi.ae/diwan/poem/117074","الرجز"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21686","المنسرح"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45403","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118372","الطويل"],[2792,"","https://poetry.dctabudhabi.ae/diwan/poem/123625","البسيط"],[2909,"","https://poetry.dctabudhabi.ae/diwan/poem/96424","البسيط"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112584","الطويل"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67590","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111462","المتقارب"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45045","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94386","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66107","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139639",""],[4702,"الصقر ينفض غباره","https://www.poetsgate.com/ViewPoem.aspx?id=155206",""],[4702,"اليا اختلط وكر الصقور بشي من ريش النعام","https://www.poetsgate.com/ViewPoem.aspx?id=155320",""],[4718,"ماجور ياصدرٍ قطع قلبه الياس","https://www.poetsgate.com/ViewPoem.aspx?id=137171",""],[4767,"أتاك الشكر","https://www.poetsgate.com/ViewPoem.aspx?id=178839",""],[1663,"الى امرئ نصبت قحطان رايتها","https://www.poetsgate.com/ViewPoem.aspx?id=93229",""],[4869,"مغشا بدويه","https://www.poetsgate.com/ViewPoem.aspx?id=138046",""],[4869,"ياحظي الطايح","https://www.poetsgate.com/ViewPoem.aspx?id=151638",""],[4869,"نظم المواجع","https://www.poetsgate.com/ViewPoem.aspx?id=162800",""],[460,"لا تتركن إن صنيعة ٌ سلفت","https://www.poetsgate.com/ViewPoem.aspx?id=22194",""],[5122,"يجض الخفوق","https://www.poetsgate.com/ViewPoem.aspx?id=18065",""],[5122,"أحبهاااا","https://www.poetsgate.com/ViewPoem.aspx?id=20463",""],[5183,"إلى رجال الإستقامة","https://www.poetsgate.com/ViewPoem.aspx?id=180170",""],[5198,"الكحل","https://www.poetsgate.com/ViewPoem.aspx?id=135396",""],[5198,"وهل يخفى القمر","https://www.poetsgate.com/ViewPoem.aspx?id=135398",""],[5198,"هوى النفس","https://www.poetsgate.com/ViewPoem.aspx?id=155075",""],[5220,"البارحه","https://www.poetsgate.com/ViewPoem.aspx?id=37049",""],[5277,"حسّونُ الصوبين..","https://www.poetsgate.com/ViewPoem.aspx?id=190915",""],[5411,"شَرُّ البَليّةِ","https://www.poetsgate.com/ViewPoem.aspx?id=185440",""],[5431,"القبة العليا ...","https://www.poetsgate.com/ViewPoem.aspx?id=210728",""],[5486,"امرأة من حجر","https://www.poetsgate.com/ViewPoem.aspx?id=211189",""],[5493,"طيفُ امرأة","https://www.poetsgate.com/ViewPoem.aspx?id=205292",""],[5533,"لَيَالي الشَّوْق","https://www.poetsgate.com/ViewPoem.aspx?id=186685",""],[5616,"مزاج","https://www.poetsgate.com/ViewPoem.aspx?id=203198",""],[5652,"نوت الدفينه","https://www.poetsgate.com/ViewPoem.aspx?id=192040",""],[5652,"تفاحة نيوتن","https://www.poetsgate.com/ViewPoem.aspx?id=208680",""],[5756,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=5431",""],[5843,"رأفت الهجان","https://www.poetsgate.com/ViewPoem.aspx?id=51300",""],[6075,"أماني عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=203788",""],[6100,"قلب المولع","https://www.poetsgate.com/ViewPoem.aspx?id=52594",""]],"verses":[["إِلى أَمَلِ الحُسَينِ بَسَطتُ ظَنّي","وَرَشَّحتُ المَطالِبَ لِانتِجاعي",0,"ع",2,0],["إِلى أَمينٍ عَلى أَوطانِهِ يَقِظٍ","ذي مِرَّةٍ يَتَلَقّى الخَطبَ جَذلانا",1,"ن",2,0],["آلى أَميرُكَ لا يَرُدُّ تَحِيَّةً","ماذا بِمَن شَعَفَ الهَوى بِرَحيمِ",2,"م",1,0],["إِلى اِمرِئٍ لا تُعَرّينا نَوافِلُهُ","أَظفَرَهُ اللَهُ فَليَهنِئ لَهُ الظَفَرُ",3,"ر",1,0],["إِلى اِمرِئٍ لا تَخَطّاهُ الرِفاقُ وَلا","جَدبِ الخُوانِ إِذا ما اِستُبطِئَ المَرَقُ",4,"ق",1,0],["إِلى اِمرِئٍ لَم تَلِد يَوماً لَهُ شَبَهاً","أُنثى لَهُ كَرَماً يَوماً وَلَن تَلِدُ",5,"د",1,0],["إِلى إِمامٍ لَهُ ما كانَ مِن شَرَفٍ","يُعَدُّ في سالِفِ الدُنيا وَباقيها",6,"ي",3,0],["إِلى أُمِّ المُهَلَّبِ حَيثُ أَعطَت","بِثَديِ اللُؤمِ فاهَ مَعَ الصِغارِ",7,"ر",1,0],["إِلى أَمَدٍ حَتّى يُزايِلَ بَينَهُم","وَيوجِعُ مِنّا النَخسُ مَن هُوَ مُقرِفُ",8,"ف",1,0],["إلى أُمَّةٍ تُلقِي إليكم رَجاءَها","إذا هَاجَها يومٌ مِن الشَّرِّ أشهبُ",9,"ب",1,0],["إِلى اِمرِئٍ يُطعِنُ في دينِهِ","يُورِقُ مِنهُ خَشَبُ الصَلبِ",10,"ب",1,0],["إِلى اِمرِئٍ أُمُّ مالِهِ أَبَداً","تَسعى بِجَيبٍ في الناسِ مَشقوقِ",11,"ق",1,0],["إِلى إِمامِ الناسِ وَجَّهتُها","تَجري عَلى غارٍ مِنَ الطُحلُبِ",12,"ب",1,0],["آلى أميرُكِ لا يَسْري الخَيالُ لنا","إذا هَجَعْنا فقد أسْرَى وما عَلِما",13,"م",2,0],["إلى امرِهِ في كُلِّ أمرٍ ونهيهِ","يَرُوحُ ويغدُو كُلُّ ناهٍ وآخِرِ",14,"ر",1,0],["إِلى إِمامٍ لَم يَخِب","في عَصرِهِ مُؤَمِّلُ",15,"ل",1,0],["إِلى إِمامٍ جودُهُ","لِكُلِّ راجٍ مَوئِلُ",15,"ل",1,0],["إِلَى إِمَامِ الْعَصْرِ أَوْحَدِهِ","عَمِيدِ أَهْلِ السَّنَنِ الْحَسَنِ",16,"ن",1,0],["أَلي أَم لِلوشاة لظاك تصلي","فَمَن أَولى بِجذوتها صِليّا",17,"ي",2,0],["إلى إمام الهُدَى مَدَّتْ هَواديَها","عِيسٌ وصلْن لنا الآصالَ بالبُكَر",18,"ر",1,0],["إِلى أَمارٍ وَأَمارٌ مُدَّتي","دافَعَ عَني بِنُقَيرٍ مَوتَتي",19,"ت",2,0],["إلى امرئ للأمر يرتضونه","من أفضل القوم يؤمرونه",20,"ه",1,0],["إِلى أُمِّ البَنينَ مَتى","يُقَرِّبُها مُقَرِّبُها",21,"ب",3,0],["الى امير المؤمنين المجدي","ربّ مَعَدّ وسوى معد",22,"د",1,0],["إلى أمقتِ في المنظ","رِ من زِيَارِ بَيْطار",23,"ر",1,0],["إِلى امرِىءٍ له أيَادٍ عِندِي","وَاجِبةُ الحَقّ وَلَم أُؤدِّ",24,"د",1,0],["إِلى اِمرِىءٍ أَن تَقولَ إِن ذُكِرَت","عِندَكَ في الجِدِّ لَستُ أَذكُرُها",25,"ر",3,0],["إِلى آمِرٍ في الدَهرِ ناهٍ إِذا قَضى","عَلى كُلِّ مَن فيها أَطاعوهُ قاضِيا",26,"ي",2,0],["الى امره كانوا سراعا فربهم","اليهم بما يبغون منه سريع",27,"ع",1,0],["إلى امزء ماجد الآباء كان لنا","حصناً حصيناً من اللأواء والغير",28,"ر",1,0],["إلى امري مشبع مجدا ومكرمةً","عارية فهوَ حالٍ منهما كاسي",29,"س",2,0],["إلى أمم الإسلام أزجى قصيدتي","وماهي إلا منيتي ورجائي",30,"ا",2,0],["إلى اُمَمٍ عهدُها بالدِّهانِ","بعيدٌ طويلٌ وفَليِ الشَّعَرْ",31,"ر",1,0],["إِلى أُمِّنا طِر وَقُل تَذهَبُ","جَمِيعَ النَّبِيلاتِ تَصطَحِبُ",32,"ب",1,0],["الى امام الحضرة القدسية","وآله وصحبه من بعد",33,"د",1,0],["إِلى أَمثالِهِ ما دامَ تَبدو","أَهِلَّتُهُ وَأَنتَ لَها السَناءُ",34,"ا",2,0],["إلى أُمَّة الأشراف قد جاءَ أُمَّةً","إِمام لَهُ أُمُّ النجوم منابرُ",35,"ر",1,0],["إلى أمَّةٍ فَتَّ العِدَى في يَمِينِها","وازْرَى بها احْجامُها وقُعُودُها",36,"د",3,0],["إلى أمره ألقت مقاليدَ أمرها","وهل لسوى علياه تُلقى المقالد",37,"د",1,0],["اليا متى نبقى على لو وياليت","والحلّ تحت القصف ندرس قراره",38,"ر",2,0],["الْيا متى نبقى على ذالحال في وضع السلام","والمسجد الأقصى من السبعة وستين مْخفور",39,"ر",1,0],["اليا متى وانا اتبعك مثل الانفاس","وليا متى وانتّه تجاهل احساسي",40,"س",2,0],["إلى (أم الحمام) ومن عليها","تصيغ البسمة الجذلى قصيدا",41,"د",2,0],["الى امرئ نصبت قحطان رايتها","بالكف منه ورأس العز منكوس",42,"س",1,1],["إليا مشت بالسوق بالعين تصطاد","حتى المقاضي لاخذتها هديّه",43,"ي",2,0],["إليا متى والعين تشتاق للنوم","وإليا متى والليل يكره اغانيه",44,"ن",3,0],["إليا متى والبُعد, للشعر فاجع","إليا متى والوزن يرجي قوافيك",45,"ك",1,0],["إلى امرىء أن تقولَ إن ذكرت","في الجدِّ لست أذكرها",46,"ر",3,0],["أليا من عليه زعلت قلب،الشقاء يرفض","أمور(ن) تضيق،،خاطره غصب يرفضها",47,"ض",3,0],["أليا من طرتلي لزني هاجسي لز","لز،الخفر لا لز سواق جمسي",48,"س",2,0],["إلى أمة لو عمر الله أمة","بإيمانها كانت بذلك أجدرا",49,"ر",2,0],["إليا منّك بكيتي صرت كلمة تحتها خطين","وصرخة غير مسموعة وجملة غير مفهومة",50,"م",2,0],["اليا مشيت تزفّك النسمة كما عود الارآك","لافيك خلّة حال ولا زود طول ولاقصر",51,"ر",1,0],["اليامتى وانت في بحر الاماني غريق","وتطاوع النفس وتوفّر ملذاتها",52,"ت",3,0],["اليا مشى كنه عن الارض مرفوع","واليا وقف تحتار فيه القلوبي",53,"ب",2,0],["إلى أمِّ المآذنِ تاقَ قلبي","وفيها حلَّ بعد الروحِ جسْمُ",54,"م",1,0],["إلى أمَّهات قَدَدْنَ الثِّيابَ","وَمِنْ حَسْرَةٍ قَلْبها يَشْرَبُ",55,"ب",1,0],["إلى أمة نغتالُ منها طغاتها","ليعمل بناؤوا العقول ويدهشوا",56,"ش",3,0],["إلى امرأة مهما خطبت اقترابها","وحاولت إلا أن ، أخوض عبابها",57,"ب",3,1],["إلى امرأة من صخرة كان قلبها","وكان غباء إذ طلبت اقترابها !",57,"ب",3,0],["إلى امرأةٍ تذيبُ القلبَ شمعًا","تُفيضُ عيونَها ضوءًا مُشِعَّا",58,"ع",2,1],["إلى امرأةٍِ تشُقُّ الأرضَ نورًا","تريقُ العمْرَ في الأجفانِ دمعًا",58,"ع",2,0],["إلى امرأةٍ تقيمُ العرسَ يَأسًا","تصالحُهُ على الأناتِ طوْعَا",58,"ع",2,0],["إلَى امرأةٍ يكادُ النجمُ يخبُو","بهودَجِهَا ليولدَ فيهِ سبعَا",58,"ع",2,0],["إلى أُمِّي إلى أَبَتِي وأَهْلِي","إلى عَهْدٍ يُطارِدُهُ أَنْينِي",59,"ن",2,0],["إلى أمي إلى خفقات قلبٍ","إذا التقت الغريرةُ بالغريرِ!",60,"ر",1,0],["الي امانيهم على ناظري دوم","تكتب وطن والفقر عمْ الديارا",61,"ر",2,0],["اليا مشت شفت التباهي تباها","في مشيها إيقاع ( تك تك )و يزيد",62,"د",1,0],["اليا متى نستقبل ذنوب بأعذار","واليا متى نستنزف جروح بطعون",63,"ن",1,0],["اليا مشت تلتفت ركبان","واليا أوقفت تاقف الديره",64,"ر",2,0],["إِلَى أُمِّ الْعَرَادِ حَمَلْتُ قَلْبِي","لِأَلْثُمَ صَخْرَةً تَرْنُو إِلَيْهَا",65,"ي",3,1],["اليا متى والخد من شانك دشاش","طال البعاد ولا رون المعاطيش",66,"ش",1,0]]}