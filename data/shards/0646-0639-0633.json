{"poems":[[87,"أحق أنهم دفنوا عليا","https://www.aldiwan.net/poem7117.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85310","المجتث"],[203,"نعس النجم ولم أنم","https://www.aldiwan.net/poem45362.html","المديد"],[276,"يا جيرة الحي في ذا الاثل والبان","https://www.aldiwan.net/poem52066.html","البسيط"],[276,"لم يبق في الحي من ربع ولا طلل","https://www.aldiwan.net/poem52078.html","البسيط"],[1901,"","https://poetry.dctabudhabi.ae/diwan/poem/216574","البسيط"],[2443,"","https://poetry.dctabudhabi.ae/diwan/poem/144862","الكامل"],[3017,"","https://poetry.dctabudhabi.ae/diwan/poem/117142","المتقارب"],[3271,"","https://poetry.dctabudhabi.ae/diwan/poem/142240","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91550","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91556","الكامل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29303","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90865","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90867","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90832","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94462","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94370","الكامل"],[4747,"رسالة إلى صدام","https://www.poetsgate.com/ViewPoem.aspx?id=17213",""],[5002,"أهزوجة الليل ،،،","https://www.poetsgate.com/ViewPoem.aspx?id=202975",""],[6147,"لو.","https://www.poetsgate.com/ViewPoem.aspx?id=151497",""],[6198,"الموجةُ الطروبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79239&r=&rc=13",""],[6290,"المُعَلّقَةُ الثّامِنَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85504&r=&rc=22",""]],"verses":[["نَعستُ فما وجدت الغمض حتى","نفضت على المناحة مقلتيا",0,"ي",2,0],["نعستِ بعد الرِضاعِ","وَللنعاس دواعي",1,"ي",1,1],["نعسَ النجمُ ولم أنمْ","فصفوا لي لذةَ الحلمِ",2,"م",1,1],["نعس مكحلة لعس معسلة","فيهن حسن وَما فيهن احسان",3,"ن",1,0],["نعس مكحلة لعس معسلة","يا حَبذا اللعس المَمزوج بالعسل",4,"ل",1,0],["نعسانٌ يُسهرُ عينيهِ لِيرُضيَني","في ذمة الحبّ نَعسانٌ وسهرانُ",5,"ن",1,0],["نَعِسَتْ فأيقظها الغلامُ بقرصةٍ","فأبانَ منها كوكباً يتوقَّدُ",6,"د",1,0],["نعست الشهور لأني سبقت","إليهن سبق جياد عراب",7,"ب",1,0],["نعسةٌ وانتعاشة وهنا الشَيْ","ءُ الذي قيل عنه للناس سِحر",8,"ر",1,0],["نَعساءُ من دلٍّ أَبِيتُ بوجدِها","أَبداً بِليلِ الساهدِ الوَلهان",9,"ن",1,0],["نعساءُ إِلا أَنَّها","في ضَعفها ضعفت قوَى",10,"و",2,0],["نَعِسَت روحي الكَليلَةُ نَشوى","فيهِ تَرعى فَجرَيَ هذا الجَمالِ",11,"ل",1,0],["نعس شكوت لهزم ما بي من ضنا","فرددت منكسراً عديم منام",12,"م",1,0],["نعس مراض لا شفاء لعلتي","منها وهل يشفي السقيم الأسقم",13,"م",1,0],["نعس أشد من القضاء إذا سطت","واحد من غضب المنية مرهفا",14,"ف",2,0],["نعسانة الطرف كم قد أيقظت بدُجىً","شهماً يرى سحراً من حيث لا سحرُ",15,"ر",1,0],["نَعسانة الطرف الغضيض وإنما","كم أيقظت قلب الخليِّ ترنُّما",16,"م",2,0],["نعسف الصعب ثم يجيك مزين دله","اديب ما يشتكي عرقوب جماله",17,"ل",2,0],["نعِستْ عيون الَّليْل تَرقبُها السَّما","ووِشاحُها بسطتُه في الظَّلماءِ",18,"ا",2,1],["نعس الشّتاءُ على الغيوم وقرّه","حتّى استهام النُّورُ ملتذّا معكْ",19,"ك",1,0],["نَعَسَتْ وقد مدَّ النسيمُ.. جناحَهُ","فنفى لذيذَ نُعاسها بِهُبوب",20,"ب",1,0],["نُعَسِّرُ مَيْسُورًا نُبَعِّدُ دَانِيًا","نُذَمِّمُ مَحْمُودًا وَ أَوْلَى لَنَا الذَّمُّ",21,"م",1,0]]}