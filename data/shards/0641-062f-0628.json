{"poems":[[53,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[93,"أبو غازي السلام عليك منا","https://www.aldiwan.net/poem62706.html","عموديه"],[33,"أأنكرت من بعد عرفانكا","https://www.aldiwan.net/poem42028.html","المتقارب"],[54,"أردت الشرب في القمر","https://www.aldiwan.net/poem27001.html","مجزوء الوافر"],[50,"لا تبك للذاهبين في الظعن","https://www.aldiwan.net/poem65299.html","المنسرح"],[15,"معلقة عبيد بن الأبرص","https://www.poetsgate.com/ViewPoem.aspx?id=11410",""],[164,"ولما أراد الله أن الهدى يحيى","https://www.aldiwan.net/poem58884.html","البسيط"],[228,"أتجهل قدر بشر إن بشرا","https://www.aldiwan.net/poem39691.html","الوافر"],[308,"ملكت غلاما جميعي له","https://www.aldiwan.net/poem57616.html","المتقارب"],[422,"دعاك أمير المؤمنين وإنما","https://www.aldiwan.net/poem54129.html","الطويل"],[445,"سلام على مستودع الروح والنفس","https://www.aldiwan.net/poem34839.html","الطويل"],[445,"كذا تتجلى الشمس بعد كسوفها","https://www.aldiwan.net/poem34867.html","الطويل"],[463,"حبست وأيام الملوك كذاكا","https://www.aldiwan.net/poem56082.html","الطويل"],[463,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122746","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48786","المتقارب"],[1192,"","https://poetry.dctabudhabi.ae/diwan/poem/74130","البسيط"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113934","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77932","الطويل"],[1733,"","https://poetry.dctabudhabi.ae/diwan/poem/216310","الوافر"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33851","السريع"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87331","الرجز"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130062","المتقارب"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89301","الوافر"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36750","البسيط"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128946","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135381","الطويل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136412",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5582,"هَلْ لِلنَّوَى ذلِكَ الظَّبْيُ الأَغَنُّ سَرَى","https://www.poetsgate.com/ViewPoem.aspx?id=63509",""],[5701,"وزائرة تدعي أنها","https://www.poetsgate.com/ViewPoem.aspx?id=164646",""]],"verses":[["فدبّر لي عليك عساك تُنقي","ضميرك لي وقد ينقي الغَسُولُ",0,"ل",1,0],["فَدَبَّ إِلَيكَ مِثلَ اللِصِّ لَيلاً","وَكانَ المَوتُ لَيسَ لَهُ ذَمامُ",1,"م",1,0],["فَدَبَّ لَها وَلَكَ الكاشِحونَ","فَحَلّوا حَبائِلَ أَقرانِكا",2,"ك",2,0],["فَدَبَّ الغَيمُ مُعتَمِداً","فَأَخفاهُ عَنِ النَظَرِ",3,"ر",1,0],["فَدَبَّتِ الراحُ في مَفاصِلِهِ","وَرَنَّقَت فيهِ فَترَةُ الوَسَنِ",4,"ن",1,0],["فَدَبَّ مِنْ خَلفِها دَبيبًا","والعَيْنُ حِمْلاقُها مَقْلوبُ",5,"ب",1,0],["فدبر أمر الملك من لم تكن له","سجايا الملوك الغر والهمم العليا",6,"ا",1,0],["فَدَبَّت سورَةُ العَرَبِيِّ فيهِ","وَأَسرَجَ مُهرَهُ حَتّى يَكُرّا",7,"ر",2,0],["فدبى عليه ودأبي له","ودخلي فيه وخرجي منه",8,"ه",1,0],["فدبَّرت منا رقعة ما تدبرت","وكم فرزنت أيديك فينا بيادقا",9,"ق",2,0],["فدبَّ بما لَوْ سامَني الخوفُ ذِكْرَهُ","لَما جالَ فِي وَهْمِي ولا دَبَّ من حِسِّي",10,"س",2,0],["فَدَبَّ إِلَيْهَا فِي عَدِيدِ عُفاتِها","ورَاحَ عَلَيْها فِي سِمَاتِ ضُيُوفِها",11,"ف",3,0],["فدبّوا فسدّوا غابَهُ وهو خادرٌ","فضاق عليه نهضةً وحَراكا",12,"ك",2,0],["فدبّ فيها الخصبُ حتى رجعتْ","سدائساً بُزْلاً وكانت حِقَقا",13,"ق",2,0],["فدبرا أن يظهرا القياما","وينصبا محمدا إماما",14,"م",2,0],["فَدَبَّ لَهُ تَحتَ الثَّرَى مُتَغَضِّضٌ","مِنَ الرُّقشِ مَنقُوشُ الظِّهارَةِ أعرَمُ",15,"م",1,0],["فدبر سلام الحمى وانتظر","عواقبه بعد درء الفتن",16,"ن",1,0],["فدبَّ فيه دَبيبَ النار في فَحمٍ","يَنفى دُجاه بِلَونٍ غير منفى",17,"ا",1,0],["فدَبَّت حُمَيّا الشوقِ في النفسِ واصطَلَت","تباريحُ إلّا تودِ بالنَفسِ تلعَجِ",18,"ج",1,0],["فدبّت حميّا سمه فيّ واِنتهت بما","يَنتَهي ماء العروق إِلى القَضيب",19,"ب",1,0],["فدبج من بسيط الفكر روضاً","أنيقاً مشرق الجنبات نضرا",20,"ر",2,0],["فَدَبَّ فيهِ النُقصُ وَاِختانَهُ","دَهرٌ مَليءٌ بِالخِياناتِ",21,"ت",1,0],["فَدبِّر الفُلكَ على المُرادِ","لِوَفرَةِ الماءِ مَعاً والزَّادِ",22,"د",1,0],["فدبَّ خلافٌ أضاعَ الحِجا","وأقصى الأماني وأعمى المُقَل",23,"ل",1,0],["فدب النمل في جسدي","وطار النحل من عقلي",24,"ل",2,0],["فَدَبَّ نَحوَ الشامِ يَسعى","عَلى اِرتِهاشٍ لَهُ قَشيشُ",25,"ش",1,0],["فدبر الثعلب حالاً حيلة","ينجو بها برأيه السديد",26,"د",1,0],["فدبِّر بتدبير عليَّ ينيلني","مرادي كما أهوى بلا منع من منعْ",27,"ع",1,0],["فدبري الحيلة في وصلتي","فليس للميعاد عندي قرار",28,"ر",1,0],["فدبر ابن أبي سفيان خطته","وقال قم يا أبا الدرداء سر فيها",29,"ي",3,0],["فَدَبَّرَ المَلِكُ الأُسْتاذُ نُهْيَتَهُ","تَدْبِيرِ مَنْ فِي التَّأَتِّي أَرْسَلَ النَّظَرَا",30,"ر",2,0],["فدبجت بعض القوافي لها","لأكشف من أمرها ما احتجب",31,"ب",1,0]]}