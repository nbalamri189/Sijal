//www.poetsgate.com/ViewPoem.aspx?id=208629",""],[5644,"عبق الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=198556",""],[5651,"ألِفارطِ العيشِ الرّطيبِ معيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=107007",""],[5689,"ما بال دمعك ينهمر","https://www.poetsgate.com/ViewPoem.aspx?id=143433",""],[5823,"ليل الشباب سيورق","https://www.poetsgate.com/ViewPoem.aspx?id=61786",""],[5865,"هذا المساء","https://www.poetsgate.com/ViewPoem.aspx?id=179857",""],[5943,"وحي النور","https://www.poetsgate.com/ViewPoem.aspx?id=11153",""],[5956,"فاجعُ المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=182538",""],[5956,"الفطرة البيضاء، والفطرة السوداء","https://www.poetsgate.com/ViewPoem.aspx?id=192038",""],[5956,"راعي المواهب","https://www.poetsgate.com/ViewPoem.aspx?id=193927",""],[5956,"أخلاقه","https://www.poetsgate.com/ViewPoem.aspx?id=194553",""],[5956,"يسري النسيمُ العذب في الصحراءِ","https://www.poetsgate.com/ViewPoem.aspx?id=205124",""],[5956,"أرتين قد بدأ المسير مهللا","https://www.poetsgate.com/ViewPoem.aspx?id=205422",""],[5956,"يا جابراً بمهارة لكسورنا","https://www.poetsgate.com/ViewPoem.aspx?id=210305",""],[6093,"الزمكان","https://www.poetsgate.com/ViewPoem.aspx?id=198343",""],[6127,"خوفُ الهلال","https://www.poetsgate.com/ViewPoem.aspx?id=198260",""],[1583,"جحود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73060&r=&rc=17",""],[5190,"فتجملي بالصبر يا بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85048&r=&rc=123",""],[572,"هذا الصَّباحُ فما الّذي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9283&r=&rc=140",""]],"verses":[["مُتَفَيِّئُ الآراءِ في ظِلَلِ القَنا","تَجري إِلَيهِ مِنَ العَلاءِ مَذانِبُ",0,"ب",1,0],["متْ فما أنتَ حاكمٌ أبد الده","ر على الناس فاقْض ما أنتَ قاض",1,"ض",1,0],["متفرد قال الزمان لفضله","فوفى المقال وصح عقد المجمع",2,"ع",1,0],["مُتَفَلِّقٌ أَنساؤُها عَن قانِيٍ","كَالقُرطِ صاوٍ غُبرُهُ لا يُرضَعُ",3,"ع",1,0],["مُتَفَرنِجين وَما التَفَرنُجُ","عِندَهُم غَيرُ الجُحود",4,"د",1,0],["مُتَفَرِّقُ الطَعمَينِ مُجتَمِعُ القُوى","فَكَأَنَّهُ السَرّاءُ وَالضَرّاءُ",5,"ا",2,0],["مُتَفاوِثُ الحُسنَينِ يَث","قُل رِدفُهُ وَيَخِفُّ قَدُّه",6,"د",2,0],["مُتَفَرِّدٍ في النائِباتِ بِرَأيِهِ","إِن خافَ فَوتَ شَوارِدِ الآثارِ",7,"ر",1,0],["مُتَفَّيئاً ظِلَّ السيو","فِ وتارةً ظِلَّ الفَرادِس",8,"س",1,0],["متفرِّعٌ من دَوْحَةٍ عَدَوِيَّةٍ","هي والسَّماحُ تَفرَّعَا من عُنصُرِ",9,"ر",1,0],["مُتفرِّدٌ من رأيِه بعزَائمٍ","لو أنهنَّ طَلَعْنَ كنَّ فَراقِدا",10,"د",2,0],["متفنّنٌ في الجري يتّبعُ اسمَهُ","منه نعوتٌ بعدهنّ نعوتُ",11,"ت",1,0],["مُتَفَنِّنٌ في الظَرفِ باطِنُ صَدرِها","مُتَفَنِّنٌ في الحُسنِ ظاهِرُ صَدرِها",12,"ر",3,0],["مُتَفَجِّرٌ نادَمتُهُ فَكَأَنَّني","لِلنَجمِ أَو لِلمِرزَمَينِ نَديمُ",13,"م",1,0],["مُتَفَرِّغٌ أَبَداً وَلَيسَ بِفارِغٍ","مَن لا سَبيلَ لَهُ إِلى الأَشغالِ",14,"ل",1,0],["مُتَفَرِّدٌ يُملي الصَوابَ عَلى","آرائِهِ رَبٌّ يُوَفِّقُهُ",15,"ق",2,0],["مُتَفَقّهٌ للدّهرِ إنْ تَسْتَفْتِهِ","نَفسُ امرئٍ عن جُرمه لا يُفْتِها",16,"ت",3,0],["مُتَفَضِّخَاتٍ بِالحَمِيمِ كَأّنَّما","نُضِحَتْ لُبُودُ سُرُوجِهَا بِذِنَابِ",17,"ب",1,0],["متفرِّساتٍ في سكينةِ قانصٍ","لم يخْلُ من حذرٍ وفرط دهاءِ",18,"ا",2,0],["متفرِّقين على البعاد منازلاً","متجمِّعين على هوىً ووئامِ",19,"م",1,0],["مُتَفَكِّكونَ فَما تَضُمُّ نُفوسَهُم","ثِقَةٌ وَلا جَمَعَ القُلوبَ صَفاءُ",20,"ا",2,0],["مُتَفوِّقٌ في المُحْزِيَات، معوِّق","رَكْبَ الحضارة، للفساد مُسَبِّل",21,"ل",1,0],["متفرِّدٌ يربو على أقرانه","باعزِّ سَمتٍ في السماءِ رَفيع",22,"ع",1,0],["متفاهمين فما نبا وجل","لوقوعِ ذنبٍ غير مغتَفَر",23,"ر",1,0],["مُتَفاوِتُ الحُسْنَيْنِ يَثْ","قُلُ رِدْفُهُ، وَيَخِفُّ قَدّهْ",24,"د",2,0],["متفرّجين وما التفرنج","عندهم غير الجحود",25,"د",1,0],["مُتفرد في العالَمين بِهمة","عُلوية آثارَها لَم تَجحد",26,"د",1,0],["متفرق اللحظات في أفنانها","للجمع بين الورد والنسرين",27,"ن",1,0],["متفرّد من صاحب وأخ","حسن الندامة منية القلب",28,"ب",1,0],["مُتفاعلن مُتفاعلن متفاعلُ","كَمُلت صفاتُ علاه فهو الكاملُ",29,"ل",1,0],["متفائل لا البأس يعرف مدخلا","لفؤاده وهو الشجيّ فيدخل",30,"ل",1,0],["متفرِّد في لونه فكأنَّه","ماءٌ زلالٌ فيه خمرٌ قَرقَفُ",31,"ف",1,0],["متفرّع من هاشم في ذِروة","طابت لطيب فروعِها والعنصر",32,"ر",1,0],["متفيئين ظلال كل كَرامة","في ريف رأفة من سما ليسودا",33,"د",2,0],["مُتفَقِّهٍ جَمَعَ الحَدي","ثَ إِلى قِياسِ أَبي حَنيفَه",34,"ف",2,0],["مُتَفِّقونَ عَلى الغِوايَةِ أَجمَعوا","وَلَحوا دَعاةَ الراشِدينَ وَفَنَّدوا",35,"د",3,0],["مُتَفَلسِفٌ مُتَصَوِّفٌ مُتَسَنِّنٌ","مُتَشَيِّعٌ ذو رَغبَةٍ مُتَزِهِّدُ",35,"د",1,0],["مُتفيِّئينَ ظلالَ أَبيضَ ماجدٍ","عن رِفْدِه بالعُذْرِ غَيرِ مُمانع",36,"ع",1,0],["متفكّراً فيما يراه من البلى","من ربه يوم الحساب وعَرضه",37,"ض",2,0],["متفرّداً بالهمِّ مَن ليَ ساعةً","بِرفَاقِ شَعَيا أو عُلالة دَاهِر",38,"ر",1,0],["مُتفرِّدٌ بالمجد واحدُ عصرِه","ما في الرِّجال لمجدِه من ثان",39,"ن",1,0],["متفرّد بالفضل يعرف قدره","من يعرِف الأفراد والآحادا",40,"د",2,0],["متفردٌ في العالمين وواحدٌ","بين الأنام فما له من ثان",41,"ن",1,0],["متفردٌ عنهم بسامي مجدِه","لكنهم في حالِه شُركاؤه",42,"ا",3,0],["متفنّن في النحوِ بين عواملٍ الإ","عرابِ والأسماءِ والأفعالِ",43,"ل",1,0],["مُتَفَجِّرٌ لِعُفَاتِهِ عن شِيمَةٍ","زادَتْ بِهَا الأَيامُ فِي أَرزاقِها",44,"ق",3,0],["مُتَفَرِّدٌ بمناقِبٍ مُتَقاصِرٌ","عن كُنْهِها المنظومُ والمنثورُ",45,"ر",1,0],["مُتَفَرِّجُ الأَبوابِ عن صَحْنٍ ثوى","فِيهِ الصباحُ وشُرِّدَ الإِظلامُ",46,"م",1,0],["متفضِّلاً بقبولِها فلقد أتَتْ","خجلَى ثَنتَها من ثنائكَ راحُها",47,"ح",3,0],["مُتفارطُ التَّسْكابِ كلُّ مُسفَةٍ","منه تُذامِرُ أخْتَها اذْ تُقدِمُ",48,"م",1,0],["مُتَفَرِّدٌ مُذ كانَ بِالأَدَبِ الَّذي","يُهدي إِلى الأَسماعِ مِنهُ فَريدا",49,"د",2,0],["متفقّهٌ بوِصالِه متوقّفٌ","ويرى القطيعةَ من أصولِ الدينِ",50,"ن",1,0],["متفرد دون الأنام بصونه","متكفل دون الأنام بنصره",51,"ر",2,0],["متفاوتُ الطَّعْمينِ أَريٌ في فم ال","عافي وللباغي نقيعُ الحنظلِ",52,"ل",1,0],["مُتَفَتِّقُ الآراءِ في جَمعِ الهَوى","يَخرُجنَ مِن نَجوى ضَميرٍ أَوحَدِ",53,"د",1,0],["مُتَفاوِتٌ في الرَأيِ مُختَلِطٌ بِهِ","في أَمرِهِ التَرغيبُ وَالتَرهيبُ",54,"ب",1,0],["مت في هوى حيْ تحسبْ حيَّهُ حيَّكْ","وانزل بِحَيُّهْ فإنُّهْ قد نزلْ حيَّكْ",55,"ك",1,1],["مُتَفَنِّنْينَ مِنَ التَّذَا","كُرِ والتَّ