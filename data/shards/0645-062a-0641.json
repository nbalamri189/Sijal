{"poems":[[53,"مثواي إما صهوة أو غارب","https://www.aldiwan.net/poem30756.html","الكامل"],[72,"وقل لقاض من صنعه عزلوه","https://www.aldiwan.net/poem19119.html","الخفيف"],[72,"كف الملامة عن حشا المتوجع","https://www.aldiwan.net/poem19166.html","الكامل"],[26,"أمن المنون وريبها تتوجع","https://www.aldiwan.net/poem24106.html","الكامل"],[91,"يا من قربت من الفؤاد","https://www.aldiwan.net/poem8819.html","عموديه"],[43,"أمن ازديارك في الدجى الرقباء","https://www.aldiwan.net/poem9445.html","الكامل"],[45,"نفسي الفداء لمن أوده","https://www.aldiwan.net/poem63470.html","مجزوء الكامل"],[28,"هتمت قريبة يا أخا الأنصار","https://www.aldiwan.net/poem5194.html","الكامل"],[61,"كر الخطوب على الفوارس","https://www.aldiwan.net/poem51598.html","مجزوء الكامل"],[61,"ما ضر ليلتنا بسفح محجر","https://www.aldiwan.net/poem51682.html","الكامل"],[61,"عذر العذول فراح فيك مساعدا","https://www.aldiwan.net/poem51726.html","الكامل"],[80,"الدمع ينطق واللسان صموت","https://www.aldiwan.net/poem31531.html","الكامل"],[44,"عنت له سكن فهام بذكرها","https://www.aldiwan.net/poem30241.html","الكامل"],[44,"أسقى طلولهم أجش هزيم","https://www.aldiwan.net/poem30341.html","الكامل"],[44,"آلت أمور الشرك شر مآل","https://www.aldiwan.net/poem30371.html","الكامل"],[52,"هذا الفراق وكنت أفرقه","https://www.aldiwan.net/poem26805.html","الكامل"],[46,"يا راعي الود الذي أفعاله","https://www.aldiwan.net/poem23629.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39594","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39670","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[106,"تحية وقضية","https://www.poetsgate.com/ViewPoem.aspx?id=179292",""],[90,"يا بدرداجيَة الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179157",""],[90,"الذكرى أو دمعة تثيرها الكمنجة","https://www.poetsgate.com/ViewPoem.aspx?id=179143",""],[45,"نَفْسِي الفِداءُ لِمَنْ أوَدُّهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31621",""],[91,"إلى صديق","https://www.poetsgate.com/ViewPoem.aspx?id=53034",""],[107,"واها لموقفنا ببرقة تهمد","https://www.aldiwan.net/poem16187.html","الكامل"],[148,"صدروا وسحر لحاظهم يغريني","https://www.aldiwan.net/poem68480.html","الكامل"],[184,"وخلية مما خلوت به","https://www.aldiwan.net/poem44123.html","الكامل"],[187,"بمحمد نور المعارف شامل","https://www.aldiwan.net/poem35129.html","الكامل"],[195,"صديان يغلي في حشاه المرجل","https://www.aldiwan.net/poem39876.html","الكامل"],[202,"بيني وبينك يا ظلوم الموقف","https://www.aldiwan.net/poem53234.html","الكامل"],[227,"أنظر لتفويف الرياض وحسنها","https://www.aldiwan.net/poem51040.html","الكامل"],[269,"ألف التذكر مبدئا ومعيدا","https://www.aldiwan.net/poem52063.html","الكامل"],[336,"ركبوا المراكب واغتدوا","https://www.aldiwan.net/poem68729.html","مجزوء الكامل"],[347,"لمغيب قلبي في هواكم مشهد","https://www.aldiwan.net/poem15644.html","الكامل"],[362,"أوجست من جمر بخدك ساطع","https://www.aldiwan.net/poem60852.html","الكامل"],[374,"يا غافلا والإثم حل بأرضه","https://www.aldiwan.net/poem59360.html","الكامل"],[406,"أصبحت بعدك يا شقيق النفس في","https://www.aldiwan.net/poem32271.html","الكامل"],[413,"نزلوا بحيث السفح من نعمان","https://www.aldiwan.net/poem54001.html","الكامل"],[413,"عاد الفؤاد من الجوى ما عادا","https://www.aldiwan.net/poem54072.html","الكامل"],[413,"هنيت بالفرمان والنيشان","https://www.aldiwan.net/poem54081.html","الكامل"],[429,"سائل لوى خبت فذاك لواؤه","https://www.aldiwan.net/poem12550.html","الكامل"],[429,"هي دولة موصولة الإقبال","https://www.aldiwan.net/poem12698.html","الكامل"],[436,"طلعت نجوم السعد من آفاقها","https://www.aldiwan.net/poem34800.html","الكامل"],[436,"سر سار صنع الله حيث تسير","https://www.aldiwan.net/poem34815.html","الكامل"],[436,"اسعد كما سعدت بك الأيام","https://www.aldiwan.net/poem34855.html","الكامل"],[450,"ما للرياض تنمنمت أدواحها","https://www.aldiwan.net/poem13951.html","الكامل"],[459,"أما اذا سلم الامام الأعظم","https://www.aldiwan.net/poem16018.html","الكامل"],[466,"لا زال أحمد في الورى محمودا","https://www.aldiwan.net/poem60201.html","الكامل"],[512,"ما الراح إلا روح كل حزين","https://www.aldiwan.net/poem20791.html","الكامل"],[513,"سفر الزمان بواشح من بشره","https://www.aldiwan.net/poem12098.html","الكامل"],[549,"ما الحب إلا موئل المتعلل","https://www.aldiwan.net/poem47295.html","الكامل"],[551,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[551,"هجر الصبا وأناب وهو طروب","https://www.aldiwan.net/poem68420.html","الكامل"],[556,"مت في هوى حي تحسب حيه حيك","https://www.aldiwan.net/poem34267.html","المواليا"],[565,"هذ الصبوح فما الذي","https://www.aldiwan.net/poem69659.html","مجزوء الكامل"]],"verses":[["مُتَفَيِّئُ الآراءِ في ظِلَلِ القَنا","تَجري إِلَيهِ مِنَ العَلاءِ مَذانِبُ",0,"ب",1,0],["متْ فما أنتَ حاكمٌ أبد الده","ر على الناس فاقْض ما أنتَ قاض",1,"ض",1,0],["متفرد قال الزمان لفضله","فوفى المقال وصح عقد المجمع",2,"ع",1,0],["مُتَفَلِّقٌ أَنساؤُها عَن قانِيٍ","كَالقُرطِ صاوٍ غُبرُهُ لا يُرضَعُ",3,"ع",1,0],["مُتَفَرنِجين وَما التَفَرنُجُ","عِندَهُم غَيرُ الجُحود",4,"د",1,0],["مُتَفَرِّقُ الطَعمَينِ مُجتَمِعُ القُوى","فَكَأَنَّهُ السَرّاءُ وَالضَرّاءُ",5,"ا",2,0],["مُتَفاوِثُ الحُسنَينِ يَث","قُل رِدفُهُ وَيَخِفُّ قَدُّه",6,"د",2,0],["مُتَفَرِّدٍ في النائِباتِ بِرَأيِهِ","إِن خافَ فَوتَ شَوارِدِ الآثارِ",7,"ر",1,0],["مُتَفَّيئاً ظِلَّ السيو","فِ وتارةً ظِلَّ الفَرادِس",8,"س",1,0],["متفرِّعٌ من دَوْحَةٍ عَدَوِيَّةٍ","هي والسَّماحُ تَفرَّعَا من عُنصُرِ",9,"ر",1,0],["مُتفرِّدٌ من رأيِه بعزَائمٍ","لو أنهنَّ طَلَعْنَ كنَّ فَراقِدا",10,"د",2,0],["متفنّنٌ في الجري يتّبعُ اسمَهُ","منه نعوتٌ بعدهنّ نعوتُ",11,"ت",1,0],["مُتَفَنِّنٌ في الظَرفِ باطِنُ صَدرِها","مُتَفَنِّنٌ في الحُسنِ ظاهِرُ صَدرِها",12,"ر",3,0],["مُتَفَجِّرٌ نادَمتُهُ فَكَأَنَّني","لِلنَجمِ أَو لِلمِرزَمَينِ نَديمُ",13,"م",1,0],["مُتَفَرِّغٌ أَبَداً وَلَيسَ بِفارِغٍ","مَن لا سَبيلَ لَهُ إِلى الأَشغالِ",14,"ل",1,0],["مُتَفَرِّدٌ يُملي الصَوابَ عَلى","آرائِهِ رَبٌّ يُوَفِّقُهُ",15,"ق",2,0],["مُتَفَقّهٌ للدّهرِ إنْ تَسْتَفْتِهِ","نَفسُ امرئٍ عن جُرمه لا يُفْتِها",16,"ت",3,0],["متفرِّساتٍ في سكينةِ قانصٍ","لم يخْلُ من حذرٍ وفرط دهاءِ",17,"ا",2,0],["متفرِّقين على البعاد منازلاً","متجمِّعين على هوىً ووئامِ",18,"م",1,0],["مُتَفَكِّكونَ فَما تَضُمُّ نُفوسَهُم","ثِقَةٌ وَلا جَمَعَ القُلوبَ صَفاءُ",19,"ا",2,0],["مُتَفوِّقٌ في المُحْزِيَات، معوِّق","رَكْبَ الحضارة، للفساد مُسَبِّل",20,"ل",1,0],["متفرِّدٌ يربو على أقرانه","باعزِّ سَمتٍ في السماءِ رَفيع",21,"ع",1,0],["متفاهمين فما نبا وجل","لوقوعِ ذنبٍ غير مغتَفَر",22,"ر",1,0],["مُتَفاوِتُ الحُسْنَيْنِ يَثْ","قُلُ رِدْفُهُ، وَيَخِفُّ قَدّهْ",23,"د",2,0],["متفرّجين وما التفرنج","عندهم غير الجحود",24,"د",1,0],["مُتفرد في العالَمين بِهمة","عُلوية آثارَها لَم تَجحد",25,"د",1,0],["متفرق اللحظات في أفنانها","للجمع بين الورد والنسرين",26,"ن",1,0],["متفرّد من صاحب وأخ","حسن الندامة منية القلب",27,"ب",1,0],["مُتفاعلن مُتفاعلن متفاعلُ","كَمُلت صفاتُ علاه فهو الكاملُ",28,"ل",1,0],["متفائل لا البأس يعرف مدخلا","لفؤاده وهو الشجيّ فيدخل",29,"ل",1,0],["متفرِّد في لونه فكأنَّه","ماءٌ زلالٌ فيه خمرٌ قَرقَفُ",30,"ف",1,0],["متفرّع من هاشم في ذِروة","طابت لطيب فروعِها والعنصر",31,"ر",1,0],["متفيئين ظلال كل كَرامة","في ريف رأفة من سما ليسودا",32,"د",2,0],["مُتفَقِّهٍ جَمَعَ الحَدي","ثَ إِلى قِياسِ أَبي حَنيفَه",33,"ف",2,0],["مُتَفِّقونَ عَلى الغِوايَةِ أَجمَعوا","وَلَحوا دَعاةَ الراشِدينَ وَفَنَّدوا",34,"د",3,0],["مُتَفَلسِفٌ مُتَصَوِّفٌ مُتَسَنِّنٌ","مُتَشَيِّعٌ ذو رَغبَةٍ مُتَزِهِّدُ",34,"د",1,0],["مُتفيِّئينَ ظلالَ أَبيضَ ماجدٍ","عن رِفْدِه بالعُذْرِ غَيرِ مُمانع",35,"ع",1,0],["متفكّراً فيما يراه من البلى","من ربه يوم الحساب وعَرضه",36,"ض",2,0],["متفرّداً بالهمِّ مَن ليَ ساعةً","بِرفَاقِ شَعَيا أو عُلالة دَاهِر",37,"ر",1,0],["مُتفرِّدٌ بالمجد واحدُ عصرِه","ما في الرِّجال لمجدِه من ثان",38,"ن",1,0],["متفرّد بالفضل يعرف قدره","من يعرِف الأفراد والآحادا",39,"د",2,0],["متفردٌ في العالمين وواحدٌ","بين الأنام فما له من ثان",40,"ن",1,0],["متفردٌ عنهم بسامي مجدِه","لكنهم في حالِه شُركاؤه",41,"ا",3,0],["متفنّن في النحوِ بين عواملٍ الإ","عرابِ والأسماءِ والأفعالِ",42,"ل",1,0],["مُتَفَجِّرٌ لِعُفَاتِهِ عن شِيمَةٍ","زادَتْ بِهَا الأَيامُ فِي أَرزاقِها",43,"ق",3,0],["مُتَفَرِّدٌ بمناقِبٍ مُتَقاصِرٌ","عن كُنْهِها المنظومُ والمنثورُ",44,"ر",1,0],["مُتَفَرِّجُ الأَبوابِ عن صَحْنٍ ثوى","فِيهِ الصباحُ وشُرِّدَ الإِظلامُ",45,"م",1,0],["متفضِّلاً بقبولِها فلقد أتَتْ","خجلَى ثَنتَها من ثنائكَ راحُها",46,"ح",3,0],["مُتفارطُ التَّسْكابِ كلُّ مُسفَةٍ","منه تُذامِرُ أخْتَها اذْ تُقدِمُ",47,"م",1,0],["مُتَفَرِّدٌ مُذ كانَ بِالأَدَبِ الَّذي","يُهدي إِلى الأَسماعِ مِنهُ فَريدا",48,"د",2,0],["متفقّهٌ بوِصالِه متوقّفٌ","ويرى القطيعةَ من أصولِ الدينِ",49,"ن",1,0],["متفرد دون الأنام بصونه","متكفل دون الأنام بنصره",50,"ر",2,0],["متفاوتُ الطَّعْمينِ أَريٌ في فم ال","عافي وللباغي نقيعُ الحنظلِ",51,"ل",1,0],["مُتَفَتِّقُ الآراءِ في جَمعِ الهَوى","يَخرُجنَ مِن نَجوى ضَميرٍ أَوحَدِ",52,"د",1,0],["مُتَفاوِتٌ في الرَأيِ مُختَلِطٌ بِهِ","في أَمرِهِ التَرغيبُ وَالتَرهيبُ",53,"ب",1,0],["مت في هوى حيْ تحسبْ حيَّهُ حيَّكْ","وانزل بِحَيُّهْ فإنُّهْ قد نزلْ حيَّكْ",54,"ك",1,1],["مُتَفَنِّنْينَ مِنَ التَّذَا","كُرِ والتَّنَاسُمِ فِي زَهَرْ",55,"ر",1,0]]}