يَّ الاعْرَاقِ والعَزَمَاتِ",120,"ت",1,0],["أَرْسَلَ العِلْمُ نورَه فَسَرَى الرَّكْبُ","يقُودُ المُنَى إِلَى الغَايَاتِ",120,"ت",1,0],["أَرْسِلِ الصوْتَ رَنَّةً تَمْلأُ الدنْيَا","وَتَبْقَى عَلَى الزمَانِ خُلُودا",121,"د",2,0],["أرسلتُها ملءَ الأثير كأنما","وحْيُ السماء اختار غُرَّ فصاحهَا",122,"ح",3,0],["أرسى قواعده شعبٌ له خُلُقٌ","ذو صولة تتحدَّى من تَحَدَّاه",123,"ا",2,0],["أَرسلَ الفُلكُ في الفضاء صفيرًا","رنَّ في مسمعي رنينَ الأذان",124,"ن",1,0],["أَرَسْمَ دِيارٍ مِنْ هُنَيْدَة َ تَعْرِفُ","بِأَسْقُفَ مِنْ عِرْفانِه العَيْنُ تَذْرِفُ",125,"ف",1,1],["أرْسَالُ خَيْلٍ، إذا أطَلّ بها","على أقَاصِي ثَغْرٍ دَنَا أمَدُهْ",126,"د",2,0],["أرْسَلْتِ شُغْلَيْنِ مِنْ لَفْظٍ مَحَاسِنُهُ،","تُدوِي الصّحيحَ، وَلَفْظٍ يُسكرُ الصّاحي",127,"ح",2,0],["أرسلوا تزرع الأرض خطا","وتباري كلّ بيت مثل",128,"ل",1,0],["أرسلها صاحب البريد كما","فُوِّضَ بعضُ الهضاب من أُحُدِ",129,"د",1,0],["أرسلوها فتوالى صيب","من جحيم أرسلته فهما",130,"م",2,0],["أرسلتها وبعثتُ الدمعَ يكفنها","كما تحدَّر حولَ السَّوسن البرد",131,"د",1,0]]}