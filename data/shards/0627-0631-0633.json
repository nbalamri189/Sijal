يوما ديمة تهتانا","https://www.aldiwan.net/poem45292.html","الرجز"],[343,"حيه ما حييت يا قلب واهدا","https://www.aldiwan.net/poem55329.html","الخفيف"],[343,"أنشد الشعر وحي الشهداء","https://www.aldiwan.net/poem55389.html","الرمل"],[349,"عزمة صح فألها بالنجاح","https://www.aldiwan.net/poem19950.html","الخفيف"],[349,"أرسل لي إبن الوحيد لما","https://www.aldiwan.net/poem20369.html","مخلع البسيط"],[349,"أرسلت عني النرجس الغض الذي","https://www.aldiwan.net/poem20448.html","الكامل"],[349,"من صفات الكريم ستر الحريم","https://www.aldiwan.net/poem20686.html","الخفيف"],[365,"هل أنت بطولك مسعده","https://www.aldiwan.net/poem60943.html","المتدارك"],[367,"يا فاضلا بهرتنا من فصاحته","https://www.aldiwan.net/poem17924.html","البسيط"],[378,"أفأي عين لا ترف وتدمع","https://www.aldiwan.net/poem59345.html","الكامل"],[401,"وأضأت ليلي","https://www.aldiwan.net/poem6707.html","عموديه"],[401,"أنوار القرآن","https://www.aldiwan.net/poem6712.html","عموديه"],[401,"شموخ الصابري","https://www.aldiwan.net/poem6716.html","عموديه"],[401,"يا ضيف وجداني","https://www.aldiwan.net/poem6759.html","عموديه"],[403,"كم ذا يذوب أسى وكم يتجلد","https://www.aldiwan.net/poem46938.html","الكامل"],[404,"صبابة حلت وفرط وجد","https://www.aldiwan.net/poem33974.html","الرجز"],[404,"مرحبا يا مرحبا يا مرحبا بنسيم","https://www.aldiwan.net/poem34146.html","الرمل"],[417,"لمن الركب وحيفا وذميلا","https://www.aldiwan.net/poem53988.html","الرمل"],[417,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[433,"صاحبت في سفري لك الآمالا","https://www.aldiwan.net/poem12397.html","الكامل"],[433,"متعتب من غير ما سبب","https://www.aldiwan.net/poem12570.html","أحذ الكامل"],[433,"سفحت عيون الغيث أدمع قطره","https://www.aldiwan.net/poem12612.html","الكامل"],[433,"أرسلت لي سطرين قد جمعا","https://www.aldiwan.net/poem12764.html","أحذ الكامل"],[438,"حيا بكاس السرى سا في الأغاريد","https://www.aldiwan.net/poem2596.html","البسيط"],[442,"الحمد الله رب اللوح واللوح","https://www.aldiwan.net/poem14288.html","البسيط"],[459,"أين تريد يا مثير الظعن","https://www.aldiwan.net/poem55836.html","الرجز"],[459,"إن كان فوق الشمس للساعي قدم","https://www.aldiwan.net/poem55866.html","الرجز"],[459,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[459,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[459,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[459,"بلغت صبرا فقالت ما الخبر","https://www.aldiwan.net/poem56203.html","الرمل"],[462,"تجري السوابق للغايات محرزة","https://www.aldiwan.net/poem16101.html","البسيط"],[462,"رفقا بها يا أيها الزاجر","https://www.aldiwan.net/poem16434.html","السريع"],[465,"ظبيات الحمى تخيف الأسودا","https://www.aldiwan.net/poem3169.html","عموديه"],[465,"قوامك اللدن لا ما يزعم الغصن","https://www.aldiwan.net/poem3196.html","عموديه"],[465,"جد بقلبي وهزل","https://www.aldiwan.net/poem3313.html","عموديه"],[465,"عاد مني الخيال طيف الخيال","https://www.aldiwan.net/poem3497.html","عموديه"],[465,"لولا هواك وجل خطب هواك","https://www.aldiwan.net/poem3580.html","عموديه"],[469,"يا من يظاهرني بالنصح في العذل","https://www.aldiwan.net/poem59778.html","البسيط"],[471,"أرسلت أم جعفر لا تزرنا","https://www.aldiwan.net/poem4844.html","الخفيف"],[478,"أرسم الهوى العذري دمعك في الرسم","https://www.aldiwan.net/poem15271.html","الطويل"],[480,"أسفي على هذا الزمان وأهله","https://www.aldiwan.net/poem37188.html","الكامل"],[480,"أبكي لفرقتهم وهم أحياء","https://www.aldiwan.net/poem37605.html","الكامل"],[487,"أرسم ديار بالستارين تعرفُ","https://www.aldiwan.net/poem482.html",""],[496,"لما بعثت بلحظي في خد جلنار نارا","https://www.aldiwan.net/poem9858.html","مجزوء الخفيف"],[507,"قل للزنادق عني","https://www.aldiwan.net/poem2394.html","المجتث"],[539,"أرسم حبيبي زدت قلبي تشوقا","https://www.aldiwan.net/poem47547.html","عموديه"],[541,"أرسم سودة محل دارس الطلل","https://www.aldiwan.net/poem56707.html","البسيط"],[552,"أرسلها ترعى ألاء ونفل","https://www.aldiwan.net/poem47254.html","الرجز"],[552,"يا خير باد في الأنام وحاضر","https://www.aldiwan.net/poem47789.html","الكامل"],[559,"ربي الذي ليس له ماهيه","https://www.aldiwan.net/poem33561.html","الرجز"],[559,"نحن من المنسوبين","https://www.aldiwan.net/poem33814.html","مجزوء الرجز"],[559,"كان فرعون قاصدا تحقيقه","https://www.aldiwan.net/poem34290.html","الخفيف"],[559,"أقسمت عليك أيها المحبوب","https://www.aldiwan.net/poem34970.html","الدوبيت"],[576,"أدنو إليك فأقصى","https://www.aldiwan.net/poem2923.html","المجتث"]],"verses":[["أُرسِلُها هَزلاً وَأَرمي بِها","ما بَلَغَ الجِدُّ مِنَ الهازِلِ",0,"ل",1,0],["أَرسى النَسيمُ بِواديكُم وَلابَرِحَت","حَوامِلُ المُزنِ في أَجداثِكُم تَضَعُ",1,"ع",1,0],["أَرسَلَها خَمصاءَ في خِماصِ","زَوراءَ مِن رَعيِ الجَميمِ الواصي",2,"ص",2,0],["أَرسَلَت بِاللُبانِ قَد مَضَغَتهُ","فَوقَ تُفّاحَةٍ عَلى رَيحانِ",3,"ن",1,0],["إِرسالُها فيكَ إِلَينا لَنا","كَرامَةٌ فَوقَ الكَراماتِ",4,"ت",1,0],["أرْسَلْتُ منْها علَى الأعْداءِ داهِيَةً","دَهْياءَ ما وجَدَتْ في دفْعِها قِبَلا",5,"ل",2,0],["أَرْسَلْتُ عَيْنِي فِي حُلاَكَ بِنَظْرَةٍ","هِيَ كَانِتِ السَّبَبَ الْقَرِيبَ لِمَا بِي",6,"ي",1,1],["أَرسِل حَكيماً وَاِستَشِر لَبيبا","إِذا أَتَيتَ الوَطَنَ الحَبيبا",7,"ب",2,0],["أَرْسَى بِهَا الدُّسْتُورَ وَاسْتِقْلالُهَا","بَلَغَ التَّمَامَ مَوَطَّدِ البُنْيَانِ",8,"ن",1,0],["أرسلتها حيثما الأرواح مرسلةٌ","نوادراً تنشر البشرى أمانيها",9,"ي",3,0],["أرسلت سرعان الجياد كأنها","أسرابُ طيرٍ في التنوفة حُوَّمِ",10,"م",1,0],["أرستْ بجودي الجود في يوم الندى","وجرت بيوم الحرب في تيارِ",11,"ر",1,0],["أرسيته جبلاً قامت ذراه على","أصل مع الموج تحت الماء معتنق",12,"ق",1,0],["أرسلت منه أنيناً فات أوله","سمعي وآخره بالقلب مرتبط",13,"ط",1,0],["أَرَسمَ الحَيِّ إِذ نَزَلوا الإِيادا","تَجُرُّ الرامِساتُ بِهِ فَبادا",14,"د",2,1],["أَرَسماً جَديداً مِن نَوارَ تَعَرُّفُ","تُسائِلُهُ إِذ لَيسَ بِالدارِ مَوقِفُ",15,"ف",1,1],["أرسلتُ نجلي واثقاً بمكارمٍ","أورثتها عن سادةٍ أنجاب",16,"ب",1,1],["أرسلت تمراً بل نوى فقبلته","بيدِ الودَادِ فما عليك عتاب",17,"ب",1,0],["أرسلت نضوا حقيراً","ولو قدرت لزدته",18,"ه",1,1],["أرسله مع تاجر الكتب الفلاني وقل","هذا أخي حين أدعوه وذا ولدي",19,"ي",1,0],["أرسلته نعم الجلي","س إذا تغيَّرت البشر",20,"ر",1,1],["أرسلت بعدكم بجهدٍ نحوكم","جبناً فيا خجلي ويا جهلي",21,"ي",1,1],["أَرسَلتَ تَسأَلُ عَنّي كَيفَ كُنتُ وَما","لَقيتُ بَعدكَ مِن هَمٍّ وَمِن حَزَنِ",22,"ن",1,1],["أرسلها صاحب البريد كما","قُوِّضَ بعضُ الهضاب من أُحُدِ",23,"د",1,0],["أرسى عليها قتود الرحل أن خُلِقت","أخفَّ ما دب فوق الأرض إخفافا",24,"ف",2,0],["أرسلني عاشِقٌ بحاجتِهِ","فجئت بين الرجاء والوَجَلِ",25,"ل",1,1],["أرسلوا نحوه السهامَ جواباً","لرسالاتِه وللإرسالِ",26,"ل",1,0],["أَرسَلتُ طَرفي رائِداً فَجَرى","وَجَرى عَلى آثارِهِ فِكري",27,"ر",2,0],["أَرسَلَت نَحوَ الدَراري لَفتَةً","أَذكَرَت تِلكَ الدَراري القَمَرا",28,"ر",2,0],["أَرسَلوها تَزرَعُ الأَرضَ خَطا","وَتُباري كُلَّ بَيتٍ مِثلِ",29,"ل",1,0],["أَرسَلتُ قَولِيَ تَمثيلاً وَتَشبيهاً","لَعَلَّ في القَولِ تَذكيراً وَتَنبيها",30,"ي",3,0],["أَرسَلَت لي تُفّاحَةً نَقَشَتها","مِن فُؤادٍ بِحُبِّها مُستَهامِ",31,"م",1,1],["أَرسَلتُهُ في حاجَةٍ","كَالماءِ هَيِّنَةِ المَساغِ",32,"غ",1,1],["أَرسَلتَهُ شِعراً إِلَيَّ","وَلَو عَلِمتُ لَقُلتُ سِحرا",33,"ر",2,0],["أَرسَلتُ دَمعي خَلفَهُ","فَعَساهُ يَرجَعُ مِن قَريبِ",34,"ب",1,0],["ارسلن شعراً من","اشعة على المناكب",35,"ب",1,0],["ارسلت نوراً بهياً في اشعته","نرى الجمال افانيناً افانينا",36,"ن",2,0],["ارسل الطرف في الجماهير تبصر","ماله في الوجوه من آثار",37,"ر",1,0],["ارسل الطرف للسما","ء وانعم بها النظر",38,"ر",1,0],["ارسل الى اجوائها","نظراً تر النقع المثارا",39,"ر",2,0],["أرسلت رأسك يهوى","من ربوة لقراره",40,"ر",2,0],["أَرسَلتَ بِالتَوراةِ موسى مُرشِداً","وَاِبنَ البَتولِ فَعَلِّمِ الإِنجيلا",41,"ل",2,0],["أَرسَلتُها وَبَعَثتُ الدَمعَ يَكنُفُها","كَما تَحَدَّرَ حَولَ السَوسَنِ البَرَدُ",42,"د",1,0],["أَرسَيتَها وَمَلَكتَ مَذهَبَها","بِدُجُنَّةٍ كَسَريرَةِ الدَهرِ",43,"ر",1,0],["أَرسَلَتهُ الأَرضُ عَنها خَبَراً","طَنَّ في آذانِ سُكّانِ السَماء",44,"ا",2,0],["أَرسى عَلى بابِ الإِمامِ كَأَنَّهُ","لِلفُلكِ مِن فَرطِ الجَلالِ إِمامُ",45,"م",1,0],["أَرسَلتَها مَملوءَةً كَرَماً","فَرَدَدتُها مَملوءَةً حَمَدا",46,"د",2,0],["أَرسَلتَ تَسأَلُني المَديحَ سَفاهَةً","صَفراءُ أَضيَقُ مِنكَ ماذا أَزعُمُ",47,"م",1,0],["أرسلتُ صبري على وجدي ليُزعِجَهُ","عن الحَشا فأقاما فيه واحترَبَا",48,"ب",2,0],["أَرُسومُ دارٍ أَم سُطورُ كِتابِ","دَرَسَت بَشاشَتِها مَعَ الأَحقابِ",49,"ب",1,1],["أَرسَلتِ شُغلَينِ مِن لَفظٍ مَحاسِنَهُ","تُدوي الصَحيحَ وَلَحظٍ يُسكِرُ الصاحي",50,"ح",2,0],["أَرسالُ خَيلٍ إِذا أَطَلَّ بِها","عَلى أَقاصي دَهرٍ دَنا أَمَدُه",51,"د",2,0],["أَرسى قَواعِدَهُ مَعنُ بنُ زائِدَةٍ","في باذِخٍ مِن شَواةِ النَجمِ مُحتَلَلِ",52,"ل",1,0],["أَرسَلتَهُ مِلءَ العُيونِ مُسَلَّماً","مِنها بِشَهوَتِها لِطولِ دَوامِهِ",53,"م",2,0],["أَرسَلتَ مِن عارِضِ الآجالِ فَوقَهُمُ","طَيراً أَبابيلَ لَم تُنسَب إِلى الرَخَمِ",54,"م",1,0],["أرسَوا قِبَابَهمُ في البرِّ واتَّخذوا","سُوراً عليه من الأرماحِ مَضروبا",55,"ب",2,0],["أَرسَلَت في الكُؤوسِ بِالمُعجِزاتِ","فَأَرَتنا الآياتِ وَالبَيَّناتِ",56,"ت",1,1],["أَرسَلتَ فيها لِلرِماحِ أَراقِماً","لَسَبَت قُلوبَ حُماتِها بِحُماتِها",57,"ت",3,0],["أرسلت شعرك في المدائن هادياً","شبهَ المنار يطوف بالأقطارِ",58,"ر",1,0],["أرسلتُ طَرْفي يقتضي طرفَها","وَعْداً به أُبرئُ أسقامي",59,"م",2,1],["أرساغُهُ دُرَرٌ على فيروزجٍ","لان الصفا من وقعهِ لصليبِ",60,"ب",1,0],["أرَسَلَت نَحوَهُ المَنِيَّةُ عَيناً","قَطَعَت مِنهُ أَوثَقَ الأَسبابِ",61,"ب",1,0],["أَرسى بِناديكَ النَدى وَتَنَفَّسَت","نَفَساً بِعَقوَتِكَ الرِياحُ ضَعيفا",62,"ف",2,0],["أَرْسَلْتُ طَرْفِي رَائِداً","فَمَا عَلا حَتَّى هَوَى",63,"و",2,0],["أَرسَلَت إِذ رَأَت بِعادِيَ أَن لا","يَقبَلَن بي مُحَرِّشاً إِن أَتاهُ",64,"ا",2,0],["أَرسَلَت أَنَّنا نَخافُ شَناتٍ","آفِكاتٍ مِن حَولِنا وَعُيونا",65,"ن",2,0],["أَرسَلتَ أَكذَبَ مَن مَشى وَأَنَمَّهُ","مَن لَيسَ يَكتُمُ سِرَّنا أَعدانا",66,"ن",2,0],["أَرسَلَت نَحوِيَ الرَسولَ لِأَلقا","ها فَأَرسَلتُ عِندَ ذاكَ بِأَن لا",67,"ل",2,0],["أَرسَلتُ لَمّا عيلَ صَبري إِلى","أَسماءَ وَالصَبُّ بِأَن يُرسِلا",68,"ل",2,1],["أَرسَلَت هِندٌ إِلَينا رَسولاً","عاتِباً أَن ما لَنا لا نَراكا",69,"ك",2,1],["أَرسَلَت أَسماءُ إِنّا","قَد تَبَدَّلنا سِواكا",70,"ك",2,1],["أَرسَلَت سِرّاً إِلَينا","وَثَنَت رَجعاً خَفيضا",71,"ض",2,0],["أَرسَلَت هِندٌ إِلَينا ناصِحاً","بَينَنا إيتِ حَبيباً قَد حَضَر",72,"ر",1,0],["أَرسَلَت تَعتِبُ الرَبابُ وَقالَت","قَد أَتانا ما قُلتَ في الإِنشادِ",73,"د",1,1],["أَرسَلَت خُلَّتي إِلَيَّ بِأَنّا","قَد أُتينا بِبَعضِ ما قَد كَتَمتا",74,"ت",2,1],["أَرسِلي نَحوَهُ الوَليدَةَ تَسعى","قَد فَعَلنا رِضا أَبي الخَطّابِ",75,"ب",1,0],["أَرسَلَت أَسماءُ في مَعتَبَةٍ","عَتَبَتها وَهيَ أَهوى مَن عَتَب",76,"ب",1,0],["أَرسى بِهِ في اللَهِ طَودُ سَكينَةٍ","وَعَدالَةٍ وَاِمتَدَّ حَبلُ رَجاءِ",77,"ا",2,0],["أُرسِلتُ بالإسلام ديناً قيّماً","وبُعِثْتُ خيراً للشُّعوبِ عميما",78,"م",2,0],["أرسلوها فَتَوالى صَيِّبٌ","من جَحيمٍ أرسلته فَهَمى",79,"م",2,0],["أرسلتَهُ سهماً تَضجُّ لِهَوْلِهِ","أُمَمُ الكتابِ وتَفزعُ الأحقابُ",80,"ب",1,0],["أرسلَتْها دَعوةً واحدةً","ليتها زادتْ على حَدِّ المِئينْ",81,"ن",1,0],["أرسى المعاقلِ مؤمنٌ لا نفسُه","تهفو ولا إيمانُه يتزلزلُ",82,"ل",1,0],["أرسلَ اللَّحظَ للقِتالِ نَذِيرَا","لَيتَهُ بالوِصَالِ جَاءَ نَذِيرَا",83,"ر",2,1],["أَرسَلَ بِالفَجرِ إِلى المَشرِقِ","فَاِرتَفَعَت رايَتُهُ المُذهَبَه",84,"ه",1,0],["أرسلي اللحنَ شجيّاً","كالصَّبا في الغَلَسِ",85,"س",1,0],["أرسَلْتَ عنْ بردَى سلا","مك في لظى الحرب العوانِ",86,"ن",1,0],["أرسومٌ وكن قبل صروحاً","كلُّ صرحٍ عاتٍ على الدهر عال",87,"ل",1,0],["أَرسَلَ اللَهُ عِندَ ذاكَ عَذاباً","جَعَلَ الأَرضَ سِفلُها أَعلاها",88,"ا",1,0],["أَرسَلتُ أُسداً عَلى سودِ الكِلابِ فَقَد","أَضحى شَريدُهُم في الأَرضِ فُلاّلا",89,"ل",2,0],["أَرسَلَ الذَرَّ وَالجَرادُ عَلَيهِم","وَسِنيناً فَأَهلَكَتهُم وَمورا",90,"ر",2,0],["أَرسَلَت سَلمى بِأَنّي","قَد تَبَدَّلتُ سِواكا",91,"ك",2,1],["أَرَسمَ دِيارٍ مِن حُنَيدَةَ تَعرِفُ","بِأَسقُفَ مِن عِرفانِها العينُ تَذرِفُ",92,"ف",1,1],["أُرسِلتَ منه لِلخَلائِقِ رَحْمَةً","عَمَّتْ قِياماً منهمُ وجُلوسا",93,"س",2,0],["أرسلتَ عُجماً ما تبين","فتشيعت فيها الظنون",94,"ن",1,1],["أَرسَلَ مَن أَهوى رَسولاً لَهُ","إِلَيَّ وَالمَنسوبُ مَحبوبُ",95,"ب",1,1],["أَرسَلنَ في لُطفٍ إِلَيَّ أَنِ اِئتِنا","غابَ الرَقيبُ وَما تَخافُ وَعيدا",96,"د",2,0],["أَرسَلَت خُلَّتي مِنَ الدَمع