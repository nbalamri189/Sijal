{"poems":[[55,"كأنك لم تقد بعويرضات","https://www.aldiwan.net/poem30163.html","الوافر"],[79,"وقوراء من قوس الغمام ابتغوا لها","https://www.aldiwan.net/poem36379.html","الطويل"],[88,"لا مرحباً بك أيهذا العام","https://www.aldiwan.net/poem10482.html","الكامل"],[82,"رعى ورق البيض الذي زهره دم","https://www.aldiwan.net/poem31308.html","الطويل"],[33,"خليلي اربعا وسلا","https://www.aldiwan.net/poem41833.html","مجزوء الوافر"],[107,"أبا الفضل أقبل وارفع الصوت شاكرا","https://www.aldiwan.net/poem44043.html","الطويل"],[104,"سل جنة الشعر ما ألوى بدوحتها","https://www.aldiwan.net/poem32925.html","البسيط"],[50,"يا قلب يا خائن الحبيب","https://www.aldiwan.net/poem10820.html","مجزوء البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39616","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39596","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39561","السريع"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[98,"عام جديد","https://www.poetsgate.com/ViewPoem.aspx?id=17900",""],[119,"متى يا سعد تسعدنا الليالي","https://www.aldiwan.net/poem40630.html","عموديه"],[158,"قيود الأحرار","https://www.aldiwan.net/poem932.html",""],[173,"رويداً بعض نوحك يا حمام","https://www.aldiwan.net/poem1677.html",""],[226,"أتنآى ورجلاك فوق الثرى","https://www.aldiwan.net/poem55300.html","المتقارب"],[310,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[406,"مواكب خير ، موكب إثرموكب","https://www.aldiwan.net/poem4595.html","عموديه"],[438,"هو النادي وأنت به أنادي","https://www.aldiwan.net/poem12423.html","الوافر"],[1042,"","https://poetry.dctabudhabi.ae/diwan/poem/204375","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96721","الوافر"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72311","المنسرح"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79496","الكامل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122074","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101046","الكامل"],[1936,"","https://poetry.dctabudhabi.ae/diwan/poem/105198","الطويل"],[2371,"","https://poetry.dctabudhabi.ae/diwan/poem/142612","الوافر"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83210","الوافر"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132733","الطويل"],[3181,"","https://poetry.dctabudhabi.ae/diwan/poem/105090","الطويل"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71308","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91379","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81299","الكامل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81934","المتقارب"],[4691,"وشم بخاصرة الضنى","https://www.poetsgate.com/ViewPoem.aspx?id=61390",""],[4691,"مُؤنثَة ٌ أحْلامُهُ ومُذَكّرَة ْ","https://www.poetsgate.com/ViewPoem.aspx?id=125543",""],[4764,"تحسس شوفني يمكن","https://www.poetsgate.com/ViewPoem.aspx?id=28974",""],[4767,"تحية القمر","https://www.poetsgate.com/ViewPoem.aspx?id=178565",""],[4782,"إياب","https://www.poetsgate.com/ViewPoem.aspx?id=214685",""],[4830,"أتلو جمالَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=206865",""],[4927,"فدوى","https://www.poetsgate.com/ViewPoem.aspx?id=30183",""],[4929,"سيأتي الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=200127",""],[4984,"فيا سائلا لا تلمني *","https://www.poetsgate.com/ViewPoem.aspx?id=175582",""],[5060,"تسبيح النارنج","https://www.poetsgate.com/ViewPoem.aspx?id=214495",""],[585,"يا شيب إن أوان الشيب لم يحن","https://www.poetsgate.com/ViewPoem.aspx?id=161874",""],[5081,"إِغْرَاءٌ","https://www.poetsgate.com/ViewPoem.aspx?id=190416",""],[5121,"سَلام","https://www.poetsgate.com/ViewPoem.aspx?id=215998",""],[5277,"قوارير بغدادية","https://www.poetsgate.com/ViewPoem.aspx?id=193638",""],[5295,"أمير الروح","https://www.poetsgate.com/ViewPoem.aspx?id=210573",""],[5338,"غالى ولم يبلغ قصيدي","https://www.poetsgate.com/ViewPoem.aspx?id=187759",""],[5387,"مطاردة","https://www.poetsgate.com/ViewPoem.aspx?id=53768",""],[5431,"بكف الله ممزوجا بلوني....","https://www.poetsgate.com/ViewPoem.aspx?id=200700",""],[5493,"تراب الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=205057",""],[5587,"سيد الثقلين","https://www.poetsgate.com/ViewPoem.aspx?id=193801",""],[5638,"أمي (أنشودة للأطفال)","https://www.poetsgate.com/ViewPoem.aspx?id=199069",""],[5725,"ولما تلافينا","https://www.poetsgate.com/ViewPoem.aspx?id=207233",""],[5897,"أول الميزان","https://www.poetsgate.com/ViewPoem.aspx?id=157277",""],[5956,"ذكرياتُ مشاهدَ من حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=184838",""],[5974,"هَلَّا عُدْت","https://www.poetsgate.com/ViewPoem.aspx?id=200420",""],[5977,"لها في خافقي ركن شديد","https://www.poetsgate.com/ViewPoem.aspx?id=213902",""],[6043,"مرثيّة الأرض العالقة","https://www.poetsgate.com/ViewPoem.aspx?id=215591",""],[6093,"ربابٌ ( الوافر)","https://www.poetsgate.com/ViewPoem.aspx?id=176208",""],[6093,"عَقِيْقَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=204951",""],[6131,"قوسُ عينيكِ","https://www.poetsgate.com/ViewPoem.aspx?id=189336",""],[6180,"عشرون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81083&r=&rc=17",""],[6288,"الحاضر ... ليس النهاية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76849&r=&rc=12",""],[5126,"متى أعيش؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87816&r=&rc=31",""]],"verses":[["وَتُرسِلُها العَرَضنَةَ صادِياتٍ","مُبادَرَةً إِلى الماءِ الغُطاطا",0,"ط",2,0],["وَتُرْسِلُ مِنْ شُهْبَانِهَا ذَا ذُؤابَةٍ","فَتَبْغِي اسْتِرَاقَ السَّمْعِ عَنْ حَوْزَةِ الْمُلْكِ",1,"ك",1,0],["وَتَرَسَّمَ المُتَعَلِّمونَ خُطاهُما","فَاِنشَقَّ مِن عَلَمَيهِما أَعلامُ",2,"م",1,0],["وترسلُ نِفْطاً يركبُ الماءَ مُحْرِقاً","كمُهْلٍ به تَشْوي الوجوهَ جَهَنَّمُ",3,"م",1,0],["وَتُرسِلُ في مُلاطَفَةٍ","وَنُعمِلُ نَحوَها الرُسُلا",4,"ل",2,0],["وتُرْسِلُهُ حُرّاً طليقاً وإنّه","لفي عِزَّةٍ تُعيي النفوسَ الحرائرا",5,"ر",2,0],["وَتُرسل الزَفرة الحَرّى مصدّعة","ضُلوع كُل عَميد القَلب مَكروبِ",6,"ب",1,0],["وَتُرسِلُ العَينُ ماقِيَيها","بِالفَيضِ مِن مائِها السَكوبِ",7,"ب",1,0],["وترْسُمُ أسماءَ ما عُلِّمَتْ","من القلم المبدع القادرِ",8,"ر",1,0],["وترسَّلْ يا قصيدي نَغَماً","وتنقَّلْ بين مَوْجٍ وغمامِ",9,"م",1,0],["وترسمُ لي الأشباحُ طيفَ خيالهِ","فأدنو لضمٍّ أو للثمِ شفاهِ",10,"ه",1,0],["وتُرسلُ الأغنيةَ الشائقه","قمريةً ظلَّتْ على حبّهِ",11,"ه",1,0],["وترسَّموا سَنَنَ الرئيسِ وهدْيَه","شيخِ الأساةِ عليّ الْجراحِ",12,"ح",1,0],["وترسّل يا صديقي نغما","وتنقّل بين أمواج وغمام",13,"م",1,0],["وترسل في الربى نظرا حديداً","لتبصر فيه سارحة الغزال",14,"ل",1,0],["وترسل سهم كيدك نحو قلبي","فيشربُ من وريد القلب رِيا",15,"ي",2,0],["وَتُرسِلُ مِن لَواحِظِها سِهاماً","فَتَمضي حَيثُ لا تَمضي السِهامُ",16,"م",1,0],["وترسل تيار هذا الغرام","خلال الجوارح منا يجوس",17,"س",1,0],["وَتُرسلُ فرعاً ينفضُ الليلُ صبغهُ","عَلَيه ويَأبى من ترسّلهِ المشطا",18,"ط",2,0],["وترسمُ عينُ الشمسِ منها شعاعها","فيهربُ من أضوائها كلُّ غيهبِ",19,"ب",1,0],["وترسيل يراه الروض زهراً","ينثّره براحات الوهادِ",20,"د",1,0],["وترسل الدمع أجفاني محاكية","لفيض وبل من الوسمي منسجم",21,"م",1,0],["وَترسمُ بالمجلجلَ أرسما","فيها البِلى رسما",22,"م",2,0],["وترسه ظاهر لوقع قنا","لكنها ليس بالقنا الذبل",23,"ل",1,0],["وترسُّل الصابي يزينُ علوَّه","خطُّ ابنِ مقلةَ ذي المحلِّ الأرفعِ",24,"ع",1,0],["وَتُرْسِلُ شِعْراً مِنْ عَجَاجٍ خُيُولُهُ","تُرَجِّلُهُ أَيْدِي نُسُورٍ وَعُقْبَانِ",25,"ن",1,0],["وترسموا أثارها في حكمةٍ","كتبت لكم صحفاً على الآطام",26,"م",1,0],["وترسل في آل النبي مدائحاً","تجير لدى الإنشاء من يستجيرها",27,"ر",3,0],["وترسخ في مخايلنا وتحيا","صقور وقائع وليوث غاب",28,"ب",1,0],["وَتُرسِلُ لِلمَلا صَوتاً شَجِيّاً","تُرَدِّدُهُ الفَواخِتُ مُسعِداتِ",29,"ت",1,0],["وترسل في الأرداف وارد شعرها","فينساب في حقف من الرمل ارقما",30,"م",2,0],["وترسم شهب النجم فوق سطوحها","سطوراً فتبدي من لئالئها سمطا",31,"ط",2,0],["وَتُرْسِلُ الدَّمْعَ عَيْني فِي مَنَازِلِهِمْ","كَيْلاَ تُسَابِقَهَا فِي سَحِّهَا السُّحُبُ",32,"ب",1,0],["وَترسلُ بيضَ الهندِ مِن سُودِ أَعينٍ","وَتُظهرُ إمّا ملتَ لَدْنا مثقَّفا",33,"ف",2,0],["وترسل طرفاً بليلاً إليها","عساه بذلتها يشفع",34,"ع",1,0],["وَتَرسموا آثار مُدرجة الهُدى","وَالعلم في أَدَب وَفي أَضرابه",35,"ب",2,0],["وترسل من طرفها صارماً","كما يرسل الصارم المخذم",36,"م",1,0],["وترسمني وشما بخاصرة الضنى","فلله ما أقساك كم منك َ أعجبُ",37,"ب",1,0],["وترسم في وجه الليالي نجمة","وتُعشب ُ قلبي بابتسامٍ وثرثرة",38,"ر",2,0],["وترسل كلها يمك ،، عسى بس فيضها جابك","وحسيت انها حلمك / ولا شيٍ يوازيها",39,"ي",3,0],["وترسِمُ مِن تعاونها","تُحفِّزُ غيرَها صورا",40,"ر",2,0],["وترسو في ضفاف الحب روحٌ","مروّضة على السفر الطويلِ",41,"ل",1,1],["وترسمُ بسمَةَ الشّفتينِ سِحراً","فترمي من مفاتِنِها حِبالَكْ",42,"ك",1,0],["وَتَرْسُمُ حُبَّهُمْ حَسْبَ الأَمَاْنِيْ","وَلاْ يُُعْطَىْ إِذَاْ سُئِلَتْ جَوَاْبُ",43,"ب",1,0],["وترسمُ للغدِ مستقبلا","فخِيما سنا شمسه لن يغيبا",44,"ب",2,0],["وترسل من عينها ومضات","كبرق تلألأ بين السحاب",45,"ب",1,0],["وترسمُ الحلمَ ظلاً يُستجارُ به","لا تتركِ الظلَّ.. ! إنَّ الظلَّ مسفوحُ",46,"ح",1,0],["وترسل اللحظة البلهاء مدنفةً","وأنت في يقظة أدنى إلى الوسن",47,"ن",1,0],["وَتُرْسِلُنِي لِبَحْرٍ كَيْفَ أَنْجُو","وَلَا فُلْكٌ هُنَاكَ وَلَا فَنَارُ ؟!",48,"ر",1,0],["وَتَرْسِمُ تَرْسِمُ لَوْحَاتِ فَنٍّ","بِأَلْوَانِ حُبٍّ وَنَبْضِ دِمَاءِ",49,"ا",2,0],["وترسلُ الآهَ تلوَ الآهِ في وطنٍ","تبكي تغرّبّها الشاكي بمنفاهُ",50,"ا",2,0],["وترسمني القصائدُ سيلَ شوقٍ","لغيركَ ما جرى حتى بقطرَةْ",51,"ر",2,0],["وَتَرَسَّمَتْ فِيكَ الْحَيَا-","-ةَ وطلعةَ الأملِ الرّغيد",52,"د",1,0],["وترسل ألف جاسوس ورائي","وتسلبني هدوئي المطمئن",53,"ن",1,0],["وتُرسلُ للسماء صلاة عشقٍ","لتحفظَ كالنجوم علوّ شأني!",54,"ن",2,0],["وترسلُ في المدَى عطرًا شَفيفًا","يسابقُه إلى الأحْلامِ حَرفُ",55,"ف",1,0],["وَ تَرْسُمُ بِالإِنْصَافِ شَمْسًا جَمِيلَةً","تُصَلِي إِلَى المَعْبُودِ شَوْقًا وَتُنْفَجُ",56,"ج",1,0],["وَتُرْسِلُ شَوْقَهَا يَسْرِي","أَلَا لَبَّيْكَ يَا عُمْرِي",57,"ي",1,0],["وترسل بالاحداق صمت عتابها","فتوجعني همساً وما أنطقتْ فما",58,"م",2,0],["وترسّم الغُرُّ الكرام طريقه","ومضوا بعين بصيرة ورشاد",59,"د",1,0],["وترسو الطيور على أوج رأسي","ترى نَهْرَ عيني وتخشى ابتلالا",60,"ل",2,0],["وتَرْسُمُ بَين أعْيُنِنا","ظلاما بات يطْوِينا",61,"ن",2,0],["\" وترسو في جمال الحب روحٌ\"","لها في خافقي ركن شديدُ",62,"د",1,0],["وترسم في شقوق الجِذع بَدرًا","لتحجب عن تساقُطِنا الغصونا",63,"ن",2,0],["وترسمُ في الثرى زوجى قلوب","وتنظرُ في السما نطق اطلابُ",64,"ب",1,0],["وتُرْسِلُ دَلْوَ إِدْلاءٍ بِرَأيٍ","لِتَسْبُرَ غَوْرَ أَخْيِلَةٍ سَحِيْقَةْ",65,"ق",2,0],["وَ تَرسُمني بضوءِ الشَّمسِ حرفًا","لتَمرُقَ منْ شَغافِ الغَمِّ...نُعمَى",66,"م",2,0],["وترسمُ الأحلامَ في داخلي","وشوقَها الصَّلبَ القويَّ العنيفْ",67,"ف",1,0],["وترسل الالحان صداحة ً","من فيض أنغام ألاولى الساحره ْ",68,"ر",2,0],["وتُرسِلُ اللحن تِلْوَ اللحنِ متزناً","عذباً كمطَّردٍ بالماء سلْسالِ",69,"ل",1,0]]}