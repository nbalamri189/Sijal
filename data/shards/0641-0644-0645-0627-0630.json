sgate.com/ViewPoem.aspx?id=210541",""],[5414,"صرخة من وراء الأسوار","https://www.poetsgate.com/ViewPoem.aspx?id=12936",""],[5542,"حوار في ساحة المطاف","https://www.poetsgate.com/ViewPoem.aspx?id=10068",""],[5550,"يا كثيرَ الصُّدُود","https://www.poetsgate.com/ViewPoem.aspx?id=211543",""],[470,"لماذا..؟!","https://www.poetsgate.com/ViewPoem.aspx?id=178067",""],[5616,"نفور","https://www.poetsgate.com/ViewPoem.aspx?id=203194",""],[5616,"سراج","https://www.poetsgate.com/ViewPoem.aspx?id=203332",""],[5616,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=203475",""],[5628,"التحول","https://www.poetsgate.com/ViewPoem.aspx?id=178547",""],[5691,"الأماني الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=206740",""],[3856,"كَسَرَابٍ فِي أعيُنِ الظَّامِئينَا","https://www.poetsgate.com/ViewPoem.aspx?id=215914",""],[5776,"مُذَكّرةُ قائد بالباب","https://www.poetsgate.com/ViewPoem.aspx?id=199334",""],[5899,"من أجلكِ","https://www.poetsgate.com/ViewPoem.aspx?id=31523",""],[5956,"كيان شرير التكوين","https://www.poetsgate.com/ViewPoem.aspx?id=192313",""],[5957,"ولماذا الساعة لا تعمل؟","https://www.poetsgate.com/ViewPoem.aspx?id=181672",""],[6093,"يذكر النَّاس ُ كلَّ مَيْتٍ بخيرٍ ( الخفيف)","https://www.poetsgate.com/ViewPoem.aspx?id=176024",""],[6120,"يَا قَلْبِي دَعْ عَنْكَ الْأَمَلَ","https://www.poetsgate.com/ViewPoem.aspx?id=214879",""],[6202,"رجاء جديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86724&r=&rc=25",""],[6225,"الحبُّ الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80938&r=&rc=207",""],[6237,"هموم الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77903&r=&rc=45",""],[6237,"إفاقة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77866&r=&rc=8",""],[6237,"وحشة قلب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77896&r=&rc=38",""],[6251,"الرِّسَالَة ُالخَامِسَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76491&r=&rc=31",""]],"verses":[["فَلَمّا ذَوى بَقلُ التَناهي وَبَيَّنَت","مَخاضُ الأَوابي وَاِستُبيِنَت حِيالُها",0,"ل",3,0],["فلماذا لا تنقضُون عهوداً","بعهودٍ هم قبلكم نقضوها",1,"و",3,0],["فلماذا نراك تدعو إليهم","وهم اليوم ذُلّنا والصَغار",2,"ر",1,0],["فلماذا رمى هناكَ صَفاتي","أصفيائي عَدِمْتُهم أصفياءَ",3,"ا",2,0],["فلِمْ أَذلتَ الشعر في مثله","فقلتُ والعذرُ بتبيينه",4,"ن",2,0],["فَلِماذا أَعشَقُ النَوم وَلا أَهوى الحِماما","وَلِماذا تَجزَعُ الأَرواحُ مِنهُ لَستُ أَدري",5,"ي",1,0],["فلماذا تعيش في الكونِ يا صاحِ","وما فيكَ من جنًى يستفيدُهْ",6,"ه",1,0],["فلماذا نراك وحدك تبكي","قلت ابكي حزنا على الضاحكينا",7,"ن",2,0],["فلماذا يا زهرتي انت آثر","ت على وجه الارض منها البطونا",8,"ن",2,0],["فَلِماذا أَضَعتُمُ عَهدَ مَن كا","نَ لَهُ صُحبَةٌ بِكُم وَاِلتِزامُ",9,"م",1,0],["فَلِماذا اِمتَعَضتَ مِن نَبتِ خَدّي","كَ وَما أَوجَبَ المَشيبُ اِمتِعاضي",10,"ض",2,0],["فَلَّما ذَاقَها قال اتركوها","فإنّ اللهَ قد كَشَفَ الغِطاءَ",11,"ا",2,0],["فَلَمّا ذَكَت عَينٌ وَأَشرَفَتِ العِدى","وَجاهَرَنا واشٍ وَدَبَّ حَسودُ",12,"د",1,0],["فلماذا لمحت وجهَك إذا أش","رق مثلَ العقيقة الحمراءِ؟",13,"ا",2,0],["فلِماذا جِئتَنِي مُكتَسِحًا","مُستَبينًا ما تُلاقِيهِ فَصَفحَك",14,"ك",1,0],["فلماذا تُحاولين بأنْ أعلنَ","ما يُنكِرُ الورى إعلانه",15,"ن",2,0],["فلم اذكر او يقاتي بسلع","مع الاحباب الا الدمع سالا",16,"ل",2,0],["فلماذا نَذرِفُ الدمع جُزافاً","ليس تَحيا الحطَبه",17,"ه",1,0],["فلماذا يبذل الوجه","إلى نذل سفيه",18,"ي",2,0],["فَلِماذا عَظَّموا مُعْتَصِماً","وَبماذَا فضّلوا مُعتَضِدا",19,"د",2,0],["فَلِماذا نَعتاضُ عَن زُرقَةِ الما","ءِ لَدى القَيظِ غُلَّةَ الظَمآنِ",20,"ن",1,0],["فَلماذا كلُّ نِصفٍ","يدَّعِي مَنزِلَتَينِ",21,"ن",1,0],["فلماذا أيُّها القلبُ أرى","هذه اللَّوعَةَ تسري في الوَتين؟",22,"ن",1,0],["فلما ذقت فحوى ما حواه","وقفت على الجوابات العذاب",23,"ب",1,0],["فَلِماذا حُرِمْتُ من غَيرِ عَجزٍ","ولماذا عُوقِبْتُ من غَيرِ حُوبِ",24,"ب",1,0],["فلماذا تتركُ الجاني يفر","ولماذا أنت يأساً تنتحر",25,"ر",1,0],["فلما ذكرتُ الأجْرَ فيما لقيتُهُ","تبلَّجتُ حتى كدتُ أشكر ظالمي",26,"ي",1,0],["فلماذا أهدت شمائلها البان","وقامت تدعو عليها الحمام",27,"م",1,0],["فلماذا حرَّموا النومَ وما","كان لولا البينُ و