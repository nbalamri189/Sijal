/54220","البسيط"],[36,"أنابغ لم تنبغ ولم تك أولا","https://www.poetsgate.com/ViewPoem.aspx?id=15884",""],[106,"غادة البسفور","https://www.poetsgate.com/ViewPoem.aspx?id=179474",""],[106,"في مهرجان الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179637",""],[106,"نيسان","https://www.poetsgate.com/ViewPoem.aspx?id=179310",""],[90,"لم تُنْصفوا اصوت من النجف","https://www.poetsgate.com/ViewPoem.aspx?id=178980",""],[90,"الأحاديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=179020",""],[90,"الذكرى أو دمعة تثيرها الكمنجة","https://www.poetsgate.com/ViewPoem.aspx?id=179143",""],[45,"يا بْنَ مَنْ طَابَ في المَوَالِيدِ حُرًّا","https://www.poetsgate.com/ViewPoem.aspx?id=31683",""],[80,"أرأيتَ لنَا ولهم ظُعُنَا","https://www.poetsgate.com/ViewPoem.aspx?id=3765",""],[46,"أنا، باللّيالي والحوادثِ، أخبرُ،","https://www.poetsgate.com/ViewPoem.aspx?id=20108",""],[28,"إنّ ابنَ يُوسُفَ مَحْمُودٌ خَلائِقُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=17938",""],[28,"إن الذي سمك السماء بنى لنا","https://www.poetsgate.com/ViewPoem.aspx?id=22079",""],[31,"يا ذا الذي في الحبّ يلحى ، أما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19087&r=&rc=349",""],[53,"أيُّ العُيُونِ تُجَانِبُ الأقْذاءَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9806&r=&rc=3",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""]],"verses":[["إِنَّ أَبانا الَّذي سَمِعتَ بِهِ","أَسَّسَ في هَضبَةِ العُلى وَبَنى",0,"ن",2,0],["إِنَّ اِبنَ موسى وَالبَقاءُ إِلى مَدىً","أَعطى القِيادَ بِمارِنٍ لَم يُخطَمِ",1,"م",1,0],["إِنَّ اِبنَ يوسُفَ عُرِّيَت أَنقاضُهُ","وَثَوى بِمَنزِلَةِ المُكَلِّ المُظلَعِ",2,"ع",1,0],["إِنّا بَني الدُنيا نُعَدَّ","لُ بِاللَيالي وَالشُهورِ",3,"ر",1,0],["أنا بالحَيِّ مُسْتَجيرٌ وبالمَيْتِ","أما في كلَيْهِما منْ مُجيرِ",4,"ر",1,0],["إنّا بَني نَصْرٍ إذا ما أطْلَعَتْ","يوْماً سَماءُ سُعودِنا مَوْلودا",5,"د",2,1],["إنْ أبْهَمَ الخَطْبُ أذْكى في دُجُنّتِهِ","رأياً يُفَرِّقُ بيْنَ الغَيِّ والرَّشَدِ",6,"د",1,0],["إِنْ أَبْرَمُوا أَمْراً فَرَبُّكَ مُبْرَمٌ","أمْراً وَإِنَّهُمْ هُمُ السُّفَهَاءُ",7,"ا",2,0],["إِنّا بَلَغنا رُشدَنا","وَالرُشدُ تَسبِقُهُ الغَوايَه",8,"ا",3,0],["أَنابِتَةَ العَصرِ إِنَّ الغَريبَ","مُجِدٌّ بِمِصرَ فَلا تَلعَبي",9,"ي",1,0],["إِنَّ اِبنَ عُروَةَ حينَ سَوَّدَ بِالزِنا","وَجهَي صَحيفَتِهِ وَبَيَّضَ مَسجِدا",10,"د",2,1],["إِنَّ أَبا حَسّانَ عَرشٌ هَوى","مِمّا بَنى اللَهُ بِكِنٍّ ظَليل",11,"ل",1,1],["أَنَابَكُمُ الْمَوْلَى الكَرِيمُ بِفَضْلِهِ","وَحَيِّ عَلَى الأَيَّامِ رَابِطَةَ الأَدَبْ",12,"ب",1,0],["إنَّ اْبْتِسَامَاتِ الوُجُوهِ كَثِيرَةٌ","دَرَجَاتُهَا وَلَهَا لِطَافُ مَعَانِ",13,"ن",1,0],["إِنْ أَبْطَأتْ حِيناً فَلَمْ يَكُ بِطْؤُهَا","دُلاَّ وَلَكِنْ مُبْطِيءٌ مَنْ يَخْجَلُ",14,"ل",1,0],["آناً بِبِيضِ أَيَادٍ","تُسْدَى وَآناً بِمَال",15,"ل",1,0],["أَنا بَشَّرتُ أَبا سَع","دٍ فَأَعطاني البِشارَه",16,"ر",2,1],["إِنَّ أَبا سَعدٍ عَلى مُجونِهِ","وَرِقَّةٍ في عَقلِهِ وَدينِهِ",17,"ن",2,1],["إِنَّ اِبنَ طَوقٍ وَبَني تَغلِبٍ","لَو قُتِّلوا أَو جُرِّحوا قَصرَه",18,"ر",2,1],["إِنَّ أَبا سَعدٍ فَتىً شاعِرٌ","يُعرَفُ بِالكُنيَةِ لا الوالِدِ",19,"د",1,1],["إِنَّ اِبنَ زَيّاتٍ لَهُ قَينَةٌ","أَربَت عَلى الشَيطانِ في القُبحِ",20,"ح",1,1],["إنَّا بني الآمال تخدعنا المنى","فنخادع الآمال بالتسيار",21,"ر",1,0],["أنا باقٍ على الوفاء وإنكا","نت بقلبي ممن أحبّ جراح",22,"ح",1,0],["أنا بالحكومة والسياسة أعرف","أأُلام في تفنيدها وأعنَّف",23,"ف",1,1],["أنابَكَ خَطب أم عَراك تعشُّقٌ","فإنّي أرى حزناً بوجهك باديا",24,"ي",2,0],["إِنَّ اِبنَ وَقبٍ وَاِبنَ أُمِّ خَوران","وَاِبنَ القُيونِ غُلَّقٌ في الأَقران",25,"ن",1,0],["إِنَّ اِبنَ شِعرَةَ وَالقَرينَ وَضَوطَراً","بِئسَ الفَوارِسُ لَيلَةَ الحَدَثانِ",26,"ن",1,0],["إِنَّ اِبنَ يوسُفَ فَاِعلَموا وَتَيَقَّنوا","ماضي البَصيرَةِ واضِحُ المِنهاجِ",27,"ج",1,0],["إِنّا بِطِخفَةَ أَو أَيّامِ ذي نَجَبٍ","نِعمَ الفَوارِسُ لَمّا اِلتَفَّتِ العُذَرُ",28,"ر",1,0],["أَنابُكَ أَم قَومٌ تَفُضُّ سُيوفُهُم","عَلى الهامِ ثِنيَي بَيضَةِ المُتَجَبِّرِ",29,"ر",1,0],["إِنَّ اِبنَ تَيمٍ لَمَنسوبٌ لِوالِدِهِ","داني القَرابَةِ مِن حامٍ وَيَحمومِ",30,"م",1,0],["إِنَّ اِبنَ آكِلَةِ النُخالَةِ قَد جَنى","حَرباً عَلَيكَ ثَقيلَةَ الأَجرامِ",31,"م",1,0],["إِنَّ أَبانَ كانَ حُلواً بَسرا","مُلِّئَ عَمراً وَأُرِبَّ عَمرا",32,"ر",2,1],["إِنَّ اِبنَ عَمِّكَ لَيسَ عَمُّ الأَخطَلِ اِج","تاحَ المُلوكَ وَفَكَّكَ الأَغلالا",33,"ل",2,0],["إِنَّ أَباكَ الرَذلَ كانَ لِصِغرَةٍ","وَكانَ أَبوكَ التَيسُ شاةً عَزوزا",34,"ز",2,1],["أَنَّ اِبنَ عَمرٍ سُهَيلاً كانَ أَلأَمَهُم","عِندَ الهَزاهِزِ بِالسَوءاتِ أَمّارُ",35,"ر",1,0],["إِنَّ اِبنَ جَفنَةَ مِن بَقِيَّةِ مَعشَرٍ","لَم يَغذُهُم آباؤُهُم بِاللَومِ",36,"م",1,1],["أنا باق هنا ولست أبالي","ما ألاقي من كيدها في البقاء",37,"ا",2,0],["إنَّ ابن بلبلَ نخلةٌ","لانتْ لصقرٍ من وراءِ",38,"ا",2,1],["إن أبا حفصٍ وعُثْنُونَهُ","كلاهما أصبحَ لي ناصبا",39,"ب",2,1],["إنَّ أبا العباس إلّا يكُنْ","أَرَّخَ بالفُلجِ فقد شَبّبا",40,"ب",2,0],["إن أبا العباسِ مستصحِبٌ","يَرضى أبا العباس مُستصحَبا",40,"ب",2,0],["إن أبا الصقر على بُعدِه","داني العطايا إن تكفَّفْتُها",41,"ت",3,0],["أنا باللَّه وَحدَهُ مستغيثٌ","ويميناً لَتأْتيَنِّي المغوثَهْ",42,"ث",2,0],["إن ابن إسماعيلَ مَفْزَعُ هارب","قِدماً وَمَفْدَى طالِبٍ وَمَراحُهُ",43,"ح",2,0],["إنْ أبتسمْ عَمَّا فعلتَ فَزينَةٌ","أوْ لاَ فما وَارَيْتُ ثَغْراً أقلحا",44,"ح",2,0],["إن أبا حفْصٍ سيستعدي","على القوافي حين لا مُعْدِي",45,"د",2,1],["إنّ ابنها في العالمين لآية","واللَّه أحكم خالقٍ ومصوّر",46,"ر",1,0],["أنا بين أظفار الزمان وخائف","منه شبا الأنياب والأضراس",47,"س",1,0],["أنا بالله عائذ من عُنوقٍ","سُمتَني أخذهنَّ من بعد نوق",48,"ق",1,0],["إنَّ أبا القاسم مستأهلٌ","عارفةً من عُرفِكَ المشترَك",49,"ك",1,0],["أنا بين الخصومِ فيه غريبٌ","لا أرى الزورَ للمحاباة أهلا",50,"ل",2,0],["أنا باللَّهِ عائذٌ وبحِقْوي","كَ وآلاءِ كفَّك المسئولهْ",51,"ل",2,0],["إن ابن عمار عُزيرُ العالمِ","قد أخرجتْهُ من تراث آدمِ",52,"م",1,1],["إنَّ أبا حفصٍ له","هامةُ صدقٍ نَزِهَهْ",53,"ه",2,1],["إِنَّ اِبنَ رِبعِيٍّ كَفاني سَيبُهُ","ضِغنَ العَدُوِّ وَنَبوَةَ البُخّالِ",54,"ل",1,0],["إِنَّ اِبنَ مَروانَ أَسقاني عَلى ظَمَإٍ","بِسَجلِ لا عاتِمٍ رَيّاً وَلا خَذِمِ",55,"م",1,0],["أَنا بَينَ أَصحابي الَّذينَ أُحِبُّهُم","ما أَجمَلَ الدُنيا مَعَ الأَصحابِ",56,"ب",1,0],["أَنا بَينَهُم أَسَدٌ وَجَدتُ عَرينَتي","أَنا بَينَهُم ظَبيٌ وَجَدتُ كِناسي",57,"ي",1,0],["إِن أَبكِ سورِيّا فَقَبلِيَ كَم بَكى","أَعشى مَنازِلَ قَومِهِ وَالأَخطَلُ",58,"ل",1,0],["أَنا بَسَمتُ وَقَد رَأَيتُكَ مُقبِلاً","فَكَما يَهَشُّ لِعائِديهِ عَليلُ",59,"ل",1,0],["أَنا بِالحُبِّ قَد وَصَلتُ إِلى نَفسي","وَبِالحُبِّ قَد عَرَفتُ اللَهَ",60,"ه",1,0],["أَنا بَعدَ المَوتِ شَيئاً لا أَكون","حَيثُ أَنّي لَم أَكُن مِن قَبلُ شَيء",61,"ي",2,0],["أَنا بِالفِراقِ مُرَوَّعٌ أَبَداً","ذا طالِعي فيهِ وَذا نَجمي",62,"ي",1,0],["أَنا بِالعاذِلِ لابَل","أَنا بِالعالَمِ أَلعَب",63,"ب",1,0],["إِنَّ اِبنَ مَغراءَ عَبدٌ لَيسَ نائِلَنا","حَتّى يَنالَ بَياضَ الشَمسِ رانيها",64,"ي",3,1],["إنَّ ابنَ آدمَ في قرارَةِ نفسِهِ","عبدُ الحَيَاةِ الصَّادقُ الإِيمانِ",65,"ن",1,0],["انا بعصر فيه","بالعلم تسود الامم",66,"م",1,0],["انا بعهد ناصب","اود لو ينصرم",66,"م",1,0],["انا بروض به الازهار مصغية","للعندليب وقد حفت به زمرا",67,"ر",2,0],["انا بالشعر وحده اتسلى","انه كل طارفي وتلادي",68,"ي",1,0],["انا بعصر يعاب الصادقون به","وليس يحمد الا الكاذب الاشر",69,"ر",1,0],["انا بعصر فيه عند الناس","ترك الشر بر",70,"ر",1,0],["انا بعصر تسابق","والويل للمتهمل",71,"ل",1,0],["انا بعصر الطائرا","ت ركوبة المتنقل",71,"ل",1,0],["انا بعصر الكهربا","ء وما لها من مشعل",71,"ل",1,0],["انا بعدما قد سرت في حبي لها","شوطاً بعيدا لست عنه ارجع",72,"ع",1,0],["انا بين الشيوخ لم انفرد في الذ","ذب عنها فان لي اشياعا",73,"ع",2,0],["إنا بظاهر أرضنا","قسمان مغصوب وغاصب",74,"ب",1,0],["إنا بحال لو علم","تم غير محمود العواقب",74,"ب",1,0],["إنّ اِبن زيدون على فضلهِ","يغتابني ظلماً ولا ذنب لي",75,"ي",1,1],["إنا برئنا من حماك إلى الذي","يحمى الأسود ويحفظ الأشبالا",76,"ل",2,0],["إن آباءك الكرام بمصر","خير من مدّنوا البلاد وساسوا",77,"س",3,0],["أنا بنت البر أم الفقرا","ليس دوني ملجأ للقاصدين",78,"ن",1,1],["أَنا بِالوُشاةِ إِذا ذَكَرتُكَ أَشبَهُ","تَأتي النَدى وَيُذاعُ عَنكَ فَتَكرَهُ",79,"ه",1,1],["أَنَّ أَبا جَعفَرٍ أَطالَ يَدي","بِنائِلٍ مِن نَداهُ مَوهوبِ",80,"ب",1,0],["أَنا بِالشامِ مَوطِني غَيرَ أَنّي","بَعدَ عَهدِ العِراقِ فيها غَريبُ",81,"ب",1,0],["إِن أَبقَ أَو أَهلَك فَقَد نُلتُ الَّتي","مَلَأَت صُدورَ أَصادِقي وَعُداتي",82,"ي",1,0],["إِنَّ أَبا الفَضلِ عَلى سَروِهِ","لَم يَزعُموهُ طَيِّبَ البَيتِ",83,"ت",1,0],["إِنَّ اِبنَ هارونَ الأَغَرَّ سَمَيدَعٌ","كَالبَدرِ يَطلُعُ في نُجومِ سُعودِ",84,"د",1,0],["أَنا بِالوُدِّ مُستَزيدٌ لِمَدحي","لَكَ مُستَقصِرٌ لِذائِعِ شُكري",85,"ي",1,0],["إِنّا بِأَسيافِنا نَعلو أَكابِرَهُم","قَسراً وَتَقتُلَنا الوِلدانُ بِالمُقَلِ",86,"ل",1,0],["إِنّا بَعَثنا اليَعمَلاتِ قَواصِداً","لِفِنائِكَ المَأنوسِ قَصدَ الأَسهُمِ",87,"م",1,0],["أَنا بِالوُدِّ وَالصَفاءِ زَعيمُ","وَعَلى العَهدِ وَالوفاءِ مُقيمُ",88,"م",1,0],["إِنَّ أَبا إِسحاقَ عَمَّت نِعَمُه","وَجَعجَعَت بِالناكِثينَ نِقَمُه",89,"م",2,0],["أَنَّ اِبنَ مِصقَلَةَ البَكرِيَّ دافَعَ لي","عَن نِعمَتي وَكفاني العُظمَ مِن شاني",90,"ي",1,0],["أَنا بِالقُربِ مِنكَ عِندَ صَديقٍ","قَد أَلَحَّت عَليَةَ شُهبُ سِنيهِ",91,"ي",2,0],["أَنَّ اِبنَ لَيلى بِأَرضِ النيلِ أَدرَكَهُ","وَهُم سِراعٌ إِلى مَعروفِهِ القَدَرُ",92,"ر",1,0],["إِنَّ أَبا الحارِثِ العَبّاسِ نائِلُهُ","مِثلُ السِماكِ الَّذي لا يُخلِفُ المَطَرا",93,"ر",2,0],["إِنَّ اِبنَ يوسُفَ مَحمودٌ خَلائِقُهُ","سيئانِ مَعروفُهُ في الناسِ وَالمَطَرا",94,"ر",2,1],["إِنَّ اِبنَ بَطحاوي قُرَيشٍ نَمى بِهِ","إِلى المَجدِ أَعراقٌ كِرامٌ وَمَغرِسُ",95,"س",1,1],["إِنَّ اِبنَ جَبّارَي رَبيعَةَ مالِكاً","لِلَّهِ سَيفُ صَنيعَةٍ مُسلولِ",96,"ل",1,0],["إِنَّ اِبنَ ضَبَّةَ كانَ خَيراً والِداً","وَأَتَمُّ في حَسَبِ الكِرامِ وَأَفضَلُ",97,"ل",1,0],["إِنَّ اِبنَ أُختِ بَني كُلَيبٍ خالُهُ","يَومَ التَفاضُلِ أَلأَمُ الأَخوالِ",98,"ل",1,0],["إِنَّ اِبنَ أَحوَزَ قَد داوَت كَتائِبُهُ","داءَ العِراقَ وَجَلَّت ظُلمَةَ الفِتَنِ",99,"ن",1,1],["إِنَّ اِبنَ أَحوَزَ مَحمودٌ شَمائِلُهُ","وَالمُستَقالُ بِهِ مِن عَثرَةِ الزَمَنِ",99,"ن",1,0],["إِنَّ اِبنَ وَرقاءَ لا تُخشى غَوائِلُهُ","لَكِن وَقائِعُهُ في الحَربِ تُنتَظَرُ",100,"ر",1,0],["أَنا بِالدَهرِ عَليمٌ","وَاَبو الدَهرِ وَأُمُه",101,"ه",1,1],["إِنَّ اِبنَ آمِنَةَ النَبيّ مُحَمَّداً","رَجُلٌ صَدوقٌ قالَ عَن جبريلِ",102,"ل",1,0],["إِن أُبدِهِ يَصفَح وَإِن لَم أُبدِهِ","يَقتُل فَقُبِّحَ وَجهُهُ مِن صاحِبِ",103,"ب",1,0],["أَنا بِبابِ القَصرِ في بَعضِ ما","أَطوفُ في قَصرِهِم إِذ رَمى",104,"م",2,0],["آناً بِقُربِكُمُ قَد صارَ يُبكينا","نَعى المُؤَيَّدَ قَومٌ لَو دَرَوا وَوَعوا",105,"ع",3,0],["إِن أَبادوا بِالغَدرِ مِنّا بُزاةً","وَيلَهُم مِن كَمالِ ريشِ الفِراخِ",106,"خ",1,0],["إن أبِت جائعاً فثمّةَ زادي","أو أبِت مُعسراً فثَمَّ الدراهم",107,"م",1,0],["إن ابنَ عليّ حازَ عُلاً","فالفعلُ له والقولُ لنا",108,"ن",2,0],["إنّ ابن يحيى عليّاً بدرُ مملكةٍ","لِصِيدِ آبائِهِ الإقدامُ والقدمُ",109,"م",1,0],["إنّ ابن يحيى من وكوف الحيا","في زَمَنِ المحل ليهمي انسجام",110,"م",1,0],["إنَّ ابنَ يَحيى في المفاخِرِ ذِكرُهُ","مُتَضَوّعٌ منه فمُ المتمثّلِ",111,"ل",1,0],["أنابوا وتابوا عن ذنوبٍ تَقَدّمَتْ","بزعمهمُ من قطعهم سُبُلَ البحرِ",112,"ر",1,0],["إن ابنَ يحيَى قد بَنى للعُلى","بيتاً فأمسى وهو جارُ الضراح",113,"ح",1,0],["إِن أُبلَ فيكَ بِأَن أَصبَحتَ مَنتَهَباً","فَالمَرءُ قَد يُبتَلى في صالِحِ الحُرُمِ",114,"م",1,0],["إِنَّ اِبتِداءَ العُرفِ مَجدٌ باسِقٌ","وَالمَجدُ كُلُّ المَجدِ في اِستِتمامِهِ",115,"م",2,0],["إِنّا بَعَثنا الشِعرَ نَحوَكَ مُفرَداً","وَإِذا أَذِنتَ لَنا بَعَثنا العيسا",116,"س",2,0],["أَنَّ اِبنَ طَوقِ بنِ مالِكٍ مَلِكٌ","مالِكُ أَمرِ المَكارِمِ الشُمُسِ",117,"س",1,0],["إِنَّ اِبنَ يوسُفَ نَجّى الثَغرَ مِن سَنَةٍ","أَعوامُ يوسُفَ عَيشٌ عِندَها رَغَدُ",118,"د",1,0],["إنَّ أباها وأبا أباها","قدْ بلغا في المجدِ غايتاها",119,"ه",2,0],["إنْ أبقَ أوْ أهلَكْ فقدْ نلتُ المنى","وبلغتْتُ سؤْلي قاضياً أوطاري",120,"ر",2,0],["أنا بدرٌ وقد بدا الصبحُ في رأ","سِكَ والصبحُ طاردٌ للبدورِ",121,"ر",1,0],["إنْ أبكِ يضحكْ وإنْ أعقلْ يجنَّ وإنْ","أقرَّ يعبثْ وإنْ أحضرْ لهُ يغبِ",122,"ب",1,0],["أَنا بِبابِ القَصرِ بي بَعضِ ما","أَطلُبُ مِن قَصرِهِمُ إِذ رَمى",123,"م",2,0],["إنّا بَنوهُ فَلن يَرانا نَبْتَغِي","دِينَ الجُمودِ ولن نَراهُ يَبورُ",124,"ر",1,0],["آناً بمُلْتَطَمِ الدّماءِ وتارةً","في جَوْفِ مُحتدَمٍ من النّيرانِ",125,"ن",1,0],["إِنّا بَنو القُرآنِ وَالدينِ الَّذي","صَدَعَ الشُكوكَ وَجاءَ بِالتِبيانِ",126,"ن",1,0],["أَنّا بَنو عُثمانَ أَعلامُ الوَرى","وَالأَرضُ تَشرُفُ فَوقَها الأُعلامُ",127,"م",1,1],["إنّ ابن أرقمَ لم تكن لتخونه","أُذُنٌ تَعِي وتصونُ ما تتلقّفُ",128,"ف",1,0],["أَنا بِالرَحمَن مِن حو","رٍ يكَسِّرن جفونا",129,"ن",2,1],["أنا بِكْرُ ساعاتٍ ثلاثٍ","كلها رمزُ الحميَّهْ",130,"ي",2,0],["اَنابَت لِوَجهِ اللَهِ ثُمَّ تَبتَّلَت","فَسَّبَحَ عَنها لَومةَ المُتَلَوِّمِ",131,"م",1,0],["إِنّا بِالشِعبِ الَّذي دونَ سَلعٍ","لَقَتيلاً دَمُهُ ما يُطَلُّ",132,"ل",1,1],["أَنابَت إِلى جَنّاتِ عَدنٍ نُفوسُهُم","وَما بَعدَها لِلصالِحينَ حُتوفُ",133,"ف",1,0],["أَنا بَينَ الهَوى وَبَينَ التَجَنّي","في شَقاءٍ وَفي عَذابٍ شَديدِ",134,"د",1,1],["إنَّ إبراهيمَ مردودٌ إلى","زَمَنٍ غَضٍّ وأيّامٍ جُدُد",135,"د",1,0],["أَنا بِالبَصرَةِ مَولىً","عَرَبِيٌّ بِالجِبالِ",136,"ل",1,0],["إِنَّ اِبنَ عَمِّ النَبيِّ يَهدي إِلى ال","حَقِّ وَما دونَ نَبثِهِ وَزَرُ",137,"ر",1,0],["إِنَّ اِبنَ نِهيا عَلى أَخلاقِ والِدِهِ","لا يَحرِمُ الضَيفَ مِن عِرسٍ لَهُ زادا",138,"د",2,0],["أَنا بِلٌّ بِشادِنٍ","أَحوَرِ العَينِ أَجيَدا",139,"د",2,0],["إِنَّ اِبنَ ساقي الحَجيجِ يَكفيكَ ما","حَلَّ مُقيماً وَأَيَّةً رَكِبا",140,"ب",2,0],["إِنَّ اِبنَ آسى مَضى وَلَكِن","دَلَّ عَلى فَضلِهِ الزَبورُ",141,"ر",1,0],["أَنا بِاللَيالي وَالحَوادِهِ أُخبَرُ","سَفَرٌ يَجِدُّ بِنا وَجِسرٌ يُعبَرُ",142,"ر",1,1],["إِنّا بِعَلمِ إِلَهي كُلُّنا دَنَسٌ","فَكَيفَ نَخلو مِنَ الأَقذارِ وَالدَنَسِ",143,"س",1,0],["أَنا بِئسَ الإِنسانُ وَالناسُ مِثلي","فَاِعتِبيني إِن شِئتِ أَو فَاِعتَبي لي",144,"ل",2,0],["إنّا بعَثْناكَ تَبْغي القَولَ من كَثَبٍ","فجِئْتَ بالنّجْمِ مَصْفوداً من الأفُقِ",145,"ق",1,0],["إن أَبطأت شمس الرقي","يِ فإنَّ فجر الشعب كاذب",146,"ب",1,0],["إنا بعصر أَهله","يتيقظون من المنام",147,"م",1,0],["إنا بعصر لا حَياة بأرضه","إلا لمن هو في الكفاح نشيط",148,"ط",1,0],["إن ابتساماتي انتهت أَسبابها","فإذا بكيت فما عليّ ملام",149,"م",1,0],["إِنّا بواد لَيسَ يؤمن سيله","فَلنَبتَعد عنه إلى الآكام",150,"م",1,0],["إِنَّا بعصر قد أَبان رقيُّه","وَالناس قَد غاصوا البحار وَطاروا",151,"ر",3,0],["ان اِبتسمت من الخف","ضِ وَالسَعادة حينا",152,"ن",2,1],["إنا بعصر به لا","يجوز للناس مهل",153,"ل",1,0],["إِنا بعصرٍ لا يَجو","ز لمن يَعيش به القعود",154,"د",1,0],["إِنّا بعصر ما تقد","دم في سَبيل المكرمات",155,"ت",1,0],["إنّ ابن زيدون له فقحة","تعشقُ قضبان السراويلِ",156,"ل",1,1],["إنَّا بلونا الهولَ باسم الغرامْ","جنباً لجنبٍ ورجونا المُنى",157,"ن",2,0],["إنّا بنوكِ وإن سُئلتِ فأُمنا","مهدُ الشموسِ وعرشُهنَّ المعْرِقُ",158,"ق",1,0],["أَنابغَ لَمْ تَنْبَغْ ولَمْ تَكُ أَوّلا","وكُنْتَ صُنيّاً بَيْنَ صُدَّيْنِ مَجْهَلا",159,"ل",2,1],["أَنابغَ إنْ تَنْبَغْ بلُؤْمِكَ لا تَجِدْ","لِلُؤْمِكَ إِلاّ وَسْطَ جَعْدَةَ مَجْعَلا",159,"ل",2,0],["إنْ أبَى دَرُّها النّزُولَ مِنَ الخِلْ","فِ حَلَبْنا لهمْ مِن العُرْقوب",160,"ب",1,0],["أنا بَدْرٌ وقد بدا الصّبْحُ في رأ","سِكَ والصّبْحُ يَطْرُدُ الأقْمارا",161,"ر",2,0],["إنَّ ابنَ أُمِّكَ لَم يُنظَر قَفِيَّتَهُ","لَمَّا تَوارَى وَرامَى النَّاسَ بِالكَلِمِ",162,"م",1,1],["إِنَّ ابْنَ آدَمَ لَوْلا عَقْلُهُ شَبحٌ","مُرَكَّبٌ مِنْ عِظَامٍ ذَاتِ أَوْصَالِ",163,"ل",1,0],["إِنَّ ابْنَ آدَمَ فِي الدُّنْيَا عَلَى خَطَرٍ","لا يَسْتَقِيمُ لَهُ قَصْدٌ وَمِنْهَاجُ",164,"ج",1,0],["إِنَّ ابْنَ آدَمَ ذُو طَبَائِعَ أَرْبَعٍ","مَجْمُوعَةِ الأَجْزَاءِ فِي أَخْلاقِهِ",165,"ق",2,1],["إِنَّ ابْنَهُ لَسِرُّهُ","فِي الفَضْلِ وَالتَّفَضُّلِ",166,"ل",1,0],["إِنَّ ابْتِساماً لاَحَ مِنْهَا عِنْدَ مَا","جَاءَتْ بِهذِي الْحُلَّةِ البَيْضَاءِ",167,"ا",2,0],["إنّا بَنُو الحَرْبِ نُمْرِيها وَنُنْتِجُهَا","وعِنْدَنا لِذَوي الأضْغَانِ تَنْكيلُ",168,"ل",1,0],["أنَابُوا وَلَمْ يَفْتِنْهُمُ مَا أَصَابَهُمْ","من النّكثِ فيها والبلاء بل الوَتْرِ",169,"ر",1,0],["أَنا بَهظَتني صُروف الرَدى","فَكَيفَ أَمانُكَ أَن تُبهَظا",170,"ظ",2,0],["أَنابيقُ هَداجينَ بَعدَكَ ها هُنا","مَتى لُمتَهُم في اللَومِ أَلحَ قَنافِذا",171,"ذ",2,0],["أنا بالدرِّ أخبرُ الناسِ لكن","ذلك النوعُ ندّ عن إمكاني",172,"ي",1,0],["أنا بالمجدِ مُولَعٌ وبأهلي","ه وبالباقياتِ من ذِكْرَياته",173,"ت",2,0],["إِنَّا بدَرْسِ الدِّينِ أَبْصَرْنَا الهدَى","نُوراً يُشِعُّ بِجَمْعِهِ المحشُودِ",174,"د",1,0],["إنَّا بَني الأُسْدِ أمضَى مِخْلباً ويداً","لَدَى الصِّراعِ وأحْمَى الناسِ عِرْنينَا",175,"ن",2,0],["إنَّ ابنَ داودٍ علَى سُلْطانِه","قد خَرَّ مُنْفَرِداً على مِنْساتِهِ",176,"ت",2,0],["إنّا بنو العُربِ يا صحراءُ كم نَحتت","من صخركِ الصلْدِ أخلاقاً أوالينا",177,"ن",2,0],["أنابغ إن تنبغ بلؤمك لا تجد","لِلُؤمك إلاوَسَسْطَ جَعْدَة َ مَجْعَلا",178,"ل",2,0],["إِنَّا بعين الفخر ترمُقُ نصرهم","ونعيذهم من نشوة المغرور",179,"ر",1,0],["أنا باليراع -ولا أمنُّ على الحمى-","كافحتُ الاستعمارَ أيَّ كفاح",180,"ح",1,0],["إن ابنَ آدمَ عن سرِّ الوجود، وعن","سر الحياة، وسر الموت غفلان",181,"ن",1,0],["أنابغةَ الدين الذي دون عِرضه","تدافع يُسراه وتحمي يمينُهُ",182,"ن",2,1],["إن أباحتْ لكِ أربابُ الهَوى","سِرَّه فالحكمُ عندي أن يصونوا",183,"ن",3,0],["أنا بانتظارِكِ كلَّ آونةٍ","علماً بأن الحزنَ مُنْتَظِري",184,"ر",2,0],["أَنَا بالْقُرْبِ مِنْكَ عِاْدَ صَدِيقٍ","قَدْ أَلْحَّتْ عَلَيْهِ شُهْبُ سِنِيهِ",185,"ي",2,0],["إنّ ابن عليّ حازَ عُلي","فالفعلُ له والقولُ لنا",186,"ن",2,0],["أنا، باللّيالي والحوادثِ، أخبرُ","، سَفَرٌ يَجِدُّ بنا، وجِسرٌ يُعبَرُ",187,"ر",1,1],["إنّ ابنَ يُوسُفَ مَحْمُودٌ خَلائِقُهُ","سِيئانِ مَعرُوفُهُ في الناسِ وَالمَطَرُ",188,"ر",1,1],["إنّ ابنَ ضَبّةَ كانَ خَيراً وَالِداً،","وَأتَمُّ في حَسَبِ الكهرَامِ وأفضَلُ",189,"ل",1,0],["أنا ببابِ القصرِ، في بعضِ ما","أطلبُ في قصرهمُ، إذ رمى",190,"م",2,0],["انا بنو الدنيا تسير ركابنا","وَتُغالِطُ الإدْلاجَ وَالإسْرَاءَ",191,"ا",2,0],["إِنَّ ابْنَكَ المَصْفُودَ في أَغْلالِهِ","قَدْ سِيقَ نَحْوَ الْمَوْتِ غَيْرَ مُدانِ",192,"ن",1,0]]}