{"poems":[[55,"مثواي إما صهوة أو غارب","https://www.aldiwan.net/poem30756.html","الكامل"],[88,"أثنى الحجيج عليك والحرمان","https://www.aldiwan.net/poem68941.html","الكامل"],[54,"طال ليلي وساورتني الهموم","https://www.aldiwan.net/poem26703.html","الخفيف"],[69,"إن تحي آمالي برؤية عيسى","https://www.aldiwan.net/poem18073.html","الكامل"],[70,"صد حمى ظمئي لماك لماذا","https://www.aldiwan.net/poem1495.html",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[102,"أسمار القرية","https://www.poetsgate.com/ViewPoem.aspx?id=50334",""],[53,"وبديعٍ من البدائع يَسْبي","https://www.poetsgate.com/ViewPoem.aspx?id=29591",""],[240,"ألفجر ليلك بالبنية مطلع","https://www.aldiwan.net/poem31891.html","الكامل"],[366,"أيها الخل قد صحبناك دهرا","https://www.aldiwan.net/poem68109.html","الخفيف"],[376,"أما الحديث بما صنعت فقد بدا","https://www.aldiwan.net/poem57485.html","الكامل"],[435,"بلبل يشدو ويصدح","https://www.aldiwan.net/poem41415.html","مجزوء الرمل"],[543,"أبخير عيد أم بخير إمام","https://www.aldiwan.net/poem47940.html","عموديه"],[556,"أجر المدامع كيف شيتا","https://www.aldiwan.net/poem48033.html","مجزوء الكامل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199623","المسحوب"],[985,"","https://poetry.dctabudhabi.ae/diwan/poem/111239","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62558","الخفيف"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80185","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136198","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136162","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136115","الكامل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78142","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177822","الخفيف"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109463","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121147","الكامل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131947","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76729","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120366","الكامل"],[4858,"صبراً أُخَيَّ","https://www.poetsgate.com/ViewPoem.aspx?id=29944",""],[4961,"خمس دقائق قبل وصول العاصفة","https://www.poetsgate.com/ViewPoem.aspx?id=33331",""],[5111,"فِي لُجِّ الْغِيَابِ","https://www.poetsgate.com/ViewPoem.aspx?id=212357",""],[5111,"عَشْتَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=212606",""],[5136,"أسد غودر في القاع الجدد","https://www.poetsgate.com/ViewPoem.aspx?id=121559",""],[5277,"صَلُّوا عَلَيْهِ وَسَلِّمُوا تَسْلِيمًا","https://www.poetsgate.com/ViewPoem.aspx?id=200675",""],[5365,"وللكحلِ في عينيها أحلامُ","https://www.poetsgate.com/ViewPoem.aspx?id=190407",""],[5459,"عَابُوكَ ..","https://www.poetsgate.com/ViewPoem.aspx?id=212859",""],[5751,"أميرة القلب","https://www.poetsgate.com/ViewPoem.aspx?id=215029",""],[5906,"فمعفر الليث","https://www.poetsgate.com/ViewPoem.aspx?id=188221",""],[6102,"على !!","https://www.poetsgate.com/ViewPoem.aspx?id=184455",""],[6234,"الدوحة الشاعرة المحتضرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6536&r=&rc=3",""]],"verses":[["وَعَلَيَّ في هَذا المَقالِ غَضاضَةٌ","إِن لَم يُساعِدني القَضاءُ الغالِبُ",0,"ب",1,0],["وَعَلى فَرَنسيسِ الحَضارَةِ مِنَّةٌ","تُتلى أَناشيدٌ لَها وَأَغاني",1,"ن",2,0],["وَعَليٌّ فَكَاِبنِهِ غَيرَ شَكٍّ","واجِبٌ حَقُّهُ عَلَينا عَظيمُ",2,"م",1,0],["وَعلى فَتَى الحَسَنِ الذي سَطَوَاتُهُ","مَرَّت على الأَعداءِ مَرَّ المُوسى",3,"س",2,0],["وعليّ فيكَ مَنِ اعتدَى في حِجْره","فقَد اغتدى في حِجْرِهِ مَلّاذا",4,"ذ",2,0],["وَعَلَى فَقِيدٍ كَالَّذِي","تَبْكِينَ فَلْيَكُنِ النَّحِيبُ",5,"ب",1,0],["وعلى فجأة تلقت خطاها","من غبار الصدى ، غيوم رواعد",6,"د",1,0],["وعليَّ فارطَ العتاب فإنِّي","واطىء ٌ من مَعاتبي كلَّ رضْف",7,"ف",1,0],["وَعَلى فُروعِ البانِ كُلُّ خَلِيَّةٍ","باتَت تُغَرِّدُ في الغُصونِ وَتَسجَعُ",8,"ع",1,0],["وَعَلى فَرض أَنَّني فيك أَذنب","ت فاني لَدَيك آمل سترا",9,"ر",2,0],["وعليَّ فيها أن أقيمَ بذكرِها","فبذكرِه في كلِّ يومٍ مَشهَدا",10,"د",2,0],["وعليّ في مقام","أسعديّ ليس يبرح",11,"ح",1,0],["وعلى فراشِ سَقامِه مُتَمَلمِلاً","بِجُروحِه يشكو منَ الآلامِ",12,"م",1,0],["وعلى فراقِ حبائبٍ","وأقاربٍ منّا غُذِيتا",13,"ت",2,0],["وعلى فرقا عْرب لي","ومصافاة النديم",14,"م",1,0],["وعلى فتى والاكم","ألف والف من تحيه",15,"ي",2,0],["وعليٌّ في سما رتبته","ومعاليه عليٌّ كعلي",16,"ل",2,0],["وَعَلى فوادي قامَ كُرسي مَجدِهِ","فَأَقامَ مُنَجَلياً بِخَير مَكانِ",17,"ن",1,0],["وعلى فضلك الجزيل اعتمادي","وإلى بابك المنيع اضطراري",18,"ر",2,0],["وعلى فضلك المعول فابسط","ذيل ستر على قبيح عشاري",18,"ر",2,0],["وعلى فضلك الجزيل اعتمادي","حبذا من عليك القى اعتماده",19,"د",2,0],["وعلى فوايدها عثرت بشاهد","في الذوق أسفر ما عليه نقاب",20,"ب",1,0],["وَعليَّ في البُرهان أَكبَر شاهِدٍ","مِن عترة الجَبَلي وَآل مُحَمَد",21,"د",1,0],["وعلى فرشٍ من الجعدِ تَرِفْ","طالما العاشقُ منها قلّبا",22,"ب",2,0],["وعلى فقده فقد ردد الجذع","حنينا لبعده بانتحاب",23,"ب",1,0],["وعلى فرض أننا ما ائتلفنا","هو أهل لكل شكر وحمد",24,"د",1,0],["وَعلى فَكَم مَعنًى لَهَا أيضاً لَدَى","عَمرٍو فذَاكَ إمَامُ هَذَا الشَّانِ",25,"ن",1,0],["وعليَّ فعل المستطاع منادياً","للنّاس أنّ الله يا قوم اشترى",26,"ر",2,0],["وعلى فمي من مدحكم لي نغمة","في الشعر قد غزت على بشاره",27,"ر",2,0],["وعلى فروع الايك شاد يحتوي","طرباً لآخر تحتويه الأضلع",28,"ع",1,0],["وعلى فيضي منهم فياضة","آلاؤه فجزت عن الاغداق",29,"ق",1,0],["وَعَلَى فِلَسْطِينَ المُعَذَّبِ شَعْبُهَا","هَبَطَ البُغَاةُ كَأَنَّهُمْ دَأْدَاءُ",30,"ا",2,0],["وعلى فؤادي مِن محيطِكَ واحةٌ","ومياهُها هيَ في يديَّ خواطرُ",31,"ر",1,0],["وَعلى فمِي آياتُ شِعْرٍ هائم ٍ","يتلُو رؤى آنَائِهَا يَتَموَّرُ",32,"ر",1,0],["وَعَلَى فَاهِي مَعَان ٍ تَتَنَاغَى","تَقْطِفُ الألْفَاظَ مِنِّي فِيْ احْتِيَالِ",33,"ل",1,0],["وعلى فقده قد شفني","ولا حشائي وللاكباد",34,"د",1,0],["وعلى فؤادي كلُّ شوقٍ ملؤُهُ","حبٌّ لمنْ بالوحيِ بدرٌ للهدى",35,"د",2,0],["وعليّ فاقصُص لا تخَف من شاعرٍ","سأكونُ سرّاً ناصحاً ووزيرا",36,"ر",2,0],["وعَلَى فَرَحٍ ضَافٍ حَبَكَتْ","بُشْرَاهُ تَقَاسِيمَ النَّغَمِ ..",37,"م",1,0],["وعلى فمي القرآنُ ظلَّ فأورقتْ","من بوحهِ (الكرسيُّ) ثمّ (الناسُ)",38,"س",1,0],["وَعَلى فَيافينا المُجازُ تُرابُها","تَلهو الفَوارِسُ بِالرَّدى تَعليلا",39,"ل",2,0],["وَعَلَى فَمِي لَمَّا قَدِ اصطَرَعَا","لَم أَلقَ لِي حَولًا وَلَا قِبَلا",40,"ل",2,0],["وعلى فروعي الشمس سارحة","من نورها أختار ألواني",41,"ن",2,0]]}