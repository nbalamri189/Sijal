{"poems":[[74,"دعاه لذكر الحمى مذهب","https://www.aldiwan.net/poem18271.html","المتقارب"],[53,"يا ذا الذي قد حال عن عهدي","https://www.aldiwan.net/poem61903.html","السريع"],[91,"جثمانه هذا فاين المنطق","https://www.aldiwan.net/poem44775.html","الطويل"],[68,"أبت الوصال مخافة الرقباء","https://www.aldiwan.net/poem38501.html","الكامل"],[68,"فيروزج الصبح أم يا قوتة الشفق","https://www.aldiwan.net/poem41544.html","البسيط"],[92,"شممت تربك لا زلفى ولا ملقا","https://www.aldiwan.net/poem60156.html","عموديه"],[76,"بما حزته من شريف النظام","https://www.aldiwan.net/poem13262.html","المتقارب"],[107,"أعلى المآتم تخفق الأعلام","https://www.aldiwan.net/poem42080.html","الكامل"],[78,"أمصباح هذا الدين بعد نبينا","https://www.aldiwan.net/poem39271.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39643","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16686","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54559","الكامل"],[96,"إيه حكيم الدّهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66311&r=&rc=29",""],[129,"سائل بغرته الهلال المقمرا","https://www.aldiwan.net/poem4089.html","الكامل"],[170,"تلك الجنان قطوفهن دوان","https://www.aldiwan.net/poem46838.html","الكامل"],[173,"كره الله ما أحب الأعادي","https://www.aldiwan.net/poem1621.html",""],[185,"أمصعب قد نجوت من الأعادى","https://www.aldiwan.net/poem59094.html","الوافر"],[216,"خليدة ذاب القلب من حر شوقكم","https://www.aldiwan.net/poem37854.html","الطويل"],[234,"لجوا فلج غرامي فيك إذ عذلوا","https://www.aldiwan.net/poem50851.html","البسيط"],[266,"متى يستفيق الدهر من غفلانه","https://www.aldiwan.net/poem38140.html","الطويل"],[275,"لأبي عبيدة في دمشق وخالد","https://www.aldiwan.net/poem35645.html","الكامل"],[290,"أمصر طربت لكن ليس هذا","https://www.aldiwan.net/poem39414.html","الوافر"],[369,"غير العدا بسيوفكن قتيل","https://www.aldiwan.net/poem60807.html","الكامل"],[438,"مولاي عبدك يشتكي","https://www.aldiwan.net/poem12546.html","مجزوء الكامل"],[445,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[458,"الفتنة الكبرى تطل قرونها","https://www.aldiwan.net/poem61287.html","الكامل"],[545,"إذا مطمع يوما غزاني غزوته","https://www.aldiwan.net/poem56860.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138325",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83326","الطويل"],[717,"","https://poetry.dctabudhabi.ae/diwan/poem/146633","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48614","الخفيف"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18493","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62659","الكامل"],[1367,"","https://poetry.dctabudhabi.ae/diwan/poem/205627","الكامل"],[1367,"","https://poetry.dctabudhabi.ae/diwan/poem/205473","الطويل"],[1421,"","https://poetry.dctabudhabi.ae/diwan/poem/117105","البسيط"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/114006","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108566","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/199440","الطويل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126200","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93845","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100425","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200002",""],[3226,"","https://poetry.dctabudhabi.ae/diwan/poem/140161",""],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74049","الكامل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123939","الطويل"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103601","المتقارب"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131986","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206160",""],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117888","المجتث"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59455","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101390","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52124","الوافر"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52166","الخفيف"],[3464,"تحكم بما تهوى لك الحسن مسعدُ","https://www.poetsgate.com/ViewPoem.aspx?id=158768",""],[4830,"ياجوهرَ الأقداس","https://www.poetsgate.com/ViewPoem.aspx?id=211350",""],[4913,"عام ٌ جفاك","https://www.poetsgate.com/ViewPoem.aspx?id=202979",""],[5136,"نفس على برحى الشوق أطويها","https://www.poetsgate.com/ViewPoem.aspx?id=121778",""],[5186,"طاب يا نشء في نهاك الثناء","https://www.poetsgate.com/ViewPoem.aspx?id=156455",""],[2365,"ظربت وشاقتك البروق اللوامع","https://www.poetsgate.com/ViewPoem.aspx?id=200652",""],[5431,"ياقلبُ قلْ لي...","https://www.poetsgate.com/ViewPoem.aspx?id=185004",""],[5431,"تبارك الله أحسن الخالقين...","https://www.poetsgate.com/ViewPoem.aspx?id=203151",""],[5531,"أذكريني يامنيتي","https://www.poetsgate.com/ViewPoem.aspx?id=128418",""],[243,"حقائق كالخيال","https://www.poetsgate.com/ViewPoem.aspx?id=50559",""],[5842,"عصفورة الأمل \\محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=150624",""],[5956,"هل يعرف التاريخ مثل فتايا؟","https://www.poetsgate.com/ViewPoem.aspx?id=193202",""]],"verses":[["أمصرُ سقتكِ غوادِي السرور","وجادَكِ من أفقها صيب",0,"ب",1,0],["أم صُنْتني عن سَقْي دَسْتيجَةٍ","أم لم يساعدني بها جَدِّي",1,"د",2,0],["أم صنتَ مقدارَك عن أن تُرَى","تُهْدي حقيراً في الذي تُهْدي",1,"د",2,0],["أمصور الارواح بعد جسومها","صور اذا ما اسطعت روحك تزهق",2,"ق",1,0],["أَمُصيبَةً مِنّا بِنَبلِ لِحاظِها","ما أَخطَأَتهُ أَسِنَّةُ الأَعداءِ",3,"ا",2,0],["أَم صارِمُ الشَرقِ لَمّا لاحَ مُختَضِباً","كَما بَدا السَيفُ مُحمَرّاً مِنَ العَلَقِ",4,"ق",1,0],["أَم صامِدَيْنِ يَرُبَّانِ المَصيرَ مَعاً","حُبَّاً ويَقْتَسِمانِ الأَمْنَ والفَرَقا",5,"ق",2,0],["أَمُصُّ مَراشِفَها لَوعَةً","وَأَذكُرُ مابَينَنا مِن ذِمامِ",6,"م",1,0],["أَمَصارعَ الشُّهداءِ أين دماؤُهم","وَهَلِ اشْتَفَى مِنها ومنكِ أَوامُ",7,"م",1,0],["أمِصباحَ هذا الدين بعدَ نبيّنا","ومَن نُورهُ في الشرقِ والغربِ ساطعُ",8,"ع",1,1],["أم صاحبا سفَرٍ مال الضَّنَى بهما","حوَتهما جنّةٌ للفنِّ معطارُ",9,"ر",1,0],["أمْ صالحاتُ البَناتِ إضْنَ بها","زِيادَةً في الرِّعَاثِ والخَدَم",10,"م",1,0],["أَمْ صَرَّحْتْ نُذُرُ المَشِي","بِ وَظَلَّ يُنْكِرُهَا الشَّبَابُ",11,"ب",1,0],["أمصوّر الدنيا جحيما فائرا","يرمي العصور بجمره اللّفّاح",12,"ح",1,0],["أَم صَدرُ غانِيةٍ تَمَزَّقَ جَيبُها","فَغَدَت تَحُوكُ الوَشي فيهِ مُصَوّرا",13,"ر",2,0],["أم صُدغُ مَعشوقٍ تَصَوْلَجَ مسكُهُ","من وردِ وَجنَتهِ على ميدانِ",14,"ن",1,0],["أَم صِيامٌ يَتلوهُ طولُ قِيامٍِ","فَهوَ في الدَهرِ ساهِرُ الطَرفِ صادِ",15,"د",1,0],["أَمُصعَبُ قد نَجَوتَ مِنَ الأعادى","ولم تُصبح بِمُعتَرَكٍ قتيلا",16,"ل",2,1],["أمصُّ ثغورَ الخُود مهما يَلذُّ لي","وقد مالَ بي بعد الصَّبُوحِ غُبُوقُ",17,"ق",1,0],["أَمْ صدَّه وجِلاً أَمْ دَمْعَه خَضِلاً","أَمْ شَعْرُه رَجِلاً أمْ خَطْوَه كَسِلاَ",18,"ل",2,0],["أمصباحنا والدهر داج ولا أرى","مصابيح هذا الدهر غير هداته",19,"ت",2,0],["أمصيرُهم يوماً يكونُ مصيرَنا","ولنا على الأطلالِ حَسرةُ فاقد",20,"د",1,0],["أمصر طربت لكن ليس هذا","بكافينا لدى العيد الجديد",21,"د",1,1],["أمُصرِّفَ الأقلامِ وهْي دقيقةٌ","يَكْفي بهنَّ الخَطْبَ وهْو جليل",22,"ل",1,0],["أم صحّ ما قال الوُشا","ةُ بما استرابَ به اعتِقادُك",23,"ك",1,0],["أَمْصُّ من الكافورِ مِسْكاً وأَجتَنِي","من الوَشْيِ رُمَّاناً زَهتْهُ المقادِمُ",24,"م",1,0],["أم صادق التاريخ وهو مدون","آثامكم إن فاتكم تدوينها",25,"ن",3,0],["أَمصُّ ثِمادي وَالمياهُ كَثيرَةٌ","أُعالِجُ مِنها حَفرَها واِكتِدادَها",26,"د",3,0],["ام صالح الاعمال أشرق بيننا","منه محياً كالكواكب ساطع",27,"ع",1,0],["أَمصَرعَها يَومَ الثَلاثا وَقَد سَرى","بِها نَعشَها كَالفَلَكِ وَالدَمعِ حامِلُهُ",28,"ل",2,0],["أم صوب دمعي وأنفاسي؟ فهن لها","بعد الأحبة أرواح وأمطار",29,"ر",1,0],["أم صحيحَ الفؤاد والجسم مسرو","راً بشمل مجمَّعٍ وهناء",30,"ا",2,0],["أَمُصعَبُ مَن يَحرُب وَيُذمَم فِعالُهُ","فَما كُنتَ بِالواني وَلا المُتَحَرَّبِ",31,"ب",1,0],["أم صححت سمد حديث مودة","يرويه عن سندٍ فَمُ النَسْماءِ",32,"ا",2,0],["أمصدّق فيك الظنون وناظر","للنيل نظرة مانح وصّال",33,"ل",1,0],["أمصيبا إذا انتحلت محالا","ومحيلا إن فهت بالمعقول",34,"ل",1,0],["أمصطفى بن علي يا أخا ثقتي","إني عهدتك للإخوان معوانا",35,"ن",2,1],["أم صابَها وَشكُ الفِراقِ بعائِرٍ","فبَكَت وَحُقَّ لها الغداةَ بُكاها",36,"ا",3,0],["أم صون أبناء السبيل من النصي","ريين ذنبٌ للولاة صريح",37,"ح",1,0],["أمصغية حثي تبثك شجوها","حوائم لم تعهد كواديه واديا",38,"ي",2,0],["أمَّ صَحبِى بقُدوَةٍ قُطبَ وَقتى","مَهبَطَ السِّرّ برزَخَ الإقتداءِ",39,"ا",2,0],["أم صبح غرته تحت الشعور بدا","في غيهب الليل يبدي موقع اللثم",40,"م",1,0],["أمصطبح بدجلة لي صبوحاً","يغار غبوقه من منتشيه",41,"ي",2,1],["أمصورٌ يمحو بريشته","صوراً ويبدع صورة أخرى",42,"ر",2,0],["أم صبيح أتى الرياض صباحا","فتعاطى مع الصباح كؤوسا",43,"س",2,0],["أَمصوّراً ما في الوجو","د بقضّه وَقضيضهِ",44,"ض",2,0],["أمصر ربوع العيش منك زواهر","ولكن ربوع الفضل فيك مواحل",45,"ل",1,0],["أمصطبر أنت ان فوّضوا","وأموا المصيف من المربع",46,"ع",1,1],["أَم صَيَّرت في والدَيكَ مَحَبَّةً","فَهُما بِما يُرضيكَ مُغتَبِطانِ",47,"ن",1,0],["أم صغته من نظرة الم","حبوب في قلب المحب",48,"ب",1,0],["أمصدِّقون معذبو","ن فكيف حال الكافرينا",49,"ن",2,0],["أم صبوة ابن أبي","تعروك وقتاً ووقتا",50,"ت",2,0],["أم صوْتُ صَادِحةٍ على ميَّاسةٍ","صدحتْ فنازعها النياحةَ صَادحُ",51,"ح",1,0],["أم صبح فرق تحت ليل الجعد","وذا عذار زان صحن وجته",52,"ه",1,0],["أم صارم لكل صب يشهر","أم سهم قوس للمنايا يوتر",52,"ر",1,0],["ام صفات الرضا تجلت فشمنا","انجما من ثواقب النجم انجم",53,"م",1,0],["أمصرعُه ببيتِ الدين يومَ","الخميسِ وقد تولى للزوالِ",54,"ل",1,0],["أمصبَّ الزيوتِ وهو حياةٌ","يُحْرَمُ الظامئُ القِوى منه وِردا",55,"د",2,0],["أمصر عطاء الله هلَّ سروره","ودهرك طوع ما أراد محمد",56,"د",1,0],["أم صرخةُ الايتامِ في رأدِ الضُحى","ضجّتْ حُفاةً من لهيبٍ ألهَما",57,"م",2,0],["أم صِرتَ تُمْني النفسَ ان تَبقى كَمن","كذبا يُمنّيها بما لا يَحدِثُ !!؟",58,"ث",1,0],["أمصّ منك لساناً مصه لفمي","أشهى عليّ من الدنيا وما فيها",59,"ي",3,0],["أم صغار الأسماك وهي ضعاف","ذاد عنها كبارها الأقوياء؟",60,"ا",2,0],["أمصّ ثمادي والبحار غزيرة","لئلّا يرى عندى لقوم صنائع",61,"ع",1,0],["أم صوت طفلٍ إذْ بكى في مسمعكْ؟","ياقلبُ كم من بائسٍ بتوجعكْ",62,"ك",1,0],["أمُصحّرٌ يبقى بلا أملٍ؟","لاغيثَ يُحيي القلب في النشرّة",63,"ر",2,0],["أمْ صَحا بقَلبي غَرامٌ قديمٌ","برياح ٍقُدْسِيَّةٍ فاحْتَواكِ؟",64,"ك",1,0],["أم صل حواء بالتفاح كافأني","وهو الذي أمس بالتفاح أغواها",65,"ا",1,0],["أم صار عقل الناس قفراً خاوياً","وغدت تذوب حقوقهم بجفاها",66,"ا",3,0],["أمٌّ صديقته طوال حياتها","جعلت له شمَّ الجبال مطايا",67,"ا",3,0]]}