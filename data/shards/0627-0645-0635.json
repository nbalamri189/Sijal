{"poems":[[72,"دعاه لذكر الحمى مذهب","https://www.aldiwan.net/poem18271.html","المتقارب"],[51,"يا ذا الذي قد حال عن عهدي","https://www.aldiwan.net/poem61903.html","السريع"],[89,"جثمانه هذا فاين المنطق","https://www.aldiwan.net/poem44775.html","الطويل"],[66,"أبت الوصال مخافة الرقباء","https://www.aldiwan.net/poem38501.html","الكامل"],[66,"فيروزج الصبح أم يا قوتة الشفق","https://www.aldiwan.net/poem41544.html","البسيط"],[90,"شممت تربك لا زلفى ولا ملقا","https://www.aldiwan.net/poem60156.html","عموديه"],[74,"بما حزته من شريف النظام","https://www.aldiwan.net/poem13262.html","المتقارب"],[105,"أعلى المآتم تخفق الأعلام","https://www.aldiwan.net/poem42080.html","الكامل"],[76,"أمصباح هذا الدين بعد نبينا","https://www.aldiwan.net/poem39271.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39643","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16686","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54559","الكامل"]],"verses":[["أمصرُ سقتكِ غوادِي السرور","وجادَكِ من أفقها صيب",0,"ب",1,0],["أم صُنْتني عن سَقْي دَسْتيجَةٍ","أم لم يساعدني بها جَدِّي",1,"د",2,0],["أم صنتَ مقدارَك عن أن تُرَى","تُهْدي حقيراً في الذي تُهْدي",1,"د",2,0],["أمصور الارواح بعد جسومها","صور اذا ما اسطعت روحك تزهق",2,"ق",1,0],["أَمُصيبَةً مِنّا بِنَبلِ لِحاظِها","ما أَخطَأَتهُ أَسِنَّةُ الأَعداءِ",3,"ا",2,0],["أَم صارِمُ الشَرقِ لَمّا لاحَ مُختَضِباً","كَما بَدا السَيفُ مُحمَرّاً مِنَ العَلَقِ",4,"ق",1,0],["أَم صامِدَيْنِ يَرُبَّانِ المَصيرَ مَعاً","حُبَّاً ويَقْتَسِمانِ الأَمْنَ والفَرَقا",5,"ق",2,0],["أَمُصُّ مَراشِفَها لَوعَةً","وَأَذكُرُ مابَينَنا مِن ذِمامِ",6,"م",1,0],["أَمَصارعَ الشُّهداءِ أين دماؤُهم","وَهَلِ اشْتَفَى مِنها ومنكِ أَوامُ",7,"م",1,0],["أمِصباحَ هذا الدين بعدَ نبيّنا","ومَن نُورهُ في الشرقِ والغربِ ساطعُ",8,"ع",1,1],["أم صاحبا سفَرٍ مال الضَّنَى بهما","حوَتهما جنّةٌ للفنِّ معطارُ",9,"ر",1,0],["أمْ صالحاتُ البَناتِ إضْنَ بها","زِيادَةً في الرِّعَاثِ والخَدَم",10,"م",1,0],["أَمْ صَرَّحْتْ نُذُرُ المَشِي","بِ وَظَلَّ يُنْكِرُهَا الشَّبَابُ",11,"ب",1,0]]}