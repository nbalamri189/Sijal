{"poems":[[72,"دعاه لذكر الحمى مذهب","https://www.aldiwan.net/poem18271.html","المتقارب"],[51,"يا ذا الذي قد حال عن عهدي","https://www.aldiwan.net/poem61903.html","السريع"],[89,"جثمانه هذا فاين المنطق","https://www.aldiwan.net/poem44775.html","الطويل"],[66,"أبت الوصال مخافة الرقباء","https://www.aldiwan.net/poem38501.html","الكامل"],[66,"فيروزج الصبح أم يا قوتة الشفق","https://www.aldiwan.net/poem41544.html","البسيط"],[90,"شممت تربك لا زلفى ولا ملقا","https://www.aldiwan.net/poem60156.html","عموديه"],[74,"بما حزته من شريف النظام","https://www.aldiwan.net/poem13262.html","المتقارب"],[105,"أعلى المآتم تخفق الأعلام","https://www.aldiwan.net/poem42080.html","الكامل"],[76,"أمصباح هذا الدين بعد نبينا","https://www.aldiwan.net/poem39271.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39643","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16686","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54559","الكامل"],[123,"سائل بغرته الهلال المقمرا","https://www.aldiwan.net/poem4089.html","الكامل"],[164,"تلك الجنان قطوفهن دوان","https://www.aldiwan.net/poem46838.html","الكامل"],[167,"كره الله ما أحب الأعادي","https://www.aldiwan.net/poem1621.html",""],[179,"أمصعب قد نجوت من الأعادى","https://www.aldiwan.net/poem59094.html","الوافر"],[210,"خليدة ذاب القلب من حر شوقكم","https://www.aldiwan.net/poem37854.html","الطويل"],[227,"لجوا فلج غرامي فيك إذ عذلوا","https://www.aldiwan.net/poem50851.html","البسيط"],[259,"متى يستفيق الدهر من غفلانه","https://www.aldiwan.net/poem38140.html","الطويل"],[268,"لأبي عبيدة في دمشق وخالد","https://www.aldiwan.net/poem35645.html","الكامل"],[283,"أمصر طربت لكن ليس هذا","https://www.aldiwan.net/poem39414.html","الوافر"],[362,"غير العدا بسيوفكن قتيل","https://www.aldiwan.net/poem60807.html","الكامل"],[429,"مولاي عبدك يشتكي","https://www.aldiwan.net/poem12546.html","مجزوء الكامل"],[436,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[451,"الفتنة الكبرى تطل قرونها","https://www.aldiwan.net/poem61287.html","الكامل"],[538,"إذا مطمع يوما غزاني غزوته","https://www.aldiwan.net/poem56860.html","الطويل"]],"verses":[["أمصرُ سقتكِ غوادِي السرور","وجادَكِ من أفقها صيب",0,"ب",1,0],["أم صُنْتني عن سَقْي دَسْتيجَةٍ","أم لم يساعدني بها جَدِّي",1,"د",2,0],["أم صنتَ مقدارَك عن أن تُرَى","تُهْدي حقيراً في الذي تُهْدي",1,"د",2,0],["أمصور الارواح بعد جسومها","صور اذا ما اسطعت روحك تزهق",2,"ق",1,0],["أَمُصيبَةً مِنّا بِنَبلِ لِحاظِها","ما أَخطَأَتهُ أَسِنَّةُ الأَعداءِ",3,"ا",2,0],["أَم صارِمُ الشَرقِ لَمّا لاحَ مُختَضِباً","كَما بَدا السَيفُ مُحمَرّاً مِنَ العَلَقِ",4,"ق",1,0],["أَم صامِدَيْنِ يَرُبَّانِ المَصيرَ مَعاً","حُبَّاً ويَقْتَسِمانِ الأَمْنَ والفَرَقا",5,"ق",2,0],["أَمُصُّ مَراشِفَها لَوعَةً","وَأَذكُرُ مابَينَنا مِن ذِمامِ",6,"م",1,0],["أَمَصارعَ الشُّهداءِ أين دماؤُهم","وَهَلِ اشْتَفَى مِنها ومنكِ أَوامُ",7,"م",1,0],["أمِصباحَ هذا الدين بعدَ نبيّنا","ومَن نُورهُ في الشرقِ والغربِ ساطعُ",8,"ع",1,1],["أم صاحبا سفَرٍ مال الضَّنَى بهما","حوَتهما جنّةٌ للفنِّ معطارُ",9,"ر",1,0],["أمْ صالحاتُ البَناتِ إضْنَ بها","زِيادَةً في الرِّعَاثِ والخَدَم",10,"م",1,0],["أَمْ صَرَّحْتْ نُذُرُ المَشِي","بِ وَظَلَّ يُنْكِرُهَا الشَّبَابُ",11,"ب",1,0],["أَم صَدرُ غانِيةٍ تَمَزَّقَ جَيبُها","فَغَدَت تَحُوكُ الوَشي فيهِ مُصَوّرا",12,"ر",2,0],["أم صُدغُ مَعشوقٍ تَصَوْلَجَ مسكُهُ","من وردِ وَجنَتهِ على ميدانِ",13,"ن",1,0],["أَم صِيامٌ يَتلوهُ طولُ قِيامٍِ","فَهوَ في الدَهرِ ساهِرُ الطَرفِ صادِ",14,"د",1,0],["أَمُصعَبُ قد نَجَوتَ مِنَ الأعادى","ولم تُصبح بِمُعتَرَكٍ قتيلا",15,"ل",2,1],["أمصُّ ثغورَ الخُود مهما يَلذُّ لي","وقد مالَ بي بعد الصَّبُوحِ غُبُوقُ",16,"ق",1,0],["أَمْ صدَّه وجِلاً أَمْ دَمْعَه خَضِلاً","أَمْ شَعْرُه رَجِلاً أمْ خَطْوَه كَسِلاَ",17,"ل",2,0],["أمصباحنا والدهر داج ولا أرى","مصابيح هذا الدهر غير هداته",18,"ت",2,0],["أمصيرُهم يوماً يكونُ مصيرَنا","ولنا على الأطلالِ حَسرةُ فاقد",19,"د",1,0],["أمصر طربت لكن ليس هذا","بكافينا لدى العيد الجديد",20,"د",1,1],["أمُصرِّفَ الأقلامِ وهْي دقيقةٌ","يَكْفي بهنَّ الخَطْبَ وهْو جليل",21,"ل",1,0],["أم صحّ ما قال الوُشا","ةُ بما استرابَ به اعتِقادُك",22,"ك",1,0],["أَمْصُّ من الكافورِ مِسْكاً وأَجتَنِي","من الوَشْيِ رُمَّاناً زَهتْهُ المقادِمُ",23,"م",1,0],["أم صادق التاريخ وهو مدون","آثامكم إن فاتكم تدوينها",24,"ن",3,0],["أَمصُّ ثِمادي وَالمياهُ كَثيرَةٌ","أُعالِجُ مِنها حَفرَها واِكتِدادَها",25,"د",3,0]]}