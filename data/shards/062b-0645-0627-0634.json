{"poems":[[88,"بكرا صاحبي يوم الإياب","https://www.aldiwan.net/poem68952.html","الخفيف"],[95,"كيف قوضت يا علم","https://www.aldiwan.net/poem11343.html","مجزوء الخفيف"],[53,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[64,"حكماؤنا وصفوا لنا صنما","https://www.aldiwan.net/poem52165.html","أحذ الكامل"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42628","البسيط"],[146,"من علم القلب ما يملى من الغزل","https://www.aldiwan.net/poem58449.html","البسيط"],[376,"كنت من قبل أن تلقب كالبد","https://www.aldiwan.net/poem57400.html","الخفيف"],[581,"لكنه حوض من أودى بإخوته","https://www.aldiwan.net/poem1793.html","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77479","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46508","الرجز"],[2081,"","https://poetry.dctabudhabi.ae/diwan/poem/146932","البسيط"],[2212,"","https://poetry.dctabudhabi.ae/diwan/poem/202379","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109448","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46984","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59510","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111420","البسيط"],[4767,"تجارة خاسرة","https://www.poetsgate.com/ViewPoem.aspx?id=179991",""]],"verses":[["ثُمَّ أَشرَقتَ في المَنارِ عَلَينا","بَينَ نورِ الهُدى وَنورِ الصَوابِ",0,"ب",1,0],["ثُمَّ أَشْكُو مُفَجَّعاً","مَا أُعَانِي مِنَ الأَلَمْ",1,"م",1,0],["ثم أشكو إليك جَدْبِيَ والمرْ","عَى مَريعٌ والماء صَافٍ شروبُ",2,"ب",1,0],["ثم اشوه بالرفق مبتدئاً","فيصير كلساً ما له جرمُ",3,"م",1,0],["ثُمَّ اِشرَأَبَّت لِخَفرِ العَهدِ مِن سَفَهٍ","بَنُو النَّضيرِ فَأَجلاهُم عَنِ الأُطُمِ",4,"م",1,0],["ثُمَّ اشْرَأَبَّتْ فَأَلْفَتْ طَائِرَاً حَذِراً","عَلَى قَضِيبٍ يُدِيرُ السَّمْعَ وَالْبَصَرَا",5,"ر",2,0],["ثم اشتَمَلْتَهُمُ الصَّماَءَ فانشعبوا","أيدِى سَبَا في بطون السهل والجبلِ",6,"ل",1,0],["ثم أشكَلتُما عليَّ بأن صِر","تَ تُسمى كما يُسمَّى مُنيرا",7,"ر",2,0],["ثُمَّ اِشتَكَيتُ لَأَشكاني وَساكِنُهُ","قَبرٌ بِسِنجارَ أَو قَبرٌ عَلى قَهَدِ",8,"د",1,0],["ثُمَّ أَشارَ بعدُ بِالأَصابِعِ","مِن بَينِهم إِلى النصيب الرابع",9,"ع",1,0],["ثُمَ أَشارَ أَن خذوه فاخذ","وَقامَ مِن بَين يَديهِ وَجبذ",10,"ذ",1,0],["ثمَّ اشتراها أبو خاقان حين عَسَت","فالتقطت نُطْفَةً منه بأقطانِ",11,"ن",1,0],["ثم اشتملت أهاويشا تغيرهم","عليه ليلا ويوما غير محتشم",12,"م",1,0],["ثم اشتغلت بمدح ذي شرف","إذ كان لي بصفاته خبر",13,"ر",1,0],["ثُمَّ اشتُمِ الحَشوِيَّ حَشوَ الدينِ وال","قُرآنِ وَالآثَارِ وَالإِيمَانِ",14,"ن",1,0],["ثم اشتمل شرقا الى البلاط","فانه حل بذا الرباط",15,"ط",1,0],["ثم اشتمل نحو قبور البخت","وزرهم تفز بحسن البخت",15,"ت",1,0],["ثُم اشْفَعُوا لِي فَالشَّفاعَةُ عِنْدَهُ","فِيهَا أُبَوَّأُ رُتبَة الأَبْرَارِ",16,"ر",1,0],["ثم اشمعلَّ يشقُّ في","وجفانه ثوبَ الرغامِ",17,"م",1,0],["ثُمَّ اشتَوَوهُ وهَبُّوا للطَّعام ولم","يَكُن بِهِم قطُّ شاكٍ لم يَنَل جُعَلا",18,"ل",2,0],["ثم اشترى ما بِعتَه","أغلى النفائس عقلَكا",19,"ك",2,0]]}