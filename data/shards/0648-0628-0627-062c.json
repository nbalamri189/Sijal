{"poems":[[438,"قف بقفراء يباب","https://www.aldiwan.net/poem12547.html","مجزوء الرمل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122665","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/78024","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27163","الرمل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101347","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136538",""],[4501,"","https://poetry.dctabudhabi.ae/diwan/poem/143310","السريع"],[2220,"بأثيلاتِ النَّقا سربُ قطا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19287&r=&rc=829",""]],"verses":[["وبأجيادٍ كأجيا","دِ ظباءٍ في شِعابِ",0,"ب",1,0],["وبأجرَعِ السَّرحاتِ قَبرٌ بُورِكَت","سَرَحاتُ أجرُعِهِ وَبُورِكَ أجرُعا",1,"ع",2,0],["وباجتناب كثرة الآثام","فرفعوا إلى المحل السامي",2,"م",2,0],["وَبِأَجوازِ الفَلا مِن إِضَمٍ","نَعَمٌ تَرعى عَلَيها وَظِبا",3,"ب",2,0],["وباجماع أمة الفضل اضحى","لك سر من الحيا ليس يخرق",4,"ق",1,0],["وباجفانه سِهامُ المَنايا","من قريبٍ تصمى الحَشا وبعيد",5,"د",1,0],["وباجتماع الشَّمل يقضي لنا","من كان بالبين علينا قضى",6,"ض",2,0],["وبأجوازِ الفلا من إضمٍ،","نعمٌ ترعى لديها وظبا",7,"ب",2,0]]}