{"poems":[[93,"أمر من يطلب الخلود عسير","https://www.aldiwan.net/poem9165.html","الخفيف"],[91,"خير ما يكتبه ذو مرقم","https://www.aldiwan.net/poem8865.html","عموديه"],[69,"قال شريف جفنه","https://www.aldiwan.net/poem28331.html","مجزوء الرجز"],[91,"الشاعر والأمة","https://www.poetsgate.com/ViewPoem.aspx?id=53088",""],[328,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[348,"صدقوا قد نظروا الورد مسيج","https://www.aldiwan.net/poem19932.html","الرمل"],[349,"أقبل صبحي وسفر","https://www.aldiwan.net/poem15721.html","مجزوء الرجز"],[366,"ما معالشيب حديث في غزل","https://www.aldiwan.net/poem17387.html","الرمل"]],"verses":[["قال شيئاً مما أراد حبيب","وتغني بما تسنى الضرير",0,"ر",1,0],["قالَ شَيخٌ مِنهُم مُحدَودِبٌ","وَدُموعُ اليَأسِ تَغشى بَصَرَه",1,"ر",2,0],["قالَ شريفٌ جفنُهُ","كذا الفقارِ الباترِ",2,"ر",1,1],["قال شيخ منهم محدوب","ودموع اليأس تغشى بصره",3,"ر",2,0],["قال شيخٌ لزوجه ذات يوم","داعياً صانك الإله القدير",4,"ر",1,0],["قَالَ شِعْرٌ لكَ أَمْ دُرٌّ علَى","أَنَّهُ أَبْهَى مِن الدُّرِّ وَأَبْهَجْ",5,"ج",1,0],["قالَ شَهيدٌ عامِرُ ال","فَضلِ لَهُ قُلتُ عَمَر",6,"ر",1,0],["قالَ شَلَّت وَاِدِّعاها دَعوَةَ","وَالَّذي يَدعو بِقَلبٍ لا شَلَل",7,"ل",1,0]]}