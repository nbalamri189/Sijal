{"poems":[[95,"أمر من يطلب الخلود عسير","https://www.aldiwan.net/poem9165.html","الخفيف"],[93,"خير ما يكتبه ذو مرقم","https://www.aldiwan.net/poem8865.html","عموديه"],[71,"قال شريف جفنه","https://www.aldiwan.net/poem28331.html","مجزوء الرجز"],[93,"الشاعر والأمة","https://www.poetsgate.com/ViewPoem.aspx?id=53088",""],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[353,"صدقوا قد نظروا الورد مسيج","https://www.aldiwan.net/poem19932.html","الرمل"],[354,"أقبل صبحي وسفر","https://www.aldiwan.net/poem15721.html","مجزوء الرجز"],[371,"ما معالشيب حديث في غزل","https://www.aldiwan.net/poem17387.html","الرمل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63790","الرمل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77564","المجتث"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26654","الخفيف"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111273","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100229","الطويل"],[2971,"","https://poetry.dctabudhabi.ae/diwan/poem/199869","الخفيف"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118942","الرمل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44680","الخفيف"],[4757,"قَالَ محبوبي بقدي","https://www.poetsgate.com/ViewPoem.aspx?id=189299",""],[4797,"يالعقاب","https://www.poetsgate.com/ViewPoem.aspx?id=51280",""],[4811,"الى البردوني ورحمة الله","https://www.poetsgate.com/ViewPoem.aspx?id=198338",""],[5056,"<< هذيانُ شاعر..>>","https://www.poetsgate.com/ViewPoem.aspx?id=33175",""],[5302,"يا غويا","https://www.poetsgate.com/ViewPoem.aspx?id=201064",""],[5409,"قال شيخ لو أن عصر شبابي","https://www.poetsgate.com/ViewPoem.aspx?id=155275",""],[5952,"عاشوا","https://www.poetsgate.com/ViewPoem.aspx?id=211568",""]],"verses":[["قال شيئاً مما أراد حبيب","وتغني بما تسنى الضرير",0,"ر",1,0],["قالَ شَيخٌ مِنهُم مُحدَودِبٌ","وَدُموعُ اليَأسِ تَغشى بَصَرَه",1,"ر",2,0],["قالَ شريفٌ جفنُهُ","كذا الفقارِ الباترِ",2,"ر",1,1],["قال شيخ منهم محدوب","ودموع اليأس تغشى بصره",3,"ر",2,0],["قال شيخٌ لزوجه ذات يوم","داعياً صانك الإله القدير",4,"ر",1,0],["قَالَ شِعْرٌ لكَ أَمْ دُرٌّ علَى","أَنَّهُ أَبْهَى مِن الدُّرِّ وَأَبْهَجْ",5,"ج",1,0],["قالَ شَهيدٌ عامِرُ ال","فَضلِ لَهُ قُلتُ عَمَر",6,"ر",1,0],["قالَ شَلَّت وَاِدِّعاها دَعوَةَ","وَالَّذي يَدعو بِقَلبٍ لا شَلَل",7,"ل",1,0],["قال شِمْ كفَّ أبي قاسِمِنا","فبحارُ الرّاحِ فيها زاخِره",8,"ر",2,0],["قالَ شيل مَعي إِيش ما كان","قالَ روح ما لك وَما لي",9,"ي",1,0],["قال شبهه قلت صدر حسود","خالطته مكارم المحسود",10,"د",1,0],["قال شمر عرفت هذا ولكن","قتلك اليوم يابن طاها مرامي",11,"م",2,0],["قال شمر ما للجنان ومالي","بل عطايا يزيد والأنعام",11,"م",1,0],["قال شعاع الآل في رونق الضحى","ترقرق ماء طافح فتجوب",12,"ب",1,0],["قَالَ شَخْصِيِ لِشَخْصِهِ سَيِّدِي زُرْ","تَ كَأَنَّا كُنَّا عَلىَ مِيعاِد",13,"د",1,0],["قال شام أم يمان","أنت أم غربي الجهاتِ",14,"ت",1,0],["قالَ شَوقي في مثل ذاتيَ حُسناً","خَدَعوها بِقَولَهُم حَسناءُ",15,"ا",2,0],["قَالَ شبهه بحقي","قلت لَا يُشْرك وجدي",16,"د",2,0],["قال شفت الموت لو بيدي ماهو كفو ...لخذاني","بس لاتشره علي لو لبسوني غصب ...حله",17,"ل",2,0],["قال شيئا عن عاشقين حيارا","في دجى الليل يعزفون الصباحا",18,"ح",2,1],["قال :- شاعر . قلتُ :- مُوثوقاً ، وجائل","قال :- ما البحر لزاماًغير سائل",19,"ل",1,1],["قال شيئا بغمزة وتخطى","فوق أرضي وساقني حين قاله",20,"ل",2,0],["قال شيخ لو أن عصر شبابي","عاد لي اليوم عشته كأمير",21,"ر",1,1],["قال شيخٌ كان يهوى خيمةً","بئست الخيمات في السُّكنى خِتاما",22,"م",2,0]]}