{"poems":[[26,"عرفت الديار كرقم الدوا","https://www.aldiwan.net/poem24098.html","المتقارب"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138441",""],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112587","الوافر"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133197",""],[4778,"إذا ما الموت دَانَى لا يَهَابُ","https://www.poetsgate.com/ViewPoem.aspx?id=188139",""],[5129,"تقتلني اليقظة","https://www.poetsgate.com/ViewPoem.aspx?id=151602",""],[5232,"المعلقة السينية الحديثة","https://www.poetsgate.com/ViewPoem.aspx?id=212771",""],[5277,"حسّونُ الصوبين..","https://www.poetsgate.com/ViewPoem.aspx?id=190915",""],[5376,"تئن على فراق الأهل درعا","https://www.poetsgate.com/ViewPoem.aspx?id=189706",""],[5615,"وينشرحون إن نعق الغراب .... !","https://www.poetsgate.com/ViewPoem.aspx?id=196626",""],[6093,"عَلى أَطْلالِ بَعْضِيَ قَامَ بَعْضِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=191508",""]],"verses":[["عَلَى أَطرِقا بالِياتُ الخِيا","مِ إِلّا الثُمامُ وَإِلّا العِصِيُّ",0,"ي",1,0],["على اطوار مقدسنا اخضرارا","وآثار باجلال جريه",1,"ي",2,0],["على أطلالها سكبوا وناحوا","وبعد خرابها لطموا وصاحوا",2,"ح",3,1],["على أطلال أصحاب السرايغ","وأرباب الصوافن والدوابر",3,"ر",1,0],["على أطلال من بادوا بنينا","على آثارنا يُبنى الخراب",4,"ب",1,0],["على أطرافِ فجري نجمتاها","توقَّدَتا بذكرى من سَناها",5,"ا",3,1],["على أطلال من نهوى ندوسُ","ونبكي واقفينَ متى الجلوسُ ؟!",6,"س",1,1],["على أطلالِها هدلتْ وناحتْ","حمائمُ أهلها والشوقُ وسْمُ",7,"م",1,0],["على أطلالها تشدو حمام","بما قد ودعت بالشوق ربعا",8,"ع",2,0],["عَلى أَطلالِهمْ جَادَتْ عُيُونُُ","بِأَدمُعِها ، كَمَا جَادَ السَّحَابُ",9,"ب",1,0],["عَلى أَطْلالِ بَعْضِيَ قَامَ بَعْضِيْ","وَيَبْكي الشَّيْبُ أَطْلالَ الشَّبَابِ",10,"ب",1,0]]}