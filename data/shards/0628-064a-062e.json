{"poems":[[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38351","الخفيف"],[4908,"كومة الأوجاع","https://www.poetsgate.com/ViewPoem.aspx?id=207314",""],[5101,"قلق","https://www.poetsgate.com/ViewPoem.aspx?id=202971",""],[5277,"أعدو إلى عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=197627",""]],"verses":[["بيَ خالٌ بِخَدِّهِ قَد تَبدّى","وَدَنا مِن عِذارِهِ السندسِ",0,"س",1,1],["بِي خَوْفُ مُوسَى أيَا أُمَّاه لِي وَطَنٌ","مِنْ الجِرَاحَاتِ وَالآهَاتِ وَالحَنَقِ",1,"ق",1,0],["بي خَوفُ صاحِبِ غارِهِ ورُؤى","زرقاءُ فيها الصّوتُ يختنقُ",2,"ق",1,0],["بي خوفُ شمسٍ قدْ تفارقُ ظلَّها","أنا ريثما يشتدُّ عودي أغربُ",3,"ب",1,0]]}