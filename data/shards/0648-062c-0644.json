هور خفيه",242,"ي",2,0],["وجلتنا يد العناية في الكو","ن شموساً لماعةً للوجود",243,"د",1,0],["وجَلى بالإِعْزازِ وَحْشَةَ مُوسى","حينَما فَرَّ لا بِظِلِّ وَلِيِّ",244,"ي",1,0],["وجَلالٍ طَوى صُنوفَ نَوالٍ","أَسْكَرَتْني بكأْسِها المَدَنِيِّ",244,"ي",1,0],["وجَلَتْني يدُ العِنايَةِ بدراً","قد تعالى مَرْقاهُ عن كيوَانِ",245,"ن",1,0],["وجَلا في مَعاني","حجِّهِ حكْماً وصَومِهْ",246,"م",2,0],["وجَلَتْهُ من شَيْخونَ كوكَبَ سَمكِها","فأَضاءَ في الأَكوانِ دونَ تسلُّلِ",247,"ل",1,0],["وجَلا في البِيدِ شمساً أَثبَتَتْ","بعُيونِ القَوْمِ منه مَشْهَدَا",248,"د",2,0],["وجلَتْ فينا أَفانينَ الجَلالْ","فطوَتْ في وسْطِ الصَّيفِ الرَّبيعْ",249,"ع",1,0],["وجِلاً يظنّ النومَ لَمْعَ سُيوفهِ","ويرى نُجومَ الليلِ منْ خِرْصانهِ",250,"ن",2,0],["وجلَتْ لنا من تحت مِسكةِ خالِها","كافورَ فجرٍ شقَّ ليلَ العنْبرِ",251,"ر",1,0],["وجلَوْا بتيجانِ التّرائِبِ أوجُهاً","لو قابلَتْ جيشَ الدُّجنّةِ لاِنْثَنا",252,"ن",2,0],["وجَلَتْ بظُلمةِ فرعِها شمسَ الضُحى","فمَحا نهارُ الشّيبِ ليلَ قَذالِ",253,"ل",1,0],["وجلّى رونقُ البُشْرى هِلالاً","تصدّى كالحُسام بلا قِرابِ",254,"ب",1,0],["وجلوت صفحة مجده بمدائح","يصقلن من صدأ السماح الداثر",255,"ر",1,0],["وجلوت من تحت المظلة غرة","يبدو عليها التاج والإكليل",256,"ل",1,0],["وجلوا بنور العدل كل ظلامة","فما أن ترى في الناس من متظلم",257,"م",1,0],["وَجَلل العَرش بِالأَنوار وَاِتشَح ال","كُرسي وَزخرف فردوسٌ وَجنات",258,"ت",1,0],["وَجَلا علاه حِينَ أَمّ الأَنبيا","وَأَقام جبرائيل مِن وزرائِهِ",259,"ا",3,0],["وجَلَّى بِمضْمارِ الفَضائِلِ والتُّقَى","عَلَى مَنْهَجٍ لَمْ يَعْدُ صَوْبَ سَدادِ",260,"د",1,0],["وجُلْ إنَّ الْمَجالَ طَويلُ ذَيْلٍ","وكُنْ في الكائِناتِ مِنَ الْمُشَاةِ",261,"ه",1,0],["وَجَلِّى بِمضْمارِ السّباقِ وقَصَّرَتْ","لَدَى شَوْطِهِ أَبْنَا لُؤَيِّ بنِ غالِبِ",262,"ب",1,0],["وَجَلَت لنا ذهبيةً في الكأسِ مِن","كفٍّ بِلونِ إنائِها مخضُوبِ",263,"ب",1,0],["وجَليدُ الرّكبِ يوماً","ثَمِلٌ لا يستفيقُ",264,"ق",1,0],["وَجليدُ الرّجال إنْ واجهوه","غَبِن اللّحْظَ من حِذارٍ وغضّا",265,"ض",2,0],["وجليلاً معظّماً كان للآ","مالِ فيه التّرحيبُ والتَّرشيحُ",266,"ح",1,0],["و