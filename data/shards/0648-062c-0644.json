5,"هذا العقيق وتلك شم رعانه","https://www.aldiwan.net/poem20784.html","الكامل"],[515,"خفرت بسيف الغنج ذمة مغفري","https://www.aldiwan.net/poem20789.html","الكامل"],[515,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[515,"سفرت فبرقعها حجاب جمال","https://www.aldiwan.net/poem20814.html","الكامل"],[515,"أفي طي الصبا نشر التصابي","https://www.aldiwan.net/poem20824.html","الوافر"],[516,"هنئت مفتتح الصيام السافر","https://www.aldiwan.net/poem12120.html","الكامل"],[516,"إن حارت الأفكار كيف تقول","https://www.aldiwan.net/poem12199.html","الكامل"],[516,"ولاؤك مفروض على كل مسلم","https://www.aldiwan.net/poem12246.html","الطويل"],[525,"الله أكبر كم وافت بشارات","https://www.aldiwan.net/poem13287.html","البسيط"],[525,"وولد الحبيب فمرحبا بوفائه","https://www.aldiwan.net/poem13288.html","الكامل"],[530,"وفود حبيب أم ورود عهاد","https://www.aldiwan.net/poem37457.html","الطويل"],[530,"لعمري أنت بعض الترهات","https://www.aldiwan.net/poem37499.html","الوافر"],[530,"أيا بين كم كدرت صفو المشارب","https://www.aldiwan.net/poem37536.html","الطويل"],[539,"نظرت بلحظ بالقلوب لعوب","https://www.aldiwan.net/poem48277.html","عموديه"],[552,"شاقك البرق اليماني","https://www.aldiwan.net/poem47375.html","مجزوء الرمل"],[552,"هل مجير من غصة ما تقضى","https://www.aldiwan.net/poem47736.html","الخفيف"],[552,"يا ابن عبد العزيز إن فؤادي","https://www.aldiwan.net/poem47900.html","الخفيف"],[554,"كتاب فتى أخى كلف طروب","https://www.aldiwan.net/poem68408.html","الوافر"],[559,"هو العظيم الذي علا شانه","https://www.aldiwan.net/poem33693.html","المنسرح"],[559,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"],[559,"شمعتي أشرقت بنورك ربي","https://www.aldiwan.net/poem34431.html","الخفيف"],[559,"معان بدت فينا حروف سطورها","https://www.aldiwan.net/poem34471.html","الطويل"],[559,"ترنمت المثاني والمثالث","https://www.aldiwan.net/poem34697.html","الوافر"],[559,"أنا عندي أن الشهود حجاب","https://www.aldiwan.net/poem34967.html","الخفيف"],[560,"كشف المحبوب عن قلبي الغطا","https://www.aldiwan.net/poem69334.html","الرمل"],[568,"رذال قوم أباحوا لومهم شرفي","https://www.aldiwan.net/poem69607.html","البسيط"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[574,"تلهي العيون رقومه فكأنها","https://www.aldiwan.net/poem3655.html","الكامل"],[576,"وجلنار على غصون","https://www.aldiwan.net/poem2739.html","مخلع البسيط"],[576,"أحسنتم إن تحسنوا في الفعل","https://www.aldiwan.net/poem3038.html","الرجز"],[587,"أأخاف صرف الدهر أم حدثانه","https://www.aldiwan.net/poem17502.html","الكامل"]],"verses":[["وَجَلجَلَها عَلى الأَهوازِ حَتّى","أَعادَ زَئيرَ أُسدِكُمُ أَنينا",0,"ن",2,0],["وَجَلَّلوا مَيسَ الرِحا","لِ بِالشُعورِ وَالجُمَم",1,"م",1,0],["وجلا للأرض أسرار السما","وتراءى في فم الكون ابتساما",2,"م",2,0],["وَجَلاَ الأَنْوَارَ بُرْهَا","ناً بِخُلْفٍ وَافْتِراضِ",3,"ض",1,0],["وَجَلاَ صَدَى هَمِّي وَأَدْ","هَمَهُ بَشَأْوِ النَّفْسِ جَائِلْ",4,"ل",1,0],["وجَلالِ الإلاهِ لوْ كانَ فيها","حاضِراً ما زَهَتْ بخَيْرٍ دارُ",5,"ر",1,0],["وجُلْ فوْقَ سَرْجي واجْعَلِ الوَصْلَ","غايَتي فإنّي للّذّاتِ خيْرُ جَوادِ",6,"د",1,0],["وجَلّتْ تِجارُ الرَّيْعِ كُلَّ بِضاعَةٍ","تُقرُّ لَها صَنْعاءُ بالفضْلِ والهِنْدُ",7,"د",1,0],["وجَلا عَلَيّ الرّاح في أكْواسِها","فشَرِبْتُها صِرْفاً بغَيْرِ مِزاجِ",8,"ج",1,0],["وَجَلَّ زَبَرجَدَةٌ فَوقَهُ","وَياقوتَةٌ خِلتَ شَيئاً نَكيرا",9,"ر",2,0],["وَجُلُنداءَ في عُمانَ مُقيماً","ثُمَّ قَيساً في حَضرَمَوتَ المُنيفِ",10,"ف",1,0],["وَجَلَوتَ مِرآةَ العَروضِ صَقيلَةً","لِلنيلِ فَاِستَوجَبتَ شُكرَ النيلِ",11,"ل",1,0],["وَجَلَتها حِكمَةً بالِغَةً","أَعجَزَت أَطواقَ أَهلِ المَغرِبِ",12,"ب",1,0],["وَجَلسٍ أَمونٍ تَسَدَّيتَها","لِيَطعَمَها نَفَرٌ جُوَّعُ",13,"ع",1,0],["وَجَلا لَكَ الرِّيفُ الحِلَى مَمْزُوجَةً","بِالظَّاهِرِ الخَافِي مِنَ الأَلْوَانِ",14,"ن",1,0],["وَجَلَتْ فِي بَنَاتِهَا من حِلاَهَا","خَيْرَ مَا رَاعَ فِي النُّهَى وَالْعُيُونِ",15,"ن",1,0],["وَجَلاَ عَنِ الْقَدَرِ المُخَبَّأِ لَيْلَهَا","وَبَدَا الصَّبَاحُ مُقَرَّحَ الأَجْفَانِ",16,"ن",1,0],["وَجَلا النُّبْلُ بَعْدَ وَجْهٍ وُجُوهاً","لِلنَّدَى وَالإِبَاءِ وَالإِقْدَامِ",17,"م",1,0],["وَجَلاَ فَضَائِلَ نَفْسِهِ","فِي رَوْنَقِ الطَّبْعِ النَّبِيلِ",18,"ل",1,0],["وجلّوْها في الروع بيض فِعال","أقرأتهم كتب الفَخار دروسا",19,"س",2,0],["وَجَلا السُيولُ عَنِ الطُلولِ كَأَنَّها","زُبُرٌ تُجِدُّ مُتونَها أَقلامُها",20,"م",3,0],["وَجُلَّنارٍ مُشرِقٍ","عَلى أَعالي شَجَرَه",21,"ر",2,1],["وَجَلَستَ لِلعُهّارِ مَجلِسَ فِتنَةٍ","وَذَمَمتَ عَينَي مومَسٍ بِصُوابِ",22,"ب",1,0],["وجلّيتها يا ابن المجلي ضمينة","خلودَ الفتى إنَّ الثناءَ خلوده",23,"د",2,0],["وجلى همومي جامع البرّ والتقا","بنعماء من بابِ الزيادة تدخل",24,"ل",1,0],["وجلست من شغفٍ أنزِّه ناظري","في ماءِ رونقه وخضرة شكله",25,"ل",2,0],["وجلى ثغور الأرض من قلح العدى","ولم لا وقد جرَّ الأراك من القنا",26,"ن",2,0],["وجَلتْ رأسَهُ نِعمّا فأضحى","بارزَ الصرحِ ما يُوارى صُؤابَهْ",27,"ب",2,0],["وجلود قوم ليس تأ","لم غير أطراف الرماحِ",28,"ح",1,0],["وَجَلا الدُّجُنَّةَ لائحٌ من نوره","كشف الغطاء عن العيون مِلاحهُ",29,"ح",2,0],["وجِلَ القلبُ أن تجيء هناتٌ","من عِجانٍ لا يستفيقُ لُواطا",30,"ط",2,0],["وجِلاً قلبُهُ بلا أخذِ حِذرٍ","غير ما في حشاه من قلقالِ",31,"ل",1,0],["وَجَلالُ لُبنانٍ وَقَد غَمَرَ المَسا","هَضَباتِهِ وَاِنسالَ في الأَدواءِ",32,"ا",2,0],["وَجَلَوتُ لِلأَبصارِ كُلَّ خَريدَةٍ","عَصماءَ تَحسِدُها النُجومُ تَأَلُّقا",33,"ق",2,0],["وَجَلَسَ العُشّاقُ حَولي في السَحَر","عَلى بِساطِ العُشبِ في ضَوءِ القَمَر",34,"ر",1,0],["وَجَليسي يَظُنُّ في الشُهبِ قَصدي","وَأَنا أَحسَبُ الجَليسَ عَناها",35,"ا",3,0],["وَجَليسٍ لَيسَ فيهِ","قَطُّ مِثلَ الناسِ حِسُّ",36,"س",1,1],["وَجَليسٍ حَديثُهُ","لِلمَسَرّاتِ طارِدُ",37,"د",1,1],["وَجَلَسَ الهِرُّ بِجَنبِ الكَلبِ","وَقَبَّلَ الخَروفُ نابَ الذِئبِ",38,"ب",1,0],["وَجَلا الوَداعُ مِنَ الحَبيبِ مَحاسِناً","حُسنُ العَزاءِ وَقَد جُلينَ قَبيحُ",39,"ح",1,0],["وَجَلَبتَ الحِسانَ حُوّاً وَحوراً","آنِساتٍ حَتّى أَغَرتَ النِساءَ",40,"ا",2,0],["وَجُلوسي عَنِ التَصَرُّفِ وَالأَر","ضُ لِمِثلي رَحيبَةُ الأَكنافِ",41,"ف",1,0],["وَجَلالٍ لَو كانَ لِلقَمَرِ البَد","رِ لَما جازَ فيهِ حُكُمُ المُحاقِ",42,"ق",1,0],["وجَلَسَتْ بينَ غُثا وأغثَرِ","فشَرِبا من ثَغرِها المُؤَشَّرِ",43,"ر",1,0],["وَجَلالُهُم ما قَد عَلِمتَ إِذا","أُحلِلتُمُ بِمَخارِمِ الأُكمِ",44,"م",1,0],["وَجَلَوتَ شِعري في المَحافِلِ بَعدَما","أَخفَيتُهُ بِدَفاتِرٍ وَجُزازِ",45,"ز",1,0],["وَجَلاها وَالصُبحُ قَد هَزَمَ اللَي","لَ وَهَمَّ الرِفاقُ بِالتَعريسِ",46,"س",1,0],["وَجَلَونا عَلى الأَهِلَّةِ شَمسَ ال","راحِ بَينَ الشَمّاسِ وَالقِسّيسِ",46,"س",1,0],["وَجَلَونَ مِن صُبحِ الُوجوهِ أَشِعَّةً","غادَرنَ فَودَ اللَيلِ مِنها شائِبا",47,"ب",2,0],["وجلوتَ الظلام حتى تقَضَّى","ما على الكون مسحةٌ من ظلامِ",48,"م",1,0],["وجلوتَ الجمالَ والسحرَ والفجرَ","على ضوءِ ثغرِهَا البسَّامِ",48,"م",1,0],["وجلوتَ الزهورَ تَندَى علينا","فكأني أرى الربيعَ أمامي",48,"م",2,0],["وجلست أنثر جعبة معمورة","بالذكرياتِ جديدها وقديم",49,"م",1,0],["وجليلٌ مُصَابُ أحمدَ لكنْ","يُصْبِرُ النفسَ للجليلِ الجليلُ",50,"ل",1,0],["وجَلَتْ سروجُ الحَلْيِ فوق متونها","سُرُجاً تألّقُ وهي ذاتُ لهيبِ",51,"ب",1,0],["وَجَلا بُردُها وَقَد حَسَرَتهُ","نورَ بَدرٍ يُضيءُ لِلناظِرينا",52,"ن",2,0],["وَجَلَت بَشيرَةُ سُنَّةً مَشهورَةً","دونَ الأَراكِ وَراهِنِ الحَوذانِ",53,"ن",1,0],["وَجَلَت أَسيلاً يَومَ ذي خُشُبٍ","رَيّانَ مِثلَ فُجاءَةِ البَدرِ",54,"ر",1,0],["وَجَلَت عَشِيَّةَ بَطنِ مَكَّةَ إِذ بَدَت","وَجهاً يُضيءُ بَياضُهُ الأَستارا",55,"ر",2,0],["وَجُل في الحَديقَةِ أُختِ المُنى","وَدِن بِالمُدامَةِ أُمِّ الطَرَب",56,"ب",1,0],["وَجَلا الإِمارَةَ في رَقيقِ نَضارَةٍ","جَلَتِ الدُجى في حُلَّةِ الأَنوارِ",57,"ر",1,0],["وجلَّلكِ الظّلامُ وكنتِ نوراً","يَفيضُ على شُعوبِ المُسلِمينا",58,"ن",2,0],["وجَلى جَبِينُ النَّهرِ غُرَّة ظِلِّهِ","قَد جَعَّدتهُ الرّيحُ فَوق شنُونَهُ",59,"ن",2,0],["وجلال الوديان مِلْء الحنايا","وجمال الجبال ملء العيون",60,"ن",1,0],["وَجَلَبنا إِلَيهِمُ الخَيلَ فَاِقتي","ضَ حِماهُم وَالحَربُ ذاتُ اِقتِياضِ",61,"ض",1,0],["وَجُلَّنارٌ مِثلَ جَمرِ الخَدِّ","أَو مِثلُ أَعرافِ دُيوكِ الهِندِ",62,"د",1,0],["وَجَلَّ فَما أَجزيهِ إِلّا بِشُكرِهِ","فَيا لَيتَهُ يَدري بِأَنِّيَ صادِقٌ",63,"ق",1,0],["وَجَلا ظلامَ الظُّلْمِ لَمَّا أوْمَضَتْ","وَمَضَتْ لديْه صحائفٌ وَصَفيحُ",64,"ح",1,0],["وَجلَّلَ الغارَ نَسْجُ العنكبوتِ عَلَى","وَهْنٍ فيا حَبَّذا نَسْجٌ وَتَجْليلُ",65,"ل",1,0],["وَجَلِّ مِقْدَارُ ما وُلِّيتَ مِنْ رُتَبٍ","وعَزَّ إدْرَاكُ ما أُولِيتَ مِنْ نِعَمِ",66,"م",1,0],["وَجُلُّ النَّاسِ خُوَّانٌ وَلكِنْ","أُناسٌ مِنْهُمْ لا يَسْتُرُونا",67,"ن",2,0],["وجَلا ظَلامَ الدِّين والدّنْيا بهِ","مَلِكٌ لما قال الكِرامُ فَعُول",68,"ل",1,0],["وجَلَوْكِ لي إذ نحن غُصْنا بانَةٍ","حتى إذا احتَفَلَ الهوَى حجَبوك",69,"ك",1,0],["وجَلا الفِطْرُ منه عن نَبَوِيٍّ","أبيضِ الوجهِ أبيضِ الأخلاق",70,"ق",1,0],["وجَلَّلَها أسلابَ كلِّ مُنافِقٍ","وكلِّ عنيدٍ قد طغى وتجبَّرا",71,"ر",2,0],["وَجِلدَةٍ تُشبِهُ وَشيَ البُردِ","ظاهِرُها زِفٌّ شَديدُ الوَقدِ",72,"د",1,0],["وَجُلُّ الجُندِ تَحتَ رِكابِ كِسرى","بِأَعمِدَةٍ وَأَقبِيَةٍ قِصارِ",73,"ر",1,0],["وَجَليسٍ كَأَنَّ في وَجنَتَيهِ","كُلُّ حُسنٍ تَصبو إِلَيهِ النُفوسُ",74,"س",1,0],["وَجَلَّدَني عَنها البَريءُ مِنَ الهَوى","وَلَستُ عَلى هِجرانِها بِجَليدِ",75,"د",1,0],["وَجَلَوْا غَمْرَةَ الوَغَى بوُجوهٍ","حَسُنَتْ فهْيَ مَعْدِنُ الإحسانِ",76,"ن",1,0],["وجَلَّ أَنْ تُدْركَهٌ العُيونُ","أَو يَحْوياه الوَهم والظُّنونُ",77,"ن",1,0],["وجلا لي الكون في أعماقه","أعيُناً تبكي دماءً لا دموعا",78,"ع",2,0],["وجلا الوداع من الحبيب محاسناً","حسن العزاء وقد جلبن قبيح",79,"ح",1,0],["وجلا من صُوَرِ الحسنِ لنا","عبقرياً لَبِقَ الفنِّ صنَاعا",80,"ع",2,0],["وجلسنا يهفو السكونُ علينا","ويرينا وجوهَنا المصباحُ",81,"ح",1,0],["وجلا الغيبُ سرَّهُ","بين عينيه وارتسمْ",82,"م",1,0],["وجلائل للمأثرات مواثل","وجَحافل للحادثات جسامِ",83,"م",1,0],["وجلسنا في ظلها نتملَّى","صفحةَ الماءِ في الضحى والبكورِ",84,"ر",1,0],["وجَلوتَها للناظرينَ فأبصروا","برهانَ ربك ساطعاً يتألقُ",85,"ق",1,0],["وَجلا زمانُك وجههُ مُتَطَلِّعاً","فكأنَّهُ بعد المماتِ معادُ",86,"د",1,1],["وجلاك الشروق حتّى تبيّنت","محيّاك فاحتضنت الشروقا",87,"ق",2,0],["وَجَلَوْتَ فِي أَبْهَى تأَلُّقِهَا","أَقْمَارَ ذَاك العَهْدِ وَالزهْرَا",88,"ر",2,0],["وَجَلاَمِدُ الأَرْمَاسِ أَهْوَنُ مَحْمِلاً","مِنْ أَنْ يُحَمَّلَ مِثْلَهُنَّ كُرُوبَا",89,"ب",2,0],["وَجَلاَ الهَوَى وَالرَّأْيُ في إِيثَارِه