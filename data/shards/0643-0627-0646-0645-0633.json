{"poems":[[87,"تأمل في الوجود وكن لبيبا","https://www.aldiwan.net/poem7799.html","الوافر"],[47,"يا أخا الأزد ما حفظت الإخاء","https://www.aldiwan.net/poem10196.html","الخفيف"],[82,"لي سمع صد عن قول اللواح","https://www.aldiwan.net/poem31515.html","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202531","الرجز"],[356,"ومختلف الأصوات مؤتلف الزحف","https://www.aldiwan.net/poem68975.html","الطويل"],[447,"أعد نظراً في السرب بالرمل من حزوي","https://www.aldiwan.net/poem14343.html","الطويل"],[466,"تود الجحاجيح من خندف","https://www.aldiwan.net/poem15115.html","المتقارب"],[466,"تباريت والشهر الحرام ففقته","https://www.aldiwan.net/poem16180.html","الطويل"],[473,"أبو السرور بن جريج فتى","https://www.aldiwan.net/poem59716.html","السريع"],[520,"هي البدر من سنة البدر أملح","https://www.aldiwan.net/poem12055.html","الطويل"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62476","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25359","الرجز"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21661","المنسرح"],[2215,"","https://poetry.dctabudhabi.ae/diwan/poem/141791","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132746","المتقارب"],[3488,"","https://poetry.dctabudhabi.ae/diwan/poem/28825","الوافر"],[3582,"","https://poetry.dctabudhabi.ae/diwan/poem/45248","الوافر"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67653","الكامل"],[4501,"","https://poetry.dctabudhabi.ae/diwan/poem/143327","المديد"],[4940,"سهام الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=210455",""]],"verses":[["كأن مسيله مطر يصوب","ولكن نقمة وردىً صبيبا",0,"ا",1,0],["كانَ مُستَضعَفاً فَعَزَّ وَمَحرو","ماً فَأَجدى وَمُظلِماً فَأَضاءَ",1,"ا",2,0],["كان مِسْكُ اللّيلِ في مفرِقِه","فانجَلى عنهُ بِكَافورِ الصّباح",2,"ح",1,0],["كان مسيحيا وكان فاضلا","وكان عن حقيقة مناضلا",3,"ل",2,0],["كأن مساعيرَ الموالي عليهم","زماميج حادت للغرانيق بالنشف",4,"ف",1,0],["كأن مساحيب النضانض حوله","مجر رماح الحي في الماقط الألوى",5,"و",2,0],["كأنَّ مَسالكَها والرِّجالَ","تِلاعُ الصَّريم وجِنَّانُها",6,"ن",3,0],["كأنَّ مساعي أحمد بن محمَّدٍ","نجومٌ جلَتْ عنها المَطالعَ شمْأل",7,"ل",1,0],["كانَ مَسيحِيّاً فَلَمّا غَدا","مُحَمَّدِيّاً نَسِيَ الذُلّا",8,"ل",2,0],["كأن مساعي جملة الخلق جملة","غدت بمساعيه الحميدة تشرح",9,"ح",1,0],["كانَ مَسير البَحرِ في سُكونِ","وَدِعَةٍ مِن غَير ما فُتونِ",10,"ن",1,0],["كانَ مَسيرُنا عَلى القِطارِ","مِن أَوّلِ اللَيلِ إِلى النَهارِ",10,"ر",1,0],["كانَ مَسيرُنا إِلى السويسِ","مِن غَيرِ تَشويشٍ وَلا تَهويسِ",10,"س",1,0],["كأن مسار النقع سُحبٌ وقدحها","الشرار بروق يستهل حياها",11,"ا",3,0],["كَأَنَّ مِسْكاً ذاكِيَ الفُغَامِ","خالَطَ بَعْدَ وَسَنِ المَنامِ",12,"م",1,0],["كَأَنَّ مُستَنَّها تُلِمُّ بِهِ","لَطايِمُ المِسكِ حينَ يَلثِمُها",13,"م",3,0],["كان مستأنسا بقربك منه","يتمنى النعيم والإنعاما",14,"م",2,0],["كأن مسيل دماء الصغار","مسيل جفون عليهم بكينا",15,"ن",2,0],["كَأَنَّ مَسيحَتَي وَرِقٍ عَلَيها","نَمَت قُرطَيهِما أُذُنٌ خَذيمُ",16,"م",1,0],["كَأَنَّ مَساحِقَ الغِرقَيِّ فيها","مَلاحِفَ شَبَّها وَرسٌ مَدوفُ",17,"ف",1,1],["كأنَّ مسجدها المشيدَ بناؤه","ربعٌ أحال ومنزلٌ مترسّم",18,"م",1,0],["كان مَستوراً فحين دنا","كَأْسُها في كفّه افْتضحا",19,"ح",2,0],["كأنَّ مسافة الأقطار فينا","تقبل في سُكُوت وجنتيْنا",20,"ن",2,0]]}