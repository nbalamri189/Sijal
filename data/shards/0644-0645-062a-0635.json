{"poems":[[88,"لا رعى الله عهدها من جدود","https://www.aldiwan.net/poem10688.html","الخفيف"],[80,"لم تصف لي بعد وإلا فلم","https://www.aldiwan.net/poem14000.html","السريع"],[87,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[47,"مرت على عزمها ولم تقف","https://www.aldiwan.net/poem65159.html","المنسرح"],[71,"لمت صباغكم على","https://www.aldiwan.net/poem28275.html","مجزوء الخفيف"],[69,"أهل التقى والعلم أهل السؤدد","https://www.aldiwan.net/poem18059.html","الكامل"],[50,"قل لحمدان ما لكا","https://www.aldiwan.net/poem65020.html","مجزوء الخفيف"],[48,"أعوز الشث والسلم","https://www.aldiwan.net/poem23436.html","مجزوء الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147557","الكامل"],[111,"ريب المنون مقارض الأعمار","https://www.poetsgate.com/ViewPoem.aspx?id=521",""],[119,"يا ايها الحادي اعد مغناه","https://www.aldiwan.net/poem40434.html","عموديه"],[154,"يا من له شيم تملكه","https://www.aldiwan.net/poem68473.html","مجزوء الكامل"],[447,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[463,"مل معي لا عليك ضري ونفعي","https://www.aldiwan.net/poem56120.html","الخفيف"],[519,"شرف الوجه في تراب زرود","https://www.aldiwan.net/poem20806.html","الخفيف"],[519,"ضحكت فبان لنا عقود جمان","https://www.aldiwan.net/poem20818.html","الكامل"],[520,"شغل الزمان بما تقول وتفعل","https://www.aldiwan.net/poem12213.html","الكامل"],[563,"لو يكون الحظ السعيد رفيقا","https://www.aldiwan.net/poem34423.html","الخفيف"],[567,"طال شوقي لطول هذا البعاد","https://www.aldiwan.net/poem52967.html","الخفيف"],[580,"أما الغرام بها فعاد كما بدا","https://www.aldiwan.net/poem3079.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138235",""],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104108","الخفيف"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133795","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64906","البسيط"],[1239,"","https://poetry.dctabudhabi.ae/diwan/poem/128267","الخفيف"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56593","الخفيف"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64590","الكامل"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90694","الخفيف"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141254","الرمل"],[2188,"","https://poetry.dctabudhabi.ae/diwan/poem/20894","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93605","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65983","الرجز"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132620","الخفيف"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68005","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48292","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108171","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205667",""],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86503","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86462","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81279","الرمل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81683","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33539","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120410","الكامل"],[4727,"دولة الحلاقة","https://www.poetsgate.com/ViewPoem.aspx?id=215835",""],[4767,"استنهاض القلم","https://www.poetsgate.com/ViewPoem.aspx?id=201142",""],[4767,"استبصار","https://www.poetsgate.com/ViewPoem.aspx?id=213047",""],[4927,"رثاء الشهيدين برزان التكريتي وعواد البندر","https://www.poetsgate.com/ViewPoem.aspx?id=12987",""],[4960,"في وداع طِفلة","https://www.poetsgate.com/ViewPoem.aspx?id=210407",""],[5183,"لغة العز","https://www.poetsgate.com/ViewPoem.aspx?id=180218",""],[5277,"من أوراقِ عاشقٍ كرخيّ","https://www.poetsgate.com/ViewPoem.aspx?id=186552",""],[5409,"تخشع النفس هيبةً من جلال ال","https://www.poetsgate.com/ViewPoem.aspx?id=155478",""],[5956,"أنهكتَ أمك لست تأكل جيدا","https://www.poetsgate.com/ViewPoem.aspx?id=205428",""],[6223,"طارقة السحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1216&r=&rc=1",""]],"verses":[["لَم تَصُنكَ الجُنودُ تَفديكَ بِالأَر","واحِ وَالمالِ يا غَرامَ الجُنودِ",0,"د",1,0],["لَم تَصفُ لي بَعدُ وَإِلّا فَلِم","لَم أَرَ في عُنوانِها جَوهَرَهْ",1,"ر",2,1],["لَم تُصارِح أَصرَحَ الناسِ يَداً","وَلِساناً وَرُقاداً وَاِنتِباها",2,"ا",3,0],["لَم تُصِب بِالخِداعِ نُجحاً وَلَكِن","خَدَعوها بِقَولِهِم حَسناءُ",3,"ا",2,0],["لَم تُصبِ الرَأيَ في إِزارَتِها","مَن لايُجازي بِالوُدِّ وَاللَطَفِ",4,"ف",1,0],["لمتُ صباغَكُمْ على","مستهامٍ يعشقُهْ",5,"ه",1,1],["لمْ تُصْغِ لِلْعُلَمَاءِ إِلَّا مِثْلَمَا","أَصْغَى سُلَيْمَانٌ لِقَوْلِ الهُدْهُدِ",6,"د",1,0],["لَم تَصِل يا فَدَتكَ نَف","سي حِبالي حِبالَكا",7,"ك",2,0],["لَم تُصِب جِسمُهُ الكُلو","مُ وَلا دينُهُ كُلِم",8,"م",1,0],["لم تُصَنْ من جراءة المستبدي","نَ عَلى الهالكين حتى القبور",9,"ر",1,0],["لم تصف قط لعاقل فكأنما","عبرت عن فقد النهى بصفائها.",10,"ا",3,0],["لم تصغ نادبة لندبة جارها","هي تستعد لندبة في الدار",11,"ر",1,0],["لم تصرف العشاق آه مقلقا","في حبه الا واقبل آه",12,"ا",2,0],["لم تَصفُ منها لذةٌ","إلاَّ وفيها شائب",13,"ب",1,0],["لم تصبه الدنيا ولا أموالها","والغانيات فما اطباه دلالها",14,"ل",3,0],["لم تُصِخْ للعذول في فرط أشعا","ري ولم تزدجر بنهيٍ ووزعِ",15,"ع",1,0],["لم تصلْها حبائِلُ الفِكر والوهْ","مِ ولو وُصِّلَتْ بحبلِ الوَريدِ",16,"د",1,0],["لم تصلِبِ القُرْطَ البريَّ لغايةٍ","إلّا لتنصُرَ دولةَ الصُّلبانِ",17,"ن",1,0],["لم تصد منها صفحة بملمة","إلا وعزمك في صداها صيقل",18,"ل",1,0],["لم تصلني يد تروم خلاصي","ثم إن الإله أمريَ أنهى",19,"ا",1,0],["لم تُصبْنا أيدي العُداةِ بِسَهمٍ","فرَمانا بأعيُنِ الحُسَّادِ",20,"د",1,0],["لم تصدئ الأَيَّامُ سيفَ لِحَاظِها","لكِنْ عَلَى الشَّفَتَين أَبْصَرْتُ الصَّدا",21,"د",2,0],["لم تصنع الحسنى جهاراً أنما","سراً يراها الواحد المعبود",22,"د",1,0],["لم تُصبهُ النّوى بفقدانِ خلِّ","فيُرى باكياً على فقدانِه",23,"ن",2,0],["لم تصب منك غير ما","يترك الظل من أثر",24,"ر",1,0],["لم تَصْحُ حَوباؤهُ مِنْ شكْرِ حَوْبتِها","حتى سَقاها بكأسِ الحَرْبِ ساقيكاً",25,"ك",2,0],["لم تُصدِّقْ هَولَ الفَجِيعَةِ نَفْسِي","واخْتِلاسَ الحِمامِ قُمْرِيّ داري",26,"ر",2,0],["لم تصيبي ماذا تخافين منهم","أنت في منعةٍ من الأحكام",27,"م",1,0],["لم تصدر الآثار حق وجوبه","إلا دلالتها لتأثيراته",28,"ت",2,0],["لم تُصَب أيُّها الأميرُ بُعبدِ","الله لكن بِهِ اصِيبَ الأنامُ",29,"م",1,1],["لم تصف غير الرزّايا والألم","دبّجت يمناك آيات السّما",30,"م",2,0],["لَم تَصبِر لَنا غَطَفانُ لَمّا","تَلاقَينا وَأُحرِزَتِ النِساءُ",31,"ا",2,1],["لَم تصبح الحَي العصاة بغارة","إِلا وَقَبلك قَد بَعثت نَذيرا",32,"ر",2,0],["لم تصطحب عرفاً ولا براً ولا","تقوى لها من قلة الاحذام",33,"م",1,0],["لم تصب واحداً من الناس لكن","أوحد الناس في الفضائل طرّا",34,"ر",2,0],["لم تصف للانبيا والاولياء ولا","صفت لاهل عتابات ولا همم",35,"م",1,0],["لم تصطحِبْ من وَقود النارِ رِفْقتُه","تَكفِي مَلامحُه عن شُعلة الوَقَد",36,"د",1,0],["لمْ تُصْمِتِ الأيامُ ألسُنَ فِكْرَتي","إلا وأنصَفَتِ المَواهِبُ خُرْسَها",37,"س",3,0],["لم تصبر الأجفان بعدك عن دم","يهمي وقلبي عن لفظى متضرم",38,"م",1,0],["لم تصُن عهدًا لمن حا","طك بالعطف العجاب",39,"ب",1,0],["لم تصب إلا لاحتيا","زٍ للمحامد وامتلاك",40,"ك",1,0],["لم تصلح الدنيا بغير رعاية","منكم لنجدة سيد ومسود",41,"د",1,0],["لَم تَصوغوا قَلبَها الخافق حَتّى","تَفرُضوا الحُب عَلَيها وَالحَبيبا",42,"ب",2,0],["لم تُصْدرِ الأرماح إلاّ بعد ما","أرْيتَ من قُلُبِ القلوب ظماءها",43,"ا",3,0],["لم تصافِحُ دموعُهُ الخدَّ حتى","بانَ منهُ قلبٌ عليهِ كريمُ",44,"م",1,0],["لم تصف عن غصص المنى","وهو الذي لا يدفع",45,"ع",1,0],["لم تُصِبْ مثل أيادي","حالقِ في محْلوقِ",46,"ق",1,0],["لمْ تَصدحنْ منك البلابلُ، لم","ينطِقْ بشأنِ اليومِ منك فم",47,"م",1,0],["لَم تصْفُ يوماً للصديقِ نفوسُهم","كلا وما بقِيَتْ لَهم أحباب",48,"ب",1,0],["لَمْ تَصْفُ يَوْماً، إِنَّمَاْ غَدَرَتْ بِمَنْ","لَمْ يُرْضِهِ جُبْنٌ وَلاْ شَنَآنُ",49,"ن",1,0],["لمْ تصطحِبْ غَيرَ أحلامٍ مُلَونَةٍ،","هلْ يَحتَفيْ بِصِباها الفادِح الأزَلُ",50,"ل",1,0],["لم تصغها غير المعالي عقودا","زانت الكون في جمال المقلَّد",51,"د",1,0],["لم تصمدي يوماً لعاطفةِ الهوى","وانا الذي للعشقِ بُعداً يصمدُ",52,"د",1,0],["لم تصل للكمال نفس ولكن","كدت فيها تجتاز باب الكمال",53,"ل",1,0],["لمْ تُصبح الأسنانُ بعدُ قوية","وهي التي منها أعيش مهدّدا",54,"د",2,0],["..لم تُصبِهِ في الهوى ألحاظ غانيةٍ","كما صبت قبله قوماً فلم يفقوا",55,"ق",3,0]]}