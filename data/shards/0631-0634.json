.aldiwan.net/poem37618.html","الكامل"],[512,"ما الراح إلا روح كل حزين","https://www.aldiwan.net/poem20791.html","الكامل"],[512,"ضحكت فبان لنا عقود جمان","https://www.aldiwan.net/poem20818.html","الكامل"],[560,"قد مد خط عذاره فأجاده","https://www.aldiwan.net/poem52837.html","الكامل"],[560,"لاحت بوجه بديع الأنس ميمون","https://www.aldiwan.net/poem52847.html","البسيط"],[560,"غضي جفونك يا عيون النرجس","https://www.aldiwan.net/poem52891.html","الكامل"],[560,"قفا بين الثنية والمصلى","https://www.aldiwan.net/poem52929.html","الوافر"],[560,"أخاف إذا أشار براحتيه","https://www.aldiwan.net/poem52973.html","الوافر"],[573,"إنك المخلوق في كبدي","https://www.aldiwan.net/poem2816.html","المديد"],[573,"لام العذول على هواك وفندا","https://www.aldiwan.net/poem2960.html","الكامل"],[573,"أرى واحدا في الحسن ثاني عطفه","https://www.aldiwan.net/poem3050.html","الطويل"],[573,"عادني من هوى الأحبة عيد","https://www.aldiwan.net/poem3078.html","الخفيف"],[584,"رشيق القامة النضره","https://www.aldiwan.net/poem17529.html","مجزوء الوافر"],[584,"فدتك نفوس قد حلا بك حالها","https://www.aldiwan.net/poem17657.html","الطويل"],[584,"ليت شعري من قد أحل الخياما","https://www.aldiwan.net/poem17744.html","الخفيف"],[584,"هذا العقيق فما لقلبك يخفق","https://www.aldiwan.net/poem18003.html","الكامل"]],"verses":[["رِشتُمُ سَهمي وَضاعَفتُم لَهُ","عَقِبَ النَعماءِ وَالريشِ اللُواما",0,"م",2,0],["رِشاءُ الرَدى لَو عَضَّ بِالطَودِ هاضَهُ","وَلَو شَمَّ ما لاقى عَلى الأَرضِ أَحرَقا",1,"ق",2,0],["رِشتُم سِهامي لِلعِدى وَتَرَكتُمُ","قَدَمي إِلى أَمَدِ المَعالي تَتبَعُ",2,"ع",1,0],["رُشِقَت بِهِ في كُلِّ جَنبٍ مُديَةٌ","وَاِنسابَ فيهِ بِكُلِّ رُكنٍ أَرقَمُ",3,"م",1,0],["رَشَأٌ أَقصَدَ الجَوانِحَ قَصداً","عَن جُفونٍ كُحِلنَ عَمداً بِسِحرِ",4,"ر",1,0],["رُشْدِي وَكَانَ الحَوْلُ دَهْراً حَوْلَهُ","وَالمَالُ لَوْ يَبْغِيهِ طَوْعُ بَنَانِ",5,"ن",1,0],["رُشْدِي وَهَلْ يَنْسَى لِرُشْدِي قَوْمُهُ","حُسْنَ البَلاءِ وَقُوَّةَ الإِيمَانِ",5,"ن",1,0],["رَشَأٌ وَالنِّفَارُ شِيمَتُهُ","لا لِشَيءٍ يَصُدُّ أَحْيَانَا",6,"ن",2,0],["رَشيدُهُم غاوٍ وَطِفلاهُ بَعدَهُ","لِهَذا رَزايا دونَ ذاكَ مُجونُ",7,"ن",1,0],["رَشيفَ الهِجانَينِ الصَفا رَقرَقَت بِهِ","عَلى ظَهرِ صَمدٍ بَغشَةٌ لَم تُسَيِّلِ",8,"ل",1,0],["رشفتُ به شهدَ الرُّضاب سُلافةٌ","وقبّلْتُ في ماء النعيم الأقاحيا",9,"ي",2,0],["رِشني فَقَد دَخَلَت عَلَيَّ خَصاصَةٌ","مِمّا جَمَعتَ وَكُلُّ خَيرٍ تَجمَعُ",10,"ع",1,0],["رَشَتكَ مُجاشِعٌ سَكَراً بِفَلسٍ","فَلا يَهنيكَ رِشوَةُ مَن رَشاكا",11,"ك",2,0],["رَشَأٌ إِذا لَحَظَ العَفيفَ بِنَظرَةٍ","كانَت لَهُ سَبَباً إِلى الفَحشاءِ",12,"ا",2,0],["رشأٌ دبَّ في سوالفه النم","لُ فهامت خواطر الشعراء",13,"ا",2,0],["رشيقةٌ ما كأني يومَ فرقتِها","إلا على آلةٍ في القوم حدباء",14,"ا",2,0],["رشاً ترفع الناسُ العيون لحسنهِ","ولكنّ عيناه على الناسِ تنصب",15,"ب",1,0],["رشا بالصالحيةِ سفح عيني","سريعٌ في محبته مديد",16,"د",1,1],["رشقتني من اللحاظ بغمزه","وتثنت كصعدةٍ مهتزّه",17,"ز",2,1],["رشأٌ رشفت رضابه أو ثعلب","ما للمحبِّ إلى رضاه بلوغ",18,"غ",1,1],["رشأ من الأتراك إلا أن في","جفنيه ما في الهند من أسياف",19,"ف",1,0],["رشأٌ وجدت العذل فيه باطلاً","لما وجدت بمقلتيه السحر حق",20,"ق",1,0],["رشأٌ سرفت مدامعي في حبِّه","يا للقتيل بكى لحبِّ القاتل",21,"ل",1,0],["رشاقة فذاك القدّ فوقَ صراطه","ودينار ذاكَ الخدّ بين الموازن",22,"ن",1,0],["رشأٌ يجور مع اعْتدال قوامه","فينا ويفتك مع حداثة سنه",23,"ن",2,0],["رُشَّت بخِيلانها فجلدتُها","منقوشة مثل جلدة النمره",24,"ر",2,0],["رشأٌ أودع قلبي حسرةً","وحَمى عينيَّ بالدمع النظر",25,"ر",1,0],["رِشْني تجدني رضى لمصطنع","إن قلت أي الرجال أصطنع",26,"ع",1,0],["رشفُوا المنِيَّ من الفياشِ وحرَّموا","ريقَ الصديقِ مُؤاكِلاً ومنادما",27,"م",2,0],["رشأٌ قد جاوزَ الحُس","نُ به حدَّ التَّمنِّي",28,"ي",1,0],["رِشاءُ مَحالَةٍ في يَومِ وِردٍ","يَمُدُّ حِطاطُها المَسَدَ المُغارا",29,"ر",2,0],["رشاد أنت صديق","ماذا ترى في البضاعة",30,"ه",1,0],["رشاد أنت ههنا","من ذا الذي كان معك",31,"ك",1,0],["رشاد اسمع عقدت العزم فاذهب","وأمك فاخطبا لي اليوم زينب",32,"ب",1,1],["رَشَأٌ يُعابُ الساحِرو","نَ وَسِحرُهُم إِلّا جُفونُهُ",33,"ن",2,0],["رشَأٌ فُتورُ لِحَاظِهِ","يروي عن المَلَكينِ سِحْرا",34,"ر",2,1],["رَشَأُ ما دَنَت بِهِ الدارُ إِلّا","رَجَعَ البُعدَ صَدُّهُ وَاِجتِنابُه",35,"ب",2,0],["رَشَأٌ إِن أَعادَ كَرَّ بِلَحظٍ","أَشعَلَ القَلبَ مُضنِياً أَو أَذابَه",36,"ب",2,0],["رَشيدِيَةٌ في نَجرِها واثِقِيَّةٌ","يَرى اللَهُ إيثارَ التُقى مِن عِتادِها",37,"د",3,0],["رَشادَكَ لا يَحزُنكَ بَينُ اِبنِ هِمَّةٍ","يَتوقُ إِلى العَلياءِ لَيسَ لَهُ نَدُّ",38,"د",1,0],["رَشَأٌ تُخبِرُ القَراطِقُ مِنهُ","عَن كَنارٍ يُضيءُ تَحتَ الكَنارِ",39,"ر",1,0],["رَشَأٌ كَأَنَّ الشَمسَ يَومَ دُجُنَّةٍ","حَيراءَ بَينَ هُجولِهِ وَحِجالِهِ",40,"ل",2,0],["رِشاءٌ لَهُ دَلوٌ تَفيضُ ذُنوبُها","عَلى المَحلِ أَعلى دَلوِها في الكَواكِبِ",41,"ب",1,0],["رشأ ما استاك إلا","ظالما جوهر فيه",42,"ي",2,0],["رَشَفتُ بُردَ الحُمَيّا مِن مَراشِفِها","فَنَبَّهَتني إِلَيها نَسمَةُ السَحَرِ",43,"ر",1,0],["رَشَأٌ تَفَرَّدَ فيهِ قَلبي بِالهَوى","لَمّا غَدا بِجَمالِهِ مُتَفَرِّدا",44,"د",2,0],["رَشَأٌ مِن جَآذِرِ التُركِ لَكِن","حازَ إِرثَ الجَمالِ عَن بِلقيسِ",45,"س",1,0],["رَشيقَةُ السَبكِ لا المَعنى بِمُبتَذَلٍ","مِنها وَلا لَفظُها بِالعَسفِ مَكدودُ",46,"د",1,0],["رَشَأٌ غَدا مَن سُكرِ خَمرَةِ ريقِهِ","مُتَأَوَّدا فَكَأَنَّها صَهباءُ",47,"ا",2,0],["رَشَأٌ كَبَدرِ التَمِّ في إِشراقِهِ","وَكَمالِ طَلعَتِهِ وَبُعدِ مَنالِهِ",48,"ل",2,0],["رَشأٌ تَفَرَّدَ في المَحاسِنِ فَاِغتَدى","تَفصيلُ رَسمِ الحُسنِ في إِجمالِهِ",48,"ل",2,0],["رشأ ينفرُ خَوْفاً","كلَّما مَاشاهُ ظِلُّه",49,"ل",2,0],["رشأٌ أحنّ إلى هواه كأنّه","وطنٌ وُلدتُ بأرضه ونشيتُ",50,"ت",1,0],["رَشَأً إِذا ما كانَ يُطلِقُ نَفسَهُ","في فَتكِهِ أَمَرَ الحَياءُ بِحَبسِهِ",51,"س",2,0],["رَشَأٌ تَعْبُدُ النَّوَاظِرُ مِنْهُ","وَاحِداً فِي الْجَمَالِ لَيْسَ يُثَنَّى",52,"ن",2,0],["رشقتني بأسهمٍ انتضتها ال","هدْبُ عنْ قوسِ حاجبٍ مقرونِ",53,"ن",1,0],["رشفْتُ عندَ اللقا مِنْ حلوِ ريقَتِها","قَطْرَ النباتِ فزالَ البؤسُ واللهبُ",54,"ب",1,1],["رشدي وغيي وجهُهُ","فالوجهُ زاهٍ زاهرُ",55,"ر",1,0],["رَشفت مِنها سَلسلاً بارِداً","صادف نِيراني فَأَطفاها",56,"ا",3,0],["رُشِدَّتَ وَأُنعِمَت اِبنَ عَمرٍ وَإِنَّما","تَجَنَبتَ تَنوراً مِنَ النارِ حامِيا",57,"ي",2,1],["رِش نَبلَ مَن يَرمي وَراءَكَ جاهِداً","رَميَ المُناضِلِ فازَ بِالأَخطارِ",58,"ر",1,0],["رَشاشٌ كَغَربَي هاجِرِيٍّ كِلاهُما","لَهُ داجِنٌ بِالكَرَّتَينِ عَليفُ",59,"ف",1,0],["رَشَأٌ قَد زانَ طُرَّتَهُ","مَشقُ نونٍ لَيسَ بِالقَلَمِ",60,"م",1,0],["رَشأٌ كَساهُ الحُسنُ خِلعَتَهُ","وَجَرى عَلى خَدَّيهِ رَونَقُهُ",61,"ق",2,0],["رَشَأٌ تَواصَينَ القِيانُ بِهِ","حَتّى عَقَدنَ بِأُذنِهِ شَنَفا",62,"ف",2,0],["رَشَأٌ لَولا مَلاحَتُهُ","خَلَتِ الدُنيا مِنَ الفِتَنِ",63,"ن",1,0],["رَشِدتَ أَميرَ المُؤمِنينَ وَإِنَّما","ظَفَرتَ وَوَلَّيتَ الأَمينَ المُسَدَّدا",64,"د",2,0],["رَشِّح لُبانَةَ صاحِبٍ","وَاِذكُر بِها ما كُنتَ قُلتا",65,"ت",2,0],["رَشِّح أَباكَ لِأُخرى مِن صَنائِعِهِ","وَاِعرِف لِقَومٍ بِرَأسٍ دونَهُ أَشَبُ",66,"ب",1,0],["رَشاً لو رآهُ البدرُ يُشرقُ وجهُهُ","لأظلمَ وجهُ البدرِ وهو شَريقُ",67,"ق",1,0],["رشاً سجدَ الجمالُ لوجنتيهِ","كما سَجدَ النَّصارى للصَّليبِ",68,"ب",1,1],["رشقتها النجوم من كل صوب","بسهام للدفع ذات مضاء",69,"ا",2,0],["رشقتها من الجوانب لما","وَجدتها تجري بغير وقاء",69,"ا",2,0],["رَشَأٌ بَلْ غادةٌ مَمْكُورةٌ","عُمِّمَتْ صُبْحاً بلَيْلٍ أَسْوَدَا",70,"د",2,0],["رَشَفَتْ خَمْرَةَ النَّدَى مِنْ كُؤُوسِ الزْ","زَهْرِ حَتَّى تَمَايَلَتْ مِنْ خُمَارِ",71,"ر",1,0],["رَشِيدُ أَبْلِغ أَجَلَّ حَبْرٍ","تَهْنِئَةَ الوَامِقِ النَّصُوحِ",72,"ح",1,0],["رَشِيدُ الأَمْرِ ذُو حُكْمٍ وَعِلْمٍ","وَحِلْمٍ لَمْ يكنْ نَزقاً خَفِيفَا",73,"ف",2,0],["رُشيت مآذنها، فلم تغضب لها","غضب الكرام، وباعها ناقوسها",74,"س",3,0],["رَشاً طامَ عُلواً فَاِدَّعَت يَثرِبُ الحَشا","فَأَفطَرَ سُفلاً فَاِدَّعَت ردفهُ مِصرُ",75,"ر",1,1],["رَشدتَ قَبلَ اِكتِمالِ عَشرٍ","وَاِزدَنت بِالحِلمِ وَالوقارِ",76,"ر",1,0],["رَشَأٌ يصْطادُ الأُسْدَ وكمْ","رامَتْهُ الأسْدُ فلم تَصِدِ",77,"د",1,0],["رَشِيدُ لاَقَتْ رَشِيداً","شَهْماً مُجيباً مُجابا",78,"ب",2,0],["رَشَقَتْه أحْداثُ الْخطوبِ فأقْصَدَتْ","حَرْبُ الخُطُوبِ الدُّهْمِ غيرُ سِجَالِ",79,"ل",1,0],["رشفت من النيل العتيق رحيقه","وتَفيَّأَتُ منه ظلال الوادي",80,"د",2,0],["رشفةٌ من منابع النيل تُربِي","حسناتي في كِفَّةِ الميزان",81,"ن",1,0],["رشَقوا جمالا بالزهو","ر؛ من الجِنَانِ، وبالورود",82,"د",1,0],["رشفةٌ قد حُرمْتُها منك باتت","عند غيري رخيصةً مُستَهانه",83,"ن",2,0],["رَشأٌ كأنّ الشّمسَ، يوْمَ دُجُنّةٍ،","حَيرَاءُ بَينَ حُجُولِهِ وَحِجَالِهِ",84,"ل",2,0],["رِش جناحي أوْ سمِّ لي مُستريشا","لك أضحى وريشُه غيرُ وحفِ",85,"ف",1,0],["رَشَفَتْ خَمْرَة َ النَّدَى مِنْ كُئُوسِ ال","زَّهْرِ حَتَّى تَمَايَلَتْ مِنْ خُمَارِ",86,"ر",1,0],["رَشاً يَفتَر عَن بَرد","تَكادُ تُذيبَهُ القُبَل",87,"ل",1,0],["رَشأ يَميل مِن الدَلال وَيَنثَني","عَجَباً كَغُصن البانة المَيّاد",88,"د",1,0],["رَشأ سَبا مِنا العُقو","ل وَلِلقُلوب لَقَد سَلَب",89,"ب",1,0],["رَشأ كَالمهات جَيداً وَلَحظاً","وَقَضيب يَقل بَدراً سَنيّا",90,"ي",2,0],["رَشأ حازَ عُنوة دَولة الحَس","ن وَأَرواح ذي الغَرام الرَسيس",91,"س",1,0],["رَشأ تُثير لَواعِجي حَرَكاتُهُ","وَتَنبه الأَشواق لِلأَشجان",92,"ن",1,0],["رشت بدمع العاشقين وروده","وعليه قلبي دون صحبي طائر",93,"ر",1,0],["رشق الفؤاد بسهم بين صائب","ادمى سويدائي وقد سوادي",94,"د",2,0],["رشيد فارشدني برشدك دائماً","صبور فجملني إلى الموت بالصبر",95,"ر",1,0],["رَشَا كُلَّما أدمَت جُفُونِيَ خَدَّهُ","أشار إلى قلبي بعينيهِ فانتصَر",96,"ر",1,0],["رشفة منه ولو قد نلتها","لكفتني عن دواء البنسلين",97,"ن",1,0],["رشفُ الثنايا والتزام والطُّلىَ","إن أمكنا أخلاطُ درياقى",98,"ق",2,0],["رَشَأٌ تَشابَهَ طَرفُهُ وَمُحِبُّهُ","وَوِدادُهُ كُلٌّ أَراهُ سَقيما",99,"م",2,0],["رُشُّوا بماءِ الورد ضيفاً لنا","ظبياً أنار الحسنُ من خده",100,"ه",1,1],["رَشَأٌ تَشْرَهُ النُّفُوسُ إِلى مَا","في ثَناياهُ مِنْ رَحِيقِ اللِّسانِ",101,"ن",1,0],["رَشَأٌ كُلَّما سَرى اللحْظُ فيهِ","جَرَحَتْهُ خَناجِرُ الأَبْصارِ",102,"ر",1,0],["رَشَأٌ يَقتُلُ الأُسودَ غَريرٌ","كَيفَ يُردي الأُسودَ ظَبيٌ غَريرُ",103,"ر",1,0],["رَشْقاً كألحاظِ الحسانِ رمى بها ال","عُشّاقَ قوسَ الحاجبِ المقرونِ",104,"ن",1,0],["رَشْتُ به ثَنايا في ثَنايا","كأن المِسْك بينهما فَتيت",105,"ت",1,0],["رشيقةٌ يَتَثنَّى قَدُّها هَيَفا","كالخُوطِ مالَ بعطْفَيْه النسيمُ نَدِ",106,"د",1,0],["رشأٌ وهَبتُ لهُ الشب","بابَ فكان عنوانَ افتِخاري",107,"ي",1,0],["رشقت قلباً خفوقاً يلتظي","كضرام بيدي مرتعش",108,"ش",1,0],["رشأٌ تلاعبَ بال