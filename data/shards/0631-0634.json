],[80,"ملني من لا أمله","https://www.aldiwan.net/poem31333.html","مجزوء الرمل"],[80,"الدمع ينطق واللسان صموت","https://www.aldiwan.net/poem31531.html","الكامل"],[44,"يا لابسا ثوب الملاحة أبله","https://www.aldiwan.net/poem30235.html","الكامل"],[87,"لاعب السكر قده فتثنى","https://www.aldiwan.net/poem8230.html","الخفيف"],[69,"صاح إن كنت في الغرام معيني","https://www.aldiwan.net/poem28372.html","الخفيف"],[69,"رشفت عند اللقا من حلو ريقتها","https://www.aldiwan.net/poem28684.html","البسيط"],[69,"الطرف ساه ساهر","https://www.aldiwan.net/poem28915.html","مجزوء الكامل"],[102,"رسالة واها لها واها","https://www.aldiwan.net/poem33108.html","السريع"],[21,"رشدت وأنعمت ابن عمر وإنما","https://www.aldiwan.net/poem36134.html","الطويل"],[39,"هل يدنيك من أجارع واسط","https://www.aldiwan.net/poem53778.html","الكامل"],[22,"أمن رسم دار مربع ومصيف","https://www.aldiwan.net/poem21650.html","الطويل"],[52,"لم ينم همي ولم أنم","https://www.aldiwan.net/poem26680.html","المديد"],[52,"هذا الفراق وكنت أفرقه","https://www.aldiwan.net/poem26805.html","الكامل"],[48,"حلت سعاد وأهلها سرفا","https://www.aldiwan.net/poem64408.html","الكامل"],[48,"يا كثير النوح في الدمن","https://www.aldiwan.net/poem66134.html","المديد"],[50,"ألم يأن أن تسلى مودة مهددا","https://www.aldiwan.net/poem63919.html","الطويل"],[50,"يا صاح قل في حاجتي","https://www.aldiwan.net/poem64734.html","مجزوء الكامل"],[50,"تأبدت برقة الروحاء فاللبب","https://www.aldiwan.net/poem64839.html","البسيط"],[76,"أرقت وقلبي عنك ليس يفيق","https://www.aldiwan.net/poem39255.html","الطويل"],[76,"رشا سجد الجمال لوجنتيه","https://www.aldiwan.net/poem39480.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30451","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42649","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54686","البسيط"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67325","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142037","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43639","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43841","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43884","المتدارك"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54236","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54196","الكامل"],[106,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[106,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[106,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""],[90,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""],[45,"هَذا الحَبيبُ، فمَرْحَباً بخَيالِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=32119",""],[51,"وبديعٍ من البدائع يَسْبي","https://www.poetsgate.com/ViewPoem.aspx?id=29591",""],[87,"حَبَّذا الراحُ فى أوانِ البَهارِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23982&r=&rc=244",""]],"verses":[["رِشتُمُ سَهمي وَضاعَفتُم لَهُ","عَقِبَ النَعماءِ وَالريشِ اللُواما",0,"م",2,0],["رِشاءُ الرَدى لَو عَضَّ بِالطَودِ هاضَهُ","وَلَو شَمَّ ما لاقى عَلى الأَرضِ أَحرَقا",1,"ق",2,0],["رِشتُم سِهامي لِلعِدى وَتَرَكتُمُ","قَدَمي إِلى أَمَدِ المَعالي تَتبَعُ",2,"ع",1,0],["رُشِقَت بِهِ في كُلِّ جَنبٍ مُديَةٌ","وَاِنسابَ فيهِ بِكُلِّ رُكنٍ أَرقَمُ",3,"م",1,0],["رَشَأٌ أَقصَدَ الجَوانِحَ قَصداً","عَن جُفونٍ كُحِلنَ عَمداً بِسِحرِ",4,"ر",1,0],["رُشْدِي وَكَانَ الحَوْلُ دَهْراً حَوْلَهُ","وَالمَالُ لَوْ يَبْغِيهِ طَوْعُ بَنَانِ",5,"ن",1,0],["رُشْدِي وَهَلْ يَنْسَى لِرُشْدِي قَوْمُهُ","حُسْنَ البَلاءِ وَقُوَّةَ الإِيمَانِ",5,"ن",1,0],["رَشَأٌ وَالنِّفَارُ شِيمَتُهُ","لا لِشَيءٍ يَصُدُّ أَحْيَانَا",6,"ن",2,0],["رَشيدُهُم غاوٍ وَطِفلاهُ بَعدَهُ","لِهَذا رَزايا دونَ ذاكَ مُجونُ",7,"ن",1,0],["رَشيفَ الهِجانَينِ الصَفا رَقرَقَت بِهِ","عَلى ظَهرِ صَمدٍ بَغشَةٌ لَم تُسَيِّلِ",8,"ل",1,0],["رشفتُ به شهدَ الرُّضاب سُلافةٌ","وقبّلْتُ في ماء النعيم الأقاحيا",9,"ي",2,0],["رِشني فَقَد دَخَلَت عَلَيَّ خَصاصَةٌ","مِمّا جَمَعتَ وَكُلُّ خَيرٍ تَجمَعُ",10,"ع",1,0],["رَشَتكَ مُجاشِعٌ سَكَراً بِفَلسٍ","فَلا يَهنيكَ رِشوَةُ مَن رَشاكا",11,"ك",2,0],["رَشَأٌ إِذا لَحَظَ العَفيفَ بِنَظرَةٍ","كانَت لَهُ سَبَباً إِلى الفَحشاءِ",12,"ا",2,0],["رشأٌ دبَّ في سوالفه النم","لُ فهامت خواطر الشعراء",13,"ا",2,0],["رشيقةٌ ما كأني يومَ فرقتِها","إلا على آلةٍ في القوم حدباء",14,"ا",2,0],["رشاً ترفع الناسُ العيون لحسنهِ","ولكنّ عيناه على الناسِ تنصب",15,"ب",1,0],["رشا بالصالحيةِ سفح عيني","سريعٌ في محبته مديد",16,"د",1,1],["رشقتني من اللحاظ بغمزه","وتثنت كصعدةٍ مهتزّه",17,"ز",2,1],["رشأٌ رشفت رضابه أو ثعلب","ما للمحبِّ إلى رضاه بلوغ",18,"غ",1,1],["رشأ من الأتراك إلا أن في","جفنيه ما في الهند من أسياف",19,"ف",1,0],["رشأٌ وجدت العذل فيه باطلاً","لما وجدت بمقلتيه السحر حق",20,"ق",1,0],["رشأٌ سرفت مدامعي في حبِّه","يا للقتيل بكى لحبِّ القاتل",21,"ل",1,0],["رشاقة فذاك القدّ فوقَ صراطه","ودينار ذاكَ الخدّ بين الموازن",22,"ن",1,0],["رشأٌ يجور مع اعْتدال قوامه","فينا ويفتك مع حداثة سنه",23,"ن",2,0],["رُشَّت بخِيلانها فجلدتُها","منقوشة مثل جلدة النمره",24,"ر",2,0],["رشأٌ أودع قلبي حسرةً","وحَمى عينيَّ بالدمع النظر",25,"ر",1,0],["رِشْني تجدني رضى لمصطنع","إن قلت أي الرجال أصطنع",26,"ع",1,0],["رشفُوا المنِيَّ من الفياشِ وحرَّموا","ريقَ الصديقِ مُؤاكِلاً ومنادما",27,"م",2,0],["رشأٌ قد جاوزَ الحُس","نُ به حدَّ التَّمنِّي",28,"ي",1,0],["رِشاءُ مَحالَةٍ في يَومِ وِردٍ","يَمُدُّ حِطاطُها المَسَدَ المُغارا",29,"ر",2,0],["رشاد أنت صديق","ماذا ترى في البضاعة",30,"ه",1,0],["رشاد أنت ههنا","من ذا الذي كان معك",31,"ك",1,0],["رشاد اسمع عقدت العزم فاذهب","وأمك فاخطبا لي اليوم زينب",32,"ب",1,1],["رَشَأٌ يُعابُ الساحِرو","نَ وَسِحرُهُم إِلّا جُفونُهُ",33,"ن",2,0],["رشَأٌ فُتورُ لِحَاظِهِ","يروي عن المَلَكينِ سِحْرا",34,"ر",2,1],["رَشَأُ ما دَنَت بِهِ الدارُ إِلّا","رَجَعَ البُعدَ صَدُّهُ وَاِجتِنابُه",35,"ب",2,0],["رَشَأٌ إِن أَعادَ كَرَّ بِلَحظٍ","أَشعَلَ القَلبَ مُضنِياً أَو أَذابَه",36,"ب",2,0],["رَشيدِيَةٌ في نَجرِها واثِقِيَّةٌ","يَرى اللَهُ إيثارَ التُقى مِن عِتادِها",37,"د",3,0],["رَشادَكَ لا يَحزُنكَ بَينُ اِبنِ هِمَّةٍ","يَتوقُ إِلى العَلياءِ لَيسَ لَهُ نَدُّ",38,"د",1,0],["رَشَأٌ تُخبِرُ القَراطِقُ مِنهُ","عَن كَنارٍ يُضيءُ تَحتَ الكَنارِ",39,"ر",1,0],["رَشَأٌ كَأَنَّ الشَمسَ يَومَ دُجُنَّةٍ","حَيراءَ بَينَ هُجولِهِ وَحِجالِهِ",40,"ل",2,0],["رِشاءٌ لَهُ دَلوٌ تَفيضُ ذُنوبُها","عَلى المَحلِ أَعلى دَلوِها في الكَواكِبِ",41,"ب",1,0],["رشأ ما استاك إلا","ظالما جوهر فيه",42,"ي",2,0],["رَشَفتُ بُردَ الحُمَيّا مِن مَراشِفِها","فَنَبَّهَتني إِلَيها نَسمَةُ السَحَرِ",43,"ر",1,0],["رَشَأٌ تَفَرَّدَ فيهِ قَلبي بِالهَوى","لَمّا غَدا بِجَمالِهِ مُتَفَرِّدا",44,"د",2,0],["رَشَأٌ مِن جَآذِرِ التُركِ لَكِن","حازَ إِرثَ الجَمالِ عَن بِلقيسِ",45,"س",1,0],["رَشيقَةُ السَبكِ لا المَعنى بِمُبتَذَلٍ","مِنها وَلا لَفظُها بِالعَسفِ مَكدودُ",46,"د",1,0],["رَشَأٌ غَدا مَن سُكرِ خَمرَةِ ريقِهِ","مُتَأَوَّدا فَكَأَنَّها صَهباءُ",47,"ا",2,0],["رَشَأٌ كَبَدرِ التَمِّ في إِشراقِهِ","وَكَمالِ طَلعَتِهِ وَبُعدِ مَنالِهِ",48,"ل",2,0],["رَشأٌ تَفَرَّدَ في المَحاسِنِ فَاِغتَدى","تَفصيلُ رَسمِ الحُسنِ في إِجمالِهِ",48,"ل",2,0],["رشأ ينفرُ خَوْفاً","كلَّما مَاشاهُ ظِلُّه",49,"ل",2,0],["رشأٌ أحنّ إلى هواه كأنّه","وطنٌ وُلدتُ بأرضه ونشيتُ",50,"ت",1,0],["رَشَأً إِذا ما كانَ يُطلِقُ نَفسَهُ","في فَتكِهِ أَمَرَ الحَياءُ بِحَبسِهِ",51,"س",2,0],["رَشَأٌ تَعْبُدُ النَّوَاظِرُ مِنْهُ","وَاحِداً فِي الْجَمَالِ لَيْسَ يُثَنَّى",52,"ن",2,0],["رشقتني بأسهمٍ انتضتها ال","هدْبُ عنْ قوسِ حاجبٍ مقرونِ",53,"ن",1,0],["رشفْتُ عندَ اللقا مِنْ حلوِ ريقَتِها","قَطْرَ النباتِ فزالَ البؤسُ واللهبُ",54,"ب",1,1],["رشدي وغيي وجهُهُ","فالوجهُ زاهٍ زاهرُ",55,"ر",1,0],["رَشفت مِنها سَلسلاً بارِداً","صادف نِيراني فَأَطفاها",56,"ا",3,0],["رُشِدَّتَ وَأُنعِمَت اِبنَ عَمرٍ وَإِنَّما","تَجَنَبتَ تَنوراً مِنَ النارِ حامِيا",57,"ي",2,1],["رِش نَبلَ مَن يَرمي وَراءَكَ جاهِداً","رَميَ المُناضِلِ فازَ بِالأَخطارِ",58,"ر",1,0],["رَشاشٌ كَغَربَي هاجِرِيٍّ كِلاهُما","لَهُ داجِنٌ بِالكَرَّتَينِ عَليفُ",59,"ف",1,0],["رَشَأٌ قَد زانَ طُرَّتَهُ","مَشقُ نونٍ لَيسَ بِالقَلَمِ",60,"م",1,0],["رَشأٌ كَساهُ الحُسنُ خِلعَتَهُ","وَجَرى عَلى خَدَّيهِ رَونَقُهُ",61,"ق",2,0],["رَشَأٌ تَواصَينَ القِيانُ بِهِ","حَتّى عَقَ