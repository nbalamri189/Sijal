{"poems":[[95,"ألطيب في نفحات الروض حياني","https://www.aldiwan.net/poem11224.html","البسيط"],[74,"صحا القلب لولا نسمة تتخطر","https://www.aldiwan.net/poem18693.html","الطويل"],[107,"أميطي الغيب وادرعي الشهودا","https://www.aldiwan.net/poem42134.html","الوافر"],[119,"الى اعتاب زين العابدين","https://www.aldiwan.net/poem40441.html","عموديه"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63761","الهزج"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49924","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91000","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72496","الوافر"],[4750,"يآسوريآ عذراً","https://www.poetsgate.com/ViewPoem.aspx?id=180444",""],[5198,"زهرة الريف","https://www.poetsgate.com/ViewPoem.aspx?id=135066",""],[5732,"مصايب الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=177822",""]],"verses":[["إِلَى أَعِزَّةِ هَذِي الدَّارِ مِنْ نُجُبٍ","تَاهَتْ فَخَاراً بِقَاصِيهِمْ وَبِالدَّانِي",0,"ن",2,0],["إلى أعينٍ بالماءِ نضَّاحة الصفا","إذا سدَّ منها مِنخرٌ جاش منخرُ",1,"ر",1,0],["إلى أعلامكِ الشُمِّ الرّواسي","إذا ما همَّ رُكنُكِ أن يميدا",2,"د",2,0],["الى اعتاب زين العابدين","سرت ارواح حزب العاشقين",3,"ن",1,1],["إلى أعلى قويقٍ حي","ث يلقى نَهْرُهُ نهرا",4,"ر",2,0],["إلى أَعَزّ بني الدّْنيا وأَشرَفَهم","من الأَعاجِمِ طُراً والأَعاريبِ",5,"ب",1,0],["إلى أعتابكم وافي كتابي","من الصب المشوق المستهام",6,"م",1,0],["إلى أعتابه من راح يأوى","فقد آوى إلى ركن شديد",7,"د",1,0],["إلى اعتزت فيفي وصآحت عنآيآت","قآموا لھآ مليون متضآهرينآ",8,"ن",2,0],["اليا عشقت اعشق بلا خدعة وزيف","والياعطيت اجود من غير منّي",9,"ن",2,0],["اليا عتت حمر الهموم وقادها","هاجوس فكري والضمير يجيب",10,"ب",1,0]]}