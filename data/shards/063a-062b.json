{"poems":[[53,"يا ابن الوزير الذي تمت وزارته","https://www.aldiwan.net/poem62960.html","البسيط"],[45,"قفا تريا ودقي فهاتا المخايل","https://www.aldiwan.net/poem9986.html","الطويل"],[309,"يا هاجري كم ذا تكون مهاجري","https://www.aldiwan.net/poem16862.html","الكامل"],[327,"ألا طال التنظر والثواء","https://www.aldiwan.net/poem56353.html","الوافر"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119248","الخفيف"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25370","الرجز"],[1166,"","https://poetry.dctabudhabi.ae/diwan/poem/131354","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108842","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74189","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117847","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/136089","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54363","الطويل"],[5431,"حول الحرام ترى اللسان مطقطقا","https://www.poetsgate.com/ViewPoem.aspx?id=197841",""],[5431,"جدوى الحياة....","https://www.poetsgate.com/ViewPoem.aspx?id=205102",""],[5459,"ذبح السماح","https://www.poetsgate.com/ViewPoem.aspx?id=200624",""],[5818,"الشعب واللص","https://www.poetsgate.com/ViewPoem.aspx?id=199688",""],[6152,"بلاد العُرب أوطاني","https://www.poetsgate.com/ViewPoem.aspx?id=203296",""],[6320,"نِدَاءُ اسْتِغَاثَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84333&r=&rc=30",""]],"verses":[["غثٌّ من الشعر فيه ذلُّ مسألةٍ","كلاهما يُكسِب المستور إعوارا",0,"ر",2,0],["غَثاثَةُ عَيشي أَن تَغِثَّ كَرامَتي","وَلَيسَ بِغَثٍّ أَن تَغِثَّ المَآكِلُ",1,"ل",1,0],["غثني بغيث إنني لك خاضع","عبد ذليل لا أقوم لضائر",2,"ر",1,0],["غُثاءُ السيلِ يَضرَحُ حَجرَتَيهِ","تَجَلَّلهُ مِنَ الزَبَدِ الجُفاءُ",3,"ا",2,0],["غث فأف اذا غزاك كزاز","فض خضاضا اذا أفاض غثاء",4,"ا",2,0],["غَثِيثَةُ المِلْغِ بِقَوْلٍ خِبِّ","وَاللَّهُ راعٍ عَمَلِي وَجَأْبِي",5,"ي",1,1],["غث لها أرضها فلم تبغ عنها","حولا نحو بلدة وانتقالا",6,"ل",2,0],["غث عبدك البر من دهرٍ غباوته","تستنزل الدمع من عين الفصيح دما",7,"م",2,0],["غث والها قاصِداً بِالوزر مُرتَدياً","جَنابك الرَحب يا مَن قَد سَما جاها",8,"ا",3,0],["غث من سحاب الفضل جدب قلوبنا","بمجلل لصدى البصائر صاقل",9,"ل",1,0],["غِثْ من استغاثَ بي في كل حينْ","أنت سميعٌ وبصير العالمينْ",10,"ن",1,1],["غثا بسلاحٍ عليه يطوف","وأشلاء قتلى ابترتها السيوف",11,"ف",1,0],["غثائي وغثي أنتَ حامل نقصهِ","بفضلَك إنَّ البحرَ يحتملُ الغثا",12,"ث",2,0],["غثيان تشعر بالتقيؤ كلما","صادفت وجها شاحبا بك حدقا",13,"ق",2,0],["غثاءٌ به يبدو انتمائيَ تهمة","ولا أمة ألقى ولا جنّة الفحوى!!",14,"و",2,0],["غثاء سيلٍ نحنُ ، تغتالنا","أطماعنا ، وغِيضَ ماءُ الصلاح ..",15,"ح",1,0],["غثٌّ غثاءٌ ك مثل الرمل منبطحٌ","في بطنهِ التِبْر لمْ يبطشْ ب منْ غرفا",16,"ف",2,0],["غثاءُ جمعُهم والناس صرعى","لأوهام وأفكار سقيمة",17,"م",2,0],["غُثَاءُ السَّيْلِ صَارَ لَنَا شَبِيهاً","نَهِيمُ بِلاَ هُدَىً مِثْلَ السَّوَامِ",18,"م",1,0]]}