{"poems":[[36,"خليلي مالي قد بليت ولا أرى","https://www.aldiwan.net/poem4945.html","الطويل"],[59,"أحب من الإخوان كل مواتي","https://www.aldiwan.net/poem24718.html","الطويل"],[79,"إذا أنا لم أوثر هواي على عزمي","https://www.aldiwan.net/poem36126.html","الطويل"],[44,"يقول الأرذلون بنو قشير","https://www.aldiwan.net/poem50350.html","الوافر"],[29,"أقول لأصحابي اربعوا من مطيكم","https://www.aldiwan.net/poem5950.html","الطويل"],[93,"أحب معانقة النرجس لعينيك يا ابنة كولمبس","https://www.aldiwan.net/poem8967.html","عموديه"],[93,"طوى بعض نفسي إذ طواك الثرى عني","https://www.aldiwan.net/poem62780.html","عموديه"],[72,"لئن صدقتني في الحديث ظنوني","https://www.aldiwan.net/poem42435.html","الطويل"],[72,"دعوتك لما أن بدت لي حاجة","https://www.aldiwan.net/poem42733.html","الطويل"],[30,"أحب من النساء وهن شتى","https://www.aldiwan.net/poem5414.html","الوافر"],[51,"أحب من الإخوان كل مؤات","https://www.aldiwan.net/poem10395.html","الطويل"],[68,"مملوكك اليوم أبو حبه","https://www.aldiwan.net/poem38646.html","السريع"],[71,"أحب من كلما رأتني","https://www.aldiwan.net/poem28190.html","مخلع البسيط"],[35,"ألا يا غراب البين ما لك كلما","https://www.aldiwan.net/poem25732.html","الطويل"],[35,"تذكرت ليلى والسنين الخواليا","https://www.aldiwan.net/poem25753.html","الطويل"],[107,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[104,"تحية لك يا مصر الفراعين","https://www.aldiwan.net/poem33034.html","السريع"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/11788","الطويل"],[253,"خلقت امرأ لا أخلط الجد بالهزل","https://www.aldiwan.net/poem1317.html",""],[275,"شجاني ظلام الليل والبرق يومض","https://www.aldiwan.net/poem35175.html","الطويل"],[275,"حتام يشفى الفتى والدهر يدفعه","https://www.aldiwan.net/poem35620.html","البسيط"],[275,"تذكرت ما أبلى الزمان وما غير","https://www.aldiwan.net/poem35628.html","الطويل"],[285,"أمني النفس وصلا من سعاد","https://www.aldiwan.net/poem60785.html","الوافر"],[384,"قالت سليمى إنني لا أبغيه","https://www.aldiwan.net/poem4588.html","الرجز"],[411,"أحب من الإخوان كل مهذب","https://www.aldiwan.net/poem49943.html","الطويل"],[466,"أحب مطال الوصل لا عن رضى به","https://www.aldiwan.net/poem15162.html","الطويل"],[469,"قفا في ذمام الدمع بين الملاعب","https://www.aldiwan.net/poem3188.html","عموديه"],[545,"عاتب النفس والفؤاد الغويا","https://www.aldiwan.net/poem56637.html","الخفيف"],[556,"على من ثوى أرض الحجاز تحية","https://www.aldiwan.net/poem47340.html","الطويل"],[556,"لقل غناء العتب والمجرم الدهر","https://www.aldiwan.net/poem47826.html","الطويل"],[556,"أحب من ليس حظ في مودته","https://www.aldiwan.net/poem47873.html","البسيط"],[556,"هل شافع لي إلى نعم وسيلتها","https://www.aldiwan.net/poem47879.html","البسيط"],[563,"ظهرت لي يا غيب يا مطلق","https://www.aldiwan.net/poem34302.html","السريع"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66763","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119917","الوافر"],[1099,"","https://poetry.dctabudhabi.ae/diwan/poem/27034","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108882","السريع"],[1660,"","https://poetry.dctabudhabi.ae/diwan/poem/72148","الوافر"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69406","الوافر"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76793","البسيط"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199812","المسحوب"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77242","الوافر"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137232",""],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109829","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202009","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200871","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203478","الوافر"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132534","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130042","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62826","الوافر"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48319","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108391",""],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32794","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59452","الطويل"],[3856,"","https://poetry.dctabudhabi.ae/diwan/poem/124138","السريع"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119396","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94712","الطويل"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99118","البسيط"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52155","الوافر"],[4045,"أأحزنك الأولى ردّوا","https://www.poetsgate.com/ViewPoem.aspx?id=200274",""],[5277,"سرُّ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=188635",""],[592,"رسائل أخوان الصفا والتودد","https://www.poetsgate.com/ViewPoem.aspx?id=128837",""],[5363,"مفخرة الإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=144431",""],[5431,"لعلي أصحصحُ !!","https://www.poetsgate.com/ViewPoem.aspx?id=215648",""],[5956,"هي الماضي والمستقبل","https://www.poetsgate.com/ViewPoem.aspx?id=182326",""],[5956,"تسجيل وتصوير ليلة دخلة عريس","https://www.poetsgate.com/ViewPoem.aspx?id=182669",""],[5956,"الحنوُّ الغزير","https://www.poetsgate.com/ViewPoem.aspx?id=192936",""],[6000,"أحب من الدُّنْيَا إِلَيّ وَمَا حوت","https://www.poetsgate.com/ViewPoem.aspx?id=189381",""],[6167,"لا رجعية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85486&r=&rc=15",""],[6267,"ألاَ حَيِّ لُبْنَى اليَوْمَ إنْ كُنْتَ غادِيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=8357&r=&rc=65",""]],"verses":[["أُحِبُّ مِنَ الأسماءِ ما وافَقَ اِسمَها","وَأَشبَهَهُ أَو كانَ مِنهُ مُدانِيا",0,"ي",2,0],["أُحِبُّ مِنَ الإِخوان كُلَّ مُواتي","وَكُلَّ غَضيضِ الطَرفِ عَن عَثَراتي",1,"ت",2,1],["أَحَبُّ مِنَ الْمَحْيَا وأَجْدَى مِنَ الْحَيَا","وَأَهْدَى لِمَنْ ضَلَّ الْسَّبيلَ مِنَ النَّجْمِ",2,"م",1,0],["أُحِبُّ مُحَمَّداً حُبّاً شَديداً","وَعَبّاساً وَحَمزَةَ وَالوصِيّا",3,"ي",2,0],["أُحِبُّ مِنَ الفِتيانِ مِثلَ مُحَرِّقٍ","وَشَيبانَ إِنَّ الكامِلينَ قَليلُ",4,"ل",1,0],["أُحِبُّ مُعانَقَةَ النَرجِسِ","لِعَينَيكِ يا اِبنَةَ كولَمبُسِ",5,"س",1,1],["أَحَبُّ مِنَ الأَبراجِ طالَت قِبابُها","وَأَجمَلُ في عَينَيَّ مِن أَجمَلِ المُدنِ",6,"ن",1,0],["أُحِبُّ مِنَ الأَشياءِ ماكانَ فائِقاً","وَما الدونُ إِلّا مَن يَميلُ لَدونِ",7,"ن",1,0],["أُحِبُّ مِنَ الظَبيِ الغَريرِ تَلَفُّتاً","وَأَهوى مِنَ الغُصنِ النَضيرِ تَفَتُّلا",8,"ل",2,0],["أَحَبُّ مِنَ النِساءِ وَهُنَّ شَتّى","حَديثَ النَزرِ وَالحَدَقَ الكِلالا",9,"ل",2,1],["أُحِبُّ مِنَ الإِخوانِ كُلَّ مُؤاتِ","وَفِيٍّ يَغُضُّ الطَرفَ عَن عَثَراتي",10,"ت",2,1],["أُحِبُّ مِن في نَفسِهِ خِسَّةٌ","وَالجِنسُ مَيّالٌ إِلى الجِنسِ",11,"س",1,0],["أحبُّ مَنْ كلَّما رأتني","في وجهها للرضى دليلُ",12,"ل",1,1],["أُحِبُّ مِنَ الأَسماءِ ما وافَقَ اِسمَها","أَوَ اَشبَهَهُ أَو كانَ مِنهُ مُدانِيا",13,"ي",2,0],["أُحِبُّ مِنَ الأَسماءِ ما وافَقَ اِسمُها","وَشابَهَهُ أَو كانَ مِنهُ مُدانِيا",14,"ي",2,0],["أحبَّ من الخيانةِ ما أحبّا","يُريدُ العَيشَ مُحتقَراً ذليلا",15,"ل",2,0],["أُحب مصر وَلَكن مصرَ راغِبَة","عَني فتعرض مِن حين إِلى حين",16,"ن",1,0],["أُحِبُّ مِنَ الرَسماءِ ما وافَقَ اِسمَها","وَأَشبَهَهُ أَو كانَ مِنهُ مُدانِيا",17,"ي",2,0],["احب من الاقوال ما كان صادقا","وارضى من الافعال ما جاز في العقل",18,"ل",1,0],["أُحبُّ من الظلماءِ إرخاءَ سِترِها","عليَّ وأفكاري عليهِ تُنضنض",19,"ض",1,0],["أُحبُّ مَوجَكِ حباً للتي وقفَت","عليهِ يوماً وقد جاءت تُوَدِّعه",20,"ع",2,0],["أُحبُّ مساءً جاءَ يُرخي على الوَرى","من الأفقِ الوردي برقعَهُ الأكدر",21,"ر",1,0],["أُحِبُّ مَكَارِمَ الأَخْلاَقِ مِنْهُ","وَأَعْشَقُ دَوْلَةَ الْمَلِكَ الْجَوَادِ",22,"د",1,0],["أحب ما اصطاد مكان يخليه","ذو ذنبان يستطيل راعيه",23,"ي",2,0],["أحبُّ من الإخوانِ كُلَّ مُهَذَّبٍ","ظريفِ السَّجايا طيَّبِ العَرْفِ والنَّشْرِ",24,"ر",1,1],["أُحبُّ مطال الوصل لا عن رضىً به","وهل ترتضي نفس الفتى ما يؤودها",25,"د",3,1],["أُحبُّ من الأغصان كلَّ مهفهفٍ","حكى في التثني كل هيفاءَ كاعب",26,"ب",1,0],["أُحْبُ مَدحاً أَبا مُعاويَةَ الما","جدَ لا تلقَهُ حَصوراً عَييّا",27,"ي",2,0],["أُحِبُّ مناخاً بالحجاز تعاصفتْ","إلينا بريّاه صَباً وشَمولُ",28,"ل",1,0],["أحبُّ من الفتيان كلَّ مشيَّعٍ","عصيٍّ فلا نهىٌ عليه ولا أمرُ",29,"ر",1,0],["أُحِبُّ مَنْ ليس حظٌّ في مودّتِهِ","وَليسَ إلّا الهَوى والهمُّ والكَمَدُ",30,"د",1,1],["أُحِبُّ منكِ وإنْ ماطَلْتِ عن أرَبي","وعداً وكم أخلف الميعاد من يَعدُ",31,"د",1,0],["أحب مولاه ولا يستطع","إدراكه وهو له يعشق",32,"ق",1,0],["أحبُّ من آمن بالله ولم","يشرك به طُرفةَ عينٍ في الأزَلْ",33,"ل",1,0],["أحب مديحه علما بأني","وام أفرط فيبه لا أحوب",34,"ب",1,0],["أُحِبُّ مِن كَنَفي بُحار","وَما رَأَتِ الخَواطِبُ مِن نِساحِ",35,"ح",1,0],["أحب من درياق منظومة","داوي بها اِبراهيم لب السليم",36,"م",1,0],["أحب مكارم الأخلاق جهدي","وأكره أن أعيب وأن أعابا",37,"ب",2,1],["أُحِبُّ مِنَ السَمادِعِ كُلَّ نَدبٍ","كَريمِ الخِيمِ مَأمُونِ اللِسانِ",38,"ن",1,0],["أُحِبُّ مَن حَبَّهُم مِن أَجلِ مَن صَحِبوا","أَجَل وَأُبغِضُ مَن يُعزَى لِبُغضِهِمِ",39,"م",1,0],["أحبّ من حبّك ردود المراسيل","منشود لك منّي على ردّ منشود",40,"د",1,0],["أُحِبّ مِنَ الحُروفِ النونَ أَنّى","أَرى قُربى لَها بِك واِنتِسابا",41,"ب",2,1],["احب مزايا فيك يعبق نشرها","على انها اذكى من المسك والند",42,"د",1,0],["احب من عين ذات خدر","مقرونة الحاجبين كحلا",43,"ل",2,0],["أُحب من الحسن أنواعه","وأهوى الغرام وأشياعه",44,"ه",1,1],["أحبّ مشاهدةً للأنام","وأُبغِض منهم سماعَ الكلام",45,"م",1,1],["أحب محبتي لهم وإن لم","أحبهم وقد بانوا طغاما",46,"م",2,0],["أحب من الفتيان أروع ماجداً","عفيفاً شريف النفس تزكو ضرائبه",47,"ب",2,0],["أحبّ مصر وأَهليها وإن غبنوا","وأَستشيط لهم من عزّة غضبا",48,"ب",2,0],["أُحب من الفتينِ كلّ غَشَمْشَمٍ","له شيع من عزمِه وعديدُ",49,"د",1,0],["أُحِبُّ منَ الأمْداحِ ما فيكَ نظْمُهُ","وما البِرُّ إلا أنْ أُرَى منهُ مُنْفِقا",50,"ق",2,0],["احب من المعتاص قرع صفاتهِ","وكل قناةٍ ان اكون مقوما",51,"م",2,0],["أُحِبُّ مِنَ الإِخوانِ كُلَّ مواتِ","وَكُلَّ غَضيضِ الطَرفِ عَن هَفَواتي",52,"ي",1,1],["أحبُّ من الندمانِ كل مُطرّبٍ","وكل غَّضيضِ الطرفِ عن عثراتي",53,"ت",2,0],["احب مولاهُ بصدق فلا","يقدر ان يفتر عن ذكره",54,"ر",2,0],["أحب من الحلواء ما كان مشبهاً","بنان عروس في حبير معصب",55,"ب",1,1],["أحب من الآرام والعين نظرةً","وكم ذوَّبوا بالهجر قلباً ومقلةً",56,"ه",1,0],["أحب منك وإن لج العوازل في","لومي دلال الرضا في نخوة الصلف",57,"ف",1,0],["أَحَبُّ مِن الكهولةِ وهي حق","خيالٌ للطُّفولة زار حينا",58,"ن",2,0],["أحبّ من الغناء ملي","ح ما إيقاعه الهزج",59,"ج",1,0],["أُحِبُّ مُعَذّبي إنّي","وَجَدْتُ هُنا بِهِ سِحْرَهْ",60,"ر",2,0],["أحب من الأولاد والنفس بل ومن","جميع الورى والمال من كل أتلد",61,"د",1,0],["أحبُّ محمداً حبّاً عظيماً","فيا ربّاه ألهمْني وفائي",62,"ا",2,0],["أحبُ مذاقَ البدر عند اكتماله","مذاقٌ على حلقي من الشهد أملحُ",63,"ح",1,0],["أحب معيشتي معها","كأني الطائر النادرْ",64,"ر",1,0],["أحب معاني الغموضِ العميقِ","تنيرُ بأفقيَ سِرَّ العُمُرْ",65,"ر",1,0],["أُحِبُّ مُحَمّدَ مثلَ أبيهِ","فمِنْ يَدِهِ نِلتُ أحلاميهْ",66,"ي",2,0],["أحب من الدُّنْيَا إِلَيّ وَمَا حوت","غزال تبدي لي بكأس رحيق",67,"ق",1,1],["أُحبُّ مآثرى وأُعزُّ أمسى","ولكنى بحبِّ غدٍ أُجاهِرْ",68,"ر",1,0],["أُحِبُّ مِنَ الأَسْمَاءِ ما وَافَقَ کسْمَهَا","وأشبَهه أو كان مِنهُ مُدانِيا",69,"ي",2,0]]}