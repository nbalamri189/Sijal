at=shqas&qid=78505&r=&rc=3",""]],"verses":[["قَعاقِعُهُنَّ تُشَنُّ الحُتوفَ","إِذا هُنَّ أَوعَدنَ لا بِالشِنانِ",0,"ن",1,0],["قَعَدَ الراضونَ بِالذُلِّ فَقُم","إِنَّما الماضي إِذا هَمَّ عَزَم",1,"م",1,1],["قَعِدٌ عَنِ الغُنمِ القَريبِ المُجتَبى","سَرِعٌ إِلى الطَلبِ البَعيدِ المَنزَعِ",2,"ع",1,0],["قَعوا وِقعَةَ الساري فَقَد طالَ حَثُّكُم","إِلى العارِ أَعناقَ المَطِيِّ الدَلائِثِ",3,"ث",1,0],["قَعَدتُ بِمَدرَجَةِ النائِباتِ","يُمِرُّ الزَمانُ عَلَيَّ الخُطوبا",4,"ب",2,0],["قَعَدْتَ للإنْصافِ بيْنَ الوَرى","فاطْلُبْ لَنا الإنْصافَ منْ نفْسِكْ",5,"ك",1,0],["قَعَدْتُ لتَذْكيرٍ ولوْ كُنْتُ منْصِفاً","لذكّرتُ نفْسي فهْيَ أحْوَجُ للذِّكْرى",6,"ر",2,1],["قَعَدَت شُعوبُ الشَرقِ عَن","كَسبِ المَحامِدِ وَالمَفاخِر",7,"ر",1,1],["قَعَدَ الفَضلُ بي وَقُمتُ بِعِزّي","بَينَ صَحبي جُزيتَ خَيرَ الجَزاءِ",8,"ا",2,0],["قَعيدَكِ أَنّى زُرتِ ضَوؤُكِ ساطِعٌ","وَطيبُكِ نَفّاحٌ وَحَليُكِ هادِلُ",9,"ل",1,0],["قَعَدتُ لَهُ وَصُحبَتي بَينَ حامِرٍ","وَبَينَ إِكامِ بُعدَ ما مُتَأَمَّلِ",10,"ل",1,0],["قَعَدتُ لَهُ وَصُحبَتي بَينَ ضارِجٍ","وَبَينَ تِلاعِ يَثلُثٍ فَالعَريضِ",11,"ض",1,0],["قَعَدتُ لَهُ حتىعَلا الأَفقَ ماؤُهُ","وَسالَ بِفَعمِ الوَبلِ مِنهُ الدَوافِقُ",12,"ق",1,0],["قَعَدتُ لَهُ ذاتَ العِشاءِ أَشيمُهُ","بِمَرٍّ وَأَصحابي بِجُبَّةِ أَذرُحِ",13,"ح",1,0],["قَعَدْت وَالحُزْنُ لِي أَلِيفٌ","فِي كُلِّ آنٍ وَكُلِّ أَيْنِ",14,"ن",1,0],["قعدتم عن السعي المؤدّي إلى العلا","على حين يُزري بالرجال قُعودها",15,"د",3,0],["قَعَدَت قُفَيرَةُ بِالفَرَزدَقِ بَعدَما","جَهَدَ الفَرَزدَقُ جُهدَهُ لا يَأتَلي",16,"ل",2,0],["قَعَدتُ وَحدي لَهُ وَقالَ أَبو","لَيلى مَتى يَغتَمِن فَقَد دَأَبا",17,"ب",2,0],["قعدت بهم هِمَّاتهم وسمت به","همم الملوك وسورة الأبطال",18,"ل",1,0],["قعدَ العُفاةُ وسيبُهُ","يَختبُّ نحوهُمُ اختبابهْ",19,"ب",2,0],["قَعيدَكِ عَمرَ اللَهِ هَل تَعلَمِينَني","كَريماً إِذا اِسوَدَّ الأَنامِلُ أَزهَرا",20,"ر",2,0],["قَعَدوا عَلى أَكوارِها فَتَرَدَّفَت","صَخِبَ الصَدى جَذَعَ الرِعانِ رَجيلا",21,"ل",2,0],["قعدنا معقد الآباء منه","فكنا البَهم قد خلف السباعا",22,"ع",2,0],["قَعدَ الآلُ لِلعَزاءِ وَقامَت","باكِياتٍ عَلى الحُسَينِ الفَواطِم",23,"م",1,0],["قَعَدنَ فَكُنَّ الأَساسَ المَتينَ","وَقامَ عَلَيها البِناءُ المَشيد",24,"د",1,0],["قَعَدتِ مِنَ الأَظعانِ في مَقطَعَ السُرى","وَمَرّوا رِكاباً في غُبارِ رِكابِ",25,"ب",1,0],["قَعَدَ الشَرقُ عَلَيهِم مَأتَما","وَاِنثَنى الغَربُ بِهِم في عُرُسِ",26,"س",1,0],["قَعَدنا فَلَم يَعدَم فَتى الرومِ فَيلَقاً","مِنَ الرُعبِ يَغزوهُ وَآخَرَ يَسلُبُ",27,"ب",1,0],["قَعَدَ الناسُ كُلُّهُم عَن مَساعي","كَ وَقامَت بِها القَنا وَالنُصولُ",28,"ل",1,0],["قَعَدوا وَأَينَ قِيامُ مَن قَد طُلنَهُ","شُرُفاتُ ما تَبني ذُراً وَقَواعِدا",29,"د",2,0],["قَعقَعتُ لِلبُخَلاءِ أَذعَرُ جَأشَهُم","وَنَذيرَةٌ مِن باتِكٍ أَن يُنتَضى",30,"ض",2,0],["قُعودٌ لَدى الأَبوابِ طُلّابُ حاجَةٍ","عَوانٍ مِنَ الحاجاتِ أَو حاجَةٍ بِكرا",31,"ر",2,0],["قُعودُكَ في الشَربِ الكِرامِ بَلِيَّةٌ","وَرَأسُكَ في الإِكليلِ إِحدى الكَبائِرِ",32,"ر",1,1],["قُعوداً وَخَلفَ القاعِدينَ سُطورَهُم","جُنوحٌ وَأَيديهِم جُموسٌ وَنُطَّفُ",33,"ف",1,0],["قُعودٌ بِأَبوابِ الزُروبِ وَلا تَرى","لَهُم شاهِداً عِندَ الأُمورِ العَظائِمِ",34,"م",1,0],["قَعيدَكُما اللَهَ الَّذي أَنتُما لَهُ","أَلَم تَسمَعا بِالبَيضَتَينِ المُنادِيا",35,"ي",2,0],["قَعدتَ وكم نهضتَ إلى التَّصابي","بنَقرِ الدُّفِّ تُوسِعُ فِيه خَطْوا",36,"و",2,0],["قُعودُها عَن قَضاءِ حَقٍ","لِعُذرِ مَن لامَني يُقيمُ",37,"م",1,0],["قعاقعُ دُهْمٍ أسهرَتْكَ وطالما","أنامتْكَ بِيضٌ أسْمَرَتْكَ الأغانيا",38,"ي",2,0],["قَعَستُ لَهُ حَتّى التَقيتَ سِهامَهُ","وَأَثبَتَّ في تامورِهِ الحُجَجَ اللُدّا",39,"د",2,0],["قَعَد الشُّيوخُ عن النّضالِ وهذه","دُنيا الشّبابِ فبوركَ الأبطالُ",40,"ل",1,0],["قَعدتَ فلما كَرِهتَ القُعودَ","نَفرت حَثيثاً إلى المَلْحَمَهْ",41,"م",2,0],["قَعقَعتُ حِضنَي حاجِزٍ وَصِحابُهُ","وَقَد نَبَذوا خُلقانَهُم وَتَشَنَّعوا",42,"ع",3,1],["قَعَدتُ فَلَم أُرسِل وَلا أَرسَلُوا هُمُ","بِشَيءٍ إِلَينا صاحِ حَولاً مُجَرَّما",43,"م",2,0],["قَعَدَ الزّمانُ عن المكارم والعُلى","إنَّ الزّمان السَّوءَ غيرُ رشيد",44,"د",1,0],["قُعوداً حَولَ دَسكَرَتي وَعِندي","كَأَنَّ لَهُم عَلَيَّ فُضولَ مالِ",45,"ل",1,0],["قَعيدَكَ أَن يَنسى اِمرُؤٌ أَنتَ هَمُّهُ","تَلالا عَلَيهِ الهَمُّ لا يَبرَحُ الخَلدا",46,"د",2,0],["قَعيدُكِ أُخرى لا تَبيعُ مَوَدَّتي","بِوُدٍّ وَلا تَخشى إِذا ما تَوَلَّتِ",47,"ت",1,0],["قَعيدَكَ أَن تَنهى اِمرَأً عَن طِباعِهِ","يَجودُ وَيَغدو ناصِباً بِعَتيبِ",48,"ب",1,0],["قَعَدَ الأَغَرُّ لَدى الكَريهَةِ وَالَّذي","عِندَ المَلاحِمِ يُشتَفى بِضِرابِهِ",49,"ب",2,0],["قُعوداً لَهُ غَسّانُ يَرجونَ أَوبَهُ","وَتُركٌ وَرَهطُ الأَعجَمينَ وَكابُلُ",50,"ل",1,0],["قُعوداً عَلى آلِ الوَجيهِ وَلاحِقٍ","يُقيمونَ حَولِيّاتِها بِالمَقارِعِ",51,"ع",1,0],["قُعوداً لَدى أَبياتِهِم يَثمِدونَها","رَمى اللَهُ في تِلكَ الأُنوفِ الكَوانِعِ",51,"ع",1,0],["قعدت له من آخر الليل بعدما","علا النجم أفراع الذرى من يلملم",52,"م",1,0],["قَعَدتُ عَنِ المَجدِ مِن بَعدِهِ","وَسُدَّت سَبيلي وَلا مَسلَكا",53,"ك",2,0],["قعدت لتذكير ولو كنت منصفا","لذكرت نفسي فهي أحوج للذكرا",54,"ر",2,1],["قُعُوداً لَدَى أبياتِهِمْ يَشْمِدونَها","، رمى اللهُ في تلكَ الأنوفِ الكوانعِ",55,"ع",1,0],["قُعوداً لَدى حَطمِ الحَجونِ كَأَنَّهُم","مَقاوِلَةٌ بَل هُم أَعَزُّ وَأَمجَدُ",56,"د",1,0],["قعيدةُ الخدرِ فما","تعرِفُ إلا المِغزَلا",57,"ل",2,0],["قَعَدوا عَنِ الغِيَرِ الَّتي ناهَضتَها","وَاِستَبعدوا الأَمَدَ الَّذي تَستَقرِبُ",58,"ب",1,0],["قَعَدتَ وَالقَومُ قائِمونَ كَما","قُمتَ بِصَرفِ الخُطوبِ إِذ قَعَدوا",59,"د",3,0],["قَعَدنا بِأَكبادٍ نُقاسي وَلوعَها","لِأَشتاتِ آفاتٍ نَخافُ وُقوعَها",60,"ه",2,0],["قُعودي وَقَد سارَ الحَجيجُ ضَرورَةٌ","وَفي الصَدرِ قَلبُ لا يَزالُ يُحَرَّقُ",60,"ق",1,0],["قَعَدَتُ لهُ ذَاتَ العِشَاءِ أُشِيمُهُ","وَأَنظُرُ مِن أَينَ استَقَلَّت مَطَالِعُه",61,"ع",2,0],["قعود الورى عن طاعة الله بعدما","عذاهم بألطاف الغذا وهو الرب",62,"ب",1,0],["قعدت لديه معولاً وسِياقُه","يقومُ بنفسي تارةً ثم يَقْعُدُ",63,"د",1,0],["قَعَدتَ عَن نَصري وَعَهدي بِكَ لا","أَدعوكَ إِلّا قُمتَ مَشبوحَ العُضُد",64,"د",1,0],["قعدت تفسين فوق طنفستي","ما بين راحي وبين ريحاني",65,"ن",2,0],["قَعَدَ الهُدَى فأقَامَهُ بِمَضَائِهِ","وَمَضَى النَّدَى فأَعَادَهُ بِلُهاهُ",66,"ا",2,0],["قَعِيدَةٌ للعُلَى قامَتْ علَى عَمَدٍ","مَصْفُوفَة حسْنُها يُزرِي ب