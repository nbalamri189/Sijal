{"poems":[[53,"نعوه على ضن قلبي به","https://www.aldiwan.net/poem29746.html","المتقارب"],[53,"قعد الراضون بالذل فقم","https://www.aldiwan.net/poem29750.html","الرمل"],[53,"لو كان يرتدع القضاء بمردع","https://www.aldiwan.net/poem30148.html","الكامل"],[53,"خذوا نفثات من جوى القلب نافث","https://www.aldiwan.net/poem30663.html","الكامل"],[53,"أودع في كل يوم حبيبا","https://www.aldiwan.net/poem30733.html","المتقارب"],[77,"يا قاضي العدل الذي لم تزل","https://www.aldiwan.net/poem35878.html","السريع"],[77,"قعدت لتذكير ولو كنت منصفا","https://www.aldiwan.net/poem36476.html","الطويل"],[86,"قعدت شعوب الشرق","https://www.aldiwan.net/poem10860.html","مجزوء الكامل"],[86,"لي كساء أنعم به من كساء","https://www.aldiwan.net/poem68838.html","الخفيف"],[73,"مرادهم حيث السلاح خمائل","https://www.aldiwan.net/poem11930.html","الطويل"],[0,"قفا نبك من ذكرى حبيب ومنزِل","https://www.aldiwan.net/poem50.html","الطويل"],[0,"أعني على برق أراه وميضِ","https://www.aldiwan.net/poem54.html","الطويل"],[35,"أشاقك برق آخر الليل خافق","https://www.aldiwan.net/poem39128.html","الطويل"],[35,"وإنك عمري هل ترى ضوء بارق","https://www.aldiwan.net/poem39171.html","الطويل"],[93,"يا ولدي اللذين غابا","https://www.aldiwan.net/poem11161.html","مخلع البسيط"],[88,"أما آن أن يغشى البلاد سعودها","https://www.aldiwan.net/poem44836.html","الطويل"],[27,"لمن الديار كأنها لم تحلل","https://www.aldiwan.net/poem5967.html","الكامل"],[4,"طافت أسيماء بالرحال فقد","https://www.aldiwan.net/poem21147.html","المنسرح"],[37,"هلا سألت معالم الأطلال","https://www.aldiwan.net/poem7428.html","الكامل"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[14,"تحن إلى سلمى بحر بلادها","https://www.aldiwan.net/poem38305.html","الطويل"],[38,"ما بال دفك بالفراش مذيلا","https://www.aldiwan.net/poem7807.html","الكامل"],[85,"أعرني النجم أوهب لي يراعا","https://www.aldiwan.net/poem7102.html","الوافر"],[85,"لك في الأرض والسماء مآتم","https://www.aldiwan.net/poem11330.html","الخفيف"],[85,"أصاب المجاهد عقبى الشهيد","https://www.aldiwan.net/poem62887.html","المتقارب"],[85,"سماؤك يا دنيا خداع سراب","https://www.aldiwan.net/poem62924.html","الطويل"],[85,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[43,"مالنا كلنا جو يا رسول","https://www.aldiwan.net/poem9980.html","الخفيف"],[45,"من رقبة أدع الزيارة عامدا","https://www.aldiwan.net/poem63545.html","الكامل"],[45,"ترك السواد للابسيه وبيضا","https://www.aldiwan.net/poem64626.html","الكامل"],[28,"تذكر هذا القلب من شوقه ذكرا","https://www.aldiwan.net/poem5056.html","الطويل"],[28,"قعودك في الشرب الكرام بلية","https://www.aldiwan.net/poem5180.html","الطويل"],[28,"وجاء قريع الشول قبل إفالها","https://www.aldiwan.net/poem5338.html","البسيط"],[28,"ما نحن إن جارت صدور ركابنا","https://www.aldiwan.net/poem5609.html","الطويل"],[28,"ألم تر أني يوم جو سويقة","https://www.aldiwan.net/poem5654.html","الطويل"],[61,"سألت الله مما كان عفوا","https://www.aldiwan.net/poem51398.html","الوافر"],[66,"وعدكم بالندى سقيم","https://www.aldiwan.net/poem38743.html","مجزوء البسيط"],[80,"أباد حياتي الموت إن كنت ساليا","https://www.aldiwan.net/poem31246.html","الطويل"],[44,"أتاني ورحلي بالعذيب عشية","https://www.aldiwan.net/poem30600.html","الطويل"],[105,"لا اليوم يومك إذ ولدت ولا الغد","https://www.aldiwan.net/poem41933.html","الكامل"],[105,"لك الله أقبل أبا خيثمه","https://www.aldiwan.net/poem44026.html","المتقارب"],[13,"قعقعت حضني حاجز وصحابه","https://www.aldiwan.net/poem2221.html","الطويل"],[40,"أقول عشاء للطويل تعجبا","https://www.aldiwan.net/poem42335.html","الطويل"],[75,"قل للمليك ابن الملوك الصيد","https://www.aldiwan.net/poem69088.html","الكامل"],[50,"وكيف يخف لي بصري وسمعي","https://www.aldiwan.net/poem62292.html","البسيط"],[50,"خليلي غضا ساعة وارحلا بردا","https://www.aldiwan.net/poem63877.html","الطويل"],[50,"تخليت من صفراء لا بل تخلت","https://www.aldiwan.net/poem64748.html","الطويل"],[50,"ذكرت شبابي اللذ غير قريب","https://www.aldiwan.net/poem64805.html","الكامل"],[50,"ما رد سلوته إلى إطرابه","https://www.aldiwan.net/poem64822.html","الكامل"],[7,"دعاك الهوى واستجهلتك المنازل","https://www.aldiwan.net/poem1979.html","الطويل"],[7,"ليهنئ بني ذبيان أن بلادهم","https://www.aldiwan.net/poem1982.html","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43734","المتقارب"],[77,"قعدت لتذكير ولو كنت منصفا","https://www.poetsgate.com/ViewPoem.aspx?id=34110",""],[7,"ليهنئ بني ذبيانَ أنّ بلادهمْ","https://www.poetsgate.com/ViewPoem.aspx?id=17578",""],[135,"ألا هل أتى بحرينا صنع ربنا","https://www.aldiwan.net/poem20995.html","الطويل"],[143,"قلت لعمرو جذلا","https://www.aldiwan.net/poem58372.html","مجزوء الرجز"],[144,"ما لي مقال عن فعالك يعرب","https://www.aldiwan.net/poem11728.html","الكامل"],[144,"قصر عن سعيك الألى جهدوا","https://www.aldiwan.net/poem11756.html","المنسرح"],[151,"دموع على الخدين ترسل مزنها","https://www.aldiwan.net/poem68585.html","الطويل"],[182,"أعنى على برق أريك وميضه","https://www.aldiwan.net/poem58764.html","الطويل"],[187,"رويدا أيا إسحاق واسمع فإنني","https://www.aldiwan.net/poem44118.html","الطويل"],[199,"مصابك ما كر الجديدان سرمد","https://www.aldiwan.net/poem51953.html","الطويل"],[236,"لكل ما طال به الدهر أمد","https://www.aldiwan.net/poem32095.html","الرجز"],[257,"قومي تنحي فلست من شأني","https://www.aldiwan.net/poem48560.html","المنسرح"],[276,"أما الكثيب فما يطار حماه","https://www.aldiwan.net/poem25463.html","الكامل"],[276,"طنب قبابك هذا العز والشرف","https://www.aldiwan.net/poem25479.html","البسيط"],[281,"لك الخير قد أنحى علي زماني","https://www.aldiwan.net/poem60787.html","الطويل"],[299,"قفا عللا قبل التفرق عانيا","https://www.aldiwan.net/poem36278.html","عموديه"],[323,"أشتقت وانهل دمع عينك أن","https://www.aldiwan.net/poem56345.html","المنسرح"],[352,"قعدت من فوق عرد لابن فرناس","https://www.aldiwan.net/poem68979.html","البسيط"],[380,"يا أسم أسقاك البريق الوامض","https://www.aldiwan.net/poem4560.html","الرجز"],[394,"قعقعة الثلج بماء عذب","https://www.aldiwan.net/poem53615.html","الرجز"],[417,"جد في وجده بكم فعلاما","https://www.aldiwan.net/poem53970.html","الخفيف"],[433,"طار عن برقة برق فشم","https://www.aldiwan.net/poem12350.html","الرمل"],[440,"بسعدك لا بسعد أو سعاد","https://www.aldiwan.net/poem34782.html","الوافر"],[459,"قالوا عساك مرجم فتبين","https://www.aldiwan.net/poem55859.html","الكامل"],[459,"قد قنعنا أن نرقب الأحلاما","https://www.aldiwan.net/poem55874.html","الخفيف"],[459,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[459,"تموق الليالي فيكم ثم تعقِل","https://www.aldiwan.net/poem55908.html","الطويل"],[459,"وجد الجميم فعافه وتبقلا","https://www.aldiwan.net/poem55960.html","الكامل"],[459,"ما للدسوت وللسروج تسائل","https://www.aldiwan.net/poem56069.html","الكامل"],[459,"وكنت وأيام المزار رخية","https://www.aldiwan.net/poem56127.html","الطويل"],[459,"لمن صاغيات في الحبل طلائح","https://www.aldiwan.net/poem56246.html","الطويل"],[462,"أسر بالبرق لا حرصا على الديم","https://www.aldiwan.net/poem16089.html","البسيط"],[465,"أما وبنات الفكر حلفة فاضل","https://www.aldiwan.net/poem3336.html","عموديه"],[514,"أبى لي الوفاء دوام الجفا","https://www.aldiwan.net/poem67694.html","المتقارب"],[544,"ليس يغني القول إلا لامرئ","https://www.aldiwan.net/poem1759.html","الرمل"],[552,"أهاجك ذكر منهم ووساوس","https://www.aldiwan.net/poem47756.html","الطويل"],[552,"قفا بي على تلك الطلول الرثائث","https://www.aldiwan.net/poem48019.html","الطويل"],[554,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[583,"قعيدك يا يزيد أبا قبيس","https://www.aldiwan.net/poem1747.html","الوافر"]],"verses":[["قَعاقِعُهُنَّ تُشَنُّ الحُتوفَ","إِذا هُنَّ أَوعَدنَ لا بِالشِنانِ",0,"ن",1,0],["قَعَدَ الراضونَ بِالذُلِّ فَقُم","إِنَّما الماضي إِذا هَمَّ عَزَم",1,"م",1,1],["قَعِدٌ عَنِ الغُنمِ القَريبِ المُجتَبى","سَرِعٌ إِلى الطَلبِ البَعيدِ المَنزَعِ",2,"ع",1,0],["قَعوا وِقعَةَ الساري فَقَد طالَ حَثُّكُم","إِلى العارِ أَعناقَ المَطِيِّ الدَلائِثِ",3,"ث",1,0],["قَعَدتُ بِمَدرَجَةِ النائِباتِ","يُمِرُّ الزَمانُ عَلَيَّ الخُطوبا",4,"ب",2,0],["قَعَدْتَ للإنْصافِ بيْنَ الوَرى","فاطْلُبْ لَنا الإنْصافَ منْ نفْسِكْ",5,"ك",1,0],["قَعَدْتُ لتَذْكيرٍ ولوْ كُنْتُ منْصِفاً","لذكّرتُ نفْسي فهْيَ أحْوَجُ للذِّكْرى",6,"ر",2,1],["قَعَدَت شُعوبُ الشَرقِ عَن","كَسبِ المَحامِدِ وَالمَفاخِر",7,"ر",1,1],["قَعَدَ الفَضلُ بي وَقُمتُ بِعِزّي","بَينَ صَحبي جُزيتَ خَيرَ الجَزاءِ",8,"ا",2,0],["قَعيدَكِ أَنّى زُرتِ ضَوؤُكِ ساطِعٌ","وَطيبُكِ نَفّاحٌ وَحَليُكِ هادِلُ",9,"ل",1,0],["قَعَدتُ لَهُ وَصُحبَتي بَينَ حامِرٍ","وَبَينَ إِكامِ بُعدَ ما مُتَأَمَّلِ",10,"ل",1,0],["قَعَدتُ لَهُ وَصُحبَتي بَينَ ضارِجٍ","وَبَينَ تِلاعِ يَثلُثٍ فَالعَريضِ",11,"ض",1,0],["قَعَدتُ لَهُ حتىعَلا الأَفقَ ماؤُهُ","وَسالَ بِفَعمِ الوَبلِ مِنهُ الدَوافِقُ",12,"ق",1,0],["قَعَدتُ لَهُ ذاتَ العِشاءِ أَشيمُهُ","بِمَرٍّ وَأَصحابي بِجُبَّةِ أَذرُحِ",13,"ح",1,0],["قَعَدْت وَالحُزْنُ لِي أَلِيفٌ","فِي كُلِّ آنٍ وَكُلِّ أَيْنِ",14,"ن",1,0],["قعدتم عن السعي المؤدّي إلى العلا","على حين يُزري بالرجال قُعودها",15,"د",3,0],["قَعَدَت قُفَيرَةُ بِالفَرَزدَقِ بَعدَما","جَهَدَ الفَرَزدَقُ جُهدَهُ لا يَأتَلي",16,"ل",2,0],["قَعَدتُ وَحدي لَهُ وَقالَ أَبو","لَيلى مَتى يَغتَمِن فَقَد دَأَبا",17,"ب",2,0],["قعدت بهم هِمَّاتهم وسمت به","همم الملوك وسورة الأبطال",18,"ل",1,0],["قعدَ العُفاةُ وسيبُهُ","يَختبُّ نحوهُمُ اختبابهْ",19,"ب",2,0],["قَعيدَكِ عَمرَ اللَهِ هَل تَعلَمِينَني","كَريماً إِذا اِسوَدَّ الأَنامِلُ أَزهَرا",20,"ر",2,0],["قَعَدوا عَلى أَكوارِها فَتَرَدَّفَت","صَخِبَ الصَدى جَذَعَ الرِعانِ رَجيلا",21,"ل",2,0],["قعدنا معقد الآباء منه","فكنا البَهم قد خلف السباعا",22,"ع",2,0],["قَعدَ الآلُ لِلعَزاءِ وَقامَت","باكِياتٍ عَلى الحُسَينِ الفَواطِم",23,"م",1,0],["قَعَدنَ فَكُنَّ الأَساسَ المَتينَ","وَقامَ عَلَيها البِناءُ المَشيد",24,"د",1,0],["قَعَدتِ مِنَ الأَظعانِ في مَقطَعَ السُرى","وَمَرّوا رِكاباً في غُبارِ رِكابِ",25,"ب",1,0],["قَعَدَ الشَرقُ عَلَيهِم مَأتَما","وَاِنثَنى الغَربُ بِهِم في عُرُسِ",26,"س",1,0],["قَعَدنا فَلَم يَعدَم فَتى الرومِ فَيلَقاً","مِنَ الرُعبِ يَغزوهُ وَآخَرَ يَسلُبُ",27,"ب",1,0],["قَعَدَ الناسُ كُلُّهُم عَن مَساعي","كَ وَقامَت بِها القَنا وَالنُصولُ",28,"ل",1,0],["قَعَدوا وَأَينَ قِيامُ مَن قَد طُلنَهُ","شُرُفاتُ ما تَبني ذُراً وَقَواعِدا",29,"د",2,0],["قَعقَعتُ لِلبُخَلاءِ أَذعَرُ جَأشَهُم","وَنَذيرَةٌ مِن باتِكٍ أَن يُنتَضى",30,"ض",2,0],["قُعودٌ لَدى الأَبوابِ طُلّابُ حاجَةٍ","عَوانٍ مِنَ الحاجاتِ أَو حاجَةٍ بِكرا",31,"ر",2,0],["قُعودُكَ في الشَربِ الكِرامِ بَلِيَّةٌ","وَرَأسُكَ في الإِكليلِ إِحدى الكَبائِرِ",32,"ر",1,1],["قُعوداً وَخَلفَ القاعِدينَ سُطورَهُم","جُنوحٌ وَأَيديهِم جُموسٌ وَنُطَّفُ",33,"ف",1,0],["قُعودٌ بِأَبوابِ الزُروبِ وَلا تَرى","لَهُم شاهِداً عِندَ الأُمورِ العَظائِمِ",34,"م",1,0],["قَعيدَكُما اللَهَ الَّذي أَنتُما لَهُ","أَلَم تَسمَعا بِالبَيضَتَينِ المُنادِيا",35,"ي",2,0],["قَعدتَ وكم نهضتَ إلى التَّصابي","بنَقرِ الدُّفِّ تُوسِعُ فِيه خَطْوا",36,"و",2,0],["قُعودُها عَن قَضاءِ حَقٍ","لِعُذرِ مَن لامَني يُقيمُ",37,"م",1,0],["قعاقعُ دُهْمٍ أسهرَتْكَ وطالما","أنامتْكَ بِيضٌ أسْمَرَتْكَ الأغانيا",38,"ي",2,0],["قَعَستُ لَهُ حَتّى التَقيتَ سِهامَهُ","وَأَثبَتَّ في تامورِهِ الحُجَجَ اللُدّا",39,"د",2,0],["قَعَد الشُّيوخُ عن النّضالِ وهذه","دُنيا الشّبابِ فبوركَ الأبطالُ",40,"ل",1,0],["قَعدتَ فلما كَرِهتَ القُعودَ","نَفرت حَثيثاً إلى المَلْحَمَهْ",41,"م",2,0],["قَعقَعتُ حِضنَي حاجِزٍ وَصِحابُهُ","وَقَد نَبَذوا خُلقانَهُم وَتَشَنَّعوا",42,"ع",3,1],["قَعَدتُ فَلَم أُرسِل وَلا أَرسَلُوا هُمُ","بِشَيءٍ إِلَينا صاحِ حَولاً مُجَرَّما",43,"م",2,0],["قَعَدَ الزّمانُ عن المكارم والعُلى","إنَّ الزّمان السَّوءَ غيرُ رشيد",44,"د",1,0],["قُعوداً حَولَ دَسكَرَتي وَعِندي","كَأَنَّ لَهُم عَلَيَّ فُضولَ مالِ",45,"ل",1,0],["قَعيدَكَ أَن يَنسى اِمرُؤٌ أَنتَ هَمُّهُ","تَلالا عَلَيهِ الهَمُّ لا يَبرَحُ الخَلدا",46,"د",2,0],["قَعيدُكِ أُخرى لا تَبيعُ مَوَدَّتي","بِوُدٍّ وَلا تَخشى إِذا ما تَوَلَّتِ",47,"ت",1,0],["قَعيدَكَ أَن تَنهى اِمرَأً عَن طِباعِهِ","يَجودُ وَيَغدو ناصِباً بِعَتيبِ",48,"ب",1,0],["قَعَدَ الأَغَرُّ لَدى الكَريهَةِ وَالَّذي","عِندَ المَلاحِمِ يُشتَفى بِضِرابِهِ",49,"ب",2,0],["قُعوداً لَهُ غَسّانُ يَرجونَ أَوبَهُ","وَتُركٌ وَرَهطُ الأَعجَمينَ وَكابُلُ",50,"ل",1,0],["قُعوداً عَلى آلِ الوَجي