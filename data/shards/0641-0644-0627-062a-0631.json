dctabudhabi.ae/diwan/poem/83198","الرجز"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66136","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58039","الوافر"],[4493,"","https://poetry.dctabudhabi.ae/diwan/poem/20660","البسيط"],[4767,"تاج الكمال","https://www.poetsgate.com/ViewPoem.aspx?id=179616",""],[4778,"بيتك من زجاج","https://www.poetsgate.com/ViewPoem.aspx?id=198850",""],[1901,"وداعاً بَني أُمي فَقدْ آنَ أنْ أَمضِي","https://www.poetsgate.com/ViewPoem.aspx?id=160417",""],[1901,"أقولُ وهَمي ضاقَ عن فيضَهُ صدري","https://www.poetsgate.com/ViewPoem.aspx?id=160389",""],[4927,"وداع عفراء","https://www.poetsgate.com/ViewPoem.aspx?id=29611",""],[4929,"عجبتُ لحُرٍّ كرَّمَ اللهُ خلقَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=203697",""],[5002,"نقاط وحروف","https://www.poetsgate.com/ViewPoem.aspx?id=204115",""],[5111,"ربوةُ الوَردِ","https://www.poetsgate.com/ViewPoem.aspx?id=212618",""],[5145,"إذا المرء لم يعرف مصالح نفسه","https://www.poetsgate.com/ViewPoem.aspx?id=108248",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5189,"تُطاردك الذنُوب","https://www.poetsgate.com/ViewPoem.aspx?id=190515",""],[4572,"إذا المرء لم يكسبْ معاشاً لنفسه","https://www.poetsgate.com/ViewPoem.aspx?id=15017",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5376,"وقامت أُخيَّة تلقي السلام......من حماه","https://www.poetsgate.com/ViewPoem.aspx?id=188421",""],[5376,"مسلمو بورما لا بواكي لهم","https://www.poetsgate.com/ViewPoem.aspx?id=188478",""],[5376,"لنا في الخنا طَرْفٌ من الذلِّ مرتدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=199640",""],[5415,"ألآ أيها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=212280",""],[5431,"ولا وأبيك لا أهجو الذبابا","https://www.poetsgate.com/ViewPoem.aspx?id=197167",""],[5431,"في صداقة الدكتور ناصر أبو عون...","https://www.poetsgate.com/ViewPoem.aspx?id=202127",""],[5431,"تستوي الهامات عزّا ومنحى ....","https://www.poetsgate.com/ViewPoem.aspx?id=211306",""],[5516,"وجه السماء بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=215422",""],[5628,"لا أمل في البقاء","https://www.poetsgate.com/ViewPoem.aspx?id=178512",""],[5638,"سلام على الأحرار","https://www.poetsgate.com/ViewPoem.aspx?id=199062",""],[5667,"الراقصة","https://www.poetsgate.com/ViewPoem.aspx?id=214915",""],[5689,"أراك على مر الجديدين خاسرا","https://www.poetsgate.com/ViewPoem.aspx?id=143410",""],[5690,"حياة المرءِ في الدنيا منامُ","https://www.poetsgate.com/ViewPoem.aspx?id=172186",""],[5829,"سليمى","https://www.poetsgate.com/ViewPoem.aspx?id=210709",""],[5910,"دَعْ عتكَ مَن يدَّعي زُورًا أخوَّتَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=206953",""],[5956,"جاءني الرد منك سريعا","https://www.poetsgate.com/ViewPoem.aspx?id=193930",""],[5956,"مناجاةُ أبٍ موَسوَسٍ على ابنته العُزَّى","https://www.poetsgate.com/ViewPoem.aspx?id=207206",""],[6070,"رأيتُ الليلَ يمشي للسَّرابِ","https://www.poetsgate.com/ViewPoem.aspx?id=189505",""],[6102,"صراحة مفرطة ...","https://www.poetsgate.com/ViewPoem.aspx?id=184430",""],[6102,"لحظة وداع","https://www.poetsgate.com/ViewPoem.aspx?id=184862",""],[6167,"حديث النجوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85550&r=&rc=33",""]],"verses":[["فَلا تَرهِبوني بِالرِماحِ سَفاهَةً","فَعيدانُ أَوطاني قَناً وَصِعادُ",0,"د",1,0],["فَلا تَرى لؤلؤاً مِن مبسِمٍ نَسَقاً","حَتىّ تَرى لؤلؤاً مِن مَدمَعٍ بَددا",1,"د",2,0],["فلا تَرْهَبِ الأعْداءَ ما عَصَفَتْ يَدي","وبأسمَرَ أو ناطَتْ نِجادي بأبْيَضا",2,"ض",2,0],["فَلا تَرضَ بِمَنقَصَةٍ وَذُلٍّ","وَتَقنَع بِالقَليلِ مِنَ الحُطامِ",3,"م",1,0],["فلا تَرجُ في الدنيا وفاءً لعهدهم","فلا بدّ في الأيام للعهد من نكث",4,"ث",1,0],["فلا ترتكب قرب اللئام فإنهم","لكالبحر محمول على الهول راكبه",5,"ب",2,0],["فلا ترأم الحيتانُ أحناشَ قفرة","ولا تحسب النيب الجحاشَ فصالَها",6,"ه",2,1],["فلا تركوا أعلام علم تراهمو","بأُفقِ عليٍّ للنجومِ صحابا",7,"ب",2,0],["فلأْتركنك بعد ظن","نِك لا تصدِّق واعدا",8,"د",2,0],["فلا ترى أثقبَ من ذهنهِ","فيه ولا أيمَنَ من طائرِهْ",9,"ر",2,0],["فلا ترضيَنْ في مُحرِزٍ بدنيّةٍ","فلستَ بمعتاضٍ ولياً بمحرِز",10,"ز",1,0],["فلا تَرُمْ أن ترى شمسي كهيئتها","بلا عيونٍ كما طارت بلا رِيش",11,"ش",1,0],["فلا ترتهنْ ذمّي بمطلك إنني","بمَنْ لا يبالي الذمَّ غيرُ مبالي",12,"ل",2,0],["فَلا تَرجوا العُيونَ لِتَنزِلوها","وَلا الرَهَواتِ وَاِلتَمِسوا المَغارا",13,"ر",2,0],["فَلا تُرضِخوا وُدّاً عَلَيكُم عَرَضتُهُ","فَيا رُبَّ مَعروضٍ وَلَيسَ بِكاسِدِ",14,"د",1,0],["فَلا تَرجُ سِلماً مِنَ العالَمينَ","فَإِنَّ السِباعَ كَما تُفطَرُ",15,"ر",1,0],["فَلا تُرَجِّ الخَيرَ عِندَ اِمرِئٍ","مَرَّت يَدُ النَخّاسِ في رَأسِهِ",16,"س",2,0],["فلا ترومَنَّ إنصافاً وقد شَهِدَتْ","مخالبُ الليثِ أن الظلمَ في الفِطَرِ",17,"ر",1,0],["فَلا تَرَ بِالخَضراءِ مِثلَ الَّذي رَأى","صَديقُكَ بِالدَكناءِ مِن عَودِهِ المُبدي",18,"د",2,0],["فلا تَردُدِ العِقْدَ المُفَضَّلَ خائباً","بصدِّكَ عنه والرِّداءَ المُحبَّرا",19,"ر",2,0],["فَلَأَترُكَنَّ بِهِ قَبائِلَ تَغلِبٍ","قَتلى بِكُلِّ قَرارَةٍ وَمَكانِ",20,"ن",1,0],["فلا ترى شيبَ رأسي","ولا حقارةَ كيسي",21,"ي",1,0],["فلا تركبُ مطايا الجهلِ إني","أحاذرُ أنْ تشقَّ على المطايا",22,"ا",3,0],["فَلا تَرضَ المَوَدَّةَ مِن أُناسٍ","إِذا كانَت مَوَدَّتُهُم نِفاقا",23,"ق",2,0],["فَلا تَرتَب بِفَهمي إِنَّ رَقصي","عَلى مِقدارِ إيقاعِ الزَمانِ",24,"ن",1,0],["فَلاَ تُرَجُّوا جزِيلَ الأجْرِ مِنْ عَمَلٍ","إِنَّ الرَّجاء مِنَ الكُفَّار مُخْذُولُ",25,"ل",1,0],["فلا تَرُمْ بالمعاصِي كَسْرَ شَهْوَتِها","إنَّ الطعامَ يُقَوِّي شَهْوَةَ النَّهِمِ",26,"م",1,0],["فلا تُرهِقُوني بالمزيدِ فحسبُكمْ","وحسبي لديكُم ما ترَوْنَ من الوَفرِ",27,"ر",1,0],["فَلا تَرعوا لَنا عَهداً","فَما نَرعى لَكُم عَهدا",28,"د",2,0],["فَلا تَرُدّي عاشِقاً مُدنَفاً","يَرضى بِهَذا القَدرِ مِن ذاكِ",29,"ك",1,0],["فَلا تَرثِيَنَّ لَها إِنَّها","لِجِسمِكَ في ضَعفِهِ ما رَثَت",30,"ت",1,0],["فَلا تُرسِلَنَّ حِبالَ الرَجا","وَأَمّسِك بِكَفِّكَ مِنها طَرَف",31,"ف",1,0],["فَلا تَرغَبوا في المُلكِ تَعصونَ بِالظُبا","عَلَيهِ فَمِن أَشقى الرِجالِ مُلوكُها",32,"ك",3,0],["فلا تراني العيونُ مقتحماً","سياجَه أو تحسُّ لي شانا",33,"ن",2,0],["فَلا تَرْكَنْ إِلَيْهِ فَكُلُّ شَيْءٍ","تَرَاهُ بِهِ يَؤُولُ إِلَى ذَهابِ",34,"ب",1,0],["فَلاَ تَرْغَبَنْ في حَشْدِ أَمْرٍ تُرِيدُهُ","وأَلِّبْ وَجَمِّعْ كُلَّ ما أَنْتَ جَامِعُ",35,"ع",1,0],["فلا تراهُ سِوَى شاكٍ لسَاجِعَةٍ","أو نادِبٍ إِثرَ أَطْلالٍ وآثار",36,"ر",1,0],["فلاَ ترْقُبِي في عاشِقٍ أنْتِ همُّهُ","قرِيباً ولا تسْتأذِنِي فِيهِ أجْنَبا",37,"ب",2,0],["فلا تَرى غيرَ أنقاضٍ مُبعثرةٍ","هَوينَ فناً وتاريخاً وأزمانا",38,"ن",2,0],["فلأْ تركنك بعد ظنَّ","ك لا تصدِّق واعدا",39,"د",2,0],["فلا ترْضى بمنقَصَة ٍ وَذُلٍّ","وتقنعْ بالقليل منَ الحطام",40,"م",1,0],["فلا ترجُو من الدنيا دَوَاما","فلا شىءٌ على الدنيا يدومُ",41,"م",1,0],["فَلا تَركَبَنَّ الدَهرَ مِنهُ ذِمامَةً","وَأَنتَ اِمرُؤٌ مِن خَيرِ عَبدِ مَنافِ",42,"ف",1,0],["فَلا تَرفُ ذي فَتكٍ إِلى الفَتكِ يَعتَلي","وَلا يَدُ ذي جَورٍ إِلى الجَورِ تَمتَدُّ",43,"د",1,0],["فَلا تَرُعهُم وَكُن مِنهُم عَلى ثِقَةٍ","أَنَّ الحِمامَ إِلَيهِم يَسبِقُ الكَمَدا",44,"د",2,0],["فَلا تَركُن إِلى زَمَنٍ خَؤونٍ","لِآمِلِهِ سَريعِ الإِنتِقالِ",45,"ل",1,0],["فَلا تَرضَ يا عِزَّ المُلوكِ بِذُلِّهِم","وَأَن يَرِدوا مِن غَيرِ بَحرِكَ مَنهَلا",46,"ل",2,0],["فَلا تَركَن إِلى صَبري وَمَيلي","عَلى نَفسي وَلَو كُنتُ اِبنَ أُمِّه",47,"م",2,0],["فلا تُرض مَخلُوقاً باسخاطِ خالقٍ","فربّك أولى من يُخَافُ ويُستَحيَا",48,"ي",2,0],["فلا ترى غير ذي قَلب به حرقٌ","وغير ذى مقلةِ إنسانُها يكفُ",49,"ف",1,0],["فَلا تُرَجِّ لَهُ إِذ يَستَفيدُ غِنىً","فَإِنَّهُ بِاِنتِقالِ الحالِ يَنتَقِلُ",50,"ل",1,0],["فَلا تَرضَ لي غَيراً واِعلَم أَنّني","غَيورٌ وَما ضاقَت بِمِثلي مَذاهِبُهْ",51,"ب",2,0],["فَلا تَرجُ يَوماً في حَسُودٍ مَوَدَّةً","وَإِن كُنتَ تُبدي وُدَّهُ وَتُجامِلُه",52,"ل",2,0],["فَلا تَرى نائِلاً يَجري كَنائِلِهِ","وَلا كَبُنيانِهِ في الأَرضِ بُنيانا",53,"ن",2,0],["فلا ترى الشيخَ يقوى","ولا الفتى يستقلُّ",54,"ل",1,0],["فلا تردون شابا","يشوككم إن سلبتم",55,"م",1,0],["فلا تَرْحمِ الأعداءَ يوماً ولا تَلُمْ","حسوداً فما إن يَرْتضى ضدَّه الضّدّ",56,"د",1,0],["فَلاَ تَرُدَّنِي وَإِنِّي هَائِمُ","عَفْوَكَ يَا مَوْلاَيَ إِنِّي ظَالِمُ",57,"م",1,0],["فلا تَرهَب دَلالاً أو عَفافاً","ولا تَقنُط إذا أَبدت نفُورا",58,"ر",2