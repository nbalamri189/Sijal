,2,1],["أمّاهُ شِعْري في رِحابِكِ عاجِزٌ","ولّى البيانُ وغادَرتْ ألْحاني",140,"ن",2,0],["أُمَّاهُ ، يا مِشعلًا ، ليلي الكئيبُ دَنا","هَلَّا كَشَفتِ يسيرًا مِنْ مُحَيَّاكِ ؟",141,"ك",1,0],["أماه أنت الفل والحبق","ما كنت أحسب أنا سوف نفترق",142,"ق",1,1],["أماه رغم مشيي لم أزل ولداً","ولا يزال على \"دشداشتي\" دبق!",142,"ق",1,0],["أماه إنَّ أصابعي ملوثةٌ","وإخوتي كلّهم لما رأوا شهقوا!!",142,"ق",3,0],["أماه صاحت ديوك الفجر وانطلقت","كل الخراف إلى الغدران تستبق",142,"ق",1,0],["أماه أين فطوري إن مدرستي","حانت وإن سيوف الفجر تَمتَشق",142,"ق",1,0],["أماه إنا هنا ريح بنا عصفت","لم ندر أيم أنهينا بعد لقياها",143,"ا",1,0],["أمّاهُ بَعْدَكِ مَنْ أزورُ ومَنْ أرى؟!",".فالدّارُ مُوحشةٌ وبيتُك أَظْلَمَا",144,"م",2,0],["أمّاهُ بعدك ما السّعادةُ ؟ ما الهنا؟","حُلم يضيعُ وذا فؤاديَ حُطِّمَا",144,"م",2,0],["أمّاه بعدك حُضنُ عيشيَ باردٌ","...أمّاهُ أضحى كلّ عيشيَ مُؤلما",144,"م",2,0],["أمّاهُ وَحْدِي والجراحُ كثيرةٌ","والموتُ للأحلام زارَ فَهَدَّمَا",144,"م",2,0],["أمّاهُ وحدي رغم كلّ أحبّتي","لا شيءَ يعدلُ والِديَّ وإنْ سَما",144,"م",2,0],["أماه يا فيض جودٍ في تكرُّمها","البحر يخجل أن. يسعى مساعيها",145,"ي",3,0],["أَمَّا هُنَاكَ فَفِي الْأُخْرَىٰ شَفَاعَتُهُ","لِمَنْ بِهِ يَقْتَدِيْ فِي حَالَةِ الْيُسْرَىٰ",146,"ر",2,0],["أماه إني قد عققت طفولتي","وعققت فيك أمومة ترعاني",147,"ي",1,0],["أمّاه قد عضَّ الصقيعُ بنابهِ","جسدي الصغيرَ وخيمتي المذعورةْ",148,"ر",2,1],["أمّاهُ إني ببحرِ الحزنِ غارقةٌ","كمْ نوَّةٍ عصفتْ والموجُ غالَبَنِي",149,"ن",2,1],["أمّاهُ قدْ كَانَ هذا الموتُ فَاجعةً","أدمتْ عيونًا فهلْ فِي الصبْرِ كَافينَا؟",150,"ن",2,0],["أماهُ يا روحاً منيراً","في رحى جسمٍ أهلا",151,"ل",2,1],["أمّاهُ ماذا عن أبي؟","سردتْ له فأجابَ ما هذا الثملْ",152,"ل",1,0],["‏أمّاهُ.. ‏وارْتَجّ مستشفى الجراحِ صدىً","‏لمنْ تنادينَ؟.. شِلْوًا قد طوى شِلْوا",153,"و",2,0],["أ ما هو بحثٌ عن سلامٍ مُؤزَّر","ونقلُ ذوي البؤسَى إلى خيرِ عالَمِ ؟",154,"م",1,0],["أ ما هو وَعْيٌ عالميٌّ مسالمٌ","وَلطمةُ تحنانٍ على خدِّ ظالمِ ؟",154,"م",1,0],["أ ما هو دعوى للمحبة والإخا","ونشرُ الهَدى والحبِّ ضد الجرائمِ ؟",154,"م",