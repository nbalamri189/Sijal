{"poems":[[75,"أضحى التنائي بديلا من تدانينا","https://www.aldiwan.net/poem11836.html","البسيط"],[95,"طلعت طلوع الشمس بالنور والندى","https://www.aldiwan.net/poem9832.html","الطويل"],[95,"دع الخمر نصح أخ إنها","https://www.aldiwan.net/poem11112.html","المتقارب"],[23,"لاطت قريش حياض المجد فافترطت","https://www.aldiwan.net/poem21446.html","البسيط"],[91,"حملته بين احشائي بلا برم","https://www.aldiwan.net/poem44857.html","البسيط"],[99,"يا من طواها الليل في ظلمائه","https://www.aldiwan.net/poem24355.html","الكامل"],[35,"فوالله ثم والله إني لدائب","https://www.aldiwan.net/poem26026.html","الطويل"],[107,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[48,"يا ليل قد نام الشجي ولم ينم","https://www.aldiwan.net/poem22581.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85482","المجتث"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62279","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39667","الكامل"],[92,"يا شعب","https://www.poetsgate.com/ViewPoem.aspx?id=178937",""],[123,"ترى ينسخ الإصباح من ظلمة القبر","https://www.aldiwan.net/poem49268.html","الطويل"],[127,"عفا الصفا وانتفى من كوخ ندماني","https://www.aldiwan.net/poem23777.html","البسيط"],[153,"الطعن والضرب منسوبان للعرب","https://www.aldiwan.net/poem68456.html","البسيط"],[181,"أماه","https://www.aldiwan.net/poem50693.html","البسيط"],[200,"كفي الملام وعلليني","https://www.aldiwan.net/poem39948.html","مجزوء الكامل"],[226,"ضيعت في هضب الهوى رشدي","https://www.aldiwan.net/poem41886.html","أحذ الكامل"],[228,"أناعي ماهر لم تدر ماذا","https://www.aldiwan.net/poem55088.html","الوافر"],[264,"يا أخا العين في المحاسن عينا","https://www.aldiwan.net/poem38162.html","الخفيف"],[273,"يا مي أفنى مهجتي التعليل","https://www.aldiwan.net/poem35580.html","الكامل"],[273,"أأماه حياك الربيع نضيرا","https://www.aldiwan.net/poem35608.html","الطويل"],[278,"كرت سوافح عبرتي أشجاني","https://www.aldiwan.net/poem25514.html","الكامل"],[283,"سوى باكيك من ينهى العذول","https://www.aldiwan.net/poem60710.html","الوافر"],[301,"هذا وربك مثوى كل إنسان","https://www.aldiwan.net/poem36260.html","عموديه"],[301,"أضر بغادة هيفاء رود","https://www.aldiwan.net/poem36293.html","عموديه"],[367,"أذاكرة يوم الوداع نوار","https://www.aldiwan.net/poem60917.html","الطويل"],[406,"هل أهنيك أم أهني المعالي","https://www.aldiwan.net/poem33473.html","الخفيف"],[446,"وشب بأرض بوليفا","https://www.aldiwan.net/poem55925.html","عموديه"],[460,"كم النوى قد جزع الصابر","https://www.aldiwan.net/poem56172.html","السريع"],[467,"يا صبر أيوب","https://www.aldiwan.net/poem36227.html","عموديه"],[479,"أما هواك وان تقادم عهده","https://www.aldiwan.net/poem15208.html","الكامل"],[481,"لست المبدل جنسي","https://www.aldiwan.net/poem37608.html","المجتث"],[502,"تطوف بساحات القلوب عجائب","https://www.aldiwan.net/poem38077.html","الطويل"],[540,"بربك هل أبصرت أسخف من عقلي","https://www.aldiwan.net/poem47995.html","عموديه"],[542,"أوصي غنيا فما أنفك أذمره","https://www.aldiwan.net/poem56708.html","الطويل"],[555,"أحق أنه أودى يزيد","https://www.aldiwan.net/poem68415.html","الوافر"],[560,"غلب الهوى واستحوذ استحواذا","https://www.aldiwan.net/poem34561.html","الكامل"],[642,"","https://poetry.dctabudhabi.ae/diwan/poem/26691","البسيط"],[1092,"","https://poetry.dctabudhabi.ae/diwan/poem/130531","الكامل"]],"verses":[["أَمّا هَواكِ فَلَم نَعدِل بِمَنهَلِهِ","شُرَباً وَإِن كانَ يُروينا فَيُظمينا",0,"ن",2,0],["أما هي أرقى نسوة الشرق شيمةً","ونبلاً وأسماهن جاهاً ومحتدا",1,"د",2,0],["أَما هِيَ تِلْكَ الَّتِي خَرَّبَتْ","بُيُوتاً بِتَقْويضِهَا رُكْنَهَا",2,"ن",3,0],["أَما هِيَ تِلْكَ الَّتِي ضَعْضَعَتْ","شُعُوباً وَدَكَّتْ بِهَا مُدْنَهَا",2,"ن",3,0],["أَمّا هِشامٌ فَرِجلا قَينَةٍ مَجِنَت","باتَت تُغَمِّزُ وَسطَ السامِرِ الكَمَرا",3,"ر",2,0],["اما هواه فملء القلب يشبعني","مسرة واسمه المحبوب ملء فمي",4,"م",2,0],["إمّا هَوى نجمٌ ومالَ لضعفهِ","أبصرتِ حظَّكِ في الشعاعِ الغاربِ",5,"ب",1,0],["أَمَ اَهرُبُ حَتّى لا أَرى لي مُجاوِراً","أَمَ اَفعَلُ ماذا أَم أَبوحُ فَأُغلَبُ",6,"ب",1,0],["أُمّاه لا تُودِي بحقِّكِ وانبذي","رَأيَ الغُواةِ وخُطّةَ الجُهّالِ",7,"ل",1,0],["أَمّا هَدىً فَوَجَدتُهُ ما بَينَنا","سِرّاً وَلَكِنَّ الضَلالَ جِهارُ",8,"ر",1,0],["أُمّاه إنّي ضَريرُ","وَالقَلب مني كَسيرُ",9,"ر",1,1],["أُمّاه ما في حَياة ال","طفل الضَرير سرور",9,"ر",1,0],["أُمّاه إني إلى أَن","أَراكَ يَوماً فَقير",9,"ر",1,0],["أُمّاه هَل هذه الدن","يا رحبة تَستَنير",9,"ر",1,0],["أَمَّا هُمُ فَعُدَاةٌ مَا نُكَلِّمُهُمْ","وهْيَ الصَّدِيقُ بِهَا وَجْدٌ وتَخْبِيلُ",10,"ل",1,0],["أُمَّاهُ خانتني المقادر فاغفري","قدَري وإن قلَّ الفداءُ فسامحي",11,"ح",2,0],["أما هواك فذاك ملء جوانحي","تحنو على ذكراك فيه وتكلف",12,"ف",1,0],["أما هاتف يرثي لنفس يقيمها","ويقعدها قولي ليها الدهر لا أدري",13,"ي",1,0],["أما هواك فلا زلت الحفي به","ولا أزال عليه الحادب الحاني",14,"ن",2,0],["أما هلال فقد أوفى بذمته","وفاء راع لحقّ الدين والأدب",15,"ب",1,0],["أمّاهُ كمْ أرهقتنا دُرْبةُ الأوّاهْ","مذ فَلَّقَ الدمعُ في أرواحِنا مَجْراهْ",16,"ا",2,1],["أُمّاهُ قد غَلَبَ الأسى","كُفّي الملامَ وعلّليني",17,"ن",2,0],["أُمّاهُ أَينَ أَبي فَإِنَّ لَهُ","عِندي شُؤوناً ضَيَّعَت رُشدي",18,"د",2,0],["أَماهرُ إِنَّ وعدَ اللَهِ حقٌّ","وَما جَزعي عليكَ منَ التُقاةِ",19,"ه",1,0],["أماهرُ كنتَ فيما مرَّ أُنسى","فمن لي في اللَيالي الباقِيات",19,"ت",1,0],["ام اهنا فيك العذول إلى ان","بكلام الوشاة منك منينا",20,"ن",2,0],["أمّا هواكِ فإنّهُ مُستَحكِمٌ","بجوارحي فمتى يُبَلُّ غليل",21,"ل",1,0],["أما هيَّجَت ذكراكِ عصفورةً غدَت","تُحيِّي ضياءً أو تزقُّ صَغيرا",22,"ر",2,0],["أمّا هَوَاكِ فَعَنْ سِوَاك مُكَتَّمٌ","والسِّرُّ عِنْدَ الحُرِّ فِي كِتْمَانِ",23,"ن",1,0],["أَما هَوْلٌ بِأَنْ يُحْثى وَيُلْقى","عَلَى ذاكَ الْجَمالِ ثَرىً مَهِيلُ",24,"ل",1,0],["أُمّاه أُبدلتِ بالأَملاكِ مكرُمةً","(أهلاً بأَهلٍ وجيراناً بجيران)",25,"ن",1,0],["أَم اهتك عفةً بسبيلِ قوتٍ","إِذاً إني لفي غيٍّ بعيد",26,"د",1,0],["أما همْ إلى قلبي من العينِ غُدْوةً","يَسيرون أن زَمُّوا الجِمالَ وساروا",27,"ر",3,0],["أم أهني الأكوان فهي جميعاً","في سرور ولذة واختيال",28,"ل",1,0],["أما هذي حليفهم","تعلونا على الغنم",29,"م",1,0],["إما هلالٌ منكُمُ واضحٌ","يسري لها أو كوكبٌ زاهرُ",30,"ر",1,0],["أما هنا يا بني عمي، فقد تعبت","مما تحن إلى أعشاشها الحجل!",31,"ل",1,0],["أمّا هواكَ واِنْ تقادمَ عهدُه","فشفيعُ وجهِكَ ما يزالُ يُجِدُّهُ",32,"د",2,1],["أماه خير البلاد","أرعاك ما دمت حيا",33,"ي",2,0],["أمَّا هو جدُّهمْ طِلْسَمُ العَبا","وكَنزُ فُهومٍ صَيِّناتِ المَضارِبِ",34,"ب",1,0],["أمَا هذِه الأخلاقُ غيرُ حَماقَةٍ","يؤيدها العقل السليم من الخبل",35,"ل",1,0],["إِمّا هللتَ وَلَم تنظر إِلى نَشبٍ","كَما تَعَطَّلَ بَعد الخلقةِ الحالي",36,"ل",2,0],["أَما هُدَّت لِمَصرَعِهِ نِزارٌ","بَلى وَتَقَوَّضَ المَجدُ المَشيدُ",37,"د",1,0],["أما هواه فإنه هو ملّتي","وعليه كنت أعاهد الأستاذا",38,"ذ",2,0],["إِمّا هَلَكتُ فَإِنّي قَد بَنَيتُ لَكُم","عِزَّ الحَياةِ بِما قَدَّمتُ قُدّامي",39,"م",2,0],["اما هلكت ابا الفعال فما جرى","من فوق مثلك عقد ذات نطاف",40,"ف",1,0]]}