حيا كشيخٍ مكتهلْ","أبقى ببيتي قابعاً أصْلَى المللْ",167,"ل",1,0],["أُماهُ إِني بَلَغْتُ الحُزْنَ في وَجَلٍ","ضُمي فَتاكِ وَصُبي العَطْفَ والأَلقا",168,"ق",2,0],["أُماهُ إنَّ الذي في داخلي ألمٌ","مِنْ أَلفِ قَهرٍ على ما كانَ يُؤذينا",169,"ن",2,0],["أُماهُ إنَّ الهَوى نَومٌ على سُرُرٍ","من فضل روحكِ يا مَنْ عِشتِ تَأوينا",169,"ن",2,0],["أُماهُ إِني أَجوبُ الأَرْضَ مُنْفَرِداً","لا شَيءَ عِندي سِوى ما كُنتُ أُزْمِعُهُ",170,"ع",2,0],["أُماهُ إِني على عَهدِ الهوى شَغِفٌ","جاءَ الرَبيعُ وَفَقدُ الزَهْرِ يوجِعُهُ",170,"ع",2,0],["أماه يا بسمةً في ثغر مكتئبٍ","ينادي يا أمّ كيف الآن دنياكِ",171,"ك",1,1],["أماه نار الوغى في القلب تستعر","والعين ترقب ما قد خطه القدر",172,"ر",1,1],["أماه أماه مات الحب في أفقي","صارت حياتي جحيما مالها وتر",172,"ر",1,0],["أماه أماه ماذا قد جرى ؟ ومتى","يعود فى الأرض أنوار وأضواء",173,"ا",2,0],["أمّاه يا أمّاه يا لحنَ الهوى","يا جنّت الدنيا خطبت رضاك",174,"ك",1,0],["أمّاهُ مَنْ هذي التي في جانبي","هلْ هذهِ ميساءُ أمْ خَنساءُ",175,"ا",2,0],["أماهُ هلْ هذي الحياةُ جميلةٌ","قالتْ سُعادُ بأَنَّها فيحاءُ",175,"ا",2,0],["أمّاهُ أمشي خائفاً مِنْ مِديةٍ","قَدْ سَنّها الأغرابُ والأعداءُ",175,"ا",2,0],["أمّاهُ إنّي تائِهٌ في حَيرةٍ","هل هذهِ صَحراءُ أمْ ميناءُ",175,"ا",2,0],["أُمَّاهُ ؛ مَرَّ الزَّمانُ المُرُّ فانفَتَقَتْ","حَشاشَتي , وَ استَبَدَّ القَهرُ فانتَصَرا",176,"ر",2,0],["أمّاه يا رَوضَ اللغاتِ تحية ً","من مغرٍم قلقِ الجوى يتألم",177,"م",1,0],["أَمَا هِيَ حَدَّثَتْكَ عَنِ النَّبَالَمِ وَالرِّجَالْ ؟","عَنِ الإِنْسَانِ تَأكُلُهُ المَظَالِمُ تَحْتَ خَيْمَهْ ؟",178,"ه",1,0],["أمّاه قد أجهشتْ أحلامنا حزنا","لكننا اليوم قد جفّت مآقينا !",179,"ن",2,0],["أمّاهُ ! بيتُكِ كان أولَ منزلٍ","متلألئٍ بتلاوة الوحي المبينْ",180,"ن",1,0],["أماهُ ! بيتكِ ضمّ أولَ سجدةٍ","نبويةٍ لله ربِّ العالمينْ",180,"ن",1,0],["أمّاه يا فرح العيون ونورها","رُدّي إليّ بوجهِكِ علّي أرى",181,"ا",1,0],["أماه كيف تركتِ بيتاً عامراً","وحواكِ قبرٌ في ظلام ترابه؟!",182,"ب",2,0],["أماه معذرة.. قد لزَّني الضجر","وقد تبطنني.. الصبّا ر.. والصبِر",183,"ر",1,1],["أماه معذرة.. قد خانني حلمي","وقد تكدر في أغصانه.. الثمر",183,"ر",1,0],["أماه معذرة.. فالدرب آلمني","ومزّق الخطوَ مني الشوك.. والحفر",183,"ر",1,0],["أماه معذرة.. إن المدى ظُلَمٌ","فقد توسده.. هذا الورى.. البقر",183,"ر",1,0],["أماه معذرة..فالله يشهد لي","لمْ أنس.. هل يتناسى غيمَهُ المطر؟!",183,"ر",1,0],["أماه! لازلتِ ينبوعا.. يُغَسِّلني","لا زال من ديمتيْكِ الماء..ينهمر",183,"ر",1,0],["أماه معذرة.. بل ألف معذرة","جف اليراع.. وقلبي قلْبُهُ سقرُ!",183,"ر",1,0],["أُمّاهُ لا تحزني إنْ جاءَكِ الخَبَرُ","أو قيلَ طالَ بِهِ يا أُمَّهُ السفَرُ",184,"ر",1,1],["أماهُ .. لا تسألي عن كُنْهِ أمنيتي","لا تسألي عن دمٍ يجري بأوردتي",185,"ت",2,1],["أماه ذاب على جمر الأسى جَلَدي","أبيتُ ألهثُ بين الحُزْنِ والكَمَدِ",186,"د",1,1]]}