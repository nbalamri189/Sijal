{"poems":[[73,"أضحى التنائي بديلا من تدانينا","https://www.aldiwan.net/poem11836.html","البسيط"],[93,"طلعت طلوع الشمس بالنور والندى","https://www.aldiwan.net/poem9832.html","الطويل"],[93,"دع الخمر نصح أخ إنها","https://www.aldiwan.net/poem11112.html","المتقارب"],[23,"لاطت قريش حياض المجد فافترطت","https://www.aldiwan.net/poem21446.html","البسيط"],[89,"حملته بين احشائي بلا برم","https://www.aldiwan.net/poem44857.html","البسيط"],[97,"يا من طواها الليل في ظلمائه","https://www.aldiwan.net/poem24355.html","الكامل"],[33,"فوالله ثم والله إني لدائب","https://www.aldiwan.net/poem26026.html","الطويل"],[105,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[46,"يا ليل قد نام الشجي ولم ينم","https://www.aldiwan.net/poem22581.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85482","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39667","الكامل"],[90,"يا شعب","https://www.poetsgate.com/ViewPoem.aspx?id=178937",""],[120,"ترى ينسخ الإصباح من ظلمة القبر","https://www.aldiwan.net/poem49268.html","الطويل"],[124,"عفا الصفا وانتفى من كوخ ندماني","https://www.aldiwan.net/poem23777.html","البسيط"],[150,"الطعن والضرب منسوبان للعرب","https://www.aldiwan.net/poem68456.html","البسيط"],[178,"أماه","https://www.aldiwan.net/poem50693.html","البسيط"],[197,"كفي الملام وعلليني","https://www.aldiwan.net/poem39948.html","مجزوء الكامل"],[223,"ضيعت في هضب الهوى رشدي","https://www.aldiwan.net/poem41886.html","أحذ الكامل"],[225,"أناعي ماهر لم تدر ماذا","https://www.aldiwan.net/poem55088.html","الوافر"],[261,"يا أخا العين في المحاسن عينا","https://www.aldiwan.net/poem38162.html","الخفيف"],[270,"يا مي أفنى مهجتي التعليل","https://www.aldiwan.net/poem35580.html","الكامل"],[270,"أأماه حياك الربيع نضيرا","https://www.aldiwan.net/poem35608.html","الطويل"],[275,"كرت سوافح عبرتي أشجاني","https://www.aldiwan.net/poem25514.html","الكامل"],[280,"سوى باكيك من ينهى العذول","https://www.aldiwan.net/poem60710.html","الوافر"],[298,"هذا وربك مثوى كل إنسان","https://www.aldiwan.net/poem36260.html","عموديه"],[298,"أضر بغادة هيفاء رود","https://www.aldiwan.net/poem36293.html","عموديه"],[364,"أذاكرة يوم الوداع نوار","https://www.aldiwan.net/poem60917.html","الطويل"],[403,"هل أهنيك أم أهني المعالي","https://www.aldiwan.net/poem33473.html","الخفيف"],[443,"وشب بأرض بوليفا","https://www.aldiwan.net/poem55925.html","عموديه"],[458,"كم النوى قد جزع الصابر","https://www.aldiwan.net/poem56172.html","السريع"],[465,"يا صبر أيوب","https://www.aldiwan.net/poem36227.html","عموديه"],[477,"أما هواك وان تقادم عهده","https://www.aldiwan.net/poem15208.html","الكامل"],[479,"لست المبدل جنسي","https://www.aldiwan.net/poem37608.html","المجتث"],[500,"تطوف بساحات القلوب عجائب","https://www.aldiwan.net/poem38077.html","الطويل"],[538,"بربك هل أبصرت أسخف من عقلي","https://www.aldiwan.net/poem47995.html","عموديه"],[540,"أوصي غنيا فما أنفك أذمره","https://www.aldiwan.net/poem56708.html","الطويل"],[553,"أحق أنه أودى يزيد","https://www.aldiwan.net/poem68415.html","الوافر"],[558,"غلب الهوى واستحوذ استحواذا","https://www.aldiwan.net/poem34561.html","الكامل"]],"verses":[["أَمّا هَواكِ فَلَم نَعدِل بِمَنهَلِهِ","شُرَباً وَإِن كانَ يُروينا فَيُظمينا",0,"ن",2,0],["أما هي أرقى نسوة الشرق شيمةً","ونبلاً وأسماهن جاهاً ومحتدا",1,"د",2,0],["أَما هِيَ تِلْكَ الَّتِي خَرَّبَتْ","بُيُوتاً بِتَقْويضِهَا رُكْنَهَا",2,"ن",3,0],["أَما هِيَ تِلْكَ الَّتِي ضَعْضَعَتْ","شُعُوباً وَدَكَّتْ بِهَا مُدْنَهَا",2,"ن",3,0],["أَمّا هِشامٌ فَرِجلا قَينَةٍ مَجِنَت","باتَت تُغَمِّزُ وَسطَ السامِرِ الكَمَرا",3,"ر",2,0],["اما هواه فملء القلب يشبعني","مسرة واسمه المحبوب ملء فمي",4,"م",2,0],["إمّا هَوى نجمٌ ومالَ لضعفهِ","أبصرتِ حظَّكِ في الشعاعِ الغاربِ",5,"ب",1,0],["أَمَ اَهرُبُ حَتّى لا أَرى لي مُجاوِراً","أَمَ اَفعَلُ ماذا أَم أَبوحُ فَأُغلَبُ",6,"ب",1,0],["أُمّاه لا تُودِي بحقِّكِ وانبذي","رَأيَ الغُواةِ وخُطّةَ الجُهّالِ",7,"ل",1,0],["أَمّا هَدىً فَوَجَدتُهُ ما بَينَنا","سِرّاً وَلَكِنَّ الضَلالَ جِهارُ",8,"ر",1,0],["أُمّاه إنّي ضَريرُ","وَالقَلب مني كَسيرُ",9,"ر",1,1],["أُمّاه ما في حَياة ال","طفل الضَرير سرور",9,"ر",1,0],["أُمّاه إني إلى أَن","أَراكَ يَوماً فَقير",9,"ر",1,0],["أُمّاه هَل هذه الدن","يا رحبة تَستَنير",9,"ر",1,0],["أُمَّاهُ خانتني المقادر فاغفري","قدَري وإن قلَّ الفداءُ فسامحي",10,"ح",2,0],["أما هواك فذاك ملء جوانحي","تحنو على ذكراك فيه وتكلف",11,"ف",1,0],["أما هاتف يرثي لنفس يقيمها","ويقعدها قولي ليها الدهر لا أدري",12,"ي",1,0],["أما هواك فلا زلت الحفي به","ولا أزال عليه الحادب الحاني",13,"ي",1,0],["أما هلال فقد أوفى بذمته","وفاء راع لحقّ الدين والأدب",14,"ب",1,0],["أمّاهُ كمْ أرهقتنا دُرْبةُ الأوّاهْ","مذ فَلَّقَ الدمعُ في أرواحِنا مَجْراهْ",15,"ا",2,1],["أُمّاهُ قد غَلَبَ الأسى","كُفّي الملامَ وعلّليني",16,"ي",1,0],["أُمّاهُ أَينَ أَبي فَإِنَّ لَهُ","عِندي شُؤوناً ضَيَّعَت رُشدي",17,"ي",1,0],["أَماهرُ إِنَّ وعدَ اللَهِ حقٌّ","وَما جَزعي عليكَ منَ التُقاةِ",18,"ه",1,0],["أماهرُ كنتَ فيما مرَّ أُنسى","فمن لي في اللَيالي الباقِيات",18,"ت",1,0],["ام اهنا فيك العذول إلى ان","بكلام الوشاة منك منينا",19,"ن",2,0],["أمّا هواكِ فإنّهُ مُستَحكِمٌ","بجوارحي فمتى يُبَلُّ غليل",20,"ل",1,0],["أما هيَّجَت ذكراكِ عصفورةً غدَت","تُحيِّي ضياءً أو تزقُّ صَغيرا",21,"ر",2,0],["أمّا هَوَاكِ فَعَنْ سِوَاك مُكَتَّمٌ","والسِّرُّ عِنْدَ الحُرِّ فِي كِتْمَانِ",22,"ن",1,0],["أَما هَوْلٌ بِأَنْ يُحْثى وَيُلْقى","عَلَى ذاكَ الْجَمالِ ثَرىً مَهِيلُ",23,"ل",1,0],["أُمّاه أُبدلتِ بالأَملاكِ مكرُمةً","(أهلاً بأَهلٍ وجيراناً بجيران)",24,"ن",1,0],["أَم اهتك عفةً بسبيلِ قوتٍ","إِذاً إني لفي غيٍّ بعيد",25,"د",1,0],["أما همْ إلى قلبي من العينِ غُدْوةً","يَسيرون أن زَمُّوا الجِمالَ وساروا",26,"ر",3,0],["أم أهني الأكوان فهي جميعاً","في سرور ولذة واختيال",27,"ل",1,0],["أما هذي حليفهم","تعلونا على الغنم",28,"م",1,0],["إما هلالٌ منكُمُ واضحٌ","يسري لها أو كوكبٌ زاهرُ",29,"ر",1,0],["أما هنا يا بني عمي، فقد تعبت","مما تحن إلى أعشاشها الحجل!",30,"ل",1,0],["أمّا هواكَ واِنْ تقادمَ عهدُه","فشفيعُ وجهِكَ ما يزالُ يُجِدُّهُ",31,"د",2,1],["أماه خير البلاد","أرعاك ما دمت حيا",32,"ي",2,0],["أمَّا هو جدُّهمْ طِلْسَمُ العَبا","وكَنزُ فُهومٍ صَيِّناتِ المَضارِبِ",33,"ب",1,0],["أمَا هذِه الأخلاقُ غيرُ حَماقَةٍ","يؤيدها العقل السليم من الخبل",34,"ل",1,0],["إِمّا هللتَ وَلَم تنظر إِلى نَشبٍ","كَما تَعَطَّلَ بَعد الخلقةِ الحالي",35,"ي",1,0],["أَما هُدَّت لِمَصرَعِهِ نِزارٌ","بَلى وَتَقَوَّضَ المَجدُ المَشيدُ",36,"د",1,0],["أما هواه فإنه هو ملّتي","وعليه كنت أعاهد الأستاذا",37,"ذ",2,0]]}