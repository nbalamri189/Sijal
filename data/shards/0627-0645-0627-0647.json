r=&rc=2",""],[5190,"وصية شهيد فلسطيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78343&r=&rc=56",""],[6343,"نفس من النفس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1972&r=&rc=2",""],[6355,"شيطان عاطفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66612&r=&rc=72",""]],"verses":[["أَمّا هَواكِ فَلَم نَعدِل بِمَنهَلِهِ","شُرَباً وَإِن كانَ يُروينا فَيُظمينا",0,"ن",2,0],["أما هي أرقى نسوة الشرق شيمةً","ونبلاً وأسماهن جاهاً ومحتدا",1,"د",2,0],["أَما هِيَ تِلْكَ الَّتِي خَرَّبَتْ","بُيُوتاً بِتَقْويضِهَا رُكْنَهَا",2,"ن",3,0],["أَما هِيَ تِلْكَ الَّتِي ضَعْضَعَتْ","شُعُوباً وَدَكَّتْ بِهَا مُدْنَهَا",2,"ن",3,0],["أَمّا هِشامٌ فَرِجلا قَينَةٍ مَجِنَت","باتَت تُغَمِّزُ وَسطَ السامِرِ الكَمَرا",3,"ر",2,0],["اما هواه فملء القلب يشبعني","مسرة واسمه المحبوب ملء فمي",4,"م",2,0],["إمّا هَوى نجمٌ ومالَ لضعفهِ","أبصرتِ حظَّكِ في الشعاعِ الغاربِ",5,"ب",1,0],["أَمَ اَهرُبُ حَتّى لا أَرى لي مُجاوِراً","أَمَ اَفعَلُ ماذا أَم أَبوحُ فَأُغلَبُ",6,"ب",1,0],["أُمّاه لا تُودِي بحقِّكِ وانبذي","رَأيَ الغُواةِ وخُطّةَ الجُهّالِ",7,"ل",1,0],["أَمّا هَدىً فَوَجَدتُهُ ما بَينَنا","سِرّاً وَلَكِنَّ الضَلالَ جِهارُ",8,"ر",1,0],["أُمّاه إنّي ضَريرُ","وَالقَلب مني كَسيرُ",9,"ر",1,1],["أُمّاه ما في حَياة ال","طفل الضَرير سرور",9,"ر",1,0],["أُمّاه إني إلى أَن","أَراكَ يَوماً فَقير",9,"ر",1,0],["أُمّاه هَل هذه الدن","يا رحبة تَستَنير",9,"ر",1,0],["أَمَّا هُمُ فَعُدَاةٌ مَا نُكَلِّمُهُمْ","وهْيَ الصَّدِيقُ بِهَا وَجْدٌ وتَخْبِيلُ",10,"ل",1,0],["أُمَّاهُ خانتني المقادر فاغفري","قدَري وإن قلَّ الفداءُ فسامحي",11,"ح",2,0],["أما هكذا الاقدار تنفذ حكمها","بلى ان هذا خصلة من عجابها",12,"ب",3,0],["أما هذه الدنيا التي يقتنونها","ستقتضب الاعمار منها الفجائع",13,"ع",1,0],["أما هواك فذاك ملء جوانحي","تحنو على ذكراك فيه وتكلف",14,"ف",1,0],["أما هذه الآجال في كل لحظة","بهن على دعوى النذير شهود",15,"د",1,0],["أما هاتف يرثي لنفس يقيمها","ويقعدها قولي ليها الدهر لا أدري",16,"ي",1,0],["أما هواك فلا زلت الحفي به","ولا أزال عليه الحادب الحاني",17,"ن",2,0],["أما هلال فقد أوفى بذمته","وفاء راع لحقّ الدين والأدب",18,"ب",1,0],["أمّاهُ كمْ أرهقتنا دُرْبةُ الأوّاهْ","مذ فَلَّقَ الدمعُ في أرواحِنا مَجْراهْ",19,"ا",2,1],["أُمّاهُ قد غَلَبَ الأسى","كُفّي الملامَ وعلّليني",20,"ن",2,0],["أُمّاهُ أَينَ أَبي فَإِنَّ لَهُ","عِندي شُؤوناً ضَيَّعَت رُشدي",21,"د",2,0],["أَماهرُ إِنَّ وعدَ اللَهِ حقٌّ","وَما جَزعي عليكَ منَ التُقاةِ",22,"ه",1,0],["أماهرُ كنتَ فيما مرَّ أُنسى","فمن لي في اللَيالي الباقِيات",22,"ت",1,0],["ام اهنا فيك العذول إلى ان","بكلام الوشاة منك منينا",23,"ن",2,0],["أمّا هواكِ فإنّهُ مُستَحكِمٌ","بجوارحي فمتى يُبَلُّ غليل",24,"ل",1,0],["أما هيَّجَت ذكراكِ عصفورةً غدَت","تُحيِّي ضياءً أو تزقُّ صَغيرا",25,"ر",2,0],["أمّا هَوَاكِ فَعَنْ سِوَاك مُكَتَّمٌ","والسِّرُّ عِنْدَ الحُرِّ فِي كِتْمَانِ",26,"ن",1,0],["أَما هَوْلٌ بِأَنْ يُحْثى وَيُلْقى","عَلَى ذاكَ الْجَمالِ ثَرىً مَهِيلُ",27,"ل",1,0],["أُمّاه أُبدلتِ بالأَملاكِ مكرُمةً","(أهلاً بأَهلٍ وجيراناً بجيران)",28,"ن",1,0],["أَم اهتك عفةً بسبيلِ قوتٍ","إِذاً إني لفي غيٍّ بعيد",29,"د",1,0],["أما همْ إلى قلبي من العينِ غُدْوةً","يَسيرون أن زَمُّوا الجِمالَ وساروا",30,"ر",3,0],["أم أهني الأكوان فهي جميعاً","في سرور ولذة واختيال",31,"ل",1,0],["أما هذي حليفهم","تعلونا على الغنم",32,"م",1,0],["إما هلالٌ منكُمُ واضحٌ","يسري لها أو كوكبٌ زاهرُ",33,"ر",1,0],["أما هنا يا بني عمي، فقد تعبت","مما تحن إلى أعشاشها الحجل!",34,"ل",1,0],["أمّا هواكَ واِنْ تقادمَ عهدُه","فشفيعُ وجهِكَ ما يزالُ يُجِدُّهُ",35,"د",2,1],["أماه خير البلاد","أرعاك ما دمت حيا",36,"ي",2,0],["أمَّا هو جدُّهمْ طِلْسَمُ العَبا","وكَنزُ فُهومٍ صَيِّناتِ المَضارِبِ",37,"ب",1,0],["أمَا هذِه الأخلاقُ غيرُ حَماقَةٍ","يؤيدها العقل السليم من الخبل",38,"ل",1,0],["إِمّا هللتَ وَلَم تنظر إِلى نَشبٍ","كَما تَعَطَّلَ بَعد الخلقةِ الحالي",39,"ل",2,0],["أَما هُدَّت لِمَصرَعِهِ نِزارٌ","بَلى وَتَقَوَّضَ المَجدُ المَشيدُ",40,"د",1,0],["أما هواه فإنه هو ملّتي","وعليه كنت أعاهد الأستاذا",41,"ذ",2,0],["أما هنا فإلى لقاك تسابقوا","مثل البنين إلى أبيها البار",42,"ر",1,0],["أَما هَواكَ فَذاكَ غَيرُ مُفارِقي","وَنَعيمُ روحي أَن تَكونَ فِداكا",43,"ك",2,0],["إمّا هَلَكتَ فَكُلُّ شَيء هالِكٌ","وَإذا فَنيتَ فَكُلُّ شَيءٍ فانِ",44,"ن",1,0],["أما هاشم قدماً أذلوا صعابها","فما بالها تيمٌ رقوها وأردفوا",45,"ف",3,0],["أماه قد حان الإياب لمضجعي","أماه قد حان الوداع فودعي",46,"ع",2,1],["أماه لما والدي أعماله","تقضى فيقفل راجعاً متوجعا",47,"ع",2,0],["أَما هُم أَضلّ العالمين وَإنهم","أَذل البَرايا يَوم قَطع الغلاصم",48,"م",1,0],["أَما هوَ خصَّني قَبل التَلاقي","بِآداب بِها المخفوض يَعلو",49,"ل",2,0],["أَما هُوَ قَد أَبدى مِن الرَأي ما سَما","بِهِ مِن بَني الأَوطان ناهٍ وَآمر",50,"ر",1,0],["أَما هُوَ في الحَماسة لَيث حَرب","يَهاب لِقاءه الجَمّ الغَفير",51,"ر",1,0],["أَما هَلكت قَوم عادَ وَقَد","قَضى اللَه فيهُم وَما خُلِّدوا",52,"د",3,0],["إمَّا هَتَكْنا بِكَفِّ المَزجِ سُتْرَتَها","أرْخَتْ لَنا دُونَ صَرْفِ الهَمِّ أحْجالا",53,"ل",2,0],["أما هواك فآخذ بقلوبنا","فكأنه الآيات والتنزيل",54,"ل",1,0],["أما هجائي فإنْ تَفَزَّزه","فليس مستنكراً تَفَزُّزُه",55,"ز",2,0],["إِمّا هَلَكتُ فَإِنّي قَد بَنَيتُ لَكُم","عِزَّ الحَياةِ بِما قَدَّمتُ قُدّامي",56,"م",2,0],["إمَّا هُمُ غَضِبُوا فالبأْسُ بَاْسُهُمُ","والحَقُّ في يدهم تأتي مَرَامِيْهِ",57,"ي",2,0],["اما هذه دار الحبيب نزلتها","أتذكر ما أولتك فيها انامله",58,"ل",2,0],["إِمَّا هَوَى من أفق مجدك كوكبٌ","فَتَعَز عَنهُ بكوكب وخدينِ",59,"ن",1,0],["أما هذا عدوكم المدلي","لوالدكم أما هذا الحسود",60,"د",1,0],["أماه روحي جاوبته وقد","بسطت ذراعيها له سندا",61,"د",2,0],["أمّاه لا يحزنك ما فعلت","فينا الليالي إنها عِبر",62,"ر",1,0],["أما هواك ففي أعز مكان","كم صارم من دونه وسنان",63,"ن",1,1],["أما هذا الديار ديار سعدى","أما هذا المعالم والرواسي",64,"س",2,0],["أَما هاشِمٌ في كلّ وقتٍ وساعةٍ","تُسامُ كما العَبْدُ العسيفُ يُسامُ",65,"م",1,0],["أما هو ظلم كنت في كل ساعة","تمثل للدنيا به ظلمة الحشر",66,"ر",1,0],["أما هو ملك طال بالحيف عهده","واشبعت فيه ضاري البحر والقفر",66,"ر",1,0],["أماهُ قد ماتَ صبري","إذ غاب نورُ العيون",67,"ن",1,0],["أماهُ ما عدتُ أرجو","لقاء من فارقوني",67,"ن",2,0],["أُماهُ جَيشي وَأَشبالي وَحاشِيَتي","قَد سَلَّموا لِلعِدا وَالدَهرُ غَدّارُ",68,"ر",1,0],["أُمّاهُ قَد نَطَقَ الجَلامِدُ فَاِنطِقي","وَت