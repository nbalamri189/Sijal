{"poems":[[63,"يا ربة البرقع كم غلة","https://www.aldiwan.net/poem45879.html","السريع"],[61,"سيوفكم بحمد الله نفع","https://www.aldiwan.net/poem51657.html","الوافر"],[235,"هنيئا هنيئا بعدما عز مهنأ","https://www.aldiwan.net/poem18032.html","الطويل"],[280,"ألحظك حز قلبي أم حسام","https://www.aldiwan.net/poem32633.html","الوافر"],[362,"حيتك غادية الحيا من مربع","https://www.aldiwan.net/poem60850.html","البسيط"],[362,"طلعت نجوم الدين فوق الفرقد","https://www.aldiwan.net/poem60958.html","الكامل"],[466,"أبا علي علي ليس ينصفه","https://www.aldiwan.net/poem59876.html","البسيط"]],"verses":[["فَلِمْ قَسا قَلْبُكِ في مَوْقفٍ","رَقَّتْ بِهِ الأَلْفاظُ وَالأَدْمُعُ",0,"ع",1,0],["فَلِمْ قَصُرَت وأيديكُم طِوالٌ","تُحكَّمُ في رِقابِ الناسِ طُرّا",1,"ر",2,0],["فَلِمْ قَدْ قَطَفْتُ القَوْلَ وَهْوَ مُنَوَّر ٌ","وَلِمْ قد عَلِمْتُ كَيْفَ أُنْهِي وَأَبْدَأُ",2,"ا",1,0],["فَلم قَتلي حَلالٌ في هَواهُ","عَلى عَمدٍ وَلم وَصلي حَرامُ",3,"م",1,0],["فلِمُقلتي أُفُقٌ خُصوصاً شَمسُه","من وَجْهها ونُجومُه من أَدمُعي",4,"ع",2,0],["فِلمِقوْلي في قلبِ كُل مُعانِد","تأثيرُ مصْقولِ الغِرارِ مهند",5,"د",1,0],["فَلِمَ قَدِمتَ عَلىتَشتيتِ وَصلِكَ لي","مِن بَعدِ ما كُنتَ مَجهوداً تُؤَلِّفُهُ",6,"ف",2,0]]}