{"poems":[[65,"يا ربة البرقع كم غلة","https://www.aldiwan.net/poem45879.html","السريع"],[63,"سيوفكم بحمد الله نفع","https://www.aldiwan.net/poem51657.html","الوافر"],[242,"هنيئا هنيئا بعدما عز مهنأ","https://www.aldiwan.net/poem18032.html","الطويل"],[287,"ألحظك حز قلبي أم حسام","https://www.aldiwan.net/poem32633.html","الوافر"],[369,"حيتك غادية الحيا من مربع","https://www.aldiwan.net/poem60850.html","البسيط"],[369,"طلعت نجوم الدين فوق الفرقد","https://www.aldiwan.net/poem60958.html","الكامل"],[473,"أبا علي علي ليس ينصفه","https://www.aldiwan.net/poem59876.html","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65094","المنسرح"],[5213,"يا من برقة طبع","https://www.poetsgate.com/ViewPoem.aspx?id=170542",""],[5691,"أقولُ لأمَّتي...!","https://www.poetsgate.com/ViewPoem.aspx?id=207393",""]],"verses":[["فَلِمْ قَسا قَلْبُكِ في مَوْقفٍ","رَقَّتْ بِهِ الأَلْفاظُ وَالأَدْمُعُ",0,"ع",1,0],["فَلِمْ قَصُرَت وأيديكُم طِوالٌ","تُحكَّمُ في رِقابِ الناسِ طُرّا",1,"ر",2,0],["فَلِمْ قَدْ قَطَفْتُ القَوْلَ وَهْوَ مُنَوَّر ٌ","وَلِمْ قد عَلِمْتُ كَيْفَ أُنْهِي وَأَبْدَأُ",2,"ا",1,0],["فَلم قَتلي حَلالٌ في هَواهُ","عَلى عَمدٍ وَلم وَصلي حَرامُ",3,"م",1,0],["فلِمُقلتي أُفُقٌ خُصوصاً شَمسُه","من وَجْهها ونُجومُه من أَدمُعي",4,"ع",2,0],["فِلمِقوْلي في قلبِ كُل مُعانِد","تأثيرُ مصْقولِ الغِرارِ مهند",5,"د",1,0],["فَلِمَ قَدِمتَ عَلىتَشتيتِ وَصلِكَ لي","مِن بَعدِ ما كُنتَ مَجهوداً تُؤَلِّفُهُ",6,"ف",2,0],["فلِمْ قَطَعْتَ الإِيناسَ عن نَفَرٍ","أَهواؤهمْ في هواكَ مُتَّفِقَهْ",7,"ق",2,0],["فلم قطعت محبا","على الوداد ملازم",8,"م",1,0],["فلَمَّ قَبائِلَ الأعْرابِ صَفّاً","غَدا بعْدَ العِداءِ لهُ قَبيلا",9,"ل",2,0]]}