{"poems":[[55,"أيعلم قبر بالجنينة أننا","https://www.aldiwan.net/poem29621.html","الطويل"],[79,"ألا حدثاها فهي أم العجائب","https://www.aldiwan.net/poem36775.html","الطويل"],[29,"انظر خليلي بأعلى ثرمداء ضحى","https://www.aldiwan.net/poem5927.html","البسيط"],[53,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[87,"ممات في المواكب أم حياة","https://www.aldiwan.net/poem62910.html","الوافر"],[47,"وعالمة وقد جهلت دوائي","https://www.aldiwan.net/poem10211.html","الوافر"],[46,"أعيدي النوح معولة أعيدي","https://www.aldiwan.net/poem30318.html","الوافر"],[107,"هو الخطب حتى ينكر التاج صاحبه","https://www.aldiwan.net/poem43380.html","الطويل"],[52,"نأتك على طول التجاور زينب","https://www.aldiwan.net/poem64821.html","الطويل"],[53,"خبا نَحْسٌ وأعقب منه سعْد","https://www.poetsgate.com/ViewPoem.aspx?id=28470",""],[203,"أأخشاه جفنا ما تسل قواضبه","https://www.aldiwan.net/poem45563.html","الطويل"],[287,"هنيئا لقد أوتيت سؤلك يا موسى","https://www.aldiwan.net/poem32738.html","الطويل"],[302,"بكيت لبرق لاح بالثغر باسمه","https://www.aldiwan.net/poem33167.html","الطويل"],[353,"رقيت من الشكوى بنعمة طالب","https://www.aldiwan.net/poem19856.html","الطويل"],[358,"بني خالد ما في بني الدهر خالد","https://www.aldiwan.net/poem40388.html","الطويل"],[358,"وفى لنا الدهر إسعادا بما وعدا","https://www.aldiwan.net/poem40401.html","البسيط"],[369,"كان المنى إذ تقضى ما عهدناه","https://www.aldiwan.net/poem60577.html","البسيط"],[409,"ثوى جبل العلم الذي طال واندكا","https://www.aldiwan.net/poem33612.html","الطويل"],[447,"أبا ساحباً ذيل البطالة والصبا","https://www.aldiwan.net/poem14400.html","الطويل"],[447,"أجل هذه الدنيا الدنية معشق","https://www.aldiwan.net/poem14466.html","الطويل"],[466,"وبالذروة الشماء من موطن العلى","https://www.aldiwan.net/poem15456.html","الطويل"],[469,"عيون المهى قلبي بنبلك مجروح","https://www.aldiwan.net/poem3149.html","عموديه"],[487,"سواطع التولي في أكتاف ذروته","https://www.aldiwan.net/poem24479.html","عموديه"],[563,"أزال عن الوجه الجميل قناعه","https://www.aldiwan.net/poem34366.html","الطويل"],[567,"لقبر التويني كل حين كرامة","https://www.aldiwan.net/poem52633.html","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103076","البسيط"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66746","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87110","البسيط"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130199","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70698","المجتث"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64895","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112786","الوافر"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122079","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49012","البسيط"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87847","الطويل"],[2049,"","https://poetry.dctabudhabi.ae/diwan/poem/118062","البسيط"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42480","الوافر"],[2215,"","https://poetry.dctabudhabi.ae/diwan/poem/121503","الطويل"],[2652,"","https://poetry.dctabudhabi.ae/diwan/poem/198387","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75882","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93846","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93863","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93795","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93925","الوافر"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100218","الطويل"],[3031,"","https://poetry.dctabudhabi.ae/diwan/poem/22534","الطويل"],[3252,"","https://poetry.dctabudhabi.ae/diwan/poem/105714","المتقارب"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68005","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123512","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123496","البسيط"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102743","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58009","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58154","الطويل"],[5010,"مَا زِلْتُ مُتَّكِأً عَلَى رَجَائِي","https://www.poetsgate.com/ViewPoem.aspx?id=190649",""],[5206,"حَيَاةُ المُهَج","https://www.poetsgate.com/ViewPoem.aspx?id=187392",""],[592,"رسائل أخوان الصفا والتودد","https://www.poetsgate.com/ViewPoem.aspx?id=128837",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5786,"إن كنتَ لي صاحباً قِف لي بهبود","https://www.poetsgate.com/ViewPoem.aspx?id=50651",""],[5854,"إلى من ابتلي بمشاهدة الأفلام الفاضحة","https://www.poetsgate.com/ViewPoem.aspx?id=191818",""]],"verses":[["هُوَ الخاضِبُ الأَقلامَ نالَ بِها عُلىً","تَقاصَرَ عَنها الخاضِبونَ العَوالِيا",0,"ي",2,0],["هُوَ الْخَبرُ الصِّدْقُ الَّذِي وَضَحَتْ بِهِ","سَبِيلُ الْهُدَى بَعْدَ الْتِبَاسِ الْمَذَاهِبِ",1,"ب",1,0],["هُوَ الخَليفَةُ فَاِرضَوا ما قَضى لَكُمُ","بِالحَقِّ يَصدَعُ ما في قَولِهِ جَنَفُ",2,"ف",1,0],["هو الخوفُ والتأميلُ والرأيُ والهوى","فيا ليت شعر النفسِ كيف تصارمُ",3,"م",1,0],["هُوَ الخَبَرُ اليَقينُ وَما سِواهُ","أَحاديثُ المُنى وَالتُرَّهاتُ",4,"ت",1,0],["هُوَ الخِلُّ الوَدودُ لِكُلِّ خِلٍّ","يَدومُ عَلى المَوَدَّةِ وَالإِخاءِ",5,"ا",2,0],["هُوَ الخَطبُ الَّذي اِبتَدَعَ الرَزايا","وَقالَ لِأَعيُنِ الثَقَلَينِ جودي",6,"د",2,0],["هُوَ الخَطبُ حَتّى يُنكِرَ التاجَ صاحِبُهْ","وَحَتّى يَظُنَّ العَرشَ حَتفاً يُراقِبُهْ",7,"ب",2,1],["هُوَ الخَنفُ لا إِنسٌ وَلا نَجلُ جِنَّةٍ","يَعيشُ وَلا يَغذوهُ أُمٌّ وَلا أَبُ",8,"ب",1,0],["هو الخَصْم الألدُ لكلِّ ضِدٍّ","من الأضْداد والقَرْن الأعَدُّ",9,"د",1,0],["هو الخمرُ لولا طعمها وخمارُها","هو السحرُ لولا ذمَّهُ ومعائبُهُ",10,"ب",2,0],["هُوَ الخَضرُ المَشهورُ نَشراً وَسُؤدَداً","وَيوسُفُ حسناً والْقَ موسى تجد موسى",11,"س",2,0],["هُوَ الخضِرُ الأَكنافِ والخِضرم الَّذي","يَرى وَشَلاً كلَّ الخضارِم عائمُه",12,"م",2,0],["هُوَ الخَصِرُ الجَمُّ الجَدّى الخضِرُ الندا","إذا لَمْ يَبُلَّ البَحْرُ غُلَّةَ شَارِبِ",13,"ب",1,0],["هُوَ الخَطب كَم أَعيا خَطيباً كَأَنَّما","عَلى أَصغريهِ مِن أَسا البين عاقدُ",14,"د",1,0],["هُوَ الخَبير بِأَحوال الأَنام فَلا","يَزال نورُ ذكاه الدَهر مُتَّقِدا",15,"د",2,0],["هو الخيالُ الّذي يَسْري لموعدِه","فيُقْمرُ اللّيلُ للسّاري بمَسْراه",16,"ا",2,0],["هو الخطب قد أصل الحشا لهب الأسى","فكم مهجة أنكى وكم مقلةٍ أبكى",17,"ك",2,0],["هو الخالق الباري المصور ما له","شريك بباريه وشبه ترتَّبا",18,"ب",2,0],["هو الخلف الباقي بعمران ملكه","فيحرم من يبغي ومن شاء يرزق",19,"ق",1,0],["هو الخاضب العسَّال من نحر قِرنه","إِذا النفعُ ضلَّت في الطعان عواسله",20,"ل",2,0],["هو الخصرِ النُّعمى على كبد العُلى","لدى حيث وجه اليوم بالماءِ منضوح",21,"ح",1,0],["هو الخبيث الذي جلت بشاعته","واستعظمت الشبل في أجم",22,"م",1,0],["هو الخير محض الخير والشر فرضه","وتقديره للعقل بان فراعه",23,"ع",2,0],["هُوَ الخِضرُ في أجيال كلِّ مؤرِّخٍ","لهُ قامَ في بيروتَ ذِكرٌ مؤبَّدُ",24,"د",1,0],["هو الخيال الذي في الماء تثبته","حسا وبالعقل تنفي غير منحجم",25,"م",1,0],["هو الخاطرُ المختالُ يَمشي بِسيفِهِ","إلى أهلِ بدرٍ والأَسَّنةُ تُنْزَعُ",26,"ع",1,0],["هُوَ الخديوي الَّذي أَوطانُه نَشرت","لِلفَضل في عَصره مَطويّ أَعلام",27,"م",1,0],["هو الخطيب لبنت الفكر لو سمعت","أذناه ابلغ من في العرب ما خطبا",28,"ب",2,0],["هو الخليفةُ بعد ال","هادي النبيِّ محمد",29,"د",1,0],["هو الخَليقُ بأَنْ يُغنيكَ فاغْنَ بهِ","ولا تُعُدَّنَّ خَلْقاً غيرَهُ خُلِقَا",30,"ق",2,0],["هو الختم الكريم لرسل ربي","وحسبك أن للخير سُلم",31,"م",1,0],["هُوَ الخَطْبُ هَلْ عَجَّتْ بِهِ قَيْسُ عَيْلاَنِ","عَجِيجَ الحَجِيجِ اسْتَقْبَلُوا شِعْبَ نُعْمَانِ",32,"ن",1,1],["هو الخليلُ وما مِثلُ الخليلِ فَتىً","بجودِهِ يتباهى العُرْبُ والعَجَم",33,"م",1,0],["هُوَ الخُلدُ وَالغيدُ الأَماليدُ حورُهُ","وَتِلكَ الطُيورُ الصادِحاتُ شَواعِرُه",34,"ر",2,0],["هو الخلا حل حلما والحيا كرما","والليث عينا إذا ما هم أو عسفا",35,"ف",2,0],["هو الخطُّ الشريفُ وقد أتانا","تعالى اللَّهُ مرسلُهُ تباركْ",36,"ك",1,0],["هو الخمر لكن أين للخمر طعمه","ولذته مع أنني لم أذقها",37,"ه",2,0],["هو الخلف المعروف والدين والتقى","ومسعر حرب لا كهام ولا غمر",38,"ر",1,0],["هُوَ الخَطيبُ وَنَجلٌ للخَطيبِ وَصُن","وٌ للخَطيبِ يَفوقُ الناسَ إِفصاحا",39,"ح",2,0],["هو الخضم الذي عمت موارده","للناس سيان ذو بعد وذو قرب",40,"ب",1,0],["هو الخبير بعلم الصرف خبرته","تأتي بمنفرد فيه ومزدوج",41,"ج",1,0],["هو الخديوي وحيد الدهر مفرده","من لم تكن مثله ولادة ولدت",42,"ت",1,0],["هو الخل الوفي أبو المزيايا","أخو الثمرات طيبة المجاني",43,"ن",2,0],["هو الخطب لم تكفف بسلم كتائبه","يحارب بالأرزاء من لا يحاربه",44,"ب",2,0],["هُوَالخُلدُ في الدُنيا لِمَن يَستَطيعُهُ","وَقَتلٌ لِأَصحابِ الصَبابَةِ مُذعِفُ",45,"ف",1,0],["هو الخطب في الدين جل وجالا","فعم الأنام وخص الجلالا",46,"ل",2,1],["هو الخِضَمُّ الْتَقِطْ من صَفْوِه دُرراً","وإن يُهَج فاحذرِ الأمواجَ لا تَرِد",47,"د",1,0],["هو الخليل الجليل السيد السند النور","الذي ضوءه الاقمار قد بهظا",48,"ظ",2,0],["هو الخليل الجليل الكامل العثم الحاوى","السناء وكل الحسن احواذا",49,"ذ",2,0],["هو الخاتم المبعوث أشرف مرسل","وأكرم من ضمته في مهده القمط",50,"ط",1,0],["هو الخالقُ المحيي المميتُ وباعثٌ","ليومِئذٍ فيه تشيبُ الولائِدُ",51,"د",1,0],["هو الخطبُ حتى صارَ كل معظَّمِ","حقيراً وجادت مُقْلَةُ العينِ بالدمِ",52,"م",1,1],["هُوَ الْخَلَاصُ مِنَ الْأَهْوَالِ أَجْمَعِهَا","هُوَ الْمَلَاذُ ، وَنِعْمَ الْوَاحِدُ الْأَحَدُ",53,"د",1,0],["هُوَ الخِزْيُ والدَّاءُ القَبِيحُ لِأَهْلِهِ","هُوَ الهُوَّةُ الدَّهْيَاءُ يَا بِيْسَهَا لِهْبَا",54,"ب",2,0],["هو الخالق المحيي المميت مدبر","هو المالك الرازق فاسأله واجتد",55,"د",1,0],["هو الخضر المخصوص في الكهف ذكره","وموسى كليم الله فافهم لمقصد",55,"د",1,0],["هو الخارجي المعتد الكافر الذي","يكفرنا لما دعونا ذوي اللحد",56,"د",1,0],["هو الخديجي ذو المجدِ الأثيل ومن","أضحى به الدّينُ في عز وتأييدِ",57,"د",1,0],["هو الخبثُ المبينُ وكلُّ شرٍّ","ستهوي مِنه في قعرٍ سحيقِ",58,"ق",1,0]]}