{"poems":[[53,"لمن الحدوج تهزهن الأنيق","https://www.aldiwan.net/poem29959.html","الكامل"],[53,"هذي المنازل بالغميم فنادها","https://www.aldiwan.net/poem30606.html","الكامل"],[77,"تتعاور القطبان منها رقعة","https://www.aldiwan.net/poem35899.html","الكامل"],[71,"مصحف عثمان صاح من حنق","https://www.aldiwan.net/poem3743.html","المنسرح"],[71,"لا رعى الله ليلتي في بخارى","https://www.aldiwan.net/poem3902.html","الخفيف"],[73,"يا قمرا مطلعه المغرب","https://www.aldiwan.net/poem11865.html","السريع"],[93,"هل بعالي الذرى مكان اعتصام","https://www.aldiwan.net/poem11308.html","الخفيف"],[41,"يا روضة الوضاح قد","https://www.aldiwan.net/poem42348.html","مجزوء الكامل"],[47,"ألزمني ذنبا بلا ذنب","https://www.aldiwan.net/poem25347.html","السريع"],[51,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[51,"الزب رب للنساء","https://www.aldiwan.net/poem65482.html","مجزوء الكامل"],[89,"الزهر أكبر مصرع الصداح","https://www.aldiwan.net/poem44607.html","الكامل"],[89,"يا مصر فيك الشعر مات اميره","https://www.aldiwan.net/poem44744.html","الكامل"],[85,"كان ذئب يتغذى","https://www.aldiwan.net/poem8000.html","مجزوء الرمل"],[85,"لك في الأرض والسماء مآتم","https://www.aldiwan.net/poem11330.html","الخفيف"],[85,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[85,"آل زغلول حسبكم من عزاء","https://www.aldiwan.net/poem62833.html","الخفيف"],[43,"واحر قلباه ممن قلبه شبم","https://www.aldiwan.net/poem10521.html","البسيط"],[62,"الزئبق الشرقي في سرنا","https://www.aldiwan.net/poem52180.html","السريع"],[62,"الزئبق الأبيض الرقيق إذا","https://www.aldiwan.net/poem52189.html","المنسرح"],[99,"غرناطة","https://www.aldiwan.net/poem6258.html","عموديه"],[44,"الزنج أكرم منكم والروم","https://www.aldiwan.net/poem30003.html","الكامل"],[44,"إجعل لعيني في الكرى حظا","https://www.aldiwan.net/poem30221.html","السريع"],[69,"يا شجر اللوز ترنح ومل","https://www.aldiwan.net/poem28377.html","السريع"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[74,"أنى تطاولني ودوني بسطتا","https://www.aldiwan.net/poem12908.html","الكامل"],[105,"قل للألى رقدوا والعدل يقظان","https://www.aldiwan.net/poem42055.html","البسيط"],[52,"هل من معين على أحداث أزماني","https://www.aldiwan.net/poem26625.html","البسيط"],[48,"لا أستزيد حبيبي من مواتاتي","https://www.aldiwan.net/poem62462.html","البسيط"],[50,"لا تبغ شر امرئ شرا من الداء","https://www.aldiwan.net/poem64885.html","البسيط"],[46,"اللب قطب والأمور له رحى","https://www.aldiwan.net/poem22570.html","الكامل"],[46,"هي طرق فمن ظهور وأرحا","https://www.aldiwan.net/poem22729.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85597","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85441","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85582","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85351","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85636","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85432","الكامل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140979",""],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54812","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55049","الخفيف"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116954","الخفيف"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/206203","الكامل"],[106,"محنة فرنسا","https://www.poetsgate.com/ViewPoem.aspx?id=179418",""],[106,"تمثال فينوس","https://www.poetsgate.com/ViewPoem.aspx?id=179776",""],[43,"واحر قلباه ممن قلبه شبم","https://www.poetsgate.com/ViewPoem.aspx?id=415",""],[94,"ذكرى الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=15593",""],[51,"الزُّبُّ زبٌّ للنِسا","https://www.poetsgate.com/ViewPoem.aspx?id=29861",""]],"verses":[["الزاخِرُ الغَدِقُ الَّذي يُروى بِهِ","ظَمَأُ المُنى وَالوابِلُ المُتَبَعِّقُ",0,"ق",1,0],["الزَهدُ وَالأَحلامُ في فُتّاكِها","وَالفَتكُ لَولا اللَهُ في زُهّادِها",1,"د",3,0],["الزّهْرَةُ الزّهْراءُ فَرْزانٌ بِها","والبَدْرُ شاهٌ والنّجومُ بَيادِقُ",2,"ق",1,0],["الزَنكَلونِيُّ صارَ يَخدِمُني","يا رَبِّ عَجِّل بِالفَأرِ وَالأَرَضَه",3,"ض",2,0],["أَلزَموني ما قالَهُ الخالِدِيّانِ","وَراحوا عَنّي بِقَولِ جَريرِ",4,"ر",1,0],["أَلزَمتَني الذَنبَ الَّذي جِئتَهُ","صَدَقتَ فَاِصفَح أَيُّها المُذنِبُ",5,"ب",1,0],["أَلزَّعِيمُ الخَلِيقُ مِنْهَا وَلا مَ","نٌّ عَلَيْهِ بِالحُبِّ وَالإِكْرَامِ",6,"م",1,0],["الزَّوجُ يَدعو إِلفَهُ","فَتَطَاعَما حُبَّ السَكَن",7,"ن",1,0],["أَلزَمَني ذَنباً بِلا ذَنبِ","وَلَجَّ في الهِجرانِ وَالعَتبِ",8,"ب",1,1],["ألزم اللّؤمُ أنفك الذُلَّ حتى","هو سيّانِ ذِلَّةً والمِقَطُّ",9,"ط",1,0],["الزب ربٌّ للنسا","ء يمقنه ويخفنَهُ",10,"ن",2,1],["الزهر أكبر مصرع الصداح","فبكت عليه شقائق وأقاح",11,"ح",1,1],["الزهر اكبر مصرع الصيداح","فبكت عليه شقائق واقاح",12,"ح",1,0],["أَلزَمَتهُ الصَومَ حَتّى","فَجَعَت في الروحِ جِسمَه",13,"م",2,0],["الزَكِيّونَ عُنصُراً مِثلَ إِبرا","هيمَ وَالطَيِّبونَ مِثلَ القاسِم",14,"م",1,0],["الزاخِرُ العَذبُ في عِلمٍ وَفي أَدَبٍ","وَالناصِرُ النَدبِ في حَربٍ وَفي سَلَمِ",15,"م",1,0],["آلَ زَغلولَ حَسبُكُم مِن عَزاءٍ","سُنَّةُ المَوتِ في النَبِيِّ وَآلِه",16,"ل",2,1],["أَلزَمتَ نَفسَكَ شَيئاً لَيسَ يَلزَمُها","أَن لا يُوارِيَهُم أَرضٌ وَلا عَلَمُ",17,"م",1,0],["الزئبق الشرقي في سرنا ال","مكتوم يدعى الزئبق الأعلى",18,"ل",2,1],["الزئبق الأبيض الرقيق إذا","ما فارق الأرض فهو طيارُ",19,"ر",1,1],["الزخرفات.. أكاد أسمع نبضه","والزركشات على السقوف تنادي",20,"ي",1,0],["الزَنجُ أَكرَمُ مِنكُمُ وَالرومُ","وَالحَينُ أَيمَنُ مِنكُمُ وَالشومُ",21,"م",1,1],["أَلزَمتَني ذَنباً فَعاقَبتَني","مِن قَبلِ أَن تَسمَعَ لي لَفظا",22,"ظ",2,0],["الزهرُ في جيدِكَ درُّ الحلي","والماءُ في ساقِكَ خلخالُ",23,"ل",1,0],["ألزمتها الجِدَّ حيثُ الناسُ هازلةٌ","والهزلَ في موقفٍ بالجدِّ مقرون",24,"ن",1,0],["إِلزِم ثَراكَ وَغُضَّ طَرفَكَ ذِلَّةً","فَمَكانَتي أَنأى عَلَيكَ وَأَبعَدُ",25,"د",1,0],["الزرعُ حولك ذاوٍ والثّرى يَبِسٌ","والعبقريّةُ أنهارٌ وخُلجانُ",26,"ن",1,0],["الزاجِرِ الدَهرِ عَنّي إِذ شَحا فَمَهُ","وَمَدَّ كَفَّيهِ في ظُلمٍ وَعُدوانِ",27,"ن",1,0],["أَلُزُّهُ بِحُمَيّاها وَأَزجُرُهُ","بِاللينِ طَوراً وَبِالتَشديدِ تاراتِ",28,"ت",1,0],["أَلزَمتَ عَينَكَ مِن بَغضائِنا حَوَلاً","لَو قَد وَسَمتُكَ عادَت غَيرَ حَولاءِ",29,"ا",2,0],["إِلزَم ذَراكَ وَإِن لَقيتَ خَصاصَةً","فَاللَيثُ يَستُرُ حالَهُ الإِخدارُ",30,"ر",1,0],["إِلزَمِ الصَمتَ إِن أَرَدتِ نَجاةً","لَيسَ ضَحضاحُ مَنطِقٍ مِثلَ غَمرِ",31,"ر",1,0],["الزم مكانك لا تحذر مقاربتي","فَلَيسَ مني عليك اليوم من خطر",32,"ر",1,0],["الزهر كل الزهر غُيّب في الثَرى","فكأَنَّما تحت التراب رَبيع",33,"ع",1,0],["الزوج كان هو الَّذي","يولي الرضى ثم استردا",34,"د",2,0],["إِلزامك المَرء بالبرهان تورده","لا يحمل المَرء في يوم عَلى العمل",35,"ل",1,0],["الزهر فوق الأرض مبثوث وقد","ألقت عليه ظلها الأدواح",36,"ح",1,0],["الزَهر فيه مشبه","للزُهر في الفلك المدار",37,"ر",1,0],["ألزمت نفسك شيئاً ليس يلزمها","ألاّ تواريهم أرضٌ ولا علم",38,"م",1,0],["إِلْزَمُوا طَاعَةَ الأَكَابِرِ مِنْكُمْ","ذَاكَ وَحْيُ الْهُدَى وَنَهْجُ الرَّشَادِ",39,"د",1,0],["الزَّكِيِّ الْفُرُوعِ مِمَّنْ نَمَاهُمْ","وَالذَّكِيِّ الأُصُوِل وَالأَعْرَاقِ",40,"ق",1,0],["الزمِ الثغر والعبُّدَ فيه","فيسَ بغدادُ موضعَ الزُهاد",41,"د",1,0],["الزخرفات أكاد أسمع نبضها","والزركشات على الرفوف تنادي",42,"ي",1,0],["الزيتُ والبترولُ من آلاتها","والعلْمُ ينفخ إن خَبَت أكوارها",43,"ر",3,0],["الزَّهر لا يَرعَونَهُ","بل يَقنَعُونَ بنشره",44,"ر",2,0],["أَلزَمتَ نَفسَكَ شَيئًا لَيسَ يَلزَمُها","ألا يُوارِيَهُم أَرضٌ وَلا عَلَمُ",45,"م",1,0],["الزغاريدُ، فقد جُنَّ الإباءُ","من صفاتِ الله هذي الكبرياء",46,"ا",2,1],["الزُّبُّ زبٌّ للنِسا","ءِ يَمِقْنَه وَيَخَفْنَهُ",47,"ن",2,1]]}