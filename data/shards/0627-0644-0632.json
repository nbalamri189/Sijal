.poetsgate.com/ViewPoem.aspx?id=187232",""],[5836,"الزهد الحقيقي","https://www.poetsgate.com/ViewPoem.aspx?id=194587",""],[5866,"نحمد الله","https://www.poetsgate.com/ViewPoem.aspx?id=182813",""],[5875,"شمس الشموس","https://www.poetsgate.com/ViewPoem.aspx?id=11739",""],[5910,"فلطالما حاربتُ ذا سفهٍ","https://www.poetsgate.com/ViewPoem.aspx?id=207125",""],[5929,"خارطة الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=197059",""],[5952,"الزم قطيعك","https://www.poetsgate.com/ViewPoem.aspx?id=197112",""],[6038,"نون 2003","https://www.poetsgate.com/ViewPoem.aspx?id=25700",""],[6056,"كفيّ ، طوّ قت معصمه","https://www.poetsgate.com/ViewPoem.aspx?id=130137",""],[6056,"مفهوم المعاني","https://www.poetsgate.com/ViewPoem.aspx?id=130509",""],[6056,"الحكي والوشاية","https://www.poetsgate.com/ViewPoem.aspx?id=156706",""],[6069,"لا تجزعن بقلبك المفتون","https://www.poetsgate.com/ViewPoem.aspx?id=105710",""],[6093,"كرونا","https://www.poetsgate.com/ViewPoem.aspx?id=211150",""],[6115,"شوف مفعول الكرامه بصدام العراق","https://www.poetsgate.com/ViewPoem.aspx?id=181638",""],[6115,"صكّه الدهر فالجبهه بمشعابه!","https://www.poetsgate.com/ViewPoem.aspx?id=185782",""],[6115,"الذياب استنعجت والنعاج استذيبت!","https://www.poetsgate.com/ViewPoem.aspx?id=196470",""],[6142,"بنت النبوة أخت الذكر أم هدا","https://www.poetsgate.com/ViewPoem.aspx?id=155741",""],[6186,"عادت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82885&r=&rc=5",""],[6225,"النصف الأقوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81093&r=&rc=287",""],[6247,"الراحلون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80266&r=&rc=5",""]],"verses":[["الزاخِرُ الغَدِقُ الَّذي يُروى بِهِ","ظَمَأُ المُنى وَالوابِلُ المُتَبَعِّقُ",0,"ق",1,0],["الزَهدُ وَالأَحلامُ في فُتّاكِها","وَالفَتكُ لَولا اللَهُ في زُهّادِها",1,"د",3,0],["الزّهْرَةُ الزّهْراءُ فَرْزانٌ بِها","والبَدْرُ شاهٌ والنّجومُ بَيادِقُ",2,"ق",1,0],["الزَنكَلونِيُّ صارَ يَخدِمُني","يا رَبِّ عَجِّل بِالفَأرِ وَالأَرَضَه",3,"ض",2,0],["أَلزَموني ما قالَهُ الخالِدِيّانِ","وَراحوا عَنّي بِقَولِ جَريرِ",4,"ر",1,0],["أَلزَمتَني الذَنبَ الَّذي جِئتَهُ","صَدَقتَ فَاِصفَح أَيُّها المُذنِبُ",5,"ب",1,0],["أَلزَّعِيمُ الخَلِيقُ مِنْهَا وَلا مَ","نٌّ عَلَيْهِ بِالحُبِّ وَالإِكْرَامِ",6,"م",1,0],["الزَّوجُ يَدعو إِلفَهُ","فَتَطَاعَما حُبَّ السَكَن",7,"ن",1,0],["أَلزَمَني ذَنباً بِلا ذَنبِ","وَلَجَّ في الهِجرانِ وَالعَتبِ",8,"ب",1,1],["ألزم اللّؤمُ أنفك الذُلَّ حتى","هو سيّانِ ذِلَّةً والمِقَطُّ",9,"ط",1,0],["الزب ربٌّ للنسا","ء يمقنه ويخفنَهُ",10,"ن",2,1],["الزهر أكبر مصرع الصداح","فبكت عليه شقائق وأقاح",11,"ح",1,1],["الزهر اكبر مصرع الصيداح","فبكت عليه شقائق واقاح",12,"ح",1,0],["أَلزَمَتهُ الصَومَ حَتّى","فَجَعَت في الروحِ جِسمَه",13,"م",2,0],["الزَكِيّونَ عُنصُراً مِثلَ إِبرا","هيمَ وَالطَيِّبونَ مِثلَ القاسِم",14,"م",1,0],["الزاخِرُ العَذبُ في عِلمٍ وَفي أَدَبٍ","وَالناصِرُ النَدبِ في حَربٍ وَفي سَلَمِ",15,"م",1,0],["آلَ زَغلولَ حَسبُكُم مِن عَزاءٍ","سُنَّةُ المَوتِ في النَبِيِّ وَآلِه",16,"ل",2,1],["أَلزَمتَ نَفسَكَ شَيئاً لَيسَ يَلزَمُها","أَن لا يُوارِيَهُم أَرضٌ وَلا عَلَمُ",17,"م",1,0],["الزئبق الشرقي في سرنا ال","مكتوم يدعى الزئبق الأعلى",18,"ل",2,1],["الزئبق الأبيض الرقيق إذا","ما فارق الأرض فهو طيارُ",19,"ر",1,1],["الزخرفات.. أكاد أسمع نبضه","والزركشات على السقوف تنادي",20,"د",2,0],["الزَنجُ أَكرَمُ مِنكُمُ وَالرومُ","وَالحَينُ أَيمَنُ مِنكُمُ وَالشومُ",21,"م",1,1],["أَلزَمتَني ذَنباً فَعاقَبتَني","مِن قَبلِ أَن تَسمَعَ لي لَفظا",22,"ظ",2,0],["الزهرُ في جيدِكَ درُّ الحلي","والماءُ في ساقِكَ خلخالُ",23,"ل",1,0],["ألزمتها الجِدَّ حيثُ الناسُ هازلةٌ","والهزلَ في موقفٍ بالجدِّ مقرون",24,"ن",1,0],["إِلزِم ثَراكَ وَغُضَّ طَرفَكَ ذِلَّةً","فَمَكانَتي أَنأى عَلَيكَ وَأَبعَدُ",25,"د",1,0],["الزرعُ حولك ذاوٍ والثّرى يَبِسٌ","والعبقريّةُ أنهارٌ وخُلجانُ",26,"ن",1,0],["الزاجِرِ الدَهرِ عَنّي إِذ شَحا فَمَهُ","وَمَدَّ كَفَّيهِ في ظُلمٍ وَعُدوانِ",27,"ن",1,0],["أَلُزُّهُ بِحُمَيّاها وَأَزجُرُهُ","بِاللينِ طَوراً وَبِالتَشديدِ تاراتِ",28,"ت",1,0],["أَلزَمتَ عَينَكَ مِن بَغضائِنا حَوَلاً","لَو قَد وَسَمتُكَ عادَت غَيرَ حَولاءِ",29,"ا",2,0],["إِلزَم ذَراكَ وَإِن لَقيتَ خَصاصَةً","فَاللَيثُ يَستُرُ حالَهُ الإِخدارُ",30,"ر",1,0],["إِلزَمِ الصَمتَ إِن أَرَدتِ نَجاةً","لَيسَ ضَحضاحُ مَنطِقٍ مِثلَ غَمرِ",31,"ر",1,0],["الزم مكانك لا تحذر مقاربتي","فَلَيسَ مني عليك اليوم من خطر",32,"ر",1,0],["الزهر كل الزهر غُيّب في الثَرى","فكأَنَّما تحت التراب رَبيع",33,"ع",1,0],["الزوج كان هو الَّذي","يولي الرضى ثم استردا",34,"د",2,0],["إِلزامك المَرء بالبرهان تورده","لا يحمل المَرء في يوم عَلى العمل",35,"ل",1,0],["الزهر فوق الأرض مبثوث وقد","ألقت عليه ظلها الأدواح",36,"ح",1,0],["الزَهر فيه مشبه","للزُهر في الفلك المدار",37,"ر",1,0],["ألزمت نفسك شيئاً ليس يلزمها","ألاّ تواريهم أرضٌ ولا علم",38,"م",1,0],["إِلْزَمُوا طَاعَةَ الأَكَابِرِ مِنْكُمْ","ذَاكَ وَحْيُ الْهُدَى وَنَهْجُ الرَّشَادِ",39,"د",1,0],["الزَّكِيِّ الْفُرُوعِ مِمَّنْ نَمَاهُمْ","وَالذَّكِيِّ الأُصُوِل وَالأَعْرَاقِ",40,"ق",1,0],["الزمِ الثغر والعبُّدَ فيه","فيسَ بغدادُ موضعَ الزُهاد",41,"د",1,0],["الزخرفات أكاد أسمع نبضها","والزركشات على الرفوف تنادي",42,"د",2,0],["الزيتُ والبترولُ من آلاتها","والعلْمُ ينفخ إن خَبَت أكوارها",43,"ر",3,0],["الزَّهر لا يَرعَونَهُ","بل يَقنَعُونَ بنشره",44,"ر",2,0],["أَلزَمتَ نَفسَكَ شَيئًا لَيسَ يَلزَمُها","ألا يُوارِيَهُم أَرضٌ وَلا عَلَمُ",45,"م",1,0],["الزلّه اللي خسّرتني مربحي","عز الله أنها منك جت في وقتها",46,"ت",3,0],["الزمن هو هو ... وأحثالة العالم....؟.... غجر..","وللعسل ذايق وللسم الاسود.. جارعه",47,"ع",2,0],["الزاهرات اللي عطرها بكل حالاته.. شذي..","لاهب منها.. فج.. ترتيب الخصال.. الموميه. .",48,"م",3,0],["الزاهدين بها ولو كشفت لهم","سرّ الحياة المجتلى لم يزهدوا",49,"د",3,0],["الزغاريدُ، فقد جُنَّ الإباءُ","من صفاتِ الله هذي الكبرياء",50,"ا",2,1],["الزُّبُّ زبٌّ للنِسا","ءِ يَمِقْنَه وَيَخَفْنَهُ",51,"ن",2,1],["الزهر وحي دلالك","والشعر وحي جمالك",52,"ك",1,0],["أَلزَمتُهُ حُبَّ الوَفا","ءِ وَقَلَّ أَن يَتَقَلَّبا",53,"ب",2,0],["الزَّهرُ يَزكى عَرفُهُ بذُبُولهِ","وكذا النفوسُ تصحُّ بالأدواء",54,"ا",2,0],["الزّهرُ عندي خيرُ ما يُهدى","فبنَشقه أتذكَّرُ العهدا",55,"د",2,1],["الزهرُ ريشٌ من ملائكةٍ","يُهدى الى أخواتِ 