{"poems":[[42,"ألا تلك عرسي أم سكن تنكرت","https://www.aldiwan.net/poem50437.html","الطويل"],[42,"رأيت زيادا يجتويني بشره","https://www.aldiwan.net/poem50454.html","الطويل"],[93,"هدايا الناس من زهر الجنان","https://www.aldiwan.net/poem11187.html","الوافر"],[30,"خليلي عوجا عوجة","https://www.aldiwan.net/poem29570.html","الطويل"],[30,"وقفت على ربع لمية ناقتي","https://www.aldiwan.net/poem29613.html","الطويل"],[37,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[72,"برغم العلى تاج تحلى به الثرى","https://www.aldiwan.net/poem18719.html","الطويل"],[72,"أخا اللوم لا تتعب لسانا ولا ذهنا","https://www.aldiwan.net/poem20176.html","الطويل"],[51,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[91,"طوى بعض نفسي إذ طواك الثرى عني","https://www.aldiwan.net/poem62780.html","عموديه"],[70,"يغيب إذا غبت عني السرور","https://www.aldiwan.net/poem42852.html","الطويل"],[78,"وعدت وأخلفتني الموعدا","https://www.aldiwan.net/poem14175.html","المتقارب"],[43,"هو البين حتى ما تأنى الحزائق","https://www.aldiwan.net/poem9738.html","الطويل"],[62,"فؤاد على كر الحوادث مارد","https://www.aldiwan.net/poem52454.html","الطويل"],[28,"وركب قد استرخت طلاهم من السرى","https://www.aldiwan.net/poem5467.html","الطويل"],[66,"لا يوخذ الجار في الأعراض بالجار","https://www.aldiwan.net/poem38786.html","البسيط"],[33,"وقال نساء لسن لي بنواصحن","https://www.aldiwan.net/poem25720.html","الطويل"],[105,"على ذكرها فليعرف الحق جاهله","https://www.aldiwan.net/poem41937.html","الطويل"],[50,"أقمت وأجريت الصبا ما وحى واح","https://www.aldiwan.net/poem63975.html","الطويل"],[57,"ما شئت كان وإن لم أشأ","https://www.poetsgate.com/ViewPoem.aspx?id=3314",""],[78,"وعدتَ وأَخلفتني الموعدا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86620&r=&rc=115",""],[110,"على ذات القرنفل قد حططنا","https://www.aldiwan.net/poem16311.html","الوافر"],[110,"إذا ما زرت أكناف المرام","https://www.aldiwan.net/poem16459.html","الوافر"],[170,"أفي كل يوم للخطوب أصالي","https://www.aldiwan.net/poem1650.html",""],[190,"رأى مدح خير الخلق صعبا فأحجما","https://www.aldiwan.net/poem35105.html","الرمل"],[196,"على ذي منار تعرف العين متنه","https://www.aldiwan.net/poem54375.html","الطويل"],[224,"على ذروة بين أطلال صور","https://www.aldiwan.net/poem39710.html","المتقارب"],[230,"تميط الأذى عن حامليها الصوارم","https://www.aldiwan.net/poem50832.html","الطويل"],[236,"رمتني الليالي من مصابك يا أخي","https://www.aldiwan.net/poem32106.html","الطويل"],[238,"أحاجيك عن تفاحة ذات بهجة","https://www.aldiwan.net/poem18127.html","الطويل"],[238,"ذوي ودي ويا من عنفوني","https://www.aldiwan.net/poem19282.html","الوافر"],[354,"صلوا حبل ودي يا كرام وزوروا","https://www.aldiwan.net/poem40349.html","الطويل"],[365,"إلى من يشار بهذا العذل","https://www.aldiwan.net/poem60798.html","المتقارب"],[367,"على ذكراه أيام الفنيق","https://www.aldiwan.net/poem17048.html","الوافر"],[372,"أدلة أهواء يضل اتباعها","https://www.aldiwan.net/poem57322.html","الطويل"],[404,"أجزتكما يا أهل ودي روايتي","https://www.aldiwan.net/poem33356.html","الطويل"],[417,"لفقدان عبد الواحد الدمع قد جرى","https://www.aldiwan.net/poem54022.html","الطويل"],[440,"وأهد بها في الفلا والسرى","https://www.aldiwan.net/poem34834.html","المتقارب"],[444,"سلام على شيخ المشايخ أحمد","https://www.aldiwan.net/poem56037.html","عموديه"],[459,"أبلاغور تشتاق تلك النجودا","https://www.aldiwan.net/poem56240.html","المتقارب"],[501,"ولما تلافينا التلال بلعلع","https://www.aldiwan.net/poem37977.html","الطويل"],[537,"أيا عين جودي ولا تسأمي","https://www.aldiwan.net/poem23868.html","المتقارب"],[559,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[563,"قفا بين الثنية والمصلى","https://www.aldiwan.net/poem52929.html","الوافر"],[563,"أسحرا كان شغلي في هواكا","https://www.aldiwan.net/poem52945.html","الوافر"]],"verses":[["عَلى ذاتِ لَوثٍ تَجعَلُ الوَضعَ مَشيَها","كَما انقَضَّ عَيرُ الصَخرَةِ المُتَرَقِّبُ",0,"ب",1,0],["عَلى ذاتِ لَوثٍ أَو بِأَهوَجَ وَشوَشٍ","صَنيعٍ نَبيلٍ يَملأُ الرحلَ كاهِلُه",1,"ل",2,0],["عَلَى ذِكْرَاهُ تَصْطَفِقُ القَوَافِي","كَمَا اصْطَفَقَتْ بُنُودُ المَهْرَجَانِ",2,"ن",1,0],["عَلى ذِروَةِ الصُلبِ الَّذي واجَهَ المِعا","سَواخِطَ مِن بَعدِ الرِضا لِلمَراتِعِ",3,"ع",1,0],["عَلى ذاتِ أَلواحٍ طِوالٍ وَكاهِلٍ","أَنافَت أَعاليهِ وَمارَت مَناكِبُه",4,"ب",2,0],["على ذلك إجرِيّايَ فيكُم ضَرِيبَتي","ولو جَمَعُوا طُرَّاً عليَّ واجلَبُوا",5,"ب",3,0],["على ذاهب قد كان للقصد ملجأً","وللظن مرتاداً وللعين منظرا",6,"ر",2,0],["على ذكرك العالي بنا كلّ معربٍ","ثناه فيا لله من معربٍ يبنى",7,"ن",2,0],["على ذاك أسَّسنا الخلالةَ بينناً","فهلْ مَنقم فيما اعتددْتُ لناقمِ",8,"م",1,0],["عَلى ذَلِكَ القَبرِ السَلامُ فَذِكرُهُ","أَريجٌ بِهِ نَفسي عَنِ العِطرِ تَستَغني",9,"ن",2,0],["عَلى ذَلِكَ الوَجهِ مِنّي السَلامُ","وَلا أَوحَشَ اللَهُ مِن مُؤنِسي",10,"س",2,0],["عَلى ذاكَ أَفديك مِن ماجِدٍ","تَشّبتثَ بِالظَرف فيهِ الهُدى",11,"د",2,0],["عَلى ذا مَضى الناسُ اِجتِماعٌ وَفُرقَةٌ","وَمَيتٌ وَمَولودٌ وَقالٍ وَوامِقُ",12,"ق",1,0],["على ذا مضَى حكمُ الزمإن لأهلهِ","فوادحُ مقرونٌ بهنَّ فوائدُ",13,"د",1,0],["عَلى ذي مَنارٍ تَعرِفُ العيسُ مَتنَهُ","كَما تَعرِفُ الأَضيافُ آلَ المُهَمَّلِ",14,"ل",1,0],["عَلى ذَوي الوِدِّ بِالحُسنى بِأَنفُسِهِم","وَما عَليهِم بِفِعلِ الغَيرِ مِن عارِ",15,"ر",1,0],["عَلى ذاكَ ما يَمحو لِيَ الذَنبَ عِندَها","وَتَمحو دَواعي حُبِّها ذَنبَها عِندي",16,"د",2,0],["على ذِكرِها فليعرفِ الحقَّ جاهلُهْ","ويُؤمنْ بأنّ البَغْيَ شتّى غوائلُهْ",17,"ل",2,1],["عَلى ذاكَ حَتّى رَدَّني عَن جَهالَةٍ","وَما الناسُ إِلّا طالِبُ اللَهوِ أَو صاحِ",18,"ح",1,0],["على ذا مننت ، وهذا خذلت","وذلك أعنت وذا لم تعن",19,"ن",1,0],["عَلى ذاكَ أَفديك مِن ماجِدٍ","تَشبّثَ بِالظَّرف فيهِ الهُدى",20,"د",2,0],["عَلى ذات القُرُنفل قَد حَطَطنا","وَكانَ بِطِيبِها طيب الحَياةِ",21,"ه",1,1],["عَلى ذاكَ الضَريح وَما يَليهِ","تَحيات مِن الرَب السَلام",22,"م",1,0],["عَلى ذاكَ مِنّي شاهِدٌ غَيرُ غائِبٍ","يُبَيِّنُ لِلأَقوامِ صِدقَ مَقالي",23,"ل",2,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","بَرا نورَهُ الخلّاق قبل العوالمِ",24,"م",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","أَبو الناسِ طرّاً أعرفُ الناسِ أرفعُ",24,"ع",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","محمّدٌ المختارُ من آل هاشم",24,"م",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","تَناقلهُ الأخيارُ من عهد آدم",24,"م",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","وَكَم مُعجزاتٍ أعجزَ الخلقَ دحضُها",24,"ه",2,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","وَمِن أَين جاءَتهم طيورٌ أبابيل",24,"ل",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","أَضاءَت قصورُ الشامِ مِن ضوء نورهِ",24,"ه",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","وَإِيوانُ كِسرى قَد هوت شرفاتهُ",24,"ه",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","حَليمةُ سَعدٍ ضاعفَ اللَّه برّها",24,"ه",2,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","وَما شاركَ الأقوامَ حيناً بأمرِهم",24,"م",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","تخيّرُه الرحمنُ مِن كلّ ناطق",24,"ق",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","أَتى وَظلامُ الشركِ في الناسِ حالك",24,"ك",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","فَلا عزَّ للعُزّى ولا لِمناتِهم",24,"م",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","عليهِ على حكمِ الضلالِ تعصّبوا",24,"ب",3,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","وَأَولاهُ مَولاهُ كرامَ أصاحب",24,"ب",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","بِهِم أيّدَ الجبّارُ في الأرض دينهُ",24,"ه",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","لَقَد هجَروا مِن أجلهِ الدارَ والأهلا",24,"ل",2,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","وَلا تَنسَ صَحباً مِن هُنا وهنالكا",24,"ك",2,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","لَقَد جاهَدوا في اللَّه حقّ جهادهِ",24,"ه",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","وَيا حبّذا الأطهارَ آل محمّد",24,"د",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","وَطهّرهم مِن كلّ رجسٍ مطهّرُ",24,"ر",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","مَواليه كلٌّ منهمُ سادَ قومهُ",24,"ه",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","صِفاتكَ يا خيرَ الخلائق تعظمُ",24,"م",1,0],["عَلى ذي مَنارٍ تَعرِفُ العَينُ مَتنَهُ","كَما تَرِفُ الأَضيافُ دارُ المُقَطَّعِ",25,"ع",1,1],["عَلى ذَروَةٍ بَينَ أَطلالِ صُور","يُحيطُ بِها شَجَرٌ وَصُخور",26,"ر",1,1],["على ذا مضى آباؤك الغُرُّ يَرْتَضي","فِعَالَهُمُ بَذْلُ النَّدَى والمَلاحِم",27,"م",1,0],["عَلى ذي يَدٍ كَالغَيثِ في المَحلِ ثَرَّةٍ","وَوَجهٍ كَضَوءِ الصُبحِ أَبلَحَ أَبلَخِ",28,"خ",1,0],["علَى ذَاكَ لاَ تُلْفِي لَهَا الدهْرَ عائِباُ","وَلَيْسَ لَهَا فِي رُؤْيَةِ الْعَيْنِ مَِقْدَحُ",29,"ح",1,0],["عَلَى ذِي الْحِلْمِ وَالْعِلْمِ الْمَتِينِ","عَلَى ذِي الذِّكْرِ وَالسِّرِّ الْمَصُونِ",30,"ن",1,0],["عَلَى ذِي الْبِشْرِ بَرَّاقِ الثَّنَايَا","عَلَى ذِي النُّورِ وَضَّاحِ الْجَبِينِ",30,"ن",1,0],["عَلى ذَلِكَ النادي تَحيّة مُغرم","لَهُ الصَبر يَحلو وَالبعاد مَريرُ",31,"ر",1,0],["على ذلك العَيْشِ منّي السَّلامُ","فما كان إلاّ خِضاباً نَصل",32,"ل",1,0],["عَلى ذِكراهُ أَيّامَ الفَنيقِ","جَرى مِن عَينِهِ عَينُ العَقيقِ",33,"ق",1,1],["على ذِروَةٍ للحادِثاتِ منيفةٍ","فمِن عِندِه إشرافُها واطِّلاعُها",34,"ع",3,0],["على ذلك الشرط الذي بين أهله","وفي شرحنا التوضيح تنقيح ما فيه",35,"ي",2,0],["على ذاهبٍ منَّا يرغم أُنوفِنا","نُعالِجُ حُزْناً أو نموت فنُعذرا",36,"ر",2,0],["عَلَى ذُلُلٍ من مطايا الشؤونِ","قَطَعْنَ إِلَيْكَ عِقالَ الثَّواءِ",37,"ا",2,0],["على ذلك الوجه المغسل بالحبا","وحامض فحم يزدري ابيض القند",38,"د",1,0],["على ذاك ما قصُرتْ دولة","فطاولْ زمانَك بيضاً وسُودا",39,"د",2,0],["على ذُروَةٍ من أرضِهِمْ وقْفُ مُهْجَتي","صَحيحٌ ومنِّي يا سَماءُ ألا اقْلِعي",40,"ع",2,0],["عَلى ذي الفَواضِلِ وَالمَكرُماتِ","وَمَحضِ الضَريبَةِ وَالمَحتِدِ",41,"د",1,0],["على ذاك الربيع الطّل","قِ إذ تلك النواحي عَمّْ",42,"م",1,0],["على ذاكَ الكَثيبِ لنا سَلامٌ","يُكاثِرُ في الكَثيِبِ الفَرْدِ رَمْلا",43,"ل",2,0],["على ذُرِّيَّةِ الرَجُلينِ وَقفٌ","وليسَ بهِ التَّصَرُّفُ من قَضاكا",44,"ك",2,0]]}