sgate.com/ViewPoem.aspx?id=151604",""],[5183,"مصاب الدين","https://www.poetsgate.com/ViewPoem.aspx?id=180258",""],[5194,"شدْ سناره","https://www.poetsgate.com/ViewPoem.aspx?id=34587",""],[5363,"مفخرة الإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=144431",""],[5411,"ما زِلْتُ أُحِبّكَ","https://www.poetsgate.com/ViewPoem.aspx?id=189583",""],[5411,"عَلَى ذِمَّةِ التَّحْقيقِ","https://www.poetsgate.com/ViewPoem.aspx?id=204686",""],[5431,"من هلوسات الحمى (3)-وشعبي سيغلبُ","https://www.poetsgate.com/ViewPoem.aspx?id=198325",""],[5626,"أنّاتُ عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=189718",""],[5652,"عمرو بن العاص رضي الله عنه","https://www.poetsgate.com/ViewPoem.aspx?id=208678",""],[5741,"على ذم القطيفة اجتمعنا","https://www.poetsgate.com/ViewPoem.aspx?id=187493",""],[5747,"لوعة التذكار","https://www.poetsgate.com/ViewPoem.aspx?id=61615",""],[5747,"جرح الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=61619",""],[5756,"غرام احباب","https://www.poetsgate.com/ViewPoem.aspx?id=5423",""],[6102,"فرات وذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=184550",""],[199,"عَلَى ذِي مَنَارٍ، تَعْرِفُ العَيْنُ مَتْنَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=22421",""],[6181,"قصيدة البيان الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87685&r=&rc=0",""]],"verses":[["عَلى ذاتِ لَوثٍ تَجعَلُ الوَضعَ مَشيَها","كَما انقَضَّ عَيرُ الصَخرَةِ المُتَرَقِّبُ",0,"ب",1,0],["عَلى ذاتِ لَوثٍ أَو بِأَهوَجَ وَشوَشٍ","صَنيعٍ نَبيلٍ يَملأُ الرحلَ كاهِلُه",1,"ل",2,0],["عَلَى ذِكْرَاهُ تَصْطَفِقُ القَوَافِي","كَمَا اصْطَفَقَتْ بُنُودُ المَهْرَجَانِ",2,"ن",1,0],["عَلى ذِروَةِ الصُلبِ الَّذي واجَهَ المِعا","سَواخِطَ مِن بَعدِ الرِضا لِلمَراتِعِ",3,"ع",1,0],["عَلى ذاتِ أَلواحٍ طِوالٍ وَكاهِلٍ","أَنافَت أَعاليهِ وَمارَت مَناكِبُه",4,"ب",2,0],["على ذلك إجرِيّايَ فيكُم ضَرِيبَتي","ولو جَمَعُوا طُرَّاً عليَّ واجلَبُوا",5,"ب",3,0],["على ذاهب قد كان للقصد ملجأً","وللظن مرتاداً وللعين منظرا",6,"ر",2,0],["على ذكرك العالي بنا كلّ معربٍ","ثناه فيا لله من معربٍ يبنى",7,"ن",2,0],["على ذاك أسَّسنا الخلالةَ بينناً","فهلْ مَنقم فيما اعتددْتُ لناقمِ",8,"م",1,0],["عَلى ذَلِكَ القَبرِ السَلامُ فَذِكرُهُ","أَريجٌ بِهِ نَفسي عَنِ العِطرِ تَستَغني",9,"ن",2,0],["عَلى ذَلِكَ الوَجهِ مِنّي السَلامُ","وَلا أَوحَشَ اللَهُ مِن مُؤنِسي",10,"س",2,0],["عَلى ذاكَ أَفديك مِن ماجِدٍ","تَشّبتثَ بِالظَرف فيهِ الهُدى",11,"د",2,0],["عَلى ذا مَضى الناسُ اِجتِماعٌ وَفُرقَةٌ","وَمَيتٌ وَمَولودٌ وَقالٍ وَوامِقُ",12,"ق",1,0],["على ذا مضَى حكمُ الزمإن لأهلهِ","فوادحُ مقرونٌ بهنَّ فوائدُ",13,"د",1,0],["عَلى ذي مَنارٍ تَعرِفُ العيسُ مَتنَهُ","كَما تَعرِفُ الأَضيافُ آلَ المُهَمَّلِ",14,"ل",1,0],["عَلى ذَوي الوِدِّ بِالحُسنى بِأَنفُسِهِم","وَما عَليهِم بِفِعلِ الغَيرِ مِن عارِ",15,"ر",1,0],["عَلى ذاكَ ما يَمحو لِيَ الذَنبَ عِندَها","وَتَمحو دَواعي حُبِّها ذَنبَها عِندي",16,"د",2,0],["على ذِكرِها فليعرفِ الحقَّ جاهلُهْ","ويُؤمنْ بأنّ البَغْيَ شتّى غوائلُهْ",17,"ل",2,1],["عَلى ذاكَ حَتّى رَدَّني عَن جَهالَةٍ","وَما الناسُ إِلّا طالِبُ اللَهوِ أَو صاحِ",18,"ح",1,0],["عَلَى ذاتِ إِسَآدٍ كأَنَّ ضُلُوعَهَا","وأَلْوَاحَهَا العُلْيَا السَّقِيفُ المُشَبَّحُ",19,"ح",1,0],["على ذا مننت ، وهذا خذلت","وذلك أعنت وذا لم تعن",20,"ن",1,0],["عَلى ذاكَ أَفديك مِن ماجِدٍ","تَشبّثَ بِالظَّرف فيهِ الهُدى",21,"د",2,0],["عَلى ذات القُرُنفل قَد حَطَطنا","وَكانَ بِطِيبِها طيب الحَياةِ",22,"ه",1,1],["عَلى ذاكَ الضَريح وَما يَليهِ","تَحيات مِن الرَب السَلام",23,"م",1,0],["عَلى ذاكَ مِنّي شاهِدٌ غَيرُ غائِبٍ","يُبَيِّنُ لِلأَقوامِ صِدقَ مَقالي",24,"ل",2,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","بَرا نورَهُ الخلّاق قبل العوالمِ",25,"م",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","أَبو الناسِ طرّاً أعرفُ الناسِ أرفعُ",25,"ع",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","محمّدٌ المختارُ من آل هاشم",25,"م",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","تَناقلهُ الأخيارُ من عهد آدم",25,"م",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","وَكَم مُعجزاتٍ أعجزَ الخلقَ دحضُها",25,"ه",2,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","وَمِن أَين جاءَتهم طيورٌ أبابيل",25,"ل",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","أَضاءَت قصورُ الشامِ مِن ضوء نورهِ",25,"ه",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","وَإِيوانُ كِسرى قَد هوت شرفاتهُ",25,"ه",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","حَليمةُ سَعدٍ ضاعفَ اللَّه برّها",25,"ه",2,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","وَما شاركَ الأقوامَ حيناً بأمرِهم",25,"م",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","تخيّرُه الرحمنُ مِن كلّ ناطق",25,"ق",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","أَتى وَظلامُ الشركِ في الناسِ حالك",25,"ك",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","فَلا عزَّ للعُزّى ولا لِمناتِهم",25,"م",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","عليهِ على حكمِ الضلالِ تعصّبوا",25,"ب",3,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","وَأَولاهُ مَولاهُ كرامَ أصاحب",25,"ب",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","بِهِم أيّدَ الجبّارُ في الأرض دينهُ",25,"ه",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","لَقَد هجَروا مِن أجلهِ الدارَ والأهلا",25,"ل",2,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","وَلا تَنسَ صَحباً مِن هُنا وهنالكا",25,"ك",2,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","لَقَد جاهَدوا في اللَّه حقّ جهادهِ",25,"ه",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","وَيا حبّذا الأطهارَ آل محمّد",25,"د",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","وَطهّرهم مِن كلّ رجسٍ مطهّرُ",25,"ر",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","مَواليه كلٌّ منهمُ سادَ قومهُ",25,"ه",1,0],["عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما","صِفاتكَ يا خيرَ الخلائق تعظمُ",25,"م",1,0],["عَلى ذي مَنارٍ تَعرِفُ العَينُ مَتنَهُ","كَما تَرِفُ الأَضيافُ دارُ المُقَطَّعِ",26,"ع",1,1],["عَلى ذَروَةٍ بَينَ أَطلالِ صُور","يُحيطُ بِها شَجَرٌ وَصُخور",27,"ر",1,1],["على ذا مضى آباؤك الغُرُّ يَرْتَضي","فِعَالَهُمُ بَذْلُ النَّدَى والمَلاحِم",28,"م",1,0],["عَلى ذي يَدٍ كَالغَيثِ في المَحلِ ثَرَّةٍ","وَوَجهٍ كَضَوءِ الصُبحِ أَبلَحَ أَبلَخِ",29,"خ",1,0],["علَى ذَاكَ لاَ تُلْفِي لَهَا الدهْرَ عائِباُ","وَلَيْسَ لَهَا فِي رُؤْيَةِ الْعَيْنِ مَِقْدَحُ",30,"ح",1,0],["عَلَى ذِي الْحِلْمِ وَالْعِلْمِ الْمَتِينِ","عَلَى ذِي الذِّكْرِ وَالسِّرِّ الْمَصُونِ",31,"ن",1,0],["عَلَى ذِي الْبِشْرِ بَرَّاقِ الثَّنَايَا","عَلَى ذِي النُّورِ وَضَّاحِ الْجَبِينِ",31,"ن",1,0],["عَلى ذَلِكَ النادي تَحيّة مُغرم","لَهُ الصَبر يَحلو وَالبعاد مَريرُ",32,"ر",1,0],["على ذلك العَيْشِ منّي السَّلامُ","فما كان إلاّ خِضاباً نَصل",33,"ل",1,0],["عَلى ذِكراهُ أَيّامَ الفَنيقِ","جَرى مِن عَينِهِ عَينُ العَقيقِ",34,"ق",1,1],["على ذِروَةٍ للحادِثاتِ منيفةٍ","فمِن عِندِه إشرافُها واطِّلاعُها",35,"ع",3,0],["على ذلك الشرط الذي بين أهله","وفي شرحنا التوضيح تنقيح ما فيه",36,"ي",2,0],["على ذاهبٍ منَّا يرغم أُنوفِنا","نُعالِجُ حُزْناً أو نموت فنُعذرا",37,"ر",2,0],["عَلَى ذُلُلٍ من مطايا الشؤونِ","قَطَعْنَ إِلَيْكَ عِقالَ الثَّواءِ",38,"ا",2,0],["على ذلك الوجه المغسل بالحبا","وحامض فحم يزدري ابيض القند",39,"د",1,0],["على ذاك ما قصُرتْ دولة","فطاولْ زمانَك بيضاً وسُودا",40,"د",2,0],["على ذُروَةٍ من أرضِهِمْ وقْفُ مُهْجَتي","صَحيحٌ ومنِّي يا سَماءُ ألا اقْلِعي",41,"ع",2,0],["عَلى ذي الفَواضِلِ وَالمَكرُماتِ","وَمَحضِ الضَريبَةِ وَالمَحتِدِ",42,"د",1,0],["على ذاك الربيع الطّل","قِ إذ تلك النواحي عَمّْ",43,"م",1,0],["على ذاكَ الكَثيبِ لنا سَلامٌ","يُكاثِرُ في الكَثيِبِ الفَرْدِ رَمْلا",44,"ل",2,0],["على ذُرِّيَّةِ الرَجُلينِ وَقفٌ","وليسَ بهِ التَّصَرُّفُ من قَضاكا",45,"ك",2,0],["على ذلك الوجه الوسيم الذي عدا","عليهِ البِلَى يمحو محاسنَهُ مَحوا",46,"و",2,0],["على ذي الإبل خيّم مستديراً","وخيّمَ في جوانبه ورادا",47,"د",2,0],["على ذا تاجُ وردٍ و","على ذا تاجُ نسرين",48,"ن",1,0],["عَليُّ ذاتٍ وَقَدرٍ في ذُرى شَرفٍ","وَاِسمٍ وَصيتٍ حَميدٍ طَيِّبٍ وَسَني",49,"ن",2,0],["عَلى ذَوي الطّغيانِ","أَنزِلْ بِهِم هَولاً غَريب",50,"ب",1,0],["عَلى ذَقنِكَ الشّيب اِغتَدى الآنَ ضاحِكاً","وَكانَ عَلى ذَقني شبابكَ يَضحكُ",51,"ك",1,0],["على ذوي الحب آيات مترجمة","تبين من أجله عن كل مشتبه",52,"ه",1,1],["عَلى ذلِكَ الْوَادِي وَأحْرَزْتَ نَظْرَةً","فَبَلَّغْ سَلاَمِي لِلَّذِي حَلَّ حُجْرَةً",53,"ه",1,0],["على ذا مَضَى طِيبُ الشباب ويومه","وقد نزل الشيب الذي هو نازل",54,"ل",1,0],["عَلي ذُنوب وَتَصحيفها","وَعِندكُم الجود وَالمَغفِرَه",55,"ر",2,0],["عَلى ذُرىً شامِخٍ وعرٍ قَد امْتَلأَتْ","كِبْراً بِهِ وهو مَمْلوءٌ بِها تِيها",56,"ه",2,0],["على ذي الهِمَّة العَلياء والمِنَّ","ةِ البيضاءِ والوجهِ الصَّبيح",57,"ح",1,0],["عَليَّ ذَنباً كُلُّهُ لَم أَصنَعِ","مِن أَن رَأَت رَأسي كَرَأسِ الأَصلَعِ",58,"ع",1,0],["على ذاتك صلى الل","ه في التنزيل تنزيها",59,"ي",3,0],["عَلى ذاكَ السَلامُ غَداةَ وَلّى","وَدامَ لِذا السَلامَةُ وَالسَلامُ",60,"م",1,0],["عَلى ذرا سينا","صاروا مجانينا",61,"ن",2,0],["على ذكر الغواني قبيل ذكر","لميّة كنت منقسم الجنان",62,"ن",1,0],["علَى ذَاتِ مَحبُوبٍ لِكُلِّ صِفاتِكُم","مَعَ الآلِ وَالأَصحابِ أَرجُو هِباتِكُم",63,"م",1,0],["عَلى ذا مَضى عُمري كَذاكَ وَعُمرهُ","صَفِيَّينِ لا نَجفو وَلا نَتَعَتَّبُ",64,"ب",1,0],["على ذلك المحبوب منى تحية","تليق به مصحوبة بسلامي",65,"م",2,0],["عَلى ذِكرِها دارَت حُمَيّا مَدامِعي","وَحَنَّ مِنَ الأَشواقِ عودُ الأَضالِعِ",66,"ع",1,1],["على ذلك المغنى المنير وأهله","سلام محب نازح هالك جهدا",67,"د",2,0],["على ذلك القلب الذي أضمر الأسى","إلى ذلك الوجد الذي حجب المدى",68,"د",2,0],["على ذروة للعلم والمال شيدا","لبيتهما المعمور ارسخ بنيان",69,"ن",1,0],["على ذَلِكَ الترتيبِ خُذهُنَّ جُملَةً","إذا فَاتَ عَجزٌ أو صُدُورُ المَراكِبِ",70,"ب",1,0],["على ذلكَ الشامِي هُنَاكَ مُحَقَّقٌ","ثمانٍ ونصفٌ في الجُدَيِّ بِتِسعَةِ",71,"ه",1,0],["على ذا قضى الدهرُ بالخؤون بأهلهِ","فما شرعهُ غير الجِفا والتباعدِ",72,"د",1,0],["على ذكاء توارت شمس مشرقه","صبحاً وخلفت الأبصار للرمد",73,"د",1,0],["علي ذات معاليه به افتخرت","وقد حوى رقة كشافة الحزن",74,"ن",1,0],["على ذاك يمضي اللندنيُّ محدّثًا","فيصغي إليه القاهري مواليا",75,"ي",2,0],["علي ذو العلوم والشجاعه","والزهد في الدنيا وذو البراعه",76,"ه",1,0],["على ذا مضى الهادي النبي وصحبه","وأتباعهم خير القرون وأفضل",77,"ل",1,0],["على ذا ما مضى وعليه يمضي","صوالُ مني وآجال قصار",78,"ر",1,0],["عَلى ذي مَيعةٍ عَبلٍ جوادٍ","صَريحيّ الأرومة والنّصِاب",79,"ب",1,0],["على ذروة العرشِ المجيدِ محمَّدٌ","علا رائياً للربِّ حقاً وسامعه",80,"ع",2,0],["عَلَى ذَاكَ الجَنَابِ تَحِيَّةٌ مِن","مُحِبٍّ دَائِماً أبَدَا مُسَرمَد",81,"د",1,0],["عَلى ذكرِ اسمهِ المَموقِ جِئنا","بِصافي الكَأس نَرتشفُ الرَحيقا",82,"ق",2,0],["على ذكر مولى لو تحلت ببعض ما","به الشمس لم تطلع علينا من الع