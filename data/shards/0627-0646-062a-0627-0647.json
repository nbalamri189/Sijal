{"poems":[[88,"طمع ألقى عن الغرب اللثاما","https://www.aldiwan.net/poem10683.html","الرمل"],[89,"ديني الحنيف وربي الله","https://www.aldiwan.net/poem8200.html","أحذ الكامل"],[33,"أصبح القلب في الحبال رهينا","https://www.aldiwan.net/poem41280.html","الخفيف"],[33,"أرسلت تعتب الرباب وقالت","https://www.aldiwan.net/poem42583.html","الخفيف"],[108,"من وحي البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179317",""],[119,"يا رسول الله دارك كرما","https://www.aldiwan.net/poem42174.html","الرمل"],[234,"أنت أهدى إلى المكارم والفضل","https://www.aldiwan.net/poem51078.html","الطويل"],[285,"أنت للمسلمين حصن وحرز","https://www.aldiwan.net/poem60691.html","الخفيف"],[369,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[409,"أيها العاتب رفقا","https://www.aldiwan.net/poem33615.html","مجزوء الرمل"],[438,"نزلوا فادعوا نزال نزال","https://www.aldiwan.net/poem12343.html","الخفيف"],[505,"أنت أهل المعروف يا معروف","https://www.aldiwan.net/poem37952.html","الخفيف"],[567,"طال شوقي لطول هذا البعاد","https://www.aldiwan.net/poem52967.html","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138370",""],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117399","البسيط"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82314","السريع"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80023","الخفيف"],[1577,"","https://poetry.dctabudhabi.ae/diwan/poem/28432","الكامل"],[3768,"","https://poetry.dctabudhabi.ae/diwan/poem/130434","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103001","الخفيف"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101389","الكامل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81944","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33315","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120506","الخفيف"],[4727,"من ديارِ بالقليبِ جديبِ","https://www.poetsgate.com/ViewPoem.aspx?id=208015",""],[5049,"المسكنة الله","https://www.poetsgate.com/ViewPoem.aspx?id=186335",""],[5232,"إلى شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=213608",""],[5281,"درب الاقدار","https://www.poetsgate.com/ViewPoem.aspx?id=199271",""],[5293,"المتكبرة","https://www.poetsgate.com/ViewPoem.aspx?id=186134",""],[5370,"حروف ومعاني","https://www.poetsgate.com/ViewPoem.aspx?id=86514",""],[5376,"قمْ للصلاةِ وصلِّ الفجرَ منفردا","https://www.poetsgate.com/ViewPoem.aspx?id=206384",""],[6056,"الوجيه المكفهرّه","https://www.poetsgate.com/ViewPoem.aspx?id=156694",""],[6213,"شق النفس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76280&r=&rc=37",""]],"verses":[["أَنتَ أَهدَيتَ إِلَينا عُدَّةً","وَلِباساً وَشَراباً وَطَعاما",0,"م",2,0],["إِنْ تَاهَ غَيْرِي بِالزَّمَانِ فَلِي","قَلْبٌ بِذِكْرِ اللَّهِ تَيَّاهُ",1,"ا",2,0],["أَنتِ أَهوى العِبادِ قُرباً وَبُعداً","لَو تُنيلينَ عاشِقاً مَحزونا",2,"ن",2,0],["أَنتِ أَهوى إِلَيَّ مِن سَإِرِ النا","سِ ذَريني مِن كَثرَةِ التَعدادِ",3,"د",1,0],["إن تاه في مُفْترَق الشِّعَاب","يا خامس الأَربعة الأَقطاب",4,"ب",1,0],["أنت أهل للمعالي كلها","وأنا مضني على الباب ارتمى",5,"م",2,0],["أنت أهدَى إلى المكارم والفض","لِ وأندَى من الغمام المَطِيرِ",6,"ر",1,1],["أَنْتَ أَهْضْتَنِي وَقَدْ خَرِقَ الْخَطْ","بُ فَلَمْ يُغْنِ فِيهِ رَكْلٌ وَهَمْزُ",7,"ز",1,0],["أنت أهدَيتَها بزُهْرِ مَعالي","كَ فأبدَتْ أمثالَها للرّائي",8,"ا",2,0],["أنت أهملت كتابي","وهو قد وافاك رقا",9,"ق",2,0],["أَنتَ أَهلٌ لأَنْ تَجُودَ بمُلْكٍ","فقليلٌ بأَن تجودَ بمالِ",10,"ل",1,0],["أنتَ أهلُ المَعْروفِ يا مَعْروفُ","وأبو الفَتْكِ يومَ تَزْهو الصُّفوفُ",11,"ف",1,1],["أنت أهلُ القريضِ تُنشَدُ منهُ","كلَّ بيتٍ يَهِمُّ بالإنشادِ",12,"د",1,0],["ان تاه مني اللب لا عجب فكم","هذا المحيط أتاه فيهِ عقولا",13,"ل",2,0],["إن تاه ثغرُ الأقاحي في تشبهه","بثغر حبكَ واستولى به الطربُ",14,"ب",1,1],["إِن تاهَ بَشّارٌ عَلَيكُم فَقَد","أَمكَنتُ بَشّاراً مِنَ التّيهِ",15,"ي",2,1],["أنت أهلٌ وقد علمت بأن لي","سَ يُضيع الباري لمثلك أهلا",16,"ل",2,0],["أَن تاهَ أَحوَرُ ذو رَعَي","نَ لَنا وَأَحوى ذو أَباعِر",17,"ر",1,0],["إن تاه في معوج صدغيك فقد","هداه من فرقك مستقيمه",18,"م",2,0],["أنت أهل لحسنها علم الل","ه كما أنها لحسنك أهل",19,"ل",1,0],["ان تاه في كبر الملوك فانه","سلطان مملكة الحسان الغيد",20,"د",1,0],["أنت أهل لقدرة اللّه روح","القدس لمَّا أتت تؤيد عيسى",21,"س",2,0],["أنتَ أهلكتني وكن","تَ غَنياً عن النظَّر",22,"ر",1,0],["انت اهل لان ترجى وتخشى","وتعز الذليل ان سيم رقا",23,"ق",2,0],["أنْتَ أهلٌ لأنْ تَجُورَ وتَطغَى","فذُنوبُ الحبيبِ غيرُ الذُّنُوبِ",24,"ب",1,0],["أنت أهل الجميل ربي فعد لي","بجميل عودتنيه جنينا",25,"ن",2,0],["أنتِ آهٌ في زماني وأنا","من جنونِ الألمِ المكبوتِ آهْ",26,"ا",2,0],["إِنْ تَاهَتْ العَيْنْ نَبْضَ القَلْبْ مَا يِخْدَعْ","وَالقَلْبْ فِي العُمْر مَا يِعْشَقْ سِوَى وَاحِدْ",27,"د",1,0],["إِنْ تَاهَ تهِنَا وَ إِنْ أَبْدَى تَوَاضُعَهُ","أَعْطَيْنَا مِنْ كَنْزِنَا مَا سَوْفَ يُغْنِيهِ",28,"ي",2,0],["إنت أهلك يا صاحبي صاد والعين","وانا اهلي صادٍ وعينٍ على صاد",29,"د",1,1],["إن تاهتِ النفسُ يوماً عند حاجتِها","فالقلبُ غيرَك يا ألله ما عبدا",30,"د",2,0],["أنت أهل المغفرة والجود والتقوى ببرّه","وأنت أهل المرحمة، وأهل اليدين المعطية",31,"ي",2,0],["إن تاهت الروح في درب بلا سند","فالوقت يطوي بلا جسر ولا عمد",32,"د",1,0]]}