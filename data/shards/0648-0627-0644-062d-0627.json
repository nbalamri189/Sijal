ViewPoem.aspx?id=180190",""],[5183,"ركب الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=180181",""],[5185,"الوحدة","https://www.poetsgate.com/ViewPoem.aspx?id=70900",""],[5281,"يارب يسر لنا كل الأمور","https://www.poetsgate.com/ViewPoem.aspx?id=199604",""],[5283,"ركض على طريق الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=208967",""],[5320,"البسمة الصفراء","https://www.poetsgate.com/ViewPoem.aspx?id=43257",""],[5320,"العالم يغنى","https://www.poetsgate.com/ViewPoem.aspx?id=41632",""],[5409,"طواك الموت قيثاراً بديعا","https://www.poetsgate.com/ViewPoem.aspx?id=155460",""],[5420,"عجزت عَن قصَّة الطَّبِيب وَعَن","https://www.poetsgate.com/ViewPoem.aspx?id=190370",""],[5431,"من ذا يُجففُ أنهره","https://www.poetsgate.com/ViewPoem.aspx?id=199762",""],[5437,"إنتفاضة قلب","https://www.poetsgate.com/ViewPoem.aspx?id=143707",""],[5488,"عزوة الصحابة","https://www.poetsgate.com/ViewPoem.aspx?id=100733",""],[470,"هذي ذُرى مصر","https://www.poetsgate.com/ViewPoem.aspx?id=63614",""],[5573,"ياذيب ياذيب يالي تكتب وتقرا","https://www.poetsgate.com/ViewPoem.aspx?id=202126",""],[5596,"القمر والأهلة","https://www.poetsgate.com/ViewPoem.aspx?id=205610",""],[5596,"مكة الغيث","https://www.poetsgate.com/ViewPoem.aspx?id=206191",""],[5596,"تحية الى العيينة واهلها","https://www.poetsgate.com/ViewPoem.aspx?id=206718",""],[5618,"في جبة التأويل ..عراق الصمود","https://www.poetsgate.com/ViewPoem.aspx?id=208921",""],[5751,"لغتي تتهجّى الفرح","https://www.poetsgate.com/ViewPoem.aspx?id=214711",""],[5758,"إلى حاكم","https://www.poetsgate.com/ViewPoem.aspx?id=207928",""],[5843,"موت طازج","https://www.poetsgate.com/ViewPoem.aspx?id=51285",""],[5940,"أنشأت نظمًا زاهرًا قد طابا","https://www.poetsgate.com/ViewPoem.aspx?id=124948",""],[5943,"يابنتَ خيرِ النَّاسِ","https://www.poetsgate.com/ViewPoem.aspx?id=11256",""],[2765,"برح الخفا ما الحق فيه خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=136825",""],[5953,"عاذلتي في الشيب لو تعلم ما","https://www.poetsgate.com/ViewPoem.aspx?id=93807",""],[5953,"الله أكبر قددنا الفتح","https://www.poetsgate.com/ViewPoem.aspx?id=93791",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[4442,"نظرت فخانني حدسي وفكري","https://www.poetsgate.com/ViewPoem.aspx?id=171205",""],[179,"أعلنْتَ في حُبِّ جُملٍ أيَّ إعلانِ","https://www.poetsgate.com/ViewPoem.aspx?id=4725",""],[6093,"يوماً وقفتُ بسَفْحِ الرِّيمِ مُخْتار (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=175996",""],[6100,"العام في شوفي تزف التباشير","https://www.poetsgate.com/ViewPoem.aspx?id=52552",""],[6127,"الأملُ الموعود","https://www.poetsgate.com/ViewPoem.aspx?id=198207",""],[6142,"بنت النبوة أخت الذكر أم هدا","https://www.poetsgate.com/ViewPoem.aspx?id=155741",""],[520,"دانت لأمرك طاعة الأقدار","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577511",""],[243,"صحيفة الأحرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68182&r=&rc=174",""],[6229,"الغصن الذاوي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65173&r=&rc=5",""]],"verses":[["وَالحازِمُ الرَأيِ الَّذي يَغتَدي","مُستَقلِعاً يُنذِرُ مُستَوطِنا",0,"ن",2,0],["وَالحامِلُ العِبءَ رَمى","أَقَلَّ مِنهُ الحامِلُ",1,"ل",1,0],["وَالحامِلِ الأَقلامَ مَشروعَةً","كَأَنَّها بَعضُ القَنا الشُرَّعِ",2,"ع",1,0],["وَالحالُ أَوسَعُ وَالعَوالي جَمَّةٌ","وَالمَجدُ أَشمَخُ وَالصَريمَةُ أَصرَمُ",3,"م",1,0],["وَالحازِمَ الباني العُلى","في الشاهِقاتِ مِنَ الدَعائِم",4,"م",1,0],["وَالحارِثُ الخَيرُ قَد أَورى فَما خَمِدَت","نيرانُ مَجدٍ بِزَندٍ غَيرِ مَصلادِ",5,"د",1,0],["وَالحارِثُ الحَرّابُ خَلّى عاقِلاً","داراً أَقامَ بِها وَلَم يَتَنَقَّلِ",6,"ل",1,0],["وَالحارِثانِ كِلاهُما وَمُحَرِّقٌ","وَالتُبَّعانِ وَفارِسُ اليَحمومِ",7,"م",1,0],["والحَاشِرُ الآخِرُ المُصَدِّقُ لل","أولِ فِيمَا تَنَاسُخُ الكُتُبِ",8,"ب",1,0],["والحافظين الشرع إما فارس","أو جالس للحكم بين أناس",9,"س",1,0],["والحاصدين عداته بقواضبٍ","صارت لطولِ ضرابها كمناجل",10,"ل",1,0],["وَالحالُ يَرمُقُني طَوراً وَأَرمُقُهُ","إِن شا فَيُغشى عَلى الإِخوانِ مِن قُلَلِه",11,"ل",2,0],["والحالُ من سعدٍ يساعدنا","طوراً ونحْسٍ مُعْقَبٍ نكدُهْ",12,"د",2,0],["وَالحارِثَ بنَ أَبي عَوفٍ لَعِبنَ بِهِ","حَتّى تَعاوَرَهُ العِقبانُ وَالسُبَرُ",13,"ر",1,0],["والحادثات حربنني وجرحنني","فبقيت منبوذا بلا إسعاف",14,"ف",1,0],["والحاملين على الرقاب جلالها","والمنزلين إلى التراب سناءها",15,"ا",3,0],["وَالحامِلينَ إِذا دُعوا لِيُعَلِّموا","عِبءَ الأَمانَةِ فادِحاً مَسؤولا",16,"ل",2,0],["وَأُلحاظُ وَطفاوَينِ إِن رُمتُ نِيَّةً","أَجَدَّ فُتوراً في عِظامي فُتورُها",17,"ر",3,0],["وَأَلحاظُ عَينٍ ما عَلِقنَ بِفارِغٍ","فَخَلَّينَهُ حَتّى يَكونَ لَهُ شُغلُ",18,"ل",1,0],["وَالحابِسينَ إِلى العَشِيِّ لِيَأخُذوا","نُزُحَ الرَكِيِّ وَدِمنَةَ الأَسآرِ",19,"ر",1,0],["وَالحارِثِيُّ أَخو الحِماسِ وَرِثتُهُ","صَدعاً كَما صَدَعَ الصَفاةَ المِعوَلُ",20,"ل",1,0],["وَالحادِثاتُ بِها الأَقدارُ جارِيَةٌ","وَالمَرءُ مُرتَفِعٌ فيها وَمُنخَفِضُ",21,"ض",1,0],["وَالحادِثاتُ عَدُوُّ الأَكرَمينَ فَما","تَعتامُ إِلّا اِمرَاً يَشفى مِنَ القَرَمِ",22,"م",1,0],["وَالحادِثاتُ وَإِن أَصابَكَ بوسُها","فَهوَ الَّذي أَنباكَ كَيفَ نَعيمُها",23,"م",3,0],["وَالحامِلَ الأَقوامَ فَوقَ سَلاهِبٍ","وَالحاكِيَ الرِئبالَ في إِقدامِهِ",24,"م",2,0],["والحادثاتُ غوافلٌ عنْ أهلِهِ","والجفنُ عما لا يحبُّ قريرُ",25,"ر",1,0],["والحارثُ المأفونُ طاحَ بِلُبِّهِ","خَبَلٌ تُصابُ بِهِ العقولُ فَتَضْعُفُ",26,"ف",1,0],["والحازمُ الدّاهي يُكابِدُ نفْسَهُ","أعداءَهُ فتراهُ وهو مُجامل",27,"ل",1,0],["والحامِلات وكلّها محمولَةٌ","والنّاتِجات وكلّها عذراء",28,"ا",2,0],["وَالحالُ ضاقَت عَن ضَمِّها جَسَدي","فَكَيفَ لي أَن يَضُمَّهُ الشَجَبُ",29,"ب",1,0],["وَالحائِمونَ كَثيرٌ ثُمَّ بَعدَهُمُ","قَومٌ نِهالٌ وَقَومٍ كَظَّهُم عَلَلُ",30,"ل",1,0],["وَالحافِظَ الناسَ في تَحوطَ إِذا","لَم يُرسِلوا تَحتَ عائِذٍ رُبَعا",31,"ع",2,0],["وَالحَائِطُونَ فَلاَ يُرَامُ ذِمَارُهُمْ","وَالحَافِظُونَ مَعَاقِدَ الأَحْسَابِ",32,"ب",1,0],["والحَامِلِينَ إِذَا مَا جَرَّ جَارِمُهُمْ","بِحَامِلٍ غَيْر خَوَّارٍ ولاَ ضَجِرِ",33,"ر",1,0],["وألحانهم من فحيح العروقِ","يُصَعِّدُها الوترُ الساخرُ",34,"ر",1,0],["وَالحافِظو حِكَمِ الزَبورِ وَما أَتى","في الصُحُفِ وَالاِنجيلِ وَالتَوراةِ",35,"ه",1,0],["والحانياتِ على الغدير حواسرًا","عن كل ذيلٍ طاهرٍ معثار",36,"ر",1,0],["والحابسينَ زئيرَهم بصدورهم","فإذا انفجرنَ بهِ فأيُّ ضواري",37,"ر",2,0],["والحاضرُ المرتجّ بينهما شجاً","وتطُّلعاً تهفو به الأحلام",38,"م",1,0],["والحاكمونَ بما تُوحي مطامعُهم","مؤِّولينَ عليها الجدَّ واللَّعبا",39,"ب",2,0],["والحاقدينَ على البلادِ لأنَّها","حقَرَتْهم حَقْرَ السَّليبِ السَّالبا",40,"ب",2,0],["والحالِمونَ سيَفْقَهون إذا انجلَتْ","هذي الطّيوفُ خوادعاً وكواذباً",40,"ب",2,0],["والحَامِلَ بالكَلَّ الذي يُعيِى الوَرَى","والظَّاهِرَ الرُّتبَ العَزِيزَ الخَامِلا",41,"ل",2,0],["والحافظو عَورِة العشيرةِ للدّ","هر إذا شنَّ غارةً عُزُلُ",42,"ل",1,0],["وَالحامِلِ العِبءَ الَّذي لَو حُمِّلَت","هَضَباتُ سَلمى بَعضَهُ لَم يَحمِلِ",43,"ل",1,0],["وَالحارِثَ بنَ عُبادٍ غالَهُ وَسَطا","بِجَحدَرٍ فارِسِ التَحلاقِ لِلَّمَمِ",44,"م",1,0],["وَالحارِثَ بنَ سَدُوسٍ لَم يَهَب عَدَداً","فِيهِم بَنُوهُ وَلَمّا يَكتَرِث بِهِمِ",44,"م",1,0],["وَالحارِثانِ إِلى غاياتِهِم سَبَقاً","عَفواً كَما أَحرَزَ السَبقَ الجَوادانِ",45,"ن",1,0],["والحاسب الشهم لا تجري أناملُه","بحَسب ما أنت مشكور ومسؤولُ",46,"ل",1,0],["والحاسدون المبغضون رماهمو","ربّي بسلب السّمع والأبصار",47,"ر",1,0],["والحازمين العازمين شهامةً","والقائلين الفاعلين تَبَرُّعا",48,"ع",2,0],["وَالحافِظَ الناسَ في القُحوطِ إِذا","لَم يُرسِلوا تَحتَ عائِذٍ رُبَعا",49,"ع",2,0],["والحافظات ومكة تثني","عليه وعسقلان",50,"ن",1,0],["والحان اتار القريض ومعبد","وضوت الاغاني والحمائم هتفا",51,"ف",2,0],["والحاضرونَ جميعاً قائلونَ معي","الله باركَ أهلَ الدارِ والدارا",52,"ر",2,0],["وَالحالُ شاهِدَةٌ أنْ لَيْسَ مُعتَقِداً","حُكْمَ الكِتَابَيْنِ إِنْجيلاً وَقُرْآنَا",53,"ن",2,0],["والحابسون عليها أنفساً صبراً","لدى الكفاح فلا ميلاً ولا كشفا",54,"ف",2,0],["وَالحاتميُّ الَّذي أَضحَت عوارفُه","لمُغتَفي نَيله كالسُحبِ منهمِرَه",55,"ر",2,0],["وَالحافظُ العهد إذا ما نُسي","عندَ كرام القَوم حِفظُ العُهود",56,"د",1,0],["والحافي المدعو ببشر حبذا","من زاهد متبتل مستجمع",57,"ع",1,0],["والحاكمون بأمرهم","يا ذلّهم في الحاكمين",58,"ن",1,0],["وَالحالُ تَقعُدُ بِالكَريمِ فَما تَرى","فيهِ لِعِزَّتِهِ تَغَيُّرَ حالِ",59,"ل",1,0],["وَالحاصِلُ المَعلومُ مِن قَصدي لَكُم","أَنّي عَلى مَعلومِكُم لا أَحصُلُ",60,"ل",1,0],["والحال أنك في الأمانة تابعٌ","إيمانَ رأس الرسْلِ مع خُلفائه",61,"ا",3,0],["والحارِثُ المُسمِعُ الدُّعاءَ وفي","أَصحابِهِ مَلجَأٌ ومُعتَصَمُ",62,"م",1,0],["والحال أن العقل يكذب قولهم","حاشا الوصي بمثل ذاك يفوه",63,"و",2,0],["وَالحاكِم المَنصور أَسعَدَهُم بِهِ","عُمراً وَأَكثَرَهُم بِهِ إِنجاحا",64,"ح",2,0],["وألحان المثالثِ والمثاني","يُغنّيها فتطربُ في غناها",65,"ا",3,0],["والحاسدون فلا ترج","جى منهم أبداً صفاوه",66,"ا",3,0],["والحازم الرأي من عين اليقين يرى","بأنه عن كثيف الجمع موجود",67,"د",1,0],["والحاضنين عبيد الظلم من كفروا","بالحق وافتخروا بالموقف القذر",68,"ر",1,0],["والحالمين بإعزاز لأمتهم","على ايادي لصوص بالغي الضرر",68,"ر",1,0],["والحال تنبى أن ذاك لم يكن","عن توبة وانما كان فشل",69,"ل",1,0],["والحارثُ بن أبي شمرٍ ينوحُ على اب","ن أخته منكُمُ والنوحُ تقصيرُ",70,"ر",1,0],["والحاج يُلقَى دونه","نّ اللَّحِزُ المُزَيِّدُ",71,"د",1,0],["والحاصباتِ وكلُّ مَوقع جمرةٍ","يَنبدْنَها في القلبِ مَوقِدُ جمرةِ",72,"ه",1,0],["والحال فينا ما ترى","من شدّة أو نصب",73,"ب",1,0],["والحال حال وقد دار الزمان وما","بالكون دائرة إلا وقد رقصت",74,"ت",1,0],["وَالحافِظو عَورَةِ العَشيرَةِ لا","يَأتيهُمُ مِن وَرائِهِم وَكَفُ",75,"ف",1,0],["والحادثات جميعاً زرعٌ وإن","نَكَ أنت زارعها وأنت الحاصدُ",76,"د",1,0],["والحاسِدونَ بخِزْيٍ لا يُفارِقُهُمْ","على المذلَّةِ حتَّى يُنْفَخَ الصُّورُ",77,"ر",1,0],["والحاملان على الممالك ثقل ما","تحتاج من نقض ومن إمرار",78,"ر",1,0],["وَالحادِثاتُ إِذا طَرَقن فَلم أَكن","عَنهُنَّ نوّاماً ولا بهجودِ",79,"د",1,0],["وَالحاطِمينَ غَداة كلِّ كريهةٍ","في الدّارعينَ صدورَ كلِّ صِعادِ",80,"د",1,0],["وألحان عشق تذوب اشتياقا","وكأس وليل وأيام عيد",81,"د",1,0],["والحادث المعلوم ليس بحادث","علم قديم مثله أحواله",82,"ل",2,0],["والحال يشهد والشهيد هو الذي","شهد الأمور على أتم صلاح",83,"ح",1,0],["وألحاظ بألفاظ تنادي","دم العشاق في الدينا مباح",84,"ح",1,0],["والحالُ أَنَّ لهُ كذا ألفاً من الن","نُسَخِ التي اتَّفَقتْ بضبطٍ مُحَكمِ",85,"م",1,0],["وَالحاصِباني باتَ إِثرَها","يَشتَدُّ في الجَريَ لَيسَ يَصطَبِرُ",86,"ر",1,0],["وَالحامِلونَ إِذا ما أَزَمَة أَزمَت","فِعلَ العَشائِرِ إِن هَمّوا وَإِن ضَرَبوا",87,"ب",3,0],["وَالْحَائِزينَ بِمَجْدِهِمْ رُتَبَ الْعُلَى","مَا بَيْنَ شِيبٍ قَدْ مَضَوْا وَشَبَابِ",88,"ب",1,0],["والْحالِبُ العَجْلانُ كالْ","مِخْراقِ والزِّقِّ الرَّوِيْ",89,"ي",1,0],["والحال رُبَّتما تكون مُعَضَّلاً","تُمَّتْ تحولُ إذا تَحولُ مُسَبَّغا",90,"غ",2,0],["وَالحافِظ الثَّبت بِهذا الزّمان","ومالِك الوَقتِ بِرأيٍ صَواب",91,"ب",1,0],["وألحاظٌ لها فتَرٌ","ومنطقُه به غُنّه",92,"ن",2,0],["والحاجز الجيِّدُ المعروف عند مسا ال","خير الكريم فتِلكُمْ للعِدا نِقَم",93,"م",1,0],["والحال منا بعين اللّه يبصرها","وكلنا طامع يرجو طلوع غد",94,"د",1,0],["وألحاظ تبارك من براها","سهاما للقلوب بها براني",95,"ن",2,0],["والحايزين بأحساب وبيض ظبا","بحبوحة المجد والشم الرفيعات",96,"ت",1,0],["والحاملين لها من الأ","يدي بمجتمع الأساور",97,"ر",1,0],["والحافظون شريعة ال","بعوث من خير العشائر",97,"ر",1,0],["وَالحارِثِيونَ لَم أَرضَ الَّذي نَطقوا","عِندَ الأَميرِ وَشَرُّ المَنطِق الشنعُ",98,"ع",1,0],["والحازم النحرير من زهد الدنا","وسعى ببرٍّ واكتسى ثوب النقا",99,"ق",2,0],["والحار قد يُخشى بان يُربى بهِ","حنقٌ يؤول إلى الخروج عن الصدّدْ",100,"د",1,0],["والحاجبانِ حروف شعر دافئ","والوجه ملفوفٌ بسحر الرونقِ",101,"ق",1,0],["والحائم الصّديان يخدع رأيه","آل الهجير وللهجير وقود",102,"د",1,0],["والحال ما أبان وصف الفاعل","أو وصف مفعول بنصب الفاضل",103,"ل",1,0],["والحاء رتقا وابتداؤها لدى","ختمك لاما اصلها فيه بدا",104,"د",2,0],["والحاء فيهما على حدٍّ سوا","وبعضُهم في الثان تلويزاً روى",104,"ر",3,0],["وألحاظ مواض كالمواضي","قلوب العاشقين لها جفون",105,"ن",1,0],["والحاكم العَدّلُ له الاكبار","بحكم لا إله إلا اللّه",106,"ه",1,0],["والحافِظُ الحُرُمَات مِ","نِّي حيثُ شَيَّعتُ المحَارِم",107,"م",1,0],["والحافظون ذمامَ المستجير بهم","والدّافعون عُرام المأزق العادي",108,"د",2,0],["والحاملون رماحَ الخطّ مسْرعة","للطعن ما بين لبّات واكبادِ",108,"د",1,0],["والحائز المجد المؤئل مَن زَكَتْ","آباؤه وسَمَتْ بهِ أفضالُهُ",109,"ل",2,0],["وَالحارِثَ الفَيّاضَ يُبرُقُ وَجهُهُ","كَالبَدرِ جَلّى لَيلَةَ الإِظلامِ",110,"م",1,0],["وَأَلَحَّ إِلحاحاً بِحاجَتِهِ","شَكوى الضَريرِ وَمَزجَرَ الكَلبِ",111,"ب",1,0],["وألحاظ يروم البرء منها","لفرط جنونه وهي السقام",112,"م",1,0],["والحاسب المنشي البلي","غ المصقع الدرِب الأجل",113,"ل",1,0],["والحاسب المنشي الذي رجحت صنا","ئعه بميزان الحساب الجامع",114,"ع",1,0],["والحاذق الفطن اللبيب الصادق ال","لسن الأريب البارع القهار",115,"ر",1,0],["والحال تطلبه لأقبح طاعةٍ","عمياء تثلم صيتَه المعروفا",116,"ف",2,0],["والحاكمينَ لما شاؤوا إذا غُمِزَتْ","بعضُ الرجال بمردودٍ وموهون",117,"ن",1,0],["والحاملاتُ كمثلهن ولا أرى","بأساً بذوق الحلوِ والمر",118,"ر",1,0],["والحارِثيّين والسمِّىَ إِنَّهمُ","لكالجُحولِ على العلياء والغُرَرِ",119,"ر",1,0],["والحال فيما سُكِّنَتْهُ ومُلِّكَتْ","منه الذي مَلَكَتْهُ من آلاتِها",120,"ت",3,0],["والحال ليس يحصى","جمالهُ للمحصى",121,"ص",2,0],["وَالحارِثُ بنُ يِزيدٍ وَيحَكَ أَعوِلي","حُلواً شِمائِلُهُ رَحيبُ الباعِ",122,"ع",1,0],["والحارثُ بن عُبادٍ اقتحم الوغى","لما استُضِيم فكان غيرَ مذمم",123,"م",1,0],["والحَاضرُونَ نَدَاما","والغائبُونَ نَدَامَا",124,"م",2,0],["وألحَاظُهُ كُلٌّ تَتِيهُ بِحُسنِها","وَلكِنَّ إحداهُنَّ غَارَت مِنَ الأخرَى",125,"ر",2,0],["والحاء تطلب بالتنزيه كاتبها","يوماً إذا صار تشبيه به وطرا",126,"ر",2,0],["وإلحام الأباعد بالأداني","وإظهار السوابق بالمآل",127,"ل",1,0],["وإلحامِ الأباعد بالأداني","وقالوا النقصُ من شرطِ الكمالِ",128,"ل",1,0],["والحال حين سرى نادت مؤرخةً","هذا مصيرٌ لوفد العالم البشري",129,"ر",2,0],["والحَاكِمُ الثَّاني كَلامُ رَسُولِهِ","مَا ثَمَّ غيرُهُمَا لِذِي إيمانِ",130,"ن",1,0],["والحافظات الغيب منهن التي","قد أصبحت فردا من النسوان",130,"ن",1,0],["وَالحامِلاتُهُمُ في كُلِّ مُعتَرَكٍ","فيهِ إِسارٌ وَتَقتيلٌ وَتَعفيرُ",131,"ر",1,0],["وإلحاقها بالزوج من حملته من","سواه وكتمان العلوم لمجتدي",132,"د",2,0],["وَالحارِثُ البَكرِيُّ قامَ إِلى الوَغى","مِن بَعدِ ما أَمضى عَزيمَةَ جالِسِ",133,"س",1,0],["والحاكم المرتضى دون الورى حكما","يا أسعد الله جد الحاكم الحكم",134,"م",1,0],["وألحاظُها فوق المياه وكلها","ر