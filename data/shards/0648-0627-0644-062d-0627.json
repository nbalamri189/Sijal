,"د",1,0],["وَالحَالُ قَد يُحذَفُ مَا فِيهَا عمِل","وَبَعضُ مَا يُحذَفُ ذِكرُهُ حُظِل",159,"ل",1,0],["وَالحازِمُ الأَمرُ الكَريمَ بِرَأيِهِ","وَالواصِلُ الأَرحامَ وَاِبنُ الواصِلِ",160,"ل",1,0],["وَالحاضرُ اللبّ وَالأَلبابُ طائِشَةٌ","وَالثابت الجَأش وَالأَبطالُ تصطدمُ",161,"م",1,0],["والحال قد رقت فلا مرفق","يجبرها أو راتب آتي",162,"ت",2,0],["والحال حالٍ والهنا","أصفى التواصل منهله",163,"ل",2,0],["والحالُ انك بالوفاءِ سَمَو أَلٌ","ووليدهُ دُونَ الدُروعِ قتيلُ",164,"ل",1,0],["والحالُ ان يسوعَ قدَّمهُ كما","قد نَصَّهُ الإِنجيلُ بالتبيانِ",165,"ن",1,0],["وَالحال حالت وَالنُفوس عَلى شَفا","مما جَرى وَالجسم في إنهاك",166,"ك",1,0],["وَالحاكم الدَيان جلَّ جَلالُه","قَد صانَ ما فرّطت مِنكَ وَسطرا",167,"ر",2,0],["وَالحال حالٌ آخرٌ","وَجَميعُهم لا يَعلمون",168,"ن",1,0],["والحَافِظَان لما أوصَى الإله بِهِ","مِن حقِّ ذي الحقِّ إن غَابَا وإن شَهِدَا",169,"د",2,0],["وَالحاجِري الأَديب صَبا","أَنسَته بَرقَ الحِما وَحاجِر",170,"ر",1,0],["وَالحارِثَ بنَ شِهابٍ عِندَ مُعتَركٍ","رَهنُ المَقامَةِ لِلعَرجاءِ وَالرُخَمِ",171,"م",1,0],["والحان ترقص والأرواح قد صعدت","لمشهد السر فالأرواح أرواح",172,"ح",1,0],["والحاضرين ومن قاموا بخدمتكم","فإنهم عن جميل الصنع ما ناموا",173,"م",3,0],["والحاظ يجول السحر فيها","فَتَنقاد القلوب بِلا زمام",174,"م",1,0],["والحائز الدنيا مع الدين معاً","بذالكم أخبرني عيافها",175,"ف",3,0],["والحالبين لغات الأرض اشطرها","والمالئين بيوت العلم بالكتب",176,"ب",1,0],["والحاكم الندب الحكي","م العدل ذو الرأي المسدد",177,"د",1,0],["وَالحاتِميِ وَالمَهدَوي مِن صَحبِهِ","أَسدُ الهياج وَأَنجُمُ الأَبراجِ",178,"ج",1,0],["وألحاظ الظبا سلَّت ظُباها","تقدُّ قلوبَ عُشّاقُ القدودِ",179,"د",1,0],["والحال في التوراة والإنجيل","وهكذا الزبور كالتنزيل",180,"ل",1,0],["والحاجبان لها كأنهما","قوسان فرَّق فيهما النبلُ",181,"ل",1,0],["والحالُ عن خبرٍ مما تنوبُ إذا","إضمار إذ وإذا من قبلها لزما",182,"م",2,0],["وَالحالِفَ الحانِثَ المُصِرَّ عَلى الحَنْ","ثِ عُتُوّا وَشاتم السُّلَفِ",183,"ف",1,0],["والحاضرينَ بيعةِ الرضوان بَلْ","والتَّابعين السَّادَة الأبرَارِ",184,"ر",1,0],["وَالحالُ إِن عَظُمَت فَلا يُدعى لَها","إِلّا العَظيمُ وَأَشرَفَ الشُفَعاءِ",185,"ا",2,0],["وَالحالُ ضاقَت بي وَلَم أَرَ نافِعاً","إِلّا الرُجوعُ لِأَكرَمِ الكُرَماءِ",185,"ا",2,0],["والحادثات موكّلات بالفتى","والناس بعد الحادثات سماع",186,"ع",1,0],["والحاشدون حشود الشرِّ جمَّعهمْ","في ملّة الشرِّ أنْ كلٌّ له أَرَبُ",187,"ب",1,0],["والحا حدتني عن هوى ناعم الريش","ما مثلها بين المخاليق لو عاش",188,"ش",1,0],["والحال كما قال (تميم ال","برغوثي) صار هو الأفظع",189,"ع",1,0],["والحال يسوء بنا فاخبر","يا صاحِ امرأةً لم تقنع",189,"ع",1,0],["والحاءُ حان اللقا حفظاً لدينِ هدى","والسينُ سلَّ العدوُّ السيفَ إذ وعدا",190,"ا",1,0],["والحالُ هذا ما استمرْ","رَ على الوتيرةِ قاتل",191,"ل",1,0],["والحاقدونَ بأرض يعربَ أيّدوا","غدرَ الجُناةِ , وهنّؤوا أعداكِ",192,"ك",1,0],["والحائط المصبوغ بال","آلام والحزن الدفين!",193,"ن",1,0],["والحالقون صدورهم وفخوذهم","مثل النساءِ شمائلاً وميولا",194,"ل",2,0],["وألحانٌ تَفِيضُ بها الحنايا","فَتُسكِرُ كلَّ ذي لُبٍّ يَرِقُّ",195,"ق",1,0],["والحاجبانِ كأنّما خُطَّا بِري","شة مُتقِنٍ كالقوسِ حين يُعلَّقُ",196,"ق",1,0],["وَالْحَاكِمُ الْمَأْجُوْرُ يَدْعَمُ قَاْتِلاً","نَذْلاً، وَيَدْعَمُ حُكْمَهُ مُسْتَأْجَرُ",197,"ر",1,0],["والحاء ثم الدال كم ذا شُرِّفَتْ","أبدا لتأتي باسمه الغرَّاءِِ",198,"ر",3,0],["والحال أن الوضع بات مذبذبا","هدف يزول ليستعاد مجددا",199,"د",2,0],["والحاصل ان الحقد ما يثمر الحب","واللي قرا الأمثال ياما سردها",200,"د",3,0],["والحاجه اللي حدت النفس للناس","هي عرفتني ناس فيها خداجه",201,"ج",2,0],["والحاسدين الكثّر أغلبهم العي","الناقصين اللي احسدوني يبونك",202,"ك",1,0],["والحاكمون غدا الكرسيُّ ربهمو","يقدمون له الأوطان قربانا",203,"ن",2,0],["والحانين الحاتمين من الندى","ما شاع في العربي والمستعرب",204,"ب",1,0],["( وألحاظ بأسياف تُنادي","على عاصي الهوى الله أكبر )",205,"ر",1,0],["والحاجه....الي تجعلك عبد-للغير","جنب مسالكها .....وﻻ تقترفها",206,"ف",3,0],["وَالْحَاءُ حَنَّتْ بَعْدَ ضَمٍّ أَشْفَقَتْ","لَمَّا رَأَتْ حَرْفَاً يَلِيهَا شُدِّدَا",207,"د",2,0],["وَالْحَاضِرُ الْمَأْسُورُ فِي جِلْبَابِهِ","حَجَبَ الرُّؤَى وَالأُمْنِيَاتِ الْمُسْبِلَةْ",208,"ل",2,0],["وألحان تذيب القلب شجواً","وأنفاس من الأزهار عذبةْ",209,"ب",2,0],["وألحا فقمت أملي وأرجو","منك مولاي أن يتم المروم",210,"م",1,0],["والحاكمونَ بأمرِهِ","ظلموهُ ثمَّ تحاملوا",211,"ل",3,0],["والحالُ ما زالَ نفسَ الحالِ واأسفا","بلْ لم تَزلْ بلسانِ الحالِ ترويها",212,"ي",3,0],["والحادثات كمُوناً في مرابضها","كأنها في مراعي الضأن ذؤبان",213,"ن",1,0],["والحال تمتلك الأزمة دونه","والجد في نير الحياة عثور",214,"ر",1,0],["والحاضر الآن استقر مزاجه","إما التضامن أو يسود فناء",215,"ا",2,0],["والحال دوَّار كم يِبقَى يِدُور","وكُلَّنَا وَسطْ هَذي الدايره",216,"ر",2,0],["والحاضرون تشربوا بدمائهم","فاعطش ولا تشرب من الإبريق",217,"ق",1,0],["والحاضر الميمون يحكى للورى","عما يكون لمصرنا الشماء",218,"ا",2,0],["وألحان من التهريج تعلو","لتطمس نغمة الشرق الجميلة",219,"ل",2,0],["وألحان سحرت بها قلوبا","أطالت حول معزفك الخضوعا",220,"ع",2,0],["وَالْحَال أبدت لمن تميزها","تَعَجبا سَاءَ مصدرا وَصفه",221,"ه",1,0],["والحارسون لعرشها","خانوا السراط وكوثره",222,"ر",2,0],["والحال هيّن بين احيان واحيان","لآ غابت القمرا .. نشب القناديل",223,"ل",1,0],["والحاء حديد الزين بان فيدين سادات الزمان","مطلوبهم سكن الجنان من خوف يوم النازعات",224,"ت",1,0],["والحاكمون أقالَ اللَّه ُعَثْرَتَهُم","يَسعَونَ في الأرض ِتَزميرا ًوتَطبيلا",225,"ل",2,0],["والحاكم الي منه مانعدم البشرا","يفصل وهو يعلم الخافي وماقلته",226,"ت",2,0],["والحاجبان مزججان كأنما","قوساهما في الرسم مثل هلاله",227,"ل",2,0],["والحادثات معاول هدامة","وعلى معاولها الزمان يُعوّل",228,"ل",1,0],["و(الحاجر) الحاجر الماء الزلال على","ضفاف واديه بالرحمى يساقيها",229,"ي",3,0],["والحالمون على بساط بُراقِهم","المجدُ والإجلال والإشراقُ",230,"ق",1,0],["والحاجبانِ استَنطقا قُزَحاً","والبَوحُ ، فوقَ الرِّمشِ ، إنشادُ",231,"د",1,0],["وَالحَاكِمُ العَرَبِيُّ يَقْتُلُ شَعْبَهُ","وَتُقامُ فَوْقَ قُبورِهِ الحَفَلَاتُ",232,"ت",1,0],["والحال مستور لا تستجدي حلول","قبلت قسمي معك في كل الاحوال",233,"ل",1,0],["والحالقين تراهم مثل النسا","والبانيان على سوى استصحابا",234,"ب",2,0],["والحاقدونَ تسلقوا حبلَ افترا","فانهارَ دونَ متانةِ البنيان",235,"ن",1,0],["والحادثات مصاعق بمنابر","بعظاتها تتواضع الأشياء",236,"ا",2,0],["والحامدون السائحون في العلى","والراكعون الساجدون والرُّغب",237,"ب",1,0],["والحافظون الكاتمون أمرهم","والراسخون في العلوم والرتب",237,"ب",1,0],["والحارث القزمي حراث لكم","بالعلم من قدر بكم ينحو",238,"ح",2,0],["والحارث الأعور القرمي علمهم","بكل قلب زكي غير منفسد",239,"د",1,0],["وألحاظ الحواسد تتقيني","وأفئدة الكواشح قيد أسري",240,"ر",2,0],["والحارثانِ إلى غاياتهم سبقاً","غفواً كما أحرزَ السبقَ الجوادانِ",241,"ن",1,0],["والحَادِبونَ على مَنْ حلَّ حِلتَّهُمْ","لا يعتدونَ على جَارٍ وإِنْ جَارَا",242,"ر",2,0],["والحاجه اللي ما تجي دون تبرير..!!","يا شينها لا زل فيها لساني",243,"ن",2,0],["والحاءُ في الميمِ فاحَتْ والبهاءُ بدا","عِقدٌ ثمانٍ وعشرونَ العُلا وُسِما",244,"م",2,0],["والحارسان لها بعل وخير أبٍ","حراسة العين بالجفنين والهدب",245,"ب",1,0],["والحاملان عن الممالك ثقل ما","تحتاج من نقض ومن إمرار",246,"ر",1,0],["والحابس الأبطال عن أن يزأروا","ظن الزئير قضى قتل إسار",247,"ر",1,0],["والحالُ يقضي أن تكونَ بها","في غبطةٍ لا تُضمر الشَّرّا",248,"ر",2,0]]}