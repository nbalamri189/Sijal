نَواحي فَإِنَّ جودي سَمينُ",4,"ن",1,0],["إِن تَرجِعِ الحُكمَ إِلى أَهلِهِ","فَلَستَ بِالمُستي وَلا النائِرِ",5,"ر",1,0],["أن تُرِدْ غرس نخلة من ثراء","فسوى المفلس مالها من نواة",6,"ه",1,0],["إِن تَرَي رَأسِيَ أَمسى واضِحاً","سُلِّطَ الشَيبُ عَلَيهِ فَاِشتَعَل",7,"ل",1,0],["أن ترى العُرفَ عند مثليَ نكراً","وأرى المدح فيك كالتسبيحِ",8,"ح",1,0],["أن ترى أنني متى انجاب هذا ال","ليلُ عني أضاء ذاك النهارُ",9,"ر",1,0],["أنت راض حين تجري","بعد سبق بلَحاق",10,"ق",1,0],["أنت راعي الرُّعيان طوراً وطوراً","أنت راعي رَعيّة الرُّعيان",11,"ن",1,0],["إِن تَرَ زَهرَةَ وَردٍ فَوقَها لِلطَلِّ قَطرَه","فَتَأَمَّلَها كَلُغزٍ غامِضٍ تَجهَلُ سِرَّه",12,"ر",2,1],["أَنتَ روحي لا أَرى لي","عَنكَ يا روحي اِنفِصالا",13,"ل",2,0],["أَنتَ روحي وَقَد تَمَلَّكتَ روحي","وَحَياتي وَقَد سَلَبتَ حَياتي",14,"ي",1,0],["أَنْتَ روحٌ غَبِيَّةٌ تكره النُّور","وتقضي الدُّهُور في ليل مَلْسِ",15,"س",1,0],["أَنتِ روحُ الرَّبيعِ تختالُ ف","ي الدُّنيا فتهتزُّ رائعاتُ الورودِ",16,"د",1,0],["انت روح ترقى الى حيث شاءت","لا حجاب لها عن التصعيد",17,"د",1,0],["أنت روحي ظلم الواشي الذي","زعم القلب سلا أو ضيّعك",18,"ك",1,0],["أَنتَ رَشيدُ العُلى","في المَلأَينِ اِحتَكَم",19,"م",1,0],["إِن تَرامَت بَلَداً عِقبانُهُ","خَطَفَت تاجاً وَاِصطادَت عُقابا",20,"ب",2,0],["إِن تُراعِها","تَسمَعِ العَجَب",21,"ب",1,0],["إِن تَرمِني نَكَباتُ الدَهرِ عَن كَثَبٍ","تَرمِ اِمرَأً غَيرَ رِعديدٍ وَلا نَكِسِ",22,"س",1,0],["إِن تَريني أَدِمتُ بَعدَ بَياضٍ","فَحَميدٌ مِنَ القَناةِ الذُبولُ",23,"ل",1,0],["إِن تُرِد نَقلَ بَيتِهِ لا يُتابِع","كَ شَرَوري وَلا يُطاوِعكَ شابَه",24,"ب",2,0],["إِن تَرجُ طولَ عُبَيدِ اللَهِ لا تَخِبِ","أَو تَرمِ في غَرَضٍ مِن سَيبِهِ تَصِبِ",25,"ب",1,1],["إِن تَرامَت بِها المَسافَةُ أَدنا","ها وَجيفٌ إِلَيهِ أَو تَوخيدُ",26,"د",1,0],["إِن تَرَيني تَرَي حُساماً صَقيلاً","مَشرِفِيّاً مِنَ السُيوفِ الحِدادِ",27,"د",1,0],["إِن تَرمِ إِسحاقَ بنَ كُنداجيقَ بي","أَرضٌ فَكُلُّ الصَيدِ في جَوفِ الفَرا",28,"ر",2,0],["إِن تَرمِ آلاؤُهُ في الدَهرِ عَن وَتَرٍ","تَكُن لَها نُوَبُ الأَيّامِ أَهدافا",29,"ف",2,0],["أَنتَ رَجائي بِأَرضي إِنَّني فَرِقٌ","مِن واسِطٍ وَالَّذي نَلقاهُ نَنتَظِرُ",30,"ر",1,0],["إِن تَرجِعوا قَد فَرَغتُم مِن جَنازَتِهِ","فَما حَمَلتُم عَلى الأَعوادِ مِن أَمَمِ",31,"م",1,0],["إن تروا أدمعي فلا تزجروني","ودعوني إني أحب الدموعَا",32,"ع",2,0],["أنت روح في سمائي وأنا","لك أعلو فكأني محض روح",33,"ح",1,0],["أنْ ترفعَ الطاعونَ عنّا عاجلاً","وتجيرَنا مِنْ شرِّهِ وتجنِّبا",34,"ب",2,0],["إنْ ترهُ بينَ ذويهِ في الحمى","فانصبْ وقلْ كمْ كوكباً تحوي السما",35,"م",2,0],["إِن تَرَيني أَقصَرتُ عَن طَلَبِ الغَي","يِ وَطاوَعتُ عاذِلي إِذ نَهاني",36,"ي",1,0],["أَن تَرُدَّ الواشينَ عَنّي كَما أَع","صي إِذا ما ذُكِرتَ عِندي أَميرا",37,"ر",2,0],["إن تُريدي شاهِداً أو مَثَلا","فاسْأَلي الآياتِ واستفتِي السُّوَرْ",38,"ر",1,0],["أَنترُكُها نَهْبَ المُغيرينَ إنّنا","لَتُنكِرُنا آباؤنا حِينَ نُنْسَبُ",39,"ب",1,0],["إِن تَرفَعِ الهِمَمُ الشُعوبَ فَإِنَّنا","شَعبٌ تدينُ لَهُ الصِعابُ هُمامُ",40,"م",1,0],["أنتركها لِلغاصِبينَ وَنَبتَغي","لَنا وَطَناً فَوقَ البَسيطَةِ ثانِيا",41,"ي",2,0],["أَنتركُها بِأَيدي القَومِ نَهباً","وَفي هَذي الكنانةِ سَهمُ رامِ",42,"م",1,0],["إن تُردْ خيراً فهذا مَعبدٌ","أوَ لم يُنْبِئكَ أنّ الأمرَ إِدّ",43,"د",1,0],["إِن ترَحَميني تعذبيني","أَو تَظلميني لا تَنصفيني",44,"ي",1,0],["أَن تَريني يا شَرُّ خَلَّفتُ أَيّا","مِيَ صِبّاً كانَ ناعِمَ البالِ لَذّا",45,"ذ",2,0],["إِن تَرَيني يا شَرُّ مُلقىً عَلى الفُر","شِ وَقَد مَلَّ عائِدي وَطَبيبي",46,"ب",2,0],["إِن تَرَيني فادَ الرُقادُ مِنَ الوَج","دِ حَزيناً أُجيدُ فيكَ القَصيدا",47,"د",2,0],["إِن تُراعوا مِنَ المُراعاةِ رَبّاً","لا تُراعوا بِالرَوعِ مِنَ ذاتِ رَمضِ",48,"ض",1,0],["إِن تَركَبِ الخَيلَ أَو تَضرُب مَراكِبَها","مِن عَسجَدٍ فَإِلى الغَبراءِ تَنصَرِفُ",49,"ف",1,0],["إِن تُرِد أَن تَخُصَّ حُرّاً مِنَ النا","سِ بِخَيرٍ فَخُصَّ نَفسَكَ قَبلَه",50,"ل",2,0],["إِن تَري هَمّيَ أَمسى شاغِلي","وَإِذا ما نُوجِيَ الهَمُّ شَغَل",51,"ل",1,0],["إِن تُرزَ في طَرَفَي نَهارٍ واحِدٍ","رُزئَينِ هاجا لَوعَةً وَبَلابِلا",52,"ل",2,0],["أَنتركُهُم يَغصِبون العُروبَ","ةَ مَجدَ الأُبَوَّةِ والسُّؤدَدَا",53,"د",2,0],["إنْ تَرِدْها القَنَاةُ فهْيَ قَناةٌ","نَمِراً صادَفَتْ بها لا نَميرا",54,"ر",2,0],["أَنْ تَرْتَعُوا فِي نِعْمَةِ اسْتِقْلاَلِكُمْ","فَتَذَكَّرُوا مَنْ شَادَ الاسْتِقْلاَلاَ",55,"ل",2,0],["إِنْ تَرَامَى بَيْنَ الرُّبَى","خِلْتَ فُلْكاً بَيْنَ الْحَبَبْ",56,"ب",1,0],["أن ترى الإنسان يهوي من عل","يدعي العقل ولكن حربه",57,"ه",1,0],["أنْتْرُكُ العَرَبيَّ السَّمْحَ مَنْطِقُهُ","إلَى دَخِيلٍ مِنَ الألْفَاظِ مُغْتَرِبِ",58,"ب",1,0],["أنتِ رُوحانيَّةٌ لا تدّعى","غيرَها فالأمرُ كالصبح جلاء",59,"ا",2,0],["إن ترتَقِ اللغةُ، ارتقى أبناؤها","وإذا هوتْ، فأقم عليهم مأتما",60,"م",2,0],["أن تريدي سيارة وإدارة","فلتكوني قوادة عن جدارة",61,"ر",2,1],["إنْ تَرَاقَتْ بها المَسافَةُ أدْنَا","ها وَجيفٌ إلَيهِ، أوْ تَوْخيدُ",62,"د",1,0],["إن تر زهرة ورد فوقها للطلّ قطره","فتأمّلها كلغر غامض تجهل سرّه",63,"ر",2,1],["أنتركهُا كيف نتركها ؟","وما أُرهقت بعدُ أعصابُنا",64,"ن",2,0],["أنت ركن القبول والكل يدري","ان لله كل ذهابك",65,"ك",1,0],["أنت روح الأشياء والبرزخ الفا","روق بين الآلا ومولى الموالي",66,"ل",2,0],["إنّ تركي خدمةَ الأوطان معْ","طول ما مارستُ في الدنيا خسارهْ",67,"ر",2,0],["أنت روحٌ لها ولا يعُمِر الجث","مانُ إلا ما دام للروح وَكرا",68,"ر",2,0],["إِن تُرِد عِلمَ حالِهِم عَن يَقينٍ","فَاِلقَهمُ في مَكارِمٍ أَو قِتالِ",69,"ل",1,0],["إِن تَرى شَخصي لِأَمرٍ ساكِناً","فَلَعَمري إِنَّ قَلبي في طِرادِ",70,"د",1,0],["إِن تَرَى اليَومَ ضِيقَةً","سَتَرى فَرجةً غَدَا",71,"د",2,0],["أنت روحي فكيف أهجر روحي","يا منايَ وغايتي وسروري",72,"ي",1,1],["أنتَ روحُ الوجودِ سفلاً وعلوا","وَمدارُ السعودِ دُنيا وأخرى",73,"ر",2,0],["إن تردِ الدنيا ومن قسمكَ ال","فقرُ تكن روحكَ من قسمها",74,"م",3,0],["أنتركُ الغربَ يلهينا بزخرفهِ","ومشرقُ الشمسِ يبكينا وينتحبُ",75,"ب",1,0],["أنت روحي فمن يعيش بلا رو","حٍ أبِن لي إذا تغيَّبتَ عنّي",76,"ن",2,0],["أنت روحي فلو أتيتُك للتَّو","ديعِ ودَّعتُ مهجتي للسِّياقِ",77,"ق",1,0],["أنت روحي وراحتي وحياتي","ووجودي ومسعي وعياني",78,"ن",2,0],["إِن تُرجِعي دَمك الشَهِيِّ لِنَبعَه","كَم جَدوَلٍ في الأَرضِ راجِع مَنبَعَه",79,"ع",2,0],["إِن تَرُم مجداً وَفَخرا","وَاِقتِداراً مُستَمِرّا",80,"ر",2,1],["إِن تَرُم ت