{"poems":[[53,"وسمتك حالية الربيع المرهم","https://www.aldiwan.net/poem29817.html","الكامل"],[53,"تمضي العلى وإلى ذراكم ترجع","https://www.aldiwan.net/poem30156.html","الكامل"],[53,"ولقد أكون من الغواني مرة","https://www.aldiwan.net/poem30713.html","الكامل"],[53,"ألان جوانبي غمز الخطوب","https://www.aldiwan.net/poem30752.html","الوافر"],[55,"ولائم في السمر من جهله","https://www.aldiwan.net/poem26193.html","السريع"],[34,"قد قلت للقلب لا لبناك فاعترف","https://www.aldiwan.net/poem4917.html","البسيط"],[86,"نعاك النعاة وحم القدر","https://www.aldiwan.net/poem10471.html","المتقارب"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[35,"حبال سجيفة أمست رثاثا","https://www.aldiwan.net/poem39175.html","المتقارب"],[27,"بان الخليط برامتين فودعوا","https://www.aldiwan.net/poem5799.html","الكامل"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"إن وهب بن سليما","https://www.aldiwan.net/poem61889.html","مجزوء الرمل"],[51,"نادمت بدر السماء في فلكه","https://www.aldiwan.net/poem65770.html","المنسرح"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[12,"أقيموا بني أمي صدور مطيكم","https://www.aldiwan.net/poem1219.html",""],[89,"هتف العراق مرحبا","https://www.aldiwan.net/poem44847.html","مجزوء الكامل"],[89,"جاء الربيع وورد الرمان","https://www.aldiwan.net/poem44908.html","الكامل"],[85,"آذار أقبل قم بنا يا صاح","https://www.aldiwan.net/poem7257.html","الكامل"],[85,"إن تسألي عن مصر حواء القرى","https://www.aldiwan.net/poem8089.html","الكامل"],[85,"عادت أغاني العرس رجع نواح","https://www.aldiwan.net/poem21008.html","الكامل"],[85,"اخترت يوم الهول يوم وداع","https://www.aldiwan.net/poem62860.html","الكامل"],[85,"قد كنت أوثر أن تقول رثائي","https://www.aldiwan.net/poem62927.html","الكامل"],[85,"اجعل رثاءك للرجال جزاء","https://www.aldiwan.net/poem62936.html","الكامل"],[85,"درجت على الكنز القرون","https://www.aldiwan.net/poem63694.html","مجزوء الكامل"],[85,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[45,"ما أنت للكلف المشوق بصاحب","https://www.aldiwan.net/poem10671.html","الكامل"],[45,"تعاط الصبابة أو عانها","https://www.aldiwan.net/poem66802.html","المتقارب"],[28,"هتمت قريبة يا أخا الأنصار","https://www.aldiwan.net/poem5194.html","الكامل"],[66,"هل علم الطيف عند مسراه","https://www.aldiwan.net/poem38476.html","المنسرح"],[66,"أنف الخمار من فرط خباها","https://www.aldiwan.net/poem39074.html","الرمل"],[97,"جئتُ أشكو لكِ روحي وجواها","https://www.aldiwan.net/poem24757.html","الرمل"],[97,"كيف أنسى زمناً كنت به","https://www.aldiwan.net/poem24981.html","الرمل"],[97,"يا شطر نفسي وغرامي الوحيد","https://www.aldiwan.net/poem24986.html","السريع"],[97,"هتفت وقد بدت مصر لعيني","https://www.aldiwan.net/poem25068.html","الوافر"],[44,"فاض اللئام وغاضت الأحساب","https://www.aldiwan.net/poem30067.html","الكامل"],[44,"ملك جار إذ ملك","https://www.aldiwan.net/poem30142.html","مجزوء الخفيف"],[44,"آلت أمور الشرك شر مآل","https://www.aldiwan.net/poem30371.html","الكامل"],[44,"بوأت رحلي في المراد المبقل","https://www.aldiwan.net/poem30384.html","الكامل"],[105,"هتف الداعي فلبى واعتزم","https://www.aldiwan.net/poem41931.html","الرمل"],[105,"هتف البشير به وحان الحين","https://www.aldiwan.net/poem42044.html","الكامل"],[105,"ها هنا الأعلام كانت تنصب","https://www.aldiwan.net/poem42062.html","الرمل"],[105,"طال التحجب فارفع الأستارا","https://www.aldiwan.net/poem42078.html","الكامل"],[105,"قل ما أردت فما عليك جناح","https://www.aldiwan.net/poem42081.html","الكامل"],[105,"هتف النعي فما ملكت بياني","https://www.aldiwan.net/poem42093.html","الكامل"],[105,"أميطي الغيب وادرعي الشهودا","https://www.aldiwan.net/poem42134.html","الوافر"],[105,"هتف الدليل وسار ركب النيل","https://www.aldiwan.net/poem42143.html","الكامل"],[105,"بلغ الدنى فألم غير مسلم","https://www.aldiwan.net/poem43112.html","الكامل"],[105,"بشراك أم حبيبة بمحمد","https://www.aldiwan.net/poem44057.html","الكامل"],[105,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[39,"برت لك حماء العلاط سجوع","https://www.aldiwan.net/poem53769.html","الطويل"],[75,"نظرت كما جلت عقاب على إرم","https://www.aldiwan.net/poem69035.html","الطويل"],[75,"قد مررنا على مغانيك تلك","https://www.aldiwan.net/poem69052.html","الطويل"],[48,"عفا المصلى وأقوت الكثب","https://www.aldiwan.net/poem10767.html","المنسرح"],[48,"أنعت كلبا مرهفا خميصا","https://www.aldiwan.net/poem64360.html","الرجز"],[50,"مللت مبيتي بالقرين وشاقني","https://www.aldiwan.net/poem63905.html","الطويل"],[46,"البابلية باب كل بلية","https://www.aldiwan.net/poem22354.html","الكامل"],[46,"أيا ديك عدت من أياديك صيحة","https://www.aldiwan.net/poem23291.html","الطويل"],[76,"هتك الحجاب عن الضمائر","https://www.aldiwan.net/poem39327.html","مجزوء الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85570","الخفيف"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125571","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39594","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39548","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39563","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39654","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39543","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39590","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42702","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42670","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42599","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54285","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54310","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54275","الطويل"],[106,"تحية وتقدير","https://www.poetsgate.com/ViewPoem.aspx?id=179700",""],[106,"شيخ القضاة","https://www.poetsgate.com/ViewPoem.aspx?id=179683",""],[106,"أدب الوزراء","https://www.poetsgate.com/ViewPoem.aspx?id=179506",""],[106,"هل عاد قيس؟","https://www.poetsgate.com/ViewPoem.aspx?id=179386",""],[106,"على الأعراف","https://www.poetsgate.com/ViewPoem.aspx?id=179633",""],[106,"زورق في الفضاء","https://www.poetsgate.com/ViewPoem.aspx?id=179453",""],[106,"مولد الهادي الأمين","https://www.poetsgate.com/ViewPoem.aspx?id=179620",""],[18,"أليلتنا بذي حسم أنيري","https://www.poetsgate.com/ViewPoem.aspx?id=27758",""],[90,"يا بدرداجيَة الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179157",""],[90,"أنا !","https://www.poetsgate.com/ViewPoem.aspx?id=179156",""],[90,"يدي هذه رهن","https://www.poetsgate.com/ViewPoem.aspx?id=179108",""],[45,"لا تكمل اللذات إلا","https://www.poetsgate.com/ViewPoem.aspx?id=31164",""],[51,"أنَّى هجوتَ بني ثوابَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=26855",""],[18,"أليلتنا بذي حسمٍ أنيري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26445&r=&rc=11",""]],"verses":[["هَتَفَ الحِمامُ بِهِ فَكانَ وَصاتَهُ","بَذلُ الرَغائِبِ وَاِحتِمالُ المَغرَمِ",0,"م",1,0],["هَتَفَ العَلاءُ بِهِم إِلى غاياتِهِ","فَتَضَرَّعَ القَومُ اللِئامُ وَأَسرَعوا",1,"ع",3,0],["هَتَفَ الرَدى بِجَميعِهِم فَتَتابَعوا","طَلقَ العُطاسِ بَني أَبٍ وَبَني أَبِ",2,"ب",1,0],["هَتَكتُ فُروجَهُ بِالرُمحِ لَمّا","دَعَوا بِاِسمي وَيا لَكَ مِن مُجيبُ",3,"ب",1,0],["هَتَكتُ في الأُدمِ سُتورَ الهَوى","وَلَذَّةُ العاشِقِ في الهَتكِ",4,"ك",1,0],["هَتّى تَكَنَّفَني الواشونَ فَاِفتُلِتَت","لا تَأمَنَن رَبَداً مِن غِشِّ مُكتَنِفِ",5,"ف",1,0],["هَتَفتَ بِها مَرَّةً في الهَجيرِ","فَكادَ يَدِبُّ إِلَيكَ الشَجَر",6,"ر",1,0],["هَتَفَنَ تحتَ اللّيالي باسمِه شَغَفاً","وللحِسانِ تَمّنٍّ في لَياليها",7,"ي",3,0],["هَتوفاً إِذا ذاقَها النازِعونَ","سَمِعتَ لَها بَعدَ حَبضٍ عِثاثا",8,"ث",2,0],["هَتَفَ الخِيارُ غَداةَ أُدرِكَ روحُهُ","بِمُجاشِعٍ وَأَخو حُتاتٍ يَسمَعُ",9,"ع",1,0],["هَتْماً لفيك أما تَخَيْ","يَرَ ما يشوبُ بهِ لُعابهْ",10,"ب",2,0],["هَتَكَتْ ضرطتُهُ سِتْ","ر أبيه من بعيدِ",11,"د",1,0],["هَتَفْتُ للدهرِ باسمِ قاسِمهِ","فانْهَزَمَ الدهرُ وهْو في شِكَكهْ",12,"ك",2,0],["هَتَك الشيبُ ذلك السِّتْرَ لي عن","ه فزال العمى وراح التعامي",13,"م",2,0],["هَتوفٌ مِنَ المُلسِ المُتونِ يَزينُها","رَصائِعُ قَد نيطَت إلَيها وَمِحمَلُ",14,"ل",1,0],["هتف العراق مرحبا","بأئمة الادب الصميم",15,"م",1,1],["هتفت فانصتت الطيور لصوتها","ورقاء تخفى جسمها الافنان",16,"ن",1,0],["هتك الردى من حسنه وبهائه","بالليل ما نسجت يد الإصباح",17,"ح",1,0],["هَتَكَ الزَمانُ حِجابَهُم وَأَزالَهُم","بَعدَ الصِيانِ إِزالَةَ الأَسرارِ",18,"ر",1,0],["هَتَكوا بِأَيديهِم مُلاءَةَ فَخرِهِم","مَوشِيَّةً بِمَواهِبِ الفَتّاحِ",19,"ح",1,0],["هَتَفَ النُعاةُ ضُحىً فَأَوصَدَ دونَهُم","جُرحُ الرَئيسِ مَنافِذَ الأَسماعِ",20,"ع",1,0],["هَتَفَ الرُواةُ الحاضِرونَ بِشِعرِهِ","وَحَذا بِهِ البادونَ في البَيداءِ",21,"ا",2,0],["هَتَكَ الحِمايَةَ وَالرِجالَ وَراءَها","يَتَلَمَّسونَ لَها السُتورَ رِياءَ",22,"ا",2,0],["هَتَكَ الحِجالَ عَلى الحَضا","رَةِ وَالخُدورَ عَلى الفُنون",23,"ن",1,0],["هَتَكَت عِزَّةَ الحِجابِ وَفَضَّت","سُدَّةَ البابِ مِن سَميرٍ وَأُنسِ",24,"س",1,0],["هُتِكَت غَيابَتُها بِأَبيَضَ ماجِدٍ","فَكَأَنَّما هُتِكَت بِأَبيَضَ قاضِبِ",25,"ب",1,0],["هَتَكنا إِلَيهِ حِجابَ الدُجى","بِخَوصٍ تَبارى بِرُكبانِها",26,"ن",3,0],["هُتِمَت قَريبَةُ يا أَخا الأَنصارِ","فَاِغضَب لِعِرسِكَ أَن تُرَدَّ بِعارِ",27,"ر",1,1],["هَتونُ جودٍ سَماحُ راحَتِهِ","جارَ عَلى مالِهِ فَأَفناهُ",28,"ا",2,0],["هَتَكَت أَنوارُها سِترَ الدُجى","بِصِفاحٍ خَرَّقَ اللَيلَ سَناها",29,"ا",3,0],["هتف القلب وقد حدثتني","أيّ ماضٍ كشفت لي شفتاها",30,"ا",3,0],["هتفت بي النفس فلنمض إلى","ذلك الورد الكريم الطيب",31,"ب",1,0],["هتكتِ عن روحي خفي النقاب","فلم يزل يا ليل هذا الحجاب",32,"ب",1,0],["هتفتُ وقد بدت مصر لعيني","رفاقي تلك مصر يا رفاقي",33,"ق",2,1],["هَتَّكتُ ديني فَاِستَتَرتُ بِتَوبَةٍ","فَأَنا المُقِرُّ بِذَنبِهِ التَوّابُ",34,"ب",1,0],["هَتَكَت سِترَ سَلوَتي","كَفُّ حُبِّيكَ فَاِنهَتَك",35,"ك",1,0],["هَتَكَت عَجاجَتَهُ القَنا عَن وامِقٍ","أَهدى الطِعانُ لَهُ خَليقَةَ قالِ",36,"ل",1,0],["هَتَكَ الظَلامَ أَبو الوَليدِ بِغُرَّةٍ","فَتَحَت لَنا بابَ الرَجاءِ المُقفَلِ",37,"ل",1,0],["هتف الدّاعي فلبَّى واعتزمْ","ومضَى يَلقَى العِدَى في المُزدَحَمْ",38,"م",1,1],["هَتفَ البشيرُ به وحَانَ الحينُ","فأَضاءَ وَجهٌ واسْتنارَ جَبينُ",39,"ن",1,1],["هَتَفَ العقلُ وقامَ الحَقُّ في","جَاههِ العَالي إماماً يَخطبُ",40,"ب",1,0],["هتفوا فأقبل كلُّ غضٍّ ناضرٍ","صُلبِ العزيمةِ يركب الأخطارا",41,"ر",2,0],["هتفتْ تُحيِّي مِصرَ في أتراحها","فَتُخرِّمَتْ وتوالت الأتراحُ",42,"ح",1,0],["هتفَ النعيُّ فما ملكتُ بياني","ليت النعيَّ إلى الإِمام نعاني",43,"ن",2,1],["هتكنا الحُجْبَ والأستارَ عنها","ومزّقْنا المطارفَ والبُرودا",44,"د",2,0],["هَتَفَ الدليلُ وسَارَ ركبُ النّيلِ","بُوركتما من سائرٍ ودليلِ",45,"ل",1,1],["هَتَكَتُ مِنَ العَزَماتِ كُلَّ مُسَرَّدٍ","وَفَرَت مِنَ المُهجاتِ كُلَّ مُلَملَمِ",46,"م",1,0],["هَتَفَ الرسولُ أَجِبْ وكيلَ مُحَمَّدٍ","فمشَى إلى المَلِكِ الأعزِّ الأصيَدِ",47,"د",1,0],["هَتفَ الإمامُ بها فَراحَ يُعيدها","ثُمَّ انْثَنى مُتَلَطِّفَاً يَتَنصَّلُ",48,"ل",1,0],["هَتوفٌ عَوى مِن جانِبَيها مُحَدرَجٌ","مُمَرٌّ كَحُلقومِ القَطاةِ بَديعُ",49,"ع",1,0],["هَتكتُ سُجوفَ الخِدرِ وهو بمَرصَدٍ","فلمّا تَعَارَفْنَا هممتُ به وهَمّ",50,"م",1,0],["هَتَكَ الظُّلمَ والظلامَ به ذو","رَوْعَةٍ لا يَريبُ سِتْراً بهَتْك",51,"ك",1,0],["هَتَكتُ عَنها وَاللَيلُ مُعتَكِرٌ","مُهَلهَلَ النَسجِ ما لَهُ هُدُبُ",52,"ب",1,0],["هَتَّكَ عَن حُجبِ الظِبا قَميصا","فَمَحَّصَت آرائَها تَمحيصا",53,"ص",2,0],["هَتَفنا وَنَوَّهنا بِعُقبَةَ إِنَّهُ","مَعَ النَصرِ مَفروطٌ بِعَمٍّ وَوالِدِ",54,"د",1,0],["هَتَكَت حِجابَ المُحَصَناتِ وَجَشَّمَت","مُهَنَ العَبيدِ تَهَضُّمُ الأَربابِ",55,"ب",1,0],["هَتَفتَ فَقالَ الناسُ أَوسُ بنُ مُعيرٍ","أَو اِبنُ رَباحٍ بِالمَحَلَّةِ قائِمُ",56,"م",1,0],["هتَكَ الحِجابَ عَنِ الضمائرْ","طَرْفٌ به تُبْلى السرائرْ",57,"ر",1,1],["هتف الناس اليوم للعيد طراً","وَبَدا القطر مائجاً رجراجا",58,"ج",2,0],["هتفتُ قف لم يبق إلا القليل","وكل حيٍّ سائرٌ في سبيل",59,"ل",1,0],["هَتَكَ الستارَ مُقنَّعٌ حسناتُه","يخفين خلفَ ريائِهن الذِّيبا",60,"ب",2,0],["هتكت حجابَ الصمتِ عنكَ وربما","هتكتْ غشاءَ المقلةِ العمياءِ",61,"ا",2,0],["هتف المحدِّقُ في مشارقها","ذهبَ النهارُ فريس