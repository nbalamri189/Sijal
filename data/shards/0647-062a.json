","البسيط"],[429,"نغم الأطيار على القضب","https://www.aldiwan.net/poem41430.html","المتدارك"],[432,"جرى في عوده ماء الشباب","https://www.aldiwan.net/poem12568.html","الوافر"],[432,"لم ترض أني قد حرمت وصالها","https://www.aldiwan.net/poem12711.html","الكامل"],[434,"وكم بيضاء مسكي قناها","https://www.aldiwan.net/poem24788.html","الوافر"],[439,"نعم يبشر بدؤها بتمام","https://www.aldiwan.net/poem34866.html","الكامل"],[453,"هتف العابثون بالسلم للسلم","https://www.aldiwan.net/poem61306.html","الخفيف"],[453,"أيها العام الذي","https://www.aldiwan.net/poem61588.html","مجزوء الرمل"],[453,"عيد الضحية مرحبا بك عيدا","https://www.aldiwan.net/poem61686.html","الكامل"],[458,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[458,"نعم هذه يا دهر أم المصائب","https://www.aldiwan.net/poem56291.html","الطويل"],[461,"لمعت كتلويح الرداء المسبل","https://www.aldiwan.net/poem15089.html","الكامل"],[464,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[464,"سقيت دمشق وجارتا جيرونها","https://www.aldiwan.net/poem3549.html","عموديه"],[500,"قف أيها المفتون فينا واتئد","https://www.aldiwan.net/poem37643.html","الكامل"],[515,"نبهتني حمامة بسحير","https://www.aldiwan.net/poem12292.html","الخفيف"],[516,"هتوف الضحى ورقاء يذكرك الهوى","https://www.aldiwan.net/poem48655.html","الطويل"],[551,"ألا غاد دمع العين إن كنت غاديا","https://www.aldiwan.net/poem47140.html","الطويل"],[551,"حييت يا ربع اللوى من مربع","https://www.aldiwan.net/poem47702.html","الكامل"],[558,"طلعت شمسنا على الأفلاك","https://www.aldiwan.net/poem34274.html","الخفيف"],[567,"هتف الصبح بالدجى فاسقنيها","https://www.aldiwan.net/poem69452.html","الخفيف"],[586,"بين بان الحمى وبان المصلى","https://www.aldiwan.net/poem17554.html","الخفيف"]],"verses":[["هَتَفَ الحِمامُ بِهِ فَكانَ وَصاتَهُ","بَذلُ الرَغائِبِ وَاِحتِمالُ المَغرَمِ",0,"م",1,0],["هَتَفَ العَلاءُ بِهِم إِلى غاياتِهِ","فَتَضَرَّعَ القَومُ اللِئامُ وَأَسرَعوا",1,"ع",3,0],["هَتَفَ الرَدى بِجَميعِهِم فَتَتابَعوا","طَلقَ العُطاسِ بَني أَبٍ وَبَني أَبِ",2,"ب",1,0],["هَتَكتُ فُروجَهُ بِالرُمحِ لَمّا","دَعَوا بِاِسمي وَيا لَكَ مِن مُجيبُ",3,"ب",1,0],["هَتَكتُ في الأُدمِ سُتورَ الهَوى","وَلَذَّةُ العاشِقِ في الهَتكِ",4,"ك",1,0],["هَتّى تَكَنَّفَني الواشونَ فَاِفتُلِتَت","لا تَأمَنَن رَبَداً مِن غِشِّ مُكتَنِفِ",5,"ف",1,0],["هَتَفتَ بِها مَرَّةً في الهَجيرِ","فَكادَ يَدِبُّ إِلَيكَ الشَجَر",6,"ر",1,0],["هَتَفَنَ تحتَ اللّيالي باسمِه شَغَفاً","وللحِسانِ تَمّنٍّ في لَياليها",7,"ي",3,0],["هَتوفاً إِذا ذاقَها النازِعونَ","سَمِعتَ لَها بَعدَ حَبضٍ عِثاثا",8,"ث",2,0],["هَتَفَ الخِيارُ غَداةَ أُدرِكَ روحُهُ","بِمُجاشِعٍ وَأَخو حُتاتٍ يَسمَعُ",9,"ع",1,0],["هَتْماً لفيك أما تَخَيْ","يَرَ ما يشوبُ بهِ لُعابهْ",10,"ب",2,0],["هَتَكَتْ ضرطتُهُ سِتْ","ر أبيه من بعيدِ",11,"د",1,0],["هَتَفْتُ للدهرِ باسمِ قاسِمهِ","فانْهَزَمَ الدهرُ وهْو في شِكَكهْ",12,"ك",2,0],["هَتَك الشيبُ ذلك السِّتْرَ لي عن","ه فزال العمى وراح التعامي",13,"م",2,0],["هَتوفٌ مِنَ المُلسِ المُتونِ يَزينُها","رَصائِعُ قَد نيطَت إلَيها وَمِحمَلُ",14,"ل",1,0],["هتف العراق مرحبا","بأئمة الادب الصميم",15,"م",1,1],["هتفت فانصتت الطيور لصوتها","ورقاء تخفى جسمها الافنان",16,"ن",1,0],["هتك الردى من حسنه وبهائه","بالليل ما نسجت يد الإصباح",17,"ح",1,0],["هَتَكَ الزَمانُ حِجابَهُم وَأَزالَهُم","بَعدَ الصِيانِ إِزالَةَ الأَسرارِ",18,"ر",1,0],["هَتَكوا بِأَيديهِم مُلاءَةَ فَخرِهِم","مَوشِيَّةً بِمَواهِبِ الفَتّاحِ",19,"ح",1,0],["هَتَفَ النُعاةُ ضُحىً فَأَوصَدَ دونَهُم","جُرحُ الرَئيسِ مَنافِذَ الأَسماعِ",20,"ع",1,0],["هَتَفَ الرُواةُ الحاضِرونَ بِشِعرِهِ","وَحَذا بِهِ البادونَ في البَيداءِ",21,"ا",2,0],["هَتَكَ الحِمايَةَ وَالرِجالَ وَراءَها","يَتَلَمَّسونَ لَها السُتورَ رِياءَ",22,"ا",2,0],["هَتَكَ الحِجالَ عَلى الحَضا","رَةِ وَالخُدورَ عَلى الفُنون",23,"ن",1,0],["هَتَكَت عِزَّةَ الحِجابِ وَفَضَّت","سُدَّةَ البابِ مِن سَميرٍ وَأُنسِ",24,"س",1,0],["هُتِكَت غَيابَتُها بِأَبيَضَ ماجِدٍ","فَكَأَنَّما هُتِكَت بِأَبيَضَ قاضِبِ",25,"ب",1,0],["هَتَكنا إِلَيهِ حِجابَ الدُجى","بِخَوصٍ تَبارى بِرُكبانِها",26,"ن",3,0],["هُتِمَت قَريبَةُ يا أَخا الأَنصارِ","فَاِغضَب لِعِرسِكَ أَن تُرَدَّ بِعارِ",27,"ر",1,1],["هَتونُ جودٍ سَماحُ راحَتِهِ","جارَ عَلى مالِهِ فَأَفناهُ",28,"ا",2,0],["هَتَكَت أَنوارُها سِترَ الدُجى","بِصِفاحٍ خَرَّقَ اللَيلَ سَناها",29,"ا",3,0],["هتف القلب وقد حدثتني","أيّ ماضٍ كشفت لي شفتاها",30,"ا",3,0],["هتفت بي النفس فلنمض إلى","ذلك الورد الكريم الطيب",31,"ب",1,0],["هتكتِ عن روحي خفي النقاب","فلم يزل يا ليل هذا الحجاب",32,"ب",1,0],["هتفتُ وقد بدت مصر لعيني","رفاقي تلك مصر يا رفاقي",33,"ق",2,1],["هَتَّكتُ ديني فَاِستَتَرتُ بِتَوبَةٍ","فَأَنا المُقِرُّ بِذَنبِهِ التَوّابُ",34,"ب",1,0],["هَتَكَت سِترَ سَلوَتي","كَفُّ حُبِّيكَ فَاِنهَتَك",35,"ك",1,0],["هَتَكَت عَجاجَتَهُ القَنا عَن وامِقٍ","أَهدى الطِعانُ لَهُ خَليقَةَ قالِ",36,"ل",1,0],["هَتَكَ الظَلامَ أَبو الوَليدِ بِغُرَّةٍ","فَتَحَت لَنا بابَ الرَجاءِ المُقفَلِ",37,"ل",1,0],["هتف الدّاعي فلبَّى واعتزمْ","ومضَى يَلقَى العِدَى في المُزدَحَمْ",38,"م",1,1],["هَتفَ البشيرُ به وحَانَ الحينُ","فأَضاءَ وَجهٌ واسْتنارَ جَبينُ",39,"ن",1,1],["هَتَفَ العقلُ وقامَ الحَقُّ في","جَاههِ العَالي إماماً يَخطبُ",40,"ب",1,0],["هتفوا فأقبل كلُّ غضٍّ ناضرٍ","صُلبِ العزيمةِ يركب الأخطارا",41,"ر",2,0],["هتفتْ تُحيِّي مِصرَ في أتراحها","فَتُخرِّمَتْ وتوالت الأتراحُ",42,"ح",1,0],["هتفَ النعيُّ فما ملكتُ بياني","ليت النعيَّ إلى الإِمام نعاني",43,"ن",2,1],["هتكنا الحُجْبَ والأستارَ عنها","ومزّقْنا المطارفَ والبُرودا",44,"د",2,0],["هَتَفَ الدليلُ وسَارَ ركبُ النّيلِ","بُوركتما من سائرٍ ودليلِ",45,"ل",1,1],["هَتَكَتُ مِنَ العَزَماتِ كُلَّ مُسَرَّدٍ","وَفَرَت مِنَ المُهجاتِ كُلَّ مُلَملَمِ",46,"م",1,0],["هَتَفَ الرسولُ أَجِبْ وكيلَ مُحَمَّدٍ","فمشَى إلى المَلِكِ الأعزِّ الأصيَدِ",47,"د",1,0],["هَتفَ الإمامُ بها فَراحَ يُعيدها","ثُمَّ انْثَنى مُتَلَطِّفَاً يَتَنصَّلُ",48,"ل",1,0],["هَتوفٌ عَوى مِن جانِبَيها مُحَدرَجٌ","مُمَرٌّ كَحُلقومِ القَطاةِ بَديعُ",49,"ع",1,0],["هَتكتُ سُجوفَ الخِدرِ وهو بمَرصَدٍ","فلمّا تَعَارَفْنَا هممتُ به وهَمّ",50,"م",1,0],["هَتَكَ الظُّلمَ والظلامَ به ذو","رَوْعَةٍ لا يَريبُ سِتْراً بهَتْك",51,"ك",1,0],["هَتَكتُ عَنها وَاللَيلُ مُعتَكِرٌ","مُهَلهَلَ النَسجِ ما لَهُ هُدُبُ",52,"ب",1,0],["هَتَّكَ عَن حُجبِ الظِبا قَميصا","فَمَحَّصَت آرائَها تَمحيصا",53,"ص",2,0],["هَتَفنا وَنَوَّهنا بِعُقبَةَ إِنَّهُ","مَعَ النَصرِ مَفروطٌ بِعَمٍّ وَوالِدِ",54,"د",1,0],["هَتَكَت حِجابَ المُحَصَناتِ وَجَشَّمَت","مُهَنَ العَبيدِ تَهَضُّمُ الأَربابِ",55,"ب",1,0],["هَتَفتَ فَقالَ الناسُ أَوسُ بنُ مُعيرٍ","أَو اِبنُ رَباحٍ بِالمَحَلَّةِ قائِمُ",56,"م",1,0],["هتَكَ الحِجابَ عَنِ الضمائرْ","طَرْفٌ به تُبْلى السرائرْ",57,"ر",1,1],["هتف الناس اليوم للعيد طراً","وَبَدا القطر مائجاً رجراجا",58,"ج",2,0],["هتفتُ قف لم يبق إلا القليل","وكل حيٍّ سائرٌ في سبيل",59,"ل",1,0],["هَتَكَ الستارَ مُقنَّعٌ حسناتُه","يخفين خلفَ ريائِهن الذِّيبا",60,"ب",2,0],["هتكت حجابَ الصمتِ عنكَ وربما","هتكتْ غشاءَ المقلةِ العمياءِ",61,"ا",2,0],["هتف المحدِّقُ في مشارقها","ذهبَ النهارُ فريسةَ الليلِ",62,"ل",1,0],["هتف القلبُ بالمنادينَ حولي","لَقِيَ الصادحُ الطروبُ حمامَه",63,"م",2,0],["هتفَ البشيرُ به فماجتْ أعصرٌ","وتلفّتتْ أممٌ ودارتْ أنجمُ",64,"م",1,0],["هتفوا بمجدِكَ واستخفّ وقارَهمْ","أملٌ يجلُّ عن الهتافِ ويعظمُ",64,"م",1,0],["هتفتْ بي ويداها في يدي","تدفع الكأسَ بإغراءِ وعُجْبِ",65,"ب",1,0],["هتفت بي تراكَ من أنتَ يا صا","حِ فقلتُ المعذَّب الملتاحُ",66,"ح",1,0],["هتفتَ بها حيَّا فلا تألُ خالداً","هُتافكَ وانفضْ عنكَ صمْتَ المقابرِ",67,"ر",1,0],["هَتَفَ الدِّيكُ سُحْرَةً","فَاصْطَبَحْنَا لِهَتْفِهِ",68,"ه",1,1],["هَتَكْتُ بِهَا سُتُورَ اللَّيْلِ حَتَّى","خَرَجْتُ مِنَ السَّوَادِ إِلَى البَيَاضِ",69,"ض",1,0],["هَتَفْنَ فَأَطْرَبْنَ القُلُوبَ كَأَنَّمَا","تَعَلَّمْنَ أَلْحَانَ الصَّبَابَةِ مِنْ شِعْرِي",70,"ر",2,0],["هَتَكَتْ قَريحَتُهُ السُّجُوفَ وَأَقْبَلَتْ","تَسْبِي خَبَايَا النَّفْسِ كلَّ سِبَاءِ",71,"ا",2,0],["هَتَفَ الْمَجْدُ بِاسْمِهِ وَاسْتَضَاءَتْ","بِسنَاهُ زَعَامَةُ الزُّعَمَاءِ",72,"ا",2,0],["هتفتْ لمَوْلِدِ كابرٍ","لمُطَهَّرِ الأنسابِ كابرْ",73,"ر",1,0],["هتفتْ بفاروقٍ أجَ","لِّ مُمَلَّكِ وأعزِّ ناصرْ",73,"ر",1,0],["هُتَافٌ مِنَ الْحُبِّ الصَّميمِ انْبِعاثُهُ","تُرَدِّدُهُ أَصْدَاؤهُ وتُرَجِّعُ",74,"ع",1,0],["هتفوا بذكر أغرَّ نابه","عَمرُو بنُ بحرٍ في ثيابه",75,"ب",2,1],["هَتفَتْ شمائلُهُ بملءِ لَهاتِها","تَرثيه قبل هُتافنا برثائه",76,"ا",3,0],["هتفوا بَهيكلٍ الوزيرِ، وإنما","حيَّيْتُه رجلاً إلى الأدب انتمى",77,"م",2,1],["هتَفت به الهيفَاءُ، وهْ","يَ بخدْرها عند السَّحر",78,"ر",1,0],["هتفوا لزيد بالحياة وخالدٍ","لكنْ وقفتُ على الجلاء هُتافي!",79,"ف",2,0],["هتف الخلقُ للعلوم زمانًا","وانْجَلى برقها فكان سرابا",80,"ب",2,0],["هَتَفَتُ باسمِهِ حليمُة طفلاً","فغدَا في فمِ الزمانِ نشيدا",81,"د",2,0],["هتاف هتاف وماج الصدى","وأرغى هنا وهنا أزبدا",82,"د",2,1],["هتكت به بيوت بني عباد","وبعض القتل أشفى للصدور",83,"ر",1,0],["هتفوا فأسنَدَتِ اليدانِ ضلوعي","وشَرِقتُ بالحسراتِ قبلَ دُموعي",84,"ع",2,1],["هتفت لي الأهوال تطلُبني","فبرزتُ حراً غيرَ منتقِب",85,"ب",1,0],["هتفتُ وما أنفك أهتِف صارخاً","ولو حرّموا مسِّي ولو حلَّلوا دمي",86,"م",2,0],["هتك الستور، وإنما الل","لذات في هتك الستور",87,"ر",1,0],["هتكت حجاب الصّمت بيني وبينها","(بشبّابة) سكرى الحنين خلوب",88,"ب",1,0],["هتك الفضائح بعد صون وانتضى","للمالكين بيانه المصقولا",89,"ل",2,0],["هتف الهاتفون : أين رياض","فانتخى في الثرى حسام صقيل",90,"ل",1,0],["هَتْماً لفيك فما تخيْ","يَرَ ما يشوبُ به لُعابهْ",91,"ب",2,0],["هتكت عزة الحجاب وفضت","سدة الباب من سمير وأنسي",92,"س",2,0],["هتكوا حرمة العرين فهاجوا","أسدا دامي البراثن وردا",93,"د",2,0],["هَتَكْتُ بِهِ بُيُوتَ بَنِي عُبَادٍ","وَبَعْضُ الغَشْمِ أَشْفَى لِلصُّدُورِ",94,"ر",1,0],["هتكت حجاب الصذمت عنك وربما","هتكت غشاء المقلة العمياء",95,"ا",2,0],["هتفت بها حيّا ، فلا تأل خالدا","هتافك ، وانقض عنك صمت المقابر",96,"ر",1,0],["هتف القلب بالمنادين حولي","لقي الصّداح الطّروب حمامه",97,"م",2,0],["هتكُ عرضٍ نهبُ أرضٍ شنقُ بعضٍ","لم تُحرِّك غَضَبَه",98,"ه",1,0],["هَتَفتَ فَهِجتَ لي شَوقاً فَقُل لِي","حَمامٌ أَنتَ وَيحَكَ أَم حِمامُ",99,"م",1,0],["هتّانَةُ الهَطْلِ من طُلابِها اقْتَرَبَتْ","كَأَنَّها دِيَمٌ تَدْنو وتَنْهَمِرُ",100,"ر",1,0],["هَتَفَتْ تُبَشِّرُ بِالضُّحى الأَطيارُ","فَاِستَيقَظَت لِهُتافِها الأَزهارُ",101,"ر",1,1],["هتكنا حجاب السر في الحب دونه","نمائمُ بالقول الأثيم تلفّق",102,"ق",1,0],["ةتم ما قصدت فاعذرنا سجا","سبع وعشر عمره ياذا 