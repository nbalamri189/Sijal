{"poems":[[55,"بمجال عزمي يملأ الملوان","https://www.aldiwan.net/poem29659.html","الكامل"],[95,"صدق النعي وردد الهرمان","https://www.aldiwan.net/poem11225.html","الكامل"],[32,"أقول لنفسي واقفا عند مشرف","https://www.aldiwan.net/poem29553.html","الطويل"],[32,"يا دار مية بالخلصاء غيرها","https://www.aldiwan.net/poem29593.html","البسيط"],[74,"بشراك إن السرى والعود مبرور","https://www.aldiwan.net/poem18707.html","البسيط"],[53,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[53,"يا من هواه من القلوب مكين","https://www.aldiwan.net/poem66463.html","الكامل"],[107,"هذا الدفاع وهذه الأجناد","https://www.aldiwan.net/poem42120.html","الكامل"],[107,"هو الخطب حتى ينكر التاج صاحبه","https://www.aldiwan.net/poem43380.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55175","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54981","الكامل"],[92,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[92,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[96,"أيّكما الرّبيع","https://www.poetsgate.com/ViewPoem.aspx?id=15635",""],[132,"كتب الحسن في محياك سطرا","https://www.aldiwan.net/poem50510.html","الخفيف"],[133,"حدث الشاعر عن نور القمر","https://www.aldiwan.net/poem60382.html","الرمل"],[139,"أعيذك من شر الحوادث يا مصر","https://www.aldiwan.net/poem49038.html","الطويل"],[154,"صدروا وسحر لحاظهم يغريني","https://www.aldiwan.net/poem68480.html","الكامل"],[154,"يا سيد الرسل المكين مكانه","https://www.aldiwan.net/poem68545.html","الكامل"],[161,"هكذا الدنيا","https://www.aldiwan.net/poem23648.html","المنسرح"],[214,"شمس المنازل قد أنارت بالفرح","https://www.aldiwan.net/poem13556.html","الكامل"],[244,"لمقامك التعظيم والتبجيل","https://www.aldiwan.net/poem23840.html","الكامل"],[305,"ثكلى عوان بدوار مؤلفة","https://www.aldiwan.net/poem45499.html","البسيط"],[325,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[376,"أخيلت للصب أشواقه","https://www.aldiwan.net/poem57270.html","الطويل"],[458,"عيدان عيد تحرر وتفاؤل","https://www.aldiwan.net/poem61377.html","الكامل"],[463,"أمن أسماء والمسرى بعيد","https://www.aldiwan.net/poem56226.html","الوافر"],[520,"بصعود منزلة وجد صاعد","https://www.aldiwan.net/poem12058.html","الكامل"],[567,"عنوان كل مديح راسخ القدم","https://www.aldiwan.net/poem52884.html","البسيط"],[569,"عنوان مجدك ظاهر وضاح","https://www.aldiwan.net/poem833.html",""],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126812","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122754","البسيط"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199595","المسحوب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38954","السريع"],[1001,"","https://poetry.dctabudhabi.ae/diwan/poem/100566","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59260","الرمل"],[1224,"","https://poetry.dctabudhabi.ae/diwan/poem/130640","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46522","الرجز"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48974","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127999","البسيط"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66285","الكامل"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113731","الكامل"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199824","المسحوب"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93651","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87326","الرجز"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74336","الرمل"],[3148,"","https://poetry.dctabudhabi.ae/diwan/poem/203636","الكامل"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216545",""],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89110","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52997","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109972","الرمل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110005","الرجز"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76458","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125824","الكامل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199108","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36685","الدوبيت"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36567","الدوبيت"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136818",""],[4728,"رسالة من غريب (هلالي قصير)","https://www.poetsgate.com/ViewPoem.aspx?id=176996",""],[4755,"لَيلٌ دَقَائِقُهُ سَمِيكةْ","https://www.poetsgate.com/ViewPoem.aspx?id=205604",""],[4767,"سيف الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=215269",""],[4869,"المدينه المنوره ....","https://www.poetsgate.com/ViewPoem.aspx?id=151715",""],[4883,"بنت_تهز الأسئله","https://www.poetsgate.com/ViewPoem.aspx?id=48368",""],[4927,"جرائم الديكتاتورية","https://www.poetsgate.com/ViewPoem.aspx?id=80801",""],[4984,"يوم المجاهد","https://www.poetsgate.com/ViewPoem.aspx?id=181624",""],[5002,"القصيدة الباكية","https://www.poetsgate.com/ViewPoem.aspx?id=204939",""],[5045,"سجل حديث النصر","https://www.poetsgate.com/ViewPoem.aspx?id=185179",""],[5092,"عزفٌ على وتر الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=176564",""],[5122,"الدرة اللي تلبس اللماسي","https://www.poetsgate.com/ViewPoem.aspx?id=27279",""],[5150,"ارحلْ ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203386",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5198,"روشان","https://www.poetsgate.com/ViewPoem.aspx?id=139895",""],[5281,"قانون الصُّحبة","https://www.poetsgate.com/ViewPoem.aspx?id=199349",""],[5358,"همسات القدر","https://www.poetsgate.com/ViewPoem.aspx?id=21894",""],[5362,"نشرت ذوائبها على الارض","https://www.poetsgate.com/ViewPoem.aspx?id=170389",""],[5376,"ما زال قلبي من الهجران يلتاعُ","https://www.poetsgate.com/ViewPoem.aspx?id=188291",""],[5461,"رد على قصيدة من محمد بن راشد","https://www.poetsgate.com/ViewPoem.aspx?id=5069",""],[5465,"ظهر الحق واستبان مضيا","https://www.poetsgate.com/ViewPoem.aspx?id=98443",""],[5472,"أضحى السّهاد له إلفا وما ظلما","https://www.poetsgate.com/ViewPoem.aspx?id=200478",""],[5756,"رثاء الشيخ زايد","https://www.poetsgate.com/ViewPoem.aspx?id=8433",""],[5776,"النّهرُ العيّاب","https://www.poetsgate.com/ViewPoem.aspx?id=199331",""],[402,"صدق النعي ورددد الهرمان","https://www.poetsgate.com/ViewPoem.aspx?id=36491",""],[5894,"عذب المحبة في جمالك مجمع","https://www.poetsgate.com/ViewPoem.aspx?id=131427",""],[5997,"عَصْفُ رِيْح","https://www.poetsgate.com/ViewPoem.aspx?id=214286",""],[6056,"منثور الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=130519",""],[6068,"حكمية","https://www.poetsgate.com/ViewPoem.aspx?id=186093",""],[773,"مبنى أغر وليلة غراء","https://www.poetsgate.com/ViewPoem.aspx?id=134917",""],[6093,"يَا هَاجِريْ ! عينٌ لبَعْضيَ أنكرتْ ( الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=176195",""],[549,"توبة في محراب النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=203000",""],[6212,"أميرة الماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1629&r=&rc=10",""],[6320,"حَائِطُ الشَّجَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83619&r=&rc=0",""]],"verses":[["عُنوانُ بِأَسي أَن يَصولَ مُهَنَّدي","وَرَدى عَدُوّي أَن يَطولَ لِساني",0,"ن",2,0],["عُنْوَنَ نَهْضَتِهَا وَخَيْرُ مُحَصَّلٍ","مِنْ مَجْدِهَا فِي ذَلِكَ العُنْوَانِ",1,"ن",1,0],["عَنودٌ النَوى حُلّالَةٌ حَيثُ تَلتَقي","جَمادٌ وَشرقِيّاتُ رَملِ الشَقائِقِ",2,"ق",1,0],["عَن واضِحٍ ثَغرُهُ حوٍّ مَراكِزُهُ","كَالأُقحُوانِ زَهَت أَحقافُهُ الزَهَرا",3,"ر",2,0],["عنوان بشرك يولي اليسر كلُّ يدٍ","معجّلاً فإذا العنوان تيسير",4,"ر",1,0],["عن وجوهٍ كأَنهنَّ شموسٌ","وبدورٌ طلعنَ غبَّ سحابِ",5,"ب",1,0],["عنوانُ معروفٍ يكون وراءه","بَدءٌ وعَوْد من جداك ثخين",6,"ن",1,0],["عُنوانُها والحادثاتُ هَوادةٌ","ومثالُها والحادثاتُ جِلادُ",7,"د",1,0],["عُنوا بِوُلاةِ السوءِ فَالشَعبُ سِلعَةٌ","بِأَيديهمو وَالمُلكُ فَوضى مَناصِبُه",8,"ب",2,0],["عُنْوَانُ فَخْرِ الْفَتَاةِ شَعْرٌ","يَقُولُ رَائِيهِ مَا أُحَيلَى",9,"ل",2,1],["عُنْوَانُهَا المُزْدَانُ بِاسْمِ سَمِيِّهِ","فِيهِ القُبُولُ لَدَى المَقَامِ الأَقْدَسِ",10,"س",1,0],["عنودٌ ، تأبَّى الوَثْبَ في نكَساتهِ","من الكِبْرِ ، لولا أنْ تُطاردَهُ وَثَبْا",11,"ب",2,0],["عن واهبينَ حياتَهم ، ما استُعبِدوا","للشاكرين ، ولم يَذُموا الجْاحدا",12,"د",2,0],["عنوا للخائنين ودلّلوهم","وما بالوا بأرحام تضيع",13,"ع",1,0],["عنون الكون فيه صورة قوسٍ","مَنْ مِنَ العَالَمَينَ مِنهُ سَليمُ",14,"م",1,0],["عن وكم من أنَّةٍ في وَتَري","في صَداها عَنعَناتٌ عن خَبَر",15,"ر",1,0],["عُنوا باتباع المجد حتى عَلا لهم","على المشتري قدرٌ وسار لهم ذكْرُ",16,"ر",1,0],["عنوان ما أخفاه من أخلاقه","بشر يلوح بوجهه الميمون",17,"ن",1,0],["عنوانُ طِرسِ الأنبياءِ وخَتمُهُ","والطرس يُكمِلُ حُسنَهُ عنوانُهُ",18,"ن",2,0],["عُنْوَانُهَا المَكْرُ فِي تَلَوُّنِهَا","إِنْ أظْهَرَتْ حُسْنًا أَبْطَنَتْ بَغْيَا",19,"ي",2,0],["عن وجهه الضحاك يروى بشره","ويمينه عنها حديث الفضل صح",20,"ح",1,0],["عنوانُ مجدِ العرب منقذ عزهم","بوقائعٍ غُررٍ لهنَّ حجول",21,"ل",1,0],["عَن واضِحِ اللَوانِ كَالدينارِ مُنجَدِلٍ","لَم تَخشَ إِنساً وَلَم تَتَرُك بِهِ وَصَبا",22,"ب",2,0],["عُنوانَ مِقدارِهِ مِن قَبلِ بِعثَتُهُ","في مُلكِ كِسرى بَدَت كَالشَمسِ آيَتُهُ",23,"ت",2,0],["عَنوَن قِرطاساً طَواهُ عَلى","قَوادِحٍ فيهنَّ حُرَّاقُهُ",24,"ق",2,0],["عنوانها الشورى ولب لبابها","صون الحقوق وعزّة الأفراد",25,"د",1,0],["عُنُوا بثراك واغترسوك حتّى","بسقتَ على العِضاةِ وأنت عودُ",26,"د",1,0],["عن واحد هو النبي تفرعوا","وكذا الألوف تفرعت عن واحد",27,"د",1,0],["عُنوانُ كلِّ مديحٍ راسخِ القَدَمِ","تَرْكُ التَغَزُّلِ والتمويهِ في الكَلِمِ",28,"م",1,1],["عنوان مجدك ظاهر وضاح","شرف يزيد كأنه الإصباح",29,"ح",1,1],["عن واجب الحق على المحق","بجمعهم من حجة في الحق",30,"ق",1,0],["عنوده بغير ما تكلف","والله كافي كل من لا يكتفي",30,"ي",1,0],["عن وَصفِك الشعراء يا مدّثّر","عَجزوا وكلّوا عن صفات علاكا",31,"ك",2,0],["عِنوانُ ما بَلَغَت شُهبُ البُزاةِ بِهٍِ","في العُربِ ما بَلَغ الغِربانُ والرُّخمُ",32,"م",1,0],["عن وصلهم لا بدّي","في سعود من الليال",33,"ل",1,0],["عَن وَجدِهِ حَدِّثْ بِدونِ اِختِصار","وَأَفْنِ بِالتّحديثِ عَنهُ الدّهور",34,"ر",1,0],["عنوا له إذ ذاك لكن القلو","ب دب فيها وغر قد ألهبا",35,"ب",2,0],["عَنْ وِشَاحِ البَرْقِ عَنْ عِقْدِ الحَيَا","عَنْ حُلِيِّ الدر عَنْ تَاجِ الجَمَالْ",36,"ل",1,0],["عن وقع كل ملمةٍ","لي من مكارمه مفاخر",37,"ر",1,0],["عَن وَكرِهِ وَالليل وَالسحاب","فَحارَ إِذ أَعوزه الذهاب",38,"ب",1,0],["عُنودُها أقتلُ لي منَ الشَّجى","شَوقي إِلَى قَبرِ النَّبيِّ الأوحدِ",39,"د",1,0],["عُنُوسُهَا وَهوَ يَزِيدُ قَدرَهَا","مُطَيِّباً بَينَ السُّقَاةِ ذِكرَهَا",39,"ه",2,0],["عنوانه سوقُ الغرامِ ووصفه","طيرٌ أصابتهُ يدُ الصياد",40,"د",1,0],["عن وصفها وسناها همتى قصرت","فرحت أسحب ذيل العى والحصر",41,"ر",1,0],["عنوان بدرٍ حين أرخه بدى","شيد العريش على أساس محكم",42,"م",1,0],["عن وجهِها في غالبِ الأس","فار أسفَرَ من سَفَر",43,"ر",1,0],["عن وصل غيرك والله أنّي","شلّيت بشراع أو مياني",44,"ن",2,0],["عنوانه هذا الكتاب من عزي","ز راحم لفلان ابن فلان",45,"ن",1,0],["عَن وَجه أَحمَد طالَما كَشف المحن","يا صارِماً لَم يَنب شفرته المجن",46,"ن",1,0],["عن وَجه من صلّى بقَبضَتين","صَلى على هَذا لِيَقضيَ الَّين",47,"ن",1,0],["عَن وَفاء وَعَفاف","لذ بِهِ إِن رُمت أَمنا",48,"ن",2,0],["عن ورد وجنته بآس عذاره","وبسيف نرجسِ طرفه الساجي حمى",49,"م",2,0],["عن وَصْلْ مَحْبوبِي فَلاَبِدّ","لو دون وَصْلَهْ سِتِرْ وْحْجَاب",50,"ب",1,0],["عن وصفه لا تخبرنّي إنه","خبر وإن أسهبت دون المَخبَر",51,"ر",1,0],["عنوانُ أنواعِ الفلاح","في مِصرَ صار مخَّلدا",52,"د",2,0],["عن وناسة بطرسَ الهامِ الهُما","مِ العظيم القَدرِ قَدرٍ ذي قَدَرَ",53,"ر",1,0],["عُنوانَ ما لغيرها","وكذَّبَت حقائقَه",54,"ق",2,0],["عنوانكم في بحور البؤس منغمس","مسكين اني له ان يغلب اللججا",55,"ج",2,0],["عَنَوتَ فَلا تَرعَوي لِمَقالِ","أَأَنتَ سَبوقٌ بِكُلِّ مَجالِ",56,"ل",1,0],["عن وقعِ نَعْيكَ بعْدَ هذا لا تسلْ","هدَّ الجميعَ أباعدا وأقاربا",57,"ب",2,0],["عنوان كل فضيلة وفواضل","ودليل طرق الخير والإحسان",58,"ن",1,0],["عَن وَصلك مذ بُليت بالحرمانِ","لا مؤنسَ لِلقَلبِ سِوى الأَحزانِ",5