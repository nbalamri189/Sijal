{"poems":[[53,"يا دهر ما سبك غير ذي الخبث","https://www.aldiwan.net/poem9235.html","المنسرح"],[53,"اسعد بعيد أخي نسك وإسلام","https://www.aldiwan.net/poem66052.html","البسيط"],[87,"يا قوم عثمان والدنيا مداولة","https://www.aldiwan.net/poem63738.html","البسيط"],[68,"رو عظامي بسلا","https://www.aldiwan.net/poem38502.html","مجزوء الرجز"],[68,"أهلا ببدر دجى يسعى بشمس ضحى","https://www.aldiwan.net/poem41358.html","البسيط"],[50,"قولوا لمن قد تنفر","https://www.aldiwan.net/poem66288.html","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42734","البسيط"],[102,"بين ذهاب ومعاد","https://www.poetsgate.com/ViewPoem.aspx?id=50188",""],[53,"اسْعَدْ بعيد أخي نُسْكٍ وإسلامٍ","https://www.poetsgate.com/ViewPoem.aspx?id=30411",""],[123,"جاء وفي يساره","https://www.aldiwan.net/poem4361.html","مجزوء الرجز"],[199,"جزعت أن شت صرف الحي فانفرقوا","https://www.aldiwan.net/poem54414.html","البسيط"],[240,"ما سمع الناس ولا أبصروا","https://www.aldiwan.net/poem31959.html","السريع"],[287,"ما شد أزرار القبا","https://www.aldiwan.net/poem32867.html","مجزوء الرجز"],[438,"لمن ربوع مقفرات باللوى","https://www.aldiwan.net/poem12472.html","الرجز"],[543,"يا لذة الحلم في إغفاءة الوسن","https://www.aldiwan.net/poem47600.html","عموديه"],[558,"كأنه شلو كبش والهواء له","https://www.aldiwan.net/poem68339.html","البسيط"],[567,"من عاشر الدهر لا يخلو من الهوس","https://www.aldiwan.net/poem52815.html","البسيط"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25445","الرجز"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118427","السريع"],[2895,"","https://poetry.dctabudhabi.ae/diwan/poem/143704","الرجز"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115422","البسيط"],[3837,"","https://poetry.dctabudhabi.ae/diwan/poem/114658","السريع"],[5087,"لنا سراح نوره ظلمة","https://www.poetsgate.com/ViewPoem.aspx?id=96352",""],[5136,"هاج اشتياقي إلى من لا أسميها","https://www.poetsgate.com/ViewPoem.aspx?id=121942",""],[5376,"كلٌّ يغني على ليلاه","https://www.poetsgate.com/ViewPoem.aspx?id=188474",""],[572,"لستُ على عذلِكَ صَبَّارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9316&r=&rc=173",""]],"verses":[["كأنهُ شاربٌ على ظمإٍ","للمجد أو آكلٌ على غَرَثِ",0,"ث",1,0],["كأنّه شمسُ إصحاء وحاشَ له","من أن يُقاسَ إليه بدْرُ إعتامِ",1,"م",1,0],["كَأَنَّهُ شَفَقٌ تَسمو العُيونُ لَهُ","قَد قَلَّدَ الأُفقَ ياقوتاً وَمُرجانا",2,"ن",2,0],["كَأَنَّهُ شَمسُ النَها","رِ في رِداءِ الشَفَقِ",3,"ق",1,0],["كَأَنَّهُ شامَتٌ بِاللَيلِ عَن خَنَقٍ","فَكُلَّما صَدَعَ الصُبحُ الدُجى صَدَحا",4,"ح",2,0],["كأنه شحمُ نحلٍ","أو جامُ ثلجٍ مقعّر",5,"ر",1,0],["كَأَنَّهُ شُعْلَةٌ فِي الْكَفِّ قَائِمَةٌ","تَهْفُو بِهَا الرِّيحُ أَحْياناً وَتَعْتَدِلُ",6,"ل",1,0],["كأنّه شيخ على وجهه","مقبرة من عهده السالف",7,"ف",1,0],["كأنّه شمسُ إصحاء وحاشى له","من أن يُقاسَ إليه بدْرُ إعتام",8,"م",1,0],["كأنه شمسٌ بدَت","وحولها قوسُ قُزح",9,"ح",1,0],["كَأَنَّهُ شارِبٌ يَشفي لَذاذَتَهُ","بِالخَمرِ أَو وارِمُ الأَوداجِ مُختَنِقُ",10,"ق",1,0],["كَأَنَّهُ شَيخُ سَوءٍ بَزَّ خِلعَتَهُ","عاري الأَشاجِعِ مَكلومٌ بِهِ رَمَقُ",10,"ق",1,0],["كَأَنَّهُ شِلوُ قَتيلٍ أَتَت","لَهُ ثَلاثٌ وَهوَ لَم يُقبَرِ",11,"ر",1,0],["كَأَنَّهُ شَمسُ الضُحى","تَحمِلُ لَيلاً كَوكَبا",12,"ب",2,0],["كأنه شمسُ ضحًى بدتْ على","غصن رطيب في كثيبٍ في نَقا",13,"ا",1,0],["كَأنَّهُ شَيخُ بَدوٍ حَلَّ في مُدُنٍ","وأنتَ تعرفُ شيخَ البَدوِ في المُدُنِ",14,"ن",1,0],["كَأَنَّهُ شِلوُ كَبشٍ وَالهَواءُ لَهُ","تَنّورُ شاوِيَةٍ وَالجَذعُ سُفّودُ",15,"د",1,1],["كأنُّهُ شاخَ حتى صارَ من خَرَفٍ","لا يُدرِكُ الفَرْقَ بينَ الماءِ والقَبَسِ",16,"س",1,0],["كَأَنَّهُ شَلّالُ عاناتٍ كُدُمْ","كَأَنَّما تَغَرِيدُهُ بَعْدَ العَتَمْ",17,"م",1,0],["كأنه شوقا الى شادن","احور مارى شادنا احورا",18,"ر",2,0],["كأنه شرارة لموقد","أخرجها من ناره مقباسه",19,"س",2,0],["كأنه شبكٌ من لؤلؤ نظمت","أو جوهر السن أو تحبيك وشّاء",20,"ا",2,0],["كأنه شخص الامام الذى","تبغى الهدى منه أولو الرفض",21,"ض",1,0],["كأنه شخص الإمام الذي","يبغي الهدى منه أولو الفرض",22,"ض",1,0],["كأنه شفتاها واللمى ورق","يفعلن فعل ارتشاق الخمر من فيها",23,"ي",3,0],["كأنَّه شاءً دروبَ النوى","وشاء عن الابتسامِ العويلا",24,"ل",2,0],["كأَنَّهُ شعلة ُ نارٍ إذا","عاينَ فتخاءَ وحشنَارا",25,"ر",2,0]]}