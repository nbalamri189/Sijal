?id=12894",""],[5121,"الْمُسْتَلْقِيَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=213628",""],[5121,"بِلَا أَثَر","https://www.poetsgate.com/ViewPoem.aspx?id=214588",""],[5216,"إهداء إلى سائح","https://www.poetsgate.com/ViewPoem.aspx?id=187001",""],[5277,"زاجلةٌ بغدادية","https://www.poetsgate.com/ViewPoem.aspx?id=198942",""],[5302,"والظبي راتع","https://www.poetsgate.com/ViewPoem.aspx?id=201661",""],[5344,"لا تعجّل بالحُكم ..","https://www.poetsgate.com/ViewPoem.aspx?id=155070",""],[5358,"نطق العراق","https://www.poetsgate.com/ViewPoem.aspx?id=194832",""],[5397,"خضعت لعزة ذاتك الدول","https://www.poetsgate.com/ViewPoem.aspx?id=157897",""],[5397,"أهل بسط كف تحجب الشمس والبدرا","https://www.poetsgate.com/ViewPoem.aspx?id=157931",""],[5574,"أزكى الحبّ أثمله","https://www.poetsgate.com/ViewPoem.aspx?id=206027",""],[5582,"أَبَى اللهُ إِلاّ أَنْ أَرَى الحَقَّ غالِبا","https://www.poetsgate.com/ViewPoem.aspx?id=186674",""],[5618,"وردة في محراب عقبة","https://www.poetsgate.com/ViewPoem.aspx?id=208918",""],[5690,"صدقتم لحظهُ لحظ الغزالِ","https://www.poetsgate.com/ViewPoem.aspx?id=172173",""],[5703,"لمن أشكو","https://www.poetsgate.com/ViewPoem.aspx?id=207240",""],[5727,"الشاطئ البعيد","https://www.poetsgate.com/ViewPoem.aspx?id=205417",""],[5744,"فَخرُ أُنثى","https://www.poetsgate.com/ViewPoem.aspx?id=207278",""],[5842,"ويحكِ يادمشق .. ! / غسان عبد الفتاح","https://www.poetsgate.com/ViewPoem.aspx?id=174873",""],[5845,"إذا عهدوا فليسَ لهمْ وفاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=198492",""],[5885,"ذرة في الوجود","https://www.poetsgate.com/ViewPoem.aspx?id=194689",""],[5943,"أسيرُ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=11280",""],[6035,"ويحكِ يادمشق .. !","https://www.poetsgate.com/ViewPoem.aspx?id=174872",""],[6093,"إذا ما أمْرضَتْ نفسي المعاصي","https://www.poetsgate.com/ViewPoem.aspx?id=176267",""],[6093,"الشعر ( البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=181645",""],[6189,"وصية حرام بن ملحان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83557&r=&rc=24",""],[5190,"الوردة الحمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78331&r=&rc=44",""]],"verses":[["وإنْ أرابَكَ منْ دَهْرٍ تَكَدّرُهُ","كُنتُ المُصَفّى على أحْداثِهِ شِيَما",0,"م",2,0],["وَإِن أَرضاكِ هَجري فَاِهجُريني","فَما أَرضاكِ يُنمي لي سُروري",1,"ر",2,0],["وأنارَ شيْبَ البَرْقِ عارضُ عارِضٍ","تُحْدى بأصْواتِ الرّعودِ قِطارُهُ",2,"ر",2,0],["وإنْ أرَدْتَ الغَسْلَ فاعْدُدْ لَهُ","خَلاًّ وبالقِثّاءِ فاسْتَنْجِ",3,"ج",1,0],["وَأَنارَ ضَوءَ جَبينِهِ مُتَوَضِّحاً","في لَيلَةٍ مِن شَعرِهِ لَيلاءِ",4,"ا",2,0],["وَإِن أَرَدتَ جِهاداً رَوِّ سَيفَكَ مِن","قَومٍ أَضاعوا فُروضَ اللَهِ وَالسُّنَنا",5,"ن",2,0],["وإن أردت ترى وادي العقيق فَرِدْ","دموعَ عاشقها حمراً مجاريها",6,"ي",3,0],["وإن أردتم أن تنطقوني","فأطلقوني فأطلقوني",7,"ي",1,0],["وإن أردت عياناً أو محادثة","فاهرع إلى سندي واسمع أسانيدي",8,"د",2,0],["وإن أراد اللَّهُ في ملكهُ","جاوزت خَمْسِيَّ فأضعفْتُها",9,"ت",3,0],["وإن أرْصدوا منه لإدراك غرَّةٍ","لقُوا دونها أسيافه بالمراصدِ",10,"د",1,0],["وأن أراني عند ذاك أعتبر","فتسأل الغفران إذ لا أغتفر",11,"ر",1,0],["وإن أراد اللئيمُ مشأَمتي","كنتُ له طعنة وطاعونا",12,"ن",2,0],["وَإِن أَرَ الحُزنَ عَلى فائِتٍ","أَضَرَّ بِيَ الحُزن وَلَم يُجدِهِ",13,"د",2,0],["وإنْ أَرْشفتْكِ شِفاهُ الحَيَاةِ","رُضابَ الأَسى ورَحيقَ الأَلمْ",14,"م",1,0],["وإنْ أَردتَ قضاءَ العيشِ في دَعَةٍ","شعريَّةٍ لا يُغَشِّي صَفْوَها نَدَمُ",15,"م",1,0],["وأن أرى النور بعيني","بعد طول الظلم",16,"م",1,0],["وأن أراني هاوياً","منه إلى جهنم",16,"م",1,0],["وإن إرادة حلمي دعاك","لأعلى الأرائك مرسومها",17,"م",3,0],["وإن أردت جِدي","فأنت خير عندي",18,"ي",1,0],["وَأَنّا رَكِبنا غِمارَ الأُمورِ","وَأَنّا نَزَلنا إِلى المُؤتَمَر",19,"ر",1,0],["وَأَنّا رَدَدنا المُستَعارَ مُذَمَّماً","عَلى أَهلِهِ وَاِستَأنَفَ الحَقَّ صاحِبُه",20,"ب",2,0],["وَإِن أَرَدتَ اِجتِراحَ سَيِّئَةٍ","فَهَهُنا السَيِّئاتُ تُجتَوَحُ",21,"ح",1,0],["وَأَنارَت لَمّا رَكِبتَ إِلَيها","وَالمَوالي الحُماةُ وَالأَنصارُ",22,"ر",1,0],["وَإِنَّ اِرتِقابي ضَيعَتي مِن جَنابِهِ","كَما اِرتَقَبَ الساري الصَباحَ يُقابِلُه",23,"ل",2,0],["وأنا رهين كآبة","بخواطري أتوهَّمك",24,"ك",1,0],["وإن أردت دوائي","داوي الهوى ولهيبه",25,"ه",1,0],["وإن أرْضَكَ لو ألقى تعزّزها","منها رغاماً على أرض العدا رَغمُوا",26,"م",3,0],["وَإِن أَرَدتَ الشُربَ عِندَ الفَجرِ","وَالصُبحُ قَد سَلَّ سُيوفَ الحَرِّ",27,"ر",1,0],["وَإِن أَرَدتُ سَقَتني","خَمّارَةٌ قِبطِيَّه",28,"ي",2,0],["وَأَن أُرى ضاحِكاً إِلى أَحَدٍ","إِلّا بِقَلبٍ جَمِّ الكَآباتِ",29,"ت",1,0],["وَإِن أَرَدتَ اِنتِهاكَ عِرضِكَ فَاِر","دُدهُمُ يُعذَروا لِحاجاتِ",29,"ت",1,0],["وَإِن أَرغَمتَ صاحِبَةً بِضَرٍّ","فَأَجدِر أَن تَروعَ بِمُعرِماتِ",30,"ت",1,0],["وَإِنّا رَأَينا المَلِكَ يُخلِقُ ثَوبُهُ","وَتُخبِرُنا عَنهُ الدِيارُ الطَوامِسُ",31,"س",1,0],["وَإِن أَرَوكَ الوُدَّ عَن حاجَةٍ","فَفي حِبالٍ لَهُم يَجذِبون",32,"ن",1,0],["وأنار في شرف السماء نجومها","فتلون من آياته الألواحا",33,"ح",2,0],["وإِنَّ ارْتياحي من بكاءِ حمامةٍ","كذي شجنٍ داويتُهُ بشُجونِ",34,"ن",1,0],["وَإِنَّا رِجَالٌ تَعْلَمُ الْحَرْبُ أَنَّنَا","بَنُوهَا وَيَدْرِي الْمَجْدُ مَاذَا نُحَاوِلُ",35,"ل",1,0],["وَأَنَارَ كُلَّ خَفِيَّةٍ عَشِيَتْ","عَنْهَا الظنُونُ فَلَمْ يَذَرْ سِرَّا",36,"ر",2,0],["وأنا روح النظام الأمثل","أحفظ الأجرام في أفلاكها",37,"ه",2,0],["وإِنْ أرسلتْ في ذِمَّةِ اللّه عَبْرَةً","على ابن سُرىً حامي الذِّمارِ وَثُوبِ",38,"ب",1,0],["وإن أربى على العشرين منهم","فتى، أمس يغالط في الحساب",39,"ب",1,0],["وان ارتباط النفس في عرصاتها","شهود يريح النفس بين إغترابها",40,"ب",3,0],["وإن أردت لكم شِعراً يُجَسُّ به","نَبْضُ السياسةِ من آنٍ إلى آن",41,"ن",1,0],["وإنْ أرَدْتَ اجْتِرَاحَ سَيّئَةٍ،","فَهَهُنَا السّيّئَاتُ تُجْتَرَحُ",42,"ح",1,0],["وإن أرضاً غودرتَ فيها لتهدي","ريحها منك عَرفَ مسكٍ ذكيّ",43,"ي",1,0],["وأنار محراب الجهاد بربه","ومحى الهوى معنى بخير جهاد",44,"د",1,0],["وإن آراؤك الحسنى مميزة","عند التشابه بين الشحم والورم",45,"م",1,0],["وَأَنارَ بِساطِعِ سُؤدَدِهِ","لِذَوي الأَملاكِ دُجى الظُلَمِ",46,"م",1,0],["وأنارَ بالإيمانِ أفئِدةَ الورى","وأزالَ عنها الغشّ والأدرانا",47,"ن",2,0],["وإن أرث من أوصافه هبت الصبا","مع الشمس ترمي في اشعتها وردا",48,"د",2,0],["وان ارتكاض الشوق في حلبة الحشا","لأَهوَلُ من ركض المسوَّمة الجردِ",49,"د",1,0],["وأنار في صبح التهاني بهجة","نوارها وبها الاقاح قد انفتح",50,"ح",1,0],["وان أَراد الهَوى منك الهوان فقل","حكم المَنيَّة في حب الحَبيب منى",51,"ن",2,0],["وان أَرضيتهم غضبوا ملالا","وان أحسنت عشرتهم أَساؤا",52,"ا",2,0],["وإِن أَردت علمَها","وحدَّها ورَسمَها",53,"ه",2,0],["وإِن أَراكَ اِعتدالاً رمحُ قامتِه","فَطالَما جار في العُشّاق جائرهُ",54,"ر",2,0],["وإن أرعشت جفنيّ تهويمة الكرى","تراءيت جرحا ساهدا في محاجري",55,"ر",2,0],["وإنّ أرفعَ من قَصرٍ لشائدِه","بَيتٌ إذا سار مِن شِعْري لمَنْ شَعَرا",56,"ر",2,0],["وإنِ ارتَبْتَ يا غلامُ بأمري","فاتْلُ وصْفي في سُورة الشُعَراء",57,"ا",2,0],["وأنارَ بالبشرى الورى","وأجالها في الكون ريحه",58,"ح",2,0],["وإن أردت طلب الكمال","والفوز في العقبى وفي المآل",59,"ل",1,0],["وإن أردت الهداية","فاعمل بما في البدايه",60,"ه",1,0],["وإن أردت النهاية","فهي بالأحيا حريه",60,"ه",1,0],["وإن أردت السلامة من زمان الكلول","فإنها في القناعة والرضا والخمول",61,"ل",1,0],["وأن أرضي التي غادرتها لبست","ثوب الجفاف وصارت بعدكم طللا",62,"ل",2,0],["وأنّ آراءَك إن أَعْمِلَتْ","في حادثٍ كالسيّف أو أمضَى",63,"ض",2,0],["وإنْ أردْت أماناً من غوائِله","فلا تُعَرِّفْه من أبنائهِ أحدا",64,"د",2,0],["وإِن أرفَهَتْ فِي بحرِ جودِكَ شِرْبَها","فَمِنْ ظِمْءِ عَشْرٍ فِي الهجيرِ إِلَى تِسْعِ",65,"ع",1,0],["وأَنارَتْ بِهِ نجومُ المعالي","وأَنارَ الدُّنيا ببيضِ الأَيادِي",66,"د",2,0],["وان أردت سواكم","فلا بلغت مرادي",67,"د",2,0],["وإن أرتكَ شارةً طريرةً","ترضَى بها العينُ ووجهاً هَلْهَلا",68,"ل",2,0],["وإن أردتِ الأمنَ أن تجوري","فيمِّمي بغدادَ ثمَّ سِيري",69,"ر",2,0],["وَأَن أَرِدَ الماءَ المُوَطَّأَ حَسبَةً","وَأَتبَعَ وَصلاً مِنكَ وَهُوَ ضَعيفُ",70,"ف",1,0],["وأن أرَى تركَ الإتِّحادِ ونوعِهِ","وإحكامَ حكمِ النَّصِّ في الفرقِ والجَمْعِ",71,"ع",1,0],["وأنّا رِفدُهُم في كلّ يومٍ","فإن غَضِبُوا فَسَل رُجلاً عَريفا",72,"ف",2,0],["وأنا رَجائي في المُهَيمِنِ وَحدَهُ","هو مُبرِىءُ الأَرواحِ والأبدانِ",73,"ن",1,0],["وأنارَ ناراً لا تبوخُ وربّما","قد كان للنّيرانِ لونُ دُخانِ",74,"ن",1,0],["وإنّا رَفَعناكمْ فَأشرف منكُمُ","بنا فوق هاماتِ الأعزّةِ مُشرِفُ",75,"ف",1,0],["وإن أردتم جواباً واحداً فقفوا","هنا فما هذه قيلَ التماثيل",76,"ل",1,0],["وإن أراك الله فضل امرئٍ","من كامل الدنيا وتحريره",77,"ر",2,0],["وأنارت مشكاة ذاتي بمصبا","ح علومي وفي الزجاجة زيتُ",78,"ت",1,0],["وإن أراد زادكم بفضله","عين اليقين منزل الأسماء",79,"ا",2,0],["وَإِن أَرَدنَ شَزرَهُ شَزرِيُّ","بِسَلِبٍ أُنبوبُهُ مَدرِيُّ",80,"ي",1,0],["وإن أردتَ نجاةَ الرَّأيِ من سَفَهٍ","فاذهَبْ ونادِ بأعلى الصَّوتِ يا ابنَ نَجَا",81,"ج",2,0],["وإِن أَردْت معانِي الحسن مُثْبتَةً","فاكتُب فوجْهُ حبيبِ القلبِ يُمليكا",82,"ك",2,0],["وأَن أُرَى مِن أَجْلها","عِند الملوكِ جَالِس",83,"س",1,0],["وَإِنْ أَرادُوا مَكارِماً بَلَغُوا","وَإِنْ أَرادُوا مَكَارِهاً غَلَبُوا",84,"ب",3,0],["وان اراد الهي بامرئ رشداً","اغناه عن كل انصار واعوان",85,"ن",1,0],["وإنْ أردْتَ جعلْتُ الخَدَّ واسِطَةً","حتَّى تكونَ شَفيعاً لي إلى قدمِكْ",86,"ك",1,0],["وإنَّ أرواحَهَم مُخَيِّمَةٌ","عِندكَ بَينَ السُّتُورِ مِن خَيَمِك",87,"ك",1,0],["وإن أرسلوها في الدروع رايتها","أشد نفوذاً من أخ الرمل واثب",88,"ب",1,0],["وَإِن أَردت فَسَلِ الطاعونا","عَني تَراه قَد مَضى مَغبونا",89,"ن",2,0],["وَإِن أَرَدتَ الشُربَ في الظَلامِ","عاقَكَ عَن تَناوُلِ المُدامِ",90,"م",1,0],["وأن أراك رجلاً","بين الرجال النجب",91,"ب",1,0],["وإن أرادت لهم من جيرة مدداً","فالترك والفرس والأفغان والعرب",92,"ب",1,0],["وأنارَ في جُنحِ الدُّجَى","بدراً علا صدرَ القضيبِ",93,"ب",1,0],["وإن ارضا وليتها فلك","يحرسها من يراعك الشهب",94,"ب",1,0],["وَأَنارَ الأَيّامَ فيهِ دَواماً","بِوَزيرٍ لَقَد خَلا عَن مداني",95,"ن",2,0],["وَإِن أَرَدت تَدخل البُروجا","قَبل الدُخول قدِّم الخُروجا",96,"ج",2,0],["وأنْ أرعى النجومَ ولستَ فيها","وأنْ أطأ التراب وأنتَ فيهِ",97,"ه",1,0],["وإنْ أَردْتم حرمانَه فلقد","يصح معْهُ أدنى اعتذاركم",98,"م",1,0],["وَإنْ أردت ترشيش حظ من النهى","فَمَا النَّجْمُ مفقودٌ وَلاَ الصُّبْحُ خَافِيَا",99,"ي",2,0],["وأنَارَ مِنْ أفْقِ الخِلاَفَةِ مَا دَجَا","وَأبَانَ في العَلْيَا مَآثِرَ مَنْ غَبَرْ",100,"ر",1,0],["وإن أراد النوم لم يقض الكرى","من هول ما لاقى وأهوال الردى",101,"ا",1,0],["وَإنْ أُرِيْدَ الْقُوَّةُ الْقُدْسِيَّهْ","وَما بِهِ الْمَسائِلُ الْفَرْعِيَّهْ",102,"ه",1,0],["وإن أرضى الناس بالخسار","من باع دين الحق بالدينار",103,"ر",1,0],["وانار نار الحرب في","يوم تشيب به الصغارْ",104,"ر",1,0],["وانار دار العز عرس زانه","وفق على مدد الزمان يزيدُ",105,"د",1,0],["وأنا رقدت وقدْ نهضت لأن لي","رب العلاء هو المعين المنصرُ",106,"ر",1,0],["وأَنارَ كالبَرْقِ استَطارَ وإِنَّما","لمّاعُهُ أَعْيا عَلى لمّاحِهِ",107,"ح",2,0],["وإن أرض طوعاً أرض مصرٍ وحرها","بديلا فإني فائل الرأي أخرق",108,"ق",1,0],["وَإِن أَرَدتَ صَحيحَ مَن يُكوى بِها","فَاِقرَأ عَقيبَةَ سورَةِ الأَنفالِ",109,"ل",1,0],["وإن أردت اجعل إذا المفاجأة","في موضع الفاء على المكافأة",110,"ه",1,0],["وإن اردتَ فكَّ هذي الدائره","لكونها على الاصول دائره",111,"ه",1,0],["وان اردت الوضع في التركيب","فاقسم ثلاثة على الترتيب",111,"ب",1,0],["وان اردت باليمين فافعلِ","هذا وذا يجوز عند الاولِ",111,"ل",1,0],["وأن أرعى الكواكبَ طُولَ ليلى","وقد خِلتُ الكواكبَ من شهاب",112,"ب",1,0],["وانا راضٍ بما تضي","فلا تخشَ الملاما",113,"م",2,0],["وَأن أَردَ الماءَ الّذي شَربت به","سُليمى وَإِن ملّ السرى كلّ واحدِ",114,"د",1,0],["وان أرادك الهوى منه الهوان فقل","الصبر فرض على من يعشق الحسنا",115,"ن",2,0],["وأنار القلوبَ بالهدى حتى","عَمَّ نورُ الهُدى وسادَ الضِّياء",116,"ا",2,0],["وإن أردت فنصف الصاع تدفعه","برا لكل فقير مرمل وكل",117,"ل",1,0],["وإن أرضاك قتلي","تعيش رأسك وتبقى",118,"ق",2,0],["وان اردت انتقاماً","ممن أرادوا المعونه",119,"ن",2,0],["وأن أرى لحياتي","نهايةً وختاما",120,"م",2,0],["وإن أردتَ قصّة الإصرافَهْ","فإنها في غايةِ اللَّطافَهْ",121,"ه",1,1],["وان ارج فيك الفوز يا بن محمد","فانك بالأمر الذي ترتجي ملي",122,"ل",2,0],["وأنار لي منها ضياءٌ خاطفٌ","خِلْتُ البيوتَ سماءَ ذاك الخاطفِ",123,"ف",1,0],["وإن أردتَ شبهَهُ","فَقَلبُهُ بالتصحيف",124,"ف",1,0],["وَإِن أَرَ خَيراً في المَنامِ فَنازِحٌ","وَإِن أَرَ شَرّاً فَهُوَ مِنّي مُقَرَّبُ",125,"ب",1,0],["وَإِن أَرجو التَخَلُّصَ مِن عَظيمٍ","فَقَد يَنجو مِنَ اللُجَجِ الغَريقُ",126,"ق",1,0],["وَإن أرَدتَ البَرَّ في اليَسَارِ","فِيه أَدِلاَّ جُملَةِ الأدوَارِ",127,"ر",1,0],["وَإن أرَدتَ لاَرَ في شُرُوقِه","من نَجَّ تاتيهِ فَخُذ تحقيقَه",127,"ه",1,0],["وإن أردتَِ يستقيمَ الزام","في المايةِ والعشرِ لا تنام",128,"م",1,0],["وإن أرَدتَ البَرَّ من حَافُوني","تَرَى قِطَع بَنَّةَ باليَقينِ",129,"ن",1,0],["وَإن أَرَدتَ غِيرَةً لِلبَحرِ","صَوِّب وكُن صاحِبَ فِكرٍ وَآجرِ",130,"ر",1,0],["وَإن أرَدتَ كِلوَة المُلُوك","مِن مُنفِيَه فَعِندَكَ السُّلُوك",130,"ك",1,0],["وإن أردتم فاحقنوا","وإن أردتم فاسفكوا",131,"ك",3,0],["وَإِنْ أَرَدْتَ القَوْلَ فِي السَّفَرْجَلِ","غِذَاؤُهُ يُحْمَدُ لِلْمُسْتَعْمِلِ",132,"ل",1,0],["وإن أردتَ القولَ في طَبعِ الرُّطبْ","فطَبْعه الحَرُّ فِي أُولى الرتب",132,"ب",1,0],["وان ارفع ما للمرء من شرفٍ","إلى كمال العلا يسمو بمرقاه",133,"ا",2,0],["وإن أردت فاترك الدنيا وغب","عن علمك المزخرف المرصود",134,"د",1,0],["وان ارسل جعديه","ركبنا الليل تغليسا",135,"س",2,0],["وان أردت أن تكون شاعراً","فحلاً فكن مثل أبي الشمقمق",136,"ق",1,0],["وَإِن أَرضَيتَهُم غَضِبوا مَلالاً","عَديمَ العَتبِ يَعقُبُهُ الجَفاءُ",137,"ا",2,0],["وإن أرادت سبيل الغيّ ألجمها","بالعقل اجعله في الحبّ ميزانا",138,"ن",2,0],["وإن أرغب مدى عمري لقتل","فغاية رغبتي قتل الحسود",139,"د",1,0],["وأن أرد الماء الذي شربت به","سليمى، وقد مل السرى كل واجد",140,"د",1,0],["وان اردت نكاحا قد شغفت به","فاخطب لبكر وذات الدبن فاغتنم",141,"م",1,0],["وان اردت وقاعا سم مبتديا","واساله تجنيبك الشيطان بالنسم",141,"م",1,0],["وان اردت خروجاً للصلاة فكن","من بعد لبس ثياب البيض والعمم",141,"م",1,0],["وإن أروَ نهرُ النيل من مصرَ غورَها","فَبَحرُكَ عذبٌ منه تُروى نجودُها",142,"د",3,0],["وان ارتبكت ولم تجب فالويل ك","ل الويل ياقبح الذى أضناكا",143,"ك",2,0],["وإن أردتُ مُقاما قال قائلهم","يا سعنةَ الخيْرِ قدَ قرَّتْ بنا الدارُ",144,"ر",1,0],["وَإنْ أَرْجُوكُمُ وَأَخِيبُ كُلاًّ","سِوَاكُمْ قَصْدُ رَاجِيه يَخِيبُ",145,"ب",1,0],["وأنار طالعك الليالي فانجلت","كرباتها وأنجب عنها الغيب",146,"ب",1,0],["وَإِن أَردتُم مِثالا صالِحاً حسناً","فَسعدُ أَبلغ ما تبغون مِن مَثَلِ",147,"ل",1,0],["وأنارت للشّمْعِ فيها نُجومٌ","تُجْتَلى عندَ نقْصِها في اكْتِمالِ",148,"ل",1,0],["وإن أرْسَلَتْ في حوْمَةِ الحرْبِ ذابِلاً","تتبّعَ من لمْ يبْغ عنهُ تثبُّطا",149,"ط",2,0],["وأنار واديك الربيع فربما","نغنى به ونراه أبهج وادِ",150,"د",1,0],["وَإن أردَتَ مِثلَ ثَانِى اثنَينِ","مُرَكَّباً فَجِىء بِتر كِيبَينِ",151,"ن",1,0],["وَأَنارَ مِن شَهر الرَبيع هِلالَهُ","وَبَدا كَبَدر مِنهُ أَشرَق نير",152,"ر",1,0],["وإن اردت عدد المجرورِ","متّبعاً لمذهب الجمهور",153,"ر",1,0],["وإن أردت الصواب فامسخ","ما كان فيها من اعتدال",154,"ل",1,0],["وأن أراني تارة مقبلًا","وخطوتي تمشي بي القهقرى",155,"ر",2,0],["وأن أروح أصحاب السعادة في","جنات عدنٍ كطير يعلق الشجرا",156,"ر",2,0],["وإن أرواح من يشقى معذبه","حتى تكون مع الجثمان في سقرا",156,"ر",2,0],["وأن أرى الأهل والأبناء في سعة","فيدرك الكل من مولاه مأموله",157,"ل",2,0],["وأن أرى العفو مقرونا بعافية","وعيشتي بالصفا والعز مكفوله",157,"ل",2,0],["وإن أرى خلتها لغيرنا عرضت","تبدو عوارضها بالبشر جداده",158,"د",2,0],["وإن أردت الونا وهو الفتور فقل","نِ يا خليلي نياه نوه ني نينا",159,"ن",2,0],["وإن أراد الشرَّ بالعبد عكسْ","عليه ذا فالحق عنه ملتبسْ",160,"س",1,0],["وَأَنارَ في ظُلمِ الحَوادث رَأيه","فَأَراكَ فِعل الشَّمسِ في الأَحلاكِ",161,"ك",1,0],["وان اردت شهودا","فالحب بعض الشهود",162,"د",1,0],["وان اردت انتقالا","إِلى نَعيم الخلود",162,"د",1,0],["وأنار حول أخيل فانقشعت","تلك الغياهب عنه في العجل",163,"ل",1,0],["وَاناروا الكَون مِن شهب الكَلام","نحمَدُ اللَهَ الَّذي اَبقى لَنا",164,"ن",2,0],["وإن أراه النُّهى في النأي نيلَ منىً","ولو إلى السند أضحى وهو يزمعه",165,"ع",2,0],["وإن أرتنا الثنايا في تبسمها","حسبت أنفس درّ عندها صدفا",166,"ف",2,0],["وأنار مصباح الأمان وحلمهُ","غوثٌ إلى من قد أتى متوسِّلا",167,"ل",2,0],["وأنار مصباح القريض وقد أتى","بسما الفرائد والفوائد مسفرا",168,"ر",2,0],["وإن أردف المحل شهب السنين","وجفت من العاديات الضروع",169,"ع",1,0],["وَإِن أَرَدتَ الأَمنَ سَلِّم لَهُ","تَكُن بِلا رَيبٍ من الآمِنين",170,"ن",1,0],["وإن أراد اعتراضاً دُونَ ذي حُرَمٍ","فلن أحمِّلُهُ إلا الذي احتُمِلا",171,"ل",2,0],["وأن أرى رأسك السامي ينوء به","مثقّف بين أهل البغي والكذب",172,"ب",1,0],["وأن أرواح أصحاب السعادة في","جنات عدن كطير يعلق الشجرا",173,"ر",2,0],["وأَن أَرقَى ولَو يَومًا","بهِ, عَن حَظرِ تِجوَالِكْ!",174,"ك",1,0],["وأنا رِوَايَاتُ الصَّفِيحِ عَن ال","بَذَخِ الذي عَادَتْ عِصَابَتُهُ",175,"ت",2,0],["وإِن أَرَدتُم بَيَانًا عنه ذا ثِقَةٍ","فَلتَسمَعُوا عنه (حَسَّانًا) و(نَشوانا)",176,"ن",2,0],["وأن أراك في جَميل هيئة","بتاج عزك الذي تألقا",177,"ق",2,0],["وانا رقدت وعمري اربع عشر عام","وصحيت في شهر اربعه عام الالفين",178,"ن",1,0],["وإن أردت رفيقاً لا جفاء بهِ","فاصحب حروفكَ لاتأمن لإنسانِ !",179,"ن",1,0],["وإن ارتضى أهلُ الضلال ضلالَهم","فالله اكبر من دعي إمعة",180,"ع",2,0],["وَأَنَاْرَتِ الْحُبَّ الْعَفِيْفَ بُدُوْرُهُ","وَشُمُوْسُهُ بِأَشِعَةِ الإِشْرَاْقِ",181,"ق",1,0],["وأنا رضيت بأن ألوذ بوحدتي","ولذا تراني للشعور مهادنا",182,"ن",2,0],["وإِنَّ أَرَقَّ شَيءٍ قَدْ نُلاقِي","-بِرُغمِ وداعَةٍ فِيهِ- العنَاءَ",183,"ا",2,0],["وإن أردت بقوم فتنةً عمماً","لا ترهف السيف لكن أرهف القلما",184,"م",2,0],["وإن أردت خلاصاً من تعتبه","ظلماً، فعاتبته في فعله غضباً",185,"ب",2,0],["وإنا رأينا المشاريع تمّتْ","كما قلت.. لكن بحلم يُعادْ",186,"د",1,0],["وَأَنَا رَسَمْتُ قَصِيدَةً بِمَشَاعِرِي","مِنْ تُحْفَةٍ سِحْرِيَّةٍ مُسْتَوْحِيَةْ",187,"ي",2,0],["وَأَنَا رَجَوْتُ مِنَ الْحَبِيبِ إِذَا خَطَرْ","أَنْ يَرْتَمِي فِي مُقْلَتِي عِنْدَ النَّظَرْ",188,"ر",1,1],["وإنْ أردْتَ بِناءً عمرهُ حِقَبٌ","فالخلدُ وقفٌ على آثارِ ماضينا",189,"ن",2,0],["وأنا رسولُ الوجدِ يسكنُ خافقي","وعلى طريقِ الشوقِ أنتِ بريدُ",190,"د",1,0],["وإن أرجف الحساد في بث شبهة","لهانوا وهل عز اللئيم المخادع",191,"ع",1,0],["وأنا رجيتك لا تعجلك الأسباب","وتنطق أحبك لأن هالحب ميثاق",192,"ق",1,0],["وأنا رأيتُكَ إنْ تُعَيَّنْ راعياً","ضأناً يكُنْ أمراً عليكَ كثيرا",193,"ر",2,0],["وأنار فيك الحق واتضحت","للعارفين بعدلك السبل",194,"ل",1,0],["وإن ارتداد المرء بغض نبيه","وعترته والصحب كلهم طرا",195,"ر",2,0],["٢- وإنْ أردتَ مزيدًا هاك قافِيَتي","أو خُذْ من الشعرِ أسماهُ وأجزلَهُ",196,"ل",2,0],["وَأَنْ أَرْتَقِي مِنْ غايَةِ المَجْدِ وَالعُلا","مَراتِبَ تَعْلُو فِي الفَخارِ مَراتِبا",197,"ب",2,0],["وأنارَ تاريخ الفتوحات التي","قد أوشكت أبوابُه أن توصدا",198,"د",2,0],["وأن أرخى النقاب على المحيا","قضينا العمر في سهر الليالي",199,"ل",2,0],["وإنْ أرْسلْتَ حَرفاً لي أراهُ","على جيدي مَكانَ العقْدِ عِقدا",200,"د",2,0],["وأنا رغمَ كلِّ جرأة قلبي","أرهبُ الحقدَ واصطراعَ السمومِ",201,"م",1,0],["وإن أرْسَلْتُ في الفُرْسانِ طَرْفي","أُبيحُ بسيفِ هُدْبي ما يُصانُ",202,"ن",1,0],["وإنْ أراحتْ سيوفاً في غمائِدها","ترى القراطيس هبَّتْ تُوقِظُ القلما",203,"م",2,0],["وإنْ أرضيتهمْ غضبوا ملالاً","وإنْ أحسنتَ عشرتهمْ أساءوا",204,"ا",1,0],["وأنا ربكم فمن يعص أمري","أصله النار بين كي وشي",205,"ي",1,0],["وإنْ أردتَ لدرءِ الشَّرِ واسطةً","ففي الصَّلاحِ لنا خيرٌ وإصلاحُ",206,"ح",1,0],["وإنْ أراحتْ سيوفاً كي تُسَنِّنُها","ترى القراطيس هبَّتْ تُوقِظُ القلما",207,"م",2,0],["وإنْ أرختْ عناناً في ملاهٍ","وإنْ هَرَعتْ إلي دفٍّ وعُودِ",208,"د",1,0],["وإنَّ أردتَ بياناً عنْ مقالتنا","فَشِعْرُ حسَّانَ حيٍّ وهْو في الرَّيْم",209,"م",1,0],["وأنا روحها زفيرُ أساها","كلما ضاق صدرها والشهيق",210,"ق",1,0],["وإن أرسلتُ أشرعتي تباعاً","لبحرِكِ ، جاهدي أنْ تُغرقيها",211,"ي",3,0]]}