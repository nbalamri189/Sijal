1456",""],[4791,"لو تعذر","https://www.poetsgate.com/ViewPoem.aspx?id=28409",""],[4859,"لايجرح الحب!","https://www.poetsgate.com/ViewPoem.aspx?id=204305",""],[3591,"يا وجوه الجمال في أرض باري","https://www.poetsgate.com/ViewPoem.aspx?id=149479",""],[5145,"أعوز الصبر فهل لي من طريق","https://www.poetsgate.com/ViewPoem.aspx?id=108199",""],[5402,"لايجبر الكسر","https://www.poetsgate.com/ViewPoem.aspx?id=215526",""],[5455,"القلوب الطيبه","https://www.poetsgate.com/ViewPoem.aspx?id=34404",""],[5649,"درة صور","https://www.poetsgate.com/ViewPoem.aspx?id=38967",""],[5650,"عَائِشَة... وَحْيُ الْقَصِيد!","https://www.poetsgate.com/ViewPoem.aspx?id=131223",""],[5691,"ضياغم بيْتا","https://www.poetsgate.com/ViewPoem.aspx?id=206209",""],[178,"أقرح القلب والحشا","https://www.poetsgate.com/ViewPoem.aspx?id=200970",""],[5818,"ليت العذول الذي قد بات يعذلني","https://www.poetsgate.com/ViewPoem.aspx?id=199979",""],[5829,"ولو ألقى معاذيره","https://www.poetsgate.com/ViewPoem.aspx?id=155463",""],[5937,"لا يُجيدُ الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=211809",""],[5939,"اضرب كي تقطع رأس الأفعى","https://www.poetsgate.com/ViewPoem.aspx?id=136646",""],[5956,"أنا وشقيقي والحمامة","https://www.poetsgate.com/ViewPoem.aspx?id=184560",""],[6048,"معراجُ الوجع","https://www.poetsgate.com/ViewPoem.aspx?id=197747",""],[5309,"في نظام مرصع الأصفاد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573552",""],[6317,"دموع التاريخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86079&r=&rc=4",""]],"verses":[["لا يَجبُرونَ عَلى الأَيّامِ مَن وَهَنوا","بِالقارِعاتِ وَلا يَأسونَ مَن عَقَروا",0,"ر",3,0],["لا يَجِدُ الدَهرُ مَسلَكاً أَبَداً","وَلا طَريقاً إِلَيكَ مَلحوبا",1,"ب",2,0],["لا يَجتَويها ضَيفُهُم وَفَقيرُهُم","وَمُدَفَّعٌ طَرَقَ النُبوحَ يَتيمُ",2,"م",1,0],["لا يَجهَلونَ وَإِن حاوَلتَ جَهلَهُمُ","في فَضلِ أَحلامِهِم عَن ذاكَ مُتَّسَعُ",3,"ع",1,0],["لا يجهلن حليم إنني رجل","من كان أخطل جهل كنت جحّافا",4,"ف",2,0],["لا يجهلن على حلمي أخو ثقة","فالجهل من خلقي إن كان من خلقه",5,"ه",1,0],["لأيّ جُرمٍ غدوتَ تَلْفظُني","وكنتُ أحلى لديك من وسنِك",6,"ك",1,0],["لا يَجُر مولىً جليلٌ سنناً","في عُبيد لم يفارق سكنَه",7,"ن",2,0],["لا يَجزَعُ الشاعِرُ أَن يُقتَلا","لَيسَ وَراءَ القَبرِ سَيفٌ وَرُمح",8,"ح",1,0],["لِأَيِّ جَميلٍ مِن جَميلِكَ أَشكُرُ","وَأَيِّ أَياديكَ الجَليلَةِ أَذكُرُ",9,"ر",1,1],["لا يجتني الطَّرْفُ منه إلاَّ","عَواطفَ الشَّوْكِ والتُّرابْ",10,"ب",1,0],["لا يجاريك في الخلود قريضي","كل ما فيك قلته سيضيع",11,"ع",1,0],["لا يجوس العدو مملكة","جيشها انتظم",12,"م",1,0],["لا يُجازيهِ في تَفَنُّنِهِ العو","دُ وَلا يَشتَكي إِذا لَم يُجارِهِ",13,"ر",2,0],["لا يَجبُرُ الناسُ عَظماً أَنتَ كاسِرُهُ","وَلا يَهيضونَ عَظماً أَنتَ جابِرُهُ",14,"ر",2,0],["لا يَجذِبَنَّ رِكابي نَحوَهُ أَحَدٌ","ما دُمتُ حَيّاً وَما قَلقَلنَ كيرانا",15,"ن",2,0],["لا يجلب الصبغ الذي","تريده من بعدِ",16,"د",1,0],["لا يجمد الماء بأجساده","ما لم يكن بينهما الصمغة",17,"غ",2,1],["لايَجذِبُ الوَطَنُ المَألوفُ عَزمَتَهُ","وَلا الغَزالُ الَّذي في طَرفِهِ كَحَلُ",18,"ل",1,0],["لا يُجزِ عَنَّكَ أَنَّهُ رَفَعَ العِدى","فَلَسَوفَ يَهدِمهُ قَليلٌ ما بَنى",19,"ن",2,0],["لا يَجْزَعُونَ مِنَ المَنونِ كَأَنَّما","آجالُهُمْ لِنُفوسِهِم أعمارُ",20,"ر",1,0],["لا يُجَارَى لِسَبقِهِ فَلِهذا","لم يَجِدْ في مَدَى العُلى من يُجاري",21,"ر",2,0],["لا يَجوزُ الأُمورَ صَفحاً وَلا يُر","قِلُ إِلّا عَلى سَواءِ الطَريقِ",22,"ق",1,0],["لا يَجزَعِ العاني فَكُلٌّ زائِلٌ","وَلِكُلِّ دَولَةِ مَعشَرٍ ميعادُ",23,"د",1,0],["لا يَجهَلُ القَومُ الَّذينَ تَمَرَدّوا","أَنَّ الرِقابَ لِحُكمِهِم لا تَخضَعُ",24,"ع",1,0],["لا يَجْزَعِ القوْمُ إنّ السَّيفَ مُرتَدِعٌ","عمّا قليلٍ وإنّ النّصرَ قد أزِفا",25,"ف",2,0],["لا يَجتَلي الحَوراءَ مِن خِدرِها","إِلّا امرُؤٌ ميزانِهِ راجِحُ",26,"ح",1,0],["لا يَجزَعَنَّ مِنَ المَنِيَّةِ عاقِلٌ","فَالنَعشُ مَن نُعِشَ الفَتى أَن يَعثُرا",27,"ر",2,1],["لا يَجعَلَنَّ هِنداً هُنَيدَةً فُوَكَ فَالتَ","صغيرُ مَقرونٌ إِلى الإِصغارِ",28,"ر",1,0],["لا يَجمَعُ الفَضلَ بَل يُعطى العُلا رَجَبٌ","لِلحَربِ يُجبى وَيُعطى الفِطرَ شَوّالُ",29,"ل",1,0],["لا يَجْتَني حُلْوَ المَحامدِ ماجِدٌ","حتى يَذوقَ منَ المَطالبِ مُرَّها",30,"ر",3,0],["لا يجلي شاعر","لم يكن مبتكرا",31,"ر",2,0],["لا يَجْمُلُ الْمَرْءُ فِي ظَرْفٍ وَفِي أَدَبٍ","مَا لَمْ تَكُنْ فَوْقَ مَرْآهُ سَرَائِرُهُ",32,"ر",2,0],["لا يُجَارِي عَلى افْتِئَات","وَلا يَعْدَمُ مِنْهُ نَصِيرَهُ التَّفْكِيرُ",33,"ر",1,0],["لا يَجِدُ المأوَى ولو رَامَهُ","أحالَهُ الدهر على قَبْره",34,"ر",2,0],["لا يجزع الوطن المدلّ بحقّه","ألباسمون مع الشباب حماته",35,"ت",2,0],["لا يُجاريه في تفنُّنِه العو","دُ، ولا يَشْتكِي إذا لم يُجارِه",36,"ر",2,0],["لا يَجحَدُ الشمس المنيرة مُبصِرٌ","إلا صُوَيْحِبُ مُقْلَةٍ عمياءِ",37,"ا",2,0],["لا يجتبى ببيوت النافقاءِ ولا","يروح مشتملا ثوبا من الزورِ",38,"ر",1,0],["لا يَجحَدَنَّكَها الحَسودُ تَجاهُلاً","فَالصُبحُ لا يَخفى عَلى البُصَراءِ",39,"ا",2,0],["لا يَجبُرُ الدَهرُ هَيضاً في كَسيرِهِمُ","وَلا تَهيضُ يَدُ الأَيّامِ ما جَبَرُوا",40,"ر",3,0],["لا يَجهلُ الحسنَ ما بَينَ الوَرى أَحَداً","وَلَيسَ يَعلمُ مِنهُم كُنْههُ أَحَدُ",41,"د",1,0],["لا يُجيبُ الأَحياءَ مَن لَيسَ حَيّاً","وَالعَمى عِندَ غَيرِهِ الأَخبارُ",42,"ر",1,0],["لا يَجتَويهِ وَإِن طالَت إِقامَتُهُ","أَهلُ المَكانِ وَلا الأَرضُ الَّتي نَزَلا",43,"ل",2,0],["لا يجتبي المجدَ غَضَّاً غيرُ مُضطَغِنٍ","تَرْدِي به الجُرْد أو تُحدَى به العير",44,"ر",1,0],["لا يجارَى في حربه والمجاري","عاد من عجزه إلى السلم جانح",45,"ح",1,0],["لا يَجِدُ العَالِمونَ خَوْفاً","بِهِ ولا يَشْتَكُونَ حُزْنا",46,"ن",2,0],["لا يُجفِلونَ عَنِ المُضافِ وَلَو رَأَوا","أولى الوَعاوِعِ كَالغُطاطِ المُقبِلِ",47,"ل",1,1],["لا يَجحَدِ الفَضلُ سِوى","مَن لِلنَهارِ ناكِرُ",48,"ر",1,0],["لا يَجزَعونَ إِذا ما القَتلُ حَلَّ بِهِم","وَلا يُرَونَ فُراحى إِن هُمُ خَمِسوا",49,"س",3,0],["لا يَجتويه ناظِرُ مُرْتادُه","إن اهتدى ودَعْه إن لم يَهْتَد",50,"د",1,0],["لا يَجف الدَمع مِن أَجفان ذي","شَجن إِلّا إِذا الحُزن ثَناها",51,"ا",3,0],["لا يجودن بمال أبداً","بل يجودون بربّات الخدود",52,"د",1,0],["لا يَجلسُ الحلمُ ولا يركَبُ ال","خوفُ ولم تجلِس ولم تَركَبِ",53,"ب",1,0],["لا يَجبَهُ الحاجَةَ بِالتَضجيعِ","مِنَ المَحَلِّ الخَصِبِ المَريعِ",54,"ع",1,0],["لا يجمع الله بيني وبينه أبدا","فالأفق شيمته والسفك مكتتم",55,"م",1,0],["لا يجهل البازل سناً ولا","أُعلّم الخمرة إني عوان",56,"ن",1,0],["لا يَجمَعونَ المالَ إلّا للنّدى","أَو لاِصطِناع صنيعةٍ لم تُصنعِ",57,"ع",1,0],["لا يجد الذّمّ في حريمهمُ","مسعىً ولا العائبون مُضطَرَبا",58,"ب",2,0],["لا يجاريه مادرٌ وَطويسٌ","عِندَ لؤم بليل شؤم ظَلام",59,"م",1,0],["لا يجهزون على حياتك خلسة","ومراصد الأغيار منك دوان",60,"ن",1,0],["لا يجتني ثمراً سوى ما قدمت","فيها يداه ولا يسيغ شرابا",61,"ب",2,0],["لا يجتني الا بمجل","س فضله ثمر الوداد",62,"د",1,0],["لا يجهدِ النّفس في نيلِ العُلَى أَحَدٌ","مَن كانَ غَيرَ عَليٍّ كانَ غَيرَ علي",63,"ي",1,0],["لا يجرمنك ذَمَّ الناسُ أم حمدوا","فان أحمدهم في السر هجاء",64,"ا",2,0],["لا يجدون قُدْوة من عُلَما","قد نَصَبوا لآل طه عَلَمَا",65,"م",2,0],["لا يَجْعَلُونَ النَقْدَ لِلْمُسْتَأْذِنِ","أَمْكَنْتَهُمْ مِنْ حاجَةِ المُسْتَمْكِنِ",66,"ن",1,0],["لا يجعلوك مماثلاً","فالله لم يخلق مثالك",67,"ك",1,0],["لا يَجزع الحر مِن المَصائب","كَلا وَلا يَخضع لِلنَوائب",68,"ب",1,0],["لا يَجِدُ العَيبُ إلَيهِ مُختَطَى","وَمَن يَرُم مُهَذَّباً أخَا كَرَم",69,"م",1,0],["لا يجتلي النور إلا من مشارقه","ويجتني الدر إلا من مجانيه",70,"ي",2,1],["لا يجدر استقلال جزءٍ سيمَّا","لمَدى العُضُوِّ بِهَيئَةٍ بَشرِيَّة",71,"ي",2,0],["لايُجبَرُ الناسُ شَيئاً هاضَهُ أَسَدٌ","يَوماً وَلا يَرتَقونَ الدَهرَ ما فَتَقا",72,"ق",2,0],["لا يجزيء الثغرَ خوار القناة ولا","هش المكاسر والقلب الذي يجف",73,"ف",1,0],["لا يَجذِبَنَّكَ حُسنٌ قَبلَ تَجرِبَةٍ","أَو لا فَلا غَروَ إِن أَرداكَ جاذِبُهُ",74,"ب",2,0],["لا يجاريه في المباراة خصمٌ","ومحالٌ يفرُّ من ميدانِ",75,"ن",1,0],["لا يجمعون إلى إِقامة ساقِطٍ","من عِزِّهم بيمينه مهدومِ",76,"م",1,0],["لا يجهلون ولا تدري مقاصدهم","سكناهم المجلس المعمورُ والقبرُ",77,"ر",1,0],["لا يجاريها الصبا في حلبة","إن جرت في البيد إرقالا ووخدا",78,"د",2,0],["لا يُجاوِرُكُمُ الصَّعيدُ بِسوء","فَهوَ لِلنّازِلينَ بِئسَ المجيرُ",79,"ر",1,0],["لا يَجتني ثمارَها مُجتَدٍ","وأكَّدَ العزمَ وقامَ وسعى",80,"ا",1,0],["لا يَجفل الخشف مِنهُ حينَ يرمقه","لِظَنِّه أَنَّهُ مِن بَعض أَهليه",81,"ي",2,0],["لا يجمع القلب القريح صَبابةً","وتأذّياً منه بمن يهواه",82,"و",3,0],["لا يجسُر الطيفُ يسري في منازلهم","مهابة خَيَّمت في مَطْمَحِ الفِكر",83,"ر",1,0],["لا يجرحون بنابهم ولكنهم","بنباحهم قد جرّحوا الأسماعا",84,"ع",2,0],["لا يجد المرء من يماثله","ومن يساويه في المزيات",85,"ت",1,0],["لا يجوزن أرضنا مضري","بخفير ولا بغير خفير",86,"ر",1,1],["لا يجوز الصراط إلا محب","منك يعطى الجواز وهو الولاء",87,"ا",2,0],["لا يجزعون وان جلت مصيبتهم","فكلما عظمت ارزائهم صبروا",88,"ر",3,0],["لا يُجيبُ الداعيهِ فيهِ وَلا يَر","جِعُ مِن عِندِهِ إِلَيهِ جَوابُ",89,"ب",1,0],["لا يَجمُدانِ عَلَيهِم عِندَ جَهدِهِم","كَلاهُما نافِعٌ فيهِم إِذا اِفتَقَروا",90,"ر",3,0],["لا يَجبُرونَ مَهِيضَها كلَّا ولا","يَهدُونَ من قد ضلَّ في القيعانِ",91,"ن",1,0],["لا يجلّون سوى من سكرا","أو اذا هامَ ببنت العنبِ",92,"ب",1,0],["لا يجهل الخير أدراهم وأجهلهم","ففيم عالمهم بالشر كظّان",93,"ن",1,0],["لا يجمع السمط منها درتين ولا","يرجى لها بعدَ وَهْيِ السمطِ قنيان",93,"ن",1,0],["لا يجاري آراء من يخدع النا","س على جهلهم أمور الحياة",94,"ه",1,0],["لا يجزعونَ إذا لم يُنصروا أسَفاً","يوماً ولا يرتدونَ العُجبَ إن نُصروا",95,"ر",3,0],["لا يَجدُرَنَّ بِنا أَن نَستَطيلَ إِلى","مَداكَ أَو نَر تاءي ما لا يَلوحُ لَنا",96,"ن",2,0],["لا يَجهَلُ الحيتانُ فَرداً فَرداً","يُعرَفُ بدء صَيدُها وَالحدا",97,"د",2,0],["لا يجلي ديجورها غير بدر","ينجلي في شروقه الديجور",98,"ر",1,0],["لا يجلّي دُجى الحوادث إِلا","غُررُ الحرب في وجوه الرّجال",99,"ل",1,0],["لا يجزعون اذ اللقا","ألقى للاقيه سهامه",100,"م",2,0],["لا يَجمَعُ المالَ إِلَّا رَيث يُتلِفُهُ","وَلا يُزَهِّدُهُ في العُرفِ مَن كَفَرا",101,"ر",2,0],["لا يَجحَدُ اللَّهُ بِالتَأَوُّلِ وَالشَّكْ","كِ وَلكِن جُحودَ مُعتَرِفِ",102,"ف",1,0],["لا يجتنى ثمر المنى من روضه","إلا فتى في ليله ما غمّضا",103,"ض",2,0],["لا يُجْتَنَى المَجْدُ إلاَّ بالظُّبَى لَمَعَتْ","تَحْتَ العَجاجِ فعادتْ بالدمِ القاني",104,"ن",2,0],["لا يجازي امرءً على الخير عبد","مرسلا كان في الورى أو وليا",105,"ي",2,0],["لا يجيني خاضع ٍ يبعد وراه","يشهد الله ماله بحبي ذرى",106,"ر",2,0],["‏‎لايجرح الحبُّ من نمّى أواصره","وليس يأسف من بالطيب يبنيه!",107,"ه",1,1],["لا يجارى العشّاق في رأفة القا","ب وحبّ العلى وجود اليمين",108,"ن",1,0],["لا يجازي المكر علماً أنه","سيء المكر بأهليه يحيق",109,"ق",1,0],["لايجبر الكسر كسر القلب والساق","إلا إذا ترجمت بالشعر أشواقي",110,"ق",2,1],["لايجي باكر يغني : (ياسقى الله وسقى)","كل شي ان طال زال الا القصايد ماتزال",111,"ل",1,0],["لا يَجْرُؤُ الشِّعْرُ أَنْ يَشْدُوْكَ قَافِيَةً","لَكِنَّهً اجْتَاحَنَا رَبْعاً وَوِجْدَانَا",112,"ن",2,0],["لا يَجْرِمَنّ فُؤَادَها شَنَآنُ قَو","مٍ قَدْ بَنَوْا لِلنّيلِ مِنْها مَعْبَدَا",113,"د",2,0],["لا يجْرُؤُ الذِّئْبُ سطْواً حينَ يرْدَعُهُ","بأْسُ الحُماةِ ولوْ أعْدى السَّراحينا !",114,"ن",2,0],["لا يجازى على الوصا","ل ولا يقبل الرّشا",115,"ش",2,0],["لا يجمع الله في الدارين من حِممٍ","ولا يعذّب قلباً مثخناً عشقا",116,"ق",2,0],["لا يجهلن أحد علينا, إننا","في كفنا تتلاعب الأرزاء",117,"ا",2,0],["لا يُجيدُ السكوت إلّا مماتاً","لا يُجيدُ الكلامَ إلّا قصيدا",118,"د",2,0],["لا يُجدِي الآنَ كلامٌ نَفْعا","اضربْ كَيْ تقطَعَ رأسَ الأفعى",119,"ع",2,1],["لا يجوز الكِذْب في أي مجالٍ","إنَّما الحقُّ دواماً هو شامَةْ",120,"م",2,0],["لِأيِّ جُرحٍ بروحي يكتبُ القلمُ","وأيُّ صوتٍ بصوتي راحَ يَضّطَرِمُ",121,"م",1,1],["لا يَجوعُ الإِنسانُ فيهِ وَيَعرى","فَيَبيعَ الأرواحَ بِالأجسادِ",122,"د",1,0],["لا يجزعون إذا ساح الوغى التطمت","فيه السيوف وماجت فوقه القضب",123,"ب",1,0]]}