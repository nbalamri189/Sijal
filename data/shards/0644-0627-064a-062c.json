{"poems":[[53,"من شافعي وذنوبي عندها الكبر","https://www.aldiwan.net/poem30415.html","البسيط"],[53,"كان قضاء الإله مكتوبا","https://www.aldiwan.net/poem30741.html","المنسرح"],[4,"طلل لخولة بالرسيس قديم","https://www.aldiwan.net/poem21193.html","الكامل"],[23,"إن الذوائب من فهر وإخوتهم","https://www.aldiwan.net/poem21254.html","البسيط"],[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[51,"ما لي يزاحمني الخلصان في طرقي","https://www.aldiwan.net/poem65711.html","البسيط"],[51,"أنى تشاغلت عن أبي حسنك","https://www.aldiwan.net/poem65777.html","الخفيف"],[51,"إنما يبكي شجي شجنه","https://www.aldiwan.net/poem66464.html","الرمل"],[91,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[70,"لأي جميل من جميلك أشكر","https://www.aldiwan.net/poem42919.html","الطويل"],[92,"أدركت فجر الحياة أعمى","https://www.aldiwan.net/poem38919.html","مخلع البسيط"],[89,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[89,"انما نهضة الامم","https://www.aldiwan.net/poem44855.html","مجزوء الخفيف"],[85,"ساجع الشرق طار عن أوكاره","https://www.aldiwan.net/poem62880.html","الخفيف"],[43,"حاشى الرقيب فخانته ضمائره","https://www.aldiwan.net/poem9571.html","البسيط"],[43,"قد علم البين منا البين أجفانا","https://www.aldiwan.net/poem10588.html","البسيط"],[62,"حضاننا السحق فلا","https://www.aldiwan.net/poem52145.html","مجزوء الرجز"],[62,"لا يجمد الماء بأجساده","https://www.aldiwan.net/poem52163.html","السريع"],[45,"لا دمنة بلوى خبت ولا طلل","https://www.aldiwan.net/poem65579.html","البسيط"],[66,"صبرا على وعد الزمان وإن لوى","https://www.aldiwan.net/poem41578.html","الكامل"],[80,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[80,"عجبي من سكينتي ووقاري","https://www.aldiwan.net/poem31439.html","الخفيف"],[44,"ما عهدنا كذا نحيب المشوق","https://www.aldiwan.net/poem30395.html","الخفيف"],[105,"ذهب السرور وولت الأعياد","https://www.aldiwan.net/poem43120.html","الكامل"],[105,"يا أيها الداعي وليس بمسمع","https://www.aldiwan.net/poem43140.html","الكامل"],[105,"ديار مكة هذا خالد دلفا","https://www.aldiwan.net/poem44044.html","الكامل"],[48,"أية نار قدح القادح","https://www.aldiwan.net/poem62540.html","السريع"],[46,"لا يجزعن من المنية عاقل","https://www.aldiwan.net/poem22631.html","الكامل"],[46,"بالغار من هضبي عماية نازل","https://www.aldiwan.net/poem22710.html","الكامل"],[46,"والمال يحويه جدوى من يجود به","https://www.aldiwan.net/poem23132.html","البسيط"],[76,"ما ضر عندك حاجتي ما ضرها","https://www.aldiwan.net/poem39318.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85523","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42644","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54920","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[85,"ساجعُ الشؤقِ طارَ عن أوكاره","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9603&r=&rc=93",""],[126,"أنا بحر هجو إن أردت جفائي","https://www.aldiwan.net/poem50677.html","الكامل"],[140,"هل في جنوب اللوى وجد فأطربه","https://www.aldiwan.net/poem58378.html","البسيط"],[141,"محض الإباء وسؤدد الآباء","https://www.aldiwan.net/poem11717.html","الكامل"],[167,"ماذا بنا في طلاب العز ننتظر","https://www.aldiwan.net/poem1631.html",""],[180,"حي رسما لمن تحيي ثراه","https://www.aldiwan.net/poem67075.html","الخفيف"],[193,"ليت شعري هل تخبرني الديار","https://www.aldiwan.net/poem54408.html","الخفيف"],[193,"أتعرف الدار أم لا تعرف الطللا","https://www.aldiwan.net/poem54422.html","البسيط"],[196,"أما وقد شردت تلك اليعافير","https://www.aldiwan.net/poem51940.html","البسيط"],[257,"كل شهم لذاته المدح صالح","https://www.aldiwan.net/poem35564.html","الخفيف"],[273,"لبانة المستهام لبنى","https://www.aldiwan.net/poem25508.html","مخلع البسيط"],[298,"لا يجفلون عن المضاف ولو رأوا","https://www.aldiwan.net/poem45438.html","الكامل"],[318,"بك العلا تظاهر","https://www.aldiwan.net/poem67198.html","مجزوء الرجز"],[320,"بان الخليط فقلبي اليوم مختلس","https://www.aldiwan.net/poem56356.html","البسيط"],[362,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[377,"من لنفس طال في الحب عناها","https://www.aldiwan.net/poem49195.html","الرمل"],[434,"ته فلو قستك بالظبي الغرير","https://www.aldiwan.net/poem2516.html","الرمل"],[456,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[466,"هدية من شاعر مطبوع","https://www.aldiwan.net/poem59893.html","الرجز"],[480,"سواطع التولي في أكتاف ذروته","https://www.aldiwan.net/poem24479.html","عموديه"],[493,"لو كان بالدهر لحر يدان","https://www.aldiwan.net/poem10281.html","السريع"],[549,"حييت يا ربع اللوى من مربع","https://www.aldiwan.net/poem47702.html","الكامل"],[549,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"]],"verses":[["لا يَجبُرونَ عَلى الأَيّامِ مَن وَهَنوا","بِالقارِعاتِ وَلا يَأسونَ مَن عَقَروا",0,"ر",3,0],["لا يَجِدُ الدَهرُ مَسلَكاً أَبَداً","وَلا طَريقاً إِلَيكَ مَلحوبا",1,"ب",2,0],["لا يَجتَويها ضَيفُهُم وَفَقيرُهُم","وَمُدَفَّعٌ طَرَقَ النُبوحَ يَتيمُ",2,"م",1,0],["لا يَجهَلونَ وَإِن حاوَلتَ جَهلَهُمُ","في فَضلِ أَحلامِهِم عَن ذاكَ مُتَّسَعُ",3,"ع",1,0],["لا يجهلن حليم إنني رجل","من كان أخطل جهل كنت جحّافا",4,"ف",2,0],["لا يجهلن على حلمي أخو ثقة","فالجهل من خلقي إن كان من خلقه",5,"ه",1,0],["لأيّ جُرمٍ غدوتَ تَلْفظُني","وكنتُ أحلى لديك من وسنِك",6,"ك",1,0],["لا يَجُر مولىً جليلٌ سنناً","في عُبيد لم يفارق سكنَه",7,"ن",2,0],["لا يَجزَعُ الشاعِرُ أَن يُقتَلا","لَيسَ وَراءَ القَبرِ سَيفٌ وَرُمح",8,"ح",1,0],["لِأَيِّ جَميلٍ مِن جَميلِكَ أَشكُرُ","وَأَيِّ أَياديكَ الجَليلَةِ أَذكُرُ",9,"ر",1,1],["لا يجتني الطَّرْفُ منه إلاَّ","عَواطفَ الشَّوْكِ والتُّرابْ",10,"ب",1,0],["لا يجاريك في الخلود قريضي","كل ما فيك قلته سيضيع",11,"ع",1,0],["لا يجوس العدو مملكة","جيشها انتظم",12,"م",1,0],["لا يُجازيهِ في تَفَنُّنِهِ العو","دُ وَلا يَشتَكي إِذا لَم يُجارِهِ",13,"ر",2,0],["لا يَجبُرُ الناسُ عَظماً أَنتَ كاسِرُهُ","وَلا يَهيضونَ عَظماً أَنتَ جابِرُهُ",14,"ر",2,0],["لا يَجذِبَنَّ رِكابي نَحوَهُ أَحَدٌ","ما دُمتُ حَيّاً وَما قَلقَلنَ كيرانا",15,"ن",2,0],["لا يجلب الصبغ الذي","تريده من بعدِ",16,"د",1,0],["لا يجمد الماء بأجساده","ما لم يكن بينهما الصمغة",17,"غ",2,1],["لايَجذِبُ الوَطَنُ المَألوفُ عَزمَتَهُ","وَلا الغَزالُ الَّذي في طَرفِهِ كَحَلُ",18,"ل",1,0],["لا يُجزِ عَنَّكَ أَنَّهُ رَفَعَ العِدى","فَلَسَوفَ يَهدِمهُ قَليلٌ ما بَنى",19,"ن",2,0],["لا يَجْزَعُونَ مِنَ المَنونِ كَأَنَّما","آجالُهُمْ لِنُفوسِهِم أعمارُ",20,"ر",1,0],["لا يُجَارَى لِسَبقِهِ فَلِهذا","لم يَجِدْ في مَدَى العُلى من يُجاري",21,"ر",2,0],["لا يَجوزُ الأُمورَ صَفحاً وَلا يُر","قِلُ إِلّا عَلى سَواءِ الطَريقِ",22,"ق",1,0],["لا يَجزَعِ العاني فَكُلٌّ زائِلٌ","وَلِكُلِّ دَولَةِ مَعشَرٍ ميعادُ",23,"د",1,0],["لا يَجهَلُ القَومُ الَّذينَ تَمَرَدّوا","أَنَّ الرِقابَ لِحُكمِهِم لا تَخضَعُ",24,"ع",1,0],["لا يَجْزَعِ القوْمُ إنّ السَّيفَ مُرتَدِعٌ","عمّا قليلٍ وإنّ النّصرَ قد أزِفا",25,"ف",2,0],["لا يَجتَلي الحَوراءَ مِن خِدرِها","إِلّا امرُؤٌ ميزانِهِ راجِحُ",26,"ح",1,0],["لا يَجزَعَنَّ مِنَ المَنِيَّةِ عاقِلٌ","فَالنَعشُ مَن نُعِشَ الفَتى أَن يَعثُرا",27,"ر",2,1],["لا يَجعَلَنَّ هِنداً هُنَيدَةً فُوَكَ فَالتَ","صغيرُ مَقرونٌ إِلى الإِصغارِ",28,"ر",1,0],["لا يَجمَعُ الفَضلَ بَل يُعطى العُلا رَجَبٌ","لِلحَربِ يُجبى وَيُعطى الفِطرَ شَوّالُ",29,"ل",1,0],["لا يَجْتَني حُلْوَ المَحامدِ ماجِدٌ","حتى يَذوقَ منَ المَطالبِ مُرَّها",30,"ر",3,0],["لا يجلي شاعر","لم يكن مبتكرا",31,"ر",2,0],["لا يَجْمُلُ الْمَرْءُ فِي ظَرْفٍ وَفِي أَدَبٍ","مَا لَمْ تَكُنْ فَوْقَ مَرْآهُ سَرَائِرُهُ",32,"ر",2,0],["لا يُجَارِي عَلى افْتِئَات","وَلا يَعْدَمُ مِنْهُ نَصِيرَهُ التَّفْكِيرُ",33,"ر",1,0],["لا يَجِدُ المأوَى ولو رَامَهُ","أحالَهُ الدهر على قَبْره",34,"ر",2,0],["لا يُجاريه في تفنُّنِه العو","دُ، ولا يَشْتكِي إذا لم يُجارِه",35,"ر",2,0],["لا يَجحَدُ الشمس المنيرة مُبصِرٌ","إلا صُوَيْحِبُ مُقْلَةٍ عمياءِ",36,"ا",2,0],["لا يجتبى ببيوت النافقاءِ ولا","يروح مشتملا ثوبا من الزورِ",37,"ر",1,0],["لا يَجحَدَنَّكَها الحَسودُ تَجاهُلاً","فَالصُبحُ لا يَخفى عَلى البُصَراءِ",38,"ا",2,0],["لا يَجبُرُ الدَهرُ هَيضاً في كَسيرِهِمُ","وَلا تَهيضُ يَدُ الأَيّامِ ما جَبَرُوا",39,"ر",3,0],["لا يَجهلُ الحسنَ ما بَينَ الوَرى أَحَداً","وَلَيسَ يَعلمُ مِنهُم كُنْههُ أَحَدُ",40,"د",1,0],["لا يُجيبُ الأَحياءَ مَن لَيسَ حَيّاً","وَالعَمى عِندَ غَيرِهِ الأَخبارُ",41,"ر",1,0],["لا يَجتَويهِ وَإِن طالَت إِقامَتُهُ","أَهلُ المَكانِ وَلا الأَرضُ الَّتي نَزَلا",42,"ل",2,0],["لا يجتبي المجدَ غَضَّاً غيرُ مُضطَغِنٍ","تَرْدِي به الجُرْد أو تُحدَى به العير",43,"ر",1,0],["لا يجارَى في حربه والمجاري","عاد من عجزه إلى السلم جانح",44,"ح",1,0],["لا يَجِدُ العَالِمونَ خَوْفاً","بِهِ ولا يَشْتَكُونَ حُزْنا",45,"ن",2,0],["لا يُجفِلونَ عَنِ المُضافِ وَلَو رَأَوا","أولى الوَعاوِعِ كَالغُطاطِ المُقبِلِ",46,"ل",1,1],["لا يَجحَدِ الفَضلُ سِوى","مَن لِلنَهارِ ناكِرُ",47,"ر",1,0],["لا يَجزَعونَ إِذا ما القَتلُ حَلَّ بِهِم","وَلا يُرَونَ فُراحى إِن هُمُ خَمِسوا",48,"س",3,0],["لا يَجتويه ناظِرُ مُرْتادُه","إن اهتدى ودَعْه إن لم يَهْتَد",49,"د",1,0],["لا يَجف الدَمع مِن أَجفان ذي","شَجن إِلّا إِذا الحُزن ثَناها",50,"ا",3,0],["لا يجودن بمال أبداً","بل يجودون بربّات الخدود",51,"د",1,0],["لا يَجلسُ الحلمُ ولا يركَبُ ال","خوفُ ولم تجلِس ولم تَركَبِ",52,"ب",1,0],["لا يَجبَهُ الحاجَةَ بِالتَضجيعِ","مِنَ المَحَلِّ الخَصِبِ المَريعِ",53,"ع",1,0],["لا يجمع الله بيني وبينه أبدا","فالأفق شيمته والسفك مكتتم",54,"م",1,0],["لا يجهل البازل سناً ولا","أُعلّم الخمرة إني عوان",55,"ن",1,0],["لا يَجمَعونَ المالَ إلّا للنّدى","أَو لاِصطِناع صنيعةٍ لم تُصنعِ",56,"ع",1,0],["لا يجد الذّمّ في حريمهمُ","مسعىً ولا العائبون مُضطَرَبا",57,"ب",2,0]]}