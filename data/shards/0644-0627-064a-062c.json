{"poems":[[55,"من شافعي وذنوبي عندها الكبر","https://www.aldiwan.net/poem30415.html","البسيط"],[55,"كان قضاء الإله مكتوبا","https://www.aldiwan.net/poem30741.html","المنسرح"],[4,"طلل لخولة بالرسيس قديم","https://www.aldiwan.net/poem21193.html","الكامل"],[23,"إن الذوائب من فهر وإخوتهم","https://www.aldiwan.net/poem21254.html","البسيط"],[53,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[53,"ما لي يزاحمني الخلصان في طرقي","https://www.aldiwan.net/poem65711.html","البسيط"],[53,"أنى تشاغلت عن أبي حسنك","https://www.aldiwan.net/poem65777.html","الخفيف"],[53,"إنما يبكي شجي شجنه","https://www.aldiwan.net/poem66464.html","الرمل"],[93,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[72,"لأي جميل من جميلك أشكر","https://www.aldiwan.net/poem42919.html","الطويل"],[94,"أدركت فجر الحياة أعمى","https://www.aldiwan.net/poem38919.html","مخلع البسيط"],[91,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[91,"انما نهضة الامم","https://www.aldiwan.net/poem44855.html","مجزوء الخفيف"],[87,"ساجع الشرق طار عن أوكاره","https://www.aldiwan.net/poem62880.html","الخفيف"],[45,"حاشى الرقيب فخانته ضمائره","https://www.aldiwan.net/poem9571.html","البسيط"],[45,"قد علم البين منا البين أجفانا","https://www.aldiwan.net/poem10588.html","البسيط"],[64,"حضاننا السحق فلا","https://www.aldiwan.net/poem52145.html","مجزوء الرجز"],[64,"لا يجمد الماء بأجساده","https://www.aldiwan.net/poem52163.html","السريع"],[47,"لا دمنة بلوى خبت ولا طلل","https://www.aldiwan.net/poem65579.html","البسيط"],[68,"صبرا على وعد الزمان وإن لوى","https://www.aldiwan.net/poem41578.html","الكامل"],[82,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[82,"عجبي من سكينتي ووقاري","https://www.aldiwan.net/poem31439.html","الخفيف"],[46,"ما عهدنا كذا نحيب المشوق","https://www.aldiwan.net/poem30395.html","الخفيف"],[107,"ذهب السرور وولت الأعياد","https://www.aldiwan.net/poem43120.html","الكامل"],[107,"يا أيها الداعي وليس بمسمع","https://www.aldiwan.net/poem43140.html","الكامل"],[107,"ديار مكة هذا خالد دلفا","https://www.aldiwan.net/poem44044.html","الكامل"],[50,"أية نار قدح القادح","https://www.aldiwan.net/poem62540.html","السريع"],[48,"لا يجزعن من المنية عاقل","https://www.aldiwan.net/poem22631.html","الكامل"],[48,"بالغار من هضبي عماية نازل","https://www.aldiwan.net/poem22710.html","الكامل"],[48,"والمال يحويه جدوى من يجود به","https://www.aldiwan.net/poem23132.html","البسيط"],[78,"ما ضر عندك حاجتي ما ضرها","https://www.aldiwan.net/poem39318.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85523","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42644","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54920","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[96,"تحيّة الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=15667",""],[87,"ساجعُ الشؤقِ طارَ عن أوكاره","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9603&r=&rc=93",""],[132,"أنا بحر هجو إن أردت جفائي","https://www.aldiwan.net/poem50677.html","الكامل"],[146,"هل في جنوب اللوى وجد فأطربه","https://www.aldiwan.net/poem58378.html","البسيط"],[147,"محض الإباء وسؤدد الآباء","https://www.aldiwan.net/poem11717.html","الكامل"],[173,"ماذا بنا في طلاب العز ننتظر","https://www.aldiwan.net/poem1631.html",""],[186,"حي رسما لمن تحيي ثراه","https://www.aldiwan.net/poem67075.html","الخفيف"],[199,"ليت شعري هل تخبرني الديار","https://www.aldiwan.net/poem54408.html","الخفيف"],[199,"أتعرف الدار أم لا تعرف الطللا","https://www.aldiwan.net/poem54422.html","البسيط"],[202,"أما وقد شردت تلك اليعافير","https://www.aldiwan.net/poem51940.html","البسيط"],[263,"كل شهم لذاته المدح صالح","https://www.aldiwan.net/poem35564.html","الخفيف"],[279,"لبانة المستهام لبنى","https://www.aldiwan.net/poem25508.html","مخلع البسيط"],[304,"لا يجفلون عن المضاف ولو رأوا","https://www.aldiwan.net/poem45438.html","الكامل"],[324,"بك العلا تظاهر","https://www.aldiwan.net/poem67198.html","مجزوء الرجز"],[326,"بان الخليط فقلبي اليوم مختلس","https://www.aldiwan.net/poem56356.html","البسيط"],[368,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[384,"من لنفس طال في الحب عناها","https://www.aldiwan.net/poem49195.html","الرمل"],[441,"ته فلو قستك بالظبي الغرير","https://www.aldiwan.net/poem2516.html","الرمل"],[461,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[471,"هدية من شاعر مطبوع","https://www.aldiwan.net/poem59893.html","الرجز"],[485,"سواطع التولي في أكتاف ذروته","https://www.aldiwan.net/poem24479.html","عموديه"],[498,"لو كان بالدهر لحر يدان","https://www.aldiwan.net/poem10281.html","السريع"],[554,"حييت يا ربع اللوى من مربع","https://www.aldiwan.net/poem47702.html","الكامل"],[554,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[757,"","https://poetry.dctabudhabi.ae/diwan/poem/17656","البسيط"]],"verses":[["لا يَجبُرونَ عَلى الأَيّامِ مَن وَهَنوا","بِالقارِعاتِ وَلا يَأسونَ مَن عَقَروا",0,"ر",3,0],["لا يَجِدُ الدَهرُ مَسلَكاً أَبَداً","وَلا طَريقاً إِلَيكَ مَلحوبا",1,"ب",2,0],["لا يَجتَويها ضَيفُهُم وَفَقيرُهُم","وَمُدَفَّعٌ طَرَقَ النُبوحَ يَتيمُ",2,"م",1,0],["لا يَجهَلونَ وَإِن حاوَلتَ جَهلَهُمُ","في فَضلِ أَحلامِهِم عَن ذاكَ مُتَّسَعُ",3,"ع",1,0],["لا يجهلن حليم إنني رجل","من كان أخطل جهل كنت جحّافا",4,"ف",2,0],["لا يجهلن على حلمي أخو ثقة","فالجهل من خلقي إن كان من خلقه",5,"ه",1,0],["لأيّ جُرمٍ غدوتَ تَلْفظُني","وكنتُ أحلى لديك من وسنِك",6,"ك",1,0],["لا يَجُر مولىً جليلٌ سنناً","في عُبيد لم يفارق سكنَه",7,"ن",2,0],["لا يَجزَعُ الشاعِرُ أَن يُقتَلا","لَيسَ وَراءَ القَبرِ سَيفٌ وَرُمح",8,"ح",1,0],["لِأَيِّ جَميلٍ مِن جَميلِكَ أَشكُرُ","وَأَيِّ أَياديكَ الجَليلَةِ أَذكُرُ",9,"ر",1,1],["لا يجتني الطَّرْفُ منه إلاَّ","عَواطفَ الشَّوْكِ والتُّرابْ",10,"ب",1,0],["لا يجاريك في الخلود قريضي","كل ما فيك قلته سيضيع",11,"ع",1,0],["لا يجوس العدو مملكة","جيشها انتظم",12,"م",1,0],["لا يُجازيهِ في تَفَنُّنِهِ العو","دُ وَلا يَشتَكي إِذا لَم يُجارِهِ",13,"ر",2,0],["لا يَجبُرُ الناسُ عَظماً أَنتَ كاسِرُهُ","وَلا يَهيضونَ عَظماً أَنتَ جابِرُهُ",14,"ر",2,0],["لا يَجذِبَنَّ رِكابي نَحوَهُ أَحَدٌ","ما دُمتُ حَيّاً وَما قَلقَلنَ كيرانا",15,"ن",2,0],["لا يجلب الصبغ الذي","تريده من بعدِ",16,"د",1,0],["لا يجمد الماء بأجساده","ما لم يكن بينهما الصمغة",17,"غ",2,1],["لايَجذِبُ الوَطَنُ المَألوفُ عَزمَتَهُ","وَلا الغَزالُ الَّذي في طَرفِهِ كَحَلُ",18,"ل",1,0],["لا يُجزِ عَنَّكَ أَنَّهُ رَفَعَ العِدى","فَلَسَوفَ يَهدِمهُ قَليلٌ ما بَنى",19,"ن",2,0],["لا يَجْزَعُونَ مِنَ المَنونِ كَأَنَّما","آجالُهُمْ لِنُفوسِهِم أعمارُ",20,"ر",1,0],["لا يُجَارَى لِسَبقِهِ فَلِهذا","لم يَجِدْ في مَدَى العُلى من يُجاري",21,"ر",2,0],["لا يَجوزُ الأُمورَ صَفحاً وَلا يُر","قِلُ إِلّا عَلى سَواءِ الطَريقِ",22,"ق",1,0],["لا يَجزَعِ العاني فَكُلٌّ زائِلٌ","وَلِكُلِّ دَولَةِ مَعشَرٍ ميعادُ",23,"د",1,0],["لا يَجهَلُ القَومُ الَّذينَ تَمَرَدّوا","أَنَّ الرِقابَ لِحُكمِهِم لا تَخضَعُ",24,"ع",1,0],["لا يَجْزَعِ القوْمُ إنّ السَّيفَ مُرتَدِعٌ","عمّا قليلٍ وإنّ النّصرَ قد أزِفا",25,"ف",2,0],["لا يَجتَلي الحَوراءَ مِن خِدرِها","إِلّا امرُؤٌ ميزانِهِ راجِحُ",26,"ح",1,0],["لا يَجزَعَنَّ مِنَ المَنِيَّةِ عاقِلٌ","فَالنَعشُ مَن نُعِشَ الفَتى أَن يَعثُرا",27,"ر",2,1],["لا يَجعَلَنَّ هِنداً هُنَيدَةً فُوَكَ فَالتَ","صغيرُ مَقرونٌ إِلى الإِصغارِ",28,"ر",1,0],["لا يَجمَعُ الفَضلَ بَل يُعطى العُلا رَجَبٌ","لِلحَربِ يُجبى وَيُعطى الفِطرَ شَوّالُ",29,"ل",1,0],["لا يَجْتَني حُلْوَ المَحامدِ ماجِدٌ","حتى يَذوقَ منَ المَطالبِ مُرَّها",30,"ر",3,0],["لا يجلي شاعر","لم يكن مبتكرا",31,"ر",2,0],["لا يَجْمُلُ الْمَرْءُ فِي ظَرْفٍ وَفِي أَدَبٍ","مَا لَمْ تَكُنْ فَوْقَ مَرْآهُ سَرَائِرُهُ",32,"ر",2,0],["لا يُجَارِي عَلى افْتِئَات","وَلا يَعْدَمُ مِنْهُ نَصِيرَهُ التَّفْكِيرُ",33,"ر",1,0],["لا يَجِدُ المأوَى ولو رَامَهُ","أحالَهُ الدهر على قَبْره",34,"ر",2,0],["لا يجزع الوطن المدلّ بحقّه","ألباسمون مع الشباب حماته",35,"ت",2,0],["لا يُجاريه في تفنُّنِه العو","دُ، ولا يَشْتكِي إذا لم يُجارِه",36,"ر",2,0],["لا يَجحَدُ الشمس المنيرة مُبصِرٌ","إلا صُوَيْحِبُ مُقْلَةٍ عمياءِ",37,"ا",2,0],["لا يجتبى ببيوت النافقاءِ ولا","يروح مشتملا ثوبا من الزورِ",38,"ر",1,0],["لا يَجحَدَنَّكَها الحَسودُ تَجاهُلاً","فَالصُبحُ لا يَخفى عَلى البُصَراءِ",39,"ا",2,0],["لا يَجبُرُ الدَهرُ هَيضاً في كَسيرِهِمُ","وَلا تَهيضُ يَدُ الأَيّامِ ما جَبَرُوا",40,"ر",3,0],["لا يَجهلُ الحسنَ ما بَينَ الوَرى أَحَداً","وَلَيسَ يَعلمُ مِنهُم كُنْههُ أَحَدُ",41,"د",1,0],["لا يُجيبُ الأَحياءَ مَن لَيسَ حَيّاً","وَالعَمى عِندَ غَيرِهِ الأَخبارُ",42,"ر",1,0],["لا يَجتَويهِ وَإِن طالَت إِقامَتُهُ","أَهلُ المَكانِ وَلا الأَرضُ الَّتي نَزَلا",43,"ل",2,0],["لا يجتبي المجدَ غَضَّاً غيرُ مُضطَغِنٍ","تَرْدِي به الجُرْد أو تُحدَى به العير",44,"ر",1,0],["لا يجارَى في حربه والمجاري","عاد من عجزه إلى السلم جانح",45,"ح",1,0],["لا يَجِدُ العَالِمونَ خَوْفاً","بِهِ ولا يَشْتَكُونَ حُزْنا",46,"ن",2,0],["لا يُجفِلونَ عَنِ المُضافِ وَلَو رَأَوا","أولى الوَعاوِعِ كَالغُطاطِ المُقبِلِ",47,"ل",1,1],["لا يَجحَدِ الفَضلُ سِوى","مَن لِلنَهارِ ناكِرُ",48,"ر",1,0],["لا يَجزَعونَ إِذا ما القَتلُ حَلَّ بِهِم","وَلا يُرَونَ فُراحى إِن هُمُ خَمِسوا",49,"س",3,0],["لا يَجتويه ناظِرُ مُرْتادُه","إن اهتدى ودَعْه إن لم يَهْتَد",50,"د",1,0],["لا يَجف الدَمع مِن أَجفان ذي","شَجن إِلّا إِذا الحُزن ثَناها",51,"ا",3,0],["لا يجودن بمال أبداً","بل يجودون بربّات الخدود",52,"د",1,0],["لا يَجلسُ الحلمُ ولا يركَبُ ال","خوفُ ولم تجلِس ولم تَركَبِ",53,"ب",1,0],["لا يَجبَهُ الحاجَةَ بِالتَضجيعِ","مِنَ المَحَلِّ الخَصِبِ المَريعِ",54,"ع",1,0],["لا يجمع الله بيني وبينه أبدا","فالأفق شيمته والسفك مكتتم",55,"م",1,0],["لا يجهل البازل سناً ولا","أُعلّم الخمرة إني عوان",56,"ن",1,0],["لا يَجمَعونَ المالَ إلّا للنّدى","أَو لاِصطِناع صنيعةٍ لم تُصنعِ",57,"ع",1,0],["لا يجد الذّمّ في حريمهمُ","مسعىً ولا العائبون مُضطَرَبا",58,"ب",2,0],["لايُجبَرُ الناسُ شَيئاً هاضَهُ أَسَدٌ","يَوماً وَلا يَرتَقونَ الدَهرَ ما فَتَقا",59,"ق",2,0]]}