535,"","https://poetry.dctabudhabi.ae/diwan/poem/72444","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120467","الوافر"],[4764,"بغير الوهم ما شفته","https://www.poetsgate.com/ViewPoem.aspx?id=32993",""],[4782,"جفاك النوم","https://www.poetsgate.com/ViewPoem.aspx?id=201017",""],[1012,"السجسج","https://www.poetsgate.com/ViewPoem.aspx?id=186252",""],[4935,"لئام الناس أيديها","https://www.poetsgate.com/ViewPoem.aspx?id=129368",""],[5219,"ذكريات العيد","https://www.poetsgate.com/ViewPoem.aspx?id=193952",""],[5277,"أماسي بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=198377",""],[5363,"رحيلك مرٌّ (رثاء)","https://www.poetsgate.com/ViewPoem.aspx?id=200029",""],[5369,"اعترف","https://www.poetsgate.com/ViewPoem.aspx?id=177442",""],[5376,"توشَّحَ الليلُ في أغوارِ لوحاتي","https://www.poetsgate.com/ViewPoem.aspx?id=205053",""],[5431,"ومازال للعشاق غيمٌ ومرتفعْ!!","https://www.poetsgate.com/ViewPoem.aspx?id=199292",""],[5722,"الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=12690",""],[5722,"آذار","https://www.poetsgate.com/ViewPoem.aspx?id=12684",""],[5725,"تداعى علينا القوم","https://www.poetsgate.com/ViewPoem.aspx?id=177466",""],[5847,"عمان في عيدها","https://www.poetsgate.com/ViewPoem.aspx?id=8560",""],[5957,"عراقية النبض تهدي السلام","https://www.poetsgate.com/ViewPoem.aspx?id=177054",""],[5975,"أنا في هذه الدنيا سجينُ","https://www.poetsgate.com/ViewPoem.aspx?id=53401",""],[6031,"تَوَشَّحَتِ السَّمَاءُ بِبُرْدِ غَيْمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=46337",""],[6212,"عيون الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1622&r=&rc=3",""]],"verses":[["توشّحَ منْ زُهْرِ النّجومِ قِلادَةً","ومنْ قَلَقِ الإصْباحِ أصْبَحَ في بُرْدِ",0,"د",1,0],["تُوَشّي البَلاغَةَ أَقلامُهُ","إِذا ما الضَميرُ عَلَيها أَمَلّ",1,"ل",1,0],["تَوَشَّحتُ الضُحى وَاللَيلَ","في أُنسي وَفي حُزني",2,"ي",1,0],["توشَّحنَ من هذا اليمانيّ مِثْلما","تأزَّرْنَ من ذاكَ المُلاءِ المُزَعْفرا",3,"ر",2,0],["توشَّحَتْ بِمُلاةٍ غَيْرِ مُلْحمةٍ","مِنْ نَوْرِها ورِداءٍ غَيْرِ مَنْسُوجِ",4,"ج",1,0],["توشك النار أَن تَثور بأَيدٍ","آثماتٍ يعملن للإيقاد",5,"د",1,0],["تُوشِكُ الزِّينَةُ البَدِيعَةُ أَنْ","تَخْلِطَ مَا بَيْنَ أَرْضِنَا وَالسَّمَاءِ",6,"ا",2,0],["توشح منهم بالنجوم فمذهوت","تعمت على أهل البلاد المعالم",7,"م",1,0],["توشح من زهر النجوم قلادة","ومن فلق الإصباح أصبح في برد",8,"د",1,0],["تَوَشحت الوَزارَة من علاه","بَعقد صانَها مِن كل زور",9,"ر",1,0],["تَوَشَّت رِياضُ الأَرضِ بُشرى بِمُلكِكُم","وَقَد رَقَصَت فيها الغُصونُ النَواعِمُ",10,"م",1,0],["توشح منهم مفرق العز فانثوا","خيلان وجوه في مفاخر سمطان",11,"ن",1,0],["توشح ماء الواشحي صفاؤه","وأشرق من أفلاك معناه شارقُه",12,"ق",2,0],["توشَّجت مثل خطف البرق بينهما","أواصرُ الود تدنيها وتدنيه",13,"ي",2,0],["توشَّح من حجلها خصرها","وتدني الوشاح على الساقِ خجلا",14,"ل",2,0],["توشيحه والقوافي","ملوك تبع تولى",15,"ل",2,0],["توشك أنفاسها وقد صعدت","أن تحرقَ القوم في تسعُّرها",16,"ر",3,0],["تَوَشَّحَ بِالمَجدِ الصَميمِ وَشَمَّرَت","بهِ لِاِبتِناءِ المَكرُماتِ العَزائِم",17,"م",1,0],["توشِكُ أَن لا تُتِمَّ وَصلَ أَخٍ","في كُلِّ زَلّاتِهِ تُنافِرُهُ",18,"ر",2,0],["توشيع آياتهِ مذ أُعلنت فضحت","ضلالة الملحدينِ ابليس والصنمِ",19,"م",1,0],["توشَّحَ قَلبي فِي هَواهُ لِأَنَّهُ","يَحِلُّ محلَّ السَمع مِنِّي والبَصَر",20,"ر",1,0],["توشَّح بالكمال فكان فردا","همامٌ من كرام الناس عُدَّا",21,"د",2,1],["توشحوا اللَه لمَّا إِنَّهم خلعوا","ثوبَ الوُجودِ وأَلقوه إلى العَدَمِ",22,"م",1,0],["توشجت الأحقاد بين ضلوعه","كما اشتبكت تحت التراب جذور",23,"ر",1,0],["توشك النسمةُ أن تصرعها","كلما مرت بها في عجل",24,"ل",1,0],["تُوشِكُ النسمَةُ إذ تحمِلُه","عنك أن تحسُدَ فيهِ السامِعينا",25,"ن",2,0],["توشحت في وشاح الرود","منها المعاني انبرت أرواحا",26,"ح",2,0],["توشت به ديباجة الشرف الذي","أعار طراز المجد من حسنه وشيا",27,"ي",2,0],["توشح بالكمال فكل ثوب","يقل به يليق ويستجاد",28,"د",1,0],["توشح من جمال الروح ملامح ما تذكرني","سوى اني عشقت انسان بغير الوهم ما شفته",29,"ت",2,0],["توشحتِ السهاد فذاب قلبي","وأوردكِ الهوى ريب الهلاك",30,"ك",1,0],["توشح شعري بأنوارهم","حلي كمال به يبلج",31,"ج",1,0],["توشحنا وشاح ولا","بعرفان به نسري",32,"ر",2,0],["توشحت واكتست من ليلها سحبا","من للطفولة يجلو الليل والسحبا",33,"ب",2,0],["توشّحتْ من بريقِ النجمِ وجنتهُا","ويغسلُ الروحَ من أخلاقها الغدقُ",34,"ق",1,0],["توشّحتِ الأسفارُ لمّا هَجَرْتَها","سواداً حداداً والبياض تُخاصمُ",35,"م",1,0],["تُوشكُ العينُ تغيضُ","والبحيراتُ تجِفّ",36,"ف",1,1],["توشَّحَ الليلُ في أغوارِ لوحاتي","فيها مكبلةٌ عنقاءٌ آهاتي",37,"ت",2,1],["توشحَ فيها الحبُ ثوبَ فضيلةٍ","وخالطت الألوان نورا بها لمعْ",38,"ع",1,0],["توشَّحَ بالعبقِ المستطابِ","وغلغل في البهجةِ الضَّافيهْ",39,"ي",2,0],["توشحها مائجات الغيوم","وأطياف أجنحها الضافيه",40,"ي",2,0],["توشح بالانجاسِ لصُّ وقاتلٌ","ودجج في غدرٍ علينا عصائبُ",41,"ب",1,0],["توشحت بالسعد ياقائدا","مددت لشعبك كف الكرم",42,"م",1,0],["توشوش للطير يشدو النخيل","فتعشب أحلامها العاثرة",43,"ر",2,0],["توشَّحني الظلامُ وليتَ شعري","ففي السجنِ الظلامُ هنا دفينُ",44,"ن",1,0],["تَوَشَّحَتِ السَّمَاءُ بِبُرْدِ غَيْمٍ","فَأجْمِلْ بالمُوشَّحِ والوِشَاحِ",45,"ح",1,1],["تُوشِّح ربّةَ الإلهام سيفاً","وتلعنُ عاثرَ الحظّ الشَّحيحِ!",46,"ح",1,0]]}