tps://poetry.dctabudhabi.ae/diwan/poem/40107","البسيط"],[4469,"","https://poetry.dctabudhabi.ae/diwan/poem/103164","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76756","الكامل"],[4679,"يجد الفتى كما يعيش مُخلَّدَا","https://www.poetsgate.com/ViewPoem.aspx?id=142735",""],[4788,"يا سيده","https://www.poetsgate.com/ViewPoem.aspx?id=132280",""],[4797,"الكورة","https://www.poetsgate.com/ViewPoem.aspx?id=50250",""],[4816,"عمان","https://www.poetsgate.com/ViewPoem.aspx?id=15736",""],[5186,"يوم كأسبوع وشهر كعام","https://www.poetsgate.com/ViewPoem.aspx?id=156514",""],[5198,"شمع وشمعدان","https://www.poetsgate.com/ViewPoem.aspx?id=135070",""],[5199,"دمتي","https://www.poetsgate.com/ViewPoem.aspx?id=145544",""],[2365,"مالك فى الجهل من عذير","https://www.poetsgate.com/ViewPoem.aspx?id=200647",""],[5409,"روحي النس لا يهم الزمانا","https://www.poetsgate.com/ViewPoem.aspx?id=155516",""],[5433,"حمرت الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=36234",""],[5455,"يبه","https://www.poetsgate.com/ViewPoem.aspx?id=34696",""],[5525,"مني السلام","https://www.poetsgate.com/ViewPoem.aspx?id=7260",""],[5573,"كل ماقلت هانت واحتكمها حكيم","https://www.poetsgate.com/ViewPoem.aspx?id=200089",""],[5573,"بكت عيني اليمنى بدمع وزجرتها","https://www.poetsgate.com/ViewPoem.aspx?id=200219",""],[5720,"الْصُّفَّةُ *","https://www.poetsgate.com/ViewPoem.aspx?id=199180",""],[5725,"يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=211258",""],[5739,"اكتبيني بقرطاس ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131226",""],[5777,"قم فَقد لاح بريق الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=157258",""],[402,"يا مسهد القوم أطلت السنة","https://www.poetsgate.com/ViewPoem.aspx?id=36826",""],[5794,"كنز لا يفنى ..","https://www.poetsgate.com/ViewPoem.aspx?id=80285",""],[5794,"قلب جدا ..","https://www.poetsgate.com/ViewPoem.aspx?id=80286",""],[5847,"ألم وأمل","https://www.poetsgate.com/ViewPoem.aspx?id=6444",""],[5848,"يصير خير","https://www.poetsgate.com/ViewPoem.aspx?id=53208",""],[6008,"يالله يلي معتلي في سماكا","https://www.poetsgate.com/ViewPoem.aspx?id=60805",""],[6056,"يوم العيد الوطني","https://www.poetsgate.com/ViewPoem.aspx?id=156217",""],[6152,"أمتي","https://www.poetsgate.com/ViewPoem.aspx?id=203274",""],[5309,"في نظام مرصع الأصفاد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573552",""],[6185,"غزو الهموم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87032&r=&rc=18",""],[6359,"نخلة الوادي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69091&r=&rc=5",""]],"verses":[["يَومَ كَفَّنّاهُ في آمالِنا","وَذَكَرنا عِندَهُ قَولَ حَبيبِ",0,"ب",1,0],["يَومٌ كَأَيّامِ لَذّاتٍ لَنا انصَرَمَت","بِتنا لَها حينَ نامَ الدَهرُ سُرّاقا",1,"ق",2,0],["يوم كانت ربوعنا تحت رقٍ","وبنوها الأحرار في الأغلال",2,"ل",1,0],["يَوْمُكَ فِي لُبْنَانَ يَوْمٌ لَهُ","أَنْبَاؤُهُ فِي آخِرِ الأَزْمِنَهْ",3,"ن",2,0],["يومٌ كأنَّ سماءَهُ","تحكي جفوني حين بِنتا",4,"ت",2,1],["يوم كيوم الصحو في إشراقه","وغد كيوم الغيث في الإغداق",5,"ق",1,0],["يومك الحاتمي والتارك الخص","م مُزِلّاً مقامه زحلوقا",6,"ق",2,0],["يوم كوجه الغول وفي","شدقيه انياب تصر",7,"ر",1,0],["يوم كنا نسير جنباً لجنب","في طريق الهوى ولا نتنكب",8,"ب",1,0],["يوم كنا ولا تسل كيف كنا","نتلاقى والعيش رغد رخاء",9,"ا",2,0],["يَومَ كُنّا وَلا تَسَل كَيفَ كُنّا","نَتَهادى مِنَ الهَوى ما نَشاءُ",10,"ا",2,0],["يَومٌ كَبَدرٍ فَخَيلُ الحَقِّ راقِصَةٌ","عَلى الصَعيدِ وَخَيلُ اللَهِ في السُحُبِ",11,"ب",1,0],["يَومَ كانَ المُقامُ في الدارِ شَكّاً","يَبعَثُ الحُزنَ وَالرَحيلُ يَقينا",12,"ن",2,0],["يوْمٌ كأنّ نسِيمَهُ","نفحاتُ كافورٍ ومسكِ",13,"ك",1,1],["يومٌ كأنّ القَطْرَ فيهِ لؤلؤٌ","يَنْظِمُ للرّوضِ عُقُوداً وَوُشَح",14,"ح",1,0],["يَومَ كُنا نَقول عاكَسنا الده","رُ وَجَدنا مِن صحبنا مَن يَلوم",15,"م",1,1],["يَوم كانَت قُلوبنا تَتَلظى","وَالعِدى توسع البِلاد اِحتِمالا",16,"ل",2,0],["يومُكَ أجدى من مَعادي بلا","كُفْرانَ للّهِ ولا فِسْق",17,"ق",1,0],["يومٌ كبدرٍ في الفتوح منزلهْ","أمسى هرقل بعده لا عزّ لهْ",18,"ه",1,0],["يوم كيوم السامري لولا","دفع أبي بكر وعون المولى",19,"ل",2,0],["يوم كنا في الحقل نمرحُ زهوا","وسليمى معنا وهندٌ وسلوى",20,"ا",1,0],["يوم كنا نقرا هجاء وكرجا","وسليمى تمحو الأساطِرَ غثنجا",20,"ا",1,0],["يَومٌ كَأَنَّ الأَرضَ فيهِ عانَقَت","صَدرَ السَماءِ بِعارِضٍ مُنقادِ",21,"د",1,0],["يوْمٌ كأَنَّ ضِيَاءَه مِنْ أَعْيُنٍ","مِنْ طُولِ ما اتّجَهتْ له الأَنْظارُ",22,"ر",1,0],["«يوم كُنَّا، ولا تسل: كيف كنَّا»","كلُّ جيشٍ بقائد وجنود",23,"د",1,0],["يومَ كنّا والهوى غضٌّ وما","فُتِحَتْ إلاّ على الطُهْر العُيون",24,"ن",1,0],["يَومٌ كَأَن الدَهر سامحنا بِهِ","فَصارَ اِسمُهُ ما بَيننا هبة الدَهر",25,"ر",1,1],["يَومُكَ أَبقى أَخاكَ ديناً","إِبليسَ مُستَهلَكَ العَزيمَه",26,"م",2,0],["يومك في فرحة كعام","تراه عاما وليس عاما",27,"م",2,0],["يوم كنّا نتعاطى","الراح سرّاً ونصلّي",28,"ي",1,0],["يومَ كانَ الفؤادُ كالروضةِ الغنا","ءِ تجني يد الهوى منهُ زهرا",29,"ر",2,0],["يَومَ كانَ الحُبُّ فَرضا","صافِياً كَالعسجَدِ",30,"د",1,0],["يوم كأنّ الريح في أرجائِهِ","لُحُفٌ مشقَّة تمرّ وترجِع",31,"ع",1,0],["يَوْمٌ كَفانا مِنَ اللَّذّاتِ أَنَّ بِهِ","لَمْ تَطْلُعِ الشَّمْسُ حَتّى زارَنا الْقَمَرُ",32,"ر",1,0],["يؤمُّكَ رضوانٌ من اللَه واسعٌ","يقرِّب من ضُمِّنتَ من رَبِّها زُلفا",33,"ف",2,0],["يومٌ كيومِ الدينِ لا وَزَرٌ بهِ","وَلكلّ مرءٍ منهُ شأنٌ مقنعُ",34,"ع",1,0],["يوم كانت منى وكنت هواها","قبل أن أصطلى بنار الهوان",35,"ن",1,0],["يوم كان الزمان فيك ربيعا","عبقريّاً وكنت روح الربيع",36,"ع",1,0],["يوم كانت ألفاظها تتثنّى","رقةً لم يبلغ رحيقٌ مداها",37,"ه",2,0],["يَومٌ كأنّ اللهَ بَثَّ جُنودَه","للحَقِّ فيه منَ الضَّلالِ مُديلا",38,"ل",2,0],["يوم كانت ترعى الشياه ويرعى","قيس أغنامه فتشدو ويشدو",39,"و",1,0],["يوم كانت يا لهفة الشاعر العا","شق ماذا قد أبقت الأقدار؟",39,"ر",1,0],["يوم كانَ الوداع إذ آل ميٍّ","قوَّضوها ركائباً وظعونا",40,"ن",2,0],["يومَ كانَ الفرار أهونَ من أنْ","تستبيح السُّيوف منها قتيلا",41,"ل",2,0],["يوم كظل الرمح قصر طولهُ","لمع السوابق وانقضاض أسابر",42,"ر",1,0],["يومٌ كهذا اليوم تهتف عنده","مُهجُ الشعوبِ العانياتِ هُتافي",43,"ف",2,0],["يوم كنا فيما يرى توأمين","لست أنسى ولم يزل نصب عيني",44,"ي",1,0],["يوم كنا ولا تسل كيف كنا","وكلانا في المهيعين سواء",45,"ا",2,0],["يوم كنا ونحن فيه نشاوى","نتهادى من الهوى ما نشاء",45,"ا",2,0],["يوم كساه الاستياء مهابة","ساد السكون فأكبرته الأعين",46,"ن",1,0],["يوم كأن الجيش تحت قتامه","سر بأثناء الجوانح مضمر",47,"ر",1,0],["يومٌ كأنّ أُسودَ الغاب ضاريةٌ","فرسانُهُ وقنا فرسانِهِ الأَجَمُ",48,"م",1,0],["يوم كواكب سعده طلعت لنا","وجرى الهنا بحراً فكل يغرف",49,"ف",1,0],["يوم كانت بنو معد بن عدنا","ن مهيباً جهادها والدفاع",50,"ع",1,0],["يوم كان العقاب يخفق في الج","وومنه نسر الأعادني يراع",50,"ع",1,0],["يومٌ كأنَّ نَسيمَه من عنَبرِ","وتخالُ أنَّ أديَمه من جوهرِ",51,"ر",1,1],["يوم كيوم الحشر ضمهمُ وكم","رحَّبتَ في أرب لهم مضمارا",52,"ر",2,0],["يومٌ كما تشتهيه مُصطَبحٌ","وفوق ما يشتهيه مُغْتَبق",53,"ق",1,0],["يومٌ كأن الشمس فيه خريدةٌ","حسناءُ من خَلَل السُّجوف تَطلَّع",54,"ع",1,0],["يومُك اليومُ فميدي يا ربانا","وانتفض يا سهلُ زهوا وافتتانا",55,"ن",2,1],["يوم كنا والمنايا حُوَّمُ","غتلي تحت لواهم ولوانا",55,"ن",2,0],["يَومٌ كَلَيْلِ الوِصالِ مُتَّصِلٌ","بِلَيْلَةٍ صِبْغُها مِنَ العَلَقِ",56,"ق",1,0],["يوم كنا نرى الجحيم نعيما","ونرى القدس كله في العجوز",57,"ز",1,0],["يوم كنا إذا ادلهمَّ ظلام","الليل واشتد برد يوم العجوز",57,"ز",1,0],["يوم كان الإدمان يبدو علينا","أين كنا لا سيما في العجوز",57,"ز",1,0],["يوم كانت لنا العزيمة تهتز","وتفري الهموم مثل العجوز",57,"ز",1,0],["يوم كنا إذا سمعنا زئيراً","من عجوز خلناه صوت عجوز",57,"ز",1,0],["يوم كان النعيم أن","نتلهى ونلعبا",58,"ب",2,0],["يوم كنا نرى الحياة","غراماً وملعبا",58,"ب",2,0],["يوم كانت لنا العزيمة","كالسيف مضربا",58,"ب",2,0],["يوم كانت يد الهوى","تجعل القلب لولبا",58,"ب",2,0],["يوم كان الراحلُ النَّدبُ يجود","بلباب العلم يغذو كل حس",59,"س",1,0],["يوم كلٍ بات بامره مستجير","ينتظر الفلوس ما عنده مَره",60,"ر",2,0],["يومكم يوم سعيد سلسبيل","لم تره بثينة ولا جميل",61,"ل",1,0],["يوم كأن سماءه","مثل الحصان الأبرش",62,"ش",1,1],["يومك يا هاشم تأريخه","أقراك في الجنة بحر العلوم",63,"م",1,0],["يوم كأن سحابه","لبست غمامي المصامت",64,"ت",1,1],["يوم كنا مثل أملاك السما","نتناجى تحت ظل الشجر",65,"ر",1,0],["يَومَ كانَ الكَهفُ يَبدو مَسكَناً","وَلَبوسُ القَومِ جِلدُ البَهَمِ",66,"م",1,0],["يَومَ كانوا في ظَلامٍ حالِكٍ","وَمَراحُ الكُلِّ خيسُ العُصُمِ",66,"م",1,0],["يوم كنا نهيم في جنة الدن","يا ونقضي شبابنا أحلاما",67,"م",2,0],["يومَ كنّا في بساتين الصِّبَا","من ثمار الحبّ نجني ما اشتهينا",68,"ن",2,0],["يومَ كان العدلُ من أركانها","ولها عطفٌ على أوطانها",69,"ه",2,0],["يَوم كأنّ عجاجه وَسبوحه","بحرٌ طمى وَأَبو قبيس قَد رَسا",70,"س",2,0],["يوم كيوم محمد والخلق من","دهش المصاب مطاشة الأحلام",71,"م",1,0],["يومكم ما كان أعظمه","لم يبق صبرا لنا عنكم وسلوانا",72,"ن",2,0],["يوم كشف اللثام كم نلت قصدا","بالتثام الثغر المنظم عقدا",73,"د",2,0],["يؤمك مِن شَرق البِلاد وَغَربِها","مِن الوَفد راجي الرَفد أَشعَث أَغبَرا",74,"ر",2,0],["يَومٌ كَإِبهام القَطاةِ اِنقَضى","وَمَذهَبي فيما اِنقَضى مَذهَبي",75,"ب",2,0],["يوم كنا نغنم الأن","س صباحا ومساء",76,"ا",2,0],["يوم كنا لا نرى من","دهرنا إلا الولاء",76,"ا",2,0],["يوم كانت جيادكم تطأ الها","م ويخشى صهيلها البلقان",77,"ن",1,0],["يوم كانت فروق عاصمة الأر","ض وفيها الهدى وفيها الأمان",77,"ن",1,0],["يوم كانت ساحاتكم مهبط العد","ل ولم يخل من نداكم مكان",77,"ن",1,0],["يومَ كاد البينُ أن يقتلني","حين لمَّا يَتَّرِكْ فيَّ رمقْ",78,"ق",1,0],["يومَ كشفٍ لغطاءٍ","وانجلاءِ الحقِّ عينا",79,"ن",2,1],["يَؤُمُّ كافورَ حَصْباءِ العيونِ بِهِ","عَن طَلّ عنبرِ أَصداغِ الرَّياحينِ",80,"ن",1,0],["يومٌ كأن سحابه","لبست عمامي المصامت",81,"ت",1,1],["يوم كحاشية الرداء المعلم","أوفى بسر مسرةٍ لم تكتم",82,"م",1,1],["يؤمك مستجدٍ فيلفيك منهلا","ويأتيك مستهدٍ فيلقاك مرشدا",83,"د",2,0],["يومك سألتي إشتقت وأقول يعني","ترى انفعالك دل إني تغلبت",84,"ت",1,0],["يوم كان اسمي محيميد اتحمّد","كان مسموح انظره وارقى لسوره",85,"ر",2,0],["يوم كل الناس تنشد للسلام وللامان","حازها رجل السلام يوم غيره عاقها",86,"ق",3,0],["يوم كأسبوع وشهر كعام","صافي حساب المدنف المستهام",87,"م",1,1],["يوم كان الحرف بستان وترف","وانت فاحْضان الجداول غصن بان",88,"ن",1,0],["يومك من اعذب نهرواصفى شربتى","اروى ضماء ريقك بروح اعتناقه",89,"ق",2,0],["يومك على شوفة رحيله عزمتى","والعين تشكى يوم حزة فراقه",89,"ق",2,0],["يومك هذا على مهاد","ثم غدا راكب السرير",90,"ر",1,0],["يوم كان الحياءُ عوناً علينا","كلما مهد الظلام لقانا",91,"ن",2,0],["يوم كنا من وجدنا نتلوى","مثل لي العواصف الأغصانا",91,"ن",2,0],["يومك ضحكت وبش باوجانك الدم","قبل الغياب وكلهم حاسدينك",92,"ك",1,0],["يومك تعلمني الامن تحاكيت","درس الحياه اللي كبرت وفهمته",93,"ت",2,0],["يومك لنا مَا أخاف بَردٍ وحَرقا","بَيت العَزا بعدك يبي جدر وسقوف",94,"ف",1,0],["يوم كبرت متونه من معزة كريم","زوجه يرجي الله يسعده ويهداه",95,"ا",2,0],["يومك تجيها بالمشاهد تذكرك","بوصوف دارك لافنيت وهجرتها",96,"ت",3,0],["يوم كُنَّا في رباها نغتدي","نزرعُ الصبحَ .. بذورَ الأملِ",97,"ل",1,0],["يوم كنا بالوغى عشاقها","صبُرٌ للسيف عند الملتقى",98,"ق",2,0],["يومك تكبرتي وانا فيك محتاس.","الله حسيبك لين تجني مصيرك.",99,"ك",1,0],["يوم كنا والعلى في منزل","والرزايا والعدا في منزلِ",100,"ل",1,0],["يومك في لبنان يوم له","انباؤه في آخر الزمنه",101,"ن",2,0],["يوم كروا بالمكايد ألف جوله","وأوغلوا بالطيش ما راعوا حرام",102,"م",1,0],["يوم كلن هز نبضه في طرب","للخساره صافحوا كف العميل",103,"ل",1,0],["يوم كنا لله قصدا وسعيا","ومن النور روحنا ريانه",104,"ن",2,0],["يوم كنا على التقى حلقات","وحدود المولى لدينا مصانه",104,"ن",2,0],["يوم كان الوضع ما بيني وبينك خطير","كانت يديني بيدّي وعقب .. افختّها",105,"ت",3,0],["يوم ٍ كل ٍ من ولاكا كلاكا","دخيلكم يا مير يلقى الفكوكا",106,"ك",2,0],["يوم كل ٍ قام ، في عيد الوطن يمدح دياره","طاب لي ، أمدح دياري ، وآتمثّل بالقصيد",107,"د",1,1],["يوم كنا سادة الدنيا ولم","ننحي يوما لوغد أو وثن",108,"ن",1,0],["يَومَ كانَ العَبيدُ كَالبَهَمِ الآمِنِ","هَمَّ الإنفاقِ وَالإيرادِ",109,"د",1,0],["يَوْمَ كَانَ النَّدَى يُرَوِّيْ حُقُوْلاً","بِالرَّيَاحِيْنِ بَيْنَنَا تَتَثَنَّى",110,"ن",2,0],["يوم كنتي ليا هبّت هبوب العصر","موعد الفيّ والعصفور والسلسبيل",111,"ل",1,0]]}