{"poems":[[53,"لله خالد الطائي من رجل","https://www.aldiwan.net/poem8687.html","البسيط"],[93,"رأيت غلاما مليح الرواء","https://www.aldiwan.net/poem8783.html","عموديه"],[33,"تقول وليدتي لما رأتني","https://www.aldiwan.net/poem41270.html","الوافر"],[50,"ما لي وللعاذلات","https://www.aldiwan.net/poem62464.html","المجتث"],[52,"يا للرجال أمن شخص بأجياد","https://www.aldiwan.net/poem63932.html","البسيط"],[108,"من وحي السد","https://www.poetsgate.com/ViewPoem.aspx?id=179600",""],[122,"جرى ذكر هجرٍ في خروق المسامع","https://www.aldiwan.net/poem495.html",""],[128,"عفا الصفا وانتفى من كوخ ندماني","https://www.aldiwan.net/poem23777.html","البسيط"],[128,"قالوا سيجمع أشعاري جهابذة","https://www.aldiwan.net/poem23789.html","البسيط"],[275,"صبرا على حور العينين والدعج","https://www.aldiwan.net/poem35434.html","البسيط"],[325,"سألت الندى هل أنت فقال لا","https://www.aldiwan.net/poem61808.html","الكامل"],[466,"أسر بالبرق لا حرصا على الديم","https://www.aldiwan.net/poem16089.html","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38768","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77634","البسيط"],[1324,"","https://poetry.dctabudhabi.ae/diwan/poem/99305","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201750","المجتث"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204585","السريع"],[3008,"","https://poetry.dctabudhabi.ae/diwan/poem/103196","السريع"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65466","المجتث"],[3617,"","https://poetry.dctabudhabi.ae/diwan/poem/107037","المجتث"],[881,"تقول سُلَيْمى ما لِجِسْمك شاحباً","https://www.poetsgate.com/ViewPoem.aspx?id=175385",""],[2177,"قالوا تركت الحج ميلا الى","https://www.poetsgate.com/ViewPoem.aspx?id=127082",""],[5953,"عاذلتي في الشيب لو تعلم ما","https://www.poetsgate.com/ViewPoem.aspx?id=93807",""]],"verses":[["فقلتُ شأنكَ والمحْجُوجُ معترفٌ","إن لم يُعانِد إذا ما حُجَّةٌ وجَبَتْ",0,"ت",1,0],["فَقُلتُ شَقِيٌّ مِنَ الأَشقِياء","يُجاهِدُ مِن أَجلِ حُرِّيَتِه",1,"ه",1,0],["فَقُلتُ شَكا إِلَيَّ أَخٌ مُحِبٌّ","كَبَعضِ زَمانِنا إِذ تَعلَمينا",2,"ن",2,0],["فَقُلتُ شَمسٌ وَرَبّي","قَد أَجلَتِ الظُلُماتِ",3,"ت",1,0],["فَقُلتُ شَمسُ الضُحى في مِرطِ جارِيَةٍ","يا مَن رَأى الشَمسَ في مِرطٍ وَأَبرادِ",4,"د",1,0],["فقلتُ: شتَّانَ يومَ الفخْرِ بينهما","فما هما في مجال الفخرِ سِيَّانِ",5,"ن",1,0],["فقلت شراء قال لابل وراثةً","وحاشاي أن آتيه من كفّ بائع",6,"ع",1,0],["فقلت شعري أشلاء مبعثرة","كأنها عمري في كل ميدان",7,"ن",1,0],["فقلت شكراً فشعري لا تصيخ له","من بعد عامي هذا غير آذاني",8,"ن",2,0],["فقلتُ شيَّعتُ قلبي حينَ فارَقني","بمُقلتيَّ وما في العذرِ من عَوَج",9,"ج",1,0],["فَقُلتُ شِراءَ قالَ لا بَل وِراثَةً","عَنِ الجودِ عَن جَدلِهِم عَنِ مَحامِدِ",10,"د",1,0],["فقلتُ شتَّانَ ما بيني وبينكمُ","كما تباعدَ بين الغَوْرِ والعَلَمِ",11,"م",1,0],["فَقُلتُ شَرعُ الهَوى إِن كانَ حَرَّمَهُ","يا ضَيعَةَ العمرِ لَم أبلغ بِهِ أَربي",12,"ب",2,0],["فَقُلت شَكواك لِلإِنسان قَد جلبَت","لَكَ البَليَّةَ يا مِسكين فاتئدِ",13,"د",1,0],["فقلت شبيهي في التغرب والنوى","وطول التنائي عن بني وعن أهلي",14,"ل",2,0],["فقلت شعريَ روحي","حلّتْ من اللفظ جسما",15,"م",2,0],["فقلت شغلي الشعر في نظمه","أدفع عني حجفل النائبات",16,"ت",1,0],["فقلت شأني كله أنني","في تعبٍ من لفظ جرداني",17,"ن",2,0],["فقلتُ شعري رقيقٌ","وللرّقيق انقطاعُ",18,"ع",1,0],["فقلت شعري حقير","وواجب ان اجلك",19,"ك",1,0],["فقُلتُ شجُون من خُطُوبٍ تَتابعت","عليّ كِبَارٌ والزَّمانُ يَريب",20,"ب",1,0],["فقلت شرط الحج وهو الغنى","من فيض ذي المغنى فهذا السبب",21,"ب",1,0],["فقلت شكراً قد مننت فأتممي","قالت فقد تم فقلت مرتقب",22,"ب",1,0]]}