 يرنو..","ويناغي كالطفل: (دادا، حباذا)",271,"ذ",2,0],["وإلى مدى التحليق يرفعه هوى","وهوى يخوض به مدى الاسفاف",272,"ف",1,0],["وإلى لا منتهى هذا السرى","في المتاهاتِ، ومن غير ابتداء",273,"ا",2,0],["واليوم في القرية الجوعى يضيّعه","درب ، ودرب من الأشواك يختطف",274,"ف",1,0],["واليوم لا أبكي نواك","ولا اقترابي منك يشفي",275,"ف",2,0],["واليومُ نخشى أن يَضيعَ توازُنٌ","في الكِفَّتَيْنِ وأنت غيرُ مقيم",276,"م",1,0],["واليومَ يفخرُ \" بالحيادِ \" كفاخرٍ","بالقتلِ إذ لم \" يُسلَخِ \" المقتولا",277,"ل",2,0],["وإلى أبي سَهْلِ بنِ نَيْبُخْتََ انْتَهَى","مَا كَانَ من غُرَرٍ لَهَا وَحُجُولِ",278,"ل",1,0],["وإِلى إِخوَتي ذَوي الأَدَبِ الْغُرِّ ،","أُؤَدِّي تَحِيَّتي وأَلوكِي",279,"ك",2,0],["وآلَيْتُ لا أنْسَى بُلُوغي بكَ العُلا","على كُرْهِ شَتّى مِن شُهُودٍ وَغُيَّبِ",280,"ب",1,0],["واليعابيبُ حوله تتعادى","كالسراجين بالأسود الضواري",281,"ر",2,0],["واليوم ودّعت المظالم أختها","ومشيت تجر ذبولها إدلالا",282,"ل",2,0],["وإليك شكوى القلبِ نجوى","الروحِ أجمع النداء",283,"ا",2,0],["وإلى القطب والجليدُ عليه","والصّحارى وما بها من سمائم؟",284,"م",1,0],["وإلى النُّسور تقاصرت أعمارها","والعهدُ في عمر النسورِ يطول",285,"ل",1,0],["وَإلى لِقاءٍ تَحْتَ ظِلِّ عَدالَةٍ","قُدْسِيَّةِ الأَحْكامِ والمِيزانِ",286,"ن",1,0],["واليمُّ رهوٌ إذا رآك كأنّهُ","قد قيّدتْهُ دهشَة ٌ وحياء",287,"ا",2,0]]}