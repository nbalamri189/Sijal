s://poetry.dctabudhabi.ae/diwan/poem/54522","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54518","المجتث"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142016","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141995","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141970","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141963","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/204512",""],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142327","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/206203","الكامل"],[104,"دمع الخيل","https://www.poetsgate.com/ViewPoem.aspx?id=37377",""],[106,"الطفل الموءود!","https://www.poetsgate.com/ViewPoem.aspx?id=179638",""],[106,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""],[106,"انتصار الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179290",""],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[106,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[77,"هب النسيم معطر الأراج","https://www.poetsgate.com/ViewPoem.aspx?id=33813",""],[100,"الهارب.. إلى صوته","https://www.poetsgate.com/ViewPoem.aspx?id=183582",""],[100,"فارس الاصطياف","https://www.poetsgate.com/ViewPoem.aspx?id=50417",""],[100,"ابن السبيل","https://www.poetsgate.com/ViewPoem.aspx?id=50328",""],[100,"كانت وكان","https://www.poetsgate.com/ViewPoem.aspx?id=50424",""],[100,"بعد الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=50367",""],[90,"ذكرى الهاشمي","https://www.poetsgate.com/ViewPoem.aspx?id=179163",""],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[45,"في غَيرِ شأْنكَ بُكْرَتِي وأصِيلي","https://www.poetsgate.com/ViewPoem.aspx?id=32124",""],[45,"يَا ابْنَةَ الدَّهرِ ،هَلْ رَأَيْتِ كَمِثْلِي","https://www.poetsgate.com/ViewPoem.aspx?id=32156",""],[45,"بِنَا أنْتِ مِنْ مَجْفُوّةٍ لمْ تُعَتَّبِ","https://www.poetsgate.com/ViewPoem.aspx?id=31693",""],[80,"عجبي من سكينتي وَوَقَاري","https://www.poetsgate.com/ViewPoem.aspx?id=3243",""],[91,"فتح اورشليم","https://www.poetsgate.com/ViewPoem.aspx?id=53229",""],[97,"ذنبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63568&r=&rc=115",""],[85,"لك في الأرض والسماءِ مآتمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9626&r=&rc=116",""],[85,"أنظر إلى الأقمار كيف تزولُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9615&r=&rc=105",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""],[81,"يومٌ تضاحكَ نورهُ الوضاءُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10959&r=&rc=0",""]],"verses":[["وَاليَومَ بانَ لِناظِري","ما أَثمَرَت تِلكَ الغُصونُ",0,"ن",1,0],["وَاليَومُ أَبلَجُ تَستَضي","ءُ لَهُ ظُهورٌ أَو بُطونُ",0,"ن",1,0],["وَإِلَيكَ عَطَّ بِيَ الظَلامَ عُذافِرٌ","مُتَجَلبِبٌ بِالنَصِّ وَالذَمَلانِ",1,"ن",1,0],["وَإِلى اِبنِ ذي يَزَنٍ غَدَت مَرحولَةً","نَفَضَت حَوِيَّتَحا عَلى غُمدانِ",2,"ن",1,0],["وَاليَومَ قَطَّعَ قَرعُ البيضِ حَبوَتَهُ","عَنِ العَجاجِ وَخَيلُ اللَهِ في الحَرَمِ",3,"م",1,0],["وَاليَومُ مُقذٍ لِلعُيونِ بِنَقعِهِ","لا يَهتَدي فيهِ البَنانُ إِلى الفَمِ",4,"م",1,0],["وَإِلى اليَومِ قَذى نا","ظِرُهُ ذاكَ القَتامُ",5,"م",1,0],["وَإِلَيكَ طَوَّحَ بِالمَطيِّ مُغَرِّرٌ","عَصَفَت بِهِ أَيدي المَطيِّ المُضلِلِ",6,"ل",1,0],["واليتُ فيهِ مَدائِحي فَكَأَنَّما","أَفرَغتُ نَبلي كُلَّها في مَقتَلِ",6,"ل",1,0],["وَإِلى مَتى عُودي عَلى أَيديهِمُ","مُلقىً يُنَيَّبُ دائِباً وَيُحَرَّقُ",7,"ق",1,0],["وَاليَومُ مَلطومُ السَوالِفِ بِالظُبى","وَاللَيلُ مُرتَعِدُ النُجومِ خَفوقُ",8,"ق",1,0],["وَإِلى أَميرِ المُؤمِنينَ نَجَت بِهِم","ميلَ الجَماجِمِ سَيرُهُنَّ تَدَفُّقُ",9,"ق",1,0],["وَاليَومُ عُريانُ مَشهورٌ بِفُرجَتِهِ","يَعتَمُّ بِالنَقعِ أَطواراً وَيَأتَزِرُ",10,"ر",1,0],["والَيثُ لا تَرهَبُ الأَقرانُ طَلعَتَهُ","حَتّى يُصَمِّمُ مِنهُ النابُ وَالظُفُرُ",11,"ر",1,0],["وَإِلَيكَ أَنحَلَتِ الفَلا أَخفافَها","تُطوى بِهِنَّ قَبائِلٌ وَعَمائِرُ",12,"ر",1,0],["وَاليَومُ أَسوَدُ لِمَّةً مِن لَيلِهِ","سَتَرَتكَ مِنهُ ذَوائِبٌ وَغَدائِرُ",12,"ر",1,0],["وَاليَومَ كَم في صَدرِهِ لَكَ آمِلٌ","يُعطى وَكَم في عَجزِهِ لَكَ شاكِرُ",12,"ر",1,0],["وَإِلى الزَمانِ نَبا وَعاوَدَ عَطفَهُ","فَاِرتاحَ ظَمآنٌ وَأَورَقَ عودُ",13,"د",1,0],["وَاليَومَ تُستَلُّ السُيو","فُ بِهِ وَتَنسَلُّ الرِقابُ",14,"ب",1,0],["وَإِلى طَودٍ مِنَ العِز","زَةِ مِزلاقِ الجُنوبِ",15,"ب",1,0],["وَإِلَيْهِ يَصْبو الرُّواةُ وَفيهِ","مَعَ شِكْل الحِجازِ ظَرْفُ العِراقِ",16,"ق",1,0],["واليومَ ألْقَتْ بهِ الشِّعْرَى كَلاكِلَها","وصوّحَتْ منْ رُبا فَلْجٍ مَراتِعِهُ",17,"ع",2,0],["وإِلى أبي العَبّاسِ يَجْتَذِبُ الندى","مِدَحاً هيَ الحِبَراتُ منْ تَفْويفي",18,"ف",2,0],["واليَثْرِبيّاتُ بأيْدي غِلْمَةٍ","تهوي إِلى أعدائِهِم خَساً زَكا",19,"ا",1,0],["واليومُ مُحْمَرُّ أديمِ الضُّحى","بالمَشْرَفيّاتِ صَقيلُ النّواحْ",20,"ح",1,0],["وإِلى سَناءِ الدّولةِ اضْطَرَبَتْ بِنا","شعب الرِّحالِ وغَرَّدَ الرُّكْبانُ",21,"ن",1,0],["وإِلى أميرِ المؤمنينَ تطَلَعَتْ","مِدَحٌ كما ابتَسَمَ الرِّياضُ تُحَبَّرُ",22,"ر",1,0],["وإلَيكَ يَلتَجئُ الكَريمُ ويَتّقي","بكَ ما يُحاذِرُ والنّوائِبُ تَعتَري",23,"ر",2,0],["واليوم تسعون مليوناً وما بلغوا","نضجاً وقد عصر الزيتون والعنب",24,"ب",1,0],["واليوم أذوي وطيش الفن يعزفني","والأربعون على خدّي تلتهب",24,"ب",1,0],["وإلى الوادي إلى الظلّ إلى","حيث يلقي الروض أنفاس الملاب",25,"ب",1,0],["وَآلَيتِ أَن لا تَكتُبي فَفَجَعتِني","بِأَكبَرِ شَيءٍ مِنكِ كانَ يَكونُ",26,"ن",1,1],["وَإِلى مَتى أَبكي وَتَضحَكُ لاهياً","عَنّي وَأُدني في الهَوى وَتُباعِدُ",27,"د",1,0],["وَإِلى مَتى أَنا هاتِفٌ بِكَ في دُجّىً","أَبكي إِلَيكَ وَأَشتَكي وَأُناشِدُ",27,"د",1,0],["والى الزّاويةَ العُلْيا التَفِتْ","فهْيَ مثْوَى مَنْ عنِ الغَيِّ نَزَعْ",28,"ع",1,0],["والْيِسْرُ بَعْدَ الْعُسْرِ مَوْعُودٌ بِهِ","وَالصَّبْرُبِالْفَرَجِ الْقَرِيبِ مُوَكّلُ",29,"ل",1,0],["واليومَ حلَّ عِقابُ كلِّ مُذَرَّبٍ","ماضي الشَّبا يَفْري الفَريَّ غِرارُهُ",30,"ر",2,0],["والي الوُلاةِ وواحِدَ الزّمنِ الذي","تبْأى المُلوكُ بمثْلِهِ وتُفاخِرُ",31,"ر",1,1],["والَى عليَّ بِها وقالَ هيَ التي","فِيها سَمَحْتَ بخَيْرِها النّسّاجِ",32,"ج",1,0],["وَإِلَيْكَهَا كَالْبَحْرِ قِيسَ بِمِذْنَبٍ","وَالشَّمْسِ نَازَعَهَا الضَّيَاءَ الْكَوكَبُ",33,"ب",1,0],["وَإِلَيهِمُ اِستَقبَلتُ كُلَّ وَديقَةٍ","شَهباءَ يَسفُع حَرُّها كَالنارِ",34,"ر",1,0],["وَاليَومَ قَد غالَ الحِمامُ أَسَدَّنا","رَأياً فَطاحَ بِحِكمَةٍ وَصَوابِ",35,"ب",1,0],["وَإِلى هُنا حَبَسَ الحَياءُ لِسانَها","وَجَرى البُكاءُ بِدَمعِها الهَطّالِ",36,"ل",1,0],["وَإِلَيكَ مِن جُهدِ المُقِلِّ قَصيدَةً","يُغنيكَ موجَزُها عَنِ الإِسهابِ",37,"ب",1,0],["وَإِلَيكَ مَكَّةَ هَل تَرى","أَحَداً بِها وَإِلَيكَ نَجدا",38,"د",2,0],["وَإِلَيكَ تونُسَ وَالجَزا","ئِرَ قَد لَبِسنَ العَيشَ نَكدا",38,"د",2,0],["وَاليَومَ قَد أَلطَفتَنا","بِالطَيِّباتِ مِنَ الثِمارِ",39,"ر",1,0],["وَإِلى الحِجازِ الخارِجِيِّ وَما بِهِ","إِلّا اِقتِناصُ الأَصفَرِ الرَنّانِ",40,"ن",1,0],["وَإِلَيكَ يا فَرعَ الخَلائِفِ مِدحَةً","عَزَّت شَوارِدُها عَلى حَسّانِ",40,"ن",1,0],["وَاليَومَ أُنشِدُهُم شِعراً يُعيدُ لَهُم","عَهدَ النَواسِيِّ أَو أَيّامَ حَسّانِ",41,"ن",1,0],["واليوم آمال الفضائل والعلى","يحلفن في تشييع من شيعته",42,"ت",2,0],["واليوم ابصر بالسبيل تذنبت","وتعقربت وسطت على الأبصار",43,"ر",1,0],["وَاليَوْمَ أَفْصَحَ مَجْلِساً نُوَّابِهَا","عَنْ رَأْيِهَا وَهُمَا لِسَانَا حَالِهَا",44,"ل",3,0],["وَاليَأْسُ إِنْ فَاجَأَ ذَا مَرَّةٍ","دَوَّخَ ذَا المِرَّةِ عَنْ قَصْدِهِ",45,"د",2,0],["وَاليَوْمَ آمَالُ الفَضَائِلِ وَالعُلَى","يَحْفُلْنَ فِي تَشْيِيعِ مَنْ شَيَّعْتَهُ",46,"ت",2,0],["وَاليَوْمَ لَوْ بُعِثَتْ مِنْ قَبْرِهَا لَبَدَا","لَهَا كَمَا خَبَرَتْهُ مُنْذُ أَزْمَانِ",47,"ن",1,0],["وَاليَوْمَ ضَاعَفْتَ مَا تُسْدِي بِمَأْثَرَةٍ","أَعْيَتْ بِلُطْفِ المَعَانِي كُلَّ تِبْيَانِ",48,"ن",1,0],["وَاليَوْمَ صَدَّقَتِ الكَوَارِثُ قَوْلَهُ","كَيْفَ الشُّعُوبُ طَلِيقُهَا وَالعَانِي",49,"ن",2,0],["وَإِلَى السُّوَيْعَاتُ الَّتِي ذُقْنَا بِهَا","طِيبَ الحَيَاةِ وَنَحْنُ فِي لُبْنَانِ",50,"ن",1,0],["وَاليوْمَ تَبْدُو مِنْ دَيَاجٍ بِهَا","عَابِسَةٍ بَارِقَةٌ تَبْسُمُ",51,"م",1,0],["وَاليَوْمَ شَادَتْ لَهُ قَبْراً بِجَانِبِهِ","فَجَاوَرَ الرَّوْضَةَ القُدْسِيَّةَ الْحَرَمُ",52,"م",1,0],["وَإِلَيْكَ يَا عَبْدَ العَزِيزِ تَحِيَّةً","مِمَّنْ يُوَدِّعُ وَالدُّمُوعُ سِجَامُ",53,"م",1,0],["وَاليَوْمَ تُلْفِيهِ نَدىً مُتَمَاسِكاً","مِنْ بَعْدِ أَنْ نَصَلَ الخِضَابُ الدَّامِي",54,"م",2,0],["وَاليَسِيرُ الذِي تَصِيدُ عَسِيرٌ","وَالضَّئِيلُ الَّذِي تُريدُ جَسِيمُ",55,"م",1,0],["وَإِلَيْكِ أُهْدِيهِ وَقَدْ","أَبْلَغْتُهُ حَدَّ الكَمَالِ",56,"ل",1,0],["وَإِلَيكُمُ مِن","بَعضِ النِظامِ عَساهُ فيهِ يَسعَدُ",57,"د",1,0],["واليتَ للخلقَِ ما أوليتَ من نعم","والى لك اللهُ ما أولى ووالاهُ",58,"ا",2,0],["وإليك من صون العقول عقيلةً","وقفت بِبابِك وِقْفَةَ المسترحمِ",59,"م",1,0],["وإليك من سُمر الجهاد غريبةً","جاءت تقرّظُك الثناء جميلا",60,"ل",2,0],["وإليكها ملء العيون وسامةً","حَيَّتْكَ بالأبكار من أفكاري",61,"ر",2,0],["وإليكَها من روض فكري نفحةً","شفّ الثناء بها على الأزهارِ",62,"ر",1,0],["واليوم موسم قُربةٍ وعبادة","وغداً ظفرت بأجره عاشورا",63,"ر",2,0],["وإلى عليك بها الكؤوس وربما","يسقيك من كأس الفتور إذا فَتَرْ",64,"ر",1,0],["واليتَ ما أوْليتَ يا بحر الندى","ووحقّ جودك ما رأيت كهذِهِ",65,"ذ",2,1],["وإلى الملوك قد اعتزى من عزةِ","فغدا له ياقوتها ممقوتا",66,"ت",2,0],["وإليك مني روضةٌ مطلولةٌ","أَرِجَتْ أزاهرها بطيب ثَناءِ",67,"ا",2,0],["واليوم أصبحت لا دار ولا وزر","آوي إليه ولا عم ولا خال",68,"ل",1,0],["واليوم قد هان الخلود الذي","قدّره الله لنا في سقر",69,"ر",1,0],["وإلى متى هو ساتر","وجه الحقيقة في ضَبابه",70,"ب",2,0],["واليوم قلت بجانبيها أرخوا","دَفَق السُيول فماجت الأزمات",71,"ت",1,0],["وإلى اليوم قام في الهند منها","أثَر مثل طَودها لا يزول",72,"ل",1,0],["وإلى الحقيقة تنتهي","طرق الضلالة والهداية",73,"ا",3,0],["وَإِلى اللَهِ تُرجَعونَ وَعِندَ","اللَهِ وِردُ الأُمورِ وَالإِصدارُ",74,"ر",1,0],["وإلى يَثرِبَ التَّحَوُّلَ عَنها","لِمَقَامٍ عَن غَيرِ دار مُقامِ",75,"م",1,0],["وإلى عمادهُم انتهتْ علياؤُهم","وإلى العلاء قد انتهتْ لنجيب",76,"ب",1,0],["وَالى شهيّ الرشف وقتاً وفي","وقتٍ له التحكيم والقهر",77,"ر",1,1],["واليت أمراضي عليَّ وليتني","أدري أحسنك ساخطٌ أم راضي",78,"ي",1,0],["وإليك أشكو صدر حالٍ ضيقٍ","بالمؤلماتِ وحال همٍّ مولع",79,"ع",1,0],["واليوم تنهض بالأمداح لي فكرٌ","جدائد الحسن لم تخطر على بالي",80,"ي",1,0],["وإلى بابك أنهينا الرجا","وهو أوْلى باتِّصال المنن",81,"ن",1,0],["واليمن تابع قصده","والجود طيُّ بنانه",82,"ن",2,0],["واليومُ مدجونٌ فَحُرَّتُهُ","فيه بمُطَّلَعٍ ومحتجبِ",83,"ب",1,0],["واليْتُهم ما حالفتْ","أوعالُ شابةَ هضبَ شَابَهْ",84,"ب",2,0],["واليَلَنْجوجِ في المجامر والند","دِ ترى نشرَهُ كمثلِ الضبابِ",85,"ب",1,0],["وإليك الشكاةُ يا ابن الوزيريْ","نِ فإني في محنتي أيوبُ",86,"ب",1,0],["وَإِلى ابن إسماعيل مِنهُ مُهاجري","ومِن الزمان إذا أُلِيحَ سلاحُهُ",87,"ح",2,0],["والياسمين إذا حصَّلْتَ أحْرُفَهُ","فاليأسُ منه مكانَ الياء معدودُ",88,"د",1,0],["وإلى الأجلِّ من الفعا","ل تراه يجنح لا أخَسِّه",89,"س",2,0],["وإلى الله أشتكي أن ودي","ليس ممن وددتُ بالمرزوق",90,"ق",1,0],["وإلى ابن أحمد أرقلت بي ناقتي","في كل أغبر قاتم الأعماق",91,"ق",1,0],["وإلى السلوِّ تفجعي","وإلى التصبر ما ألاقي",92,"ي",1,0],["وإلى الذي شطت به","عني النوى طول اشتياقي",92,"ي",1,0],["وإلى الخمودِ مآلُ ذي لهَبٍ","وإلى السكونِ محارُ ذي حَرك",93,"ك",1,0],["وإليك الشكاةُ منها ومن أش","ياءَ تبتزُّ ذا الحجى معقولَهْ",94,"ل",2,0],["وإلى اللَّه بعد هذا تشكّي","حاجتي منك خلَّةَ الإغفالِ",95,"ل",1,0],["وإلى مَن يُذْعَر العا","رمُ منه والعُرامُ",96,"م",1,0],["وإلى مَن منه يُخشى","وإليه يُستنامُ",96,"م",1,0],["وإلى مُن يُؤثرُ الحقْ","قَ إذا اشتدَّ الخصامُ",96,"م",1,0],["والَى عليه مصيبتين أفاضتا","عبراتِه واستذكَتا أحزانَهُ",97,"ن",2,0],["وَإِلى كُلِّ نابِغٍ عَبقَرِيٍّ","أُمَّةً أَهلُها ذَوو أَلبابِ",98,"ب",1,0],["وَإِلى كُلِّ شاعِرٍ عَرَبِيٍّ","سَلَّةً مِن فَواكِهِ الأَلقابِ",98,"ب",1,0],["وَإِلى كُلِّ تاجِرٍ حُرِمَ التَو","فيقَ زِقَّينِ مِن عَصيرِ الكُذابِ",98,"ب",1,0],["وَإِلى كُلِّ عاشِقٍ مُقلَةً تُب","صِرُ كَم مِن مَلاحَةٍ في التُرابِ",98,"ب",1,0],["وَإِلى الغادَةِ الجَميلَةِ مِرآ","ةً تُريها ضَمائِرَ العُزّابِ",98,"ب",1,0],["وَإِلى الناشِىءِ الغَريرِ مِراناً","وَإِلى الشَيخِ عَزمَةً في الشَبابِ",98,"ب",1,0],["وَإِلى مَعشَرِ الكَسالى قُصوراً","مِن لُجَينٍ وَعَسجَدٍ في السَحابِ",98,"ب",1,0],["وَإِلى ذي الغِنى الَّذي يَرهَبُ","الفَقرَ اِزدِيادَ الَّذي بِهِ مِن عَذابِ",98,"ب",1,0],["وَإِلى الصاحِبِ المُراوِغِ وَجهاً","أَسوَداً حالِكاً كَوَجهِ الغُرابِ",98,"ب",1,0],["وَإِلى المُؤمِنينَ شَيئاً مِنَ الشَكِّ","وَبَعضَ الإيمانِ لِلمُرتابِ",98,"ب",1,0],["وَإِلى مَن يَسُبُّني في غِيابي","شَرَفاً كَي يَصونُهُ مِن سِبابي",98,"ي",1,0],["وَإِلى حاسِدِيَّ عُمراً طَويلاً","لِيَدومَ الأَسى بِهِم مِمّا بي",98,"ي",1,0],["وَإِلى الحَقلِ زَهرُهُ وَحُلاهُ","مِن نَدىً لامِعٍ وَمِن أَعشابِ",98,"ب",1,0],["وَاليَأسُ مَوتٌ غَيرَ أَنَّ صَريعَهُ","يَبقى وَأَمّا نَفسُهُ فَتَزولُ",99,"ل",1,0],["وَاليَومَ وَدَّعَتِ المَظالِمَ أُختُها","وَمَشَت تَجُرُّ ذُيولُها إِدلالا",100,"ل",2,0],["وَإِلى السَواقي وَهيَ تَنشُدُ لِلصِبا","وَالحُبِّ في الفَتَياتِ وَالفِتيانِ",101,"ن",1,0],["وَإِلى الأَزاهِرِ كُلَّما مَرَّت بِها","عَذراءُ ذاتُ مَلاحَةٍ وَبَيانِ",101,"ن",1,0],["وَإِلى التاريخِ وَالعِل","مِ أَباهُ وَأَخاه",102,"ه",1,0],["وَإِلَيكَ يا مَلِكَ المِلا","حِ وَقَفتُ أَشكو حالِيَه",103,"ي",2,0],["وَاليَومُ يَومٌ لَم يَزَل","يَومَ سُكونٍ وَدَعَه",104,"ع",2,0],["وَإِلَيكَ عاذِلُ عَن مَلامَةِ مُغرَمٍ","ما أتَهَمَ العُذّالُ إِلا أَنجَدا",105,"د",2,0],["وَاليَومَ لي يَومانِ لَم","أَرَهُ وَهَذا اليَومُ ثالِث",106,"ث",1,0],["وَاليَومَ قالوا حُرَّةً","سُتُّ الحَرائِرِ في الحِجابِ",107,"ب",1,0],["واليومَ يُسايِرُها شَبَحاً","أَضناهُ الحزنُ وَنَكَّدَهُ",108,"د",2,0],["واليومَ لَقَدْ غَشَّاهُ اللَّيلُ","فما في العالمِ يُسعدُهُ",108,"د",2,0],["واليومَ قَدْ أمسَتْ كأَعماقِ","الكُهُوفِ الواجِمَهْ",109,"ه",1,0],["واليومَ إذْ زالتْ ظِلالُ","الأَمسِ عَنْ زَهَري البَديعْ",109,"ع",1,0],["وإلى الرِّياحِ النَّائحاتِ كأَنَّها","في الغابِ تبكي ميّت الأَيَّامِ",110,"م",1,0],["وإلى الشَّبابِ مغَنِّياً متَرَنِّماً","حوْلي بأَلحانِ الغَرامِ الظَّامي",110,"ي",1,0],["وإلى أَناشيدِ الرُّعاةِ مُرِفَّةً","في الغابِ شاديةً كسِرْبِ يَمامِ",110,"م",1,0],["وإلى الصَّدى المِمْراحِ يهتُفُ راقصاً","بَيْنَ الفِجاجِ الفيحِ والآكامِ",110,"م",1,0],["واليمُّ لا يَرْثِي لمَنْ طمَّهُ","والسَّيْلُ لا يبكي لنَوْحِ الهَشِيمْ",111,"م",1,0],["واليأْسُ موتٌ ولكنْ","موتٌ يُثيرُ الشَّقَاءْ",112,"ا",2,0],["واليومَ أحيا مُرْهَقَ","الأَعصابِ مَشْبُوبَ الشُّعُورْ",113,"ر",1,0],["واليوم اذ ذهب الشباب فحاجتي","هي ان يواريني بقبري اللاحد",114,"د",1,0],["واليوم لا خوف عليهم بعد ما","طلبوا الامان على يد الجلواز",115,"ز",1,0],["واليوم اني على ما فيّ من ثقة","بقوتي خائف من زندك الواري",116,"ي",1,0],["والى السلم قد نزعنا وان كا","ن على الارض السلم شيئاً محالا",117,"ل",2,0],["واليوم لا ادري أاقوى قائما","وحدي باعباء الهوى ام اضعف",118,"ف",1,0],["والى هذا اليوم لم تتفتح","زهرة لي في روضة الآمال",119,"ل",1,0],["واليوم تلقاني اسعى الى","سعدي فلا القى سوي نحسي",120,"ي",1,0],["والياسمين من الصبا اذ اجهزت","يرجو الامان وما هناك امان",121,"ن",1,0],["وإليه يفزع من أسى","يطغى ومن ثكل يثور",122,"ر",1,0],["وإلى الله من مشى بصليب","في يديه ومن مشى بهلال",123,"ل",1,0],["والياسمين لطيفة ونقيه","كسريرة المتنزه المسماح",124,"ح",1,0],["وإلى الأجانب تنتهى","نعم الصنائع والمتاجر",125,"ر",1,0],["وَاليَومَ أَرتَجِلُ الرِثاءَ وَأَنزَوي","في مَأتَمٍ أَبكي مَعَ الباكينا",126,"ن",2,0],["وَإِلى القُطبِ وَالجَليدُ عَلَيهِ","وَالصَحاري وَما بِها مِن حَمائِم",127,"م",1,0],["وَاليَومَ أَصبَحَتا بِحالِ طُفولَةٍ","في العِلمِ تَلتَمِسانِهِ تَطفيلا",128,"ل",2,0],["واليومَ تبعث فيّ حين تَهُزُّني","ما يبعث الناقوسُ فِي النُّسّاكِ",129,"ك",1,0],["وَاليَومَ فَوقَ مَشيدِ قَبرِكَ مَيتاً","وَجَدَ المُوَفَّقُ لِلمَقالِ مَقاما",130,"م",2,0],["وَإِلى الجِبالِ الشُمِّ كَيفَ يُميلُها","عادي الرَدى بِإِشارَةٍ فَتَميلُ",131,"ل",1,0],["وَإِلى الرِياحِ تَخِرُّ دونَ قَرارِها","صَرعى عَلَيهِنَّ التُرابُ مَهيلُ",131,"ل",1,0],["وَإِلى النُسورِ تَقاسَرَت أَعمارُها","وَالعَهدُ في عُمرِ النُسورِ يَطولُ",131,"ل",1,0],["وَاليَومَ لِلشَهَواتِ فيها وَالهَوى","سَيلٌ وَلِلدَمِ وَالدُموعِ مَسيلُ",131,"ل",1,0],["وَاليَومَ ضَمَّ الناسَ مَأتَمُ أَرضِهِ","وَحَوى المَلائِكَ مِهرَجانُ سَمائِهِ",132,"ا",3,0],["وَاليَومُ أَشيَبُ وَالآفاقُ مُذهَبَةٌ","وَالشَمسُ مُصفَرَةٌ تَجري لِمُنحَدَرِ",133,"ر",1,0],["وَاليَومَ عَقَّ كَأَنَّما","يَنسى جَميلَكَ وَاِصطِناعَك",134,"ك",1,0],["وَإِلَيكَ بَعدَ اللَهِ يَرجِعُ تَحتَهُ","ما جَفَّ أَو ما ماتَ أَو ما يَنفُقُ",135,"ق",1,0],["وَإِلَيكَ ي