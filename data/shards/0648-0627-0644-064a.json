مينة رصعت بنجومه","والبركة الذهبية الإنشاد",158,"د",1,0],["واليوم حرته مجبة","المحاسن لا ترام",159,"م",1,0],["وإلى الأميرِ سَريْتُ مُرتَدياً","بعزيمَةٍ تَدَعُ الدُّجى فَجْرا",160,"ر",2,0],["وَإِلى سِنانٍ سَيرُها وَوَسيجُها","حَتّى تُلاقِيَهُ بِطَلقِ الأَسعُدِ",161,"د",1,0],["وَإِلى مَدىً سَبَقَت جِيادُ ذَوي التُقى","فَأَصَبنَ فيهِ مِنَ الحَياءِ رَبيعا",162,"ع",2,0],["وَإِلى مَدىً تَجري وَتِلكَ هِيَ الَّتي","لا تُستَقالُ إِذا بَلَغتَ مَداكا",163,"ك",2,0],["وَاليَقينُ الشِفاءُ مِن كُلِ هَمٍّ","ما يُثيرُ الهُمومَ إِلّا الظُنونُ",164,"ن",1,0],["وَإِلى مَتى أَنا مُمسِكٌ","بُخلاً بِما مَلَكَت يَميني",165,"ي",1,0],["وَإِلى مَن رَغِبَ النا","سُ إِلَيهِ أَكبَروهُ",166,"و",2,0],["وَاليَأسُ مَقطَعَةُ المُنى","وَالصَبرُ مِفتاحُ الرَجاءِ",167,"ا",2,0],["وَإِلى أَمينِ اللَهِ مَهرَ","بُنا مِنَ الدَهرِ العَثورِ",168,"ر",1,0],["وَإِلَيهِ أَتعَبنا المَطا","يا بِالرَواحِ وَبِالبُكورِ",168,"ر",1,0],["وَإِلَيكَ العُيونُ تَطمَحُ إِن لُح","تَ وَإِن غِبتَ بِالبَنانِ يُشارُ",169,"ر",1,0],["وَالياسَمينُ كَعاشِقٌ قَد شَفَّهُ","جَورُ الحَبيبِ بِهَجرِهِ وَصُدودِهِ",170,"د",2,0],["وَاليَراعُ الَّذي يَزيدُ بِقَطعِ ال","رَأسِ نُطقاً مِن بَعدِ شَقِّ اللِسانِ",171,"ن",1,0],["وَإِلَيكَ كانَ المُلكُ يَطمَحُ بَعدَهُ","يَبغي جَواباً لَو سَمَحتَ بِرَدِّهِ",172,"د",2,0],["وإلى نسائم جنة سحرية","قرّحت أجفاني على مغناهَا",173,"ا",3,0],["وإليك شكوى القلبِ نج","وى الروحِ أجمعَ والنداء",174,"ا",2,0],["وإلى ابن عَبّادٍ تَعَبّدها","رَمْلاً قَطَعْنَ مداهُ بالرّمَلِ",175,"ل",1,0],["واليعابِيبُ حَولَهُ تَتَعادى","كَالسراحينَ بِالأُسودِ الضَّواري",176,"ر",2,0],["وَإِلى جَنابِ أَبي الحُسَينِ تَشَنَّعَت","بِزِمامِها كَالمُصعَبِ المَخطومِ",177,"م",1,0],["وَإِلى أَحمَدٍ نَقَضتُ عُرا العَج","زِ بِوَخدِ السَواهِمِ الأَنقاضِ",178,"ض",1,0],["وَإِلى جَنابِ أَبي المُغيثِ تَواهَقَت","خوصُ العُيونِ مَوائِرُ الأَعضادِ",179,"د",1,0],["وَإِلى بَني عَبدِ الكَريمِ تَواهَقَت","رَتكَ النَعامِ رَأى الظَلامَ فَخَوَّدا",180,"د",2,0],["وَإِلى اِبنِ حَسّانَ اِعتَدَت بي هِمَّةٌ","وَقَفَت عَلَيهِ خِلَّتي وَإِخائي",181,"ا",2,0],["وَإِلى مُحَمَّدٍ اِبتَعَثتُ قَصائِدي","وَرَفَعتُ لِلمُستَنشِدينَ لِوائي",181,"ا",2,0],["وإلى الأبكارِ ذهني سابقٌ","وقوى الأفكارِ عندي تضعفُ",182,"ف",1,0],["واليومَ مصرُ كما ترى","واللّهِ أفحشُ مِنْ حَلَبْ",183,"ب",1,0],["واليومَ لم تألُ تَستشري مطامِحُنا","وتقتفيها على قدْرٍ مَعاصينا",184,"ن",2,0],["واليومَ نَرقُبُ في أسحارنا أجَلا","تقومُ من بَعدهِ عَجلى نواعينا",184,"ن",2,0],["وَإِلَيكَ مِن حُرِّ الكَلامِ عَقيلَةً","قَصَرَت خُطاها خَجلَةُ العُذَراءِ",185,"ا",2,0],["وَإِلَيكَ مِن حَوكِ البَديعِ قَوافِياً","هَزَّ النَشيدُ بِها مُتونَ شَفارِ",186,"ر",1,0],["وَإِلَيكَها فَاِهنَأ بِها مِن مِدحَةٍ","أَهدَيتُها رَوضاً إِلَيكَ مُنَوَّرا",187,"ر",2,0],["وَإِلَيكَها غَرّاءَ لَولا حُسنُها","لَم تُفتَقِ الأَبصارُ وَالأَسماعُ",188,"ع",1,0],["واليأسُ فاصْدِفْ عنه واحْذرْ داءَه","فاليأسُ داءٌ للنّفوسِ عُضالُ",189,"ل",1,0],["واليأسُ إن طرد الإيمانُ رائِدَهُ","لم يَبْقَ للنَّفسِ مِن شيءٍ تُحاذِرُهُ",190,"ر",2,0],["وَإِلى القَياصِرِ كَيفَ يَسلُبُ مُلكَهُم","رَيبُ الزَمانِ وَصِرفُهُ الخَوّانُ",191,"ن",1,0],["وَإِلَيكِها اِبنَةَ ساعَةٍ لا تَلتَقي","إِلّا بِسَمعٍ مُنصِتٍ أَو مُنصِفِ",192,"ف",1,0],["وَاليَومَ عادَ الدَهرُ في إِحسانِهِ","وَاِستَرجَعَت مَعروفَها الأَيّامُ",193,"م",1,0],["وَاليَمُّ رَهوٌ إِذ رَآكَ كَأَنَّهُ","قَد قَيَّدتَهُ دَهشَةٌ وَحَياءُ",194,"ا",2,0],["وَإِلَيهِ المُصطَفى لَيلاً سَرى","وَكَذا البَيعة حَيث عمرا",195,"ر",2,0],["واليوم من شؤْمكم نُبلى بكارثةٍ","هذا هو الطَّينُ والماءُ الذي زادا",196,"د",2,0],["وإلى متى زعماءُ قوْ","مِكَ يخلبونك بالكياسه",197,"ه",1,0],["واليومَ في ضَنْكِ","واهي القوى",198,"ق",3,0],["وَإِلى جَهَنَم أَنتُما","حطب لَها طول البَقاء",199,"ا",2,0],["وَاليَومَ يَجري بِالأَكا","بِرِ جَمعِها وَالفَجرُ ذاهِب",200,"ب",1,0],["وَإلى المَسِيحِ وَأُمِّهِ وَكَفَى بها","صِدِّيقَةً حَمَلَتْ به وَبَتُولا",201,"ل",2,0],["وآليت لا آلوك شكرا على التي","غدت لي وسقا زيد فيه وُسوق",202,"ق",1,0],["واليومَ يَرقَى أمَلي صاعِداً","وما لهُ غيرُكَ من مُرْق",203,"ق",1,0],["وآليْتُ لا أُعطي الزّمانَ مَقادَةً","إلى مثلِ يحيَى ثمّ أُغضي على وَتْرِ",204,"ر",1,0],["وَإِلى أَبي الأُمَناءِ هارونَ الَّذي","يَحيا بِصَوبِ سَمائِهِ الحَيوانُ",205,"ن",1,0],["وَإِلى الجُحودِ بِما عَلَيهِ طَوِيَّتي","رَبّي إِلَيكَ بِكِذبِهِم نَسَبوني",206,"ي",1,0],["وَاليَأسُ مِمّا فاتَ يُعقِبُ راحَةً","وَلِرُبَّ مَطعَمَةٍ تَعودُ ذُباحا",207,"ح",2,0],["وَآلِيَ أَعني الأَقرِباءَ جُنودُهُ","عَلى ما سَقاني مِن أَذىً وَوَأى لي",208,"ل",2,0],["وَإِلى شَراحيلَ الهُمامِ بِنَصرِهِ","نَصرَ الأَشاءَ سَرِيُّهُ مُستَرغَدُ",209,"د",1,0],["وإلى عِشْقِكَ الجَمالُ دعاهُ","فإلى هجَرِهِ تُرى من دعاكا",210,"ك",2,0],["وإليَّ العيونُ ترسل ناراً","شرُّها من وميضها مستطيرُ",211,"ر",1,0],["وإلى جنبهِ يقاسي اللظى الأخ","طلُ مستعبراً ويشكو جرير",211,"ر",1,0],["وإلى جنبه على النار أفلا","طون يصغي كأنه مسرور",211,"ر",1,0],["واليوم قد زال ذاك ال","وَعَى وَذاكَ المصاع",212,"ع",1,0],["وَاليَوم عَن سفري في الأرض يوقفني","خلوّ ذاتِ يدي وَالضعف وَالخور",213,"ر",1,0],["وَاليَوم يا ابنة أُنسي","أَنتَ الحَقيقة نامي",214,"ي",1,0],["وآليت أن لا أَستَكين لمن عتوا","وإن قطعوا بالسيف حبل وَريدي",215,"د",2,0],["وَاليَوم إِذ نالَت الأيام من جلدي","أَودُّ لَو جاءَني موتٌ فيخترم",216,"م",1,0],["وإلى العيد أنت عيدٌ لأيَّا","مي جميعاً أنت الحبيبُ المُفدَّى",217,"د",2,0],["وإلى حصى أرضٍ أقام بها","بالنّاس من تقبيله يلل",218,"ل",1,0],["وإلى عروس البحر هِمْ","تَ وفي شواطئها كمنْتْ",219,"ت",1,0],["وإليها نَجْلاءُ يَرْهَبُها الشّيْ","خُ كما يَرْهَبُ الصّغيرُ الكَبيرا",220,"ر",2,0],["واليوم تأكلينها","أمَرّ من طعم الصبر",221,"ر",1,0],["وَالى علَىَّ بطَرْفِهِ وبكَفِّهِ","فأَمالَ مِن رَأسِي لِعَبِّ كَبيرِه",222,"ر",2,0],["وآلى زُهَيْرُ الحُبِّ يا عزَّ أَنَّهُ","إِذا ذَكَرتْهُ الذَّاكِراتُ أَتاهَا",223,"ا",3,1],["وإِلَيْكَها من نَاطِقٍ","يَدْعُوكَ إِذْ صَمَتَ البَهَائِمْ",224,"م",1,0],["وَإِلَيْكَ مِنْ حَوْكِ اللِّسَانِ حَبِيرَةً","يُغْنِيكَ رَوْنَقُها عَنِ التَّشْبِيبِ",225,"ب",1,0],["وَإِلَى القَنَابِلِ تَسْتَقِي","مُهَجَ الجُيُوشِ وَتَلْتَهِمْ",226,"م",1,0],["وَإِلَى الشُّيُوخِ تَخَضَّبَتْ","بِدِمَائِهَا مِنْهَا اللَّمَمْ",226,"م",1,0],["وَإِلَى المُشَاةِ كَأَنَّهُمْ","سُورٌ يَسِيرُ عَلَى قَدَمْ",226,"م",1,0],["وَإِلَى جَانِبِ المَصَانِعِ شِيدَتْ","لِلعُلُومِ الصرُوحُ وَالآطَامُ",227,"م",1,0],["وَالْيَوْمَ يَكْفَلُهَا عَلِيٌّ نَاحِياً","نَحْواً بِمُطَّرَدِ النَّجَاحِ كَفِيلاَ",228,"ل",2,0],["وَاليَوْمَ نُكِّسَ بَنْدُهُمْ عَنْهَا","وَأَوْفَى نُورُ بَنْدِكْ",229,"ك",1,0],["وَاليَوْمَ يَضْحَك فِي مَرَا","تِعِهِ وَتدْمَى مُقْلتاكْ",230,"ك",1,0],["وَإِلى اللّهِ بِالهِدَايَةِ يَرْقَى","مِنْ حَضِيضِ الْجَهْلِ البَعِيدِ الْقَرَار",231,"ر",1,0],["وَإِلَى جَمِيعِ الشَّرْقِ فَانْعِ مُهَذَّباً","فِقْدَانُهُ فِي الشَّرْقِ عَمَّ مُصَابَا",232,"ب",2,0],["وَإِلَيْكِ أَدْعِيَةُ النُّفُوسِ بِأَنْ","تَحْيِي مُعْظَّمَةً مَدَى الحُقُبِ",233,"ب",1,0],["وَاليَوْمَ فَتَّ رَدَاكَ في أَعْضَادِهَا","مَا أَجْلَبَ البَأْسَاءَ لِلبَأْسَاءِ",234,"ا",2,0],["وَإِلَى الضَّعْفِ قُوَّةُ الْبَأْسِ آلَتْ","بَعْدَ أَنْ نَاصَرَتْهُ فَهْيَ خَذُولُ",235,"ل",1,0],["وَإِلَى الحِمَى أَهْدَيْتَ كُتَّاباً بِهِمْ","يَعْتَزُّ دَعْ مَنْ كَانَ مِنْ أَشْكَالِي",236,"ي",1,0],["وَأَليَنُ مَا تُلْفِيهِ وَهْوَ مُخَالِفٌ","وَأَثْبَتُ مَا تُلفِيهِ وَهْوَ مُعَاهِد",237,"د",1,0],["وَإِلَى ذَاكَ مَوْئِلُ العِلمِ إِنْ لَمْ","تَرْحَبِ الأَرْضُ بِالهُدَى وَالهُدَاةِ",238,"ه",1,0],["واليَوْمَ إِذْ وَلَّى الصَّبَا لَمْ يَبْقَ مِنْ","أَثَرٍ عَلَيْهَا عَالِقٍ بَفَنَاءِ",239,"ا",2,0],["وَاليَوْمَ رَاعَ البِلادَ مُصْرَعُ","إِسْمَعِيلَ فَالحُزْنُ شَامِلُ عَمَمُ",240,"م",1,0],["وَإِلَيْكَ يَا حَسَنُ التحِيَّةَ","مِنْ أخٍ يَرْعَى وِدَادَكْ",241,"ك",1,0],["وَإِليْكَ يَا مَنْ صَارَ مِنْ","أَسْرِ الْحَيَاةِ إِلى الْفَكَاكْ",242,"ك",1,0],["وَإِلَى أَواصِرَ مِنْ هَوَى عَبَّاسِهَا","أَمِنَتْ مِنَ الإِيهَاءِ وَالتَّفْكِيكِ",243,"ك",1,0],["وَإلى بابِهِ سَعَى قَبْلَ أَنْ يَسْعَى","إِلى بابِهَا حرِيبٌ وَعَافِ",244,"ف",1,0],["وَاليَوْمَ قَدْ عَثَرُوا تنْدَى نَضَارَتُهُمْ","نَدَى الْجَفَافِ وَتَخْبُو شعْلَةُ البَاسِ",245,"س",1,0],["وَإِلى ذَاكَ لَمْ يَكُنْ فِي بَديعِ","النَّظْمِ إِلاَّهُ فِي بَديعِ النَّثْرِ",246,"ر",1,0],["وَالْيَومَ تَسْتَحْيِي الرِّيَاضُ لِعُرْيِهَا","وَتَلُوحُ لاَ وَرَقٌ وَلاَ أَثْمَارُ",247,"ر",1,0],["وَالْيَوْمَ أَجْرَأُ أَنْ أُخَالِفَ طَبْعَهُ","