{"poems":[[87,"به هجر يتيمه","https://www.aldiwan.net/poem7140.html","مجزوء الوافر"],[60,"أتطلب رزق الله من عند غيره","https://www.aldiwan.net/poem30821.html","الطويل"],[95,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[164,"إلى كم تمادى في غرور وغفلة","https://www.aldiwan.net/poem59149.html","الطويل"],[463,"متى وصلت تحية مستهامِ","https://www.aldiwan.net/poem55870.html","الوافر"],[473,"يا عاملا معروفه متباطي","https://www.aldiwan.net/poem59912.html","الكامل"],[518,"سقى الله رمل القاع في النخلات","https://www.aldiwan.net/poem67774.html","الطويل"],[556,"لك الليل بعد الذاهبين طويلا","https://www.aldiwan.net/poem47299.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87026","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86743","الوافر"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54182","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54053","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48761","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38334","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64899","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122022","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48930","المتقارب"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144763","الوافر"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118390","الوافر"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89531","الطويل"],[2241,"","https://poetry.dctabudhabi.ae/diwan/poem/10502","الطويل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145046","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112692","الكامل"],[3737,"","https://poetry.dctabudhabi.ae/diwan/poem/138909",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114102","الطويل"],[3996,"","https://poetry.dctabudhabi.ae/diwan/poem/114911","الطويل"],[4862,"عجوزٌ تحسن المكرا","https://www.poetsgate.com/ViewPoem.aspx?id=55620",""],[5376,"مسلمو بورما لا بواكي لهم","https://www.poetsgate.com/ViewPoem.aspx?id=188478",""],[5401,"دايم السيف","https://www.poetsgate.com/ViewPoem.aspx?id=179866",""],[5410,"آهات","https://www.poetsgate.com/ViewPoem.aspx?id=144495",""],[6084,"ومثقلة زحف الكسير تؤمنا","https://www.poetsgate.com/ViewPoem.aspx?id=170865",""],[6097,"ألا يا خاطب الحسنا","https://www.poetsgate.com/ViewPoem.aspx?id=186339",""],[6225,"معركة الكرسي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80900&r=&rc=169",""]],"verses":[["وترضعه فتاة البر","ر من سعد وترحمه",0,"م",2,0],["وَتَرضى بِصَّرافٍ وَإِن كانَ مُشرِكاً","ضَميناً وَلا تَرضى بِرَبِّكَ ضامِنا",1,"ن",2,0],["وتَرضَى بِهِ تَاجاً كَرِيماً لِفَقْرِها","مُعوَّضَةٌ خَيْراً مِن الكُثْرِ بِالقلِّ",2,"ل",1,0],["وترضى من العيش السعيد بعيشة","مع الملأ الأعلى بعيش البهيمة",3,"ه",1,0],["وتُرضيني بعذرٍ بعد عذرٍ","وكرُّ الحكِّ أقرفُ للكِلاَمِ",4,"م",1,0],["وَتَرضكتَ شِعري إِذا أَتاكَ مُطَأطَئاً","خَجَلاً وَلَم يَكُ قَطُّ بِالمُتَعاطي",5,"ط",2,0],["وترضى قلوبٌ قد تواتر سخطها","علي فعادتني بغير ترات",6,"ت",1,0],["وترضون ضدَّ الحزم إن كان ملككُمْ","بَدِيناً وديناً دنتموه هزيلا",7,"ل",2,0],["وَتَرضى وَأَنتَ اللَيث وَالغَيث أَنَّني","أُضام وَأَني في حِماك نَزيل",8,"ل",1,0],["وَتَرضى أَهلُها عَنهُ وَيَحظى","سَريعاً بِالَّذي مِنها يُريد",9,"د",1,0],["وترضى به وصفاً ذميماً يشينها","وتهتك في أستارها مسبل السترِ",10,"ر",1,0],["وترضى بتضييع الفرائض عامداً","وأنتَ على اللذات مستكمل الحرص",11,"ص",1,0],["وترضى عن الأحزاب مصر وما رأت","بها صائحاً إلا ليدرك مغنما",12,"م",2,0],["وَتَرضى بِلَثمِ الكفّ مِنك صَداقها","لِتَفخرَ فيهِ الدّهرَ ما بَينَ أَترابِ",13,"ب",1,0],["وتُرْضي ذَوي إِحسانِها بسُعودِهْم","وتَقْضِي على أَهْلِ الإِساءة بالشَّقا",14,"ق",2,0],["وَتَرْضَى رِمَاحُ الْخَطِّ حَطْمَ قُدُودِهَا","إِذَا هَزَّهَا لِلطَّعْنِ فِي كُلِّ مَشْهَدِ",15,"د",1,0],["وترضى بإدراكِ ما تبتغي","وتبكي وتغضبُ إن تُمنع",16,"ع",1,0],["وترضيكم إضاعته","بدار دأبها السرف",17,"ف",1,0],["وترضى المسلمين وفي رضاهم","يؤمل ان ينال رغى الجليل",18,"ل",1,0],["وَتَرضاهُ في الرَأيِ المُصيبِ إِذا هَفَت","حُلومٌ وَرُدَّ الرَأيُ وَهوَ كَليلُ",19,"ل",1,0],["وَتَرضى بِأَن يُهدى لَكَ العَفلُ مُصلَحاً","وَتَحنُقُ أَن تُجنى عَلَيكَ العَظائِمُ",20,"م",1,0],["وترضى ولو عمن تبرم بالرضا","وتسلى ولو عمن أبي منك أن تسلى",21,"ل",2,0],["وترض صدرا منه أمسى","كنز معرفة وحكمه",22,"م",2,0],["وترضى أضل ومنك الرشاد","وأنت لما نابني تشهد",23,"د",1,0],["وَتَرضَى بِهِ حُكماً مِنَ اللهِ بَادِياً","وَتَأبَاهُ فِعلاً مِنكَ نَادَى بِشَقوَةِ",24,"ه",1,0],["وترضَى بما لا يرتضي الحرُّ مثلَه","وذو الحلم بالتخييس والذلّ لا يَرضى",25,"ض",2,0],["وترضي خصمها زيداً","لكي يقصي لها عمرا",26,"ر",2,0],["وترضى خنوعا لا يداويَ مسلما","وتشقى بهمٍّ لا يروم مجافيا",27,"ي",2,0],["وترضي أهل النظم والذوق المميز","وبين كل الطرح تأتي فالصداره",28,"ر",2,0],["وترضى أن تكون كقيس ليلى","طريداً يستخف به المجونُ",29,"ن",1,0],["وترضعهم وترا كأن حبابه","حياة لمن كانت له الريح تهشم",30,"م",1,0],["وتَرضَى ما قَسَمتَ لها","وتقنَعُ طولَ عيشتِها؟",31,"ت",3,0],["وترضى للكفاءة أيَّ قبر ٍ","إذا لم يرضَ وقفتهَا الرصيفُ ؟",32,"ف",1,0]]}