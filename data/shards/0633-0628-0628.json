{"poems":[[75,"هل عهدنا الشمس تعتاد الكلل","https://www.aldiwan.net/poem11918.html","الرمل"],[74,"ما لمن لام فيكمو من جواب","https://www.aldiwan.net/poem18239.html","الخفيف"],[53,"فتحت أبواب مدح لا انغلاق لها","https://www.aldiwan.net/poem8299.html","البسيط"],[87,"مضناك جفاه مرقده","https://www.aldiwan.net/poem63667.html","المتدارك"],[47,"ما على الركب من وقوف الركاب","https://www.aldiwan.net/poem10646.html","الخفيف"],[47,"مرحبا بالخيال منك المطيف","https://www.aldiwan.net/poem65145.html","الخفيف"],[107,"هتف النعي فما ملكت بياني","https://www.aldiwan.net/poem42093.html","الكامل"],[107,"تلك عقبى البغي فانظر كيف عادا","https://www.aldiwan.net/poem44219.html","الرمل"],[54,"رثيت الحجيج فقال العداة","https://www.aldiwan.net/poem27263.html","المتقارب"],[50,"أتشتم خير ذي حكم ابن سعد","https://www.aldiwan.net/poem62611.html","الوافر"],[48,"ما الثريا عنقود كرم ملاح","https://www.aldiwan.net/poem22111.html","الخفيف"],[48,"أستقبح الظاهر من صاحبي","https://www.aldiwan.net/poem22286.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54578","الخفيف"],[132,"أنت الحبيب المرتضى ولك الهنا","https://www.aldiwan.net/poem50490.html","الكامل"],[164,"أما الوشاة به فقد ظلموه","https://www.aldiwan.net/poem58961.html","الكامل"],[275,"للقلب إن طال البعاد تقرب","https://www.aldiwan.net/poem35241.html","الكامل"],[275,"عودي الى ماضيك يا بغداد","https://www.aldiwan.net/poem35650.html","الكامل"],[369,"لولا رجائي ثانيا للقائه","https://www.aldiwan.net/poem61006.html","الكامل"],[463,"أنذرتني أم سعد أن سعدا","https://www.aldiwan.net/poem56214.html","الرمل"],[469,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[520,"بصعود منزلة وجد صاعد","https://www.aldiwan.net/poem12058.html","الكامل"],[520,"من أجل هيبة ذا المقام المذهل","https://www.aldiwan.net/poem12202.html","الكامل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61096","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77901","الخفيف"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105422","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71067","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199997","المجتث"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87407","الرمل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112689","الرجز"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138676",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131274",""],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81925","الكامل"],[4396,"","https://poetry.dctabudhabi.ae/diwan/poem/111570","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72415","الرمل"],[4702,"علام الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=155110",""],[4702,"سفينتنا جريحة","https://www.poetsgate.com/ViewPoem.aspx?id=155211",""],[4728,"عجبنا كيف نامن لدنيانا","https://www.poetsgate.com/ViewPoem.aspx?id=176868",""],[4728,"على قبر أبي","https://www.poetsgate.com/ViewPoem.aspx?id=176882",""],[4929,"الى أصحاب قمة اسطنبول","https://www.poetsgate.com/ViewPoem.aspx?id=199263",""],[5136,"يا كافي أحمد النبي الأحزاب","https://www.poetsgate.com/ViewPoem.aspx?id=121502",""],[5225,"عليهم صابر","https://www.poetsgate.com/ViewPoem.aspx?id=25795",""],[5449,"فاءٌ أنا","https://www.poetsgate.com/ViewPoem.aspx?id=188821",""],[5480,"تغاريد الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=1145",""],[5739,"جاوبيني","https://www.poetsgate.com/ViewPoem.aspx?id=126426",""],[5762,"إقرأ كتابك","https://www.poetsgate.com/ViewPoem.aspx?id=13131",""],[5848,"فواتير الغلا","https://www.poetsgate.com/ViewPoem.aspx?id=53370",""],[6068,"سؤال وجواب (التأخر)-08-","https://www.poetsgate.com/ViewPoem.aspx?id=177482",""],[6147,"حنين إلى الفار المخلوع","https://www.poetsgate.com/ViewPoem.aspx?id=151693",""]],"verses":[["سَبَبُ السُقمِ الَّذي بَرَّحَ بي","صِحَّةٌ كَالسُقمِ في تِلكَ المُقَل",0,"ل",1,0],["سببت نظمنا لُهاهُ ولا بدَّ","لنظم القريض من أسباب",1,"ب",1,0],["سبِّبْ أو افعل بل اسمح لي بجمعهما","فعلاً بفعلٍ وتسبيباً بتسبيبِ",2,"ب",1,0],["سَبَبٌ لِرِضاكَ أُمَهِّدُهُ","ما بالُ الخَصرِ يُعَقِّدُهُ",3,"د",2,0],["سَبَبٌ أَوَّلٌ عَلى جودِ إِسما","عيلَ أَغنى عَن سائِرِ الأَسبابِ",4,"ب",1,0],["سَبَبٌ بَينَنا مِنَ الأَدَبِ المَح","ضِ قَوِيُّ الأَسبابِ غَيرُ ضَعيفِ",5,"ف",1,0],["سببان من دُنيا الشُّعوبِ ودينهم","تتفرَّقُ البلوى ويفترقانِ",6,"ن",1,0],["سَببٌ للّهِ من يَعلقْ بهِ","لم يَخَفْ ضَيْماً ولم يَخْشَ اضطهادا",7,"د",2,0],["سُبِبتُ فَمَن لامَني مِنهُمُ","فَلَستُ بِمُرضٍ وَلا مُعتِبِ",8,"ب",1,0],["سَبَبتُ اِبنَ الحُدَيجِ فَسَبَّ ظِلّي","لَعَمرُ أَبيكَ لا اِستَوفى وَزادا",9,"د",2,0],["سُبِّبَ الرِزقُ لِلأَنامِ فَما يَق","طَعُ بِالعَجزِ ذَلِكَ التَسبيبُ",10,"ب",1,0],["سُبِبتَ بِالكَلبِ فَأَنكَرتَهُ","وَالكَلبُ خَيرٌ مِنكَ إِذ يَنبَحُ",11,"ح",1,0],["سَبَبٌ خَدْمَةُ الْحُكُومَةِ إِلاَّ","أَنَّ لِلْجَاهِ دُونَهَا أَسْبَابَا",12,"ب",2,0],["سببُ العلاقةِ نظرةٌ بجمالهم","فتمكنتْ لما أدَرْت الأعينَا",13,"ن",2,0],["سببان مدرسة المجاهد والخطا","بة عدهما لي فهو ما أخذوه",14,"و",2,0],["سببُ الشَّقاوةِ حرصُنا وطموحُنا","إنَّ الشقاءَ مع الرجاءِ لطِّيب",15,"ب",1,0],["سَبَبُ التأخُّرِ والسّقوطِ تخاذلٌ","للعزمِ فيهِ والنشاط نفاد",16,"د",1,0],["سبب النجاة ولاؤه ورجاءه","فتمسكوا بولائه ورجائه",17,"ا",3,0],["سبّبتْ لي فيكِ أضغانَ العدا","نظرةٌ أرسلتُها تطلبُ ودّا",18,"د",2,0],["سبباً لوعةٍ وأصلاً ولوعٍ","ودفينا بثٍ وبرْحا غرامِ",19,"م",1,0],["سببٌ هجنَ القرابة حسناً","وذمامٌ أكرِمْ بهِ من ذمامِ",19,"م",1,0],["سبب يمت إلى البتول وعروة","عقدة بأوثق عروة ومعاقد",20,"د",1,0],["سبب غدا نسباً وأنت وصلته","منهم بعصمة عقدة لم تحلل",21,"ل",1,0],["سَبب البشارة بِاللقاء فراقه","لَولا الفِراق لَما رَأَيت بَشيرا",22,"ر",2,0],["سبب الخير صبحة الأَخيار","واِجتناب الأغرة الأَشرار",23,"ر",1,1],["سببت على عجف تعثر في السرى","يحدو بها مستعجل لا يلبث",24,"ث",1,0],["سَبباً إلى نَيْلِ الوِداع وعِلَّةً","يتستَّرون بها عن التصميمِ",25,"م",1,0],["سبب التناول وهو يوجب لذة","أخرى سوى ما نالت العينان",26,"ن",1,0],["سببت بالجود من قد","سلبته المال غدرا",27,"ر",2,0],["سَبَبُ الحبّ عيونٌ وَعيونٌ","لَحظاتٌ تَلتَقيها لَحظاتُ",28,"ت",1,0],["سبب قتل ابن النبي الطاهر","وأنه أقوى من المباشر",29,"ر",1,0],["سبب الاسباب لولاهم لما","سبب الرحمن ما قد سببا",30,"ب",2,0],["سبب الهوى نظرٌ إلى وجهٍ جرى","فيه معين الحسن غير مبرقع",31,"ع",1,1],["سبب النجاة لمن أراد نجاته","والبضعة الزهراء والحسنان",32,"ن",1,0],["سببتم عتيقاً والأمامين بعده","فلم تعدموا يوم الحريق المضرم",33,"م",1,0],["سببي في نسبي وكنه أيدي حسبي","بعرى باب علي نعم ما قد أوكت",34,"ت",1,1],["سبب خبلٍ يشوف الصيد واطلق طيره المكسور","جهل مدري غشامه بسّ مدري ويش تأويله",35,"ل",2,0],["سبب ركابها كلٍ حجز له مقعد وغره","قعد ما همه اقصاها وتجاهل وضعها الأدنى",36,"ن",2,0],["سببها حكاوينا تخالف نوايانا","ولو جت مساعينا توافق مبادينا",37,"ن",2,0],["سببها زاهد الدنيا إلى أرض الخلود يْفوت","إلى آخر ملاحم شاعرٍ عنوانه التنهيت",38,"ت",1,0],["سببانِ يكفي ان تثارَ لواحدٍ","خيلُ العروبةِ للنفير ِوتَصْهُلُ",39,"ل",1,0],["سبب لكفايتي إلهي أسباب","من شر يعارض مكر أنساب",40,"ب",1,0],["سبب خلٍ عليه القلب يهمل","هميل العين ما كف اندفاعه",41,"ع",2,0],["سببٌ ثقيلٌ اسمُنا بين الورى","أنَّى نُقيمُ الأرضُ منَّا تَسأمُ",42,"م",1,0],["سببٌ خفيفٌ أنْ نعودَ لأرضِنا","سببٌ خفيفٌ إِنَّما نتألَّمُ",42,"م",1,0],["سبب منهو خطف قلبي وشل امن الحشا ما لاف","وخلى دمعة ً خجلا على خدي بي اتْماري",43,"ر",2,0],["سبب الفوضى في بث أبراجها.","والتردد.! في تِردد مع قصور.",44,"ر",1,0],["سببٌ، بأوتار القلوب.. عروقُهُ","إن رنّ هذا.. رنّ ذاكَ ورجَّعا!",45,"ع",2,0],["سببت لك لوعه بعدها لوعه","اشقيت حالك وانشقى بك حالي",46,"ل",2,0],["سبب التأخر آية","قد صانها الروح القدس",47,"س",1,0],["سببْناك .بل قلْ محوْناك..فاغرُب..","فليت امّحاءَك يَشفي الغليل",48,"ل",1,0]]}