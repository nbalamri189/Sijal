{"poems":[[53,"أتحسب سوء الظن يجرح في فكري","https://www.aldiwan.net/poem30426.html","الطويل"],[55,"يسير فلا تشييعه أستطيعه","https://www.aldiwan.net/poem26104.html","الطويل"],[55,"ألا فانظري بالله يا سكني الوعدا","https://www.aldiwan.net/poem26406.html","الطويل"],[77,"ألا عد عن ذكر الرحيق المفدم","https://www.aldiwan.net/poem36092.html","الطويل"],[88,"أقول لهم وقد جد الفراق","https://www.aldiwan.net/poem44404.html","الطويل"],[72,"مقسم الخاطر ولهانه","https://www.aldiwan.net/poem20166.html","السريع"],[92,"كرهت القصور وقطانها","https://www.aldiwan.net/poem38931.html","المتقارب"],[89,"كتاب رثاء يحمل البث من قلبي","https://www.aldiwan.net/poem44958.html","الطويل"],[45,"قد كان يعلم من طرفي بها طرفا","https://www.aldiwan.net/poem62683.html","البسيط"],[66,"ملكت ببعض برك رق شكري","https://www.aldiwan.net/poem38795.html","الوافر"],[66,"سوى حسن وجهك لم يحل لي","https://www.aldiwan.net/poem40964.html","المتقارب"],[87,"سلامة عرضي في خفارة صارمي","https://www.aldiwan.net/poem8282.html","الطويل"],[69,"أأخشى من الأعداء والله ناصري","https://www.aldiwan.net/poem28981.html","الطويل"],[48,"طموح العين والنظر","https://www.aldiwan.net/poem63343.html","مجزوء الوافر"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9958","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42552","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67298","المتقارب"],[29,"إذا لان الصفا عن طولِ نحتٍ","https://www.poetsgate.com/ViewPoem.aspx?id=17341",""],[115,"سلوا حمرة الخدين عن مهجة الصب","https://www.aldiwan.net/poem41230.html","عموديه"],[115,"فراق الأم أم رحاب قلبي","https://www.aldiwan.net/poem41725.html","الوافر"],[150,"ألا فاشكروا نعمى الإله يزدكم","https://www.aldiwan.net/poem68580.html","الطويل"],[185,"أخلآى بالثغر دام الفراق","https://www.aldiwan.net/poem14614.html","المتقارب"],[204,"ظبي نفى عن جفيني الوسن","https://www.aldiwan.net/poem53162.html","المتقارب"],[210,"فؤاد بذكر العامرية مغرم","https://www.aldiwan.net/poem13295.html","الطويل"],[210,"أماني الهنا بالحمد وافت وبالشكر","https://www.aldiwan.net/poem13524.html","الطويل"],[212,"خليدة ذاب القلب من حر شوقكم","https://www.aldiwan.net/poem37854.html","الطويل"],[212,"مررنا بروض والركائب وقف","https://www.aldiwan.net/poem37859.html","الطويل"],[259,"سلام حكى نظم الجواهر في السلك","https://www.aldiwan.net/poem35792.html","الطويل"],[261,"أمض الجوى صد القريب المجانب","https://www.aldiwan.net/poem38365.html","الطويل"],[270,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[270,"وقفت على الأمواج أبكي وأشتاق","https://www.aldiwan.net/poem35597.html","الطويل"],[297,"من عم طلعتك الغراء بالبلج","https://www.aldiwan.net/poem33309.html","البسيط"],[305,"حبيبي إن حبك ملء قلبي","https://www.aldiwan.net/poem56376.html","الوافر"],[353,"وفاتنة من الغيد الغواني","https://www.aldiwan.net/poem39798.html","الوافر"],[364,"ألا ليت قلبي يوم أعلن وجده","https://www.aldiwan.net/poem60955.html","الطويل"],[366,"أبى الغمض والتمهيد جفناي والجنب","https://www.aldiwan.net/poem17158.html","الطويل"],[377,"أراك غني الفضل تنتهر البوسا","https://www.aldiwan.net/poem59381.html","الطويل"],[377,"يا صاح إسمع مذ سمت","https://www.aldiwan.net/poem66909.html","مجزوء الرجز"],[380,"فؤاد به من فقد أحبابه جمر","https://www.aldiwan.net/poem48833.html","الطويل"],[458,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[461,"رعاك ضمان الله ما أظلم الدجى","https://www.aldiwan.net/poem15657.html","الطويل"],[464,"جلت عزماتك الفتح المبينا","https://www.aldiwan.net/poem3115.html","عموديه"],[464,"نعم نفحة الوادي التي تتأرج","https://www.aldiwan.net/poem3143.html","عموديه"],[464,"رمتني بنجل والسهام جفون","https://www.aldiwan.net/poem3591.html","عموديه"],[538,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"],[538,"أودع في صباح غد حبيبا","https://www.aldiwan.net/poem48269.html","عموديه"],[551,"وثقت بكم حتى خجلت وكم جنت","https://www.aldiwan.net/poem47888.html","الطويل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"شفاك الله من دائك","https://www.aldiwan.net/poem2699.html","الهزج"],[586,"له مني المحبة والوداد","https://www.aldiwan.net/poem17485.html","الوافر"],[586,"أوائل حب ما لهن أواخر","https://www.aldiwan.net/poem17524.html","الطويل"],[587,"بحمد الله نبدأ في المقال","https://www.aldiwan.net/poem11558.html","عموديه"]],"verses":[["فَقَلبِيَ يَأبى أَن يُدَنَّسَ سِرُّهُ","بِرَيبٍ وَوُدّي أَن يُعَنَّفَ مِن غَدري",0,"ي",1,0],["فَقَلبي إِذا ما سارَ حِلفُ صَبابَةٍ","وَقَلبي إِذا كانَ القُدومُ مُتَيَّمُ",1,"م",1,0],["فَقَلبي إِلَيكُم لا يَزالُ يَجُرُّني","وَيَفتَحُ لي باباً مِنَ الحُبِّ مُنسَدّا",2,"د",2,0],["فَقَلبِي لَكَ الْبَيْتُ الْعَتِيقُ مَقَامُهُ","وَشَوْقِيَ إِحْرَامِي وَدَمْعِيَ زَمْزَمِي",3,"م",2,0],["فقلبي فوق أرؤسكم مطار","ودمعي تحت أرجلكم مراق",4,"ق",1,0],["فقلبه في مصر مستودعٌ","وفي أقاصي الشام جثمانه",5,"ن",2,0],["فقلَّبتُ طَرْفي بمهْوى الزُّهُورِ","وصعَّدته في الفضاءِ الأَسيفْ",6,"ف",1,0],["فقلبٌ على ما كان ولهان آسف","وعينٌ على ما ناب دائمة السكب",7,"ب",1,0],["فَقَلبُهُ مِن حَذارى واجِفٌ وَلِهٌ","دوني عَلى بَيتِها سِترٌ وَتَحريجُ",8,"ج",1,0],["فَقَلبُكَ في الشَدائِدِ صَدرُ بَحرٍ","وَصَدرُكَ في الأَوابِدِ قَلبُ بَحرِ",9,"ر",1,0],["فَقَلبي بِإِحسانِكُم فارِغٌ","وَكَفّي بِإِنعامِكُم مُمتَلي",10,"ل",2,0],["فَقَلْبِيَ حُرٌّ لا يَدِينُ لِصَوْلَةٍ","وَعُودِيَ صُلْبٌ لا يَلِينُ لِعَاجِمِ",11,"م",1,0],["فقلبيَ مسرورٌ وسعديَ مقبلٌ","وحربيَ نصرٌ والمقالُ صوابُ",12,"ب",1,0],["فَقَلبي غَيرُ مُصطَبِرٍ","وَعَنهُ غَيرُ مُزدَجَرِ",13,"ر",1,0],["فَقَلبي هائِمٌ في كُلِّ أَرضٍ","يُقَبِّلُ إِثرَ أَخفافِ الجِمالِ",14,"ل",1,0],["فَقَلْبِيَ تَحْتَ السَّرْدِ كَالنَّارِ لافِحٌ","وَدَمْعِيَ فَوْقَ الْخَدِّ كالْمَاءِ سافِحُ",15,"ح",1,0],["فَقَلْبُكَ مِنْ ذِكْرِهِم خافِقٌ","مِنَ الشَّوقِ والحَزَنِ المُنْضِجِ",16,"ج",1,0],["فقلبكَ رامَها الجبارُ فينا","فكانَ لَنا، وللجبّارِ دينُ",17,"ن",1,0],["فقلبي وعيني في دمي قد تشاركا","فخصمي خصيمي آه والداء في الطب",18,"ب",1,0],["فقلبي كلما خطرت ببالي","يئج جوى ودمعي فيض مزن",19,"ن",1,0],["فَقَلبي مَكلومٌ وَجَفنيَ أَمرَهُ","شُجوني لِفَقدِ الهاشميِّ عَتيدَةٌ",20,"ه",1,0],["فقلبيَ منذ سَباني البعادُ","له نحوَكم كلَّ يوم إباق",21,"ق",1,0],["فقلبي سقيم وجسمي نحيلٌ","ودمعي غزيرٌ هطولٌ هَتِنْ",22,"ن",1,0],["فقلبي على ما تعهدون من الوفا","مقيم وحبل الود لا ينصرم",23,"م",1,0],["فقلبي كسير صح عندك جبره","فلا بدع ان قابلت كسريَ بالجبر",24,"ر",1,0],["فقلبي لَدَيْكُم مُوْثَقٌ ومُقَيَّدٌ","ودَمْعِي علَيْكُم مُسْبَل وطلِيقُ",25,"ق",1,0],["فقلب مولاي ابن سلطان ذي الندى","سعيد بذكراه الورى تَتَشَرَّفُ",26,"ف",1,0],["فقلبي بلا سلوان قدس مقامه","غدا مدنيّ الحبّ وهو الفتى المكّي",27,"ك",2,0],["فقلبي اعيى منقذ آل منقذ","وأعوز فيه غالب بن غالب",28,"ب",1,0],["فقلبي وعيني مَطلعانِ لنورها","وما أطلعَ الأنوارِ غيرُ الدُّجنَّة",29,"ه",1,0],["فقلبي سماءٌ ليسَ يأفلُ نجمُها","وفيها لأحبابي ثغورٌ وأحداق",30,"ق",1,0],["فَقَلبُه من سَعير الوَجدِ ذو حُرَقٍ","وَجَفنُه من بحار الدَمع في لُجَجِ",31,"ج",1,0],["فَقَلبي مِنكَ مرآةُ التجلّي","وِذكركَ في جلا الأصداءِ قينُ",32,"ن",1,0],["فَقَلبي وَاِسمهُ وَهَواك عِندي","سَليمٌ في سَليمٍ في سَليمِ",33,"م",1,0],["فقَلبِيَ من شَوقٍ إذا قلتُ قد خَبا","مَع الليّلِ أحيا ناسِمُ الريحِ وَقْدَه",34,"د",2,0],["فَقَلبي قَلبٌ لا يَخِفُّ لَهُ حَشاً","وَعَينِيَ عَينٌ لا يَجِفُّ لَها غَربُ",35,"ب",1,0],["فقلبي الحديديْ صار جسماً محدَّداً","وصوتُهُمُ النيرانَ أو مَغَناطيسا",36,"س",2,0],["فقلبه كالحُربه","حوى ضروب النوب",37,"ب",1,0],["فَقلب وَلا جسم وَطَرف وَلا كَرى","وَشَوق وَلا قَلب وَلَيل وَلا فَجر",38,"ر",1,0],["فقلبُها من قلبي","الأخ وإبنُ العمِّ",39,"م",1,0],["فقلبه من طَعْم","ووجهُه من طعمِ",39,"م",1,0],["فقلبيَ والعَلْياءُ فيكَ كِلاهُما","ذوا صَبْوةٍ سلوانُها غيرُ واقعِ",40,"ع",1,0],["فقلب القدس مسرور ولولا","سطاك لكان مكتئباً حزينا",41,"ن",2,0],["فقلبٌ كما شاءت يلجُّ ضرامهُ","وإنسان عينٍ في الدموع يلجّج",42,"ج",1,0],["فقلبي زناد والسّويداء حراقة","وللنار فيما بين ذاك كمون",43,"ن",1,0],["فقلبُ مُحتَاجٍ رَجَاء خائِفٍ","وقلبُ بَاغٍ خَائِفٍ مِن فَرَقِ",44,"ق",1,0],["فقلبِي بَعدَهُ شيئا فَشَيئاً","يَذوبنُ وكيفَ قلبِي لا يذُوبُ",45,"ب",1,0],["فقلبِيَ عنكمْ مُعرضٌ غيرُ مائقٍ","ودمعِي عليكمْ جامدٌ غيرُ سافِحِ",46,"ح",1,0],["فقلب كل مؤمن مجيب","يسرح في علم من الغيوب",47,"ب",1,0],["فقَلْبي بات قد أَعْيا","من الهمِّ كإِعْيَائك",48,"ك",1,0],["فقلبي لا يُلَائِمُهُ اصْطِبارٌ","وَجفْنِي لا يُفارِقهُ السُّهَادُ",49,"د",1,0],["فَقلْبيَ في بَحْرِ الصَّبابةِ وَاقعٌ","غَرِيقٌ ولُبِّي في فَضَا الوَجْدِ طائِرُ",50,"ر",1,0],["فقلب ليس يشهدها سقيم","ومنكوس لفعل الخير قال",51,"ل",1,0]]}