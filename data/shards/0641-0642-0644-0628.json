0,"أتاك العيد","https://www.poetsgate.com/ViewPoem.aspx?id=1460",""],[5431,"وما الكره إلا هلاك سعى!!....","https://www.poetsgate.com/ViewPoem.aspx?id=199939",""],[5582,"أَفْراحُ أَهْلِ الهَوَى فِي الهَجْرِ أَحْزانُ","https://www.poetsgate.com/ViewPoem.aspx?id=187308",""],[243,"العش المهجور","https://www.poetsgate.com/ViewPoem.aspx?id=50479",""],[5672,"من الطفيات","https://www.poetsgate.com/ViewPoem.aspx?id=215679",""],[5704,"إذا أن فتشت القلوب وجدتها..","https://www.poetsgate.com/ViewPoem.aspx?id=202947",""],[1155,"ترى يا جيرة الرمل","https://www.poetsgate.com/ViewPoem.aspx?id=190928",""],[5746,"عهد قلم","https://www.poetsgate.com/ViewPoem.aspx?id=207121",""],[5790,"أتسمع ما يقول لك النسيم","https://www.poetsgate.com/ViewPoem.aspx?id=112130",""],[5853,"علام..؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=175681",""],[5906,"مَشَقة نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=188069",""],[5943,"بريء","https://www.poetsgate.com/ViewPoem.aspx?id=21949",""],[5957,"لماذا زرعت بذور الأمل؟","https://www.poetsgate.com/ViewPoem.aspx?id=29970",""],[5989,"بالشعر .. ؛ لا أكثر","https://www.poetsgate.com/ViewPoem.aspx?id=181549",""],[5997,"الوَمْضَة","https://www.poetsgate.com/ViewPoem.aspx?id=214258",""],[6004,"شَكوَى الحَمَامِ","https://www.poetsgate.com/ViewPoem.aspx?id=71984",""],[6048,"رفقا بحالي","https://www.poetsgate.com/ViewPoem.aspx?id=200487",""],[6102,"إِفراط ..","https://www.poetsgate.com/ViewPoem.aspx?id=182848",""],[6120,"أُوَزِّعُ الْحُزْنَ فِي يَوْمِي","https://www.poetsgate.com/ViewPoem.aspx?id=214994",""],[6142,"ما العرب إلا سماء للعلاء وما","https://www.poetsgate.com/ViewPoem.aspx?id=155759",""],[6152,"روح الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=204434",""],[6247,"أتدرين أنك أمّ الجمال؟!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80293&r=&rc=32",""],[6251,"أتيتك بالبشر لا بالعزاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76474&r=&rc=14",""]],"verses":[["فَقَلبِيَ يَأبى أَن يُدَنَّسَ سِرُّهُ","بِرَيبٍ وَوُدّي أَن يُعَنَّفَ مِن غَدري",0,"ر",2,0],["فَقَلبي إِذا ما سارَ حِلفُ صَبابَةٍ","وَقَلبي إِذا كانَ القُدومُ مُتَيَّمُ",1,"م",1,0],["فَقَلبي إِلَيكُم لا يَزالُ يَجُرُّني","وَيَفتَحُ لي باباً مِنَ الحُبِّ مُنسَدّا",2,"د",2,0],["فَقَلبِي لَكَ الْبَيْتُ الْعَتِيقُ مَقَامُهُ","وَشَوْقِيَ إِحْرَامِي وَدَمْعِيَ زَمْزَمِي",3,"م",2,0],["فقلبي فوق أرؤسكم مطار","ودمعي تحت أرجلكم مراق",4,"ق",1,0],["فقلبه في مصر مستودعٌ","وفي أقاصي الشام جثمانه",5,"ن",2,0],["فقلَّبتُ طَرْفي بمهْوى الزُّهُورِ","وصعَّدته في الفضاءِ الأَسيفْ",6,"ف",1,0],["فقلبٌ على ما كان ولهان آسف","وعينٌ على ما ناب دائمة السكب",7,"ب",1,0],["فَقَلبُهُ مِن حَذارى واجِفٌ وَلِهٌ","دوني عَلى بَيتِها سِترٌ وَتَحريجُ",8,"ج",1,0],["فَقَلبُكَ في الشَدائِدِ صَدرُ بَحرٍ","وَصَدرُكَ في الأَوابِدِ قَلبُ بَحرِ",9,"ر",1,0],["فَقَلبي بِإِحسانِكُم فارِغٌ","وَكَفّي بِإِنعامِكُم مُمتَلي",10,"ل",2,0],["فَقَلْبِيَ حُرٌّ لا يَدِينُ لِصَوْلَةٍ","وَعُودِيَ صُلْبٌ لا يَلِينُ لِعَاجِمِ",11,"م",1,0],["فقلبيَ مسرورٌ وسعديَ مقبلٌ","وحربيَ نصرٌ والمقالُ صوابُ",12,"ب",1,0],["فَقَلبي غَيرُ مُصطَبِرٍ","وَعَنهُ غَيرُ مُزدَجَرِ",13,"ر",1,0],["فَقَلبي هائِمٌ في كُلِّ أَرضٍ","يُقَبِّلُ إِثرَ أَخفافِ الجِمالِ",14,"ل",1,0],["فَقَلْبِيَ تَحْتَ السَّرْدِ كَالنَّارِ لافِحٌ","وَدَمْعِيَ فَوْقَ الْخَدِّ كالْمَاءِ سافِحُ",15,"ح",1,0],["فَقَلْبُكَ مِنْ ذِكْرِهِم خافِقٌ","مِنَ الشَّوقِ والحَزَنِ المُنْضِجِ",16,"ج",1,0],["فقلبكَ رامَها الجبارُ فينا","فكانَ لَنا، وللجبّارِ دينُ",17,"ن",1,0],["فقلبي وعيني في دمي قد تشاركا","فخصمي خصيمي آه والداء في الطب",18,"ب",1,0],["فقلبي كلما خطرت ببالي","يئج جوى ودمعي فيض مزن",19,"ن",1,0],["فَقَلبي مَكلومٌ وَجَفنيَ أَمرَهُ","شُجوني لِفَقدِ الهاشميِّ عَتيدَةٌ",20,"ه",1,0],["فقلبيَ منذ سَباني البعادُ","له نحوَكم كلَّ يوم إباق",21,"ق",1,0],["فقلبي سقيم وجسمي نحيلٌ","ودمعي غزيرٌ هطولٌ هَتِنْ",22,"ن",1,0],["فقلبي على ما تعهدون من الوفا","مقيم وحبل الود لا ينصرم",23,"م",1,0],["فقلبي كسير صح عندك جبره","فلا بدع ان قابلت كسريَ بالجبر",24,"ر",1,0],["فقلبي لَدَيْكُم مُوْثَقٌ ومُقَيَّدٌ","ودَمْعِي علَيْكُم مُسْبَل وطلِيقُ",25,"ق",1,0],["فقلب مولاي ابن سلطان ذي الندى","سعيد بذكراه الورى تَتَشَرَّفُ",26,"ف",1,0],["فقلبي بلا سلوان قدس مقامه","غدا مدنيّ الحبّ وهو الفتى المكّي",27,"ك",2,0],["فقلبي اعيى منقذ آل منقذ","وأعوز فيه غالب بن غالب",28,"ب",1,0],["فقلبي وعيني مَطلعانِ لنورها","وما أطلعَ الأنوارِ غيرُ الدُّجنَّة",29,"ه",1,0],["فقلبي سماءٌ ليسَ يأفلُ نجمُها","وفيها لأحبابي ثغورٌ وأحداق",30,"ق",1,0],["فَقَلبُه من سَعير الوَجدِ ذو حُرَقٍ","وَجَفنُه من بحار الدَمع في لُجَجِ",31,"ج",1,0],["فَقَلبي مِنكَ مرآةُ التجلّي","وِذكركَ في جلا الأصداءِ قينُ",32,"ن",1,0],["فَقَلبي وَاِسمهُ وَهَواك عِندي","سَليمٌ في سَليمٍ في سَليمِ",33,"م",1,0],["فقَلبِيَ من شَوقٍ إذا قلتُ قد خَبا","مَع الليّلِ أحيا ناسِمُ الريحِ وَقْدَه",34,"د",2,0],["فَقَلبي قَلبٌ لا يَخِفُّ لَهُ حَشاً","وَعَينِيَ عَينٌ لا يَجِفُّ لَها غَربُ",35,"ب",1,0],["فقلبي الحديديْ صار جسماً محدَّداً","وصوتُهُمُ النيرانَ أو مَغَناطيسا",36,"س",2,0],["فقلبه كالحُربه","حوى ضروب النوب",37,"ب",1,0],["فَقلب وَلا جسم وَطَرف وَلا كَرى","وَشَوق وَلا قَلب وَلَيل وَلا فَجر",38,"ر",1,0],["فقلبُها من قلبي","الأخ وإبنُ العمِّ",39,"م",1,0],["فقلبه من طَعْم","ووجهُه من طعمِ",39,"م",1,0],["فقلبيَ والعَلْياءُ فيكَ كِلاهُما","ذوا صَبْوةٍ سلوانُها غيرُ واقعِ",40,"ع",1,0],["فقلب القدس مسرور ولولا","سطاك لكان مكتئباً حزينا",41,"ن",2,0],["فقلبٌ كما شاءت يلجُّ ضرامهُ","وإنسان عينٍ في الدموع يلجّج",42,"ج",1,0],["فقلبي زناد والسّويداء حراقة","وللنار فيما بين ذاك كمون",43,"ن",1,0],["فقلبُ مُحتَاجٍ رَجَاء خائِفٍ","وقلبُ بَاغٍ خَائِفٍ مِن فَرَقِ",44,"ق",1,0],["فقلبِي بَعدَهُ شيئا فَشَيئاً","يَذوبنُ وكيفَ قلبِي لا يذُوبُ",45,"ب",1,0],["فقلبِيَ عنكمْ مُعرضٌ غيرُ مائقٍ","ودمعِي عليكمْ جامدٌ غيرُ سافِحِ",46,"ح",1,0],["فقلب كل مؤمن مجيب","يسرح في علم من الغيوب",47,"ب",1,0],["فقَلْبي بات قد أَعْيا","من الهمِّ كإِعْيَائك",48,"ك",1,0],["فقلبي لا يُلَائِمُهُ اصْطِبارٌ","وَجفْنِي لا يُفارِقهُ السُّهَادُ",49,"د",1,0],["فَقلْبيَ في بَحْرِ الصَّبابةِ وَاقعٌ","غَرِيقٌ ولُبِّي في فَضَا الوَجْدِ طائِرُ",50,"ر",1,0],["فقلب ليس يشهدها سقيم","ومنكوس لفعل الخير قال",51,"ل",1,0],["فقل بهاجر إسماعيل أحزانها","متى تشط عنها من حر الظما تؤب",52,"ب",1,0],["فَقَلبي من يَوم النَوى في تَغابُنٍ","إِلى أَن أَرى في الحشر شخصَك في صَفي",53,"ف",2,0],["فقلّب في ما لديه الجفونا","فألفى مشاهد توري الشجونا",54,"ن",2,1],["فقلبي قلب لم يشنه تغير","وودي ود لم يشه تملق",55,"ق",1,0],["فقلبي زناد والسّويدا حراقة","وللنار فيما بين ذاك كمون",56,"ن",1,0],["فقلبي خافق أبدا لهاد","وشوقي حاضر أبدا لبادي",57,"د",2,0],["فَقَلْبِي وَقُرْطَاهَا وَصَبْرِي وَخصْرُهَا","وَوَجْدِي وَرِدْفَاهَا وَدَمْعِيَ وَالعِقْدُ",58,"د",1,0],["فَقَلبي لا يزالُ لخص","رِها الظمآن ظمآنا",59,"ن",2,0],["فَقَلبي هام غيلان بميّ","وَكانَ الحاذقَ الفطنَ الأريبا",60,"ب",2,0],["فَقلبْي ولبِّي مَعاً عَازبان","وَعَيْنايَ عَيْنانِ نضَّاخَتانِ",61,"ن",1,0],["فقلبه معذب بينهما","ما لم يكن مؤديا حقهما",62,"م",2,0],["فقل بعلو صوت وارتفاع","وثقت بعهد سيدنا الرفاعي",63,"ي",1,0],["فقل بدخولها أرّخت أمناً","فبيت المجد جُدّد بالبشيرِ",64,"ر",1,0],["فقلبك أثبت من قلبه","وزندك أفتل من زنده",65,"د",2,0],["فَقُل بَعدَ إِهداءِ السَلام تَحِيَّة","تَعُمُّ ضَجِيعَيه الكرام المَواليا",66,"ي",2,0],["فقلبك أعي أن يراع فما الذي","عراه فأعياه أرتياعاً وقلبا",67,"ب",2,0],["فَقَلْبِيَ عَنْ رُوحٍ وَعَنْ نَائِلٍ يَدِي","وَعَنْ مَرْحَبٍ أُذْنِي وَعَيْنِيَ عَنْ بِشْرِ",68,"ر",1,0],["فقلبى على حفظ المودَّةِ ثابتٌ","ولكن له قلبٌ كثيرُ التّقلُّبِ",69,"ب",1,0],["فقلبٌ لها ترحاً واقعٌ","وقلبٌ لها فرحاً طائر",70,"ر",1,0],["فَقَلبي رائح غادي","كغصن فيه أَغصان",71,"ن",1,0],["فَقَلبي في الهَوى مضني","وَروحي بالعنا مَعنى",72,"ن",2,0],["فقل بمدحته ما قاله رجلٌ","نادى غنيّاً شحيحاً للندى فأبى",73,"ب",2,0],["فَقَلْبي بأَيِّ النظرتين كَرَرتُها","إليها وعنها تلك تُغْرِي ولا تُسْلي",74,"ل",2,0],["فقلبي مفئود وطرفي مسهد","ونومي مفقود وصبري فاني",75,"ن",2,0],["فقلبي لحر الوجد لم يفت صالياً","وطرفي بماء الدمع ريان منقعا",76,"ع",2,0],["فَقَلبِي من جفاه في جحيمٍ","وألحَاظِي تَمتَّعُ بِالجنَانِ",77,"ن",1,0],["فَقَلَبتُمُ تِلكَ الحَقَائِقَ مِثلَ مَا","قُلِبَت قُلُوبُكُمُ عَنِ الإِيمَانِ",78,"ن",1,0],["فقلبها لم تطل فيه مسرته","حتى تنازع تبريح الجوى فيه",79,"ي",2,0],["فَقَلبيَ في نارٍ مِن الوَجدِ خالِدٌ","وَطَرفيَ في بَحرٍ مِن الدَمعِ غائِصُ",80,"ص",1,0],["فَقَلبيَ مُسوَدٌ وَليلي مِثلُهُ","سواداً فَجاءوني بِمسوَدَّةِ الجلدِ",81,"د",1,0],["فَقَلبيَ في حُزنٍ وَعَينيَ في بُكا","فَيا لَكَ شَجواً بينَ ذا قَد ثَوى وَذِي",82,"ذ",2,0],["فقلبي مدهوف","ووجهي مكشوف",83,"ف",1,0],["فقلبي به شطران جذلان واحدٌ","وآخر محزونٌ من أجلك محرق",84,"ق",1,0],["فقلبي يفوق جميع القصور","به أودع الدر والجوهر",85,"ر",1,0],["فقلبي قلب لم يشنه تغير","وودي ود لم يشبْه تملق",86,"ق",1,0],["فقلبت السياسة كل قلب","وبتنا تستبد بنا الأمور",87,"ر",1,0],["فَقَلْبِيَ لَو رَامَ السلُوَّ ثَنيَتُه","عَن القَرِّ ما بينَ الضُّلوعِ إلى النَّفْرِ",88,"ر",1,0],["فقلبٌ يدقّ بلحنِ الغرامِ","ونَفسٌ تُصَلي بمحرابها",89,"ه",2,0],["فقل باعدي يا إست إن زال نفعها","ولا تبعدينا من جناك المعلِّل",90,"ل",1,0],["فقلبي فقير في ظلام همومه","لجامد نورٍ فيه ذوبٌ من التبر",91,"ر",1,0],["فقلبي اذا عن الأسى رهن وجده","وطرفي اذا جن الدجى حلف سهده",92,"د",2,0],["فقلبك مذبان الخليط مودع","وعينك إذ شطت به الدار تدمع",93,"ع",1,0],["فقل به ليث العرين فيه قد","أمته اغنام فشد مغضبا",94,"ب",2,0],["فقلبيَ مدلولٌ وأن دليلهُ","لساني كما دلَّ الدُخانُ على النارِ",95,"ر",1,0],["فقلبي على جمر الأَسَى متقلبٌ","ودمعي على الخدَّينِ يجري ويمتدُّ",96,"د",1,0],["فَقلب الشَمس مشتعلٌ بنار","وَنورُ البَدر يُكسَفُ من وجوم",97,"م",1,0],["فَقَلْبِي بِذِكْرِ اللِّوَى خافِقٌ","مَشُوقٌ لِسُكّانِ تِلْكَ النُّواحْ",98,"ح",1,0],["فقلبيَ لا يخفاك والجسم ظاهرٌ","وسؤلي لا ينآكَ رب بماجدِ",99,"د",1,0],["فقلبي خافقٌ حتى يكاد","يطير فوق فمي",100,"ي",1,0],["فَقَلبيَ عِندَ النَظمِ مُستَغفرٌ عَلى","مآثمَ لَولا الحال ما كُنتُ أَصنَعُ",101,"ع",1,0],["فقلبي في السلم الزجاجة رقة","وفي الحرب أقصى من حديد وجلمد",102,"د",1,0],["فقل بالليث عريسا تهادى","أمالهم وليس إلى الزفاف",103,"ف",1,0],["فقلبي وما نار الغضا مثل ناره","ودمعي وما وادي العقيق كواديه",104,"ي",2,0],["فقلبي كما شاء النوى ظل راحلا","وجسمي كما يقضى الهوى بات ثاويا",105,"ي",2,0],["فقلبيَ بينَ الشّوقِ والصبرِ واقفٌ","على جَدَدٍ بينَ الولايةِ والعزلِ",106,"ل",1,0],["فقلبك الصلد والإحراق شيمتهُ","ولين قلبي بنيرا