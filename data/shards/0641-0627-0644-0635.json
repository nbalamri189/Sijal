{"poems":[[53,"إياك أن تسخو بوعد","https://www.aldiwan.net/poem30704.html","مجزوء الكامل"],[63,"أما وحبيك هذا منتهى حلفي","https://www.aldiwan.net/poem46124.html","البسيط"],[55,"يا من شقيت بحبه","https://www.aldiwan.net/poem26464.html","مجزوء الكامل"],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[77,"لما رضيت بفرقتي وبعادي","https://www.aldiwan.net/poem36580.html","الكامل"],[83,"الأمير بدر المواكب","https://www.aldiwan.net/poem54192.html","مجزوء الرمل"],[88,"جاء المصيف فجفت الأنداء","https://www.aldiwan.net/poem44412.html","الكامل"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[92,"عذبة أنت كالطفولة كالأح","https://www.aldiwan.net/poem38954.html","الخفيف"],[85,"إن تسألي عن مصر حواء القرى","https://www.aldiwan.net/poem8089.html","الكامل"],[61,"هي الصوارم والخطية الذبل","https://www.aldiwan.net/poem51493.html","البسيط"],[58,"قدم لنفسك في الحياة تزودا","https://www.aldiwan.net/poem30966.html","الكامل"],[66,"عزمت يا متلفي على السفر","https://www.aldiwan.net/poem39640.html","المنسرح"],[80,"الصبح شر بغيض","https://www.aldiwan.net/poem31540.html","المجتث"],[44,"الحق أبلج والسيوف عوار","https://www.aldiwan.net/poem30507.html","الكامل"],[87,"خلعت في حب غزلان الحمى رسني","https://www.aldiwan.net/poem8236.html","البسيط"],[74,"الليل إلا حيث كنت طويل","https://www.aldiwan.net/poem13223.html","الكامل"],[67,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[48,"وقائل هل تريد الحج قلت له","https://www.aldiwan.net/poem63256.html","البسيط"],[50,"قل للتي هجرت حولين عاشقها","https://www.aldiwan.net/poem63872.html","البسيط"],[46,"قد أصبحت ونعاتها نعاتها","https://www.aldiwan.net/poem22158.html","الكامل"],[46,"حاجي نظيم جمان والحياة معي","https://www.aldiwan.net/poem22537.html","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42734","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42495","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55074","الخفيف"],[156,"قم يا غلام إلى المدام","https://www.aldiwan.net/poem55557.html","مجزوء الكامل"],[161,"ما عن سرب الضبيات العفر","https://www.aldiwan.net/poem58722.html","الرجز"],[161,"رقص جياد الظبا في حلبة اللعب","https://www.aldiwan.net/poem59045.html","البسيط"],[161,"انجزت في الأعداء ميعاد المنى","https://www.aldiwan.net/poem59087.html","الكامل"],[187,"لا تنزعج لنوائب الدهر","https://www.aldiwan.net/poem43852.html","الكامل"],[224,"حاذر الحب إن في الحب شرا","https://www.aldiwan.net/poem41905.html","الخفيف"],[230,"كل حي إلى الفناء يصير","https://www.aldiwan.net/poem51107.html","الخفيف"],[236,"طرقت ودون طروقها","https://www.aldiwan.net/poem32143.html","مجزوء الكامل"],[238,"يا بدورا لست عنها بصاح","https://www.aldiwan.net/poem18118.html","المديد"],[238,"عرج على قبر","https://www.aldiwan.net/poem19791.html","مجزوء البسيط"],[242,"ضحكات الشيب في الشعر","https://www.aldiwan.net/poem45748.html","المديد"],[253,"دعني ولا تلحني في دمعي الهتن","https://www.aldiwan.net/poem1423.html",""],[260,"الشدة عنوان الفرج","https://www.aldiwan.net/poem35545.html","المتدارك"],[260,"قم نحو حماه وانصرف","https://www.aldiwan.net/poem35942.html","المتدارك"],[298,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[306,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[306,"يا منعما قبل السؤال على الورى","https://www.aldiwan.net/poem56533.html","الكامل"],[321,"عتبت والعتب أرجى في الوداد على","https://www.aldiwan.net/poem61651.html","البسيط"],[321,"بقبول صومك قد تبسم عيده","https://www.aldiwan.net/poem67216.html","الكامل"],[339,"لا بر أعظم من مساعدة","https://www.aldiwan.net/poem68801.html","الكامل"],[378,"يا أيها الأب المكرم التقي","https://www.aldiwan.net/poem59158.html","الرجز"],[378,"أولى مسيري ذا الأمان","https://www.aldiwan.net/poem59233.html","مجزوء الكامل"],[378,"حليف بلوى شكا جورا فقلت له","https://www.aldiwan.net/poem66900.html","البسيط"],[378,"أسلاف سلامكم أم خطاب","https://www.aldiwan.net/poem66943.html","الخفيف"],[381,"لا واِختلاس النظر","https://www.aldiwan.net/poem49232.html","مجزوء الرجز"],[401,"خالي العزيز","https://www.aldiwan.net/poem6746.html","عموديه"],[403,"أو أنه كان يرضي الموت فيك فدى","https://www.aldiwan.net/poem46439.html","البسيط"],[404,"جرى القضا بشمول الموت للبشر","https://www.aldiwan.net/poem33928.html","البسيط"],[438,"إن كان أضمر قلبي عنك سلوانا","https://www.aldiwan.net/poem2597.html","البسيط"],[462,"أسر بالبرق لا حرصا على الديم","https://www.aldiwan.net/poem16089.html","البسيط"],[465,"قف أن وقفت فذاك وادي المنحى","https://www.aldiwan.net/poem3179.html","عموديه"],[465,"أصمت فؤادي مقلتاه باسهم","https://www.aldiwan.net/poem3482.html","عموديه"],[465,"كم من يد بيضاء في رمك","https://www.aldiwan.net/poem3560.html","عموديه"],[496,"مولاي إن عدت ولم ترضى لي","https://www.aldiwan.net/poem9774.html","السريع"],[496,"يا نفس صبرا وإلا فاهلكي جزعا","https://www.aldiwan.net/poem10236.html","البسيط"],[530,"لله في خلقه ما شاء من نظر","https://www.aldiwan.net/poem37425.html","البسيط"],[552,"لو كنت في مثل حالي لم ترد عذلي","https://www.aldiwan.net/poem47288.html","البسيط"],[559,"من يعرف الله فليس يسأل","https://www.aldiwan.net/poem34250.html","الرجز"],[576,"لأسرفت يا حماه في شدة الوقد","https://www.aldiwan.net/poem2968.html","الطويل"]],"verses":[["فَالصِدقُ يَحسُنُ بِالفَتى","وَالكِذبُ يُحسَبُ مِن عُيوبِه",0,"ب",2,0],["فآلُ صَفوانَ إنْ تُذْكَرْ مَناقِبُهُمْ","يَلْوِ الحَسودُ إليها جِيدَ مُعْتَرِفِ",1,"ف",1,0],["فَالصَدرُ مُضطَرِمُ الحَشا","وَالعَينُ مُسبَلَةُ السَحابِ",2,"ب",1,0],["فَالصَّرْحُ مِنْهُ مُمَرَّدٌ وَالصَّفْحُ من","هُ مُوَرَّدٌ وَالشَّطَّ مِنْهُ مُهَدَّلُ",3,"ل",1,0],["فالصّبْرُ منّي أجْنَبيُّ بعْدَها","ولَواعِجُ الأشْجانِ منْ أوْلادي",4,"د",2,0],["فالصبا مع الجنائب","كامتلت منها الحقائب",5,"ب",1,0],["فالصيف أرأف بالفقير من الشتا","ولذا تحبّ قدومه الفقراء",6,"ا",2,0],["فالصديق المأمون للزمن الفا","دح والمرتجى لدى البُرَحاءِ",7,"ا",2,0],["فالصَّباحُ الجميلُ يُنْعِشُ بالدِّفءِ","حياةَ المُحَطَّمِ المكدودِ",8,"د",1,0],["فَالصُبحُ في مَنفٍ وَثيبَة واضِحٌ","مَن ذا يُلاقي الصُبحَ بِالإِنكارِ",9,"ر",1,0],["فالصَّافناتُ حَشاياه وإن قَلِقَت","والسَّابغاتُ وإن أوهَت له حُللُ",10,"ل",1,0],["فَالصَمتُ يُحسِنُ كُلَّ ظَنٍ بِالفَتى","وَلَعَلَّهُ خَرقٌ سَفيهٌ أَرقَعُ",11,"ع",1,0],["فَالصَبرُ كَالصَبرِ في مَرارَتِهِ","لَكِنَّ فيهِ عَواقِبَ الظَفَرِ",12,"ر",1,0],["فالصبح أبْعَدَ مني","قُرْبَ الغزال الربيب",13,"ب",1,0],["فَالصينُ مَنظومٌ بِأَندَلُسٍ إِلى","حيطانِ رومِيَّةٍ فَمُلكِ ذَمارِ",14,"ر",1,0],["فَالصَّفْحُ عَنْ بَعْضِ مَا يُمْنَى الْكَرِيمُ بِهِ","فَضْلٌ يَطِيرُ بِهِ شُكْرٌ بِلا ثَمَنِ",15,"ن",1,0],["فَالصُبحُ ثَغرٌ في جَنابِكَ ضاحِكٌ","وَاللَيلُ طَرفٌ في ذَراكَ كَحيلُ",16,"ل",1,0],["فالصَّبْرُ مِنْ يَدِ مَنْ أَحْبَبْتَهُ عَسَلٌ","وَالشَّهْدُ مِنْ يَدِ مَنْ أَبْغَضْتَهُ صَبرُ",17,"ر",1,0],["فالصُّفْرُ مِنْ ذَهَبٍ عِنْدِي وإنْ صفِرَتْ","يَدِي وَإنْ غَنِيَتْ سِيَّان والصُّفُرُ",17,"ر",1,0],["فالصِّدْقُ في الغارِ والصِّدِّيقُ لَمْ يَرِمِا","وَهُمْ يقولونَ ما بالغارِ مِنْ أَرِمِ",18,"م",1,0],["فَالصالِحيَّةُ فَالكَرخُ الَّتي جَمَعَت","شُذّاذَ بَغدادَ ما هُم لي بِشُذّاذِ",19,"ذ",1,0],["فَالصُرمُ غُلٌّ لَنا نَخشى عَوائِدَهُ","وَالوَصلُ فيهِ شِفاءُ السُقمِ لَو عادا",20,"د",2,0],["فَالصَوتُ هَدرُ الفَحلِ تُؤنَسُ رِكزَهُ","أُلّافُهُ فَتُجيبُ مُمتَنِعاتُها",21,"ت",3,0],["فَالصُمُّ مِن عُنصُرِ الإِفسادِ حاسِدَةٌ","لِصَحَّةِ السَمعِ خُلداً ما لَهُ بَصَرُ",22,"ر",1,0],["فَالصَّبْرُ مُنْخَذِلٌ وَالدَّمْعُ مُنْهَمِلٌ","وَالعَقْلُ مُخْتَبِلٌ وَالْقَلْبُ مُشْتَغِلُ",23,"ل",1,0],["فَالصُّبْحُ وَالظُّهْرُ وَالْعَشَايَا","وَالْوَهْنُ مِنْ لَيْلِها سَوَاءُ",24,"ا",2,0],["فَالصِّبَا مُقْعِدِي وَمَوْكِبُك ال","ذخَّارُ يَمْشِي فِي قَلْبِي الخَفَّاقِ",25,"ق",1,0],["فَالصُّبْحُ يَنْتَهِبُ الدُّجى","وَالبَدْرُ يَضْحَكُ في الظَّلامِ",26,"م",1,0],["فالصادر القانع من ساحته","مبشر للوارد المغتر",27,"ر",1,0],["فالصبح في وجهه من بشره وضح","والبرق في الجو يبدي كف مختضب",28,"ب",1,0],["فالصيد من دأب الملوك وربما","قد كان بعض الصيد منهم أهونا",29,"ن",2,0],["فالصبر أجمل في الأمور وإن شجى","ومشاغب الأيام في الحجر",30,"ر",1,0],["فَالصبياتُ قَد تكنَّ عهارى","وَأَزاهيرُ قَد تَكنَّ وتبرا",31,"ر",2,0],["فالصباح الأغرّ ليل بهيم","عند فَقْدِيك والديار قبور",32,"ر",1,0],["فَالصاحِبُ الحِزقُ الجَوا","دُ لَهُ العَطايا وَالرِغابُ",33,"ب",1,0],["فَا لصَّحِيحُ نَشْرُهُ عَاطِرٌ","ضَاعَ يَوْمَ الْخَتْمِ مِسْكًا وَفاحْ",34,"ح",1,0],["فَالصَّبْرُ مِنْ شَكْوَايْ","مُعَفَّنُ الأَخْلاَطْ",35,"ط",1,0],["فالصبا كلُّ الحياةِ فإن","مر مرت غبطةُ العُمُرِ",36,"ر",1,0],["فالصَبرُ أَجمَلُ ثَوب أَنتَ لابِسَهُ","لِنازِل وَالتَعزّي أَحسَنُ السُنَنِ",37,"ن",1,0],["فالصبّ بفضل الحبّ يقرْ","وبراح الروح القلب يقرْ",38,"ر",1,0],["فالصفح من المولى يُرجى","لكن للعبد المعترف",39,"ف",1,0],["فالصِدق في المحبَّة","يوجبُ هذي النِسبَه",40,"ه",1,0],["فَالصخرُ حيّاهُ وَالأشجارُ ساجدةٌ","وَالجذعُ حنّ ولبّت إذ دعا الرممُ",41,"م",1,0],["فَالصبرُ يُلجِمني عَنِ الشكوى رضاً","عَنكم وَحالي ليس يفتأُ مُخبِرا",42,"ر",2,0],["فَالصَبرُ حَسبي وَيَعفو اللَهَ عَنكَ أَخي","فَإِنَّ وُدّي دانٍ رَغمَ أَقصائي",43,"ي",1,0],["فَالصِدقُ وَالإِخلاصُ فيكَ كِلاهُما","بادَ بِفِعلِكَ لا تَغيبَ شُهودُهُ",44,"د",2,0],["فَالصَفحُ عَن زَلَلِ الصَديقِ وَإِن","أَعياكَ خَيرٌ مِن مُعاندَتِه",45,"ت",2,0],["فالصوم ضدُّ شهوةٍ والصدقهْ","تقاوم الفعلَ وطِعْ توما الثقهْ",46,"ه",1,0],["فالصالحون سلاحهم","والمرسلون لهم عَوان",47,"ن",1,0],["فالصبر أمنع درعٍ أنت لا بسه","كما ترداه يوسف بين إخوته",48,"ت",2,0],["فالصلاحَ الصلاحَ إن كان منا","صالحٌ فالطلاح عنه حساب",49,"ب",1,0],["فَالصَون أَيُّ صَقلٍ","وَرَونَق المُصور",50,"ر",1,0],["فالصبرُ عند الصدمة الأولى إذ","حمَّ القضاء ، يُهدِّئُ الوجدانا",51,"ن",2,0],["فالصَّبرُ عقدٌ نفيسٌ ما لَهُ ثمَنٌ","ولا يكونُ لغير السيِّد السَّنَدِ",52,"د",1,0],["فالصبر أحسن درع أنت لابسه","عند الحوادث في ورد وفي صدر",53,"ر",1,0],["فالصد منك وإن أصبحت ذا صدد","جمر الفضى بفنا الأوطان أوطانا",54,"ن",2,0],["فالصُّمُّ من شدَّة الإيجافِ هايلةٌ","والشمس من مُسْتثار النَّقع في سقم",55,"م",1,0],["فالصبحُ فينا ما خبا حتى بدا","والغُمض عنا ما نأى حتى دنا",56,"ن",2,0],["فالصارم الهندي يجهل حدّه","وإلا ثر إلاَّ في يمين مصمّمِ",57,"م",1,0],["فالصحف الملقاة من صنعها","كنماشرٍ من ظلماتِ الصفيح",58,"ح",1,0],["فالصفو بعد الكدر المعتري","كالصحوِ بعد المطرِ الصيّب",59,"ب",1,0],["فالصبر أجمل إلا أن يكون أسى","يرده فإذَنْ لا تأتلي جزعا",60,"ع",2,0],["فالصَّبْرُ أَشْرَفُ ما لاَذَ الْمُصَابُ بِهِ","إن ناوَشَتْهُ يَدُ الأيّامِ بالضَّرَرِ",61,"ر",1,0],["فالصّلحُ ممّن درى الضُرَّ المحيطَ به","ولا دفاعَ له صلحٌ على دَخَلِ",62,"ل",1,0],["فالصادق الذي إليه يصل","بالصدق في التوحيد ذوقاً يكمل",63,"ل",1,0],["فأَلْصِقْ بها ذاك المقبَّلَ ساعةً","فما الطبُّ إِلا دفعُكَ الضِدَّ بالضدِّ",64,"د",1,0]]}