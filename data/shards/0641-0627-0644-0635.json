px?id=179285",""],[6102,"غُربَةُ الزَّمَكان!","https://www.poetsgate.com/ViewPoem.aspx?id=186283",""],[6134,"ماذا حملتم على الايدي بلا حذر","https://www.poetsgate.com/ViewPoem.aspx?id=169551",""],[2220,"لما شهدت الذي سوى حقيقتهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11448&r=&rc=322",""],[6308,"إني أحبكَ أكثر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87729&r=&rc=7",""],[572,"عالية ُ الأجزاءِ قَدْ بُرِّئَتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9245&r=&rc=102",""]],"verses":[["فَالصِدقُ يَحسُنُ بِالفَتى","وَالكِذبُ يُحسَبُ مِن عُيوبِه",0,"ب",2,0],["فآلُ صَفوانَ إنْ تُذْكَرْ مَناقِبُهُمْ","يَلْوِ الحَسودُ إليها جِيدَ مُعْتَرِفِ",1,"ف",1,0],["فَالصَدرُ مُضطَرِمُ الحَشا","وَالعَينُ مُسبَلَةُ السَحابِ",2,"ب",1,0],["فَالصَّرْحُ مِنْهُ مُمَرَّدٌ وَالصَّفْحُ من","هُ مُوَرَّدٌ وَالشَّطَّ مِنْهُ مُهَدَّلُ",3,"ل",1,0],["فالصّبْرُ منّي أجْنَبيُّ بعْدَها","ولَواعِجُ الأشْجانِ منْ أوْلادي",4,"د",2,0],["فالصبا مع الجنائب","كامتلت منها الحقائب",5,"ب",1,0],["فالصيف أرأف بالفقير من الشتا","ولذا تحبّ قدومه الفقراء",6,"ا",2,0],["فالصديق المأمون للزمن الفا","دح والمرتجى لدى البُرَحاءِ",7,"ا",2,0],["فالصَّباحُ الجميلُ يُنْعِشُ بالدِّفءِ","حياةَ المُحَطَّمِ المكدودِ",8,"د",1,0],["فَالصُبحُ في مَنفٍ وَثيبَة واضِحٌ","مَن ذا يُلاقي الصُبحَ بِالإِنكارِ",9,"ر",1,0],["فالصَّافناتُ حَشاياه وإن قَلِقَت","والسَّابغاتُ وإن أوهَت له حُللُ",10,"ل",1,0],["فَالصَمتُ يُحسِنُ كُلَّ ظَنٍ بِالفَتى","وَلَعَلَّهُ خَرقٌ سَفيهٌ أَرقَعُ",11,"ع",1,0],["فَالصَبرُ كَالصَبرِ في مَرارَتِهِ","لَكِنَّ فيهِ عَواقِبَ الظَفَرِ",12,"ر",1,0],["فالصبح أبْعَدَ مني","قُرْبَ الغزال الربيب",13,"ب",1,0],["فَالصينُ مَنظومٌ بِأَندَلُسٍ إِلى","حيطانِ رومِيَّةٍ فَمُلكِ ذَمارِ",14,"ر",1,0],["فَالصَّفْحُ عَنْ بَعْضِ مَا يُمْنَى الْكَرِيمُ بِهِ","فَضْلٌ يَطِيرُ بِهِ شُكْرٌ بِلا ثَمَنِ",15,"ن",1,0],["فَالصُبحُ ثَغرٌ في جَنابِكَ ضاحِكٌ","وَاللَيلُ طَرفٌ في ذَراكَ كَحيلُ",16,"ل",1,0],["فالصَّبْرُ مِنْ يَدِ مَنْ أَحْبَبْتَهُ عَسَلٌ","وَالشَّهْدُ مِنْ يَدِ مَنْ أَبْغَضْتَهُ صَبرُ",17,"ر",1,0],["فالصُّ