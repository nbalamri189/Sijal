{"poems":[[55,"تألق نجدي كأن وميضه","https://www.aldiwan.net/poem29799.html","الطويل"],[9,"فدى لبني ذهل ابن شيبان ناقتي","https://www.aldiwan.net/poem21917.html","الطويل"],[24,"أتعرف رسما بين رهمان فالرقم","https://www.aldiwan.net/poem21880.html","الطويل"],[29,"لمن رسم دار هم أن يتغيرا","https://www.aldiwan.net/poem5761.html","الطويل"],[30,"تقاصرت الجبال له وطمت","https://www.aldiwan.net/poem4951.html","الوافر"],[2,"صحا القلب عن سلمى وقد كاد لا يسلو","https://www.aldiwan.net/poem25064.html","الطويل"],[48,"تكرم أوصال الفتى بعد موته","https://www.aldiwan.net/poem21991.html","الطويل"],[48,"لقد فقد الخير بين الأنا","https://www.aldiwan.net/poem23555.html","المتقارب"],[111,"تهد العمر رائعة المنون","https://www.poetsgate.com/ViewPoem.aspx?id=523",""],[111,"تهد العمر رائعة المنون","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545636",""],[24,"أتَعرِفُ رَسْماً بين رَهْمَانَ فالرَّقَمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10882&r=&rc=23",""],[147,"ما كان قبلك في الزمان الخالي","https://www.aldiwan.net/poem11802.html","الكامل"],[254,"تغيرت المنازل بالكثيب","https://www.aldiwan.net/poem2130.html","الوافر"],[347,"الضحايا معناهم الشهداء","https://www.aldiwan.net/poem55366.html","الخفيف"],[556,"دعى منظري إن لم أكن لك رائعا","https://www.aldiwan.net/poem47780.html","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49601","الكامل"],[2382,"","https://poetry.dctabudhabi.ae/diwan/poem/101809","المتقارب"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60841","البسيط"],[2612,"","https://poetry.dctabudhabi.ae/diwan/poem/31522","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204476","المنسرح"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101625","الكامل"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107052","الطويل"],[3458,"","https://poetry.dctabudhabi.ae/diwan/poem/198356","الوافر"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101216","الوافر"],[4080,"","https://poetry.dctabudhabi.ae/diwan/poem/80168","الوافر"],[5431,"بيد أني أحبهم مثل أهلي","https://www.poetsgate.com/ViewPoem.aspx?id=197224",""],[5956,"المضحوك عليهم.!","https://www.poetsgate.com/ViewPoem.aspx?id=192182",""]],"verses":[["هُمُ ضَمِنوا اللَأواءَ وَالأَزلُ راكِدٌ","عَلى مُقعِدٍ مِن عُسرِهِم وَمُقيمِ",0,"م",1,0],["هُمُ ضَرَبوا بِالحِنوِ حِنوِ قُراقِرٍ","مُقَدِّمَةَ الهامَرزِ حَتّى تَوَلَّتِ",1,"ت",1,0],["هُمُ ضَربوكُم حينَ جُرتُم عَنِ الهُدى","بِأَسيافِهمِ حَتّى اِستَقَمتُم عَلى القِيَم",2,"م",1,0],["هُمُ ضَرَبوا هامَ المُلوكِ وَعَجَّلوا","بِوِردٍ غَداةَ الحَوفَزانِ فَبَكَّرا",3,"ر",2,0],["هُمُ ضَرَبوا الصَنائِعَ وَاِستَباحوا","بِمَذحِجَ يَومَ ذي كَلَعٍ ضِرابا",4,"ب",2,0],["هُمُ ضَرَبوا عَن فَرجِها بِكَتيبَةٍ","كَبَيضاءِ حَرسٍ في طَوائِفِها الرَجلُ",5,"ل",1,0],["هُمُ ضارَبوا أَولادَ فِهرٍ وَجالَدوا","عَلى الدينِ إِذا وَشّى المُلوكَ عَباءُ",6,"ب",3,0],["هُمُ ضَرَبوا حَيدَراً ساجِداً","وَحَسبُكَ مِن عُمَرٍ إِذا طُعِن",7,"ن",1,0],["هم ضمنوا بكشف الكرب عنا","فقد اخنت شعوب على الضمين",8,"ن",1,0],["هم ضمنوا بكشف الكرب عنا","فقد أخت شعوب على الضمين",9,"ن",1,0],["همُ ضربوكم حينَ جُرْتُمْ عن الهُدَى","بأسيافهم حتى استقتم على القيمْ",10,"م",1,0],["هُم ضَيَّعوها ثُمَّ راموا حِفظَها","مِن أَعظُمٍ تَحتَ التُرابِ بَوالِ",11,"ل",1,0],["هُمُ ضَرَبوا قَوانِسَ خَيلِ حُجرٍ","بِجَنبِ الرَدهِ في يَومٍ عَصيبِ",12,"ب",1,0],["هم ضحايا اوطانهم واسود","لفظتهم من جوفها صحراء",13,"ا",2,0],["هُمُ ضربوا لِلطارِقينَ خِيامَهمْ","وهمْ رفعوا النّيرانَ للمُتَنوِّرِ",14,"ر",1,0],["هُمْ ضَمَّنوكَ عَناءَ كلِّ سيادةٍ","واسْتنجحوكَ لِسَعْدِ كلِّ قران",15,"ن",1,0],["هم ضربوا انبوا خضبوا","ابوا نقضوا نكثوا بيعتك",16,"ك",1,0],["هُمْ ضيّعوا ذِمَماً بيني وبينَهُمُ","وأيّ صامتِ خلخالٍ له ذِممُ",17,"م",1,0],["هُمُ ضَرَروا سَعدَ بنَ لَيثٍ وَجُندُعاً","وَكَلباً غَداةَ الجِزعِ ضَرباً مُذَكَّرا",18,"ر",2,0],["هم ضعافٌ همْ أقوياء معاً","منهم عليهم ترى الشكايات",19,"ت",1,0],["هم ضيعوا إرث الجدود فنالهم","غضب الجود ولعنة الحفاد",20,"د",1,0],["هم ضربوا فوق الضراح قبابهم","وهم تخذوا هام المجرة مركبا",21,"ب",2,0],["هم ضربوا الكتائب يوم كسرى","أمام الناس إذ كرهوا الجلادا",22,"د",2,0],["هم ضربوا صماخ الكفر حتى","بنوا دين الهدى أعلى بناء",23,"ا",2,0],["همُ ضربوهُمُ حتى تولَّوْا","وخَلَّوا كل بَهْنكةٍ كَعابِ",24,"ب",1,0],["هم ضحايا وقهرهم في ضلوعي","يوجع الروح بؤسه المستديم",25,"م",1,0],["همُ ضد الأهلِ خاضوا حملةً","تلو أخرى يهدمون الهُضُبا",26,"ب",2,0]]}