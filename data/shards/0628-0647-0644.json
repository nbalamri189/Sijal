{"poems":[[74,"ليهنك يا عين الزمان وأهله","https://www.aldiwan.net/poem18375.html","الطويل"],[68,"رأى فرسي إسطبل موسى فقال لي","https://www.aldiwan.net/poem38782.html","الطويل"],[113,"فتى راعه الدهر الخؤون ببأسه","https://www.aldiwan.net/poem16385.html","الطويل"],[119,"خفايا المعاني تنجلي بالدلائل","https://www.aldiwan.net/poem40849.html","عموديه"],[119,"لشأن الدين في الإسلام معنى","https://www.aldiwan.net/poem41715.html","البسيط"],[137,"لك النصر حزب والمقادير أعوان","https://www.aldiwan.net/poem4207.html","الطويل"],[242,"ألا قل لمن يبغي إلى العز منفذا","https://www.aldiwan.net/poem18189.html","الطويل"],[285,"عشت للمجد أطول الأعمار","https://www.aldiwan.net/poem60579.html","الخفيف"],[369,"في الجيرة الغادين بدر","https://www.aldiwan.net/poem60895.html","مجزوء الكامل"],[371,"الحسن جاد على الأحباب فازدادوا","https://www.aldiwan.net/poem17180.html","البسيط"],[371,"كتاب به ماء الحياة ونقعة ال","https://www.aldiwan.net/poem17922.html","الطويل"],[445,"طلعت نجوم السعد من آفاقها","https://www.aldiwan.net/poem34800.html","الكامل"],[469,"أشاقك برق بالشآم يشام","https://www.aldiwan.net/poem3487.html","عموديه"],[529,"وماذا عسى أحصيه من اختصاصه","https://www.aldiwan.net/poem13290.html","الطويل"],[572,"عادات طيفك أن يعاود","https://www.aldiwan.net/poem69711.html","مجزوء الكامل"],[572,"أمسك ديف بالقهوة","https://www.aldiwan.net/poem69769.html","الهزج"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101495","الكامل"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62672","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84506","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64417","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79994","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101018","الطويل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123178","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53141","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109471","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109400","السريع"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109413","السريع"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109530","البسيط"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28062","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75906","الطويل"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113872","الطويل"],[2922,"","https://poetry.dctabudhabi.ae/diwan/poem/105354","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134021","المتقارب"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87637","الطويل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97990","السريع"],[3357,"","https://poetry.dctabudhabi.ae/diwan/poem/105648","المتقارب"],[3524,"","https://poetry.dctabudhabi.ae/diwan/poem/124598","الطويل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118777","الرجز"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123524","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91023","الطويل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35451","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72423","الوافر"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136386",""],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136445",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139627",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139477",""],[4927,"رسالة حب","https://www.poetsgate.com/ViewPoem.aspx?id=29840",""],[5385,"قوس المنون بسهم البين قدر رشقا","https://www.poetsgate.com/ViewPoem.aspx?id=144222",""],[5431,"على لسان نازح سوري...","https://www.poetsgate.com/ViewPoem.aspx?id=209152",""],[482,"حرامٌ على الجفنِ القريحِ منامُه","https://www.poetsgate.com/ViewPoem.aspx?id=111412",""],[5690,"غريبٌ فقده أبكى","https://www.poetsgate.com/ViewPoem.aspx?id=172278",""],[5894,"بدت مبرقعة في حسنها العربي","https://www.poetsgate.com/ViewPoem.aspx?id=131411",""],[5909,"يا صامتاً عَشِق السكون","https://www.poetsgate.com/ViewPoem.aspx?id=210229",""],[192,"نبض الشوارع","https://www.poetsgate.com/ViewPoem.aspx?id=16352",""],[6134,"مزيننا إذا ما مد كفاه","https://www.poetsgate.com/ViewPoem.aspx?id=169584",""]],"verses":[["به للبرايا حاجبٌ من هلاله","ولحتَ فيا لله عينٌ وحاجب",0,"ب",1,0],["بِهِ لَم أَذُق طَعمَ الشَعيرِ كَأَنَّني","بِسِقطِ اللِوى بَينَ الدُخولِ فَحَومَلِ",1,"ل",1,0],["بِهِ لَعِبَت أَيدي الفراق فَحاضِراً","تَراهُ وَلَكن غائِباً عَن حَواسِهِ",2,"س",2,0],["به لهجت آساد كل فصيلة","فما ضره نج الكلاب القلائل",3,"ل",1,0],["به لغريبنا المعروف فرض","وأولى فيه من ذاك القريب",4,"ب",1,0],["به لا بظبيٍ بالصريمةِ أعفرٍ","فقد طاحَ منهُ مارِدُ الإنسِ شيطانُ",5,"ن",1,0],["بِهِ لاَ بِظَبْيٍ قَوْلُهُمْ لَكَ عِنْدَمَا","يَهُمُّكَ مِنْهُمْ مَا يُهِمُّكَ مِنْ أَذَى",6,"ذ",2,0],["بِهِلالٍ كَأَنَّما غُرَّةُ الشَّهْ","رِ بِرُؤْياهُ لَيْلَةُ الإِبْدارِ",7,"ر",1,0],["بهلالِ وَجْهٍ مُجْتَلا","هُ لصائمِ الآمالِ فِطر",8,"ر",1,0],["بِهِ لِنارِ العِدا في الحَربِ أَربَعَةٌ","رَفعٌ وَخَفضٌ وَإِطفاءٌ وَإِيقادُ",9,"د",1,0],["بِهِ لَهُما سَبحٌ طَويلٌ فَهَذِهِ","عَلى خاطِرٍ بَردٌ وَفي خَطَرٍ بَدرُ",10,"ر",1,0],["بهلالِ أَقمارِ الهُدى من يَعْرُبٍ","فَمُنى مَساعِي شأْوِها بِلَحَاقِها",11,"ق",3,0],["به للأعادي والنُّضار تشتُّت","وللوفد والمجد الأثيل نظامُ",12,"م",1,0],["بِهِ لذت في أَمري وَفُزت بِما أَشا","وَمِن فَيضِهِ قَد عَمَّني الجَبر والسَّعدُ",13,"د",1,0],["بهلالِ ما سَتَرَ النِّقا","بُ غزالِ ما حَوَتِ القَلاَئِدْ",14,"د",1,0],["به للجِنَّ عزّافٌ","يُوالي فِيْهِ تَصْنِيجَهْ",15,"ج",2,0],["به لهم إنهم أئمة","كلهم دون جميع الأمة",16,"ه",1,0],["بهِ لظى الخدّ يَزهُو","كجنَّةٍ وهوَ مطهَر",17,"ر",1,0],["بهِ لَقينا البَعض مِن أَهلِ اليَمن","مُستَخدمينَ لِضَرورَة الزَّمَن",18,"ن",1,0],["به ليلنا في بهجة ومتى انقضى","فلا تسألَنْ عن ليلنا فهو مظلمُ",19,"م",1,0],["به لآدم هب العفو وانتسبت","لشيته في سما العليا الأراجيل",20,"ل",1,0],["به لمكة إذ كانت مشيدة","ديما مجددة في الأشهر الحرم",21,"م",1,0],["به لذَّ لي ذلي وعزي تهجما","أراني خليل اللّه وشك ذهابه",22,"ه",1,0],["بهِ لبسَ الزمانُ قشيبَ بردٍ","فجوذبَ ذلك البرد القشيبا",23,"ب",2,0],["به لقحت سود الليالي فليته","قضى في بطون الغيب لم يتخلق",24,"ق",1,0],["به لبن قد بيّض اللَه وجهه","لأسود طرفي إن تفرّع شاغل",25,"ل",1,0],["به لواعج شوق لو تحملها","رَضْوَى لهدته أو كادت تُضَعْضِعُه",26,"ع",2,0],["به لابيه أحمد الذات واجبٌ","علينا أداءُ الشكر في كل محفل",27,"ل",1,0],["به ليالي الأنس وافت وقد","قامت به الأفراحُ حق القيام",28,"م",1,0],["به لأبناء النقيب الهنا","يسمو بعزٍّ ما له من زوال",29,"ل",1,0],["به لطيفة بنت السائس احتجبت","وذو الجلال بهذا الحجب قد حكما",30,"م",2,0],["بِهِ لا بِها أَرمى الفَلاةَ عَن الهَوى","وَأَفرُجُ غَمَّ المُسدِفِ المُتلاحِمِ",31,"م",1,0],["بِهِ لَمَمٌ قَد مَسَّهُ وَتَخَبُّطٌ","فَلا بالرُقى يُهدى وَلا بِالتَعوُّذِ",32,"ذ",1,0],["به لاحت الأنوار من كل جانب","لأنجال إبراهيم من حيث اقبلوا",33,"ل",3,0],["به لحق النسر المحلق رفعة","ولم نتخذ إلا السيوف قوادما",34,"م",2,0],["به للحواس اجتماع على","مسراتها راق في كل آن",35,"ن",1,0],["بِهِ للعلى والجاه ارَّختُ عابقٌ","شَذى أَرَجٍ بادٍ من الوردِ والمسكِ",36,"ك",1,0],["بهلاً ترشفت دواء الجوى","منها فليس الطب إلا بها",37,"ب",3,0],["به لبس الدهر برد السرور","وعنا به الهم ولى وسارا",38,"ر",2,0],["به لم يجد للطّعن وجها بليغُها","ولم يجد شيئا بالطعان حسودها",39,"د",3,0],["به لكلّ ثم بعض واشتمال","وغلط وانت تعرف المثال",40,"ل",1,0],["به لذت أشكو فتية طغت","علىّ فأعيا النفس عبء عناها",41,"ا",3,0],["به لهما حق الهناء وكيف لا","ومظهره اسنى من الشمس في الظهر",42,"ر",1,0],["بِهِ لَعب الهَوى شَيئاً فَشَيئا","فَلَم يَشعُر وَقَد خَلَعَ العذارا",43,"ر",2,0],["به لمقصر أي التزام","وهم لعديم حام مستضام",44,"م",1,0],["به لك جند النصر والفلك التي","تشابهها في مسج الفلك الزهر",45,"ر",1,0],["به لاحت زليخا في المعاني","بمغنى الحسن للعشاق شاقا",46,"ق",2,0],["به لاذ هذا الدهر خوفاً ومَن يلذ","بمولاه قد هانت عليه شدائده",47,"د",2,0],["به للعالم النوري عكسٌ","كعكس العالم الأعلى بماء",48,"ا",2,0],["بِهِ لِلْعِشْقِº وَالْعُشَّاْقِ دِرْعٌ","إِذَاْ غَدَرَ الْمُغَفَّلُº وَالْبَلِيْدُ",49,"د",1,0],["به لقد فجعتنا الحادثات فما","امر يوما به كف النوى صفقا",50,"ق",2,0],["به لحن الوئام بكل واد","وهسهسة السلام مع الشروق",51,"ق",1,0],["به لاعجٌ مِن شدَّةِ الوجدِ مُقلِقُ","يزيدُ على بعدِ المزارِ ضِرامُهُ",52,"م",2,0],["بهِ للأصفر المضنى","أبيهِ لوعة القلبِ",53,"ب",1,0],["به لقد أضحت الأيام باسمة","إذ قد أباح إلي الأيتام بالنشب",54,"ب",1,0],["به لعجةٌ وعليه من ألم الجوى","لو صام كل الدهرِ كان لزاما",55,"م",2,0],["به ليال ٍ ما تبالي لو تجينا بالفواجع","الحزن فيها مثالي واصل ٍ ماهو قطوع",56,"ع",1,0],["به ليل العذار يعود صبحاً","فإن سميته شمساً فأسنى",57,"ن",2,0]]}