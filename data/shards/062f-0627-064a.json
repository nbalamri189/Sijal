المحب إذا مضى -11-","https://www.poetsgate.com/ViewPoem.aspx?id=175875",""],[6093,"دَايَنْتُ أصحابَ القصيدِ قصيدي(الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=181498",""]],"verses":[["دايَنوا المَجدَ بِأَطرافِ القَنا","فَغَدا عَيناً وَقَد كانَ ضِمارا",0,"ر",2,0],["دائب شاد مجده خالد الآ","ثار من بكرة القرون الخوالي",1,"ل",2,0],["دَائِبٌ لَمْ تَزِدْهُ إِلاَّ ثَبَاتاً","غَمَرَاتٌ رَمَتْهُ بِالأهْوَالِ",2,"ل",1,0],["دائِبٌ مَورُها وَيَصرِفُها الغَو","رُ كَما تَعطِفُ الهِجانُ الظُؤارُ",3,"ر",1,0],["دائباً يكنز القناطير للوا","رِث والعُمرُ دائباً لانقضاءِ",4,"ا",2,0],["دائم العهد لا يُنَقِّلُك الغد","ر إذا خيل بعضهم زاووقا",5,"ق",2,0],["دائباً تُصْلِيَها طو","راً وتُغزيها السّرايا",6,"ا",3,0],["داير على كل الأبواب","ساعي يحسس بجريدة",7,"ه",1,0],["دائِرُ الدولابِ بِالناسِ عَلى","جانِبَيهِ المُرتَقى وَالمُنحَدَر",8,"ر",1,0],["دائِمُ الاِنفِرادِ بِالرَأيِ في الخَل","وَةِ لا يَتَّقي اللَيالي بِواقِ",9,"ق",1,0],["دائرٍ لا يَخافُ دائرةَ السُّو","ء إذا اغتالَه العَدوُّ اغتِيالا",10,"ل",2,0],["دائِباً لَيلَتي أَكُفُّ بِكَفّي","كَبِداً حَزُّها كَحَزِّ المَواسي",11,"س",2,0],["دَائِبٌ فِي ابْتِغَاءِ مَا يَبْتَغِيهِ","سَاهِرُ اللَّيْلِ وَالِّلذَاتُ نِيَامُ",12,"م",1,0],["دَائِمُ الرَّجْعِ كُلَّمَا أَرْضَوْهُ","طَيَّبَ الدَّهْرُ ذِكْرَ عَبْدِ الْحَمِيدِ",13,"د",1,0],["دائراتُ المعارفِ اجتمعت في","ه ففتِّش عنهن في صَفحَاتِه",14,"ت",2,0],["دائم صوب جذلان","ما المنعمان سيَّان",15,"ن",1,0],["دائرٌ بين لجَّةٍ وبخارٍ","كنجوم السماءِ في الدَّوران",16,"ن",1,0],["دائمات آياته والتجلي","منطو في آياته الدائمات",17,"ت",1,0],["دائم الصمت مفرد الرأي والفكر","ة لا أنفي الهموم بحد",18,"د",1,0],["دائمُ النورِ مُستمرّ العطاءِ","هوَ مِسكٌ لسائر الأنبياءِ",19,"ا",2,0],["دائِباً لاهِياً تُخَوِّنُ حِلمي","بِثَنايا غُرٍّ وَوَجهٍ وَسيمِ",20,"م",1,0],["دائرةٌ في فَلكٍ","من خصرها والكفلِ",21,"ل",1,0],["دائِماً أَلفاكَ تَذري العبرات","كاسِرَ الطَرفين",22,"ن",1,0],["دائِرةٌ أحدقتْ بعُزتها","أهِلةٌ لا تُجِنّها السُّحُب",23,"ب",1,0],["دائِمُ الحُزنِ فَريدٌ","في أَعالي حَفِتيانِ",24,"ن",1,0],["دائم النوح والشجى","كاد يقضي من الضنى",25,"ن",2,0],["دائِماً جَائياً سُدًى","وَكَذا عَادَةُ الخُصى",26,"ص",2,0],["دائِمَةٍ آخِرُها لا يُبلَغُ","كَأَنَّما عُمرُكَ طَوقٌ مُفَرَغُ",27,"غ",1,0],["دائِماً يَنهضُ الفَتى وهوَ كالس","سَيفِ فَيشفي صَدراً ويُبردُ غُلَّه",28,"ل",2,0],["دائما والثنا الجميل حمد عبد مقر بالنقص","في الشكر عن فتيل",29,"ل",1,0],["دائمان على الذي","كل خير لنا فتح",30,"ح",1,0],["دائم الفخر خالد الذكر ما غير","فخارٍ لكم مدى الدهر دائم",31,"م",1,0],["دائِمَ النعمة منهلَّ الحيا","مورد الظامي بعذب سلسبيل",32,"ل",1,0],["دائبا يشتهى لها وحدةَ الم","جدِ بعلمٍ يُعُّز قبلَ السلاحِ",33,"ح",1,0],["دائِمُ السَّحِّ له في الح","َيِّ مُكْثٌ ومُقام",34,"م",1,0],["دائماً ما طلعتْ شمسُ الضُّحى","وسَما في الأفْقِ نجْمٌ وغَرَبْ",35,"ب",1,0],["دائمٌ سقيه ومع ذاك يمهى","غير شكٍّ قدّاً ويقصر شكلا",36,"ل",2,0],["دائمُ سقيهُ ومع ذاك يقما","غير شكٍّ قدّاً ويقصر شكلا",37,"ل",2,0],["دائم جوده كجود صلاحٍ لك","في الخلق مستهلٍّ ركامُ",38,"م",1,0],["دائمة الإحسان ينتابني","من راحتيها رائح باكر",39,"ر",1,0],["دائر لا زال في هممٍ","لكلام الناس يلتقط",40,"ط",1,0],["دائِرَةُ الحِكمةِ أقلامُهُ","أعمِدةُ الحقِّ على المَنْكبِ",41,"ب",1,0],["دَائِمَةُ الإِعْرَاضِ عَنِّي فَمَا","يَخْطِرُ لِي ذِكْرٌ عَلَى بَالِهَا",42,"ل",3,0],["دائِي الحياةُ فمن يُبشِّرُني","منها بإِفراق وإِبْلاَلِ",43,"ل",1,0],["دَائرٌ بَيْنَ النَّدامَى","وَالتِثامِ الثغرِ رَسْمي",44,"ي",1,0],["دائي دوائي إن عَلِقتُ ومُتلِفي","لَعِسُ الشِّفاهِ ومُمرِضي وطبيبي",45,"ب",2,0],["دائِماً بِالأَمر يَسري","آمنا من كُل شَرِّ",46,"ر",1,0],["دائي عضال وهَ","ذا السم نعم الدواء",47,"ا",2,0],["دائم السخط على من","شارك القلب فجارْ",48,"ر",1,0],["دائي الصدود وربما","كان الوصال شفائيه",49,"ي",2,0],["دائم الصبر حَمول للأذى","قائم الشكر يجلي الكربا",50,"ب",2,0],["دائل دائم ديار دلال","دار دهما دنية دهماء",51,"ا",2,0],["دائم الدهرِ مقيم","لم تغيّرهُ الليالي",52,"ي",1,0],["دائرة في خاطري","وخاطري مندثر",53,"ر",1,0],["دائِمَة الخُصومه","لَوامة مَلومه",54,"ه",1,0],["دائِمَة البكاه","كالحية الرَّقطاء",54,"ا",2,0],["دائم الجرف لا سكينة فيه","دائم الإضطراب والخ