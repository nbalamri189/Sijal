udhabi.ae/diwan/poem/204369","الكامل"],[4727,"لعل الدّهر مدّخر ثوابا","https://www.poetsgate.com/ViewPoem.aspx?id=208810",""],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4869,"ايام","https://www.poetsgate.com/ViewPoem.aspx?id=151680",""],[4888,"جنات الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=207675",""],[4929,"رداً على منتقدي بحور الخليل ومُشَعرني النثر","https://www.poetsgate.com/ViewPoem.aspx?id=199636",""],[4961,"وصلَّى خلفكَ العملُ المثالي","https://www.poetsgate.com/ViewPoem.aspx?id=37240",""],[5055,"ثارت الفتنة","https://www.poetsgate.com/ViewPoem.aspx?id=101192",""],[5186,"أرقت وهاجتني وقد هجع الركب","https://www.poetsgate.com/ViewPoem.aspx?id=156457",""],[5191,"الحُمق","https://www.poetsgate.com/ViewPoem.aspx?id=211971",""],[5299,"مكابرةُ امرأة","https://www.poetsgate.com/ViewPoem.aspx?id=210536",""],[5324,"صوت صفير البلبل.","https://www.poetsgate.com/ViewPoem.aspx?id=210992",""],[592,"ألا بلغا عن جميلاً رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=128827",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5411,"وَحُبُّكَ موسيقى","https://www.poetsgate.com/ViewPoem.aspx?id=186139",""],[5431,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=190113",""],[5431,"ونحن الآن من شغفٍ ألوفُ ...","https://www.poetsgate.com/ViewPoem.aspx?id=199188",""],[5491,"الشعر الطويل","https://www.poetsgate.com/ViewPoem.aspx?id=215329",""],[5510,"على قيد الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=205678",""],[5756,"قدها وقدود","https://www.poetsgate.com/ViewPoem.aspx?id=5439",""],[5781,"قارئ كفّ","https://www.poetsgate.com/ViewPoem.aspx?id=208937",""],[5790,"أسرب المها لا حبذا أنت من سرب","https://www.poetsgate.com/ViewPoem.aspx?id=111944",""],[5853,"ما أعذب الموت","https://www.poetsgate.com/ViewPoem.aspx?id=188356",""],[5970,"طلبت العلا حتى استلان لي الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=130656",""],[6078,"بل أَكثر","https://www.poetsgate.com/ViewPoem.aspx?id=203412",""],[6142,"وطلاب رشدٍ فوق نجب حدت بهم","https://www.poetsgate.com/ViewPoem.aspx?id=155740",""]],"verses":[["وَمَن وَرَدَ الماءَ الَّذي كُنتُ وارِداً","بِهِ وَرَعى الرَوضَ الَّذي كُنتُ راعِيا",0,"ي",2,0],["وَمَن وَجَدَ الرِزقَ عِندَ السُيوفِ","فَلَم يَتَحَمَّل لِذُلِّ الطَلَب",1,"ب",1,0],["وَمِن واقِفٍ راكِبٍ فارِهاً","لِيَمضي عَلَيهِ فَريداً مَكينا",2,"ن",2,0],["وَمُنّوا بِالوُجودِ فَقَد جَهِلنا","بِفَضلِ وُجودِكُم مَعنى الوُجودِ",3,"د",1,0],["وَمِن وُصَلي هِجرَةٌ لا أَعُدُّ","لِحالي سِوى يَومِها مَولِدا",4,"د",2,0],["ومنوّعِ الحركات قد ركب الهوا","يمشي على خط به متوهّمِ",5,"م",1,0],["ومن وسط السور الشَماليّ تنتهي","إليها بمسدود الرتاجين مُوصَد",6,"د",1,0],["وَمُنوا بِمُلتَهِمِ العِنانِ مُناقِلٍ","عِندَ الرِهانِ مُقَرِّبٍ وَمُحاضِرِ",7,"ر",1,0],["ومن ولى بذمته رزينا","وشيعته ولم يعرف بعهدِ",8,"د",1,0],["وَمَن وَرَدَ المَهالِكَ لَم تَرُعهُ","رَزايا الدَهرِ في أَهلٍ وَمالِ",9,"ل",1,0],["ومن وزن الزمان فتى وشيخا","إذا الفتيان قبل الشيب ضلوا",10,"ل",3,0],["وَمِن واهِبٍ جَزلاً وَمِن زاجِرٍ هَلاً","وَمِن هاتِكٍ دِرعاً وَمِن ناثِرٍ قُصبا",11,"ب",2,0],["وَمِن وَردٍ بِخَدَّيهِ","إِذا جَمَّشتُهُ يَخجَل",12,"ل",1,0],["وَمُنوا بِرائِعَةِ الفِراقِ فَإِنَّهُ","سِلمُ السُهادِ وَحَربُ نَومِ النُوَّمِ",13,"م",1,0],["وَمَن وَرِثَ العودَينِ وَالخاتَمَ الَّذي","لَهُ المُلكُ وَالأَرضُ الفَضاءُ رَحيبُها",14,"ب",3,0],["ومِنْ وراءِ السُّجوفِ بَدرُ دُجىً","يُخْجِلُ بَدرَ الدُّجى إذا طَلَعا",15,"ع",2,0],["ومن وراءِ سُجوفِ الرَّقْمِ شَمسُ ضُحىً","تجولُ في جنحِ ليلٍ مُظلمٍ دَاجِي",16,"ج",2,0],["وَمَن وَجهُهُ مِثلُ شَمسِ النَهارِ","عَزيزُ المَقالِ عَزيزُ السَناءِ",17,"ا",2,0],["وَمِن وَشيِ خَدٍّ لَم يُنَمنَم فِرِندُهُ","مَعالِمَ يُذكِرنَ الكِتابَ المُنَمنَما",18,"م",2,0],["ومن وقوف على قلوصٍ","وسيرِ ليلِ على قعود",19,"د",1,0],["وَمَن وَمَن عانَدَهُ","أَو جارَ لَم يُنتَهَبِ",20,"ب",1,0],["وَمِنْ وَحِيدٍ ناعِمٍ ظِفْرُهُ","لَيْسَ لِبُؤسٍ عَنْهُ مِنْ دَافِعِ",21,"ع",1,0],["وَمِنْ وَدَاعِةٍ وَمِنْ شَجَاعَةٍ","يَكْبُرُهَا العدوُّ كَالصَّدِيقِ",22,"ق",1,0],["ومن وقع سيف نام بين أضالعي","إلى وقع رمح راح يوغل في ظهري",23,"ر",2,0],["ومن وحش إلى وحشين","وهي الناقة العجفا",24,"ف",2,0],["ومن وجدالزند الذي هو ثاقبٌ","فلنْ يَقْدَحَ الزَّنْدَ الذي هوَ صالِدُ",25,"د",1,0],["ومن وافى حماه ولاذ مما","دهاه بغير ريب لا يضام",26,"م",1,0],["ومنوا علينا بالوفا بعد هجركم","فليس لنا والله من دونكم قصد",27,"د",1,0],["ومنوا له يا سادتي بالتفاتة","يطيب بمعنى طيبها طيب العطر",28,"ر",1,0],["ومن ورائي فارْحَموا غُربتي","حدائقٌ غُلْبٌ وأَنْهارُ",29,"ر",1,0],["وَمَن وَجَلالِ اللهِ حَلفَةَ صَادِقٍ","بري حُبُّهُ لَو تَعلَمينَ عِظامِى",30,"م",2,0],["ومن واجدٍ طاوٍ على حسراتهِ","ولو انها في شامخٍ لتهدما",31,"م",2,0],["ومن والدٍ برٍّ وأمٍّ رحيمةٍ","تنوحُ على من غالهُ الموتُ منهما",31,"م",2,0],["وَمَنْ وَمَنْكَعَلِيِّهِ","فِي نَشْرِ فَضْلٍ وَطَيِّهِ",32,"ي",2,0],["وَمِن وَضْعِهِ فِي حُرِّ وَجهِي وَرَفعِهِ","لِقِمَّةِ رَأْسِي أَنْ يعِز مَآلُ",33,"ل",1,0],["ومن وقوفي على طلول","دوارس الرسم في حماك",34,"ك",1,0],["وَمَن وَقتي بِهِ سَيفٌ","عَلى الكَونِ بِهِ أَسطو",35,"ط",2,0],["وَمَن وَطِئَتهُ أَقدَامُ المَنَايَا","فَإِنِّي ذَلِكَ النّيقُ الرَّفِيعُ",36,"ع",1,0],["ومَن وجَهُه بِشْرٌ ومَن كفُّه نَدىً","ومَن خُلْقُه لطفٌ ومَن خَلْقُه لُطَف",37,"ف",1,0],["ومن ورائي أُصَيْحابٌ تَركتُهمُ","في منزلٍ بخُطوبِ الدّهرِ مُكْتَنَف",38,"ف",1,0],["ومَنَّ وقَدْ غاب الرقيبُ برَشفةٍ","من الشنب البرّاقِ أحلَى مِنَ المَنِّ",39,"ن",1,0],["ومنوا عليه بالرضا وتجاوزوا","وإن ملأ الدنيا ذنوباً وعصيانا",40,"ن",2,0],["وَمُنَوَّعِ الحركات يَلعبُ بِالنُهى","لَبِس المحاسن عند خَلعِ لِباسِه",41,"س",2,1],["ومنوّرٍ بضريح أفضل مرسلٍ","يا حبَّذا ذاك الضريح الأَنور",42,"ر",1,0],["ومن والاه أُلْبسَ ثوبَ عز","وصار من الحوادث في أمان",43,"ن",1,0],["ومن وهب الأموال أو قتل العدا","ليشري بذاك الشكر والحمد بحمدُ",44,"د",1,0],["ومن ولَدَتْ من كريمِ النِّجارِ","ومن أرْضَعَتْ بِلِبانِ الدَّهاءِ",45,"ا",2,0],["ومَنْ وَسِعَ الإسلامَ رَأْفَةَ مُنْعِمٍ","وهيَّأَ للإِشراكِ عَدْوَةَ رِئْبَالِ",46,"ل",1,0],["ومن ولدناه إن الموت أفقدنا","ومن ألفناه كان الموت فرّقنا",47,"ن",2,0],["ومنوّهم بتهويل","وانذار لمجترم",48,"م",1,0],["ومن ورائهمُ عقدُ اليمين سُدىً","مضيَّعٌ وذمامُ الجار مخفورُ",49,"ر",1,0],["وَمُنَّوا بِإحسانٍ وَجُودُوا بِرَأفَةٍ","وبِالفضلِ لُطفاً أَبدِلُوا العسرَ باليسر",50,"ر",1,0],["ومُنُّوا علينا بالعِنايَةِ إِنَّنا","ضِعافٌ فيَا للوارِداتِ القَوِيَّةِ",51,"ه",1,0],["وَمَنْ وَجَدَ الْحَقِيقَةَ وَهْيَ حَقٌّ","فَقَدْ بَطَلَ التَّمَسُّكُ بالخَيالِ",52,"ل",1,0],["ومن وقفةٍ في مضيق القرا","عِ وَالجيشُ مشتعلٌ بِاِنهِزامِ",53,"م",1,0],["ومن واقفٍ فوق رجّافةٍ","تَزِلُّ الأخامصُ عنها زليلا",54,"ل",2,0],["ومِن ولدٍ كالعينِ منه كرامةً","يُقاد بأيدي النّاكثين ويُعْسَفُ",55,"ف",1,0],["ومن واترٍ ظَفِرَتْ عنوةً","بأثوابه قبضةُ الثّائرِ",56,"ر",1,0],["ومَن وَفَى النَّاسَ في ما كان مؤتَمناً","وَفَى لهُ الدَّهرُ في ما كان يُودِعُهُ",57,"ع",2,0],["ومن وَجْهِ الإلهِ لهُ كفيلٌ","ومن عين السُّعودِ لهُ رقِيبُ",58,"ب",1,0],["وَمَن وَكَّلتَ عَلى قَبضِ مَتاعِكَ أَي","مِن ثَمَنٍ لِطَعامِكَ الَّذي اِتَّجَرا",59,"ر",2,0],["وَمَنْ وَصْلُهُ الصُّبْحُ الذي هو مُرشِدِي","كما هَجْرُهُ الليلُ الذي هُوَ مُدْرِكِي",60,"ك",2,0],["ومَنْ وَجْهُهُ مع قدِّه مع رِدْفِه","هلالٌ على غصنٍ يَمِيس على دِعْصِ",61,"ص",1,0],["ومَن وعد العباد بحسن أجر","إذا اجتنبت نفوسهم الدنايا",62,"ا",3,0],["وَمَن ولدته أمّه الطهر فاطم","وفي البيت لا مولود من قبل يوضعُ",63,"ع",1,0],["ومن واقفاتٍ فوقهنّ أهلّةٌ","حنايا هي التّيجانُ أو هيَ أبدعُ",64,"ع",1,0],["وَمنوف العلا بفضلك سادَت","وَتحلّت عقودها بِنظام",65,"م",1,0],["وَمَن وَمَن لا يُبارَى في مَعارفه","وَفَضلِه الوافرِ الفَيّاضِ كَالسُحب",66,"ب",1,0],["ومن ورق صامت بدرة","ينوء بها الأغلب الأعصم",67,"م",1,0],["ومن وثقت بالأمر والنهي نفسه","فأليق ما فيه التجاوز والحلم",68,"م",1,0],["ومنوِّلَ العاصي المعادي فرصةً","ليعود عوناً من عصاك وعادى",69,"د",2,0],["ومَن وردَ الماءَ الذي كنتُ وارداً","نعم ورعى العُشْبَ الذي كنت راعيا",70,"ي",2,1],["ومن وخزته بالنوب الليالي","فكيف يطيق عدوا واشتدادا",71,"د",2,0],["ومن ورع درع وسيف من الحجى","وحصن من التفويض في كل حد ثان",72,"ن",1,0],["وَمِنْ وَرَقِ الأنْهَارِ قَدْ صِيغَ حِجْلُهَا","وَمِنْ جَوْهَرِ الأزْهَارِ صَارَ لَهَا قُرْطُ",73,"ط",1,0],["وَمِنْ وَرَقِ القِدَاحِ لهَا قُصُور","وَمِنْ نَوْرِ الأقاح لها قِبَابُ",74,"ب",1,0],["وَمنوا بِوَعد ينيل المُنى","هديتُم وَلَو كُنتُم تخلِفونا",75,"ن",2,0],["ومن وجناتها يجنى شقيق","ومن رشفاتها عصر المدام",76,"م",1,0],["ومِنْ وُعُولٍ تُباري","غُزْلانَها وَالأَرانِبْ",77,"ب",1,0],["ومن وحلات نفسي يا كرام","الحمى بالمكرمات فانقذوني",78,"ن",2,0],["ومنوا بتقريبي ولو بإعارة","وما كل من يلق الوصال يعير",79,"ر",1,0],["ومنوا باقبال على الخير والرضا","بمن جاء مرسولا إلى العجم والعرب",80,"ب",1,0],["ومن وباء سيط بالوبال","ومن خباء نيط بالخبال",81,"ل",1,0],["وَمِن وارِدٍ فيهِ عَلى ما يَسُرُّهُ","وَمِن وارِدٍ فيهِ عَلى الحَسَراتِ",82,"ت",1,0],["ومن وجد السبيل إِلى حياةٍ","ولم يحيَ فذاك هو الشنار",83,"ر",1,0],["ومن وحتى ثم لوما ثمّ لو","لا وجواب الشرط أو جواب لو",84,"و",1,0],["ومن ودك العرفان نور قذفته","ولولاه لم يعرفك جنس الخليقة",85,"ه",1,0],["ومن وجلٍ للقلبِ فيه أراقم","ومن خجلٍ للوجهِ فيه صِباغُ",86,"غ",1,0],["ومن وقاك وقانا الله منك فلم","يمسسك ضر وقد ضمنت نيرانا",87,"ن",2,0],["وَمَنْ وَضَعَ التَّقْرِيبَ فِي غَيْرِ أَهْلِهِ","فَذَاكَ امْرُؤٌ مَسْعَاهُ وَالْقَصْدُ خَائِبُ",88,"ب",1,0],["ومن ولدي وَوالدتي","ومن جدي معاً وأبي",89,"ب",2,0],["ومن ورود الحميا أنت في خجل","يا ورد جلق أم من خدها العنمي",90,"م",2,0],["وَمُنَوَّعُ الحَرَكَاتِ قَدْ رَكِبَ الهَوَا","يَخطُو عَلَى خَطٍ بِهِ مُتَوَهمِ",91,"م",1,0],["وَمَن وَفَّرَ لي جاهي","وَمَن يَسَّرَ لي أَمري",92,"ر",2,0],["ومن ورود الركايا","ورود صهباء صرف",93,"ف",1,0],["ومن واصلٍ سرَّ الحقيقةِ صامت","ولو نطق المسكين عجزه الورى",94,"ا",1,0],["ومن واقفٍ للخلق عند مقامه","ومنزله في الغيب منزلةُ الاسا",94,"ا",1,0],["ومن واجدٍ قد قام من متواجد","فأبدى له الوجدُ الوجود وما زها",94,"ا",1,0],["ومن وجه يكون سناه أيضاً","كما أن الهدى عين الضلال",95,"ل",1,0],["ومن وجنةٍ أبدى الحَيَا طيبَ رَشْحِها","كأنّ من الخَدَّيْنِ تستقطرُ الوردا",96,"د",2,0],["ومن وجنتيه نار وجدي وخصره","نحولي ومن سقم الجفون سقامي",97,"م",2,0],["ومن وَعَدَ الرحمن موسى ببعثه","وهيهات للرحمن يُخلَفُ موعد",98,"د",1,0],["ومن وجه ليلى طلعة الشمس تستضى","وفي الشمس ابصار الورى تتحي",99,"ي",1,0],["ومن ولائك ان اظمأ فحسبي ما","يغني بسلساله عن بادر شبم",100,"م",1,0],["ومن ولع بالغيد حطّ راسه","وذلّ للظبي الربيب الاحوم",101,"م",1,0],["ومنونا وهنونا بوصل","وحق جنابكم لا تقطعونا",102,"ن",2,0],["ومن وسع الأنام بكل فتياً","يقيناً علمه وسع الاناما",103,"م",2,0],["ومن ورائي فلاة","مأهولة بالممات",104,"ت",1,0],["ومن ومن هيهات أحصي الذي","أعطى لما هب وما دبّا",105,"ب",2,0],["ومن ولهى أنّي أخبِّرُ بالذي","تحققتموهُ من وفائي ومن عهدي",106,"د",2,0],["ومن وطئ السّماك باخمصيه","ومبسوط الذّراع لهُ وساده",107,"د",2,0],["ومن وقعات بالرجال كأنها","إذا عنت الأحداث وقع المناصل",108,"ل",1,0],["ومن ومن تولتنا فضائله","سبحانه ليس هذا القول يحصيها",109,"ي",3,0],["ومن وجنتي الورد طاب اجتناؤه","ومن خجل وجبي تصبب ماؤه",110,"ه",1,0],["ومن وعاهُ في دنّه زمناً","واكتاله في الظّروف إذ حلبَهْ",111,"ب",2,0],["وَمِن وادي القنانِ وَأَينَ مِنّي","بداراتِ الرُّها وادي القَنانِ",112,"ن",1,0],["وَمن وسط البان حلّ النِطاق","وزرّ عَلى البَدرِ أَزرارهُ",113,"ر",2,0],["وَمن وَطئ السَماء بأَخمصيه","يَعود له وَراء الترب خدُّ",114,"د",1,0],["ومن والِدٍ للهِ منْشأُ فضْلِهِ","إذا جدَّهُ الأرْضَى حمِدْنا ووالِدَهْ",115,"د",2,0],["وَمن وَمَا وَال تُسَاوِى مَا ذُكِر","وَهَكَذَا ذُو عِندَ طيِّءٍ شُهِر",116,"ر",1,0],["ومنّوا علينا ضحىً بالقدو","أمير المؤمنين وكونوا غداً للغدا عندنا",117,"ن",2,0],["ومن وله بالموت لو كان لامرئ","بحسناء لم تخلف بزورته وعدا",118,"د",2,0],["ومن وجيه لفحة","من اللظى المستعر",119,"ر",1,0],["ومن ورائهم أخيل رفعا","هامة فطرقل بلب خلعا",120,"ع",2,0],["وَمَنوبةٌ نابَت عَلى جَنّةِ العُلا","وَمَنظَرُها المَأنوس يَسبى النُهى سِحرا",121,"ر",2,0],["ومن وصال الحب كل مدنف","به يخص من أريد وأصطفي",122,"ي",1,0],["وَمِن وُشاةٍ أُدارِيهِمْ وَمِن فِكَرٍ","شَتّانَ ما بَيْنَ حَالَينا لِذِي بَصَرٍ",123,"ر",1,0],["ومنوا بمعهود الرضا وتصدقوا","ألا زهرة من روض العطف تقطع",124,"ع",1,0],["ومن ورد فتحت له","بسوق الذكر دكانا",125,"ن",2,0],["ومن وطئت ارض العراقين رجله","من الروم جرَّبناه للأوج يصعد",126,"د",1,0],["ومن وطئت أرض العراق ركابه","إلى الأوج جربناه لاشك يصعد",127,"د",1,0],["ومِنْ وَحَّد الله وانتِذَر عَمَّا سِواه","أسكَنه رَبِّي جَنةٍ لا جِزا لها",128,"ل",3,0],["ومن وصفه عزم وحزم تواضع","حياء وود والمرؤة والحذق",129,"ق",1,0],["ومن ودّ من لا يجازي الوداد","مثلاً بمثلٍ فقد ضيَّعا",130,"ع",2,0],["ومن وجوهٍ أضاءت في الوجود لهم","ضاء الزمان وزالت كلُّ ظلماء",131,"ا",2,0],["ومنوِّراً بصرَ النهى","في اثمد الحِكَم الظواهر",132,"ر",1,0],["ومن وهج الشفق الساطع","على وجنتيها أقام الضرام",133,"م",1,0],["ومن ورث الأولاد بعد وفاته","حضانك طابت نفسه حين يقبر",134,"ر",1,0],["ومَنْ وجدَ الكلابَ سَراةَ قَومِ","فليسَ عليهِ إنْ سَبَّ الكِلابا",135,"ب",2,0],["ومن ورع درع وسيف من الحجا","وحسن من التفويض في كل حدثان",136,"ن",1,0],["ومن وين ماودك تناديني ايام","وانا بجيب ايام عمري لك بيوم",137,"م",1,0],["ومِن وَهْدَتِهِ السُّفلى","عَلا لِلصَّعْدةِ العُلْيا",138,"ي",2,0],["ومنْ ولدَتْ بفطرتِهِ يَقُلْها","ولو لمْ يدرِ في التَّعليمِ سطْرَا",139,"ر",2,0],["ومَنْ والاكَ عن حبٍّ ووعي ٍ","مُحالٌ لا يكونُ مِنَ الجبال ِ",140,"ل",1,0],["ومن وقدها ما تحلّى بالأدبْ","لمّة البدوان سَوْتّ له زفير",141,"ر",1,0],["ومنوا على أوطانكم باتحادكم","فليس على سهل اتحادكم صعب",142,"ب",1,0],["ومن وهمٍ إلى وهم تداعوا","بأيّ الحقِّ هذا الوهمُ حقُّ؟!",143,"ق",1,0],["ومن وفائي ومن وجدي ومن سهري","ومن صمودي ومن أحلى كفاحاتِي",144,"ت",2,0],["ومن وزير فاسدٍ","ومن زعيم أبطلِ",145,"ل",1,0],["ومن والد سامي الذرى ذي مآثر","حسان وأخلاق يفاع المراتب",146,"ب",1,0],["ومن واجبات الدين أو مستحبه","ومندوبه أو سنة القول والعمل",147,"ل",1,0],["وَمِنْ وَشْوَشات الحُبِّ يَرْتِعِشُ المَدَى","وتلكَ الزَّوايا صَمْتُها يَتَفَجَّرُ",148,"ر",1,0],["ومن وجع إلى وجع وقدسٌ","من الرحمن للأكوان شمسُ",149,"س",1,0],["ومن وجه الطفولة وجه حبي","ووجهي وجه لعبته الرؤوف",150,"ف",1,0],["ومن وجهِكِ الوضَّاءِ كَبَّرتِ الضُّحَى","وصَلَّت ورمشُ العينِ سكرانُ هاجعُ",151,"ع",1,0],["ومن وجع الليالي صغتُ لحنا","بقلبٍ في دروب الحلم يضرى",152,"ر",2,0],["ومن وين الزمن مقبل وإلى وين الليال تقود","ومن في هالزمن يقدر يوجّه خطوة أقدامه",153,"م",2,0],["ومنْ وَهَجٍ مُسْتَبدٍّ بحرفي","ومن نصلِ شعرٍ فروحي غِذاهْ",154,"ا",2,0],["ومن واردي ارسل عليهم أفاعيا","لتحميهم عن مورد الطعن والضرب",155,"ب",1,0],["ومن.. وكيف ..لماذا ...ياترى ولمن؟","تظل أسأئلة ....حرى تبعثرني !",156,"ن",2,0],["ومن وهب العلياء نفسا عزيزة","فليس له غير النهوض لها أمر",157,"ر",1,0],["ومن وجدٍ يُجرجره فُرادى","فإن حلَّ اللقاءُ أتاهُ بيني",158,"ن",2,0],["ومن وردوا أرض الغري بدا لهم","سنا الحق وضاحاً فقالوا احبسوا العيسا",159,"س",2,0]]}