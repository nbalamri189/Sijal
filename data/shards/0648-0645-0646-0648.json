{"poems":[[53,"أقول لركب رائحين لعلكم","https://www.aldiwan.net/poem29626.html","الطويل"],[53,"أثرها على ما بها من لغب","https://www.aldiwan.net/poem30743.html","المتقارب"],[55,"ركبنا وفتيان صدق ثبينا","https://www.aldiwan.net/poem26089.html","المتقارب"],[86,"بنات الشعر بالنفحات جودي","https://www.aldiwan.net/poem10690.html","الوافر"],[73,"أفاض سماحك بحر الندى","https://www.aldiwan.net/poem11956.html","المتقارب"],[83,"أللمحة من بارق متبسم","https://www.aldiwan.net/poem54240.html","الكامل"],[88,"زر السجن في بغداد زورة راحم","https://www.aldiwan.net/poem45020.html","الطويل"],[27,"طرب الحمام بذي الأراك فهاجني","https://www.aldiwan.net/poem5781.html","الكامل"],[37,"ألا أبلغ جماعة أهل مرو","https://www.aldiwan.net/poem6907.html","الوافر"],[47,"ضلال مارأيت من الضلال","https://www.aldiwan.net/poem25209.html","الوافر"],[85,"بنى عبد السلام على أبيكم","https://www.aldiwan.net/poem7142.html","الوافر"],[43,"فديناك من ربع وإن زدتنا كربا","https://www.aldiwan.net/poem9455.html","الطويل"],[45,"سقاني القهوة السلسل","https://www.aldiwan.net/poem65570.html","المنسرح"],[45,"هذي المعاهد من سعاد فسلم","https://www.aldiwan.net/poem66637.html","البسيط"],[28,"رأيت بني مروان يرفع ملكهم","https://www.aldiwan.net/poem1276.html",""],[61,"أإن دنا الشوق بعد ما شسعا","https://www.aldiwan.net/poem51574.html","المنسرح"],[61,"لو سالمته سجايا طرفك الساجي","https://www.aldiwan.net/poem51752.html","البسيط"],[66,"أيا ملكا ربعه للعفاة","https://www.aldiwan.net/poem39068.html","المتقارب"],[44,"عسى وطن يدنو بهم ولعلما","https://www.aldiwan.net/poem30356.html","الطويل"],[48,"لقبلة الراحِ إذ تصلي","https://www.aldiwan.net/poem66577.html","مخلع البسيط"],[50,"هل من رسول مخبر","https://www.aldiwan.net/poem64796.html","مجزوء الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55011","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55082","الرجز"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/142172","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142324","الهزج"],[67,"جَنابكِ منه تُسْتَفَادُ الفَوائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13730&r=&rc=6",""],[115,"الا يا من به يجلى الظلام","https://www.aldiwan.net/poem40599.html","عموديه"],[115,"سهرنا على ذكر الاحبة يا هند","https://www.aldiwan.net/poem41164.html","عموديه"],[115,"سكنتم سويد القلب في برزخ الصدر","https://www.aldiwan.net/poem41661.html","الطويل"],[166,"غريبكم ليس له دار","https://www.aldiwan.net/poem47069.html","السريع"],[181,"بأهلى ومالى من بليت بحبه","https://www.aldiwan.net/poem59061.html","الطويل"],[199,"ألا لا تلمه اليوم أن يتألما","https://www.aldiwan.net/poem45633.html","الطويل"],[237,"إدريس نجل سميه","https://www.aldiwan.net/poem19754.html","مجزوء الكامل"],[275,"سجام لعمري أدمع وسجال","https://www.aldiwan.net/poem25421.html","الطويل"],[304,"يا بهجة الحسن هل أراك","https://www.aldiwan.net/poem16810.html","مخلع البسيط"],[349,"أيا من حبه حالي","https://www.aldiwan.net/poem15760.html","الهزج"],[357,"أضاء ببرقة برق لموع","https://www.aldiwan.net/poem4163.html","الوافر"],[364,"محلك سام والعلاء به اعتكف","https://www.aldiwan.net/poem60840.html","الطويل"],[364,"حيث انتهيت من الهجران بي فقف","https://www.aldiwan.net/poem60841.html","البسيط"],[402,"تخطر كالبدر المنير على غصن","https://www.aldiwan.net/poem46742.html","الطويل"],[403,"علام يلام القلب إن ظل حيرانا","https://www.aldiwan.net/poem33375.html","الطويل"],[408,"ومنوع الحركات يلعب بالنهى","https://www.aldiwan.net/poem4196.html","الكامل"],[416,"لمن السوابق والجياد الضمر","https://www.aldiwan.net/poem54183.html","الكامل"],[432,"خليلي اتركا ما تعدلاني","https://www.aldiwan.net/poem12479.html","الوافر"],[437,"أقيموا عمود الدين للّه تسعدوا","https://www.aldiwan.net/poem2621.html","الطويل"],[439,"وأهد بها في الفلا والسرى","https://www.aldiwan.net/poem34834.html","المتقارب"],[439,"سلام على الأيام تسليم إقبال","https://www.aldiwan.net/poem34847.html","الطويل"],[441,"لا جدد الله فيما بينكم حزنا","https://www.aldiwan.net/poem14483.html","البسيط"],[443,"وشب بأرض بوليفا","https://www.aldiwan.net/poem55925.html","عموديه"],[458,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[500,"أتانا الهوى العذري من حيث لا ندري","https://www.aldiwan.net/poem37700.html","الطويل"],[500,"أراني هلال الأفق لمعة أنسكم","https://www.aldiwan.net/poem38063.html","الطويل"],[529,"نظام يا ابن ودي أم لآلي","https://www.aldiwan.net/poem37270.html","الوافر"],[551,"بلغت المنى في جميع المرام","https://www.aldiwan.net/poem47210.html","المتقارب"],[551,"رقدت وأسهرت ليلا طويلا","https://www.aldiwan.net/poem47320.html","المتقارب"],[551,"خذوا من جفوني ماءها فهي ذرف","https://www.aldiwan.net/poem47400.html","الطويل"],[551,"ألا حبذا زمن الحاجر","https://www.aldiwan.net/poem47796.html","المتقارب"],[562,"تذكر المنحنى فانهل مدمعه","https://www.aldiwan.net/poem52851.html","البسيط"],[562,"كثيب فوقه غصن رطيب","https://www.aldiwan.net/poem52890.html","الوافر"],[563,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[575,"بنفسي من فارقت فيه تماسكي","https://www.aldiwan.net/poem2901.html","الطويل"],[575,"غدا الحسن شورى في الملاح وإنما","https://www.aldiwan.net/poem2922.html","الطويل"]],"verses":[["وَمَن وَرَدَ الماءَ الَّذي كُنتُ وارِداً","بِهِ وَرَعى الرَوضَ الَّذي كُنتُ راعِيا",0,"ي",2,0],["وَمَن وَجَدَ الرِزقَ عِندَ السُيوفِ","فَلَم يَتَحَمَّل لِذُلِّ الطَلَب",1,"ب",1,0],["وَمِن واقِفٍ راكِبٍ فارِهاً","لِيَمضي عَلَيهِ فَريداً مَكينا",2,"ن",2,0],["وَمُنّوا بِالوُجودِ فَقَد جَهِلنا","بِفَضلِ وُجودِكُم مَعنى الوُجودِ",3,"د",1,0],["وَمِن وُصَلي هِجرَةٌ لا أَعُدُّ","لِحالي سِوى يَومِها مَولِدا",4,"د",2,0],["ومنوّعِ الحركات قد ركب الهوا","يمشي على خط به متوهّمِ",5,"م",1,0],["ومن وسط السور الشَماليّ تنتهي","إليها بمسدود الرتاجين مُوصَد",6,"د",1,0],["وَمُنوا بِمُلتَهِمِ العِنانِ مُناقِلٍ","عِندَ الرِهانِ مُقَرِّبٍ وَمُحاضِرِ",7,"ر",1,0],["ومن ولى بذمته رزينا","وشيعته ولم يعرف بعهدِ",8,"د",1,0],["وَمَن وَرَدَ المَهالِكَ لَم تَرُعهُ","رَزايا الدَهرِ في أَهلٍ وَمالِ",9,"ل",1,0],["ومن وزن الزمان فتى وشيخا","إذا الفتيان قبل الشيب ضلوا",10,"ل",3,0],["وَمِن واهِبٍ جَزلاً وَمِن زاجِرٍ هَلاً","وَمِن هاتِكٍ دِرعاً وَمِن ناثِرٍ قُصبا",11,"ب",2,0],["وَمِن وَردٍ بِخَدَّيهِ","إِذا جَمَّشتُهُ يَخجَل",12,"ل",1,0],["وَمُنوا بِرائِعَةِ الفِراقِ فَإِنَّهُ","سِلمُ السُهادِ وَحَربُ نَومِ النُوَّمِ",13,"م",1,0],["وَمَن وَرِثَ العودَينِ وَالخاتَمَ الَّذي","لَهُ المُلكُ وَالأَرضُ الفَضاءُ رَحيبُها",14,"ب",3,0],["ومِنْ وراءِ السُّجوفِ بَدرُ دُجىً","يُخْجِلُ بَدرَ الدُّجى إذا طَلَعا",15,"ع",2,0],["ومن وراءِ سُجوفِ الرَّقْمِ شَمسُ ضُحىً","تجولُ في جنحِ ليلٍ مُظلمٍ دَاجِي",16,"ج",2,0],["وَمَن وَجهُهُ مِثلُ شَمسِ النَهارِ","عَزيزُ المَقالِ عَزيزُ السَناءِ",17,"ا",2,0],["وَمِن وَشيِ خَدٍّ لَم يُنَمنَم فِرِندُهُ","مَعالِمَ يُذكِرنَ الكِتابَ المُنَمنَما",18,"م",2,0],["ومن وقوف على قلوصٍ","وسيرِ ليلِ على قعود",19,"د",1,0],["وَمَن وَمَن عانَدَهُ","أَو جارَ لَم يُنتَهَبِ",20,"ب",1,0],["وَمِنْ وَحِيدٍ ناعِمٍ ظِفْرُهُ","لَيْسَ لِبُؤسٍ عَنْهُ مِنْ دَافِعِ",21,"ع",1,0],["وَمِنْ وَدَاعِةٍ وَمِنْ شَجَاعَةٍ","يَكْبُرُهَا العدوُّ كَالصَّدِيقِ",22,"ق",1,0],["ومن وقع سيف نام بين أضالعي","إلى وقع رمح راح يوغل في ظهري",23,"ر",2,0],["ومن وحش إلى وحشين","وهي الناقة العجفا",24,"ف",2,0],["ومن وجدالزند الذي هو ثاقبٌ","فلنْ يَقْدَحَ الزَّنْدَ الذي هوَ صالِدُ",25,"د",1,0],["ومن وافى حماه ولاذ مما","دهاه بغير ريب لا يضام",26,"م",1,0],["ومنوا علينا بالوفا بعد هجركم","فليس لنا والله من دونكم قصد",27,"د",1,0],["ومنوا له يا سادتي بالتفاتة","يطيب بمعنى طيبها طيب العطر",28,"ر",1,0],["ومن ورائي فارْحَموا غُربتي","حدائقٌ غُلْبٌ وأَنْهارُ",29,"ر",1,0],["وَمَن وَجَلالِ اللهِ حَلفَةَ صَادِقٍ","بري حُبُّهُ لَو تَعلَمينَ عِظامِى",30,"م",2,0],["ومن واجدٍ طاوٍ على حسراتهِ","ولو انها في شامخٍ لتهدما",31,"م",2,0],["ومن والدٍ برٍّ وأمٍّ رحيمةٍ","تنوحُ على من غالهُ الموتُ منهما",31,"م",2,0],["وَمَنْ وَمَنْكَعَلِيِّهِ","فِي نَشْرِ فَضْلٍ وَطَيِّهِ",32,"ي",2,0],["وَمِن وَضْعِهِ فِي حُرِّ وَجهِي وَرَفعِهِ","لِقِمَّةِ رَأْسِي أَنْ يعِز مَآلُ",33,"ل",1,0],["ومن وقوفي على طلول","دوارس الرسم في حماك",34,"ك",1,0],["وَمَن وَقتي بِهِ سَيفٌ","عَلى الكَونِ بِهِ أَسطو",35,"ط",2,0],["وَمَن وَطِئَتهُ أَقدَامُ المَنَايَا","فَإِنِّي ذَلِكَ النّيقُ الرَّفِيعُ",36,"ع",1,0],["ومَن وجَهُه بِشْرٌ ومَن كفُّه نَدىً","ومَن خُلْقُه لطفٌ ومَن خَلْقُه لُطَف",37,"ف",1,0],["ومن ورائي أُصَيْحابٌ تَركتُهمُ","في منزلٍ بخُطوبِ الدّهرِ مُكْتَنَف",38,"ف",1,0],["ومَنَّ وقَدْ غاب الرقيبُ برَشفةٍ","من الشنب البرّاقِ أحلَى مِنَ المَنِّ",39,"ن",1,0],["ومنوا عليه بالرضا وتجاوزوا","وإن ملأ الدنيا ذنوباً وعصيانا",40,"ن",2,0],["وَمُنَوَّعِ الحركات يَلعبُ بِالنُهى","لَبِس المحاسن عند خَلعِ لِباسِه",41,"س",2,1],["ومنوّرٍ بضريح أفضل مرسلٍ","يا حبَّذا ذاك الضريح الأَنور",42,"ر",1,0],["ومن والاه أُلْبسَ ثوبَ عز","وصار من الحوادث في أمان",43,"ن",1,0],["ومن وهب الأموال أو قتل العدا","ليشري بذاك الشكر والحمد بحمدُ",44,"د",1,0],["ومن ولَدَتْ من كريمِ النِّجارِ","ومن أرْضَعَتْ بِلِبانِ الدَّهاءِ",45,"ا",2,0],["ومَنْ وَسِعَ الإسلامَ رَأْفَةَ مُنْعِمٍ","وهيَّأَ للإِشراكِ عَدْوَةَ رِئْبَالِ",46,"ل",1,0],["ومن ولدناه إن الموت أفقدنا","ومن ألفناه كان الموت فرّقنا",47,"ن",2,0],["ومنوّهم بتهويل","وانذار لمجترم",48,"م",1,0],["ومن ورائهمُ عقدُ اليمين سُدىً","مضيَّعٌ وذمامُ الجار مخفورُ",49,"ر",1,0],["وَمُنَّوا بِإحسانٍ وَجُودُوا بِرَأفَةٍ","وبِالفضلِ لُطفاً أَبدِلُوا العسرَ باليسر",50,"ر",1,0],["ومُنُّوا علينا بالعِنايَةِ إِنَّنا","ضِعافٌ فيَا للوارِداتِ القَوِيَّةِ",51,"ه",1,0],["وَمَنْ وَجَدَ الْحَقِيقَةَ وَهْيَ حَقٌّ","فَقَدْ بَطَلَ التَّمَسُّكُ بالخَيالِ",52,"ل",1,0],["ومن وقفةٍ في مضيق القرا","عِ وَالجيشُ مشتعلٌ بِاِنهِزامِ",53,"م",1,0],["ومن واقفٍ فوق رجّافةٍ","تَزِلُّ الأخامصُ عنها زليلا",54,"ل",2,0],["ومِن ولدٍ كالعينِ منه كرامةً","يُقاد بأيدي النّاكثين ويُعْسَفُ",55,"ف",1,0],["ومن واترٍ ظَفِرَتْ عنوةً","بأثوابه قبضةُ الثّائرِ",56,"ر",1,0],["ومَن وَفَى النَّاسَ في ما كان مؤتَمناً","وَفَى لهُ الدَّهرُ في ما كان يُودِعُهُ",57,"ع",2,0],["ومن وَجْهِ الإلهِ لهُ كفيلٌ","ومن عين السُّعودِ لهُ رقِيبُ",58,"ب",1,0],["وَمَن وَكَّلتَ عَلى قَبضِ مَتاعِكَ أَي","مِن ثَمَنٍ لِطَعامِكَ الَّذي اِتَّجَرا",59,"ر",2,0],["وَمَنْ وَصْلُهُ الصُّبْحُ الذي هو مُرشِدِي","كما هَجْرُهُ الليلُ الذي هُوَ مُدْرِكِي",60,"ي",1,0],["ومَنْ وَجْهُهُ مع قدِّه مع رِدْفِه","هلالٌ على غصنٍ يَمِيس على دِعْصِ",61,"ص",1,0]]}