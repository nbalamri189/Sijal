{"poems":[[53,"أقول لركب رائحين لعلكم","https://www.aldiwan.net/poem29626.html","الطويل"],[53,"أثرها على ما بها من لغب","https://www.aldiwan.net/poem30743.html","المتقارب"],[55,"ركبنا وفتيان صدق ثبينا","https://www.aldiwan.net/poem26089.html","المتقارب"],[86,"بنات الشعر بالنفحات جودي","https://www.aldiwan.net/poem10690.html","الوافر"],[73,"أفاض سماحك بحر الندى","https://www.aldiwan.net/poem11956.html","المتقارب"],[83,"أللمحة من بارق متبسم","https://www.aldiwan.net/poem54240.html","الكامل"],[88,"زر السجن في بغداد زورة راحم","https://www.aldiwan.net/poem45020.html","الطويل"],[27,"طرب الحمام بذي الأراك فهاجني","https://www.aldiwan.net/poem5781.html","الكامل"],[37,"ألا أبلغ جماعة أهل مرو","https://www.aldiwan.net/poem6907.html","الوافر"],[47,"ضلال مارأيت من الضلال","https://www.aldiwan.net/poem25209.html","الوافر"],[85,"بنى عبد السلام على أبيكم","https://www.aldiwan.net/poem7142.html","الوافر"],[43,"فديناك من ربع وإن زدتنا كربا","https://www.aldiwan.net/poem9455.html","الطويل"],[45,"سقاني القهوة السلسل","https://www.aldiwan.net/poem65570.html","المنسرح"],[45,"هذي المعاهد من سعاد فسلم","https://www.aldiwan.net/poem66637.html","البسيط"],[28,"رأيت بني مروان يرفع ملكهم","https://www.aldiwan.net/poem1276.html",""],[61,"أإن دنا الشوق بعد ما شسعا","https://www.aldiwan.net/poem51574.html","المنسرح"],[61,"لو سالمته سجايا طرفك الساجي","https://www.aldiwan.net/poem51752.html","البسيط"],[66,"أيا ملكا ربعه للعفاة","https://www.aldiwan.net/poem39068.html","المتقارب"],[44,"عسى وطن يدنو بهم ولعلما","https://www.aldiwan.net/poem30356.html","الطويل"],[48,"لقبلة الراحِ إذ تصلي","https://www.aldiwan.net/poem66577.html","مخلع البسيط"],[50,"هل من رسول مخبر","https://www.aldiwan.net/poem64796.html","مجزوء الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55011","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55082","الرجز"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142324","الهزج"],[67,"جَنابكِ منه تُسْتَفَادُ الفَوائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13730&r=&rc=6",""]],"verses":[["وَمَن وَرَدَ الماءَ الَّذي كُنتُ وارِداً","بِهِ وَرَعى الرَوضَ الَّذي كُنتُ راعِيا",0,"ي",2,0],["وَمَن وَجَدَ الرِزقَ عِندَ السُيوفِ","فَلَم يَتَحَمَّل لِذُلِّ الطَلَب",1,"ب",1,0],["وَمِن واقِفٍ راكِبٍ فارِهاً","لِيَمضي عَلَيهِ فَريداً مَكينا",2,"ن",2,0],["وَمُنّوا بِالوُجودِ فَقَد جَهِلنا","بِفَضلِ وُجودِكُم مَعنى الوُجودِ",3,"د",1,0],["وَمِن وُصَلي هِجرَةٌ لا أَعُدُّ","لِحالي سِوى يَومِها مَولِدا",4,"د",2,0],["ومنوّعِ الحركات قد ركب الهوا","يمشي على خط به متوهّمِ",5,"م",1,0],["ومن وسط السور الشَماليّ تنتهي","إليها بمسدود الرتاجين مُوصَد",6,"د",1,0],["وَمُنوا بِمُلتَهِمِ العِنانِ مُناقِلٍ","عِندَ الرِهانِ مُقَرِّبٍ وَمُحاضِرِ",7,"ر",1,0],["ومن ولى بذمته رزينا","وشيعته ولم يعرف بعهدِ",8,"د",1,0],["وَمَن وَرَدَ المَهالِكَ لَم تَرُعهُ","رَزايا الدَهرِ في أَهلٍ وَمالِ",9,"ل",1,0],["ومن وزن الزمان فتى وشيخا","إذا الفتيان قبل الشيب ضلوا",10,"ل",3,0],["وَمِن واهِبٍ جَزلاً وَمِن زاجِرٍ هَلاً","وَمِن هاتِكٍ دِرعاً وَمِن ناثِرٍ قُصبا",11,"ب",2,0],["وَمِن وَردٍ بِخَدَّيهِ","إِذا جَمَّشتُهُ يَخجَل",12,"ل",1,0],["وَمُنوا بِرائِعَةِ الفِراقِ فَإِنَّهُ","سِلمُ السُهادِ وَحَربُ نَومِ النُوَّمِ",13,"م",1,0],["وَمَن وَرِثَ العودَينِ وَالخاتَمَ الَّذي","لَهُ المُلكُ وَالأَرضُ الفَضاءُ رَحيبُها",14,"ب",3,0],["ومِنْ وراءِ السُّجوفِ بَدرُ دُجىً","يُخْجِلُ بَدرَ الدُّجى إذا طَلَعا",15,"ع",2,0],["ومن وراءِ سُجوفِ الرَّقْمِ شَمسُ ضُحىً","تجولُ في جنحِ ليلٍ مُظلمٍ دَاجِي",16,"ج",2,0],["وَمَن وَجهُهُ مِثلُ شَمسِ النَهارِ","عَزيزُ المَقالِ عَزيزُ السَناءِ",17,"ا",2,0],["وَمِن وَشيِ خَدٍّ لَم يُنَمنَم فِرِندُهُ","مَعالِمَ يُذكِرنَ الكِتابَ المُنَمنَما",18,"م",2,0],["ومن وقوف على قلوصٍ","وسيرِ ليلِ على قعود",19,"د",1,0],["وَمَن وَمَن عانَدَهُ","أَو جارَ لَم يُنتَهَبِ",20,"ب",1,0],["وَمِنْ وَحِيدٍ ناعِمٍ ظِفْرُهُ","لَيْسَ لِبُؤسٍ عَنْهُ مِنْ دَافِعِ",21,"ع",1,0],["وَمِنْ وَدَاعِةٍ وَمِنْ شَجَاعَةٍ","يَكْبُرُهَا العدوُّ كَالصَّدِيقِ",22,"ق",1,0],["ومن وحش إلى وحشين","وهي الناقة العجفا",23,"ف",2,0],["ومن وجدالزند الذي هو ثاقبٌ","فلنْ يَقْدَحَ الزَّنْدَ الذي هوَ صالِدُ",24,"د",1,0]]}