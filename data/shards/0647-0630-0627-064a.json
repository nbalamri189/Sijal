04",""],[4858,"ويلُ الشّجِيّ من الخَلِيّ","https://www.poetsgate.com/ViewPoem.aspx?id=140780",""],[4869,"ماعاد ادوّر صداقه","https://www.poetsgate.com/ViewPoem.aspx?id=151575",""],[5009,"في ذكرى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=24366",""],[5032,"كمان اللّيل","https://www.poetsgate.com/ViewPoem.aspx?id=191770",""],[3591,"يا دار مية دمع العين هطَّال","https://www.poetsgate.com/ViewPoem.aspx?id=149395",""],[5131,"من هَهُنا من أَرضِ يافا أكتبُ","https://www.poetsgate.com/ViewPoem.aspx?id=55256",""],[5135,"قَدْ أنْذَرْتُكُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=201967",""],[5135,"العِيْدُ","https://www.poetsgate.com/ViewPoem.aspx?id=201996",""],[5135,"رَكْبُ المَنِيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=202007",""],[5179,"يَا رب عفوك أنني فِي معشر","https://www.poetsgate.com/ViewPoem.aspx?id=190273",""],[5183,"المْفَتُوْن","https://www.poetsgate.com/ViewPoem.aspx?id=186475",""],[5187,"قدسنا الجريح","https://www.poetsgate.com/ViewPoem.aspx?id=29245",""],[5279,"رَوَّعْتَ قَلْبِي","https://www.poetsgate.com/ViewPoem.aspx?id=183667",""],[5279,"الطُّفُولَةُ","https://www.poetsgate.com/ViewPoem.aspx?id=184133",""],[5320,"رائد الأعلام","https://www.poetsgate.com/ViewPoem.aspx?id=40898",""],[5355,"أسَف","https://www.poetsgate.com/ViewPoem.aspx?id=188321",""],[5370,"أحب ثاني","https://www.poetsgate.com/ViewPoem.aspx?id=85942",""],[5436,"السفر الى ضفاف الرافدين (محمود محمد أسد )","https://www.poetsgate.com/ViewPoem.aspx?id=58602",""],[5561,"نعيم الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=196767",""],[5616,"قصب","https://www.poetsgate.com/ViewPoem.aspx?id=203436",""],[5652,"ياديننا عُذرآ","https://www.poetsgate.com/ViewPoem.aspx?id=174959",""],[5689,"هل طي عرفك لي يا نسمة السحر","https://www.poetsgate.com/ViewPoem.aspx?id=143428",""],[5689,"كم بذا بعاصمة الأنوار من لهب","https://www.poetsgate.com/ViewPoem.aspx?id=143425",""],[5690,"اللّه أكبرُ هذا عصر تجديدِ","https://www.poetsgate.com/ViewPoem.aspx?id=172153",""],[5691,"ديار أهلها رحلوا...!","https://www.poetsgate.com/ViewPoem.aspx?id=206526",""],[5704,"صعُبَ الكلام على الكلام...","https://www.poetsgate.com/ViewPoem.aspx?id=200003",""],[5786,"حتّامَ دمعك في الأطلال ينسكبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50654",""],[5792,"قالو جماله","https://www.poetsgate.com/ViewPoem.aspx?id=180356",""],[5829,"نكبة 2012","https://www.poetsgate.com/ViewPoem.aspx?id=152668",""],[5829,"شدو المستهام في مدح خير الأنام","https://www.poetsgate.com/ViewPoem.aspx?id=155538",""],[5829,"رسالة إلى أمي في ذكرى وفاتها","https://www.poetsgate.com/ViewPoem.aspx?id=175530",""],[5842,"استغفرُ الله / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=135811",""],[5842,"على ضفافِ القلق \\ محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=126129",""],[5933,"قال النبي مقالةً","https://www.poetsgate.com/ViewPoem.aspx?id=40707",""],[5953,"يدعون بالناس إخواناً وقد كذبوا","https://www.poetsgate.com/ViewPoem.aspx?id=93815",""],[5956,"ما عاد يقْبل عقلي الشعرَ واسطة","https://www.poetsgate.com/ViewPoem.aspx?id=183972",""],[5956,"مَن حقق الأحلام إلا فارسٌ؟","https://www.poetsgate.com/ViewPoem.aspx?id=193206",""],[5956,"هذه الدعابة","https://www.poetsgate.com/ViewPoem.aspx?id=193426",""],[5956,"سخّرْتَ وقتك لنجدتنا","https://www.poetsgate.com/ViewPoem.aspx?id=193506",""],[5956,"في بلاد الحب والشيم","https://www.poetsgate.com/ViewPoem.aspx?id=194003",""],[5956,"الله أرسله حتى يؤانسَني","https://www.poetsgate.com/ViewPoem.aspx?id=194170",""],[5956,"يا مُحْدِثاً أقوى اختراق","https://www.poetsgate.com/ViewPoem.aspx?id=194556",""],[5956,"لو مات أولادي لن أحزنا","https://www.poetsgate.com/ViewPoem.aspx?id=194592",""],[5956,"لسامية السّالك اسم آخر هو: عناية بالنازح","https://www.poetsgate.com/ViewPoem.aspx?id=207515",""],[5956,"ثلاث قصائد لصديق","https://www.poetsgate.com/ViewPoem.aspx?id=207975",""],[6031,"لي إنْ تَحَامَاني أَخٌ وحَميمُ","https://www.poetsgate.com/ViewPoem.aspx?id=46275",""],[6031,"يا طِرْسُ قُلْ لخَليلَيَّ اللذَينِ هُمَا","https://www.poetsgate.com/ViewPoem.aspx?id=46349",""],[6068,"قال العواذل هل نسيت غرامها -20-","https://www.poetsgate.com/ViewPoem.aspx?id=175899",""],[6070,"ليلة مع يتيم الشوارع","https://www.poetsgate.com/ViewPoem.aspx?id=188468",""],[6093,"يوماً وقفتُ بسَفْحِ الرِّيمِ مُخْتار (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=175996",""],[6127,"إلى موسى(ع)","https://www.poetsgate.com/ViewPoem.aspx?id=203675",""],[5724,"هتف الزمان مهللا ومكبرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55143&r=&rc=10",""],[6202,"القتل فيكم قد وجبْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86743&r=&rc=44",""],[6355,"ميراث السلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66683&r=&rc=143",""]],"verses":[["هَذا يَحِنُّ إِلى هَذا وَقَد عُقِدَت","مَوَدَّةٌ بَينَهُم مَوصولَةُ السَبَبِ",0,"ب",1,0],["هَذا يَطيرُ مَعَ الخَيا","لِ وَذاكَ يَرتَجِلُ النَوادِر",1,"ر",1,0],["هَذا يَرى رَأيَ العَمي","دِ وَذا يَعُدُّ عَلَيهِ عَدّا",2,"د",2,0],["هَذا يَطيرُ إِلى فَروقَ وَمَن بِها","شَوقاً وَذاكَ إِلى رُبى لُبنانِ",3,"ن",1,0],["هَذَا يَسِيرٌ مِنْ مَعَانٍ جَاوَزَتْ","وُسْعَ امْرِيءٍ وَقَدِ احْتَوَاهَا اسْمَانِ",4,"ن",1,0],["هَذَا يَقُودُ برُّمَتي","قَوداً إِلَيكِ وَذَا يَسُوق",5,"ق",1,0],["هذا يوم يوم جنا","ما لها فالفخر قسيما",6,"م",2,0],["هذا يَميس بأبراد مُفوَّفةٍ","وذا يَخيط شظايا طِمْرِه البالي",7,"ل",2,0],["هذا يفطّر فاه","وذا يفطرُ قلبه",8,"ب",2,0],["هذا يفطر فاه أو","هذا يفطر كبده",9,"د",2,0],["هذا يُبدّي الجلد منك وذا","يسقيك من صفراءَ كالوَرْس",10,"س",1,0],["هذا يُصمِّم في الفُصوص وذاكُمُ","في أيِّما فصٍّ أصاب وأبؤس",11,"س",1,0],["هذا يبيع القريضَ من شرهٍ","ووالديه معاً بفلسين",12,"ن",1,0],["هَذا يُحَرِّكُ بي دَفينَ صَبابَتي","وَيَهُزُّ ذاكَ مَشاعِري وَكَياني",13,"ن",2,0],["هذا يضاجعه الرفاه وذاك في","سغب ينام وقد اقض المرقد",14,"د",1,0],["هذا يثبطه الحجا","ب وذاك يحفزه السفور",15,"ر",1,0],["هَذا يَحُنُّ إِلى البُسفورِ مُحتَضِراً","وَذاكَ يَبكي الغَضا وَالشيحَ وَالبانا",16,"ن",2,0],["هَذا يَفيضُ بِفِضَّةٍ وَبِعَسجَدٍ","وَيَفيضُ ذاكَ بِفاخِرِ المَرجانِ",17,"ن",1,0],["هذا يناولُه النديمُ تحيَّةً","حسُنَت وذا يَحظَى بكأسِ عُقارِ",18,"ر",1,0],["هَذا يُحَبِّرُ مَدحي في الرَّسولِ وَذا","يَتلُو عَلى الناسِ ما أُوحيهِ مِن كَلِمِي",19,"م",2,0],["هَذَا يَحُلُّ وَذَاكَ يَرْحَلُ كَارِهَاً","عَنْهُ فَصُلْحٌ تَارَةً وَخِصَامُ",20,"م",1,0],["هَذا يُقَرِّبُهُ مِنها وَعَبرَتُها","يَومَ الفِراقِ فَما أَرعى وَما اِقتَصَدا",21,"د",2,0],["هَذا يَهُبُّ مَعَ الأَصيلِ عَنِ الرُبى","أَرَجاً وَذَلِكَ عَن غَديرِ الماءِ",22,"ا",2,0],["هذا يُقالُ له الزّعيمُ","كما يُقالُ لذاكَ حُرُّ",23,"ر",1,0],["هذا يُقال لأحمدٍ","إن حصحص الحقُّ المبين",24,"ن",1,0],["هذا يدُلُّهُمُ على ذي عَزْمَةٍ","لا فيهِ تسليمٌ ولا تخذيل",25,"ل",1,0],["هَذا يُفَدّيهِ وَهَذا إِذا","ناوَلَهُ القَهوَةَ حَيّاهُ",26,"ا",2,0],["هَذا يسير على مهل ويشتمني","وَذاكَ يحبو وَذا يعدو وَذا يثب",27,"ب",1,0],["هذا يعالج دلْبَة","والشيخ من حنقَ يصيح",28,"ح",1,0],["هذا يغير على النُّمور، وذاك لا","يُلوي على صيدٍ سوى الغزلان",29,"ن",1,0],["هذا يرفُّ فلا نُحِسُّ بهِ","ويهزُّنا هذا إذا رَفّا",30,"ف",2,0],["هذا يميس بابراد مفوقة","وذا يخيط شظايا طمره البالى",31,"ل",2,0],["هَذا يُجرعهُ مرارة هَجرِهِ","طَوراً وَذا عَذب اللَما يَسقيهِ",32,"ي",2,0],["هذا يهيمه الحطيم بنكة","منها لذي غلط يراد حطام",33,"م",1,0],["هذا يَرِنُّ، وذي رسائِلُها تُعاتِبُ،","أو تُهَدِّدُ بالقَطِيعةِ والنَّدَمْ",34,"م",1,0],["هذا يؤلههه وذاك","يعده في المرسلين",35,"ن",1,0],["هذا يعلُّ وذاكَ ينهلُ تارةً","لا يسأمون عشيةً وصباحا",36,"ح",2,0],["هذا يُسَمِّيهِ قُطباً في مَدَائِحِه","يَوماً وذَا وَتداً مَا القُطبُ وَالوَتِدُ",37,"د",1,0],["هذا يسبّحُ ربَه عجباً وذا","يدعو وذا يثني عليك فيكثرا",38,"ر",2,0],["هذا يشير وذا يثنى عليك وذا","يهدي الدعا رافعاً كفَّيه مُبتهلا",39,"ل",2,0],["هذا يشيرُ وهذا باسطٌ يده","يدعو وذا ناقلُّ تِرباً يقبّلُهُ",40,"ل",2,0],["هذا يصيبُ وذا يخطى بطعنتهِ","وأَنت تضَحكُ ممن مسَّهُ الخجلُ",41,"ل",1,0],["هذا يسبح ذا وهذا قائل","لأخيه أنت الله ذو الإِعظام",42,"م",1,0],["هَذا يَرومُ قِرىً وَذاكَ قِراءَةً","سُمِعَت عَن المُختارِ عَن جِبريلا",43,"ل",2,0],["هَذا يَد اللَه يَسري في أَنامِلِها","سرٌّ مِنَ العَرشِ عَن يمنٍ يُوافيها",44,"ي",3,0],["هذا يزيد وذا يَبي","د كما انْطَوَى ليلٌ بفَجرْ",45,"ر",1,0],["هذا يبوحُ به اللسا","ن وذا يبوح به المآقْ",46,"ق",1,0],["هذا يغُرّ بصوت الشاة من بعد","وذا تخادعُه الآمال والأجلُ",47,"ل",1,0],["هذا يضاف إلى علو","وِ السن في زمن عقوق",48,"ق",1,0],["هذا يموت وذاك يولد بغتة","فالموت يحصد والمهيمن يزرع",49,"ع",1,0],["هذا يذلّ لرخصه فتناله","أيدي الرّذال بما يهون من القطع",50,"ع",1,0],["هذا يقين وهذا ربّما حجبَت","عنه الخطوب وصرف الدهر والحذر",51,"ر",1,0],["هذا يصاول ذا وذاك مراوغ","وجميعهم متثعلبٌ مستأسدُ",52,"د",1,0],["هذا يرنحهُ الأنينُ وذاكَ في","سكراتهِ يهفو بهِ التلحينُ",53,"ن",1,0],["هذا يحيلُ على ذا","وآفةُ الكلِّ جنسُهْ",54,"س",2,0],["هذا يفقدانِ عبدِ اللهِ حلَّ بنَا","وقد تساقطَ من أجفانِنَا الدُّرَرُ",55,"ر",1,0],["هذا يحفُّ بِهِ الغِنى في راحَةٍ","وَيَعُمُّ ذا فَقرٌ جزا أَتعابِهِ",56,"ب",2,0],["هذا يُماشيهِ النَصي","رُ وَذا يُقيمُ بِلا نَصير",57,"ر",1,0],["هذا يُمَجِّد بِالشُرو","رِ وَذا يُهانُ بِلا شُرور",57,"ر",1,0],["هذا يُظَنُّ من اللبا","بِ وَذا يُخالُ من القُشور",57,"ر",1,0],["هذا يُشَمُّ ولا يُضَمْ","مُ وذا يُضَمّ وَيشمَمُ",58,"م",1,0],["هذا يُناجِي ذا هوىً وتحافَظَا","أبداً ولم يَسْتمتعا بلقاء",59,"ا",2,0],["هَذا يَكُرُّ بِذابِلٍ مِن قَدِّهِ","لَدنٍ وَهَذا بِاللَواحِظِ رامِ",60,"م",1,0],["هَذا يَغُضُّ مِنَ اللُجَينِ بَياضُهُ","وَتَتيهُ زُرقَتُهُ عَلى الفيروزَجِ",61,"ج",1,0],["هذا يَفُلُّ بِهِ الْخُطُو","بُ وَذا يَقُدُّ بِهِ الْجَماجِمْ",62,"م",1,0],["هذا ينير به أفق البيان سَنا","وذاك منه بنو الآمال ترتزِق",63,"ق",1,0],["هَذا يَميلُ إِلى أَبي بَكرٍ وَذا","يَبغي عَلِيّاً مُخلِصاً بِتَوَدُّدِ",64,"د",1,0],["هَذا يَقولُ بِما عَلا مِن شَأنِها","وَالآخَرونَ بِفَخرِ تِلكَ النِعمَةِ",65,"ه",1,0],["هذا يهوذاه الذي باعه","وذاك بيلاطسه المحتقر",66,"ر",1,0],["هَذا يَسيرُ إِلى السِرا","رِ وَذا يُقيمُ عَلى التَمامِ",67,"م",1,0],["هَذا يَجودُ بِعَكسٍ ما يَأتي بِهِ","هَذا فَيُحمَدُ ذا وَذاكَ يُلامُ",68,"م",1,0],["هَذا يُغيرُ عَلى القُلُو","بِ وذا يُغيرُ على الجُسومِ",69,"م",1,0],["هَذا يَروقُ وذا يُراقُ وإنَّما","هَذا يَروقُ صَفاؤهُ ليُريقا",70,"ق",2,0],["هذا يومٌ خُصِصتَ فيه مُعَدّاً","منذُ عصرٍ زمانُه بك ماض",71,"ض",1,0],["هذا يسوع ابن العليِّ وعزمه","قد قدَّ أعداه برمحٍ يَشدخ",72,"خ",1,0],["هذا يهوذا بشَّر السريانَ في","يومٍ رماه الموتُ سهماً صائبا",73,"ب",2,0],["هذا يجوّز للفتاة سفوره","ويُبيحُ أن تلقى النساء رِجالها",74,"ل",3,0],["هذا يبالغ في تحفظه وذا","بيراعه لخليله يستوقف",75,"ف",1,0],["هذا يدل بأن ودكُمُ","خلق ترقع خرقه كتبي",76,"ب",2,0],["هذا يُسرُّ بحالٍ لا تَدومُ وذا","يبكي على الفَوتِ من دنياهُ والفَرَطِ",77,"ط",1,0],["هذا يصول بطرفه وبقَدِّه","صولات ذاك برمحه ونصاله",78,"ل",2,0],["هذا يضَنُّ وذاك يَقصُر مالُه","فقد استوى المحظوظُ والمحرومُ",79,"م",1,0],["هذا يمجُّ بما يَخُ","طُّ دَمَاً وذاك يَخُدُّ دَرْجا",80,"ج",2,0],["هذا يراعك وهو من","قصب يفل المشرفيا",81,"ي",2,0],["هذا يفيضُ غعلى العدو ببأسه","نقماً وذاك على الوليّ بجوده",82,"د",2,0],["هذا يذكَّرهُ وذاكَ يشوقُه","وهما يقودانِ الحنينَ فيتبعُ",83,"ع",1,0],["هذا يسلم بالهداية أمره","وسواه يسبح في بحار ضلالة",84,"ه",1,0],["هذا يغازل هذه","كل أصيب بعقله",85,"ل",2,0],["هذا يراقبه وذاك يشي به","وسواهما ينوي الهدى فيضله",86,"ل",2,0],["هذا يغازل هذه وكلاهما","في الموبقات وخزيهم ضوان",87,"ن",1,0],["هذا يجند للجها","د وذاك في الغرما يجند",88,"د",1,0],["هذا ينادي يا أخي","ذاك ينادي يا أبي",89,"ب",2,0],["هذا يرى معنى الحياة تنفسا","وسواه ذلك عنده القتال",90,"ل",1,0],["هذا يقول سل الإمام سواهما","إني أراك قد التمست محالا",91,"ل",2,0],["هذا يميل إِلى الجِيادِ وذَا","أَبداً تراه يَحِنُّ للإِبِل",92,"ل",1,0],["هذا يليق بقدره ان يرتقي","متسما لذرى العلاء الغاربا",93,"ب",2,0],["هَذا يَموتُ بِكُلِّ يَومٍ حَسرَةً","إِذا ذاكَ راحَ بِيَومِهِ المَوعودِ",94,"د",1,0],["هذا يقول غريبٌ ساقه طمعٌ","وذاك حين أريه البرّ يجفوني",95,"ن",2,0],["هذا يطالب في لب له احترقا","وذا يطالب في دمع له اندفقا",96,"ق",2,0],["هذا يراعكَ صَيقلُ الشِعرِ","وحجاك مجمع آيهِ الغُرِّ",97,"ر",1,1],["هَذا يَكون لتَجريبٍ فَمَن عَرَفوا","منه الصَفا وَالوَفا أَدنَوه واِقتربوا",98,"ب",3,0],["هَذا يَفوق بِنَقدِهِ وَبفقهِهِ","لا سيّما التَبويبُ حينَ يُتَرجِمُ",99,"م",1,0],["هذا يفرقع في الضراط وذاكم","يرمي بمثل حجارة المقلاع",100,"ع",1,0],["هذا يتيه بمنصب عال وذا","متكبِّر مترفِّع متغان",101,"ن",1,0],["هذا يلينُ وذا يشدُّ وسائلٌ","يرجو وذو يأس يفيضُ هموما",102,"م",2,0],["هذا يقول علَّهُ اعْ","تَلَّ بداءٍ عصبي",103,"ب",2,0],["هذا يحسنها فقام بها","يغري وذاك يقدم العذرا",104,"ر",2,0],["هذا يبيع لها هدايته","ويبيح ذاك البيض والصفرا",104,"ر",2,0],["هذا يبجل هذا كي يبجله","اكفاء كل لكل بالدها واهي",105,"ي",1,0],["هذا يُغيرُ على هذا وذاكَ على","هذا يُغيرُ وعَينُ الحَزمِ لم تَنَمِ",106,"م",1,0],["هذا يُساقط دُرّاً في الفضاء وذا","يرمي العقيق وكلٌّ يملأُ الأفقا",107,"ق",2,0],["هذا يروح متيم دعوته وذا","حدب عليه يخصه بدعائهِ",108,"ا",3,0],["هذا يقبل منه وجنة خجلت","وذا يغازل طرفا منه مكحول",109,"ل",1,0],["هذا يعاذ به من الشيطان إذ","يعتاذ ذا مس من الشيطان",110,"ن",1,0],["هذا \"يشوط\" بجدّةٍ","ويلوك من حنق سبابه",111,"ب",2,0],["هذا يحرّقه اللهيب فيشتكي","وتروع ذاك الخاطراتُ فيرتمي",112,"م",2,0],["هذا يمدّ إلى الهدايا كفّه","متطاولاً من فوق ظهر الأكبر",113,"ر",1,0],["هذا يفركشه صغير طامع","ويلوذ آخر بالدموع ويفتري",113,"ر",2,0],["هَذا يُضاحك وَقع الطل عَن شَنب","وَذا يُلاحظ عَطف النهر عَن حور",114,"ر",1,0],["هذا يحركه النسيم بلطفه","ففؤاده من حيث هب يقلب",115,"ب",1,0],["هذا يشيرُ بأصبع وعيونُ ذا","ترنو إليه وثغرُ هذا يضحكُ",116,"ك",1,0],["هذا يشير بشرب ابن الغمام ضحىً","وذا يشير عشياً بابنة العنب",117,"ب",1,0],["هذا يقول له قد حزن مثوبة","وذا يقول له قد نلت رضوانا",118,"ن",2,0],["هذا يعيش مفكرا متكفلا","بنجاح ذاك لكي يعيش رغيدا",119,"د",2,0],["هذا يجاوب ذا بأحسن منطق","فإذا شدا الثاني أعاد الأول",120,"ل",1,0],["هذا يرصع درا في مراشفها","وذا يغازل بالأجفان أغزالي",121,"ل",2,0],["هذا يفاخرُ بالجم","الِ وذاك في حسنِ الظواهر",122,"ر",1,0],["هذا يجدّ إلى العلاء مدافعاً","عن قومه بجهاده المتواتر",123,"ر",1,0],["هذا يطير بأفق مصر محلّقا","حرّاً وذاك بأرضها مدفون",124,"ن",1,0],["هذا يبيع وذاك يقبض ما","ربحت بضاعته كما قصدا",125,"د",2,0],["هذا يؤيد قوله بمحمّدٍ","ويلوذ ذلك بالمسيح الفادي",126,"د",2,0],["هذا يراقب في الصباح خليلةً","يرجو إذا طلع النهار وصالها",127,"ل",3,0],["هذا