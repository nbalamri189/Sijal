{"poems":[[88,"صونوا يراع علي في متاحفكم","https://www.aldiwan.net/poem10487.html","البسيط"],[88,"قعدت شعوب الشرق","https://www.aldiwan.net/poem10860.html","مجزوء الكامل"],[88,"ما لي أرى بحر السياسة","https://www.aldiwan.net/poem10920.html","مجزوء الكامل"],[88,"أثنى الحجيج عليك والحرمان","https://www.aldiwan.net/poem68941.html","الكامل"],[95,"طفلان كالأخوين مؤتلفان","https://www.aldiwan.net/poem11268.html","الكامل"],[43,"يامن لقلب لا يطيع","https://www.aldiwan.net/poem42365.html","مجزوء الكامل"],[85,"الملك أصبح علينا","https://www.aldiwan.net/poem54204.html","مجزوء الرمل"],[90,"لا تشك للناس يوما عسرة الحال","https://www.aldiwan.net/poem44974.html","البسيط"],[74,"عد مدنف القلب صبه","https://www.aldiwan.net/poem18272.html","المجتث"],[74,"هنئت بالصوم السعيد","https://www.aldiwan.net/poem18617.html","مجزوء الكامل"],[53,"قل للأمير إذا مثلت له","https://www.aldiwan.net/poem64651.html","أحذ الكامل"],[53,"يدعو الحمام بها الهديل تأسيا","https://www.aldiwan.net/poem64677.html","الطويل"],[53,"خساسة البيهقي والبينِ","https://www.aldiwan.net/poem66485.html","المنسرح"],[93,"إني امرؤ لا شيء يطرب روحه","https://www.aldiwan.net/poem62762.html","عموديه"],[91,"تلغى معاهدة واخرى تعقد","https://www.aldiwan.net/poem44875.html","الكامل"],[91,"الغرب مركبه البخار","https://www.aldiwan.net/poem44884.html","مجزوء الكامل"],[87,"يا قوم عثمان والدنيا مداولة","https://www.aldiwan.net/poem63738.html","البسيط"],[47,"شيد بفضلك مشرف البنيان","https://www.aldiwan.net/poem66837.html","الكامل"],[63,"أسعيد هل لك في زيارة منزل","https://www.aldiwan.net/poem51625.html","الكامل"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[89,"ذهب الصبا وتولت الأيام","https://www.aldiwan.net/poem8289.html","الكامل"],[33,"ألمم بزينب إن البين قد أفدا","https://www.aldiwan.net/poem42567.html","البسيط"],[76,"يانشر عرف الروضة الغناء","https://www.aldiwan.net/poem12828.html","الكامل"],[104,"إخواننا أهل الوفاء","https://www.aldiwan.net/poem32979.html","مجزوء الكامل"],[77,"أرسلت عجما ما تبين","https://www.aldiwan.net/poem69005.html","مجزوء الكامل"],[77,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[50,"ما استكمل اللذات إلا فتى","https://www.aldiwan.net/poem66174.html","السريع"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85575","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147458",""],[108,"ليثان يقتنصان","https://www.poetsgate.com/ViewPoem.aspx?id=179573",""],[92,"بديعة","https://www.poetsgate.com/ViewPoem.aspx?id=179133",""],[90,"لا تشك للناس يوماً عسرة الحال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19556&r=&rc=59",""],[113,"أفديهما أخوين كل منهما","https://www.aldiwan.net/poem16480.html","الكامل"],[119,"صاغ الاكابر بالنظام علومهم","https://www.aldiwan.net/poem40409.html","عموديه"],[121,"أشتات","https://www.aldiwan.net/poem24069.html","الكامل"],[128,"لانت قناتك للمنون","https://www.aldiwan.net/poem23735.html","الكامل"],[132,"لابد من بعد النوى من زورة","https://www.aldiwan.net/poem50645.html","الكامل"],[136,"ما للشجى على برح الغرام يد","https://www.aldiwan.net/poem54853.html","الطويل"],[164,"قد أوعدتني بالزيارة في الكرى","https://www.aldiwan.net/poem58874.html","الكامل"],[164,"هذا التأني وهذا الحلم قد فعلا","https://www.aldiwan.net/poem58892.html","البسيط"],[164,"يزورك العيد والأشواق تحمله","https://www.aldiwan.net/poem58897.html","البسيط"],[164,"عيد حظى بك والأعياد تقتتل","https://www.aldiwan.net/poem58929.html","البسيط"],[164,"شكوى الهدى وتعلق الإسلام","https://www.aldiwan.net/poem59211.html","الكامل"],[173,"ما شئتما يا صاحبي فقولا","https://www.aldiwan.net/poem1656.html",""],[186,"يا أربع الخيف يسقي الماء واديها","https://www.aldiwan.net/poem67024.html","البسيط"],[189,"انظر إلى ما ضمن ال","https://www.aldiwan.net/poem14524.html","مجزوء الكامل"],[189,"شكري لقربك واشتياق","https://www.aldiwan.net/poem14608.html","مجزوء الرمل"],[190,"الليث يزبى وفوق الزبية الحمل","https://www.aldiwan.net/poem43498.html","البسيط"],[190,"أصبحت في حلق المضيق","https://www.aldiwan.net/poem43543.html","مجزوء الكامل"],[190,"ذم الزمان سفاهة يتبشع","https://www.aldiwan.net/poem43639.html","الكامل"],[190,"الورد يحسن في أوائل ورده","https://www.aldiwan.net/poem43648.html","الوافر"],[190,"قد صحح العقل والتمييز والنظر","https://www.aldiwan.net/poem43853.html","البسيط"],[203,"هدم الأنام وجئت انت تشيد","https://www.aldiwan.net/poem45155.html","الكامل"],[203,"ضنت وما أنا لو تشاء ضنين","https://www.aldiwan.net/poem45348.html","الكامل"],[203,"كل يقول شقينا","https://www.aldiwan.net/poem45405.html","المجتث"],[216,"حوادث الدهر فيها البجر والعبر","https://www.aldiwan.net/poem37884.html","البسيط"],[227,"العمر قصر نحن بين رحابه","https://www.aldiwan.net/poem41875.html","الكامل"],[227,"ويل الضعيف من القدير","https://www.aldiwan.net/poem41921.html","مجزوء الكامل"],[233,"ورد الخدود أرق من","https://www.aldiwan.net/poem50811.html","مجزوء الكامل"],[233,"أما الرياض فإنها مسروقة","https://www.aldiwan.net/poem51264.html","الكامل"],[239,"يا خير منتصر لخير إمام","https://www.aldiwan.net/poem31765.html","الكامل"],[239,"يا ابن الدوامي الذي هو عصمة","https://www.aldiwan.net/poem32122.html","الكامل"],[284,"أنا والندى سيفان في","https://www.aldiwan.net/poem60751.html","مجزوء الكامل"],[285,"تجري يمينك في القرطاس سابقة","https://www.aldiwan.net/poem1377.html",""],[286,"أنى اهتدى طيف الحبيب لمرقدي","https://www.aldiwan.net/poem32794.html","الكامل"],[324,"يا حسن حظ الأرثوذكس وحزبها","https://www.aldiwan.net/poem67197.html","الكامل"],[332,"الحمد للَه على ماق ضى","https://www.aldiwan.net/poem54955.html","الكامل"],[370,"هذا غريمي في الغرام","https://www.aldiwan.net/poem17097.html","مجزوء الكامل"],[370,"ومغردين تجاوبا في مجلس","https://www.aldiwan.net/poem17705.html","الكامل"],[375,"يا ذا الذي في خده","https://www.aldiwan.net/poem56926.html","مجزوء الكامل"],[375,"أرأيتني فيما أراك طروقا","https://www.aldiwan.net/poem57281.html","الكامل"],[381,"هاك سمعان وارم بالإنقباض","https://www.aldiwan.net/poem59146.html","الخفيف"],[381,"ما بين جفني والأحبة برزخ","https://www.aldiwan.net/poem66880.html","الكامل"],[381,"شمس تسير مشارقا ومغاربا","https://www.aldiwan.net/poem66953.html","الكامل"],[404,"تشكو الفتاوى","https://www.aldiwan.net/poem6741.html","عموديه"],[407,"قد شف جسمي طول ما أتشوف","https://www.aldiwan.net/poem33640.html","الكامل"],[407,"عجبا يعاتبني بلا ذنب","https://www.aldiwan.net/poem34115.html","الكامل"],[413,"الناس كالطير والدنيا شباكهم","https://www.aldiwan.net/poem31881.html","البسيط"],[420,"هلا نظرت إلى الكئيب الواله","https://www.aldiwan.net/poem54023.html","الكامل"],[461,"لمن الطلول كأنهن رقوم","https://www.aldiwan.net/poem55864.html","الكامل"],[461,"لمن الحمول سلكن فلجا","https://www.aldiwan.net/poem56259.html","مجزوء الكامل"],[467,"أفتى علي لم تزل","https://www.aldiwan.net/poem3121.html","عموديه"],[467,"سل بين بانات الحمى وقدوده","https://www.aldiwan.net/poem3490.html","عموديه"],[480,"دمن حبسن على الغرام وأربع","https://www.aldiwan.net/poem15253.html","الكامل"],[482,"ما القبر إلا ترجمان الماثت","https://www.aldiwan.net/poem36941.html","الكامل"],[482,"فسد الزمان وأهله","https://www.aldiwan.net/poem37028.html","مجزوء الكامل"],[482,"سكن الهوى في القلب حيث أجله","https://www.aldiwan.net/poem37061.html","الكامل"],[482,"أسفي على هذا الزمان وأهله","https://www.aldiwan.net/poem37188.html","الكامل"],[482,"الله أكبر أيها ال","https://www.aldiwan.net/poem37198.html","مجزوء الكامل"],[482,"في الجد أو في اللعب","https://www.aldiwan.net/poem37612.html","مجزوء الرجز"],[482,"الدهر دهر والرجال رجال","https://www.aldiwan.net/poem37622.html","الكامل"],[498,"إن لم يكن هذا الصدود فصالا","https://www.aldiwan.net/poem10260.html","الكامل"],[578,"قد همت بالبدوي في الحلل","https://www.aldiwan.net/poem2886.html","أحذ الكامل"]],"verses":[["هَذا يَحِنُّ إِلى هَذا وَقَد عُقِدَت","مَوَدَّةٌ بَينَهُم مَوصولَةُ السَبَبِ",0,"ب",1,0],["هَذا يَطيرُ مَعَ الخَيا","لِ وَذاكَ يَرتَجِلُ النَوادِر",1,"ر",1,0],["هَذا يَرى رَأيَ العَمي","دِ وَذا يَعُدُّ عَلَيهِ عَدّا",2,"د",2,0],["هَذا يَطيرُ إِلى فَروقَ وَمَن بِها","شَوقاً وَذاكَ إِلى رُبى لُبنانِ",3,"ن",1,0],["هَذَا يَسِيرٌ مِنْ مَعَانٍ جَاوَزَتْ","وُسْعَ امْرِيءٍ وَقَدِ احْتَوَاهَا اسْمَانِ",4,"ن",1,0],["هَذَا يَقُودُ برُّمَتي","قَوداً إِلَيكِ وَذَا يَسُوق",5,"ق",1,0],["هذا يوم يوم جنا","ما لها فالفخر قسيما",6,"م",2,0],["هذا يَميس بأبراد مُفوَّفةٍ","وذا يَخيط شظايا طِمْرِه البالي",7,"ل",2,0],["هذا يفطّر فاه","وذا يفطرُ قلبه",8,"ب",2,0],["هذا يفطر فاه أو","هذا يفطر كبده",9,"د",2,0],["هذا يُبدّي الجلد منك وذا","يسقيك من صفراءَ كالوَرْس",10,"س",1,0],["هذا يُصمِّم في الفُصوص وذاكُمُ","في أيِّما فصٍّ أصاب وأبؤس",11,"س",1,0],["هذا يبيع القريضَ من شرهٍ","ووالديه معاً بفلسين",12,"ن",1,0],["هَذا يُحَرِّكُ بي دَفينَ صَبابَتي","وَيَهُزُّ ذاكَ مَشاعِري وَكَياني",13,"ن",2,0],["هذا يضاجعه الرفاه وذاك في","سغب ينام وقد اقض المرقد",14,"د",1,0],["هذا يثبطه الحجا","ب وذاك يحفزه السفور",15,"ر",1,0],["هَذا يَحُنُّ إِلى البُسفورِ مُحتَضِراً","وَذاكَ يَبكي الغَضا وَالشيحَ وَالبانا",16,"ن",2,0],["هَذا يَفيضُ بِفِضَّةٍ وَبِعَسجَدٍ","وَيَفيضُ ذاكَ بِفاخِرِ المَرجانِ",17,"ن",1,0],["هذا يناولُه النديمُ تحيَّةً","حسُنَت وذا يَحظَى بكأسِ عُقارِ",18,"ر",1,0],["هَذا يُحَبِّرُ مَدحي في الرَّسولِ وَذا","يَتلُو عَلى الناسِ ما أُوحيهِ مِن كَلِمِي",19,"م",2,0],["هَذَا يَحُلُّ وَذَاكَ يَرْحَلُ كَارِهَاً","عَنْهُ فَصُلْحٌ تَارَةً وَخِصَامُ",20,"م",1,0],["هَذا يُقَرِّبُهُ مِنها وَعَبرَتُها","يَومَ الفِراقِ فَما أَرعى وَما اِقتَصَدا",21,"د",2,0],["هَذا يَهُبُّ مَعَ الأَصيلِ عَنِ الرُبى","أَرَجاً وَذَلِكَ عَن غَديرِ الماءِ",22,"ا",2,0],["هذا يُقالُ له الزّعيمُ","كما يُقالُ لذاكَ حُرُّ",23,"ر",1,0],["هذا يُقال لأحمدٍ","إن حصحص الحقُّ المبين",24,"ن",1,0],["هذا يدُلُّهُمُ على ذي عَزْمَةٍ","لا فيهِ تسليمٌ ولا تخذيل",25,"ل",1,0],["هَذا يُفَدّيهِ وَهَذا إِذا","ناوَلَهُ القَهوَةَ حَيّاهُ",26,"ا",2,0],["هَذا يسير على مهل ويشتمني","وَذاكَ يحبو وَذا يعدو وَذا يثب",27,"ب",1,0],["هذا يعالج دلْبَة","والشيخ من حنقَ يصيح",28,"ح",1,0],["هذا يغير على النُّمور، وذاك لا","يُلوي على صيدٍ سوى الغزلان",29,"ن",1,0],["هذا يرفُّ فلا نُحِسُّ بهِ","ويهزُّنا هذا إذا رَفّا",30,"ف",2,0],["هذا يميس بابراد مفوقة","وذا يخيط شظايا طمره البالى",31,"ل",2,0],["هَذا يُجرعهُ مرارة هَجرِهِ","طَوراً وَذا عَذب اللَما يَسقيهِ",32,"ي",2,0],["هذا يهيمه الحطيم بنكة","منها لذي غلط يراد حطام",33,"م",1,0],["هذا يَرِنُّ، وذي رسائِلُها تُعاتِبُ،","أو تُهَدِّدُ بالقَطِيعةِ والنَّدَمْ",34,"م",1,0],["هذا يؤلههه وذاك","يعده في المرسلين",35,"ن",1,0],["هذا يعلُّ وذاكَ ينهلُ تارةً","لا يسأمون عشيةً وصباحا",36,"ح",2,0],["هذا يُسَمِّيهِ قُطباً في مَدَائِحِه","يَوماً وذَا وَتداً مَا القُطبُ وَالوَتِدُ",37,"د",1,0],["هذا يسبّحُ ربَه عجباً وذا","يدعو وذا يثني عليك فيكثرا",38,"ر",2,0],["هذا يشير وذا يثنى عليك وذا","يهدي الدعا رافعاً كفَّيه مُبتهلا",39,"ل",2,0],["هذا يشيرُ وهذا باسطٌ يده","يدعو وذا ناقلُّ تِرباً يقبّلُهُ",40,"ل",2,0],["هذا يصيبُ وذا يخطى بطعنتهِ","وأَنت تضَحكُ ممن مسَّهُ الخجلُ",41,"ل",1,0],["هذا يسبح ذا وهذا قائل","لأخيه أنت الله ذو الإِعظام",42,"م",1,0],["هَذا يَرومُ قِرىً وَذاكَ قِراءَةً","سُمِعَت عَن المُختارِ عَن جِبريلا",43,"ل",2,0],["هَذا يَد اللَه يَسري في أَنامِلِها","سرٌّ مِنَ العَرشِ عَن يمنٍ يُوافيها",44,"ي",3,0],["هذا يزيد وذا يَبي","د كما انْطَوَى ليلٌ بفَجرْ",45,"ر",1,0],["هذا يبوحُ به اللسا","ن وذا يبوح به المآقْ",46,"ق",1,0],["هذا يغُرّ بصوت الشاة من بعد","وذا تخادعُه الآمال والأجلُ",47,"ل",1,0],["هذا يضاف إلى علو","وِ السن في زمن عقوق",48,"ق",1,0],["هذا يموت وذاك يولد بغتة","فالموت يحصد والمهيمن يزرع",49,"ع",1,0],["هذا يذلّ لرخصه فتناله","أيدي الرّذال بما يهون من القطع",50,"ع",1,0],["هذا يقين وهذا ربّما حجبَت","عنه الخطوب وصرف الدهر والحذر",51,"ر",1,0],["هذا يصاول ذا وذاك مراوغ","وجميعهم متثعلبٌ مستأسدُ",52,"د",1,0],["هذا يرنحهُ الأنينُ وذاكَ في","سكراتهِ يهفو بهِ التلحينُ",53,"ن",1,0],["هذا يحيلُ على ذا","وآفةُ الكلِّ جنسُهْ",54,"س",2,0],["هذا يفقدانِ عبدِ اللهِ حلَّ بنَا","وقد تساقطَ من أجفانِنَا الدُّرَرُ",55,"ر",1,0],["هذا يحفُّ بِهِ الغِنى في راحَةٍ","وَيَعُمُّ ذا فَقرٌ جزا أَتعابِهِ",56,"ب",2,0],["هذا يُماشيهِ النَصي","رُ وَذا يُقيمُ بِلا نَصير",57,"ر",1,0],["هذا يُمَجِّد بِالشُرو","رِ وَذا يُهانُ بِلا شُرور",57,"ر",1,0],["هذا يُظَنُّ من اللبا","بِ وَذا يُخالُ من القُشور",57,"ر",1,0],["هذا يُشَمُّ ولا يُضَمْ","مُ وذا يُضَمّ وَيشمَمُ",58,"