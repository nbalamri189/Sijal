{"poems":[[87,"ركزوا رفاتك في الرمال لواء","https://www.aldiwan.net/poem62931.html","الكامل"],[64,"عجنا إلى الجزع الذي مد في","https://www.aldiwan.net/poem52404.html","السريع"],[82,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[164,"هموا بحرب ومناهم به الحلم","https://www.aldiwan.net/poem58920.html","البسيط"],[242,"أهدى لنا الخيري في الروضه","https://www.aldiwan.net/poem19485.html","السريع"],[369,"من كان فوق سراة المجد معتليا","https://www.aldiwan.net/poem60558.html","البسيط"],[466,"شكرا لدهري بالضمير وبالفم","https://www.aldiwan.net/poem15142.html","الكامل"],[469,"عداك وجدي فعد عن عذلي","https://www.aldiwan.net/poem3178.html","عموديه"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27255","الرمل"],[3490,"","https://poetry.dctabudhabi.ae/diwan/poem/199138","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59461","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102964","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102985","البسيط"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44730","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76680","الكامل"],[5956,"أفرغتُ بعض جنونيَ المستاءا","https://www.poetsgate.com/ViewPoem.aspx?id=183958",""]],"verses":[["لَو لاذَ بِالجَوزاءِ مِنهُم مَعقِلٌ","دَخَلوا عَلى أَبراجِها الجَوزاءَ",0,"ا",2,0],["لو لاذتِ الريحُ سَموماً به","لانقلبتْ وهي نَسيمُ السَّحَرْ",1,"ر",1,0],["لولا ذُرَى الحسن الهمامِ وَفَضْلُهُ","ما قَرَّ بي في الخافِقَينِ قَرارُ",2,"ر",1,0],["لولا ذوو الجهل لم يعرف لرب حجا","قدر ولم تتفاوت للورى قيم",3,"م",1,0],["لَوْلاَ ذُبُولٌ يَعْتَرِيهِ جَنىً","قُلْتُ أَيَادِي السَّيِّدِ الْغَضَّهْ",4,"ض",2,0],["لولا ذِمامٌ للدّهْرِ أنت عاقِدُه","ما كنتُ عن ذمّهِ ما عشْتُ مُنْتَهيا",5,"ي",2,0],["لو لاذت الغبراء منه بعصمةٍ","لحمى ثراها أنْ يُداسَ بمنْسمِ",6,"م",1,0],["لولا ذهولي نقعت من ريق","ه بَرْحَ غليلي بمائِهِ الغَلَل",7,"ل",1,0],["لولا ذاتي لم يصح استوى","وبنوري صح ضربُ المثَل",8,"ل",1,0],["لولا ذنوب المسلمين وانهم","ركبوا الكبائر ما لهن خفاء",9,"ا",2,0],["لولا ذَكرت كما ذكر","تُ عشيَّةَ الجَفرينِ دّعدا",10,"د",2,0],["لولا ذراعك ما استطال لهابد","كالنار لولا الربح لم تتوقد",11,"د",1,0],["لولا ذمام بنيك الزهر ما اعتصرت","خمر الغمام ولا دارت على الزهر",12,"ر",1,0],["لَولا ذُنوبُ العَبدِ ما","قَد كانَ ذِكرُ العَفوِ يُكتَبْ",13,"ب",1,0],["لولا ذبول الورد قلت بانه","خدُّ الحبيب عليه صبغ حيائه",14,"ا",3,0],["لولا ذكائي ما استطعت تخلصاً","مما يعيث بخافقي إيذاءا",15,"ا",3,0]]}