{"poems":[[55,"ما ابيض من لون العوارض أفضل","https://www.aldiwan.net/poem29902.html","الكامل"],[32,"ما هاج عينيك من الأطلال","https://www.aldiwan.net/poem29544.html","الرجز"],[53,"أرضى بصورته وصد فأغضبا","https://www.aldiwan.net/poem8652.html","الكامل"],[53,"يا مادح الحقد محتالا له شبها","https://www.aldiwan.net/poem9213.html","البسيط"],[53,"سمعا أبا إسحق إنك ماجد","https://www.aldiwan.net/poem66524.html","الكامل"],[48,"وعظت قوما فلم يرعوا إلى عظتي","https://www.aldiwan.net/poem22466.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[102,"حيرة الساري","https://www.poetsgate.com/ViewPoem.aspx?id=50134",""],[208,"أهل الهوى من إذا ما استعطفوا عطفوا","https://www.aldiwan.net/poem53229.html","البسيط"],[266,"يا ابن المكارم والعلا","https://www.aldiwan.net/poem38148.html","مجزوء الكامل"],[266,"هنئت بالإكرام والإعزاز","https://www.aldiwan.net/poem38261.html","الكامل"],[276,"لكل خطب مهم حسبي الله","https://www.aldiwan.net/poem52129.html","البسيط"],[309,"يا رحمة الله زوري","https://www.aldiwan.net/poem16858.html","المجتث"],[371,"إن كنت تترعه كأسا لمكتئب","https://www.aldiwan.net/poem17314.html","البسيط"],[383,"ما كل يوم ينال المرء ما طلبا","https://www.aldiwan.net/poem415.html",""],[396,"مسكين مسكين من قرب إلى المجزره","https://www.aldiwan.net/poem54438.html","عموديه"],[396,"الحمد لله مسعف كل سائل بسول","https://www.aldiwan.net/poem54537.html","عموديه"],[447,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37991","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38208","البسيط"],[929,"","https://poetry.dctabudhabi.ae/diwan/poem/147642","البسيط"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126152","الرجز"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78173","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49921","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108584","السريع"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114030","الكامل"],[1936,"","https://poetry.dctabudhabi.ae/diwan/poem/105202","الكامل"],[1971,"","https://poetry.dctabudhabi.ae/diwan/poem/97560","المجتث"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109440","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47181","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93530","الكامل"],[2656,"","https://poetry.dctabudhabi.ae/diwan/poem/124603","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132790","السريع"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82828","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91877","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59507","الكامل"],[4767,"السيرة العظيمة","https://www.poetsgate.com/ViewPoem.aspx?id=204762",""],[5385,"قوس المنون بسهم البين قدر رشقا","https://www.poetsgate.com/ViewPoem.aspx?id=144222",""],[5480,"عزوتي","https://www.poetsgate.com/ViewPoem.aspx?id=16305",""],[5845,"لكلِّ خطبٍ مهمٍّ حسبيَ اللهُ","https://www.poetsgate.com/ViewPoem.aspx?id=198425",""],[5956,"أسيرُ النعومة ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182288",""],[6056,"علوم الرجال","https://www.poetsgate.com/ViewPoem.aspx?id=130329",""],[6056,"نصيحة في زمن لايقبل النصيحة","https://www.poetsgate.com/ViewPoem.aspx?id=130520",""],[6146,"حَدَتْ حُداةُ بني يحيى بن عثمانا","https://www.poetsgate.com/ViewPoem.aspx?id=122039",""]],"verses":[["وَالعَفوُ مَكرُمَةٌ فَإِن أَغرى بِها","مُتَغافِلٌ قالَ الرِجالُ مُغَفَّلُ",0,"ل",1,0],["وَالعُفرِ مِن صَريمَةِ الأَدحالِ","غَيَّرَها تَناسُجُ الأَحوالِ",1,"ل",1,0],["والعفوُ منه سجيةٌ لكنَّه","يعفو إذا ما العفو كان الأَصْوبا",2,"ب",2,0],["والعَفْوُ أقربُ للتقوى وإن جُرُمٌ","من مجرمٍ جَرَحَ الأكبادَ أو فَرَثا",3,"ث",2,0],["والعفُو عن جانٍ ملكتَ عقابَهُ","طرفٌ من الإنشاءِ والتَّكْوِينِ",4,"ن",1,0],["وَالعَفوَ آمُلُ مِن رَبّي إِذا حُضِرَت","نَفسي وَفارَقتُ عُوّادي لِأَعوادي",5,"د",2,0],["والعفاريت ذاهبين عراةً","تجفل الوحشُ منهمُ والطيور",6,"ر",1,0],["والعفاريت عليها موكب","يرتمي في موكب شاكي السلاح",7,"ح",1,0],["والعفو بعد اقتدارٍ فِعلُه شَرَفٌ","والهجر بعد اعتذارٍ فِعلُه سَرَفُ",8,"ف",1,0],["والعفو من شيم الكرام","فأن تشأ عفوت عني",9,"ن",2,0],["والعفو عند الأقتدار ولا نري","كالعفو عند الأقتدار مجازي",10,"ز",2,0],["وَالعَفو أَوسع عَن تَقصير من قعدت","به الذنوب فَلَم تنهض مَطاياه",11,"ا",2,0],["والعفو عن كل ذنب","مع صلاح الأمور",12,"ر",1,0],["وَالعَفوُ جودٌ وجودٌ ما لَهُ سَبَبٌ","أَحظى وَأَكرَمُ مِن جودٍ عَلى سَبَبِ",13,"ب",1,0],["والعفو إلا عن الأكفاء مكرمة","من قال غير الذي قد قلته كذباً",14,"ب",2,0],["والعفو والستر في الدنيا وفي الآخره","لي والمحبين وأهل الدار والدائره",15,"ر",2,0],["والعفو عنا وعن أولادنا والأصول","ومن طلب للدعا منا فصل يا وصول",16,"ل",1,0],["والعفو من عاداتهم عن كفوةٍ","والأسد في حلب الوغى جدالها",17,"ل",3,0],["وَالعَفوُ مِن شِيَمِ الكريمِ وَشأنِهِ","وَالصَّفحُ في السّاداتِ خَيرُ مزيّةِ",18,"ه",1,0],["وَالعَفوُ عادَتُكَ الحَميدةُ في الوَرى","وَيُعابُ تَركُ العادَةِ المَحمودَةِ",18,"ه",1,0],["وَالعَفو يُمدَحُ حقّاً عِندَ مَقدِرةً","إِذ تِلكَ تُثبِتُهُ وَالعَجزُ يَنفيهِ",19,"ي",2,0],["والعفو عندَ لئيمِ الطَّبْعِ مَفسَدَةٌ","تَطْغى، ولكنَّه عند الكريم يَدُ",20,"د",1,0],["والعفو عما قد مضى","والطهر بعد الدنس",21,"س",1,0],["وَالعَفو عَن كَعب أَجل كَرامة","إِذ خَصَهُ في بُردة الأَرفاد",22,"د",1,0],["والعفاةُ المجاورونَ لديه","أبداً مُنه في زمانٍ خصيبِ",23,"ب",1,0],["والعفو ما نرجوه منه فما","يسر خلق اللَه عزل الفؤاد",24,"د",1,0],["والعفوَ عمَّن قد جَنَى والحِلم والتِّ","رحابَ والخُلُقُ الجميل وأكثرا",25,"ر",2,0],["والعفو اجدر بالكريم وعبدكم","قد أمّ باب رجائكم كي يعتقا",26,"ق",2,0],["والعفو أنتم أهله واليكم","ينمى وأنتم كنهه ان أطلقا",26,"ق",2,0],["وَالعفوُ أحسنُ شيء","يَكون عند اِقتدارِ",27,"ر",1,0],["والعفو يرجى للمقصر حيثما","يأتي مقراً للكريم بعذره",28,"ر",2,0],["والعَفْوُ عمّا قد جَنَيْتُ مُؤَمَّلٌ","حيثُ اجْترَأْتُ على عَلِّي مكان",29,"ن",1,0],["وَالعَفو أَقرَب لِلتُقى مِن قادر","لَو شاءَ عَفى أَرضهم وَترابها",30,"ب",3,0],["والعفو عن زلة الاخوان سيرتنا","والبلا لا الاثم والكصرى أو مانا",31,"ن",2,0],["والعفو والغفران في زورته","فالبشر للوافد والزائر",32,"ر",1,0],["وَالعَفوُ أَنكرتُموهُ وَهوَ شيمَتُكُم","وَالصَفحُ لَفظٌ لديكُم مُبهَمُ المَعنى",33,"ن",2,0],["وَالعفو بعد الإقتدار محببٌ","وَالحلم حزمٌ إن أمنت عواقبه",34,"ب",2,0],["والعفرُ عاطفةٌ على أطْلائها","خُرقاً قضْينَ بأمنِها أيامُها",35,"م",3,0],["والعفيف الشريف في النار يَصلَى","حرَّ ضحضاحها سقيماً شقيا",36,"ي",2,0],["والعفو لا زال منهلا عليك مدى","الزمان ما البرق في افق العلا برقا",37,"ق",2,0],["والعفو لا صاغ قولي عذاريب","كلن له المغوار عزوة ولابه",38,"ب",2,0],["والعفوُ أوسعُ منْ تقصيرِ منْ قعدتْ","بهِ الذنوبُ فلمْ تنهضْ مطاياهُ",39,"ا",2,0],["‏والعفوُ من ربِّ الضحى متوَقَّعٌ","‏ ‏ عن ذنب كلِّ مُتَيَّمٍ يتفانى",40,"ن",2,0],["والعفو عند المقدرة شيمة رجال","لاهيب لا خوف ٍ ، ولا قل حيلة",41,"ل",2,0],["والعفو ، عند المقدرة ، فعل رجّال","تفخر به الأنجال ،، وكل الحفايد",42,"د",1,0],["والعفوُ عن زلَّة الإخوان سيرتُنا","والبِرُّ لا الإثمُ والكسريُّ أوصانا",43,"ن",2,0]]}