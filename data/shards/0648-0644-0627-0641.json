{"poems":[[53,"يا طائر البان غريدا على فنن","https://www.aldiwan.net/poem29732.html","البسيط"],[53,"مسيري إلى ليل الشباب ضلال","https://www.aldiwan.net/poem29909.html","الطويل"],[53,"ألوي حيازيمي عليك تحرقا","https://www.aldiwan.net/poem29950.html","الطويل"],[71,"ذراها إذا رامت معاجاً إلى الحمى","https://www.aldiwan.net/poem4002.html","الطويل"],[88,"يقولون في الإسلام ظلما بأنه","https://www.aldiwan.net/poem45024.html","الطويل"],[23,"لقد علمت بنو النجار","https://www.aldiwan.net/poem21437.html","الوافر"],[64,"لقد أعجبني الوجد","https://www.aldiwan.net/poem67568.html","الهزج"],[51,"يهنأ بالإفطار قوم لأنهم","https://www.aldiwan.net/poem7938.html","الطويل"],[51,"ألا نسيا نفسي حديث البلابلِ","https://www.aldiwan.net/poem65958.html","الطويل"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[51,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[43,"لا يحزن الله الأمير فإنني","https://www.aldiwan.net/poem9454.html","الطويل"],[43,"بغيرك راعيا عبث الذئاب","https://www.aldiwan.net/poem9459.html","الوافر"],[45,"أبا جعفر ليس فضل الفتى","https://www.aldiwan.net/poem10910.html","المتقارب"],[45,"تعست فما لي من وفاء ولا عهد","https://www.aldiwan.net/poem63524.html","الطويل"],[45,"وأكثرت غشيان المقابر زائرا","https://www.aldiwan.net/poem63570.html","الطويل"],[28,"لقد طلبت بالذحل غير ذميمة","https://www.aldiwan.net/poem5192.html","الطويل"],[49,"أجاب الله داعيك","https://www.aldiwan.net/poem64262.html","الهزج"],[69,"أعوذ بالله ربي","https://www.aldiwan.net/poem29247.html","عموديه"],[81,"شكا بالعتب مضناك","https://www.aldiwan.net/poem61407.html","الهزج"],[75,"بأكثبة الدهناء منهم منازل","https://www.aldiwan.net/poem69024.html","الطويل"],[46,"أتاني بإسناده مخبر","https://www.aldiwan.net/poem23265.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85835","الرجز"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16637","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55195","الطويل"],[106,"شبح الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=179421",""],[90,"الشاعرية بين البؤس والنعيم","https://www.poetsgate.com/ViewPoem.aspx?id=179134",""],[90,"أطِل مكثاً","https://www.poetsgate.com/ViewPoem.aspx?id=179234",""],[45,"وأكثرْتُ غِشْيَانَ المَقابرِ، زَائِراً","https://www.poetsgate.com/ViewPoem.aspx?id=31255",""],[99,"ورقة إلى القارىء","https://www.poetsgate.com/ViewPoem.aspx?id=17760",""],[94,"حنين الغريب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66297&r=&rc=15",""],[115,"الا يا من به يجلى الظلام","https://www.aldiwan.net/poem40599.html","عموديه"],[120,"يا ليتني لو يصح لي أمل","https://www.aldiwan.net/poem49371.html","المنسرح"],[126,"للحب دين وللأشواق باقينا","https://www.aldiwan.net/poem794.html",""],[128,"أنفق من المال ما استطعت فذو","https://www.aldiwan.net/poem50577.html","المنسرح"],[128,"قضى اللّه فيما بيننا بقرابة","https://www.aldiwan.net/poem50668.html","الكامل"],[132,"أبعد الشيب تبكى بالديار","https://www.aldiwan.net/poem54834.html","الوافر"],[142,"يروح ويغدو علينا الحمام","https://www.aldiwan.net/poem58402.html","المتقارب"],[160,"على غيرك البهتان والزور ينفق","https://www.aldiwan.net/poem58945.html","الطويل"],[169,"أرتها المآقي ما تكن الجوانح","https://www.aldiwan.net/poem1611.html",""],[169,"تجاف عن العتبى فما الذنب واحد","https://www.aldiwan.net/poem1614.html",""],[184,"إذا ما وردنا ماء مدين أشرقت","https://www.aldiwan.net/poem23816.html","عموديه"],[186,"تكارير السنين حنت قناتي","https://www.aldiwan.net/poem43491.html","الوافر"],[186,"يفوت العطاش المزن وهي حوافل","https://www.aldiwan.net/poem43873.html","الطويل"],[189,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[189,"مقام أجل الرسل أعلى وأعظم","https://www.aldiwan.net/poem35106.html","الطويل"],[198,"ألا عظة إن الزمان خؤون","https://www.aldiwan.net/poem51871.html","الطويل"],[199,"صبا للقصور وغزلانها","https://www.aldiwan.net/poem45545.html","المتقارب"],[204,"لسان الفتى حتف الفتى حين يجهل","https://www.aldiwan.net/poem53017.html","الطويل"],[235,"أيا السيد ما ساع","https://www.aldiwan.net/poem32026.html","الهزج"],[252,"أما وجفونك المرضى الصحاح","https://www.aldiwan.net/poem1418.html",""],[261,"ترى أي داء من فراقك أعضل","https://www.aldiwan.net/poem38214.html","الطويل"],[270,"عديني أفي الدنيا أقل من الوعد","https://www.aldiwan.net/poem35448.html","الطويل"],[271,"ولا في بقاع الارض حيا وميتا","https://www.aldiwan.net/poem52081.html","الطويل"],[275,"ألما بأشلاء العلى والمكارم","https://www.aldiwan.net/poem25526.html","الطويل"],[280,"هو الرسم لو أغنى الوقوف على الرسم","https://www.aldiwan.net/poem60704.html","الطويل"],[280,"سأشكر ما مننت به ومثلي","https://www.aldiwan.net/poem60758.html","الوافر"],[282,"إلمام طيف شنيب الثغر ألماه","https://www.aldiwan.net/poem32309.html","البسيط"],[301,"جلبنا الخيل من جنبي أريك","https://www.aldiwan.net/poem2060.html","الوافر"],[320,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[353,"مطالع سعد قد تجلت كواكبه","https://www.aldiwan.net/poem40814.html","الطويل"],[364,"سواء تدان منهم وتناء","https://www.aldiwan.net/poem61015.html","الطويل"],[377,"وشاحك فخر في الأنام جليل","https://www.aldiwan.net/poem59286.html","الطويل"],[377,"نصحتك نصحا قل من شأنه النصح","https://www.aldiwan.net/poem66888.html","الطويل"],[391,"عسى فرج من المولى القريب","https://www.aldiwan.net/poem54637.html","عموديه"],[400,"الإبحار","https://www.aldiwan.net/poem6784.html","عموديه"],[402,"نقضت عهودي فاسترحت من الهوى","https://www.aldiwan.net/poem46454.html","الطويل"],[403,"عجبت لقوم ينسبون مقالة","https://www.aldiwan.net/poem33933.html","الطويل"],[403,"إلام أرى عاذلي في تعب","https://www.aldiwan.net/poem34155.html","المتقارب"],[406,"أبا الفضل طال الليل أم خانني صبري","https://www.aldiwan.net/poem50177.html","الطويل"],[409,"أما في الهوى حاكم يعدل","https://www.aldiwan.net/poem32553.html","المتقارب"],[416,"ألا من مبلغ عني نقيبا","https://www.aldiwan.net/poem53906.html","الوافر"],[416,"ما مات من بعد عبد الواحد الجود","https://www.aldiwan.net/poem53941.html","البسيط"],[432,"بعينيه شكري لا بكأس عقاره","https://www.aldiwan.net/poem12787.html","الطويل"],[437,"أشاقتك من أطلال ليلى معالم","https://www.aldiwan.net/poem2587.html","الطويل"],[437,"سلام عليكم والتحية تكتب","https://www.aldiwan.net/poem2601.html","الطويل"],[439,"دعي عزمات المستضام تسير","https://www.aldiwan.net/poem34841.html","الطويل"],[439,"ولا في سرور العيد نحن مهنوه","https://www.aldiwan.net/poem34860.html","الطويل"],[458,"تموق الليالي فيكم ثم تعقِل","https://www.aldiwan.net/poem55908.html","الطويل"],[458,"خفف بذات البان من أثقالها","https://www.aldiwan.net/poem55951.html","الرجز"],[458,"أروم الوفاء الصعب بالمطلب السهل","https://www.aldiwan.net/poem56064.html","الطويل"],[458,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[461,"حماك حمى الرحمن من كل حادث","https://www.aldiwan.net/poem16151.html","الطويل"],[464,"لكم من سقامي بالهوى شاهد عدل","https://www.aldiwan.net/poem3604.html","عموديه"],[477,"كفاك على وجدي دليلا مدامعي","https://www.aldiwan.net/poem15237.html","الطويل"],[505,"القريض","https://www.aldiwan.net/poem56768.html","الوافر"],[538,"وجمرة الوجنة ذاب","https://www.aldiwan.net/poem47912.html","عموديه"],[551,"أقلا فشأنكما غير شاني","https://www.aldiwan.net/poem47155.html","المتقارب"],[551,"دع الجزع عن يمناك لا عن شمالكا","https://www.aldiwan.net/poem47348.html","الطويل"],[551,"ألم تسأل الطلل الدارسا","https://www.aldiwan.net/poem47752.html","المتقارب"],[551,"أما ترى الربع الذي أقفرا","https://www.aldiwan.net/poem47804.html","السريع"],[551,"يا رب ليل أخذنا فيه منيتنا","https://www.aldiwan.net/poem47809.html","البسيط"],[558,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[575,"ألا فانتبه من أفقها طلع الفجر","https://www.aldiwan.net/poem3064.html","الطويل"]],"verses":[["وَلا فُجِعتَ وَقَد سارَت رَكائِبُهُم","يَومَ الغَميمِ بِغِزلانِ كَغِزلانِ",0,"ن",1,0],["وَلا فَرقَ بَيني في الكَلامِ وَبَينَهُم","بِشَيءٍ سِوى أَنّي أَقولُ وَقالوا",1,"ل",3,0],["وَلا في مَهاوي الأَرضِ إِن رُمتَ مَهبَطاً","وَلا في مَراقي الجَوِّ إِن رُمتَ مُرتَقى",2,"ق",2,0],["وَلا فَرحَةُ الإِثراءِ مِن بَعدِ فاقَةٍ","عَلى قَلبِ مَن نالَ في الدَهرِ مَغنَما",3,"م",2,0],["ولا فخرَ للإنسان إلاّ بسعيه","ولا فضلَ إلا بالتُقى والتكرُّم",4,"م",1,0],["وَلا في الفَرعِ مِن أَبناءِ عَمروٍ","وَلا في فَرعِ مَخزومِ الكِرامِ",5,"م",1,0],["وَلا فَوقٌ وَلا تَحتٌ","وَلا قَبلٌ وَلا بَعدُ",6,"د",1,0],["ولا فاتهُ في الفطر صومٌ لأنهُ","مواصِلُ صومٍ عُقْبَتاهُ سَواءُ",7,"ا",2,0],["ولا فاته طولُ الأناةِ بفرصةٍ","إذا ضاع أمر العاجز المتخاذلِ",8,"ل",1,0],["ولا فَهّةٌ من عاجزٍ متخاذلٍ","إذا نابه يوماً من الأمر مُعْظَمُ",9,"م",1,0],["ولا في عُقدةٍ منه انحلالٌ","ولا في عُروةٍ منه انفصامُ",10,"م",1,0],["وَلا فَضلَ فيها لِلشَجاعَةِ وَالنَدى","وَصَبرِ الفَتى لَولا لِقاءُ شَعوبِ",11,"ب",1,0],["وَلا في فَقدِهِنَّ بَني كِلابٍ","إِذا أَبصَرنَ غُرَّتَكَ اِغتِرابُ",12,"ب",1,0],["وَلا في فَراهَةِ بِرذَونِهِ","وَلا في نَظافَةِ أَثوابِهِ",13,"ب",2,0],["وَلا فِيَّ خَيرٌ يَرتَجيهِ مَعاشِري","وَلا أَنا ذو فِعلٍ سَديدٍ وَلا رُشدِ",14,"د",1,0],["وَلا فَضلَ عِندَ الأَرمَنِيِّ يَعُدُّهُ","سِوى رَنَّهُ ثَورٌ سَمينٌ لِجازِرِ",15,"ر",1,0],["وَلا في كُلَيبٍ إِن عَرَتهُم مُلِمَّةٌ","كَريمٌ عَلى ما أَحدَثَ الدَهرُ صابِرُ",16,"ر",1,0],["وَلا فاخِتَةَ النَخلِ","مِنَ الطاوّسِ وَالديكِ",17,"ك",1,0],["ولا فدى بدخيره","دولابَهُ الطيارُ",18,"ر",1,0],["وَلا في المَنِّ وَالسَلوى","سُلُوٌّ عَن ثَناياك",19,"ك",1,0],["ولا في بلاد الله غيرك معقل","لحر إذا ما قيل أين المعاقل",20,"ل",1,0],["وَلا فَضلَ فينا وَلَكِنَّها","حُظوظٌ مِنَ الفَلَكِ الصاقِلِ",21,"ل",1,0],["ولا فتى قد قتل","النفس البراء أو غصب",22,"ب",1,0],["ولا فِتْنَةٌ طائِيّةٌ عامِرِيّةٌ","يُحَرَّقُ في نيرانِها الجَعدُ والسَّبْطُ",23,"ط",1,0],["ولاَ فِكْرةٌ نَقَّادة وَمَهَارَةٌ","حِسَابِيَّةٌ تعْتَدٌّ فِي الرَّيْبِ فَيْصلاَ",24,"ل",2,0],["ولا في قوانين البرية رحمة","ولا شيء في الدنيا يقال له الحب",25,"ب",1,0],["ولا فرقَ إلاّ أنَّ هذا مراوغٌ","كثيرُ مُداجاهٍ وهذا مجاهر",26,"ر",1,0],["ولا في أنْ يِمِسَّ ذويكَ ضُرٌّ","يَحيقُ بهمْ ومَظْلَمةٌ تَحيف",27,"ف",1,0],["ولا فَضْلَ عِنْدَ الأرْمَنيّ يَعُدُّهُ","سِوَى أنّهُ ثَوْرٌ سَمِينٌ لجَازِرِ",28,"ر",1,0],["ولا فَقَع الثَدْيُ أو عربَدَا","صنعتُكَ من أضلعي .. لا تكنْ",29,"ن",1,0],["ولا فوق نعماء المحبّة جنّة","ولا فوق أحقاد النّفوس جحيم",30,"م",1,0],["ولا فرس تثور ولا حصان","ولا سرح لدي ولا لجام",31,"م",1,0],["ولا فؤادي كالوكر مضطرباً","تجني عليه بلحظها المقل",32,"ل",1,0],["ولا في ثرى الرولة الفيحاء طاب لنا","حسن المقام وحسن الحور والعينا",33,"ن",2,0],["ولا فقيرٌ تراه ذَا عُسُر","يلقَاهُ إلا كساهُ أو نفعهْ",34,"ع",2,0],["ولا فَقَدَت أفواهُنا ذكركم ولا","ذكرناكمُ إلا بخير ونُطْنِبُ",35,"ب",1,0],["وَلاَ في جَوبِكَ الفَلَواتِ مَهمَا","جُفُونُ اللَّيلِ قَد كُحِلَت ِبِقَارِ",36,"ر",1,0],["ولا فرقَ ما بيننا في القيا","سِ إلاّ العقولُ وهذا الكلامُ",37,"م",1,0],["ولا في مدى عمري اتساع لنأيه","وبعدٌ له أطوى الفيافي وأعنق",38,"ق",1,0],["وَلا فَلَّ صَبري ما لَقيتُ وَإِنَّني","لَأَلوي عَلى اللّأواءِ جَلدٌ مُكافِحُ",39,"ح",1,0],["وَلا في بَني فَضلٍ بَخيلٌ وَإِنَّهُم","إِذا اِغبَرَّتِ الآفاقُ غُرٌّ أَماجِدُ",40,"د",1,0],["ولا فانيا عن زينة الزخرفا من","هوائية الدنيا بغشية غفلتي",41,"ت",2,0],["ولا فاتقا رتق الغشاوات عن قلي","ب من كدرات الجسم في أصل طينتي",41,"ت",2,0],["ولا فضل من أثخنته صوارم","بألحاظ ليلاه أغثني بعطفة",41,"ه",1,0],["ولا فرس ولا عير وثو","ولا بغل يعدّد في البغال",42,"ل",1,0],["ولا فقر إلا سوف يدركه الغنى","فإمّا بيسر المال أو بقوى المثري",43,"ر",2,0],["وَلا فاعلٌ للخيرِ والشرّ غيره","وَمِن أدَبٍ لَسنا له ننسبُ الشرّا",44,"ر",2,0],["ولا فرقَ بين المدركينَ زمانَهُ","وَمَن سمِعوا في سائر الدهر شانهُ",45,"ه",1,0],["ولا فرحاً إلا وأَعقبَ يَوْمَهُ","من الدهر نَوْحٌ دائمٌ وشجون",46,"ن",1,0],["ولا في الشعورِ كموجِ السحابِ","إذا ما تراختْ على بانِها",47,"ن",3,0],["ولا في الحواجبِ مثلَ الهلالِ","ولا في العيونِ وأجفانِها",47,"ن",3,0],["ولا في جمالِ زهورِ الرياضِ","إذا اختلْنَ في ثوبِ نيسانها",47,"ن",3,0],["ولا فضل في الحسنى إلى من يمنُّها","بلى عند مَن يزكو لديه التفضُّل",48,"ل",1,0],["وَلا فيكَ بِحَمدِ اللَ","هِ لا هَزلٌ وَلا جِدُّ",49,"د",1,0],["وَلا فَلَّ المَلامُ غرارَ غيىٍ","وَلا ثَلَمَ العِتابُ شَبا جِماحي",50,"ح",2,0],["ولا فقد الأقوام منك سميدعا","يقول إذا اشتد الخصام ويفعل",51,"ل",1,0],["ولا فلكيٌّ للكواكب راصدٌ","ولي مرصدٌ يُبنى على جبلِ الهند",52,"د",1,0],["وَلا في بقاع الارض حيا وَميتا","وَلا فوق آفاق السَماء كاحمد",53,"د",1,1],["ولا فارَقوا والمَوْتُ يُتْلِعُ جِيدَهُ","بِحَيْثُ التَقَى الجَمْعَانِ صِدْقَ العَزائِمِ",54,"م",1,0],["وَلا فَرْقَ فِيها بَيْنَ عَزْمٍ وَصارِمٍ","كَأَنَّ الظُّبى فِيها طُبِعْنَ مِنَ الْعَزْمِ",55,"م",1,0],["وَلا فُوْقَ الْغِنى جُودٌ فَحَسْبِي","كَفى بِالْمَحْلِ عارِضُكَ الْمَطِيرُ",56,"ر",1,0],["وَلا فَرائِدَ إِلّا مِن عِبارَتِهِ","وَلا فَوائِدَ إِلّا مِن عَطاياهُ",57,"ا",2,0],["وَلا فَضحُ الفُضُوحِ وَلا شُيَيمٌ","وَلا سُلْماكُمُ صَمِّي صَمامِ",58,"م",1,0],["وَلا فَتى كَعَلي ذي الوَلاءِ فَلَو","صَفا لَهُ الوَقتُ لَاِمتازَت خِلافَتُهُ",59,"ت",2,0],["وَلا فتئ الإِقبال بالعزّ مُقبِلاً","إِلى بابِهِ العالي تُحَثُّ جَنائِبُه",60,"ب",2,0],["ولا فَخْرَ عندي في وجُوهٍ وضيئةٍ","إذا كانتِ الأخلاقُ غيرَ وِضاء",61,"ا",2,0],["ولا فضل إلا وهو فينا متمَّمٌ","ونحن بإحكام الأمور كهول",62,"ل",1,0],["ولا فرق بين الإبن في كل شهوةٍ","وبين أبيه حيث ضمهما سفح",63,"ح",1,0],["ولا فزع ولا جزع وضر","ولا بلوى ولا هم شغيب",64,"ب",1,0],["ولا فيهِ موجٌ ولا لُجَّةٌ","ولا أثرٌ فيه من غارقِ",65,"ق",1,0],["ولا في وصالٍ منكَ أطلبُ شافعاً","ولا رُسُلي تأتي إليكَ ولا كتبي",66,"ي",1,0],["ولا فتك لرجس الشقي ابن عقبة","بطيبة فَتْك المسلمين بخيبر",67,"ر",1,0],["ولا فرج عاجل منقذ","لقلب غدا في بحار الكُرَب",68,"ب",1,0],["وَلا فَرقَ فيما بَينَنا غَيرَ أَنَّنا","بِمَسِّ الأَذى نَدري وَأَنَّكَ لا تَدري",69,"ر",2,0],["ولا فيهِ عاطِفَةٌ تُرتَجى","وكلُّ بَلائِي بهِ مُشكِلُ",70,"ل",1,0],["ولا فارقتُ منه هاشميًّا","حليف الجود وضَّاح الجبين",71,"ن",1,0],["ولا فقدنا من الدُّنيا مكارمه","وفي ذراريه ذاك الفضل موجود",72,"د",1,0],["ولا فضلَ في نيلِ العُلا دون بذلِه","كذا الماءُ يَرْوي من صدًى في قرارِه",73,"ر",2,0],["ولا فارق التقديس أرضا ثوى بها","ولا رحمة واللّه إذ ذاكَ راحم",74,"م",1,0],["ولا فخر في الدنيا بغير فضائل","يمدّ رواقُ المجد منها ويضربُ",75,"ب",1,0],["ولا فَقَدَتْ أَيَّامَكَ الغُرَّ أَنفُسٌ","حياتُكَ أَعيادٌ لهم وسُرورُ",76,"ر",1,0],["وَلا فِي سرورِ العيدِ نحنُ مُهَنُّوهُ","ولا فِي سريرِ الملكِ نَحْنُ مُحَيُّوهُ",77,"و",2,1],["ولا فاتني هذا الذَّرا الرحبُ موطناً","لعزِّي ولا هذا البساطُ المقبَّلُ",78,"ل",1,0],["ولافت الأيام ورقابُها","قد ذهبتْ عَرْضاً مع انفتالها",79,"ل",3,0],["ولا فطنوا أن يجسلوا ووفودُهم","يميسون في الألطاف منهم وفي الفضل",80,"ل",1,0],["ولا فرِحتْ أقيالُ آلِ أميَّةٍ","بما سَيَّرتْ فيها تميمٌ وتَغلِبُ",81,"ب",1,0],["ولا فارقتْ تلك المناقبَ صِحَّةٌ","مهنَّأةٌ ما الْتَذَّ بالماءِ شارِبُهْ",82,"ب",2,0],["ولا فلتِ العيسُ الفلاة ولا ارتمتْ","إلى نحوها كومُ الجديليَّة البذل",83,"ل",1,0],["ولا فارقتْ ظِلَّ الأراكِ ولا غدتْ","مُحَلأَّةً عن طَيبِّاتِ المشارعِ",84,"ع",1,0],["ولا في حانةٍ فيها القريضُ","يُقدّمُ مع خُمورٍ وسجائرْ",85,"ر",1,0],["ولا في طُرقةٍ فيها القريضُ","مهانٌ تحت أقراصِ الفطائرْ",85,"ر",1,0],["ولا في مسرحٍ نسجَ الحَكايا","على سِيَرِ البَغايا لا الحرائِرْ",85,"ر",1,0],["ولا في مَجْمعٍ عدَّ القريضَ","إذا طالَ الوُلاةَ منَ الكبائرْ",85,"ر",1,0],["ولا فيْ مُحتوى كُتُبِ الغِناءِ","أو الشّعْرِ أو الفنّ المعاصِرْ",85,"ر",1,0],["ولا فِرِندٍ صارِمٍ","عَضبٍ سليلِ اليَمَنِ",86,"ن",1,0],["ولا فارقَتْكَ ضُروبُ السّرورِ","ولا صارمَتْك فنونُ التَّهاني",87,"ي",1,0],["ولا فِكْرَ فيمن صمَّ لمّا دعوتَه","وربُّ الورى طرّاً مجيب دعائكا",88,"ك",2,0],["ولا فَرَستْكَ نيوبُ الزّمانِ","فقد كنتَ دهراً لها فارسا",89,"س",2,0],["وَلا فَريتم أدَماً مرّةً","ولم تكونوا قطّ ممّن فرى",90,"ر",2,0],["ولا فَرَتْ يدُها نحراً فتتركَهُ","إلّا وقد نُشرتْ منه نواشرُهُ",91,"ر",2,0],["ولا فرق إلا بالأفول ألم تكن","إذا لا أحب الآفلين مقالتي",92,"ي",1,0],["ولا فرقَ لولا اللَّونُ بين سِلاَحِهم","فآراؤُه بِيضٌ ورَاياتُهم صُفْرُ",93,"ر",1,0]]}