{"poems":[[53,"يا طائر البان غريدا على فنن","https://www.aldiwan.net/poem29732.html","البسيط"],[53,"مسيري إلى ليل الشباب ضلال","https://www.aldiwan.net/poem29909.html","الطويل"],[53,"ألوي حيازيمي عليك تحرقا","https://www.aldiwan.net/poem29950.html","الطويل"],[71,"ذراها إذا رامت معاجاً إلى الحمى","https://www.aldiwan.net/poem4002.html","الطويل"],[88,"يقولون في الإسلام ظلما بأنه","https://www.aldiwan.net/poem45024.html","الطويل"],[23,"لقد علمت بنو النجار","https://www.aldiwan.net/poem21437.html","الوافر"],[64,"لقد أعجبني الوجد","https://www.aldiwan.net/poem67568.html","الهزج"],[51,"يهنأ بالإفطار قوم لأنهم","https://www.aldiwan.net/poem7938.html","الطويل"],[51,"ألا نسيا نفسي حديث البلابلِ","https://www.aldiwan.net/poem65958.html","الطويل"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[51,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[43,"لا يحزن الله الأمير فإنني","https://www.aldiwan.net/poem9454.html","الطويل"],[43,"بغيرك راعيا عبث الذئاب","https://www.aldiwan.net/poem9459.html","الوافر"],[45,"أبا جعفر ليس فضل الفتى","https://www.aldiwan.net/poem10910.html","المتقارب"],[45,"تعست فما لي من وفاء ولا عهد","https://www.aldiwan.net/poem63524.html","الطويل"],[45,"وأكثرت غشيان المقابر زائرا","https://www.aldiwan.net/poem63570.html","الطويل"],[28,"لقد طلبت بالذحل غير ذميمة","https://www.aldiwan.net/poem5192.html","الطويل"],[49,"أجاب الله داعيك","https://www.aldiwan.net/poem64262.html","الهزج"],[69,"أعوذ بالله ربي","https://www.aldiwan.net/poem29247.html","عموديه"],[81,"شكا بالعتب مضناك","https://www.aldiwan.net/poem61407.html","الهزج"],[75,"بأكثبة الدهناء منهم منازل","https://www.aldiwan.net/poem69024.html","الطويل"],[46,"أتاني بإسناده مخبر","https://www.aldiwan.net/poem23265.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85835","الرجز"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16637","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55195","الطويل"],[106,"شبح الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=179421",""],[90,"الشاعرية بين البؤس والنعيم","https://www.poetsgate.com/ViewPoem.aspx?id=179134",""],[90,"أطِل مكثاً","https://www.poetsgate.com/ViewPoem.aspx?id=179234",""],[45,"وأكثرْتُ غِشْيَانَ المَقابرِ، زَائِراً","https://www.poetsgate.com/ViewPoem.aspx?id=31255",""]],"verses":[["وَلا فُجِعتَ وَقَد سارَت رَكائِبُهُم","يَومَ الغَميمِ بِغِزلانِ كَغِزلانِ",0,"ن",1,0],["وَلا فَرقَ بَيني في الكَلامِ وَبَينَهُم","بِشَيءٍ سِوى أَنّي أَقولُ وَقالوا",1,"ل",3,0],["وَلا في مَهاوي الأَرضِ إِن رُمتَ مَهبَطاً","وَلا في مَراقي الجَوِّ إِن رُمتَ مُرتَقى",2,"ق",2,0],["وَلا فَرحَةُ الإِثراءِ مِن بَعدِ فاقَةٍ","عَلى قَلبِ مَن نالَ في الدَهرِ مَغنَما",3,"م",2,0],["ولا فخرَ للإنسان إلاّ بسعيه","ولا فضلَ إلا بالتُقى والتكرُّم",4,"م",1,0],["وَلا في الفَرعِ مِن أَبناءِ عَمروٍ","وَلا في فَرعِ مَخزومِ الكِرامِ",5,"م",1,0],["وَلا فَوقٌ وَلا تَحتٌ","وَلا قَبلٌ وَلا بَعدُ",6,"د",1,0],["ولا فاتهُ في الفطر صومٌ لأنهُ","مواصِلُ صومٍ عُقْبَتاهُ سَواءُ",7,"ا",2,0],["ولا فاته طولُ الأناةِ بفرصةٍ","إذا ضاع أمر العاجز المتخاذلِ",8,"ل",1,0],["ولا فَهّةٌ من عاجزٍ متخاذلٍ","إذا نابه يوماً من الأمر مُعْظَمُ",9,"م",1,0],["ولا في عُقدةٍ منه انحلالٌ","ولا في عُروةٍ منه انفصامُ",10,"م",1,0],["وَلا فَضلَ فيها لِلشَجاعَةِ وَالنَدى","وَصَبرِ الفَتى لَولا لِقاءُ شَعوبِ",11,"ب",1,0],["وَلا في فَقدِهِنَّ بَني كِلابٍ","إِذا أَبصَرنَ غُرَّتَكَ اِغتِرابُ",12,"ب",1,0],["وَلا في فَراهَةِ بِرذَونِهِ","وَلا في نَظافَةِ أَثوابِهِ",13,"ب",2,0],["وَلا فِيَّ خَيرٌ يَرتَجيهِ مَعاشِري","وَلا أَنا ذو فِعلٍ سَديدٍ وَلا رُشدِ",14,"د",1,0],["وَلا فَضلَ عِندَ الأَرمَنِيِّ يَعُدُّهُ","سِوى رَنَّهُ ثَورٌ سَمينٌ لِجازِرِ",15,"ر",1,0],["وَلا في كُلَيبٍ إِن عَرَتهُم مُلِمَّةٌ","كَريمٌ عَلى ما أَحدَثَ الدَهرُ صابِرُ",16,"ر",1,0],["وَلا فاخِتَةَ النَخلِ","مِنَ الطاوّسِ وَالديكِ",17,"ك",1,0],["ولا فدى بدخيره","دولابَهُ الطيارُ",18,"ر",1,0],["وَلا في المَنِّ وَالسَلوى","سُلُوٌّ عَن ثَناياك",19,"ك",1,0],["ولا في بلاد الله غيرك معقل","لحر إذا ما قيل أين المعاقل",20,"ل",1,0],["وَلا فَضلَ فينا وَلَكِنَّها","حُظوظٌ مِنَ الفَلَكِ الصاقِلِ",21,"ل",1,0],["ولا فتى قد قتل","النفس البراء أو غصب",22,"ب",1,0],["ولا فِتْنَةٌ طائِيّةٌ عامِرِيّةٌ","يُحَرَّقُ في نيرانِها الجَعدُ والسَّبْطُ",23,"ط",1,0],["ولاَ فِكْرةٌ نَقَّادة وَمَهَارَةٌ","حِسَابِيَّةٌ تعْتَدٌّ فِي الرَّيْبِ فَيْصلاَ",24,"ل",2,0],["ولا في قوانين البرية رحمة","ولا شيء في الدنيا يقال له الحب",25,"ب",1,0],["ولا فرقَ إلاّ أنَّ هذا مراوغٌ","كثيرُ مُداجاهٍ وهذا مجاهر",26,"ر",1,0],["ولا في أنْ يِمِسَّ ذويكَ ضُرٌّ","يَحيقُ بهمْ ومَظْلَمةٌ تَحيف",27,"ف",1,0],["ولا فَضْلَ عِنْدَ الأرْمَنيّ يَعُدُّهُ","سِوَى أنّهُ ثَوْرٌ سَمِينٌ لجَازِرِ",28,"ر",1,0]]}