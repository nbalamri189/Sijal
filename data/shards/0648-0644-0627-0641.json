عتد في الريب فيصلا",205,"ل",2,0],["ولا فقدنا الهوى أيام وصلكم","ولا اغتدينا وذاك القرب أخبار",206,"ر",1,0],["ولا فلك الأدوار مما به قضى","إله السما والأرض سنة حكمتي",207,"ت",2,0],["ولا فيه أصعب من الحرمان والا الجفا","ف قلوب تطفي لياليها فوانيسها",208,"س",3,0],["ولا فاح زَهرٌ من رُبى العُمْر إنّما","بقايا لقلبٍ أوهنتهُ الفواجعُ",209,"ع",1,0],["ولأفرِغَنَّ علَى مُقلَّدِ مجدِهِ","دُرَراً يهشُّ لهُنَّ كُلُّ مُقَلِّدِ",210,"د",1,0],["وَ لَا \" فَعُولٌ \" عَلَى شَطِّ المُنَى رَكَزَتْ","مِرسَاتُها فِي بُحُورِ الحُبِّ , لَا \" فَعِلُ \"",211,"ل",1,0],["ولا فيه كذاّب موثق كلامه","الكاذب الي بان زيفه تضايق",212,"ق",1,0],["ولافيه عنده خبر موثوق","والكذب دائم صفة لانذال",213,"ل",1,0],["ولا فرج نرجاه إِلا مَراحمك","يا اللَه تغيرها بأَحسن حال",214,"ل",1,0],["ولا فضلت قوما لتحقر غيرهم","ولا جحدت حقا ولا أنكرت يدا",215,"د",2,0],["ولا فطنوا أن يجلسوا ووفودُهم","يميسون في الألطاف منهم وفي الفضل",216,"ل",1,0]]}