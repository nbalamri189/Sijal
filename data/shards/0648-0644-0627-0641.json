77,"خليلي خلتكما تحسدان","https://www.poetsgate.com/ViewPoem.aspx?id=127094",""],[4119,"تفي بضمانها البيض الحداد","https://www.poetsgate.com/ViewPoem.aspx?id=16114",""],[5055,"حديث الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=89777",""],[5061,"العيون مسكته","https://www.poetsgate.com/ViewPoem.aspx?id=148018",""],[3859,"رنت بلابلُ في ودٍ من السلم","https://www.poetsgate.com/ViewPoem.aspx?id=124438",""],[5136,"أعاتبه وهو المليك المكرم","https://www.poetsgate.com/ViewPoem.aspx?id=121663",""],[5183,"رداء الحياء","https://www.poetsgate.com/ViewPoem.aspx?id=186498",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5213,"ولا فخر بالاموات فالنار ان خبت","https://www.poetsgate.com/ViewPoem.aspx?id=170551",""],[5237,"زيارة أرباب التقى مرهم يبري","https://www.poetsgate.com/ViewPoem.aspx?id=113107",""],[5277,"لا فرق عندي","https://www.poetsgate.com/ViewPoem.aspx?id=190717",""],[592,"أرى طالع الأدبار والنحس قد بدا","https://www.poetsgate.com/ViewPoem.aspx?id=128843",""],[592,"رسائل أخوان الصفا والتودد","https://www.poetsgate.com/ViewPoem.aspx?id=128837",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5431,"حنانيك ...","https://www.poetsgate.com/ViewPoem.aspx?id=206968",""],[5459,"أقيموا الوزن بالقسط","https://www.poetsgate.com/ViewPoem.aspx?id=198347",""],[5561,"إطلالة على الماضي والحاضر","https://www.poetsgate.com/ViewPoem.aspx?id=197572",""],[5694,"من العايدين","https://www.poetsgate.com/ViewPoem.aspx?id=132100",""],[402,"مكانك لا يخلو إاذ غيره خلا","https://www.poetsgate.com/ViewPoem.aspx?id=36169",""],[5790,"لا أوحشت منكم للربع آثار","https://www.poetsgate.com/ViewPoem.aspx?id=112040",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5848,"الله يقطع بليسها","https://www.poetsgate.com/ViewPoem.aspx?id=48832",""],[5952,"خليليَّ","https://www.poetsgate.com/ViewPoem.aspx?id=199847",""],[6031,"حَتَّامَ أمطلُ سيِّدي شكرَ اليدِ","https://www.poetsgate.com/ViewPoem.aspx?id=46263",""],[6102,"طلل","https://www.poetsgate.com/ViewPoem.aspx?id=184437",""],[6115,"الحق مايزعل يكون الهلامه","https://www.poetsgate.com/ViewPoem.aspx?id=180472",""],[6115,"رجل كما الصقر يطلع فوق","https://www.poetsgate.com/ViewPoem.aspx?id=181733",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[5724,"رسول العلى والفضل والخير والهدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55159&r=&rc=26",""],[463,"أروم الوفاءَ الصعبَ بالمطلبِ السهلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60203&r=&rc=259",""]],"verses":[["وَلا فُجِعتَ وَقَد سارَت رَكائِبُهُم","يَومَ الغَميمِ بِغِزلانِ كَغِزلانِ",0,"ن",1,0],["وَلا فَرقَ بَيني في الكَلامِ وَبَينَهُم","بِشَيءٍ سِوى أَنّي أَقولُ وَقالوا",1,"ل",3,0],["وَلا في مَهاوي الأَرضِ إِن رُمتَ مَهبَطاً","وَلا في مَراقي الجَوِّ إِن رُمتَ مُرتَقى",2,"ق",2,0],["وَلا فَرحَةُ الإِثراءِ مِن بَعدِ فاقَةٍ","عَلى قَلبِ مَن نالَ في الدَهرِ مَغنَما",3,"م",2,0],["ولا فخرَ للإنسان إلاّ بسعيه","ولا فضلَ إلا بالتُقى والتكرُّم",4,"م",1,0],["وَلا في الفَرعِ مِن أَبناءِ عَمروٍ","وَلا في فَرعِ مَخزومِ الكِرامِ",5,"م",1,0],["وَلا فَوقٌ وَلا تَحتٌ","وَلا قَبلٌ وَلا بَعدُ",6,"د",1,0],["ولا فاتهُ في الفطر صومٌ لأنهُ","مواصِلُ صومٍ عُقْبَتاهُ سَواءُ",7,"ا",2,0],["ولا فاته طولُ الأناةِ بفرصةٍ","إذا ضاع أمر العاجز المتخاذلِ",8,"ل",1,0],["ولا فَهّةٌ من عاجزٍ متخاذلٍ","إذا نابه يوماً من الأمر مُعْظَمُ",9,"م",1,0],["ولا في عُقدةٍ منه انحلالٌ","ولا في عُروةٍ منه انفصامُ",10,"م",1,0],["وَلا فَضلَ فيها لِلشَجاعَةِ وَالنَدى","وَصَبرِ الفَتى لَولا لِقاءُ شَعوبِ",11,"ب",1,0],["وَلا في فَقدِهِنَّ بَني كِلابٍ","إِذا أَبصَرنَ غُرَّتَكَ اِغتِرابُ",12,"ب",1,0],["وَلا في فَراهَةِ بِرذَونِهِ","وَلا في نَظافَةِ أَثوابِهِ",13,"ب",2,0],["وَلا فِيَّ خَيرٌ يَرتَجيهِ مَعاشِري","وَلا أَنا ذو فِعلٍ سَديدٍ وَلا رُشدِ",14,"د",1,0],["وَلا فَضلَ عِندَ الأَرمَنِيِّ يَعُدُّهُ","سِوى رَنَّهُ ثَورٌ سَمينٌ لِجازِرِ",15,"ر",1,0],["وَلا في كُلَيبٍ إِن عَرَتهُم مُلِمَّةٌ","كَريمٌ عَلى ما أَحدَثَ الدَهرُ صابِرُ",16,"ر",1,0],["وَلا فاخِتَةَ النَخلِ","مِنَ الطاوّسِ وَالديكِ",17,"ك",1,0],["ولا فدى بدخيره","دولابَهُ الطيارُ",18,"ر",1,0],["وَلا في المَنِّ وَالسَلوى","سُلُوٌّ عَن ثَناياك",19,"ك",1,0],["ولا في بلاد الله غيرك معقل","لحر إذا ما قيل أين المعاقل",20,"ل",1,0],["وَلا فَضلَ فينا وَلَكِنَّها","حُظوظٌ مِنَ الفَلَكِ الصاقِلِ",21,"ل",1,0],["ولا فتى قد قتل","النفس البراء أو غصب",22,"ب",1,0],["ولا فِتْنَةٌ طائِيّةٌ عامِرِيّةٌ","يُحَرَّقُ في نيرانِها الجَعدُ والسَّبْطُ",23,"ط",1,0],["ولاَ فِكْرةٌ نَقَّادة وَمَهَارَةٌ","حِسَابِيَّةٌ تعْتَدٌّ فِي الرَّيْبِ فَيْصلاَ",24,"ل",2,0],["ولا في قوانين البرية رحمة","ولا شيء في الدنيا يقال له الحب",25,"ب",1,0],["ولا فرقَ إلاّ أنَّ هذا مراوغٌ","كثيرُ مُداجاهٍ وهذا مجاهر",26,"ر",1,0],["ولا في أنْ يِمِسَّ ذويكَ ضُرٌّ","يَحيقُ بهمْ ومَظْلَمةٌ تَحيف",27,"ف",1,0],["ولا فَضْلَ عِنْدَ الأرْمَنيّ يَعُدُّهُ","سِوَى أنّهُ ثَوْرٌ سَمِينٌ لجَازِرِ",28,"ر",1,0],["ولا فَقَع الثَدْيُ أو عربَدَا","صنعتُكَ من أضلعي .. لا تكنْ",29,"ن",1,0],["ولا فوق نعماء المحبّة جنّة","ولا فوق أحقاد النّفوس جحيم",30,"م",1,0],["ولا فرس تثور ولا حصان","ولا سرح لدي ولا لجام",31,"م",1,0],["ولا فؤادي كالوكر مضطرباً","تجني عليه بلحظها المقل",32,"ل",1,0],["ولا في ثرى الرولة الفيحاء طاب لنا","حسن المقام وحسن الحور والعينا",33,"ن",2,0],["ولا فقيرٌ تراه ذَا عُسُر","يلقَاهُ إلا كساهُ أو نفعهْ",34,"ع",2,0],["ولا فَقَدَت أفواهُنا ذكركم ولا","ذكرناكمُ إلا بخير ونُطْنِبُ",35,"ب",1,0],["وَلاَ في جَوبِكَ الفَلَواتِ مَهمَا","جُفُونُ اللَّيلِ قَد كُحِلَت ِبِقَارِ",36,"ر",1,0],["ولا فرقَ ما بيننا في القيا","سِ إلاّ العقولُ وهذا الكلامُ",37,"م",1,0],["ولا في مدى عمري اتساع لنأيه","وبعدٌ له أطوى الفيافي وأعنق",38,"ق",1,0],["وَلا فَلَّ صَبري ما لَقيتُ وَإِنَّني","لَأَلوي عَلى اللّأواءِ جَلدٌ مُكافِحُ",39,"ح",1,0],["وَلا في بَني فَضلٍ بَخيلٌ وَإِنَّهُم","إِذا اِغبَرَّتِ الآفاقُ غُرٌّ أَماجِدُ",40,"د",1,0],["ولا فانيا عن زينة الزخرفا من","هوائية الدنيا بغشية غفلتي",41,"ت",2,0],["ولا فاتقا رتق الغشاوات عن قلي","ب من كدرات الجسم في أصل طينتي",41,"ت",2,0],["ولا فضل من أثخنته صوارم","بألحاظ ليلاه أغثني بعطفة",41,"ه",1,0],["ولا فرس ولا عير وثو","ولا بغل يعدّد في البغال",42,"ل",1,0],["ولا فقر إلا سوف يدركه الغنى","فإمّا بيسر المال أو بقوى المثري",43,"ر",2,0],["وَلا فاعلٌ للخيرِ والشرّ غيره","وَمِن أدَبٍ لَسنا له ننسبُ الشرّا",44,"ر",2,0],["ولا فرقَ بين المدركينَ زمانَهُ","وَمَن سمِعوا في سائر الدهر شانهُ",45,"ه",1,0],["ولا فرحاً إلا وأَعقبَ يَوْمَهُ","من الدهر نَوْحٌ دائمٌ وشجون",46,"ن",1,0],["ولا في الشعورِ كموجِ السحابِ","إذا ما تراختْ على بانِها",47,"ن",3,0],["ولا في الحواجبِ مثلَ الهلالِ","ولا في العيونِ وأجفانِها",47,"ن",3,0],["ولا في جمالِ زهورِ الرياضِ","إذا اختلْنَ في ثوبِ نيسانها",47,"ن",3,0],["ولا فضل في الحسنى إلى من يمنُّها","بلى عند مَن يزكو لديه التفضُّل",48,"ل",1,0],["وَلا فيكَ بِحَمدِ اللَ","هِ لا هَزلٌ وَلا جِدُّ",49,"د",1,0],["وَلا فَلَّ المَلامُ غرارَ غيىٍ","وَلا ثَلَمَ العِتابُ شَبا جِماحي",50,"ح",2,0],["ولا فقد الأقوام منك سميدعا","يقول إذا اشتد الخصام ويفعل",51,"ل",1,0],["ولا فلكيٌّ للكواكب راصدٌ","ولي مرصدٌ يُبنى على جبلِ الهند",52,"د",1,0],["وَلا في بقاع الارض حيا وَميتا","وَلا فوق آفاق السَماء كاحمد",53,"د",1,1],["ولا فارَقوا والمَوْتُ يُتْلِعُ جِيدَهُ","بِحَيْثُ التَقَى الجَمْعَانِ صِدْقَ العَزائِمِ",54,"م",1,0],["وَلا فَرْقَ فِيها بَيْنَ عَزْمٍ وَصارِمٍ","كَأَنَّ الظُّبى فِيها طُبِعْنَ مِنَ الْعَزْمِ",55,"م",1,0],["وَلا فُوْقَ الْغِنى جُودٌ فَحَسْبِي","كَفى بِالْمَحْلِ عارِضُكَ الْمَطِيرُ",56,"ر",1,0],["وَلا فَرائِدَ إِلّا مِن عِبارَتِهِ","وَلا فَوائِدَ إِلّا مِن عَطاياهُ",57,"ا",2,0],["وَلا فَضحُ الفُضُوحِ وَلا شُيَيمٌ","وَلا سُلْماكُمُ صَمِّي صَمامِ",58,"م",1,0],["وَلا فَتى كَعَلي ذي الوَلاءِ فَلَو","صَفا لَهُ الوَقتُ لَاِمتازَت خِلافَتُهُ",59,"ت",2,0],["وَلا فتئ الإِقبال بالعزّ مُقبِلاً","إِلى بابِهِ العالي تُحَثُّ جَنائِبُه",60,"ب",2,0],["ولا فَخْرَ عندي في وجُوهٍ وضيئةٍ","إذا كانتِ الأخلاقُ غيرَ وِضاء",61,"ا",2,0],["ولا فضل إلا وهو فينا متمَّ