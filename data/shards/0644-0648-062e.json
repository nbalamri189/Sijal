{"poems":[[23,"لو خلق اللؤم إنسانا يكلمهم","https://www.aldiwan.net/poem21331.html","البسيط"],[72,"لتهن عين إلى مراك قد طمحت","https://www.aldiwan.net/poem18476.html","البسيط"],[51,"يا ابن المدبر غرني الرواد","https://www.aldiwan.net/poem61893.html","الكامل"],[51,"لعن الله خالدا","https://www.aldiwan.net/poem61945.html","مجزوء الخفيف"],[51,"لا تشم للمزن برقا","https://www.aldiwan.net/poem65494.html","مجزوء الرمل"],[91,"لو أستطيع كتبت بالنيران","https://www.aldiwan.net/poem62773.html","عموديه"],[85,"لنا رقيب كان ما أثقله","https://www.aldiwan.net/poem7302.html","السريع"],[85,"جبريل أنت هدى السماء","https://www.aldiwan.net/poem63729.html","مجزوء الكامل"],[43,"لا تحسبوا ربعكم ولا طلله","https://www.aldiwan.net/poem10134.html","المنسرح"],[43,"شغلي عن الربع أن أسائله","https://www.aldiwan.net/poem10614.html","المنسرح"],[45,"أأفاق صب من هوى فأفيقا","https://www.aldiwan.net/poem65176.html","الطويل"],[66,"حبل المنى بحبال اليأس معقود","https://www.aldiwan.net/poem40133.html","البسيط"],[66,"فيروزج الصبح أم يا قوتة الشفق","https://www.aldiwan.net/poem41544.html","البسيط"],[80,"هذا ابتداء له عند العلى خبر","https://www.aldiwan.net/poem31433.html","البسيط"],[44,"أي القلوب عليكم ليس ينصدع","https://www.aldiwan.net/poem30310.html","البسيط"],[31,"كدت يوم الرحيل أقضي حياتي","https://www.aldiwan.net/poem42017.html","الخفيف"],[105,"قل للحسين ولات حين ملام","https://www.aldiwan.net/poem43043.html","الكامل"],[75,"أقوى المحصب من هاد ومن هيد","https://www.aldiwan.net/poem69092.html","الطويل"],[50,"تعجبت جارتي مني وقد رقدت","https://www.aldiwan.net/poem63950.html","البسيط"],[50,"لله سلمى حبها ناصب","https://www.aldiwan.net/poem64840.html","البسيط"],[46,"شعر كساه الدهر صبغة حاذق","https://www.aldiwan.net/poem23248.html","الكامل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39634","الرمل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16703","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/1670","البسيط"]],"verses":[["لَو خُلِقَ اللُؤمُ إِنساناً يُكَلِّمُهُم","لَكانَ خَيرَ هُذَيلٍ حينَ ياتيها",0,"ي",3,1],["لو خط بعض اسمك العالي على علم","وقابلته حصون الأرض لافتتحت",1,"ت",1,0],["لو خَيَّسَتْ فرعونَ ذلَّ لوقعها","فرعونُ ذو الأوتاد والأوتادُ",2,"د",1,0],["لو خلا منه ليلةً","بات يرعى الفراقدا",3,"د",2,0],["لو خلا الأبرار منكم","أصبح المشرب رَنقا",4,"ق",2,0],["لَو خُيِّرَ الضُعَفاءُ لَاِختاروا الرَدى","لَكِنَّ عَيشَ الأَكثَرينَ أَماني",5,"ن",2,0],["لو خال بسم الله في مصحف","تغضب تحسينا محا البسلمه",6,"ل",3,0],["لَو خَيَّما في كَربُلا","لَم يُمنَعِ السِبطُ السِقايَه",7,"ا",3,0],["لَو خُلِطَ المِسكُ وَالعَبيرُ بِها","وَلَستِ فيها لَخِلتُها تَفِلَه",8,"ل",2,0],["لو خُلقت رجله كهامته","إذاً لبارى البُزاةَ في طلَقِهْ",9,"ق",2,0],["لَو خاضَها عِمليقُ أَو عُوجٌ إِذاً","ما جَوَّزَت عُوجاً وَلا عِمليقا",10,"ق",2,0],["لَو خَطَّ سَطراً تَرى عَكسَ القِياسِ بِهِ","الشَمسُ طالِعَةٌ وَاللَيلُ مَوجودُ",11,"د",1,0],["لَو خالَفَتكَ كُماةُ الجِنِّ عاصِيَةً","أَركَبتَهُم طَبَقاً في الأَرضِ عَن طَبَقِ",12,"ق",1,0],["لو خُصَّ عَصْرُ شبابٍ مِنْ سعادته","بلحظةٍ لم يَنَلْهُ الشيبُ والكبرُ",13,"ر",1,0],["لَو خَرَّ سَيفٌ مِنَ العَيّوقِ مُنصَلِتاً","ما كانَ إِلّا عَلى هاماتِهِم يَقَعُ",14,"ع",1,0],["لَو خَلَت خُلَّتي أَصَبتُ نَوالاً","أَو حَديثاً يَشفى مَعَ التَنويلِ",15,"ل",1,0],["لو خُيِّر الأعرابُ في أنسابهم","لتلمّسوا الأنسابَ في الأعجامِ",16,"م",1,0],["لو خَلّدَ الدّهرُ ذا عزّ لعِزّتِهِ","كنتَ الأحَقَّ بتَعميرٍ وتَخليدِ",17,"د",1,0],["لَو خُيِّرَ القَلبُ مَن يَمشي عَلى قَدَمٍ","لَاِختارَ سُعدى وَلَم يَعدِل بِها أَحَدا",18,"د",2,0],["لَو خَرَجَت لِلناسِ في عيدِهِم","صَلّى لَها الأَمرَدُ وَالشائِبُ",19,"ب",1,0],["لَو خُيِّروا بَينَ الحَياةِ وَغَيرِها","ما كانَتِ الدُنيا اِختِيارَ مُحَصِّل",20,"ل",1,0],["لو خايل البحرُ نَدَى يَديهِ","إذا لجَت عُفاتُهُ إليهِ",21,"ه",1,0],["لو خَلا من كرْمتَيْها فُلكُ نوحِ","أخطأ الجوديَّ أو باتَ غريقا",22,"ق",2,0],["لو خُلّيَتْ وذَنوبَ ماءٍ سائلٍ","في مِذْنَبٍ سَبَقَتْهُ من إسْراعِها",23,"ع",3,0],["لَو خِفتُ لَيثاً أَبا شِبلَينِ ذا لِبَدٍ","ما أَسلَموني لِلَيثِ الغابَةِ العادي",24,"د",2,0]]}