8","السريع"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145059","الكامل"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121357","البسيط"],[3334,"","https://poetry.dctabudhabi.ae/diwan/poem/31454",""],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89182","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62850","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108132","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36264","الدوبيت"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78241","البسيط"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105524","الرمل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81917","البسيط"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81926","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33742","المنسرح"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120193","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35126","الرمل"],[4717,"رفقاً خديجة","https://www.poetsgate.com/ViewPoem.aspx?id=199578",""],[4750,"ياوليفي دمعكم في غيابي ردّ لي","https://www.poetsgate.com/ViewPoem.aspx?id=180434",""],[5055,"النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=100746",""],[5055,"النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=104293",""],[5061,"دمعة المغترب","https://www.poetsgate.com/ViewPoem.aspx?id=152992",""],[3591,"حرم الجمال نواظري سنة الكرى","https://www.poetsgate.com/ViewPoem.aspx?id=149439",""],[5183,"المْفَتُوْن","https://www.poetsgate.com/ViewPoem.aspx?id=186475",""],[5183,"منزل الشان","https://www.poetsgate.com/ViewPoem.aspx?id=180213",""],[5183,"خميلة الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=185682",""],[778,"قم فاسقني قهوة اذا انبعثت","https://www.poetsgate.com/ViewPoem.aspx?id=89145",""],[5190,"روح وريحان","https://www.poetsgate.com/ViewPoem.aspx?id=121512",""],[4045,"صرمتك بعد وصالها","https://www.poetsgate.com/ViewPoem.aspx?id=200296",""],[5277,"بغداد بين الأمس واليوم","https://www.poetsgate.com/ViewPoem.aspx?id=185168",""],[5277,"شقائق النعمان","https://www.poetsgate.com/ViewPoem.aspx?id=185276",""],[5277,"أنتِ..يا أجملَ الأزهار","https://www.poetsgate.com/ViewPoem.aspx?id=187783",""],[5463,"يا زماني .. ما طلبت الا سلامه","https://www.poetsgate.com/ViewPoem.aspx?id=25227",""],[5463,"أحسب أهلي ناسبوها","https://www.poetsgate.com/ViewPoem.aspx?id=31731",""],[5525,"قلبي سجد لك","https://www.poetsgate.com/ViewPoem.aspx?id=7227",""],[5573,"من يفرش القاع يلقى ليلة لحافه","https://www.poetsgate.com/ViewPoem.aspx?id=200305",""],[5652,"انا تراني ضيغمي للسناعيس","https://www.poetsgate.com/ViewPoem.aspx?id=176981",""],[5736,"نامت على حسرة","https://www.poetsgate.com/ViewPoem.aspx?id=208227",""],[5747,"بعض الخطا","https://www.poetsgate.com/ViewPoem.aspx?id=61611",""],[5956,"يا خيبة الآمال","https://www.poetsgate.com/ViewPoem.aspx?id=181987",""],[5978,"رسالة إلى المتنبي","https://www.poetsgate.com/ViewPoem.aspx?id=191364",""],[6056,"شقائق النعمان","https://www.poetsgate.com/ViewPoem.aspx?id=130320",""],[6124,"لست سحارا","https://www.poetsgate.com/ViewPoem.aspx?id=174658",""],[6147,"سفر على الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=151691",""],[6152,"أقسى الجراح خيانة الأوطان","https://www.poetsgate.com/ViewPoem.aspx?id=203401",""]],"verses":[["لَو خُلِقَ اللُؤمُ إِنساناً يُكَلِّمُهُم","لَكانَ خَيرَ هُذَيلٍ حينَ ياتيها",0,"ي",3,1],["لو خط بعض اسمك العالي على علم","وقابلته حصون الأرض لافتتحت",1,"ت",1,0],["لو خَيَّسَتْ فرعونَ ذلَّ لوقعها","فرعونُ ذو الأوتاد والأوتادُ",2,"د",1,0],["لو خلا منه ليلةً","بات يرعى الفراقدا",3,"د",2,0],["لو خلا الأبرار منكم","أصبح المشرب رَنقا",4,"ق",2,0],["لَو خُيِّرَ الضُعَفاءُ لَاِختاروا الرَدى","لَكِنَّ عَيشَ الأَكثَرينَ أَماني",5,"ن",2,0],["لو خال بسم الله في مصحف","تغضب تحسينا محا البسلمه",6,"ل",3,0],["لَو خَيَّما في كَربُلا","لَم يُمنَعِ السِبطُ السِقايَه",7,"ا",3,0],["لَو خُلِطَ المِسكُ وَالعَبيرُ بِها","وَلَستِ فيها لَخِلتُها تَفِلَه",8,"ل",2,0],["لو خُلقت رجله كهامته","إذاً لبارى البُزاةَ في طلَقِهْ",9,"ق",2,0],["لَو خاضَها عِمليقُ أَو عُوجٌ إِذاً","ما جَوَّزَت عُوجاً وَلا عِمليقا",10,"ق",2,0],["لَو خَطَّ سَطراً تَرى عَكسَ القِياسِ بِهِ","الشَمسُ طالِعَةٌ وَاللَيلُ مَوجودُ",11,"د",1,0],["لَو خالَفَتكَ كُماةُ الجِنِّ عاصِيَةً","أَركَبتَهُم طَبَقاً في الأَرضِ عَن طَبَقِ",12,"ق",1,0],["لو خُصَّ عَصْرُ شبابٍ مِنْ سعادته","بلحظةٍ لم يَنَلْهُ الشيبُ والكبرُ",13,"ر",1,0],["لَو خَرَّ سَيفٌ مِنَ العَيّوقِ مُنصَلِتاً","ما كانَ إِلّا عَلى هاماتِهِم يَقَعُ",14,"ع",1,0],["لَو خَلَت خُلَّتي أَصَبتُ نَوالاً","أَو حَديثاً يَشفى مَعَ التَنويلِ",15,"ل",1,0],["لو خُيِّر الأعرابُ في أنسابهم","لتلمّسوا الأنسابَ في الأعجامِ",16,"م",1,0],["لو خَلّدَ الدّهرُ ذا عزّ لعِزّتِهِ","كنتَ الأحَقَّ بتَعميرٍ وتَخليدِ",17,"د",1,0],["لَو خُيِّرَ القَلبُ مَن يَمشي عَلى قَدَمٍ","لَاِختارَ سُعدى وَلَم يَعدِل بِها أَحَدا",18,"د",2,0],["لَو خَرَجَت لِلناسِ في عيدِهِم","صَلّى لَها الأَمرَدُ وَالشائِبُ",19,"ب",1,0],["لَو خُيِّروا بَينَ الحَياةِ وَغَيرِها","ما كانَتِ الدُنيا اِختِيارَ مُحَصِّل",20,"ل",1,0],["لو خايل البحرُ نَدَى يَديهِ","إذا لجَت عُفاتُهُ إليهِ",21,"ه",1,0],["لو خَلا من كرْمتَيْها فُلكُ نوحِ","أخطأ الجوديَّ أو باتَ غريقا",22,"ق",2,0],["لو خُلّيَتْ وذَنوبَ ماءٍ سائلٍ","في مِذْنَبٍ سَبَقَتْهُ من إسْراعِها",23,"ع",3,0],["لَو خِفتُ لَيثاً أَبا شِبلَينِ ذا لِبَدٍ","ما أَسلَموني لِلَيثِ الغابَةِ العادي",24,"د",2,0],["لو خلعت الملابس السود سود","ناك بين الرجال وسط النادي",25,"د",2,0],["لو خاض طيفك في بحارِ مَدامعي","خوضي لبحر عطاءِ يحيى مُمكنا",26,"ن",2,0],["لو خوطب المرَء منهم وهو مشتغلٌ","عن نفسه بأليمِ الضرب ما عَقلا",27,"ل",2,0],["لو خيّروني بصبيّ رائق","أم مرة حسناء قلت الصبي",28,"ب",2,0],["لو خُلقَ المجدُ كالانامِ لما","كان سوى ناظريك عيناهُ",29,"ا",2,0],["لو خُلِّيا سرمدَ الدنيا قد انفردا","عند التغازل ما مَلّا وما بَرِما",30,"م",2,0],["لَو خِفتُ هَذا مِنكَ يَوماً لَم أَنَم","حَتّى أَجوزَ الشَعَفاتِ مِن خِيَم",31,"م",1,1],["لَو خوفتك الجحيم بطشي","لشوقت قلبك الجنان",32,"ن",1,0],["لو خلتهُ سرّاً لما أفشيته","لهمُ ولكن كنت غير مصيبِ",33,"ب",1,0],["لَو خَرَجتُم إِلى السِهامِ نَهاراً","لَخَرَجتُم لِلغارِمينَ سِهاما",34,"م",2,0],["لو خافَكُم خالدُ بنُ نَضلَةَ نَج","جَتهُ سَبوحٌ عِنانُها خَذِمُ",35,"م",1,0],["لَو خايَلَت دِجلَةَ بِالأَلبانِ","إِذاً لَقيلَ اِشتَبَهَ النَهرانِ",36,"ن",1,0],["لو خلا منه عصره لو هى الدي","ن ذهابا وبدل الإسلام",37,"م",1,0],["لو خامر الحزن جلمودا لكسره","هيهات تبقى على الحزن الجلاميد",38,"د",1,0],["لو خَلتْ من أُسرةٍ في قومها","ونفاها حسبٌ زاكٍ نماها",39,"ا",3,0],["لو خلَّد الجودُ امرأً","بما حبا وأجزلا",40,"ل",2,0],["لو خنقته ذلَّةُ البخل لما","قال بدينار لها تنفَّسي",41,"س",2,0],["لو خُلِّد ابنُ البَرِّ أو أمِنَ الردَى","لعفافه لم يولَد ابنُ الفاجرِ",42,"ر",1,0],["لو خير المخلوق قبل وجوده","ما صيغ من طين ولا من ماء",43,"ا",2,0],["لو خيرونا لما اخترنا سوى عدم","وإنما الأمر موكول إلى القدر",44,"ر",1,0],["لو خلا الدست قبله ومن وقار","خف شوقاً إليه دست وقور",45,"ر",1,0],["لو خطانِي جُرحُهُ وقْ","تاً لداويتُ جُروحي",46,"ح",2,0],["لو خلق الله وجوداً للورى","لكان مثله ومثله افترا",47,"ر",2,1],["لو خُيِّرَ السُّلطانُ لاختارَ البَقا","ويكونَ عبداً من أقلِّ عبيدهِ",48,"د",2,0],["لَوْ خُيرَ الجودُ يومَ الفخرِ مُنْتَسِباً","لَقَالَ زايدُ مَا أرْجُو وَأَنْتَسِب",49,"ب",1,0],["لو خُيِّر المِنبرُ فرسانَه","ما اختارَ إلاّ منكمُ فارِسا",50,"س",2,0],["لو خلا البر من المحراث لم","ترفع الريح على البحر شراعا",51,"ع",2,0],["لو خاطبت وثناً","لحنّ مع الجمود لها وإنا",52,"ن",2,0],["لَو خاضَ في صفّ العِداةِ رَأَيتَهُ","بِجَوادِهِ قَد داسَ فَوقَ الديسَمِ",53,"م",1,0],["لو خَشِينَا الْبِدَارَ مِنهُمْ لَعِثْنا","فيهِم كاللُّيُّوثِ فِي الأَمْعُوزِ",54,"ز",1,0],["لو خاطب الحجر الجلمود أسمعه","ولو دعا ميتا في القبر لباه",55,"ا",2,0],["لَوْ خَالَ كِسْرَى سَنَا هُدَاهَا","مَا كَانَ للِنَّارِ قَدْ تَعَبَّدْ",56,"د",1,0],["لو خاضه البحر ليلاً مات من ظمإِ","لو خاضه فرح لاغتاله حزنه",57,"ن",2,0],["لو خفف الثقل عن قلبي وعلله","بالوعد كنت أمنيه وأطمعه",58,"ع",2,0],["لَو خُيِّرَت قَيسٌ بَني آدَمٍ","كُنتُ الرِضا مِن أَلفِ إِنسانِ",59,"ن",1,0],["لو خفت مثلى طرفه الأدعجا","أو لو رأيت فرقه الأبلجا",60,"ج",2,0],["لو خرجتم من القبور لدينا","ورأيتم أن الحياة خصام",61,"م",1,0],["لو خلي الليث ببطن الورى","والنمر أو قد جيء بالببر",62,"ر",1,0],["لو خلت منه نشأة ما استقامت","مستحيل قوامها وخلاها",63,"ا",3,0],["لو خبا نورها عن الأرض صارت","بلقعاً قد خلا من السكان",64,"ن",1,0],["لو خلقنا الفعل لم نشق به","ولكان الفعل ما فيه عسر",65,"ر",1,0],["لو خضت لجة قاموس وجدت به","درا جلا جلو مصباح الدجى السدفا",66,"ف",2,0],["لو خلَت هذه البسيطة منهم","لوجدنا فيها نعيمَ الجنان",67,"ن",1,0],["لو خلت هذه البسيطةُ منهم","لخلت من بواعث الاحزان",67,"ن",1,0],["لو خُيِّرَ الناسُ فاختاروا لأنفسهم","أحظّ منك لما نالوه ما قدروا",68,"ر",3,0],["لو خلّد اللَه محلوقاً لنجدتهِ","فكان ربُكَ في الدنيا مخلّده",69,"ه",1,1],["لو خاف من سيف الجفون خده","فقد غدا مستلئماً بالزرد",70,"د",1,0],["لو خلد الذكر الجميل من الورى","أحد لكنت مدى الزمان تخلّد",71,"د",1,0],["لو خَلّاك الزماني","يْمحق شَعَرْك الشيب",72,"ب",1,0],["لَو خِدرُهُ طالَعَ الأَحباشَ شارِقُهُ","لَكانَ يَبيَضُّ مِنهُم حالِكُ الأَدَمِ",73,"م",1,0],["لو خلدّ الخير والاسلام ذا قدمٍ","إذاً لخلدكَ الإسلام والخير",74,"ر",1,0],["لَو خَبَرَ الناسُ جَميعَ الكتبِ","وَنَظمَهُم ونَثرَهُم يا صَاحِبي",75,"ي",1,0],["لو خلا القلب من هوى ساكنيهِ","كان موتي لفقدهم قد حلا لي",76,"ل",2,0],["لو خالفتهُ الجبال وافقهُ","في قطعها صارٌم لهُ ذكر",77,"ر",1,0],["لو خلد الحر ذليلا لما","شاء البقا كيف به وهو فان",78,"ن",1,0],["لو خاف موسى أن يحل به ردى","في الطور لم يك للإله كليما",79,"م",2,0],["لو خَطرَف الشيبُ عقداً كنت أعذرُهُ","لكنما سهوه بالضعفِ في العددِ",80,"د",1,1],["لو خاف من سبع أو من بهيمة أو","إنسان أو حية أو جاحم شعلا",81,"ل",2,0],["لو خلتَه وحريمه","لرأيت عُرساً أو مطاهرْ",82,"ر",1,0],["لو خَضَعنا لمستطيلٍ سِواكم","أَو سَمِحنا لغيرِكم بالسؤالِ",83,"ل",1,0],["لو خيل أنك محسن تعريبَ ما","تركت يدا هيجو من الأثارِ",84,"ر",1,1],["لَو خَطّ عِذاره اِجتَلى العَين رأت","ما النَفسُ تَمَنَّتهُ لَها مَكتوبا",85,"ب",2,0],["لَو خالَكَ البَدرُ يَوماً قالَ مُندَهِشاً","أَنتَ الصَباح وَأَنتَ النور للامم",86,"م",1,0],["لو خلت من نوره ما ثقبا","نير منها بوجه الغلس",87,"س",1,0],["لو خلتِ الأرض يوماً من مثبتها","لمادت الأرض والأفلاك بالقطب",88,"ب",1,0],["لو خلا الكون من إمام لمادت","بهم الأرض واعترتها السماء",89,"ا",2,0],["لو خَلطوهُ بالمِسكِ وسخَّهُ","أو طَرحوه في البحرِ كدَّرَهُ",90,"ر",2,0],["لو خالطت أخلاقه الأرواح ما","هبت لنا إلا صبا ونسيما",91,"م",2,0],["لَو خَشِينا الجَورَ مِن جيرَتِنا","لَاِنتَصَفنا قَبلَ أَن نَفتَرِقا",92,"ق",2,0],["لوْ خُيِّرَتْ بَيْنْ الشَّمَائَلِ مَا ابْتَغَتْ","فَخِصَالُها أسْمَى الصِّفَاتِ وأَشْرَفُ",93,"ف",1,0],["لوّ خبر به حيّ يبكي على فقدان حيّ","كان يمدي من عرفني يشاركني عزاي",94,"ا",2,0],["لو خط بالنسيان سيفٍ بلا ترس","أو تحمل الترحال سود البطاحي",95,"ح",2,0],["لو خط بالنسيان سيفٍ بلا طمس","أو تحمل الترحال سود البطاحي",96,"ح",2,0],["لو #خيروني ....بين كل المخاليق","ب اختارك انتي ياعسى عمرك يطول",97,"ل",1,0],["لو خيّروني بين باريس ومن","أهوى لفضلها الفؤاد وآثرا",98,"ر",2,0],["لو خنتها يوما ولو خانتك بين صحابتك","لكن معظم حسنها لك أنت وفق مسرَّتك",99,"ك",1,0],["لو خلتها وهي تمشي في خميلتها","سكرى لأكبرتها عن حفظ رضوان",100,"ن",1,0],["لو خلتها والسكر يرفع ثوبها","عن عرف غالية ولطف مؤاس",101,"س",1,0],["لو خامرت صخرة بسورتها","لاحدثت في سكونها حركه",102,"ك",2,0],["لَوْ خَيَّرُونِي بَينَ حُبِّكِ والحَيَا","ةِ ، اْختَرْتُ حُبَّكِ ، رَغمَ شَهدِ رُوَائِهَا",103,"ا",3,0],["لو خيّرت من خلقها","لم تعد فضل كمالها",104,"ل",3,0],["لو خيروني اليومَ بين حبيبتي","أو بين ليلٍ في الرصافةِ يسمرُ",105,"ر",1,0],["لو خيروني لما آليتُ مجتهداً","أن أصطفيكِ كما أصفتكِ أوطانُ",106,"ن",1,0],["لو خيّروني بين عيني واللِقا","لاخترتكِ وتركتُ خلفي مقلتي",107,"ت",2,0],["لو خطيت الكل يرمي بالملامه","ولو رجيت الشخص حبّه ما عطاني",108,"ن",2,1],["لو خطت مرّه أمانه يا أهلها أتركوها","مثل هذي لو بتخطي ما بخطاها أي معابه",109,"ب",2,0],["لوخضت بحر وأنا في عزتك ناجي","ولو كنت أنا البحر... مالي عزتك بنفد",110,"د",1,0],["لو خفف الضيق من شرياني اوصافه","دواته الدم لو تنفعني اوصافي",111,"ف",2,0],["لو خط حرفه فوق بيض القراطيس","قرطاسنا نورن شعى فوق عباس",112,"س",1,0],["لو خصّ أوردتي بالنبضِ حين رمى","ذاك السلام فأحيا مهجتي مرّةْ",113,"ر",2,0],["لو خايلت عينك سنا البرق لا لاح","لاتحسب انه كل مالاح صايب",114,"ب",1,0],["لو خيَّروني بين عيش أو ردىً","رغم الصعوبة للردى أختار",115,"ر",1,0],["لو خُيِّرَ الذهبُ الإبريز حليتهُ","لما توانى بأنْ يدعوكَ يا ذهبي",116,"ب",2,0],["لو خيّروني قلت ما ارضى بدايل","لوكان نقوة في البنات الفرافيش",117,"ش",1,0],["لو خرجنا مثل أطيافِ البراري","في غدٍ تزهو المنى نورًا بهيَّا",118,"ي",2,0],["لو خبّروكَ بأني الحبَّ سارقُه","صدِّقْ.. فهذا الجوى للشعر مستبقي",119,"ق",2,0],["لو خيروني في سواها عِفتُها","خُبا وإكراما بغير توانِ",120,"ن",1,0]]}