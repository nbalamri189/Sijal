{"poems":[[23,"لو خلق اللؤم إنسانا يكلمهم","https://www.aldiwan.net/poem21331.html","البسيط"],[72,"لتهن عين إلى مراك قد طمحت","https://www.aldiwan.net/poem18476.html","البسيط"],[51,"يا ابن المدبر غرني الرواد","https://www.aldiwan.net/poem61893.html","الكامل"],[51,"لعن الله خالدا","https://www.aldiwan.net/poem61945.html","مجزوء الخفيف"],[51,"لا تشم للمزن برقا","https://www.aldiwan.net/poem65494.html","مجزوء الرمل"],[91,"لو أستطيع كتبت بالنيران","https://www.aldiwan.net/poem62773.html","عموديه"],[85,"لنا رقيب كان ما أثقله","https://www.aldiwan.net/poem7302.html","السريع"],[85,"جبريل أنت هدى السماء","https://www.aldiwan.net/poem63729.html","مجزوء الكامل"],[43,"لا تحسبوا ربعكم ولا طلله","https://www.aldiwan.net/poem10134.html","المنسرح"],[43,"شغلي عن الربع أن أسائله","https://www.aldiwan.net/poem10614.html","المنسرح"],[45,"أأفاق صب من هوى فأفيقا","https://www.aldiwan.net/poem65176.html","الطويل"],[66,"حبل المنى بحبال اليأس معقود","https://www.aldiwan.net/poem40133.html","البسيط"],[66,"فيروزج الصبح أم يا قوتة الشفق","https://www.aldiwan.net/poem41544.html","البسيط"],[80,"هذا ابتداء له عند العلى خبر","https://www.aldiwan.net/poem31433.html","البسيط"],[44,"أي القلوب عليكم ليس ينصدع","https://www.aldiwan.net/poem30310.html","البسيط"],[31,"كدت يوم الرحيل أقضي حياتي","https://www.aldiwan.net/poem42017.html","الخفيف"],[105,"قل للحسين ولات حين ملام","https://www.aldiwan.net/poem43043.html","الكامل"],[75,"أقوى المحصب من هاد ومن هيد","https://www.aldiwan.net/poem69092.html","الطويل"],[50,"تعجبت جارتي مني وقد رقدت","https://www.aldiwan.net/poem63950.html","البسيط"],[50,"لله سلمى حبها ناصب","https://www.aldiwan.net/poem64840.html","البسيط"],[46,"شعر كساه الدهر صبغة حاذق","https://www.aldiwan.net/poem23248.html","الكامل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39634","الرمل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16703","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/1670","البسيط"],[158,"غبطت جوارحنا عليك الأعينا","https://www.aldiwan.net/poem58876.html","الكامل"],[158,"هذا التأني وهذا الحلم قد فعلا","https://www.aldiwan.net/poem58892.html","البسيط"],[184,"إني وإن كنت أخا عرجة","https://www.aldiwan.net/poem44131.html","السريع"],[197,"رأيت نجليك فرقدي أفق","https://www.aldiwan.net/poem45511.html","المنسرح"],[202,"لا شيء أحسن من إلفين قد قسما","https://www.aldiwan.net/poem53183.html","البسيط"],[247,"لو خفت هذا منك يوما لم أنم","https://www.aldiwan.net/poem2091.html","الرجز"],[269,"رياض نجد بكم جنان","https://www.aldiwan.net/poem52050.html","مخلع البسيط"],[303,"يا خير محتفظ لود حبيب","https://www.aldiwan.net/poem56603.html","الكامل"],[364,"صدق الله وعده الأياما","https://www.aldiwan.net/poem17276.html","الخفيف"],[395,"في كفه لدنة مُثقفة","https://www.aldiwan.net/poem699.html",""],[407,"موسى وهارون هما اللذان","https://www.aldiwan.net/poem67464.html","الرجز"],[434,"هذه الدار والخيام الخيام","https://www.aldiwan.net/poem2543.html","الخفيف"],[438,"رفقا عليك وصبرا فهو محمود","https://www.aldiwan.net/poem14451.html","البسيط"],[456,"أتراها يوم صدت أن أراها","https://www.aldiwan.net/poem55814.html","الرمل"],[456,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[456,"يا وحشة المجد ثقي بالأنس","https://www.aldiwan.net/poem56153.html","الرجز"],[456,"خدع الزمان مودة من ثائر","https://www.aldiwan.net/poem56205.html","الكامل"],[477,"جدت ابن آدم أخطب الخطباء","https://www.aldiwan.net/poem36890.html","الكامل"],[477,"القول كالبرق والأعمال كالمطر","https://www.aldiwan.net/poem37185.html","البسيط"],[513,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[549,"يا مليح الوجه لم فعلك","https://www.aldiwan.net/poem47890.html","مجزوء الرمل"],[556,"لو خلق الله وجودا للورى","https://www.aldiwan.net/poem34491.html","الرجز"],[560,"ما يرتجيه المرء من مولوده","https://www.aldiwan.net/poem52771.html","الكامل"]],"verses":[["لَو خُلِقَ اللُؤمُ إِنساناً يُكَلِّمُهُم","لَكانَ خَيرَ هُذَيلٍ حينَ ياتيها",0,"ي",3,1],["لو خط بعض اسمك العالي على علم","وقابلته حصون الأرض لافتتحت",1,"ت",1,0],["لو خَيَّسَتْ فرعونَ ذلَّ لوقعها","فرعونُ ذو الأوتاد والأوتادُ",2,"د",1,0],["لو خلا منه ليلةً","بات يرعى الفراقدا",3,"د",2,0],["لو خلا الأبرار منكم","أصبح المشرب رَنقا",4,"ق",2,0],["لَو خُيِّرَ الضُعَفاءُ لَاِختاروا الرَدى","لَكِنَّ عَيشَ الأَكثَرينَ أَماني",5,"ن",2,0],["لو خال بسم الله في مصحف","تغضب تحسينا محا البسلمه",6,"ل",3,0],["لَو خَيَّما في كَربُلا","لَم يُمنَعِ السِبطُ السِقايَه",7,"ا",3,0],["لَو خُلِطَ المِسكُ وَالعَبيرُ بِها","وَلَستِ فيها لَخِلتُها تَفِلَه",8,"ل",2,0],["لو خُلقت رجله كهامته","إذاً لبارى البُزاةَ في طلَقِهْ",9,"ق",2,0],["لَو خاضَها عِمليقُ أَو عُوجٌ إِذاً","ما جَوَّزَت عُوجاً وَلا عِمليقا",10,"ق",2,0],["لَو خَطَّ سَطراً تَرى عَكسَ القِياسِ بِهِ","الشَمسُ طالِعَةٌ وَاللَيلُ مَوجودُ",11,"د",1,0],["لَو خالَفَتكَ كُماةُ الجِنِّ عاصِيَةً","أَركَبتَهُم طَبَقاً في الأَرضِ عَن طَبَقِ",12,"ق",1,0],["لو خُصَّ عَصْرُ شبابٍ مِنْ سعادته","بلحظةٍ لم يَنَلْهُ الشيبُ والكبرُ",13,"ر",1,0],["لَو خَرَّ سَيفٌ مِنَ العَيّوقِ مُنصَلِتاً","ما كانَ إِلّا عَلى هاماتِهِم يَقَعُ",14,"ع",1,0],["لَو خَلَت خُلَّتي أَصَبتُ نَوالاً","أَو حَديثاً يَشفى مَعَ التَنويلِ",15,"ل",1,0],["لو خُيِّر الأعرابُ في أنسابهم","لتلمّسوا الأنسابَ في الأعجامِ",16,"م",1,0],["لو خَلّدَ الدّهرُ ذا عزّ لعِزّتِهِ","كنتَ الأحَقَّ بتَعميرٍ وتَخليدِ",17,"د",1,0],["لَو خُيِّرَ القَلبُ مَن يَمشي عَلى قَدَمٍ","لَاِختارَ سُعدى وَلَم يَعدِل بِها أَحَدا",18,"د",2,0],["لَو خَرَجَت لِلناسِ في عيدِهِم","صَلّى لَها الأَمرَدُ وَالشائِبُ",19,"ب",1,0],["لَو خُيِّروا بَينَ الحَياةِ وَغَيرِها","ما كانَتِ الدُنيا اِختِيارَ مُحَصِّل",20,"ل",1,0],["لو خايل البحرُ نَدَى يَديهِ","إذا لجَت عُفاتُهُ إليهِ",21,"ه",1,0],["لو خَلا من كرْمتَيْها فُلكُ نوحِ","أخطأ الجوديَّ أو باتَ غريقا",22,"ق",2,0],["لو خُلّيَتْ وذَنوبَ ماءٍ سائلٍ","في مِذْنَبٍ سَبَقَتْهُ من إسْراعِها",23,"ع",3,0],["لَو خِفتُ لَيثاً أَبا شِبلَينِ ذا لِبَدٍ","ما أَسلَموني لِلَيثِ الغابَةِ العادي",24,"د",2,0],["لو خاض طيفك في بحارِ مَدامعي","خوضي لبحر عطاءِ يحيى مُمكنا",25,"ن",2,0],["لو خوطب المرَء منهم وهو مشتغلٌ","عن نفسه بأليمِ الضرب ما عَقلا",26,"ل",2,0],["لو خيّروني بصبيّ رائق","أم مرة حسناء قلت الصبي",27,"ب",2,0],["لو خُلقَ المجدُ كالانامِ لما","كان سوى ناظريك عيناهُ",28,"ا",2,0],["لو خُلِّيا سرمدَ الدنيا قد انفردا","عند التغازل ما مَلّا وما بَرِما",29,"م",2,0],["لَو خِفتُ هَذا مِنكَ يَوماً لَم أَنَم","حَتّى أَجوزَ الشَعَفاتِ مِن خِيَم",30,"م",1,1],["لَو خوفتك الجحيم بطشي","لشوقت قلبك الجنان",31,"ن",1,0],["لو خلتهُ سرّاً لما أفشيته","لهمُ ولكن كنت غير مصيبِ",32,"ب",1,0],["لَو خَرَجتُم إِلى السِهامِ نَهاراً","لَخَرَجتُم لِلغارِمينَ سِهاما",33,"م",2,0],["لو خافَكُم خالدُ بنُ نَضلَةَ نَج","جَتهُ سَبوحٌ عِنانُها خَذِمُ",34,"م",1,0],["لَو خايَلَت دِجلَةَ بِالأَلبانِ","إِذاً لَقيلَ اِشتَبَهَ النَهرانِ",35,"ن",1,0],["لو خلا منه عصره لو هى الدي","ن ذهابا وبدل الإسلام",36,"م",1,0],["لو خامر الحزن جلمودا لكسره","هيهات تبقى على الحزن الجلاميد",37,"د",1,0],["لو خَلتْ من أُسرةٍ في قومها","ونفاها حسبٌ زاكٍ نماها",38,"ا",3,0],["لو خلَّد الجودُ امرأً","بما حبا وأجزلا",39,"ل",2,0],["لو خنقته ذلَّةُ البخل لما","قال بدينار لها تنفَّسي",40,"س",2,0],["لو خُلِّد ابنُ البَرِّ أو أمِنَ الردَى","لعفافه لم يولَد ابنُ الفاجرِ",41,"ر",1,0],["لو خير المخلوق قبل وجوده","ما صيغ من طين ولا من ماء",42,"ا",2,0],["لو خيرونا لما اخترنا سوى عدم","وإنما الأمر موكول إلى القدر",43,"ر",1,0],["لو خلا الدست قبله ومن وقار","خف شوقاً إليه دست وقور",44,"ر",1,0],["لو خطانِي جُرحُهُ وقْ","تاً لداويتُ جُروحي",45,"ي",1,0],["لو خلق الله وجوداً للورى","لكان مثله ومثله افترا",46,"ر",2,1],["لو خُيِّرَ السُّلطانُ لاختارَ البَقا","ويكونَ عبداً من أقلِّ عبيدهِ",47,"د",2,0]]}