{"poems":[[79,"ألحظك أم سيف عمرو أعيدا","https://www.aldiwan.net/poem36612.html","المتقارب"],[53,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8499.html","البسيط"],[53,"طرقت أسماء والركب هجود","https://www.aldiwan.net/poem61906.html","الرمل"],[87,"أمينتي في عامها","https://www.aldiwan.net/poem8068.html","مجزوء الرجز"],[48,"الحظ لي ولأهل الأرض كلهم","https://www.aldiwan.net/poem22201.html","البسيط"],[48,"الحظ يقسم عاش بشر ما اشتكى","https://www.aldiwan.net/poem22566.html","الكامل"],[215,"بيني وبين غد عهد سأذكره","https://www.aldiwan.net/poem46780.html","البسيط"],[266,"أنا مضنى نوى الأحبة نضو","https://www.aldiwan.net/poem38109.html","الخفيف"],[287,"ألحظك حز قلبي أم حسام","https://www.aldiwan.net/poem32633.html","الوافر"],[325,"الحظ قد أوفى وأوفى بالمنن","https://www.aldiwan.net/poem67166.html","الكامل"],[369,"ألحظ في جفونك أم صوارم","https://www.aldiwan.net/poem60650.html","الوافر"],[382,"إسمع أخي خطاب أم الله ما","https://www.aldiwan.net/poem59366.html","الكامل"],[505,"ما رده الباغي إذا ردت به","https://www.aldiwan.net/poem38052.html","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64026","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37977","الوافر"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75887","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93895","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201258","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89238","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91480","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102729","البسيط"],[4791,"الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=35555",""],[4816,"بصمت احبك","https://www.poetsgate.com/ViewPoem.aspx?id=32380",""],[4866,"رباه","https://www.poetsgate.com/ViewPoem.aspx?id=129542",""],[4869,"روس الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=138049",""],[4869,"عيون السهر","https://www.poetsgate.com/ViewPoem.aspx?id=151623",""],[4869,"يديك ويديني","https://www.poetsgate.com/ViewPoem.aspx?id=151676",""],[4877,"ضاع الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=36092",""],[5055,"تراتيل ملتاع","https://www.poetsgate.com/ViewPoem.aspx?id=103543",""],[5100,"أصفار","https://www.poetsgate.com/ViewPoem.aspx?id=207705",""],[5225,"صدفه","https://www.poetsgate.com/ViewPoem.aspx?id=27447",""],[5225,"يكفيك انك شفتها","https://www.poetsgate.com/ViewPoem.aspx?id=36893",""],[5431,"اركض برجلك إن الحظ في ذاتك...","https://www.poetsgate.com/ViewPoem.aspx?id=190427",""],[5606,"إن كان تنشد عن حياتي فأنا حي","https://www.poetsgate.com/ViewPoem.aspx?id=194544",""],[5755,"ركض المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=177110",""],[5956,"إذا شاخ الدمُ","https://www.poetsgate.com/ViewPoem.aspx?id=183934",""],[5956,"شاعر الأديان","https://www.poetsgate.com/ViewPoem.aspx?id=192499",""],[6102,"لُمْ نَفسَك!!","https://www.poetsgate.com/ViewPoem.aspx?id=186291",""],[2588,"شاخصة (صدمة)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65599&r=&rc=31",""]],"verses":[["ألَحْظُكَ أم سَيْفُ عَمْرو أُعِيدا","لقَدْ جنّدَ الحُسْنُ فيكَ الجُنودا",0,"د",2,1],["الحظُّ أعمى ولولا ذاك لم نَرَهُ","للبحتريِّ بلا عقلٍ ولا حسبِ",1,"ب",1,0],["ألْحَظُ الرِيَّ وحشْوي غُلَّةٌ","غير أن ليس يُواتيني الوُرودُ",2,"د",1,0],["أَلحَظُها كَأَنَّها","مِن بَصَري في شَرَكِ",3,"ك",1,0],["الحَظُّ لي وَلِأَهلِ الأَرضِ كُلِّهِمُ","أَلّا يَرانِيَ أُخرى الدَهرِ أَصحابي",4,"ب",2,1],["الحَظُّ يُقسَمُ عاشَ بِشرٌ ما اِشتَكى","نَظَراً وَعُمِّرَ أَكمَهاً بَشّارُ",5,"ر",1,1],["الحظّ في يدكم والدهر في يدكم","إن الفتى الشهم للأدهار قتّال",6,"ل",1,0],["ألحظي منعتني أم لذنب","كان مني وفيك المذنب عفو",7,"و",1,0],["أَلحَظُكَ حَزَّ قلبي أَم حُسامُ","وَلَفظُكَ حازَ لُبّي أَم كَلامُ",8,"م",1,1],["الحَظُّ قَد أَوفى وَأَوفى بِالمَنَنِ","وَعَلى دَوامِ الأُنسِ حالَفَنا الزَمَنُ",9,"ن",1,1],["أَلَحْظٌ في جُفونِكِ أم صَوارمْ","وحَرْبٌ لي فؤادُكِ أم مُسالِمْ",10,"م",1,1],["الحظ كل الحظ أنت وليس لي","في العالمين سوى رضاك وعَرشهِ",11,"ش",2,0],["الحَظُّ أقْصَرهُ وقدَّ حِبالَهُ","فَتعلَّقتْ بالغَيْرِ شُؤماً همَّتُهْ",12,"ت",2,0],["الحظُّ يوشغُ للأديب فما الذي","أنكرت مني أنَّ حظِّيَ أوْشَغا",13,"غ",2,0],["أَلَحْظٌ ما تَكَحَّلَ أَم حُسامُ","وَغُصنٌ ما تَمايَلَ أَم قوامُ",14,"م",1,1],["أَلحظُ البدرَ وَهوَ نُصبُ عِياني","وَأُناجيهِ آمِنا مِن صدودِ",15,"د",1,0],["الحظ وافاه وصافته المنى","أبدا على كيد العدو المكمد",16,"د",1,0],["الحظ في الغرب ممنوع ممن العمل","والحظ يعمل عند الشرق ذي الكسل",17,"ل",1,1],["الحظ يا عمر أراه مُصْحَفا","فالخط من شيخ الغلام مُصَحَّفا",18,"ف",2,0],["أَلَحْظٌ عَلى قَلبي يجورُ وَيعتدي","وَأَخشى إِذا ما جال غَربُ المهنَّدِ",19,"د",1,1],["الحظ بعين الرضى عبدا له تبع","والعمر ولى ولم يرجع ولم يتب",20,"ب",1,0],["الحظيظ اللي على مر الزمان","بين حظه والمعزه ما يحول",21,"ل",1,0],["الحظ جابك في طريقي والأسباب","والصمت هو معنى الرضا والوسيله",22,"ل",2,0],["الحظ الاقشر ووجه البوم","سدّوا الطريق ومواصيله",23,"ل",2,0],["الحظ سكينه تغني كل عآم","مآيمر يوم إلا من هْمومي يريق",24,"ق",1,0],["الحظ يطلع ثم ينزل كما اللفت","والعقل ينزف ضيق والنفس تنهاه",25,"ا",2,0],["الحظ قصّر من يديك ويديني","ولولا الامل ماكنت اناظر يدينك",26,"ك",1,1],["الحظ ما قصر معاك ومعايه","لا من عدلته مال من دون تفسير . .",27,"ر",1,0],["الحظ فارقني تلافيت الاوضاع","لكنّ صدك ثايرٍ دوم ضدّي",28,"د",2,0],["الحظ العاثرُ يعشقني، وهروبي عارْ","ودروبُ نجاتي يغلقها... جيشُ التاتارْ",29,"ر",1,1],["الحظ لك في الوقت يا صاحبي جاد","فرحتك في صدفة لقى يا كبرها",30,"ر",3,0],["الحظ لك في الوقت يا صاحبي جاد","فرحتك في صدفة لقا يا كبرها",31,"ر",3,0],["الحظ مالحظ ؟...بعضٌ من معاناتك!","الحظُ يعني سلاما عند ميقاتك..",32,"ك",1,1],["الحظ بعضُ عذاباتٍ نكابدها","فتحمد الله في إنزاف أوقاتك",32,"ك",1,0],["الحظ عاندني وتدبيري السي","والا الفرص جتني إلى سدت البيت",33,"ت",1,0],["الحظ ريشة مؤلف ..! والحياه الكتاب","والعمر صفحه عليها كل عابر يبوح",34,"ح",1,1],["الحظ أكثر مستحقٍّ للقِلى","والازدراء لأنه لا يرحمُ",35,"م",1,0],["الحظ هذا يستحق عقابنا","هو ظالمٌ في كلِّ ما هو يحكمُ",35,"م",1,0],["الحظّ وجهني لربي إنما","لا أستطيع لما أراه أقلّدُ",36,"د",1,0],["الحَظُّ حَضَّ المُقعَدِينَ عَلى الخُطَى","وَعَلى قُعُودِكَ سُوءُ حَظِّكَ حَضَّكْ",37,"ك",1,0],["الحظُّ فيه الغِنى","والعقلُ فيه العَدَمْ",38,"م",1,1]]}