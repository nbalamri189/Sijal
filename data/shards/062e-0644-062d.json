{"poems":[[83,"سقى الهوى فانتشى العميد","https://www.aldiwan.net/poem61401.html","مجزوء البسيط"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102571","الرمل"],[6056,"راسي يافهد شابي","https://www.poetsgate.com/ViewPoem.aspx?id=130323",""]],"verses":[["خَلِّ حَبيبي عَلى صُدودُ","مَليحَهُ ما يَعمَلُ المِلاح",0,"ح",1,0],["خل حاشا ودع سوى واترك إلا","وعدا ما هنالك استثناء",1,"ا",2,0],["خلّ حبيبك لا يقلس","قدّه رمان نهدين",2,"ن",1,0],["خل ٍ حسين ٍ إلى من هل ّ بإ قباله","فلقة قمر ، في جبينه زين الأسلابي",3,"ب",2,0]]}