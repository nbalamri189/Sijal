{"poems":[[65,"من أغفل الحزم أدمى كفه ندما","https://www.aldiwan.net/poem46181.html","البسيط"],[53,"إذا تغنت شنطف مرة","https://www.aldiwan.net/poem65930.html","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39618","الرمل"],[102,"بيتٌ مِن الرِّيح","https://www.poetsgate.com/ViewPoem.aspx?id=183581",""],[102,"من أغني","https://www.poetsgate.com/ViewPoem.aspx?id=50152",""],[102,"خير ما في القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=50388",""],[98,"إليها","https://www.poetsgate.com/ViewPoem.aspx?id=17491",""],[96,"طمع الأقوياء","https://www.poetsgate.com/ViewPoem.aspx?id=15664",""],[366,"ان من يحفظ المودة أحرى","https://www.aldiwan.net/poem68108.html","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59123","البسيط"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131580",""],[1849,"","https://poetry.dctabudhabi.ae/diwan/poem/77682","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94316","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91296","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111425","الرجز"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127277","البسيط"],[4755,"لَمَّا طَغَى المَاء..","https://www.poetsgate.com/ViewPoem.aspx?id=183533",""],[5736,"من أغمد النصل بأضلعك","https://www.poetsgate.com/ViewPoem.aspx?id=208284",""]],"verses":[["مَنْ أغْفَلَ الحَزْمَ أدْمى كَفَّهُ نَدَما","واسْتَضْحَكَ النّصْرَ مَنْ أبْكى السّيوفَ دَما",0,"م",2,1],["منِ اغتدَى بعدَك يخشَى لظىً","لم يعتقد في اللَّه تعديلا",1,"ل",2,0],["من أغانيَّ التي استلهمتُها من شفتيها","من دموع مازجَتْ أدمعَها بين يديها",2,"ي",3,0],["مَن أغارَ الآنَ؟ قُل يا سَقفُ مَن","عَضَّ عُرقُوبَيكَ, مَن ذا شَقَّ سَطحَك؟",3,"ك",1,0],["من أغنّي ؟ لا حبيبا ؟ لا ؟ ولا","لي من الدنيا على الدنيا نصيب",4,"ب",1,0],["من أغسقَ الأيامَ يا ريحُ هل","تدري الثريا أيَّ مَسْرَىً تَجُوب",5,"ب",1,0],["من أغانيّ التي استل","همتها من شفتيها",6,"ي",3,0],["من أغاني طيورها ساجعات","قد تعلّمت هذه الأنغاما",7,"م",2,0],["من أَغَنّ لَو كانَ لِلبَدر جز","من سَناه أَقام شَهرا وَدَهرا",8,"ر",2,0],["مِنْ أغْصُنٍ نُعَّمٍ مَوَائِلْ","أوْ أشْمُسٍ مَا لَهَا غُرُوبْ",9,"ب",1,0],["من اغصان مائسه تمثر بأقمار","وتتلفت بأعناق الجآذر",10,"ر",1,0],["مَن اِغتَدى مَوطِّئاً أَكنافَه","صَحَّ لَهُ التَمهيدُ في أَحوالهِ",11,"ل",2,1],["من اغتذى بالنور جوفه خلا","ولم يكن يوما ليأتي الخلا",12,"ل",2,0],["من أَغيدٍ لحظاتُهُ","نعست فَأيقظَتِ الفتن",13,"ن",1,0],["من أَغنِيا أَرضٍ بها اَيسِيفُسُ","يَجرِي أَتَوا يَأمُرُهُم فَنذرُسُ",14,"س",1,0],["من اغتدى موقدا من دوحكم حطبا","يصلى بدنياه قبل الحشر نيرانا",15,"ن",2,0],["مَن أَغضَبَ البَحرَ! حتى هَاجَ مُندَفِعًا","بَينَ الحَنَايا كَمَا لَو أَنَّهُ كَمَدُ",16,"د",1,0],["من أغمدَ النصلَ العميقَ بأضلعِكْ ؟","منْ ذا ليغتالَ الطيوبَ بمرتعِكْ؟",17,"ك",1,1]]}