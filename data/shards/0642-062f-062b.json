{"poems":[[23,"أمسى الخلابيس قد عزوا وقد كثروا","https://www.aldiwan.net/poem21404.html","البسيط"],[85,"أعياد عزك للدنيا مجاليها","https://www.aldiwan.net/poem7533.html","البسيط"],[44,"الدار ناطقة وليست تنطق","https://www.aldiwan.net/poem30020.html","الكامل"],[69,"وافى الكتاب الذي تعنو له الكتب","https://www.aldiwan.net/poem29125.html","البسيط"],[46,"هل آن للقيد أن تفكه","https://www.aldiwan.net/poem23093.html","مجزوء البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43831","المديد"]],"verses":[["قَد ثَكِلَت أُمُّهُ مَن كُنتُ صاحِبَهُ","أَو كانَ مُنتَشِباً في بُرثُنِ الأَسَدِ",0,"د",1,0],["قد ثقلوك بنيرٍ من جلامد لا","تعده الأرض إلا من رواسيها",1,"ي",3,0],["قَد ثَقَّفَت مِنهُ الشَآمُ وَسَهَّلَت","مِنهُ الحِجازُ وَرَقَّقَتهُ المَشرِقُ",2,"ق",1,0],["قَدْ ثُجَّتِ الماءُ ثجاً فَهْوَ منسكب","ورُجَّتِ الأرضُ رجاً فَهْيَ تَضطربُ",3,"ب",1,0],["قَد ثَرَّبَت يَثرِبٌ عَلَيهِم","وَبِكَّةُ المُسلِمينَ بَكَّه",4,"ك",2,0],["قَد ثَوى عَبدُ الغَنِيِّ بطوبى","فَهَل العُقبى غَداً لِعَليِّ",5,"ي",1,0]]}