{"poems":[[23,"أمسى الخلابيس قد عزوا وقد كثروا","https://www.aldiwan.net/poem21404.html","البسيط"],[85,"أعياد عزك للدنيا مجاليها","https://www.aldiwan.net/poem7533.html","البسيط"],[44,"الدار ناطقة وليست تنطق","https://www.aldiwan.net/poem30020.html","الكامل"],[69,"وافى الكتاب الذي تعنو له الكتب","https://www.aldiwan.net/poem29125.html","البسيط"],[46,"هل آن للقيد أن تفكه","https://www.aldiwan.net/poem23093.html","مجزوء البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43831","المديد"],[458,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[506,"قد ثبت الغي في العباد","https://www.aldiwan.net/poem2439.html","مخلع البسيط"],[551,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"],[551,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["قَد ثَكِلَت أُمُّهُ مَن كُنتُ صاحِبَهُ","أَو كانَ مُنتَشِباً في بُرثُنِ الأَسَدِ",0,"د",1,0],["قد ثقلوك بنيرٍ من جلامد لا","تعده الأرض إلا من رواسيها",1,"ي",3,0],["قَد ثَقَّفَت مِنهُ الشَآمُ وَسَهَّلَت","مِنهُ الحِجازُ وَرَقَّقَتهُ المَشرِقُ",2,"ق",1,0],["قَدْ ثُجَّتِ الماءُ ثجاً فَهْوَ منسكب","ورُجَّتِ الأرضُ رجاً فَهْيَ تَضطربُ",3,"ب",1,0],["قَد ثَرَّبَت يَثرِبٌ عَلَيهِم","وَبِكَّةُ المُسلِمينَ بَكَّه",4,"ك",2,0],["قَد ثَوى عَبدُ الغَنِيِّ بطوبى","فَهَل العُقبى غَداً لِعَليِّ",5,"ي",1,0],["قد ثَبَتَ المعجِزُ لي في صدقِها","من طول ما صحَّ وما تَكرَّرا",6,"ر",2,0],["قد ثَبَتَ الغَي في العِباد","طائفةُ الكونِ والفَسَادِ",7,"د",1,1],["قد ثلم الدّهرُ ما بناهُ لكُمْ","وتاب ممّا جناه واِجترما",8,"م",2,0],["قَد ثَلَلْنا عروشَكمْ وَطَمَسنا","بِيَدِ الحقّ تلكُمُ الآثارا",9,"ر",2,0],["قد ثار بالكوفة ثم اعتقله","قالوا أبو مسلم حتى قتله",10,"ه",1,0]]}