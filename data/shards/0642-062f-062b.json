{"poems":[[23,"أمسى الخلابيس قد عزوا وقد كثروا","https://www.aldiwan.net/poem21404.html","البسيط"],[87,"أعياد عزك للدنيا مجاليها","https://www.aldiwan.net/poem7533.html","البسيط"],[46,"الدار ناطقة وليست تنطق","https://www.aldiwan.net/poem30020.html","الكامل"],[71,"وافى الكتاب الذي تعنو له الكتب","https://www.aldiwan.net/poem29125.html","البسيط"],[48,"هل آن للقيد أن تفكه","https://www.aldiwan.net/poem23093.html","مجزوء البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43831","المديد"],[463,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[511,"قد ثبت الغي في العباد","https://www.aldiwan.net/poem2439.html","مخلع البسيط"],[556,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"],[556,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138354",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122685","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202080","الخفيف"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101993","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112814","الخفيف"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35728","الرجز"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93695","الكامل"],[2546,"","https://poetry.dctabudhabi.ae/diwan/poem/33951","السريع"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102719","المواليا"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130750","الخفيف"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100510","الخفيف"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68022","الكامل"],[3407,"","https://poetry.dctabudhabi.ae/diwan/poem/105102","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62821","البسيط"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126976","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135158","المجتث"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136678",""],[4691,"ما أحيلى رؤيا هويفي تمرحْ","https://www.poetsgate.com/ViewPoem.aspx?id=61741",""],[5464,"كُتِبَ الوفاءُ عليَّ دون إرادتي","https://www.poetsgate.com/ViewPoem.aspx?id=125405",""],[5596,"تحت قدمي والدتي","https://www.poetsgate.com/ViewPoem.aspx?id=206782",""],[2546,"قد ثبت الخاتم فى بنصرى","https://www.poetsgate.com/ViewPoem.aspx?id=201431",""],[5956,"أوحى له جبريل","https://www.poetsgate.com/ViewPoem.aspx?id=192632",""],[6035,"الغيّ ياكسرى عَصِيّ كَيّه .. !","https://www.poetsgate.com/ViewPoem.aspx?id=177042",""],[6213,"مركب ووقود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76267&r=&rc=24",""],[463,"هوَّنَ باللَّيلِ عليها الغررا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60075&r=&rc=131",""]],"verses":[["قَد ثَكِلَت أُمُّهُ مَن كُنتُ صاحِبَهُ","أَو كانَ مُنتَشِباً في بُرثُنِ الأَسَدِ",0,"د",1,0],["قد ثقلوك بنيرٍ من جلامد لا","تعده الأرض إلا من رواسيها",1,"ي",3,0],["قَد ثَقَّفَت مِنهُ الشَآمُ وَسَهَّلَت","مِنهُ الحِجازُ وَرَقَّقَتهُ المَشرِقُ",2,"ق",1,0],["قَدْ ثُجَّتِ الماءُ ثجاً فَهْوَ منسكب","ورُجَّتِ الأرضُ رجاً فَهْيَ تَضطربُ",3,"ب",1,0],["قَد ثَرَّبَت يَثرِبٌ عَلَيهِم","وَبِكَّةُ المُسلِمينَ بَكَّه",4,"ك",2,0],["قَد ثَوى عَبدُ الغَنِيِّ بطوبى","فَهَل العُقبى غَداً لِعَليِّ",5,"ي",1,0],["قد ثَبَتَ المعجِزُ لي في صدقِها","من طول ما صحَّ وما تَكرَّرا",6,"ر",2,0],["قد ثَبَتَ الغَي في العِباد","طائفةُ الكونِ والفَسَادِ",7,"د",1,1],["قد ثلم الدّهرُ ما بناهُ لكُمْ","وتاب ممّا جناه واِجترما",8,"م",2,0],["قَد ثَلَلْنا عروشَكمْ وَطَمَسنا","بِيَدِ الحقّ تلكُمُ الآثارا",9,"ر",2,0],["قد ثار بالكوفة ثم اعتقله","قالوا أبو مسلم حتى قتله",10,"ه",1,0],["قد ثّبت الرحمن عرشكما على","دعم القلوب فقام لا ينهل",11,"ل",1,0],["قَد ثَقَّفَتكَ النّائياتُ بِحُكمِها","والرّمحُ لا يُرضيكَ غَيرَ مُثَقَّفِ",12,"ف",1,0],["قد ثقفت غمرات الحرب أكعبه","فطعنه بالكلا النحر موصول",13,"ل",1,0],["قَدْ ثَوَوْا من مراتب الدين مثْوى","قَصُرَتْ عَنْ بُلوِغهِ الأَوهام",14,"م",1,0],["قد ثقل الدل جفنيه فصوّلها","كأنه بسحيق الغنج مكتحل",15,"ل",1,0],["قد ثووت عندها البلايا وحطت","كم لها من كبيره وصغيره",16,"ر",2,0],["قَد ثَلِمَ الدَهرُ بِهِ ثُلمَةً","جانِبُها لَيسَ بِمَسدودِ",17,"د",1,0],["قَد ثقفت بحاسمه فَكأنَّها","كانَت قَناً معوجة فاقامها",18,"م",3,0],["قَد ثَبَتَ الخاتَمُ في خُنصَري","إِذ جاءَني مِنكِ تَجَنّيكِ",19,"ك",1,1],["قد ثوت في الثرا جلّ الذي كان ما زال","ما تهنيت لذّة والمدامع اسبال",20,"ل",1,0],["قد ثناها عن نيل ما تتمنى","مرض في القوى غدا قتالا",21,"ل",2,0],["قد ثوى في حمى الحسين العزيز ال","جار فاستوجب النعيم المقيما",22,"م",2,0],["قد ثويا وجملة العرضيين","خلف المقام بالرضى محبورين",23,"ن",1,0],["قد ثويا في تربة تنمى لأو","لاد الملوك هكذا لنا رووا",23,"و",3,0],["قد ثُقِّفوا للحربِ تثقيفَ الظُّبا","وبفنِّ قانونِ الحروب تَدفَّقوا",24,"ق",3,0],["قد ثل في الإسلام منها غلمة","وليّ بعز المسلمين صغارها",25,"ر",3,0],["قد ثقّفَ الغزوُ منها فهي مُخطَفَةٌ","خُصورهنّ كأوساطِ الزّنابيرِ",26,"ر",1,0],["قد ثوى المجد في ثراه فحقاً","أرخوه المجد في خير مرقد",27,"د",1,0],["قد ثم فوق المعالي","وللفساد ثميم",28,"م",1,0],["قد ثوت في حجا الملاهى وأوهت","فى هواها بأسى وبدّت حجائى",29,"ا",2,0],["قد ثَوى قلبُه لديكَ وأضحى","ناحلَ الجسم في رُبى جصان",30,"ن",1,0],["قد ثبتنا على الوداد هويفي","وسوانا إلى السلوِّ تزحزحْ",31,"ح",1,0],["قدْ ثابَ لو أنَّ الجنونَ يَثوبُ","وأجابَ لو أنَّ القتيلَ يُجيبُ !",32,"ب",1,0],["قد ثار قبل الفجر ثم تواترت","رعداته لتقض هاني المضجع",33,"ع",1,0],["قد ثبت الخاتم فى بنصرى","إذ جاءنى منك تجنّيك",34,"ك",1,1],["قد ثَبَّتَ الأعلى القديرُ رسالةً","لنبيّهِ وتتابعَ الإيحاءُ",35,"ا",2,0],["قد ثُلَّ عرشُك يابن كسرى فانْكَفِئْ","وَخُذِ النَوَافِقَ والفلولَ الرَّاسِفَةْ !",36,"ف",2,0],["قد ثبتت بين الضلوع زعانف","تزهو كرمح مستدب الجانب",37,"ب",1,0],["قدْ ثبتَ المعجزُ لي في صدقها","منْ طولِ ما صحَّ وتكرَّرا",38,"ر",2,0]]}