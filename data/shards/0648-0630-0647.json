{"poems":[[79,"النصر نصك والحسام دليله","https://www.aldiwan.net/poem36377.html","الكامل"],[53,"قد لعمري اقتصصت من كل ضرس","https://www.aldiwan.net/poem65806.html","الخفيف"],[93,"من أين جئت وكيف عجت ببابي","https://www.aldiwan.net/poem8751.html","عموديه"],[93,"ما للهموم الطارقات ومالي","https://www.aldiwan.net/poem62625.html","عموديه"],[93,"إني مررت على الرياض الحاليه","https://www.aldiwan.net/poem62822.html","عموديه"],[94,"قد سكرنا بحبنا واكتفينا","https://www.aldiwan.net/poem38928.html","الخفيف"],[107,"أدر الحديث وطف على الأقوام","https://www.aldiwan.net/poem42048.html","الكامل"],[107,"إني نصحتك فاتهمت نصيحتي","https://www.aldiwan.net/poem43108.html","الكامل"],[83,"تجلى شهاب للسعادة آفل","https://www.aldiwan.net/poem61333.html","الطويل"],[41,"قل في شط نهروان اغتماضي","https://www.aldiwan.net/poem53771.html","الخفيف"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[69,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[77,"قامت تميس كما تدافع جدول","https://www.aldiwan.net/poem69047.html","الكامل"],[52,"يا بان ضاق المذهب","https://www.aldiwan.net/poem64810.html","مجزوء الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39636","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54710","الكامل"],[108,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[102,"شاعر الكأس والرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=50185",""],[102,"في طريق الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=50125",""],[102,"كلّنا في انتظار ميلاد الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=50117",""],[244,"الله ربي والحنيفةُ ديني","https://www.aldiwan.net/poem1095.html","الكامل"],[276,"أفي نيابتي برع تقيم","https://www.aldiwan.net/poem52116.html","الوافر"],[310,"وذهبي نمر فضضوه بسكر","https://www.aldiwan.net/poem56454.html","البسيط"],[310,"وذهبية الجلباب فضية الحشا","https://www.aldiwan.net/poem56471.html","الطويل"],[327,"أضحت أميمة لا ينال زمامها","https://www.aldiwan.net/poem56344.html","الكامل"],[347,"هاك قلبي واعطني قلبا","https://www.aldiwan.net/poem55380.html","مجزوء الرمل"],[347,"ألق الدنيا حباب","https://www.aldiwan.net/poem55384.html","مجزوء الرمل"],[369,"البحر أجمع لو غدا أنقاسي","https://www.aldiwan.net/poem60869.html","الكامل"],[396,"الحمد لله مسعف كل سائل بسول","https://www.aldiwan.net/poem54537.html","عموديه"],[396,"الحمدلله حمدا موافيا بالنوال","https://www.aldiwan.net/poem54549.html","عموديه"],[406,"أنا ناطق باسم الشباب","https://www.aldiwan.net/poem6794.html","عموديه"],[409,"أجاب الدمع من قبل اللسان","https://www.aldiwan.net/poem33393.html","الوافر"],[409,"لعل زمانا بالوصال يجود","https://www.aldiwan.net/poem33976.html","الطويل"],[409,"وقفت على السؤال وما حواه","https://www.aldiwan.net/poem34131.html","الوافر"],[412,"هبوا أن سجني مانع لوصاله","https://www.aldiwan.net/poem50136.html","الطويل"],[458,"رف الربيع على الشتاء الماحل","https://www.aldiwan.net/poem61771.html","الكامل"],[469,"يا طارداً بالهجر لهوي","https://www.aldiwan.net/poem3408.html","عموديه"],[505,"والذي علم القلوب المعاني","https://www.aldiwan.net/poem37736.html","الخفيف"],[505,"أتانا من صبا نجد نسيم","https://www.aldiwan.net/poem37783.html","الوافر"],[505,"لله من جفن هملن دموعه","https://www.aldiwan.net/poem37965.html","الكامل"],[543,"قد رمت وصفك وهو شيء يلزم","https://www.aldiwan.net/poem47954.html","عموديه"],[580,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"],[678,"","https://poetry.dctabudhabi.ae/diwan/poem/142206","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87017","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48541","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77663","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77535","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77549","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62653","الكامل"],[1011,"","https://poetry.dctabudhabi.ae/diwan/poem/124614","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136264","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46526","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50006","المتقارب"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79910","المتقارب"],[1776,"","https://poetry.dctabudhabi.ae/diwan/poem/84765","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52120","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52071","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71055","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110341","الكامل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120735","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106836","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106865","الكامل"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76023","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201563",""],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74102","الكامل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86264","الطويل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128944","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111510","الرجز"],[4087,"","https://poetry.dctabudhabi.ae/diwan/poem/131678",""],[4091,"","https://poetry.dctabudhabi.ae/diwan/poem/141847","الطويل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136914",""],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81297","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81286","الخفيف"],[4291,"","https://poetry.dctabudhabi.ae/diwan/poem/142467","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76682","الكامل"],[4677,"أسقيت زهرك","https://www.poetsgate.com/ViewPoem.aspx?id=203957",""],[5082,"أطيافٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212387",""],[5163,"عراق","https://www.poetsgate.com/ViewPoem.aspx?id=34064",""],[5277,"حصان ديمقراطي","https://www.poetsgate.com/ViewPoem.aspx?id=186056",""],[5358,"نطقتْ","https://www.poetsgate.com/ViewPoem.aspx?id=201485",""],[5442,"نمت ولم يجف كراك الجفون","https://www.poetsgate.com/ViewPoem.aspx?id=114769",""],[5500,"على سبيل الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=190252",""],[5542,"مشاهد من يوم القيامة","https://www.poetsgate.com/ViewPoem.aspx?id=10202",""],[5561,"آثار مجدك","https://www.poetsgate.com/ViewPoem.aspx?id=192893",""],[5628,"أنا وأنت والمستحيل","https://www.poetsgate.com/ViewPoem.aspx?id=178445",""],[5853,"((ناديتني))...على لسان الأنثى","https://www.poetsgate.com/ViewPoem.aspx?id=175647",""],[5956,"غَنَمٌ هَرَبْنَ من الحظيرة للشارع","https://www.poetsgate.com/ViewPoem.aspx?id=183499",""],[5970,"جهل الناس والزمان ومالي","https://www.poetsgate.com/ViewPoem.aspx?id=130595",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""]],"verses":[["وَذَهَبْتَ تَعْتَامُ الْبُيُوتَ مُيَمِّماً","مَا يَمِّمَتْ أذْوَاؤُهُ وَقُيُولُهُ",0,"ل",2,0],["وذهبْنا إلى امتحانِك للبُقْ","يا وما كان عمْدُنا لامتهانِك",1,"ك",1,0],["وَذَهَبتَ في عَرضِ الفَضاءِ كَخَيمَةٍ","رُفِعَت بِلا عُمُد وَلا أَطنابِ",2,"ب",1,0],["وَذَهَبتُ أَختَرِقُ المَسالِكَ مُدلِجاً","وَكَأَنَّما أُطلِقتُ مِن أَغلالِ",3,"ل",1,0],["وَذَهَبتُ أُنشِدُها فَأَعيا خاطِري","حَتّى نَظَرتُ إِلى بَناتِ بِلادي",4,"ي",1,0],["وذهبنا بَلُبِّهِ وهو رُوحٌ","وَتَركنا القُشُورَ وهيَ جَمادُ",5,"د",1,0],["وذَهَبْتَ تذكرُ للأُلىَ اتَّبعوا العَمَى","ما فيهِ مِن سُنَنِ ومن أحكامِ",6,"م",1,0],["وَذَهَبتَ تَركَبُ كُلَّ رَأيٍ جامِحٍ","حَتّى طَحا بِكَ ما تَقولُ وَتَفعَلُ",7,"ل",1,0],["وَذِهنٌ هُوَ المِصبَاحُ لَكِن فَرَاشُهُ","صًرُوفُ الدُّنَا وَالحَادِثَاتُ النَّوَازِلُ",8,"ل",1,0],["وَذَهَلتُ الصَبا وَأَرشَدَني اللَ","هُ بِدَهرٍ ذي مِرَّةٍ وَاِنتِقاضِ",9,"ض",1,0],["وذهلنا عند اللقاء وكم أَذْ","هَلَ صَبَّاً من الحَبيبِ لِقاءُ",10,"ا",2,0],["وذُهِلْتُ لا أدْرِي بمَا أنا ماثلٌ","بِشَذا نَسِيمٍ أَوْ بِشَدْوِ حَمامِ",11,"م",1,0],["وذهَبْتِ عنّي بالشَّبيبَةِ فاردُدي","ثوبي الّذي قد كنْتُ فيه أرفُل",12,"ل",1,0],["وَذَهَبتُ في غَيرِ السَبي","لِ لِكُلِّ غاوٍ مَذهَبُ",13,"ب",1,0],["وذهبتُ ألتمسُ السلوَّ وأطلقتْ","نفسِي زِمامَ جوادها الركَّاضِ",14,"ض",1,0],["وَذَهَابَهَا بِرؤُوسِهَا صُعُداً","مِنْ مَوْضِعِ التَّصْويبِ فِي الوَادِي",15,"د",2,0],["وذهبت تقتنصُ الطيو","رُ فكنتَ من حَبِّ الحصيد",16,"د",1,0],["وذهول الإلهام يرعش عينيك","كما ترعش الصبا الأقحوانا",17,"ن",2,0],["وذهول كأنّه فيلسوف","غاب في صمته يناجي الحقيقة",18,"ق",2,0],["وذهبنا وفي دمانا حنين","جائع ينخر الضلوع ويفري",19,"ر",2,0],["وذه الطرائق والقباب مشيدة","من بيننا أثر من التوهين",20,"ن",1,0],["وَذهبان وَفي عمق وَحلى","تساورها المفاوز وَالرسوم",21,"م",1,0],["وَذَهبيّ نمرٍ فَضّضوه بسكّرٍ","وَحَشوا حشاهُ لبّ جوزٍ وفستقِ",22,"ق",1,1],["وَذَهبيّة الجلبابِ فضيّةِ الحشا","زُمرّديّةِ الإكليلِ مسكيّةِ العرفِ",23,"ف",1,1],["وَذَهابُ هَمّي وَصلُ من عُلِّقتُهُ","وَهنانَةً يَشفي السَقيمَ كَلامُها",24,"م",3,0],["وذهول عن حياة","كل ما فيها هباء",25,"ا",2,0],["وذهاب في فضاء ال","فكر يتلوه اياب",26,"ب",1,0],["وذهْبْتَ عن رَأْسي وسِرْتَ فلا تَسلْ","ما مَرَّ بعدَك للفِراقِ براسي",27,"س",2,0],["وذه ذنوب كباير عند أهل العقول","كن عبد مملوك راضي وايش لك من فضول",28,"ل",1,0],["وذه مسائل قريبه من كلام الغزال","نرجو لعارف لها عامل بها أن ينال",29,"ل",1,0],["وذهبتُ من بابٍ إلى بابٍ","أرى صَدَّاً يزيدُ توجَّعي وسَقامي",30,"م",2,0],["وذهنك صارم يغري المعاني","كفَرْيِكَ للعدا يوم الطعان",31,"ن",1,0],["وذهنك قد أعطى أقاليم بحثه","عليه لواء خافق وبنود",32,"د",1,0],["وذهَّبوا الضعيف وقرروه","وما خافوا مناقشة الحساب",33,"ب",1,0],["وَذهنٍ لَو الكافور يمنع حَرَّه","لأَزري بفخر المِسكِ عند اعتمالِهِ",34,"ل",2,0],["وذهبت لا هذى الدموع سخينة","تكفى لتبيان العذاب الجائل",35,"ل",1,0],["وذهبتَ لا تحنو على","دنفٍ ولا ترثي لنضو",36,"و",1,0],["وذَهَبْنا مِنكُمْ إليكُمْ بِرُكْبا","نِ قُلوبٍ بالشَّوقِ شَبَّ لَظاها",37,"ا",3,0],["وذُهلَةِ همَّةٍ عن كلِّ غيرٍ","تفوقُ ذُهولَ أَصحابِ الرَّقيمِ",38,"م",1,0],["وذَهِلْتُ لا نُطقي تُدارُ حُروفُهُ","بفَمي ولا صوتي يَجولُ شُرُوعُهُ",39,"ع",2,0],["وذهبتَ في كَنَفِ الإلهِ يَحُفُّكُم","وجناحُ حِفظِهِ في الإيابِ مُخَيِّمُ",40,"م",1,0],["وذَهَلْت عن شَمْس الصبا","حتَّى تَوارَتْ بِالحِجَابِ",41,"ب",1,0],["وذهبت تقتاتين تغتسلين في موج الصخب","والصمت لو تدرين أبلغ من ملايين الخطب",42,"ب",1,0],["وَذهن ثاقب في كُل فَنٍّ","عَن الإشكال لَست تَراه يَخلو",43,"ل",2,0],["وذَهِّبي أُفْقَ حيا","تي بضياء يسحر",44,"ر",1,0],["وَذهنك الثاقِبُ في الأُمور","يَسري إِلى ظُلمتها بِالنور",45,"ر",1,0],["وَذَهَب السُلطان للسرايه","مُجَرَّد العَقل عَن الدِرايه",46,"ه",1,0],["وَذَهَب البيض مَع الدجاج","وَعَدم المالُ مَع الخراج",47,"ج",1,0],["وذهلتُ مثل نسيته","وكلاهما معنى غفل",48,"ل",1,0],["وذه البهائم صائمات كظّماً","شرعٌ لديها مسرحٌ ومراح",49,"ح",1,0],["وذه البغاة طائفاً سدّت بها","طرق الرفاق غدُوّهم ورواح",49,"ح",1,0],["وذه السفائنُ عوّقت لما بدا","من حزبهن تصَعّب وجماح",49,"ح",1,0],["وذهبت في وصف العيان بغايتي","واقمت في حاني لنفع صديقي",50,"ق",2,0],["وَذَهَب الصياد عَنهُ وَبَقى","مُنطَرِحاً في حيرة لما لَقى",51,"ق",2,0],["وذهل تجود أيادي يديهِ","لكل رهين إذاً بالفكاكِ",52,"ك",1,0],["وذهنُك لو لم يكن روضةً","لما أتحفتنا بأورادها",53,"د",3,0],["وَذَهَبنا قَصدَ التَنَز","زُهِ نابِذينَ لِكُلِّ عائِقِ",54,"ق",1,0],["وذهلت في تشبيهها","إذ قلت فيها العسجد",55,"د",1,0],["وَذَهَلْتُ عَنْ قَولِ العَوَاذِلِ مَالَهُ","خَلَعَ العِذَارَ لِبارِقٍ يَتَألَّقُ",56,"ق",1,0],["وذُهولي عن لحاقي بِأبي","في قرار القُدْسِ في مَغْنى الدَّعَهْ",57,"ع",2,0],["وذهبت عن دنياك وهي تشد ذي","ل الثوب منك تريد أن لا تذهبا",58,"ب",2,0],["وذُهِلتَ عن هذا الوجود مُغَيِّباً","لمَّا لمحتَ من الجمالِ مَلاَمِحَا",59,"ح",2,0],["وذهبتِ خطبُكِ فادحٌ لكنما","موتُ العفاف اليومَ خطبٌ أفدح",60,"ح",1,0],["وذهبتُ في الدنيا على قدمِ","يسعى بها جدي الذي عثرا",61,"ر",2,0],["وذهبت دولتهم وزالت","وأيّ حالٍ في الورى ما حالت",62,"ت",1,0],["وذهب الملك العضوض من بده","وبايعوا للمستعين ولده",62,"ه",1,0],["وَذِهنٍ كَأَنَّ النارَ مِنهُ تَوَقَّدَت","فَلَولا نَداهُ كانَ من يَدنُ يُحرَقِ",63,"ق",1,0],["وذهبت نحو البيت مبتدراً","من سرعتي لا أُبصر السبُلا",64,"ل",2,0],["وَذَهبت لا أسفاً عَلى الد","دنيا وَلا متندّما",65,"م",2,0],["وَذهن اذا ما اعوز الشَمس ضوها","رَأَيناهُ اضحى من 