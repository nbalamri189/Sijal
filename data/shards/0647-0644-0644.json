ناظر","https://www.aldiwan.net/poem47795.html","الكامل"],[551,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[558,"عن يمين الحي من إضم","https://www.aldiwan.net/poem34197.html","المديد"],[558,"حبسوا طير الهوى في قفص","https://www.aldiwan.net/poem34424.html","الرمل"],[559,"هل لكم في شرب صهبا مزجت","https://www.aldiwan.net/poem69360.html","الرمل"],[562,"هل للذي في حشاه حزن يعقوب","https://www.aldiwan.net/poem52873.html","البسيط"],[566,"هل للفتى من بنات الدهر من واق","https://www.aldiwan.net/poem1928.html","البسيط"],[586,"فضحت جيد الغزال بالجيد","https://www.aldiwan.net/poem17492.html","المنسرح"]],"verses":[["هَل لِداءٍ بَينَ جِسمٍ","وَفُؤادٍ مِن طَبيبِ",0,"ب",1,0],["هَل لَكُم أَن نَقومَ نَبكي جَميعاً","وَنَشُقَّ الجُيوبَ بِاللَهِ قوموا",1,"م",3,0],["هلْ لهَذا البَيْنِ منْ مُجتَمَع","أوْ لهَذا المُرْتَجى منْ مُرْتَجَعْ",2,"ع",1,0],["هَلَّلتُ حينَ لَمَحتُ نورَ جَبينِهِ","وَرَجَوتُ فيهِ الخَيرَ حينَ تَأَلَّقا",3,"ق",2,0],["هَلَّلتُ حينَ رَأَيتُ رَكبَكَ سالِماً","وَرَأَيتُ عَبّاساً بِهِ يَتَبَسَّمُ",4,"م",1,0],["هَل لِلخَيالِ وَلِلحَقيقَةِ مَنهَلٌ","لَم يَبغِهِ الرُوّادُ في ديوانِهِ",5,"ن",2,0],["هَل لِداعيكَ مُجيبُ","أَم لِشاكيكَ طَبيبُ",6,"ب",1,1],["هَل لِخالي زَمانِنا مِن رُجوعٍ","أَم لِماضي زَمانِنا مِن مَكَرِّ",7,"ر",1,0],["هل لسام أو حافظ أو لاسما","عيل فيمن أجاد شعراً نظير",8,"ر",1,0],["هَلْ لِي تَأَسٍّ بَعْدَ بَيْنِكَ وَأَلأَسَى","غَلَبَ الْعَزَاءَ وَبَاتَ مِلْءَ جَنَانِي",9,"ن",2,0],["هَلْ لِلْفَتَى عُمْرَانِ يُفْنِي فِيهِمَا","قَلْبَيْنِ بَيْنَ النَّقْضِ وَالإبْرَامِ",10,"م",1,0],["هل للشباب الذي قد فات من طلب","أم ليس غائبه الماضي بمنقلبِ",11,"ب",1,1],["هل لحال من اقتياض بحال","رب مغبون صفقة غير آلِ",12,"ل",1,1],["هَل لِلفَصاحَةِ وَالسَما","حَةِ وَالعُلى عَنّي مَحيدُ",13,"د",1,1],["هَل لِصَبٍّ مُتَيَّمٍ مِن مُعينٍ","وَلِداءٍ مُخامِرٍ مِن طَبيبِ",14,"ب",1,0],["هل لثمةٌ منك مثل الرَّاح عند فَمي","وعند عاذليَ الغيرانِ كالبنج",15,"ج",1,0],["هل لكَ يا أرفع البرايا","في قريةٍ شأنها رفيع",16,"ع",1,1],["هل لك في منّةٍ تغيث على","جور عزيزٍ في قلبه حمق",17,"ق",1,0],["هللي يا ربا المدينة واهمي","بسخي الأظلال والأنداء",18,"ا",2,0],["هل للمحرَّبِ غيره","في كل نائبةٍ مَصيرُ",19,"ر",1,0],["هل للقلوب من العيونِ خلاصُ","أم لا فإن عزاءها معتاصُ",20,"ص",1,1],["هل لقوم إلا بقوميَ حلٌّ","أم لقوم إلا بقوميَ ربطُ",21,"ط",1,0],["هل لديه لك سرٌّ ذائعٌ","أم أمانات غدت مُحتجنه",22,"ن",2,0],["هل لديه تُحفةٌ مذخورة","عنك أم منفوسةٌ مُختزنه",22,"ن",2,0],["هَل لاحَ لَهُ وَجهٌ عَرَفا","أَم هَزَّ جَوارِحَهُ نَغَمُ",23,"م",1,0],["هل لمن يرقدون في الالحاد","يقظة بعد كل هذا الرقاد",24,"د",1,1],["هَل لَكَ في أَن أَرشِدَ الإِنسانا","لِيَعرِفَ المَكانَ وَالإِمكانا",25,"ن",2,0],["هَل لَكُم في نَبَإِ خَيرِ نَبَأ","حِليَةِ التاريخِ مَأثورٍ عَظيم",26,"م",1,0],["هَلْ لَكُمَا في اصْطِباحِ كَأْسٍ","وفي نُهُوضٍ إلى تَحاسِي",27,"س",2,1],["هَل لِعُذري عِندَ الهُمامَ أَبي الفَض","لِ قُبولٌ سَوادُ عَيني مِدادُه",28,"د",2,0],["هَل لِلنَدى عَدلٌ فَيَغدو مُنصِفاً","مِن فِعلِ إِسماعيلِهِ اِبنِ شِهابِهِ",29,"ب",2,1],["هَل لَكَ في الصُلحِ فَأُعفيكَ مِن","نِصفٍ وَتَستَأنِفُ لي نِصفا",30,"ف",2,0],["هَل لَكَ في الحَمدِ تَستَبِدُّ بِهِ","أُخرى اللَيالي وَالشُكرِ تَرتَهِنُه",31,"ن",2,0],["هل لك يا ابن غاليه","في قهوة وشاديه",32,"ي",2,1],["هَلْ للعَليلِ سوى ابنِ قُرَّةَ شَافي","بعدَ الإلهِ وهل له من كافي",33,"ف",2,1],["هَلْ للمَكارمِ من مُجيرِ","أم هَل لأحمدَ من نَصيرِ",34,"ر",1,1],["هَل للوزيرِ أدامَ اللهُ دولتَه","في صاحب ٍيتحرَّى نُصْحَ مَنْ صَحِبا",35,"ب",2,1],["هل للغَنِيَّيْنِ عُذْرٌ في اغتصابِهِما","حَلْياً يَبوء بأَوفْى اللَّعنِ غاصِبُه",36,"ب",2,0],["هَل لِمَطلوبٍ بِذَنبٍ","تَوبَةٌ مِنهُ نَصوحُ",37,"ح",1,0],["هل لي إلى مكةَ منْ عودةٍ","فأبلغ السؤلَ وأقضي الديونْ",38,"ن",1,1],["هَل لَكَ اليَومَ إِن نَأَت أُمُّ بَكرٍ","وَتَوَلَّت إِلى عَزاءٍ طَريقُ",39,"ق",1,0],["هَل لِمَتبولٍ بِها مُستَقبَلٌ","دَنَفِ القَلبِ عَميدٍ غَيرِ صاح",40,"ح",1,0],["هَلَ لَدَيَّ اليَومَ مِنهُ سِوى","طولِ قَرعِ السِنِّ مِن نَدَمِ",41,"م",1,0],["هل للهدايةِ منكَ لوعةُ جازعٍ","أم للحَميَّةِ فيك لهفةُ عانِ",42,"ن",1,0],["هَل لامرِئٍ في الأَرضِ بَعدَ بِلادِهِ","مَجدٌ يَزينُ بِهِ الحَياةَ وَسُؤدُدُ",43,"د",1,0],["هَل ليمَ نَضوُ صَبابَةٍ فَأَفاقا","أَم سيمَ صَبراً في الهَوى فَأَطاقا",44,"ق",2,1],["هل لديكُمْ سياسةٌ غير هذا ال","قول يُحيي من النفوس قواها",45,"ا",3,0],["هَل لَكَ في مَغفِرَةٍ عَن جُرمِ","وَقُبلَةٍ تُريحُني عَن هَمّي",46,"ي",1,0],["هَل لِلأَغَرِّ ذَنبٌ","إِن لَم يَكونوا غُرّا",47,"ر",2,0],["هَل لَكَ في لَيلَةٍ بَيضاءَ مُقمِرَةٍ","كَأَنَّها فِضَّةٌ ذابَت عَلى البَلَدِ",48,"د",1,1],["هَل لِدُنيا قَد أَقبَلَت نَحوَنا دَه","راً فَصَدَّت وَلَيسَ مِنّا صُدودُ",49,"د",1,0],["هلْ للفتى في العَيشِ مِن مَندوحَةٍ","إلاّ اصطِفاءُ مَوَدّةِ الإخْوانِ",50,"ن",1,0],["هل للدُّمستق بعد ذلك رَجْعَةٌ","قُضِيَتْ بسيفك منهمُ الأوطار",51,"ر",1,0],["هل لي إلى الفرْدوْسِ من إذنٍ وقَدْ","شارَفْتُ باباً دونَها مفتوحَا",52,"ح",2,0],["هَل لَكَ وَالهَلُّ خِيَر","فيمَن إِذا غِبتَ حَضَر",53,"ر",1,0],["هَل لَكَ أَن تَطرُدَ النُعاسَ فَقَد","طابَ اِنضِواعُ المُدامِ وَالآسِ",54,"س",1,0],["هَل لِدِيارٍ حَيَّيتَها دُرُسِ","مِن صَمَمٍ ما هَتَفتَ أَو خَرَسِ",55,"س",1,1],["هَل لَكَ أَن تَغدو عَلى قَهوَةٍ","تُسرِعُ في المَرءِ إِذا أَسرَعا",56,"ع",2,0],["هَل لَكَ في عَذراءَ مَمكورَةٍ","يَزينُها صَدرٌ لَها فَخمُ",57,"م",1,0],["هل للغلام الذي كلفتَ بهِ","كخدّها إذ يلوحُ في خجلِه",58,"ل",2,0],["هَل لَكَ في مالي وَعِرضي مَعاً","وَكُلِّ ما يَملِكُ جَيرانِيَه",59,"ه",1,1],["هَل لَكِ بِالآباءِ مِن خِبرَةٍ","كَم والِدٍ في زَمَنٍ تَنسِبين",60,"ن",1,0],["هل لِمحزونٍ كئيبٍ قُبْلةٌ","مِنْكَ يَشفي بَردُها حرَّ الغَليلْ",61,"ل",1,0],["هل لما ليس ينتهي","عمرك اللَه خالق",62,"ق",1,0],["هَل للذي يحيا عَلى","حوبائه هذي السياده",63,"د",2,0],["هَل للألى فقدوا السجا","يا ما يسدُّ لها مسدّا",64,"د",2,0],["هل لقوم ساروا نزوعٌ إلى الأه","ل ترى أو إلى الدار التفات",65,"ت",1,0],["هل لعذري إلى الإمام أبي الفض","ل قبولٌ سواد عيني مداده",66,"د",2,0],["هَل لَهُ إن لَم يَمُت في قَعَصٍ","مِن غِنَاهُ غَيرُ قَبرٍ وكَفَن",67,"ن",1,0],["هَلْ لِسَلامِ الْعَلِيلِ رَدُّ","أَمْ لِصَبَاحِ اللِّقَاءِ وَعْدُ",68,"د",1,1],["هَلْ لِلْمَكارِمِ مَنْ يُحْيِي مَنَاسِكَهَا","أَمْ لِلضَّلالَةِ بَعْدَ الْيَوْمِ مِنْ هَادِي