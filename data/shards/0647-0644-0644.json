3,0],["هَل لِلمُحب المُستَهام رَفيقُ","أَم هَل إِلى الصَبر الجَميل طَريق",148,"ق",1,1],["هَل لِهَذا القَلبِ سَمعٌ أَو بَصَر","أَو تَناهٍ عَن حَبيبٍ يُدَّكَر",149,"ر",1,0],["هل لمن يرتجي البقاء خلود","وسوى الله كل حي يبيد",150,"د",1,1],["هَل لِشبابٍ فات من مَطلب","أم ما بُكاءُ البائسِ الأَشيبِ",151,"ب",1,1],["هَلْ لِطرفي منكَ يوماً نظرةٌ","رَيْثما ينْدَمِلُ القَلبُ الجَريحُ",152,"ح",1,0],["هَلْ لِمَنْ أتْلَفْتَ مُهجَتّهُ","يا شقيقَ النَّفسِ مِنْ حكَمِ",153,"م",1,0],["هَلْ لَنَا من يوم نصرٍ أبيضٍ","يُقصَرُ الباطلُ فيهِ ويُضامُ",154,"م",1,0],["هَلْ لنَا مِن حملاتٍ في الوغى","في العِدَى يندكُّ منهنّ شمام",154,"م",1,0],["هَلْ ليَدْرِ الحقّ يا للهِ مِنْ","بعدما قد نالَه المحْقُ تمامُ",154,"م",1,0],["هل للنوى عهد يعرفه","أو ماله رسم ولا حَدُّ",155,"د",1,0],["هَلْ للقلوبِ من العيونِ مَلاذُ","ولها على مكنونِها اسْتِحواذُ",156,"ذ",1,1],["هل لركْبِ العراقِ بعدَ نُجودِه","أوبةٌ تقتضي دنوّ بَعيدِهْ",157,"د",2,1],["هل لي إلى عصر الشباب","بعد التصرم من إياب",158,"ب",1,1],["هلّلت عصبةُ المعارف طرّاً","وبما نلت هنأتك البلاد",159,"د",1,0],["هل للأمير أعز الله حكمته","أن ينقذ الشعب من ضيم يعانيه",160,"ي",2,1],["هل لك بالنازلات دون مِنىً","يا عَلَم الشوقِ بعدنا عِلْمُ",161,"م",1,0],["هل لكما من عِلْمِ","بالطارق الملِّمِ",162,"م",1,1],["هل لك في ودٍّ على شحط النوى","صفَا على غِشِّ المودّات ورَقّْ",163,"ق",1,0],["هل لقتيلٍ على اللوى ثائرْ","أم هل لليلِ المحبِّ من آخرْ",164,"ر",1,1],["هل للزمان وقد جلَّتْ جرائمُهُ","وأضعف الخطب من تلقائه الجلدا",165,"د",2,1],["هل لأيّام الحمى من عودةٍ","وإذا اليأسُ تمادى قلتُ هل",166,"ل",1,0],["هل لي حوار لما قد أحرقت جنني","عرج أخي حمى ليلى ومنعرج",167,"ج",1,0],["هل لي حوار لما قد أحرقت جنني","كم عذبتني بنار البين والوهج",167,"ج",1,0],["هل للوزارة حاجة أو حجة","ترجو تتمة بعضها بكمال",168,"ل",1,0],["هَلْ لي إلَى هَجْرِهِمُ مِنْ سَبِيلْ","قَدْ كَدَّرَ الخاطِرَ قالٌ وقيلْ",169,"ل",1,1],["هَلْ لِذا الهَمِّ انْفِراجُ","وَلِذا الكَرْبِ ابْتِهاجُ",170,"ج",1,1],["هل لا يزالُ المكرُ","والذَكاءُ طبعَ البائِيَه",171,"ي",2,0],["هل لِي إلى الوجه المحجَّبِ نظرةٌ","ترم