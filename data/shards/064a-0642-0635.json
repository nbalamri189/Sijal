te.com/ViewPoem.aspx?id=30195",""],[5085,"سقتني الدمع","https://www.poetsgate.com/ViewPoem.aspx?id=188440",""],[5183,"قال","https://www.poetsgate.com/ViewPoem.aspx?id=186485",""],[5277,"تباريحٌ بغدادية","https://www.poetsgate.com/ViewPoem.aspx?id=202456",""],[5434,"الشاور غشاني","https://www.poetsgate.com/ViewPoem.aspx?id=37612",""],[3294,"أبى المجد الذي يأبى سواه","https://www.poetsgate.com/ViewPoem.aspx?id=173251",""],[5544,"عبري","https://www.poetsgate.com/ViewPoem.aspx?id=213406",""],[5582,"أَأَسْطُرُ إِعْجامٍ تَراءَتْ وَأَحْرُفُ","https://www.poetsgate.com/ViewPoem.aspx?id=63536",""],[5648,"هواجيس الجفا","https://www.poetsgate.com/ViewPoem.aspx?id=154840",""],[5916,"سَلُوْ بَلْقَيْسَ","https://www.poetsgate.com/ViewPoem.aspx?id=190525",""],[5956,"جلادُ بيتي ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182553",""],[5956,"نفحاتٌ وحِكَمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=192564",""],[5956,"شكراً لتلفاز الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=193473",""],[6093,"فَازَ بِالشِّعْرِ ظَرِيْفْ ( مجزوء الرمل)","https://www.poetsgate.com/ViewPoem.aspx?id=180593",""],[6251,"عزة النفس .. إلى الرئيس إبراهيم الحمدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76482&r=&rc=22",""],[6355,"جار لا خير فيه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66672&r=&rc=132",""]],"verses":[["يَقُصُّ وَمِن غَيرِ سَهمٍ أَصابَ","وَيَرمي وَمِن غَيرِ قَوسٍ رَمى",0,"ا",1,0],["يُقصونَ ذا الأَنفِ الحَمِيِّ وَفيهِمُ","حِلمٌ وَلَيسَ حَرامُهُم بِحَلالِ",1,"ل",1,0],["يقَصِّرُ عنْ أمْداحِهِ كلَّ مادِحٍ","وهَيْهات يُحْصى الرّمْلُ أو يُحْصَرُ القَطْرُ",2,"ر",1,0],["يقَصِّرُ نَفْحُ الطّيبِ عنْ طِيبِ ذِكْرِهِ","ويُزْري بأزهارِ الرِّياضِ امْتِداحُهُ",3,"ح",2,0],["يُقَصِّرُ قُربُكَ لَيلي الطَويلا","وَيَشفي وِصالُكَ قَلبي العَليلا",4,"ل",2,1],["يقصر جري الرياح عنه","فكلها خلفه جنائِب",5,"ب",1,0],["يقصدُ القاصدون منهم لئاماً","ما لهم من وجوههم حُجَّابُ",6,"ب",1,0],["يَقْصُرُ ما يُعطيكَ في حُلْمه","عن بعضِ ما يُعطيك في نُبْهِهِ",7,"ه",2,0],["يُقَصِّرُ عَنهُ المَدحُ مِن كُلِّ مادِحٍ","وَلو كانَ مِن زُهرِ النُجومِ نِظامُهُ",8,"م",2,0],["يُقَصِّرُ عَنكَ المَدحُ مِن كُلِّ مادِحٍ","وَلو جاءَ بِالشَمسِ المُنيرَةِ وَالبَدرِ",9,"ر",1,0],["يُقَصِّرُ عَن أَمثالِهِ كُلُّ قَيصَرٍ","وَيُغلَبُ عَن أَمثالِهِ كُلُّ أَغلَبِ",10,"ب",1,0],["يقصى ويدنى بأولى","إشارة الراحتين",11,"ن",1,0],["يُقَصِّرُ عَن يَمينِكَ كُلُّ بَحرٍ","وَعَمّا لَم تُلِقهُ ما أَلاقا",12,"ق",2,0],["يَقصُرُ شَأوُ المُلوكِ عَن مَلِكٍ","نُجِلُّهُ دونَهُم وَنَجتَهِرُه",13,"ر",2,0],["يُقَصِّرُ القَومُ وَهُم عُصبَةٌ","عَن جَزرِ ما يولي وَتَخمينِه",14,"ن",2,0],["يَقصِمنَ إِذ طَعَنوا بِها أَقرانَهُم","حَلَقَ الدُروعِ وَهُنَّ غَيرُ قِصارِ",15,"ر",1,0],["يُقَصِّرُ عنها خاطِبٌ وهو مِصقَعٌ","ويَعجَزُ عنها شاعرٌ وهو مُفْلِقُ",16,"ق",1,0],["يُقصِّرْنَ إذ طُلْنَ خَطْوَ العِدا","ويُبدينَ في كلِّ نحرٍ عِثارا",17,"ر",2,0],["يُقصي الخَليلُ أَخاهُ عِندَ ميتَتِهِ","وَكُلُّ مَن ماتَ أَقصَتهُ الأَخِلّاءُ",18,"ا",2,0],["يُقَصِّرونَ فَنَستَحيي وَنُعذِرُهُم","وَيَحلِفونَ فَنَستَعفي وَنَعتَذِرُ",19,"ر",1,0],["يُقَصِّرُ مَغداهُنَّ كُلَّ مُوَلوِلٍ","عَلَيهِنَّ تَستَبكيهِ أَيدي الكَرائِنِ",20,"ن",1,0],["يُقَصِّدُ في العِدا سُمْرَ العَوالي","فيَرْجِعُ وهْوَ مسلوبٌ سَلوبُ",21,"ب",1,0],["يقصّرُ عُمرَ الليلِ إن طال شربُها","ويعملُ في عُمرِ النهارِ خُمارُها",22,"ه",2,0],["يَقُصُّ آثارَ أَقوامٍ أولي سَفَهٍ","وَبِالمِقَصَّينِ في النَعماءِ يُشقيكا",23,"ك",2,0],["يَقِصُ الذُّبَابَ بِطَرْفِهِ وَنثِيرِهِ","وَيُثِيرُ نَقْعاً في ذُرَى الأَظْرَابِ",24,"ب",1,0],["يقصر حبل الملك أو يمدّه","ما رسم الحدود إلا حدّه",25,"ه",1,0],["يُقَصَّرُ دونَ باعِكَ كُلُّ باعٍ","وَيَحصَرُ دونَ خُطبَتِكَ الخَطيبُ",26,"ب",1,0],["يُقَصِّرُ قَابُ الْفِكْرِ عَنْهَا وَيَنْتَهِي","أَخُو الْجِدِّ عَنْ إِدْرَاكِهَا وَهْوَ ذَاهِلُ",27,"ل",1,0],["يُقَصِّرُ حُسْنَاً عَنْهُما صَرْحُ بَابِلٍ","وَيَعْتَرِفُ الإِيوَانُ بِالْعَجْزِ وَالْبَهْرِ",28,"ر",1,0],["يَقُصُّ حَدِيثَ الكَوْنِ مُنْذُ ابْتِدَائِهِ","وَمَا َأخْلَفَتْ أَحْدَاثُهُ وَالتَّجَارِبُ",29,"ب",1,0],["يَقُصُّ مِنْ كَبِدِ النَّمْسَا لِيَتْرُكَهَا","وَرَاءَهُ مَا بِهَا جِسْمٌ وَلاَ كَبِدٌ",30,"د",1,0],["يقصُرُ اللَّيْلُ حِينَ يَسْمُرُ صَبْرِي","بَعْدَ أَنْ كَانَ نَابِغيّاً طَوِيلاَ",31,"ل",2,0],["يقصُّون احوالََ الحياة تمتُّعاً","وأنتِ تقصيِّن الحياة أمانيا",32,"ي",2,0],["يُقَصِّرُ الْقَوْمُ وَهُمْ عُصْبَةٌ","عَن حَزْرِ مَا يُولِي وتَخْمِينِهِ",33,"ن",2,0],["يَقِصُ الإِكَامَ بسِرْطِمٍ مُتَحَادِب","ٍ سَبِطٍ بِطانَتُهُ كَسِبْتِ النابلِ",34,"ل",1,0],["يقصي العلي ويقرب الدني","وبغتنى عنه وفيه يعتنى",35,"ن",2,0],["يقصرُ فيهِ كُل مثنٍ وإن غلا","وأجرى إلى أقصى نهايته الفِكرا",36,"ر",2,0],["يُقَصِّرُ قَولي دونَ ما أَنتَ فاعِلٌ","وَإِن كُنتَ قَد أوتيتَ قَولاً وَمِقوَلا",37,"ل",2,0],["يقصر عنها جِرولٌ ومهلهل","ويحذو عليها أخطل وجرير",38,"ر",1,0],["يَقِصُ السِّباعَ كَأَنَّ حَلّا فَوقَهُ","ضَخمٌ مُذَمِّرُهُ شَدِيدُ الأَنحُسِ",39,"س",1,0],["يُقَصِّرُ عَن تَرصيعِها في عُقُودِها","أَخُو دارِمٍ وَالأَعشيانِ وَجَروَلُ",40,"ل",1,0],["يُقَصِّرُ حاتِمٌ في الجُودِ عَنهُ","وَكَعبٌ وَالبَرامِكَةُ الكِرامُ",41,"م",1,0],["يُقَصِّرُ باعُ المَدحِ دونَ صِفاتِهِ","وَتَصغُرُ أَن يَهدي الثَناءَ لَهُ الشِعرُ",42,"ر",1,0],["يقصر عني في الهوى قيس عامر","ويهوى جميل انني كنت معمرا",43,"ر",2,0],["يقصر من سرمين أو يقل","قضاء هالديك والسجل",44,"ل",1,0],["يقصر عن ادراكها البرق غاية","وتهزأ بالنكباء شوطاً وتهزل",45,"ل",1,0],["يقصر عن ادراكها من يرومها","وان راح منها راتع الفكر راتكا",46,"ك",2,0],["يقصد بي بحر العلوم التي","تعذب للوارد والصادر",47,"ر",1,0],["يقصدني جود من أنامله","لو راسلتها السحاب لم تجد",48,"د",1,0],["يُقَصِّرُ عَنهُ مادِحوهُ فَكُلُّهُم","لَهُ بِالتِماسِ العُذرِ مِنهُ سَؤولُ",49,"ل",1,0],["يُقَصِّرُ عَن مَدائِحِهِ جَريرٌ","وَجَروَلُ وَالفَرَزدَقَ وَالبَعيثُ",50,"ث",1,0],["يُقصّرُ عنهُ جهدُ الشكرِ لمّا","يضاعفُ مدّه القصرُ السعيدُ",51,"د",1,0],["يُقصِّرُ آلُ بَرْمكَ عَن نَداهُ","فَنِعماهُمْ لِذِي نَعْماهُ تُكْفَرْ",52,"ر",1,0],["يقصِّرُ عمَّا يأكلُ اليومَ حالُه","ويبذلُ بالقَولِ الرَّغائِبَ إفراطا",53,"ط",2,0],["يُقصَى المحبُّ ويُدْني مَن عقيدتُه","فإنما حظُّهُ طردٌ وإقصاءُ",54,"ا",2,0],["يقصر المادح عنها مطنباً","كلَّما بالغ بالمدح وغالى",55,"ل",2,0],["يقصّر بالبلاغة باعَ قسٍّ","ويقصُرُ عنه قيس بن الخطيم",56,"م",1,0],["يقصُرُ عنه ثوبُ الثّنا وعلى","سواهُ عند الإياسِ ينسحِبُ",57,"ب",1,0],["يقصد الأبطال يهلكهم","من عداه والقفا قصد",58,"د",1,0],["يقصُّ عنك أخرساً","ما دقَّ أو ما أَشكَلا",59,"ل",2,0],["يقُصُّ إثرَ الشذوذِ يلتمس ال","عيبَ وينسَى الإحسان في الجملِ",60,"ل",1,0],["يَقُصُّ بها تحت الظلام سميرُها","وتَرجُزُكم وجهَ النهارِ حُداتُها",61,"ت",3,0],["يقصُ الأُقران من غير زئيرٍ","ويسحُّ الجودَ من غير رِعادِ",62,"د",1,0],["يقصُّ أحاديث الكثيب وبانهِ","ودون الكثيب البيدُ والعيس والوخد",63,"د",1,0],["يَقْصُرُ عن سِرِّ عُلاهُ عَقْلُهُ","ويَفْتَري الزُّورَ سَفيلٌ ما وَصَلْ",64,"ل",1,0],["يُقَصِّرُ قابَ العَينِ في فَلواتِها","نَواشِزُ صَفوانٍ عَلَيها وَجَلمَدِ",65,"د",1,0],["يُقَصِّرُ عَنْ سَخَائِكَ كلُّ بَحْر","بِيَاقُوتٍ وَمُرْجَانٍ تَجُودُ",66,"د",1,0],["يقصد المولى الكريم المنتخب","صاحب المجد العظيم المنتجب",67,"ب",1,0],["يقص قصة من قصت سوابقه","وصاه الصد لما طار طائره",68,"ر",2,0],["يقصر عنه الوصفُ والنعت مِنْ","مقالةِ الناظمِ والناثر",69,"ر",1,0],["يقصِّر عن مدائحه","حليف الوصف والنعتِ",70,"ت",1,0],["يقصِّرُ القولُ عن وصف الأمير فما","أوفَتْ مكارِمُه الأشعارُ والخطبُ",71,"ب",1,0],["يقصر من سعى يبغي نداه","ولو ركب الرجاء عن اللحوق",72,"ق",1,0],["يقصر البرق عنه والرياح إذا","ما قالت الخيل يا حرب الوغى جولوا",73,"ل",3,0],["يقصِّر عنهُ حاتمٌ واِبنُ عاصمٍ","غَداةَ نوالٍ أو غداة مغارِ",74,"ر",1,0],["يقصِّر عنه في الدَّرجا","تِ حارثةٌ وهانيهِ",75,"ي",2,0],["يقصِّر عنه في معاليه قيصرٌ","وَهيهات أَن يعلو معاليه قيصرُ",76,"ر",1,0],["يقصر عنها شأو من دوني عسى","تميز اليقظان ممن قعسا",77,"س",2,0],["يَقْصِدُ مَهْواها عَلَى خَيْرِ السِكَكْ","فِي مَذْهَبٍ بَيْنَ الجِبالِ وَالنَبَكْ",78,"ك",1,0],["يُقَصِّرُ عنهُ الغَيثُ واللَّيثُ نائلاً","وَبأْساً وعن أَوصافهِ النَّظمُ والنَّثرُ",79,"ر",1,0],["يَقصدها المُلوك وَالخَلائف","وَجائع ذو فاقة وَخائِف",80,"ف",1,0],["يُقَصِّر باعَ العامِليِّ عَن العُلا","وَلَكِنَّ العامِليّ طَويل",81,"ل",1,1],["يَقصُ السُّهولَةَ وَالحُزونَةَ إِذا غَدا","بِزهاءِ أَرعَنَ مِثلِ لَيلٍ جانِحِ",82,"ح",1,0],["يقصر الواصف عن حسنها","وإن غدا في