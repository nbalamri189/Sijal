{"poems":[[55,"قالوا رجوت الندى منه بلا سبب","https://www.aldiwan.net/poem29788.html","البسيط"],[93,"وحلمت ثانية وكان الكون لم تبرح","https://www.aldiwan.net/poem8728.html","عموديه"],[93,"إني مررت على الرياض الحاليه","https://www.aldiwan.net/poem62822.html","عموديه"],[107,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[123,"ثاب العزاء وحان الأخذ بالثار","https://www.aldiwan.net/poem4353.html","البسيط"],[164,"ما لي وقد شبت في داعي الصبا أرب","https://www.aldiwan.net/poem58671.html","البسيط"],[164,"جمع الملا يحيى على القرآن","https://www.aldiwan.net/poem58850.html","الكامل"],[164,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[261,"قالوا رأيناك بما فيك من","https://www.aldiwan.net/poem48448.html","السريع"],[371,"قالوا رأينا الأسود الصبر عادتهم","https://www.aldiwan.net/poem17159.html","البسيط"],[398,"قالوا ربيعك قد قدم","https://www.aldiwan.net/poem53435.html","مجزوء الكامل"],[406,"تهميش على دفتر الصداقة","https://www.aldiwan.net/poem6760.html","عموديه"],[463,"قالوا رضيت قلت ما أجدى الغضب","https://www.aldiwan.net/poem56298.html","الرجز"],[567,"طال البعاد فطال الشوق والكمد","https://www.aldiwan.net/poem52804.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138200",""],[411,"","https://poetry.dctabudhabi.ae/diwan/poem/30520","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37754","الكامل"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100137","المتدارك"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117383","البسيط"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47481","البسيط"],[1482,"","https://poetry.dctabudhabi.ae/diwan/poem/198789","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108678","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49611","البسيط"],[2406,"","https://poetry.dctabudhabi.ae/diwan/poem/100117","البسيط"],[2664,"","https://poetry.dctabudhabi.ae/diwan/poem/143083","الكامل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122467","البسيط"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118807","الكامل"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140310",""],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112370","السريع"],[4315,"","https://poetry.dctabudhabi.ae/diwan/poem/143029","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73409","البسيط"],[4755,"قالت: تَوَضَّأْ مِن دُمُوعِي.. وصَلّْ","https://www.poetsgate.com/ViewPoem.aspx?id=200782",""],[4830,"ياموسى العراق","https://www.poetsgate.com/ViewPoem.aspx?id=198352",""],[4830,"أفديهِ","https://www.poetsgate.com/ViewPoem.aspx?id=200115",""],[4961,"للصلاةِ شهبٌ يراها العارفون","https://www.poetsgate.com/ViewPoem.aspx?id=47905",""],[5842,"أعُوذُ باللهِ / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=137108",""],[5847,"حينما بكت عمان .!!","https://www.poetsgate.com/ViewPoem.aspx?id=208953",""],[5895,"قالوا ربيعا","https://www.poetsgate.com/ViewPoem.aspx?id=214446",""],[5922,"محاورة النجوم","https://www.poetsgate.com/ViewPoem.aspx?id=185133",""],[5956,"مناجاة حبيبة رحلت بعيدا ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182151",""],[5956,"الطائرة المنكوبة","https://www.poetsgate.com/ViewPoem.aspx?id=193917",""],[6035,"الغيّ ياكسرى عَصِيّ كَيّه .. !","https://www.poetsgate.com/ViewPoem.aspx?id=177042",""],[5309,"خطرت وورد الروض بين يديها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573535",""],[5567,"خدعة العمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81878&r=&rc=127",""]],"verses":[["قالوا رَجَوتَ النَدى مِنهُ بِلا سَبَبٍ","فَقُلتُ هَل سَبَبٌ أَقوى مِنَ الكَرَمِ",0,"م",1,1],["قالوا رَفيقَتُنا شَهيدَةُ هُزئِها","بِنَصائِحِ العُقَلاءِ وَالحُكَماءِ",1,"ا",2,0],["قالوا رَأَيناها فَلَم نَرَ طَيِّباً","وَلّى صِباها وَالجَمالُ مَعَ الصِبا",2,"ب",2,0],["قالوا رُويدَ اللَّائمين فما بنا","عَجزُ الضّعيفِ يخاف كلَّ سؤالِ",3,"ل",1,0],["قالوا ردوا باقتحام البحرِ عن غُرَرٍ","والموتُ يُدلي بأنيابٍ وأظفارِ",4,"ر",1,0],["قالوا رضيت ولاموني بجهلهم","وقد دروا ما الرضا يجدي ولا الغضبُ",5,"ب",1,0],["قالوا رأيناه يصلي هكذا","في ثالث العشرين من رمضانِ",6,"ن",1,0],["قالوا رقصنا كما الأحباش قد رقصوا","بمسجد المصطفى قلنا بلا كذب",7,"ب",1,0],["قالوا رأيناك بما فيك من","هشاشة الفطنة والكيس",8,"س",1,1],["قالوا رَأَينا الأُسودَ الصَبرُ عادَتُهُم","فَقُلتُ أَبناءُ أَيّوبٍ وَلا عَجَبُ",9,"ب",1,1],["قالوا رَبيعُك قَد قدم","فَلَكَ البشارَة بِالنِعَم",10,"م",1,1],["قالوا: رماكَ بما يسوؤكَ صاحبٌ","واشْتدَّ فيما لا يسُرُّ وأغربا",11,"ب",2,0],["قالوا رَضيتَ قلتُ ما أجَدَى الغَضَبْ","ما غالبَ الدهرُ فتىً إلا غَلَبْ",12,"ب",1,1],["قالوا رَأيناكَ تَصْبوا نحوَ دارِ بني","رَسلانَ قد نطَقُوا عدْلاً بما شَهِدوا",13,"د",3,0],["قالوا رأينا النور قلت إذا بدت","في الأفق شمس هل سناها يحتجب",14,"ب",1,0],["قالوا رضيتَ بدون حقِّكَ والغنى","يسمو بصاحبه إلى العلياء",15,"ا",2,1],["قالوا رَميتَ الدرَّ في البَحري الّذي","لَم يَستَحقْ لَه وَلَيسَ بِأَهلهِ",16,"ل",2,0],["قالوا رزء أعطاك حشا","قرحي وأساءت مبتدرا",17,"ر",2,0],["قالوا رأيناك كلَّ وقتٍ","تهيمُ بالشربِ والغِناءِ",18,"ا",2,1],["قَالُوا رأَيْنا فُراتاً لَيْسَ يُوجِعُهُ","ما يُوجِعُ النّاَسَ مِن هَجْوٍ بهِ قُذِفا",19,"ف",2,1],["قالوا: رحلت وكيف يرحل مؤمن؟","زرع النفوس محبَّة وإخاء",20,"ا",2,0],["قالوا رأيت هلال العيد قلت لهم","رأيته بينكم يا سادة البشر",21,"ر",1,1],["قالوا رُزْقِنَا اعْتِصَاماً من صَبَابَتِكم","وإنَّما ذاكَ لو تدرونَ حرمان",22,"ن",1,0],["قالوا رضينا به مولىً وأكثرهم","يفتر عن صدر ملآن من الدغل",23,"ل",1,0],["قالوا رضيت، وأنت أعلم ذا الورى","بحقائق الأشياء عن باريها",24,"ي",3,1],["قالُوا رُدانَةُ أقصَى ما يُرادُ بنا","ثمَّ القُفُولُ فقد ضِقنابِها عُصُرا",25,"ر",2,0],["قالوا رشاً هيهات وَهوَ يصيدني","ما عادة الغزلان إلا توثقُ",26,"ق",1,0],["قالوا ربحنا ولا واللَه ما ربحوا","بفعلهم غير خسران الموازين",27,"ن",1,0],["قالوا ربيعٌ قلتُ أين الصّبَا","أينَ الفَراشاتُ وأينَ الطيور",28,"ر",1,0],["قالوا: رأيت كإسماعيل من رشأ؟","فقلت: شرواه في دار الخلود يرى",29,"ر",2,1],["قالوا رَمَتهُ وداسَت بالنِّعالِ عَلى","قَفاهُ قُلتُ لَهُم ذا من عَوائِدهِ",30,"د",2,0],["قالُوا رَأَوا بِالأمسِ عُكَّازَهُ","تَسْتَنجِدُ \"المَبعُوثَ\" في المُعتَقَل",31,"ل",1,0],["قالوا رميتَ وما رماهمْ اِذ رمى","نصرٌ من اللهِ أعزَّ خُطاكا",32,"ك",2,0],["قالوا رويدكَ قابَ قوسين الردى","فالوجدُ في طَيّ الفؤادِ توَشَّما",33,"م",2,0],["قالوا رحلتَ عن ِ الحياةِ وأنتَ في","أضلاعِنا لمْ تنطفئْ برحيلِ",34,"ل",1,1],["قالوا: رُوَيدَكَ.. بَلْ هُم مِنْ بَنيكَ فقدْ","ثارَ العُقُوقُ بِهِمْ كالقيحِ في الوَرَمِ",35,"م",1,0],["٥_ قالوا رحلتَ فأثكلت البلاد وما","أبقيت قلبا سوى بالدمع مزدحمِ",36,"م",1,0],["قَالُوا رَبِيْعاً قَدْ وَقَفْتَ بِبَابِهِ","تَتَعَطَّرُ الأََحْْلامُ عِنْدَ شَبَابِهِ",37,"ب",2,1],["قالواركبوا لبسم مُجْريها ومُرسيها","ركبت لاكنّ قلبي لم يزلْ كمدا",38,"د",2,0],["قالوا رحلتِ إلى المهامه والفلا","أ نسِيتِني حقاً أيا ريمَ الفلا؟",39,"ل",2,1],["قالوا رجَعنا للإله، وكلنا","لله مُذْ خَلَق البرية كلَّها",40,"ه",2,0],["قالوا رشيد العُرْب وَهْم ، وانقَضَتْ","أسطورةٌ أَلْهَتْ شعوباً سالِفَةْ !",41,"ف",2,0],["قالوا رَعاكَ اللهُ فاتِنَةُ الوَرى","فَارحَم فُؤادَكَ مِن هَوى عَينَيها",42,"ي",3,0],["قالوا : رحلت فما صدقتهم أبداً","وخلت كل مقال منهم كذبا",43,"ب",2,0]]}