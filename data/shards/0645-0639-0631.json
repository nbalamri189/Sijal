ُ مَنْ جَارَ عَلَى مَنْ حَكَمْ",3,"م",1,1],["مُعرَورِياً رَمَضَ الرَضراض يَركُضُهُ","وَالشَمسُ حَيرى لَها بِالجَوِّ تَدويمُ",4,"م",1,0],["مُعَرِّساً في بَياضِ الصُبحِ وَقعَتُهُ","وَسائِرُ السَيرِ إِلاّ ذاكَ مُنجَذِبُ",5,"ب",1,0],["معرباً عن مباديء محكمات","ساميات تُحرّر الأقواما",6,"م",2,0],["معرق الآباء باهي الش","خص وضَّاح السجيَّه",7,"ي",2,0],["معروفُهُ في جميع الناس مُقْتسمٌ","فحمدُهُ في جميع الناس لا العُصَبِ",8,"ب",1,0],["معروفُهُ عُرضةٌ لِطالبِهِ","بل طالبٌ كلَّ من ونَى طلبُهْ",9,"ب",2,0],["مُعرَّبَةٌ أقلامُكم نَبَتَتْ لكُمْ","بحيث الْتَقَى طَلْحٌ وضَالٌ وغَرْقَدُ",10,"د",1,0],["مُعْرقٌ بل مردَّدٌ في الوزارا","تِ مُعَنَّىً قد مَلَّ من تردادِهْ",11,"د",2,0],["معروفة الأُم ولكنها","مثلك لم يُعرَف لها والدُ",12,"د",1,0],["مَعرِفَةٌ لَكِنَّهُ","أَصبَحَ فيها نَكِرَه",13,"ر",2,0],["مَعْرِفَتي بالصَّوابِ مَعْرِفَةٌ","غَرَّاءُ إِمّا عَرَفْتُمُ النّكرهْ",14,"ر",2,0],["مُعَرَّقَةَ الأَلحي كَأَنَّ خَبيبَها","خَبيبُ نَعاماتٍ رَوايِحَ خُضَّبِ",15,"ب",1,0],["معرَّجٍ كالأَيْمِ في التواءِ","وقد توافتْ عُصْبَةُ الوفاءِ",16,"ا",2,0],["معرقٌ في المجد من آبائه","أُسُدِ الرّوع وأملاكِ الزمان",17,"ن",1,0],["مُعرِقٌ في المُلكِ مَوصولاً بِهِ","شَرَفُ المَجدِ ومَحضُ السُؤدُدِ",18,"د",1,0],["مُعَرَّسُهُ في ظِلالِ السُيوفِ","وَمَشرَبُهُ مِن نَجيعِ الدِماءِ",19,"ا",2,0],["مُعَرَّسُ حَقٍّ مالُهُ وَلَرُبَّما","تَحَيَّفَ مِنهُ الخَطبُ وَالخَطبُ باطِلُ",20,"ل",1,0],["مُعَرَّسُ كُلِّ مُعضِلَةٍ وَخَطبٍ","وَمَنبِتُ كُلِّ مَكرُمَةٍ وَآدِ",21,"د",1,0],["معرةُ الأذكياءِ تسبي","لبي ووادي الجنانِ حسبي",22,"ي",1,1],["معرةُ النعمانِ عيني إذا","ذكرتُها تُفرِطُ في سَيْلها",23,"ه",2,1],["مَعَرَّتكمْ إلى مصرينَ تُعْزى","فخلِّ معرةَ النعمانِ قِسْمي",24,"ي",1,1],["مُعَربِداً يَجرَحُني طَرفُهُ","وَكانَ ذَنبُ السُكرِ مَغفورا",25,"ر",2,0],["مَعرضُ الأَجيالِ إِن طُفتَ بِهِ","فَتَمَهَّل وَاِتَّئِد في الطائِفينْ",26,"ن",1,0],["مَعْرفةُ العَقْل من الإنسانِ","أثبتُ من مَعرفةِ العِيانِ",27,"ن",1,0],["معربداً لا يريم سابحةً","إلَّا ومنهُ بثغرها أثرُ",28,"ر",1,0],["معرق؛ أمُّه الحضارة، والعل","م أبوه، إذا أراد انتساب