{"poems":[[88,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[53,"ومن العجائب يا أبا الفياض","https://www.aldiwan.net/poem64948.html","الكامل"],[53,"لا تكثرن ملامة العشاق","https://www.aldiwan.net/poem65525.html","الكامل"],[107,"مرأى من الملأ العلي ومظهر","https://www.aldiwan.net/poem41935.html","الكامل"],[107,"خلت المنازل منك والأوطان","https://www.aldiwan.net/poem41941.html","الكامل"],[107,"قل للألى رقدوا والعدل يقظان","https://www.aldiwan.net/poem42055.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[108,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[186,"على ثراك غوادي الصبح تنهمر","https://www.aldiwan.net/poem67073.html","البسيط"],[189,"يا من صفا لي ظاهرا ونيه","https://www.aldiwan.net/poem14691.html","الرجز"],[201,"يا من صهرت لهم شعوري","https://www.aldiwan.net/poem39818.html","مجزوء الكامل"],[228,"عرفت فيك النبل يا شاعري","https://www.aldiwan.net/poem41641.html","السريع"],[234,"يا من صفا ود صدري","https://www.aldiwan.net/poem51097.html","المجتث"],[240,"لمن الركائب تستقي","https://www.aldiwan.net/poem31796.html","مجزوء الكامل"],[240,"ما كنت أول حافظ لمضيع","https://www.aldiwan.net/poem31823.html","الكامل"],[256,"قف شامخاً","https://www.aldiwan.net/poem27798.html","عموديه"],[276,"ما ضر وجد الهوى العذرى لوهانا","https://www.aldiwan.net/poem52061.html","البسيط"],[408,"يا من صبا حين هبت في السحير صبا","https://www.aldiwan.net/poem46547.html","البسيط"],[454,"لبيك يا منقذ الفصحى","https://www.aldiwan.net/poem986.html",""],[463,"أسترشد البان وهو غضبان","https://www.aldiwan.net/poem55858.html","المنسرح"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87062","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48506","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120010","الكامل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138103",""],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136199","البسيط"],[2105,"","https://poetry.dctabudhabi.ae/diwan/poem/101754","الكامل"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70356","السريع"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65445","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110075","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114550","الكامل"],[4927,"الشهيد الرنتيسي","https://www.poetsgate.com/ViewPoem.aspx?id=4575",""],[5320,"قلعة الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=40442",""],[5459,"يا من صددتم..","https://www.poetsgate.com/ViewPoem.aspx?id=191516",""],[5459,"صبابة ..","https://www.poetsgate.com/ViewPoem.aspx?id=196539",""],[5490,"ماغيبوك","https://www.poetsgate.com/ViewPoem.aspx?id=176355",""],[5674,"هزوا بجذع قصائدي","https://www.poetsgate.com/ViewPoem.aspx?id=185185",""],[5943,"يااسودَ الوجهِ ياقذاف ويلاتِ","https://www.poetsgate.com/ViewPoem.aspx?id=61861",""],[5956,"إني لَمُختصّ بكم يا أشهمُ","https://www.poetsgate.com/ViewPoem.aspx?id=194262",""],[6097,"طيفٌ غابرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=191557",""],[6190,"في موكب العطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87009&r=&rc=15",""]],"verses":[["يا مَن صَدَفتَ عن الدُّنيا وزِينَتها","فلم يَغُرَّكَ من دُنياكَ مُغريها",0,"ي",3,0],["يا من صِناعتُه الدعاءُ إلى العُلا","ناقضتَ في فعلَيْك أيّ نِقاض",1,"ض",1,0],["يا من صفت لي في ذراه شرائعي","حتى تركت تتبع الأرزاق",2,"ق",1,0],["يا مُنْصِفِي القرآنَ من أعدائهِ","أَنتُمْ لِقَوْمِكُمُ العَتادُ الأكبرُ",3,"ر",1,0],["يا مُنصِفَ الإسلامِ من أعدائهِ","لا الظُّلمُ جَاوَزَهُ ولا العُدوانُ",4,"ن",1,0],["يا مُنصِفَ الشّعبِ مّمن كان يظلمه","أنصِفْ قُوىً غَالَها ظُلمٌ وعُدوانُ",5,"ن",1,0],["يَا مَنْ صَحِبْتُ العُمْرَ أَشْهَدُ مَا نحا","في الشِّعْرِ مِنْ مُتَبَايِنِ الأَنْحَاءِ",6,"ا",2,0],["يَا مَنْ صَفَا لِي وُدُّهُ وَصَفَا لَهُ","وُدِّي عَلَى السَّرَّاءِ والضَّرَّاءِ",7,"ا",2,0],["يا مُنْصِفي العُمَّال، هلاَّ زِنْتُمُو","باسْمِ المُعَلّم صَفحة العُمَّالِ؟",8,"ل",1,0],["يا مَن صَبَرتَ لِطولِ السُّقمِ عَن جَلَدٍ","مِن أَينَ صَبرُ قُلوبٍ فيكَ تَنفَطِرُ",9,"ر",1,0],["يا مَنْ صَفا لي ظاهِرا ونِيَّهْ","ومَنْ يدي بِوُدِّه غَنِيَّةْ",10,"ن",3,1],["يا من صهرت لهم شعوري","فجراً على شدو الطيور",11,"ر",1,1],["يا منصلاً أَغمَدت عَهداً طَويل","عارَ عَلى الأُمة أَن تَغمَدك",12,"ك",1,0],["يا من صفا ودُّ صدري","له وسِرّي وجهري",13,"ر",2,1],["يا مَن صِفاتُ عُلاهُ تُخ","رِسُ كُلَّ ذي لَسَنٍ قَؤولِ",14,"ل",1,0],["يا مُنصِفي مِن جَورِ دَهرِ قاسِطٍ","وَأَجِلُّهُ مِن أَن أَقولَ شَفيعي",15,"ع",2,0],["يا من صبرتم للحصار طويلاً","في عزة تعلو المجرة طولا",16,"ل",2,0],["يا منصب الحسن والاحسان خذ بيدي","فذاك مَن لم يكنحسنا واحسانا",17,"ن",2,0],["يا مَن صَبا حين هبّت في السُّحيرِ صَبا","ما أنتَ أولُ قلْبٍ للنَّسيم صَبا",18,"ب",2,1],["يا منصف الضاد من فوضى القريض فلم","يقبله بين عروض الشعر من أحد",19,"د",1,0],["يا من صحا الدهرُ حين أعَلقني","منه اختصاما والدهرُ سكرانُ",20,"ن",1,0],["يا مَن صَبا في مَهد أَسعَد مَولد","لِعُلوم تَدبير وَرَدع مخاصم",21,"م",1,0],["يا من صفا كأس الحياة بحكمه","فكفى العباد مرارة الأكدار",22,"ر",1,0],["يا من صرفت إليه وجه مطالبي","وعلمت أني بالمراد سأصرفُ",23,"ف",1,0],["يا من صحوت لحبيه فارقني","حتى إذا نمت عنه ظل يوقظني",24,"ن",2,0],["يا منصفي من قضاة الحب مثلك من","يرق لي فمغيث الصب ماجور",25,"ر",1,0],["يا من صفا ماءُ النعيم بوجهه","كم عيشةٍ كَدَّرْتَهَا بِصَفَائِهِ",26,"ا",3,1],["يا منصفاً في كل أحواله","لا تخرج الإنصاف عن رسمه",27,"م",2,1],["يا من صفا منهُ لي ودادُ","ومن لهُ في العلى ازديادُ",28,"د",1,1],["يا مَن صَفاءُ طِباعهم","فاقت على صَفو المُدام",29,"م",1,0],["يا من صنائِعُهُ تَعُمُّ مماثِلِي","عَبداً فقيراً يلتجي لِمُواسِ",30,"س",1,0],["يَاْ مَنْ صَنَعْتُمْ لأَهْلِ الْحَقِّ مَلْحَمَةً","خَضْرَاْءَ تُوْرِقُ فِيْ جَهْرٍ وَإِسْرَاْرِ",31,"ر",1,0],["يَا مُنصِفَ الأَيامِ مِنْ ظُلمَائِهَا","أَهلاً بِعيدٍ مُشرق وَضاء",32,"ا",2,0],["يَا مَنْ صَدَدْتُمْ مَعَ امْتِنَاعِ","هَلاَّ رَحِمْتُمْ أَذَى الْتِيَاعِي..",33,"ع",2,1],["يا مَن صَبا للفاتنات","طرقتَ أبوابَ الكآبه",34,"ب",2,0],["يا مَن صنعتَ من القضبان مدرسةً","وهجعة القبر قد سَوّيتَها أفقا",35,"ق",2,0],["يا منصف الشعراء اكتب قصتي","فلعلها بعدي تكون مُخلّده",36,"د",2,0],["يامنْ صنعتَ بوهمِ الغرِّ أجنحةً","بها تطيرُ بجهلٍ في الحماقاتِ",37,"ت",1,0],["يا منصفاً مستمتعاً بقصائدي","ورضاء غيرك إنْ فقطْ سال الدمُ",38,"م",1,0],["يَا مَنْ صَنعْتِ مِنَ العَيِيِّ مُفَوّهًا","وَأذَبْتِ مِنْ حَرِّ البُعادِ جَليدَهُ",39,"د",2,0],["يا منْ صحوتَ على ميلادِ قاتلةٍ","وكم رغبتَ على زنديكَ مقتلها !",40,"ل",3,0]]}