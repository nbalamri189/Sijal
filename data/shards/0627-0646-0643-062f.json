{"poems":[[10,"إن كنت عن وجدك لم تقصري","https://www.aldiwan.net/poem21081.html","السريع"],[46,"صرف النوى ليس بالمكيث","https://www.aldiwan.net/poem30564.html","مجزوء البسيط"],[484,"زوجي حسينة خففي لأوائي","https://www.aldiwan.net/poem37596.html","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64811","السريع"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109283","الرمل"],[4832,"جود المسعى فكل قد وعى","https://www.poetsgate.com/ViewPoem.aspx?id=166705",""]],"verses":[["إِنَّكَ داعٍ بِكَبيرٍ إِذا","وافَيتَ أَعلى مَرقَبٍ فَاِنظُرِ",0,"ر",1,0],["أَنكِد بِأَريِ النَوالِ ما لَم","يَحلُ مِنَ العُشبِ وَالجُثوثِ",1,"ث",1,0],["إن كدرتك ولا تخافي فرقة","فأنا وأنت بها من العداء",2,"ا",2,0],["إِنْ كَدَّرَتْ مَشْرَبَهُ كَلَّها","وإِنْ صَفَتْ كدَّرتِ الآخرَهْ",3,"ه",1,0],["انكد الناس لعمري عيشة","عائل مغترب يشكو الأسى",4,"ا",1,0],["أنكد العيش معاناة أذى","ليس منه مفزعا إلا الد \\عا",5,"ع",2,0]]}