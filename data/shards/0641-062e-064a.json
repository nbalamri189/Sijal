e.com/ViewPoem.aspx?id=188071",""],[5943,"دخول الناس بين الناس صعبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=34492",""],[5953,"لاح ضياء القمر الزاهر","https://www.poetsgate.com/ViewPoem.aspx?id=93849",""],[5953,"سئمت المقام بأرض الشّام","https://www.poetsgate.com/ViewPoem.aspx?id=93800",""],[5956,"أرى وجه الإله على الزهورِ..","https://www.poetsgate.com/ViewPoem.aspx?id=192602",""],[5956,"تخاصمني الحبيبة نايُ أيضاً","https://www.poetsgate.com/ViewPoem.aspx?id=194077",""],[5956,"شكراً شربنا القهوة الغراءَ","https://www.poetsgate.com/ViewPoem.aspx?id=208050",""],[6068,"يعذبني التذكار رائعة البسم -14-","https://www.poetsgate.com/ViewPoem.aspx?id=177649",""],[6120,"خَيْرُ الْوَرَى","https://www.poetsgate.com/ViewPoem.aspx?id=213523",""],[520,"يهوى الحبيبين من بأس ومن كرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577609",""]],"verses":[["فخَيْرٌ لمَنْ يُغْضي الجُفونَ على القَذى","ويَضْرَعُ للأعْداءِ فقْدُ حَياتِهِ",0,"ت",2,0],["فخَيِّمْ بحَيْثُ الدَّهرُ يُؤْمَنُ كَيدُهُ","فلا صَرْفُهُ يُخشى ولا الخَطْبُ يُكْرَثُ",1,"ث",1,0],["فخيرٌ ينعم السعداء فيه","وبأسٌ تحتويهِ الأشقياء",2,"ا",2,0],["فخيَّموا منك في سهلٍ مَباءتُهُ","وأوسعوا بك طراً بعد إقتار",3,"ر",1,0],["فخيَّمَ في أوطانِ بَكرِ بنِ وائِلٍ","يقابلُ بالنَّعماءِ بَكراً ووائِلا",4,"ل",2,0],["فخيرُ ما فيه أنَّه رجلٌ","يخدُمُني الدهرَ وهو أُستاذي",5,"ذ",2,0],["فخيرُ صَيدِكَ ما حلَّت مَصايِدُه","وخيرُ مالِكَ ما طابَتْ مَكاسِبُه",6,"ب",2,0],["فَخَيرَ المَماتِ قَتلَةٌ في سَبيلِهِ","وَخَيرُ المَعاشِ الخِفُّ وَالحِلُّ وَالقَصدُ",7,"د",1,0],["فَخَيَّبَ اللَّهُ مَسعاها وَغادَرَها","نَهبَ الرَّدى وَالصَّدى وَالرِّيحِ وَالطَّسَمِ",8,"م",1,0],["فَخَيِّم بِمَثوى المَجدِ وَالسَعدِ ناظِماً","عَلى نَحرِها عِقداً مِنَ الخَيلِ يُنسَقُ",9,"ق",1,0],["فخيرٌ على خيرٍ ونُعمَى تزيدها","من اللهِ نُعمى سِرُّها عنك مَكنونُ",10,"ن",1,0],["فَخَيرُهُمُ مَعاً خُلُقاً","وَشَرُّهُمُ مَعاً خُلُقا",11,"ق",2,0],["فَخَيرٌ مِنكِ مَن لا خَيرَ فيهِ","وَخَيرٌ مِن زِيارَتِكُم قُعودي",12,"د",2,0],["فَخَيْرُكَ مَأْمُولٌ وَفَضْلُكَ وَاسِعٌ","وَظِلُّكَ مَمْدُودٌ وَعَدْلُكَ شَامِلُ",13,"ل",1,0],["فَخَيَّلَهَا البَدْرُ رُوحاً بَدَتْ","عَلَى البُعْدِ فِي حُلَّةٍ مِنْ شُفُوفْ",14,"ف",1,0],["فخير ما رافقت علما نافعا","وشافعا مشفعا في يوم \" لا\"",15,"ل",2,0],["فخير الاخلاء المقيم على الوفا","وشر الاخلاء الفتى المتعتب",16,"ب",1,0],["فخيرُ الورى مَن قدّر البغضَ والهوى","وشرُّهمُ مَنْ في شمائِله يَغْلُو",17,"ل",2,0],["فَخَيرُكَ يا فويسقُ لستَ تدرِي","فخيرا من فريع أم أُصيل",18,"ل",1,0],["فَخَيرك يا مُسَيلمةُ لدَينا","فَخير بالسريقةِ وَالجهيل",18,"ل",1,0],["فخيل لي أن الرئاسة سرّه","وخلت إذن أني أحطت به خبرا",19,"ر",2,0],["فخيلنا دائما للحرب مسرجةٌ","من استغاث بنا بشّره بالظفر",20,"ر",1,0],["فخيلُه صافناتٌ في مرابطها","وبيضُه لم تجد عن غمدِها حِولا",21,"ل",2,0],["فخير عمر المرء ما اكتسى به","ملابس الخير من اكتسابه",22,"ب",2,0],["فخير مال الفتى مال يصون به","عرضا وينفقه في صالح العمل",23,"ل",1,0],["فَخيطٌ دب بدءُ الشيبِ فيهِ","دبيبَ النارِ في طرفِ الذبالِ",24,"ل",1,0],["فَخَيرٌ لَعَمرِي مِن بَساتينِ مُرغَمٍ","عَلى ذي المَجاري طَلحُ نَجدٍ وَشُوعُها",25,"ع",3,0],["فَخَيرٌ مِنَ الأَحساءِ إِن دامَ عُتبُكُم","أُشَيٌّ وَوادِى مَنهَمٍ وَنَعامُ",26,"م",1,0],["فخير من حياتي دفن ليل","وتغييب المحاسن في القبور",27,"ر",1,0],["فخيرُ أحوال له موته","ولا يقاسي سفلة بحرم",28,"م",1,0],["فَخيرُ الوَرى بعدَ النبيّينَ آلهُ","وَلا سيّما أبناءُ فاطمةَ الزهرا",29,"ر",2,0],["فَخَيرُ عَيشِ الفَتى رَيعانُ جِدَّتِهِ","وَالعُمرُ مِن فِضَّةٍ وَالشَيبُ مِن خَبَثِ",30,"ث",1,0],["فَخير الناس عبد قال صدقا","وَقدم صالحا قبل الذهاب",31,"ب",1,0],["فخيَّل لي طيفُ البخيلة أَنّها","أَلَمَّتْ برَحْلِي في الظَّلام المروّق",32,"ق",1,0],["فَخَيلُكَ تَغشى الرَّوعَ شُعثاً ضَوامِراً","شَوازِبَ قَد عَوَّدتها الفَتحَ وَالنَصرا",33,"ر",2,0],["فخيالُها في ناظريَّ وذكرُها","بفمي وطيبُ حديثها في مسمعي",34,"ع",2,0],["فخيام جفني فوق ذا مضروبةٌ","ولواءُ قلبي فوقَ هذا خافقُ",35,"ق",1,0],["فَخيرٌ من توالي الخصبِ رفقٌ","وَإجرارٌ لأرسانٍ بقسِّ",36,"س",1,0],["فَخَيرُ الشِعرِ أَكرَمُهُ رِجالاً","وَشَرُّ الشِعرِ ما نَطَقَ العَبيدُ",37,"د",1,0],["فَخَير البِرّ عاجَله وَالا","فَخذ اِذنا وَعجل بِالحُضور",38,"ر",1,0],["فَخَيرٌ تِلكُمُ مِن أَلفِ شَهرٍ","وَشَرٌّ هَذِهِ مِن أَلفِ شَهرِ",39,"ر",1,0],["فخيرُ تَدبيرها إذا ظفِرَ ال","جودُ بِها قِسطُ قدرةِ الظافِر",40,"ر",1,0],["فخيمت في ذنبانٍ منقفع","وفي رفوض كلا غير قشع",41,"ع",1,0],["فخير القوم من صبرا","وبالماضي فمعتبرا",42,"ر",2,0],["فخيرُ من قادكُمُ من لو سرى","بنفسه كان الخميسَ الجحفَلا",43,"ل",2,0],["فخيسُ الأسودِ كناسُ الظبا","ء والماءُ والنارُ في موضعِ",44,"ع",1,0],["فخيرٌ من مراعيها بذلٍّ","عِضاضٌ بالحناجر واجترارُ",45,"ر",1,0],["فخيرُ الوقتِ ما واتاكَ فيِهِ","زمانُأوشبابُ أومكانُ",46,"ن",1,0],["فَخِيسُ الهِزَبر كِناسُ الغَزال","بِهِ الشِبلُ ناشٍ مَع الجُؤذرِ",47,"ر",1,0],["فخيرُ الخصم أنْ يُسحبْ","وخيرُ الواهِ أنْ يُحْجَبْ",48,"ب",1,0],["فخيب ظني باغتصاب ذخيرتي","زماني وأرداني بسهم شتات",49,"ت",1,0],["فخيم الأمن فيها مذ نزلت بها","حتى لضج الكرى من صحبة المقل",50,"ل",1,0],["فخيرُ التآليفِ ما سَهُلَت","عبَارَتُه كُلَّما عَبَّرا",51,"ر",2,0],["فَخيرٌ أن نُسالمَ مِنه حَربا","تُحارِب سِلمَ ذي القلبِ الولُوعِ",52,"ع",1,0],["فخَيرُ مَن يَهدى به خَلقَهُ","مَن هُو بينَ خلقِه لُبُّهُ",53,"ب",2,0],["فخيرٌ من اليقظان مَن بات نائماً","وخيرٌ من الصّبحِ المنير ظلامُ",54,"م",1,0],["فخيرٌ من القصر المشيد بجنّةٍ","سُرىً في ظهور اليَعْمَلاتِ الخوانِفِ",55,"ف",1,0],["فخير الأمور السالفات على الهدى","وشر الأمور المحدثات فبعد",56,"د",1,0],["فخير آنسة زُفت لخير فتى","كم طوّقت منه اجياد الورى المنن",57,"ن",1,0],["فَخَيَّبَ البَينُ ما قَد كُنتُ آمُلُهُ","وَكَم أَرَتني اللَيالي ضِدَّ حِسباني",58,"ن",2,0],["فَخَيمَ العِزُّ فيكُم واستَوى لَكُمُ","مِن السَّفينةِ إذ قَرَّت عَلى الجُودي",59,"د",2,0],["فَخَيرٌ مِن شَقاءٍ في شَقاءٍ","نَعيمٌ في نَعيمِ في نَعيمِ",60,"م",1,0],["فخيرُ الورى من زانَ ايَّام عُمرهِ","بما يُبهجُ الأَلباب في موقفِ الحشر",61,"ر",1,0],["فَخَيرُ يَومَيكَ يَومٌ أَنتَ فيهِ إِذا","مُيِّزتَ في الناسِ مَحمودٌ وَمَعذولُ",62,"ل",1,0],["فخيبه عجلات الكرام","جوارا أتت بالمآكل ملأى",63,"ا",2,0],["فخيرُ ما اسْتُهْدِيَ ما لم يزلْ","مطيَّةَ الموسرِ والمفلس",64,"س",1,0],["فَخيمٌ عَريضُ الجاهِ سامٍ رفيعهُ","يُؤَيّدهُ بِالرّفعِ منهُ التواضِعُ",65,"ع",1,0],["فخيب ظنونَ الحاسدين بزورةٍ","لمن لاحَ فيك صاحبٌ وخدين",66,"ن",1,0],["فخيرهم للاجنبي وقبحهم","على بعضهم بعضا يعدونه حسنا",67,"ن",2,0],["فخيب عدوانه جيشه","وخيبه الله من بعده",68,"د",2,0],["فخيلهم دون بُلو","غِ السُّؤل فينا قد كبت",69,"ت",1,0],["فَخَيَّرتُهُ مالاً طَريفاً وَتالِداً","يَصونُ بِهِ عِرضاً لَهُ غَيرَ نادِمِ",70,"م",1,0],["فخيرُ الديانات دينُ الضميرِ","وما دونهُ عبثٌ لا يدومْ",71,"م",1,0],["فخيِّطوا بالعُقار مُقلتهُ","ومَزَّقوا لا وثَقِّبوا درَّه",72,"ه",1,0],["فخير ما تبقي لهذا الوطن","كلمةً مأثورةً خالده",73,"ه",1,0],["فخير قولٍ بإكرامٍ نردده","وما به هذه المرثاة نختتم",74,"م",1,0],["فخير الخيبتين لكم صغار","به تنجو نفوس الهاربينا",75,"ن",2,0],["فخيول جودك لم تجل إلا انثنت","والفقر غير مِكَرِّها مقبول",76,"ل",1,0],["فخير ما عوطيتها مصطبحاً","على قدوم الملك المسعود",77,"د",1,0],["فَخِيَارُ عَسكَرِكُم فَأنتُم مِنهُمُ","بُرَاءُ إذ قَرُبُوا مِنَ الإِيمَانِ",78,"ن",1,0],["فَخَيَّمنَ حتَّى يستريحَ ركابُها","فلا فَلَكٌ جارٍ ولا كوكبٌ سارِ",79,"ر",1,0],["فخير دنيا المرء حظاً له","ماحصَّنَ الدينَ وغَضَّ البَصَرِ",80,"ر",1,0],["فخير يوم يومنا","بجمع شمل الحاضرين",81,"ن",1,0],["فخيل لي كبدر فوق غصن","ذوى للبعد من قرب المياه",82,"ه",1,0],["فخيمنَ حَتّى تَستَريح ركابها","فَلا فلك جارٍ وَلا كَوكَب سار",83,"ر",1,0],["فَخُيِّل لي أنّ السموات أطبقت","عليّ وأبصرتُ الكواكب في الظهرِ",84,"ر",1,0],["فَخَيرٌ لِلجَماعَةِ أَن يَلوها","بِإِصلاحٍ يُقَوِّمُ مَن تمارى",85,"ر",2,0],["فخيلك والقواضب والعوالي","تصير سدى إذا عدمت طرادا",86,"د",2,0],["فخير دواء مرضاه صيام","يسود على البطون الجائعات",87,"ت",1,0],["فخير المباني ما ترقى وصوله","لأسمى المعاني لا سليمى ولا هند",88,"د",1,0],["فخَيرك موهوب وبأسك صارمٌ","وإن كنتَ للإحسان أدنى وأقرَبا",89,"ب",2,0],["فخير الورى من ىل طه وصيه","عن الخلق طراً بالتحجب أوصاه",90,"ا",2,0],["فخير لنا ان ننظم الشعر للدمى","اذا ما غدا عند الرجال بلا قدر",91,"ر",1,0],["فخيل لي بَرَداً تعلق","في الاَغصان تنثرهُ الصبا نثرا",92,"ر",2,0],["فَخير العُمر إخوانٌ وَراحٌ","وَقَلبٌ لَيسَ يَشقى بانزعاج",93,"ج",1,0],["فخير 