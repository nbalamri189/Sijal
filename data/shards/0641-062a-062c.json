px?id=176252",""],[5533,"الكِبْرُ نَقِيْضُ الإِيمان","https://www.poetsgate.com/ViewPoem.aspx?id=176849",""],[5596,"إلى ابن مكتوم","https://www.poetsgate.com/ViewPoem.aspx?id=206174",""],[5596,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=206694",""],[5596,"إلى آل الفلاح في مصابهم","https://www.poetsgate.com/ViewPoem.aspx?id=206783",""],[5612,"مُتَّكَأُ المَوْت","https://www.poetsgate.com/ViewPoem.aspx?id=179836",""],[5691,"سفارة فوق الدماء","https://www.poetsgate.com/ViewPoem.aspx?id=206030",""],[5691,"كتاب وريشة","https://www.poetsgate.com/ViewPoem.aspx?id=206594",""],[5691,"الكوكب الأحمر... الوطن القادم...!","https://www.poetsgate.com/ViewPoem.aspx?id=206733",""],[5725,"انسام طيبة","https://www.poetsgate.com/ViewPoem.aspx?id=183345",""],[5751,"مَعارجُ الصعيد","https://www.poetsgate.com/ViewPoem.aspx?id=214714",""],[5781,"مقاليدُ العشقِ بيدي!","https://www.poetsgate.com/ViewPoem.aspx?id=208762",""],[5829,"دعوة الى الستر","https://www.poetsgate.com/ViewPoem.aspx?id=157070",""],[5956,"تواصل الفتن فيما بيننا","https://www.poetsgate.com/ViewPoem.aspx?id=202522",""],[5997,"جائحة","https://www.poetsgate.com/ViewPoem.aspx?id=214297",""],[6031,"يا طِرْسُ قُلْ لخَليلَيَّ اللذَينِ هُمَا","https://www.poetsgate.com/ViewPoem.aspx?id=46349",""],[6036,"قصيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=84095",""],[6052,"ميراث الفضيلة","https://www.poetsgate.com/ViewPoem.aspx?id=35378",""],[6052,"همس الذكربات","https://www.poetsgate.com/ViewPoem.aspx?id=49636",""],[6070,"حملتيني بأحضانِ الحنايا","https://www.poetsgate.com/ViewPoem.aspx?id=189159",""],[6093,"القصيدة الزبيدية في مدح خير البرية","https://www.poetsgate.com/ViewPoem.aspx?id=195006",""],[6102,"جيهان ..","https://www.poetsgate.com/ViewPoem.aspx?id=183612",""],[6102,"ذِكرى الأَمس !!","https://www.poetsgate.com/ViewPoem.aspx?id=184048",""],[6102,"رِقَّةٌ وَحشِيَّة !!","https://www.poetsgate.com/ViewPoem.aspx?id=184163",""],[6102,"سِباقُ الواوِيات ..","https://www.poetsgate.com/ViewPoem.aspx?id=184411",""],[6152,"سيد قومه المتغابي","https://www.poetsgate.com/ViewPoem.aspx?id=203404",""],[231,"قبلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79171&r=&rc=45",""],[5355,"حالة واحدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87212&r=&rc=37",""],[549,"سيرةٌ إنسانيَّةٌ للرِّمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87656&r=&rc=8",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""],[6315,"قَبائلُ النِّسْرِين !! هامشٌ على قرطاسِ المُتَنَبّي ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87575&r=&rc=0",""],[5190,"لا زلتُ أشكو لوعةَ الغُرباءِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78295&r=&rc=8",""],[5567,"أبدو .. ولا أبدو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81749&r=&rc=21",""]],"verses":[["فَتَجاذَبْنا على أَكْوارِها","ذِكَراً تَنْقَدُّ مِنْهُنَّ الضُّلُوعُ",0,"ع",1,0],["فتَجاذَبَتْ جُدُلَ الأزمّةِ وانْبَرَتْ","تحْكي البَوارِقَ سُرْعَةً وتُضاهِي",1,"ي",1,0],["فَتَجَشَّموا لِلمَجدِ كُلَّ عَظيمَةٍ","إِنّي رَأَيتُ المَجدَ صَعبَ المُرتَقى",2,"ق",2,0],["فَتَجري إِلى العَلياءِ وَالمَجدِ شَوطَها","وَيُخصِبُ فيها كُلُّ جَدبٍ وَيَنضُرُ",3,"ر",1,0],["فَتُجيبُ الجِبالُ رَجماً وَقَذفاً","بِشُواظٍ مِن مارِجٍ وَدُخانِ",4,"ن",1,0],["فَتَجامَدَت مُحتالَةً","وَالمَرءُ يَعجَزُ لا الحَويل",5,"ل",1,0],["فَتَجعَلَ أَسماءَ الغَداةَ كَحاجَةٍ","أَجَمَّت فَلَمّا أَخلَفَت لَم تُبالِها",6,"ل",3,0],["فتجري بها سفُنُ الرجاء إلى مَدّى","وليس إلى الجودي من الجود ساحلُ",7,"ل",1,0],["فَتَجمَعُ نُعمى عَلى حاتِمٍ","وَتُحضِرُها مِن مَعَدٍّ شُهودا",8,"د",2,0],["فتجشم منها ما جشِمت من التي","بسوراء هرت نحو حالك حالها",9,"ل",3,0],["فتجشمتُ نحوها الهولَ والحُر","رَاسُ قد هوَّموا على الأبوابِ",10,"ب",1,0],["فتجوَّبتْ بهمُ الدُّجَى","وتكشَّفتْ غُمَمُ الغُموم",11,"م",1,0],["فَتَجَلَّد أَيُّها القَلبُ الجَزوع","أَو تَدَفَّق كُلَّما شاءَ الوَلوع",12,"ع",1,0],["فَتَجَهَّمَت وَتَلَفَّتَت مُرتاعَةً","كَالظَبيِ أَيقَنَ أَنَّهُ مَأسورُ",13,"ر",1,0],["فَتَجَرَّعَتْ كَأساً دِهاقاً","مِنْ مُشَعْشَعَةِ الشَّفَقْ",14,"ق",1,0],["ف