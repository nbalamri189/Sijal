{"poems":[[63,"عرضت ناشئة المزن لنا","https://www.aldiwan.net/poem46104.html","الرمل"],[77,"حنت لخضر ربي وزرق مياه","https://www.aldiwan.net/poem35858.html","الكامل"],[86,"لي فيك حين بدا سناك وأشرقا","https://www.aldiwan.net/poem10685.html","الكامل"],[86,"أطل على الأكوان والخلق تنظر","https://www.aldiwan.net/poem10689.html","الطويل"],[86,"نبئاني إن كنتما تعلمان","https://www.aldiwan.net/poem10953.html","الخفيف"],[73,"جاءتك وافدة الشمول","https://www.aldiwan.net/poem11978.html","مجزوء الكامل"],[35,"ألا يا لقومي للنوى وانفتالها","https://www.aldiwan.net/poem39092.html","الطويل"],[83,"نجوم أمدتها بدور كوامل","https://www.aldiwan.net/poem54260.html","الطويل"],[11,"أبى طول ليلك إلا سهود","https://www.aldiwan.net/poem237.html",""],[37,"تألق برق عندنا وتقابلت","https://www.aldiwan.net/poem7494.html","الطويل"],[51,"كتبت ربة الثنايا العذاب","https://www.aldiwan.net/poem8530.html","الخفيف"],[51,"شغل المحب عن الرسوم","https://www.aldiwan.net/poem66332.html","مجزوء الكامل"],[91,"لوعة في الضلوع مثل جهنم","https://www.aldiwan.net/poem8809.html","عموديه"],[91,"سمعت عويل النائحات عشية","https://www.aldiwan.net/poem8833.html","عموديه"],[92,"أيها الحب أنت سر بلائي","https://www.aldiwan.net/poem38975.html","الخفيف"],[85,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[85,"علمت بالقلم الحكيم","https://www.aldiwan.net/poem63745.html","مجزوء الكامل"],[62,"إذا ما الطلق لم يغسل بماء","https://www.aldiwan.net/poem52216.html","الوافر"],[45,"يا سعيد والأمر فيك عجيب","https://www.aldiwan.net/poem11045.html","الخفيف"],[28,"إني حلفت بصارع لابن له","https://www.aldiwan.net/poem5441.html","الكامل"],[2,"عفا من آل فاطمة الجواء","https://www.aldiwan.net/poem25055.html","الوافر"],[49,"لله در ذوي العقول المشعبات","https://www.aldiwan.net/poem10841.html","الكامل"],[49,"إني لأكره أن تكون","https://www.aldiwan.net/poem62032.html","مجزوء الكامل"],[49,"الهرص داء قد أضربمن","https://www.aldiwan.net/poem63074.html","مجزوء الكامل"],[80,"تغنت قيان الورق في الورق الخضر","https://www.aldiwan.net/poem31443.html","الطويل"],[44,"يا ربع لو ربعوا على ابن هموم","https://www.aldiwan.net/poem30351.html","الكامل"],[69,"زردية حلقاتها","https://www.aldiwan.net/poem28026.html","مجزوء الكامل"],[31,"نام الخلي وبت غير موسد أ","https://www.aldiwan.net/poem42571.html","الكامل"],[33,"فيا ليت ليلى وافقت كل حجة","https://www.aldiwan.net/poem25859.html","الطويل"],[48,"داو يحيى من خماره","https://www.aldiwan.net/poem63269.html","مجزوء الرمل"],[48,"أعاذل لا أموت بكف ساق","https://www.aldiwan.net/poem64422.html","الوافر"],[50,"لا تلمني على عبيدة صاح","https://www.aldiwan.net/poem63969.html","الخفيف"],[46,"لم أرض رأي ولاة قوم لقبوا","https://www.aldiwan.net/poem22632.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85583","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85548","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141986","الكامل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199503","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[106,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[100,"بين ليل وفجر","https://www.poetsgate.com/ViewPoem.aspx?id=50195",""],[90,"غضبة","https://www.poetsgate.com/ViewPoem.aspx?id=179231",""],[99,"ورقة إلى القارىء","https://www.poetsgate.com/ViewPoem.aspx?id=17760",""],[51,"شغَلَ المُحبَّ عن الرسو","https://www.poetsgate.com/ViewPoem.aspx?id=30515",""],[90,"لعبة التجارب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66767&r=&rc=175",""],[118,"أُغاضبها","https://www.aldiwan.net/poem24054.html","المتدارك"],[121,"يرى من ستور الغيب حتى كأنما","https://www.aldiwan.net/poem49290.html","الطويل"],[129,"يا نفس أنت محادده","https://www.aldiwan.net/poem50643.html","مجزوء الكامل"],[133,"أيا عين السلامة لا تنامى","https://www.aldiwan.net/poem54740.html","الوافر"],[144,"عاذ بالصفح من أَحب البقاء","https://www.aldiwan.net/poem11716.html","الخفيف"],[144,"هل غير ظلك للعفاة مقيل","https://www.aldiwan.net/poem11791.html","الكامل"],[153,"الشوكة","https://www.aldiwan.net/poem17104.html","عموديه"],[186,"عتبت الزمان عسى يعتب","https://www.aldiwan.net/poem14122.html","المتقارب"],[205,"روض المحاسن نزهة الأبصار","https://www.aldiwan.net/poem53142.html","الكامل"],[205,"حلل المحاسن نزهة الأبصار","https://www.aldiwan.net/poem53256.html","الكامل"],[224,"سل البدر بالضياء الظلاما","https://www.aldiwan.net/poem41867.html","الخفيف"],[226,"غاض ماء الحياء من كل وجه","https://www.aldiwan.net/poem55142.html","الخفيف"],[232,"خط الربيع بأقلام التباشير","https://www.aldiwan.net/poem44564.html","البسيط"],[250,"أطلال مية بالتلاع فمثقب","https://www.aldiwan.net/poem2127.html","الكامل"],[257,"أيها السيد الذي طاب في المجد","https://www.aldiwan.net/poem48372.html","الخفيف"],[262,"هلما نحييها ربى وربوعا","https://www.aldiwan.net/poem38241.html","الطويل"],[271,"تنفست الظبية النافره","https://www.aldiwan.net/poem35370.html","المتقارب"],[271,"أعاتبها والحب من طبعه العتب","https://www.aldiwan.net/poem35605.html","الطويل"],[271,"لأبي عبيدة في دمشق وخالد","https://www.aldiwan.net/poem35645.html","الكامل"],[286,"طرب الهزار وعمت البشرى فما","https://www.aldiwan.net/poem39429.html","الكامل"],[299,"ذهب الهوى بشغاف قلب الموجع","https://www.aldiwan.net/poem36280.html","عموديه"],[299,"برزت بزينتها إليك الشام","https://www.aldiwan.net/poem36300.html","عموديه"],[305,"نسمات الحي وهنا إذ سرت","https://www.aldiwan.net/poem16846.html","الرمل"],[306,"سائل النفس قبل فوت الأوان","https://www.aldiwan.net/poem56386.html","الخفيف"],[306,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[321,"في عالم الرؤيا رأيت ركابكم","https://www.aldiwan.net/poem61696.html","الكامل"],[321,"عندي لكم يا آل ودي دعوة","https://www.aldiwan.net/poem67115.html","الكامل"],[338,"ألا من مبلغ خاقان عني","https://www.aldiwan.net/poem45332.html","الوافر"],[394,"حدق الحسان رمينني بتململ","https://www.aldiwan.net/poem53677.html","الكامل"],[397,"ليبك عقالاً كل كسر مؤربٍ","https://www.aldiwan.net/poem597.html",""],[404,"أصدود منكم ثم عتاب","https://www.aldiwan.net/poem34139.html","الرمل"],[410,"كنت بين الرجاء واليأس منه","https://www.aldiwan.net/poem31722.html","عموديه"],[440,"دأبك الهجر ودابي","https://www.aldiwan.net/poem34824.html","مجزوء الرمل"],[453,"يا سرحة الوادي سقيت من الحيا","https://www.aldiwan.net/poem13770.html","الكامل"],[465,"بين حزني وحسنه اليوسفي","https://www.aldiwan.net/poem3166.html","عموديه"],[465,"يا من لابيض كل جفن اسود","https://www.aldiwan.net/poem3536.html","عموديه"],[465,"وصل الأسى وعصى مقال العذل","https://www.aldiwan.net/poem3537.html","عموديه"],[530,"من ذا يطيق لربه","https://www.aldiwan.net/poem37144.html","مجزوء الكامل"],[539,"لما استقام ولم يفز بمرامه","https://www.aldiwan.net/poem48130.html","عموديه"],[559,"فر إبليس عن هدى العرفان","https://www.aldiwan.net/poem33728.html","الخفيف"],[559,"إن قولي مؤيد بالنقول","https://www.aldiwan.net/poem34243.html","الخفيف"],[559,"فر يا طائرا إلى ربك","https://www.aldiwan.net/poem34262.html","الخفيف"],[559,"يشف ثوب عنه لي مخيط","https://www.aldiwan.net/poem34404.html","الرجز"],[559,"قد أتينا الحمى على منهاج","https://www.aldiwan.net/poem34688.html","الخفيف"]],"verses":[["فَتَجاذَبْنا على أَكْوارِها","ذِكَراً تَنْقَدُّ مِنْهُنَّ الضُّلُوعُ",0,"ع",1,0],["فتَجاذَبَتْ جُدُلَ الأزمّةِ وانْبَرَتْ","تحْكي البَوارِقَ سُرْعَةً وتُضاهِي",1,"ي",1,0],["فَتَجَشَّموا لِلمَجدِ كُلَّ عَظيمَةٍ","إِنّي رَأَيتُ المَجدَ صَعبَ المُرتَقى",2,"ق",2,0],["فَتَجري إِلى العَلياءِ وَالمَجدِ شَوطَها","وَيُخصِبُ فيها كُلُّ جَدبٍ وَيَنضُرُ",3,"ر",1,0],["فَتُجيبُ الجِبالُ رَجماً وَقَذفاً","بِشُواظٍ مِن مارِجٍ وَدُخانِ",4,"ن",1,0],["فَتَجامَدَت مُحتالَةً","وَالمَرءُ يَعجَزُ لا الحَويل",5,"ل",1,0],["فَتَجعَلَ أَسماءَ الغَداةَ كَحاجَةٍ","أَجَمَّت فَلَمّا أَخلَفَت لَم تُبالِها",6,"ل",3,0],["فتجري بها سفُنُ الرجاء إلى مَدّى","وليس إلى الجودي من الجود ساحلُ",7,"ل",1,0],["فَتَجمَعُ نُعمى عَلى حاتِمٍ","وَتُحضِرُها مِن مَعَدٍّ شُهودا",8,"د",2,0],["فتجشم منها ما جشِمت من التي","بسوراء هرت نحو حالك حالها",9,"ل",3,0],["فتجشمتُ نحوها الهولَ والحُر","رَاسُ قد هوَّموا على الأبوابِ",10,"ب",1,0],["فتجوَّبتْ بهمُ الدُّجَى","وتكشَّفتْ غُمَمُ الغُموم",11,"م",1,0],["فَتَجَلَّد أَيُّها القَلبُ الجَزوع","أَو تَدَفَّق كُلَّما شاءَ الوَلوع",12,"ع",1,0],["فَتَجَهَّمَت وَتَلَفَّتَت مُرتاعَةً","كَالظَبيِ أَيقَنَ أَنَّهُ مَأسورُ",13,"ر",1,0],["فَتَجَرَّعَتْ كَأساً دِهاقاً","مِنْ مُشَعْشَعَةِ الشَّفَقْ",14,"ق",1,0],["فَتَجَلَّت لِيَ القُصورُ وَمَن في","ها مِنَ العِزِّ في مَنازِلَ قُعسِ",15,"س",1,0],["فَتجارَتِ اللُغَتانِ لِل","غاياتِ في الحَسِبِ الصَميمِ",16,"م",1,0],["فتجمع صفوه في الماء منه","ويبقى ثفله شبه الرمادِ",17,"د",1,0],["فَتَجَمَّل لَنا قَليلاً كَما كُن","تَ فَإِنَّ الرَحيلَ عَنكَ قَريبُ",18,"ب",1,0],["فَتَجُزَّ ناصِيَتي وَتُفرِجَ كُربَتي","عَنّي وَتُطلِقَ لي يَداكَ كُبولي",19,"ل",2,0],["فَتُجمَع أَيمُنُ مِنّا وَمِنكُم","بِمُقسَمَةٍ تَمورُ بِها الدِماءُ",20,"ا",2,0],["فَتَجافَ عَن دارِ الغُرورِ وَعَن دَوا","عيها وَكُن مُتَوَقِّعاً لِلحادِثاتِ",21,"ت",1,0],["فَتَجُرَّ مَحمَدَتي إِلَي","هِ وَلَيسَ مِمَّن يُحمَدُ",22,"د",1,0],["فَتَجَنَّبِ الشَهَواتِ وَاِح","ذَر أَن تَكونَ لَها قَتيلا",23,"ل",2,0],["فتجلوهمُ أيدي السقاة عرائساً","ترى الدّرّ أزراراً لأثوابها الحُمرِ",24,"ر",1,0],["فَتَجَرَّدَت بيضُ السُيوفِ لِهامِهِم","وَتَجَرَّدَ التَوحيدُ لِلتَخريمِ",25,"م",1,0],["فتجلُّ لابسَ سردِها","عنْ ذكرِ عنترَ في الحلقْ",26,"ق",1,0],["فَتَجَهَّمَت لَمّا رَأَتني داخِلاً","بِتَلَهُّفٍ مِن قَولِها وَتَهَدُّدِ",27,"د",1,0],["فَتَجمَعَنا مِن نَخلَتَينِ ثَنِيَّةٌ","يَغَصُّ بِأَعضادِ المَطِيِّ طَريقُها",28,"ق",3,0],["فَتَجَلَّت عَن شِهابٍ","يَتَرامى بِشَرارِه",29,"ر",2,0],["فَتَجري ما يُحَسُّ لَها حَسيسٌ","إِذا مَرَّت بِمُزدَرَدِ البُصاقِ",30,"ق",1,0],["فَتَجَهَّزتُ لِاِنقِضاءِ حَياتي","وَاِستَعَدَّت لِميتَتي أَنواحي",31,"ح",2,0],["فَتَجَنَّبَن مُتَوافِقَينِ عَلى الأَذى","مُتَخالِفَينِ بَواطِناً وَظَواهِرا",32,"ر",2,0],["فَتَجَرَّعت سمّاً وَما","تت في غضيرٍ من صباها",33,"ا",3,0],["فتجلدي عند الرزية واحسبي","أني اجتمعت إليك في ألاحلام",34,"م",1,0],["فَتَجَاوَلا وَكِلاهُمَا","متَقحمٌ كَالصَّقْرِ كَاسِرْ",35,"ر",1,0],["فتجمعوا في الوكر حول حمامةٍ","بيضاء جللها الأسى بسواد",36,"د",1,0],["فتجهش اللوعة في أضلعي","وينفض الشوق المدوي كراهْ",37,"ا",2,0],["فتجاهلتْ لغةَ الغرامِ وتابعتْ","خُطُواتِها في عِزَّةِ وشِياحِ",38,"ح",1,0],["فتجيبُ دعوتَهم ملا","ئكةُ السَّماءِ مؤمِّنين!!",39,"ن",1,0],["فتجمّع الإخوان بعد تفرّق","وانضمّ شمل الأهل بعد شتات",40,"ت",1,0],["فتجاوَزَتْكَ وراح نَهبتَها","نَخْبُ الفؤادِ وخامِلٌ غَمْر",41,"ر",1,0],["فتجعل من رئتي مَوْقِدا ..","هَيولاهُ من شاطيء المُبْتَدا",42,"ا",1,0],["فتجوَّبتْ بهمُ الدُّجَى","وتكثفتْ غُمَمُ الغُموم",43,"م",1,0],["فتجرِبةٌ للحكمِ خَلقُ موظفٍ","وتجرِبةٌ للشعبِ تخريجُ نائب",44,"ب",1,0],["فَتُجاذِبُني مِثْلَ الماضي","وتَلُفُّ الحَبْلَ على ذَقْني",45,"ن",2,0],["فتجريه في أنواف كل خميلةٍ","وتنشده بين الربى والمخارم",46,"م",1,0],["فتجارةُ الإفسادِ في","سوق المكارِم كاسِدَهْ",47,"د",2,0],["فَتَجلُو غَمرَةَ الحِدثَانِ عَنهُ","عَزَائِمُ لاَ تَطُوعُ لِمُستَنَامِ",48,"م",1,0],["فَتَجاوَز رُكوبَ جُردِ المَذاكي","أَنَفاً مِنهُ وَاِمتَطِ الجَوزاءَ",49,"ا",2,0],["فَتَجَنَّبوا سَرحَ المُظَفَّرِ إِنَّهُ","نَعَمٌ بِأَشطانِ القَنا مَعقولُ",50,"ل",1,0],["فَتَجْتَمِعُونَ حُشُودًا عَلَيَّ","يُؤَلِّفُهُنَّ ضَلاَلٌ وَحِقْدُ",51,"د",1,0],["فتَجْذِب ذاك الخَصيب الجَديب","بعنفٍ وما فيه ما تجْذِب",52,"ب",1,0],["فتجنّبِ الأشرارَ تُكفى شرَّهم","واختر لنفسك صحبةَ الأخيارِ",53,"ر",1,0],["فتجنَّبِ الأشرارَ تَجنُب شرَّهم","واختر لنفسك صحبة الأخيارِ",54,"ر",1,0],["فَتُجيبُ الرُبوعُ بِالصَمتِ وَالدَم","عِ وَلا تنبسُ الشفاهُ اِحتِراما",55,"م",2,0],["فَتَجَنَّت على الشُعوبِ وَشَنَّت","غارةً في البِلادِ من بعدِ أخرى",56,"ر",2,0],["فتجتلي البشر من ذات الستور به","وتجتني تمر حجر غير محجور",57,"ر",1,0],["فَتَجارَيا شَأواً بَطيناً ميلُهُ","هَيهاتَ شَأوُهُما وَشَأوُ التَولَبِ",58,"ب",1,0],["فتجاوزت خانقين وخلف","ت ورائي على الطريق جلولا",59,"ل",2,0],["فتجربة الياقوت بالنار والكبا","بحرق فيها دائما ليضوعا",60,"ع",2,0],["فتَجني عواطفَهُ ضمَّةً","وليست بما نثرَت شاعره",61,"ر",2,0],["فتجني الذي تجنيه في الرَّوضِ نحلةٌ","وما الشعرُ إِلا الشَّهدُ يخزنُه الصبُّ",62,"ب",1,0],["فتجدَّلَ الأحرارُ 