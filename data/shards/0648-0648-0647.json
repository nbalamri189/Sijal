{"poems":[[65,"بدا لي على الكثيب","https://www.aldiwan.net/poem45694.html","المضارع"],[74,"عجبت خلتي لوخط مشيبي","https://www.aldiwan.net/poem18228.html","الخفيف"],[53,"بات يدعو الواحدا الصمدا","https://www.aldiwan.net/poem61930.html","المديد"],[53,"عيد يطابق أول الأسبوع","https://www.aldiwan.net/poem65060.html","الكامل"],[53,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[47,"يا خليلي بل لست لي بخليل","https://www.aldiwan.net/poem65615.html","الخفيف"],[68,"أنصفته جهدي ولي ما أنصفا","https://www.aldiwan.net/poem39532.html","الكامل"],[68,"أسلبن من فوق النهود ذوائبا","https://www.aldiwan.net/poem41382.html","الكامل"],[83,"ذد عن موارد أدمعي طير الكرى","https://www.aldiwan.net/poem61523.html","الكامل"],[54,"إن الفراق دعا الخليط فزالا","https://www.aldiwan.net/poem26731.html","الكامل"],[50,"هلا استعنت على الهموم","https://www.aldiwan.net/poem65095.html","مجزوء البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39548","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39550","الكامل"],[108,"(1) في المخبأ","https://www.poetsgate.com/ViewPoem.aspx?id=179531",""],[47,"يا خَليلي، بَلْ لَسْتَ لي بخَليلِ","https://www.poetsgate.com/ViewPoem.aspx?id=31804",""],[139,"أحسن الأيام أيام التلاق","https://www.aldiwan.net/poem49117.html","الرمل"],[147,"هل للأماني عن جنابك مدفع","https://www.aldiwan.net/poem11771.html","الكامل"],[151,"إلى الصون مدت تلمسان يداها","https://www.aldiwan.net/poem47691.html","الطويل"],[154,"أهلا بغرتك السعيده","https://www.aldiwan.net/poem68462.html","مجزوء الكامل"],[189,"ماذا يقول المادحو","https://www.aldiwan.net/poem14113.html","مجزوء الكامل"],[189,"صلى الإله عليك يا بن رسوله","https://www.aldiwan.net/poem14639.html","الكامل"],[214,"ودي لكم صدق بغير تملق","https://www.aldiwan.net/poem13520.html","الكامل"],[230,"لو أن أطلال المنازل تنطق","https://www.aldiwan.net/poem55213.html","الكامل"],[231,"حب الشكور","https://www.aldiwan.net/poem24232.html","عموديه"],[327,"أضحت أميمة لا ينال زمامها","https://www.aldiwan.net/poem56344.html","الكامل"],[333,"سكر الليل بكاسات السكون","https://www.aldiwan.net/poem54974.html","الخفيف"],[333,"الذنب ذنبك ليس ذنبي","https://www.aldiwan.net/poem55020.html","مجزوء الكامل"],[422,"ما لها مفرية بيدا فبيدا","https://www.aldiwan.net/poem53936.html","الرمل"],[435,"إلى الروم أصبو كلما أومض الخال","https://www.aldiwan.net/poem40048.html","الطويل"],[435,"صدحت على غصن السرور قماري","https://www.aldiwan.net/poem40772.html","الكامل"],[469,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[505,"كم نشرنا من طامس وطوينا","https://www.aldiwan.net/poem37722.html","الخفيف"],[556,"ألا ماذا يريبك من همومي","https://www.aldiwan.net/poem47740.html","الوافر"],[580,"أصبحت للدنيا الدنية","https://www.aldiwan.net/poem2753.html","مجزوء الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122626","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48719","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48707","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48676","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48825","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38923","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145822","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96725","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96713","الكامل"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79468","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64438","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64435","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108927","الكامل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110275","الرمل"],[2125,"","https://poetry.dctabudhabi.ae/diwan/poem/123614","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27855","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27206","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77236","الكامل"],[2406,"","https://poetry.dctabudhabi.ae/diwan/poem/100120","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/61013","الكامل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132363","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130837",""],[2731,"","https://poetry.dctabudhabi.ae/diwan/poem/102022","الرمل"],[3348,"","https://poetry.dctabudhabi.ae/diwan/poem/81380","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74035","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62769","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129507","الطويل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95326","الرجز"],[3984,"","https://poetry.dctabudhabi.ae/diwan/poem/147201","الخفيف"],[3988,"","https://poetry.dctabudhabi.ae/diwan/poem/202416","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94801","الطويل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81297","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72489","الكامل"],[4778,"أهواكَا","https://www.poetsgate.com/ViewPoem.aspx?id=188197",""],[4830,"هواجس حائرة","https://www.poetsgate.com/ViewPoem.aspx?id=195016",""],[4858,"نيسان بين أفراح وأشجان","https://www.poetsgate.com/ViewPoem.aspx?id=161813",""],[3271,"لم يطب للنبوغ فيك مقام","https://www.poetsgate.com/ViewPoem.aspx?id=103537",""],[5136,"نعم أنا لا أرجو إذا ألوت اللوى","https://www.poetsgate.com/ViewPoem.aspx?id=121784",""],[5186,"يا ناثر النظم الأرق الأنفس","https://www.poetsgate.com/ViewPoem.aspx?id=156549",""],[5190,"الكذبة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=153355",""],[5582,"أَغِزْلانَ رِيمٍ فِي الهَوادِجِ أَمْ دُمَى","https://www.poetsgate.com/ViewPoem.aspx?id=63578",""],[5616,"الي من كان صديقي","https://www.poetsgate.com/ViewPoem.aspx?id=205770",""],[5670,"جئتُ يا شِعري","https://www.poetsgate.com/ViewPoem.aspx?id=211123",""],[5829,"فتاة السكر","https://www.poetsgate.com/ViewPoem.aspx?id=210632",""],[5952,"لا وجه لي","https://www.poetsgate.com/ViewPoem.aspx?id=205983",""],[5952,"لا وجه لي","https://www.poetsgate.com/ViewPoem.aspx?id=205984",""],[5975,"وصية شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=52974",""],[6075,"النَّصْرُ آتٍ","https://www.poetsgate.com/ViewPoem.aspx?id=190501",""],[6177,"شرايين التراب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79077&r=&rc=20",""],[6237,"إفاقة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77866&r=&rc=8",""],[2220,"ألا إنَّ الوجودَ وجودُ ربي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11785&r=&rc=655",""]],"verses":[["وَوَهبينُ في رُباها","لأَسرابِها رُبوعُ",0,"ع",1,0],["ووهت قوَّتي فأعرضت كرهاً","عن لقاءِ المكروهِ والمحبوب",1,"ب",1,0],["ووهت أركانه جزعاً","وارتقت أنفاسه صُعُدا",2,"د",2,0],["ووهتْ أمورهُمُ هناك فعالجوا","من وهْيها ما ليس بالمرقوع",3,"ع",1,0],["ووهبتَ نفسكَ للمتالفِ دونَهُ","ورأيتَ ذلك في الإمام قليلا",4,"ل",2,0],["وَوَهبتُ الفَصَّينِ لِلَّهِ مَن بَع","دِ عِنادِ الداعي وَضَربِ لعَليلِ",5,"ل",1,0],["وَوَهَبتُهُ رِقّي فَما إِن رَقَّ لي","وَوَفَيتُ بِالعَهدِ القَديمِ فَما وَفى",6,"ف",2,0],["وَوَهَبتَهُم زَمَنَ الأَمانِ فَمَن رَأى","مَلِكاً يَكونُ لَهُ الزَمانُ مَواهِبا",7,"ب",2,0],["وَوَهَبتَ لا مُستَرجِعاً وَحَكَمتَ لا","مُتَنَطِّعاً وَعَلَوتَ لا مُتَجَبِّرا",8,"ر",2,0],["وَوَهَبتُهُم لِلصَرمِ وَاِبتَلَّ الثَرى","وَوَجَدتُ عُذراً فيهِمُ وَمَقالا",9,"ل",2,0],["وَوَهَبتَ لِلعَيشِ الحَمي","دِ بَقِيَّةَ العَيشِ الذَميمِ",10,"م",1,0],["ووهِمْتَ ناراً ذات إيماضِ","فبسطتَ كفَّك نحوها فزَعا",11,"ع",2,0],["ووهبتُ قلبي للخطارِ فللهوى","شطرٌ وللعلياءِ شطرٌ ثاني",12,"ن",2,0],["وَوَهتْ عزيمته فأف","لت يابسٌ منه وسائل",13,"ل",1,0],["وَوهَبْتُ الفَصَّيْنِ لِلهِ مَنْ بَعْدِ","عِنَادِ الدَّاعِي وضَرْبِ العَلِيلِ",14,"ل",1,0],["ووهَى الفضلُ فلولا أحمدٌ","لاعترى الفضلَ أنمحاء وانمحاقْ",15,"ق",1,0],["وَوَهَبتَ لي قُربى أَنالَت رِفعَةً","وَالدَهرُ لَيسَ بِخافِضٍ مَن تَرفَعُ",16,"ع",1,0],["ووهران والمرساة كلا بما حوت","غدت حائزاتٍ من حماك مناها",17,"ا",3,0],["ووهبته نفسي ومن","حق البشارة أن أزيده",18,"د",2,0],["ووهبتَ أهلَ الأرضِ حَ","تى لم تجدْ في الخلقِ طالب",19,"ب",1,0],["ووهبتَ حتى إنّ جودَك يغمر ال","دنيا ومن فيها ببعض هُموله",20,"ل",2,0],["ووهبته روحي كما يهب الندى","قاضي القضاة محمد ابن مزلق",21,"ق",1,0],["وَوَهَبتَ فَاِبتَكَر النُضارُ سحائِبا","تَهمي وَتَفتقِد المَحيلَ وَتُغدِقُ",22,"ق",1,0],["ووهبته ملك الحياة وطالما","قد عاشها كالعامل المأجور",23,"ر",1,0],["وَوَهَت مُبَعِّجَةً تَبَعَّجَ عُظمُها","لَمّا تَزَيَّدَ وَاِدلَهُمَّ جَهامُها",24,"م",3,0],["ووهبنا الحب دنيانا","وما بين يدينا",25,"ن",2,0],["ووهبتها قلبي المعذّ","ب بلبُلا يبكى أساه",26,"ه",1,0],["ووهى يومَ نأَيْتُم جَلَدي","بعدَ ما كنتُ على الدَّهر جليدا",27,"د",2,0],["ووهم الليالي إن تمادى جماحها","فهمته الكبرى الشكيمة والخالُ",28,"ل",1,0],["ووهبتهُ شرفاً بحسن إمارةٍ","فكسوتهُ ثوب الثنا المعطارِ",29,"ر",1,0],["ووهى فمات وكاد يبسط عذره","لو عاش بعد الهالكِ المفقودِ",30,"د",1,0],["ووَهَبْنا برَبِّنا وسَلَبْنا","وحَكَمْنا بأَمرِهِ وقَضَيْنَا",31,"ن",2,0],["وَوهّابِ اللُّها في يومِ سلمٍ","وضرّابِ الكُلى يومَ الهِراش",32,"ش",1,0],["ووهبْتُها مِني لبَا","ئِع نَفْسِه كَيْ يَشْتَرِيها",33,"ي",3,0],["وَوَهبتَه دمَه لجاهِ محمدٍ","ورِضَى علي وجعفر الطيار",34,"ر",1,0],["ووهبتهم فتهافتوا ومنعتهم","فسطوا بألسنةٍ هناك حداد",35,"د",1,0],["ووهبت ألفاً كل فرد من ذوي","قرباي تضمن لي رضاه وتكفل",36,"ل",1,0],["ووهبت أهل الصرب نصحك ناهياً","عن أن يمدوا الطاغي المهزوما",37,"م",2,0],["ووهبت الحياة قومك حتى","كدت تحيي آباءهم والجدودا",38,"د",2,0],["وَوَهمِيَ سلواه عَديمٌ وجودُه","وَكَيفَ وَأَحشائي على حبّه اِنطووا",39,"و",3,0],["وَوَهَبتَها مَا لمْ تَكُنْ","أهلا ًله ُحُبَا ًومَقتَا",40,"ت",2,0],["وَوهنانة الأطرافِ ما حطّ مرطُها","عَلى متنِها إلّا شَكى وتألّما",41,"م",2,0],["وَوهبت في جدبِ الزمان مغانماً","وحملت في هدن الزمانِ مَغارما",42,"م",2,0],["ووهبتَ منها نعمةً لا تُلْهِني","يا ربِّ أنتَ بسُكْرِها عن شُكرِها",43,"ه",2,0],["ووهبا عليمياً فيوض انبساطه","تزحزح وهمي يا علمي وظلمتي",44,"ي",1,0],["ووهبك يا وهاب ليس لعارض","وليس لأغراض ولا عوضية",45,"ه",1,0],["ووهبت من جود الأمير لجيدها","درراً بغير يد الأمير تصان",46,"ن",1,0],["وَوَهَبَ اللَهُ لَهُ الشَهادَهْ","جاءَ فَدَلَّتهُ عَلى السَعادَهْ",47,"ه",1,0],["ووهت اعصابه حتى بدا","وهو في العشرين شيخاً هرما",48,"م",2,0],["ووهبت خدري والفراش لكاعب","في الحي ذات دمالج وحجول",49,"ل",1,0],["ووهمي في العلوم له احتكام","وما همُ النفوسِ كمثل وهمي",50,"م",2,0],["ووهبنا ما وهبنا","سرّ بدرِ الحبشيّ",51,"ي",1,0],["وَوَهَبتُها القَلبَ الَّذي","قَد عَلَّقتهُ بِجيدِها",52,"د",3,0],["ووهذه رشحة من عارض هطل","وقطرة من جمام الجحفل العرم",53,"م",1,0],["ووهبت داووداً خطِيِئته التي","تركتْ مدَامعَه سواكب كالمطر",54,"ر",1,0],["ووهدانُ أركان العلى بشواهِقٍ","من الفخرِ شيدت من رؤوسِ القبائلِ",55,"ل",1,0],["ووهبتها في الحب قلبي","والوفاءُ لها سفيري",56,"ر",2,0],["ووهى ركن اصطباري أسفا","ولقد كنت على الأرزاء جلدا",57,"د",2,0],["ووهبنا منه العقول عقاراً","أدركتْ من حوادث الدهر ثارا",58,"ر",2,0],["وَوهبت للأَوطانِ نفسك هادِراً","تَحمي الحُقوق وَللفَنيق هَديرُ",59,"ر",1,0],["ووهبن لي أخفافَهُنّ مع الذُرى","فوهبتُ صِحَّتَهُنّ للأوصابِ",60,"ب",1,0],["ووهاب أنفال يكاد بنانه","من الجود يعدو والفرار من العدوى",61,"و",2,0],["ووهَن العدوّ ضَعفا يهِنُ","ربَض يَربض المقالُ البيّنُ",62,"ن",1,0],["ووهبْنا التوراةَ أفقاً رحيباً","وحَضَنَّا الإنجيلَ بالقرآنِ",63,"ن",1,0],["ووهبت لي الالف التي لو أنها","وزنت بصم الصخر كانت أبهرا",64,"ر",2,1],["ووهنائةٌ خُرعوبَةٌ وعقيلةٌ","وبَهنانةٌ وسناءُ زين الخراعبِ",65,"ب",1,0],["وَوَهَبنا لَكَ الحَياة وَفَجر","نا يَنابيعها لِعَينيك قُربى",66,"ب",2,0],["ووهبت ما ملكت يدي من أنعم","لمبشري بقدوم أكرم مقدم",67,"م",1,0],["ووهبتني طوق النجاة فليس لي","بين العباد مُؤَازِرا الّاكا",68,"ك",2,0],["ووهبتِ ادراجَ الرياحِ رسائلي","وسحقتِ بهجَ خُطايَ في قدَميكِ",69,"ك",1,0],["ووهبت يا ربّي الوجودَ جماله","فتسابق الشّعراءُ في ميدانه",70,"ن",2,0],["ووهبت الفرقان قلبك حتى","فاض من قدسهِ لك الإلهام",71,"م",1,0],["ووهني له أشدد يا شديد القوى فما","شددت الوهن إلا اعتدى وقوى",72,"و",2,0],["ووهبته وفري وما ملكت يدي","فأحل تعريفي بأفلس مفلس",73,"س",1,0],["ووَهَبتُ مِن فَيضِ الغَرَامِ دَمِي","فَوَهَبْتِنِي مِن فَيضِهِ نُكرَا",74,"ر",2,0],["وَوَهْنانَة