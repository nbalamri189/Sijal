{"poems":[[65,"يا صاحبي خذا للسير أهبته","https://www.aldiwan.net/poem45929.html","البسيط"],[3,"إذا كشف الزمان لك القناع","https://www.aldiwan.net/poem176.html",""],[79,"أثار سراها والديار نوازح","https://www.aldiwan.net/poem36644.html","الطويل"],[90,"لقد بت مطروف النواظر بالسهد","https://www.aldiwan.net/poem45057.html","الطويل"],[74,"يتيم ابتسامك ما يقهر","https://www.aldiwan.net/poem18706.html","المتقارب"],[74,"بشراك إن السرى والعود مبرور","https://www.aldiwan.net/poem18707.html","البسيط"],[53,"لنعم اليوم يوم السبت حقا","https://www.aldiwan.net/poem8145.html","الوافر"],[53,"ذلي لزهوك أرض","https://www.aldiwan.net/poem64957.html","المجتث"],[93,"أطار عني النوم صوت في الدجى","https://www.aldiwan.net/poem62627.html","عموديه"],[40,"قالت سليمى أتنوي اليوم أم تغل","https://www.aldiwan.net/poem7736.html","البسيط"],[94,"يا ربة الشعر والأحلام غنيني","https://www.aldiwan.net/poem38900.html","الكامل"],[47,"لدن هجرته زحزحته عن الصبر","https://www.aldiwan.net/poem63642.html","الطويل"],[47,"لأوشك شعب الحي أن يتفرقا","https://www.aldiwan.net/poem65185.html","الطويل"],[47,"أرى بين ملتف الأراك منازلا","https://www.aldiwan.net/poem65533.html","الطويل"],[30,"كيف ببيت قريب منك مطلبه","https://www.aldiwan.net/poem5081.html","البسيط"],[60,"أنا علي وابن عبد المطلب مهذب","https://www.aldiwan.net/poem31159.html","الرجز"],[60,"وما طلب المعيشة بالتمني","https://www.aldiwan.net/poem31199.html","الوافر"],[68,"وحقك إني قانع بالذي تهوى","https://www.aldiwan.net/poem38475.html","الطويل"],[107,"مصيبة أمة وأنا المصاب","https://www.aldiwan.net/poem41138.html","الوافر"],[54,"ومختضب بحثي للعقار","https://www.aldiwan.net/poem26998.html","الوافر"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9945","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54940","السريع"],[106,"بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=5126",""],[79,"أثار سناها والديار نوازح","https://www.poetsgate.com/ViewPoem.aspx?id=33819",""],[154,"توكل إذا نابتك يوما ملمة","https://www.aldiwan.net/poem68522.html","الطويل"],[173,"ما أنصف الطلل العافي بماوانا","https://www.aldiwan.net/poem1685.html",""],[173,"على م وفي م ظلماً تلحياني","https://www.aldiwan.net/poem1688.html",""],[189,"لو كان هجرك يبقيني إلى أمد","https://www.aldiwan.net/poem14501.html","البسيط"],[193,"لمن ربع بأكناف المصلى","https://www.aldiwan.net/poem35174.html","الوافر"],[227,"خلعت عن الروح ثوب المدر","https://www.aldiwan.net/poem39688.html","المتقارب"],[227,"مضت أشهر نذرت للمطر","https://www.aldiwan.net/poem39700.html","المتقارب"],[235,"ما ذا أثار بقلبي السائق الغرد","https://www.aldiwan.net/poem44592.html","البسيط"],[241,"إن برزت من لطافة يدها","https://www.aldiwan.net/poem18184.html","المنسرح"],[241,"أبناء فاس من يفارقهم","https://www.aldiwan.net/poem19524.html","السريع"],[256,"أبى جلد أن أحمل البين والقلى","https://www.aldiwan.net/poem1415.html",""],[279,"أتجحد قتلي ربة الشنف والخرص","https://www.aldiwan.net/poem25494.html","الطويل"],[326,"أشتقت وانهل دمع عينك أن","https://www.aldiwan.net/poem56345.html","المنسرح"],[330,"لما استظل بتاج الملك واجتمعت","https://www.aldiwan.net/poem44274.html","البسيط"],[332,"تعاليت لا مولى سواك خلقتني","https://www.aldiwan.net/poem54954.html","الطويل"],[332,"المجتث","https://www.aldiwan.net/poem55010.html","المجتث"],[352,"السيف خلفي فعذرا إن جرحت إذا","https://www.aldiwan.net/poem19843.html","البسيط"],[352,"كن لي جوابا فلفظي","https://www.aldiwan.net/poem20389.html","المجتث"],[353,"هب منطقي سمعك يا وهب","https://www.aldiwan.net/poem15536.html","السريع"],[353,"شرعة وجدي ما لها نسخ","https://www.aldiwan.net/poem15566.html","السريع"],[357,"حمدا لمن جعل التاريخ عقد حلى","https://www.aldiwan.net/poem39584.html","البسيط"],[369,"أفاطم لو شهدت ببطن خبت","https://www.aldiwan.net/poem44361.html","الوافر"],[381,"يا صاح إسمع مذ سمت","https://www.aldiwan.net/poem66909.html","مجزوء الرجز"],[397,"أيعسوب دين الله صنو نبيه","https://www.aldiwan.net/poem53623.html","الطويل"],[436,"زهرن فاعجب لروض ماله زهر","https://www.aldiwan.net/poem12341.html","البسيط"],[436,"هبهم رضوا غير قلبه وطنا","https://www.aldiwan.net/poem12755.html","المنسرح"],[441,"منازلهم بين اللوى فالدكادك","https://www.aldiwan.net/poem2528.html","الطويل"],[445,"صب صبته إلى ليلى صبابته","https://www.aldiwan.net/poem14340.html","البسيط"],[445,"دع الزفرات صاعدة طوامي","https://www.aldiwan.net/poem14481.html","الوافر"],[461,"أما وهواها عذرة وتنصلا","https://www.aldiwan.net/poem55919.html","الطويل"],[461,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"],[461,"دعوها ترد بعد خمس شروعا","https://www.aldiwan.net/poem56122.html","المتقارب"],[461,"سلا دار البخيلة بالجناب","https://www.aldiwan.net/poem56296.html","الوافر"],[554,"هل هاج شوقك صوت الطائر الغرد","https://www.aldiwan.net/poem47848.html","البسيط"],[554,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[556,"لا تدع بي الشوق إني غير معمود","https://www.aldiwan.net/poem68413.html","البسيط"],[561,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[565,"أتى مثل موسى حينما عاد من مصر","https://www.aldiwan.net/poem52768.html","الطويل"],[565,"أرى الدهر يقضي كل يوم ديونه","https://www.aldiwan.net/poem52787.html","الطويل"],[565,"ألناس في الدهر لفظ أنت معناه","https://www.aldiwan.net/poem52808.html","البسيط"],[570,"داو خماري بكأس خمر","https://www.aldiwan.net/poem69458.html","مخلع البسيط"],[578,"بحقك حدث عن هواي ولا حرج","https://www.aldiwan.net/poem2976.html","الطويل"],[975,"","https://poetry.dctabudhabi.ae/diwan/poem/204090","الوافر"],[1075,"","https://poetry.dctabudhabi.ae/diwan/poem/84984","الرجز"]],"verses":[["وَفي يَدِي كَلِسانِ الأَيْمِ مُرْهَفَةٌ","غِرارُها بِمَقيلِ الرُّوحِ مُلْتَبِسُ",0,"س",1,0],["وَفي يَومِ المَصانِعِ قَد تَرَكن","لَنا بِفِعالِنا خَبَراً مُشاعا",1,"ع",2,0],["وفي يومِ بَدْرٍ إذْ رَمَى قَبْضَةَ الثّرى","فولّتْ جُموعُ الشِّرْكِ وهْيَ جَوامِحُ",2,"ح",1,0],["وفي يد ه سيف أُجيد صقاله","على أنه من صّنعة الله لا الهند",3,"د",1,0],["وفي يدهِ فاضليّ اليراع","مقيمٌ وسؤددهُ سير",4,"ر",1,0],["وفي يراعكَ سرٌّ من سعادته","قد صحَّ منه لعلمِ الحرف تأثير",5,"ر",1,0],["وفي يومِ الخميسِ قضاء خيرٍ","ففيه الله يأذن بالقضاءِ",6,"ا",2,0],["وفي يمينك بسطٌ","لِما يُحبُّ وقبضُ",7,"ض",1,0],["وَفي يَدي الشِمالُ أَشكالُ المُنى","وَصُوَرُ اليَقينِ وَالضَلالِ",8,"ل",1,0],["وَفي يَدومَ إِذا اِغبَرَّت مَناكِبُهُ","وَذِروَةِ الكورِ عَن مَروانَ مُعتَزَلُ",9,"ل",1,0],["وفي يديكِ مزاميرٌ يُخالِجُها","وَحْيُ السَّماءِ فهاتيها وغَنِّيني",10,"ن",2,0],["وَفي يَومِ صِفّينَ اِقتَسَمنا ذُرى العُلا","وَقَد جَعَلَ الخَطِّيُّ يَعثُرُ بِالكَسرِ",11,"ر",1,0],["وَفي يَدِكَ السَيفُ الَّذي اِمتَنَعَت بِهِ","صَفاةُ الهُدى مَن أَن تَرِقَّ فَتَخرَقا",12,"ق",2,0],["وَفي يَومِ مَنويلٍ وَقَد لَمَسَ الهُدى","بِأَظفارِهِ أَو هَمَّ أَن يَتَناوَلا",13,"ل",2,0],["وَفي يَمينِكَ سَيفُ اللَهِ قَد نُصِرَت","عَلى العَدُوِّ وَرِزقٌ غَيرُ مَحظورِ",14,"ر",1,0],["وَفي يَميني صارِمٌ يَجلو الكَرب","مَن يَلقَني يَلقَ المَنايا وَالعَطَب",15,"ب",1,0],["وَفي يَومِ الخَميسِ قَضاءُ حاجٍ","فَفيهِ اللَهُ يَأذَنُ بِالدُعاءِ",16,"ا",2,0],["وَفِيٌّ يُجازي المُذنِبينَ بِعَفوِهِ","وَلَكِنَّهُ عَن مالِهِ لا يَرىالعَفوا",17,"و",2,0],["وفي يده من الريحان عود","كأن مداده الذهب المذاب",18,"ب",1,0],["وَفي يُمناهُ إِبريقٌ وَماءٌ","وَكَأسُ الخَمرِ في يَدِهِ اليَسارِ",19,"ر",1,0],["وَفي يَومِ المَصانِعِ قَد تَرَكنا","لَنا بِفِعالِنا خَبَراً مُشاعا",20,"ع",2,0],["وَفِي يَقِينِي أَنَّهُ قَامَ لِي","عِنْدَ أَخِي مِنْ نَفْسِهِ عُذْرُ",21,"ر",1,0],["وفي يميني ورود جئت أزرعها","على ضفائر فيها الليل مصلوب",22,"ب",1,0],["وفي يوم إذ رمى قبضة الثرى","فولت جموع الشرك وهي جوامح",23,"ح",1,0],["وفي يوسف الصديق أعظمُ حجة","بأن ليس للمخلوق في مثله حكم",24,"م",1,0],["وَفِي يَدَيكَ سَحابُ الجُودِ تُمطِرُها","عَلى الخَلائِقِ أَوراقاً وَعِقيانا",25,"ن",2,0],["وَفي يَدِهِ سِوارُ المُلكِ يُزهى","بِمعصمِ ماجِدٍ سَبطِ البَنانِ",26,"ن",1,0],["وفي يَميني يمين الموتِ مائلةً","في صورة السيف لم تنقصُ ولم تَزد",27,"د",1,0],["وَفي يومِ القيامةِ سوف يبدو","لهُ شرفُ الشفاعةِ قد تجلّى",28,"ل",2,0],["وَفي يَدِها خَشَباتُ رَبابٍ","تَشَظّى عَلَيهِ الأَسى فَاِنكَسَر",29,"ر",1,0],["وَفي يَومِ عيدٍ نقيِّ السَماءِ","كَأَنَّ السَما صَفحَةٌ من سُوَر",30,"ر",1,0],["وفي يديك لواء الحمد ثم لك ال","حوض الروي إذا ما أعوز الثمد",31,"د",1,0],["وَفِي يَدِهِ مِفْتَاحُ مِقْفَلِهَا","وَفِي مَشَاهِدِهِ تَوَلُّدُهَا",32,"د",3,0],["وَفِي يَدِ الأَحْزَانِ مُرْتَهَنٌ","شَخْصٌ تُغَادِيهِ بَوَائِقُهُمْ",33,"م",1,0],["وَفي يَومِ بَيسانٍ سَقيتَهُمُ الرَدى","وَغادَرتَ أَخلافَ المنيَّة حُفّلا",34,"ل",2,0],["وَفي يَدِ تَشْبِيبي قِيَادُ شَبِيبَتِي","وَخِلِّي وَحِلْمي مُسْتَقِيد ومُسْتَعْصِي",35,"ص",2,0],["وَفي يَدَيها مِن بَغيِها عُسُرٌ","وَالرِجلُ فيها مِن خَلفِهِ رَوَحُ",36,"ح",1,0],["وَفي يَدَيهِ سَماءٌ غَيرُ مُقلِعَةٍ","بِالجودِ صَوبُ عَزاليها الدَنانيرُ",37,"ر",1,0],["وفي يسار العيش أو يسره","وفي ابتعاد القلب أو قربه",38,"ه",1,0],["وفي يديه صِلال","طعامها من قلوب",39,"ب",1,0],["وَفي يَدَيكَ أَمانٌ لاجْتِماعِهُما","لِخَائبِ الجَمْعِ بَيْنَ النَّارِ والخَشَبِ",40,"ب",1,0],["وفي يَمنِيَ كُوْبٌ","وَفي يِسَارِيَ كُوْزْ",41,"ز",1,0],["وَفي يَميني اليُمنُ وَاليُسرُ في ال","يُسرى وَمِنّيَ الوَصلُ وَالحُبُّ",42,"ب",1,0],["وَفي يَميني حَجَرٌ دامِغٌ","لَرَأسِ لا حَيَّ بِهِ رَضخُ",43,"خ",1,0],["وَفي يَكن مَولد النعمان كانَ فَقل","هُوَ الإِمام إِمام الفَضل وَالفضلا",44,"ل",2,0],["وفي يُمنايَ ماضي الحدِّ أَبقى","بمضربه قِراعُ الخَطبِ إِثرا",45,"ر",2,0],["وفي يمينك شُكل","مغللاً باللهب",46,"ب",1,0],["وَفي يَوم بَدرٍ غنية وَكفايَة","وَقَد ذُلِّلَت في مضرَبَيكَ المَصاعِبُ",47,"ب",1,0],["وَفي يَوم عمروٍ أي لعمري مَناقِب","مُبَيَّنَةٌ ما مِثلهنَّ مناقِبُ",47,"ب",1,0],["وفي يمينِكَ يَجْري كَيْفَ تَأْمُرُهُ","ما يحسُدُ الذِّكْرَ عَنْهُ الصارِمُ الذَّكَر",48,"ر",1,0],["وفي يمينِ النسيمِ مألكةٌ","أسرّها فاقتضيْتُه العلَنا",49,"ن",2,0],["وفي يده للناس بالباس والندى","أقاليد أبواب التقى والناسك",50,"ك",1,0],["وفي يغوث ونسر أو يعوق وقد","تقطعت قطعاً قامت دلالته",51,"ت",2,0],["وفي يده الكريمة قعضبي","طويل الدرع معتدل القوام",52,"م",1,0],["وفي يدهِ البيضاءِ يقطُرُ ماؤها","ربيعٌ يَرُدُّ الجدبَ أخضرَ مُبقِلا",53,"ل",2,0],["وفي يدي من القلوب حبُّها","أملكها صبابةً وعُلَقا",54,"ق",2,0],["وفي يدكم أن تغاروا عليَّ","وأن تحفظوا فيَّ حقّاً أُضيعا",55,"ع",2,0],["وفي يدك الغني فابعث أمينا","إليّ به وصيِّرْهُ جوابي",56,"ب",2,0],["وَفي يَديك لَعوبُ المتنِ مُبتَدرٌ","إلى تقنّصِ نفس الفارس النَّجِدِ",57,"د",1,0],["وفي يديك رسولٌ منك تُرسلهُ","متى أردتَ إلى كلِّ المنيّاتِ",58,"ت",1,0],["وَفي يَدَيكَ بَقايا مِن سَراتِهِمُ","هُمُ لَدَيكَ عَلى وَعدٍ وَتَوعيدِ",59,"د",1,0],["وفي ياقين قد زرنا","أهالي مسجدٍ يُهدمْ",60,"م",1,0],["وفي يدهِ البيضاءِ تلكَ العصا التي","إذا ضَرَبَت صخراً تُؤَثِّرُ في الصَّخرِ",61,"ر",1,0],["وفي يدِهِ أمرٌ مُطاعٌ أجازَهُ","قديرٌ تَوَلَّى كافَ أمرٍ ونونهُ",62,"ن",2,0],["وفي يمينِكَ من سَيفٍ ومن قَلَمٍ","ما في حواشيهِ نيرانٌ وأمواهُ",63,"ا",2,0],["وَفِي يَمِيْنِي شَمَالُ شَمْسٍ","وَفِي شِمَالِي يَمِيْنُ بَدْرِ",64,"ر",1,0],["وفي يدهِ المحْيَا وفي خدِّه الحَيَا","وفي فمه السُّقْيا وفي وجْهه الفَرَجْ",65,"ج",1,0],["وفي يوم الكلاب إذ اعترتنا","قبائل أقبلوا متناسبينا",66,"ن",2,1],["وفي يميني ذو وميضٍ باتِرُ","صفيحةٌ ورثتها يا عامِرُ",67,"ر",1,0]]}