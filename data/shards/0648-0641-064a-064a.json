d=197377",""],[5718,"\"إلهى\"","https://www.poetsgate.com/ViewPoem.aspx?id=213785",""],[5736,"شكواي","https://www.poetsgate.com/ViewPoem.aspx?id=208435",""],[5798,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=139103",""],[5845,"أمن نيابتي برع تقيم","https://www.poetsgate.com/ViewPoem.aspx?id=16700",""],[5957,"حكايات (المسنجر)","https://www.poetsgate.com/ViewPoem.aspx?id=46453",""],[6127,"الأملُ الموعود","https://www.poetsgate.com/ViewPoem.aspx?id=198207",""],[6152,"يوما ما ستشاق لي","https://www.poetsgate.com/ViewPoem.aspx?id=213202",""],[6251,"عزة النفس .. إلى الرئيس إبراهيم الحمدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76482&r=&rc=22",""],[5190,"أُحقِّركُم وأكرَهُكُم جميعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85050&r=&rc=125",""]],"verses":[["وَفي يَدِي كَلِسانِ الأَيْمِ مُرْهَفَةٌ","غِرارُها بِمَقيلِ الرُّوحِ مُلْتَبِسُ",0,"س",1,0],["وَفي يَومِ المَصانِعِ قَد تَرَكن","لَنا بِفِعالِنا خَبَراً مُشاعا",1,"ع",2,0],["وفي يومِ بَدْرٍ إذْ رَمَى قَبْضَةَ الثّرى","فولّتْ جُموعُ الشِّرْكِ وهْيَ جَوامِحُ",2,"ح",1,0],["وفي يد ه سيف أُجيد صقاله","على أنه من صّنعة الله لا الهند",3,"د",1,0],["وفي يدهِ فاضليّ اليراع","مقيمٌ وسؤددهُ سير",4,"ر",1,0],["وفي يراعكَ سرٌّ من سعادته","قد صحَّ منه لعلمِ الحرف تأثير",5,"ر",1,0],["وفي يومِ الخميسِ قضاء خيرٍ","ففيه الله يأذن بالقضاءِ",6,"ا",2,0],["وفي يمينك بسطٌ","لِما يُحبُّ وقبضُ",7,"ض",1,0],["وَفي يَدي الشِمالُ أَشكالُ المُنى","وَصُوَرُ اليَقينِ وَالضَلالِ",8,"ل",1,0],["وَفي يَدومَ إِذا اِغبَرَّت مَناكِبُهُ","وَذِروَةِ الكورِ عَن مَروانَ مُعتَزَلُ",9,"ل",1,0],["وفي يديكِ مزاميرٌ يُخالِجُها","وَحْيُ السَّماءِ فهاتيها وغَنِّيني",10,"ن",2,0],["وَفي يَومِ صِفّينَ اِقتَسَمنا ذُرى العُلا","وَقَد جَعَلَ الخَطِّيُّ يَعثُرُ بِالكَسرِ",11,"ر",1,0],["وَفي يَدِكَ السَيفُ الَّذي اِمتَنَعَت بِهِ","صَفاةُ الهُدى مَن أَن تَرِقَّ فَتَخرَقا",12,"ق",2,0],["وَفي يَومِ مَنويلٍ وَقَد لَمَسَ الهُدى","بِأَظفارِهِ أَو هَمَّ أَن يَتَناوَلا",13,"ل",2,0],["وَفي يَمينِكَ سَيفُ اللَهِ قَد نُصِرَت","عَلى العَدُوِّ وَرِزقٌ غَيرُ مَحظورِ",14,"ر",1,0],["وَفي يَميني صارِمٌ يَجلو الكَرب","مَن يَلقَني يَلقَ المَنايا وَالعَطَب",15,"ب",1,0],["وَفي يَومِ الخَميسِ قَضاءُ حاجٍ","فَفيهِ اللَهُ يَأذَنُ بِالدُعاءِ",16,"ا",2,0],["وَفِيٌّ يُجازي المُذنِبينَ بِعَفوِهِ","وَلَكِنَّهُ عَن مالِهِ لا يَرىالعَفوا",17,"و",2,0],["وفي يده من الريحان عود","كأن مداده الذهب المذاب",18,"ب",1,0],["وَفي يُمناهُ إِبريقٌ وَماءٌ","وَكَأسُ الخَمرِ في يَدِهِ اليَسارِ",19,"ر",1,0],["وَفي يَومِ المَصانِعِ قَد تَرَكنا","لَنا بِفِعالِنا خَبَراً مُشاعا",20,"ع",2,0],["وَفِي يَقِينِي أَنَّهُ قَامَ لِي","عِنْدَ أَخِي مِنْ نَفْسِهِ عُذْرُ",21,"ر",1,0],["وفي يميني ورود جئت أزرعها","على ضفائر فيها الليل مصلوب",22,"ب",1,0],["وفي يوم إذ رمى قبضة الثرى","فولت جموع الشرك وهي جوامح",23,"ح",1,0],["وفي يوسف الصديق أعظمُ حجة","بأن ليس للمخلوق في مثله حكم",24,"م",1,0],["وَفِي يَدَيكَ سَحابُ الجُودِ تُمطِرُها","عَلى الخَلائِقِ أَوراقاً وَعِقيانا",25,"ن",2,0],["وَفي يَدِهِ سِوارُ المُلكِ يُزهى","بِمعصمِ ماجِدٍ سَبطِ البَنانِ",26,"ن",1,0],["وفي يَميني يمين الموتِ مائلةً","في صورة السيف لم تنقصُ ولم تَزد",27,"د",1,0],["وَفي يومِ القيامةِ سوف يبدو","لهُ شرفُ الشفاعةِ قد تجلّى",28,"ل",2,0],["وَفي يَدِها خَشَباتُ رَبابٍ","تَشَظّى عَلَيهِ الأَسى فَاِنكَسَر",29,"ر",1,0],["وَفي يَومِ عيدٍ نقيِّ السَماءِ","كَأَنَّ السَما صَفحَةٌ من سُوَر",30,"ر",1,0],["وفي يديك لواء الحمد ثم لك ال","حوض الروي إذا ما أعوز الثمد",31,"د",1,0],["وَفِي يَدِهِ مِفْتَاحُ مِقْفَلِهَا","وَفِي مَشَاهِدِهِ تَوَلُّدُهَا",32,"د",3,0],["وَفِي يَدِ الأَحْزَانِ مُرْتَهَنٌ","شَخْصٌ تُغَادِيهِ بَوَائِقُهُمْ",33,"م",1,0],["وَفي يَومِ بَيسانٍ سَقيتَهُمُ الرَدى","وَغادَرتَ أَخلافَ المنيَّة حُفّلا",34,"ل",2,0],["وَفي يَدِ تَشْبِيبي قِيَادُ شَبِيبَتِي","وَخِلِّي وَحِلْمي مُسْتَقِيد ومُسْتَعْصِي",35,"ص",2,0],["وَفي يَدَيها مِن بَغيِها عُسُرٌ","وَالرِجلُ فيها مِن خَلفِهِ رَوَحُ",36,"ح",1,0],["وَفي يَدَيهِ سَماءٌ غَيرُ مُقلِعَةٍ","بِالجودِ صَوبُ عَزاليها الدَنانيرُ",37,"ر",1,0],["وفي يسار العيش أو يسره","وفي ابتعاد القلب أو قربه",38,"ه",1,0],["وفي يديه صِلال","طعامها من قلوب",39,"ب",1,0],["وَفي يَدَيكَ أَمانٌ لاجْتِماعِهُما","لِخَائبِ الجَمْعِ بَيْنَ النَّارِ والخَشَبِ",40,"ب",1,0],["وفي يَمنِيَ كُوْبٌ","وَفي يِسَارِيَ كُوْزْ",41,"ز",1,0],["وَفي يَميني اليُمنُ وَاليُسرُ في ال","يُسرى وَمِنّيَ الوَصلُ وَالحُبُّ",42,"ب",1,0],["وَفي يَميني حَجَرٌ دامِغٌ","لَرَأسِ لا حَيَّ بِهِ رَضخُ",43,"خ",1,0],["وَفي يَكن مَولد النعمان كانَ فَقل","هُوَ الإِمام إِمام الفَضل وَالفضلا",44,"ل",2,0],["وفي يُمنايَ ماضي الحدِّ أَبقى","بمضربه قِراعُ الخَطبِ إِثرا",45,"ر",2,0],["وفي يمينك شُكل","مغللاً باللهب",46,"ب",1,0],["وَفي يَوم بَدرٍ غنية وَكفايَة","وَقَد ذُلِّلَت في مضرَبَيكَ المَصاعِبُ",47,"ب",1,0],["وَفي يَوم عمروٍ أي لعمري مَناقِب","مُبَيَّنَةٌ ما مِثلهنَّ مناقِبُ",47,"ب",1,0],["وفي يمينِكَ يَجْري كَيْفَ تَأْمُرُهُ","ما يحسُدُ الذِّكْرَ عَنْهُ الصارِمُ الذَّكَر",48,"ر",1,0],["وفي يمينِ النسيمِ مألكةٌ","أسرّها فاقتضيْتُه العلَنا",49,"ن",2,0],["وفي يده للناس بالباس والندى","أقاليد أبواب التقى والناسك",50,"ك",1,0],["وفي يغوث ونسر أو يعوق وقد","تقطعت قطعاً قامت دلالته",51,"ت",2,0],["وفي يده الكريمة قعضبي","طويل الدرع معتدل القوام",52,"م",1,0],["وفي يدهِ البيضاءِ يقطُرُ ماؤها","ربيعٌ يَرُدُّ الجدبَ أخضرَ مُبقِلا",53,"ل",2,0],["وفي يدي من القلوب حبُّها","أملكها صبابةً وعُلَقا",54,"ق",2,0],["وفي يدكم أن تغاروا عليَّ","وأن تحفظوا فيَّ حقّاً أُضيعا",55,"ع",2,0],["وفي يدك الغني فابعث أمينا","إليّ به وصيِّرْهُ جوابي",56,"ب",2,0],["وَفي يَديك لَعوبُ المتنِ مُبتَدرٌ","إلى تقنّصِ نفس الفارس النَّجِدِ",57,"د",1,0],["وفي يديك رسولٌ منك تُرسلهُ","متى أردتَ إلى كلِّ المنيّاتِ",58,"ت",1,0],["وَفي يَدَيكَ بَقايا مِن سَراتِهِمُ","هُمُ لَدَيكَ عَلى وَعدٍ وَتَوعيدِ",59,"د",1,0],["وفي ياقين قد زرنا","أهالي مسجدٍ يُهدمْ",60,"م",1,0],["وفي يدهِ البيضاءِ تلكَ العصا التي","إذا ضَرَبَت صخراً تُؤَثِّرُ في الصَّخرِ",61,"ر",1,0],["وفي يدِهِ أمرٌ مُطاعٌ أجازَهُ","قديرٌ تَوَلَّى كافَ أمرٍ ونونهُ",62,"ن",2,0],["وفي يمينِكَ من سَيفٍ ومن قَلَمٍ","ما في حواشيهِ نيرانٌ وأمواهُ",63,"ا",2,0],["وَفِي يَمِيْنِي شَمَالُ شَمْسٍ","وَفِي شِمَالِي يَمِيْنُ بَدْرِ",64,"ر",1,0],["وفي يدهِ المحْيَا وفي خدِّه الحَيَا","وفي فمه السُّ