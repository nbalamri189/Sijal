{"poems":[[55,"من شافعي وذنوبي عندها الكبر","https://www.aldiwan.net/poem30415.html","البسيط"],[65,"أماط والليل أثيث الجناح","https://www.aldiwan.net/poem46168.html","السريع"],[88,"ملك النهى لا تبعدي","https://www.aldiwan.net/poem10479.html","مجزوء الكامل"],[37,"خليلي إن أم الحكيم تحملت","https://www.aldiwan.net/poem39117.html","الطويل"],[87,"وممهد في الوكر","https://www.aldiwan.net/poem7930.html","مجزوء الكامل"],[47,"وإذا رأيت شمائل ابنى صاعد","https://www.aldiwan.net/poem63444.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[47,"وإذا رأيت شمائل ابني صاعد","https://www.poetsgate.com/ViewPoem.aspx?id=32930",""],[37,"خليليّ إنْ أمُّ الحكيم تحمَّلتْ","https://www.poetsgate.com/ViewPoem.aspx?id=22071",""],[139,"بهجة في نضارة في رواء","https://www.aldiwan.net/poem49098.html","الخفيف"],[237,"ما للدموع تسيل سيل الوادي","https://www.aldiwan.net/poem14701.html","الكامل"],[261,"قالت وقد كشف الوداع","https://www.aldiwan.net/poem48368.html","مجزوء الكامل"],[264,"كلنا في جماله ذو هيام","https://www.aldiwan.net/poem35562.html","الخفيف"],[264,"نحمد مولانا الذي قد اصطفى","https://www.aldiwan.net/poem35821.html","الرجز"],[266,"لا نلت عفوا الهنا عاف شذا","https://www.aldiwan.net/poem38374.html","الكامل"],[275,"هذا مليك القبة الزرقاء","https://www.aldiwan.net/poem35689.html","الكامل"],[285,"لاح الهلال فما يكاد يرى","https://www.aldiwan.net/poem60617.html","أحذ الكامل"],[369,"أهكذا يسري القمر","https://www.aldiwan.net/poem60902.html","مجزوء الرجز"],[369,"ألم يأن يا صاح أم قد أنى","https://www.aldiwan.net/poem61009.html","المتقارب"],[371,"ترى آثارهم إلا أماني","https://www.aldiwan.net/poem17124.html","الوافر"],[435,"بلغ الخليل المجد في","https://www.aldiwan.net/poem41421.html","مجزوء الكامل"],[438,"خذها كلون التبر ذائب","https://www.aldiwan.net/poem12560.html","مجزوء الكامل"],[440,"سيدنا لا يني حتى","https://www.aldiwan.net/poem25311.html","المنسرح"],[469,"حكمت بلوعتك الظباء الغيد","https://www.aldiwan.net/poem3597.html","عموديه"],[519,"خطرت فمال الغصن وهو ممنطق","https://www.aldiwan.net/poem20823.html","الكامل"],[592,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63866","المنسرح"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38992","الرمل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67847","الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25340","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56372","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56024","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144163","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1356,"","https://poetry.dctabudhabi.ae/diwan/poem/200257","الكامل"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76795","البسيط"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46488","الكامل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109349","السريع"],[2242,"","https://poetry.dctabudhabi.ae/diwan/poem/216450",""],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60845","الرجز"],[2740,"","https://poetry.dctabudhabi.ae/diwan/poem/126517","البسيط"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147353","الكامل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3655,"","https://poetry.dctabudhabi.ae/diwan/poem/205636","الكامل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118778","الرجز"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205672","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117922","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85007","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59461","الكامل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101378","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86498","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36636","الدوبيت"],[4091,"","https://poetry.dctabudhabi.ae/diwan/poem/141838","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90859","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133185","الرمل"],[4504,"","https://poetry.dctabudhabi.ae/diwan/poem/142718","الكامل"],[5032,"كمان اللّيل","https://www.poetsgate.com/ViewPoem.aspx?id=191770",""],[5136,"الحق أبلج واضح للمهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=121802",""],[5186,"يا لمنطاد أرضنا يتقلى","https://www.poetsgate.com/ViewPoem.aspx?id=156522",""],[5295,"أُخْتُ السَماءِ","https://www.poetsgate.com/ViewPoem.aspx?id=177208",""],[5431,"اسم بقلبي يُكتبُ","https://www.poetsgate.com/ViewPoem.aspx?id=186919",""],[3294,"ليل يجيء ونهار يذهب","https://www.poetsgate.com/ViewPoem.aspx?id=173257",""],[5638,"رسول الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=199078",""],[5674,"ترنيمة عاشقة فراتية","https://www.poetsgate.com/ViewPoem.aspx?id=190249",""],[5725,"سرّ منْ رأى","https://www.poetsgate.com/ViewPoem.aspx?id=177530",""],[5956,"إمّا اصطبر أو..‏","https://www.poetsgate.com/ViewPoem.aspx?id=183515",""],[5974,"نسائم العشق","https://www.poetsgate.com/ViewPoem.aspx?id=213853",""],[6082,"تبَا كفى","https://www.poetsgate.com/ViewPoem.aspx?id=58844",""],[6093,"شيطان صعدة","https://www.poetsgate.com/ViewPoem.aspx?id=198391",""],[6093,"خَالِد","https://www.poetsgate.com/ViewPoem.aspx?id=198602",""],[6213,"ميناء المطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76248&r=&rc=5",""]],"verses":[["كَالفَرعِ ساقِطَ ما يَعلوهُ مِن وَرَقٍ","وَالجَفنِ أُفرِدَ عَنهُ الصارِمُ الذَكَرُ",0,"ر",1,0],["كالفَنَنِ المَهْزوزِ تَعْتادُهُ","على لُغوبٍ نَسَماتُ الرّياحْ",1,"ح",1,0],["كَالفَرعِ هَزَّتهُ العَوا","صِفُ فَاِلتَوى ثُمَّ اِنكَسَر",2,"ر",1,0],["كَآلِفَةٍ إِلفاً إِذا صَدَّ وِجهَةً","سِوى وَجهِهِ حَنَّت لَهُ فَاِرعَوى لَها",3,"ل",3,0],["كَالفَحمِ غادَرَ في الرَما","دِ بَقِيَّةً لَم تُحرَق",4,"ق",1,0],["كَالفَرقَدَينِ إِذا تَأَمَّلَ ناظِرٌ","لَم يَعلُ مَوضِعُ فَرقَدٍ عَن فَرقَدِ",5,"د",1,0],["كالفَهْدِ إِنْ يَقْفِزْ وَكَالْهِرِّ إِنْ","يَهْبِطْ وَشِبْهُ الْحُوتِ إِنْ يَعْبُرِ",6,"ر",1,0],["كالفرقدين إذا تأمل ناظر","لم يعن موضع فرقد عن فرقد",7,"د",1,0],["كآلفة ٍ إلفاً إذا صَدَّ وِجْهَة ً","سوى وجههِ حنَّتْ فارعوى لها",8,"ل",3,0],["كالفراديس كل ما يشتهيهِ","في رباها وما يلذّ لرائي",9,"ا",2,0],["كَالفَجرِ يَومَ نَبا وَكَالجَوزاءِ يَو","مَ عَلا وَكَالضِرغام يَومَ طِرادِ",10,"د",1,0],["كالفرخ يضعف قلبه","عن أن يودع بالحزن",11,"ن",1,0],["كالفقيه الّذي تردَّى بنفسٍ","وله من هواه طيّش درسُ",12,"س",1,0],["كالفاضل الواصل ذي التقرُّبِ","يوسف مصر ذي الجمال الطيّبِ",13,"ب",1,0],["كالفقر من بعد الغنى فقراته","وغناؤه للسامعين عناء",14,"ا",2,0],["كالفاتحِ المجتازِ سورَ مدينةٍ","يدعو الى التأمينِ في الهيجاء",15,"ا",2,0],["كَالْفِتْرِ أَوْ كَالْحَجْلِ قَدْ فَتَحَتْ","مِنْهُ الْكَعابُ لِتَدْخُلَ الرِّجْلُ",16,"ل",1,0],["كألِفٍ بَيْنٍ سَطَر","فمَرّ كالظّبْيِ نَفر",17,"ر",1,0],["كإلْفِ مَواهبِه للأكُفْ","ف إلْفُ قَواضبِه للطُلى",18,"ا",1,0],["كَأَلفاظٍ خَلَت مِن ساكِنيها","فَيا شَوقي إِلى تِلكَ المَعاني",19,"ن",2,0],["كالفرقدين عليهما","حفظ الإله أمين",20,"ن",1,0],["كالفارسِ الرِّعْديدِ قد","جرّ القناةَ ومرّ هارب",21,"ب",1,0],["كَالفَأسِ لا يَستَجِدُّ قَطعاً","إلاَّ وَفي عَينِهِ هِرَاوَه",22,"ه",1,0],["كالفضّة البيضاءِ لكن قلبهُ","فظٌ على العشَّاقِ فهو حديد",23,"د",1,0],["كالفرقدَينِ تلابَسا فكلاهُما","أسنى من القمرِ المُنيرِ وأفوَقُ",24,"ق",1,0],["كالفاضل الثقة الموهوب تكرمة","فضلاً على الناس بالعلم الذي علما",25,"م",2,0],["كالفَلسِ لو رمتَ أن يجوزَ لما","وجدتَ فيه معنىً يُجَوِّزه",26,"ز",2,0],["كَالفُتوحاتِ الّتي قَد شهرَت","وَكَذا صاح فُصوص الحِكمِ",27,"م",1,0],["كالفَاضل البهْلول حبر زمَانه","صافي الصَّبابة قدوة المدّاح",28,"ح",1,0],["كَالفَقْعِ إِنْ يُهْمَزْ بِوَطْءٍ يُثْلَغِ","صاحِبُ سَوْآتٍ وَجُوعٍ هُنْبُغِ",29,"غ",1,0],["كالفضل ثمت حاتم وسواهما","من كل من نسبت له الأفضالُ",30,"ل",1,0],["كالفرك فوق النار في سمنٍ لهُ","شهد المذاق واشهد السمانُ",31,"ن",1,0],["كالفأس لا يستمرّ قطعا","إلّا وفي ثقبها هراوه",32,"ه",1,0],["كالفا وفي عند ومن بعد إلى","كاليا ومع إلا وإن وعن على",33,"ل",2,0],["كألف أوّلة للوصل","وألف أخيرة للفصل",34,"ل",1,0],["كألف في عالم تمثلا","وألف في طالما تخللا",34,"ل",2,0],["كالفاء في ابتدائه وفي الوسط","سيان والاخرى بقسمين تخط",35,"ط",1,0],["كالفجر أشرق من حجاب جهامه","أو كالهدي على منصة ساج",36,"ج",1,0],["كالفجرِ في البَلَدِ المحروسِ غُرَّتُهُ","والشمسُ من نُورِهِ الوضاحِ مُستَتِرَه",37,"ر",2,0],["كَالفص لَيسَ يبين مَعنى نَقشه","حَتّى يَكون بِناؤه مَقلوبا",38,"ب",2,0],["كالفجر لما انشق ضاءت لنا","أنواره تنبيءُ عمّا هناك",39,"ك",1,0],["كالفنانيل النُهود","ما بعد وصفه صِفاه",40,"ا",2,0],["كالفار يمشي لَيْلَهُ","حولَ رغيفِ يَثبِ",41,"ب",1,0],["كالفرد صَفوتَ من تاهت بعزَّتهِ","مراتب المجد دانيها وقاصيها",42,"ي",3,0],["كَالْفَيْلَسُوفِ المُسْتَجِيرِ بِقَبْضَةٍ","عَمْيَاءَ فِي حَشْوِ الغِيَابِ تُوَسَّدُ",43,"د",1,0],["كالفَضلِ وَالحارِثِ وَالنُّعمَانِ","فَذِكرُ ذا وَحَذفُهُ سِيَّانِ",44,"ن",1,0],["كالفجر يرسل في الدجنة خيطه","ويجر ثوب ضيائه بالمشرق",45,"ق",1,0],["كألف اثنين وواو الجمع","وياء أنثى خوطبت كاسترعي",46,"ي",1,0],["كالفجر تسري على مهل طلائعه","أو موكب النصر يدنو وهو يصطخب",47,"ب",1,0],["كالفقيه المقدم ابن علي","سابق القوم خيله لا تجارى",48,"ر",2,0],["كَالفَجرِ لَولا أَنَّ فيهِ كاذِباً","كَالبَدرِ لَكِن جَلَّ عَن نُقصانِهِ",49,"ن",2,0],["كالفَرقدِ الأحوى الأغرّ إذا","لرْبرَبهِ تبدَّى",50,"د",2,0],["كالفيل ليس بمرهب إن لم يكن","فيه زئير الليث ذي الأشبال",51,"ل",1,0],["كالفلك تشحنه غرائبه","فيشق لج الفكر مجدفه",52,"ف",2,0],["كالفَرع أرى جَمالَها يَشملها","مِن مفرق رأَسِها إِلى الأَقدامِ",53,"م",1,0],["كالفا جريين اللذين تدرعا","حُلل الحروب وللحروب صليل",54,"ل",1,0],["كالفجر جيدا زاهيا والصبح وج","ها باهيا والليل شعرا اجعدا",55,"د",2,0],["كالفتيله لم تزل في نفسها","تنفع الغير وتفنى في الوقود",56,"د",1,0],["كالفضَّةِ البيضاءِ إلاّ أنَّهُ","يلقاكَ من ذهَب الحياءِ مموَّها",57,"ه",2,0],["كالفَقْدِ ما يَجِدُ التّحَسُّسُ ها هنا","كالأمسِ ماُ تَتَملكُ الأحضانُ",58,"ن",1,0],["كالفضل لما راح يثني وجهه","عن نظرة الحسنا مراراً باليد",59,"د",1,0],["كالفراش المبثوث نمسي،","وكالعهن رواسي جباله وصروحه",60,"ح",2,0],["كالفاتناتِ تغنجا","يسبي العقولَ دلالُهُنَّهْ",61,"ن",2,0],["كالفاكهات مذاقها","كرزٌ وتينٌ طيبُ",62,"ب",1,0],["كالفتيات بزة لكنما","وجوههم من الصفاة اصلب",63,"ب",1,0],["كَالْفَجْرِ يَخْرُجُ مِنْ ظَلَامٍ دَامِسٍ","كَالرُّوحِ تُحْيِي الْمَيْتَ وَهْوَ رِمَامُ",64,"م",1,0],["كالفجرِ يشرقُ.. قد يزيلُ دجى العمى","فارحمْ خشوعي ..ذلّتي ودعائي",65,"ا",3,0],["كالفرقدين تعالا فوق جبهتها","العسكريّ ونورٌ من ابيهِ علي",66,"ل",2,0],["كالفقر كالأسقام أو كن صامدا","في سِجن شُغْلكَ تحت أصفادِ الرَّدَى",67,"د",2,0],["كالفَجْرِ أنتِ إذا مَا لاحَ منكِ سَنا","مِنْكِ النّسِيم إذا مَا هَبَّ يُحْييني",68,"ن",2,1],["كالفجر أقبل واختفى","كالجفن اُغْلق اذ غفا",69,"ف",2,1],["كالفأر لاذ بجحره في صعدة","مران لا تنجيك من قواس",70,"س",1,0],["كالفجْرِ يَنشُرُ في الفَضاءِ ضياءَهُ","فبَدا الوجُودُ مُنَمَّقًا ومُنَمْنَمَا",71,"م",2,0],["كالفجر تبدو كالبواعث في دمي","كصواعق تنتاب أحلام السحر",72,"ر",1,1]]}