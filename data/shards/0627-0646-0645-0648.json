{"poems":[[66,"قل لمن يبكي علينا حزنا","https://www.aldiwan.net/poem67542.html","الرمل"],[53,"غابن الحمد حقه مغبونه","https://www.aldiwan.net/poem66432.html","الخفيف"],[64,"ملنا إلى النشر الذي تلتقي","https://www.aldiwan.net/poem52394.html","السريع"],[68,"لو بعثتم في طي نشر النسيم","https://www.aldiwan.net/poem40338.html","الخفيف"],[52,"قرب دار الحبيب قرة عين","https://www.aldiwan.net/poem62276.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55074","الخفيف"],[111,"نكس العلام يا خير الملل","https://www.poetsgate.com/ViewPoem.aspx?id=67046",""],[52,"قُرْبُ دَارِ الحبيب قُرَّة ُ عَيْنٍ","https://www.poetsgate.com/ViewPoem.aspx?id=30990",""],[96,"أين أين الرعيل من أهل بدر","https://www.poetsgate.com/ViewPoem.aspx?id=13787",""],[91,"جف روض المنى وشح الربيع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=567172",""],[208,"عبيد يا غصن بان","https://www.aldiwan.net/poem53165.html","المجتث"],[228,"ملي النور قبل عهد البدور","https://www.aldiwan.net/poem39689.html","الخفيف"],[230,"نحن لله ما لحي بقاء","https://www.aldiwan.net/poem55098.html","الخفيف"],[246,"إن أسماء في الورى خير أنثى","https://www.aldiwan.net/poem45753.html","الخفيف"],[266,"عطفاً علينا يا زمان","https://www.aldiwan.net/poem38163.html","مجزوء الكامل"],[287,"حلفت لي هند فخانت يميني","https://www.aldiwan.net/poem32333.html","الخفيف"],[287,"عد عن العين واليعافير","https://www.aldiwan.net/poem32764.html","المنسرح"],[435,"مرحبا مرحبا بربة خال","https://www.aldiwan.net/poem39904.html","الخفيف"],[435,"يا كليما قد كلم القلب مني","https://www.aldiwan.net/poem41043.html","الخفيف"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/124040","الخفيف"],[1410,"","https://poetry.dctabudhabi.ae/diwan/poem/98153","الخفيف"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82326","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48980","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109332","الخفيف"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67215","الخفيف"],[2467,"","https://poetry.dctabudhabi.ae/diwan/poem/111699","الخفيف"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127396","الرمل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122494","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201637","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200219","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74228","الكامل"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67596","الخفيف"],[3062,"","https://poetry.dctabudhabi.ae/diwan/poem/204402",""],[3162,"","https://poetry.dctabudhabi.ae/diwan/poem/198744","البسيط"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121798","الخفيف"],[3277,"","https://poetry.dctabudhabi.ae/diwan/poem/125984","الكامل"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46011","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91870","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91198","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86351","الرمل"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35058","الخفيف"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28661","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72885","الرمل"],[4909,"نشيدي","https://www.poetsgate.com/ViewPoem.aspx?id=197325",""],[3591,"أيها الموت قد أخذلت الرجالا","https://www.poetsgate.com/ViewPoem.aspx?id=149461",""],[5145,"سربٌ يسامي الفرقدين بناؤه","https://www.poetsgate.com/ViewPoem.aspx?id=108207",""],[5179,"مَا لعين جنت على الْقلب ذَنْب","https://www.poetsgate.com/ViewPoem.aspx?id=190272",""],[2365,"أدرك الدّهر الذي طلبا","https://www.poetsgate.com/ViewPoem.aspx?id=200641",""],[5376,"نشيد الاقصى","https://www.poetsgate.com/ViewPoem.aspx?id=190447",""],[5720,"الْمُشَلْوِي","https://www.poetsgate.com/ViewPoem.aspx?id=204050",""]],"verses":[["إِنَّ مَوتي هُوَ حَياتي إِنَّني","أَنظُرُ اللَهَ جهاراً عَلَنا",0,"ن",2,0],["إنَّ موسى نَجِيُّ من لا يناجَى","شُدَّ منهُ بِعَوْنِهِ هارونه",1,"ن",2,0],["أنموذجُ الماءِ الذي جاءَنا ال","وعدُ بأنْ نُسْقَاهُ في الآخِرَه",2,"ر",2,0],["إِنَّ مَولايَ قَد تَوَلَّعَ جَهلاً","بَعدَ سِقطِ اللَوى بِوادي الصَريمِ",3,"م",1,0],["إِنَّ مَوتَ الَّذي يَموتُ مِنَ الحُب","بِ عَفيفاً لَهُ عَلى الناسِ فَضلُ",4,"ل",1,0],["إِنَّ مَوْتاً وَالعَيْشُ مَا زَالَ مَنْصُو","راً شَهِيَّ الحَيِّي لِمُرِّ المَذَاقِ",5,"ق",1,0],["إن موتاً وحياة حتماً","قبل هذا الخلق في لوح الأزل",6,"ل",1,0],["إِنَّ مَوْتَ الذِي يموت من الحُ","ب عفيفاً لهُ على الناس فضل",7,"ل",1,0],["إنّ موت العظيم محنة التاريخ","ودنيا تفنى وكون يزول",8,"ل",1,0],["ان موتا نخافه هو في الحق الى","ما قبل الحياة رجعوع",9,"ع",1,0],["أُنموذج الحور مَعهُ","أُنموذج الوِلدانِ",10,"ن",1,0],["إِنَّ مَوتي عَلى الربابِ رُقادٌ","يَنتَهي بي إِلى صَباحٍ مُنيرِ",11,"ر",1,0],["إِنَّ مَولاكَ كانَ أَحسَنَ مَن تُز","هى بِأَنوارِ وجههِ البَطحاءُ",12,"ا",2,0],["إن موتاً في ساحد الحربِ خيرٌ","لكَ من عيش ذلةٍ وخضوع",13,"ع",1,0],["انموت من ظماء عناً","والأرض يحييها عنان",14,"ن",1,0],["إِنَّ مَودودَ بنَ المُبارَكِ بَدرَ الدي","نِ لي مِنهُ خَيرُ حِصنٍ حَصينِ",15,"ن",1,0],["أُنموذَجٌ لِلجِنانِ رَبوَتُها","تُقَرِّرُ الوَعدَ أَيَّ تَقريرِ",16,"ر",1,0],["إن موسى قد أبطل السحر قبلا","ونراه أتى بسحر المقالِ",17,"ل",1,0],["ان موسى مذ غاب قد ضل قوم","كيف حالي وغاب عني وحدي",18,"ي",1,0],["إن مولود يا مجيد مجيد","يا مجيد اجزه جزاء المجيد",19,"د",1,0],["إنّ موت الكئيبِ أص","لحُ مِن أَن يعمّرا",20,"ر",2,0],["إِنَّ مَولاكَ قَد أَساءَ وَمَن أع","تَبَ مِن ذَنبِهِ فَغَيرُ مُسِيِّ",21,"ي",1,0],["إنَّ موتَ الرئيسِ أشرفُ موتٍ","يشتهيهِ الزمانُ وهو بخيل",22,"ل",1,0],["إن موسى أبلى مناظرة الكه","ان فيما أتت به وابتلاها",23,"ا",3,0],["إن موسى إتيانه باليد البيضا","ء من نيلها ومن أنداها",23,"ا",3,0],["ان موت العزيز تحت ظلال الن","قع خير من عيش خسف وخلب",24,"ب",1,0],["إنَّ مُوسى الكليم في الحُب ناجا","كَ بليلٍ من فوق طورِ رضاكا",25,"ك",2,0],["إنّ موتَ المحب من ألَمِ الشو","قِ وخوفِ الفِراقِ يُورث عُذرا",26,"ر",2,0],["إن موتا في عداد الهالكينا","لهو خير من حياة الخاضعينا",27,"ن",2,0],["إنَّ موتَ الإِمام رزءٌ جَسِيمٌ","وكُسُوفٌ كَسَا البِلاَدَ ظَلاَما",28,"م",2,0],["إن موسيقيَ الطبيعة أحلى","من لذيذ الغناء والترجيع",29,"ع",1,1],["إنّ موضوعكم يقاس بنفعٍ","وبضُرٍّ وكلُّ ذا عَرَضيُّ",30,"ي",1,0],["أنَموذج العلماء مغني من أَتى","يَبغي الشفاء البَحت مِن وَصب الوله",31,"ل",2,0],["إنَّ موتَ الفراشِ عارٌ وعجزٌ","وهو تحتَ السيوفِ فخرٌ مُنيفُ",32,"ف",1,0],["إن موسى بفضله","جمع الفضل أجمعا",33,"ع",2,0],["أنموذجاً لو أفاق العرب واقتبسوا","منه الكثير لما خابوا ولا خسروا",34,"ر",3,0],["إن مُوسَى راح يقْبِسُ ناراً","كلَّم اللّهَ رَبَّه تكْلِيمَا",35,"م",2,0],["أنموت في سبل الرقيّ ضحيةً","ونصير من أجل الرقي غبارا",36,"ر",2,0],["إِنَّ موسى أَثارَ حَرباً عَواناً","وَقراها مُحَمَّدٌ بِالنبالِ",37,"ل",1,0],["إن موتي وَحَياتي بعدهم","وَهمومي وَسروري لا كشيّ",38,"ي",1,0],["إِن مَولاك وَهوَ رَبٌّ رَحيمٌ","أَنزل الحَدّ فَاجعل الحَدّ فيصل",39,"ل",1,0],["إن موسى مذ أحال الشرفا","طبق الدنيا سروراً عرسه",40,"ه",1,0],["إن موسى ونشيدي والهنا","أرج في أرج في أرج",40,"ج",1,0],["إِنّ مَوتاً ليفضلنّ حياةً","كلّ يَومٍ نذوقُ فيها المنونا",41,"ن",2,0],["إِنَّ مَولايَ عَبدُ غَيري وَلَولا","شُؤمُ جَدّي لَكانَ مَولايَ عَبدي",42,"د",2,0],["إن مولانا الشريف النسبِ","صاحب الرشد منيف الحسبِ",43,"ب",1,1],["إنّ موسيقى نشيدي ستحيطُ بكَ، يا بنيَّ، إحاطةَ ذراعَي الحبِّ الشغوفَتَيْن.","وسيقبّلُ نشيدي جبينَكَ، قبلةَ البَرَكة.",44,"ه",1,1],["إن مولىً قد هزّ حين انتخاب الش","عب إياه سيداً إجبالا",45,"ل",2,0],["أنموذج من جنّة الخلد التي","أثنى عليها الله جلّ ثناؤه",46,"ا",3,0],["أَن موت العشاق من ألم الفر","قة فِي الْحبّ سنة تسْتَحب",47,"ب",1,0],["إنّ مولاكم أبا حسن","أحرز الغايات والقصبا",48,"ب",2,0],["إن موتَ المرءِ حرٌ","مثل عيشٍ في الخلودْ",49,"د",1,0],["أُنْمُوْذَجٌ فِيْ كُلِّ فِعْلٍ نَافِعٍ","وَهُوَ الْإِمَامُ ، وَقَوْلُهُ مَبْرُوْرُ",50,"ر",1,0]]}