9288",""],[90,"إلى الباجة جي \" في نكبته\"","https://www.poetsgate.com/ViewPoem.aspx?id=179138",""],[90,"ستالينغراد","https://www.poetsgate.com/ViewPoem.aspx?id=179193",""],[90,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"الثورة العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=178929",""],[90,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""],[51,"أقسمتُ والحنثُ له آثامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30408",""],[29,"ومحبوسة ٍ في الحيّ ضامنة ِ القرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17428&r=&rc=1",""],[3,"وتظلُّ عبْلة ُ في الخدور تجُرُّها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10748&r=&rc=102",""]],"verses":[["وَمَحوكَةٍ كَالدِرعِ أَحكَمَ سَردَها","صَنَعٌ فَأَفصَحَ في الزَمانِ الأَعجَمِ",0,"م",1,0],["وَمُحَجَّبٍ فَإِذا بَدا مِن نورِهِ","لِلرَكبِ مُلتَهِبُ المَطالِعِ مونِقُ",1,"ق",1,0],["وَمُحَجَّبٍ ضُرِبَت عَلَيهِ مَهابَةٌ","يُغشي العُيونَ بَهاؤُهُ وَضِياؤُهُ",2,"ا",3,0],["ومُحتَجِبٍ بالعزِّ مِن خَيرِهمْ أباً","زَجَرْتُ إليه المُقْرَباتِ المَذاكِيا",3,"ي",2,0],["وَمَحجوبَةٍ في الخِدرِ عَن كُلِّ ناظِرٍ","وَلَو بَرَزَت في اللّيلِ ما ضَلَّ مَن يَسري",4,"ي",1,0],["وَمُحدِّثٌ نَفسي بِهجرِكُمُ","إِنَّ المَلولَ دَواؤُهُ الهَجرُ",5,"ر",1,0],["وَمُحْتَقِبٍ مَاضِي الذُّبَابَيْنِ فِي الوَغَى","سَطَا مِنْهُ بِالأَنْفِ الحَمِّي ذُبَابَانِ",6,"ن",1,0],["وَمَحَتْ مَآثِرُكَ الْمَآثِرَ عِنْدَمَا","نُظِّمْنَ فِي نَحْرِ الْعُلاَ أَسْلاَكَا",7,"ك",2,0],["وَمَحامِدٌ نَسَجَت لَهُ أَكفانَهُ","مِن عِفَّةٍ وَسَماحَةٍ وَإِباءِ",8,"ا",2,0],["وَمَحا فوردُ آيَةَ المَشيِ حَتّى","شَرَعَ الناسُ يَنبِذونَ النِعالا",9,"ل",2,0],["وَمَحَت تِلكُمُ المَحاسِنَ مِنها","حينَ تَمَّت آياتُها آيَتانِ",10,"ن",1,0],["وَمَحَت آيَتُها آيَتَهُ","وَتَبَدَّت فِتنَةً لِلعالَمين",11,"ن",1,0],["وَمُحالِفُ الإِحسانِ يَمحو حلمُهُ","أَحقادَهُ وَالحُلمُ أَحسَنُ ماحِ",12,"ح",1,0],["وَمُحافِظٌ حسنُ الحَديثِ مُنَجَّحٌ","حَيثُ اِنتَحى نَحوَ الحَيا الفَيّاحِ",12,"ح",1,0],["وَمحالٌ قَولي لِنَفسي عَزاءً","سُرعَةُ السَيرِ عادَةُ الأَقمارِ",13,"ر",1,0],["وَمَحاسِنٌ تَندى رَقائِقُ ذِكرِها","فَتَكادُ توهِمُكَ المَديحَ نَسيبا",14,"ب",2,0],["وَمَحاسِنٌ زَهَرَ الزَمانُ بِزُهرِها","فَكَأَنَّما أَيّامُهُ أَعيادُ",15,"د",1,0],["وَمُحتَرِشٍ ضَبَّ العَداوَةِ مِنهُمُ","بِحُلوِ الخَلا حَرشَ الضِبابِ الخَوادِعِ",16,"ع",1,0],["وَمَحبِسُنا لَها بِعُفارِياتٍ","لِيَجمَعَنا وَفاطِمَةَ المَسيرُ",17,"ر",1,0],["وَمَحَّصَتِ التَّجَارِبُ أَيَّ نَدْبٍ","لَهُ فِي كُلِّ مَفْخَرَةٍ يَدَانِ",18,"ن",1,0],["وَمُحَاوِلٍ مُتَفَلْسِفٍ وَمُطَاوِلٍ","مُتَعَسِّفٍ وَمُمَاطِلٍ مُتَحَكِّمِ",19,"م",1,0],["وَمُحَبَّبَاتٍ مِنْ بَنَاتِ قَبِيلَتِي","خَفِرَاتِ إِيماءٍ فِصَاحَ كَلامِ",20,"م",1,0],["ومحياً صلت الجبين طليقٌ","يتلالا كأنه قنديل",21,"ل",1,0],["ومحبّة الأوطان لولاها لما","عَرف الأنام عداوة الأوطان",22,"ن",1,0],["وَمُحتَمِلٌ ضِغناً عَلَيَّ وَلَم يَكُن","لِيَبلُغَ جَهلي إِن جَهِلتُ وَلا حِلمي",23,"ي",1,0],["ومُحِلُّونَ مُحرِمُونَ مُقِرُّو","نَ لِحِلٍّ قَرَارَةً وحَرَامِ",24,"م",1,0],["ومحاسنُ الأقوال والشيمِ التي","قسمتْ لديهِ وسميتْ آدابا",25,"ب",2,0],["ومحامل ظعنت بمهجة ناحل","أرأيت من حملوا على الأعواد",26,"د",1,0],["ومحت غثاثة دهره نعماؤه","فكأنَّ ذاك غثاً وتلك سيول",27,"ل",1,0],["ومحاسن تزهو وتخلف عهدها","وكذا يكون الروض ذا ألوان",28,"ن",1,0],["ومحل سامي السماك إلى أن","حررته كواكب الميزان",29,"ن",1,0],["ومحاريب شدْتها بدروس","وصلاة تحبى إليها وتجلى",30,"ل",2,0],["ومحالٌ أن يسعدَ السعداءُ ال","دهرَ إلّا بِشِقْوةِ الأشقياءِ",31,"ا",2,0],["ومحبوبُهُ رَهْنُ مكروهِهِ","ومكروهُهُ رهنُ محبوبِهِ",32,"ب",2,0],["ومَحَلّي عَاريَّةٌ وجدارا","تُ بيوتي فكلُّها منقوبُ",33,"ب",1,0],["ومحبِسُه العطيةَ مستزيداً","نَدَى يَدِه وليس بمستزادِ",34,"د",1,0],["ومحاسنُ الأشياءِ فيك معاً","فملالِتيكَ ملالتي بصري",35,"ر",2,0],["ومحامدٍ نادت مُسمِّيَهُ","تاللَهِ ما سمَّيتَ بالعكس",36,"س",1,0],["ومحالٌ قبول عِرسكَ منك ال","خسف ما لم يَشْركك فيها شريك",37,"ك",1,0],["ومُحالٌ ألّا يقومَ بما قلْ","لَدَهُ الأولياءُ كُلَّ القِيامِ",38,"م",1,0],["ومحبُّ الحبيبِ لا شك فيه","كارهٌ للكريه يا إنسان",39,"ن",1,0],["ومُحالٌ يعشقُ التخ","نيثَ إلا حَلَقِيُّ",40,"ي",1,0],["وَمَحبوسَةٍ في الحَيِّ ضامِنَةِ القِرى","إِذا اللَيلُ وافاها بِأَشعَثَ ساغِبِ",41,"ب",1,1],["وَمُحتَقِرٌ جَوزَ الفَلاةِ إِذا اِنتَحى","وَشُدَّ بِمَقتورٍ مِنَ المَيسِ كاهِلُه",42,"ل",2,0],["وَمَحَبَّةً لِلخَيرِ تَسري في دَمي","وَرِعايَةً لِلضَعفِ وَالضُعَفاءِ",43,"ا",2,0],["وَمُحَلِّقٍ بَينَ المَجَرَّةِ وَالسُها","صَعَدَ الحِمامُ إِلَيهِ في الطَيَرانِ",44,"ن",1,0],["وَمُحَكِّماً عَلِمَ القَضاءُ مَكانَهُ","في المُقسِطينَ الجِلَّةِ الأَنزاهِ",45,"ا",2,0],["ومَحَوْتُ كلَّ لُبانةٍ من خاطري","ونَسِيتُ كلَّ تَعاتُبٍ وتَشاكي",46,"ك",2,0],["وَمَحاسِنُ الأَخلاقِ فيكَ تَغَيَّبَت","عاماً وَسَوفَ تُغَيَّبُ الأَعواما",47,"م",2,0],["وَمُحِلَّ الفَقيرِ بَينَ ذَويهِ","وَمُعِزَّ اليَتيمِ بَينَ صِغارِهِ",48,"ر",2,0],["وَمُحَمَّدٌ صَلّى عَلى جَنَباتِهِ","وَاِستَقبَلَ السَمَحاتِ في أَرجائِهِ",49,"ا",3,0],["وَمَحا الرَواحُ إِلى مَغا","ني الوُدِّ ما اِقتَرَفَ البُكور",50,"ر",1,0],["وَمَحا الحَمراءَ إِلّا عَمَداً","نَزعُها مِن عَضُدِ الأَرضِ عَسِر",51,"ر",1,0],["وَمَحاريبَ كَالبُروجِ بَنَتها","عَزَماتٌ مِن عَزمَةِ الجِنِّ أَمضى",52,"ض",2,0],["وَمُحَجَّباتٍ هُنَّ أَط","هَرُ عِندَ نائِبَةٍ كِفايَه",53,"ا",3,0],["ومَحْجُوبة في الخِدْرِ عنْ كُلِّ ناظِرٍ","ولَوْ بَرَزَتْ ما ضَلَّ بالليلِ مَنْ يَسْرِي",54,"ي",1,1],["وَمَحَلُّ قائِمِهِ يَسيلُ مَواهِباً","لَو كُنَّ سَيلاً ما وَجَدنَ مَسيلا",55,"ل",2,0],["ومحجوبةٍ لو هبَّتِ الريحُ أرقلت","إليها الغيارى بالعوالي ولم يلْوُوا",56,"و",2,0],["ومُحاذرٍ وَخْزَ الهوانِ صَحِبْتُه","فَسرى بضوء جبينهِ الأركُوبُ",57,"ب",1,0],["وَمَحَلَّةٍ تَعلو فَتَسقُطُ دونَها","هِمَمُ العِدى وَنَفاسَةُ الحُسّادِ",58,"د",1,0],["وَمُحتَرِسٍ مِن أَينَ رُمتَ اِغتِرارَهُ","وَجَدتَ لَهُ سَهماً إِلَيكَ مُفَوَّقا",59,"ق",2,0],["وَمِحِبّونَ لِلرَسولِ وَأَهلِ ال","بَيتِ حُبّاً يُرضونَ فيهِ الرَسولا",60,"ل",2,0],["وَمَحذُوَّةٍ بَينَ الحِذاءَ الَّذي لَها","وَبَينَ الحَصى نَعلاً مُرِشّاً بَصيرُها",61,"ر",3,0],["وَمُحتَقِرينَ السَيرَ قَد أَنهَجَت لَهُم","سَرابيلَ أَبقاها الَّذي قَد تَرَعبَلا",62,"ل",2,0],["وَمُحَرِّقاً صَفَدوا إِلَيهِ يَمينَهُ","بِصِفادِ مُقتَسَرٍ أَخوهُ مُكَبَّلُ",63,"ل",1,0],["وَمَحفورَةٍ لا ماءَ فيها مَهيبَةٍ","يُغَطّى بِأَعوادِ المَنِيَّةِ نابُها",64,"ب",3,0],["ومَحَوْتَ آثارَ الصَّليبِ فلم تَدَعْ","للعينِ منها مَعلَماً مَعلوما",65,"م",2,0],["ومحبوسَةُ الأنفاسِ مَجروحَةُ الحَشا","يُخَفِّفُ عنها الصَّبُّ وهو ثَقيلُ",66,"ل",1,0],["ومُحكَّمانِ على النُفوسِ وربَّما","لم يَحكُما فيهِنَّ حُكماً عادِلا",67,"ل",2,0],["ومحلَّ خاشِعَةِ القُلوبِ تَفَرَّدُوا","بالذِّكْرِ بينَ فُروقِه وفُروقِ",68,"ق",1,0],["ومَحلُّ عِزٍّ شاملٍ ما احتلَّه","باغٍ كَساه البغيُ ثَوبَ خِلافِ",69,"ف",1,0],["ومَحجوبَةٍ بالماءِ عَنْ كُلِّ ناظِرٍ","ولكَّنها من حُجبِها تُتَخَطَّفُ",70,"ف",1,1],["وَمُحتَرِسٍ مِن نَفسِهِ خَوف ذِلَّةٍ","تَكونُ عَلَيهِ حُجَّةٌ هِيَ ماهِيَا",71,"ي",2,1],["وَمُحَمَّد فينا كَأَنَّ جَبينَهُ","شَمسٌ تَجَلَت مِن خِلالِ غِمامِ",72,"م",1,0],["وَمُحَمَّدٌ لَكَ إِن سَلَكتَ سَبيلَهُ","في كُلِّ خَيرٍ قائِدٌ وَإِمامُ",73,"م",1,0],["وَمَحلُ الخَدِّ مِن غَي","رِ مَسيلِ الدَمعِ لا يُسقى",74,"ق",2,0],["وَمُحيلُ العامِ المَحيلِ إِذا اِعتا","دَ لِسانُ الفَصيحِ نُطقَ الذُبابِ",75,"ب",1,0],["ومحيِّرُ الأفهام لحظان","قَرَآ كتابَهما وما كادا",76,"د",2,0],["ومحصَّبٍ بالدرّ تحسبُ تربَهُ","مسكاً تَضَوّعَ نشره وعبيرا",77,"ر",2,0],["وَمُحُوا من صحيفةِ الدهر طُرّاً","مَحوَ هُوجِ الرياح آياتِ رسمِ",78,"م",1,0],["ومُحلَولِكٌ ما فكَّ زيجاً ولا لَهُ","بِسِرِّ قضاء النجم علمٌ ولا طبعُ",79,"ع",1,0],["ومحسودةٍ لا تحسُدِ الغيدُ مِثلها","لها في عميم الخَلْقِ حُسْنٌ مُنَوَّعُ",80,"ع",1,1],["وَمَحْوُ النّهار بكافورةٍ","من النور عنبرةَ الحندسِ",81,"س",1,0],["ومحالٌ نَقْلُكَ الطبعَ الَّذي","كَانَ مِنهُ في كَريمِ المَولِدِ",82,"د",1,0],["ومحتْ أسْطُرَ شوقٍ كُتِبَتْ","بدموع نِقْسُها قلبٌ مذاب",83,"ب",1,0],["وَمُحَجَّبٍ حاوَلتُهُ فَوَجَدتُهُ","نَجماً عَلى الرَكبِ العُفاةِ شَسوعا",84,"ع",2,0],["وَمُحتَكِمٍ في الخُمصِ طَوراً وَفي البُدنِ","فَقَد دَقَّ عَن حِقفٍ وَقَد جَلَّ عَن غُصنِ",85,"ن",1,1],["وَمَحدودِ الذَريعَةِ ساءَهُ ما","تُرَشِّحُ لي مِنَ السَبَبِ الحَظِيِّ",86,"ي",1,0],["وَمُحرِماً أَحرَمَت أَرضُ العِراقِ لَهُ","مِنَ النَدى وَاِكتَسَت ثَوباً مِنَ البَخَلِ",87,"ل",1,0],["وَمُحلِفَةً لَمّا تَرِد أُذنَ سامِعٍ","فَتَصدُرَ إِلّا عَن يَمينٍ وَشاهِدِ",88,"د",1,0],["وَمَحَّصْتُ أمْرَكَ لم أرْتَهِبْ","بِنَقْلِ \" الرُّوَاةِ \" ولم أُُخْدَعِ",89,"ع",1,0],["وَمُحَدِّثٍ قَد باتَ يُؤنِسُني","رَخصِ البَنانِ مُهَفهَفِ الخَصرِ",90,"ر",1,0],["وَمَحمولَةٍ فَوقَ المَناكِبِ عِزَّةً","لَها نَسَبٌ في رَوضَةِ الحَزنِ مُعرِقُ",91,"ق",1,1],["وَمَحكَمَةُ الدَهرِ مِن بعدِنا","تُقامُ لِأَجداثِنا وَالرُفاتِ",92,"ت",1,0],["ومُحكَمُ ذكرهِ فاجعلْهُ وِردا","فإنّ له على الأكبادِ بَردا",93,"د",2,0],["وَمَحَت جَميلَ الصَبرِ مِنّي عَبرَةٌ","خُطَّت بِها في صَفحَتي آثارُ",94,"ر",1,0],["وَمَحاريجَ مِن سِعارٍ وَغينٍ","وَغَماليلِ مُدجَناتِ الغِياضِ",95,"ض",1,0],["وَمَحاهُ تَهطالُ أَسمِيَةٍ","كُلَّ يَومٍ وَلَيلَةٍ ترِدُه",96,"د",2,0],["وَمُحَجَّلٍ غَيرَ اليَمينِ كَأَنَّهُ","مُتَبَختِرٌ يَمشي بِكُمٍّ مُسبَلِ",97,"ل",1,0],["وَمُحَرِّقٍ طاقَينِ مِن سَبَجٍ","في عاجِ وَجهٍ لاحَ كَالسُرُجِ",98,"ج",1,1],["وُمُحَيّاً كالشَّمس منكَ مُضِيءٌ","أسْفَرَت عنه ليلةٌ غَرّاءُ",99,"ا",2,0],["وَمُحَدِّثٍ كَثُرَت طَرائِفُهُ","عانٍ لَدَيَّ بِقِلَّةِ الوَفرِ",100,"ر",1,0],["وَمَحبَرَتي رَأسُ الرَياءِ وَدَفتَري","وَنَعلايَ في كَفَّيَّ مِن آلَةِ الخَتلِ",101,"ل",1,0],["وَمُحَكَّمٍ في مُهجَتي","وَالجورُ في أَحكامِهِ",102,"م",2,1],["وَمَحبِسِ يَومٍ جَرَّتِ الحَربُ ضَنكَهُ","دَنا ظِلُّهُ وَاِحمَرَّ حَتّى تَحَمَّما",103,"م",2,0],["وَمُحتَرِقِ الوَديقَةِ يَومَ نَحسٍ","مِنَ الجَرزاءِ ظَلَّ لَهُ أَوارُ",104,"ر",1,0],["وَمَحاسِنُ الدُوَل الَّتي غُرَّت بِها","حالَت فَقَبلَ حِسانُها شَنِعاتُها",105,"ت",3,0],["ومُحَمَّدٌ وَهُوَ المُنَبَّأُ يَشتَكي","لِمَكانِ أَكلَتِهِ اِنقِطاعَ الأَبهُرِ",106,"ر",1,0],["وَمَحاسِنُ الدُنِّيا الأَنيسُ وَإِنَّما","أَشباحُ سادَتِهِم أَهِلَّةُ أَشهُرِ",106,"ر",1,0],["ومُحَيّاكَ للّذي يَعْبُدُ الدّهْ","رَ وإهْباءُ طِرْفِكَ الفَتَيَانِ",107,"ن",1,0],["ومَحجوبةٍ حَجمَ الثُّديِّ نواهدٍ","تميسُ بها الأغصانُ منْأدَّةً ثقْلا",108,"ل",2,0],["وَمحاول جحداً لمج","دي كَي يَنال بذاك مجدا",109,"د",2,0],["ومحاريبُ للعذارى إذا ما","سَكَب الغربُ في الدجى أُرجوانَه",110,"ن",2,0],["ومحا سناهُ ظلام أنفسهم وما","حُمِّلْنَ من ذل النكوص وعارِهِ",111,"ر",2,0],["ومحبَّةٍ للخيرِ صَفوُ مِزاجِها","مرضاةُ نفسٍ أو عزاءُ فُؤادِ",112,"د",1,0],["ومَحْواةِ أرْضٍ صَدّ محْوَةَ بُعدُها","وَحِيُّ المنايا مِن أساوِدِها نَشْطُ",113,"ط",1,0],["ومحمد سليمان ووجهك سرمد","يعنو له الأملاك والأمراء",114,"ا",2,0],["وَمُحَمَّدُ ابنُكِ كَانَ أولَ","مُنْجِدٍ سَمِعَ الدُّعَاءْ",115,"ا",2,0],["وَمُحِبِّي الأَمْثَالِ يَضْرِبُهَا","التَّالُونَ وَالسَّابِقُونَ لِلأَعْقَابِ",116,"ب",1,0],["وَمُحَولَيْنِ لِنَفْع مِصْرَ وَأَهلِهَا","مَا لَمْ يَكُنْ إِلاَّ لِنَفْعِ جَوَالِي",117,"ل",2,0],["ومُحَيّاً فيِه مِنَ اللّه سِرٌّ","كادَ يُغْشِيهِ نُورُهُ وحَيَاؤُه",118,"ا",3,0],["ومحمدٌ ولَّى، ومن كمحمدٍ؟","مَن مثلُه في نُبلِهِ وإبائه؟",119,"ا",3,0],["ومحدِّثِ تحوي صحائفُ صدره","ما غاب عن (خَلَفَ)، وعن (حمَّاد)",120,"د",1,0],["ومُحاربينَ لغيرهم أسلابُها","لكنهم يتحملُون خَسارها",121,"ر",3,0],["ومُحَطِّمُو الأغلالِ عن سَاقِ الحِمَى","من بعد ما وَرِمَتَ من الأَغْلالِ",122,"ل",1,0],["وَمَحوْنَا عن مصرَ وَصْمَةَ عار","بَرئَتْ أرضُها من الوَصَمَات",123,"ت",1,0],["ومحاريبٌ بشرق الأرض، أو","غربِها تَشْدُو بتكبيرِ الإله",124,"ا",3,0],["ومحتملٍ للحقِ مستأنسٍ به","يُرَجّيهِ مظلومٌ ويَخشَاهُ ظالم",125,"م",1,0],["ومحوتِ العجب من اسطاره","وملأت الصَّلَفَ المحضَ ازدراء",126,"ا",2,0],["ومُحَرَّقين يُغازلون وَقودَها","شوقاً إليكِ ويَحمَدون الواقدا",127,"د",2,0],["ومحمداً ما إنْ أهابَ بجيشهِ","يطأ البلادَ روابياً وفدافدا",127,"د",2,0],["ومحمدٌ رَفَعتْ رسالةُ ربَّه","كَفّاهُ ، لا الأخوالُ والأعمام",128,"م",1,0],["ومُحتقِبٍ شرَّ ما يُجتوى","مشى ناصباً رأسهُ كاللِّوا",129,"ا",1,0],["ومحرِجَ المُوسِرِ الطاغي بنعمتهِ","أنْ يُشرِكَ المُعْسِرَ الخاوي بما نهبا",130,"ب",2,0],["ومحشَرجِ وقفَ الحِمامُ ببابهِ","فدفعتَهُ عنه فزُحزِحَ خائبا",131,"ب",2,0],["ومحي لليل التم يحمي بطرفه","ثغوراً أضاعتها العيون الهواجع",132,"ع",1,0],["وَمَحلاً خِصبا فحلَّ بوادٍ","أنبتَ اللهُ حولَهُ ريحانه",133,"ن",2,0],["ومحتد أعراقُه كرام","من قبل أن تلزمك الأحكام",134,"م",1,0],["ومحبوسة ٍ في الحيّ ضامنة ِ القرى","إذا الليلُ وافاها، بأشعت ساغبِ",135,"ب",1,1],["ومُحلَّمٌ يَسْعَوْنَ تحْتَ لوائِهِ","والموتُ تحتَ لواءِ آلِ محلم",136,"م",1,0]]}