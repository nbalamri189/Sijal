{"poems":[[74,"قدمت كالسيف إلى غمده","https://www.aldiwan.net/poem18559.html","السريع"],[66,"لي حبيب أزور في الخلوات","https://www.aldiwan.net/poem67660.html","الخفيف"],[93,"أنا لست في دنيا الخيال ولا الكرى","https://www.aldiwan.net/poem8868.html","عموديه"],[45,"لعينيك ما يلقى الفؤاد وما لقي","https://www.aldiwan.net/poem9733.html","الطويل"],[69,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[66,"لي حبيبٌ أزور في الخلوات","https://www.poetsgate.com/ViewPoem.aspx?id=8521",""],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[203,"غير قلبي أراه يسطيع صبرا","https://www.aldiwan.net/poem45561.html","الخفيف"],[445,"تبلج عن إشراق غرتك الصبح","https://www.aldiwan.net/poem34816.html","الطويل"],[445,"تخيرت فاستمسكت بالعروة الوثقى","https://www.aldiwan.net/poem34892.html","الطويل"],[563,"فر يا طائرا إلى ربك","https://www.aldiwan.net/poem34262.html","الخفيف"],[567,"طال ميعادنا فخلناه دهرا","https://www.aldiwan.net/poem52935.html","الخفيف"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103083","الكامل"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45403","الطويل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140007","الطويل"],[3524,"","https://poetry.dctabudhabi.ae/diwan/poem/124598","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102961","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102965","الوافر"],[6108,"رحلة","https://www.poetsgate.com/ViewPoem.aspx?id=192588",""]],"verses":[["هوادِج تحملُها من سرى","فواقع الآل على مدّه",0,"د",2,0],["هُوَ أَدنى مِنَ الضَميرِ إِلى الوَه","مِ وَأَخفى مِن لائِحِ الخَطَراتِ",1,"ت",1,0],["هُوَ آدَمُ الأَشجارِ أَدرَكَهُ الحَيا","لَمّا تَبدّى عُريُهُ فَتَسَتَّرا",2,"ر",2,0],["هَوادٍ لِأَملاكِ الجُيوشِ كَأَنَّها","تَخَيَّرُ أَرواحَ الكُماةِ وَتَنتَقي",3,"ق",2,0],["هَوَ آدَمٌ فِي الفَضْلِ إِلَّا أنّهُ","لَمْ يُعْطَ حالَ النَّفْخَةِ التَّكْمِيلا",4,"ل",2,0],["هو أدل من الضمير إلى الوهم","وأخفى من لائح الخطرات",5,"ت",1,0],["هُوَ أَدنى عَبيدِ مَولاهُ مِنهُ","ما لِعَبدٍ لَم يُدنِهِ إِدناءُ",6,"ا",2,0],["هو أدرى بما أحاولُ منهُ","وأنا بالذي يحاولُ أدرى",7,"ر",2,0],["هَوَادٍ إِذَا جَلَّيْنَ عنكَ لِناكِثٍ","فَحَتْمُ المنايا من لَواحِظِها لَمْحُ",8,"ح",1,0],["هَوادِيَ فِي ضَنكِ المَكَرِّ ولا هُدىً","نَواطِقَ بالفتح المبينِ ولا نُطقاً",9,"ق",2,0],["هو أدنى إليك منك له","كل نفس فالنفس من حجبك",10,"ك",1,0],["هُوَ أدرى بعَجْزِنا عن ثَناهُ","فَهْوَ يَعفُو عَنّا ويَقبَلُ عُذرا",11,"ر",2,0],["هو آدم الإنسان لا متحجب","بالعجز عنه دائماً يتعذر",12,"ر",1,0],["هَوادٍ عَلى أَعجازِها قيمُ النَدى","فَأَربح بِنا مَشرِيَّ حَمدٍ وَشارِيا",13,"ي",2,0],["هواديك آيات الكتاب وإنها","لتشفى جوىً من يشتكي بجواه",14,"و",3,0],["هوادجها تكسو جمالا جمالها","وتجمل فوق الناجيات قتودها",15,"د",3,0],["هوادج تبدو فوق أسنمة المطا","حسانا كما يبدو السوار على الزند",16,"د",1,0],["هواد للرجال إلى مناها","تسوم بالفتوح لها هواد",17,"د",1,0],["هو آدمُ المطرودُ ..دونَ خطيئةٍ","مَن حلّلَ القتلَ الغبيَّ وعلّلهْ!؟",18,"ل",2,0]]}