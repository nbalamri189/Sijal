,"","https://poetry.dctabudhabi.ae/diwan/poem/72481","البسيط"],[4718,"ياهيه ..","https://www.poetsgate.com/ViewPoem.aspx?id=136928",""],[4718,"ياما حلا الفنجال","https://www.poetsgate.com/ViewPoem.aspx?id=137107",""],[4755,"قفزةٌ على ظَهر الصّمت","https://www.poetsgate.com/ViewPoem.aspx?id=184177",""],[4869,"خوف الخيانه","https://www.poetsgate.com/ViewPoem.aspx?id=151538",""],[4927,"أهلا وسهلا","https://www.poetsgate.com/ViewPoem.aspx?id=29615",""],[5009,"في ذكرى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=24366",""],[5030,"جرمٌ كبيرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=215696",""],[5050,"خير الرجال فتى في الهول قد ثبتا","https://www.poetsgate.com/ViewPoem.aspx?id=38203",""],[5055,"نفحة الأرطا","https://www.poetsgate.com/ViewPoem.aspx?id=106745",""],[5363,"بعصى الجهاد تفجِّر الصحواتِ","https://www.poetsgate.com/ViewPoem.aspx?id=144288",""],[5401,"ضابط الإيقاع","https://www.poetsgate.com/ViewPoem.aspx?id=78141",""],[5525,"ردي على الصوت","https://www.poetsgate.com/ViewPoem.aspx?id=947",""],[5561,"طيفًا يزورُكَ ...","https://www.poetsgate.com/ViewPoem.aspx?id=203216",""],[5573,"العدل والميل","https://www.poetsgate.com/ViewPoem.aspx?id=200222",""],[5725,"زرني بليلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=201274",""],[5804,"حوار معا الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=191224",""],[5829,"بوح الظمآن","https://www.poetsgate.com/ViewPoem.aspx?id=179846",""],[5953,"الله أكبر أكبر الله","https://www.poetsgate.com/ViewPoem.aspx?id=93797",""],[5956,"يستلهم الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=182395",""],[5956,"لا نفْعَ تفعلهُ","https://www.poetsgate.com/ViewPoem.aspx?id=192935",""],[5956,"أعانك الله في ترتيب أنفسكم","https://www.poetsgate.com/ViewPoem.aspx?id=193864",""],[6069,"يا من يعيب علي حب مدللٍ","https://www.poetsgate.com/ViewPoem.aspx?id=105675",""],[463,"من ناظرٌ لي بين سلعٍ وقباَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59981&r=&rc=37",""],[6290,"بِكُلِّ بَلِيَّةٍ يَزْداَدُ سِنِّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85161&r=&rc=9",""]],"verses":[["يُرضيكَ ظاهِرُهُ وَبَينَ ضُلوعِهِ","قَلبٌ بِما يُدني إِلَيكَ مُتَيَّمُ",0,"م",1,0],["يُرْضي النّديمَ فمَهْما","سَقَى الرِّياضَ كَساهُ",1,"ه",1,0],["يَرْضى الرّضيُّ بِها إذا ما أُنْشِدَتْ","يوْماً ويعْرِفُ فضْلَها مِهْيارُهُ",2,"ر",2,0],["يُرضي المُرَتِّلَ في الكَنيسَةِ صُنعُهُ","كَيساً وَيُرضي ساكِنَ المِحرابِ",3,"ب",1,0],["يَرُضنَ صِعابَ الدُرِّ في كُلِّ حِجَّةٍ","وَلَو لَم تَكُن أَعناقُهُنَّ عَواطِلا",4,"ل",2,0],["يَرضى بِها كُلُّ مَن كانَت سَريرَتُهُ","تَقوى الإِلَهِ وَبِالأَمرِ الَّذي شَرَعوا",5,"ع",3,0],["يُرْضِي وإن لهوجْتَهُ تَلهوَجا","فلا يَعُدْ كَرْمُ كريم عَوْسَجَا",6,"ج",2,0],["يُرضيك من مَرأىً ومن مَخْبَرٍ","يا لك من قَبْلٍ ومن بعْدِ",7,"د",1,0],["يَرضى لِمَوطِنِهِ يَصيرُ مُواطِناً","وَتَصيرُ أُمَّتُهُ إِلى أَجناسِ",8,"س",1,0],["يرضى به من كان ذا","نظرٍ بعين العقل ثاقب",9,"ب",1,0],["يُرضيهمُ بعدَ الصدى وِرْدُ الصَّرَى","رِفْهَاً وغِبَّا",10,"ب",2,0],["يَرضى فَيَرمي بِاللُهى سَماحَةً","وَيَغضَبُ المَوتُ إِذا الفَتحُ غَضِب",11,"ب",1,0],["يُرضيكَ مِن حَسَنٍ قَصدٌ إِلى حَسَنٍ","أَخلَدَ يَرمي إِلى عُلياهُ إِخلادا",12,"د",2,0],["يُرضيكَ والِيَ تَدبيرٍ وَمُبتَغِياً","نُصحاً وَمُعجِلَ إيرادٍ وَإِصدارِ",13,"ر",1,0],["يَرضاهُمُ الناسُ أَرباباً لِسُؤدُدِهِم","فَكَيفَ أَسخَطُهُم يا بُهلُ إِخوانا",14,"ن",2,0],["يَرضى الجَوادُ إِذا كَفّاهُ وازَنَتا","إِحدى يَمينَي يَدَي نَصرِ بنِ سَيّارِ",15,"ر",1,1],["يُرضي النديمَ ويُرضَى عن مُرُوءتِه","إذا أتاه بمشروبٍ ومأكولِ",16,"ل",1,0],["يَرضى بِهِ السادَةُ مِن أَهلِ اليَمَن","مِن ساكِني نَجدٍ وَمِن أَهلِ عَدَن",17,"ن",1,0],["يَرضى بِقَسمٍ مَليكِهِ","مُتَجَمِّلاً في مَطلَبِه",18,"ب",2,0],["يَرضى بِها ذاكَ مِن هَذا وَيَطعَمُ ذا","ما كانَ هَذا بِهِ مِن كَسبِهِ جَذِلا",19,"ل",2,0],["يَرضى بِأَنَّ الجَمعَ عَنها راضِ","لا يَرقُبُ الأَسباقَ وَالمَواهِبا",20,"ب",2,0],["يَرضَخُ في البيدِ الحَصى","وَإِن رَمى إِلى الرُبى",21,"ا",1,0],["يَرضى فَيُرسِلُها لِقَومٍ نِعمَةً","وَتَكونُ مِنهُ لِآخِرينَ عِقابا",22,"ب",2,0],["يرضونَ مِلَّتَهُ فيسجدُ شاكراً","للهِ جلَّ جلالُه يَتقرَّبُ",23,"ب",1,0],["يَرضى الكَفافَ تُقىً مِنَ الدُنيا وَلا","يَرضى الكَفافَ إِذا تَلَمَّسَ مَفخَرا",24,"ر",2,0],["يَرضَونَ بِالحَمدِ مِن صَنائِعِهم","فينا وَبِالعَفوِ بَعدَما ظَفَروا",25,"ر",3,0],["يُرضيكَ في هَدمِ رِفابِ العِدى","وَفي بِناءِ الحَسَبِ الأَرفَعِ",26,"ع",1,0],["يُرضيك طول أناتهِ فاذا التوَى","فهو القديرُ الفذُّ في الإغضاب",27,"ب",1,0],["يُرضِي الفتى عَيْشُهُ ما دامَ يَغمُرُهُ","بالطيباتِ ويُغْريهِ بتحبيب",28,"ب",1,0],["يرضيه أن يتشفّى من مدامعنا","لم نبك منه ولكنّا بكيناه",29,"ا",2,0],["يرضَى بطيفٍ قال مو","عدُنا الحشيَّةُ والوِسادُ",30,"د",1,0],["يُرضيكَ إِن رَكِبَ الجِيادَ عُرامُهُ","عِزّاً وَإِن حَضَرَ النَدِيَّ وَقارُهُ",31,"ر",2,0],["يرضى ويسخط كل قطر زرته","في يوم تلقاه ويوم تبين",32,"ن",1,0],["يَرضَخُ بِالبيدِ الحَصى فَإِن رَقى","إِلى الرُبى أَورى بِها نارَ الحبى",33,"ا",1,0],["يُرضيكَ منطِقُهُ وَلَولا ضَعفُهُ","للَقيتَ مِنهُ أَحَرَّ مِن حَزِّ المدى",34,"د",2,0],["يرضى الحليم على الضرورة خائفا","طلب النجاة بحور حكم الجاهل",35,"ل",1,0],["يرضي الغنيّ عن الأيام ما ملكا","حتّى إذا هو قفا عاتب الفلكا",36,"ك",2,1],["يرضَع من غير أُمِّه لبناً","يمجُّه فوه فهو لا يَكبَرْ",37,"ر",1,0],["يرضى بقضاء الحب فيما حكما","إن جار عليه الحب أو لم يجر",38,"ر",1,0],["يُرضيهِ أَن يَأوي إِلى مَعلَفٍ","يَمنَعُهُ في اللَيلِ أَن يَشرُدا",39,"د",2,0],["يَرضى بِما اِستَودِعَتهُ مِن عَبَقٍ","بِنَشرِكَ المُستَطابِ مُمتَزَجِ",40,"ج",1,0],["يرضى من الدنيا الغرور ببلغة","لا يتسع فيها اتساع الباطر",41,"ر",1,0],["يُرضيهِ مَخبَرُهُم إِذا ما اِفتَرَّهُم","وَيُقِرُّ طرفهُ مِنهُمُ المَنظورُ",42,"ر",1,0],["يُرضِي ولّياً ويُشْجي حاسداً أبداً","بعِزّ جاهِك فهْو الجارِحُ الآسي",43,"س",2,0],["يُرضي الرعيّةَ والرّاعي بسِيرتِه","ولم يَكادا معاً أَن يُرضِيا سِيَرا",44,"ر",2,0],["يُرضي الأئمّةَ في قُرْبٍ وفي بُعُدٍ","أقام في الحيِّ أم شطّتْ بهِ الدّار",45,"ر",1,0],["يرضى بنزر العيش محقوراً وقد","دعمته كِلْمات الإله المُدعِم",46,"م",1,0],["يرضى بفقرٍ إختياريٍّ كما","يرضى الغنيْ بغنىً يزيد تكبُّرا",47,"ر",2,0],["يرضى بكسوته وقوت حياته","وتهابه الأعيان مع أُسد الشرى",47,"ر",2,0],["يرضى بأن الموت يُفني ذاته","لكنَّ أين الموت عند بقائه",48,"ا",3,0],["يرضى عن الله سبحانه بمر وحال","عليه في كل أحواله عظيم اتكال",49,"ل",1,0],["يرضون ما فهت به خاطباً","وليس يرضاه الجهور الجري",50,"ر",2,0],["يَرضُّ الحَصى مِنهُ حَوام كَأَنَّما","مَناسِر أَفواه النُسور نُسورُها",51,"ر",3,0],["يَرضي الكَتيبة وَالكِتابَة سَعيه","وَعناؤُهُ وَالنَقض وَالأَمرارُ",52,"ر",1,0],["يُرضي الكَتيبَةَ وَالكِتابَةَ وَالنَدى","بِفعالِهِ وَمَقالِهِ وَسَخائِهِ",53,"ا",3,0],["يرضى العلاء متى يرضى على أحدٍ","ويغضب الدَّهر أحياناً إذا غضبا",54,"ب",2,0],["يرضى به الله والإسلام مبتهج","منه وعاد نبيّ اللّه جذلانا",55,"ن",2,0],["يرضى العذاب بقربها","ويرى الشقا فيها نعيمه",56,"م",2,0],["يرضون أمداحا هي الذم عينه","إذا عقل الأحياء بل هي أردأ",57,"ا",1,0],["يَرضَى الفتاتَ جوائزاً","والموتَ كالعيشِ القشيبِ",58,"ب",1,0],["يرضَى بشمّ العُشب إما فاته","والسير يأكلُ منه أكلَ الممعنِ",59,"ن",1,0],["يرضَى من العلياء باسمٍ ما لَهُ","معنىً وزِعنفةُ الأديم أديمُ",60,"م",1,0],["يرضَى بما ساق إليه غَلطُ ال","حظّ ولم يسعَ له مجتهدا",61,"د",2,0],["يرضَى من الحظّ بما جاءه","عفواً وما الحظّ سوى الاجتهادْ",62,"د",1,0],["يرضيك من حديثهم شاهدُهم","وفي القديم ما سالتَ الكُتُبا",63,"ب",2,0],["يُرْضي القُلوبَ بحسنِ سيرَتهِ","وتَوَدُّهُ الألْحاظُ والمُقَلُ",64,"ل",1,0],["يرضى ويغضب فهو محيٍ قاتلٌ","في حالتيه بوصلهِ وجفائه",65,"ا",3,0],["يرضى على عَنَتِ الزمانِ وحكمِه","منه بما منحَ الهوى وتيسَّرا",66,"ر",2,0],["يَرْضَى بِمَيْسُورٍ منَ الدُّنيا وَلاَ","يَغْتَمُّ عِنْدَ نِفارِهَا عَنْ بَابِهِ",67,"ب",2,0],["يرضى النِّجادَ بديلاً من تمائمه","وأحمرَ النَّقْعِ من مُحمرّةِ الحُلَلِ",68,"ل",1,0],["يَرضى بِسُخطِي على الزّمان فإنْ","رضيتُ يوماً عن صرفه غَضِبا",69,"ب",2,0],["يَرضَى النقيضُ نقيضَهُ كنظيرهِ","فيهنَّ وَهْوَ عليهِ غيرُ مُسَلِّمِ",70,"م",1,0],["يرضون أن يجتمعوا في ناحية","إلى علي أو إلى معاوية",71,"ه",1,0],["يُرضعُ النشءَ من ثدَيَّ حليباً","فيشبُّ الفتى حُساماً حديدا",72,"د",2,0],["يرضيك إن هز القنا بشماله","وإذا انتضي سيف الفنا بيمين",73,"ن",1,0],["يَرضى بِمَعدومِ الخَيا","لِ حَقيقَةً وَيُطيعُ وَهما",74,"م",2,0],["يَرضى عَلى الأَقدارِ شارِبُها الَّذي","ما زالَ ذا سَخَطٍ عَلى الأَقدارِ",75,"ر",1,0],["يرضى وزارتكم فرضاً عليه لكم","وليس يرضى بها مرعى ومنتجعا",76,"ع",2,0],["يرضى الأباة وقد أعياهُ بأسُهُمُ","لدى المكاره والأسواء والمحن",77,"ن",1,0],["يُرْضِعُهُ من لبنِ العشارِ","ماءً إذا جرى جرى من نار",78,"ر",1,0],["يرضى لعيشَتِه القليلَ ويطعمُ ال","وُفَّادَ والسُّؤَّالَ والمحروما",79,"م",2,0],["يرضى وإلا نفحت","منه إذا كان أبا",80,"ب",2,0],["يُرضي العروبةَ ما بذلت لها","وتعود بعد الهجر تفتّر",81,"ر",1,0],["يرضاه من عاش صوفياً بلا بلا جَدَلٍ","يرضاه من باع دنياه بأخراه",82,"ا",2,0],["يُرَضْنَ بِكُلّ عَصَا رَائِض","وَيُصْبِحْنَ كُلَّ غَدَاة صِعَابَا",83,"ب",2,0],["يُرْضيكَ تكبيرُهُمْ في كلِّ داجيةٍ","وما لهمْ حياضِ المَوْتِ تَهْليلُ",84,"ل",1,0],["يَرضى بشر غَيركا","تَسخطاً بِخَيركا",85,"ك",2,0],["يَرضونَهُ وَيظهرون الطاعه","حَتَّى إِذا فادح حرب راعه",86,"ه",1,0],["يرضى بِلونَينِ من كُشكٍ ومن عَدسٍ","وإن تَشهَّى فزيتونٌ بطسُّوجِ",87,"ج",1,0],["يرضى بما أرضى فلا هو مُعرِضٌ","عنّى ولا أنا غائبٌ عن بالِهِ",88,"ل",2,0],["يَرضى بِهذا يا لقومي حرّ","أُهدى وَقَد أعطى وَسيق المهرُ",89,"ر",1,0],["يُرضى التغزُّل في حِبٍّ علانيه","تأَدُّباً لا تنافي الطبعَ لهجتُهُ",90,"ه",1,0],["يرضى الإله بما ترضى أئمتهم","وليس يغضب إلا إن هم غضبوا",91,"ب",3,0],["يرضيك يا ولدي بما تختاره","ويقين قلبي أنه أرضاكا",92,"ك",2,0],["يرضى ويغضب دائماً من غير ما","سبب فوا تعبي وطول تحسري",93,"ر",2,0],["يُرضيكَ عَفواً فَإِن رَفَّعتَ هزَّته","رفَّعتَ مِن رِبَذِ التَبغيلِ هِملاجِ",94,"ج",1,0],["يرضيه عن زلة الجاني توقفه","وفي إجابة مضطر تسرعه",95,"ع",2,0],["يرضيه تسهيدي ونوم جفونه","عني وأرضى أن ينام وأسهرا",96,"ر",2,0],["يرضى الإله هديه","وقوله وفعله",97,"ل",2,0],["يرضى به غيرُ عبد","لسرِّه يصطفيه",98,"ي",2,0],["يرضى بنصح العاذلين وما درى","أن العذول على المتيم مفسد",99,"د",1,0],["يَرضى فَيُرضيهما عن كلِّ مُجتَرِمٍ","ويَغضبَانِ على ذي النُّصحِ إن غَضِبا",100,"ب",2,0],["يَرضعُ الإنسانُ في أحضَانِها ثَدْياً حَنِيّا","وَيُلاقِي عِندَها المَهدَ الذي يُؤْوي الضَّنِيّا",101,"ي",2,0],["يرضى بقدرين من كشك ومن عدس","وان تشهى فزيتون بطسوج",102