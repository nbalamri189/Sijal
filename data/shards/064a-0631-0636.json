{"poems":[[55,"لله ثم لك المحل الأعظم","https://www.aldiwan.net/poem29795.html","الكامل"],[79,"كأنما الغيث ملك","https://www.aldiwan.net/poem35840.html","المجتث"],[79,"إن بان منزله وشطت داره","https://www.aldiwan.net/poem36406.html","الكامل"],[88,"لعب البلى بملاعب الألباب","https://www.aldiwan.net/poem10375.html","الكامل"],[4,"كبيشة حلت بعد عهدك عاقلا","https://www.aldiwan.net/poem21183.html","الطويل"],[23,"إن الذوائب من فهر وإخوتهم","https://www.aldiwan.net/poem21254.html","البسيط"],[53,"من ذا رأت عيناه مثلي في الشجا","https://www.aldiwan.net/poem9239.html","الرجز"],[53,"يا رب عبد مالك سيدا","https://www.aldiwan.net/poem61854.html","الكامل"],[93,"لم يبق ما يسليك غير الكاس","https://www.aldiwan.net/poem8973.html","عموديه"],[91,"ماذا برقراق السحائب","https://www.aldiwan.net/poem44965.html","مجزوء الكامل"],[64,"يا أيها المولى الذي اصطنع الورى","https://www.aldiwan.net/poem52507.html","مجزوء الكامل"],[47,"ما للكبير في الغواني من أرب","https://www.aldiwan.net/poem10669.html","الرجز"],[47,"أعاد شكوى من الطيف الذي اعتادا","https://www.aldiwan.net/poem63468.html","البسيط"],[47,"إذا الغمام حداه البارق الساري","https://www.aldiwan.net/poem63559.html","البسيط"],[47,"أعن جوار أبي إسحاق تطمع أن","https://www.aldiwan.net/poem66813.html","البسيط"],[30,"يرضى الجواد إذا كفاه وازنتا","https://www.aldiwan.net/poem5207.html","البسيط"],[63,"إذا المجرة مالت بعد تعديل","https://www.aldiwan.net/poem51485.html","البسيط"],[60,"أنا الغلام القرشي المؤتمن","https://www.aldiwan.net/poem30824.html","الرجز"],[51,"اصبر على نوب الزمان","https://www.aldiwan.net/poem10388.html","مجزوء الكامل"],[51,"اهرب بنفسك من دنيا مضللة","https://www.aldiwan.net/poem63073.html","البسيط"],[68,"أما ترى الأنواء والسحائبا","https://www.aldiwan.net/poem40945.html","الرجز"],[68,"برق المشيب قد أضا","https://www.aldiwan.net/poem40981.html","مجزوء الرجز"],[107,"أأفاق ظالم نفسه فأنابا","https://www.aldiwan.net/poem43091.html","الكامل"],[107,"هو وفدهم وهم الفريق الطيب","https://www.aldiwan.net/poem44002.html","الكامل"],[83,"أهدى التلاقي صبح وجهك مسفرا","https://www.aldiwan.net/poem61522.html","الكامل"],[52,"يا قلب ما لي أراك لا تقر","https://www.aldiwan.net/poem63821.html","المنسرح"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/13672","السريع"],[92,"إلى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179104",""],[92,"قتل العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179140",""],[96,"اللهب القدسي","https://www.poetsgate.com/ViewPoem.aspx?id=15627",""],[146,"مرض بقلبك ما يعاد","https://www.aldiwan.net/poem58409.html","مجزوء الكامل"],[147,"طاول بقدرك من علا مقداره","https://www.aldiwan.net/poem11767.html","الكامل"],[164,"انهض فطائر سعدك الميمون","https://www.aldiwan.net/poem59011.html","الكامل"],[168,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[173,"العز ما خضعت لهيبته العدى","https://www.aldiwan.net/poem1618.html",""],[190,"لله ما أنا فيه أين تصرفي","https://www.aldiwan.net/poem43477.html","الكامل"],[190,"يرضي الغني عن الأيام ما ملكا","https://www.aldiwan.net/poem43518.html","البسيط"],[208,"تطوى المنى عن طلاب غايته","https://www.aldiwan.net/poem53265.html","المنسرح"],[235,"قد لجج في بحر الهوى واقتحما","https://www.aldiwan.net/poem44548.html","الدوبيت"],[239,"قل لجمال الدين يا أكرم ال","https://www.aldiwan.net/poem32037.html","السريع"],[239,"قل لابن نصر ياذا العطاء ويا","https://www.aldiwan.net/poem32125.html","المنسرح"],[308,"شغف المحب بحب ظبية عامر","https://www.aldiwan.net/poem16891.html","الكامل"],[309,"رسل البشائر ورد وصدور","https://www.aldiwan.net/poem56545.html","الخفيف"],[368,"قضى على جد شانيكم بإتعاس","https://www.aldiwan.net/poem60867.html","البسيط"],[368,"إلى خيال خيال في الظلام سرى","https://www.aldiwan.net/poem60879.html","البسيط"],[368,"نشدتك الله هل تدرين يا دار","https://www.aldiwan.net/poem60908.html","البسيط"],[381,"سعدت نفوس بالإله الأعظم","https://www.aldiwan.net/poem59265.html","الكامل"],[381,"إن الذي ترك الثراء الأفخرا","https://www.aldiwan.net/poem59428.html","الكامل"],[381,"طوبى لمن قد تاب بعد خطائهِ","https://www.aldiwan.net/poem66970.html","الكامل"],[395,"الحمدلله حمدا موافيا بالنوال","https://www.aldiwan.net/poem54549.html","عموديه"],[407,"إن كان من يبغضنا كارها","https://www.aldiwan.net/poem33906.html","السريع"],[410,"خليلي هل من رقدة أستعيرها","https://www.aldiwan.net/poem50173.html","الطويل"],[410,"الليل حيث حللن فيه نهار","https://www.aldiwan.net/poem50176.html","الكامل"],[410,"قولا له هل دار في حوبائه","https://www.aldiwan.net/poem50212.html","الكامل"],[420,"ما غاب بدر دجى منكم ولا غربا","https://www.aldiwan.net/poem53990.html","البسيط"],[441,"إن كان أضمر قلبي عنك سلوانا","https://www.aldiwan.net/poem2597.html","البسيط"],[447,"قف بالديار وحيها","https://www.aldiwan.net/poem56021.html","عموديه"],[456,"لماذا أعزي بل لماذا أهنىء","https://www.aldiwan.net/poem61308.html","الطويل"],[456,"أين ابتسامك يا حبيبي","https://www.aldiwan.net/poem61716.html","مجزوء الكامل"],[461,"قالوا عساك مرجم فتبين","https://www.aldiwan.net/poem55859.html","الكامل"],[461,"لمن الطلول كأنهن رقوم","https://www.aldiwan.net/poem55864.html","الكامل"],[461,"صدت بنعمان على طول الصدى","https://www.aldiwan.net/poem56213.html","الرجز"],[461,"خاطر بها إما ردى أو مراد","https://www.aldiwan.net/poem56227.html","الرجز"],[461,"من ناظر لي بين سلعٍ وقبا","https://www.aldiwan.net/poem56276.html","الرجز"],[464,"ينثي برأفته ونجدته","https://www.aldiwan.net/poem16422.html","أحذ الكامل"],[467,"أهلاً بطيف زار بعد جفائه","https://www.aldiwan.net/poem3611.html","عموديه"],[480,"ألم الفراق نفى الرقاد ونفرا","https://www.aldiwan.net/poem15259.html","الكامل"],[532,"هذا العقيق فقف على أبوابه","https://www.aldiwan.net/poem37529.html","الكامل"],[554,"لا تقطعن رجاء العيش بالعلل","https://www.aldiwan.net/poem47259.html","البسيط"],[554,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[565,"نحن النصارى آل عيسى المنتمي","https://www.aldiwan.net/poem52748.html","الكامل"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[723,"","https://poetry.dctabudhabi.ae/diwan/poem/97796","الرجز"],[874,"","https://poetry.dctabudhabi.ae/diwan/poem/17699","الكامل"]],"verses":[["يُرضيكَ ظاهِرُهُ وَبَينَ ضُلوعِهِ","قَلبٌ بِما يُدني إِلَيكَ مُتَيَّمُ",0,"م",1,0],["يُرْضي النّديمَ فمَهْما","سَقَى الرِّياضَ كَساهُ",1,"ه",1,0],["يَرْضى الرّضيُّ بِها إذا ما أُنْشِدَتْ","يوْماً ويعْرِفُ فضْلَها مِهْيارُهُ",2,"ر",2,0],["يُرضي المُرَتِّلَ في الكَنيسَةِ صُنعُهُ","كَيساً وَيُرضي ساكِنَ المِحرابِ",3,"ب",1,0],["يَرُضنَ صِعابَ الدُرِّ في كُلِّ حِجَّةٍ","وَلَو لَم تَكُن أَعناقُهُنَّ عَواطِلا",4,"ل",2,0],["يَرضى بِها كُلُّ مَن كانَت سَريرَتُهُ","تَقوى الإِلَهِ وَبِالأَمرِ الَّذي شَرَعوا",5,"ع",3,0],["يُرْضِي وإن لهوجْتَهُ تَلهوَجا","فلا يَعُدْ كَرْمُ كريم عَوْسَجَا",6,"ج",2,0],["يُرضيك من مَرأىً ومن مَخْبَرٍ","يا لك من قَبْلٍ ومن بعْدِ",7,"د",1,0],["يَرضى لِمَوطِنِهِ يَصيرُ مُواطِناً","وَتَصيرُ أُمَّتُهُ إِلى أَجناسِ",8,"س",1,0],["يرضى به من كان ذا","نظرٍ بعين العقل ثاقب",9,"ب",1,0],["يُرضيهمُ بعدَ الصدى وِرْدُ الصَّرَى","رِفْهَاً وغِبَّا",10,"ب",2,0],["يَرضى فَيَرمي بِاللُهى سَماحَةً","وَيَغضَبُ المَوتُ إِذا الفَتحُ غَضِب",11,"ب",1,0],["يُرضيكَ مِن حَسَنٍ قَصدٌ إِلى حَسَنٍ","أَخلَدَ يَرمي إِلى عُلياهُ إِخلادا",12,"د",2,0],["يُرضيكَ والِيَ تَدبيرٍ وَمُبتَغِياً","نُصحاً وَمُعجِلَ إيرادٍ وَإِصدارِ",13,"ر",1,0],["يَرضاهُمُ الناسُ أَرباباً لِسُؤدُدِهِم","فَكَيفَ أَسخَطُهُم يا بُهلُ إِخوانا",14,"ن",2,0],["يَرضى الجَوادُ إِذا كَفّاهُ وازَنَتا","إِحدى يَمينَي يَدَي نَصرِ بنِ سَيّارِ",15,"ر",1,1],["يُرضي النديمَ ويُرضَى عن مُرُوءتِه","إذا أتاه بمشروبٍ ومأكولِ",16,"ل",1,0],["يَرضى بِهِ السادَةُ مِن أَهلِ اليَمَن","مِن ساكِني نَجدٍ وَمِن أَهلِ عَدَن",17,"ن",1,0],["يَرضى بِقَسمٍ مَليكِهِ","مُتَجَمِّلاً في مَطلَبِه",18,"ب",2,0],["يَرضى بِها ذاكَ مِن هَذا وَيَطعَمُ ذا","ما كانَ هَذا بِهِ مِن كَسبِهِ جَذِلا",19,"ل",2,0],["يَرضى بِأَنَّ الجَمعَ عَنها راضِ","لا يَرقُبُ الأَسباقَ وَالمَواهِبا",20,"ب",2,0],["يَرضَخُ في البيدِ الحَصى","وَإِن رَمى إِلى الرُبى",21,"ا",1,0],["يَرضى فَيُرسِلُها لِقَومٍ نِعمَةً","وَتَكونُ مِنهُ لِآخِرينَ عِقابا",22,"ب",2,0],["يرضونَ مِلَّتَهُ فيسجدُ شاكراً","للهِ جلَّ جلالُه يَتقرَّبُ",23,"ب",1,0],["يَرضى الكَفافَ تُقىً مِنَ الدُنيا وَلا","يَرضى الكَفافَ إِذا تَلَمَّسَ مَفخَرا",24,"ر",2,0],["يَرضَونَ بِالحَمدِ مِن صَنائِعِهم","فينا وَبِالعَفوِ بَعدَما ظَفَروا",25,"ر",3,0],["يُرضيكَ في هَدمِ رِفابِ العِدى","وَفي بِناءِ الحَسَبِ الأَرفَعِ",26,"ع",1,0],["يُرضيك طول أناتهِ فاذا التوَى","فهو القديرُ الفذُّ في الإغضاب",27,"ب",1,0],["يُرضِي الفتى عَيْشُهُ ما دامَ يَغمُرُهُ","بالطيباتِ ويُغْريهِ بتحبيب",28,"ب",1,0],["يرضيه أن يتشفّى من مدامعنا","لم نبك منه ولكنّا بكيناه",29,"ا",2,0],["يرضَى بطيفٍ قال مو","عدُنا الحشيَّةُ والوِسادُ",30,"د",1,0],["يُرضيكَ إِن رَكِبَ الجِيادَ عُرامُهُ","عِزّاً وَإِن حَضَرَ النَدِيَّ وَقارُهُ",31,"ر",2,0],["يرضى ويسخط كل قطر زرته","في يوم تلقاه ويوم تبين",32,"ن",1,0],["يَرضَخُ بِالبيدِ الحَصى فَإِن رَقى","إِلى الرُبى أَورى بِها نارَ الحبى",33,"ا",1,0],["يُرضيكَ منطِقُهُ وَلَولا ضَعفُهُ","للَقيتَ مِنهُ أَحَرَّ مِن حَزِّ المدى",34,"د",2,0],["يرضى الحليم على الضرورة خائفا","طلب النجاة بحور حكم الجاهل",35,"ل",1,0],["يرضي الغنيّ عن الأيام ما ملكا","حتّى إذا هو قفا عاتب الفلكا",36,"ك",2,1],["يرضَع من غير أُمِّه لبناً","يمجُّه فوه فهو لا يَكبَرْ",37,"ر",1,0],["يرضى بقضاء الحب فيما حكما","إن جار عليه الحب أو لم يجر",38,"ر",1,0],["يُرضيهِ أَن يَأوي إِلى مَعلَفٍ","يَمنَعُهُ في اللَيلِ أَن يَشرُدا",39,"د",2,0],["يَرضى بِما اِستَودِعَتهُ مِن عَبَقٍ","بِنَشرِكَ المُستَطابِ مُمتَزَجِ",40,"ج",1,0],["يرضى من الدنيا الغرور ببلغة","لا يتسع فيها اتساع الباطر",41,"ر",1,0],["يُرضيهِ مَخبَرُهُم إِذا ما اِفتَرَّهُم","وَيُقِرُّ طرفهُ مِنهُمُ المَنظورُ",42,"ر",1,0],["يُرضِي ولّياً ويُشْجي حاسداً أبداً","بعِزّ جاهِك فهْو الجارِحُ الآسي",43,"س",2,0],["يُرضي الرعيّةَ والرّاعي بسِيرتِه","ولم يَكادا معاً أَن يُرضِيا سِيَرا",44,"ر",2,0],["يُرضي الأئمّةَ في قُرْبٍ وفي بُعُدٍ","أقام في الحيِّ أم شطّتْ بهِ الدّار",45,"ر",1,0],["يرضى بنزر العيش محقوراً وقد","دعمته كِلْمات الإله المُدعِم",46,"م",1,0],["يرضى بفقرٍ إختياريٍّ كما","يرضى الغنيْ بغنىً يزيد تكبُّرا",47,"ر",2,0],["يرضى بكسوته وقوت حياته","وتهابه الأعيان مع أُسد الشرى",47,"ر",2,0],["يرضى بأن الموت يُفني ذاته","لكنَّ أين الموت عند بقائه",48,"ا",3,0],["يرضى عن الله سبحانه بمر وحال","عليه في كل أحواله عظيم اتكال",49,"ل",1,0],["يرضون ما فهت به خاطباً","وليس يرضاه الجهور الجري",50,"ر",2,0],["يَرضُّ الحَصى مِنهُ حَوام كَأَنَّما","مَناسِر أَفواه النُسور نُسورُها",51,"ر",3,0],["يَرضي الكَتيبة وَالكِتابَة سَعيه","وَعناؤُهُ وَالنَقض وَالأَمرارُ",52,"ر",1,0],["يُرضي الكَتيبَةَ وَالكِتابَةَ وَالنَدى","بِفعالِهِ وَمَقالِهِ وَسَخائِهِ",53,"ا",3,0],["يرضى العلاء متى يرضى على أحدٍ","ويغضب الدَّهر أحياناً إذا غضبا",54,"ب",2,0],["يرضى به الله والإسلام مبتهج","منه وعاد نبيّ اللّه جذلانا",55,"ن",2,0],["يرضى العذاب بقربها","ويرى الشقا فيها نعيمه",56,"م",2,0],["يرضون أمداحا هي الذم عينه","إذا عقل الأحياء بل هي أردأ",57,"ا",1,0],["يَرضَى الفتاتَ جوائزاً","والموتَ كالعيشِ القشيبِ",58,"ب",1,0],["يرضَى بشمّ العُشب إما فاته","والسير يأكلُ منه أكلَ الممعنِ",59,"ن",1,0],["يرضَى من العلياء باسمٍ ما لَهُ","معنىً وزِعنفةُ الأديم أديمُ",60,"م",1,0],["يرضَى بما ساق إليه غَلطُ ال","حظّ ولم يسعَ له مجتهدا",61,"د",2,0],["يرضَى من الحظّ بما جاءه","عفواً وما الحظّ سوى الاجتهادْ",62,"د",1,0],["يرضيك من حديثهم شاهدُهم","وفي القديم ما سالتَ الكُتُبا",63,"ب",2,0],["يُرْضي القُلوبَ بحسنِ سيرَتهِ","وتَوَدُّهُ الألْحاظُ والمُقَلُ",64,"ل",1,0],["يرضى ويغضب فهو محيٍ قاتلٌ","في حالتيه بوصلهِ وجفائه",65,"ا",3,0],["يرضى على عَنَتِ الزمانِ وحكمِه","منه بما منحَ الهوى وتيسَّرا",66,"ر",2,0],["يَرْضَى بِمَيْسُورٍ منَ الدُّنيا وَلاَ","يَغْتَمُّ عِنْدَ نِفارِهَا عَنْ بَابِهِ",67,"ب",2,0],["يرضى النِّجادَ بديلاً من تمائمه","وأحمرَ النَّقْعِ من مُحمرّةِ الحُلَلِ",68,"ل",1,0],["يَرضى بِسُخطِي على الزّمان فإنْ","رضيتُ يوماً عن صرفه غَضِبا",69,"ب",2,0],["يَرضَى النقيضُ نقيضَهُ كنظيرهِ","فيهنَّ وَهْوَ عليهِ غيرُ مُسَلِّمِ",70,"م",1,0],["يرضون أن يجتمعوا في ناحية","إلى علي أو إلى معاوية",71,"ه",1,0],["يَرضى بِهذا يا لقومي حرّ","أُهدى وَقَد أعطى وَسيق المهرُ",72,"ر",1,0],["يَرضى بِصُحبَتِها إِذا بَرَزَت لَهُ","وَأَشَذَّ عَنها أَلفَ كُلِّ حِمارِ",73,"ر",1,0]]}