,"هل أتاكم حديث الخيول ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63746&r=&rc=12",""],[6198,"المهاجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79235&r=&rc=9",""],[5075,"ماذا جنى الأحرار ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82761&r=&rc=7",""],[6213,"أنت في قلبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85490&r=&rc=93",""],[406,"حوار في ساحة المطاف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=847&r=&rc=38",""],[6262,"مُكابرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80103&r=&rc=1",""],[6268,"بعثريني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82933&r=&rc=19",""],[6268,"عَدُّودَةُ الخُروج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82921&r=&rc=7",""],[6285,"هذه الشام لا تقولي كفانا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86807&r=&rc=0",""],[6318,"مهرجان القصيد (1)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66156&r=&rc=6",""],[6318,"درّة الأقصى مُحمَّد الدرّة وأبوه جمال الدرّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66165&r=&rc=15",""],[6318,"مواكب بدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66158&r=&rc=8",""],[5396,"الميلاد ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65508&r=&rc=7",""]],"verses":[["ها هُنا قَبرُ شَهيدٍ في هَوى","أُمَّةٍ أَيقَظَها ثُمَّ رَقَد",0,"د",1,0],["هاهُنا مَصرَعُ الصِناعَةِ وَالتَص","ويرِ وَالحِذقِ وَالحِجا وَالأَغاني",1,"ن",2,0],["ها هو مبدٍ لك مكنونَهُ","فقد أضاقت حاله ذرعه",2,"ع",2,0],["ها هي الشمس بدت بازغة","يا له من مشهد قد فتنا",3,"ن",2,0],["ها هو الموج زاحف","مثل طود قد اشمخر",4,"ر",1,0],["هاهُنا حَلَّ بِهِ الرَكبُ وَسار","وَهُنا ثاوٍ إِلى البَعثِ الأَسير",5,"ر",1,0],["ها هُنا كُنتَ تَرى حُوَّ الدُمى","فاتِناتٍ بِالشِفاهِ اللُعُسِ",5,"س",1,0],["ها هُوَ الشَيبُ لائِماً فَأَفيقي","وَإِترُكيهِ إِن كانَ غَيرَ مُفيقِ",6,"ق",1,1],["ها هو الحق الذي لم","يُبقِ شكَّا أو كلامَا",7,"م",2,0],["ها هنا حفلٌ وذكرى ووفاء","لبّنا أنت ملبِّي الأصدقاء",8,"ا",2,1],["هاهنا ماءُ لسانٍ","وهنا الوردُ المربَّى",9,"ب",2,0],["هَا هُنا الأعلامُ كانت تُنْصَبُ","هَا هُنا بالأمسِ كان الملعبُ",10,"ب",1,1],["ها هُنا ها هنا يَطيبُ المقام","هذه يَثرِبٌ وهذا الإمامُ",11,"م",1,0],["هَا هُنا العدلُ والسَّماحةُ والإح","سانُ أعظِمْ بذا المقامِ مَقاما",12,"م",2,0],["ها هُنا ما تُريدُ قَد ظَهَرَ الأَم","رُ الَّذي كانَ قَبلُ في الديماسِ",13,"س",1,0],["ها هم العشاقُ قد هبُّوا إلى الوادي خفافا","أقبلوا كالضوءِ أطيافاً وأحلاماً لطافا",14,"ف",2,0],["ها هنا حيث ألاقيك","طباعا وسجايا",15,"ي",2,0],["هاهنا الشعرُ هاهنا، والتَّصابي","إنما الشعر والهوى تَوأَمَان",16,"ن",1,0],["ها هم خصومُك حول ش","طَّ «المنش» إن رمت الخصام",17,"م",1,0],["هاهنا الفنُّ قام يَرْوي حديث الْ","مَجْدِ عنا، والفنُّ خيرُ الرواة",18,"ه",1,0],["هاهنا معبدُ الفنون لمن را","مَ صلاةً، فكَبِّروا للصَّلاة",18,"ه",1,0],["هاهنا مجدٌ ضائعٌ. لا تقولوا:","إنَّ ما ضاع ليس بالمردود",19,"د",1,0],["ها هُنَا المُنْتَهَى ويَعْدُو إليهِ","عِندَمَا تُصبحُ النِّهَايَاتُ بَدْءَا",20,"ا",2,0],["ها هنا يا شهرزاد انطفأت","نار جدبي وابتدت نار خصيبه",21,"ب",2,0],["ها هنا الجدران ، تدمي وتفكر","وعلى أرؤوسها تمشي ، وتنظر",22,"ر",1,1],["ها هنا نجلس ، يا (عمرو) ترى","ما اقتنى التأريخ منا واطّرح ؟",23,"ح",1,0],["هاهنا الحزن على عاداته","فلماذا اليوم للحزن غرابة",24,"ب",2,0],["ها هنا قصف هنا يهمي دم","ربما سمّوه توريد اللطافه",25,"ف",2,0],["ها هنا ألقي حطامي ..؟ حسنا","ربما تلفت عمال النظافه",25,"ف",2,0],["ها هنا في المنزل العاري الجديب","أحتسي الدمع وأقتات النحيب",26,"ب",1,1],["ها هنا أشكو إلى اللّيل وكم","أشتكي واللّيل في الصمت الرهيب",26,"ب",1,0],["ها هنا يا ليل وحدي والجوي","بين أضلاعي لهيب في لهيب",26,"ب",1,0],["ها هنا كان يناجينا الغرام","ويناجي المستهام المستهام",27,"م",1,1],["ها هنا رفّ بقلبينا الصبا","وتبنّانا التصافي والوئام",27,"م",1,0],["ها هنا غنّى الهوى الطفل لنا","وطواه ها هنا عنّا الفطام",27,"م",1,0],["ها هنا لاح الحبّ وغابا","وتشظّى في يد الأمس وذابا",28,"ب",2,1],["هاهنا مسراك يلغي وحشتي","وصدى نجواك، يَغلي في اعتقادي",29,"د",2,0],["ها هنا بعض النّجوم انطفأت","كي تزيد الأنجم الأخرى اشتعال",30,"ل",1,0],["ها هي الشام بعد فرقة دهر","أنهر سبعة ..وحور عين",31,"ن",1,0],["ها هنا الحزن على عادته","فلماذا اليوم للحزن غرابه ؟",32,"ب",2,0],["هَا هذِهِ رُوحي إِلَيْكِ هَدِيَّةً","فتجمَّلي في أَخذها أَوْ فاعْذِري",33,"ر",2,0],["ها هُم تَداعوا كما أبنت لنا","وَنحنُ مَع كثرةٍ بنا ضعفا",34,"ف",2,0],["ها هو الشاطىء فاسمع","أيها القلبُ هديره",35,"ه",1,0],["ها هنا عاهدت هندا","بعدما حرّرت نفسي",35,"ي",1,0],["ها هنا بالحبّ والنشوة","قد غيّبت نحسي",35,"ي",1,0],["ها هي الشمس يا حبيبي أطلت","قم نغني وننعش الأرواحا",36,"ح",2,0],["ها هيَ الحربُ أشعلوها فرُحما","كَ إلهي بالأمّةِ العربيّه",37,"ي",2,0],["ها هو الصبحُ قد تبدّى تُحَلّي","ثَغرهُ الحلوَ بسمةٌ ورديّه",37,"ي",2,0],["ها هو الحبل فصله مثلما","كان واستغفر وحيي برضاء",38,"ا",2,0],["هاهم جنودك فوق الخيل قد وثبوا","والسهم في القوس مشدودٌ ليرميه",39,"ي",2,0],["ها هنا الجدول يشدو طرباً","وهناك الطير في الأغصان غنى",40,"ن",2,0],["ها هُوَ الدَمعُ في المَحاجِرِ سائِلِ","وَإِلى الصَبرُ لَم تعُد مِن وَسائِلِ",41,"ل",1,1],["ها هنا ها هنا حياة المعاني","طهرت من حقارة الإنسان",42,"ن",1,0],["ها هنا المعبد الإلهي مذ كا","ن وكُنّا في عالم الأسرار",42,"ر",1,0],["ها هنا قصةٌ يمثّلها البؤ","س على مسرح الهوى والرحيق",43,"ق",1,0],["ها هو القلب الذي طهّرته","من هوى الدنيا وآثام الشباب",44,"ب",1,0],["ها هنا ظامىء يحن إلى كأ","س يفدى حبابها بالحياة",45,"ه",1,0],["ها هو المال في يديك فنادمه","سرابا يعج بالترهات",46,"ت",1,0],["ها هو الفجر فاستفق يا أخا","الفجر ودعني أعشق مع الظلمات",46,"ت",1,0],["ها هي الكاس فصور","من رؤاك الندماء",47,"ا",2,0],["ها هي الأرض يا حبيبيَ عافت","ريها من مجازر الآدمي",48,"ي",1,0],["ها هي الأرض يا حبيبي ذئاب","وذئابٌ من فاجر أو تقي",48,"ي",1,0],["ها هي اليوم تملأ الكون نوراً","فجرّ اللَه في السماء عيونه",49,"ن",2,0],["ها هيكلُ اِسرائيل أشرفُ منزلٍ","في الأرض لكن كل يومٍ ينقُصُ",50,"ص",1,1],["ها هنا الفجرُ، ما يزال يُريني","كيف ينجو من الخِضَمِّ سَفيني",51,"ن",2,0],["ها هنا الفجرُ مشرقاً فاطمئنِّي","يا قلوباً، ويا عيونُ استبيني",51,"ن",2,0],["ها هنا الفجر، فاقرؤوه كتاباً","سُطِّرتْ فيه ذكرياتُ الحنينِ",51,"ن",1,0],["ها هنا الفجر، فاركضي يا قوافي","في ميادين لهفتي واتبعيني",51,"ن",2,0],["ها هو الشحاذ لصق البن","ك تستجدي لحونه",52,"ه",1,1],["ها هو الوقتُ في الحَقيقَةِ وَقْتي","يا بَني العصرِ والزَّمانُ زَمَانِي",53,"ن",2,0],["هاهما كُلُّ فرقةٍ نابَ عنها","واحدٌ منهمُ حليفُ اعتبارِ",54,"ر",1,1],["ها هُوَ اليومَ زَائِري","وكفانِي هَذا وَقَد",55,"د",1,0],["ها هنا غابة بها أسدُ حربٍ","مشرعاتٌ رماحهم للطعان",56,"ن",1,0],["ها هو الحق ملء قلبي وجسمي","وعظامي وكل ما هو دونُ",57,"ن",1,0],["هَا هُوَ مُصْغٍ إِلَيْكَ سَمْعَاً","لَهُ إِلَى أَمْرَكَ اسْتِمَاعُ",58,"ع",1,0],["ها هو ذا المنتمي الصدوق وإن","جَوَّزَ في أمرنا الذي جوَّز",59,"ز",1,0],["ها هو اليوم حاسر الموج إِلا","من دموع تسيل في الوديانِ",60,"ن",1,0],["ها هُمْ رؤوسٌ هَيِّنٌ","قِطافها يَوانِعُ",61,"ع",1,0],["هاهي الدار في حداد وصمت","وهي في ما مضى لها ضوضاء",62,"ا",2,0],["هَا هُمْ بَنُوكَ وَمَنْ عَلَّمْتَهُمْ حلفوا","شَعُبُ الْمَكَارِمِ بِالأَرْوَاحِ نَفْذِيْهِ",63,"ي",2,0],["ها هنا شيخ التقى قد دفنا","اذ قضى نحبا فابكى الامتين",64,"ن",1,0],["هاهم قد تفيَّأوا ظلّ من كا","نَ على العالمين لله ظلاّ",65,"ل",2,0],["ها هي الأرض أخرجتكم لتجزى","كلُّ نفس ما قدَّم الأصغرانِ",66,"ن",1,0],["ها هُمُ الأتقياءُ حَلُّوا كراماً","بين فَيضٍ من الرضى والأماني",66,"ن",2,0],["ها هو القبرُ مستقرك حتى","صحوة الناس للمصير الثاني",66,"ن",2,0],["ها هو النشوان مني قد دنا","فانتصر يا فنُّ واحكُم بيننا",67,"ن",2,0],["ها هو المجد يُنادي","وهو يبكي بالدموع",68,"ع",1,0],["ها هي الأرضُ وُفَّيت ما استحقت","وتُوَفَّى بمثل هذا السماء",69,"ا",2,0],["ها هو النورُ يا شُمُوسُ تجلىذ","فانظروا كيف تسطَعُ الأضواء",69,"ا",2,0],["ها هو العقل رائدٌ فذرُوه","يتخيَّر لحظِّكم ما يشاء",69,"ا",2,0],["هاهم نازلون بالذكر فيه","حين غابوا به مغيب الشهاب",70,"ب",1,0],["هَا هيَ اليومَ الإماراتُ اكتَسَتْ ثَوباً بَهيّا","وَ حَبَاهَا اللَّهُ فِي الآنَامِ حُسناً أَبدِيّا",71,"ي",2,1],["هاهى بالهادي الامين طوحت","وفي علي نزلت وفاطم",72,"م",1,0],["هاهي اضحت عليك عاكفة","عليك دون الورى معولها",73,"ل",3,0],["هاهي طوعا لديك قد برزت","ليوثها تَرتَمي واشبلها",73,"ل",3,0],["ها هم رجالك أيها المولى ولا","من عليك ونعم من تختار",74,"ر",1,0],["ها هو القمري في