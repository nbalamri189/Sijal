m44308.html","الخفيف"],[288,"ولقد قلت حين أقفر بيتي","https://www.aldiwan.net/poem44312.html","الخفيف"],[326,"آذن اليوم جيرتي بارتحال","https://www.aldiwan.net/poem56350.html","الخفيف"],[341,"ولقد قطعت الخرق تحمل نمرقي","https://www.aldiwan.net/poem45330.html","الكامل"],[375,"ما عليها سهرت أم بت نائم","https://www.aldiwan.net/poem57165.html","الخفيف"],[410,"أوقد البين في الخميس خميسا","https://www.aldiwan.net/poem50154.html","الخفيف"],[420,"انظر إلى الأشراف كيف تسود","https://www.aldiwan.net/poem54146.html","البسيط"],[420,"هاج القرام وهيجا بلبالي","https://www.aldiwan.net/poem54163.html","الكامل"],[420,"يا إمام الهدى ويا صفوة الله","https://www.aldiwan.net/poem54171.html","الخفيف"],[436,"هل لركب العراق بعد نجوده","https://www.aldiwan.net/poem12470.html","الخفيف"],[436,"لو شاء بل بها ذيول الحندس","https://www.aldiwan.net/poem12516.html","الكامل"],[436,"زادكَ الله جلالا","https://www.aldiwan.net/poem12536.html","مجزوء الرمل"],[436,"أسف موثق ودمع طليق","https://www.aldiwan.net/poem12681.html","الخفيف"],[443,"قل للربيع اسحب ملاء سحائب","https://www.aldiwan.net/poem34876.html","الكامل"],[445,"عجبا لراج فوز ناج سابق","https://www.aldiwan.net/poem14317.html","الكامل"],[445,"هذا المحصب يا قلوصي من منى","https://www.aldiwan.net/poem14320.html","الكامل"],[464,"جرد سيوفك للجلاد وأشهر","https://www.aldiwan.net/poem15128.html","الكامل"],[473,"ولقد قلت يوم مكة سرا","https://www.aldiwan.net/poem4836.html","الخفيف"],[498,"وأبى الدهر لقد جذذ","https://www.aldiwan.net/poem10234.html","مجزوء الرمل"],[503,"آه من نار فؤآده لم يزل","https://www.aldiwan.net/poem37673.html","الرمل"],[503,"خذوا بيد العبد الضعيف تكرما","https://www.aldiwan.net/poem38071.html","الرمل"],[530,"يا قاضيا ما مثله من قاض","https://www.aldiwan.net/poem46005.html","الكامل"],[554,"خلها إنها تريد الغميما","https://www.aldiwan.net/poem47231.html","الطويل"],[554,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[554,"ليس للقلب في السلو نصيب","https://www.aldiwan.net/poem48092.html","الخفيف"],[554,"من لداع لا يجاب","https://www.aldiwan.net/poem48097.html","مجزوء الرمل"],[561,"حق بدا في صورة الموهوم","https://www.aldiwan.net/poem34185.html","الكامل"],[565,"شاب شعري نظير ما شاب شعري","https://www.aldiwan.net/poem52740.html","الخفيف"],[565,"طفح الأنس فوق ساحات جلق","https://www.aldiwan.net/poem52784.html","الخفيف"],[570,"يا علي بن سليمان ويا","https://www.aldiwan.net/poem69790.html","الرمل"],[576,"قف بربع الأسى وقوف الطليح","https://www.aldiwan.net/poem3652.html","الخفيف"],[578,"ليس لي منه سوى لا","https://www.aldiwan.net/poem3032.html","مجزوء الرمل"],[578,"يا قلب ويحك إن ظبيك قد سنح","https://www.aldiwan.net/poem3091.html","الكامل"],[712,"","https://poetry.dctabudhabi.ae/diwan/poem/72987","الكامل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/22574","الكامل"],[1163,"","https://poetry.dctabudhabi.ae/diwan/poem/28927","الكامل"]],"verses":[["وَلَقَد قُلتُ وَالهُمومُ رُكودُ","وَدُموعي عَلى الرِداءِ تَجودُ",0,"د",1,1],["وَلَقَد قُذِفتَ إِلى الجَحي","مِ وَبِئسَ عُقبى المُنكَرِ",1,"ر",1,0],["وَلَقَد قَطَعتُ الأَرضَ طوراً سالِكاً","نَجداً وَآوِنَةً أَجدُّ مُغَوَّرا",2,"ر",2,0],["وَلَقَد قَضى فيكِ التَجَلُّدُ نَحبَهُ","فَثَوى وَأَعقَبَ زَفرَةً وَنَحيبا",3,"ب",2,0],["وَلَقَد قُلتُ وَالمَدامعُ تَجري","بِدُمُوعٍ كَأنَّهَا فَيضُ غَربِ",4,"ب",1,0],["وَلَقَد قَسَمتُ لِذي الرِقاعِ هَدِيَّةً","وَتَرَكتُ فيهِ وَهِيَّةً لا تُرقَعُ",5,"ع",1,0],["وَلَقَد قَطَعتُ مجاهِلاً وَمَناهِلاً","وَجِمامُ آجِنِها كَلَونِ العَندَمِ",6,"م",1,0],["وَلَقَد قَطَعتُ وَصيلَةً مَجرودَةً","يَبكي الصَدى فيها لِشَجوِ البومِ",7,"م",1,0],["ولقد قصْدتكَ شاكياً حرّ الظما","فكرعتُ في عذبِ الصلات بِرودها",8,"د",3,0],["ولقد قال سَيِّدٌ من أُولي الفض","ل ومن سِرِّ صفوة الأصفياءِ",9,"ا",2,0],["ولقد قلت حين أخطأني الحُمْ","لانُ قدْ تخطىء المحِقَّ الذَّنُوبُ",10,"ب",1,0],["ولقد قلتُ قوْلَ صدق سيشفي","صِدْقُه كلَّ مُدْنَفٍ معْمُودِ",11,"د",1,0],["ولقد قلتُ عند ذاك وأضمر","تُ على باخسي حقوقي حقدا",12,"د",2,0],["ولقد قلتُ لدهري إذ غدا","وهو للأخيْار ظلّامٌ ضَهُودُ",13,"د",1,0],["ولقد قلت للشباب الذي با","ن قليلٌ من قاسمٍ أن يعيدَكْ",14,"ك",1,0],["ولقد قلتُ للحمام وقد غر","ردَ في أيكه يُضاهي نشيدَكْ",14,"ك",1,0],["ولقد قطعتَ إليه كلَّ حِبالة","لا يستطيعُ لها الدهاةُ حويلا",15,"ل",2,0],["ولقد قام بذاك ال","ثقل جِلدٌ وعظامُ",16,"م",1,0],["ولقد قيل قديماً","شيمةُ الخير الوِسامُ",16,"م",1,0],["وَلَقَد قُلتُ لِنَفسي وَأَنا بَينَ المَقابِر","هَل رَأَيتِ الأَمن وَالراحَةَ إِلّا في الحَفائِر",17,"ر",1,0],["وَلَقَد قُلتُ يَومَ نادى المُنادي","مُستَحِثّاً بِرِحلَةٍ وَاِنطِلاقِ",18,"ق",1,0],["ولقد قالوا ما لاحمد قبر","كذبوا ان قبر احمد قلبي",19,"ي",1,0],["وَلَقَد قالَ طَبيبي","وَطَبيبي ذو اِحتِيَالِ",20,"ل",1,1],["وَلَقَد قُلتُ وَخَمرُ ال","حُبِّ قَد أَقرَحَ قَلبي",21,"ب",2,0],["وَلَقَد قُلتُ لِأَهلي","إِذ أَذابَ الحُبُّ لَحمي",22,"م",2,0],["وَلَقَد قَتَلتُ الشَعثَمَينِ وَمالِكاً","وَاِبنَ المُسَوَّرِ وَاِبنَ ذاتِ دَوامِ",23,"م",1,0],["ولَقَد قُلتُ لحادي عيسِنا","وهيَ بِالبُخلِ عَنِ البُخلِ تَجود",24,"د",1,0],["وَلَقَد قُلتُ يَومَ مَكَّةَ لَمّا","أَرسَلَت تَقرَأُ السَلامَ عَلينا",25,"ن",2,0],["وَلَقَد قُلتُ يَومَ مَكَّةَ سِرّاً","قَبلَ وَشكٍ مِن بَينِكُم نَوَّلينا",26,"ن",2,0],["وَلَقَد قُلتُ مُخفِياً لِغَريضٍ","هَل تَرى ذاكَ الغَزالَ الأَجَمّا",27,"م",2,0],["وَلَقَد قَضَّيتُ حاجا","تي وَلاقَيتُ النَعيما",28,"م",2,0],["وَلَقَد قَرَأتُ كِتابَها فَفَهِمتُهُ","لَو كانَ غَيرَ كِتابَها لَم أَفهَمِ",29,"م",1,0],["وَلَقَد قالَتِ الحَبيبَةُ لَولا","كَثرَةُ الناسِ جُدتُ بِالتَقبيلِ",30,"ل",1,0],["وَلَقَد قُلتُ يَومَ بانوا لِبَكرٍ","أَنتَ يا بَكرُ سُقتَنا ذا المَساقا",31,"ق",2,1],["وَلَقَد قُلتُ لا أَبا لَكَ دَعني","إِنَّ حَتفي في أَن أَزورَ الرِفاقا",31,"ق",2,0],["وَلَقَد قُلتُ عَلى فَو","تٍ وَكَفكَفتُ الدُموعا",32,"ع",2,0],["وَلَقَد قُلتُ زاجِراً لِفُؤادي","لَو نَهاهُ عَن حُبِّها الإِزدِجارُ",33,"ر",1,0],["وَلَقَد قُلتُ لَيلَةَ البَينِ إِذ جُد","دَ رَحيلٌ وَخِفتُ أَن أُستَطارا",34,"ر",2,0],["وَلَقَد قُلتُ إِذ تَطاوَلَ هَجري","رَبِّ لا صَبرَ لي عَلى هَجرِ هِندِ",35,"د",1,1],["وَلَقَد قُلتُ لِبَكرٍ","إِذ مَرَرنا بِالصِفاحِ",36,"ح",1,0],["وَلَقَد قالَت لِأَترابٍ لَها","كَالمَها يَلعَبنَ في حُجرَتِها",37,"ت",3,1],["وَلَقَد قُلتُ أَيُّها القَلبُ ذو الشَو","قِ الَّذي لا يُحِبُّ حُبَّكَ حِبُّ",38,"ب",1,0],["وَلَقَد قُلتُ لَيلَةَ الجَزلِ لَمّا","أَخضَلَت رَيطَتي عَلَيَّ السَماءُ",39,"ا",2,0],["ولقد قتلنا المشركينَ نُريدُه","فتحاً يَشُجُّ الشِّركَ في عِرْنِينهِ",40,"ه",1,0],["وَلَقَد قَصَرتَ عَلى تَميمٍ نِعمَةً","وَعَمَمتَ بِالنُعمى عَلى أَنمارِ",41,"ر",1,0],["وَلَقَد قُلتُ إِذ وَقَفتُ حَزِيناً","وَدُمُوعي حَثيثَةُ الإِنسِكابِ",42,"ب",1,0],["وَلَقَد قَفَوتُ الغَيثَ يَنطُفُ دَجنُهُ","وَالصُبحُ مُلتَبِسٌ كَعَينِ الأَشهَلِ",43,"ل",1,0],["وَلَقَد قُلتُ لِعَمروٍ","بَعدَ كِتماني خَريفا",44,"ف",2,0],["وَلَقَد قُلتُ إِذ أَطَلَّ عَلى القَو","مِ ثَقيلٌ يُربي عَلى ثَهلانِ",45,"ن",1,0],["وَلَقَد قاسَيتُ مِن جَورِ الَّتي","عَجَبَ الدَهرِ وَمِن كَأسِ السُكُر",46,"ر",1,0],["وَلَقَد قُلتُ لِزَورٍ زارَني","بَعدَما أَعرَضَ حيناً وَهَجَر",46,"ر",1,0],["وَلَقَد قُلتُ حينَ خامَرَني الحُب","بُ بِداءٍ مِن كاعِبٍ وَخَريدِ",47,"د",1,0],["وَلَقَد قُلتُ يَومَ قالوا تَشَكَّت","بِصُداعٍ مِن صالِبِ الأَورادِ",48,"د",1,0],["وَلَقَد قُلتُ لِأُخرى أَعرَضَت","دونَ رَيحانَةَ قَتلي صَرَدا",49,"د",2,0],["وَلَقَد قُلتُ حينَ لَجَّ بِيَ الحُب","بُ وَأَصبَحتُ خاشِعاً كَالوَحيدِ",50,"د",1,0],["وَلَقَد قُلتُ لِلَّتي","دَفَعَتني مُصرَدّا",51,"د",2,0],["وَلَقَد قُلتُ إِذ جُفيتُ وَلَم أَج","فُ وَكانَت بَلِيَّتي مِن وِدادي",52,"د",2,0],["وَلَقَد قُلتُ لِلنِطاسِيِّ أُعطي","كَ تِلادي وَطارِفي بِالنَجاحِ",53,"ح",1,0],["وَلَقَد قُلتُ لِراجٍ","راحَتي بِالرُقَياتِ",54,"ت",1,0],["وَلَقَد قُلتُ حينَ أَنصَبَني الحُب","بُ فَأَبلى جِسمي وَعَذَّبَ قَلبي",55,"ب",2,0],["وَلَقَد قُلتُ لِلَّذي لامَني في","كِ جِهاراً وَما تَقَنَّعتُ خَبّا",56,"ب",2,0],["وَلَقَد قُلتُ لِلنَطاسِيِّ لَمّا","جِئتُهُ وَاِشتَكَيتُ داءَ الحِبابِ",57,"ب",1,0],["وَلَقَد قُلتُ لِقَلبي خالِياً","حينَ لَم يَلقَ هَواها وَدَأَب",58,"ب",1,0],["وَلَقَد قُلتُ لِاِبنِ جُهمَةَ إِذ بِت","تُ مَشوقاً وَنامَ عَنّي الصِحابُ",59,"ب",1,0],["وَلَقَد قُلتُ إِذ تَوَلَّتنِيَ الهَم","مُ وَسُدَّت مِن دونِيَ الأَبوابُ",59,"ب",1,0],["وَلَقَد قُلتُ لِسَلمى","إِذ تَعَيّاني طَبيبي",60,"ب",2,0],["وَلَقَد قُلتُ إِذ تَلَوّى بِيَ الحُب","بُ وَفَوقي مِنَ الهَوى كَالضَبابَه",61,"ب",2,0],["وَلَقَد قُلتُ وَالدُمو","عُ لِباسُ التَرائِبِ",62,"ب",1,0],["وَلَقَد قُلتُ يَومَ زافَ لِمَسعو","دٍ وَأَلقى عَنهُ قِناعَ الحَياءِ",63,"ا",2,0],["وَلَقَد قَتَلنَهُمُ وَكَم مِن سَيِّدٍ","عَكَفَت عَلَيهِ خُيولُنا وَهُمامِ",64,"م",1,0],["ولقد قال ناعتوه هو العا","لم منا بما تكنُّ الصدور",65,"ر",1,0],["ولقد قام في الأخير فتى يخ","طب فيهم والصوت منه جهور",65,"ر",1,0],["وَلَقَد قنعت من الطَعا","م ببلغة تتيسر",66,"ر",1,0],["ولقد قالوا شذوذٌ مُغرِبُ","وإباحيَّة لاهٍ لا يُفيقْ",67,"ق",1,0],["ولقد قُدتَني كثيراً فوَجَّه","تُ بما خيَّبَت عليكَ شَمالِ",68,"ل",1,0],["ولقد قَضيتُ العُمرَ أطْبَع فِتْيَتِي","طَبْعًا على كَرَمٍ، وحُسْنِ خِلالِ",69,"ل",1,0],["ولقد قلت إذ أطلَّ على القود","مِ ثقيلٌ يُربي على ثهلانِ",70,"ن",1,0],["ولقد قلتُ حين خامرني الحب","بِدَاءٍ من كَاعب وخَرِيدِ",71,"د",1,0],["ولقد قلتُ إذ تولتني الهم","وَسُدَّتْ مِنْ دُونيَ الأَبْوَابُ",72,"ب",1,0],["ولقدْ قلتُ إذ تلوَّى بيَ الحبُّ وفو","قي من الْهوى كالضَّبابهْ",73,"ب",2,0],["ولقد قلتُ والدُّم","عُ لباسُ التَّرائبِ",74,"ب",1,0],["ولقد قال ماردٌ يتلظى","في جحيمٍ على البرية ناقم :",75,"م",1,0],["ولقد قلتُ للحمام وقد غرَّ","دَ في أيكه يُضاهي نشيدَكْ",76,"ك",1,0],["ولقد قالتْ لأترابٍ لها،","كالما يلعبنَ في حجرتها:",77,"ت",3,1],["وَلَقَدْ قُلْتُ، مُخْفِياً، لِغَرِيضٍ","هَلْ تَرَى ذَلِكَ الغَزَالَ الأَجمّا؟",78,"م",2,0],["وَلَقَدْ قُلْتُ ليلة َ البَيْنِ إذْ جَدَّ","رَحِيلٌ وَخِفْتُ أَنْ أُسْتَطَارا",79,"ر",2,0],["ولقد قضى العام الطويل بسجدة","فوق الثرى الثرى ببطاح أطيب وادي",80,"د",2,0],["ولقد قلتك بالهجاء ولم تمت","إن الكلاب طويلة الأَعمار",81,"ر",1,0],["وَلَقَد قُلتُ لِسَلمى","إِذ قَتَلتُ البَينَ عِلما",82,"م",2,0],["وَلَقَد قالَ طَبيبي","وَطَبيبي غَيرُ آلِ",83,"ل",1,1],["وَلَقَد قَضَيتُ وَإِن تَجَلَّلَ لِمَّتي","شَيبٌ عَلى رَغمِ العِدا لَذّاتي",84,"ت",2,1],["ولقد قال وقد عاتبته","سل يجري كلّ ما قد قدرا",85,"ر",2,0],["وَلَقَد قَضى بِاللَهِ مُنتَقِلاً إِلى","دارِ السَعادةِ في النعيمِ الأَعظَمِ",86,"م",1,0],["وَلَقَد قَضى بِالخَيرِ مُدَّتَهُ إِلى","أَن زارَ حُفرَتَهُ كَما شاءَ القَضا",87,"ض",2,0],["وَلَقَد قَضى بِاللَهِ مُنتَقِلاً إِلى","دارِ النَعيمِ فَحَلَّ خَيرَ مَقِيلِ",88,"ل",1,0],["وَلَقَد قَضى بِالبِرِّ مُدَّتَهُ إِلى","أَن جاءَهُ أَجَلُ القَضا المَحتومِ",89,"م",1,0],["وَلَقَد قَضى بِاللَه مُنتَقِلاً إِلى","أَوجٍ تَسبِّحُ في العُلى طَغماتُهْ",90,"ت",2,0],["ولقد قلت للتي عذلتني","في انقباضي واللوم همّ طويل",91,"ل",1,0],["ولقد قام في المواسم قس","شاهداً أنه نبي رسول",92,"ل",1,0],["ولقد قضوا حِقَباً يقاتل بعضُهم","بعضاً وسترُ ضَلالهم مسدول",93,"ل",1,0],["ولقد قلتُ للزمان وإن كا","ن إليهِ في أمري التَّفويضُ",94,"ض",1,0],["ولقد قلّما البقاء مجاز فار","كبا آلة السرور وجوزا",95,"ز",2,0],["وَلَقَد قَرَّتِ الأَعادي عُيوناً","طالَما أُغفِيَت عَلى الأَقذاءِ",96,"ا",2,0],["وَلَقَد قُلتُ حينَ أَجحَرني البَر","دُ كَما تَجحَرُ الكِلابُ ثعالَه",97,"ل",2,1],["وَلَقَد قُلتُ حينَ أَقفَرَ بَيتي","مِن جِرابِ الدَقيقِ وَالفُخّارَةِ",98,"ر",2,1],["وَلَقَد قُلتُ يَومَ بانوا بِصَرمٍ","كَيفَ وَصلي مِن لا يُجِدُّ وِصالي",99,"ل",2,0],["وَلَقَد قَطَعتُ الخَرقَ تَحمِلُ نُمرُقي","حَدَّ الظَهيرَةِ عَيهَلٌ في سَبسَبِ",100,"ب",1,1],["ولَقَد قُلتُ حينَ أرسلتُ فاعتَل","لَ رَسولي بِالواكِفِ المُتَراكِم",101,"م",1,0],["وَلَقَد قلت لِلزَّمانِ مَقالاً","حينَ أَكدى وَعادَ جدباً يَبيسا",102,"س",2,0],["ولقد قضى نحباً أبُوه وقد مضى","ما لامرئٍ في الكائنات خلود",103,"د",1,0],["ولقد قربت من المعالي قربك ال","داني من العافين بالإِيصال",104,"ل",1,0],["ولقد قمتمُ الليالي قياماً","واكتحلتم من القيام السهادا",105,"د",2,0],["ولقد قلت حين زار وقلبي","ذو ثباتٍ على الهوى وعهودِه",106,"د",2,0],["ولقدْ قدَحْتَ زِنادَ شوقٍ طالما","أورى شَرارَ المَدْمَع المتبجّسِ",107,"س",1,0],["ولقد قابلَ جدوى","كفِّك العُدْمَ فزالا",108,"ل",2,0],["ولقد قلتُ حين عاودني الحبُّ","نِكاحُ البَغيضةِ التطليقُ",109,"ق",1,0],["ولقد قَضَيْتُ من الصَّبابَةِ حَقَّها","فَقَضتْ من الأَمَلِ البَعيدِ مآرَِبي",110,"ب",2,0],["ولقد قطعت علائقي من كل مخ","لوق فلا تقطع لديك علائقي",111,"ق",2,0],["ولقد قصدنا في رضاك لزمزم","للاغتسال عساك تقبل غسلنا",112,"ن",2,0],["ولقد قضيتُ مآرباً نجديَّةً","ودُجى الذؤابة صبحة لم يُسفرِ",113,"ر",1,0],["وَلَقَد قُلتُ يَومَ مَكَّةَ سِراً","قَبلَ وَشكٍ مِن بَينها نَوِّليني",114,"ي",1,1],["ولقد قلت لمن أق","بل بالمفقود ينعى",115,"ع",2,0],["ولقد قالوا الفتى جنَّ سدى","كذبوا عمداً وجهلاً صدقوا",116,"ق",3,0],["ولقد قصُرَتْ أَيَّامهُ ولَهاً بكُمْ","كما طالَ فيكم يالَ وُدِّي عِتابُهُ",117,"ب",2,0],["ولقد قرضضتض الشعر فاسمع واستمع","لنشيد شعر طائعاً وقراضض",118,"ض",1,0],["ولقد قلتُ والجَوى يُخرس النُّطْ","قَ ذُهولاً وحَيْرَةً ووُجوما",119,"م",2,0],["ولقد قلتُ إذْ سمعتُ الّذي كن","تُ أُرَجِّي للّه دَرُّ النّاعي",120,"ع",2,0],["وَلقد قلت لِلمليحةِ والرأ","سُ بِصبغ المَشيب ظلماً خضيبُ",121,"ب",1,0],["وَلَقد قلت وَلِلمَش","غوفِ في الأمرِ اِرتيابُ",122,"ب",1,0],["ولقد قرأناه صحائف نُشِّرَت","بالحق بين معارف وعلوم",123,"م",1,0],["ولقد قصَّرَت طِوالُ الليالي","هِمَّتي فانتشا من الطُّول قِصرِي",124,"ر",2,0],["ولقد قُلتُ للذي رامَ مدحاً","لكريمٍ يُرضى بهِ ويُصدَّقْ",125,"ق",1,0],["ولقد قُلْتُ لإسْحاقَ وإسْ","حاقَ بالأوجاع والأدْوَاءِ طَبْ",126,"ب",1,0],["وَلَقَد قُلتُ لِلوَزيرِ أَبي الحَجّاجِ","صَبراً لِرَيبِ دَهرٍ مُشيحِ",127,"ح",1,0],["ولقد قامَ بنصر ال","له حرباً ونِزَالا",128,"ل",2,0],["ولقد قَدمتَ فسوفَ أَغفِرُ مَا جَنى","دَهْرِي عليَّ وسَوْفَ آسُو ما اجْتَرَح",129,"ح",1,0],["ولقد قَتلتكم ثُناءَ وَموحَدَا","وتركتُ مُرَّة مثلَ أَمسِ المدبِرِ",130,"ر",1,0],["وَلَقَد قَتَلنا مِن بَنيكَ ثَلاثَةً","فَلَتَزِعَنَّ وَأَنتَ غَيرُ مُطاعِ",131,"ع",1,0],["ولقد قطعتُ الوصلَ يوم خلاجِهِ","واخو الصريمةِ في الأمورِ المزمعُ",132,"ع",1,0]]}