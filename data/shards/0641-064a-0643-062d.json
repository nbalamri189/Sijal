{"poems":[[108,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[226,"نما على أرضها الشجر","https://www.aldiwan.net/poem55288.html","مخلع البسيط"],[572,"الحمد لله قد وجدت أخا","https://www.aldiwan.net/poem69721.html","المنسرح"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110827","الرمل"],[3827,"","https://poetry.dctabudhabi.ae/diwan/poem/139834",""],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76443","الرمل"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35047","الرمل"],[4680,"طلعة الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=185087",""],[4968,"كان ظلي","https://www.poetsgate.com/ViewPoem.aspx?id=206572",""],[5064,"حُطام مقدور بائس","https://www.poetsgate.com/ViewPoem.aspx?id=199131",""],[572,"الحمدُ للهِ قَدْ وَجَدْتُ أَخاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9238&r=&rc=95",""]],"verses":[["فيك حيَّيتُ كلَّ ذاتِ شراعِ","تتهادى تهاديَ النَّشوان",0,"ن",1,0],["فيك حياة وفيك موت","يرمقنا خلسة شذر",1,"ر",1,0],["فيك حَيَاةٌ وَأَمْنَةٌ رَخُصَتْ","بالنَّفْسِ دون الطَّرِيْفِ والتَّالِدْ",2,"د",1,0],["فيك حكم وجلالُ","ولك الناس عيالُ",3,"ل",1,1],["فيك حلت هضب العلى من بني عد","نان في مربع العلى المهضوب",4,"ب",1,0],["فيك حبر فيك اقلام","وَفي وجهك الارشاد",5,"د",1,0],["فيكَ حسبي لو ولكن","ريثما قوليَ يَلزب",6,"ب",1,0],["فيكِ حُسنٌ هامتْ به الأرض نشوى","وتمنّتهُ فاتناتُ الغيدِ",7,"د",1,0],["فيك حرفي هائما شق الذرى","صاعدا يربو وبين الفلك صارا",8,"ر",2,0],["فيكَ حسُّ الكونِ يا قلبُ انطوَى","أفِئن متَّ فنحنُ السُّعدَاءْ.؟!",9,"ا",2,0],["فيكَ حياة ٌ وأُنسَة ٌ رَخُصَتْ","بالنفسِ دونَ الطريفِ والتالِدْ",10,"د",1,0]]}