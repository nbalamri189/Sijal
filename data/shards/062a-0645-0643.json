{"poems":[[75,"هي الشمس مغربها في الكلل","https://www.aldiwan.net/poem11950.html","المتقارب"],[10,"ذكرت أخي بعد نوم الخلي","https://www.aldiwan.net/poem21082.html","المتقارب"],[29,"لعل فراق الحي للبين عامدي","https://www.aldiwan.net/poem5733.html","الطويل"],[4,"يا ضمر يا عبد بني كلاب","https://www.aldiwan.net/poem21216.html","الرجز"],[74,"أفديه أعمى مغمدا لحظه","https://www.aldiwan.net/poem18584.html","السريع"],[104,"سل جنة الشعر ما ألوى بدوحتها","https://www.aldiwan.net/poem32925.html","البسيط"],[54,"تمكن هذا الدهر مما يسوءني","https://www.aldiwan.net/poem26852.html","الطويل"],[77,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[92,"الأنانية","https://www.poetsgate.com/ViewPoem.aspx?id=179128",""],[189,"أيام ملكك أعياد وأعراس","https://www.aldiwan.net/poem14555.html","البسيط"],[203,"تغيرت الدنيا فهل هي زور","https://www.aldiwan.net/poem45156.html","الطويل"],[208,"تمكنت من قلبي وجسمي ومهجتي","https://www.aldiwan.net/poem53096.html","الطويل"],[208,"غزال عليه طرة وقصاص","https://www.aldiwan.net/poem53107.html","الخفيف"],[208,"خانوا وإني على العهد الذي عهدوا","https://www.aldiwan.net/poem53324.html","البسيط"],[254,"أمن دمنة عادية لم تأنس","https://www.aldiwan.net/poem2113.html","الطويل"],[280,"تمكن من مسامعه العذول","https://www.aldiwan.net/poem25544.html","الوافر"],[302,"حسن ابتدائي بذكري جيرة الحرم","https://www.aldiwan.net/poem33180.html","البسيط"],[303,"خليلي إني قد حننت لقربها","https://www.aldiwan.net/poem36259.html","عموديه"],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[325,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[376,"سقيم نهاه سقم جفنيه أن يسلو","https://www.aldiwan.net/poem57172.html","الطويل"],[398,"ولما تناءت بالحبيب دياره","https://www.aldiwan.net/poem53424.html","الطويل"],[411,"تمكنت من تقبيل كف لو أنني","https://www.aldiwan.net/poem49795.html","الطويل"],[463,"أما والنقا لولا هوى ظيبة النقا","https://www.aldiwan.net/poem56097.html","الطويل"],[484,"متى يا دهر تجمع شمل أنسى","https://www.aldiwan.net/poem36931.html","الوافر"],[509,"سما قدر السماحه والجمال","https://www.aldiwan.net/poem38407.html","الوافر"],[519,"إلى الله نشكو فادحات النوائب","https://www.aldiwan.net/poem20840.html","الطويل"],[567,"دع يوم أمس وخذ في شأن يوم غد","https://www.aldiwan.net/poem52862.html","البسيط"],[568,"هو الموت عضب لا تخون مضاربه","https://www.aldiwan.net/poem13604.html","الطويل"],[572,"تريك مرور الليالي العبر","https://www.aldiwan.net/poem69673.html","المتقارب"],[580,"أحدث عنكم أن بعدكم دنا","https://www.aldiwan.net/poem2999.html","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38063","الطويل"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100158","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67820","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120097","الوافر"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136122","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136363","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136355","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136351","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136299","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136267","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136191","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136204","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136168","الطويل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56670","السريع"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115948","الطويل"],[1631,"","https://poetry.dctabudhabi.ae/diwan/poem/142174","البسيط"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132290","الوافر"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66288","الوافر"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106706","المتقارب"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125476","البسيط"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74993","الوافر"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109373","الطويل"],[2737,"","https://poetry.dctabudhabi.ae/diwan/poem/20978","الطويل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139984","الطويل"],[3481,"","https://poetry.dctabudhabi.ae/diwan/poem/112964","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86241","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110058","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91440","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117886","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114211","الطويل"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21534","الطويل"],[4166,"","https://poetry.dctabudhabi.ae/diwan/poem/203266","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54485","البسيط"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28792","الطويل"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127937","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33553","السريع"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33321","المتقارب"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136383",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139629",""],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/199652","الرجز"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4755,"على السَّطرِ عَانَى البَحرُ عاصِفَةً هَوْجَا","https://www.poetsgate.com/ViewPoem.aspx?id=190070",""],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4935,"ألا يا نفس ما هذا التواني","https://www.poetsgate.com/ViewPoem.aspx?id=129284",""],[4984,"لمن تُعزف النجوى ؟","https://www.poetsgate.com/ViewPoem.aspx?id=175545",""],[5464,"طرقنا بابكم فأجاب صمت","https://www.poetsgate.com/ViewPoem.aspx?id=6677",""],[4623,"خليلي زدني من مديح محمد ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146771",""],[5956,"حول الأوزان والحداثة","https://www.poetsgate.com/ViewPoem.aspx?id=186235",""],[5956,"قممٌ تُعْقد","https://www.poetsgate.com/ViewPoem.aspx?id=194436",""],[5964,"تمكن حب علوة من فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=181308",""],[5997,"جمر في ذاكرة الرماد","https://www.poetsgate.com/ViewPoem.aspx?id=214424",""],[6056,"بنت رسلان","https://www.poetsgate.com/ViewPoem.aspx?id=130379",""],[6056,"سواليف الغزل","https://www.poetsgate.com/ViewPoem.aspx?id=130511",""],[6218,"زمن أم عمرو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65904&r=&rc=57",""]],"verses":[["تَمَكَّنَ يَتلوكَ في الصالِحاتِ","فَلَمّا تَفُتهُ وَلَمّا يَنَل",0,"ل",1,0],["تَمَكَّنَ في دِفءِ أَرطاتِهِ","أَهاجَ العَشِيُّ عَلَيهِ فَثارا",1,"ر",2,0],["تَمَكَّنتَ في حَيِّي مَعَدٍّ مِنَ الذُرى","وَفي يَمَنٍ أَعلى كَريمِ المَوالِدِ",2,"د",1,0],["تَمكو اِستَهُ مِن حَذَرِ الغُرابِ","يا وَرلاً أُلقِيَ في سَرابِ",3,"ب",1,0],["تمكنت عيناي من وجهه","فقلت هذي جنة الخلد",4,"د",1,0],["تَمكن الذلّ مِن قَومي فَلا عَجَب","أَلّا يُبالوا بِتَقريع وَتَأنيبِ",5,"ب",1,0],["تَمَكَّنَ هَذا الدَهرُ مِمّا يَسوءُني","وَلَجَّ فَما يَخلي صَفاتِيَ مِن قَرعِ",6,"ع",1,1],["تَمْكو عليه فرائصٌ وتَرائِبٌ","وتَرِنُّ فيه سواجِعٌ وثواكل",7,"ل",1,0],["تمكّنَ ذو طَوْلٍ فأصبح حاكماً","وجنّب مدحوراٌ فأصبح راهبا",8,"ب",2,0],["تمكَّنَ النُّجْحُ من آمالِ سائلها","كما تأكدَ من حُسّادها الباس",9,"س",1,0],["تمكنت من عرنينها فاستقدتها","بحبلي بلاءٍ قائد ووزيرُ",10,"ر",1,0],["تمكَّنتَ من قلبي وجسمي ومهجتي","وعذَّبتَني بالهجر والتيه والصَّلَفْ",11,"ف",1,1],["تمكَّنتُ منه نظرةً فأذابني","كما ذاب بين الجمرتَينِ رصاصُ",12,"ص",1,0],["تمكَّن الوجد من قلبي ومن كبدي","فليس لي معه قلب ولا كبدُ",13,"د",1,0],["تَمَكَّثَ حيناً ثُمَّ أَنحى ظُلوفَهُ","يُثيرُ التُرابَ عَن مَبيتٍ وَمَكنِسِ",14,"س",1,0],["تَمكّن من مسامعِهِ العَذول","فقالَ وأنتَ تَدري ما يَقُولُ",15,"ل",1,1],["تمكينُ عَدلٍ لهم أَرسَوا قواعدَه","يَرعى به الذئبُ في المَرعى مع الغنمِ",16,"م",1,0],["تمكَّنَ مني السقمُ في كلِّ مفصلٍ","وَلم يبق بي إلاّ ذَما كدخان",17,"ن",1,0],["تمكن لمشى لا تخط بأرجل","وذيلك لا تسحب كافعال نسوان",18,"ن",1,0],["تَمَكَّنتُ في النَدى إِقدامُهُ وَرَسَت","كَما أَفاضَت بِفَرطِ الجودِ راحَتُهُ",19,"ت",2,0],["تمكنتَ من دنياكَ إنِّيَ إنَّما","دَعوتُ دُعاءً لَيسَ يقبلُه البَذلُ",20,"ل",1,0],["تَمَكَّن مِنّي الشَوقُ غَيرَ مخالِسٍ","كَمُعتَزِلي قَد تَمَكَّن من خَصم",21,"م",1,0],["تمكَّنْتُ من تَقبيلِ كَفِّ لو أنَّني","أردْتُ بِها الدُّنيا لَكُنْتُ أنالُها",22,"ه",2,1],["تمكَّن إسماعيلُ منه ورهطُه","مكانَ تمنَّى البدرُ لو أنه ارتقى",23,"ق",2,0],["تمكن بي الهوى فغضضت طرفي","وكيف يكون هدم متين أس",24,"س",1,0],["تمكن في القلوب ودام فيها","فما في ذي البلاد سواه وال",25,"ل",1,0],["تمكّن منهُ الموتُ في قَبضِ روحِه","ولم يتمكّنْ عندَ قبضِ الرّواجِبِ",26,"ب",1,0],["تَمكَّنت بعدَ ضُعفٍ من نَفائسِهِ","حتَّى ابتَنَتْ كُلَّ بيتٍ شامخِ العُمُدِ",27,"د",1,0],["تَمَكَّنَ مِن نَفسي بِنَفسٍ سَماعه","جَوى فيهِ كُلّي ذابَ قَلبي وَقالِبُه",28,"ب",2,0],["تَمَكَّنَتِ النَّارُ مِنْ جِسْمِهَا","فَلَمْ تُبْقِ فِي الصَّفْوِ مِنْهَا كَدَرْ",29,"ر",1,0],["تمكنَّ في دَست الوزَارَة جالساً","وما كلُّ من رامَ الجلوسَ تمكَّنَا",30,"ن",2,0],["تَمَكَّنَ مِنهُ الحبُّ إِذ صارَ أَمكناً","وَلَكِن مِنَ التّعذيبِ لَم يَجِد الصّرفا",31,"ف",2,0],["تمكن مني ما حييت غرامه","فلست وإن طال التباعد أقلاه",32,"ا",2,0],["تَمَكَّنَ فِي الأَحشَاءِ كل التَّمَكُّنِ","وَصَافَيْتُهُ فِي الْوُدِّ مِنْ كُلِّ مُمْكِنَ",33,"ن",1,0],["تمكن حب علوة من فؤادي","وزاد فزال عن عيني رقادي",34,"د",2,1],["تمكن مني حين شابت مفارقي","فلله حب عندما شبت قد شبا",35,"ب",2,0],["تمكن فيها الحب حتى تحملت","من الحب حمل لا يطيق له رضوى",36,"و",2,0],["تمكن في قلبي هواكم فلم يرد","سواكم وما في الحب حظ لمن ثنى",37,"ن",2,0],["تمكن مني الحب حتى رأيته","سرى من فوادي بعد ذاك إلى البدن",38,"ن",1,0],["تمكن في قلبي الهوى لاعدمته","فقل لعذولي أنت بالحب جاهل",39,"ل",1,0],["تمكن في قلبي فاضرم في الحشا","لهيب غرام في المحبة محرقي",40,"ق",2,0],["تمكن في علم الحقايق كلها","وخاض بحارا ليس تحصر بالذكر",41,"ر",1,0],["تمكن فيه الحب حتى كانه","لشدته من جنس أهل المقابر",42,"ر",1,0],["تمكن في قلبي هواهم وحبهم","فلله ما يخفيه قلبي وما يبدو",43,"د",2,0],["تمكث من تحت رماد المدى","وفوقها تحترق الأفئده",44,"ه",1,0],["تمكّن من قلبى حبيبٌ ألِفتُهُ","فليس لخلقٍ غيره فيه موضعُ",45,"ع",1,0],["تمكنوا من جبال الشام واعتصموا","فكل حصن على الاجيال مريد",46,"د",1,0],["تمكّنت المليحة من عناني","متى منها عنيت بما عناني",47,"ن",2,1],["تمكن حبّه في كل قلبٍ","ودب بكل لبٍ أو جنان",48,"ن",1,0],["تمكَّنَ في النَّاسِ أجمعِهِم","فيَعرِكُ غَركَ الرّحَى للثَّقَال",49,"ل",1,0],["تمكن السُّهدُ من عيني فأرقَّها","وقد تعدى على قلبي فواحربي",50,"ب",2,0],["تمكن من فؤادي الوجل حَتّى","رأت شكل الهَوى مني العيون",51,"ن",1,0],["تمكَّن عرشُ العز منهُ بمظهرٍ","واضحى به جيشُ المهابة يُحدِق",52,"ق",1,0],["تُمَكَّكُ أَطرافَ العِظامِ غُدَيَّةً","وَتَجعَلَهُنَّ لِلأُنوفِ خَواطِما",53,"م",2,0],["تمكَّن فيه المجد أيَّ تمكن","فخصت أياديه الكرام وعمت",54,"ت",1,0],["تمكَّنوا من وصاياهُ وقد طفقوا","يسعون بين الذئاب الطُّلس كالغنمِ",55,"م",1,0],["تَمَكَّنَ العَدلُ في ايّامِ دَولَتِهِ","حَتّى غَدا المُلكُ مِنهُ ثابِتَ القَدم",56,"م",1,0],["تمكنَ الحُبُّ في قلبي وزِدتَ هَوىً","بمدحهِ الرُسل نُور العُرب والعَجَمِ",57,"م",1,0],["تمكّن حبُّها وَنما هواها","فعزّ القَلبُ أَن يَطلبْ سواها",58,"ا",3,1],["تمكن من إدارتها بعزم","تخر له الجبال الراسيات",59,"ت",1,0],["تَمَكَّنَ فِي صَدرِي هَوىً مِنكَ لاَ يُدرَى","وَلَيسَ لَهُ نَسخٌ لأنَّ لَهُ الصَّدرَا",60,"ر",2,1],["تَمكَّنَ مِن غِرّاتِهِ الحُبُّ فانتَحى","عَليهِ بأَيدٍ أَيّدات حَواشِدِ",61,"د",1,0],["تمكين حبك في قلبي به نسخت","محبة الكل من عرب ومن عجم",62,"م",1,0],["تمكّنَ الرُّعبُ في قلبِ العدوِّ بها","تمكُّنَ النّارِ بالإحراقِ في الفحمِ",63,"م",1,0],["تَمَكَّنت مِن نَفسي فَأَزمَعت قَتلَها","وَأَنتَ رَضِيُّ البالِ وَالنَّفس تَذهَبُ",64,"ب",1,1],["تمكنوا في وصاياه وقد طفقوا","يسعون بين الذباب الخطف كالغنم",65,"م",1,0],["تمكنت من قلبهِ لحظةٌ","أسرَع فيها القدرُ المُبهَمُ",66,"م",1,0],["تمكن من خدهِ الاحمرارُ","وجانسَهُ الوَردُ والجُلنارُ",67,"ر",1,1],["تمكن من كل المعارف فانجلت","لافكاره فوراً صعاب المسائل",68,"ل",1,0],["تمكَّنُ أن ترقي لأحفظ رفعةٍ","اليك بجنح النسر طرنَ الفراقد",69,"د",1,0],["تم كأس الحمام المنقع","وأصبحت ديارهم كالبلقع",70,"ع",1,0],["تَمَكَّنَ مِنّي الحُبُّ فَاِمت