{"poems":[[77,"صاب مزن الدموع من جفن صبك","https://www.aldiwan.net/poem36705.html","الخفيف"],[71,"يا دهر ويحك ما عدا مما بدا","https://www.aldiwan.net/poem4011.html","الكامل"],[83,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"ما القلب في إثرهم بمختطف","https://www.aldiwan.net/poem65441.html","المنسرح"],[12,"ومرقبة عنقاء يقصر دونها","https://www.aldiwan.net/poem1216.html",""],[85,"قم سليمان بساط الريح قاما","https://www.aldiwan.net/poem63696.html","الرمل"],[85,"أنا من خمسة وعشرين عاما","https://www.aldiwan.net/poem63697.html","الخفيف"],[43,"أركائب الأحباب إن الأدمعا","https://www.aldiwan.net/poem9723.html","الكامل"],[45,"يائبنة الدهر هل رأيت كمثلي","https://www.aldiwan.net/poem65532.html","الخفيف"],[58,"العلم زين فكن للعلم مكتسبا","https://www.aldiwan.net/poem30998.html","البسيط"],[66,"نفوس الصيد أثمان المعالي","https://www.aldiwan.net/poem40137.html","الوافر"],[48,"قد غنينا عن الشتاء","https://www.aldiwan.net/poem66247.html","مجزوء الخفيف"],[46,"إركع لربك في نهارك واسجد","https://www.aldiwan.net/poem22482.html","الكامل"],[46,"أركان دنيانا غرائر أربع","https://www.aldiwan.net/poem23489.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85591","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85551","البسيط"],[21,"","https://poetry.dctabudhabi.ae/diwan/poem/11042","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43749","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54222","الرمل"],[99,"ترصيع بالذهب على سيف دمشقي","https://www.poetsgate.com/ViewPoem.aspx?id=587",""],[51,"ما القلبُ في إثْرِهم بمختطَفِ","https://www.poetsgate.com/ViewPoem.aspx?id=29597",""],[174,"سيدي أنت ومن لم","https://www.aldiwan.net/poem46032.html","مجزوء الرمل"],[178,"لعل وعسى","https://www.aldiwan.net/poem50717.html","الرمل"],[371,"هل هائم دنف كما أنا هائم","https://www.aldiwan.net/poem57114.html","الكامل"],[377,"يا صاح إسمع مذ سمت","https://www.aldiwan.net/poem66909.html","مجزوء الرجز"],[391,"الحمدلله حمدا موافيا بالنوال","https://www.aldiwan.net/poem54549.html","عموديه"],[458,"من ناصري والزمان لي خصم","https://www.aldiwan.net/poem55862.html","المنسرح"],[458,"أيقظني للبرقِ وهو نائم","https://www.aldiwan.net/poem55863.html","الرجز"],[458,"قم غير معتذرٍ ولا متثاقلِ","https://www.aldiwan.net/poem55926.html","الكامل"],[458,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[464,"أركض جياد الصبي في حلبة اللعب","https://www.aldiwan.net/poem3615.html","عموديه"],[495,"نظري لهذا العيش كيف مزاجه","https://www.aldiwan.net/poem9805.html","الكامل"],[515,"أركبك الموت يا عطيه","https://www.aldiwan.net/poem12305.html","مخلع البسيط"]],"verses":[["أَرْكَبَتنِي صُرُوفُكَ الصَّعْبَ حَتَّى","جِئْتَ بِالْبَيْنِ وَهْوَ أَصْعَبُ صَعْبَكْ",0,"ك",1,0],["أَركَبتَهُ حَلَقاتِ أَدهَمَ قَصَّرَت","مِنهُ الخُطى مِن بَعدِ أَشقَرَ أَجرَدا",1,"د",2,0],["أركبتَه في المنشآت كأنما","جهزته في وجهة لمزارِ",2,"ر",1,0],["أرَكيكاً رأيتَ عبدك صِفْراً","لا جَنىً فيه أم جنَى شَنْعاءَ",3,"ا",2,0],["أركبه الله ذروةً تمكت","من شرف لم يكن بمرتدف",4,"ف",1,0],["أَرَكَّبُها في كُلَّ أَحمَرَ غاثِر","وَأَنسِجُ لِلوِلدانِ ما هُوَ مُقرِفُ",5,"ف",1,0],["أَركَبُ اللَيثَ وَلا أَركَبُها","وَأَرى لَيثَ الشَرى أَوفى ذِماما",6,"م",2,0],["أَركَبُ البَحرَ تارَةً وَأَجوبُ ال","بَرَّ طَوراً وَأَقطَعُ الأَيّاما",7,"م",2,0],["أَرَكائِبَ الأَحبابِ إِنَّ الأَدمُعا","تَطِسُ الخُدُودَ كَما تَطِسنَ اليَرمَعا",8,"ع",2,1],["أَركَبُ المَهمَهَ المَهولَ بِعَزمٍ","وَثِيابي ظَلامَةُ الحَلكوكِ",9,"ك",1,0],["أَركَبُ اللَيلَ في زُها هائِلِ اللَي","لِ وَرَأدَ الضُحى لِوَقتِ الدُلوكِ",9,"ك",1,0],["أركِن إِلَيهِ وَثِق بِاللَهِ وَاَغنِ بِهِ","وَكُن حَليماً رَزينَ العَقلِ مُحتَرِسا",10,"س",2,0],["أَرُكنَ الدينِ كَم رُكنٍ مَشيدٍ","هَدَدتَ بِفَقدِ ذُيّاكَ الجَمالِ",11,"ل",1,0],["أركب المدنَ في الدي","ار وفي المدنِ والقراءِ",12,"ا",2,0],["إِركَع لِرَبِّكَ في نَهارِكَ وَاِسجُدِ","وَمَتى أَطَقتَ تَهَجُّداً فَتَهَجَّدِ",13,"د",1,1],["أَركانُ دُنيانا غَرائِرُ أَربَعٌ","جُعِلَت لِمَن هُوَ فَوقَنا أَركانا",14,"ن",2,1],["أركِضْ جوادَك في حم","دِ مكرميك وخِبَّا",15,"ب",2,0],["اركض من الزور بغلاً أنت راكبه","فقد وجدت لبغل الزور ميدانا",16,"ن",2,0],["أُر كِسوا في جَهَنَّمَ إِنَهُّم","كانوا عُتاةً تَقولُ اِفَكاً وَزورا",17,"ر",2,0],["أَركَنتُ لِلدُنيا وَكُن","تُ الصَعبَ دونَ لِجامه",18,"ه",1,1],["أَرْكَبُ المَرْكَبَ صَعْباً خَشِناً","إِنْ دَعَتْني هِمَّتي أنْ أرْكَبا",19,"ب",2,0],["إركبي الشمس يا دمشق حصاناً","ولك الله ... حافظ وأمينُ",20,"ن",1,0],["أرْكبَه الله ذروة ً تمكتْ","من شرفٍ من يكن بمرتدفِ",21,"ف",1,0],["أَرْكِبِ الكاسَاتِ كَ","فَّ الرِّيمِ بِالْخَمْرِ المُعَتَّقِ",22,"ق",1,0],["اركضي في لغتي يا ظبيتي","وامنحي قنديلَ شعري قَبَسا",23,"س",2,1],["أركبتَ قَوماً لا يَمَلُّون السُّرَى","خَيلاً عِتاقاً ما لَهنَّ قَوائِمُ",24,"م",1,0],["إركب جنيب الرَسل","وجر لا كالرِسل",25,"ل",1,0],["أركان الاسلام خمسة فاستمع للمقال","تشهد لله بالتوحيد في كل حال",26,"ل",1,0],["أركبُ منها شُهبَ الأماني فتل","قاني الليالي من دونها الدُّهْمُ",27,"م",1,0],["أُركِبْتَه بدراً وقد حُطَّت لك ال","جوزاءُ فهي العُذْر والشكائمُ",28,"م",1,0],["إركب وطاوِلْ فوق كُورِك علَّها","أن تُرْفَعَ الأحداجُ للمتطاولِ",29,"ل",1,0],["أُركِبتَه وجَنبتَ آخر مثلَه","سهمَيْ مصيب قارباك منالا",30,"ل",2,0],["أركضْ جيادَ الصبي في حلبة اللعبِ","فالدَّوحُ راياتهُ خفاقة العذبِ",31,"ب",1,1],["أركبتني فرس الكرامة ملجماً","وعليك بعد لجامه إسْراجه",32,"ج",2,0],["أركبك الموت يا عطيه","نعشاً ويا بئست المطيه",33,"ط",3,1]]}