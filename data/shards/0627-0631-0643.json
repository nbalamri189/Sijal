ww.poetsgate.com/ViewPoem.aspx?id=203490",""],[5652,"ناديت لكن مالقى صوتي مجيب !!","https://www.poetsgate.com/ViewPoem.aspx?id=177404",""],[5664,"خلف سيار","https://www.poetsgate.com/ViewPoem.aspx?id=176684",""],[5689,"ارك بقلبي بت غير موسوس","https://www.poetsgate.com/ViewPoem.aspx?id=143394",""],[5691,"أنَا والدجى","https://www.poetsgate.com/ViewPoem.aspx?id=206743",""],[5732,"يا فزعة المظيوم","https://www.poetsgate.com/ViewPoem.aspx?id=177835",""],[5881,"أيوب","https://www.poetsgate.com/ViewPoem.aspx?id=183766",""],[5897,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=156535",""],[5943,"غمد الحريق","https://www.poetsgate.com/ViewPoem.aspx?id=41601",""],[6115,"نصايح عشر","https://www.poetsgate.com/ViewPoem.aspx?id=180461",""],[6128,"‏اركب مَعي","https://www.poetsgate.com/ViewPoem.aspx?id=212857",""],[6142,"لا تسل ما جرى بميلاده الأز","https://www.poetsgate.com/ViewPoem.aspx?id=155704",""],[6162,"مَا لمْ تَقلهُ المرَايْا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69309&r=&rc=2",""],[463,"قمْ غيرَ معتذرٍ ولا متثاقلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60275&r=&rc=331",""],[6268,"فرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82914&r=&rc=0",""],[6273,"قواف ٍ في ركب السراة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78507&r=&rc=5",""],[3984,"الذئاب الحمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64417&r=&rc=23",""],[5126,"مزنة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87787&r=&rc=2",""]],"verses":[["أَرْكَبَتنِي صُرُوفُكَ الصَّعْبَ حَتَّى","جِئْتَ بِالْبَيْنِ وَهْوَ أَصْعَبُ صَعْبَكْ",0,"ك",1,0],["أَركَبتَهُ حَلَقاتِ أَدهَمَ قَصَّرَت","مِنهُ الخُطى مِن بَعدِ أَشقَرَ أَجرَدا",1,"د",2,0],["أركبتَه في المنشآت كأنما","جهزته في وجهة لمزارِ",2,"ر",1,0],["أرَكيكاً رأيتَ عبدك صِفْراً","لا جَنىً فيه أم جنَى شَنْعاءَ",3,"ا",2,0],["أركبه الله ذروةً تمكت","من شرف لم يكن بمرتدف",4,"ف",1,0],["أَرَكَّبُها في كُلَّ أَحمَرَ غاثِر","وَأَنسِجُ لِلوِلدانِ ما هُوَ مُقرِفُ",5,"ف",1,0],["أَركَبُ اللَيثَ وَلا أَركَبُها","وَأَرى لَيثَ الشَرى أَوفى ذِماما",6,"م",2,0],["أَركَبُ البَحرَ تارَةً وَأَجوبُ ال","بَرَّ طَوراً وَأَقطَعُ الأَيّاما",7,"م",2,0],["أَرَكائِبَ الأَحبابِ إِنَّ الأَدمُعا","تَطِسُ الخُدُودَ كَما تَطِسنَ اليَرمَعا",8,"ع",2,1],["أَركَبُ المَهمَهَ المَهولَ بِعَزمٍ","وَثِيابي ظَلامَةُ الحَلكوكِ",9,"ك",1,0],["أَركَبُ اللَيلَ في زُها هائِلِ اللَي","لِ وَرَأدَ الضُحى لِوَقتِ الدُلوكِ",9,"ك",1,0],["أركِن إِلَيهِ وَثِق بِاللَهِ وَاَغنِ بِهِ","وَكُن حَليماً رَزينَ العَقلِ مُحتَرِسا",10,"س",2,0],["أَرُكنَ الدينِ كَم رُكنٍ مَشيدٍ","هَدَدتَ بِفَقدِ ذُيّاكَ الجَمالِ",11,"ل",1,0],["أركب المدنَ في الدي","ار وفي المدنِ والقراءِ",12,"ا",2,0],["إِركَع لِرَبِّكَ في نَهارِكَ وَاِسجُدِ","وَمَتى أَطَقتَ تَهَجُّداً فَتَهَجَّدِ",13,"د",1,1],["أَركانُ دُنيانا غَرائِرُ أَربَعٌ","جُعِلَت لِمَن هُوَ فَوقَنا أَركانا",14,"ن",2,1],["أركِضْ جوادَك في حم","دِ مكرميك وخِبَّا",15,"ب",2,0],["اركض من الزور بغلاً أنت راكبه","فقد وجدت لبغل الزور ميدانا",16,"ن",2,0],["أُر كِسوا في جَهَنَّمَ إِنَهُّم","كانوا عُتاةً تَقولُ اِفَكاً وَزورا",17,"ر",2,0],["أَركَنتُ لِلدُنيا وَكُن","تُ الصَعبَ دونَ لِجامه",18,"ه",1,1],["أَرْكَبُ المَرْكَبَ صَعْباً خَشِناً","إِنْ دَعَتْني هِمَّتي أنْ أرْكَبا",19,"ب",2,0],["إركبي الشمس يا دمشق حصاناً","ولك الله ... حافظ وأمينُ",20,"ن",1,0],["أرْكبَه الله ذروة ً تمكتْ","من شرفٍ من يكن بمرتدفِ",21,"ف",1,0],["أَرْكِبِ الكاسَاتِ كَ","فَّ الرِّيمِ بِالْخَمْرِ المُعَتَّقِ",22,"ق",1,0],["اركضي في لغتي يا ظبيتي","وامنحي قنديلَ شعري قَبَسا",23,"س",2,1],["أركبتَ قَوماً لا يَمَلُّون السُّرَى","خَيلاً عِتاقاً ما لَهنَّ قَوائِمُ",24,"م",1,0],["إركب جنيب الرَسل","وجر لا كالرِسل",25,"ل",1,0],["أركان الاسلام خمسة فاستمع للمقال","تشهد لله بالتوحيد في كل حال",26,"ل",1,0],["أركبُ منها شُهبَ الأماني فتل","قاني الليالي من دونها الدُّهْمُ",27,"م",1,0],["أُركِبْتَه بدراً وقد حُطَّت لك ال","جوزاءُ فهي العُذْر والشكائمُ",28,"م",1,0],["إركب وطاوِلْ فوق كُورِك علَّها","أن تُرْفَعَ الأحداجُ للمتطاولِ",29,"ل",1,0],["أُركِبتَه وجَنبتَ آخر مثلَه","سهمَيْ مصيب قارباك منالا",30,"ل",2,0],["أركضْ جيادَ الصبي في حلبة اللعبِ","فالدَّوحُ راياتهُ خفاقة العذبِ",31,"ب",1,1],["أركبتني فرس الكرامة ملجماً","وعليك بعد لجامه إسْراجه",32,"ج",2,0],["أركبك الموت يا عطيه","نعشاً ويا بئست المطيه",33,"ط",3,1],["أرُكبانُ رَسلاتٍ خِفافٌ خُفُوفُها","طوالٌ مَثانيها دَوامٍ أُنُوفُها",34,"ف",3,1],["أركان مملكة ضمنت خلودها","بالعدل بعد زيادة وكمال",35,"ل",1,0],["أَركَبتها طِرفَ القَريضِ مُهذّباً","سَهلَ الخَلائِقِ بِالجَزالَةِ ملجما",36,"م",2,0],["أَركَبتها نِضْوَ القَريضِ مذَلّلاً","يَحدوهُ كلّ مُعوّذٍ وَمبسملِ",37,"ل",1,0],["أَركَبتُها مَتنَ الرّجاءِ مَطيَّةً","تَبغي القبولَ وَدونَهُ لا تَهجَعُ",38,"ع",1,0],["إركضي نحوهُ بلهفةِ أمٍّ","وضعي مِعطَفَ الشِتا واحمليهِ",39,"ي",2,0],["أَرْكَبُ ما دُونَ الفُجُورِ البَحْتِ","فَآل أَوْلِي وَاسْتَقَامَ سَمْتِي",40,"ت",2,0],["أُرْكضُ أَفْراسَ التَّصابي مِنَ ال","لَّذاتِ في أَرْحَبِ مَيْدانِ",41,"ن",1,0],["أرَكباً سَرى إِذ شامَ بَرقاً يَمانيا","لِيَهنِكُم أَنّا بَلَغنا الأَمانيا",42,"ي",2,1],["أَرُكبانَ أَنضاءِ السِفار أَلا قِفُوا","رُسُومَ المَطايا في رُسومِ المَنازِلِ",43,"ل",1,0],["أركب الردى هل من يؤدي رسالتي","إلى جدت أمسى علي رهينه",44,"ن",2,1],["أركائب الأحباب وقفة ساعةٍ","تشفي لواعج قلبي الموجوع",45,"ع",1,0],["اركبي ومواضيه انعمي بورود","ودائرة السوء استمري بدورة",46,"ه",1,0],["أركبوهن عناداً فوق أقتاب الجمال","وابنه السجاد قهراً كبلوه بالحديد",47,"د",1,0],["اركبوهن على عجف المطا","فوق قتبٍ الرحل من غير وطا",48,"ط",2,0],["أركبوهن النياق العجفا","وسروا فيها على غير رحال",49,"ل",1,0],["أَركزها فيهُم وَقالَ أُثبُتي","فَفي غَد مِن تَحتك المحشر",50,"ر",1,0],["اِركَبِ الخافِقينَ يا اِبنَ شَقيقٍ","فَإِلى أَشجَعَ بنِ عَمروٍ تَصيرُ",51,"ر",1,0],["أركانُه وسمَت بالعزِّ كيوانا","نادٍ قِرى الضيفِ مِن إحدى عوارفه",52,"ه",1,0],["أركبتني طرف العناية سابقا","فأجلت من غرر المديح جيادها",53,"د",3,0],["أَركائب الأَشواق جدي في السرى","فَإِذا وصلت إِلى الأَحِبَّة عرّسي",54,"س",2,0],["إركب إذا دارت رَحَاهَا وَانزلِ","وَقُلْ إذا صَمَّ صَدَاها وَافْعَلِ",55,"ل",1,1],["اركبْ إلى المجدِ أنضاء الأعاصيرِ","وَجُبْ مع السَّعْد أحشْاءَ الدياجيرِ",56,"ر",1,1],["أركبوه ظهر صعب كلما","خر عنه لم يطق أن ينهضا",57,"ض",2,0],["أَركانُها كالأَعضا لِلإنسانِ","تَكبيرُها كالمُخِّ لِلسِّيقانِ",58,"ن",1,0],["أركبَهُمْ فوقَ الخُيولِ الصَّاهِلَهْ","وقد حَبَاهُمْ بالرِّضى أَوْفى صِلَهْ",59,"ه",1,0],["ارْكَبْ بحارَ العلم نحو المنى","وهذه سفينة الصَالح",60,"ح",1,0],["إركب لها صافنات الفلك مسرجة","فالريح تغنيك عن سوط وعن رسن",61,"ن",1,0],["أركبوهنَّ على عُجفِ المَطَا","وأداروهُنَّ في بُلدانها",62,"ن",3,0],["أركض برجلك يا همام ولا تخف","واستقل الأفراح واترك ما انقضا",63,"ض",2,0],["اركض بالرجل في طريق","بغير زاد بغير ماء",64,"ا",2,0],["اركب بهيم الليّل واستصغر ال","خطب الّذي تلقاهُ فهو يسير",65,"ر",1,0],["اركب الظهر واستعن بالحرائر","واستشر في النوى ظهور الأباعر",66,"ر",1,1],["أركب الصَّعْبَ والذّلولَ وأمشى","لا أُبالي بأيِّ نفسٍ أُخاطر",67,"ر",1,0],["أركبتهم لهم أسيافٍ مُهَنَّدَةٍ","كسوتَهُم بالدِّما أثوابَ فَرصادِ",68,"د",1,0],["أرْكَبتَهُ البحْرَ قصْداً أن تُبلِّغَهُ","من صهْوةِ المُلْكِ أسْنى كلّ مرْكوبِ",69,"ب",1,0],["أركان أبنيةٍ جدران أغميةٍ","صدور أنديةٍ أقمار أفلاك",70,"ك",1,0],["أركبتهم جُرْد الجيادِ وَصنتُهمْ","عَمّا يسوءُ وَذاك فعلٌ صالحُ",71,"ح",1,0],["أركَبتهُ وَأمسَكَت بِرِكَابٍ","وَعِنَانٍ وهَكَذَا الوُزَرَاءُ",72,"ا",2,0],["أَركان أَبياتها ما شاعها خللٌ","بَل زانَها الوَزن وَالأَحكام مَوقعها",73,"ع",3,0],["أَركانُها مُحكَمَة البِناء","بِطُرفِها تُشيرُ لِلسَّماء",74,"ا",2,0],["اركان مجد العرب منبع عزهم","اسماؤهم تغني عن التفسير",75,"ر",1,0],["أركان دينِ عن الأرجاس قد بعدوا","بل حزبه من جناب القدس قد قربوا",76,"ب",3,0],["أركبتَ رأْسَ سنان رأسَ ظالمها","عَدْلاً وكنتَ لوزْر غيرَ مُرتكبِ",77,"ب",1,0],["أركانُ مُلكٍ راسخٌ بنيانُهُ","سامٍ إلى زُهْرِ الكواكب صاعد",78,"د",1,0],["اركن إلى الله لا تركن إلى الناس","فاصغ انتبه لا تكن كالغافل الناسي",79,"س",2,1],["أرَكِّب في وهمي محيّا يشوقني","على قامة أولى به ثم أشبق",80,"ق",1,0],["أر كائب الأحباب ليتك","با لمحصب لم ترمى",81,"م",2,0],["اركض برجلك في الدما ثمّ انطلق","خلف المجرّة حاكمٌ وقضاءُ",82,"ا",2,0],["أركبُ من شوقي لكم قاربًا","من الخيالات إذا أركبُ",83,"ب",1,0],["ارْكُضْ بِرِجْلِكَ يا بُنيَّ فَرُبَّمَا","أَثَرٌ لِأَيُّوبٍ .. يَدُلُّكَ مَوْضِعَهْ",84,"ع",2,0],["اركب على اللي قنابلها من السلة","بمكبرات الصور في الجو جواله",85,"ل",2,0],["أركب على شقر المهار العسايف","وانطح وجيه القوم سابق ومسبوق",86,"ق",1,0],["أركب الصعب بقصيدة واهتوي طرد السراب","وأنتجي عذب المعاني وأتحاشى المبهمه",87,"م",2,0],["اركن عليهآ فوحة البن والهيل","خلّ المزآج يصير للجرح كآوي",88,"ا",3,0],["اركد والاوضآع عفويّه","شوف الطْفل ينخلق عآري",89,"ر",2,0],["أركيت دلّة مشآعر قلت تأمني","واسرجت فكري وطيفك روّح بخيلي",90,"ل",2,0],["اركزت رمحي في حشى مظلم الوقت","بأحيي صباحٍ قالوا الناس ميّت",91,"ت",1,1],["أركيت ظهري واسترحت وقلت في نفسي ببيع","صوتي لوحدي واختنقت ومت من قلّ الزحام!",92,"م",1,0],["أركب الجد فيه رحلي","ن كميتاً فأدهم اليعبوب",93,"ب",1,0],["أركب الجد فيه رحلين رحلي","ن أقاسيم شاعر موهوب",94,"ب",1,0],["اركعْ له في كل وقتٍ ركعةً","واسجدْ على سفَهِ الاغاني الهابطةْ",95,"ط",2,0],["ارْ كضِت ْ للمصْطرْ لِكيته ْ اشلكيته ْ ؟؟","امْكطع ْ عل َ أتراب ِ الكاظميه ْ",96,"ي",2,0],["إركبْ غرورَك واتركني ومنسأتي","ودعْ فؤادي يداوي جرحَ عاطفتي",97,"ت",2,1],["أركن من الأركان يا قومنا اجترى","على هدد أعمى وبالغ في الهدم",98,"م",1,0],["اِركعْ إليهم صاغراً","إيَّاك يوماً تنتصبْ",99,"ب",1,0],["اركض بعلمك هذا صيّبٌ هطلٌ","يربو به الحقُ والبرهانُ والعملُ",100,"ل",1,0],["اركض بشعرك نحو المجد تبلغه","نعْمَ الطموح ونعْمَ َالوعدُ والظفرُ",101,"ر",1,0],["اركض برجلك علّه بَرَدٌ","نهرُ الخلاص وسابغ الكرَم",102,"م",1,0],["اركض برجلك لاماءٌ ولا برَدٌ","إلا الغرامَ.. وثقبُ الكون سبّاقُ",103,"ق",1,0],["اركض بقلبك نحو الغيم مغتسلا","وانزع شغافك من وحشٍ ومن كمدِ",104,"د",1,0],["اركض مع الدنيا كما ركض دوار","ياما كسب زندي وياما غدى لي",105,"ل",2,0],["أركضُ كالناعور ِ .. لكنني","أدورُ حولي .. ويدورُ المكانْ",106,"ن",1,0],["اركض بخيلك إن النيل مغتسلُ","ما أطيب النيل مشروباً ومغتسلا",107,"ل",2,0],["اركي عليها النار وازيد بني","اشرب مراره بالرضى والمغاصيب",108,"ب",1,0],["اركزت فعلك في قلوب الأقاويل","في راس مجدك كل قلب نحرته",109,"ت",2,0],["ارك بقلبي بت غير موسوس","أما لك فيه من نديم ومؤنس؟",110,"س",1,1],["أركانُ بنْياني مُوطَّدة ٌ","و