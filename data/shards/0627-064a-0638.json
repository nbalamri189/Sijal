{"poems":[[93,"هدايا الناس من زهر الجنان","https://www.aldiwan.net/poem11187.html","الوافر"],[88,"للمسلمين على نزورة وفرهم","https://www.aldiwan.net/poem44431.html","الكامل"],[51,"ما كنت في بخس الجزاء بمشبه","https://www.aldiwan.net/poem8510.html","الكامل"],[51,"طرقت أسماء والركب هجود","https://www.aldiwan.net/poem61906.html","الرمل"],[51,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[51,"رمين فؤادي من عيون الوصاوص","https://www.aldiwan.net/poem64935.html","الطويل"],[51,"سمعا أبا إسحق إنك ماجد","https://www.aldiwan.net/poem66524.html","الكامل"],[85,"لا والقوام الذي والأعين اللاتي","https://www.aldiwan.net/poem7794.html","البسيط"],[85,"رمضان ولى هاتها يا ساقي","https://www.aldiwan.net/poem63705.html","الكامل"],[45,"بعينيك ضوء الأقحوان المفلج","https://www.aldiwan.net/poem62674.html","الطويل"],[105,"قومي أهاب من الحياة بشير","https://www.aldiwan.net/poem42068.html","الكامل"],[105,"قل ما أردت فما عليك جناح","https://www.aldiwan.net/poem42081.html","الكامل"],[105,"وفد نجران إن أردت الرشادا","https://www.aldiwan.net/poem44017.html","الوافر"],[105,"قل ما أردت فما عليك جناح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55078&r=&rc=248",""]],"verses":[["أَيَظْفَرُ فِي الكَرَائِمِ مِنْ حِجَارٍ","بِلُطْفِ الحَسِّ أَوْ ظَرْفِ المَعَانِي",0,"ي",1,0],["أيظنّ ذو عقل بأنّ بناءها","شيء لشرط الواقفين منافي",1,"ي",1,0],["أيظنُّ غِيبتَهُ تُفطِّر صائماً","قُبحاً له ولظنِّه المكذوبِ",2,"ب",1,0],["أيُّ ظِلٍّ من نعيم فاءَ لي","ليلتي لوْ كان للظلِّ ركودُ",3,"د",1,0],["أيظلمني يا للبرية خالدٌ","نعم إنه أعلى قروناً وأقهر",4,"ر",1,0],["أيظلمني من ليس في الأرض غيره","إذا نيصَ من ظُلمٍ مَناصٌ لنائص",5,"ص",1,0],["أيظلُّ مدحي في مقام مبارزٍ","وترى هجائي في مُغار كَمين",6,"ن",1,0],["أيظهر النحس أم يبدو له ذنب","والسعد منك بأقمار وهالات",7,"ت",1,0],["أَيَظَلُّ بَعضُهُمُ لِبَعضٍ خاذِلاً","وَيُقالُ شَعبٌ في الحَضارَةِ راقي",8,"ق",2,0],["أَيَظلِمُني المُستَضعَفونَ وَقَد رَأَوا","تَهَجُّمَ ظَلّامٍ مَتى يَكوِ يُنضِجِ",9,"ج",1,0],["أَيظلُّ جَدُّ الغَربِ يَدأبُ صَاعِداً","والشّرقُ مَطويُّ الجَناحِ كَسيرُ",10,"ر",1,0],["أَيَظلُّ هُورُ على الكِنانةِ نَاعياً","فَيُقالُ غَنَّى البُلبلُ الصَّدّاحُ",11,"ح",1,0],["أيظنُّ المسيحَ عَبْداً وقد كا","ن إلهاً أتى يدينُ العِبادا",12,"د",2,0],["أيظل هور على الكنانة ناعبا","فيقال غنى البلبل الصداح",13,"ح",1,0]]}