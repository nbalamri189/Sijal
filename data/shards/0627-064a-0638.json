{"poems":[[95,"هدايا الناس من زهر الجنان","https://www.aldiwan.net/poem11187.html","الوافر"],[90,"للمسلمين على نزورة وفرهم","https://www.aldiwan.net/poem44431.html","الكامل"],[53,"ما كنت في بخس الجزاء بمشبه","https://www.aldiwan.net/poem8510.html","الكامل"],[53,"طرقت أسماء والركب هجود","https://www.aldiwan.net/poem61906.html","الرمل"],[53,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[53,"رمين فؤادي من عيون الوصاوص","https://www.aldiwan.net/poem64935.html","الطويل"],[53,"سمعا أبا إسحق إنك ماجد","https://www.aldiwan.net/poem66524.html","الكامل"],[87,"لا والقوام الذي والأعين اللاتي","https://www.aldiwan.net/poem7794.html","البسيط"],[87,"رمضان ولى هاتها يا ساقي","https://www.aldiwan.net/poem63705.html","الكامل"],[47,"بعينيك ضوء الأقحوان المفلج","https://www.aldiwan.net/poem62674.html","الطويل"],[107,"قومي أهاب من الحياة بشير","https://www.aldiwan.net/poem42068.html","الكامل"],[107,"قل ما أردت فما عليك جناح","https://www.aldiwan.net/poem42081.html","الكامل"],[107,"وفد نجران إن أردت الرشادا","https://www.aldiwan.net/poem44017.html","الوافر"],[107,"قل ما أردت فما عليك جناح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55078&r=&rc=248",""],[119,"ايظلمني الزمان وانت فيه","https://www.aldiwan.net/poem41190.html","عموديه"],[146,"ألكم إلى رد الشباب سبيل","https://www.aldiwan.net/poem58447.html","الكامل"],[164,"إليك وإلا ضيع الحزم أَهله","https://www.aldiwan.net/poem58774.html","الطويل"],[214,"لحظ يسبيك مقلده","https://www.aldiwan.net/poem13325.html","المتدارك"],[257,"أما وجفونك المرضى الصحاح","https://www.aldiwan.net/poem1418.html",""],[266,"منهل دمع المحب من دمه","https://www.aldiwan.net/poem38141.html","المنسرح"],[266,"أيظن بي أني رنا أو مالا","https://www.aldiwan.net/poem38210.html","الكامل"],[371,"أنوما وألحاظ الخطوب سواهر","https://www.aldiwan.net/poem17319.html","الطويل"],[409,"أي ظرف نصفه مظروفه","https://www.aldiwan.net/poem33469.html","الرمل"],[409,"لله درك فارس العلماءكم","https://www.aldiwan.net/poem33490.html","الكامل"],[543,"إني بعثت لسيدي بكتابي","https://www.aldiwan.net/poem48294.html","عموديه"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87109","الطويل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39099","السريع"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39104","السريع"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39107","السريع"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39105","السريع"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39102","السريع"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39100","السريع"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39103","السريع"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39106","السريع"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39098","السريع"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39101","السريع"],[357,"","https://poetry.dctabudhabi.ae/diwan/poem/142216","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62557","الكامل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61052","الرمل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76657","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53121","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53107","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77284","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77281","الكامل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133974","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74051","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108292","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131046",""],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105570","الوافر"],[4047,"","https://poetry.dctabudhabi.ae/diwan/poem/144065","الرجز"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73123","الكامل"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147311","الكامل"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147301","الرمل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72846","الكامل"],[4691,"خذ ما تريد لك الفدا","https://www.poetsgate.com/ViewPoem.aspx?id=125341",""],[4858,"شوق وحنين إلى فلذات كبدي","https://www.poetsgate.com/ViewPoem.aspx?id=33747",""],[4858,"آسادٌ في الأسر","https://www.poetsgate.com/ViewPoem.aspx?id=137593",""],[4858,"فرعون زال","https://www.poetsgate.com/ViewPoem.aspx?id=138195",""],[4859,"كورونا","https://www.poetsgate.com/ViewPoem.aspx?id=210929",""],[4935,"شرف الرجال فضائل العرفان","https://www.poetsgate.com/ViewPoem.aspx?id=129366",""],[4954,"هلَكَ الفُؤادُ","https://www.poetsgate.com/ViewPoem.aspx?id=208897",""],[4968,"خمور القريض2","https://www.poetsgate.com/ViewPoem.aspx?id=206758",""],[5121,"قَلَمِي","https://www.poetsgate.com/ViewPoem.aspx?id=33498",""],[5121,"مُسْكِرَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=33588",""],[5136,"أسموط در فصلت بالعسجد","https://www.poetsgate.com/ViewPoem.aspx?id=121799",""],[5353,"محمد (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=212456",""],[5459,"إصباح","https://www.poetsgate.com/ViewPoem.aspx?id=200151",""],[5781,"أُنْثاكَ في العشق!","https://www.poetsgate.com/ViewPoem.aspx?id=208932",""],[5956,"قال لي قلبها","https://www.poetsgate.com/ViewPoem.aspx?id=181958",""],[5956,"استرحام زوجة لزوجها","https://www.poetsgate.com/ViewPoem.aspx?id=182552",""],[5956,"أحببتكم في الله مِن مَحْيايا","https://www.poetsgate.com/ViewPoem.aspx?id=197927",""],[6273,"أسئلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78503&r=&rc=1",""]],"verses":[["أَيَظْفَرُ فِي الكَرَائِمِ مِنْ حِجَارٍ","بِلُطْفِ الحَسِّ أَوْ ظَرْفِ المَعَانِي",0,"ن",2,0],["أيظنّ ذو عقل بأنّ بناءها","شيء لشرط الواقفين منافي",1,"ف",2,0],["أيظنُّ غِيبتَهُ تُفطِّر صائماً","قُبحاً له ولظنِّه المكذوبِ",2,"ب",1,0],["أيُّ ظِلٍّ من نعيم فاءَ لي","ليلتي لوْ كان للظلِّ ركودُ",3,"د",1,0],["أيظلمني يا للبرية خالدٌ","نعم إنه أعلى قروناً وأقهر",4,"ر",1,0],["أيظلمني من ليس في الأرض غيره","إذا نيصَ من ظُلمٍ مَناصٌ لنائص",5,"ص",1,0],["أيظلُّ مدحي في مقام مبارزٍ","وترى هجائي في مُغار كَمين",6,"ن",1,0],["أيظهر النحس أم يبدو له ذنب","والسعد منك بأقمار وهالات",7,"ت",1,0],["أَيَظَلُّ بَعضُهُمُ لِبَعضٍ خاذِلاً","وَيُقالُ شَعبٌ في الحَضارَةِ راقي",8,"ق",2,0],["أَيَظلِمُني المُستَضعَفونَ وَقَد رَأَوا","تَهَجُّمَ ظَلّامٍ مَتى يَكوِ يُنضِجِ",9,"ج",1,0],["أَيظلُّ جَدُّ الغَربِ يَدأبُ صَاعِداً","والشّرقُ مَطويُّ الجَناحِ كَسيرُ",10,"ر",1,0],["أَيَظلُّ هُورُ على الكِنانةِ نَاعياً","فَيُقالُ غَنَّى البُلبلُ الصَّدّاحُ",11,"ح",1,0],["أيظنُّ المسيحَ عَبْداً وقد كا","ن إلهاً أتى يدينُ العِبادا",12,"د",2,0],["أيظل هور على الكنانة ناعبا","فيقال غنى البلبل الصداح",13,"ح",1,0],["ايظلمني الزمان وانت فيه","لمن فيه باذن الله غوث",14,"ث",1,1],["أيظُنُّ من عَقَر النجائبَ قومُه","أ الدماءَ جميعَها مطلولُ",15,"ل",1,0],["أيظلمني من يختشى كلَّ صيحةٍ","ويفزعه قلباً من الجبن ظلُّهُ",16,"ل",2,0],["ايظن بان اخشاه ولي","في الافق شهاب يرصده",17,"د",2,0],["أَيَظهَر في السَماءِ ضُحىً نُهاها","وَتَخفى وَهيَ طالِعَةٌ بِراحِ",18,"ح",1,0],["أي ظلوم سواك يبصره","لم يخف اللَه من تظلمه",19,"م",2,0],["أيظن بي أني رنا أو مالا","أن اتقى الصمصام والعسالا",20,"ل",2,1],["أَيَظهَرُ في الأَجفانِ عَقدٌ مُصَحَّحٌ","وَيَكمُنُ في الأَجفانِ سَيفٌ مُمَرَّضُ",21,"ض",1,0],["أي ظرف نصفه مظروفه","فهو مظروف له في كل حال",22,"ل",1,1],["أيظن بالخضر الكليم الميل للد","نيا ويحسب ما يراه فضولا",23,"ل",2,0],["أيَظَلُّ مولانَا يُمَتِّعُ طرفَه","في كلِّ منتَقبٍ بِوَردِ شبَابِ",24,"ب",1,0],["أَيَظلِمُ عينْ شيناً ولي مِنهُ حافظٌ","يردّ بِسَيف العَدل كُلَّ المَظالمِ",25,"م",1,1],["أيَظْهَرُ البَدْرُ عَلى بُعْدِهِ","وأنتَ بالقُرْبِ ولا تَطْلُعُ",26,"ع",1,0],["أيَظْهَرُ البَدْرُ عَلى بُعْدِهِ","وأنتَ بالقُرْبِ ولا تُشْرِقُ",27,"ق",1,0],["أيَظْهَرُ البَدْرُ عَلى بُعْدِهِ","وأنتَ بالقُرْبِ ولا تُحْسِنُ",28,"ن",1,0],["أيَظْهَرُ البَدْرُ عَلى بُعْدِهِ","وأنتَ بالقُرْبِ ولا تُنْعِمُ",29,"م",1,0],["أيَظْهَرُ البَدْرُ عَلى بُعْدِهِ","وأنتَ بالقُرْبِ ولا تُسْعِفُ",30,"ف",1,0],["أيَظْهَرُ البَدْرُ عَلى بُعْدِهِ","وأنتَ بالقُرْبِ ولا تَلْمَحُ",31,"ح",1,0],["أيَظْهَرُ البَدْرُ عَلى بُعْدِهِ","وأنتَ بالقُرْبِ ولا تُسْعِدُ",32,"د",1,0],["أيَظْهَرُ البَدْرُ عَلى بُعْدِهِ","وأنتَ بالقُرْبِ ولا تُفْضِلُ",33,"ل",1,0],["أيَظْهَرُ البَدْرُ عَلى بُعْدِهِ","وأنتَ بالقُرْبِ ولا تَظْهَرُ",34,"ر",1,0],["أيَظْهَرُ البَدْرُ عَلى بُعْدِهِ","وأنتَ بالقُرْبِ ولا تَغْرُبُ",35,"ب",1,0],["أيظل محتلا يئن مكبلا","والمسلمون يمينه ويساره",36,"ر",2,0],["أيظنني أن ليس لي","عون عليه مُسعِدُ",37,"د",1,0],["أَي ظَبي مِنهُم عاطيته","محض ودي وَاعتِقادي لَو صَفا",38,"ا",1,0],["أيظلم في عيني كذا قمر الدجى","وتنبو بكفي شفرة الصارم العضب",39,"ب",1,0],["أي ظباء بَظَّنا جفونها","عُفِّرن من دون الكثيب الأعفر",40,"ر",1,0],["أيظن أنا في فنائك نغتدي","متجردين من العمائم والفرا",41,"ر",2,0],["أَي ظَبيَةَ الشامِ قَد أَوقعتِ في شَرَك","لَيثاً بِمِصرَ حَليفَ السُقمِ وَالأَرَق",42,"ق",1,0],["أَيَظَلُّ يرسُفُ في البَلاءِ لِأَنَّهُ","أَعمى يُقادُ إِلى الفَناءِ وَأَبكَمُ",43,"م",1,0],["أي ظلم باق وأي اعتساف","أو ضلال في الحكم أو في التقاضي",44,"ض",2,0],["أيّ ظامٍ عاف المعين الزُلالا","وَمشوق سلا الحمى وَالغَزالا",45,"ل",2,1],["أي ظبي في مصر يشبه جيداً","لك أو كوكب يحاكي جمالك",46,"ك",1,0],["أيظنّ أنّا نرتقي إلا إذا","ضم العناصر ألفة ووئام",47,"م",1,0],["أيظمأ عند ساحله رجائي","ويرجع وهو صفر الكف خال",48,"ل",1,0],["أيُظلِمُ القلبُ وقد","أشرق صبحُ الشّعَرِ",49,"ر",1,0],["أَيظُنُّني ممَّن يَرُومُ سُلُوَّهُ","هَيهاتَ ذلكَ لا نراهُ ولا يُرَى",50,"ر",2,0],["أيظل قلبي بعد أن عرف الهدى","ويزول نور قد أظل جناني",51,"ن",2,0],["أيظل الظفر دوما للغنى","أيظل القهر زادا للفقير",52,"ر",1,0],["أيَظُنَّ أن انسى لجا","ذبتي لهُ الدُرَّ النظيم",53,"م",1,0],["أيظل يغرقني الهوى","وأروم رحمة ضفتيك",54,"ك",1,1],["أيظلُّ أبوكمْ في ظمأ","والنبْعُ لديكم والقطْرُ؟!",55,"ر",1,0],["أيظلُّ أبوكمْ في سَغَبٍ","والزّادُ لديكم والذُّخْرُ؟!",55,"ر",1,0],["أيظل السُّهدُ يُعذّبُهُ","والنومُ بقُرْبكمُ يُسْرُ؟!",55,"ر",1,0],["أيظلُّ أبوكم في لَهَفٍ","ويظلُّ يُحرّقُهُ الجمْرُ؟!",55,"ر",1,0],["أيظلّ بالقيد اللعين مكَبّلاً","والمسلمون لذُلّهم قد غُيّبوا؟",56,"ب",3,0],["أيظنّ ألاّ يبطش المولى به وهو الرّصد","فرعونُ زال ومَن بغى وتزول يا ذاك النّكَد",57,"د",1,0],["أيظل صفو الحب يرقص حولنا","أم أننا سنرافق الصابونا",58,"ن",2,0],["أيظن بالمال الغبي نباهة","بالزور والبهتان والعدوان",59,"ن",1,0],["أيْ ظالِمًا غرّتْه منّي لوْعةٌ","اِرْأفْ وآتِ الْقلْب ما لهُ قدْ صَبَا",60,"ب",2,0],["أيظن ان الشوق غادر مخدعي","بل ضاجعتني ناره وجحيمُها",61,"م",3,0],["أَيَظُنُّ مَنْ كَتَبَ الْقَصِيِدَ بليْلةٍ ؟","كَنَزِيِفِ عُمْرِ فَوَارِسٍ وَبَوَاسِلِ ؟!!",62,"ل",1,0],["أَيَظُنُّ مَنْ شَبَّ الْحَرِيِقَ بِمُنْيَتِي ؟","سَيَحِنُّ قَلْبُ مُخَدَّرٍ حِيِنَ انْكَوْى!!",63,"و",2,0],["ايظن حالي حال عن سنن الوفا","بظنون قوم ترحموها في اليد",64,"د",1,0],["أيظل هذا الفجرُ فينا أبكمٌ","كي ترتديهِ عُجاجة ٌخرساءُ",65,"ا",2,0],["أيَظنُّ أهل الشر أن الخير قد","ولّى ..فصارت تُزهق الأرواح ؟!",66,"ح",1,0],["أيظْمَأُ الصَّبْرُ أم أرويكَ من شُجُنٍ","قد بِتُّ أخجلُ من أُسطورةِ المَطَرِ",67,"ر",1,0],["أ يُظلِمُ خالٌ وتزهو نجوم","على سِحْنة من كواكب نورْ؟",68,"ر",1,0],["‏ ‏أ يظلُّ عمري جثة من دونما","‏ ‏ روح وأمعن في اتجاه الياس؟",69,"س",1,0],["أ يظل يبزغ لي خيالُك باسماً","يرجو يعيد بشاشتي وصبايا؟",70,"ا",3,0],["أيظل قِرني في ظِلال وريفه","وأظل يحرقني السّموم الصيهدُ؟",71,"د",1,0]]}