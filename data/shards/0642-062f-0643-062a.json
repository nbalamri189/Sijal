{"poems":[[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[53,"وقينة أبرد من ثلجه","https://www.aldiwan.net/poem9259.html","السريع"],[87,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[46,"قد عرفنا دلائل المنع أو ما","https://www.aldiwan.net/poem29711.html","الخفيف"],[83,"قد كتب الحسن على خده","https://www.aldiwan.net/poem61469.html","السريع"],[54,"يا ناظرا أودع قلبي الهوى","https://www.aldiwan.net/poem27313.html","الرجز"],[77,"قد كتبنا في قطعة من جراب","https://www.aldiwan.net/poem69101.html","الخفيف"],[52,"طال ليلي وبات قلبي جناحا","https://www.aldiwan.net/poem63974.html","الخفيف"],[48,"دمع على ما يفوت منسكب","https://www.aldiwan.net/poem23328.html","المنسرح"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[87,"شيَّعوا الشمس ومالوا بضحاها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9634&r=&rc=124",""],[159,"لا تعجبوا إن خانه صبره","https://www.aldiwan.net/poem55676.html","السريع"],[159,"مر بنا في قرطق أخضر","https://www.aldiwan.net/poem55682.html","السريع"],[208,"لي حبيب قد شفني وبراني","https://www.aldiwan.net/poem53169.html","الخفيف"],[237,"جسد ناحل وقلب جريح","https://www.aldiwan.net/poem14705.html","الخفيف"],[257,"عاتباه في فرط ظلمي وهجري","https://www.aldiwan.net/poem1426.html",""],[261,"مولاي قد أحسست لما أتى","https://www.aldiwan.net/poem48569.html","السريع"],[287,"وأهيف القد بالقلوب هفا","https://www.aldiwan.net/poem32705.html","المنسرح"],[325,"مشرقة الطلعة ذات البها","https://www.aldiwan.net/poem61780.html","البسيط"],[353,"قد كتبوا عنك ما تصنفه","https://www.aldiwan.net/poem20706.html","المنسرح"],[369,"هجر الراء واصل بن عطاء","https://www.aldiwan.net/poem61007.html","الطويل"],[408,"قد كتب الله على خده","https://www.aldiwan.net/poem46673.html","السريع"],[408,"يا دار سلمى بسفح ذي سلم","https://www.aldiwan.net/poem46982.html","المنسرح"],[409,"وافت هداياك التي مثلها","https://www.aldiwan.net/poem34101.html","السريع"],[463,"يا دار لهوي بالنجيل من قطن","https://www.aldiwan.net/poem55854.html","الرجز"],[520,"قدك مثل الغصن في اعتداله","https://www.aldiwan.net/poem12217.html","الرجز"],[532,"وقينة أحسن من لقياها","https://www.aldiwan.net/poem45991.html","الرجز"],[543,"قدك يا جميل","https://www.aldiwan.net/poem47914.html","عموديه"],[572,"السحر من ألفاظها الفاتكه","https://www.aldiwan.net/poem69557.html","الرجز"],[580,"وشادن كالهلال بل هو كالد ينار","https://www.aldiwan.net/poem2827.html","المنسرح"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53709","الخفيف"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96969","الكامل"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112464","الرمل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63904","السريع"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99984","المنسرح"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72265","الخفيف"],[1065,"","https://poetry.dctabudhabi.ae/diwan/poem/177918","السريع"],[1084,"","https://poetry.dctabudhabi.ae/diwan/poem/119091","السريع"],[1187,"","https://poetry.dctabudhabi.ae/diwan/poem/130348","السريع"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64725","المنسرح"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136366","الخفيف"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122857","الخفيف"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128060","السريع"],[2027,"","https://poetry.dctabudhabi.ae/diwan/poem/101860","السريع"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76014","الرمل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112668","الرجز"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99379","المنسرح"],[3471,"","https://poetry.dctabudhabi.ae/diwan/poem/56466","السريع"],[3684,"","https://poetry.dctabudhabi.ae/diwan/poem/198587",""],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128900","المجتث"],[4056,"","https://poetry.dctabudhabi.ae/diwan/poem/143578","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54478","الخفيف"],[4338,"","https://poetry.dctabudhabi.ae/diwan/poem/99879","السريع"],[4359,"","https://poetry.dctabudhabi.ae/diwan/poem/141148","السريع"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105178","السريع"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76769","السريع"],[1536,"مُتَيَّمٌ مُتْلَفٌ تَلَدُّدُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=85717",""],[5582,"طَرَقَ الطَّيْفُ وَقَدْ زارَ وِسادِي","https://www.poetsgate.com/ViewPoem.aspx?id=186881",""],[5616,"خيام","https://www.poetsgate.com/ViewPoem.aspx?id=203428",""],[5616,"أحوال","https://www.poetsgate.com/ViewPoem.aspx?id=205244",""],[572,"السِّحْرُ في ألحاظِهَا الفاتِكَهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9420&r=&rc=277",""]],"verses":[["قد كتبت في شكلِهِ حروف","تقري بما يقرى به الضيوف",0,"ف",1,0],["قد كَتبتْ في بدنٍ ناحلٍ","أسماءَ من لاعَبَها الفَحْجَهْ",1,"ج",2,0],["قَد كَتَبناها فَكانَت صورَةً","صَدرُها حَقٌّ وَحَقٌّ مُنتَهاها",2,"ا",3,0],["قَد كَتَبنا لَكَ الأَمانَ فَما تُس","أَلُها عُمرَ ذا الزَمانِ الطَويلِ",3,"ل",1,0],["قَد كَتَبَ الحُسنُ عَلى خَدِّهِ","إِنّا فَتَحنا لَكَ فَتحاً مُبين",4,"ن",1,1],["قَد كَتَبَ الدَمعُ عَلى خَدِّهِ","هَذا حَبيسٌ في سَبيلِ الهَوى",5,"و",2,0],["قد كَتبنا في قطعةٍ من جِرابِ","وجعَلنا المَقالَ غيرَ صَوابِ",6,"ب",1,1],["قَد كَتَمتُ الهَوى مَلِيّاً فَلَمّا","ضِقتُ ذَرعاً بِحُبِّ عَبدَةَ باحا",7,"ح",2,0],["قَد كَتَبَ اللَهُ لِلرَدى صُحُفاً","وَبانَ نَقطٌ لَها وَإِعجامُ",8,"م",1,0],["قد كتب اللّهُ على خَدِّه","خَطّاً يَبِينُ البُؤُسُ في سَطْرِهِ",9,"ر",2,0],["قد كتبتاها، فكانت صورة ً","صَدْرُها حقٌّ وحقٌّ مُنتهاها",10,"ا",3,0],["قَدْ كَتَبَ الدَّمْعُ عَلى خَدِّهِ","عُنْوانَ ما يُضْمِرُهُ سِرُّهُ",11,"ر",2,0],["قَدْ كَتَبَ الحُسْنُ عَلى خَدِّهِ","يا أَعْيُنَ الناسِ قِفي وانْظُري",12,"ي",1,0],["قد كتمنا الهوى مكاتمة الخو","ف عسى أن نفوز فوز البيان",13,"ن",1,0],["قَد كَتَمتُ الهَوى بِجُهدي وَإِن دا","مَ عَلَيَّ الغَرام سَوفَ أَبوحُ",14,"ح",1,0],["قَد كَتَمتُ الهَوى وان نَمَّ دَمعي","وَحَملتُ الجَفا وان عيلَ صَبري",15,"ر",2,0],["قد كتبت سطراً على عصعصي","هذا لسلطان الخرا ضافيه",16,"ف",3,0],["قَد كَتَبَ الحُسنُ بِالعِذارِ عَلى","كاغِدِ تُفّاحِ خَدِّهِ أَلِفا",17,"ف",2,0],["قَد كَتَبَ الحُسنَ عَلى وَجهِها","يا أَعيُنَ الناسِ قِفي وَاِنظُري",18,"ي",1,0],["قَد كَتبُوا عِنكَ ما تُصنِّفُهُ","قَالَ الأَديبُ المُحرِّرُ الفَهِمُ",19,"م",1,1],["قد كَتبنا إليكَ نَطلُبُ دِينا","رَيْن والرَّهْنُ قائمٌ بالإزاء",20,"ا",2,0],["قد كتبَ اللهُ على خدِّه","بالمسكِ سطراً دَقّ معناهُ",21,"ه",1,1],["قد كتموا مِن سَنَا فَضائِلهمْ","ما لَمْ يكنْ نورُه بمنكتمِ",22,"م",1,0],["قد كتب اللهو بخط الهوى","في باطن الفنجان هلا انتشيت",23,"ت",1,0],["قد كتبَ الشعْر على عارضِه","ما أقبح الإعراضَ بالوجه الحسنْ",24,"ن",1,0],["قد كتب الحسن على دلاله","هذا الذي يدعو إلى إدلاله",25,"ل",2,0],["قد كتب العتق على ذفراها","أي قلوصٍ راكبٍ تراها",26,"ا",3,0],["قد كتَبَ اللهُ على","مَن بِالصَّبَابَةِ ابتَلى",27,"ل",2,0],["قَدْ كَتَبَ الحُسْنُ عَلَى خَدِّهَا","كُلُّ دَمٍ أَنْتِ لَهُ سَافِكَهْ",28,"ك",2,0],["قد كتبَ الحُسْنُ تحت طُرَّته","غالٍ وفي صَحْنِ خدِّه غايه",29,"ه",1,0],["قد كتبت الكتاب ثم مضى اليو","م ولم أدر ما جواب الكتاب",30,"ب",1,1],["قد كتب لبعداء أقرب منجد","واليوم أبعدهم عن القرباء",31,"ا",2,0],["قد كتمت الوجد والمدمع باح","عندما سال نجيعاً أحمرا",32,"ر",2,1],["قد كَتَبَ الحسنُ على وجهِهِ","ما لا تملُّ العينُ منْ دَرْسِه",33,"س",2,0],["قَدْ كَتَبَ الْحُبُّ بِالسَّقَامِ لَهُ","نَظَّمَهُ بِمَنْ أَتَى يُفَنِّدُهُ",34,"د",2,0],["قد كتبنا إليك فأوضح لنا","الآن بماذا عن الكتاب تجيب",35,"ب",1,0],["قد كتب الحُسْنُ على خدِّه","خطاً له أَسودُ قلبي مِداد",36,"د",1,0],["قد كتب الدهر على خده","بالشعر هذا آخر الباطلِ",37,"ل",1,0],["قد كتب الشعر على خده","خفض فهذا آخر الدوله",38,"ه",1,0],["قَدْ كتبَ الحبُّ خدَّهُ فأَتتْ","مَدامعٌ فوقَ خَدِّهِ تَشْرحْ",39,"ح",1,0],["قد كتمت الهوى زمانا فلما","فاض دمعي هتكت معنى الهويه",40,"ي",2,0],["قد كتمت الهوى بمبلغ جهدي","فبدا منه غير ما كنت أبدي",41,"د",2,0],["قد كتب الله علينا الهوى","والذل فيه والعذاب الاليم",42,"م",1,1],["قد كتب الحسن على خده","سطراً من المسك قرأناه",43,"ا",2,0],["قَد كَتَمتُ عَنهُ حُبّي زَمناً","وَهوَ لا شَكَّ بحبّي يَعرِفُ",44,"ف",1,0],["قد كتبَ القتلُ عليهم فَمَضوا","إلى نعيم دائمٍ لما قَضوا",45,"ض",3,0],["قد كتب الحسن فوق عارضه","هذا مليح وحق من خلقه",46,"ق",2,0],["قد كتبَ الحُبُّ على جَبهتي","هذا قتيلٌ في سبيل الهوى",47,"ه",3,0],["قد كتب الحسنُ فيه سطراً","ويولج اللَّيل في النَّهارِ",48,"ر",1,0],["قد كتبوا بالدماء","فوق جباه الدهور",49,"ر",1,0],["قد كتمتُ الحبَّ حتى","لم أجدْ قلباً مُطيعا",50,"ع",2,1],["قد كتمتُ الهوى وباحَ به الدَّم","عُ فسرِّي ما بينَ مُفشٍ وكاتم",51,"م",1,0],["قد كتب الدهر على خدِّه","بالشعر والليل إذا يغشى",52,"ش",2,0],["قد كتم الحق وبان المحالْ","والغوث بالله الشديد المحالْ",53,"ل",1,1],["قد كتب الحسن على خده","هذا نبي فيكم ظاهر",54,"ر",1,0],["قد كتب الشَّعرُ على خده","أو كالذي مر على القريه",55,"ه",1,0],["قَدْ كَتَبَ الْحُبُّ بِالسَّقَامِ لَهُ","فَضَمَّهُ مَنْ أَتَى يُفَنِّدُهُ",56,"د",2,0],["قَدْكَ تَلْحِينِي وَنارُ الوَجْدِ فِي","كَبِدِي مُسْعَرَةٌ ذاتُ اتِّقادِ",57,"د",1,0],["قد كتبنا على التوابيت حتى","قد سخرنا من حرفنا المومياء!!",58,"ا",2,0],["قد كتَبْنا على النجومِ حكايا","نا وسِرْنا كأنَّنا الأمثالُ",59,"ل",1,0],["قد كَتَبَ الحُسْنُ على خدّهَا","طُلَّ دَمٌ أنتِ لهُ سافِكَهْ",60,"ك",2,0]]}