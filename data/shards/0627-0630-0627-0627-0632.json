{"poems":[[55,"لأي صنائعه أشكر","https://www.aldiwan.net/poem30454.html","المتقارب"],[55,"أبينتها أم ناكرتك شياتها","https://www.aldiwan.net/poem30677.html","الطويل"],[9,"غشيت لليلى بليل خدورا","https://www.aldiwan.net/poem21941.html","المتقارب"],[85,"سلو البارق النجدي من علمي نجد","https://www.aldiwan.net/poem54324.html","الطويل"],[29,"أهاج الشوق معرفة الديار","https://www.aldiwan.net/poem5744.html","الوافر"],[47,"مع الدهر ظلم ليس يقلع راتبه","https://www.aldiwan.net/poem10905.html","الطويل"],[47,"لديك هوى النفس اللجوج وسولها","https://www.aldiwan.net/poem65582.html","الطويل"],[63,"أتكتم أسرار الهوى أم تذيعها","https://www.aldiwan.net/poem51571.html","الطويل"],[51,"أما والذي يحيى به ويمات","https://www.aldiwan.net/poem10837.html","الطويل"],[52,"أحبى فيم خليت","https://www.aldiwan.net/poem64745.html","الهزج"],[119,"دع الفكر واصبر فالزمان صعائبه","https://www.aldiwan.net/poem41944.html","الطويل"],[257,"أبى جلد أن أحمل البين والقلى","https://www.aldiwan.net/poem1415.html",""],[280,"غزو على النصر والتمكين منشؤه","https://www.aldiwan.net/poem25646.html","البسيط"],[303,"أبيني هل لوصلك من سبيل","https://www.aldiwan.net/poem36795.html","عموديه"],[411,"إذا ازدرى ساقط كريما","https://www.aldiwan.net/poem49556.html","مخلع البسيط"],[445,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[447,"أخي ولدي ما بال قلبك لاه","https://www.aldiwan.net/poem14433.html","الطويل"],[454,"تحلو الترانيم","https://www.aldiwan.net/poem985.html",""],[518,"إذا ازداد رعيا للهوى زدته هوى","https://www.aldiwan.net/poem67723.html","الطويل"],[541,"أشاقك بالملا دمن عواف","https://www.aldiwan.net/poem23849.html","الوافر"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104623","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59806","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25352","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64770","الطويل"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73983","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49943","الطويل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95503","الطويل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82515","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79810","الطويل"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87902","البسيط"],[1749,"","https://poetry.dctabudhabi.ae/diwan/poem/96399","المتقارب"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106703","الطويل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46450","الطويل"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143012","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27231","البسيط"],[3002,"","https://poetry.dctabudhabi.ae/diwan/poem/73570","الوافر"],[3217,"","https://poetry.dctabudhabi.ae/diwan/poem/203956","الوافر"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45743","الطويل"],[3706,"","https://poetry.dctabudhabi.ae/diwan/poem/116586","الوافر"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132156","الوافر"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59459","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135498","الطويل"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2539","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102935","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77088","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94412","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139514",""],[5817,"حماة العلم","https://www.poetsgate.com/ViewPoem.aspx?id=199671",""],[454,"تحلو الترانيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82671&r=&rc=35",""]],"verses":[["إِذا اِزدَحَمَت فيهِ أَلحاظُنا","وَقَد ضَمَّ أَعطافَهُ المَحضَرُ",0,"ر",1,0],["إِذا أَزمَعَت إِزماعَةَ الجِدِّ لَم تُبَل","أَفِتيانُها الباكونَ أَم فَتَياتُها",1,"ت",3,0],["إِذا اِزدَحَمَت في المَكانِ المَضي","قِ حَتَّ التَزاحُمُ مِنها القَتيرا",2,"ر",2,0],["إذا ازدحموا يوماً على الماء أسوة","فما ازدحموا إلاَّ على مورد المجدِ",3,"د",1,0],["إِذا اِزدادَ العَمونَ عَمىً عَرَفتُم","هُدى الإِسلامِ واضِحَةَ المَنارِ",4,"ر",1,0],["إِذا اِزدادَ شَغباً كانَ والي قِراعِهِ","مَلِيّاً لَهُ بِالفَضلِ حينَ يُشاغِبُه",5,"ب",2,0],["إِذا اِزدَحَموا قُدّامَهُ وَوَراءَهُ","مَشَوا مِشيَةً يَأبى الأَناةَ عَجولُها",6,"ل",3,0],["إذا ازدَحَمَتْ فيها السيوفُ حَسبِتَها","يَنابيعَ ماءٍ ضاقَ عنعا وسيعُها",7,"ع",3,0],["إِذا اِزدَدتَ مالاً قُلتَ مالي وَثَروَتي","وَمالَكَ إِلّا اللَهُ وَالحَسَناتُ",8,"ت",1,0],["إِذا أَزمَعتُ أَن أَنظُرَ ف","ي الحاجَةِ أَنسيتُ",9,"ت",1,0],["إذا أزمة زادت وكرب تكاثرت","مصائبه والخطب عمت نوائبه",10,"ب",2,0],["إِذا اِزدرتُ وَجداً زادَ صداً وَكُلَّما","تَذلّلتُ مِن فَرط الغَرام تَدلّلا",11,"ل",2,0],["إِذا ازْدَهى بِكَميٍّ ظَلَّ يَصْرَعُه","أحْظَاهُ مَا فَاتَ للمَقْدُور يُخطِئُهُ",12,"ا",2,0],["إذا أزمعتِ مَنْعَ الوصلِ عنّي","فإني منك راضٍ بالقليل",13,"ل",1,0],["إذا ازدرى ساقِطٌ كَريماً","فلا يَطولَنَّ ضِيقُ صَدْرِهْ",14,"ه",1,1],["إِذَا ازْدَحَمُوا فِي ضَنْكِ شِرْبِي تَمَثَّلُوا","بأَسْباطِ مُوسى حولَ منفَجَرِ الصَّخْرِ",15,"ر",1,0],["إِذا ازددت خوفاً زادَني الخوف رغبة","وإِن زادَ ذكري فيك زاد ولاه",16,"ه",1,0],["إذا ازدهت ببني مكتوم غرته","فالتاج يزدان فيه الدر والذهب",17,"ب",1,0],["إذا ازداد رعياً للهوى زدته هوىً","وضني به مقدار هذين يضعف",18,"ف",1,1],["إِذا اِزدَلَفوا لَنا يَوماً دَلَفنا","إِلى هاماتِهِم أَيَّ اِزدِلافِ",19,"ف",1,0],["اذا ازدحمت في مَعرَكِ الموتِ برهةً","مركضَّةً في الفرِّ طوراً وفي الكَرِّ",20,"ر",1,0],["إذا أزمة شدَّت عليك خناقها","وضاقَت فلم تلف لنفسك مخرجا",21,"ج",2,1],["إِذا ازْدَهَتْهُ رِيحُ غَيْمٍ أَوْ شَبَمْ","طارَ العَدَوْلِيُّ كَأَقْحافِ البُرَمْ",22,"م",1,0],["إِذا ازْورَّ عَنّي وَالنَّعِيمُ يُمدُّني","ظَنَنْتُ زُلالَ الماءِ مُهْلاً مُكَدَّرا",23,"ر",2,0],["إذا ازور سخطاً أو تلفت راضياً","أمات وأحبا بالقطوب وبالبشر",24,"ر",1,0],["إذا ازمعَ الرّاجي سُلوكاً لحاجةٍ","رآى سُبل المعروف نحوك وضَّحا",25,"ح",2,0],["إذا أزمة ضاقت بها حيلُ الورى","وطالَعَها هانت وذابت من الرعبِ",26,"ب",1,0],["إِذا أزموا ألقوا فُضولَ حِبائِهِم","وَخَلّوا صُروف الدَّهر نَفري وَتجرحُ",27,"ح",1,1],["إذا ازدحموا حشداً على نَقع فَيلقٍ","رأيت على اللَّيل النهار تكوَّرا",28,"ر",2,0],["إذا ازدَهَى المرءُ بالجسم الجميل ولم","يُزهِر فهو أَشنعُ المخلوق من عَلَمِ",29,"م",1,1],["إذا أزْبَدَتْ مِن تَبارِي المَطِ","يِّ خِلْتَ بها خَبَلاً أو جُنونا",30,"ن",2,0],["إذا ازدَلَفَ الراجُونَ منكم بصَالِحٍ","فإن متَاتِي عِندَكَ الحمدُ والشُّكرُ",31,"ر",1,0],["إِذا إِزداد طَعناً لاءمَ الدَهر سمتَه","وَيَطعنُ قَصداً وَالطِعان صِداف",32,"ف",1,0],["إذا أزبدتْ سيارتي في صعودها","تخلَّف عنها ثابتاتٌ وخنَّسُ(3)",33,"س",1,0],["إذا أزال صدى الأكوان واتّحدتْ","صفاتُه بصفات الحقُّ فاعتبرا",34,"ر",2,0],["اذا ازدحمت هموم الصدر قلنا","عسى يوماً يكون لها انفراج",35,"ج",1,0],["إذا ازدحم الكِرامُ على المعالي","تنحى الباهليُّ عن الزِّحام",36,"م",1,0],["إِذا اِزدَهت الأَيّام كُنتُم صباحها","وَكانَت أَعاديكم ظَلام الغَياهب",37,"ب",1,0],["إذا ازدحم الكرامُ على المعالي","تنحّى الباهليُّ عَنِ الطعامِ",38,"م",1,0],["إذا ازدحم الرفاق بكل سوقٍ","فأسبقها الرفيق المستعدُ",39,"د",1,0],["إذا أزْمَعن قَتلَ عَميدِ قَومٍ","كشَفْنَ عن الترائبِ والنُّهودِ",40,"د",1,0],["إذا ازدادت الأنثى من الشحم أحزنت","لضرتها أو من تحاسدها حسدا",41,"د",2,1],["إِذا اِزوَرَّ مِن وَقعِ الرِماحِ زَجَرتُهُ","وَقُلتُ لَهُ اِرجِع مُقبِلاً غَيرَ مُدبِرِ",42,"ر",1,0],["إذا أزور بأس أو تنمر حادث","فإنك رام كل جزع بثاقب",43,"ب",1,0],["إِذا اِزدَراني جُهول قُلت لا عَجَب","إِذ عَربَة الدارِ تَذوي زَهرَةَ الرجل",44,"ل",1,0],["إذا ازدحمت كل العفاة ببابهِ","يُسَرُّ وإلّا جاءَ يبدي التأَسُّفا",45,"ف",2,0],["إذا ازددت بعداً منك فضلاً ومنَّة","علىَّ تزدني منك يا راحمي قربا",46,"ب",2,0],["إذا ازدان الفتى بجميل خُلْقٍ","وخلَّا عنه العابَ البناتِ",47,"ت",1,1],["إذا ازدهت ببني مكتوم غرتها","فالتاج يزدان فيه الدر والذهب",48,"ب",1,0]]}