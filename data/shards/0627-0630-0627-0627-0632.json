{"poems":[[53,"لأي صنائعه أشكر","https://www.aldiwan.net/poem30454.html","المتقارب"],[53,"أبينتها أم ناكرتك شياتها","https://www.aldiwan.net/poem30677.html","الطويل"],[9,"غشيت لليلى بليل خدورا","https://www.aldiwan.net/poem21941.html","المتقارب"],[83,"سلو البارق النجدي من علمي نجد","https://www.aldiwan.net/poem54324.html","الطويل"],[27,"أهاج الشوق معرفة الديار","https://www.aldiwan.net/poem5744.html","الوافر"],[45,"مع الدهر ظلم ليس يقلع راتبه","https://www.aldiwan.net/poem10905.html","الطويل"],[45,"لديك هوى النفس اللجوج وسولها","https://www.aldiwan.net/poem65582.html","الطويل"],[61,"أتكتم أسرار الهوى أم تذيعها","https://www.aldiwan.net/poem51571.html","الطويل"],[49,"أما والذي يحيى به ويمات","https://www.aldiwan.net/poem10837.html","الطويل"],[50,"أحبى فيم خليت","https://www.aldiwan.net/poem64745.html","الهزج"],[115,"دع الفكر واصبر فالزمان صعائبه","https://www.aldiwan.net/poem41944.html","الطويل"],[252,"أبى جلد أن أحمل البين والقلى","https://www.aldiwan.net/poem1415.html",""],[275,"غزو على النصر والتمكين منشؤه","https://www.aldiwan.net/poem25646.html","البسيط"],[298,"أبيني هل لوصلك من سبيل","https://www.aldiwan.net/poem36795.html","عموديه"],[405,"إذا ازدرى ساقط كريما","https://www.aldiwan.net/poem49556.html","مخلع البسيط"],[439,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[441,"أخي ولدي ما بال قلبك لاه","https://www.aldiwan.net/poem14433.html","الطويل"],[449,"تحلو الترانيم","https://www.aldiwan.net/poem985.html",""],[513,"إذا ازداد رعيا للهوى زدته هوى","https://www.aldiwan.net/poem67723.html","الطويل"],[536,"أشاقك بالملا دمن عواف","https://www.aldiwan.net/poem23849.html","الوافر"]],"verses":[["إِذا اِزدَحَمَت فيهِ أَلحاظُنا","وَقَد ضَمَّ أَعطافَهُ المَحضَرُ",0,"ر",1,0],["إِذا أَزمَعَت إِزماعَةَ الجِدِّ لَم تُبَل","أَفِتيانُها الباكونَ أَم فَتَياتُها",1,"ت",3,0],["إِذا اِزدَحَمَت في المَكانِ المَضي","قِ حَتَّ التَزاحُمُ مِنها القَتيرا",2,"ر",2,0],["إذا ازدحموا يوماً على الماء أسوة","فما ازدحموا إلاَّ على مورد المجدِ",3,"د",1,0],["إِذا اِزدادَ العَمونَ عَمىً عَرَفتُم","هُدى الإِسلامِ واضِحَةَ المَنارِ",4,"ر",1,0],["إِذا اِزدادَ شَغباً كانَ والي قِراعِهِ","مَلِيّاً لَهُ بِالفَضلِ حينَ يُشاغِبُه",5,"ب",2,0],["إِذا اِزدَحَموا قُدّامَهُ وَوَراءَهُ","مَشَوا مِشيَةً يَأبى الأَناةَ عَجولُها",6,"ل",3,0],["إذا ازدَحَمَتْ فيها السيوفُ حَسبِتَها","يَنابيعَ ماءٍ ضاقَ عنعا وسيعُها",7,"ع",3,0],["إِذا اِزدَدتَ مالاً قُلتَ مالي وَثَروَتي","وَمالَكَ إِلّا اللَهُ وَالحَسَناتُ",8,"ت",1,0],["إِذا أَزمَعتُ أَن أَنظُرَ ف","ي الحاجَةِ أَنسيتُ",9,"ت",1,0],["إذا أزمة زادت وكرب تكاثرت","مصائبه والخطب عمت نوائبه",10,"ب",2,0],["إِذا اِزدرتُ وَجداً زادَ صداً وَكُلَّما","تَذلّلتُ مِن فَرط الغَرام تَدلّلا",11,"ل",2,0],["إِذا ازْدَهى بِكَميٍّ ظَلَّ يَصْرَعُه","أحْظَاهُ مَا فَاتَ للمَقْدُور يُخطِئُهُ",12,"ا",2,0],["إذا أزمعتِ مَنْعَ الوصلِ عنّي","فإني منك راضٍ بالقليل",13,"ل",1,0],["إذا ازدرى ساقِطٌ كَريماً","فلا يَطولَنَّ ضِيقُ صَدْرِهْ",14,"ه",1,1],["إِذَا ازْدَحَمُوا فِي ضَنْكِ شِرْبِي تَمَثَّلُوا","بأَسْباطِ مُوسى حولَ منفَجَرِ الصَّخْرِ",15,"ر",1,0],["إِذا ازددت خوفاً زادَني الخوف رغبة","وإِن زادَ ذكري فيك زاد ولاه",16,"ه",1,0],["إذا ازدهت ببني مكتوم غرته","فالتاج يزدان فيه الدر والذهب",17,"ب",1,0],["إذا ازداد رعياً للهوى زدته هوىً","وضني به مقدار هذين يضعف",18,"ف",1,1],["إِذا اِزدَلَفوا لَنا يَوماً دَلَفنا","إِلى هاماتِهِم أَيَّ اِزدِلافِ",19,"ف",1,0]]}