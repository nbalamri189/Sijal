{"poems":[[79,"مولاي ست من الظلام مضت","https://www.aldiwan.net/poem36658.html","المنسرح"],[79,"دعاك بأقصى المغربين غريب","https://www.aldiwan.net/poem36715.html","الطويل"],[91,"حلمت بان الدهر لي يتبسم","https://www.aldiwan.net/poem44859.html","الطويل"],[35,"تروح سالما يا شبه ليلى","https://www.aldiwan.net/poem25830.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39625","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39593","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54640","الكامل"],[102,"قالت الضحيّة","https://www.poetsgate.com/ViewPoem.aspx?id=50170",""],[96,"الشّهيد","https://www.poetsgate.com/ViewPoem.aspx?id=13789",""],[2,"صَحا القَلبُ عن سلمى وأقصرَ باطِلُهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19479&r=&rc=5",""],[147,"طاول بهمتك الزمان وحيدا","https://www.aldiwan.net/poem11746.html","الكامل"],[147,"إن لم أقل فيك ما يردي العدى كمدا","https://www.aldiwan.net/poem11753.html","البسيط"],[147,"أما وظلك مما خفته وزر","https://www.aldiwan.net/poem11759.html","البسيط"],[147,"سل عن فضائلك الزمان لتخبرا","https://www.aldiwan.net/poem11760.html","الكامل"],[164,"أعن ملل خيالك لا يطيف","https://www.aldiwan.net/poem58766.html","الوافر"],[182,"ذهاب أضاع إيابه","https://www.aldiwan.net/poem50692.html","المتقارب"],[275,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[290,"بشرى السلامة أشرقت","https://www.aldiwan.net/poem39378.html","مجزوء الكامل"],[302,"يا صاح هذا المشهد الأقدس","https://www.aldiwan.net/poem33243.html","السريع"],[354,"بي للورى فليطل العجب","https://www.aldiwan.net/poem15535.html","السريع"],[376,"بين نشو الغنا ونشو المعالي","https://www.aldiwan.net/poem57181.html","الخفيف"],[409,"لك الله هذا غاية الخلق يا قلبي","https://www.aldiwan.net/poem34141.html","الطويل"],[415,"قمر إذا عاتبته شغفا به","https://www.aldiwan.net/poem32560.html","الكامل"],[445,"أرحلي محمول على العتق النجب","https://www.aldiwan.net/poem34886.html","الطويل"],[447,"عذاب الهوى في قلب من رامه عذب","https://www.aldiwan.net/poem14329.html","الطويل"],[447,"وداعا أيها الشهر الوداعا","https://www.aldiwan.net/poem14377.html","الوافر"],[463,"أفلح قوم إذا دعوا وثبوا","https://www.aldiwan.net/poem56299.html","المنسرح"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83341","الطويل"],[622,"","https://poetry.dctabudhabi.ae/diwan/poem/130717","الوافر"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86846","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38335","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56682","المجتث"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115986","الكامل"],[1833,"","https://poetry.dctabudhabi.ae/diwan/poem/111111","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27341","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27164","المتقارب"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28059","الطويل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121198","البسيط"],[2769,"","https://poetry.dctabudhabi.ae/diwan/poem/98159","الكامل"],[2900,"","https://poetry.dctabudhabi.ae/diwan/poem/102178","الكامل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112294","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88974","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86340","الوافر"],[3663,"","https://poetry.dctabudhabi.ae/diwan/poem/111142","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91703","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91184","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216508",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131211",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111467","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69978","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119622","المتقارب"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127236","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133088","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33187","المنسرح"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72356","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139521",""],[4767,"عقد الجمان","https://www.poetsgate.com/ViewPoem.aspx?id=178711",""],[4830,"شعرُ صبابتي","https://www.poetsgate.com/ViewPoem.aspx?id=209132",""],[4578,"أصم ناعيك سمع الفضل حين نعى","https://www.poetsgate.com/ViewPoem.aspx?id=49472",""],[4955,"لأن الحق يا ولدي سينتصر","https://www.poetsgate.com/ViewPoem.aspx?id=204352",""],[5002,"رجع ُ الصَّدى....","https://www.poetsgate.com/ViewPoem.aspx?id=210619",""],[5038,"سر فنجاني","https://www.poetsgate.com/ViewPoem.aspx?id=189965",""],[5131,"ودَّعتُهُ وعلى فؤادي حسرةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=175584",""],[5277,"الذهول","https://www.poetsgate.com/ViewPoem.aspx?id=184871",""],[5295,"أمير الروح","https://www.poetsgate.com/ViewPoem.aspx?id=210573",""],[5302,"كن لي رفيق الروح","https://www.poetsgate.com/ViewPoem.aspx?id=200552",""],[5314,"رسول الله وانبثقت حياة","https://www.poetsgate.com/ViewPoem.aspx?id=214860",""],[5430,"أتاك العيد","https://www.poetsgate.com/ViewPoem.aspx?id=1460",""],[243,"حقائق كالخيال","https://www.poetsgate.com/ViewPoem.aspx?id=50559",""],[5688,"وداعا","https://www.poetsgate.com/ViewPoem.aspx?id=200896",""],[5704,"شموس الحق","https://www.poetsgate.com/ViewPoem.aspx?id=200002",""],[402,"أمشيع أنا كل يوم ذاهبا","https://www.poetsgate.com/ViewPoem.aspx?id=35298",""],[5844,"كان لها عنوان","https://www.poetsgate.com/ViewPoem.aspx?id=139719",""],[5956,"الذبحُ الرَّاحم ‏","https://www.poetsgate.com/ViewPoem.aspx?id=183394",""],[6124,"يشاطر الهدب دمعتي","https://www.poetsgate.com/ViewPoem.aspx?id=121832",""],[6124,"بريء","https://www.poetsgate.com/ViewPoem.aspx?id=159472",""],[6125,"سلامٌ لقلبي المُفَدَّى سلامْ","https://www.poetsgate.com/ViewPoem.aspx?id=212867",""],[6225,"تظلُّم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80898&r=&rc=167",""],[5561,"حلو الكلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86130&r=&rc=4",""]],"verses":[["فَلَيْلَةُ المَوْلِدِ الكريمِ على","تَقْواكَ للّهِ أصْدَقُ الحُجَجِ",0,"ج",1,0],["فَلَيْلَتُهُ لَيْلُ السَّلِيمِ وَيَوْمُهَا","إِذَا شُدَّ لِلشَّوْقِ الْعِصَابُ عَصِيبُ",1,"ب",1,0],["فليلي حتى يأتي اليوم اليل","ويومي حتى يأتي الليل ايوم",2,"م",1,0],["فَلَيلى أَنقَذَتكَ مِنَ المَنايا","وَفَكَّت عَن قَوائِمِكَ الكُبولا",3,"ل",2,0],["فليُلقِ بالمجداف من كفِّهِ","وليتركِ الموجَ طليقَ الرِّغابْ",4,"ب",1,0],["فَليُلْقِ أروعَ ما أبدعتَ من خُطبٍ","جلالُكَ الأبديُّ المفردُ المثَلِ",5,"ل",1,0],["فَليَلْقَ عِنْدَ إِلهِهِ مَا لَمْ يَكُنْ","لِيُنَالَ فِيهَا مِنْ مُنَىً وَرَغَائِبَا",6,"ب",2,0],["فليلبّيه ثالث : ليت أنّي","نقطة فوق خدّها مستديره",7,"ر",2,0],["فليلته صبح وعسرته غنى","وأحزانه نعمى وآهاته شعر",8,"ر",1,0],["فليلاً علفناهُ، فأكملَ صنعهُ","فتمَّ، وعزتهُ يداهُ وكاهلهْ",9,"ل",2,0],["فَليَلبَثوا حَيثُ اِستَقَرَّت دارُهُم","وَأَرَدتَ مادامَ الحَديدُ حَديدا",10,"د",2,0],["فَليَلتَمِس رافِعٌ ما عَزَّ مَطلَبُهُ","فَلَن يُدافَعَ مَن تُضحي لَهُ سَنَدا",11,"د",2,0],["فَليَلزَموا اللَقَمَ الوَضّاحَ إِن طَلَبوا","أَمناً فَحَزمُكَ لا يُمشى لَهُ الخَمرُ",12,"ر",1,0],["فَليَلحَقِ النُعمانَ في سُلطانِهِ","بَل فَليَطُلهُ فَقَد عَلَوتَ المُنذِرا",13,"ر",2,0],["فليلي والنهار لفرط شوقي","فصولٌ ذا الشتاءُ وذا المصيفُ",14,"ف",1,0],["فليلي بَهيم كحزنِ اليتامى","وسعدي ذهابٌ أضاع إيابَهْ",15,"ب",2,0],["فليلةُ سعدي قد رأيتُ ظلامَها","ضياءً وفي آفاقها ألفُ نجمة",16,"ه",1,0],["فليلتقم صخراً كذو","ب بالاشاعة قد جهر",17,"ر",1,0],["فَليلُنا من نورِه مُقمِرٌ","وَيَومُنا من ضَوئه مُشمِسُ",18,"س",1,0],["فَلَيلُهُم عِندي نَهارٌ وَلي","فيهِ مَعاشُ بِالرِبا يَربو",19,"ب",2,0],["فليلحّ الزمانُ ما شاءَ في حا","لي فَما يَستَطيعُ تَغييرَ حالي",20,"ل",2,0],["فليلي نهار في السهاد وغيره النه","ار كئيب في سواد من الكرب",21,"ب",1,0],["فَليلْحَني مَن شاءَ فيهِ فَصَبوَتي","بهواهُ سُكرٌ لستُ مِنهُ مُفيقَا",22,"ق",2,0],["فَليلٌ إِلَى صُبحٍ وصبحٌ إِلَى دُجىً","وكَرْبٌ إِلَى رَوْحٍ وروحٌ إِلَى كَرْبِ",23,"ب",1,0],["فلي لفظ سحبان وقدر أسامة","وشيمة جساس إذا أنعل الركب",24,"ب",1,0],["فليل القدر تعدل ألف شهر","موفقةً لمجتهد أطعا",25,"ع",2,0],["فَلَيْلَةُ الحَرْىِ وهي جامدةٌ","له كيوم الجوزاءِ يلتهِبُ",26,"ب",1,0],["فَلَيلٌ وَبَدرٌ عِندَها ما هُما سِوى","سَوادِ مِدادٍ في بَياضِ مَهارِقِ",27,"ق",1,0],["فلي ليلٌ تكدرُهُ هُمومٌ","ولي دهرٌ تنغصهُ الليالي",28,"ل",2,0],["فَلَيل الأَماني بِالكَواكب مُشرق","وصُبح التَهاني بِالمَواهب مُسفر",29,"ر",1,0],["فَليَلقَها مِنكَ القَبولُ فَإِنّه","لَأَجلُّ شَيءٍ أَنتَ فيه راشحُ",30,"ح",1,0],["فليلهماني قليلاً","إني ضعيف البيان",31,"ن",1,0],["فليلقَ كلُّ مُدعّجٍ بلحاظهِ","وقوامِهِ عُريانَ يوم نِزالِه",32,"ل",2,0],["فليلتهب للدين قلب طالما","كان به ثلجاً شجي وليستعر",33,"ر",1,0],["فليلبس الولدُ المحفوظُ خرقَتنا","على الشروطِ التي ضمنتُها فيه",34,"ي",2,0],["فَلَيلِيَ مِن وَجهِها مُشرِقٌ","وَيَومِيَ مِن شَعرِها غاسِقُ",35,"ق",1,0],["فَلَيلى خَليلٌ حالَتِ الحَربُ دونَهُ","يُخَبِّرُ عَن لَيلى أَقاصٍ وَجُنَّبُ",36,"ب",1,0],["فليلة القدر خير في فضائلها","من الف شهر بها كم نال من طلبا",37,"ب",2,0],["فليلحقن بمن مضى متخلف","من بعده ولذهبن ونذهب",38,"ب",1,0],["فليلق كل مسدس ما لم يكن","شرواه يرقى الشعب فيه ويسعد",39,"د",1,0],["فَلَيلُهُم من شعاع البيض صُبحُهمُ","وصبحُهُم من دُخانِ الحَربِ كالقَتَمِ",40,"م",1,0],["فليلة القدر لي يوم البشير أتى","يا حبذا لك إصباحي وإمسائي",41,"ا",2,0],["فَلى لِم تَرنُ بِالاِلحاظِ اِلّا","رَأَيتُ العَقلَ فارَقني فَتاها",42,"ه",2,0],["فليلة قدر ليلتي بمديحكم","لأني إذا أحييتها يرفع القدر",43,"ر",1,0],["فَليلٌ حَيث نمسي في هَناءٍ","وَصبحٌ مثلما نَهوى يُنير",44,"ر",1,0],["فَليَلقَها وَفقَ الجَزا","بَعد المَآثر وَالمنح",45,"ح",1,0],["فليلق بين القدح والثناء","ما شاءت الدنيا من الجزاء",46,"ا",2,0],["فليلجوا في غيهم ما استطاعوا","إن رب الورى سريع الحساب",47,"ب",1,0],["فَلَيلَتُنا هَذي وَواحَظَّ مَن رَأَى","سَنَهلِكُ فيها أَو نَنالُ الأَمانِيا",48,"ي",2,0],["فَليلة انسهِ أَضحت نَهاراً","بِأَنوارِ تَرينا الجَنتينِ",49,"ن",1,0],["فلَيلاي قد أصبحت صبيتي","وقوت العيال غدت عَزَّتي",50,"ي",1,1],["فليلي ليل القوس من بعد بعدكم","وكم في فؤادي للحوادث من سهم",51,"م",1,0],["فليلها كالضحى نوراً ومكسبةً","ويومها لو ترى في ذي الدنا عجبا",52,"ب",2,0],["فليله ليلة الأسير كما","يبيت يخشاه في صباح غده",53,"د",2,0],["فليلمني من شاء أني موال","رافل من ولائهم بشفوف",54,"ف",1,0],["فليلوِ عنه عناناً من يسابقه","وليترك السعى من أودى به التعب",55,"ب",1,0],["فلَيلُ الانتظار طواه نور","من المولود مثل الصبح بانا",56,"ن",2,0],["فليلتَهِمْ جَسَدي لهيبُكَ طالما","سُكناكَ في روحي وقد ذَهَبَتْ مَعَكْ",57,"ك",1,0],["فليلزم النيل كسر القلب في كدرٍ","فقد مضى من به قد كان مرتفعا",58,"ع",2,0],["فليلُ الظُّلمِ مهما طالَ منحسرٌ","وغيثُ اليسرِ بعدَ العسرِ ينهمرُ",59,"ر",1,0],["فلِي لُثِّمَتْ دَاخِلِي بَهْجَةٌ","وقدْ فُطِمَتْ بَسْمَةٌ تَرْضَعُ",60,"ع",1,0],["فليلي كلُّهُ فزعٌ","وليلكَ نومهُ الْهاني",61,"ن",2,0],["فليلقِ من حقد افتراءً أننا","صرنا على حملِ المهانة أخبرا",62,"ر",2,0],["فَلَيْليَ مَدّ بِطَيْفِ الكرى","بِساطَ الوِصالِ وَقَدْ أقْبَلا",63,"ل",2,0],["فليلى سلَّمتني العرشَ طوعاً","وما لي فوق هذا العرشِ ضُرَّةْ",64,"ر",2,0],["فليلي إن أرخى سدولا فزعت في","جنوني إلى خل يحل بذاتي",65,"ت",2,0],["فَلَيْلَةَ قَدْ وُلِدْتَ بَثَثْتَ عِزّا","مَهِيبًا لَا يُرَامُ وَلَيْسَ غَبَّا",66,"ب",2,0],["فليلي دائمٌ أبداً","وضوءُ الفجرِ مندحرُ",67,"ر",1,0],["فليلق سازاك من يسمى ثمانية","غيري ويستوف أجر القبر حفار",68,"ا",2,0],["فليلي طويل قد تباطأ نجمه","وصبحي مرير والمآسيَ تتْبعه",69,"ع",2,0],["فليل الظلم مدحور بأرضي","وبات القهر منهزما وضيعا",70,"ع",2,0],["فليلق عند إلهيه ما لم يكن","لينال فيها من منى ورغائبا",71,"ب",2,0],["فليل البحر يُؤمن ليس إلا","وموج البحر أكثر منكَ عطفًا",72,"ف",2,0],["فلَيْلُك يا شياهي ليس ليلا","وصَحْوُكِ دائمٌ حتى تلبِّي..",73,"ب",2,0],["فَلَيْلَةً يَرْقُصُونَ مِنْ عَجَبٍ","وَلَيْلَةً مِنْ حِرَابِ أَنَّتِهَا",74,"ت",3,0],["فليلُ العشقِ يهواني","وجمرُ السعدِ سوَّاني.",75,"ي",1,0],["فليلي طويلٌ وبدري محاقٌ","ونوري ضبابٌ لبُعْدِ المُقامْ",76,"م",1,0],["فليلي دائم ٌ، نومي شريدٌ","حنيني لوعة ٌ، ندمي سعيرُ",77,"ر",1,0],["فليلك ليلي ويومك يومي","من الماء والطين جئنا بني",78,"ي",1,0]]}