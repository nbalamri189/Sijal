{"poems":[[55,"نظمنا نظام العقد ودا وألفة","https://www.aldiwan.net/poem29821.html","الطويل"],[74,"إنسان عيني بتعجيل السهاد بلي","https://www.aldiwan.net/poem19471.html","البسيط"],[53,"سقيا لعيش مضى ما فيه تكدير","https://www.aldiwan.net/poem64040.html","البسيط"],[64,"يا حادي الظعن رفقا إنك الجاني","https://www.aldiwan.net/poem52253.html","البسيط"],[107,"ديار مكة هذا خالد دلفا","https://www.aldiwan.net/poem44044.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55271","الرجز"],[92,"الذكرى أو دمعة تثيرها الكمنجة","https://www.poetsgate.com/ViewPoem.aspx?id=179143",""],[173,"العز ما خضعت لهيبته العدى","https://www.aldiwan.net/poem1618.html",""],[234,"شرى البرق فالتاع الفؤاد المعذب","https://www.aldiwan.net/poem51254.html","الطويل"],[237,"هيجت وجدي يا نسيم الصبا","https://www.aldiwan.net/poem14742.html","السريع"],[237,"تبدت لنا حزوى فهاج جواها","https://www.aldiwan.net/poem14831.html","الطويل"],[309,"بشر فؤادك بالنصيب الوافي","https://www.aldiwan.net/poem16794.html","الكامل"],[376,"توق إذا ما حرمة العدل جلت","https://www.aldiwan.net/poem57518.html","الطويل"],[463,"من موصل بالسؤال والقسم","https://www.aldiwan.net/poem55894.html","المنسرح"],[463,"ظن غداة الخيف أن قد سلِما","https://www.aldiwan.net/poem55900.html","الرجز"],[463,"هل تقبلون إنابة الدهر","https://www.aldiwan.net/poem56194.html","أحذ الكامل"],[466,"أرج النسيم فقلت نشر خميلة","https://www.aldiwan.net/poem16338.html","الكامل"],[484,"القول كالبرق والأعمال كالمطر","https://www.aldiwan.net/poem37185.html","البسيط"],[484,"من للثكالى وللجرحى وأيتام","https://www.aldiwan.net/poem37205.html","البسيط"],[484,"أرقت وما غير الشجون سمير","https://www.aldiwan.net/poem37571.html","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48508","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96726","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56241","الرجز"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136273","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136101","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136188","البسيط"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18481","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64604","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77770","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124717","السريع"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114700","البسيط"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96031","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27335","البسيط"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130807",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93905","البسيط"],[2888,"","https://poetry.dctabudhabi.ae/diwan/poem/46729","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131208",""],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76479","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125907","المتقارب"],[4767,"عقد زينب","https://www.poetsgate.com/ViewPoem.aspx?id=179946",""],[4767,"زينة الكون","https://www.poetsgate.com/ViewPoem.aspx?id=212573",""],[5277,"لا تمسحِ الدمعَ","https://www.poetsgate.com/ViewPoem.aspx?id=195072",""],[5411,"شاعر الثورة","https://www.poetsgate.com/ViewPoem.aspx?id=198605",""],[5442,"الذرك الشيب فهلا أرعويت","https://www.poetsgate.com/ViewPoem.aspx?id=114783",""],[5582,"هَلْ ذاكَ بَدْرٌ لاحَ تَحْتَ غَمامِ","https://www.poetsgate.com/ViewPoem.aspx?id=63579",""],[5582,"أَنَوارُ هَلْ مِنْ زَوْرَةٍ أَنَوارُ","https://www.poetsgate.com/ViewPoem.aspx?id=63507",""],[5781,"قولي لهم","https://www.poetsgate.com/ViewPoem.aspx?id=176234",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[463,"ظنَّ غداة َ الخيف أن قد سلما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60298&r=&rc=354",""],[2220,"ألبستُ جارية ُ ثوباً من الخفرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11423&r=&rc=297",""]],"verses":[["وَأَستَصرِفُ الأَعداءَ عَنّا فَإِنَّنا","مُذُ اليَومِ أَغراضٌ لِكُلِّ مَرامِ",0,"م",1,0],["واستصحّ بمعتل الصبا جسدِي","وربما صحَّت الأجسام بالعلل",1,"ل",1,0],["واستصحبَ الدمعُ عيناً غيرَ راقئةٍ","لما غدتْ بحدوج الجيرةِ العير",2,"ر",1,0],["واستصحبتْ من فؤادي قطعةً نفرتْ","وحشيّةً بين آجالٍ وصِيرانِ",3,"ن",1,0],["واستصرخوا من رسولِ اللهِ ذا حَدَبٍ","إذا استغاثَ به مُستصرخٌ عَطَفَا",4,"ف",2,0],["وَاسْتَصْبِحِي بِالشَّمْسِ فِي","أَشْقَى وَأَبْهَى مَوْسَمِ",5,"م",1,0],["واستصحبِي جَزَعا يلائِمُني","وخذي اصطباري إخْذَ مُقْتَدر",6,"ر",1,0],["وَاِستَصفِني وَلَداً كَذَلِكَ خادِماً","لَو يَستَطيعُ فَداكَ مِن صَرفِ الرَدى",7,"د",2,0],["وأستصحِبُ الأهوالَ في كلّ موطنٍ","ويُمْزَجُ لي السّمّ الذُّعاف فأَشْرَبُ",8,"ب",1,0],["وَاِستَصحَبوا قلبي غَداةَ النَوى","فَعَزَّ مَصحوباً وَمُستَصحَبا",9,"ب",2,0],["وَأَستَصحِب القَومَ الَّذينَ بِمُهجَتي","لِفَقدِهِمُ نارٌ يَشُبُّ لَظاها",10,"ا",3,0],["واستصحب التقوى وكن ذا همة","وفتوة وأمانة وعفاف",11,"ف",1,0],["واستصغِر البَلوى لمن عَرف الهوى","واستكثر الشكوى وإن هي قلَّتِ",12,"ت",1,0],["واستصرخوكم مستضعفين على","حربٍ فكنتم أنصارَ ملكهمِ",13,"م",1,0],["واستصغر الدنيا فلو جاد بها","موهوبةً لم يعتقبها ندَما",14,"م",2,0],["واستصغروا عفوَ اللبيب فما اس","تغنَوا بجهل الغافل الغَمْرِ",15,"ر",1,0],["واسْتصغر العدل العميم لأنْفُسٍ","ظَمِئَتْ فأتْبَعَهُ بجودٍ هاطِلِ",16,"ل",1,0],["واستصحب العقل في وضع النصيحة عن","قوس تصوب مرماها عن الوتر",17,"ر",1,0],["واستصرخوا أمة الإسلام قاطبة","ممن بمصر وبالخضرا وبالشام",18,"م",1,0],["واستصبحت بالخاطف الأبصار في","حلك الدجى ومع الوميض تدور",19,"ر",1,0],["واستصرخوا فأتاهم جحفل لجب","من دولة الوهم فيه اليأس والنكد",20,"د",1,0],["وَاِستصفهِ بالمدحِ تحظى بالخلي","جِ الزاخرِ المُتلاطمِ القمقامِ",21,"م",1,0],["واستصوبوا أن تقتنى الأطيارُ","من كل سطّاءٍ به الأظفارُ",22,"ر",1,0],["واستصحب الصبر وابذل ما يعز على","ادراك ما رمت واترك وارد المهل",23,"ل",1,0],["واستصحب الصبر فيما أنت قاصده","فالصبر مجلبة للفوز بالطلب",24,"ب",1,0],["واستصحب الذكر في معنى تكون به","في عالم الذكر مذكورا على الاثر",25,"ر",1,0],["وَاِستَصبَحوا كُلَّ عَمٍ أُمِّيِّ","مِن كُلِّ خَطّافٍ وَأَعرابِيِّ",26,"ي",1,1],["واستصلحوا سير النفوس بما بهِ","تزكو ولا تذروا الكمال مُسوّفا",27,"ف",2,0],["واِستصحبتها نحو أَحباب لَها","طافوا بكعبة بيتها المَعمور",28,"ر",1,0],["واستصحب القرآن مستشعراً","مستظهراً خاتمةَ النحلِ",29,"ل",1,0],["واستصحب الملأَ الأعلى لهُ مددا","ولم يمدّ إلى المستعصبات يَدا",30,"د",2,0],["واستصبحوا فرأوا دوين مرادهم","جبلا اشم وفارساً صنديدا",31,"د",2,0],["واستصرختْ في ثنيات الطوافِ وقد","حسرنَ عن أوجهٍ من أحسنِ الصُّورِ",32,"ر",1,0],["واستصحب الرسم وهاجاً على فرس","واملأ جيوبك بالمعلوم عن عملي",33,"ل",2,0],["واستصحب الحكم المومي إليه وصل","حبل الوداد ولا تقطع وسائله",34,"ل",2,0],["وَاِستَصحِب الوَرَعَ النَزيهَ وَجانِب الط","طَبعَ السَفيهَ بِكُلِّ حالٍ وَاِهجُرِ",35,"ر",1,0],["واستصف اموال البلاد ولا تخف","لوماً فانت على الرعية قيم",36,"م",1,0],["واِستَصحبي الحزم في اخراج ناشئة","واِستَصحبي الحذق في غزل وَفي نسج",37,"ج",1,0],["واستصعب الخطب إن جاءني","بأَرزاءَ قد أَوقدت نارها",38,"ر",3,0],["واستصغروا قَدراً له رَفعتْ","من شأنه الآياتُ واتَّهَمُوا",39,"م",3,0],["واستصغروا عزاًّ لقد وجبَت","منهم بما قد صار نُصرته",40,"ت",2,0],["واسْتصحبِ الأمسَ مما عشتَ تعرفهُ","أن الذي ذبتَ من سلواهُ ما تعبا",41,"ب",2,0],["وَ اسْتَصْرَخَتْ حَلباتُ سَبْقٍ بَيْنَما","ثَقُلَتْ بِجَيبِ غَريمِكَ الأمْوالُ",42,"ل",1,0],["واستصحب الذكر عسى أنه","يغدو أنيساً لك أنى ثويت",43,"ت",1,0],["-وَاسْتَصْفِهِ بِالمَدْحِ تَحْظَ بِالخَلِي","جِ الزَّاخِرِ المُتَلاطِمِ القَمْقامِ",44,"م",1,0],["[ وَاسْتَصْفِنِي وُدًّا أَكُنْ لَكَ خادِماً","يَخْتارُ فِي الخَيْراتِ ما تَخْتارُ ]",45,"ر",1,0],["واسْتَصْرِخي وَجَعي ما ذُقْتُ أجْمَلَهُ","أنتِ الشَّقاءُ وضَوْءُ القَلبِ والظُّلَمُ",46,"م",1,0],["وَاستصر خَوافي دَولة التُرك وَاحتموا","وَقالوا لوحا هالقوم زايد جنونها",47,"ن",3,0],["واستصغروا الدنيا فلو جاد بها","موهوبة ً لم يعتقبها ندما",48,"م",2,0],["واستصرختْ في نيات الطوافِ وفدْ","حسرنَ عن أوجهٍ من أحسنِ الصُّورِ",49,"ر",1,0]]}