{"poems":[[93,"أباعثة المطايا من حديد","https://www.aldiwan.net/poem62788.html","عموديه"],[47,"عارضننا أصلا فقلنا الربرب","https://www.aldiwan.net/poem10644.html","الكامل"],[47,"أهلا بهذا الملك المقبل","https://www.aldiwan.net/poem65607.html","البسيط"],[63,"ومعتدل يسعى إلي بكأسه","https://www.aldiwan.net/poem51499.html","الطويل"],[46,"عفت أربع الحلات للأربع الملد","https://www.aldiwan.net/poem30536.html","الطويل"],[33,"يا أم نوفل فكي عانيا مثلت","https://www.aldiwan.net/poem41855.html","البسيط"],[7,"عفا ذو حساً من فرتنى فالفوارع","https://www.aldiwan.net/poem1983.html","الطويل"],[48,"كم سبحت أربع جوار","https://www.aldiwan.net/poem22555.html","مجزوء البسيط"],[48,"ما للأنام وجدتهم من جهلهم","https://www.aldiwan.net/poem23424.html","الكامل"],[48,"تهجد معشر ليلا ونمنا","https://www.aldiwan.net/poem23562.html","الوافر"],[93,"مستشفى تل شيحا","https://www.poetsgate.com/ViewPoem.aspx?id=53339",""],[113,"قد ضمنا والكرام بستان","https://www.aldiwan.net/poem16548.html","المنسرح"],[113,"أمنجك كن صبورا في البرايا","https://www.aldiwan.net/poem16555.html","الوافر"],[234,"نجوم سعودك لا تفتر","https://www.aldiwan.net/poem51053.html","المتقارب"],[257,"سيف بجفنك مغمد مسلول","https://www.aldiwan.net/poem1421.html",""],[287,"لقد سرني لما سرى طيف مية","https://www.aldiwan.net/poem32851.html","الطويل"],[325,"أبا مصطفى استمتع فحظك وافر","https://www.aldiwan.net/poem67164.html","الطويل"],[358,"دعوني بين ندمان وساقي","https://www.aldiwan.net/poem40026.html","الوافر"],[369,"هم نازلون بقلبي أية سلكوا","https://www.aldiwan.net/poem60817.html","البسيط"],[371,"وحوشي أن يقال لها عتابي","https://www.aldiwan.net/poem17143.html","الوافر"],[376,"إذا أنت لم ترع البروق اللوامحا","https://www.aldiwan.net/poem57514.html","الطويل"],[412,"صددت أن عاد روض الرأس ذا زهر","https://www.aldiwan.net/poem50174.html","البسيط"],[466,"زهي المباسل لانتضاء المقصل","https://www.aldiwan.net/poem15147.html","الكامل"],[469,"صبر قلبي عان ودمعي طليق","https://www.aldiwan.net/poem3398.html","عموديه"],[469,"أما وابتسام البرق في عابس الدجن","https://www.aldiwan.net/poem3514.html","عموديه"],[520,"ليست صفات علاك مما يمترى","https://www.aldiwan.net/poem12109.html","الكامل"],[543,"ثلاث شهور بل ثلاث دهور","https://www.aldiwan.net/poem48177.html","عموديه"],[556,"إِن كان غيبك التراب الأحمر","https://www.aldiwan.net/poem47823.html","الكامل"],[609,"","https://poetry.dctabudhabi.ae/diwan/poem/198599","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48643","الكامل"],[984,"","https://poetry.dctabudhabi.ae/diwan/poem/122195","المنسرح"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62587","الخفيف"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96702","الطويل"],[1341,"","https://poetry.dctabudhabi.ae/diwan/poem/124703","الطويل"],[1426,"","https://poetry.dctabudhabi.ae/diwan/poem/124625","الوافر"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26644","الكامل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111839","المتقارب"],[1738,"","https://poetry.dctabudhabi.ae/diwan/poem/124298","الطويل"],[1843,"","https://poetry.dctabudhabi.ae/diwan/poem/130221","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114706","السريع"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53137","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53234","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53052","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27945","الطويل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129823","السريع"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84916","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83231","الكامل"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136994",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204440","المتقارب"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89273","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89041","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125861","البسيط"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127080","الكامل"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28933","الطويل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136408",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139712",""],[4984,"ودع رفاقك","https://www.poetsgate.com/ViewPoem.aspx?id=175794",""],[5184,"لأنك العراق","https://www.poetsgate.com/ViewPoem.aspx?id=186052",""],[404,"لسْتُ براحلِ","https://www.poetsgate.com/ViewPoem.aspx?id=195049",""],[5582,"قِفا وَاَسْعِدانِي كَيْ نُحَيِّي المَنازِلا","https://www.poetsgate.com/ViewPoem.aspx?id=187238",""],[5582,"لا تُكْثِرا فِي اللَّوْمِ مِنْ تَفْنِيدِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63502",""],[5720,"تَهَانِيْنَا","https://www.poetsgate.com/ViewPoem.aspx?id=211739",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5980,"في ثغر بيروت قاضٍ","https://www.poetsgate.com/ViewPoem.aspx?id=146267",""],[6106,"إلى رحمات الله ، يا أبا فيصل","https://www.poetsgate.com/ViewPoem.aspx?id=7000",""],[6189,"أحزان جديدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83596&r=&rc=63",""],[6259,"صددت إذ عادَ روضُ الرأس ذا زهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59373&r=&rc=21",""],[5164,"أنت الطريق..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75657&r=&rc=11",""]],"verses":[["فَمَجدُكِ فَوقَ مَجدِهِما عَلاءً","وَحُسنُكِ فَوقَ حُسنِهِما فُتونا",0,"ن",2,0],["فَمُجَدَّلٌ وَمُرَمَّلٌ وَمُوَسَّدٌ","وَمُضَرَّجٌ وَمُضَمَّخٌ وَمُخَضَّبُ",1,"ب",1,0],["فَمَجدُكَ الآخِرُ يُغني بَني","نَبهانَ عَن مَجدِهِمِ الأَوَّلِ",2,"ل",1,0],["فَمَجلِسُنا في الماءِ يَهوي ويَرتقي","وإبريقُنا في الكأسِ يَبكي ويَضْحَكُ",3,"ك",1,0],["فَمَجّوا بِهِ سَمّاً وَصاباً وَلَو نَأَت","سُيوفُكَ عَنهُم كانَ أَحلى مِنَ الشَهدِ",4,"د",1,0],["فَمَجَّتِ المِسكَ بَحتاً لَيسَ يَخلِطُهُ","إِلّا سَحيقٌ مِنَ الكافورِ قَد نُخِلا",5,"ل",2,0],["فَمُجتَمَعُ الأَشراجِ غَيَّرَ رَسمَها","مَصايِفُ مَرَّت بَعدَنا وَمَرابِعُ",6,"ع",1,0],["فَمَجِّدوا رَبَّكُم إِلى أَن","تَلفِظَ أَمواتَها القُبورُ",7,"ر",1,0],["فَمُجادِلٌ وَصَلَ الجِدالَ وَقَد دَرى","أَنَّ الحَقيقَةَ فيهِ لَيسَ كَما زَعَم",8,"م",1,0],["فَمَجِّدهُ فَلَم يَخسَر أُناسٌ","أَنابوا لِلمَليكِ وَمَجِّدوهُ",9,"د",3,0],["فمجدك فوق مجدها علاء","وحسنك فوق حسنها فتونا",10,"ن",2,0],["فَمَجدُهُ الصدق لا يَشك بِهِ","وَفي سِواهُ يَعد بُهتانُ",11,"ن",1,0],["فَمَجدك لا تَبور لَهُ بِقاع","وَفَيض بحار فَضلك لا يَغورُ",12,"ر",1,0],["فمجدُك ما فوقه مَصْعَدٌ","وقَصْرُك ما بعده منظَر",13,"ر",1,0],["فَمُجَدَّلٌ يَسعى إِلَيهِ أَجدَلٌ","أَو هارِبٌ طارَت إِلَيهِ خُيولُ",14,"ل",1,0],["فَمَجنونُ لَيلى ماتَ في الحُبِّ مَوتَةً","وَلي كُلَّ يَومٍ في الهَوى أَلفُ مَوتَةِ",15,"ت",2,0],["فَمَجلِسَنا الحُلى اِتَّجَهَت لِشأَنِهِ","وَإِصلاحِهِ وَالعَزمُ لَم يَعُد لِعِيالَك",16,"ك",1,0],["فَمَجلس أُنسنا فَلك التَهاني","وَنَحن ثُبي من السَبع الطِباقِ",17,"ق",1,0],["فَمجدُه خالصاً دونَ الأنامِ له","ومالُه خالصاً للوَفْدِ مُمْتَلَك",18,"ك",1,0],["فَمَجدُكُمُ إِذا سُحُبٌ تَعالَت","وَبِشرُكُمُ إِذا بَدرٌ تَراءى",19,"ا",2,0],["فمجدٌ يحثُّ القول من كلِّ قائلٍ","إليه وجودٌ يستحثُّ القَرائِحا",20,"ح",2,0],["فَمَجدِهِ وَنداه المحض في حَضَرٍ","وَماله وَثَناهُ الغضُّ في سَفَرِ",21,"ر",1,0],["فمجاسد الفتيات أهُبْ كوانِسٍ","والمُطْفلُ الحسناءُ مثلُ المُغْزل",22,"ل",1,0],["فمجانٍ زهرٌ وروضٌ أريضٌ","ومحانٍ حوٌّ وغيثٌ دفوق",23,"ق",1,0],["فمجدٌ بلا كبرٍ وملكٌ بلا أذى","ونعمى بلا مطلٍ وعزمٌ بلا وهن",24,"ن",1,0],["فمجالس كسيت رقيماً أبيضاً","ومجالس كسيت طميماً أصفرا",25,"ر",2,0],["فمَجدٌ وجودٌ واقتِدارٌ وحكمةٌ","وحزمٌ وعَزمٌ واكتِناهُ خَبيرِ",26,"ر",1,0],["فمجدّلٌ وسْطَ الأسنّةِ بالقنا","ما كان يوماً للّباسِ يُعَصفِرُ",27,"ر",1,0],["فمُجَاريكَ في النَّدا والمعالي","عاجزٌ مالهُ بذاكَ يدانِ",28,"ن",1,0],["فمجاهد لك في البلاد تعينه","بمؤذن لك في العباد يصيح",29,"ح",1,0],["فمجال كل مرابطٍ مستهدفٌ","وفؤاد كل موحد مقروح",29,"ح",1,0],["فمجرئي الأسد في مرابضها","كمجرئي الغانيات في الكلل",30,"ل",1,0],["فمجازي هواكم لم أحل عَنْه","وأنتم حقيقتي ومجازي",31,"ز",2,0],["فَمَجنون ليلى خامرَ الحبُّ قلبَهُ","مَدى عمرهِ حتّى اِحتوته الجنادلُ",32,"ل",1,0],["فمجّدت ما فيك من الطهر والتقى","على رغم ما في القلب من ساحق الكفر",33,"ر",1,0],["فمجلسنا كما نهواه زبن","بمن تهواه في قرب وبعد",34,"د",1,0],["فمجدل ومزمل وموسد","ومضرج ومضمخ ومخضب",35,"ب",1,0],["فمجلى المعاني ومولى الكما","لِ أُولى الانامِ بأُولى الرتب",36,"ب",1,0],["فمجتهدو الإطلاق أما سواهم","فليس إذا ما زايل الحقّ يعذَر",37,"ر",1,0],["فمجاهِرٌ لي بالعَدَاوة مِنْهُمُ","جَهْلاً وطاوِى غُلَّةٍ لم يَجْهَرِ",38,"ر",1,0],["فمجِّدوا اللَه ولا تحقِروا","جُنداً له مِن خلقِه جُنِّدوا",39,"د",3,0],["فمجده صعب على طالبه","ورفده سهل على الملتمس",40,"س",1,0],["فمجاري علاك يا ابن أبي يعل","ى له دون غاية المجد كبوه",41,"و",2,0],["فمجيري من جورهن مُجِيرُ الدي","ن حامي سرج العلا يعقوبُ",42,"ب",1,0],["فمجموعنا شخصٌ لذاك أتى به","وسمَّاه شخصاً مرسَلا من له القرب",43,"ب",1,0],["فمجمد أعلاهم فوقا وما","حكمت لهم بهزيمة الرجحان",44,"ن",1,0],["فمج لي في الكأس من ثغره","ما حبّبَ الشرب وما طيّبا",45,"ب",2,0],["فَمَجدك مَشهور وَفَضلك شامل","لِكُل مريد مِن طَريف وَتالد",46,"د",1,0],["فَمَجالِسُ الوُزَراءِ قَد أَسعَدتها","بِحَصافَةٍ يا صَفوَةَ الأُمَناءِ",47,"ا",2,0],["فمجد عصامي به قد تمتعوا","وعز سقاه بالثبات فما يظما",48,"ا",1,0],["فمجموعة الحسن والقبح في الكو","ن أجمل ما قد رآه البصر",49,"ر",1,0],["فمجده ماله مثالٌ","وما له فيه من مثيل",50,"ل",1,0],["فمجوا بها صبراً نقيعاً بصبرهم","ولولاك كانت عندهم سائغ الشهد",51,"د",1,0],["فمجلس الأمن أَعمى لا تنبهه","إلا المدافع لا فتوى القوانين",52,"ن",1,0],["فمجامر الأزهار فاح أريجها","عبقا بنار البرق ذي اللألاء",53,"ا",2,0],["فمجتمعَ الاسدامِ من حول شارعٍ","فروّى جبال القريتينِ فَضَلفَعا",54,"ع",2,0],["فمجده عن سلف ثابت","وجوده طبع به اكمل",55,"ل",1,0],["فمجده قد علا السبع الشداد علىً","وجودُه في الجهات الست قد وكفا",56,"ف",2,0],["فمجاملات الأصدقاء تُكُلفت","فتظاهروا.. متزلف .. وودود",57,"د",1,0],["فَمَجْنُوْنُكِ المَوْهوبُ أَغْمدَ سيفَهُ","وصارَتْ قَوافي الشِّعْرِ تَطْعَنُهُ غَدْرا",58,"ر",2,0],["فمجنونةٌ أنتِ استبقْتِ بلاغتي","وكيف لذاك اللَّحظ أودْى بعاقل ؟",59,"ل",1,0],["فَمَجْنُونُ لَيْلَى لا يَزِيدُ صَبابَةً","عَلَيَّ وَلَمْ يَكْرَعْ كَمِثْلِي مَناهلا",60,"ل",2,0],["[ فَمُجاجُ رِيقَتِهِ لَدَى تَرْشافِهِ","يُغْنِي عَنْ القِنْدِيدِ مِنْ راقُودِهِ ]",61,"د",2,0],["فمَجدُ الطبِّ يعلو كلَّ مَجدٍ","بهِ ترقىٰ النفوسُ إلىٰ الجَلالِ",62,"ل",1,0],["فمجموع قرآن محمدنا الذي","علينا تلى آياته كل ساعتي",63,"ت",2,0],["فمجلس الشرع فيها","جارٍ بأحكام حقِّ",64,"ق",1,0],["فمجمع فهد للمصاحف شاهدٌ","بحب كتاب الله والله منعم",65,"م",1,0],["فمٌ جاء فجريَّ البدايات لونه","صباحٌ وفي أبعاده الحُزنُ يندفُ",66,"ف",1,0],["فمجده ونداه المحضُ في حضر","ومالهُ وثناهُ العض في سفر",67,"ر",1,0],["فمجلِسُ الأمن ِ أشْباحٌ تعاوِرُنا","ومجمعُ العُرْبِ أبْواقٌ لما قَدَروا",68,"ر",3,0]]}