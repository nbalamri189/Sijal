{"poems":[[91,"أباعثة المطايا من حديد","https://www.aldiwan.net/poem62788.html","عموديه"],[45,"عارضننا أصلا فقلنا الربرب","https://www.aldiwan.net/poem10644.html","الكامل"],[45,"أهلا بهذا الملك المقبل","https://www.aldiwan.net/poem65607.html","البسيط"],[61,"ومعتدل يسعى إلي بكأسه","https://www.aldiwan.net/poem51499.html","الطويل"],[44,"عفت أربع الحلات للأربع الملد","https://www.aldiwan.net/poem30536.html","الطويل"],[31,"يا أم نوفل فكي عانيا مثلت","https://www.aldiwan.net/poem41855.html","البسيط"],[7,"عفا ذو حساً من فرتنى فالفوارع","https://www.aldiwan.net/poem1983.html","الطويل"],[46,"كم سبحت أربع جوار","https://www.aldiwan.net/poem22555.html","مجزوء البسيط"],[46,"ما للأنام وجدتهم من جهلهم","https://www.aldiwan.net/poem23424.html","الكامل"],[46,"تهجد معشر ليلا ونمنا","https://www.aldiwan.net/poem23562.html","الوافر"],[91,"مستشفى تل شيحا","https://www.poetsgate.com/ViewPoem.aspx?id=53339",""],[110,"قد ضمنا والكرام بستان","https://www.aldiwan.net/poem16548.html","المنسرح"],[110,"أمنجك كن صبورا في البرايا","https://www.aldiwan.net/poem16555.html","الوافر"],[230,"نجوم سعودك لا تفتر","https://www.aldiwan.net/poem51053.html","المتقارب"],[253,"سيف بجفنك مغمد مسلول","https://www.aldiwan.net/poem1421.html",""],[283,"لقد سرني لما سرى طيف مية","https://www.aldiwan.net/poem32851.html","الطويل"],[321,"أبا مصطفى استمتع فحظك وافر","https://www.aldiwan.net/poem67164.html","الطويل"],[354,"دعوني بين ندمان وساقي","https://www.aldiwan.net/poem40026.html","الوافر"],[365,"هم نازلون بقلبي أية سلكوا","https://www.aldiwan.net/poem60817.html","البسيط"],[367,"وحوشي أن يقال لها عتابي","https://www.aldiwan.net/poem17143.html","الوافر"],[372,"إذا أنت لم ترع البروق اللوامحا","https://www.aldiwan.net/poem57514.html","الطويل"],[407,"صددت أن عاد روض الرأس ذا زهر","https://www.aldiwan.net/poem50174.html","البسيط"],[462,"زهي المباسل لانتضاء المقصل","https://www.aldiwan.net/poem15147.html","الكامل"],[465,"صبر قلبي عان ودمعي طليق","https://www.aldiwan.net/poem3398.html","عموديه"],[465,"أما وابتسام البرق في عابس الدجن","https://www.aldiwan.net/poem3514.html","عموديه"],[516,"ليست صفات علاك مما يمترى","https://www.aldiwan.net/poem12109.html","الكامل"],[539,"ثلاث شهور بل ثلاث دهور","https://www.aldiwan.net/poem48177.html","عموديه"],[552,"إِن كان غيبك التراب الأحمر","https://www.aldiwan.net/poem47823.html","الكامل"]],"verses":[["فَمَجدُكِ فَوقَ مَجدِهِما عَلاءً","وَحُسنُكِ فَوقَ حُسنِهِما فُتونا",0,"ن",2,0],["فَمُجَدَّلٌ وَمُرَمَّلٌ وَمُوَسَّدٌ","وَمُضَرَّجٌ وَمُضَمَّخٌ وَمُخَضَّبُ",1,"ب",1,0],["فَمَجدُكَ الآخِرُ يُغني بَني","نَبهانَ عَن مَجدِهِمِ الأَوَّلِ",2,"ل",1,0],["فَمَجلِسُنا في الماءِ يَهوي ويَرتقي","وإبريقُنا في الكأسِ يَبكي ويَضْحَكُ",3,"ك",1,0],["فَمَجّوا بِهِ سَمّاً وَصاباً وَلَو نَأَت","سُيوفُكَ عَنهُم كانَ أَحلى مِنَ الشَهدِ",4,"د",1,0],["فَمَجَّتِ المِسكَ بَحتاً لَيسَ يَخلِطُهُ","إِلّا سَحيقٌ مِنَ الكافورِ قَد نُخِلا",5,"ل",2,0],["فَمُجتَمَعُ الأَشراجِ غَيَّرَ رَسمَها","مَصايِفُ مَرَّت بَعدَنا وَمَرابِعُ",6,"ع",1,0],["فَمَجِّدوا رَبَّكُم إِلى أَن","تَلفِظَ أَمواتَها القُبورُ",7,"ر",1,0],["فَمُجادِلٌ وَصَلَ الجِدالَ وَقَد دَرى","أَنَّ الحَقيقَةَ فيهِ لَيسَ كَما زَعَم",8,"م",1,0],["فَمَجِّدهُ فَلَم يَخسَر أُناسٌ","أَنابوا لِلمَليكِ وَمَجِّدوهُ",9,"د",3,0],["فمجدك فوق مجدها علاء","وحسنك فوق حسنها فتونا",10,"ن",2,0],["فَمَجدُهُ الصدق لا يَشك بِهِ","وَفي سِواهُ يَعد بُهتانُ",11,"ن",1,0],["فَمَجدك لا تَبور لَهُ بِقاع","وَفَيض بحار فَضلك لا يَغورُ",12,"ر",1,0],["فمجدُك ما فوقه مَصْعَدٌ","وقَصْرُك ما بعده منظَر",13,"ر",1,0],["فَمُجَدَّلٌ يَسعى إِلَيهِ أَجدَلٌ","أَو هارِبٌ طارَت إِلَيهِ خُيولُ",14,"ل",1,0],["فَمَجنونُ لَيلى ماتَ في الحُبِّ مَوتَةً","وَلي كُلَّ يَومٍ في الهَوى أَلفُ مَوتَةِ",15,"ت",2,0],["فَمَجلِسَنا الحُلى اِتَّجَهَت لِشأَنِهِ","وَإِصلاحِهِ وَالعَزمُ لَم يَعُد لِعِيالَك",16,"ك",1,0],["فَمَجلس أُنسنا فَلك التَهاني","وَنَحن ثُبي من السَبع الطِباقِ",17,"ق",1,0],["فَمجدُه خالصاً دونَ الأنامِ له","ومالُه خالصاً للوَفْدِ مُمْتَلَك",18,"ك",1,0],["فَمَجدُكُمُ إِذا سُحُبٌ تَعالَت","وَبِشرُكُمُ إِذا بَدرٌ تَراءى",19,"ا",2,0],["فمجدٌ يحثُّ القول من كلِّ قائلٍ","إليه وجودٌ يستحثُّ القَرائِحا",20,"ح",2,0],["فَمَجدِهِ وَنداه المحض في حَضَرٍ","وَماله وَثَناهُ الغضُّ في سَفَرِ",21,"ر",1,0],["فمجاسد الفتيات أهُبْ كوانِسٍ","والمُطْفلُ الحسناءُ مثلُ المُغْزل",22,"ل",1,0],["فمجانٍ زهرٌ وروضٌ أريضٌ","ومحانٍ حوٌّ وغيثٌ دفوق",23,"ق",1,0],["فمجدٌ بلا كبرٍ وملكٌ بلا أذى","ونعمى بلا مطلٍ وعزمٌ بلا وهن",24,"ن",1,0],["فمجالس كسيت رقيماً أبيضاً","ومجالس كسيت طميماً أصفرا",25,"ر",2,0],["فمَجدٌ وجودٌ واقتِدارٌ وحكمةٌ","وحزمٌ وعَزمٌ واكتِناهُ خَبيرِ",26,"ر",1,0],["فمجدّلٌ وسْطَ الأسنّةِ بالقنا","ما كان يوماً للّباسِ يُعَصفِرُ",27,"ر",1,0]]}