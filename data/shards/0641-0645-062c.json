{"poems":[[91,"أباعثة المطايا من حديد","https://www.aldiwan.net/poem62788.html","عموديه"],[45,"عارضننا أصلا فقلنا الربرب","https://www.aldiwan.net/poem10644.html","الكامل"],[45,"أهلا بهذا الملك المقبل","https://www.aldiwan.net/poem65607.html","البسيط"],[61,"ومعتدل يسعى إلي بكأسه","https://www.aldiwan.net/poem51499.html","الطويل"],[44,"عفت أربع الحلات للأربع الملد","https://www.aldiwan.net/poem30536.html","الطويل"],[31,"يا أم نوفل فكي عانيا مثلت","https://www.aldiwan.net/poem41855.html","البسيط"],[7,"عفا ذو حساً من فرتنى فالفوارع","https://www.aldiwan.net/poem1983.html","الطويل"],[46,"كم سبحت أربع جوار","https://www.aldiwan.net/poem22555.html","مجزوء البسيط"],[46,"ما للأنام وجدتهم من جهلهم","https://www.aldiwan.net/poem23424.html","الكامل"],[46,"تهجد معشر ليلا ونمنا","https://www.aldiwan.net/poem23562.html","الوافر"],[91,"مستشفى تل شيحا","https://www.poetsgate.com/ViewPoem.aspx?id=53339",""]],"verses":[["فَمَجدُكِ فَوقَ مَجدِهِما عَلاءً","وَحُسنُكِ فَوقَ حُسنِهِما فُتونا",0,"ن",2,0],["فَمُجَدَّلٌ وَمُرَمَّلٌ وَمُوَسَّدٌ","وَمُضَرَّجٌ وَمُضَمَّخٌ وَمُخَضَّبُ",1,"ب",1,0],["فَمَجدُكَ الآخِرُ يُغني بَني","نَبهانَ عَن مَجدِهِمِ الأَوَّلِ",2,"ل",1,0],["فَمَجلِسُنا في الماءِ يَهوي ويَرتقي","وإبريقُنا في الكأسِ يَبكي ويَضْحَكُ",3,"ك",1,0],["فَمَجّوا بِهِ سَمّاً وَصاباً وَلَو نَأَت","سُيوفُكَ عَنهُم كانَ أَحلى مِنَ الشَهدِ",4,"د",1,0],["فَمَجَّتِ المِسكَ بَحتاً لَيسَ يَخلِطُهُ","إِلّا سَحيقٌ مِنَ الكافورِ قَد نُخِلا",5,"ل",2,0],["فَمُجتَمَعُ الأَشراجِ غَيَّرَ رَسمَها","مَصايِفُ مَرَّت بَعدَنا وَمَرابِعُ",6,"ع",1,0],["فَمَجِّدوا رَبَّكُم إِلى أَن","تَلفِظَ أَمواتَها القُبورُ",7,"ر",1,0],["فَمُجادِلٌ وَصَلَ الجِدالَ وَقَد دَرى","أَنَّ الحَقيقَةَ فيهِ لَيسَ كَما زَعَم",8,"م",1,0],["فَمَجِّدهُ فَلَم يَخسَر أُناسٌ","أَنابوا لِلمَليكِ وَمَجِّدوهُ",9,"د",3,0],["فمجدك فوق مجدها علاء","وحسنك فوق حسنها فتونا",10,"ن",2,0]]}