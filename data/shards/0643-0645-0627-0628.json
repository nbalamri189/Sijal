w.poetsgate.com/ViewPoem.aspx?id=213010",""],[4578,"قلبٌ بنار الأسى والوجد حرانُ","https://www.poetsgate.com/ViewPoem.aspx?id=49529",""],[4578,"في ليلة النصف من شعبان قد عادا","https://www.poetsgate.com/ViewPoem.aspx?id=49402",""],[4578,"قلبي لعيناك نيشان الهوى فيه","https://www.poetsgate.com/ViewPoem.aspx?id=49604",""],[4935,"بعيد جلوسك عبد الحميد","https://www.poetsgate.com/ViewPoem.aspx?id=129302",""],[4985,"صدام","https://www.poetsgate.com/ViewPoem.aspx?id=11311",""],[4994,"يُحبُّهُ اللهُ وأُحبُّهُ أنا","https://www.poetsgate.com/ViewPoem.aspx?id=208943",""],[4999,"إليك سيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=184286",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[5411,"يَهمُّ بِيَ العَذابُ","https://www.poetsgate.com/ViewPoem.aspx?id=202889",""],[5431,"هيتَ له ....","https://www.poetsgate.com/ViewPoem.aspx?id=202400",""],[5431,"عليّ كرم الله وجهه....","https://www.poetsgate.com/ViewPoem.aspx?id=212969",""],[5531,"أذكريني يامنيتي","https://www.poetsgate.com/ViewPoem.aspx?id=128418",""],[5780,"لست يا موصل إلا دار عز وكرامه","https://www.poetsgate.com/ViewPoem.aspx?id=187624",""],[5829,"صرخة المخيم","https://www.poetsgate.com/ViewPoem.aspx?id=152733",""],[5956,"قطة على شاطئ البحر","https://www.poetsgate.com/ViewPoem.aspx?id=183429",""],[5956,"كم أبتغي إضحاككم","https://www.poetsgate.com/ViewPoem.aspx?id=192423",""],[5956,"ذكرى موت زميل الطفولة","https://www.poetsgate.com/ViewPoem.aspx?id=194480",""],[6097,"لأيًا بعدَ جيرةْ","https://www.poetsgate.com/ViewPoem.aspx?id=190694",""]],"verses":[["كَم أَبٍ لي جَدَّ في إِحرازِها","يَحرُقُ النابَ عَليها وَاِبنِ عَمّ",0,"م",1,0],["كَم أَبيتُ مُمتَرياً","خِلفَ دَمعيَ الهَطِلِ",1,"ل",1,0],["كَم أَبٍ أَسوانَ دامٍ قَلبُهُ","مُستَطيرِ اللُبِّ مَفقورِ الظَهَر",2,"ر",1,0],["كما بهر البَدرُ النجومَ لأربعٍ","وعشر فأمستْ غيرَ ذاتِ ضياءِ",3,"ا",2,0],["كما بأبي العباس أنشئ مُلكُكُمْ","كذا بأبي العباس منكم يُجدّدُ",4,"د",1,0],["كم أبٍ قد رأى عزيزَ بنيه","وهْوَ يُعلَى بصارمٍ صمصام",5,"م",1,0],["كَم أَبحَثُ بَينَ الأَجرامِ","عَنّي وَأُنَقِّبُ في الأَرضِ",6,"ض",1,0],["كما بكى قائله","ابان كان ينظم",7,"م",1,0],["كما بان ما جاءنا آخر","بأمثالها لا ولا أولُ",8,"ل",1,0],["كَما بَعَثَ اللَهُ النَبِيَّ مُحَمَّداً","عَلى فَترَةٍ وَالناسُ مِثلَ البَهائِمِ",9,"م",1,0],["كَم أَبكَتِ البيضَ في كَفَّيهِ إِذ ضَحِكَت","عَيناً وَأَضحَكَ سِنّاً مالُهُ الباكي",10,"ك",2,0],["كَم أبعدَ النَّاسُ في أَمرٍ ظنونَهُمُ","فكان دائي قريبَ البُرْءِ بالباري",11,"ر",2,0],["كَم أَبطَلوا سُنَنَ النَبِيِّ وَعَطَّلوا","مِن حِليَةِ التَوحيدِ ذُروَةَ مِنبَرِ",12,"ر",1,0],["كَما بَلَّ مَثنى طُفيَةٍ نَضحُ عائِطٍ","يُزَيِّنُها كِنُّ لَها وَسُفوعُ",13,"ع",1,0],["كَما بَنى مِن أَعجَبِ البِناءِ","لا زالَ فينا دائِمَ البَقاءِ",14,"ا",2,0],["كم أبانَتْ آياتُهُ من علومٍ","عن حُروفٍ أبانَ عنها الهجاءُ",15,"ا",2,0],["كَمْ أبْرَأْتَ وَصِباً باللَّمْسِ راحَتُهُ","وأَطْلَقَتْ أرِباً مِنْ رِبْقَةِ اللَّمَمِ",16,"م",1,0],["كَم أَبَنَّ الغابَ مِن أَسَدٍ","أَيُّ لَيثٍ لَيسَ يُفتَرَسُ",17,"س",1,0],["كَم أَبادا مِن عالَمٍ وَأَعادا","سابِحاً وَهوَ في الثَرى مَأزولُ",18,"ل",1,0],["كَما بِدم الأَسباط إِذ سُرَّ يوسُفٌ","بِعاقِبَةِ النَزغِ الَّذي بَينَهُم يَزَغ",19,"غ",1,0],["كما بائسٍ يبكيك كنتَ طبيبه","من علتين: السُّقم، والإملاق",20,"ق",1,0],["كم أب خاصم في الله ابنَهُ","وأخٍ حارب في الله أخاه",21,"ا",2,0],["كما بأبي العباس أنشىء مُلكُكُم","كذا بأبي العباس منكم يجدِّدُ",22,"د",1,0],["كما بكينا كما بكيت فلم تر","ث ولم تكثرت لدمعي السخين",23,"ن",1,0],["كما بزعيم الدّولة الأممُ ارتضتْ","على الدِّين والدنيا زعيما وسيِّدا",24,"د",2,0],["كما بالتواضعِ يسمو اللئيم","ويَرْقَي من الفضلِ أعلى مقام",25,"م",1,0],["كَم أبو جهل اِستطالَ على الدي","نِ وكَم ذا أزرت به الجهلاءُ",26,"ا",2,0],["كم أبت من سعيي الحثيث","بصفقة الخسران",27,"ن",1,0],["كَما باتَ يُسري نائِلُ اِبنِ مُحَمَّدٍ","إِلى طالِبي مَعروفِهِ يَقطَعُ الأَرضا",28,"ض",2,0],["كَم أَباحَت جُيوشُهُ وَسَرايا","هُ بِبيضِ الغُمودِ بيضَ الخُدورِ",29,"ر",1,0],["كَما بَادَرتْ وَأداً بنِيَّاتِ قُسِّهَا","إيَادٌ وَهُنَّ الآنِسَاتُ العَقَائِلُ",30,"ل",1,0],["كم أبيتُ أربطها","بالذراعِ والعضد",31,"د",1,0],["كَما بانَ لفحُ النارِ مكنون نفحةٍ","أُحيلَ إليهِ بالتوقّدِ عودها",32,"د",3,0],["كَما بَلَغت أَوطاننا بِكَ غايةً","بَلَغنا بِها أَوطارنا وَالرَجا مَعا",33,"ع",2,0],["كما بسَديدِ الدّولةِ الدّولةُ اهتدَتْ","إلى كُلِّ ما تَرْمي به فَتُصيب",34,"ب",1,0],["كَما بَلَعني بَني حربٍ وَاسرتهم","أُشجي وَأُرغمُ مَن أَضحى يُعاديهِ",35,"ي",2,0],["كم أباحوا من كل ما حرم اللّه","وكم أيتموا من الأطفال",36,"ل",1,0],["كما بآدابه أنسى بأحمد من","له أقرت جميع العجم والعرب",37,"ب",1,0],["كما بلغا في المجد أبناءُ راشدٍ","مكان الدراري والنُّجوم الزَّواهر",38,"ر",1,0],["كم أبْهَر العينَ حُسناً من سنى كلمٍ","بدا وتورية فيها تورِّيها",39,"ي",3,0],["كم أبعدت كفاه أسود فاقة","واستخدمت بالحرب أبيض مخدما",40,"م",2,0],["كما بَشَّرَتْ بالغيثِ بارِقَةُ الحَيا","ووأَسفر عن شمسِ الضحى فَلَقُ الصُّبْحِ",41,"ح",1,0],["كما بغض الأحياء عندي فراقه","فرت أنا الأنسي في جيرة الجن",42,"ن",1,0],["كم أبطلت سطورها","في الحرب من كيدِ بطل",43,"ل",1,0],["كم ابتلعت حجاجةً بقاعٌ","لهم فيها اغتباقٌ واصطباحُ",44,"ح",1,0],["كم أبادوا بالبيضِ آجالَ صِيدٍ","وبسُمرِ القَناء آجالَ صِيدِ",45,"د",1,0],["كم أبٍ نامَ في حَشاكَ وجَدٍّ","أَرهَفوا سَمعًهم لما نَحنُ نَأتي",46,"ي",1,0],["كم أبدَعُوا مِن آيةٍ في فنِّهِم","ونَجِيبُهم من فكرِه كَم أنجَبَا",47,"ب",2,0],["كم ابهج القلب الحزين وأضحك ال","وجه العبوس وأطرب المتفكرا",48,"ر",2,0],["كما بَقِيَت آثار أكرم عالم","وخير زعيمٍ أعظم الزعماءِ",49,"ا",2,0],["كما بدأنا أعدنا حكمه لأب","لا حكم أم بدت عن وصفة الرسب",50,"ب",1,0],["كَما بِهِ قَد سَخّر النَّصارى","تَخدِمُنا كأَنَّهُم أُسارى",51,"ر",2,0],["كما بيعَ رأسُكَ بيعَ العِراق","ولا من مُجيرٍ ولا نادِبِ",52,"ب",1,0],["كم أبدْنا بقطرها","من رؤوس قماقم",53,"م",1,0],["كما بالفضل حيَّر كل راجٍ","محمدٌ بْنُ فيصلَ وأستقلاّ",54,"ل",2,0],["كما بفناء البيت والحجر اغتدت","تطهر أوساخ الذنوب وتحسم",55,"م",1,0],["كم أبرم الأمر السحيل برأيه","ولكم به نقض القضاء المبرما",56,"م",2,0],["كم أبرا من علة وفرط جنون","كم أوصل من قاطع وقطع أوصال",57,"ل",1,0],["كم أبادوا مضللا وغويا","وبغيا وفاجرا كفارا",58,"ر",2,0],["كما بدا الحق في آل الوصي فأ","نوار الهدى لعَّمي القلب ترشده",59,"د",2,0],["كَمَا بَغَمَت مِن شَجوِهَا أُمُّ وَاحِدٍ","أُتِيحَ لَهَا مِثلَ الزُّجَاجِ طَرِيرُ",60,"ر",1,0],["كما بمنظومتي تلك التي سلفت","لي للذين أساؤوا النظم ارشادُ",61,"د",1,0],["كم ابنُ فهدٍ غدا فيها لعُدّة دا","عِيكم وكم لأياديكم من ابنِ نما",62,"م",2,0],["كَم أَبلَتِ الدُنيا وَكَم جَدَّدَت","مِنّا وَكَم تُبلي وَتَغتالُ",63,"ل",1,0],["كم أباحت نفوسكم لكم الش","ر وكيف استطيرَ هذا البلاء",64,"ا",2,0],["كما ببنيك آثار صحاح","رووها عنك معنى لا كلاما",65,"م",2,0],["كم أَبْصَرَتْ عيْني وكم سِمعَتْ به","أُذْني مقالَة مُخبِرٍ لا يُتْهَمُ",66,"م",1,0],["كَما بِهِمَّتِكَ العُليا بَنَيتَ بِها","لِلمَجدِ وَالفَضلِ أَعلاماً وَأَركانا",67,"ن",2,0],["كم ابعدتني عنك لايّام","وانا مقيم ولالي أخوز",68,"ز",1,0],["كما بصيرُّ عينَ الشمسِ في نظري","من أيمن الطورِ في وادٍ به لهبا",69,"ب",2,0],["كما بدأ الرحمنُ نشأ يعيده","بغير مثالٍ حاصلٍ قبله سبقْ",70,"ق",1,1],["كم أبرىء الاكمه من فاقة","عيسى كأن جوده العافيه",71,"ي",2,0],["كما بناصرها كانت معززة","سَيف المظفر قِواها وَعزّزها",72,"ز",3,0],["كما بلقاءِ الشَّيخِ ماء عُيُونِنَا","على الشَّرعِ فَضلاً والحقيقة باعِثُ",73,"ث",1,0],["كَما باقلٍ في الشعر عالجه","فَدعَوه وَهُوَ الغرُّ فَرجيلا",74,"ل",2,0],["كَم أَبرَم العَقل أَمراً عادَ مُنتَفِضاً","وَكَم تَوقَّع نُجحاً فَاِنثَنى فَشِلا",75,"ل",2,0],["كما بغى ابن أبي سُفيان حين بغى","ما ليس فيه له إِرْثٌ ولا قِسَم",76,"م",1,0],["كَم أَبعَدَ الناسَ هَدياً مِن غَباوَتِهِم","كَم أَنقَذَ العُميَ وَعظاً مِن غَوايَتِهِم",77,"م",1,0],["كم أبصر الخير فيما كنت أكرهه","لكنّ خيري خيرٌ لي وللبشر",78,"ر",1,0],["كَم أَبرأت وَصبا باللمس راحته","من بعد عجز طَبيب باهر الحِكم",79,"م",1,0],["كَم أَبرَأت وَصباً بِاللَمس راحته","وأقصدت جَحفلاً كَالبَحر في العظم",80,"م",1,0],["كما بناها يبني سواها","كما بدانا كذا نعاد",81,"د",1,0],["كم أبلت الأيّام شهماً ماجداً","مِن أهل مصر وكم أبادت قيصرا",82,"ر",2,0],["كما بي عن شوقٍ شديدٍ إليكما","كأن على الأحشاء منه مكاويا",83,"ي",2,0],["كم أبدعت أخلاقه ضلاله","في الخلق واستولت به الجهاله",84,"ه",1,0],["كَما بَدا البشر لَنا عادا","وَاِلتأم الجرحانِ أَو كادا",85,"د",2,1],["كما بإبراهيم قدما سما","فبالحبيب قد سما شأنه",86,"ن",2,0],["كم أبصرت العين بدوراً وشموسا","لم تحك محياك ولا لمع سناه",87,"ه",1,0],["كم أبكت البيض في كفّيه إذ ضحكت","أهل النفاق وألقتهم بأشراكِ",88,"ك",1,0],["كم أبكمٍ قد حَلَّ عَقدَ لِسانهِ","بل اكمهٍ أَجلَى عَماهُ بلا جِلا",89,"ا",1,0],["كم أبدعوا فصلَ فضل من تُقىً ونَقىً","واشرعوا او رَعَوا بالحُكم والحِكَمِ",90,"م",1,0],["كم أبرموا في الورى أمراً فانقضه","قول طلائعه الروعات والحذر",91,"ر",1,0],["كما بدا خلقهم ربي يعيدهم","سبحان من أنشأ الأرواح والصورا",92,"ر",2,0],["كما بخسوا يحيى بن ذي النون حقُّه","فقالوا ابنَ سُعدى في النوال وحاتمُ",93,"م",1,0],["كَم أَبرَزَت شَفَتاهُ مِن أَجلِ وَمِن","رِزقٍ يَعُمُّ المُعتَدي وَالمُجتَدي",94,"د",2,0],["كَما بَحثَ الحِسيَ الكِلابِيَّ مُنهِلٌ","رِضابُ النَدى في روعِهِ يَتَزَلَّفُ",95,"ف",1,0],["كَما باتَ دَهري يُريني نَهج ترببتي","فَيَنثَني بِقَبولي وَاِمتِثالاتي",96,"ت",2,0],["كم أبطلوا بطلا وكم","بقليبه ألقوا أسامه",97,"م",2,0],["كم أبطلوا بطلا كم جندلوا جدلا","كم مثلوا مثلا كم طهروا خبثا",98,"ث",2,0],["كَمَا بَلَّغَتْ أيَّامُ صِفْينَ نَفْسَهُ","تَرَاقِيَةُ وَالشَّامِتُونَ شُهُودُ",99,"د",1,0],["كم أبدعوا روض عدل بعد طولهم","وانزعوا حوض فضل قبل قولهم",100,"م",1,0],["كما بمحمد شمس المعالي ال","هلالي حفه سعد القرآن",101,"ن",1,0],["كما باسمه نادى البشير مؤرخا","غدا دائما عبد الحميد مؤيدا",102,"د",2,0],["كما بهرت منك سيما العلى","فالبست البدر ثوب السرار",103,"ر",1,0],["كم أبادت عن محبٍّ محنا","أبدلتها بالتداني منحا",104,"ح",2,0],["كما به أضحت ليالي الهنا","في صفو عيشٍ ما له من نفاد",105,"د",1,0],["كما به أمست ليالي الصفا","في صفو بشرٍ ما له من نفاد",106,"د",1,0],["كم أبيٍّ يلوكُ خبزَ عناهُ","بالرضا والقبولِ والكتمانِ",107,"ن",1,0],["كما بهمة عبد القادر انطفأت","في الشام من حادث الأيام نيران",108,"ن",1,0],["كما برأهُ بالأنفال ليلتها","وقت لنا حسب ما نرجوه ميعادا",109,"د",2,0],["كما بكاملها بيروت عاودها","عز الهنا إذ غدا للخير معتادا",109,"د",2,0],