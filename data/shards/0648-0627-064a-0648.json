{"poems":[[79,"إذا أنا لم أوثر هواي على عزمي","https://www.aldiwan.net/poem36126.html","الطويل"],[68,"توسد في الفلا أيدي المطايا","https://www.aldiwan.net/poem41575.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39627","السريع"],[382,"أيا أغنياء الروح صونوا كنوزَكم","https://www.aldiwan.net/poem59426.html","الطويل"],[422,"ألا بلغ جناب الشيخ عني","https://www.aldiwan.net/poem54059.html","الوافر"],[435,"وإيوان مجد برج ليث تخاله","https://www.aldiwan.net/poem40996.html","الخفيف"],[445,"أرحلي محمول على العتق النجب","https://www.aldiwan.net/poem34886.html","الطويل"],[447,"كفى البدر حسناً أن يقال نديدها","https://www.aldiwan.net/poem14342.html","الطويل"],[556,"رضيت بالدون لما لم أجد وزرا","https://www.aldiwan.net/poem47161.html","البسيط"],[564,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"],[701,"","https://poetry.dctabudhabi.ae/diwan/poem/107332","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56208","الوافر"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122027","المتقارب"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122074","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122022","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80046","السريع"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69414","الطويل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104951","الطويل"],[2868,"","https://poetry.dctabudhabi.ae/diwan/poem/101948","الطويل"],[2888,"","https://poetry.dctabudhabi.ae/diwan/poem/46736","البسيط"],[2922,"","https://poetry.dctabudhabi.ae/diwan/poem/105325","البسيط"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133942","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129349","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111465","المتقارب"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77089","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139639",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139477",""],[4759,"متى تفتش عني","https://www.poetsgate.com/ViewPoem.aspx?id=204206",""],[4812,"سرى عارضُ","https://www.poetsgate.com/ViewPoem.aspx?id=200780",""],[5039,"المسامح كريم","https://www.poetsgate.com/ViewPoem.aspx?id=48114",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5442,"لعل حداة العيش أن يترفقوا","https://www.poetsgate.com/ViewPoem.aspx?id=114754",""],[5442,"أرحها فقد مل الظلام سراها","https://www.poetsgate.com/ViewPoem.aspx?id=114763",""],[5442,"غنى بذكر الحمى فارتاح كل شجى","https://www.poetsgate.com/ViewPoem.aspx?id=114774",""],[5442,"عسى وقفة بالركب يا حادي الركب","https://www.poetsgate.com/ViewPoem.aspx?id=114759",""],[231,"العود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79153&r=&rc=27",""]],"verses":[["وإِيوَانُ كِسْرَى أَسْرَعَتْ شُرُفَاتُهُ","وَقَدْ عَايَنَتْ مَا عَايَنَتْهُ إِلَى الْهَدْمِ",0,"م",1,0],["وَإيوانٌ حَكى إيوانَ كِسرى","تُدارُ عَلَيهِ مِن نَبعٍ حَنايا",1,"ا",3,0],["وأيِّ وادٍ للأسى أو معينْ","فجَّرتِ لحناً من أرقِّ النغمْ",2,"م",1,0],["وأيوب في الحالين أصبح ظافراً","بحال الغنى والجاه والذل والفقر",3,"ر",1,0],["وأيُّ ولاية حَصَلتْ بجهلٍ","ومن ذا نالَ بالكفران أجرا",4,"ر",2,0],["وإيوان مجد برج ليث تخاله","به كوكب الإقبال أصبح مشرقا",5,"ق",2,1],["وأَيُّ وليدٍ للمكارِمِ والعُلا","وأَيُّ رضيعٍ للوقائِع والحَرْبِ",6,"ب",1,0],["وإيوان كسرى قد تساقط بعد ما","بأعلامه ينبيهم من يرودها",7,"د",3,0],["وأيُّ وقتٍ من الأوقاتِ أكرهُهُ","أُجيبُ فيه حِمامي إذْ يناديني",8,"ن",2,0],["وأيُّ وِصالٍ في القضيَّة يُدَّعى","وأكملُ مَنْ في النَّاس لم يدَّع الأمنْا",9,"ن",2,0],["وأيُّ والٍ على غشٍّ طَوِيَّتُهُ","فلَن يفوزَ بخيرٍ أينما ذهَبا",10,"ب",2,0],["وإيواناً علا حصناً وحسناً","وباباً حدثت عنه الرواةُ",11,"ه",1,0],["وَإِيوَانُ كِسْرَى تَدَاعَى سُقوطاً","فَأَبْدى انْكِسَاراً وَذَلَّ افْتِقَارَا",12,"ر",2,0],["وَإِيوَانُ كِسْرَى ارْتَجَّ كُلَّ ارْتِجَاجَةٍ","وَكَانَ كَمَا تَرْوِيهِ أَعْظَمَ إِيوَانِ",13,"ن",1,0],["وَإِيوَانُ كِسْرَى وَهْوَ ذَاكَ وَمُلْكُهُ","كِلاَ الشَّامِخَيْنِ اسْتَشْعَرَا الإِذْنَ بِالحَدِّ",14,"د",1,0],["وأيُّ وجهٍ لأغرٍّ هو اب","نُ الشمس مهما يزهُ خفَّاها",15,"ا",3,0],["وَأَيُّوب إِذ نادى وَقَد طالَ ضُرُّهُ","فَفُرّجَ ما يَشكُو مِنَ الضُرِّ أَيُّوبُ",16,"ب",1,0],["وإيوان كسرى انشقَّ أعلاه مؤذناً","بأن بناءَ الدين عاد يُشَيَّدُ",17,"د",1,0],["وأيوب فيه ق نجا من بلائه","وعوفي مما فيه وانكشف الضر",18,"ر",1,0],["وَأَيُّ وَصلَيهِ مَوجوداً وَمُفتَقَداً","أَولى وَأَجدَرُ أَن تُرعى وَسائِلُهُ",19,"ل",2,0],["وأي واد به عند الضحى نزلوا","لقد تجاهلت في قولي وما عقلوا",20,"ل",3,0],["وأيوب من ضر وأول قطرة","على الأرض كانت فيه من مبدأ المطر",21,"ر",1,0],["وايوان كسرى أنذر الفرس قائلا","هوى ملك كسرى فاجزعي أو تجلدي",22,"د",2,0],["وآيونُ بالعُنُقِ تَحتَ التَّرائِك","بِمزرَاقِ هَكطُورَ أَلفى المَهالِك",23,"ك",1,0],["وَإيوان كِسرى اِنشَقَّ وَاِرتَج","هيبة وَمِنه شَرافات تَعاورها الهد",24,"د",1,0],["وايوان كسرى قد تصدَّع هيبة","لايوانها حتى هوى فهو هامد",25,"د",1,0],["وأيوان صفا مرآه حتى","على الأفلاك فَضِّل بالضياءِ",26,"ا",2,1],["وأي وجهة حرف غاب من زمن","ماعاد يكتبني مذ رام إعتاقي",27,"ق",2,0],["وأي وصالٍ ترومُ إذا","قطعتَ الحبالَ بقلبٍ ويدْ",28,"د",1,0],["وأي وإياك تبكي مثل مبكا الحريم","أبلع الحزن وأطلب ربك ومأنت خايب",29,"ب",1,0],["وإيوان كسرى ما رو الماء غاد من","بحيرته والفرس اغتدت نارهم فحما",30,"م",2,0],["وإيوان كسرى انشق يةوم ولاده","وكان يزل الطرف منه ويزلق",31,"ق",1,0],["وإيوان كسرى شق والنار أخمدت","وساوة لم يجر البحيرة ماها",32,"ا",3,0],["واي وجه مصون لم يحط على","بساط ترب بسلك العز منتسج",33,"ج",1,0],["وإيوان مسرى شق والنار أخمدت","لمولده والجن تقذف بالشهيب",34,"ب",1,0],["وأي وحي لنا تروي رسالته","فيؤمن الناس أفكارا ووجدانا ؟",35,"ن",2,0]]}