{"poems":[[55,"أبا حسن لي في الرجال فراسة","https://www.aldiwan.net/poem29932.html","الطويل"],[75,"ألا هل درى الداعي المثوب إذ دعا","https://www.aldiwan.net/poem11947.html","الطويل"],[74,"عذيري من ساجي اللواحظ أغيد","https://www.aldiwan.net/poem18545.html","الطويل"],[74,"يا دار جيرتنا بسفح الأجرع","https://www.aldiwan.net/poem19161.html","الكامل"],[53,"لهوت عن وصف الطلول الدارسه","https://www.aldiwan.net/poem64573.html","الرجز"],[53,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[68,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[22,"طافت أمامة بالركبان آونة","https://www.aldiwan.net/poem21638.html","البسيط"],[119,"ما كفى الصد والغريم الغرام","https://www.aldiwan.net/poem40594.html","عموديه"],[154,"أتدري من تبارز بالذنوب","https://www.aldiwan.net/poem68506.html","الوافر"],[214,"تفديك روحي تفدي","https://www.aldiwan.net/poem13355.html","المجتث"],[275,"أفي دار قومي يسكن الغرباء","https://www.aldiwan.net/poem35648.html","الطويل"],[290,"للغرب أنت وللمشارق مرجع","https://www.aldiwan.net/poem39407.html","الكامل"],[362,"هنيئا لك الإقبال واليمن والنجح","https://www.aldiwan.net/poem4174.html","الطويل"],[369,"لأي وميض بارقة أشيم","https://www.aldiwan.net/poem60666.html","الوافر"],[385,"رويدا إن للضيق انفراجا","https://www.aldiwan.net/poem48757.html","الوافر"],[412,"لو جادهن غداة رمن رواحا","https://www.aldiwan.net/poem50194.html","الكامل"],[445,"دواليك من دهر يواليك بالنجح","https://www.aldiwan.net/poem34846.html","الطويل"],[445,"عيد ووعد صادق لك بالمنى","https://www.aldiwan.net/poem34852.html","الكامل"],[445,"ثنائي عليك ونعماك فينا","https://www.aldiwan.net/poem34861.html","المتقارب"],[445,"لك الله بالنصر العزيز كفيل","https://www.aldiwan.net/poem34919.html","الطويل"],[463,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[463,"بكرت هيما تحل الربطا","https://www.aldiwan.net/poem56142.html","الرمل"],[463,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[463,"بعينيك يوم البين غيبي ومشهدي","https://www.aldiwan.net/poem56221.html","الطويل"],[463,"دواعي الهوى لك أن لا تجيبا","https://www.aldiwan.net/poem56305.html","المتقارب"],[466,"يا عاقدا وضن الجمال البزل","https://www.aldiwan.net/poem16248.html","الكامل"],[473,"وظالمة الأرداف مظلومة الخصر","https://www.aldiwan.net/poem60110.html","السريع"],[505,"رفرف غصن البان لا بمرق","https://www.aldiwan.net/poem37963.html","الرجز"],[543,"إسألوني عما رأيت بعيني","https://www.aldiwan.net/poem47588.html","عموديه"],[543,"مقدم القائد الأعز نظيرا","https://www.aldiwan.net/poem48180.html","عموديه"],[543,"هو يوم وما أبرئ نفسي","https://www.aldiwan.net/poem48217.html","عموديه"],[567,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[580,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129540","المتقارب"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59430","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55895","البسيط"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128074","الطويل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202145","الرمل"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177827","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27590","الطويل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47133","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87329","الرجز"],[445,"","https://poetry.dctabudhabi.ae/diwan/poem/48108","المتقارب"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116511","الطويل"],[2785,"","https://poetry.dctabudhabi.ae/diwan/poem/203862","الوافر"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94287","المتقارب"],[3098,"","https://poetry.dctabudhabi.ae/diwan/poem/131896","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48443","الطويل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61266","الوافر"],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104832","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66523","المتقارب"],[3749,"","https://poetry.dctabudhabi.ae/diwan/poem/33127","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131048",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114050","الخفيف"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133303","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135885","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135884","الرجز"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125902","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94412","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133112","الوافر"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136387",""],[4984,"الفاصلة .. ، ..","https://www.poetsgate.com/ViewPoem.aspx?id=197617",""],[5131,"ودَّعتُهُ وعلى فؤادي حسرةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=175584",""],[5136,"كتابي يهنى الأمير الخطير","https://www.poetsgate.com/ViewPoem.aspx?id=121491",""],[5136,"قمت ليل الوداع إلا قليلا","https://www.poetsgate.com/ViewPoem.aspx?id=121943",""],[5145,"أذر الدموع فلات حين مجاز","https://www.poetsgate.com/ViewPoem.aspx?id=108241",""],[5155,"أين الفتى السياب!؟","https://www.poetsgate.com/ViewPoem.aspx?id=176271",""],[5442,"قد براها جذب البرى والأزمة","https://www.poetsgate.com/ViewPoem.aspx?id=114766",""],[470,"حشودٌ من الحب والكبرياء","https://www.poetsgate.com/ViewPoem.aspx?id=194105",""],[6031,"عُجْ بالمَطِيِّ علَى مَعَالمِ بُورِي","https://www.poetsgate.com/ViewPoem.aspx?id=46320",""],[6102,"على !!","https://www.poetsgate.com/ViewPoem.aspx?id=184455",""]],"verses":[["فَوَفِّيتُكَ التَعظيمَ قَبلَ أَوانِهِ","وَقُلتُ أَطالَ اللَهُ لِلسَيِّدِ البَقا",0,"ق",2,0],["فَوَفَّيتَها مالَم يَدَع لِضَميرِها","إِلى غايَةٍ مِن بَعدِهِ مُتَطَلَّعا",1,"ع",2,0],["فوفيتني وعدَ الأماني وإنها","سجيةُ إسماعيلَ في صدقِ موعد",2,"د",1,0],["فوفودها من أرضها وسمائها","في مطمحٍ يسعى إليه ومطمع",3,"ع",1,0],["فوَفرُهُ في وقعاتٍ حامسه","ووفْدُه في هَيسَاتٍ هائسه",4,"س",2,0],["فوفودُ السؤال عنه قُعودٌ","مَقْعَدَ الحامدين لا اللُّوام",5,"م",1,0],["فَوَفَّني غَيرَ مَأمورٍ وُعودَكَ لي","فَلَيسَ رُؤياكَ أَضغاثاً مِنَ الحُلُمِ",6,"م",1,0],["فَوَفَّروا مالَهُ مِن فَضلِ مالِهِمُ","لَولا الإِلَهُ وَلَولا سَعيُهُم ذَهَبا",7,"ب",2,0],["فوفاء العهود خلة مجد","وهي من غير اهلها لا ترام",8,"م",1,0],["فوفقني فأنت تمنّ فضلاً","على العاصي وتغفر كلّ حوبِ",9,"ب",1,0],["فوفني حق مدحي","واغنم ثنائي وحمدي",10,"د",2,0],["فوفّقَ بين البأسِ والحلمِ مُقسِطاً","وما العدلُ إِلا أن يَصحَّ جزاء",11,"ا",2,0],["فوفاؤك الروض الأنيق محجة","هميانك المكنون شهد أعذب",12,"ب",1,0],["فَوَفّقَ مَا تَنوِي وَسَدّدَ مَا تَرَى","وَيَسَّر مَا تَأتي وقَرَّبَ مَا تَنحُو",13,"ح",2,0],["فَوفِّرْها بسَعْيِكَ لي فلولا","يَدُ الأَرواحِ ما اجْتُلِبَ الغُيوم",14,"م",1,0],["فَوفى حَق خَدَمتِهِ قِياما","بِما يَرضى المُناجي وَالمُناجا",15,"ج",2,0],["فوفود شكر المُسلمين وَغيرهم","تأتي إِلَيكَ أَعاجِماً وَفِصاحا",16,"ح",2,0],["فَوُفِّيتَ من سعْيِ الجهادِ تجارةً","مضاعَفَةَ الأَضعافِ نامِيَةَ الرِّبْحِ",17,"ح",1,0],["فوفيتمُ ورعيتمُ وسعيتمُ","وحميتمُ الإِسلامَ حَتَّى استَيْقَنا",18,"ن",2,0],["فوَفَّاكَ عنَّا الجزاءَ الجزيلَ","ولقَّاكَ مِنَّا الثناءَ الثمينا",19,"ن",2,0],["فَوُفِّيتَ أَجرَ الصابرين ولا عَدَا","مساعِيكَ فَوزٌ عاجلٌ وَقَبُولُ",20,"ل",1,0],["فوفُّوه حقَّ الشعر وارعَوا ذمامَه","وصحبتَه إن اليسيرَ ذميمُ",21,"م",1,0],["فوفَى جذلانَ حتى ردّني","وقصارى غايتي أن تُغبَطا",22,"ط",2,0],["فوفاءً أبا الوفاء فلم تُقْ","ضَ إذا ما لم تَقْضِ فيَّ النذورُ",23,"ر",1,0],["فوفِّرْ على عجز البُعول صَداقَها","وعرّسْ بها أمَّ البنين وأولدِ",24,"د",1,0],["فوفِّ فقد جَعَلَ الدَّينُ ما","تنفَّلتَ في الجودِ فرضا وُجوبا",25,"ب",2,0],["فوَفى وزادَ على الوَفاءِ بفَضْلهِ","كالغيث يفْضُلُ عنْ جناب المُمْحل",26,"ل",1,0],["فَوَفَّيتُها بِالشُربِ ما تَستَحِقُّهُ","إِلى أَن تَوَفّاني بِها مَلَكُ السَكرِ",27,"ر",1,0],["فوَفِّ عهدي بثَباتٍ واستَقِمْ","إنَّ الثَّباتَ طبعُ أَصحابِ الوَفَا",28,"ف",2,0],["فُوفود الأعيَانِ مِن مِصرَ والشَّا","مِ وهِندٍ ومَغربٍ والصِّينِ",29,"ن",1,0],["فوُفودٌ من كلِّ قُطرٍ تَباهت","بِقُدومٍ لَه تُلَبِّي البَشيرا",30,"ر",2,0],["فُوفودٌ قد أقبلَت بقلُوب","فهىَ قبلَ الأجسَام ذاتُ احتشَادِ",31,"د",1,0],["فَوِّفْ وصُغْ جملاً وأنشدْ وطِبْ زَجَلاً","وانزِلْ على حَرَمٍ من أشطُرِ الخِيَمِ",32,"م",1,0],["فوفدهُم منهمُ مُربحٌ","وفرُّهُمُ مِنْهمُ مخسرُ",33,"ر",1,0],["فوفقه اللَه للصالحات","ورد النوائب عن نفسه",34,"س",2,0],["فوفق وسامح واعف واغفر خطيئتي","فأنت سميع للدعاء قريب",35,"ب",1,0],["فوفق الله إكليلين في زمن","بليلة انسها قد تمّ وانتظما",36,"م",2,0],["فوفاه رضوان الجنان مؤرخا","سليمان باشا جاء في أطيب الخلد",37,"د",1,0],["فوفى ناس وناس نكثوا","وسطا بالأوفياء الناكثون",38,"ن",1,0],["فوفيت نذرا ثم قضيت للمنى","بها تفثا من رمي جمر وحلقكا",39,"ك",2,0],["فوفيتُ ما قد أوجبَ الله فعله","عليّ بتصريفِ القضاءِ مع القدر",40,"ر",1,0],["فَوَفِّ بالوعد مَعْ رسولٍ","أتاك إنّي بذاك شاكِرْ",41,"ر",1,0],["فَوفَاقُكُم مِيزَانُ دِينِ الله لاَ","مَن جَاءَ بِالبُرهَانِ وَالفُرقَانِ",42,"ن",1,0],["فوَفّقنَا لِقِسمَةِ الأزوَامِ","في أنجُمِ النعوشِ بالتَّمَامِ",43,"م",1,0],["فَوَفَّرْتُ فِي الوَجْهِ ماءَ الحياءِ","بِداراً إِلَيْهِ بِماءِ الحَياةِ",44,"ه",1,0],["فوفى بآداب حوت كل مبتفى","عليه وأخلاق تسامت عن الحصر",45,"ر",1,0],["فوفي ما وعدت به، فقالت:","كلام الليل يمحوه النهار",46,"ر",1,0],["فوفق لطاعتك الآن قلبي","ونج غريقا ببحر التعاصي",47,"ص",2,0],["فَوفّق ولاة الأمر بى لطاعة","لدى الأمر والنهى الذى لم يجادل",48,"ل",1,0],["فوفّى حُقوقَ المكْرُماتِ وطالَما","وفَى بعُهودِ المجْدِ والدّهْرُ ناكِثُ",49,"ث",1,0],["فَوفّى دَينَ شَوقي حينَ وافى","وَأَحيا مَيتَ أنسي حينَ حيّا",50,"ي",2,0],["فوفت بموعدها إلي وطالما","باتت تعللني بمطل مواعد",51,"د",1,0],["فوفري منه وودّي له","ووخدي إليه ووجدي عليه",52,"ه",1,0],["فَوَفّى بِفَضلٍ مِن قَضاياهُ مُتَرعا","وَأَصفى لِكُلٍ مِن عَطاياهُ مَورِدا",53,"د",2,0],["فوفاؤهن إذا اعتبرت خيانة","وسحابهن لمن رجاه جهام",54,"م",1,0],["ف وَفِي ذاَك القَبضِ زُهدٌ تَعَرَّف","واعتِلاَءٌ بِهَا تَصَرَّف",55,"ف",1,0],["فوفد سعد بنجم السعد مقترن","له بنجاح حليف أينما كانا",56,"ن",2,0],["فوفِّقَنَّا ربَّنا إلى اتِّباعْ","نبيِّنا عن كلِّ ما هو ابتداعْ",57,"ع",1,0],["فوفِّقَنِّي لطريقٍ وسطى","تحبُّها آخذها ما شطَّا",58,"ط",2,0],["فوفيْتَها بالمكرمات حقوقَها","حقَّ الوفاءِ ولم تكنْ بالنادم",59,"م",1,0],["فوفقهُ يا ذا الجود في كل مأربٍ","وأَيّدهُ ما دام الزَمان تعطفا",60,"ف",2,0],["فوفقني إلهي منك فضلاً","بما ترضى من البر حسانه",61,"ن",2,0],["فوفقت للتقوى وفقت ذوي الهدى","بأعمالك الحسنى وأخلاقك الغرا",62,"ر",2,0],["فوفر للأخطار حفظ خزينة","ليقطع دينا كان من قبله حَوْبا 7",63,"ب",2,0],["فوفى وأنجد كلما ناديتهُ","ولطالما لاقيتُ دربًا مقفرا",64,"ر",2,0],["فوفقك الله فيه ملا","تحب ووقاك صرف القضاء",65,"ا",2,0],["فوفائي بكنه مدحك مولاي","محال ولو أطلت المقولا",66,"ل",2,0],["فوفاته ليست بمرزئةٍ، بلى","هي عند أحرار الزمان مرازي",67,"ز",2,0],["فوفى لها وشدا بها","وهفا لهاتيك الشعاب",68,"ب",1,0],["فوفت بالذي عليها ومثلي","من وفا بالذي لها وأتمه",69,"م",2,0],["فوفّى بها كلّ دين العراق","ووفّت به الأرض أجيالها",70,"ل",3,0],["فَوفَتْ ببَردِ حُشَاشَةِ المحْرُورِ","عَدْلاً ودِفءِ مَضَاجِعِ المقْرورِ",71,"ر",1,0],["فَوَفَيتُ ؛ لَكِن مَا رَعَتْ ذِمَمِي","وَعَدَوتُ فيمَا أَمعَنَتْ كَسَلا",72,"ل",2,0]]}