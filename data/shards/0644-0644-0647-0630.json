{"poems":[[79,"لو أنني فيك بذلت الدنا","https://www.aldiwan.net/poem35888.html","السريع"],[88,"ملكت علي مذاهبي","https://www.aldiwan.net/poem68864.html","مجزوء الكامل"],[95,"إني أقمت على التعلة","https://www.aldiwan.net/poem11123.html","مجزوء الكامل"],[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[53,"قل للأمير أدام الله غبطته","https://www.aldiwan.net/poem10869.html","البسيط"],[53,"ضحك الربيع إلى بكا الديم","https://www.aldiwan.net/poem66296.html","أحذ الكامل"],[63,"قمر تفرد بالمحاسن كلها","https://www.aldiwan.net/poem51541.html","الكامل"],[52,"وردت همومك يوم صاعد","https://www.aldiwan.net/poem63918.html","مجزوء الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55153","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54813","الرجز"],[190,"الدهر في حالتي جمع وتفريق","https://www.aldiwan.net/poem43567.html","البسيط"],[308,"لله ذاك الطرف كم فيه من","https://www.aldiwan.net/poem57989.html","السريع"],[409,"حتى م ذا الدهر بالتشتيت يرمينا","https://www.aldiwan.net/poem33381.html","الرمل"],[438,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[438,"هذا اللوى لا حط منه لواء","https://www.aldiwan.net/poem12549.html","الكامل"],[453,"أترى لداء صبابتي ابلال","https://www.aldiwan.net/poem53722.html","الكامل"],[482,"أما الشباب فشيء عز مطلبه","https://www.aldiwan.net/poem15274.html","البسيط"],[534,"أعلى الذي ألقى طلبت شهودي","https://www.aldiwan.net/poem37458.html","الكامل"],[543,"سقيت بكأس للمنون دهاق","https://www.aldiwan.net/poem47552.html","عموديه"],[580,"لما دعا في الركب داعي الفراق","https://www.aldiwan.net/poem2701.html","السريع"],[816,"","https://poetry.dctabudhabi.ae/diwan/poem/107105","الكامل"],[942,"","https://poetry.dctabudhabi.ae/diwan/poem/123698","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62540","السريع"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131524",""],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53172","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120734","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93533","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87452","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91498","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91648","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85045","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102962","الكامل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107519","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102753","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90757","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94388","البسيط"],[4418,"","https://poetry.dctabudhabi.ae/diwan/poem/95775","البسيط"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89580","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139635",""],[5596,"وادي محرم","https://www.poetsgate.com/ViewPoem.aspx?id=206487",""],[5822,"لله ذُو كبد يكابد فِي الْهوى","https://www.poetsgate.com/ViewPoem.aspx?id=191662",""],[6115,"نوادر الشعر تشبه جمّ عذبٍ زلال","https://www.poetsgate.com/ViewPoem.aspx?id=186438",""]],"verses":[["للّهِ ذِهْنٌ منْكَ مهْما سَرَى","في مُشْكِلٍ لمْ يبْقَ منْ لَبْسِ",0,"س",1,0],["لِلَّهِ ذَيّاكَ الجِوا","رُ وَذَلِكَ العَيشُ الرَخيمُ",1,"م",1,0],["للهِ ذَاكَ النَّهْرُ مَا","أَزْهَى خَمَائلُهُ المُظلَّهْ",2,"ل",2,0],["لله ذاكَ السفح والوادِي الغرد","والماء معسول الرضاب مطَّرد",3,"د",1,0],["لله ذاكَ المنظر المهنى","إنّ معان عن ذراه عدنا",3,"ن",2,0],["للّه ذلك من عيدٍ لقد وثِقتْ","فيه النفوس بركنٍ غير مُنْآدِ",4,"د",1,0],["لله ذاك اليُمْنُ إنَّ له","في المُلْكِ حرفاً غيرَ مُدَّغَمِ",5,"م",1,0],["للهِ ذاك الوجهُ كيفَ تألَّفَتْ","فيه بدائِعُ لم تكنْ تَتألَّفُ",6,"ف",1,0],["لِلَّهِ ذُكرَةُ عاشِقٍ","يَدنو بِها النائي المُباعِد",7,"د",1,0],["لِلهِ ذَاكَ الوَجْهَ المُوَرَّدُ مَا","أَصْبَى وَذَاكَ الوَقَارُ مَا أَحْلَى",8,"ل",2,0],["لِلّهِ ذَاكَ الْخْدُّ مَا أَرْوَعَهُ","لِلّهِ ذَاكَ الْقَدُّ مَا أَبْدَعَهُ",9,"ه",1,0],["لله ذلي ولا للناس في طلي","قوتي كذلّة عشيق لمعشوق",10,"ق",1,0],["لله ذاك الطرفُ كم فيه من","حيفٍ على الصب ومن حين",11,"ن",1,1],["للّه ذاتك ما أصفى خلائقها","كأنها صدف بالدر مشحونا",12,"ن",2,0],["للِّه ذُو ألأَفراسِ غيرَ صَواهلٍ","وسَرَنْدَلِي والماءُ مِنْ مُبْذُولةِ",13,"ه",1,0],["لله ذاك العيشُ إذ لا بيننا","بينٌ ولا عاداتُنا عُدَواءُ",14,"ا",2,0],["لله ذاك العيش مرّ فما حلت","من بعده حال لنا أو مال",15,"ل",1,0],["للهِ ذا القلبُ كم يشكو لوازمَه","مِنَ الغرامِ ويُشجيهِ معذَّبُه",16,"ب",2,0],["للهِ ذاك الْعَهْدُ في ذاكَ اللّقا","ما بَيْنَ ثَهْمَدِ لَعْلَعٍ وزَرُودِ",17,"د",1,0],["للهِ ذيَاكَ العُنَيقُ المُلتوِي","سُبحانَ ربِّي الحُسن في الأعنَاقِ",18,"ق",1,0],["لله ذاك اليوم كم مُقْلَةٍ","غَرْقي وقَلْب بالجَوَى ذي احتراق",19,"ق",1,0],["للَه ذكر لا يزال بخاطري","متصرّف في صفوه متحكّم",20,"م",1,0],["للّه ذاك السلسبيل وقد غدا","يجري لجين الماء فوق صفاته",21,"ت",2,0],["لله ذاك الشيخ في فضله","وعلمه ليس له من ضريبْ",22,"ب",1,0],["لله ذاك المليح كم في حلاه","في كل معنى بديع الإفتنان",23,"ن",1,0],["لله ذكركمُ تفاجئني","بمواهب تأتي ولم أسل",24,"ل",1,0],["لله ذَيَّاكَ الفَرِيقُ فَإنَّهُم","خُصُّوا بِخَالِصَةٍ مِنَ الرَّحمَنِ",25,"ن",1,0],["لله ذاك الفهم يؤتيه الذي","هو أهله من جاد بالاحسان",25,"ن",1,0],["لِلّهِ ذاكَ القبرُ ماذا ضمَّ مِن","فَضلِ الحِجَى ومحاسنِ الآدابِ",26,"ب",1,0],["لِلّه ذكرهم وَإِن","هَجروا مَعنّى القَلب صَبه",27,"ب",2,0],["لِلَّه ذَيّاك الحَبيب وَما أَرى","شَيئاً اشبههُ بِهِ إِلّاهُ",28,"ا",2,0],["لِلّه ذاكَ العَهد وَالعَيش الرَغي","دُ فطالما ساءَ الحَسودَ وَمَن وَشى",29,"ش",2,0],["لِلّه ذاكَ اليَومُ لَو لَم يُبكِنا","خطبُ التَفرّقِ بعدَ حُسنِ جموع",30,"ع",1,0],["لِلَهِ ذاكَ الشادِنُ الشادي الَّذي","قَد حارَ في أَوصافِهِ كَم أَكيَسِ",31,"س",1,0],["للَه ذاك الطيف أوقد فيهم","نارا ومر كأنه لم يوقد",32,"د",1,0],["لِلّهِ ذكرُكِ في البلادِ","غدا مَسيرَ الشمسِ سائر",33,"ر",1,0],["للَه ذا البرق ما اذكاه حين روى","عن برق ثغر الذي في القلب مثواه",34,"ا",2,0],["للَه ذياك الجمال وحبذا","مجلى به ابتهج الحمى والمعهد",35,"د",1,0],["لِلَّه ذاتٌ سمت أَسمى الطباق عُلى","في لين قلبٍ وديعٍ جلَّ فاطرُهُ",36,"ر",2,0],["لِلَّه ذو أدَبٍ حُلوٍ شمائِلُه","لُقياهُ أطيَبُ لي من جُملة النِعم",37,"م",1,1],["لِلَهِ ذا مِن رَبرَبٍ","مِن شَكلِهِ قَرَّ البَصَر",38,"ر",1,0],["لله ذاتٌ منه مصطفوبةٌ","زرَّت على فذِّ الكرام برودها",39,"د",3,0],["لله ذي الفضل والإنعام من سجدت","له الخلائق في ذُلٍّ وإخبات",40,"ت",1,0],["لله ذُو كبد يكابد فِي الْهوى","طمع الْحَرِيص وعفة المتحرج",41,"ج",1,1],["لله ذو القدره القادر صفات الكمال","والناس تخطي دروب العرف ودّلها",42,"ل",3,0]]}