وَإِن نُظِرَت","خَميلَةٌ تُنبِتُ الأَعاجيبا",1,"ب",2,0],["وإنّ دُيوناً ما طَلَتْها صُروفُها","بِبيضِ الظُّبا في هَبوَةِ النّقْعِ تُقْتَضى",2,"ض",2,0],["وإنْ دُعِيَتْ نَزالِ مَشَوا سِراعاً","إِلى الأقْرانِ وابْتَدَرَوْا النِّزالا",3,"ل",2,0],["وإنَّ دُوَيْنَ القاعِ من أرضِ بِيشَةٍ","ظِباءً يُخاتِلْنَ الأُسودَ الضَّوارِيا",4,"ي",2,0],["وَأَندُبا دَهرَنا بِسالِفَتي دِج","لَةَ نَصبو وَنَجتَني اللَذّاتِ",5,"ت",1,0],["وإنّ دونَ طِلابِ الثّأرِ أُسْدَ وَغَى","منْ قوْمِكَ الغُرِّ أو آبائِكَ النُّجُدِ",6,"د",1,0],["وأنْديَةٌ يَنْتابُها البأسُ والنَّدى","فيُخْلَفُ إيعادٌ ويُنْجَزُ مِيعادُ",7,"د",1,0],["وَإِنَّ دُعائي كُلَّ يَومٍ وَلَيلَةٍ","عَلَيكَ بِما أَسدَيتَهُ لَطَويلُ",8,"ل",1,0],["وَإِن دَعا في ثَرى الأَهرامِ ذو أَلَمٍ","أَجابَهُ في ذُرا لُبنانَ مُنتَحِبُ",9,"ب",1,0],["وَإِن دَعَوتُ لِحَيٍّ","يَوماً فَإِيّاكَ أَعني",10,"ن",2,0],["وَإِن دَجا لَيلُ خَطبٍ عَمَّ فادِحُهُ","ذَكا لَهُ النَيِّرانِ الفَضلُ وَالأَدَبُ",11,"ب",1,0],["وَإِنْ دَعَتْهُ إِلَى ذَوْدِ حَمِيَّتُهُ","رَاعَ العُدَاةَ بِمِثْلِ الزَّأْرِ فِي الأَجَمِ",12,"م",1,0],["وَإِن دَنا المِسكينُ مِن بابِهِ","شَدَّ عَلى المِسكينِ بِالسَيفِ",13,"ف",1,0],["وأندلساً أوليتَ ما أنت أهلُهُ","وأوردتها وِرداً من الأمن صافيا",14,"ي",2,0],["وأندبها عند الأغاريد شارباً","من الدمع كأساً لا أريد لها مذقا",15,"ق",2,0],["وَإِنَّ دَفينَ اللُؤمِ يا تَيمُ فيكُمُ","فَقَد أَصبَحَت تَيمٌ مُثاراً دَفينُها",16,"ن",3,0],["وَإِنَّ دِماءَ التَيمِ لَم توفِ عَنهُمُ","دِماءً وَلا يوفي بِرَهنٍ رَهينُها",16,"ن",3,0],["واندُب على الهرمِ الغربيّ لي عمراً","فحبَّذا هرمٌ فارقته وصبا",17,"ب",2,0],["وأندى يداً لو أورقت عود منبر","لما عجب الرائي وإن قيل أينع",18,"ع",1,0],["وأندب للمحراب قنديل غرَّةٍ","بنورِ التقى طول الدجى يتشعشع",19,"ع",1,0],["وأندب للمعروف والبرّ راحةً","ترى راحة تعبانها حين ينفع",19,"ع",1,0],["وأندبها للتربِ من حجب العلى","وديعة أستار إلى عدن تودع",19,"ع",1,0],["وأندبها لليومِ صوماً وللدجى","صلاةً وأذكاراً ونسكاً يوزَّع",19,"ع",1,0],["وإن دعوت به في منطقٍ وندىً","دعوت طائيّ ألفاظٍ وإفضال",20,"ل",1,0],["وا ندامي على التَّخلُّفِ عنهمْ","وقليلٌ عنهُم غَناء نِدامي",21,"م",2,0],["وأنَّ دأْبِي يَجُرُّ لي تَعباً","يُكثِرُ بعدَ الصحاح أسقامي",22,"م",2,0],["وَإِنَّ دُموعي إِثرَهُ لَكَثيرَةٌ","لَو أَنَّ الدُموعَ وَالبُكاءَ يُريحُ",23,"ح",1,0],["وَأَندَمُ بَعدَ الفَوتِ أَوفى نَدامَةٍ","وَأَغدو كَما لا أَشتَهي وَأَروحُ",24,"ح",1,0],["وَإِن دَمِيَت مَناسِمُها وَأَلقَت","بِمَوماةٍ عَلى عَجَلٍ جَنينا",25,"ن",2,0],["وان دينا رسول اللَه مبلغه","ينير حيث بدا الالباب والمهجا",26,"ج",2,0],["واندفاعاً كما قد اندفع الاقوام","قبلا ويقظة من سبات",27,"ت",1,0],["وَاِندَفَعَ القِردُ مُديرُ الكاسِ","فَقيلَ أَحسَنتَ أَبا نُواسِ",28,"س",1,0],["وَأَنَّ دُعاةَ الخَيرِ وَالحَقِّ حَربُهُم","زَمانٌ بِهِم مِن عَهدِ سُقراطَ مولَعُ",29,"ع",1,0],["وَاِندَسَّ كَالمِصباحِ في","حُفَرٍ مِنَ الأَجداثِ جون",30,"ن",1,0],["وإنَّ دَهْراً عَلَوْتَ النّاسَ كُلَّهُمُ","فيهِ فبالجهلِ والخذلانِ مُتّهَمُ",31,"م",1,0],["وَأَنَّ دَماً أَجرَيتَهُ بِكَ فاخِرٌ","وَأَنَّ فُؤاداً رُعتَهُ لَكَ حامِدُ",32,"د",1,0],["وأندى ثراها والغوادي شحيحةٌ","بصوبِ حَياها أن تبلَّ تُرابَا",33,"ب",2,0],["وإنْ دعاكَ له ظِلٌّ فربَّ وَغىً","جعلْتَ ظِلَّكَ منها السُّمرَ والعَذَبا",34,"ب",2,0],["وَإِن دَرَّت نِياقُكَ فَاِحتَلِبها","فَما تَدري الفَصيلُ لِمَن يَكونُ",35,"ن",1,0],["وإنّ دقائقَ ساعاتها","لِعُمْرِكَ آكلةٌ شاربه",36,"ب",2,0],["وإنْ دخلنا فالودادُ القليلْ","واللهِ قَدْ حِرنا فصبرٌ جميلْ",37,"ل",1,0],["وإنْ دُهمنا بسيلٍ أو بنوعِ أذى","كالثلجِ والنارِ حِرْنا ما هو السببُ",38,"ب",1,0],["وَأَنداءٌ تُباكِرُهُ","وَجَونٌ واكِفُ السَبَلِ",39,"ل",1,0],["وَأَندُبَ عَهداً بِالمُشَقَّرِ سالِفاً","وَظِلَّ غَمامٍ لِلصِبا قَد تَقَشَّعا",40,"ع",2,0],["وَأَندُبُ أَشجى رَنَّةٍ مِن حَمامَةٍ","وَأَبكي وَأَقضي مِن ذِمامِ رِمامِ",41,"م",1,0],["وَأَندى مُحَيّا ذَلِكَ العَصرِ مَطلَعاً","وَأَكرَمَ نادي ذَلِكَ الصَحبِ نادِيا",42,"ي",2,0],["وَإِن دَعا الشَقِيُّ بِالطَعامِ","خَيَّطَ جَفنَيهِ عَلى المَنامِ",43,"م",1,0],["وَإِن دُهِموا في مَأزِقٍ قامَ دونَهُم","كَما قامَ جاري النَبلِ دونَ نُباتِ",44,"ت",1,0],["وَإِنَّ دُنياكَ هَذي مِثلُ قائِبَةٍ","وَسَوفَ يَقطَعُ مِنها رَبُّها القوبا",45,"ب",2,0],["وَإِنَّ دُواداً حينَ أَنكَرَ عَقلَهُ","لَغَيرُ مَقيتٍ عِندَ أُمِّ دُوادِ",46,"د",1,0],["وَإِن دَثَرَ القَلبُ فَأسَف لَهُ","وَلا تَبكِيَنكَ رُبوعٌ دُثُر",47,"ر",1,0],["وَإِن دُلِلتَ عَلى شَرٍّ لِتَأتِيَهُ","فَأَنتَ مِنهُ عَلى ما ساءَ مَدلولُ",48,"ل",1,0],["وَأَنَّ دُنيايَ دارٌ لا قَرارَ بِها","وَما أَزالُ مُعَنّاً في مَساعيها",49,"ي",3,0],["وأن دليل النقل إن كان مانعاً","يُأَوَّل بالعقل الذي هو أحكم",50,"م",1,0],["وإن دعون فإني","عبد لهن سميع",51,"ع",1,0],["وإن داءك من بعد اِستحالته","أعيا الأطباء في مصر كَما اِعترَفوا",52,"ف",3,0],["وإن دعام الحذق خلق يقيمه","فإن لم يكن خلق فلا ينفع الحذق",53,"ق",1,0],["وأن دينهم بذاك أجدرُ","وأنهم على قريش أقدرُ",54,"ر",1,0],["واندفعت خيل الإمام تعدو","يقدمها اليمن ويحدو السعدُ",55,"د",1,0],["وَإِن دارَت بِهِم خَيلُ الأَعادي","وَنادَوني أَجَبتُ مَتى دُعيتُ",56,"ت",1,0],["وَإِنْ دَجَا الرَّيْبُ كَوْنِي","أَصْفَى وَأَزْهَى سِرَاجِ",57,"ج",1,0],["وَانْدَسَّ فِي أَحْشَائِهِ","شَيءٌ أَدَقُّ من الذَّرُورْ",58,"ر",1,0],["وإن دنا منكمو قبَّلْتُمُوه كما","يُقَبِّل الحورَ صبٌ يَعْشَق الحورا",59,"ر",2,0],["واندبي المعهد القديم عسى الرج","عة قد آذنت اليه عساها",60,"ا",3,0],["وانداحَتِ الدنيا بناظرِه","حتى لظَنَّ رحابَها نَفَقا",61,"ق",2,0],["وإنّ دنياكَ هذا مثلُ قائبةٍ،","وسوفَ يقطعُ منها ربُّها القوبا",62,"ب",2,0],["وان دارا الى حد نصاحبها","من أحزم الأمر انا لا نصافيها",63,"ي",3,0],["وأن داعة َ الخير والحقِّ حربهم","زمانٌ بهم عهد سُقْراطَ مُولَع",64,"ع",1,0],["وَأَندُب أَياماً أَلذ مِن المَنا","تَقضينَ لي بَينَ الحَطيم وَزَمزَم",65,"م",1,0],["وَاندك طود المَعلوات وَغَيض ما","ء المُكرَمات وَغابَ نجم سُعودي",66,"د",2,0],["وان دمدم الحادي بآيات نعتهم","امات الهوى مني فؤادا واحياه",67,"ا",2,0],["وَإِن دُعيتَ لَغَدرٍ أَو أُمِرتَ بِهِ","فَاِهرب بِنَفسِكَ عَنهُ أَيِّدِ الهَرَبِ",68,"ب",1,0],["وإن داراكَ من عاداك دارِى","ومن والاكَ والِ المستطيعَا",69,"ع",2,0],["وأنداهُم يداً وأشدُّ بطشاً","مَضَوا لم يلبثُوا إلا يسيرَا",70,"ر",2,0],["واندُبَا المَعهَدَ المُحجِيلَ وسُحَّا","في رَجَا عَرَصَتَيهِ دَمعاً جَمُومَا",71,"م",2,0],["وإن دَهَنَ الفَالونَ مِن جَنَباتُها","رَجَّى شعثت من دهنهم جَنَبَاتُها",72,"ت",3,0],["وإن دارت رحى الهيجاءَ يوماً","وشب الحربُ واشتبك العوالي",73,"ل",2,0],["وَاِندُب لَها فِتيَةً عَمائِمُها","بَيضٌ تَلالا وَقُمصُها زَرَدُ",74,"د",1,0],["وَإِن دَعاهُ النَدى لَبَّت مَواهِبُهُ","وَلَم يَحُل دونَها مَطلٌ وَلا عُذُرُ",75,"ر",1,0],["وأن دام هجر الحبّ أو زاد بينه","فذلك داءٌ لم يزل بشفاء",76,"ا",2,0],["وان دنا من السرير دفعوا","في صدرِه ورد رد المجتري",77,"ر",2,0],["وأَن دواة المجد فوق بساطِه","وأقلامُها قد وشّحت كَفَّهُ اليمنى",78,"ن",2,0],["وَإِن دَولَةٌ وَلَّت قَفاها فَوَلِّها","قَفاكَ فَأَعيى كُلّ شَيءٍ رُجوعُها",79,"ع",3,0],["وَإِن دَمَعَت عَينايَ سَوقاً إِلَيكُمُ","فَعَوَّضتُها مِن ذَلِكَ الدَمعُ بِالعَمى",80,"م",2,0],["وَإِن دَجا لَيلٌ بَدا نُورُهُ","لِلرَكبِ نَجماً فَهيَ تَسري بِه",81,"ه",1,0],["واندُبي عهداً مضى كُنتُ به","حائراً أسألُ أشباحَ العَشايا",82,"ي",2,0],["وان دهتنا من الاسقام فادحة","رأَيت منهم لها خير المداوينا",83,"ن",2,0],["وَأَندى عِندَ جَدبِ الناسِ راحاً","وَأَنفَعُ لِلأَراملِ وَالضِعافِ",84,"ف",1,0],["وَإِن دُعيتَ لِغَدرٍ أَو أُمِرتَ بِهِ","فَاِهرَب بِنَفسِكَ عَنهُ أَيَّةَ الهَرَبِ",85,"ب",1,0],["وان دام هذا الدمع يجري صبابة","فاني اخشى منه ان يكثر الغرقى",86,"ق",2,0],["وإن دموع العاشقين لعبرة","ودمعي تبر وهو بالخد جامد",87,"د",1,0],["وَأَنداءُ الصَباحِ تَفوحُ طيباً","وَيَسكُبُها النَسيمُ عَلَيهِ عِطرا",88,"ر",2,0],["وَإِن داهَمَتنا في المَحَبَّةِ ظُلمَةٌ","فَنَأخُذُ نبراساً لَنا مُهجَةَ البَدرِ",89,"ر",1,0],["واندفعتْ عِيدانُه وسطَه","بكلّ ممتدٍّ ومُشْتَدّ",90,"د",1,0],["وَأَندى راحَةً مِنهُ وَكَفّاً","وَقَد جَمِدَت مِنَ السَنَةِ القِطارُ",91,"ر",1,0],["وَإِنَّ دماً أَجراهُ داوودُ دونَهُ","سُيوفُ إِلى الهاماتِ أَوحى وَأَعجلُ",92,"ل",1,0],["واندراجي في دفتر الحبّ حسبي","ذاك فخراً والفخر للمدروج",93,"ج",1,0],["واندرجنا بالانتماء إليه","ضمن درجٍ من المنى مدروج",94,"ج",1,0],["وأندلسُ الجميلةُ عمَّروها","فأطلعتِ الكواكبَ في الدياجي",95,"ج",2,0],["وَأَندب آثار الفَريق بلوعة","وَلا عج وجد بعدهم متجدد",96,"د",1,0],["واندب زَمان اللَهو في عرصاتها","وَمواقف القينات وَالفتيان",97,"ن",1,0],["وأندب سفح البان ايام صبوتي","اليه وَبرد اللهو فيه قَشيب",98,"ب",1,0],["وان دعا فأجبه واحم جانبه","وَصله ما قطعت أَيامه السَبيل",99,"ب",3,0],["وان دَعا فاجبه واحم جانبه","من حاسد شامت أَو ظالم نكد",100,"د",1,0],["وان دعا فأحبه واحم جانبه","يا خير من دفنت في القاع أَعظمه",101,"م",2,0],["وإِن دعوت فاِحتفِل","ولا تَكن كمَن بَخِل",102,"ل",1,0],["وإِن دَعاك من تُحب","إِلى طَعامٍ فأَجِب",102,"ب",1,0],["وَإن دَعتك إلى حظ بشهوتها","فاشرح لها غب ما فيه من التعب",103,"ب",1,0],["وَأنديةٌ بِها قولٌ وفعلٌ","وَعقد لجى وَإِجماع عقيدُ",104,"د",1,0],["وَأَندى على الأكبادِ من مسعفِ المنى","وَأعذبُ في الأفواه من رشفة الضربِ",105,"ب",1,0],["واندبوا حظ امة","غالها غائل المحن",106,"ن",1,0],["واندثَرْ","أحرَقْتُ كلَّ رَسائلي منها",107,"ه",2,0],["وإنْ دَجا ليلُ خطبٍ لا صباحَ له","فكنْ لرأيك في داجِيه مُنتَضيا",108,"ي",2,0],["وإن دُعِيتَ لغدرٍ أو أُمِرتَ به","فاهرُب بنفسِكَ عنه آبِدَ الهَرَبِ",109,"ب",1,0],["وَأَندِيَةٍ خُضرِ مِنَ الخِصبِ دونَها","سُيوفٌ رَمَينَ الجَدبَ في اللُجَجِ الخُضرِ",110,"ر",1,0],["وإِنْ دَعَوْتِ إلى جُلَّى ومَكْرُمَةٍ","يوماً سَراَةَ خِيارِ الناسِ فادْعِينا",111,"ن",2,0],["وإنَّ دمُوعاً سافَرت بحدِيثِنا","تعمُّ بهِ ما عَمَّه العارِضُ الهَتِن",112,"ن",1,0],["وإنَّ دَمعي ليرضيني غداةَ أبى","إلا نِداءً على حالي وإشهارا",113,"ر",2,0],["وإن درسَت مبانيها","فسل للدار بانيها",114,"ي",3,0],["واندقَّ طودُ الكفر منحطّاً به","نحو الحضيض وأدبر الدَبَران",115,"ن",1,0],["وَإِن دَجى خَطبٌ فَآراؤُهُ","كَالشُهُب في جَنح الظَلام البَهيم",116,"م",1,0],["وَإِن دَهمت خُطوب وَأَدلهمت","رَأَينا رَأيُهُ فيها سِراجا",117,"ج",2,0],["وإن دام السرور عليك يوما","ولم تسمح عيونك بالبكاء",118,"ا",2,0],["وإن دَعاهم إلى الإعطاء مُفتْقَرٌ","يلبّه المجدُ والعلياءُ والشيمُ",119,"م",1,0],["وأنداهم كفا إذا حضر العطا","فأعطى وما أكدى ومنَّ وما مَنَّا",120,"ن",2,0],["وإن دواوين الذنوب ثلاثة","ترى واحداً منها مَحَتْها المكارم",121,"م",1,0],["وإن دعا للمبتلى","فهو الدوا المجرب",122,"ب",1,0],["وان دام استنادك في خباء","ليمنعك تصدر للرزيّه",123,"ي",2,0],["واندَخْ سواكِنَ داخلاً في حَوْرِها","واركَبْ على الأَعلى بأَعلى همّةِ",124,"ه",1,0],["وأندب دارا باللوى غير أنني","اقول لها يا دار سلمى ألا اتتلكي",125,"ي",1,0],["واندُبْ لتشييعِهِمْ حَرَّ الزفيرِ ضُحىً","وابعَثْ دموعَكَ فِي آثارِهِ مَدَدَا",126,"د",2,0],["وإِنْ دَجَتِ الخُطوبُ بِهِم عَلَيْهِ","فأَنْتَ لكُلِّ داجيةٍ ضِياءُ",127,"ا",2,0],["وإِنْ دَجا فلَقٌ يوْماً بذي أَمَلٍ","فَذُو الرِّياساتِ طَلقُ الليلِ ناصِعُهُ",128,"ع",2,0],["وإن دفع الشقاء فإن وصلنا","بإذن اللَه زال بها الشقاء",129,"ا",2,0],["وإن دعثت أناس في المخازي","فعرضي صنعت عن كل اندعاث",130,"ث",1,0],["وإن دام هذا الحزن عندي قليله","فقدت مع المفقود من حيث يفقد",131,"د",1,0],["وَإِن دُفن الميت الذي كان فوقها","غدا كلنا في الرعي للموت ناسيا",132,"ي",2,0],["وإن دنا عن رضا من بعد جفوته","له نسجنا برودا تفضح الحللا",133,"ل",2,0],["وأنداء الحقول مشعشعات","بخمر في تجليها الحميم",134,"م",1,0],["واندبْ لها بين يديك ناهضا","يَخلُفُني في ذا الدعاءِ والهنا",135,"ن",2,0],["وأنديةً تسَعُ السامعين","قِرىً ووجوها تَضيف العيونا",136,"ن",2,0],["وأنديةٍ حبُّ العلا من عقودها","وأيدٍ كنوزُ المال تحت كِمامِها",137,"م",3,0],["وأنداهُمُ صارماً أو يداً","تقَحَّمَ أو بَلَّ تُربَ القُحَمْ",138,"م",1,0],["وأنّ دَينَ الشعر في ذمّته","شريعةٌ يدين بالتزامِها",139,"م",3,0],["وأنديةٌ وألسنةٌ هُبوبٌ","إذا انتُضيتْ وأحلامٌ رُكودُ",140,"د",1,0],["وأنديةٌ وأروقةٌ رِحابٌ","تَضُمُّ بدائدَ الفضلِ الشتاتِ",141,"ت",1,0],["وإن دارت الصهباءُ فيهم تجاذبوا","أحاديث مجدٍ تجعل النَّكسَ أروعا",142,"ع",2,0],["وأندياتِ العُلى منهم اذا ثَقُلتْ","تلك الحُبى وغَدا بالذنب غُفرانُ",143,"ن",1,0],["وَأَنداءٌ إِذا سُلَّت عَلَيها","سُيوفُ البَرقِ تُبطَحُ في البِطاحِ",144,"ح",1,0],["وأندبُ ارسمَها الماثلا","ت وجداً عليها وابكي الطُّلُولا",145,"ل",2,0],["واندفعتْ كلُّ بجاويَّةٍ","اِعمالُها نصٌّ واِعناقُ",146,"ق",1,0],["وإن دافَعْتَ عن طبعٍ فأَحْكِمْ","نِظامَ الشَّرْعِ واخْلِصْ في التَّداعي",147,"ع",2,0],["وأنْدُبُ الحَيَّ ودَمعي كَدَمي","ومُقْلَتي مَحْرومَةُ الهُجوعِ",148,"ع",1,0],["وإِنْ دُعيتَ لكلامِ المُصْطَفى","أَطِعْ وحاذِرِ لا تكنْ كمن طغَى",149,"ا",1,0],["وإِنْ دَهى طامِسُ كربٍ فاعْتَصِمْ","باللهِ كم كربٍ بذا الشَّأْنِ انْجَلَى",149,"ا",1,0],["واندب هديت قصور سادات عفت","قد نالهم ريب الزمان ونالها",150,"ل",3,0],["واندباه عني فقد كل فكري","والمراثي ملت حديث لساني",151,"ن",2,0],["وأَنْدُبُ دَهْرَ الجَمْعِ بَعْدَ تَفَرُّقٍ","وأبْكي عَلَيْهِ بالدُّمُوعِ السَّواكِبِ",152,"ب",1,0],["وَإِن دَوَّمَت شَمسُهُ فَوقَهُ","أَظَلَّتهُ غِربانُهُ الحُجَّلُ",153,"ل",1,0],["وإنْ دَعَوْتَ بهمْ في يومِ مَلْحَمَةٍ","جاؤوك شدّاً على الأكوارِ والحُصُنِ",154,"ن",1,0],["وأندُبُ مرموساً بملساءَ قَفرةٍ","فيا ليتني ناديتُ غيرَ دفينِ",155,"ن",1,0],["وأنّ دَيْناً عليكمْ لا قضاءَ له","وأنّ رَهْناً عليكمْ تائِهٌ غَلِقُ",156,"ق",1,0],["وإن دَجَوْا كنت صُبحاً","وَإِن ضَحوْا كنت بَرْدا",157,"د",2,0],["وإنْ دَجَوْا كنت فيهمُ قبساً","أَو خَمدوا كنتَ فيهمُ لَهَبا",158,"ب",2,0],["وإن دام أنتج قدس النفوس","وتطهيرها من قذى حالها",159,"ل",3,0],["وإن دخلت البيت تبغي به","توكُّلاً كيلا ترى الخلقا",160,"ق",2,0],["وإنَّ داراً لوجهِ الحقِّ عاضِدةٌ","لها يدُ اللهِ في تاريخها عَضدَتْ",161,"ت",1,0],["وأندَمُ غافلٍ من صَمَّ سمعاً","قُبيلَ البينِ عن صوتِ النَّذيرِ",162,"ر",1,0],["وإِن دَخَلوا صَمَتوا خُشُّعاً","لأَن المَقامَ لهم هَائِلُ",163,"ل",1,0],["وإِن دجَت في الخطوب معضلةٌ","فهو لإصْباحِ فجْرِها فالِق",164,"ق",1,0],["واندبي المصطفى بحزنٍ شديدٍ","خالطَ القلبَ فهو كالمعمودِ",165,"د",1,0],["واندبي المصطفى فَعَمِّي وخُصِّي","بدموعٍ غزيرةِ الاسرابِ",166,"ب",1,0],["وإن داويت ديناً بالتناسي","وبالليان أخطأت الدواء",167,"و",3,0],["وإن دبَّ من قومي إليك عداوةً","عقاربهُم دبَّت إليهم عَقارِبي",168,"ب",2,0],["وَإِن دَعَوتِ إِلى جُلّى وَمَكرُمَةٍ","يَوماً سُراةَ كِرامِ الناسِ فَاِدعينا",169,"ن",2,0]]}