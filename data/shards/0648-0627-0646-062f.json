{"poems":[[53,"إياك عنه عذل العاذل","https://www.aldiwan.net/poem29842.html","السريع"],[53,"كان قضاء الإله مكتوبا","https://www.aldiwan.net/poem30741.html","المنسرح"],[63,"خضاب على فودي للدهر ما نضا","https://www.aldiwan.net/poem46185.html","الطويل"],[63,"أثرها وهي تنتعل الظلالا","https://www.aldiwan.net/poem46214.html","الوافر"],[63,"بعيشكما يا صاحبي دعانيا","https://www.aldiwan.net/poem46218.html","الكامل"],[55,"امزجا لي بماء دجلة كأسا","https://www.aldiwan.net/poem26444.html","الخفيف"],[77,"قلبي وسمعي في شغل عن الفند","https://www.aldiwan.net/poem36613.html","البسيط"],[77,"زمانك أفراح لدينا وأعياد","https://www.aldiwan.net/poem36614.html","الطويل"],[24,"أترجو اعتذاري يابن أروى ورجعتي","https://www.aldiwan.net/poem21903.html","الطويل"],[86,"لمصر أم لربوع الشام تنتسب","https://www.aldiwan.net/poem10918.html","البسيط"],[86,"يا يوم تكريم حفني","https://www.aldiwan.net/poem68862.html","المجتث"],[71,"ما قام لولا هواك المدنف الوصب","https://www.aldiwan.net/poem4015.html","البسيط"],[93,"نهاية الفخر لي في هذا الكلم","https://www.aldiwan.net/poem11309.html","البسيط"],[54,"يا تارك البيت على الضيف","https://www.aldiwan.net/poem27523.html","السريع"],[83,"معاذ الهوى أن أصحب القلب ساليا","https://www.aldiwan.net/poem54225.html","الطويل"],[88,"ذهبت لحي في فروق تزاحمت","https://www.aldiwan.net/poem44452.html","الطويل"],[27,"ألا إنما تيم لعمرو ومالك","https://www.aldiwan.net/poem4438.html","الطويل"],[72,"أذكى سنا البرق في أحشائه لهبا","https://www.aldiwan.net/poem18234.html","البسيط"],[72,"تذكر جرعاء الحمى فتجرعا","https://www.aldiwan.net/poem19169.html","الطويل"],[72,"أذات الحجى إن الحجاب ليمنع","https://www.aldiwan.net/poem19171.html","الطويل"],[72,"عيد يعود إلى هذا الثنا العالي","https://www.aldiwan.net/poem19474.html","البسيط"],[51,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[51,"يا رب ما أطول البلاء وما","https://www.aldiwan.net/poem66335.html","المنسرح"],[26,"نام الخلي وبت الليل مشتجرا","https://www.aldiwan.net/poem24088.html","البسيط"],[70,"لئن بحت بالشكوى إليك محبة","https://www.aldiwan.net/poem42972.html","الطويل"],[38,"أبت آيات حبى أن تبينا","https://www.aldiwan.net/poem7818.html","الوافر"],[89,"لبيك من آمر يا خير من عزما","https://www.aldiwan.net/poem44739.html","البسيط"],[89,"رمت للقوم نهضة في الحياة","https://www.aldiwan.net/poem44919.html","الخفيف"],[85,"لما دعا داعي أبي الأشبال","https://www.aldiwan.net/poem8042.html","الرجز"],[85,"أبثك وجدي يا حمام وأودع","https://www.aldiwan.net/poem63659.html","الطويل"],[85,"درجت على الكنز القرون","https://www.aldiwan.net/poem63694.html","مجزوء الكامل"],[56,"الكلب فوق أناس أنت مالكهم","https://www.aldiwan.net/poem58516.html","البسيط"],[43,"عواذل ذات الخال في حواسد","https://www.aldiwan.net/poem9528.html","الطويل"],[62,"أهاب به داعي الهوى فأجابا","https://www.aldiwan.net/poem52502.html","الطويل"],[61,"حسب الأمير سماح وطد الحسبا","https://www.aldiwan.net/poem51801.html","البسيط"],[58,"إذا هبت رياحك فاغتنمها","https://www.aldiwan.net/poem30840.html","الوافر"],[80,"وعظت بلمتك الشائبه","https://www.aldiwan.net/poem31548.html","المتقارب"],[69,"إن انقطعنا فالعتاب الثقيل","https://www.aldiwan.net/poem28827.html","السريع"],[69,"وافى الكتاب الذي تعنو له الكتب","https://www.aldiwan.net/poem29125.html","البسيط"],[31,"ألم تربع على الطلل","https://www.aldiwan.net/poem42022.html","مجزوء الوافر"],[74,"سجعت وقد غنى الحمام فرجعا","https://www.aldiwan.net/poem13173.html","الطويل"],[74,"أفي ما تؤدي الريح عرف سلام","https://www.aldiwan.net/poem13260.html","الطويل"],[74,"كفاني شكوى أن أرى المجد شاكيا","https://www.aldiwan.net/poem13277.html","الطويل"],[52,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[50,"فتاتي نديمي غنيا بحياتي","https://www.aldiwan.net/poem64737.html","الطويل"],[46,"لو كنت يعقوب طير كنت أرشد في","https://www.aldiwan.net/poem22128.html","البسيط"],[46,"خوى دن شرب فاستحابوا إلى التقى","https://www.aldiwan.net/poem22453.html","الطويل"],[46,"إذا عثر القوم فاغفر لهم","https://www.aldiwan.net/poem22751.html","المتقارب"],[46,"لأوصين بما أوصت به أمم","https://www.aldiwan.net/poem23136.html","البسيط"],[46,"حسبي من الجهل علمي أن آخرتي","https://www.aldiwan.net/poem23573.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85558","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85579","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85451","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85572","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9902","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54676","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54894","الكامل"],[106,"كلب بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179351",""],[90,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=179230",""],[46,"لو كنتَ يعقوبَ طيرٍ كنتَ أرشدَ، في","https://www.poetsgate.com/ViewPoem.aspx?id=17976",""],[85,"أَبُثُّكَ وَجْدي يا حَمامُ، وأُودِعُ أَبُثُّكَ وَجْدي يا حَمامُ، وأُودِعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9555&r=&rc=45",""]],"verses":[["وانَدَما إِن لَم أَكُن سامِعاً","مَشورَةَ الصِلِّ أَبي وائِلِ",0,"ل",1,0],["وَإِنَّ دُنيا الفَتى وَإِن نُظِرَت","خَميلَةٌ تُنبِتُ الأَعاجيبا",1,"ب",2,0],["وإنّ دُيوناً ما طَلَتْها صُروفُها","بِبيضِ الظُّبا في هَبوَةِ النّقْعِ تُقْتَضى",2,"ض",2,0],["وإنْ دُعِيَتْ نَزالِ مَشَوا سِراعاً","إِلى الأقْرانِ وابْتَدَرَوْا النِّزالا",3,"ل",2,0],["وإنَّ دُوَيْنَ القاعِ من أرضِ بِيشَةٍ","ظِباءً يُخاتِلْنَ الأُسودَ الضَّوارِيا",4,"ي",2,0],["وَأَندُبا دَهرَنا بِسالِفَتي دِج","لَةَ نَصبو وَنَجتَني اللَذّاتِ",5,"ت",1,0],["وإنّ دونَ طِلابِ الثّأرِ أُسْدَ وَغَى","منْ قوْمِكَ الغُرِّ أو آبائِكَ النُّجُدِ",6,"د",1,0],["وأنْديَةٌ يَنْتابُها البأسُ والنَّدى","فيُخْلَفُ إيعادٌ ويُنْجَزُ مِيعادُ",7,"د",1,0],["وَإِنَّ دُعائي كُلَّ يَومٍ وَلَيلَةٍ","عَلَيكَ بِما أَسدَيتَهُ لَطَويلُ",8,"ل",1,0],["وَإِن دَعا في ثَرى الأَهرامِ ذو أَلَمٍ","أَجابَهُ في ذُرا لُبنانَ مُنتَحِبُ",9,"ب",1,0],["وَإِن دَعَوتُ لِحَيٍّ","يَوماً فَإِيّاكَ أَعني",10,"ي",1,0],["وَإِن دَجا لَيلُ خَطبٍ عَمَّ فادِحُهُ","ذَكا لَهُ النَيِّرانِ الفَضلُ وَالأَدَبُ",11,"ب",1,0],["وَإِنْ دَعَتْهُ إِلَى ذَوْدِ حَمِيَّتُهُ","رَاعَ العُدَاةَ بِمِثْلِ الزَّأْرِ فِي الأَجَمِ",12,"م",1,0],["وَإِن دَنا المِسكينُ مِن بابِهِ","شَدَّ عَلى المِسكينِ بِالسَيفِ",13,"ف",1,0],["وأندلساً أوليتَ ما أنت أهلُهُ","وأوردتها وِرداً من الأمن صافيا",14,"ي",2,0],["وأندبها عند الأغاريد شارباً","من الدمع كأساً لا أريد لها مذقا",15,"ق",2,0],["وَإِنَّ دَفينَ اللُؤمِ يا تَيمُ فيكُمُ","فَقَد أَصبَحَت تَيمٌ مُثاراً دَفينُها",16,"ن",3,0],["وَإِنَّ دِماءَ التَيمِ لَم توفِ عَنهُمُ","دِماءً وَلا يوفي بِرَهنٍ رَهينُها",16,"ن",3,0],["واندُب على الهرمِ الغربيّ لي عمراً","فحبَّذا هرمٌ فارقته وصبا",17,"ب",2,0],["وأندى يداً لو أورقت عود منبر","لما عجب الرائي وإن قيل أينع",18,"ع",1,0],["وأندب للمحراب قنديل غرَّةٍ","بنورِ التقى طول الدجى يتشعشع",19,"ع",1,0],["وأندب للمعروف والبرّ راحةً","ترى راحة تعبانها حين ينفع",19,"ع",1,0],["وأندبها للتربِ من حجب العلى","وديعة أستار إلى عدن تودع",19,"ع",1,0],["وأندبها لليومِ صوماً وللدجى","صلاةً وأذكاراً ونسكاً يوزَّع",19,"ع",1,0],["وإن دعوت به في منطقٍ وندىً","دعوت طائيّ ألفاظٍ وإفضال",20,"ل",1,0],["وا ندامي على التَّخلُّفِ عنهمْ","وقليلٌ عنهُم غَناء نِدامي",21,"م",2,0],["وأنَّ دأْبِي يَجُرُّ لي تَعباً","يُكثِرُ بعدَ الصحاح أسقامي",22,"م",2,0],["وَإِنَّ دُموعي إِثرَهُ لَكَثيرَةٌ","لَو أَنَّ الدُموعَ وَالبُكاءَ يُريحُ",23,"ح",1,0],["وَأَندَمُ بَعدَ الفَوتِ أَوفى نَدامَةٍ","وَأَغدو كَما لا أَشتَهي وَأَروحُ",24,"ح",1,0],["وَإِن دَمِيَت مَناسِمُها وَأَلقَت","بِمَوماةٍ عَلى عَجَلٍ جَنينا",25,"ن",2,0],["وان دينا رسول اللَه مبلغه","ينير حيث بدا الالباب والمهجا",26,"ج",2,0],["واندفاعاً كما قد اندفع الاقوام","قبلا ويقظة من سبات",27,"ت",1,0],["وَاِندَفَعَ القِردُ مُديرُ الكاسِ","فَقيلَ أَحسَنتَ أَبا نُواسِ",28,"س",1,0],["وَأَنَّ دُعاةَ الخَيرِ وَالحَقِّ حَربُهُم","زَمانٌ بِهِم مِن عَهدِ سُقراطَ مولَعُ",29,"ع",1,0],["وَاِندَسَّ كَالمِصباحِ في","حُفَرٍ مِنَ الأَجداثِ جون",30,"ن",1,0],["وإنَّ دَهْراً عَلَوْتَ النّاسَ كُلَّهُمُ","فيهِ فبالجهلِ والخذلانِ مُتّهَمُ",31,"م",1,0],["وَأَنَّ دَماً أَجرَيتَهُ بِكَ فاخِرٌ","وَأَنَّ فُؤاداً رُعتَهُ لَكَ حامِدُ",32,"د",1,0],["وأندى ثراها والغوادي شحيحةٌ","بصوبِ حَياها أن تبلَّ تُرابَا",33,"ب",2,0],["وإنْ دعاكَ له ظِلٌّ فربَّ وَغىً","جعلْتَ ظِلَّكَ منها السُّمرَ والعَذَبا",34,"ب",2,0],["وَإِن دَرَّت نِياقُكَ فَاِحتَلِبها","فَما تَدري الفَصيلُ لِمَن يَكونُ",35,"ن",1,0],["وإنّ دقائقَ ساعاتها","لِعُمْرِكَ آكلةٌ شاربه",36,"ب",2,0],["وإنْ دخلنا فالودادُ القليلْ","واللهِ قَدْ حِرنا فصبرٌ جميلْ",37,"ل",1,0],["وإنْ دُهمنا بسيلٍ أو بنوعِ أذى","كالثلجِ والنارِ حِرْنا ما هو السببُ",38,"ب",1,0],["وَأَنداءٌ تُباكِرُهُ","وَجَونٌ واكِفُ السَبَلِ",39,"ل",1,0],["وَأَندُبَ عَهداً بِالمُشَقَّرِ سالِفاً","وَظِلَّ غَمامٍ لِلصِبا قَد تَقَشَّعا",40,"ع",2,0],["وَأَندُبُ أَشجى رَنَّةٍ مِن حَمامَةٍ","وَأَبكي وَأَقضي مِن ذِمامِ رِمامِ",41,"م",1,0],["وَأَندى مُحَيّا ذَلِكَ العَصرِ مَطلَعاً","وَأَكرَمَ نادي ذَلِكَ الصَحبِ نادِيا",42,"ي",2,0],["وَإِن دَعا الشَقِيُّ بِالطَعامِ","خَيَّطَ جَفنَيهِ عَلى المَنامِ",43,"م",1,0],["وَإِن دُهِموا في مَأزِقٍ قامَ دونَهُم","كَما قامَ جاري النَبلِ دونَ نُباتِ",44,"ت",1,0],["وَإِنَّ دُنياكَ هَذي مِثلُ قائِبَةٍ","وَسَوفَ يَقطَعُ مِنها رَبُّها القوبا",45,"ب",2,0],["وَإِنَّ دُواداً حينَ أَنكَرَ عَقلَهُ","لَغَيرُ مَقيتٍ عِندَ أُمِّ دُوادِ",46,"د",1,0],["وَإِن دَثَرَ القَلبُ فَأسَف لَهُ","وَلا تَبكِيَنكَ رُبوعٌ دُثُر",47,"ر",1,0],["وَإِن دُلِلتَ عَلى شَرٍّ لِتَأتِيَهُ","فَأَنتَ مِنهُ عَلى ما ساءَ مَدلولُ",48,"ل",1,0],["وَأَنَّ دُنيايَ دارٌ لا قَرارَ بِها","وَما أَزالُ مُعَنّاً في مَساعيها",49,"ي",3,0],["وأن دليل النقل إن كان مانعاً","يُأَوَّل بالعقل الذي هو أحكم",50,"م",1,0],["وإن دعون فإني","عبد لهن سميع",51,"ع",1,0],["وإن داءك من بعد اِستحالته","أعيا الأطباء في مصر كَما اِعترَفوا",52,"ف",3,0],["وإن دعام الحذق خلق يقيمه","فإن لم يكن خلق فلا ينفع الحذق",53,"ق",1,0],["وأن دينهم بذاك أجدرُ","وأنهم على قريش أقدرُ",54,"ر",1,0],["واندفعت خيل الإمام تعدو","يقدمها اليمن ويحدو السعدُ",55,"د",1,0],["وَإِن دارَت بِهِم خَيلُ الأَعادي","وَنادَوني أَجَبتُ مَتى دُعيتُ",56,"ت",1,0],["وَإِنْ دَجَا الرَّيْبُ كَوْنِي","أَصْفَى وَأَزْهَى سِرَاجِ",57,"ج",1,0],["وَانْدَسَّ فِي أَحْشَائِهِ","شَيءٌ أَدَقُّ من الذَّرُورْ",58,"ر",1,0],["وإن دنا منكمو قبَّلْتُمُوه كما","يُقَبِّل الحورَ صبٌ يَعْشَق الحورا",59,"ر",2,0],["وانداحَتِ الدنيا بناظرِه","حتى لظَنَّ رحابَها نَفَقا",60,"ق",2,0],["وإنّ دنياكَ هذا مثلُ قائبةٍ،","وسوفَ يقطعُ منها ربُّها القوبا",61,"ب",2,0],["وأن داعة َ الخير والحقِّ حربهم","زمانٌ بهم عهد سُقْراطَ مُولَع",62,"ع",1,0]]}