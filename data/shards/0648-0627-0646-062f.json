ps://www.aldiwan.net/poem37979.html","السريع"],[498,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[513,"لا تندبن ليلى ولا أطلالها","https://www.aldiwan.net/poem12239.html","الكامل"],[513,"خطبتني الخطوب بالهم لما","https://www.aldiwan.net/poem12295.html","الخفيف"],[527,"أيا بين كم كدرت صفو المشارب","https://www.aldiwan.net/poem37536.html","الطويل"],[534,"أشاقك بالمنتصى منزل","https://www.aldiwan.net/poem23851.html","المتقارب"],[549,"يا طائر الأيك غرد لي على الفنن","https://www.aldiwan.net/poem47158.html","البسيط"],[549,"ألم ترني في كل يوم وليلة","https://www.aldiwan.net/poem47162.html","الطويل"],[549,"يهون عندكم أني بكم أرق","https://www.aldiwan.net/poem47381.html","البسيط"],[549,"أما رأيت ضحيا","https://www.aldiwan.net/poem47867.html","المجتث"],[549,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[556,"طريقتنا قل بأقوالها","https://www.aldiwan.net/poem33500.html","المتقارب"],[556,"إن كنت تدري الرزق في بلدة","https://www.aldiwan.net/poem34330.html","السريع"],[560,"بنى الأمين ابن رسلان الأمير على","https://www.aldiwan.net/poem52624.html","البسيط"],[560,"إذا ذهب الكثير من الكثير","https://www.aldiwan.net/poem52789.html","الوافر"],[573,"غريمي ولكنه الماطل","https://www.aldiwan.net/poem3034.html","المتقارب"],[573,"راح رسولي وجاءني عاشق","https://www.aldiwan.net/poem3045.html","المنسرح"]],"verses":[["وانَدَما إِن لَم أَكُن سامِعاً","مَشورَةَ الصِلِّ أَبي وائِلِ",0,"ل",1,0],["وَإِنَّ دُنيا الفَتى وَإِن نُظِرَت","خَميلَةٌ تُنبِتُ الأَعاجيبا",1,"ب",2,0],["وإنّ دُيوناً ما طَلَتْها صُروفُها","بِبيضِ الظُّبا في هَبوَةِ النّقْعِ تُقْتَضى",2,"ض",2,0],["وإنْ دُعِيَتْ نَزالِ مَشَوا سِراعاً","إِلى الأقْرانِ وابْتَدَرَوْا النِّزالا",3,"ل",2,0],["وإنَّ دُوَيْنَ القاعِ من أرضِ بِيشَةٍ","ظِباءً يُخاتِلْنَ الأُسودَ الضَّوارِيا",4,"ي",2,0],["وَأَندُبا دَهرَنا بِسالِفَتي دِج","لَةَ نَصبو وَنَجتَني اللَذّاتِ",5,"ت",1,0],["وإنّ دونَ طِلابِ الثّأرِ أُسْدَ وَغَى","منْ قوْمِكَ الغُرِّ أو آبائِكَ النُّجُدِ",6,"د",1,0],["وأنْديَةٌ يَنْتابُها البأسُ والنَّدى","فيُخْلَفُ إيعادٌ ويُنْجَزُ مِيعادُ",7,"د",1,0],["وَإِنَّ دُعائي كُلَّ يَومٍ وَلَيلَةٍ","عَلَيكَ بِما أَسدَيتَهُ لَطَويلُ",8,"ل",1,0],["وَإِن دَعا في ثَرى الأَهرامِ ذو أَلَمٍ","أَجابَهُ في ذُرا لُبنانَ مُنتَحِبُ",9,"ب",1,0],["وَإِن دَعَوتُ لِحَيٍّ","يَوماً فَإِيّاكَ أَعني",10,"ي",1,0],["وَإِن دَجا لَيلُ خَطبٍ عَمَّ فادِحُهُ","ذَكا لَهُ النَيِّرانِ الفَضلُ وَالأَدَبُ",11,"ب",1,0],["وَإِنْ دَعَتْهُ إِلَى ذَوْدِ حَمِيَّتُهُ","رَاعَ العُدَاةَ بِمِثْلِ الزَّأْرِ فِي الأَجَمِ",12,"م",1,0],["وَإِن دَنا المِسكينُ مِن بابِهِ","شَدَّ عَلى المِسكينِ بِالسَيفِ",13,"ف",1,0],["وأندلساً أوليتَ ما أنت أهلُهُ","وأوردتها وِرداً من الأمن صافيا",14,"ي",2,0],["وأندبها عند الأغاريد شارباً","من الدمع كأساً لا أريد لها مذقا",15,"ق",2,0],["وَإِنَّ دَفينَ اللُؤمِ يا تَيمُ فيكُمُ","فَقَد أَصبَحَت تَيمٌ مُثاراً دَفينُها",16,"ن",3,0],["وَإِنَّ دِماءَ التَيمِ لَم توفِ عَنهُمُ","دِماءً وَلا يوفي بِرَهنٍ رَهينُها",16,"ن",3,0],["واندُب على الهرمِ الغربيّ لي عمراً","فحبَّذا هرمٌ فارقته وصبا",17,"ب",2,0],["وأندى يداً لو أورقت عود منبر","لما عجب الرائي وإن قيل أينع",18,"ع",1,0],["وأندب للمحراب قنديل غرَّةٍ","بنورِ التقى طول الدجى يتشعشع",19,"ع",1,0],["وأندب للمعروف والبرّ راحةً","ترى راحة تعبانها حين ينفع",19,"ع",1,0],["وأندبها للتربِ من حجب العلى","وديعة أستار إلى عدن تودع",19,"ع",1,0],["وأندبها لليومِ صوماً وللدجى","صلاةً وأذكاراً ونسكاً يوزَّع",19,"ع",1,0],["وإن دعوت به في منطقٍ وندىً","دعوت طائيّ ألفاظٍ وإفضال",20,"ل",1,0],["وا ندامي على التَّخلُّفِ عنهمْ","وقليلٌ عنهُم غَناء نِدامي",21,"م",2,0],["وأنَّ دأْبِي يَجُرُّ لي تَعباً","يُكثِرُ بعدَ الصحاح أسقامي",22,"م",2,0],["وَإِنَّ دُموعي إِثرَهُ لَكَثيرَةٌ","لَو أَنَّ الدُموعَ وَالبُكاءَ يُريحُ",23,"ح",1,0],["وَأَندَمُ بَعدَ الفَوتِ أَوفى نَدامَةٍ","وَأَغدو كَما لا أَشتَهي وَأَروحُ",24,"ح",1,0],["وَإِن دَمِيَت مَناسِمُها وَأَلقَت","بِمَوماةٍ عَلى عَجَلٍ جَنينا",25,"ن",2,0],["وان دينا رسول اللَه مبلغه","ينير حيث بدا الالباب والمهجا",26,"ج",2,0],["واندفاعاً كما قد اندفع الاقوام","قبلا ويقظة من سبات",27,"ت",1,0],["وَاِندَفَعَ القِردُ مُديرُ الكاسِ","فَقيلَ أَحسَنتَ أَبا نُواسِ",28,"س",1,0],["وَأَنَّ دُعاةَ الخَيرِ وَالحَقِّ حَربُهُم","زَمانٌ بِهِم مِن عَهدِ سُقراطَ مولَعُ",29,"ع",1,0],["وَاِندَسَّ كَالمِصباحِ في","حُفَرٍ مِنَ الأَجداثِ جون",30,"ن",1,0],["وإنَّ دَهْراً عَلَوْتَ النّاسَ كُلَّهُمُ","فيهِ فبالجهلِ والخذلانِ مُتّهَمُ",31,"م",1,0],["وَأَنَّ دَماً أَجرَيتَهُ بِكَ فاخِرٌ","وَأَنَّ فُؤاداً رُعتَهُ لَكَ حامِدُ",32,"د",1,0],["وأندى ثراها والغوادي شحيحةٌ","بصوبِ حَياها أن تبلَّ تُرابَا",33,"ب",2,0],["وإنْ دعاكَ له ظِلٌّ فربَّ وَغىً","جعلْتَ ظِلَّكَ منها السُّمرَ والعَذَبا",34,"ب",2,0],["وَإِن دَرَّت نِياقُكَ فَاِحتَلِبها","فَما تَدري الفَصيلُ لِمَن يَكونُ",35,"ن",1,0],["وإنّ دقائقَ ساعاتها","لِعُمْرِكَ آكلةٌ شاربه",36,"ب",2,0],["وإنْ دخلنا فالودادُ القليلْ","واللهِ قَدْ حِرنا فصبرٌ جميلْ",37,"ل",1,0],["وإنْ دُهمنا بسيلٍ أو بنوعِ أذى","كالثلجِ والنارِ حِرْنا ما هو السببُ",38,"ب",1,0],["وَأَنداءٌ تُباكِرُهُ","وَجَونٌ واكِفُ السَبَلِ",39,"ل",1,0],["وَأَندُبَ عَهداً بِالمُشَقَّرِ سالِفاً","وَظِلَّ غَمامٍ لِلصِبا قَد تَقَشَّعا",40,"ع",2,0],["وَأَندُبُ أَشجى رَنَّةٍ مِن حَمامَةٍ","وَأَبكي وَأَقضي مِن ذِمامِ رِمامِ",41,"م",1,0],["وَأَندى مُحَيّا ذَلِكَ العَصرِ مَطلَعاً","وَأَكرَمَ نادي ذَلِكَ الصَحبِ نادِيا",42,"ي",2,0],["وَإِن دَعا الشَقِيُّ بِالطَعامِ","خَيَّطَ جَفنَيهِ عَلى المَنامِ",43,"م",1,0],["وَإِن دُهِموا في مَأزِقٍ قامَ دونَهُم","كَما قامَ جاري النَبلِ دونَ نُباتِ",44,"ت",1,0],["وَإِنَّ دُنياكَ هَذي مِثلُ قائِبَةٍ","وَسَوفَ يَقطَعُ مِنها رَبُّها القوبا",45,"ب",2,0],["وَإِنَّ دُواداً حينَ أَنكَرَ عَقلَهُ","لَغَيرُ مَقيتٍ عِندَ أُمِّ دُوادِ",46,"د",1,0],["وَإِن دَثَرَ القَلبُ فَأسَف لَهُ","وَلا تَبكِيَنكَ رُبوعٌ دُثُر",47,"ر",1,0],["وَإِن دُلِلتَ عَلى شَرٍّ لِتَأتِيَهُ","فَأَنتَ مِنهُ عَلى ما ساءَ مَدلولُ",48,"ل",1,0],["وَأَنَّ دُنيايَ دارٌ لا قَرارَ بِها","وَما أَزالُ مُعَنّاً في مَساعيها",49,"ي",3,0],["وأن دليل النقل إن كان مانعاً","يُأَوَّل بالعقل الذي هو أحكم",50,"م",1,0],["وإن دعون فإني","عبد لهن سميع",51,"ع",1,0],["وإن داءك من بعد اِستحالته","أعيا الأطباء في مصر كَما اِعترَفوا",52,"ف",3,0],["وإن دعام الحذق خلق يقيمه","فإن لم يكن خلق فلا ينفع الحذق",53,"ق",1,0],["وأن دينهم بذاك أجدرُ","وأنهم على قريش أقدرُ",54,"ر",1,0],["واندفعت خيل الإمام تعدو","يقدمها اليمن ويحدو السعدُ",55,"د",1,0],["وَإِن دارَت بِهِم خَيلُ الأَعادي","وَنادَوني أَجَبتُ مَتى دُعيتُ",56,"ت",1,0],["وَإِنْ دَجَا الرَّيْبُ كَوْنِي","أَصْفَى وَأَزْهَى سِرَاجِ",57,"ج",1,0],["وَانْدَسَّ فِي أَحْشَائِهِ","شَيءٌ أَدَقُّ من الذَّرُورْ",58,"ر",1,0],["وإن دنا منكمو قبَّلْتُمُوه كما","يُقَبِّل الحورَ صبٌ يَعْشَق الحورا",59,"ر",2,0],["وانداحَتِ الدنيا بناظرِه","حتى لظَنَّ رحابَها نَفَقا",60,"ق",2,0],["وإنّ دنياكَ هذا مثلُ قائبةٍ،","وسوفَ يقطعُ منها ربُّها القوبا",61,"ب",2,0],["وأن داعة َ الخير والحقِّ حربهم","زمانٌ بهم عهد سُقْراطَ مُولَع",62,"ع",1,0],["وَأَندُب أَياماً أَلذ مِن المَنا","تَقضينَ لي بَينَ الحَطيم وَزَمزَم",63,"م",1,0],["وَاندك طود المَعلوات وَغَيض ما","ء المُكرَمات وَغابَ نجم سُعودي",64,"د",2,0],["وان دمدم الحادي بآيات نعتهم","امات الهوى مني فؤادا واحياه",65,"ا",2,0],["وَإِن دُعيتَ لَغَدرٍ أَو أُمِرتَ بِهِ","فَاِهرب بِنَفسِكَ عَنهُ أَيِّدِ الهَرَبِ",66,"ب",1,0],["وإن داراكَ من عاداك دارِى","ومن والاكَ والِ المستطيعَا",67,"ع",2,0],["وأنداهُم يداً وأشدُّ بطشاً","مَضَوا لم يلبثُوا إلا يسيرَا",68,"ر",2,0],["واندُبَا المَعهَدَ المُحجِيلَ وسُحَّا","في رَجَا عَرَصَتَيهِ دَمعاً جَمُومَا",69,"م",2,0],["وإن دَهَنَ الفَالونَ مِن جَنَباتُها","رَجَّى شعثت من دهنهم جَنَبَاتُها",70,"ت",3,0],["وإن دارت رحى الهيجاءَ يوماً","وشب الحربُ واشتبك العوالي",71,"ي",1,0],["وَاِندُب لَها فِتيَةً عَمائِمُها","بَيضٌ تَلالا وَقُمصُها زَرَدُ",72,"د",1,0],["وَإِن دَعاهُ النَدى لَبَّت مَواهِبُهُ","وَلَم يَحُل دونَها مَطلٌ وَلا عُذُرُ",73,"ر",1,0],["وأن دام هجر الحبّ أو زاد بينه","فذلك داءٌ لم يزل بشفاء",74,"ا",2,0],["وان دنا من السرير دفعوا","في صدرِه ورد رد المجتري",75,"ر",2,0],["وأَن دواة المجد فوق بساطِه","وأقلامُها قد وشّحت كَفَّهُ اليمنى",76,"ن",2,0],["وَإِن دَولَةٌ وَلَّت قَفاها فَوَلِّها","قَفاكَ فَأَعيى كُلّ شَيءٍ رُجوعُها",77,"ع",3,0],["وَإِن دَمَعَت عَينايَ سَوقاً إِلَيكُمُ","فَعَوَّضتُها مِن ذَلِكَ الدَمعُ بِالعَمى",78,"م",2,0],["وَإِن دَجا لَيلٌ بَدا نُورُهُ","لِلرَكبِ نَجماً فَهيَ تَسري بِه",79,"ه",1,0],["واندُبي عهداً مضى كُنتُ به","حائراً أسألُ أشباحَ العَشايا",80,"ي",2,0],["وان دهتنا من الاسقام فادحة","رأَيت منهم لها خير المداوينا",81,"ن",2,0],["وَأَندى عِندَ جَدبِ الناسِ راحاً","وَأَنفَعُ لِلأَراملِ وَالضِعافِ",82,"ف",1,0],["وَإِن دُعيتَ لِغَدرٍ أَو أُمِرتَ بِهِ","فَاِهرَب بِنَفسِكَ عَنهُ أَيَّةَ الهَرَبِ",83,"ب",1,0],["وان دام هذا الدمع يجري صبابة","فاني اخشى منه ان يكثر الغرقى",84,"ق",2,0],["وإن دموع العاشقين لعبرة","ودمعي تبر وهو بالخد جامد",85,"د",1,0],["وَأَنداءُ الصَباحِ تَفوحُ طيباً","وَيَسكُبُها النَسيمُ عَلَيهِ عِطرا",86,"ر",2,0],["وَإِن داهَمَتنا في المَحَبَّةِ ظُلمَةٌ","فَنَأخُذُ نبراساً لَنا مُهجَةَ البَدرِ",87,"ر",1,0],["واندفعتْ عِيدانُه وسطَه","بكلّ ممتدٍّ ومُشْتَدّ",88,"د",1,0],["وَأَندى راحَةً مِنهُ وَكَفّاً","وَقَد جَمِدَت مِنَ السَنَةِ القِطارُ",89,"ر",1,0],["وَإِنَّ دماً أَجراهُ داوودُ دونَهُ","سُيوفُ إِلى الهاماتِ أَوحى وَأَعجلُ",90,"ل",1,0],["واندراجي في دفتر الحبّ حسبي","ذاك فخراً والفخر للمدروج",91,"ج",1,0],["واندرجنا بالانتماء إليه","ضمن درجٍ من المنى مدروج",92,"ج",1,0],["وأندلسُ الجميلةُ عمَّروها","فأطلعتِ الكواكبَ في الدياجي",93,"ج",2,0],["وَأَندب آثار الفَريق بلوعة","وَلا عج وجد بعدهم متجدد",94,"د",1,0],["واندب زَمان اللَهو في عرصاتها","وَمواقف القينات وَالفتيان",95,"ن",1,0],["وأندب سفح البان ايام صبوتي","اليه وَبرد اللهو فيه قَشيب",96,"ب",1,0],["وان دعا فأجبه واحم جانبه","وَصله ما قطعت أَيامه السَبيل",97,"ب",3,0],["وان دَعا فاجبه واحم جانبه","من حاسد شامت أَو ظالم نكد",98,"د",1,0],["وان دعا فأحبه واحم جانبه","يا خير من دفنت في القاع أَعظمه",99,"م",2,0],["وإِن دعوت فاِحتفِل","ولا تَكن كمَن بَخِل",100,"ل",1,0],["وإِن دَعاك من تُحب","إِلى طَعامٍ فأَجِب",100,"ب",1,0],["وَإن دَعتك إلى حظ بشهوتها","فاشرح لها غب ما فيه من التعب",101,"ب",1,0],["وَأنديةٌ بِها قولٌ وفعلٌ","وَعقد لجى وَإِجماع عقيدُ",102,"د",1,0],["وَأَندى على الأكبادِ من مسعفِ المنى","وَأعذبُ في الأفواه من رشفة الضربِ",103,"ب",1,0],["واندبوا حظ امة","غالها غائل المحن",104,"ن",1,0],["واندثَرْ","أحرَقْتُ كلَّ رَسائلي منها",105,"ه",2,0],["وإنْ دَجا ليلُ خطبٍ لا صباحَ له","فكنْ لرأيك في داجِيه مُنتَضيا",106,"ي",2,0],["وإن دُعِيتَ لغدرٍ أو أُمِرتَ به","فاهرُب بنفسِكَ عنه آبِدَ الهَرَبِ",107,"ب",1,0],["وَأَندِيَةٍ خُضرِ مِنَ الخِصبِ دونَها","سُيوفٌ رَمَينَ الجَدبَ في اللُجَجِ الخُضرِ",108,"ر",1,0],["وإِنْ دَعَوْتِ إلى جُلَّى ومَكْرُمَةٍ","يوماً سَراَةَ خِيارِ الناسِ فادْعِينا",109,"ن",2,0],["وإنَّ دمُوعاً سافَرت بحدِيثِنا","تعمُّ بهِ ما عَمَّه العارِضُ الهَتِن",110,"ن",1,0],["وإنَّ دَمعي ليرضيني غداةَ أبى","إلا نِداءً على حالي وإشهارا",111,"ر",2,0],["وإن درسَت مبانيها","فسل للدار بانيها",112,"ي",3,0],["واندقَّ طودُ الكفر منحطّاً به","نحو الحضيض وأدبر الدَبَران",113,"ن",1,0],["وَإِن دَجى خَطبٌ فَآراؤُهُ","كَالشُهُب في جَنح الظَلام البَهيم",114,"م",1,0],["وَإِن دَهمت خُطوب وَأَدلهمت","رَأَينا رَأيُهُ فيها سِراجا",115,"ج",2,0],["وإن دام السرور عليك يوما","ولم تسمح عيونك بالبكاء",116,"ا",2,0],["وإن دَعاهم إلى الإعطاء مُفتْقَرٌ","يلبّه المجدُ والعلياءُ والشيمُ",117,"م",1,0],["وأنداهم كفا إذا حضر العطا","فأعطى وما أكدى ومنَّ وما مَنَّا",118,"ن",2,0],["وإن دواوين الذنوب ثلاثة","ترى واحداً منها مَحَتْها المكارم",119,"م",1,0],["وإن دعا للمبتلى","فهو الدوا المجرب",120,"ب",1,0],["وان دام استنادك في خباء","ليمنعك تصدر للرزيّه",121,"ي",2,0],["واندَخْ سواكِنَ داخلاً في حَوْرِها","واركَبْ على الأَعلى بأَعلى همّةِ",122,"ه",1,0],["وأندب دارا باللوى غير أنني","اقول لها يا دار سلمى ألا اتتلكي",123,"ي",1,0],["واندُبْ لتشييعِهِمْ حَرَّ الزفيرِ ضُحىً","وابعَثْ دموعَكَ فِي آثارِهِ مَدَدَا",124,"د",2,0],["وإِنْ دَجَتِ الخُطوبُ بِهِم عَلَيْهِ","فأَنْتَ لكُلِّ داجيةٍ ضِياءُ",125,"ا",2,0],["وإِنْ دَجا فلَقٌ يوْماً بذي أَمَلٍ","فَذُو الرِّياساتِ طَلقُ الليلِ ناصِعُهُ",126,"ع",2,0],["وإن دفع الشقاء فإن وصلنا","بإذن اللَه زال بها الشقاء",127,"ا",2,0],["وإن دعثت أناس في المخازي","فعرضي صنعت عن كل اندعاث",128,"ث",1,0],["وإن دام هذا الحزن عندي قليله","فقدت مع المفقود من حيث يفقد",129,"د",1,0],["وَإِن دُفن الميت الذي كان فوقها","غدا كلنا في الرعي للموت ناسيا",130,"ي",2,0],["وإن دنا عن رضا من بعد جفوته","له نسجنا برودا تفضح الحللا",131,"ل",2,0],["وأنداء الحقول مشعشعات","بخمر في تجليها الحميم",132,"م",1,0],["واندبْ لها بين يديك ناهضا","يَخلُفُني في ذا الدعاءِ والهنا",133,"ن",2,0],["وأنديةً تسَعُ السامعين","قِرىً ووجوها تَضيف العيونا",134,"ن",2,0],["وأنديةٍ حبُّ العلا من عقودها","وأيدٍ كنوزُ المال تحت كِمامِها",135,"م",3,0],["وأنداهُمُ صارماً أو يداً","تقَحَّمَ أو بَلَّ تُربَ القُحَمْ",136,"م",1,0],["وأنّ دَينَ الشعر في ذمّته","شريعةٌ يدين بالتزامِها",137,"م",3,0],["وأنديةٌ وألسنةٌ هُبوبٌ","إذا انتُضيتْ وأحلامٌ رُكودُ",138,"د",1,0],["وأنديةٌ وأروقةٌ رِحابٌ","تَضُمُّ بدائدَ الفضلِ الشتاتِ",139,"ت",1,0],["وإن دارت الصهباءُ فيهم تجاذبوا","أحاديث مجدٍ تجعل النَّكسَ أروعا",140,"ع",2,0],["وأندياتِ العُلى منهم اذا ثَقُلتْ","تلك الحُبى وغَدا بالذنب غُفرانُ",141,"ن",1,0],["وَأَنداءٌ إِذا سُلَّت عَلَيها","سُيوفُ البَرقِ تُبطَحُ في البِطاحِ",142,"ح",1,0],["وأندبُ ارسمَها الماثلا","ت وجداً عليها وابكي الطُّلُولا",143,"ل",2,0],["واندفعتْ كلُّ بجاويَّةٍ","اِعمالُها نصٌّ واِعناقُ",144,"ق",1,0],["وإن دافَعْتَ عن طبعٍ فأَحْكِمْ","نِظامَ الشَّرْعِ واخْلِصْ في التَّداعي",145,"ع",2,0],["وأنْدُبُ الحَيَّ ودَمعي كَدَمي","ومُقْلَتي مَحْرومَةُ الهُجوعِ",146,"ع",1,0],["وإِنْ دُعيتَ لكلامِ المُصْطَفى","أَطِعْ وحاذِرِ لا تكنْ كمن طغَى",147,"ا",1,0],["وإِنْ دَهى طامِسُ كربٍ فاعْتَصِمْ","باللهِ كم كربٍ بذا الشَّأْنِ انْجَلَى",147,"ا",1,0],["واندب هديت قصور سادات عفت","قد نالهم ريب الزمان ونالها",148,"ل",3,0],["واندباه عني فقد كل فكري","والمراثي ملت حديث لساني",149,"ي",1,0],["وأَنْدُبُ دَهْرَ الجَمْعِ بَعْدَ تَفَرُّقٍ","وأبْكي عَلَيْهِ بالدُّمُوعِ السَّواكِبِ",150,"ب",1,0],["وَإِن دَوَّمَت شَمسُهُ فَوقَهُ","أَظَلَّتهُ غِربانُهُ الحُجَّلُ",151,"ل",1,0],["وإنْ دَعَوْتَ بهمْ في يومِ مَلْحَمَةٍ","جاؤوك شدّاً على الأكوارِ والحُصُنِ",152,"ن",1,0],["وأندُبُ مرموساً بملساءَ قَفرةٍ","فيا ليتني ناديتُ غيرَ دفينِ",153,"ن",1,0],["وأنّ دَيْناً عليكمْ لا قضاءَ له","وأنّ رَهْناً عليكمْ تائِهٌ غَلِقُ",154,"ق",1,0],["وإن دَجَوْا كنت صُبحاً","وَإِن ضَحوْا كنت بَرْدا",155,"د",2,0],["وإنْ دَجَوْا كنت فيهمُ قبساً","أَو خَمدوا كنتَ فيهمُ لَهَبا",156,"ب",2,0],["وإن دام أنتج قدس النفوس","وتطهيرها من قذى حالها",157,"ل",3,0],["وإن دخلت البيت تبغي به","توكُّلاً كيلا ترى الخلقا",158,"ق",2,0],["وإنَّ داراً لوجهِ الحقِّ عاضِدةٌ","لها يدُ اللهِ في تاريخها عَضدَتْ",159,"ت",1,0],["وأندَمُ غافلٍ من صَمَّ سمعاً","قُبيلَ البينِ عن صوتِ النَّذيرِ",160,"ر",1,0],["وإِن دَخَلوا صَمَتوا خُشُّعاً","لأَن المَقامَ لهم هَائِلُ",161,"ل",1,0],["وإِن دجَت في الخطوب معضلةٌ","فهو لإصْباحِ فجْرِها فالِق",162,"ق",1,0]]}