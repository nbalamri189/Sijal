,"وجدُ بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=187579",""],[5277,"القدسُ مرآةُ الضمائر","https://www.poetsgate.com/ViewPoem.aspx?id=194532",""],[5318,"هيَ حُسنيان","https://www.poetsgate.com/ViewPoem.aspx?id=215393",""],[5358,"يمن أنت يا يمن","https://www.poetsgate.com/ViewPoem.aspx?id=206165",""],[5419,"للحبّ غنى الكون","https://www.poetsgate.com/ViewPoem.aspx?id=51997",""],[5431,"قد خُلقنا ملائكا في الطراز","https://www.poetsgate.com/ViewPoem.aspx?id=200154",""],[5720,"بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=199926",""],[402,"دال السكون من الحراك الدائم","https://www.poetsgate.com/ViewPoem.aspx?id=36327",""],[469,"جزتَ في المجد والفعال الشريفِ","https://www.poetsgate.com/ViewPoem.aspx?id=76859",""],[5821,"قالو توفت","https://www.poetsgate.com/ViewPoem.aspx?id=114113",""],[5848,"هي بإختصار","https://www.poetsgate.com/ViewPoem.aspx?id=53447",""],[5853,"لا تشتكِ","https://www.poetsgate.com/ViewPoem.aspx?id=175626",""],[5853,"((عروسة الجنوب))","https://www.poetsgate.com/ViewPoem.aspx?id=175631",""],[5956,"الرقابةُ صاحبةُ العظمةِ المصطنعة","https://www.poetsgate.com/ViewPoem.aspx?id=185621",""],[5956,"سيُنْصِفُها التاريخ إن شاء الله ولو ليس يهمها التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=207820",""],[6093,"قُبْلَةُ المِلْيَارِ","https://www.poetsgate.com/ViewPoem.aspx?id=199427",""],[6127,"أعيذك يا سمراء","https://www.poetsgate.com/ViewPoem.aspx?id=188188",""],[6145,"من نحن ؟","https://www.poetsgate.com/ViewPoem.aspx?id=7794",""],[406,"يا قدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=835&r=&rc=26",""]],"verses":[["هِيَ حِكْمَةٌ للهِ بَالِغَةٌ وَإِنْ","خَفِيَتْ وَذَلِكَ حُكْمُ أَعْدَلِ حَاكِمِ",0,"م",1,0],["هي حرّة تأبى المَذَلّة نفسُها","والدهر أجمعُ عَيّ عن إذلالها",1,"ل",3,0],["هي حال الجوادِ يعدمُ فيها","كلّ شيء لجودِهِ مُغتالِ",2,"ل",1,0],["هِيَ حُلْمِي إذا رَقَدْتُ وهَميِّ","وسُرورِي ومُنْيتي يقظانا",3,"ن",2,0],["هي حسناء ولكن","صبها ليس يثاب",4,"ب",1,0],["هي حسن كل زمان قوم رائح","وجمال كل زمان قوم غادى",5,"د",2,0],["هي حاجةٌ بِكرٌ قضيت وراءَها","أخرى على طَرفِ النجاحِ عَوانُ",6,"ن",1,0],["هِيَ حالانِ شِدَّةٌ وَرَخاءُ","وَسِجالانِ نِعمَةٌ وَبلاءُ",7,"ا",2,1],["هِيَ حَظّي قَدِ اِقتَصَرتُ عَلَيها","مِن ذَواتِ العُقودِ وَالأَطواقِ",8,"ق",1,0],["هي حِكمةُ الإسلامِ يَعرفُ وصفَها","مَن كان من حُكمائه موصوفا",9,"ف",2,0],["هي حِفنةٌ للمشركينَ من الحَصى","خَفَّ الوقورُ لها وطاشَ المِرْجَحُ",10,"ح",1,0],["هِيَ حَوّاء ذَلِكَ الخُلد فاِحذر","لا تَكونَنَّ أَنتَ آدم فيهِ",11,"ه",1,0],["هِيَ حَدّ السوريتين شَمالاً","وَجُنوباً وَما تَنوء مَجالا",12,"ل",2,0],["هيَ حانةٌ شتَّى عجائبها","معروشةٌ بالزّهْرِ والقصبِ",13,"ب",1,1],["هيَ حِصْني يوْمَ الهِياجِ فعَدّي","ها عن الآسِ واسْتَعِدّي العَبيرا",14,"ر",2,0],["هِيَ حلْبَةٌ فِيهَا مَدىً مُتَطَاوِلٌ","لِمُكاِفحِي رَأْيٍ وَلِلأَنْصَارِ",15,"ر",1,0],["هي حلمُ الغابِ في السفحِ الوديع","سلوةُ الراعي إذا ضاع القطيع",16,"ع",1,0],["هي حفلةُ الدين الحنيف، شُهُودها","كشهودٍ بدْرٍ في الجهادِ وخَيْبَرا",17,"ر",2,0],["هي حسرة فازدد وأنت أخو هوى","حقّ الوفاء عليك أن تزدادها",18,"د",3,0],["هي حضرة الجمع ال","علية والجلية في خفاها",19,"ا",3,0],["هيَّ حروفَ اسمِك اللائي دُعِيتَ بها","وائت السباق وإلاَّ فِرَّ مِنْ دُوني",20,"ن",2,0],["هيَ حضرةُ الشيخِ العميد ولم تَزلْ","شربَ العطاشِ ومسرحَ الورّاد",21,"د",1,0],["هي حكمة المعراج عن كثب وعي","ما لا يعيه الدرس والتعداد",22,"د",1,0],["هي حرَّةٌ عربيةٌ فقوامُها","من نجدِها وحُسامُها من هِندِه",23,"د",2,0],["هي حرب البقاء تنتظم الخُل","ق سواءً صغارهم والكبار",24,"ر",1,0],["هِيَ حليةُ الأَدبِ الّتي مُلِّكْتُها","فقضَتْ عَليَّ منَ الغنى أن أعطَلا",25,"ل",2,0],["هي حواء صوتهُا كرذاذٍ","عانقَ الروحَ رقةً وحنانا",26,"ن",2,0],["هي حامل وجنتيها","في أمه يتشفع",27,"ع",1,0],["هي حفلة لولاك ما كانت تقا","م ولا استتب من الحضور حضور",28,"ر",1,0],["هِىَ حَقًّا في الطورِ واللهِ كَانت","مِن سَجينٍ زِيارَةٌ لِسَجينِ",29,"ن",1,0],["هي حفلُ الآدابِ آن ربيعٌ","فاقتِطافاً من زهرِهِ واشتِماما",30,"م",2,0],["هي حرف لها انحراف المعاني","وحشة أدمجت مع الإيناس",31,"س",1,0],["هي حضرة في الشام طاب بها اليمن","وبعلمها والفضل أشرقت الدمن",32,"ن",1,0],["هي حَوْلَنا ماءٌ وطينٌ فانظُروا","مَن خاضَ بينهما أيَطمعُ في النَّقا",33,"ق",2,0],["هِي حُرَّةٌ حاشا لأُمِّ","ك إِنْ فطِنْت ومُسْلِمَه",34,"م",2,0],["هيَ حَسرَةٌ لَم يَلقَها مُتَأخِّرٌ","مِمَّن عَلِمتُ بِهِ وَلا مُتَقَدِّمُ",35,"م",1,0],["هي حيزبون الارض ام بلادها","تردي القرون وتدفن الادهارا",36,"ر",2,0],["هي حُورٌ قد ثوت في غرفٍ","وسط عَدنٍ انما دونَ قرار",37,"ر",1,0],["هي حرة الأفكار في أبوابها","والحر بالنفس العزيزة يفتدي",38,"د",2,0],["هِيَ حجة مَبرورة بقبولها","لَكَ زخرفت بَينَ الأَنام قُصور",39,"ر",1,0],["هي حكمةٌ تُهْدى إليك وإِنما","هي حكمةٌ تُهْدَى إلى سقراط",40,"ط",1,0],["هي حُلَّةُ المجدِ التي لو أنَّها","لِلُّبسِ كانت سندساً واستَبرَقا",41,"ق",2,0],["هِيَ حالٌ لَيْسَ الشَّبَابُ وإِنْ فُضِّ","لَ خَيْراً فِيهَا مِن التَّعْنِيسِ",42,"س",1,0],["هِيَ حُضنُ أمِّكَ في الوَفا","وَيَدَا أبيكَ بمَا استطالا",43,"ل",2,0],["هي حوّاءُ لا تلوموا عميداً","في هَواها إن يقترفْ آثاما",44,"م",2,0],["هي حربٌ ثارت فعمَّت رزايا","ها وليست تنفكُّ في ثوران",45,"ن",1,0],["هي حرفة لكنها","مقرونة بالحرفه",46,"ه",1,0],["هِيَ حبوة الملك الَّذي قَد دبر الد","دُنيا وَكانَ عَلى الهُدى تَدبيرها",47,"ر",3,0],["هي حرة عزيت لام حرة","كرمت ارومتها وطابت مولدا",48,"د",2,0],["هي حسبي وكيف أسلو هواها","وهي تدعى بين الحسان حسيبه",49,"ب",2,0],["هِيَ حَدُّ ما بَينَ الضَلالَةِ وَالهُدى","في دينِنا وَالعُرف دونَ المنكرِ",50,"ر",1,0],["هي حمى العشاق في كل وقت","وجحيم التعذيب والإحراق",51,"ق",1,0],["هي حلم الهوى ومنطلقي الباقي","يدك الحدود سجناً فسجنا",52,"ن",2,0],["هي حبي العاتي وكل غرامي","آه لو أدرك الغرام لجنا",52,"ن",2,0],["هي حضرة القدس التي ضمنت","سرَّ الاله وجهر ما يبدي",53,"د",2,0],["هي حضْرةُ المُلْكِ التي قد أصبحَتْ","غيْثاً وغَوثاً إن حللَتْ حِلالَها",54,"ل",3,0],["هي حضرةُ الموْلَى الخليفَةِ يوسُفٍ","شرَفِ الملوكِ إمامِها مَولاها",55,"ا",3,0],["هِيَ حالةٌ تَمضي بِأَية حيلةٍ","وَالجاهل المغترّ جاهل أَمره",56,"ر",2,0],["هي حجة القدر العزيز على امرئ","يرميه حين يثور بالإجحاف",57,"ف",1,0],["هِيَ حَضرةُ المَولى المُعَظَّمِ قَدرُهُ","قاضي العَساكر مَن سَما شَرَفاً عَلي",58,"ل",2,0],["هي حرب ما