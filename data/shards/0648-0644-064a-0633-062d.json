{"poems":[[56,"تأسفت جارتي لما رأت زوري","https://www.aldiwan.net/poem27564.html","البسيط"],[53,"عزاؤك أن الدهر ذو فجعات","https://www.aldiwan.net/poem8699.html","الطويل"],[53,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[53,"وليس حراما شتم من كان مفحما","https://www.aldiwan.net/poem66352.html","الطويل"],[45,"نسيت وما أنسى عتابا على الصد","https://www.aldiwan.net/poem9558.html","الطويل"],[47,"سقى دار ليلى حيث حلت رسومها","https://www.aldiwan.net/poem65675.html","الطويل"],[68,"يا رب إن كان ذنبي","https://www.aldiwan.net/poem38522.html","المجتث"],[68,"لئن ثلمت حدي صروف النوائب","https://www.aldiwan.net/poem41586.html","الطويل"],[82,"عسى للصبا علم برسم المعالم","https://www.aldiwan.net/poem31293.html","الطويل"],[71,"ألا أيها المولى الذي زار عبده","https://www.aldiwan.net/poem28560.html","الطويل"],[71,"أيا علو دمع العين يغني عن الورد","https://www.aldiwan.net/poem28807.html","الطويل"],[50,"يا من جداه قليل","https://www.aldiwan.net/poem65017.html","المجتث"],[50,"ذكرني الورد ريح إنسان","https://www.aldiwan.net/poem65321.html","المنسرح"],[48,"يتلون أسفارهم والحق يخبرني","https://www.aldiwan.net/poem23165.html","البسيط"],[190,"ينوب المرء نحس فيه نقص","https://www.aldiwan.net/poem44174.html","الوافر"],[190,"وهل ذاك إلا مهمه بين ثلة","https://www.aldiwan.net/poem44178.html","الطويل"],[255,"ما زلت في الدنيا من الهم","https://www.aldiwan.net/poem15036.html","السريع"],[310,"لصادق رعيه القصر السعيد","https://www.aldiwan.net/poem56577.html","الوافر"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[458,"حلمت ولم أعلم أحلمى يقظة","https://www.aldiwan.net/poem61799.html","الطويل"],[592,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48792","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49912","البسيط"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35707","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49567","السريع"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124733","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27623","الطويل"],[2263,"","https://poetry.dctabudhabi.ae/diwan/poem/140242",""],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124783","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124770","الطويل"],[2406,"","https://poetry.dctabudhabi.ae/diwan/poem/100110","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202742","الوافر"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118814","السريع"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65110","الطويل"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121417","الطويل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86527","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114399","البسيط"],[4822,"طربت وما شوقي لباسمة الثغر","https://www.poetsgate.com/ViewPoem.aspx?id=171236",""],[5582,"هوَ الدَّهْرُ فِينا جائِدٌ غَيْرُ جائِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186912",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[520,"قل للمشارف عني","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577570",""]],"verses":[["وَلَيسَ حَيٌّ مِنَ الأَحياءِ نَعلَمَهُ","مِن ذي يَمانٍ وَمِن بَكرٍ وَمِن مُضَرِ",0,"ر",1,0],["وليس حكيمُ القوم بالرَّجل الذي","تكون الرزايا عنده نَقماتِ",1,"ت",1,0],["وليس حُصولُ فائدةٍ حصولاً","إذا ما أخطأ الغرضَ الحصولُ",2,"ل",1,0],["وليس حراماً شتْمُ من كان مُفْحماً","على شاعرٍ قد سامهُ الضَّيمَ سائمُ",3,"م",1,1],["وَلَيسَ حَياءُ الوَجهِ في الذِئبِ شيمَةً","وَلَكِنَّهُ مِن شيمَةِ الأَسَدِ الوَردِ",4,"د",1,0],["وَلَيسَ حَديثُ المَكرُماتِ بِكائِنٍ","يَدَ الدَهرِ إِلّا حَيثُ كانَ قَديمُها",5,"م",3,0],["وَلَيسَ حَسبي إِلّا","بِأَنَّ عَفوَكَ حَسبي",6,"ب",2,0],["وَلَيسَ حَسودٌ يَنشُرُ الفَضلَ عائِباً","وَلَكِنَّهُ مُغرىً بِعَدِّ المَناقِبِ",7,"ب",1,0],["وليس حديثُ الريح إلا تبسّماً","يفتّ حصاةَ القلب بين الحيازمِ",8,"م",1,0],["وليسَ حياءُ الوجهِ في الذئبِ شيمةً","ولكنها من شيمةِ الأسدِ الوردي",9,"د",2,0],["وليسَ حياءُ الوجهِ في الذئبِ شيمةً","ولكنها مِنْ شيمةِ الأسدِ الوردِ",10,"د",1,0],["وَلَيسَ حَولِيَ إِلّا","رِياحُ حُبٍّ تَجولُ",11,"ل",1,0],["وَلَيسَ حَيّانَ مَن عَنَيتُ وَلَ","كِنَّهُما في الهِجاءِ سِيّانِ",12,"ن",1,0],["وَلَيسَ حِبرٌ بِبِدعٍ في صَحابَتِهِ","إِن سامَ نَفعاً بِأَخبارٍ تَقَوَّلَها",13,"ل",3,0],["وليس حسابه واقيه نحسا","وهل تثنى المناحس بالحساب",14,"ب",1,0],["وليس حكيما من تهذب لفظه","وأخلاقه فيها عليه معايب",15,"ب",1,0],["وليس حظي منه إلا اسمُهُ","قَنِعتُ من ذلك بالإِسمِ",16,"م",1,0],["وَليسَ حجابُه إلّا كمالاً","كليلاً دونه البصرُ الحديدُ",17,"د",1,0],["وَلَيسَ حَظّي سِوى هَذا القُصورُ بِلى","لَقَد جُرِرتُ بِأَهوائي لِكُلِّ بِلا",18,"ل",2,0],["وليس حيالي غير نبت مُمرد","يردّد صيحات الوحوش لأوهامي",19,"م",2,0],["وليس حديث النتر والمسح ثابتاً","ولا صح في فعل النبي محمد",20,"د",1,0],["وليس حديد الجند ما أنت مالك","ولكنه العزم القوي المنظم",21,"م",1,0],["وليس حَسنُ السَّجايا بالعجيب لمنْ","أبوهُ ذُهْلٌ فأنَّ النَّسْلَ قَفَّاءُ",22,"ا",2,0],["وَلَيسَ حَريباً مَن أُصيبَ بِمالهِ","وَلكِنّ مَن وارى أَخاهُ حَريبُ",23,"ب",1,0],["وليس حظُّ المرءِ منْ عُمْرِهِ","إلا خُطىً تُحْصَى وأنفاس",24,"س",1,0],["وليس حديث نفسك بالطلاق","بشيءٍ دون نطقٍ واندلاق",25,"ق",1,0],["وليس حجابي غير كوني فلو مضى","قعدت مع المحبوبِ في مقعد الصدق",26,"ق",1,0],["وليس حاتم طي منه أسمح من","أعطى ولا خالد من بالسخاء عني",27,"ن",2,0],["وليس حلالا وطء سريّة ولا","لزوجته في الحيض والدبر اصدد",28,"د",1,0],["وليس حرام الفعل إذ ندب الوفا","به في كتاب الله مع صدق مسند",29,"د",1,0],["وليس حنيني للشئام وإنما","حنيني لأفلاذ الفؤاد الأصاغر",30,"ر",1,0],["وليس حياتهم إِلا حروباً","وأنتِ حياتك الحسناءُ سِلْم",31,"م",1,0],["وليس حالي خافيا عنكُم","يا من هُم في حي قلبي نزول",32,"ل",1,0],["وليس حبابٌ ما علاها وإنّما","تستّر منها الوجه خوفا من الثّلب",33,"ب",1,0],["وليس حليماً من تُقبِّلُ كفَّه","فيرضَى ولكن من تَعَضُّ فيحلم",34,"م",1,0],["وَليسَ حَتماً فِى سِوَى مَاكَعِ أو","كَيَعِ مَجزوماً فَراعٍ مَارَعَوا",35,"ع",3,0],["وَلَيسَ حَتماً فِى سِوَىَ مَا انخَفَضَا","بِاسمِ كَقَولِكَ اقتِضَاءَمَ اقتَضَى",35,"ض",2,0],["وليس حفاظ المرء غلا بليلةً","فياليت ما كان الحفاظ ولا كنا",36,"ن",2,0],["وليسَ حرمةُ أهلِ العلمِ في حُللٍ","بل في حليِّ الرسولِ الطاهرِ الشيمِ",37,"م",1,0],["وليس حنيني للركائب قوضت","فقوض يوم البين من قبلها صبري",38,"ر",2,0],["وَلَيْسَ حَياةُ المَرْءِ فِي غَفَلاتِهِ","وَلَذَّتِهِ إِلاَّ كأَحْلامِ راقِدِ",39,"د",1,0],["وليس حل لخلق ترك ظاهره","حتى يكون عليما بالذي بطنا",40,"ن",2,0],["وليس حكم القوافي","يجوز في كل ساعه",41,"ع",2,0]]}