ewPoem.aspx?id=85373",""],[4693,"الارهاب","https://www.poetsgate.com/ViewPoem.aspx?id=30028",""],[4699,"مساء الحب سيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=155951",""],[4730,"هذا الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=27831",""],[4755,"إِلهُ السّبعين","https://www.poetsgate.com/ViewPoem.aspx?id=183629",""],[4767,"أيام التكريم","https://www.poetsgate.com/ViewPoem.aspx?id=180898",""],[4797,"ودي بك وابيك","https://www.poetsgate.com/ViewPoem.aspx?id=50257",""],[4866,"رمضان","https://www.poetsgate.com/ViewPoem.aspx?id=142236",""],[4884,"ساءَ مَن رأَى","https://www.poetsgate.com/ViewPoem.aspx?id=201903",""],[4984,"يَوْمُ الْاسْتِقْلَالِ","https://www.poetsgate.com/ViewPoem.aspx?id=204988",""],[4988,"مدرسة دنياي","https://www.poetsgate.com/ViewPoem.aspx?id=214087",""],[5008,"ياقلب","https://www.poetsgate.com/ViewPoem.aspx?id=28398",""],[5039,"بعض الأغاني حزينه","https://www.poetsgate.com/ViewPoem.aspx?id=48130",""],[5043,"رسالة إلى عمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=204368",""],[5057,"ثمار المحبّة","https://www.poetsgate.com/ViewPoem.aspx?id=208545",""],[585,"أنرسف بالسلاسل والقيود","https://www.poetsgate.com/ViewPoem.aspx?id=161852",""],[3591,"يا حافظ الشعر ويا شاعراً","https://www.poetsgate.com/ViewPoem.aspx?id=149433",""],[5106,"إعتذارٌ لعمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=137303",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5145,"أسير وقلبي في هواك أسير","https://www.poetsgate.com/ViewPoem.aspx?id=108064",""],[5213,"سل السرب يوم الظعن ما فعل السرب","https://www.poetsgate.com/ViewPoem.aspx?id=170411",""],[5277,"عهدٌ... إلى عهدٍ التميميِّ تلكَ الَّتي كشفتْ بصفعتِها عِوارَنا...","https://www.poetsgate.com/ViewPoem.aspx?id=194810",""],[592,"لك الحمد اللهم يا واسع المجد","https://www.poetsgate.com/ViewPoem.aspx?id=128838",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5409,"تهللت كالعارض الباكر","https://www.poetsgate.com/ViewPoem.aspx?id=155493",""],[5431,"عليك صلاة الروح ...","https://www.poetsgate.com/ViewPoem.aspx?id=190681",""],[5582,"قِفا وَاَسْعِدانِي كَيْ نُحَيِّي المَنازِلا","https://www.poetsgate.com/ViewPoem.aspx?id=187238",""],[5582,"فَما كُنْتُ أَدْرِي أَنْ يَكُونَ سَعِيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=186978",""],[5582,"هوَ الدَّهْرُ فِينا جائِدٌ غَيْرُ جائِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186912",""],[5582,"ألا غَنِّنا بالعامِرِيَّةِ وَاطْرَبِ","https://www.poetsgate.com/ViewPoem.aspx?id=186673",""],[5582,"أَوَجْهُ أُمَيْمٍ ذاكَ شَفَّ بِهِ السِّتْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=63513",""],[5595,"أبا السّجادِ يا كلَّ نبيٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=175953",""],[5609,"المنديل","https://www.poetsgate.com/ViewPoem.aspx?id=215572",""],[243,"مرئية الآلهة","https://www.poetsgate.com/ViewPoem.aspx?id=50562",""],[5764,"الشارع","https://www.poetsgate.com/ViewPoem.aspx?id=174220",""],[5768,"عِيدُكُمْ مُبارَكٌ","https://www.poetsgate.com/ViewPoem.aspx?id=215344",""],[402,"يا حسنها ساعة من العمر","https://www.poetsgate.com/ViewPoem.aspx?id=35939",""],[5790,"سلا خاطري عن زينبٍ ونوار","https://www.poetsgate.com/ViewPoem.aspx?id=111946",""],[5790,"متى بت إلا في هواك موحدا","https://www.poetsgate.com/ViewPoem.aspx?id=112031",""],[5790,"خذوا حذركم من طرفها فهو ساحرُ","https://www.poetsgate.com/ViewPoem.aspx?id=111917",""],[5986,"أيا عترة المختار والسادة الطهر","https://www.poetsgate.com/ViewPoem.aspx?id=162956",""],[6004,"يا عاذلي","https://www.poetsgate.com/ViewPoem.aspx?id=59103",""],[6100,"حصه اللوغان","https://www.poetsgate.com/ViewPoem.aspx?id=52550",""],[6100,"اشتقت لأنفاسك","https://www.poetsgate.com/ViewPoem.aspx?id=52589",""],[6225,"تقويم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80905&r=&rc=174",""]],"verses":[["وَيا عَقَداتِ الرَملِ كَم لِيَ أَنَّةٌ","إِذا ما تَذَكَّرتُ الشَقيقَ مِنَ الرَملِ",0,"ل",1,0],["وَيا عوداً تَنُمُّ عَلى","أَعاليهِ عَناصِرُه",1,"ر",2,0],["وَيَا عَجَباً مِنِّي وَفَرْطِ تَشَيُّعِي","أهِيمُ بِوَجْدِي فِيهِ وَهْوَ ابْنُ مُلْجَمِ",2,"م",1,0],["ويا عُدّةَ المُلْكِ المَرينيِّ كلّما","اسْتَجارَ بهِ في الأمْسِ واليوْمِ والغَدِ",3,"د",1,0],["وَيا عَينُ قَد آنَ الجُمودُ لِمَدمَعي","فَلا سَيلَ دَمعٍ تَسكُبينَ وَلا دَما",4,"م",2,0],["وَيا عَزَّ لَو أَشكو الَّذي قَد أَصابَني","إِلى مُوثَقٍ في قَيدِهِ لَعَدا لِيا",5,"ي",2,0],["ويا عجبً من ذلك الترب كيف لا","يفيضُ ببحر للسماحة مزبدِ",6,"د",1,0],["وَيا عِفَّتي مالي وَما لَكَ كُلَّما","هَمَمتُ بِأَمرٍ هَمَّ لي مِنكَ زاجِرُ",7,"ر",1,0],["ويا عاذِلي إنِّي لنقلك صابرٌ","وإنِّي مقيمٌ ما أقام عسيب",8,"ب",1,0],["ويا عزيزاً يخيطُ العجبُ ناظرَهُ","أذكرْ هوَانك تحت الترب واتَّئدِ",9,"د",1,0],["ويا عجباً حيث اللآلي يتيمة","بفيها وما يبدو بها ذلُّ يتمها",10,"م",3,0],["ويا عاذلاً يقسو عليَّ وما رأى","ثرى لمحة من وجهها وتلين",11,"ن",1,0],["ويا عجباً من أن عمراً مُنادَمٌ","وأني مدحور ألوفٌ مع الدحر",12,"ر",1,0],["ويا عَجَبَاً والدهرُ جمٌّ عجيبُهُ","أيُسْكِرُ ماءٌ حين لا تُسكِرُ الخمر",13,"ر",1,0],["ويا عجَباً والدهر جم عجيبهُ","أيُنْبِتُ طَلٌّ حين لا يُنبت القَطر",13,"ر",1,0],["ويا عجباً والدهر جم عجيبهُ","أيُقمِرُ نَجْمٌ حين لا يُقمِرُ البدر",13,"ر",1,0],["ويا عجباً والدهر جم عجيبهُ","أتَبْهَرُ نار حين لا يَبْهر الفجر",13,"ر",1,0],["ويا عجباً أن لا يكونَ بدا لنا","كشمس الضحى لا بل أجلَّ وأعظما",14,"م",2,0],["ويا عصا كلّ راعٍ","وسيفَ كل محامي",15,"م",2,0],["وَيا عامُ هَل جِئتَنا مُحرَماً","فَنَرجوكَ أَم جِئتَنا مُحرِبا",16,"ب",2,0],["وَيا عَجَباً لَكُم توغِرونَ","عَلى العَرَبِ التامِزَ وَالهَدسَنا",17,"ن",2,0],["وَيا عاذِلي في لَوعَتي لَستُ سامِعاً","فَكَم أَنا لا أُصغي وَأَنتَ تُطيلُ",18,"ل",1,0],["وَياعاذِلي قَد قُلتَ قَولاً سَمِعتُهُ","وَلَكِنَّهُ قَولٌ عَلَيَّ ثَقيلُ",19,"ل",1,0],["وَيا عَجَباً حَتّى السِماتُ تخونني","وَحَتّى اِنتِباهي للصّديقِ مَنامُ",20,"م",1,0],["وَيا عَقارِبَها لا تَعدَمي أَبَداً","شَجّا وَعقراً وَلا نوعاً مِنَ الضَرَرِ",21,"ر",1,0],["ويا عصري وللممدوح تنمى","لك الغرر السنية والحجول",22,"ل",1,0],["وَيا عُيوني الساهِراتِ بَعدَهُم","إِن لَم يَعُدكِ طَيفُهُم لا تَرقُدي",23,"د",2,0],["ويا عِظَةَ الطامحينَ العِظامِ","للاهينَ عن غَدِهِمْ قُنَّعِ",24,"ع",1,0],["وَياعَجَباً لي كَيفَ أَجبُنُ في الهَوى","وَإِنّي لَمِقدامٌ إِذا الذِمرُ أَحجَما",25,"م",2,0],["وَيا عاذِلِيَّ اليَومَ في غَيرِ كُنهِهِ","أَقِلّا مَلامي لاتَ حينَ أَوانِ",26,"ن",1,0],["ويا عَمْرو اتَّخِذْ لِسُوَاعَ بأساً","يُذِلُّ من الطَواغيتِ الجِباها",27,"ا",3,0],["وَيا عَجَبا لِيَشكُرَ إِذا أَغَذَت","لِنَصرِهِمُ رُواةُ اِبنَي دُخانِ",28,"ن",1,0],["وَياعاذِلي هَلّا اِشتَغَلتَ بِسامِعٍ","كَما أَنا مَشغولٌ بِكَأسي عَنِ العَذلِ",29,"ل",1,0],["وَيا عائِبي وَالعَيبُ حَشوُ فُؤادِهِ","تَأَمَّل رُوَيداً لَستَ مِمَن أُحاذِرُه",30,"ر",2,0],["وَيا عَرشَ سُلَيمانٍ","إِذا هَمَّ بِإِسفارِ",31,"ر",1,0],["وَيا عالِماً بِصُروفِ الزَمانِ","كَما عَلِمَ القَومُ مِن ذِلكا",32,"ك",2,0],["وَيا علْم قد طبت من موردٍ","وإن لناس إليك أواما",33,"م",2,0],["وَيا عنادل غني","وَيا غصون أظلِّي",34,"ل",2,0],["ويَا عَجَبَا لِلدَّهْرِ أَنَّى أَصَابَهُ","ومِنْ مِثْلِ مَا لاَقى ابْنُ عَفَّانَ يُعْجَبُ",35,"ب",1,0],["وَيَا عَرُوسَانِ إِنَّ أَثْبَتَ مَا","يُبْنَى بِنَاءَ بِناءَ الوَفَاءِ بِالطُّهْرِ",36,"ر",1,0],["وَياعاذِلي فيهِ جَوابُكَ حاضِرٌ","وَلَكِن سُكوتي عَن جَوابِكَ أَصلَحُ",37,"ح",1,0],["وَيا عَجَباً مِن أَنَّ مِبضَعَ فاصِدٍ","تَلَقَّيتَهُ لَم يَنصَرِف نابِيَ الحَدِّ",38,"د",1,0],["ويا عقلاء العرب هذا زمانكم","فكونوا لمن ضلّ المحجّة ، هاديا",39,"ي",2,0],["ويا عجبا لكم توغرون","على العرب \" التامز والهندسنا \"",40,"ن",2,0],["ويا عيون الريم ريم الفلا","ويا قوام الغصن الرطب",41,"ب",1,0],["ويا عروس جمالٍ حال جلوتها","لشانها الحجب عن الواجها ارتفعت",42,"ت",1,0],["ويا عدل خذ بالعدل والقهر ظالمي","لطيف بلطف منك جدلى مدى عمري",43,"ر",2,0],["وَيا عَلَمَ المَجدِ قاضي القُضاةِ","وَيا سَيِّدَ الوُزَراءِ الأَجَلّ",44,"ل",1,0],["وَيا عِذَارَيْهِ هَاكُما كَبِدِي","فَابْتَدِرَا نَحْوَها بِسَيْفَيْنِ",45,"ن",1,0],["ويا عاذلي هل جئت بدعا بما ترى","أليس الهوى مما تعم به البلوى",46,"و",2,0],["ويا علماء الدين ما العذر في غد","من الله ان عوتبتم في التدابر",47,"ر",1,0],["ويا عجباً من الأقدارِ تجري","وبعدَ وقوعِ ما تجري تدارُ",48,"ر",1,0],["ويا عذولي عنه لا تلهني","فالعشق جد ليس فيه مزاح",49,"ح",1,0],["ويا عاذلي عنه لا أرعوي","ولو كان وجدي به محرقي",50,"ق",2,0],["ويا عذارَيه ما أُحَيْسِنَ ما","برزتما فيه لي بعُذْرَين",51,"ن",1,0],["وَيا عاذِليَّ الآمِريَّ بِتَركِهِ","نَهاني هَواهُ أَن أَطيعَ وَأَقبلا",52,"ل",2,0],["ويا عينا يعرفنا رعينا","بعزِّ العزم عند المجمعين",53,"ن",1,0],["وَيا عَذولي خَلِّ تَكرارَكَ ال","دُروسَ في لَومي وَتَفنيدي",54,"د",2,0],["وَيا عصرَ الشباب عليك منّي","مَدى الدَهر التحيَّةُ وَالسَلامُ",55,"م",1,0],["وَيا عيني اسعدي أَنْ بتُّ شوقاً","أُريقُ من المدامعِ ما أُريق",56,"ق",1,0],["ويا عجباً ما أتت ريبةً","وألزمها أنها تقلعُ",57,"ع",1,0],["وَيا عَين قرّي إِنّ شَمس دِيارنا","بَدَت وَغَمام الغَمّ زالَ وَأقشعا",58,"ع",2,0],["وَيا عَذبات الرند قَد عذب الهَوى","فَما أَعذب التَعذيب عِندي إِذا صَحّا",59,"ح",2,0],["ويا عَذولي ومَن يُصْغي إلى عَذَلٍ","إذا رنا أحورُ العَيْنَيْنِ ذو هَيف",60,"ف",1,0],["وَيا عاذِلي رِفقاً كَفاني صُدودُهُ","فَإِن شِئتَ فَاِنقُص مِن مَلامِكَ أَو زِدِ",61,"د",1,0],["ويا عَبيدَ الغَراميلِ التي نَزَلَت","بِهم من المَجدِ في الأَعلى مِن القُلَلِ",62,"ل",1,0],["ويا عين سحّي من دموعٍ سخينةٍ","وشحّي علي بالمرائي البهية",63,"ه",1,0],["وَيا عَذّلي في الهَوى","أَما لِيَ مِن عاذر",64,"ر",1,0],["ويا عَذَبات البَانِ مِن سفْحِ حَاجرٍ","هَلِ السَّفحُ معمور الربوع على عَهْدي",65,"د",2,0],["ويا عاذلي إن كنت تطلب سلوتي","فأطلق فؤادي فهو في ربقةِ الأسرِ",66,"ر",1,0],["ويا عذولي تَرَفَقْ لا تلُمْ كَلِفاً","يهيمُ ما بينَ أنجادٍ وأغوارِ",67,"ر",1,0],["ويا عصبة من هاشم قاسمية","إلى كم ترون الجور إحدى المفاخر",68,"ر",1,0],["ويا علماء الدين مالي أراكُم","تغاضيتم عن منكرات الأوامر",68,"ر",1,0],["ويا عجباً يا عمرُو من غفلة بنا","لقد مازجت قلباً وقد خالطت لُبَّا",69,"ب",2,0],["وَيا عَجَباً للدَّستِ كَيفَ جَفافه","وَفي كُلِّ عقد مِن أَنامِلِهِ نَهرُ",70,"ر",1,0],["ويا عباباً غدا في الرمس منقبضاً","وهل سمعت بأن البحر ينقبضُ",71,"ض",1,0],["ويا عَجَبَ الليالي أَيُّ بَحْرٍ","تَغَلْغَلَ بَيْنَ أَثناءِ الغُثَاءِ",72,"ا",2,0],["ويَا عِيدَ أَعْيادٍ توافَتْ فأَشْرَقَتْ","عَلَى الدِّينِ والدُّنيا وكُنتَ أَجَلَّها",73,"ل",3,0],["ويا عَجَب الأَيَّامِ أَخْفَرْنَ ذِمَّةً","لِمَلْكٍ متى تَسْتَوفِهِ الْعَهْدَ يُوفِها",74,"ف",3,0],["ويا عجباً مني لغيري موقر","وأغلث بالأهوى التقي وأعاجم",75,"م",1,0],["ويا عجباً منا نطاوع أنفساً","إِلى كل جلاب المكاره تزهق",76,"ق",1,0],["ويا عجباً مني لكم أبعث العزا","وإني لمنكم في الفقيدة أولق",76,"ق",1,0],["ويا عجباً ميتاً يعزيه ميت","على ميت والموت ما عنه معتق",77,"ق",1,0],["ويا عجباً مني لفقدان أحمد","فتى قاسم أبقى فيا عجباً مني",78,"ن",2,0],["ويا عجباً من ميت زار ميتاً","على ميت عزاه من قبله بانا",79,"ن",2,0],["ويا عذبات الرند ما بين رامة","وسلع متى مرت بكن الرواحل",80,"ل",1,0],["ويا علماً تنساخ أضواء فضله","فنرعى له في النأي ما لم يكن يخفى",81,"ف",2,0],["ويا عيد رتل أحب الأغاني","أغاني للحق لا تغفل",82,"ل",1,0],["ويا عُرَيْصات القليب من لوى","نعمانَ فالأثيل من جرعاها",83,"ا",3,0],["ويا عاذلي أنى اهتديتَ لناحلٍ","أسىً ضلَّ عنه الطيف إلا أنينه",84,"ن",2,0],["ويا عَطَشاً كلُّ جَدْبِ العصور","سَيَشربُ من وِرْدِهِ الزَّمزَمِ",85,"م",1,0],["ويا عذولي كفَّ عن لومي فقد","آليتُ لا أُعطي العذولَ مسمعي",86,"ع",2,0],["ويا عجب يبغي استتار حقائق","ولما الستر بان له ذنب",87,"ب",1,0],["ويا عجبا حر يصير بنطقه","أسيرا أما يثنى عنان لساني",88,"ن",2,0],["ويا عَذَباتِ البانِ من جانِبِ اللِّوا","أَفيضي لنا من نَشْرِ مِعْطارِهِمْ شمَّا",89,"م",2,0],["ويا عَجيباً لِخَمولٍ جاهِلٍ","يَقولُ إنِّي في الغَرامِ مُبْتَلى",90,"ل",2,0],["ويا عَجَباً لِحبِّي","على شُؤُني اطِّلاعُ",91,"ع",1,0],["ويا عاذلي لو تذوق الهوى","لكنتَ على حبّها عاذري",92,"ر",2,0],["ويا عاصماً لِي من الموبقاتِ","وما كنتُ أطمعُ في عصمتي",93,"ي",1,0],["ويا عربياً أرادوني أموت أساً","في حبهم وأرى دوني رقى بهمِ",94,"م",1,0],["ويا عشائرُ باسمِ الله مَنزِلُكم","ويا قوافِلُ باسمِ اللهِ مَجراكِ",95,"ك",1,0],["ويا عرباً قد فرق الجهل جمعها","وصارت لصرف الدهر من جملة الأسرار",96,"ر",1,0],["ويا عرب نجد والحجاز وقيتموا","ولا زلتم للدين والوطن الذخرا",96,"ر",2,0],["ويا عينُ إِن أَبصرتِ في الناس غيرَهم","فما أَنْتَ يا إِنسانُها قَطُّ إِنْسَاني",97,"ن",2,0],["ويا عَوْرَةَ الحظِّ الذي صَارَ غُرَّةً","بقومٍ خِسَاسٍ قد كَسَاهُمْ وعرَّاني",97,"ن",2,0],["ويا عَاطِلاً مِنْ عِقدِها إِنَّ أَدْمُعِي","لأَكبَرُ ممَّا فِيهِ مِنْ ذلِك الحَبِّ",98,"ب",1,0],["ويا عمادَ الدِّين يا من لَهُ","كُلُّ مبارٍ في المعالي مُبار",99,"ر",1,0],["وَيا عاذِلي أَقصَرَ فَلَستَ بَوازِعي","أَطَلتَ بِتَعنيفي عَلى غَيرِ طائِلِ",100,"ل",1,0],["وَيا عارِضاً ما شَرَى بَرقُهُ","عَنِ الخَيرِ والشَّرِّ إلاَّ صَدَق",101,"ق",1,0],["ويا عَفَّ الإزارِ لقد رُزينا","عَلَى الاسبُوعِ طاهِرةَ الإزار",102,"ر",1,0],["ويا عينُ غابَ اليوم بدركِ فارقُبي","لفرقتهِ تحت الدُجَى الأَنجُم الزُهرا",103,"ر",2,0],["وَيا عالَماً في واحد قَد بَدا لَنا","وَيا صاحب المَعروف وَالنهي وَالأَمر",104,"ر",1,0],["وَيا عالماً في واحد عم نَفعه","جَميع عِباد اللَه في كُل وجهة",105,"ه",1,0],["ويا عنبرةَ الهندِ","ويا مسكةَ دارين",106,"ن",1,0],["وَيا عَفيفي مِن أَذى البَرغوثِ","خذ عَنّي الكَربَ وَكُن مغيثي",107,"ي",1,0],["ويا عيون َالمها بين َالرصافةِ وَالْ","كرْخ ِالحَزين ِاستعادَ اللهفة َاللَّهَفُ",108,"ف",1,0],["ويا عجباً لأحتكام الهوى","على قلب من حُكمه ممتثل",109,"ل",1,0],["ويا عدل يا ديان يا ملك الورى","ويا حي يا قيوم يا حق يا حكم",110,"م",1,0],["ويا عالم الأسرار يا موضح الهدى","ويا منزل القرآن يا مظهر الحكم",110,"م",1,0],["ويا عبد رب العرش يا ذكره الذي","تعوّذ من كيد العدا بالتمائم",111,"م",1,0],["ويا عون المقل أجب دعائي","فإني قد دعوتك باضطراري",112,"ر",2,0],["ويا عريف النقا رقوا فقد لعبت","بصبكم في حمى ليلى الصبابات",113,"ت",1,0],["وَيا عجباً لألحاظٍ مراضٍ","تُصاد بهنّ أَفئدةٌ صحاحُ",114,"ح",1,0],["وَيا عاذلاً مهلاً ورفقاً لمدنفٍ","مَتى يلحه اللّاحي يحنّ وينحبِ",115,"ب",1,0],["وَيا عجباً لعاذل مد","نفٍ قَد ظلّ يلحيهِ",116,"ي",2,0],["وَيا عجباً منهُ يكرّ ودرعهُ","مكسّرة فيها المثقّفةُ السمرُ",117,"ر",1,0],["وَيا عاذلي في هند رفقاً بمهجةٍ","تَذوبُ مَدى الأيّام شوقاً إلى هندِ",118,"د",1,0],["ويا عصمة للحق تُفْضي أواخر","إليها كما تفضي إليها أوائل",119,"ل",1,0],["ويا عجباً لإقدام المنايا","عليه كيف جسَّرها الهجوم؟",120,"م",1,0],["ويا عينه ما حكاك الشهاب","ويا صوته مثلك المدفع",121,"ع",1,0],["ويا عاقب الله الغرام بمثله","لكي يعذر العشاق فيمن تولَّعا",122,"ع",2,0],["ويا عدل في أحكامه وقضائه","وفي خلقه والرزق والفاعلية",123,"ه",1,1],["ويا عالماً أن القضاء صِناعةٌ","إِذا لم يرمها ذو القضا في القضا قضى",124,"ض",2,0],["ويا عاذلي في حب ليلى وما عسى","تروم وميثاقي على الحب ميثاقي",125,"ق",2,0],["ويا عيسُ لو حملتِ بعضَ صبابتي","غداة النّوى ظلَّت بك الأَرض تزْلقُ",126,"ق",1,0],["وَيَا عَينَيَّ إِن لَم تَستَهِلا","ثَكِلتُكُمَا إِذاً بَينَ السِّحَابِ",127,"ب",1,0],["ويا عاذلي لا ترج مني في الهوى","بذاك سلوا عن أهيل مودّتي",128,"ي",1,0],["ويا عَرضي هدرتُ دِماك جوداً","ويا عِرضي اقترح شرف القصاص",129,"ص",1,0],["ويا عينَه ارحمي مُهجتي","فأَنتِ هو السحر بل أسحر",130,"ر",1,0],["ويا عليًّا زان مفرقَهُ","نورٌ من الآباء مرتسم",131,"م",1,0],["ويا عبرتي كفّي ويا ناقتي قفي","ويا شيبتي احتجي ويا صبوتي ادرجي",132,"ج",2,0],["ويا عَرْفَ الصبا إني ضعيف","نظيرك أو كناظرها عليل",133,"ل",1,0],["وَيَا عَاذِلي لَوْلاَ نَفَاسَةُ حُبِّها","عَلَيْكَ لَمَا بَالَيْتَ أنَّكَ خَابِرُهْ",134,"ر",2,0],["وَيَا عَجَباً مِنْ حُبِّ مَنْ هُو قَاتِلي","كأنِّيَ أَجْزِيهِ المَوَدَّةَ مِنْ قَتْلي",135,"ل",2,0],["ويا عاذلي سمعاً إليكَ وطاعةً","بما لم تكن تألو ولا كنتُ أحْفَل",136,"ل",1,0],["ويا علم الأعلام كم خفقت قلو","ب قومٍ إلى مرأى حفافيك فاخفق",137,"ق",1,0],["ويا عظم خطب المسلمين بفقدهم","أمام أصابتهم به عين نافس",138,"س",1,0],["وَيا عَجَبَ النَفسِ مِن مَوقِفٍ","تَبَدَّلَ بَعدَ الهَوى بِالمَلَل",139,"ل",1,0],["ويا عز قد عز التواصل بيننا","وطارت بذاك العيش عنقاء مغرب",140,"ب",1,0],["وَيا عَجَباً ضِدانِ فيكَ تَجَمعا","فُؤادك يُقصيني وَأَنتَ تُعاقب",141,"ب",1,0],["ويا عجبي والداءُ منها سرى إلى","فؤادي يجري في عروقي واضلعي",142,"ع",2,0],["ويا عابدَ اللَهِ الذي وافقَ اسمهُ","مُسَمّاهُ فهوَ في العبادة غامِرُ",143,"ر",1,0],["ويا عجباً إن المعين هو الذي","يكون مُعاناً ردُّه شاهد البَينِ",144,"ن",1,0],["ويا عجباً من فرحةٍ كيف قورنَتْ","بترحةٍ قلبٍ حلَّ فيه عظيم",145,"م",1,0],["ويا عنيقيد قستَ وفرته","فيك فإن استطع شربت دمك",146,"ك",1,0],["ويا عز دين الله صوت مثوب","له فيك مدحٌ كالفريد مُرصّعٌ",147,"ع",1,0],["ويا عماداً لركن الدين تنصره","بمقول الحق إن أركانه انصدعت",148,"ت",1,0],["ويا عفاة الورى صبراً فان أبا","الأمين أكرم من جاءوا ومن غبروا",149,"ر",3,0],["ويا عجبي هذا ثبير رأيته","وقد حملته للرجال كواهل",150,"ل",1,0],["وَيا عَجَباً مِن مُدَّعِينَ فَضيلَةً","بِنزرٍ مِن الأَوراقِ ذاتِ إِنقاضِ",151,"ض",1,0],["وَيا عَجَباً أَنّي أُسَرُّ بِحُبِّه","وَروحيَ عَن جُثمانِيَ اليَومَ سائِرُ",152,"ر",1,0],["وَيا عارِضاً كَالعارض الجون إِستجز","مِن الفِكرِ ما أَعطاكَ عندَ كلالِهِ",153,"ل",2,0],["ويا عدَماً يزداد حسنك كلّما","خبرتُ وجوداً قبحُه متراكم",154,"م",1,0],["ويا عيني لك البشرى فنامي","وتهنيك السلامة يا فؤادي",155,"د",2,0],["وَيا عَيبه الفَضل الَّذي لَم يَزَل بِه","معاناً عَلى أَهل الفَساد مُؤيدا",156,"د",2,0],["وَيا عالم الدُنيا وَعالم أَهلها","وَمَن مَلأَ السَبع الطِباق جَلالا",157,"ل",2,0],["وَيا عَين الخلاصة من مناف","وَمن بِجوارهم تحمى الذمام",158,"م",1,0],["ويا علم الفيوم ما من ضلالة","ونار جز الباغي لراسك اضرام",159,"م",1,0],["ويا عذولي إلى كم","تطيل فيهم ملامكْ",160,"ك",1,0],["وَيا عجباً أشتاقُ خلوة من غدا","وَمثواهُ ما بين الحشا والترائبِ",161,"ب",1,0],["ويا عيد مولاي المليك تحيّةُ","فإنّك آتٍ بالمسرّات مُفعَما",162,"م",2,0],["ويا عماداً له ألقت أزمتها ال","عليا فأمسى ملاذ الناس كلهم",163,"م",1,0],["ويا عين أنصفت ببغضك شخصه","وإنك مهما تأمري القلب يفعلي",164,"ل",2,0],["ويا عين من أهوى سواه ترفقي","بسهميك في أعشار قلب مقتل",164,"ل",1,0],["ويا عين كفي من دموعك إنما","تثير الجوى بين الضلوع المدامع",165,"ع",1,0],["ويا عقيق الخد هل لي على","بارق ذاك الثغر من منحنى",166,"ن",2,0],["ويا عقرت ركائب سيرتكم","إلى الشام المشومة في عناء",167,"ا",2,0],["ويا عجباً يعزى إلى الجود حاتم","وما هو منه في اللهى واللهازم",168,"م",1,0],["وَيا عَجَباً إِنّي لَكاتِمُ حُبِّها","وَقَد شاعَ حَتّى قُطِّعَت دونَها السُبلُ",169,"ل",1,0],["ويا علة الايجاد في كل عالم","ومن بيديه الأمر مهما يشأ يمض",170,"ض",1,0],["ويا عجبا للبدر كيف ضياؤه","وقد غاب في بطن الثرى من ينازله",171,"ل",2,0],["ويا عَذاباً رآهُ جاهلٌ عَذِبا","ولم يَكُن لِذَوي الأَلبابِ بالعَذِبِ",172,"ب",1,0],["ويا عياذي يا ملاذ الورى","إن لم تكن ترحم من يرحم",173,"م",1,0],["وَيا عَينُ ما أَجرى انسكابَ مدامعي","عَلى ما جَرى بَعد الفراق وَما جَرى",174,"ر",2,0],["وَيا عَين كم نبكي صديقاً مهذباً","وَخلّاً حميداً ذا وَقار وَرقّة",175,"ه",1,0],["وَيا عَين جُودي بِالمَدامع وَاسفحي","عَلى رَوض تربٍ حَلَّ فيه أَخو البَدر",176,"ر",1,0],["ويا عارفيه لا تضنوا بذكره","ففي الذكر رجعى من يد الموت ناجيةْ",177,"ي",2,0],["ويا عجبًا منا نسائل أنفسًا","إذا سئلت حارت وليس تُحير",178,"ر",1,0],["وَيا عِماداً لِبَيتِ الفَضلِ يَرفَعُهُ","وَكانَ مِن ضَعفِهِ يلفى عَلى خَطرِ",179,"ر",1,0],["وَيا عاذِلَيَّ عَلامَ العَنا","دَعاني وَرَبُّ الجَمالِ الغَريبِ",180,"ب",1,0],["ويا عجباً من في حبضي ومادني","لوادي كسان من قتيل مسند",181,"د",1,0],["ويا عجباً لنا والحب داءُ","يفاجيء الحرَّ بالحَين المحينِ",182,"ن",1,0],["ويا عجباً كيفَ يثبتُ حا","دثٌ مع من له وصفُ القدم",183,"م",1,0],["ويا عليُّ يا كبير يا حفيظْ","شرّ الدنيّ رُدَّ عني والغليظْ",184,"ظ",1,0],["ويا عدلُ في الظُّلاَّم نفِّذ لعدلكا","ونفِّذْ لنا فضلاً يدوم مع السير",185,"ر",1,0],["ويا عليُّ يا عظيمُ متعالْ","عنا شرورَ الخلقِ صدَّ كلَّ حالْ",186,"ل",1,0],["ويا عزيزُ رافعٌ ويا رفيعْ","أعزّنا عند الرفيع والوضيعْ",186,"ع",1,0],["ويا عظيمُ باريء لي فعظِّما","يا متعالي أعلِ قدري سلِّما",187,"م",2,0],["ويا عليُّ يا عظيمُ متعالْ","عنّي فاردُدْ شرَّ قولي والفعالْ",188,"ل",1,0],["ويا عزيزُ يا عفوُّ باعثْ","صُدَّ شرور من لعهدٍ ناكثْ",188,"ث",1,0],["ويا عظيمُ يا قويُّ يا متينْ","ويا عزيزُ يا معزُّ للمَهينْ",189,"ن",1,0],["ويا عليُّ يا كبيرُ كافي","ويا كفيلُ شافي يا معافي",189,"ي",1,0],["ويا عزيز يا علي يا عظيمْ","أعزَّني وأعلِ قدري يا عليمْ",190,"م",1,0],["وَيا عِلّة الدُّنيا وَمَن بَدو خَلقها","له وَسَيتلو البدو في الحشر تَعقيبُ",191,"ب",1,0],["ويا عينَ الرَّقيبِ سخِنْتِ عيناً","فَما أَغنى شهادك إِذ رَعاني",192,"ن",2,0],["ويا عصر الحديد أوثق وصفد","وكهرب يا زمان الكهرباء",193,"ا",2,0],["ويا عمرك اللَه لا تتركيه","بين المعافى وبين الودي",194,"د",2,0],["ويا عين أن غاض بحر الدموع","فسحّي عليه دماً أحمرا",195,"ر",2,0],["ويا عجبا من نحركم للعدى به","وما قد عهدنا قط نحرا لدى فطر",196,"ر",1,0],["ويا عينا همى جودا فأضحى","به زهر الأيادي ذا ابتسام",197,"م",1,0],["ويا عديم المثل والمثال","رقيت أعلى رتب المعالي",198,"ي",1,0],["ويا عجباً ما ابيض مفرق طفلكم","ومن دمكم وجه البسيطة محمر",199,"ر",1,0],["ويا عروة وثقى فمستمسك به","على قدم الأقدام لن يتزلزلا",200,"ل",2,0],["وَيا عَذوليَ فيهِ دع ملامَك لي","فما أرى فيه لي نُصحاً ولو كانا",201,"ن",2,0],["ويا عُيونَ الَمها غُضِّي فَقَد نَظَرت","أحداقُهُ وَسَلي أَجفانُهُ وَطَفا",202,"ف",2,0],["ويا عجبا لم تخسف الأرض عندما","بدت ولها بين الخيام عويل",203,"ل",1,0],["ويا عريباً بكثبان اللوى نزلوا","وبالعقيق وذات الرند والحزم",204,"م",1,0],["ويا عجبَا من ظالمٍ رامَ نصرةً","فهيهاتَ هذا من ظلومٍ مُخَاتِلِ",205,"ل",1,0],["وَيا عَجَباً كَم تَدّعي أَحدِيَة","وَهيَ عَلى التَحقيقِ غايَةُ وَحدَةِ",206,"ه",1,0],["ويا عجباً من جهل كل فراشةٍ","تعارض مصباحي لتحرقها وقدي",207,"د",2,0],["ويا عَجَباً حتى النّسيمُ يخُونُنى","ويُضرِمُ نيرانَ الأسى بِهُبوبِهِ",208,"ه",1,1],["ويا عجبي من الايام اني","تهيج البوم ينعب في النهار",209,"ر",1,0],["ويا عوناً لناصره وملجىً","وغوثاً للولى على التنائي",210,"ا",2,0],["ويا عيلم العلم الذي صب صوبه","علو ما على الستِّ الجهات بسحبه",211,"ب",2,0],["وَيا عاذِلي كَرِّر فَإِنّي وَإِن أَكُن","إِلى العَذلِ لا أُصغي فَلِلذِكرِ سامِعُ",212,"ع",1,0],["ويا عقيق ثغره ضم على","لؤلؤه لعله لا يدركه",213,"ك",2,0],["وياعل عود هيل من فوقه الترب","يرسل عليه المغفرة والسكوني",214,"ن",2,0],["ويا عود الأراك سقاك غيث","ولن يفنيك جور الاحتطاب",215,"ب",1,0],["ويا عينان تختصران","بين جفونها لغتي",216,"ت",2,0],["وياعجباً يموت حبيبُ ربي","وآخرُ من تودِّعهُ النّساءُ",217,"ا",2,0],["ويا عِبادي مِن هُتافاتِكُم","في ساحةِ التغييرِ إِني سَقيمْْ",218,"م",1,0],["ويا عقداً يلوح على","صدور الخُرَّدِ الغِيد",219,"د",1,0],["وياعزوة اخوانك ومطلب هذولاك","ناس (ن) محبة والدك تدعيها",220,"ي",3,0],["ويا عسى ذا الشهر يعطي بالكثير","من هدايا للذي قلبه عفا",221,"ف",2,0],["ويا عينُ صبراً، ولا تجْزعي","وواسي فؤادي بصبْرٍ أَمَرّْ",222,"ر",1,0],["وَيَا عِيدُ مَا نَبْضُ الْقَرِيحَةِ يَافِعٌ","رُوَيْدَكَ قَدْ حَلَّ الْجَفَافُ بِأَغْصَانِي",223,"ن",2,0],["ويا عاشق الدنيا ترى هم واتعاس","خسران من يتبع هواه ومزاجه",224,"ج",2,0],["وياعين هلي دمعك بتالي الليل","ترى دموع العشق ماحدٍ نقدها",225,"د",3,0],["وياعنّها ماجت حياتي لو أخفيت","اني مع المجداف خنت السفينه",226,"ن",2,0],["ويا عمرو لوانّك كنت فينا","لأبكاك المآل دماً سخينا",227,"ن",2,0],["ويا عِشقاً أبوحُ بِهِ بِفَخرٍ","إذا العشاقُ كنّوا واستعاروا",228,"ر",3,0],["ويا علماء هذا الشرق هبوا","إلى نزع الدخائل والحقود",229,"د",1,0],["ويا عرين الشعر في مصر لا","أقويت من ضرغامك الخادر",230,"ر",1,0],["وَيَاْ عَمْرُوْ ابْن كُلْثُوْمٍ حَرَاْمٌ","لِأَنْ تَبْكِيْ وَنَحْنُ ضَاْحِكُوْنَاْ",231,"ن",2,0],["ويا عالم الأعمال قبل اجتراحها","وقبل احتياج المرء يعلم حوجاه",232,"ا",2,0],["ويا عجباً من طرسه ليس يمحي","وقد حفه من راحتيه بحور",233,"ر",1,0],["ويا عزمة أمضى من العضب فانكا","ولولا مضاء العزم ما فتك العضب",234,"ب",1,0],["ويا عهدُ نبقى العمرَ نحكي حكايةً","لقدسيةِ الكفَّينِ منها انجلى العهدُ",235,"د",1,0],["ويا عابد الرحمن يا من سمت به","مآثر أبا كرام ذوي سعد",236,"د",1,0],["ويا عصبة الإسلام أي عصابة","على الحق والتقوى ومن كان أظلما",237,"م",2,0],["ويا عظةً رددتها الحيا","ة على مسمع البشر الحائر",238,"ر",1,0],["وياعابقا في النفس مسكا وعنبرا","ويامبهجا للعين ..خير الفوارس",239,"س",1,0],["وَيا عاذِلِي فِي حُبِّ سُعْدَى فَما الَّذِي","دَهاكَ عَلَى أَمْرٍ بِهِ كُنْتَ جاهِلا",240,"ل",2,0],["[ وَيا عَيْنُ جُودِي بِالدُّمُوعِ فَإِنَّها","دُمُوعٌ غِزارٌ ما لَهُنَّ جُمُودُ ]",241,"د",1,0],["وَيا عَجَباً لِلصَّارِمِ العَضْبِ كَيْفَ قَدْ","سَطا فِي السُّرَيْحِيِّ الحُسامِ المُجالِدِ",242,"د",1,0],["وَيا عاذِلاً مَهْلاً وَرِفْقاً بِمُدْنَفٍ","مَتَى يَلْحَهُ اللاّحِي يَحِنَّ وَيَنْحَبِ",243,"ب",1,0],["وَيا عَجَباً لِلدَّمْعِ مِنْ كُلِّ شادِنٍ","عَلَى الخَدِّ يُذْرَا بِالبَنانِ المُخَضَّبِ",243,"ب",1,0],["وَيا عَجَباً حَيْثُ الرِّماحُ تَنُوشُهُ","وَما انْحَطَّ عَنْ سَرْجٍ ( بِهِ ) يَرْكُضُ المُهْرُ",244,"ر",1,0],["ويا عطشاً أراهُ في منامي","يفجّرُ صارخاً ذاك السّكونا",245,"ن",2,0],["ويا عجبي من خدها عند لمسه","كملمس رملٍ في النفود بلا خللْ",246,"ل",1,0],["ويا عهد كنّا كابن حلاّج واحدا","مع الله إن ضاع الورى فهو ضائع",247,"ع",1,0],["وياعين لاتستحي الدمعات من كحلك","أنا اتأسف لدمعي كثر مآ أرده",248,"د",2,0],["وَيَاعِيدُ أَلَا أَسْرِعْ","وَزُرْ أَحْبَابَنَا الْقِمَمَا",249,"م",2,0],["ويا عروسان إن أثبت ما","يبني بناء الوفاء بالطهر",250,"ر",1,0],["ويا عاذلي في هجر هندٍ وزينبٍ","وقد لاح عذري كالصباح لساري",251,"ر",2,0],["ويا عاذلي دعني وغيي فإنني","رأيت الهدى في الحب أن لا أرى هدى",252,"د",2,0],["ويا عاذلي بالله ما أنت عاذرٌ","أعن مثل هذا الحسن تثنى النواظر",253,"ر",1,0],["وياعلة التكوين والآية التي","تحير في إدراكها اللب والفكر",254,"ر",1,0],["وَيَا عَاذِلِي نِلْتَ الْمُنَى حِينَ غِرَةٍ","فَمَا عَادَ دَرْبِي بَاسِمَ الْوَعْدِ شَادِيَا",255,"ي",2,0],["ويا عزيز ان شفتها بين المحاني","قلها سلطان من شانك يجيب",256,"ب",1,0],["ويا عين سجي بالنظر عن غريبتّك \"","تتعب فلول اليآس ملح ٍ بكابك",257,"ك",1,0],["ويا عينيّ لم يَطُلِ ابتسامٌ","بلا دمع يرى التبشيرَ نعيا",258,"ي",2,0]]}