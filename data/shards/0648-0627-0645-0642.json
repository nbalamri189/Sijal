{"poems":[[45,"جللا كما بي فليك التبريح","https://www.aldiwan.net/poem9522.html","الكامل"],[64,"ولما تراءى السرب قلت لصاحبي","https://www.aldiwan.net/poem52350.html","الطويل"],[48,"كل على مكروهه مسبل","https://www.aldiwan.net/poem23150.html","السريع"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69406","الوافر"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69407","الطويل"],[5605,"ملحمة الحذاء","https://www.poetsgate.com/ViewPoem.aspx?id=159791",""],[5956,"حَيِيتُ لأُهدي الهناء لغيري","https://www.poetsgate.com/ViewPoem.aspx?id=193573",""]],"verses":[["وَأَمَقَّ لَو خَدَتِ الشَمالُ بِراكِبٍ","في عَرضِهِ لَأَناخَ وَهيَ طَليحُ",0,"ح",1,0],["وأمقتُ عيني أن تضنَّ بمائِها","وقد لاحَ برقٌ بالحِجاز لَمُوعُ",1,"ع",1,0],["وَأَمقَرَت أَفعالُ سُكّانِها","فَهُم ذِئابٌ في الفَضا عُسَّلُ",2,"ل",1,0],["وَأَمقُتُ كُلَّ مُغتابٍ نَمُومٍ","حَرِيصٍ بِالنَميمَةِ غَيرِ وَاني",3,"ن",2,0],["وَأَمقُتُ مَن لا تَطلُبُ الحَمدَ نَفسُهُ","وَلا يُضمِرُ الوُدَّ الصَحِيحَ وَلا وَدّا",4,"د",2,0],["وأَمقتُ عرشكم إِذْ رَاح َيَشكُو","إلى حكم تُلَطِّخُةُ الدماءُ",5,"ا",2,0],["وأمقت سعداً يكلل قلبي","إذا لم يكلل جميع التقاة",6,"ه",1,0]]}