y.dctabudhabi.ae/diwan/poem/102754","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90905","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90894","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91023","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90960","السريع"],[4349,"","https://poetry.dctabudhabi.ae/diwan/poem/80110","الطويل"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127935","الكامل"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28939","الطويل"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77693","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120222","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120507","الطويل"],[4634,"","https://poetry.dctabudhabi.ae/diwan/poem/200298","الوافر"],[4816,"سابق الوقت","https://www.poetsgate.com/ViewPoem.aspx?id=8469",""],[5056,"<< صدح البلبلُ..>>","https://www.poetsgate.com/ViewPoem.aspx?id=34078",""],[5145,"أما والزرق تخطر وهي سمر","https://www.poetsgate.com/ViewPoem.aspx?id=108061",""],[5160,"ورب الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=175205",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5353,"طائر الشمال","https://www.poetsgate.com/ViewPoem.aspx?id=212468",""],[5397,"بكى الدين والدنيا عليك فأفجعا","https://www.poetsgate.com/ViewPoem.aspx?id=157901",""],[5444,"رُّمانُ.. وأيلولُ أسود","https://www.poetsgate.com/ViewPoem.aspx?id=205085",""],[402,"مضت نأبى لها ذما","https://www.poetsgate.com/ViewPoem.aspx?id=35426",""],[402,"أرن سهم الردى إرنان منتحب","https://www.poetsgate.com/ViewPoem.aspx?id=35361",""],[6031,"مَا بَالُ عينِكَ لا تَجُودُ بِمَائِهَا","https://www.poetsgate.com/ViewPoem.aspx?id=46293",""],[6177,"قلق الحُروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79602&r=&rc=0",""]],"verses":[["لَنِعمَ حَريمُ العَزمِ أَنتَ وَثَغرُهُ","إِذا رَجَّحَ الرَأيَ الأَلَدُّ المُجالِدُ",0,"د",1,0],["لَنِعْمَ مُناخُ الرَّكْبِ بابُكَ للوَرى","وآلُ عَدِيٍّ نِعْمَ مُنتَجَعُ السَّفْرِ",1,"ر",1,0],["لَنَعِشْتِ مِنِّي مُهْجَةً مَطْلُولَةً","وَأَنَلْتِني فَوْقَ الذي أَنَا أَطْلُبُ",2,"ب",1,0],["لَنِعمَ حَديثُ البِرِّ تودِعُهُ الصَبا","تَبُثُّ نَثاهُ حَيثُ لاتوضِعُ البُردُ",3,"د",1,0],["لَنِعمَ الفَتى تَعشو إِلى ضَوءِ نارِهِ","طَريفُ بنُ مالٍ لَيلَةَ الجوعِ وَالخَصرِ",4,"ر",1,1],["لَنِعمَ ذوو الأَضيافِ يَغشونَ بابَهُ","إِذا هَبَّ أَرياحُ الشِّتاءِ الصَوارِدُ",5,"د",1,0],["لَنِعمَ أَبو الأَضيافِ يَغشَونَ نارَهُ","وَمُلقى رِحالِ العيسِ وَهيَ لَغُوبُ",6,"ب",1,0],["لِنَعِشْ مَعَاشَ زَمَانِنَا وَلنَنْتَهِزْ","فُرَصَ النَّجَاحِ نَفُزْ بِهِ أَوْ نَسْلَمُ",7,"م",1,0],["لَنِعمَ الفَتى وَالخَيلُ تَنحِطُ في القَنا","نَعى اِبنُ زِيادٍ لِلعُقَيلِيِّ طارِقِ",8,"ق",1,1],["لَنِعمَ حُماةُ الحَيِّ يُخشى وَرائَهُم","قَديماً وَجيرانُ المَخافَةِ وَالأَزلِ",9,"ل",1,0],["لِنعمَ طَبِيبُ الدَّاءِ من أمرِ أمّةٍ","تَوَاكَلَها ذُو الطِّبِ والمُتَطَبِّبُ",10,"ب",1,0],["لنعم الوزير الباسط اليد أنعماً","وأدعية للملك جذلان وادع",11,"ع",1,0],["لنعم الفتى ديناً ودنيا بجمعنا","وفي خطبة الدارين نعم المؤهَّل",12,"ل",1,0],["لنعم الفتى أبقى لروضِ نباته","شميماً وأوهى الدَّهر منه شماما",13,"م",2,0],["لَنعمَ اليومُ يومُ السبت حقاً","لصيدٍ إن أردت بلا امتراءِ",14,"ا",2,1],["لَنِعمَ مُناخُ أَنضاءِ المَطايا","عَسَفنَ إِلَيهِ بيداً بَعدَ بيدِ",15,"د",1,0],["لَنِعمَ الدَمُ المَسفوحُ لَيلَةَ جَعفَرٍ","هَرَقتُم وَجُنحُ اللَيلِ سودٌ دَياجِرُه",16,"ر",2,0],["لَنِعمَ شَريكُ الراحِ في لُبِّ ذي الحِجى","إِذا اِستَهلَكَتهُ بَينَ نايٍ وَمِزهَرِ",17,"ر",1,0],["لَنِعمَ ذُرى الآمالِ يَتبَعنَ ظِلَّهُ","وَوِردُ مُحَلّاةِ الظُنونِ الخَوامِسِ",18,"س",1,0],["لِنِعمَ مُناخُ القَومِ حَلّوا رِحالَهُم","إِلى قُبَّةٍ فَوقَ الوَليدِ سَماؤُها",19,"ا",3,0],["لَنِعمَ فَتى الظَلماءِ وَالرافِدُ القِرى","وَضارِبُ كَبشِ العارِضِ المُتَوَقِّدِ",20,"د",1,0],["لَنِعمَ تُراثَ المَرءِ أَورَثَ قَومَهُ","عُمَيرُ اِبنِ عَمرٍ وَالحِصانِ السُلاجِمِ",21,"م",1,1],["لَنِعمَ التُقى تَقوى فَتاً ضامِرِ الحَشا","خَميصٍ مِنَ الدُنيا تَقِيِّ المَسالِكِ",22,"ك",1,1],["لِنُعمٍ إِذ تَعاوَدَهُ هُيامٌ","بِهِ أَعيا عَلى الحاوي الطَبيبِ",23,"ب",1,0],["لَنِعمَ فَتى الكِنانةِ غيرَ واهٍ","إذا جَدَّ البلاءُ ولا هَيوبِ",24,"ب",1,0],["لَنِعمَ ثَناءُ المَرءِ حَيّاً وَغادِياً","بِهِ الصَحبُ مِن باكٍ وَمِن مُتَرَحِّمِ",25,"م",1,0],["لَنِعمَ الشِهابُ المُستَضاءُ بِنورِهِ","إِذا اِسوَدَّ مِن لَيلِ الحَوادِثِ قاتِمُ",26,"م",1,0],["لنعم القَومُ ما أَوفوا بَعَهدٍ","لِأَوطانٍ شَقِينَ وَلا ذِمامِ",27,"م",1,0],["لَنِعمَ الزرعُ زرعُكَ حِينَ تَبغِي","جَناهُ وحِينَ يُدركُهُ الحَصَادُ",28,"د",1,0],["لَنِعْمَ الصّاحبانِ الناجيانِ","على طُولِ التَّرَدُّدِ والتَّوانِي",29,"ي",1,0],["لَنِعمَ الحَيُّ حَيُّ بَني كُلَيبٍ","إِذا ما أَوقَدوا فَوقَ اليَفاعِ",30,"ع",1,1],["لَنِعْمَ أخاً في كلِّ يوْم كريهَةٍ","تصولُ بهِ غيرَ الهِدانِ ولا الغَمر",31,"ر",1,0],["لنِعْمَ نِظامُ الأمرِ والرُّتَبِ العُلى","ونِعْمَ قِوامُ المُلكِ والعسكر المَجر",31,"ر",1,0],["لَنِعْمَ وُكورُ الدينِ تَدرُجُ بينها","فإنّا رأينا دارجَ الطّيرِ يُفْرِخ",32,"خ",1,0],["لَنِعمَ الرَبُّ رَبُّ اِبنَي دُخانٍ","إِذا نَفَضَ الشِتاءُ عَلى القُتارِ",33,"ر",1,0],["لنعت صباحي طويل شقاؤه","له رقميات وصفراء ذابل",34,"ل",1,0],["لَنِعمَ دَوَاءُ الظُّلمِ يَشفِي سحيقُهُ","مجاريحَ شتَّى من أيامَى وأيتامِ",35,"م",1,0],["لَنِعْمَ الفَتى يا تَوْبَ كُنْتَ إذا الْتَقَتْ","صُدُورُ الأَعالي واسْتَشالَ الأَسافِلُ",36,"ل",1,1],["لنَعيمٍ لم يَنَلْ","قلبيَ منهُ مُشْتَهَاهْ",37,"ا",2,0],["لَنِعْمَ العَامُ مُسْدِينا","مِنَ الإسْعَافِ مَا أَسْدَا",38,"د",2,0],["\"لنعترف \" أنا أضعنا الصباح","فلنحترق حتّى يضيء الطريق",39,"ق",1,0],["لَنِعْمَ فَتىً نِلْتُمْ كَأَنَّ رِدَاءَهُ","عَلَى سَرْحَةٍ مِنْ سَرْحِ دَوْمَةَ شَانِقُ",40,"ق",1,0],["لَنِعْمَ تُرَاثُ المَرْءِ أوْرَثَ قَوْمَهُ","عُميرُ بنُ عَمروٍ وَالحَصَانِ السُّلاجمِ",41,"م",1,1],["لِنُعمانَ آثارٌ عَلَينا مُبينَةٌ","كَما بَيَّنَت آثارُ غَيبٍ مَسائِلُهِ",42,"ه",1,1],["لنعم أباة الضيم قومي وحبّذا","وبا حبّذا فيهمُ تَقِلّ ويا نعما",43,"م",2,0],["لنُعظمنَّ سَخاك يا رِيَّ الصَدى","رَحضَ الخَطاء ورافعَ الأرزاء",44,"ا",2,0],["لَنِعم الفتى أنتَ إنْ حادثٌ","ألمَّ وإن ريب دهرٍ أَطل",45,"ل",1,0],["لِنَعبُدَهُ سُبحانَهُ دونَ غَيرِهِ","لِنَستَدفِعَ البَل