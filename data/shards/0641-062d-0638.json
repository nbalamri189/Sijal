{"poems":[[65,"تجنى علينا طيفها حين أرسلا","https://www.aldiwan.net/poem46150.html","السريع"],[53,"سليم الزمان كمنكوبه","https://www.aldiwan.net/poem8495.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42567","الطويل"],[147,"تمني العلى سهل ومنهجها وعر","https://www.aldiwan.net/poem11763.html","الطويل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[266,"أنا مضنى نوى الأحبة نضو","https://www.aldiwan.net/poem38109.html","الخفيف"],[287,"ما حرك الشوق ذكرا منك بالبال","https://www.aldiwan.net/poem32642.html","البسيط"],[325,"لست أنسى يوما لمجلس أنس","https://www.aldiwan.net/poem61649.html","البسيط"],[411,"وما الدهر إلا ما مضى فهو فائت","https://www.aldiwan.net/poem49787.html","الطويل"],[422,"هنيت بالفرمان والنيشان","https://www.aldiwan.net/poem54081.html","الكامل"],[435,"إني مدحت أكابرا وأسابرا","https://www.aldiwan.net/poem41423.html","الكامل"],[438,"وما أنا إلا واحد من جماعة","https://www.aldiwan.net/poem12652.html","الطويل"],[447,"أعزيكمو في ميت لم يزل عندي","https://www.aldiwan.net/poem14445.html","الطويل"],[447,"نكابد في الدنيا هموما وأحزانا","https://www.aldiwan.net/poem14485.html","الطويل"],[447,"سلوا هل تروا خلقا وإن عز باقيا","https://www.aldiwan.net/poem14491.html","الطويل"],[463,"تظن ليالينا عودا","https://www.aldiwan.net/poem56231.html","المتقارب"],[466,"يسيل دماء الدارعين ودمعه","https://www.aldiwan.net/poem16165.html","الطويل"],[469,"في لأذني عن كل لاح صمم","https://www.aldiwan.net/poem3159.html","عموديه"],[469,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63946","المنسرح"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63866","المنسرح"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96629","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109110","الوافر"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110299","السريع"],[2053,"","https://poetry.dctabudhabi.ae/diwan/poem/132441","الرجز"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203545","الوافر"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112352","المتدارك"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103837","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48313","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91200","الكامل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128943","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111394","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77080","الكامل"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146751","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58084","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58042","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120361","الوافر"],[4767,"اليانصيب","https://www.poetsgate.com/ViewPoem.aspx?id=180035",""],[4045,"نشدت بحقّ الله من كان مسلما","https://www.poetsgate.com/ViewPoem.aspx?id=200273",""],[5259,"إذا لم يكن في السمع مني تصاون","https://www.poetsgate.com/ViewPoem.aspx?id=186801",""],[5829,"ولا تبقوا حصونا للهوان","https://www.poetsgate.com/ViewPoem.aspx?id=195343",""],[5829,"واسقط حكمة الرجل الحصيف","https://www.poetsgate.com/ViewPoem.aspx?id=211484",""],[5943,"يابنتَ خيرِ النَّاسِ","https://www.poetsgate.com/ViewPoem.aspx?id=11256",""],[5952,"كورونا","https://www.poetsgate.com/ViewPoem.aspx?id=210554",""],[6093,"مَاهِيَّتي ( البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=180517",""]],"verses":[["فحَظُّ مُجاريهِ إذا جَدَّ جَدُّهُ","على إثْرِهِ أنْ يَملأَ العَينَ قَسْطَلا",0,"ل",2,0],["فَحَظِّي وإن كنتُ مغصوبَهُ","فَسِتْرِيَ لستُ بمغصوبِهِ",1,"ب",2,0],["فَحَظُّ أُناسٍ مِنْهُ كَأْسٌ وَقَيْنَةٌ","وَحَظُّ رِجالٍ ذُكْرَةٌ وَنَشِيدُ",2,"د",1,0],["فَحَظُّكَ مِنا ما يُغاظُ بِهِ العِدى","وَحَظّي الغِنى وَالعِزُّ وَالجاهُ وَالفَخرُ",3,"ر",1,0],["فَحظّكم حظرٌ لما جوّزَ النُهى","وَجوّزتمُ ما كانَ عندَ النهى حضرا",4,"ر",2,0],["فحظوظ الرجال سود وبيض","كليالي الشتاء دجن وصحو",5,"و",1,0],["فَحَظُّهُ كُلّ إِعزازٍ لَدَيَّ وَإِن","جَفا فَحَظّي لَدَيهِ كُلُّ إِذلالي",6,"ل",2,0],["فَحَظَينا بِكُلِّ مَعنى لَطيفِ","وَبِمَغنى تَنسى المُسَبِّحَ وَردَه",7,"د",2,0],["فحظُّكَ مِمّا أنتَ فيهِ فإنَّهُ","زَمانُ الفَتى من مُجْمَلٍ ومُفَصَّلِ",8,"ل",1,0],["فحظيتَ من ملك الزَّمان بما به","فخرٌ على الأَمثال والأَقران",9,"ن",1,0],["فحظيت من تلك الأكابر بالغنا","وحظيت من تلك الأسابر بالحجل",10,"ل",1,0],["فحظُكُمُ كالشمسِ لم يخْبُ ضوؤها","وإن حُجِبَتْ من ظلمةِ الليلِ في قَمْصِ",11,"ص",1,0],["فحظ وضيع القدر في المَوت قسمة","كحظ رفيع الشأن بالجد والجد",12,"د",1,0],["فحظ عظيم القدر في قسمة الردى","وفي اللحد إلا حظ من قدره هانا",13,"ن",2,0],["فحظ ذليل القوم في قسمة الردى","كحظ الذي في القوم أصبح عاتيا",14,"ي",2,0],["فحظٌّ عساه وإن ساءني","يكون بما سرَّني أعوَدا",15,"د",2,0],["فحظُّ سباع الطير فُرسانُ بُهْمةٍ","وكومٌ حُظوظُ الطَّارقينَ ونيبُ",16,"ب",1,0],["فحظي التسليمُ ممَّا قلتهُ","وحظهم من المقال التُهم",17,"م",1,0],["فحظرتم من اللقاء حلالاً","وسفكتم من الدماءِ حراما",18,"م",2,0],["فحظّيَ الرفعُ عند ذاك كما","أنَّ ابنَ سلمونَ حظُّهُ الخَفْض",19,"ض",1,0],["فحظُّه منه حظُّ مَنْ يدُه","في الماء مشغولةٌ تُجَرِّزه",20,"ز",2,0],["فَحظيت منه بخير من","تجع وأعذب موردِ",21,"د",1,0],["فحظ المرء في الدنيا ثلاث","ولادته وشقوته وموته",22,"ت",2,0],["فحظكم في عيشكم مثله","في موتكم يقضي بهذا النظام",23,"م",1,0],["فحظه من الإله شحط","عليه لعنٌ دائم وسخط",24,"ط",1,0],["فحظِّي كل يومٍ منه رُبعُ","ظمئتُ فليته لو كان شَطرا",25,"ر",2,0],["فحظّيَ فيها إذا ما سكرتُ","كحظّيَ منها وعَقلي معي",26,"ي",1,0],["فحظك من بعض السواقي مفضل","على أن بحور الملك من أصلها الرحى",27,"ح",2,0],["فحظّيَ للأطْماعِ أمْسى مقَرِّباً","ولفْظيَ للأسْماعِ أمْسى مقَرِّطا",28,"ط",2,0],["فَحظوظ راجي ما لَديهِ جَنة","وَحُقوق من ناوى علاه جهنم",29,"م",1,0],["فحظي بقوقع صغير","يضيع في منقاره الكبير",30,"ر",1,0],["فحَظُّكَ قد تَراخى عَنهُ حَظِّي","وباعي حُمِّلت ثِقلَ الطَّوَاري",31,"ر",2,0],["فَحَظيتُ مِنها بِالمُنى مُتَدَرِّعاً","بَردَ الصِيانَةِ وَالغَرامِ لِباسي",32,"س",2,0],["فحظي من الحظين هم وحسرة","وحاصلها أني على الهم حاصل",33,"ل",1,0],["فحظِّيَ من فِقْدانِهِ غيرُ نَاقصٍ","بأحشايَ باتَ الفقْدُ يَعْلُو ويَسْطَعُ",34,"ع",1,0],["فحظُّ فقيهِ القوم في قسمةِ الرَّدَى","كحظِّ سفيهٍ جلَّ ربي له الأمرُ",35,"ر",1,0],["فحظي كله في نظم در","يليق بقدر يوسف في المديح",36,"ح",1,0],["فحظٌّ عاثر يأبى صعوداً","وحظ العاثرين هو الركود",37,"د",1,0],["فحظّ بنى مروان منها وحظكم","مع الغيظ والحرمان والعيلة الحرب",38,"ب",1,0],["فحظي إذن من صومي الجوع والظما","وإن قلت إني صمت يوماً فما صمت",39,"ت",1,0],["فحظ المرء ما خطت يداه","وما حصدت زنودٌ من تفان",40,"ن",1,0],["فحظّ العاشقين جمار وجد","تلوح لظى بشريان رهيفِ",41,"ف",1,0],["فحظيتِ من عطفِ الرسولِ وودِّهِ","ماساءَ أهلَ الغدرِ والعدوانِ",42,"ن",1,0],["فحظرتُها وطفقتُ أغسلُ صفحتي","وعصرتُ في ماسنجري ليمونا",43,"ن",2,0],["فَحظُّ دُنَيايَ في طِيْني خَرَائِطُهُ","وحَظُّ آخرتي في النُّورِ يَقْتحِمُ",44,"م",1,0]]}