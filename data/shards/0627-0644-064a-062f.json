{"poems":[[51,"ذكرتك حين ألقت بي عصاها","https://www.aldiwan.net/poem8527.html","الوافر"],[49,"أما والله إن الظلم لوم","https://www.aldiwan.net/poem63114.html","الوافر"],[48,"أما ونجيبة يهوي","https://www.aldiwan.net/poem62585.html","مجزوء الوافر"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39572","الرمل"],[115,"إليكَ أتيت (1)","https://www.aldiwan.net/poem24027.html","الوافر"],[187,"مقام أجل الرسل أعلى وأعظم","https://www.aldiwan.net/poem35106.html","الطويل"],[227,"إلى دير القصير صبا فؤادي","https://www.aldiwan.net/poem50999.html","الوافر"],[280,"ألا هل إلى باب البريد سبيل","https://www.aldiwan.net/poem32669.html","الطويل"],[280,"تقول صحابي والمطي بنا تخدي","https://www.aldiwan.net/poem32793.html","الطويل"],[347,"أقبل صبحي وسفر","https://www.aldiwan.net/poem15721.html","مجزوء الرجز"],[413,"لأسماء دار حيث منقطع الرمل","https://www.aldiwan.net/poem53930.html","الطويل"],[429,"لمن رسوم الديار باللبب","https://www.aldiwan.net/poem12466.html","المنسرح"],[431,"نظرت من البستان أحسن منظر","https://www.aldiwan.net/poem24530.html","الطويل"],[456,"لو كنت تبلو غداة السفح أخباري","https://www.aldiwan.net/poem56179.html","البسيط"],[560,"ضريح حل فيه كريم قوم","https://www.aldiwan.net/poem52600.html","الوافر"],[560,"إذا طلع النهار أرى الرجالا","https://www.aldiwan.net/poem52866.html","البسيط"],[560,"بناء العلى بين القنا والبوارق","https://www.aldiwan.net/poem52969.html","الطويل"]],"verses":[["إلى دارٍ أبتْ فيها المنايا","رجوعاً للمحب إلى الحبيبِ",0,"ب",1,0],["إِلى دَيّانِ يَومِ الدينِ نَمضي","وَعِندَ اللَهِ تَجتَمِعُ الخُصومُ",1,"م",1,0],["إِلى دورٍ يَحِلُّ بِها ال","أُلى قَلبي بِهِم كَمَدُ",2,"د",1,0],["إِلى دِفءِ أَرطَاةًٍ تُثيرُ كِناسها","تَبَوّأُ مِنها آخِرَ الليلِ مُجفَرا",3,"ر",2,0],["اليدُ البيضاءُ في كلِّ الغصونْ","زهرةٌ تَنْدَى ونوْرٌ يُشرقُ",4,"ق",1,0],["إلى دارٍ أراكَ به عَفُوًّا","غَفُورًا كلَّ زَلَّاتي ورِجْسِي",5,"س",2,0],["إِلى دينِ طه فهو بالكفر مظلمُ","عليهِ عبادَ اللَّه صلّوا وسلّموا",6,"م",3,0],["إلى دير القُصَير صبا فؤادي","وقد يصبو الخطير إلى الخطير",7,"ر",1,1],["إِلى دَوحَةِ المَجدِ المُؤَثَّلِ يَنتَمي","وَفيها فُروعٌ دونَهُ وَأُصولُ",8,"ل",1,0],["إِلى دَوحَةٍ بِالمَكرُماتِ تَهَدَّلَت","فَأَغصانُها تُجنى عَلى القُربِ وَالبُعدِ",9,"د",1,0],["إِلى دُخولِ البابِ وَالبا","بُ فيهِ خَمسُ نَقَر",10,"ر",1,0],["إلى دوحة من هاشم نبويَّةٍ","نعم إنَّ هذا الفرع من ذلك الأَصل",11,"ل",1,0],["الى ديارٍ بين الصِّفاحِ فذا","تِ الخالِ فالرقمتَيْنِ فالكتُبِ",12,"ب",1,0],["إلى دوح كمثرى يلوحُ كأنه","قناديلُ تبر محكماتُ العلائقِ",13,"ق",1,0],["اليَدُ منكم فلا تُلقوا أشاجِعَها","لفاصمٍ من يدِ العلياء بشّارِ",14,"ر",1,0],["إلى دار السَّلامِ مضَى أميناً","بحفِظِ اللهِ يشمَلُهُ النَّعيمُ",15,"م",1,0],["إلى دارِ السَّعادةِ سِرتَ فَوْراً","كأنّكَ عاشقٌ يَبغِي الوِصالا",16,"ل",2,0],["إلى دارهِ الرُّكبانُ تَهْوِي فتنثني","مُشاةً لِوقْر المالِ فوقَ الأيانقِ",17,"ق",1,0]]}