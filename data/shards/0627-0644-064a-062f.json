{"poems":[[53,"ذكرتك حين ألقت بي عصاها","https://www.aldiwan.net/poem8527.html","الوافر"],[51,"أما والله إن الظلم لوم","https://www.aldiwan.net/poem63114.html","الوافر"],[50,"أما ونجيبة يهوي","https://www.aldiwan.net/poem62585.html","مجزوء الوافر"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39572","الرمل"],[121,"إليكَ أتيت (1)","https://www.aldiwan.net/poem24027.html","الوافر"],[193,"مقام أجل الرسل أعلى وأعظم","https://www.aldiwan.net/poem35106.html","الطويل"],[234,"إلى دير القصير صبا فؤادي","https://www.aldiwan.net/poem50999.html","الوافر"],[287,"ألا هل إلى باب البريد سبيل","https://www.aldiwan.net/poem32669.html","الطويل"],[287,"تقول صحابي والمطي بنا تخدي","https://www.aldiwan.net/poem32793.html","الطويل"],[354,"أقبل صبحي وسفر","https://www.aldiwan.net/poem15721.html","مجزوء الرجز"],[422,"لأسماء دار حيث منقطع الرمل","https://www.aldiwan.net/poem53930.html","الطويل"],[438,"لمن رسوم الديار باللبب","https://www.aldiwan.net/poem12466.html","المنسرح"],[440,"نظرت من البستان أحسن منظر","https://www.aldiwan.net/poem24530.html","الطويل"],[463,"لو كنت تبلو غداة السفح أخباري","https://www.aldiwan.net/poem56179.html","البسيط"],[567,"ضريح حل فيه كريم قوم","https://www.aldiwan.net/poem52600.html","الوافر"],[567,"إذا طلع النهار أرى الرجالا","https://www.aldiwan.net/poem52866.html","البسيط"],[567,"بناء العلى بين القنا والبوارق","https://www.aldiwan.net/poem52969.html","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59673","السريع"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80221","الوافر"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122921","البسيط"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31624","الهزج"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50041","الهزج"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50022","المتقارب"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52091","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109489","الوافر"],[2436,"","https://poetry.dctabudhabi.ae/diwan/poem/17741","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65966","الطويل"],[2818,"","https://poetry.dctabudhabi.ae/diwan/poem/101870","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89255","الخفيف"],[3469,"","https://poetry.dctabudhabi.ae/diwan/poem/5","المتقارب"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48323","الطويل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102389","الطويل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102382","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86242","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45868","الوافر"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131993","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117997","الطويل"],[354,"","https://poetry.dctabudhabi.ae/diwan/poem/44074","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94450","الطويل"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117176","الوافر"],[4759,"سيدة المغازي","https://www.poetsgate.com/ViewPoem.aspx?id=206170",""],[5672,"في الحسين عليه السلام","https://www.poetsgate.com/ViewPoem.aspx?id=206429",""],[5761,"طهرت منك","https://www.poetsgate.com/ViewPoem.aspx?id=14231",""],[5848,"علوم دقاقة","https://www.poetsgate.com/ViewPoem.aspx?id=48825",""],[6068,"رشيد تونس -18-","https://www.poetsgate.com/ViewPoem.aspx?id=177481",""],[6139,"نفحة محمدية","https://www.poetsgate.com/ViewPoem.aspx?id=212348",""],[6152,"اللهم عليك بالمسافات","https://www.poetsgate.com/ViewPoem.aspx?id=205059",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[520,"لا وعيون لحظها ساحر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577520",""]],"verses":[["إلى دارٍ أبتْ فيها المنايا","رجوعاً للمحب إلى الحبيبِ",0,"ب",1,0],["إِلى دَيّانِ يَومِ الدينِ نَمضي","وَعِندَ اللَهِ تَجتَمِعُ الخُصومُ",1,"م",1,0],["إِلى دورٍ يَحِلُّ بِها ال","أُلى قَلبي بِهِم كَمَدُ",2,"د",1,0],["إِلى دِفءِ أَرطَاةًٍ تُثيرُ كِناسها","تَبَوّأُ مِنها آخِرَ الليلِ مُجفَرا",3,"ر",2,0],["اليدُ البيضاءُ في كلِّ الغصونْ","زهرةٌ تَنْدَى ونوْرٌ يُشرقُ",4,"ق",1,0],["إلى دارٍ أراكَ به عَفُوًّا","غَفُورًا كلَّ زَلَّاتي ورِجْسِي",5,"س",2,0],["إِلى دينِ طه فهو بالكفر مظلمُ","عليهِ عبادَ اللَّه صلّوا وسلّموا",6,"م",3,0],["إلى دير القُصَير صبا فؤادي","وقد يصبو الخطير إلى الخطير",7,"ر",1,1],["إِلى دَوحَةِ المَجدِ المُؤَثَّلِ يَنتَمي","وَفيها فُروعٌ دونَهُ وَأُصولُ",8,"ل",1,0],["إِلى دَوحَةٍ بِالمَكرُماتِ تَهَدَّلَت","فَأَغصانُها تُجنى عَلى القُربِ وَالبُعدِ",9,"د",1,0],["إِلى دُخولِ البابِ وَالبا","بُ فيهِ خَمسُ نَقَر",10,"ر",1,0],["إلى دوحة من هاشم نبويَّةٍ","نعم إنَّ هذا الفرع من ذلك الأَصل",11,"ل",1,0],["الى ديارٍ بين الصِّفاحِ فذا","تِ الخالِ فالرقمتَيْنِ فالكتُبِ",12,"ب",1,0],["إلى دوح كمثرى يلوحُ كأنه","قناديلُ تبر محكماتُ العلائقِ",13,"ق",1,0],["اليَدُ منكم فلا تُلقوا أشاجِعَها","لفاصمٍ من يدِ العلياء بشّارِ",14,"ر",1,0],["إلى دار السَّلامِ مضَى أميناً","بحفِظِ اللهِ يشمَلُهُ النَّعيمُ",15,"م",1,0],["إلى دارِ السَّعادةِ سِرتَ فَوْراً","كأنّكَ عاشقٌ يَبغِي الوِصالا",16,"ل",2,0],["إلى دارهِ الرُّكبانُ تَهْوِي فتنثني","مُشاةً لِوقْر المالِ فوقَ الأيانقِ",17,"ق",1,0],["اليدُ فوق الصدر منضوحة","يوم النوى من مدمع هامل",18,"ل",1,0],["إِلى دار السَعادَةِ قُمتَ تَسعى","فَقُلتُ لِصحبَتي بانَت سُعادُ",19,"د",1,0],["الى دمشق ففيها ان قصدت غنى","وثم يأتي سواي الجاه والمال",20,"ل",1,0],["إلى دَيْرِ سَعيدٍ أَوْ","إلى دَيْرِ مَخائِيلِ",21,"ل",1,0],["إلى دار أبي القاسم","هل يقصد إلاّ هو",22,"ا",3,0],["إلى داره للعُفاةانتجاعٌ","إِذا ما تَشَكَّى العفاة المحولا",23,"ل",2,0],["إلى دار السلام مضى علي","وجاور في منازلها السلاما",24,"م",2,0],["إلَى دَمَاثَةِ خُلْقٍ لاَ يُكَدّرُهَا","ثِقلُ المُلِحّ وَلاَ كِبرُ الفَرَاعِينِ",25,"ن",1,0],["إلى دار النعيم سرى فنادى","بمسراه الوجودُ مع السلامه",26,"م",2,0],["إِلى دَفِّ هِلواعٍ كَأَنَّ زِمامَها","قُرى حَيَّةٍ تَخشى مِنَ السِندِ حاوِيا",27,"ي",2,0],["إلى ديننا إِذ ديننا طاب أصله","وطابت فروع عنده وطبائع",28,"ع",1,0],["اليد الحسني والشهم الذي","في وصفه تاه اللبيب الألمعي",29,"ع",2,0],["اليد البيضا اللسان الفصيح ال","منظر النضر والقوام الرشيق",30,"ق",1,0],["إِلى دار قَومٍ حِسانِ الوُجوهِ","عِظامِ القِبابِ طِوالِ العَوال",31,"ل",1,0],["إلى دوحَةِ النّصْرِ العزيز انتِسابُهُم","وهُمْ سِرُّها إنْ عُدِّدوا وسَراتُها",32,"ت",3,0],["إلى دَبْرِ شمسٍ لم يدَعْ سنَنُ الصَّبا","ولا قصفُ زَمزامِ الأتِيِّ اللوالِمِ",33,"م",1,0],["إلى دفءِ أرطاةٍ إلى جَنبِ عجْمةٍ","بها الشاةُ مَحبورُ المكانِ غَريرُ",34,"ر",1,0],["الى دَولَة العَبّاسِ تَسعى المَفاخِرُ","وَطوعاً لَهُ تَعنو المُلوكُ القَياصِرُ",35,"ر",1,1],["إِلى دار النَعيم مَضَت وَكُل","قَصاراه إِلى رَب وَدود",36,"د",1,1],["إلى دار المعز نجد سيرا","حثيثا فوق متن الصافنات",37,"ت",1,0],["إلى دوحة قد أحسن اللَه نبتها","وزان بها أغصانها والأفانينا",38,"ن",2,0],["إِلى دُخولِ البابِ وَال","بابُ به خَمسُ نَفرْ",39,"ر",1,0],["إِلى دارة القمراءِ حيوا أتى الهنا","لها اليمن والإسعاد في نيلها المُنى",40,"ن",2,1],["إلى دارِ المنونِ فجهَّزَتهُم","تحُثُّهُم بأربَعَةٍ حثاثِ",41,"ث",1,0],["إلي درب يغربني وأني","أراني قدة غويت اذ اهتديت",42,"ت",1,0],["إلى دمِكِ الساكبِ المؤتلي","إلى قلبِكَ الظامئِ الأنبلِ",43,"ل",1,0],["اليد التي قبلتها .. طعنتني وخانت","والله إني حتما سأنساك",44,"ك",1,1],["اليد الوحدة تراها ما تصفق","والأكل للجايع أشهى من الذواقة",45,"ق",2,0],["آلى دخول الأرض فك حصارها","فطن الجنان بغير غدر ألمعي",46,"ع",2,0],["إلى دارها قد شدّ قلْبٌ رحاله","فصارتْ لهُ إسما وأنْسًا ومجْلِسَا",47,"س",2,0],["إلى ديار حوت قلبا أهيم به","من بات يرهقني بعدا وأشواقا",48,"ق",2,0],["إِلى دارس الحكمة وَواعي رُموزها","وَمُدرك مَعانيها وَحافظ مثالها",49,"ل",3,0],["اليد ابن السيد المرتضى","فرعٌ نماه الحسب الطاهر",50,"ر",1,0]]}