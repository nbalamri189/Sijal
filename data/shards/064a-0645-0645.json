"https://www.poetsgate.com/ViewPoem.aspx?id=72792",""],[4978,"تشطير قصيدة لو كان حبك","https://www.poetsgate.com/ViewPoem.aspx?id=177254",""],[4978,"رد على مضى زمني","https://www.poetsgate.com/ViewPoem.aspx?id=177285",""],[5001,"في مدح النبي صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=176233",""],[5055,"نفحة الأرطا","https://www.poetsgate.com/ViewPoem.aspx?id=106745",""],[3591,"يمّمي الشيخ وأقرئيه السلاما","https://www.poetsgate.com/ViewPoem.aspx?id=149512",""],[5101,"حضن الغوى","https://www.poetsgate.com/ViewPoem.aspx?id=202973",""],[5131,"هذا هو الإسلام في مفهومه","https://www.poetsgate.com/ViewPoem.aspx?id=58407",""],[5136,"أضحك النصر مبسم العلياء","https://www.poetsgate.com/ViewPoem.aspx?id=121488",""],[5150,"حبي عليك جنى ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203779",""],[5190,"الجوزاء والبحر","https://www.poetsgate.com/ViewPoem.aspx?id=68758",""],[5213,"هل تبلغ العيس بى الدارا","https://www.poetsgate.com/ViewPoem.aspx?id=170460",""],[5284,"آداب تلاوة القرآن","https://www.poetsgate.com/ViewPoem.aspx?id=188852",""],[5365,"الوصيّة","https://www.poetsgate.com/ViewPoem.aspx?id=190421",""],[5493,"شعرُ العلا","https://www.poetsgate.com/ViewPoem.aspx?id=199901",""],[5542,"الأمل القادم","https://www.poetsgate.com/ViewPoem.aspx?id=10027",""],[5582,"هَلْ قَدْ أَضاءَتْ شُمُوسٌ فِي المَحارِيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=186670",""],[2110,"يا مهاة قد نأت عن مقلتي","https://www.poetsgate.com/ViewPoem.aspx?id=156291",""],[5674,"قلبي هائم وقتيل","https://www.poetsgate.com/ViewPoem.aspx?id=189068",""],[5674,"احذر حروف الشاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=191749",""],[5685,"قبلة الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=36763",""],[5691,"يعرب","https://www.poetsgate.com/ViewPoem.aspx?id=206081",""],[5720,"الْمُعْطِي","https://www.poetsgate.com/ViewPoem.aspx?id=207672",""],[5736,"يممت وجهي","https://www.poetsgate.com/ViewPoem.aspx?id=203906",""],[5781,"سورية ما بين قلبي والمسافة بيننا","https://www.poetsgate.com/ViewPoem.aspx?id=202833",""],[5781,"أناقة العشق...وتصبُّري","https://www.poetsgate.com/ViewPoem.aspx?id=210380",""],[5879,"رتل هواك","https://www.poetsgate.com/ViewPoem.aspx?id=215459",""],[5894,"يا حداة السرى بحث المطي","https://www.poetsgate.com/ViewPoem.aspx?id=131438",""],[5929,"باد هواك","https://www.poetsgate.com/ViewPoem.aspx?id=202445",""],[5942,"بغداد. يا لغة الدنيا وجنتها","https://www.poetsgate.com/ViewPoem.aspx?id=215593",""],[5952,"وَعَزَفْتُ","https://www.poetsgate.com/ViewPoem.aspx?id=196720",""],[5956,"مناجاة حبيبة رحلت بعيدا ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182151",""],[6127,"رحلة الإباء","https://www.poetsgate.com/ViewPoem.aspx?id=192766",""],[6130,"شرفةُ حلمٍ ...","https://www.poetsgate.com/ViewPoem.aspx?id=199248",""],[136,"يمم لحاجك سبب البحر او ساخ","http://www.aldiwanalarabi.com/poemDescription.do?poemId=599699",""]],"verses":[["يَمَّمْتَهَا وَالْمَاءُ مُوْجُودٌ لَهَا","نَحْرَ الْعَدُوِّ فَكَانَ خَيْرَ تَيَمُّمِ",0,"م",1,0],["يَمَّمتُ خَيرَ فَتىً في الناسِ كُلَّهُمُ","الشاهِدينَ بِهِ أَعني وَمَن غابا",1,"ب",2,0],["يَمِّمْ بِوَجْهِكَ شَطْرَ رَبِّكَ إِنَّهُ","نِعْمَ الوَلِيِّ لَهُمُ وَنَمْ بِأَمَانِ",2,"ن",1,0],["يَمَّمْتُ فِيهَا البِئْرَ وَالأَتْرَابُ قَدْ","نُثِرَتْ حَوَالَيْهَا بِغَيْرِ نِظَامِ",3,"م",1,0],["يَممْ حماهُ تجدْ عفواً لمقترِفٍ","مالاً لمفتقرِ جاهاً لمقترب",4,"ب",1,0],["يممته والغلا والفقرُ قدْ جمعا","لحالتي بين طاعونٍ وحجَّاج",5,"ج",1,0],["يممت في حال مرحوم منازله","ثم انثنيت وحالي حال محسود",6,"د",1,0],["يمَّم الشام بعد إقتار وقت","لم تجد فيه للمناجح قصدا",7,"د",2,0],["يمم حماه تجد سحاباً مشبماً","يهنى الندى وتلطفاً متبغذذا",8,"ذ",2,0],["يممته دلفيّ الأصل منتسباً","تأبى معاليهِ أن تخفى عناصره",9,"ر",2,0],["يمَّمت بابك وهي مني عادة","معروفة في حالةِ الإعسار",10,"ر",1,1],["يممْ حماه إذا ما خفت ضائعةً","فبابه بالندى كالصدر متسع",11,"ع",1,0],["يممه والسحب عقم واخشَ سطوته","والخيل من حدبِ الهيجاء قد نسلت",12,"ت",1,0],["يمّمْ حماه ودافع كلّ معضلةٍ","مهيبة الحرم تعلم أنه حرم",13,"م",1,0],["يممه يا راجيه تلقَ خلاله","تسدى بها حلل الثناء وترقم",14,"م",1,0],["يمَّم مغانيَهُ بالقصدِ محتكماً","إنَّ الغنى اشْتقَّ فينا من مغانيه",15,"ي",2,0],["يَمَّمَتْه بنا المطايا فأفْضَتْ","من فضاءٍ إلى فضاءٍ رحيبِ",16,"ب",1,0],["يَمَّمْتُ بدرَ بني بدرٍ فما انتسبت","ألفاظهُ ليَ لكنْ وجهُهُ انتسبا",17,"ب",2,0],["يَمَّمَتْ همتُه قصوى المَدى","فجرى جَرْيَ جواد لجوادِ",18,"د",1,0],["يممه بالمديح شاعرُهُ","طريدَ إملاقه وإنفاضه",19,"ض",2,0],["يممت وجهك أهتدي بنجومه","عند احتشاد الليل في تسجيفه",20,"ف",2,0],["يممته إذ وجوه الناس كلهم","فيها إلى الجانب المعمور منصرف",21,"ف",1,0],["يمَّمتْ ربْعكم حُداةٌ خِفافٌ","من رياحٍ تُزْجي سحاباً ثِقالا",22,"ل",2,0],["يَمِّم أبا الصقرِ إن اللَّه فَضَّلَهُ","وفات كل نظيرٍ في فضائلِهِ",23,"ل",2,0],["يمَّمْتَ يمَّاً أساحَ اللَّهُ لُجَّتَهُ","في أرضهِ فخرابُ الأرض عُمران",24,"ن",1,0],["يَمِّمْهُ إنك منه بين مُثَوِّب","بالمُعْطشينَ ومِذْودٍ نَدَّاهِ",25,"ه",1,0],["يَمَّمتُهُ سَحرا وَأَسراري مَعي","وَرَجَعتُ في أَعماقِهِ أَسراري",26,"ر",2,0],["يَمَّمتُها وَنُجومُ الأُفقِ تَلحَظُني","في السَيرِ شَذَراً كَأَنّي مِن أَعاديها",27,"ي",3,0],["يممي يا نفسي السماء فاني","لا ارى في الثرى طريق الخلود",28,"د",1,0],["يممت ثغر سعيد خير محتفل","تعيدها حفلات قيصريات",29,"ت",1,0],["يَمَّمتُ شاسِعَ دارِهِم عَن نِيَّةٍ","إِنَّ المُحِبَّ عَلى البِعادِ يَزورُ",30,"ر",1,0],["يَمِّموا نَحوَهُ تَلقوا سَماحاً","وَوَلِيّاً يَجودُنا بِوَلِيِّ",31,"ي",1,0],["يَمَّمنَ مورِقَةَ الأَفنانِ دانِيَةً","وَفي الخَلاءِ فَما يُؤنِسنَ دَيّارا",32,"ر",2,0],["يَمَّمتُ مِن عَلياكَ خَيرَ مُيَمِّمٍ","وَحَلَلتُ مِن مَغناكَ دارَ مُخَيَّمِ",33,"م",1,1],["يَمِّمِ الصاحِبَ الذِي يُتَرَجَّى","فَتْحُ ثَغْرٍ بهِ وسَدُّ ثُغُورِ",34,"ر",1,0],["يَمَّمنَ مِن جَنبَي هَجَر","أَخضَرَ طَمّامَ العَكَر",35,"ر",1,0],["يممت بيروت بعد الشام في سفري","أجلو بأوجه أمجادٍ بها بصري",36,"ر",2,1],["يممت بيروت أستشفي بطيبته","وَقلت علّ جروحي فيه تندمل",37,"ل",1,0],["يمّميتها ونجوم الأفق تلحظني","في السير شذرا كأنّي من أعاديها",38,"ي",3,0],["يَمّمْتُه وبودّي أنني قَلَمٌ","أسعى إليه ورأسي تحتيَ السّاعي",39,"ع",2,0],["يَمَّمْتُهَا بِرِفَاقٍ إِنْ دَعَوْتُ بِهِمْ","لَبُّوا سِرَاعَا وَإِنْ أَنْزِلْ بِهِمْ نَزَلُوا",40,"ل",3,0],["يَمَّمْتِ مِصْرَ فَعَلَى الرَّحْ","بِ وَخَيْرِ مَقْدَمِ",41,"م",1,0],["يَمَّمكَ المَوتُ وَهوَ كَأسٌ","لَم يَنجُ مِن شُربها كَمِيُّ",42,"ي",1,0],["يممتها والماء موجود لها","نحو العدو فكان خير تيمم",43,"م",1,0],["يَمم بِنا دار العِمادي أَنَّهُ","مَولى غَدا المَعروف مِن أَشياعِهِ",44,"ه",1,1],["يَمِّمْ ذُراها تر البحر الخضمَّ بها","فاغرف بكفكَ واشربْ غيرَ مَسْنُونِ",45,"ن",1,0],["يَمَّمتَ نحوَ العِدى غرّاً غطارفةٌ","شُمَّ الأنوف شداداً زَانها الغُرَرُ",46,"ر",1,0],["يَمِّم لِحَاجِكَ سيبَ البحرِ أو سَاخ","مَن عِندَهُ بِدَرُ النَّقدَينِ أَوسَاخُ",47,"خ",1,1],["يَمَّمتُهُ مِن رَبِّهِ صلواتٌ","لَم تَنِ الدَّهرَ فَائِحَاتٍ مَلاَبَا",48,"ب",2,0],["يَمَّمتُها في حالَةٍ","يَنسى الخَليلُ بِها خَليلَه",49,"ل",2,0],["يمَّموا في البِطاح للَّه جلّ ال","لَه بَيتاً له البروجُ فداءُ",50,"ا",2,0],["يمم الى نحو حماه تنل","ما رمت منه وعلي الضمان",51,"ن",1,0],["يممت أبغي ندى من راق منظره","فعزّ بي ببروق ما بها مطر",52,"ر",1,1],["يَمَّمتُهُ ظامِئاً فَأَورَدَني","مَناهِلاً مِن حِياضِهِ الفُعُمِ",53,"م",1,0],["يَمَّمتُهُ فَنَزَلتُ بِال","جَدِّ العُثورِ عَلى المُقيلِ",54,"ل",1,0],["يَمِّمهُمُ وَاِسرَح رِكابَكَ تَستَرِح","مِن خَوضِ أَهوالٍ وَقَطعِ فَيافِ",55,"ف",1,0],["يَمِّم حِمى عَبدِ الرَحيمِ الَّذي","يَقتُلُ إِعسارَكَ بِاليُسرِ",56,"ر",1,0],["يَمَّمتُها مِصراً وَعَجزاً بِمَن","يُجهِزُّ البُرَّ إِلى مِصرِ",56,"ر",1,0],["يَمِّم ثَراهُ تَجِد مَرا","داً لِلمَكارِمِ مُعشِبا",57,"ب",2,0],["يمّم ندى غيث الكرام العلي","فالغيث لا يهمي سوى من علي",58,"ل",2,1],["يَمَّمنَ بَحرَ نَدىً وَحَبراً عالِماً","بِعُلومِ أَهلِ الرَأيِ وَالمَنصوصِ",59,"ص",1,0],["يممْ بمن تنعاه لي (أُمَّ القرى)","واجمعْ من الأَحياءِ كل موزّع",60,"ع",1,0],["يمّم جيادَ القولِ خيرَ ميمّم","هَذا مجالٌ للهناءِ الأعظمِ",61,"م",1,1],["يمّمتُ أعذبَ مورد ينفي الظما","وَأعزّ ملجا لائذاً أنصارا",62,"ر",2,0],["يمّمهُ وَاِجهد في يمينكَ مُقسِماً","أَن سَوف تمتلئُ اليمين يسارا",62,"ر",2,0],["يَمَّمتُ موسى الإِمامَ مُرتَغِباً","أَرجو نَداهُ وَالخَيرُ مُطَّلَبُ",63