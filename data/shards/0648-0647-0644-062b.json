{"poems":[[53,"تعللت ريقا يطرد النوم برده","https://www.aldiwan.net/poem66764.html","الطويل"],[76,"لك الله من برق تراءى فسلما","https://www.aldiwan.net/poem13245.html","الطويل"],[48,"فعلت فعل تجار مخسرين به","https://www.aldiwan.net/poem22667.html","البسيط"],[458,"أفى العرس تنعى يالها قسوة القدر","https://www.aldiwan.net/poem61712.html","الطويل"],[543,"كما قلتم لن يرتضي السلم مجرم","https://www.aldiwan.net/poem47935.html","عموديه"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59157","البسيط"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31620","المتقارب"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48929","المتقارب"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129464","البسيط"],[4578,"","https://poetry.dctabudhabi.ae/diwan/poem/114623","الطويل"],[1901,"وداعاً بَني أُمي فَقدْ آنَ أنْ أَمضِي","https://www.poetsgate.com/ViewPoem.aspx?id=160417",""],[3749,"وهل ثم نفس لا تميل إلى الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=134967",""],[5273,"أسئلة بظهر الغيب","https://www.poetsgate.com/ViewPoem.aspx?id=176796",""],[5397,"رميت بقوس الحزم عن قوس حاجب","https://www.poetsgate.com/ViewPoem.aspx?id=157922",""],[5937,"شبيهةُ صنعاء","https://www.poetsgate.com/ViewPoem.aspx?id=211806",""]],"verses":[["وهل ثَغَبٌ حصباؤه مثلُ ثغرِها","يصادَفُ إلا طَيِّبَ الطعمِ صافيا",0,"ي",2,0],["وَهَل ثِقَةٌ في الأَرضِ يَحفَظُ خِلَّةً","إِذا غَدَرا بي صاحِبانِ هُما هُما",1,"م",2,0],["وَهَل ثَعالِبُ طَيٍّ في مَنازِلِها","إِلّا ثَعالِبُ وَحشٍ بِتنَ في الوجُرِ",2,"ر",1,0],["وهلَ ثمَّ معنىً للنبوغ بأَوِجهِ","يُساقُ إلى الموتِ المحَّتم والحفر",3,"ر",1,0],["وهل ثِقَةٌ فيمن يَقولُ لِسانُهُ","وأَعالُهُ عَن عكسِ قَولٍ تُتَرجِمُ",4,"م",1,0],["وَهَلْ ثَنَى الدَّهْرُ غربا من محاسنهِ","فَكَانَ كَوْكَب شَرْق فِي ليالِيهِ",5,"ي",2,0],["وهَلْ ثَمَلُ مُنْكرٌ بَعْدَ أَنْ","تَكونَ لَهُ راحَتاهُ ثِمالا",6,"ل",2,0],["وهل ثبتتْ أمةُ في العُلى","بغير يدِ المرأة الراقيه",7,"ي",2,0],["وهل ثنت خيلكم عطفا اعنتها","على الهوادج لما ضجت الحرم",8,"م",1,0],["وهل ثم للمثني مجال وقد اتى","بمدحته الذكر الحكيم منجما",9,"م",2,0],["وهل ثم إلا راحة لا مدَى لها","بها الرَوْح والريحانُ للأنفسِ المرُضِ",10,"ض",1,0],["وهل ثم نفس لا تميل إلى الهوى","محال ولكن ثم عزم الصبر",11,"ر",1,1],["وهلْ ثَوْبُكِ ارتاحَ مِنْ تُرَّهاتي؟","أمِ الثَّوبُ يشتاقُني مُذْ أفَلْتُ؟",12,"ت",1,0],["وهل ثائر في قائم السيف من بني","أبي طالب للثأر أسرع طالب",13,"ب",1,0],["وهل ثم أقسى من بلادٍ تُقيمها","وما لك مرعىً في رباها ومنزِلُ",14,"ل",1,0]]}