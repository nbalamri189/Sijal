{"poems":[[91,"تأن في الظلم تخفيفا وتهوينا","https://www.aldiwan.net/poem44960.html","البسيط"],[68,"وعدكم بالندى سقيم","https://www.aldiwan.net/poem38743.html","مجزوء البسيط"],[108,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[443,"أضر بي إذا جد في كعبه","https://www.aldiwan.net/poem2591.html","المنسرح"],[454,"الحكم للعمل","https://www.aldiwan.net/poem1013.html",""],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56706","السريع"],[1294,"","https://poetry.dctabudhabi.ae/diwan/poem/101147","الكامل"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79411","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79905","الخفيف"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102049","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200208","الخفيف"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147337","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110173","الرمل"],[4004,"","https://poetry.dctabudhabi.ae/diwan/poem/111313","الرمل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81292","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83137","الخفيف"],[4750,"كل دار أرجعت وأنا سناوي","https://www.poetsgate.com/ViewPoem.aspx?id=180447",""],[4755,"مِل مَعَ التَّقبيلِ","https://www.poetsgate.com/ViewPoem.aspx?id=195173",""],[4940,"سحر البدايات","https://www.poetsgate.com/ViewPoem.aspx?id=207394",""],[4940,"لوحة من دلال","https://www.poetsgate.com/ViewPoem.aspx?id=210414",""],[4975,"رنين شوق","https://www.poetsgate.com/ViewPoem.aspx?id=189471",""],[5092,"نحتاجُ لَمْسَ الورد","https://www.poetsgate.com/ViewPoem.aspx?id=213361",""],[5121,"حُلِي","https://www.poetsgate.com/ViewPoem.aspx?id=215841",""],[5277,"الشارد","https://www.poetsgate.com/ViewPoem.aspx?id=193593",""],[5284,"جارتا النهرين","https://www.poetsgate.com/ViewPoem.aspx?id=191795",""],[5491,"قلبٌ تعلّقَ بالهوى","https://www.poetsgate.com/ViewPoem.aspx?id=196673",""],[5720,"الْهِنْدُ","https://www.poetsgate.com/ViewPoem.aspx?id=205305",""],[5795,"نصرت دولة المهى التركيه","https://www.poetsgate.com/ViewPoem.aspx?id=167910",""],[5829,"كان الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=162006",""],[5894,"يا حداة السرى بحث المطي","https://www.poetsgate.com/ViewPoem.aspx?id=131438",""],[5909,"يا رقّة الرؤيا التي آنستها","https://www.poetsgate.com/ViewPoem.aspx?id=210227",""],[6124,"نكتب الأوتار","https://www.poetsgate.com/ViewPoem.aspx?id=121830",""],[6124,"حلم اللقاء","https://www.poetsgate.com/ViewPoem.aspx?id=174740",""],[454,"الحكم للعمل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82643&r=&rc=7",""]],"verses":[["يا رقق اللَه منك القلب من ملك","يجمع المال لكن من مساعينا",0,"ن",2,0],["يا رَقدَةً لَم يَحظَ قَديماً","بِمِثلِها الكَهفُ وَالرَقيمُ",1,"م",1,0],["يا رقيقَ البَنان، كيف حفرت الصَّ","خر بالظِّفر؟ يا رقيقَ البنان",2,"ن",1,0],["يا رقدة لم يزل يزورّها","لي أملي فالحياة من كذبه",3,"ب",2,0],["يا رقة الشعر فيك الحب ما فعل","حتى تحولت شهدا يخجل العسلا",4,"ل",2,0],["يأرق ناس ليلهم كلّهُ","ما أطول الليل على الآرق",5,"ق",1,0],["يا رقعة جاءت بأشرف ساعة","من سيد للنيرين يضاهي",6,"ي",1,1],["يا رقعةً طُوِيَتْ على حَيَّاتِ","وعقاربٍ كَرَّرْنَ ماءَ حياتي",7,"ت",2,1],["يا رُقوداً ببابلٍ لا عَلمتُم","كيف يُمسي أخو الحشا المُرتاح",8,"ح",1,0],["يا رق نجد من المصلى","أهجت شوقاً على السقيم",9,"م",1,0],["يا رقيباً أتى بدون حبيبٍ","أنت شوكٌ فأين خلّفت وردك",10,"ك",1,1],["يَا رِقَّةَ الوَرْدِ المُبَلَّلِ بِالتُّقى","كَالضّوءِ وهّاجَاً بِرَوْضٍ يَشْهَقُ",11,"ق",1,0],["يا رقيّاً بالحِجَى","لاقَ بي ان أُنشِدَه",12,"ه",1,1],["يا رقيق الساق يا من","كنت للحسن منارا",13,"ر",2,0],["يا رقة في الثَرى تَذوب","وَنَضرة لِلرَدى تَنشر",14,"ر",1,0],["يا رَقيقاً كَم حَمَّلُوكَ رَقيقاً","مِن مُنىً عَذبةٍ وَمِن أَشواقِ",15,"ق",1,0],["يارقبة الخشف يا عين النداوي","ياسراجيف الذلول المستحيله",16,"ل",2,0],["يا رَقِيقَ الحُبِّ, زِدنِي وَجَعًا","إِنَّ سِرَّ الحُبِّ فِي سَطوَتِهِ",17,"ت",2,0],["يارقةَ الماءِ والأنداءُ ظامئةٌ","لقبلةِ الوردِ في كلّ الصّباحاتِ",18,"ت",1,0],["يارقة المعنى وفرط عذوبة","أحيت بوصف جمالها أقلاما",19,"م",2,0],["يارقّة الأشواق في لغةٍ","صمتاً فإنّ مشاعري أحلى",20,"ل",2,0],["يا رقَّةً غابت بماءِ وجوهِنا","صُبّي حياءك في العيونِ تَصَبُّحَا",21,"ح",2,0],["يَا رِقَّةَ الْحَرْفِ الْمُرَصَّعِ بِالْحُلِي","مُتَلَأْلِئاً كَالنَّجْمِ شَعْشَعَ مِنْ عَلِ",22,"ل",1,1],["يا رقَّةً طابتْ وأبدتْ منبَعَكْ","ما إنْ أُطيقُ معَ النوى أنْ أمنعَكْ",23,"ك",1,0],["يارَقَّةَ الأمجادِ يامَأْسُورَةً","والحربُ تُفْتَكُ عِندَها الأكبادُ",24,"د",1,0],["يارَقَّةَ الشَّامِ الجريحِ تَصَبَّري","ماخُلِّدَ المُستعبِدُ القَوَّادُ",24,"د",1,0],["يا رِقَّةَ الوجدِ العفيفِ سماحةً","بين الضلوع ِ خيالُهُ متصوِّفُ",25,"ف",1,0],["يا رقةَ الأجواءِ فيكِ .. ولطفِها","لمّا النسيمُ أشاعَ عطراً فاخِرا!",26,"ر",2,0],["يا رقيقاً لذات خصر رقيق","برئت منك ذمة الحريه",27,"ي",2,0],["يا رقدا في روابي ميسلون أفق","عاد الغزاة وكل الدار إضرام",28,"م",1,0],["يا رقيقة الخصر رقى لحالي","لا تجوري تدللا كالصبي",29,"ي",1,0],["يا رقّة الرؤيا التي آنستها","محشورة بين الغفا والصحوِ",30,"و",1,1],["يا رقيقَ الهمسِ هلْ هلَّ المدى","واجتباني شاهداً في مصرعكْ",31,"ك",1,0],["يا رقيقًا مثل نجمٍ في السماءِ","حينما أعطيتني نهرَ الحياءِ",32,"ا",2,1],["يا رقة الشعر فيك الحب ما فعلا","حتى تحولت شهدا يخجل العسلا",33,"ل",2,0]]}