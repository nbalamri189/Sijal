{"poems":[[74,"قالوا ذقون الملاح باردة","https://www.aldiwan.net/poem18632.html","المنسرح"],[50,"عاج الشقي على دار يسائلها","https://www.aldiwan.net/poem62547.html","البسيط"],[52,"يا رحمة الله حلي في منازلنا","https://www.aldiwan.net/poem63828.html","البسيط"],[128,"عفا الصفا وانتفى من كوخ ندماني","https://www.aldiwan.net/poem23777.html","البسيط"],[146,"قالوا ذر الشعر وكن عائدا","https://www.aldiwan.net/poem58384.html","السريع"],[215,"غنى المغنون من حولى فما سمعت","https://www.aldiwan.net/poem46768.html","البسيط"],[408,"قالوا ذكرت أبا بكر فقلت لهم","https://www.aldiwan.net/poem46946.html","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65327","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45768","البسيط"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131954","الرمل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44660","الكامل"],[4940,"روح من جنون","https://www.poetsgate.com/ViewPoem.aspx?id=205646",""],[6093,"الشخص ُيذهبُ للحَمَّامِ مُضْطَرَّا","https://www.poetsgate.com/ViewPoem.aspx?id=190103",""],[6127,"اقرأ","https://www.poetsgate.com/ViewPoem.aspx?id=197852",""]],"verses":[["قالوا ذقونُ الملاح باردة","منكرات قلت اهدروا نكدي",0,"ي",1,1],["قالوا ذَكَرتَ دِيارَ الحَيِّ مِن أَسَدٍ","لا دَرَّ دَرُّكَ قُل لي مَن بَنو أَسَدِ",1,"د",1,0],["قالوا ذَواتُ الغِنى خَيرٌ فَقُلتُ لَهُم","بِرَحمَةِ اللَهِ أَستَغني وَأَوطاري",2,"ر",2,0],["قالوا ذوو الشأن في عمان تغضبهم","صراحتي ولذا أفتوا بحرماني",3,"ن",2,0],["قالوا ذوو الشأن في عمان قد برموا","بمسلكي واصطفاني رهط مجان",3,"ن",1,0],["قالوا ذر الشعرَ وكن عائدا","بالله يصرفْ عنك شيطانَهُ",4,"ن",2,1],["قالوا ذوى الشعر في مصر فقلت له","إني سأجعله من بعض خلاني",5,"ن",2,0],["قالوا ذكرت أبا بكر فقلتُ لَهُمْ","لا غافلاً أبداً عنْهُ ولاَ لاهي",6,"ي",1,1],["قالوا ذُبولٌ مسّهُ فأجبتهم","صدقُوا ولكن من قضيب قوامه",7,"ه",1,0],["قالوا ذكاؤك مَحسوب عَلَيك كَما","يَروي فَقُلتُ حَديث غَير مَردود",8,"د",1,0],["قالوا ذوي غصن الشبا","ب وأنت تلهج بالنسيب",9,"ب",1,1],["قالوا ذُنوبكَ في الحَياةِ كَثيرةٌ","وَجَهَنَّمٌ بِالذَنب قَد تُذكيها",10,"ي",3,1],["قالوا ذهولا أما في العشق غيرهما؟!","حتى كأنهما قد عانقا السَّحُبا",11,"ب",2,0],["قالوا : ذهبتَ إليهِمْ قلتُ : معتذراَ","فَالشخص ُيذهبُ للحَمَّامِ مُضْطَرَّا",12,"ر",2,1],["قالوا ذللتٓ، وقلتُ الذل أجمعه","ذُل بلاك وعزٌّ فيكٓ ألتصقُ",13,"ق",1,0]]}