{"poems":[[119,"روحي وأرواح الوجود","https://www.aldiwan.net/poem42166.html","مجزوء الكامل"],[119,"إليك ربكان أرباب الفحول سعت","https://www.aldiwan.net/poem42179.html","البسيط"],[280,"أهلا بهن أهلة وكواكبا","https://www.aldiwan.net/poem25628.html","الكامل"],[505,"قد قام ينفخ داعي الصور في الصور","https://www.aldiwan.net/poem37999.html","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136305","الكامل"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145106","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46682",""],[4888,"مدرسة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=207751",""],[5720,"جمالُ الروح ..","https://www.poetsgate.com/ViewPoem.aspx?id=198836",""],[5720,"حَوْرَاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=214146",""],[5756,"رثاء الشيخ زايد","https://www.poetsgate.com/ViewPoem.aspx?id=8433",""],[5848,"الجاني والمتهم","https://www.poetsgate.com/ViewPoem.aspx?id=48842",""]],"verses":[["يا حضرة الإحسان يا","سر التدلي والصعود",0,"د",1,0],["يا حضرة كلما ضاق الوجود لخطب","مدهش الكرب فضلاً بالرضى اتسعت",1,"ت",1,0],["يا حَضْرَةَ التّوْحِيدِ زانَكَ حاضِراً","ثُمّ استَقَلّ يَسُدّ ثَغْرَك غَائِبا",2,"ب",2,0],["يا حضرَةً حفَّها الهادي بظرَتِهِ","فأصبحَتْ خيرَ محفوفٍ ومَنْظورِ",3,"ر",1,0],["يا حضرة قد شرفت اربابها","بلطيف سر نوالها المتوالي",4,"ل",2,0],["يا حضرة الدكتور ذي الأفضال","مالَكَ لا تعبأ بالرجال",5,"ل",1,0],["يا حضرةَ الشيخِ الظهيرِ الُمرتَجى","لولاكِ ما صنَّفتُه لولاكِ",6,"ك",1,0],["يا حضنَها المملوءَ دفئًا ضُمَّني","حتّى كأنّي في الفضاءِ أُحَلّقُ",7,"ق",1,0],["يا حضرةَ الشعرِ .. هلّا صغتَ مُقْتَضَباً","من ذلك الحسِّ ..كي أرقىٰ بتصويري ؟",8,"ر",2,0],["يا حضرةَ العُشاقِ كيفَ يعودُ ليْ","حاليْ .. وقلبي في المحبةِ ذابا؟!",9,"ب",2,0],["ياحضاره في زمن مابه حضاره","ياضمير العالم ٍ ميت ضميره",10,"ر",2,0],["يا حضرة الليل .. يا جاني واناالمتهّم","ضيعت عمري وانا مانيب ناقص ضياع",11,"ع",1,1]]}