{"poems":[[53,"لو رأيت الغرام يبلغ عذرا","https://www.aldiwan.net/poem30442.html","الخفيف"],[63,"وحي في الذؤابة من قريش","https://www.aldiwan.net/poem45740.html","الوافر"],[9,"تصابيت أم بانت بعقلك زينب","https://www.aldiwan.net/poem21908.html","الطويل"],[86,"هجعت يا طير ولم أهجع","https://www.aldiwan.net/poem68946.html","السريع"],[93,"من عذيري والدمع جار سخين","https://www.aldiwan.net/poem11202.html","الخفيف"],[72,"حلفت بليل الشعر منه إذا سجى","https://www.aldiwan.net/poem18453.html","الطويل"],[72,"يتيم ابتسامك ما يقهر","https://www.aldiwan.net/poem18706.html","المتقارب"],[72,"أما وتلفت الرشاء الغرير","https://www.aldiwan.net/poem18712.html","الوافر"],[72,"أبكيك للحسنين الخلق والخلق","https://www.aldiwan.net/poem19356.html","البسيط"],[72,"قوامك تحت شعرك يا أمامه","https://www.aldiwan.net/poem19681.html","الوافر"],[72,"أعيذ ريم الترك بالروم","https://www.aldiwan.net/poem19684.html","السريع"],[72,"لست أنسى ابتسامها اللؤلؤيا","https://www.aldiwan.net/poem20569.html","الخفيف"],[51,"أشد بأيامنا لتشهرها","https://www.aldiwan.net/poem64036.html","المنسرح"],[51,"الدين والعلم والنعماء والشرف","https://www.aldiwan.net/poem65471.html","البسيط"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[29,"أعاذلتي اليوم ويحكما مهلا","https://www.aldiwan.net/poem6068.html","الطويل"],[91,"أقبل العيد ولكن ليس في الناس المسره","https://www.aldiwan.net/poem8875.html","عموديه"],[89,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[89,"عاث هذا المنون يسرف فينا","https://www.aldiwan.net/poem44774.html","الخفيف"],[85,"تسائلني كرمتي بالنهار","https://www.aldiwan.net/poem8187.html","المتقارب"],[85,"ألا حبذا صحبة المكتب","https://www.aldiwan.net/poem62987.html","المتقارب"],[45,"أبكاء في الدار بعد الدار","https://www.aldiwan.net/poem63605.html","الخفيف"],[61,"أقصر الزاجر عنه فازدجر","https://www.aldiwan.net/poem51677.html","الرمل"],[66,"سوى حسن وجهك لم يحل لي","https://www.aldiwan.net/poem40964.html","المتقارب"],[31,"يقول خليلي إذ أجازت حمولها","https://www.aldiwan.net/poem42550.html","الطويل"],[74,"أما والتفات الروض عن أزرق النهر","https://www.aldiwan.net/poem12954.html","الطويل"],[81,"أشمس في غلالة أرجوان","https://www.aldiwan.net/poem61472.html","الوافر"],[13,"ترجي نساء الأزد طلعة ثابت","https://www.aldiwan.net/poem2208.html","الطويل"],[52,"بليت بعد شيبه","https://www.aldiwan.net/poem26932.html","مجزوء الرجز"],[75,"قد سار بي هذا الزمان فأوجفا","https://www.aldiwan.net/poem69062.html","الكامل"],[48,"ذكر الصبوح بسحرة فارتاحا","https://www.aldiwan.net/poem62495.html","الكامل"],[48,"إن كان يحيى يقدر","https://www.aldiwan.net/poem66289.html","المجتث"],[50,"تثاقل ليلي فما أبرح","https://www.aldiwan.net/poem63978.html","المتقارب"],[46,"تدري الحمامة حين تهتف بالضحى","https://www.aldiwan.net/poem23177.html","الكامل"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[106,"خيال في يقظة","https://www.poetsgate.com/ViewPoem.aspx?id=179676",""],[106,"يا ملاذ الموظفين","https://www.poetsgate.com/ViewPoem.aspx?id=179706",""],[105,"خلوا سبيل الشاعر المتدفع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55089&r=&rc=259",""],[107,"لحظات ترمي الحشا بنبال","https://www.aldiwan.net/poem16391.html","الخفيف"],[113,"آه من فتك طرفها القتال","https://www.aldiwan.net/poem41688.html","الخفيف"],[123,"وخديمة للعلم في أحشائها","https://www.aldiwan.net/poem4071.html","الكامل"],[126,"أأحبابنا منكم حياة لنا الوصل","https://www.aldiwan.net/poem50554.html","الطويل"],[133,"برزت في سحر البيان","https://www.aldiwan.net/poem49106.html","مجزوء الكامل"],[140,"عينى التي علقت حبائلكم بها","https://www.aldiwan.net/poem58369.html","الكامل"],[141,"علي لها أن أحفظ العهد والودا","https://www.aldiwan.net/poem11743.html","الطويل"],[148,"تركنا زهيرا للبقيع فثهمد","https://www.aldiwan.net/poem68579.html","الطويل"],[179,"أمن طلل بالجزع قو المعارف","https://www.aldiwan.net/poem58844.html","الطويل"],[180,"عرجا في ربوعها وسلاها","https://www.aldiwan.net/poem67021.html","الخفيف"],[184,"الورد يحسن في أوائل ورده","https://www.aldiwan.net/poem43648.html","الوافر"],[208,"هناء به شمل المعاني تنظما","https://www.aldiwan.net/poem13324.html","الطويل"],[208,"قتيل هواك ليس يروم ثاره","https://www.aldiwan.net/poem13365.html","الوافر"],[209,"لقد طالت الساعات إني أعدها","https://www.aldiwan.net/poem46283.html","الطويل"],[209,"أسافر في يوم الثلاثاء ليتني","https://www.aldiwan.net/poem46608.html","الطويل"],[209,"لقيتك بعد اليأس منك فصفقت","https://www.aldiwan.net/poem46765.html","الطويل"],[233,"لدينا يا ابن إسماعيل قدر","https://www.aldiwan.net/poem31935.html","الوافر"],[257,"إلام الحشا من لاعج الشوق في سخط","https://www.aldiwan.net/poem35776.html","الطويل"],[257,"موقع النجم في الحمى الشرقي","https://www.aldiwan.net/poem35936.html","الخفيف"],[259,"سلا عن ربي سلع فأعين عينها","https://www.aldiwan.net/poem38135.html","الطويل"],[268,"أيا هند الهوى أصل البلاء","https://www.aldiwan.net/poem35032.html","الوافر"],[268,"مرت كورد في الضحى مزهر","https://www.aldiwan.net/poem35431.html","السريع"],[268,"بما في ليالي الهوى من أرق","https://www.aldiwan.net/poem35459.html","المتقارب"],[280,"أحبابنا مذ بانوا","https://www.aldiwan.net/poem32393.html","مجزوء الرجز"],[280,"أومض البرق بعلياء منين","https://www.aldiwan.net/poem32401.html","الرمل"],[295,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[296,"واها لأيام الشباب الغض","https://www.aldiwan.net/poem36825.html","عموديه"],[302,"على ميم وادي الرقمتين سلامي","https://www.aldiwan.net/poem16854.html","الطويل"],[320,"أرقت وشر الداء هم مؤرق","https://www.aldiwan.net/poem56359.html","الطويل"],[340,"يا عروسا في ثياب الرقص","https://www.aldiwan.net/poem55341.html","مجزوء الرمل"],[359,"ان وجدي كل يوم في ازدياد","https://www.aldiwan.net/poem68123.html","الرمل"],[362,"جوانح واجد وجفون سال","https://www.aldiwan.net/poem60683.html","الوافر"],[362,"جمال ولكن أين منك جميل","https://www.aldiwan.net/poem60800.html","الخفيف"],[362,"أأحبتي الشاكين طول تغيبي","https://www.aldiwan.net/poem60990.html","الطويل"],[364,"أي شأن لا يباح به","https://www.aldiwan.net/poem17294.html","المديد"],[374,"أدركت شأوك فاتق الأسواء","https://www.aldiwan.net/poem66973.html","الكامل"],[377,"أقاسي من صدودك ما أقاسي","https://www.aldiwan.net/poem49212.html","الوافر"],[400,"بالله يا ريح الصبا","https://www.aldiwan.net/poem34157.html","مجزوء الرجز"],[429,"عقدوا شعورهم عمائم","https://www.aldiwan.net/poem12340.html","مجزوء الكامل"],[450,"قم بنا يا نديم فالطير غرد","https://www.aldiwan.net/poem13736.html","الخفيف"],[456,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[536,"من ذاك ينكر فضل إبراهيم","https://www.aldiwan.net/poem47956.html","عموديه"],[536,"إني بعثت لسيدي بكتابي","https://www.aldiwan.net/poem48294.html","عموديه"],[536,"طال مني لذا النهار ارتقابي","https://www.aldiwan.net/poem48296.html","عموديه"],[549,"عذيري من خليل لي","https://www.aldiwan.net/poem47145.html","الهزج"],[549,"ما للخيال ببطن مر يطرق","https://www.aldiwan.net/poem47378.html","الكامل"],[561,"غرام سقى قلبي مدامته صرفا","https://www.aldiwan.net/poem13596.html","الطويل"],[573,"إن الذي في عطفه بانه","https://www.aldiwan.net/poem2846.html","السريع"],[573,"عشقت ومن هذا الذي ليس يعشق","https://www.aldiwan.net/poem2909.html","الطويل"],[573,"طراز غرامي في المحبة مذهب","https://www.aldiwan.net/poem2984.html","الطويل"],[584,"وعيون أمرضن جسمي وأض","https://www.aldiwan.net/poem17680.html","الخفيف"],[585,"بحمد الله نبدأ في المقال","https://www.aldiwan.net/poem11558.html","عموديه"]],"verses":[["وَخُدوداً مِثلَ الذَوابِلِ مُلساً","وَجَباهاً مِثلَ الدَنانيرِ غُرّا",0,"ر",2,0],["وَخَدُّ الأَرضِ يَغمُرُهُ نَجيعٌ","وَعَينُ الشَّمسِ يَكحَلُها قَتامُ",1,"م",1,0],["وَخَدّاً أَسيلاً يَحدُرُ الدَمعَ فَوقَهُ","بَنانٌ كَهُدّابِ الدَمَقسِ مُخَضَّبُ",2,"ب",1,0],["وَخَدُّهُ لا تَنطَفي نارُهُ","كَأَنَّما يَقبِسُ مِن أَضلُعي",3,"ي",1,0],["وَخَدِيناً عَلَى اخْتِلافِ اللَّيَالِي","لا يُجَارِيهِ فِي الوَلاءِ خَدِينُ",4,"ن",1,0],["وخدًّا كفاني صبوَةً شمُّ وردهُ","فكيف وقد زاد العذار بنفسجا",5,"ج",2,0],["وخدّك ذا السهل ما باله","على من رجا قُبلةً يعسر",6,"ر",1,0],["وخدّ لاح فيه خيال دمعي","فقل في الرَّوض والماءِ النهير",7,"ر",1,0],["وخدَّدت فوق خدِّي للبكا طرق","حتى رويت حديث الحزن عن طرق",8,"ق",1,0],["وخدّ شاهدٌ بدمي وإلا","بأن وراه من ريق مدامهْ",9,"م",2,0],["وخدّه المشرق قد صحّ في","عذراه المعوجّ تقويمي",10,"م",2,0],["وخدوداً حمريَّة اللون أشكو","من جفاها وناظراً مستحيا",11,"ي",2,0],["وخدمةٍ للصديق دائمةٍ","تَجشَمُها النفسُ كي يوقِّرها",12,"ر",3,0],["وخدمةً سبقت أيامَ دولته","ما مثلها زلفة إن عدت الزلف",13,"ف",1,0],["وخَدْلٌ وممشوقٌ وأبيض ناصعٌ","وأسودُ غِربيبٌ وأقنى وأخثمُ",14,"م",1,0],["وَخَدّاً أَسيلاً غَيرَ زَغبٍ مَقَذُّهُ","بِمُذهِبَةٍ في الجيدِ قَد فُتِلَت فَتلا",15,"ل",2,0],["وَخُدوداً باهِتاتٍ قَد كَساها الهَمُّ صُفرَه","وَشِفاهاً تَحذُرُ الضِحكَ كَأَنَّ الضِحكَ جَمرَه",16,"ر",2,0],["وخدمت الآداب فيها بصدق","مثلما يخدم الرياض الربيع",17,"ع",1,0],["وخدمت العلم العزيز لاجل العلم لم","تبغ منه دنياً ودينا",18,"ن",2,0],["وخدمت الانسان بعد جهاد","متعب وهي غاية المحسنينا",18,"ن",2,0],["وَخِدمَةُ فَنٍّ يُداوي القُلوبَ","وَيَشفي النُفوسَ وَيُذكي الفِطَن",19,"ن",1,0],["وَخَدَّشَ ظُفرُ الزَمانِ الوُجو","هَ وَغَيَّضَ مِن بِشرِها المُعجِبِ",20,"ب",1,0],["وَخَدانُ القِلاصِ حولاً إِذا قا","بَلنَ حولاً مِن أَنجُمِ الأَسحارِ",21,"ر",1,0],["وخُدودٌ سفَرَتْ عن وَرْدِها","أم ربيعٌ عن جَنى الوَرْدِ سفَر",22,"ر",1,0],["وَخَدُّكَ موقَدَةٌ نارُهُ","وَقَلبي بِجُذوَتِها يَصطَلي",23,"ل",2,0],["وَخَدٍّ أَسيلٍ كَالوَذِيلَةِ ناعِمٍ","مَتى يَرَهُ راءٍ يُهِلُّ وَيُسحِرُ",24,"ر",1,0],["وَخِدرِ فَتاةٍ قَد طَرَقتُ وَإِنَّما","أَبَحتُ بِهِ وَكرَ الحَمامَةِ لِلصَقرِ",25,"ر",1,0],["وَخَدٌّ فيهِ تُفّاحٌ وَوَردٌ","عَلَيهِ مِنَ العَقارِبِ حارِسانِ",26,"ن",1,0],["وَخَدتُ بِهِم حَتّى إِذا طالَ وَخدُهُم","وَرابَ عَلَيهِم مَضجَعي وَمَقيلي",27,"ي",1,0],["وَخَدَّهُ مُشَوِّكٌ","مُزَرَّرُ التَلويزِ",28,"ز",1,0],["وخُدورِ مثلِكِ قد طرقتُ لقومِها","متعرِّضاً ولأرضِها متعسِّفا",29,"ف",2,0],["وَخَدينِ لَذّاتٍ مُعَلَّلِ صاحِبٍ","يَقتاتُ مِنهُ فُكاهَةً وَمُزاحا",30,"ح",2,0],["وخدّ وجهٍ منيرٍ","بمائهِ الزهرُ يقطر",31,"ر",1,0],["وَخَدٌّ أَسيلٌ وَكَفٌّ إِذا","أَشارَت لِقَومٍ بِها سَبَّحوا",32,"ح",3,0],["وَخَدى لِأَرضٍ بِالفَقيرِ نَجِيُّهُ","فَأَصابَ ثَروَتَها وَحازَ خِدالَها",33,"ل",3,0],["وَخَدٌّ كَقِرطاسِ الشَآمي وَمِشفَرٌ","كَسِبتِ اليَماني قَدُّهُ لَم يُجَرَّدِ",34,"د",1,0],["وَخَدّاً كَبُرقُوعِ الفَتاةِ مُلَمَّعٍ","وَرَوقَينِ لَمّا يَعدُوَا أَن تَقَشَّرا",35,"ر",2,0],["وخدعت نفسي؛ فاشتكيت له الج","وى وكأنَّني مترقِّبٌ أن يَفهما",36,"م",2,0],["وخَدعنا الورى بزيّ جميلٍ","وهو قُبحٌ مُمَوَةٌ بطلاء",37,"ا",2,0],["وخد القلادة صاغها لك شاعر","الله أورثه قلائد تبع",38,"ع",1,0],["وَخُدود كَالوَرد لَوناً وَطيباً","صَقَلتها صِبا إِلَيها وَالجَمال",39,"ل",1,0],["وخدود كالبدر أشرق ليلاً","وجبين مبرج كالهلال",40,"ل",1,0],["وخَديمةٍ للعلمِ في أحشائِها","كلَفٌ بجمع حرامِهِ وحَلالِهِ",41,"ه",1,1],["وخدٌّ صقيل ناعمٌ لا يشينُه","بياضٌ عَلَتْه جمرةُ ما بِه صَقْلُ",42,"ل",1,0],["وخدمتَ ديوانَ المعا","رفِ مخلصاً بتشوقِ",43,"ق",1,0],["وخدعتمُ سمعى بطيبِ حديثكم","ومن الكلام لآلىءٌ وفرائدُ",44,"د",1,0],["وَخِدنُ الهَوى مَن عَدَّ إِسخاطَهُ رِضىً","وَإِكدارَهُ صَفواً وَحَنظَلَهُ شَهدا",45,"د",2,0],["وَخَدَت عيسُ المُلَبِّينَ نَحوَهُ","بِأَضوَعَ مِن شَوقٍ تَلَقَّتهُ مِن نَحوي",46,"ي",1,0],["وَخَدنَ بِهِم حتّى كأَنَّ ثِيابَهُم","تَزَعزَعُ مِن لَفَّ الرِّياحِ العَواصِفِ",47,"ف",1,0],["وَخدوش الظَراء آلَم مَضّاً","مِن جِراحِ السُيوفِ رَقّت ظُباها",48,"ا",3,0],["وخدودُ ربّات الحجال مميّز","يغلو لعزّته على أهل الورع",49,"ع",1,0],["وخد الشقيق الغض اينع عندما","كساه الندى بالدر حسنا ورق ما",50,"م",2,0],["وخد جلنار الروض ابدى","ومن تلك النهود غدت ثماره",51,"ر",2,0],["وخدٌّ تقول الراح إن رحيقها","عصائر من خدّ له الروح عاصر",52,"ر",1,0],["وخداك ما خداك والجمر صارخا","أخفّ حريقا حين يطفى وأمهل",53,"ل",1,0],["وخدّان كالصهباء ثار رحيقها","فصار شذاها عاشقا يتنهد",54,"د",1,0],["وَخَدُّ الوَردِ قَد أَضحى نَظيماً","عَليهِ لُؤلُؤُ الطَلِّ النَثيرُ",55,"ر",1,0],["وخدٍّ حكى الروضَ الأريضَ الّذي به","لقد بسط الورد الجني ألطفَ البسط",56,"ط",1,0],["وخدودٍ محمّرةٍ كورودٍ","عمّها عرش خالها المسكيّ",57,"ي"