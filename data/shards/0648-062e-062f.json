فا نحو كؤوس الأنس ساق","https://www.poetsgate.com/ViewPoem.aspx?id=49492",""],[4862,"أملٌ يجدد للحبيب رجوعا","https://www.poetsgate.com/ViewPoem.aspx?id=55512",""],[4869,"اطهر حزينه","https://www.poetsgate.com/ViewPoem.aspx?id=151616",""],[4875,"الشُهرة","https://www.poetsgate.com/ViewPoem.aspx?id=133719",""],[4927,"معلقة أمير الشهداء المعاصرين صَدّام يرحمه الله","https://www.poetsgate.com/ViewPoem.aspx?id=36731",""],[4984,"حسن إختيار أو انهيار","https://www.poetsgate.com/ViewPoem.aspx?id=191329",""],[5038,"الصدّيقة الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=195418",""],[5061,"الاجوديه","https://www.poetsgate.com/ViewPoem.aspx?id=147150",""],[585,"تلك القبور وماثل الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=161873",""],[3591,"أنيخوا مطاياكم غداة نودع","https://www.poetsgate.com/ViewPoem.aspx?id=149422",""],[5136,"ومهاة ذات صد وملل","https://www.poetsgate.com/ViewPoem.aspx?id=121643",""],[5145,"أعينا فؤادي على ما يعاني","https://www.poetsgate.com/ViewPoem.aspx?id=108214",""],[5183,"من مُلح الرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=180281",""],[5186,"في ليلة القدر أتاح الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=156523",""],[5191,"العيون الخضر","https://www.poetsgate.com/ViewPoem.aspx?id=212017",""],[5219,"تبدى ملاكا","https://www.poetsgate.com/ViewPoem.aspx?id=194165",""],[5219,"أنين قلب","https://www.poetsgate.com/ViewPoem.aspx?id=194918",""],[5277,"ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=184903",""],[592,"أشاقك من سعدي بتلك المنازل","https://www.poetsgate.com/ViewPoem.aspx?id=128861",""],[5550,"يا كثيرَ الصُّدُود","https://www.poetsgate.com/ViewPoem.aspx?id=211543",""],[5704,"السلام عليك ايها القمر٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=202946",""],[5759,"أقولُ لها","https://www.poetsgate.com/ViewPoem.aspx?id=214106",""],[5956,"وتتابعت آيات ربك","https://www.poetsgate.com/ViewPoem.aspx?id=192633",""],[6011,"وخد قد غدا مرآة حسن","https://www.poetsgate.com/ViewPoem.aspx?id=169340",""],[6031,"بعثَتْ طَيْفَها فَزَارَ طُرُوقَا","https://www.poetsgate.com/ViewPoem.aspx?id=46276",""],[6056,"الشمس والفيّ","https://www.poetsgate.com/ViewPoem.aspx?id=130382",""],[6056,"الخنجر المذروب","https://www.poetsgate.com/ViewPoem.aspx?id=130515",""],[6093,"أسارةُ إنَّ الهّجْرَ للحبِّ قاتل","https://www.poetsgate.com/ViewPoem.aspx?id=176430",""],[6102,"جيهان ..","https://www.poetsgate.com/ViewPoem.aspx?id=183612",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""]],"verses":[["وَخُدوداً مِثلَ الذَوابِلِ مُلساً","وَجَباهاً مِثلَ الدَنانيرِ غُرّا",0,"ر",2,0],["وَخَدُّ الأَرضِ يَغمُرُهُ نَجيعٌ","وَعَينُ الشَّمسِ يَكحَلُها قَتامُ",1,"م",1,0],["وَخَدّاً أَسيلاً يَحدُرُ الدَمعَ فَوقَهُ","بَنانٌ كَهُدّابِ الدَمَقسِ مُخَضَّبُ",2,"ب",1,0],["وَخَدُّهُ لا تَنطَفي نارُهُ","كَأَنَّما يَقبِسُ مِن أَضلُعي",3,"ع",2,0],["وَخَدِيناً عَلَى اخْتِلافِ اللَّيَالِي","لا يُجَارِيهِ فِي الوَلاءِ خَدِينُ",4,"ن",1,0],["وخدًّا كفاني صبوَةً شمُّ وردهُ","فكيف وقد زاد العذار بنفسجا",5,"ج",2,0],["وخدّك ذا السهل ما باله","على من رجا قُبلةً يعسر",6,"ر",1,0],["وخدّ لاح فيه خيال دمعي","فقل في الرَّوض والماءِ النهير",7,"ر",1,0],["وخدَّدت فوق خدِّي للبكا طرق","حتى رويت حديث الحزن عن طرق",8,"ق",1,0],["وخدّ شاهدٌ بدمي وإلا","بأن وراه من ريق مدامهْ",9,"م",2,0],["وخدّه المشرق قد صحّ في","عذراه المعوجّ تقويمي",10,"م",2,0],["وخدوداً حمريَّة اللون أشكو","من جفاها وناظراً مستحيا",11,"ي",2,0],["وخدمةٍ للصديق دائمةٍ","تَجشَمُها النفسُ كي يوقِّرها",12,"ر",3,0],["وخدمةً سبقت أيامَ دولته","ما مثلها زلفة إن عدت الزلف",13,"ف",1,0],["وخَدْلٌ وممشوقٌ وأبيض ناصعٌ","وأسودُ غِربيبٌ وأقنى وأخثمُ",14,"م",1,0],["وَخَدّاً أَسيلاً غَيرَ زَغبٍ مَقَذُّهُ","بِمُذهِبَةٍ في الجيدِ قَد فُتِلَت فَتلا",15,"ل",2,0],["وَخُدوداً باهِتاتٍ قَد كَساها الهَمُّ صُفرَه","وَشِفاهاً تَحذُرُ الضِحكَ كَأَنَّ الضِحكَ جَمرَه",16,"ر",2,0],["وخدمت الآداب فيها بصدق","مثلما يخدم الرياض الربيع",17,"ع",1,0],["وخدمت العلم العزيز لاجل العلم لم","تبغ منه دنياً ودينا",18,"ن",2,0],["وخدمت الانسان بعد جهاد","متعب وهي غاية المحسنينا",18,"ن",2,0],["وَخِدمَةُ فَنٍّ يُداوي القُلوبَ","وَيَشفي النُفوسَ وَيُذكي الفِطَن",19,"ن",1,0],["وَخَدَّشَ ظُفرُ الزَمانِ الوُجو","هَ وَغَيَّضَ مِن بِشرِها المُعجِبِ",20,"ب",1,0],["وَخَدانُ القِلاصِ حولاً إِذا قا","بَلنَ حولاً مِن أَنجُمِ الأَسحارِ",21,"ر",1,0],["وخُدودٌ سفَرَتْ عن وَرْدِها","أم ربيعٌ عن جَنى الوَرْدِ سفَر",22,"ر",1,0],["وَخَدُّكَ موقَدَةٌ نارُهُ","وَقَلبي بِجُذوَتِها يَصطَلي",23,"ل",2,0],["وَخَدٍّ أَسيلٍ كَالوَذِيلَةِ ناعِمٍ","مَتى يَرَهُ راءٍ يُهِلُّ وَيُسحِرُ",24,"ر",1,0],["وَخِدرِ فَتاةٍ قَد طَرَقتُ وَإِنَّما","أَبَحتُ بِهِ وَكرَ الحَمامَةِ لِلصَقرِ",25,"ر",1,0],["وَخَدٌّ فيهِ تُفّاحٌ وَوَردٌ","عَلَيهِ مِنَ العَقارِبِ حارِسانِ",26,"ن",1,0],["وَخَدتُ بِهِم حَتّى إِذا طالَ وَخدُهُم","وَرابَ عَلَيهِم مَضجَعي وَمَقيلي",27,"ل",2,0],["وَخَدَّهُ مُشَوِّكٌ","مُزَرَّرُ التَلويزِ",28,"ز",1,0],["وخُدورِ مثلِكِ قد طرقتُ لقومِها","متعرِّضاً ولأرضِها متعسِّفا",29,"ف",2,0],["وَخَدينِ لَذّاتٍ مُعَلَّلِ صاحِبٍ","يَقتاتُ مِنهُ فُكاهَةً وَمُزاحا",30,"ح",2,0],["وخدّ وجهٍ منيرٍ","بمائهِ الزهرُ يقطر",31,"ر",1,0],["وَخَدٌّ أَسيلٌ وَكَفٌّ إِذا","أَشارَت لِقَومٍ بِها سَبَّحوا",32,"ح",3,0],["وَخَدى لِأَرضٍ بِالفَقيرِ نَجِيُّهُ","فَأَصابَ ثَروَتَها وَحازَ خِدالَها",33,"ل",3,0],["وَخَدٌّ كَقِرطاسِ الشَآمي وَمِشفَرٌ","كَسِبتِ اليَماني قَدُّهُ لَم يُجَرَّدِ",34,"د",1,0],["وَخَدّاً كَبُرقُوعِ الفَتاةِ مُلَمَّعٍ","وَرَوقَينِ لَمّا يَعدُوَا أَن تَقَشَّرا",35,"ر",2,0],["وخدعت نفسي؛ فاشتكيت له الج","وى وكأنَّني مترقِّبٌ أن يَفهما",36,"م",2,0],["وخَدعنا الورى بزيّ جميلٍ","وهو قُبحٌ مُمَوَةٌ بطلاء",37,"ا",2,0],["وخد القلادة صاغها لك شاعر","الله أورثه قلائد تبع",38,"ع",1,0],["وَخُدود كَالوَرد لَوناً وَطيباً","صَقَلتها صِبا إِلَيها وَالجَمال",39,"ل",1,0],["وخدود كالبدر أشرق ليلاً","وجبين مبرج كالهلال",40,"ل",1,0],["وخَديمةٍ للعلمِ في أحشائِها","كلَفٌ بجمع حرامِهِ وحَلالِهِ",41,"ه",1,1],["وخدٌّ صقيل ناعمٌ لا يشينُه","بياضٌ عَلَتْه جمرةُ ما بِه صَقْلُ",42,"ل",1,0],["وخدمتَ ديوانَ المعا","رفِ مخلصاً بتشوقِ",43,"ق",1,0],["وخدعتمُ سمعى بطيبِ حديثكم","ومن الكلام لآلىءٌ وفرائدُ",44,"د",1,0],["وَخِدنُ الهَوى مَن عَدَّ إِسخاطَهُ رِضىً","وَإِكدارَهُ صَفواً وَحَنظَلَهُ شَهدا",45,"د",2,0],["وَخَدَت عيسُ المُلَبِّينَ نَحوَهُ","بِأَضوَعَ مِن شَوقٍ تَلَقَّتهُ مِن نَحوي",46,"ي",1,0],["وَخَدنَ بِهِم حتّى كأَنَّ ثِيابَهُم","تَزَعزَعُ مِن لَفَّ الرِّياحِ العَواصِفِ",47,"ف",1,0],["وَخدوش الظَراء آلَم مَضّاً","مِن جِراحِ السُيوفِ رَقّت ظُباها",48,"ا",3,0],["وخدودُ ربّات الحجال مميّز","يغلو لعزّته على أهل الورع",49,"ع",1,0],["وخد الشقيق الغض اينع عندما","كساه الندى بالدر حسنا ورق ما",50,"م",2,0],["وخد جلنار الروض ابدى","ومن تلك النهود غدت ثماره",51,"ر",2,0],["وخدٌّ تقول الراح إن رحيقها","عصائر من خدّ له الروح عاصر",52,"ر",1,0],["وخداك ما خداك والجمر صارخا","أخفّ حريقا حين يطفى وأمهل",53,"ل",1,0],["وخدّان كالصهباء ثار رحيقها","فصار شذاها عاشقا يتنهد",54,"د",1,0],["وَخَدُّ الوَردِ قَد أَضحى نَظيماً","عَليهِ لُؤلُؤُ الطَلِّ النَثيرُ",55,"ر",1,0],["وخدٍّ حكى الروضَ الأريضَ الّذي به","لقد بسط الورد الجني ألطفَ البسط",56,"ط",1,0],["وخدودٍ محمّرةٍ كورودٍ","عمّها عرش خالها المسكيّ",57,"ي",1,0],["وخدن المعالي الفاخرات بمجده","وفخر معالينا بفخر خدينها",58,"ن",3,0],["وخدُّك صانهُ النعمانُ زهراً","تولَّت رَيَّهُ ماءُ السماء",59,"ا",2,0],["وخدُّها مُستَعِرٌ خلقةً","لا مُستَعارٌ فهو جانٍ بري",60,"ر",2,0],["وخدُّكِ فَلقَةُ رمّانةٍ","ومثلَ السوارِ فؤادي خَفَق",61,"ق",1,0],["وَخَدُّها أَعارَهُ","تُفّاحَهُ لُبنانُ",62,"ن",1,0],["وَخُدودٍ عِندَها تُفّاحُ لُب","نانَ في الأَغصانِ خَجلانُ حَزين",63,"ن",1,0],["وَخدمةُ الأَضيافِ","سجيَّةُ الأَشرافِ",64,"ف",1,0],["وخدِّها المورَّدِ","وَصدغِها المزرَّدِ",64,"د",1,0],["وَخدها مورّدٌ أسيلُ","ولحظُها مهندٌ صقيلُ",65,"ل",1,0],["وخد شقيق الورد في وجناته","وطرف به سحر ورشق سهام",66,"م",1,0],["وَخَدّانِ زانا وَجهَ عَنسٍ كَأَنَّها","وَقَد ضَمَرَت قَرمٌ مِنَ الأُدمِ أَشدَقُ",67,"ق",1,0],["وخدود من حرير","ونهود بارزات",68,"ت",1,0],["وَخد ود تَتَلَظّى حمرة","وَدَلال قَد نَفى عَنّي الرقاد",69,"د",1,0],["وخَدّاً منه يَبرُقُ مِلءَ عَيْني","كما برَق المُهنّدُ ذو الصِّقال",70,"ل",1,0],["وخَدِّيَ من صِبْغِ الدُّموعِ مُورَّدٌ","وطَرْفيَ باللّيلِ الطّويل كَحيل",71,"ل",1,0],["وخَدمتُكم ليلَ الشّبابِ بطُولِه","حتّى بدا صُبْحُ العِذارِ الأشيَب",72,"ب",1,0],["وَخُدودُ الأَرضِ مُشرِفَةٌ","مِن دَمٍ وَالخَيلُ خَيلانُ",73,"ن",1,0],["وَخِدِ المَسيرَ الجِدَّ في جَدَدِ التُقى","بَمناسِمٍ تَذَرُ السَمومَ رُخاءَ",74,"ا",2,0],["وَخَدٌّ فَوقَهُ وَردٌ جَنيٌّ","وَصَدغ تبتهُ مخضل آس",75,"س",1,0],["وخده قد جمع الم","اء به واللهبا",76,"ب",2,0],["وخُدِعْتُ في قلبي فقدْ","أَسْلَمْتُهُ ورَجَعْتُ سالِم",77,"م",1,0],["وخدود مضرّجاتٍ عليها","شعراتٌ من لينها تتجعدْ",78,"د",1,0],["وخُدعْتُ عن وفري وما خُدِعَتْ","عن ذمةٍ نفسي ولا إلِّ",79,"ل",1,0],["وخديمُكم ومُحِبُّكم","حاشا وحَقِّكمُ يُضام",80,"م",1,0],["وخدِيمُكم عَمِيت نَواظِرُه علَى","مرأى الضَّفادِع في نفُوسِ ذئابِ",81,"ب",1,0],["وخَديمُ الأعتَابِ ليسَ يُلاقِي","غيرَ خَيرٍ من سيِّد الأعتَابِ",82,"ب",1,0],["وخدّي فوق يُسْراهُ","وجَنْبي تحت يُمناهُ",83,"ا",2,0],["وَخَدعتَ إلّا أنَّ كلَّ خديعةٍ","رَوَّتْ صدى كَلِفٍ يُحبّ ويعشِقُ",84,"ق",1,0],["وَخَدٌّ كَما تَحتَ المُحيطِ مِنَ الثَرى","فَآلَيتُهُ لا جَفَّ إِلّا إِذا جَفّا",85,"ف",2,0],["وخدُّه التِّبْريُّ قد قال لي","بأَنَّه في وجْنَتَيْه عَانَه",86,"ن",2,0],["وخَدْشٌ على خَطِّ العِذَارِ كأَنَّهُ","كلامٌ على سَطْرٍ من الخط مُلْحَقُ",87,"ق",1,0],["وخدٌّ بقَتْلي في المحبة شامتٌ","وعندي دليلٌ في المعاني مصَوَّبُ",88,"ب",1,0],["وَخُدودٍ مِثْل الرّياضِ زَوَاهٍ","مَا لأَيَّامِ حُسْنِهَا مِنْ زَوَالِ",89,"ل",1,0],["وخدمة ربنا في كل حال","بلا عجز هنالك أو ملال",90,"ل",1,0],["وخَدُّكَ بالطَّلاقَةِ كان أبهى","ضياً أم خَدُّها بالجُلّنار",91,"ر",1,0],["وخدمتُهُ ووهبتُه","في كل يومٍ قافَيه",92,"ي",2,0],["وَخَديم دَولتك الأَمين وَإِن نَشا","في مَصر وَهُوَ بِها عَزيز واصل",93,"ل",1,0],["وَخَدُّهُ إِن تبدّى تحتَ عارضِهِ","حسبتَهُ في الدُجى لألاءَ نبراسِ",94,"س",1,0],["وخدٌّ ورده غصنٌّ نضيرٌ","على طول الزمان أبت زواله",95,"ل",2,0],["وخدُّكَ أم ورْدٌ جنتُه يدُ الحَيا","جَنيّاً فأحيى عَرْفُه ميَّت الفِكْر",96,"ر",1,0],["وخدمتي لأُناسٍ","مِنَ النَّصارَى الكِلاب",97,"ب",1,0],["وخداع لم يزل تع","مية للغافلينا",98,"ن",2,0],["وخدودُ الشقيقِ تلطِمُها أي","دي الصَّبا لطمَ ليِّنِ القلبِ قاس"