{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55187","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55505","الكامل"],[92,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[128,"إن الزمان ولا أقول زماني","https://www.aldiwan.net/poem23705.html","الكامل"],[2562,"","https://poetry.dctabudhabi.ae/diwan/poem/141693","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/136006","الرجز"],[4755,"مأساة سُهَيل اليَمَاني ( 5 )","https://www.poetsgate.com/ViewPoem.aspx?id=210758",""],[5147,"أنا شيء وكنه هيكلي المشهود","https://www.poetsgate.com/ViewPoem.aspx?id=166689",""],[5616,"قولي","https://www.poetsgate.com/ViewPoem.aspx?id=203440",""]],"verses":[["وَكِيَاسَةٌ تُهْدِيكَ إِنْ عَزَّ الهُدَى","وَتُرِيكَ وَجْهاً لِلصَّوَابِ جَمِيلا",0,"ل",2,0],["وَكِيَاسَةٍ ذَكَّتْ دَمَ ال","شَّرْقِيِّ مِنْ مُدَدٍ مَدِيدَهْ",1,"د",2,0],["وكيانُ مُلكٍ في حداثةِ عهدِه","يتطلَّبُ التلطيفَ والتدليلا!",2,"ل",2,0],["وكيان مسجد قريتي من ذا الذي","يبقي عليه إذا أزيل كياني",3,"ن",2,0],["وكي أرى الهبة الممدوح واهبها","واسم العظيم العلي المنقوش بالذهب",4,"ب",1,0],["وكي أنالَ منك حُبّاً يُرتضى","يُذهبُ خوفَ ما يجي وما مضى",5,"ض",2,0],["وكَي أُحِسَّ بِأَنَّي صِرتُ أَكبَرَ مِن","صَخرٍ يُقَسَّمُ أَسداسًا وأَثمانا",6,"ن",2,0],["وكياني لما أحاط به العلم","وجاست حدوده الأهواء",7,"ا",2,0],["وكياني من عالم ضمه الغيب","نواحيه كلها لألاء",7,"ا",2,0],["وكي أعود إلى ترتيب قافيتي","وأحذف الحاء والباء الذي ختلا",8,"ل",2,0],["وكي أعود إلى وهمي فأخنقه","فلا أظل بكأس فارغ ثملا!",8,"ل",2,0]]}