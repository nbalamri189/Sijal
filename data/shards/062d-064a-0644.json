{"poems":[[87,"جئننا بالشعور والحداق","https://www.aldiwan.net/poem7534.html","الخفيف"],[51,"قطعت منك حبائل الآمال","https://www.aldiwan.net/poem63049.html","الكامل"],[51,"حيل البلى تأتي على المحتال","https://www.aldiwan.net/poem63053.html","الكامل"],[54,"حيلة الشيب في عذاري تلوح","https://www.aldiwan.net/poem27140.html","الخفيف"],[52,"حذف المنى عنه المشمر في الهدى","https://www.aldiwan.net/poem62272.html","الكامل"],[48,"غض الجفون إذا جلس","https://www.aldiwan.net/poem23269.html","مجزوء الكامل"],[119,"يا مصطفى الرحمن يا أحمد","https://www.aldiwan.net/poem41132.html","عموديه"],[262,"حيلة البرء صنعة لعليل","https://www.aldiwan.net/poem2681.html","الخفيف"],[469,"باحت بنجد وهوى غزلانها","https://www.aldiwan.net/poem3273.html","عموديه"],[567,"لمن الدمع بعد هذا تصون","https://www.aldiwan.net/poem52978.html","الخفيف"],[567,"أجمل الله في فؤادك صبرا","https://www.aldiwan.net/poem52990.html","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48804","الرمل"],[1802,"","https://poetry.dctabudhabi.ae/diwan/poem/116938","السريع"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93708","السريع"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93604","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76147","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204634","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110144","الكامل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131952","الرمل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131078",""],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91046","الكامل"],[5183,"مأساة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=186493",""],[5376,"يا رسولَ اللهِ ما طيرٌ شدا","https://www.poetsgate.com/ViewPoem.aspx?id=193785",""],[5725,"ياعراق","https://www.poetsgate.com/ViewPoem.aspx?id=179277",""],[5956,"كلنا للحب نركعْ","https://www.poetsgate.com/ViewPoem.aspx?id=184835",""],[6056,"ياحيلة الله كيف ؟","https://www.poetsgate.com/ViewPoem.aspx?id=130568",""],[6068,"سحّتْ دموعي لجّها تهيّيجا -17-","https://www.poetsgate.com/ViewPoem.aspx?id=175813",""],[6093,"حِيْلَة الشِّعر ( الرمل )","https://www.poetsgate.com/ViewPoem.aspx?id=180637",""],[6093,"حِيَلُ الطَّرِيقِ","https://www.poetsgate.com/ViewPoem.aspx?id=207120",""]],"verses":[["حيلتي في الهوى وما اتمنى","حيلة الأذكياء في الأرزاق",0,"ق",1,0],["حِيَلُ اِبنِ آدَمَ في الأُمورِ كَثيرَةٌ","وَالمَوتُ يَقطَعُ حِليَةَ المُحتالِ",1,"ل",1,0],["حِيَلُ البَلى تَأتي عَلى المُحتالِ","وَمساكِنُ الدُنيا فَهُنَّ بَوالِ",2,"ل",1,1],["حيلَةُ الشَيبِ في عِذاري تَلوحُ","وَفُؤادي في الغَيِّ بَعدُ جَموحُ",3,"ح",1,1],["حِيَلُ اِبنِ آدَمَ في الحَياةِ كَثيرَةٌ","وَالمَوتُ يَقطَعُ حِيلَةَ المُحتالِ",4,"ل",1,0],["حِيَلٌ تُمَنُّ عَلى الأَنا","مِ فَأَدمُعُ العُقَلاءِ هُمَّل",5,"ل",1,0],["حي لعمر الله في قبره","يسعف بالله وقد ينجد",6,"د",1,0],["حيلَةُ البُرءِ صَنعَةٌ لِعَليلِ","يَتَرَجّى الحَياةَ أَو لِعَليلِه",7,"ه",1,1],["حيل الحيا تلك الربوع وسقى","مهذب الدين فتى فتيانها",8,"ن",3,0],["حيلةٌ أعيتِ الأنامَ فمات ال","شيخُ عجزاً كما يموتُ الجنينُ",9,"ن",1,0],["حيلَةٌ تَركُها سَبيلٌ إِلَيها","وَسقامٌ برَفضنا الطِبَّ يَبرا",10,"ر",2,0],["حِيَلُ القوم وما زا","لت ضروباً وفنونا",11,"ن",2,0],["حيلةُ من ليست له حيلةٌ","حسن عزاء النفس والصبرُ",12,"ر",1,0],["حَيٌّ لَقاحٌ لَم يذلُّوا إِلى","مَلْكٍ وَما اِنقادوا إِلى حاكم",13,"م",1,0],["حي لَها شم قَد تَداعى سُوره","وَالحَي مطمعة بِدُون السُور",14,"ر",1,0],["حي لقاح إِذا ما يَلحقون وغى","حيت وَنادم مَهزوزٌ وَمَسلولُ",15,"ل",1,0],["حيل الثعالب أصبحت مثلا فلم","لم تضربوه بحيلة الانسان",16,"ن",1,0],["حيٌّ لحيّ الذكر حيّ مورخاً","دُم بيتَ اسمعيل فردوسَ عَدَن",17,"ن",1,0],["حي ليث الغاب ربان السفين","قائد الخضراء للنصر المبين",18,"ن",1,1],["حيل الناس توقف النسر في الجو","فيبغي عن المطار عدولا",19,"ل",2,0],["حيل إذا حولت ظاهر أمرها","تلقى بواطنها ربا وقمارا",20,"ر",2,0],["حيّ لبنان مبهجاً مغناه","والليالي ليلاه أو لبناه",21,"ا",2,1],["حيلةُ المرءِ تدانى مكْرُها","وسلاحٌ قد أتانا سُجَّدا",22,"د",2,0],["حيل توجعني وانا الجرحي عتيج","بخيط اركّعها ويتيخ اذيالها",23,"ل",3,0],["حيلة الخالق حب","هو فَخٌّ فيه نقبعْ",24,"ع",1,0],["حيلي تردّى قمت أنا أباري الساس","وأقدام رجلي ثاقلات ٍ خُطاها",25,"ا",3,0],["حيّ لها الهجران قبل تواصل","والعقد والخلخال والدملوجا",26,"ج",2,0],["حِيلْةُ الشِّعرِ قديمٌ سحرها","ورأينا في حديثٍ فِعلَها",27,"ل",3,0],["حِيَلُ الطَّرِيقِ ومكْرُهُ","إيَّاكَ مِنْ حِيَلِ الطريق",28,"ق",1,0]]}