{"poems":[[32,"أصهب يمشي مشية الأمير","https://www.aldiwan.net/poem29581.html","الرجز"],[193,"أموا المدينة حيث جل المغنم","https://www.aldiwan.net/poem35107.html","الكامل"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/44784","الكامل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26183","السريع"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113874","الرجز"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86398","الوافر"],[5219,"شدوا الرحال","https://www.poetsgate.com/ViewPoem.aspx?id=195038",""],[5431,"مرّوا على النفس...","https://www.poetsgate.com/ViewPoem.aspx?id=190591",""],[5431,"لسيدي محمد رسول الله (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=198211",""],[5596,"وادي محرم","https://www.poetsgate.com/ViewPoem.aspx?id=206487",""],[4890,"الهزيمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72560&r=&rc=137",""]],"verses":[["أَصهَبَ يَمشي مِشيَةَ الأَميرِ","لا أَوطَفَ الرَأسِ وَلا مَقرورِ",0,"ر",1,1],["أَصهارهُ أختانه ختنانهُ","كَم ذا له رحمٌ هنالك محرمُ",1,"م",1,0],["إِصهَر بِنارِكَ غُلَّ عُنقِكَ يَنصَهِر","فَعَلى الجَماجِمِ تُركَزُ الأَعلامُ",2,"م",1,0],["أَصَهوَةَ الغَبراءِ أَم داحِسا","رَكِبتَ حَتّى خُضتَ ذاكَ الغِمار",3,"ر",1,0],["أصهارنا تاللَه كيف كنتم","أكرم بكم يا آل بيت الشكر",4,"ر",1,0],["أصهباء تروق لنا مزاجاً","جبينك كان يورثها انبلاجا",5,"ج",2,1],["٢٢-أ صهيونُ صبراً فجرحي عميقٌ","ولكنّ عرضي عصيُّ المنال",6,"ل",1,0],["٢٩-أ صهيونُ مهلاً من اغترّ فيها","فإن الجزاء بجنس الفعال",6,"ل",1,0],["اصهر جراحك في جمر تخزنه","بقوة الحب عل البعض يأتلف",7,"ف",1,0],["اصهَر جراحَكَ في نورٍ يُخَزِّنُهُ","قرآنُ ربكَ ...علّ اليأس ينصرفُ",8,"ف",1,0],["أصهارنا ولهم في القلب منزلة","منذ (الإمام) وتجديداً بزيجات",9,"ت",1,0],["أصْهركِ الآن يا أغاني","غيماً ومرثيّةٌ ودِيمه",10,"م",2,1]]}