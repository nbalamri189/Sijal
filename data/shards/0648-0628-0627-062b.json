{"poems":[[463,"حب إليها بالغضا مرتبعا","https://www.aldiwan.net/poem56125.html","السريع"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87217","الخفيف"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122306","الرجز"],[1467,"","https://poetry.dctabudhabi.ae/diwan/poem/136777",""],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109384","الرمل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65137","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138513",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72472","الكامل"],[4679,"مرحباً بالكرام أهل الحمَّية","https://www.poetsgate.com/ViewPoem.aspx?id=142757",""]],"verses":[["وبأثيلاتِ النقا طلائلاً","يَفرشُها كراكراً وأذرعا",0,"ع",2,0],["وَبأثناء ذَلك الخَطبِ وافى","عَسكر القائد المبيد عِداه",1,"ا",2,0],["وباثنتين منك ان اجزيتني","غبت عن جوائز الاتشاد",2,"د",1,0],["وبإثر الومض عن شغفٍ","وبل دمعي بالهوى همعا",3,"ع",2,0],["وبأثناء المواعيد التي","أخذُها كان قديماً وجديدا",4,"د",2,0],["وبإثره يأتي البناءُ مُؤسّسا","لدوام ملككمُ دواما مُحكما",5,"م",2,0],["وبآثار قد أبداها","فشت الخيرات وفاز البر",6,"ر",1,0],["وبأثر ما كنت الملحَّ عشية","أصبحت لا أملا ولا أمنية",7,"ه",1,0],["وبآثارهم ترنم وفاخرّ","لا بآثار أعصر الجاهليَّة",8,"ي",2,0]]}