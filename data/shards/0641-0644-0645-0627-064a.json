{"poems":[[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112525","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91482","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114310","الرمل"]],"verses":[["فلما يوافوا يناديهم ارجعوا","وسيروا لموسى البر فهو المكلم",0,"م",1,0],["فلم أيأس وقد أذكيت جمري","بآمال أشم من الجبال",1,"ل",1,0],["فلما يسوق القَومُ فيَّ كلامَهم","وَاللَه يَعلمُ أنَّ ذَلِكَ ما جَرى",2,"ر",2,0],["فَلِمَا يَعْنَيك فَاعْمَدْ تَارِكاً","قَالَ أوْ قِيلَ إِذَا شِئْتَ تُجَلْ",3,"ل",1,0]]}