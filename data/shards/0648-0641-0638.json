{"poems":[[83,"وفظ غليظ القلب لا ود عنده","https://www.aldiwan.net/poem61344.html","الطويل"],[422,"وفظ غليظ القلب أيقنت أنه","https://www.aldiwan.net/poem54019.html","الطويل"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127401","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125837","الرمل"],[4485,"","https://poetry.dctabudhabi.ae/diwan/poem/132211","الخفيف"],[5409,"أيار شهرك بالكوارث مفعم","https://www.poetsgate.com/ViewPoem.aspx?id=155316",""]],"verses":[["وفَظّ غَليظِ القلبِ لاَ وِدَّ عندَهُ","وَلَيسَ لَدَيهِ للأخِلاَّء تأنيسُ",0,"س",1,1],["وفظٍّ غليظِ القلبِ أيْقَنْتُ أنَّه","على النَّفس ما شيءٌ أشدَّ من الغَضِّ",1,"ض",1,1],["وفظائع الطليان فيها","قصد إفناء العرب",2,"ب",1,0],["وفظاعاتٌ يغطِّيهُن","تعبير رقيق",3,"ق",1,0],["وفظيع وعنظب وظلام","والظبى والحظا معا والغلاظ",4,"ظ",1,0],["وفظايع الأيام تبقى مثلما","تبقى السمات وإن تعفّى الميسم",5,"م",1,0]]}