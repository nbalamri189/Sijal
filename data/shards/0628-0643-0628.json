{"poems":[[87,"ولد الهدى فالكائنات ضياء","https://www.aldiwan.net/poem20977.html","الكامل"],[92,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[201,"بك بالشوق بالضنى يا جاره","https://www.aldiwan.net/poem39943.html","الخفيف"],[287,"من علا الصاحب الطويل الركاب","https://www.aldiwan.net/poem32864.html","الخفيف"],[382,"ذلت لعزة دينك الأديان","https://www.aldiwan.net/poem59237.html","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87038","الخفيف"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64586","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79843","الخفيف"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137090",""],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84897","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130790",""],[3205,"","https://poetry.dctabudhabi.ae/diwan/poem/76543","المديد"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62896","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85149","المديد"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105513","الكامل"],[4816,"حورية","https://www.poetsgate.com/ViewPoem.aspx?id=8480",""],[5518,"في مدح الرسول","https://www.poetsgate.com/ViewPoem.aspx?id=201599",""],[5563,"مدعوجة العينين ( نبطية )","https://www.poetsgate.com/ViewPoem.aspx?id=212820",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[6367,"أين الطريق إليك ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80597&r=&rc=0",""]],"verses":[["بِكَ بَشَّرَ اللَهُ السَماءَ فَزُيِّنَت","وَتَضَوَّعَت مِسكاً بِكَ الغَبراءُ",0,"ا",2,0],["بك بعد مُحتَدِمِ النضالِ سينجَلي","مما ابتدأتَ من النِضالِ ختام",1,"م",1,0],["بكِ بالشوقِ بالضنى يا جاره","اسعِفيني بالكأسِ والسيجارَه",2,"ر",2,1],["بِكَ بابُ البَريدِ يَجلو عَلى العا","لم بابَ الفِردَوسِ في الأَبوابِ",3,"ب",1,0],["بكَ بيعت الدنيا بأبخس درهمٍ","فانٍ فليسَ لبيعها أثمان",4,"ن",1,0],["بِكَ بَينَ الوَرى غَدَوت إِماماً","يا مَليكاً حَوى بَديع الجَمال",5,"ل",1,0],["بكبر لا إله إلا اللّه","وكبر أسمائك عجل المدد",6,"د",1,0],["بك باهى مقامُ جدّك إبرا","هيمَ لمَّا أن أقمت فيه مُنيبا",7,"ب",2,0],["بك بيعة الروم السعيد تزدهي","اذ كنت حارس مجدها المضمون",8,"ن",1,0],["بِكَ بَدر العُلوم أَضحَت تَهني","بِعُلاها وَأَنتَ فيها وَكيل",9,"ل",1,0],["بكبار المدرعات احاطت","كل غواصةٍ تلى طُربيلا",10,"ل",2,0],["بِكَ بَدءُ المَعلُواتِ فَدُم","تَبدَأُ العَليا وَتَختِمُها",11,"م",3,0],["بكَ بعد ما رجفت قواعدُ عزِّها","ثَبَتَتْ وقامتْ بالخلافةِ سَاقُ",12,"ق",1,0],["بك بدر السعد حاضرنا","بك غاب الهم والكدر",13,"ر",1,0],["بك برء أسقامي وأنت سقامي","يا مخجل الأقمار والآرام",14,"م",1,1],["بكبرك ينسرق عمري واشيخ وتبقي المودود","عساي في ثراك ادفن يا اغلى ا م وداده",15,"د",2,0],["بك بشّرَ الله السماءَ فكبّرتْ","وتزينتْ كي تلتقي بشراكا",16,"ك",2,0],["بك بلغت العشق فوق اللي طلبتي","وا لمحبة دار واحساسك عمدها",17,"د",3,0],["بكبرياء الملك الحق المبين","بعز سلطان الألوهة المتين",18,"ن",1,0],["\"بك بشر الله السماء فزينت\"","والأرض تخطر في ضحى بشراكا",19,"ك",2,0]]}