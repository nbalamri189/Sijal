و قيسا","https://www.poetsgate.com/ViewPoem.aspx?id=207367",""],[4778,"الأقدار","https://www.poetsgate.com/ViewPoem.aspx?id=200396",""],[4828,"سيرةُ ضوء","https://www.poetsgate.com/ViewPoem.aspx?id=193407",""],[4984,"عاد رفاق الأمس","https://www.poetsgate.com/ViewPoem.aspx?id=190247",""],[4984,"أَيُعْقَلُ أَنْ أَنْسَى","https://www.poetsgate.com/ViewPoem.aspx?id=201808",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5431,"وعرّشت في الأعماق نبعا وماجفّا","https://www.poetsgate.com/ViewPoem.aspx?id=198714",""],[5431,"غمامٌ حاتميٌ ...","https://www.poetsgate.com/ViewPoem.aspx?id=214181",""],[5442,"رأى الركائب تحدى فإنني كلفا","https://www.poetsgate.com/ViewPoem.aspx?id=114755",""],[5459,"باريس","https://www.poetsgate.com/ViewPoem.aspx?id=205977",""],[469,"أعاذلتي كُفّي ثكلتِ عن العذلِ","https://www.poetsgate.com/ViewPoem.aspx?id=76855",""],[5830,"أَسَاحِرَةَ العُيُونِ","https://www.poetsgate.com/ViewPoem.aspx?id=201193",""],[5894,"كل الحواسد راعوا ما أنا فيه","https://www.poetsgate.com/ViewPoem.aspx?id=131407",""],[5897,"صبراً .. دمّاج","https://www.poetsgate.com/ViewPoem.aspx?id=156532",""],[5956,"بديل الغيد","https://www.poetsgate.com/ViewPoem.aspx?id=183217",""],[6072,"القلبُ إذا تَلَكَّأ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84903&r=&rc=3",""],[463,"طرفُ نجديّة ُ وطرفُ عراقيُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60153&r=&rc=209",""],[6318,"حب ووفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66154&r=&rc=4",""],[5536,"سيف دولتنا عليا !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76355&r=&rc=33",""]],"verses":[["وَما أَعلَمنا أَنّا","إِلى الغايَةِ أَجرَينا",0,"ن",2,0],["وَما أَعذَرتُ حَتّى كانَ نَعلي","دَماً وَوِسادَتي وَجهَ التُرابِ",1,"ب",1,0],["وَما اعتَرَضَت هُمومُ النَفسِ إِلّا","وَمِن ذِكراكِ رَيحاني وَراحي",2,"ح",2,0],["وَما أَعطَتِ السَبعونَ قَبلُ أُولي الحِجى","مِنَ الإِربِ ما أَعطَتكَ عَشروكَ وَالعُشرُ",3,"ر",1,0],["وَمَا اعْتِدَالُ زَمَانٍ لا يُقَوِّمُهُ","بَنُوهُ بِالصَّبْرِ وَالإِقْدَامِ تَقْوِيمَا",4,"م",2,0],["وَمَا أعنِي بِقَولِي أَسفَليكُم","وَلَكِنِّي أُرِيدُ بِهِ الذَّوينَا",5,"ن",2,0],["وَما اِعتَرَضتُ عَلَيهِ في أَوامِرِهِ","لَكِن سَأَلتُ وَمِن عاداتِهِ نَعَمُ",6,"م",1,0],["وما اعتقلتني رغبةٌ عنك يَمَّمت","سواك ولكن أيُّ رهبة راهبِ",7,"ب",1,0],["وما اعْتَفَيْتُكُمُ إلا بِتَجْربَةٍ","إذا اعتفى القومَ عافيهِمْ بتقليدِ",8,"د",1,0],["وما اعتبادكُمُ حرّاً بمعتمدٍ","أنّى ونياتُكم نيات أخيار",9,"ر",1,0],["وما أعجلتْه الحربُ إبرامَ أمرهِ","إذا أعجل المنخوبَ جولُ الجوائلِ",10,"ل",1,0],["وما أعطيتَ إلا ارتاشَ حرٌّ","وأطرق والحياءُ له كِعامُ",11,"م",1,0],["وَما أَعلَمُ قَبلَ الآ","نَ أَنَّ الطَودَ ناقَ لي",12,"ل",2,0],["وَما اِعتِراضُ الحَظِّ دونَ المُنى","مِن هَفوَةِ المُحسِنِ أَو ذَنبِهِ",13,"ب",2,0],["وما أعَدَّ الله في جنة ال","مأوى لنا فهو الثواب الكبير",14,"ر",1,0],["وما أعرض الأطماع إِلّا رأيتَني","لهنَّ شجىً بين اللَّهى والحلاقمِ",15,"م",1,0],["وَما أُعطى القَرارَ وَقَد تَناءَت","وَهَذا الحُبُّ يَمنَعُني قَراري",16,"ر",2,0],["وَما أَعرِفُ الأَطلالَ مِن بَطنِ توضِحٍ","لِطولِ تَعَفّيها وَلَكِن إِخالُها",17,"ل",3,0],["وَما أَعرِفُ الأَطلالَ في جَنبِ توضِحٍ","لِطولِ تَعَفّيها وَلَكِن إِخالُها",18,"ل",3,0],["وَما أَعتَدُّ مِن عُمري بِيَومٍ","يَمُرُّ وَلا أَراكَ وَلا تَراني",19,"ن",2,0],["وَما أُعيدَ لَهُم حَتّى أَتَيتَهُمُ","أَزمانَ مَروانَ إِذ في وَحشِها غِرَرُ",20,"ر",1,0],["وَما أَعجَبَ الآجالَ في خُدَعاتِها","وَما أَعجَبَ الأَرزاقَ كَيفَ تَسَبَّبَت",21,"ت",1,0],["وَما اِعتَزَّ هَيّابُ البِلادِ بِحِليَةٍ","وَلَو أَنَّ سَمطَيها جُمانٌ وَعَسجَدُ",22,"د",1,0],["وَما اِعتَنَقَ العَليا سِوى مُفرَدٍ سَرى","لِهَولِ الفَلا وَالشَوقِ وَالسَوقِ رابِعاً",23,"ع",2,0],["وَما أَعجَبَتني لِاِبنِ آدَمَ شيمَةٌ","عَلى كُلِّ حالٍ مِن مَسودٍ وَسائِدِ",24,"د",1,0],["وَما أَعفَتِ الأَيّامُ بَدواً مِنَ الرَدى","وَلا حَضَراً فَاِسأَل بَداً عَنهُ وَالحَضرا",25,"ر",2,0],["وَما اِعتِرافي بِعَيبِ الجِنسِ مَنقَصَةً","وَالعَينُ يُعرَفُ في آنافِها الذَلَفُ",26,"ف",1,0],["وَما أَعودُ إِلى الدُنيا وَقَد زَعَموا","أَنَّ الزَمانَ بِمِثلي سَوفَ يَحكيني",27,"ن",2,0],["وما أُعْجِلْتُ عن زَرَدٍ حِذاراً","ولكِنّ المُفاضَةَ أَثْقَلَتْني",28,"ن",2,0],["وَمَا أَعَزَّ الْفَتَى تَنْمِيهَ هَمَّتُهُ","هَذَا إلى أَنَّهُ يَنْمِيه خَيْرُ أَبِ",29,"ب",1,0],["وما أعجبَ المعروفَ تستر فِعله","ولستَ تراه الدهرَ غير شهير",30,"ر",1,0],["وما أعلن المرء عن نفسه","بمثل الأناة، ومثل الدأَب",31,"ب",1,0],["وما أعربت خرس الأراك بلحنها","عن الحب إلا كي يقال فصاح",32,"ح",1,0],["وَمَا أُعِيدَ لَهُمْ حَتى أتَيْتَهُمُ،","أزْمانَ مَرْوَانَ إذْ في وَحْشِا غِرَرُ",33,"ر",1,0],["وَما أَعرِفُ الفَقرَ حَتّى أَقولَ","عَلى أَنَّني رَبُّ بَيتِ الفِقَر",34,"ر",1,0],["وَما أَعطى الصَبابَةَ ما اِستَحَقَّت","عَلَيهِ وَلا قَضى حَقَّ المَنازِل",35,"ل",1,0],["وَما أَعظُمُ وَضّاحٍ","يُنادى وَالدُجى يَغسِق",36,"ق",1,0],["وَما أَعجَبَتني دارُ ذُلٍّ وَإِن غَدَت","مَنازِلَ قَومي وَالأَكارِمِ مِن أَهلي",37,"ل",2,0],["وما اعتلى الميتُ من عزةٍ","أعناقَ من يرمونهُ في التُّرابْ",38,"ب",1,0],["وما أعل فالمثال أن يرد","أعلاله بفائه كفا وجد",39,"د",1,0],["وما اعتلَّتْ به الألحا","ظُ فِي أجفانها النُّجُلِ",40,"ل",1,0],["وَما أَعذَبَ قَولُ النا","سِ قَد تَيَّمَهُ الحُبُّ",41,"ب",1,0],["وما اعتاض فيها من مسيء ومحسن","سوى ذم شاك أو محامد شاكر",42,"ر",1,0],["وَما اعْتَرَفَتْ أَنْفُسٌ بِالْحِما","مِ لَوْ كانَ يَقْبَلُ إِنْكارَها",43,"ر",3,0],["وما اعتاد فيه المرء خصته نفسه","فلا تقرب الا غير ما شان في الشان",44,"ن",1,0],["وَما أَعرَضَت عَنّي وَحَقِّ وِصالِها","لِغَيرِ اِحتِرامي في الهَوى وَخَطيئَتي",45,"ي",1,0],["وَما اِعتزّ ذو تاجٍ بِملك وَسَطوة","عَلى قُدرةٍ إِلّا لَهُ اللَه أَخضَعا",46,"ع",2,0],["وما أَعمارُنا إلاّ شُموسٌ","وهل للشّمْسِ بُدٌّ من زَوال",47,"ل",1,0],["وما اعتَمَد الأقوامُ حَربَكَ غِرّةً","ولكنّهمْ غُرّوا بحِلْمِكَ فاغْتَرّوا",48,"ر",3,0],["وما أعبَقَ الوردَ الرّبيعُ وإنّما","بَنانُك أهدَى عَرْفُ عُرْفِك للوَرد",49,"د",1,0],["وما اعترف الحُسّادُ حُبّاً بفَضْلِه","ولكنّهم لا يَستطيعون جَحْده",50,"د",2,0],["وَما أَعني سِواكَ أَبا عَليِّ","فَكُن حَيثُ اشتُهيتَ تَكُن مُرادا",51,"د",2,0],["وما اعترف الجحود بها وفاقاً","ولكنْ لا سبيل إلى الجحود",52,"د",1,0],["وما اعتادني منها سوى فرط لوعة","تصبّب دمعي بالزفير المصعّد",53,"د",1,0],["وما أعلم الحسَّادَ للشمس أنهم","فناءٌ على الأيّام وهي دوامُ",54,"م",1,0],["وما أعزَّ الفتى في ظلِّ عفّتِهِ","لو شُووِرَ الحزمُ أو لو صحَّت الفِكَرُ",55,"ر",1,0],["وما أعرفُ الممدوحَ لم يَجزِني به","إذا قلتُ خيراً إنَّ ذلك بالضدِّ",56,"د",1,0],["وما أعْجَب حِرْماني","وأنتُمْ للنَّدى أصْلُ",57,"ل",1,0],["وما اعْترفَ الحُرُّ الفصيح لمحْسنٍ","فجازاهُ حمداً خالداً في العَواقِب",58,"ب",1,0],["وما أعجبَ المرء في حالي تقلبه","حين الرضا عن لياليه وفي الإحن",59,"ن",1,0],["وما اعتراه من خلل","ما للهلال الأحمر",60,"ر",1,0],["وَما أُعابُ بِشَيءٍ بَعدَ فُرقَتِكُم","إِلّا البَقاءَ فَإِنّي مِنهُ أَعتَذِرُ",61,"ر",1,0],["وما اعتمادي على علمي ولا عملي","أنت الكريم وقد وجهت يا أملي",62,"ي",1,0],["وما اعتراهم على الأطلال بعض أسى","إذ قوضتها الأعادي بالقنا السلب",63,"ب",1,0],["وما أعانيه من وجدي بفاطمةٍ","أجلُّ خودٍ إليها الحسن يَنْتَسبُ",64,"ب",1,0],["وما اعتدت أن ألقى من الدهر رحمة","وإن ذهبت نفسي أسىً وأنينا",65,"ن",2,0],["وما اعتبروا بما آلوا إليه","وهل تدري فتعتبر الصخور",66,"ر",1,0],["وما أعطاك إلا ما استحقت","صفاتك إنها أعلى الصفات",67,"ت",1,0],["وَما اِعتَوَرَت فُرسانُ قَحطان قَبلَهُ","عَلى أَحَدٍ في السِرِّ وَالجَهَراتِ",68,"ت",1,0],["وما أعذب الغدران والطير حُوَّمٌ","تردد ألحان الخلود البواقيا",69,"ي",2,0],["وما اعتضتم منهم غداة نقلتم","بكره إلى جدب البلاد من الخصب",70,"ب",1,0],["وما أَعَرْنا النَّاصِحينَ لَحْظَا","نَخْبُثُ مَعْنىً ونَطِيبُ لَفْظَا",71,"ظ",2,0],["وما اعتراها من زحاف أو علل","على جواز أو لزوم في العمل",72,"ل",1,0],["وما أعجبتني قَطّ دعوى عريضةٌ","ولو قام في تصديقِها الفُ شاهدِ",73,"د",1,0],["وما أعرضت هجراً ولكن مخافة","إذا جد وجدٌ أن ينم عذول",74,"ل",1,0],["وما اعتقلوا وراءك من سلاح","ولكن ذلك الحق الصراح",75,"ح",1,0],["وما اعتنق الحنيف بغير رأي","ولم يسلك محجته اقتحاما",76,"م",2,0],["وَما اِعتَمَدنا عَلى قَودٍ تُقَرِّبُنا","مِنهُ وَلَكِن عَلى النِيّاتِ نَعتَمِدُ",77,"د",1,0],["وما اعتذاري وقد أصبحت جاركم","إن لم يطل في رسوم الدار تردادي",78,"ي",1,1],["وما أعشق الأقمارَ الاَّ لاجلِكم","ولا أذكرُ الأغصانَ الاّ تَعَلُّلاَ",79,"ل",2,0],["وَما أَعداك هذا الجيل بُخلاً","كَأَنَّك بَينَ أظَهرهم غَريب",80,"ب",1,0],["وَما أَعددت لِلأَعداء إِلّا","سُيوف الهند وَالأَسل الحِرابا",81,"ب",2,0],["وما أعانيه من وجد ومن كمد","ولوعة وصبابات وإيراق",82,"ق",1,0],["وَما أَعمَلَت يَوماً إِلى شُغُلٍ يَداً","سِوى قَلمٍ تَثنى عَلَيهِ الأَصابِعُ",83,"ع",1,0],["وما اعتاص المَرام عليّ إِلا","وجدت التَرْك يُرْخِص كلَّ غال",84,"ل",1,0],["وما أعظم الانسان في قرب ربه","وذلك إن صلى من القلب إن صلى",85,"ل",2,0],["وما أعربد في الدنيا على أحد","إذا سكرت بها إلا على مالي",86,"ي",1,0],["وما اعتقَلت كريّما","إلّا وأنت مثَقّف",87,"ف",1,0],["وما اعتقلوا يوماً قناة ولهذما","ولا حملوا يوماً إلى الحرب مخذ",88,"ذ",1,0],["وما اعتاضُ بالأَقوامِ منكم","وهل يعتاضُ صَدرِى من فُؤادِي",89,"د",2,0],["وما اعتاضَ مدحٌ أنتَ ربّ كلامِهِ","نَداكَ مُسَدِّيةِ ومجدُكَ حائِكُ",90,"ك",1,0],["وما اعْتزّ دينُ اللهِ إلا لأنه","يُدافِعُ أحْزابَ العِدَى ويُكافِحُ",91,"ح",1,0],["وما اعتاضَ من مَعنى الغَوايةِ بانَ لي","وقد كانَ عني قبلَ معناهُ أَعوَصا",92,"ص",2,0],["وَما اعتقدت وَلَكن","أَخذت رَأي الخَيال",93,"ل",1,0],["وما اعتدادُك بالأيام تحسبها","وإنما أنت خدن الويل والألم",94,"م",1,0],["وما اعتَجرت بالليلِ إلاّ مخافةً","لمرتَقِبٍ يذكي العُيون الروامِقا",95,"ق",2,0],["وَما اِعتَرَف المَجدُ إِلا لَكُم","فَلَيسَ إِلى غَيرِكُم ينسبُ",96,"ب",1,0],["وَمَا اعتَرَى الأطفَالَ مِن آلاَمِ","يَقضِى لأهلِ السُّنَّةِ الأعلاَمِ",97,"م",1,0],["وما اعتراضي على ربي ليقضي لي","ما لا يشاء ولي في العقل مزدَجَر",98,"ر",1,0],["وما أعصيكمُ أمراً ونهياً","ولكن لست أدري أين أنتم",99,"م",1,0],["وما اعتقلوا إلا الرديني عاملا","ولا اشتملوا الا الحسام مهندا",100,"د",2,0],["وَما أَعلاهُ من فتحٍ","به مجدٌ لأَمجادِ",101,"د",1,0],["وَما أَعجَبُ مِن فِعلي","وَما أَعظَمُ مِن ذَنبي",102,"ب",2,0],["وما اعتل يا مولاي جسمك وحده","ولكن قلوبٌ جمة وجسومُ",103,"م",1,0],["وما أعلنتُ حتّى زا_","دني المحبوب تهويسا",104,"س",2,0],["وما اعتراضك للأقدار يمنعها","ولا امتثالك معنيٌ به القدر",105