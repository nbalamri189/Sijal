{"poems":[[53,"أما كنت مع الحي","https://www.aldiwan.net/poem29741.html","الهزج"],[86,"رميت بها على هذا التباب","https://www.aldiwan.net/poem10505.html","الوافر"],[73,"إليك من الأنام غدا ارتياحي","https://www.aldiwan.net/poem11860.html","الوافر"],[73,"هو الدهر فاصبر للذي أحدث الدهر","https://www.aldiwan.net/poem11936.html","الطويل"],[93,"أبيت والسيف يعلو الرأس تسليماً","https://www.aldiwan.net/poem11419.html","البسيط"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[47,"أشدة ما أراه منك أم كرم","https://www.aldiwan.net/poem25155.html","البسيط"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"يا ابن الوزيرين وابن السادة الصيد","https://www.aldiwan.net/poem10866.html","البسيط"],[51,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[51,"ألا نسيا نفسي حديث البلابلِ","https://www.aldiwan.net/poem65958.html","الطويل"],[51,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[91,"تسير بنا على عجل","https://www.aldiwan.net/poem62631.html","عموديه"],[85,"إثن عنان القلب واسلم به","https://www.aldiwan.net/poem63782.html","السريع"],[62,"إحراقنا البالغ في أول التكليس","https://www.aldiwan.net/poem52226.html","السريع"],[62,"لقد هاجني والصبح طلق المباسم","https://www.aldiwan.net/poem52267.html","الطويل"],[45,"حذرت الحب لو أغنى حذاري","https://www.aldiwan.net/poem63588.html","الوافر"],[45,"قف العيس قد أدنى خطاها كلالها","https://www.aldiwan.net/poem65539.html","الطويل"],[45,"وقوفك في أطلالهم وسؤالها","https://www.aldiwan.net/poem65564.html","الكامل"],[45,"سلام أيها الملك اليماني","https://www.aldiwan.net/poem66805.html","الوافر"],[28,"فأعقب الله ظلا فوقه ورق","https://www.aldiwan.net/poem5054.html","البسيط"],[49,"أيا عجب الدنيا لعين تعجبت","https://www.aldiwan.net/poem10847.html","الطويل"],[105,"حماة الوغى أين السلام الموطد","https://www.aldiwan.net/poem43104.html","الطويل"],[81,"تنازعني الآمال كهلا ويافعا","https://www.aldiwan.net/poem61463.html","البسيط"],[46,"حوائج نفسي كالغواني قصائر","https://www.aldiwan.net/poem22443.html","الطويل"],[46,"أرى الأرض فيها دولة مضرية","https://www.aldiwan.net/poem22600.html","الطويل"],[46,"شكوت من أهل هذا العصر غدرهم","https://www.aldiwan.net/poem22983.html","البسيط"],[46,"هل تثبتن لذي شام وذي يمن","https://www.aldiwan.net/poem23524.html","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16678","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54572","البسيط"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23638","الطويل"],[106,"تحيْة الرسالة","https://www.poetsgate.com/ViewPoem.aspx?id=179503",""],[90,"ماهذه النفوس قداح","https://www.poetsgate.com/ViewPoem.aspx?id=178947",""],[28,"زارت سكينة أطلاحا أناخ بهم","https://www.poetsgate.com/ViewPoem.aspx?id=21584",""],[144,"سبقت ففز بعظيم الخطر","https://www.aldiwan.net/poem11757.html","المتقارب"],[144,"أما وهوى عصيت له العواذل","https://www.aldiwan.net/poem11798.html","الوافر"],[165,"ديار الحي بالرس","https://www.aldiwan.net/poem67584.html","الهزج"],[170,"إليكن عني فانصرفن على مهل","https://www.aldiwan.net/poem1643.html",""],[200,"لا تغترر بالناس فيما ترى","https://www.aldiwan.net/poem45398.html","السريع"],[223,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[230,"شغلت بخلسة المقل","https://www.aldiwan.net/poem50846.html","مجزوء الوافر"],[233,"فؤادي والهوى نهب","https://www.aldiwan.net/poem14786.html","الهزج"],[262,"بلوت الليالي وابتليت بصرفها","https://www.aldiwan.net/poem38273.html","الطويل"],[281,"لقد جاوزت فيك مقدارها","https://www.aldiwan.net/poem60757.html","المتقارب"],[305,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[350,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[354,"أعد ذكر ربع البان سفحا وأجرعا","https://www.aldiwan.net/poem40148.html","الطويل"],[365,"جوانح واجد وجفون سال","https://www.aldiwan.net/poem60683.html","الوافر"],[365,"نصرت على الأعداء فليهنك النصر","https://www.aldiwan.net/poem60900.html","الطويل"],[365,"أضم على قلبي يدي من الوجد","https://www.aldiwan.net/poem60941.html","الطويل"],[365,"ألا ليت قلبي يوم أعلن وجده","https://www.aldiwan.net/poem60955.html","الطويل"],[407,"أرى دهري تفضل واستفادا","https://www.aldiwan.net/poem50182.html","الوافر"],[417,"ليالينا على الجرعاء عودي","https://www.aldiwan.net/poem54070.html","الوافر"],[438,"سقاه الصبا خمر الدلال المردد","https://www.aldiwan.net/poem2561.html","الطويل"],[459,"عجبت لمر النفس كيف يضام","https://www.aldiwan.net/poem55871.html","الطويل"],[459,"هل عند ريح الصبا من رامة خبر","https://www.aldiwan.net/poem56197.html","البسيط"],[459,"أقامت على قلبي كفيلا من العهد","https://www.aldiwan.net/poem56244.html","الطويل"],[462,"زمان كله هجر","https://www.aldiwan.net/poem16093.html","الهزج"],[462,"بقيت مطاعا ما تغنت حمامة","https://www.aldiwan.net/poem16342.html","الطويل"],[465,"كيف السكون من الدنيا إلى سكن","https://www.aldiwan.net/poem3393.html","عموديه"],[480,"وحق سيف أنور","https://www.aldiwan.net/poem37204.html","مجزوء الرجز"],[494,"لمن أسائل لا رسم ولا أثر","https://www.aldiwan.net/poem67374.html","البسيط"],[559,"قلوبنا بك أبلتها النوى كمدا","https://www.aldiwan.net/poem34643.html","البسيط"]],"verses":[["وَما أَعلَمنا أَنّا","إِلى الغايَةِ أَجرَينا",0,"ن",2,0],["وَما أَعذَرتُ حَتّى كانَ نَعلي","دَماً وَوِسادَتي وَجهَ التُرابِ",1,"ب",1,0],["وَما اعتَرَضَت هُمومُ النَفسِ إِلّا","وَمِن ذِكراكِ رَيحاني وَراحي",2,"ح",2,0],["وَما أَعطَتِ السَبعونَ قَبلُ أُولي الحِجى","مِنَ الإِربِ ما أَعطَتكَ عَشروكَ وَالعُشرُ",3,"ر",1,0],["وَمَا اعْتِدَالُ زَمَانٍ لا يُقَوِّمُهُ","بَنُوهُ بِالصَّبْرِ وَالإِقْدَامِ تَقْوِيمَا",4,"م",2,0],["وَمَا أعنِي بِقَولِي أَسفَليكُم","وَلَكِنِّي أُرِيدُ بِهِ الذَّوينَا",5,"ن",2,0],["وَما اِعتَرَضتُ عَلَيهِ في أَوامِرِهِ","لَكِن سَأَلتُ وَمِن عاداتِهِ نَعَمُ",6,"م",1,0],["وما اعتقلتني رغبةٌ عنك يَمَّمت","سواك ولكن أيُّ رهبة راهبِ",7,"ب",1,0],["وما اعْتَفَيْتُكُمُ إلا بِتَجْربَةٍ","إذا اعتفى القومَ عافيهِمْ بتقليدِ",8,"د",1,0],["وما اعتبادكُمُ حرّاً بمعتمدٍ","أنّى ونياتُكم نيات أخيار",9,"ر",1,0],["وما أعجلتْه الحربُ إبرامَ أمرهِ","إذا أعجل المنخوبَ جولُ الجوائلِ",10,"ل",1,0],["وما أعطيتَ إلا ارتاشَ حرٌّ","وأطرق والحياءُ له كِعامُ",11,"م",1,0],["وَما أَعلَمُ قَبلَ الآ","نَ أَنَّ الطَودَ ناقَ لي",12,"ل",2,0],["وَما اِعتِراضُ الحَظِّ دونَ المُنى","مِن هَفوَةِ المُحسِنِ أَو ذَنبِهِ",13,"ب",2,0],["وما أعَدَّ الله في جنة ال","مأوى لنا فهو الثواب الكبير",14,"ر",1,0],["وما أعرض الأطماع إِلّا رأيتَني","لهنَّ شجىً بين اللَّهى والحلاقمِ",15,"م",1,0],["وَما أُعطى القَرارَ وَقَد تَناءَت","وَهَذا الحُبُّ يَمنَعُني قَراري",16,"ر",2,0],["وَما أَعرِفُ الأَطلالَ مِن بَطنِ توضِحٍ","لِطولِ تَعَفّيها وَلَكِن إِخالُها",17,"ل",3,0],["وَما أَعرِفُ الأَطلالَ في جَنبِ توضِحٍ","لِطولِ تَعَفّيها وَلَكِن إِخالُها",18,"ل",3,0],["وَما أَعتَدُّ مِن عُمري بِيَومٍ","يَمُرُّ وَلا أَراكَ وَلا تَراني",19,"ن",2,0],["وَما أُعيدَ لَهُم حَتّى أَتَيتَهُمُ","أَزمانَ مَروانَ إِذ في وَحشِها غِرَرُ",20,"ر",1,0],["وَما أَعجَبَ الآجالَ في خُدَعاتِها","وَما أَعجَبَ الأَرزاقَ كَيفَ تَسَبَّبَت",21,"ت",1,0],["وَما اِعتَزَّ هَيّابُ البِلادِ بِحِليَةٍ","وَلَو أَنَّ سَمطَيها جُمانٌ وَعَسجَدُ",22,"د",1,0],["وَما اِعتَنَقَ العَليا سِوى مُفرَدٍ سَرى","لِهَولِ الفَلا وَالشَوقِ وَالسَوقِ رابِعاً",23,"ع",2,0],["وَما أَعجَبَتني لِاِبنِ آدَمَ شيمَةٌ","عَلى كُلِّ حالٍ مِن مَسودٍ وَسائِدِ",24,"د",1,0],["وَما أَعفَتِ الأَيّامُ بَدواً مِنَ الرَدى","وَلا حَضَراً فَاِسأَل بَداً عَنهُ وَالحَضرا",25,"ر",2,0],["وَما اِعتِرافي بِعَيبِ الجِنسِ مَنقَصَةً","وَالعَينُ يُعرَفُ في آنافِها الذَلَفُ",26,"ف",1,0],["وَما أَعودُ إِلى الدُنيا وَقَد زَعَموا","أَنَّ الزَمانَ بِمِثلي سَوفَ يَحكيني",27,"ن",2,0],["وما أُعْجِلْتُ عن زَرَدٍ حِذاراً","ولكِنّ المُفاضَةَ أَثْقَلَتْني",28,"ن",2,0],["وَمَا أَعَزَّ الْفَتَى تَنْمِيهَ هَمَّتُهُ","هَذَا إلى أَنَّهُ يَنْمِيه خَيْرُ أَبِ",29,"ب",1,0],["وما أعجبَ المعروفَ تستر فِعله","ولستَ تراه الدهرَ غير شهير",30,"ر",1,0],["وما أعلن المرء عن نفسه","بمثل الأناة، ومثل الدأَب",31,"ب",1,0],["وما أعربت خرس الأراك بلحنها","عن الحب إلا كي يقال فصاح",32,"ح",1,0],["وَمَا أُعِيدَ لَهُمْ حَتى أتَيْتَهُمُ،","أزْمانَ مَرْوَانَ إذْ في وَحْشِا غِرَرُ",33,"ر",1,0],["وَما أَعرِفُ الفَقرَ حَتّى أَقولَ","عَلى أَنَّني رَبُّ بَيتِ الفِقَر",34,"ر",1,0],["وَما أَعطى الصَبابَةَ ما اِستَحَقَّت","عَلَيهِ وَلا قَضى حَقَّ المَنازِل",35,"ل",1,0],["وَما أَعظُمُ وَضّاحٍ","يُنادى وَالدُجى يَغسِق",36,"ق",1,0],["وَما أَعجَبَتني دارُ ذُلٍّ وَإِن غَدَت","مَنازِلَ قَومي وَالأَكارِمِ مِن أَهلي",37,"ل",2,0],["وما اعتلى الميتُ من عزةٍ","أعناقَ من يرمونهُ في التُّرابْ",38,"ب",1,0],["وما أعل فالمثال أن يرد","أعلاله بفائه كفا وجد",39,"د",1,0],["وما اعتلَّتْ به الألحا","ظُ فِي أجفانها النُّجُلِ",40,"ل",1,0],["وَما أَعذَبَ قَولُ النا","سِ قَد تَيَّمَهُ الحُبُّ",41,"ب",1,0],["وما اعتاض فيها من مسيء ومحسن","سوى ذم شاك أو محامد شاكر",42,"ر",1,0],["وَما اعْتَرَفَتْ أَنْفُسٌ بِالْحِما","مِ لَوْ كانَ يَقْبَلُ إِنْكارَها",43,"ر",3,0],["وما اعتاد فيه المرء خصته نفسه","فلا تقرب الا غير ما شان في الشان",44,"ن",1,0],["وَما أَعرَضَت عَنّي وَحَقِّ وِصالِها","لِغَيرِ اِحتِرامي في الهَوى وَخَطيئَتي",45,"ي",1,0],["وَما اِعتزّ ذو تاجٍ بِملك وَسَطوة","عَلى قُدرةٍ إِلّا لَهُ اللَه أَخضَعا",46,"ع",2,0],["وما أَعمارُنا إلاّ شُموسٌ","وهل للشّمْسِ بُدٌّ من زَوال",47,"ل",1,0],["وما اعتَمَد الأقوامُ حَربَكَ غِرّةً","ولكنّهمْ غُرّوا بحِلْمِكَ فاغْتَرّوا",48,"ر",3,0],["وما أعبَقَ الوردَ الرّبيعُ وإنّما","بَنانُك أهدَى عَرْفُ عُرْفِك للوَرد",49,"د",1,0],["وما اعترف الحُسّادُ حُبّاً بفَضْلِه","ولكنّهم لا يَستطيعون جَحْده",50,"د",2,0],["وَما أَعني سِواكَ أَبا عَليِّ","فَكُن حَيثُ اشتُهيتَ تَكُن مُرادا",51,"د",2,0],["وما اعترف الجحود بها وفاقاً","ولكنْ لا سبيل إلى الجحود",52,"د",1,0],["وما اعتادني منها سوى فرط لوعة","تصبّب دمعي بالزفير المصعّد",53,"د",1,0],["وما أعلم الحسَّادَ للشمس أنهم","فناءٌ على الأيّام وهي دوامُ",54,"م",1,0],["وما أعزَّ الفتى في ظلِّ عفّتِهِ","لو شُووِرَ الحزمُ أو لو صحَّت الفِكَرُ",55,"ر",1,0],["وما أعرفُ الممدوحَ لم يَجزِني به","إذا قلتُ خيراً إنَّ ذلك بالضدِّ",56,"د",1,0],["وما أعْجَب حِرْماني","وأنتُمْ للنَّدى أصْلُ",57,"ل",1,0],["وما اعْترفَ الحُرُّ الفصيح لمحْسنٍ","فجازاهُ حمداً خالداً في العَواقِب",58,"ب",1,0],["وما أعجبَ المرء في حالي تقلبه","حين الرضا عن لياليه وفي الإحن",59,"ن",1,0],["وما اعتراه من خلل","ما للهلال الأحمر",60,"ر",1,0],["وَما أُعابُ بِشَيءٍ بَعدَ فُرقَتِكُم","إِلّا البَقاءَ فَإِنّي مِنهُ أَعتَذِرُ",61,"ر",1,0],["وما اعتمادي على علمي ولا عملي","أنت الكريم وقد وجهت يا أملي",62,"ي",1,0]]}