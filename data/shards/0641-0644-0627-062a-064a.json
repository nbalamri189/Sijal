{"poems":[[44,"أمنت على السر امرء غير حازم","https://www.aldiwan.net/poem50461.html","الطويل"],[32,"أتعرف أطلالا بوهبين والحضر","https://www.aldiwan.net/poem29583.html","الطويل"],[82,"خطاب عن لقائكم يعوق","https://www.aldiwan.net/poem31361.html","الوافر"],[48,"عجبت لآمرنا لم يطع","https://www.aldiwan.net/poem22969.html","المتقارب"],[132,"قفوا قلنا في ربع ليلى مواقف","https://www.aldiwan.net/poem50573.html","الطويل"],[239,"فلا تيأسا من رحمة الله وانظرا","https://www.aldiwan.net/poem4607.html","الطويل"],[358,"دعينا من بعادك أو عدينا","https://www.aldiwan.net/poem39771.html","الوافر"],[382,"أيدري الدهر أيم الله أني","https://www.aldiwan.net/poem59430.html","الكامل"],[409,"ستطلع شمس الوصل بعد أفولها","https://www.aldiwan.net/poem33667.html","الطويل"],[580,"ألا فانتبه من أفقها طلع الفجر","https://www.aldiwan.net/poem3064.html","الطويل"],[951,"","https://poetry.dctabudhabi.ae/diwan/poem/19931","الطويل"],[2052,"","https://poetry.dctabudhabi.ae/diwan/poem/101418","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27421","الطويل"],[3150,"","https://poetry.dctabudhabi.ae/diwan/poem/82364","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103884","الطويل"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145148","الوافر"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145128","المتقارب"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132010","الوافر"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118744","الطويل"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32796","الوافر"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102931","الطويل"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139460",""],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127103","البسيط"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103254","الطويل"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104535","الطويل"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116072","الطويل"],[5410,"انتظار","https://www.poetsgate.com/ViewPoem.aspx?id=139635",""],[5636,"وَمضَةُ أَمَلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=207172",""],[5704,"رحيل الأهل ...","https://www.poetsgate.com/ViewPoem.aspx?id=191697",""],[5957,"تنحى الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=176787",""],[4442,"إذا جد جد المرء والدهر مطرق","https://www.poetsgate.com/ViewPoem.aspx?id=170988",""],[6152,"القادم أجمل","https://www.poetsgate.com/ViewPoem.aspx?id=204815",""]],"verses":[["فَلا تَيأَسَنَّ الدَهرَ مِن ودِّ كاشِحٍ","وَلا تَأمَنَنَّ الدَهرَ صَرمَ حَبيبِ",0,"ب",1,0],["فَلا تَيأَسَن مِن أَنَّني لَكَ ناصِحٌ","وِمَن أَنزَلَ الفُرقانَ في لَيلَةِ القَدرِ",1,"ر",1,0],["فلا تيْأسْ فللرحمنِ لُطْفٌ","يُحَلّ بِيُسْرِهِ العَقْدُ الوثيقُ",2,"ق",1,0],["فَلا تَيأَسَنَّ لِلَيلٍ دَجا","وَلا تَفرَحَنَّ بِفَجرٍ سَطَع",3,"ع",1,0],["فلا تيأسُوا إِمَّا اجترحتمْ حريمُة","له من سجاياهُ عليكم عواطفُ",4,"ف",1,0],["فَلا تَيأسا من رَحمَةِ اللَهِ وَاِنظُرا","بِوادي جَبونا أَن تَهُبَّ شَمالُ",5,"ل",1,1],["فَلا تَيأس إِذا ما غابَ عَنّا","وَأبقى حَمدَهُ وَثَناه فينا",6,"ن",2,0],["فلا تيأس لدهرٍ مُكفَهِرٍّ","إذا غادرتَ ذنباً مكفهرا",7,"ر",2,0],["فلا تيأسن إن طال ليل بعادهم","فقد حان من شمس اللقا طلوع",8,"ع",1,0],["فلا تَيأَسَنْ يا قلبُ أَنْ تبلغَ المنَى","ولا تعجَبنْ إِنْ قِيلَ قَد أَوْرَق الصَّخْرُ",9,"ر",1,0],["فلا تيأسن الدهر من وصل كاشح","ولا تأمنن الدهر صرم حبيب",10,"ب",1,1],["فَلا تَيأسِ المُدَّاحُ مِن صَدَقاتِه","فَإنْ فاتَ يَوماً جُودُهُ لم يَفُتْ غدا",11,"د",2,0],["فلا تيأسي يا نفس مما نريده","فلا بدّ لي منه وإنْ طالَ ما طالا",12,"ل",2,0],["فَلا تَيأَسا مِن فَرحَةٍ بَعدَ ترحة","وَأَن تَبأيا بِاليُسرِ مِن بَعد ما عُسرِ",13,"ر",1,0],["فلا تيأسي يا نفس عل زماننا","يعود بوجهٍ مقبلٍ غير مدبر",14,"ر",1,0],["فلا تيأس وثق بالنصر وابشر","فإنك سوف تبلغ ما تريد",15,"د",1,0],["فلا تيأسي إن عرت نبوة","فسيف الجزائر لن يغمدا",16,"د",2,0],["فلا تيأس فإن الدهر فيه","صحائف تحفظ الشكر الجزيلا",17,"ل",2,0],["فلا تيأسي يا قرّة العين واصبري","فوالله إن الظالمين لفي خسر",18,"ر",1,0],["فَلا تَيأَس وَإِن صَحَّت","عَزيمَتُهُم عَلى الدَلَجِ",19,"ج",1,1],["فلا تيأسن من نجدة بعد شدة","فلم تر ليلا ليس بالفجر يعقب",20,"ب",1,0],["فلا تيأسن فاللهُ ملكَ يوسفاً","خزائنهُ بعد الخلاصِ من السجنِ",21,"ن",1,0],["فلا تيمم سواه فالتيمم لا","يجوز كيف وماء الجود قد سفحا",22,"ح",2,0],["فلا تيأسوا أن ترجحوا كفة بهم","فرب ألوف لا تطيق مئينا",23,"ن",2,0],["فلا تيأسن منه فلست بعالم","متى بدره في أفق دارك يشرق",24,"ق",1,0],["فلا تيئسوا إنّ الزّمانَ صُروفَهُ","وأحداثَهُ مثلُ الحديثِ شُجونُ",25,"ن",1,0],["فلا تيأس وخذ بيدي","وكن لمواسمي حكرا",26,"ر",2,0],["فَلا تَيْأَسْ إذا ما الفَقْدُ أمْسى","رَفيقَ الحَرْفِ واحْتَضَنَ اليَراعا",27,"ع",2,0],["فلا تيأس من الأحباب عَوْدًا","فحتمًا ينقضي زمن الجفاء",28,"ا",2,0],["فلا تيأس فؤادي فالمآسي","يعاني من عواصفها الوفاءُ",29,"ا",2,0],["فلا تيأسن منه فلت بعالم","متى بدوره في أفق دارك يشرق",30,"ق",1,0],["فلا تيأس , ولا تحزن تفاءل","فإن القادم المأمول أجمل !",31,"ل",1,0]]}