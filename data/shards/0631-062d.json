24",""],[106,"الركب المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=179288",""],[106,"فجر السلام","https://www.poetsgate.com/ViewPoem.aspx?id=179416",""],[77,"مولاي يهنيك المطر","https://www.poetsgate.com/ViewPoem.aspx?id=34089",""],[77,"نفحت فشبت لافح التذكار","https://www.poetsgate.com/ViewPoem.aspx?id=34093",""],[77,"نشدتك هل أبصرت قبلي أو بعدي","https://www.poetsgate.com/ViewPoem.aspx?id=33937",""],[77,"أهاجتك ذكرى من خليط ومعهد","https://www.poetsgate.com/ViewPoem.aspx?id=33822",""],[49,"مَنْ يعشْ يكبرْ ومنْ يكبَرْ يمُتْ","https://www.poetsgate.com/ViewPoem.aspx?id=16968",""],[50,"أرسلت خلتي من الدمع غربا","https://www.poetsgate.com/ViewPoem.aspx?id=19941",""],[67,"سارتِ العِيسُ يُرجعْنَ الحنينا","https://www.poetsgate.com/ViewPoem.aspx?id=14580",""],[27,"وأَقبَّ كالسِّرحان تم له","https://www.poetsgate.com/ViewPoem.aspx?id=180957",""],[90,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[90,"ذكرى الهاشمي","https://www.poetsgate.com/ViewPoem.aspx?id=179163",""],[90,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[90,"إلى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179104",""],[90,"بم أستهل","https://www.poetsgate.com/ViewPoem.aspx?id=179014",""],[90,"أمين الريحاني","https://www.poetsgate.com/ViewPoem.aspx?id=178954",""],[51,"ما مَدْمَعي حذَرَ النَّوى بقريحِ","https://www.poetsgate.com/ViewPoem.aspx?id=27414",""],[51,"يا بن فراس أيُّ شيءٍ تنتظرْ","https://www.poetsgate.com/ViewPoem.aspx?id=29083",""],[51,"ابا حسن إنّ حبل الِمطا","https://www.poetsgate.com/ViewPoem.aspx?id=29052",""],[50,"يا دارُ بين الفرع والجنابِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=8373&r=&rc=14",""],[97,"زازا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63558&r=&rc=104",""],[88,"أقول لهم وقد جدّ الفراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19548&r=&rc=51",""],[3,"إذا كانَ دمْعي شاهدي كيفَ أجْحَدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10687&r=&rc=41",""]],"verses":[["رَحَّلَني عَن وَطَني","إِنّي ذَمَمتُ الوَطَنا",0,"ن",2,0],["رَحَلنا بِها كَالبَدرِ حُسناً وَشارَةً","وَمِلنا إِلى البَيداءِ وَهيَ هِلالُ",1,"ل",1,0],["رَحِمٌ تَعَلَّقُ بِالبَعيدِ كَما","عَلِقَ الحِباءَ النازِحُ الطُوَلُ",2,"ل",1,0],["رُحِضَ الأَغلَفُ في تَيّارِهِ","وَرَدَ العِلجُ وَما كادَ يَرِد",3,"د",1,0],["رَحَلنا بِأَكبادٍ غِلاظٍ عَلى الهَوى","قَليلٍ إِلى ما خَلفَها لَفَتاتُها",4,"ت",3,0],["رَحَلتَ وَفي كُلِّ جَفنٍ دَمٌ","عَلَيكَ وَفي كُلِّ قَلبٍ وَجيبُ",5,"ب",1,0],["رَحْبُ الذِّراعِ بكَشْفِ الخَطْبِ في فِتَنٍ","كأنَّنا مِنْ غَواشيهِنَّ في ظُلَلِ",6,"ل",1,0],["رَحَلْتَ فالمَجدُ لمْ تَرْقَأْ مَدامِعُهُ","ولَمْ تَرِقَّ عَلَيْنا المُزْنُ أكْبادا",7,"د",2,0],["رَحيضُ حواشي البُرْدِ ما شانَهُ الخِنَى","خَفيضُ نَواحي النُّطْقِ ما شابَهُ الهُجْرُ",8,"ر",1,0],["رَحَلتِ وَقَلبي يا اِبنَةِ العَمِّ تائِهٌ","عَلى أَثَرِ الأَظعانِ لِلرَكبِ يَنشُدُ",9,"د",1,0],["رَحِمَ اللَهُ مَن دَعا لي إِذا قا","مَ يُصَلّي فَإِنَّني مَظلومُ",10,"م",1,0],["رَحَلتُ إِلَيهِ مِن بَلَدي وَأَهلي","فَجازاني جَزاءَ الخائِنينا",11,"ن",2,0],["رحْبُ الذِّراعِ لكُلِّ خطْبٍ فادِحٍ","أعْيَتْ رِياضَتُهُ علَى الحُذّاقِ",12,"ق",1,0],["رَحمَةَ اللهِ حُجَّةَ اللهِ نُورَ ال","لَّهِ بُرْهَانَه الْحَقِيقَ الْمُبِينَا",13,"ن",2,0],["رَحِيبَةُ ألْطَافٍ إِذَا الْوَفْدُ حَلَّهَا","تَكَنَّفَهُمْ غَمْرُ النَّوَالِ عَمِيمُهُ",14,"م",2,0],["رحَلْتُ عنْكمْ ولي فُؤادٌ","لهُ بأحْوازكُمْ قَرارُ",15,"ر",1,0],["رُحِمَ العِبادُ بخاطِرٍ","في جوِّ نفْسِكَ قد خطَرْ",16,"ر",1,0],["رُحْمى بِلا مَنٍّ أمْنٌ دونَما","رهَبٍ وحِفْظُ أذِمّةٍ وذِمارِ",17,"ر",1,0],["رَحيبَةَ أكْنافٍ ضَمينَةَ أنْعُمٍ","تدُلُّ على الفَخْرِ المُؤَثَّلِ والمَجْدِ",18,"د",1,0],["رحَلْتَ فكُنْتَ في التّحقيقِ بَدْرا","مَنازِلُكَ المَنازِلُ والبِلادُ",19,"د",1,1],["رَحيبُ مَجالِ الفَضْلِ يَكْلَفُ بالعُلى","فَما هوَ بالمُصْغي لقَوْلِ المُفَنِّدِ",20,"د",1,0],["رُحْمَى إلَهِ العَرْشِ بيْنَ عِبادِهِ","وأمِينِه الأرْضَى على ما يُوحي",21,"ح",2,0],["رَحَلْنا عنِ الأوجِ الرّفيعِ مَحَلُّهُ","مَراحِلَ شتّى ثمّ عُدْنا الى الأوْجِ",22,"ج",1,0],["رَحَلَ الصِّبَا فَطَرَحْتُ فِي أَعْقَابِهِ","مَا كَانَ مِنْ غَزلٍ وَمِنْ تَشْبِيبِ",23,"ب",1,0],["رَحْمَةُ اللهِ ورِضْوا","نٌ على تِلْكَ الفَراشَهْ",24,"ش",2,0],["رَحَلَت سُمَيَّةُ غُدوَةً أَجمالَها","غَضبى عَلَيكَ فَما تَقولُ بَدا لَها",25,"ل",3,1],["رَحَلتُ إِلى قَومي لِأَدعو جُلَّهُم","إِلى أَمرِ حَزمٍ أَحَكَمتُهُ الجَوامِعُ",26,"ع",1,1],["رَحِمَ اللَهُ صاحِبَ النَظَراتِ","غابَ عَنّا في أَحرَجِ الأَوقاتِ",27,"ت",1,1],["رُحِمتَ فَقَد كُنتَ حُلوَ اللِسانِ","جَلِيَّ البَيانِ صَدوقَ الخَبَر",28,"ر",1,0],["رَحمَةُ الدينِ عَلَيهِ كُلَّما","خَرَجَ التَفسيرُ عَن طَوقِ الأَريبِ",29,"ب",1,0],["رَحمَةُ الرَأيِ عَلَيهِ كُلَّما","طاشَ سَهمُ الرَأيِ في كَفِّ المُصيبِ",29,"ب",1,0],["رَحمَةُ الفَهمِ عَلَيهِ كُلَّما","دَقَّتِ الأَشياءُ عَن ذِهنِ اللَبيبِ",29,"ب",1,0],["رَحمَةُ الحِلمِ عَلَيهِ كُلَّما","ضاقَ بِالحِدثانِ ذو الصَدرِ الرَحيبِ",29,"ب",1,0],["رَحِمَ اللَهُ يا حُسَينُ خِلالاً","فيكَ لَم يَجتَمِعنَ في نَفسِ حَيِّ",30,"ي",1,0],["رُحِمتَ فَما جاهٌ يُنَوِّهُ في العُلا","بِصاحِبِهِ إِلّا وَجاهُكَ أَوسَعُ",31,"ع",1,0],["رَحِمَ اللَهُ مِنهُ لَفظاً شَهِيّاً","كانَ أَحلى مِن رَدِّ كَيدِ الأَعادي",32,"د",2,0],["رَحِمَ اللَهُ مِنهُ طَرفاً تَقِيّاً","وَيَميناً تَسيلُ سَيلَ الغَوادي",32,"د",2,0],["رَحِمَ اللَهُ مِنهُ شَهماً وَفِيّاً","كانَ مِلءَ العُيونِ في كُلِّ نادي",32,"د",2,0],["رَحِمتُ اِنكِسارَ قُلوبِ النعالِ","وَقَد دَنَّسوها بِأَثوابِهِ",33,"ب",2,0],["رَحُبتَ بِها سَرباً فَأَجزَأتَ كُلَّها","بِحِفظٍ فلَم يَفدَحكَ ما أَنتَ حامِلُ",34,"ل",1,0],["رَحمَةُ اللَهِ وَالسَلامُ عَلَيهِ","وَسَقى قَبرَهُ الرَبيعُ خَريفا",35,"ف",2,0],["رُحْمَاكَ يَا طَلْقَ المُحَيَّ","ا لَوْ رَثَيْتَ لِذُّلِّ عَانِي",36,"ي",1,0],["رُحْتَ تَأْسُو جَرْحَى وَتَشْفِي مِرَاساً","تَتَرَامَى الرُّبى بِهِمْ وَالحُزُونُ",37,"ن",1,0],["رَحَلتُ عيسي إِلى البَيتِ الحَرامِ عَلى","ما كانَ مِن وَصَبٍ فيها وَمِن نَصَبِ",38,"ب",1,0],["رحم الإله العالمين ببعثه","فيهم وفضَّل جنسَهُ تفضيلا",39,"ل",2,0],["رحلتهم بالبدور ومارحمتم","مشوقاً لا يبوخ له اشتياق",40,"ق",1,0],["رحم الله أمةً أصبح الغر","بُ يرى كل ذنبها الإسلاما",41,"م",2,0],["رحم الله شيخنا إنه كا","ن بعيداً عمّا تريد السياسه",42,"س",2,0],["رَحَلنَ لِشُقَّةٍ وَنَصَبنَ نَصباً","لِوَغراتِ الهَواجِرِ وَالسَمومِ",43,"م",1,0],["رحبُ الفِناءِ اضطراب المجد رغبته","والمجدُ أنفعُ مضروبٍ لمضطربِ",44,"ب",1,1],["رحيب الذراع متين الزَّماعِ","إذا الأمر ضاق على الَبْلتَمِ",45,"م",1,1],["رَحِمَ اللَهُ نافِعَ اِبنِ بُدَيلٍ","رَحمَةَ المُشتَهي ثَوابَ الجِهادِ",46,"د",1,1],["رِحمَ نَبِيٍّ جَدُّهُ جَدُّهُ","يَدعو إِلى نورِ هُدىً ساطِعِ",47,"ع",1,0],["رَحبَ المَباءَةَ وَالجِنابَ مَوطِئاً","مَأوى لِكُلِّ مُعَتَّقٍ سَوّافِ",48,"ف",1,0],["رحلت إليك ركائبٌ ومدائحٌ","فإليك يقصد راغبٌ ويقصّد",49,"د",1,1],["رحلت فألقى رحله كلّ قاصدٍ","وقطع من أسبابه بعدك الشعر",50,"ر",1,0],["رحلتَ عن عادميْ صبرٍ وما قدروا","أن لا تفارقهم فالراحلون همُ",51,"م",1,0],["رحلَّتني عن سلوي","بلغاتٍ فارسيَّه",52,"ي",2,0],["رَحِمَ اللَّهُ مَنْ سقى","رحم اللَّه من شرِبْ",53,"ب",1,0],["رحُبَتْ به الدنيا على سُكَّانِها","من بعدما كانت كَخَطِّ ضريحِ",54,"ح",1,0],["رحم اللّه من مضى ووقاكُمْ","نُوَبَ الدهر يا بني حمَّادِ",55,"د",1,0],["رحل المَطيُّ لنيةٍ","زوراءَ مَطلبها شَطيرُ",56,"ر",1,0],["رحلتُ على أملٍ بادنٍ","وأ ت على أمل ضامر",57,"ر",1,0],["رُح لي بما أمَّلْت إذ لم تبتكر","وإن عجزتَ أن تَسُنَّ فافتقر",58,"ر",1,0],["رحيبةِ شق الفرج أكبرُ خلقها","مَبال خبيث الريح أخرق أجحر",59,"ر",1,0],["رحل الصيام وشهره وكلاهما","لهج بذكرك ما يفيق نزوعا",60,"ع",2,0],["رحُبت خواصره وجبهتُه","والمنخران وتم أتلَعه",61,"ع",2,0],["رحم الله صالح بن وصيفِ","فلقد كان جدَّ شهمٍ ظريفِ",62,"ف",1,1],["رُحت كي تجبرعظماً","وغدا ينهش عرقا",63,"ق",2,0],["رحلْتُ ظني إلى جدواه بل ثقتي","فأخَّر الوعدَ لكنْ قدم النَّفلا",64,"ل",2,0],["رحلتْ نحو مَنْ تثاقلَ عنها","وكفتْهُ مؤونةَ الترحالِ",65,"ل",1,0],["رحلْتَ إليها العيس أيْمَنَ راحلٍ","ويقدمها من بعدُ أسعدُ قادم",66,"م",1,0],["رحَّلنَ إلفَك عن مساكِن قلعةٍ","كانت لقوم آخرين مساكنا",67,"ن",2,0],["رَحَلتَ فَلَم تَترُك لِنَفسِكَ حاجَةً","أَبا دَوبَلٍ إِلّا اِختِلاسَ الأَخادِعِ",68,"ع",1,1],["رَحَلَت أُمامَةُ لِلفِراقِ جِمالَها","كَيما تَبينَ وَما تُريدُ زِيالَها",69,"ل",3,1],["رَحمَةً بِالخُصورِ أَيَّتُها الغي","د وَرِفقاً رِفقاً بِتِلكَ القُدودِ",70,"د",1,0],["رَحَلَ الشاعِرُ عَن دارِ الأَذى","وَاِنقَضَت مَعَهُ اللَيالي الغُرَرُ",71,"ر",1,0],["رَحَمَةُ اللَهِ عَلى أَسلافِكُم","إِنَّهُم كانوا تُقاةً بَربَرَه",72,"ر",2,0],["رَحمَةُ اللَهِ عَلَيهِم إِنَّهُم","لَم يَكونوا أُمَّةً مُنشَطِرَه",72,"ر",2,0],["رُحنا حَيارى صامِتينَ كَأَنَّما","لِلهَولِ نَحذُرُ عِندَهُ أَن نَنطِقا",73,"ق",2,0],["رُحماكَ بي فَالَيلُ قاسٍ بَردُهُ","وَالهَولُ يَملَءُ ناظِري وَجَناني",74,"ن",2,0],["رَحَلنا مِنَ الأَجبالِ أَجبالِ طَيِّءِ","نَسوقُ النِساءَ عوذَها وَعِشارَها",75,"ر",3,0],["رَحَلَ الواشونَ عَنّا","شَكَرَ اللَهُ المَطايا",76,"ا",3,1],["رَحبُ الجَنابِ خَصيبَةٌ أَكنافُهُ","فَلَكَم سَديرٌ عِندَها وَخَوَرنَقُ",77,"ق",1,0],["رَحَلَ الشَبابُ وَلَم أَنَل","مِن لَذَّةٍ فيهِ نَصيبي",78,"ب",2,1],["رُحْماكَ قَدْ عَذَّبْتَني بالصَّمتِ","والدَّمعِ الهَتُونْ",79,"ن",1,0],["رَحَلوا وَأَخفى وَجدَهُ فَأَذاعَهُ","ماءُ الشُجون مُصرّحا وَمجمجما",80,"م",2,0],["رَحَلَ اِصطِباري إِذ رَحَلتُم قائِلاً","أوبُ الأَحِبَّة بَينَنا الميعادُ",81,"د",1,0],["رَحَلَ الخَليطُ جِمالَهُم بِسَوادِ","وَحَدا عَلى إِثرِ الحَبيبَةِ حادِ",82,"د",1,1],["رحب القبر في الغداة بشكري","وعسى أن يسره الترحاب",83,"ب",1,0],["رحلت وفي العيادة كل شئ","وعدت فما وجدت هناك شيا",84,"ي",2,0],["رحمة الله على سيدتي","وسقى الله ثراها وجزاها",85,"ا",3,1],["رحماك رحماك يا ذاك الخيال ويا","أمّاه رفقا ويا عادي الهوى أتئد",86,"د",1,0],["رُحماكَ يوسُفُ قِف رِكابَكَ ساعَةً","وَاِعطِف عَلى يَعقوبَ فيهِ حَزينا",87,"ن",2,0],["رُحماكَ عَبدَ الحَيِّ أُمُّكَ شَيخَةٌ","قَعَدَت وَهيضَ لَها الغَداةَ جَناحُ",88,"ح",1,0],["رُحِمتَ مَصيرُ العالَمينَ كَما تَرى","وَكُلُّ هَناءٍ أَو عَزاءٍ إِلى فَوتِ",89,"ت",1,0],["رَحمَةُ اللَهِ لَهُ هَل عَلِما","أَنَّ تِلكَ النَفسَ مِن ذا النَفَسِ",90,"س",1,0],["رُحِموا بِالعَبقَرِيِّ النابِهِ","البَعيدِ الهِمَّةِ الصَعبِ القِياد",90,"د",1,0],["رِحلَةُ المَشرِقِ وَالمَغرِبِ ما","لَبِثَت غَيرَ صَباحٍ وَمَساء",91,"ا",2,0],["رَحّالَةَ الشَرقِ إِنَّ البيدَ قَد عَلِمَت","بِأَنَّكَ اللَيثُ لَم يُخلَق لَهُ الفَزَعُ",92,"ع",1,0],["رَحَلَ العَزاءُ بِر