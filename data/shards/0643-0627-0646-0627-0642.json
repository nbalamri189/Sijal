{"poems":[[55,"ألا يا لقومي للخطوب الطوارق","https://www.aldiwan.net/poem29952.html","الطويل"],[74,"وراهبة طرقناها بليل","https://www.aldiwan.net/poem18500.html","الوافر"],[74,"نعم الدواة حكت بيض الظبا فلها","https://www.aldiwan.net/poem18591.html","البسيط"],[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[31,"حي المنازل بين السفح والرحب","https://www.aldiwan.net/poem6045.html","البسيط"],[31,"لقد غدوت على الندمان لا حصر","https://www.aldiwan.net/poem6163.html","البسيط"],[91,"مات سعد فما عسى أن تقولا","https://www.aldiwan.net/poem44613.html","الخفيف"],[77,"الشمس عنه كليلة أجفانها","https://www.aldiwan.net/poem69029.html","الكامل"],[147,"عاذ بالصفح من أَحب البقاء","https://www.aldiwan.net/poem11716.html","الخفيف"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[369,"إن أقمر الليل للسارين في حضن","https://www.aldiwan.net/poem60631.html","البسيط"],[369,"ألا ليت قلبي يوم أعلن وجده","https://www.aldiwan.net/poem60955.html","الطويل"],[463,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[470,"الموجعة","https://www.aldiwan.net/poem59030.html","عموديه"],[567,"يوسف الشيخ الرفيع الشان من","https://www.aldiwan.net/poem52550.html","البسيط"],[591,"متى يعطف الجاني وتقضى وعوده","https://www.aldiwan.net/poem17488.html","الطويل"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104111","الطويل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104564","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64041","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77611","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25345","الرجز"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95575","الرمل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48933","السريع"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108691","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93669","البسيط"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75949","البسيط"],[2740,"","https://poetry.dctabudhabi.ae/diwan/poem/126521","الوافر"],[3186,"","https://poetry.dctabudhabi.ae/diwan/poem/198690","البسيط"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66104","الطويل"],[4767,"اعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=91943",""],[4828,"سيرةُ ضوء","https://www.poetsgate.com/ViewPoem.aspx?id=193407",""],[5050,"مقام في القصور على قصور","https://www.poetsgate.com/ViewPoem.aspx?id=38189",""],[778,"قم فادرها على راحا","https://www.poetsgate.com/ViewPoem.aspx?id=89226",""],[5213,"تنشقت بالدارات من مية عرفا","https://www.poetsgate.com/ViewPoem.aspx?id=170503",""],[5431,"ستهلك ألف عاشقة وأبقى","https://www.poetsgate.com/ViewPoem.aspx?id=196523",""],[194,"كَاَنَّ اَقتادِىَ والاَسامِطا","https://www.poetsgate.com/ViewPoem.aspx?id=51524",""],[2110,"كرعتها وحباب الكأس مشتبك","https://www.poetsgate.com/ViewPoem.aspx?id=156284",""],[5690,"لحسن رأيك باتت تخضع الفكرُ","https://www.poetsgate.com/ViewPoem.aspx?id=172163",""],[5809,"قطار العمر","https://www.poetsgate.com/ViewPoem.aspx?id=205636",""],[6052,"نحتُّ الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=50324",""]],"verses":[["كَأَنّا قَذىً يَرمي بِهِ السَيلُ كُلَّما","تَطاوَحَ ما بَينَ الرُبى وَالأَبارِقِ",0,"ق",1,0],["كأنا قد سلبنا الديكَ عيناً","فقامَ من الكرى فزعاً يصيح",1,"ح",1,0],["كأنَّ أقلامها منها منضلةٌ","فلم يفتها إلى الأغراضِ تسديد",2,"د",1,0],["كأن أقطار الفلاة مجزره","أو روضة من الدماءِ مزهره",3,"ه",1,0],["كَأَنَّ أَقتادَهُ مِن بَعدِ ما كَلَمَت","عَلى أَصَكَّ خَفيفِ العَقلِ مُنتَخَبِ",4,"ب",1,0],["كَأَنَّ أَقرابَها القُبطِيُّ إِذ ضَمَرَت","وَكادَ مِنها بَقايا الماءِ يُعتَصَرُ",5,"ر",1,0],["كان أقواله تدور عليها","دوران النجوم في الأفلاك",6,"ك",1,0],["كان اقتناها الجاثلِيقُ يُكِنُّهَا","ويَصُونُ دُرّةَ غائصٍ صَوّانها",7,"ن",3,0],["كانَ إِقدامُ عامِرٍ لَكَ إِضرا","ءً وَقَد أَحسَنوا هُناكَ البَلاءَ",8,"ا",2,0],["كانَ أَقوى الأنام بطشاً وإن صا","رَعَ ذلّت لبطشه الأقوياءُ",9,"ا",2,0],["كأنّ أقلامَه المُصماةَ إذ طَعنَتْ","في ثُغرةِ الخَطْبِ أطرافُ القنا اللُّدُن",10,"ن",1,0],["كأنّا قصَدْنا المجدَ نحن حقيقةً","وكان مَجازاً ما يرومون قَصْده",11,"د",2,0],["كأنّ أقلامَهُمُ","في اللُّبثِ والتسرُّعِ",12,"ع",1,0],["كانَ أقصى أحلامِه ِوَلَد ٌ","يَزدَهي ، أو بُنَيَّة ٌتَلِد ُ!",13,"د",1,0],["كانَ أقوَى عُمدَةٍ في قومهِ","بينَ كُلِّ النَّاسِ مرفوعَ المَقامْ",14,"م",1,0],["كأنّا قَسَمْنا نِصْفَ شَعْبَان بَيْنَنَا","عَلى حُكْم ما يُرْضِي الهَوَى ويُريدُهُ",15,"د",2,0],["كأنّا قُرفنا باجترامٍ فما لنا","لسانٌ يُقوّينا بعذرٍ مُباينِ",16,"ن",1,0],["كأنّ أقاحيهِ نِظامُ لآلئٍ","تداعى نِثاراً في جِنانِ جنيّهِ",17,"ي",2,0],["كأن أقلامَهم فيمن يخالِفُهُم","سُمرٌ وبيضٌ خلالَ النَّقع تختلف",18,"ف",1,0],["كانَ اِقتَنى في عُمره بُستانا","يَرزع فيهِ الآس وَالرَيحانا",19,"ن",2,0],["كَأَنَّ أَقْتادِي جَلَزْنَ زَوْرَقَا","أَزَلَّ أَوْ هَيْقَ نَعام أَهْيَقا",20,"ق",2,0],["كان أقوى من عوادى الحدثان","وقرينا لفتاة كالقمر",21,"ر",1,0],["كأَن أقمارَك قد حُوصرت","ولم يُصِبكَ الدهرُ في مقتَل",22,"ل",1,0],["كأن أقسى علي مني على الما","ل إذا كان زائري غندورا",23,"ر",2,0],["كَأَن أَقلامه اللاتي يُثقفها","عَصى الَّذي شَقَ فيها البَحر فَانفَلَقا",24,"ق",2,0],["كانَ اِقتَنى كتباً في العِلمِ نادِرَةً","كَيما يَخُصّ بِها ناساً بِأَندَلُسِ",25,"س",1,0],["كانَّا قد خُلقنا لافتراق","تراقبنا النوائب كالاعادي",26,"د",2,0],["كأنّ أقداسَها رَكْبٌ إذا سَمعوا","منها حُداءً بكَوْا للبَيْن وارتَحلوا",27,"ل",3,0],["كانا قَطيعٌ حيثُ شاءَ رُعاتُهُ","مَضَى مالَهُ في الأَمْرِ جِلٌّ ولا دِقُّ",28,"ق",1,0],["كأنا قد فعلنا كل سوء","وأدخلنا على الأعراف عارا",29,"ر",2,0],["كان اقتراحُ المعاني الخُضرِ شاغِلَهُ","فظلَّ يبحثُ عن كونٍ يوازيهِ",30,"ي",2,0],["كأنا قد شككنا في مقال","أتى من عند مولانا القدير",31,"ر",1,0],["كان اقداحها بهار","يعود فوق الخدود وردا",32,"د",2,0],["كأن اقتطاع البيد طوع مناسم","بوارق نفاثات تبعثها خطفا",33,"ف",2,0],["كأنا قد لبسنا الحب دهرا","وعروته على الأرواح وثقى",34,"ق",2,0],["كَاَنَّ اَقتادِىَ والاَسامِطا","وَالرَحلَ وَالاَنساعَ وَالقراطِطا",35,"ط",2,1],["كأن أقداحها الأقمار ساطعة","ونورها من شعاع الشمس منسبك",36,"ك",1,0],["كانَّ أقلامه والبيض تخدمها","سمر تشير إلى ما خطه القدرُ",37,"ر",1,0],["كأنّا قضيبا سكةٍ مرَّ مسرعاً","عليها قطارُ العمرِ دونَ تَلاقِ",38,"ق",1,0],["كأنَّا قد حملنا السيف ثأراً","وكان الناس أعداءً لئاما",39,"م",2,0]]}