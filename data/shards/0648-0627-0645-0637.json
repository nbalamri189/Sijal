{"poems":[[55,"أعاد لي عيد الضنى","https://www.aldiwan.net/poem29729.html","مجزوء الرجز"],[95,"يفسح الراحلون للقادمينا","https://www.aldiwan.net/poem11170.html","الخفيف"],[90,"ابنوا المدارس واستقصوا بها الأملا","https://www.aldiwan.net/poem45004.html","البسيط"],[49,"أبت عبراته إلا انسكابا","https://www.aldiwan.net/poem25381.html","الوافر"],[53,"رقدت وما ليل الغريب براقد","https://www.aldiwan.net/poem61941.html","الطويل"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[76,"أرأيك أمضى أم حسامك يقطع","https://www.aldiwan.net/poem13174.html","الطويل"],[107,"أعدوا لأعلام البيان المنابرا","https://www.aldiwan.net/poem42086.html","الطويل"],[54,"يا من يفندني في اللهو والترب","https://www.aldiwan.net/poem27251.html","البسيط"],[48,"لهان علينا أن تمر كأنها","https://www.aldiwan.net/poem23501.html","الطويل"],[15,"ألين إذا لان الغريم وألتوي","https://www.aldiwan.net/poem45249.html","الطويل"],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/10712","الوافر"],[92,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[147,"شفاء الهدى يا سيفه العضب أن تشفا","https://www.aldiwan.net/poem11779.html","الطويل"],[159,"نالت على يدها ما لم تنله يدي","https://www.aldiwan.net/poem55472.html","البسيط"],[164,"شهدت لقد أعليت كعب المكارم","https://www.aldiwan.net/poem58777.html","الطويل"],[214,"قدوم به ربع الأحبة مشرق","https://www.aldiwan.net/poem13317.html","الطويل"],[242,"لا تخف أن ينقض الذن","https://www.aldiwan.net/poem19285.html","مجزوء الرمل"],[275,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[302,"يا حادي الظعن إن جزت المواقيتا","https://www.aldiwan.net/poem33317.html","البسيط"],[303,"تلاقوا بعد ما افترقوا طويلا","https://www.aldiwan.net/poem36818.html","عموديه"],[369,"بغرة وجهك منا القسم","https://www.aldiwan.net/poem60657.html","المتقارب"],[369,"شفته تحيات العيون العلائل","https://www.aldiwan.net/poem60810.html","الطويل"],[369,"أعد نظرة تبصر صنيع هواكا","https://www.aldiwan.net/poem60818.html","الطويل"],[371,"لقد سالمتنا صروف الزمان","https://www.aldiwan.net/poem17175.html","المتقارب"],[382,"ذلت لعزة دينك الأديان","https://www.aldiwan.net/poem59237.html","الكامل"],[463,"أعينوني على طلب المعالي","https://www.aldiwan.net/poem56066.html","الوافر"],[463,"حب إليها بالغضا مرتبعا","https://www.aldiwan.net/poem56125.html","السريع"],[473,"حللت كتافي يا أخي وهو موثق","https://www.aldiwan.net/poem59836.html","الطويل"],[487,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[520,"لكل مقام في علاك مقال","https://www.aldiwan.net/poem12200.html","الطويل"],[520,"رجونا قطع هجرك بالوصال","https://www.aldiwan.net/poem12224.html","الوافر"],[580,"يا ويح نفس عشقت","https://www.aldiwan.net/poem2982.html","مجزوء الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122761","المتقارب"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87220","البسيط"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130204","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64360","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70851","الرمل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70834","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62563","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80020","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108589","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69385","الطويل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137925",""],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28573","الوافر"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60821","الرمل"],[2467,"","https://poetry.dctabudhabi.ae/diwan/poem/111760","البسيط"],[2638,"","https://poetry.dctabudhabi.ae/diwan/poem/142148","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137427",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100246","الكامل"],[2902,"","https://poetry.dctabudhabi.ae/diwan/poem/147204","المتقارب"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133953","الرجز"],[3291,"","https://poetry.dctabudhabi.ae/diwan/poem/106694","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48460","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66502","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131117",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131016",""],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133264","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77005","البسيط"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44894","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86366","الوافر"],[4042,"","https://poetry.dctabudhabi.ae/diwan/poem/69295","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127097","الخفيف"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102748","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102735","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94550","البسيط"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138723","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73223","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139659",""],[4755,"مأساة سُهَيل اليَمَاني ( 1 )","https://www.poetsgate.com/ViewPoem.aspx?id=209084",""],[4888,"زف الدماء","https://www.poetsgate.com/ViewPoem.aspx?id=207759",""],[4929,"إرسالة إلى دماج","https://www.poetsgate.com/ViewPoem.aspx?id=202564",""],[4929,"عروبة الزمن الأجنبي","https://www.poetsgate.com/ViewPoem.aspx?id=215675",""],[4978,"تشطير الصمت شعر","https://www.poetsgate.com/ViewPoem.aspx?id=177287",""],[5010,"غرد في فضاء الشعر حرا","https://www.poetsgate.com/ViewPoem.aspx?id=189945",""],[5213,"حي ربوعا بالعذيب درسا","https://www.poetsgate.com/ViewPoem.aspx?id=170491",""],[5277,"الذهول","https://www.poetsgate.com/ViewPoem.aspx?id=184871",""],[5277,"نجوى قلم","https://www.poetsgate.com/ViewPoem.aspx?id=185263",""],[5277,"أغنيتي","https://www.poetsgate.com/ViewPoem.aspx?id=188101",""],[5277,"حديث البواقي","https://www.poetsgate.com/ViewPoem.aspx?id=204610",""],[5302,"ما أثلج الصدرا","https://www.poetsgate.com/ViewPoem.aspx?id=201896",""],[592,"أقول لعمري ما لهذا حقيقةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=128718",""],[5365,"وطن المعجزات","https://www.poetsgate.com/ViewPoem.aspx?id=191266",""],[5387,"أين كنتِ؟","https://www.poetsgate.com/ViewPoem.aspx?id=46528",""],[5461,"طالت القامات","https://www.poetsgate.com/ViewPoem.aspx?id=5039",""],[5582,"ما لِلْحَمائِمِ لا يَنْفَكُّ نائِحُها","https://www.poetsgate.com/ViewPoem.aspx?id=186834",""],[5689,"هنا بين هذا الدوح والزهرات","https://www.poetsgate.com/ViewPoem.aspx?id=143393",""],[5848,"العاشق الأكذوبه","https://www.poetsgate.com/ViewPoem.aspx?id=48977",""],[5861,"هسيس الروح","https://www.poetsgate.com/ViewPoem.aspx?id=215789",""],[5878,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=199218",""],[5956,"فرحة العمل بالهدى","https://www.poetsgate.com/ViewPoem.aspx?id=192553",""],[6148,"شهر الصيام","https://www.poetsgate.com/ViewPoem.aspx?id=201600",""],[6300,"أنا يا أنت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81626&r=&rc=3",""]],"verses":[["وَأَمطِرا دَمعَيكُما","ذاكَ الكَثيبَ الأَيمَنا",0,"ن",2,0],["وَأَمْطْتَ الحِجَابَ عَن أَيِّ سِرٍّ","كَانَ فِي مُهْجَةِ الفَخَارِ مَصُونَا",1,"ن",2,0],["وأمطروا روضها علما ومقدُرة","حتى تُفتحّ من أزهارها الأملا",2,"ل",2,0],["وَأَمطَرنَ الجِباهَ بِمُرجَحِنَّ","وَلَكِن بِالطِعانِ المُرِّ صابا",3,"ب",2,0],["وأمطرَه جذْبُ المجانيق جنْدلاً","وناراً تلظَّى كانقضاض الفراقدِ",4,"د",1,0],["وَأَمَّ طَيبَةَ مَسروراً بِعَودَتِهِ","يَطوي المَنازِلَ بِالوَخّادَةِ الرُّسُمِ",5,"م",1,0],["وَأَمطَرتَهُ غَيثاً مِنَ العَيثِ واكِفاً","يُظاهِرُهُ وَبلٌ مِنَ النُبلِ يَهمَعُ",6,"ع",1,0],["وأمطرتُهم عَتْباً فلمّا توجّعوا","توجّعتُ أَستدعِي الدُّموعَ مَواطِرا",7,"ر",2,0],["وَأَمطَرَ الكَأسُ ماءً مِن أَبارِقِهِ","فَأَنبَتَ الدُرَّ في أَرضٍ مِنَ الذَهَبِ",8,"ب",1,0],["وَأُمُّ طَويلِ الرُمحِ سَمَّتهُ مازِناً","لَدى العَقلِ يَحكي نَملَةً أُمَّ مازِنِ",9,"ن",1,0],["وَأَمطُلُهُ العَصرَينِ حَتّى يَمَلَّني","وَيَرضى بِبَعضِ الدَينِ في غَيرِ نائِلِ",10,"ل",1,0],["وَأُمطِرُ في التُرابِ سَحابَ جَفني","وَقَلبي في هُمومٍ وَاِكتِئابِ",11,"ب",1,0],["وأمُطُّ من شفتيَّ هُزءاً أنْ أرى","عُفْرَ الجباهِ على الحياةِ تكالُبا",12,"ب",2,0],["وَأَمطَتكَ أَطرافُ الأَسِنَّةِ رُتبَةً","تَوَدُّ الثُرَيّا أَن تَدومَ لَها إِلفا",13,"ف",2,0],["وَأَمْطَرَتْ لُؤْلُؤأً مِنْ نَرْجِسٍ وَسَقَتْ","وَرْداً وَعَضَّتْ عَلَى العُنَّابِ بِالبَرَدِ",14,"د",1,0],["وأمطرت معنى الجود بالتبر ديمة","غسلت بها عنه دماء السوائم",15,"م",1,0],["وأمطرتنا من سيل سيبك نائلا","فكدنا نقول الشهب بالغيث تدفق",16,"ق",1,0],["وَأَمِطْ عَنْهُ الدَّوَاعِي","لِيُمِيطَ اللهُ شَيْنَكْ",17,"ك",1,0],["وأمطرِ النخلَ والزيتونَ غاديةً","والتوتَ والكرمَ والرمانَ والتينا",18,"ن",2,0],["وأَمَّ طيبةَ مَثوى الطَيِّبين وقد","ثَنى له الشَوقُ نَحو المُصطَفى ليتا",19,"ت",2,0],["وَأمطرتِ الرصاصُ فكان وَبلاً","شديدَ الوكْفِ منهمراً وَبيلا",20,"ل",2,0],["وأمْطاهُ صَهْوتَه فامْتِطَى","وحكَّمه في الوَرى فاحْتكَم",21,"م",1,0],["وأمطَرْتَهم منها بطَلٍّ منَ الرَّدى","ولو ثَبتوا أمطَرْتَ أيضاً بوابل",22,"ل",1,0],["وأمطاكَ ظَهْراً للعَلاء منُاصباً","نُجومَ الدُّجَى لم يَقْتَعِدْه سِواكا",23,"ك",2,0],["وَأَمطَرتَ نَوءَ النَدى دائِماً","فَهُزَّت بِهِ أَرضُنا الهامِدَه",24,"د",2,0],["وأمطتَ ذيلَ الكفر لما أن بدا","من نورك الإرشاد والإيمان",25,"ن",1,0],["وأمطاك الغزالةَ ظهرَ طِرْفٍ","أتى خَلْقاً وسبقاً كالغزالِ",26,"ل",1,0],["وأمطرتْ من العميد مزنةٌ","عمّت فما فات حياها موضعا",27,"ع",2,0],["وَأَمطَرتَني مِن سُحبِ جودِكَ نائِلاً","غَدا مِنه أَمري وَهوَ رَيّانٌ مونِقُ",28,"ق",1,0],["وأمطر على أرض الجسوم غوادقا","من العلم بالأشيا تراها كما هيه",29,"ي",2,0],["وأمطرت فيه المسلمين وغيرهم","سحاب ندى لا يقتضيه سؤال",30,"ل",1,0],["وأمطيها وأنشطها فإنا","مللنا من عقال واعتقال",31,"ل",1,0],["وأَمْطَرَتْ دمْعَ الآ","لٍ كاللآلي نُسِّقَتْ",32,"ت",1,0],["وَأُمطِلُ آمالي الخامِساتِ","شَهراً وَشَهراً وعاماً وَعاما",33,"م",2,0],["وَأَمطَرَت مِن سَما الهَيجا مَدافعُه","عَلى رؤوس العِدا في أَرضهم كُلَلا",34,"ل",2,0],["وامطرت الدر الرطيب بخدها","يواقيت عادت بالشعاع المورد",35,"د",1,0],["وأمطر الكأس ماءا من أبارقه","فأنبت الدر في أرضٍ من الذهب",36,"ب",1,0],["وامْطلوني فحياتي","في التمادى والمِطالِ",37,"ل",1,0],["وأمطارٌ تروِّى أر","ضَه من بعد أمطار",38,"ر",1,0],["وامطري بقعة معطّرة الأر","جا مخضرة الرّبى والجنانِ",39,"ن",1,0],["وأمطر بناناً يا محمدُ في الورى","وقد روَّضوا حالاً توالت محولها",40,"ل",3,0],["وامطر علي من السماحة ديمة","وطفاء تسعدني بمحو سهادي",41,"د",2,0],["وَأَمطَرتَهُم مِن جَندَلِ الحَزنِ دِيمَةً","إِذا كَثُرَت أَمطارُها كَثُرَ الجَدبُ",42,"ب",1,0],["وامطر ساقةَ الالمان رمياً","سديداً مقصد الاهداف سعرا",43,"ر",2,0],["وَأَمطَرنا سَحابَ الدَّمعِ حَتّى","حَسِبنا أَنَّهُ مُهَجٌ تَسيلُ",44,"ل",1,0],["وأمْطرالسَّوْح العُواجي فَمَا","زِلْتُ مُعرى بهواه مُغْرما",45,"م",2,0],["وأمطَرَ الكأسُ ماءً من أبارِقها","فأنبَتَ الدُرَّ في أرضٍ من الذهبِ",46,"ب",1,1],["وأمطت أقنعة اللئام وزيفهم","حتى بدوا فينا بغير قناعِ",47,"ع",1,0],["وأمط لثامك عن جمالك كي نرى","بدر السماء وما عليه لثام",48,"م",1,0],["وامط لثام الورد عن متفتق","ورد تفتحه الصبا نفاحا",49,"ح",2,0],["وأمطر علمك سحب السماء","ولولاك ما كان يوما مطيرا",50,"ر",2,0],["وأمطرت مزن الرضا كروما","تشفى بعصر خمرها الكاوما",51,"م",2,0],["وأمطرتَ وَبلاً بالمخازنِ قطرُهُ","بموتَِ الأعَادِي بُندُقٌ وسِهَامُ",52,"م",1,0],["وأمْطى من الغرّ الجِيادِ سوابِقاً","محاسِنُها تستوقِفُ المتأمّلا",53,"ل",2,0],["وأمطت النقاب عن وجنة ال","ورد فقبّلنها ثغور الأقاح",54,"ح",1,0],["وأمطرني وبلا فأيقنت أنه","إلى قبة الأفلاك قد نقل البحرا",55,"ر",2,0],["وامطرها طوغو قنابل ملؤها","هلاك فكانت مثل ما انهل صيب",56,"ب",1,0],["وأمطرنا الغنى سحا ووبلا","ولا تجعل سحابتنا جهاما",57,"م",2,0],["وَأَمطَر الاِنس رَوضات القُلوب وَكَم","أَنشا بِهِن اِرتِياحاً مزق الوَصبا",58,"ب",2,0],["وَأَمطَروا وابِلاً يَشفي أَوامهمُ","وَأَسرَفوا في طَعامِ الحُبِّ ما شَبِعوا",59,"ع",3,0],["وأمطر ثم عن برد وتبر","وأسبل برقه غيثاً صبيبا",60,"ب",2,0],["وأمطلُه العَصرَينِ حَتّى يَملَّني","وَيَرضى بِنِصفِ الدينِ وَالأَنفُ راغِمُ",61,"م",1,1],["وأمطت النقاب عن وجنة","الورد فقبلها ثغور الأقاح",62,"ح",1,0],["وامطرهم وبلا من النبل جونه","إذا سح