,[561,"نحن معاني الوجود فيه","https://www.aldiwan.net/poem33671.html","مخلع البسيط"],[564,"يا رب أنت تجبر الكسيرا","https://www.aldiwan.net/poem27849.html","الرجز"],[576,"أجيرة بيتي ما لكم بكم السهو","https://www.aldiwan.net/poem3636.html","الطويل"],[578,"تذكرت أيام الصبابة والصبا","https://www.aldiwan.net/poem2767.html","الطويل"],[578,"أيا دار في جنات عدن له دار","https://www.aldiwan.net/poem2783.html","الطويل"],[578,"مضى معهم قلبي فلله درره","https://www.aldiwan.net/poem3060.html","الطويل"],[590,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"]],"verses":[["وَلا كُنتَ تَرضى أَن تَصِحَّ بِبَلدَةٍ","إِذا قيلَ عُضوٌ مِن زَمانِكَ فاسِدُ",0,"د",1,0],["ولا كانَ دمْعٌ لا يُطيعُ لمَنْ دَعا","وكمْ بيْنَ عاصٍ في الدّموعِ وطيّعِ",1,"ع",1,0],["وَلاّكَ سُلْطانُ الجَمالِ نُفوسَنا","فاحْكُمْ بِما تَرْضى فنَحْنُ عَبيدُ",2,"د",1,0],["وَلاَ كَمِثْلِ كِتَابِ اللهِ مُعْجِزَةً","تَبْقَى عَلَى الدَّهْرِ إِنْ وَلَّى وَإنْ ذَهَبَا",3,"ب",2,0],["وَلاَ كَيْوسُفَ مَوْلاَنَا الَّذِي كَرُمَتْ","آثَارُهُ وَبَنِيهِ السَّادَةِ النُّجَبَا",3,"ب",2,0],["وَلا كُنتُ فَقعاً نابِتاً بِقَرارَةٍ","وَلَكِنَّني آوي إِلى عَطَنٍ رَحبِ",4,"ب",1,0],["وَلا كَخارِجَةَ الَّذي","وَلِيَ الحَمالَةَ وَالصَبارَه",5,"ر",2,0],["وَلا كُشُفٌ فَنَسأَمَ حَربَ قَومٍ","إِذا أَزَمَت رَحىً لَهُمُ رَحانا",6,"ن",2,0],["وَلّاكَ رَبُّكَ مُلكاً في رِعايَتِهِ","وَمَدَّهُ لَكَ في خِصبٍ وَعُمرانِ",7,"ن",1,0],["ولا كَمِدرى الصَنَاع أُلقِي ف","ي الدِمنَة لا مُصفَح ولا خَشِبُ",8,"ب",1,0],["وَلا كُنتُ أَلقى الأَلفَ زُرقاً عُيونُها","بِسَبعينَ فيهِم كُلَّ أَشأَمَ أَنكَدِ",9,"د",1,0],["وَلا كانَ مِمّا كانَ مِمّا تَقَوَّلوا","عَلَيَّ وَنَثّوا غَيرُ ظَنٍّ مُرَجَّمِ",10,"م",1,0],["ولا كمثليَ في حزنٍ فُجِعتُ به","لكن أعلق صدري فيه بالعُلق",11,"ق",1,0],["ولا كحّلت بمرأى مثله بصري","هذا وقد جبتُ ظهر الأرض أميالا",12,"ل",2,0],["ولا كرمادٍ اشتدت رياحٌ","به عُرْضَ الصَّحاصح فَهْوَ هابِ",13,"ب",1,0],["ولا كُلْثُومٌ المجْمُوعُ فيه","إلى الْخُطَب الرَّسَائلُ والقصيدُ",14,"د",1,0],["ولا كلُّ محتاج إلى ما يشدُّه","يُسَفْسِفُ إلا والوهاءُ له وكْدُ",15,"د",1,0],["ولا كان في استبداده متعمداً","وما كنتُ في الإخلال بالمتعمدِ",16,"د",1,0],["ولأكحُلَنَّك بالسُّها","دِ بما رقدْت وطاب غُمضُك",17,"ك",1,0],["ولأكسونّك من فعالك حلةً","قد زانها التحبير والتسهيمُ",18,"م",1,0],["وَلأَكُن كَالغُرابِ رِزقِيَ في الحَق","لِ وَفي السَفحِ مَجثَمي وَاِضطِرابي",19,"ب",2,0],["وَلأَكُن وَحدي لَها هَدَفاً","وَلتَكُن نَفسي لَها حَطَبا",20,"ب",2,0],["وَلا كانَ وَلا صارَ","وَلا قُلتُم وَلا قُلنا",21,"ن",2,0],["ولا كالعلم يجمع كل شمل","وليس لأمة في الجهل شمل",22,"ل",1,0],["ولا كالمجد ميسورا قريبا","لشعب فيه إقدام وعقل",22,"ل",1,0],["وَلا كُنتِ لِلأَعمى مَشاهِدَ فِتنَةٍ","وَلِلمُقعَدِ العاني مَجالَ وَثابِ",23,"ب",1,0],["وَلا كَرَّمتُ إِلّا وَجهَ حُرٍّ","يُقَلِّدُ قَومَهُ المِنَنَ الرَغابا",24,"ب",2,0],["وَلا كَأُولَئِكَ البُؤَساءِ شاءً","إِذا جَوَّعتَها اِنتَشَرَت ذِئابا",25,"ب",2,0],["وَلا كُتبَ إِلّا المَشرَفِيَّةُ عِندَهُ","وَلا رُسُلٌ إِلّا الخَميسُ العَرَمرَمُ",26,"م",1,0],["ولا كان لي حُكمٌ مطاعٌ أُجِيزهُ","فأُرغِمُ أعدائي وأكبُتُ حُسَّدِي",27,"د",2,0],["وَلا كَسِنانِ بنِ المُشَلَّلِ عِندَما","بَنى هَرَمَيها مِن حِجارَةِ لابِها",28,"ب",3,0],["وَلا كانَ مُختَلَفِ الحالَتَينِ","يَروحُ بِنَفعٍ وَيَغدو بِضَرّ",29,"ر",1,0],["وَلا كَالعَطايا يَشرُفُ النَجمُ ما بَنَت","وَهُنَّ مَنالٌ لِلأَكُفِّ اللَوامِسِ",30,"س",1,0],["وَلا كانَ خَصمي يَومَ طَأطَأتَ ظُلمَهُ","بِنافِعِهِ إِسرافُهُ وَتَحالُطُه",31,"ط",2,0],["وَلّاكُمُ البَغيَ ثُمَّ اِنسابَ نَحوَكُمُ","بِالمَشرَفِيَّةِ فيها الثُكلُ وَالهَبَلُ",32,"ل",1,0],["وَلَأَكتُمَنَّ لَكِ الَّذي اِستَودَعتِني","وَالسِرُّ مُنتَشِرٌ إِذا لَم يُكتَمِ",33,"م",1,0],["وَلا كانَ يَومَ الدَستِ صاحِبَ صَدرِهِ","وَلِلجَيشِ يَومَ الحَربِ مَركَزُ قُطبِهِ",34,"ب",2,0],["وَلا كُنتُ مِمَّن يَكسُرُ الجَفنَ في الوَغى","إِذا أَنا لَم أَغضُضهُ عَن رَأيِ مَحرَمِ",35,"م",1,0],["وَلا كَالعُلى ما لَم يُرَ الشِعرُ بَينَها","فَكَالأَرضِ غُفلاً لَيسَ فيها مَعالِمُ",36,"م",1,0],["وَلا كَشَفَ اللَيلَ النَهارُ وَقَد بَدا","كَما كُشِفَت تِلكَ الشُؤونُ الغَوامِضُ",37,"ض",1,0],["وَلا كِتَابٌ مِنْ حَبِيبٍ أَتَى","وَلا أَخُو صِدْقٍ يَرُدُّ السَّلامْ",38,"م",1,0],["ولا كانوا مقادة أجنبيٍّ","متى وبكيف ما يهوى يقود",39,"د",1,0],["وَلا كَفَّ إِلّا لِلأَميرِ كَريمَةٌ","تَبَسَّمَ فيها النَصلُ عَن مَبسِمِ النَصرِ",40,"ر",1,0],["وَلا كانَ مِن رَيبِ الحَوادِثِ آمِناً","جَناحُكَ إِن أَزمَعتَ لِلطَيَرانِ",41,"ن",1,0],["وَلاكِن أَخو الحَزمِ الَّذي لَيسَ نازِلاً","بِهِ الأَمرُ إِلّا وَهوَ لِلأَمرِ مُبصِرُ",42,"ر",1,0],["ولا كَتَبَ الكتابَ وَلا تَلاه","فيُلْحِدَ في رسالته المُريبُ",43,"ب",1,0],["ولا كِيساً وَضُعْتُ عَلَيْهِ شَمْعاً","ولا بَيتاً وَضَعْتُ عَليْهِ طِينا",44,"ن",2,0],["ولا كلّ مُزْنٍ إذا ما هَمَى","بمُزْنٍ ولا كُلّ يَمٍّ بَيمّ",45,"م",1,0],["ولا كلّ ما في أكُفٍّ نَدىً","ولا كلّ ما في أُنوفٍ شَمَم",45,"م",1,0],["ولا كالليالي ما لَهُنّ مواثِقٌ","ولا كالغواني ما لَهُنّ عُهُود",46,"د",1,0],["ولا كالمُعِزّ ابْنِ النبيّ خليفةً","له اللّهُ بالفضلِ المبينِ شَهِيد",46,"د",1,0],["ولا كابنه أذكى شهاباً بمعركٍ","وأجمحَ في ثِنْي العنانِ وأطمحا",47,"ح",2,0],["وَلا كُنتُ إِلّا كَالَّذي كَشَفَ استَهُ","بِمَرأى عُيونٍ مِن عِدىً وَحَميمِ",48,"م",1,0],["وَلا كَقَومٍ حَديثُ يَومِهِمُ","ما أَكَلوا أَمسَهُم وَما طَبَخوا",49,"خ",3,0],["ولا كَلَّ حَلاَّفٍ تَقَلَّدَ بَيْعَةً","فأَعْظَمَ عَهْدَ اللّهِ ثُمَّ شَراها",50,"ا",3,0],["ولا كان لي دارٌ ولا ربع منزلٍ","وما مسّني من ذاك روع جنان",51,"ن",1,0],["وَلا كضَلالٍ كانَ أَهْدَى لِصَبْوتِي","لَيَالِيَ يَهْدِيني الغَرامُ خِباءَهَا",52,"ا",3,0],["وَلاِكْمتِمَالِ الشَّمْلِ","شَمْلِ الأُسْرَةِ المُمَثَّلِ",53,"ل",1,0],["وَلا كُنتَ مِن زَمَني مَأمَني","إِذا خِفتُ أَيّامَهُ العُظَّظا",54,"ظ",2,0],["ولاَ كُتبَتْ عليهِ لافتاتٌ","ولا يَهدي السُّراةَ به مَنار",55,"ر",1,0],["ولا كون الا للطبيعة انها","لها الضر في أكوانها والمنافع",56,"ع",1,0],["ولا كان دلال المنايا حصانه","ولا باع في سوق الدعاوي ولا اشترى",57,"ر",2,0],["ولا كان لي البدر المعلى مسامراً","وان كنت أعلى منه قدراً واكراما",58,"م",2,0],["ولا كلُّ ما نَهَزَ الناهِزون","من المُمتِعاتِ وما استَنْزَحوا",59,"ح",3,0],["ولا كلُّ ما أمَّلَ الآمِلون","ولا مُخْفِقٌ منهُ ، أو مُنْجَح",59,"ح",1,0],["وَلاّكُمُ البَغيَ ثمّ انساب نَحوَكُم","بالمَشرَفيّةِ فهيا الثُّكْلُ، والهَبَلُ",60,"ل",1,0],["وَلا كَانَ للمَكرُوهِ نَحوَكَ مَذهَبٌ،","وَلاَ لصُرُوفِ الدّهرِ فيكَ نَصِيبُ",61,"ب",1,0],["وَلا كانَ غَزْوُ الرّومِ بَعضَ مآرِبي،","وَهَمّي، وَلا ممّا أُطالِبُهُ الأَجرُ",62,"ر",1,0],["ولا كان قلبي منزل الحقد والأذى","فإنّي رأيت الحقد خزيان متعبا",63,"ب",2,0],["ولأكْتُمَنّ لكِ الّذي اسْتَوْدَعْتِي،","والسّرُّ مُنْتَشِرٌ، إذا لَمْ يُكْتَمِ",64,"م",1,0],["ولا كمصاب القطب يوم تفطرت","قلوب بمعناه لنا وكبود",65,"د",1,0],["ولا كل مولوع يجامله الهوى","ولا كل مأسور الفؤاد مفاداه",66,"ا",2,0],["ولا كلام كشعري","في الحب سحر حلال",67,"ل",1,0],["ولا كنت أكسو النفس ثوب مخاوفي","وأزعجها من حيث تنشي الأمانيا",68,"ي",2,0],["وَلّاكَ حَمدانُ الفَخارَ بِأَسرِهِ","وَأَجَلُّهُ لِبَني أَبي الهَيجاءِ",69,"ا",2,0],["وَلّاكَ مِنها ما تَوَلّى بُرهَةً","وَفَدى حَياتَكَ راضِياً بِحَياتِهِ",70,"ت",2,0],["وَلا كَسبَ إِلّا ما يَقولُ وَما يَنوي","هُوَ المُصطَفى جِدٌّ نَفى الصِّدقُ لَهوَهُ",71,"ه",1,0],["ولا كل منظوم له التاج أحمد","ملوك ولكن شيمة فوق شيمة",72,"ه",1,0],["ولا كظل في بلاد كلما","دنا إلى الإِنسان شبراً فرا",73,"ر",2,0],["وَلَأَكسُوَنَّ عُلاهُ ما لا يَنطَوي","أَبَدَ الزَمانِ وَلا يُلِمُّ بِهِ البِلى",74,"ل",2,0],["وَلا كُلُّ نَبتٍ تُخرِجُ الأَرضُ مَأكَلٌ","وَلا كُلُّ ماءٍ تُبصِرُ العَينُ مَنهَلُ",75,"ل",1,0],["وَلا كانَ هَذا آخِرَ العَهدِ إِنَّني","إِلى اللَهِ في أَن نَلتَقي أَتَوَسَّلُ",75,"ل",1,0],["وَلا كانَ لِلعَلياءِ أُمٌّ وَلا أَبٌ","نِصابٌ وَلا لِلمَكرُماتِ نِظامُ",76,"م",1,0],["وَلا كَالسَيفِ لَو صَدِئَت وَفُلَّت","مَضارِبُهُ عَصاً مِن خَيزُرانِ",77,"ن",1,0],["وَلا كُلُّ مَبهوتٍ سَكوتٍ كأَنَّهُ","مِنًَ العِىِّ مَسدُودٌ عليهِ المَسَامعُ",78,"ع",1,0],["وَلا كيفَ بالهِجرَانِ وَالقَلبُ آلفٌ","وَلاَ كيفَ يَرضَى بالهَوَانِ كَرِيمُ",79,"م",1,0],["وَلا كَوكَباً لِلرُشدِ يُهدى بِرأيهِ","وَلا مَنهلاً للعلمِ يُشفى بِرِيِّهِ",80,"ي",2,0],["ولا كفكفت عني دموع غوادق","تطهر جفني من سواها وتوبتي",81,"ت",2,0],["ولا كلُّ مَن كانَ ذا قوَّةٍ","يناوي الضعيفَ إذا استضعفه",82,"ف",2,0],["ولا كعيون العِين مرضى سقيمةً","تُعاد فتُعدي سقمَها فيعودُ",83,"د",1,0],["ولا كان ابراهيم في الحال ناره","عليه غدت بردا بارض اريضة",84,"ه",1,0],["ولا كان اسماعيل للذبح مذ أتى","مطيعا نجا في الحال من حد مدبة",84,"ه",1,0],["ولا كان لما تله لجبينه","وقد سلما افدي باعظم فدية",84,"ه",1,0],["ولا كان عيسى وهو طفل بمهده","ينبىء عنه قومه بالنبوة",84,"ه",1,0],["ولا كان عن ايوب قد زال ضره","ولا كان اعطى الصبر عند البلية",84,"ه",1,0],["ولا كان حبرا في العلوم مصدرا","يسر بمرآه وينشرح الصدر",85,"ر",1,0],["ولا كان ذو عسر اله اذا أتى","فيثرى ومن يمناه يعتاده اليسر",85,"ر",1,0],["ولا كان قد جادت اياديه بالوفا","ولا كان منها ابحر قد جرت عشر",85,"ر",1,0],["ولا كنت أرجو أن تقول بأننا","حبيبان يطغيان الغرام فنجدهل",86,"ل",1,0],["ولا كانَ دهرٌ بالفراقِ قَطَعْتُه","ولا بُوركت أوقاتُه في مدى البَقَا",87,"ق",2,0],["ولا كجدد ولا كفعل","مثلث الفا مع فتح ما يلى",88,"ل",2,0],["وَلا كَبا يا بَني الرَقيلِ لَكُم","زَنّدٌ وَلا أُزلِقَت لَكُم قَدَمُ",89,"م",1,0],["وَلا كَفِلَت بِالنُجحِ مَسعاةُ طالِبٍ","وَلا صافَحَت كَفَّ الغِنى يَدُ مُجتَدِ",90,"د",1,0],["وَلا كَذَبَت آمالُ راجٍ أَمامَها","شَفيعانِ إِخلاصٌ وَصِدقُ وَلاءِ",91,"ا",2,0],["ولا كان دِيناري مِنَ النُّصحِ بَهرَجاً","لَدَيْهِ ولا بَرْقِي مِنَ الوُدِّ خُلَّبا",92,"ب",2,0],["وَلاَ كَعَهْدِ خَلِيلٍ خِلْتُ خُلَّتَهُ","دَائِمَةً فَبَدَا فِي رَأْسِهَا الشَّمَطُ",93,"ط",1,0],["وَلاَ كَعُبَيْدِ خَالِقِهَا فَتَاهَا","سَلِيلِ ذَوَاتِهَا وَأَبِي عُلاَهَا",94,"ا",3,0],["وَلا كانَ يَلقاني بِوَجهٍ مُقَطَّبٍ","يَرُدُّ سَلامي خِفيَةً حينَ أَجهَرُ",95,"ر",1,0],["وَلا كانَ كُلٌّ مِنهُمُ في مَمالِكٍ","يُعايَنُ كَالأسكَندَرِ البانِيِ السَدِّ",96,"د",1,0],["ولا كائن قد أو هو كائن","سوي بمراد اللَه من غير حاصر",97,"ر",1,0],["ولا كان فيهاه المضيع المسيح","وفي جنبه الباهري الضياء",98,"ا",2,0],["ولا كنا كراماً ان نكسنا","عن الجلى ولا كنا شبابا",99,"ب",2,0],["وَلا كُلُّ مَن قَطَّ اليَراعة كاتب","وَلا كُلّ مَن خَطَّ البَراعة يَشعرُ",100,"ر",1,0],["وَلا كانَت دِماؤُهُمُ وَفاءً","لَنا فيما يُعَدُّ مِنَ العِقابِ",101,"ب",1,0],["ولا كتدفُّقِ الدُّولابِ فيها","رأتْ عينايَ واغترَفَتْ يَدايا",102,"ا",3,0],["وَلا كُنتُ إِلّا غائِباً مِثلَ شاهِدٍ","وَإِن كانَ صَرفُ الدَهرِ يَثني عَزائِمي",103,"م",2,0],["وَلاّكَها اللهُ لمّا أنْ رآك لها","أهْلاً ومَن لم يُوَلِّ اللهُ يَنْعَزِل",104,"ل",1,0],["ولا كاتبٍ إن غِبْتُ عن غيرِ حاجةٍ","وأُجرِيَ مُجْرىَ ألكَنٍ مُتفاصح",105,"ح",1,0],["وَلا كانَ قَصدُ الوَفدِ غُرَّةَ كَوكَبِ","فَلَمّا بَدَت صَلّى عَلَيها وَسَلَّما",106,"م",2,0],["ولا كان ادعى منها وفيها","نبيّاً حين مَخرقَ باليَمامه",107,"م",2,0],["ولا كان أدى شأنها من شتاتها","لبعثٍ شريفٍ من مبانٍ قصية",108,"ه",1,0],["ولا كان مني مِقوَلُ الهجو جارياً","بميدانِه بالقذف والذمِّ والثلب",109,"ب",1,0],["وَلا كُنت أَن لانَت قَناتي لِغامز","وَلو قطَّعت نَحري قَوارض أَغلالي",110,"ل",2,0],["ولا كسب دنيا ولا حسن دين","إذا نظر كسبه تحسف",111,"ف",1,0],["ولا كلُّ الغيومِ تُثير بَرْق","يحرِّك وَمْضُه شَغَفَ الجبالِ",112,"ل",1,0],["ولا كِتابٌ ولا جوابُ","ولا سَلامٌ ولا كَلامُ",113,"م",1,0],["ولا كنت أدري أن في الكفر مثل ذا","وحاشا لمثلي أن يكون مرامي",114,"م",2,0],["ولا كيلة لي من زكاة ولم أذق","لها حبة يوماً ولا لمست يدي",115,"د",2,0],["ولا كإسماعيل من أصحب","صفاته كالشمس لا تحجب",116,"ب",1,0],["ولاّك ما كنتَ أهلاً أن تكونَ له","مُشَيّداً من مباني المجد أركانا",117,"ن",2,0],["ولاّك إفتاءَ الأنام محبّذا","رأيٌ لعَمري إنَّه لسديد",118,"د",1,0],["ولا كرياض الجزع وهي أنيقة","وتفضلها في بهجة وبهاء",119,"ا",2,0],["ولأكثرت فيهم القتل والسَّبْ","يَ ومثّلتهم بها تمثيلا",120,"ل",2,0],["ولا كل فعلينِ قد صُرِّفا","سواءً سواءً على المصْدرِ",121,"ر",1,0],["ولا كَفَتْحٍ غَدَتْ أَعلامُ دعوتِهِ","ترسو بِهِ وَكَثِيبُ الشِّرْكِ يَنْهالُ",122,"ل",1,0],["ولا كَبَني سبيلٍ شَرَّدَتْهُمْ","عن الأَوْطانِ قاضِيَةُ القضاءِ",123,"ا",2,0],["ولا كَوُفودٍ تقبَّلْتَ مِنْهُمْ","وسائِلَ كانوا عَلَيْها شُهودا",124,"د",2,0],["ولأَكْتُبَنْ منها عَلَى صُحُفِ العُلا","غُرَرَ الكِتابِ وغُرَّةَ الكُتَّابِ",125,"ب",1,0],["ولا كَنَدَتْ أَسيافُهُ مُلْكَ كِنْدَةٍ","فَيَتْرُكَ فِي أَركانِ عِزَّتِها وَهْيَا",126,"ي",2,0],["ولا كالتعازي بيننا فهي سنة","فميت يعزي ميتاً فقد ميت",127,"ت",1,0],["ولا كنتُ عبداً لهذا الجمالِ","أراكَ تطالبني بالمحالِ",128,"ل",1,0],["ولا كان قدرُ المال قدرَ انتقامكم","ألا بئس فتْكاتُ الملوك فتكَتُمُ",129,"م",1,0],["ولا كان هذا الشملُ مما يرُوعه","صُدوعٌ ولا ذا الظلُّ مما يُحوَّلُ",130,"ل",1,0],["ولاَّك أمرَ عباده نظراً","منه فما تُدهَى من العزلِ",131,"ل",1,0],["ولا كاتّباع الحِرصِ للمرء خَلَّةً","يدِقُّ عليها العِرضُ وهو جليلُ",132,"ل",1,0],["ولا كضريح أمس هِلْنا ترابَه","على جسدٍ باقي العلا في النَّقا بالي",133,"ل",2,0],["ولا كنتُ قبلَكِ في حاجةٍ","لتحمِلَ عُنْقي لريح يدا",134,"د",2,0],["ولا كامناً في الحيّ أنظرُ سِربَهُ","على خدعة الأَشراكِ كيف أصيدُ",135,"د",1,0],["ولا كان في حكم الوثيقة أن أرى","عليك الثرى كَلاًّ وجسمِيَ رَيِّحُ",136,"ح",1,0],["ولا كذباً طارت به الريح طيرةً","فأقعصه أن طأطأتْ عاصفاتُها",137,"ت",3,0],["ولا كنتُ إلا واحداً من عشيرةٍ","ولا باقياً في الناس إلا ابن ذاهب",138,"ب",1,0],["ولا كعهدك في ابن الصاحب ابتهجت","له المعالي وطالَ الفخرُ والحسَب",139,"ب",1,0],["ولاكنني أوتيت قلبا يميل لل","نصائح وعظا لي وللغير زاجرا",140,"ر",2,0],["ولا كنتُ أهوى القدَّ لدناً مهفهفاً","ولا الظبي مصقولَ الترائب أغيدا",141,"د",2,0],["ولا كَثَرى بغداد في الأرض ِواحَة ٌ","ولا دَجلَة ٌأ ُخرى لها الرُّوحُ تَظمأ ُ!",142,"ا",1,0],["وَلا كُلُّ ذي حِرصٍ يُزادُ بِحِرصِهِ","وَلا كُلُّ راجٍ نَفعَهُ المَرءُ يَنفَعُ",143,"ع",1,0],["ولا كنتُ لولاهما ضَلَّةًً","أديمُ سَنا البارقِ المنجدِ",144,"د",1,0],["ولا كنتُ مِمَّنْ يشتكي جُمْلَةَ الهوى","وتفصيلَهُ لولا أليمُ هوى جُمْلِ",145,"ل",1,0],["ولا كنتُ لولا البينُ أبكي إذا سرتْ","شمالٌ على الجرعاءِ مسكَّيةُ النَّشرِ",146,"ر",1,0],["ولا كنتُ أنضي العيسَ في البيدِ كلَّما","محا خطوُها سطَرا ترفَّعَ عن سَطْرِ",146,"ر",1,0],["ولا كانتْ نياقي في الموامي","سطوراً والخروقُ لهنَّ طَرْسا",147,"س",2,0],["ولا كانَ فيها نجيبٌ يَخُبُّ","برحلي كَلالاً ولا يوُضِعُ",148,"ع",1,0],["ولا كان يَمزَعُ بي نحوَها","فسيحُ الخُطا جَرْشَعٌ قارحُ",149,"ح",1,0],["ولا كرامة بالبرد التي طرأت","ولا مسرة بالنجم الذي طلعا",150,"ع",2,0],["ولا كلُّ عالٍ في الوُجودِ وسافِلٌ","ولا كلُّ مَطْموسٍ وظاهِرُ أَشْكالِ",151,"ل",1,0],["ولا كانَ في ما مضى مكسَبي","وبئسَ البِضاعَةُ للتّاجِر",152,"ر",1,0],["ولا كان ذاك العذل إلا نصيحةً","ولا ذلك الأغضاء إلا تهيبا",153,"ب",2,0],["ولاكففت الغرب من مقول","أمضى إذا شئت من المعضب",154,"ب",1,0],["ولا كرمن عن مناخ جعجع","يفحصن فيه الأرض بالكراكر",155,"ر",1,0],["ولا كانَ مَصْحُوباً مَشُوباً بِبِدْعَةٍ","يَصِيرُ بها لَحْظُ الشّرِيعَةِ أَرْمَدا",156,"د",2,0],["ولا كَالأُلى في العالَمِين تَمَيَّزوا","بَنكثِ عُهودٍ عاهَدوها وأقسَموا",157,"م",3,0],["ولا كنتُ ممّنْ يرى سيّئاً","بغيري ومقلتُهُ لا تراني",158,"ن",2,0],["ولا كان منّا غيرُ حائمِ قفرةٍ","يلوذ على حرّ الصَّدى بحيامِ",159,"م",1,0],["ولا كانَ إلّا ناجياً من عَضِيهَةٍ","ولا ساعِياً إلّا بطرق الفضائلِ",160,"ل",1,0],["ولا كنتُ أحفل في بلدةٍ","مقيماً بمُستَوْفِزٍ راحلِ",161,"ل",1,0],["وَلا كانَ لِي إلّا عليك إقامةٌ","وَلا كانَ لِي إِلّا برَبْعِك مَرْبَعُ",162,"ع",1,0],["وَلا كانَت منَ الزّمن المُلَحَّى","مَراتبُكُم بِه إلّا سُفاطا",163,"ط",2,0],["وَلا كانَ هادِم ما يبتنيه","وقالعُ أغراسهِ غارسا",164,"س",2,0],["وَلا كنتُمُ إلّا كَما تَكرهونَهُ","وَلا اِعتادَكمْ نوءٌ من الرّزق راجسُ",165,"س",1,0],["ولا كنتُ يوماً للهوانِ مصافياً","ولا بين أبياتِ اللّئام قراري",166,"ر",2,0],["وَلا كَساكمْ بَعد أَن كنتُمُ","بلا رِياشٍ حِبَرَ الفَخرِ",167,"ر",1,0],["ولا كانوا لكلِّ النّا","سِ إلّا موضعَ القُطبِ",168,"ب",1,0],["ولا كبير ولا صغير","ولا حليم ولا سفيه",169,"ي",2,0],["وَلا كَراءً يَقطَعُ الظُهورا","ظَلَّت تُصادي يَومَها الحَرورا",170,"ر",2,0],["وَلا كَهَذا فَليَهوَ مَن كانَ ذا هَوى","وَإِلّا فَحُبُّ الناسِ أَكثَرهُ لَهوُ",171,"و",1,0],["ولا كان قَلْبي بالهموم مُكَحَّلاَ","ولا كَانَ طرْفي بالدِّماءِ مخضَّبا",172,"ب",2,0],["ولا كان جسمِي من هُزالي مُخْصِباً","ولا كان خَدِّي من شُحوبيَ مُعْشِبَا",172,"ب",2,0],["ولا كوكب إِلا بسعدي طالع","ولا فَلَكٌ إِلاَّ بِقَصدِيَ دَوَّار",173,"ر",1,0],["ولا كنتُ إِلاَّ مَنْ يُقارِعِ دَهْرَه","قِراعاً إِلى أَنْ يَسْأَلَ الصُّلحَ دَهرُه",174,"ر",2,0],["ولا كان هذا شأنه وصنيعه","ولا كان هذا حاله حين يضرب",175,"ب",1,0]]}