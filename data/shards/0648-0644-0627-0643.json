{"poems":[[53,"نصافي المعالي والزمان معاند","https://www.aldiwan.net/poem30627.html","الطويل"],[77,"لعل خيالا منك يطرق مضجعي","https://www.aldiwan.net/poem35993.html","الطويل"],[77,"الصبر إلا في هواك حميد","https://www.aldiwan.net/poem36607.html","الكامل"],[77,"الحمد لله موصولا كما وجبا","https://www.aldiwan.net/poem36772.html","البسيط"],[42,"ما ولدت أمي من القوم عاجزا","https://www.aldiwan.net/poem50408.html","الطويل"],[9,"يا جارتي ما كنت جاره","https://www.aldiwan.net/poem21939.html","مجزوء الكامل"],[9,"ألا من مبلغ عني حريثا","https://www.aldiwan.net/poem21987.html","الوافر"],[86,"طف بالأريكة ذات العز والشان","https://www.aldiwan.net/poem68949.html","البسيط"],[37,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[47,"دعوتك للجفن القريح المسهد","https://www.aldiwan.net/poem25322.html","الطويل"],[23,"لمن منزل عاف كأن رسومه","https://www.aldiwan.net/poem21242.html","الطويل"],[72,"أبكيك للحسنين الخلق والخلق","https://www.aldiwan.net/poem19356.html","البسيط"],[72,"يا صاحبي أرانا الدهر شوالا","https://www.aldiwan.net/poem20547.html","البسيط"],[51,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[51,"يعان المستعين بك البعيد","https://www.aldiwan.net/poem10001.html","الوافر"],[51,"لك الطائر الميمون والطالع السعد","https://www.aldiwan.net/poem10887.html","الطويل"],[51,"هنيئا مريئا غير داء مخامر","https://www.aldiwan.net/poem61856.html","الطويل"],[51,"يا خالد ابن الخالدات","https://www.aldiwan.net/poem65801.html","مجزوء الكامل"],[51,"لأمورك التكميل والتتميم","https://www.aldiwan.net/poem66061.html","الكامل"],[91,"سئمت نفسي الحياة مع الناس","https://www.aldiwan.net/poem8747.html","عموديه"],[91,"رضيت نفسي بقسمتها","https://www.aldiwan.net/poem8760.html","عموديه"],[70,"من اليوم تعارفنا","https://www.aldiwan.net/poem42673.html","الهزج"],[85,"حبيبك من تحب ومن تجل","https://www.aldiwan.net/poem7574.html","الوافر"],[85,"سماؤك يا دنيا خداع سراب","https://www.aldiwan.net/poem62924.html","الطويل"],[85,"سلو قلبي غداة سلا وثابا","https://www.aldiwan.net/poem63783.html","الوافر"],[85,"أنادي الرسم لو ملك الجوابا","https://www.aldiwan.net/poem63784.html","الوافر"],[43,"إذا كان مدح فالنسيب المقدم","https://www.aldiwan.net/poem10143.html","الطويل"],[62,"أبى الله أن أسمو بغير فضائلي","https://www.aldiwan.net/poem52453.html","الطويل"],[45,"معاد من الأيام تعذيبنا بها","https://www.aldiwan.net/poem10908.html","الطويل"],[45,"تبسم عن واضح ذي أشر","https://www.aldiwan.net/poem63557.html","المتقارب"],[45,"يشوقك توخيد الجمال القناعس","https://www.aldiwan.net/poem64574.html","الطويل"],[45,"أمن أجل أن أقوى الغوير فواسطه","https://www.aldiwan.net/poem64650.html","الطويل"],[45,"لا دمنة بلوى خبت ولا طلل","https://www.aldiwan.net/poem65579.html","البسيط"],[28,"وبواضح رتل تشف غروبه","https://www.aldiwan.net/poem5543.html","الكامل"],[66,"هو الدهر مغرى بالكريم وسلبه","https://www.aldiwan.net/poem40134.html","الطويل"],[66,"لئن لم أبرقع بالحيا وجه عفتي","https://www.aldiwan.net/poem41571.html","الطويل"],[44,"ألم يأن أن تروى الظماء الحوائم","https://www.aldiwan.net/poem30365.html","الطويل"],[44,"مهاة النقا لولا الشوى والمآبض","https://www.aldiwan.net/poem30473.html","الطويل"],[87,"يا ناعس الطرف إلى كم تنام","https://www.aldiwan.net/poem8287.html","السريع"],[90,"أعيذك أن يعاصيك القصيد","https://www.aldiwan.net/poem60159.html","عموديه"],[74,"أما والتفات الروض عن أزرق النهر","https://www.aldiwan.net/poem12954.html","الطويل"],[33,"ألا يا غرابا صاح من نحو أرضها","https://www.aldiwan.net/poem25778.html","الطويل"],[13,"إذا المرء لم يحتل وقد جد جده","https://www.aldiwan.net/poem2226.html","الطويل"],[67,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[67,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[75,"أما والمذاكي يلكن الشكم","https://www.aldiwan.net/poem69039.html","المتقارب"],[75,"ألا طرقتنا والنجوم ركود","https://www.aldiwan.net/poem69091.html","الطويل"],[75,"أنظلم أن شمنا بوارق لمحا","https://www.aldiwan.net/poem69094.html","الطويل"],[48,"أهاشم خذ مني رضاك وإن أتى","https://www.aldiwan.net/poem65270.html","الطويل"],[46,"لا يفقدن خيركم مجالسكم","https://www.aldiwan.net/poem22307.html","المنسرح"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72229","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147465","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30434","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55172","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43727","المتقارب"],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[90,"صحو بعد سكر","https://www.poetsgate.com/ViewPoem.aspx?id=178933",""],[90,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=179239",""],[45,"لا دِمنَةٌ بلِوَى خَبتٍ، وَلا طَلَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32200",""],[45,"لتهَنئً أميرَ المؤمنينَ عَطيّةً","https://www.poetsgate.com/ViewPoem.aspx?id=31553",""],[45,"عَلَيكَ السَلامٌ، أيّها القَمَرُ البَدْرُ،","https://www.poetsgate.com/ViewPoem.aspx?id=31254",""],[28,"يا أخت ناجية بن سامة إنني","https://www.poetsgate.com/ViewPoem.aspx?id=21038",""]],"verses":[["وَلا كُنتَ تَرضى أَن تَصِحَّ بِبَلدَةٍ","إِذا قيلَ عُضوٌ مِن زَمانِكَ فاسِدُ",0,"د",1,0],["ولا كانَ دمْعٌ لا يُطيعُ لمَنْ دَعا","وكمْ بيْنَ عاصٍ في الدّموعِ وطيّعِ",1,"ع",1,0],["وَلاّكَ سُلْطانُ الجَمالِ نُفوسَنا","فاحْكُمْ بِما تَرْضى فنَحْنُ عَبيدُ",2,"د",1,0],["وَلاَ كَمِثْلِ كِتَابِ اللهِ مُعْجِزَةً","تَبْقَى عَلَى الدَّهْرِ إِنْ وَلَّى وَإنْ ذَهَبَا",3,"ب",2,0],["وَلاَ كَيْوسُفَ مَوْلاَنَا الَّذِي كَرُمَتْ","آثَارُهُ وَبَنِيهِ السَّادَةِ النُّجَبَا",3,"ب",2,0],["وَلا كُنتُ فَقعاً نابِتاً بِقَرارَةٍ","وَلَكِنَّني آوي إِلى عَطَنٍ رَحبِ",4,"ب",1,0],["وَلا كَخارِجَةَ الَّذي","وَلِيَ الحَمالَةَ وَالصَبارَه",5,"ر",2,0],["وَلا كُشُفٌ فَنَسأَمَ حَربَ قَومٍ","إِذا أَزَمَت رَحىً لَهُمُ رَحانا",6,"ن",2,0],["وَلّاكَ رَبُّكَ مُلكاً في رِعايَتِهِ","وَمَدَّهُ لَكَ في خِصبٍ وَعُمرانِ",7,"ن",1,0],["ولا كَمِدرى الصَنَاع أُلقِي ف","ي الدِمنَة لا مُصفَح ولا خَشِبُ",8,"ب",1,0],["وَلا كُنتُ أَلقى الأَلفَ زُرقاً عُيونُها","بِسَبعينَ فيهِم كُلَّ أَشأَمَ أَنكَدِ",9,"د",1,0],["وَلا كانَ مِمّا كانَ مِمّا تَقَوَّلوا","عَلَيَّ وَنَثّوا غَيرُ ظَنٍّ مُرَجَّمِ",10,"م",1,0],["ولا كمثليَ في حزنٍ فُجِعتُ به","لكن أعلق صدري فيه بالعُلق",11,"ق",1,0],["ولا كحّلت بمرأى مثله بصري","هذا وقد جبتُ ظهر الأرض أميالا",12,"ل",2,0],["ولا كرمادٍ اشتدت رياحٌ","به عُرْضَ الصَّحاصح فَهْوَ هابِ",13,"ب",1,0],["ولا كُلْثُومٌ المجْمُوعُ فيه","إلى الْخُطَب الرَّسَائلُ والقصيدُ",14,"د",1,0],["ولا كلُّ محتاج إلى ما يشدُّه","يُسَفْسِفُ إلا والوهاءُ له وكْدُ",15,"د",1,0],["ولا كان في استبداده متعمداً","وما كنتُ في الإخلال بالمتعمدِ",16,"د",1,0],["ولأكحُلَنَّك بالسُّها","دِ بما رقدْت وطاب غُمضُك",17,"ك",1,0],["ولأكسونّك من فعالك حلةً","قد زانها التحبير والتسهيمُ",18,"م",1,0],["وَلأَكُن كَالغُرابِ رِزقِيَ في الحَق","لِ وَفي السَفحِ مَجثَمي وَاِضطِرابي",19,"ي",1,0],["وَلأَكُن وَحدي لَها هَدَفاً","وَلتَكُن نَفسي لَها حَطَبا",20,"ب",2,0],["وَلا كانَ وَلا صارَ","وَلا قُلتُم وَلا قُلنا",21,"ن",2,0],["ولا كالعلم يجمع كل شمل","وليس لأمة في الجهل شمل",22,"ل",1,0],["ولا كالمجد ميسورا قريبا","لشعب فيه إقدام وعقل",22,"ل",1,0],["وَلا كُنتِ لِلأَعمى مَشاهِدَ فِتنَةٍ","وَلِلمُقعَدِ العاني مَجالَ وَثابِ",23,"ب",1,0],["وَلا كَرَّمتُ إِلّا وَجهَ حُرٍّ","يُقَلِّدُ قَومَهُ المِنَنَ الرَغابا",24,"ب",2,0],["وَلا كَأُولَئِكَ البُؤَساءِ شاءً","إِذا جَوَّعتَها اِنتَشَرَت ذِئابا",25,"ب",2,0],["وَلا كُتبَ إِلّا المَشرَفِيَّةُ عِندَهُ","وَلا رُسُلٌ إِلّا الخَميسُ العَرَمرَمُ",26,"م",1,0],["ولا كان لي حُكمٌ مطاعٌ أُجِيزهُ","فأُرغِمُ أعدائي وأكبُتُ حُسَّدِي",27,"ي",1,0],["وَلا كَسِنانِ بنِ المُشَلَّلِ عِندَما","بَنى هَرَمَيها مِن حِجارَةِ لابِها",28,"ب",3,0],["وَلا كانَ مُختَلَفِ الحالَتَينِ","يَروحُ بِنَفعٍ وَيَغدو بِضَرّ",29,"ر",1,0],["وَلا كَالعَطايا يَشرُفُ النَجمُ ما بَنَت","وَهُنَّ مَنالٌ لِلأَكُفِّ اللَوامِسِ",30,"س",1,0],["وَلا كانَ خَصمي يَومَ طَأطَأتَ ظُلمَهُ","بِنافِعِهِ إِسرافُهُ وَتَحالُطُه",31,"ط",2,0],["وَلّاكُمُ البَغيَ ثُمَّ اِنسابَ نَحوَكُمُ","بِالمَشرَفِيَّةِ فيها الثُكلُ وَالهَبَلُ",32,"ل",1,0],["وَلَأَكتُمَنَّ لَكِ الَّذي اِستَودَعتِني","وَالسِرُّ مُنتَشِرٌ إِذا لَم يُكتَمِ",33,"م",1,0],["وَلا كانَ يَومَ الدَستِ صاحِبَ صَدرِهِ","وَلِلجَيشِ يَومَ الحَربِ مَركَزُ قُطبِهِ",34,"ب",2,0],["وَلا كُنتُ مِمَّن يَكسُرُ الجَفنَ في الوَغى","إِذا أَنا لَم أَغضُضهُ عَن رَأيِ مَحرَمِ",35,"م",1,0],["وَلا كَالعُلى ما لَم يُرَ الشِعرُ بَينَها","فَكَالأَرضِ غُفلاً لَيسَ فيها مَعالِمُ",36,"م",1,0],["وَلا كَشَفَ اللَيلَ النَهارُ وَقَد بَدا","كَما كُشِفَت تِلكَ الشُؤونُ الغَوامِضُ",37,"ض",1,0],["وَلا كِتَابٌ مِنْ حَبِيبٍ أَتَى","وَلا أَخُو صِدْقٍ يَرُدُّ السَّلامْ",38,"م",1,0],["ولا كانوا مقادة أجنبيٍّ","متى وبكيف ما يهوى يقود",39,"د",1,0],["وَلا كَفَّ إِلّا لِلأَميرِ كَريمَةٌ","تَبَسَّمَ فيها النَصلُ عَن مَبسِمِ النَصرِ",40,"ر",1,0],["وَلا كانَ مِن رَيبِ الحَوادِثِ آمِناً","جَناحُكَ إِن أَزمَعتَ لِلطَيَرانِ",41,"ن",1,0],["وَلاكِن أَخو الحَزمِ الَّذي لَيسَ نازِلاً","بِهِ الأَمرُ إِلّا وَهوَ لِلأَمرِ مُبصِرُ",42,"ر",1,0],["ولا كَتَبَ الكتابَ وَلا تَلاه","فيُلْحِدَ في رسالته المُريبُ",43,"ب",1,0],["ولا كِيساً وَضُعْتُ عَلَيْهِ شَمْعاً","ولا بَيتاً وَضَعْتُ عَليْهِ طِينا",44,"ن",2,0],["ولا كلّ مُزْنٍ إذا ما هَمَى","بمُزْنٍ ولا كُلّ يَمٍّ بَيمّ",45,"م",1,0],["ولا كلّ ما في أكُفٍّ نَدىً","ولا كلّ ما في أُنوفٍ شَمَم",45,"م",1,0],["ولا كالليالي ما لَهُنّ مواثِقٌ","ولا كالغواني ما لَهُنّ عُهُود",46,"د",1,0],["ولا كالمُعِزّ ابْنِ النبيّ خليفةً","له اللّهُ بالفضلِ المبينِ شَهِيد",46,"د",1,0],["ولا كابنه أذكى شهاباً بمعركٍ","وأجمحَ في ثِنْي العنانِ وأطمحا",47,"ح",2,0],["وَلا كُنتُ إِلّا كَالَّذي كَشَفَ استَهُ","بِمَرأى عُيونٍ مِن عِدىً وَحَميمِ",48,"م",1,0],["وَلا كَقَومٍ حَديثُ يَومِهِمُ","ما أَكَلوا أَمسَهُم وَما طَبَخوا",49,"خ",3,0],["ولا كَلَّ حَلاَّفٍ تَقَلَّدَ بَيْعَةً","فأَعْظَمَ عَهْدَ اللّهِ ثُمَّ شَراها",50,"ا",3,0],["ولا كان لي دارٌ ولا ربع منزلٍ","وما مسّني من ذاك روع جنان",51,"ن",1,0],["وَلا كضَلالٍ كانَ أَهْدَى لِصَبْوتِي","لَيَالِيَ يَهْدِيني الغَرامُ خِباءَهَا",52,"ا",3,0],["وَلاِكْمتِمَالِ الشَّمْلِ","شَمْلِ الأُسْرَةِ المُمَثَّلِ",53,"ل",1,0],["وَلا كُنتَ مِن زَمَني مَأمَني","إِذا خِفتُ أَيّامَهُ العُظَّظا",54,"ظ",2,0],["ولاَ كُتبَتْ عليهِ لافتاتٌ","ولا يَهدي السُّراةَ به مَنار",55,"ر",1,0],["ولا كان لي البدر المعلى مسامراً","وان كنت أعلى منه قدراً واكراما",56,"م",2,0],["ولا كلُّ ما نَهَزَ الناهِزون","من المُمتِعاتِ وما استَنْزَحوا",57,"ح",3,0],["ولا كلُّ ما أمَّلَ الآمِلون","ولا مُخْفِقٌ منهُ ، أو مُنْجَح",57,"ح",1,0],["وَلاّكُمُ البَغيَ ثمّ انساب نَحوَكُم","بالمَشرَفيّةِ فهيا الثُّكْلُ، والهَبَلُ",58,"ل",1,0],["وَلا كَانَ للمَكرُوهِ نَحوَكَ مَذهَبٌ،","وَلاَ لصُرُوفِ الدّهرِ فيكَ نَصِيبُ",59,"ب",1,0],["وَلا كانَ غَزْوُ الرّومِ بَعضَ مآرِبي،","وَهَمّي، وَلا ممّا أُطالِبُهُ الأَجرُ",60,"ر",1,0],["ولأكْتُمَنّ لكِ الّذي اسْتَوْدَعْتِي،","والسّرُّ مُنْتَشِرٌ، إذا لَمْ يُكْتَمِ",61,"م",1,0]]}