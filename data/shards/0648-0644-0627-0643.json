ضى معهم قلبي فلله درره","https://www.aldiwan.net/poem3060.html","الطويل"],[585,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"]],"verses":[["وَلا كُنتَ تَرضى أَن تَصِحَّ بِبَلدَةٍ","إِذا قيلَ عُضوٌ مِن زَمانِكَ فاسِدُ",0,"د",1,0],["ولا كانَ دمْعٌ لا يُطيعُ لمَنْ دَعا","وكمْ بيْنَ عاصٍ في الدّموعِ وطيّعِ",1,"ع",1,0],["وَلاّكَ سُلْطانُ الجَمالِ نُفوسَنا","فاحْكُمْ بِما تَرْضى فنَحْنُ عَبيدُ",2,"د",1,0],["وَلاَ كَمِثْلِ كِتَابِ اللهِ مُعْجِزَةً","تَبْقَى عَلَى الدَّهْرِ إِنْ وَلَّى وَإنْ ذَهَبَا",3,"ب",2,0],["وَلاَ كَيْوسُفَ مَوْلاَنَا الَّذِي كَرُمَتْ","آثَارُهُ وَبَنِيهِ السَّادَةِ النُّجَبَا",3,"ب",2,0],["وَلا كُنتُ فَقعاً نابِتاً بِقَرارَةٍ","وَلَكِنَّني آوي إِلى عَطَنٍ رَحبِ",4,"ب",1,0],["وَلا كَخارِجَةَ الَّذي","وَلِيَ الحَمالَةَ وَالصَبارَه",5,"ر",2,0],["وَلا كُشُفٌ فَنَسأَمَ حَربَ قَومٍ","إِذا أَزَمَت رَحىً لَهُمُ رَحانا",6,"ن",2,0],["وَلّاكَ رَبُّكَ مُلكاً في رِعايَتِهِ","وَمَدَّهُ لَكَ في خِصبٍ وَعُمرانِ",7,"ن",1,0],["ولا كَمِدرى الصَنَاع أُلقِي ف","ي الدِمنَة لا مُصفَح ولا خَشِبُ",8,"ب",1,0],["وَلا كُنتُ أَلقى الأَلفَ زُرقاً عُيونُها","بِسَبعينَ فيهِم كُلَّ أَشأَمَ أَنكَدِ",9,"د",1,0],["وَلا كانَ مِمّا كانَ مِمّا تَقَوَّلوا","عَلَيَّ وَنَثّوا غَيرُ ظَنٍّ مُرَجَّمِ",10,"م",1,0],["ولا كمثليَ في حزنٍ فُجِعتُ به","لكن أعلق صدري فيه بالعُلق",11,"ق",1,0],["ولا كحّلت بمرأى مثله بصري","هذا وقد جبتُ ظهر الأرض أميالا",12,"ل",2,0],["ولا كرمادٍ اشتدت رياحٌ","به عُرْضَ الصَّحاصح فَهْوَ هابِ",13,"ب",1,0],["ولا كُلْثُومٌ المجْمُوعُ فيه","إلى الْخُطَب الرَّسَائلُ والقصيدُ",14,"د",1,0],["ولا كلُّ محتاج إلى ما يشدُّه","يُسَفْسِفُ إلا والوهاءُ له وكْدُ",15,"د",1,0],["ولا كان في استبداده متعمداً","وما كنتُ في الإخلال بالمتعمدِ",16,"د",1,0],["ولأكحُلَنَّك بالسُّها","دِ بما رقدْت وطاب غُمضُك",17,"ك",1,0],["ولأكسونّك من فعالك حلةً","قد زانها التحبير والتسهيمُ",18,"م",1,0],["وَلأَكُن كَالغُرابِ رِزقِيَ في الحَق","لِ وَفي السَفحِ مَجثَمي وَاِضطِرابي",19,"ي",1,0],["وَلأَكُن وَحدي لَها هَدَفاً","وَلتَكُن نَفسي لَها حَطَبا",20,"ب",2,0],["وَلا كانَ وَلا صارَ","وَلا قُلتُم وَلا قُلنا",21,"ن",2,0],["ولا كالعلم يجمع كل شمل","وليس لأمة في الجهل شمل",22,"ل",1,0],["ولا كالمجد ميسورا قريبا","لشعب فيه إقدام وعقل",22,"ل",1,0],["وَلا كُنتِ لِلأَعمى مَشاهِدَ فِتنَةٍ","وَلِلمُقعَدِ العاني مَجالَ وَثابِ",23,"ب",1,0],["وَلا كَرَّمتُ إِلّا وَجهَ حُرٍّ","يُقَلِّدُ قَومَهُ المِنَنَ الرَغابا",24,"ب",2,0],["وَلا كَأُولَئِكَ البُؤَساءِ شاءً","إِذا جَوَّعتَها اِنتَشَرَت ذِئابا",25,"ب",2,0],["وَلا كُتبَ إِلّا المَشرَفِيَّةُ عِندَهُ","وَلا رُسُلٌ إِلّا الخَميسُ العَرَمرَمُ",26,"م",1,0],["ولا كان لي حُكمٌ مطاعٌ أُجِيزهُ","فأُرغِمُ أعدائي وأكبُتُ حُسَّدِي",27,"ي",1,0],["وَلا كَسِنانِ بنِ المُشَلَّلِ عِندَما","بَنى هَرَمَيها مِن حِجارَةِ لابِها",28,"ب",3,0],["وَلا كانَ مُختَلَفِ الحالَتَينِ","يَروحُ بِنَفعٍ وَيَغدو بِضَرّ",29,"ر",1,0],["وَلا كَالعَطايا يَشرُفُ النَجمُ ما بَنَت","وَهُنَّ مَنالٌ لِلأَكُفِّ اللَوامِسِ",30,"س",1,0],["وَلا كانَ خَصمي يَومَ طَأطَأتَ ظُلمَهُ","بِنافِعِهِ إِسرافُهُ وَتَحالُطُه",31,"ط",2,0],["وَلّاكُمُ البَغيَ ثُمَّ اِنسابَ نَحوَكُمُ","بِالمَشرَفِيَّةِ فيها الثُكلُ وَالهَبَلُ",32,"ل",1,0],["وَلَأَكتُمَنَّ لَكِ الَّذي اِستَودَعتِني","وَالسِرُّ مُنتَشِرٌ إِذا لَم يُكتَمِ",33,"م",1,0],["وَلا كانَ يَومَ الدَستِ صاحِبَ صَدرِهِ","وَلِلجَيشِ يَومَ الحَربِ مَركَزُ قُطبِهِ",34,"ب",2,0],["وَلا كُنتُ مِمَّن يَكسُرُ الجَفنَ في الوَغى","إِذا أَنا لَم أَغضُضهُ عَن رَأيِ مَحرَمِ",35,"م",1,0],["وَلا كَالعُلى ما لَم يُرَ الشِعرُ بَينَها","فَكَالأَرضِ غُفلاً لَيسَ فيها مَعالِمُ",36,"م",1,0],["وَلا كَشَفَ اللَيلَ النَهارُ وَقَد بَدا","كَما كُشِفَت تِلكَ الشُؤونُ الغَوامِضُ",37,"ض",1,0],["وَلا كِتَابٌ مِنْ حَبِيبٍ أَتَى","وَلا أَخُو صِدْقٍ يَرُدُّ السَّلامْ",38,"م",1,0],["ولا كانوا مقادة أجنبيٍّ","متى وبكيف ما يهوى يقود",39,"د",1,0],["وَلا كَفَّ إِلّا لِلأَميرِ كَريمَةٌ","تَبَسَّمَ فيها النَصلُ عَن مَبسِمِ النَصرِ",40,"ر",1,0],["وَلا كانَ مِن رَيبِ الحَوادِثِ آمِناً","جَناحُكَ إِن أَزمَعتَ لِلطَيَرانِ",41,"ن",1,0],["وَلاكِن أَخو الحَزمِ الَّذي لَيسَ نازِلاً","بِهِ الأَمرُ إِلّا وَهوَ لِلأَمرِ مُبصِرُ",42,"ر",1,0],["ولا كَتَبَ الكتابَ وَلا تَلاه","فيُلْحِدَ في رسالته المُريبُ",43,"ب",1,0],["ولا كِيساً وَضُعْتُ عَلَيْهِ شَمْعاً","ولا بَيتاً وَضَعْتُ عَليْهِ طِينا",44,"ن",2,0],["ولا كلّ مُزْنٍ إذا ما هَمَى","بمُزْنٍ ولا كُلّ يَمٍّ بَيمّ",45,"م",1,0],["ولا كلّ ما في أكُفٍّ نَدىً","ولا كلّ ما في أُنوفٍ شَمَم",45,"م",1,0],["ولا كالليالي ما لَهُنّ مواثِقٌ","ولا كالغواني ما لَهُنّ عُهُود",46,"د",1,0],["ولا كالمُعِزّ ابْنِ النبيّ خليفةً","له اللّهُ بالفضلِ المبينِ شَهِيد",46,"د",1,0],["ولا كابنه أذكى شهاباً بمعركٍ","وأجمحَ في ثِنْي العنانِ وأطمحا",47,"ح",2,0],["وَلا كُنتُ إِلّا كَالَّذي كَشَفَ استَهُ","بِمَرأى عُيونٍ مِن عِدىً وَحَميمِ",48,"م",1,0],["وَلا كَقَومٍ حَديثُ يَومِهِمُ","ما أَكَلوا أَمسَهُم وَما طَبَخوا",49,"خ",3,0],["ولا كَلَّ حَلاَّفٍ تَقَلَّدَ بَيْعَةً","فأَعْظَمَ عَهْدَ اللّهِ ثُمَّ شَراها",50,"ا",3,0],["ولا كان لي دارٌ ولا ربع منزلٍ","وما مسّني من ذاك روع جنان",51,"ن",1,0],["وَلا كضَلالٍ كانَ أَهْدَى لِصَبْوتِي","لَيَالِيَ يَهْدِيني الغَرامُ خِباءَهَا",52,"ا",3,0],["وَلاِكْمتِمَالِ الشَّمْلِ","شَمْلِ الأُسْرَةِ المُمَثَّلِ",53,"ل",1,0],["وَلا كُنتَ مِن زَمَني مَأمَني","إِذا خِفتُ أَيّامَهُ العُظَّظا",54,"ظ",2,0],["ولاَ كُتبَتْ عليهِ لافتاتٌ","ولا يَهدي السُّراةَ به مَنار",55,"ر",1,0],["ولا كان لي البدر المعلى مسامراً","وان كنت أعلى منه قدراً واكراما",56,"م",2,0],["ولا كلُّ ما نَهَزَ الناهِزون","من المُمتِعاتِ وما استَنْزَحوا",57,"ح",3,0],["ولا كلُّ ما أمَّلَ الآمِلون","ولا مُخْفِقٌ منهُ ، أو مُنْجَح",57,"ح",1,0],["وَلاّكُمُ البَغيَ ثمّ انساب نَحوَكُم","بالمَشرَفيّةِ فهيا الثُّكْلُ، والهَبَلُ",58,"ل",1,0],["وَلا كَانَ للمَكرُوهِ نَحوَكَ مَذهَبٌ،","وَلاَ لصُرُوفِ الدّهرِ فيكَ نَصِيبُ",59,"ب",1,0],["وَلا كانَ غَزْوُ الرّومِ بَعضَ مآرِبي،","وَهَمّي، وَلا ممّا أُطالِبُهُ الأَجرُ",60,"ر",1,0],["ولأكْتُمَنّ لكِ الّذي اسْتَوْدَعْتِي،","والسّرُّ مُنْتَشِرٌ، إذا لَمْ يُكْتَمِ",61,"م",1,0],["ولا كل مولوع يجامله الهوى","ولا كل مأسور الفؤاد مفاداه",62,"ا",2,0],["ولا كلام كشعري","في الحب سحر حلال",63,"ل",1,0],["ولا كنت أكسو النفس ثوب مخاوفي","وأزعجها من حيث تنشي الأمانيا",64,"ي",2,0],["وَلّاكَ حَمدانُ الفَخارَ بِأَسرِهِ","وَأَجَلُّهُ لِبَني أَبي الهَيجاءِ",65,"ا",2,0],["وَلّاكَ مِنها ما تَوَلّى بُرهَةً","وَفَدى حَياتَكَ راضِياً بِحَياتِهِ",66,"ت",2,0],["وَلا كَسبَ إِلّا ما يَقولُ وَما يَنوي","هُوَ المُصطَفى جِدٌّ نَفى الصِّدقُ لَهوَهُ",67,"ه",1,0],["ولا كل منظوم له التاج أحمد","ملوك ولكن شيمة فوق شيمة",68,"ه",1,0],["ولا كظل في بلاد كلما","دنا إلى الإِنسان شبراً فرا",69,"ر",2,0],["وَلَأَكسُوَنَّ عُلاهُ ما لا يَنطَوي","أَبَدَ الزَمانِ وَلا يُلِمُّ بِهِ البِلى",70,"ل",2,0],["وَلا كُلُّ نَبتٍ تُخرِجُ الأَرضُ مَأكَلٌ","وَلا كُلُّ ماءٍ تُبصِرُ العَينُ مَنهَلُ",71,"ل",1,0],["وَلا كانَ هَذا آخِرَ العَهدِ إِنَّني","إِلى اللَهِ في أَن نَلتَقي أَتَوَسَّلُ",71,"ل",1,0],["وَلا كانَ لِلعَلياءِ أُمٌّ وَلا أَبٌ","نِصابٌ وَلا لِلمَكرُماتِ نِظامُ",72,"م",1,0],["وَلا كَالسَيفِ لَو صَدِئَت وَفُلَّت","مَضارِبُهُ عَصاً مِن خَيزُرانِ",73,"ن",1,0],["وَلا كُلُّ مَبهوتٍ سَكوتٍ كأَنَّهُ","مِنًَ العِىِّ مَسدُودٌ عليهِ المَسَامعُ",74,"ع",1,0],["وَلا كيفَ بالهِجرَانِ وَالقَلبُ آلفٌ","وَلاَ كيفَ يَرضَى بالهَوَانِ كَرِيمُ",75,"م",1,0],["وَلا كَوكَباً لِلرُشدِ يُهدى بِرأيهِ","وَلا مَنهلاً للعلمِ يُشفى بِرِيِّهِ",76,"ي",2,0],["ولا كفكفت عني دموع غوادق","تطهر جفني من سواها وتوبتي",77,"ت",2,0],["ولا كلُّ مَن كانَ ذا قوَّةٍ","يناوي الضعيفَ إذا استضعفه",78,"ف",2,0],["ولا كعيون العِين مرضى سقيمةً","تُعاد فتُعدي سقمَها فيعودُ",79,"د",1,0],["ولا كان ابراهيم في الحال ناره","عليه غدت بردا بارض اريضة",80,"ه",1,0],["ولا كان اسماعيل للذبح مذ أتى","مطيعا نجا في الحال من حد مدبة",80,"ه",1,0],["ولا كان لما تله لجبينه","وقد سلما افدي باعظم فدية",80,"ه",1,0],["ولا كان عيسى وهو طفل بمهده","ينبىء عنه قومه بالنبوة",80,"ه",1,0],["ولا كان عن ايوب قد زال ضره","ولا كان اعطى الصبر عند البلية",80,"ه",1,0],["ولا كان حبرا في العلوم مصدرا","يسر بمرآه وينشرح الصدر",81,"ر",1,0],["ولا كان ذو عسر اله اذا أتى","فيثرى ومن يمناه يعتاده اليسر",81,"ر",1,0],["ولا كان قد جادت اياديه بالوفا","ولا كان منها ابحر قد جرت عشر",81,"ر",1,0],["ولا كنت أرجو أن تقول بأننا","حبيبان يطغيان الغرام فنجدهل",82,"ل",1,0],["ولا كانَ دهرٌ بالفراقِ قَطَعْتُه","ولا بُوركت أوقاتُه في مدى البَقَا",83,"ق",2,0],["ولا كجدد ولا كفعل","مثلث الفا مع فتح ما يلى",84,"ل",2,0],["وَلا كَبا يا بَني الرَقيلِ لَكُم","زَنّدٌ وَلا أُزلِقَت لَكُم قَدَمُ",85,"م",1,0],["وَلا كَفِلَت بِالنُجحِ مَسعاةُ طالِبٍ","وَلا صافَحَت كَفَّ الغِنى يَدُ مُجتَدِ",86,"د",1,0],["وَلا كَذَبَت آمالُ راجٍ أَمامَها","شَفيعانِ إِخلاصٌ وَصِدقُ وَلاءِ",87,"ا",2,0],["ولا كان دِيناري مِنَ النُّصحِ بَهرَجاً","لَدَيْهِ ولا بَرْقِي مِنَ الوُدِّ خُلَّبا",88,"ب",2,0],["وَلاَ كَعَهْدِ خَلِيلٍ خِلْتُ خُلَّتَهُ","دَائِمَةً فَبَدَا فِي رَأْسِهَا الشَّمَطُ",89,"ط",1,0],["وَلاَ كَعُبَيْدِ خَالِقِهَا فَتَاهَا","سَلِيلِ ذَوَاتِهَا وَأَبِي عُلاَهَا",90,"ا",3,0],["وَلا كانَ يَلقاني بِوَجهٍ مُقَطَّبٍ","يَرُدُّ سَلامي خِفيَةً حينَ أَجهَرُ",91,"ر",1,0],["وَلا كانَ كُلٌّ مِنهُمُ في مَمالِكٍ","يُعايَنُ كَالأسكَندَرِ البانِيِ السَدِّ",92,"د",1,0],["ولا كائن قد أو هو كائن","سوي بمراد اللَه من غير حاصر",93,"ر",1,0],["ولا كان فيهاه المضيع المسيح","وفي جنبه الباهري الضياء",94,"ا",2,0],["ولا كنا كراماً ان نكسنا","عن الجلى ولا كنا شبابا",95,"ب",2,0],["وَلا كُلُّ مَن قَطَّ اليَراعة كاتب","وَلا كُلّ مَن خَطَّ البَراعة يَشعرُ",96,"ر",1,0],["وَلا كانَت دِماؤُهُمُ وَفاءً","لَنا فيما يُعَدُّ مِنَ العِقابِ",97,"ب",1,0],["ولا كتدفُّقِ الدُّولابِ فيها","رأتْ عينايَ واغترَفَتْ يَدايا",98,"ا",3,0],["وَلا كُنتُ إِلّا غائِباً مِثلَ شاهِدٍ","وَإِن كانَ صَرفُ الدَهرِ يَثني عَزائِمي",99,"م",2,0],["وَلاّكَها اللهُ لمّا أنْ رآك لها","أهْلاً ومَن لم يُوَلِّ اللهُ يَنْعَزِل",100,"ل",1,0],["ولا كاتبٍ إن غِبْتُ عن غيرِ حاجةٍ","وأُجرِيَ مُجْرىَ ألكَنٍ مُتفاصح",101,"ح",1,0],["وَلا كانَ قَصدُ الوَفدِ غُرَّةَ كَوكَبِ","فَلَمّا بَدَت صَلّى عَلَيها وَسَلَّما",102,"م",2,0],["ولا كان ادعى منها وفيها","نبيّاً حين مَخرقَ باليَمامه",103,"م",2,0],["ولا كان أدى شأنها من شتاتها","لبعثٍ شريفٍ من مبانٍ قصية",104,"ه",1,0],["ولا كان مني مِقوَلُ الهجو جارياً","بميدانِه بالقذف والذمِّ والثلب",105,"ب",1,0],["وَلا كُنت أَن لانَت قَناتي لِغامز","وَلو قطَّعت نَحري قَوارض أَغلالي",106,"ل",2,0],["ولا كسب دنيا ولا حسن دين","إذا نظر كسبه تحسف",107,"ف",1,0],["ولا كلُّ الغيومِ تُثير بَرْق","يحرِّك وَمْضُه شَغَفَ الجبالِ",108,"ل",1,0],["ولا كِتابٌ ولا جوابُ","ولا سَلامٌ ولا كَلامُ",109,"م",1,0],["ولا كنت أدري أن في الكفر مثل ذا","وحاشا لمثلي أن يكون مرامي",110,"ي",1,0],["ولا كيلة لي من زكاة ولم أذق","لها حبة يوماً ولا لمست يدي",111,"د",2,0],["ولا كإسماعيل من أصحب","صفاته كالشمس لا تحجب",112,"ب",1,0],["ولاّك ما كنتَ أهلاً أن تكونَ له","مُشَيّداً من مباني المجد أركانا",113,"ن",2,0],["ولاّك إفتاءَ الأنام محبّذا","رأيٌ لعَمري إنَّه لسديد",114,"د",1,0],["ولا كرياض الجزع وهي أنيقة","وتفضلها في بهجة وبهاء",115,"ا",2,0],["ولأكثرت فيهم القتل والسَّبْ","يَ ومثّلتهم بها تمثيلا",116,"ل",2,0],["ولا كل فعلينِ قد صُرِّفا","سواءً سواءً على المصْدرِ",117,"ر",1,0],["ولا كَفَتْحٍ غَدَتْ أَعلامُ دعوتِهِ","ترسو بِهِ وَكَثِيبُ الشِّرْكِ يَنْهالُ",118,"ل",1,0],["ولا كَبَني سبيلٍ شَرَّدَتْهُمْ","عن الأَوْطانِ قاضِيَةُ القضاءِ",119,"ا",2,0],["ولا كَوُفودٍ تقبَّلْتَ مِنْهُمْ","وسائِلَ كانوا عَلَيْها شُهودا",120,"د",2,0],["ولأَكْتُبَنْ منها عَلَى صُحُفِ العُلا","غُرَرَ الكِتابِ وغُرَّةَ الكُتَّابِ",121,"ب",1,0],["ولا كَنَدَتْ أَسيافُهُ مُلْكَ كِنْدَةٍ","فَيَتْرُكَ فِي أَركانِ عِزَّتِها وَهْيَا",122,"ي",2,0],["ولا كالتعازي بيننا فهي سنة","فميت يعزي ميتاً فقد ميت",123,"ت",1,0],["ولا كنتُ عبداً لهذا الجمالِ","أراكَ تطالبني بالمحالِ",124,"ل",1,0],["ولا كان قدرُ المال قدرَ انتقامكم","ألا بئس فتْكاتُ الملوك فتكَتُمُ",125,"م",1,0],["ولا كان هذا الشملُ مما يرُوعه","صُدوعٌ ولا ذا الظلُّ مما يُحوَّلُ",126,"ل",1,0],["ولاَّك أمرَ عباده نظراً","منه فما تُدهَى من العزلِ",127,"ل",1,0],["ولا كاتّباع الحِرصِ للمرء خَلَّةً","يدِقُّ عليها العِرضُ وهو جليلُ",128,"ل",1,0],["ولا كضريح أمس هِلْنا ترابَه","على جسدٍ باقي العلا في النَّقا بالي",129,"ي",1,0],["ولا كنتُ قبلَكِ في حاجةٍ","لتحمِلَ عُنْقي لريح يدا",130,"د",2,0],["ولا كامناً في الحيّ أنظرُ سِربَهُ","على خدعة الأَشراكِ كيف أصيدُ",131,"د",1,0],["ولا كان في حكم الوثيقة أن أرى","عليك الثرى كَلاًّ وجسمِيَ رَيِّحُ",132,"ح",1,0],["ولا كذباً طارت به الريح طيرةً","فأقعصه أن طأطأتْ عاصفاتُها",133,"ت",3,0],["ولا كنتُ إلا واحداً من عشيرةٍ","ولا باقياً في الناس إلا ابن ذاهب",134,"ب",1,0],["ولا كعهدك في ابن الصاحب ابتهجت","له المعالي وطالَ الفخرُ والحسَب",135,"ب",1,0],["ولاكنني أوتيت قلبا يميل لل","نصائح وعظا لي وللغير زاجرا",136,"ر",2,0],["ولا كنتُ أهوى القدَّ لدناً مهفهفاً","ولا الظبي مصقولَ الترائب أغيدا",137,"د",2,0],["وَلا كُلُّ ذي حِرصٍ يُزادُ بِحِرصِهِ","وَلا كُلُّ راجٍ نَفعَهُ المَرءُ يَنفَعُ",138,"ع",1,0],["ولا كنتُ لولاهما ضَلَّةًً","أديمُ سَنا البارقِ المنجدِ",139,"د",1,0],["ولا كنتُ مِمَّنْ يشتكي جُمْلَةَ الهوى","وتفصيلَهُ لولا أليمُ هوى جُمْلِ",140,"ل",1,0],["ولا كنتُ لولا البينُ أبكي إذا سرتْ","شمالٌ على الجرعاءِ مسكَّيةُ النَّشرِ",141,"ر",1,0],["ولا كنتُ أنضي العيسَ في البيدِ كلَّما","محا خطوُها سطَرا ترفَّعَ عن سَطْرِ",141,"ر",1,0],["ولا كانتْ نياقي في الموامي","سطوراً والخروقُ لهنَّ طَرْسا",142,"س",2,0],["ولا كانَ فيها نجيبٌ يَخُبُّ","برحلي كَلالاً ولا يوُضِعُ",143,"ع",1,0],["ولا كان يَمزَعُ بي نحوَها","فسيحُ الخُطا جَرْشَعٌ قارحُ",144,"ح",1,0],["ولا كرامة بالبرد التي طرأت","ولا مسرة بالنجم الذي طلعا",145,"ع",2,0],["ولا كلُّ عالٍ في الوُجودِ وسافِلٌ","ولا كلُّ مَطْموسٍ وظاهِرُ أَشْكالِ",146,"ل",1,0],["ولا كانَ في ما مضى مكسَبي","وبئسَ البِضاعَةُ للتّاجِر",147,"ر",1,0],["ولا كان ذاك العذل إلا نصيحةً","ولا ذلك الأغضاء إلا تهيبا",148,"ب",2,0],["ولاكففت الغرب من مقول","أمضى إذا شئت من المعضب",149,"ب",1,0],["ولا كرمن عن مناخ جعجع","يفحصن فيه الأرض بالكراكر",150,"ر",1,0],["ولا كانَ مَصْحُوباً مَشُوباً بِبِدْعَةٍ","يَصِيرُ بها لَحْظُ الشّرِيعَةِ أَرْمَدا",151,"د",2,0],["ولا كَالأُلى في العالَمِين تَمَيَّزوا","بَنكثِ عُهودٍ عاهَدوها وأقسَموا",152,"م",3,0],["ولا كنتُ ممّنْ يرى سيّئاً","بغيري ومقلتُهُ لا تراني",153,"ي",1,0],["ولا كان منّا غيرُ حائمِ قفرةٍ","يلوذ على حرّ الصَّدى بحيامِ",154,"م",1,0],["ولا كانَ إلّا ناجياً من عَضِيهَةٍ","ولا ساعِياً إلّا بطرق الفضائلِ",155,"ل",1,0],["ولا كنتُ أحفل في بلدةٍ","مقيماً بمُستَوْفِزٍ راحلِ",156,"ل",1,0],["وَلا كانَ لِي إلّا عليك إقامةٌ","وَلا كانَ لِي إِلّا برَبْعِك مَرْبَعُ",157,"ع",1,0],["وَلا كانَت منَ الزّمن المُلَحَّى","مَراتبُكُم بِه إلّا سُفاطا",158,"ط",2,0],["وَلا كانَ هادِم ما يبتنيه","وقالعُ أغراسهِ غارسا",159,"س",2,0],["وَلا كنتُمُ إلّا كَما تَكرهونَهُ","وَلا اِعتادَكمْ نوءٌ من الرّزق راجسُ",160,"س",1,0],["ولا كنتُ يوماً للهوانِ مصافياً","ولا بين أبياتِ اللّئام قراري",161,"ر",2,0],["وَلا كَساكمْ بَعد أَن كنتُمُ","بلا رِياشٍ حِبَرَ الفَخرِ",162,"ر",1,0],["ولا كانوا لكلِّ النّا","سِ إلّا موضعَ القُطبِ",163,"ب",1,0],["ولا كبير ولا صغير","ولا حليم ولا سفيه",164,"ي",2,0],["وَلا كَراءً يَقطَعُ الظُهورا","ظَلَّت تُصادي يَومَها الحَرورا",165,"ر",2,0],["وَلا كَهَذا فَليَهوَ مَن كانَ ذا هَوى","وَإِلّا فَحُبُّ الناسِ أَكثَرهُ لَهوُ",166,"و",1,0],["ولا كان قَلْبي بالهموم مُكَحَّلاَ","ولا كَانَ طرْفي بالدِّماءِ مخضَّبا",167,"ب",2,0],["ولا كان جسمِي من هُزالي مُخْصِباً","ولا كان خَدِّي من شُحوبيَ مُعْشِبَا",167,"ب",2,0],["ولا كوكب إِلا بسعدي طالع","ولا فَلَكٌ إِلاَّ بِقَصدِيَ دَوَّار",168,"ر",1,0],["ولا كنتُ إِلاَّ مَنْ يُقارِعِ دَهْرَه","قِراعاً إِلى أَنْ يَسْأَلَ الصُّلحَ دَهرُه",169,"ر",2,0],["ولا كان هذا شأنه وصنيعه","ولا كان هذا حاله حين يضرب",170,"ب",1,0]]}