{"poems":[[79,"هي أسعد ما دونهن حجاب","https://www.aldiwan.net/poem36780.html","الطويل"],[56,"دليتني بغرور وعدك","https://www.aldiwan.net/poem27520.html","الكامل"],[4,"إن أبان كان حلوا بسرا","https://www.aldiwan.net/poem21170.html","الرجز"],[74,"يا دار جيرتنا بسفح الأجرع","https://www.aldiwan.net/poem19161.html","الكامل"],[53,"هل تعرف الدار بذي الأثأب","https://www.aldiwan.net/poem8512.html","السريع"],[53,"كان العزير زمانا","https://www.aldiwan.net/poem64057.html","المجتث"],[68,"ومخلق الخدين من صبغ الحيا","https://www.aldiwan.net/poem39520.html","الكامل"],[52,"غمض الحديد بصاحبيك فغمضا","https://www.aldiwan.net/poem62354.html","الكامل"],[52,"سبح خليلي وقل يا حسن تصوير","https://www.aldiwan.net/poem63819.html","البسيط"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[190,"حسبي من التريبات والحشم","https://www.aldiwan.net/poem43276.html","المنسرح"],[201,"يا ليتني فوق الغصون حمامة","https://www.aldiwan.net/poem39817.html","الكامل"],[275,"لم أنس ليلا بالنجوم ترصعا","https://www.aldiwan.net/poem35676.html","الكامل"],[295,"دع عنك أيام السرور","https://www.aldiwan.net/poem11665.html","مجزوء الكامل"],[325,"كان التنقل في الغرام يلذ لي","https://www.aldiwan.net/poem61736.html","الكامل"],[343,"لا تطلبن أثرا بعين","https://www.aldiwan.net/poem68687.html","مجزوء الكامل"],[409,"الحمد كل الحمد للخلاق","https://www.aldiwan.net/poem33620.html","الكامل"],[438,"لم يشف طيفك لما زارني ألما","https://www.aldiwan.net/poem12372.html","البسيط"],[463,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[466,"نصبو القنا الطعان فخلته","https://www.aldiwan.net/poem15974.html","الكامل"],[473,"ما أحرج الباب بل ما أرحب الوادي","https://www.aldiwan.net/poem59455.html","البسيط"],[505,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[520,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[520,"المدح يدري أنكم أكبر","https://www.aldiwan.net/poem12115.html","السريع"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138288",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83322","البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83258","الكامل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66654","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38980","البسيط"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72340","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95547","المجتث"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108931","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127997","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48241","السريع"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88644","البسيط"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67200","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60837","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93610","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100414","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100832","الكامل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112296","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86523","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135624","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111502","البسيط"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97096","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97098","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97094","الكامل"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105164","الكامل"],[4639,"","https://poetry.dctabudhabi.ae/diwan/poem/124653","الكامل"],[4767,"الضياع","https://www.poetsgate.com/ViewPoem.aspx?id=180021",""],[4927,"سَهَرُ الْعَاْشِق","https://www.poetsgate.com/ViewPoem.aspx?id=29636",""],[4994,"يُحبُّهُ اللهُ وأُحبُّهُ أنا","https://www.poetsgate.com/ViewPoem.aspx?id=208943",""],[5147,"يا ربع زحلة أين عنا","https://www.poetsgate.com/ViewPoem.aspx?id=166758",""],[5285,"زهر السفرجل","https://www.poetsgate.com/ViewPoem.aspx?id=203982",""],[5409,"يومٌ بزغت بأفقه مولودا","https://www.poetsgate.com/ViewPoem.aspx?id=155488",""],[5409,"عيش ترصده المنايا ضيق","https://www.poetsgate.com/ViewPoem.aspx?id=155461",""],[5518,"في رسول الله صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=206406",""],[5956,"بصخرِ العز","https://www.poetsgate.com/ViewPoem.aspx?id=192333",""],[463,"أولى لها أن يرعوي نفارها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60088&r=&rc=144",""]],"verses":[["حَتَّى إِذَا شَمَلَ البِلاَدَ وَأَهْلَهَا","فَعَلاَ لَهُمْ قِدْحٌ وَعَزَّ جَنَابُ",0,"ب",1,0],["حَتّى إِذا شَمِتَ العَدُوُّ وَقَد","شُهِرَ اِنتِقاصُكَ شُهرَةَ البَلَقِ",1,"ق",1,0],["حَتّى إِذا شَقَّ الصَباحُ الفَجرا","أَلقى سَرابيلاً شَليلاً غَمرا",2,"ر",2,0],["حتى إذا شمنا لطيبةَ معلماً","عجَّلت قبل الحجّ طيب تمتعي",3,"ع",2,0],["حتى إذا شاهده عالمٌ","ألفيتَهُ أروغَ منْ ثعلبِ",4,"ب",1,0],["حتى إذا شمْت فيه","أيراً كجُرذان عَير",5,"ر",1,0],["حَتّى إِذا شَهِدَ المَقامَ مُبارِزاً","وَالطَيرُ بَينَ مُحَوِّمٍ وَمُحَلِّقِ",6,"ق",1,0],["حَتّى إِذا شَرِبَت بِماءِ مَوَدَّتي","وَشَرِبتُ بَردَ رُضابِها مُتَبَرِّضا",7,"ض",2,0],["حِتّى إِذا شُقَّ عَنهُ اللَيلُ وَدَّعَني","بِعَبرَةٍ وَلِثامٍ في التَنانيرِ",8,"ر",1,0],["حتّى إذا شَافَهَتِ الحُتوفا","وشامَتِ الرِّماحَ والسُّيوفا",9,"ف",2,0],["حتى إذا شارفَ ظلَّ الشجرْ","في روضةٍ غناءَ ريَّا الأديمْ",10,"م",1,0],["حَتى إِذَا شَبُّوا تَقَاضَوْا حَقَّهُمْ","بِهُدىً وَمَا كَانُوا مِنَ الضُّلاَّلِ",11,"ل",1,0],["حتى إذا شبّ واستوى ونما","وصار في الكسب غير محتشم",12,"م",1,0],["حتّى إذا شفت الغليل تعطشست","للموت واندفعت بجوف النار",13,"ر",1,0],["حتى إذا شارَفتُ دار حبيبتي","فَذَكرتُ لي فيها لياليَ أربعا",14,"ع",2,0],["حتى إذا شبت لظاها","كنت كالأسد الهصور",15,"ر",1,0],["حَتّى إِذا شاهَدتَ مَنظَرَكَ الجَلي","وَقَفَ الهَوى بي حَيثُ أَنتَ فَلَيسَ لي",16,"ي",1,0],["حَتّى إِذا شَمِلَ المَشي","بُ فَجازَ قُطرَ الجانِبَين",17,"ن",1,0],["حتى إذا شب المشيب بعارضي","ومضى الشباب وكان خير رواق",18,"ق",1,0],["حتى إِذا شابَ فَوْدُ الليلِ وانْعَطَفتْ","قناتُه وتدانَى خَطْوُهُ هَرَما",19,"م",2,0],["حتى إذا شرعنَ في حياضه","خالفَ من إيرادها إصدارُها",20,"ر",3,0],["حتى اذا شَرَعوهُ قُلْتُ كواكبٌ","مُنْقضَّةٌ في جِنْحِ ليلٍ ألْيَلِ",21,"ل",1,0],["حتى إذا شعرت نفسي بنُقلتها","تُصيب إسكيمَها مِرقاةَ إصعاد",22,"د",1,0],["حتَّى إذا شَمختْ بالأُفقِ قُبَّتُهُ","وكفْكَفَ الأرضَ تَكْويرٌ وادْحاءُ",23,"ا",2,0],["حتى إذا شيدتها ونصبتها","علماً يحج فناؤه ويزار",24,"ر",1,0],["حتى إذا شاهد أفعالكم","صدق حسن الخبر المخبر",25,"ر",1,0],["حتى إذا شُفي الأوام ازيد من","تذكير من أنسى الفروض فيذّكر",26,"ر",1,0],["حَتّى إِذا شَغَفَ القَلبُ الَّذي اِجتَذَبَت","بانَت سُعادُ فَقَلبي اليَومَ مَتبولُ",27,"ل",1,0],["حَتّى إِذا شَقَّ الدُجُنَّةَ شَوقَها","لِلقا ذُكاءَ وَشابَ فَودُ الأَسفَعِ",28,"ع",1,0],["حتى إذا شربوا جميعاً رَدَّها","ومضى فَخِلْتَ مكانَها لم يُقْرَبِ",29,"ب",1,0],["حَتّى إِذا شامَها الأَعداءُ خافِقة","فَرُّوا وَهُم يَطلُبونَ القَفر وَالبيدا",30,"د",2,0],["حتى إذا شيطانه قال ابتدر","في سرعة للملك والتمكين",31,"ن",1,0],["حتى إذا شاب خطب","شبّ الأَسى يستجدُ",32,"د",1,0],["حتى إذا شقَّ المؤذِّنُ شدقَه","مثلَ الحمارِ له تؤُمُّ أَتان",33,"ن",1,0],["حتى اذا شربوا كؤوس مدامة","غناهم شاد بديع في الغنا",34,"ن",2,0],["حتى إذا شاهدَ لي لوعةً","لم تُبْقِ إلا شربةً من ضُباحْ",35,"ح",1,0],["حتىّ اذا شاقه الأَدنى له رحما","وآذنت جمرات الشوق في شعل",36,"ل",1,0],["حتى إذا شاء الآلهُ بأن يَرى","ذاكَ الهُمامَ مجدَّلاً بين العِدى",37,"د",2,0],["حَتّى إذا شاهدت شطى عواجة قف","وانزل بها فبهالله أسرارُ",38,"ر",1,0],["حَتّى إِذا شاءَ المهيمن قربهم","لِجواره وَجَرى القَضا المَسطور",39,"ر",1,0],["حتى اذا شاء الأله بان يُرى","ملقى بمهمهةٍ على كثبانها",40,"ن",3,0],["حتى اذا شهر المضيم حسامه","كانت له مهج الجفاة غمودا",41,"د",2,0],["حتى إذا شطّ المَزَا","رُ بهذه الدنيا الغَرُورِ",42,"ر",1,0],["حتى إذا شهدوا المعارك أدرجوا","تلك الأماني الغر في الأكفان",43,"ن",1,0],["حتى إذا شمس الحقيقة أُعليتْ","تجد الليالي كالنهار وأجليتْ",44,"ت",1,0],["حتى إذا شاء زفسٌ في بطانته","موتي فإن حياتي تلك دونهم",45,"م",1,0],["حتى إذا شحذت يداه حدودها","للفتك عزرائيل كان قرينها",46,"ن",3,0],["حتى إذا شرعت بروق حسامه","سبل الشريعة أو جلت أدجانها",47,"ن",3,0],["حتى إذا شاء الإله بأن يرى","شمس العوالم نكست أعلامها",48,"م",3,0],["حتى إذا شق الصباح عموده","صدت مولية وخاب رجائي",49,"ا",2,0],["حتى اذا شاء القضا إنجازه ال","عهد القديم فانجز الميعادا",50,"د",2,0],["حتى إذا شاء رب الكون أظهَره","ليحفظ الدين بالأحكام والسُّنَن",51,"ن",1,0],["حَتَّىْ إِذَاْ شَكَّتْ سِهَاْمُ خِيَاْنَةٍ","فِيْ عَاْرِضَيْكَº وَسَيَّلَتْ مِنْكَ الدِّمَاْ",52,"م",2,0],["حَتَى إذا شَدّ الحَنينُ حَنينَه","ضَمَّ الخَيالَ لِصَدرِهِ وَتَنسّما",53,"م",2,0],["حتى إذا شاهدته","فقل السلام عليك عنا",54,"ن",2,0],["حتى إذا شاءَ الإلهُ منيَّتي","يكفي ب \" طارق \" أنه يهواكِ",55,"ك",1,0],["حتى إذا شمس النبوة أسفرت","عن أهلها حجب الضلال السودا",56,"ا",1,0],["حتى إذا شاء السكوت لك القضا","ولكل حي ساعةٌ لا ترفق",57,"ق",1,0],["حتى إذا شاهدته ذقت الندى","ونداهُ نبعٌ في المحبةِ جارِ",58,"ر",1,0],["حتى إذا شاء الإله وصالنا","والنصر تمّ على العدل بالأكملِ",59,"ل",1,0],["حتى إذا شرعنَ في حياضهِ","خالفَ منْ غيرادها إصدارها",60,"ر",3,0]]}