{"poems":[[74,"صحا القلب لولا نسمة تتخطر","https://www.aldiwan.net/poem18693.html","الطويل"],[580,"ألا فانتبه من أفقها طلع الفجر","https://www.aldiwan.net/poem3064.html","الطويل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111872","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77982","الوافر"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108361",""],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117982","الطويل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107489","المتقارب"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125827","الطويل"],[4277,"","https://poetry.dctabudhabi.ae/diwan/poem/124304","الطويل"],[5397,"بمد العمر قد ذهب الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=157906",""],[5956,"فقاعة متغطرسة","https://www.poetsgate.com/ViewPoem.aspx?id=192425",""]],"verses":[["هو الثابت العليا على كلّ مرسلٍ","بحيثُ له في حضرة القدس محضر",0,"ر",1,0],["هو الثَّغْرُ إِلاَّ أَنَّه الصبحُ طالِعاً","على أَنَّه الكَافُورُ لكنَّه الدُّرُ",1,"ر",1,0],["هوَ الثارُ حتى يحجب الشمسَ عثيرٌ","تساوى بهِ العين الصحيحة والرمدَا",2,"د",2,1],["هو الثاني لواحد كل نجوى","إلى ما ليس يحصره العديد",3,"د",1,0],["هو الثاقب الرأي السديد على ذكاً","يكاد لنا يبهى قبيل اشتعاله",4,"ل",2,0],["هو الثابت الراي المصيب فهل ترى","سواه لا ملاك النظام بنظّام",5,"م",1,0],["هو الثَمرُ الحلو من منطقي","جَنوهُ ولولاكَ لم يُجتنى",6,"ا",1,0],["هو الثلجُ لا ثلجٌ يجيُ به الشتا","بسيبريا أو في لنين غرادا",7,"د",2,0],["هو الثالث الجالي دجى القلب حسنه","فأي وجوه الحسن صادك أبكم",8,"م",1,0],["هو الثقل الذي بالوزن راسي","ويعدله بكفته الكتاب",9,"ب",1,0],["هو الثرثار لم يخرس قليلاً","ولا يحظى كلامُه بالقَبولِ",10,"ل",1,0]]}