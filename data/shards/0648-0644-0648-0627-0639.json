{"poems":[[55,"يا من رأى البرق على الأنعم","https://www.aldiwan.net/poem29815.html","السريع"],[55,"قضت المنازل يوم كاظمة","https://www.aldiwan.net/poem29962.html","الكامل"],[85,"يا من يحن إلى نجد وناديها","https://www.aldiwan.net/poem54234.html","البسيط"],[53,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[91,"أسرفت يا إبليس في الوسواس","https://www.aldiwan.net/poem44751.html","الكامل"],[47,"إذا ما حصلت عليا قريش","https://www.aldiwan.net/poem63627.html","الوافر"],[68,"الشوق أعظم جملة يا سيدي","https://www.aldiwan.net/poem40314.html","الكامل"],[71,"لا واخذ الرحمن مصرا ولا","https://www.aldiwan.net/poem29168.html","السريع"],[107,"أبا الفضل أقبل وارفع الصوت شاكرا","https://www.aldiwan.net/poem44043.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16654","الوافر"],[113,"يدير علي كاسات الحميا","https://www.aldiwan.net/poem16389.html","الوافر"],[139,"أهدي إلى السامي المقام سلاميه","https://www.aldiwan.net/poem48994.html","الكامل"],[147,"ما مرتقاك على من رامه أمم","https://www.aldiwan.net/poem11824.html","البسيط"],[164,"ما لي وقد شبت في داعي الصبا أرب","https://www.aldiwan.net/poem58671.html","البسيط"],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[189,"يا ساحل الثغر كم لي فيك من أرب","https://www.aldiwan.net/poem14109.html","البسيط"],[240,"الدست من لألاء وجهك مشرق","https://www.aldiwan.net/poem31812.html","الكامل"],[266,"وإذا حرمت الجد ظلت من الدنا","https://www.aldiwan.net/poem38129.html","الكامل"],[266,"عوفيت نضو هواك برح داؤه","https://www.aldiwan.net/poem38139.html","الكامل"],[303,"أعطى قليلا واستردا","https://www.aldiwan.net/poem36857.html","عموديه"],[323,"ولو أعطاني الدهر اختياري","https://www.aldiwan.net/poem62621.html","الوافر"],[358,"زن بالفضائل مجد جدك","https://www.aldiwan.net/poem40385.html","مجزوء الكامل"],[369,"إذا لم تقدرا أن تسعداني","https://www.aldiwan.net/poem60633.html","الوافر"],[438,"نعم هو البرق على الأنعم","https://www.aldiwan.net/poem12720.html","السريع"],[475,"إني لآمل أن تدنو وإن بعدت","https://www.aldiwan.net/poem4661.html","البسيط"],[519,"هلم بنا إلى أرض الحجون","https://www.aldiwan.net/poem20805.html","الوافر"],[580,"رأيت طرفك يوم البين حين همى","https://www.aldiwan.net/poem3020.html","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59423","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136169","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125360","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114711","الطويل"],[2169,"","https://poetry.dctabudhabi.ae/diwan/poem/141459","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53155","السريع"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28489","الوافر"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88658","الرجز"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137150",""],[2940,"","https://poetry.dctabudhabi.ae/diwan/poem/113700","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74021","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91994","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85007","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111502","البسيط"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121269","الكامل"],[4981,"إلى أمّي","https://www.poetsgate.com/ViewPoem.aspx?id=190477",""],[5038,"تسائلني","https://www.poetsgate.com/ViewPoem.aspx?id=189580",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[475,"إِنِّي لآمُلُ أَنْ تَدْنُو وَإِنْ بَعُدَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=20519",""],[6056,"طيور الظلامي","https://www.poetsgate.com/ViewPoem.aspx?id=130381",""]],"verses":[["وَلّوا عَلى قَلبي عَنيفَ الجَوى","يُعاقِبُ القَلبَ وَلَم يُجرِمِ",0,"م",1,0],["وَلَواعِجٌ نَفَسي يُنَفِّسُها","وَبَلابِلٌ دَمعي يُخَفِّفُها",1,"ف",3,0],["ولو أعرتُ لسان الدهر يشكرها","لكان يقصرُ عن شكرٍ يُوَفّيها",2,"ي",3,0],["ولو أعرضت بيني وبينك أبحرٌ","زواخرُ تودي بالسفين العوائمِ",3,"م",1,0],["ولو اعتقدت بهم شعورا في الردى","لتبعتهم تغوى الى الارماس",4,"س",1,0],["وَلَو أَعطاكَ رَبُّكَ ما تَمَنّى","عَلَيهِ لَزادَ في غِلَظِ الأُيورِ",5,"ر",1,0],["وَلَواعِجُ البُرَحاءِ أَعظَمُ كَثرَةً","مِن أَن يُحيطَ بِها بَلِيغُ خِطابي",6,"ب",2,0],["ولَّوا علينا قاضياً ثالثاً","ما كانَ للناسِ بهِ حاجَهْ",7,"ه",1,0],["ولو أعرضوا لم يَرْدَعِ الحربُ رَادِعٌ","ولم يَنتزِعْ أنيابَهَا والأظافرا",8,"ر",2,0],["ولو أعطى على قَدْرِ المَعالي","سَقى الهَضَباتِ واجْتَنَبَ الوِهادا",9,"د",2,0],["وَلَو أَعيا الزَمان الوَغد همٌّ","فَأَعجزهُ لِأَرسلهُ اليّا",10,"ي",2,0],["ولواعجا أذكى البعادُ لهيبها","ومدامعاً رقت فأضحت جاريهْ",11,"ي",2,0],["وَلَو أَعَرتَهُمُ أَلبابَهُم لَدَرَوا","أَنَّ الَّذي جَهِلوا أَضعافَ ما عَلِموا",12,"م",3,0],["ولو أعار صروف الدهر فكرته","بدا له من قضايا حكمه العجبُ",13,"ب",1,0],["ولو أعطى المعطى كتابك رشده","طواه على عراته والمكاسر",14,"ر",1,0],["ولو أعادتْ ليَ الأيامُ ما أَخذتْ","مع المشيبِ الذي أَبقَتْه لم يَطِب",15,"ب",1,0],["وَلَّوا عَلى الأَدبارِ لا يَدرونَ أَنَّ","هُمُ إِلى وِردِ المَنِيَّةِ أَسبَقُ",16,"ق",1,0],["ولو اعتبرت الأمر أعطاك الحجا","ذوقاً يمج حرامها وحلالها",17,"ل",3,0],["ولو اعتبرنا الأمر فيه لسرنا","بالمنع عنه وساء منه عطاؤه",18,"ا",3,0],["ولوٍ اعتلقتُ الخدَّ من","ه جنيتُ تفاحاً ووردا",19,"د",2,0],["ولو أعطاني الدهر اختياري","بحس بالسر مني والطوية",20,"ه",1,1],["وَلَواعِجاً تَفري مُدى","أظفارها حَكّاً بِجلدِك",21,"ك",1,0],["ولو أعملْتَ فكْرَكَ في حُقوقي","رَعيْتَنيَ الغداةَ كما رَعاني",22,"ن",2,0],["ولو أعار الليلَ آراءَهُ","ما احتاجَ ساريهِ الى الأنجمِ",23,"م",1,0],["وَلَو أُعاتِبُ ذا حِقدٍ قَتَلتُ لَهُ","نَفساً مُعاتَبَتي إِيّاكِ ما حَقدا",24,"د",2,0],["ولو أعدى الصخور عليه سالت","جوامدُها بجاريةِ العيونِ",25,"ن",1,0],["ولو أَعار شَمَاماً من خَلائِقه","حلماً لأَصبح في عِرْنِينِه شَمَماً",26,"م",2,0],["ولو أعار محيا الشمس بعض سنا","ما أسبل الليل من أهدى به سجفا",27,"ف",2,0],["ولو اعرب الوجدان عن مقتضى الهوا","ببرهان ذوق كان اعدل شاهد",28,"د",1,0],["ولو اعتقدت بأنه واشٍ بمغا","قُلنا لَصُنتُ السرَّ بالكِتمانِ",29,"ن",1,0],["ولو أعفَتِ الأيامُ قِدحُ ابن مقبلٍ","لما اختار كفّاً تطبيه على الفنن",30,"ن",1,0],["ولو أعطاكها ما أزددت عزا","ولا لك لو أجابك من مزيد",31,"د",1,0],["ولو أُعِيرَ البدرُ في أفقه","كَمَالَه في الملك لم يُمْحَق",32,"ق",1,0],["وَلَو أَعدَتهُ ثُمَّ جُفونُ عَينِي","لَجادَ عَلَيهِ بِالدَّمعِ الغَريبِ",33,"ب",1,0],["ولو اعار البدر من جبينه","ما خسف البدر فعاد اسفعا",34,"ع",2,0],["ولواعج تصلى بحر سعيرها","العلماء والشعراء والاشراف",35,"ف",1,0],["ولو اعترى بعد الشباب لسرَّني","فالعزُّ مكتهلاً شبابٌ ثاني",36,"ي",1,0],["وَلَواعجُ الزفرات في صعد","تمتَدّ بين الصدر والنحرِ",37,"ر",1,0],["وَلو اعتبرت بدا لعينك يا فتى","في كُل آنٍ للأنام شؤونُ",38,"ن",1,0],["وَلَو اِعتَزَّت أَهلُ المَحاسِنِ لَم تَقُل","إِلّا بِأَنَّ الكُلَّ مِن عَبدانِهِ",39,"ن",2,0],["ولوا عباديد نحن الفلك شاردةً","هل جل خطبٌ به الأرباب قد حكموا",40,"م",3,0],["ولواعِبُ الخيلِ استوَين كواعِباً","وأهِلَّةُ الحيّ اكتمَلنَ بدورا",41,"ر",2,0],["ولو أعطَيْنَ مِن جُوْدٍ كثيرٍ","فأمّي الجُودُ بل أمّي التّلالُ",42,"ل",1,0],["وَلَو أعْطَيتَني حُوراً وَعِيناً","لَما زاغَتْ عُيوني عَنْ رُباها",43,"ا",3,0],["ولو أعمل العيس الهجان مسافرٌ","إلى مسجدٍ عبر الثلاثة بالشد",44,"د",1,0],["ولوْ أعاتبُ ذا حقدٍ، قلتُ لهُ","نفساً، معاتبتي إياكِ ما حقدا",45,"د",2,0],["ولوإعتكف سبعين يوم ٍ بمحراب","أو إلتّزم بين الحجر والمقامي",46,"م",2,0]]}