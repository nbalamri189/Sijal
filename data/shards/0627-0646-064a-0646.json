{"poems":[[53,"وسمتك حالية الربيع المرهم","https://www.aldiwan.net/poem29817.html","الكامل"],[86,"شيخان قد خبرا الوجود وأدركا","https://www.aldiwan.net/poem68877.html","الكامل"],[86,"يا كاسي الأخلاق في","https://www.aldiwan.net/poem68899.html","مجزوء الكامل"],[73,"إعجب لحال السرو كيف تحال","https://www.aldiwan.net/poem11939.html","الكامل"],[93,"تمضي وأنت مضنة الأوطان","https://www.aldiwan.net/poem11245.html","الكامل"],[93,"بلغت أقصى العمر الفاني","https://www.aldiwan.net/poem11247.html","السريع"],[93,"إن ينتقل أغناطيوس الثاني","https://www.aldiwan.net/poem11262.html","الكامل"],[30,"أنينا وشكوى بالنهار كثيرة","https://www.aldiwan.net/poem29503.html","الطويل"],[30,"تغير بعدي من أميمة شارع","https://www.aldiwan.net/poem29603.html","الطويل"],[27,"قل للديار سقى أطلالك المطر","https://www.aldiwan.net/poem5764.html","البسيط"],[27,"طرب الحمام بذي الأراك فهاجني","https://www.aldiwan.net/poem5781.html","الكامل"],[27,"لمن الديار رسومهن خوالي","https://www.aldiwan.net/poem5974.html","الكامل"],[23,"سماه معشره أبا حكم","https://www.aldiwan.net/poem21392.html","الكامل"],[72,"جسم سقيم لا يرام شفاؤه","https://www.aldiwan.net/poem18173.html","الكامل"],[72,"دمعي عليك مجانس قلبي","https://www.aldiwan.net/poem18235.html","أحذ الكامل"],[72,"جل الإمام عن الأشعار يعرضها","https://www.aldiwan.net/poem18767.html","البسيط"],[72,"عين حواجبها ترمي بأقواس","https://www.aldiwan.net/poem19019.html","البسيط"],[72,"حاشاك من وحشة تحت الثرى وجلا","https://www.aldiwan.net/poem20546.html","البسيط"],[51,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[51,"لا يبعدن شبابك الغرنيق","https://www.aldiwan.net/poem65701.html","الكامل"],[51,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[91,"لم يبق ما يسليك غير الكاس","https://www.aldiwan.net/poem8973.html","عموديه"],[38,"إني نذير التي ألقت منيئتها","https://www.aldiwan.net/poem7812.html","البسيط"],[89,"وددت لو أني كنت في مصر محشورا","https://www.aldiwan.net/poem44924.html","الطويل"],[89,"كذب الرجاء فما نجيب يرجع","https://www.aldiwan.net/poem44935.html","الكامل"],[85,"شر البلية أن يكون زعيما","https://www.aldiwan.net/poem7255.html","الكامل"],[85,"بأبي وروحي الناعمات الغيدا","https://www.aldiwan.net/poem63773.html","الكامل"],[43,"عيد بأية حال عدت يا عيد","https://www.aldiwan.net/poem9555.html","البسيط"],[43,"هذي برزت لنا فهجت رسيسا","https://www.aldiwan.net/poem9613.html","الكامل"],[62,"لقياك من غير الزمان أمان","https://www.aldiwan.net/poem52256.html","الكامل"],[45,"إستقبلا الركب في أطلالهم وقفا","https://www.aldiwan.net/poem65170.html","البسيط"],[61,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[80,"هذا ابتداء له عند العلى خبر","https://www.aldiwan.net/poem31433.html","البسيط"],[80,"هجر الخيال فزرته بالخاطر","https://www.aldiwan.net/poem31447.html","الكامل"],[44,"إني نظرت ولا صواب لعاقل","https://www.aldiwan.net/poem29692.html","الكامل"],[44,"اليوم أدرج زيد الخيل في كفن","https://www.aldiwan.net/poem30299.html","البسيط"],[44,"أبى فلا شنبا يهوى ولا فلجا","https://www.aldiwan.net/poem30563.html","البسيط"],[69,"يا ناذرين الصوم يوم شفائه","https://www.aldiwan.net/poem28960.html","الكامل"],[31,"يا من لقلب دنف مغرم","https://www.aldiwan.net/poem41819.html","السريع"],[105,"نظم المجد لأبطال الحمى","https://www.aldiwan.net/poem42072.html","الرمل"],[105,"وفد البحيرة جاء طوع يقينه","https://www.aldiwan.net/poem42098.html","الكامل"],[105,"لمن دم في مغاني الحي مطلول","https://www.aldiwan.net/poem42135.html","البسيط"],[105,"إني نصحتك فاتهمت نصيحتي","https://www.aldiwan.net/poem43108.html","الكامل"],[105,"إني نظرت إلى الحوادث نظرة","https://www.aldiwan.net/poem43376.html","الكامل"],[105,"هم سادة الحرب من شيب وشبان","https://www.aldiwan.net/poem43573.html","البسيط"],[22,"شاقتك أظعان للي","https://www.aldiwan.net/poem21642.html","مجزوء الكامل"],[48,"حي الديار وأهلها أهلا","https://www.aldiwan.net/poem65031.html","الكامل"],[50,"بأبي وأمي من يقاربني","https://www.aldiwan.net/poem64843.html","الكامل"],[46,"ما لي رأيت صنوف الباطل اشتبهت","https://www.aldiwan.net/poem23164.html","البسيط"],[46,"أما البليغ فإني لا أجادله","https://www.aldiwan.net/poem23168.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39543","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39678","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39664","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67335","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54288","الكامل"],[106,"تحية وتقدير","https://www.poetsgate.com/ViewPoem.aspx?id=179700",""],[106,"تجار العقائد","https://www.poetsgate.com/ViewPoem.aspx?id=179441",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[22,"أَشاقتك أظعانٌ لليلى","https://www.poetsgate.com/ViewPoem.aspx?id=19749",""],[90,"بم أستهل","https://www.poetsgate.com/ViewPoem.aspx?id=179014",""],[90,"في ذكرى الخالصي","https://www.poetsgate.com/ViewPoem.aspx?id=179047",""],[31,"يا من لقلبٍ دنفٍ مغرمش،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19050&r=&rc=313",""],[107,"بك يستغاث من العدا","https://www.aldiwan.net/poem16254.html","مجزوء الكامل"],[113,"ألقيت في باب أهل اللَه في حلب","https://www.aldiwan.net/poem41748.html","البسيط"],[126,"بيضاء واضحة الترائب غادة","https://www.aldiwan.net/poem50502.html","الكامل"],[126,"تعلم العلم حقا يا فتى عمر","https://www.aldiwan.net/poem50614.html","البسيط"],[158,"إِذا سفك الدماء لديك حلا","https://www.aldiwan.net/poem58931.html","الوافر"],[162,"لن تستطيع لأمر الله تعقيبا","https://www.aldiwan.net/poem67835.html","البسيط"],[184,"أنين وشكوى في الظلام فإن أمت","https://www.aldiwan.net/poem43930.html","الطويل"],[227,"ناعورة أنة أنين الهوى","https://www.aldiwan.net/poem50993.html","السريع"],[255,"إني نظرت إلى المرآة إذ جليت","https://www.aldiwan.net/poem2684.html","البسيط"],[260,"إني نذرت لئن رأيتك سالما","https://www.aldiwan.net/poem68210.html","الكامل"],[273,"لمبشري برضاك أن يتحكما","https://www.aldiwan.net/poem25527.html","الكامل"],[280,"ماست كخوط البانة المياس","https://www.aldiwan.net/poem32736.html","الكامل"],[280,"سل عن فؤادي بسلع أية ذهبا","https://www.aldiwan.net/poem32874.html","البسيط"],[295,"لولا ازديارك في الكرى وهنا","https://www.aldiwan.net/poem33143.html","أحذ الكامل"],[303,"ينهي إليك سلاما جارك الجنب","https://www.aldiwan.net/poem56608.html","البسيط"],[326,"رقرقت فيك ملاحني وغنائي","https://www.aldiwan.net/poem54944.html","الكامل"],[351,"يا مفردا بين أرباب المروءة في","https://www.aldiwan.net/poem39756.html","البسيط"],[362,"طلعت نجوم الدين فوق الفرقد","https://www.aldiwan.net/poem60958.html","الكامل"],[364,"إن ينثروا الدر من مجد فما نثروا","https://www.aldiwan.net/poem17274.html","البسيط"],[364,"أستودع الله في أظعانهم قمرا","https://www.aldiwan.net/poem17355.html","الوافر"],[369,"أبلغ أبا الفتح ابن مك","https://www.aldiwan.net/poem57484.html","مجزوء الكامل"],[369,"إن الهوى المجحودا","https://www.aldiwan.net/poem57497.html","المجتث"],[390,"يا موحش الإخوان عش مستأنسا","https://www.aldiwan.net/poem53328.html","الكامل"],[399,"رح خاليا عما تكابد اضلعي","https://www.aldiwan.net/poem46746.html","الكامل"],[400,"لله در الجلال من علم","https://www.aldiwan.net/poem33433.html","المنسرح"],[400,"الاجتماع غنيمة","https://www.aldiwan.net/poem33481.html","مجزوء الكامل"],[400,"عذل العذول لباب السمع ما ولجا","https://www.aldiwan.net/poem34095.html","البسيط"],[413,"هلا نظرت إلى الكئيب الواله","https://www.aldiwan.net/poem54023.html","الكامل"],[429,"لذي الظلامة عد الظلم والشنب","https://www.aldiwan.net/poem12438.html","البسيط"],[438,"إن المنية في الورى أسباب","https://www.aldiwan.net/poem14436.html","الكامل"],[438,"الرزء أفجع أن نسح دموعا","https://www.aldiwan.net/poem14461.html","الكامل"],[441,"دمت يا فارس الخطب","https://www.aldiwan.net/poem55928.html","عموديه"],[451,"علم الإباء وأحكم الشعراء","https://www.aldiwan.net/poem61239.html","الكامل"],[451,"ذكرى الأباة ومطلع الشهداء","https://www.aldiwan.net/poem61257.html","الكامل"],[451,"يا من يوكل للأجانب ملكه","https://www.aldiwan.net/poem61598.html","البسيط"],[456,"نوازع الشوق والغليلِ","https://www.aldiwan.net/poem55990.html","مخلع البسيط"],[456,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[513,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[527,"قلب تقلب في فنون","https://www.aldiwan.net/poem37273.html","مجزوء الكامل"],[538,"اني نذرت لئن لقيتك سالما","https://www.aldiwan.net/poem56836.html","البسيط"],[549,"اسعد سعدت بساعة التحويل","https://www.aldiwan.net/poem47276.html","الكامل"],[551,"يا عين جودي بدمع منك مدرار","https://www.aldiwan.net/poem68400.html","البسيط"],[551,"أما النحيب فإني سوف أنتحب","https://www.aldiwan.net/poem68401.html","البسيط"],[560,"أعلمت ما بالقلب من نار الجوى","https://www.aldiwan.net/poem52852.html","الكامل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["إِنّي نَزَلتُ وَكُنتُ غَيرَ مُذَلَّلٍ","بَيتَ المُهانِ وَأَنتَ عَينُ المُكرَمِ",0,"م",1,0],["إِنّي نَظَرتُ إِلى اليَراعَةِ في يَدي","فَحَسِبتُها في القَدرِ عودَ ثِقابِ",1,"ب",1,0],["إِن يَنكِروا بَعضَ الغُمو","ضِ عَلى أَديبٍ ذي اِقتِدارِ",2,"ر",1,0],["إِن يَنكَدِر بِالأَمسِ نَجمٌ ثاقِبٌ","فَاليَومَ أَقلَعَ عارِضٌ هَطّالُ",3,"ل",1,0],["إنْ يَنْفَصِمْ سَبَبٌ يَصِلهُ وَإنْ يَقَعْ","خَطَلٌ يَذُدْهُ بِمقَاطِعِ البُرْهَانِ",4,"ن",1,0],["إنْ يَنْتَقِلْ مَنْ طَهُّرَتْ رُوحُهُ","مَا فُرْقَهُ الرُّوحِ لِجِثْمَانِ",5,"ن",1,0],["إِنْ يَنْتَقِلْ أَغْنَاطِيُوسُ الثَّانِي","فَإِلَى الخُلُودِ وَكُلُّ حَيٍّ فَانِي",6,"ن",2,1],["أَنيناً وَشَكوى بِالنَهارِ كَثيرَةً","عَلَيَّ وَما يَأتي بِهِ اللَيلُ أَبرَحُ",7,"ح",1,1],["أَنينَ الفَتى المَسلولِ أَبصَرَ حَولَهُ","عَلى جُهدِ حالٍ مِن ثَناياهُ عُوَّدا",8,"د",2,0],["إِنّي نَفَيتُكَ عَن نَجدٍ فَما لَكُمُ","نَجدٌ وَمالَكَ مِن غورِيِّهِ حَجَرُ",9,"ر",1,0],["إِنّي نَزَلتُ بِمُفرَعٍ مِن خِندِفٍ","في أَهلِ مَملَكَةٍ وَمُلكٍ قاهِرِ",10,"ر",1,0],["إِنّي نَدَبتُ فَوارِسي وَفَعالَهُم","وَنَدَبتُ شَرَّ فَوارِسٍ وَفَعالِ",11,"ل",1,0],["إِن يَنتَصِر يَدمى الجَبينُ وَإِن","يُلبَث قَليلاً يودَ بِالرَحلِ",12,"ل",1,0],["إن ينأ عني منك شخصٌ باخلٌ","روحي وما ملكت يديّ فداؤه",13,"ا",3,0],["إنْ يَنأَ عني بابُ أحمدِكمْ","فالآن وافرَحاه بالقرب",14,"ب",1,0],["إن ينج من نار بؤس من لحظت ففي","ولاء مثلك ما يُنجي من النار",15,"ر",1,0],["إن ينْسِني الهمّ منها ما أجيد فما","قصَّرت برّي ولا باعدت إيناسي",16,"ي",1,0],["إن ينأ شخصك إني بعد فرقته","أدنى وأيسر ما قاسيت ما قتلا",17,"ل",2,0],["إنْ يَنْأَ عن جانبي بجانبه","كما اتَّقى مسَّ مصحفٍ جُنُبُهْ",18,"ب",2,0],["إن ينسني عصر الشباب وعهده","عصر فعصركم لذاك خليق",19,"ق",1,0],["إني نَكِرتُ على الليالي أن أتَتْ","ما قد أتتهُ لم يكُنَّ ظنائنا",20,"ن",2,0],["إِنّي نَبَذتُ ثِمارَها مُذ ذُقتُها","وَوَجَدتُ طَعمَ الغَدرِ في أَدراسِ",21,"س",1,0],["إِنّي نَذيرُ الَّتي أَلقَت مَنيئَتَها","عَلى القُعودِ وَحَفَّتها بِأَهدامِ",22,"م",1,1],["اني نبأ الحفل المجيد عشية","فاصبح منه الشعب اجمع مسرورا",23,"ر",2,0],["إني نويت إلى فروق رحلةً","على أنال بها مقاماً يرفع",24,"ع",1,0],["إن ينقموا خلقوا الشقاءو إن رضوا","جعلوا حياة البائسين نعيما",25,"م",2,0],["إِنّي نَظَرتُ إِلى الشُعوبِ فَلَم أَجِد","كَالجَهلِ داءً لِلشُعوبِ مُبيدا",26,"د",2,0],["إِنّي نَزَلتُ بِكَذّابينَ ضَيفُهُمُ","عَنِ القِرى وَعَنِ التَرحالِ مَحدودُ",27,"د",1,0],["إِنّي نَثَرتُ عَلَيكَ دُرّاً فَاِنتَقِد","كَثُرَ المُدَلِّسُ فَاِحذَرِ التَدليسا",28,"س",2,0],["إن يُنْتَجِ النُعمَى سواك فإنَّه","بجميلِ فعلِك لُقِّحَ الإحسانُ",29,"ن",1,0],["إِن يَنجُ مُنهَزِماً رَكضاً فَقَد وَطِئَت","مِنهُ الرِماحُ صَليفَي كاهِلٍ وَقَفا",30,"ف",2,0],["إني نَبَذْتُ على السَّواءِ إليكما","فتأهبَّا للفادحِ المُنتابِ",31,"ب",1,0],["إنّي نَأيتُ وحظِّي حُطَّ منزلةً","كأنّما طول باعي عاقَهُ قِصَرُ",32,"ر",1,0],["إِنِّي نَظَرتُ فَلَم أجِدْ لك فتكَةً","إلّا بِحَدِّ حسامِ لَحظٍ فاتِرِ",33,"ر",1,0],["إِنّي نَظَرتُ وَلا صَوابَ لِعاقِلٍ","فيما يَهُمُّ بِهِ إِذا لَم يَنظُرِ",34,"ر",1,1],["إِن يَنتَخِل حَدَثانُ الدَهرِ أَنفُسَكُم","وَيَسلَمِ الناسُ بَينَ الحَوضِ وَالعَطَنِ",35,"ن",1,0],["إِن يَنجُ مِنكَ أَبو نَصرٍ فَعَن قَدَرٍ","تَنجو الرِجالُ وَلَكِن سَلهُ كَيفَ نَجا",36,"ج",2,0],["إني نذرتُ على مخالفتي لكم","فطراً فكيف أصوم يومَ العيدِ",37,"د",1,0],["إِن يَنسَنا المَوتُ وَيُؤذَن لَنا","نَلقَكَ إِن عُمِّرتَ بِالمَوسِمِ",38,"م",1,0],["إن ينالوا منك ما يُفجِعُنا","فَتَحوا الفتحَ ونالوا المغنما",39,"م",2,0],["إن ينتهوا يَغْفِرْ وإن يتمرَّدُوا","يجدوك غَلَّابَ الصَّرامةِ قاهرا",40,"ر",2,0],["إنّي نصحتُ لِقومي قبل مَصرعِهم","لو أنّ نُصحَ ذوي الألبابِ مقبولُ",41,"ل",1,0],["إِنّي نَصَحتُكَ فَاِتَّهَمتَ نَصيحَتي","وَزَعَمتَ أَنَّكَ ذو تَجارِبَ حُوَّلُ",42,"ل",1,1],["إِنّي نَصَحتُ وَلاتَ حينَ نَصيحَةٍ","وَأَرى المُضَلَّلَ بِالمَلامَةِ يَعجِلُ",42,"ل",1,0],["إِنَّي نَظَرتُ إِلى الحَوادِثِ نَظرَةً","كَشَفَت حَقائِقَها لِعَينِ المُبصِرِ",43,"ر",1,1],["إن يَنفدِ الزّادُ أغناكم وزوّدكم","ما ليس يَنفدُ من تقوىً وإيمانِ",44,"ن",1,0],["إِنّي نَهاني أَن أَذُم","مَكَ ماجِدُ الجَدَّينِ فاخِر",45,"ر",1,0],["إِنّي نَدَبتُ لِحاجَتي رَجُلاً","صافي السَماحَةِ وَاِحتَوى النُبلا",46,"ل",2,0],["أَنّى نَوالُكَ مِن تَذَكُّرِها","وَالحُبُّ قَد نَشِبَت مَخالِبُهُ",47,"ب",2,0],["إِن يَنظُرا أَعيُناً رُمداً فَما رَمِدا","وَلا بِغَيرِ سَوادِ الحِندِسِ اِكتَحَلا",48,"ل",2,0],["إِن يَنقُلُ الحَتفُ عَن عاداتِهِ","فَما تَزالُ مَعانيهُنَّ أَبطالا",49,"ل",2,0],["إنْ يَنمْ فالحياةُ شدوٌ ولهوٌ","أو يُنبّهْ فأدمعٌ وجراحُ",50,"ح",1,0],["إن ينل منك المغيرون فما","فتحوا غير تخومٍ وحدود",51,"د",1,0],["أنّى نَزَلْت بمصرَ أو جاراتِها","جئتَ العُروبَةَ أُمَّةً وبلادَا",52,"د",2,0],["إن يُنْجُ منها ابنُ حَرْبٍ بَعْدَمَا بَلَغَتْ","مِنْهُ التّراقي وأمرُ اللهِ مَفْعُولُ",53,"ل",1,0],["إِنِّي نَزَلْتُ بِجِيرَةٍ","بُسْلٍ عَلَى النَّجَدَاتِ حَشْدِ",54,"د",1,0],["إنْ ينتَسِب سِفرٌ إلي","ه، تاه فخرًا بانتسابه",55,"ب",2,0],["إن ينتفع بيسوع، غنى","باسمه، وترنما",56,"م",2,0],["إن ينسَ ماضيَه مع ال","إسلامِ، فالتاريخُ ذاكر",57,"ر",1,0],["إنِّي نهاني أنْ أَعيبك","ماجدُ الجدَّين فاخر",58,"ر",1,0],["إني نظمت الدمع فيه قصيدة","لما وجدت القول دون رثائه",59,"ا",3,0],["إنْ ينتفضْ فَبِقوةٍ مستغلبٌ","أو ينتهضْ فَبِذِلَّةٍ مغلول",60,"ل",1,0],["إنْ ينسنا الموتُ، ويؤذنْ لنا،","نَلْقَكَ، إنْ عُمِّرْتَ بِکلمَوْسِمِ",61,"م",1,0],["أَني نَحَوتك مَلجأ","وَتَخذت جاهك مَقصَدا",62,"د",2,0],["أني نزيلهم حاشا مكارمهم","ترضى انفصامي مهما ساءبي أدبي",63,"ي",1,0],["إني نثرتُ عليكَ دُر قلائِد","تزرى بكلِّ لآلىءِ ونظامِ",64,"م",1,0],["إنى نصحتكَ فاسْتمسِكْ بنصحِ فتَى","مُشَافِق مُشْفِق صافٍ مِن الكَدَرِ",65,"ر",1,0],["أُنين صدى لأقوام وهام","نجيع دمَائهم بالسيف طلا",66,"ل",2,0],["إِن يَندُبوكَ فَقَد ثُلَّت عُروشُهُمُ","وَأَصبَحَ العِلمُ مَرثِيّاً وَمَندوبا",67,"ب",2,0],["أنينٌ وشكوى في الظلام فإن أمت","فميت الهوى في العاشقين شهيد",68,"د",1,1],["أنينها صَرَّةُ تدويرها","ودمعها ماء قواديسِها",69,"س",3,0],["إِنّي نَظَرتُ إِلى المِرآةِ إِذ جليت","فَأَنكَرَت مُقلَتايَ كُلَّ ما رَأَتا",70,"ت",2,1],["إنّي نَذَرتُ لَئِن رَأَيتُكَ سَالِماً","بِقُرى العِرَاقِ وأنتَ ذُو وَفرِ",71,"ر",1,1],["إِنْ يَنْتَزِحْ نادِيكَ عَنْهُ يَقْتَرِبْ","منْهُ وإِلا تَحْمِهِ يَلجِ الحِمَى",72,"م",2,0],["إِن يَنثُرِ الدُرَّ النَفيسَ بَنانُهُ","يَنظِمهُ بِالأَقلامِ في القِرطاسِ",73,"س",1,0],["إِن يَنأَ فَالأَمجَدُ المَيمونُ طائِرُهُ","لَدَيَّ إِحسانُهُ مازالَ مُقتَرِبا",74,"ب",2,0],["إن ينأَ حيُّك فالهَوى أمَمٌ","أَو تَقصَ دارُك فالحَشى مَغنى",75,"ن",2,0],["إنّي نَزلت كما تَدرون في بلدٍ","مرافق العيشِ عنه كلّها جنبُ",76,"ب",1,0],["أني نظرت فثمّ شعبٌ ضائعٌ","عفن الحياة ممزّق الأشلاء",77,"ا",2,0],["إِن يَنجَح القَصد لِلهَيجاء كُنت أَخاً","أَو لا فَإِنَّ أَخا الصَبر الجَميلِ أَنا",78,"ن",2,0],["إنّي نَشْدتُ لدى ذُراكَ مقاصِدي","فوجَدْتها وقصيدتي لم تُنشَد",79,"د",1,0],["إِن يَنثُروا الدُرَّ مِن مَجدٍ فَما نَثَروا","أَو يَنظِموا الدُرَّ في حَمدٍ فَما نَظَموا",80,"م",3,1],["إِن يَنهَدِم بِكُمُ لِلدَهرِ بَيتُ عُلاً","فَإِنَّ بَيتَ رِثائي لَيسسَ يَنهَدِمُ",81,"م",1,0],["أنِّي نسيتُ حسابَه","فجعلتُ أجعلُه عِدادا",82,"د",2,0],["إن ينصرِف عنك صرفٌ","يَسُؤهُ أن لا يَعودا",83,"د",2,0],["إن ينصرم حبل العيان تباعداً","فالذكر متَّصلٌ بحبل وريدي",84,"ي",1,0],["إن يُنكروا وجدي بهم وصبابتي","فالسّقمُ بيّنةٌ على ما أدّعي",85,"ي",1,0],["إن ينكروا فضله فلا عجب","أن ينكروا حاتماً مع كرمه",86,"م",2,0],["إني نحرت شواغلي","وجلودها جعلت نعالا",87,"ل",2,0],["إن ينكر الأدبا فضلاً خصصت به","فقد أقمت بما أهديته الحججا",88,"ج",2,0],["إنِّي نَعِمْتُ بجاهه وبماله","تَعسَ البخيل بجاهه وبماله",89,"ل",2,0],["إن ينتسبْ لقريشٍ فهي طائفةٌ","إليك بعد رسولِ اللهِ تنتسِبُ",90,"ب",1,0],["إِني نصحتك والمودة بيننا","في اللَه إِن ودادنا أَنساب",91,"ب",1,0],["إني نصحتكمو نصيحة حاذق","حلب الزمان كهولة ورضيعا",92,"ع",2,0],["ان ينل بغية فكم","عمي الدهر في الارب",93,"ب",1,0],["أنى نظرت ترى المناحة حولها ال","أعراس والأحباب في الأعداء",94,"ا",2,0],["أنى نظرت ترى مواكب نسقت","للحب بين ترنم وضياء",95,"ا",2,0],["إنّي نصحتكَ غير راجٍ أن أرى","أملاً يُحققُ لي وحلماً يعتلى",96,"ل",2,0],["إن ينبُ دهرٌ بكم فِقدْماً","لم يخلُ من غدرةٍ وغُولِ",97,"ل",1,0],["إن ينتقِضْ كرُّ الخطو","بِ قُواي واستمرارُها",98,"ر",3,0],["إن ينعموا أو ينقموا فإنما","هم خلج من فيض بحر زاخر",99,"ر",1,0],["إنْ يَنْتَهِكْ في النّاسِ شَرْعَا","فَدْمٌ مِنَ الأغْتَامِ جاهِلْ",100,"ل",1,0],["انّي نَذَرتُ لَئِن لَقَيتُكَ سالِماً","أَن لا أُعالِجَ بَعدَكَ الأَسفارا",101,"ر",2,1],["إنْ ينحفوا لصباً فقد جثموا عُلىً","ولهمْ بفضل الأصل كلُّ عَبولِ",102,"ل",1,0],["إِن يُنصِتِ القَومُ لا يَنطِق بِفاحِشَةٍ","أَو يَنطِقوا فَمُصيبٌ غَيرُ مِهذارِ",103,"ر",1,0],["إِنّي نَظَرتُ إِلى الحورِ الحِسانِ بِها","وَإِنَّما هَمُّهُنَّ اللَهوُ وَاللَعِبُ",104,"ب",1,0],["إنّي نَطَقتُ بما رأيتُ وبعضُهُ","مِمَّا سَمِعتُ فما نَطَقتُ عَنِ الهَوَى",105,"و",2,0],["أن ينصبوا من بعده إماما","برأيهم ينفذ الأحكاما",106,"م",2,0]]}