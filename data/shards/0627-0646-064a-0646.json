9,"إني نظرت الى منيرة ارضكم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573530",""],[5309,"أين كنت ومن انا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573963",""],[520,"في مثل مدحك شرح القول مختصر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577521",""],[6225,"ملجأ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81041&r=&rc=278",""],[6072,"القلبُ إذا تَلَكَّأ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84903&r=&rc=3",""],[4035,"يا يوسف الحسن فيك الصب قد ليما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1517&r=&rc=0",""],[6259,"قسماً بوصلك إنَّ بُعد مرامهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59403&r=&rc=51",""],[2220,"المرجفانِ هما الإبريقُ والطاسُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11260&r=&rc=134",""]],"verses":[["إِنّي نَزَلتُ وَكُنتُ غَيرَ مُذَلَّلٍ","بَيتَ المُهانِ وَأَنتَ عَينُ المُكرَمِ",0,"م",1,0],["إِنّي نَظَرتُ إِلى اليَراعَةِ في يَدي","فَحَسِبتُها في القَدرِ عودَ ثِقابِ",1,"ب",1,0],["إِن يَنكِروا بَعضَ الغُمو","ضِ عَلى أَديبٍ ذي اِقتِدارِ",2,"ر",1,0],["إِن يَنكَدِر بِالأَمسِ نَجمٌ ثاقِبٌ","فَاليَومَ أَقلَعَ عارِضٌ هَطّالُ",3,"ل",1,0],["إنْ يَنْفَصِمْ سَبَبٌ يَصِلهُ وَإنْ يَقَعْ","خَطَلٌ يَذُدْهُ بِمقَاطِعِ البُرْهَانِ",4,"ن",1,0],["إنْ يَنْتَقِلْ مَنْ طَهُّرَتْ رُوحُهُ","مَا فُرْقَهُ الرُّوحِ لِجِثْمَانِ",5,"ن",1,0],["إِنْ يَنْتَقِلْ أَغْنَاطِيُوسُ الثَّانِي","فَإِلَى الخُلُودِ وَكُلُّ حَيٍّ فَانِي",6,"ن",2,1],["أَنيناً وَشَكوى بِالنَهارِ كَثيرَةً","عَلَيَّ وَما يَأتي بِهِ اللَيلُ أَبرَحُ",7,"ح",1,1],["أَنينَ الفَتى المَسلولِ أَبصَرَ حَولَهُ","عَلى جُهدِ حالٍ مِن ثَناياهُ عُوَّدا",8,"د",2,0],["إِنّي نَفَيتُكَ عَن نَجدٍ فَما لَكُمُ","نَجدٌ وَمالَكَ مِن غورِيِّهِ حَجَرُ",9,"ر",1,0],["إِنّي نَزَلتُ بِمُفرَعٍ مِن خِندِفٍ","في أَهلِ مَملَكَةٍ وَمُلكٍ قاهِرِ",10,"ر",1,0],["إِنّي نَدَبتُ فَوارِسي وَفَعالَهُم","وَنَدَبتُ شَرَّ فَوارِسٍ وَفَعالِ",11,"ل",1,0],["إِن يَنتَصِر يَدمى الجَبينُ وَإِن","يُلبَث قَليلاً يودَ بِالرَحلِ",12,"ل",1,0],["إن ينأ عني منك شخصٌ باخلٌ","روحي وما ملكت يديّ فداؤه",13,"ا",3,0],["إنْ يَنأَ عني بابُ أحمدِكمْ","فالآن وافرَحاه بالقرب",14,"ب",1,0],["إن ينج من نار بؤس من لحظت ففي","ولاء مثلك ما يُنجي من النار",15,"ر",1,0],["إن ينْسِني الهمّ منها ما أجيد فما","قصَّرت برّي ولا باعدت إيناسي",16,"س",2,0],["إن ينأ شخصك إني بعد فرقته","أدنى وأيسر ما قاسيت ما قتلا",17,"ل",2,0],["إنْ يَنْأَ عن جانبي بجانبه","كما اتَّقى مسَّ مصحفٍ جُنُبُهْ",18,"ب",2,0],["إن ينسني عصر الشباب وعهده","عصر فعصركم لذاك خليق",19,"ق",1,0],["إني نَكِرتُ على الليالي أن أتَتْ","ما قد أتتهُ لم يكُنَّ ظنائنا",20,"ن",2,0],["إِنّي نَبَذتُ ثِمارَها مُذ ذُقتُها","وَوَجَدتُ طَعمَ الغَدرِ في أَدراسِ",21,"س",1,0],["إِنّي نَذيرُ الَّتي أَلقَت مَنيئَتَها","عَلى القُعودِ وَحَفَّتها بِأَهدامِ",22,"م",1,1],["اني نبأ الحفل المجيد عشية","فاصبح منه الشعب اجمع مسرورا",23,"ر",2,0],["إني نويت إلى فروق رحلةً","على أنال بها مقاماً يرفع",24,"ع",1,0],["إن ينقموا خلقوا الشقاءو إن رضوا","جعلوا حياة البائسين نعيما",25,"م",2,0],["إِنّي نَظَرتُ إِلى الشُعوبِ فَلَم أَجِد","كَالجَهلِ داءً لِلشُعوبِ مُبيدا",26,"د",2,0],["إِنّي نَزَلتُ بِكَذّابينَ ضَيفُهُمُ","عَنِ القِرى وَعَنِ التَرحالِ مَحدودُ",27,"د",1,0],["إِنّي نَثَرتُ عَلَيكَ دُرّاً فَاِنتَقِد","كَثُرَ المُدَلِّسُ فَاِحذَرِ التَدليسا",28,"س",2,0],["إن يُنْتَجِ النُعمَى سواك فإنَّه","بجميلِ فعلِك لُقِّحَ الإحسانُ",29,"ن",1,0],["إِن يَنجُ مُنهَزِماً رَكضاً فَقَد وَطِئَت","مِنهُ الرِماحُ صَليفَي كاهِلٍ وَقَفا",30,"ف",2,0],["إني نَبَذْتُ على السَّواءِ إليكما","فتأهبَّا للفادحِ المُنتابِ",31,"ب",1,0],["إنّي نَأيتُ وحظِّي حُطَّ منزلةً","كأنّما طول باعي عاقَهُ قِصَرُ",32,"ر",1,0],["إِنِّي نَظَرتُ فَلَم أجِدْ لك فتكَةً","إلّا بِحَدِّ حسامِ لَحظٍ فاتِرِ",33,"ر",1,0],["إِنّي نَظَرتُ وَلا صَوابَ لِعاقِلٍ","فيما يَهُمُّ بِهِ إِذا لَم يَنظُرِ",34,"ر",1,1],["إِن يَنتَخِل حَدَثانُ الدَهرِ أَنفُسَكُم","وَيَسلَمِ الناسُ بَينَ الحَوضِ وَالعَطَنِ",35,"ن",1,0],["إِن يَنجُ مِنكَ أَبو نَصرٍ فَعَن قَدَرٍ","تَنجو الرِجالُ وَلَكِن سَلهُ كَيفَ نَجا",36,"ج",2,0],["إني نذرتُ على مخالفتي لكم","فطراً فكيف أصوم يومَ العيدِ",37,"د",1,0],["إِن يَنسَنا المَوتُ وَيُؤذَن لَنا","نَلقَكَ إِن عُمِّرتَ بِالمَوسِمِ",38,"م",1,0],["إن ينالوا منك ما يُفجِعُنا","فَتَحوا الفتحَ ونالوا المغنما",39,"م",2,0],["إن ينتهوا يَغْفِرْ وإن يتمرَّدُوا","يجدوك غَلَّابَ الصَّرامةِ قاهرا",40,"ر",2,0],["إنّي نصحتُ لِقومي قبل مَصرعِهم","لو أنّ نُصحَ ذوي الألبابِ مقبولُ",41,"ل",1,0],["إِنّي نَصَحتُكَ فَاِتَّهَمتَ نَصيحَتي","وَزَعَمتَ أَنَّكَ ذو تَجارِبَ حُوَّلُ",42,"ل",1,1],["إِنّي نَصَحتُ وَلاتَ حينَ نَصيحَةٍ","وَأَرى المُضَلَّلَ بِالمَلامَةِ يَعجِلُ",42,"ل",1,0],["إِنَّي نَظَرتُ إِلى الحَوادِثِ نَظرَةً","كَشَفَت حَقائِقَها لِعَينِ المُبصِرِ",43,"ر",1,1],["إن يَنفدِ الزّادُ أغناكم وزوّدكم","ما ليس يَنفدُ من تقوىً وإيمانِ",44,"ن",1,0],["إِنّي نَهاني أَن أَذُم","مَكَ ماجِدُ الجَدَّينِ فاخِر",45,"ر",1,0],["إِنّي نَدَبتُ لِحاجَتي رَجُلاً","صافي السَماحَةِ وَاِحتَوى النُبلا",46,"ل",2,0],["أَنّى نَوالُكَ مِن تَذَكُّرِها","وَالحُبُّ قَد نَشِبَت مَخالِبُهُ",47,"ب",2,0],["إِن يَنظُرا أَعيُناً رُمداً فَما رَمِدا","وَلا بِغَيرِ سَوادِ الحِندِسِ اِكتَحَلا",48,"ل",2,0],["إِن يَنقُلُ الحَتفُ عَن عاداتِهِ","فَما تَزالُ مَعانيهُنَّ أَبطالا",49,"ل",2,0],["إنْ يَنْقُضِ الدَّهْرُ مِنِّي مِرَّةٍ لِبِلىً","فَالدَّهْرُ أَرْوَد بِالأَقْوَامِ ذُوِ غَيرِ",50,"ر",1,0],["إِنْ يَنْقُصِ الدَّهْرِ مِنِّي فَالْفَتَى غَرَضٌ","لِلدَّهْرِ مِنْ عُودِهِ وَافٍ ومَثْلُومُ",51,"م",1,0],["إنْ يَنمْ فالحياةُ شدوٌ ولهوٌ","أو يُنبّهْ فأدمعٌ وجراحُ",52,"ح",1,0],["إن ينل منك المغيرون فما","فتحوا غير تخومٍ وحدود",53,"د",1,0],["أنّى نَزَلْت بمصرَ أو جاراتِها","جئتَ العُروبَةَ أُمَّةً وبلادَا",54,"د",2,0],["إن يُنْجُ منها ابنُ حَرْبٍ بَعْدَمَا بَلَغَتْ","مِنْهُ التّراقي وأمرُ اللهِ مَفْعُولُ",55,"ل",1,0],["إِنِّي نَزَلْتُ بِجِيرَةٍ","بُسْلٍ عَلَى النَّجَدَاتِ حَشْدِ",56,"د",1,0],["إنْ ينتَسِب سِفرٌ إلي","ه، تاه فخرًا بانتسابه",57,"ب",2,0],["إن ينتفع بيسوع، غنى","باسمه، وترنما",58,"م",2,0],["إن ينسَ ماضيَه مع ال","إسلامِ، فالتاريخُ ذاكر",59,"ر",1,0],["إنِّي نهاني أنْ أَعيبك","ماجدُ الجدَّين فاخر",60,"ر",1,0],["إني نظمت الدمع فيه قصيدة","لما وجدت القول دون رثائه",61,"ا",3,0],["إنْ ينتفضْ فَ