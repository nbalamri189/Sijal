{"poems":[[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131275",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131208",""],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69967","البسيط"],[5092,"إلى الفاتنة","https://www.poetsgate.com/ViewPoem.aspx?id=139721",""],[470,"هذي ذُرى مصر","https://www.poetsgate.com/ViewPoem.aspx?id=63614",""],[5950,"دموع التماسيح ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128120",""],[6147,"سفر على الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=151691",""],[6152,"شكرا لحرفك","https://www.poetsgate.com/ViewPoem.aspx?id=206270",""]],"verses":[["هذي ذد لك عندي لست أكفرها","وإن يكن بعض من آثرتهم كفروا",0,"ر",3,0],["هذي ذراريكم تموت أمامكم","جوعاً ليحيا الغاشمون وينعموا",1,"م",3,0],["هذيذهُ في كِتابِ اللَه متصلٌ","يَختارُ مِنهُ غِذاء النَفس كَاللبَنِ",2,"ن",1,0],["هذي ذنوبُ العاشقاتِ على دمي","هيَّا استعدِّي واحملي أوزاريهْ",3,"ي",2,0],["هذي ذ ُرا مصر كَي تَدنُو لِهَيْبَتِها","أنْشِدْ لَواسْطَعْتَ قُرآنا ًوإنجيلا",4,"ل",2,0],["هذي ذنوبي بين دعوة وتسبيح","علّقتها في رحمة الله وسلّمت",5,"ت",1,0],["هذي ذراعي ،وذا دفئي براحتها..","ما أجمل الدفءَ مِنْ راحٍ.. بِلا مَلَقِ",6,"ق",1,1],["هذي ذرى جيزان تشهد أنكم","طاولتموها همةً ونتاجا",7,"ج",2,0]]}