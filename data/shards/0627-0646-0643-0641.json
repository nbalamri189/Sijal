{"poems":[[57,"قد تخوفت أن أموت من الشوق","https://www.aldiwan.net/poem26536.html","الخفيف"],[53,"إن كفيك لقفل","https://www.aldiwan.net/poem64924.html","مجزوء الرمل"],[87,"رنة الكف فوق خدك اشهى","https://www.aldiwan.net/poem7573.html","الخفيف"],[99,"أبي أخي كعبة آمالنا","https://www.aldiwan.net/poem24966.html","السريع"],[33,"طال ليلي وتعناني الطرب","https://www.aldiwan.net/poem42651.html","الرمل"],[48,"كم تنصح الدنيا ولا نقبل","https://www.aldiwan.net/poem23149.html","السريع"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54844","الخفيف"],[92,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""],[164,"يوم سرور وشفاء صدر","https://www.aldiwan.net/poem59024.html","الرجز"],[190,"إن كف شيخ فقد توفي","https://www.aldiwan.net/poem44104.html","مخلع البسيط"],[302,"هد الحمام لآل عبد مناف","https://www.aldiwan.net/poem33214.html","الكامل"],[500,"يا آل عصم أنتم أولو العصم","https://www.aldiwan.net/poem10276.html","مشطور الرجز"],[500,"ما للخزامى تعود نسرينا","https://www.aldiwan.net/poem10279.html","المنسرح"],[500,"وكلني بالهم والكآبة","https://www.aldiwan.net/poem10290.html","الرجز"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138266",""],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77643","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77577","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77662","الرجز"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44826","الكامل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35803","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125369","الخفيف"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114718","السريع"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88652","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205426","الخفيف"],[3471,"","https://poetry.dctabudhabi.ae/diwan/poem/56424","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74065","المتدارك"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62779","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129443","الكامل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132016","الرمل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66625","الخفيف"],[3910,"","https://poetry.dctabudhabi.ae/diwan/poem/131371","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77136","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77114","البسيط"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123860","الرجز"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139518",""],[4802,"ماخذيت الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=32350",""],[4956,"حي يعزّيه ميت","https://www.poetsgate.com/ViewPoem.aspx?id=1397",""],[5460,"إن كفّي إذا التقينا تراها","https://www.poetsgate.com/ViewPoem.aspx?id=200754",""],[5732,"البارحه يازبن بالقلب هوجاس","https://www.poetsgate.com/ViewPoem.aspx?id=177848",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5956,"الأنثى طهورة ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181856",""],[5997,"الرحى جوعى","https://www.poetsgate.com/ViewPoem.aspx?id=214466",""]],"verses":[["إِنَّ كَفاً إِلَيكُمُ كَتَبَتني","لِشَقيٌ فُؤَدُها في عَذابِ",0,"ب",1,0],["إن كفيكَ لقفلٌ","مُحكمٌ يا ابن جُراشهْ",1,"ش",2,1],["إن كفا كفّت أذاك عن النا","س لكف خليقة بالفخار",2,"ر",1,0],["إنك فردّ دون ثانٍ ولن","يرى لهذا النبل أشباه",3,"ا",2,0],["إِنَّ كَفّي لَكِ رَهنٌ بِالرِضا","فَاِقبَلي يا هِندُ قالَت قَد وَجَب",4,"ب",1,0],["إِن كُفَّ ما بَينَهُمُ حازِمٌ","فَلُبُّهُ المُطلَقُ لا يُكبَلُ",5,"ل",1,0],["إنّ كَفّي لا تَحْلُبُ الخِلْفَ لكِنْ","تَحْلُبُ الساقَ مُشْرِقاً مُسْتَطيرا",6,"ر",2,0],["إِنَّ كَفْراً يُدْعى مُصَيْلِحَة","سَمَّاهُ لاَ شَكَّ أَلْمَعِيٌّ خَبِيرُ",7,"ر",1,0],["إن كفاً قاست عليك لباساً","مثلَ هذا مهّارةٌ شيطانه",8,"ن",2,0],["ان كفرته فتية أنعمه","فالله لا يرضى لنا بالكفر",9,"ر",1,0],["إن كفّ شيخ فقد توفّي","وفات من موته حياته",10,"ت",2,1],["إِن كفَّنوكَ فإِنَّ جسمَك لَم يَزل","يَختالُ في بُردي تُقىً وعَفافِ",11,"ف",1,0],["إنك في الناس كبُرء في سقم","يا فرق ما بين الوجود والعدم",12,"م",1,0],["إن كف عن زلة فلا رعة","أو عف عن خَلة فلا دينا",13,"ن",2,0],["إنك في الطعنِ على الشيخين","والقدح في السَّيِّد ذي النورين",14,"ن",1,0],["أنك فيما كنت قد شهدت","والله في ذلك قد كذبت",15,"ت",1,0],["إن كف كفك عن حباء خليلة","عن حوضها لا ريب أنت مذود",16,"د",1,0],["إِنَّك في الغِناءِ تَحكي العودا","وَتَستَعير الصَوت مِن داودا",17,"د",2,0],["إِنَّك في جَوّ السَما وَحيدَه","وَعَن بِحار أَرضِنا بَعيدَه",18,"ه",1,0],["إِنَّك في كُل الأُمور مدّعي","تخبط كَالعَشواءِ وَهيَ لا تَعي",19,"ي",1,0],["إِن كَفَّ عَنّي طَرفُهُ","فالسَّيفُ أَضعَفُ نَاصِرَا",20,"ر",2,0],["إِنَّ كَفّي مُحَمَّدٍ لَتَجودا","نِ عَلى مُجتَديهِ جودَ الغَمامِ",21,"م",1,0],["إنَّ كَفَّ المعونةِ اليَومَ قَصدي","فهي كفٌّ من هاطلِ الغَيثِ أندى",22,"د",2,0],["إن كُفِرَ الكَرمُ فما زلتَ ذا","جَيبٍ على الإيمان مَزرُورِ",23,"ر",1,0],["ان كفا تجاه نعشك مدت","طالما قد مددتها مستنيلا",24,"ل",2,0],["إن كف الذكرى تصور في الخا","طر رسم الماضي الجديد القديم",25,"م",1,1],["إنَّ كفّاً إيلكَ قد بعثَتْني","في شَقَاءٍ مُواصَلٍ وعذابِ",26,"ب",1,0],["إن كفرتَ أَو","مسّك اللمم",27,"م",1,0],["أنكفْكِفُ الآمالَ جَرحى بَعْدَما","أصبحتَ غوثَ المستجيرِ المُنْعِمِ",28,"م",1,0],["ان كف سرح المال عنك فانما","في جود كفك تضرب الأمثال",29,"ل",1,0],["إن كفا أنقذ الله بها","جاهلا لهي محل الاحترام",30,"م",1,0],["إنَّ كَفّاً إلَيْكَ قَدْ كَتَبَتْهَا","تَتَهادَى ما بَيْنَ سُكْرٍ وَشُكْرِ",31,"ر",1,0],["ان كفت العين عن برج البكاء همت","والقلب ان ذدته عن همّه بهم",32,"م",1,0],["إِن كَفَّ واكف مزنة فَبِكَفِّهِ","في المَحَلِّ يَروي كُلُّ ذي فَقرٍ صَدي",33,"د",2,0],["إِن كَفَّ نوءُ وَلِيٍّ سَحب وابِلُه","أَو لَم تَكُن دَجلَة تَجري إِلى أَمَد",34,"د",1,0],["انك في الناس كبرءٍ في سقم","فاسلم ودم بالسعد ما سحت ديم",35,"م",1,0],["إن كفَّ عني الفضل إني امرؤٌ","لي في عمومس من عطاه نصيب",36,"ب",1,0],["إنكفوا شدوا وشد الصبح عني","خلوا الظلما تشكل ألف زول",37,"ل",1,0],["إن كَفَفْنا دمع العيون عزاءً","إن للقلب أدمعًا قد خَفينا",38,"ن",2,0],["إن كفّي إذا التقينا تراها","تتنزى الى قفا حيان",39,"ن",1,1],["ان كفني وقتي بالانياب وضروس","شكيت للي عز بالغار الاثنين",40,"ن",1,0],["ان كف همال الحيا وامحل الوطا","وشحشح عن الطفل الرضيع غذاه",41,"ا",2,0],["‏ ‏إنّ كفْر المرء بالنُّعْمَى دعاه","‏ ‏ بعد أن يشبعَ إلقاءَ الفطيرةْ",42,"ر",2,0],["أنْ كفى ماْ قد مضى من ماضياتٍ","حان وعد الله مولى كل زاهدْ",43,"د",1,0]]}