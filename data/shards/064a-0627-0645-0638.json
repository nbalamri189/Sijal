{"poems":[[83,"أللمحة من بارق متبسم","https://www.aldiwan.net/poem54240.html","الكامل"],[83,"زار الخيال بأيمن الزوراء","https://www.aldiwan.net/poem54344.html","الطويل"],[51,"يا مظهرا نخوة عند اللقاء لنا","https://www.aldiwan.net/poem61944.html","البسيط"],[48,"يا مظهرا شكوى على صرمه","https://www.aldiwan.net/poem64341.html","السريع"],[48,"أَظهر بعد الوصلِ هجرانا","https://www.aldiwan.net/poem66114.html","السريع"],[110,"يا مظهر النسك والأنام به","https://www.aldiwan.net/poem16583.html","المنسرح"],[116,"يا مظهر الحسن الجليل","https://www.aldiwan.net/poem40608.html","عموديه"],[116,"روحي وأرواح الوجود","https://www.aldiwan.net/poem42166.html","مجزوء الكامل"],[365,"لمن الركائب سيرهن تهاد","https://www.aldiwan.net/poem60948.html","الكامل"],[375,"يا مظهر العقل في ولايته","https://www.aldiwan.net/poem4134.html","المنسرح"],[469,"يا مظهرا لي هيبة بحجابه","https://www.aldiwan.net/poem60465.html","الكامل"],[559,"لا تمش معه كما ترى","https://www.aldiwan.net/poem34486.html","مجزوء الكامل"]],"verses":[["يا مظهر الألطاف وهي خفيّةٌ","ومُهِبَّ ريحِ النصر للمتنسِّم",0,"م",1,0],["يا مُظْهِر الحقِّ الجليِّ ومُطْلِعَ ال","نّورِ السَّنِيِّ الساطعِ الأَضواءِ",1,"ا",2,0],["يا مُظْهراً نَخْوةً عند اللقاء لنا","وكاسراً طرفَه من غير ما رمدِ",2,"د",1,1],["يا مُظهِراً شَكوى عَلى صَرمِهِ","مُقَبِّحاً خُلقي لَدى الناسِ",3,"س",1,1],["يا مُظهِراً في النَومِ هِجرانا","حَسبُكَ ما تَفعَلُ يَقظانا",4,"ن",2,0],["يا مظهر النسك وَالأَنام بِهِ","تَهتكوا لا عَدمت لُقياكا",5,"ك",2,1],["يا مظهر الحسن الجليل","والظرف واللطف الجزيل",6,"ل",1,1],["يا مظهر الرحموت في الد","نيا وفي دار الخلود",7,"د",1,0],["يا مُظهرِين لبَعْضِ ما يُخْفى لهم","بُعْدُ النّوى من خِلّةٍ ووِداد",8,"د",1,0],["يا مُظهرَ العَقل في وِلايته","كيف ما زِلتَ ظاهرَ النَزَقِ",9,"ق",1,1],["يا مظهَراً لي هَيبَةً بِحِجابِهِ","وَالكَلبُ يَأنَفُ أَن يَجوزَ بِبابِهِ",10,"ه",1,1],["يا مظهر الحق المبي","ن انظر لربك من ورا",11,"ر",2,0]]}