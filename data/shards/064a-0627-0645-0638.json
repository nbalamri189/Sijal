{"poems":[[85,"أللمحة من بارق متبسم","https://www.aldiwan.net/poem54240.html","الكامل"],[85,"زار الخيال بأيمن الزوراء","https://www.aldiwan.net/poem54344.html","الطويل"],[53,"يا مظهرا نخوة عند اللقاء لنا","https://www.aldiwan.net/poem61944.html","البسيط"],[50,"يا مظهرا شكوى على صرمه","https://www.aldiwan.net/poem64341.html","السريع"],[50,"أَظهر بعد الوصلِ هجرانا","https://www.aldiwan.net/poem66114.html","السريع"],[113,"يا مظهر النسك والأنام به","https://www.aldiwan.net/poem16583.html","المنسرح"],[119,"يا مظهر الحسن الجليل","https://www.aldiwan.net/poem40608.html","عموديه"],[119,"روحي وأرواح الوجود","https://www.aldiwan.net/poem42166.html","مجزوء الكامل"],[369,"لمن الركائب سيرهن تهاد","https://www.aldiwan.net/poem60948.html","الكامل"],[379,"يا مظهر العقل في ولايته","https://www.aldiwan.net/poem4134.html","المنسرح"],[473,"يا مظهرا لي هيبة بحجابه","https://www.aldiwan.net/poem60465.html","الكامل"],[563,"لا تمش معه كما ترى","https://www.aldiwan.net/poem34486.html","مجزوء الكامل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122378","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70746","البسيط"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61163","المنسرح"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102299","البسيط"],[2111,"","https://poetry.dctabudhabi.ae/diwan/poem/119216","البسيط"],[2231,"","https://poetry.dctabudhabi.ae/diwan/poem/124055","الكامل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132336","الكامل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100909","الخفيف"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87583","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89419","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89085","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45787","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135921","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135737","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135800","الرجز"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81238","البسيط"],[4418,"","https://poetry.dctabudhabi.ae/diwan/poem/95771","السريع"],[5324,"يامظهر الإحسان.","https://www.poetsgate.com/ViewPoem.aspx?id=211078",""],[5324,"يامظهر الوجه الضحك.","https://www.poetsgate.com/ViewPoem.aspx?id=211079",""],[5324,"اليقين .","https://www.poetsgate.com/ViewPoem.aspx?id=211660",""],[5442,"يا مظهر حب الرسول وجهله","https://www.poetsgate.com/ViewPoem.aspx?id=114781",""],[5582,"ما لِلْحَمائِمِ لا يَنْفَكُّ نائِحُها","https://www.poetsgate.com/ViewPoem.aspx?id=186834",""],[5853,"ظلمة الشك","https://www.poetsgate.com/ViewPoem.aspx?id=175613",""],[6093,"الوقت حب","https://www.poetsgate.com/ViewPoem.aspx?id=194334",""]],"verses":[["يا مظهر الألطاف وهي خفيّةٌ","ومُهِبَّ ريحِ النصر للمتنسِّم",0,"م",1,0],["يا مُظْهِر الحقِّ الجليِّ ومُطْلِعَ ال","نّورِ السَّنِيِّ الساطعِ الأَضواءِ",1,"ا",2,0],["يا مُظْهراً نَخْوةً عند اللقاء لنا","وكاسراً طرفَه من غير ما رمدِ",2,"د",1,1],["يا مُظهِراً شَكوى عَلى صَرمِهِ","مُقَبِّحاً خُلقي لَدى الناسِ",3,"س",1,1],["يا مُظهِراً في النَومِ هِجرانا","حَسبُكَ ما تَفعَلُ يَقظانا",4,"ن",2,0],["يا مظهر النسك وَالأَنام بِهِ","تَهتكوا لا عَدمت لُقياكا",5,"ك",2,1],["يا مظهر الحسن الجليل","والظرف واللطف الجزيل",6,"ل",1,1],["يا مظهر الرحموت في الد","نيا وفي دار الخلود",7,"د",1,0],["يا مُظهرِين لبَعْضِ ما يُخْفى لهم","بُعْدُ النّوى من خِلّةٍ ووِداد",8,"د",1,0],["يا مُظهرَ العَقل في وِلايته","كيف ما زِلتَ ظاهرَ النَزَقِ",9,"ق",1,1],["يا مظهَراً لي هَيبَةً بِحِجابِهِ","وَالكَلبُ يَأنَفُ أَن يَجوزَ بِبابِهِ",10,"ه",1,1],["يا مظهر الحق المبي","ن انظر لربك من ورا",11,"ر",2,0],["يا مظىء الخيل كأن ليس لها","غير دماء الصيد من مناهل",12,"ل",1,0],["يا مظهراً كلَّ فعل من محامدِه","وكلَّ سعْىٍ بعون اللَّه مشكور",13,"ر",1,0],["يا مظهراً للضمير ما شجره","لَيسَت إِذا أَثمَرَت بمبتكره",14,"ر",2,1],["يا مظهراً بمحياه وطرته","فضيلة الجمع بين الصبح والغسق",15,"ق",1,0],["يا مظميء الخيل أو تروى ذوابله","والخيل تشرب من أشداقها اللجم",16,"م",1,0],["يا مظهرا ماشا ويخفى ما يشا","ببدائع الإخفاء والإظهار",17,"ر",1,0],["يا مُظهِرَ الأسمَاءِ مَنبَعَ سرِّها","قُطبَ المكونِ مجمعاً أفذاذا",18,"ذ",2,1],["يا مُظِلَّ الرجال من لفحة ال","عَيشِ أجبتَ الآمالَ قبل النداء",19,"ا",2,0],["يا مُظهِرَ العدل في قطرٍ بِهِ هَتَفَت","بشائرُ السعد تجري كأَسُهُ رَغَدا",20,"د",2,1],["يا مظهر الأنوار والأزهار وال","أثمار في روض غدا بك زاهيا",21,"ي",2,1],["يا مَظهَرَ الأسرار والأنوار بل","يا كوكب الأسحار حلف السهد",22,"د",1,0],["يا مَظهَر الوَحي المُنيف وَقبلة ال","دين الحَنيف المُعتلى تَشريفا",23,"ف",2,0],["يا مُظهرَ الكمال في ذي النقصِ","يا مَنْ يُنالُ فضلُه بالنصِّ",24,"ص",1,1],["يا مظهرٌ موسِّعٌ وماهرُ","أظهرْ لفضلي لا يضرُّ ناكرُ",25,"ر",1,0],["يا مظهر الإصباحِ بعد الليلِ","بك احفظنَّا من جميع ويلِ",26,"ل",1,1],["يا مُظلم الروح كَم تَشقى عَلى حَرق","مِما يُكابد مِنكَ القَلب وَالرُوح",27,"ح",1,1],["يا مُظهراً آية موسى لنا","إِلَيكَ من دون الهوى المَهربِ",28,"ب",1,0],["يامظهر الإحسان أنت شراعها","لو كان دهرك بالعدالة انصفا",29,"ف",2,0],["يا مظهر الوجه الضحوك..مباركٌ","لك ما زرعت وما جنيت..مؤيّدا",30,"د",2,0],["يا مظهرَ العجبِ العجابِ تحيّةً","آثرت تبذلُ والزمانُ ضنينُ",31,"ن",1,0],["يا مظهر الحبّ العظيم لأهله","كلّ العراق لشخصكم (ممنونُ)",31,"ن",1,0],["يا مظهر حب الرسول وجهله","يغزيه من سفه ببعض صحابه",32,"ب",2,1],["يا مُظْهِرَ اللَّوْمِ فِيما لَيْسَ يَعْلَمُهُ","رِفْقاً بِنَفْسٍ هَواها لا يُسانِحُها",33,"ح",3,0],["يا مظلما نور الصباح ليَ المدى","حجبتْ سنا نوري اليك ظنون",34,"ن",1,0],["يَا مُظْهِرَ البَسَمَاتِ والضَّحَكَاتِ","يَا مُبْطِنَ الأنَّاتِ والآهَاتِ",35,"ت",1,1]]}