 الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[58,"ألا هل إلى طول الحياة سبيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15571&r=&rc=97",""],[86,"لا تلم كفى إذا السيف نبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69178&r=&rc=65",""],[30,"أَلا حَيِّ دَاراً قَدْ أَبَانَ مُحِيلُهَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20509&r=&rc=3",""],[31,"أعبدة ُ، ما ينسى مودتكِ القلبُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18790&r=&rc=53",""],[88,"انظر الى تلك المعلقة التي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19580&r=&rc=83",""]],"verses":[["قَطَعَ الهُوَينا وَاِستَمَرَّ وَإِنَّما","بَعضُ التَوَكُّلِ في الأُمورِ تَوانِ",0,"ن",1,0],["قَطَّعتَ أَنفاسَ الحِمامِ بِجَريِها","حَتّى كَبا في الهامِ وَالأَبدانِ",1,"ن",1,0],["قَطَعتُ مَفازَةَ هَذا الرَجاءِ","وَلَكِنَّ جَدّي بَعيدُ المَرامِ",2,"م",1,0],["قَطَعتُ وَكالِئَتي هِمَّةٌ","إِذا أَسمَعَ الرُعبُ قالَت صَمامِ",2,"م",1,0],["قَطَعتَ يا اِبنَ واصِلٍ مُدَّةَ العُم","رِ فَهاجَ الضُبارِمُ الفَتّاكا",3,"ك",2,0],["قَطوعٌ لِأَقرانِ الرِجالِ كَأَنَّني","إِلى كُلِّ فَجٍّ ثائِرُ الرَحلِ نازِعُ",4,"ع",1,0],["قَطَعَ المَوتُ بَينَنا فَتَبايَن","نا لِقاءً إِلّا نِزاعاً وَذِكرا",5,"ر",2,0],["قَطَعَ الزَمانُ لِسانَكَ العَضبَ الشَبا","وَهَدى تَخَمُّطَ فَحلِكَ الهَدّارِ",6,"ر",1,0],["قَطَعَ الزَمانُ قِبالَ نَعلِكَ فَاِنتَعِل","أُخرى تَقيكَ مِنَ العِثارِ وَجَدِّدِ",7,"د",1,0],["قَطَعتَ بِمَطرَبَيهِ عَلى تَمارٍ","خِلاجَ الشَكِّ إِنَّ لَهُ خِلاجا",8,"ج",2,0],["قَطاةً عَزَّها شَرَكٌ فَباتَت","تُجاذِبُهُ وَقَد عَلِقَ الجَناحُ",9,"ح",1,0],["قَطَعَتْ سُيُوفَكَ كُلَّ حُكْمٍ قَاطِعٍ","وَقَضَتْ سُعُودُكَ قَبْلَ كُلَّ مُنَجِّمِ",10,"م",1,0],["قُطْناً تَراكَمَ في الأغْصانِ إذ قَذَفَتْ","لَفائِفَ الثّلْجِ في أعْلاهُ قوْسُ قُزَحْ",11,"ح",1,0],["قطَعْنَ إلى الْبيْتِ الْعَتِيقِ عَلَى الْوَجَى","مَفَاوِزَ لاَ تَنْجُو بِهِنَّ النَّجَائِبُ",12,"ب",1,0],["قَطُوفٌ إِذا تَمشي تَخالُ دِماءَها","تَسايَلُ أَو تَبدو لَها بتَقَطُّرِ",13,"ر",1,0],["قطعتُ إِذا كانَ السَرابُ كَأَنَّهُ","سَحابٌ عَلى أَعجازِهِ مُتَنَصِّبُ",14,"ب",1,0],["قَطَعتُ بِصَهباءِ السَراةِ شِمِلَّةٍ","مَروحِ السُرى وَالغِبِّ مِن كُلِّ مَسأَدِ",15,"د",1,0],["قَطَعتُ إِذا خَبَّ رَيعانُها","بِعَرفاءَ تَنهَضُ في آدِها",16,"د",3,0],["قَطَعتُ وَصاحِبَي سُرُحٌ كِنازٌ","كَرُكنِ الرَعنِ ذِعلِبَةٌ قَصيدُ",17,"د",1,0],["قَطَعتُ إِذا سَمِعَ السامِعو","نَ لِلجُندُبِ الجَونِ فيها صَريرا",18,"ر",2,0],["قَطَعتُ إِذا ما اللَيلُ كانَت نُجومُهُ","تَراهُنَّ في جَوِّ السَماءِ سَوامِكا",19,"ك",2,0],["قَطَعتُ إِذا خَبَّ رَيعانُها","وَنُطِّقَ بِالهَولِ أَغفالُها",20,"ل",3,0],["قَطَعتُ بِرَسّامَةٍ جَسرَةٍ","عَذافِرَةٍ كَالفَنيقِ القَطِم",21,"م",1,0],["قَطَعتُ إِذا خَبَّ رَيعانُها","بِدَوسَرَةٍ جَسرَةٍ كَالفَدَن",22,"ن",1,0],["قَطَعتُ يُماشيني بِها مُتَضائِلٌ","مِنَ الطُلسِ أَحياناً يَخُبُّ وَيَعسِلُ",23,"ل",1,0],["قَطَفَ المَوتُ بَواكيرَ النُهى","فَجَنى أَجمَلَ طاقاتِ الزَهَر",24,"ر",1,0],["قَطَّبَت ما بَينَ عَينَيها لَنا","فَرَأَيتُ المَوتَ فيها قَطَّبا",25,"ب",2,0],["قَطَعنا نِياطَ العيسِ نَحوَ ابنِ حُرَّةٍ","صَفَت عِندَهُ لِلمُعتَفينَ المَشارِبُ",26,"ب",1,0],["قَطَعتَ بِمِجذامِ الرَواحِ كَأَنَّها","إِذا حُطَّ عَنها كورُها جَمَلٌ صَعبُ",27,"ب",1,0],["قَطَرَاتٌ مِنْ نَدَى هِمَهمٍ","مُثْمِرَاتٌ كَنَدَى السُّحْبِ",28,"ب",1,0],["قطعة حلوى أبدعت في مثال","بض خبيث اللحظ حلو الدلال",29,"ل",1,0],["قَطَفَتْ بَوَاكِيرَ الوُرُودِ وَقَلَّمَتْ","أَشْوَاكَهَا لِتَحِيَّةٍ وَسَلامِ",30,"م",1,0],["قَطَعتُ بِصَهباءِ العَثانينِ أَسأَرَت","سُرى اللَيلِ مِنها آلَ قَرمٍ ضُبارِمِ",31,"م",1,0],["قَطَعتُ بِفِتيَةٍ وَبِيَعمَلاتٍ","تُلاطِمُهُنَّ هاجِرَةٌ هَجومُ",32,"م",1,0],["قَطوفُ الخُطى عجَزاءُ لا تَنطِقُ الخَنا","خَلوبٌ لأَلبابِ الرِجالِ مَطولُها",33,"ل",3,0],["قَطَعتُ عَلى مَضبورَةٍ أُخرَياتُها","بَعيدَةِ ما بَينَ الخِشاشَةِ وَالرَحلِ",34,"ل",1,0],["قَطَعتُها بِفِتيَةٍ أَزوالِ","عَلى مَهارى رُجَّفِ الأَنعالِ",35,"ل",1,0],["قَطَعتُ بِنَهّاضٍ إِلى صُعُداتِهِ","إِذا شُمِّرَت عَن ساقِ خِمسٍ ذَلاذِلُه",36,"ل",2,0],["قَطَعتُ إِذا تَجَوَّفَت العَواطي","ضُروبَ السِدرِ عُبرّياً وَضالا",37,"ل",2,0],["قِطافَ الخُطى مُلتَفّةً رَبَلاتُها","مِنَ اللَّفّ أفخاذاً مؤزَّرةً كِفلا",38,"ل",2,0],["قَطَعتُ عَلَيها غَولَ كُلِّ تَنوفَةٍ","وَقَضَّيتُ حاجاتي تَخُبُّ وَتَعِنقُ",39,"ق",1,0],["قَطَعتُ بِها أَرضا تَرى وَجهَ رَكبِها","إِذا ما عَلَوها مُكفَأً غَيرَ ساجِعِ",40,"ع",1,0],["قَطَعتُ وَرَقراقُ السَرابِ كَأَنَّهُ","سَبائِبُ في أَرجائِهِ تَتَرَيَّعُ",41,"ع",1,0],["قَطَعتُ وَلَيلي غائِبُ الضَوءِ جَوزَهُ","وَأَكنافَهُ الأُخرى عَلى الأَرضِ واضِعُ",42,"ع",1,0],["قَطَعتُ بِخَلقاءِ الدُفوفِ كَأَنَّها","مِنَ الحُقبِ مَلساءُ العَجيزَةِ ضامِرُ",43,"ر",1,0],["قَطَعتث إِذا هابَ الضَغابيسُ هَولَها","عَلى كورِ إِحدى المُشرِفاتِ الغَوارِبِ",44,"ب",1,0],["قَطَعتُ بِهِ لَيلاً عَلى كورِ نِضوَةٍ","تُعاطي زِمامي تَارَةً وَتُجاذِبُه",45,"ب",2,0],["قطعت به ليلاً يطارحني الجوى","فآونَةً يبدو وآونةٌ يخفَى",46,"ف",2,0],["قَطفت أبواعكم عن كَثَب","كل مجد شاهق المُقتطَف",47,"ف",1,0],["قَطعُ الدِبارِ وَأَبرُ النَخلِ عادَتُهُم","قِدماً فَما جاوَزَت هاذا مَساعيها",48,"ي",3,0],["قَطَعنَ بِنا عَرضَ السَماوَةِ هَزَّةً","كَما هَزَّ أَمراساً بِلينَةَ ماتِحُ",49,"ح",1,0],["قَطَعنَ الدَوَّ وَالأَدَمى إِلَيكُم","وَمَطلَبُكُم مِنَ الأَدمى بَعيدُ",50,"د",1,0],["قَطَعنَ إِلَيكُمُ مُتَشَنَّعاتٍ","مَهامِهِ ما يُعَدُّ لَهُنَّ ميلُ",51,"ل",1,0],["قَطَعَ الخَليطُ وِصالَ حَبلِكَ مِنهُمُ","وَلَقَد يَكونُ بِحَبلِهِم مَوصولا",52,"ل",2,0],["قَطَعتُ بِشَجعاءِ الفُؤادِ نَجيبَةٍ","مَروحٍ إِذا ما النِسعُ غُرِّزَ فاضِلُه",53,"ل",2,0],["قَطَعتُ بِمِرداةٍ كَأَنَّ نُسوعَه","تَشُدُّ عَلى قَرمٍ عَلَندي مَخاطِرِ",54,"ر",1,0],["قطعت ظلام ليلته ويوماً","يكاد حصى الأكام به يذوبُ",55,"ب",1,0],["قطعتم لساني عن عدو تنالكم","عقاربُه تلداغُها ودبيبها",56,"ب",3,0],["قَطَعنَ إِلى الجِبارِ بِنا مَعاناً","وَنَكَّبنَ الصُبَيرَةَ وَالقِبابا",57,"ب",2,0],["قَطَعتُ إِذا خَبَّ جاري السَرابِ","بِهَوجاءَ يَلعَبُ شَيطانُها",58,"ن",3,0],["قطعت باليأس آمالي لديك فقد","تركتني أصحب الدنيا بلا أمل",59,"ل",1,0],["قطعت بها أيدي وأرجل حاسدٍ","كما تتلوّى في الصعيد الأراقم",60,"م",1,0],["قطعوا الوصول وعوَّضوا غيري وما","جاروا ابن عمهمُ ولا ظلموني",61,"ي",1,0],["قَطَع الجَبُّ بالخَصِيِّ كما يَق","طَعُ فَقْدُ المُرْدِيِّ بالملّاح",62,"ح",1,0],["قطعوا لسان سَفاهِهِ فاستوثقوا","منه وأما عن أذاه فحادوا",63,"د",3,0],["قطعتْ شبيبتَها زِناً وسماحةً","وتجارةً خُسْراً لذاك المَتْجَر",64,"ر",1,0],["قطعَ اللَّهُ عذرَ مَنْ أبواهُ","هاشميّانِ أن يكونَ بخيلا",65,"ل",2,1],["قَطْرُ سهميكَ من دماء المحبي","ن على وجنتيكَ غير خَفيِّ",66,"ف",2,0],["قَطَعَ الغُزاةُ عِجافَهُنَّ وَأَصحَبَت","جُردٌ صَلادِمُ قُرَّحٌ وَذُكورُ",67,"ر",1,0],["قَطَعتُ بِهَوجاءِ النَجاءِ نَجيبَةٍ","عُذافِرَةٍ تَهدي المَطِيَّ المُخَزَّما",68,"م",2,0],["قَطاةٌ كَكُردوسِ المَحالَةِ أَشرَفَت","إلى سَنَدٍ مِثلِ الغَبيطِ المُذَأَّبِ",69,"ب",1,0],["قَطَعَ القُنوطُ عَلَيهِ خَيطَ رَجائِهِ","وَالمَرءُ لا يَحيا بِغَيرِ رَجاءِ",70,"ا",2,0],["قَطَعتُ بِاليَأسِ حِوطَ المُنى","وَقُلتُ لِلسَلوانِ لا تَبعُدِ",71,"د",1,0],["قَطَنا بَنوكِ اليَومَ قَد نَهَضوا","فَتَجَمَّدي بِبَنيكِ يا قَطَنا",72,"ن",2,0],["قَطَعتُ بِها شَكُّ الخِلاجِ وَلَم أَقُل","لِخَيّابَةٍ هَيّابَةٍ كَيفَ تَأمُرُ",73,"ر",1,0],["قَطَرِيَّةٌ وَخِلالُها مَهرِيَّةٌ","مِن عِندِ ذاتِ سَوالِفٍ غُلبِ",74,"ب",1,0],["قَطَعوا اليَمامَةَ يَطرُدونَ كَأَنَّهُم","قَومٌ أَصابوا ظالِمينَ قَتيلا",75,"ل",2,0],["قَطَّعتَ قَلبي الَّذي أَعطاكَ جَوهَرَهُ","إِنّي وَهَبتُكَ مَحضَ النَفسِ وَالكَبِدِ",76,"د",1,0],["قطعت وصل الغانيا","ت قطع حبل مبرم",77,"م",1,0],["قَطَعتَ طَوالَي لَيلِها وَنَهارِها","بِآمالِ نَفسٍ في الكَمالِ رِغابِ",78,"ب",1,0],["قَطيعٌ يُزَجّيهِ راعٍ مِنَ الدَه","رِ لَيسَ بِلَينٍ وَلا صُلَّبِ",79,"ب",1,0],["قَطرَةٌ مِن دَمِهِم في مُلكِهِ","تَملَأُ المُلكَ جَمالاً وَنِظاما",80,"م",2,0],["قِطارُهُم كَالقَطرِ هَزَّ الثَرى","وَزادَهُ خِصباً عَلى خِصبِهِ",81,"ب",2,0],["قَطَّعتَهُم حَسَداً أَراهُم ما بِهِم","فَتَقَطَّعوا حَسَداً لِمَن لا يَحسُدُ",82,"د",1,0],["قَطَفَ الرِجالُ القَولَ وَقتَ نَباتِهِ","وَقَطَفتَ أَنتَ القَولَ لَمّا نَوَّرا",83,"ر",2,0],["قَطَّعتِ ذَيّاكِ الخُمارَ بِسَكرَةٍ","وَأَدَرتِ مِن خَمرِ الفِراقِ كُؤوسا",84,"س",2,0],["قَطَعَت مَكارِمُهُم صَوارِمَهُم","فَإِذا تَعَذَّرَ كاذِبٌ قَبِلوا",85,"ل",3,0],["قَطَعتُ بسَيري كلَّ يهماءَ مفزَعِ","وجُبتُ بخيلي كلَّ ص