om/ViewPoem.aspx?id=208491",""],[5736,"أوجاع الغياب","https://www.poetsgate.com/ViewPoem.aspx?id=208858",""],[5751,"أنثى الماس","https://www.poetsgate.com/ViewPoem.aspx?id=214776",""],[5918,"أُحبُّكِ فلتسألي الذَّارياتِ","https://www.poetsgate.com/ViewPoem.aspx?id=177711",""],[5943,"كَشَفَتْ غطاها","https://www.poetsgate.com/ViewPoem.aspx?id=34277",""],[5956,"لو تحوَّلتُ لنور","https://www.poetsgate.com/ViewPoem.aspx?id=185270",""],[5956,"معنى جديد لعبارة شُذَّاذ الأفق","https://www.poetsgate.com/ViewPoem.aspx?id=192723",""],[5973,"ضاع عام في الخصام وأكثر","https://www.poetsgate.com/ViewPoem.aspx?id=13685",""],[6068,"لُبنى -11-","https://www.poetsgate.com/ViewPoem.aspx?id=175839",""],[6068,"عيناك من عين المها -13-","https://www.poetsgate.com/ViewPoem.aspx?id=175846",""],[6068,"الجمال -03-","https://www.poetsgate.com/ViewPoem.aspx?id=175908",""],[6102,"حطب الحقد","https://www.poetsgate.com/ViewPoem.aspx?id=183654",""],[6124,"ما لقلبك","https://www.poetsgate.com/ViewPoem.aspx?id=201228",""],[6125,"فُؤادِي جَذوَةٌ وَهَوَاكِ زَيتُ","https://www.poetsgate.com/ViewPoem.aspx?id=207909",""],[243,"أراها غدا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68171&r=&rc=163",""],[6229,"القبّرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65189&r=&rc=15",""],[5490,"العمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81965&r=&rc=52",""],[6304,"الشمس الجريحة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1611&r=&rc=1",""]],"verses":[["فَتَغَمَّرَت نَفساً وَأَدرَكَ شَأوُها","عُصَبَ القَطا يَهوينَ لِلأَذقانِ",0,"ن",1,0],["فتَغَلَّلَتْ من تِبْرها بِغُلالةٍ","وتوشَّحت مِنْ دُرِّهَا بوشاح",1,"ح",1,0],["فتغنّتْ فهزَّني القرُّ حتى","خلت أني في وسْط برد العجوز",2,"ز",1,0],["فتغاضيتَ خوف أعْرمَ منه","راضياً خُطَّةَ الذليلِ المضيم",3,"م",1,0],["فَتَغَمَّدَن بِالصَفحِ هَفوَةَ مُذنِبٍ","ضاقَت بِهِ مَعَ سُخطِكَ الأَرضُ الفَضا",4,"ض",2,0],["فَتغبرَّ من تلك الفِجاجِ مَواقِفٌ","وتحمرَّ من تلك المياهِ جِمامُ",5,"م",1,0],["فَتُغلِل لَكُم ما لا تُغِلُّ لِأَهلِها","قُرىً بِالعِراقِ مِن قَفيزٍ وَدِرهَمِ",6,"م",1,0],["فَتَغضَبُ لي بِأَجمَعِها قُصَيٌّ","قَطِينُ البَيتِ وَالدُمثِ الرِقاقِ",7,"ق",1,0],["فتغَدَّى بالصَّاعِ أَلْفٌ جِياعٌ","وتَرَوَّى بالصَّاعِ ألفٌ ظِمَاءُ",8,"ا",2,0],["فَتَغَشّاهُ كَراهُ فَهَذى","ساعَةً ثُمَّ تَغَشّاهُ الخُمارُ",9,"ر",1,0],["فَتَغَنَّى الطَّيْرُ تَبْشِيراً بِهِ","وَكَسَى الأُفْقَ الرِّدَاءَ الأَزْهَرَا",10,"ر",2,0],["فَتَغَنَّى أَسْتَغْفِرُ اللهَ بَلْ نَا","حَ نُوَاحاً يُذيبُ قَلبَ الجَمَادِ",11,"د",1,0],["فتَغالى قَالَ فِي التَّمْثِيلِ لا","شِبهَ لِي قالَتْ وَيُحْيِي المَيْتَ نَشْرا",12,"ر",2,0],["فتَغَيَّرَ القَمَرُ المُنِيرُ لِفَقْدِهِ","والشّمْسُ قد كُسِفَتْ وكَادَتْ تأفلُ",13,"ل",1,0],["فتغنى وشبَب المتنبي","وتصابى الصابي أبو إسحقَ",14,"ق",1,0],["فَتغفرَ في شَفاعَتِهِ ذُنوبي","وَأَسكُنَ راضِياً مَعَهُ الرِياضا",15,"ض",2,0],["فتغنّى بمصرُ في موكبِ الشر","قِ وعزِّ التاجيْنِ والصوْلجان",16,"ن",1,0],["فَتغرُزُ في رَخوةٍ سَمْحَةٍ","وتنفِرُ عن ذي مِسَنٍّ قَسا",17,"ا",1,0],["فتَغدو نُقاسِي عِلّتَينِ، وَيَغتَدي","صَحيحاً كنصلِ السّيفِ صَحّتْ مَضَارِبُهْ",18,"ب",2,0],["فتغلب بالدفع الذي عندها الجذبا","طوت بالسير الارض طياً كانها",19,"ا",1,0],["فَتَغَمَّد سَمِيَّهُ مَنكَ بِالرَأ","فَةِ وَالعَفوِ مُحسِناً إِن أَساءَ",20,"ا",2,0],["فَتَغَنّمي عَصرَ الشَبابِ فَإِنَّهُ","ظِلٌّ يَزولُ وَصَفوُ عَيشٍ يَنفَدُ",21,"د",1,0],["فتغاضَ عن جهد المقلّ وإن يكن","أهدى لكم عوض النُضار البهرجا",22,"ج",2,0],["فَتَغدو معَ الأيامِ جيشاً عَرَمرَماً","وتكثُرُ أشلاءُ العدى والغنائم",23,"م",1,0],["فَتَغْرُبُ كَالأَهِلَّةِ فِي لَهَاةٍ","وتَطْلعُ في يَمينٍ كالبُدورِ",24,"ر",1,0],["فَتغترفُ الممالكُ من جَداها","وَيعرفُ أنّ منزعكَ السديدُ",25,"د",1,0],["فتغنّى الشط والأموا","ج ألحان الغزل",26,"ل",1,0],["فتغدو نشاوى الهوى العبقري ال","نقي الحبي الشجي النغم",27,"م",1,0],["فَتَغتَدي بِنَهارٍ لَيسَ يَغشاهُ","لَيلٌ بِظِلٍّ لِلَيلى طابَ مَأواهُ",28,"ه",1,0],["فتَغنَّموا أَنّي أَسيرُ خلالَكمْ","سَيْرَ امْرِئٍ بالاِلتقاءِ قَنوع",29,"ع",1,0],["فتغَنّمْ عِلاوةً لرسولِ اللْ","لهِ نيطَتْ من سُنْةٍ بَيضاء",30,"ا",2,0],["فَتَغرَّبتَ وسابَق","تَ إلى رَيبِ المَنُونِ",31,"ن",1,0],["فتغدو كأن الصبح صلٌّ يروعها","وتَسري كأن الليل لصٌّ يَضيرُها",32,"ر",3,0],["فَتَغاضى عَني حَياءً وَلَم يُرَ","دد جَواباً فَكانَ دَمعي جَوابي",33,"ب",2,0],["فتغانم وقتك الفائت من","قبل يأتيك أوان الانتقال",34,"ل",1,0],["فتغدو خماصاً منه تلتمس الغذا","وتأوى بطاناً حيث تلقى به الحبا",35,"ب",2,0],["فتغشى الأمور كحاطب ليلٍ","وتعمي عن النهج والاقتصاد",36,"د",1,0],["فتغنَّمها وخذ من رزقه","حُلوَهُ المأكولَ عفواً وحلالَهْ",37,"ل",2,0],["فتغدو رياضاً من نَداهُ أنيقَةً","وإمَّا غَزا أعداءهُ رُحْنَ عَنْدَما",38,"م",2,0],["فتَغْنى به الأبطالُ وهي جَحاجحٌ","وتُجْلى به اللَّزْباتُ وهي ثِقالُ",39,"ل",1,0],["فَتَغْنَى بها عمّا يطيبُ على الظما","من المنهلِ العذبِ الزَّلالِ لشاربِ",40,"ب",1,0],["فَتَغمُرُني في سَحابَتِها اِنسِكاباً","وَتوسِعُني أَهِلَّتِها طلوعا",41,"ع",2,0],["فتغنّ بالذي بيْن يديكَ","بل وباهِ فيهِ وافحِمْ أيْن كنتَا",42,"ت",2,0],["فَتغيَّرت أوقَاتُنا وَمَنِ الَّذي","تَصفو لَه الأَوقَاتُ والأزمانُ",43,"ن",1,0],["فتغرَّدْتُ حين طُوِّقْتُ والوّرْقا","ءُ في الطَّوقِ شَأْنُها التَّغْريدُ",44,"د",1,0],["فتغرينٌ وتغرينٌ وودٌّ","ورِفدٌ بَعدَ رِفدٍ بَعد رِفدِ",45,"د",1,0],["فتغنيت مطريا معه الفض","ل الذي قد يجل عن إحصائي",46,"ا",2,0],["فتغني طوراً وترقص طوراً","وتلهى بكل ما يلهيني",47,"ن",2,0],["فتغدو الوجوه برحمته","أزاهير روض زهت بالندى",48,"د",2,0],["فتغنيت له مرتجلا","أنجزت عينا بخيل ما وعد",49,"د",1,0],["فَتَغَنّى صَوتاً لِيوضِحَ عِندي","حَيِّ أُمَّ العَلاءِ قَبلَ الرَحيلِ",50,"ل",1,0],["فتغير هذي بكرة","وتعاود الأخرى عشية",51,"ي",2,0],["فتغنيني عواطفه غناء","يقربني إليه ويصطفيني",52,"ن",2,0],["فتغردت أطيارها وتمايدت","أشجارها وامتدت الأفياء",53,"ا",2,0],["فتغيّرت خوفَ الرقيبِ لعلمها","بمكانِها منّي يشي لغيورها",54,"ر",3,0],["فتغنيه يا أَحبة قَلبي","كَم عَلى هجركم يَكون وَقوفي",55,"ف",2,0],["فتغيرت ومتى أقام على الوفا","خلٌّ ودام مضاجعٌ لمضاجع",56,"ع",1,0],["فَتَغانَجَت وَتَبَغدَت","وَلِسانُ حالِ العَهرِ ناطِقِ",57,"ق",1,0],["فتغدو غبها عود القصايا","تساجلها البكايا والقصايا",58,"ا",3,0],["فتغزلت وما أضمره","وبدا يغشى سناه ناظري",59,"ي",1,0],["فتغيظ العدوّ قولا وفعلا","وتسرّ الوليّ فعلا وحالا",60,"ل",2,0],["فتغبط منهُ الكفَّ سارية الحيا","وتحسد معناه البروق اللوامع",61,"ع",1,0],["فتغضي ولا تنضي حسامك أخذا","بحقي ومنه اليوم قد صفرت كفي",62,"ف",2,0],["فَتَغّيَرَت إِلا مَلاعبها","وَمعرَّساً مِن جَونَةٍ ظَهرِ",63,"ر",1,1],["فتغدو خماصا طاويات وتنثني","وهنّ بطان من نوال ومن بر",64,"ر",1,0],["فتغلغت بالكمال وحيي","ت بغضٍ تحية لا تريب",65,"ب",1,0],["فتغنّي بذكره في الذي قا","ل مديحاً في سيد الأكوان",66,"ن",1,0],["فتغنّيْتِ كي تنيمي أساها","نومة الطفل بعد طول التشكّي",67,"ك",2,0],["فتَّ غصن البان قدًّا","والنَّقا في خطراتكْ",68,"ك",1,0],["فتْغذيةُ الجسم من مأكلٍ","وتغذيةُ الشعر بالانزعاج",69,"ج",1,0],["فتغدو أهالي البر لا تشتكي ظما","ولا تشتكي جدبا ولا تشتكي فقرا",70,"ر",2,0],["فتغلغلت فيها تنقل من","صرٍ إلى سطحٍ إلى قعر",71,"ر",1,0],["فتغالوا ولهاً في حبه","ما رضوا شيئا سوى طيب الوصال",72,"ل",1,0],["فتغمَّدَ الرَحمانُ رُوحك بالرِضَى","وسَقَى ضريحكَ سَحُّ غِيثٍ وابل",73,"ل",1,0],["فتَغمَّدَ الرحمنُ بالرُضوانِ مَن","أَبقى لنا خَلَفاً بهِ انبَسَطَ الأَمَل",74,"ل",1,0],["فَتغفو جُفونٌ ساهرت بَعده الدُجى","وَيَرغدُ عَيشٌ في النَوى لَيسَ بِالرَّغد",75,"د",1,0],["فَتَغَنَّت وَأَبصَرَت","رَجُلاً حامِلاً عَلَف",76,"ف",1,0],["فَتَغَنّى صَوتاً فَكانَ خَطاءً","ثُمَّ ثَنّى أَيضاً فَكانَ مُحالا",77,"ل",2,0],["فتغسلُ دمعتي حزني","وتطفئُ لوعةَ الأح",78,"ح",1,0],["فتغنى بذهاب الأنفس","يا بنفسي وسليماها الربوع",79,"ع",1,0],["فتغفلتها تغفَّل خصم","وتأمّلتها تأمّل قاضِ",80,"ض",1,0],["فتغافل آن كنت أمراً","إيثار عيشك تامل",81,"ل",1,0],["فَتَغمّدنا بِرُحمى","وَقَبُولٍ وَأَمانِ",82,"ن",1,0],["فتغمد حتى يستباح قتيل","إذا فاه منا مصقع قلَّ نولهم",83,"م",1,0],["فتغنم الشكر من كل الورى ابداً","والمدح ممن بفضل أنت شامله",84,"ل",2,0],["فتغرى يميني بالسماح فتنهمي","ولا ترتضي خلا يقول لها يكفي",85,"ف",2,0],["فَتَغرُبُ الآمالُ خَلفِي وهل","يَفُوزُ بالآمالِ إلَّا البَلِيدْ!",86,"د",1,0],["فَتَغَلْغَلْتَ في الأَضالِعِ أَنفاساً","لِطافاً تَهْفو إليها العِظامُ",87,"م",1,0],["فتغرّد الأطيار في روض الرّضا","من وُلدنا ، ونحقق المرغوبا",88,"ب",2,0],["فتغمره ذكريات السنين","كمن عاشها الليلة البارحهْ",89,"ح",2,0],["فتغدوا ولايات الهضاب حقيقة","وفضلا مضافا من كرائمه عقبى",90,"ب",2,0],["فتغافى من الضنى ينشد الرح","مة والصفو في الخيال النائي",91,"ا",2,0],["فتَغلْغلَ الإيمانُ جَوفَ قُلوبِهم","عبَقاً لدينٍ واحداً متفرِّدا",92,"د",2,0],["فتغدو مُبْتَلاً كالعابدينا","وتنسى خمرك والمُخْمِرينا",93,"ن",2,0],["فَتَغْدُو الْغَنَائِمُ دُونَ نَفِيِسٍ","يُزَيِّنُ صَدْرَ صَبَاحَ اعْتِقَالِي",94,"ل",2,0],["فتغزو كلّ قطبٍ مستنير","تُعجّمه ليتبعها طِواعا",95,"ع",2,0],["فتغنى بها وألف فيها","وبدا شاعرا له تأويب",96,"ب",1,0],["فتغمرني عشقا وأسري بليلتي","بما لذ لا أرنو لصبح الغد الضاحي",97,"ح",2,0],["فتُغيثُها نصراً يروّي كلَّ طَودٍ أو خبيبِ","ما كان أسرعَ منقذٍ إلاّكَ في لهبِ الحروبِ",98,"ب",1,0],["فتغيرت بك وجهةً وديانةً","وكرامةً وعزائماً وعديدا",99,"د",2,0],["فتغسلُ الروحَ أنت الطهر منبعه","ماءٌ فراتٌ بخمر الشعر قد مُزِجا",100,"ج",2,0],["فتغارُ من وطني الفراقدُ والسُّهَى","بلْ كلُّ نجمٍ في السماءِ يَغارُ",101,"ر",1,0],["فتُغازِل الأَطْيَارُ حَرَّ لِقائِنا","ونَشِيدُها يَرْقَى لأَرْفَعِ مَوْضِعِ",102,"ع",1,0],["فتغدو الأرض من ظلم يبابا","وبالكون الفسيح دجى رهيب",103,"ب",1,0],["فتُغير لا تُبقي على","من قد يدبّ على التراب",104,"ب",1,0],["فتغرس شوكةً للهجر حيناً","وتزرع علقمًا للمستهامِ",105,"م",1,0],["فتغرقني بحور الوجد شوقاً","لذكرى من به قد خاب ظني",106,"ن",2,0],["فتَغلْغَلَتْ بي حتى ارتوائي إنها","خمرٌ فأثملَني فؤادي الكاسُ",107,"س",1,0],["فَتَغدُو لتَلقَى مَعيْنَ الضِّيَاءِ","وتَنهَلَ مِنْ عَيْنِهِ الصَّافِية",108,"ي",2,0],["فتغدو في جلالِ الصمت حيرى","على الآلامِ تستجدي الإلها",109,"ا",1,0],["فَتَغَنَّي يا ملاكي بهوانا","أسعِفي الأمواج في بثِّ الهديرِ",110,"ر",1,0],["فتغيَّرَ شُذَّاذ الأفُقِ","معناهم في ذهني اللبِقِ",111,"ق",1,0],["فتغرغر يا حبيبي بدمعي","كيفمايرضيك ان تتغرغر",112,"ر",1,0],["فتغضب منّي وتكره وجهي","وترضى ذهابا إلى السوق معْنَا",113,"ن",2,0],["فتغلغلت في القلب عند بكائها","إن الصبابة في الحشا تتغلغل",114,"ل",1,0],["فتَغَزُّلي بِحَبيبةٍ","صوْنُ الفُؤادِ لِمَن عَقَلْ",115,"ل",1,0],["فَتَغَشَّانِي خاطِرٌ عَبقَرِيٌّ","قالَ : ( قَدْ جِئتُ كَي أَزِيدَكَ صَقلَا )",116,"ل",2,0],["فَتَغْفُو النُّجُومُ عَلَى دَارِنَا","وَلَيْلِي يُلَمْلِمُ أَذْيَالَهُ",117,"ل",2,0],["فَتَغفُو هذهِ الحَسنَاءُ ليلًا","عَلىٰ كَتفيَّ تَسمعُ ما رَوَيتُ",118,"ت",1,0],["فتغدو وعمري أو عمرها","ويستوقف المولد المولدا",119,"د",2,0],["فتُغرينها في شجوها بابتسامةٍ","ببثّكِ معنًى للخلود جليلا",120,"ل",2,0],["فتغمرني نشوةٌ من بهاءٍ","وتأخذه سَكرةٌ من سبات",121,"ت",1,0],["فتغفو على حُلم ٍِ يُدرُّ ضُروعَها","وتصحو على حُلم ٍ به الزرعُ يُقطف",122,"ف",1,0]]}