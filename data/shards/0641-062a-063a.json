{"poems":[[4,"درس المنا بمتالع فأبان","https://www.aldiwan.net/poem21206.html","الكامل"],[51,"ومدامة أغنت عن المصباح","https://www.aldiwan.net/poem9412.html","الكامل"],[51,"كنت عند الأمير عيسى بن هارون","https://www.aldiwan.net/poem64527.html","الخفيف"],[51,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[45,"طاف الوشاة به فصد وأعرضا","https://www.aldiwan.net/poem64628.html","الكامل"],[61,"محلك مثل الغاب ليس يرام","https://www.aldiwan.net/poem51457.html","الطويل"],[2,"أمن أم أوفى دمنة لم تكلم","https://www.aldiwan.net/poem25065.html","الطويل"],[40,"فكم من كاعب حوراء رود","https://www.aldiwan.net/poem42292.html","الوافر"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"ونديم لم يزل ساقينا","https://www.aldiwan.net/poem63286.html","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54852","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67336","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141998","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43768","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[45,"تُخَطّي اللّيالي مَعشَراً لا تُعِلُّهُم ْ","https://www.poetsgate.com/ViewPoem.aspx?id=31552",""],[88,"تذكرت في أوطاني الأهلَ والصحبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19533&r=&rc=36",""],[141,"عاذ بالصفح من أَحب البقاء","https://www.aldiwan.net/poem11716.html","الخفيف"],[167,"بعثت تهدد بالنوى وتوعد","https://www.aldiwan.net/poem1617.html",""],[257,"قسما بصبح الحسن حين تبلجا","https://www.aldiwan.net/poem35816.html","الكامل"],[268,"هو الملك تبنيه الجيوش الخضارم","https://www.aldiwan.net/poem35646.html","الطويل"],[273,"بنفسي مثلجات للصدور","https://www.aldiwan.net/poem25442.html","الوافر"],[303,"لصادق رعيه القصر السعيد","https://www.aldiwan.net/poem56577.html","الوافر"],[326,"هتف الشاطىء بالمدح","https://www.aldiwan.net/poem55007.html","مجزوء الرمل"],[340,"رقادك قلبي شجاك الألم","https://www.aldiwan.net/poem55386.html","المتقارب"],[347,"لما دعاني الهوى من ربة الكلل","https://www.aldiwan.net/poem15862.html","البسيط"],[362,"عدد لكم أن سرت في تشييعي","https://www.aldiwan.net/poem60845.html","الكامل"],[362,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[369,"يا علي بن حميد","https://www.aldiwan.net/poem56998.html","مجزوء الرمل"],[374,"قفا نبك نفسا طال منها بسورها","https://www.aldiwan.net/poem59433.html","الطويل"],[377,"من لصب أحشاؤه في التهاب","https://www.aldiwan.net/poem49258.html","الخفيف"],[388,"طلب الراحة في الدنيا محال","https://www.aldiwan.net/poem54543.html","عموديه"],[400,"خليلي هبا فالنسيم بكم هبا","https://www.aldiwan.net/poem34164.html","الطويل"],[438,"أيا شارباً كأس خمر الرقاد","https://www.aldiwan.net/poem14364.html","المتقارب"],[456,"ما جد السعي أتاه ما سعى له","https://www.aldiwan.net/poem55933.html","الرمل"],[459,"ضروب قذال القرن فذا لدى الوغى","https://www.aldiwan.net/poem16039.html","الطويل"],[459,"إذا الشمس غابت عن مسالك مسهل","https://www.aldiwan.net/poem16148.html","الطويل"],[475,"أرقت هوى والليل مرخي الذوائب","https://www.aldiwan.net/poem15229.html","الطويل"],[491,"أمر بدار عمار بن نصر","https://www.aldiwan.net/poem67355.html","الوافر"],[503,"التّرِكة","https://www.aldiwan.net/poem42458.html","الرمل"],[536,"ألقلب من حذر النوى ملآن","https://www.aldiwan.net/poem47592.html","عموديه"],[573,"إن أكن أشجعا فأنت الرشيد","https://www.aldiwan.net/poem3083.html","الخفيف"]],"verses":[["فَتَغَمَّرَت نَفساً وَأَدرَكَ شَأوُها","عُصَبَ القَطا يَهوينَ لِلأَذقانِ",0,"ن",1,0],["فتَغَلَّلَتْ من تِبْرها بِغُلالةٍ","وتوشَّحت مِنْ دُرِّهَا بوشاح",1,"ح",1,0],["فتغنّتْ فهزَّني القرُّ حتى","خلت أني في وسْط برد العجوز",2,"ز",1,0],["فتغاضيتَ خوف أعْرمَ منه","راضياً خُطَّةَ الذليلِ المضيم",3,"م",1,0],["فَتَغَمَّدَن بِالصَفحِ هَفوَةَ مُذنِبٍ","ضاقَت بِهِ مَعَ سُخطِكَ الأَرضُ الفَضا",4,"ض",2,0],["فَتغبرَّ من تلك الفِجاجِ مَواقِفٌ","وتحمرَّ من تلك المياهِ جِمامُ",5,"م",1,0],["فَتُغلِل لَكُم ما لا تُغِلُّ لِأَهلِها","قُرىً بِالعِراقِ مِن قَفيزٍ وَدِرهَمِ",6,"م",1,0],["فَتَغضَبُ لي بِأَجمَعِها قُصَيٌّ","قَطِينُ البَيتِ وَالدُمثِ الرِقاقِ",7,"ق",1,0],["فتغَدَّى بالصَّاعِ أَلْفٌ جِياعٌ","وتَرَوَّى بالصَّاعِ ألفٌ ظِمَاءُ",8,"ا",2,0],["فَتَغَشّاهُ كَراهُ فَهَذى","ساعَةً ثُمَّ تَغَشّاهُ الخُمارُ",9,"ر",1,0],["فَتَغَنَّى الطَّيْرُ تَبْشِيراً بِهِ","وَكَسَى الأُفْقَ الرِّدَاءَ الأَزْهَرَا",10,"ر",2,0],["فَتَغَنَّى أَسْتَغْفِرُ اللهَ بَلْ نَا","حَ نُوَاحاً يُذيبُ قَلبَ الجَمَادِ",11,"د",1,0],["فتَغالى قَالَ فِي التَّمْثِيلِ لا","شِبهَ لِي قالَتْ وَيُحْيِي المَيْتَ نَشْرا",12,"ر",2,0],["فتَغَيَّرَ القَمَرُ المُنِيرُ لِفَقْدِهِ","والشّمْسُ قد كُسِفَتْ وكَادَتْ تأفلُ",13,"ل",1,0],["فتغنى وشبَب المتنبي","وتصابى الصابي أبو إسحقَ",14,"ق",1,0],["فَتغفرَ في شَفاعَتِهِ ذُنوبي","وَأَسكُنَ راضِياً مَعَهُ الرِياضا",15,"ض",2,0],["فتغنّى بمصرُ في موكبِ الشر","قِ وعزِّ التاجيْنِ والصوْلجان",16,"ن",1,0],["فَتغرُزُ في رَخوةٍ سَمْحَةٍ","وتنفِرُ عن ذي مِسَنٍّ قَسا",17,"ا",1,0],["فتَغدو نُقاسِي عِلّتَينِ، وَيَغتَدي","صَحيحاً كنصلِ السّيفِ صَحّتْ مَضَارِبُهْ",18,"ب",2,0],["فتغلب بالدفع الذي عندها الجذبا","طوت بالسير الارض طياً كانها",19,"ا",1,0],["فَتَغَمَّد سَمِيَّهُ مَنكَ بِالرَأ","فَةِ وَالعَفوِ مُحسِناً إِن أَساءَ",20,"ا",2,0],["فَتَغَنّمي عَصرَ الشَبابِ فَإِنَّهُ","ظِلٌّ يَزولُ وَصَفوُ عَيشٍ يَنفَدُ",21,"د",1,0],["فتغاضَ عن جهد المقلّ وإن يكن","أهدى لكم عوض النُضار البهرجا",22,"ج",2,0],["فَتَغدو معَ الأيامِ جيشاً عَرَمرَماً","وتكثُرُ أشلاءُ العدى والغنائم",23,"م",1,0],["فَتَغْرُبُ كَالأَهِلَّةِ فِي لَهَاةٍ","وتَطْلعُ في يَمينٍ كالبُدورِ",24,"ر",1,0],["فَتغترفُ الممالكُ من جَداها","وَيعرفُ أنّ منزعكَ السديدُ",25,"د",1,0],["فتغنّى الشط والأموا","ج ألحان الغزل",26,"ل",1,0],["فتغدو نشاوى الهوى العبقري ال","نقي الحبي الشجي النغم",27,"م",1,0],["فَتَغتَدي بِنَهارٍ لَيسَ يَغشاهُ","لَيلٌ بِظِلٍّ لِلَيلى طابَ مَأواهُ",28,"ه",1,0],["فتَغنَّموا أَنّي أَسيرُ خلالَكمْ","سَيْرَ امْرِئٍ بالاِلتقاءِ قَنوع",29,"ع",1,0],["فتغَنّمْ عِلاوةً لرسولِ اللْ","لهِ نيطَتْ من سُنْةٍ بَيضاء",30,"ا",2,0],["فَتَغرَّبتَ وسابَق","تَ إلى رَيبِ المَنُونِ",31,"ن",1,0],["فتغدو كأن الصبح صلٌّ يروعها","وتَسري كأن الليل لصٌّ يَضيرُها",32,"ر",3,0],["فَتَغاضى عَني حَياءً وَلَم يُرَ","دد جَواباً فَكانَ دَمعي جَوابي",33,"ب",2,0],["فتغانم وقتك الفائت من","قبل يأتيك أوان الانتقال",34,"ل",1,0],["فتغدو خماصاً منه تلتمس الغذا","وتأوى بطاناً حيث تلقى به الحبا",35,"ب",2,0],["فتغشى الأمور كحاطب ليلٍ","وتعمي عن النهج والاقتصاد",36,"د",1,0],["فتغنَّمها وخذ من رزقه","حُلوَهُ المأكولَ عفواً وحلالَهْ",37,"ل",2,0],["فتغدو رياضاً من نَداهُ أنيقَةً","وإمَّا غَزا أعداءهُ رُحْنَ عَنْدَما",38,"م",2,0],["فتَغْنى به الأبطالُ وهي جَحاجحٌ","وتُجْلى به اللَّزْباتُ وهي ثِقالُ",39,"ل",1,0],["فَتَغْنَى بها عمّا يطيبُ على الظما","من المنهلِ العذبِ الزَّلالِ لشاربِ",40,"ب",1,0],["فَتَغمُرُني في سَحابَتِها اِنسِكاباً","وَتوسِعُني أَهِلَّتِها طلوعا",41,"ع",2,0],["فتغنّ بالذي بيْن يديكَ","بل وباهِ فيهِ وافحِمْ أيْن كنتَا",42,"ت",2,0],["فَتغيَّرت أوقَاتُنا وَمَنِ الَّذي","تَصفو لَه الأَوقَاتُ والأزمانُ",43,"ن",1,0],["فتغرَّدْتُ حين طُوِّقْتُ والوّرْقا","ءُ في الطَّوقِ شَأْنُها التَّغْريدُ",44,"د",1,0]]}