{"poems":[[55,"بلاء القلب ناظره","https://www.aldiwan.net/poem30463.html","مجزوء الوافر"],[79,"وأبيض من ذوي الأشجار يبدو","https://www.aldiwan.net/poem36761.html","الوافر"],[90,"خاض الدجى وظلام الليل مختلط","https://www.aldiwan.net/poem44831.html","البسيط"],[87,"كبير السابقين من الكرام","https://www.aldiwan.net/poem63748.html","الوافر"],[47,"مع الدهر ظلم ليس يقلع راتبه","https://www.aldiwan.net/poem10905.html","الطويل"],[99,"ولما التقينا بعد نأي وغربة","https://www.aldiwan.net/poem24795.html","الطويل"],[107,"ترامى الجيش واندفع الرعيل","https://www.aldiwan.net/poem44191.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39595","الطويل"],[99,"تحليل قبلة","https://www.poetsgate.com/ViewPoem.aspx?id=17252",""],[147,"سل المقادير ما أحببته تجب","https://www.aldiwan.net/poem11725.html","البسيط"],[280,"لمن وقعة بالغرب ضعضعت الشرقا","https://www.aldiwan.net/poem25477.html","الطويل"],[382,"أزل يا شقيق الروح مني بقيتي","https://www.aldiwan.net/poem66906.html","الطويل"],[463,"أيا سكر الزمان متى تفيق","https://www.aldiwan.net/poem56099.html","الوافر"],[466,"يسوس الأمر وجبته ضجاج","https://www.aldiwan.net/poem16427.html","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48789","المتقارب"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62476","الطويل"],[1078,"","https://poetry.dctabudhabi.ae/diwan/poem/131923",""],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56210","الوافر"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130631","البسيط"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130621","الطويل"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132885","الطويل"],[1464,"","https://poetry.dctabudhabi.ae/diwan/poem/146699","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95551","البسيط"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95504","المتقارب"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46487","الوافر"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42459","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86273","البسيط"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118748","المتقارب"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114383","الطويل"],[3914,"","https://poetry.dctabudhabi.ae/diwan/poem/116890","الطويل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29298","البسيط"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75690","البسيط"],[4177,"","https://poetry.dctabudhabi.ae/diwan/poem/105692","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33755","الهزج"],[4828,"سيرةُ ضوء","https://www.poetsgate.com/ViewPoem.aspx?id=193407",""],[4955,"كلام متنه الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=188728",""],[5083,"طيَّاتُ العَبير","https://www.poetsgate.com/ViewPoem.aspx?id=53771",""],[5135,"وجاء الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=201954",""],[5274,"أحلام أندلسية","https://www.poetsgate.com/ViewPoem.aspx?id=207438",""],[5285,"لكِ الله يهدي سواء السبيل","https://www.poetsgate.com/ViewPoem.aspx?id=204396",""],[5431,"أيا عيدي وياسكني وأنسي","https://www.poetsgate.com/ViewPoem.aspx?id=190959",""],[5781,"أحلامٌ مُفكَّكةٌ ووِسادةٌ خالية","https://www.poetsgate.com/ViewPoem.aspx?id=202844",""],[5897,"بين رمضان والعيد","https://www.poetsgate.com/ViewPoem.aspx?id=156847",""],[5897,"إلى .. اليمن الذي كان سعيداً !","https://www.poetsgate.com/ViewPoem.aspx?id=176758",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[5956,"شَعْبِيَّةُ المَرْتَبة *","https://www.poetsgate.com/ViewPoem.aspx?id=183665",""],[5956,"إخلاصه الجم يسقي حقل موهبتي","https://www.poetsgate.com/ViewPoem.aspx?id=193723",""],[5957,"صباح الأمان","https://www.poetsgate.com/ViewPoem.aspx?id=176793",""],[6056,"العيون الإنتهازية","https://www.poetsgate.com/ViewPoem.aspx?id=130347",""],[456,"حنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84503&r=&rc=2",""],[6230,"العقاب ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67168&r=&rc=42",""],[6336,"عشاق في الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73561&r=&rc=22",""]],"verses":[["يَبُثَّ سَوامَ لَحظَتِهِ","وَأَنجُمُهُ أَزاهِرُه",0,"ر",2,0],["يَبُثُّ لَكَ الْمَسَائِلَ وَالْمَعَانِي","وَإِنْ يَسْأَلْهُ شَخْصٌ لَنْ يُجِيبَهْ",1,"ب",2,0],["يبثّ في الليل حزناً لو أحسّ به","لبان في لِمَّتيهِ الشيب والشمط",2,"ط",1,0],["يَبُثُّ تَجارِبَ الأَيّامِ فيهِم","وَيَدعو الرابِضينَ إِلى القِيامِ",3,"م",1,0],["يَبُثُّ المَنايا وَالمَنايا يَحُزنَهُ","وَيَكرَبُ مِنهُ الحَتفُ وَالحَتفُ كارِبُه",4,"ب",2,0],["يبث فمي سرّ لهوى لمقبّل","أجود له بالروح غير ضنين",5,"ن",1,0],["يبثُّ الوجدَ مُبتَئِسٌ حِزينٌ","وَتذرِي الدمعَ وَالِهَةٌ ثَكُولُ",6,"ل",1,0],["يبثُّ الحرارةَ بَرْدَ الشتاءِ","ويُلهبُ شُعلته المطفأه",7,"ه",1,0],["يبثُّ سناها الأرض حبّاً ورحمةً","ويطوي هداها سطوةَ المتمرِّدِ",8,"د",1,0],["يبث فمي سرّ الهوى لمقبّل","أجود له بالروح غيرَ ضنين",9,"ن",1,0],["يَبُثُّ في كُلِّ أَرضٍ لِلعَدُوِّ نَأَت","ذِكراً يَقومُ مَقامَ الجَحفَلِ اللَجِبِ",10,"ب",1,0],["يَبُثُّ هُناكَ السَّيْفُ للرُّمْحِ بَثَّهُ","فَتُبْصِرُ مُنْفلاً يُحادِثُ مُنْدَقَّا",11,"ق",2,0],["يبثون ما قد ناله من نكاله","وكم نال ذاك الجسم من كل بلوة",12,"ه",1,0],["يبُثُّ علاك في النعم اللواتي","نسيمُ المكرمات بها عبيقُ",13,"ق",1,0],["يَبُثُّ ثَناءَهُ ضَيْفُ الدَّياجي","وبالصُّبْحِ القَشاعِمُ والذِّئابُ",14,"ب",1,0],["يبثون رسلهم في الدجى","ويلتمسون رضى الخاذل",15,"ل",1,0],["يبث نسيمُ الروض أخبارهَ لهَا","فتهتز طيباً من لطيف سُراها",16,"ا",3,0],["يبث من العقل الشريف نتائجاً","تضيء فكم قد أسفرتْ في المكاتب",17,"ب",1,0],["يبثّ له الدعا أبداً ويثني","نقولا طاب في الموصوف نشدا",18,"د",2,0],["يبثه العتب لا يصغي فينشده","واحرّ قلباه ممن قلبه شبم",19,"م",1,0],["يبث الندى والسحب تجري دموعها","حياءا وهذا ما عليه تعودا",20,"د",2,0],["يبثَّانِ عَرفَ العُرفِ حتى كأنما","تروقُ في يوم الشَّمال شمول",21,"ل",1,0],["يبثثن في القرطاس أجباء النهي","بلعاب منقار لها من قار",22,"ر",1,0],["يبث في الروع أن المرء فى حلم","وإن قضى يستفق من ذلك الحلمِ",23,"م",1,0],["يبثُّ المحامد في شعبه","ويغذوه علماً غزيراً نماه",24,"ا",2,0],["يُبثُّ جُنوده شَرقاً وَغَرباً","وَقَد بَعَثَ الطَلائع مِن أَمام",25,"م",1,0],["يبثُّ جواهراً مِن فيهِ حتَّى","إليهِ الناسُ تهرعُ بالنَّوالِ",26,"ل",1,0],["يَبُثُّ روحَ التُقى في قَلبِ امتِّهِ","فَضلاً وَيُقرَنُ مِنهُ العِلمَ بِالعَمَل",27,"ل",1,0],["يبث العجائب إذ يرتقي","اناملَ راحته منبرا",28,"ر",2,0],["يَبُثُّ يواقيتاً وَطَوراً لآلئا","وحيناً جلا دُر نَفيساً مُنظَّما",29,"م",2,0],["يبثكّ أنفاس الحبيب وانها","لا ذكى من المسك الذكيّ وأعبقُ",30,"ق",1,0],["يَبُثُّ أَحزانَهُ لِلنَجمِ مُمتَثِلاً","وَلِلنُجومِ قُلوبٌ ما تُواسيها",31,"ي",3,0],["يبث فينا علوماً حينَ تسمعها","تخاله ملكاً في صورة البشر",32,"ر",1,0],["يبثون بين الناس فيه نصائحاً","وما هي إلا ضله ومكائد",33,"د",1,0],["يَبثُّ السقمَ من عيني","هِ لكن لحظُهُ يشفي",34,"ف",2,0],["يبثُّ شكواهُ ، والأصداءُ تُرجِعُها","طيفاً ، ويُحزنُهُ ألاّ يُلاقيهِ",35,"ي",2,0],["يُبثُّ لنا بأغنيةٍ","بها كلُّ الحياءِ يراقْ",36,"ق",1,0],["يَبُثُّ جَواهُ مُبْتَرِداً لِيُطفي","ضِرامَ الوَجْدِ بالظَبيِ الغَريرِ",37,"ر",1,0],["يبث الحياة بكل الدُّنَا","ويوقظ للشجو أطيارَهُ",38,"ر",2,0],["يبثُ الليلُ أنْسَامَ القَوَافِي","وَمَا تَعِبَ الهَدِيل ُ ولا الحَمَامُ",39,"م",1,0],["يبثُ الكرامةَ في كلِّ نفسٍ","ويمسحُ دمعاً بعينٍ يسيلْ",40,"ل",1,0],["يبث النار حراقا بهمسي","ويشعلني إذا مااجتاح حسي",41,"س",2,0],["يَبُثُّني الشَّوْقَ مَنْ يَهْوى عَلى وَرَقٍ","وَيَأْسِرُ اللُّبَّ شِعْرٌ خَطَّهُ القَلَمُ",42,"م",1,0],["يبث أغاني العيد من كل صادحٍ","فتدمع أحداقٌ وتضحك أحداقُ",43,"ق",1,0],["يبث ألوان قوس النصر فوق مدى","يا طالما قال أن اليُمن لليَمنِ",44,"ن",1,0],["يبثها في أخلاء له غرر","مستبصرين معاذين من السمد",45,"د",1,0],["يبثُّ عليَّ السِّجنُ مِنْ دون رحمةِ","روائحَ أقذَى من سموم العقاربِ",46,"ب",1,0],["يبث في القلب والوجدان حكمته","أسيرُ ظلاً وراهُ وهو مستبقي",47,"ق",2,0],["يبث الأمان بدرب الحيارى","وانهار بوحه تسقي المكان",48,"ن",1,0],["يبث الذبذبة ، شوق ٍ حواها الود بالتغليف","بأحاسيس الغلا من صافي الإخلاص مروية",49,"ي",2,0],["يَبُثُّ سَناهُ من بعيدٍ كأنَّهُ","يزورُ بسَلمى ، فَوقَها يتَلَمَّع",50,"ع",1,0],["يبُثُّها رُوحُهُ السَّكْرَى بِغُرْبَتِهَا","في عالَمٍ يَتَداعى حولَها تَلَفَا..",51,"ف",2,0],["يبثّ إليها الشوقَ طيَّ شعاعه","فتعرضُ لا تنوي الصدود، وإنما...",52,"م",2,0]]}