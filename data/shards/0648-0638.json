ctabudhabi.ae/diwan/poem/54270","المديد"],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[106,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""],[106,"معجزة السد","https://www.poetsgate.com/ViewPoem.aspx?id=179335",""],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[100,"كانت وكان","https://www.poetsgate.com/ViewPoem.aspx?id=50424",""],[93,"فتاة الجبل","https://www.poetsgate.com/ViewPoem.aspx?id=12714",""],[90,"المازني وداغر","https://www.poetsgate.com/ViewPoem.aspx?id=179154",""],[90,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[90,"أطِل مكثاً","https://www.poetsgate.com/ViewPoem.aspx?id=179234",""],[90,"الحزبان المتآخيان","https://www.poetsgate.com/ViewPoem.aspx?id=179105",""],[90,"هجرت الديار","https://www.poetsgate.com/ViewPoem.aspx?id=178969",""],[45,"نَِكتُمْ وَدِيعةَ أَرْدشير،ولم يَكُنْ","https://www.poetsgate.com/ViewPoem.aspx?id=32531",""],[45,"قُلْ للجَنُوبِ: إذا غَدَوْتِ فأَبْلِغي","https://www.poetsgate.com/ViewPoem.aspx?id=31840",""],[45,"أعَلْتَ بَني وَهْبٍ على العالَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=32048",""],[45,"خيَالٌ مُلِمٌّ، أو حَبيبٌ مُسَلِّمُ","https://www.poetsgate.com/ViewPoem.aspx?id=32021",""],[99,"لحمُها .. وأظَافري","https://www.poetsgate.com/ViewPoem.aspx?id=16934",""],[99,"يُحبني كثيراً","https://www.poetsgate.com/ViewPoem.aspx?id=14386",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[88,"لقد سمعوا من الوطن الأنينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19527&r=&rc=30",""],[88,"وظبي جاء يطلب جلنارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19547&r=&rc=50",""],[61,"أُحَذِّرُكُمْ أمواجَ دجلة َإذ غدَتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59478&r=&rc=11",""]],"verses":[["وَظَبيٍ بِأَطوارِ الجِمارِ إِذا غَدا","رَمى كَبِداً مَقروحَةً وَرَماها",0,"ا",3,0],["وَظاهَروا النَقعَ عَلى زَغفِهِم","وَرَجَّلوا بِالدَمِ سودَ الجِمام",1,"م",1,0],["وَظَبيَةٍ مِن ظِباءِ الإِنسِ عاطِلَةٍ","تَستَوقِفُ العَينَ بَينَ الخَمصِ وَالهَضَمِ",2,"م",1,0],["وَظَفِرتُ مِن نَفَحاتِهِ وَجِوارِهِ","بِأَجَلِّ نَعماءٍ وَأَحرَزِ مَوئِلِ",3,"ل",1,0],["وَظِباءً حالِياتٍ","كَظِباءٍ عاطِلاتِ",4,"ت",1,0],["وظلامُ اللَّيلِ معتَكِرٌ","وَطَريقُ الحَزْنِ مشتَبِهُ",5,"ه",1,0],["وَظَلماءَ مِن لَيلِ التَّمامِ طَوَيتُها","لأَلْقى أَناةَ الخَطوِ مِن سَلَفَيْ سَعدِ",6,"د",1,1],["وَظَمياءَ لا تَجزي المُحِبَّ بِوُدِّهِ","وَلِلَّهِ ما يُخفيهِ مِنهُ وَما يُبدي",6,"د",2,0],["وَظَلامٍ قَيَّدَ العَينَ بِهِ","لَيلَةٌ ضَلَّ بِها العَينَ الكَرى",7,"ا",1,1],["وَظِلُّهُ الأَلمى حَوَا","لَيهِ غَديرٌ مُترِعُ",8,"ع",1,0],["وَظَلَّ يُنشِدُها شِعري وَيُطرِبُها","حَتىّ رَأَتهُ بِذَيلِ اللَيلِ مُنتَقِبا",9,"ب",2,0],["وَظَلَلتُ إِذ نَشَرَ الصَّباحُ رِداءَهُ","أَشكو الوِشاحَ وَأَشكُرُ الخَلخالا",10,"ل",2,0],["وَظَلامُ الشَّبابِ أَحسَنُ عِندي","مِن مَشيبٍ يُظِلُّني بِضياءِ",11,"ا",2,0],["وَظَلَّ يَكسوُهُ مِن نَوَّارِهِ حُلّلاً","تُنيرُهُنَّ وَتُسديهِنَّ أَمطارُ",12,"ر",1,0],["وَظِباءٍ مِن بَني أَسَدٍ","بِهَواها القَلبُ مأهولُ",13,"ل",1,1],["وَظَلَّ يَبُزُّ النّاجِياتِ مِراحَها","إِلَيْكَ أَبا المِغوارِ وَالسَّيْرُ باهِظُ",14,"ظ",1,0],["وَظَلَّتْ تُناجينا صَباً مَشْرِقِيَّةٌ","تُزيلُ تَباريحَ الجَوى نَسَماتُها",15,"ت",3,0],["وَظَلَّ نَديمَ غَاطِيَةٍ وَرَوُضٍ","وَبَاتَ صَريعَ باطِيَةٍ وَدَنِّ",16,"ن",1,0],["وظَمْياءُ لم تَحْفِلْ بسِرٍّ أصونُهُ","ولا بدُموعٍ في هَواها أُذيلُها",17,"ل",3,0],["وظلّتْ على الجَرْعاءِ ولْهَى كَئيبَةً","وقد سالَ واديها بأحمَرَ قانِ",18,"ن",1,0],["وَظَهَرتُ مِنكِ عَلى الَّذي كاتَمتِني","فَسَكَتُّ عَنكِ كَأَنّي لَم أَعلَمِ",19,"م",1,0],["وَظَائِفُ بَعْدَ بُعْدِكَ فِي ازْدِيَادٍ","وَحِفْظٌ فِي طِعَانٍ أَوْ طَعَامِ",20,"م",1,0],["وَظَعَنْتَ عَنْ أَوْطَانِ مُلْكِكَ رَاكِباً","مَتْنَ الْعُبَابِ فَأَيُّ صَبْرٍ يَجْمُلُ",21,"ل",1,0],["وظَبْيٍ لأوْضاعِ المَجالِ مدرِّسٍ","عليمٍ بأسْرارِ المَحاسِنِ ماهِرِ",22,"ر",1,1],["وظلِلْتُ أطْلُبُ في الكِرامِ نَشيدَتي","حتّى أنَخْتُ بعَقْوَةِ الأنْصارِ",23,"ر",1,0],["وَظَنَّت بِأَنّي كُلَّما رَضَيَت بِهِ","رَضِيتُ بِهِ يا جَهلَها كَيفَ ظَنَّتِ",24,"ت",1,0],["وَظُعنُنا خَلفَنا كُحلاً مَدامِعُها","أَكبادُها وُجُفٌ مِمّا تَرى تَجِفُ",25,"ف",1,0],["وَظَلَّت شَعيبٌ غَربَةُ الماءِ عِندَنا","وَأَسحَمُ مَملوءٌ مِنَ الراحِ مُتأَقُ",26,"ق",1,0],["وَظَلَّ سَراةَ اليَومِ يُبرِمُ أَمرَهُ","بِرَابِيَةٍ البَحّاءِ ذاتِ الأَعابِلِ",27,"ل",1,0],["وَظَنَّ أَهلُكِ بي سوءاً وَأَرمَضَني","قَولُ الوُشاةِ وَدَعوى كُلِّ أَفّاكِ",28,"ك",1,0],["وَظَلَّتِ الروسُ عَلى جَمرَةٍ","وَالمَجدُ يَدعوهُم أَلا فَاِصبِروا",29,"ر",3,0],["وظَنَّ كلُّ فَريقٍ أنّ صاحِبَهُم","أوْلى بها وأتى الشّحْنَاءَ آتيها",30,"ي",3,0],["وَظَبيٍ مِن بَني مِصرٍ غَريرٍ","شَهِيِّ اللَفظِ ذي خَدٍّ مَشيمِ",31,"م",1,0],["وَظَلَّ فُؤادٌ مَفخَرَ الشَرقِ كُلِّهِ","كَثيرَ الأَيادي صادِقَ العَزَماتِ",32,"ت",1,0],["وَظَلَّ مُستَتِراً مِنها وَمُحتَجِباً","عَنها وَنورُهُما في الناسِ قَد ظَهَرا",33,"ر",2,0],["وَظَبيٍ يُسَقّينا سُلافَةَ خَمرِهِ","حَكى جَسَدي في السُقمِ رِقَّةَ خَصرِهِ",34,"ه",1,0],["وَظَلَّ طُهاةُ اللَحمِ ما بَينَ مُنضِجٍ","صَفيفَ شِواءٍ أَو قَديرٍ مُعَجَّلِ",35,"ل",1,0],["وَظَلَّ لِثيرانِ الصَريمِ غَماغِمٌ","يُداعِسُها بِالسَمهَرِيِّ المُعَلَّبِ",36,"ب",1,0],["وَظَلَّ غُلامي يَضجَعُ الرُمحَ حَولَهُ","لِكُلِّ مَهاةٍ أَو لِأَحقَبَ سَهوَقِ",37,"ق",1,0],["وَظَلَّ صِحابي يَشتَوُونَ بِنِعمَةٍ","يَصُفّونَ غاراً بِاللَكيكِ المُوَشَّقِ",37,"ق",1,0],["وَظاعِنَةٍ في الحَيِّ لَولا عَطاؤُهُ","غَداةَ غَدٍ مِن أَهلِها ما اِستَقَلَّتِ",38,"ت",1,0],["وَظَلَّ فِي كُلِّ مَا نَاطَ الرَّجَاءُ بِهِ","عِنْدَ الَّذِي زَعَمُوا أَوْ فَوْقَ مَا زَعَمُوا",39,"م",3,0],["وَظَنَنتَ أَرضَ اللَهِ ضَيِّقَةً","عَنّي وَأَرضُ اللَهِ لَم تَضِقِ",40,"ق",1,0],["وَظَنَنتُ أَنَّكِ قَد فَعَل","تِ فَكِدتُ مِن حَزَنٍ أُجَن",41,"ن",1,0],["وَظَلَّ السَفا مِن كُلِّ قِنعٍ جَرى بِهِ","تَخَزَّمَ أَوتارَ الأُنوفِ نَواصِلُه",42,"ل",2,0],["وَظاهِر لَها مِن يابِسِ الشَختِ وَاِستَعِن","عَلَيها الصَبا وَاجعَل يَدَيكَ لَها سِترا",43,"ر",2,0],["وَظَلَّ لِلأَعيَسِ المُزجي نَواهِضَهُ","في نَفنَفِ اللَوحِ تَصويبٌ وَتَصعيدُ",44,"د",1,0],["وظلّ يرنو تارةً خلفه","وتارة ينظرها مغرما",45,"م",2,0],["وظلنا نرجّي منك للخرق راقعاً","ولكن تراخى الأمر مُتّسع الخرق",46,"ق",1,0],["وظلّ ابنها عن كل حَوْض مُحَلأً","يَحُوم على سَلساله وهو عطشان",47,"ن",1,0],["وظلّت له ترنو بعينِ تجوده","بفَذّ من الدمع الغزير وتَوْءَم",48,"م",1,0],["وظلتُ لها أبكي بعين قريحة","جرت من أماقيها عصارةُ عندم",48,"م",1,0],["وظل فوق الأرض في حالةٍ","يزَوّر عنها الحسب الأرفع",49,"ع",1,0],["وَظَلَّت قَراقيرُ الفَلاةِ مُناخَةً","بِأَكوارِها مَعكوسَةً بِالخَزائِمِ",50,"م",1,0],["وَظَلَّ لَكُم يَومٌ بِسِنجارَ فاضِحٌ","وَيَومٌ بِأَعطانِ الرَحوبَينِ أَفضَحُ",51,"ح",1,0],["وَظَنّوا في اللِقاءِ لَهُم رَواحاً","وَكانوا يُصعَقونَ مِنَ الوَعيدِ",52,"د",1,0],["وَظَلّامَةٍ قَلَّدتُها حُكمَ مُهجَتي","وَمَن يُنصِفُ المَظلومَ وَالخَصمُ حاكِمُه",53,"م",2,0],["وَظَبيٍ غَريرٍ في فُؤادي كِناسُهُ","إِذا اِكتَنَسَ العَينُ الفَلاةَ وَحَورُها",54,"ر",3,1],["وَظَنُّهُمُ بي أَنَّني لِعَشيرَتي","عَلى أَيِّ حالٍ كانَ حامٍ وَذائِدُ",55,"د",1,0],["وظلامٌ كأن كيوان أعمى","سائلٌ فيهِ عن عصا الجوزاء",56,"ا",2,0],["وظيفتيَ المدحُ الذي أنا ناظم","عليك وحسبي في الأنامِ به مدحا",57,"ح",2,1],["وظرفت في اليقظات منه بخلوة","ما كنت آمل في المنام خيالها",58,"ل",3,0],["وظاهريّ الأيادي غير خافيةٍ","وليس عن شيم العليا بمعتزل",59,"ل",1,0],["وظيفة قيل ما ذي","فقلت قول السلامهْ",60,"م",2,0],["وظبي له في أسرة الترك نسبة","وفي الهند معنى من مضاء جفونه",61,"ن",2,0],["وَظاهِراً باطِناً تَجَلّى","لَكُلِّ شَيءٍ بِكُلِّ شَيِّ",62,"ي",1,0],["وظَمِئنا إلى الشراب وأنت الْ","بحرُ يَروى في جانبيه الظِّماءُ",63,"ا",2,0],["وظننتَ ما شاهدتَ من آياته","بلطيفةٍ من حيلة الحكماءِ",64,"ا",2,0],["وظنونُ الذكيِّ أَنْفذ في الحق","قِ سهاماً من رؤية الأغبياءِ",65,"ا",2,0],["وظنِّي أنه رجلٌ","يحاولُ عندها الرِّيَبا",66,"ب",2,0],["وظرفُهُ نُورٌ لآدابِهِ","إذ لم ينوِّرْ كلُّ مَنْ أعشبا",67,"ب",2,0],["وظننت توبتكم نَصوحاً بعدها","ولقد يُخالَف من يَظُنُّ ويَحسبُ",68,"ب",1,0],["وظنَّي أنه لو كان سيلاً","لعلَّمه التوقُّلَ في العقابِ",69,"ب",1,0],["وظلّ فيه برقُهُ كالحاً","ورعدُهُ يُعوِلُ في مَنْدبِ",70,"ب",1,0],["وظلَّ على الأيْدي تَساقط نَفْسُه","ويذوِي كما يذوي القَضِيبُ من الرَّنْدِ",71,"د",1,0],["وظلماءَ ما في سُدِّها من خَصَاصةٍ","لعين ولا فيها لذي الرأي مَحْدِسُ",72,"س",1,1],["وظل دهري له مُلاوِذَهُ","من خوف سهم الردى ومقراضه",73,"ض",2,0],["وظلت عيون النور تخضل بالندى","كما اغرورقت عين الشجيِّ لتدمعا",74,"ع",2,0],["وظلوا كأن الريح تزفي عليهمُ","بها قزعاً ملء السماء مقزَّعا",74,"ع",2,0],["وظليمِ أسفارٍ إذا افترش الفلا","بارى الظليم فزفَّ مثل زفيفه",75,"ف",2,0],["وظلُّوا وباتوا به آمني","ن في ظل عيش أثيث الورق",76,"ق",1,0],["وظُلْتُ لما غاصَ في بحرها","آملُ أن يرجع تأميلا",77,"ل",2,0],["وظُلم الغواني أنهن صرمنني","لظلم الليالي إنني لمُظلَّمُ",78,"م",1,0],["وظُنِّي جميلاً بالذي لم تزلْ له","عوائدُ من إحسانِهِ المُتقادمِ",79,"م",1,0],["وظُلامةُ العادي عليهمْ تنقضي","وعِقابُهمْ يبقى على الأيام",80,"م",1,0],["وظَلَّ كتابيَ ملقىً لديك","بدار اطِّراحٍ ومثواةِ هُون",81,"ن",1,0],["وَظَلَّت بَنو الصَمعاءِ تَأوي فُلولُهُم","إِلى كُلِّ دَسماءِ الذِراعَينِ وَالعَقبِ",82,"ب",1,0],["وَظَلَّ الحُراقُ وَهوَ يَحرُقُ نابَهُ","لِما قَد رَأى مِن قُوَّةٍ وَعَتادِ",83,"د",1,0],["وَظَلَّ يَجيشُ الماءَ مِن مُتَفَصِّدٍ","عَلى كُلِّ حالٍ مِن مَذاهِبِهِ يَجري",84,"ر",2,0],["وَظَلَّ لَهُ بَينَ العُقابِ وَراهِطٍ","ضَبابَةُ يَومٍ لا تُوارى كَواكِبُه",85,"ب",2,0],["وَظَلَّ كَمِثلِ النُصبِ يَقذِفُ طَرفَهُ","إِلى كُلِّ شَخصٍ نابِئٍ هُوَ عادِلُه",86,"ل",2,0],["وَظَلَّ يَسوفُ النَهيَ حَتّى تَمَذَّرَت","بِطينِ الزُبى أَرساغُهُ وَجَحافِلُه",86,"ل",2,0],["وَظَلَّ بِحَيزومٍ يَفُلُّ نُسورَهُ","وَيَوجِعُهُ صَوّانُهُ وَأَعابِلُه",86,"ل",2,0],["وَظَلَّ بِالوَعرِ الظَمآنُ يَعصِبُهُ","يَومٌ تَكادُ شُحومُ الوَحشِ تَصطَهِرُ",87,"ر",1,0],["وَظَلَّت تُنادي بِالثُدِيِّ نِساؤُهُم","طَوالِعَ بِالعَلياءِ مائِلَةَ الخُمرِ",88,"ر",1,0],["وَظَنَّ أَنّي اِنتَهى بَلائي","فَلَم يَزِدني سِوى بَلاء",89,"ا",2,0],["وَظَنَنتَ أَنَّكَ بالِغٌ شَأوي إِذا","رُمتَ القَريضَ فَما ظَفِرتَ بِحاجِ",90,"ج",1,0],["وَظَنَنتُ أَنّي مُدرِكٌ أَرَبي","إِن غارَ تَحتَ الأَرضِ أَو صَعَدا",91,"د",2,0],["وَظَنَنتُ خافِقَةَ الغُصونِ أَضالِعاً","وَثِمارَهُنَّ القانِياتِ كُبودا",92,"د",2,0],["وَظَلَّتِ التينَةُ الحَمقاءُ عارِيَةً","كَأَنَّها وَتَدٌ في الأَرضِ أَو حَجَرُ",93,"ر",1,0],["وَظَنَنتُ الدَهرَ مَهما حَقَدا","سَوفَ لا يُفجِعُني في وَطَني",94,"ي",1,0],["وظَلْنا نُمازحُه باللِّطامِ","وقفدِ القذال إلى أن نَعِسْ",95,"س",1,0],["وَظَنَّ أَنّي لا أَرعى مَوَدَّتَهُ","حاشايَ مِن ظَنِّهِ هَذا وَحاشاهُ",96,"ه",1,0],["وَظِلتُ بِفِتيانٍ مَعي أَتَّقيهُمُ","بِهِنَّ قَلِيلاً ساعَةً ثُمَّ خُيَّبوا",97,"ب",3,0],["وَظَلَّ الغَيورُ آنِفاً بِبَنانِهِ","كَما عَضَّ بِرذَونٌ عَلى الفَأسِ جامِحُ",98,"ح",1,0],["وَظَلَّ بِالأُكمِ ما يَصري أَرانِبَها","مِن حَدِّ أَظفارِهِ الجُحرانُ وَالقَلَعُ",99,"ع",1,0],["وظلَّ شَريداً وحيداً بعيداً","يُغالبُ عُنْفَ الحَيَاةِ العَصيبْ",100,"ب",1,0],["وظل يفري جلده","فري حنيق غاضب",101,"ب",1,0],["وظلت الشعرى تنا","جي الصبح كالمعاتب",101,"ب",1,0],["وظبية تتثنى","في راحتَى رئبال",102,"ل",1,0],["وَظَهرُكَ العالي هُوَ البِساطُ","لِلنَفسِ في رُكوبِهِ اِنبِساطُ",103,"ط",1,0],["وَظَلَّلَتهُ فَصارَت تَستَظِلُّ بِهِ","غَمامَةٌ جَذَبَتها خيرَةُ الدِيَمِ",104,"م",1,0],["وَظَنّوني مَدَحتُهُم قَديماً","وَأَنتَ بِما مَدَحتُهُمُ مُرادي",105,"د",2,0],["وَظَلَّ الطَعنُ في الخَيلَينِ خَلساً","كَأَنَّ المَوتَ بَينَهُما اِختِصارُ",106,"ر",1,0],["وَظُبىً تَعرِفُ الحَرامَ مِنَ الحِل","لِ فَقَد أَفنَتِ الدِماءَ حَلالا",107,"ل",2,0],["وَظَنِّهِم أَنَّكَ المِصباحُ في حَلَبٍ","إِذا قَصَدتَ سِواها عادَها الظُلَمُ",108,"م",1,0],["وَظَلتَ تَحسِبَ رَبَّ المالِ مالِكَهُ","عَلى الحُقوقِ وَرَبُّ المالِ واهِبُهُ",109,"ب",2,0],["وَظِباءٍ هيفٍ تَجِلُّ عَنِ التَشبي","هِ في الحُسنِ بِالظِباءِ الهيفِ",110,"ف",1,0],["وَظَنَنتُمو ما جِئتُموهُ تُحفَةً","تُعتَدُّ أَو لَطَفاً مِنَ الأَلطافِ",111,"ف",1,0],["وَظَلّامُ أَعداءٍ إِذا بُدِئَ اِعتَدى","بِموجِزَةٍ يَرفَضُّ مِن وَقعِها الدَمُ",112,"م",1,0],["وَظَلَمتُ نَفسي جاهِداً في ظُلمِها","فَاِسمَع مَقالَةَ ظالِمٍ مَذلومِ",113,"م",1,0],["وَظَنُّكَ بِالضَرائِبِ أَن تَكافا","كَظَنِّكَ بِالأَصابِعِ يَستَوينا",114,"ن",2,0],["وَظَبيَةُ دائي وَالشِفاءُ لِقاؤُها","وَهَل أَنا مَدعوٌّ لِنَفسي طَبيبُها",115,"ب",3,0],["وَظَلماءَ تَحتَ الأَرضِ قَد خُضتَ هَولَها","وَلَيلٍ كَلَونِ الطَيلَسانِيِّ أَدعَجا",116,"ج",2,0],["وَظَلَّت تَغالاها التِجارُ وَلا تُرى","لَها سيمَةٌ إِلّا قَليلاً كَثيرُها",117,"ر",3,0],["وَظَلماءَ مِن جَرّا نَوارٍ سَرَيتُها","وَهاجِرَةٍ دَوِّيَّةٍ ما أُقيلُها",118,"ل",3,0],["وَظَلَّ يَعدِلُ أَيَّ المَورِدَينِ لَها","أَدنى بِمُنخَرِقِ القيعانِ مَسؤومِ",119,"م",1,0],["وَظَنَّت بَنو العَجلانِ أَن لَستُ ذاكِراً","عِلاطَهُمُ المَعروضَ تَحتَ العَمائِمِ",120,"م",1,0],["وَظَنَّت عُقَيلٌ أَنَّني لَستُ ذاكِراً","عَجوزَهُمُ الدَغماءَ أُمَّ التَوائِمِ",120,"م",1,0],["وظلنا إذ رأينا الخب","ز ندنو قبل نستدنى",121,"ن",2,0],["وظُباً مُحرَّمَةٌ على أَغْمادِها","حتى تُبيحَ من الضَّلال حَريما",122,"م",2,0],["وَظِلْنا نُمِيتُ لَدَيْها الزِّقاقَ","ونُحيي السُّرورَ بمَوْتِ الزِّقاقِ",123,"ق",1,0],["وظباء لاقت كلاب سلوق","فانثنت وهي داميات الجراح",124,"ح",1,0],["وظِلٌّ لا يُمازِجُه هَجيرٌ","وشَمسٌ لا يُكدِّرُها ضَبابُ",125,"ب",1,0],["وظلَّت صِغارُ السُّفنِ ترقُصُ وسطَها","كَرَقْصِ بَنَاتِ الزَّنْجِ عندَ انتشائِها",126,"ا",3,0],["وَظَلَّ بِوَعساءِ الكَثيبِ كَأَنَّهُ","خِباءٌ عَلى صَقبَي بِوانٍ مُرَوَّقُ",127,"ق",1,0],["وَظَنّي فيكَ يا رَبّي جَميلٌ","فَحَقِّق يا إِلَهي حُسنَ ظَنّي",128,"ي",1,0],["وَظاعِنٍ مِن بَياضِ الرَيطِ كُسوَتُهُ","مُطَيَّبٍ لِلمَنايا غَيرِ مُدَّهِنِ",129,"ن",1,0],["وظبي من الترك نادمته","وبالغت في حسن تأليفه",130,"ف",2,1],["وَظَلَّت بِها يَكوي الهَجيرُ جُلودَها","وَأَخفافُها مِن لَذعِ قَدحِ الحَصى تُكوى",131,"و",2,0],["وَظَلَلنا نُحيي بِها جَوهَرَ النَف","سِ وَنُسقى رَحيقَها المَختوما",132,"م",2,0],["وَظَبيِ إِنسٍ ذي مَعانٍ مُكمَلَه","كَأَنَّهُ دُنيا السَعيدِ المُقبِلَه",133,"ل",2,1],["وَظَبيٍ بِقَفرٍ فَوقَ طِرفٍ مُفَوِّقٍ","بِقَوسٍ رَمى في النَقعِ وَحشاً بِأَسهُمِ",134,"م",1,1],["وَظَبيٍ حازَ رِقّي وَهوَ رِقّي","بِصِحَّةِ كَسرَةِ الطَرفِ السَقيمِ",135,"م",1,1],["وَظَلَّ كُلُّ صَديقٍ يَرتَضي سَخطي","فيهِ وَكُلُّ شَفيقٍ يَرتَجي تَلَفي",136,"ف",2,0],["وَظَلتُ أَغذوهُ بِالعُلومِ وَما","يَزينُهُ وَهوَ فيهِ مُجتَهِدُ",137,"د",1,0],["وَظَلَّ مِن فَرطِ جِرمِ الكَأسِ مُنقَبِضاً","عَنِ المَطارِ وَجِنحُ اللَيلِ قَد جَنَحا",138,"ح",2,0],["وَظَبيَةٍ مِن ظِباءِ التُركِ كانِسَةٍ","لَكِنَّها في رِياضِ القَلبِ قَد سَرَحَت",139,"ت",1,0],["وَظَلتُ كَأَنّي أَملِكُ الدَهرَ عِزَّةً","فَلا تَنزِلُ الأَيّامُ إِلّا عَلى حُكمي",140,"ي",1,0],["وظللتُ أحلم والتفتُّ لساعةٍ","تدنو إِليَّ بطيفك الميّاد",141,"د",1,0],["وظننتُ أني حالمٌ في جَنّةٍ","لمّا رأيتُ الملكَ فيه كبيرا",142,"ر",2,0],["وظباءٍ أمِنَتْ من قانصٍ","لم ينلها الصيدُ في ظلّ المقيلِ",143,"ل",1,0],["وظُباكِ تصرعُ دائباً أهلَ الهَوى","وَظُبا عليٍّ تَصرَع الأبطالا",144,"ل",2,0],["وظباءٍ كأنّهُنّ دُمَاهُ","حينَ تَرْنو لو أنّها تَتَبَرْقَعْ",145,"ع",1,0],["وظَلَّت سِباعُ الماءِ وهيَ تنوشُهُمْ","فلا شلو منهم في صريحٍ ولا قبرُ",146,"ر",1,0],["وَظِباءُ أُنسِكَ لَم تَبَدَّل مِنهُمُ","بِظِباءِ وَحشِكَ ظاعِناً بِمُقيمِ",147,"م",1,0],["وَظَلِلتُ أُلحِفُ في السُؤالِ رُسومَها","وَالمَنعُ مِن تُحَفِ السُؤالِ المُلحِفِ",148,"ف",1,0],["وَظَلَّ بِالظَفَرِ الأَفشينُ مُرتَدِياً","وَباتَ بابَكُها بِالذُلِّ مُلتَحِفا",149,"ف",2,0],["وَظَلِلتُ أُنشِدُهُ وَأَنشُدُ أَهلَهُ","وَالحُزنُ خِدني ناشِداً أَو مُنشِدا",150,"د",2,0],["وَظِلالِهِنَّ المُشرِقاتِ بِخُرَّدٍ","بيضٍ كَواعِبَ غامِضاتِ الأَكعُبِ",151,"ب",1,0],["وَظامٍ يُريغُ الماءَ قَد حيلَ دونَهُ","سَقوهُ ذُباباتِ الرِقاقِ البَوارِدِ",152,"د",1,0],["وَظَلَّ في مَكَّةَ المُختارُ مُنتَظِراً","إِذناً مِنَ اللَهِ في سَيرٍ وَمُعتَزَمِ",153,"م",1,0],["وَظاهَرَت مِن بَني بَكرٍ حَليفَتَها","عَلى خُزاعَةَ أَهلِ الصِّدقِ فِي الذِّمَمِ",153,"م",1,0],["وَظَبْيِ أُنْسٍ سُمْتُهُ","إِنْجَازَ وَعْدِي فَلَوَى",154,"و",2,0],["وَظَلَّ أَعْدَلُ مَنْ تَلْقَاهُ مِنْ رَجُلٍ","أَعْدَى عَلَى الْخَلْقِ مِنْ ذِئْبٍ عَلَى غَنَمِ",155,"م",1,0],["وظنوا بالعزيزِ العجزَ عنها","فجاءَ إليهِ عاصيها مطيعا",156,"ع",2,0],["وَظَلَّت تَهادى ثُمَّ تَمشي تَأَوُّداً","وَتَشكو مِراراً مِن قَوائِمِها فَترا",157,"ر",2,0],["وَظاهَرَني بِمُغتَرَبي حُسامٌ","أَنِستُ بِهِ وَنِعمَ أَخو الغَريبِ",158,"ب",1,0],["وَظَفَّرَهُ في مُلتَقى الخَيلِ ساعِدٌ","أَلَفُّ وَقَلبٌ بَينَ جَنبَيهِ أَصمَعُ",159,"ع",1,0],["وَظَلامِ لَيلٍ لا شِهابِ بِأُفقِهِ","إِلّا لِنَصلِ مُهَنَّدٍ أَو لَهذَمِ",160,"م",1,1],["وَظَلّوا عاكِفينَ عَلَيكَ حَتّى","كَأَنَّكَ كُنتَ مِن خَيرِ الأَماني",161,"ي",1,0],["وَظَننتَ أنَكَ إن لَقيتَ جُنودَهُ","لم تُغْنِ عنه كَتيبَةٌ أو مِقْنَبُ",162,"ب",1,0],["وظنَّ غُواتُهم أن لن يُهدُّوا","بَني غَطفانَ جِدُّوا ثم جِدُّوا",163,"د",3,0],["وظَهر قد حكَا في الشَّكل دالاً","على الِفِ القَوامِ المُستَقِيمِ",164,"م",1,0],["وَظِلالُ القُضبِ اللِطافِ عَلى النَر","جِسِ تَحكي مَراوِداً في عُيونِ",165,"ن",1,0],["وظننْتَ أنَّكَ قَدْ وَهَن","ت فَدَبَّ في العظم الوهنْ",166,"ن",1,0],["وَظِلّاً بِدارٍ مِن سُلَيمى وَطالَ ما","مَضى بِاللَوى صَيفٌ لَها وَرَبيعُ",167,"ع",1,0],["وَظَلَّ دُعاعُ المَتنِ مِن وَقعِ حاجِزٍ","يَخِرُّ وَلَو نَهنَهتَ سَوقَ قَليلِ",168,"ل",1,0],["وَظَلَّ يُناجي أُمَّ شَذرَةَ قاعِداً","كَأَنَّ عَلى شُرسوفِها كُرزَ حَنظَلِ",169,"ل",1,0],["وَظَهَرَت مَشَقَّةٌ في حَلقِهِ","وَماتَ كُلُّ صاحِبٍ مِن فَرقِهِ",170,"ه",1,0],["وَظاهِرُ أَطرافِهِ ساكِنٌ","وَمِن تَحتِهِ حَرَكاتُ الفِطَن",171,"ن",1,0],["وَظَلتَ تُسابِقُ رَحلَ الحُدا","ةِ حِرصاً وَما هِيَ بِالمُطعِمَه",172,"م",2,0],["وَظَلَّ عُذّالُهُ لا كانَ عُذَّلُهُ","لَو يَعلَمونَ الَّذي أَلقى لِما عَذَلوا",173,"ل",3,0],["وَظَلَّت صَوارِمُ أَيمانِنا","تُحَسّيهِمُ المَوتَ في غَيرِ كاسِ",174,"س",1,0],["وَظاهِرَةٍ في نِصفِ شَهرٍ لِمَن يَرى","وَلَكِنَّها مَكتومَةٌ آخَرَ الشَهرِ",175,"ر",1,1],["وَظِباءٍ غَرائِرِ","مُشبَعاتِ المَآزِرِ",176,"ر",1,1],["وَظَلَّت تُديرُ الراحَ أَيدي جَآذِرٍ","عِتاقِ دَنانيرِ الوُجوهِ مِلاحِ",177,"ح",1,0],["وَظَلَّت بِغَيرِكَ مَشغولَةً","فَهَيهاتَ ما بِكَ مِمّا بِها",178,"ب",3,0],["وظّنَّ كلُّ امرِىءٍ فِي قَلْبِهِ مَرَضٌ","بأنَّ مَوْعِدَهُ بالنَّصْرِ مُمْطُولُ",179,"ل",1,0],["وَظَلتُ مِن حَسَناتِ الدَهرِ في مَهَلٍ","حَتّى أَبانَت عُيونُ الصُبحِ إِزعاجي",180,"ج",2,0],["وَظَبيٍ خَلوبِ اللَفظِ حُلوٍ كَلامُهُ","مُقَبَّلُهُ سَهلٌ وَجانِبُهُ وَعرُ",181,"ر",1,0],["وَظَنَّ بِأَنَّ اللَهَ أَحدَثَ بَعدَهُ","ضِياءً مُنيراً أَو قَضى بَعدَهُ أَمرا",182,"ر",2,0],["وَظَنَنتَ أَنّي غَيرُ مُنتَقِمٍ","فَسَكَتَّ حينَ سَكَتَّ عَن عِلمِ",183,"م",1,0],["وَظَبيٍ تَقسِمُ الآجا","لَ بَينَ الناسِ عَيناهُ",184,"ا",2,1],["وَظَنَّ وَهوَ مُجِدٌّ في هَزيمَتِهِ","ما لاحَ قُدّامَهُ شَخصاً يُسابِقُهُ",185,"ه",1,1],["وَظَلِلتُ أَصدُقُهُ وَأَكذِبُهُ","حَتّى يُبايِعَني وَما رَبِحا",186,"ح",2,0],["وَظَلِلتُ أَندُبُ سَيفَ آلِ مُحَمَّدٍ","عُمَراً وَجَلَّ هُنالِكَ المَندوبُ",187,"ب",1,0],["وَظَلَّ عَلى عَلياءَ يَقسِمُ أَمرَهُ","أَيَمضي لِوِردٍ باكِراً أَم يُواتِبُه",188,"ب",2,0],["وَظَلَّ في سَبعَةٍ مِنها لَحِقنَ بِهِ","يَكُرُّ بِالرَوقِ فيها كَرَّ إِسوارِ",189,"ر",1,0],["وَظَنّوا الطُهرَ مُتَّصِلاً بِقَومٍ","وَأُقسِمُ أَنَّهُم غَيرُ الطَهارى",190,"ر",2,0],["وَظاهِرُ أَمرِنا عَيشٌ وَمَوتٌ","وَيَدأَبُ ناسِكٌ لِرَجاءِ بَعثِ",191,"ث",1,0],["وَظُلمٌ أَن أُحاوِلَ فيكِ رِبحاً","وَلَم أَخرُج إِلَيكِ بِرَأسِ مالِ",192,"ل",1,0],["وَظُهورُ تِلكَ أَباحَهُ لَكَ رَبُّها","وَظُهورُ هَذي هَتكَةٌ وَأَثامُ",193,"م",1,0],["وَظَنّوا أَنَّ بوهَ الطَيرِ صَقرٌ","بِجَهلِهِمُ وَأَنَّ الصَقرَ بوهُ",194,"ب",3,0],["وَظالِمٌ عِندَهُ كُنوزٌ","مِن أُمِّ دَفرٍ وَمِن لُهاها",195,"ا",3,0],["وظنّوكَ ممَنْ يُطفئُ البرْدُ نارَهُ","إذا طَلَعَتْ عند الغُرُوبِ جَهامُ",196,"م",1,0],["وَظُلمُ ذَوي القُربى أَشَدُّ مَضاضَةً","عَلى المَرءِ مِن وَقعِ الحُسامِ المُهَنَّدِ",197,"د",1,0],["وَظِباءً كَأَنَّهُنَّ أَباري","قُ لُجَينٍ تَحنو عَلى الأَطفالِ",198,"ل",1,0],["وَظَلَّ لِنِسوَةِ النُعمانِ منّا","عَلى سَفَوانَ يَومٌ أَرَوناني",199,"ن",2,0],["وَظَنيَ أَنَّ الموت قد كانَ قاصِداً","سليمى فَقالَت إنني أنا دلبر",200,"ر",1,0],["وظنيَ أَني سَوفَ ألقى حفاوة","يَطول عَلى الأيام مني لها الشكر",201,"ر",1,0],["وظلّ لبى ذاهِلاً","كأنه لَيسَ مَعي",202,"ي",1,0],["وظل يَرغو الرعد بع","د البرق فوق الأربُع",202,"ع",1,0],["وَظنك حسناً باللَيالي سفاهة","وَرأيك في الأيام غير سَديد",203,"د",1,0],["وظامئاً مهما تُتَح","مواردٌ أن أشربا",204,"ب",2,0],["وظَفِرتِ من تمثيله وغنائهِ","بأدقّ مثّالٍ وأرخمِ طائرِ",205,"ر",1,0],["وظلالَ النخيل في شَفَقٍ","س