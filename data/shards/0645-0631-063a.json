{"poems":[[104,"لا تقل لله لبنان الأشم","https://www.aldiwan.net/poem32913.html","الرمل"],[119,"ان جزت في بطحاء ام عبيدة","https://www.aldiwan.net/poem41080.html","عموديه"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87272","الرمل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48548","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38390","الرمل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59652","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59124","الخفيف"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133764","الخفيف"],[1341,"","https://poetry.dctabudhabi.ae/diwan/poem/124697","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69375","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27141","الكامل"],[2338,"","https://poetry.dctabudhabi.ae/diwan/poem/111147","الرمل"],[2596,"","https://poetry.dctabudhabi.ae/diwan/poem/97587","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74235","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118005","البسيط"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86540","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125815","الكامل"],[4929,"القدس بوابة العبور إلى المجد","https://www.poetsgate.com/ViewPoem.aspx?id=199179",""],[4929,"صدى الواقع","https://www.poetsgate.com/ViewPoem.aspx?id=199284",""],[4929,"سراب الرجال","https://www.poetsgate.com/ViewPoem.aspx?id=201708",""],[5136,"أضحك النصر مبسم العلياء","https://www.poetsgate.com/ViewPoem.aspx?id=121488",""],[5376,"وشجى على هولِ المصاب ِهَزَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=189133",""],[5431,"قبلة الأمس...","https://www.poetsgate.com/ViewPoem.aspx?id=210259",""],[5533,"وانتصَرَتْ حَلَب","https://www.poetsgate.com/ViewPoem.aspx?id=181540",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[5851,"قبس في منتصف الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=175274",""],[6035,"الغيّ ياكسرى عَصِيّ كَيّه .. !","https://www.poetsgate.com/ViewPoem.aspx?id=177042",""]],"verses":[["مرغماً يَنساق وَالريح تَثور","يا فُؤادي أِين أَيام الهَوى",0,"ه",3,0],["مرغ جبينك في ثراه ولا تخف","وانشق عبير المسك من ذاك الثرى",1,"ر",2,0],["مُرغمٌ أَنفَ اللئامِ","بِبَني حامِ الكِرامِ",2,"م",1,0],["مرغياً كالجمل المص","عب إذ حل عقالا",3,"ل",2,0],["مَرِّغِ الخَدَّينِ مِنها بِالتّرابْ","وَاِكتَحل مِنهُ فَذاك الإِثمدُ",4,"د",1,0],["مرَّغْتُ خدي رغبة لك في الثرى","ونشبتُ كفي في فضول ردائك",5,"ك",1,0],["مُرْغِمٌ بِالنِّضَالِ أنْفَ المُعَادِي","مُضْحِكٌ بِالنَّوَالِ ثَغْرَ الوَدُودِ",6,"د",1,0],["مرغوا الهام دون مردوك في","بابل خوف السنا المشع البادي",7,"د",2,0],["مرّغي جبهة الرجولة كبرا","عند رجليك واهزأي بالنسور",8,"ر",1,0],["مُرغِبٌ مُرهِبٌ فَقَد مَلَأَ الآ","فاقَ أَمناً وَطَبَّقَ الأَرضَ عَدلا",9,"ل",2,0],["مَرَّغتُ خَدّي رِقَّةً وَصَبابَةً","فِبِحَقِّ حَقِّ هَواكُمُ لا تُؤيسوا",10,"س",3,0],["مرغماً من كم لنا حل الحبا","لانحلال الحب أو عقد القلا",11,"ل",2,0],["مرّ غرابٌ بنا يمسح وجه الربى","قلت له مرحباً يا لون شعر الصبى",12,"ب",2,1],["مرغ بخدك تمثالاً لَها فَله","فَضل كَما وَرَدَت في ذاكَ آثار",13,"ر",1,0],["مرغ خدودك في أعتاب مشهده","والزم ثرى بابه واعكف بناديه",14,"ي",2,0],["مرغم أنفه على صفحة القر","طاس كي يستفيد رغم الأنوف",15,"ف",1,0],["مرِّغ جبينك في التراب مقدساً","ومبصبصاً كالكلب تخرج ظافرا",16,"ر",2,0],["مرغُوا لإسرائيلَ أنفَ غُرورِها","ببسالةٍ لم يُثْنِها إرهابُ",17,"ب",1,0],["مَرَغْنَا أنفَ إمريكا اجتثاثاً","لهم فتسعَّرت شررًا ونارا",18,"ر",2,0],["مرغتُم به أنفَ الذي احتلَّ دارَكم","وشرَّدَكم في كلِّ قُطرٍ وبدَّدَا",19,"د",2,0],["مرغ الخد بالتراب خضوعاً","لجلال العزيز ذي الكبرياء",20,"ا",2,0],["مرِّغْ لأنْفَكَ بلْ وزِدْ تعفيرِه","ما عاد فينا قائدٌ مغوارُ",21,"ر",1,0],["مرّغت صدرها رمادَ اشتعالي","فانتشى الحب روضة أبدية",22,"ي",2,0],["مرِّغي أَنْفَ الطُّغاةِ بالثَّرى","وانثُري النورَ بدَفْعِ الغَيْهَبِ",23,"ب",1,0],["مُرِّغتْ آنافُ الأعِزَّةِ في الوحْل ِ","ودانت لِلعَمِّ سامَ الذقونُ",24,"ن",1,0],["مرغت حرفي في التراب تولها","فاخضر يوقظ في الفؤاد سنابلا",25,"ل",2,0],["مرَّغْتِ أنفَ العابثين بِوَصْلِنا","ووصلتِ رِحْماً من عقودٍ نازفةْ !",26,"ف",2,0]]}