{"poems":[[74,"هجرت بديع القول هجر المباين","https://www.aldiwan.net/poem20186.html","الطويل"],[81,"ولقبت المسدس وهو نعت","https://www.aldiwan.net/poem29562.html","الوافر"],[87,"ممات في المواكب أم حياة","https://www.aldiwan.net/poem62910.html","الوافر"],[87,"سلو قلبي غداة سلا وثابا","https://www.aldiwan.net/poem63783.html","الوافر"],[45,"مغاني الشعب طيبا في المغاني","https://www.aldiwan.net/poem10596.html","الوافر"],[63,"على أبن العصب الملحي","https://www.aldiwan.net/poem51279.html","الهزج"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16680","الوافر"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/117010","الطويل"],[108,"بيوت الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=179528",""],[285,"متى ارتجعت مواهبها الكرام","https://www.aldiwan.net/poem60717.html","الوافر"],[422,"شفيت بطرد صالح كل صدر","https://www.aldiwan.net/poem53900.html","الوافر"],[422,"سنا برق تبلج واستنارا","https://www.aldiwan.net/poem54050.html","الوافر"],[422,"سطا بحسام مقلته وصالا","https://www.aldiwan.net/poem54125.html","الوافر"],[435,"سل الخطي والبيض الصقالا","https://www.aldiwan.net/poem40268.html","الوافر"],[469,"خليلي ما بال النجوم كأَّنما","https://www.aldiwan.net/poem3154.html","عموديه"],[487,"يلومونني أهل البعاد على العذب","https://www.aldiwan.net/poem24287.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86754","الطويل"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132807","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77990","الوافر"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11214","الطويل"],[2391,"","https://poetry.dctabudhabi.ae/diwan/poem/18050","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65953","الطويل"],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145542","الطويل"],[3411,"","https://poetry.dctabudhabi.ae/diwan/poem/79761","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91129","المتقارب"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131272",""],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29302","المجتث"],[4301,"","https://poetry.dctabudhabi.ae/diwan/poem/146709","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81706","الطويل"],[4830,"حذار","https://www.poetsgate.com/ViewPoem.aspx?id=194147",""],[5703,"اللقاء الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=206134",""],[6124,"خيوط","https://www.poetsgate.com/ViewPoem.aspx?id=201329",""],[5355,"تَذكَّريني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87132&r=&rc=27",""]],"verses":[["فلو طابَ ليَ طابت حياتِي بعدهم","وكنت ألاقيهم بطلعة خائن",0,"ن",1,0],["فَلوطيّ ومأبون وزانٍ","وديّوث وقرنان وسارق",1,"ق",1,0],["فَلَو طُلِبَت لَهُم دِيَةٌ لَقالَت","كُنوزُ الأَرضِ نَحنُ هِيَ الدِياتُ",2,"ت",1,0],["فَلَو طالَعتَ أَحداثَ اللَيالي","وَجَدتَ الفَقرَ أَقرَبَها اِنتِيابا",3,"ب",2,0],["فَلَو طُرِحَت قُلوبُ العِشقِ فيها","لَما خافَت مِنَ الحَدَقِ الحِسانِ",4,"ن",1,0],["فلو طارت بنا ضعفا","صبا لاعبة طرنا",5,"ن",2,0],["فلو طُعِنَ الفتى بأشَدّ غُصْنٍ","حَنَاهُ أشَدُّ حِصْنٍ في الهِياج",6,"ج",1,0],["فلو طاوَعَتني بالمكارمِ قدرَةٌ","لجادَ عليها بالنوالِ ربيعُها",7,"ع",3,0],["فلو طاب المقام ببيت شعر","إذًا لأقمتُ في أعلى بناء",8,"ا",2,0],["فَلَوْ طُبِعَ الْفَخُرُ سَيْفاً لَكُنْ","تَ دُونَ الْوَرى حَدَّهُ وَالْفِرِنْدا",9,"د",2,0],["فلو طالت يداه عليك يوماً","أراك الحتفَ ذو الباع القصير",10,"ر",1,0],["فلو طار السرور بمجتليها","على الندمان يومئذٍ لطارا",11,"ر",2,0],["فلو طاولنَه السُّمر العوالي","على نيل المرام إذنْ لطالا",12,"ل",2,0],["فلو طلبت اسنته عدواً","ولو فوق السماك هوى ومالا",13,"ل",2,0],["فلو طرَّقت أن الليالي بمثلها","لذي حسبٍ ما نظم الجزعَ ثاقبه",14,"ب",2,0],["فلو طلبوا مني الخضوع ليقطعوا","لكنت سميعا مبصرا لفنا العطب",15,"ب",1,0],["فَلو طاف بي في النَوم وَهوَ محرّمٌ","عَليّ خَيالٌ جاءَني بعتيد",16,"د",1,0],["فلو طُبعت بيضُ السيوفِ على اسمه","مَضت وهي في الأغماد في كلِّ مَضربِ",17,"ب",1,0],["فلو طعمت طعام الطاعمينا","جميعاً منا شبعنا ولا هنينا",18,"ن",2,1],["فَلو طاوَعَتني آلُ سَلمى إِبنِ مالِكٍ","لَأَعطَيتُ مَهراً مِن مَسَرَّةَ غالِيا",19,"ي",2,1],["فَلَو طُفتَ بَينَ الشَرقِ وَالغَربِ لَم تَجِد","لِقومٍ عَلى قَومي وَلَو كَرُموا فَضلا",20,"ل",2,0],["فلو طمع الأشرار مني بهفوة","إلى الظلم قالوا ما سواك يسود",21,"د",1,0],["فلو طار فوق الأرض أو غار تحتها","لما خال أن المنتأى عنك واسع",22,"ع",1,0],["فلو طاوعوني يوم بُطْنانَ أُسْلِمَتْ","لقيسٍ فروجٌ منكمُ وأنامِلُ",23,"ل",1,0],["فَلو طلعت عليهم","لَوليت مِنهُم فَرارا",24,"ر",2,0],["فلو طلب الماء ما بيننا","له مسرباً لم يجد مسربا",25,"ب",2,0],["فَلَو طَلَبتَ مَزيداً","لَما أَصبَتَ مُناكا",26,"ك",2,0],["فلو طاف في دارين ما طاب مسكه","ولو ماج في بئرين ما ماج رمله",27,"ل",2,0],["فلو طرقت قُسَاً وقد قام خاطباً","لأصغى لها سمعاً وقال لها قُصِّي",28,"ص",2,0],["فلو طُليَ الحديدُ بخير تبرٍ","لما ساوى من الذهب اللُّبابا",29,"ب",2,0],["فَلو طَلَبْتَ حَياتي مابَخلتُ بها","ولا أراكَ تَعيسَ القلبِ حَيرانا",30,"ن",2,0],["فَلَوْ طَالَ الهَوَى ثَوْبكْ","لَمَاجَ البَحْرُ وَالحَانُ.",31,"ن",1,0],["فلو طال البعاد تذكريني","برغم الهجر في يوم أعودُ",32,"د",1,0]]}