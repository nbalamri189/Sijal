عِ مِنهُمُ","مَناصِبُ أَعناقٍ رِزانِ الجَماجِمِ",2,"م",1,0],["مِنَ القَومِ ما زَرّوا الجُيوبَ عَلى الخَنا","وَلا قُرِعَت أَسماعُهُم بِمَلامِ",3,"م",1,0],["مِنَ القَومِ الَّذينَ أَقامَ فيهِم","عِدادُ المَجدِ وَالعَدَدُ اللُهامُ",4,"م",1,0],["مِنَ القَومِ الأُلى مَلَكوا رِقابَ ال","أَواخِرِ وَاِختَلوا قِمَمَ الأَوالي",5,"ل",2,0],["مِنَ القَومِ طاروا في الفَلا كُلَّ طَيرَةٍ","وَمَدّوا إِلى الأَحسابِ بوعاً وَأَذرُعا",6,"ع",2,0],["مِنَ القَومِ طالوا كُلَّ طَولٍ إِلى العُلى","إِذا أَذرُعٌ يَوماً قَصَرنَ وَبوعُ",7,"ع",1,0],["مِنَ القَومِ حَلّوا بِالرُبى وَأَمَدَّهُم","قَديمُ المَساعي وَالعَلاءُ القَدامِسُ",8,"س",1,0],["مِنَ القَومِ الأُلى مَلَأوا اللَيالي","إِلى أَصبارِها كَرَماً وَآدا",9,"د",2,0],["مِنَ القَومِ الأُلى طَلَبوا وَنالوا","وَجَدُّ بِهِم إِلى العَلياءِ جَدُّ",10,"د",1,0],["مِنَ القَومِ أَشباهُ المَكارِمِ فيهِمُ","وَعِرقُ المَعالي الغُرِّ وَالحَسَبِ العِدِّ",11,"د",1,0],["مِنَ القَومِ حَلّوا في المَكارِمِ وَالعُلى","بِمُلتَفِّ أَعياصِ الفُروعِ الأَطايِبِ",12,"ب",1,0],["مِنَ القرَياتِ الجُلحِ خَلَّفَها لَهُ","أَبٌ حينَ واراهُ وُقيتَ الرَدى لَحدُ",13,"د",1,0],["مِنَ القَوْمِ تَسْتَحْلِي المَنايَا نُفُوسَهُمْ","وَيَخْتالُ تِيهاً في ظِلالِهِمُ الوَفْدُ",14,"د",1,0],["مِنَ القومِ لا مأْوَى المَساكينِ مُقْفِرٌ","لدَيْهِمْ ولا مَثْوى الصّعاليكِ مُمْحِلُ",15,"ل",1,0],["منَ القَوْمِ يُزْجِي الرّاغِبونَ إلَيْهِمُ","على نَصَبِ المَسْرى غُرَيْرِيَّةً صُهْبا",16,"ب",2,0],["منَ القَوْمِ لمْ يَسْتَقْدِحِ المَجْدُ زَنْدَهُ","لدى الفَخْرِ إلاّ أوْقَدوا بِضِرامِ",17,"م",1,0],["منَ القَوْمِ لا يَسْتَضْرِعُ الدّهْرُ جارهُمْ","ولا يَتحاماهُ حِذارَ النّوائِبِ",18,"ب",1,0],["منَ القَوم لا المُزْجي إلَيهمْ رَجاءَهُ","بِمُكْدٍ ولا المُثني عَلَيْهمْ بمُفْحَمِ",19,"م",1,0],["منَ القومِ عدَّ النّاسِبونَ بيوتَهُمْ","فلَم يُنْكِروا أن النّجومَ لَهمْ رَهْطُ",20,"ط",1,0],["مِنَ القَومِ يُلفي الرّاغِبونَ لَدَيهِمُ","مَكارِمَ عبّاسِيَّةً وأيادِيا",21,"ي",2,0],["مِنَ القاصِراتِ الطَرفِ أَمّا وِشاحُها","فَيَبكي وَأَمّا الحِجلُ مِنها فَصائِمُ",22,"م",1,0],["منَ القومِ شادُوا الدّينَ بَدْءاً ودافَعوا","بأسْيافِهمْ عنْ رُكْنِهِ الوهْنَ والوَهْيَا",23,"ي",2,0],["منَ القومِ جادُوا بالنّفوسِ كأنّما","يُسَقّوْنَ في وِرْدِ الرّدى الشّهْدَ والأرْيا",23,"ي",2,0],["منَ القومِ خاتِمَ الرُّسْلِ أحْمَدٍ","وهُمْ عضّدوا التّنْزيلَ والحَقَّ والوَحْيا",23,"ي",2,0],["مِنَ القَومِ أَمّا أَحنَفٌ فَمُسفَّهٌ","لَدَيهِم وَأَمّا حاتِمٌ فَبَخيلُ",24,"ل",1,0],["مِنَ القَومِ وَضّاح الأَسِرَّةِ ماجِدٌ","إِلى آلِ أَيّوبَ الكِرامِ اِنتِسابُهُ",25,"ب",2,0],["مِنَ القاصِراتِ الطَرفِ لَو دَبَّ مُحوِلٍ","مِنَ الذَرِّ فَوقَ الإِتبِ مِنها لَأَثَّرا",26,"ر",2,0],["مِنَ القَومِ مَغشِيُّ الرِواقِ كَأَنَّهُ","إِذا سيمَ ضَيماً خادِرٌ مُتَبَسِّلُ",27,"ل",1,0],["من القروش النيكل ملء","عيون المجتلي",28,"ي",1,0],["من القوم صانوا المجد صون عينُهُ","كما قد أباحوا المال يُنهّبُ للرُفدِ",29,"د",1,0],["من القومِ في بطحاءِ مكَّة منزل","لهم وفنىً حولَ الشِّعابِ شِعاب",30,"ب",1,0],["من القوم في بطحاءِ مكة أصلهم","وأفناؤهم في الخلق فوَّاحة الزّهر",31,"ر",1,0],["من القوم الذين لهم صعودٌ","إلى العلياءِ أسرع من حدور",32,"ر",1,0],["من القومِ فاتوا الناس سبقاً إلى العلى","ألم ترهم أندى أكفًّا وأبسطا",33,"ط",2,0],["من القوم فرسان البلاغة والوغى","على أنهم لله أيّ رجال",34,"ل",1,0],["من القوم حلوا كل آفاق دولة","فهم في سماء العزّ والرأي شهبان",35,"ن",1,0],["من القومِ تمحى نجوم السما","وآثار سؤددهم باقيه",36,"ي",2,0],["من القوم لا يستحمدون ببذلهم","ولكنهم يعطون جود طبائع",37,"ع",1,0],["مِن القومِ لا يرعَوْنَ حقاً لشاعرٍ","ولا تَقْتدي أفعالُهم بفعالكا",38,"ك",2,0],["مِنَ القَومِ إِلّا ذو عَفافٍ يُعينُهُ","عَلى ذاكَ مِنهُ صِدقُ نَفسٍ وَخَيرُها",39,"ر",3,0],["مِنَ القِيانِ هَتوفٌ طالَما رَكَدَت","لِفِتيَةٍ يَشتَهونَ اللَهوَ وَالغَزَلا",40,"ل",2,0],["مِنَ القَومِ أَفطاسٌ كَأَنَّ أُنوفَهُمُ","أُنوفُ خَنازيرٍ يُراقِبنَ خارِيا",41,"ي",2,0],["مِنَ القُرى القانِعَةِ الطاوِيَه","وَالمُدُنِ الجامِحَةِ الغادِيَه",42,"ه",1,0],["مِنَ القاسِمينَ الشُكرَ بَيني وَبَينَهُم","لِأَنَّهُمُ يُسدى إِلَيهِم بِأَن يُسدوا",43,"د",3,0],["من القوم يَحنونَ الضلوعَ شوابكا","جُنوحاً على مسِّ الهُموم اللوازمِ",44,"م",1,0],["من القومِ حنَّ المُلكُ مذ عهدِ آدمٍ","إليهمْ فوافاهم مُقيماً مخيِّما",45,"م",2,0],["من القوم طاروا في المعالي فحلَّقُوا","وراموا هِضابَ العِزِّ حتى تفرَّعُوا",46,"ع",3,0],["من القادحاتِ النارَ في لُجِّ غَمْرةٍ","ولا الجمرُ مشبوبٌ ولا الماء مشروبُ",47,"ب",1,0],["مِنَ القَومِ مَرجوٌّ لِما الغَيثُ دونَهُ","وَفي القَومِ مَن لا يُرتَجى لِبِلالِ",48,"ل",1,0],["مِنَ القَومِ يَستَحمي إِذا حَمِسَ الوَغى","لِهاماتِ كُلّاحِ الرِجالِ ضَروبُها",49,"ب",3,0],["مِنَ القَومِ إِلّا مَن تَصَعَّدَ مَجدُهُ","إِلى الشَمسِ إِذ فاءَت عَلَيهِ ظِلالُها",50,"ل",3,0],["مِنَ القَومِ في مَتنِ الجِيادِ وِلادُهُم","كَأَنَّ مُتونَ الصافِناتِ مُهودُ",51,"د",1,0],["مِنَ القَومِ إِن عُدَّ الفَخارُ فَإِنَّهُم","هُمُ الروحُ فَخراً وَالأَنامُ جَوارِحُ",52,"ح",1,0],["مِنَ القِلاصِ الخورِ وَالجِلادِ","وَالمُقرِباتِ الصُفُنِ الجِيادِ",53,"د",1,0],["مِنَ القِلاصِ اللَواتي في حَقائِبِها","بِضاعَةٌ غَيرُ مُزجاةٍ مِنَ الكَلِمِ",54,"م",1,0],["مِنَ القَومِ جَعدٌ أَبيَضُ الوَجهِ وَالنَدى","وَلَيسَ بَنانٌ يُجتَدى مِنهُ بِالجَعدِ",55,"د",1,0],["مِنَ القِرطاتِ في الآذانِ تَبقى","بَقاءَ الوَحيِ في الصُمِّ الصِلابِ",56,"ب",1,0],["مِن القَومِ أَدَّتهُم إِلى خَيرِ أَبطُنٍ","تَخَيَّرنَ لِلأَبناءِ خَيرَ ظُهورِ",57,"ر",1,0],["مِنَ القَومِ سادوا في المُهودِ نَجابَةً","وَطَبّوا صِغاراً مِن كُلومِ العَظائِمِ",58,"م",1,0],["مِنَ القَولِ الَّذي قَد قا","لَ واشٍ ظالِمٌ فيهِ",59,"ي",2,0],["من القادحاتِ النّارَ تُضْرَمُ للطُّلى","فليس لها يومَ اللّقاء خُمود",60,"د",1,0],["مِنَ القَومِ بَسّامٌ كَأَنَّ جَبينَهُ","سَنا الفَجرِ يَسري ضَوءُهُ وَيُنيرُ",61,"ر",1,0],["مِنَ القادَةِ المُستَأذِنينَ إِذا غَدا","كَأَنَّ عَلى أَعطافِهِ ضَوءَ مِصباحِ",62,"ح",1,0],["مِنَ القَومِ الكِرامِ وَهُم شُموسٌ","وَلَكِن لا تُوارى بِالدُجونِ",63,"ن",1,0],["مِنَ الْقَوْمِ ضَرَّابِي الْعَرَاقِيبِ وَالطُّلَى","إِذَا اسْتَنَّتِ الْغَارَاتُ أَوْ فَغَرَ الْمَحْلُ",64,"ل",1,0],["مِنَ الْقَوْمِ بَادٍ مَجْدُهُمْ فِي شِمَالِهِمْ","وَلا مَجْدَ إِلا دَاخِلٌ فِي الشَّمَائِلِ",65,"ل",1,0],["مِنْ آل قَطَّانَ الأَمَاجِيدِ الأُلَى","هُمْ دَوْحَةٌ تَزكو عَلَى الأَزْهارِ",66,"ر",1,0],["مِنَ القَوَافِ