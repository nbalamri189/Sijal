,"https://www.poetsgate.com/ViewPoem.aspx?id=132240",""],[4829,"الجابريّة","https://www.poetsgate.com/ViewPoem.aspx?id=35605",""],[4578,"يا من بألفاظه ازدانت نواحينا","https://www.poetsgate.com/ViewPoem.aspx?id=49531",""],[4858,"رثاء البطل الشهيد مجاهد شحادة","https://www.poetsgate.com/ViewPoem.aspx?id=33320",""],[4858,"حافلة الموت","https://www.poetsgate.com/ViewPoem.aspx?id=138780",""],[4859,"محيط مرامي","https://www.poetsgate.com/ViewPoem.aspx?id=197032",""],[4869,"رساله إلى لوجين .. شطحه","https://www.poetsgate.com/ViewPoem.aspx?id=151714",""],[4929,"الشعر في معادلة التغيير","https://www.poetsgate.com/ViewPoem.aspx?id=199508",""],[4978,"من قال أنساك يوما، في الهوى كذبا","https://www.poetsgate.com/ViewPoem.aspx?id=177182",""],[4984,"معركة \" الشوابير\"","https://www.poetsgate.com/ViewPoem.aspx?id=191622",""],[5150,"غربة","https://www.poetsgate.com/ViewPoem.aspx?id=202797",""],[5183,"سلطان الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=180268",""],[5184,"داريْ صِغاركِ","https://www.poetsgate.com/ViewPoem.aspx?id=186356",""],[5206,"في علم الحكمة","https://www.poetsgate.com/ViewPoem.aspx?id=187418",""],[5320,"إلى رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=40398",""],[5370,"حروف ومعاني","https://www.poetsgate.com/ViewPoem.aspx?id=86514",""],[5431,"مازال يأسرني الإعجاز من شفة","https://www.poetsgate.com/ViewPoem.aspx?id=195158",""],[5431,"علّي أرى علّي","https://www.poetsgate.com/ViewPoem.aspx?id=195184",""],[5431,"ياقلبها المملوء فيك محبة","https://www.poetsgate.com/ViewPoem.aspx?id=195245",""],[5431,"لتخلصه ....","https://www.poetsgate.com/ViewPoem.aspx?id=210627",""],[5460,"خبّاب إنك قد ملحت فما ترى","https://www.poetsgate.com/ViewPoem.aspx?id=200743",""],[5691,"عروش الطغاة","https://www.poetsgate.com/ViewPoem.aspx?id=207075",""],[5783,"لم تعقمي يا أمة الأحرار","https://www.poetsgate.com/ViewPoem.aspx?id=34050",""],[5821,"امانه","https://www.poetsgate.com/ViewPoem.aspx?id=113761",""],[5829,"شدو المستهام في مدح خير الأنام","https://www.poetsgate.com/ViewPoem.aspx?id=155538",""],[5829,"الفجر آتٍ والحساب عسير","https://www.poetsgate.com/ViewPoem.aspx?id=157213",""],[5848,"ارتباكات القلق","https://www.poetsgate.com/ViewPoem.aspx?id=48862",""],[5950,"ممكن أغنّي على الطاروق","https://www.poetsgate.com/ViewPoem.aspx?id=128138",""],[5950,"أحيان تتنازل عن الحلم وتعيش","https://www.poetsgate.com/ViewPoem.aspx?id=139966",""],[5956,"سعادةٌ من التفوق على بؤس الشعور","https://www.poetsgate.com/ViewPoem.aspx?id=183909",""],[5956,"متربصون","https://www.poetsgate.com/ViewPoem.aspx?id=185606",""],[5956,"لِكثيرِ من صادفتهم أنذالا","https://www.poetsgate.com/ViewPoem.aspx?id=193418",""],[5956,"المجد ينبع من عينيك والهممُ","https://www.poetsgate.com/ViewPoem.aspx?id=206263",""],[6068,"مرض الحبيب فزرته إسعافا -05-","https://www.poetsgate.com/ViewPoem.aspx?id=177672",""],[4442,"فقه الشريعة أول","https://www.poetsgate.com/ViewPoem.aspx?id=171209",""],[6142,"سل كربلا والوغى والبيض والأسلا","https://www.poetsgate.com/ViewPoem.aspx?id=155747",""],[6187,"آخر أنفاس الحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82157&r=&rc=0",""],[6213,"القَدَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76315&r=&rc=63",""],[5080,"حتّام ترثي نخيلا في العناوينِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88135&r=&rc=5",""],[6242,"التِّمثال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87561&r=&rc=8",""]],"verses":[["لكن وقار الشيب لا يعدل ما","في طيّه من لوثة ومن ونى",0,"ا",1,0],["لكنْ وفودُ الشكرِ لا","تنفكُّ قد شحنتْ رحابهْ",1,"ب",2,0],["لَكِن وَجَدتُكِ في المَساءِ وَضَعتِ رَأسَكِ في يَدَيكِ","وَجَلَستِ في عَينَيكِ أَلغازٌ وَفي النَفسِ اِكتِئاب",2,"ب",1,0],["لَكِنَّ وَجهَ الَّذي كَلِفتُ بِهِ","مُحتَمَلٌ ذَنبُهُ وَمَغفورُ",3,"ر",1,0],["لَكِنَّ وارِدَةَ الحِما","مِ مَوائِلاً عِندي مُثولا",4,"ل",2,0],["لَكِن وَلونا بِإِنصافٍ وَمَعدَلَةٍ","حَتّى هَجَدنا وَكُنّا غَيرَ هُجّادِ",5,"د",1,0],["لَكِنْ وَكَمْ لَكِنْ تُقَالُ","إِذَا كَبَا بِالجَدِّ كَابْ",6,"ب",1,0],["لكنوز ، من شعوذات التمني","تتبدّى ثنى ، وتخفى فرادى",7,"د",2,0],["لكن وَجْدتُ القوافي تَشْتَكي عَنتاً","والمنبرَ الحُرَّ يشكو فَرطَ ما افترعا",8,"ع",2,0],["لكن وجدت الشعرَ مهنةَ عاجز","إن لم يَقُمْ عني بشكر نَداكا",9,"ك",2,0],["لكن وفاء لنعمى منك سابقة","وأنّك الكنز للأوطان يدّخر",10,"ر",1,0],["لكن وضيع الطبع في","قيد العيوب عن المعالي",11,"ل",2,0],["لكن وقاه الله جل جلاله","من حرها المشبوب واللهبان",12,"ن",1,0],["لكن ولا بدّ من الموقّفِ","ومرشدٍ لنهجها معرّفِ",13,"ف",1,0],["لكنْ وَرِثْتُ لكمْ قديمَ مَودّةٍ","أَضحَتْ قَواعدُها وهُنَّ رواس",14,"س",1,0],["لكن وثقت بمدتي","والعمر فخٌّ منطرح",15,"ح",1,0],["لكن وحي اللَه سرٌّ غامضٌ","يؤتيه من يأتيه وهو مهذب",16,"ب",1,0],["لكن وجدتُ بَرَاعَتِي اعْتَذَرتْ","لبَرَاعَتِي بتقاصُرِ الشِّيَمِ",17,"م",1,0],["لكن وجدت طريق المدح متسعاً","فيه وحبي له محضاً فقد سبقا",18,"ق",2,0],["لكن وجدت مكان الحمد متسعا","ولي لسان وقلب فيه قد طبعا",19,"ع",2,0],["لكن وجدت سبيل المدح فيه على","حب الإله وحبي فيه متسعا",20,"ع",2,0],["لكن وعدنا بهذا ليس منفلتا","عنه ومنا الذي يبقى إلى أجل",21,"ل",1,0],["لكن وردت قراراة الغمر الذي","تغدو عبيداً عنده الأرباب",22,"ب",1,0],["لكن وعدتِ بأن تَعودي عَودَةً","تَشفِي منَ القَلب الظَّميءِ غَليلا",23,"ل",2,0],["لكن وجودك قابل وكذا الورى","للصفو فاسلك يا هنا من يسلك",24,"ك",1,0],["لَكِنْ وَجَدْتُ الشِّعْرَ لِلْ","آدَابِ تَرْجَمَةً فَصِيْحَهْ",25,"ح",2,0],["لكن وصيٌّ خازنٌ عندَه","عِلمٌ من اللهِ به يَعمَلُ",26,"ل",1,0],["لكن وجهك فاق نو","ر الشمس بالإشراق جداًّ",27,"د",2,0],["لكن وثوقي بالكريم فإنّه","مولىً ورحمته أجلُّ وأوسع",28,"ع",1,0],["لكن وإن لولا ألا أما أما","ولام الابتدا وحتى ربّما",29,"م",2,0],["لَكِن وَأَوَّتَاهُ باِسم تَمدُّن","أَغوَى الكِبَارُ بِسرِّهِ صُغَرَاكُمُ",30,"م",1,0],["لَكِنْ وَقَفْتُ اليَومَ في مهدأ","أبحَثُ كُلَّ البَحثِ عنْ مَلجَأٍ",31,"ج",2,0],["لَكِن وَإِن طَالَ مَدحِي لا أَفِي أَبَداً","فأَجعَلُ العُذرَ وَالإِقرارَ مُختَتَمِي",32,"م",2,0],["لكن ولي أمرنا علي","في كل مجد جدّه علي",33,"ي",1,0],["لكن وثقت وقد علقت بمعشر","يا ليتهم لم ينقضوا ما أبرموا",34,"م",3,0],["لكن وجدي لأهل الخيف يطربني","شوقاً عسى منهم أن أبلغ الوطرا",35,"ر",2,0],["لَكِنَّ وَهمَ العَبدِ ثُمَّ خَيَالُهُ","فِي ذِي المَظَاهِرِ دَائِماً يَلِجَانِ",36,"ن",1,0],["لَكِنَّ وَصفَ الحَيِّ لاَزِمُ ذَلِك ال","مَعنَى لُزُومَ العِلمِ للِرَّحمَنِ",36,"ن",1,0],["لكن وجدتك في العرباء جاهدها","وسادنا لعلى خلق وإسلام",37,"م",1,0],["لكن ولا كَكِتَابِ اللهِ مُعجِزَةً","فنورُها لجميعِ العالمينَ بدا",38,"د",2,1],["لَكِنَّ وَحيَ المَرءِ بَينَ جَنانِهِ","وَلِسانِهِ وَيَراعَةِ الإِنشاءِ",39,"ا",2,0],["لك نور يا ربي ولا نار ولا زيت","نورت به القلب فصلى وعبد",40,"د",1,0],["لكن ويا طول شوقي نحو أربعها","أرى أسي لتنائيَّ الأسى جلبا",41,"ب",2,0],["لكن واجبكم علي رأيته","أولى فقمت به القيامَ الأفضلِ",42,"ل",1,0],["لَكن وَددت لَو أَن بَعض مَعارف","شَيدت فَقامَ بِها عَلى أَشرئبابه",43,"ب",2,0],["لكِنَّ وصفَ العارِفِ القدسِيّ من","حسنت سريرتهُ وكانَ صَبورا",44,"ر",2,0],["لكِن وَأَنّى لي بِها حاجَة","لَو كُنت فيهِ بَعض قوّامِهِ",45,"م",2,0],["لكنَّ وا أسفاه لم تبقَ على","ذاك الهنا والعزّ والارخاء",46,"ا",2,0],["لَكن وَلاءً عَلى الرَحمن مُحتَسباً","في طاعَة اللَه لَم يُمذَق وَلَم يُشَبِ",47,"ب",1,0],["لكن ولائي للحسين ورهطه","كالصبح أودى بالظلام الكالح",48,"ح",1,0],["لكن وَشَى الواشونَ ما بينَنا","فغيَّرُوا ألوانَ أَلْوانا",49,"ن",2,0],["لكنّ ودي انادي امي بْكلمتين","واطلب من الله يرقّق قلبها واحضنه",50,"ن",2,0],["لكنَّ وجهيَ عن جوًى","يكوي الحُشاشةَ عبَّرا",51,"ر",2,0],["لكنَّ وغداًأثيمَ الفعل غرَّبني","عن النَّدامى وعجزي سوَّدَ القزَما",52,"م",2,0],["لكن وقتهم ولا ولا ضنتي بيعود","وبيت بنوه بظلم ما دامت اركانه",53,"ن",2,0],["لكن وجهك ايتن كونيه","تنبي بعظم الخالق العلامي",54,"م",2,0],["لكن وحاشاك لم تبد الصواب بما","أبديت من درر باهت لا لينا",55,"ن",2,0],["لكِنْ وَجَدْتُ الصَّبْرَ بَعْدَكَ بِالهُدَى","وَهُدَى النُّفُوسِ يَضُمُّهُ التَّنْزِيلُ",56,"ل",1,0],["لكنّ وسواساً ين","وش ، فعمّهم ليل الشّرود",57,"د",1,0],["لكن ويا أسفي تلاشتْ فرحتي","لمّا أفقتُ وما لقيتُ أمامي",58,"م",2,0],["لكن وربي ما نحبك تسوقين","والشعب لو سقتي / بيصدر قراره",59,"ر",2,0],["لكن َّوعيَ افتقادِ الوعيِ في وطني","أعْيَتْ حقيقتُه الإدراكَ إثباتا",60,"ت",2,0],["لكنّ وقْرا من الآلام يطحنني","آلامِ عا