{"poems":[[53,"أثرها على ما بها من لغب","https://www.aldiwan.net/poem30743.html","المتقارب"],[89,"نأى بي عن الأصحاب في سيره العمر","https://www.aldiwan.net/poem44923.html","الطويل"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[132,"تخطى ركبه الظلل القواء","https://www.aldiwan.net/poem54900.html","الوافر"],[280,"إذا لم يكن من حادث الدهر موئل","https://www.aldiwan.net/poem60784.html","الطويل"],[298,"أضر بغادة هيفاء رود","https://www.aldiwan.net/poem36293.html","عموديه"],[328,"حبيبي جاني وهناني","https://www.aldiwan.net/poem54908.html","عموديه"],[349,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[551,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[587,"ألا يا راكباً قف لي فواقا","https://www.aldiwan.net/poem11557.html","عموديه"]],"verses":[["وَلَمّا يَعافوا عَلى عِزِّهِم","تَوَسُّدَ أَعضادُها وَالرُكَب",0,"ب",1,0],["ولما يزل نسر المجرة طائراً","اما في فضاء اللا تناهي له وكر",1,"ر",1,0],["ولِما يَعْذُلُ عن ليماء طَوْ","عَ هوىً في العذل أعصى من عُصي",2,"ي",1,0],["ولمَّا يَزَلْ مَثَلٌ سائرٌ","على الناسِ يَجري : بأيدي سبا",3,"ا",1,0],["وَلَمَّا يَعجَبُوا بِصَلاتِهممَا","يَرَونَ صَلاَتَهُم إلاَّ مُكَاءَ",4,"ا",2,0],["وَلَمَّا يَقُمْ مِنْ دُونِ ثَأْرِكَ مَعْشَرٌ","إِذَا عَزَمُوا فِي النَّائِبَاتِ تَوَكَّلُوا",5,"ل",3,0],["وَلمّا يبق مما استقرضته","سوى مائةٍ من المال الجديد",6,"د",1,0],["ولما يسمع ألحاني","يعطف عليّ ويهواني",7,"ي",1,0],["وَلِما يَنَل عِنَ الوِصالِ وِصالَها","مُيَمِّمُها إِلّا بِعَقرِ المَطِيَّةِ",8,"ه",1,0],["ولمّا يُغنِ أنصارٌ","من الموتِ وأعوانُ",9,"ن",1,0],["ولما يأتنا منكم جواب","به ترك الجواب يكون ذاما",10,"م",2,0]]}