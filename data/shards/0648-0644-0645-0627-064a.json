{"poems":[[55,"أثرها على ما بها من لغب","https://www.aldiwan.net/poem30743.html","المتقارب"],[91,"نأى بي عن الأصحاب في سيره العمر","https://www.aldiwan.net/poem44923.html","الطويل"],[70,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62224","الوافر"],[92,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[136,"تخطى ركبه الظلل القواء","https://www.aldiwan.net/poem54900.html","الوافر"],[285,"إذا لم يكن من حادث الدهر موئل","https://www.aldiwan.net/poem60784.html","الطويل"],[303,"أضر بغادة هيفاء رود","https://www.aldiwan.net/poem36293.html","عموديه"],[333,"حبيبي جاني وهناني","https://www.aldiwan.net/poem54908.html","عموديه"],[354,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[556,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[592,"ألا يا راكباً قف لي فواقا","https://www.aldiwan.net/poem11557.html","عموديه"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63723","الهزج"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70850","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16760","الطويل"],[1108,"","https://poetry.dctabudhabi.ae/diwan/poem/146567","الطويل"],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/126594","الطويل"],[1389,"","https://poetry.dctabudhabi.ae/diwan/poem/102239","الطويل"],[1610,"","https://poetry.dctabudhabi.ae/diwan/poem/115021","الطويل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128091","الكامل"],[1854,"","https://poetry.dctabudhabi.ae/diwan/poem/135064","الطويل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48202","الطويل"],[2241,"","https://poetry.dctabudhabi.ae/diwan/poem/10451","الوافر"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60964","الكامل"],[2527,"","https://poetry.dctabudhabi.ae/diwan/poem/17710","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91220","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216812","الكامل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136899",""],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93762","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66114","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58122","المتقارب"],[4669,"","https://poetry.dctabudhabi.ae/diwan/poem/32987","الطويل"],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4984,"التكامل","https://www.poetsgate.com/ViewPoem.aspx?id=175601",""],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[5136,"ما هز عطفي ملة الحنفاء","https://www.poetsgate.com/ViewPoem.aspx?id=121489",""],[5206,"حَيَاةُ المُهَج","https://www.poetsgate.com/ViewPoem.aspx?id=187392",""],[5246,"إذا افتخر العصر الذي قد صحبتُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=187044",""],[5691,"ربيع عشتار","https://www.poetsgate.com/ViewPoem.aspx?id=206247",""],[5704,"لهيبُ الروح","https://www.poetsgate.com/ViewPoem.aspx?id=192688",""],[5749,"اه يا دمعتي","https://www.poetsgate.com/ViewPoem.aspx?id=157287",""],[6144,"جهل فقر مرض","https://www.poetsgate.com/ViewPoem.aspx?id=152334",""],[6144,"رأس المال","https://www.poetsgate.com/ViewPoem.aspx?id=21830",""]],"verses":[["وَلَمّا يَعافوا عَلى عِزِّهِم","تَوَسُّدَ أَعضادُها وَالرُكَب",0,"ب",1,0],["ولما يزل نسر المجرة طائراً","اما في فضاء اللا تناهي له وكر",1,"ر",1,0],["ولِما يَعْذُلُ عن ليماء طَوْ","عَ هوىً في العذل أعصى من عُصي",2,"ي",1,0],["وَلَمَّا يَنْذَرا بِضُبُوءِ طِمْلٍ","أَخِي قَنَصٍ بِرزِّهِمَا سَمِيعِ",3,"ع",1,0],["ولمَّا يَزَلْ مَثَلٌ سائرٌ","على الناسِ يَجري : بأيدي سبا",4,"ا",1,0],["وَلَمَّا يَعجَبُوا بِصَلاتِهممَا","يَرَونَ صَلاَتَهُم إلاَّ مُكَاءَ",5,"ا",2,0],["وَلَمَّا يَقُمْ مِنْ دُونِ ثَأْرِكَ مَعْشَرٌ","إِذَا عَزَمُوا فِي النَّائِبَاتِ تَوَكَّلُوا",6,"ل",3,0],["وَلمّا يبق مما استقرضته","سوى مائةٍ من المال الجديد",7,"د",1,0],["ولما يسمع ألحاني","يعطف عليّ ويهواني",8,"ي",1,0],["وَلِما يَنَل عِنَ الوِصالِ وِصالَها","مُيَمِّمُها إِلّا بِعَقرِ المَطِيَّةِ",9,"ه",1,0],["ولمّا يُغنِ أنصارٌ","من الموتِ وأعوانُ",10,"ن",1,0],["ولما يأتنا منكم جواب","به ترك الجواب يكون ذاما",11,"م",2,0],["ولمَّا يألُ لي براً","على برٍ على برِّ",12,"ر",1,0],["ولمَّا يجدْ لي موضعاً من شحاشتي","وقلبيَ إلا حلَّ منهن موضعا",13,"ع",2,0],["وَلَمّا يُفَرِّرهُ تَقَلُّبَ دَهرِهِ","فَقُلتَ لَعَلَّ الدَهرَ لَم يَتَقَلَّبِ",14,"ب",1,0],["ولما ير المسكين رأيك إنه","سيخطفه والليل مرخى ذوائبه",15,"ب",2,0],["ولما يزدهم والسياط تنوشه","فشلت يمين الضارب المتبتل",16,"ل",1,0],["ولما يئسنا منه تهنا ضرورةً","فلم يبقَ لي فيها عليه تشوُّف",17,"ف",1,0],["ولما يكُن للمشرفّية فَوقكم","شُعاعٌ كقرَن الشمس حين تَرَجّلُ",18,"ل",1,0],["ولما يجنِ جانيكم علينا","فنقصد غيرنا في المُعربينا",19,"ن",2,0],["ولمائها الصافى اذا لعبت به","شمس الاصيل مع الضيا لألاء",20,"ا",2,0],["ولما يكن يومٌ تزول نجومه","تطير به الركبان ذو نبأٍ ضخم",21,"م",1,0],["ولماَّ يزل سيفٌ له سيفَ دولة","له راية الإحسانِ والجودِ عاقدُ",22,"د",1,0],["وَلَمّا يُبقِ مِن سَرَواتِ فِهرٍ","وَخِندِفَ هَذِهِ إِلّا شَريدا",23,"د",2,0],["ولما يَرى بَرَداً بثغرك نابتاً","وعليه أكبادُ الرجال تذوب",24,"ب",1,0],["وَلَمّا يَزَل عَن رَأسِ صَهوَةِ عِصمِها","وَلمّا يَدَع وِردَ العِراقِ مَناهِلُه",25,"ل",2,0],["وَلم أَيأس مِن العَليا ليأسٍ","فَإِنّ الغَيث مِن بَعد الرُعود",26,"د",1,0],["ولما يصيب الجاهدين يعوزنا","جهد الأباة وهمة الشجعان",27,"ن",1,0],["ولما يفعت وشق الصبا","كمامي كما انشق كم الزهر",28,"ر",1,0],["وَلما يَرق لي في رُبى الزَهر آية","مِن الأُنس إِلا نَظرة المنبسم",29,"م",1,0],["ولَما يَزَلْ يَسْرِي بنا في ضَلالِهِ","فَطِيرٌ من الآراءِ غَيْرُ مُهَذَّبِ",30,"ب",1,0],["ولما يزالُونَ في غيِّهم","يموجون في فِعْلِهِمْ والمقالْ",31,"ل",1,0],["وَلِما يُفَرِّق جَمعَهُم كُلُّ ماجِدٍ","إِذا قُلتُ قَد وَلّى وَأَدبَرَ أَقبَلا",32,"ل",2,0],["ولما يشاهد إن يشاهد شهوده","إذا لم يغب عنه بمشهوده الداني",33,"ن",2,0],["ولما يزل في الحصن من هو عابد","يرابط في ذكر به الله رافعه",34,"ع",2,0],["ولما يزل يحمي ذمار طريقه","يهزز أرماحا يسدد أسهما",35,"م",2,0],["ولما يداخلها ترى خيلاءها","فغدت تميل بنشوة الخيلاء",36,"ا",2,0],["وَلَمَّا يَزَل في صَمْدِهِ قَاصِدًا لَهُ","بِمِرصَادِهِ حَتَّى يُنيخَ بِهِ الرَّكْبَا",37,"ب",2,0],["وَلَمَّا يَزَلْ يَرْقَى بِمَرْقَى التُّقَى بِهَا","يَرُومُ الرِّضَى خَوفَ الشَّقَا إنْ قَضَى نَحبَا",37,"ب",2,0],["ولما يزل يا مصرُ حقُك باقياً","سأذكرُه في الناسِ ما بقي دهر",38,"ر",1,0],["ولمّا يزَلْ تمّوزُ يتْبَعُ موْكِبي","ليَسْمَعَ عنْ عِشْتارَ أيَّةَ أخْبارِ !",39,"ر",1,0],["ولم أيأس من الأحباب عَوْدًا","أسلِّي النفس مني بالتمني",40,"ن",2,0],["ولما يجي الليل كل العيون تنام وتحلم","وانت يا عين رموشك شوك يدمي",41,"ي",1,0],["ولما ينصاب برا","جعه أو بتيفوئيد",42,"د",1,0],["ولما يقولوا دي مظاهره","بريئة من بنات طاهرة",43,"ه",1,0]]}