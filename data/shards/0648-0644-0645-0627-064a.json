{"poems":[[55,"أثرها على ما بها من لغب","https://www.aldiwan.net/poem30743.html","المتقارب"],[91,"نأى بي عن الأصحاب في سيره العمر","https://www.aldiwan.net/poem44923.html","الطويل"],[70,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62224","الوافر"],[92,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[136,"تخطى ركبه الظلل القواء","https://www.aldiwan.net/poem54900.html","الوافر"],[284,"إذا لم يكن من حادث الدهر موئل","https://www.aldiwan.net/poem60784.html","الطويل"],[302,"أضر بغادة هيفاء رود","https://www.aldiwan.net/poem36293.html","عموديه"],[332,"حبيبي جاني وهناني","https://www.aldiwan.net/poem54908.html","عموديه"],[353,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[554,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[590,"ألا يا راكباً قف لي فواقا","https://www.aldiwan.net/poem11557.html","عموديه"],[779,"","https://poetry.dctabudhabi.ae/diwan/poem/135064","الطويل"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/10451","الوافر"],[874,"","https://poetry.dctabudhabi.ae/diwan/poem/17710","الطويل"]],"verses":[["وَلَمّا يَعافوا عَلى عِزِّهِم","تَوَسُّدَ أَعضادُها وَالرُكَب",0,"ب",1,0],["ولما يزل نسر المجرة طائراً","اما في فضاء اللا تناهي له وكر",1,"ر",1,0],["ولِما يَعْذُلُ عن ليماء طَوْ","عَ هوىً في العذل أعصى من عُصي",2,"ي",1,0],["وَلَمَّا يَنْذَرا بِضُبُوءِ طِمْلٍ","أَخِي قَنَصٍ بِرزِّهِمَا سَمِيعِ",3,"ع",1,0],["ولمَّا يَزَلْ مَثَلٌ سائرٌ","على الناسِ يَجري : بأيدي سبا",4,"ا",1,0],["وَلَمَّا يَعجَبُوا بِصَلاتِهممَا","يَرَونَ صَلاَتَهُم إلاَّ مُكَاءَ",5,"ا",2,0],["وَلَمَّا يَقُمْ مِنْ دُونِ ثَأْرِكَ مَعْشَرٌ","إِذَا عَزَمُوا فِي النَّائِبَاتِ تَوَكَّلُوا",6,"ل",3,0],["وَلمّا يبق مما استقرضته","سوى مائةٍ من المال الجديد",7,"د",1,0],["ولما يسمع ألحاني","يعطف عليّ ويهواني",8,"ي",1,0],["وَلِما يَنَل عِنَ الوِصالِ وِصالَها","مُيَمِّمُها إِلّا بِعَقرِ المَطِيَّةِ",9,"ه",1,0],["ولمّا يُغنِ أنصارٌ","من الموتِ وأعوانُ",10,"ن",1,0],["ولما يأتنا منكم جواب","به ترك الجواب يكون ذاما",11,"م",2,0],["ولما يكن يومٌ تزول نجومه","تطير به الركبان ذو نبأٍ ضخم",12,"م",1,0],["وَلَمّا يُبقِ مِن سَرَواتِ فِهرٍ","وَخِندِفَ هَذِهِ إِلّا شَريدا",13,"د",2,0],["وَلَمّا يَزَل عَن رَأسِ صَهوَةِ عِصمِها","وَلمّا يَدَع وِردَ العِراقِ مَناهِلُه",14,"ل",2,0]]}