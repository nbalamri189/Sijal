{"poems":[[93,"يا لعهد الصبا تقضي وشيكا","https://www.aldiwan.net/poem9159.html","الخفيف"],[37,"إذا اللقاح غدت ملقى أصرتها","https://www.aldiwan.net/poem6501.html","البسيط"],[51,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[91,"وربت أمريكية خلت ودها","https://www.aldiwan.net/poem8794.html","عموديه"],[44,"أعتيب يا ابن الفعلة اللخناء","https://www.aldiwan.net/poem30074.html","الكامل"],[15,"لمن الدار أقفرت بالجناب","https://www.aldiwan.net/poem45282.html","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54871","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[259,"محلك من متن السماكين ارفع","https://www.aldiwan.net/poem38242.html","البسيط"],[259,"ذراني إذا ما فؤادي صبا","https://www.aldiwan.net/poem38370.html","المتقارب"],[278,"يا نسيم الصبا الولوع بوجدي","https://www.aldiwan.net/poem60760.html","الخفيف"],[320,"ذرفت عيني دموعا","https://www.aldiwan.net/poem56351.html","مجزوء الرمل"],[379,"منع النوم ماوي التهمام","https://www.aldiwan.net/poem433.html",""],[400,"تحفة تهدى لمن يهوى عليا","https://www.aldiwan.net/poem33355.html","الرمل"],[456,"إذا لم يقرب منك إلا التذلل","https://www.aldiwan.net/poem56075.html","الوافر"]],"verses":[["وكهذا الخصب العجيب الذي كا","ن وما زال مضرب الأمثال",0,"ل",1,0],["وكهذا الشعب الأمين الذي أو","تي أحلى شمائلٍ وخصال",0,"ل",1,0],["وكهذا شعبٌ حر السجايا سخى","وأبى عن عزة لا اختيال",0,"ل",1,0],["وكهكه المدلج المقرور في يده","واستدفأ الكلب في المأسور ذي الذِّئبِ",1,"ب",1,0],["وكهولُ الحَوذانِ فيه مع السَّعْ","دان غُلباً كأنهن الصُّقُوبُ",2,"ب",1,0],["وَكَهرَبَ روحَينا فَلَمّا تَنَهَّدَت","تَنَهَّدتُ حَتّى كادَ صَدري يَنهَدُّ",3,"د",1,0],["وَكُهولُ كَهلانَ وَحَيّا حِميَرٍ","كَالسَيلِ قُدّامي مَعاً وَوَرائي",4,"ي",1,0],["وَكُهولٍ ذَوي نَدىً وَحُلومٍ","وَشَبابٍ أَنجادِ غُلبِ الرِقابِ",5,"ب",1,0],["وَكَهَذِي الأَرْضِ الصَّغِيرَةِ كَمْ أَرْ","ضٍ عَلى نَفْسِهَا لِحِينٍ تَدُورُ",6,"ر",1,0],["وَكَهْرَبَاءَ الغَيْمِ إِنْ تَصْطَدِمُ","بِذَاتِ بَرْقٍ مِثْلِهَا تَجْأَرِ",7,"ر",1,0],["وكهف اللها المزبى على كل ربوة","إليه تفر المعتفون وتفزع",8,"ع",1,0],["وكهمت عضب يد النائبات","فما قطع الدهر حتى نبا",9,"ب",2,0],["وَكُهُولٍ قَشاعِمٍ تَتلاقَى","فِي ذُرى الْمَجْدِ أَوْ غَطَارِفَ مُرْدِ",10,"د",1,0],["وَكَهولٍ قَد أَراهُم","كَخَضاريمِ البُحورِ",11,"ر",1,0],["وَكُهولٌ بَنى لَهُم أَوَّلوهُم","مَأَثُراتٍ يَهابُها الأَقوامُ",12,"م",1,0],["وكهارون غدا في شأنه","منه إلا أنه ليس نبيا",13,"ي",2,0],["وكهلُكُمُ في فتكه وانبساطه","فتىً وفتاكم في الحجا متكهِّلُ",14,"ل",1,0]]}