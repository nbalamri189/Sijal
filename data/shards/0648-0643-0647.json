{"poems":[[95,"يا لعهد الصبا تقضي وشيكا","https://www.aldiwan.net/poem9159.html","الخفيف"],[39,"إذا اللقاح غدت ملقى أصرتها","https://www.aldiwan.net/poem6501.html","البسيط"],[53,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[93,"وربت أمريكية خلت ودها","https://www.aldiwan.net/poem8794.html","عموديه"],[46,"أعتيب يا ابن الفعلة اللخناء","https://www.aldiwan.net/poem30074.html","الكامل"],[15,"لمن الدار أقفرت بالجناب","https://www.aldiwan.net/poem45282.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54871","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[96,"أين أين الرعيل من أهل بدر","https://www.poetsgate.com/ViewPoem.aspx?id=13787",""],[266,"محلك من متن السماكين ارفع","https://www.aldiwan.net/poem38242.html","البسيط"],[266,"ذراني إذا ما فؤادي صبا","https://www.aldiwan.net/poem38370.html","المتقارب"],[285,"يا نسيم الصبا الولوع بوجدي","https://www.aldiwan.net/poem60760.html","الخفيف"],[327,"ذرفت عيني دموعا","https://www.aldiwan.net/poem56351.html","مجزوء الرمل"],[387,"منع النوم ماوي التهمام","https://www.aldiwan.net/poem433.html",""],[409,"تحفة تهدى لمن يهوى عليا","https://www.aldiwan.net/poem33355.html","الرمل"],[463,"إذا لم يقرب منك إلا التذلل","https://www.aldiwan.net/poem56075.html","الوافر"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101489","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62542","الطويل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105461","الوافر"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216944","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59113","البسيط"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72257","الرمل"],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138064",""],[1947,"","https://poetry.dctabudhabi.ae/diwan/poem/178107","الخفيف"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100472","الوافر"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108471","الكامل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102155","الوافر"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110625","الطويل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132308","الطويل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100161","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110002","الوافر"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59489","الطويل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199068","الطويل"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105516","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72430","الطويل"],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101932","الرجز"],[5032,"كتاب البكاء","https://www.poetsgate.com/ViewPoem.aspx?id=189764",""],[5213,"هوى قمر الامامة للافول","https://www.poetsgate.com/ViewPoem.aspx?id=170520",""],[2365,"أشاقك طائر غرد","https://www.poetsgate.com/ViewPoem.aspx?id=200645",""],[2365,"نائح في الغصون بالليل ناحا","https://www.poetsgate.com/ViewPoem.aspx?id=200663",""],[5323,"من النافذة","https://www.poetsgate.com/ViewPoem.aspx?id=207565",""],[5937,"الثُّقب الأسود","https://www.poetsgate.com/ViewPoem.aspx?id=214121",""],[6031,"خَليلَيَّ حَالَ البعدُ دونَ لقاكما","https://www.poetsgate.com/ViewPoem.aspx?id=46262",""],[6056,"العيون الإنتهازية","https://www.poetsgate.com/ViewPoem.aspx?id=130347",""]],"verses":[["وكهذا الخصب العجيب الذي كا","ن وما زال مضرب الأمثال",0,"ل",1,0],["وكهذا الشعب الأمين الذي أو","تي أحلى شمائلٍ وخصال",0,"ل",1,0],["وكهذا شعبٌ حر السجايا سخى","وأبى عن عزة لا اختيال",0,"ل",1,0],["وكهكه المدلج المقرور في يده","واستدفأ الكلب في المأسور ذي الذِّئبِ",1,"ب",1,0],["وكهولُ الحَوذانِ فيه مع السَّعْ","دان غُلباً كأنهن الصُّقُوبُ",2,"ب",1,0],["وَكَهرَبَ روحَينا فَلَمّا تَنَهَّدَت","تَنَهَّدتُ حَتّى كادَ صَدري يَنهَدُّ",3,"د",1,0],["وَكُهولُ كَهلانَ وَحَيّا حِميَرٍ","كَالسَيلِ قُدّامي مَعاً وَوَرائي",4,"ي",1,0],["وَكُهولٍ ذَوي نَدىً وَحُلومٍ","وَشَبابٍ أَنجادِ غُلبِ الرِقابِ",5,"ب",1,0],["وَكَهَذِي الأَرْضِ الصَّغِيرَةِ كَمْ أَرْ","ضٍ عَلى نَفْسِهَا لِحِينٍ تَدُورُ",6,"ر",1,0],["وَكَهْرَبَاءَ الغَيْمِ إِنْ تَصْطَدِمُ","بِذَاتِ بَرْقٍ مِثْلِهَا تَجْأَرِ",7,"ر",1,0],["وكهولا أبلت شبابهم الجلّى","فهم في الصبا الوسيم كهول",8,"ل",1,0],["وكهف اللها المزبى على كل ربوة","إليه تفر المعتفون وتفزع",9,"ع",1,0],["وكهمت عضب يد النائبات","فما قطع الدهر حتى نبا",10,"ب",2,0],["وَكُهُولٍ قَشاعِمٍ تَتلاقَى","فِي ذُرى الْمَجْدِ أَوْ غَطَارِفَ مُرْدِ",11,"د",1,0],["وَكَهولٍ قَد أَراهُم","كَخَضاريمِ البُحورِ",12,"ر",1,0],["وَكُهولٌ بَنى لَهُم أَوَّلوهُم","مَأَثُراتٍ يَهابُها الأَقوامُ",13,"م",1,0],["وكهارون غدا في شأنه","منه إلا أنه ليس نبيا",14,"ي",2,0],["وكهلُكُمُ في فتكه وانبساطه","فتىً وفتاكم في الحجا متكهِّلُ",15,"ل",1,0],["وكهذا حالُ مَن تسألهُ","مذ رأى عينيك يا أسمى البشَر",16,"ر",1,0],["وكهف لمن آواه منجىً وملجأ","وروض لمن يرعاه ناشٍ وناضرُ",17,"ر",1,0],["وكهفاً كم أجار له جواراً","إذا ما فادح الحدثان جارا",18,"ر",2,0],["وكُهُولٍ عنْدَ الحِفاظِ مرَاجِيْ","حَ يُبارون كُلّ ريحٍ عَريّهْ",19,"ي",2,0],["وَكَهْفُ ملكٍ حَمَى الإسْلاَمَ جانبُه","فِي الشَّرْقِ وَالغَرْبِ بِالهِنْدِيَّةِ الصّينِ",20,"ن",1,0],["وكهول من بني خير","البرايا وشباب",21,"ب",1,0],["وكهف عزٍّ لأيتام تطوف به","رماه صرف القضا بالهدم والعطب",22,"ب",1,0],["وكهولٌ أوهت كواهلها السم","ر تهادى إلى ابتغاء الدخول",23,"ل",1,0],["وكهف للورى ولنا إذا ما","تنمر حادث فله التجينا",24,"ن",2,0],["وكهولها كتبت مصيبتها التي","تبقى مخلدةً إلى أطفالها",25,"ل",3,0],["وكهارونَ وعيسى مثلاً","لا نبيّاً بل وصيّاً حُبِّبا",26,"ب",2,0],["وكهف منيع يستجار بظله","إذا جار صرف الدهر يوماً أو اعتدى",27,"د",2,0],["وكهفُكَ حِصنٌ يا بن بُشرى ابن مَريمٍ","وهو طهَ تاجُ الأنبيا والمراتِب",28,"ب",1,0],["وكهفي من الأيام إن ناب حادث","أبث له حزني وأشكو له أمري",29,"ي",1,0],["وكَهنُوتٌ وتزويجٌ حَلالٌ","كتحديد الكنيسةِ غيرَ خافِ",30,"ف",1,0],["وكهلان والعنقاء عَنقاءُ يعربٍ","وهودٌ نبيُّ الله أفضل فاضلِ",31,"ل",1,0],["وكهف ولكن للصديق عن العدا","وبحر ولكن من يلاقيه لا يعرى",32,"ر",2,0],["وكهفاً للأنام بكل معضل","إذا ظمأ القريض لورد مدح ال",33,"ل",1,0],["وكهف الورى النشورطي رواقه","على من أقلت في مناكبها الغبرا",34,"ر",2,0],["وكهفها السامي المقام والذي","فحسبنا به فخاراً وكفى",35,"ا",1,0],["وكَهْلٍ وَراءَ الصَّمْتِ يَشْوي خَيالَهُ","سُؤالاً وأفْكارَاً عَنِ الحَرْبِ حائرَة",36,"ر",2,0],["وكهمه رهيف الحد ماض","وما هو بالكهام ولا الكليل",37,"ل",1,0],["وكهف نستجير به","ومعتمد ومعتقد",38,"د",1,0],["وكهول مجدّة للأعادى","وشباب يلاعبون الرّماحا",39,"ح",2,0],["وكهلٌ في سبيل المال ساعٍ","يشرعنُ ما يحقق مبتغاهُ",40,"ا",2,0],["وكهدهدٍ وأنا بمعبدِ وحدتي","ألقت علي من الغرام كتابا",41,"ب",2,0],["وكَهْفَيْ حِمىً يغشَى الأنامُ ذُراكما","ويَعصِمُ من رِيبِ الزمانِ ذُرَاكُما",42,"م",2,0],["وكهرومغنطة حبي شعاع ٍ، مرّعبرالطيف","تجسّد ، موجة إرساله مشاعر إزدواجية",43,"ي",2,0]]}