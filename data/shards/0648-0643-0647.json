{"poems":[[93,"يا لعهد الصبا تقضي وشيكا","https://www.aldiwan.net/poem9159.html","الخفيف"],[37,"إذا اللقاح غدت ملقى أصرتها","https://www.aldiwan.net/poem6501.html","البسيط"],[51,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[91,"وربت أمريكية خلت ودها","https://www.aldiwan.net/poem8794.html","عموديه"],[44,"أعتيب يا ابن الفعلة اللخناء","https://www.aldiwan.net/poem30074.html","الكامل"],[15,"لمن الدار أقفرت بالجناب","https://www.aldiwan.net/poem45282.html","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54871","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"]],"verses":[["وكهذا الخصب العجيب الذي كا","ن وما زال مضرب الأمثال",0,"ل",1,0],["وكهذا الشعب الأمين الذي أو","تي أحلى شمائلٍ وخصال",0,"ل",1,0],["وكهذا شعبٌ حر السجايا سخى","وأبى عن عزة لا اختيال",0,"ل",1,0],["وكهكه المدلج المقرور في يده","واستدفأ الكلب في المأسور ذي الذِّئبِ",1,"ب",1,0],["وكهولُ الحَوذانِ فيه مع السَّعْ","دان غُلباً كأنهن الصُّقُوبُ",2,"ب",1,0],["وَكَهرَبَ روحَينا فَلَمّا تَنَهَّدَت","تَنَهَّدتُ حَتّى كادَ صَدري يَنهَدُّ",3,"د",1,0],["وَكُهولُ كَهلانَ وَحَيّا حِميَرٍ","كَالسَيلِ قُدّامي مَعاً وَوَرائي",4,"ي",1,0],["وَكُهولٍ ذَوي نَدىً وَحُلومٍ","وَشَبابٍ أَنجادِ غُلبِ الرِقابِ",5,"ب",1,0],["وَكَهَذِي الأَرْضِ الصَّغِيرَةِ كَمْ أَرْ","ضٍ عَلى نَفْسِهَا لِحِينٍ تَدُورُ",6,"ر",1,0],["وَكَهْرَبَاءَ الغَيْمِ إِنْ تَصْطَدِمُ","بِذَاتِ بَرْقٍ مِثْلِهَا تَجْأَرِ",7,"ر",1,0]]}