{"poems":[[79,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[79,"أمولاي دمت الدهر منصور أعلام","https://www.aldiwan.net/poem36104.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42600","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42720","الطويل"],[108,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[119,"وعزة الله ما شوقي إلى العلم","https://www.aldiwan.net/poem41774.html","البسيط"],[119,"يا رسول الرضى بفضلك دارك","https://www.aldiwan.net/poem42172.html","الخفيف"],[280,"ألا قل لذي الجهل كم تطمح","https://www.aldiwan.net/poem25406.html","المتقارب"],[309,"وصيتي لك يا ذا الفضل والأدب","https://www.aldiwan.net/poem16756.html","البسيط"],[310,"أعيذ صفاء الود من كدر العتب","https://www.aldiwan.net/poem56604.html","الطويل"],[411,"أقول وروعي للفراق مروع","https://www.aldiwan.net/poem49882.html","الطويل"],[438,"كم مقلة للشقيق الغض رمداء","https://www.aldiwan.net/poem12548.html","البسيط"],[505,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138207",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38195","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70965","الطويل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105469","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59423","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112871","الطويل"],[1873,"","https://poetry.dctabudhabi.ae/diwan/poem/73010","الوافر"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102157","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27910","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77300","الكامل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124758","الطويل"],[2786,"","https://poetry.dctabudhabi.ae/diwan/poem/132220","الطويل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140096",""],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86288","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92400","الطويل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44712","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125878","الطويل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97105","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94353","الطويل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81948","الطويل"],[4270,"","https://poetry.dctabudhabi.ae/diwan/poem/124283","الطويل"],[5087,"أيها اللائمي لحبي عليا","https://www.poetsgate.com/ViewPoem.aspx?id=96364",""],[5377,"إلى الغاضبين علينا","https://www.poetsgate.com/ViewPoem.aspx?id=61899",""],[5533,"جاءَ البَشير","https://www.poetsgate.com/ViewPoem.aspx?id=186841",""],[5596,"دار الغشّام","https://www.poetsgate.com/ViewPoem.aspx?id=206479",""],[523,"ما أصعب الكلام (رثاء ناجي العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""],[2220,"إذا ما ذكرتُ اللهَ بالذكرِ نفسهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11385&r=&rc=259",""]],"verses":[["وَكُنْ وَاثِقاً بِاللَّهِ مُسْتَنْصِراً بِهِ","فَسُلْطَانُهُ يُعْلُو عَلَى كُلِّ سُلْطَانِ",0,"ن",1,0],["وَكُنْ وَاثِقاً باللهِ فِي كُلِّ وِجْهَةٍ","يُتِمُّ عَلَيْكَ الْفَضْلَ أَحْسَنَ إِتْمَامِ",1,"م",1,0],["وَكُنْ وَسَطاً لا مُشْرَئبَّاً إِلى السُّهَا","وَلا قَانِعَاً يَبْغِي التَّزَلُّفَ بِالصُّغْرِ",2,"ر",1,0],["وَكُنْ وَاثِقَاً بِاللَّهِ فِي كُلِّ مِحْنَةٍ","فَلَلَّهُ أَوْلَى بِالْعِبَادِ وَأَرْفَقُ",3,"ق",1,0],["وكنوزٌ لم يُكشف الستر عنها","وأراضٍ عذراءُ غيرُ عوان",4,"ن",1,0],["وكن وسيلة أمري أنت واسطتي","للَه في نيل ما أرجوه من نعم",5,"م",1,0],["وكنوز الغيب المقدس في طي الت","تجلي القدسي في بطن غارك",6,"ك",1,0],["وكن واثقاً في اجتراح الذنو","بِ بأن مقدّرها يصفحُ",7,"ح",1,0],["وكن وقوراً خشوعاً غير منهمك","في اللهو والضحك والأفراح واللعب",8,"ب",1,0],["وَكُن وسطاً بينَ الشقاق وضدّه","فإنّ نفاقاً أَن توافق عن عقبِ",9,"ب",1,0],["وكُنْ واثِقاً باللهِ واصبِرْ لحُكمِهِ","فإنَّ زَوالَ الشَرِّ عنكَ سَريعُ",10,"ع",1,0],["وكُنْ وليّ وليِّ الدين تسطُ على","صَرفِ الزمانِ بماضي العزمِ والرّاء",11,"ا",2,0],["وكنْ وَقوراً رَبَّ خُلْقٍ رَيِّضٍ","ما خفَّ في مجلِسِهِ رَبُّ حِجَا",12,"ا",1,0],["وكنوزنا أعمالنا مكتوبة","مذخورة حتى أداء حساب",13,"ب",1,0],["وَكُن واثِقاً بِاللَّهِ وَاِصبِرْ لِحُكمِهِ","تَنالُ الّذي تَرجوهُ مِنهُ تَفضُّلا",14,"ل",2,0],["وكنْ واثقاً فالإعتصامُ بحبله","إذا ما حبالٌ قُطِّعتْ وسلوك",15,"ك",1,0],["وكنوز على في ضميرك أودعت","يزداد جوهرها لدى إنفاقها",16,"ق",3,0],["وكن ولي ولي العهد مالكنا","المسعود كهف اليتامى عمدة الشرفا",17,"ف",2,0],["وكن واثقا بالحق واطلب نواله","وكن في الدجى عبداً بادمعه اغتسل",18,"ل",1,0],["وَكُن وَرداً خُبَعثِنَةً","يُراوِغُ مِنهُمُ قَنَصا",19,"ص",2,0],["وكُن وسيلَتَنا في جَذبِ أنفُسِنا","حتّى يُتَوِّجَها عفوٌ وغُفرانُ",20,"ن",1,0],["وكن واحداً من كلِّ وجه تفزْ به","وتجهلك الأعداد واللثر حاضر",21,"ر",1,0],["وَكُنوزُهُ تيهُ الفُنونِ حَديثُها","راحُ النُفوسِ وَنُزهَةُ الأَلبابِ",22,"ب",1,0],["وكن واصل الأرحام حتى لكاشح","توفّر في عمر ورزق وتسعد",23,"د",1,1],["وكن واثقاً بالله في نيل رزقه","وخل سبيل الحرص إذ ليس ينفع",24,"ع",1,0],["وكنوز كسرى قال تفتح فيكموا","ويفيض مال الله أعظم فيضه",25,"ه",1,0],["وكن وقوراً لدى التقرير متقياً","لحظ نفسك من فعل ومن كلم",26,"م",1,0],["وَكُن واثِقاً يا صاح فيما لَقيتُه","بِرَبِّ كَريم خَير واقِ وَعاصِم",27,"م",1,0],["وكُن واثقاً بالعَهد معتمداً به","عليه فقد تجري الأُمور على قدر",28,"ر",1,0],["وَكُن واثِقاً إِنّ الشَدائدَ تَنجَلي","وَيَرجَعُ سوء الحالِ مِن أَحسن الحالِ",29,"ل",1,0],["وكنْ واثقاً أنَّ الرضى في وجوههم","شبيهٌ بما ضُمَّتْ عليه الأضالع",30,"ع",1,0],["وكنوز رشد لا يضل أليفها","يزداد ما فيهن بالإنفاق",31,"ق",1,0],["وكن واسعاً صدراً على البؤس والبلا","صبوراً ولا تشكو بعصر موارب",32,"ب",1,0],["وكن واثقاً باللّه يا صاح وحده","وبالقائم المهدي للناس بعده",33,"ه",1,0],["وكن واثقا باللّه فالأمر كله","لمن ملكه عم السموات والأرضا",34,"ض",2,0],["وكنوح نجى من الهلك من سي","ر في الفلك إذ علا الجوديا",35,"ي",2,0],["وكنوزٍ من الحرام يراها","مقتنوها هلكاً وحينا",36,"ن",2,0],["وكُنُوزُ كِسْرى أَصْبحَتْ لسُراقَةٍ","وَعْداً له .. بِرُّ الوُعُودِ وَفاؤُها",37,"ا",3,0],["وكنوزاً من المعارف تغري","كل طلابها بنور ابتسام",38,"م",1,0],["وكنوزَهم مسروقةٌ بالعدِل","واستقلالهم نوعُ من الإخصاءِ",39,"ا",2,0],["وكنْ واحداً منْ كلِّ وجهٍ تفزْ بهِ","وتجلهكَ الأعدادُ واللثرُ حاضرِ",40,"ر",1,0]]}