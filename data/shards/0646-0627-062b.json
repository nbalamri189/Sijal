{"poems":[[45,"قد صدق الورد في الذي زعما","https://www.aldiwan.net/poem10576.html","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[113,"كبد من سنان لحظك جرحى","https://www.aldiwan.net/poem16239.html","الخفيف"],[228,"إيه برناس هيكل الشعراء","https://www.aldiwan.net/poem41899.html","الخفيف"],[369,"وعدت باستراقة للقاء","https://www.aldiwan.net/poem61018.html","الخفيف"],[470,"وحدك الصوت","https://www.aldiwan.net/poem36434.html","عموديه"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63916","الخفيف"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81727","الرمل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72520","الرمل"],[6256,"تحية أدباء المغرب العربي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65918&r=&rc=6",""],[6256,"كلمات إليها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65934&r=&rc=22",""],[5190,"ها أنا يا نبض قلبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78297&r=&rc=10",""]],"verses":[["ناثِرُهُ ناثِرُ السُيوفِ دَماً","وَكُلَّ قَولٍ يَقولُهُ حِكَما",0,"م",2,0],["نَاثِرٌ تَنْفُثُ البَرَاعَةُ مِنْهُ","نَشْوَةَ الخَمْرِ فِي مُجَاجِ شِهَادِ",1,"د",1,0],["ناثى الفَضل والمَكارم يَقظا","ن عَليم يَطوي عَلى الودّ كَشحا",2,"ح",2,0],["ناثِرٌ دَمعَة العزاءِ عَلى الأَر","ضِ لتَشفي تَعاسَةَ الضُعَفاءِ",3,"ا",2,0],["ناثرٌ ما يزالُ في الطِّرس دُرّاً","حَسدَتْ حُسنَها نجومُ السّماء",4,"ا",2,0],["ناثراتِ الشُّعورِ حتى لَيَغدو","فوقَها التَّمرُ حَنظَلاً لا يُذاقُ !",5,"ق",1,0],["ناثراً في البقول ما أبرزته","يدُهُ من خُلالةِ الأضراس",6,"س",1,0],["ناثرٌ نظمَ الأعادي","ناظمٌ شملَ المحاسن",7,"ن",1,0],["ناثرا في الطرس أنواع الدرر","عالم از لفظ خوشابش بر شرر",8,"ر",1,0],["ناثرًا من شعوره أرج الحب","وفوق الدروب يلقي الورودا",9,"د",2,0],["ناثراً شعري مع الأنسام كالغيث شهيّا","وتوالتْ سنواتُ العمر يا حلوَ المحيّا",10,"ي",2,0],["ناثراً عطرَ اشتياقي","لحبيبٍ ما نساني",11,"ن",2,0]]}