{"poems":[[74,"لاعب شطرنج بفصل الشتا","https://www.aldiwan.net/poem18403.html","السريع"],[74,"يا عذولي خلني أغنم عمري","https://www.aldiwan.net/poem18701.html","الرمل"],[580,"وجنة فوقها عذار أطلا","https://www.aldiwan.net/poem3027.html","الخفيف"],[580,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108837","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90829","الكامل"],[5206,"حياة الأرواح","https://www.poetsgate.com/ViewPoem.aspx?id=187335",""]],"verses":[["دع غزلاً وامدحْ وزير التقى","في فضله الأوفى وفي نعته",0,"ت",2,0],["دَع غواني مجلسي تصدح لي","فغداً تبكي البواكي حولَ قبري",1,"ر",2,0],["دع غماماً هَمَى ودُرّاً تلالا","وهِزَبْراً عَدا وبَدْراً تَجَلَّى",2,"ل",2,0],["دعْ غَماماً هَمَى وبَدْراً تَجَلَّى","وشهاباً أَوْرَى ورَوْضاً تَنَوَّر",3,"ر",1,0],["دع غيره واقصد حدائق فضله","تجد الحدائق نوِّرت بمكارم",4,"م",1,0],["دع غيره بين البرية يدعي","بالمكرمات فإنها دعوى سدا",5,"د",2,0],["دَعْ غَيرَهُ فَالغَيْرُ عَفْسٌ ضَيِّقٌ","وَالجَهْلُ فِيهِ لَدَى الجَهَالَةِ حَابِسُ",6,"س",1,0]]}