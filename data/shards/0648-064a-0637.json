,"https://www.aldiwan.net/poem56171.html","السريع"],[459,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[459,"تهوى وأنت محلأ مصدود","https://www.aldiwan.net/poem56216.html","الكامل"],[462,"تعاظم حزني والرزية أعظم","https://www.aldiwan.net/poem15905.html","الطويل"],[462,"منازلكم للخائفين عصام","https://www.aldiwan.net/poem16033.html","الطويل"],[462,"الخطب أكبر في النفوس وأعظم","https://www.aldiwan.net/poem16060.html","الكامل"],[462,"ليهن الرعايا والمناقب والعلى","https://www.aldiwan.net/poem16354.html","الطويل"],[465,"تلقاك يا سعد بالنجح سعد","https://www.aldiwan.net/poem3152.html","عموديه"],[465,"أماط لثاماً فاجتلِ القمر الأدنى","https://www.aldiwan.net/poem3203.html","عموديه"],[465,"أقام الوجد بعدهم وساروا","https://www.aldiwan.net/poem3209.html","عموديه"],[465,"سرى وأقبل يقفو إثره القمر","https://www.aldiwan.net/poem3626.html","عموديه"],[478,"أبرق على المنحنى لائحام","https://www.aldiwan.net/poem15220.html","المتقارب"],[501,"أين يا حادي النياق الخيام","https://www.aldiwan.net/poem37627.html","الخفيف"],[501,"الخب ميال مع الشبهات","https://www.aldiwan.net/poem37714.html","الكامل"],[501,"إطمس مشاهدك التي","https://www.aldiwan.net/poem37971.html","مجزوء الكامل"],[515,"تصاحى وهو مخمور الجنان","https://www.aldiwan.net/poem20821.html","الوافر"],[516,"داويت ما نفع العليل دوائي","https://www.aldiwan.net/poem12002.html","الكامل"],[530,"يجاهرني العدو بكل نكر","https://www.aldiwan.net/poem37467.html","الوافر"],[530,"على عصر الشبيبة كل حين","https://www.aldiwan.net/poem37469.html","الوافر"],[530,"مسامع من ناديت يا عمرو سدت","https://www.aldiwan.net/poem37501.html","الطويل"],[539,"عبد السلام ببلدة الحمراء","https://www.aldiwan.net/poem48306.html","عموديه"],[552,"خذ صاحبي عني الذي أملي","https://www.aldiwan.net/poem47284.html","أحذ الكامل"],[552,"أأغفل والدهر لا يغفل","https://www.aldiwan.net/poem47339.html","المتقارب"],[552,"أيا ملك الأملاك قد جاءني الذي","https://www.aldiwan.net/poem47842.html","الطويل"],[552,"أتنسين يا لمياء شملك جامعا","https://www.aldiwan.net/poem48098.html","الطويل"],[559,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[559,"قلبي الذي في ذاتكم يتقلب","https://www.aldiwan.net/poem34938.html","الكامل"],[568,"حلل الشبيبة مستعاره","https://www.aldiwan.net/poem69664.html","مجزوء الكامل"],[576,"سعودك ردت ما ادعاه المنجم","https://www.aldiwan.net/poem3015.html","الطويل"],[576,"على خاطري يا شغله منك أشغال","https://www.aldiwan.net/poem3029.html","الطويل"],[576,"ألا فانتبه من أفقها طلع الفجر","https://www.aldiwan.net/poem3064.html","الطويل"],[576,"مالي هجرت بغير ذنب","https://www.aldiwan.net/poem3104.html","مجزوء الكامل"]],"verses":[["ويَطْوينَ والرّوْضُ في حُلّةٍ","يجُرُّ رَفارِفَها الأزْيَبُ",0,"ب",1,0],["ويُطْرِبُها الحادي بمَدْحِكَ مَوْهِناً","فتَخْدي وقد مَسَّ المَراخِي لُغوبُها",1,"ب",3,0],["ويَطْوونَ الضُّلوعَ على طَواها","ويأْكُلُ جارُهُمْ أُنُفَ الجِفانِ",2,"ن",1,0],["ويَطْوي الضُّلوعَ على غُلَّةٍ","إذا درَّعَتْهُ الهَوانَ المِياهْ",3,"ا",2,0],["ويُطبِقُ جَفْنَيهِ إذا اعْتَرَضَ السَّنا","مَخافَةَ أنْ يُمْنَى بِنارِ الحُباحِبِ",4,"ب",1,0],["ويَطوي على البَغْضاءِ جَنْبَيْهِ كاشِحٌ","تخطّى بهِ رَهْواً إِلى الحَسَدِ الغَبْطُ",5,"ط",1,0],["وَيُطرِبُني وَالخَيلُ تَعثُرُ بِالقَن","حُداةُ المَنايا وَاِرتِعاجُ المَواكِبِ",6,"ب",1,0],["ويَطْوي بُرودَ الُلْكِ فوقَ خلائِقٍ","تُناسبُ خُلْقَ النّاسِكِ المتزهِّدِ",7,"د",1,0],["وَيَطْلُبُ فِي جَيْبِ الْجَنُوبِ جَوَابَهَا","إِذَا مَا أَطَلَّتْ وَالصَّبَاحُ جَنِيبُ",8,"ب",1,0],["وَيُطرِبُهِ في يَومِ ذِكراكَ أَن مَشَت","إِلَيكَ مُلوكُ القَولِ عُربٌ وَأَعجَمُ",9,"م",1,0],["وَيَطُلْ عَهْدُهُ","مَا يَطُولُ المَدَى",10,"د",2,0],["ويطير في جوّ السرور مرفوفاً","بالمشتكين كآبةً ومسلالا",11,"ل",2,0],["وَيَطلُبُ كَعباً حَيثُ لا الإِثرُ يُقتَفى","لِتَعلَمَ كَعبٌ أَيَّ عودٍ تُكاسِرُ",12,"ر",1,0],["ويطرحون على الأبوابِ من حمقٍ","قصائِداً هي في التحقيق بابات",13,"ت",1,0],["ويطرب المدحُ فيه حينَ أكتبه","كأن منتصب الأقلامِ نايات",13,"ت",1,0],["ويطيع قلبي حكم لحظك في الهوى","يا للكليم غدا يطيع السَّاحرا",14,"ر",2,0],["ويطيب أفواه العواذل ذكره","حتَّى أهمّ بلثم ثغر العاذل",15,"ل",1,0],["ويطعن الطعنة النجلاء يتبعها","شخبٌ دَرير إذا لاقَى الحصى ضَرحا",16,"ح",2,0],["ويطول بين السائلين بَقاؤه","وكأن خاتم جوده مِفْتاحُهُ",17,"ح",2,0],["ويُطْرِقُ إطْراقَ الذَّليل وإنه","هُنَاكَ لَسَامِي نَاظِرِ العيْنِ أصْيَدُ",18,"د",1,0],["وَيَطلُبُ مِن نَباتِ الأَرضِ قوتاً","وَتَأبى غَيرَ لَحمِ الطَيرِ زادا",19,"د",2,0],["ويطول الفراق والحزن حتى","يصبح الموت وحده كل مأرب",20,"ب",1,0],["ويطرق سمعي اسم السعيد ولا ارى","بعيني سعيداً فهو عنقاء مغرب",21,"ب",1,0],["وَيَطلِبُ عِندَ الناسِ ما عِندَ نَفسِهِ","وَذَلِكَ مالا تَدَّعيهِ الضَراغِمُ",22,"م",1,0],["وَيَطعَنُ الخَيلَ كُلَّ نافِذَةٍ","لَيسَ لَها مِن وَحائِها أَلَمُ",23,"م",1,0],["ويطوي صبرَهُ ريحٌ شَمالٌ","وينشُرُ وجدَهْ راحٌ شَمولُ",24,"ل",1,0],["ويُطمِعُها في نيلِها العزَّ أنَّها","حليفُ طِرادٍ والمعالي طرائِدُ",25,"د",1,0],["وَيُطري وَلاءَ بَني هاشِمٍ","وَما عَظمُهُ فيهِمُ بِالمُمِخ",26,"خ",1,0],["ويطل الفداء شمساً علين","ما عسانا نكون.. لولا الفداء",27,"ا",2,0],["وَيَطلُبُ أَقوامٌ مَواريثَ هالِكٍ","وَفينا مَواريثُ النُبُوَّةِ وَالهُدى",28,"ا",1,0],["وَيُطلِعُ في سَماءِ الطُرسِ شُهباً","ثَواقِبُها لَأُفقِ المُلكِ تَحمي",29,"م",2,0],["وَيُطرِبُني في مَجلِسِ الأُنسِ بَينَنا","أَنابيبُ في أَجوافِها الريحُ تَصفِرُ",30,"ر",1,0],["ويُطْلِقُني من عقالِ العناقِ","صَباحٌ يُنَبّهُ عينَ الرّقيبِ",31,"ب",1,0],["وَيَطرُقُني ضَيفاً مَعَ اللَيلِ طَيفُهُ","فَيَكرَعُ في ماءٍ مِنَ البِشرِ غامِرِ",32,"ر",1,0],["وَيُطرِبُهُ سَجعُ الحَمامَةِ بِالضُحى","فَيَلوي إِلَيها لَيتَهُ مُتَفَهِّما",33,"م",2,0],["ويطوينَ الجلالةَ في جِلالٍ","نُهين لها الجباهَ مُعظِّمينا",34,"ن",2,0],["ويطمَعُ أن يُغادِرَهُ قتيلا","كذلك قال يستهوِي القبيلا",35,"ل",2,0],["ويطغى الليلُ والشوق","فيدعوك ويبكيك",36,"ك",1,0],["ويطرْنَ بعد الابترا","د إلى الغصونِ مهودهنَّه",37,"ن",2,0],["وَيَطلِبونَ كُلَّ يَومٍ رِزقاً","يَرَونَهُ دَيناً لَهُم وَحَقّا",38,"ق",2,0],["وَيَطيشُ نَبلي إِن رَمَي","تُ وَإِن رَمى فَهوَ المُجيدُ",39,"د",1,0],["وَيَطوي المَلا بَعدَ المَلا فَوقَ كَورِهِ","إِذا العيسُ تُزجى وَالسَوابِقُ تُجنَبُ",40,"ب",1,0],["وَيَطلُبُ النِقلَةَ عَن خيمِهِم","ناسٌ عَلى كُلِّ قَبيحٍ رُتُب",41,"ب",1,0],["وَيُطرِبُني بَعدَ النُهى قَولُ قائِلٍ","سَقى بارِقاً مِن جانِبِ الغَورِ بارِقُ",42,"ق",1,0],["وَيَطلُبُ قوتاً وَرِزقُ المَلي","كِ يَسأَلُ بِالطالِبِ السائِلِ",43,"ل",1,0],["وَيَطمَعُ في وِردِ السَرابِ مَعاشِرٌ","وَسَوفَ يَروزونَ الخُطوبَ كَما رُزنا",44,"ن",2,0],["ويُطيلُ عمركَ للصّديق فطولُهُ","سبَبٌ إلى غَيظِ العُداةِ وكَبتِها",45,"ت",3,0],["ويُطلَبُ منكَ ما هوَ فيكَ طبْعٌ","ومَطْلُوبٌ من اللّسِنِ البَيانُ",46,"ن",1,0],["ويَطْرَبُ مَن لم يَدْرِهَا عند ذِكْرِهَا","كَمُشْتَاقِ نُعْمٍ كلّما ذُكرَتْ نُعم",47,"م",1,0],["ويطير سمعي صوب كلِّ مُرِنَّةٍ","في الأفق تخفق عن جَناحيْ طائرِ",48,"ر",1,0],["ويُطلق الطيرُ نشيد الصباحْ","بنغمةٍ تصدر عن حزنهِ",49,"ه",1,0],["ويطلُعُ الفجْرُ وفَوْقَ جَفنِهِ","مِن النّجومِ حِلْيَةٌ لم تُحْرَزِ",50,"ز",1,0],["ويَطْعَنُ في عُلايَ وإنّ شِسْعي","لَيَأنَفُ أن يكونَ له نِجادا",51,"د",2,0],["وَيُطرِبُني وَالخَيلُ تَعثُرُ بِالقَنا","حُداةُ المَنايا وَاِرتِعاجُ المَواكِبِ",52,"ب",1,0],["وَيَطلَعُ ضَوءُ الصُبحِ تَحتَ جَبينِها","فَيَغشاهُ لَيلٌ مِن دُجى شَعرِها الجَعدِ",53,"د",1,0],["ويطرق أستاذه واجما..","ولا يذكر الطفل ما أنشدا..",54,"د",2,0],["ويطوي وراء البِشْرِ نفساً جَرِيحةً","وأعشارَ قلبٍ بالهُمومِ خَضِيب",55,"ب",1,0],["ويطُفْنَ بالبيت الكر","يمِ مُكبِّراتٍ داعيات",56,"ت",1,0],["ويَطْرُقُ الشَّيْخَ في المِحْرابِ قَدْ فَنِيَتْ","عِظَامُهُ وَبَرَتْهُ خَشْيَةُ البَاري",57,"ر",2,0],["ويُطرِبُها عالي الهتافِ فتنثني","كما رقصتْ هيفُ العذارى على غمِ",58,"م",1,0],["ويطلبُ اللحم من دكَّان فاكهةٍ","ويشتري الموز من حانوت جزار",59,"ر",1,0],["ويطوفُ بالوجناتِ قُبلةَ عاشقٍ","ويِدُّب في الأوصال كأَس عُقار",60,"ر",1,0],["ويطيب لي معنى الحياة به، وإن","تَكْن الحياةُ كثيرةَ الأوزار",60,"ر",1,0],["ويطوي برود الملك فوق خلائق","تناسب خلق الناسك المتزهد",61,"د",1,0],["ويطيرون يضفرون النجوم الخضر","\" غارا \" يكلّلون النضالا",62,"ل",2,0],["ويطير الحريق منا شرارا","فينال الشرار بكرا وعجلا",63,"ل",2,0],["ويَطْرقُني كلَّما راودَتْ","ضميريَ فاحشةٌ ترشَح",64,"ح",1,0],["ويطمعها حتّى إذا جنّ شوقها","إليه انثنى عن دربها وتجنّبا",65,"ب",2,0],["ويطلُّ الفداءُ شمساً علينا","ما عسانا نكونُ.. لولا الفداءُ",66,"ا",2,0],["ويطلع النحس به إذا طَلعْ","يا ويح أثوابك لو قد تُنْتَزع",67,"ع",1,0],["ويطول بين السائلين بَقاؤه","وكأن خاتم وجوده مِفْتاحُهُ",68,"ح",2,0],["وَ يطيرَ الحريقُ منا شراراً","فينالَ الشرارُ قيساً وَ ذهلاَ",69,"ل",2,0],["ويطفيءُ لوعتي شبت بهم","وبالالطاف يندفع الضرام",70,"م",1,0],["ويطيش أحلام اله","داة ويذهل المتأكدين",71,"ن",1,0],["ويطْوى عن الصبِّ أحزانَه","ويُنسى الخليلَ وصالَ الخليلْ",72,"ل",1,0],["ويطهّرُ الإسلام مما شابه","ويزيل عن غدرانه الأكدارا",73,"ر",2,0],["ويطرُدُ التحصيلَ من خاطري","صهباءُ أو صفراءُ سلسالَهْ",74,"ل",2,0],["وَيُطرِبُهُ صَليلُ البيضِ فَوقَ ال","قَوانِسِ لا البَسيطُ وَلا النَشيدُ",75,"د",1,0],["وَيَطفو عَلى ماءِ الجَمالِ بِوَجهِهِ","حَياءٌ تَظَنّى جاهِلٌ أَنَّهُ كِبرُ",76,"ر",1,0],["ويطرق سمعا بينكم مثل هذه","ويهنيكم طعم الكرى في المحاجر",77,"ر",1,0],["ويُطرِبني في جانبيك حَمائم","لها بين أوراق الغصون عَوِيل",78,"ل",1,0],["ويطبّ من داء طبيب حاذقٌ","متيقّظ وبجسمه سقم",79,"م",1,0],["وَيطيلُ وَصفَ نِزاعِهِ","فَيَزيدُ في شَوقي وَخبلي",80,"ل",2,0],["وَيُطِلُّ الدَهرُ مِن كوَّتِهِ","لِيَراها كَيف تُرمى بِالوُرود",81,"د",1,0],["ويطول هذا ثم يقصر ضده","متعاقبين بحكمة الإيلاج",82,"ج",1,0],["وَيُطْرًونَ الغَنِيَّ فَإِنْ تَرَدَّى","بِفَقْرِ فَهْوَ مَهْجورُ الْمُنَاخِ",83,"خ",1,0],["وَيُطْفِئُ نَارَ الْوَجْدِ مِنِّي بِقَطْرَةٍ","تُمِيتُ الجَوَى مِنْ فَضْلِهِ الْوَابِلِ الْقَطْرِ",84,"ر",1,0],["وَيُطرِبُكَ الشادي بِمدحكَ إِذ تَرى","فَعالَك فيهِ مُجملاً ومفصّلا",85,"ل",2,0],["ويطرب عند سماع الغنا","ويرقص للقرد في دولته",86,"ت",2,0],["ويطمع في نيل السها ولربما","سما كاهلا فوق السماك وحاركا",87,"ك",2,0],["ويُطربهُ على الأوتارِ لحنٌ","وتُسقمهُ إذا سقمت جفون",88,"ن",1,0],["ويُطربُهُ الشعرُ الذي أنا منشدٌ","فيَلهو عن التَسبيحِ والطَلبات",89,"ت",1,0],["وَيُطيلُ فِي حُلَلِ الجَمَالِ تَخايُلاً","فَتَخالُهُ حَلاهُ بَعْضَ حُلاهُ",90,"ا",2,0],["ويَطوي معَ الإصباحِ مَنْشورَ نَشْره","كَما بانَ عَن ربع المُحبّ حَبيبُ",91,"ب",1,0],["وَيُطْمِعُنِي فِيكَ أَنَّ الثنا","ءَ ما زالَ مِنْكَ مَكِينَ الْمَكانِ",92,"ن",1,0],["وَيُطلِعُ الشَمسَ عَلى الغُصنِ في","حِقفِ النَقا مِن تَحتِ خَصرٍ هَضيم",93,"م",1,0],["وَيَطرَبُ إِن غَنَّيتُهُ فَكَأَنَّني","ضَرَبتُ لَهُ في الديرِ بِالصُبحِ ناقوسا",94,"س",2,0],["وَيَطلَعُ الكُردِيُّ في غَيهَبٍ","مُعَربِداً بِالسَيفِ وَالرُمحِ",95,"ح",1,0],["وَيُطيل إِمتاعي بحفظِ جنابكم","مِن أَن يشابَ صفاهُ بالأقذاءِ",96,"ا",2,0],["وَيَطلُبُ دَولَةَ الدُنيا جُنوناً","وَدَولَتُها مُخالِفَة المَخازي",97,"ز",2,0],["ويطلق الألحان في الأرغن","فتستضىء الفكرة القاتمه",98,"ه",1,0],["ويطبي خافقي ظبي به هيف","فاتقيه بقلب بارز خال",99,"ل",1,0],["ويطغى على الزهر شوك القتاد","فيفقد ذا الكون لونا وشم",100,"م",1,0],["وَيَطلُبُ الشاهِدَ وَالشاهِ","دُ عِندي مِن حَضَر",101,"ر",1,0],["ويَطْلُبُك الشُّغْلُ الّذي يَطلُبونَه","فنَلْ منه فَخْراً ما سِواكَ بِنائل",102,"ل",1,0],["وَيُطلِعُ في سُحبِ العَجاجِ كَواكِباً","لَها الفِعلُ لا لِلثاقِباتِ الطَوالِعِ",103,"ع",1,1],["ويُطمعُني في عادَةٍ أستَعيدها","ولا وَجهَ مَع تيكَ العَوائد للناسِي",104,"س",2,0],["ويُطمعُني في راحَتي أنَّ حاجَتي","مُرددةٌ ما بين قَلبي وناظِري",105,"ر",2,0],["ويُطمعني بالوصل لِينُ قوامِها","وألحاظُها في كلّ قلبٍ لها حربُ",106,"ب",1,0],["ويُطْلِقُ كفّيهِ وأنتَ مُقيَّدٌ","وما مُطْلقٌ في فِعْلِهِ كمُقيّدِ",107,"د",1,0],["ويطيل السجود وهو كمون","لاصطياد يرجوه من أي ثلمه",108,"م",2,0],["ويطعمها أذهان قوم تسابقوا","إلى طلب العليا يهشون بالطبع",109,"ع",1,0],["ويُطيلُ العرفانُ فيه الكلاما","يتَحلَّى من فضله بِحُلْيٍ",110,"ي",1,0],["ويطرب في مغانيكم محبٌّ","يبوح لكم بما كتم الضمير",111,"ر",1,0],["ويطلبُها الهواءُ إِذا تراخَتْ","فيُقْسِمُ ما يَشُمُّ لها هواءَ",112,"ا",2,0],["ويطمعُ في شأوي أناسٌ تنافَسوا","على مَطعِمٍ في راحتيْهِ ومُطْمِعِ",113,"ع",1,0],["ويُطربني إن قام بالدوح نائح","على عذبات البان من شجوه يشدو",114,"د",2,0],["ويطرُقُهُ الوحيُ وَهنَاً وأَنتُم","ضَجيعَاهُ بَيْنَ يَدَيْ جِبرَئيلِ",115,"ل",1,0],["ويطلع فيها رؤوس جبال","فينحط من روسها بانهداد",116,"د",1,0],["ويطعن جوف المارقين بفعله","يقارع رهط الجاحدين المهرزِ",117,"ز",1,0],["ويطمعون الأعادي فيك عن سفه","حتى يعيث الأعادي في معاليك",118,"ك",1,0],["ويطهر الجيل الجديد بشعره","من كل شعوذة ومن كفران",119,"ن",1,0],["ويطعنني في الخلفِ وهو مُقِّبلٌ","يَراعي كأني سخرةٌ للمقادر",120,"ر",1,0],["ويَطَّبيني على فصاحةِ شك","واي إليها ربوعُها العُجُمُ",121,"م",1,0],["ويطفن يوماً بالملوك حوالياً","تُحفاً لهنّ الشَّمُّ والتقبيلُ",122,"ل",1,0],["ويطَّبيني وطَنٌ تربُهُ","مستعبَدٌ يلفِظ أحرارَهْ",123,"ر",2,0],["ويُطيقُ المغمَّرون الذي أب","دعَ فيه طريقه المسطورُ",124,"ر",1,0],["ويُطَرِّبُ الشادي فلا يهتزُّني","وينالُ منّي السائقُ الغِرّيدُ",125,"د",1,0],["ويَطْوي أمانيَّ النفوسِ نَجيَّةً","مخافةَ عُقبى رَعْيُها مُتوخِّمُ",126,"م",1,0],["ويُطْريهُ ذِكرُ المكارمِ والعُلى","كأنَّ المَساعي قرْقَفٌ ومُدامُ",127,"م",1,0],["ويَطأنَ غُرَّانَ السَّراةِ كأنها","صوَّانُ رعْنٍ بالسَّنابك يُهْشمُ",128,"م",1,0],["ويُطْربُني صدقي بنظمِ مديحهِ","وإِن بات جفْني وهو للمدح ساهر",129,"ر",1,0],["ويطربهُ المال بعد العطا","إذا عاد منه ثناءٌ وحمد",130,"د",1,0],["ويطربني في البدر منه ملامحٌ","وفي عذبات البان من قدّه معنى",131,"ن",2,0],["ويطلعُ في ظلام الحرب بدراً","منيراً ليس يخفيهِ السّرار",132,"ر",1,0],["ويطلع الصبح في ديجور طرَّته","والليلُ ما عنده من صبحه خبر",133,"ر",1,0],["ويُطرِبُني عندَ تغريدِه","على البانِ قُمريُّهُ النائحُ",134,"ح",1,0],["ويطير الأسرار منهم شؤنٌ","طرزها الإحترام والإحتشام",135,"م",1,0],["ويطير للزور الملفق سمعه","ويعده من محكم الآيات",136,"ت",1,0],["ويَطيرُ للمَلإِ العَلِ","يِّ وعِشُّهُ لا يُقَطَعُ",137,"ع",1,0],["ويطوي السّرَّ منه وكيفَ يَخفى","وفي عينيهِ عُنوانُ العَلانِ",138,"ن",1,0],["ويطول مكث المرء ثاو في الثرى","حتى يرى أثراً من الزيزاء",139,"ا",2,0],["ويَطْوِي الْبِشْرَ عَنِّي منْ أُصَافِي","ويَنْسَى ما لَدَيْهِ مِنَ الأَيادِي",140,"د",2,0],["ويَطَّرحونَ قَوْلَ الطُّهْرِ طَهَ","وكُلٌّ مِنْهُمُ عَنْهُ شُرُودُ",141,"د",1,0],["ويَطَّرِحُ الآمالَ غَيْرَ مُعَرِّجٍ","عَلَى ما بِهِ عَنْ رُتْبَةِ الْمَجْدِ ألْهَتِ",142,"ت",1,0],["ويطيرُ في جَوِّ السمَاء محلِقا","حتَّى يُري أسرَاره لِلرَّائي",143,"ا",2,0],["ويطيع من كرمٍ تَجَلَّلَه","أمرَ النّدى ودواعِيَ البذلِ",144,"ل",1,0],["ويطمعني أنّني سالمٌ","وداءُ السّلامة لِي أقتَلُ",145,"ل",1,0],["ويُطربن مَن أصغى لهنَّ بسمعِه","كما أطربتْ ذا الخمرِ ألحانُ مَعبدِ",146,"د",1,0],["وَيُطرِبُني إِنْ عنَّ ذكرُك مرّةً","وَلَستُ لِشيءٍ غير ذكراك أطربُ",147,"ب",1,0],["ويطرد عنه كل من تبع الهوى","وتمزيقه ديناً بدنياه راقع",148,"ع",1,0],["ويطيب في أرض الحقيقة غرسنا","لا تعرضوا عنا فهذا أنسنا",149,"ن",2,0],["ويُطِيْلُ أبناءُ الرَّغا","ئِبِ في مسالِكِهِ انتظارَهْ",150,"ر",2,0],["ويُطْوى سجِلُّ الأَرضِ من قبلِ طيِّه","وتنهدِمُ الدنيا وما يُتَهدَّمُ",151,"م",1,0],["ويُطرِبُه صوتُ القِراعِ وإِنَّه","له طَرباتٌ وهْو للقومِ أَهْوَال",152,"ل",1,0],["ويطلعُ فيها الصُّبح والَّليلُ بَعْدَهُ","وفي قلبٍ ذا خوفٌ وفي صدرِ ذَا ذُعْرُ",153,"ر",1,0],["ويُطِيعُ أَمرَكَ أَو يَرى","ما كان صَعْباً غيرَ صَعْب",154,"ب",1,0]]}