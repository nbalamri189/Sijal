{"poems":[[63,"أتروى وقد صدح الجندب","https://www.aldiwan.net/poem46138.html","المتقارب"],[63,"ألمت ودوني رامة فكثيبها","https://www.aldiwan.net/poem46161.html","الطويل"],[63,"مراحك إنه البرق اليماني","https://www.aldiwan.net/poem46172.html","الوافر"],[63,"سرى البرق والليل يدني خطاه","https://www.aldiwan.net/poem46183.html","المتقارب"],[63,"حنانيك إن الغدر ضربة لازب","https://www.aldiwan.net/poem46200.html","الطويل"],[63,"بدا والثريا في مغاربها قرط","https://www.aldiwan.net/poem46211.html","الطويل"],[3,"أحن إلى ضرب السيوف القواضب","https://www.aldiwan.net/poem129.html",""],[77,"أهاجتك ذكرى من خليط ومعهد","https://www.aldiwan.net/poem36601.html","الطويل"],[77,"دعاك بأقصى المغربين غريب","https://www.aldiwan.net/poem36715.html","الطويل"],[86,"يحييك من أرض الكنانة شاعر","https://www.aldiwan.net/poem68927.html","الطويل"],[93,"يا رجاء الوطن","https://www.aldiwan.net/poem11167.html","مجزوء الرمل"],[88,"لا تبك أربعهم ولا الأطلالا","https://www.aldiwan.net/poem44425.html","الكامل"],[47,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[72,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[72,"صيرت نومي مثل عطفك نافرا","https://www.aldiwan.net/poem18698.html","الكامل"],[72,"قسما بغصن قوامه المتمايل","https://www.aldiwan.net/poem19481.html","الكامل"],[51,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[51,"قدمت لي وعدا فأين نجاحه","https://www.aldiwan.net/poem9384.html","الكامل"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[91,"شهور العام أجملها ربيع","https://www.aldiwan.net/poem8810.html","عموديه"],[89,"اذكري إذ كنا صغيرين نلعب","https://www.aldiwan.net/poem44865.html","الخفيف"],[89,"سلام على عهد الرقي المحبب","https://www.aldiwan.net/poem44927.html","الطويل"],[43,"على قدر أهل العزم تأتي العزائم","https://www.aldiwan.net/poem10524.html","الطويل"],[43,"أحق عاف بدمعك الهمم","https://www.aldiwan.net/poem10537.html","المنسرح"],[62,"كفى حزنا بأن تمضي الليالي","https://www.aldiwan.net/poem52303.html","الوافر"],[62,"فؤاد على كر الحوادث مارد","https://www.aldiwan.net/poem52454.html","الطويل"],[45,"لنا صاحب ظالم ما يزال","https://www.aldiwan.net/poem62729.html","المتقارب"],[99,"إفادة في محكمة الشعر","https://www.aldiwan.net/poem6630.html","عموديه"],[58,"أمن بعد تكفين النبي ودفنه","https://www.aldiwan.net/poem31202.html","الطويل"],[66,"كتبت فما علمت أنور نجم","https://www.aldiwan.net/poem40640.html","الوافر"],[66,"وإني لألهو بالمدام وإنها","https://www.aldiwan.net/poem40675.html","الطويل"],[80,"طربت متى كنت غير الطروب","https://www.aldiwan.net/poem31567.html","المتقارب"],[74,"لك الخير أي الخير في رد صاحب","https://www.aldiwan.net/poem12963.html","الطويل"],[74,"أما وخيال قد أطاف وسلما","https://www.aldiwan.net/poem13244.html","الطويل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"إلى القوم الألى جمعوا الجموعا","https://www.aldiwan.net/poem44203.html","الوافر"],[102,"هبيني لا أسميك","https://www.aldiwan.net/poem32923.html","الهزج"],[102,"بيض الحمائم حسبهنه","https://www.aldiwan.net/poem33133.html","مجزوء الكامل"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[50,"عاد الغداة الصب عيد","https://www.aldiwan.net/poem63944.html","مجزوء الكامل"],[46,"ليشغلك ما أصبحت مرتقبا له","https://www.aldiwan.net/poem22055.html","الطويل"],[46,"أخبرت عن كتبك أعجوبة","https://www.aldiwan.net/poem22372.html","السريع"],[46,"أرقت فهل نجم الدجنة آرق","https://www.aldiwan.net/poem23015.html","الطويل"],[46,"عجبت وكم عجب في الزمان","https://www.aldiwan.net/poem23264.html","المتقارب"],[46,"إذا أعمل الفكر الفتى جعل الغنى","https://www.aldiwan.net/poem23467.html","الطويل"],[46,"يا راعي الود الذي أفعاله","https://www.aldiwan.net/poem23629.html","الكامل"],[46,"معان من أحبتنا معان","https://www.aldiwan.net/poem23635.html","الوافر"],[68,"شربنا على ذكر الحبيب مدامة","https://www.aldiwan.net/poem1525.html",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39564","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39561","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16647","الرجز"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16643","الوافر"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9896","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9921","الطويل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199493","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54293","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54255","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54239","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54316","الطويل"],[106,"من وحي الكأس","https://www.poetsgate.com/ViewPoem.aspx?id=179738",""],[106,"موكب الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=179775",""],[77,"أهاجتك ذكرى من خليط ومعهد","https://www.poetsgate.com/ViewPoem.aspx?id=33822",""],[18,"إن تحت الأحجار حزما وعزما","https://www.poetsgate.com/ViewPoem.aspx?id=27785",""],[90,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=179239",""],[99,"إفادة في محكمة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=581",""],[51,"وجهك يا شنطفُ هَولُ المُطَّلعْ","https://www.poetsgate.com/ViewPoem.aspx?id=29538",""],[51,"قدَّمتَ لي وعداً فأين نجاحُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=27390",""],[18,"إنَّ تَحْتَ الأَحْجَارِ حَزْماً وَعَزْمَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26455&r=&rc=21",""]],"verses":[["ويَطْوينَ والرّوْضُ في حُلّةٍ","يجُرُّ رَفارِفَها الأزْيَبُ",0,"ب",1,0],["ويُطْرِبُها الحادي بمَدْحِكَ مَوْهِناً","فتَخْدي وقد مَسَّ المَراخِي لُغوبُها",1,"ب",3,0],["ويَطْوونَ الضُّلوعَ على طَواها","ويأْكُلُ جارُهُمْ أُنُفَ الجِفانِ",2,"ن",1,0],["ويَطْوي الضُّلوعَ على غُلَّةٍ","إذا درَّعَتْهُ الهَوانَ المِياهْ",3,"ا",2,0],["ويُطبِقُ جَفْنَيهِ إذا اعْتَرَضَ السَّنا","مَخافَةَ أنْ يُمْنَى بِنارِ الحُباحِبِ",4,"ب",1,0],["ويَطوي على البَغْضاءِ جَنْبَيْهِ كاشِحٌ","تخطّى بهِ رَهْواً إِلى الحَسَدِ الغَبْطُ",5,"ط",1,0],["وَيُطرِبُني وَالخَيلُ تَعثُرُ بِالقَن","حُداةُ المَنايا وَاِرتِعاجُ المَواكِبِ",6,"ب",1,0],["ويَطْوي بُرودَ الُلْكِ فوقَ خلائِقٍ","تُناسبُ خُلْقَ النّاسِكِ المتزهِّدِ",7,"د",1,0],["وَيَطْلُبُ فِي جَيْبِ الْجَنُوبِ جَوَابَهَا","إِذَا مَا أَطَلَّتْ وَالصَّبَاحُ جَنِيبُ",8,"ب",1,0],["وَيُطرِبُهِ في يَومِ ذِكراكَ أَن مَشَت","إِلَيكَ مُلوكُ القَولِ عُربٌ وَأَعجَمُ",9,"م",1,0],["وَيَطُلْ عَهْدُهُ","مَا يَطُولُ المَدَى",10,"د",2,0],["ويطير في جوّ السرور مرفوفاً","بالمشتكين كآبةً ومسلالا",11,"ل",2,0],["وَيَطلُبُ كَعباً حَيثُ لا الإِثرُ يُقتَفى","لِتَعلَمَ كَعبٌ أَيَّ عودٍ تُكاسِرُ",12,"ر",1,0],["ويطرحون على الأبوابِ من حمقٍ","قصائِداً هي في التحقيق بابات",13,"ت",1,0],["ويطرب المدحُ فيه حينَ أكتبه","كأن منتصب الأقلامِ نايات",13,"ت",1,0],["ويطيع قلبي حكم لحظك في الهوى","يا للكليم غدا يطيع السَّاحرا",14,"ر",2,0],["ويطيب أفواه العواذل ذكره","حتَّى أهمّ بلثم ثغر العاذل",15,"ل",1,0],["ويطعن الطعنة النجلاء يتبعها","شخبٌ دَرير إذا لاقَى الحصى ضَرحا",16,"ح",2,0],["ويطول بين السائلين بَقاؤه","وكأن خاتم جوده مِفْتاحُهُ",17,"ح",2,0],["ويُطْرِقُ إطْراقَ الذَّليل وإنه","هُنَاكَ لَسَامِي نَاظِرِ العيْنِ أصْيَدُ",18,"د",1,0],["وَيَطلُبُ مِن نَباتِ الأَرضِ قوتاً","وَتَأبى غَيرَ لَحمِ الطَيرِ زادا",19,"د",2,0],["ويطول الفراق والحزن حتى","يصبح الموت وحده كل مأرب",20,"ب",1,0],["ويطرق سمعي اسم السعيد ولا ارى","بعيني سعيداً فهو عنقاء مغرب",21,"ب",1,0],["وَيَطلِبُ عِندَ الناسِ ما عِندَ نَفسِهِ","وَذَلِكَ مالا تَدَّعيهِ الضَراغِمُ",22,"م",1,0],["وَيَطعَنُ الخَيلَ كُلَّ نافِذَةٍ","لَيسَ لَها مِن وَحائِها أَلَمُ",23,"م",1,0],["ويطوي صبرَهُ ريحٌ شَمالٌ","وينشُرُ وجدَهْ راحٌ شَمولُ",24,"ل",1,0],["ويُطمِعُها في نيلِها العزَّ أنَّها","حليفُ طِرادٍ والمعالي طرائِدُ",25,"د",1,0],["وَيُطري وَلاءَ بَني هاشِمٍ","وَما عَظمُهُ فيهِمُ بِالمُمِخ",26,"خ",1,0],["ويطل الفداء شمساً علين","ما عسانا نكون.. لولا الفداء",27,"ا",2,0],["وَيَطلُبُ أَقوامٌ مَواريثَ هالِكٍ","وَفينا مَواريثُ النُبُوَّةِ وَالهُدى",28,"ا",1,0],["وَيُطلِعُ في سَماءِ الطُرسِ شُهباً","ثَواقِبُها لَأُفقِ المُلكِ تَحمي",29,"ي",1,0],["وَيُطرِبُني في مَجلِسِ الأُنسِ بَينَنا","أَنابيبُ في أَجوافِها الريحُ تَصفِرُ",30,"ر",1,0],["ويُطْلِقُني من عقالِ العناقِ","صَباحٌ يُنَبّهُ عينَ الرّقيبِ",31,"ب",1,0],["وَيَطرُقُني ضَيفاً مَعَ اللَيلِ طَيفُهُ","فَيَكرَعُ في ماءٍ مِنَ البِشرِ غامِرِ",32,"ر",1,0],["وَيُطرِبُهُ سَجعُ الحَمامَةِ بِالضُحى","فَيَلوي إِلَيها لَيتَهُ مُتَفَهِّما",33,"م",2,0],["ويطوينَ الجلالةَ في جِلالٍ","نُهين لها الجباهَ مُعظِّمينا",34,"ن",2,0],["ويطمَعُ أن يُغادِرَهُ قتيلا","كذلك قال يستهوِي القبيلا",35,"ل",2,0],["ويطغى الليلُ والشوق","فيدعوك ويبكيك",36,"ك",1,0],["ويطرْنَ بعد الابترا","د إلى الغصونِ مهودهنَّه",37,"ن",2,0],["وَيَطلِبونَ كُلَّ يَومٍ رِزقاً","يَرَونَهُ دَيناً لَهُم وَحَقّا",38,"ق",2,0],["وَيَطيشُ نَبلي إِن رَمَي","تُ وَإِن رَمى فَهوَ المُجيدُ",39,"د",1,0],["وَيَطوي المَلا بَعدَ المَلا فَوقَ كَورِهِ","إِذا العيسُ تُزجى وَالسَوابِقُ تُجنَبُ",40,"ب",1,0],["وَيَطلُبُ النِقلَةَ عَن خيمِهِم","ناسٌ عَلى كُلِّ قَبيحٍ رُتُب",41,"ب",1,0],["وَيُطرِبُني بَعدَ النُهى قَولُ قائِلٍ","سَقى بارِقاً مِن جانِبِ الغَورِ بارِقُ",42,"ق",1,0],["وَيَطلُبُ قوتاً وَرِزقُ المَلي","كِ يَسأَلُ بِالطالِبِ السائِلِ",43,"ل",1,0],["وَيَطمَعُ في وِردِ السَرابِ مَعاشِرٌ","وَسَوفَ يَروزونَ الخُطوبَ كَما رُزنا",44,"ن",2,0],["ويُطيلُ عمركَ للصّديق فطولُهُ","سبَبٌ إلى غَيظِ العُداةِ وكَبتِها",45,"ت",3,0],["ويُطلَبُ منكَ ما هوَ فيكَ طبْعٌ","ومَطْلُوبٌ من اللّسِنِ البَيانُ",46,"ن",1,0],["ويَطْرَبُ مَن لم يَدْرِهَا عند ذِكْرِهَا","كَمُشْتَاقِ نُعْمٍ كلّما ذُكرَتْ نُعم",47,"م",1,0],["ويطير سمعي صوب كلِّ مُرِنَّةٍ","في الأفق تخفق عن جَناحيْ طائرِ",48,"ر",1,0],["ويُطلق الطيرُ نشيد الصباحْ","بنغمةٍ تصدر عن حزنهِ",49,"ه",1,0],["ويطلُعُ الفجْرُ وفَوْقَ جَفنِهِ","مِن النّجومِ حِلْيَةٌ لم تُحْرَزِ",50,"ز",1,0],["ويَطْعَنُ في عُلايَ وإنّ شِسْعي","لَيَأنَفُ أن يكونَ له نِجادا",51,"د",2,0],["وَيُطرِبُني وَالخَيلُ تَعثُرُ بِالقَنا","حُداةُ المَنايا وَاِرتِعاجُ المَواكِبِ",52,"ب",1,0],["وَيَطلَعُ ضَوءُ الصُبحِ تَحتَ جَبينِها","فَيَغشاهُ لَيلٌ مِن دُجى شَعرِها الجَعدِ",53,"د",1,0],["ويطرق أستاذه واجما..","ولا يذكر الطفل ما أنشدا..",54,"د",2,0],["ويطوي وراء البِشْرِ نفساً جَرِيحةً","وأعشارَ قلبٍ بالهُمومِ خَضِيب",55,"ب",1,0],["ويطُفْنَ بالبيت الكر","يمِ مُكبِّراتٍ داعيات",56,"ت",1,0],["ويَطْرُقُ الشَّيْخَ في المِحْرابِ قَدْ فَنِيَتْ","عِظَامُهُ وَبَرَتْهُ خَشْيَةُ البَاري",57,"ر",2,0],["ويُطرِبُها عالي الهتافِ فتنثني","كما رقصتْ هيفُ العذارى على غمِ",58,"م",1,0],["ويطلبُ اللحم من دكَّان فاكهةٍ","ويشتري الموز من حانوت جزار",59,"ر",1,0],["ويطوفُ بالوجناتِ قُبلةَ عاشقٍ","ويِدُّب في الأوصال كأَس عُقار",60,"ر",1,0],["ويطيب لي معنى الحياة به، وإن","تَكْن الحياةُ كثيرةَ الأوزار",60,"ر",1,0],["ويطوي برود الملك فوق خلائق","تناسب خلق الناسك المتزهد",61,"د",1,0],["ويطير الحريق منا شرارا","فينال الشرار بكرا وعجلا",62,"ل",2,0],["ويَطْرقُني كلَّما راودَتْ","ضميريَ فاحشةٌ ترشَح",63,"ح",1,0],["ويطلُّ الفداءُ شمساً علينا","ما عسانا نكونُ.. لولا الفداءُ",64,"ا",2,0],["ويطلع النحس به إذا طَلعْ","يا ويح أثوابك لو قد تُنْتَزع",65,"ع",1,0],["ويطول بين السائلين بَقاؤه","وكأن خاتم وجوده مِفْتاحُهُ",66,"ح",2,0],["وَ يطيرَ الحريقُ منا شراراً","فينالَ الشرارُ قيساً وَ ذهلاَ",67,"ل",2,0]]}