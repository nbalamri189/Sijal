"https://www.aldiwan.net/poem56171.html","السريع"],[461,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[461,"تهوى وأنت محلأ مصدود","https://www.aldiwan.net/poem56216.html","الكامل"],[464,"تعاظم حزني والرزية أعظم","https://www.aldiwan.net/poem15905.html","الطويل"],[464,"منازلكم للخائفين عصام","https://www.aldiwan.net/poem16033.html","الطويل"],[464,"الخطب أكبر في النفوس وأعظم","https://www.aldiwan.net/poem16060.html","الكامل"],[464,"ليهن الرعايا والمناقب والعلى","https://www.aldiwan.net/poem16354.html","الطويل"],[467,"تلقاك يا سعد بالنجح سعد","https://www.aldiwan.net/poem3152.html","عموديه"],[467,"أماط لثاماً فاجتلِ القمر الأدنى","https://www.aldiwan.net/poem3203.html","عموديه"],[467,"أقام الوجد بعدهم وساروا","https://www.aldiwan.net/poem3209.html","عموديه"],[467,"سرى وأقبل يقفو إثره القمر","https://www.aldiwan.net/poem3626.html","عموديه"],[480,"أبرق على المنحنى لائحام","https://www.aldiwan.net/poem15220.html","المتقارب"],[503,"أين يا حادي النياق الخيام","https://www.aldiwan.net/poem37627.html","الخفيف"],[503,"الخب ميال مع الشبهات","https://www.aldiwan.net/poem37714.html","الكامل"],[503,"إطمس مشاهدك التي","https://www.aldiwan.net/poem37971.html","مجزوء الكامل"],[517,"تصاحى وهو مخمور الجنان","https://www.aldiwan.net/poem20821.html","الوافر"],[518,"داويت ما نفع العليل دوائي","https://www.aldiwan.net/poem12002.html","الكامل"],[532,"يجاهرني العدو بكل نكر","https://www.aldiwan.net/poem37467.html","الوافر"],[532,"على عصر الشبيبة كل حين","https://www.aldiwan.net/poem37469.html","الوافر"],[532,"مسامع من ناديت يا عمرو سدت","https://www.aldiwan.net/poem37501.html","الطويل"],[541,"عبد السلام ببلدة الحمراء","https://www.aldiwan.net/poem48306.html","عموديه"],[554,"خذ صاحبي عني الذي أملي","https://www.aldiwan.net/poem47284.html","أحذ الكامل"],[554,"أأغفل والدهر لا يغفل","https://www.aldiwan.net/poem47339.html","المتقارب"],[554,"أيا ملك الأملاك قد جاءني الذي","https://www.aldiwan.net/poem47842.html","الطويل"],[554,"أتنسين يا لمياء شملك جامعا","https://www.aldiwan.net/poem48098.html","الطويل"],[561,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[561,"قلبي الذي في ذاتكم يتقلب","https://www.aldiwan.net/poem34938.html","الكامل"],[570,"حلل الشبيبة مستعاره","https://www.aldiwan.net/poem69664.html","مجزوء الكامل"],[578,"سعودك ردت ما ادعاه المنجم","https://www.aldiwan.net/poem3015.html","الطويل"],[578,"على خاطري يا شغله منك أشغال","https://www.aldiwan.net/poem3029.html","الطويل"],[578,"ألا فانتبه من أفقها طلع الفجر","https://www.aldiwan.net/poem3064.html","الطويل"],[578,"مالي هجرت بغير ذنب","https://www.aldiwan.net/poem3104.html","مجزوء الكامل"]],"verses":[["ويَطْوينَ والرّوْضُ في حُلّةٍ","يجُرُّ رَفارِفَها الأزْيَبُ",0,"ب",1,0],["ويُطْرِبُها الحادي بمَدْحِكَ مَوْهِناً","فتَخْدي وقد مَسَّ المَراخِي لُغوبُها",1,"ب",3,0],["ويَطْوونَ الضُّلوعَ على طَواها","ويأْكُلُ جارُهُمْ أُنُفَ الجِفانِ",2,"ن",1,0],["ويَطْوي الضُّلوعَ على غُلَّةٍ","إذا درَّعَتْهُ الهَوانَ المِياهْ",3,"ا",2,0],["ويُطبِقُ جَفْنَيهِ إذا اعْتَرَضَ السَّنا","مَخافَةَ أنْ يُمْنَى بِنارِ الحُباحِبِ",4,"ب",1,0],["ويَطوي على البَغْضاءِ جَنْبَيْهِ كاشِحٌ","تخطّى بهِ رَهْواً إِلى الحَسَدِ الغَبْطُ",5,"ط",1,0],["وَيُطرِبُني وَالخَيلُ تَعثُرُ بِالقَن","حُداةُ المَنايا وَاِرتِعاجُ المَواكِبِ",6,"ب",1,0],["ويَطْوي بُرودَ الُلْكِ فوقَ خلائِقٍ","تُناسبُ خُلْقَ النّاسِكِ المتزهِّدِ",7,"د",1,0],["وَيَطْلُبُ فِي جَيْبِ الْجَنُوبِ جَوَابَهَا","إِذَا مَا أَطَلَّتْ وَالصَّبَاحُ جَنِيبُ",8,"ب",1,0],["وَيُطرِبُهِ في يَومِ ذِكراكَ أَن مَشَت","إِلَيكَ مُلوكُ القَولِ عُربٌ وَأَعجَمُ",9,"م",1,0],["وَيَطُلْ عَهْدُهُ","مَا يَطُولُ المَدَى",10,"د",2,0],["ويطير في جوّ السرور مرفوفاً","بالمشتكين كآبةً ومسلالا",11,"ل",2,0],["وَيَطلُبُ كَعباً حَيثُ لا الإِثرُ يُقتَفى","لِتَعلَمَ كَعبٌ أَيَّ عودٍ تُكاسِرُ",12,"ر",1,0],["ويطرحون على الأبوابِ من حمقٍ","قصائِداً هي في التحقيق بابات",13,"ت",1,0],["ويطرب المدحُ فيه حينَ أكتبه","كأن منتصب الأقلامِ نايات",13,"ت",1,0],["ويطيع قلبي حكم لحظك في الهوى","يا للكليم غدا يطيع السَّاحرا",14,"ر",2,0],["ويطيب أفواه العواذل ذكره","حتَّى أهمّ بلثم ثغر العاذل",15,"ل",1,0],["ويطعن الطعنة النجلاء يتبعها","شخبٌ دَرير إذا لاقَى الحصى ضَرحا",16,"ح",2,0],["ويطول بين السائلين بَقاؤه","وكأن خاتم جوده مِفْتاحُهُ",17,"ح",2,0],["ويُطْرِقُ إطْراقَ الذَّليل وإنه","هُنَاكَ لَسَامِي نَاظِرِ العيْنِ أصْيَدُ",18,"د",1,0],["وَيَطلُبُ مِن نَباتِ الأَرضِ قوتاً","وَتَأبى غَيرَ لَحمِ الطَيرِ زادا",19,"د",2,0],["ويطول الفراق والحزن حتى","يصبح الموت وحده كل مأرب",20,"ب",1,0],["ويطرق سمعي اسم السعيد ولا ارى","بعيني سعيداً فهو عنقاء مغرب",21,"ب",1,0],["وَيَطلِبُ عِندَ الناسِ ما عِندَ نَفسِهِ","وَذَلِكَ مالا تَدَّعيهِ الضَراغِمُ",22,"م",1,0],["وَيَطعَنُ الخَيلَ كُلَّ نافِذَةٍ","لَيسَ لَها مِن وَحائِها أَلَمُ",23,"م",1,0],["ويطوي صبرَهُ ريحٌ شَمالٌ","وينشُرُ وجدَهْ راحٌ شَمولُ",24,"ل",1,0],["ويُطمِعُها في نيلِها العزَّ أنَّها","حليفُ طِرادٍ والمعالي طرائِدُ",25,"د",1,0],["وَيُطري وَلاءَ بَني هاشِمٍ","وَما عَظمُهُ فيهِمُ بِالمُمِخ",26,"خ",1,0],["ويطل الفداء شمساً علين","ما عسانا نكون.. لولا الفداء",27,"ا",2,0],["وَيَطلُبُ أَقوامٌ مَواريثَ هالِكٍ","وَفينا مَواريثُ النُبُوَّةِ وَالهُدى",28,"ا",1,0],["وَيُطلِعُ في سَماءِ الطُرسِ شُهباً","ثَواقِبُها لَأُفقِ المُلكِ تَحمي",29,"م",2,0],["وَيُطرِبُني في مَجلِسِ الأُنسِ بَينَنا","أَنابيبُ في أَجوافِها الريحُ تَصفِرُ",30,"ر",1,0],["وَيَطيرَ الحَريقُ مِنّا شَراراً","فَيَنالَ الشَرارُ بَكراً وَعِجلا",31,"ل",2,0],["ويُطْلِقُني من عقالِ العناقِ","صَباحٌ يُنَبّهُ عينَ الرّقيبِ",32,"ب",1,0],["وَيَطرُقُني ضَيفاً مَعَ اللَيلِ طَيفُهُ","فَيَكرَعُ في ماءٍ مِنَ البِشرِ غامِرِ",33,"ر",1,0],["وَيُطرِبُهُ سَجعُ الحَمامَةِ بِالضُحى","فَيَلوي إِلَيها لَيتَهُ مُتَفَهِّما",34,"م",2,0],["ويطوينَ الجلالةَ في جِلالٍ","نُهين لها الجباهَ مُعظِّمينا",35,"ن",2,0],["ويطمَعُ أن يُغادِرَهُ قتيلا","كذلك قال يستهوِي القبيلا",36,"ل",2,0],["ويطغى الليلُ والشوق","فيدعوك ويبكيك",37,"ك",1,0],["ويطرْنَ بعد الابترا","د إلى الغصونِ مهودهنَّه",38,"ن",2,0],["وَيَطلِبونَ كُلَّ يَومٍ رِزقاً","يَرَونَهُ دَيناً لَهُم وَحَقّا",39,"ق",2,0],["وَيَطيشُ نَبلي إِن رَمَي","تُ وَإِن رَمى فَهوَ المُجيدُ",40,"د",1,0],["وَيَطوي المَلا بَعدَ المَلا فَوقَ كَورِهِ","إِذا العيسُ تُزجى وَالسَوابِقُ تُجنَبُ",41,"ب",1,0],["وَيَطلُبُ النِقلَةَ عَن خيمِهِم","ناسٌ عَلى كُلِّ قَبيحٍ رُتُب",42,"ب",1,0],["وَيُطرِبُني بَعدَ النُهى قَولُ قائِلٍ","سَقى بارِقاً مِن جانِبِ الغَورِ بارِقُ",43,"ق",1,0],["وَيَطلُبُ قوتاً وَرِزقُ المَلي","كِ يَسأَلُ بِالطالِبِ السائِلِ",44,"ل",1,0],["وَيَطمَعُ في وِردِ السَرابِ مَعاشِرٌ","وَسَوفَ يَروزونَ الخُطوبَ كَما رُزنا",45,"ن",2,0],["ويُطيلُ عمركَ للصّديق فطولُهُ","سبَبٌ إلى غَيظِ العُداةِ وكَبتِها",46,"ت",3,0],["ويُطلَبُ منكَ ما هوَ فيكَ طبْعٌ","ومَطْلُوبٌ من اللّسِنِ البَيانُ",47,"ن",1,0],["ويَطْرَبُ مَن لم يَدْرِهَا عند ذِكْرِهَا","كَمُشْتَاقِ نُعْمٍ كلّما ذُكرَتْ نُعم",48,"م",1,0],["ويطير سمعي صوب كلِّ مُرِنَّةٍ","في الأفق تخفق عن جَناحيْ طائرِ",49,"ر",1,0],["ويُطلق الطيرُ نشيد الصباحْ","بنغمةٍ تصدر عن حزنهِ",50,"ه",1,0],["ويطلُعُ الفجْرُ وفَوْقَ جَفنِهِ","مِن النّجومِ حِلْيَةٌ لم تُحْرَزِ",51,"ز",1,0],["ويَطْعَنُ في عُلايَ وإنّ شِسْعي","لَيَأنَفُ أن يكونَ له نِجادا",52,"د",2,0],["وَيُطرِبُني وَالخَيلُ تَعثُرُ بِالقَنا","حُداةُ المَنايا وَاِرتِعاجُ المَواكِبِ",53,"ب",1,0],["وَيَطلَعُ ضَوءُ الصُبحِ تَحتَ جَبينِها","فَيَغشاهُ لَيلٌ مِن دُجى شَعرِها الجَعدِ",54,"د",1,0],["ويطرق أستاذه واجما..","ولا يذكر الطفل ما أنشدا..",55,"د",2,0],["ويطوي وراء البِشْرِ نفساً جَرِيحةً","وأعشارَ قلبٍ بالهُمومِ خَضِيب",56,"ب",1,0],["ويطُفْنَ بالبيت الكر","يمِ مُكبِّراتٍ داعيات",57,"ت",1,0],["ويَطْرُقُ الشَّيْخَ في المِحْرابِ قَدْ فَنِيَتْ","عِظَامُهُ وَبَرَتْهُ خَشْيَةُ البَاري",58,"ر",2,0],["ويُطرِبُها عالي الهتافِ فتنثني","كما رقصتْ هيفُ العذارى على غمِ",59,"م",1,0],["ويطلبُ اللحم من دكَّان فاكهةٍ","ويشتري الموز من حانوت جزار",60,"ر",1,0],["ويطوفُ بالوجناتِ قُبلةَ عاشقٍ","ويِدُّب في الأوصال كأَس عُقار",61,"ر",1,0],["ويطيب لي معنى الحياة به، وإن","تَكْن الحياةُ كثيرةَ الأوزار",61,"ر",1,0],["ويطوي برود الملك فوق خلائق","تناسب خلق الناسك المتزهد",62,"د",1,0],["ويطيرون يضفرون النجوم الخضر","\" غارا \" يكلّلون النضالا",63,"ل",2,0],["ويَطْرقُني كلَّما راودَتْ","ضميريَ فاحشةٌ ترشَح",64,"ح",1,0],["ويطمعها حتّى إذا جنّ شوقها","إليه انثنى عن دربها وتجنّبا",65,"ب",2,0],["ويطلُّ الفداءُ شمساً علينا","ما عسانا نكونُ.. لولا الفداءُ",66,"ا",2,0],["ويطلع النحس به إذا طَلعْ","يا ويح أثوابك لو قد تُنْتَزع",67,"ع",1,0],["ويطول بين السائلين بَقاؤه","وكأن خاتم وجوده مِفْتاحُهُ",68,"ح",2,0],["وَ يطيرَ الحريقُ منا شراراً","فينالَ الشرارُ قيساً وَ ذهلاَ",69,"ل",2,0],["ويطفيءُ لوعتي شبت بهم","وبالالطاف يندفع الضرام",70,"م",1,0],["ويطيش أحلام اله","داة ويذهل المتأكدين",71,"ن",1,0],["ويطْوى عن الصبِّ أحزانَه","ويُنسى الخليلَ وصالَ الخليلْ",72,"ل",1,0],["ويطهّرُ الإسلام مما شابه","ويزيل عن غدرانه الأكدارا",73,"ر",2,0],["ويطرُدُ التحصيلَ من خاطري","صهباءُ أو صفراءُ سلسالَهْ",74,"ل",2,0],["وَيُطرِبُهُ صَليلُ البيضِ فَوقَ ال","قَوانِسِ لا البَسيطُ وَلا النَشيدُ",75,"د",1,0],["وَيَطفو عَلى ماءِ الجَمالِ بِوَجهِهِ","حَياءٌ تَظَنّى جاهِلٌ أَنَّهُ كِبرُ",76,"ر",1,0],["ويطرق سمعا بينكم مثل هذه","ويهنيكم طعم الكرى في المحاجر",77,"ر",1,0],["ويُطرِبني في جانبيك حَمائم","لها بين أوراق الغصون عَوِيل",78,"ل",1,0],["ويطبّ من داء طبيب حاذقٌ","متيقّظ وبجسمه سقم",79,"م",1,0],["وَيطيلُ وَصفَ نِزاعِهِ","فَيَزيدُ في شَوقي وَخبلي",80,"ل",2,0],["وَيُطِلُّ الدَهرُ مِن كوَّتِهِ","لِيَراها كَيف تُرمى بِالوُرود",81,"د",1,0],["ويطول هذا ثم يقصر ضده","متعاقبين بحكمة الإيلاج",82,"ج",1,0],["وَيُطْرًونَ الغَنِيَّ فَإِنْ تَرَدَّى","بِفَقْرِ فَهْوَ مَهْجورُ الْمُنَاخِ",83,"خ",1,0],["وَيُطْفِئُ نَارَ الْوَجْدِ مِنِّي بِقَطْرَةٍ","تُمِيتُ الجَوَى مِنْ فَضْلِهِ الْوَابِلِ الْقَطْرِ",84,"ر",1,0],["وَيُطرِبُكَ الشادي بِمدحكَ إِذ تَرى","فَعالَك فيهِ مُجملاً ومفصّلا",85,"ل",2,0],["ويطرب عند سماع الغنا","ويرقص للقرد في دولته",86,"ت",2,0],["ويطمع في نيل السها ولربما","سما كاهلا فوق السماك وحاركا",87,"ك",2,0],["ويُطربهُ على الأوتارِ لحنٌ","وتُسقمهُ إذا سقمت جفون",88,"ن",1,0],["ويُطربُهُ الشعرُ الذي أنا منشدٌ","فيَلهو عن التَسبيحِ والطَلبات",89,"ت",1,0],["وَيُطيلُ فِي حُلَلِ الجَمَالِ تَخايُلاً","فَتَخالُهُ حَلاهُ بَعْضَ حُلاهُ",90,"ا",2,0],["ويَطوي معَ الإصباحِ مَنْشورَ نَشْره","كَما بانَ عَن ربع المُحبّ حَبيبُ",91,"ب",1,0