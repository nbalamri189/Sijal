ِيَ البذلِ",144,"ل",1,0],["ويطمعني أنّني سالمٌ","وداءُ السّلامة لِي أقتَلُ",145,"ل",1,0],["ويُطربن مَن أصغى لهنَّ بسمعِه","كما أطربتْ ذا الخمرِ ألحانُ مَعبدِ",146,"د",1,0],["وَيُطرِبُني إِنْ عنَّ ذكرُك مرّةً","وَلَستُ لِشيءٍ غير ذكراك أطربُ",147,"ب",1,0],["ويطرد عنه كل من تبع الهوى","وتمزيقه ديناً بدنياه راقع",148,"ع",1,0],["ويطيب في أرض الحقيقة غرسنا","لا تعرضوا عنا فهذا أنسنا",149,"ن",2,0],["ويُطِيْلُ أبناءُ الرَّغا","ئِبِ في مسالِكِهِ انتظارَهْ",150,"ر",2,0],["ويُطْوى سجِلُّ الأَرضِ من قبلِ طيِّه","وتنهدِمُ الدنيا وما يُتَهدَّمُ",151,"م",1,0],["ويُطرِبُه صوتُ القِراعِ وإِنَّه","له طَرباتٌ وهْو للقومِ أَهْوَال",152,"ل",1,0],["ويطلعُ فيها الصُّبح والَّليلُ بَعْدَهُ","وفي قلبٍ ذا خوفٌ وفي صدرِ ذَا ذُعْرُ",153,"ر",1,0],["ويُطِيعُ أَمرَكَ أَو يَرى","ما كان صَعْباً غيرَ صَعْب",154,"ب",1,0]]}