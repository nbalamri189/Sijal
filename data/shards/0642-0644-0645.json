?id=202271",""],[5952,"ما ودَّعَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=203725",""],[5956,"كل ما عندك لطفٌ وجَمال","https://www.poetsgate.com/ViewPoem.aspx?id=182049",""],[5957,"يا أيها الوطن المسافر في دمي","https://www.poetsgate.com/ViewPoem.aspx?id=177344",""],[6031,"هَتَفَتْ بِدَمْعِ العَينِ وَهْي سَجُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=46292",""],[6100,"العام في شوفي تزف التباشير","https://www.poetsgate.com/ViewPoem.aspx?id=52552",""],[6220,"القَلمُ الذّهَبيُّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86695&r=&rc=0",""],[6259,"بعثت إليك بطيفها تعليلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59390&r=&rc=38",""],[6259,"حازكِ البينُ حين أصبحت بدراً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59372&r=&rc=20",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""],[6355,"الرمق الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66553&r=&rc=13",""]],"verses":[["قُل ما بَدا لَكَ أَن تَقولَ فَرُبَّما","ساقَ البلاءَ إِلى الفَتى المِقدارُ",0,"ر",1,0],["قَلَمُ الْمَحَاسِنِ خَطَّ نُونَ عِذَارِهِ","أَوَ مِثْلَ حُلَّتِهِ يُحَاكُ بِلاَ عَلَمْ",1,"م",1,1],["قَلَمانِ مَشروعانِ في شِقَّيهِما","وَحيٌ يُفيضُ عَلى أُولي الأَلبابِ",2,"ب",1,0],["قَلَمٌ إِذا رَكِبَ الأَنامِلَ أَو جَرى","سَجَدَت لَهُ الأَقلامُ وَهيَ جَواري",3,"ر",2,1],["قَلَمَ النَّاصِحِ الْجَرْي","ءِ الَّذِي يُوقِظُ الْهِمَمْ",4,"م",1,0],["قلمّ به المسرّات ازدياراً","فتعرفه وتجهله الكروب",5,"ب",1,0],["قلم المرء في بلوغ المعالي","فائق في وغي الحروب جُرازه",6,"ز",2,0],["قلمٌ أخضرُ المرابع لا غرْ","وَ إذا كانَ عيش راجيه رغدا",7,"د",2,0],["قلمي ولفظي معرضان كلاهما","لا من لسانِي إن نطقت ولا يدِي",8,"د",2,0],["قلم ينصُّ على إمامة فضله","فيروقنا بشعاره العباسي",9,"س",2,0],["قلمٌ له في كلِّ يومٍ كريهة","أنباء يجري في جوانبها الدّم",10,"م",1,0],["قلم العذار بوجنتيك جرى","وبسيف لحظك صان كل دم",11,"م",1,1],["قلماً جائلاً إذا خطَّ حرفاً","حمدَ الناسُ رمحه الخطّيّا",12,"ي",2,0],["قلَّ مِنْ خيركم نصيبي ولكنْ","أنا من شَرّكم كثيرُ النصيبِ",13,"ب",1,0],["قلمٌ إذا جَدَح الدَّوَاةَ رأيْتَهُ","لجميع ما تحت السياسَةِ مِجْدَحَا",14,"ح",2,0],["قُلْ ما تَشَاءُ فإنِّي منهُ مُعْتَصمٌ","بِمُدْمَجٍ من حبال العزِّ ممْسُودِ",15,"د",1,0],["قلَّما اعتلّت الخلافةُ إلا","ضمِنُوا بُرْءَها من الأمراضِ",16,"ض",1,0],["قلَّ مقدارُ ما سألتُ من الرز","قِ وإنْ هَوَّلَ احتكامي وهالا",17,"ل",2,0],["قلَّ ما طُلَّتِ الدماءُ اللواتي","سفكَتْها سواكنُ الأطلالِ",18,"ل",1,0],["قلَّ ما توجدُ الفضائل إلا","في خِفاف الرجال دونَ الثقالِ",18,"ل",1,0],["قلَّ ما ينفع الثراءُ بخيلاً","عَلِقَتْ في الثَّرَى المهيلِ رُهونه",19,"ن",2,0],["قلم من خِلقة اللَّ","هِ جليل الطرفين",20,"ن",1,0],["قَلَمٌ يَهمي عَلى أُمَّتِهِ","رَحمَةً إِذ تُمطِرُ الدُنيا شَقا",21,"ق",2,0],["قلم يلعب يوم ال","روع بالرمح الرديني",22,"ن",2,0],["قَلَمٌ جَرى الحِقَبَ الطِوالَ فَما جَرى","يَوماً بِفاحِشَةٍ وَلا بِهِجاءِ",23,"ا",2,0],["قَلَمي وَإِن جَهِلَ الغَبِيُّ مَكانَهُ","أَبقى عَلى الأَحقابِ مِن ماضيكِ",24,"ك",1,0],["قُلُ ما هَويتَ فَإِنَّني","لَكَ سامِعٌ وَالأَمرُ أَمرُك",25,"ك",1,1],["قَلَّما لا تَتَصَبّاني الدِمَن","وَتُعَنّيني بِذِكرى مِن شَجَن",26,"ن",1,1],["قلم الحمرة .. أختاه .. ففي","شرفات الظن، ميعادي معه",27,"ع",2,1],["قَلَّما يَنجو امرُؤٌ مِن فِتنَةٍ","عَجَباً مِمَّن نَجى كَيفَ نَجا",28,"ج",2,0],["قَلَمٌ فَرى كَبِدَ الأُسودِ وَما رَعى","حَقَّ الجِوارِ لَهُنَّ في أَجَماتِها",29,"ت",3,0],["قلمي ما الذي لدي","كَ من الخيرِ يا قلم",30,"م",1,0],["قلمٌ يمشقُ في الطّعنِ فَقُلْ","أمَحَا العيشَ أمِ الموتَ كتب",31,"ب",1,0],["قُل ما بَدا لَكَ يا اِبنَ تُرنا فَالصَدا","بِمُهَذَّبِ العِقيانِ لا يَتَعَلَّقُ",32,"ق",1,0],["قُل ما تَشاءُ بِمَحفِلٍ أَو مَجهَلٍ","وَاِخزُن لِسانَكَ عَن مَقالٍ يوبِقُ",33,"ق",1,1],["قُلْ ما أردتَ فما عليك جُناحُ","أَسُدىً كذلك تذهبُ الأرواحُ",34,"ح",1,1],["قُلْ ما أردتَ ونادِ قومَكَ أَقْبِلوا","مِن حاضرٍ يَخْشَى الإلهَ وبادِ",35,"د",1,0],["قَلَمٌ تَحمِلُ الحَوادِثُ مِنهُ","مِثلَ ما تَحمِلينَ مِن آلامِكْ",36,"ك",1,0],["قُلْ ما تشاءُ فلن يَضيقَ بسائلٍ","يرجو الصَّوابَ وإن ألحَّ وشَدَّدا",37,"د",2,0],["قل ما يُعَلِّمكَ الذي هو عَالِمٌ","أنّ النُّفوسَ إلى الفسادِ نَوازِعُ",38,"ع",1,0],["قلما حاوَلتْ مَدِيحكَ إِلّا","سَاعَدَتْهَا مِيمٌ ودالٌ وحَاءُ",39,"ا",2,0],["قَلمّا يملأُ عيْناً من سَناً","غيرَ ما يملأُ قلباً من كَمدْ",40,"د",1,0],["قَلَّ مَن طابَ لَهُ آباؤُهُ","وَعَلى أُمّاتِهِ حُسنُ الثَنا",41,"ا",1,0],["قُل ما بَدا لَكَ مِن زورٍ وَمِن كَذِبٍ","حِلمي أَصَمُّ وَأُذني غَيرُ صَمّاءِ",42,"ا",2,0],["قَلَّمتُ ظِفرِيَ تاراتٍ وَما جَسَدي","إِلّا كَذاكَ مَتى ما فارَقَ الروحا",43,"ح",2,1],["قُل ماتَشاءُ وَلا تُرهِبكَ عاذِلَةٌ","إِنَّ النِفاقَ لَمَردودٌ إِلى النَفَقِ",44,"ق",1,0],["قُلْ ما بَدا لكَ وافْعلِ","واقْطعْ حِبالكَ أو صِلِ",45,"ل",1,1],["قُلْ ماتَ مُعَنّاكُمْ غراماً وجَوىً","في الحُبّ وما اعتاض عن الرّوح بشَي",46,"ي",1,0],["قلّ من ينظر الحقيقة إلا","مثلما يقتَضيه منه هواه",47,"ه",1,1],["قل مَتى تنتفي الحروب الدوامي","ويشيع السلام بين العباد",48,"د",1,0],["قل ما بدا لك فالصو","ت منك صوت نبيه",49,"ه",1,0],["قل ما تَرى فيه إصلاحا لفاسدهم","فقد يصادف منك القول آذانا",50,"ن",2,0],["قل ما تَراه اليوم حق","قاً في الشئون ولا تبال",51,"ل",1,0],["قلم يبق إلا زوجها وشقيقها","خليل وأما الآخرون فودَّعوا",52,"ع",3,0],["قَلَّ مَن مَاتَ بَعْدَ دَهْرٍ كَمَا م","تَّ وَحَقٌّ عَلَيْهِ لُبْسُ الْحِدَاد",53,"د",1,0],["قَلَّ مَنْ عَاشَ مِثْلَ مَا عِشْتَ","فِي أَنْزَهِ حَالٍ عَنْ رِيبَةٍ وَنفَاقِ",54,"ق",1,0],["قُلِّمَ الشَّوْكُ مِنْ جَوَانِبِهَا وَابْ","تَسَمَتْ فِي مَوَاضِعِ التَّجْرِيدِ",55,"د",1,0],["قلمت أظفار الزما","ن ورعت داهية الخطوب",56,"ب",1,0],["قل ما تشاء؛ فإن الدهر ينقده","تنفي الحصى يدُه، والدرَّ تبقيه",57,"ي",2,0],["قَلِّمْ أظافرَ أيدٍ غيرِ طاهرةٍ","بعد انتصارك مُدَّتْ تَجْمعُ السَّلَبا",58,"ب",2,0],["قلم الفتاة كجفنها","فيما يَريش من النبال",59,"ل",1,0],["قَلم يذود عن الحنيفة تارة","ويذود تارةً الهوانَ عن الحمى",60,"م",2,0],["قلم العقاد سيفٌ باترٌ","لم يجردْهُ ابتغاءَ المنفعة",61,"ع",2,0],["قلمي ساحر القلوب بديع","وبديع الأقلام محض الصريف",62,"ف",1,0],["قلما يكسب انفرادكَ فضلا ً","ومع الاجتماع غرس العقول",63,"ل",1,0],["قَلَّمَا ينجُو امرُوءٌ منْ فتْنَة","ٍ عَجَباً مِمَّن نجَا كَيفَ نَجَا",64,"ج",2,0],["قَلّمَا عَرَّسَ حَتّى هِجْتُهُ","بالتّباشِيرِ مِنَ الصُّبْحِ الأُوَلْ",65,"ل",1,0],["قَلَمٌ سقاهُ فيضُ كفِّك فالتقَت","بيضُ الأماني بين سودِ حُروفه",66,"ف",2,0],["قلَّ ما ينفع الثراءُ بخيلاً","عَلِقَتْ في الثَّرَى المهلِ رُهونه",67,"ن",2,0],["قُل ما تَشاءُ إِذا أَرَدت صِفاتَهُ","فَهُوَ الحري بِكُل وَصفٍ باهي",68,"ي",1,0],["قلّما تسلم منها حبةٌ","خلصتْ من كل عابٍ مَدخَلْ",69,"ل",1,0],["قُلْ ما تقولُ من المَقَا","لَةِ لا يُحَرِّكُنى سَفَاءُ",70,"ا",2,0],["قل ما تشاء فإنني لك طائع","إنَّ المحبَّ بمن يحب لمبتلي",71,"ل",2,0],["قَلَّما ينْفقُ الأَديبُ وَلن ينْ","فقَ إِلاَّ عَلَى ذَوي الآدابِ",72,"ب",1,0],["قُل ما بَدا لَكَ عاذِلاً وَمُناصِحاً","قَدَرُ الهَوى فَأَسيرُهُ لا يُطلَقُ",73,"ق",1,0],["قَلَّما حَمَّلَهُ مِن رَحلِهِ","غَيرَ أَقتادٍ وَقَطعٍ وَقِرابِ",74,"ب",1,0],["قلم تمشَّى في طروسِكَ فانبرتْ","مثلَ الرياضِ وأيمِها المُنْساب",75,"ب",1,0],["قلمي والحياة جزرٌ ومدّ","ومساءٌ يمضي فيأتي صباح",76,"ح",1,0],["قلمي أنت مشرط وزماني","طبّه من جواه هذا السلاح",76,"ح",1,0],["قل من يذكر الحقائق منا","وكذا الجهل والتعصب ينسي",77,"س",2,0],["قلّما باكر الصباح بما س","رّك إلا وساءك الإمساء",78,"ا",2,0],["قلّما يرزق اللبيب فهل يح","سب من رزقه عليه الذكاء",78,"ا",2,0],["قَلمٌ تَصدرُ الحقائِقُ عنه","حالياتٍ في أَجملِ الأَبرادِ",79,"د",1,0],["قُل ما فعلتَ بأيامٍ تُدفِّنُها","والحسنُ والحبُّ ماءٌ غاضَ منبعه",80,"ع",2,0],["قَلم تخيره المهيمن للوَرى","سيفا عَلى الاعداء ليس بمغمد",81,"د",1,0],["قلّما يبرَأ منهوك الحجا","عن هداه بعماه يربَأ",82,"ا",1,0],["قَلَمُ الوَزيرِ هُوَ الشَّقِيقُ لَبيضهِ","والبِيضُ في عَلَقِ النُّفُوسِ شَقيقُ",83,"ق",1,1],["قَلمي بها حتّى الصّباحِ وشَمْعتي","بِتْنا ثلاثتُنا ومَدْحُك شُغْلُنا",84,"ن",2,0],["قَلمي صَحيحٌ إنْ غَدا","قَدمي لسُقْمي في اعْتِقال",85,"ل",1,0],["قَلَمٌ ناحلٌ بيُمْناهُ أَمضَى","من سُيوفٍ بيضٍ بأيمانِ شِجْعه",86,"ع",2,0],["قَلَمٍ يَقلِمُ الخطوبَ ورأْيٍ","بِهما يُبْدِيءُ العُلا ويُعيد",87,"د",1,0],["قلَمٌ ما يزالُ يُردِي عَدُوّاً","بشَبا حَدّهِ ويُعْلي وَدودا",88,"د",2,0],["قُل ما تَشاءُ وَزِد وَبا","لِغ إِنَّكَ الثَبتُ المُحَقِّق",89,"ق",1,0],["قُل ما تَشاءُ