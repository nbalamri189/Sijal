,[406,"إعترافي بعظم فضلك فضل","https://www.aldiwan.net/poem50135.html","الخفيف"],[406,"بعثت إليك بطيفها تعليلا","https://www.aldiwan.net/poem50139.html","الطويل"],[406,"حازك البين حين أصبحت بدرا","https://www.aldiwan.net/poem50175.html","الخفيف"],[406,"إن الحمول غداة غربة غرب","https://www.aldiwan.net/poem50208.html","الكامل"],[416,"ما قضينا حقا لرسم محيل","https://www.aldiwan.net/poem53816.html","الخفيف"],[416,"قل مثلما قد قال عبد الباقي","https://www.aldiwan.net/poem53980.html","الكامل"],[416,"سكب الدمع لها فانسكبا","https://www.aldiwan.net/poem54052.html","الرمل"],[416,"هو البرق مما راعها وشجاها","https://www.aldiwan.net/poem54106.html","الطويل"],[420,"كالخط في كتب الغلام أجاده","https://www.aldiwan.net/poem4859.html","الكامل"],[432,"قل لفخر الأئمة العلم العا","https://www.aldiwan.net/poem12363.html","الخفيف"],[432,"سفرت عنك أوجه الأسفار","https://www.aldiwan.net/poem12416.html","الخفيف"],[432,"وكأنما مدح الأثير أثارها","https://www.aldiwan.net/poem12736.html","الكامل"],[437,"لك ذروة المجد الذي لا يرتقى","https://www.aldiwan.net/poem2535.html","الكامل"],[452,"صح واني نسيمنا باعتلاله","https://www.aldiwan.net/poem13878.html","الخفيف"],[458,"أتراها يوم صدت أن أراها","https://www.aldiwan.net/poem55814.html","الرمل"],[461,"نحن قوم من تميم بن مر","https://www.aldiwan.net/poem16100.html","المديد"],[464,"كم بين أكناف العذيب وحاجر","https://www.aldiwan.net/poem3505.html","عموديه"],[468,"قل من يوجد في الأقوام","https://www.aldiwan.net/poem60457.html","مجزوء الرمل"],[479,"قل معي يا ولدي","https://www.aldiwan.net/poem36926.html","مجزوء الرمل"],[479,"قل ما بدا لك تلق السمع صاغيه","https://www.aldiwan.net/poem37039.html","البسيط"],[500,"قف أيها المفتون فينا واتئد","https://www.aldiwan.net/poem37643.html","الكامل"],[506,"قلم به الاقليم أصبح في حمى","https://www.aldiwan.net/poem2414.html","الكامل"],[543,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[551,"قد هويناه ناقضا للعهود","https://www.aldiwan.net/poem47853.html","الخفيف"],[558,"قلم يجري له النور يد","https://www.aldiwan.net/poem34651.html","الرمل"],[558,"حملت بنا أم من الأرواح","https://www.aldiwan.net/poem34671.html","الكامل"],[558,"هي هذه الحركات والسكنات","https://www.aldiwan.net/poem34703.html","الكامل"],[558,"أنت قيد الوجود إن غبت غابا","https://www.aldiwan.net/poem34952.html","الخفيف"],[558,"وجه تعدد في المرائي","https://www.aldiwan.net/poem35086.html","مجزوء الكامل"],[559,"هل لكم في شرب صهبا مزجت","https://www.aldiwan.net/poem69360.html","الرمل"],[562,"طال ميعادنا فخلناه دهرا","https://www.aldiwan.net/poem52935.html","الخفيف"],[567,"أنا مشغوف بجار","https://www.aldiwan.net/poem69675.html","مجزوء الرمل"],[567,"لا أحب الدواة تخشى يراعا","https://www.aldiwan.net/poem69806.html","الخفيف"],[575,"سلام عليه لا على الدهر بعده","https://www.aldiwan.net/poem3075.html","الطويل"]],"verses":[["قُل ما بَدا لَكَ أَن تَقولَ فَرُبَّما","ساقَ البلاءَ إِلى الفَتى المِقدارُ",0,"ر",1,0],["قَلَمُ الْمَحَاسِنِ خَطَّ نُونَ عِذَارِهِ","أَوَ مِثْلَ حُلَّتِهِ يُحَاكُ بِلاَ عَلَمْ",1,"م",1,1],["قَلَمانِ مَشروعانِ في شِقَّيهِما","وَحيٌ يُفيضُ عَلى أُولي الأَلبابِ",2,"ب",1,0],["قَلَمٌ إِذا رَكِبَ الأَنامِلَ أَو جَرى","سَجَدَت لَهُ الأَقلامُ وَهيَ جَواري",3,"ي",1,1],["قَلَمَ النَّاصِحِ الْجَرْي","ءِ الَّذِي يُوقِظُ الْهِمَمْ",4,"م",1,0],["قلمّ به المسرّات ازدياراً","فتعرفه وتجهله الكروب",5,"ب",1,0],["قلم المرء في بلوغ المعالي","فائق في وغي الحروب جُرازه",6,"ز",2,0],["قلمٌ أخضرُ المرابع لا غرْ","وَ إذا كانَ عيش راجيه رغدا",7,"د",2,0],["قلمي ولفظي معرضان كلاهما","لا من لسانِي إن نطقت ولا يدِي",8,"د",2,0],["قلم ينصُّ على إمامة فضله","فيروقنا بشعاره العباسي",9,"س",2,0],["قلمٌ له في كلِّ يومٍ كريهة","أنباء يجري في جوانبها الدّم",10,"م",1,0],["قلم العذار بوجنتيك جرى","وبسيف لحظك صان كل دم",11,"م",1,1],["قلماً جائلاً إذا خطَّ حرفاً","حمدَ الناسُ رمحه الخطّيّا",12,"ي",2,0],["قلَّ مِنْ خيركم نصيبي ولكنْ","أنا من شَرّكم كثيرُ النصيبِ",13,"ب",1,0],["قلمٌ إذا جَدَح الدَّوَاةَ رأيْتَهُ","لجميع ما تحت السياسَةِ مِجْدَحَا",14,"ح",2,0],["قُلْ ما تَشَاءُ فإنِّي منهُ مُعْتَصمٌ","بِمُدْمَجٍ من حبال العزِّ ممْسُودِ",15,"د",1,0],["قلَّما اعتلّت الخلافةُ إلا","ضمِنُوا بُرْءَها من الأمراضِ",16,"ض",1,0],["قلَّ مقدارُ ما سألتُ من الرز","قِ وإنْ هَوَّلَ احتكامي وهالا",17,"ل",2,0],["قلَّ ما طُلَّتِ الدماءُ اللواتي","سفكَتْها سواكنُ الأطلالِ",18,"ل",1,0],["قلَّ ما توجدُ الفضائل إلا","في خِفاف الرجال دونَ الثقالِ",18,"ل",1,0],["قلَّ ما ينفع الثراءُ بخيلاً","عَلِقَتْ في الثَّرَى المهيلِ رُهونه",19,"ن",2,0],["قلم من خِلقة اللَّ","هِ جليل الطرفين",20,"ن",1,0],["قَلَمٌ يَهمي عَلى أُمَّتِهِ","رَحمَةً إِذ تُمطِرُ الدُنيا شَقا",21,"ق",2,0],["قلم يلعب يوم ال","روع بالرمح الرديني",22,"ن",2,0],["قَلَمٌ جَرى الحِقَبَ الطِوالَ فَما جَرى","يَوماً بِفاحِشَةٍ وَلا بِهِجاءِ",23,"ا",2,0],["قَلَمي وَإِن جَهِلَ الغَبِيُّ مَكانَهُ","أَبقى عَلى الأَحقابِ مِن ماضيكِ",24,"ك",1,0],["قُلُ ما هَويتَ فَإِنَّني","لَكَ سامِعٌ وَالأَمرُ أَمرُك",25,"ك",1,1],["قَلَّما لا تَتَصَبّاني الدِمَن","وَتُعَنّيني بِذِكرى مِن شَجَن",26,"ن",1,1],["قلم الحمرة .. أختاه .. ففي","شرفات الظن، ميعادي معه",27,"ع",2,1],["قَلَّما يَنجو امرُؤٌ مِن فِتنَةٍ","عَجَباً مِمَّن نَجى كَيفَ نَجا",28,"ج",2,0],["قَلَمٌ فَرى كَبِدَ الأُسودِ وَما رَعى","حَقَّ الجِوارِ لَهُنَّ في أَجَماتِها",29,"ت",3,0],["قلمي ما الذي لدي","كَ من الخيرِ يا قلم",30,"م",1,0],["قلمٌ يمشقُ في الطّعنِ فَقُلْ","أمَحَا العيشَ أمِ الموتَ كتب",31,"ب",1,0],["قُل ما بَدا لَكَ يا اِبنَ تُرنا فَالصَدا","بِمُهَذَّبِ العِقيانِ لا يَتَعَلَّقُ",32,"ق",1,0],["قُل ما تَشاءُ بِمَحفِلٍ أَو مَجهَلٍ","وَاِخزُن لِسانَكَ عَن مَقالٍ يوبِقُ",33,"ق",1,1],["قُلْ ما أردتَ فما عليك جُناحُ","أَسُدىً كذلك تذهبُ الأرواحُ",34,"ح",1,1],["قُلْ ما أردتَ ونادِ قومَكَ أَقْبِلوا","مِن حاضرٍ يَخْشَى الإلهَ وبادِ",35,"د",1,0],["قَلَمٌ تَحمِلُ الحَوادِثُ مِنهُ","مِثلَ ما تَحمِلينَ مِن آلامِكْ",36,"ك",1,0],["قُلْ ما تشاءُ فلن يَضيقَ بسائلٍ","يرجو الصَّوابَ وإن ألحَّ وشَدَّدا",37,"د",2,0],["قل ما يُعَلِّمكَ الذي هو عَالِمٌ","أنّ النُّفوسَ إلى الفسادِ نَوازِعُ",38,"ع",1,0],["قلما حاوَلتْ مَدِيحكَ إِلّا","سَاعَدَتْهَا مِيمٌ ودالٌ وحَاءُ",39,"ا",2,0],["قَلمّا يملأُ عيْناً من سَناً","غيرَ ما يملأُ قلباً من كَمدْ",40,"د",1,0],["قَلَّ مَن طابَ لَهُ آباؤُهُ","وَعَلى أُمّاتِهِ حُسنُ الثَنا",41,"ا",1,0],["قُل ما بَدا لَكَ مِن زورٍ وَمِن كَذِبٍ","حِلمي أَصَمُّ وَأُذني غَيرُ صَمّاءِ",42,"ا",2,0],["قَلَّمتُ ظِفرِيَ تاراتٍ وَما جَسَدي","إِلّا كَذاكَ مَتى ما فارَقَ الروحا",43,"ح",2,1],["قُل ماتَشاءُ وَلا تُرهِبكَ عاذِلَةٌ","إِنَّ النِفاقَ لَمَردودٌ إِلى النَفَقِ",44,"ق",1,0],["قُلْ ما بَدا لكَ وافْعلِ","واقْطعْ حِبالكَ أو صِلِ",45,"ل",1,1],["قُلْ ماتَ مُعَنّاكُمْ غراماً وجَوىً","في الحُبّ وما اعتاض عن الرّوح بشَي",46,"ي",1,0],["قلّ من ينظر الحقيقة إلا","مثلما يقتَضيه منه هواه",47,"ه",1,1],["قل مَتى تنتفي الحروب الدوامي","ويشيع السلام بين العباد",48,"د",1,0],["قل ما بدا لك فالصو","ت منك صوت نبيه",49,"ه",1,0],["قل ما تَرى فيه إصلاحا لفاسدهم","فقد يصادف منك القول آذانا",50,"ن",2,0],["قل ما تَراه اليوم حق","قاً في الشئون ولا تبال",51,"ل",1,0],["قلم يبق إلا زوجها وشقيقها","خليل وأما الآخرون فودَّعوا",52,"ع",3,0],["قَلَّ مَن مَاتَ بَعْدَ دَهْرٍ كَمَا م","تَّ وَحَقٌّ عَلَيْهِ لُبْسُ الْحِدَاد",53,"د",1,0],["قَلَّ مَنْ عَاشَ مِثْلَ مَا عِشْتَ","فِي أَنْزَهِ حَالٍ عَنْ رِيبَةٍ وَنفَاقِ",54,"ق",1,0],["قُلِّمَ الشَّوْكُ مِنْ جَوَانِبِهَا وَابْ","تَسَمَتْ فِي مَوَاضِعِ التَّجْرِيدِ",55,"د",1,0],["قلمت أظفار الزما","ن ورعت داهية الخطوب",56,"ب",1,0],["قل ما تشاء؛ فإن الدهر ينقده","تنفي الحصى يدُه، والدرَّ تبقيه",57,"ي",2,0],["قَلِّمْ أظافرَ أيدٍ غيرِ طاهرةٍ","بعد انتصارك مُدَّتْ تَجْمعُ السَّلَبا",58,"ب",2,0],["قلم الفتاة كجفنها","فيما يَريش من النبال",59,"ل",1,0],["قَلم يذود عن الحنيفة تارة","ويذود تارةً الهوانَ عن الحمى",60,"م",2,0],["قلم العقاد سيفٌ باترٌ","لم يجردْهُ ابتغاءَ المنفعة",61,"ع",2,0],["قَلَّمَا ينجُو امرُوءٌ منْ فتْنَة","ٍ عَجَباً مِمَّن نجَا كَيفَ نَجَا",62,"ج",2,0],["قَلّمَا عَرَّسَ حَتّى هِجْتُهُ","بالتّباشِيرِ مِنَ الصُّبْحِ الأُوَلْ",63,"ل",1,0],["قَلَمٌ سقاهُ فيضُ كفِّك فالتقَت","بيضُ الأماني بين سودِ حُروفه",64,"ف",2,0],["قلَّ ما ينفع الثراءُ بخيلاً","عَلِقَتْ في الثَّرَى المهلِ رُهونه",65,"ن",2,0],["قُل ما تَشاءُ إِذا أَرَدت صِفاتَهُ","فَهُوَ الحري بِكُل وَصفٍ باهي",66,"ي",1,0],["قلّما تسلم منها حبةٌ","خلصتْ من كل عابٍ مَدخَلْ",67,"ل",1,0],["قُلْ ما تقولُ من المَقَا","لَةِ لا يُحَرِّكُنى سَفَاءُ",68,"ا",2,0],["قل ما تشاء فإنني لك طائع","إنَّ المحبَّ بمن يحب لمبتلي",69,"ل",2,0],["قَلَّما ينْفقُ الأَديبُ وَلن ينْ","فقَ إِلاَّ عَلَى ذَوي الآدابِ",70,"ب",1,0],["قُل ما بَدا لَكَ عاذِلاً وَمُناصِحاً","قَدَرُ الهَوى فَأَسيرُهُ لا يُطلَقُ",71,"ق",1,0],["قَلَّما حَمَّلَهُ مِن رَحلِهِ","غَيرَ أَقتادٍ وَقَطعٍ وَقِرابِ",72,"ب",1,0],["قلم تمشَّى في طروسِكَ فانبرتْ","مثلَ الرياضِ وأيمِها المُنْساب",73,"ب",1,0],["قلمي والحياة جزرٌ ومدّ","ومساءٌ يمضي فيأتي صباح",74,"ح",1,0],["قلمي أنت مشرط وزماني","طبّه من جواه هذا السلاح",74,"ح",1,0],["قل من يذكر الحقائق منا","وكذا الجهل والتعصب ينسي",75,"ي",1,0],["قلّما باكر الصباح بما س","رّك إلا وساءك الإمساء",76,"ا",2,0],["قلّما يرزق اللبيب فهل يح","سب من رزقه عليه الذكاء",76,"ا",2,0],["قَلمٌ تَصدرُ الحقائِقُ عنه","حالياتٍ في أَجملِ الأَبرادِ",77,"د",1,0],["قُل ما فعلتَ بأيامٍ تُدفِّنُها","والحسنُ والحبُّ ماءٌ غاضَ منبعه",78,"ع",2,0],["قَلم تخيره المهيمن للوَرى","سيفا عَلى الاعداء ليس بمغمد",79,"د",1,0],["قلّما يبرَأ منهوك الحجا","عن هداه بعماه يربَأ",80,"ا",1,0],["قَلَمُ الوَزيرِ هُوَ الشَّقِيقُ لَبيضهِ","والبِيضُ في عَلَقِ النُّفُوسِ شَقيقُ",81,"ق",1,1],["قَلمي بها حتّى الصّباحِ وشَمْعتي","بِتْنا ثلاثتُنا ومَدْحُك شُغْلُنا",82,"ن",2,0],["قَلمي صَحيحٌ إنْ غَدا","قَدمي لسُقْمي في اعْتِقال",83,"ل",1,0],["قَلَمٌ ناحلٌ بيُمْناهُ أَمضَى","من سُيوفٍ بيضٍ بأيمانِ شِجْعه",84,"ع",2,0],["قَلَمٍ يَقلِمُ الخطوبَ ورأْيٍ","بِهما يُبْدِيءُ العُلا ويُعيد",85,"د",1,0],["قلَمٌ ما يزالُ يُردِي عَدُوّاً","بشَبا حَدّهِ ويُعْلي وَدودا",86,"د",2,0],["قُل ما تَشاءُ وَزِد وَبا","لِغ إِنَّكَ الثَبتُ المُحَقِّق",87,"ق",1,0],["قُل ما تَشاءُ وَقَولٌ أَنتَ قائِلُهُ","ما فيهِ ما صَدَّ عَمّا المَرءُ فاعِلُهُ",88,"ل",2,0],["قلَّما دارتِ المَنايا كؤوساً","بين قومٍ إلا وكنتَ المُديرا",89,"ر",2,0],["قُل ما تَشاءُ عن الحياةِ وحُسْنه","وجمالِ ما فيْها مِنَ الأحْلامِ",90,"م",1,0],["قُل ما تَشاءُ عن الحياةِ وحُسْنها","وجمالِ ما فيْها