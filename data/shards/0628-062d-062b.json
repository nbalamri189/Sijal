{"poems":[[32,"ألا يا دار مية بالوحيد","https://www.aldiwan.net/poem29597.html","الوافر"],[32,"ألا أيها الربع الذي غير البلى","https://www.aldiwan.net/poem29602.html","الطويل"],[74,"هددتموا بالضنا من ليس يرتدع","https://www.aldiwan.net/poem19165.html","البسيط"],[93,"يا أيها الشعر أسعفني فأرثيه","https://www.aldiwan.net/poem62808.html","عموديه"],[99,"قالت لميكي سر بنا","https://www.aldiwan.net/poem24870.html","مجزوء الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62279","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54847","المنسرح"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[32,"ألا أيُّها الرَّسمُ الذي غيَّرَ البلى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20510&r=&rc=4",""],[354,"بحث المحق مع العنيد لقوله","https://www.aldiwan.net/poem15833.html","الكامل"],[409,"بنت فكر وافت كشمس النهار","https://www.aldiwan.net/poem33921.html","الخفيف"],[449,"دع عنك صهباء الدساكر","https://www.aldiwan.net/poem56047.html","عموديه"],[457,"أرنت الورق وهنا فوق أبراج","https://www.aldiwan.net/poem13683.html","البسيط"],[534,"بحث تجمع فيه كل شاردة","https://www.aldiwan.net/poem37260.html","البسيط"],[574,"فان يبل الشباب فكل شيء","https://www.aldiwan.net/poem51993.html","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63938","الخفيف"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199580","المسحوب"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138096",""],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125478","الوافر"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125359","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27692","الطويل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132317","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200086","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204642","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91168","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117898","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114050","الخفيف"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147285","الكامل"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113836","الكامل"],[4679,"مرحباً بالكرام أهل الحمَّية","https://www.poetsgate.com/ViewPoem.aspx?id=142757",""],[4859,"كل الدروب يباب!","https://www.poetsgate.com/ViewPoem.aspx?id=197024",""],[4915,"دِينُ المصطفى","https://www.poetsgate.com/ViewPoem.aspx?id=211735",""],[5119,"النرد","https://www.poetsgate.com/ViewPoem.aspx?id=196606",""],[5121,"وَرْدُ النُّورِ","https://www.poetsgate.com/ViewPoem.aspx?id=215141",""],[5363,"كحِّل عيونك إن البدر مكتملُ","https://www.poetsgate.com/ViewPoem.aspx?id=144466",""],[5387,"أعودُ إليكِ","https://www.poetsgate.com/ViewPoem.aspx?id=53780",""],[5431,"عادات ثقيلة ...","https://www.poetsgate.com/ViewPoem.aspx?id=213746",""],[5561,"حبيبتي في الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=192909",""],[5561,"ومضة شوق","https://www.poetsgate.com/ViewPoem.aspx?id=193806",""],[5561,"ضياع قائد عربي","https://www.poetsgate.com/ViewPoem.aspx?id=198048",""],[5764,"حديث نفس","https://www.poetsgate.com/ViewPoem.aspx?id=161806",""],[5809,"روح","https://www.poetsgate.com/ViewPoem.aspx?id=205571",""],[5819,"بنت صور","https://www.poetsgate.com/ViewPoem.aspx?id=215659",""],[5851,"سندبادة وزادها الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=175305",""],[5873,"لوحة المعاني","https://www.poetsgate.com/ViewPoem.aspx?id=215792",""],[5937,"شبيهةُ صنعاء","https://www.poetsgate.com/ViewPoem.aspx?id=211806",""],[5937,"حديثٌ مع الله","https://www.poetsgate.com/ViewPoem.aspx?id=211814",""],[5997,"الوفاء","https://www.poetsgate.com/ViewPoem.aspx?id=214219",""],[6003,"عيد الاستقلال","https://www.poetsgate.com/ViewPoem.aspx?id=189045",""],[5309,"أنا من سكر هواهم ثمل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573771",""],[6165,"نشيد الألواح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87256&r=&rc=16",""],[6190,"أتيتُ سهواً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87002&r=&rc=8",""],[6305,"مَنْ يُرينِي الشِّعْر ؟!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87327&r=&rc=0",""],[5001,"جاءت تسيّر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83394&r=&rc=0",""],[6332,"خجل الصّحوُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65172&r=&rc=1",""]],"verses":[["بَحَثنَ جَوانِبَ الأَرطاةِ حَتّى","كَأَنَّ عُروقَها شُعَبُ الوَريدِ",0,"د",1,0],["بَحَثنَ الثَرى تَحتَ الجَنوبِ وَأَسبَلَت","عَلى الأَجنَفِ العُليا غُصونٌ مَوائِدُ",1,"د",1,0],["بحثت عن وصفك الزاكي فنائله","مسلمٌ ومدى علياك ممتنع",2,"ع",1,0],["بَحَثتُ لي عَن مُعَزٍّ يَومَ مَصرَعِهِ","فَلَم أَجِد غَيرَ مَحزونٍ أُعَزّيهِ",3,"ي",2,0],["بحثت عن الإِلف الصغي","ر فلم تجده خلفها",4,"ه",2,0],["بَحْثَ الكَعَابِ لِقُلْبٍ في مَلاَعِبِهَا","وفي اليَدَيْنِ مِنَ الحِنّاءِ تَفْصِيلُ",5,"ل",1,0],["بَحَثْتُ عَنْ طَاقَةٍ أَقَدِّمُهَا","فَلَمْ أَجِدْ طَاقَةً مِنَ الزَّهْرِ",6,"ر",1,1],["بَحَثَ الْمَجْدُ في الْعُصُورِ فَلَمْ","يَلْقَ لَهُ بَيْنَ دَفَّتَيْها نَدِيدَا",7,"د",2,0],["بَحَثْنَ الثَّرَى تَحْتَ الجَنُوبِ وَأَسَبلتْ","على الأجنبِ العليا غصونٌ موائدُ",8,"د",1,0],["بِحثُ المُحِقِّ مَعَ العَنيدِ لِقَولِهِ","كَمُغالِبٍ لِمُغالِبٍ في مالِهِ",9,"ه",1,1],["بحثوا عن صحيحه باجتهاد","وقروه على شيوخ كبار",10,"ر",1,0],["بحثوا عن الأجرام في الا","فلاك وانتبثوا المغاور",11,"ر",1,0],["بحث نخب الكؤوس المثقلات لنا","شدو الغنا بين أفراد وأزواج",12,"ج",1,0],["بَحْثٌ تَجَمَّعَ فيهِ كُلُّ شارِدَةٍ","أَبانَ عَنْ فَضْلِ بَاعٍ غَيْرِ مَفْضُولِ",13,"ل",1,1],["بَحْثٌ يُخَبِّرُ قَبْلَ الخُبْرِ عَنْ صَعبِ ال","أَخْبارِ ما بَيْنَ مَعْلُولٍ ومَقْبُولِ",13,"ل",1,0],["بَحْثٌ غَدَا عَقْدَ إشْكالِ السؤالِ بِهِ","عَلَى مُرورِ اللّيالِي غَيْرَ مَحْلولِ",13,"ل",1,0],["بَحْثٌ يُبَرْهِنُ أَنَّ الفَخْرَ مَفْخَرَةٌ","للدِّينِ في عِلْمِ مَعْقُولٍ ومَنْقولِ",13,"ل",1,0],["بحث المجد قد علمت معد","وَنَغلي المجد ان المجد غالِ",14,"ل",1,0],["بحثاً وفحصاً ما يزالُ يضلُّ مِنْ","سَنَنَيْهما البحَّاثُ والفحَّاص",15,"ص",1,0],["بحثّها في الغاية","يوم الهاجع رقد",16,"د",1,0],["بحثت عن الود الصحيح سفاهة","وهيهات ان العالمين قشاعم",17,"م",1,0],["بحثتُ عن الدواءِ فعيلَ صَبري","وضاعف ما أعانيه ملالي",18,"ل",2,0],["بحثُوا العِظامَ وما حَوَت أدوارُها","في الشِّيبِ والإطفالِ والشُّبَّانِ",19,"ن",1,0],["بحثاً يحارُ الطبُّ في تلعيلهِ","عَرَفُوا به ما هيَّةَ الحيوانِ",19,"ن",1,0],["بحثت عن أصل الأمرِ ما أصل كونه","فلاحَ لنا في ذلك البحثِ فيصل",20,"ل",1,0],["بَحَثتُ عن اطوارِ الغرامِ صبابَةً","ولكن لطوري في مداهُ مباحِثُ",21,"ث",1,1],["بحثتم في الجديد لنا كثيراً","وما ابدعتم شيئاً جديدا",22,"د",2,1],["بحثكم يشكل البديهي حتى","ينكر البدر في السما وشروقه",23,"ق",2,0],["بَحثَت عَن علة التأخير في زَمَني","وَالجدّ من شيمي وَالمَجد يعرفني",24,"ن",2,1],["بحثيث سعي لاكتسا","ب الرزق من قاصي النواح",25,"ح",1,0],["بَحَثَت عَن حَتفٍ فَصَارَت كَعَصفِ","وَنَمَى أمنُ الخَمسِ مِن كُلِّ خَوفِ",26,"ف",1,0],["بحث يدور بدورة","الأفلاك أ في زمن الشتاتِ",27,"ت",1,0],["بحث العداة بظلفهم عن حتفهم","وتباهتوا في حومة الهيجاء",28,"ا",2,1],["بحثوا في الأفلاك والطب","والتاريخ أبحاثاً باعتبار حريَّة",29,"ي",2,0],["بحثتُ عنه طويلاً أرتجي فرجاً","ولم أجدْ بعد طولِ الصّبرِ مرتحلا",30,"ل",2,0],["بحثتُ في فلسفاتِ الأرضِ قاطبةً","وعَن دياناتِهم عمَّا سيُنجينا",31,"ن",2,1],["بحثتُ في الدّرجِ هل ضيّعته قلمِي؟","أو ربّما وردةٌ أنسى ويُنسيها",32,"ي",3,0],["بَحَثْتُ فِي صَحْوَتِي عَنْ رَوْضِ أُمْسِيَتِي","وَلَمْ أَجِدْ غَيْرَ وَرْدِ الرُّوحِ فِي بَشَرِي",33,"ر",2,0],["بحثت لا لم أجد إلا الجهاد به","خير الدواء وفيه البرء والجذلُ ​",34,"ل",1,0],["بحثتُ بعالم الترحال عن فرح","طفوليٍ يداويخافقي التعب",35,"ب",1,0],["بحثتُ عن الإله وقد توارى","ولم ألحظْه في النفس الذليلة",36,"ل",2,0],["بحثتُ عن مفرداتِ الشّوقِ أنسجُها","قصائدا …وربيعا ما سلوناه",37,"ا",2,0],["بحثتُ عن حلل المعنى وزينته","وعن بيان على أقرانه فخر",38,"ر",1,0],["بحثتُ في خَلَدي عن قائدٍ عربي","في كفِّهِ السيفُ سيفُ الجِدِّ لا اللَعبِ",39,"ب",1,1],["بحثتُ عنهُ ولمّا لم أجدْ أحدا","ناديتُ مُنتفضاً ويلٌ على العربِ",39,"ب",1,0],["بحثت ف اول وجيه الناس واقصاها","( ريلام )هاذيك مدري وين الاقيها ؟",40,"ي",3,1],["بحثتُ فلم أجدْ كَهواكَ حجماً","يسدُّ فراغَ حبِّكَ من فؤادي",41,"د",2,1],["بحثت عن الجمال بكل أرض","لأشرب من منابعه المنالا",42,"ل",2,0],["بحثت عني وجدت الشعر خارطة","إلى الحمامة من غابت معازفها",43,"ف",3,0],["بحثت طوال عمري عنك دوماً","جعلت هواك لي كلّ القضية",44,"ي",2,0],["بحثتُ على عينيك في كل فكرةٍ","وقلتُ سآتِي بالذي فيكِ يَفصِلُ",45,"ل",1,0],["بحثتُ وأشكال الوجود تروعني","يئستُ من الأشكال ، هبني جوهرا",46,"ر",2,0],["بَحَثْتُ عَنِ الوَفَاْ فِيْ كُلِّ قَلْبٍ","يَهِزُّ شِغَاْفَهُ بِالحُبِّ لَحْنِي",47,"ن",2,0],["بحثت فى صفحة التاريخ عن وطنى","ماذا سأكتب ماذا سوف أرتجل ؟؟",48,"ل",1,1],["بَحَثت عَنهُم فَأَعياها السُّرى","وَهيَ لَيسَت لِحِماهُم تَصِلُ",49,"ل",1,0],["بحثتُ عن جسدٍ ثانٍ أحلُّ به","كينونتي وحدتي..أحيا وأحتضرُ",50,"ر",1,0],["بحثتُ عنِ الحقيقةِ لم أجِدْها","فمنْ وجَدَ الحقيقةَ فَلْيُفِدْني",51,"ن",2,0],["بحثتُ عن الموفينَ علّي أراهمُ","فلمْ أرَ غيرَ الغدر ِفينا مُدبَّرا",52,"ر",2,0],["بحثت عنك طويلا والصبا عبق","وأنهر الحب تروي حرف أشعاري",53,"ر",2,0],["بحثتْ أغنيةٌ عن أصلها","عند عينيكِ فأعماها الدُّوار",54,"ر",1,0]]}