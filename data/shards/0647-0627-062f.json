","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125823","الرمل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119667","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123498","المنسرح"],[4142,"","https://poetry.dctabudhabi.ae/diwan/poem/101325","الكامل"],[4163,"","https://poetry.dctabudhabi.ae/diwan/poem/106736","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102752","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45121","الرمل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83662","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83364","البسيط"],[1012,"فتح جعلان","https://www.poetsgate.com/ViewPoem.aspx?id=124501",""],[4829,"سنيني شيب","https://www.poetsgate.com/ViewPoem.aspx?id=34258",""],[4831,"الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=208040",""],[4578,"قلَ الريحان في الورد أجاد","https://www.poetsgate.com/ViewPoem.aspx?id=49392",""],[4935,"حسن المطالع في صفاء براعة","https://www.poetsgate.com/ViewPoem.aspx?id=129288",""],[5139,"مليط","https://www.poetsgate.com/ViewPoem.aspx?id=68956",""],[5338,"« يا رسول الله خذ بيدي »","https://www.poetsgate.com/ViewPoem.aspx?id=187760",""],[5353,"لعنة قابيل","https://www.poetsgate.com/ViewPoem.aspx?id=212463",""],[5410,"همسات ناعمة","https://www.poetsgate.com/ViewPoem.aspx?id=152343",""],[5431,"مات الحسين وفاض القلب أحزانا","https://www.poetsgate.com/ViewPoem.aspx?id=191499",""],[5442,"ما آذنته بينها أسماء","https://www.poetsgate.com/ViewPoem.aspx?id=114772",""],[5674,"البوح فضاح","https://www.poetsgate.com/ViewPoem.aspx?id=198517",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6102,"مفعول عكسي !!","https://www.poetsgate.com/ViewPoem.aspx?id=185062",""],[6251,"صديقُ المجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76479&r=&rc=19",""],[5126,"صَدْمَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87817&r=&rc=32",""]],"verses":[["هَادِئاً وَادِعاً كَأَنَّ جَسِيمَ الْ","أَمْرِ إِذْ تَلْتَقِيهِ غَيْرُ جَسِيمِ",0,"م",1,0],["هادياً للندى وللعلم ترجى","كلّ يومٍ أقواله وفعاله",1,"ل",2,0],["هادَنَهُ دَهرُهُ وَراهَنَهُ","وَرامَهُ مُنعِماً وَأَرضاهُ",2,"ا",2,0],["هادي البَرايا بِنورِ طَلعَتِهِ","مُحيي الرَعايا بِفَيضِ جَدواهُ",2,"ا",2,0],["هاديهِ جِذعٌ مِنَ الأَراكِ وَما","خَلفَ الصَلا مِنهُ صَخرَةٌ جَلسُ",3,"س",1,0],["هادمُ الأصنامِ من عُمّارِها","كيف تبنِي من ذويكم صنما",4,"م",2,0],["هادئ القَلب مطبق الأَجفان","مُطلق الروح راقد الجُثمان",5,"ن",1,1],["هادي رَشادٍ وبُرْهانٍ ومَوعظَةٍ","وبيِّناتٍ وتوفيقٍ وتسْديد",6,"د",1,0],["هادرات بخطبة المجد بتراء","ويؤذي البلاغة التطويل",7,"ل",1,0],["هادٍ إلى طُرُقِ النجا","ة مؤيد فيها أمين",8,"ن",1,0],["هادٍ إلى طرق الحقيقة مرشد","متأول فيما يحاول راشد",9,"د",1,0],["هادي الأَنامِ مِنَ الضَلالَةِ وَالعَمى","وَمُجيرُها مِن جاحِمِ النيرانِ",10,"ن",1,0],["هاد هداني إلى جمالٍ","من النضار النفيس أغلى",11,"ل",2,0],["هادِئَةٌ كَالنَهَرِ الهادىءِ","تحلُمُ في خُضرَةِ أَوراقِها",12,"ه",2,0],["هادي الدعاة ابي الغاراتِ خير فَتىً","أَدنى عَطيّاتِه أَقصى أَمانيكا",13,"ك",2,0],["هادٍ لِقَصْدِ أبيهِ المُرْتَضى عَلَماً","لِجَبر ما انهاضَ أو إِصْلاح ما مَرِجا",14,"ج",2,0],["هادراً يخفِقُ بالرأْسِ كمنْ","يقرأُ الآيَ بتقوى وَصلاح",15,"ح",1,0],["هادٍ ضِياءٌ مُنيرٌ فاصِلٌ فَلَجٌ","قَضاؤُهُ سُنَّةٌ وَقَولُهُ مَثَلُ",16,"ل",1,0],["هاد هدى اللَه رب العالمين به","أهل الضلالة من غاوٍ وحيران",17,"ن",1,0],["هادي الهُداةِ بعِلْمِه العَلَمُ الذي","فضَل الأنامَ مَقامُه المَحْمود",18,"د",1,0],["هادٍ هوادِيَها والليلُ معتكرٌ","بهَدْيِ من أرْشِدَ الإِسْلامُ فِي رَشَدِهْ",19,"د",2,0],["هادي الدعاة كفيل دولتك التي","تهدي إذا ضل السميع المبصر",20,"ر",1,0],["هادي الخلايق محمود الطرايق مأ","مون البوايق خير الخلق كلهمِ",21,"م",1,0],["هاديا مرشدا حفيظا كفيلا","قابل التوب ساترا غفارا",22,"ر",2,0],["هادياً من حكمِ الأشعارِ ما","دونه تَدنو هدايا كلّ هادِ",23,"د",1,0],["هادي الأكرمين للجود طفلا","مرتدي سملة الفحار وليدا",24,"د",2,0],["هاداهم في تحفة","منظومها قد ظُرّفا",25,"ف",2,0],["هادي المختار له كرم","فاق الامطار مع الخلج",26,"ج",1,0],["هادي العباد بايضاح الرشاد لاحراز","السداد وحوز القرب والنعم",27,"م",1,0],["هادي الهُداة سَلِمتَ للإسلامِ","ولشعبك المقدام والإقدامِ",28,"م",1,1],["هادئ السير خافت الصوت لا تس","مع منه إلا أنين العليل",29,"ل",1,0],["هادي المضلِّ إلى سويِّ صراطه","ومعذِّبِ الغاوي بنارِ وَغَاهُ",30,"ا",2,0],["هاداهمُ بنجومِ تَوْمٍ مُشْرِقٍ","يُعْطي الشموسَ المسفراتِ ضياهُ",30,"ا",2,0],["هادون في طول القيام كأنهمذ","بين السواري الجامدات سواري",31,"ر",2,0],["هادي رشاد وبرهان ومعتصم","ولا حب برشاد النهج مسلوك",32,"ك",1,0],["ها دمي في وجنتيك فَلِمْ","عنه قد وَرَّيْتَ بالخَجَل",33,"ل",1,0],["هَادٍ يقوُلُ الحقَّ يُرشِدُ خَلقَهُ","بِكَلاَمِهِ لِلحَقِّ والإِيمَانِ",34,"ن",1,0],["هادِياً فى الشُؤُونِ منه إليه","حيث ما كان فى الوُجُودِ سِواهِ",35,"ا",2,0],["هادنت فيك هموم النفس أصحبها","لعلها هدنة تبنى على دخن",36,"ن",1,0],["هادياً أهل الهداية والصلاح","آح لولا ألمي ما قلت آح",37,"ح",1,0],["هادى الأنام ومهدى الكون أَجمعه","ومن سما الصيد أَقصاها وأَدناها",38,"ا",3,0],["هادي وَهِندي يَنتَهي","بِهِما أُجاجُ المُمْعَدِ",39,"د",1,0],["هادٍ اذا ما ارتقى اعواد منبره","مدَّت لترمته الشعرى هواديها",40,"ي",3,0],["هاد به قد نجا هود واسرته","من مهلك حل في عاد وحزبهم",41,"م",1,0],["هادياً للسعادتين جميعاً","فيه دنيا الفتى وفيه الدين",42,"ن",1,0],["هاد إلى نهج الهدى مهديها","مفيدها الحبر الرضي المرتضى",43,"ض",2,0],["هادم التعليم لا كان الذي","يهدمُ العلياء فينا ويَهُد",44,"د",1,0],["هادِراً عَن شَقاشِق القدم لا يف","ترّ عَنها أَو يخزم الخصماءَ",45,"ا",2,0],["هادماً لِلهَوان حصناً فحصناً","بانياً للعلى رواقاً رواقا",46,"ق",2,0],["هادٍ تنزل في العوالم داعياً","للاهتداء وان ذاك صعود",47,"د",1,0],["هادٍ إلى الرشد للشرع الشريف حمى","يقوم بالواجب الشرعي إذا اتضحا",48,"ح",2,0],["هاد كما قد أسفرت شمسكم","بساطع في الجو وقَّاد",49,"د",1,0],["هَادِ مَنْ أَحْبَبَْتَهُ مَا يَشْتَهِي","فَالهَدَايَا تُورِثُ الحُبَّ الرِّفَلْ",50,"ل",1,0],["هادي أيا شاكرُ يا كريمُ","أكرم لنا بالشكر نستقيمُ",51,"م",1,0],["هادياً من لواقح عاصفاتٍ","ملأت عقوة الثريّا قتاما",52,"م",2,0],["هادِماً ما بَنَوا وَدَهرهُم يَعْ","جَزُ أَن يَهدمَ الَّذي هُو باني",53,"ن",2,0],["هادئاً يلتذُّ في أحلامه","لا يرى للغرب كابوساً مهابا",54,"ب",2,0],["هادٍ ولم أكذب بقولي إنه","هادي الصفيّ لير أم النجدين",55,"ن",1,0],["هاد هدانا الى الرشاد وكم","أهدى الينا بهديه بشرا",56,"ر",2,0],["هاد إلى نهج السبيل ومرشد","أكرم به من مرشد أو هاد",57,"د",1,0],["هادٍ إِلى السَنَنِ القَويمِ وَآخِذٍ","حِجزَ الخَلائِقِ عَن شَفيرِ النارِ",58,"ر",1,0],["هادى الخلائق والرشيد ومن دعى","بامين صدق ثم بالمأمون",59,"ن",1,0],["ها دَمي مِن وَخزَةٍ في خَدِّهِ","ظاهِرٌ مِن غَيرِ تَبيينِ حُجَج",60,"ج",1,0],["هادَنوا الخَصمَ مرَّةً بَعد أُخرى","في فِلِسطين يَومَ لِلحَربِ قاموا",61,"م",3,0],["هادي الأَنامِ وَمِصباح الظَلام وَمن","هُوَ المُرَجّى لورّادٍ وَقُصّادِ",62,"د",1,0],["هاديات إلى الرشاد بالسنة","قد يتبعن والقرآنا",63,"ن",2,0],["هادوك خذها واول النصح ترغيب","سيف الفتى نصفه ونصفن ترى كتاب",64,"ب",1,0],["هادي ووَجْدي مِشْعَلا بَيّارَةٍ","وسناءُ شمسٌ قَدْ أطلّتْ تَلْمَعُ",65,"ع",1,0],["هاد بالتوحيد قلبي نحوه","فهداني من سنا خديه هاد",66,"د",1,0],["هاد إلى المولى كذلك مهتد","ومقدم وعزيز قوم عزت",67,"ت",1,0],["هادٍ يضلّ وحيرانٌ يُدلّ وما","طولُ البليّةِ إلا حيرةُ الهادي",68,"د",2,0],["هَادِمِ الأَصْنَامِ مَاحِقِهَا","عَنْ فِنَاءِ البَيْتِ لِلأَبَدِ",69,"د",1,0],["هادنتُ جُرحي رَيثَ أعصِب ُ خافقي","ومرَشّتي في الصّدرِ نغرٌ معتمُ",70,"م",1,0],["هادنتُهُم فاستمرَؤوا شِيَمي","هاجرتُهُم لكنَّهُمْ غَدَروا",71,"ر",3,0],["ها دمعُ جديَ مضنى من تمزقنا","مثل المسيح بكى من كان خوّانا",72,"ن",2,0],["هادي البرية عند ما نذقتهموا","من قبل في لهواتها الأهواء",73,"ا",2,0],["هادنتُ قلبي لعلَّ النبض يرتاح","والروح أرسلتها في إثْر ِ من راحوا",74,"ح",3,1],["هادماً ب( البلاشِفِ )الحمر مجداً","قيصرياً قد واكبتْهُ القرونُ",75,"ن",1,0],["هَادِنْ صُرُوفَ الدَّهرِ مُصْطَبرًا","وكُنْ مَعَ النَّاسِ بِلَا سَأَمِ",76,"م",1,0],["( ها؛ دَبرا؛ كَدَبرا ) ثُمَّ عَوَى","وَافتَرَّ بِنابٍ مَبزولِ",77,"ل",1,0],["هادئ الأعماقِ والأفواق ليس بموارٍ ولا ملتطمِ","إن شِعْري مَعْقِلٌ ساحتهُ حرمٌ ..فيها جلال الحرمٍ",78,"م",1,0],["هادراً أخشى تدفقَهُ","أن يعمَّ البيتَ والآلا",79,"ل",2,0]]}