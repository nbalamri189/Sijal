,[3419,"","https://poetry.dctabudhabi.ae/diwan/poem/130745","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88999","الدوبيت"],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26996","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138700",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138513",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109977","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92160","البسيط"],[3713,"","https://poetry.dctabudhabi.ae/diwan/poem/144951","البسيط"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202349","الكامل"],[3837,"","https://poetry.dctabudhabi.ae/diwan/poem/114692","المجتث"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102985","البسيط"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36565","الدوبيت"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66126","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33247","الكامل"],[4755,"مِلْ أَيُّها المَاءُ واكْبَح سَوْرَةَ الحُطَمَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=197775",""],[4755,"صنعاء والدولار","https://www.poetsgate.com/ViewPoem.aspx?id=200384",""],[4755,"لا غائِمٌ أُفُقِي, ولا صَحْوُ","https://www.poetsgate.com/ViewPoem.aspx?id=202891",""],[4852,"يا عرَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=214452",""],[5005,"ساحة الظلم..","https://www.poetsgate.com/ViewPoem.aspx?id=189344",""],[5012,"ما أوعدك","https://www.poetsgate.com/ViewPoem.aspx?id=26272",""],[5136,"أهواه كالغصن في تثنيه","https://www.poetsgate.com/ViewPoem.aspx?id=121781",""],[5259,"ستودع الله من ودعته ويدي","https://www.poetsgate.com/ViewPoem.aspx?id=186806",""],[5277,"قُمريّةُ الحارات","https://www.poetsgate.com/ViewPoem.aspx?id=202106",""],[5397,"أجريت قلبي بالدموع مذابا","https://www.poetsgate.com/ViewPoem.aspx?id=157905",""],[5612,"حكاية","https://www.poetsgate.com/ViewPoem.aspx?id=191059",""],[5736,"معا يطيب غنائي","https://www.poetsgate.com/ViewPoem.aspx?id=203861",""],[5931,"دمعة الفقد !","https://www.poetsgate.com/ViewPoem.aspx?id=181122",""],[5943,"أماهُ فارثيه( اليتيم)","https://www.poetsgate.com/ViewPoem.aspx?id=50979",""],[5956,"لا عدل في الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=192298",""],[6127,"أعيذك يا سمراء","https://www.poetsgate.com/ViewPoem.aspx?id=188188",""],[6131,"روحي رهينةْ","https://www.poetsgate.com/ViewPoem.aspx?id=189335",""],[6142,"ما أوتيت أنبياء الله قبل من ال","https://www.poetsgate.com/ViewPoem.aspx?id=155711",""],[6211,"تفاهات،تفاهات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78242&r=&rc=11",""]],"verses":[["مَا أَوْبَقَ الأَنْفُسَ إِلاَّ الأَمَلُ","وَهْوَ غُرُورٌ مَا عَلَيْهِ عَمَلٌ",0,"ل",1,1],["ما أوقِدَت نارُ الكِرامِ بِوَهدَةٍ","في المَحلِ إِلّا شَبَّها بِيَفاعِ",1,"ع",1,0],["ما أوقد الدهر نار مُخزية","إلاّ وأنتم لنارها حَطَب",2,"ب",1,0],["ما أَوقَدَ الناسُ مِن نيرانِ مَكرُمَةٍ","إِلّا اِصطَلَينا وَكُنّا موقِدي النارِ",3,"ر",1,0],["ما أوضح الحكم فيها عن إمام هدى","بالعلم متَّزر بالحلم مشتمل",4,"ل",1,0],["ما أوجَبَ العفوَ على سيدٍ","ما لامرئٍ منه سواه مَلاذْ",5,"ذ",1,1],["ما أُولع الدهر في تصرفهِ","بكل زينٍ له ومفتخَرِ",6,"ر",1,0],["ما أوحش الأجرام لم","تمرح بها بيض كواعب",7,"ب",1,0],["ما أَوجُهُ الحَضَرِ المُستَحسَناتُ بِهِ","كَأَوجُهِ البَدَوِيّاتِ الرَعابيبِ",8,"ب",1,0],["ما أَوسَعَ الخَيرَ فَاِبسُط راحَتَيكَ بِهِ","وَكُن كَأَنَّكَ عِندَ الشَرِّ مَغلولُ",9,"ل",1,0],["ما أَوضَحَ الأَمرَ لِلمُلقي بِعِبرَتِهِ","بَينَ التَفَكُّرِ وَالتَجريبِ وَالفِطَنِ",10,"ن",1,0],["ما أَوَّلُ السامينَ بِالعالي وَلا","كُلُّ الجِيادِ دُفِعنَ قَبلُ سَوابِقُ",11,"ق",1,0],["ما أودعَ اللهُ منْ فضلٍ لوالدِهِ","إلا ونحنُ نراهُ في ابنِهِ الآنا",12,"ن",2,0],["ما أَوْجَعَ الذكرَى ويالكِ لوعةً","في قلبِ كل مُوَحِّدٍ تَتَوقَّدُ",13,"د",1,0],["ما أَولَعَ المَوتَ الزُؤامَ بِأُمَّةٍ","تَرجو الحَياةَ مِنَ العَدُوِّ الشاني",14,"ن",2,0],["ما أورثَ الإسلامُ قومَكَ زادهم","خَيراً وكان لهم أجلَّ وأكبرا",15,"ر",2,0],["ما أَولَعَ العَينَينِ بِالوَكفِ","إِذا تَنَحَّت غُرَّةُ الأَنفِ",16,"ف",1,0],["ما أَوسَعَ المَوتَ يَستَريحُ بِهِ الجِس","مُ المُعَنّى وَيَخفُتُ اللَجَبُ",17,"ب",1,0],["ما أَوصَلَ السَيفَ قَطّاعاً لِحامِلِهِ","وَأَبلَغَ الذابِلَ المَوصوفَ بِالخَطَلِ",18,"ل",1,1],["ما أوصل المتأخري","نَ عَن المَدى المشي الوَئيد",19,"د",1,0],["ما أوشكت تنتهي مناحتها","وينتهي من معنيّها عبره",20,"ر",2,0],["ما أوجَبَ العفوَ على سيدٍ","ما لامرىء منه سواه مَلاذْ",21,"ذ",1,1],["ما أَورَدوها قَطُّ إِلّا أُصدِرَت","جَرحى الصُدورِ سَليمَةَ الأَكفالِ",22,"ل",1,0],["ما أوحش الربع مرءا بعد أحمده","وأجدب الأرض مرعا بعد ما رحلا",23,"ل",2,0],["ما أوجبَ الإعراضَ بعدَ الذي","قد كانَ من وصلٍ وإيناسِ",24,"س",1,1],["ما أَوضَحَ الحقَّ إِذا ما اِنجَلى","في حُلَّةِ الحُسنِ وَحليِ البَيان",25,"ن",1,0],["ما أَومَضَت بِاِبتِسامِ البَرقِ سارِيَةٌ","تَحتَ الدُجا وَبَدَت نارٌ عَلى عَلَمِ",26,"م",1,0],["ما أُولُوا القُرْآن إنْ صَدَقُوا","عَزْمَهُم مِن جِيلِ إنْجِيلِ",27,"ل",1,0],["مَا أوْفَدَهُ العُدْوانُ غَدَا","يُطْفيهِ العَدْلُ ويُخْمِدُهُ",28,"د",2,0],["ما أوْضَحَ البُرهانَ إنَّ له العُلى","عادِية والسُّؤدَد الوَضّاحا",29,"ح",2,0],["ما أَودَع السحر في بلاغته","وضمَّن الدرّ شاعِرٌ كلِمَه",30,"م",2,0],["ما أَوغلَ الفكرُ في قَولٍ لمدحته","إِلّا وَجاء بعِقدٍ غير مُنفصمِ",31,"م",1,0],["ما أَومَضَ البَرقُ بَينَ الطَلعِ وَالبانِ","إِلّا وَنابَ الغَوادي دَمعي القاني",32,"ن",2,1],["ما أومض البرق بالجرداء مبتسماً","إلاَّ تكفكف دمع العين وانسجما",33,"م",2,1],["ما أوقدَ ابنُ طُلَيْبِ قطُّ بِدارهِ","نَاراً وكان هلاكُها بالنّارِ",34,"ر",1,0],["ما أَوْضَحَ العُذْرَ لي لو أنهم عَذَروا","وأَجْمَلَ الصَّبْرَ بِي لو أنهم صبروا",35,"ر",3,1],["ما أَوْرَدَتْها من عُدَاتِكَ مَنْهَلاً","إِلّا ابْتَدَرْنَ أَمامَ ذَلِكَ مَشْرَبا",36,"ب",2,0],["ما أَوهبت إِلا وقد سلبت وما","إِن أَضحكت إِلا ثنت ببكاء",37,"ا",2,0],["ما أولعَ الدهرَ بالفسوق إذا","قيلَ له في يمينك الحكمُ",38,"م",1,0],["ما أوضح الحقَّ لو أصبحت ذا بصرٍ","وأفصح الوعظ لو أصبحتَ ذا أذن",39,"ن",1,0],["ما أولعَ الحبَّ بعقل الإنسان","وساجعات ليلها في الأغصان",40,"ن",1,0],["ما أومضَ البرقُ اللموعُ","على رُبا نجدٍ فشامَهْ",41,"م",2,0],["ما أومضَ البرقُ اليمانِ على الغَضا","اِلاّ تشوَّقَ عهدَهُ وتذكَّرا",42,"ر",2,0],["ما أوجفَ الركبُ أو ضلَّ الدليلُ به","اِلاّ وشيَّبَ مِنْ رُكبانِه اللَّمَما",43,"م",2,0],["ما أوحش الدنيا غدية فارقت","قطباً رجى الدنيا عليه تدار",44,"ر",1,0],["ما أَوجَعَ الحُبَّ لِلقُلوبِ وَما","أَبكى شَجاهُ لِلأَعيُنِ الجُمُدِ",45,"د",1,0],["ما أوضح الهدى لهم وأنوره","وأبين الحق لمن تدبره",46,"ه",1,0],["ما أوبقَ اللؤمَ لئيماً كما","أَوبَقَكَ اللؤمَ ولا أوتَغَه",47,"غ",2,0],["ما أَوسَعَتْهُ عيناكَ من نَظَرٍ","فناظرُ الخطبِ عنه مطموس",48,"س",1,0],["ما أَومَضَ البرقُ ما غَنَّت مُطوَّقة","في الرّوضِ ما الأَرض دَرَّ السّحبِ قَد رضَعَت",49,"ت",1,0],["ما أَومَضَ البرقُ وَهبَّت صبا","وَما هَمى الودقُ وَما قَد هَتَن",50,"ن",1,0],["ما أَوعَدَ الصبُّ في هَجرٍ وفي بُعدٍ","إِلّا وَمِن خَوفِهِ قَد صارَ ذا رعشِ",51,"ش",1,0],["ما أوردوا قاصداً في قيظ هاجِرَة","إلا وقصدهمُ أن ينضحوا كبدي",52,"د",2,0],["ما أومضت شعلات سيفك في الوغى","الا علت من شوسها الضوضاء",53,"ا",2,0],["ما اولع القلب بما يجتني","وأفتن العين بما تجتلي",54,"ي",1,0],["ما أوشكت أن تنتهي محنٌ","إلا وجاءت بعدها محنُ",55,"ن",1,0],["ما أَوعَظَ القَبرَ لَو قَبِلنا","مَوعِظَةَ الناطِقِ الصَموت",56,"ت",1,0],["ما أوهن العبد بما عناه","بحق لا إله إلا اللّه",57,"ه",1,0],["ما أومضت سحرا بروق الأبرق","إلا شرقت بدمعي المترقرق",58,"ق",1,1],["ما أومض برقُ ثناياها","إلا وسحاب الدمع همى",59,"م",2,0],["ما أوقد الناس من نار لمكرمة","الا اصطلينا وكنا موقدي النار",60,"ر",1,1],["ما أولد المجد من بكر العلى أسداً","إلّاه أفتك من صمصامه الذكر",61,"ر",1,0],["ما أوجد اللَه في الدنيا سيُعدمه","لا تطمعنّ في وجود ما به عدم",62,"م",1,0],["ما أوجد الرحمن عندك نعمة","إلا وجدت لها لساناً قائلا",63,"ل",2,0],["ما أوجدت نعماك عندي منة","إلا وجدت لها لساناً شاكرا",64,"ر",2,0],["ما أوسع القلبَ إذ آمنت","جوارحي بكلِّ ما يجري",65,"ر",2,0],["ما أوجد الله إنساناً من العلق","إلا ليعلمَ ما فيه من العلق",66,"ق",1,0],["ما أومض بارقٌ ولا هب نسيم","إلا وغدا القلب من الوجد يهيم",67,"م",1,1],["ما أوقدت نار اللحاظ ضريمة","إلا وكنت لها ثجاجا طافي",68,"ف",2,0],["مَا أوحشَ الأوطان لا سكن بها","يسلي ولا كفٍ تجود لمجتدي",69,"د",2,0],["ما أودعوك مع الغرام وودعوا","إلا ليتلف قلبك المشتاق",70,"ق",1,1],["ما اولع الموت بالصحب الاولى رتعوا","به ولوعاً كأن الموت منتجع",71,"ع",1,0],["ما أوسعَ الفرق بين القول نسمعه","بالعقل يسمو وبين العقل يُنزله",72,"ل",2,0],["ما أَورَثَ البَغيُ قَوماً قَبلَهُم رَشدا","بَل يَهلِكون بِهِ في كُلِّ أَزمان",73,"ن",1,0],["ما أَومض البَرق في حِماكُم","إِلا وَقَد شَب في جُلودي",74,"د",2,0],["ما أومضت بك برقة لمؤمل","إلا تلاها منهم الإرعاد",75,"د",1,0],["ما أومضت أيامها حتى مضت","لكن كما الأعراس في سراء",76,"ا",2,0],["مَا أَوْلَعَ الْحُبَّ بِاْلِكرامِ وَمَا","أَوْلَعَ بِاْلَهْجرِ كُلِّ مَحْبُوبِ",77,"ب",1,1],["ما أوجبت تلازم الجزءين","وذات الانفصال دون مين",78,"ن",1,0],["ما أوجبت تنافُزاً بينهما","أقسامُها ثلاثةٌ فلتعلما",78,"م",2,0],["ما أوقح أعمى إن ازدرى ذا عورٍ","الكل حواها فكيف سب النسب",79,"ب",1,0],["ما أُؤَدّي الزَكاةَ إِلّا كَما يُعصَرُ زِق","قٌ مُعَسَّلٌ بِالحِبالِ",80,"ل",1,0],["ما أوقح الأسياف كيف اتخذت","لضربها منه المحيا ملعبا",81,"ب",2,0],["ما أوحى فيه كل في الذك","ر من التعظيم وما أظهر",82,"ر",1,0],["ما أوجبوا باللُبسِ سالبَ أمرهم","إلّا لسلبِ مآكل ولِباسِ",83,"س",1,0],["ما أوبة الأنس من بعد الشباب سِوى","عيشٍ تردّد أنظار الأمصار",84,"ر",1,0],["ما أوسط الخيرَ فابسُطْ راحتيك به","وكن كأنك دون الشَّرِّ مغلول",85,"ل",1,0],["ما أوضع الوفاد إلا خب في","أموالها الجود الصريح وأوضعا",86,"ع",2,0],["ما أوقح المتنبى","فيما حكى وادعاه",87,"ا",2,1],["ما أومضت في الوغى منهم بروق ظبى","إلا وفاض سحاب الهام بالمطر",88,"ر",1,0],["ما أَوقَحَ ذا الوَردَ عَلى الإِطلاقِ","إِذ عارض خَدَّيه لَدى الإِشراقِ",89,"ق",1,1],["ما اوْهنتْ نُوَبُ الايامِ لي هِمَما","ولا ثَنانيَ عنْ وِرْدِ العُلا ثانِ",90,"ن",1,0],["ما أولعَ النومَ المشو","مَ بكلِّ محزونٍ عميدِ",91,"د",1,0],["ما أَوجَعَ الصَّمتَ عَمَّا لا يُطَاقُ، وما","أَشَدَّ أَوجاعَ صَوتٍ لا يُطِيقُ فَمَه",92,"م",2,0],["ما أَوجَعَ الأَحلامَ فيها، إِذا","تَعَمَّدَ المَوجُوعُ نِسيَانَها",93,"ن",3,0],["ما أَوجَعَ الكَلِمَاتِ يَحبِسُها","وَطَنٌ.. ويَحبِسُهُ بِها الشَّكوُ",94,"و",1,0],["ما أوجعَ الفقدَ لو كان الفقيدُ دَمَا","يجري بأوردةٍ أجسادها صُلِبُوا",95,"ب",3,0],["ما أوجع الآلام حين تصيبنا!","والصبر في ألحاظنا ما أروعه!",96,"ع",2,0],["ما أوعدك من يضمن اظروف الزمان","لا تصدقي من قال للدنيا امان",97,"ن",1,1],["ما أوجع القرب للشجي إذا","كان بعيد الفؤاد مشجيه",98,"ي",2,0],["ما أوجعَ البينَ في قلب الكريم غدا","يفارقُ القلب في ثَوْبَيْ مودعه",99,"ع",2,0],["ما أورقتْ فيها الحياةُ خطيئةً","أو جانبتْ وسطيةِ الخطواتِ",100,"ت",1,0],["ما أومضت جذوات قلبي بارقاً","إلا وأرسلت الدموع سحابا",101,"ب",2,0],["ما أوْجَعَ السَّيْرَ في صَحْرا بلا أمَلٍ","يا ضَيْعَةَ النَفْسِ في أقْسى مَعانيها",102,"ي",3,0],["ما أوسع الأحلام لو كنا معا","ويضيق حلمٌ في فضاءِ النائي",103,"ا",3,0],["ما اورقت دمع السما قاعي الجرد","ولا جاد من همس النداما مسايير",104,"ر",1,0],["ماأوسعتْ دربَهُ في وجهِ مبتسمٍ","يهدي له فرحةً بالسَّعدِ تأتيهِ",105,"ي",2,0],["ما أوّل الإرهاب إلا دولة","بنيت على الإرهاب وهي وليدُ",106,"د",1,0],["ما أوحش الدار إن باتت تراقدها","حمى الوساوس ممسوساً بذي فَرَقِ",107,"ق",1,0],["مَا أوصدوا الشطآنَ دونكْ","الشمسُ أنتَ وما يَرونَكْ",108,"ك",1,1],["مَا أوصَدُوا الأحلامَ إلَّا","فتِّحتْ كي لا تخونَكْ",108,"ك",1,0],["ما أوتيت أنبياء الله قبل من ال","آيات إلا وخير الرسل أوتيها",109,"ي",3,1],["ما أَوْقفَ الهجْرُ بأسي،كيف يوقفني؟","لا شيءَ يوقِفُ إن حاربتُ غاراتي",110,"ت",2,0]]}