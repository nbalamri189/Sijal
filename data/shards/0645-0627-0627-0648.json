{"poems":[[77,"ما أوبق الأنفس إلا الأمل","https://www.aldiwan.net/poem36351.html","الرجز"],[71,"ما سر سكان الحمى بمذاع","https://www.aldiwan.net/poem4025.html","الكامل"],[88,"حياكم الله أيها العرب","https://www.aldiwan.net/poem44469.html","المنسرح"],[27,"حيوا المقام وحيوا ساكن الدار","https://www.aldiwan.net/poem5782.html","البسيط"],[72,"من مبلغ علماء الأعصر الأول","https://www.aldiwan.net/poem19527.html","البسيط"],[51,"ما أوجب العفو على سيد","https://www.aldiwan.net/poem61992.html","الوافر"],[51,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[89,"ماذا برقراق السحائب","https://www.aldiwan.net/poem44965.html","مجزوء الكامل"],[43,"من الجآذر في زي الأعاريب","https://www.aldiwan.net/poem9507.html","البسيط"],[49,"طول التعاشر بين الناس مملول","https://www.aldiwan.net/poem63048.html","البسيط"],[49,"إني أرقت وذكر الموت أرقني","https://www.aldiwan.net/poem63163.html","البسيط"],[44,"قرب الحيا وانهل ذاك البارق","https://www.aldiwan.net/poem30393.html","الكامل"],[69,"قد كان أعظمهم زهدا وأرفعهم","https://www.aldiwan.net/poem28003.html","البسيط"],[105,"لا اليوم يومك إذ ولدت ولا الغد","https://www.aldiwan.net/poem41933.html","الكامل"],[105,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[105,"ترك الملوك ملوك كندة وانتحى","https://www.aldiwan.net/poem44009.html","الكامل"],[48,"سقيا لبغداد وأيامها","https://www.aldiwan.net/poem64399.html","السريع"],[46,"من لي أن أقيم في بلد","https://www.aldiwan.net/poem22110.html","السريع"],[46,"ما أوصل السيف قطاعا لحامله","https://www.aldiwan.net/poem23218.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85376","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54327","المنسرح"],[51,"ما أوجَبَ العفوَ على سيدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=28620",""],[144,"ما كان قبلك في الزمان الخالي","https://www.aldiwan.net/poem11802.html","الكامل"],[161,"ما لي ارى الغاب عن وجه الهزبر خلا","https://www.aldiwan.net/poem59005.html","البسيط"],[200,"ما أوجب الإعراض بعد الذي","https://www.aldiwan.net/poem45213.html","السريع"],[226,"شمس المعالي كعقود الجمان","https://www.aldiwan.net/poem55208.html","السريع"],[236,"لولاك يا خير من يمشي على قدم","https://www.aldiwan.net/poem31766.html","البسيط"],[276,"لم يخن في الحب تأويلي","https://www.aldiwan.net/poem25541.html","المديد"],[276,"مرقوم الخد مورده","https://www.aldiwan.net/poem25586.html","المتدارك"],[276,"طلعت عليك مع المساء صباحا","https://www.aldiwan.net/poem25602.html","الكامل"],[298,"عارضه السندسي من رقمه","https://www.aldiwan.net/poem33169.html","المنسرح"],[298,"حسن ابتدائي بذكري جيرة الحرم","https://www.aldiwan.net/poem33180.html","البسيط"],[350,"ما أومض البرق بين الطلع والبان","https://www.aldiwan.net/poem15981.html","البسيط"],[360,"ما أومض البرق بالجرداء مبتسماً","https://www.aldiwan.net/poem809.html",""],[410,"انظر إلى الأيام كيف تقودنا","https://www.aldiwan.net/poem32235.html","الكامل"],[440,"ما أوضح العذر لي لو أنهم عذروا","https://www.aldiwan.net/poem34747.html","البسيط"],[440,"أهلا بمن قهر الملوك ومرحبا","https://www.aldiwan.net/poem34865.html","الكامل"],[442,"الرزء أفجع لو أطلت بكائي","https://www.aldiwan.net/poem14434.html","الكامل"],[459,"من ناصري والزمان لي خصم","https://www.aldiwan.net/poem55862.html","المنسرح"],[465,"كيف السكون من الدنيا إلى سكن","https://www.aldiwan.net/poem3393.html","عموديه"],[465,"ديار هند أقفرت منذ أزمان","https://www.aldiwan.net/poem3492.html","عموديه"],[478,"برق تألق من تهامه","https://www.aldiwan.net/poem15205.html","مجزوء الكامل"],[478,"ألم الفراق نفى الرقاد ونفرا","https://www.aldiwan.net/poem15259.html","الكامل"],[478,"دع عنك ما زخرف الواشي وما زعما","https://www.aldiwan.net/poem15273.html","البسيط"],[516,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[554,"واكبدا أحرق الهوى كبدي","https://www.aldiwan.net/poem68369.html","المنسرح"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["مَا أَوْبَقَ الأَنْفُسَ إِلاَّ الأَمَلُ","وَهْوَ غُرُورٌ مَا عَلَيْهِ عَمَلٌ",0,"ل",1,1],["ما أوقِدَت نارُ الكِرامِ بِوَهدَةٍ","في المَحلِ إِلّا شَبَّها بِيَفاعِ",1,"ع",1,0],["ما أوقد الدهر نار مُخزية","إلاّ وأنتم لنارها حَطَب",2,"ب",1,0],["ما أَوقَدَ الناسُ مِن نيرانِ مَكرُمَةٍ","إِلّا اِصطَلَينا وَكُنّا موقِدي النارِ",3,"ر",1,0],["ما أوضح الحكم فيها عن إمام هدى","بالعلم متَّزر بالحلم مشتمل",4,"ل",1,0],["ما أوجَبَ العفوَ على سيدٍ","ما لامرئٍ منه سواه مَلاذْ",5,"ذ",1,1],["ما أُولع الدهر في تصرفهِ","بكل زينٍ له ومفتخَرِ",6,"ر",1,0],["ما أوحش الأجرام لم","تمرح بها بيض كواعب",7,"ب",1,0],["ما أَوجُهُ الحَضَرِ المُستَحسَناتُ بِهِ","كَأَوجُهِ البَدَوِيّاتِ الرَعابيبِ",8,"ب",1,0],["ما أَوسَعَ الخَيرَ فَاِبسُط راحَتَيكَ بِهِ","وَكُن كَأَنَّكَ عِندَ الشَرِّ مَغلولُ",9,"ل",1,0],["ما أَوضَحَ الأَمرَ لِلمُلقي بِعِبرَتِهِ","بَينَ التَفَكُّرِ وَالتَجريبِ وَالفِطَنِ",10,"ن",1,0],["ما أَوَّلُ السامينَ بِالعالي وَلا","كُلُّ الجِيادِ دُفِعنَ قَبلُ سَوابِقُ",11,"ق",1,0],["ما أودعَ اللهُ منْ فضلٍ لوالدِهِ","إلا ونحنُ نراهُ في ابنِهِ الآنا",12,"ن",2,0],["ما أَوْجَعَ الذكرَى ويالكِ لوعةً","في قلبِ كل مُوَحِّدٍ تَتَوقَّدُ",13,"د",1,0],["ما أَولَعَ المَوتَ الزُؤامَ بِأُمَّةٍ","تَرجو الحَياةَ مِنَ العَدُوِّ الشاني",14,"ن",2,0],["ما أورثَ الإسلامُ قومَكَ زادهم","خَيراً وكان لهم أجلَّ وأكبرا",15,"ر",2,0],["ما أَولَعَ العَينَينِ بِالوَكفِ","إِذا تَنَحَّت غُرَّةُ الأَنفِ",16,"ف",1,0],["ما أَوسَعَ المَوتَ يَستَريحُ بِهِ الجِس","مُ المُعَنّى وَيَخفُتُ اللَجَبُ",17,"ب",1,0],["ما أَوصَلَ السَيفَ قَطّاعاً لِحامِلِهِ","وَأَبلَغَ الذابِلَ المَوصوفَ بِالخَطَلِ",18,"ل",1,1],["ما أوصل المتأخري","نَ عَن المَدى المشي الوَئيد",19,"د",1,0],["ما أوشكت تنتهي مناحتها","وينتهي من معنيّها عبره",20,"ر",2,0],["ما أوجَبَ العفوَ على سيدٍ","ما لامرىء منه سواه مَلاذْ",21,"ذ",1,1],["ما أَورَدوها قَطُّ إِلّا أُصدِرَت","جَرحى الصُدورِ سَليمَةَ الأَكفالِ",22,"ل",1,0],["ما أوحش الربع مرءا بعد أحمده","وأجدب الأرض مرعا بعد ما رحلا",23,"ل",2,0],["ما أوجبَ الإعراضَ بعدَ الذي","قد كانَ من وصلٍ وإيناسِ",24,"س",1,1],["ما أَوضَحَ الحقَّ إِذا ما اِنجَلى","في حُلَّةِ الحُسنِ وَحليِ البَيان",25,"ن",1,0],["ما أَومَضَت بِاِبتِسامِ البَرقِ سارِيَةٌ","تَحتَ الدُجا وَبَدَت نارٌ عَلى عَلَمِ",26,"م",1,0],["ما أُولُوا القُرْآن إنْ صَدَقُوا","عَزْمَهُم مِن جِيلِ إنْجِيلِ",27,"ل",1,0],["مَا أوْفَدَهُ العُدْوانُ غَدَا","يُطْفيهِ العَدْلُ ويُخْمِدُهُ",28,"د",2,0],["ما أوْضَحَ البُرهانَ إنَّ له العُلى","عادِية والسُّؤدَد الوَضّاحا",29,"ح",2,0],["ما أَودَع السحر في بلاغته","وضمَّن الدرّ شاعِرٌ كلِمَه",30,"م",2,0],["ما أَوغلَ الفكرُ في قَولٍ لمدحته","إِلّا وَجاء بعِقدٍ غير مُنفصمِ",31,"م",1,0],["ما أَومَضَ البَرقُ بَينَ الطَلعِ وَالبانِ","إِلّا وَنابَ الغَوادي دَمعي القاني",32,"ن",2,1],["ما أومض البرق بالجرداء مبتسماً","إلاَّ تكفكف دمع العين وانسجما",33,"م",2,1],["ما أوقدَ ابنُ طُلَيْبِ قطُّ بِدارهِ","نَاراً وكان هلاكُها بالنّارِ",34,"ر",1,0],["ما أَوْضَحَ العُذْرَ لي لو أنهم عَذَروا","وأَجْمَلَ الصَّبْرَ بِي لو أنهم صبروا",35,"ر",3,1],["ما أَوْرَدَتْها من عُدَاتِكَ مَنْهَلاً","إِلّا ابْتَدَرْنَ أَمامَ ذَلِكَ مَشْرَبا",36,"ب",2,0],["ما أَوهبت إِلا وقد سلبت وما","إِن أَضحكت إِلا ثنت ببكاء",37,"ا",2,0],["ما أولعَ الدهرَ بالفسوق إذا","قيلَ له في يمينك الحكمُ",38,"م",1,0],["ما أوضح الحقَّ لو أصبحت ذا بصرٍ","وأفصح الوعظ لو أصبحتَ ذا أذن",39,"ن",1,0],["ما أولعَ الحبَّ بعقل الإنسان","وساجعات ليلها في الأغصان",40,"ن",1,0],["ما أومضَ البرقُ اللموعُ","على رُبا نجدٍ فشامَهْ",41,"م",2,0],["ما أومضَ البرقُ اليمانِ على الغَضا","اِلاّ تشوَّقَ عهدَهُ وتذكَّرا",42,"ر",2,0],["ما أوجفَ الركبُ أو ضلَّ الدليلُ به","اِلاّ وشيَّبَ مِنْ رُكبانِه اللَّمَما",43,"م",2,0],["ما أوحش الدنيا غدية فارقت","قطباً رجى الدنيا عليه تدار",44,"ر",1,0],["ما أَوجَعَ الحُبَّ لِلقُلوبِ وَما","أَبكى شَجاهُ لِلأَعيُنِ الجُمُدِ",45,"د",1,0],["ما أوضح الهدى لهم وأنوره","وأبين الحق لمن تدبره",46,"ه",1,0]]}