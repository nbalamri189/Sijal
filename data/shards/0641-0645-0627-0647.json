"الطويل"],[381,"سمعت بأذني رنة السهمِ في قلبي","https://www.aldiwan.net/poem66952.html","الطويل"],[407,"شكت بلسان الحال طول جفاها","https://www.aldiwan.net/poem33365.html","الطويل"],[407,"سلام على الدار التي جمعت شملي","https://www.aldiwan.net/poem33607.html","الطويل"],[407,"نعم قد قضى ربي بما هو كائن","https://www.aldiwan.net/poem34099.html","الطويل"],[407,"عسى توبة تمحى بها كل زلة","https://www.aldiwan.net/poem34112.html","الطويل"],[413,"ولكنني ألقى الحوادث وادعا","https://www.aldiwan.net/poem32183.html","الطويل"],[420,"سقى الله جيرانا بأكناف حاجر","https://www.aldiwan.net/poem53824.html","الطويل"],[420,"عرفت صبابة هذي النياق","https://www.aldiwan.net/poem53927.html","المتقارب"],[420,"سعيت لهذا الملك بالهمة الكبرى","https://www.aldiwan.net/poem53949.html","الطويل"],[441,"أنخ أيها الحادي المطي وسلّم","https://www.aldiwan.net/poem2559.html","الطويل"],[441,"أحقا صددت وخنت الودادا","https://www.aldiwan.net/poem2615.html","المتقارب"],[443,"مكارمك اغتباقي واصطباحي","https://www.aldiwan.net/poem34896.html","الوافر"],[461,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[461,"على أي أخلاقِ الزمان أعاتبه","https://www.aldiwan.net/poem56287.html","الطويل"],[464,"سألت إله العرش رب محمد","https://www.aldiwan.net/poem16158.html","الطويل"],[467,"ألمت نع الظلماء يهدى سلامها","https://www.aldiwan.net/poem3195.html","عموديه"],[467,"تتيه علينا أن وليت ولاية","https://www.aldiwan.net/poem3527.html","عموديه"],[471,"أدر كأس هجرك عنه فقد","https://www.aldiwan.net/poem60077.html","المتقارب"],[471,"أيا قلب خل عنان الهوى","https://www.aldiwan.net/poem60532.html","المتقارب"],[489,"ألا يا قيس لا تسمن درعي","https://www.aldiwan.net/poem461.html",""],[489,"ألا إن عيني بالبكاء تهلل","https://www.aldiwan.net/poem465.html",""],[541,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[554,"تراءت لنا بالأبرقين بروق","https://www.aldiwan.net/poem47376.html","الطويل"],[565,"عنوان كل مديح راسخ القدم","https://www.aldiwan.net/poem52884.html","البسيط"],[578,"جرى دمعه من مسيل الأسيل","https://www.aldiwan.net/poem2885.html","المتقارب"],[1028,"","https://poetry.dctabudhabi.ae/diwan/poem/98030","الطويل"]],"verses":[["فَما هَزِئَت بِقِراكَ الضُيوفُ","وَلا ذَمَّ مَنزِلَكَ النازِلُ",0,"ل",1,0],["فَما هَرَقوا في جَمعِها رِيَّ عامِلٍ","وَلا قَطَعوا في عَقدِها شِبعَ طائِرِ",1,"ر",1,0],["فَما هُوَ لَولا ما أَقولُ بِسامِعٍ","وَلا أَنا لَولا ما يَمُنُّ بِشاعِرِ",1,"ر",1,0],["فما هَبَّ عُلْويُّ الرّياحِ ولا بَدا","سَنا بارِقٍ إلا طَرِبْتُ إِلى هِنْدِ",2,"د",1,0],["فَما هوَ إلا أنْ تحُطَّ رحالَها","بمَثْوَى التّجلّي والشّهودِ بإطْلاقِ",3,"ق",1,0],["فَما هذِهِ ما بَينَ ثَديَيكَ قالَ لي","تَقَعُّرُ صَدري مِن مُحَدَّبِ ظَهرِهِ",4,"ر",2,0],["فَمَا هُوَ بَيْنَ نَفْسِكَ فِي عُلاَهَا","وَدَارَ الخُلْدِ غَيْرُ وُلُوجِ بَابِ",5,"ب",1,0],["فَمَا هُمُ بِأَعَادِينَا خَلائِقُنَا","هِيَ الَّتِي أَصْبَحَتْ أَعْدَى أَعَادِينَا",6,"ن",2,0],["فَمَا هِيَ إِلاَّ لَحْظَةٌ ثُمَّ يَنْقَضِي","فَسُرُّوا بِهَا مَا تَسْتَطِيعُونَ رَيْثَمَا",7,"م",2,0],["فما هي إلا ليلة ونهارها","وما قد دعونا من سلانيك قد لبّى",8,"ب",2,0],["فما هي إلاّ أرض أكرام معشر","من العُرب لم تنبت سوى البطل الندب",9,"ب",1,0],["فما هو إلاّ المَيْن منكم أعانكم","عليه رجال خائنون وأيّدوا",10,"د",3,0],["فما هنّ إلاّ متعة من متاعهم","وأن صنّ عن بَيع لهم وشراء",11,"ا",2,0],["فما هي إلاّ حياة السَوا","م تجول من العيش في نافد",12,"د",1,0],["فما هي إلاّ بعد شربي سُوَيْعة","وقد دبّ من رأسي الطلا في المفارق",13,"ق",1,0],["فما هي إلا خبوةٌ ترتمي بها","إلى ظلمات صبحها غير مسفر",14,"ر",1,0],["فَما هِبتُ الفَرَزدَقَ قَد عَلِمتُم","وَما حَقُّ اِبنِ بَروَعَ أَن يُهابا",15,"ب",2,0],["فما همّها إلا ضعيفٌ تسوسه","بفضل نداها أو قويٌّ تسوده",16,"د",2,0],["فما هو إلا أن تَجرَّ ذُيولها","ليالٍ على آثارِ ذاكَ مَواضي",17,"ض",2,0],["فما هو إلا نسجُك الشعرَ سادراً","وما الشعرُ إلا ضلَّةٌ من ضلالِكا",18,"ك",2,0],["فما هذا التقزُّز من كلامي","وأُمّكَ لم تُقَزَّزْ من أبيكا",19,"ك",2,0],["فما هذا المِطالُ فداكَ أهلي","وباعُكَ بالندى باعٌ طويلُ",20,"ل",1,0],["فَما هُوَ رَأيَكَ قالَ اِقصِر","مَعَ البَردِ لا تَنفَعُ الوَلوَلَه",21,"ه",1,0],["فَما هَزَّني إِلّا حَديثٌ سَمِعتُهُ","عَنِ الغيدِ كَالغيدِ الحِسانِ جَميلُ",22,"ل",1,0],["فَما هُوَ في سَماحَتهِ كَمَعنٍ","وَلَيسَت نوقُهُ لِلذابِحينا",23,"ن",2,0],["فَما هُم بِأَمواتٍ فَنَبكي عَلَيهُمُ","وَلا هُم بِأَحياءِ فَنَرجو التَلاقِيا",24,"ي",2,0],["فَما هُوَ إِلّا نورُ ثَغرٍ لَثَمتُهُ","تَعَلَّقَ في أَطرافِ شَعري فَأَلهَبا",25,"ب",2,0],["فَما هَكَذا أَحبَبتَ مَن كانَ قَبلُها","وَلا هَكَذا فيما مَضى كُنتَ تَفعَلُ",26,"ل",1,0],["فما هو بالواشي على مذهب الهوى","ولا هو في شرع الغرام مريبُ",27,"ب",1,0],["فَما هَتَفا حَتّى نَزا الجَنبُ وَاِنزَوى","فَيا وَيحَ جَنبي كَم يَسيلُ وَكَم يَدمى",28,"م",2,0],["فَما هُوَ بِالواشي عَلى مَذهَبِ الهَوى","وَلا هُوَ في شَرعِ الوِدادِ مُريبُ",29,"ب",1,0],["فما هوَ حتى قادني نحوَك الهوى","على الرغم ما أحسنتُ هَجرا ولا وصلا",30,"ل",2,0],["فما هو إلا البدرُ بعدَ سِرارِهِ","بَدَا وهو مِلْءُ العينِ والقلبُ صاعدُ",31,"د",1,0],["فَما هُوَ إِلّا العَفوُ عَمَّت سَماؤُهُ","أَوِ السَيفُ عُريانُ المَضارِبِ لا يَنبو",32,"ب",2,0],["فَما هُوَ بِالسَهلِ الشَكيمَةِ دونَهُم","وَلا فيهِمِ بِالمُدهِنِ المُتَصَنِّعِ",33,"ع",1,0],["فَما هُوَ تَعريسُ المَطايا وَنَصُّها","وَلَكِنَّهُ حَلُّ العُلا وَرَحيلُها",34,"ل",3,0],["فَما هُوَ إِلّا بائِلٌ مِن مَخافَةٍ","وَآخَرَ مِنهُم ظَلَّ بِالريقِ يَشرَقُ",35,"ق",1,0],["فَما هِيَ إِلّا أَصلُ كُلِّ مَسَرَّةٍ","فَكَم رَوَّحَت هَمّاً وَكَم فَرَّجَت كَربا",36,"ب",2,0],["فما هممتَ بأمْرٍ أو أشرتَ به","إلا وقامتْ له الدنيا على قدمِ",37,"م",1,0],["فَما هَذِهِ الأَحداجُ إِلّا قُلوبنا","حَبائِبُنا فيها سَرائِرُ تُكْتَمُ",38,"م",1,0],["فَما هَضبَتا رَضوى وَلا رُكنُ مُعنِقٍ","وَلا الطَودُ مِن قُدسٍ وَلا أَنفُ يَذبُلا",39,"ل",2,0],["فَما هَبَّتِ الريحُ الجَنوبُ مِنَ اَرضِها","مِنَ اللَيلِ إِلّا بِتُّ لِلريحِ حانِيا",40,"ي",2,0],["فَما هُوَ إِلّا أَن أَراها فَجاءَةً","فَأُبهَتُ حَتّى ما أَكادُ أُجيبُ",41,"ب",1,0],["فما هابوا الفتى والشيخَ فيها","ولا رَحمِوا الرَّضيعَ ولا الجنينا",42,"ن",2,0],["فَما هابَنا مِن جيرَةِ السوءِ هائِبٌ","وَلا سامَنا غَيرَ الهَضيمَةِ سائِمُ",43,"م",1,0],["فما هو إلا أن هوى غير معقب","سِوَى الخزيِ من ذكرٍ لمن كان ذاكرا",44,"ر",2,0],["فما هَمَتِ المُزْنُ حتى هَمى","ولا ابْتَسَمَ البَرْقُ حتى ابتَسَم",45,"م",1,0],["فما هي إلاّ السعدُ وافقَ مطلعاً","وما هي إلاّ الشمسُ زُفَّت إلى البدر",46,"ر",1,0],["فَما هَجَمَ الصَباحُ عَلَيَّ حَتّى","رَأَيتُ الأَرضَ دائِرَةَ الفِجاجِ",47,"ج",1,0],["فَما هُوَ إِلّا الدَهرُ يَأتي بِصَرفِهِ","عَلى كُلِّ مَن يَشقى بِهِ وَيُعادي",48,"د",2,0],["فَما هَذِهِ الأَيّامُ إِلّا نَظائِرٌ","تَساوَت بِها آحادُها وَسُبوتُها",49,"ت",3,0],["فَما هُوَ في سَلَفٍ سائِرٌ","وَلا هُوَ في حِندِسٍ قابِسُ",50,"س",1,0],["فَما هُوَ إِلّا السَهمُ لا كَفَّ عادِياً","وَلا نالَ صَيداً في كِنانَتِهِ السَهمُ",51,"م",1,0],["فَما هنالك بعدٌ","ولا هنالك قبل",52,"ل",1,0],["فما هو غير أن أقبلت حتى","تبدل كل أمر مستحيل",53,"ل",1,0],["فما هُنَّ بعضَ مدادٍ جرى","ولا هُنَّ أختاهُ بعضَ الورقْ",54,"ق",1,0],["فما هو بالملَكِ المستعزِّ","ولكنَّهُ الآدميُّ المَهينْ",55,"ن",1,0],["فَما هُوَ إِلّا أَن أَراها فَجاءَةً","فَأَبهَتُ لا عُرفٌ لَدَيَّ وَلا نَكرُ",56,"ر",1,0],["فَمَا هِيَ إِلَّا أَنْ نَظَرْتُ فُجَاءَةً","بِحُلْوانَ حَيْثُ انْهَارَ وَانْعَقَدَ الرَّمْلُ",57,"ل",1,0],["فَمَا هَذِهِ الدُّنْيَا وَإِنْ جَلَّ قَدْرُهَا","سِوَى مُهْلَةٍ نَأْتِي لَهَا وَنَعُودُ",58,"د",1,0],["فَمَا هُوَ إِلاَّ وَالمُنَى قَدْ غَدتْ لَهُ","ضَنىً وَخلُودُ الصِّيْتِ موْتاً مُعجَّلاَ",59,"ل",2,0],["فَمَا هُوَ بِالسَّاعِي إِلى الشَّرِّ بَادِئاً","وَمَا هُوَ بِالوَاهِي إِذَا دَفَعَ الشَّرَّا",60,"ر",2,0],["فما هو إلاّ مِبْضَعٌ في يمينِه","أطاح بناب الموتِ واستأصل السُّمَا",61,"م",2,0],["فما هو شعرٌ ونثر، ولكن","هو الروح للجسم، وهُو العصب",62,"ب",1,0],["فما هي إلا جدعة الأنف ما شفت","غليلا وجرح لا يزال يغور",63,"ر",1,0],["فما هو في تعجيله البطش عابث","ولا عارضته في التأني موانع",64,"ع",1,0],["فما هيَ غيرُ خاطرةٍ وأُخرى","وإلاّ وَثْبةٌ ثُمَّ انصِباب",65,"ب",1,0],["فما هي أوّلُ مجذومةٍ","مخافةَ عدوى بها تُنتفى",66,"ا",1,0],["فما هي إلا حياة السَّوام","تجول من العيش في نافذ",67,"ذ",1,0],["فما هذا التمادي والتواني","ونبذكم حفائظنا وراء",68,"ا",2,0],["فما هاج قلبي حبيبٌ مَضَى","ولا شاقني بعدُ ريعٌ مُحيلْ",69,"ل",1,0],["فَما هِيَ إِلّا حَوزُ مَن طابَ مَولِداً","وَنَشراً وَأَخباراً وَعِرقاً وَمَنصِبا",70,"ب",2,0],["فما همّتي إلا مقارعة العدا","وهزمي أبطالاً شداداً بأبطالي",71,"ل",2,0],["فَما هُوَ إِلّا الواو في أَحرُفِ العَطفِ","تَبارَكَ مَن بِالماءِ فَجَّرَ كَفَّهُ",72,"ه",1,0],["فَما هُوَ إِلّا مِن جَهَنَّمَ جُنَّةٌ","أَغاثَ بِهِ اللَهُ الوَرى فَهوَ مُزنَةٌ",73,"ه",1,0],["فما هذه يانفس دار إقامة","مقامك في أخرى خذي في بنائها",74,"ا",3,0],["فما هو في الموتى ومن حسناته","خراج له يحيى كما كان في الأحيا",75,"ي",2,0],["فما هو إلا والدٌ لعبيده","ونحن عبيده في مبرته ولدُ",76,"د",1,0],["فما هم إليه حين يعزى بنسبة","وهل كالضحى قطع من الليل مسود",77,"د",1,0],["فما هكذا كنّا لقد كان بيننا","معاملة عن غيرِ هذا الجفا تنبي",78,"ب",2,0],["فما هو إلا رحمة منك أرسلت","بلغنا بها مما نشا الغاية القصوى",79,"ا",1,0],["فما هو الا وسط كفك واقع","بلا ذمة ترعى لديه ولا حما",80,"م",2,0],["فما هو إلا العز والموت دونه","أو الذل إن شئتم أمانا على الشرب",81,"ب",1,0],["فما هتكوا إلاَّ ستورَ نفوسِهم","ولا نقلوا زوراً عليَّ فصُدّقوا",82,"ق",3,0],["فما هو ذا في بابه وخراجها","يساق إليه ما على ظهرها ثقل",83,"ل",1,0],["فما هو في هذا كما قد زعمتم","ولكن إلى التعطيل والشك يذهب",84,"ب",1,0],["فما هُوَ فيما رامَ إلا كباسطٍ","إلى الماءِ كفّيْهِ ليبلغَ فاهُ",85,"ه",1,0],["فَما هَجَرٌ أَمٌّ غَذَتكَ لِبانُها","وَلا الخَطُّ إِذ فارَقتَها لَكَ والِدُ",86,"د",1,0],["فما هو للآفات إلا دَريئةٌ","لوَخزِ رماحٍ أو لرَشْقِ سِهام",87,"م",1,0],["فما هو إلا كأكلِ المريض","لشهوته من أَضَرِّ الطعام",88,"م",1,0],["فما هو إلا يومه ثم في غد","إذا ذاق ماء السؤر صلى وعفرا",89,"ر",2,0],["فما هي إلا كالبئار وماؤها","عذيب ومر والفقرات ومالح",90,"ح",1,0],["فما هي إلا أن أعيش منغَّصاً","لنقضك عهدي أو أموتَ تأسُّفا",91,"ف",2,0],["فما همّهم إلا الدراهم والغنى","ولا شغلهم إلا حساب الدفاتر",92,"ر",1,0],["فما هذه الدنيا بدر اقامة","فما هي الا دار هم ومحنة",93,"ه",1,0],["فما هنّا على الأقدار يوما","ولا أمست بوارقنا نوابى",94,"ب",2,0],["فما همة الحر أو نفسه","تباع على الأرض أو تشترى",95,"ر",2,0],["فما هزَّ 