{"poems":[[104,"سل جنة الشعر ما ألوى بدوحتها","https://www.aldiwan.net/poem32925.html","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141960","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141937","البسيط"],[92,"أمنعم القلب الخلى","https://www.poetsgate.com/ViewPoem.aspx?id=178972",""],[236,"بين العقيق وبين سلع مربع","https://www.aldiwan.net/poem44569.html","الكامل"],[276,"ضربوا الخيام على الكثيب الاخضر","https://www.aldiwan.net/poem52100.html","الكامل"],[473,"يا من يجور علي فيما يحكم","https://www.aldiwan.net/poem59648.html","الطويل"],[543,"حذرته لو ينفع التحذير","https://www.aldiwan.net/poem48135.html","عموديه"],[556,"قل لمن بالجمال والحسن","https://www.aldiwan.net/poem47395.html","مجزوء الخفيف"],[593,"","https://poetry.dctabudhabi.ae/diwan/poem/107092","الرجز"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53809","المنسرح"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108953","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109396","الخفيف"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28507","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74178","الرمل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89087","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33188","الخفيف"],[4968,"مصابيح الدجى 2","https://www.poetsgate.com/ViewPoem.aspx?id=208102",""],[5219,"ليتها","https://www.poetsgate.com/ViewPoem.aspx?id=194757",""],[5363,"الغُسل بنهر الدماء","https://www.poetsgate.com/ViewPoem.aspx?id=144156",""],[5491,"أنت علمتني بألا أبالي","https://www.poetsgate.com/ViewPoem.aspx?id=215041",""],[5762,"إقرأ كتابك","https://www.poetsgate.com/ViewPoem.aspx?id=13131",""],[6102,"بين كلابها وحجاجها ..","https://www.poetsgate.com/ViewPoem.aspx?id=182808",""]],"verses":[["سَل جَنة الشعر ما أَلوى بدوحتها","حَتّى خَلَت مِن ظلال الحُسن وَالطيبِ",0,"ب",1,1],["سل جنة الخلد كم ودت أزهارها","لو استحالت عبيراً في مجامره",1,"ر",2,0],["سل جارةَ السَّدِّ هل في السد من أثَرٍ","لصبّه أم محا الاثارَ ماحيها",2,"ي",3,0],["سل جفنك الوسنان هل","علمت جُفوني ما الوسن",3,"ن",1,0],["سل جبر أمتك الكسيرة إنه","لم يبق في قوس التجلد منزع",4,"ع",1,0],["سل جيرة الجرعى غداة عدت بهم","نزل الرَكائِب في الفَريق المصحر",5,"ر",1,0],["سَل جَهبَذَ الحُبِّ الَّذي اِستَخدَمتَهُ","هَل لي وَفاءٌ عِندَهُ مُتَقَدِّمُ",6,"م",1,0],["سَل جَيشَكَ المَكسورَ عَنهم في الوَغى","يُخبِرك عنهم جَيشُك المَكسورُ",7,"ر",1,0],["سلَّ جسمي بحبِّهِ","وهو في ذاك ما اِشتفى",8,"ف",2,0],["سل جفن عيني مذهما","أهو سحاب قد همل",9,"ل",1,0],["سَلْ جزعي مُذ صددت عن حالي","هل خطر الصبر لي على بالِ",10,"ل",1,1],["سل جيرة البان عن حسناء ناديه","وانشُد فؤادي فعلمي أنه فيه",11,"ي",2,1],["سل جميع القضاة عن مشكلات","أوجبت قبلما رأها الخصاما",12,"م",2,0],["سَل جِلَّقاً عَنهُم وَما صَنَعَت","بِهِم وَعِندَ جُهَينَةَ الخَبَرُ",13,"ر",1,0],["سَل جُيوش الفُرس عَنهُم ما لَقَت","مِن كِرام رَكبوا الخَيل كِراما",14,"م",2,0],["سل جديساً وجرهماً وثموداً","ثم طسماً وأهلَ ذات العماد",15,"د",1,0],["سل جفوني ما جئن بالدمع بدعاً","يا بديع الجمال في الحسن فردا",16,"د",2,0],["سَلْ جسم خالد عن ضنى غزواته","يشهدْ بقمة صبره المعتاد",17,"د",1,0],["سل جميلا ذاق من بثن وقد","حار منها ناظما شعرا رصينا",18,"ن",2,0],["سل جدك الحر في الأهوال كم نسجت","كفاه بالسيف أمجادا وبالأسل ِ",19,"ل",1,0],["سل جنوني ولوعتي وشجوني","وعيوني ودمعَها المتلالي",20,"ل",2,0],["سلْ (جرجرا..) تُنبئكَ عن غضباتها","واستفتِ (شليا) لحظةً.. (وشلعلعا)",21,"ع",2,0],["سَلْ جَيشَ ( هَارون الرَّشيدِ ) بِفَتْحِهِ","دُكَّتْ مَصَاريعٌ على مِزْلاجِها",22,"ج",3,0]]}