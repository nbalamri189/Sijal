{"poems":[[102,"سل جنة الشعر ما ألوى بدوحتها","https://www.aldiwan.net/poem32925.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141960","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141937","البسيط"],[90,"أمنعم القلب الخلى","https://www.poetsgate.com/ViewPoem.aspx?id=178972",""],[231,"بين العقيق وبين سلع مربع","https://www.aldiwan.net/poem44569.html","الكامل"],[271,"ضربوا الخيام على الكثيب الاخضر","https://www.aldiwan.net/poem52100.html","الكامل"],[468,"يا من يجور علي فيما يحكم","https://www.aldiwan.net/poem59648.html","الطويل"],[538,"حذرته لو ينفع التحذير","https://www.aldiwan.net/poem48135.html","عموديه"],[551,"قل لمن بالجمال والحسن","https://www.aldiwan.net/poem47395.html","مجزوء الخفيف"]],"verses":[["سَل جَنة الشعر ما أَلوى بدوحتها","حَتّى خَلَت مِن ظلال الحُسن وَالطيبِ",0,"ب",1,1],["سل جنة الخلد كم ودت أزهارها","لو استحالت عبيراً في مجامره",1,"ر",2,0],["سل جارةَ السَّدِّ هل في السد من أثَرٍ","لصبّه أم محا الاثارَ ماحيها",2,"ي",3,0],["سل جفنك الوسنان هل","علمت جُفوني ما الوسن",3,"ن",1,0],["سل جبر أمتك الكسيرة إنه","لم يبق في قوس التجلد منزع",4,"ع",1,0],["سل جيرة الجرعى غداة عدت بهم","نزل الرَكائِب في الفَريق المصحر",5,"ر",1,0],["سَل جَهبَذَ الحُبِّ الَّذي اِستَخدَمتَهُ","هَل لي وَفاءٌ عِندَهُ مُتَقَدِّمُ",6,"م",1,0],["سَل جَيشَكَ المَكسورَ عَنهم في الوَغى","يُخبِرك عنهم جَيشُك المَكسورُ",7,"ر",1,0],["سلَّ جسمي بحبِّهِ","وهو في ذاك ما اِشتفى",8,"ف",2,0]]}