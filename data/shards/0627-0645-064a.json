ضُها خَطَرٌ عَظيمُ",1,"م",1,1],["أَمينُكَ لَم يَذخَركَ نُصحاً إِذا حَنا","رِجالٌ عَلى الغِشِّ القَديمِ بِأَضلُعِ",2,"ع",1,0],["أَمينُ نَواحي السِرِّ لَم تَسرِ غَدرَةٌ","بِبالي وَلَم أَحفِل بِداعِيَةِ الصَدِّ",3,"د",1,0],["أَميرُ المُؤمِنينَ أَذالَ سَيري","ذُرى هَذي المُعَبَّدَةِ الرِزاحِ",4,"ح",1,0],["أَمينٌ عَلى سِرٍّ وَلَيسَ حَفيظَةً","وَماضٍ عَلى قِرنٍ وَلَيسَ ذُبابُ",5,"ب",1,0],["أَمينُ الغَيبِ لا يوكى حَشاهُ","لِآمِنِهِ عَلى الداءِ العَياءِ",6,"ا",2,0],["أَميلُ بِإِحدى مُقلَتَيَّ إِذا بَدَتْ","إِلَيها وَبالأُخرى أُراعي رَقيبَها",7,"ب",3,0],["أُمَيمَ سَلِي عَني مَعَدّاً وَيَعْرُباً","فَما أَنا عَمَّا يُعْقِبُ المَجْدَ ذاهِلُ",8,"ل",1,1],["أمْ يَملِكونَ سَجايا وُشِّحَتْ كَرَماً","وأُلْهِجَتْ بالمَعالي أيَّ إلهاجِ",9,"ج",1,0],["أَميرَتي لا تَغفِري ذَنبي","فَإِنَّ ذَنبي شِدَّةُ الحُبِّ",10,"ب",1,1],["أميرٌ كأنّ قُمَيْرَ الدُجَى","أفاضَ الضِّياءَ علَى صَفْحَتَيْهِ",11,"ي",2,1],["أميرَ العُلَى لوْلاكَ لمْ تنْبُ رَوْعَةٌ","ولمْ تَعْرِف النّوْمَ العُيونُ الهَواجِعُ",12,"ع",1,0],["أَمِينٌ عَلَى السِّرِّ المَصُونِ مُحَافِظٌ","عَلَى كَتْمِهِ إِنْ ضَاقَ صَدْرٌ بِكتْمَانِ",13,"ن",1,0],["أميرَ الطِّوالِ السُّمْرِ والقُضُبِ البُتْرِ","وحافِظَ دين اللهِ في نازِحِ الثّغْرِ",14,"ر",1,0],["أميرٌ كَفى الإسْلامَ كلَّ عَظيمةٍ","وقدْ شابَ منْ طولِ العَناءِ وَليدُهُ",15,"د",2,0],["أميرَ العُلَى لوْلاكَ أصْبَحَ رَبْعُها","خَلاءً ودِينُ اللهِ وَاهٍ عَمودُهُ",15,"د",2,0],["أَميرَ المؤمِنينَ جُزيتَ خَيراً","أَرِحنا مِن قُباعِ بَني المُغيرَه",16,"ر",2,1],["أَميرانِ كانا صاحِبيَّ كِلاهُما","فَكُلّا جَزاهُ اللَهُ عَنّي بِما عَمِل",17,"ل",1,0],["أَمينِ الشَظى عَبلٍ إِذا القَومُ آنَسوا","مَدى العَينِ شَخصاً كانَ بِالشَخصِ أَبصَرا",18,"ر",2,0],["أَمينَ فارَقتَنا في حينِ حاجَتِنا","إِلى فَتىً لا يَرى لِلمالِ سُلطانا",19,"ن",2,0],["أَمينُ حَسبُكَ ما قَدَّمتَ مِن عَمَلٍ","فَأَنتَ أَرجَحُنا في الحَشرِ ميزانا",19,"ن",2,0],["أَميرَ القَوافي قَد أَتَيتُ مُبايِعاً","وَهَذي وُفودُ الشَرقِ قَد بايَعَت مَعي",20,"ع",2,0],["أَميرَ القَوافي إِن لي مُستَهامَةً","بِمَدحٍ وَمَن لي فيكَ أَن أَبلُغَ المَدى",21,"د",2,0],["أَميرَ المُؤمِنينَ إِلَيكَ نَهوي","عَلى البُختِ الصَلادِمِ وَالعَجومِ",22,"م",1,0],["أَمينُ الصَدرِ يَحفَظُ ما تَوَلّى","كَما يُلفى القَوِيُّ بِهِ النَبيلُ",23,"ل",1,0],["أَمينٌ مُقِرُّ الصَدرِ يَسبِقُ قَولَهُ","بِفِعلٍ فَيَأبى أَن يُخَيَّبَ آمِلُ",24,"ل",1,0],["أمينة تحضن بالساعد","رسم عروس غضة ناهد",25,"د",1,0],["أمينة كالملك الطاهر","مفترة عن لؤلؤ فاخر",25,"ر",1,0],["أَمِيرُ الشِّعْرُ مَا أَسْنَاهُ تَاجاً","حَلِيتَ بِهِ وَمَا أَحْلَى مَحَلَّهْ",26,"ل",2,0],["أَمِيرُ الحِجَى فِي مِثَالٍ بَدَا","فَيَا أَوْلِيَاءَ الحِجَى سَلِّمُوا",27,"م",3,0],["أُمَيةَّ مُا أحبَبَت حُبَّكِ أُيَّماً","وَلا ذَاتَ بَعلٍ فَاِحِلفي لي بِذَلِكِ",28,"ك",1,0],["أميل إذا الأغصان مالت بروضةٍ","أعانق منها القُضْبَ شوقاً لقدِّهِ",29,"د",2,0],["أمير نَمَتْه للمكارم والعلا","جحاجح من كعب كرام المعارق",30,"ق",1,0],["أمين أبي التدليس في القول حاكياً","فتسمعه يروي الحديث كما يجري",31,"ر",2,0],["أَميجاسَ الخَبائِثِ عَدِّ عَنّا","بِضَأنِكَ يا اِبنَ آكِلَةٍ سَلاها",32,"ه",2,1],["أُمّي النَدى مِن جَدا العَبّاسِ إِنَّ لَهُ","بَيتَ المَكارِمِ يَنمي جَدُّهُ صُعُدا",33,"د",2,0],["أَميرُ المُؤمِنينَ قَضى بِعَدلٍ","أَحَلَّ الحِلَّ وَاِجتَنَبَ الحَراما",34,"م",2,0],["أَميرَ المُؤمِنينَ جَمَعتَ ديناً","وَحِلماً فاضِلاً لِذَوي الحُلومِ",35,"م",1,0],["أَميرُ المُؤمِنينَ عَلى صِراطٍ","إِذا اِعوَجَّ المَوارِدُ مُستَقيمِ",35,"م",1,0],["أُميلَت عَلَيهِ قَرقَفٌ بابِلِيَّةٌ","لَها بَعدَ كَأسٍ في العِظامِ هَميمُ",36,"م",1,0],["أَميرٌ عَلَينا رَسولُ المَلي","كِ أَحبِب بِذاكَ إِلَينا أَميرا",37,"ر",2,0],["أمير حاجب ملكٍ غير أنَّ له","نور المهابة يغنيه عن الحجب",38,"ب",1,0],["أميرٌ ما لأهلِ القصدِ صفرٌ","لديهِ ولا لأهل الكبر طيخ",39,"خ",1,0],["أمير على السادات أيّ مقدمٍ","وفي واجب المدَّاح أيّ كبير",40,"ر",1,0],["أمين التقى يكفي من الشكر أنه","يقصر عمَّا أنت مانحه شكري",41,"ي",1,0],["أمين التقى قلبي أمينٌ على الوَلا","إن ارْتبْتُمو فاسْتشهدوه على أمري",41,"ي",1,0],["أمير بني فضل الإله وكلهم","بأقلامه والسيف ناهٍ وآمر",42,"ر",1,0],["أمين العلى والعلم هنئت حجَّةً","وعوْداً لديه الأجر والذكر أجمع",43,"ع",1,1],["أمير حسنٍ كما قلنا أمير تقىً","في الشامِ وهو على شهبائه ملك",44,"ك",1,0],["أميراً إذا قابلت وصفاً ونسبة","ترى الفضل مأثور الصفات ونجله",45,"ل",2,0],["أمين العلى والعلم دعوة ناشئٍ","ببيتك تلقى حيثما كانَ فضله",46,"ه",1,1],["أميل خوف ازْدحام الناس تحطّمها","كأنني مثل بعض الناس سكران",47,"ن",1,0],["أميْري وأنت المرءُ ينجم رأيهُ","فيسري به السارونَ في الظُّلماتِ",48,"ت",1,0],["أميناً على مالِ الملوكِ وفيئِهِم","وسوقِهمُ ليست له حثَراتُ",49,"ت",1,0],["أميّز كل شيءٍ من أموري","سوى أمري لديكِ ففيه لبس",50,"س",1,0],["أميِّزُ أخلاق الكرام فأصطفي","كرائمها والزبد يُنْزع بالمخضِ",51,"ض",1,0],["أمينٌ على مال الملوك كأنه","حِذاراً ونصحاً حيةٌ يتقلْقَلُ",52,"ل",1,0],["أمينٌ في معايبِهِ أمونٌ","سليمُ الأنفِ ليسَ به زُكامُ",53,"م",1,0],["أُمِّي إذاً أمُّك إن لم تكن","مني على مثلِ الطَّياجين",54,"ن",1,0],["أم يرتجي ألا يثيب خسيستي","عند النشيد بضعف ما يغنيني",55,"ن",2,0],["أُمَيَّةُ وَالعاصي وَإِن يَدعُ خالِدٌ","يُجِبهُ هِشامٌ لِلفَعالِ وَنَوفَلُ",56,"ل",1,0],["أَم يَستَمِرَّ عَلى الغَضاضَةِ وَالقَذى","وَالعَيشُ لا يَحلو مَعَ الضَرّاءِ",57,"ا",2,0],["أَميري الَّذي قَد كُنتُ أَسطو بِقِربِهِ","وَكُنتُ عَلى الدُنيا بِهِ أَتَحَكَّمُ",58,"م",1,0],["أَميرٌ لَهُ في الجودِ كُلُّ غَريبَةٍ","بِها يَطرَبُ الراوي إِذا ما تَمَثَّلا",59,"ل",2,0],["أَميرٌ إِذا أَبصَرتَ إِشراقَ وَجهِهِ","فَقُل لِلَيالي تَستَسِرُّ بُدورُها",60,"ر",3,0],["أُمَيمَةُ لا يُخزى نَثاها حَليلَها","إِذا ذُكَرِ النِسوانُ عَفَّت وَجَلَّتِ",61,"ت",1,0],["أَمينُ الصَدرِ يَحفَظُ ما تَوَلّى","بِما يَكفي القَوِيُّ بِهِ النَبيلُ",62,"ل",1,0],["اميرة الفن على","الابداع انت قادره",63,"ر",2,0],["اميرة الفن تحيتي","اليك عاطره",63,"ر",2,0],["اميرة الفن انا من رعاياك","نصبو لشدوك هذا الضاحك الباكي",64,"ي",1,0],["ام يقولون هكذا قد وجدنا","في القديم الآباء والامهات",65,"ت",1,0],["أَميَّةُ نوّلينا منك قرباً","أمية ثم لا تَذَرى النوالا",66,"ل",2,0],["أمي كانت إليه تغدو","إذا أنا طفل ولا تزال",67,"ل",1,1],["أمير المهرجان وددت أنى","أَرى في مهرجانك أو أراعى",68,"ع",2,0],["أمين قريش اختلفت","فجاءته تُحكَّمه",69,"م",2,0],["أمينتيَ الدنيا إذا هي أقب