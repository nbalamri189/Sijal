{"poems":[[57,"قد كنت أشكو هوى نفسي وأظهره","https://www.aldiwan.net/poem26433.html","البسيط"],[32,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[90,"قد صح عزمك والزمان مريض","https://www.aldiwan.net/poem44822.html","الكامل"],[87,"يا غاب بولون ولي","https://www.aldiwan.net/poem63721.html","مجزوء الكامل"],[83,"أما ترى دمه في الطشت حين جرى","https://www.aldiwan.net/poem61375.html","الطويل"],[50,"يا رب مجلس فتيان سموت له","https://www.aldiwan.net/poem10404.html","البسيط"],[50,"نبه نديمي يوسفا","https://www.aldiwan.net/poem64394.html","مجزوء الرجز"],[52,"يا مالك الناس في مسيرهم","https://www.aldiwan.net/poem64869.html","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54532","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141925","السريع"],[124,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[139,"نسمات رأس البر ما أشهاك","https://www.aldiwan.net/poem49120.html","الكامل"],[147,"لا زال ملكك بالعلى مأهولا","https://www.aldiwan.net/poem11789.html","الكامل"],[159,"تركب الروح فيه إذ تركبه","https://www.aldiwan.net/poem55504.html","البسيط"],[183,"تربعت بين المهيد والأحم","https://www.aldiwan.net/poem535.html",""],[287,"يا ملبسي بالصد ثوب السقام","https://www.aldiwan.net/poem32481.html","السريع"],[422,"خذ بالمسرة واغنم لذة الطرب","https://www.aldiwan.net/poem54116.html","البسيط"],[463,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[500,"غضي جفونك يا رياض","https://www.aldiwan.net/poem9883.html","مجزوء الكامل"],[563,"لمائه كلنا أواني","https://www.aldiwan.net/poem33828.html","مخلع البسيط"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126736","الكامل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66654","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63854","السريع"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101993","البسيط"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18439","الرجز"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113954","الكامل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69390","الكامل"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11325","المنسرح"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89359","السريع"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102927","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102958","الطويل"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21536","المنسرح"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90937","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66142","الكامل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204167","الكامل"],[4119,"إن كان لا بد من السكر","https://www.poetsgate.com/ViewPoem.aspx?id=16162",""],[6142,"بنت النبوة أخت الذكر أم هدا","https://www.poetsgate.com/ViewPoem.aspx?id=155741",""],[6304,"في الشام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82502&r=&rc=9",""]],"verses":[["حَتّى إِذا دارُهُ عَنّي بِهِ نَزَحَت","بَقيتُ أَشكو هَوى قَلبي إِلى الريحِ",0,"ح",1,0],["حَتّى إِذا دَوَّمَت في الأَرضِ راجَعَهُ","كِبرٌ وَلَو شاءَ نَجّى نَفسَهُ الهَرَبُ",1,"ب",1,0],["حتى إذا دار الزمان مداره","خاب القريض وعاد وهو جَريض",2,"ض",1,0],["حَتّى إِذا دَعَتِ النَوى","فَتَبَدَّدَ الشَملُ النَضيد",3,"د",1,0],["حَتَّى إذَا دَخَلَت فِي كُمِّهِ يَدُهُ","كَالشَّمسِ غَابَت عنِ الأنظَارِ في الحُجُبِ",4,"ب",1,0],["حَتّى إِذا دَرَجَت في القَومِ وَاِنتَشَرَت","هَمَّت عُيونُهُمُ مِنها بِإِغفاءِ",5,"ا",2,0],["حَتّى إِذا دارَ الكَرى","في مُقلَتَيهِ وَغَفا",6,"ف",2,0],["حَتّى إِذا دَرَّتِ الدَرورُ لَهُ","وَرَغَّثَتهُ الرُواةُ في نَسَبِه",7,"ب",2,0],["حَتَّى إِذَا دُعِيَ الطَّبِيبُ فَجَاءَهُمْ","رَاعَ القُلُوبَ بِنَفْيَ كُلِّ رَجَاءِ",8,"ا",2,0],["حتى إذا دان لها في الهوى","من لم يدن وبايع المشركون",9,"ن",1,0],["حتى إذا دب بعد النوم صاحبه","فالجفن من سكرات الموت سكران",10,"ن",1,0],["حتى إذا دوت الطبولُ فصفقي","ما شئتِ من طربٍ وشاء هواكِ",11,"ك",1,0],["حَتّى إِذا دَلَفَت إِلَيكَ جُموعُهُم","جُمَلاً جَعَلتَ لَها الرَدى تَفصيلا",12,"ل",2,0],["حَتَّى إِذَا دَغْدَغَتْ أَوْتَارَهُ عَبَثاً","تكَلَّمَتْ أَلْسُنٌ مِنْ صَدْرِها فِيهِ",13,"ي",2,0],["حَتّى إِذا دُمَّت بَنيٍّ مُرتَكِم","وَجَعَلَت تَركَبُ أَشرافَ الأَكَم",14,"م",1,0],["حَتّى إِذا دَبَّ مُحاقاً إِلى","تِسعٍ وَعِشرينَ دَنا لالتِئام",15,"م",1,0],["حتَّى إذا دبّروا للحرب أمرهم","وهم عن الرأي والتدبير في حجب",16,"ب",1,0],["حتى إذا دارت رحى بغيهمُ","عليهمُ وسبقَ السيفُ العذَلْ",17,"ل",1,0],["حتى إذا دُعيتْ نَزا","لِ وأزّت الهيجاء أزا",18,"ز",2,0],["حتى إذا دك منه طور","وعاد بالصعق في اكتمان",19,"ن",1,0],["حتّى إذا دَنتِ المنيّة والقضا","تجري له في مسلم الأقدارُ",20,"ر",1,0],["حتى إذا دنت الأسَّنةُ منهمُ","ورَمَوْا فنالَهمُ سِهام المِقْنَبِ",21,"ب",1,0],["حتى إِذا دار بما ساءنا","على الحسينِ القَدَرُ الدائر",22,"ر",1,0],["حتى إذا دحضت بالعنف حجته","وقد تبين في إسنادها الخلل",23,"ل",1,0],["حَتّى إِذا داراكِ أُفقٌ فَاِرجِعي","حَتّى بَدا بَعدَ السُخامِ الأَقرَعِ",24,"ع",1,0],["حتّى إذا دَبَّ الحمولُ كأنّها","أصرامُ عيدانٍ على مِلطاطِ",25,"ط",1,0],["حَتّى إِذا دانَت لَهُ الآفاقُ","وَأَقفَرَت مِن مُصعَبَ العِراقُ",26,"ق",1,0],["حَتّى إِذا دارَ الزَمانُ عَلَيكُمُ","وَأَراكُمُ اليَقَظاتِ كَالأَحلامِ",27,"م",1,0],["حَتّى إِذا دَبَّتِ الحَوادِثُ في","عَظمي وَحَلَّ الزَمانُ مِن عُقَدي",28,"د",2,0],["حتى إذا دارت رحاها به","واستنزل العصم بأيدٍ متين",29,"ن",1,0],["حتى إذا دبت بهم نشوانها","خروا لها موتى وهم أحياء",30,"ا",2,0],["حتى إذا دنت الوفاة من الدجى","والصبح قارن ليلة الميلاد",31,"د",1,0],["حَتى إِذا دانَت الحَوادِثُ مِن","خَطوي وَحلَّ الزمانُ مِن عُقَدي",32,"د",2,0],["حتى إذادانيت أطلس سترها","ارخت ثلاث ذوائب من شعرها",33,"ه",2,0],["حَتَّى اذا دارَ الزَّمانُ اغاثَهُمْ","فَتْحُ الجُدُودِ بِرَحْمَةِ القِرْضاب",34,"ب",1,0],["حتى إذا داع دعاه الى الهوى","أصغى اليه سامعا ومطيعا",35,"ع",2,0],["حتى إذا دارت على شربها","ألحاظها أغنت عن الخمر",36,"ر",1,0],["حتى إذا دخلت تلك الغزالة لل","كناس وانحجبت عن كل مرتقب",37,"ب",1,0],["حتى اذا دالت تساقط فوقها","بأسُ الحديد وقام هذا المسجدُ",38,"د",1,0]]}