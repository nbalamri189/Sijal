{"poems":[[53,"بمجال عزمي يملأ الملوان","https://www.aldiwan.net/poem29659.html","الكامل"],[53,"قعد الراضون بالذل فقم","https://www.aldiwan.net/poem29750.html","الرمل"],[53,"أمبلغي ما أطلب الغزل","https://www.aldiwan.net/poem29910.html","الكامل"],[53,"مثواي إما صهوة أو غارب","https://www.aldiwan.net/poem30756.html","الكامل"],[53,"أي العيون تجانب الأقذاء","https://www.aldiwan.net/poem30780.html","الكامل"],[63,"وظلام قيد العين به","https://www.aldiwan.net/poem45729.html","الرمل"],[63,"ومكاشح نهنهته عن غاية","https://www.aldiwan.net/poem46081.html","الكامل"],[63,"هو طيفها وطروقه تعليل","https://www.aldiwan.net/poem46153.html","الكامل"],[63,"وله تشف وراءه الأشجان","https://www.aldiwan.net/poem46179.html","الكامل"],[63,"خضاب على فودي للدهر ما نضا","https://www.aldiwan.net/poem46185.html","الطويل"],[63,"طرقت فنم على الصباح شروق","https://www.aldiwan.net/poem46208.html","الكامل"],[63,"طرقت ونحن بسرة البطحاء","https://www.aldiwan.net/poem46215.html","الكامل"],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[77,"إن بان منزله وشطت داره","https://www.aldiwan.net/poem36406.html","الكامل"],[77,"سكن الحب فؤادي وعمر","https://www.aldiwan.net/poem36493.html","الرمل"],[77,"خضبتها بعدما لاح المشيب وقد","https://www.aldiwan.net/poem35867.html","البسيط"],[86,"إيه يا ليل هل شهدت المصابا","https://www.aldiwan.net/poem10378.html","الخفيف"],[86,"نعاك النعاة وحم القدر","https://www.aldiwan.net/poem10471.html","المتقارب"],[86,"أخت الكواكب ما رماك","https://www.aldiwan.net/poem10485.html","مجزوء الكامل"],[86,"الشعب يدعو الله يا زغلول","https://www.aldiwan.net/poem68900.html","الكامل"],[10,"يا عين إبكي فارسا","https://www.aldiwan.net/poem21103.html","مجزوء الكامل"],[93,"إهنأ بما أهدى المليك","https://www.aldiwan.net/poem9675.html","عموديه"],[88,"إليك ما شاهدت عيني من العجب","https://www.aldiwan.net/poem44424.html","البسيط"],[88,"أيا سائلا عنا ببغداد إننا","https://www.aldiwan.net/poem44796.html","الطويل"],[88,"وضح الحق واستاقم السبيل","https://www.aldiwan.net/poem45025.html","الطويل"],[27,"بان الخليط برامتين فودعوا","https://www.aldiwan.net/poem5799.html","الكامل"],[37,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[72,"وعدت بطيف خيالها هيفاء","https://www.aldiwan.net/poem18174.html","الكامل"],[72,"بستان حسن لا عدمت قطافه","https://www.aldiwan.net/poem19305.html","الكامل"],[72,"شكوت وبالشكوى إلى غير راحم","https://www.aldiwan.net/poem19575.html","الطويل"],[51,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[51,"فزعت إلى الخضاب فلم تجدد","https://www.aldiwan.net/poem8714.html","الوافر"],[51,"يا ذا الذي كنيته كنيتي","https://www.aldiwan.net/poem64998.html","السريع"],[51,"أتتني عنك المؤيسات فلم ألم","https://www.aldiwan.net/poem65059.html","الطويل"],[51,"أسألت رسم الدارِ أم لم تسأل","https://www.aldiwan.net/poem65978.html","الكامل"],[29,"الكاملبان الشباب وربما عللته","https://www.aldiwan.net/poem6029.html","الكامل"],[29,"بئس الفوارس عند معترك القنا","https://www.aldiwan.net/poem6062.html","الكامل"],[85,"انظر إلى الأقمار كيف تزول","https://www.aldiwan.net/poem62837.html","الكامل"],[85,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[43,"وزيارة عن غير موعد","https://www.aldiwan.net/poem9545.html","مجزوء الكامل"],[43,"الرأي قبل شجاعة الشجعان","https://www.aldiwan.net/poem10580.html","الكامل"],[62,"رطب تراكيبك إن","https://www.aldiwan.net/poem52205.html","مجزوء الرجز"],[62,"لمن في عراص البيد نوق مطاريب","https://www.aldiwan.net/poem52480.html","الطويل"],[45,"كم بالكثيب من اعتراض كثيب","https://www.aldiwan.net/poem11038.html","الكامل"],[45,"لامت ملامة مشفق متعتب","https://www.aldiwan.net/poem11495.html","الكامل"],[45,"يا يوم عرج بل وراءك يا غد","https://www.aldiwan.net/poem63475.html","الكامل"],[45,"عهد لعلوة باللوى قد أشكلا","https://www.aldiwan.net/poem65545.html","الكامل"],[28,"خضبت بجيد الحناء رأسي","https://www.aldiwan.net/poem5273.html","الوافر"],[61,"نوب الزمان قلائد الأعناق","https://www.aldiwan.net/poem51346.html","الكامل"],[61,"بين الشنوف الحمر والأقراط","https://www.aldiwan.net/poem51578.html","البسيط"],[49,"المرء مستأثر بما ملكا","https://www.aldiwan.net/poem62203.html","المنسرح"],[66,"خيال سرى والنجم في القرب راسخ","https://www.aldiwan.net/poem38495.html","الطويل"],[66,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[80,"بك يا صبور القلب هام جزوعه","https://www.aldiwan.net/poem31382.html","الكامل"],[80,"هل كان أودع سر قلب محجرا","https://www.aldiwan.net/poem31438.html","الكامل"],[44,"طلل الجميع لقد عفوت حميدا","https://www.aldiwan.net/poem30553.html","الكامل"],[44,"من سجايا الطلول ألا تجيبا","https://www.aldiwan.net/poem30582.html","الخفيف"],[87,"أقلا ملامي في هوى الشادن الأحوى","https://www.aldiwan.net/poem8196.html","الطويل"],[33,"طربت وهاجتك الديار البلاقع","https://www.aldiwan.net/poem25889.html","الطويل"],[105,"حي الخليل وطف بتلك الدار","https://www.aldiwan.net/poem43086.html","الكامل"],[105,"الله أكبر والإمام محمد","https://www.aldiwan.net/poem43136.html","الكامل"],[81,"خضعت وأمرك الأمر المطاع","https://www.aldiwan.net/poem61464.html","الوافر"],[81,"طاول بجدك فالأقدار عنوان","https://www.aldiwan.net/poem61481.html","البسيط"],[52,"جار هذا الدهر أو آبا","https://www.aldiwan.net/poem27301.html","المديد"],[67,"أزمعوا البين وشدوا الركابا","https://www.aldiwan.net/poem18030.html","المديد"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[75,"كفي فأيسر من مرد عناني","https://www.aldiwan.net/poem69028.html","الكامل"],[75,"الشمس عنه كليلة أجفانها","https://www.aldiwan.net/poem69029.html","الكامل"],[48,"لمن الديار تسربلت ببلاها","https://www.aldiwan.net/poem66196.html","الكامل"],[46,"إذا شئت أن يرضى سجاياك ربها","https://www.aldiwan.net/poem22116.html","الطويل"],[46,"سمعت نعيها صما صمام","https://www.aldiwan.net/poem23631.html","الكامل"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/66003","الخفيف"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9946","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42508","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42601","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42676","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54933","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43916","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43870","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43636","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54308","الخفيف"],[106,"عرش الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=179473",""],[106,"فقيدُ الإسلام!","https://www.poetsgate.com/ViewPoem.aspx?id=179686",""],[106,"زمزم طليعة الأسطول المصري","https://www.poetsgate.com/ViewPoem.aspx?id=179646",""],[90,"لبنان في العراق","https://www.poetsgate.com/ViewPoem.aspx?id=178952",""],[90,"الشاعرية","https://www.poetsgate.com/ViewPoem.aspx?id=650",""],[45,"يا يَوْمُ عَرّجْ بَلْ وَرَاءَكَ يا غَدُ","https://www.poetsgate.com/ViewPoem.aspx?id=31631",""],[46,"إذا شِئتَ أن يَرْضى سجاياكَ ربُّها","https://www.poetsgate.com/ViewPoem.aspx?id=2520",""],[29,"بان الشّبابُ، ورُبّما عَلّلْتُهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17433&r=&rc=6",""]],"verses":[["خُضتَ الظَلامَ إِلَيهِمُ بِسَنابِكٍ","خاضَت قُلوبَ مَواقِدِ النيرانِ",0,"ن",1,0],["خَضَعَ الدَهرُ لَنا ثُمَّ نَبا","وَكَذا الدَهرُ إِذا سافَ عَذَم",1,"م",1,0],["خُضتُ الغِمارَ فَجازَ جُمَّتَها","دوني وَطَبَّقَ ثَوبِيَ البَلَلُ",2,"ل",1,0],["خُضنا الظَلامَ وَكُلُّنا بِجَنانِهِ","ماضٍ عَلى عَجَلِ وَلَيسَ كَواكِبُ",3,"ب",1,0],["خَضَعَت لَكَ الأَعداءُ يَومَ لَقيتَها","جَلداً تُجَرِّدُ لِلمُصابِ عَزاءَ",4,"ا",2,0],["خُضتُهُ وَالدِّرعُ فَوقي وَطَوَتْ","تَحتيَ المُهرَةُ أَجوازَ الفَلا",5,"ا",1,0],["خَضِلِ البَنانِ إِليهِ يُزْجي المُجْتَدي","وَجْنَاءَ أَبْلَى السَّيْرُ ثِنْيَ وَضَينِها",6,"ن",3,0],["خَضِلَتْ بدَجْلَةَ والفُراتِ ذُيولُها","فاهْتزَّ منْ طَرَبٍ إلَيْها النّيلُ",7,"ل",1,0],["خَضَبَتْ مَناسِمَها إِلى عَرَصاتِهِ","خُوصٌ نَماها شِدْقمٌ وجَديلُ",7,"ل",1,0],["خَضَعوا لمَلْثومِ الخُطا عَرَصاتُهُ","للمُعْتَفينَ وللعُلا أوطانُ",8,"ن",1,0],["خِضابٌ على فَوْدَيَّ للدّهْرِ ما نَضا","ومُقْتَبَلٌ مِنْ رَيِّقِ العُمْرِ ما مَضَى",9,"ض",2,1],["خَضِلُ البَنانِ بِنائِلٍ منْ دونِهِ","وَجهٌ يَجولُ البِشْرُ فيهِ طَليقُ",10,"ق",1,0],["خُضْتِ الظَّلامَ ومِن جَبينِكِ يُجْتَلى","صُبْحٌ يَنِمُّ عليكِ بالأضواءِ",11,"ا",2,0],["خَضَبَتْ مَنَاصِلَكَ الْمَفَارِقَ مِنْهُمُ","حِنّا نَجِيعٍ صَبْغُهَا لاَ يَنْصلُ",12,"ل",1,0],["خَضِرُ الجَنابِ سَقى مَعاهِدَهُ الحَيا","وعَلا على كَنْزِ الجَلالِ جِدارُهُ",13,"ر",2,0],["خُضْتَ بحْرَ الحُبِّ والدّمْعِ وهلْ","تُدْرَكُ الآمالُ إلا بالغَرَرْ",14,"ر",1,0],["خضّبْتُها بعْدَما لاحَ المشيبُ وقدْ","جوّزْتُ في العَقْلِ كتْمَ الصُبْح بالغَبَشِ",15,"ش",1,1],["خَضَبَ الشيبُ شَيبَهُم بِسَوادٍ","وَمَحا البيضُ يَومَ مِتَّ الخِضابا",16,"ب",2,0],["خِضَمُّ الحَياةِ بَعيدُ النَجاةِ","فَطوبى لِراكِبِهِ إِن عَبَر",17,"ر",1,0],["خَضَعَت لِإِمرَتِهِ الرِيا","حُ مِنَ الصَبا وَمِنَ الدَبورِ",18,"ر",1,0],["خُضها هُنالِكَ بِاليَقينِ مُدَرَّعاً","وَاللَهُ بِالنَصرِ المُبينِ كَفيلُ",19,"ل",1,0],["خَضَبَ السِنانَ بِطَعنَةٍ","فَالنَفسُ يَحفِزُها النَفَس",20,"س",1,0],["خُضْتَ السِّيَاسَةَ لَمْ تَجُرْ","فِيهَا وَلَمْ تَثُرِ الرِّيَبْ",21,"ب",1,0],["خضعن للسوط حتى أن أعقدها","لو يأمر السوط يغدو مرسل الذنب",22,"ب",1,0],["خضعنا لحكام تجور وقد حلا","بأفواهها من مالنا مَأكل سُحت",23,"ت",1,0],["خضعت فارس لها عن صَغار","وتداعة إيوانها المستطيل",24,"ل",1,0],["خَضَبوا الأَسِنَّةَ وَالأَعِنَّةَ إِنَّهُم","نالوا مَكارِمَ لَم يَنَلها تُبَّعُ",25,"ع",1,0],["خِضَمُونَ أشرَافٌ لَهَاميمُ سَادَةٌ","مَطَاعِيمُ أيسَارٌ إذَا النَّاسُ أَجدَبُوا",26,"ب",3,0],["خضبت بأحمرَ كالنضار معاصماً","كالماءِ فيها رونقٌ وصفاء",27,"ا",2,0],["خضعت لعزَّته الملوك وأذعنت","لأغرّ أمَّله الزمان وخافَهُ",28,"ف",2,0],["خضبت مشيبي بالدموع فما به","ولكن بقلبي للهمومِ نصول",29,"ل",1,0],["خَضَبت رأسَهُ فبات بتَبْري","حٍ وأضحى فظلَّ في تأنيبِ",30,"ب",1,0],["خَضبتَ الشيبَ حين بدا لتُدْعَى","فتىً حَدَثاً ضَلالاً ما ارتَجيْتا",31,"ت",2,0],["خضراء كالعقرب في صُفرةٍ","نمشاءَ كالحيةِ في رُقطه",32,"ط",2,0],["خضعتُ فإن خلتَ الخضوعَ خديعةً","فما زلتُ خدَّاعاً وزلتَ مخدَّعا",33,"ع",2,0],["خضراءُ لونِ الريقِ لو نفثتْ به","مَيْثاء ألقحها الحيا لم تُبْقِلِ",34,"ل",1,0],["خَضلُ الكِئاسِ إِذا تَنَشّى لَم تَكُن","خُلُفاً مَواعِدُهُ كَبَرقِ الخُلَّبِ",35,"ب",1,0],["خُضُعٌ إِلى الطَمَعِ القَليلِ وَرِفدُهُم","عِندَ الهِياجِ لَدى الطِعانِ قَليلُ",36,"ل",1,0],["خَضَعَت لَكُم فيهِ الصُفوفُ وَأُزلِفَت","لَكُمُ الصَلاةُ وَقُرِّبَ التَرتيلُ",37,"ل",1,0],["خَضَبَ الجُندُ بِهِ الأَرضَ دَما","وَقُلوبُ الجُندِ كَالصَخرِ القَسي",38,"ي",1,0],["خَضراءَ حَمراءَ التُرا","بِ كَأَنَّها في خَدِّ أَغيَد",39,"د",1,0],["خَضَعَت لِمُنصُلِكَ المَناصِلُ عَنوَةً","وَأَذَلَّ دينُكَ سائِرَ الأَديانِ",40,"ن",1,0],["خضرته مشوبة","بحمرة من غسقِ",41,"ق",1,0],["خِضَمٌّ له بالأبرقَيْنِ تدافعٌ","كما انهارتِ الكُثبانِ وارتَّجَّتِ اللُّوبُ",42,"ب",1,0],["خُضراً يُساقِطُها الصَبا وَكَأَنَّها","وَرَقٌ يُساقِطُها اِهتِزازُ قَضيبِ",43,"ب",1,0],["خِضرُ بنُ أَحمَدَ طَودُ عِزٍّ شامِخٌ","راسٍ دَعائِمُهُ أَمينُ المَنكِبِ",44,"ب",1,0],["خَضِلُ اليَدَينِ إِذا تَفَرَّقَ في النَدى","جَمَعَ العُلا فيما يُفيدُ وَيُنفِذُ",45,"ذ",1,0],["خَضِلُ الفِناءِ مَتى وَطِئتَ تُرابَهُ","قُلتَ الغَمامُ انهَلَّ فيهِ فَأَسبَلا",46,"ل",2,0],["خَضَبتُ بِجَيِّدِ الحِنّاءِ رَأسي","لِيُعقِبَ حُمرَةً بَعدَ البَياضِ",47,"ض",1,1],["خضراء ينسح الحيا من مزنه","قبل انسكاب سحابه الغيداق",48,"ق",1,0],["خضَعَتْ رِقابُ بَني العَداوَةِ إذ رَأَتْ","آسارَها يتعد تحتَ سياطي",49,"ط",2,0],["خُضتَ المُنى ثُمَّ صِرتَ بَعدُ إِلى","مَولاكَ في وَحلِهِنَّ مُرتَبَكا",50,"ك",2,0],["خُضِ اللَيلَ وَاِقصِد مَن أُحِبَّ وَقُل لَهُ","سَأَكتُمُ ما بي وَهوَ في القَلبِ راسِخُ",51,"خ",1,0],["خُضرُ المَرابِعِ حَمرُ السَمرِ يَومَ وَغىً","سودُ الوَقائِعِ بيضُ الفِعلِ وَالشِيَمِ",52,"م",1,0],["خَضَعَتْ له عُنُقٌ لها وتَحَمَّلَتْ","من ثِقْلِهِ فوق الَّذي تسطيعُهُ",53,"ع",2,0],["خُضنا حشاه في حَشَى زِنجيَّةٍ","كَمُسِفّةٍ شَقَّتْ سُكاكاً أغبرا",54,"ر",2,0],["خَضِلاً إِذا العَبَراتُ لَم تَبرَح لَها","وَط