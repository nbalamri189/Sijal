ديباج والتاج مع","https://www.aldiwan.net/poem37420.html","السريع"],[538,"خضوعا ومثلي بالخضوع أخو فخر","https://www.aldiwan.net/poem48153.html","عموديه"],[538,"كيف يمتاز من جلالك يوم","https://www.aldiwan.net/poem48237.html","عموديه"],[558,"إن ديني وملتي واعتقادي","https://www.aldiwan.net/poem34642.html","الخفيف"],[561,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[567,"ضرب في ارتشاف ذاك الرضاب","https://www.aldiwan.net/poem69817.html","الخفيف"],[567,"من يتب خشية العقاب فإني","https://www.aldiwan.net/poem69824.html","الخفيف"],[575,"وصغير القد همت به","https://www.aldiwan.net/poem2942.html","المديد"],[575,"رجع الغرام إلى الحبيب الأول","https://www.aldiwan.net/poem3030.html","الكامل"]],"verses":[["خُضتَ الظَلامَ إِلَيهِمُ بِسَنابِكٍ","خاضَت قُلوبَ مَواقِدِ النيرانِ",0,"ن",1,0],["خَضَعَ الدَهرُ لَنا ثُمَّ نَبا","وَكَذا الدَهرُ إِذا سافَ عَذَم",1,"م",1,0],["خُضتُ الغِمارَ فَجازَ جُمَّتَها","دوني وَطَبَّقَ ثَوبِيَ البَلَلُ",2,"ل",1,0],["خُضنا الظَلامَ وَكُلُّنا بِجَنانِهِ","ماضٍ عَلى عَجَلِ وَلَيسَ كَواكِبُ",3,"ب",1,0],["خَضَعَت لَكَ الأَعداءُ يَومَ لَقيتَها","جَلداً تُجَرِّدُ لِلمُصابِ عَزاءَ",4,"ا",2,0],["خُضتُهُ وَالدِّرعُ فَوقي وَطَوَتْ","تَحتيَ المُهرَةُ أَجوازَ الفَلا",5,"ا",1,0],["خَضِلِ البَنانِ إِليهِ يُزْجي المُجْتَدي","وَجْنَاءَ أَبْلَى السَّيْرُ ثِنْيَ وَضَينِها",6,"ن",3,0],["خَضِلَتْ بدَجْلَةَ والفُراتِ ذُيولُها","فاهْتزَّ منْ طَرَبٍ إلَيْها النّيلُ",7,"ل",1,0],["خَضَبَتْ مَناسِمَها إِلى عَرَصاتِهِ","خُوصٌ نَماها شِدْقمٌ وجَديلُ",7,"ل",1,0],["خَضَعوا لمَلْثومِ الخُطا عَرَصاتُهُ","للمُعْتَفينَ وللعُلا أوطانُ",8,"ن",1,0],["خِضابٌ على فَوْدَيَّ للدّهْرِ ما نَضا","ومُقْتَبَلٌ مِنْ رَيِّقِ العُمْرِ ما مَضَى",9,"ض",2,1],["خَضِلُ البَنانِ بِنائِلٍ منْ دونِهِ","وَجهٌ يَجولُ البِشْرُ فيهِ طَليقُ",10,"ق",1,0],["خُضْتِ الظَّلامَ ومِن جَبينِكِ يُجْتَلى","صُبْحٌ يَنِمُّ عليكِ بالأضواءِ",11,"ا",2,0],["خَضَبَتْ مَنَاصِلَكَ الْمَفَارِقَ مِنْهُمُ","حِنّا نَجِيعٍ صَبْغُهَا لاَ يَنْصلُ",12,"ل",1,0],["خَضِرُ الجَنابِ سَقى مَعاهِدَهُ الحَيا","وعَلا على كَنْزِ الجَلالِ جِدارُهُ",13,"ر",2,0],["خُضْتَ بحْرَ الحُبِّ والدّمْعِ وهلْ","تُدْرَكُ الآمالُ إلا بالغَرَرْ",14,"ر",1,0],["خضّبْتُها بعْدَما لاحَ المشيبُ وقدْ","جوّزْتُ في العَقْلِ كتْمَ الصُبْح بالغَبَشِ",15,"ش",1,1],["خَضَبَ الشيبُ شَيبَهُم بِسَوادٍ","وَمَحا البيضُ يَومَ مِتَّ الخِضابا",16,"ب",2,0],["خِضَمُّ الحَياةِ بَعيدُ النَجاةِ","فَطوبى لِراكِبِهِ إِن عَبَر",17,"ر",1,0],["خَضَعَت لِإِمرَتِهِ الرِيا","حُ مِنَ الصَبا وَمِنَ الدَبورِ",18,"ر",1,0],["خُضها هُنالِكَ بِاليَقينِ مُدَرَّعاً","وَاللَهُ بِالنَصرِ المُبينِ كَفيلُ",19,"ل",1,0],["خَضَبَ السِنانَ بِطَعنَةٍ","فَالنَفسُ يَحفِزُها النَفَس",20,"س",1,0],["خُضْتَ السِّيَاسَةَ لَمْ تَجُرْ","فِيهَا وَلَمْ تَثُرِ الرِّيَبْ",21,"ب",1,0],["خضعن للسوط حتى أن أعقدها","لو يأمر السوط يغدو مرسل الذنب",22,"ب",1,0],["خضعنا لحكام تجور وقد حلا","بأفواهها من مالنا مَأكل سُحت",23,"ت",1,0],["خضعت فارس لها عن صَغار","وتداعة إيوانها المستطيل",24,"ل",1,0],["خَضَبوا الأَسِنَّةَ وَالأَعِنَّةَ إِنَّهُم","نالوا مَكارِمَ لَم يَنَلها تُبَّعُ",25,"ع",1,0],["خِضَمُونَ أشرَافٌ لَهَاميمُ سَادَةٌ","مَطَاعِيمُ أيسَارٌ إذَا النَّاسُ أَجدَبُوا",26,"ب",3,0],["خضبت بأحمرَ كالنضار معاصماً","كالماءِ فيها رونقٌ وصفاء",27,"ا",2,0],["خضعت لعزَّته الملوك وأذعنت","لأغرّ أمَّله الزمان وخافَهُ",28,"ف",2,0],["خضبت مشيبي بالدموع فما به","ولكن بقلبي للهمومِ نصول",29,"ل",1,0],["خَضَبت رأسَهُ فبات بتَبْري","حٍ وأضحى فظلَّ في تأنيبِ",30,"ب",1,0],["خَضبتَ الشيبَ حين بدا لتُدْعَى","فتىً حَدَثاً ضَلالاً ما ارتَجيْتا",31,"ت",2,0],["خضراء كالعقرب في صُفرةٍ","نمشاءَ كالحيةِ في رُقطه",32,"ط",2,0],["خضعتُ فإن خلتَ الخضوعَ خديعةً","فما زلتُ خدَّاعاً وزلتَ مخدَّعا",33,"ع",2,0],["خضراءُ لونِ الريقِ لو نفثتْ به","مَيْثاء ألقحها الحيا لم تُبْقِلِ",34,"ل",1,0],["خَضلُ الكِئاسِ إِذا تَنَشّى لَم تَكُن","خُلُفاً مَواعِدُهُ كَبَرقِ الخُلَّبِ",35,"ب",1,0],["خُضُعٌ إِلى الطَمَعِ القَليلِ وَرِفدُهُم","عِندَ الهِياجِ لَدى الطِعانِ قَليلُ",36,"ل",1,0],["خَضَعَت لَكُم فيهِ الصُفوفُ وَأُزلِفَت","لَكُمُ الصَلاةُ وَقُرِّبَ التَرتيلُ",37,"ل",1,0],["خَضَبَ الجُندُ بِهِ الأَرضَ دَما","وَقُلوبُ الجُندِ كَالصَخرِ القَسي",38,"ي",1,0],["خَضراءَ حَمراءَ التُرا","بِ كَأَنَّها في خَدِّ أَغيَد",39,"د",1,0],["خَضَعَت لِمُنصُلِكَ المَناصِلُ عَنوَةً","وَأَذَلَّ دينُكَ سائِرَ الأَديانِ",40,"ن",1,0],["خضرته مشوبة","بحمرة من غسقِ",41,"ق",1,0],["خِضَمٌّ له بالأبرقَيْنِ تدافعٌ","كما انهارتِ الكُثبانِ وارتَّجَّتِ اللُّوبُ",42,"ب",1,0],["خُضراً يُساقِطُها الصَبا وَكَأَنَّها","وَرَقٌ يُساقِطُها اِهتِزازُ قَضيبِ",43,"ب",1,0],["خِضرُ بنُ أَحمَدَ طَودُ عِزٍّ شامِخٌ","راسٍ دَعائِمُهُ أَمينُ المَنكِبِ",44,"ب",1,0],["خَضِلُ اليَدَينِ إِذا تَفَرَّقَ في النَدى","جَمَعَ العُلا فيما يُفيدُ وَيُنفِذُ",45,"ذ",1,0],["خَضِلُ الفِناءِ مَتى وَطِئتَ تُرابَهُ","قُلتَ الغَمامُ انهَلَّ فيهِ فَأَسبَلا",46,"ل",2,0],["خَضَبتُ بِجَيِّدِ الحِنّاءِ رَأسي","لِيُعقِبَ حُمرَةً بَعدَ البَياضِ",47,"ض",1,1],["خضراء ينسح الحيا من مزنه","قبل انسكاب سحابه الغيداق",48,"ق",1,0],["خضَعَتْ رِقابُ بَني العَداوَةِ إذ رَأَتْ","آسارَها يتعد تحتَ سياطي",49,"ط",2,0],["خُضتَ المُنى ثُمَّ صِرتَ بَعدُ إِلى","مَولاكَ في وَحلِهِنَّ مُرتَبَكا",50,"ك",2,0],["خُضِ اللَيلَ وَاِقصِد مَن أُحِبَّ وَقُل لَهُ","سَأَكتُمُ ما بي وَهوَ في القَلبِ راسِخُ",51,"خ",1,0],["خُضرُ المَرابِعِ حَمرُ السَمرِ يَومَ وَغىً","سودُ الوَقائِعِ بيضُ الفِعلِ وَالشِيَمِ",52,"م",1,0],["خَضَعَتْ له عُنُقٌ لها وتَحَمَّلَتْ","من ثِقْلِهِ فوق الَّذي تسطيعُهُ",53,"ع",2,0],["خُضنا حشاه في حَشَى زِنجيَّةٍ","كَمُسِفّةٍ شَقَّتْ سُكاكاً أغبرا",54,"ر",2,0],["خَضِلاً إِذا العَبَراتُ لَم تَبرَح لَها","وَطَناً سَرى قَلِقَ المَحَلِّ طَريدا",55,"د",2,0],["خَضَبَت خَدَّها إِلى لُؤلُؤِ العِق","دِ دَماً أَن رَأَت شَواتي خَضيبا",56,"ب",2,0],["خَضَعْتُ لأَحْكَامِ الْهَوَى وَلَطَالَمَا","أَبَيْتُ فَلَمْ أَخْضَعْ لِمَنْ يَهَبُ الْجَدْوَى",57,"و",2,0],["خَضَعنَ بِمَعروفِ الحَديثِ بَشاشَةً","كَما مُدَّتِ الأَعناقُ وَهيَ شَوارِعُ",58,"ع",1,0],["خُضتَ الخُطوبَ لِأَجلِ مِصرَ مَخوفَةً","مِن كُلِّ أَرعَنَ هائِلِ التَيّارِ",59,"ر",1,0],["خُضتَ الفَيالِقَ مَوجُها مُتَدافِعٌ","كَالبَحرِ يَدفَعُ زاخِرَ التَيّارِ",60,"ر",1,0],["خَضَعتُ وَأَمرُكَ الأَمرُ المُطاعُ","وَذاعَ السِرُّ و