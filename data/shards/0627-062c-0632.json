1,1],["أجزعت ؟ ، كيف وديننا أفق","رحب وأدنى ما لديك ذرا ؟!",131,"ر",2,0],["أ جزاءُ شعبِ الرّافدينِ بأنّه ُ","في شقوةٍ وشكايةٍ ما داموا ؟",132,"م",3,0],["أَجَزِعتَ مِنِّي حِيْنَمَا آذَيْتَنِيْ","فَسَكَبْتَ حِبْرَكَ في أَعزِّ مَتَاعِيْ ؟!",133,"ي",1,0],["اجزاه لو انه رماني وجادني","يمحا خطا الغالي عظيم إرضاه",134,"ا",2,0],["اجزيه بالصدع جنوب وشمالي","واتلى هوى قلبي اليا هب نسناس",135,"س",1,0],["اجزم ان كنت ياقلبي شجاع وجزوم","لد لعيون بنتٍ لا التفت الفحت",136,"ت",1,0],["إجزَعْ فقد بانوا وما رُجعاهم","بَمقالِ مَن قالوا لماذا تَجزَعُ",137,"ع",1,0],["أجْزَلْتِ بالأخْذِ ما طَابَتْ لكِ النِّعَمُ","وازْدَدْتِ بي شَغَفًا فازْدادَ بي سَقَمُ...",138,"م",1,1],["أجزائي أن أدفن حياً","وأموت بحبك مولاتي",139,"ت",2,0],["أجزاه كبراه وظهر ظهوره","منهم ومنها كوناً نوره",140,"ه",1,0],["أَ جَزا المحبةِ والولاء تنكُّرٌ؟","كلا فإني لن أمزق شملَها",141,"ل",3,0],["أجزل إلهي عطايا من أتاك ولم","يسجد لغيرك أو يدعو لإنكار",142,"ر",1,0],["أَجَزِعتَ أن أنهى العُلاقة َ شَادِنٌ","وَ حفرتَ هذا الحُزْنَ في النظراتِ",143,"ت",1,0],["أجز به وأقبل ثناي ودم على","طول المدى تخضع لك البلفاء",144,"ا",2,0],["أجزلت إذ وفيت محسن قدره","لا قول مرتاب، ولا لجاجا",145,"ج",2,0],["أجزُ جبلاً وراءَ الرزقِ قالت","وتتركنا فؤادكَ منهُ أقٌسى",146,"س",2,0],["أجزْ حراماً فما عادتْ لنا حُرُمُ","تأريخُنا وثرى أجدادِنا عدَمُ !",147,"م",1,1],["أجزْ حراماً فقد ضاقتْ بنا النُّظُمُ","وشرعُ أحمدَ يَستشري بهِ الألَم",147,"م",1,0],["أجز حراماً فإنَّ النارَ موعِدُ مَنْ","يَخشى الحَرامَ ولِلأقدار ِيحتكِم!",147,"م",1,0]]}