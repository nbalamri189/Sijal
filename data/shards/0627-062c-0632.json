سْأَلُون بِشَرْطِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=194722",""],[5542,"مالي أراك تقلبُ النظرا","https://www.poetsgate.com/ViewPoem.aspx?id=9683",""],[5595,"حكامُنا نوّابُنا نيّامُ","https://www.poetsgate.com/ViewPoem.aspx?id=144526",""],[5720,"حِبْر","https://www.poetsgate.com/ViewPoem.aspx?id=214577",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5732,"يقول من عدا على رأس عالي","https://www.poetsgate.com/ViewPoem.aspx?id=34388",""],[5756,"من تحت لتحت","https://www.poetsgate.com/ViewPoem.aspx?id=5425",""],[5759,"سنظلُّ نبكي","https://www.poetsgate.com/ViewPoem.aspx?id=212934",""],[5781,"قولي لهم","https://www.poetsgate.com/ViewPoem.aspx?id=176234",""],[5899,"من أجلكِ","https://www.poetsgate.com/ViewPoem.aspx?id=31523",""],[5953,"الله أكبر أكبر الله","https://www.poetsgate.com/ViewPoem.aspx?id=93797",""],[5956,"مودة ورحمة","https://www.poetsgate.com/ViewPoem.aspx?id=182435",""],[5974,"مرافئ الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=214988",""],[6093,"الوقت حب","https://www.poetsgate.com/ViewPoem.aspx?id=194334",""],[6134,"يا كامل الأوصاف يا سامي النهى","https://www.poetsgate.com/ViewPoem.aspx?id=169529",""],[6152,"شكرا لحرفك","https://www.poetsgate.com/ViewPoem.aspx?id=206270",""],[463,"ذكرتُ وما وفايَ بحيثُ أنسى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60101&r=&rc=157",""],[6305,"أجِزْ حَرَامَاً ...!!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87338&r=&rc=11",""]],"verses":[["أَجزَلتَ عارِفَتي وَعَوَّدتَ العَطا","عَقِبي وَوَلَّيتَ اليَراعَ بَناني",0,"ن",2,0],["أجَزْنا وأيْمُ اللهِ ساحَةَ حاجِرٍ","فمِلْ بهَواديها إِلى رَمْلِ مُرْبِخِ",1,"خ",1,0],["أجْزاءُ لَيْلٍ مرّتْ كما انْطلقَتْ","كَفٌّ على سُبْحةٍ منَ السَّبَجِ",2,"ج",1,0],["أُجزيهِ بالعُرفِ ما حُييتُ وَلا","يَعدم صَفحي لِلشَرِّ مِن عملِه",3,"ل",2,0],["أجزت فيه بالوسم الذي","دل على شبقك بين الملا",4,"ل",2,0],["أَجَزتُ إِلى مَعارِفِها بِشُعثٍ","وَأَطلاحٍ مِنَ العيدِيِّ هيمِ",5,"م",1,0],["أجز لهم يدَ مَخْلَد وجزاؤها","عندي بلا حلف ولا بتلهوقِ",6,"ق",1,1],["أَجَزَرتَهُم عِرضي تَهَكَّمُ سادِراً","ثَكِلَتكَ أُمُّكَ غَيرَ عِرضي أَجزِرِ",7,"ر",1,0],["أجزت لهم رواية ما أشاروا","إليه بمقتضى الشرط العزيز",8,"ز",1,1],["أجَزاءُ الصَّديق إيطاؤُهُ العِش","وة حتَى يظلّ كالعشْواءِ",9,"ا",2,0],["أَجْزَل البدْء لي فأغْنَى عن العَوْ","دِ فما بي إلا اخْتِلالُ الوُرُودِ",10,"د",1,0],["أجزعني حادثُ المشيب وإن","كنت جليداً مستحصِد المِرر",11,"ر",1,0],["أجزي الأخِلّاء صفحاً عن إساءتهم","إذا أساءوا وبالإحسان إحسانا",12,"ن",2,0],["أَجَزتَ إِذا كانَ السَرابُ كَأَنَّهُ","عَلى مُحزَئِلّاتِ الإِكامِ نَضيحُ",13,"ح",1,0],["أَجَزتُ إِذا الحِرباءُ أَوفى كَأَنَّهُ","مُصَلٍّ يَمانٍ أَو أَسيرٌ مُكَبَّلُ",14,"ل",1,0],["أَجَزِعنَ أَن يَجري عَلَيهِنَّ الَّذي","مِن قَبلِهِنَّ جَرى عَلى الزَهراءِ",15,"ا",2,0],["أَجِزني إِذا أُنشِدتَ شِعراً فَإِنَّما","بِشِعري أَتاكَ المادِحونَ مُرَدَّدا",16,"د",2,0],["أَجِز مِن غُلَّةِ الصَدرِ العَميدِ","وَسَكِّن نافِرَ الجَأشِ الشَرودِ",17,"د",1,1],["أَجَزتَ عَلَيهِ عابِراً فَتَساجَلَت","أَواذِيِّهُ لَمّا طَما فَوقَهُ البَحرُ",18,"ر",1,0],["أَجزَلَت كَفُّكَ العَطايا لِعافي","كَ فَكافاكَ بِالثَناءِ الجَزيلِ",19,"ل",1,0],["أَجزَّارَ بابِ الشَّامِ كيفَ وجدْتَني","وأنتَ جَزورٌ بين نابي ومِخْلَبي",20,"ب",2,1],["أَجَزتُ لِسَيِّدي وَمَليكِ رِقّي","رِوايَةَ ما حَوى مِن نَسجِ فِكري",21,"ر",2,1],["أَجزِل لَهُ الحَظَّينِ مِنكَ وَكُن لَهُ","رُكناً عَلى الأَيّامِ لَيسَ بِواهِ",22,"ه",1,0],["أجزتُهم كلَّ ما أرادوا","إذا وفى شرطَهُ العزيزُ",23,"ز",1,1],["أجزتُ مولايَ كما جوّزوا","صرفَ سوى المصروفِ للشاعرِ",24,"ر",1,0],["أَجَزَيتَهُم سوءَ العَذابِ بِظُلمِهِم","أَم ذاكَ شَيءٌ بِالشُعوبِ يُرادُ",25,"د",1,0],["اجْزُوا اليَهُودَ بِصَلْبِهِ خَيْراً ولا","تُخْزُوا يَهُوذَا الآخِذَ البِرْطِيلا",26,"ل",2,0],["أجَزْتُ عليها عابراً وتركْتُهَا","كأنّ المَنَايا تحتَ جنبي أرائِك",27,"ك",1,0],["أَجزاءُ دَهرٍ يَنقَضينَ وَلَم يَكُن","بَيني وَبَينَ جَميعِهِنَّ جِوارُ",28,"ر",1,1],["أَجَزتُهُ بِعَلَنداةٍ مُذَكَّرَةٍ","كَالعَيرِ مَوّارَةِ الضَبعَينِ مِمراحِ",29,"ح",1,0],["أجزلُ ما كافأ هذا الشهيد","بلوغُه المجد على سُلَّمك",30,"ك",1,0],["أجزني إذا أنشدت مدحاً فإنّما","بشعري أتاك المادحون مردّدا",31,"د",2,0],["أجزاؤها ثلاثةٌ مُسبَّعه","قد كَرهوا أَن يَجعلُوها أَربعَه",32,"ه",1,0],["أجزت لعيسى السبع في ختمة قرا","علي بها فليرو ذلك وليقري",33,"ر",2,1],["أجزاء ليل مضت كما انطلقت","كف على سبحة من السبج",34,"ج",1,0],["أجزَلَتْ كَفُّكَ العَطَاياَ لعافِي","كَ، فَكَافَالاَ بالثّنَاءِ الجَزِيلِ",35,"ل",1,0],["أجِزْ منْ غُلّةِ الصّدْرِ العَميدِ،","وَسَكِّنْ نَافِرَ الجائش الشَّرُودِ",36,"د",1,1],["أجَزْتَ عَلَيْهِ عابراً، فَتسَاجلَتْ","أواذِيهِ لَمّا أنْ طَما فَوْقَهُ البَحرُ",37,"ر",1,0],["اجزل ضجيع رسول الله جائزتي","عليك دهرا سلام الله يا عمر",38,"ر",1,0],["أجزل من سهمة الرجاء لنا","فكل شيءٍ نراه مطلوبا",39,"ب",2,0],["أَجزَلتَ أَثمانَ المَديحِ وَزِدتَهُ","لَمّا بَغَوا حَمداً بِغَيرِ نَوالِ",40,"ل",1,0],["اجزني اجزني سيدي واجر بي على","فواضل ما عودتني واغتنم اجري",41,"ر",2,0],["أجِزْني على مقدار ما أنا محسنٌ","ولا تعطني ما ليس يبلغُه سَهْمي",42,"م",2,0],["أَجِزْ وَأَنْجِزْ فَلاَ عُرِّيتَ منْ شَرَفٍ","إِجَازَةً لَمْ تُغَادِرْ لَكُمْ سَنَدَا",43,"د",2,0],["أَجَزْتُكُمْ مَرْوِيَّنَا مُطْلَقاً","وَمَا لَنَا يُعْزَى بِقَوْلٍ وَجِيزْ",44,"ز",1,1],["أجزيرةَ العرَبِ اذكري ما قد مضى","بك أَيِّم تشكو الأسى وثكول",45,"ل",1,0],["أجزني دفنه فشاع كما","أعجز قابيل دفن هابيل",46,"ل",1,0],["أجزّاً لشاءٍ ثم ذبحاً لغيرها","وهذي لها صرعٌ وتلكَ ثِغاء",47,"ا",2,0],["أَجَزْتَهُمُ الْمَخافَةَ لَمْ يُرابُوا","بِها رَيْباً وَمِثْلُكَ مَنْ أَجازا",48,"ز",2,0],["أَجِزني أَميرَ الشِّعرِ بالشِّعرِ إِنَّني","أَرانيَ لم أسلكْ به مسلكاً وعرا",49,"ر",2,0],["أَجزت دمشقَ الشام والراكب مظهراً","فما بتَّ إلاّ في ذرى النبك ثاويا",50,"ي",2,0],["أَجزي بِواحِدَةٍ أُلوفاً مِثلَها","وَأَحوزُ بِالتَكريرِ فِعلَ المُبتَدي",51,"ي",1,0],["أَجَزاءُ مَن هذي ذُؤابَةُ فَضلِهِ","وَثِمارُ عَلياه بِغَيرِ غُصونِ",52,"ن",1,0],["أَجَزاء نَصْحِي أَنْ يَنَالَ أقاربي","من بَعْدِ الإِبْعادُ والإزهاق",53,"ق",1,0],["أجزتكما يا أهل ودي روايتي","لما أنا من علم الحديث أرويه",54,"ي",2,1],["أجزتك يا عليُّ وأنت عندي","كأولادي الصغار مع الكبار",55,"ر",1,1],["أجزتك ما سمعنا عن شيوخ","من العلماء أعلام بحار",55,"ر",1,0],["أجزتك يابْنَ وُدِّي ما تريد","بما فيه تفيد وتستفيد",56,"د",1,1],["أجزتك إذ طلبت وأنت بحر","يحق لمثلنا فيه الورود",56,"د",1,0],["أجزت الأمهات وهن سِتٌّ","إليه كل ذي علم يعود",56,"د",1,0],["أجِزني رضاك فثَمَّ الغنى","لأنَّ رضاك هو المغنم",57,"م",1,0],["أَجِزْ لي في مديحك لي بلثمي","يمينكَ فهو لي أملٌ وقصد",58,"د",1,0],["أجزني عليها الرضا بالقبول","فأقصى المنى أن أنال القبولا",59,"ل",2,0],["أَجَزِعْتِ بعد إِقامتي من رحلتي","ليسَتْ عقودُ هَوَاكِ بالمُنْحَلَّةِ",60,"ه",1,1],["أَجزِلْ بِهَا نِعَماً فُزْنا بِهَا قِسَماً","فِي دَوْلَةِ العِزِّ إذ فازَتْ بِهَا قِسَمُكْ",61,"ك",1,0],["أجزني العُلى قبل الغنى لا مُقنعي","ومن كنت ملْفاهُ فلن يَتَقَنَّعا",62,"ع",2,0],["أَجَزتُ بِفِتيَةٍ بيضٍ خِفافٍ","كَأَنَّهُمُ تَمَلُّهُمُ سَباطِ",63,"ط",1,0],["أَجْزاءُ رُوحي لم تبرَحْ بساحَتِهِمْ","تُقَبِّلُ الأَرضَ من أَطرافِ رُكْنِهِمِ",64,"م",1,0],["أجزت على الدار الشريفة بعده","فقلت هل الأيام لي في عود",65,"د",1,0],["أجزلت حظ صلاته وصلاته","فغدا يسر لك الثواب الأجزلا",66,"ل",2,0],["أَجِزْ لَنا يا مَنْ نَرَى طِرْفَهُ","في حَلْبَةِ النَّظْمِ غَدا فَارِها",67,"ه",2,1],["أَجَزْتُكَ في فُنُونِ العِلْمِ طُرّاً","فَأَنْتَ لِذَاكَ عِزَّ الدّينِ أَهْلُ",68,"ل",1,1],["أَجَزْتُكَ بابنَ السُّراةِ الأُولى","غَدَتْ لَهُمُ المكْرُماتُ الشِّعارا",69,"ر",2,1],["أَجَزْتُكَ يا عَبْدَ الرّحِيم بكُلِّ ما","تَجُوزُ رِواياتي لَهُ في الدَّفاتِرِ",70,"ر",1,1],["أَجزْتُكَ أَيُّها الْمَوْلى بِما فِي","رِواياتِي مِنَ الْكُتُبِ الصّحاحِ",71,"ح",1,1],["أُجزَى عَلَى الحُسنَى القَبيحُ كَيفَ لا","اُجزَى عَلَى الإحسانِ بِالإحسانِ",72,"ن",1,0],["أَجَزت كَعباً فَحازَ الرفعَ مِن قَدَمٍ","عَلى الرؤوسِ وَنالَ البشرَ وَالتُحَفا",73,"ف",2,0],["أجزيك عن وطني وقومي خير ما","تجزي وألقَى ما صنعتَ بمثله",74,"ل",2,0],["أجَزِعِتَ أَنْ سالتْ بخدِّكَ لحيةٌ","هاتيك مسكٌ سائلٌ أو عنبر",75,"ر",1,0],["أَجزَل اللَّهُ ذو الجزاءِ ثَواباً","لِسُلَيمانَ صاحبِ الخَيراتِ",76,"ت",1,1],["آجزتَني بحرَ النّدى فيما حَوى","ثبتَ البَديرِيّ الإِمامِ المُفردِ",77,"د",1,0],["أجزل الله أجر مولى جليلٍ","في قضاه بلغ