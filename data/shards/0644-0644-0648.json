52,"","https://poetry.dctabudhabi.ae/diwan/poem/36424","الدوبيت"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119626","الرجز"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119615","السريع"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54490","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94488","الوافر"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138724",""],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135123","الرجز"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135120","الرجز"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123849","الخفيف"],[4612,"","https://poetry.dctabudhabi.ae/diwan/poem/111236","الخفيف"],[4680,"لهواكِ يا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=207849",""],[4816,"حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=8484",""],[4941,"يا كاظم الغيظِ،لا تكظم حرائقه","https://www.poetsgate.com/ViewPoem.aspx?id=178742",""],[4963,"شاعر سعودي والدواسر لابتي","https://www.poetsgate.com/ViewPoem.aspx?id=35635",""],[4987,"الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=49628",""],[4988,"حلم وأماني","https://www.poetsgate.com/ViewPoem.aspx?id=198223",""],[5002,"همسة الورد..","https://www.poetsgate.com/ViewPoem.aspx?id=206150",""],[5061,"الوفاء والطيب","https://www.poetsgate.com/ViewPoem.aspx?id=147176",""],[5136,"شوقي إلى دست الخلافة شيق","https://www.poetsgate.com/ViewPoem.aspx?id=121631",""],[307,"صراخ الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=213646",""],[5431,"قصيدة وجودية ...","https://www.poetsgate.com/ViewPoem.aspx?id=207830",""],[709,"ويا وميضَ بروقِ المزنِ إنْ سفرتْ","https://www.poetsgate.com/ViewPoem.aspx?id=2956",""],[5461,"غربة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=5065",""],[5464,"وفي حقول فؤادي أتمَرَ القصب","https://www.poetsgate.com/ViewPoem.aspx?id=21368",""],[5525,"ذلني الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=946",""],[5539,"المندق","https://www.poetsgate.com/ViewPoem.aspx?id=196880",""],[5587,"عمر","https://www.poetsgate.com/ViewPoem.aspx?id=196902",""],[5616,"تعليق هامشي على هامش أحداث هامشية!","https://www.poetsgate.com/ViewPoem.aspx?id=205035",""],[5736,"هذيان","https://www.poetsgate.com/ViewPoem.aspx?id=208218",""],[5755,"جنون الشك والغيره","https://www.poetsgate.com/ViewPoem.aspx?id=133413",""],[5829,"الى محمد","https://www.poetsgate.com/ViewPoem.aspx?id=153239",""],[5848,"آلهة أغريق","https://www.poetsgate.com/ViewPoem.aspx?id=53457",""],[5939,"ليلى وأخواتها","https://www.poetsgate.com/ViewPoem.aspx?id=190078",""],[5982,"يا سماك البحر","https://www.poetsgate.com/ViewPoem.aspx?id=176599",""],[6089,"إني أقمتُ جدارَ نسيانٍ على حبي","https://www.poetsgate.com/ViewPoem.aspx?id=214556",""],[6115,"رفرفي ياراية التوحيد عالي","https://www.poetsgate.com/ViewPoem.aspx?id=196475",""],[6142,"من عذيري من ألمعي تغابى","https://www.poetsgate.com/ViewPoem.aspx?id=155692",""],[6160,"أَجنِحَةُ الضَّوء ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87084&r=&rc=1",""]],"verses":[["لَلَوَيتُ مِن دونِ المَذَلَّةِ جانِبي","وَجَرَرتُ عَن دارِ الهَوانِ ذُيولي",0,"ل",2,0],["لَلَؤُمتُ إِن لَم أَسقِها بِمَدامِعي","وَوَكَلتُ سُقياها إِلى الأَنواءِ",1,"ا",2,0],["لِلونا شُهرَةٌ في الطِبِّ تاهَت","بِها مِصرٌ وَتاهَ بِها مَديحي",2,"ي",1,1],["للواردين على رياضك أعين","من فضلة أهدابهن نضار",3,"ر",1,0],["لِلوُفودِ مائِدَةٌ","مِنهُ أَينَما اِنقَلَبوا",4,"ب",3,0],["للوَرْدِ حُسْنٌ وإِشْراقٌ إذا نَظَرَتْ","إليهِ عَيْنُ مُحِبٍّ هاجَهُ الطّرَبُ",5,"ب",1,1],["لِلوَصلِ سَعى وَطالَما قُلتُ عَسى","وَالريقُ سَقى مِن بَعدِ ما كانَ قَسا",6,"س",2,0],["لِلْوَرْدِ حِينٌ ليسَ يطلعُ دُونَهُ","والوَردُ عِنْدَكَ كُلَّ حِينٍ يَطلُعُ",7,"ع",1,0],["للؤُلؤِ المنُظومِ في فَمِكِ اِنبَرت","عَبَراتُهُ كاللؤلُؤ المنثُورِ",8,"ر",1,0],["لِلُورَا قَوَافِ تَفُوح عبيرا","رعى الله لورا، وديوان لورا",9,"ر",2,1],["لَلوَيتَ وجهَك عن صَريعٍ","في حِياض اليأس مُلقى",10,"ق",2,0],["للوزينا على مصر أيادي","تكلُّ بهن أعناقَ البلادِ",11,"د",1,1],["للورد ريح عبق","يا حسنه بين الورق",12,"ق",1,1],["للوعد منك وإن مطَل","تَ ألذُّ من جدوى سواك",13,"ك",1,0],["للوحش رزق من حصاد سيوفهم","شبعا وَريا كان لحما اودما",14,"م",2,0],["لِلوَردِ وَالدُرِّ خَدّاهُ وَمَبسِمُهُ","وَلِلرُدَينِيِّ مُهتَزّاً تثنيهِ",15,"ي",2,0],["للوَردِ حينٌ بِهِ ناهيكَ مِن حينِ","أَحسِن بِهِ حاضِراً بَينَ الرَياحينِ",16,"ن",1,1],["للواصفين عُلاه كلَّ آونةٍ","تَوليدُ معنىً به الأَلفاظُ لم تَقُمِ",17,"م",1,0],["لِلوَصلِ تَدعوكَ بِالبُشرى مُهَلَّلَة","فَقُمتُ تَغنِمَها نُعمى مُعجِلَةً",18,"ه",1,0],["للوقد منه وإن شطت ديارهم","وأجدب الدهر أوطان وأوطار",19,"ر",1,0],["للوجودِ قلبي قاطناً أو ظاعناً","معها وجفني ممسكاً أو منفقا",20,"ق",2,0],["للوالِدَيْنِ احفَظْ حُقوقاً جَمَّةً","حالَ الحياةِ أَو هُما تحت الثَّرَى",21,"ا",1,0],["للوافدين وللإخوان أجمعهم","وللمحاويج من كل أرحام",22,"م",1,0],["للواء عدلك ناشراً","بين المشارق والمغاربْ",23,"ب",1,0],["لِلوَحشِ لَحمُهمُ لِلطّيرِ أَعيُنهم","نَعم وَأَعظُمهُم لِلنّارِ كَالحَطَبِ",24,"ب",1,0],["للوجدِ قلبي قاطناً أو ظاعناً","معها وجفني ممسكاً أو منفقا",25,"ق",2,0],["للورد منها وهو أحمر ناصع","خد وللغصن الرطيب قوامُ",26,"م",1,0],["لِلْوُرْقِ فيها أَغانيُّ القِيانِ ولي","نَدْبُ يُبيدُ ويُبْدي في الحَشا نَدَبا",27,"ب",2,0],["للوصل ما لو أن أن وكي فذي","فشت وجاء الخلف عنهم في الذي",28,"ي",1,0],["للواجب المختار مظهر حكمة","عن قدرة وجبت لوحدة ذاته",29,"ت",2,0],["للوَصل أَقصَرُ لذَّةٍ من أَن تَرَوا","نَغصَ النَّدامة مَا اِستَقامَ بَقاكُمُ",30,"م",1,0],["للوصل ابشعُ صورة دون النهى","من ان يقبحها شذوذُ خلاعَة",31,"ه",1,0],["للوصي الولي تعلن بالسب","عليها وتدّعي التوحيدا",32,"د",2,0],["لِلوَردِ حُمرَةُ خَدِّهِ وَالغُصنِ هَزْ","زَةُ قَدِّهِ وَالظَبي مَدَّةُ جيدِهِ",33,"د",2,0],["للوعدِ ذو صدقٍ ولكنْ لم يَزلْ","للوصلِ والإسعافِ بالملّاذِ",34,"ذ",1,0],["للواصلين هناك رحم نبيهم","تركوا تنعمهم وعافوا الانعما",35,"م",2,0],["للوقعة الشنعاء طبق","وقعها سمت البلاد",36,"د",1,0],["للوصل بعد الصَّدِّ فضلٌ، من درى","كيف الغرامُ فليسَ عنه بخاف",37,"ف",1,1],["لِلوُدّ مازِجةٍ لِلخِدر وَالجةٍ","ليسَت بِخارِجَةٍ تَهفو بِبُهتانِ",38,"ن",1,0],["للورد عندي محلٌّ","لأنه لا يملُّ",39,"ل",1,1],["للوسام الهنا بصدر جليل","حائز في فواده كل فضل",40,"ل",1,1],["لِلوَصلِ هَمزٌ سَابِقٌ لاَ يَثبتُ","إلاَّ إِذَا ابتُدِى بِهِ كاستَثبِتُوا",41,"ت",3,0],["للورى من فرعها الداجي ومن","وجهها الوضاح ليل ونهارُ",42,"ر",1,0],["للوجدِ فيهِ عَلاماتٌ إِذا ذكروا","آلَ الهَوى في الهَوى يَوماً تقدّمه",43,"م",2,0],["للورى هادو للأملاك وال","ملأ الأعلى الإمام الأوحد",44,"د",1,0],["لِلْوِدِّ عَقْدُ ذِمَّةٍ لا تُهْمَلُ","وللرَّجاء حُرْمَةٌ لا تُجْهَلُ",45,"ل",1,0],["للودّ والخُلو من المراعي","والخَلَّة الخَصلة في السماع",46,"ع",1,0],["للورق المنفوض ثم المصدر","قَبض ونَفض فاستفد يا جعفر",47,"ر",1,0],["لِلوَحشِ مُلْقىً بالعرا يقتاتُهُ","ما كان قبلُ بصيدِهِ يقتاتُهُ",48,"ت",2,0],["لِلوَردِ عَلى شَوكَتِهِ اِستِسلامُ","ناداك وَصبحاً جَنَتِ الأَقوامُ",49,"م",1,1],["لِلوردِ قَدِ اِنضَمَّ شُذورُ الذَهَبِ","ما بَينَ صحاحه كُسورُ الذَهَبِ",50,"ب",1,1],["لِلوَردِ أَرى شَمائِلَ الفُسّاقِ","إِذ شاكَلَهُ الخمرُ وَخَدُّ الساقي",51,"ي",1,1],["لِلوردِ دَعَوتُ باِمتِدادِ العُمرِ","فاِرتَدَّ مُجاوِباً بِدَمع يَجري",52,"ي",1,1],["لِلوَردِ أَقول مُنتَهاك الفوتُ","لِلبُلبُلِ لا شَكَّ يَصمّ الصوتُ",53,"ت",1,1],["لِلوردِ عَلى اليفاع شَبّ النارُ","إِذ أَمكنه من الجناة الثارُ",54,"ر",1,1],["للوجد روحه لدى التراقي","لولا التأسي صار في فواق",55,"ق",1,0],["للواردين الجود من كِفّه","أسال جيحونا وجيحانا",56,"ن",2,0],["للوقدِ أَنفُسُهمْ وسمعُهمُ","للوَقْرِ والأَعناقُ للوَقمِ",57,"م",1,0],["للورَّته الحَبيبة حنَّ قَلبي","هياماً وَالنَوى أغشى عيوني",58,"ن",2,1],["للورى لو درى الورى بك من","بعد أخيك الطهر الأمين اهتداء",59,"ا",2,0],["للواحد القرم الهزبر الأصيد","الماجد القمقام وابن الأمجد",60,"د",1,0],["للواحد القرم الهزبر الأصيد","الماجد الأفضال وابن الأمجد",61,"د",1,0],["للوزير الكبير والجهبذ","موسى المفضل العبقري",62,"ي",1,0],["للوى قد لوى الحبيب العنانا","عن وصالي وعامداً كم جفانا",63,"ن",2,1],["للواقفين وما تزحزح صبرهم","مهما عتا بغي الدخيل الحاقدِ",64,"د",1,0],["ل- لو ينفرش دربي من الشوك زله","ل- لسرجتلك حافي اقدامي ذلايل",65,"ل",1,0],["للوارثين سيبقى حزننا مطراً","عبر الفصولِ ، فهل للحزنِ أحفادُ ؟",66,"د",1,1],["للواحد المعبود والغيره بداء","اللي وهبني الشعر واعلى مكانتي",67