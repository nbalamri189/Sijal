{"poems":[[53,"إلا يكن نصلا فغمد نصول","https://www.aldiwan.net/poem29887.html","الكامل"],[53,"أبكيك لو نقع الغليل بكائي","https://www.aldiwan.net/poem30779.html","الكامل"],[86,"للونا شهرة في الطب تاهت","https://www.aldiwan.net/poem68928.html","الوافر"],[85,"بعدت ديار واحتوتك ديار","https://www.aldiwan.net/poem7354.html","الكامل"],[85,"حف كأسها الحبب","https://www.aldiwan.net/poem63726.html","المقتضب"],[56,"للورد حسن وإشراق إذا نظرت","https://www.aldiwan.net/poem58656.html","البسيط"],[66,"الحب سخا وطرف أعدائي خسا","https://www.aldiwan.net/poem39634.html","الدوبيت"],[76,"أدعو إليك فلا دعاء يسمع","https://www.aldiwan.net/poem39268.html","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43872","الكامل"],[106,"هنا شعر أنثى!","https://www.poetsgate.com/ViewPoem.aspx?id=179385",""],[130,"الطبول الطبول إِنا انتصرنا","https://www.aldiwan.net/poem67451.html","الخفيف"],[136,"للوزينا على مصر أيادي","https://www.aldiwan.net/poem49097.html","الوافر"],[187,"للورد ريح عبق","https://www.aldiwan.net/poem43552.html","مجزوء الرجز"],[212,"الشمس تشرق من صباك","https://www.aldiwan.net/poem46562.html","مجزوء الكامل"],[272,"ضحك تبروق الابرقين تبسما","https://www.aldiwan.net/poem52106.html","الكامل"],[283,"انشر حديثا قديما كنت تطويه","https://www.aldiwan.net/poem32303.html","البسيط"],[283,"للورد حين به ناهيك من حين","https://www.aldiwan.net/poem32327.html","البسيط"],[298,"حسن ابتدائي بذكري جيرة الحرم","https://www.aldiwan.net/poem33180.html","البسيط"],[321,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[465,"لنا بسمر الحمى في الحي أسمار","https://www.aldiwan.net/poem3186.html","عموديه"],[465,"لتذكري ظبيات سلع والنقا","https://www.aldiwan.net/poem3619.html","عموديه"],[501,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[588,"يا راكباً من رياض المجد مرتحلا","https://www.aldiwan.net/poem11553.html","عموديه"]],"verses":[["لَلَوَيتُ مِن دونِ المَذَلَّةِ جانِبي","وَجَرَرتُ عَن دارِ الهَوانِ ذُيولي",0,"ل",2,0],["لَلَؤُمتُ إِن لَم أَسقِها بِمَدامِعي","وَوَكَلتُ سُقياها إِلى الأَنواءِ",1,"ا",2,0],["لِلونا شُهرَةٌ في الطِبِّ تاهَت","بِها مِصرٌ وَتاهَ بِها مَديحي",2,"ي",1,1],["للواردين على رياضك أعين","من فضلة أهدابهن نضار",3,"ر",1,0],["لِلوُفودِ مائِدَةٌ","مِنهُ أَينَما اِنقَلَبوا",4,"ب",3,0],["للوَرْدِ حُسْنٌ وإِشْراقٌ إذا نَظَرَتْ","إليهِ عَيْنُ مُحِبٍّ هاجَهُ الطّرَبُ",5,"ب",1,1],["لِلوَصلِ سَعى وَطالَما قُلتُ عَسى","وَالريقُ سَقى مِن بَعدِ ما كانَ قَسا",6,"س",2,0],["لِلْوَرْدِ حِينٌ ليسَ يطلعُ دُونَهُ","والوَردُ عِنْدَكَ كُلَّ حِينٍ يَطلُعُ",7,"ع",1,0],["للؤُلؤِ المنُظومِ في فَمِكِ اِنبَرت","عَبَراتُهُ كاللؤلُؤ المنثُورِ",8,"ر",1,0],["لِلُورَا قَوَافِ تَفُوح عبيرا","رعى الله لورا، وديوان لورا",9,"ر",2,1],["لَلوَيتَ وجهَك عن صَريعٍ","في حِياض اليأس مُلقى",10,"ق",2,0],["للوزينا على مصر أيادي","تكلُّ بهن أعناقَ البلادِ",11,"د",1,1],["للورد ريح عبق","يا حسنه بين الورق",12,"ق",1,1],["للوعد منك وإن مطَل","تَ ألذُّ من جدوى سواك",13,"ك",1,0],["للوحش رزق من حصاد سيوفهم","شبعا وَريا كان لحما اودما",14,"م",2,0],["لِلوَردِ وَالدُرِّ خَدّاهُ وَمَبسِمُهُ","وَلِلرُدَينِيِّ مُهتَزّاً تثنيهِ",15,"ي",2,0],["للوَردِ حينٌ بِهِ ناهيكَ مِن حينِ","أَحسِن بِهِ حاضِراً بَينَ الرَياحينِ",16,"ن",1,1],["للواصفين عُلاه كلَّ آونةٍ","تَوليدُ معنىً به الأَلفاظُ لم تَقُمِ",17,"م",1,0],["لِلوَصلِ تَدعوكَ بِالبُشرى مُهَلَّلَة","فَقُمتُ تَغنِمَها نُعمى مُعجِلَةً",18,"ه",1,0],["للوقد منه وإن شطت ديارهم","وأجدب الدهر أوطان وأوطار",19,"ر",1,0],["للوجودِ قلبي قاطناً أو ظاعناً","معها وجفني ممسكاً أو منفقا",20,"ق",2,0],["للوالِدَيْنِ احفَظْ حُقوقاً جَمَّةً","حالَ الحياةِ أَو هُما تحت الثَّرَى",21,"ا",1,0],["للوافدين وللإخوان أجمعهم","وللمحاويج من كل أرحام",22,"م",1,0]]}