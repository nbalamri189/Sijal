{"poems":[[56,"أضياف سالم في خفض وفي دعة","https://www.aldiwan.net/poem27391.html","البسيط"],[85,"أضياء هدي أم ضياء نهار","https://www.aldiwan.net/poem54293.html","الكامل"],[74,"أوجهك أم جنة عالية","https://www.aldiwan.net/poem20561.html","المتقارب"],[53,"أبا حسنٍ حمدي متى ما بغيته","https://www.aldiwan.net/poem65959.html","البسيط"],[87,"سل الليل عن أفلاكه هل جرت سدى","https://www.aldiwan.net/poem7892.html","الطويل"],[47,"كيف به والزمان يهرب به","https://www.aldiwan.net/poem10913.html","المنسرح"],[51,"أضيع من العمر ما في يدي","https://www.aldiwan.net/poem62043.html","المتقارب"],[107,"أعيدوا الحديث وقولوا أجل","https://www.aldiwan.net/poem43082.html","المتقارب"],[107,"هواك هواك والدنيا شؤون","https://www.aldiwan.net/poem43372.html","الوافر"],[107,"أكل متوج يحمي البلادا","https://www.aldiwan.net/poem43373.html","الوافر"],[54,"أعاذل دع لومي وهاك وهات","https://www.aldiwan.net/poem27195.html","الطويل"],[50,"وقانص محتقر ذميم","https://www.aldiwan.net/poem65275.html","الرجز"],[48,"إذا وقت السعادة زال عني","https://www.aldiwan.net/poem23525.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39592","الهزج"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16677","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54840","الوافر"],[107,"أكل متوجٍ يحمي البلادا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54885&r=&rc=55",""],[147,"محلك من محل الشمس أعلا","https://www.aldiwan.net/poem11806.html","الوافر"],[203,"يا من لنضو طريح","https://www.aldiwan.net/poem45153.html","المجتث"],[371,"على نفسه بخل الباخل","https://www.aldiwan.net/poem17386.html","المتقارب"],[409,"أشموس من المعاني مضيه","https://www.aldiwan.net/poem33350.html","الخفيف"],[422,"سقى الله عهدا بالحمى قد تقدما","https://www.aldiwan.net/poem53888.html","الطويل"],[463,"حماها أن تشل وأن تراعا","https://www.aldiwan.net/poem56121.html","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122537","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64077","المنسرح"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59725","البسيط"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138069",""],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80248","الكامل"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/121109","الطويل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35705","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128701","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108954","الوافر"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49590","الرجز"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49579","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109753","الطويل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88650","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88647","الكامل"],[2483,"","https://poetry.dctabudhabi.ae/diwan/poem/144361","الطويل"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141206","الرجز"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83224","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201818","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201196","المنسرح"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200938","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200717","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202573","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204488","الطويل"],[3102,"","https://poetry.dctabudhabi.ae/diwan/poem/113894","الطويل"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71363","المنسرح"],[3311,"","https://poetry.dctabudhabi.ae/diwan/poem/203132","الوافر"],[3345,"","https://poetry.dctabudhabi.ae/diwan/poem/97845","الطويل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81296","المنسرح"],[4860,"لأول مره بكتبها","https://www.poetsgate.com/ViewPoem.aspx?id=32387",""],[4869,"اطراف المدينه","https://www.poetsgate.com/ViewPoem.aspx?id=151529",""],[4978,"يُحيي الليالي حوليَ السُّمّارُ","https://www.poetsgate.com/ViewPoem.aspx?id=177197",""],[5031,"شدوُ البلابل","https://www.poetsgate.com/ViewPoem.aspx?id=165139",""],[5031,"خيمة الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=165140",""],[5061,"ليل العنا","https://www.poetsgate.com/ViewPoem.aspx?id=155983",""],[3591,"إذا كنت لم أبرح من الدهر شاكيا","https://www.poetsgate.com/ViewPoem.aspx?id=149441",""],[5118,"فيّة الليمون","https://www.poetsgate.com/ViewPoem.aspx?id=129792",""],[5183,"الرزّء الأليم","https://www.poetsgate.com/ViewPoem.aspx?id=180263",""],[5198,"معايدة","https://www.poetsgate.com/ViewPoem.aspx?id=136231",""],[5237,"هو السعد كم من وضيع رفع","https://www.poetsgate.com/ViewPoem.aspx?id=113113",""],[1043,"خلود الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=89105",""],[5277,"\" من البغداديات \"","https://www.poetsgate.com/ViewPoem.aspx?id=210741",""],[5281,"يا رَامِشْ العَينين","https://www.poetsgate.com/ViewPoem.aspx?id=199605",""],[5353,"شكوى إلى سيد الكائنات محمد (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=212240",""],[5358,"المسارُ الصّعبُ","https://www.poetsgate.com/ViewPoem.aspx?id=202469",""],[5411,"مرامي الأناة","https://www.poetsgate.com/ViewPoem.aspx?id=187223",""],[5431,"فالق الشعر ...","https://www.poetsgate.com/ViewPoem.aspx?id=202794",""],[5616,"عهد","https://www.poetsgate.com/ViewPoem.aspx?id=203324",""],[5616,"إلى متى؟","https://www.poetsgate.com/ViewPoem.aspx?id=205030",""],[5671,"أضيق صدر الدهر والحزم واسع","https://www.poetsgate.com/ViewPoem.aspx?id=169351",""],[5720,"كَأَنَّكَ الشَّمسُ","https://www.poetsgate.com/ViewPoem.aspx?id=201280",""],[5815,"وصية الرحيل الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=200044",""],[5848,"خيوط الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=50585",""],[5943,"إلهي أبعد الواشينَ عنِّي","https://www.poetsgate.com/ViewPoem.aspx?id=11096",""],[5956,"الجمال الحنون","https://www.poetsgate.com/ViewPoem.aspx?id=184945",""],[5972,"متى مضر الحمراء تطلب ثارها","https://www.poetsgate.com/ViewPoem.aspx?id=170786",""],[6031,"حَمَامَاتِ شِيرازَ رِفْقاً بِنَا","https://www.poetsgate.com/ViewPoem.aspx?id=46324",""],[6239,"الشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75970&r=&rc=21",""],[5567,"أنا قلق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81752&r=&rc=25",""]],"verses":[["أَضيافُ سالِمِ في خَفضٍ وَفي دَعَةٍ","وَفي شَرابٍ وَلَحمٍ غَيرِ مَمنوعِ",0,"ع",1,1],["أضياءُ هَدِي أم ضياء نهارِ","وشذا المحامد أم شذا الأزهارِ",1,"ر",1,1],["أضيع وقد ضاعَ من منطقي","شذا ما بدا قبل في الباديه",2,"ي",2,0],["أَضيفَ بني عبدونَ أَحسن تزوُّداً","ولا تهتمم فيهم بطعن مَبَالِ",3,"ل",1,0],["أضيق بها حينا وطورا تضيق بي","كما عالج الغمد الحسام المهندا",4,"د",2,0],["أَضيعُ في مَعشَرٍ وَكَم بَلَدٍ","يُعَدُّ عودُ الكِباءِ مِن حَطَبِه",5,"ب",2,0],["أُضيعُ مِنَ العُمرِ ما في يَدي","وَأَطلُبُ ما لَيسَ لي في يَدِ",6,"د",1,1],["أَضيئوا الشِعابَ وَروضوا الرِكابَ","إِذا نَدَّ جامِحُها أَو جَفَلْ",7,"ل",1,0],["أَضِئ نَهجَ الحَياةِ لَنا فَإِنّا","أَضَلَّتنا الغَياهِبُ وَالدُجونُ",8,"ن",1,0],["أَضِئ قَصدَ السَبيلِ لَها وَأَلِّف","أَوابدَها فَتوشِكُ أَن تُعادى",9,"د",2,0],["أُضيفَت إِلى قارِيَّةٍ خَزَفِيَّةٍ","مُصَبَّغَةٍ بِالطينِ مُعتَجِراتِ",10,"ت",1,0],["أَضيَقُ أَرضاً مِن مَقامِ الميمِ","أَو نُقطَةٍ بَينَ جَناحِ الجيمِ",11,"م",1,0],["أَضَيفَ الفَقرِ ضَيفَنُكَ اِدِّلاجٌ","فَهَل لَكَ مِن ذُؤالَةَ في ضِفَنِّ",12,"ن",1,0],["أضىء في خاطرِ الدنيا","ووارِ سناك في جُرحي",13,"ي",1,0],["أضِياءَ النّهارِ أمْ وَضَحَ اللّؤ","لُؤِ أمْ كَوْنَهُ كثَغْرِ الحَبيبِ",14,"ب",1,0],["أُضيئَتْ لِلْهُدَى نَارُ","وَزِينَتْ لِلْقَرَى الدَّارُ",15,"ر",1,1],["أضيء قصد السبيل لها وألف","أوابدها فتوشك أن تعادي",16,"د",2,0],["أُضيفَ لَهُم إِلىالطَلَبِ اِجتِهادٌ","فَكانَ عَلى تَخَلُّفِهِم أَدَلّا",17,"ل",2,0],["أضيء كالنجم لكن","في وحدة وظلام",18,"م",1,0],["اضيَبخَلُ عَنها وَيُجي عَلَي","كَ لَقَد جَهِلَ الآمِلُ الجاهِلُ",19,"ل",1,0],["أضياء العلى بعثت بنظم","صغته من كواكب دريه",20,"ي",2,0],["أضيمَتْ كضَيْمي بين قومي وأُسْرتي","ومن ضَيْمها كادَت تبيحُ طمرَّتي",21,"ي",1,0],["أُضيفوا في العلا نسباً دخيلاً","فعدُّوها الزعانفَ والكُراعا",22,"ع",2,0],["أضياعُ الجَروبِ أو شِرَحُ القَح","مَة أو فالجَريبُ أو فالجَروبُ",23,"ب",1,0],["أضْيِعْ بماشٍ هناك قد لَثِقَتْ","نعلاه وابتلَّ طِمْرُهُ الخَلَق",24,"ق",1,0],["أضَيعُ العمر أشجاناً وطول بُكى","وعهدنا لم يزل قدْماً يُضيّعه",25,"ع",2,0],["أضيئى لنا وجه الحياة وجد دى","زمانا مضى كالحلم في عين حالم",26,"م",1,0],["أضيئى لنا وجه الحياة فانها","معودة ألا تضئ معالمي",26,"م",2,0],["أضيئى لنا وجده الحياة وأشرقي","شروق الأماني في الصدور القواتم",26,"م",1,0],["أضيئى لنا وجه الحياة وأجزلي","عطاياك فالأيام في كف عارم",26,"م",1,0],["أَضياءُ وَجهِكِ في الدجنَةِ أَسفَرا","أَم ذاكَ طَيفُكَ زارَ يَختَلِسُ السَرى",27,"ر",2,1],["أضيقُ بحمل الحادثات من النوى","وصدري من الأرض البسيطة أوسع",28,"ع",1,0],["أَضيقُ بِأَمري حينَ أَذكُرُ أَحمَداً","وَصَدري بِأَورادِ الأُمورِ رَحيبُ",29,"ب",1,0],["اضيفوا إلى معرفه فتعرفوا","بكل أداة عرفها منه ضائع",30,"ع",1,0],["أضيفٌ قلتُ ضيفٌ مستهامٌ","يريد العامرية لا سواها",31,"ا",3,0],["أضْيَقَ من عُذْرِ الكبير الغَزِلِ","إذا انتحى نَفْسَ امرىءٍ لم يُبَلِ",32,"ل",1,0],["أضْيَعَ مِنْ دَمْعٍ جَرَى في طَلَلِ","حِرْبَاؤُهُ كالضّارِعِ المُبْتَهِلِ",32,"ل",1,0],["أضِىءْ يا سراجَ الدينِ وابنَ سِراجِهِ","إذا اشتبهتْ تلكَ المسالكُ والسُّبْل",33,"ل",1,0],["أُضيفَ الدجا معنىً إلى لون شعرها","كما قد أضيفَ الفرق منها إلى الفجر",34,"ر",1,1],["أَضياء عيني قد ذهبت بنورها","فحسدت من يسعى بغير دَليل",35,"ل",1,0],["أَضياء عين المجد بعدك","طرفه اقذاه عائر",36,"ر",1,0],["أضيق بحمل الفادحات من النوى","وصدري من الأرض البسيطة أوسع",37,"ع",1,0],["أضيق من عيش اللبيب ثغرها","أضعف من حال الأديب خصرها",38,"ه",2,0],["أَضيقاً وَبُعداناً وَإِخلافَ غايَةٍ","وَنُكراً وَإِرهاقاً فَوَيلي لِشِقوَتي",39,"ت",2,0],["اضيق بأفراد الانام فإنما","حديثي لأجيال وليس لأفراد",40,"د",1,0],["أُضيع في كل ما أرى العُمرا","فلم أُمتّع سمعاً ولا بصرا",41,"ر",2,1],["أضيع العمر إنْ أمكثْ بأرضٍ","وأحرم من أفانين الجمال",42,"ل",1,1],["أضيعوا الوقت في طلب الملاهي","فليس لديكمُ عقلٌ يُضاع",43,"ع",1,0],["أضيّع مالي حيث أني ضائعٌ","أغيب عن الدنيا وأرجع أحيانا",44,"ن",2,0],["أضيعُ غدي دوماً بفكريَ في غد","فان غدي الحال الشقيُّ ببلبالي",45,"ل",2,0],["أضيعت فضاع المجد منا ولم نكن","شدادا إذا هم القضاء لقاها",46,"ا",3,0],["أَضْيَعُ شَيءٍ مَلاَمَةٌ بُذِلَتْ","لِحَاضِرِ الغَيِّ غَائِبِ الرُّشْدِ",47,"د",1,0],["أضيق بحمل الخطب ذرعاً","على أني لكل أسى حمول",48,"ل",1,0],["أضيف الدجى معنى إلى ليل شعره","فطال ولولا ذاك ما خص بالجر",49,"ر",1,1],["أَضيع شَيء في أَرضِها الذَهَب","يَجري بَعيداً عَن كَونِها الزَمَن",50,"ن",1,0],["أضيع وماهو بيديني..ولكن سنة اظروفي","إذا زادت في تقطيعي/,/,ألملم شعري وأجمعها",51,"ع",3,0],["اضيع في صوتك ولو ماتكلمت","اسمعك دايم مع نسانيس خلان",52,"ن",1,0],["أضيافي الدنيا بسائر أهلها","ومشاعري في عزفها أوتارُ",53,"ر",1,0],["أُضِيءُ إلى (العِراقِ) دُموعَ صَبْري","وَيجرحُني إلى وَطَني الوُصُولُ",54,"ل",1,0],["أضِيعُ وَخَلْفِي الموجُ خَيْلٌ جَموحَةٌ","فَلا خَيبَتي مَدٌّ وَلا فَرحتي جَزْرُ",55,"ر",1,0],["اضيق لكن . . .لا تضايقت خفيّت","ضيقات صدري . . والبيوت تتحابك",56,"ك",1,0],["أضيع رشادي في مكان سواك لو","ذكرتك يوماً أو خطرت بباليا",57,"ي",2,0],["أضيعني على الشارع رصيف الممتلي ./ باكون","__________ اَطل اَسْتَسْرق أخبارك من الشّباك ./ وسطوره",58,"ر",2,0],["أضَيف المصطفى والرمس نور","وجنات مرابعها النعيم",59,"م",1,0],["اضيع واذبل وانطفي في غيابك","وبكل تاكيد اغرق بكل تاكيد",60,"د",1,0],["أضيف إلى المصحف اسمي ومن","إلى ذي ارتفاع أضيف ارتفع",61,"ع",1,0],["أضيئي لنا وجه الحياة فإنها","معودة ألا تضيء معالمي",62,"م",2,0],["أضيئي لنا وجه الحياة وأشرقي","شروق الأماني في الصدور القواتمِ",62,"م",1,0],["أضئُ قوافياً ما دمتُ أرنو","لوجهكِ..مثلما القمرُ المنيرُ",63,"ر",1,0],["أَضيعْ حِينَ اَلْقَاهْ.. واتوه في مَعناه","وآه منِّه آه.. مَقلُوشْ(1) صنعاني",64,"ن",2,0],["أضيء ترابَك واستفتِ الزَّمَانَ فماً","وبددْ الظّلمَ والظّلماءَ والعَسسا",65,"س",2,0],["أضيّعْتَها مثلَ السنينَ أَمِ الّذي","سليلُ عِظَاتٍ للضَّياعِ سَلِيلُ؟",66,"ل",1,0],["أَضيعُ أَضيعُ بِدُنْيا هَواهُ","وَأعْشَقُ أعْشَقُ بالحُلْمِ قُرْبَهْ",67,"ب",2,0],["أضئنا هزيع الوقت شمعَ اتّقادنا","يذوبُ لكي تحظى بنورٍ حقائقُ",68,"ق",1,0],["أضيء له قناديل اعترافي","وأسرج ما استطعت إليه خيلي",69,"ل",2,0],["أَضيقُ بالحرفِ وأشجانِهِ","فالحرفُ في أفواهِنا ح