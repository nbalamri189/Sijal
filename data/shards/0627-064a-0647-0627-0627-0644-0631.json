poetsgate.com/ViewPoem.aspx?id=155487",""],[5409,"نحن في كل غدوةٍ ورواح","https://www.poetsgate.com/ViewPoem.aspx?id=155258",""],[5431,"هكذا تكلمت ريمادشت...","https://www.poetsgate.com/ViewPoem.aspx?id=202692",""],[5703,"في غياب القمر","https://www.poetsgate.com/ViewPoem.aspx?id=215498",""],[5720,"قادةٌ وأثَر *","https://www.poetsgate.com/ViewPoem.aspx?id=199812",""],[402,"ما لهذا الخافق الواهي يجب","https://www.poetsgate.com/ViewPoem.aspx?id=35115",""],[5790,"لا وعينيك ويكفى ذا القسم","https://www.poetsgate.com/ViewPoem.aspx?id=111869",""],[5900,"باسمكِ اللهمَّ يا ربَّ العبادْ","https://www.poetsgate.com/ViewPoem.aspx?id=150189",""],[5970,"أيها الراحلون جيلاً فجيلا","https://www.poetsgate.com/ViewPoem.aspx?id=130606",""],[5997,"كهف العبيد","https://www.poetsgate.com/ViewPoem.aspx?id=214282",""],[5997,"كهف العبيد","https://www.poetsgate.com/ViewPoem.aspx?id=215046",""],[6147,"رقاد في جوف الجنون","https://www.poetsgate.com/ViewPoem.aspx?id=213050",""]],"verses":[["أَيُّها الرائِحُ المُغِذُّ تَحَمَّل","حاجَةً لِلمُعَذَّبِ المُشتاقِ",0,"ق",1,1],["أَيُّها الراقِدونَ حَولي هَنيئاً","إِنَّ جَنبي عَن مَضجَعي مُتَجافِ",1,"ف",1,0],["أَيُّها الراقِدونَ حَولي أَعينو","ني عَلى اللّيلِ حِسبَةً وَاِئتِجارا",2,"ر",2,0],["أَيُّها الرافِلونَ في حُلَلِ الوَش","يِ يَجُرّونَ لِلذُيولِ اِفتِخارا",3,"ر",2,0],["أيها الرافعون شأني في نظ","مٍ منيرٍ بأبرع الأقوال",4,"ل",1,0],["أيُّهَا الرَّوْضُ كَنْ لِقَلْبِي سَلاماً","وَمَلاذاً مِن الشَّقَاءِ المُلازِمْ",5,"م",1,0],["أيُّها الراحل الذي عطَّلت من","بعده القاصدون شدّ الرحال",6,"ل",1,0],["أَيُّها الراحِلُ عَنّا","بَلَغَ الحُزنُ مَداه",7,"ه",1,0],["أيها الرافهون في أرض مصر","أيكم في النضال عنها القريع",8,"ع",1,0],["أيها الراحل المغذ تمهل","من لمن أبقيتهم يتكفل",9,"ل",1,0],["ايها الروض انك اليوم اورا","ق تهاوى سفعاً على اوراق",10,"ق",1,0],["ايها الراقد الكريم بقبر","لك مما في قبرك الله واق",10,"ق",1,0],["ايها الروح الذي استقرأته","باذلا في البحث عنه جلدي",11,"ي",1,1],["ايها الراحل الكريم رويدا","فاليك الحاجات لم ينقضينا",12,"ن",2,0],["ايها الراحل الثويّ سلام","قل اذا كنت اليوم تسمع جرسي",13,"س",2,0],["أيها الراحل العزيز عليها","سر برغم القلوب هذا الرحيل",14,"ل",1,0],["أَيُّها الراغِبُ الَّذي طَلَبَ الجو","دَ فَأَبلى كومَ المَطايا وَأَنضى",15,"ض",2,0],["أيها الراكعون في معبد الحرف","كفانا الدوار والإغماء",16,"ا",2,0],["أيها الريح أجل لكنما","هي حبي وتعلاتي ويأسي",17,"ي",1,0],["أَيُّها الرائِحُ المُجِدُّ اِبتِكارا","قَد قَضى مِن تِهامَةَ الأَوطارا",18,"ر",2,1],["أَيُّها الرَكبُ بَلِّغوها سَلامي","وَاِتَّقوا أَخذَ طَرفِها السَحّارا",19,"ر",2,0],["أَيُّها الرائِحانِ بِاللَومِ لوما","لا أَذوقُ المُدامَ إِلّا شَميما",20,"م",2,1],["أَيُّها الرَجلُ إِنَّما أَنتَ ذِئبٌ","في ذِئابٍ مِنَ المَعاشِرِ طُلسِ",21,"س",1,1],["أَيُّها الربع أَينَ أَهلك ساروا","قل إذا كنت قادِراً أَن تَقولا",22,"ل",2,0],["أَيُّهَا الرَّكبُ المخِبُّونَ","عَلَى الأَرضِ المجِدُّونَ",23,"ن",1,1],["أَيُّهَا الرَّاجِلُ الجَلِيلُ الَّذِي أَقْ","ضِيهِ نَزْراً مِنْ حَقِّهِ بِرِثَائِي",24,"ا",2,0],["أَيُّهَا الرَّاحِلُ الَّذِي مَلأَ العَصْ","رَ بِآثَارِهِ الرَّغَابِ الجِيَادِ",25,"د",1,0],["أيها الرَّاحِلُ مَا بَالُ احِجَى","غَلَبَ الحُزْنُ عَليْهِ فَانْتَحَبْ",26,"ب",1,0],["أَيُّهَا الرَّاجِعُ الكَرِيمُ إِلَيْه","إِلْقَ فِيه الصَّفَاءَ وَالْعَيْشَ رَغْدَا",27,"د",2,0],["أيها الرائدُ المُؤَمّل يا مَن","باسمهِ هودجُ العروبةِ يُحدي",28,"د",2,1],["أَيُّهَا الرَّاحِلُ الْكَرِيمُ لَقَدْ كُنْتَ","سَوَادَ الْعُيُونِ أَوْ إِنْسَانَه",29,"ن",2,0],["أيُّها الراكبونَ في طَلَبِ الْغَيْثِ","سِراعاً والغيثُ مِلْءُ الرِحالِ",30,"ل",1,0],["أيها الراحلُ الكريمُ، تَخيَّر","تَ لعمري مكانَ الاستشهاد",31,"د",1,0],["أيها الراكب المغذ إلينا","يا ترى هل شارفت ذاك الوادي",32,"د",2,0],["أيّها الركب ! يا شهيد المعالي !","هل رأيت الحياة شرّا صراحا !",33,"ح",2,0],["أيّها الركب ! نم هنيئا ودعنا","نعتسف بعدك الخطوب الجماحا",33,"ح",2,0],["أَيُّها الرَكبُ المَخِبّو","نَ عَلى الأَرضِ المُجِدّونا",34,"ن",2,1],["ايها الريم والحديث شجون","هل لما انت فاعل من جواز",35,"ز",1,0],["أيُّهَا الرَّائمُ التَّصَدِّيَ لِلش","شَيخِ أيَقظَانٌ أنتَ أم وَسنَانُ",36,"ن",1,0],["أَيُّها الرَّائِحُ الَّذي رَاحَتَاهُ","بِخِضَابِ الكُؤُوسِ مَخْضُوبَتانِ",37,"ن",1,0],["أَيُّها الراحِلُ الحَثيثُ رُويداً","وَأَصحَبنَّا وَلَو بِبَعضِ كَلامِ",38,"م",1,0],["أَيُّها الراحلُ الَّذي سارَ عَنَّا","نَحوَ عَرشٍ قَد طابَ فيهِ المُقامُ",39,"م",1,0],["أيُّها الراكبُ المخبُّ لِتُبْلِغْ","ركبَ سُعْدَى تحيةً من مشوقِ",40,"ق",1,1],["أيها الرعد إن تطل فسأشكو","ما أقاسيه للقريب السميع",41,"ع",1,0],["أَيُّها الرائِحُ المُجِد","دُ وَأَنفاسُنا مَعَه",42,"ع",2,1],["أيُّها الرسمُ تكلَّم فالبيانْ","من محيّا ناطقٍ لا مِن لِسانْ",43,"ن",1,1],["أَيُّها الراكب المجدار تحل من","شجر واقطع الفَيافي زَميلا",44,"ل",2,0],["أيها الراحلُ الظلوم","كيف لي أن أودعك",45,"ك",1,0],["أيّها الراتعُ في زهرِ الرياض","إِنّني أَرتعُ في زهرِ الكلم",46,"م",1,0],["أيها الراحلون عنّى رويدا","فمن الهجر ما يكون حراما",47,"م",2,0],["أيها الراحلون عني وأنتم","صفوة الكأس لذة وانسجاما",47,"م",2,0],["أيها الراحلون أغلَقَت الحا","نة أبوابها وباتت ظلاما",47,"م",2,0],["أيها الراحلون ما نمت عنكم","إنما نمت حيرة وانحطاما",47,"م",2,0],["أيها الراحلون عني وعن كأ","سي وحالي لا ترهقوني ملاما",47,"م",2,0],["أيها الراحلون لا تذكروني","شاديا يملأ الدنى أنغاما",47,"م",2,0],["أيها الراحلون لا تذكروا منّ","ي إلّا الأوجاع والأسقاما",47,"م",2,0],["أيها الراحلون إن مت يوماً","فلقد مِتُّ قبله أياما",47,"م",2,0],["أيها الراحلون مهما جفوتم","فأنا من عهدتموني غراما",47,"م",2,0],["أيها الراحل والغبرا","ء قبر فوق قبر",48,"ر",1,0],["أيها الراحل ماذا بع","د فقدان الحياه",48,"ه",1,0],["أيها الراحل والدنيا","بما فيه تهون",48,"ن",1,0],["أيّها الرَّكبُ بشَرقيّ الحِمى","هل لكمْ عِلْمٌ بأهلِ العَلمَيْن",49,"ن",1,0],["أَيُّها الرّاكبُ مهْلاً","واستمعْ منّي كَلاما",50,"م",2,1],["أيُّها الرّاكِبُ المُيمِّمُ كَرْما","نَ مُجِدّاً على الجيادِ العِتاقِ",51,"ق",1,1],["أيّها الرّاكبُ المُغِذُّ مُجِدّاً","وأَراه لعهدِ نجدٍ مُجِدّا",52,"د",2,0],["أَيُّها الراحِلونَ عَنّي وَيَحدو","في مَطاياهُم بِقَلبِيَ حادي",53,"د",2,1],["أيُّها الراكِبُ من قَلبي","جَمُوحاً ذا حِرانِ",54,"ن",1,0],["أَيُّها الرَكب قِفوا لي تَؤجزوا","بِتَلافي مُهجَة قَبل فَناها",55,"ا",3,0],["أَيُّها الركب حَدِثوني لَعَلَ ال","قَلب يَرتاح فَالحَديث شُجون",56,"ن",1,0],["أيها الراغب في نيل العلا","جدان الجد مفتاح الظفر",57,"ر",1,0],["أيُّها الرَّاحِلُ عنا في طريقٍ","مَنْ مَشَى فيها مُحَالٌ أن يَؤُوبا",58,"ب",2,0],["أيُّها الرَّبْعُ المُحيلُ","جَدَّ بي عنكَ الرَّحيلُ",59,"ل",1,1],["أيُّها الرَّامي قلبي عَبَثاً","بُؤْتَ بالوزر وقُلّدت أثاما",60,"م",2,0],["أيّها الراجون هذا فلك","دائر للناس في كل الأمور",61,"ر",1,0],["أيها الراكبُ تستنُّ بهِ","شطبةٌ مخطفَةٌ فتلاءُ وَجْنَا",62,"ن",2,0],["أيّها الرامي وما أجرَى دماً","لا تحصِّبْ قد بلغتَ الغرضا",63,"ض",2,0],["أيها الراكبُ المُغِذُّ على الأيْ","نِ لهُ بالنجاء حَثٌّ وكَدُّ",64,"د",1,0],["أيُّها الركبُ ثوبَا","هُ حريرٌ وحديدُ",65,"د",1,1],["أيُّها الرّاكب المغِذُّ على وج","ناءَ مثل العَلاةِ كالحرفِ نابِ",66,"ب",1,0],["أيها الركب الذي ودعنا","سائراً يقطع بيداً وأكاما",67,"م",2,0],["أيها الركب هذه دار سلمى","فانزلواها ما خاب فيها النزيل",68,"ل",1,0],["أيُّها الرَّاحلانِ عنَّا رُويداً","قد أذابت قلوبَنا الأشجانُ",69,"ن",1,0],["أيُّها الراحلُ الذي ضَرَبَ الأطنا","بَ بينَ القُلوبِ والأكبادِ",70,"د",1,0],["أيها الرَّاحلُ الذي زادُهُ التق","وَى إلى اللهِ والعَفافُ هَجينُ",71,"ن",1,0],["أَيها الرَّاحلُ إِن السَّعْ","دَ مِنْ تَحتِ لِوائِكْ",72,"ك",1,0],["أيها الرافع في المس","جد بالصوت العقيرهْ",73,"ر",2,1],["أيها الركب سر لكل البلاد","وانشر البشر في جميع العباد",74,"د",1,1],["أيُّها الراكبون أفحشَ ما يَرْ","كبُ من كانَ فاحشاً نجَّاشا",75,"ش",2,0],["أيّها الرائضُ العَزاءَ سَفاهاً","رُضْتَ مُستَصعَباً على مَن يروض",76,"ض",1,0],["أيها الراكبُ الحثيثُ إلى معْ","مدَ بِّلغْ مقالتي وكلامي",77,"م",2,1],["أَيُّها الراشِدُ في أَعمالِهِ","أَنتَ في الأَكوان رُوحٌ لِلرُشد",78,"د",1,0],["أيها الراحلون ردوا على ال","مشتاق قلباً أثخنتموه جراحا",79,"ح",2,0],["أيها الراحلون من بطن خبتٍ","فركاب النوى بهم تترامى",80,"م",2,1],["أيها الركب قفوا لي توجروا","بتلافي مهجةٍ قبل فناها",81,"ا",3,0],["أيها الراكب في الليل البهيم","ظهر بزلاء ونى عنها النسيم",82,"م",1,0],["أيها الركب على رمل الحما","وقفة أقضى بها حق الغرام",83,"م",1,1],["أيها الرب ربنا ما أعجبْ","في