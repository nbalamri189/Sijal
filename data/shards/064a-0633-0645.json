],[4044,"","https://poetry.dctabudhabi.ae/diwan/poem/105883","الرجز"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93768","السريع"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45046","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94792","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94564","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94793","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94393","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94670","الكامل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81916","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73418","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83154","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120363","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52145","الكامل"],[4750,"السيف الشقير","https://www.poetsgate.com/ViewPoem.aspx?id=180405",""],[4830,"لُغةُ العشق","https://www.poetsgate.com/ViewPoem.aspx?id=214827",""],[4927,"حبك","https://www.poetsgate.com/ViewPoem.aspx?id=29610",""],[4955,"يسمو الطبيب إذا ما كان ذا خلق","https://www.poetsgate.com/ViewPoem.aspx?id=197723",""],[4984,"أحلام الطفولة","https://www.poetsgate.com/ViewPoem.aspx?id=176011",""],[5057,"يا عُمَرُ .","https://www.poetsgate.com/ViewPoem.aspx?id=184030",""],[5074,"إلى ولدي","https://www.poetsgate.com/ViewPoem.aspx?id=153514",""],[5136,"أودى بحمد الله عامر","https://www.poetsgate.com/ViewPoem.aspx?id=121599",""],[5136,"ما هز عطفي ملة الحنفاء","https://www.poetsgate.com/ViewPoem.aspx?id=121489",""],[5136,"أيامنا بين أعراس وأفراج","https://www.poetsgate.com/ViewPoem.aspx?id=121540",""],[5283,"نسرين","https://www.poetsgate.com/ViewPoem.aspx?id=207578",""],[5285,"جمال","https://www.poetsgate.com/ViewPoem.aspx?id=203983",""],[5324,"أحلى الهوى.","https://www.poetsgate.com/ViewPoem.aspx?id=211180",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5373,"بلاغة القرآن وإعجازه","https://www.poetsgate.com/ViewPoem.aspx?id=186008",""],[5410,"همسات ناعمة","https://www.poetsgate.com/ViewPoem.aspx?id=152343",""],[5459,"غثاء","https://www.poetsgate.com/ViewPoem.aspx?id=199893",""],[5463,"من قصيدة نوره","https://www.poetsgate.com/ViewPoem.aspx?id=26995",""],[5542,"قالوا تطرف جيلنا","https://www.poetsgate.com/ViewPoem.aspx?id=10190",""],[5542,"يا قدس","https://www.poetsgate.com/ViewPoem.aspx?id=10200",""],[5717,"هوت الجباه على جمالك سجدا","https://www.poetsgate.com/ViewPoem.aspx?id=170582",""],[5721,"الرقص على حبال الموت","https://www.poetsgate.com/ViewPoem.aspx?id=214687",""],[5722,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=12685",""],[402,"لم يكفه ما كان حتى جاءه","https://www.poetsgate.com/ViewPoem.aspx?id=35699",""],[5818,"صوتكِ","https://www.poetsgate.com/ViewPoem.aspx?id=197052",""],[5943,"خفقُ القلبِ","https://www.poetsgate.com/ViewPoem.aspx?id=34275",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[5957,"أحتاج أن تكون لي الصديق","https://www.poetsgate.com/ViewPoem.aspx?id=183295",""],[5991,"يا ألمي منك إليك الفرار","https://www.poetsgate.com/ViewPoem.aspx?id=116385",""],[6031,"هَتَفَتْ بِدَمْعِ العَينِ وَهْي سَجُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=46292",""],[6038,"بيعة الخسراني","https://www.poetsgate.com/ViewPoem.aspx?id=26802",""],[6075,"نهر اشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=201155",""],[6102,"حُداءُ الجَثامِين !!","https://www.poetsgate.com/ViewPoem.aspx?id=183615",""],[6115,"يالله يالمعبود يارب الارباب","https://www.poetsgate.com/ViewPoem.aspx?id=181732",""],[6204,"إلى صديق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69140&r=&rc=12",""],[2220,"ويلتاح في جو السماءِ إذا انبرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11168&r=&rc=42",""]],"verses":[["يَسمو بِهِ قَولُ الخَطي","بِ وَتَستَطيلُ يَدُ المُشيرِ",0,"ر",1,0],["يَسْمو بهادِيهِ والأعناقُ خاضِعَةٌ","لِحافِرٍ بعُيونِ القَوْمِ مُنْتَعِلِ",1,"ل",1,0],["يَسْمُو فَتَتَّضِعُ الشَّوَامِخُ دُونَهُ","حَتَّى تَؤُوبَ بِذِلَّةِ الغيطَانِ",2,"ن",1,0],["يَسْمُو إلى عُلْيَا الأمُورِ بِفِطْنَةٍ","تَأتِي البَعِيدَ مِنَ الطَّريقِ الدَّانِي",3,"ن",2,0],["يُسْمِعُهُمْ مِنْ وَحْيِهِ مُنْشِداً","شِعْراً لَهُ فِي النَّفْسِ فِعْلُ المُدَامْ",4,"م",1,0],["يَسمو إِلى الشَرَفِ الأَقصى كَما نَظَر","أُدمٌ أَحَنَّ لَهُنَّ القانِصُ الوَتَرا",5,"ر",2,0],["يَسُمنَ كَما سامَ المَنيحانِ أَقدُحاً","نَحاهُنَّ مِن شَيبانَ سَمحٌ مُخالِعُ",6,"ع",1,0],["يُسَمّونَ الفُلَيسَ وَلا يُسَمّى","لَهُم عَبدُ المَليكِ وَلا هِشامُ",7,"م",1,0],["يُسَمّونَ المُغيرَةَ وَهوَ ظُلمٌ","وَيُنسى دَيسَمُ الإِسمِ القَديمِ",8,"م",1,0],["يسمّن بيت المال وهو هزيله","ويفعل أفعال الظّبا وهو هازل",9,"ل",1,0],["يَسْمو به جَدُّهُ فيَحْظى","وتارةً مجدُه فيَعْلى",10,"ا",1,0],["يَسْمعنَ أو يَسْتفدنَ منك شجا","والتمر يُمتار من قرى هجرِ",11,"ر",1,0],["يُسمعك الشدوَ في جوانبهِ","مُناغياتُ البُمُوم والزِّيَرَهْ",12,"ر",2,0],["يسمَّى الحقد عيباً وهْو مدحٌ","كما يدعون حلو الحق مرّا",13,"ر",2,0],["يسمو إلى المجد أقوام فتَلْهزُهم","أركانُه وابنُ يحيى غير ملهوزِ",14,"ز",1,1],["يسمعنا الشدو عنده غرِدٌ","كالسطر في المُسمعين لا اللَّحق",15,"ق",1,0],["يسمِّحن ذا البخلِ الرتوبِ وتارةً","يُشَجِّعنْ ذا الجبنِ الرَّجوفِ القوائمِ",16,"م",1,0],["يَسْمَعُ الأَحْزانَ تَبْكي","بَيْنَ أَعْماقِ القُلُوبْ",17,"ب",1,0],["يَسمونَ بِالأَدَبِ الجَديدِ وَتارَةً","يَبنونَ لِلأَدَبِ القَديمِ رِواقا",18,"ق",2,0],["يَسمَعُ اللَيلُ مِنهُ في الفَجرِ يا لَي","لُ فَيُصغي مُستَمهِلاً في فِرارِهِ",19,"ر",2,0],["يَسمى الحُسامَ وَلَيسَت مِن مُشابَهَةٍ","وَكَيفَ يَشتَبِهُ المَخدومُ وَالخَدَمُ",20,"م",1,0],["يَسمو بِكَفٍّ عَلى العافينَ حانِيَةٍ","تَهمي وَطَرفٍ إِلى العَلياءِ طَمّاحِ",21,"ح",1,0],["يُسَمّونَهُ بِاِسمِ الخَليفَةِ بَعدَ ما","رَعى الضَأنَ فيهِم ذا مَشيبٍ وَأَمرَدا",22,"د",2,0],["يَسمو لَها كُحلٌ بِغَيرِ تَكَحُّلِ","وَيُزينُها حُسنٌ بِغَيرِ تَحَسُّنِ",23,"ن",1,0],["يَسمو بها عن صِفاتِ العِينِ أنّ لها","عيناً يُسَفِّهُ منّا سحرُها الحُلُما",24,"م",2,0],["يَسمو بِكَ السَفّاحُ وَالمَنصورُ وَال","مَهدِيُّ وَالمَعصومُ وَالمَأمونُ",25,"ن",1,0],["يُسَمّونَني المَجنونَ حينَ يَرونَني","نَعَم بِيَ مِن لَيلى الغُداةَ جُنونُ",26,"ن",1,0],["يَسمرُ القومُ في الضّلالِ ويُمسِي","للذي أطلعَ النُّجومَ سميرا",27,"ر",2,0],["يسمو به حتى إذا","بوَّأهُ النجما",28,"ا",1,0],["يَسمون لِلسَلَفِ المُقَدْ","دَمِ ذي البَهاءِ وَذي التَهاوُل",29,"ل",1,0],["يَسِمُ الأَرضَ لَهُ","حافِرٌ مِثلَ القَدَح",30,"ح",1,0],["يُسَمَّونَ بِالسُؤّالِ في كُلِّ مَوطِنٍ","وَإِن كانَ فيهِم نابِهٌ وَجَليلُ",31,"ل",1,0],["يُسَمّي اِبنَهُ كِسرى فَقيرٌ مُمارِسٌ","شَقاءً وَأَسماءُ البَنينَ تُباحُ",32,"ح",1,0],["يُسَمّونَ بِالجَهلِ عَبدَ الرَحيمِ","وَعَبدَ العَزيزِ وَعَبدَ الصَمَد",33,"د",1,1],["يُسَمّي غَوِيٌّ مَن يُخالِفُ كافِراً","لَهُ الوَيلُ أَيُّ الناسِ خالٍ مِنَ الكُفرِ",34,"ر",1,0],["يَسمو وَيَذهَب موغلاً","فيصده الإعياء صدا",35,"د",2,0],["يُسَمَّوْنَ ثُوّاراً إذا ما تجهَّموا","لمغتصبٍ أو من عَذاب تألموا",36,"م",3,0],["يَسْمُو بِقَوْمٍ وَيَهْوِي آخَرُونَ بِهِ","كَالدَّهْرِ يَجْرِي بِمَيْسُورٍ وَمَعْسُورِ",37,"ر",1,0],["يَسْمُو إِلى نَجْمِ السَّمَاءِ وَيَنْثَنِي","فَيَزُورُ نَجمَ الأَرْضِ فِي الأَدْغَالِ",38,"ل",1,0],["يَسْمُوا بِهَا السَّجْنُ الْقَرِيبُ جِدَارُه","شَرَفاً إِلى سِجْنٍ بِغَيْرِ جِدَارِ",39,"ر",1,0],["يَسْمُو بمَا يَبْتَغيهِ","وَمَا يَقْصُرَ جُهْدَا",40,"د",2,0],["يَسْمَعُونَ الْمُحَاضَرَاتِ الْتِمَاساً","لِتَلاَفِي الإِغْوَاءِ بِالإِرْشَاد",41,"د",1,0],["يَسْمَعُ السُّفْنَ حَوْلَه ماخِراتٍ","مَنْ يُبَالِي بمِثْلهِ مَنْ يُبالِي",42,"ل",2,0],["يسمعُ الرَّقْصَ والأهَازيج تَشْدُو","بَيْنَ وَصْلِ الْهَوَى وهَجْرِ الدَّلالِ",42,"ل",1,0],["يسمو على الريبةِ والظُّنونِ","تحيةَ الوداع والحنين",43,"ن",1,0],["يسمح النعسة من عيني رشا","صائد في كل يوم اسدا",44,"د",2,0],["يسمو القويُّ وذاك حكم لم يدع","حتى الغصونَ فشذَّبت أوراقها",45,"ق",3,0],["يسمو الخيال بنا ويسمو جهُدهم","بِهمُ ، فكلُّ عنده منطاد",46,"د",1,0],["يسمِّى الداءَ والعللَ الوجاعا","ولم تكن الحتوفُ محلَّ شكٍّ",47,"ك",1,0],["يسمّون ثوّار إذا ما تجهّموا","لمغتصب ، أو من عذاب تألموا !",48,"م",3,0],["يسمع النا