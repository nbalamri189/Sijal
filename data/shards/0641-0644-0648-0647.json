{"poems":[[63,"شفاه قربا وقد أشفى على العطب","https://www.aldiwan.net/poem51799.html","البسيط"],[57,"","https://poetry.dctabudhabi.ae/diwan/poem/12466","الهزج"],[285,"ويوم أخذنا به فرصة","https://www.aldiwan.net/poem60709.html","المتقارب"],[463,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[1011,"","https://poetry.dctabudhabi.ae/diwan/poem/124610","الوافر"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28615","المتقارب"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113864","البسيط"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109846","الوافر"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59474","الطويل"],[4829,"الصمصامة (ملحمة بدر الكبرى)","https://www.poetsgate.com/ViewPoem.aspx?id=34259",""],[5216,"وقالتْ لماذا تَغارُ عَلَيّ","https://www.poetsgate.com/ViewPoem.aspx?id=187642",""],[6031,"بِرغمِ العَوَالِي والمُهَنَّدَةِ البُتْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=46342",""],[6056,"خشف المها","https://www.poetsgate.com/ViewPoem.aspx?id=130384",""]],"verses":[["فلو هَتفتَ بها في يومِ مَلحَمةٍ","قامت مَقامَ القَنا والبِيضِ واليَلَبِ",0,"ب",1,0],["فَلَو هَيّا لَهُ اللَهُ","مِنَ التَوفيقِ أَسبابا",1,"ب",2,0],["فَلَوْ هَمَّ هَمٌّ بِنا لَمْ يَجْدْ","طَرِيقاً إِلَيْنا بِها يَخْلُصُ",2,"ص",1,0],["فلو هبَّ مَيْتٌ من كراه فقام أو","تطلَّعَ مرموسُ الجبين تريبُ",3,"ب",1,0],["فلو هز الفتى الهمزيّ عضبي","فصاحته وساعده القصيد",4,"د",1,0],["فَلَو هَرَبَ البَدرُ مِن خَوفِهِ","وَمالَ عَلى صَوبِهِ ما اهتَدى",5,"ا",1,0],["فلو هلال السما رام الهبوط به","لم ترضه دملجا في زندها الخود",6,"د",1,0],["فلو هي انصفتك غدت مثالاً","لينصبه الصحاب على ثراكا",7,"ك",2,0],["فلو هوتِ الأفلاك فوقيَ لم أبتْ","كليلاً ولم أجزع ولم أتخشعِ",8,"ع",1,0],["فلوهي بالتمني الكل تسلطن","ولكن تؤخذ الدنيا تشارس",9,"س",1,0],["فلو هامَ شِعْري بليلى وهندٍ","لأنسيتُ قَيْسًا معَ العُمَرِيّ",10,"ي",1,0],["فَلَوْ هَمَّ غَيرُ الحُوتِ بِي لتَوَاثَبَتْ","رِجَالٌ يَخُوضُونَ الحِمَامَ إلى نَصْرِي",11,"ر",2,0],["فلوة فلاة ٍ ! توّها ، غر ٍ، عسيف","معفاة ٍ الخدمة ، وكثر،، إرهاقها",12,"ق",3,0]]}