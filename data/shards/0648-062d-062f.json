33.html","الرمل"],[501,"ما للقلوب عن الحبيب غطاء","https://www.aldiwan.net/poem38105.html","الكامل"],[515,"ويا وميض بروق المزن إن سفرت","https://www.aldiwan.net/poem20795.html","البسيط"],[515,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[515,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[539,"حي فيها الإخلاص ولاإقداما","https://www.aldiwan.net/poem47934.html","عموديه"],[552,"ألا يا لقومي لاعتنان النوائب","https://www.aldiwan.net/poem47146.html","الطويل"],[552,"يا ابن عبد العزيز إن فؤادي","https://www.aldiwan.net/poem47900.html","الخفيف"],[554,"عجبا لطيف خيالك المتجانب","https://www.aldiwan.net/poem68410.html","الكامل"],[559,"ربما يكذب حسادي علي","https://www.aldiwan.net/poem33569.html","الرمل"],[559,"قل لمن قال عن ذوي العرفان","https://www.aldiwan.net/poem33820.html","الخفيف"],[559,"نحن أهل العلوم بالإلهام","https://www.aldiwan.net/poem33878.html","الخفيف"],[559,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[559,"إنما وحدة الوجود لدينا","https://www.aldiwan.net/poem34218.html","الخفيف"],[559,"كل قول على العقول يشق","https://www.aldiwan.net/poem34304.html","الخفيف"],[559,"إن ذلي في حب علوة عز","https://www.aldiwan.net/poem34457.html","الخفيف"],[559,"إني أنا فرضه وتقديره","https://www.aldiwan.net/poem34467.html","المنسرح"],[562,"طاف الخيالان فهاجا سقما","https://www.aldiwan.net/poem27844.html","الرجز"],[568,"أخي بل رئيسي بل أميري وسيدي","https://www.aldiwan.net/poem69543.html","الطويل"],[568,"بأبي أنت تباغضت","https://www.aldiwan.net/poem69622.html","مجزوء الرمل"],[568,"عندي أخ لك ماجد","https://www.aldiwan.net/poem69657.html","الكامل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"إنني من عتقائك","https://www.aldiwan.net/poem3042.html","مجزوء الرمل"],[576,"لست الملوم بما تجني علي بصري","https://www.aldiwan.net/poem3066.html","البسيط"],[576,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"],[587,"قمر يجلو دجى الغلس","https://www.aldiwan.net/poem17971.html","المديد"]],"verses":[["وحدّة فطنةٍ في الذهن إن لم","تكن بصراً فكالبصر انقلابا",0,"ب",2,0],["وَحَديثٍ كانَ مِن لَذَّتِهِ","أُحُدٌ يُصغي إِلَينا أُذُنا",1,"ن",2,0],["وَحَدا البَرقُ كُلَّ يَومٍ إِلَيهِ","عَجِلَ القَطرِ بِالنَسيمِ الواني",2,"ن",2,0],["وَحَدا بِآلِ المُنذِرَينِ فَوَدَّعوا","بِالحيرَةِ البَيضاءِ كُلَّ مَقيلِ",3,"ل",1,0],["وَحَديثُ فَضلي ضارِبٌ بِعُروقِهِ","في الأَرضِ يَنقُلُهُ المَطيُّ البُزَّلُ",4,"ل",1,0],["وَحَدا النُهى وَالشَيبُ راحِلَتي","وَعَلى اِستِقاماتي عَلى الجَدَدِ",5,"د",1,0],["وَحدَّثَني أَترابُها أَنَّ ريقَها","عَلى ما حَكى عودُ الأراكِ لَذيذُ",6,"ذ",1,0],["وحدي هنا يا ليل وحدي","ما بين آلامي وسهدي",7,"د",2,1],["وحدي وأموات المنى","والذكريات السود عندي",7,"د",2,0],["وحدتي صمت يغني ورؤى من","عصا \" موسى \" وعجل \" السامري \"",8,"ر",2,0],["وحدتي وحي ودنيا من هدى","وضلال ويقين حائر",8,"ر",1,0],["وحدتي أرجوحة من فكر","دائرات كالشروق الدائر",8,"ر",1,0],["وَحَدَّثتَني يا سَعدُ عَنها فَزِدتَني","جُنوناً فَزِدني مِن حَديثِكَ يا سَعدُ",9,"د",1,1],["وَحَدَّثتَني يا قَلبُ أَنَّكَ صابِرٌ","عَلى البَينِ مِن لُبنى فَسَوفَ تَذوقُ",10,"ق",1,0],["وحّدْتُ شخْصَكَ في الفؤادِ لعلّهُ","يُنْجِيهِ منْ نارِ الجَوى التّوحيدُ",11,"د",1,0],["وحَدَوْها مثْلَ القِسيّ ضُموراً","قدْ بَرَتْ منْهُمُ سِهامَ قِداحِ",12,"ح",1,0],["وَحَديثِ عَهدٍ بِالفِطامِ كَأَنَّما","قَد صيغَ مِن صَدفِيةٍ بَيضاءِ",13,"ا",2,1],["وَحَديثُ الرَكبِ يَومَ هَن","وَحَديثٌ ما عَلى قِصَرِه",14,"ر",2,0],["وَحَدِّث بِأَن زالَت بِلَيلٍ حُمولُهُم","كَنَخلٍ مِنَ الأَعراضِ غَيرِ مُنَبِّقِ",15,"ق",1,0],["وُحِّدَتْ في اَحْمِرَارِهَا صِبْغَةُ البِرِّ","فَلَوْنُ الْهِلاَلِ لُوْنُ الصَّلِيبِ",16,"ب",1,0],["وَحَدِّثِ الشَّرْقَ وَالأَقْوَامُ مُصْغِيَةً","عَمَّا أحَدَّ لَهُ فِيهَا من الشَّانِ",17,"ن",1,0],["وَحَدِّثِ الشَّرْقَ وَالأَقْوَامُ مُصْغِيَةٌ","عَمَّا أَجَدَّ لَهُ فِيهَا مِنَ الشَّانِ",18,"ن",1,0],["وَحَدَّثَ قَوْمَهُ الصُّعْلُوكُ مِنْهُمُ","بِمَا كَانَتْ وَقَائِعُهُ الجِسَامُ",19,"م",1,0],["وحدة لا يَفُلّها المتوالي","من صروف الدهور والأزمان",20,"ن",1,0],["وحدة جاءنا من الله فيها","مرسل بالكتاب والفرقان",20,"ن",1,0],["وَحَدراءُ لَو لَم يُنجِها اللَهُ بُرِّزَت","إِلى شَرِّ ذي حَرثٍ دَمالاً وَمَزرَعا",21,"ع",2,0],["وحديثهن إذا التقين","تهاتف البيض الغرائرْ",22,"ر",1,1],["وحديقة واصلت خلوتها","ما بين مغتبق ومصطبح",23,"ح",1,1],["وحدّثني من ثغره ورضابه","عن الجوهريّ المنتقى والمبرَّد",24,"د",1,0],["وحدَّثنا يومَ الفخار جبينه","أحاديث صدق عن طهارة محتد",24,"د",1,0],["وحَّدته في الورى بالقصدِ وارتفعت","وسائلي فيه عن زيغٍ وإشراك",25,"ك",1,0],["وحَدَتْ شَمولٌ بالشَّمول لمعشر","غيري وفيما دون ذلك مَغْضبُ",26,"ب",1,0],["وحدثتُه عن أخته فصَدَقته","وأمحضُ نصح الناصحين المصرَّحُ",27,"ح",1,0],["وحديثُها السحرُ الحلال لوَ اَنَّها","لم تجن قتلَ المسلم المتحرِّزِ",28,"ز",1,1],["وحدا ينُصُّ رِكابه وجهَ الضحى","يأْبى الكرى لمطيّه نصَّاص",29,"ص",1,0],["وحدث الناس به فاخراً","فإنه ما شئت من سُمْعه",30,"ع",2,0],["وحدثتُ نُدماني أحاديثَ ما مضى","من العيشِ أقْفُوها بأنَّةِ ثاكلِ",31,"ل",1,0],["وَحَدَّثتُهُنَّ أَنَّني ذو أَمانَةٍ","كَريمٌ فَما يَخشَينَ خُلفي وَلا غَدري",32,"ر",2,0],["وَحَدَثٍ خدَعتُهُ فَاِنخَدَعا","حَتّى إِذا ما شَبَّ عَضَّ الإِصبَعا",33,"ع",2,0],["وَحَديثُ أَسلافٍ قَدِ اِلتَحَفوا الفَنا","فَهُمُ سَواءٌ في القِياسِ وَجُرهُمُ",34,"م",1,0],["وَحَديثُ مَن يُبدي الشَماتَةَ بي","قَد زادَني هَمّاً عَلى هَمِّ",35,"م",1,0],["وَحَديثُها كَالقَطرِ يَسمَعُهُ","راعي سِنينَ تَتابَعَت جَدبا",36,"ب",2,1],["وحدة الشعب قوّة","تدرأ الحيف ان دهم",37,"م",1,0],["وحديد عليه يختلف الده","ر ويفنى الزمان قرنا فقرنا",38,"ن",2,0],["وَحَدَّت ما هُوَ كَالحَمّا","مِ وَالماءِ وَظيفَه",39,"ف",2,0],["وَحَديثٌ ساعَةَ الضيقِ مَعَه","يَملَلأُ العَيشَ نَعيماً وَسَعَه",40,"ه",1,0],["وَحَديثاً كَرِواياتِ الهَوى","جَدَّ لِلصَبِّ حَنينٌ فَرواها",41,"ا",3,0],["وَحِدنَ بِالراشِدِ الفاروقِ عَن رُشدٍ","في المَوتِ وَهوَ يَقينٌ غَيرُ مُنبَهِمِ",42,"م",1,0],["وَحَديقَةُ الفُرقانِ ضاحِكَةُ الرُبا","بِالتُرجُم انِ شَذِيَّةٌ غَنّاءُ",43,"ا",2,0],["وَحَديثُهُم مِسكُ النَدِي","يِ وَعَنبَرٌ في المَحفِلِ",44,"ل",1,0],["وَحَدَّثَتِ المَمالِكُ آخِذاتِ","عُلومَ الحَربِ عَنكُمُ وَالفُنونا",45,"ا",1,0],["وحدته في نوعه","وهو كثير في العدد",46,"د",1,0],["وحدَّثتُ نفسي بالأمانِيّ ضَلَّةً","وليس حديثُ النفسِ غيرَ ضَلالِ",47,"ل",1,0],["وحديقةٍ للزعفران تأرَّجَتْ","وتبرَّجَتْ في نسجِ وَشْيٍ مُونِقِ",48,"ق",1,1],["وَحَديثٍ عَن أَوَّليكَ يُقَهّي","عَن سَماعِ الحَديثِ يُنثى وَيُغثي",49,"ث",2,0],["وَحَدَّثوها بِالدَستَبانِ وَبِالصَن","نِ فَكادَت تُشفى عَلى التَلَفِ",50,"ف",1,0],["وَحَدا الغَمامُ إِلى الثُغورِ رِكابَهُ","حَتّى أَناخَ بِعَلوِها فَسَقاكا",51,"ك",2,0],["وَحَديثي نِفسي بِأَن سَوفَ أُكفى","حَيفَ قاضِيَّ وَاِستِطالَةَ خَصمي",52,"م",2,0],["وَحَديثُها كَالغَيثِ جادَ بِوَبلِهِ","في حادِثِ المَحلِ الشَديدِ غَمامُ",53,"م",1,0],["وَحَديثُ مَجدٍ عَنكَ أَفرَطَ حُسنُهُ","حَتّى ظَنَنّا أَنَّهُ مَوضوعُ",54,"ع",1,0],["وحدويون! والبلاد شظاي","كل جزءٍ من لحمها أجزاء",55,"ا",2,0],["وحَدائِقٍ ضَرَبَتْ ضُروبُ جَمالِها","سوراً عليك من اللَّذاذَةِ مُحدِقا",56,"ق",2,0],["وحديث كل سماحة كذب","إلا حديث عنه تؤثره",57,"ر",2,0],["وحديثٌ كأنَّه زَهَرُ السَّو","سَنِ حُسناً أو لؤلؤٌ مَنثورُ",58,"ر",1,0],["وحدائقٍ يَسبيكَ وَشْيُ بُرودِها","حتَّى تَسُبَّ لها سبائبَ عَبقَرِ",59,"ر",1,0],["وحدوُ المدام إذا ما ونَت","ركائبها بفنون الغناء",60,"ا",2,0],["وَحداً كَمِقلاءِ الوَليدِ مُكَدَّمٌ","جَأبٌ أَطاعَ لَهُ الجَميمُ مُحَنَّبُ",61,"ب",1,0],["وَحِدتَ عَنِ المَوتِ الَّذي لَن تَفوتَهُ","وَلابُدَّ مِمّا أَنتَ عَنهُ تَحيدُ",62,"د",1,0],["وحديثٍ لم يدر لي في الظنون","يا طويلَ الهجر يا مُرَّ الغياب",63,"ب",1,0],["وحدي وقد أقسمتُ لن تعرفي","وما الذي يجديك لو تعرفين",64,"ن",1,0],["وحديثُ السّماع عنك عريضٌ","ضاقَ عن بعضه فسيحُ الكلامِ",65,"م",1,0],["وَحَديثٍ كَأَنَّهُ قِطَعُ الرّو","ضِ إذا اخضَلَّ مِن نَداهُ البكورُ",66,"ر",1,0],["وَحدي وَقَفتُ وَلَم أَقُل مِن عَبرَةٍ","وَقَفَت حَشايَ بِها لِحادينا قِفِ",67,"ف",1,0],["وحدُّها مِنْ قِبلةٍ مِلْكُ التقي","وحائزُ الروميّ حدُّ المشرقِ",68,"ق",1,0],["وَحَديثٍ بِمِثلِهِ تَنزِلُ العُص","مُ رَخيمٍ يَشوبُ ذَلِكَ حِلمُ",69,"م",1,0],["وَحَدِّثيهِ بِما حُدِّثتُ وَاِستَمِعي","ماذا يَقولُ وَلا تَعيِي بِهِ جَدَلا",70,"ل",2,0],["وَحِد رَهبَةً عَ