[556,"نحن أهل العلوم بالإلهام","https://www.aldiwan.net/poem33878.html","الخفيف"],[556,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[556,"إنما وحدة الوجود لدينا","https://www.aldiwan.net/poem34218.html","الخفيف"],[556,"كل قول على العقول يشق","https://www.aldiwan.net/poem34304.html","الخفيف"],[556,"إن ذلي في حب علوة عز","https://www.aldiwan.net/poem34457.html","الخفيف"],[556,"إني أنا فرضه وتقديره","https://www.aldiwan.net/poem34467.html","المنسرح"],[559,"طاف الخيالان فهاجا سقما","https://www.aldiwan.net/poem27844.html","الرجز"],[565,"أخي بل رئيسي بل أميري وسيدي","https://www.aldiwan.net/poem69543.html","الطويل"],[565,"بأبي أنت تباغضت","https://www.aldiwan.net/poem69622.html","مجزوء الرمل"],[565,"عندي أخ لك ماجد","https://www.aldiwan.net/poem69657.html","الكامل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"إنني من عتقائك","https://www.aldiwan.net/poem3042.html","مجزوء الرمل"],[573,"لست الملوم بما تجني علي بصري","https://www.aldiwan.net/poem3066.html","البسيط"],[573,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"],[584,"قمر يجلو دجى الغلس","https://www.aldiwan.net/poem17971.html","المديد"]],"verses":[["وَحَديثٍ كانَ مِن لَذَّتِهِ","أُحُدٌ يُصغي إِلَينا أُذُنا",0,"ن",2,0],["وَحَدا البَرقُ كُلَّ يَومٍ إِلَيهِ","عَجِلَ القَطرِ بِالنَسيمِ الواني",1,"ن",2,0],["وَحَدا بِآلِ المُنذِرَينِ فَوَدَّعوا","بِالحيرَةِ البَيضاءِ كُلَّ مَقيلِ",2,"ل",1,0],["وَحَديثُ فَضلي ضارِبٌ بِعُروقِهِ","في الأَرضِ يَنقُلُهُ المَطيُّ البُزَّلُ",3,"ل",1,0],["وَحَدا النُهى وَالشَيبُ راحِلَتي","وَعَلى اِستِقاماتي عَلى الجَدَدِ",4,"د",1,0],["وَحدَّثَني أَترابُها أَنَّ ريقَها","عَلى ما حَكى عودُ الأراكِ لَذيذُ",5,"ذ",1,0],["وحدي هنا يا ليل وحدي","ما بين آلامي وسهدي",6,"ي",1,1],["وحدي وأموات المنى","والذكريات السود عندي",6,"ي",1,0],["وَحَدَّثتَني يا سَعدُ عَنها فَزِدتَني","جُنوناً فَزِدني مِن حَديثِكَ يا سَعدُ",7,"د",1,1],["وَحَدَّثتَني يا قَلبُ أَنَّكَ صابِرٌ","عَلى البَينِ مِن لُبنى فَسَوفَ تَذوقُ",8,"ق",1,0],["وحّدْتُ شخْصَكَ في الفؤادِ لعلّهُ","يُنْجِيهِ منْ نارِ الجَوى التّوحيدُ",9,"د",1,0],["وحَدَوْها مثْلَ القِسيّ ضُموراً","قدْ بَرَتْ منْهُمُ سِهامَ قِداحِ",10,"ح",1,0],["وَحَديثِ عَهدٍ بِالفِطامِ كَأَنَّما","قَد صيغَ مِن صَدفِيةٍ بَيضاءِ",11,"ا",2,1],["وَحَديثُ الرَكبِ يَومَ هَن","وَحَديثٌ ما عَلى قِصَرِه",12,"ر",2,0],["وَحَدِّث بِأَن زالَت بِلَيلٍ حُمولُهُم","كَنَخلٍ مِنَ الأَعراضِ غَيرِ مُنَبِّقِ",13,"ق",1,0],["وُحِّدَتْ في اَحْمِرَارِهَا صِبْغَةُ البِرِّ","فَلَوْنُ الْهِلاَلِ لُوْنُ الصَّلِيبِ",14,"ب",1,0],["وَحَدِّثِ الشَّرْقَ وَالأَقْوَامُ مُصْغِيَةً","عَمَّا أحَدَّ لَهُ فِيهَا من الشَّانِ",15,"ن",1,0],["وَحَدِّثِ الشَّرْقَ وَالأَقْوَامُ مُصْغِيَةٌ","عَمَّا أَجَدَّ لَهُ فِيهَا مِنَ الشَّانِ",16,"ن",1,0],["وَحَدَّثَ قَوْمَهُ الصُّعْلُوكُ مِنْهُمُ","بِمَا كَانَتْ وَقَائِعُهُ الجِسَامُ",17,"م",1,0],["وحدة لا يَفُلّها المتوالي","من صروف الدهور والأزمان",18,"ن",1,0],["وحدة جاءنا من الله فيها","مرسل بالكتاب والفرقان",18,"ن",1,0],["وَحَدراءُ لَو لَم يُنجِها اللَهُ بُرِّزَت","إِلى شَرِّ ذي حَرثٍ دَمالاً وَمَزرَعا",19,"ع",2,0],["وحديثهن إذا التقين","تهاتف البيض الغرائرْ",20,"ر",1,1],["وحديقة واصلت خلوتها","ما بين مغتبق ومصطبح",21,"ح",1,1],["وحدّثني من ثغره ورضابه","عن الجوهريّ المنتقى والمبرَّد",22,"د",1,0],["وحدَّثنا يومَ الفخار جبينه","أحاديث صدق عن طهارة محتد",22,"د",1,0],["وحَّدته في الورى بالقصدِ وارتفعت","وسائلي فيه عن زيغٍ وإشراك",23,"ك",1,0],["وحَدَتْ شَمولٌ بالشَّمول لمعشر","غيري وفيما دون ذلك مَغْضبُ",24,"ب",1,0],["وحدثتُه عن أخته فصَدَقته","وأمحضُ نصح الناصحين المصرَّحُ",25,"ح",1,0],["وحديثُها السحرُ الحلال لوَ اَنَّها","لم تجن قتلَ المسلم المتحرِّزِ",26,"ز",1,1],["وحدا ينُصُّ رِكابه وجهَ الضحى","يأْبى الكرى لمطيّه نصَّاص",27,"ص",1,0],["وحدث الناس به فاخراً","فإنه ما شئت من سُمْعه",28,"ع",2,0],["وحدثتُ نُدماني أحاديثَ ما مضى","من العيشِ أقْفُوها بأنَّةِ ثاكلِ",29,"ل",1,0],["وَحَدَّثتُهُنَّ أَنَّني ذو أَمانَةٍ","كَريمٌ فَما يَخشَينَ خُلفي وَلا غَدري",30,"ر",2,0],["وَحَدَثٍ خدَعتُهُ فَاِنخَدَعا","حَتّى إِذا ما شَبَّ عَضَّ الإِصبَعا",31,"ع",2,0],["وَحَديثُ أَسلافٍ قَدِ اِلتَحَفوا الفَنا","فَهُمُ سَواءٌ في القِياسِ وَجُرهُمُ",32,"م",1,0],["وَحَديثُ مَن يُبدي الشَماتَةَ بي","قَد زادَني هَمّاً عَلى هَمِّ",33,"م",1,0],["وَحَديثُها كَالقَطرِ يَسمَعُهُ","راعي سِنينَ تَتابَعَت جَدبا",34,"ب",2,1],["وحدة الشعب قوّة","تدرأ الحيف ان دهم",35,"م",1,0],["وحديد عليه يختلف الده","ر ويفنى الزمان قرنا فقرنا",36,"ن",2,0],["وَحَدَّت ما هُوَ كَالحَمّا","مِ وَالماءِ وَظيفَه",37,"ف",2,0],["وَحَديثٌ ساعَةَ الضيقِ مَعَه","يَملَلأُ العَيشَ نَعيماً وَسَعَه",38,"ه",1,0],["وَحَديثاً كَرِواياتِ الهَوى","جَدَّ لِلصَبِّ حَنينٌ فَرواها",39,"ا",3,0],["وَحِدنَ بِالراشِدِ الفاروقِ عَن رُشدٍ","في المَوتِ وَهوَ يَقينٌ غَيرُ مُنبَهِمِ",40,"م",1,0],["وَحَديقَةُ الفُرقانِ ضاحِكَةُ الرُبا","بِالتُرجُم انِ شَذِيَّةٌ غَنّاءُ",41,"ا",2,0],["وَحَديثُهُم مِسكُ النَدِي","يِ وَعَنبَرٌ في المَحفِلِ",42,"ل",1,0],["وَحَدَّثَتِ المَمالِكُ آخِذاتِ","عُلومَ الحَربِ عَنكُمُ وَالفُنونا",43,"ا",1,0],["وحدته في نوعه","وهو كثير في العدد",44,"د",1,0],["وحدَّثتُ نفسي بالأمانِيّ ضَلَّةً","وليس حديثُ النفسِ غيرَ ضَلالِ",45,"ل",1,0],["وحديقةٍ للزعفران تأرَّجَتْ","وتبرَّجَتْ في نسجِ وَشْيٍ مُونِقِ",46,"ق",1,1],["وَحَديثٍ عَن أَوَّليكَ يُقَهّي","عَن سَماعِ الحَديثِ يُنثى وَيُغثي",47,"ي",1,0],["وَحَدَّثوها بِالدَستَبانِ وَبِالصَن","نِ فَكادَت تُشفى عَلى التَلَفِ",48,"ف",1,0],["وَحَدا الغَمامُ إِلى الثُغورِ رِكابَهُ","حَتّى أَناخَ بِعَلوِها فَسَقاكا",49,"ك",2,0],["وَحَديثي نِفسي بِأَن سَوفَ أُكفى","حَيفَ قاضِيَّ وَاِستِطالَةَ خَصمي",50,"ي",1,0],["وَحَديثُها كَالغَيثِ جادَ بِوَبلِهِ","في حادِثِ المَحلِ الشَديدِ غَمامُ",51,"م",1,0],["وَحَديثُ مَجدٍ عَنكَ أَفرَطَ حُسنُهُ","حَتّى ظَنَنّا أَنَّهُ مَوضوعُ",52,"ع",1,0],["وحدويون! والبلاد شظاي","كل جزءٍ من لحمها أجزاء",53,"ا",2,0],["وحَدائِقٍ ضَرَبَتْ ضُروبُ جَمالِها","سوراً عليك من اللَّذاذَةِ مُحدِقا",54,"ق",2,0],["وحديث كل سماحة كذب","إلا حديث عنه تؤثره",55,"ر",2,0],["وحديثٌ كأنَّه زَهَرُ السَّو","سَنِ حُسناً أو لؤلؤٌ مَنثورُ",56,"ر",1,0],["وحدائقٍ يَسبيكَ وَشْيُ بُرودِها","حتَّى تَسُبَّ لها سبائبَ عَبقَرِ",57,"ر",1,0],["وحدوُ المدام إذا ما ونَت","ركائبها بفنون الغناء",58,"ا",2,0],["وَحداً كَمِقلاءِ الوَليدِ مُكَدَّمٌ","جَأبٌ أَطاعَ لَهُ الجَميمُ مُحَنَّبُ",59,"ب",1,0],["وَحِدتَ عَنِ المَوتِ الَّذي لَن تَفوتَهُ","وَلابُدَّ مِمّا أَنتَ عَنهُ تَحيدُ",60,"د",1,0],["وحديثٍ لم يدر لي في الظنون","يا طويلَ الهجر يا مُرَّ الغياب",61,"ب",1,0],["وحدي وقد أقسمتُ لن تعرفي","وما الذي يجديك لو تعرفين",62,"ن",1,0],["وحديثُ السّماع عنك عريضٌ","ضاقَ عن بعضه فسيحُ الكلامِ",63,"م",1,0],["وَحَديثٍ كَأَنَّهُ قِطَعُ الرّو","ضِ إذا اخضَلَّ مِن نَداهُ البكورُ",64,"ر",1,0],["وَحدي وَقَفتُ وَلَم أَقُل مِن عَبرَةٍ","وَقَفَت حَشايَ بِها لِحادينا قِفِ",65,"ف",1,0],["وحدُّها مِنْ قِبلةٍ مِلْكُ التقي","وحائزُ الروميّ حدُّ المشرقِ",66,"ق",1,0],["وَحَديثٍ بِمِثلِهِ تَنزِلُ العُص","مُ رَخيمٍ يَشوبُ ذَلِكَ حِلمُ",67,"م",1,0],["وَحَدِّثيهِ بِما حُدِّثتُ وَاِستَمِعي","ماذا يَقولُ وَلا تَعيِي بِهِ جَدَلا",68,"ل",2,0],["وَحِد رَهبَةً عَن عُبابٍ طَمى","وَلُذ رَغبَةً بِصَياصي جَبَل",69,"ل",1,0],["وَحَدَّثتُ نَفسي بِالفِراقِ أَروضُها","فَقالَت رُوَيداً لا أَغُرُّكَ مِن صَبري",70,"ي",1,1],["وَحَدِّثوا القَومَ أَنّا أُمَّةٌ عَرَفتَ","مَعنى الحَياةِ فَلا نَومٌ وَلا وَهَنُ",71,"ن",1,0],["وَحِّدُوا اللهَ مالكم منه واقٍ","وَاحْذَرُوا الخيلَ والسُّيوفَ الحِدادا",72,"د",2,0],["وحدّثَ قَومَهُ يا قومِ إني","بخيرِ الناسِ قد أحسنتُ ظنّي",73,"ي",1,0],["وَحَديث فيهِ اِبتِذال اِحتِجاج","كُلَما نَمقوه عادَ كريها",74,"ي",3,0],["وَحَداهُ مُقتَنِصٌ قَرى آثارَهُ","بِعَياسِلٍ سُجُحِ الخُدودِ ضَواري",75,"ر",2,0],["وَحَديثٍ قَد جَعَلتُ لَهُ","دونَ عِلمِ الناسِ حُجّابا",76,"ب",2,0],["وحَدِيثُهُم في الأَنبِياءِ فلا تَسَل","عنه وخَلِّ غِطاءهُ مَسْدُولا",77,"ل",2,0],["وحَدِيثُ مَكَّةَ قد رواهَ مُطَولاً","شَعْيا فخُذهُ وَجَانِبِ التَّطوِيلا",78,"ل",2,0],["وحُدودُ تعميرِ المعمَّرِ أن","يسمو صُعوداً ثمّ ينحَدِر",79,"ر",1,0],["وحديثٌ عنكمُ أكثَرهُ","عن نسيم الريح أو بَرْق الغَواد",80,"د",1,0],["وَحَديثٍ نَمى إِلَيها فَلَم تَر","قُب بَياناً وَباطِلُ القَولِ يَنمي",81,"ي",1,0],["وَحَديثٌ كَتَمتُهُ","وَلَواهُ فَما بَدا",82,"د",2,0],["وَحَديثٌ مِنَ الخَلا","ءِ مِنَ العَينِ و