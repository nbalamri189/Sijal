{"poems":[[65,"هي الجرعاء صادية رباها","https://www.aldiwan.net/poem45792.html","الوافر"],[74,"أفدي قمر","https://www.aldiwan.net/poem18700.html","منهوك الرجز"],[72,"تعالوا بنا نطوي الحديث الذي جرى","https://www.aldiwan.net/poem42918.html","الطويل"],[87,"يود من الأرواح ما لا توده","https://www.aldiwan.net/poem7878.html","الطويل"],[64,"أرقت لبرق لاح عني وميضه","https://www.aldiwan.net/poem52462.html","الطويل"],[71,"تذكرت بالبرق إذ يلمع","https://www.aldiwan.net/poem28985.html","المتقارب"],[92,"في ذمة الله ما ألقى وما أجد","https://www.aldiwan.net/poem47616.html","الكامل"],[107,"أتنقم ما يريبك من خلالي","https://www.aldiwan.net/poem43165.html","الوافر"],[77,"تقول بنو العباس هل فتحت مصر","https://www.aldiwan.net/poem69083.html","الطويل"],[7,"فإن يك عامر قد قال جهلاً","https://www.aldiwan.net/poem2014.html","الوافر"],[48,"نفوس للقيامة تشرئب","https://www.aldiwan.net/poem22091.html","الوافر"],[1,"إذا كنت في حاجة مرسلاً","https://www.aldiwan.net/poem34003.html","المتقارب"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9916","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9978","الطويل"],[92,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[154,"بحمد الله يفتتح الكلام","https://www.aldiwan.net/poem68494.html","الوافر"],[173,"إلى كم مناجاة الهموم العوازب","https://www.aldiwan.net/poem1604.html",""],[173,"بسمر القنا والمرهفات الصوارم","https://www.aldiwan.net/poem1673.html",""],[181,"وإني لتعروني لذكراك رعدة","https://www.aldiwan.net/poem4488.html","الطويل"],[186,"بعزمك لذ إذا عز النصير","https://www.aldiwan.net/poem67071.html","الوافر"],[190,"تغنم ما حييت الخير عمدا","https://www.aldiwan.net/poem43511.html","الوافر"],[205,"وعاذلة هبت بليل تلومني","https://www.aldiwan.net/poem2078.html","الطويل"],[216,"ألا فانشدوا ذكر النجيد وحدثوا","https://www.aldiwan.net/poem37905.html","الطويل"],[287,"سل عن فؤادي بسلع أية ذهبا","https://www.aldiwan.net/poem32874.html","البسيط"],[302,"ألية بانعطاف القامة النضرة","https://www.aldiwan.net/poem33265.html","البسيط"],[309,"حويدي المطايا كم تقيم مع الصد","https://www.aldiwan.net/poem16864.html","الطويل"],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[347,"حنانيك اخت البكا والانين","https://www.aldiwan.net/poem55327.html","المتقارب"],[347,"حنانيك يا غادتي الباكية","https://www.aldiwan.net/poem55354.html","المتقارب"],[353,"يارب لا تشمت بنا حمزه","https://www.aldiwan.net/poem20391.html","السريع"],[382,"تمازج في قلبي الصبابة والشجو","https://www.aldiwan.net/poem59183.html","الطويل"],[385,"ودادي غير منتقل","https://www.aldiwan.net/poem48753.html","مجزوء الوافر"],[412,"عذب بنار الحب قلبي الذي","https://www.aldiwan.net/poem50155.html","السريع"],[435,"أخا الانس هل أبصرت صبا مولعا","https://www.aldiwan.net/poem41392.html","الطويل"],[438,"اقطع مؤاخاة أخ جاف","https://www.aldiwan.net/poem12673.html","السريع"],[445,"من سبي سيبك مما أنبتت نعمك","https://www.aldiwan.net/poem34790.html","البسيط"],[463,"أبلغ بها أمنية الطالب","https://www.aldiwan.net/poem56275.html","السريع"],[466,"أظلما ورمحي ناصري وحسامي","https://www.aldiwan.net/poem15100.html","الطويل"],[482,"دعني أكابد أشجاني وأوصابي","https://www.aldiwan.net/poem15233.html","البسيط"],[510,"المُقنَّع","https://www.aldiwan.net/poem27796.html","الطويل"],[519,"ويا وميض بروق المزن إن سفرت","https://www.aldiwan.net/poem20795.html","البسيط"],[520,"سرت نفحة كالمسك أزهى وأعطر","https://www.aldiwan.net/poem12119.html","الطويل"],[556,"ما لك في ربة الغلائل","https://www.aldiwan.net/poem47285.html","الرجز"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83305","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122811","الوافر"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87118","الطويل"],[849,"","https://poetry.dctabudhabi.ae/diwan/poem/105614","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70836","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119960","السريع"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96618","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61041","الوافر"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118129","الطويل"],[1479,"","https://poetry.dctabudhabi.ae/diwan/poem/20571","الوافر"],[1601,"","https://poetry.dctabudhabi.ae/diwan/poem/123763","المنسرح"],[1682,"","https://poetry.dctabudhabi.ae/diwan/poem/198769","الوافر"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118430","البسيط"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42402","الطويل"],[2129,"","https://poetry.dctabudhabi.ae/diwan/poem/111095","الوافر"],[2141,"","https://poetry.dctabudhabi.ae/diwan/poem/100880","الطويل"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121929","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124784","الطويل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102547","الطويل"],[2751,"","https://poetry.dctabudhabi.ae/diwan/poem/138890",""],[2875,"","https://poetry.dctabudhabi.ae/diwan/poem/124046","الطويل"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100512","البسيط"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100501","الرجز"],[3260,"","https://poetry.dctabudhabi.ae/diwan/poem/204131","السريع"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71319","المنسرح"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138552",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91285","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216609","الطويل"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2523","الوافر"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103020","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136940",""],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127291","البسيط"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135068","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83462","السريع"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83194","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120520","الطويل"],[4718,"ضاقت بي الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=137245",""],[1901,"وداعاً بَني أُمي فَقدْ آنَ أنْ أَمضِي","https://www.poetsgate.com/ViewPoem.aspx?id=160417",""],[5183,"ذات الخمارين","https://www.poetsgate.com/ViewPoem.aspx?id=180182",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5358,"متى تعود لنا","https://www.poetsgate.com/ViewPoem.aspx?id=21899",""],[709,"ويا وميضَ بروقِ المزنِ إنْ سفرتْ","https://www.poetsgate.com/ViewPoem.aspx?id=2956",""],[5459,"عين العطاء","https://www.poetsgate.com/ViewPoem.aspx?id=198380",""],[5582,"أَمِنْ دِمَنٍ مَعالِمُها قِفارُ","https://www.poetsgate.com/ViewPoem.aspx?id=63510",""],[5770,"يبكي ويضحك","https://www.poetsgate.com/ViewPoem.aspx?id=178252",""],[5855,"كذاك ابنة الأعيار خافي بسالة","https://www.poetsgate.com/ViewPoem.aspx?id=186654",""]],"verses":[["وَلا تَذعَر بِها أَدماءَ تُزجِي","بِرَوْقَيها عَلى لَغَبٍ طَلاها",0,"ا",3,0],["ولا تذر","لمن نذر",1,"ر",1,0],["وَلا تَذكُروا ذاكَ الَّذي كانَ بَينَنا","عَلى أَنَّهُ ما كانَ ذَنبٌ فَيُذكَرا",2,"ر",2,0],["ولا تذكروني عنده بشفاعة","فإن شفيع الواجد الصب وجده",3,"د",2,0],["ولا تذكري نَجْداً وطِيبَ هوائِهِ","وقد ضَاعَ وَهْنَاً رنْدُهُ المتفاوِحُ",4,"ح",1,0],["ولا تذكرنْ أدباً عندهُمْ","فآدابُ أشعارِهمْ بلقَعُ",5,"ع",1,0],["ولا تَذِلُّ لخطبٍ حُمَّ نازِلُهُ","ولا يُصَعِّرُ مِنها المالُ والولد",6,"د",1,0],["وَلا تَذكُر سِوى نَفَرٍ قَليلٍ","وَإِن هُم جاوَزوا عَدَدَ الرِمالِ",7,"ل",1,0],["ولا تَذَرُوا عليا مَعَدٍّ وغيرِهَا","لِيُعْرَفَ منكم مَن له الحقُّ والأمر",8,"ر",1,0],["وَلا تَذهَب بِحِلمِكَ طامِياتٌ","مِنَ الخُيَلاءِ لَيسَ لَهُنَّ بابُ",9,"ب",1,0],["وَلا تَذبُب هُناكَ الطَيرَ عَنّي","ولا تَبلُل يَداكَ فَماً يَذِبُّ",10,"ب",1,0],["وَلا تَذكُرِ الدَهرَ في مَجلِسٍ","حَديثاً إِذا أَنتَ لَم تُحصِهِ",11,"ص",2,0],["وَلا تَذكُرا لي غَيرَ خَيلٍ مُغيرَةٍ","وَنَقعَ غُبارٍ حالِكِ اللَونِ مُسوَدِّ",12,"د",1,0],["وَلا تَذكُرا لي طيبَ عَيشٍ فَإِنَّما","بُلوغُ الأَماني صِحَّتي وَسَقامي",13,"م",2,0],["ولا تذكروا عَتْباً فانَّ مُوطّداً","من الودِ زِدْنا فيه ما يرفعُ العتبا",14,"ب",2,0],["ولا تذهب بك الخُيَلاَءُ واعلم","بأن المهر يطغيه الجمام",15,"م",1,0],["وَلا تَذكُرا عِندي لَعَلَّ وَلا عَسى","فَما بِعَسى يُقضى نَجاحٌ لِطالِبِ",16,"ب",1,0],["وَلا تَذكُرَا الصَهباءَ ما لَم تَكُن دَماً","وَلا مُسمِعاً ما لَم يَكُن صَوتَ صارِمِ",17,"م",1,0],["ولا تُذْكَرُ الأَهْواءُ إلاّ ذكرتُها","ولا البُخْلُ إلاّ قلتُ سوف تُثيبُ",18,"ب",1,0],["وَلا تَذهَبْ بِكَ الأَهواءُ يَوماً","فَراكِبُ سبلِها غاوٍ عَثورُ",19,"ر",1,0],["ولا تذخر ليوم لم يوافي","فإن وافى فكله إلى المليك",20,"ك",1,0],["وَلا تَذهَبَن عَيناكِ في كُلِّ شَرمَحٍ","لَهُ قَصَبٌ جوفُ العِظامِ أَسيلُ",21,"ل",1,0],["ولا تذكروا نَجْداً ورملةَ عالجٍ","فذكرهما عندي من البينِ أخبثُ",22,"ث",1,0],["وَلا تَذَكَّرتُ حُزوى وَالغَويرَ وَلا","آرامَ رامَةَ إِلّا صِحتُ وا حَرَبا",23,"ب",2,0],["ولا تذكَّرتُ ذاكَ الشَمل مُجتَمِعاً","إِلّا اِستَهَلَّت دُموعي وهي مُنتَثِرَه",24,"ر",2,0],["ولا تذكر العهد القديم برامة","وأحد وسلع يا رعى اللَه من عهد",25,"د",1,0],["ولا تذكر الانسان الا بصيته","وافرض من ذا ذكر معروفه الضانى",26,"ن",2,0],["ولا تذكر العراف عند مثيلهم","تماثل عرفان عداوة أقران",26,"ن",1,0],["ولا تذكري لي بثور الشباب","الشباب المريض الشباب المهين",27,"ن",1,0],["ولا تذرفي منك هذي الدموع","دموعك يا غادتي غالية",28,"ي",2,0],["وَلا تُذِقْنا العَجزَ والذُّلَّ لِل","خَبّاز يَاذا الحَوْلِ وَالعِزَّهْ",29,"ز",2,0],["ولا تذكرُنَّ الصفوَ فيها بغيرها","فلا خير في عيش إذا لم يكن صفو",30,"و",1,0],["وَلا تَذكُر بَني ثَعل","وَعَن هاروت لا تَسَل",31,"ل",1,0],["وَلا تَذُق طَعمَ الكَرى مُقلة","نَمَّت بِأَسراري وَلَم أَشعُرِ",32,"ر",1,0],["ولا تذكر نجدا ولا بارق اللوى","سوى دارة الفيحاء يا صاحبي دعا",33,"ع",2,0],["ولا تذكرا ليلى ولا قيس عامر","ولا تذكر الخنساء ولا صخرها معا",33,"ع",2,0],["ولا تذِلْ جوهرَ شعرٍ لهُ","فكرُكَ من أصونِ أصدافِ",34,"ف",1,0],["ولا تَذَوَّقَ طَعْمَ الأَمْنِ ذو حَذَرٍ","من النَّوائِبِ حَتَّى ضَمَّهُ حَرَمُكْ",35,"ك",1,0],["ولا تُذمِّم لوجاها فما ال","راحةُ يوماً في مَطَا اللاغبِ",36,"ب",1,0],["ولا تذكرا لي خفض عيش فإنما","بلوغُ المعالي صحَّتي وقِوامي",37,"م",2,0],["ولا تذكُّرُ أيامي بقربهمُ","يُجدي عليَّ ولا ليلاتُ أطرابي",38,"ب",2,0],["ولا تذرفنّ عينك الدمع مبدياً","نقاءَ سريرةٍ فلستَ نقيّا",39,"ي",2,0],["ولا تذُمّي بياض الشّيب إن شُعِلَتْ","شموعُه في سواد الليل من شَعَري",40,"ر",2,0],["ولا تذكروا كعباً وعمراً وعنتراً","فخادمهم كعب وعمرو وعنتر",41,"ر",1,0],["ولا تذقْ أعينكم طعم الكرَى","وعندكم وفيكمُ طوائلي",42,"ل",2,0],["وَلا تَذكُروا ذاكَ الزَمانَ الَّذي مَضى","فَقَد عاضَ حُلوُ اليَومِ مِن مُرِّ مامِرا",43,"ر",2,0],["وَلا تَذكُر بَني شَيبانَ فيما","ذَكرتَ وَلا بَني عَبدِ المَدانِ",44,"ن",1,0],["وَلا تذكر الكنديَّ فهو وَإِن عَلا","إِلى ذَلِكَ المَولى العُلَى كَغلام",45,"م",1,0],["ولا تذروني حائماً حول حوضكم","إذا الناس منهم واردون وحوم",46,"م",1,0],["ولا تذكرْ مع الأصحا","بِ إملاقاً وإقلالا",47,"ل",2,0],["ولا تذكرت على حالة","ملي ومن لمياء إنسانا",48,"ن",2,0],["وَلا تَذكروا روضَ العرار وطيبه","وَإن راقَ لونٌ منه بالحسن معجبُ",49,"ب",1,0],["وَلا تَذهب بِكَ الأَحزان فيهِ","فَعندَ اللَه مدخر الأُجور",50,"ر",1,0],["وَلا تَذُمَّ صاحِباً وَإن فَلَى","فَلا الشِّقاقِ عانِداً فَلاً فَلا",51,"ل",2,0],["ولا تذكريني الواديين ولا ترى","لعيني أطلال الديار فتدمعا",52,"ع",2,0],["وَلا تَذكُر عِتابَ أَبي يَزيدٍ","فَهَيهاتَ البُحورُ مِن الثِمادِ",53,"د",1,0],["ولا تذكرت عيشة سلفت","بالخيف إلا وصحت واحربا",54,"ب",2,0],["ولا تذخرْ لرأبِ الصدعِ جهداً","بسعيِكَ سوف يلتئم الشَّتَاتُ",55,"ت",1,0],["ولا تذقنا علقم الدنيه","فانها شر من المنية",56,"ه",1,0],["ولا تذكُري ليلى ولا هندَ في الورى","وخلِّي عن المنثورِ والنظمِ في أروى",57,"و",2,0],["ولا تذكر له أبداً حديثاً","فذلك ما يشين السمع ذكرا",58,"ر",2,0],["ولا تذكرُوا الأَشباحَ بِاللهِ عِندَهُ","ف‍َلَو أتلَفَ الأَرواحَ من ذا يُطَالِبُه",59,"ب",2,0],["ولا تذهلا أن تبلغا لى تحية","الى شيخنا الخياط سيدى محمد",60,"د",1,0],["ولا تذهبن العمر منك سبهللا","ولا تغتبن في النعمتين بل اجهد",61,"د",1,0],["ولا تذكر لي عذل واش وعاذل","فليس خليّ القلب كلواله الصبّ",62,"ب",1,0],["ولا تذكر سكان العقيق ولا","ماءُ العذيب وروض ناعم خضلُ",63,"ل",1,0],["ولا تذكرا لي من صبا من مضى به","فذكرُ الجفا أيام ذكر الصفا جفا",64,"ف",2,0],["ولا تذكر جيران بذي سلم","ولا سرى طيف من أهوى فأرقني",65,"ن",2,0],["ولا تذرني رب فرداً إن ذا","معنى به استأثرت من دون البشر",66,"ر",1,0],["ولا تذدك الخمر ممزوجة","عن العناقيد التي نقطفُ",67,"ف",1,0],["وَلاَ تَذكُرْتُ عِيشَةَ سَلفَتْ","بالخِيفِ إلاَّ وَقلْتُ وَا حَرَبا",68,"ب",2,0],["ولا تذل لخطبٍ جل موقعه","ان رمت عزا فبالغز البلى اتحدا",69,"د",2,0],["وَلا تذكرنْ لي غَير ما قَد عَرفتَه","يَروّحُ رُوحي أَو يُسلِّي عَن السالي",70,"ل",2,0],["ولا تذكروني بالبكاء وإنما","أعيدوا على سمعي القصيد فأطربا",71,"ب",2,0],["وَلا تَذهَب بِحِلمِكَ هافِياتٌ","مِنَ الخُيَلاءِ لَيسَ لَهُنَّ بابُ",72,"ب",1,0],["ولا تذكر الصهباء ما لم تكن دما","ولا مسمعي ما لم يكن صوت صارم",73,"م",1,0],["ولا تذكر وفا","قاً لا وفاقٌ بينا ذكرا",74,"ر",2,0],["ولا تذوّق نشُّ الشرق مقتطفاً","من جنة الغرب معسولاً بكل فم",75,"م",1,0],["ولا تذق قط بيضاء الكؤوس تفز","فالمسك للعرس والكافور وللكفن",76,"ن",1,0],["ولا تذكرت أوطاني ومنزلتي","إلا وأيقنت أن العز بالنقل",77,"ل",1,0],["وَلا تذلّ النَفسَ إِلّا لهُ","فَفي السُؤالِ الذُلُّ دون اِشتِباه",78,"ا",2,0],["وَلا تَذُمَّ غِيَرَ الزَمانِ","فَإِنَّ فيها خِبرَةَ الإِخوانِ",79,"ن",1,0],["ولا تذكرا لي عافيا من ربوعهم","فجسمي اعفى منه رسما ومدلولا",80,"ل",2,0],["ولاتذكر اني في حياتك اليا فقت","لاتقترب حولي ولاتسير صوبي",81,"ب",2,0],["ولا تذكروني بعدها بمساءَةِ","فما خُنتُ في مالِ ولا خنتَ في عرضِ",82,"ض",1,0],["ولا تذكري لي فضل غيري فإنما","يشب سعير الحرب وخز المعيرّ",83,"ر",1,0],["ولا تذهب إلى الأموات جهلاً","لنفع أو لضر أو نوال",84,"ل",1,0],["ولا تذَرْني لظنّي أنّهُمْ مَسَحوا","ذِكْري تماماً وحالتْ بيننا الدُوَلُ",85,"ل",1,0],["ولا تذمِّي بياضَ الشَّيْبِ إِنْ شُعِلَتْ","شموعهُ في سوادِ الَّيلِمنْ شعريْ",86,"ر",2,0],["ولاَ تُذْعِنْ لِيَأسٍ فِي الْمَآسِي","وَ لاَزِمْ طَرْقَ أَبْوَابِ الرَّجَاءِ",87,"ا",2,0],["وَلا تَذْخَرْ لِوَتْرِ القَوْسِ نَبْلاً","إِذا ما أَنْتَ عَنَّ لَكَ الصُّوارُ",88,"ر",1,0],["ولا تذوّق من صنعاء كرمتها","أو ألقمته شآمٌ ثديها بلحا",89,"ح",2,0],["ولا تذهبن عيناك في كل شرمح","طويل فإن الأقصرينَ أمازرة",90,"ه",1,0]]}