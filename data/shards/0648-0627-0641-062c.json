{"poems":[[55,"حب العلى شغل قلب ما له شغل","https://www.aldiwan.net/poem29895.html","البسيط"],[45,"نعد المشرفية والعوالي","https://www.aldiwan.net/poem9758.html","الوافر"],[284,"ذرا السعي في نيل العلا والفضائل","https://www.aldiwan.net/poem2630.html","الطويل"],[303,"إذا أصبح الجزار للسرب راعيا","https://www.aldiwan.net/poem36836.html","الطويل"],[445,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[445,"لك الخير قد أوفى بعهدك خيران","https://www.aldiwan.net/poem34887.html","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56183","الوافر"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100468","السريع"],[2230,"","https://poetry.dctabudhabi.ae/diwan/poem/101792","الطويل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110640","المنسرح"],[2382,"","https://poetry.dctabudhabi.ae/diwan/poem/101815","المتقارب"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74083","الوافر"],[3770,"","https://poetry.dctabudhabi.ae/diwan/poem/111346","المتقارب"],[3997,"","https://poetry.dctabudhabi.ae/diwan/poem/132190","الوافر"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58002","الطويل"],[5387,"لغة الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=53821",""],[6034,"الدهر لا يبرح خوانا","https://www.poetsgate.com/ViewPoem.aspx?id=169609",""]],"verses":[["وَأَفجَعُ الناسِ مَن وَلّى حَبائِبُهُ","وَلا عِناقٌ وَلا ضَمٌّ وَلا قُبَلُ",0,"ل",1,0],["وَأَفجَعُ مَن فَقَدنا مَن وَجَدنا","قُبَيلَ الفَقدِ مَفقودَ المِثالِ",1,"ل",1,0],["وأفجع فيه العالمين بمقدمٍ","صبورٍ على حرب الضلال حلاحل",2,"ل",1,0],["وَأفجعُ أنواعِ الأضاحي ضحيةٌ","يقدمُها للذئبِ راعٍ وَينعق",3,"ق",1,0],["وأفْجِعْ بالنَّوى فِي دارِ سَفْرٍ","فكَيْفَ نوىً عَلَى دارِ المُقامِ",4,"م",1,0],["وأَفجِع بمنْ آوى صَفيحٌ وَجَلْمَدٌ","وَوَارَتْ رِمالٌ بالفَلاةِ وكُثْبانُ",5,"ن",1,0],["وأفجعنا بمولىً قد تغالى","بألطاف المزايا من صباهُ",6,"ا",2,0],["وأفجعتنا في القروم الألى","ذلت لهم يوم الكفاح القروم",7,"م",1,0],["وأفجع ما قاسته منك وكلها","فجايع أن أرقيت صدر ابنها شمرا",8,"ر",2,0],["وافجعت يوم جدلت حسنا","محمدا حيث خصه الثكل",9,"ل",1,0],["وأفجعني بالوفي الأبر","بودي وادنى وأقرب رحما",10,"م",2,0],["وَأَفجَع ما دَهى أسر المَعالي","علاء غيل صاحبه وَمجدُ",11,"د",1,0],["وأفجع عدنان في عزها","وألبسها ذلة وصغارا",12,"ر",2,0],["وافجع منظر إذ ذاك فيها","خشوع للرجال وللنساء",13,"ا",2,0],["وأفجع داع المرحيل إذا دعا","منادي المنايا حيث يدعو ويصرخ",14,"خ",1,0],["وأفجر مخزن أحزاني","في نهر الحبر المنزلقِ",15,"ق",1,0],["وأفجع الآداب فلتبكه","آدابه سرا وإعلانا",16,"ن",2,0]]}