{"poems":[[53,"صبرا غريم الثأر من عدنان","https://www.aldiwan.net/poem29664.html","الرجز"],[85,"العلم والبر هذا مهرجانهما","https://www.aldiwan.net/poem7124.html","البسيط"],[85,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[43,"لك يا منازل في القلوب منازل","https://www.aldiwan.net/poem10130.html","الكامل"],[69,"يا أفضل مرسل كريم","https://www.aldiwan.net/poem29050.html","مجزوء الدوبيت"],[75,"ألؤلؤ دمع هذا الغيث أم نقط","https://www.aldiwan.net/poem69067.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39581","الكامل"],[185,"يا باسط العدل في بدو وفي حضر","https://www.aldiwan.net/poem14537.html","البسيط"],[185,"أيام ملكك أعياد وأعراس","https://www.aldiwan.net/poem14555.html","البسيط"],[199,"نصبت لي في الكرى حباله","https://www.aldiwan.net/poem45141.html","مخلع البسيط"],[204,"يا أفتن الناس ألحاظا إذا رمقا","https://www.aldiwan.net/poem53221.html","البسيط"],[261,"أكناس ريم أم عرين غضنفر","https://www.aldiwan.net/poem38278.html","الكامل"],[402,"حتام أكتم ما الدموع تبيح","https://www.aldiwan.net/poem46754.html","الكامل"],[538,"قدك يا جميل","https://www.aldiwan.net/poem47914.html","عموديه"],[575,"قلبي يقول لطيف منك يطرقني","https://www.aldiwan.net/poem2997.html","البسيط"]],"verses":[["يا أَفضَلَ الفُضَلاءِ بَل يا أَعلَمَ ال","عُلَماءِ بَل يا أَطعَنَ الأَقرانِ",0,"ن",1,0],["يا أفضل الناس في الإيثار سابقة","وأحسن الناس في الإحسان بنيانا",1,"ن",2,0],["يا أَفصَحَ الناطِقينَ الضادَ قاطِبَةً","حَديثُكَ الشَهدُ عِندَ الذائِقِ الفَهِمِ",2,"م",1,0],["يا اِفخَر فَإِنَّ الناسِ فيكَ ثَلاثَةٌ","مُستَعظِمٌ أَو حاسِدٌ أَو جاهِلُ",3,"ل",1,0],["يا أفضلَ مرسلٍ كريمٍ","ما ألطفَ هذه الشمائلْ",4,"ل",1,1],["يا أفضلَ الناس من عُرْبٍ ومن عَجَمٍ","وآلِ أحمدَ إن شبّوا وإن شَمِطوا",5,"ط",3,0],["يا أفقَ إلهامي ووحيَ خواطري","هذا نشيدي في سمائكَ يخفِقُ",6,"ق",1,0],["يا أفضلَ الناسِ لم تُنْسَب إلى لقبٍ","إلا فِعلُك أَوْفَى منه فافْتخِر",7,"ر",1,0],["يا أفضلَ الناس قولا فاقَه عملٌ","وكلُّ قولٍ له الأفعال آساس",8,"س",1,0],["يا أُفق هل خفت من شراره","تحت الضلوع اسمها الفؤاد",9,"د",1,0],["يا أفتَنَ الناسِ ألحاظاً إذا رَمَقا","وأعذب الناس ألفاظاً إذا نَطَقا",10,"ق",2,1],["يا افضل العلماء بل يا اعلم","الفضلاء من ماض ومن متأخر",11,"ر",1,0],["يا أفصحَ الفُصحاء غيرَ مُدافعٍ","أقْلِلْ لِمثلكَ أن يُقالَ فصيحُ",12,"ح",1,0],["يا إِفكَ ما زَعَمتَ","وجَهلَ مَا عَلِمتَ",13,"ت",1,0],["يا أَفضلَ الخلقِ قولٌ لا يُلِمُّ به","ظَنٌّ مِنَ القَولِ أَو قَوْلٌ من الظُنَنِ",14,"ن",1,0]]}