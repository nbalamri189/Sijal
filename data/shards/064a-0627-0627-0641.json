ttps://poetry.dctabudhabi.ae/diwan/poem/56572","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112773","الكامل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137869",""],[1496,"","https://poetry.dctabudhabi.ae/diwan/poem/131407","البسيط"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128711","المتدارك"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128721",""],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69416","الكامل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89522","البسيط"],[2406,"","https://poetry.dctabudhabi.ae/diwan/poem/100120","البسيط"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114153","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90872","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54429","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54462","الكامل"],[4259,"","https://poetry.dctabudhabi.ae/diwan/poem/145336","المجتث"],[5612,"أشْتاقُ يا سيِّدي","https://www.poetsgate.com/ViewPoem.aspx?id=191652",""],[4623,"للحب تبدو وان تخفى علامات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146688",""],[5975,"على نغم المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=58500",""]],"verses":[["يا أَفضَلَ الفُضَلاءِ بَل يا أَعلَمَ ال","عُلَماءِ بَل يا أَطعَنَ الأَقرانِ",0,"ن",1,0],["يا أفضل الناس في الإيثار سابقة","وأحسن الناس في الإحسان بنيانا",1,"ن",2,0],["يا أَفصَحَ الناطِقينَ الضادَ قاطِبَةً","حَديثُكَ الشَهدُ عِندَ الذائِقِ الفَهِمِ",2,"م",1,0],["يا اِفخَر فَإِنَّ الناسِ فيكَ ثَلاثَةٌ","مُستَعظِمٌ أَو حاسِدٌ أَو جاهِلُ",3,"ل",1,0],["يا أفضلَ مرسلٍ كريمٍ","ما ألطفَ هذه الشمائلْ",4,"ل",1,1],["يا أفضلَ الناس من عُرْبٍ ومن عَجَمٍ","وآلِ أحمدَ إن شبّوا وإن شَمِطوا",5,"ط",3,0],["يا أفقَ إلهامي ووحيَ خواطري","هذا نشيدي في سمائكَ يخفِقُ",6,"ق",1,0],["يا أفضلَ الناسِ لم تُنْسَب إلى لقبٍ","إلا فِعلُك أَوْفَى منه فافْتخِر",7,"ر",1,0],["يا أفضلَ الناس قولا فاقَه عملٌ","وكلُّ قولٍ له الأفعال آساس",8,"س",1,0],["يا أُفق هل خفت من شراره","تحت الضلوع اسمها الفؤاد",9,"د",1,0],["يا أفتَنَ الناسِ ألحاظاً إذا رَمَقا","وأعذب الناس ألفاظاً إذا نَطَقا",10,"ق",2,1],["يا افضل العلماء بل يا اعلم","الفضلاء من ماض ومن متأخر",11,"ر",1,0],["يا أفصحَ الفُصحاء غيرَ مُدافعٍ","أقْلِلْ لِمثلكَ أن يُقالَ فصيحُ",12,"ح",1,0],["يا إِفكَ ما زَعَمتَ","وجَهلَ مَا عَلِمتَ",13,"ت",1,0],["يا أَفضلَ الخلقِ قولٌ لا يُلِمُّ به","ظَنٌّ مِنَ القَولِ أَو قَوْلٌ من الظُنَنِ",14,"ن",1,0],["يا أفضَلَ الخلقِ بعدَ والدِه","وَوارثَ الفَضلِ عَن بني نضر",15,"ر",1,0],["يا أفضلَ الحَيَّينِ في خَيرٍ وفي","شَرِّ وفي نقضٍ وفي إمرار",16,"ر",1,0],["يا أفضَلَ الحَيَّينِ غَيرَ مُدافَعٍ","في الفَضلِ مُعتَرِفٍ بِهِ الثًّقَلانِ",17,"ن",1,0],["يا أَفضل صَدر قد وافى","وَأَجلّ نَصير قَد صافى",18,"ف",2,0],["يا أَفضل الثقلين يا خَير الوَرى","كادَ العَيا يَقضي بِقَطع سَياسي",19,"س",2,0],["يا أَفْضلَ الإِخوانِ يا ابنَ رجَاءِ","غيري لغيركَ بالإِخاءِ يُرائِي",20,"ا",2,1],["يا أفصح العالمين طرا","في نثر نظم ونظم نثرِ",21,"ر",1,0],["يا أفضل الخلق آكفني","رمدا بعيني استبد",22,"د",1,0],["يَا افْضَلَ شَافِعٍ إِذَا الرسْلُ وُقُوفْ","وَالنَّاسُ صُفُوفْ",23,"ف",1,0],["يا أفضلَ الناسِ مِن بادٍ ومحتضرٍ","وَأفخر الخلق مِن حافٍ ومنتعلِ",24,"ل",1,0],["يا أفصحَ الناسِ ألفاظاً وأسمحهم","كَفّاً وأعظمهم في قدرِهِ شانا",25,"ن",2,0],["يا أفق لولا في الأرض لي وطن","لكان في بعض زهرك السكن",26,"ن",1,0],["يا افضل الفضلا ويا سامي العلا","ياذا المكارم والفخار تولنا",27,"ن",2,0],["يا افضل الناس في علم وفي عمل","قد صرت افضل مدفون يجوف ثرى",28,"ر",2,0],["يا أفضل الناس عودا عند معجمه","إذا تفاضل يوما معجم العود",29,"د",1,1],["يا أفضل خلق الله ومن","شرفت بنبوته العرب",30,"ب",1,0],["يا أفضل من حنّت النياق إليه","في البيد وسارت له المحامل ركبان",31,"ن",1,0],["يا أَفصَحَ الفُصَحاءِ بَل يا أَرجَحَ","الرُجَحاءِ بَل يا أَسمَحَ السُمَحاءِ",32,"ا",2,0],["يا أَفضَلَ الناسِ فيما يُمدَحونَ بِهِ","وَأَوسَعَ الناسِ عَفواً حينَ يَقتَدِرُ",33,"ر",1,0],["يا أفضل الناس في خلق وفي خلق","شهادة صدرت عن غير متهم",34,"م",1,0],["يا أَفصح الناس فانيهم وحيّهم","ماذا تَقول وَقَد باؤوا بعيّهمِ",35,"م",1,0],["يَا أفضَلَ الرُّسلِ يَا أجَلَّهُم شَرَفاً","يَا حائِزاً رُتَباً مَا نَالَهَا أحَدُ",36,"د",1,1],["يا آفة لكن على حساده","إذ يا أبا عثمان مثلك يحسد",37,"د",1,0],["يا أَفضلَ الخلفاءِ دعوةَ قانعٍ","برضاكَ ما كشف القناع قنوعُهُ",38,"ع",2,0],["يا أفضلَ الفصحاءِ بل يا أَفصحَ ال","بلغاءِ منفرداً بغيرِ مساجلِ",39,"ل",1,0],["يا أفضل الناس طراً","بلا خلاف ومين",40,"ن",1,0],["يا أفْضلَ الخَلْقِ رُوحي أنْتَ ساكنُها","دوْماً ودرْبُكَ نِبْراسٌ وميثاقُ",41,"ق",1,0],["يا أفضل الخلق يا محمد لك في","الوجود فضل وجود فيه آيات",42,"ت",1,0],["يا أفضلَ الأصحابِ منّي عبرةٌ","تنهلُّ لا كالسيلِ تسقي أرضنا",43,"ن",2,0]]}