{"poems":[[77,"هم أن ينتف ذقني","https://www.aldiwan.net/poem36333.html","مجزوء الرمل"],[27,"هل ينفعنك إن جربت تجريب","https://www.aldiwan.net/poem5665.html","البسيط"],[51,"وما الفقر عيبا ما تجمل أهله","https://www.aldiwan.net/poem8133.html","الطويل"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[51,"يرجف القرد بأني","https://www.aldiwan.net/poem64612.html","مجزوء الرمل"],[51,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[51,"إنما يبكي شجي شجنه","https://www.aldiwan.net/poem66464.html","الرمل"],[91,"لوعة في الضلوع مثل جهنم","https://www.aldiwan.net/poem8809.html","عموديه"],[91,"بت أرعى في الظلام الأنجما","https://www.aldiwan.net/poem8872.html","عموديه"],[89,"كنت طاغور ماثلا في خيالي","https://www.aldiwan.net/poem44752.html","الخفيف"],[89,"اذكري إذ كنا صغيرين نلعب","https://www.aldiwan.net/poem44865.html","الخفيف"],[89,"ذهبت ايام الشباب سراعا","https://www.aldiwan.net/poem44894.html","الخفيف"],[85,"إلى الله أشكو من عوادي النوى سهما","https://www.aldiwan.net/poem11331.html","الطويل"],[85,"بحمد الله رب العالمينا","https://www.aldiwan.net/poem63730.html","الوافر"],[85,"قم ناد أنقرة وقل يهنيك","https://www.aldiwan.net/poem63757.html","الكامل"],[56,"سهام لحاظ من قسي الحواجب","https://www.aldiwan.net/poem58453.html","الطويل"],[56,"وعزيز بين الدلال وبين الملك","https://www.aldiwan.net/poem58548.html","الخفيف"],[45,"نفست قربها علينا كنود","https://www.aldiwan.net/poem62739.html","الخفيف"],[45,"لو كان يعتب هاجر في واصل","https://www.aldiwan.net/poem65544.html","الكامل"],[49,"ما على ذا كنا افترقنا بسندا","https://www.aldiwan.net/poem63209.html","الخفيف"],[66,"زجرتني عن التشفع نفس","https://www.aldiwan.net/poem38665.html","الخفيف"],[66,"يا بدورا تغيب تحت التراب","https://www.aldiwan.net/poem40292.html","الخفيف"],[97,"بي نزوع إلى الدموع الهوامي","https://www.aldiwan.net/poem24764.html","الخفيف"],[97,"ها أنا عدت إلى حيث التقينا","https://www.aldiwan.net/poem24925.html","الرمل"],[80,"هل أقال الحمام عثرة حي","https://www.aldiwan.net/poem31249.html","الطويل"],[44,"بؤس قلبي كيف ذلا","https://www.aldiwan.net/poem30125.html","مجزوء الرمل"],[44,"أحسن بأيام العقيق وأطيب","https://www.aldiwan.net/poem30589.html","الكامل"],[52,"وغزال مقرطق","https://www.aldiwan.net/poem26814.html","مجزوء الخفيف"],[48,"أيا من حمل الذررة","https://www.aldiwan.net/poem65013.html","الهزج"],[48,"حماني وصل أبناء القسوس","https://www.aldiwan.net/poem66569.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85593","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85299","الخفيف"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/204571","الطويل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/1027","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[106,"صاحب آويته","https://www.poetsgate.com/ViewPoem.aspx?id=179660",""],[106,"آهة طفلة","https://www.poetsgate.com/ViewPoem.aspx?id=179661",""],[90,"في طهران","https://www.poetsgate.com/ViewPoem.aspx?id=179053",""],[80,"لما كبرت أتتني كل داهيةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=186768",""],[51,"أيّها السيدُ الذي اختاره السيْ","https://www.poetsgate.com/ViewPoem.aspx?id=30337",""],[51,"وما الفقرُ عيباً ما تَجمَّلَ أهلُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=26214",""],[118,"إن وجها رأيته ليلة السب","https://www.aldiwan.net/poem49368.html","الخفيف"],[130,"ما للشجى على برح الغرام يد","https://www.aldiwan.net/poem54853.html","الطويل"],[141,"هل للخليط المستقل إياب","https://www.aldiwan.net/poem11723.html","الكامل"],[158,"لم أكثر الواشي المقال وزورا","https://www.aldiwan.net/poem58959.html","الكامل"],[184,"قد قلت إذ كثروا وقالوا","https://www.aldiwan.net/poem44106.html","مخلع البسيط"],[187,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[191,"لئن أنت ناصرت بدر الدجى","https://www.aldiwan.net/poem13155.html","المتقارب"],[197,"لا تلم ذا الهوى على أن يبوحا","https://www.aldiwan.net/poem45621.html","الخفيف"],[209,"شاعر البحر إلى البحر يعود","https://www.aldiwan.net/poem46604.html","الرمل"],[209,"ما بكى باك على الحسن الأصيل","https://www.aldiwan.net/poem46773.html","الرمل"],[221,"أودك جاحظة المقلتين","https://www.aldiwan.net/poem41903.html","المتقارب"],[278,"أبا الفضل كيف تناسيتني","https://www.aldiwan.net/poem60752.html","المتقارب"],[279,"لم أكتحل إثمداً ولكن","https://www.aldiwan.net/poem1394.html",""],[301,"ممدح الوصف قد أضحى ندى يده","https://www.aldiwan.net/poem57696.html","البسيط"],[326,"في طريق يحفه الزهر النضر","https://www.aldiwan.net/poem54972.html","الخفيف"],[326,"بين يأسي وحيرتي ورجائي","https://www.aldiwan.net/poem54993.html","الخفيف"],[359,"لا وعينيك والجبين المفدى","https://www.aldiwan.net/poem68122.html","الخفيف"],[362,"ألا من عذيري من جوى في الجوانح","https://www.aldiwan.net/poem60966.html","الطويل"],[374,"أزل يا شقيق الروح مني بقيتي","https://www.aldiwan.net/poem66906.html","الطويل"],[397,"حوار مع وردة","https://www.aldiwan.net/poem10297.html","عموديه"],[403,"إن الحمول غداة غربة غرب","https://www.aldiwan.net/poem50208.html","الكامل"],[413,"كم دم فيك أيها الريم طلا","https://www.aldiwan.net/poem54000.html","الخفيف"],[434,"إن داراً بين اللوى والعفيق","https://www.aldiwan.net/poem2547.html","الخفيف"],[446,"حبذا والحال داجي الظلم","https://www.aldiwan.net/poem53777.html","الرمل"],[451,"عمر ينقضي برشد وغى","https://www.aldiwan.net/poem61787.html","الخفيف"],[456,"تعجب من صبري على ألوانِها","https://www.aldiwan.net/poem55823.html","الرجز"],[456,"لا عداكِ الغيث يا دار الوصالِ","https://www.aldiwan.net/poem55968.html","الرمل"],[456,"يا ديار الحي من جنب الحمى","https://www.aldiwan.net/poem56095.html","الرمل"],[456,"مل معي لا عليك ضري ونفعي","https://www.aldiwan.net/poem56120.html","الخفيف"],[456,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[456,"نديمي وما الناس إلا السكارى","https://www.aldiwan.net/poem56204.html","المتقارب"],[456,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[462,"أموضع سري والذي حسن عهده","https://www.aldiwan.net/poem3163.html","عموديه"],[462,"غير سهل فيك يا لمياء حزني","https://www.aldiwan.net/poem3194.html","عموديه"],[462,"طرقت ريح الصبا ميثاء وهنا","https://www.aldiwan.net/poem3594.html","عموديه"],[466,"أرى الدهر يقصد ما ساءني","https://www.aldiwan.net/poem60505.html","المتقارب"],[498,"رح مع الوردين إني عاشق","https://www.aldiwan.net/poem37950.html","الرمل"],[504,"بشراي أبصرتك خير إمام","https://www.aldiwan.net/poem2462.html","الكامل"],[549,"حتام ذمي عندكم أزماني","https://www.aldiwan.net/poem47167.html","الكامل"],[549,"قل لعيني لا تملا الدموعا","https://www.aldiwan.net/poem47711.html","الخفيف"],[549,"يا طيف ألا زرتنا بسواد","https://www.aldiwan.net/poem47852.html","الكامل"],[556,"بين أهل الجحود والتكذيب","https://www.aldiwan.net/poem34966.html","الخفيف"],[560,"بين قلب المحب والأحداق","https://www.aldiwan.net/poem52949.html","الخفيف"],[573,"ليل الحمى بات بدري فيك معتنقي","https://www.aldiwan.net/poem3047.html","البسيط"]],"verses":[["لَمْ أَكُنْ أَدْخلُ إلاَّ","أَمْرَداً جَنَّةَ وَصْلِهْ",0,"ه",1,0],["لَمّا كَفَيتَ قُرَيشاً كُلَّ مُعضِلَةٍ","قالَت قُرَيشٌ فَدَتكَ المُردُ وَالشيبُ",1,"ب",1,0],["لَمَا كان أهلُ الحمد من قُربائه","إذا ائتمروا رُشداً ولا بُعدائِهِ",2,"ا",3,0],["لم أكُن دون مالكي هذه الأم","لاكِ لو أنصفَ الزمانُ المُحابي",3,"ب",2,0],["لم أكن أنْفس شيئاً","وعلى مثلك أنْفَس",4,"س",1,0],["لم أكلفكَ أن تكونَ شفيعاً","ليَ إلّا إلى امرئٍ مفضالِ",5,"ل",1,0],["لم أكن قطُّ أرى أني أَرى","سَكناً مثلك ينسى سكنه",6,"ن",2,0],["لَم أَكَد أَخلَعُ السَواد وَأَصحو","مِن ذُهولي حَتّى لَبِستُ السَوادا",7,"ا",1,0],["لَم أَكُن أَعرِفُ ما مَعنى الهَنا","قَبَ أَن أَعرِفَ ما مَعنى الغَرام",8,"م",1,0],["لم اكن من جناتها علم الله","واني بنارها اليوم صال",9,"ل",1,0],["لم اكن اذ بنيتها اتظنى","انها بعد ساعة تتخرب",10,"ب",1,0],["لم اكن ادري قبلما خف ينأى","ان فيه على الرحيل زماعا",11,"ع",2,0],["لَما كانَ لي في الحَربِ رَأيٌ وَلا هَوىً","وَلا رُمتُ هَذا الثُكلَ لِلناسِ وَاليُتما",12,"م",2,0],["لَما كانوا وَسَيفُكَ ذو اِنتِقامٍ","يُعادِلُ جَمعُهُم مِنّا جَنينا",13,"ا",1,0],["لَم أَكذِبِ التاريخَ حينَ جَعَلتُهُم","رُهبانَ نُسكٍ لا عُجولَ نَسيكِ",14,"ك",1,0],["لما كنتُ إلاَّ مُقْصَداً بكِ مُغرقاً","ولستُ إلى أُنثى سِواكِ براغِبِ",15,"ب",1,0],["لَمْ أَكُنْ أُعْلِمُ الزَّمانَ بِحُبِّي","هِ فَيَجْني فيهِ عَلَيَّ بِصَرْفِ",16,"ف",1,0],["لَم أَكُن أَمدَحُ البَخيلَ وَلا أَق","بَلُ نَيلَ المَمدوحِ وَهُوَ زَهيدُ",17,"د",1,0],["لَمّا كَمَلتَ رَوِيَّةً وَعَزيمَةً","أَعمَلتَ رَأيَكَ في ابتِناءِ الكامِلِ",18,"ل",1,0],["لَم أَكُن أَحسِبُ الخِلافَةَ يَزدا","دُ بِها ذو الصَفاءِ إِلّا صَفاءَ",19,"ا",2,0],["لَم أَكُن جاعِلاً شَفيعِيَ إِلّا","عَفوَكَ المُرتَجى وَحُسنَ ظُنوني",20,"ن",2,0],["لَم أَكُن جازِعاً وَأَنتَ قَريبٌ","لِبُعادِ الأَهلينَ وَالأَنسابِ",21,"ب",1,0],["لم أكن أدري أن جرحاً بما","كابدت منه من فاتك الآلام",22,"م",1,0],["لم أكن أطمع أن ترحمني","بعد أن قَضَّيتُ في الوجدِ السنينا",23,"ن",2,0],["لم أكُن أطمعُ أن تُضمِرَ لي","آسياً يُبرئُ لي الجُرح الدفينا",23,"ن",2,0],["لم أكن أعلمُ يا ليلَ الأسى","أن في جُنحِكَ لي فجراً جنينا",23,"ن",2,0],["لم أكنْ إذ نَظَمْتُ تأبينَ مَيْتٍ","لك أختارُهُ على مَدْحِ حَيِّ",24,"ي",1,0],["لَم أَكُن أَخشى الَّذي كا","نَ وَقَد كُنتُ مُخَلّى",25,"ل",2,0],["لَمّا كَرُمتَ نَطَقتُ فيكَ بِمَنطِقٍ","حَقٍّ فَلَم آثَم وَلَم أَتَحَوَّبِ",26,"ب",1,0],["لَم أَكُن فيهِ بِدعَةً","كُنتُ مِمَّن بِهِ شَقي",27,"ي",1,0],["لَما كانَ عَلى عَبدِ","كَ لا قالٌ وَلا قيلُ",28,"ل",1,0],["لما كلّمتني ورددتَ نفسي","فإنّي من جفائِكَ في رسيس",29,"س",1,0],["لَم أَكُن قد عشقت وحديَ لَيلى","إن لَيلى كثيرة العشاق",30,"ق",1,0],["لَم أَكُن أَعرف الصبابة حَتّى","ظهرت لي لَيلى بغير قناع",31,"ع",1,1],["لم أكن عند يقظتي ورقادي","في أولى العقل أو أولى الأحلام",32,"م",1,0],["لَم أَكُن مِن جُناتِها عَلِمَ اللَ","هُ وَإِنّي لِحَرِّها اليَومَ صالِ",33,"ل",1,0],["لم أكُنْ مِنْ جُناتِها عَلِمَ اللهُ","وإنَي بِحَرِّها اليومَ صالي",34,"ل",2,0],["لم أكن أَرضى بسنِّي بدلاً","لا، ولو صاغوه تِبرًا أو تُؤاما",35,"م",2,0],["لما كان هذا كِفاءَ الذي","أُعانيه في بيانٍ ودين",36,"ن",1,0],["لما كان هذا كِفاءَ الذي","أُعانيه من سُقمها كلَّ حين",36,"ن",1,0],["لم أكُنْ قبل أن يَحينَ نواكُمْ","عارفاً قَدْرَ شمليَ المجموع",37,"ع",1,0],["لما كبرت أتتني كل داهيةٍ","وكل ما كان مني زائد نقصا",38,"ص",2,1],["لم أكلفكَ أن تكونَ شفيعاً","لي إلاَّ إلى امرىء ٍ مفضالِ",39,"ل",1,0],["لَمَا كان أهلُ الحمد من قُربائه","إذا أْتَمروا رُشداً ولا بُعدائه",40,"ا",3,0],["لم أكن أحسب الزمان يريني","موضعاً لست فيه جنبي حلا",41,"ل",2,0],["لََم أكدِ فِيها ولم أجبِلُّ وَرونَقها","بَادِى الطَّلاَوةِ مُنزَاحٌ بِهِ الكَمَدُ",42,"د",1,0],["لَم أُكثِرِ الإِضرابَ عَن تَركِ العُلى","إِلّا لِيَقعُدَ دونِيَ الأَضرابُ",43,"ب",1,0],["لم أكثر الواشي المقال وزورا","واطال فيما لا يجوز واقصرا",44,"ر",2,1],["لم آكل الدخن باختياري","ينشقّ سفلي ولا أموت",45,"ت",1,0],["لَما كانَ ذو عقلٍ يَرى أنّ عاقلاً","يَدينُ بهِ مَهما غَدا عقلهُ نزرا",46,"ر",2,0],["لَم أَكُن أَستطيع لو لم يُعنّي","منكَ سرٌّ وسيرةٌ حسناءُ",47,"ا",2,0],["لَما كُنتَ أَفضَل في حالَةٍ","مِنَ الكَلبِ كَلّا وَلا أَوجَها",48,"ه",2,0],["لم أكدْ أعرفُ الصبابةَ حتى","برحتْ بي همومُها تبريحا",49,"ح",2,0],["لم أكن أعرف والحظ كتابي","أنه خطّ على متن العباب",50,"ب",1,0],["لم أكن أعرف ما لون المصائب","بعد عيد أوغلت فيه المصائب",51,"ب",1,0],["لماكِ لماكِ من الجلنّار","وَفيهِ الهَوى قامَ بِالبَيِّنات",52,"ت",1,0],["لما كنت من بعد نيل الصفا","لأرغب في النّائِلِ الْمُسْتَفادِ",53,"د",1,0],["لم أكتحلْ إثمداً ولكن","كحلتْ عيني بظلمتينِ",54,"ن",1,1],["لما كفاني الذي أخشاه من زمني","تيسرت لي قوافي الفاء في الكافي",55,"ف",2,0],["لم أكن قبل أن أرى الأرض شيئا","أم تراني قد كنت في الغيب شيّا",56,"ي",2,0],["لم أكن قبله شهيد جمال","وثنيّ الغرام والأهواء",57,"ا",2,0],["لَم أَكُن أَجب الهَوى فيكَ يَبدى","لِلاِعادي ما من نحولي أَبدى",58,"د",2,0],["لمَا كان في قُرْبٍ من الدّار أو نَوىً","فؤادي إلى تَغْييرِ عَهْدٍ بجانح",59,"ح",1,0],["لما كان أحوج فعلها من قوامها","طبيباً يداوي منهما كل علة",60,"ه",1,0],["لم أكد أنفض التراب وأبدي","رأس جذري حتى إستبدّ الفضول",61,"ل",1,0],["لما كملت نطقت فيك بِمَنطِقٍ","حق فَلَم آثم ولَم أَتحَوَّبِ",62,"ب",1,0],["لم أُكَفْكف دَمعي بفضل ردائي","بادّكار الأحباب حتَّى ابتلاّ",63,"ل",2,0],