m/ViewPoem.aspx?id=182670",""],[5956,"العيش الصَّحيح","https://www.poetsgate.com/ViewPoem.aspx?id=183590",""],[5956,"قصة صديق","https://www.poetsgate.com/ViewPoem.aspx?id=192417",""],[5956,"في هجائي لشعري","https://www.poetsgate.com/ViewPoem.aspx?id=193518",""],[5956,"محبوبُ القطرين","https://www.poetsgate.com/ViewPoem.aspx?id=193589",""],[5956,"قصائدي عفوية","https://www.poetsgate.com/ViewPoem.aspx?id=201542",""],[6043,"مرثيّة الأرض العالقة","https://www.poetsgate.com/ViewPoem.aspx?id=215591",""],[6102,"فرات وذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=184550",""],[164,"لم اكثر الواشيي المقال وزورا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=607956",""],[6164,"ماض وحاضر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66043&r=&rc=52",""],[6229,"ذلك الصوت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65179&r=&rc=2",""],[463,"تعجبُ من صبري على ألوانها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60266&r=&rc=322",""],[463,"نظرة ٌ منكِ ويومٌ بالجريبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59977&r=&rc=33",""],[2220,"إذا جاءتِ الأسماء يقدمُها الله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11859&r=&rc=728",""],[147,"هَلْ لِلْخَلِيطِ الْمُسْتِقلِّ إِيَابُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27447&r=&rc=14",""]],"verses":[["لَمْ أَكُنْ أَدْخلُ إلاَّ","أَمْرَداً جَنَّةَ وَصْلِهْ",0,"ه",1,0],["لَمّا كَفَيتَ قُرَيشاً كُلَّ مُعضِلَةٍ","قالَت قُرَيشٌ فَدَتكَ المُردُ وَالشيبُ",1,"ب",1,0],["لَمَا كان أهلُ الحمد من قُربائه","إذا ائتمروا رُشداً ولا بُعدائِهِ",2,"ا",3,0],["لم أكُن دون مالكي هذه الأم","لاكِ لو أنصفَ الزمانُ المُحابي",3,"ب",2,0],["لم أكن أنْفس شيئاً","وعلى مثلك أنْفَس",4,"س",1,0],["لم أكلفكَ أن تكونَ شفيعاً","ليَ إلّا إلى امرئٍ مفضالِ",5,"ل",1,0],["لم أكن قطُّ أرى أني أَرى","سَكناً مثلك ينسى سكنه",6,"ن",2,0],["لَم أَكَد أَخلَعُ السَواد وَأَصحو","مِن ذُهولي حَتّى لَبِستُ السَوادا",7,"ا",1,0],["لَم أَكُن أَعرِفُ ما مَعنى الهَنا","قَبَ أَن أَعرِفَ ما مَعنى الغَرام",8,"م",1,0],["لم اكن من جناتها علم الله","واني بنارها اليوم صال",9,"ل",1,0],["لم اكن اذ بنيتها اتظنى","انها بعد ساعة تتخرب",10,"ب",1,0],["لم اكن ادري قبلما خف ينأى","ان فيه على الرحيل زماعا",11,"ع",2,0],["لَما كانَ لي في الحَربِ رَأيٌ وَلا هَوىً","وَلا رُمتُ هَذا الثُكلَ لِلناسِ وَاليُتما",12,"م",2,0],["لَما كانوا وَسَيفُكَ ذو اِنتِقامٍ","يُعادِلُ جَمعُهُم مِنّا جَنينا",13,"ا",1,0],["لَم أَكذِبِ التاريخَ حينَ جَعَلتُهُم","رُهبانَ نُسكٍ لا عُجولَ نَسيكِ",14,"ك",1,0],["لما كنتُ إلاَّ مُقْصَداً بكِ مُغرقاً","ولستُ إلى أُنثى سِواكِ براغِبِ",15,"ب",1,0],["لَمْ أَكُنْ أُعْلِمُ الزَّمانَ بِحُبِّي","هِ فَيَجْني فيهِ عَلَيَّ بِصَرْفِ",16,"ف",1,0],["لَم أَكُن أَمدَحُ البَخيلَ وَلا أَق","بَلُ نَيلَ المَمدوحِ وَهُوَ زَهيدُ",17,"د",1,0],["لَمّا كَمَلتَ رَوِيَّةً وَعَزيمَةً","أَعمَلتَ رَأيَكَ في ابتِناءِ الكامِلِ",18,"ل",1,0],["لَم أَكُن أَحسِبُ الخِلافَةَ يَزدا","دُ بِها ذو الصَفاءِ إِلّا صَفاءَ",19,"ا",2,0],["لَم أَكُن جاعِلاً شَفيعِيَ إِلّا","عَفوَكَ المُرتَجى وَحُسنَ ظُنوني",20,"ن",2,0],["لَم أَكُن جازِعاً وَأَنتَ قَريبٌ","لِبُعادِ الأَهلينَ وَالأَنسابِ",21,"ب",1,0],["لم أكن أدري أن جرحاً بما","كابدت منه من فاتك الآلام",22,"م",1,0],["لم أكن أطمع أن ترحمني","بعد أن قَضَّيتُ في الوجدِ السنينا",23,"ن",2,0],["لم أكُن أطمعُ أن تُضمِرَ لي","آسياً يُبرئُ لي الجُرح الدفينا",23,"ن",2,0],["لم أكن أعلمُ يا ليلَ الأسى","أن في جُنحِكَ لي فجراً جنينا",23,"ن",2,0],["لم أكنْ إذ نَظَمْتُ تأبينَ مَيْتٍ","لك أختارُهُ على مَدْحِ حَيِّ",24,"ي",1,0],["لَم أَكُن أَخشى الَّذي كا","نَ وَقَد كُنتُ مُخَلّى",25,"ل",2,0],["لَمّا كَرُمتَ نَطَقتُ فيكَ بِمَنطِقٍ","حَقٍّ فَلَم آثَم وَلَم أَتَحَوَّبِ",26,"ب",1,0],["لَم أَكُن فيهِ بِدعَةً","كُنتُ مِمَّن بِهِ شَقي",27,"ق",2,0],["لَما كانَ عَلى عَبدِ","كَ لا قالٌ وَلا قيلُ",28,"ل",1,0],["لما كلّمتني ورددتَ نفسي","فإنّي من جفائِكَ في رسيس",29,"س",1,0],["لَم أَكُن قد عشقت وحديَ لَيلى","إن لَيلى كثيرة العشاق",30,"ق",1,0],["لَم أَكُن أَعرف الصبابة حَتّى","ظهرت لي لَيلى بغير قناع",31,"ع",1,1],["لم أكن عند يقظتي ورقادي","في أولى العقل أو أولى الأحلام",32,"م",1,0],["لَم أَكُن مِن جُناتِها عَلِمَ اللَ","هُ وَإِنّي لِحَرِّها اليَومَ صالِ",33,"ل",1,0],["لم أكُنْ مِنْ جُناتِها عَلِمَ اللهُ","وإنَي بِحَرِّها اليومَ صالي",34,"ل",2,0],["لم أكن أَرضى بسنِّي بدلاً","لا، ولو صاغوه تِبرًا أو تُؤاما",35,"م",2,0],["لما كان هذا كِفاءَ الذي","أُعانيه في بيانٍ ودين",36,"ن",1,0],["لما كان هذا كِفاءَ الذي","أُعانيه من سُقمها كلَّ حين",36,"ن",1,0],["لما كاسحات البحر في البحر حرة","وفي البر لا أحرار إلا المساجد؟",37,"د",1,0],["لم أكن (شهريار) لكن تمادت","عشرة صورتك لي (شهرزادا)",38,"د",2,0],["لم أكُنْ قبل أن يَحينَ نواكُمْ","عارفاً قَدْرَ شمليَ المجموع",39,"ع",1,0],["لما كبرت أتتني كل داهيةٍ","وكل ما كان مني زائد نقصا",40,"ص",2,1],["لم أكلفكَ أن تكونَ شفيعاً","لي إلاَّ إلى امرىء ٍ مفضالِ",41,"ل",1,0],["لَمَا كان أهلُ الحمد من قُربائه","إذا أْتَمروا رُشداً ولا بُعدائه",42,"ا",3,0],["لم أكن (شهريار) لكن تمادت","عشرة صوّرتك لي (شهرزاد)",43,"د",1,0],["لم أكن أحسب الزمان يريني","موضعاً لست فيه جنبي حلا",44,"ل",2,0],["لََم أكدِ فِيها ولم أجبِلُّ وَرونَقها","بَادِى الطَّلاَوةِ مُنزَاحٌ بِهِ الكَمَدُ",45,"د",1,0],["لَم أُكثِرِ الإِضرابَ عَن تَركِ العُلى","إِلّا لِيَقعُدَ دونِيَ الأَضرابُ",46,"ب",1,0],["لم أكثر الواشي المقال وزورا","واطال فيما لا يجوز واقصرا",47,"ر",2,1],["لم آكل الدخن باختياري","ينشقّ سفلي ولا أموت",48,"ت",1,0],["لَما كانَ ذو عقلٍ يَرى أنّ عاقلاً","يَدينُ بهِ مَهما غَدا عقلهُ نزرا",49,"ر",2,0],["لَم أَكُن أَستطيع لو لم يُعنّي","منكَ سرٌّ وسيرةٌ حسناءُ",50,"ا",2,0],["لَما كُنتَ أَفضَل في حالَةٍ","مِنَ الكَلبِ كَلّا وَلا أَوجَها",51,"ه",2,0],["لم أكدْ أعرفُ الصبابةَ حتى","برحتْ بي همومُها تبريحا",52,"ح",2,0],["لم أكن أعرف والحظ كتابي","أنه خطّ على متن العباب",53,"ب",1,0],["لم أكن أعرف ما لون المصائب","بعد عيد أوغلت فيه المصائب",54,"ب",1,0],["لماكِ لماكِ من الجلنّار","وَفيهِ الهَوى قامَ بِالبَيِّنات",55,"ت",1,0],["لما كنت من بعد نيل الصفا","لأرغب في النّائِلِ الْمُسْتَفادِ",56,"د",1,0],["لم أكتحلْ إثمداً ولكن","كحلتْ عيني بظلمتينِ",57,"ن",1,1],["لما كفاني الذي أخشاه من زمني","تيسرت لي قوافي الفاء في الكافي",58,"ف",2,0],["لم أكن قبل أن أرى الأرض شيئا","أم تراني قد كنت في الغيب شيّا",59,"ي",2,0],["لم أكن قبله شهيد جمال","وثنيّ الغرام والأهواء",60,"ا",2,0],["لَم أَكُن أَجب الهَوى فيكَ يَبدى","لِلاِعادي ما من نحولي أَبدى",61,"د",2,0],["لمَا كان في قُرْبٍ من الدّار أو نَوىً","فؤادي إلى تَغْييرِ عَهْدٍ بجانح",62,"ح",1,0],["لما كان أحوج فعلها من قوامها","طبيباً يداوي منهما كل علة",63,"ه",1,0],["لم أكد أنفض التراب وأبدي","رأس جذري حتى إستبدّ الفضول",64,"ل",1,0],["لما كملت نطقت فيك بِمَنطِقٍ","حق فَلَم آثم ولَم أَتحَوَّبِ",65,"ب",1,0],["لم أُكَفْكف دَمعي بفضل ردائي","بادّكار الأحباب حتَّى ابتلاّ",66,"ل",2,0],["لم أكن أؤثر الفراق ولكن","حكم الله منك بالتفريق",67,"ق",1,0],["لم أكن أهلا لها حتى لقد","خلت وجدى بلقاها موهمي",68,"م",2,0],["لم أكن من يغادر النيل لولا","ه طريداً وان اكن كالنبي",69,"ي",1,0],["لم أكُ في تحرُّزِي أخافُهُ","بسيِّئِ الظن على استحسانِها",70,"ن",3,0],["لم أكن أُنكرُ حالاً من زماني","قبلَ أن غيَّر جَورُ الشيب حالي",71,"ل",2,0],["لم أكن أعلم حتى نحلَتْ","كنحولي أنها مثلي مشوقَهْ",72,"ق",2,0],["لم أكن أوّلَ الرجال التوى صَغْ","وي لدار الأحباب أو مال ضلعي",73,"ع",2,0],["لم أكلِّفك أن تسوقَ مع الرغ","بة فيها سوى المودةِ مَهرا",74,"ر",2,0],["لما كنتُ أرضَى لك الخافقيْ","ن مُلكاً ولا جَنَّةَ الخُلد دارا",75,"ر",2,0],["لم أكلِّفهُ سُرى البيدِ ولم","أتعسَّفْه بأخخطارِ السُّهوبِ",76,"ب",1,0],["لما كان ذكرٌ جميلٌ ركابه","إلى غاية الدنيا يغذِ ويعنق",77,"ق",1,0],["لم أكنْ لولا نداء الجمُّ ذا","ناظرٍ سامٍ وقلبٍ مطمئنّ",78,"ن",1,0],["لم أكن لولاه أبكي ذاهباً","لا ولا أقرع بعد البين سناً",79,"ن",2,0],["لَمّا كان يُحوِجُني جودُهُ","إِلى غَيرِ نُصرَةِ آلائِه",80,"ا",3,0],["لم أكنْ أرْضَى بِمصرٍ مَوْطِناً","لِعَزيزي ومَقامي الفائقُ",81,"ق",1,0],["لم أكتَرِث لِشَتاتِ شَملي بالنَّوَآ","فكأنَّما للشَّملِ جَمعُ نِظامِ",82,"م",1,0],["لمّا كساني حُلَّةً من وُدِّهِ","أُنْسِيتُ سَلْبَ حَبائبي رَيْعاني",83,"ن",2,0],["لم أكنْ قانعاً بشيءٍ من الدّه","ر وعُلِّقْتُهُ فصرتُ قَنوعا",84,"ع",2,0],["لمّا كَثُرنَ عليَّ منك تبرّعاً","وتفخّراً كثّرنَ مِن حُسَّادِي",85,"د",2,0],["لم أكلفك أن ترى حسن حالي","في البرايا أو أن تكون نسيبي",86,"ب",2,0],["لم أكن شاعر