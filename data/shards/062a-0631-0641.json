مل"],[458,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[458,"يا عينِ لو أغضيتِ يوم النوى","https://www.aldiwan.net/poem56312.html","السريع"],[461,"تمنى مقامي والمطالع ضلة","https://www.aldiwan.net/poem15107.html","الطويل"],[461,"ترفعت عن مدح الرجال وقادني","https://www.aldiwan.net/poem15117.html","الطويل"],[461,"أود ولي من شيمة المجد عاصم","https://www.aldiwan.net/poem15146.html","الطويل"],[461,"يكاد الدجى يغدو صباحا مشرقا","https://www.aldiwan.net/poem15175.html","الطويل"],[461,"تميس جياد الخيل حتى كأنما","https://www.aldiwan.net/poem15410.html","الطويل"],[461,"أصوب غمام أم نوال معذل","https://www.aldiwan.net/poem15452.html","الطويل"],[461,"ضروب قذال القرن فذا لدى الوغى","https://www.aldiwan.net/poem16039.html","الطويل"],[464,"نعم نفحة الوادي التي تتأرج","https://www.aldiwan.net/poem3143.html","عموديه"],[464,"تلقاك يا سعد بالنجح سعد","https://www.aldiwan.net/poem3152.html","عموديه"],[464,"جد بقلبي وهزل","https://www.aldiwan.net/poem3313.html","عموديه"],[464,"نسيم الصبا مثلي يصح ويسقم","https://www.aldiwan.net/poem3496.html","عموديه"],[466,"أقول لثور وهو يحلق لمتي","https://www.aldiwan.net/poem50475.html","الطويل"],[477,"هل في المنازل بعد القوم آثار","https://www.aldiwan.net/poem15240.html","البسيط"],[477,"تذكر أيام الصبا فتألما","https://www.aldiwan.net/poem15241.html","الطويل"],[482,"أنخت مطايا الذل نحوك ملقيا","https://www.aldiwan.net/poem24461.html","عموديه"],[482,"علمت بأنك سهم كليل","https://www.aldiwan.net/poem24470.html","عموديه"],[500,"لنا رفرف من دونه الفلك الأعلى","https://www.aldiwan.net/poem37806.html","الطويل"],[500,"ترفع عن محاورة الأعادي","https://www.aldiwan.net/poem38026.html","الوافر"],[514,"مضى خلف الأبرار والسيد الطهر","https://www.aldiwan.net/poem20839.html","الطويل"],[515,"أصبت في خير أعضائي وأعضادي","https://www.aldiwan.net/poem12069.html","البسيط"],[537,"إن كانت الخمر قد عزت وقد منعت","https://www.aldiwan.net/poem69405.html","البسيط"],[558,"رويدك أيها البرق اللموع","https://www.aldiwan.net/poem34391.html","الوافر"],[558,"إني أنا بك يا ودود","https://www.aldiwan.net/poem34580.html","مجزوء الكامل"],[567,"شمس الضحى في الغمام مستتره","https://www.aldiwan.net/poem69650.html","الطويل"],[575,"خانت جفوني لما لم تفض بدمي","https://www.aldiwan.net/poem2780.html","البسيط"],[575,"رأت منك رائيتي ما تحب","https://www.aldiwan.net/poem3095.html","المتقارب"]],"verses":[["تَرَفَّعَ في العَلياءِ عَن وَصفِ مادِحٍ","وَرَفَّعتُ عَن مَدحِ المُلوكِ خَواطِري",0,"ر",2,0],["تَرفَعُ ذَيلاً لِمَرا","قي المَجدِ أَو ذَيلاً تَجُرّ",1,"ر",1,0],["تَرَفَّق أَيُّها الرامي المُصيبُ","فَمِن أَغراضِ أَسهُمِكَ القُلوبُ",2,"ب",1,1],["ترفّعَتْ بكَ أو بي همّةٌ تَرَكَتْ","هذا الرُّدَيْنيَّ مَهْزوزَ الأنابيبِ",3,"ب",1,0],["ترفَّقْ وعَلِّلْها بأيْسَرِ نائِلٍ","يَحوطُ ذَماها كالسَّلامِ ورَدِّهِ",4,"د",2,0],["تَرَفَّعَ عَنْ سُلْطَانِ لَحْظِكَ حَاجِبُهْ","وَمِنْ مِثْلِ هذَا الأَمْرِ يَعْجَبُ عَاجِبُهْ",5,"ه",1,1],["تَرفُّ جَنَاهَا عَنْ أُصُول قَدِيمَةٍ","وَدُرَّة مَجْدٍ لاَ تُقَاسُ بِقِيمَة",6,"ه",1,0],["تَرْفَعُ الصَّوْتَ إِنْ مَرَرْتَ عَلَيْهِمْ","كَالْكَرَاكِيِّ أَوْ بَنَاتِ الْمَاءِ",7,"ا",2,0],["تَرِفٌ تخالُ بَنانَهُ في كَفِّهِ","قُضُبَ اللُجَينِ وَلا أَقولُ الإِسحِلا",8,"ل",2,0],["تُرَفِّعُ فَضلَ سابِغَةٍ دِلاصٍ","عَلى خَيفانَةٍ خَفِقٍ حَشاها",9,"ا",3,0],["ترفوف أرواحنا تحته","كما رفرف الطير لما انقلب",10,"ب",1,0],["تَرَفَّقتَ بِالكيرَينَ قَينَ مُجاشِعٍ","وَأَنتَ بِهَزِّ المَشرَفِيَّةِ أَعنَفُ",11,"ف",1,0],["تَرفَعهُم تارة وتَخفِضُهم","إذا طَفَوا فَوقَ آلِها رَسَبُوا",12,"ب",3,0],["ترفع الللأوَا مواهبه","مثل رفع الماء للحدَثِ",13,"ث",1,0],["ترفَّعتُ عن لؤْمِ مَجنِيِّهِ","بنفسي وعن لؤم محطوبِهِ",14,"ب",2,0],["ترفَّعْ عن التعْذير غير مُذمَّم","إلى شرف الإِعذار يخْلُصْ لك الحمدُ",15,"د",1,0],["ترفّعْ إلى النجم العليِّ مكانُه","ونَل كل ما منّاه نفسَك فضلُها",16,"ل",3,1],["تُرَفٌ لأبصارٍ حلَلْنَ بها","لِيرَيْنَ كيف عجائبُ الحِكمِ",17,"م",1,0],["ترفَّعْ إلى الطول العليِّ مكانُهُ","فما تشبه النعمى عليك السخائمُ",18,"م",1,0],["تَرُفُّ حِيالي كُلَّما أَغمَضَ الكَرى","جُفوني جَماعات وَمَثنى وَمَوحِدا",19,"د",2,0],["ترفَّق بِعَبدٍ وُدُّهُ لكً شيمَةٌ","إِذا كانَ ودُّ مَن سِواهُ تَصَنُّعا",20,"ع",2,0],["ترفُقاً يا أَبا يَحيى ومن ظفرت","كَفي بِهِ فَدَعاني فَضلُهُ ظافِرْ",21,"ر",1,1],["تَرفُّ صَحائِفُ البَردِيِّ فيها","وَيَنطُقُ في هَياكِلِها الرُخامُ",22,"م",1,0],["تَرِفّانِ فَوقَ رُفاتِ الفَقيدِ","رَفيفَ الجِنى في أَعالي الغُصُن",23,"ن",1,0],["تَرفُلُ في مُخمَلٍ","نَمَّ وَلَمّا يَتِم",24,"م",1,0],["تَرَفَّق أَيُّها المَولى عَلَيهِم","فَإِنَّ الرِفقَ بِالجاني عِتابُ",25,"ب",1,0],["تُرَفِّعُ ثَوبَها الأَردافُ عَنها","فَيَبقى مِن وِشاحَيها شَسوعا",26,"ع",2,0],["تَرَفَّعَ عَن عَونِ المَكارِمِ قَدرُهُ","فَما يَفعَلُ الفَعلاتِ إِلّا عَذارِيا",27,"ي",2,0],["تَرَفُّقاً في اِطِّلابِ مالِهِمِ","وَجَمعِهِ أَو يَعُمُّهُم بَدَدُه",28,"د",2,0],["تَرَفُّقَ المَرءِ في ذَخيرَتِهِ","آذاهُ ضيقُ الزَمانِ أَو صَلَدُه",28,"د",2,0],["تَرَفَّق فَإِنّي المَرءُ أَوهَنتَ جِسمَهُ","بِلا خَطَإٍ قَد كانَ بَل بِتَعَمُّدِ",29,"د",1,0],["تَرَفَّعَ حَتّى لَم أُرِد حينَ شِمتُهُ","مِنَ الجانِبِ الغَربِيِّ أَن أَتَرَفَّعا",30,"ع",2,0],["تَرُفُّ مُجلِبةَ الأقطارِ مُسفِرةً","تكادُ مَا لَحَظَتها الشمسُ تَشتعِلُ",31,"ل",1,0],["تَرِفُّ بِفِيهِ ضاحِكاً أَقحُوانَةٌ","وَيَهتَزُّ في بُردَيهِ مِنهُ قَضِيبُ",32,"ب",1,0],["تَرَفَّعَ لِلقَنانِ وَكُلِّ فَجٍّ","طَباهُ الرِعيُ مِنهُ وَالخَلاءُ",33,"ا",2,0],["تَرَفّعَ نَحوَ رُبوعِ الحمى","وحلَّ عَزَالِيَهُ وانخَفَض",34,"ض",1,0],["تَرَفّعَ من معاليه مَحَلّا","له في سَمْكِهِ الدريُّ جارُ",35,"ر",1,0],["تَرفَعُ الصَوتَ إِذا لانَت لَها","وَتُراخي عِندَ سَوراتِ الغَضَب",36,"ب",1,0],["تَرِفُّ الحورُ والوِلدانُ شَوْقاً","إلى ما فيه من تَرَفٍ وطيبِ",37,"ب",1,0],["تَرفَضُّ مِن حَولِها الآجالُ جافِلَةً","تَظَلُّ مِن صَعَقاتِ الهَولِ تَختَبِلُ",38,"ل",1,0],["تَرَّفَعُ في جَريٍ كَأَنَ أَطِيطَهُ","صَرِيفَ مُحالٍ يَستَعيدُ الدَوالِيا",39,"ا",1,0],["ترفّعَ عنّا سِجْفُه فكأنّه","يُحيّي بيحيَى صبْحَه المتبَلِّجا",40,"ج",2,0],["تَرفُلُ في نَعلَينِ مِن أَمعائِها","يَحُطُّها لِلأَرضِ مِن سَمائِها",41,"ا",3,0],["تَرَفَّق إِنَّ ديني لَيسَ نَبعاً","وَلَكِن بِالخِلافِ مِنَ الخِلافِ",42,"ف",1,0],["ترفق فإني ذو عيال إذا خلا","مَكانيَ ماتوا في المَجاعَة أجمع",43,"ع",1,0],["ترف روحي عليهن","نَ وَالغَرام نزوع",44,"ع",1,0],["ترفُل في شوكتها","وفي شبابها النِضر",45,"ر",1,0],["ترفُلُ من ديباجها حُلل","من هَزجٍ أو رَجزٍ أو رملِ",46,"ل",1,0],["تَرَفَّقْ فَإِنَّ الرِّفْقَ زَيْنٌ وَقَلَّمَا","يَنالُ الْفَتَى بِالْعُنْفِ ما كانَ طالِبَا",47,"ب",2,1],["تَرِفُّ عَلَى هَامِ الكُمَاةِ سُيُوفُهُ","وَتَخْفُقُ بَيْنَ الْجَحْفَلَيْنِ بُنُودُهُ",48,"د",2,0],["تَرِفُّ كَزَهْرٍ طَوَّحَتْهُ عَوَاصِفٌ","بِلُجَّةِ مَاءٍ فَهْوَ يَطْفُو وَيَغْرَقُ",49,"ق",1,0],["تَرِفُّ كَمَا رَفَّتْ صَحَائِفُ فِضَّةٍ","عَلَيْهِنَّ مِنْ لأْلاءِ شَمْسِ الضُّحَى تِبْرُ",50,"ر",1,0],["تَرَفَّقِي بِفُؤَادٍ أَنْتِ مُنْيَتُهُ","ومُقْلَةٍ لِسِوَى مَرْآكِ ما طَمَحَتْ",51,"ت",1,0],["تَرَفَّعْتَ عَنْ أَنْ تَقْبَلَ الضَّيْمَ صَابِراً","عَلَى زَمَنٍ أَحْسَنْت فِيهِ وَسَاءَ",52,"ا",2,0],["تَرَفَّقَ يا سقامُ بِهِ","أَبَعدَ المُستَوى عِوَجُ",53,"ج",1,0],["تَرَفَّعُ عَمَّنْ يَأَلَفُ اللَّوْمَ هِمَّتي","وَلَمْ أَتَكَلَّفْ عَنْ مَعائِبِهِ بَحْثا",54,"ث",2,0],["تَرفو الظِلالَ بِأَغصانٍ مُهَدَّلَةٍ","سودِ العَناقيدِ في خَضراءَ لَفّاءِ",55,"ا",2,0],["ترفَّعتُ عن أشياءَ ليست تَشِينُنِي","وأعلم أنِّي قد أكون مُغَاليا",56,"ي",2,0],["ترفق وعللها بأيسر نائل","يحوط دماها كالشمال ورده",57,"د",2,0],["ترفَّع من سلطان لحظِكَ حاجبهُ","ومن مثل هذا الأمر يُعجبُ عاجِبهُ",58,"ه",1,1],["ترفعَّ عن طرْقِ الدنايا فمالَه","سوى المجدِ والقلبِ الجريءِ سلالم",59,"م",1,0],["ترفَّعْ أيُّها النجم المُسَجَّى","وزِد في دارة الشَّرَفِ اتّقادا",60,"د",2,0],["ترفّق بقومي واحمهم من ملمّة","لقد نشبت أو آذنت بنشوب",61,"ب",1,0],["تُرَفّ لأبصارٍ يَجُلْنَ بها","لِيرَيْنَ كيف عجائبُ الحِكم",62,"م",1,0],["ترفُّقًا يا أَبا يَحيى ومن ظَفِرتْ","كَفِّي بِهِ فَدَعاني فَضلُهُ الظّافِرْ",63,"ر",1,1],["تَرَفٌ لأبصارٍ كُحلنَ بها","ليُرين كيف عجائبُ الحكم",64,"م",1,0],["ترفّ حضارات عليه وضيئة","وخير كإغداق السماء عميم",65,"م",1,0],["تَرفع شعري إِذ تَضَمَن وَصفُهُ","فَلا بدع أَن يَأبى النُجوم قَوافيا",66,"ي",2,0],["ترفع عن دني الطبع دهرا","ولا تركن لمذموم الخصال",67,"ل",1,1],["ترفق بي فأنت مليك حسن","على اهل الجمال له الرياسه",68,"س",2,0],["ترفرف خمصاء استشاط بها النوى","بذي التل ثكلى دأبها النوح والندب",69,"ب",1,0],["ترفق رعاك الله ان كنت مذنبا","فها انا من ذنبي اتيتك تائبا",70,"ب",2,0],["ترفق بنا كي ننسى ما مر او حلا","فكم انشبت فينا الهموم المخالبا",71,"ب",2,0],["ترفق فؤاديب إنه البعد والجفا","وإنك لا تدري بما الأمرُ مقبل",72,"ل",1,0],["ترفعْ عن الفعلِ الذي يضعُ الفتى","تعشْ سالماً من كل ذامِ مذمِّمِ",73,"م",1,1],["ترفَّق رويدكَ إن السّلَّو","مُراحٌ إليه يعودُ الأنامُ",74,"م",1,0],["تَرَفَّق بقَلبِي في هَواكَ فإنَّما","بُعادُكَ نَارِي واقتِرَابُكَ جَنَّتي",75,"ي",1,0],["ترفّقْ بتلكَ المُبتلاةِ وخُذ لَها","بعونِك يا مِعوانُ كلَّ مَن ابتُلي",76,"ل",2,0],["تَرَفٌ مُغازَلةُ الظّباءِ صَبابَةً","وَدَمُ الحَرائِرِ في بِلادي يُسْفَكُ",77,"ك",1,0],["تَرِفٌ يُميِّله الصِّبا مَيْل الصَّبا","بقَوامِ خُوط البانة المَيّاد",78,"د",1,0],["ترفعُ الطربوشَ في","أهلِ الهوى رايةُ حربِ",79,"ب",1,0],["ترفُّ قوافيها إذا هيَ أقبَلتْ","تزفُّ معانِيها إليكَ سُطورُها",80,"ر",3,0],["ترفق فكم من حي زينب في الحمى","فقلت لهم ما كل زينب زينب",81,"ب",1,0],["ترف عليه من قَتام عباءةٌ","وبالبيضِ والسّمرِ الرديني تَنْعَطّ",82,"ط",1,0],["ترفُ المحاسِنِ ليس في","ه لمن يروم العَيْبَ لولا",83,"ل",2,0],["تَرَفّعَ عَن حَدِّ الملاحَةِ رُتبَةً","فَأَحمَدتُ فِعلاً حَيثُ أَسكنَتهُ الصَدَرا",84,"ر",2,0],["تَرَفَّقَ في الدَمِ المَحظورِ عَمداً","وَلا قَوَدٌ عَليهِ وَلا جُناحُ",85,"ح",1,0],["ترفرف فوقها الرايات نشوى","على رأس الأسنة والرماح",86,"ح",1,0],["ترفق بي فديتك يا رَفيقي","فَما عين سويهرة كوسنا",87,"ن",2,0],["ترفقوا بفؤاد في هوادجكم","راحَت به يوم راحَت بالهَوى الابل",88,"ل",1,0],["تَرَفَّعَتُ إِلاّ عَنْ نَدى ابْنِ مُحَسِّنٍ","وَخَيْرُ النَّدى ما كانَ فِيهِ جَمالُ",89,"ل",1,0],["تَرَفَّعَ مَطْلَبِي عَنْ كُلِّ جُودٍ","فَما أَبْغِي بِجُودِكَ مِنْ بَدِيلِ",90,"ل",1,0],["ترفقْ بمن جرَّعته الصابَ إِنه","بوجهك ما جرَّعته الصابَ يبصق",91,"ق",1,0],["ترفق ولا تجزع على فائت الوفا","فما عند رسم دارس من معول",92,"ل",1,0],["تَرَفّع فَما العَلياء إِلّا ثَلاثة","يَد وَلِسان وَالفواد المُطَهّرُ",93,"ر",1,0],