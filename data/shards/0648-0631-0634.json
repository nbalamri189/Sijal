/59493","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59454","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114562","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114405","الرمل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102962","الكامل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35630","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111518","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111418","المتقارب"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86392","الرمل"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107279","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81709","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73140","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73115","الخفيف"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66097","المتقارب"],[4485,"","https://poetry.dctabudhabi.ae/diwan/poem/132211","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72489","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141567","الكامل"],[4729,"الحُشُّ والبَرَمُالكثيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=109451",""],[4830,"قاضي الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=193673",""],[4927,"قصيدة لعيني عُروة وعَفْراء","https://www.poetsgate.com/ViewPoem.aspx?id=29954",""],[4929,"جمالك ماله ثاني","https://www.poetsgate.com/ViewPoem.aspx?id=199239",""],[4978,"تشطير قصيدة لو كان حبك","https://www.poetsgate.com/ViewPoem.aspx?id=177254",""],[5072,"هذي الفتاة","https://www.poetsgate.com/ViewPoem.aspx?id=34350",""],[5183,"نَبْعُ الفضلِ","https://www.poetsgate.com/ViewPoem.aspx?id=186454",""],[5183,"بين العيد والمدرسة","https://www.poetsgate.com/ViewPoem.aspx?id=185683",""],[5205,"حتام يا من صان ظلماً","https://www.poetsgate.com/ViewPoem.aspx?id=120990",""],[5626,"شعب العراق","https://www.poetsgate.com/ViewPoem.aspx?id=189495",""],[5725,"ورشيق قدٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=188566",""],[5790,"أما وبدور الكلل","https://www.poetsgate.com/ViewPoem.aspx?id=112122",""],[5815,"رفقاً","https://www.poetsgate.com/ViewPoem.aspx?id=190221",""],[5963,"إِذا كنتَ وادي النمل","https://www.poetsgate.com/ViewPoem.aspx?id=187379",""],[5973,"وعصرت َفي شفتيَّّ جِلدك َ كلَّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=13750",""],[5977,"لا تعد","https://www.poetsgate.com/ViewPoem.aspx?id=213267",""],[6147,"حنين إلى الفار المخلوع","https://www.poetsgate.com/ViewPoem.aspx?id=151693",""],[6180,"امرأة في داخلي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81072&r=&rc=6",""],[6213,"غرام متجدد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85498&r=&rc=101",""]],"verses":[["وَرَشَّحَ مِن هَنَّا وَهَنَّا حَديثَهُ","لِيَخدَعَني وَاللَّيلُ يُغتالُ حاطِبُهْ",0,"ب",2,0],["ورِشتمْ جناح الآملين وطوّقت","رقابٌ بنعماكم فلا غرْوَ أن تشدو",1,"د",2,0],["ورشدةٍ كان من مَفاتحها","وغيَّةٍ كان من مغالقها",2,"ق",3,0],["وَرَشيدٌ نَغمَةٌ شادِيَةٌ","وَنَسيبٌ نَغَمٌ مُستَبشِرُ",3,"ر",1,0],["ورشّ عليه ماء العين حتى","يرطبه لدى السحق المبارك",4,"ك",1,0],["ورشَّحَ مشبوحَ الذارعينِ ضَيْغَماً","له في ظِلال السَّمْهريّةِ غِيْلُ",5,"ل",1,0],["وَرَشَفتُ بَردَ الراحِ مِن مَعسولِهِ","وَضَمَمتُ قَدَّ اللَدنِ مِن عَسالِهِ",6,"ل",2,0],["وَرَشِّ الفَتاةِ الطَلُّ بِالأَبطَحِ الَّذي","جَلَسنا إِلَيهِ وَالمَطِيُّ بِأَقتُدِ",7,"د",1,0],["ورشاشُ موجٍ مستطارٌ تحتهُ","زبدٌ يفور الرغو ملءَ كراتهِ",8,"ه",1,0],["ورشيقاتُ الخطى في وقعها","مُنبئاتي بشبابٍ ساحرِ",9,"ر",1,0],["وَرَشَوْتُ الْهَوَى بِلُؤْلُؤِ دَمْعِي","وَالرُّشَا وُصْلَةٌ لِنَيْلِ التَّرَقِّي",10,"ق",2,0],["ورشفنا كأس الحميا فباحت","بالذي في الصدور منا الوجوه",11,"و",2,0],["ورشحوه ليومٍ فيه ندفع عَنْ","أحسابنا، إن هذا اليومَ قد قرُبَا",12,"ب",2,0],["ورشحتني أياديك الجسام إلى","طلاب ما لم يكن عندي ولا قبلي",13,"ل",2,0],["ورَشفي حيثُ يبتسمُ الأقاحي","وشَمِّي حيثُ تَنْعجنُ الغَوالي",14,"ل",2,0],["وَرَشْفَ أَقاحِيِ الثَّغْرِ المُنَدَّى","مُنَوَّرُه بمعسولِ الرُّضاب",15,"ب",1,0],["ورشفتُ معسولَ الرضاب كأنما","فُضَّت عليه لَطيمةٌ ودِنان",16,"ن",1,0],["ورشد ابن رشد وحزم ابن حزم","ورأي الإمام وفقه الحسن",17,"ن",1,0],["وَرُشْدُ أَبِي أَسْنَى الذِي قَدْ طَلَبْتَهُ","وَصِحَّتُهُ مِنْ خَيْرِ مَا عَشِقَ الْبَالُ",18,"ل",1,0],["وَرشفتُ من فيه البَرود سُلافةً","أَروت بنَشوتها غَليلَ عطاشي",19,"ش",2,0],["وَرُشد إِرشاده كَالماء يخمدُ ما","بِالقَلب أَورَت زِناد الغيّ مِن شَرَرِ",20,"ر",1,0],["ورَشّفنَ الخلِيّ مدامَ لهو","وجَرَّعنَ الحميم حميم آن",21,"ن",1,0],["وَرشادي اِن يَكُن في سَلوَتي","فَدَعوني لَستُ أَرضى بِالرَشاد",22,"د",1,0],["ورَشْقةً تَخطِفُ الأرواحَ صائبةً","مِمّا تُطايرُهُ نارُ الوغَى شَرَرا",23,"ر",2,0],["ورِشاءُ فِكْرٍ مُرسَلٌ من كفّهِ","أبداً به درُّ الكلامِ نَبيث",24,"ث",1,0],["وَرَشاشُ بَحرِ النَقع يو","مَ حُروبِهِ لِلشَمسِ يُغرِق",25,"ق",1,0],["ورشفت ماء الإضاء والغدر","ولاح للعين سهيل في سحر",26,"ر",1,0],["ورشيد الراي ومأمون الاقبال","ومعتصم طهرا",27,"ر",2,0],["ورشفت كاس مدامة","عاطيتها فماً بفم",28,"م",1,0],["ورش الماء للشلال حتى","ليقهره كشيطان رجيم",29,"م",1,0],["ورشّحتُه يرمِي الشواكلَ رأيُهُ","ويُغني وأطرافُ الأسنّة لا تُغني",30,"ن",2,0],["ورِشتَ محصوصةَ الآدابِ فانفسحتْ","محلّقاتٍ لهنّ القُورُ والقِمَمُ",31,"م",1,0],["ورِشْ بالنوال جَناحي أطرْ","وبالإذنِ في مَهَلي أُسرِعِ",32,"ع",1,0],["ورِشت فطارَ وهو أحصُّ ترمي","محلّقةُ النسور به الضباعا",33,"ع",2,0],["ورُشِّح عاتقُه للنِّجادِ","ولم تُلْقَ أخرازُه والسيورُ",34,"ر",1,0],["ورِشْتَ من أبنائه أجنِحةً","طار حَصيصاً ريشُهُ البدائدُ",35,"د",1,0],["ورشفةٍ كانت على","نارِ حشاي نَضْحا",36,"ح",2,0],["ورَشَاشُ الطَّلِّ عن أَدمعِهِمْ","قد روَى من مُزْنِها ما انْسَجَما",37,"م",2,0],["ورشَشْتَ فوقَ المُرْسَلي","نَ الزُّهْرِ رَشًّا من بَهائِكْ",38,"ك",1,0],["ورشّقْتُها حتّى حكى التِبْر تُربها","ولو لم تكنْ في أرضِها أصبحتْ قَفْرا",39,"ر",2,0],["ورشحت الوزارة منك شبلاً","حمى حرم الخلافة أن يضاما",40,"م",2,0],["ورشح منه الليث شبل عرينه","له أجمات السمهري عرين",41,"ن",1,0],["ورشدك إن أتاك وصرت تحضر","تأمل في خلال الأرض وانظر",42,"ر",1,0],["وَرُشدُكَ ما أَبداهُ فَاِنكَشَفَ العَمى","وَوَجهُكَ ما أَبهى وَقَلبُكَ ما أَصفى",43,"ف",2,0],["ورشفْتُ راح رُضابِهِ","فوجدته حُلْوَ المَذاقْ",44,"ق",1,0],["ورشَفْتُ ريقَتَه على رَغْم الطِّلا","من كأْسِ مَرْشَفه على غيْظ القَدَحْ",45,"ح",1,0],["وَرَشِيقَةُ الأَعْطَافِ ذاتُ مُقبَّلٍ","يَفْتَرُّ عَنْ عَذْبِ الرّضَابِ بَرُودِ",46,"د",1,0],["وَرشفُ ثَنايا طالَما ظَميَت لها","شِفاهٌ ثَناياها عذابُ المَراشِف",47,"ف",1,0],["وَرَشاد وَهَيبة وَجَلال","زانَهُ حكمة وَمَجد تَليد",48,"د",1,0],["وَرَشَفْتُ من ثَغْر الأَقاحةِ ريقَها","وضَمَمْتُ أعْطافَ الغُصونِ المُيَّسِ",49,"س",1,0],["ورشق من النشاب يحدون ورده","إذا ركضوا فيه الحني المواطرا",50,"ر",2,1],["ورشف بنت الكروم صرفاً","أو لا فعيش الأنام فاسد",51,"د",1,0],["ورَشقتِني عن مُقلتي","كِ بفاترِ السّهم المُصيبِ",52,"ب",1,0],["ورشَّ كافورَ عارِضَيْهِ","بالمسكِ إذ رشَّ أَيَّ رشِّ",53,"ش",1,0],["ورشاقةٌ موموقةٌ ولباقةُ","وتفتُّلٌ مستملحٌ وتكسُّر",54,"ر",1,0],["وَرَشَفْنَا مِنَ الثغُورِ كُؤُوسًا","رَاحُهَا فِيهِ رَاحَةُ العُشَّاقِ",55,"ق",1,0],["ورشفتُ رِيقتَهُ فَشَبَّ بِمُهْجَتِي","لَهَبُ الجَوَى من رَشْفِ ماءِ السكَّرِ",56,"ر",1,0],["وَرُشدي بِأُفقِ المُلكِ أَرختهُ بِهِ","أَناديهِ لي صَدراً وَصَدري حَوى الرُشدا",57,"د",2,0],["ورشفت راح رضابه","بالروح ذاك الرح يشرى",58,"ر",2,0],["ورشيقٍ قده بل راشقٌ","لحظه قد ملأ القلبَ سهاما",59,"م",2,0],["ورشان الهوى تزقي فراخا","علقت بالمهيمن الفتاح",60,"ح",1,0],["وَرِشْتَ جَنَاحي بالمواهبِ واللُّهَا","فطار بها حظّي ولستُ بطائر",61,"ر",1,0],["وَرَشَفنا مِنَ الشِفاهِ كُؤوساً","لَم تَذُقها مَراشِفٌ بَشَرِيَّه",62,"ي",2,0],["ورشاد خليفة الحق فينا","هادم للضلال والطغيان",63,"ن",1,0],["ورشفت أزهارَ الأقاح كأنَّما","هي والشقيق مباسمٌ وخُدود",64,"د",1,0],["وَرشدي أَيّ مِقدام غَيور","وَأَي فَتىً إِلى الخَيرات سابق",65,"ق",1,0],["ورشيق القد قد أجرى دمي","أهيف تركي وعذالي يهود",66,"د",1,0],["ورشفت خمر لماه ب","ين عواذلي وعواذري",67,"ر",2,0],["ورُشداً مِن مواعِظَ قارِعاتٍ","هدَيتَ بِها المدائِنَ والقَبِيلا",68,"ل",2,0],["وَرَشَفنا مِن شِفاهٍ جَمَعَت","نَغمَةَ اللّطفِ بِثَغرٍ أَلعَس",69,"س",1,0],["ورشف مدامة من كف ساق","مليح الوجه محمود الخصال",70,"ل",1,0],["ورشيقاً بخصرهِ","ما بجسمي من الضنا",71,"ن",2,0],["وَرَشفة خَمر في رِياض نَضيرة","كَرَشفة ثَغر قَد تَكون مِن شَهد",72,"د",1,0],["وَرَشفت جُرعة كَوثر في جَوهر","وَلَثَمت دارة خدها الوَقاد",73,"د",1,0],["ورَشْفِي رُضاباً كالرَّحيقِ المُسَلْسَل","وَلَمْ أنسَ إِذ يحنُو عليَّ بقَدِّه",74,"ه",1,0],["ورشقتني بسهام لطف دونها","سهم اللواحظ اذ عليَّ يفوق",75,"ق",1,0],["ورشفت لماً فيه بدلاً","عن مرسله نحوي طربا",76,"ب",2,0],["ورشيقة المعاطف","رأتو بين السناجق",77,"ق",1,0],["ورشفتُ من فيها وقد غلب الكرى","ظلَماً ألذَّ من الرحيق السلسلِ",78,"ل",1,0],["ورشَفِ ظَلمِ ثَغرِها المُفَّلجِ","بَل ربَّ دَوَ سبْسَبٍ لم ينهج",79,"ج",1,0],["ورشاً رشادي يومَ يَعطِفُ باللِّقا","غُصنٌ يغارُ البانُ منهُ إذا مشى",80,"ش",2,1],["ورشيقُ القدِّ زاهٍ","زاهِرٌ يَبري عظامي",81,"م",2,0],["ورشفته فعجبت من قلقي به","عطشا ولم يك منه أعذب مورد",82,"د",1,0],["وَرَشَفتُ مِن فيهِ عَلى ظَمأٍ","بَردا إِذا نَقع الصَدى أَظما",83,"م",2,0],["ورشق النبل بلا اضطراب","مسدداً والطير في السحاب",84,"ب",1,0],["ورَشحُ الصُّدُوبرِ يَسِيلُ علَى","مِجَنٍّ عَلا فوقَ دِرعٍ خَضيبِ",85,"ب",1,0],["ورشيق القد قد أرشفني","في مغاني لهوه خمراً وريقا",86,"ق",2,0],["وَرَشَفتَ راحَ الفخرِ غيرَ مُحَرَّمٍ","وَقنَصتَ صَيدَ المجدِ غيرَ مُنَفّرِ",87,"ر",1,0],["ورشاً تزيد تغيظاً أجفانه","إذ لا يقابل ظُلمَها بتغيّظ",88,"ظ",1,0],["ورَشيقةٍ ممشوقةٍ لو نُقِّبت","بالبَدرِ ليلةَ تَمِّهِ لم يُسفرِ",89,"ر",1,0],["ورشيقُ القَوامِ قد رشَقتني","عن قِسيِّ من جاجبيهِ نِبالُ",90,"ل",1,0],["وَرَشْفِ الزُّلالِ وطِيبِ الظِّلالِ","وسُودُ اللَّيالي تَخِيطُ الكَفَنْ",91,"ن",1,0],["ورشيظ والوظف والخظ والمحظور","والخظبان والانكاظ",92,"ظ",1,0],["ورشفت من ثغر الهنا كأس المنى","ودنا السرور إلى فؤادي دنا",93,"ن",2,0],["ورشحتُ لذَّات قبيل نتاجه","حتى إذا باشرت عدت نشوفا",94,"ف",2,0],["وَرَشاشُ ماءِ الوردِ قد","عَرَفتُ به تلك النُّحورُ",95,"ر",1,0],["ورشفتُ من راحِ اللّمى وَطَراً","واليومَ أرشفُ نأيَه جمْرا",96,"ر",2,0],["وَرَشَفْتُ مِنْ نَبْعِ الْمَحَبَّةِ بَلْسَماً","وَهَجَرْتُ مَاْءَ لَكَاْعَةٍ ضَحْضَاْحَاْ",97,"ح",2,0],["ورشد ضلالتي أوحى","إلى عقلي بهجراني",98,"ن",2,0],["(ورشفتها سحراً وطيباً غامرا )","تمحو العذاب وتطعم الأغرابا",99,"ب",2,0],["ورشفتُ آذاري بشُرفة روضِها","وتضيقُ صحرائي بحُرقةِ آبِها",100,"ب",3,0],["ورشقة ممسَّوقه قلبتها","تحت الظلام ووجهها وضاء",101,"ا",2,0],["ورشفت من بَرَد الرحيق رضابه","عن مبسم ماء الحياة حليفه",102,"ف",2,0],["ورشفت منه زلاله","فمن السعير أراه أحمى",103,"م",2,0],["وَرَشْفَةٌ مِنْ دِماءِ الشَّعبِ تُنْعِشُهُمْ","حَتّى غَدَا دَمُنا حِلّاً لَهُمْ خَمْرا",104,"ر",2,0],["ورشيق قدٍّ قد توطّن داؤه","بالقلب سقماً فاستحال شفاؤهُ",105,"ا",3,1],["ورشف شفى غلتي","وبالرشف تشفى الغلل",106,"ل",1,0],["ورشفت من ورد الشفاه فلم أذقْ‎","شهداً تلألأ مثلما في فيكِ ‏‎",107,"ك",1,0],["وَرَشَّحْتَ لِلأَنْيَابِ صَدْراً مُدَلّلاً","رَمَىٰ القَلْبَ لَمَّا فَاجَأَتْهُ المَخَالبُ !",108,"ب",1,0],["ورشفت َ شهديَ والدوارُ","يلُفُّنا.. ورشفت ُ شهدَكْ",109,"ك",1,0],["ورشفتُ من حلو الحديث وقد بدا","أن المحبة قوة لا تهزم",110,"م",1,0],["ورشِّقْ غرابينَك السودَ فوق","السطوح لتَشفي بقتلي الغليل",111,"ل",1,0],["ورشَّتِ الملحَ على جرحي، فصارَ زهراً","وأطلقتْ في القلبِ من نزيفِهِ العبيرا",112,"ر",2,0],["ورشفتُ منك الرشفة المثلى لكي","أبقى على عهدي وفيه دوام",113,"م",1,0]]}