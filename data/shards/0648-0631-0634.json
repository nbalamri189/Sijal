{"poems":[[63,"أدار بأكناف الحمى جادها الحيا","https://www.aldiwan.net/poem45799.html","الطويل"],[72,"صدودك يا لمياء عني ولا البعد","https://www.aldiwan.net/poem18549.html","الطويل"],[51,"يا نجدة الروم في بطارقها","https://www.aldiwan.net/poem65502.html","المنسرح"],[91,"لا تسل أين الهوى والكوثر","https://www.aldiwan.net/poem8828.html","عموديه"],[62,"إذا ما الشمس في السرطان صارت","https://www.aldiwan.net/poem52157.html","الوافر"],[62,"إذا لم يعن قول النصيح قبول","https://www.aldiwan.net/poem52321.html","الطويل"],[66,"حوشيت من زفرات قلبي الواله","https://www.aldiwan.net/poem41372.html","الكامل"],[31,"ثلاثة أحجار وخط خططته","https://www.aldiwan.net/poem42568.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39672","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39602","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42711","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142019","الخفيف"],[106,"استعطاف وتبرئة","https://www.poetsgate.com/ViewPoem.aspx?id=179393",""],[158,"غايات جودك لا تبطي عن الامل","https://www.aldiwan.net/poem59074.html","البسيط"],[164,"يذكرني الحمى عهد الوصال","https://www.aldiwan.net/poem46897.html","الوافر"],[183,"عسى يبلى العذول ببعض ما بي","https://www.aldiwan.net/poem14126.html","الوافر"],[183,"هذا الفراق وهذه الأظعان","https://www.aldiwan.net/poem14686.html","الكامل"],[209,"إمام تقلد خير الخلال","https://www.aldiwan.net/poem46294.html","المتقارب"],[235,"قصدت أبا يعزى وبالبال بلبال","https://www.aldiwan.net/poem18852.html","الطويل"],[295,"وافاك نشوان المعاطف ناشي","https://www.aldiwan.net/poem33234.html","الكامل"],[351,"خذ في هوى الغيد عني أحسن الخبر","https://www.aldiwan.net/poem40343.html","البسيط"],[354,"أثار الدمع مرفض الجمان","https://www.aldiwan.net/poem24537.html","الوافر"],[359,"ان وجدي كل يوم في ازدياد","https://www.aldiwan.net/poem68123.html","الرمل"],[362,"أما الغزال الذي أهوى فقد هجرا","https://www.aldiwan.net/poem60918.html","البسيط"],[362,"أأراكة الوادي سقتك غيوث","https://www.aldiwan.net/poem60972.html","الكامل"],[364,"قم فاسقني مما تروق","https://www.aldiwan.net/poem17235.html","مجزوء الكامل"],[376,"قد علمت خود بساقيها الغفر","https://www.aldiwan.net/poem4547.html","الرجز"],[426,"سعد العلياء جلا ثغرا","https://www.aldiwan.net/poem40840.html","المتدارك"],[426,"أسناء برق لاح أم","https://www.aldiwan.net/poem41420.html","مجزوء الكامل"],[451,"ترفع عن معاداة الكريم","https://www.aldiwan.net/poem61339.html","الوافر"],[456,"كم النحت في جنبي والحز في متني","https://www.aldiwan.net/poem55835.html","الطويل"],[456,"ظل المنى واسع والشمل ملتئم","https://www.aldiwan.net/poem55869.html","البسيط"],[456,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[456,"حماها أن تشل وأن تراعا","https://www.aldiwan.net/poem56121.html","الوافر"],[456,"إذا رفعت من شراف الخدور","https://www.aldiwan.net/poem56193.html","المتقارب"],[456,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[456,"قل للزمان صلحا","https://www.aldiwan.net/poem56249.html","مجزوء الرجز"],[498,"أي ورد قد شممناه ضحى","https://www.aldiwan.net/poem37781.html","الرمل"],[498,"سقط الفحول عن الأرائك","https://www.aldiwan.net/poem38102.html","مجزوء الكامل"],[512,"طلبت عظيم المجد بالهمة الكبرى","https://www.aldiwan.net/poem20833.html","الطويل"],[513,"محلك لا يسام ولا يسامى","https://www.aldiwan.net/poem12260.html","الوافر"],[513,"ولاؤك دين في الرقاب ودين","https://www.aldiwan.net/poem12276.html","الطويل"],[556,"حباك الله بالنعما لتشكر","https://www.aldiwan.net/poem34280.html","الوافر"],[561,"غرام سقى قلبي مدامته صرفا","https://www.aldiwan.net/poem13596.html","الطويل"],[573,"ظبي بمصر نسيت منه","https://www.aldiwan.net/poem2908.html","مجزوء الكامل"],[573,"يا قلب ويحك إن ظبيك قد سنح","https://www.aldiwan.net/poem3091.html","الكامل"],[584,"حييت يا ربع الحمى بزرود","https://www.aldiwan.net/poem17493.html","الكامل"]],"verses":[["وَرَشَّحَ مِن هَنَّا وَهَنَّا حَديثَهُ","لِيَخدَعَني وَاللَّيلُ يُغتالُ حاطِبُهْ",0,"ب",2,0],["ورِشتمْ جناح الآملين وطوّقت","رقابٌ بنعماكم فلا غرْوَ أن تشدو",1,"د",2,0],["ورشدةٍ كان من مَفاتحها","وغيَّةٍ كان من مغالقها",2,"ق",3,0],["وَرَشيدٌ نَغمَةٌ شادِيَةٌ","وَنَسيبٌ نَغَمٌ مُستَبشِرُ",3,"ر",1,0],["ورشّ عليه ماء العين حتى","يرطبه لدى السحق المبارك",4,"ك",1,0],["ورشَّحَ مشبوحَ الذارعينِ ضَيْغَماً","له في ظِلال السَّمْهريّةِ غِيْلُ",5,"ل",1,0],["وَرَشَفتُ بَردَ الراحِ مِن مَعسولِهِ","وَضَمَمتُ قَدَّ اللَدنِ مِن عَسالِهِ",6,"ل",2,0],["وَرَشِّ الفَتاةِ الطَلُّ بِالأَبطَحِ الَّذي","جَلَسنا إِلَيهِ وَالمَطِيُّ بِأَقتُدِ",7,"د",1,0],["ورشاشُ موجٍ مستطارٌ تحتهُ","زبدٌ يفور الرغو ملءَ كراتهِ",8,"ه",1,0],["ورشيقاتُ الخطى في وقعها","مُنبئاتي بشبابٍ ساحرِ",9,"ر",1,0],["وَرَشَوْتُ الْهَوَى بِلُؤْلُؤِ دَمْعِي","وَالرُّشَا وُصْلَةٌ لِنَيْلِ التَّرَقِّي",10,"ق",2,0],["ورشفنا كأس الحميا فباحت","بالذي في الصدور منا الوجوه",11,"و",2,0],["ورشحوه ليومٍ فيه ندفع عَنْ","أحسابنا، إن هذا اليومَ قد قرُبَا",12,"ب",2,0],["ورشحتني أياديك الجسام إلى","طلاب ما لم يكن عندي ولا قبلي",13,"ل",2,0],["ورَشفي حيثُ يبتسمُ الأقاحي","وشَمِّي حيثُ تَنْعجنُ الغَوالي",14,"ي",1,0],["وَرَشْفَ أَقاحِيِ الثَّغْرِ المُنَدَّى","مُنَوَّرُه بمعسولِ الرُّضاب",15,"ب",1,0],["ورشفتُ معسولَ الرضاب كأنما","فُضَّت عليه لَطيمةٌ ودِنان",16,"ن",1,0],["ورشد ابن رشد وحزم ابن حزم","ورأي الإمام وفقه الحسن",17,"ن",1,0],["وَرُشْدُ أَبِي أَسْنَى الذِي قَدْ طَلَبْتَهُ","وَصِحَّتُهُ مِنْ خَيْرِ مَا عَشِقَ الْبَالُ",18,"ل",1,0],["وَرشفتُ من فيه البَرود سُلافةً","أَروت بنَشوتها غَليلَ عطاشي",19,"ي",1,0],["وَرُشد إِرشاده كَالماء يخمدُ ما","بِالقَلب أَورَت زِناد الغيّ مِن شَرَرِ",20,"ر",1,0],["ورَشّفنَ الخلِيّ مدامَ لهو","وجَرَّعنَ الحميم حميم آن",21,"ن",1,0],["وَرشادي اِن يَكُن في سَلوَتي","فَدَعوني لَستُ أَرضى بِالرَشاد",22,"د",1,0],["ورَشْقةً تَخطِفُ الأرواحَ صائبةً","مِمّا تُطايرُهُ نارُ الوغَى شَرَرا",23,"ر",2,0],["ورِشاءُ فِكْرٍ مُرسَلٌ من كفّهِ","أبداً به درُّ الكلامِ نَبيث",24,"ث",1,0],["وَرَشاشُ بَحرِ النَقع يو","مَ حُروبِهِ لِلشَمسِ يُغرِق",25,"ق",1,0],["ورشفت ماء الإضاء والغدر","ولاح للعين سهيل في سحر",26,"ر",1,0],["ورشيد الراي ومأمون الاقبال","ومعتصم طهرا",27,"ر",2,0],["ورشفت كاس مدامة","عاطيتها فماً بفم",28,"م",1,0],["ورش الماء للشلال حتى","ليقهره كشيطان رجيم",29,"م",1,0],["ورشّحتُه يرمِي الشواكلَ رأيُهُ","ويُغني وأطرافُ الأسنّة لا تُغني",30,"ي",1,0],["ورِشتَ محصوصةَ الآدابِ فانفسحتْ","محلّقاتٍ لهنّ القُورُ والقِمَمُ",31,"م",1,0],["ورِشْ بالنوال جَناحي أطرْ","وبالإذنِ في مَهَلي أُسرِعِ",32,"ع",1,0],["ورِشت فطارَ وهو أحصُّ ترمي","محلّقةُ النسور به الضباعا",33,"ع",2,0],["ورُشِّح عاتقُه للنِّجادِ","ولم تُلْقَ أخرازُه والسيورُ",34,"ر",1,0],["ورِشْتَ من أبنائه أجنِحةً","طار حَصيصاً ريشُهُ البدائدُ",35,"د",1,0],["ورشفةٍ كانت على","نارِ حشاي نَضْحا",36,"ح",2,0],["ورَشَاشُ الطَّلِّ عن أَدمعِهِمْ","قد روَى من مُزْنِها ما انْسَجَما",37,"م",2,0],["ورشَشْتَ فوقَ المُرْسَلي","نَ الزُّهْرِ رَشًّا من بَهائِكْ",38,"ك",1,0],["ورشّقْتُها حتّى حكى التِبْر تُربها","ولو لم تكنْ في أرضِها أصبحتْ قَفْرا",39,"ر",2,0],["ورشحت الوزارة منك شبلاً","حمى حرم الخلافة أن يضاما",40,"م",2,0],["ورشح منه الليث شبل عرينه","له أجمات السمهري عرين",41,"ن",1,0],["ورشدك إن أتاك وصرت تحضر","تأمل في خلال الأرض وانظر",42,"ر",1,0],["وَرُشدُكَ ما أَبداهُ فَاِنكَشَفَ العَمى","وَوَجهُكَ ما أَبهى وَقَلبُكَ ما أَصفى",43,"ف",2,0],["ورشفْتُ راح رُضابِهِ","فوجدته حُلْوَ المَذاقْ",44,"ق",1,0],["ورشَفْتُ ريقَتَه على رَغْم الطِّلا","من كأْسِ مَرْشَفه على غيْظ القَدَحْ",45,"ح",1,0],["وَرَشِيقَةُ الأَعْطَافِ ذاتُ مُقبَّلٍ","يَفْتَرُّ عَنْ عَذْبِ الرّضَابِ بَرُودِ",46,"د",1,0]]}