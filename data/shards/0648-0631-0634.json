{"poems":[[63,"أدار بأكناف الحمى جادها الحيا","https://www.aldiwan.net/poem45799.html","الطويل"],[72,"صدودك يا لمياء عني ولا البعد","https://www.aldiwan.net/poem18549.html","الطويل"],[51,"يا نجدة الروم في بطارقها","https://www.aldiwan.net/poem65502.html","المنسرح"],[91,"لا تسل أين الهوى والكوثر","https://www.aldiwan.net/poem8828.html","عموديه"],[62,"إذا ما الشمس في السرطان صارت","https://www.aldiwan.net/poem52157.html","الوافر"],[62,"إذا لم يعن قول النصيح قبول","https://www.aldiwan.net/poem52321.html","الطويل"],[66,"حوشيت من زفرات قلبي الواله","https://www.aldiwan.net/poem41372.html","الكامل"],[31,"ثلاثة أحجار وخط خططته","https://www.aldiwan.net/poem42568.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39672","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39602","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42711","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142019","الخفيف"],[106,"استعطاف وتبرئة","https://www.poetsgate.com/ViewPoem.aspx?id=179393",""]],"verses":[["وَرَشَّحَ مِن هَنَّا وَهَنَّا حَديثَهُ","لِيَخدَعَني وَاللَّيلُ يُغتالُ حاطِبُهْ",0,"ب",2,0],["ورِشتمْ جناح الآملين وطوّقت","رقابٌ بنعماكم فلا غرْوَ أن تشدو",1,"د",2,0],["ورشدةٍ كان من مَفاتحها","وغيَّةٍ كان من مغالقها",2,"ق",3,0],["وَرَشيدٌ نَغمَةٌ شادِيَةٌ","وَنَسيبٌ نَغَمٌ مُستَبشِرُ",3,"ر",1,0],["ورشّ عليه ماء العين حتى","يرطبه لدى السحق المبارك",4,"ك",1,0],["ورشَّحَ مشبوحَ الذارعينِ ضَيْغَماً","له في ظِلال السَّمْهريّةِ غِيْلُ",5,"ل",1,0],["وَرَشَفتُ بَردَ الراحِ مِن مَعسولِهِ","وَضَمَمتُ قَدَّ اللَدنِ مِن عَسالِهِ",6,"ل",2,0],["وَرَشِّ الفَتاةِ الطَلُّ بِالأَبطَحِ الَّذي","جَلَسنا إِلَيهِ وَالمَطِيُّ بِأَقتُدِ",7,"د",1,0],["ورشاشُ موجٍ مستطارٌ تحتهُ","زبدٌ يفور الرغو ملءَ كراتهِ",8,"ه",1,0],["ورشيقاتُ الخطى في وقعها","مُنبئاتي بشبابٍ ساحرِ",9,"ر",1,0],["وَرَشَوْتُ الْهَوَى بِلُؤْلُؤِ دَمْعِي","وَالرُّشَا وُصْلَةٌ لِنَيْلِ التَّرَقِّي",10,"ق",2,0],["ورشفنا كأس الحميا فباحت","بالذي في الصدور منا الوجوه",11,"و",2,0],["ورشحوه ليومٍ فيه ندفع عَنْ","أحسابنا، إن هذا اليومَ قد قرُبَا",12,"ب",2,0]]}