{"poems":[[55,"ألمع برق أم ضرم","https://www.aldiwan.net/poem29820.html","مجزوء الرجز"],[73,"كل ذي أبنة له واحد يعلوه","https://www.aldiwan.net/poem3820.html","الخفيف"],[53,"ما على الأحرار من رق إذا","https://www.aldiwan.net/poem61880.html","الرمل"],[53,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[93,"كل ميت مهما علا في حياته","https://www.aldiwan.net/poem8780.html","عموديه"],[72,"غبت عني فما الخبر","https://www.aldiwan.net/poem42903.html","مجزوء الخفيف"],[87,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[45,"أتراها لكثرة العشاق","https://www.aldiwan.net/poem9745.html","الخفيف"],[47,"نفست قربها علينا كنود","https://www.aldiwan.net/poem62739.html","الخفيف"],[82,"خلعت على بنيات الكروم","https://www.aldiwan.net/poem31295.html","الوافر"],[107,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[48,"كل ذكر من بعده نسيان","https://www.aldiwan.net/poem23463.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54935","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54214","الخفيف"],[47,"نَفّسَتْ قُرْبَها عَلَيناَ كَنُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=32955",""],[90,"طرب الشعر أن يكون نسيبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19532&r=&rc=35",""],[203,"ما لأيام ذا الصبا تتفانى","https://www.aldiwan.net/poem45673.html","الخفيف"],[214,"لا وعهد الصبا وعيش هواها","https://www.aldiwan.net/poem13367.html","الخفيف"],[226,"من طريف الآثار والأخبار","https://www.aldiwan.net/poem55284.html","الخفيف"],[240,"من عذيري فيه وهل من عذير","https://www.aldiwan.net/poem32017.html","الخفيف"],[266,"حلب الشهباء في الارض علت","https://www.aldiwan.net/poem38128.html","الرمل"],[287,"لست أسلو الشادن الأحوى الأغنا","https://www.aldiwan.net/poem32385.html","الرمل"],[369,"قربا لي يا صاحبي بعيدا","https://www.aldiwan.net/poem60938.html","الخفيف"],[376,"كل ذا مطل ويأس","https://www.aldiwan.net/poem57509.html","مجزوء الرمل"],[385,"أيد الله أسعد الوزراء","https://www.aldiwan.net/poem48764.html","الخفيف"],[396,"أسأل الرحمن لا تسأل سواه","https://www.aldiwan.net/poem54436.html","عموديه"],[415,"كل يوم فتح مبين ونصر","https://www.aldiwan.net/poem32222.html","الخفيف"],[416,"لام في أم مالك عاذلاكا","https://www.aldiwan.net/poem67486.html","الخفيف"],[449,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[463,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[463,"ياابنة القوم تراك","https://www.aldiwan.net/poem56083.html","مجزوء الرمل"],[469,"صعدة القد وسيف الكحل","https://www.aldiwan.net/poem3530.html","عموديه"],[519,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[563,"أنت قيد الوجود إن غبت غابا","https://www.aldiwan.net/poem34952.html","الخفيف"],[563,"بين أهل الجحود والتكذيب","https://www.aldiwan.net/poem34966.html","الخفيف"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107251","الرمل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122530","الخفيف"],[793,"","https://poetry.dctabudhabi.ae/diwan/poem/203824","السريع"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62500","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62460","الرمل"],[1185,"","https://poetry.dctabudhabi.ae/diwan/poem/75730","الرمل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56662","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109206","الخفيف"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/19990","الرمل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/114001","الخفيف"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87867","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108972","الرمل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124736","الرمل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124718","الرمل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118347","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53110","المديد"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109415","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77200","الخفيف"],[2338,"","https://poetry.dctabudhabi.ae/diwan/poem/111149","الخفيف"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106893","الخفيف"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60872","الخفيف"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87333","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87321","الرجز"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75907","الرمل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130862",""],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113849","المديد"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103522","المديد"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133949","الرمل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132607","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74065","المتدارك"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74050","الخفيف"],[3483,"","https://poetry.dctabudhabi.ae/diwan/poem/111137","الرمل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62868","الخفيف"],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104826","الرمل"],[3625,"","https://poetry.dctabudhabi.ae/diwan/poem/204080","الخفيف"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199150","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205920","الرمل"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/132069","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114090","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107494","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81273","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73197","المديد"],[4572,"","https://poetry.dctabudhabi.ae/diwan/poem/22798","الرمل"],[4679,"ما درت مثل عيدك الأعيادُ","https://www.poetsgate.com/ViewPoem.aspx?id=142749",""],[4691,"قل: لسامي أخرستَ صوت َ الخصامِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=59591",""],[4717,"فرجعناك إلى أمك كي (...)","https://www.poetsgate.com/ViewPoem.aspx?id=199882",""],[4578,"بالصفا نحو كؤوس الأنس ساق","https://www.poetsgate.com/ViewPoem.aspx?id=49492",""],[4858,"أيّ نارٍ تصطليها كبدي ؟","https://www.poetsgate.com/ViewPoem.aspx?id=138293",""],[4859,"غرّكِ الحسنُ","https://www.poetsgate.com/ViewPoem.aspx?id=190556",""],[4929,"تعظيم في الذَّاتِ الإلهبَّة","https://www.poetsgate.com/ViewPoem.aspx?id=199260",""],[5010,"أقبلت خير الملاح","https://www.poetsgate.com/ViewPoem.aspx?id=189867",""],[3271,"ثورة الإسلام في بدر","https://www.poetsgate.com/ViewPoem.aspx?id=103535",""],[5092,"هذا ليلي","https://www.poetsgate.com/ViewPoem.aspx?id=180064",""],[5111,"الكهف والرقيم","https://www.poetsgate.com/ViewPoem.aspx?id=212067",""],[5187,"ضحايا بين الألم","https://www.poetsgate.com/ViewPoem.aspx?id=29258",""],[5264,"نور عيونو","https://www.poetsgate.com/ViewPoem.aspx?id=176197",""],[5573,"كل ذكرى في حياتك هي حياتك","https://www.poetsgate.com/ViewPoem.aspx?id=204558",""],[5652,"دُرتي","https://www.poetsgate.com/ViewPoem.aspx?id=192118",""],[5689,"هات لي الكأس عزيز القلب هات","https://www.poetsgate.com/ViewPoem.aspx?id=143411",""],[5720,"عَهدُ سَلمانَ","https://www.poetsgate.com/ViewPoem.aspx?id=201141",""],[5764,"قويٌ لا رحيم","https://www.poetsgate.com/ViewPoem.aspx?id=175604",""],[5776,"الحكيمُ الرابع","https://www.poetsgate.com/ViewPoem.aspx?id=199327",""],[402,"هذه الشمس آذنت بالسفور","https://www.poetsgate.com/ViewPoem.aspx?id=35737",""],[5956,"صحوةُ غرام","https://www.poetsgate.com/ViewPoem.aspx?id=185064",""],[6344,"رجع من شفة الصّمت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87978&r=&rc=18",""]],"verses":[["كَلَذعَةِ الميسَمِ في","شُواظِ نارٍ وَضَرَم",0,"م",1,0],["كُلُّ ذي أُبنَةٍ لَهُ واحِدٌ يَع","لوهُ في حالِ نَيلِهِ إِيّاهُ",1,"ا",2,1],["كُلُّ ذخْرٍ لمَعاشٍ عنده","مُقْتَنىً من فضل زادٍ لمعادِ",2,"د",1,0],["كلُّ ذنوب الزمان مغتفرٌ","وذنبه فيك غير مغتفَرِ",3,"ر",1,0],["كُلُّ ذي رَغبَةٍ دَنَت أَو تَسامَت","سَوفَ يَمضي يَوماً بِلا رَغَباتِه",4,"ت",2,0],["كُلُّ ذَنبٍ كَرامَةً","لِمُحَيّاكَ مُغتَفَر",5,"ر",1,0],["كُلُّ ذي سِقطَينِ في الجَوِّ سَما","واقِعٌ يَوماً وَإِن لَم يُغرَسِ",6,"س",1,0],["كُلُّ ذِمرٍ يَزيدُ في المَوتِ حُسناً","كَبُدورٍ تَمامُها في المُحاقِ",7,"ق",1,0],["كُلُّ ذَوبٍ مِن فارِسٍ مِن عَطاءٍ","فَهُوَ في تُستَرٍ وَجُبّى جُمودُ",8,"د",1,0],["كلّ ذا يدعو إلى مشمولةٍ","فذرِ اللوم عليها أو فَلُمْ",9,"م",1,0],["كُلُّ ذِمرٍ رَمَى النُّفُوسَ بوِترٍ","مِن حَظاياهُ رَدَّه موتورا",10,"ر",2,0],["كُلُّ ذِكرٍ مِن بَعدِهِ نِسيانُ","وَتَغيبُ الآثارُ وَالأَعيانُ",11,"ن",1,1],["كُلُّ ذَاكَ التَّارِيخِ خَفَّ عَلَى سَا","قٍ بِذِكْرَاهُ مِنْ قَدِيمِ الدهُورِ",12,"ر",1,0],["كُلُّ ذَاتِ الْجَنَاحِ طَيْرٌ وَلَكِنْ","عَرَفَ الْجَوُّ نَسرَهُ مِن غُرَابِهْ",13,"ب",2,0],["كلُّ ذَوْبٍ في فارِسٍ من عَطاءٍ،","فهْوَ في تَسْتُرٍ وَجَبْيٍ جُمودُ",14,"د",1,0],["كل ذي نجدة تراه لدى الفعل","كريما وفى المقال اديبا",15,"ب",2,0],["كل ذي حالة سيمنى بأخرى","ويلاقي بعد الزمانِ زمانا",16,"ن",2,0],["كل ذي سكر تبدت مذاقا","ما عدا ريق ثغرها ولماها",17,"ا",3,0],["كل ذا والحمار يأنس بالكلب","ولم يبد منه أي نفار",18,"ر",1,0],["كُلُّ ذِمرٍ كَالظَبيِ يَسفِرُ في الكَر","رَةِ عَن ذِئبِ رَدهَةٍ مَذعورِ",19,"ر",1,0],["كل ذنب أسلفتنا قبله","صورته فيه من أعذارها",20,"ر",3,0],["كُلُّ ذي حُسنٍ إِذا قيسَ بِهِ","كانَ لَفظاً وَهوَ تَحتَ اللَّفظِ مَعنى",21,"ن",2,0],["كلُّ ذِمْرٍ يُطاوِلُ الرُّمحَ باعاً","فهْو ما إنْ يَصِيدُ إلاّ الصِّيدا",22,"د",2,0],["كل ذا مطلٌ ويأسٌ","أم رجاءٌ ونجاح",23,"ح",1,1],["كُل ذَنب مِن الزَمان صَفَحنا","عَنهُ إِلّا تَحكم الغَوغاءِ",24,"ا",2,0],["كل ذي خير فمن فضله أتاه","واستعن بالله لا تطلب عداه",25,"ه",1,0],["كُلُّ ذخرِ الملوكِ يفنَى وذُخرا","كَ هما الباقيان أجرٌ وشكرُ",26,"ر",1,0],["كُلُّ ذي طاعَةٍ مِنَ الناسِ يَرجو","كَ كَما كُلُّ مُجرِمٍ يَخشاكا",27,"ك",2,0],["كل ذي روح غدا مثل الحصيد","وتساوى الكل في شرع الممات",28,"ت",1,0],["كلّ ذي شدقين رَحبين معي","وفؤاد ضيّق المسرى دغِلْ",29,"ل",1,0],["كلّ ذاكي الحقدِ أو يخ","ضِب أعرافَ المَذاكي",30,"ك",2,0],["كلُّ ذي قلبٍ جبانٍ طرفه","راشقٌ يفتك فتكَ البطل",31,"ل",1,0],["كلُّ ذي قلبٍ مَشوقٍ لم يزلْ","للمطايا زَجْرُهُ أوْهاً وآها",32,"ا",3,0],["كل ذا باعتبار نفسك أَمَّا","هو في ذاته فجلَّ مهابا",33,"ب",2,0],["كل ذا من كثافة الطبع فيهم","وقصور العقل الخبيث السليب",34,"ب",1,0],["كلُّ ذِي شَوقٍ عَلَيهِ","مِن جميعِ الناسِ نَاهِ",35,"ه",1,0],["كلُّ ذمرٍ تفرى براحتهِ السي","فُ وتُروَى به الرِّماحُ الظماءُ",36,"ا",2,0],["كل ذوي الرأي أهل النهى","للفضل في تدبيره حامد",37,"د",1,0],["كل ذي الأهوال لم تد","خل عليهن بخاطرْ",38,"ر",1,0],["كلُّ ذي سحرٍ بيانُ لفظِه","يأخذ الفهم ويجتاح الخَلَدْ",39,"د",1,0],["كل ذا في رضاك عِندي قَليل","ساعة منه تَستَهين صعابه",40,"ب",2,0],["كل ذي لوعة يريد مثيلاً","وأنا في الهوى أريد مثيلاً",41,"ل",2,0],["كل ذنبٍ يبدو إذا عظم الود","قليلاً وإن يقلَّ جزيلا",42,"ل",2,0],["كُلُّ ذي مَجدٍ طَوِيلٍ","عِندَ مَسعاكَ قَصيرُ",43,"ر",1,0],["كلذُ حنّانَةٍ دلوحٍ سحوحٍ","مَدَّها هيدبٌ أجشُّ يمانِ",44,"ن",1,0],["كَلٌّ ذليلٌ يرى الأَهوال هاجمةً","يحتار لا يهتدى الأَوهامُ قبلتُهُ",45,"ه",1,0],["كل ذلٍّ هزني من مونسي","لذَّ لي لا رُدَّ ذلٌّ من رُشيّ",46,"ي",1,0],["كل ذات تنبيك عنها بشأن","والمراعي بخلقها أنباها",47,"ا",3,0],["كل ذات لما أراد ابتداها","ولإنقاذ ما يريد انتهاها",47,"ا",3,0],["كل ذا ما لم يرد تطليقها","جللٌ ما قال منه وسعا",48,"ع",2,0],["كل ذا معناه مختص ولم","يعمم اللفظَ جميعاً ما ذكر",49,"ر",1,0],["كل ذي جدة بها سوف يبلى","وهلال بدي بها يستسر",50,"ر",1,0],["كل ذي بغضاء يمزج لي","شهده بالمرِّ من صَبِرِه",51,"ر",2,0],["كل ذي مال إذا لم ينتفع","بعطاياه يشين الوطنا",52,"ن",2,0],["كُلُّ ذاكَ الغِنى الَّذي بَعثَروهُ","لُؤلُؤٌ مِن جِباهِنا مَنثورُ",53,"ر",1,0],["كل ذي همة تزيل الرواسي","واخي عزمة تذل الاسودا",54,"د",2,0],["كل ذنبي يا هند كثرة عشقي","لك والعاشقون غير الجناة",55,"ه",1,0],["كلذ يومٍ أوده غيرَ يومٍ","فيه يدعو ببين عزَّة داعي",56,"ع",2,0],["كلُّ ذراعٍ مِنهُمَا نَجمَانِ","وَالحُكمُ في ذلِكَ لليَمَاني",57,"ي",1,0],["كلَّ ذِراعٍ فيه ثُلثَي إصبَعِ","وآضرِب دُرُورَك في الحَوز وارجعِ",58,"ع",1,0],["كُلُّ ذي حُسنٍ تَرى أَمثالَهُ","غَير مَ