{"poems":[[53,"ألمع برق أم ضرم","https://www.aldiwan.net/poem29820.html","مجزوء الرجز"],[71,"كل ذي أبنة له واحد يعلوه","https://www.aldiwan.net/poem3820.html","الخفيف"],[51,"ما على الأحرار من رق إذا","https://www.aldiwan.net/poem61880.html","الرمل"],[51,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[91,"كل ميت مهما علا في حياته","https://www.aldiwan.net/poem8780.html","عموديه"],[70,"غبت عني فما الخبر","https://www.aldiwan.net/poem42903.html","مجزوء الخفيف"],[85,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[43,"أتراها لكثرة العشاق","https://www.aldiwan.net/poem9745.html","الخفيف"],[45,"نفست قربها علينا كنود","https://www.aldiwan.net/poem62739.html","الخفيف"],[80,"خلعت على بنيات الكروم","https://www.aldiwan.net/poem31295.html","الوافر"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[46,"كل ذكر من بعده نسيان","https://www.aldiwan.net/poem23463.html","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54935","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54214","الخفيف"],[45,"نَفّسَتْ قُرْبَها عَلَيناَ كَنُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=32955",""],[88,"طرب الشعر أن يكون نسيبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19532&r=&rc=35",""],[200,"ما لأيام ذا الصبا تتفانى","https://www.aldiwan.net/poem45673.html","الخفيف"],[211,"لا وعهد الصبا وعيش هواها","https://www.aldiwan.net/poem13367.html","الخفيف"],[222,"من طريف الآثار والأخبار","https://www.aldiwan.net/poem55284.html","الخفيف"],[236,"من عذيري فيه وهل من عذير","https://www.aldiwan.net/poem32017.html","الخفيف"],[262,"حلب الشهباء في الارض علت","https://www.aldiwan.net/poem38128.html","الرمل"],[283,"لست أسلو الشادن الأحوى الأغنا","https://www.aldiwan.net/poem32385.html","الرمل"],[365,"قربا لي يا صاحبي بعيدا","https://www.aldiwan.net/poem60938.html","الخفيف"],[372,"كل ذا مطل ويأس","https://www.aldiwan.net/poem57509.html","مجزوء الرمل"],[381,"أيد الله أسعد الوزراء","https://www.aldiwan.net/poem48764.html","الخفيف"],[392,"أسأل الرحمن لا تسأل سواه","https://www.aldiwan.net/poem54436.html","عموديه"],[410,"كل يوم فتح مبين ونصر","https://www.aldiwan.net/poem32222.html","الخفيف"],[411,"لام في أم مالك عاذلاكا","https://www.aldiwan.net/poem67486.html","الخفيف"],[444,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[459,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[459,"ياابنة القوم تراك","https://www.aldiwan.net/poem56083.html","مجزوء الرمل"],[465,"صعدة القد وسيف الكحل","https://www.aldiwan.net/poem3530.html","عموديه"],[515,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[559,"أنت قيد الوجود إن غبت غابا","https://www.aldiwan.net/poem34952.html","الخفيف"],[559,"بين أهل الجحود والتكذيب","https://www.aldiwan.net/poem34966.html","الخفيف"]],"verses":[["كَلَذعَةِ الميسَمِ في","شُواظِ نارٍ وَضَرَم",0,"م",1,0],["كُلُّ ذي أُبنَةٍ لَهُ واحِدٌ يَع","لوهُ في حالِ نَيلِهِ إِيّاهُ",1,"ا",2,1],["كُلُّ ذخْرٍ لمَعاشٍ عنده","مُقْتَنىً من فضل زادٍ لمعادِ",2,"د",1,0],["كلُّ ذنوب الزمان مغتفرٌ","وذنبه فيك غير مغتفَرِ",3,"ر",1,0],["كُلُّ ذي رَغبَةٍ دَنَت أَو تَسامَت","سَوفَ يَمضي يَوماً بِلا رَغَباتِه",4,"ت",2,0],["كُلُّ ذَنبٍ كَرامَةً","لِمُحَيّاكَ مُغتَفَر",5,"ر",1,0],["كُلُّ ذي سِقطَينِ في الجَوِّ سَما","واقِعٌ يَوماً وَإِن لَم يُغرَسِ",6,"س",1,0],["كُلُّ ذِمرٍ يَزيدُ في المَوتِ حُسناً","كَبُدورٍ تَمامُها في المُحاقِ",7,"ق",1,0],["كُلُّ ذَوبٍ مِن فارِسٍ مِن عَطاءٍ","فَهُوَ في تُستَرٍ وَجُبّى جُمودُ",8,"د",1,0],["كلّ ذا يدعو إلى مشمولةٍ","فذرِ اللوم عليها أو فَلُمْ",9,"م",1,0],["كُلُّ ذِمرٍ رَمَى النُّفُوسَ بوِترٍ","مِن حَظاياهُ رَدَّه موتورا",10,"ر",2,0],["كُلُّ ذِكرٍ مِن بَعدِهِ نِسيانُ","وَتَغيبُ الآثارُ وَالأَعيانُ",11,"ن",1,1],["كُلُّ ذَاكَ التَّارِيخِ خَفَّ عَلَى سَا","قٍ بِذِكْرَاهُ مِنْ قَدِيمِ الدهُورِ",12,"ر",1,0],["كُلُّ ذَاتِ الْجَنَاحِ طَيْرٌ وَلَكِنْ","عَرَفَ الْجَوُّ نَسرَهُ مِن غُرَابِهْ",13,"ب",2,0],["كلُّ ذَوْبٍ في فارِسٍ من عَطاءٍ،","فهْوَ في تَسْتُرٍ وَجَبْيٍ جُمودُ",14,"د",1,0],["كل ذي نجدة تراه لدى الفعل","كريما وفى المقال اديبا",15,"ب",2,0],["كل ذي حالة سيمنى بأخرى","ويلاقي بعد الزمانِ زمانا",16,"ن",2,0],["كل ذي سكر تبدت مذاقا","ما عدا ريق ثغرها ولماها",17,"ا",3,0],["كل ذا والحمار يأنس بالكلب","ولم يبد منه أي نفار",18,"ر",1,0],["كُلُّ ذِمرٍ كَالظَبيِ يَسفِرُ في الكَر","رَةِ عَن ذِئبِ رَدهَةٍ مَذعورِ",19,"ر",1,0],["كل ذنب أسلفتنا قبله","صورته فيه من أعذارها",20,"ر",3,0],["كُلُّ ذي حُسنٍ إِذا قيسَ بِهِ","كانَ لَفظاً وَهوَ تَحتَ اللَّفظِ مَعنى",21,"ن",2,0],["كلُّ ذِمْرٍ يُطاوِلُ الرُّمحَ باعاً","فهْو ما إنْ يَصِيدُ إلاّ الصِّيدا",22,"د",2,0],["كل ذا مطلٌ ويأسٌ","أم رجاءٌ ونجاح",23,"ح",1,1],["كُل ذَنب مِن الزَمان صَفَحنا","عَنهُ إِلّا تَحكم الغَوغاءِ",24,"ا",2,0],["كل ذي خير فمن فضله أتاه","واستعن بالله لا تطلب عداه",25,"ه",1,0],["كُلُّ ذخرِ الملوكِ يفنَى وذُخرا","كَ هما الباقيان أجرٌ وشكرُ",26,"ر",1,0],["كُلُّ ذي طاعَةٍ مِنَ الناسِ يَرجو","كَ كَما كُلُّ مُجرِمٍ يَخشاكا",27,"ك",2,0],["كل ذي روح غدا مثل الحصيد","وتساوى الكل في شرع الممات",28,"ت",1,0],["كلّ ذي شدقين رَحبين معي","وفؤاد ضيّق المسرى دغِلْ",29,"ل",1,0],["كلّ ذاكي الحقدِ أو يخ","ضِب أعرافَ المَذاكي",30,"ك",2,0],["كلُّ ذي قلبٍ جبانٍ طرفه","راشقٌ يفتك فتكَ البطل",31,"ل",1,0],["كلُّ ذي قلبٍ مَشوقٍ لم يزلْ","للمطايا زَجْرُهُ أوْهاً وآها",32,"ا",3,0],["كل ذا باعتبار نفسك أَمَّا","هو في ذاته فجلَّ مهابا",33,"ب",2,0],["كل ذا من كثافة الطبع فيهم","وقصور العقل الخبيث السليب",34,"ب",1,0]]}