{"poems":[[95,"ألطائر العالي مراده","https://www.aldiwan.net/poem11144.html","السريع"],[87,"يا رب أمرك في الممالك نافذ","https://www.aldiwan.net/poem63758.html","الكامل"],[51,"أحمد الله على كل حال","https://www.aldiwan.net/poem63085.html","المديد"],[46,"ما لكثيب الحمى إلى عقده","https://www.aldiwan.net/poem30552.html","المنسرح"],[50,"يا معشر اللوام","https://www.aldiwan.net/poem66546.html","المجتث"],[92,"قتل العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179140",""],[240,"وخيال سرى إلي فأدنا","https://www.aldiwan.net/poem31738.html","الخفيف"],[556,"شعر ناصع ووجه كئيب","https://www.aldiwan.net/poem48094.html","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120001","الكامل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203787","السريع"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64951","البسيط"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/74008","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132726","الكامل"],[4083,"","https://poetry.dctabudhabi.ae/diwan/poem/147650","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73127","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73095","الكامل"],[4470,"","https://poetry.dctabudhabi.ae/diwan/poem/125354","الرمل"],[4757,"يَا مضيعاً للْعهد والود غدراً","https://www.poetsgate.com/ViewPoem.aspx?id=189300",""],[4830,"قولوا لهُ","https://www.poetsgate.com/ViewPoem.aspx?id=211228",""],[5064,"محاولات تيه متشرّد","https://www.poetsgate.com/ViewPoem.aspx?id=199152",""],[3591,"على صدور الخرد الحسانِ","https://www.poetsgate.com/ViewPoem.aspx?id=149415",""],[5122,"أول كلامي","https://www.poetsgate.com/ViewPoem.aspx?id=24265",""],[5122,"(( يامضيع العشاق..1))","https://www.poetsgate.com/ViewPoem.aspx?id=27095",""],[5219,"إلى أرض الإسراء","https://www.poetsgate.com/ViewPoem.aspx?id=194255",""],[5431,"طفلي وأعشقه في اليم ألقيه","https://www.poetsgate.com/ViewPoem.aspx?id=189834",""],[5431,"لامنتهى بدمي الاك مبتدأ ...","https://www.poetsgate.com/ViewPoem.aspx?id=197789",""],[5747,"شح العطا","https://www.poetsgate.com/ViewPoem.aspx?id=61681",""],[5956,"كم أبتغي إضحاككم","https://www.poetsgate.com/ViewPoem.aspx?id=192423",""],[6038,"بيعة الخسراني","https://www.poetsgate.com/ViewPoem.aspx?id=26802",""],[2575,"ليتني ماشفت","https://www.poetsgate.com/ViewPoem.aspx?id=24772",""]],"verses":[["يا مضجعا للتوأمين","طوى جمالهما جماده",0,"د",2,0],["يا مَضرِبَ الخِيَمِ المُنيفَةِ لِلقِرى","ما أَنصَفَ العُجمُ الأُلى ضَرَبوكِ",1,"ك",1,0],["يا مُضيعَ الجِدِّ بِالهَزلِ مِنهُ","مَن يُبالي مِنكَ ما لا تُبالي",2,"ل",2,0],["يا مُضغِناً خالِداً لَكَ الثُكلُ إِن","خَلَّدَ حِقداً عَلَيكَ في خَلَدِه",3,"د",2,0],["يا مضن يقول الغواني","أحلى جنيٌ والتزاما",4,"م",2,0],["يا مُضغْةً بين جنبيَّ ابتُليِتُ بها","لا كنتِ من هدفٍ للشرِّ منصوب",5,"ب",1,0],["يا مُضِلَّ السَماحِ يَهوي بِهِ وَج","ناءُ حَرفٌ مِثلُ الهِلالِ أَمونُ",6,"ن",1,0],["يا مُضيئاً في العينِ تَسوَدُّ منهُ","كلَّ يومٍ جوانحٌ وقلوبُ",7,"ب",1,0],["يا مضحك الأيام وهي عوابس","ومقرب الآمال وهي نوازحُ",8,"ح",1,0],["يا مضرم النيران زدها لظى","واضربْ، فبئس الضربة المشفقةْ",9,"ق",2,0],["يا مُضرِماً في حَشايَ ناراً","مِنْ عَبْرةٍ لا تَزالُ تَهمِي",10,"م",2,0],["يا مضيعاً زمانه بالأماني","قم بحق الربيع حق القيامِ",11,"م",1,0],["يا مضجع التقوى ويا جدث التقى","بكرت عليك تحية وسلام",12,"م",1,0],["يا مضيع العهود والله يعفو","عنك أنَّى ارتضيت خطة ناكث",13,"ث",1,0],["يا مُضرماً نارَ الأسى بجَفاهُ في","كَبدي لِوجدي لا تبيتُ مُكابدا",14,"د",2,0],["يا مُضرماً في مهجتي بصُدودهِ","حُرقاً يكادُ لهنَّ يذبلُ يذبلُ",15,"ل",1,0],["يا مضطربا تعال وافلح","في مسكننا ونعم مسكن",16,"ن",1,0],["يَا مضيعاً للْعهد والود غدراً","ومريداً بِجهْدِهِ التفريقا",17,"ق",2,1],["يامُضمِرَ الخصرينِ حسبُكَ لوعتي","وزفيرُ أحشائي بحُرقتِها نَطَقْ",18,"ق",1,0],["يَا مُضِيَّ الأقْدَارِ فِي بَحْرِ عَيْن","ها وَرِيحَ الحَنِينِ تَاهَ السَّفِينُ",19,"ن",1,0],["يا مضجعاً في الحسن والليان","منزهاً عن شبه الأقران",20,"ن",1,0],["يامضحي الدنيا على كف عفريت","تنجب أمورا يابن نامي مثيره",21,"ر",2,0],["يامضيع العشاق في غب الإبحار","لايخدعك موج البحر توك أصغير",22,"ر",1,1],["يا مضعة السوء يا نسل الوضاعة يا","صهيون فاصبر وكان الله منتقما",23,"م",2,0],["يامضغة بدمي والحب منبتها","لا لم يطله أذى...فالقلب يفديه",24,"ي",2,0],["يامضغة النور إني منك مهترئُ","شلالُ سحرك عني ليس ينكفئُ",25,"ا",1,1],["يامضميه شح العطا منك وشلون","اصبر وانا اللي منك بالحيل ضامي!!",26,"م",2,1],["يا مضحكَ الناس الكرام بطيبتكْ","إني أتوقُ أيا صديق لغضبتكْ",27,"ك",1,1],["يا مضيعين الوقت ترى العمر فاني","ولى زمان اخلاص يبقى للمشيبي",28,"ب",2,0],["يامضوي في دجى عمري شموع","الحزن ماخلق لعيون الملاك",29,"ك",1,0]]}