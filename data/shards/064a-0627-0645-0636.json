{"poems":[[93,"ألطائر العالي مراده","https://www.aldiwan.net/poem11144.html","السريع"],[85,"يا رب أمرك في الممالك نافذ","https://www.aldiwan.net/poem63758.html","الكامل"],[49,"أحمد الله على كل حال","https://www.aldiwan.net/poem63085.html","المديد"],[44,"ما لكثيب الحمى إلى عقده","https://www.aldiwan.net/poem30552.html","المنسرح"],[48,"يا معشر اللوام","https://www.aldiwan.net/poem66546.html","المجتث"],[90,"قتل العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179140",""],[233,"وخيال سرى إلي فأدنا","https://www.aldiwan.net/poem31738.html","الخفيف"],[549,"شعر ناصع ووجه كئيب","https://www.aldiwan.net/poem48094.html","الخفيف"]],"verses":[["يا مضجعا للتوأمين","طوى جمالهما جماده",0,"د",2,0],["يا مَضرِبَ الخِيَمِ المُنيفَةِ لِلقِرى","ما أَنصَفَ العُجمُ الأُلى ضَرَبوكِ",1,"ك",1,0],["يا مُضيعَ الجِدِّ بِالهَزلِ مِنهُ","مَن يُبالي مِنكَ ما لا تُبالي",2,"ي",1,0],["يا مُضغِناً خالِداً لَكَ الثُكلُ إِن","خَلَّدَ حِقداً عَلَيكَ في خَلَدِه",3,"د",2,0],["يا مضن يقول الغواني","أحلى جنيٌ والتزاما",4,"م",2,0],["يا مُضغْةً بين جنبيَّ ابتُليِتُ بها","لا كنتِ من هدفٍ للشرِّ منصوب",5,"ب",1,0],["يا مُضِلَّ السَماحِ يَهوي بِهِ وَج","ناءُ حَرفٌ مِثلُ الهِلالِ أَمونُ",6,"ن",1,0],["يا مُضيئاً في العينِ تَسوَدُّ منهُ","كلَّ يومٍ جوانحٌ وقلوبُ",7,"ب",1,0]]}