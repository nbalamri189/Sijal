{"poems":[[87,"إلام الخلف بينكم إلاما","https://www.aldiwan.net/poem63744.html","الخفيف"],[45,"ما للمروج الخضر والحدائق","https://www.aldiwan.net/poem9743.html","الرجز"],[82,"أبا هاشم هشمتني الشفار","https://www.aldiwan.net/poem31300.html","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39593","البسيط"],[79,"حديثٌ على رغم العلا غيرُ كاذبِ","https://www.poetsgate.com/ViewPoem.aspx?id=33316",""],[137,"لواؤك منصور وسعدك غالب","https://www.aldiwan.net/poem4251.html","الطويل"],[463,"أروض الوادي أم ابيض الغسق","https://www.aldiwan.net/poem56090.html","الرجز"],[487,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[549,"تاجان زاناك","https://www.aldiwan.net/poem67256.html","عموديه"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35381","السريع"],[1501,"","https://poetry.dctabudhabi.ae/diwan/poem/146657","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53139","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200481","المجتث"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204481","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114050","الخفيف"],[4929,"نص حروفه بغير نقط (بحر الخفيف)","https://www.poetsgate.com/ViewPoem.aspx?id=208724",""],[5516,"عبق الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=214141",""],[5690,"لواؤك سيدي عبد الحميد","https://www.poetsgate.com/ViewPoem.aspx?id=172136",""],[6234,"الربيع الفاتن في نجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6538&r=&rc=5",""]],"verses":[["لِواؤُكَ كانَ يَسقيهِم بِجامٍ","وَكانَ الشِعرُ بَينَ يَدَيَّ جاما",0,"م",2,0],["لَو أَورِدَت غِبَّ سَحابٍ صادِقِ","لَأَحسَبَت خَوامِسَ الأَيانِقِ",1,"ق",1,0],["لواؤك نادى للقِرى من لحومهم","خوامعْ من آفاقها وَقَشاعِماً",2,"م",2,0],["لواؤُك الضخمُ ما زالتْ مواكبهُ","تترَى وراياتُه حمراءَ كالشُّعَلِ",3,"ل",1,0],["لِواؤُكَ منصورٌ وحِزْبُكَ ظافِر","ٌ وملْكُك محْفوظٌ وسيْفُكَ غالِبُ",4,"ب",1,0],["لواؤكَ منصورٌ وسعدُكَ غالبُ","وحزبكَ للأعداءِ عنكَ مُحارِبُ",5,"ب",1,1],["لواؤك المرفوعُ من أمامها","لم ينخفض ولا هوى منذ بسَقْ",6,"ق",1,0],["لواؤنا خفاق على كل من دنا","حظيرة قدس الفيض من وشي حلتي",7,"ي",1,0],["لو أوتيَ النخلُ أن يستلَّ قامتَهُ","سيفًا، لأصبحَ من أنصاركَ، الشجرُ",8,"ر",1,0],["لِواؤُكَ المَنصورُ مَهما سَما","يَلقاكَ وَجهُ الفَتحِ وَهوَ طَليق",9,"ق",1,0],["لواؤك في علاك لوى الأعادي","حشاها من حواشيه المطاره",10,"ر",2,0],["لواؤك مرفوع وسيفك جازم","وبعض رقاب الناس فعل مضارع",11,"ع",1,0],["لو أوكل الله يوماً","إليّ خلق الأُناس",12,"س",1,1],["لو أوكل الله تنظيم الوجود لنا","إذن منحناه بالتعمير تدميرا",13,"ر",2,0],["لُوا وَهَضمُ البُدُورِ لاَ يَتَأتَّى","ثُمَّ عَادَت جُمُوعُهُم عَنهُ شَتَّى",14,"ت",2,0],["لو أولُو أمرِكم إلى الله رَدُّوا","أمرَهُم ما طاحُوا ولا الأمرُ طاحَا",15,"ح",2,0],["لو أوثقوكِ سلاسلا تدمي ولو","أعلوا الجدار على شفا الطرقات ِ",16,"ت",1,0],["لواؤك سيدي عبد الحميد","يبشرنا بنصر للجنود",17,"د",1,1],["لو أوتي الطير إفصاحا ومعرفة","لراح ينظم فيها الشعر تشبيبا",18,"ب",2,0]]}