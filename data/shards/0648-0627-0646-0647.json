ل لا جفّ مورده","للشاربين عليه الناس تزدحم",138,"م",1,0],["وإنهم ليحسدو","ن كل من قد سعدا",139,"د",2,0],["وإنهم لينكرو","ن الحق حَتّى إن بدا",139,"د",2,0],["وأَنَّه هو حتى","على الهواء أَميرُ",140,"ر",1,0],["وإنها حين تجري","بطيئة وَسَريعه",141,"ع",2,0],["وإنها هي للمفجوع تعزية","وإنها هي للمحزون سلوان",142,"ن",1,0],["وإنها الروض مطلولاً له أرج","وإنها لجنى الأثمار بستان",142,"ن",1,0],["وإنها تارة نار قد اتقدت","وإنها تارة روح وريحان",142,"ن",1,0],["وأنهن كَحَيوا","ن ليس يهديه عقل",143,"ل",1,0],["وأنهن متاع","لهم من النفس يخلو",143,"ل",2,0],["وأنهن ملذا","ت تشتهى وتمل",143,"ل",1,0],["وأنهن ظروف","يراد منهن نسل",143,"ل",1,0],["وإنهن نجوم","عَلى السلام تدل",143,"ل",1,0],["وإنهن ابتساما","تٌ للكآبة تجلو",143,"ل",2,0],["وإنهن من اللَ","هِ للسعادة حقل",143,"ل",1,0],["وإنهن غصون","بفيئها يستظل",143,"ل",1,0],["وإنها ذات عقل","كَما له هو عقل",143,"ل",1,0],["وإنها عنه في الفه","مِ والحجى لا تقل",143,"ل",1,0],["وإنها لتذيع ال","سلام حيث تحل",143,"ل",1,0],["وإنها هي عما","يرمونها لتجل",143,"ل",1,0],["وإنها إن أَرادَت","بنفسها تستقل",143,"ل",1,0],["وإنها من علوّ","على الرجال تطل",143,"ل",1,0],["وأنه في شتات الأمر يجمعه","الشعب يفقه أن الشعر فيه هدى",144,"د",2,0],["وأنه سبب للمجد مقتدر","الشعر للروح مثل القوت للبدن",144,"ن",1,0],["وإنه زينة الأقوام والمدن","والدافع الأكبر النهّاض بالوطن",144,"ن",1,0],["وإنْ هوى للأرضِ منهمْ جريحْ","أنهضهُ في قيدهِ يَرْسُفُ",145,"ف",1,0],["وانهلا من سَلْسَلِ النُّورِ المذابْ","خمرةً ليس لها من عاصرِ",146,"ر",1,0],["وأنها في ظلال السِّلم نائمةٌ","وأنها جنَّةٌ للحبِّ غنَّاءُ",147,"ا",2,0],["وإن هيَ حورِبَتْ عنه وذيدَتْ","تحدَّثَ باسمِهِ فَرْدٌ وحِزْبُ",148,"ب",1,0],["وإِنْ هَشَمَتْ حقِّي أُميّةُ عِنْدها","فَهاتا عَلى ظَهْرِ المحجَّةِ هاشِمُ",149,"م",1,0],["وإِنَّ هُبُوطَ الوادِيَيْنِ إِلى النَّقَا","بحَيْثُ الْتَقَى الجَمْعَانِ واسْتَقْبَل السَّقْطَا",150,"ط",2,0],["وإنّه لو جازَ في الأَبياتِ","خلافُها لجازَ في اللّغاتِ",151,"ت",1,0],["وَاِنهَلوا مِن حَدِّ سَيفي جُرَعاً","مُرَّةً مِثلَ نَقيعِ الحَنظَلِ",152,"ل",1,0],["وَإِنْ هُوَ لَمْ يَصْفَحْ عَنِ