com/modules.php?name=Sh3er&doWhat=shqas&qid=19522&r=&rc=25",""],[85,"خفضتُ لعزة ِ الموتِ اليراعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9610&r=&rc=100",""]],"verses":[["وَإِن هَدَمَت مِنكَ الخُطوبُ بِمَرِّها","فَشَمَّ لِسانٌ لِلمَناقِبِ باني",0,"ي",1,0],["وَإِن هُوَ نَجّى مِن فَمِ المَوتِ مُهجَتي","نَجَوتُ وَإِلّا كُنتُ أَوَّلَ مَطعَمِ",1,"م",1,0],["وَإِنَّهُمُ لَأَعنَفُ بِالمَذاكي","مُحاضَرَةً وَأَقرَعُ بِالعَوالي",2,"ي",1,0],["وَإِن هُوَ ساوَمَني مُهجَتي","صَفَقتُ عَلى راحَتَيهِ بِياعا",3,"ع",2,0],["وَإِن هُزَّ لِلأَضغانِ عادَت بُروقُهُ","حَريقاً عَلى الأَعداءِ مُضطَرِمَ السَعرِ",4,"ر",1,0],["وَاِنهَض فَإِن لَم تَحظَ في بَلَدٍ","بِالرِزقِ فَاِقطَعهُ إِلى بَلَدِ",5,"د",1,0],["وَأَنهَلَني في القَعبِ فَضلُ غَبوقِهِ","خَليطانِ ريقٌ بارِدٌ وَضَريبُ",6,"ب",1,0],["وَاِنهَض فَما حُمِلَت عَلى","قَصفِ الفَقارِ وَلا أَجَبِّ",7,"ب",1,0],["وَإِن هُوَ لَم يُعصِمكَ مِنهُ بِجِنَّةٍ","فَقَد أُكثِبَت لِلضارِبينَ المَضارِبُ",8,"ب",1,0],["وَإِن هَبَّ عُلويُّ الرِّيِاحِ تَطَلَّعَتْ","نَوازِعُ مِن شَوقٍ عَلى الصَبِّ جامِحِ",9,"ح",1,0],["وإنْ هَدَرَتْ يومَ الفَخارِ شَقاشِقٌ","شَحا فاهُ يَستَقْري الكَلامَ المُمَضَّغا",10,"غ",2,0],["وأنها في مآقي شعره حلم","وأنها في دجاه اللهو والسمر",11,"ر",1,0],["وَاِنهَلوا مِن حَدِّ سَيفي جُرَع","مُرَّةً مِثلَ نَقيعِ الحَنظَلِ",12,"ل",1,0],["وَانهَلَّتِ العَينانِ مِن قَولِهِ","وَطارَ قَلبي كَالجَناحِ الخَفوق",13,"ق",1,0],["وَإِن هَوَيتِ فَما عِندي مُخالَفَةٌ","فَقَأتُ عَينَيَّ حَتّى لا أَرى أَحَدا",14,"د",2,0],["وَإِن هِيَ أَعطَتكَ اللَيانَ فَإِنَّها","لَآخَرَ مِن خُلّانِها سَتَلينُ",15,"ن",1,0],["وإنْ هُمُ جنَحوا للسِّلْمِ واعْتَلَقوا","منْها بمُسْتَحْكَمِ الأسْبابِ والعُلَقِ",16,"ق",1,0],["وَانْهَدْ فَنَصْرُ اللهِ فَوْقَكَ رَايَةٌ","وَمِنَ السُّعُودِ عَلَيْكَ سِتْرٌ مُسْبَلُ",17,"ل",1,0],["وَإِنْ هَطَلَتْ سُحْبُ الْبَيَانِ حَوَافِلاً","فَلَيْسَ لَهَا إَلاَّ عَلَيْكَ هُمُولُ",18,"ل",1,0],["وَانْهَضْ بِمِدْحَتِكَ التِي حَلَّيْتَهَا","بِثَنَا أَميِرِ الْمُسْلِمِينَ وَهَاتِهَا",19,"ت",3,0],["وَأَنْهَلَنِي وِرْدَ الدَّمُوعِ وَعَلَّنِي","وَمَا أَنَا عَنْ حُزْنِي عَلَيْكَ بِمُنَثنِي",20,"ي",1,0],["وَإِن هو أَعطاكَ مَجهودَهُ","فَلَيسَ بِأَعطى مِن المُكحُلَه",21,"ل",2,0],["وَإِن هِيَ ناءَت تُريدُ القِيامَ","تَهادى كَما قَد رَأَيتَ البَهيرا",22,"ر",2,0],["وَاِنهَض بِشَعبِكَ يا فُؤادُ إِلى العُلا","وَإِلى مَكانٍ في الوُجودِ بَراحِ",23,"ح",1,0],["وَاِنهَل مَعَ النُهّالِ مِن عَذبِ الحَيا","فَإِذا رَقا فَاِمتَح مَعَ المُتّاحِ",23,"ح",1,0],["وَإِن هَزَّها ذاكَ الهِلالُ لِحادِثٍ","رَأَيتَ قَضاءَ اللَهِ يَمشي وَيَركَبُ",24,"ب",1,0],["وأنّه وارِدٌ لا بدّ مَوْرِدَه","مِنَ المَنِيَّةِ لا يُعفيه ساقيها",25,"ي",3,0],["وَإِن هَبَّ فيها نَسيمُ الأَصيلِ","أَتاكَ النَسيمُ بِأَخبارِها",26,"ر",3,0],["وَاِنهَض بِشَعبِكَ في الشُعوبِ فَإِنَّما","لَكَ بَعدَ رَبِّكَ أَمرُهُ مَوكولُ",27,"ل",1,0],["وَإِن هِيَ قامَت فَما أَثلَهُ","بِعَليا تُناوِحُ ريحاً أَصيلا",28,"ل",2,0],["وَإِنْ هِيَ إِلاَّ نَوَاةٌ لِمَا","تُهَيِّئُهُ نِيَّةُ المُحْسِنِينْ",29,"ن",1,0],["وَأَنَّهُ شممٌ خَافٍ يُعَزُّ بِهِ","عَلَى الغُزَاةِ وَمَا يُبْدُونَ مِنْ شَمَمِ",30,"م",1,0],["وَإِنَّ هَوى صَيداءَفي ذَاتِ نَفسِهِ","بِسائِرِ أَسبابِ الصَبابَة راجِحُ",31,"ح",1,0],["وإنْ هبَّ خفّاقُ النسيم بنفحة","حكتْ عَرْفَهُ طيباً قضى بتأنُّسِهْ",32,"س",2,0],["وإن هي قامت لانشادنا","جثونا لها وثنَينا الركب",33,"ب",1,0],["وإنه في كلا حالَيُه منبعها","يدور في الجسم أو في الأرض ينسجم",34,"م",1,0],["وإنه وهو فوق الأرض منتثِر","كمثله وهو تحت الجوف منتظم",34,"م",1,0],["وأنهضهم إلى الشرف المُعَلّى","وكانوا عنه قبلئذٍ قعودا",35,"د",2,0],["وَأَنهَلتُهُ بِالسُمِّ ثُمَّ عَلَلتُهُ","بِكَأسٍ مِنَ الذَيفانِ مُرٌّ عَصيرُها",36,"ر",3,0],["وَأَنَّهُمُ وُلاةُ الأَمرِ فينا","وَخَيرُ الناسِ عَفواً وَاِنتِقاما",37,"م",2,0],["وَإِنَّ هَوانَ الجارِ لِلجارِ مُؤلِمٌ","وَفاقِرَةٌ تَأوي إِلَيها الفَواقِرُ",38,"ر",1,0],["وإنهم لاخوتنا ولكن","أنامل راحة لا يستوينا",39,"ن",2,0],["وإن هَاجَ نَبتُ العِلمِ في النَّاسِ لم تَزَل","لَهُم تَلعَةٌ خَضرَاءُ منهم ومِذنَبُ",40,"ب",1,0],["وأنَّهُم للنَّاسِ فيما يَنُوبهُم","أكُفُّ نَدى تُجدِي عليهم وَتُفضِل",41,"ل",1,0],["وإنَّهم للنَّاسِ فيما يَنُوبُهم","مَصَابِيحُ تَهدِى من ضَلالٍ وَمَنزِلُ",41,"ل",1,0],["وَإِنَّهُ لَمَعَ الخَلقِ الَّذينَ لَهُم","في الميمِ وَالعينِ وَالتَقديسِ مَعناهُ",42,"ه",1,0],["وأنهما ليسا كشيءٍ مُصَرَّفٍ","يُصرِّفُهُ ذو نكبةٍ حين يُنكبُ",43,"ب",1,0],["وإنْ هو منَّاها الأباطيل لم تزل","تُقاتل بالعَتْبِ القضاءَ وتُغلَبُ",43,"ب",1,0],["وأنَّهمُ حرسوا نفسَهُ","بِهِ من غوائلِ مرهوبِهِ",44,"ب",2,0],["وأنها قد حَمَّلَتْ رأسَهُ","مثلَ قرونِ الأيِّلِ الأَشْعبِ",45,"ب",1,0],["وانْهَ مَنْ يُحْصى حَصاه إنه","ضعْفُ ما ضمَّ من الرمل زَرودُ",46,"د",1,0],["وأنهمُ لو ملِّكوا القَطر أو وَلُوا","خزائنهُ خافوا النفاد على القطرِ",47,"ر",1,0],["وأنه لي حرب","إذا ضنِنتُ بميري",48,"ي",1,0],["وإن هذِي اليمينَ لا كَذِباً","لبعضُ أيمان عَبدِك الغُمُس",49,"س",1,0],["وإن هو ناداه سحيراً لدُلْجَةٍ","تنبَّه نبهان الفؤاد سرعرعا",50,"ع",2,0],["وإنّ هذين عندي","في الخَلْقِ منك لأمثلْ",51,"ل",1,0],["وإن هاجَه هيجٌ من العذلِ أصبحتْ","فواضلهُ مشفوعةً بفواضلِ",52,"ل",1,0],["وإنَّ همومي بعدها وعزائمي","لأيقظ من نارِ الحريق وأسهمُ",53,"م",1,0],["وَأَنَّها عَرِفَت مَكانَكَ في الثَرى","صارَت زَواهِرُها عَلَيكِ عُقودا",54,"د",2,0],["وَأَنَّهُ غَيرُ ذي رُواءِ","وَلا لَهُ صَوتُكَ الرَخيمُ",55,"م",1,0],["وَإِن هُمُ لَم يَقتُلوا الأَشقِياءَ","فَيا لَيتَ شِعرِيَ مَن يَقتُلون",56,"ن",1,0],["وَإِنَّهُ لَشَديدٌ","كَما عَلِمتَ وَإِنَّهُ",57,"ه",1,0],["وَإِن هُوَ وَلّى مُدبِراً فَفَناؤُهُ","وَشيكاً مِنَ التَثميرِ أَرجى وَأَنجَعُ",58,"ع",1,0],["وإنْ هَجَرَتْكِ بَناتُ الغيومِ","فقدْ عانَقَتْني بناتُ الجَحيمْ",59,"م",1,0],["وَإِنَّهُ لَمّا اِغتَدى خاطِري","مُسائِلاً جاوَبَ عُصفورُ",60,"ر",1,0],["وَأَنَّهُمُ بِكَ يَستَبشِرو","نَ أَلاّ تَخَافَ وَأَلّا تُضارا",61,"ر",2,0],["وانه البادئ","بالاصلاح والمتمم",62,"م",1,0],["وانها لاصطدامات بمنحدر","كما تصادم بالسيل الجلاميد",63,"د",1,0],["وانه لكاشف","الغمات فراج الكرب",64,"ب",1,0],["وانه لرحمة","للناس ان امر حزب",64,"ب",1,0],["وانهض فُديت بعهده","مئة وقم بالحكم أخرى",65,"ر",2,0],["وانهضوا نهضة الشعوب لدنيا","وحياة كبيرة الأشغال",66,"ل",1,0],["وإنه والعدل نبراسه","قد أُصلح القطر على عهده",67,"د",2,0],["وإنها الدهرَ للإسلام مملكة","تزهو ممالكها منها بعنوان",68,"ن",1,0],["وَأَنَّها سِرُّ عَبّاسٍ وَبِضعَتُهُ","فَهيَ الفَضيلَةُ مالي لا أُسَمّيها",69,"ي",3,0],["وَإِنَّهُ لَضِياءٌ","مُؤَيَّدٌ بِالبَقاءِ",70,"ا",2,0],["وَإِن هُوَ حَلَّ أَرضاً قامَ فيها","جِدارٌ لِلحَضارَةِ أَو دِعامُ",71,"م",1,0],["وَإِنَّهُ مَن يَعمَلِ ال","خَيرَ أَوِ الشَرَّ يَرَه",72,"ر",2,0],["وَإِن هُوَ جَدَّ في الماءِ اِنسِياباً","فَكُلُّ طَريقِهِ وَتَرٌ وَقَوسُ",73,"س",1,0],["وَأَنَّها جاوَزَت في القُدسِ مِنطَقَةً","جَرى البِساطُ فَلَم يَجتَز لَها حَرَما",74,"م",2,0],["وَإِن هَمَّ بِالعَفوِ الكَريمِ رَجاؤُهُم","فَمِن كَرَمِ الأَخلاقِ أَن لا يُخَيَّبوا",75,"ب",3,0],["وإِنْ هي أَعْطَتْكَ اللَّيانَ فإنّها","لغيرِكَ مِنْ خُلاَّنِها سَتَليِنُ",76,"ن",1,0],["وَإِنَّهُمُ عَبيدُكَ حَيثُ كانوا","إِذا تَدعو لِحادِثَةٍ أَجابوا",77,"ب",3,0],["وَاِنهَ المُشيرَ عَلَيكَ فيَّ بِضَلَّةٍ","فَالحَرُّ مُمتَحِنٌ بِأَولادِ الزِنا",78,"ن",2,0],["وإنّ هواءنا والنار نفس","بمنخلنا قد اكتسبت رواءَ",79,"ا",2,0],["وإن هُديتَ إلى مكنون سرهم","فأحرز لسانك لا تحمل على غررِ",80,"ر",1,0],["وإِنَّ هُماماً من أميّةَ ضامني","ليعفُو عن الجاني المسيء ويحلمُ",81,"م",1,0],["وَاِنهَض لِأَيَّةِ بَلدَةٍ حَلّوا بِها","في الأَرضِ إِن قَرُبَت وَإِن لَم تَقرُبِ",82,"ب",1,0],["وَإِن هَزَزتُكَ لِلجَدوى فَقَبلُ رَأى","هَزَّ الحُسامِ كَمِيُّ الفيلَقِ الحامي",83,"ي",1,0],["وَإِن هَبَطَت أَرطى لُهابٍ ظَعينَةٌ","تَميمِيَّةٌ حَلَّت إِذا فَزِعَ النَفرُ",84,"ر",1,0],["وَإِنَّهُمُ هُمُ الحامونَ لَمّا","تَواكَلَ مَن يَذودُ عَنِ الذِمارِ",85,"ر",1,0],["وَإِنَّ هِجاءَ الباهِلِيِّينَ دارِماً","لَإِحدى الأُمورِ المُنكَراتِ العَظائِمِ",86,"م",1,0],["وَإِنَّ هِجائي اِبنَي دُخانٍ وَأَنتُما","كَأَملَسَ مِن وَقعِ الأَسِنَّةِ سالِمِ",86,"م",1,0],["وَإِنَّ هِجائي طَيِّئً وَهيَ طَيِّئٌ","نَبيطُ القُرى إِحدى الكِبارِ العَظائِمِ",87,"م",1,0],["وانهلَّ حنَّانُ الغَمامِ المُمْطِرِ","وبرَقَتْ لُجَّةُ بَحرٍ أخضَرِ",88,"ر",1,0],["وَإِن هِلِكتُ فَإِنّي سَوفَ أورِثُهُم","ذَلَّ الحَياةِ فَقَد خانوا وَقَد غَدَروا",89,"ر",3,0],["وَأَنَّهُم عَرَفوا في الحُبِّ مَعرِفَتي","بِشَأنِكُم عَذَروا مِن بَعدِ ما عَذَلوا",90,"ل",3,0],["وإن هي زارَتْ خلتَها مستعيرةً","لَها مِن خَطيبِ الحفلِ جَلسَتَه العَجْلى",91,"ل",2,0],["وإنّه ليُنَمِّيهِ ويُودِعُهُ","من الصبابة بين الحِرْصِ وَالحَرَسِ",92,"س",1,0],["وَاِنهَلَّ بَعدَ اِنقِطاعٍ رِسلُ شارِفِها","حَتّى غَدَت مِن رَفِيهِ العَيشِ في طُعَمِ",93,"م",1,0],["وَإِن هُوَ يُظلَم لا تُدافِع بِحاجَةٍ","وَإِن هُوَ يَظلِم قُلتَ جَنبُكَ أُضرِعا",94,"ع",2,0],["وَأَنَّها حَلَفَت لِلَّهِ جاهِدَةً","وَما أَهَلَّ لَهُ الحُجّاجُ وَاِعتَمَروا",95,"ر",3,0],["وَاِنهَرهُ حَتّى تَستَهِلَّ دُموعُهُ","في وَجنَتَيهِ وَتَلتَظي أَحشاؤُهُ",96,"ا",3,0],["وَاِنهَد لَها فَالسَيفُ في يَدِ فارِسٍ","يَسطو بِهِ وَالسَهمُ في يَدِ باري",97,"ر",2,0],["وَإِن هَدَّتِ الأَيّامُ أَركانَ دَولَةٍ","فَثَمَّ مِنَ الأَقلامِ أَقوى دَعائِمِ",98,"م",1,0],["وَإِن هَوَّدَت في الوَجدِ مِنها حُشاشَةٌ","أَلَحَّت عَلَيها لَوعَةٌ ما تُهَوِّدُ",99,"د",1,0],["وانْهَ اليَتيمَ عَنِ البُكى مُتَرَفِّقاً","إِنَّ اليَتيمَ تَهيجُهُ الأَعيادُ",100,"د",1,0],["وَإِن هُمو كَشَفوا يَوماً مَقاتِلَها","فَلا تَسَل كَيفَ يَرميها أَعاديها",101,"ي",3,0],["وإن هَجَعَ النِّيامُ فلا تَنامِي","عَن الصّوتِ المردَّدِ حيثُ كانا",102,"ن",2,0],["وَاِنهَضوا وَاِرفَعوا عالياً","مَجدكُم خالِداً ساميا",103,"ي",2,0],["وانهضْ ولا تشكُ الزما","نَ فما شكا إلاَّ الكسول",104,"ل",1,0],["وَإِن هَتَفَت بَنو بَكرٍ أَجَبنا","إِليهِم بِالصَنائِعِ مَعلِنينا",105,"ن",2,0],["وَإِن هُوَ أَقعى خِلتَهُ مِن مَكانِهِ","عَلى حالَةٍ ما لَم يَزُل جِذمَ مِسطَحِ",106,"ح",1,0],["وَأَنهَمَني فِيكِ الأَقارِبُ كُلُّهُم","وَباحَ بِما يُخفى الفُؤادُ ضَمِيري",107,"ر",2,0],["وَإِن هُوَ لَم يَحمِل عَلى النَفسِ ضَيمَها","فَلَيسَ إِلى حُسنِ الثَناءِ سَبيلُ",108,"ل",1,0],["وَاِنهَزَمَ البَقُّ وَكَنَّ رُتَّعاً","عَلى الدِماءِ وارِداتٍ شُرَّعا",109,"ع",2,0],["وَأَنهارُ ماءٍ كَالسَلاسِلِ فُجِّرَت","لِتُرضِعَ أَولادَ الرَياحينِ وَالزَهرِ",110,"ر",1,0],["وَأَنهَضُ في طَرَباتٍ تَهيجُ","وَأُلزِمُ طَوراً فُؤادي يَدي",111,"ي",1,0],["وَإِن هَمَمتَ بِشَيءٍ","مِن وُدِّهِ فَنَهاكا",112,"ك",2,0],["وإن هو طالبُ النجوِ","فهذّاكَ لهُ أجود",113,"د",1,0],["وانهص ب