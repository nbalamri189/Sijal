ه",2,"ن",2,0],["فَلِذاكَ يَشتاقُ المَنِيَّ لِأَنَّهُ","مِنهُ ترَكَّبَ لحمُهُ مَع عَظمِهِ",3,"م",2,0],["فلذا بت وفي ضميري نية","لكم ستمسي أفكه الأسمار",4,"ر",1,0],["فلذاك أنظمها قلائد لؤلؤ","لألاؤهْا قد شف بالأنوار",5,"ر",1,0],["فلذاك عند الهاجرا","ت يَسيل شيء من لعابه",6,"ب",2,0],["فلذا أحرزتك غضاً طرياً","وكذا كم يكون موت الكرام",7,"م",1,0],["فلذاك من حنق يعبس أبيضٌ","في غمده الملقى ويرعد أسمر",8,"ر",1,0],["فلذاك أهديت الرّكابَ تخيُّلاً","لأكون قد قبلتها برسول",9,"ل",1,0],["فلذاك صار مُولّياً","أبداً ولوْ لاقى جرادَه",10,"د",2,0],["فلذاك الحديثِ حسنُ الملاهي","وله دونهنّ فضلُ الجلالِ",11,"ل",1,0],["فلذاكَ أجدرُ أن يعانيهِ الفتى","ولذاك أخْلقُ أن يقال نبيلُ",12,"ل",1,0],["فلَذكرُ الأمير أطيبُ نشراً","من خُزامى الربيع والأقحوان",13,"ن",1,0],["فَلَذَّت لِمُرتاحٍ وَطابَت لِشارِبٍ","وَراجَعَني مِنها مِراحٌ وَأَخيَلُ",14,"ل",1,0],["فَلِذاكَ ما لاقَيتُ غَيرَ مُشَبِّبٍ","بِالغانِياتِ وَطالِبٍ لِعَطاءِ",15,"ا",2,0],["فَلُذتُ بِالصوفِ أَتَّقيهِ","فَاِختَرَقَ الصوفُ كَالحَريزِ",16,"ر",3,0],["فَلِذاكَ لَو فَتَّشتَ قَلبي لَم تَجِد","لَكَ في الوَلاءِ المَحضِ فيهِ شَريكا",17,"ك",2,0],["فَلِذاكَ خَدُّكَ راحَ في الوَر","دِ المُضاعَفِ وَهوَ لابِس",18,"س",1,0],["فلذةٌ مِنْ صَميمِ قَلْبي وجُزْءٌ","مِنْ فُؤادي وقِطْعَةٌ مِنْ ضُلُوعي",19,"ع",2,0],["فَلِذاكَ جاوَزَها عَلِيٌّ وَحدَهُ","وَسَعى بِمُنصُلِهِ إِلى آمالِهِ",20,"ل",2,0],["فلذاك وسعنا الأداة وهكذا","تبني العوالم مركزا وقرارا",21,"ر",2,0],["فَلِذاكَ آنَستِ الوُقوفُ بِرَبعِهِ","نارَينِ نارِ وَغىً وَنارِ مَضيفِ",22,"ف",1,0],["فَلِذاكَ سِربي لا يُرا","عُ وَلا يُرادُ وَلا يُرامُ",23,"م",1,0],["فَلِذا جاءَ وَهوَ طَلقٌ عَبوسٌ","مَنظَرٌ رائِقٌ وَدَمعٌ هَطولُ",24,"ل",1,0],["فَلِذاكَ أَنّي قَد قَطَعتُ تَرَدُّدي","عَنكُم وَنارُ الشَوقِ حَشوُ فُؤادي",25,"د",2,0],["فَلِذاكَ إِذ واجَهتَني","بَلِّ الفُؤادُ غَليلَه",26,"ل",2,0],["فَلِذاكَ أَشري الوَصلَ مِنكَ بِمُهجَتي","وَأَبيعُ دُنيائي بِذاكَ وَديني",27,"ن",2,0],["فَلُذ بِالصَبرِ في اللَأئي وَأَحسِن","عَزاءَكَ وَاِغتَنِم حُسنَ الثَوابِ",28,"ب",1,0],["فَلِذاكَ لا أَخشى وُرودَ مَنِيَّتي","وَأَرى وُرودَ الحَتفِ عَذبَ المَنهَلِ",29,"ل",1,0],["فِلَذُ القلوب إلى القلوب تَراجعتْ","في مُلْتَقَى الآباءِ بالولدانِ",30,"ن",1,0],["فلذة الكبْدِ التي لَما نأتْ","نثْرتُ منظومَ دمعي دررا",31,"ر",2,0],["فَلَذاكَ خَيرٌ مِن مُواظَبَةٍ","لَيسَت تَزيدُكَ عِندَهُ قُربا",32,"ب",2,0],["فَلِذاكَ أَبلى الدَهرُ مَنزِلَةَ الحِمى","وَالدَهرُ ذو غِيَرٍ وَذو إِزعاجِ",33,"ج",1,0],["فَلِذا مِتُّ وَلَو عِش","تُ إِذاً طالَ هَواني",34,"ن",2,0],["فَلَذاكَ خَيرٌ مِن مُواصَلَةٍ","لَيسَت تَزيدُكَ عِندَهُ قُربا",35,"ب",2,0],["فَلِذالِكَ صارَ الحَمدُ عِندَ عُطاسِهِم","خُلقاً لَهُم وَأَخو الحِجى مُتنَطِّسُ",36,"س",1,0],["فَلِذاكَ تُبْصِرُهُ لِكبْرٍ عادَهُ","يُوفي على جِذْلٍ بكلّ قِذافِ",37,"ف",1,0],["فلِذَا تُرْوي وتَرْوي ذا صدىً","وحديثاً عن فتاةِ الحيّ حَي",38,"ي",1,0],["فَلِذاكَ خافوا بَأسَهُن","نَ وَأَشفَقوا مِن كَيدِهِنَّه",39,"ن",2,0],["فَلِذاكَ الدَّهرُ مَأمورق بِنا","فَهوَ لا يَغفَلُ إن شَيءٌ غَفَل",40,"ل",1,0],["فَلِذَاكَ تَعْتَدُّ ازْدِيَادَ وَزِيرِهَا","فَتْحاً تُرَجِّي الخَيْرَ مِنْهُ جَزِيلاَ",41,"ل",2,0],["فَلِذَاكَ بِتُّ وَفِي ضَمِيرِي نِيَّةٌ","لَكُمُ سَتُمْسِي أَفْكَهَ الأَسْمَارِ",42,"ر",1,0],["فَلِذاكَ الإِعراضُ عَنكِ وَما آ","ثَرَ قَلبي عَلَيكِ أُخرى اِختِيارا",43,"ر",2,0],["فلذٌ من الأكباد باتت تشتكي","الله في فلذ من الأكباد!",44,"د",1,0],["فلذتُ بالأولياء؛ علّ لهم","سرًا، وإن كنت غيرَ معتقد",45,"د",1,0],["فلذا ما أحوك عضب امتداحي","سابريا مسهم الأبراد",46,"د",1,0],["فلذت بالصوف أتّقيه","فاخترق الصوف كالحرير",47,"ر",1,0],["فلذك الحديثِ حسنُ الملاهي","وله دونهنّ فضلُ الجلالِ",48,"ل",1,0],["فَلَذَاكَ خَيْرٌ مِنْ مُوَاصَلَة ٍ","سلماً، وكنتِ ترينهُ حربا",49,"ب",2,0],["فلذى السعادات ابنِ جعفرَ شيمةٌ","من قَرقفٍ صِرفٍ ومِسك أذفرِ",50,"ر",1,0],["فَلِذا إِذا نُسِبَت عُلىً في مَشهَدٍ","فَإِلَيكَ ياشَرَفَ المَعالي تُنسَبُ",51,"ب",1,0],["فَلِذاكَ لاقى يَومَهُ مُستَبشِراً","حَتّى ظَنَنّا الَموتَ بَعدَ عُفاتِهِ",52,"ت",2,0],["فَلِذا الثَناءُ عَلَيكَ ضِدُ ثَنائِهِم","ذا مُنشَدٌ أَبَداً وَذا مَنشودُ",53,"د",1,0],["فَلِذا تَعُمُّ ذَوي النَباهَةِ عونُهُ","إِن سامَحَت وَتَخُصُّكُم أَبكارُهُ",54,"ر",2,0],["فَلِذاكَ أَمرُكَ حَيثُ يَمَّمَ نافِذٌ","أَرسَلتَ جَيشاً أَو بَعَثتَ رَسولا",55,"ل",2,0],["فَلِذاكَ ما يَنفَكُّ مُلكُكَ ظافِراً","يَحمي حِماهُ وَيَقتُلُ الأَقيالا",56,"ل",2,0],["فَلِذا ما أَزالُ أَنشُدُ قَلباً","ضَلَّ بَينَ الدَلالِ وَالإِدلالِ",57,"ل",1,0],["فَلِذاكَ أَلسُنُهُم لِسانٌ واحِدٌ","يُثني بِما خَوَّلتَ وَالدُنيا فَمُ",58,"م",1,0],["فَلِذا اِستَجارَكَ كَي يَفوزَ بِنَفسِهِ","فَأَطَعتَ فيها الواحِدَ العَلّاما",59,"م",2,0],["فَلِذا الجُيوشُ يَقودُها وَيَسودُها","بَنجوتَكينُ أَميرُها وَطُغانُهُ",60,"ن",2,0],["فَلِذا رَجائي عَن سِواكَ مُنَكِّبٌ","وَإِلَيكَ يَتبَعُ نَصَّهُ ذَمَلانُهُ",60,"ن",2,0],["فَلُذ بجنابه تَغنَم أمانا","إذا ما صح منك له اغتنام",61,"م",1,0],["فَلُذ بِحِماهُ فَهوَ لِلكُلِّ جُنَّةٌ","لِمِقدارِهِ بَينَ النَبيِّينَ مِكنَةٌ",62,"ه",1,0],["فلذاك لم يأسف لبعد عنهمُ","وله عليك تأسفٌ بضرامَ",63,"م",1,0],["فلذا سألتك أن تخففَ في العطا","لأمدّ أطماعي إِليك وأحسرا",64,"ر",2,0],["فلذاك طلتم كلًَّ ملكٍ في الورى","فخراً وايد ملككم بدوامِ",65,"م",1,0],["فلذاك يغمد في المعارك سيفه","إن أدبرت بظهورها الأقران",66,"ن",1,0],["فلذاك كم صغت الثناء قلائدا","ونسخت من حبري به حبري به",67,"ب",2,0],["فلِذاك تُخشى مِن قَناكَ مَطاعِنٌ","وكذاك تُغشى من قِراك مَطاعِمُ",68,"م",1,0],["فلذتُ ببابِ دارِكَ مُستجيراً","مُخلّى السربِ متسّعَ المَجالِ",69,"ل",1,0],["فَلِذاكَ قالَ الناسُ في آبائِهم","قَبحَ الإِلَهُ أُبُوَّةً لَم يُنجِبُوا",70,"ب",3,0],["فَلِذاكَ أَصْبِرُ عَافٍ عاقِلٍ","وَأُهَتِّكُ الْمَذْعُورَ فِي وَثَباتِي",71,"ت",2,0],["فَلِذاك النَّوْمُ فِي","عَيْنِي قَدْ صارَ غَرِيبَا",72,"ب",2,0],["فَلِذا أَهْوى مَعَ ال","رُّؤْيَةِ هَجْراً وَرَقِيبَا",72,"ب",2,0],["فَلِذاكَ أَحجىأَن يُنيلَكَ سائِلاً","أَم أَن يُوَرِّعَ عَنكَ يَومَ لِقاءِ",73,"ا",2,0],["فلذاك صار اللحظُ في حكم الهوى","مستشهَداً عن غامض الأسرارِ",74,"ر",1,0],["فلذاكَ زخرف وجهَه بدقائقٍ","فتنت وكحَّلَ طرفَه بفتورِ",75,"ر",1,0],["فلذا من كان يهوى الجد لم","يحي إلا في شقاء وثبور",76,"ر",1,0],["فلذ بتاج الدين تاج العلا","رب الثناء الطيب النشر",77,"ر",1,0],["فلذاك آثرتُ التفرّد والنوى","وغَدوتُ للراح المُ