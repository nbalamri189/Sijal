,"https://www.aldiwan.net/poem38681.html","الخفيف"],[66,"في طبعكم ملل مناف للوفا","https://www.aldiwan.net/poem38764.html","الكامل"],[66,"من كنت أنت رسوله","https://www.aldiwan.net/poem39228.html","مجزوء الكامل"],[66,"الوجه منك عن الصواب يضلني","https://www.aldiwan.net/poem39680.html","الكامل"],[66,"لدوا للموت وابنوا للخراب","https://www.aldiwan.net/poem40118.html","الوافر"],[66,"لمن الشوازب كالنعام الجفل","https://www.aldiwan.net/poem41583.html","الكامل"],[80,"أخذت سفاقس منك عهد أمان","https://www.aldiwan.net/poem31263.html","الكامل"],[69,"أثر الحزن بقلبي أثرا","https://www.aldiwan.net/poem29053.html","الرمل"],[31,"هلا ارعويت فترحمي صبا","https://www.aldiwan.net/poem42612.html","الكامل"],[52,"حث الفراق بواكر الأحداج","https://www.aldiwan.net/poem27171.html","الكامل"],[50,"سيدي خذ بي أتانا","https://www.aldiwan.net/poem24538.html","مجزوء الرمل"],[50,"لا تجعلن أحدا عليك إذا","https://www.aldiwan.net/poem64753.html","الكامل"],[46,"كنت الفقير فخطئت لك صيب","https://www.aldiwan.net/poem22804.html","الكامل"],[46,"أودى فليت الحادثات كفاف","https://www.aldiwan.net/poem23630.html","الكامل"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20281","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21001","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55187","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54946","الكامل"],[31,"","https://poetry.dctabudhabi.ae/diwan/poem/6095","الخفيف"],[106,"من للموظف","https://www.poetsgate.com/ViewPoem.aspx?id=179515",""],[106,"فجيعة في ساعة","https://www.poetsgate.com/ViewPoem.aspx?id=179526",""],[77,"أنتم من مناسب الأمجاد","https://www.poetsgate.com/ViewPoem.aspx?id=33807",""],[91,"شاعر الشهور","https://www.poetsgate.com/ViewPoem.aspx?id=53070",""],[51,"أيّها السيدُ الذي اختاره السيْ","https://www.poetsgate.com/ViewPoem.aspx?id=30337",""],[31,"هلا ارعويتِ، فترحمي صبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18791&r=&rc=54",""]],"verses":[["فَلِذاكَ ما اِرتَعَدَ الجَنا","نُ حَياً وَلا عَرِقَ الجَبينُ",0,"ن",1,0],["فلِذا ما أحوكُ عصْبَ امْتِداحي","سابِريّاً مُسَهَّمَ الأبْرادِ",1,"د",1,0],["فَلِذاكَ خافوا بَأسَهُ","نَ وَأَشفَقوا مِن كَيدِهِنَّه",2,"ن",2,0],["فَلِذاكَ يَشتاقُ المَنِيَّ لِأَنَّهُ","مِنهُ ترَكَّبَ لحمُهُ مَع عَظمِهِ",3,"م",2,0],["فلذا بت وفي ضميري نية","لكم ستمسي أفكه الأسمار",4,"ر",1,0],["فلذاك أنظمها قلائد لؤلؤ","لألاؤهْا قد شف بالأنوار",5,"ر",1,0],["فلذاك عند الهاجرا","ت يَسيل شيء من لعابه",6,"ب",2,0],["فلذا أحرزتك غضاً طرياً","وكذا كم يكون موت الكرام",7,"م",1,0],["فلذاك من حنق يعبس أبيضٌ","في غمده الملقى ويرعد أسمر",8,"ر",1,0],["فلذاك أهديت الرّكابَ تخيُّلاً","لأكون قد قبلتها برسول",9,"ل",1,0],["فلذاك صار مُولّياً","أبداً ولوْ لاقى جرادَه",10,"د",2,0],["فلذاك الحديثِ حسنُ الملاهي","وله دونهنّ فضلُ الجلالِ",11,"ل",1,0],["فلذاكَ أجدرُ أن يعانيهِ الفتى","ولذاك أخْلقُ أن يقال نبيلُ",12,"ل",1,0],["فلَذكرُ الأمير أطيبُ نشراً","من خُزامى الربيع والأقحوان",13,"ن",1,0],["فَلَذَّت لِمُرتاحٍ وَطابَت لِشارِبٍ","وَراجَعَني مِنها مِراحٌ وَأَخيَلُ",14,"ل",1,0],["فَلِذاكَ ما لاقَيتُ غَيرَ مُشَبِّبٍ","بِالغانِياتِ وَطالِبٍ لِعَطاءِ",15,"ا",2,0],["فَلُذتُ بِالصوفِ أَتَّقيهِ","فَاِختَرَقَ الصوفُ كَالحَريزِ",16,"ر",3,0],["فَلِذاكَ لَو فَتَّشتَ قَلبي لَم تَجِد","لَكَ في الوَلاءِ المَحضِ فيهِ شَريكا",17,"ك",2,0],["فَلِذاكَ خَدُّكَ راحَ في الوَر","دِ المُضاعَفِ وَهوَ لابِس",18,"س",1,0],["فلذةٌ مِنْ صَميمِ قَلْبي وجُزْءٌ","مِنْ فُؤادي وقِطْعَةٌ مِنْ ضُلُوعي",19,"ع",2,0],["فَلِذاكَ جاوَزَها عَلِيٌّ وَحدَهُ","وَسَعى بِمُنصُلِهِ إِلى آمالِهِ",20,"ل",2,0],["فلذاك وسعنا الأداة وهكذا","تبني العوالم مركزا وقرارا",21,"ر",2,0],["فَلِذاكَ آنَستِ الوُقوفُ بِرَبعِهِ","نارَينِ نارِ وَغىً وَنارِ مَضيفِ",22,"ف",1,0],["فَلِذاكَ سِربي لا يُرا","عُ وَلا يُرادُ وَلا يُرامُ",23,"م",1,0],["فَلِذا جاءَ وَهوَ طَلقٌ عَبوسٌ","مَنظَرٌ رائِقٌ وَدَمعٌ هَطولُ",24,"ل",1,0],["فَلِذاكَ أَنّي قَد قَطَعتُ تَرَدُّدي","عَنكُم وَنارُ الشَوقِ حَشوُ فُؤادي",25,"د",2,0],["فَلِذاكَ إِذ واجَهتَني","بَلِّ الفُؤادُ غَليلَه",26,"ل",2,0],["فَلِذاكَ أَشري الوَصلَ مِنكَ بِمُهجَتي","وَأَبيعُ دُنيائي بِذاكَ وَديني",27,"ن",2,0],["فَلُذ بِالصَبرِ في اللَأئي وَأَحسِن","عَزاءَكَ وَاِغتَنِم حُسنَ الثَوابِ",28,"ب",1,0],["فَلِذاكَ لا أَخشى وُرودَ مَنِيَّتي","وَأَرى وُرودَ الحَتفِ عَذبَ المَنهَلِ",29,"ل",1,0],["فِلَذُ القلوب إلى القلوب تَراجعتْ","في مُلْتَقَى الآباءِ بالولدانِ",30,"ن",1,0],["فلذة الكبْدِ التي لَما نأتْ","نثْرتُ منظومَ دمعي دررا",31,"ر",2,0],["فَلَذاكَ خَيرٌ مِن مُواظَبَةٍ","لَيسَت تَزيدُكَ عِندَهُ قُربا",32,"ب",2,0],["فَلِذاكَ أَبلى الدَهرُ مَنزِلَةَ الحِمى","وَالدَهرُ ذو غِيَرٍ وَذو إِزعاجِ",33,"ج",1,0],["فَلِذا مِتُّ وَلَو عِش","تُ إِذاً طالَ هَواني",34,"ن",2,0],["فَلَذاكَ خَيرٌ مِن مُواصَلَةٍ","لَيسَت تَزيدُكَ عِندَهُ قُربا",35,"ب",2,0],["فَلِذالِكَ صارَ الحَمدُ عِندَ عُطاسِهِم","خُلقاً لَهُم وَأَخو الحِجى مُتنَطِّسُ",36,"س",1,0],["فَلِذاكَ تُبْصِرُهُ لِكبْرٍ عادَهُ","يُوفي على جِذْلٍ بكلّ قِذافِ",37,"ف",1,0],["فلِذَا تُرْوي وتَرْوي ذا صدىً","وحديثاً عن فتاةِ الحيّ حَي",38,"ي",1,0],["فَلِذاكَ خافوا بَأسَهُن","نَ وَأَشفَقوا مِن كَيدِهِنَّه",39,"ن",2,0],["فَلِذاكَ الدَّهرُ مَأمورق بِنا","فَهوَ لا يَغفَلُ إن شَيءٌ غَفَل",40,"ل",1,0],["فَلِذَاكَ تَعْتَدُّ ازْدِيَادَ وَزِيرِهَا","فَتْحاً تُرَجِّي الخَيْرَ مِنْهُ جَزِيلاَ",41,"ل",2,0],["فَلِذَاكَ بِتُّ وَفِي ضَمِيرِي نِيَّةٌ","لَكُمُ سَتُمْسِي أَفْكَهَ الأَسْمَارِ",42,"ر",1,0],["فَلِذاكَ الإِعراضُ عَنكِ وَما آ","ثَرَ قَلبي عَلَيكِ أُخرى اِختِيارا",43,"ر",2,0],["فلذٌ من الأكباد باتت تشتكي","الله في فلذ من الأكباد!",44,"د",1,0],["فلذتُ بالأولياء؛ علّ لهم","سرًا، وإن كنت غيرَ معتقد",45,"د",1,0],["فلذا ما أحوك عضب امتداحي","سابريا مسهم الأبراد",46,"د",1,0],["فلذت بالصوف أتّقيه","فاخترق الصوف كالحرير",47,"ر",1,0],["فلذك الحديثِ حسنُ الملاهي","وله دونهنّ فضلُ الجلالِ",48,"ل",1,0],["فَلَذَاكَ خَيْرٌ مِنْ مُوَاصَلَة ٍ","سلماً، وكنتِ ترينهُ حربا",49,"ب",2,0]]}