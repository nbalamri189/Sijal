{"poems":[[302,"حسن ابتدائي بذكري جيرة الحرم","https://www.aldiwan.net/poem33180.html","البسيط"],[422,"الله يعلم والأنام شهود","https://www.aldiwan.net/poem53839.html","الكامل"],[422,"جئت يا ابن الفاروق من معجز","https://www.aldiwan.net/poem53865.html","الخفيف"],[505,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105453","الخفيف"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77738","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118325","الكامل"],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123477","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74157","الرجز"],[3481,"","https://poetry.dctabudhabi.ae/diwan/poem/112964","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110058","البسيط"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40121","الرمل"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72470","البسيط"],[5582,"أَبْدَلَتْهُ النَّوَى بَعْدَ خُرَّدِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=186882",""]],"verses":[["سمَّطتُ من فَرحي في وصفهم مِدَحي","ولَم أَنَل منحي إلّا بجاهِهِمِ",0,"م",1,0],["سِمْط الفضائل والفواضل كلّها","نُثِرَتْ عليه من الدموع عقود",1,"د",1,0],["سمّطتها من قبلك النَّاس لكنْ","فاتَها في قصورها أشياء",2,"ا",2,0],["سِمْطُ المعاني على مَنْظومِ جوهَرهِ","تخالفتْ باختلافِ الفهمِ أهواءُ",3,"ا",2,0],["سمط در وافي فأحيى فؤادي","قطعته صوارم الهجران",4,"ن",1,1],["سمط تقلده فؤاد متيم","تَنجو به الأَسرار من برهوت",5,"ت",1,0],["سمط غدوا في جيدها واساور","في الصمعين وفي النواظر اثمدا",6,"د",2,0],["سَمَطنا على النّهج النَّهيج فهالَنا","وإن تَقضِ عُجباً فالنّعيمُ لنا الرزّقٍ",7,"ق",1,0],["سَمط لئال قَد سَما نِظامهم","وَقَد حَلا لسمعنا نِظامهم",8,"م",1,0],["سمّط عقودهمُ وارفع بنودهمُ","واخمد حسودهم بالذل والغممِ",9,"م",1,0],["سَمِّط قلائِدَهم وانظِم فرائِدَهم","وانشِد قصائدَهم يا طَيِّبَ النَغَمِ",10,"م",1,0],["سَمَطْتَ أَمسَ سُمَيْسَاط بِها","نَظْمَ جَيشٍ مُبْهجٍ لِلنّاظرين",11,"ن",1,0],["سَمَّطْتُ بُرْدَةَ مَدْحٍ في عُلاهُ شَفَتْ","أَدِيبَ بُوصِيرَ فاسْتَوْفَتْ عُلاً وَوَفَتْ",12,"ت",1,0],["سمط به درر في كف نظام","إن البيان الذي أبدت مفكرتي",13,"ي",1,0],["سِمْطُ مَبْسِمِهِ العَذْبِ لُؤْلُؤُهُ","لَمْ يُثَقِّبْهُ لِلنَّظْمِ مِبْرَدُهُ",14,"د",2,0]]}