{"poems":[[0,"خليلي مرا بي على أم جندب","https://www.aldiwan.net/poem52.html","الطويل"],[91,"وقفت على المستنصرية باكيا","https://www.aldiwan.net/poem44962.html","الطويل"],[54,"لمن دار وربع قد تعفى","https://www.aldiwan.net/poem27164.html","الوافر"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[2230,"","https://poetry.dctabudhabi.ae/diwan/poem/101792","الطويل"],[2230,"","https://poetry.dctabudhabi.ae/diwan/poem/101791","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124784","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62823","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62768","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28679","الوافر"],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""]],"verses":[["فَكابٍ عَلى حُرِّ الجَبينِ وَمُتَّقٍ","بِمَدرِيَّةٍ كَأَنَّها ذَلقُ مِشعَبِ",0,"ب",1,0],["فكابدت منهن الصروف نوازلاً","وقاسيت منهن الخطوب عواديا",1,"ي",2,0],["فَكابَدنا السُرى حَتّى رَأَينا","غُرابَ اللَيلِ مَقصوصَ الجَناحِ",2,"ح",1,0],["فَكابدوا المجاعَة","وأَنظِروني ساعَه",3,"ه",1,0],["فكابد حر السيف وهو على ظماً","وظلّ بحر الصيف ملقى على الغبرا",4,"ر",2,0],["فكابد ما لو بالجبال لهدّها","وشاهد بين القوم فاطمة حسرا",5,"ر",2,0],["فكابد إلى أن تبلغ النفس عذرها","وكن في اكتساب العلم طلاع انجد",6,"د",1,0],["فكابدَ حتى استباحَ البلا","دَ قسراً ونالَ المُنى بالطّلَبْ",7,"ب",1,0],["فكابَرَ فيها خَمسَ عشرةَ حِجّةً","إلى المجدِ دفاعاً صدورَ العَظائمِ",8,"م",1,0],["فكابدوا المجاعه","وانتظروني ساعه",9,"ه",1,0],["فَكابَرَ طَرفُهُ فيها","فَأَرسَلَها وَما اِعتَزَما",10,"م",2,0],["فكابرتمو المعقول بالغشي والهوى","وما كان معلوماً لدى من تعلما",11,"م",2,0]]}