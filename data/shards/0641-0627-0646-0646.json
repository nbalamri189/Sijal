poem49796.html","البسيط"],[406,"سأنفق وفرى في اكتساب مكارم","https://www.aldiwan.net/poem32080.html","الطويل"],[406,"أحبابنا من لي لو","https://www.aldiwan.net/poem32430.html","مجزوء الهزج"],[407,"إذا بلغتنا العيس يحيى بن خالد","https://www.aldiwan.net/poem67501.html","الطويل"],[413,"كفاني المهمات عبد الغني","https://www.aldiwan.net/poem53926.html","المتقارب"],[413,"خليلي هل لي بعد أسنمة النقا","https://www.aldiwan.net/poem53952.html","الطويل"],[429,"أقبل بوجهك إني عنك منصرف","https://www.aldiwan.net/poem12318.html","البسيط"],[429,"إني أبثك حالي","https://www.aldiwan.net/poem12699.html","المجتث"],[429,"راخ لها في السبب","https://www.aldiwan.net/poem12774.html","مجزوء الرجز"],[436,"استقبل العز مرفوعا به علمك","https://www.aldiwan.net/poem34775.html","البسيط"],[436,"حسبي رضاك من الدهر الذي عتبا","https://www.aldiwan.net/poem34821.html","البسيط"],[436,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[438,"قفوا أيها الركبان نودعكم منا","https://www.aldiwan.net/poem14339.html","الطويل"],[438,"عزاء يا بني شرف","https://www.aldiwan.net/poem14463.html","مجزوء الوافر"],[451,"دور من القدم الغالي مجللة","https://www.aldiwan.net/poem61368.html","البسيط"],[451,"جزيرة النور تحيينا","https://www.aldiwan.net/poem61396.html","السريع"],[456,"ألا صاحب كالسيف حلو شمائله","https://www.aldiwan.net/poem55994.html","الطويل"],[459,"يقر بعيني أن أراها مغيرة","https://www.aldiwan.net/poem15105.html","الطويل"],[459,"اذا افتخرت عليا ربيعة بالذي","https://www.aldiwan.net/poem15413.html","الطويل"],[459,"لا أوحش الله من أنوار منقبة","https://www.aldiwan.net/poem16142.html","البسيط"],[462,"في لأذني عن كل لاح صمم","https://www.aldiwan.net/poem3159.html","عموديه"],[462,"لقد بوركت يا بن المبارك بلدة","https://www.aldiwan.net/poem3187.html","عموديه"],[462,"سرى وأقبل يقفو إثره القمر","https://www.aldiwan.net/poem3626.html","عموديه"],[466,"جواب عيسى لسائليه","https://www.aldiwan.net/poem59989.html","مخلع البسيط"],[493,"يا نفس صبرا وإلا فاهلكي جزعا","https://www.aldiwan.net/poem10236.html","البسيط"],[498,"هل بان نعمان وهذا الأجرع","https://www.aldiwan.net/poem37974.html","الرجز"],[503,"البديل","https://www.aldiwan.net/poem56766.html","مخلع البسيط"],[527,"كم ذا له من منن","https://www.aldiwan.net/poem37127.html","مجزوء الرجز"],[527,"أعن ذكرها يسلو الفؤاد المبلبل","https://www.aldiwan.net/poem37271.html","الطويل"],[527,"لا أترك الإلحاحا","https://www.aldiwan.net/poem37470.html","مجزوء الرجز"],[532,"أزف لك التحية والسلاما","https://www.aldiwan.net/poem23815.html","الوافر"],[538,"هلم اسقني كأسي ودع عنك من أبى","https://www.aldiwan.net/poem56619.html","الطويل"],[549,"زارك زوار الحلم","https://www.aldiwan.net/poem47191.html","مجزوء الرجز"],[549,"ما صيد قلبك إلا بابنة الكلل","https://www.aldiwan.net/poem47265.html","البسيط"],[549,"ألا جنبا قلبي الأذى لا يطيقه","https://www.aldiwan.net/poem47368.html","الطويل"],[549,"سلام على العمل الصالح","https://www.aldiwan.net/poem47889.html","المتقارب"],[549,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"],[556,"إن كنت لم ترض عن النفس","https://www.aldiwan.net/poem34447.html","السريع"],[560,"هذا ضريح الذي ما زال من قدم","https://www.aldiwan.net/poem52666.html","البسيط"],[584,"يا راقد الطرف ما للطرف إغفاء","https://www.aldiwan.net/poem17396.html","البسيط"]],"verses":[["فَإِن نُثمِر لَهُم شُكراً طَويلاً","فَهُم غَرَسوا وَكانوا المورِقينا",0,"ن",2,0],["فَإِن نَهَضتُ فَما لي غَيرَكُم وَطَرٌ","وَإِن قَعَدتُ فَما لي غَيرَكُم شُغُلُ",1,"ل",1,0],["فَإِنَّ نُفوسَ الناكِثينَ مُباحَةٌ","وَإِنَّ دِماءَ الغادِرينَ حَلالُ",2,"ل",1,0],["فَإِن نُصِرتِ فَالنَعيمُ مُدَّةً","وَالمَضجَعُ العاذِرُ إِن لَم تُنصَري",3,"ي",1,0],["فَإِنَّنا في أَرضِ أَعدائِنا","لا نَطَأُ العَذراءَ إِلّا سَفاح",4,"ح",1,0],["فَإِن نَرعَ شِركَةَ أَحسابِنا","جَميعاً فَذَلِكَ دينُ العَرَب",5,"ب",1,0],["فَإِنْ نِلْتُها اسْتَخْلَصْتُ حَقِّي وَإِنْ أَخِبْ","فَخُطْوَةُ سَاعٍ لَمْ تُصادِفْ نجاحَها",6,"ح",3,0],["فإنّ نَسيمَ العَنْبَرِ الوَرْدِ إنْ سَرَتْ","إلينا ووَسْواسُ الحُليِّ رَقيبُها",7,"ب",3,0],["فَإِنَّ نَسيمَ الجَوِّ يَجمَعُ بَينَنا","وَنُبصِرُ قَرنَ الشَمسِ حينَ تَزولُ",8,"ل",1,0],["فَإِنَّنِي جُزْتُ مِنْ سَامِي الْخِلاَلِ مَدىً","أَجَلْتُ فِيهِ جِيَادَ الْفِكْرِ مُنْتَسِبَا",9,"ب",2,0],["فإنْ نكن نحن أهليها ومنبِتَها","فإنّهم عَرَفُوها قبل أهليها",10,"ي",3,0],["فَإِنَّ نَعيمَ المُلكِ في شَظَفِ الشَقا","يُنالُ وَحُلوَ العِزِّ مِن مُرِّه يُجنى",11,"ن",2,0],["فَإِن نَغلِب فَغَلّابونَ قِدم","وَإِن نُغلَب فَغَيرُ مُغَلَّبينا",12,"ن",2,0],["فَإِنْ نَالَهُ فِي الحُبِّ خَطْبٌ فَإِنَّهُ","لَيَقْضِي خَلِيفاً أَنْ يَمُوتَ فَيَسْلَمَا",13,"م",2,0],["فَإِنْ نَالَ مِنِّي كَاشِحُونَ وَلُوَّمٌ","فَفِي كُلِّ حُبٍّ كَاشِحُونَ ولُوَّمُ",14,"م",1,0],["فَإِن نِلتُ ما يُغني مِنَ اليَومِ أَو غَدٍ","أَنَلتُكَ ما يَبقى إِلى آخِرِ الحَشرِ",15,"ر",1,0],["فَإِن نَحنُ كافَأنا فَأَهلٌ لِوُدِّنا","وَإِن نَحنُ قَصَّرنا فَما الوُدُّ مُتَّهَم",16,"م",1,0],["فإن نفعك شخصاً واحداً ربما","يكون منه عموم الناس في الضرر",17,"ر",1,0],["فَإِنَّ نَداماكَ الَّذينَ خَذَلتَهُم","تَلاقَت عَلَيهِم خَيلُ قَيسٍ وَغابُها",18,"ب",3,0],["فَإِنَّ نَزيعَ الجَفرِ يُذهِبُ عَيمَتي","وَأَبلُغُ بِالمَخشوبِ غَيرِ المُفَلفَلِ",19,"ل",1,0],["فإن نعفو فنحن لذاك أهل","وإن نرد العقاب فقادرينا",20,"ن",2,0],["فَإِن نابَهُ أَمرٌ وَقَتهُ نُفوسُنا","وَما نالَنا مِن صالِحٍ فَهوَ واسِعُه",21,"ع",2,0],["فَإِن نَلقَ في تَطوافِنا وَاِلتِماسِنا","فُراتَ بنَ حَيّانٍ يَكُن رَهنَ هالِكِ",22,"ك",1,0],["فإنَّني بين خُطَّتيْن هما","عزِّيَ دهري أوْ ذِلّتي أبدي",23,"د",2,0],["فإن نلتهُ فاعلم بأنك نائلي","وإن لم تنلهُ فابغ أمراً سوى أمري",24,"ر",2,0],["فإنني في قبضَتَي عنيف","وتحت وطء ليس بالخفيف",25,"ف",1,0],["فإنني لعزيز يوم تنصرني","وفيك عند اعتداء الدهر منتصف",26,"ف",1,0],["فإن نزتْ نَشَقَتْ فيها أو اختنقتْ","وإن ونتْ وتراخَتْ فهي للدَّركِ",27,"ك",1,0],["فإن نحن ناغمنا أخاه استفزنا","سروراً ففدَّينا الغزالَ المُناغما",28,"م",2,0],["فَإِنَّني هَهُنا غَريبٌ","وَلَيسَ في غُربَةٍ هَناء",29,"ا",2,0],["فَإِنَّ نَوائِبَ عارَكتُها","تَرُدُّ فَتى العَشرِ مُحدَودِبا",30,"ب",2,0],["فَإِنَّ نُفوسَ العُربِ كَالشُهبِ تَنطَوي","وَتَخفى وَلَكِن لَيسَ تَبلى وَلا تَصدا",31,"د",2,0],["فَإِنَّني شاهَدتُ طَيفَ الرَدى","يَنسَلُّ كَالسارِقِ بَينَ الظِلال",32,"ل",1,0],["فَإِنَّني في مَلَإٍ ظالِمٍ","أَحكامُهُ جائِرَةٌ قاسِيَه",33,"ه",1,0],["فَإِن نَحنُ لَم نَملِك دِفاعاً بِحادِثٍ","تُلِمُّ بِهِ الأَيّامُ فَالمَوتُ أَجمَلُ",34,"ل",1,0],["فَإِنَّني لاعدَلتُ الدَهرَ عَن حَسَنٍ","وَلا عَدَلتُ بِهِم عَن أَكرَمِ الشِيَمِ",35,"م",1,0],["فان ننج ننج بخير المتا","ع وإلا غرقنا مع الزورق",36,"ق",1,0],["فإن نفت الموانع فيه حظى","فليس بفائت حظ الكلام",37,"م",1,0],["فإنْ نَنَلْ عَفْوَهُ فالخلدُ يَجْمَعُنا","إنْ شاءَ أَوْ ف لَظىً إنْ شاءَ يُلْقينا",38,"ن",2,0],["فَإِنَّ نَهاري لَيلَةٌ مُدلَهِمَّةٌ","عَلى مُقلَةٍ مِن بَعدِكُم في غَياهِبِ",39,"ب",1,0],["فَإِن نِلتُ ما أَمَّلتُ مِنكَ فَرُبَّما","شَرِبتُ بِماءٍ يَعجِزُ الطَيرَ وِردُهُ",40,"د",2,0],["فإنْ نجتمعْ قبل المماتِ فناقتي","وراكبُها والحاديانُ فداكُما",41,"م",2,0],["فإنْ نِمتَ عنّي واطَّرحْتَ وسائلي","فللهِ عينٌ ما تكادُ تنامُ",42,"م",1,0],["فَإِن نُحصِ بِالتَفصيلِ مِنهُ مَثالِباً","تَناهَينَ نَعجَز قَبلَ جَمعِ المَثالِبِ",43,"ب",1,0],["فَإِن نَنسى نُعمى اللَهِ فيكَ فَحَظَّنا","أَضَعنا وَإِن نَشكُر فَقَد وَجَبَ الشُكرُ",44,"ر",1,0],["فَإِن نَبكِ لا نَبكِ المُصيباتِ إِذ أَتى","بِها الدَهرُ وَالأَيّامُ جَمٌّ خِصامُها",45,"م",3,0],["فَإِن نَزَلَت بَغتَةً لَم يُرَع","لِما كانَ في نَفسِهِ مَثَلا",46,"ل",2,0],["فَإِن نَطَقتُم بِفَخرٍ لا أَبالَكُمُ","فيمَن تَضَمَّنَ مِن إِخوانِنا اللَحَدُ",47,"د",1,0],["فَإِن نَزَلَت يَوماً فَلا تَخضَعَن لَها","وَلا تُكثِرِ الشَكوى إِذا النَعلُ زَلَّتِ",48,"ت",1,0],["فَإِنَّني أَهولُ مِنهُ ذِئباً","وَلَستُ أَخشى الرَوعَ وَالخُطُوبا",49,"ب",2,0],["فإن نجا من نارها مرة","فمن لهيب النفس لم يسلم",50,"م",1,0],["فإن نُصِرْتَ على طاغٍ ظفرتَ به","فما حليفاك إلا النصر والظفرُ",51,"ر",1,0],["فَإِن نَشَرُوا ما بَينَهمْ لَكَ طاعَةً","وقد طُوِيَت مِنهُم صُدورٌ على غَمرِ",52,"ر",1,0],["فَإِن نِلتُ ما أَمَّلتُ فيكَ فَإِنَّني","جَديرٌ وَإِلّا فَالرَحيلُ قَريبُ",53,"ب",1,0],["فَإِن نَكُ أُهمِلنا فَأَضعِف بِسَعيِنا","وَإِن نَكُ أُجبِرنا فَفيمَ نُتَعتِعُ",54,"ع",1,0],["فَإِنْ نَسُونِي فَذُكْرَتِي لَهُمُ","وَكَيْفَ يَنْسَى حَيَاتَهُ الْبَدَنُ",55,"ن",1,0],["فَإِن نَأَيتُم أَصابَ القَلبُ نَأيُكُمُ","وَإِن دَنَت دارُكُم كُنتُم لَنا سَكَنا",56,"ن",2,0],["فَإِن نَحنُ جِئنا سُنَّةً لَم تَكُن مَضَت","فَنَحنُ إِذا مِمّا يَقولونَ أَخرَقُ",57,"ق",1,0],["فَإِن نَشَرتَ عَلى عَمدٍ ذَوائِبَها","أَبصَرتَ مِنهُ فَتيتَ المِسكِ يَنتَشِرُ",58,"ر",1,0],["فَإِنَّني وَالعَفافُ مِن شِيَمي","آبى الدَنايا وَأَعشَقُ الحَسَنا",59,"ن",2,0],["فَإننَّ الثَّنَاءَ الَّذِي فِي سِوَاكَ","لأضيَعُ مِن كَاتِبٍ عَاطِلِ",60,"ل",1,0],["فَإِن نِساءً قَد تَحَدَّثنَ أَنَّنا","عَلى عَهدِنا وَالعَهدُ إِن دامَ أَجمَلُ",61,"ل",1,0],["فَإِن نَجتَمِع بَعدَ الفِراقِ فَما لَنا","عَلى فَعَلاتِ الدَهرِ عَتبٌ وَلا سُخطُ",62,"ط",1,0],["فإنني لا أرَى المدِيحَ به","لِلْمَالِ بلْ لِلْوِدَادِ والصُّحْبَهْ",63,"ب",2,0],["فإنْ نُسِبَتْ لِلنَّسرِ فالطائرُ الَّذي","لَهُ في البُروجِ الثَّابِتاتِ وُكُورُ",64,"ر",1,0],["فَإِنَّني مُتَّهَمٌ عِندَها","وَأَنتَ تَعلَمُ أَنّي بَري",65,"ي",1,0],["فَإِن نَظَرَ الواشونَ صَدَّت وَأَعرَضَت","وَإِن غَفَلوا قالَت أَلَستَ عَلى العَهدِ",66,"د",1,0],["فَإِن نالَ شَهداً فَأَيسِر بِهِ","عَلى أَنَّهُ بِسُقوطٍ حَرا",67,"ر",2,0],["فإنْ نالَ منكَ السُّقْمُ حظّاً فطالما","رأيْتُ هِلالَ الأفْقِ وهْوَ سَقيمُ",68,"م",1,0],["فإنّ نُجومَ الأرضِ ليس بغائبٍ","سَناها وفي جَوّ السماء نُجومُ",68,"م",1,0],["فإن نأى سائراً يا مُهجَتي ارتحلي","وإن دَنا زائراً يا مُقلتي ابتهِجي",69,"ج",2,0],["فإن نهاري ليلةٌ مدلهمةٌ","على مقلةٍ من فقدكم في غياهب",70,"ب",1,0],["فَإِن نَغلِب فَغَلّابونَ قِدماً","وَإِن نُغلَب فَغَيرُ مُغَلَّبينا",71,"ن",2,0],["فَإِنِّني عَفِيفُ الْهَوَى","وَمَا كُلُّ صَبٍّ يَعِفْ",72,"ف",1,0],["فَإِنْ نَافَقَ الأَقْوَامُ فِي الدِّينِ غَدْرَةً","فَإِنِّي بِحَمْدِ اللَّهِ غَيْرُ مُنَافِقِ",73,"ق",1,0],["فَإِنَّنِي أَنْتَشِي بِنَشْوَتِكُمْ","أَظْمَأَ مَا بَاتَ مِنِّيَ الكَبِدُ",74,"د",1,0],["فإنني حُزْتُ من سامي الخلالِ مدًا","أجَلْتُ فيه جِياحَ الفَخْرِ مُنْتَسَبا",75,"ب",2,0],["فإن نفع الخنزير ما قال كاذباً","ولا سرَّني ضغن الضَّغائن والحسد",76,"د",1,0],["فانْ نَخَرتِ بما عوَّضتِ من هبةٍ","فقد 