{"poems":[[55,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[57,"وآليت أن لا تكتبي ففجعتني","https://www.aldiwan.net/poem26073.html","الطويل"],[85,"يهني زمانك أعياد مجددة","https://www.aldiwan.net/poem54232.html","البسيط"],[85,"واليت ما أوليت يا بحر الندى","https://www.aldiwan.net/poem54311.html","الكامل"],[74,"قل للذي بدلت من لإقباله","https://www.aldiwan.net/poem19130.html","الكامل"],[53,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[64,"قد جاءنا في حكمة مكنونة","https://www.aldiwan.net/poem52204.html","الكامل"],[47,"بنا أنت من مفجوة لم تعتب","https://www.aldiwan.net/poem10896.html","الطويل"],[77,"ألا أيها الوادي المقدس بالندى","https://www.aldiwan.net/poem69025.html","البسيط"],[77,"قفا فلأمر ما سرينا وما نسري","https://www.aldiwan.net/poem69081.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85475","الطويل"],[47,"بِنَا أنْتِ مِنْ مَجْفُوّةٍ لمْ تُعَتَّبِ","https://www.poetsgate.com/ViewPoem.aspx?id=31693",""],[113,"لعمري ليس بالإشعار فخري","https://www.aldiwan.net/poem16511.html","الوافر"],[173,"يا باكياً لدمنة وأربع","https://www.aldiwan.net/poem1635.html",""],[188,"إذا ما وردنا ماء مدين أشرقت","https://www.aldiwan.net/poem23816.html","عموديه"],[236,"يا قسوة القلب مالي حيلة فيك","https://www.aldiwan.net/poem44559.html","البسيط"],[266,"أأبحت يا هذي دم المهجور","https://www.aldiwan.net/poem38277.html","الكامل"],[310,"يا خير محتفظ لود حبيب","https://www.aldiwan.net/poem56603.html","الكامل"],[333,"واقع أروع من نسج الخيال","https://www.aldiwan.net/poem55008.html","الرمل"],[359,"وآليت لا أعطيك قسراً ظُلامةً","https://www.aldiwan.net/poem714.html",""],[369,"وبرق مشيب في ظلام ذوائب","https://www.aldiwan.net/poem60634.html","الطويل"],[369,"أوجست من جمر بخدك ساطع","https://www.aldiwan.net/poem60852.html","الكامل"],[369,"رأيت الطريق إلى الوصل وعرا","https://www.aldiwan.net/poem60911.html","الطويل"],[369,"سواء تدان منهم وتناء","https://www.aldiwan.net/poem61015.html","الطويل"],[396,"ياكريم الوجه ضاقت وأنت بالعالم عليم","https://www.aldiwan.net/poem54488.html","عموديه"],[408,"قد آن أن تلوي العنان وتقصرا","https://www.aldiwan.net/poem46979.html","الكامل"],[443,"أحقا صددت وخنت الودادا","https://www.aldiwan.net/poem2615.html","المتقارب"],[463,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"],[463,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[469,"سقيت حياً جفني يا بانة الحمى","https://www.aldiwan.net/poem3501.html","عموديه"],[505,"أما والهوى العذري يا اخت عامر","https://www.aldiwan.net/poem37686.html","الطويل"],[519,"سفرت فبرقعها حجاب جمال","https://www.aldiwan.net/poem20814.html","الكامل"],[520,"سأبكي على ابني مدتي وحياتي","https://www.aldiwan.net/poem12039.html","الطويل"],[520,"أأرجو بقاء أم صفاء حياة","https://www.aldiwan.net/poem12043.html","الطويل"],[556,"قفا بي على تلك الطلول الرثائث","https://www.aldiwan.net/poem48019.html","الطويل"],[569,"أحبابنا لو تعلمون بحالنا","https://www.aldiwan.net/poem895.html",""],[609,"","https://poetry.dctabudhabi.ae/diwan/poem/198600","الخفيف"],[723,"","https://poetry.dctabudhabi.ae/diwan/poem/102033","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87129","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87074","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37789","الطويل"],[855,"","https://poetry.dctabudhabi.ae/diwan/poem/138856",""],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1085,"","https://poetry.dctabudhabi.ae/diwan/poem/124804","الطويل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80176","الكامل"],[1183,"","https://poetry.dctabudhabi.ae/diwan/poem/18262","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64658","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64967","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65032","البسيط"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56592","الخفيف"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26671","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77986","الكامل"],[1758,"","https://poetry.dctabudhabi.ae/diwan/poem/98059","الطويل"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105435","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48217","البسيط"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137938",""],[2176,"","https://poetry.dctabudhabi.ae/diwan/poem/69470","البسيط"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83235","المتقارب"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112584","الطويل"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140293",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108358",""],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129463","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40104","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40143","الكامل"],[4079,"","https://poetry.dctabudhabi.ae/diwan/poem/198740","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94365","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72663","المجتث"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139695",""],[4727,"أطلال","https://www.poetsgate.com/ViewPoem.aspx?id=211583",""],[5012,"تعال","https://www.poetsgate.com/ViewPoem.aspx?id=22796",""],[5121,"فِي قَلْبِي","https://www.poetsgate.com/ViewPoem.aspx?id=33499",""],[5147,"من عاذلي ومن البلية","https://www.poetsgate.com/ViewPoem.aspx?id=166725",""],[5277,"مشاعرٌ موحشة","https://www.poetsgate.com/ViewPoem.aspx?id=192198",""],[5338,"معارضة قصيدة بات سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=187941",""],[5573,"ارموز خط وبعد شط ودلو بير وعمق طي","https://www.poetsgate.com/ViewPoem.aspx?id=200172",""],[6003,"شكوى شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=188912",""]],"verses":[["واليتُ فيهِ مَدائِحي فَكَأَنَّما","أَفرَغتُ نَبلي كُلَّها في مَقتَلِ",0,"ل",1,0],["وَآلَيتِ أَن لا تَكتُبي فَفَجَعتِني","بِأَكبَرِ شَيءٍ مِنكِ كانَ يَكونُ",1,"ن",1,1],["واليتَ للخلقَِ ما أوليتَ من نعم","والى لك اللهُ ما أولى ووالاهُ",2,"ا",2,0],["واليتَ ما أوْليتَ يا بحر الندى","ووحقّ جودك ما رأيت كهذِهِ",3,"ذ",2,1],["واليت أمراضي عليَّ وليتني","أدري أحسنك ساخطٌ أم راضي",4,"ي",1,0],["واليْتُهم ما حالفتْ","أوعالُ شابةَ هضبَ شَابَهْ",5,"ب",2,0],["وإليَّ تحتاج الطبائع كلها","حتى يتمّ ومني الإصلاح",6,"ح",1,0],["وَآلَيتُ لا أَنسى بُلوغي بِكَ العُلا","عَلى كُرهِ شَتّاً مِن شُهودٍ وَغُيَّبِ",7,"ب",1,0],["وآليت لا آلوك شكرا على التي","غدت لي وسقا زيد فيه وُسوق",8,"ق",1,0],["وآليْتُ لا أُعطي الزّمانَ مَقادَةً","إلى مثلِ يحيَى ثمّ أُغضي على وَتْرِ",9,"ر",1,0],["وآليت أن لا أَستَكين لمن عتوا","وإن قطعوا بالسيف حبل وَريدي",10,"د",2,0],["وآلَيْتُ لا أنْسَى بُلُوغي بكَ العُلا","على كُرْهِ شَتّى مِن شُهُودٍ وَغُيَّبِ",11,"ب",1,0],["وَآلي تَستَقي مِنها بُحور","وَأَبحر مِن يُفاخر لَمع آل",12,"ل",1,0],["واليتُكُم كَيما أَكونَ عِندَكُم","تَحتَ لِواءِ الأَمنِ يَومَ الفَزَعِ",13,"ع",1,0],["وآليت لا أنفك أرعى وصالكم","إلى جنة الفردوس في أوج غرفة",14,"ه",1,0],["واليته بقبول الزور منك فلن","يوالي الله إلا من يعاديك",15,"ك",1,0],["واليتهم فخبرت غدر طباعهم","زمناً ولا ينبيك مثل خبير",16,"ر",1,0],["وأليّتي باللّه جلّ جلاله","وعليّ عهد ليس بالمكذوبِ",17,"ب",1,0],["واليتامى بين مفطوم على","ذلّة الجوع وأنضاء اعتلال",18,"ل",1,0],["وآليْتُ لا أعطيكَ قسْراً ظُلامةً","ولا طائِعاً ما قدَّمَتْ رجْلَها قَدَمْ",19,"م",1,1],["وآلَيتُ لا استَخْلصْتُ لي غيرَ صاحبٍ","حفيظٍ على سِرِّ الخليلِ أَمين",20,"ن",1,0],["وأَلِيّتي مهما نَبا بي مَنزِلٌ","لا مَسَّ رَحْلَ مَطِيّتي يَدُ واضع",21,"ع",1,0],["وآليتُ ألاّ أَرحتُ المَطِيْ","يَ حتّى أُصادِفَ في النّاسِ حُرّا",22,"ر",2,0],["وآليتُ لا زارتْ كريمةُ مِدْحتي","من النّاس إلاّ أكرَمَ الوزراء",23,"ا",2,0],["واليتامى والحريم رب فرجها قريبا","إنك الرب الكريم",24,"م",1,0],["والَيتُهُ وبَرِئْتُ مِنْ أَعْدائِهِ","إذ لاَ ولاء يكونُ مِن دُون البَرا",25,"ر",2,0],["وآليتَ ألا تضيعَ الوفاءَ","يميناً وألّا تخون الودادا",26,"د",2,0],["واليتها باديةً وعُوَّدا","كالسيل يرمي دُفَقاً فدُفَقا",27,"ق",2,0],["واليتامَى من دُرِّه في خليج","ضَيِّق ليس منه هذي البحورُ",28,"ر",1,0],["وآليتُ لا زارت جيادي وأينقي","فما كذبتْ إلاَّ المليكَ المعظّما",29,"م",2,0],["وآليت لا الوى العزيمة في الهوى","لغيرك في الأكوان فعل مصابر",30,"ر",1,0],["واليتُ والدَهم عليّاً فهو لي","مولىً ولا أحداً سواهُ أوالي",31,"ل",2,0],["وآليت لا أسلوه حتى أزوره","وإن قريباً كل ما هو آت",32,"ت",1,0],["وآليت لا أسلوه حتى يضمني","وإياه لحد في محل رفات",33,"ت",1,0],["وَآليتُ خَوفَ الشرِّ ألّا أُحبَّكمْ","وَتِلكَ لعَمْر اللَّهِ حِلفةُ حانثِ",34,"ث",1,0],["وآليتموا أن لا تخونوا عهودنا","وان بنتموا أو إن نكن عنكموا بنا",35,"ن",2,0],["واليتامى كفلتهم حيثُ كانوا","فنسوا أنهم من الأيتامِ",36,"م",1,0],["وإلى تعبث بالكرام","الغرّ أبناء البتول",37,"ل",1,0],["وَآليت أَني لا أَميل لِغادرٍ","وَلَو كانَ أَبهى مِن بُدور تَمام",38,"م",1,0],["وَإِلى تِلكَ قَد دُعيتَ لِتَحظى","بِالمُنى في جِنان برّ رَحيم",39,"م",1,0],["وَآليتُ أَنّي لا أَحومُ بِقُربِهِ","فَإِنّ الهَوى بِالقَهرِ مستعبِدُ الحرِّ",40,"ر",1,0],["وَالَيتُكم بدليل عقلٍ قاطعٍ","لا يعتريه الريب والأوهام",41,"م",1,0],["وأليتم أن تحفظا العهد دائما","فما بالكم لما انقضى الحول حلتم",42,"م",1,0],["وآليت لا آسى على هلك هالك","ولا فقد مال بعدك اليوم علقما",43,"م",2,0],["وَاليتنا لُطفاً بِأَحسَن مِنَّةٍ","مِن فَيضِ فضَلِ أَكفكَ البَيضاءِ",44,"ا",2,0],["وآليت لا أهدي إليك رسالة","إلى أن يحول الحول من رأس قابل",45,"ل",1,0],["وآليْتُ لا آلُوهُ نضْحَاً وعلُمهِ","ولائِيَ يَكْفِيني مُؤُونَةَ إِيلائي",46,"ي",1,0],["والَيْتُهُ ثُمَّ والَيْتُ الْمَديحُ لَهُ","فَاخْتارَ ما هُوَ أَوْلى بي فَأَولاني",47,"ن",2,0],["واليتُهُ بِبَراءِ مِنْ سِواه فقُلْ","ما شِئْتَ في حالِ سُنِّيٍّ لِشيعيِّ",48,"ي",1,0],["واليتاميى لما بكت أطربتهُ","فدهاها ليستزيد البكاء",49,"ا",2,0],["وآليتُ لولا مَلكُ لحمٍ محمد","لما كان ملك في الأنامِ لباب",50,"ب",1,0],["واليت من عاديت فيك وقابلت","منك الوجوه إليك وجها عابسا",51,"س",2,0],["وَآليتُ لا تنفكّ عيني حزينةً","عَليكَ وَلا ينفكّ جلدي أَغبرا",52,"ر",2,0],["واليت آل محمدٍ متعاهداً","لولائهم بنهاية استحفاظ",53,"ظ",1,0],["والَيْتُهُ ولمنْ يودُّ أودُّهُ","دهري وباغِضَهُ المُماذِقَ أُبغِضُ",54,"ض",1,0],["والى ترنسلفانيا طمحت بها ال","آمالُ والدهر العبوسُ تبسما",55,"م",2,0],["والَيتَ حَولاً مُغاراً في بِلادِهِمُ","وَلِلمَنايا سَحابٌ لَيسَ يَنقَطِعُ",56,"ع",1,0],["وَآلَيتُ أَن لَن يَغيبَ ضِيائي","وَدوني مَرامٌ لِمُستَحذِقِ",57,"ق",1,0],["وآليت لم تمرر بنا غير باخل","نذوق على ايديك شرّ بلاء",58,"ا",2,0],["واليت فيه معاشراً لولاهم","حبي له باد غدا وولائي",59,"ا",2,0],["واليتم صوح روضهُ والفقر قلَ","ص ظله وثرى الطوى لا يعشب",60,"ب",1,0],["وآليت لا تنفك تبتي مكارما","كمعطي ضمان في بناء المكارم",61,"م",1,0],["والَيْتُ آل أُمَيَّةَ الط","طُهُر الميامينِ الغُرَرْ",62,"ر",1,0],["والَيْتَ دولَته فتِهْتَ بدولةٍ","مُتَكلِّلٌ بِصَعيدِها الإكليلُ",63,"ل",1,0],["وَاليْتَ شعبك قبل عهد وَلائِهِ","وسبقته بالحب وهو يُبَادِرُ",64,"ر",1,0],["وآليتُ في حفظ الموالاةِ حلفةً","وإني صدوقٌ في الجهار وفي النحفا",65,"ف",2,0],["واليته فأراني","هواه فضل الولي",66,"ي",1,0],["واليتَ آل المصطفى آملا","من فضلهم فضلَ الإله السميع",67,"ع",1,0],["وآليتُ لا آتي الطُّلولَ على البُكا",".مخافةَ قولِ العاذلين على الشّْعرِ",68,"ر",1,1],["والى تبيه بالله ياخلى سوه","لاشفت شمس الليل بنسي جروح امس",69,"س",1,0],["وَآلَيْتُ أَنْ أَضْوِي شُمُوعَ مَسَرَّتِي","كَمَنْ لَمْلَمَ الأَقْمَارَ حِضْناً وَأَصْحَابَا",70,"ب",2,0],["وإلى تختلف احليقة","فيك ابراما وحلا",71,"ل",2,0],["واليتُ عشقكِ حيث الآن يحضنني","وأنت كلُّ عذولِ العشقِ واليتِ",72,"ت",1,0],["وَالَيْتَ قَوْمًا بَغَوا بَعْدي وَمَا رَحِموا","أَهْلِي فَجَمْعُهُمُ بِالطَّفِّ مَفْلولُ",73,"ل",1,0],["والي تبيه استغفر الله مايجي ملعون خد","ابرق وزلزل بالرعد مضمي ولا يتليه ري",74,"ي",1,0],["وآليت لا أبنىي على سكك الدجى","قصورىي وأن تبقى البرايا ورائيا",75,"ي",2,0]]}