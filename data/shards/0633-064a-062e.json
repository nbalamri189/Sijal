{"poems":[[65,"يا طرة الشيح بسفح عاقل","https://www.aldiwan.net/poem46162.html","الرجز"],[75,"أما علمت أن الشفيع شباب","https://www.aldiwan.net/poem11916.html","الطويل"],[95,"عزمات نحاس إذا جاورتها","https://www.aldiwan.net/poem11354.html","الكامل"],[29,"ألا حي ربع المنزل المتقادم","https://www.aldiwan.net/poem4453.html","الطويل"],[29,"سيخزى إذا ضنت حلائب مالك","https://www.aldiwan.net/poem5917.html","الطويل"],[29,"لقد نادى أميرك باحتمال","https://www.aldiwan.net/poem5957.html","الوافر"],[29,"ألا حي بالبردين دارا ولا أرى","https://www.aldiwan.net/poem6020.html","الطويل"],[52,"أصفراء ما في العيش بعدك مرغب","https://www.aldiwan.net/poem64815.html","الطويل"],[48,"لقد كرمت عليك فتاة قوم","https://www.aldiwan.net/poem23402.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85368","الطويل"],[101,"سؤال","https://www.poetsgate.com/ViewPoem.aspx?id=7380",""],[275,"حذار فأحداق الملاح حبوب","https://www.aldiwan.net/poem35457.html","الطويل"],[422,"ألا من مبلغ عني نقيبا","https://www.aldiwan.net/poem53906.html","الوافر"],[470,"وحدك الصوت","https://www.aldiwan.net/poem36434.html","عموديه"],[511,"خليلي أبا بكر فهل ثم حيلة","https://www.aldiwan.net/poem2458.html","الطويل"],[558,"بلاءك إني غير مستعب الرضى","https://www.aldiwan.net/poem68395.html","الطويل"],[580,"تقنعت لكن بالحبيب المعمم","https://www.aldiwan.net/poem3018.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122751","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48759","المتقارب"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48808","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48741","البسيط"],[833,"","https://poetry.dctabudhabi.ae/diwan/poem/198795","المتقارب"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138069",""],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111172","المتدارك"],[1287,"","https://poetry.dctabudhabi.ae/diwan/poem/198578","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89532","الطويل"],[2241,"","https://poetry.dctabudhabi.ae/diwan/poem/10465","الوافر"],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131724",""],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89406","الوافر"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125938","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205757","البسيط"],[4011,"","https://poetry.dctabudhabi.ae/diwan/poem/45531","الطويل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119485","الطويل"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147303","الكامل"],[5081,"ثَلَّاجَةُ السِّيسِي !","https://www.poetsgate.com/ViewPoem.aspx?id=190181",""],[5121,"الْمِنْهَاجُ","https://www.poetsgate.com/ViewPoem.aspx?id=34716",""],[5174,"لغة الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=185110",""],[5268,"أميم","https://www.poetsgate.com/ViewPoem.aspx?id=207019",""],[5431,"عجلتُ إليك يا طفلا بقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=191290",""],[5431,"سينقذنا همامٌ عنتريٌ ولا يخشى لعولمةٍ شِراكا","https://www.poetsgate.com/ViewPoem.aspx?id=201631",""],[5431,"فالق الشعر ...","https://www.poetsgate.com/ViewPoem.aspx?id=202794",""],[5431,"الله حقٌ لااحتمالُ ....","https://www.poetsgate.com/ViewPoem.aspx?id=205458",""],[5431,"رفاق الجنّ...","https://www.poetsgate.com/ViewPoem.aspx?id=214964",""],[5457,"غيوم اليأس","https://www.poetsgate.com/ViewPoem.aspx?id=213409",""],[5791,"وجعٌ مدلل ..!","https://www.poetsgate.com/ViewPoem.aspx?id=208074",""],[5956,"إذا لم يزُرْني","https://www.poetsgate.com/ViewPoem.aspx?id=182018",""],[5956,"الغجرية سارقة الطفل *","https://www.poetsgate.com/ViewPoem.aspx?id=184538",""],[5997,"المنصور اليماني","https://www.poetsgate.com/ViewPoem.aspx?id=215047",""],[6093,"حَبْرُ المدينةِ","https://www.poetsgate.com/ViewPoem.aspx?id=199237",""],[6125,"تُرَاوِدُنِي المَهَالِكُ والحُتُوفُ","https://www.poetsgate.com/ViewPoem.aspx?id=212877",""],[5080,"إلى لحظتيكَ يحجّ السراب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88130&r=&rc=0",""]],"verses":[["سيَخْطِرُ الآبي على شَكيمِهِ","منْ زُبَرِ الحَديدِ في الخَلاخِلِ",0,"ل",1,0],["سَيَخلُدُ في الدُنيا بِهِ لَكَ مَفخَرٌ","وَيَحسُنُ في دارِ الخُلودِ مَآبُ",1,"ب",1,0],["سَيُخَلِّدُ التَّارِيخُ مَجْدَ كِفَاحِكُمْ","وَلَهُ عَلَى مُرِّ الدُّهُورِ دَوَامُ",2,"م",1,0],["سَيُخبَرُ ما أَبلَت سُيوفُ مُجاشِعٍ","ذَوي الحاجِ وَالمُستَعمَلاتِ الرَواسِمِ",3,"م",1,0],["سَيَخزى إِذا ضَنَّت حَلائِبُ مالِكٍ","ثُوَيرٌ وَيَخزى عاصِمٌ وَجَميعُ",4,"ع",1,1],["سَيُخزيكَ الخَليفَةُ ثُمَّ تَخزى","بِعِزَّةِ ذي التَكَرُّمِ وَالجَلالِ",5,"ل",1,0],["سَيَخزى وَيَرضى بِاللَفاءِ ابنِ فَرتَنى","وَكانَت غَداةَ الغِبِّ يوفي غَريمُها",6,"م",3,0],["سَيُخبِرُ عَن رَوحٍ ثَنائي وَفِعلُهُ","وَما مِنهُما إِلّا رِضىً لا يُكَذِّبُ",7,"ب",1,0],["سَيُخفِتُ كُلَّ صَوتٍ زَأرُ لَيثٍ","وَنَبأَةُ باغِمٍ وَهَديرُ قَرمِ",8,"م",1,0],["سيخفق في الأمر الَّذين تعجّلوا","وَيأَكل أَهل الصبر من ثمر الصبرِ",9,"ر",1,0],["سيخسرنا الحرجُ والحاطبون","وتكسدُ في الأرض أخشابُنا",10,"ن",2,0],["سيخضعُ هذا القلبُ بعدَ تمرُّدٍ","ومن حَولِهِ بعدَ الجنانِ لهيب",11,"ب",1,0],["سيخطبُ في مدائحه قصيدي","كما خَطَبَ الحَمام على الغصون",12,"ن",1,0],["سَيُخَط ُّ التَّاريخُ بالدَّم ِحَتى","تَقشَعِرَّ الأقلامُ والأوراقُ !",13,"ق",1,0],["سَيُخبِرُكَ السُّلوَانُ أَنِّي رُمتُهُ","فَحال اشتِيَاقِي دُونَهُ وَنُزُوعِي",14,"ع",2,0],["سَيَخلُفُنا فيكَ الثَناءُ إِذا رَمى","بِنا غِبُّهُ وَالنَأيُ واسِطَةُ الرَحلِ",15,"ل",1,0],["سَيخْدُمُ مِنك الشمسَ مني عُطَارِدٌ","ويُبْدي كلامِي في سَمائِكَ أَنْجُمِي",16,"م",2,0],["سَيَخرِقُ بي ظَلامَ اللَّيلِ عَودٌ","يَرُوحُ كَأنَّهُ فيهِ ظَليمُ",17,"م",1,0],["سيخلف عهدك عهداً لهم","مضى بعقائده الباليه",18,"ي",2,0],["سيخرج من كل المدائن جنده","وما هو مطرود وما أنت طارد",19,"د",1,0],["سيخرجون كرام الصنع فيه وما","كانوا عليه بغاة حينما دخلوا",20,"ل",3,0],["سيخبر عن سحر تلك العيون","ويغبطه الملأ الأيمن",21,"ن",1,0],["سيخلد في شعري جمالك آمنا","خلود الرسوم في صحائف راسم",22,"م",1,0],["سيخاصم من عاداه غداً","بقوي خصام لم يدحض",23,"ض",1,0],["سيخطب قس العزم في منبر السرى","وهذي الدنى مني إذاً ستُطلَّقُ",24,"ق",1,1],["سَيخسَرُ في الدُنيا وَفي الدين سَعيُهُ","وَعَمّا قَريبٍ يَجتَوي الوِردَ ناهِلُه",25,"ل",2,0],["سَيُخبِرُ أَهلَ وَجٍّ مَن كَتَمتُم","وَتَذمي مَن أَلَمَّ بِها القُبورُ",26,"ر",1,0],["سيخ له باس شديد","مدح الآله فلا مزيد",27,"د",1,1],["سيخزيهم وينصركم عليهم","ويشف صدور قوم مؤمنينا",28,"ن",2,0],["سيخضل منك الزرع بعد مماته","ويخصب ظهر الأرض في كل صحراء",29,"ا",2,0],["سيخلد اللؤم في الدهر اللئيم وإن","أذله أهله لؤمًا وملُّوه",30,"ه",1,0],["سيخبر عن أيامنا وبلائنا","وشداتنا في الحرب حدج وحندج",31,"ج",1,0],["سيخلف جفني مخلفات الغمائم","على ما مضى من عمري المتقادم",32,"م",1,1],["سيخوننا التعريف والتنكيرُ","ونمور في وسط الخضم نمورُ",33,"ر",1,1],["سَيُخَلِّدُ التَّارِيخُ قَوْلَةَ كَاذِبٍ","سَاقَ النِّعَاجَ بِخِسَّةٍ وَسَمَاجَةْ",34,"ه",1,1],["سَيَخْنُسُ مَنْ فِي الأَرْضِ حَتْماً وَيَنْمَحِي","وَيَبْقَى بِعَرْشِ اللهِ رَبٌّ لِيَصْنَعَا",35,"ع",2,0],["سيخوض الحرب حبرا قلمي","لا يهاب الموت لا يخشى الخطر",36,"ر",1,0],["سَيختالُ عُودُكِ يا الأراكُ بناظري","وحَسبُ دمي ياعودُ أنَّكَ شَارِدُ",37,"د",1,0],["سيخبرك الحنين بألف وجد","ويرقص حول من تهواه شمسي",38,"س",2,0],["سيخبرك الوراء بأنّ قلبا","جليل القدر للمعنى اصطفاكا",39,"ك",2,0],["سيخلقُ هذا الجيل للضوء معجما","إلى كلّ شطْحات السناء يُسابقُ",40,"ق",1,0],["سيخبرهم مسار الكون يوما","بأنّ الله حقٌ لااحتمالُ",41,"ل",1,0],["سيخبرك السحاب بناطحاتٍ","ومن كانوا (بلا وزنٍ) فراغه",42,"غ",2,0],["سيخرقُ غيمتي ضوءٌ جميلٌ","فإنَّ الصبرَ يعقُبُ نعيمُ",43,"م",1,0],["سيختمُ كلَّ ذاكرةٍ سؤالٌ","متى يا طينَ لعنتنا .. سنرحلْ",44,"ل",1,0],["سيخبو صبانا ولم نتلذّذ","ببعضٍ، فَجُلُّ المعيشة آهُ",45,"ا",2,0],["سيخلّد التاريخُ شخصاً منقذاً","يُدْعَى السميحَ بْنَ الرؤوفِ الرَّيِّسِ",46,"س",1,0],["سيخرجُ شخصٌ بليغُ الصّدى","بعلمِ الكتابِ عريق النسبْ",47,"ب",1,0],["سيُخَفِّفُ الرُّبُّانُ مِنْ","أحْمالِها يرجُو النَّجاةْ",48,"ا",2,0],["سَيَخْلُدُ في بُطُونِ الأرضِ قَومٌ","ويَبْدُو مِنْ لُحُودِهمُ رَجِيفُ",49,"ف",1,0],["سيَخمدُ بُركانك الظامئونْ","وتَنبتُ سُنبلة الاكتئابْ",50,"ب",1,0]]}