رضِ رَسا",2,"ا",1,0],["مِنْ دَوحةٍ بَسَقَتْ لا الفَرْعُ مؤْتَشَبٌ","مِنها ولا عِرقُها في الحَيِّ مَدخولُ",3,"ل",1,0],["مِن دونِ نَفسي أَقفالٌ لِحُبِّكُمُ","وَأَنتُمُ لِيَ أَسبابُ المَفاتيحِ",4,"ح",1,0],["منْ دوْحَةِ الأزْدِ حيثُ الحَيُّ منْ يمَنٍ","بشَطِّ غسّانَ مِنْ بعْدِ السُرَى نزَلا",5,"ل",2,0],["مَنْ دانَ بالإخْلاصِ فيكَ فعَقْدُهُ","لا يَقْبَلُ التّمويهَ والتّلْبيسا",6,"س",2,0],["مِن دِيارٍ بِالهَضبِ هَضبِ القَليبِ","فاضَ ماءُ الشُؤونِ فَيضَ الغُروبِ",7,"ب",1,1],["مِن دَوحَةٍ شَرُفَت أَعراقُها وَزَكت","مِنها الفُروعُ وَطابَت مغرِساً وَثَرى",8,"ر",2,0],["مِن دَوحَةٍ فَخرِيَّةٍ عُمَرِيَّةٍ","طابَت مَغارِسُ مَجدِها المُتَأَثِّلِ",9,"ل",1,0],["مَنْ دَعَاهُ فِيهِ الصَّوابُ فَلَبَّى","عَزَّ حِزْباً وَكَانَ للهِ حِزْبَا",10,"ب",2,0],["مِنْ دَوْحَةٍ مَيْمُونَةٍ","خَضْرَاءَ فِي كُلِّ الفُصُولِ",11,"ل",1,0],["مِن دِمنَة نَسَفَت عَنها الصَبا سُفَعا","كَما تُنَشَّرُ بَعدَ الطَيَّةِ الكُتُبُ",12,"ب",1,0],["من دوحة نصرية يمنيةٍ","وَشَجَتْ فروعاً في العلا وأصولا",13,"ل",2,0],["منداحةُ الأرجاء عاليةُ الذرى","فكأنها في الوهد شمُّ جبَالِ",14,"ل",1,0],["مِن دُرَّةٍ أَغلى المُلوكُ بِها","مِمّا تَرَبَّبَ حائِرُ البَحرِ",15,"ر",1,0],["مِن دونِ بُصرى وَخَلفَها جَبَلُ الثَل","جِ عَلَيهِ السَحابُ كَالقِدَدِ",16,"د",1,0],["منديل بعض الناس كاس مكارمٍ","يعطيك ملآناً ويأخذ فارغا",17,"غ",2,0],["مَن دعاني إلى الذي كان مني","فهو مثلي جَلِيَّةً لا امتراءَ",18,"ا",2,0],["من دونها بحفظها بل مُرتجا","ماذا يعوق مدحتي أن تُنْسَجا",19,"ج",2,0],["مِن دونِ ما قد سُمْتَنِي نسكَ الهوى","وغدا الصِّبا ولَبُوسه أمساحُه",20,"ح",2,0],["من دبيبٍ أنت مضرو","بٌ له طوراً وراهز",21,"ز",1,0],["من دفعةٍ تتبعها جذبةٌ","وجذبةٍ تتبعها دفعه",22,"ع",2,0],["من دَنّس العِرضَ بالمواعد وال","خلفِ جعلتُ الهجاء صابونا",23,"ن",2,0],["مَن دَنا أَو نَأى فَإِنَّ المَنايا","غايَةُ القُربِ أَو قُصارى البِعادِ",24,"د",1,0],["مِن دارِ تَوأَمِهِ وَصِنوِ حَياتِهِ","وَالأَوَّلِ المَألوفِ مِن أَترابِه",25,"ب",2,0],["مُندَفِعاتٌ عَلى","مُختَلِفاتِ النَغَم",26,"م",1,0],["من دوحةِ العلياء حيثُ نَبَا","عن صفحتيها القادِحُ العَمِلُ",27,"ل",1,0],["مِن دارِمٍ حينَ صارَ الأَمرُ وَاِشتَبَهَت","مَصادِرُ الناسِ في رَجّافَةِ الكُرَبِ",28,"ب",1,0],["من دَوحةٍ طالَ فَرعُها ورسَت","أصولُها واسُتِلذَّ مَجنَاها",29,"ا",3,0],["مَن دَخَلَ الجَنَّةَ نالَ الرِضى","مِمّا تَمَنّى وَاِستَطابَ المَقيل",30,"ل",1,0],["مَن دَبَّرَ العَيشَ بِالآراءِ دامَ لَهُ","صَفواً وَجاءَ إِلَيهِ الخَطبُ مُعتَذِرا",31,"ر",2,0],["مُندّى الأَماني في مَراتِعِ رَبعِهِ","وَمستمطَرُ الجَدوى ومنتجعِ الوَفدِ",32,"د",1,0],["مِن دَوحَةِ الكَلِمِ الَّتي لَم تَنفَكِك","يُمسي عَلَيكَ رَصينُها مَحبوسا",33,"س",2,0],["من دأبِهِ سراً هنا أصحابه","ويقول قد ظهرتْ جيوشُ المغربِ",34,"ب",1,0],["مِنْ دُنُوٍّ وَشُهُودٍ وَسِرٍّ","بانَ عنه كلُّ وَاشٍ وَغابا",35,"ب",2,0],["مُندّي الجبهةِ من بعد أن","أفلتّ منه صفدي الأذنِ",36,"ن",1,0],["من دون كلّ دثارِ","يقلُّ عنك اصطباري",37,"ي",1,0],["مِن دُونِها الجُسورُ وَالجُسورُ","وَخَندقٌ أَخضرُ مُستَديرُ",38,"ر",1,0],["مِن دُونِهِ الحِجابُ وَالسُتورُ","وَقَد يُضيعُ الحاجَةَ المَأمورُ",38,"ر",1,0],["مِن داخِلِ الشَوقِ الدَخيلِ إِلى الَّتي","فيها تَروحُ لِعَينِهِ العَبَراتُ",39,"ت",1,0],["مِن دِيارٍ قَد جاءَها القادِمُ الآ","تي فَلَم يَعتَبِر بِمَنصَرِفيها",40,"ي",3,0],["من درس التاريخ أو من درسه","يمضي الزمان وهما في المدرسه",41,"ه",1,0],["مَنْ دعَاهُ بِشارَةً","لَمَحَ الْغَيْبَ وَاسْتَشَفْ",42,"ف",1,0],["مَنْ دَعَاهَا عَادِلاً أَوْ ظَالِماً","لِلمُرُوءَاتِ دَعَا مُبْتَدِرَا",43,"ر",2,0],["مَنْ دَعَا اللهَ عَلَى غَاصِبِهِ","فَالدُّعَاءُ السَّيفُ وَالذِكْرُ القَنَاةُ",44,"ه",1,0],["من دمع بائسكم وقوت فقيركم","تجبى ضرائب ظلمها ومكوسها",45,"س",3,0],["مَن دَحا البَسيطَةَ مَن","حاطَها بِأَبحُرِها",46,"ر",3,0],["من دنس الأدران","لا ضرع ولا وان",47,"ن",1,0],["من دون ذاك الإمكان","فالطّلّ رشح البحران",47,"ن",1,0],["مَنْ دنا منّي؟ وكالطيف التوى","ونأى، خلف خيالات التنائي",48,"ا",2,0],["من درى كيف أطبقت مقلتيها","ورمى اللّيل حلمها في مضيعه ؟",49,"ع",2,0],["من دهور وأنت سحر' العبارة","وانتظار المنى وحلم' الإشارة",50,"ر",2,1],["من داخل الشوق الدخليل إلى","التي فِيهَا تَرُوحُ لِعَيْنِهِ الْعبَرَاتُ",51,"ت",1,0],["من دموع مازجت أد","معها بين يديها",52,"ي",3,0],["من دُعاة المألوفِ ما دام فيه","مظهرٌ لائقٌ بشَعبٍ أنوف",53,"ف",1,0],["من دلعها؟ لاتحفتك.؟ كنها.؟ تشتكي","ومن ثقلها.؟ لو يثورن. تبقا هاديه",54,"د",3,0],["من دورة الأيام ياخوك مخنوق","الوقت مشاني من السلك للسلك",55,"ك",1,0],["منْ ديارٍ بالهضبِ القليبِ","فاضَ ماءُ الشّؤونِ فَيْضَ الغُروُبِ",56,"ب",1,1],["من دنا منسّي ؟ وكالطيف النوى","ونأى ، خلف خيالات التنائى",57,"ا",2,0],["مِن دَوحَة بِثِمار الفَضل يانِعَةٍ","وَرَوضة قَد تَولى سَقيِها الكَرَم",58,"م",1,0],["من دنياكِ تخلصْ من قَذَى أقذارِها","لا ترغبنْ بها وخالفْ شهوة",59,"ه",1,0],["من دون سفكِ مدامعى ما شئت من","حِلْم ودون دمىِ تغولك غولُ",60,"ل",1,0],["من دنا منها دنت منه المنى","فلنا إن ندن منها ما اشتهينا",61,"ن",2,0],["من دمه أجراه طغيانه","فما به اثم ولا هندمه",62,"م",2,0],["من دَنا منك فمعذورٌ إذا","أدركتْه عزةُ المُعْتَجِب",63,"ب",1,0],["من دنا منك فقارت","ه ومن صد فخيره",64,"ر",2,0],["مِن دِيارٍ غَشيتُها ذُكرَةً ما","بَينَ قاراتِ ضاحِكٍ فَالهَزيمِ",65,"م",1,0],["من درّك الغالي وغالي","الدر يهدى للأماجد",66,"د",1,0],["من دعاه النبي خدْناً وسمَّا","ه أخاً في الخفاء والإظهار",67,"ر",1,0],["من دون موماة الفراة وبابل","والقادسية والعذيب ومربخ",68,"خ",1,0],["مِن دونِ قُربِكَ لِلذوابِلِ مَشرَعٌ","وَالبيضُ وُردٌ وَالجِيادُ صَهيلُ",69,"ل",1,0],["مَن دَلَّ ذاكَ الطَرفَ لَمّا رَنا","أَنَّ فُؤادي عَرضٌ لِلسِهام",70,"م",1,0],["مَن دَنَت مِنهُ فُرصَةٌ","فَرَأى فَوتَها غَبِن",71,"ن",1,0],["مِن دونِها شَوكٌ كَأَط","رافِ الرِماحِ الذُبَّلِ",72,"ل",1,0],["مِن دونِ مَنهَلِ ثَغرِهِ مَطرورَةٌ","مِن طَرفِهِ تُحمى بِها رَشَفاتُهُ",73,"ت",2,0],["مِن دونِ ما تَبغي عِقا","بٌ في تَوَقُّلِها عِقابُ",74,"ب",1,0],["مِنْ دَرْسِهِ النَّظْمُ الذِي صَاغَهُ","نَجْلُ التِّلِمْسَانِي فِي صَنْعَتِهِ",75,"ت",2,0],["من دُوارٍ، من جُنوحٍ","أدركيني، ساعديني",76,"ن",2,0],["من دونها أوج السماكين في","سما العلا الرامح والأعزل",77,"ل",1,0],["من دمعكنَّ أخذتُ شعرَ قَصيدتي","وحديثُكنَّ أخذتهُ تَلحينا",78,"ن",2,0],["من دَمعِنا قد سقيناها ومِن دَمِنا","ففي ثراها حشاشاتٌ تشاكينا",79,"ن",2,0],["من دوحة نبوية علوية","في اصلها الزَهراء وَ