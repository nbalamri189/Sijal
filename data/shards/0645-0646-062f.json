{"poems":[[53,"أحق من كانت النعماء سابغة","https://www.aldiwan.net/poem29814.html","البسيط"],[53,"بعض الملام فقد غضضت طماحي","https://www.aldiwan.net/poem30652.html","الكامل"],[63,"واها لأيامي بأكناف اللوى","https://www.aldiwan.net/poem46135.html","الرجز"],[63,"خاض الدجى ورواق الليل مسدولب","https://www.aldiwan.net/poem46219.html","البسيط"],[55,"قد كنت أشكو هوى نفسي وأظهره","https://www.aldiwan.net/poem26433.html","البسيط"],[77,"عهد الشباب سقى أيامك الأولا","https://www.aldiwan.net/poem35728.html","البسيط"],[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[9,"من ديار بالهضب هضب القليب","https://www.aldiwan.net/poem21913.html","الخفيف"],[71,"عجبت للطيف يا لمياء حين سرى","https://www.aldiwan.net/poem4012.html","البسيط"],[71,"ريح الشمال عساك أن تتحملي","https://www.aldiwan.net/poem4013.html","الكامل"],[93,"مصر تهدي إلى بنيها السلاما","https://www.aldiwan.net/poem11323.html","الخفيف"],[93,"من مبلغ علياء إبرا","https://www.aldiwan.net/poem11477.html","مجزوء الكامل"],[30,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[83,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[83,"ما للحمول تحن للأطلال","https://www.aldiwan.net/poem54250.html","الكامل"],[23,"إن النضيرة ربة الخدر","https://www.aldiwan.net/poem21240.html","الكامل"],[23,"أنظر خليلي ببطن جلق هل","https://www.aldiwan.net/poem21402.html","المنسرح"],[72,"شكرا لها من أنعم سعدية","https://www.aldiwan.net/poem19256.html","الكامل"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"من ذا رأت عيناه مثلي في الشجا","https://www.aldiwan.net/poem9239.html","الرجز"],[51,"الحب ريحان المحب وراحه","https://www.aldiwan.net/poem9398.html","الكامل"],[51,"لا تسقرط يا أبا يحيى","https://www.aldiwan.net/poem64536.html","مجزوء الرمل"],[51,"بدعة عندي كاسمها بدعه","https://www.aldiwan.net/poem65395.html","السريع"],[51,"قل لفتى لم يزل بصورته","https://www.aldiwan.net/poem66450.html","المنسرح"],[85,"كل حي على المنية غادي","https://www.aldiwan.net/poem62901.html","الخفيف"],[85,"أرأيت زين العابدين مجهزا","https://www.aldiwan.net/poem62921.html","الكامل"],[85,"طال عليها القدم","https://www.aldiwan.net/poem63695.html","مجزوء السريع"],[62,"في راحتيك الرزق والأجل","https://www.aldiwan.net/poem52318.html","أحذ الكامل"],[28,"أنا ابن ضبة فرع غير مؤتشب","https://www.aldiwan.net/poem1257.html",""],[61,"هويتها والفراق يهواها","https://www.aldiwan.net/poem51406.html","المنسرح"],[49,"أصبح هذا الناس قالا وقيل","https://www.aldiwan.net/poem63055.html","السريع"],[66,"لا يمتطي المجد من لم يركب الخطرا","https://www.aldiwan.net/poem41548.html","البسيط"],[80,"أمسك الصبا أهدت إلي صبا نجد","https://www.aldiwan.net/poem31482.html","الطويل"],[44,"أقشيب ربعهم أراك دريسا","https://www.aldiwan.net/poem30481.html","الكامل"],[69,"يا أهل مصر هكذا وليتم","https://www.aldiwan.net/poem29137.html","الكامل"],[67,"أزمعوا البين وشدوا الركابا","https://www.aldiwan.net/poem18030.html","المديد"],[48,"أصبح أيري معرضا عني","https://www.aldiwan.net/poem66284.html","السريع"],[48,"يا غاسل الطرجهارِ","https://www.aldiwan.net/poem66568.html","المتقارب"],[50,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[50,"من أبي هشام يا رجال قصيدة","https://www.aldiwan.net/poem64740.html","الكامل"],[46,"كيف يصفو المقيم في أم دفر","https://www.aldiwan.net/poem23583.html","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202529","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55035","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54850","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54658","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142037","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[72,"وهارب من رضوان","https://www.poetsgate.com/ViewPoem.aspx?id=45465",""],[100,"ابن السبيل","https://www.poetsgate.com/ViewPoem.aspx?id=50328",""],[100,"من ذا هنا","https://www.poetsgate.com/ViewPoem.aspx?id=50178",""],[100,"مدينة الغد","https://www.poetsgate.com/ViewPoem.aspx?id=24212",""],[50,"مِنْ أَبِي هِشَامٍ يَا رِجَالُ قَصِيدَة ٌ","https://www.poetsgate.com/ViewPoem.aspx?id=19980",""],[96,"إليها","https://www.poetsgate.com/ViewPoem.aspx?id=17491",""],[90,"بشرى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179106",""],[9,"منْ ديارٍ بالهضبِ القليبِ","https://www.poetsgate.com/ViewPoem.aspx?id=20021",""]],"verses":[["مِن دَومَةٍ بِجِبالِ الغَورِ حامِلَةٍ","حَقائِبَ المَوتِ لِلأَعداءِ وَالنِقَمِ",0,"م",1,0],["مِن دونِ قودِ الجُردِ تَمري جَريها","رَبَلاتُ كُلِّ مُغامِرٍ جَحجاحِ",1,"ح",1,0],["منْ دَوْحَةٍ نالَ السّماءَ فَرْعُها","وأصْلُها في سُرّةِ الأرضِ رَسا",2,"ا",1,0],["مِنْ دَوحةٍ بَسَقَتْ لا الفَرْعُ مؤْتَشَبٌ","مِنها ولا عِرقُها في الحَيِّ مَدخولُ",3,"ل",1,0],["مِن دونِ نَفسي أَقفالٌ لِحُبِّكُمُ","وَأَنتُمُ لِيَ أَسبابُ المَفاتيحِ",4,"ح",1,0],["منْ دوْحَةِ الأزْدِ حيثُ الحَيُّ منْ يمَنٍ","بشَطِّ غسّانَ مِنْ بعْدِ السُرَى نزَلا",5,"ل",2,0],["مَنْ دانَ بالإخْلاصِ فيكَ فعَقْدُهُ","لا يَقْبَلُ التّمويهَ والتّلْبيسا",6,"س",2,0],["مِن دِيارٍ بِالهَضبِ هَضبِ القَليبِ","فاضَ ماءُ الشُؤونِ فَيضَ الغُروبِ",7,"ب",1,1],["مِن دَوحَةٍ شَرُفَت أَعراقُها وَزَكت","مِنها الفُروعُ وَطابَت مغرِساً وَثَرى",8,"ر",2,0],["مِن دَوحَةٍ فَخرِيَّةٍ عُمَرِيَّةٍ","طابَت مَغارِسُ مَجدِها المُتَأَثِّلِ",9,"ل",1,0],["مَنْ دَعَاهُ فِيهِ الصَّوابُ فَلَبَّى","عَزَّ حِزْباً وَكَانَ للهِ حِزْبَا",10,"ب",2,0],["مِنْ دَوْحَةٍ مَيْمُونَةٍ","خَضْرَاءَ فِي كُلِّ الفُصُولِ",11,"ل",1,0],["مِن دِمنَة نَسَفَت عَنها الصَبا سُفَعا","كَما تُنَشَّرُ بَعدَ الطَيَّةِ الكُتُبُ",12,"ب",1,0],["من دوحة نصرية يمنيةٍ","وَشَجَتْ فروعاً في العلا وأصولا",13,"ل",2,0],["منداحةُ الأرجاء عاليةُ الذرى","فكأنها في الوهد شمُّ جبَالِ",14,"ل",1,0],["مِن دُرَّةٍ أَغلى المُلوكُ بِها","مِمّا تَرَبَّبَ حائِرُ البَحرِ",15,"ر",1,0],["مِن دونِ بُصرى وَخَلفَها جَبَلُ الثَل","جِ عَلَيهِ السَحابُ كَالقِدَدِ",16,"د",1,0],["منديل بعض الناس كاس مكارمٍ","يعطيك ملآناً ويأخذ فارغا",17,"غ",2,0],["مَن دعاني إلى الذي كان مني","فهو مثلي جَلِيَّةً لا امتراءَ",18,"ا",2,0],["من دونها بحفظها بل مُرتجا","ماذا يعوق مدحتي أن تُنْسَجا",19,"ج",2,0],["مِن دونِ ما قد سُمْتَنِي نسكَ الهوى","وغدا الصِّبا ولَبُوسه أمساحُه",20,"ح",2,0],["من دبيبٍ أنت مضرو","بٌ له طوراً وراهز",21,"ز",1,0],["من دفعةٍ تتبعها جذبةٌ","وجذبةٍ تتبعها دفعه",22,"ع",2,0],["من دَنّس العِرضَ بالمواعد وال","خلفِ جعلتُ الهجاء صابونا",23,"ن",2,0],["مَن دَنا أَو نَأى فَإِنَّ المَنايا","غايَةُ القُربِ أَو قُصارى البِعادِ",24,"د",1,0],["مِن دارِ تَوأَمِهِ وَصِنوِ حَياتِهِ","وَالأَوَّلِ المَألوفِ مِن أَترابِه",25,"ب",2,0],["مُندَفِعاتٌ عَلى","مُختَلِفاتِ النَغَم",26,"م",1,0],["من دوحةِ العلياء حيثُ نَبَا","عن صفحتيها القادِحُ العَمِلُ",27,"ل",1,0],["مِن دارِمٍ حينَ صارَ الأَمرُ وَاِشتَبَهَت","مَصادِرُ الناسِ في رَجّافَةِ الكُرَبِ",28,"ب",1,0],["من دَوحةٍ طالَ فَرعُها ورسَت","أصولُها واسُتِلذَّ مَجنَاها",29,"ا",3,0],["مَن دَخَلَ الجَنَّةَ نالَ الرِضى","مِمّا تَمَنّى وَاِستَطابَ المَقيل",30,"ل",1,0],["مَن دَبَّرَ العَيشَ بِالآراءِ دامَ لَهُ","صَفواً وَجاءَ إِلَيهِ الخَطبُ مُعتَذِرا",31,"ر",2,0],["مُندّى الأَماني في مَراتِعِ رَبعِهِ","وَمستمطَرُ الجَدوى ومنتجعِ الوَفدِ",32,"د",1,0],["مِن دَوحَةِ الكَلِمِ الَّتي لَم تَنفَكِك","يُمسي عَلَيكَ رَصينُها مَحبوسا",33,"س",2,0],["من دأبِهِ سراً هنا أصحابه","ويقول قد ظهرتْ جيوشُ المغربِ",34,"ب",1,0],["مِنْ دُنُوٍّ وَشُهُودٍ وَسِرٍّ","بانَ عنه كلُّ وَاشٍ وَغابا",35,"ب",2,0],["مُندّي الجبهةِ من بعد أن","أفلتّ منه صفدي الأذنِ",36,"ن",1,0],["من دون كلّ دثارِ","يقلُّ عنك اصطباري",37,"ي",1,0],["مِن دُونِها الجُسورُ وَالجُسورُ","وَخَندقٌ أَخضرُ مُستَديرُ",38,"ر",1,0],["مِن دُونِهِ الحِجابُ وَالسُتورُ","وَقَد يُضيعُ الحاجَةَ المَأمورُ",38,"ر",1,0],["مِن داخِلِ الشَوقِ الدَخيلِ إِلى الَّتي","فيها تَروحُ لِعَينِهِ العَبَراتُ",39,"ت",1,0],["مِن دِيارٍ قَد جاءَها القادِمُ الآ","تي فَلَم يَعتَبِر بِمَنصَرِفيها",40,"ي",3,0],["من درس التاريخ أو من درسه","يمضي الزمان وهما في المدرسه",41,"ه",1,0],["مَنْ دعَاهُ بِشارَةً","لَمَحَ الْغَيْبَ وَاسْتَشَفْ",42,"ف",1,0],["مَنْ دَعَاهَا عَادِلاً أَوْ ظَالِماً","لِلمُرُوءَاتِ دَعَا مُبْتَدِرَا",43,"ر",2,0],["مَنْ دَعَا اللهَ عَلَى غَاصِبِهِ","فَالدُّعَاءُ السَّيفُ وَالذِكْرُ القَنَاةُ",44,"ه",1,0],["من دمع بائسكم وقوت فقيركم","تجبى ضرائب ظلمها ومكوسها",45,"س",3,0],["مَن دَحا البَسيطَةَ مَن","حاطَها بِأَبحُرِها",46,"ر",3,0],["من دنس الأدران","لا ضرع ولا وان",47,"ن",1,0],["من دون ذاك الإمكان","فالطّلّ رشح البحران",47,"ن",1,0],["مَنْ دنا منّي؟ وكالطيف التوى","ونأى، خلف خيالات التنائي",48,"ا",2,0],["من درى كيف أطبقت مقلتيها","ورمى اللّيل حلمها في مضيعه ؟",49,"ع",2,0],["من دهور وأنت سحر' العبارة","وانتظار المنى وحلم' الإشارة",50,"ر",2,1],["من داخل الشوق الدخليل إلى","التي فِيهَا تَرُوحُ لِعَيْنِهِ الْعبَرَاتُ",51,"ت",1,0],["من دموع مازجت أد","معها بين يديها",52,"ي",3,0],["من دُعاة المألوفِ ما دام فيه","مظهرٌ لائقٌ بشَعبٍ أنوف",53,"ف",1,0],["منْ ديارٍ بالهضبِ القليبِ","فاضَ ماءُ الشّؤونِ فَيْضَ الغُروُبِ",54,"ب",1,1]]}