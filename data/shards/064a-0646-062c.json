{"poems":[[55,"قضت المنازل يوم كاظمة","https://www.aldiwan.net/poem29962.html","الكامل"],[24,"أنى ألم بك الخيال يطيف","https://www.aldiwan.net/poem21870.html","الكامل"],[32,"لمية أطلال بحزوى دوائر","https://www.aldiwan.net/poem29586.html","الطويل"],[85,"أنا تاج كهلال","https://www.aldiwan.net/poem54252.html","مجزوء الرمل"],[90,"سر في حياتك سير نابه","https://www.aldiwan.net/poem44813.html","مجزوء الكامل"],[90,"خاض الدجى وظلام الليل مختلط","https://www.aldiwan.net/poem44831.html","البسيط"],[74,"سلوت لكن قلبي يا سعاد سلي","https://www.aldiwan.net/poem19470.html","البسيط"],[40,"بان الأحبة بالعهد الذي عهدوا","https://www.aldiwan.net/poem7699.html","البسيط"],[87,"استخلف المنصور في وصاته","https://www.aldiwan.net/poem7909.html","الرجز"],[64,"نظري إلى لمع الوميض حنين","https://www.aldiwan.net/poem52265.html","الكامل"],[30,"يا سائلي أين حلّ الجود والكرم","https://www.aldiwan.net/poem25438.html","البسيط"],[63,"عل طيفا سرى حليف اكتئاب","https://www.aldiwan.net/poem51808.html","الخفيف"],[2,"أمن أم أوفى دمنة لم تكلم","https://www.aldiwan.net/poem25065.html","الطويل"],[76,"مر بنا وهو بدر تم","https://www.aldiwan.net/poem12858.html","مجزوء البسيط"],[77,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[48,"أودع يومي عالما إن مثله","https://www.aldiwan.net/poem22325.html","الطويل"],[48,"ينجمون وما يدرون لو سئلوا","https://www.aldiwan.net/poem22977.html","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202551","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21003","الطويل"],[234,"أما الصباح فقد بدت راياته","https://www.aldiwan.net/poem50942.html","الكامل"],[266,"حتام لا ينثني الجموح","https://www.aldiwan.net/poem38346.html","مخلع البسيط"],[385,"استغر الله العظيم العفو","https://www.aldiwan.net/poem47411.html","الرجز"],[409,"هذي مناسك أحمد وصفاته","https://www.aldiwan.net/poem33477.html","الكامل"],[411,"لنا صديق خير أحواله","https://www.aldiwan.net/poem49566.html","السريع"],[458,"كم زعيم مسخر شرفه","https://www.aldiwan.net/poem61355.html","الخفيف"],[463,"آنس برقا بالشريف لامعا","https://www.aldiwan.net/poem56123.html","الرجز"],[463,"بين النقا فثنية الحجر","https://www.aldiwan.net/poem56199.html","أحذ الكامل"],[466,"قربا مني حسامي وجوادي","https://www.aldiwan.net/poem15102.html","الرمل"],[466,"طربت قوافي الشعر حيث يقودها","https://www.aldiwan.net/poem15179.html","الكامل"],[466,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"],[556,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[563,"شرفي يا شرفي يا شرفي","https://www.aldiwan.net/poem34339.html","الرمل"],[563,"قل هو الله","https://www.aldiwan.net/poem34606.html","مجزوء الرمل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54020","الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25360","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55886","الرمل"],[1827,"","https://poetry.dctabudhabi.ae/diwan/poem/75802","السريع"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125359","الكامل"],[2057,"","https://poetry.dctabudhabi.ae/diwan/poem/130452","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53172","الكامل"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199811","المسحوب"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27821","البسيط"],[2338,"","https://poetry.dctabudhabi.ae/diwan/poem/111147","الرمل"],[2607,"","https://poetry.dctabudhabi.ae/diwan/poem/34890","الكامل"],[2843,"","https://poetry.dctabudhabi.ae/diwan/poem/124681","السريع"],[2914,"","https://poetry.dctabudhabi.ae/diwan/poem/9608","البسيط"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99329","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89397","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74102","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48312","الطويل"],[3643,"","https://poetry.dctabudhabi.ae/diwan/poem/145190","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131063",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102995","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102994","الطويل"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67618","الرمل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136698",""],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139261","الرمل"],[4679,"من مجيري من سهام المقلِ","https://www.poetsgate.com/ViewPoem.aspx?id=142747",""],[4767,"تبت يداك","https://www.poetsgate.com/ViewPoem.aspx?id=181315",""],[5061,"خيرة اعيادي","https://www.poetsgate.com/ViewPoem.aspx?id=153000",""],[5318,"استغفروا اللهَ عمّا كان من سَفهٍ","https://www.poetsgate.com/ViewPoem.aspx?id=213797",""],[5338,"غالى ولم يبلغ قصيدي","https://www.poetsgate.com/ViewPoem.aspx?id=187759",""],[5433,"عزة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=36120",""],[5461,"يوم انا طالب","https://www.poetsgate.com/ViewPoem.aspx?id=5237",""],[2914,"أَودَى الشَّبابُ ، حَميدا ، ذو التَّعاجِيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=17641",""],[5913,"الحنين المكتَّمُ المفضوحُ","https://www.poetsgate.com/ViewPoem.aspx?id=183248",""],[5956,"جُزْتِ التصورَ عمّا كنتُ أحسبُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=207235",""],[773,"هو مورد للمعتفين وغلةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=134915",""]],"verses":[["يَنجو عَلى رَمَقٍ مُقَدَّمُها","وَيُقيمُ مَعذوراً مُخَلَّفُها",0,"ف",3,0],["يَنجو بِها خَرِبُ المُشاشِ كَأَنَّهُ","بِخِزامِهِ وَزِمامِهِ مَشنوفُ",1,"ف",1,0],["يُنَجَيَننا مِن كُلِّ أَرضٍ مَخوفَةٍ","عِتاقٌ مُهاناتُ وَهُنَّ صَوابِرُ",2,"ر",1,0],["ينجلي الإبريق فيه","كعروسٍ ذي اختيالِ",3,"ل",1,0],["ينجاب يأسي بالرجا","ء إذا نظرتُ إلى شبابه",4,"ب",2,0],["ينجاب ليل العمى عن قلب سامعه","كالفجر إن لاح فالظلماء تنكَشط",5,"ط",1,0],["ينجي الغريق إذا أعطى وبعض مُضا","سيوفه تفرق الأعداء بالبدل",6,"ل",1,0],["يَنجو بِها عُنُقٌ صَعلٌ وَتُلحِقُها","رِجلٍ أَصَكَّ خِدَبٍّ فَوقَهُ لَبِدُ",7,"د",1,0],["يَنجمُ فيها النابِغُ السَعيدُ","وَيُنجب المُقتَبس البَعيدُ",8,"د",1,0],["ينجابُ عنه النقعُ وهو كأنَّهُ","قَمرٌ له سعدُ السُّعودِ قرينُ",9,"ن",1,0],["يَنْجَابُ نُورُ الدُّجَي‌ عَنْ نُورِ غُرِّتِهِ","كَالشَّمْسِ يَنْجَابُ عَنْ إشْرَاقِهَا الظُّلَمُ",10,"م",1,0],["يَنْجلي السِّلْمُ عن بدورٍ رَواضٍ","فيه والحربُ عن أسودٍ غِضابِ",11,"ب",1,0],["يُنَجِّمُها قَومٌ لِقَومٍ غَرامَةً","وَلَم يُهَريقوا بَينَهُم مِلءَ مِحجَمِ",12,"م",1,0],["يَنجابُ عَن نورِها كِمامٌ","يَحُطُّ عَن وَجهِهِ نِقابا",13,"ب",2,0],["يَنجابُ منهُ الأفْقُ وهو دُجُنّةٌ","ويَسِحُّ منْهُ الدهُر وهو عليلُ",14,"ل",1,0],["يُنَجِّزُ هَذا الدَهرُ ما كانَ مَوعِداً","وَتَمطُلُ مِنهُ بِالرَجاءِ وُعودُ",15,"د",1,0],["يُنَجِّمونَ وَما يَدرونَ لَو سُئِلوا","عَنِ البَعوضَةِ أَنّى مِنهُمُ تَقِفُ",16,"ف",1,1],["ينجم فيها النابغ السعيد","وبنجب المقتبس البعيد",17,"د",1,0],["يَنُجنَ عَلَى مَيتٍ ويُعلِنَّ رَنَّةً","تُؤَرِّقُ عَينَي كُلِّ باكٍ ومُسعَدِ",18,"د",1,0],["ينجاب عنها تارةً فَيُبِينُها","وتَغيب طَوْراً في دُجاه فتكسَف",19,"ف",1,0],["ينجح في قصده إيابي","فإنه المقصد النجيح",20,"ح",1,0],["ينجمُ فيه بطلٌ بعد بَطَل","ويستوي شانٌ إذا شانٌ بَطَل",21,"ل",1,0],["ينجو هنالك كل ذي بله أتى","بالخمسة الأركان في تعقيله",22,"ل",2,0],["ينَجرّ في كُلِّ جَرّ فلا","تراهُ يَوماً غير مُنجَرِّ",23,"ر",1,0],["ينجب الشعب في الملمات قرنا مستميتا","يهد من جزفه",24,"ف",2,0],["ينجو به إباؤه من أن يُرَى","مضعضعاً للنائبات خاضعا",25,"ع",2,0],["ينجو بِعرضي أن يضام له","عَرْضُ الفلاةِ وغضبةُ الحُرِّ",26,"ر",1,0],["ينجلي نقعُ وغاهُ في الضُّحى","عن وساد التُّرب أو مُلْكِ البلاد",27,"د",1,0],["ينجابُ محلُ الأرض عن قسماته","ويعود منه الليلُ وجه صَباحِ",28,"ح",1,0],["ينجابُ عنه الجيش وهو مُصممٌ","وتَحيدُ عنهُ الشِّدَّةُ الصَّمَّاءُ",29,"ا",2,0],["يَنجو قَذاها غيرَ مُتّئدٍ","مِثْلَ الوَسيقةِ لَزَّها الطَّرْدُ",30,"د",1,0],["ينجلي في كل شيء عندنا","فنراه في القبا المنكشف",31,"ف",1,0],["ينجلي الحق به","وهو للمطلق حد",32,"د",1,0],["يَنْجَابُ عَنْ نفْسِ المَشوقِ إذا شَدَا","شادٍ به ما ليْسَ بالمُنجابِ",33,"ب",1,0],["يَنْجُو بِشَرْخَيْ رَحْلِهِ مُعَجْرَمُهْ","كَأَنَّما يَزْفِيهِ حادٍ يَنْهِمُهْ",34,"م",2,0],["ينجلى لوناّ ولينا كلما","طرقته أيدي البين القسي",35,"ي",1,0],["يَنجو من السَوطِ كَما تجدم ال","قَيدودُ من وَهوَهَةِ المِسحَلِ",36,"ل",1,0],["يَنجَابُ دَيجُورُ المظالمِ مُسرِعاً","ويلوح فجرُ العدلِ والإحسانِ",37,"ن",1,0],["ينجلي للرسل مجلى حسنها","سارياً في كل اواب مطيع",38,"ع",1,0],["ينجاب ليل الحادثات به","عنا فيشرق حالك الطَّفَل",39,"ل",1,0],["ينجلي للي يرى للشوق ذوق","والغبي معذور والقلب الخلي",40,"ل",2,0],["ينجو إذا صاحبُ الأعداد يهلك في","تعداده وهو الحيران في كبد",41,"د",1,0],["ينجلي الناظر فيه والنفوس","فيه عنها غيهب الغي انجلى",42,"ل",2,0],["يَنجو إِذا كانَ النَجا","ءُ عَلى أخَفّ مِن القَلوصِ",43,"ص",1,0],["ينجرون الذبائحَ الحمرَ في الصبحِ","وفي الليلِ تصطلى الاهواءُ",44,"ا",2,0],["يُنجيهِمِ مِن دَواهي الشَرِّ إِن أَزَمَت","صَبرٌ عَلَيها وَقِبصٌ غَيرُ مَحسوبِ",45,"ب",1,0],["ينجده وهو عريق في النجد","وإن جرى كانت له الريح مدد",46,"د",1,0],["ينجون بورهْ كلدنْ فبالَ وانحبس","للصبح ثم ارتد للديوان",47,"ن",1,0],["ينجيك من شرك الحما","م إِذا أَحدّ وَحمّما",48,"م",2,0],["يُنْجِزُ الوعْدَ والزّمانُ خَؤونٌ","ويوفّي الحُقوقَ والدّهْرُ باخِسْ",49,"س",1,0],["ينجى من العاهات معتصما به","وقد جاء بالبشرى كما يدفع الخزيا",50,"ي",2,0],["ينجل أن جدبٌ عرى","ولا يجود بالقرى",51,"ر",2,0],["ينجلي مزدهرا حتى إذا","غضت الأبصار عنه أظلما",52,"م",2,0],["ينجّم للدنيا بجرّ يراعه","فتجرى بما شاء الجواري الكوانس",53,"س",1,0],["ينجّم للدنيا بحر سنانه","فتجري بما شاء الجواري الكوانس",54,"س",1,0],["يُنجزُ الناسُ إذا ما وَعَدوا","وإذا ما أنجَزَ الفضلُ وَعَدْ",55,"د",1,0],["ينجو إذا مدّ في عُرض الفلا","بالخَطوِ أخفافاً خفافاً وسدا",56,"ا",1,0],["ينجم في الكاسات منها حببٌ","فيبصر الراؤون فيها الشُهبا",57,"ب",2,0],["ينجلي الحق ويبدو","نوره لا يتعمى",58,"م",2,0],["ينجلي مزدرياً بدر الدجى","فوق قدٍ يزدري بالأسلِ",59,"ل",1,0],["ينجو بعورته وسي","ف الله منه قد اقترب",60,"ب",1,0],["ي نجمة آلليل ،، ي قمراء ،،ويا وادي","لي قصةً مع ثلاثتكم .....مهي تذكر",61,"ر",1,0],["يُنجي من الغمِ مكروباً يُسبّحهُ","ذا النونِ حتى ببطنِ الحوتِ أنجاهُ",62,"ا",2,0],["يَنْجَابُ عَنْ فَجْرٍ مِنَ الْ-","-كَلِمَاتِ فِي قَوْلٍ سَديدِ",63,"د",1,0],["ينجرح قلب،، لكن ترتفع هامه","والله اني لاموت ولاانحنى راسي",64,"س",2,1],["ينجرح شوف العيون الى التفت","كن في حجر العيون اكبر قذاه",65,"ا",2,0],["ينجيهمِ من دواهي الشرّ. إنْ iiأزمتْ","صَبرٌ عَلَيها ، وقِبْضٌ غَيرُ مَحسوبِ",66,"ب",1,0],["ينجلي الهم يستحيل انشراحاً","حين يغدو إليكم أو يروح",67,"ح",1,0],["يُنْجِيه ربُّك مثلَ العنكبوت كما","أنجَى النبيَّ بغارٍ صَدَّ شِرْذمةَ",68,"ه",1,0],["ينجاب سجف النقع منه في الوغى","والطعن يخطب والمقاتل تسمع",69,"ع",1,0]]}