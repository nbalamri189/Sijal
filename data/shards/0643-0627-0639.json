{"poems":[[3,"هذه نار عبلة يا نديمي","https://www.aldiwan.net/poem203.html",""],[41,"قفا فاسألا الدمنة الماصحه","https://www.aldiwan.net/poem53809.html","المتقارب"],[108,"شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=179472",""],[108,"عصفورة تتحدى النسور!","https://www.poetsgate.com/ViewPoem.aspx?id=179471",""],[275,"هبط الليل ولما أن دجا","https://www.aldiwan.net/poem35240.html","الرمل"],[545,"ألم تأرق لضوء البرق","https://www.aldiwan.net/poem56864.html","الهزج"],[567,"بناء العلى بين القنا والبوارق","https://www.aldiwan.net/poem52969.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64226","الهزج"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107188","الخفيف"],[1185,"","https://poetry.dctabudhabi.ae/diwan/poem/75735","الخفيف"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45386","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108773","الخفيف"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49553","المتقارب"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46456","الطويل"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199638","المسحوب"],[2384,"","https://poetry.dctabudhabi.ae/diwan/poem/123655","الرمل"],[2552,"","https://poetry.dctabudhabi.ae/diwan/poem/144423","الخفيف"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140105",""],[2922,"","https://poetry.dctabudhabi.ae/diwan/poem/105344","السريع"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129392","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216704","الرمل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119608","الرمل"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139227","المتقارب"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66161","الخفيف"],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5087,"أيها اللائمي لحبي عليا","https://www.poetsgate.com/ViewPoem.aspx?id=96364",""],[5302,"هام قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=201901",""],[5353,"عندما ماتَ الشّاعرُ بينَ يديه ِ","https://www.poetsgate.com/ViewPoem.aspx?id=212466",""],[5871,"الجُرحُ مَفتُوحٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74655&r=&rc=35",""]],"verses":[["كاعِبٌ ريقُها أَلَذُّ مِنَ الشَه","دِ إِذا ما زَجَتهُ بِنتُ الكُرومِ",0,"م",1,0],["كَأَعيَنَ ذَبِّ رِيادِ العَشِيِّ","إِذا وَرَّكَت شَمسُهُ جانِحَه",1,"ح",2,0],["كاعبٌ جرَّتْ ذيول الأدبِ","وتغنَّت بقريض العربِ",2,"ب",1,1],["كاعبٌ من بنات مصرَ أرتنا","جرأةَ الليث في وجوه الحسان",3,"ن",1,0],["كاعبٌ تدرجُ في رَوضتِها","مثلَ عصفورٍ عليها دَرَجا",4,"ج",2,0],["كَأَعناقِ نِساءِ الهِن","دِ قَد شيبَت بِأَوضاحِ",5,"ح",1,0],["كأعجاز نخلٍ خاوياتٍ عُدَاتُها","تَخِرُّ لَدَى غاباتِ نخلٍ بواسقِ",6,"ق",1,0],["كأعناقِ الدراريج","وأحداقِ الكراوين",7,"ن",1,0],["كاعِبٌ هَونَةُ القِيامِ قَطُوفُ ال","مَشيِ هَيفاءُ غادَةٌ أُملُودُ",8,"د",1,0],["كاعب ناهد عقيلة شعر","تخذت حلة البَيان شعارا",9,"ر",2,0],["كَأَعضاءٍ بِها أَلَمٌ فَقَلبٌ","عَلى ضَمَدٍ وَرَأسٌ في صُداعِ",10,"ع",1,0],["كاعتلاق العلى بذيل فريقٍ","من فريق علا على كل فيلق",11,"ق",1,0],["كاعتزامِ ابنِ عبيد اللهِ لا","هَوَّنَ القُرْبَ ولا هابَ البُعُد",12,"د",1,0],["كَأَعمى اِغتَدى مِمَن بِهِ دَل ساخِراً","فَأَعِجب بِأَعمى ساخِرٍ بِدَليله",13,"ه",1,0],["كاعبٍ بالرّيم متقايس","من يوازي رتّع اقفوره",14,"ر",2,0],["كاعب هيفاء راقت خضرة","جال في ريحانها طل الغبش",15,"ش",1,0],["كاعِبٌ في الحجابِ يمنَعُها الزّو","رَ حياءٌ يصونها وغَراره",16,"ر",2,0],["كا عذرا لها قوام كرمح","لعبت من جريدها بسيوف",17,"ف",1,0],["كاعبة النهدين خمصانة","تبهضها في المشي احقافها",18,"ف",3,0],["كاعب زانها دلال وتيه","فالقوافي لعزها كالاسارى",19,"ر",2,0],["كاعب كالظبي إلا أنها","دون نهديها جنان القسور",20,"ر",1,0],["كاعبٌ هيفاء أما ردفها","جلَّ عن دعصٍ عظيم في المثال",21,"ل",1,0],["كأعمى يخاف على أعور","عثاراً وعن نفسه يغفل",22,"ل",1,0],["كاعِبٌ صادَتِ الفاادَ بِسِحْرٍ","كانَ شِعْرا اوْحَتْ بهِ عَيْناها",23,"ا",3,0],["كأعيى إذا الأعياء يوماً له اعتزوا","بأهوى وفي أهوائهم غلواء",24,"ا",2,0],["كأعمى الذي الأعماء يقروا فلا تدع","سبيل الهدى ما عن عداه عداء",24,"ا",2,0],["كاعتزال الخليل آزر في ال","سله وهجرانه أباه مليا",25,"ي",2,0],["كاعب لما ظهرت لها","في جنون واللقا سنحا",26,"ح",2,0],["كأعمى أضاعتْهُ عصاهُ ويرتجي","عصا غيرهِ أعمي يمرُّ ليهتدي",27,"د",2,0],["كأعيُنِ القتلَى","مَن ذا يَمُدُّ يدًا",28,"ا",1,0]]}