{"poems":[[3,"هذه نار عبلة يا نديمي","https://www.aldiwan.net/poem203.html",""],[39,"قفا فاسألا الدمنة الماصحه","https://www.aldiwan.net/poem53809.html","المتقارب"],[106,"شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=179472",""],[106,"عصفورة تتحدى النسور!","https://www.poetsgate.com/ViewPoem.aspx?id=179471",""],[270,"هبط الليل ولما أن دجا","https://www.aldiwan.net/poem35240.html","الرمل"],[540,"ألم تأرق لضوء البرق","https://www.aldiwan.net/poem56864.html","الهزج"],[562,"بناء العلى بين القنا والبوارق","https://www.aldiwan.net/poem52969.html","الطويل"]],"verses":[["كاعِبٌ ريقُها أَلَذُّ مِنَ الشَه","دِ إِذا ما زَجَتهُ بِنتُ الكُرومِ",0,"م",1,0],["كَأَعيَنَ ذَبِّ رِيادِ العَشِيِّ","إِذا وَرَّكَت شَمسُهُ جانِحَه",1,"ح",2,0],["كاعبٌ جرَّتْ ذيول الأدبِ","وتغنَّت بقريض العربِ",2,"ب",1,1],["كاعبٌ من بنات مصرَ أرتنا","جرأةَ الليث في وجوه الحسان",3,"ن",1,0],["كاعبٌ تدرجُ في رَوضتِها","مثلَ عصفورٍ عليها دَرَجا",4,"ج",2,0],["كَأَعناقِ نِساءِ الهِن","دِ قَد شيبَت بِأَوضاحِ",5,"ح",1,0],["كأعجاز نخلٍ خاوياتٍ عُدَاتُها","تَخِرُّ لَدَى غاباتِ نخلٍ بواسقِ",6,"ق",1,0]]}