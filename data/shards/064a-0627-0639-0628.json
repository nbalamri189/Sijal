678,"يحيى الحمادي","https://www.poetsgate.com/ViewPoem.aspx?id=202667",""],[5891,"أحلام الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=39927",""],[5923,"لغد أقول ....... ذاك دأبي قبل يوم الأفول","https://www.poetsgate.com/ViewPoem.aspx?id=146239",""],[5943,"رثاء الشاعرة النيلية عبلة محمد زقزوق","https://www.poetsgate.com/ViewPoem.aspx?id=56464",""],[5956,"شمسٌ وظلال","https://www.poetsgate.com/ViewPoem.aspx?id=192981",""],[5956,"الشكر لجدكم بل لأجدادكم","https://www.poetsgate.com/ViewPoem.aspx?id=194228",""],[5956,"آتاكَ ربك صحة وإيادا","https://www.poetsgate.com/ViewPoem.aspx?id=207823",""],[6031,"أَلجَفْنٍ أَرَّقتُموهُ هُجُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=46277",""],[6056,"عبير الورد","https://www.poetsgate.com/ViewPoem.aspx?id=130354",""],[5309,"أنوار هادي الورى في كعبة الحرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573517",""],[6229,"إلى أحمد صبري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65204&r=&rc=28",""],[6318,"مواكب بدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66158&r=&rc=8",""]],"verses":[["يا عَبرَتي هَذِهِ الأَطلالُ وَالدِّمَنُ","فَما اِنتِظارُكِ سيلي فَهيَ لي وَطَنُ",0,"ن",1,1],["يا عَبلَ كَم مِن غَمرَةٍ باشَرتُه","بِالنَفسِ ما كادَت لَعَمرُكِ تَنجَلي",1,"ل",2,0],["يا عَبلُ أَينَ مِنَ المَنِيَةِ مَهرَبي","إِن كانَ رَبّي في السَماءِ قَضاها",2,"ا",3,1],["يا عَبلَ مِثلُ هَواكِ أَو أَضعافُهُ","عِندي إِذا وَقَعَ الإِياسُ رَجاءُ",3,"ا",2,0],["يا عَبلَ قومي اِنظُري فِعلي وَلا تَسَلَي","عَنّي الحَسودَ الَّذي يُنبيكِ بِالكَذِبِ",4,"ب",1,0],["يا عَبلَ قَد دَنَتِ المَنِيَّةُ فَاِندُبي","إِن كانَ جَفنُكِ بِالدُموعِ يَجودُ",5,"د",1,0],["يا عَبلَ إِن تَبكي عَلَيَّ فَقَد بَكى","صَرفُ الزَمانِ عَلَيَّ وَهوَ حَسودُ",5,"د",1,0],["يا عَبلَ إِن سَفَكوا دَمي فَفَعائِلي","في كُلِّ يَومٍ ذِكرُهُنَّ جَديدُ",5,"د",1,0],["يا عَبلَ كَم مِن جَحفَلٍ فَرَّقتُهُ","وَالجَوُّ أَسوَدُ وَالجِبالُ تَميدُ",5,"د",1,0],["يا عَبلَ كَم يُشجى فُؤادي بِالنَوى","وَيَروعُني صَوتُ الغُرابِ الأَسوَدِ",6,"د",1,0],["يا عَبلَ يُهنِئُكِ ما يَأتيكِ مِن نَعمٍ","إِذا رَماني عَلى أَعدائِكِ القَدَرُ",7,"ر",1,0],["يا عَبلَ حُبُّكِ سالِبٌ أَلبابَن","وَعُقولَنا فَتَعَطَّفي لا تَهجُري",8,"ر",2,0],["يا عَبلَ لَولا أَن أَراكِ بِناظِري","ما كُنتُ أَلقى كُلَّ صَعبٍ مُنكَرِ",8,"ر",1,0],["يا عَبلَ كَم مِن غَمرَةٍ باشَرتُه","بِمُثَقَّفٍ صُلبِ القَوائِمِ أَسمَرِ",8,"ر",1,0],["يا عَبلَ خَلّي عَنكِ قَولَ المُفتَري","وَاِصغي إِلى قَولِ المُحِبِّ المُخبِرِ",9,"ر",1,1],["يا عَبلَ دونَكِ كُلَّ حَيٍّ فَاِسأَلي","إِن كانَ عِندَكِ شُبهَةٌ في عَنتَرِ",9,"ر",1,0],["يا عَبلَ هَل بُلِّغتِ يَوماً أَنَّني","وَلَّيتُ مُنهَزِماً هَزيمَةَ مُدبِرِ",9,"ر",1,0],["يا عَبلَ لَو عايَنتِ فِعلي في العِد","مِن كُلِّ شِلوٍ بِالتُرابِ مُعَفَّرِ",9,"ر",1,0],["يا عَبلَ نارُ الغَرامِ في كَبدي","تَرمي فُؤادي بِأَسهُمِ الشَرَرِ",10,"ر",1,0],["يا عَبلَ لَولا الخَيالُ يَطرُقُني","قَضَيتُ لَيلي بِالنَوحِ وَالسَهَرِ",10,"ر",1,0],["يا عَبلَ كَم فِتنَةٍ بُليتُ بِه","وَخُضتُها بِالمُهَنَّدِ الذَكَرِ",10,"ر",1,0],["يا عَبلَ كَم تَنعَقُ غِربانُ الفَل","قَد مَلَّ قَلبي في الدُجى سَماعَها",11,"ع",3,0],["يا عَبلَ لا تَخشَي عَلَيَّ مِنَ العِد","يَوماً إِذا اِجتَمَعَت عَلَيَّ جُموعُها",12,"ع",3,0],["يا عَبلَ لَو أَنَّ المَنِيَّةَ صُوِّرَت","لَغَدا إِلَيَّ سُجودُها وَرُكوعُها",12,"ع",3,0],["يا عَبلَ إِن كانَ ظِلُّ القَسطَلِ الحَلِكِ","أَخفى عَلَيكِ قِتالي يَومَ مُعتَرَكي",13,"ك",2,1],["يا عَبلَ ما أَخشى الحِمامِ وَإِنَّم","أَخشى عَلى عَينَيكِ وَقتَ بُكاكِ",14,"ك",1,0],["يا عَبلَ لا يَحزُنكِ بُعدي وَاِبشِري","بِسَلامَتي وَاِستَبشِري بِفَكاكي",14,"ك",2,0],["يا عَبلَ أَنتِ سَوادُ القَلبِ فَاِحتَكِمي","في مُهجَتي وَاِعدِلي يا غايَةَ الأَمَلِ",15,"ل",1,0],["يا عَبلَ لَو أَبصَرتِني لَرَأَيتِني","في الحَربِ أُقدِمُ كَالهِزَبرِ الضَيغَمِ",16,"م",1,0],["يا عَبلَ ما دامَ الوِصالُ لَيالِي","حَتّى دَهانا بَعدَهُ الهِجرانُ",17,"ن",1,0],["يا عَبلَ قَد هامَ الفُؤادُ بِذِكرِكُم","وَأَرى دُيوني ما يَحُلُّ قَضاها",18,"ا",3,0],["يا عَبلَ إِن تَبكي عَلَيَّ بِحُرقَةٍ","فَلَطالَما بَكَتِ الرِجالُ نِساها",18,"ا",3,0],["يا عَبلَ إِنّي في الكَريهَةِ ضَيغَمٌ","شَرِسٌ إِذا ما الطَعنُ شَقَّ جِباها",18,"ا",3,0],["يا عَبلَ كَم مِن فارِسٍ خَلَّيتَهُ","في وَسطِ رابِيَةٍ يَعُدُّ حَصاها",18,"ا",3,0],["يا عَبلَ كَم مِن حُرَّةٍ خَلَّيتُه","تَبكي وَتَنعى بَعلَها وَأَخاها",18,"ا",3,0],["يا عَبلَ كَم مِن مُهرَةٍ غادَرتُه","مِن بَعدِ صاحِبِها تَجُرُّ خُطاها",18,"ا",3,0],["يا عَبلَ لَو أَنّي لَقيتُ كَتيبَةً","سَبعينَ أَلفاً ما رَهِبتُ لِقاها",18,"ا",3,0],["يَا عِبْرَةَ الدَّهْرِ جَاوَزْتِ المَدَى فِينَا","حَتَّى لَيَأْنَفُ أَنْ نَنْعَاهُ مَاضِينَا",19,"ن",2,1],["يا عَبدَ خِندِفَ لا تَزالُ مُعَبَّداً","فَاِقعُد بِدارِ مَذَلَّةٍ وَهَوانِ",20,"ن",1,0],["يا عَبدَ بَيبَةَ ما عَذيرُكَ مُحلِباً","لِتُصيبَ عُرَّةَ مُجرِبٍ وَتُلاما",21,"م",2,0],["يا عبادي أما غَضِبْتُم لوجهي","ذي الجلال العظيم والإكرام",22,"م",1,0],["يا عُبيد اللّه لا زلْ","تَ موقَّىً كل كيدِ",23,"د",1,1],["يا عِبادَ اللَهِ توبوا","فَهوَ كَهفُ التائِبينا",24,"ن",2,0],["يا عِبادَ اللَهِ كُلٌّ زائِلٌ","نَحنُ نَصبٌ لِلمَقاديرِ الجَوار",25,"ر",1,0],["يا عبقرياً في شناعته","ولدتك أمك وهي معتذره",26,"ر",2,0],["يا عِبرَةَ اللَهِ الَّتي مِن طَرزِها","نَشَأوا فَكانَ القِردُ وَالخِنزيرُ",27,"ر",1,0],["يَا عِبَادَ اللَّهِ مَنْ لِفَتىً","بِيَدِ الأَشْوَاقِ مُرْتَهَنِ",28,"ن",1,0],["يا عَبدَ لا أُقذَفَن بِداهِيَةٍ","مِنكُم وَلَم آتِها وَلَم أَخُنِ",29,"ن",1,0],["يا عبيدَ المالِ هل فيكم فتىً","يَمنعُ المالَ أكفَّ الغاصِبينْ",30,"ن",1,0],["يا عَبدَ أَصبَحتُ فَاِعلَميني","غَيرَ حَريصٍ عَلى وَفاتي",31,"ت",2,0],["يا عَبدَ قَد طالَ المِطالُ فَأَنعِمي","وَاِشفي فُؤادَ فَتىً يَهيمُ مُتَيَّمِ",32,"م",1,1],["يا عَبدَ بِاللَهِ اِرحَمي عَبدَكِ","وَعَلِّليهِ بِمُنى وَعدِكِ",33,"ك",1,1],["يا عَبدَ زوريني تَكُن مِنَّةٌ","لِلّهِ عِندي يَومَ أَلقاكِ",34,"ك",1,1],["يا عَبدَ إِنّي هالِكٌ مُدنَفٌ","إِنَ لَم أَذُق بَردَ ثَناياكِ",34,"ك",1,0],["يا عَبدَ حُبُّكِ شَفَّني شَفّا","وَالحُبُّ داءٌ يورِثُ الحَتفا",35,"ف",2,1],["يا عَبدَ يا جافِيَةٌ قاطِعَه","أَما رَحِمتِ المُقلَةَ الدامِعَه",36,"ه",1,1],["يا عَبدَ خافي اللَهَ في عاشِقٍ","يَهواكِ حَتّى تَقَعَ الواقِعَه",36,"ه",1,0],["يا عَبدَ حُبّي لَكِ مَستور","وَكُلُّ حُبٍ غَيرِهِ زورُ",37,"ر",1,1],["يا عَبدَ لا تَقتُليني إِنَّني رَجُلٌ","إِن تُطلَبي بِدَمي لا تَسبِقي ثاري",38,"ر",2,0],["يا عَبدَ هَل لي مِنكُمُ مِن عائِدٍ","أَم هَل لَدَيكِ صَلاحُ قَلبٍ فاسِدِ",39,"د",1,1],["يا عَبدَ ضاقَ بِحُبِّكُم جَلَدي","وَهَواكُمُ صَدعٌ عَلى كَبِدي",40,"د",2,1],["يا عَبدَ باهِلَةَ الَّذي يَتَوَعَّدُ","أَعَلَيَّ تُبرِقُ إِذ شَبِعتَ وَتُرعِدُ",41,"د",1,1],["يا عَبدَ باهِلَةَ اِبتُليتَ بِحَيَّةٍ","فَتَرَكتَ طاعَتَنا وَرُحتَ تُهَدِّدُ",41,"د",1,0],["يا عَبدَ باهِلَةَ الَّذي لَزَمَ الخَنا","وَأَضاعَ عُقرَ قَناتِهِ لا تَسعَدُ",41,"د",1,0],["يا عَبدَ قَد شَخَصَ الفُؤا","دُ وَقَد شَخَصتِ فَغَيرُ باعِد",42,"د",1,0],["يا عَبدَ لا تَنسَي فَلَم أَنسَهُ","مَمشايَ بَينَ المَسجِدِ المُبتَدي",43,"د",2,0],["يا عَبدَ أَنتِ ذَخيرَتي","نَفسي فَدَتكِ وَجيرَتي",44,"ت",2,1],["يا عَبدَ أَقسِمُ بِالَّذي أَنا عَبدُهُ","وَلَهُ المَقامُ وَما حَوَت عَرَفاتُ",45,"ت",1,0],["يا عَبدَ جَلّي كُروبي","وَأَسعِفي وَأَثيبي",46,"ي",1,1],["يا عَبدَ حَيِّ عَن قَريب","وَتَأَمَّلي عَينَ الرَقيب",47,"ب",1,1],["يا عَبدَ بِاللَهِ فَرِّجي كُرَبي","فَقَد بَراني وَشَفَّني نَصَبي",48,"ب",2,1],["يا عَبدَ إِنّي قَد ظُلِمتُ وَإِنَّني","مُبدٍ مَقالَةَ راغِبٍ أَو راهِبِ",49,"ب",1,1],["يا عَبدَ هَل لِلِّقاءِ مِن سَبَبِ","أَو لا فَأَدعو بِالوَيلِ وَالحَرَبِ",50,"ب",1,1],["يا عَبدَ حَتّامَ لا أَلقاكِ خالِيَةً","وَلا أَنامُ لَقَد طَوَّلتِ تَعذيبي",51,"ب",2,0],["يا عَبلَ كَم مِن غَمرَةٍ باشَرتُها","بِالنَفسِ ما كادَت لَعَمرُكِ تَنجَلي",52,"ل",2,0],["يا عَبلَ كَم تَنعَقُ غِربانُ الفَلا","قَد مَلَّ قَلبي في الدُجى سَماعَها",53,"ع",3,0],["يا عَبلَ إِنَّ هَواكِ قَد جازَ المَدى","وَأَنا المُعَنّى فيكِ مِن دونِ الوَرى",54,"ر",2,0],["يا عَبلَ حُبُّكِ في عِظامي مَع دَمي","لَمّا جَرَت روحي بِجِسمي قَد جَرى",54,"ر",2,0],["يا عَبلَ ما دامَ الوِصالُ لَيالِياً","حَتّى دَهانا بَعدَهُ الهِجرانُ",55,"ن",1,0],["يا عَبلَ كَم فِتنَةٍ بُليتُ بِها","وَخُضتُها بِالمُهَنَّدِ الذَكَرِ",56,"ر",1,0],["يا عَبلَ حُبُّكِ سالِبٌ أَلبابَنا","وَعُقولَنا فَتَعَطَّفي لا تَهجُري",57,"ر",2,0],["يا عَبلَ كَم مِن غَمرَةٍ باشَرتُها","بِمُثَقَّفٍ صُلبِ القَوائِمِ أَسمَرِ",5