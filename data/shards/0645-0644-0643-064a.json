,"الكامل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61257","البسيط"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101240","الرمل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45782","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117918","الكامل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66532","الكامل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66578","السريع"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66554","البسيط"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66551","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103003","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103054","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40160","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90967","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54503","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54369","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94403","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58169","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76730","البسيط"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76763","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120556","البسيط"],[5136,"أضحك النصر مبسم العلياء","https://www.poetsgate.com/ViewPoem.aspx?id=121488",""],[5136,"شرف باذخ رفيع منيف","https://www.poetsgate.com/ViewPoem.aspx?id=121621",""],[5136,"أسموط در فصلت بالعسجد","https://www.poetsgate.com/ViewPoem.aspx?id=121799",""],[5582,"أَنَّى يَكُونُ مِنَ الغَرامِ جُحُودُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=186884",""],[5582,"لِمَنْ المَنازِلُ بِالصَّفِيحَةِ تُعْرَفُ","https://www.poetsgate.com/ViewPoem.aspx?id=187184",""],[5582,"أَسْيانُ نارُ غَرامِهِ تَتَسَعَّرُ","https://www.poetsgate.com/ViewPoem.aspx?id=187103",""],[5582,"عَبَثَ الهَوَى بِكَ حَيْثُ كُنْتَ العابِثَا","https://www.poetsgate.com/ViewPoem.aspx?id=186766",""],[5582,"إِنَّما نَوْحُ الحَمامِ","https://www.poetsgate.com/ViewPoem.aspx?id=63567",""],[5582,"دَعني من التفنيدِ والتأنيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=63468",""],[5582,"طَيْفٌ سَرَى وَثِيابُ اللَّيْلِ أَخْلاقُ","https://www.poetsgate.com/ViewPoem.aspx?id=63545",""],[5689,"حطمت لي يد القضا كل فلس","https://www.poetsgate.com/ViewPoem.aspx?id=143434",""],[5690,"هل نور وجهك ضاءَ في لبنانِ","https://www.poetsgate.com/ViewPoem.aspx?id=172190",""],[5690,"أن تعظم الأهوال حزمك أعظمُ","https://www.poetsgate.com/ViewPoem.aspx?id=172183",""],[5973,"عام بانسيه ٍ ليس يمضي حبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=13764",""],[658,"ذاك العقيق وذاك الاثل والبن","http://www.aldiwanalarabi.com/poemDescription.do?poemId=603995",""],[520,"ثغر الهدى متبلج بسام","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577634",""],[6259,"بعثت إليك بطيفها تعليلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59390&r=&rc=38",""],[4222,"يوم أهب صبا الهبات صباحه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52748&r=&rc=40",""],[4222,"بين أمر حلاوة العيش الشهي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52919&r=&rc=211",""]],"verses":[["مَلِكٌ يُكِلُّ غَداةَ يُطلَبُ شَأوُهُ","مُقَلاً يُصافِحُها العَجاجُ الأقتَمُ",0,"م",1,0],["ملِكٌ يَحُثُّ الصّالِحينَ ويَقْتَدي","في الدِّينِ منْ أنْوارِهِم بسِراجِ",1,"ج",1,0],["مَلِكٌ يَكفيكَ مِنهُ أَنَّهُ","أَنهَضَ الشَرقَ فَهَزَّ المَغرِبا",2,"ب",2,0],["مَلِكٌ يَسوسُ الدَهرَ مِنهُ مُهَذَّبٌ","تَدبيرُهُ لِلمُلكِ خَيرُ مِلاكِ",3,"ك",1,0],["ملكٌ يطوّق بالإحسان وفد رجا","وبالظبا والعوالي وفد هيجاء",4,"ا",2,0],["ملك يغار البدر لمّا يجتلى","ويذيب قلب الغيث لما يجتدى",5,"د",2,0],["ملك يقاس مجاريه بسؤدده","إذا تقايس عير الدار بالفرس",6,"س",1,0],["مَلِكٌ يقدحُ الحياة من الموْ","تى ويَكفي بفضله الأحياءَ",7,"ا",2,0],["ملِكٌ يظلُّ إذا غدا","تتعاورُ الأيدي رِكابهْ",8,"ب",2,0],["ملكٌ يعجّل بالعطا","ء ولا يرى إعمالَ حبسه",9,"س",2,0],["ملك يباشر ناره صَرَدٌ","فتظل مُدفِئةً بلا لذعه",10,"ع",2,0],["ملكٌ يُطيع الجودَ في أمواله","عند السؤالِ ولا يُطيعُ اللائما",11,"م",2,0],["مَلِكٌ يُحَدِّثُ عَن أَبيهِ وَجَدِّهِ","سَنَدٌ لَعَمرُكَ في العُلى لايُلحَقُ",12,"ق",1,0],["مِل كيف شئت مع الريا","ح ففي طباع الغصن ذاك",13,"ك",1,0],["مُلكٌ يُطاوِلُ الشَمسَ عِزَّتُهُ","في الغَربِ باذِخَةٌ في الشَرقِ قَعساءُ",14,"ا",2,0],["مَلِكٌ يَكفيكَ مِنهُ أَنَّهُ","وَجَدَ الدُنيا فَأَعطى ماوَجَد",15,"د",1,0],["مَلِكٌ يُضيءُ مِنَ الطَلاقَةِ وَجهُهُ","فَتَخالُهُ بَدرَ السَماءِ الموفي",16,"ف",2,0],["مَلِكٌ يَستَقِلُّ في رَأيِهِ المُل","كُ وَيَحيا في فَضلِهِ الإِفضالُ",17,"ل",1,0],["مَلِكٌ يَدرَءُ الإِساءَةَ بِالعَف","وِ وَيَجزي الإِحسانَ بِالإِحسانِ",18,"ن",1,0],["مَلَكَينِ قَد خَلَتِ المَنابِرِ مِنهُما","أَخَذَ المَنونُ عَلَيهِما بِالمِرصَدِ",19,"د",1,0],["ملك يخطر في قسطله","وظباه بين صبح وطفل",20,"ل",1,0],["ملك يطارد بالرماح ملوكهم","حتى يشلهم لديه طارئدا",21,"د",2,0],["مَلِكٌ يَليقُ به الثَّناءُ فيغتدي","كالرَّوْضِ يُشرِقُ نَثرُه ونِظامُه",22,"م",2,0],["مَلِكٌ يراه عدوُّهُ مُتحنِّناً","ويراه طالبُ رِفْدِهِ مألُوفا",23,"ف",2,0],["مَلِكٌ يَمُدُّ إلى العُفاةِ أنامِلاً","كادَتْ تَكونُ من السَّماحِ يَنابِعا",24,"ع",2,0],["مَلِكٌ يَعتِقُ العَبيدَ مِنَ الرِقِّ","وَيَشرِيَ الأَحَرارَ بِالإِحساِن",25,"ن",1,0],["مَلِكٌ يَملَأُ النَواظِرَ بِالحُس","نِ وَيَملا الأَكُفَّ بِالإِحسانِ",26,"ن",1,0],["مَلكٌ يَظَلُّ الدَهرُ في حُكمِهِ","مُقتَبِساً مِن رَأيِهِ القادِحِ",27,"ح",1,0],["مَلَكِيَّةً فَلَكِيَّةٌ يَسمو بِها","كَرَمٌ تَرَنَّحَ كُنهُهُ في ذاتِها",28,"ت",3,0],["مَلِكٌ يُريكَ إِذا خَطَبتَ سَماحَهُ","عُذرَ المُسيءِ وُجودَ كَفِّ المُحسِنِ",29,"ن",1,0],["مَلِكٌ يَسيرُ النَصرُ عَن تَلقائِهِ","وَوَرائِهِ وَيَمينِهِ وَشِمالِهِ",30,"ل",2,0],["مَلِكٌ يَجِلُّ عَنِ العِيانِ فَنَغتَدي","بِقُلوبِنا لا بِالنَواظِرِ نَرمُقُ",31,"ق",1,0],["مَلِكٌ يُرَوِّضُ فَوقَ طِرفٍ قارِعٍ","كُرَةً بِجَو كانٍ حَكاهُ ضَبابا",32,"ب",2,1],["مَلِكٌ يَرى تَعَبَ المَكارِمِ راحَةً","وَيَعُدُّ راحاتِ القِراعِ مَتاعِبا",33,"ب",2,0],["ملكي ومحرابي وقد","س فؤادي المتبتل",34,"ل",1,1],["مَلِكٌ يَرى الدُنيا بِأَيسَرِ لَحظَةٍ","وَيَرى التُقى رَحِماً مِنَ الأَرحامِ",35,"م",1,0],["مَلِكٌ يَضِلُّ الفَخرُ في أَيّامِهِ","وَيَقِلُّ في نَفَحاتِهِ ما يَكثُرُ",36,"ر",1,0],["مَلِكٌ يَجودُ وَلا يُؤامِرُ آمِراً","فيهِ وَيَحكُمُ في جَداهُ المُجتَدي",37,"د",2,0],["مُلكٌ يزولُ ودولةٌ يهوي بها","حَادِي التَّبابِ وسائقُ الإِعدامَ",38,"م",1,0],["مَلِكٌ يَقومُ اللَيلَ يَنظر في غَدٍ","ماذا يُسدِّدُ وَالمُلوكُ نِيامُ",39,"م",1,0],["مُلكٌ يبيدُ ومالِكٌ يُرجَى إلى","أجلٍ يَحينُ وموعَدٍ ما يُخْلَفُ",40,"ف",1,0],["مَلِكٌ يُذعذِعُ بِالمَحامِدِ مالَهُ","وَالحَمدُ حينَ يَغِبُّ ذو أَنصارِ",41,"ر",1,0],["مَلِكٌ يَسهُلُ إِذ ساهَلتُهُ","وَإِذا عاسَرتَهُ كانَ العَسِر",42,"ر",1,0],["مَلِكٌ يَفرَعُ المَنابِرَ بِالفَض","لِ وَيَسقي الدِماءَ يَومَ الدِماءِ",43,"ا",2,0],["مَلِكٌ يَعتِقُ العَبيدَ مِنَ الرِق","قِ وَيَشرِيَ الأَحرارَ بِالإِحسانِ",44,"ن",1,0],["مَلِكٌ يُحْسَبُ عَدْلاً مَلَكاً","وإِمامٌ أَمَّ فينا فَهَدَى",45,"د",2,0],["مَلِكٌ يجتابُ ثوبيْ مَلكٍ","أينَ مَنْ يُشبهُه في الناس أينْ",46,"ن",1,0],["مَلِكٌ يَقْدُرُ الرِّجَالَ وَتَعْلُو","في حِماهُ مَرَاتِبُ الْعُظَمَاءِ",47,"ا",2,0],["مَلِكٌ يرنو لعُلْيَا مَلِكٍ","وطِماحٌ يتسامى لِطمَاح",48,"ح",1,0],["ملك يتوج مَفْرقيه بالتقى","نورُ الصلاح عليه أبلجُ، باد",49,"د",1,0],["ملك يجير على الزمان طريده","حتى الحوادث في حماه مضامها",50,"م",3,0],["ملك يحب الصالحين ويقتدي","في الدين من أنوارهم بسراج",51,"ج",1,0],["ملك يرضع الدنان كما يهوى","وأنت الذي تغنّي الدنانا",52,"ن",2,0],["مَلِكٌ يَمْلأُ العُيُونَ بَهَاءً،","حينَ يَبْدُو في تَاجِهِ المَعْقُودِ",53,"د",1,0],["مَلِكٌ يَدْرَأُ الإسَاءَةَ بالعَفْ","وِ وَيَجْزِي الإحسانَ بالإحسانِ",54,"ن",1,0],["ملكَ يدٍ من فضل ربٍّ ذي سَعَه","بل ليتني أسمع تلك القَعْقَعه",55,"ع",2,0],["ملك يجدِّلُ مَنْ يشاءُ بسيفهِ","الماضي وينبُو عنه كل حُسَامِ",56,"م",1,0],["مَلِكٌ يَطلُبُ المُلوكُ رِضاهُ","مِثلَما يَطلَبُ العَليلُ الشِفاءَ",57,"ا",2,0],["ملكَ يدبرهُ المهيمنُ لا تخفْ","فيه على الآرا من العَثراتِ",58,"ت",1,0],["ملك يرى عرض البسيطة فرسخاً","ويرى البحار مخاضة فيخوضُ",59,"ض",1,0],["ملك يرى في أريحية عمره","رأي الكهول ونجدة الشجعان",60,"ن",1,0],["مَلِكٌ يَعُدُّ الذِكرَ عَقباً صالِحاً","وَيَرى المَآثِرَ أَشرَفَ البُنيانِ",61,"ن",1,0],["مَلِكٌ يُسابِقُ وَعْدَهُ إِنْجازُهُ","وَيَجُودُ مُبْتَدِئاً بِما لَمْ يُسْأل",62,"ل",1,0],["ملَكَين في دُنيا الغرامِ","منَ الملائكَةِ الخيارِ",63,"ر",1,0],["مَلْكٌ يُديِر رَحَى الهيجا بخِنْصَرِهِ","أفنى الطغاةَ بضربٍ السُمّرِ والقُضُبِ",64,"ب",1,0],["مَلِكٌ يَحِلُّ مِنَ الخِلا","فَةِ في ذُرى عَليائِها",65,"ا",3,0],["مَلِكٌ يُجيرُ مِنَ الحَوادِثِ جارَهُ","وَيُخيلُ سائِلُهُ دُعاءَ السائِلِ",66,"ل",1,0],["مَلِكٌ يَبيتُ اّلوَفدُ مِن أَلطافِهِ","وَنَداهُ بَينَ مَرابعٍ وَحِياضِ",67,"ض",1,0],["مَلِكٌ يَشتَري القَليلَ مِنَ الحَم","دِ بِمَعروفِهِ الجَزيلِ الكَثيرِ",68,"ر",1,0],["ملكٌ يسيرُ السعدُ حولَ رِكابهِ","فكأنَّه من جُملةِ الحُرّاسِ",69,"س",1,0],["ملّكي الصبّ مقاليد الحمى","فبه يغدو لكلّي موطنا",70,"ن",2,0],["مَلِكٌ يَرَى دِيناً ودُنْيا أنْ تَرَى","أدْنَى مَوَاهِبه بُيُوتُ الْمَالِ",71,"ل",1,0],["مَلَكِيَّةٌ أخْلاقُهُ فَكَأنهُ","مَا صِيغَ في الأمْلاكِ مِنْ صَلْصالِ",71,"ل",1,0],["مَلِكٌ يَدعُو نَداه الجَفلَى","حينَ لا تَدعُو الملوكُ النَّقَرى",72,"ر",2,0],["مَلْكٌ يجلِّي عَن ثَناء الحامِد","وأينَ وَصْفُ شاكِرٍ مِن شاكِد",73,"د",1,0],["ملك يريه الحزم أن منامه","خطأ فليس لعينه إغفاءُ",74,"ا",2,0],["مَلْكٌ يَصدُّ بِنُعماهُ القلوبَ على","ماهَذَّبتْهُ بهِ آباؤهُ الصِّيدُ",75,"د",1,0],["مَلِكٌ يَحسِبُهُ مُبصِرُهُ","مَلَكاً شاكَلَ هَذَا الأنَسَا",76,"س",2,0],["مَلْكٌ يُديرُ مُلْكَ الأرضِ أَجمعِها","برأْيِ مُكْتَهِلٍ في عُمْرِ مُقْتَبِل",77,"ل",1,0],["مَلِكٌ يَقْتَفي الكرامَ ويَغْدو","عنْدَه الوفْدُ بالكَرامةِ يُقْفَى",78,"ف",2,0],["مَلِكٌ يَرِقُ على الرّعيّةِ رأْفةً","قَلْبٌ على الأموالِ منه قاس",79,"س",1,0],["مَلْكٌ يقودُ جنوداً من ملائكةٍ","في طاعةِ اللهِ لا يَعصُونَ ما أَمَرا",80,"ر",2,0],["مَلكٌ يظَلُّ مُحجَّباً من عزِّه","ونَداه مهما رُمْتَغُرمُحَجَّب",81,"ب",1,0],["مَلِكٌ يَشُبُّ لبأَسِه ولجودِهِ","ناريْنِ في الإصباح والإمساء",82,"ا",2,0],["ملك يمنن بالمال فقد","ألف المن ولا يعرف منا",83,"ن",2,0],["مَلِكٌ يفيضُ على العُفاةِ سِجالَهُ","وعلى العُداةِ بسَطْوِهِ سِجِّيلا",84,"ل",2,1],["ملك يُقِرُّ بِفَضلِهِ وَبِبَذلِهِ","وَبِعَدلِهِ أَصحابَهُ وَعِداهُ",