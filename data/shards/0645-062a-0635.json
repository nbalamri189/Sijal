{"poems":[[93,"يوم أثار كوامن الأشجان","https://www.aldiwan.net/poem11171.html","الكامل"],[51,"لا تكثرن ملامة العشاق","https://www.aldiwan.net/poem65525.html","الكامل"],[51,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"يا طول غلة نفسي المبلاه","https://www.aldiwan.net/poem66717.html","الكامل"],[85,"لا السهد يدنيني إليه ولا الكرى","https://www.aldiwan.net/poem63716.html","الطويل"],[43,"الرأي قبل شجاعة الشجعان","https://www.aldiwan.net/poem10580.html","الكامل"],[45,"كم من أخ لك لست تنكره","https://www.aldiwan.net/poem64539.html","الكامل"],[2,"لمن الديار بقنة الحجر","https://www.aldiwan.net/poem25056.html","الكامل"],[80,"جاءتك أولاد الوجيه ولاحق","https://www.aldiwan.net/poem31363.html","الكامل"],[80,"هل أنت فادية فؤاد عميد","https://www.aldiwan.net/poem31494.html","الكامل"],[105,"خلق العروبة أن تجد وتدأبا","https://www.aldiwan.net/poem42057.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[148,"حمل الفؤاد على الهوى وتحملا","https://www.aldiwan.net/poem68463.html","الكامل"],[235,"وهيب نجلي سقى الرباب","https://www.aldiwan.net/poem18058.html","مخلع البسيط"],[257,"كل يوم أروم أن أتملى","https://www.aldiwan.net/poem35504.html","الخفيف"],[280,"من منقذي من منقذي عشقه","https://www.aldiwan.net/poem32792.html","الكامل"],[362,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[369,"أترى بثار أم بدين","https://www.aldiwan.net/poem57099.html","مجزوء الكامل"],[374,"دنت العناصر من علائك","https://www.aldiwan.net/poem59306.html","مجزوء الكامل"],[403,"أحياه بعد الله إذ حياه","https://www.aldiwan.net/poem50091.html","الكامل"],[413,"طرف يراعي النجم وهو مؤرق","https://www.aldiwan.net/poem54166.html","الكامل"],[450,"لله يوم في طلائعه لنا","https://www.aldiwan.net/poem13845.html","مجزوء الكامل"],[456,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[513,"سفر الزمان بواشح من بشره","https://www.aldiwan.net/poem12098.html","الكامل"],[565,"أطلق عقال الروح بالراح","https://www.aldiwan.net/poem69760.html","السريع"]],"verses":[["مُتَصَرِّفاً فِيهَا تَصَرُّفَ عَادِلٍ","صَافِي السَّريرَةِ طَاهِرِ الإِعْلانِ",0,"ن",1,0],["متصعداً زفراته متحدّراً","عبراته أبداً قريح مآقي",1,"ق",2,0],["متصدٍّ لحاجةٍ لك قد أش","فَى جداه على شفاً مُنهالِ",2,"ل",1,0],["مُتصدٍّ لحاجةٍ لك قد أش","فَى نداه على شفىً منهالِ",3,"ل",1,0],["مُتصامِماً متكامهاً عن ربه","فرماهُ بالإصمام والإكماه",4,"ه",1,0],["مُتَصَوِّباً مُتَصَعِّداً مُتَمَهِّلاً","مُتَسَرِّعاً مُتَسَلسِلاً مُتَعَثِّرا",5,"ر",2,0],["مُتَصَعلِكينَ عَلى كَثافَةِ مُلكِهِم","مُتَواضِعينَ عَلى عَظيمِ الشانِ",6,"ن",1,0],["مُتَصَنِّعٌ لَكَ في مَوَدَّتِهِ","يَلقاكَ بِالتَرحيبِ وَالبِشرِ",7,"ر",1,0],["مُتَصَرِّفٍ لِلمَجدِ مُعتَرِفٍ","لِلنائِباتِ يَراحُ لِلذِكرِ",8,"ر",1,0],["مُتَصيِّدٍ برياضةٍ وطلاقةٍ","في تيه معشوقٍ وطاعة عاشقِ",9,"ق",1,0],["مُتَصرّفُ الكَفّيْنِ في شُغُلِ العُلى","لَم يَخلُ من بَذلٍ وَمِن تَشييدِ",10,"د",1,0],["مُتصنِّعٌ باسْمِ الضّعيفِ يُريقُها","وهو الذي ترك الضّعيفَ مُعذَّبا",11,"ب",2,0],["مُتَصَدِّياً لِلْقُدْوَةِ المُثْلَىَ وَمَا","زَالَ السَّرَاةُ مَنَائِرَ الدَّهْنَاءِ",12,"ا",2,0],["متصرف في الحرب كيف تصرفت","متنقل بالجود حيث تنقلا",13,"ل",2,0],["مِتَّ صَغيراً وَإِنَّ وَجْدِي","بِكَ يَجِلُّ عَنِ الْحِسَابْ",14,"ب",1,0],["متّ صبراً فلمتها فأجابت","لا تلمني فالاجتماع مقدّرْ",15,"ر",1,0],["مُتَصَرِّفٌ في سَلبِ أَلبابِ الوَرى","فَكَأَنَّما هُوَ في التَصَرُّفِ جهبذُ",16,"ذ",1,0],["مُتَّصِلٌ فَل يَرتَقِبهُ الحاسِدُ","فَإِنَّما مَبدَأُ أَلفٍ واحِدُ",17,"د",1,0],["مُتَصرِّفاً بالشِّعرِ يا","بئسَ البِضاعَةِ في اليَدينِ",18,"ن",1,0],["متصدراً في عرشك ال","عالي المنيع بكبريائك",19,"ك",1,0],["مُتَصَرِّف أَنّى يَشاءُ بِرأيِهِ","وَيَمينه لا في يَمين سِواهُ",20,"ا",2,0],["متصرّف في البأس حيث وجدته","ما زالَ يفتق ما يشاء ويرتق",21,"ق",1,0],["متصاعِدٌ متراجعٌ","متدافع للعين واقفْ",22,"ف",1,0],["متصوِّب القدمين خفّاق الحشا","في حيث يثبت للقنا المتزعزعِ",23,"ع",1,0],["متصرف في طاعة الملكين في","ما رامه من نفعه أو ضره",24,"ر",2,0],["مُتَصَرّفاً في الجِدّ أَحْ","ياناً وَطَوْراً في المُزَاحِ",25,"ح",1,0]]}