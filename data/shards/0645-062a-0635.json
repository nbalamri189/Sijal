dhabi.ae/diwan/poem/90874","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90842","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91020","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90868","الكامل"],[4378,"","https://poetry.dctabudhabi.ae/diwan/poem/99843","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58103","الرجز"],[4988,"رحيل ومحطات","https://www.poetsgate.com/ViewPoem.aspx?id=215968",""],[5057,"لو كنتُ أدري","https://www.poetsgate.com/ViewPoem.aspx?id=203663",""],[585,"تلك القبور وماثل الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=161873",""],[5213,"ضرب الرواق يقيم مأتم جده","https://www.poetsgate.com/ViewPoem.aspx?id=170553",""],[5281,"وفاءُ التَّاريخِ","https://www.poetsgate.com/ViewPoem.aspx?id=200243",""],[5307,"يعِلك لِه الكَسْبَاني","https://www.poetsgate.com/ViewPoem.aspx?id=10537",""],[5409,"للحر بطن الأرض أجدى","https://www.poetsgate.com/ViewPoem.aspx?id=155492",""],[5431,"متصلٌ فيَّ ومااتصلا","https://www.poetsgate.com/ViewPoem.aspx?id=185184",""],[5431,"ولكم خشعت..","https://www.poetsgate.com/ViewPoem.aspx?id=185262",""],[5431,"العين (ع)","https://www.poetsgate.com/ViewPoem.aspx?id=205592",""],[5431,"ولربّ جهلٍ قد قتلْ!","https://www.poetsgate.com/ViewPoem.aspx?id=214015",""],[5948,"عَجَباً لأحمدَ والعجائبُ جمَّةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=100609",""],[5956,"شكراً لكرَم حفيدي فيصل","https://www.poetsgate.com/ViewPoem.aspx?id=193145",""],[6102,"غُربَةُ الزَّمَكان!","https://www.poetsgate.com/ViewPoem.aspx?id=186283",""]],"verses":[["مُتَصَرِّفاً فِيهَا تَصَرُّفَ عَادِلٍ","صَافِي السَّريرَةِ طَاهِرِ الإِعْلانِ",0,"ن",1,0],["متصعداً زفراته متحدّراً","عبراته أبداً قريح مآقي",1,"ق",2,0],["متصدٍّ لحاجةٍ لك قد أش","فَى جداه على شفاً مُنهالِ",2,"ل",1,0],["مُتصدٍّ لحاجةٍ لك قد أش","فَى نداه على شفىً منهالِ",3,"ل",1,0],["مُتصامِماً متكامهاً عن ربه","فرماهُ بالإصمام والإكماه",4,"ه",1,0],["مُتَصَوِّباً مُتَصَعِّداً مُتَمَهِّلاً","مُتَسَرِّعاً مُتَسَلسِلاً مُتَعَثِّرا",5,"ر",2,0],["مُتَصَعلِكينَ عَلى كَثافَةِ مُلكِهِم","مُتَواضِعينَ عَلى عَظيمِ الشانِ",6,"ن",1,0],["مُتَصَنِّعٌ لَكَ في مَوَدَّتِهِ","يَلقاكَ بِالتَرحيبِ وَالبِشرِ",7,"ر",1,0],["مُتَصَرِّفٍ لِلمَجدِ مُعتَرِفٍ","لِلنائِباتِ يَراحُ لِلذِكرِ",8,"ر",1,0],["مُتَصيِّدٍ برياضةٍ وطلاقةٍ","في تيه معشوقٍ وطاعة عاشقِ",9,"ق",1,0],["مُتَصرّفُ الكَفّيْنِ في شُغُلِ العُلى","لَم يَخلُ من بَذلٍ وَمِن تَشييدِ",10,"د",1,0],["مُتصنِّعٌ باسْمِ الضّعيفِ يُريقُها","وهو الذي ترك الضّعيفَ مُعذَّبا",11,"ب",2,0],["مُتَصَدِّياً لِلْقُدْوَةِ المُثْلَىَ وَمَا","زَالَ السَّرَاةُ مَنَائِرَ الدَّهْنَاءِ",12,"ا",2,0],["متصافين على نعمائه","ليس في الجنّة إلاّ الأصفياء",13,"ا",2,0],["متصرف في الحرب كيف تصرفت","متنقل بالجود حيث تنقلا",14,"ل",2,0],["مِتَّ صَغيراً وَإِنَّ وَجْدِي","بِكَ يَجِلُّ عَنِ الْحِسَابْ",15,"ب",1,0],["متّ صبراً فلمتها فأجابت","لا تلمني فالاجتماع مقدّرْ",16,"ر",1,0],["مُتَصَرِّفٌ في سَلبِ أَلبابِ الوَرى","فَكَأَنَّما هُوَ في التَصَرُّفِ جهبذُ",17,"ذ",1,0],["مُتَّصِلٌ فَل يَرتَقِبهُ الحاسِدُ","فَإِنَّما مَبدَأُ أَلفٍ واحِدُ",18,"د",1,0],["مُتَصرِّفاً بالشِّعرِ يا","بئسَ البِضاعَةِ في اليَدينِ",19,"ن",1,0],["متصدراً في عرشك ال","عالي المنيع بكبريائك",20,"ك",1,0],["مُتَصَرِّف أَنّى يَشاءُ بِرأيِهِ","وَيَمينه لا في يَمين سِواهُ",21,"ا",2,0],["متصرّف في البأس حيث وجدته","ما زالَ يفتق ما يشاء ويرتق",22,"ق",1,0],["متصاعِدٌ متراجعٌ","متدافع للعين واقفْ",23,"ف",1,0],["متصوِّب القدمين خفّاق الحشا","في حيث يثبت للقنا المتزعزعِ",24,"ع",1,0],["متصرف في طاعة الملكين في","ما رامه من نفعه أو ضره",25,"ر",2,0],["مُتَصَرّفاً في الجِدّ أَحْ","ياناً وَطَوْراً في المُزَاحِ",26,"ح",1,0],["مُتصرّف أعماله ال","حسنى مَدى الأيّام نَشكُر",27,"ر",1,0],["متصعّدُ الأنفاسِ راحةُ قلبهِ","وَصلُ الأحبّةِ والفراق شقاؤهُ",28,"ا",3,0],["مُتَصَبِباً مُتَغَزِلاً مُتَنَقِلاً","مِن رَوضَةٍ غَنا إِلى بُستانِ",29,"ن",1,0],["متصعد الأَنفاس عَن زفراته","حاني الضلوع عَلى فُؤاد خافق",30,"ق",1,0],["متصل حاشا حمارا منقطع","وغير موجب بوصل أو قطع",31,"ع",1,0],["متصرفٌ صرف الظَلومَ مكدَّراً","عنا وطوَّق بالصفا المظلوما",32,"م",2,0],["متصرف السلط الذي صرف العنا","عنا بجيش نواله الجرار",33,"ر",1,0],["متصلاً طُولا فحركتهُ","لم يضطرب عبراً إلى عبر",34,"ر",1,0],["مُتَصَوِّرٌ ما في الخواطِر عالِمٌ","فَحْوى المُخاطِب مُفْحِصاً ومُعَرِّضا",35,"ض",2,0],["مُتَصِّرفٌ عن طاعة المَلِكين في","ما رامَهُ من نَفْعِه أَو ضَرّهِ",36,"ر",2,0],["متصلباً للحق غير مصانعٍ","متعصباً للصدق غير مبال",37,"ل",1,0],["متصاعدٌ من كل فجٍّ حاملٌ","شكوى يرجعها الصدى ترجيعا",38,"ع",2,0],["متصرف الفيحاء جاء وقبله","قد كنت منعطفا على متصرف",39,"ف",1,1],["متصرفا في جمعهم بعوامل","عادت بجمعهم الصحيح مكسرا",40,"ر",2,0],["متصفاً بين الأنام بالتقى","فغدروا بهِ ضلالاً وشقا",41,"ق",2,0],["متصاوِنٌ خَفِرٌ إِذا ناطقتَهُ","أَغضى حَياءً في سَكون وَقارِ",42,"ر",1,0],["متصاعداً الصيحات مسلوب النهى","متخبطاً في ساعة نكراء",43,"ا",2,0],["متّصلُ النتائج الذي حوى","يكون أو مفصولها كل سوا",44,"س",3,0],["متصاعدَ الزفراتِ حَي","ثُ يسير في الدوِّ المباحْ",45,"ح",1,0],["متصرفاً وله القضاء مصرّف","ومكلفاً وكأنه مختار",46,"ر",1,0],["مُتَصَرِفاً بِعَدالَةٍ طَبَعت بِهِ","وَبَسالَةٍ مُزجَت بِصَفوِ لبانِهِ",47,"ن",2,0],["متصاغراً حتى إذا","ثنيت وسادته تفرعن",48,"ن",1,0],["متصبب شؤبوب حكمته","بالعذب لا بالآجن المر",49,"ر",1,0],["متصرف فيما يشاء إذا قضى","أمراً مضى بجوازم الأحكام",50,"م",1,0],["متصرف بالأمر حيث يشاؤه","إذ لا مرد لما أراد وسددا",51,"د",2,0],["متصرف فيما يشاء إذا قضى","أمراً فذاك الأمر حكم محكم",52,"م",1,0],["متصرف فيما يشاء فلا مر","دولا انتقاض لما أراد وسددا",53,"د",2,0],["متصرفا أبدا لطاعة أمره","تأتي الأمور على اثم مراد",54,"د",1,0],["متصرف ذو همة اضحى لها","فوق الثريا منزل ومكان",55,"ن",1,0],["متصرف فيما يشا","ء فأمره السيف المهند",56,"د",1,0],["متصرفاً للحمد محتملاً","للقل فعلك فاضل جزل",57,"ل",1,0],["مُتَّصِلٍ مُؤيَّدٍ غير مبيدٍ زائلِ","تُنْبِيكَ عني بلا عملي وسائلي",58,"ل",2,0],["متصدرين اترند في رسم الاهات","ومن العهر لا عذر ونقول راظين",59,"ن",1,0],["مُتَصبِّرٌ بِ ( عَسَى ) و( ليتَ ) و( رُبما )","والحزنُ يفضحُنِيْ على الأشهادِ",60,"د",1,0],["متصرفٌ في الكون غيرُ مفرطٍ","يبني الجديد من القديم البالي",61,"ل",2,0],["متصورا في دسته فكأنه","شخص النبي مخاطبا ومكلما",62,"م",2,0],["مُتَصَرِّفٌ في العالمينَ بِعلمِه","وَيُحرِّكُ الافلاكَ كَيفَ يَشاءُ",63,"ا",2,0],["مِتْصَوِّبْ أوْ وَلْهَاني","مِن صَدَّاتْ الحَبيبْ",64,"ب",1,0],["متصلب بالذود عز","ماً مثل صم الصخر صلدا",65,"د",2,0],["متصلٌ فيَّ ومااتصلا","نصْلُ الأحبابِ ومارحلا",66,"ل",2,1],["متصوفٌ ولهٌ وفيه قبلتي","ولكَم سجدتُ مولعا للقاه",67,"ا",2,0],["متصوّف مم استشف من الأُلى","ومقامه عينٌ لهم أيقونة !!",68,"ن",2,0],["متصببٌ في راحتيك كيانها","متسارعٌ نبضُ الحفاوة بالقبلْ",69,"ل",1,0],["مُتصرفُ للنَّوكِ في غُلوائِه","زمر المروءة جامح في المسحل",70,"ل",1,0],["متصرفٌ بطبيعةٍ مرموقةٍ","كأبيه وقْتَ الجِدِّ والألعابِ",71,"ب",1,0],["مُتَصَحِّرٌّ قَبَضَ السَّرابُ رِهانَهُ","وَجهًا! لِيُثبِتَ ظِلُّهُ بُرهانَهُ!",72,"ن",2,1]]}