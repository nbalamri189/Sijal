.dctabudhabi.ae/diwan/poem/120198","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120496","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35100","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139658",""],[4728,"اليعربيّة","https://www.poetsgate.com/ViewPoem.aspx?id=176947",""],[4757,"قَالَ محبوبي بقدي","https://www.poetsgate.com/ViewPoem.aspx?id=189299",""],[5031,"حب على ابواب الوطن المذبوح","https://www.poetsgate.com/ViewPoem.aspx?id=147674",""],[5186,"قلب الدهر اختيارا","https://www.poetsgate.com/ViewPoem.aspx?id=156521",""],[5237,"أنا عبد عبد محبكم","https://www.poetsgate.com/ViewPoem.aspx?id=113112",""],[5277,"صَلُّوا عَلَيْهِ وَسَلِّمُوا تَسْلِيمًا","https://www.poetsgate.com/ViewPoem.aspx?id=200675",""],[5413,"عاد حلما","https://www.poetsgate.com/ViewPoem.aspx?id=208942",""],[5431,"(يمّه)...لك أمة..","https://www.poetsgate.com/ViewPoem.aspx?id=195023",""],[5431,"والشعر بحرٌ طائرٌ في أربعه!!","https://www.poetsgate.com/ViewPoem.aspx?id=197923",""],[5431,"مهجة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=205811",""],[243,"ليلة القدر","https://www.poetsgate.com/ViewPoem.aspx?id=20959",""],[5691,"قالها شافيز...!","https://www.poetsgate.com/ViewPoem.aspx?id=207080",""],[4623,"لست أحصي على النبي ثناء ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146852",""],[4615,"وبنفسي منء لا أسميهِ إِلا","https://www.poetsgate.com/ViewPoem.aspx?id=17851",""],[5845,"ألسيعُ صلِّ مالهُ منْ راقِ","https://www.poetsgate.com/ViewPoem.aspx?id=16699",""],[1920,"نظارة الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=191732",""],[5956,"الودُّ الأخوي","https://www.poetsgate.com/ViewPoem.aspx?id=192947",""],[5956,"لهفي عليه ككل حر سابح","https://www.poetsgate.com/ViewPoem.aspx?id=192994",""],[5956,"سندرا أمُّ الجميع","https://www.poetsgate.com/ViewPoem.aspx?id=193161",""],[5956,"الطائرة المنكوبة","https://www.poetsgate.com/ViewPoem.aspx?id=193917",""],[5956,"إلى كل بطل مجهول","https://www.poetsgate.com/ViewPoem.aspx?id=202506",""],[6152,"وحدي معه","https://www.poetsgate.com/ViewPoem.aspx?id=205877",""],[5190,"لا تغضبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85043&r=&rc=118",""]],"verses":[["هو والله سابق ليَ برًّا","وثناءً وغيره المسبوق",0,"ق",1,0],["هُوَ واحِدٌ في المَكرُماتِ وَإِنما","يَكفيكَ عادِيَةَ الزَمانِ الواحِدُ",1,"د",1,0],["هُوَ وَفدُهم وهمُ الفريقُ الطَّيِّبُ","ما فَاتَهم من كلِّ خيرٍ مَطْلَبُ",2,"ب",1,1],["هَوَوْا من حصنِهِم وكذاك تَهوي","وتهبطُ من مَعاقِلها الوُعولُ",3,"ل",1,0],["هُوَّوا لَنا زُمَراً مِن كُلِّ ناحِيَةٍ","كَأَنَّما فَزَعُوا مِن نَفخَةِ البُوقِ",4,"ق",1,0],["هُوَ وَلَّى أهْلَ الخيانَةِ فما","وَتَوَلَّى ال الخَوَّانِ",5,"ن",1,0],["هو والجبال وأرض مَديَن همد","ودنا فخر إلى الجبين محمد",6,"د",1,0],["هو والعراق الحر مه","د هوى وأيكة عندليب",7,"ب",1,0],["هو والنصرُ حليفان؛ فما","سار، إلا وهْوَ يمشي في خُطاهْ",8,"ا",2,0],["هُو وَلَّى أهْلَ الخِيَانَة ِ فيها","وتَوَلِّي الجَوادِ كالخَوَّانِ",9,"ن",1,0],["هو والاولى زهر العشبرة اهله","آل الوصي ايمتي وحماتي",10,"ت",2,0],["هو وادٍ أودى بحالي للسق","م وأبدى خوارق العادات",11,"ت",1,0],["هو والٍ عدلٌ يجورُ على الما","ل كأنَّ الأموال من أَعْدَائه",12,"ا",3,0],["هو واحدٌ والناسُ طُرّا بعضُه","ما عازَه في الخلق غيرُ عَديله",13,"ل",2,0],["هو وافدٌ وافَى لينصر عِزُّه","نورَ النبوةِ مُعْرِبا عن فضلها",14,"ل",3,0],["هو وقارٌ ونذير للذي","يأتيه والكلّ مرتجيه",15,"ه",1,0],["هوَ والآلُ في الورى ثَقَلانِ","مِن ضلالٍ للناسِ خير أمانِ",16,"ن",1,0],["هو واللَه فوق كلّ مديحٍ","أَنشَدتهُ الرواةُ والشعراءُ",17,"ا",2,0],["هُوَ واهب الاعناق يوم الجودبل","يَوم الكَريهة ضارب الاعناق",18,"ق",1,0],["هُوَ واحِدُ الدُّنيا وَمَن لَمْ يَرْضَهُ","فَلْيَأتِ في الدّنْيَا لَهُ بِمِثالِ",19,"ل",1,0],["هو واللّه ما عَلِمنا ولكن","ربَّ وهمٍ غطّى على برهانِ",20,"ن",1,0],["هو والأعزّةُ من بَنيه دائماً","كالبَدْرِ وَسْطَ الشُهْبِ في ظَلمْائه",21,"ا",3,0],["هووك وما رأوك لطول وصفي","فقد عانوا لفقدك ما أعاني",22,"ن",2,0],["هو واللّه بغيتي ومرادي","وفؤادي في حبه قد تعبد",23,"د",1,0],["هو والفصاحة والشجاعة والندا","والعز والعليا رضيع لبان",24,"ن",1,0],["هو واصِمٌ لا واسِمٌ","فاجعل إباءَكَ منه عاصم",25,"م",1,0],["هو واحدٌ بالعين إلا أنه","يُربي على الآلافِ ساعة عدِّه",26,"د",2,0],["هو واحدُ العَليا وواحدُها الذي","ألقابُه وصفاتُه تتعدَّدُ",27,"د",1,0],["هو والعلياءُ دامَ الش","مْلُ نارٌ ومَنارُ",28,"ر",1,0],["هو واحدٌ من شعبه لم يغترر","يوماً ولا مجدٌ لديه مُعارُ",29,"ر",1,0],["هو والحياةُ غداةَ جودٍ واحدٌ","والموت وهوَ إذا سطا أخوان",30,"ن",1,0],["هو والقرين شهره وختامه","كل غدا في العالمين معظما",31,"م",2,0],["هو واهب الخيرات والقود العرا","مس في اللهى والسابح الذيال",32,"ل",1,0],["هو واحد وهو الوجود وغيره","عدم كثير ليس يحصى مظلم",33,"م",1,0],["هو واحد في ملكه","والخلق أجمعهم جنود",34,"د",1,0],["هو وَعْدٌ قد كان لي وسُؤَالِي","مِنْكَ إِنْجازُ ذَلِك الميعاد",35,"د",1,0],["هو واللّه منصف","زوجه زوج زوجتهْ",36,"ه",1,1],["هو واحد في جمعه متفرد","وبفرقه متعدد اثنان",37,"ن",1,0],["هو واحد في واحد آحاده","جلت فلا تحصى ولا هي تحصر",38,"ر",1,0],["هو والفضائل ديمة وحديقة","والناس عين نحوه ونيام",39,"م",1,0],["هو والفضائل كالربيع ونوره","وانا وغيري للربيع مشوق",40,"ق",1,0],["هَوَوا بِالهَوى العُذري كلّ فَضيلَةٍ","وَلَم يَهتَووا أَمثاَل عَزَّةَ أَو دَعدِ",41,"د",1,0],["هو واحد في المكرمات وجحفل","من باسه يوم الوغى جرار",42,"ر",1,0],["هو والحسينُ كلاهما قمرا عُلى","في فتيةٍ هم أنجم الآفاقِ",43,"ق",1,0],["هو والحسينُ بمجده قمرا عُلاً","كلٌّ عن الدنيا جلا أسدافَها",44,"ف",3,0],["هو واحد التقوى الذي","هي بعد مولده عقيم",45,"م",1,0],["هو والحسين من العلا","ءِ كلاهما عنقٌ وصهوه",46,"و",2,0],["هو واحد في فضله وفخاره","وانظر اليه تجد سلمت خميسا",47,"س",2,0],["هووا إلحاقه بيني أبيه","ويأبى اللَه إلا أن ينجى",48,"ج",2,0],["هُوَ وَمضُ الحَياءِ في غَيهَبِ البَغ","يِ وَفَيضٌ مِنَ المَعاني الجَليلَه",49,"ل",2,0],["هو وابن التي ترى كل عضو","فيه سل البغيّ من أعضاها",50,"ا",3,0],["هُوَ وَاسِعُ العَينَينِ أَكحَلُ ذًودَعَج","هُوَ أَهدَبُ الأشفارِ رَبُّ المفتَخَر",51,"ر",1,0],["هُوَ والنَّدَى أخوان في مهد النّهى","بيد المروءة أرضعا بِلِبَان",52,"ن",1,0],["هو وصل الأحباب في يوم سلمٍ","وهو يوم الهياج سمّ الحُبابِ",53,"ب",1,0],["هو واحد ما لم يحدّ بسيره","فإذا يسافر فهو في الأموات",54,"ت",1,0],["هُو وَاحِدٌ فِي وَصفِهِ وَعُلُوهِ","مَا لِلوَرَى رَبٌّ سِوَاهُ ثَانِ",55,"ن",1,0],["هُوَ وحدوِيُّ الفِكْرِ في عليائِهِ","نورٌ يقودُ الرُّشْدَ بالإِرشادِ",56,"د",1,0],["هو واحدُ الآحاد إلا أنه","عند القيام غدا جَمِيعَ جميعِ",57,"ع",1,0],["هو واحدُ الدُنيا ومن بعلائِه","هذا الوَرى عَرفوا الآله ووحَّدوا",58,"د",3,0],["هووا للثرى نهب السيوف جسومهم","عوار ولكن بالمكارم ترتدي",59,"د",2,0],["هو وحش حذروا الفتيان منه والفتايا","أوثقوه فسل الناس لماذا أوثقوني",60,"ي",1,0],["هو وجه الهلال من غير شك","هو بدر التمام دون التباس",61,"س",1,0],["هو واد أو شئت قل هو دار","كل طود بجنبها كالجدار",62,"ر",1,0],["هو والطفل واحد","حين يهواه راغبه",63,"ب",2,0],["هو والركوع مرهفه سجودا","إذا ندباً له لهم أشارا",64,"ر",2,0],["هو والعلم فرقدان وكل","من سنا الفه له تزيين",65,"ن",1,0],["هو وابن عَصرونَ الطوي","ل ويوسف النَّذل اليهودي",66,"د",2,0],["هُوَ وَالزَمان إِذا تنكّر حادِث","قرنان لَكِن سيّد وَمسودُ",67,"د",1,0],["هووا بالعرا تحت العوالي جسوءهم","عليها المواضي والرماح عكوف",68,"ف",1,0],["هووا إلى الأرض ولكن عرجت","نفوسهم وضمنتها الحجب",69,"ب",1,0],["هو واحد مثنى الهبا","ت وثالث للنّيرين",70,"ن",1,0],["هو والخنجر في أحشائه","شبح للياس يعلوه الدم",71,"م",1,0],["هو والافضال روض وصبا","هو والعلياء عقد وعنق",72,"ق",1,0],["هو والاملاك ان قيسوا به","مهيع بين بنيات الطرق",72,"ق",1,0],["هو وعدٌ لذي الجلال قديم","أنه كان وعده مفعولا",73,"ل",2,0],["هُوَ وادٍ لِلمَوتِ يَنشُرُ فيهِ","شِبَه دُنيا تَفنى وَشِبهَ حَياةِ",74,"ه",1,0],["هُوَ والباسِلُ العَزُومُ مَنيلا","عن جَمِيعِ الجُنُودِ يَقتِتلانِ",75,"ن",1,0],["هو وصف لم يكفنا النثر فيه","فاستعنَّا عليه بالأَشعارِ",76,"ر",1,0],["هو واحد ما بين اهل زمانه","كالبدر في افق السما لم يجحد",77,"د",1,0],["هو واحد الدنيا وإن","قالوا له ثان فلا",78,"ل",2,0],["هُوَ والدٌ للشَّعبِ لا ملكٌ، لهُ","نُصُبٌ تُزانُ بِنَصبهِ الأحياءُ",79,"ا",2,0],["هو واحد الاحاد لا تلقى له","فيما حواه من الخلائق ثانيا",80,"ي",2,0],["هو واحد الدنيا فلا تطلب له","في العادلين مشاكلا وعديلا",81,"ل",2,0],["هُوَ وَالظَبيُ في الجَمالِ سَواءٌ","ما اِستَعارَ الغَزالُ مِنهُ اِستَعارَه",82,"ر",2,0],["هو واحد الآحاد عند الواحد ال","أحدِ الذي قد ندّ عن تحديده",83,"د",2,0],["هو واقعٍ به من الإعجاز شيءٍ كثير","فلم ترى الناس بدعٍ مثله ولن ترى",84,"ر",2,0],["هُوَ وَالله وحيد","جلّ عَن مثل وند",85,"د",1,0],["هُوَ (وَاحِدٌ) في الوَجْدِ يَخْسَرُ عُمْرَهُ","تَوْقَاً لرمْشٍ يَسْتَديرُ هِلالا",86,"ل",2,0],["هو والأولاد يطو","ون إلى الزاد افتقارا",87,"ر",2,0],["هو والذي برأ الورى","إكسير أرباب النهى",88,"ا",1,0],["هو واللذَينَ بجانبيهِ أحبتي","بهمُ الهدايةُ والشفاعةُ والندى",89,"د",2,0],["هو والليلُ يُضاهي خوفه","شاعرٌ ملَّ منَ الشَّكْلِيَّة",90,"ه",1,0],["هو وردتي بالحب تهمي ..أرتوي","هو جدول العشق الزلال ويمّه",91,"م",2,0],["هو والقصيدة في لقاء دائم","يحيا بقلب هائم كي تتبعه",92,"ع",2,0],["هو وجه البحور في ملح دمعٍ","هو قطْرُ الحلاوة ال....ظلّ دبقا",93,"ق",2,0],["هووا الى قاع بئر قرار لها","مستمسكين بحبل من دم خضبا",94,"ب",2,0],["هُوَ وهْمٌ لمْ نَزَلْ نسْعى لَهُ","وسَرابٌ نحْنُ مِنْ طُلابِهِ",95,"ب",2,0],["هو واسطة من الحق بين","الخلق في كل مالهم قد جاء",96,"ا",2,0],["هو والظبيُ في المجالِ سَوَاءٌ","ما استعارَ الغزالُ منه استعارهْ",97,"ر",2,0],["هوَ واهبُ الأعناقِ يومَ الجودِبلْ","يومَ الكرية ِ ضاربُ الأعناقِ",98,"ق",1,0],["هو واعظ ومعلّم وكفى به","لليائسين مؤدّبا ومعلّما",99,"م",2,0],["هو وُدّه لي لم يكَوَّنْ مُطْلقاً","من سوءِ حظي الدائمِ المنحوسِ",100,"س",1,0],["هو واحد ممن أرادوا عزّة","للناسِ لكن جوبهوا بالقالِ..",101,"ل",1,0],["هو والصغار مصادر لسعادتي","والله يعلم أنني نضوُ الضنى",102,"ن",2,0],["هو واقعٌ نختاره لو روحنا اطّ","لَعَتْ على الغيبِ الذي هو خيرها",103,"ه",2,0],["هو واحدٌ ممن أرادوا عِزّة","للشعبِ لكن جوبهوا بالقالِ..",104,"ل",1,0],["هو وحده الباقي على ميثاقه","أتراه بعد عهوده سأضيعه !؟",105,"ه",1,1],["هُوَ وَاحَةٌ لا يَستَظِلُّ بِفَيِّهَا","إلاكِ ، مُذ عَصَفَ الغرامُ بِمَركَبِي",106,"ب",2,0]]}