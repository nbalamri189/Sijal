{"poems":[[72,"لرسوم الحمى عليه حقوق","https://www.aldiwan.net/poem19353.html","الخفيف"],[45,"وصل تقارب منه ثم تباعد","https://www.aldiwan.net/poem63466.html","الكامل"],[105,"هو وفدهم وهم الفريق الطيب","https://www.aldiwan.net/poem44002.html","الكامل"],[105,"ترامى الجيش واندفع الرعيل","https://www.aldiwan.net/poem44191.html","الوافر"],[40,"يا ليت ليلى رأتنا غير جازعة","https://www.aldiwan.net/poem42291.html","البسيط"],[67,"ليت شعري ما مقتضى حرماني","https://www.aldiwan.net/poem18113.html","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141981","الكامل"],[106,"تأميم القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179582",""],[67,"لَيْتَ شِعْرِي ما مُقْتَضَى حِرْماني","https://www.poetsgate.com/ViewPoem.aspx?id=14581",""],[113,"غاب الغرام تمكني وثباتي","https://www.aldiwan.net/poem41196.html","عموديه"],[113,"هات ذكر الغزالة الخود هات","https://www.aldiwan.net/poem41681.html","الخفيف"],[126,"قد قضى لي بالصد والهجر والبلوي","https://www.aldiwan.net/poem50479.html","الخفيف"],[183,"صلى الإله عليك يا بن رسوله","https://www.aldiwan.net/poem14639.html","الكامل"],[183,"إن الخلافة لم تزل عن أصلها","https://www.aldiwan.net/poem14645.html","الكامل"],[184,"ما الشيب إلا نعمة محمودة","https://www.aldiwan.net/poem43189.html","الكامل"],[187,"يا نبيا لدى الإله عظيما","https://www.aldiwan.net/poem35102.html","الخفيف"],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[269,"ودعتها والدمع يقطر بيننا","https://www.aldiwan.net/poem52117.html","الكامل"],[273,"بشراي هذا مبدأ الإقبال","https://www.aldiwan.net/poem25535.html","الكامل"],[303,"سائل النفس قبل فوت الأوان","https://www.aldiwan.net/poem56386.html","الخفيف"],[362,"يرمي فؤادي وهو في سودائه","https://www.aldiwan.net/poem58720.html","الكامل"],[400,"أجاب الدمع من قبل اللسان","https://www.aldiwan.net/poem33393.html","الوافر"],[400,"غصن شوق علاه قلبي وغرد","https://www.aldiwan.net/poem33977.html","الخفيف"],[426,"يا صاحبي من الملام دعاني","https://www.aldiwan.net/poem40502.html","الكامل"],[429,"عقدوا شعورهم عمائم","https://www.aldiwan.net/poem12340.html","مجزوء الكامل"],[429,"هذا مقام أبيك فاسم بمجده","https://www.aldiwan.net/poem12593.html","الكامل"],[429,"ماست فقيل هي القضيب الأملد","https://www.aldiwan.net/poem12594.html","الكامل"],[429,"أنجد الصب وغاروا","https://www.aldiwan.net/poem12645.html","مجزوء الرمل"],[451,"يا مالكا لا عن وراثة شامخ","https://www.aldiwan.net/poem61646.html","الكامل"],[462,"رفقاً بها يا سائق الأظعان","https://www.aldiwan.net/poem3197.html","عموديه"],[462,"هذا العقيق تلك أعلام الحمى","https://www.aldiwan.net/poem3211.html","عموديه"],[462,"قلبي بذاك الخال ليس بخال","https://www.aldiwan.net/poem3230.html","عموديه"],[556,"هو صبغة العدم الذي هو كلنا","https://www.aldiwan.net/poem33850.html","الكامل"],[556,"إني أنا بك يا ودود","https://www.aldiwan.net/poem34580.html","مجزوء الكامل"],[573,"سلام عليه لا على الدهر بعده","https://www.aldiwan.net/poem3075.html","الطويل"]],"verses":[["هو والله سابق ليَ برًّا","وثناءً وغيره المسبوق",0,"ق",1,0],["هُوَ واحِدٌ في المَكرُماتِ وَإِنما","يَكفيكَ عادِيَةَ الزَمانِ الواحِدُ",1,"د",1,0],["هُوَ وَفدُهم وهمُ الفريقُ الطَّيِّبُ","ما فَاتَهم من كلِّ خيرٍ مَطْلَبُ",2,"ب",1,1],["هَوَوْا من حصنِهِم وكذاك تَهوي","وتهبطُ من مَعاقِلها الوُعولُ",3,"ل",1,0],["هُوَّوا لَنا زُمَراً مِن كُلِّ ناحِيَةٍ","كَأَنَّما فَزَعُوا مِن نَفخَةِ البُوقِ",4,"ق",1,0],["هُوَ وَلَّى أهْلَ الخيانَةِ فما","وَتَوَلَّى ال الخَوَّانِ",5,"ن",1,0],["هو والجبال وأرض مَديَن همد","ودنا فخر إلى الجبين محمد",6,"د",1,0],["هو والعراق الحر مه","د هوى وأيكة عندليب",7,"ب",1,0],["هو والنصرُ حليفان؛ فما","سار، إلا وهْوَ يمشي في خُطاهْ",8,"ا",2,0],["هُو وَلَّى أهْلَ الخِيَانَة ِ فيها","وتَوَلِّي الجَوادِ كالخَوَّانِ",9,"ن",1,0],["هو والاولى زهر العشبرة اهله","آل الوصي ايمتي وحماتي",10,"ي",1,0],["هو وادٍ أودى بحالي للسق","م وأبدى خوارق العادات",11,"ت",1,0],["هو والٍ عدلٌ يجورُ على الما","ل كأنَّ الأموال من أَعْدَائه",12,"ا",3,0],["هو واحدٌ والناسُ طُرّا بعضُه","ما عازَه في الخلق غيرُ عَديله",13,"ل",2,0],["هو وافدٌ وافَى لينصر عِزُّه","نورَ النبوةِ مُعْرِبا عن فضلها",14,"ل",3,0],["هو وقارٌ ونذير للذي","يأتيه والكلّ مرتجيه",15,"ه",1,0],["هوَ والآلُ في الورى ثَقَلانِ","مِن ضلالٍ للناسِ خير أمانِ",16,"ن",1,0],["هو واللَه فوق كلّ مديحٍ","أَنشَدتهُ الرواةُ والشعراءُ",17,"ا",2,0],["هُوَ واهب الاعناق يوم الجودبل","يَوم الكَريهة ضارب الاعناق",18,"ق",1,0],["هُوَ واحِدُ الدُّنيا وَمَن لَمْ يَرْضَهُ","فَلْيَأتِ في الدّنْيَا لَهُ بِمِثالِ",19,"ل",1,0],["هو واللّه ما عَلِمنا ولكن","ربَّ وهمٍ غطّى على برهانِ",20,"ن",1,0],["هو والأعزّةُ من بَنيه دائماً","كالبَدْرِ وَسْطَ الشُهْبِ في ظَلمْائه",21,"ا",3,0],["هووك وما رأوك لطول وصفي","فقد عانوا لفقدك ما أعاني",22,"ي",1,0],["هو واللّه بغيتي ومرادي","وفؤادي في حبه قد تعبد",23,"د",1,0],["هو والفصاحة والشجاعة والندا","والعز والعليا رضيع لبان",24,"ن",1,0],["هو واصِمٌ لا واسِمٌ","فاجعل إباءَكَ منه عاصم",25,"م",1,0],["هو واحدٌ بالعين إلا أنه","يُربي على الآلافِ ساعة عدِّه",26,"د",2,0],["هو واحدُ العَليا وواحدُها الذي","ألقابُه وصفاتُه تتعدَّدُ",27,"د",1,0],["هو والعلياءُ دامَ الش","مْلُ نارٌ ومَنارُ",28,"ر",1,0],["هو واحدٌ من شعبه لم يغترر","يوماً ولا مجدٌ لديه مُعارُ",29,"ر",1,0],["هو والحياةُ غداةَ جودٍ واحدٌ","والموت وهوَ إذا سطا أخوان",30,"ن",1,0],["هو والقرين شهره وختامه","كل غدا في العالمين معظما",31,"م",2,0],["هو واهب الخيرات والقود العرا","مس في اللهى والسابح الذيال",32,"ل",1,0],["هو واحد وهو الوجود وغيره","عدم كثير ليس يحصى مظلم",33,"م",1,0],["هو واحد في ملكه","والخلق أجمعهم جنود",34,"د",1,0],["هو وَعْدٌ قد كان لي وسُؤَالِي","مِنْكَ إِنْجازُ ذَلِك الميعاد",35,"د",1,0]]}