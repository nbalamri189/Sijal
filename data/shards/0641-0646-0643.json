8,"","https://poetry.dctabudhabi.ae/diwan/poem/59255","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96714","الرمل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61054","المتقارب"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136175","الكامل"],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124026","الخفيف"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128714","الوافر"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114772","الطويل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46469","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203026","المتقارب"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112301","الطويل"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2570","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28679","الوافر"],[4674,"سباق","https://www.poetsgate.com/ViewPoem.aspx?id=207033",""],[4691,"\" أمّ الحَمَام \"","https://www.poetsgate.com/ViewPoem.aspx?id=158307",""],[4729,"أُتنكرين الحقَّ أختَ دَارمِ","https://www.poetsgate.com/ViewPoem.aspx?id=109473",""],[4779,"ولا يَجْزُون من خَيْرٍ بِشَرٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=213882",""],[585,"نظر المشيب إليك قبل أوان","https://www.poetsgate.com/ViewPoem.aspx?id=161877",""],[5324,"مرثيّة الغرم .","https://www.poetsgate.com/ViewPoem.aspx?id=207570",""],[5363,"الكرمة والدود","https://www.poetsgate.com/ViewPoem.aspx?id=144164",""],[5397,"زها زمنا روض الشبيبة مونقا","https://www.poetsgate.com/ViewPoem.aspx?id=157957",""],[5582,"إِنَّما نَوْحُ الحَمامِ","https://www.poetsgate.com/ViewPoem.aspx?id=63567",""],[5791,"نصٌّ مقلوب ..!","https://www.poetsgate.com/ViewPoem.aspx?id=213016",""],[199,"لَمَّا غَدَا الحَيُّ من صَرْخٍ وغَيَّبَهُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=22441",""],[6259,"بدا البرق من نجدٍ فحن إلى نجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59369&r=&rc=17",""]],"verses":[["فَنَكتُمُ ما يُخفي الضَميرُ تَحَفُّظاً","وَخَيرُ الهَوى ما كانَ يُخفى وَيُستَرُ",0,"ر",1,0],["فَنَكَّبَ حَوضى ما يَهُمُّ بِوِردِها","يَميلُ بِصَحراءِ القَنانَينِ جاذِلا",1,"ل",2,0],["فَنَكثُرُكُم فيهِ وَنَصلى بِحَرِّهِ","وَنَمشي إِلى أَبطالِهِ فَنُماصِعُه",2,"ع",2,0],["فَنَكونُ أَوَّلَ مُستَحِلِّ حَلالِهِ","وَمُحَرِّمٍ لِلَّهِ كُلَّ حَرامِ",3,"م",1,0],["فَنِكْتُهُ فرْديْنِ في واحد","عُجْباً بذاك الشادن الفرْدِ",4,"د",1,0],["فنكتَ أمَّك عني","بأير عير العُزيرِ",5,"ر",1,0],["فَنَكِرنَهُ فَنَفَرنَ وَاِمتَرَسَت بِهِ","سَطعاءُ هادِيَةٌ وَهادٍ جُرشُعُ",6,"ع",1,0],["فنكرعُ في مواردِه الطَّوامِي","ونسرحُ في مراتعِه الرِّحابِ",7,"ب",1,0],["فَنَكونُ أَوَّلَ مُستَحِلٍّ حِلَّهُ","وَمُحَرِّمٍ لِلّهِ كُلَّ حَرامِ",8,"م",1,0],["فنكّس راسَهُ وهدا","وبتّ الليلَ لم أنَم",9,"م",1,0],["فَنَكا في القَلبِ كَلماً","باطِناً ثُمَّ تَعَلّى",10,"ل",2,0],["فَنَكَّبَها كِسرى عَلى عِزِّ مُلكِهِ","وَما شاعَ مِنهُ مُكرَهاً غَيرَ طائِعِ",11,"ع",1,0],["فنكسوا رؤسهم واستحسنوا","ما قد رواه قبلها مستقبحا",12,"ح",2,0],["فَنَكَبّوا الصَوَّةَ اليُسرى فَمالَ بِهِم","عَلى الفَراضِ الجامِل الثَلِمُ",13,"م",1,0],["فنك ولو أمك واصفع ولو","أباك إن لامك في ذاكا",14,"ك",2,0],["فنكس رأسه أيري طويلاً","وفكر في الجواب عن السؤال",15,"ل",1,0],["فَنَكَّبا يَنقُفانِ البَيضَ عَن بَشَرٍ","كَأَنَّهُ وَرَقُ البَسباسِ مَغسولُ",16,"ل",1,0],["فنك وشانك وكن بالعلم عامل فعول","لا تحسب العلم يا مغرور تحسن تقول",17,"ل",1,0],["فنكر بِذي نَكرٍ إِذا اشتَجر القَنا","وعرف لآمالِ امرىء لَكَ مستجدي",18,"د",2,0],["فنّ كفنّك لن يفنى وإن بعدت","به السنون كبعد للأحباء",19,"ا",2,0],["فنكى نبضُ القلبِ أطوارَ عقْلٍ","كان باجتنابِ الهوى ما أقلَّهْ",20,"ل",2,0],["فنكّبوا إذا امتلأت غضبا","عنّيَ لا تلقون مني تعبا",21,"ب",2,0],["فنكبوا عنه وما قد أجلبوا","به عليكم فحلال طيب",21,"ب",1,0],["فنكون مملكتين كالاختين في","عهد وميثاق مدى الاجيال",22,"ل",1,0],["فنكاحُهنَّ زِنىً عليه وِزْرُه","لِعظيم ما بالجهل منه أبَاحَا",23,"ح",2,0],["فنكت به الأضداد نار أضرمت","في ماء خد مائر قران",24,"ن",1,0],["فَنَكَّرَ الهَجْرُ تَمْيِيزِي بِمَعْرِفَةٍ","وَأعْرَبَ الوَجْدُ أفْعَالِي بِأسْمَاكِ",25,"ك",1,0],["فَنكى جرحاً قديماً","بعدَ برءٍ واِلتِئامِ",26,"م",1,0],["فَنكرع في صَفو عَيش السرور","وَنَرتَع في ظله آمنينا",27,"ن",2,0],["فنكون فيها مستضيئين بها","في عصبة من سادة زهاد",28,"د",1,0],["فنكحنا تلك النواعم قسرا","وقسمنا كنوزهم أنفالا",29,"ل",2,0],["فنكّس راس أصنام ونصب","وسفّه راي أحلام ولب",30,"ب",1,0],["فنَكّب عَنهُم صرفُهُ المُتَسَحِّب","علوتِ فَما في الحُسنِ فوقك مُرتَقى",31,"ق",2,0],["فَنَكثت ما شَدَ الإِخاء عُقوده","وَمَزَجت بِالأَقذاء ماء صَفاء",32,"ا",2,0],["فنكبت عن وجهه جانباً","وإن راق منه لي المنظر",33,"ر",1,0],["فَنَكّبتُ عن صِدقِ الزّمانِ لأنّني","رأيتُ زماني عن هوَى الصّدقِ ناكبا",34,"ب",2,0],["فَنَكَّبتَ عَنّي الشارِعينَ وَلَم أَكُن","مَخافَةَ شَرِّ الشارِعينَ أَنامُ",35,"م",1,0],["فَنَكَّسَ ناظِراً في ظَه","رِ كَفٍّ يُنبِتُ العَنَما",36,"م",2,0],["فنكبر في كل غمزة عينٍ","ونجمع من هِمّة الروح مهرا",37,"ر",2,0],["فنَكْشِفُ ما ستَرَتْهُ الليالي","ألَذُّ الغرامِ الذي أُظْهِرا",38,"ر",2,0],["فنكس التيجانَ عن رُؤوسها","ما راعَ مِنْ بطشِ ذوي العمائمِ",39,"م",1,0],["فَنَكَّبَ عَنْهُمُ دَرْءَ الأَعادِى","وداوَوْا بالجُنْونِ منَ الجُنُونِ",40,"ن",1,0],["فنكصت أخسأ ما نكصت مزلزلاً","من روعة الملكوت في الأكوان",41,"ن",1,0],["فنكرتِ ما حملت اليكِ من الهوى","وجحدتني ..وسعيتِ بي لهلاكي",42,"ك",2,0],["فنكست أطرافي لتثبت عاليا","فلك السموُّ وأصلكم مذلولُ",43,"ل",1,0],["فنكس أبطال الوغى عن خيولهم","ومن فرق جمع الضلال تفرقا",44,"ق",2,0],["فَنَكَا جُرْحاً قَدِيماً","بَعْدَ بُرْءٍ وَالتِئامِ",45,"م",1,0],["ف نكتبُ السطرَ عن بعدٍ تحبّرهُ","فضيحةُ الصمتِ بالسرّ الذي أفشى",46,"ش",2,0],["فَنَكَّبُوا الصُّوَة َ اليُسْرَى فَمَالَ بِهِمْ","على الفِرَاضِ فِراضُ الحاملِ الثَّلِمُ",47,"م",1,0],["فنكرٌ بذي نكر إذا مااستحى الفتى","وعرفٌ لآمال امرئ لك مستجد",48,"د",1,0]]}