{"poems":[[55,"أحظى الملوك من الأيام والدول","https://www.aldiwan.net/poem29908.html","البسيط"],[90,"هي المواطن أدنيها وتقصيني","https://www.aldiwan.net/poem44815.html","البسيط"],[23,"أشاقك من أم الوليد ربوع","https://www.aldiwan.net/poem21439.html","الطويل"],[53,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[99,"كم أغر في بواكيرِ الصبا","https://www.aldiwan.net/poem24387.html","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54788","الطويل"],[108,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[92,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[170,"تزم غدا للظاعنين الركائب","https://www.aldiwan.net/poem47135.html","الطويل"],[201,"لا الأنس أنس ولا الأفراح أفراح","https://www.aldiwan.net/poem39809.html","البسيط"],[309,"حي ظبي الرمال والأطلال","https://www.aldiwan.net/poem16833.html","الخفيف"],[366,"أنا في عرض آل بيت نبي","https://www.aldiwan.net/poem68104.html","الخفيف"],[369,"أبقيت بالجزع ما أبليت من طلل","https://www.aldiwan.net/poem60678.html","البسيط"],[409,"قال عبد مسه طول الضرر","https://www.aldiwan.net/poem33934.html","الرمل"],[443,"أمن الهجران غدا جسدي","https://www.aldiwan.net/poem2563.html","المتدارك"],[487,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[510,"ذو الأوتاد","https://www.aldiwan.net/poem27895.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138346",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138439",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87244","الوافر"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56185","البسيط"],[1479,"","https://poetry.dctabudhabi.ae/diwan/poem/20577","الطويل"],[1965,"","https://poetry.dctabudhabi.ae/diwan/poem/102724","الكامل"],[2555,"","https://poetry.dctabudhabi.ae/diwan/poem/147061","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109977","الكامل"],[4290,"","https://poetry.dctabudhabi.ae/diwan/poem/97803","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136678",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139548",""],[5776,"( لحى اليسار )","https://www.poetsgate.com/ViewPoem.aspx?id=199823",""],[6131,"الجذرُ..العتيقْ","https://www.poetsgate.com/ViewPoem.aspx?id=189264",""],[4983,"ارتعاشات الهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82964&r=&rc=4",""]],"verses":[["كَمِ اِغتَرَبتُ عَنِ الدُنيا وَما فَطَنَت","بي المَهامِهُ حَتّى جازَني أَمَلي",0,"ل",2,0],["كم أغرقتني الليالي في مصائبها","فعُمت فيهنّ من صبري بدُلفين",1,"ن",1,0],["كَما غادَرَت في النَقعِ عُثمانَ ثاوِياً","وَسَعداً صَريعاً وَالوَشيجُ شُروعُ",2,"ع",1,0],["كم أغصُّوا من شاربٍ بشراب","كم أغصُّوا من طاعمٍ بطعام",3,"م",1,0],["كَم أغرَّ في بواكيرِ الصبَا","ناضرٍ يسحبُ أذيال النعم",4,"م",1,1],["كَمَا غُشَّ بِالْمِصْبَاحِ قُمْرِيُّ حُجْرَةٍ","تَوَهَّمَهُ ضَوْءَ الصَّبَاحِ فَغَرَّدَا",5,"د",2,0],["كم أَغَفلُوه، فما تَراءَى شاكِيًا","أو باكِيًا من عِلّة الإغفالِ",6,"ل",1,0],["كم أغرٍّ \" مُحَجَّلٍ \" ودَّ لو يُهديكَ","ما في جَبينه والمعاصِم",7,"م",1,0],["كما غرَّ بالنارِ الكذوبِ وميضُها","عيونَ البَرايا خُلّبٌ أو حبُاحِبُ",8,"ب",1,0],["كم أغمض الجفنُ والأحلامُ شاردة","عنه وتدنو خيالات وأشباح",9,"ح",1,0],["كم أغاثَ بهِ الإله صريخاً","وَلهفاً وكم نفى من محال",10,"ل",1,0],["كَم أَغَثتُم مَن جاءَكُم مُستَغيثا","وَأَجرتُم من جاءَكُم مُستَجيرا",11,"ر",2,0],["كما غدا قِبَلَ الأيّامِ لو سمَحوا","لي مَطْمعٌ فللأقوامِ غدا قِبَلي",12,"ل",2,0],["كم إغاثات وكم من دعوة","قد أجيبت بعد يأس قد حضر",13,"ر",1,0],["كم أغضى الجفن على مضض","وصدودك قد أوهى جلدي",14,"د",2,0],["كما غرت فاستكتمت حبي بمقلة","وما كان ظني ما بعيني من إنسان",15,"ن",1,0],["كم أغضبَ ابنَ أبي أخٌ قد اعتقلا","البيداءَ والروضةَ والسهلَ والجبَلا!",16,"ل",2,0],["كم أغنياء فيك تغدق كفهم","للفسق لا لسواه يوما تغدق",17,"ق",1,0],["كم اغترف الورى الاحسان منها","يفوق مذاقه شهد الخلايا",18,"ا",3,0],["كَم اِغتَصَبَ الحُقوقَ لِكَي","يَنالَ السَعدَ بِالغَصب",19,"ب",1,0],["كم أغدى وحش الفلا والطير منه وكم","من بقعةٍ بالدم المهراق أرواها",20,"ا",3,0],["كَما غادَرَت في الكَرِّ حَمزَةَ ثاوياً","وَفي صَدرِهِ ماضي الشَباةِ وَقيعُ",21,"ع",1,0],["كم أغنى محتاجاً ونجّحَ قاصداً","كم صدّ ظلاماً وأطلق عاني",22,"ن",2,0],["كما غصبوا الأملاك معشوقة الورى","وما سجلوا أيضاً بها في الحبايس",23,"س",1,0],["كم أَغرَضَت قلباً مواعظُ رُسلِها","فصُمي بلا سهمٍ ولا أَقواس",24,"س",1,0],["كما غادر المصباح بعد خبوه","فتايل قد ميثت له بدهان",25,"ن",1,0],["كم أغاثوا العُفاةض مذ بخل الغيثُ","وجادوا بهاطلٍ هتانّ",26,"ن",1,0],["كما غدرت بنادرهم وشأنُ ال","خطوبِ الغدرُ إذ هي لا تتوب",27,"ب",1,0],["كما غادروا ليلاً بلبسِ البراقعِ","هم الآن صرعى في جميعِ المواقعِ",28,"ع",1,1],["كمْ أغوتِ الغِيدَ الحِسَانَ قَلائِديْ","فأتَيْنَ يَطلُبْنَ الوصَالَ تَوَدُّدا",29,"د",2,0],["كم أغرقت خطواتنا في نبضها","فالباب والمزلاج ما أسراني",30,"ن",2,0]]}