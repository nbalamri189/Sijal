{"poems":[[95,"سادتي جاز فضلكم آمالي","https://www.aldiwan.net/poem9161.html","الخفيف"],[93,"من أسود تسربلت بالحديد","https://www.aldiwan.net/poem8806.html","عموديه"],[91,"فقدت مصر فهي سكرى المآقي","https://www.aldiwan.net/poem44745.html","الخفيف"],[68,"من نفخة الصور أم من نفحة الصور","https://www.aldiwan.net/poem41361.html","البسيط"],[99,"بأي لفظ يفيك شعري","https://www.aldiwan.net/poem24969.html","مجزوء البسيط"],[82,"وجدول جامد في الكف تحمله","https://www.aldiwan.net/poem31450.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39547","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54712","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142072","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142067","الخفيف"],[108,"الوحدة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=179293",""],[193,"حي يا سعد قبابا بالحمى","https://www.aldiwan.net/poem35099.html","الرمل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[203,"دجا الظلام فيا ليلى أما فينا","https://www.aldiwan.net/poem45159.html","البسيط"],[203,"يا طير ما للنوم قد طارا","https://www.aldiwan.net/poem45627.html","السريع"],[240,"مات السماح فاسفحي","https://www.aldiwan.net/poem31756.html","مجزوء الرجز"],[275,"هذا قران سعيد أكسب الدارا","https://www.aldiwan.net/poem35264.html","البسيط"],[291,"كأنه ذئب غضى أزل","https://www.aldiwan.net/poem34062.html","الرجز"],[333,"الحمد للَه على ماق ضى","https://www.aldiwan.net/poem54955.html","الكامل"],[376,"أصار يألف فيض الدمع مدمعه","https://www.aldiwan.net/poem57321.html","البسيط"],[376,"لا بتماديك على هجري","https://www.aldiwan.net/poem57430.html","السريع"],[385,"سقى دمشق ومن فيها بما رحبت","https://www.aldiwan.net/poem48771.html","البسيط"],[399,"في أحضان الطبيعة","https://www.aldiwan.net/poem24309.html","عموديه"],[463,"في الظباء الغادين أمس غزال","https://www.aldiwan.net/poem56073.html","الخفيف"],[505,"ما عرفت الولي إلا بدلق","https://www.aldiwan.net/poem37938.html","الخفيف"],[510,"البديل","https://www.aldiwan.net/poem56766.html","مخلع البسيط"],[556,"ضرم قلبي فاضطرم","https://www.aldiwan.net/poem47190.html","مجزوء الرجز"],[580,"ليل وصل منيرة أقماره","https://www.aldiwan.net/poem3059.html","الخفيف"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101486","الخفيف"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39087","السريع"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63961","الخفيف"],[1341,"","https://poetry.dctabudhabi.ae/diwan/poem/124686","السريع"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126670","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2256,"","https://poetry.dctabudhabi.ae/diwan/poem/216594",""],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87811","الرمل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100909","الخفيف"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100495","الخفيف"],[399,"","https://poetry.dctabudhabi.ae/diwan/poem/205765","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216626","الخفيف"],[3964,"","https://poetry.dctabudhabi.ae/diwan/poem/73555","البسيط"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119448","الرجز"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104528","الرمل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204214","المنسرح"],[1012,"فتح جعلان","https://www.poetsgate.com/ViewPoem.aspx?id=124501",""],[5409,"كلما اجتاز بعدك الدهر ميلا","https://www.poetsgate.com/ViewPoem.aspx?id=155494",""],[5525,"السراب","https://www.poetsgate.com/ViewPoem.aspx?id=928",""],[5573,"ياطول ليلي وانا اطرد طارق الفكره","https://www.poetsgate.com/ViewPoem.aspx?id=203322",""],[5784,"هذا الهوى سحر","https://www.poetsgate.com/ViewPoem.aspx?id=190378",""]],"verses":[["كان هذا الثغر الجميل ملاذي","وبأهليه كان بدء إتصالي",0,"ل",2,0],["كانَ هَذا لِلصُفرِ عيدا وَعِندَ","الروسِ ضَرباً مِنَ اللَيالي السودِ",1,"د",1,0],["كان هذا الذي به كنت تشدو","بعض دقات قلبك الخفاق",2,"ق",1,0],["كَأَنَّهُ ذَهَبٌ مِن فَوقِ أَعمِدَةٍ","مِنَ الزُمُرُّدِ في أَوراقِ كافورِ",3,"ر",1,0],["كأن هذا الجميل يترى","من طيب غادٍ ولطف ساري",4,"ر",2,0],["كَأنَّه ذِهنُ ذي حذق يَفُكُّ به","من المُعَمّى عويصاً فكّهُ عَسِرُ",5,"ر",1,0],["كان هذا المكانُ روضاً نضيراً","جرَّ فيهِ الربيعُ بالأمس ذيلا",6,"ل",2,0],["كَانَ هَذَا لَهُنَّ هَماً وَهَلْ فِي","حَالَةٍ بَعْدَهُ مَظِنَّةُ سَعْدِ",7,"د",1,0],["كأنَّ هذا اللَّيل قد ملَّني","أو انَّهُ اشتقا لوجه الصَّباح",8,"ح",1,0],["كأنَّ هذا اللَّيل قد ملَّني","أو أنَّه اشتاق لوجه الصَّباح",9,"ح",1,0],["كان هذا تاريخَنا يوم كنا","وحدةً في الحروب لا وحدانا",10,"ن",2,0],["كانَ هذا الكونُ ليلاً مُظلما","وَمنَ الشرك الورى في غلسِ",11,"س",1,0],["كانَ هَذا من غير طيبٍ أتاهُ","إِذ هو الطيبُ والأديم وعاءُ",12,"ا",2,0],["كانَ هَذا فِراشهُ ومنَ الصو","فِ دِثارٌ بهِ يكون الغطاءُ",12,"ا",2,0],["كأن هذا الذي يدعونهُ ذهباً","روح من النار ما تنفك تكوينا",13,"ن",2,0],["كأن هذا السهدَ لا يأتلي","يطلبُ من أجفاننا ثارا",14,"ر",2,0],["كَأَنَّ هَذا الدَهرَ آ","لى جاهِداً وَأَقسَما",15,"م",2,0],["كأنه ذلك العرسُ الذي سكبت","يدُ المخلِّصِ فيهِ الخمرَ مِدرارا",16,"ر",2,0],["كَأَنَّه ذئبُ غضىً أَزَلُّ","بَاتَ النَّدى يَضْرِبُهُ وَالطَّلُّ",17,"ل",1,1],["كأن هذا البحر في جوفه","معربد الأمواج طاغٍ عكر",18,"ر",1,0],["كأنَّه ذو قلوبٍ في الهَوى كَثُرت","وكلّ يَومٍ له قَلبٌ يودِّعُهُ",19,"ع",2,0],["كأنَّ هَذا الشافِعَ المُنحني","لم يكُ ذاك الحَنِقَ المُغري",20,"ر",2,0],["كَأَنَّهُ ذائب البَلور حَيث جَرى","يَجري عَلى الماس وَالعقيان وَالدُرر",21,"ر",1,0],["كان هذا الطموح لعنة أيّا","مي فيا ليتني عصيت هواه",22,"ه",1,0],["كان هذا كذا وودّي لكم حس","ب ومالي في الدِّين بعدُ اتصالُ",23,"ل",1,0],["كانَ هذا عن أَمرِ أَشرفِ هادٍ","بحُضورِ الصِّدِّيقِ والفارُوق",24,"ق",1,0],["كأنّ هذِي العيونُ لم تقْ","رأْ قصّةً قالَها إيْسُوبُ",25,"ب",1,0],["كأنّه ذو بُخُلٍ","يقول لا بعد نَعَمْ",26,"م",1,0],["كان هَذا من قبل أَنْ يُزهِر الشع","رُ وتَذْوي من الصِّبا أَزْهَارُه",27,"ر",2,0],["كان هذا التماسَ قُوتِ عيالٍ","ضاق عنها بالبؤس رَحبُ الفضاءِ",28,"ا",2,0],["كأنَّ هذِي وَجْنَةٌ خُمِّشَتْ","وذا عِذارٌ فَوْقَها قَدْ وَشَى",29,"ش",2,0],["كان هذا القريضُ حيّاً فحتى","حين ماتَ المعوَجّ مات القريض",30,"ض",1,0],["كأن هذا الليل في أضلعي","لم يعرف الصبح ولون الضياء",31,"ا",2,0],["كأن هذا الدجى والشهب لامعة","جيش الزنوج بأمر الروم يأتمر",32,"ر",1,0],["كان هذا داودُ سابعَ رَهطٍ","أينما حلَّ زالت النَّكباء",33,"ا",2,0],["كَانْ هَذَا حَقْ بِثْباته","سامحين القَلْب راضينا",34,"ن",2,0],["كانَ هَذا السَهل لِلخَيل مَجال","كَم بِهِ أَضحى صَريع وَجَريح",35,"ح",1,0],["كان هذا الفريقُ يُثبتُ فى الص","صُبحِ وتُمحَى أسماؤهُ فى السماء",36,"ا",2,0],["كان هذا لهم جزاء من اللَه","وقد كان سعيهم مشكورا",37,"ر",2,0],["كان هذا الوجود مملكتي الكب","رى فيا ليتها تعود إليّا",38,"ي",2,0],["كان هذا الهواء طلقاً فلما","حبسوه أبكي ببث أنينه",39,"ن",2,0],["كَأَنَّ هذا وَذا عَلَيها","سَحابَةٌ خَلفَها هِلالُ",40,"ل",1,0],["كأنه ذوائب","قد مشطت مجرزه",41,"ز",2,0],["كان هذا السير كرها","أو طواعا أنا أدري",42,"ي",1,0],["كأن هذا وذاك إذ نسبا","منّي سوادُ يضمّه قلب",43,"ب",1,0],["كان هذا والحمد لله في عام","(غفور) بالنصف من شعبانا",44,"ن",2,0],["كان هذا الوجود ليلاً فمذ أش","رقت أعقبته صباحاً جميلا",45,"ل",2,0],["كانه ذبحني صاحبي من عذابه","ماابي لدمي يا هل اللوم طلاب",46,"ب",1,0],["كانه ذكر قولو اني له على خبره","تدرون قولو له اني منكسر فاسي",47,"س",2,0],["كأن هذا الهوى سحر تملكني","فلست أعلم ما فوقي وما تحتي",48,"ت",2,0]]}