=122799",""],[5847,"تبسم","https://www.poetsgate.com/ViewPoem.aspx?id=14323",""],[5910,"بردة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=208729",""],[5933,"قال النبي مقالةً","https://www.poetsgate.com/ViewPoem.aspx?id=40707",""],[1920,"رمضان","https://www.poetsgate.com/ViewPoem.aspx?id=191389",""],[1920,"هلال الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=191391",""],[5953,"إن يوم الغدير يوم السرور","https://www.poetsgate.com/ViewPoem.aspx?id=93784",""],[5956,"الشامُ فيها العشقُ والتَّرحامُ","https://www.poetsgate.com/ViewPoem.aspx?id=184921",""],[5956,"عجباً يحارب نفسه الصّومالُ","https://www.poetsgate.com/ViewPoem.aspx?id=194484",""],[5989,"يا نجمةً ومضت","https://www.poetsgate.com/ViewPoem.aspx?id=181494",""],[6124,"سقتني الوصل","https://www.poetsgate.com/ViewPoem.aspx?id=201224",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577049",""],[463,"سائلِ الدَّارَ غنْ سألتَ خبيرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60093&r=&rc=149",""],[6248,"رجع الخاصرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86024&r=&rc=1",""],[6259,"حكمُ المنيَّة في البريَّة جارِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59422&r=&rc=70",""],[6290,"المُعَلّقَةُ الثّامِنَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85504&r=&rc=22",""],[2220,"إن سيرتْ صمّ الجبالِ سراباً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11189&r=&rc=63",""],[5126,"روض وشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87814&r=&rc=29",""]],"verses":[["وشُهْبٌ تَهاوَتْ للغُروبِ كأنّما","يُذابُ على الأفقِ النُّضارُ وَسامُهُ",0,"م",2,0],["وشُهْبٌ إذا ما ضُمِّرَتْ يوْمَ غارَةٍ","مطَهّمةٌ غارَتْ بها الأنْجُمُ الزُّهْرُ",1,"ر",1,0],["وشُهْبٌ إذا ما ضُمِّرَتْ يوْمَ غارَةٍ","مطهَّمةٌ غارَتْ بِها الشّهْبُ الزُّهْرُ",2,"ر",1,0],["وَشَهدْتُ نُورَ اللهِ لَيْسَ بِآفِل","وَالدِّينَ وَالدُّنْيَا عَلَى تَرْتيبِ",3,"ب",1,0],["وَشَهَادةُ الإِخْلاَصِ تُوجِبُ رَجْعَتِي","لِنَعيمِهَا مِنْ غَيْرَ مَسِّ لَغُوبِ",3,"ب",1,0],["وَشَهِدتُهُ أَنّى خَطا","خَطواً تَخَبَّلَ أَو عَثَر",4,"ر",1,0],["وَشَهِدتُ زَوجَكِ مُطرِقاً","مُستَوحِشاً بَينَ السَمَر",4,"ر",1,0],["وَشَهِدنا ثَغرَ الوَفاءِ تَجَلّى","إِذ تَجَلّى في ثَغرِها البَسّامِ",5,"م",1,0],["وَشَهِدنا مِن فَضلِكُم أَثَراً في","ها يَروقُ العُيونَ وَالأَسماعا",6,"ع",2,0],["وَشَهِدتَ جِبريلا يَمُد","دُ عَلَيهِ ظِلَّ اللَهِ مَدّا",7,"د",2,0],["وَشَهباءَ تَردي بِالسَلوقِيِّ فَوقَها","سَنا بارِقاتٍ تَكرَهُ العَينُ خالَها",8,"ل",3,0],["وشهاب أفق أم سنانٌ لامع","ينقضُّ نجْماً في سماء غبارِ",9,"ر",1,0],["وَشَهِدتُ أَنجِيَةَ الأَفاقَةِ عالِياً","كَعبي وَأَردافُ المُلوكِ شُهودُ",10,"د",1,0],["وشهمٌ ولكن جنده من سطورِهِ","وقاضٍ ولكنَّ المعاني شهوده",11,"د",2,0],["وشهيدي بذلك ابنُ فِرَاسٍ","وهو عَدْلٌ العُدُول لا المقْصُوبُ",12,"ب",1,0],["وشُهُودي بما نَحَلْتُكَ شَتَّى","من حَسُودٍ ومنْ ودُودٍ حَشُودِ",13,"د",1,0],["وشهدي على رجائك أنْ لم","أتوسل وأنْ تركتُ الإطالهْ",14,"ل",2,0],["وَشَهباءِ المَغافِرِ قارَعَتنا","مُلَملَمَةٍ يَلوذُ بِها الفُلولُ",15,"ل",1,0],["وشهدت في روما كنيسة بطرس","يبلى الشفاه بها حديد الباب",16,"ب",1,0],["وَشَهِدتُمو صَدعَ الصُفوفِ وَما جَنى","مِن أَمرِ مُفتاتٍ وَنَهيِ وَقاحِ",17,"ح",1,0],["وَشَهوَةَ عَودٍ إِنَّ جودَ يَمينِهِ","ثَناءٌ ثَناءٌ وَالجَوادُ بِها فَردُ",18,"د",1,0],["وَشُهِرتُ في شَرقِ البِلادِ وَغَربِها","فَكَأَنَّني في كُلِّ نادٍ جالِسُ",19,"س",1,0],["وَشَهِدتُ يَومَ الغَيثِ في هَطَلانِهِ","جَهماً مُحَيّاهُ أَغَمَّ بَهيما",20,"م",2,0],["وَشَهباءَ فيها لِلمَنايا مَناكِبٌ","إِذا أَقبَلَت يَوماً وَدَبَّ دَبيبُها",21,"ب",3,0],["وَشَهباءَ تُعشي الناظِرينَ إِذا اِلتَقَت","تَرى بَينَها الأَبطالَ تَهفو عُقابُها",22,"ب",3,0],["وَشَهباءَ قادَتها صَناديدُ فِتنَةٌ","نَطَحنا فَأَمسَت غَيرَ ذاتِ فُتوقِ",23,"ق",1,0],["وَشَهباءُ مِهيافٌ شَديدٌ ضَريرُها","تَحُلُّ بِراميها عُقودَ التَمائِمِ",24,"م",1,0],["وشهابُ رَجْمٍ غَيَّبَتْهُ صَفائِحٌ","طُوِيَتْ على إشراقِه ورِجام",25,"م",1,0],["وشهرٌ يُشهِّرُ ثَوبَ الثَّرى","ويَنظِمُ بالطَّلِّ فيه شُذُورا",26,"ر",2,0],["وشَهِدتَ حين جَرى القَضاءُ فأصبحت","تُقْصَى الكُماةُ عن الوغَى وتُذادُ",27,"د",1,0],["وَشَهيدي في كُلِّ ما","أَدَّعيهِ فَتى رُعَين",28,"ن",1,0],["وَشُهْبٌ أُرْسِلَتْ حَرَساً فخُطَّتْ","عَلَى طِرسِ الظَّلامِ بها شُطوبُ",29,"ب",1,0],["وَشَهادَتي أَنّي حَليفُ عِبادَةٍ","فَاِبلوا عَلى الأَيّامِ ذاكَ وَجَرِّبوا",30,"ب",3,0],["وَشُهِرتُ في الدُنِّيا وَمَن لي أَن أَرى","كَالنيرِ الفاني مَعَ الإِشهارِ",31,"ر",1,0],["وَشَهادَةٌ لَكَ أَنَّ خُلقَكَ يُجتَنى","لِيُصابَ شَهداً وَهوَ صابٌ عَلقَمُ",32,"م",1,0],["وشَهْبَاءُ تَنْبُو النَّبْلُ عَنْهَا كَأَنَّهَا","صَفاً زَلَّ عَنْ أَرْكَانِهِ المُتَزَحْلِفُ",33,"ف",1,0],["وشهدت ظل الموت فوق ظلالها","يغشى الربى ويجلل الأدواحا",34,"ح",2,0],["وشهرتها حرباً على مستعمر","مُتجبّرٍ أو غاصبٍ ظلَّامِ",35,"م",1,0],["وَشَهِدْتُ كَيْفَ تُعِدُّ أَمٌّ بَعْدَهُ","لِلمَجْدِ أَوْحَدَهَا وَلِلأَخْطارِ",36,"ر",1,0],["وَشهِدْنُ تِلْكَ الْحَادِثا","تِ كَأَنَّ مَاضِيَهُنٌ حَاضِرْ",37,"ر",1,0],["وَشِهَابُ أَوْجٍ عُطِّلَتْ عَلْيَاؤُهُ","مِنْ أَفْخَرِ الزِّيناتِ فِي الْمُتَقَلِّدِ",38,"د",1,0],["وَشَهِدتَ إِفشاءَ الطَّبيعَةِ سِرَّهَا","لِلعَقلِ بَعدَ الضَّنِّ بِالإِفْشَاءِ",39,"ا",2,0],["وَشَهِدْتَ التِّمْسَ مُضْطَرِباً","واثِباً كالصافِنِ الأَرِن",40,"ن",1,0],["وشهِدتُ فيكَ الْحُورَ تسبح في السَّنا","نفسي فِداءُ ضِيائها السّباح",41,"ح",1,0],["وشَهْدُه مُخْتَلِطٌ بصاب","يا بحرُ، قد أصحبتَ من أصحابي",42,"ب",2,0],["وشهدت دولة عبد شمس حينما","بلغ الوليدُ بها عنان الفرقد",43,"د",1,0],["وشهادَة ُ الإخلاص توجبُ رِحْلتي","لنعيمها من غيْر مسَّ لغوب",44,"ب",1,0],["وشهاب أضاء فى أفق الشعر","فسرنا به على لمعانه",45,"ن",2,0],["وَشِهاباً في سَمَوا","ت العُلى سامي الطِباق",46,"ق",1,0],["وشهدنا جماله فبدت من","ه معان تحير الاوهاما",47,"م",2,0],["وشهدت كيف العفو يسبل ستره","حتى على فرعون في عصيانه",48,"ن",2,0],["وشهباء يُستجلَى الضَّريبُ بلونِها","وطينتُها من عنصر الحَجر الصَّلدِ",49,"د",1,0],["وَشَهِدتُ البُحورَ قَد كَفَتِ الوُر","رّادَ أَن يبعَثوا لَها روّادا",50,"د",2,0],["وشهادة الفقهاء لا شك بها","هم صادقون وما بذلك ريبة",51,"ه",1,0],["وشهوةُ الإبحارْ","تغْتالُها الشُّطآنْ",52,"ن",1,0],["وشهرٍ أدرنا لارتقاب هلاله","عيوناً إلى جو السماء موائلا",53,"ل",2,1],["وشهابها تتحلى في السما","بسناه الشهب إن رمن الدرور",54,"ر",1,0],["وشهابا ما السبعة الشهب الا","دونه في ارتفاع مجد وقدر",55,"ر",1,0],["وشهادتي حق عقيب شهادة","فيها الوفاق لأهلك الإطهار",56,"ر",1,0],["وَشِهابُ الدينِ الَّذي يَصدَعُ الخَط","بَ بِوَجهٍ يَنجابُ عَنهُ الدُجونُ",57,"ن",1,0],["وَشَهِدْتُ سَعْدَ الدين ِقَدْ","أَقْرَا مَقَاصِدَهُ لِقُصَّدْ",58,"د",1,0],["وَشَهامَةٌ أَبَداً تقيِّدُ مَنزِلاً","عَن شاهِقٍ وَمُجَّدلاً عَن أَجدَلِ",59,"ل",1,0],["وشهر شوال في تكافي","ساعات أيامه القصار",60,"ر",1,0],["وشهرته بالحمد والمدح والثنا","كما اشتهرت بين الأنام قِفا نبكي",61,"ك",2,0],["وشهوتُ لو مَلأت فمي أنفاسُها","لكنَّها احتشَمت فلم تتنفَّس",62,"س",1,0],["وَشِهابٌ قَد صَبا فيمَن صَبا","لَيسَ عُمري فيه سَمعٌ وَبَصر",63,"ر",1,0],["وَشِهابٌ وَأَينَ مِثلٌ شَهابٍ","عِندَ بَذلِ النَدى وَحَرِّ الطِعانِ",64,"ن",1,0],["وَشَهادَةِ الشُهَداءِ لِلمَعنى الَّذي","أَخفوا مَحاسِنَهُ وَلَيسَ بِهِ خَفا",65,"ف",2,0],["وَشُهودي آلُ مِقدادٍ وَمِن","مِنهُم زَيدٌ وَمَن مِنهُم أُبَي",66,"ي",1,0],["وَشَهم حَليم حلَّ في حرم النُهى","تَقيّ عَلى المَعروف وَالبرّ عاكفُ",67,"ف",1,0],["وَشَهِدتُ الخَيلَ في مَلمومَةٍ","ما تَرى مِنهُنَّ إِلّا الحَدَقا",68,"ق",2,0],["وشهوده في كتبه","إن كنت تنصف في المقال",69,"ل",1,0],["وشهامة وترفع","عن لابس تيهاً وكبرا",70,"ر",2,0],["وشهادَةُ الأعداءِ بالفَضلِ الّذي","اللهُ فضّلَنا بهِ أقوى لَنا",71,"ن",2,0],["وَشِهابُ زَندِ الحُزنِ إِن طاوَعتُهُ","وَآرٍ وَإِن عاصَيتَهُ مُتَواري",72,"ر",2,0],["وشهودي من مزاياه ولا","تثبت الحجَّةُ إلاَّ بالشُّهود",73,"د",1,0],["وشهدْتُ قرماً بالكمال متَوَّجاً","ورأيت ليثاً بالفخار معمّما",74,"م",2,0],["وشهدنا مشهد الأُنس بها","وقعدنا للهوى في كل مقعد",75,"د",1,0],["وشهدنا معالم المجد فيها","قد تعالت فيا لها من معالم",76,"م",1,0],["وشهاباً تستضي أهل الهمم","بسناه من تناءى ودنا",77,"ن",2,0],["وشهد ريق عذيب","يا درَّ ثغر حبيبِ",78,"ب",1,0],["وشهاب الفضل نادى مشرقا","أرخوا محمودنا خير كريم",79,"م",1,0],["وشهاب نور ضياك غاية مقصدي","حاشا أضام وأنت لي نعم الرجال",80,"ج",3,0],["وشهرُ شعبانَ منهُ مُكتَسبٌ","مفاخراً أصبحتْ لهُ ولَنا",81,"ن",2,0],["وشهرٌ تولَّى راضِياً قَدْ بلَغْتُما","مداهُ كِراماً قُوَّمَ الليلِ صُوَّما",82,"م",2,0],["وشهيدٍ بالطَّفّ أبكَى السموا","تِ وكادت له تزول الجبالُ",83,"ل",1,0],["وشهدنا نداه حقّاً يقيناً","وسمعنا عنهمْ ضجيجاً وزورا",84,"ر",2,0],["وَشُهبٍ كَمِثلِ الشَيبِ بيضٍ مُتونِها","تَحُفُّ بِها دَهمٌ كَسودِ المَفارِقِ",85,"ق",1,0],["وشهدت ما شاهدت بالحكم التي","نزلت على بنز بوحي الواحي",86,"ح",2,0],["وشَهِدْناكَ من مَكانٍ بَعيدٍ","عِندَنا كالشُّخوصِ عندَ الظِّلالِ",87,"ل",1,0],["وشَهِدنا الهَباءَ كالنّقْعِ لَيلاً","حَولَها إذ بدَتْ منَ البلّورِ",88,"ر",1,0],["وشهر ذي الحجة قالوا لنا","ذاك بقايا السنة الخاليه",89,"ل",3,0],["وشهيدٌ يتلوهُ شهيدٌ","من يافا لأطراف جنينِ",90,"ن",1,0],["وشهِدناكَ وقد سجَّلتَ من","فَوقِها الفَنَّ كما قد سَجَّلَك",91,"ك",1,0],["وشهر مستهل بعد شهر","وحول بعده حول جديد",92,"د",1,0],["وشهودُ بأسك أسمرٌ متدقّقٌ","أو أبيضٌ ماضي الغِرارِ مُفَلَّلُ",93,"ل",1,0],["وشهّاقةً ترنو نجيعاً كأنّما","خرقتَ به نَوْءَ الحيَا فتخرّقا",94,"ق",2,0],["وَشَهباوَينَ مِن سَنَةٍ وَحَربٍ","سَلَبتَهُما الفَوارِسَ وَالجُدوبا",95,"ب",2,1],["وشهدنا الوجود حوضاً وكانت","صور الكل عندنا كيزانا",96,"ن",2,0],["وشهدتم أنه الل","ه بزور وتغالي",97,"ل",2,0],["وشهدنا هنالك السر يبدو","بالتجلي من غيبه المحروس",98,"س",1,0],["وشهدت علما زان بانا غدوا","فخر الرجال وزينة الشبان",99,"ن",1,0],["وَشَهمٍ أَبِيِّ النَفسِ أَضحى يَرى يَداً","تَذَكَّرَ فَضلٌ أَو جَميلٌ لِمُنعَمِ",100,"م",1,0],["وشَهماً نبيلاً حوى المكرمات","وكانَ له في البرايا أثَر",101,"ر",1,0],["وَشهم غدا للمجد وَالفضل وَالنَدى","حَليفاً قَرين السَعد نسل كِرام",102,"م",1,0],["وَشهاب في الجهادِ","لِلشَياطين المريدهْ",103,"ه",1,0],["وَشهرتي في باطن الأَمراضِ","خالية في الكَون عَن أَغراضِ",104,"ض",1,0],["وَشَهادة بِالحَق تَنفع يَوم لا","وَلدٌ يَجود لِوالد بِفداء",105,"ا",2,0],["وشهدنا الوجود حوضا وكانت","صور الكل عندنا اقداحا",106,"ح",2,0],["وشُهْبُ القَنَا كالنُّقْبِ والنَّقْعُ ساطِعُ","هِناءً وأيدي المُقْرَباتِ هوانِئُ",107,"ا",1,0],["وشهدت كيف جلا الإمام سماءهم","بعد اضطراد سحائب وغياهب",108,"ب",1,0],["وشهدت في بطحاء برقة أ