{"poems":[[10,"يا عين إبكي فارسا","https://www.aldiwan.net/poem21103.html","مجزوء الكامل"],[53,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[53,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[77,"أقوى المحصب من هاد ومن هيد","https://www.aldiwan.net/poem69092.html","الطويل"],[164,"العلم بالإجماع معدنه ذهب","https://www.aldiwan.net/poem58716.html","الطويل"],[189,"هذا الخليج فمرحبا بزمانه","https://www.aldiwan.net/poem14669.html","الكامل"],[310,"ذا مقام للمحرز الصديقي","https://www.aldiwan.net/poem56448.html","الخفيف"],[382,"قف بي خليلي واستمح","https://www.aldiwan.net/poem66887.html","مجزوء الكامل"],[396,"خذ من الوقت ما سمح","https://www.aldiwan.net/poem54594.html","عموديه"],[422,"ذا مسجد سر أرباب السجود به","https://www.aldiwan.net/poem53874.html","البسيط"],[435,"ما لذة المرء بالكاسات والوتر","https://www.aldiwan.net/poem40743.html","البسيط"],[435,"سل البان هل مرت عليه النوافح","https://www.aldiwan.net/poem41406.html","الطويل"],[484,"زان طرفها الحور","https://www.aldiwan.net/poem36921.html","المقتضب"],[505,"رفرف غصن البان لا بمرق","https://www.aldiwan.net/poem37963.html","الرجز"],[563,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[572,"يا ابن الخلائف من ذؤابة هاشم","https://www.aldiwan.net/poem69573.html","الكامل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83320","الخفيف"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83303","الخفيف"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146220","الرجز"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/124040","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48675","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48689","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38954","السريع"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38915","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77579","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77545","الخفيف"],[914,"","https://poetry.dctabudhabi.ae/diwan/poem/100529","السريع"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136272","الخفيف"],[1378,"","https://poetry.dctabudhabi.ae/diwan/poem/216849",""],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95547","المجتث"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80039","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48971","الكامل"],[1692,"","https://poetry.dctabudhabi.ae/diwan/poem/101577","البسيط"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102066","الكامل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95389","الخفيف"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95398","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110255","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47097","الرجز"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47186","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93604","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204454","البسيط"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134009","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110110","الكامل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128930","السريع"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66543","السريع"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111505","الرجز"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69968","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69920","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125862","البسيط"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36383","الدوبيت"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127170","السريع"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127068","الرجز"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45010","الرمل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94785","الرمل"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105511","البسيط"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83663","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83559","السريع"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120488","الكامل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204256","السريع"],[4797,"يالعقاب","https://www.poetsgate.com/ViewPoem.aspx?id=51280",""],[4913,"لا تسأليه","https://www.poetsgate.com/ViewPoem.aspx?id=202957",""],[4935,"ورد إلهنا لوارد وصادر","https://www.poetsgate.com/ViewPoem.aspx?id=129490",""],[4935,"حسن المطالع في صفاء براعة","https://www.poetsgate.com/ViewPoem.aspx?id=129288",""],[5145,"ما على الجيرة لو صبروا","https://www.poetsgate.com/ViewPoem.aspx?id=108198",""],[5186,"الماء لج بسطحه المتمدد","https://www.poetsgate.com/ViewPoem.aspx?id=156432",""],[5409,"فنُّ البيان رثاك قبل لساني","https://www.poetsgate.com/ViewPoem.aspx?id=155483",""],[6031,"جَذَّ الردَى سَبَبَ الإسلامِ فَانْجذَمَا","https://www.poetsgate.com/ViewPoem.aspx?id=46278",""]],"verses":[["ذا مِرَّةٍ وَمَهابَةٍ","بَينا نُؤَمِّلُهُ اِختُلِس",0,"س",1,0],["ذا معانٍ يقولُ مُنْتقِدُوها","كلُّ بكر رهينةٌ بافتضاض",1,"ض",1,0],["ذا مقالٍ موافقٍ لمقامٍ","ومقامٍ موافقٍ لمقالِ",2,"ل",1,0],["ذا مرَّةٍ يَفتَحُ اللَّهُ الحُصونَ عَلَى","يَدَيهِ لَيسَ بِفَرّارٍ وَلا بَرِمِ",3,"م",1,0],["ذا موقِفُ الصَّبّ من مرمى الجمار ومن","مَشاخبِ البُدْنِ قَفْراً غير معهود",4,"د",1,0],["ذا من طريق الأَفضلية لا طريق","الأكثرية والتغالي في الرتب",5,"ب",1,0],["ذا منظرٌ لو أنصفوه سَعَى له","كِسْرى أنو شروان من إيوانه",6,"ن",2,0],["ذا مُقام للمحرِزِ الصدّيقي","مُحرزِ الخصلِ وَالكمالِ الحقيقي",7,"ي",1,1],["ذا من عيوني طائرٌ","والجفن في دمعي سبح",8,"ح",1,0],["ذامع عفوه الكثير","ولو يؤاخذ بما اجترح",9,"ح",1,0],["ذا مسجدٌ سُرَّ أربابُ السُّجود بهِ","وجامعٌ جامعٌ للساجدِ الراكعْ",10,"ع",1,1],["ذا منخرٍ واسعٍ مع منسرٍ ضخمٍ","قصير أبتر مثل السيف منتشر",11,"ر",1,0],["ذا ما دجا ليل الغرام تسهدت","عيون لهجران الحبيب قرائح",12,"ح",1,0],["ذامها ولا حرج","الجمال والصغر",13,"ر",1,0],["ذا منهَجٌ صحَّ به نهجُ الهُدى","وهو طَريقُ الصَّالحينَ الحُنَفَا",14,"ف",2,0],["ذا من تجاهل حب جل عارفه","أم عجل الله لي حظى من الضرم",15,"م",1,0],["ذَا مُقْلَةٍ ذَهَبِيَّةٍ فِي هَامَةٍ","مَحْفُوفَةٍ مِنْ رِيْشِهَا بِحَدَائِقِ",16,"ق",1,0],["ذا مَجالٍ أَن تَجتَنِبهُ خَناذي","ذُ القَوافي فَإِنَّني الضِرغامُ",17,"م",1,0],["ذا مَجالٍ رَضيتُ فيهَ مِنَ السَب","قِ بِعَزمٍ لَهُ يُثنِهِ الأَحجامِ",18,"م",1,0],["ذا مع ذا، ذاك وذا","دافَعَهُ ذا فاندفع",19,"ع",1,0],["ذا مصابٌ أطار نومي فليلى","ليلُ هيمان ذي هموم عميد",20,"د",1,0],["ذا منزلي لو لا تليدُ يساره","لم يحو غير السقف والجدران",21,"ن",1,0],["ذا موسمُ الأكفاء في مجدٍ وفي","مالٍ فخلد موسمي المشهورا",22,"ر",2,0],["ذا مُصطَفى العِرفانِ سَعد البيانْ","وَسيبَويه العَصر دونَ اِرتِيابْ",23,"ب",1,0],["ذا مَسجِدٌ قَد شيدَ بُنياناً عَلى","تَقوى الإِلَهِ وَلا اِرتيابَ كَما يَجِب",24,"ب",1,0],["ذا مانع فَاِنظُر إِلى أَصالَتِه","ثُم ابذل المَجهود في إِزالَته",25,"ه",1,0],["ذا مزاح مُداعِبا","لَم يَكُن دبَّ في الفَلَت",26,"ت",1,0],["ذا مبتداً صدر بالنفي في ال","معنى فألجاه لحذف الخبر",27,"ر",1,1],["ذا مقى الاياب والسر سار","ذا عيان الشهود في كل حال",28,"ل",1,0],["ذا مقالي هوب تطفيجِ","في حشا لِفواد مِهونَّه",29,"ن",2,0],["ذا محنة قمطريراً","عراه برق ورعدُ",30,"د",1,0],["ذا محمد رشيدُ باشا بباني","شاد للحكم دار عزٍّ ومجد",31,"د",1,1],["ذا ما تكنُّ سريرتي","والله أَعلمُ بالسرائر",32,"ر",1,0],["ذا مرسح في خباء الدهر يلعب ما","يستحضر الصاحبان اليأس والأمل",33,"ل",1,0],["ذا منك فضلاً من مواهبك التي","عمت الشرق ثم غرب نوركا",34,"ك",2,0],["ذا محلّ العذارى تمشي عشيّا","وعلى الحقف تجلس الندماء",35,"ا",2,0],["ذا مرامي وفيه كان غرامي","وعسى أن أرى القطائف غبه",36,"ب",2,0],["ذا ماء عاصينا البديع فإنه","للأكل لو يك جلمداً بمذيب",37,"ب",1,0],["ذا مروع مستنجد بطش","كفيه وهذا عاق قد استجداها",38,"ا",3,0],["ذا ما جناه عليَّ شعري ليتني","لثَّمتُ وجهَ قريحتي بنقاب",39,"ب",1,0],["ذَا مَوْرِدٌ جاد به","راجي ثوابِ ربِّهِ",40,"ب",2,1],["ذا مقامُ العريان أستاذ نَصْرٍ","يوم أعطاه لقمةً خواصه",41,"ص",2,0],["ذا ميّت نشرته كف محمد","طوبى لَهُ مِن مَيت مَنشور",42,"ر",1,0],["ذا مبدأ كلما نخطو به قدماً","فبالوصول الى غاياته نثق",43,"ق",1,0],["ذا محيا الخديو لازال محيا","ه يحيى الأنامَ روحاً وجسما",44,"م",2,0],["ذا مجدُهم في نارِهم لكنهُ","ذا مجدُ كِسرَى صاحبِ الإِيوانِ",45,"ن",1,0],["ذا موقف فيه الهنا والسعود","خلا من القيل ومن قائلين",46,"ن",1,0],["ذا مَلَأَ الأَرْضَ بِإحْسانِهِ","وَذاكَ يَمْتَنُّ بِمَلءِ الجِفان",47,"ن",1,0],["ذاموطئٍ لأرجل الجلاس","وزوجها نادت بصوت الجهر",48,"ر",1,0],["ذا مَنبع العلم وَالتَقوى فَما فتئَت","وَرّادُهُ مِن رُبى لُبنان وَالمدنِ",49,"ن",1,0],["ذا مسعد الدين وَالدُنيا وَركنُهُما","وَمَن لَدَيهِ اسودُ البيدِ تَتضعُ",50,"ع",1,0],["ذا مشعل أحرقَ الدنيا وما وسعت","بشرّ ما صنعته كف إنسان",51,"ن",1,0],["ذا مِن لُطف القَول ومِن رِقَّتهِ","كالماءِ بِلَون ظرفِهِ قَد وُجدا",52,"د",2,0],["ذا مهجة ظمأنة للقا","ووجنة غرقها الأدمع",53,"ع",1,0],["ذا مشهد الشمس الذي فاق السما","إذ حسدت حصباءه النجوم",54,"م",1,1],["ذا موسمُ للأماني","بالنجحِ موفٍ مُبر",55,"ر",1,0],["ذا مَقامُ القُطبِ ذي القَدرِ العَلي","سَيدي عَبد العَزيزِ المَهدَوي",56,"ي",1,1],["ذا مقيمٌ للتلاقي في عَدَن","إذ يُنادى البارىءُ الموتى نَشَر",57,"ر",1,0],["ذا مرقد الحسن الزاكي الذي اندرجت","أسرار أحمد فيه بل سرائره",58,"ه",1,1],["ذا مَدْمَعٍ بِالدَّمِ المُنْهَلِّ مُنْسَجِمِ","أَمِنْ تَذَكُّرِ جِيرانٍ بذي سَلَمِ",59,"م",1,0],["ذا مَقال وَعيتهُ وَهو حقٌّ","صحّ مَعناه في صَحيح الكَلامِ",60,"م",1,0],["ذا مهبطُ الوَحي وَذا موطِنُ الر","رَحمَةِ مِمَّن خصَّ في برِّهِ",61,"ر",2,0],["ذا مذهبي مذ كان حظي جرعة","من نيل مصر ولم اكن بالحادس",62,"س",1,0],["ذا مهجة آمنةٍ للأذى","ما أمّنته مهجة الفرقد",63,"د",1,0],["ذا مكاني يوم رمح الغدر من حره ...زواني","ما لختالي علي حجه وانا سله ...ودله",64,"ل",2,0],["ذا موجُ عينيك العتيّ وقَد عَلا","مُسْتَحوذا لوجوديَ استحواذا",65,"ذ",2,0],["ذا مولد لدرة صافية","من بضعة طاهرة من طاهر",66,"ر",1,0],["ذا مصلح الدين الحنيف مهيمن","وكذاك صادق في مقام نبوة",67,"ه",1,0],["ذامعين الدين من خضعت","لعلاه البدو والحضر",68,"ر",1,0],["ذا مؤمن، ذا كافر، ذا أبيض","ذا أسود، يا ويل ذا من مشهد",69,"د",1,0],["ذا منتهى جهدي وجل تفكري","بقصور شعري فيك شعرٌ ثان",70,"ن",1,0],["ذا مَنْظَرٍ يُبْصِرُ الأعْمَى برؤيتِهِ","هُدىً وذا مَنْطِقٍ يَسْتنطقُ البُكُمَا",71,"م",2,0]]}