{"poems":[[71,"ما قام لولا هواك المدنف الوصب","https://www.aldiwan.net/poem4015.html","البسيط"],[29,"صدع الخليط فشاقني أجواري","https://www.aldiwan.net/poem6065.html","الكامل"],[61,"باليمن ما رفع الأمير وشيدا","https://www.aldiwan.net/poem51710.html","الكامل"],[52,"ضمن اللقاء رواح ناجية","https://www.aldiwan.net/poem26664.html","الكامل"],[19,"أبني لُبينى لستُم بيدٍ","https://www.aldiwan.net/poem329.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85558","الطويل"],[199,"يا عالم السر مني","https://www.aldiwan.net/poem51875.html","المجتث"],[224,"بكت وهي صرعى من هموم تحيقها","https://www.aldiwan.net/poem41892.html","الطويل"],[321,"خد الحبيب زانه","https://www.aldiwan.net/poem61809.html","مجزوء الرجز"],[365,"أهكذا يسري القمر","https://www.aldiwan.net/poem60902.html","مجزوء الرجز"],[403,"فيم الجفا وعلام الصد والملل","https://www.aldiwan.net/poem46541.html","البسيط"],[433,"عليكم جانبت أصحابي","https://www.aldiwan.net/poem12326.html","السريع"],[440,"نعم يبشر بدؤها بتمام","https://www.aldiwan.net/poem34866.html","الكامل"],[483,"صبّ برته لواعجُ الش","https://www.aldiwan.net/poem24482.html","عموديه"],[576,"راح رسولي وجاءني عاشق","https://www.aldiwan.net/poem3045.html","المنسرح"]],"verses":[["وَكانَ ظَنُّهُم أَن تَلتَقي بِهِم","مِصرُ البَوارَ وَتَغشى النُوبَةَ النُوَبُ",0,"ب",1,0],["وَكَأَنَّ ظُعنَ الحَيِّ حائِشُ قَريَةٍ","داني الجِنايَةِ مونِعُ الأَثمارِ",1,"ر",1,0],["وكأنَّ ظِلَّ النَّخلِ حولَ قِبابِها","ظِلُّ الغَمامِ إذا الهجيرُ تَوقَّدا",2,"د",2,0],["وَكَأَنَّ ظَعنَ الحَيِّ غادِيَةً","نَخلٌ سُقيتِ الغَيثَ مِن ظَعنِ",3,"ن",1,0],["وَكَأَنَّ ظُعنَ الحَيِّ مُدبِرَةً","نَخلٌ بِزارَةَ حَملُهُ السُعُدُ",4,"د",1,0],["وكان ظلام الجهل في الغرب عابساً","وكان ضياء العلم في الشرق يبسم",5,"م",1,0],["وكان ظنِّي جميلاً","فكنْ إذاً عندَ ظني",6,"ن",2,0],["وَكانَ ظَلامُ اللَيلِ يرخي سدولَه","وَأَنجُمهُ يذوي النُفوسَ بَريقُها",7,"ق",3,0],["وَكانَ ظَنّي أَنَّهُ","يَميلُ بي عَن مَيلي",8,"ل",2,0],["وكان ظِلاًّ فانحَسَر","إلاّ بقايا مِن ذِكَر",9,"ر",1,0],["وكان ظنّي بكم قبل النّوى حسناً","حتّى نأيتم فخابَ الظنُ والأملُ",10,"ل",1,0],["وكانَ ظَنِّي بكُمُ صادِقاً","فَغَرَّنِي مِنْهُ بِكَذَّاب",11,"ب",1,0],["وكَأَنَّ ظِلَّكَ لَيْلَةُ القَدْرِ الَّتِي","كَفَلَتْ بأَجْرِ تَهَجُّدِي وقِيامِي",12,"م",2,0],["وكأن ظلم اللعس من","شهد اللما حول اللسان",13,"ن",1,0],["وكان ظنِّي أَن سوف يطْرقُني","لأَنَّه النَّجمُ واسمه الطارِقْ",14,"ق",1,0]]}