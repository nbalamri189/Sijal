{"poems":[[47,"دع العبرات تنهمر انهمارا","https://www.aldiwan.net/poem25286.html","الوافر"],[67,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[19,"هل عاجل من متاع الحي منظور","https://www.aldiwan.net/poem342.html",""],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16637","الطويل"],[160,"أتخشى بأن يغشى صوارمه الظما","https://www.aldiwan.net/poem58941.html","الطويل"],[371,"من كل جفن بين عيني بين","https://www.aldiwan.net/poem57094.html","السريع"],[396,"قد أصبح الحبل من أسماء مصروما","https://www.aldiwan.net/poem614.html",""],[470,"أقول بعمان وهل طربي به","https://www.aldiwan.net/poem4737.html","الطويل"],[551,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[562,"بروق قد تخللها رعود","https://www.aldiwan.net/poem52749.html","الوافر"]],"verses":[["وَقَد ثَقَّفتُ لِلهَيجاءِ رُمحي","وَأَضمَرتُ المَهاري وَالمِهارا",0,"ر",2,0],["وَقَدْ ثَبَتَتْ عَدَاوَتُهُمْ فَتَمَيِّزْ","يَمِينِكَ مَنْ يكُونُ لهُ مُعِينا",1,"ن",2,0],["وَقَد ثَوَت نِصفَ حَولٍ أَشهُراً جُدُداً","يَسفي عَلى رَحلِها بِالحيرَةِ المورُ",2,"ر",1,0],["وقد ثَمِلَ الحادي بها من نسيمِها","كأنْ غالَهُ من كرْمِ بابِلَ إسْفِنْطُ",3,"ط",1,0],["وقد ثار نقع خلت أَن الضحى الدجى","به وتخيلت الأسنة أنجما",4,"م",2,0],["وقَد ثَوى بَينَ الأسَى والجَوى","قَلبي فَما يَصنعُ ذا بَينَ ذَين",5,"ن",1,0],["وقد ثوى نصف حولٍ أشهرا جددا","بباب أفأن يبتار السلاليما",6,"م",2,0],["وَقَد ثَبَتَت في الصَدرِ مِنها مَوَدَّةٌ","كَما ثَبَتَت في الراحَتَينِ الأَصابِعُ",7,"ع",1,0],["وقد ثوى أمَّ رأسي للصبابةِ ما","يُغرِي بمعصيتِي مَنْ لامَنِي ولَحا",8,"ح",2,0],["وقد ثارَ العَجاجُ بأرض قومٍ","عليهمْ مِنهُ قد خَفَقَتْ بُنودُ",9,"د",1,0]]}