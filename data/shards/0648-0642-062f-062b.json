{"poems":[[49,"دع العبرات تنهمر انهمارا","https://www.aldiwan.net/poem25286.html","الوافر"],[69,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[19,"هل عاجل من متاع الحي منظور","https://www.aldiwan.net/poem342.html",""],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16637","الطويل"],[164,"أتخشى بأن يغشى صوارمه الظما","https://www.aldiwan.net/poem58941.html","الطويل"],[376,"من كل جفن بين عيني بين","https://www.aldiwan.net/poem57094.html","السريع"],[401,"قد أصبح الحبل من أسماء مصروما","https://www.aldiwan.net/poem614.html",""],[475,"أقول بعمان وهل طربي به","https://www.aldiwan.net/poem4737.html","الطويل"],[556,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[567,"بروق قد تخللها رعود","https://www.aldiwan.net/poem52749.html","الوافر"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138198",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138271",""],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144123","الوافر"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48973","المتقارب"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28497","الطويل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110623","الطويل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/130018","الطويل"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100493","الطويل"],[3252,"","https://poetry.dctabudhabi.ae/diwan/poem/105714","المتقارب"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112693","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89397","الرجز"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95335","الرجز"],[4886,"لله كم من هضبةٍ وجبلِ","https://www.poetsgate.com/ViewPoem.aspx?id=170308",""],[5431,"غناء ...","https://www.poetsgate.com/ViewPoem.aspx?id=207456",""],[6345,"جور الزمان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78653&r=&rc=24",""]],"verses":[["وَقَد ثَقَّفتُ لِلهَيجاءِ رُمحي","وَأَضمَرتُ المَهاري وَالمِهارا",0,"ر",2,0],["وَقَدْ ثَبَتَتْ عَدَاوَتُهُمْ فَتَمَيِّزْ","يَمِينِكَ مَنْ يكُونُ لهُ مُعِينا",1,"ن",2,0],["وَقَد ثَوَت نِصفَ حَولٍ أَشهُراً جُدُداً","يَسفي عَلى رَحلِها بِالحيرَةِ المورُ",2,"ر",1,0],["وقد ثَمِلَ الحادي بها من نسيمِها","كأنْ غالَهُ من كرْمِ بابِلَ إسْفِنْطُ",3,"ط",1,0],["وقد ثار نقع خلت أَن الضحى الدجى","به وتخيلت الأسنة أنجما",4,"م",2,0],["وقَد ثَوى بَينَ الأسَى والجَوى","قَلبي فَما يَصنعُ ذا بَينَ ذَين",5,"ن",1,0],["وقد ثوى نصف حولٍ أشهرا جددا","بباب أفأن يبتار السلاليما",6,"م",2,0],["وَقَد ثَبَتَت في الصَدرِ مِنها مَوَدَّةٌ","كَما ثَبَتَت في الراحَتَينِ الأَصابِعُ",7,"ع",1,0],["وقد ثوى أمَّ رأسي للصبابةِ ما","يُغرِي بمعصيتِي مَنْ لامَنِي ولَحا",8,"ح",2,0],["وقد ثارَ العَجاجُ بأرض قومٍ","عليهمْ مِنهُ قد خَفَقَتْ بُنودُ",9,"د",1,0],["وقد ثملت براح الصفو من فرح","لما مسراتك انهلت به سحبا",10,"ب",2,0],["وقد ثملت نفوس الناس بشرا","كانّ سرورها بك كان خمرا",11,"ر",2,0],["وقد ثمِلتْ غصونُ البانِ سكراً","وغنّى الطيرُ حالاً بعدَ حالِ",12,"ل",1,0],["وقد ثَملَ القلبُ في حُبّها","ولم تسقِهِ الخَمرَ من حانِها",13,"ن",3,0],["وَقَد ثَبَتوا حَتّى طَلَعتَ عَلَيهِمُ","كَما قابَلَت شَمسَ الضُّحى الأَعيُنُ الرُّمدُ",14,"د",1,0],["وقد ثلمت ف الدين أية ثلمة","وفلت من الإسلام أي مهند",15,"د",1,0],["وقد ثار من وقع السنابكِ فسطلٌ","تخالُ لتلكَ النار منه دُخّانا",16,"ن",2,0],["وقد ثلمت في الدين أعظم ثلمةٍ","وأصبح منه المشل وهو مبدد",17,"د",1,0],["وقد ثل بالرغم عرش الهدى","كما سام عرش المعالي انثلالا",18,"ل",2,0],["وقد ثبتوا هضاب حجى بيوم","تطيش به البصائر والعقول",19,"ل",1,0],["وقُدَّ ثوبها ولكن من ورا","وهي على حال يسئ من يرى",20,"ر",2,0],["وقد ثلثت الرجُلين يا رجل","معناه صرت ثالثاً كذا نقل",21,"ل",1,0],["وقد ثوتْ في الدنّ عامين لَدُنْ","صارت أرقّ من دموع المقل!",22,"ل",1,0],["وقد ثُقّبتُ نايا حين غنى!","ليعزفني ويثمل فيه لحني",23,"ن",2,0],["وقد ثوت مهج الأطفال في حزَن ٍ","لمّا تحجر في أحشائهم ألمُ",24,"م",1,0]]}