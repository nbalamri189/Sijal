115,"هلايم طبعها ماتحشم الحاها","https://www.poetsgate.com/ViewPoem.aspx?id=196454",""]],"verses":[["اللَهَ في طَرفٍ بِكُم دامِعٌ","دامٍ وَقَلبٍ بِكُمُ مُغرَمِ",0,"م",1,0],["اللَّهَ فِي نَفْسِكَ أَوْلَى مَنْ لَهُ","ذَخَرْتَ نُصْحاً وَعِتَاباً يَقْبَلُ",1,"ل",1,0],["اللهَ في قلْبٍ تقسّمُ نارُهُ","ما بيْنَ مدْمَعِ ديمةٍ وأُوارِ",2,"ر",1,0],["اللهُ فِي أُمٍّ تُقِيمُ عَلَى","مَا نَابَهَا وَيَزُولُ أَوْحَدُهَا",3,"د",3,0],["اللهَ فِي مِصْرَ الثَّكُولِ وَقَلْبُهَا","تَتْلُو سِهَامَ البَيْنِ فِيهِ سِهَامُ",4,"م",1,0],["اللهَ فِي هِمَمِ الرِّجَالِ فَإِنَّهَا","تَلِدُ العَجَائِبَ وَالجُمُودُ عَقِيمُ",5,"م",1,0],["الله في نفس شُعاعٍ كلّما","هبّ النسيم تطير كل مطارِ",6,"ر",1,0],["اللَهُ فَضَّلَهُ وَاللَهُ وَفَّقَهُ","تَوفيقَ يوسُفَ إِذ وَصّاهُ يَعقوبُ",7,"ب",1,0],["اللَهُ فَضَّلَكُم وَأَعطى مِنكُمُ","أَمراً يُفَقِّئُ أَعيُنَ الحُسّادِ",8,"د",1,0],["اللَهُ فَضَّلَنا وَأَخزى تَغلِباً","لَن تَستَطيعَ لِما قَضى تَغيِيرا",9,"ر",2,0],["ألله في متكشّف الأحوال بل","ميت بسوء الحال غير دَفين",10,"ن",1,0],["اللَّهَ في مالِ قومٍ أنت كاسبُهُ","يا خيرَ مكتَسِبٍ من خير مكتسَبِ",11,"ب",1,0],["اللَّه في أهلي فإنك جارُهُمْ","لا تَضْرِبَنَّ عليهمُ الأسدادُ",12,"د",1,0],["اللَهُ في قَتلى جُفونِكِ أَنَّهُم","ظَلَموا نُفوسَهُم وَما ظَلَموكِ",13,"ك",1,0],["اللَهُ في أُمَّةٍ جرَ الزَمانُ بِها","يَفنى الزَمانُ وَلا يَفنى لَها أَلَمُ",14,"م",1,0],["الله في عون الجري","ح منك جراحَ القطط",15,"ط",1,0],["الله في مهجاتهم وقلوبهم","فلقد عهدتك بالنفوس رحيما",16,"م",2,0],["الله في الخلق من صب ومن عانى","تفنى القلوب ويبقى قلبك الجاني",17,"ن",2,1],["اللَهُ في وَطَنٍ ضَعي","فِ الرُكنِ واهي المَعقِلِ",18,"ل",1,0],["اللَهَ في روحِ صَبٍّ يَغشِيانِ بِها","مَوارِدَ الحَتفِ لَم يَنقُل لَها قَدَما",19,"م",2,0],["اللَهَ في كَبِدٍ سَقَيتَ بِأَربَعٍ","لَو صَبَّحوا رَضوى بِها لَتَصَدَّعا",20,"ع",2,0],["اللَهُ في مُهجَةٍ أَيتَمتَ واحِدَها","ظُلماً وَما اِتَّخَذَت غَيرَ الهَوى وَلَدا",21,"د",2,0],["اللَهُ في فَنَنٍ تَلهو الزَمانَ بِهِ","فَإِنَّما هُوَ مَشدودٌ بِأَحشائي",22,"ي",1,0],["اللَهُ فيهِ جَلا الحَرا","مَ لِخَلقِهِ وَجَلا حَلالَه",23,"ل",2,0],["اللَهَ في الأَحبارِ مِن مُتَهالِكٍ","نِضوٍ وَمَهتوكِ المُسوحِ مُصَرَّعِ",24,"ع",1,0],["اللهُ فَضَّلَهُ قِدْماً وَشَرَّفَهُ","جَرَي‌ بِذَاكَ لَهُ فِي‌ لَوْحِهِ القَلَمُ",25,"م",1,0],["اللَهُ في كُلِّ حادِثٍ ثِقَتي","وَاللَهُ عِزّي وَاللَهُ مُفتَخَري",26,"ر",2,0],["اللَهَ في قَتلِ فَتىً مُسلِمٍ","ما نَقَضَ العَهدَ وَما خانِك",27,"ك",1,0],["اللَّهُ فِي عَينٍ جَفَاهَا الْكَرَى","فِيكُمْ وَقَلْبٍ قَدْ بَرَاهُ الْغَرَامْ",28,"م",1,0],["اللهَ في إخوانِكم وبلادِكم","أَفَما تَرَوْنَ الخطبَ كيف تَهجَّما",29,"م",2,0],["الله في تلكَ المقاعدِ إنّها","مُهَجُ الأُبوَّةِ والبنينَ الهُمَّدِ",30,"د",1,0],["اللَهَ في أَمَلٍ لِمِصرَ مُحَبَّبٍ","هَتَفَ البَشيرُ بِهِ عَلى الأَبوابِ",31,"ب",1,0],["اللَهَ في وَطَنٍ يَظَلُّ مُصابُهُ","يَقضي عَلى أَعقابِكُم أَن تُنكَبا",32,"ب",2,0],["اللَهُ في سَبع وَستين اِنطَوت","وَالمَوت مَضاء العَزيمة يَطرد",33,"د",1,0],["اللَّهُ فَضَّلَهُ وَرَجَّحَ قَدْرَهُ","فَلْيَهْنِهِ التَّفْضيلُ وَالتَّرْجِيحُ",34,"ح",1,0],["اللَهَ في قَتلي مُعَذِّبَتي","لا تَقتُلي في غَيرِ ما جُرمِ",35,"م",1,0],["الله في أمّة جار الزمان بها","يفنى الزمان ولا يفنى لها ألم",36,"م",1,0],["اللَهُ فَوقَ الخَلقِ فيها وَحدَهُ","وَالناسُ تَحتَ لِوائِها أَكفاءُ",37,"ا",2,0],["اللّهَ فِي عَهدِكَ يَا خَيْرَ مَنْ","أَضْحَى عَلَى العَهْدِ كَمَا أَمْسَى",38,"س",2,0],["اللّهَ فِي بَأْسِكِ يا مَنْ بِمَا","أَمْضَاهُ عَدْلاً شَرَّفَ الْبَأْسَا",38,"س",2,0],["اللّهَ فِي حِلْمِكَ يَا مَنْ بِهِ","أَلاَنَ قَلْبَ الأَصْلَدِ الأَقْسَى",38,"س",2,0],["اللّهَ فِي جَوْدِكَ يَا مَنْ سَخَا","فَلَمْ يَذَرْ فِي جَوِّهِ بُؤْسَا",38,"س",2,0],["اللّهُ فِي أَبْطاِلكِ الصَّيدِ مِنْ","دُهاةِ حْربٍ غُيَّبٍ حُضَّرِ",39,"ر",1,0],["اللهُ في أدْوَاحِكَ النُّضْرِ الَّتِي","تَرِدُ المَعِينَ مِنْ الْجَمَادِ النَّاضِبِ",40,"ب",1,0],["الله في مهج تذوب وموطنٍ","حرب على المتَقَحّم الذّوادِ",41,"د",1,0],["اللّه في طِفْلٍ غزاهُ الضَّنَى","بأدْهَمِ الخَطْبِ ومُغْبَرِّه",42,"ر",2,0],["اللّه في جنبه ولوعته","هشيم غصن أذابه شرره",43,"ر",2,0],["الله فوَّضَهُ؛ ليُع","دل في الورى أو يظلما",44,"م",2,0],["اللهُ في الوجهِ الجمي","لِ، وفي ابتسامةِ ثغره",45,"ر",2,0],["اللَّه في أهلي فإنك جارُهُمْ","لا َضْربَنَّ عليهمُ الأسدادُ",46,"د",1,0],["الله في وطنٍ يظل مصابه","يشكو الحوادث والزمان القلبا",47,"ب",2,0],["اللَه في كلف الأحشاء مفتون","يهتاجه الشوق من بادٍ ومكنون",48,"ن",1,1],["اللهَ فيهم فحرثُ الأرضِ في يدهم","يبدون مِن سرّها ما كان مكنونا",49,"ن",2,0],["اللهَ في غرسك لا تُذوِه","من بعد إثمارٍ وإيراقِ",50,"ق",1,0],["اللهَ فيَّ فسِتْري فيكِ مُنْهتِكٌ","وكان قبلَكِ سِتري غيرَ مُنْهتِكِ",51,"ك",1,0],["اللَهَ في مهج برا","ها يا عذارى حبُّكُنّه",52,"ن",2,0],["اللَه فيّ فإنّ كاسي","ملؤها بهواك علقَم",53,"م",1,0],["اللَه في قلبي الكليمِ","فجرحه الدامي تسمّم",53,"م",1,0],["اللَه في ابن الأرض يا بنت السما","قد تاه في القفر المخيف فأرشدي",54,"د",2,0],["اللهَ في مهجةِ ذي لوعةٍ","تَيَّمَهُ يومَ النَّقا الرَّبرب",55,"ب",1,0],["الله فيها ضامن تأييدهُ","ولذاك فازوا مذ نزلت وأُيدوا",56,"د",3,0],["اللَه فيك أرى إني ليطربني","أن الوجود جميعاً روحه الغاني",57,"ن",2,0],["اللَهَ فَاِتَّقِهِ وَأَوفِ بِنَذرِهِ","وَإِذا حَلَفتَ مُمارِياً فَتَحَلَّلِ",58,"ل",1,0],["اللَهَ في كَبِدي الَّتي أَحرَقتَها","عَبَثاً بِجَمرَةِ خَدِّكَ الوَقّادِ",59,"د",1,0],["اللهُ فَضَّلَنَا عَلَى مَنْ قَبْلَنَا","فَمَلِيكُنَا مَوْلاَيَ إِسْمَاعِيلُ",60,"ل",1,1],["اللهَ فِي قَلْبِي الذِي أَصْلَيْتَهُ","بِسَعِيرِ هَجْرِكَ ذِي الْهَجِيرِ الْمُحْرِقِ",61,"ق",1,1],["اللَه في حُرُمات ودٍّ أَصبحت","هَمَلاً وأَصبحَ هديُها تَضليلا",62,"ل",2,0],["الله في نفسٍ عليكِ تقسَّمتْ","ما بين يأْسٍ مقنطٍ وَرجاءِ",63,"ا",2,0],["الله في قطعِ أَرحامٍ وَفصمِ عرى","عهدي بها وهي وثقى ليس تنفصم",64,"م",1,0],["اللَه فضله اللَه جمله","اللَه أرسله للجن والبشر",65,"ر",1,0],["اللَه في آياته عجب","والدهر في طياته عبر",66,"ر",1,0],["اللَه في العاني يكتّم حبه","فيثير فيه الحب كل دفين",67,"ن",1,0],["اللَه فيك أخي وفي نظراتك ال","عذبات ترنو شمالاً وجنوبا",68,"ب",2,0],["اللَهُ في ذمّة المَضنى الكَئيب لَقَد","أَضَعتُها ذمّة لِلوَجد منتسبَه",69,"ب",2,0],["الله في القرآن أوصانا بها","وبها نطيع المصطفى المختارا",70,"ر",2,0],["اللهَ في مغرمٍ أنْحَلْتموهُ أسىً","ما 