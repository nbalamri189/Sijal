{"poems":[[77,"الصبر إلا في هواك حميد","https://www.aldiwan.net/poem36607.html","الكامل"],[88,"خرج الناس يهرعون احتفاء","https://www.aldiwan.net/poem44795.html","الخفيف"],[88,"نعمت الدار للنفيض دارا","https://www.aldiwan.net/poem44999.html","الخفيف"],[27,"أمسى خليطك قد أجد فراقا","https://www.aldiwan.net/poem5934.html","الكامل"],[51,"قل للحكيم أبي الحسين ومن جلا","https://www.aldiwan.net/poem9408.html","الكامل"],[89,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[45,"إني لفعلك يا محمد حامد","https://www.aldiwan.net/poem63455.html","الكامل"],[28,"بل ما رأيت ولا سمعت به","https://www.aldiwan.net/poem5129.html","الكامل"],[28,"تبكي المراغة بالرغام على ابنها","https://www.aldiwan.net/poem5481.html","الكامل"],[66,"من لي بقربك والمزار عزيز","https://www.aldiwan.net/poem40650.html","الكامل"],[105,"سر يا أسامة ما لجيشك هازم","https://www.aldiwan.net/poem43570.html","الكامل"],[52,"ذم الزمان لدمنة","https://www.aldiwan.net/poem26825.html","مجزوء الكامل"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[75,"قد سار بي هذا الزمان فأوجفا","https://www.aldiwan.net/poem69062.html","الكامل"],[50,"الله أكبر والصغير صغير","https://www.aldiwan.net/poem63801.html","الكامل"],[1,"إني وجدك ما هجوتك وال","https://www.aldiwan.net/poem34016.html","الكامل"],[76,"هيج البين دواعي سقمي","https://www.aldiwan.net/poem38984.html","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/86022","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42564","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67300","الكامل"],[90,"سلمى ايضاً او وردة بين اشواك!","https://www.poetsgate.com/ViewPoem.aspx?id=179123",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[51,"قل للحكيم أبي الحسين ومن جَلاَ","https://www.poetsgate.com/ViewPoem.aspx?id=27421",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[127,"طرقت أسيماء الرحال ودوننا","https://www.aldiwan.net/poem24275.html","الكامل"],[185,"لمن الشموس غربن في الأحداج","https://www.aldiwan.net/poem14137.html","الكامل"],[189,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[282,"أظبى جردت لنا من جفون","https://www.aldiwan.net/poem32358.html","الخفيف"],[349,"لا رحت للآمال منك مبلغا","https://www.aldiwan.net/poem15782.html","الكامل"],[366,"لا أنت تعطيني ولا أنا أسأل","https://www.aldiwan.net/poem17324.html","البسيط"],[371,"أحديث نفسي أم سمر","https://www.aldiwan.net/poem57452.html","مجزوء الكامل"],[410,"ذهب الفرزدق بالفخار وإنما","https://www.aldiwan.net/poem67499.html","الكامل"],[416,"عفت المنازل رقة ونحولا","https://www.aldiwan.net/poem54062.html","الكامل"],[432,"أما الكواكب فاحتموا بمواكب","https://www.aldiwan.net/poem12405.html","الكامل"],[543,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[551,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[551,"من رأى الأظعان فوق","https://www.aldiwan.net/poem47903.html","مجزوء الرمل"],[562,"لمن المضارب في ظلال الوادي","https://www.aldiwan.net/poem52867.html","الكامل"],[567,"غدر الزمان وجار في أحكامه","https://www.aldiwan.net/poem69653.html","الكامل"]],"verses":[["ولقَدْ هَمَمْتُ بأنْ أرَوّيَ غُلّةً","لجَحيمِها بيْنَ الضّلوعِ وَقودُ",0,"د",1,0],["ولقد هوَّن الحفاوة منهم","أنهم يحتفون لا عن شعور",1,"ر",1,0],["ولقد هانت النوائب فيه","إذ لبسنا الصبر الجميل شعارا",2,"ر",2,0],["وَلَقَد هَمَمتُ بِأَن أُدَمِّرَ بارِقاً","فَرَقَبتُ فيهِم عَمَّنا إِسحاقا",3,"ق",2,0],["ولقد هَمَمْتُ بطيِّ عُرْفِكَ طاعةً","فَغَدَت شَواَهِدُهُ بِسِرِّي بُوَّحَا",4,"ح",2,0],["ولقد هون الحمام على النا","س وقد عضهم شباه الشيوع",5,"ع",1,0],["وَلَقَد هُزِزتَ فَكُنتَ أَحمَدَ مُنصُلٍ","غَمَدَتهُ لَخمُكَ في العُلا أَو غامِدِ",6,"د",1,0],["وَلَقَد هَدى بِكَ كُلَّ مُلتَبَسٍ","وَشَفى بِعَدلِكَ كُلَّ ذي غِمرِ",7,"ر",1,0],["وَلَقَد هَمَمتَ بِقَتلِ نَفسَكَ خالِياً","أَو بِالفَرارِ إِلى سَفينِ أَوالِ",8,"ل",1,0],["وَلَقَد هَزَزتُ إِليكَ دَوحَ قَريحَتي","مَدحاً فَأَينَعَ دَوحُها المَهزوزُ",9,"ز",1,0],["ولقد هَزمتَ جُموعَهم فتفرَّقوا","وشَفاكَ منهم جَيْشُكَ المُتلاحِمُ",10,"م",1,0],["وَلَقَد هَزَزتُ مُهَنَّداً","عَضبَ المَضارِبِ مُرهَفا",11,"ف",2,0],["ولقد هَمَمْتُ بأنْ أفُكَّ قُيودَهَا","لمّا رأيْتُ المُحسِنينَ قَليلا",12,"ل",2,0],["ولقد هزَزْتُ الكأسَ في يدِ مثلِها","وصحَوْتُ عمّا رَقّ منها أو صَفا",13,"ف",2,0],["وَلَقَد هَتَفتُ وَفي الأَناةِ بَقِيَّةٌ","إِنّي لَكُم مِنهُ الغَداةَ نَذيرُ",14,"ر",1,0],["وَلَقَد هَمَمتُ بِذاكَ إِذ حُبِسَت","وَأُمِرُّ دونَ عُبَيدَةَ الوَذَمُ",15,"م",1,0],["ولقد هاجَ لقلبي سَقَماً","ذِكرُ مَن لو شاءَ داوى سَقَمي",16,"ي",1,0],["ولقد هاجوا في الجحيم وماجوا","كخضم مرّت عليه الدَّبور",17,"ر",1,0],["ولقد هزتني الخطوب ثقالا","مثلما هزت الحروب كميا",18,"ي",2,0],["وَلَقَدْ هَبَطْتُ الْغَيْثَ يَلْمَعُ نَوْرُهُ","فِي كُلِّ وَضَّاحِ الأَسِرَّةِ أَغْيَدِ",19,"د",1,0],["وَلَقَدْ هُدِدْتُ لفَقْدِ حَمْزَةَ هُدَّةً","ظَلَّتْ بَناتْ الجَوْفِ مِنْها تَرْعُدُ",20,"د",1,0],["ولقد هانت الصبابةُ لو أنّى","أتتْني تَعِلةً من لُماك",21,"ك",1,0],["ولقد هزّني مسيلُ غديرٍ","مِنْ على جانبيهِ روضٌ عشيب",22,"ب",1,0],["ولقد هَمَمْتُ بعليِّ عُرْفكَ طاعَة ً","فَغَدَت شَوَاهِدُهُ بِسِرِّي بُوَّحَا",23,"ح",2,0],["ولقد هونت على النفس مني","قبل هذا ضراءها السراء",24,"ا",2,0],["وَلَقَد هَبَطت الغَيثَ يَدفَعُ مَنكَبي","طِرفٌ كَسافِلَةِ القَناةِ ذَنوبُ",25,"ب",1,0],["ولقَدِّها طولُ الرماحِ ولينُها","وفعالُها بلَهاذمٍ وزِجاج",26,"ج",1,0],["وَلَقد هزّت الملائكُ مَهداً","كانَ مِن فوقهِ له اِستلقاءُ",27,"ا",2,0],["وَلَقَد هاجَتِ النَواقيسُ بِالدي","رِ جَناني فَكُنتُ كَالمَجنونِ",28,"ن",1,0],["وَلَقَد هُزَمتُ الناكِثينَ لِبَيعَتي","لِمّا عَقَرتُ بِحَيِّهِم جَمَلاً رَغا",29,"غ",2,0],["وَلَقَد هَمَمتُ بِفِعلِ ما أَجلَلتُكُم","عَن ذِكرِهِ وَتَرَكتُهُ وَسَأَفعَلُ",30,"ل",1,0],["ولقد هَممتُ بأن أقو","لَ سُقيتَ يا قَبرُ المَطَر",31,"ر",1,0],["وَلَقَد هَجا فَأَمَضَّ أَخطَلَ تَغلِبٍ","وَحَوى اللُها بِبَيانِهِ المَشهورِ",32,"ر",1,0],["ولقد هَزَزْتُكَ للجميل فخِلْتَني","أنِّي أهزُّ مهنَّداً مصقولا",33,"ل",2,0],["ولقدْ هَوِيتُ طلوعَ نجمٍ ثاقِبٍ","منهم فكان هُوِيَ نَجْمٍ ثاقِبِ",34,"ب",1,0],["وَلَقَد هَرَّت فَما عَزَّت بِهِ","كَلبَةُ الأَودِيِّ إِذ ضاعَ الذِمارُ",35,"ر",1,0],["ولقد هفا قلبي بها وَلَعثرَةٌ","بِالقَلبِ تُنسي عَثْرةَ الأقدامِ",36,"م",1,0],["وَلَقَدْ هاجَ اِشتِياقي","نوحُ قُمْرِيٍّ ينوحُ",37,"ح",1,0],["ولقد هَمَمتُ بتَرْكهِ لو لم تَكُنْ","غَلَبَتْ عَلَيَّ صَبابةٌ بفُؤادي",38,"د",2,0],["وَلَقَدْ هَجَرْتُ الصَّبْرَ بَعْدَ فِرَاقِهِ","وَلَقَدْ مَزَجْتُ دَماً بِدَمْعِ جَارَى",39,"ر",2,0]]}