https://www.poetsgate.com/ViewPoem.aspx?id=171979",""],[5358,"طيرُ المَجَرّةِ","https://www.poetsgate.com/ViewPoem.aspx?id=48735",""],[5358,"معكم فؤادٌ","https://www.poetsgate.com/ViewPoem.aspx?id=202325",""],[5444,"مجد القلم","https://www.poetsgate.com/ViewPoem.aspx?id=205506",""],[5704,"حُبٌّ وشِعْر","https://www.poetsgate.com/ViewPoem.aspx?id=191112",""],[5704,"مَعْشُوقتِي","https://www.poetsgate.com/ViewPoem.aspx?id=191144",""],[5704,"شوقي الى المختار","https://www.poetsgate.com/ViewPoem.aspx?id=194470",""],[5720,"هَذَا صَبَاحُكَ","https://www.poetsgate.com/ViewPoem.aspx?id=213305",""],[5956,"الناي مَرْضِيّة دنيا وآخرةً","https://www.poetsgate.com/ViewPoem.aspx?id=193574",""],[6117,"سطوة الحمى","https://www.poetsgate.com/ViewPoem.aspx?id=183708",""]],"verses":[["لِلَّهِ كَم أَطفَأتَ مِن نارٍ ذَكَت","دَهراً وَكَم هَدَّأتَ مِن أَشجانِ",0,"ن",1,0],["للّه كم بتنا بها من ليلة","وكأنها سحرٌ من الأسحار",1,"ر",1,0],["للهِ كوكب سعد في سماءِ علًى","لو حلّ في الأفق لم يظلم على أحد",2,"د",1,0],["للهِ كم لكَ من يدٍ أسديتها","ما للمدائحِ في وفاها من يد",3,"د",1,0],["لله كم لك من يدٍ مأثورة","عندِي وكم لكَ من ندى متسرع",4,"ع",1,0],["لله كم خضعت لعليا مجده","رأس وكانت ذات صول لم يطق",5,"ق",1,0],["لله كم للعلى بكرٌ محجبةٌ","زفَّت إليه لقد زفَّت إلى رجل",6,"ل",1,0],["للَّهِ كفُّكَ أيُّ مُلْتَمَسٍ","للسائلين وأيُّ مُسْتَلمِ",7,"م",1,0],["لِلَّهِ كَيفَ تَبَذَّلَت آياتُها","مَن كانَ يَحسَبُ أَنَّها تَتَبَذَّلُ",8,"ل",1,0],["لِلَّهِ كَمتُغري الفَتى بِوِصالِها","وَتَضُنُّ حَتّى في الكَرى بِوِصالِها",9,"ل",3,0],["لِلَّهِ كَم قَلَّدتَني مِن مِنَّةٍ","وَالقَطرُ أَعظَمُ أَن يُحاطَ بِعَدِّهِ",10,"د",2,0],["لِلَّهِ كَفُّ مُحَمَّدٍ وَوِلادُها","لِلبَذلِ إِذ بَعضُ الأَكُفِّ عَقيمُ",11,"م",1,0],["للهِ كمْ زينْتِ مِنْ عقصةٍ","قالتْ وكمْ زينتُ مِنْ لحيهْ",12,"ه",1,0],["للهِ كم مرَّتْ لساكنِهِ بِهِ","مِنْ ليلةٍ ما شانَها تكديرُ",13,"ر",1,0],["لِلّهِ كمْ أَفْحَمَت أَفهامَنا حِكمٌ","مِنهُ وَكَم أَعجَزَ الأَلْبابَ تَأْويلُ",14,"ل",1,0],["لله كلب مرَّ بي فخسأتُه","والكلبُ معترِفٌ بكلِّ هوانِ",15,"ن",1,1],["للّه كيف تبدّلت آياتها","من كان يحسب أنّها تتبدّل؟..",16,"ل",1,0],["لله كم آية في شأنه نزلت","وكم حديث رواه الصادقون علي",17,"ل",2,0],["لله كم مرة حاضرته فحمى","شأني بحال بحبل الله متصل",17,"ل",1,0],["لله كم من ليلة قطع الدجا","فيها بركب الذكر والاوراد",18,"د",1,0],["لِلَّه كيف رَكَضتَ في طرُق العُلا","فَقَطَعتَها حينَ المجوِّدُ قَصَّرا",19,"ر",2,0],["لِلَهِ كَم حُسنٍ وَكَم بَهجَةٍ","تَسبي البَرايا تَحتَ ذاكَ اللِثام",20,"م",1,0],["لِلَّهِ كَم قَمَرَت لُبّي بِجَوِّكِ أَق","مارٌ وَكَم غازَلَتني فيكَ غِزلانُ",21,"ن",1,0],["لِلَّهِ كَم قَلَّدَ البَرايا","صَنيعَةً سَيفُهُ الصَنيعُ",22,"ع",1,0],["لِلَّهِ كَم لَكَ مِن يَدٍ مَشكورَةٍ","بَسَطَت عَوارِفُها لِسانَ الشاكِرِ",23,"ر",1,0],["للهِ كم فيكَ من ذكرى ومن عظةٍ","لأمةٍ حيّةٍ تمشي مع الأمم",24,"م",1,0],["لِلَّه كَم فيه مِن حُسنٍ يُدِلُّ به","لو كانَ يشفعُ ذاك الحسنَ إِحسانُ",25,"ن",1,0],["لله كم من تهاويلٍ ومن صور","ثيابُها ذات أَلوانٍ وأَرقام",26,"م",1,0],["لله كم قد عز في","ك عزاً وحزنا فيك حزنا",27,"ن",2,0],["لِلّه كَم ورقاء في وَرَقٍ شَجَت","فَنَنَ الغُصون تَفَنّناً وَتَرنّما",28,"م",2,0],["لِلَهِ كَفٌّ سَطَّرتهُ فَإِنَّها","مُجرى الحَياةِ وَمَنبَعُ الأَرزاقِ",29,"ق",1,0],["للهِ كم قلّد اللّيالي","من دُرّ عليائِه عقودا",30,"د",2,0],["لِلّه كم قلّدتْني مِنْ قبلها","بِلطائف الأشعارِ والأسْجاعِ",31,"ع",1,0],["لِلّه كم أرخصْتُ فيكِ مدامعاً","قد كنّ من قبل الفِراق غوالي",32,"ل",2,0],["للهِ كم مِننٍ أفاضَ على الوْرى","غَرّاء كالأطواقِ في الأجيادِ",33,"د",1,0],["لله كُتْبٌ توالت ضمنها دُررٌ","من بحر علمِك قَالوا إنها كَلِمُ",34,"م",1,0],["لله كم من انفس هلكت وكم","من مخصب غض علاه ذبول",35,"ل",1,0],["للّه كم خلق التجاوب صحبة","حتى مع الأشجار والحشرات",36,"ت",1,0],["لله كانون وقانا لفحه","نفحاتِ كانونَ التي لا تعذبُ",37,"ب",1,1],["للّهِ كم غازلتُ في","الربعِ غزالاً أحْوَرا",38,"ر",2,0],["للهِ كم قد خلَّفوا مِن مهجةٍ","حرّى وقلبٍ للغرامِ موجَعِ",39,"ع",1,0],["للّهِ كم في الديارِ الخُرسِ مِن وَصَبٍ","فيه لأهلِ الهوى والوجدِ معتبرُ",40,"ر",1,0],["للّهِ كم وجدِ هناكَ أثارَهُ","للصبِّ حادي العيسِ ساعةَ ثوَّرا",41,"ر",2,0],["للّه كم لك من فضل نشاهده","فما أجلك بين الناس من رجل",42,"ل",1,0],["للّه كل يرجع","فتصبروا واسترجعوا",43,"ع",3,1],["للَه كم من أنةٍ قد جرها","لها وكم من دمعةٍ أسالها",44,"ل",3,0],["للهِ كم غالِبٍ ردَّوهُ مُنغلِباً","وكم كسيرٍ بهم أعداءهُ غَلَبَا",45,"ب",2,0],["للّه كم في سربِكُم من مُقلةٍ","تمضي وبيضُ صِفاحِها لا تجرَحُ",46,"ح",1,0],["للَّهِ كم في عِلمِه من دُرّةٍ","مخزونةٍ كمنَتْ بِلُخِّ فُراتِهِ",47,"ت",2,0],["للّهِ كم بعيونِ عينِ كِناسِكمْ","من ضَيغَمٍ يسطو وآخرَ يصرَعُ",48,"ع",1,0],["للَّهِ كم لكَ يا زَماني فيَّ منْ","جُرحٍ بجارحةٍ وسَهْمِ وَبالِ",49,"ل",1,0],["للّهِ كم في حيّهمْ من جُؤذرٍ","يَسطو بمُهجتِه فيصرَعُ ضَيْغما",50,"م",2,0],["لِلَّهِ كَم مِن عَالمٍ سِيمَ الرَّدَى","وَلِرُوحِه التعذِيبُ وَالإِزهَاق",51,"ق",1,0],["للهِ كم ليلةٍ طاوٍ سهرتُ بهِ","في صَوْمها لم أذُقْ زاداً ولم أنَمِ",52,"م",1,0],["للَّهِ كِفْتيٌّ أَطاعَ صَبَابَتي","فيه الفُؤادُ وَخَالَف اللُّوّاما",53,"م",2,1],["للَه كم من يد","قد طوقت جيد الزمن",54,"ن",1,0],["للَه كم لك في العلوم مناقب","لم يحصها المنظوم والمنثور",55,"ر",1,0],["للَه كم لك في الوجود مفاخر","سارت مسير الشمس حين تسير",55,"ر",1,0],["لله كم حملني منَّةً","خففت الباغض من تقلي",56,"ل",2,0],["لله كم قلدتني مننا بها","أطلقت من أسر المطامع جيدي",57,"د",2,0],["لله كم عندي له من يد","مالي بحمل البعض منها يدان",58,"ن",1,0],["لله كم ثغر فتح","ت رتاجه بعطفان ثغره",59,"ر",2,0],["لله كم من سؤدد","في بردَتيك ومن سدادِ",60,"د",1,0],["لِلَّهِ كَمْ لَكَ مِنْ يَدٍ مَأثُورَةٍ","عِنْدِي وَكَم لَكَ مِنْ نَدىً مُسْتَغْزَرِ",61,"ر",1,0],["للّه كأس من عقيق خمر","ها ريق الملاحِ",62,"ح",1,0],["للّهِ كم غادَروا في الربعِ بعدَهمُ","مضنىً له مِن أتيِّ الدمعِ غُدْرنُ",63,"ن",1,0],["لله كم كبدي تذوب تحسّراً","والعين تمزج ماءَ ها بدماها",64,"ا",3,1],["لِلّهِ كمْ طودٍ ظَهَرْتُ بظَهْرِهِ","عَلَماً وكم وادٍ عَرَضْتُ بِعُرْضِهِ",65,"ض",2,0],["للهِ كمْ كُرْبَةٍ تَجلَّتْ","بهِ وكمْ مُعْجِزٍ تَجدَّدْ",66,"د",1,0],["لِلهِ كمْ مَلْكٍ رَدَدْتَ بِغَيْظِهِ","خَزْيانَ يَنْهى الدَّهْرَ فيهِ ويَأْمُرُ",67,"ر",1,0],["للّه كم من ليلةٍ عاطيتُه","كأساً لها من وجنتيهِ لهيبُ",68,"ب",1,1],["لله كم من بيعة ناحت عليك","وكم بكاك من البرية مجمع",69,"ع",1,0],["لله كم خطت يداك لنا وقد","صرنا نهط لك الرثاء ونطيع",69,"ع",1,0],["للَه كم لخياله","من نعمة عندي سنيه",70,"ي",2,1],["للّه كم من ليلة قضيتها","سهرا بقربك تحت ظل العوسج",71,"ج",1,0],["للّه كم في حي ليلى فتاه","شاهدها المضنى عيانا فتاه",72,"ا",2,1],["لله كم لك من معنىً تحيّر في","إدراكه العقلُ والأوهامُ والفكر",73,"ر",1,0],["لله كم جُرعة غيظٍ ساغها","بعد نبيّ الله من أَصحابه",74,"ب",2,0],["لله كم يُطْمِعُ تَفْتِيرُها","لو أنها تَسْمح بالبَذْل",75,"ل",1,0],["للَه كم لهم من سطوة تركوا","بها ظهرة ذاك اليوم ديجورا",76,"ر",2,0],["لِلّه كم لك يا محمد من يد","معروفها يجري وليس يجاري",77,"ر",2,0],["لِلّه كل لك في نشر العلوم يد","بشكرها يتواصى السر والعلن",78,"ن",1,0],["لله كفّ منك ما سحّ الحيا","إلا وسحَّ لها مُلِثُّ غمام",79,"م",1,0],["للَه كم رافع كفيه مبتهل","يدعو الإله وللآي الكتاب قرا",80,"ر",2,0],["لله كم لي في خدور المنحنى","للوجد مني آخذ ونصير",81,"ر",1,0],["للَّهِ كَم حِصنٍ عَلَيهِ استَولَتِ ال","كُفَّارُ مِن ذَا المنجَنِيقِ الجَانِي",82,"ن",2,0],["لله كل الورى ماذا ألمَّ بهم","لقد أصيبوا بفقد العلم لو علموا",83,"م",3,0],["لله كم في كربلا","لك شنشنات حيدريه",84,"ي",2,0],["للَه كم ليلةٍ بتنا نساهرها","بلا رقيب وقد باتت تعللنا",85,"ن",2,0],["لِلّه كَم مِن لَيلة قَضيتها","لَهواً وَقَد هَجعت عُيون الحَرس",86,"س",1,0],["لِلّه كم قطعوا هنالك مهمهاً","تكبو الرياح به من الاعياء",87,"ا",2,0],["لِلّه كم من ليلة قد بات في","أسر الهموم مروعاً متقلقلا",88,"ل",2,0],["لله كم لك من يد مشكورة","ملأت عطاياها الحسان البيدا",89,"د",2,0],["لله كم اوليته من نعمة","وشغفت فيه كأنه ليلاكا",90,"ك",2,0],["لِلّه كم صعب الركوب مشغف","تركته أهوال المقات ذلولا",91,"ل",2,0],["للّه كم دوحةٍ جنينا","هناكَ أثمارُها الأثامُ",92,"م",1,0],["لله كم لك في الورى من همة","طرب المحب لها وغيظ حسود",93,"د",1,0],["لله كم وقعت في الطف قارعةٌ","ذلت ذووا المجد واستولت بها السفل",94,"ل",1,0],["للَه كم أوهن عظماً كربه","وكم قوىً هد وظهراً انقضا",95,"ض",2,0],["لِلّه كم من ليلة بتنا بها","نفني الدجى وسهادها يفنينا",96,"ن",2,0],["لِلَّه كَم أَهدت جمان كلامها","لِمَسامع المُتَشوق المتشوفِ",97,"ف",1,0],["للهِ كمْ نَفْسٍ شَعاعٍ أُتْلِفَتْ","حتّى تلافاها ونعّمَ بالَها",98,"ل",3,0],["للهِ كمْ صُوَرٍ به مَجْلوّةٍ","كادَتْ تُحقّقُ في العُيونِ مثالَها",98,"ل",3,0],["لله كمْ واليْتَهُنّ مَواهِباً","جعلَتْ لها صيدُ المُلوكِ وَلاءَها",99,"ا",3,0],["لِلهِ كأسٌ أَسكَرَتني خمرُها","كالصِرفِ وامتَزَجَت بعقلي والقُوَى",100,"ا",1,0],["لِلّه كيفَ تَوشَّحَ ال","عالي بذا الجِسمِ الوضيعِ",101,"ع",1,0],["لِلّه كَم لَيلةٍ والت بوصلتِهِ","الدَهرُ دَهري وَأَوقاتُ الصَفا دُوَلي",102,"ل",2,0],["لِلّهِ كَم جَمَعت عُليا بَلاغَتِها","مِن كُلِّ رائِقٍ مَعنى راقَ أَو لَطُفا",103,"ف",2,0],["لِلّهِ كَمْ رَوَّضَتْ يُمْناهُ مِن زَمَنٍ","جَدْبٍ وَراضَتْ جِيادَ الجُودِ إِذْ جَمَحَتْ",104,"ت",1,0],["لِلّهِ كَمْ لَيْلَةٍ نَعِمْتُ بِها","ما شَابَها قَطُّ رِيْبَةٌ وَخَنَا",105,"ن",2,0],["لِلَّهِ كَمْ مِنْ نِعْمَةٍ فِي نَقْمِةٍ","أَسْدَى وَكمْ قَتَلَ العَدَّو ومَا جَرَحْ",106,"ح",1,0],["للَه كاسات الهنا","كم رنحت عطفاً وهزت",107,"ت",1,0],["لِلَّهِ كَم فَتَكَت فِينَا لَوَاحِظُهَا","وَمَزَّقَتنَا بِرَميِ السَّهمِ وَالوَتَرِ",108,"ر",1,0],["لِلّه كَم شاعرٍ قَد باتَ يَمدحهُ","حيّاً وَمَيتاً فَلَم يَبقوا وَلَم يَذروا",109,"ر",3,0],["لِلَّهِ كُن مُخلِصاً فيما تَقومُ بِهِ","وَلا تُراقِب سِواهُ يكفِكَ الأَزلي",110,"ل",2,0],["لِلَّهِ كَواعِبٌ خضبنَ الكفّا","آثارُ دَمٍ صببنَه لا تَخفى",111,"ف",2,1],["للَه كم أقرحت جفن النبي وكم","قد ألبست فاطماً ثوباً من الحزن",112,"ن",1,0],["للَه كم أبدى دليلاً واضحاً","من بعده هو حجة للمبصر",113,"ر",1,0],["للَه كنز سعادة اكسيرها","أبدا عليه من الصيانة طلسم",114,"م",1,0],["للّه كاسٌ تجلَّت مثل غانيةٍ","قد كاد يسكرنا صوت العقار بها",115,"ه",2,1],["لِلَّهِ كم أَنا مَسرورٌ بِرُؤيَتِكُم","لما دُعيتُ وَقَد لَبّيتُ دعوَتَكُم",116,"م",1,1],["لِلَّهِ كَم أَنا مُشتاقٌ لِطيبَةَ وَال","أَيّامُ تُقعدني عَنها لِزَلّاتي",117,"ت",2,0],["لِلَّهِ كَم سارَتِ الرُكبانُ أَرسالا","تَؤُمُّ أَمَّ القُرى لِلَّهِ إِجلالا",118,"ل",2,1],["لله كم أحيا بيوت الله","لا زال محروسا بعين الله",119,"ه",1,0],["لله كم ادمت عليه كريمة","خدا وكم بكى عليه سيد",120,"د",1,0],["لله كم شقت عليه حشاشة","أسفا وكم فريت عليه أكبد",120,"د",1,0],["لِلَهِ كاساتٌ ثَلاثٌ جَمَّعَت","لِذاتِها فَتَناسَبَت أَسبابُها",121,"ب",3,0],["للّه كم منه يعذَّب عاشق","ولكم به يمسي البريء قتيلا",122,"ل",2,0],["لله كم من فؤادٍ بالأسى صُدِعا","وكم مع الدمع قلبٌ ذاب فانهمعا",123,"ع",2,1],["لله كان أمينَه في أرضه","يهدي وينشر في النفوس شرائعَه",124,"ع",2,0],["لله كم من هضبةٍ وجبلِ","من الهوى بها يسير جَمَلي!",125,"ل",2,1],["لله كتاب بأقوى دليل","اتانا وعز وراق وطاب",126,"ب",1,0],["للهِ كمْ سافرتُ في عينٍ ولا","أبغي رجوعا من كلا البحرينِ",127,"ن",1,0],["لله كم رأت العروبة محنةً","ولكم تقدّم باسمها المتأخر",128,"ر",1,0],["لله كيف هوى البريء مضرجاً","بدمٍ يراق على الصعيد هتون",129,"ن",1,0],["لله كم للجهل عندك من يدٍ","أزرت بكل يدٍ من العرفان",130,"ن",1,0],["للهِ، كمْ نطقتْ بالشّعرِ عيناها","ماذا من الشّعر يبقى لي لألقاها",131,"ا",3,1],["لله كم سلبت شعوراً عندما","سلت شعوراً من لبيب ماهر",132,"ر",1,0],["لله كم لك من مقام قمته","بالحق تفصل باللسان الفيصل",133,"ل",1,0],["للهِ كمْ كانَ المُشَبِّهُ مُخْطِئاً","لو كانَ جانَبَكَ الكَمَالُ المُطْلَقُ",134,"ق",1,0],["للهِ كيفَ الماءُ يُعْلِنُ حربَهُ","وتظلُّ كالمُتَفَرِّجِ الشُطآنُ!",135,"ن",1,0],["للهِ كيفَ الرّوحُ يجتاحونَها","وتعيشُ لا تَتَحرّكُ الأبدانُ!",135,"ن",1,0],["لله كيف سعادتي","إذ لاحَ سطريَ من عَدم",136,"م",1,0],["لله كمْ جارَ الحبيبُ وكمْ قسا","وكأنّ بُعْدَ الحِبِّ لا يعنيهِ",137,"ي",2,0],["لله كمْ طلعتْ شمسٌ بجبْهَتِهَا","والشمسُ قد حُجِبَتْ مِنْ نورِ مرْآهَا",138,"ا",3,0],["لله كم زاد الغرام بمهجتي","بات الحنين مهيمنًا ومخيِّما",139,"م",2,0],["لِلهِ كُلُّ الحَمْدِ إذْ أَهْدَىٰ لَنَا","عُمْراً جَدِيْدَاً فِيْهِ حَلَّ سَلَامُ",140,"م",1,0],["لله كم عنده ممّا يكافئنا","من أفضل النسل بالتعليم والسَّلَمِ",141,"م",1,0],["للهِ كم ضرَّتِ الحُمَّى وما فعلَتْ !","ألقتْ بِرَأسِي عَلَى مَطويَّةِ الجسَدِ",142,"د",1,1]]}