94013",""],[5956,"هو صاحبي الأغلى الأبُ المسؤولُ","https://www.poetsgate.com/ViewPoem.aspx?id=194273",""],[5974,"خربشات","https://www.poetsgate.com/ViewPoem.aspx?id=215808",""],[5975,"على نغم المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=58500",""],[5977,"وأحبهم","https://www.poetsgate.com/ViewPoem.aspx?id=213390",""],[5997,"جائحة","https://www.poetsgate.com/ViewPoem.aspx?id=214297",""],[6068,"في أي فلب أسكن -14-","https://www.poetsgate.com/ViewPoem.aspx?id=175866",""],[6089,"خذ غيومك وارتحلْ","https://www.poetsgate.com/ViewPoem.aspx?id=214046",""],[6102,"كلميني","https://www.poetsgate.com/ViewPoem.aspx?id=184858",""],[6113,"قصة شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=44360",""],[5309,"إذا رمت ان تحيا سليما من الأذى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573774",""],[6185,"أحلى مهاة !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86942&r=&rc=2",""],[119,"ضارعت زفرة الذنوب بكائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55607&r=&rc=4",""],[572,"هذا الصَّباحُ فما الّذي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9283&r=&rc=140",""],[572,"أَشْتَهي في الغناء بُحّة َ حَلْقٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9228&r=&rc=85",""],[5064,"درسٌ نحوِيّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87546&r=&rc=41",""]],"verses":[["وَاِحبِسا الرَكبَ عَلى حا","جَةِ ذي القَلبِ الطَروبِ",0,"ب",1,0],["وأحْبِسُ الرَّكْبَ يا ظَمْياءَ إنْ بَرَقَتْ","غَمامةٌ وشَدَتْ وَرْقاءُ في فَنَنِ",1,"ن",1,0],["وأحَبِّرُ الكَلِمَ التي لا أرتَضي","مِنها بغَيرِ الشّاردِ المُتَخيّرِ",2,"ر",1,0],["وَأَحبَبتُ يَوماً أَن أَراها بِحِليَةٍ","فَصُغتُ لَها تاجاً وَلكِنَّهُ حَجَر",3,"ر",1,0],["وَأَحَبَّ نَبْتَ الرَّوْضِ فِي","أَفْيَائِهَا وَأَبَر أَهْلَهْ",4,"ل",2,0],["وَأَحَبُّ الأُولَى رَعَوْا","أُمَماً مَنْ رَعَى الحُرَمْ",5,"م",1,0],["وَأَحبَبتُ أَهلَ الغَورِ مِن حُبِّ ذي فَناً","وَأَحبَبتُ سُلمانَينَ مِن حُبِّ زَينَبا",6,"ب",2,0],["وَاِحبُ المُجامِلَ بِالجَزيلِ وَصَرمُهُ","باقٍ إِذا ضَلَعَت وَزاغَ قِوامُها",7,"م",3,0],["وَأَحَبُّ إِخواني إِلَيَّ أَبَشَّهُم","بِصَديقِهِ في سِرِّهِ أَو جَهرِهِ",8,"ر",2,0],["وأحبُّ لي الآن مدحة بنت يوم","من طروس في حلةٍ بعد حله",9,"ل",2,0],["وأَحَبَّاك حُبَّ مولىً شكورٍ","فهما وامقان بل عاشقانِ",10,"ن",1,0],["وأحب تعريفي تَحفِّيهِ به","فافتنَّ فه مُسائلاً ومُفاطِنا",11,"ن",2,0],["وَأُحِبُّ كُلَّ مُهَذَّبٍ وَلَو اَنَّهُ","خَصمي وَأَرحَمُ كُلَّ غَيرِ مُهَذَّبِ",12,"ب",1,0],["وَاِحبِب بِلادَكَ مِثلُ موسى كاظِمٍ","حُبّاً بِهِ الإِخلاص وَالإيثارُ",13,"ر",1,0],["وَأُحِبُّ أَزهارِ الحَدائِقِ وَردَها","وَأُحِبُّ مِن وَردِ الرِياضِ عَبيرُهُ",14,"ر",2,0],["وَأَحِبَّةً سَدَّ القُنوطُ عَلَيهِمُ","وَالخَوفُ كُلَّ مُعَبِّدٍ مَسلوكِ",15,"ك",1,0],["وَأَحَبُّ غَيثٍ ما هَمى في أَرضِها","حَتّى الحَيا الباكي عَلى أَطلالِها",16,"ل",3,0],["وَأَحَبَّ حَتّى مَن أَحَبَّ هَلاكَهُ","وَأَعانَ حَتّى مَن أَساءَ وَأَجرَما",17,"م",2,0],["وَأُحِبُّها نوراً جَميلاً صافِياً","مُتأَلِّقاً في النَفسِ وَالوِجدانِ",18,"ن",1,0],["وَأُحِبُّها سِحراً يَرُفُّ مَعَ النَدى","وَيَموجُ في الأَلوانِ كَالأَلوانِ",18,"ن",1,0],["وَأُحُبُّها ذِكرى تُطيفُ بِخاطِري","لِأَخٍ هَوَيتُ وَغادَةٍ تَهواني",18,"ن",2,0],["وأحب ذكراه وأكره أن أرى","بيد السلو دثورها وعفاءها",19,"ا",3,0],["وَأَحَبُّ مِن طولِ الحَياةِ بِذِلَّةٍ","قِصَرٌ يُريكَ تَقاصُرَ الأَقرانِ",20,"ن",1,0],["وَأَحبابٍ سُقيتُ بِهِم سُلافاً","وَكانَ الوَصلُ مِن قِصَرٍ حَبابا",21,"ب",2,0],["وأحبُّ من طعنِ الوريدِ وشكِّه","شكِّي بمبزالٍ وريد دِنَانِ",22,"ن",1,0],["وأحبُّ أجفانَ الحِسانِ ومحتَوى","قلبي الْتِمَاعُ ودائعِ الأجفانِ",22,"ن",1,0],["وَأَحَبُّ آفاقِ البِلادِ إِلى الفَتى","أَرضٌ يَنالُ بِها كَريمَ المَطلَبِ",23,"ب",1,0],["وَأَحبَبتُ مِن حُبِّها الباخِلي","نَ حَتّى وَمِقتُ اِبنَ سَلمٍ سَعيدا",24,"د",2,1],["وَأُحبَسُ مَع أَنَّني ناطِقٌ","وَقَدرِيَ عِندَهُمُ مُهمَلُ",25,"ل",1,0],["وأحبُّ في الإعرابِ ما هو غامضٌ","عن نصفِ نحويٍّ وعابرِ عينِ",26,"ن",1,0],["وَأَحبَبتُها حُبّاً يَقَرُّ بِعَينِها","وَحُبّي إِذا أَحبَبتُ لا يُشبِهُ الحُبّا",27,"ب",2,1],["وَأَحبِسُ بِالعَراءِ المَحلِ بَيتي","وَدونَكَ عازِبٌ صَخَبُ الذُبابِ",28,"ب",1,0],["وَأَحْبارٌ تَقُولُ لَهُ شَبِيهٌ","وَرُهْبَانٌ تَقُولُ لَهُ ضَرِيبُ",29,"ب",1,0],["وأَحَبُّوا آلَ النبيِّ فكانوا","معهم في مَغِيبِهِمْ وَالحُضورِ",30,"ر",1,0],["وَأَحبِسُها إِلى أَن يَشتَهيها","وَآخُذُها بِرِفقٍ مِن يَدَيهِ",31,"ي",2,0],["واحْبُوَاهُ الأكْفانَ مِنْ وَرَقِ المُصْ","حَفِ كِبْراً عن أنْفَسِ الأبْرادِ",32,"د",1,0],["وأحببتُ فيها العذْلَ حُبّاً لذكرِها","فلا شيءَ أَشْهى في فؤادي منَ العَذلِ",33,"ل",1,0],["وأحبسها ما دام للزيت عاصر","وما طاف فوق الأرض حاف وناعل",34,"ل",1,0],["وَأَحَبُّ مَا يَبْقَى لِخِدْنٍ رَاحِلٍ","عَهْدٌ وَإِنْ شَطَّ المَزَارُ وَثِيقُ",35,"ق",1,0],["وَأُحِبُّ فِتْيَتَهَا الكِرَامَ فإِنَّهُمْ","سُمَحَاءُ فِي الإِعْلانِ وَالإِسْرَارِ",36,"ر",1,0],["وأَحَبُّ ما وقعَتْ علي","ه عيونُهم جُثثٌ وهام",37,"م",1,0],["وأُحبُّ القريضَ سمح المعاني","مُشرق اللفظ، شاجي الترديد",38,"د",1,0],["وأحبُّ من شرب الطِّلا","لا، بل عصير البرتقال",39,"ل",1,0],["وأحبسُ في القواء المحل بيتي","ودُنَكَ عَازِبٌ صَخِبُ الذُّبَابِ",40,"ب",1,0],["وأحب فجر ما يهل","عليك من أدجى الليالي",41,"ل",2,0],["وأحبِبْ بها من مُورقاتٍ عزيزةٍ","عليّ وبي من مُستهامٍ مؤرَّق",42,"ق",1,0],["وأُحبُّ شاطئَهُ وروعةَ سَفْحِهِ","تحنو على الأمواجِ فيه نخيل",43,"ل",1,0],["وأحبّه كثر ماقفّى عن عيوني بدون أسباب","وكثر ما أملاله أكواب الغلا .. وينثّر .. أكوابي",44,"ب",2,0],["وأحب تعريفي تَحفِّيهِ به","فافتنَّ فيه مُسائلاً ومُفاطِنا",45,"ن",2,0],["وأحبّ كلّ مهذب لو أنّه","خصمي، وأرحم كلّ غير مهذب",46,"ب",1,0],["واحبتي حولي وآرام الغضا","لعبت بهفهاف الربيع اماميا",47,"ي",2,0],["وأحببْ بمقدارٍ ولا تكُ مسرفاً","وأبغضْ بمقدارٍ يدومُ لك الظِّلُّ",48,"ل",1,0],["وأحب طلعته وحسنَ طباعه","أحببتُه يا صاحبي في مَهْدِه",49,"د",2,0],["وَاِحبِس عَطاياكَ الَّتي قَد أَذهَلَت","حَسبي نَوالاً أَن أَقولَ وَتَسمَعا",50,"ع",2,0],["وَأَحَبُّ يَومٍ عِندَهُ يَومٌ بِهِ","يُعطي الهُنَيدَةَ لِلفَقيرِ المُقتِرِ",51,"ر",1,0],["وَأَحَبُّ مِن هَذا إِلَيَّ لِقاؤُهُ","لِي مُسفِراً عَن بِشرِهِ مُتَهَلِّلا",52,"ل",2,0],["وأَحْبِسُ عنكِ النَّفْسَ والنَّفْسُ صَبَّةٌ","بِذِكْراكِ والممشى إليكِ قريبُ",53,"ب",1,1],["وأحببت من أحببتموه وإن دي","ني يهوى الذي أحببتموه وشكيمتي",54,"ت",2,0],["وأحبّ ما حفظ الحيا","ة على اتساق وائتلاف",55,"ف",1,0],["وَأَحبابهُم أهلُ الغِوايةِ مِثلهم","وَمَهما يكُن أَغوى يكُن عندَهم أحرى",56,"ر",2,0],["وَأحبار أنصارِ النبيّ هم همُ","عليهِ عبادَ اللَّه صلّوا وسلّموا",57,"م",3,0],["وَأَحَبُّ العُشّاقِ مَن هام يا لَي","لى بِلَيلى وَكان ما نَحنُ صِرنا",58,"ن",2,0],["وَأُحِبُّ تَلسَعُني عَقارِبُ صُدغِهِ","عِلماً بِأَنَّ رُضابَهُ دِرياقُ",59,"ق",1,0],["وَاحبُ النَديمَ بِها حَمراءَ صافِيَةً","صِرفاً إِذا ثَبَتَت في صَدرِهِ رَجفا",60,"ف",2,0],["وأحبُّ أن أقضي إليهِ محوِّلاً","وَجهي ففي أرضِ الشآمِ رجائي",61,"ا",2,0],["وأحبابي الأولى عاهدتهم","عقلوا عَقلي بمن أَهوى هياما",62,"م",2,0],["وَأَحْبِسُ عَنْ قَوْمٍ عِنانَ قَصائِدِي","وَقَدْ أَمْكَنَ الطَّرْفَ الْجَوادَ مَجالُ",63,"ل",1,0],["وَأَحبابي اِستَقَلّوا ما أُلاقي","مِنَ البُرَحاءِ فيهِم فَاِستَقَلّوا",64,"ل",3,0],["وأحباباً وأصحاباً كراماً","من البيت المشرف بالسراج",65,"ج",1,0],["وأحبب لخلق اللّه أمرا تحبه","كذا اكرملهم ما تكرهنه برحجان",66,"ن",1,0],["وأحببت مني ما أماتت جهالتي","حياةً محال بموتتي",67,"ي",1,0],["واحبه من عوالم السحر نايا","تتناغى بهمسه الأرجاء",68,"ا",2,0],["وَأحبّ مِن بيضِ الكَواعِبِ خُرَّداً","تَقليبه اللّدنَ الكَعوبَ الأَسمرا",69,"ر",2,0],["وأحبابُك في الوَصلِ","غَلَوا في السَّومِ واشْتَطّوا",70,"ط",3,0],["وأحبَّ يوماً أمَّه من قبل أن","كان ابنَها والأم كانت وامقه",71,"ق",2,0],["وأحبابٍ لنا جاروا فجاروا","حدود العدل فيما قد أذاعوا",72,"ع",3,1],["وأحبَّه مولاه دون أخيه في","معنىً يشير إلى خِفاهُ كتاب",73,"ب",1,0],["وَاحب مِن وَجه الحَبي","ب إِلى المُحب إِذا اِبتَسَم",74,"م",1,0],["وأحبوا النخيل والقمح والزه","ر وهيموا في فاتنات الحقول",75,"ل",1,0],["واحْبِسْ بكاظمةٍ قلوصَكَ مُنْشداً","ما لِلدّموع تسيلُ سَيْلَ الوادي",76,"د",2,0],["وَأَحبّ ذا الوَجهَينِ وَجهاً في النَدى","نَدياً وَوَجهاً في اللِقاء وَقاحا",77,"ح",2,0],["وأحبّاء كأنْ لم يأخذوا","من أبيّاتِ المعالي بخطام",78,"م",1,0],["وأحبابٌ كما أهوى كرامٌ","تنادمني على بنت الكروم",79,"م",1,0],["وأَحباب أُقاسي ما أُقاسي","عَذاباً من عذابهم الأَليم",80,"م",1,0],["واحبس بها الركب أن تقضي حقوق ثرًى","على المتيَّم حقٌّ أنْ يؤدِّيها",81,"ي",3,0],["وَأَحبِب إِذا أَحبَبتَ حُبّاً مقارِباً","فَإِنَّكَ لا تَدري مَتى أَنتَ نازِعُ",82,"ع",1,0],["واحبس قلوصك يا حادي وعج بحمى","وادي الجديدة ذات السح والهطل",83,"ل",1,0],["واحبّذا مربع حاك الربيع به","برود وشي تخال الأرضُ منه سما",84,"م",2,0],["وأحب أهلك أنهم","أهل الخلال المستقيمه",85,"م",2,0],["وأحبَّهم نشرا لمنقبَةٍ","وأشدَّهم لغميزةٍ دفنا",86,"ن",2,0],["واحْبُ جيدَ النيروز منها بطوقي","ن وفصِّل لليلة العيدِ عِقْدا",87,"د",2,0],["وأحبسُ أعناق المَطي عن السُّرى","وللشَّوْقِ ما بين الضُّلوعِ مَضاءُ",88,"ا",2,0],["وأحْبارُ دين اللّه لولا هُداهُمُ","إليه لما ألفيْتَ في الأرض مُسلِما",89,"م",2,0],["وأحبِسُ عَنكِ النَفسَ والنَفسُ صَبَّةٌ","بِقُربِكِ والمَمشى إِلَيكِ قَريبُ",90,"ب",1,0],["وأحبب عباده وابغض فيه منكرهم","واستنزل الحلم فيهم موضع الغضب",91,"ب",1,0],["واحْبِبْ رجالَ اللهِ للهِ وقفْ","ببابِهِمْ والله خيرُ من هَدَى",92,"ا",1,0],["وأحب شعباناً لأني لا أرى","منه إلى شوال غير ظلام",93,"م",1,0],["وأحب فيك الموت علماً أنني","بعد الممات إلى اللقاء نصيرُ",94,"ر",1,0],["وأُحِبُّه ويُحِبني رَغمَ العِدَا","وأنا به مُتفاخرٌ مُتَبَاهِ",95,"ه",1,1],["وأحبابٍ تَبارت في احتفاءٍ","عواطِفُهم وفاحت كالزُّهورِ",96,"ر",1,0],["وأُحبُّ أهلَ الفضلِ طُرّ","ا والفتَى مَعَ مَن أحب",97,"ب",1,0],["وأحب الظبي إذ أش","بهه في لحظاته",98,"ت",2,0],["واحبس العيس علينا ساعةً","عل ميت الشوق أن يصبح حيْ",99,"ي",1,0],["وأحببتها بل تلك كانت هي التي","قديما أحبتني فزال التقاطع",100,"ع",1,0],["وأحببت بالتكليف إظهار حكمة ال","ظهور وحكمي ما أنا فيه جائر",101,"ر",1,0],["وأُحبُّ آثارَ العُلومِ وأبتغي","صُحُفَ الأدِيبِ على نُضارِ التاجرِ",102,"ر",1,0],["وأُحِبُّ المُجَنَّبَاتِ كَحُبِّي","للمَبَادي مَوْصُولَةً بالنَّشِيْدِ",103,"د",1,0],["وأَحبَّةٍ سُمْرٍ شُعُورُهُمُ","لَيْلٌ فَصَوت حُليِّهم سَمَرُ",104,"ر",1,0],["وأَحببتُ خِدمَةَ مَنْ دَهْرُنا","لأَغْراضِه خَادِمٌ أَصْغَر",105,"ر",1,0],["وأُحِبُّ لَيلى وهِي لَيْس تُحبُّني","وتحِبُّني لُبنى ولَسْت أُحِبُّها",106,"ب",3,0],["وأحبب في الإله وعاد فيه","وأبغض جاهداً فيه ووال",107,"ل",1,0],["وأحبه كل لفرط بشاشة","طُبعت ولم يكن البشاشة كاسبا",108,"ب",2,0],["وأحْبَسَ واجبي رجُلٌ ظلُومٌ","غَشومٌ لا يَتوبُ ولا يُنيبُ",109,"ب",1,0],["وأحبة أسررت من كلفي","وهواي فيهم لاعجا كمنا",110,"ن",2,0],["وأحبُّ من مجرى السوابق جدول","ينساب بين متالع ووهاد",111,"د",1,0],["وأحب رسلك بالسؤال عن الحمى","وبنيه طيب شمائل وجنائب",112,"ب",1,0],["وأحبط مسعاهم بإصلاح أمرنا","وسيرٍ كما ينهي الكتابُ ويأمر",113,"ر",1,0],["وأحب أن يمسي جمي","ع العالمين لهم حبائبْ",114,"ب",1,0],["وأحب ما احتفلوا به","أن يخلفَ الفوضى نظام",115,"م",1,0],["وأحب ميثاق إلى حُفَّاظه","ما جاءهم من طائع مختار",116,"ر",1,0],["وأحبُّ ما ارتاحت إليه نفسه","ما أنت مدركه قوى وجهادا",117,"د",2,0],["وأحبسهُ في اللَه قسراً وإنَّما","تكونُ بداياتُ المطيعينَ بالقسرِ",118,"ر",1,0],["وأُحبُّ اللسانَ كاللَّوْلَبِ الدا","ئرِ لا كالمسمارِ أو كالرزَّه",119,"ز",2,0],["وَاِحْبُ هَذي العجوزَ بِسِترٍ","فَهوَ مَهرُ العَجوزةِ الشّوهاءِ",120,"ا",2,0],["وَا حبيبَ الأُمَّةِ قَد يَتَّمتَنا","يا أَبا كُلِّ فَتاةٍ وَوَليدِ",121,"د",1,0],["وَا حَبيبَ الأُمَّةِ قَد أَصبَحَ ال","عيشُ مِن بَعدِكَ لي جِدَّ نَكيدِ",121,"د",1,0],["وَأَحبِب بِهِ مِن قادِمٍ في جَبينِهِ","سَنا مِسحَةٍ مِن بَهجَةٍ وَجَمالِ",122,"ل",1,0],["وأحبا ملة الإسلام لما","أقام رسومها بعد الدمار",123,"ر",1,0],["وَأحبُّ مَن يَصبو إِلى العلياء كم","يَصبو جميل إلى وصالِ بثينِ",124,"ن",1,0],["وأحببت فيها عبيرَ الزهور","وأنشودةَ القمح والساقية",125,"ي",2,0],["واحبذا شوّالنا وهلالهُ","شهرٌ لياليه علينا عيدُ",126,"د",1,1],["وأَحْبَبْتُكم طِفْلاً وقد شابَ مَفْرِقي","ولي بدواعي حُبِّكمْ لَهَجُ الطِّفْلِ",127,"ل",1,0],["وأَحْبُوكِ مِنْ نظمي نسيبَ قَصائِدٍ","إلى مدحِ مجدِ الدِّينِ تُعْزَى وتُنسَبُ",128,"ب",1,0],["وأحبَّ رؤيته فأنبتَ نرجساً","إن الرياضَ عيونهنَّ النرجسُ",129,"س",1,0],["وأحبب لكل مظفر بودادهم","واخدم جنابهم بحسن تودد",130,"د",1,0],["وأحبُّ الفتى يَهَشُّ إلى الضي","فِ بأخلاقه العِذاب اللِّطافِ",131,"ف",1,0],["وَاِحبِس قَلوصَكَ ساعَةً بِطُلولِهِم","وَاِحذَر عَلَيكَ بِها مِنَ الأَغوالِ",132,"ل",1,0],["وَأُحِبُّ مِن حُبّي لَها","مَن وَدَّها وَأَحَبَّها",133,"ب",3,0],["وَأُحِبُّ جارِ