{"poems":[[55,"ما للبياض والشعر","https://www.aldiwan.net/poem30486.html","مجزوء الرجز"],[107,"سيد الرسل وأم المؤمنين","https://www.aldiwan.net/poem44196.html","الرمل"],[54,"قل لمشيبي إذ بدا","https://www.aldiwan.net/poem26784.html","مجزوء الرجز"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[124,"أينغي يا زهراتي","https://www.aldiwan.net/poem49294.html","مجزوء الرمل"],[295,"ما لقصر الزهور أضحى كئيبا","https://www.aldiwan.net/poem11707.html","الخفيف"],[415,"أئن غض دهر من جماحي أو ثنى","https://www.aldiwan.net/poem32063.html","الطويل"],[438,"قامت حروب الهوى على ساق","https://www.aldiwan.net/poem12314.html","المنسرح"],[998,"","https://poetry.dctabudhabi.ae/diwan/poem/205359",""],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69195","المنسرح"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55884","الرمل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88643","الخفيف"],[2350,"","https://poetry.dctabudhabi.ae/diwan/poem/147620","الخفيف"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127392","الرمل"],[4680,"ذكرَ القلبُ سناها فوثبْ","https://www.poetsgate.com/ViewPoem.aspx?id=185093",""],[5459,"كيف نعلو ..","https://www.poetsgate.com/ViewPoem.aspx?id=197648",""]],"verses":[["أَينَ غَزالٌ داجِنٌ","رَأى البَياضَ فَنَفَر",0,"ر",1,0],["أين غابت أيَّ أرضٍ نزلت","كيف غُمَّ الأمرُ هل من مُسْتَبِينْ",1,"ن",1,0],["أَينَ غُرابٍ أَسوَدٌ","أَطَرتَهُ يا عَقعَقُ",2,"ق",1,0],["أين غطاريف الجلاد بالظبى","أين مشائيم الطعان بالقنا",3,"ا",1,0],["أينغي يا زهراتي","لقديم الصبوات",4,"ت",1,1],["أين غازي أين حامي","الإسلام والإيمان",5,"ن",1,0],["أئِن غَضَّ دهرٌ من جِماحيَ أو ثَنَى","عِنانيَ أو زَلَّت بأَخْمَصِيَ النَّعْلُ",6,"ل",1,1],["أَيْنَ غَزَالُ الْكِنَاسِ مِنْ رَشَإِ","يَنْطَحُ من فاحمٍ بِأَرْوَاقِ",7,"ق",1,0],["أين غماماتك الغوادي","يروى بها الوهد والنجود",8,"د",1,0],["أَينَ غضاراتها وَلذّتها","وَأَينَ محبورها وَحابرها",9,"ر",3,0],["أين غزلان حسان أشرقتْ","كبدور وتباهت كالديم",10,"م",1,0],["اين غيث الندى وان هو الا","عارض مر موهنا فاِستقلا",11,"ل",2,0],["اين غوت الصَريخ لم يلف الا","صخرة ان عندها ثم ولى",11,"ل",2,0],["أين غزلان عالج والمصلى","من ظباء سكنَّ نهر المعلى",12,"ل",2,1],["أين غاب النور عني","أين آثار الطريق",13,"ق",1,0],["أين غابت بهجةٌ تملؤنا؟","كنسيمٍ في فضاء الروح هَبْ",14,"ب",1,0],["أين غابت شهامة وإباء..","هل مضى العز وانتهى الإقدام ؟!",15,"م",1,0]]}