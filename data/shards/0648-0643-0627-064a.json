an.net/poem5259.html","الطويل"],[28,"لو أعلم الأيام راجعة لنا","https://www.aldiwan.net/poem5276.html","الطويل"],[28,"أقول لحرف قد تخون نيها","https://www.aldiwan.net/poem5396.html","الطويل"],[28,"فإن له كفين في راحتيهما","https://www.aldiwan.net/poem5397.html","الطويل"],[28,"إن تقتلوا منا خداشا فإنها","https://www.aldiwan.net/poem5411.html","الطويل"],[28,"وقائلة لي لم تصبني سهامها","https://www.aldiwan.net/poem5422.html","الطويل"],[28,"وكائن أبى من خطة الديم واشترى","https://www.aldiwan.net/poem5423.html","الطويل"],[28,"أفاطم لا أنسى نعاس ولا سرى","https://www.aldiwan.net/poem5545.html","الطويل"],[28,"فرعن وفرغن الهموم التي سمت","https://www.aldiwan.net/poem5547.html","الطويل"],[28,"وجدنا الأبرش الكلبي تنمي","https://www.aldiwan.net/poem5554.html","الوافر"],[28,"فقد بلغتني من كنت أرجو","https://www.aldiwan.net/poem5555.html","الوافر"],[28,"أبى الحزن أن أسلى بني وسورة","https://www.aldiwan.net/poem5648.html","الطويل"],[105,"أما والليالي وأحداثها","https://www.aldiwan.net/poem43141.html","المتقارب"],[105,"أهذي ديار القوم غيرها الدهر","https://www.aldiwan.net/poem43415.html","الطويل"],[13,"وبالشعب إذ سدت بجيلة فجه","https://www.aldiwan.net/poem2213.html","الطويل"],[75,"أرياك أم ردع من المسك صائك","https://www.aldiwan.net/poem69053.html","الطويل"],[75,"أليلتنا إذ أرسلت واردا وحفا","https://www.aldiwan.net/poem69061.html","الطويل"],[75,"تقدم خطى أو تأخر خطى","https://www.aldiwan.net/poem69107.html","المتقارب"],[46,"معان من أحبتنا معان","https://www.aldiwan.net/poem23635.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85494","الطويل"],[106,"كأس تفيض","https://www.poetsgate.com/ViewPoem.aspx?id=179509",""],[13,"وَبِالشِّعْبِ إذْ سَدَّتْ بَجِيلَةُ فَجَّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=180797",""],[45,"مِثَالُكَ مِنْ طَيْفِ الخَيَالِ المُعَاوِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=31687",""],[28,"وقائلة لي لم تصبني سهامها","https://www.poetsgate.com/ViewPoem.aspx?id=21980",""],[75,"تقدّم خطى ً أو تأخّر خطى ً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10782&r=&rc=2",""],[130,"لئن تك لمتى شعثت زمانا","https://www.aldiwan.net/poem54739.html","الوافر"],[179,"خليلى إنى اليوم شاك إليكما","https://www.aldiwan.net/poem59049.html","الطويل"],[196,"بأي نعي صبحتنا الركائب","https://www.aldiwan.net/poem51977.html","الطويل"],[199,"وعاذلة هبت بليل تلومني","https://www.aldiwan.net/poem2078.html","الطويل"],[235,"إلى ما فؤادي يذوب زفيرا","https://www.aldiwan.net/poem18193.html","المتقارب"],[273,"كفاني الحر منتجع الغمام","https://www.aldiwan.net/poem25530.html","الوافر"],[278,"ألا هكذا فليحرز الحمد والأجرا","https://www.aldiwan.net/poem60701.html","الطويل"],[278,"أرى العلياء واضحة السبيل","https://www.aldiwan.net/poem60777.html","الطويل"],[284,"ألم تعلمي يا عمرك الله أنني","https://www.aldiwan.net/poem34064.html","الطويل"],[317,"منعتك من قرني قباذ وليتني","https://www.aldiwan.net/poem23910.html","الطويل"],[318,"كوكب اليمن بمصر قد ظهر","https://www.aldiwan.net/poem67195.html","الرمل"],[320,"ما الناس إلا في رماق وصالح","https://www.aldiwan.net/poem56355.html","الطويل"],[361,"غشيت بِقرا فرط حول مكمل","https://www.aldiwan.net/poem1723.html","الطويل"],[363,"أتوعدني كأنك ذو رعين","https://www.aldiwan.net/poem44500.html","الوافر"],[365,"وكائن من فتى سوء تريه","https://www.aldiwan.net/poem4613.html","الوافر"],[365,"تخرمها العطاء فكل يوم","https://www.aldiwan.net/poem4614.html","الوافر"],[366,"أتتني لسان بني عامر","https://www.aldiwan.net/poem1872.html","المتقارب"],[393,"ألا هل لهذا الدهر من مُتعللٍ","https://www.aldiwan.net/poem607.html",""],[429,"يروع الذئب حيث سواك راع","https://www.aldiwan.net/poem12377.html","الوافر"],[436,"خلا الدهر من خطب يضيق له ذرعي","https://www.aldiwan.net/poem34853.html","الطويل"],[436,"أبى الله إلا أن يرى يدك العليا","https://www.aldiwan.net/poem34875.html","الطويل"],[456,"لعل الركب أن خلصوا نجيا","https://www.aldiwan.net/poem55813.html","الوافر"],[456,"عجلت بحطك فيها الرحالا","https://www.aldiwan.net/poem56065.html","المتقارب"],[456,"أمرتجع لي فارط العيش بالحمى","https://www.aldiwan.net/poem56129.html","الطويل"],[456,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[462,"عيون المهى قلبي بنبلك مجروح","https://www.aldiwan.net/poem3149.html","عموديه"],[462,"رجونا بديوان المعدي راحة","https://www.aldiwan.net/poem3353.html","عموديه"],[469,"ألا يا لقوم للجديد المصرم","https://www.aldiwan.net/poem753.html",""],[472,"لسان الفتى نصف ونصف فؤاده","https://www.aldiwan.net/poem2147.html","الطويل"],[538,"أرى الناس في أمر سحيل فلا تزل","https://www.aldiwan.net/poem56673.html","الطويل"],[556,"أيها السائر بالركبان حي","https://www.aldiwan.net/poem33571.html","الرمل"],[561,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[565,"أخ لي كنت أغبط باعتقاده","https://www.aldiwan.net/poem69712.html","الكامل"],[567,"ونار دعوت المعتفين بضوئها","https://www.aldiwan.net/poem52006.html","الطويل"]],"verses":[["وَكائِن تَرى مِن حاذِرٍ مُتَحَفِّظٍ","أُصيبَ وَأَلفَتهُ المَنيَّةُ في الأَهلِ",0,"ل",1,0],["وَكائِن دَفَعنا عَنكُمُ مِن مُلِمَّةٍ","وَكُربَةِ مَوتٍ قَد بَتَتنا عِقالَها",1,"ل",3,0],["وَكائِن دَفَعنا عَنكُمُ مِن عَظيمَةٍ","وَكُربَةِ مَوتٍ قَد بَتَتنا عِقالَها",2,"ل",3,0],["وَكائِن لَنا فَضلاً عَلَيكُم وَمِنَّةً","قَديماً فَما تَدرونَ ما مَنُّ مُنعِمِ",3,"م",1,0],["وَكائِن لي ثَناءٌ راحَ يَثني","إِلَيهِ العِطفَ مَجدُكُمُ الأَثيلُ",4,"ل",1,0],["وَكائِن رامَتِ الأَيّا","مُ تَرويعي فَلَم أَرتَع",5,"ع",1,0],["وَكائِن قَرَنتَ الحَقَّ مِن ثَوبِ صَفوَةٍ","وَمِن سابِحٍ طِرفٍ وَمِن كاعِبٍ بِكرِ",6,"ر",1,0],["وَكَائِنْ طَوَى مِنْ لَيْلَةٍ نَابِغِيَّةٍ","بِهَا رَقَدَ الشَّاكِي وَقَاضِيهِ سَهْرَانُ",7,"ن",1,0],["وَكَائِنْ تَلَقَّى صَدْمَةَ الدَّهْرِ صَابِراً","كَأَنَّ نَظِيراً لِلنَّظِيرِ يُصَادِمُ",8,"م",1,0],["وَكائِن تَخَطَّت ناقَتي مِن مَفازَةٍ","إِلَيكَ وَمِن أَحواضِ ماءٍ مُسَدَّمِ",9,"م",1,0],["وَكائِن تَخَطَّت ناقَتي مِن مَفازَةٍ","وَمِن نائِمٍ عَن لَيلِها مُتَزَمِّلِ",10,"ل",1,0],["وَكائِن تَخَطَّت ناقتي من مَفازَةٍ","وَهَلباجَةٍ لا يُصِدرُ الهَمَّ رامِكِ",11,"ك",1,0],["وَكائِن تَخَطَّت صَيدَحٌ مِن تَنوفَةٍ","تُجاوِرُ فَيفَي جَوفِ ماءٍ مُعَرمَضِ",12,"ض",1,0],["وَكائِن طَوَت أَنقاضُنا مِن عِمارَةٍ","لِنَلقاكَ لَم نَهبِط عَلَيها نَزورُها",13,"ر",3,0],["وَكائِن تَخَطَّت ناقَتي مِن مَفازَةٍ","وَكَم زَلَّ عَنها مِن جُحافِ المَقادِرِ",14,"ر",1,0],["وَكَائِن قَد قَطَعتُ إِلَيكِ خَرقاً","يُمَيِّثُ مُنَّةَ الرَجُلِ الجَليدِ",15,"د",1,0],["وَكائِن ذَعَرنا مِن مَهاة وَرامِح","بِلادُ الوَرى لَيسَت لًهُ بِبِلادِ",16,"د",1,0],["وَكائِن بِنا هاوَينَ مِن بَطنِ هَوجَلٍ","وَظَلماءَ وَالهِلباجَةُ الجِبسُ راقِدُ",17,"د",1,0],["وكائنْ ترى مخدومة في جلالها","سعت حيث أبكاها الردى سعي خادم",18,"م",1,0],["وكأيّن في الناس من ذي خمول","صار بالعلم كعبة القُصّاد",19,"د",1,0],["وَكائِن تَرى في الحَيِّ مِن ذي صَداقَةٍ","وَغَيرانَ يَدعو وَيلَهُ مِن حِذارِيا",20,"ي",2,0],["وَكائِن بِالأَباطِحِ مِن صَديقٍ","يَراني لَو أُصِبتُ هُوَ المُصابا",21,"ب",2,0],["وَكائِن رَأَيتُ مِن مُلوكٍ وَسوقَةٍ","وَصاحَبتُ مِن وَفدٍ كِرامٍ وَمَوكِبِ",22,"ب",1,0],["وَكائِن رَأَيتُ مِن مُلوكٍ وَسوقَةٍ","وَراحِلَةٍ شُدَّت بِرَحلٍ مُحَبَّرِ",23,"ر",1,0],["وكائنْ وكمْ من ذاتِ ودقينِ ضئْبلٍ","نآدٍ كفيت المسلمين عُضالَها",24,"ه",2,1],["وكائنْ وكمْ من ذي أواصر حوله","أفاد رغيباتِ اللُّهى وجزالَها",25,"ه",2,1],["وكائن في المعاشر من أناس","أخوهم فوقهم وهم الكرام",26,"م",1,1],["وَكائِن تَرى مِن سَيِّدٍ ذي مَهابَةٍ","أَبوهُ أَبونا وَاِبنُ أُختٍ وَمَحرَما",27,"م",2,0],["وكأيِّنْ لحيلةٍ ولِرَأيٍ","مُحْصَدٍ من مُحَيَّنٍ مَحْصُودِ",28,"د",1,0],["وكايِلي واحتكمي وخُطّي","وهذه نُقودُنا فاشتطِّي",29,"ط",2,0],["وكائنْ كسوتُكَ من حُلَّةٍ","مشيتَ بها مِشيةَ الرافل",30,"ل",1,0],["وكائن من ابن له","وإن كان لم يُمنهِ",31,"ن",2,0],["وَكائِن فَتىً هَزَّني قَولُهُ","أَنا خِدنُكَ الصادِقُ المُجتَبى",32,"ب",2,0],["وكائن ترى من شاهد مثل غائب","ومنغائب في طنه مثل شاهد",33,"د",1,0],["وكائن ترى من طائش في فعاله","وبعد قليل يعتريه التندم",34,"م",1,0],["وَكَأَيٍّ مِن عَدُوٍّ كاشِحٍ","لَكَ بِالأَمسِ هُوَ اليَومَ خَدين",35,"ن",1,0],["وكايلْ شُؤْمهُ صاعاً بصاعٍ","ومن يغلِبْ فإن له الفضيلَهْ",36,"ل",2,0],["وَكائِن جَحَدتُم مِن أَيادي مُحَمَّدٍ","كَواكِبَ دَجنٍ مِن لُهىً وَمَواهِبِ",37,"ب",1,0],["وَكائِن لَهُ في ساحَتي مِن صَنيعَةٍ","قَطَعتُ بِها عُقلَ القَوافي الشَوارِدِ",38,"د",1,0],["وَكائِنٍ غَدَت لي وَهيَ شِعرٌ مَسَيَّرٌ","وَراحَت عَلَيَّ وَهيَ مالٌ مُقَسَّمُ",39,"م",1,0],["وَكائِن أَتَتها لِلشَمالِ هَدِيَّةٌ","مِنَ التُربِ مِن أَنقاءِ وَهبٍ غَريبُها",40,"ب",3,0],["وَكائِن وَصَلنا لَيلَةً بِنَهارِها","إِلَيكَ كِلا عَصرَيهِما أَنا دائِبُه",41,"ب",2,0],["وَكائِن إِلَيكُم قادَ مِن رَأسِ فِتنَةٍ","جُنوداً وَأَمثالُ الجِبالِ كَتائِبُه",41,"ب",2,0],["وَكائِن لَكُم آلَ المُهَلَّبِ مِن يَدٍ","عَلَيَّ وَمَعروفٍ يَروحُ وَيَغتَدي",42,"د",2,0],["وَكائِن لِلمَهَلَّبِ مِن نَسيبٍ","تَرى بِلَبانِهِ أَثَرَ الزِيارِ",43,"ر",1,0],["وَكائِن لَبِسنا مِن رِداءِ وَديقَةٍ","إِلَيكَ وَمِن لَيلٍ تُجِنُّ حَظائِرُه",44,"ر",2,0],["وَكائِن فيكَ مِن مَلِكٍ هُمامٍ","أَبٍ لَكَ مِثلِ مُنصَدِعِ النَهارِ",45,"ر",1,0],["وَكائِن لَبِسنا مِن رِداءِ وَديقَةٍ","إِلَيكَ وَلَيلٌ كَالرُوَيزِيَّ سائِرُه",46,"ر",2,0],["وَكائِن بِها مِن عَينِ باكٍ وَعَبرَةٍ","إِذا اِمتُرِيَت كانَت سَريعاً دُرورُها",47,"ر",3,0],["وَكائِن لَها مِن مَحبِسٍ أُنهِبَت بِهِ","بِجَمعٍ وَبِالبَطحاءِ عِندَ المُشَعَّرِ",48,"ر",1,0],["وَكائِن تَرَكنا بِالخُرَيبَةِ مِن فَتىً","كَريمٍ وَسَيفٍ لِلضَريبَةِ قاطِعِ",49,"ع",1,0],["وَكائِن دَعَونا اللَهَ حَتّى أَجابَنا","بِأَبيَضَ عاصِيٍّ تَفيضُ أَنامِلُه",50,"ل",2,0],["وَكائِن عَلَيها مِن رَديفٍ وَحاجَةٍ","وَمَجدٍ إِلى مَجدٍ رَواسٍ أَثاقِلُه",51,"ل",2,0],["وَكَأيِن بَعَثنا مِنكُمُ مِن مُرِنَّةٍ","بَلابِلُها في الصَدرِ غَيرُ قَليلِ",52,"ل",1,0],["وَكائِن مِنَ الأَيدي الظَوالِمِ أَصبَحَت","بِكَفَّي بِلالِ الجودِ كانَ نَكالِها",53,"ل",3,0],["وَكائِن أَبى مِن خُطَّةِ الدَيمِ وَاِشتَرى","مَكارِمَ أَيّامٍ شَديدٍ قِتالُها",54,"ل",3,1],["وَكائِن مَنَعتُ القَومَ مِن نَومِ لَيلَةٍ","وَقَد مَيَّلَت أَعناقَهُم لا أَنامُها",55,"م",3,0],["وَكائِن أَنَخنا مِن ذِراعَي شِمِلَّةٍ","إِلَيكَ وَقَد كَلَّت وَكَلَّ بَغامُها",56,"م",3,0],["وَكائِن فيكَ مِن ساعاتِ يَومٍ","مِنَ الفَرّاءِ بادِيَةِ النُجومِ",57,"م",1,0],["وَكائِن مِن وَقائِعَ يَومَ بَأسٍ","لِكَلبٍ كُنَّ في عَرَبٍ وَرومِ",57,"م",1,0],["وَكائِن قَد شَنَفنَ مُقَلِّصاتٍ","إِلى صَوتٍ وَما هُوَ غَيرُ يَومِ",58,"م",1,0],["وَكائِن أَصابَت مُؤمِناً مِن مُصيبَةٍ","عَلى اللَهِ عُقباها وَمِنهُ ثَوابُها",59,"ب",3,0],["وَكائِنْ تَرى مِن فَتىً لا يَقومُ","غَداةَ الحِفاظِ مَقامَ الفَتاةِ",60,"ه",1,0],["وَكائن تَرى من ذي ثَمانين خَضَّبت","لِطُولِ البُكى مِن شَيبهِ الأَدمعُ الحُمرُ",61,"ر",1,0],["وَكائِن أَتاها هارِباً قَبلَ هَذِهِ","وَمِن غانِمٍ فَأَينَ مِنكِ الوَلاوِلُ",62,"ل",1,0],["وكائِنْ لها فوقَ الصّعيدِ مناسمٌ","يَطأنَ وفي سِرِّ الضّميرِ مَبارك",63,"ك",1,0],["وكائِنْ تَراهُ في الكريهةِ جاعِلاً","عزيمتَهُ بَرْقاً وصولتَه خَطْفا",64,"ف",2,0],["وكائِنْ تراه في المقامةِ جاعلاً","مَشاهدَه فَصْلاً وخطبتَه حَرْفا",64,"ف",2,0],["وكائِنْ تبيتُ له عَزْمَةٌ","مُضرَّجَةٌ بدِماءِ العِدى",65,"ا",1,0],["وكائنْ قد وَرَدْتَ بها غَدِيراً","ولِلْمُهُجاتِ بالرّيّ ارْتِهَانُ",66,"ن",1,0],["وكائن لنا من عادة ساء أَمرها","وَلما يقبحْها إلى الشعب نابس",67,"س",1,0],["وكائِنْ ترى الحرَّ الأبية نفسهُ","يضيع له حقٌ، وآخرُ يهْضَم",68,"م",1,0],["وَكَائِنْ أَتَاهَا هَارِباً قَبْلَ هَذِهِ","وَمِنْ غَانِمٍ أَوْ أَيْنَ مِنْكَ الْوَلاَوِلُ",69,"ل",1,0],["وكاْئِنْ لهُ في ساحَتي منْ صَنِيعَةٍ،","قَطَعْتُ لَهَا عُقْلَ القَوَافي الشّوَارِدِ",70,"د",1,0],["وكائنْ أبَى من خُطّةِ الضّيْمِ وَاشتَرى","مَكَارِمَ أيّامٍ شَدِيدٍ قِتَالُها",71,"ل",3,0],["وكائِنْ تبيتُ له عَزْمَة ٌ","مضرّضجة ٌ بدماءِ العدى",72,"ا",1,0],["وكَائن عَلَّلَت بِالدُّهنِ رَأسِى","مُنَعَمَّةٌ مُخَضَبةُ البنَامِ",73,"م",1,0],["وَكائِن تَرى مِن ذِى هوىً حِيلَ دُونَهُ","وَمُتبِعِ إِلفٍ نَظرَةً لاَ يُعيدُهَا",74,"د",3,0],["وكائنْ طَلَبْنا العيشَ صفواً جِمامُهُ","فلمْ تخلُ منْ رَنْقِ الخطوبِ المشارب",75,"ب",1,0],["وَكائِن رَأَينا مِن فُروعٍ طَويلَةٍ","تَموتُ إِذا لَم يُحَيهِنَّ أُصولُ",76,"ل",1,0],["وَكَايِنْتَرَاهُ يَفُكُّ الْمُعَمَّى","وَيُوضِحُ مَا كَانَ صَعْباً عَسِيرَا",77,"ر",2,0],["وكَائِن مِنْ يَدٍ بَيْضَاءَ فِيما","أُؤَمِّلُ مِن سَلامٍ واسْتِلامِ",78,"م",1,0],["وَكائِنْ مَنَحْتَ الرّاحَ مِنْ خُلْقِكَ الصَّفا","وَأَكْسَبْتَها مِنْ نَشْرِكَ الطَّيِّبِ النَّشْرا",79,"ر",2,0],["وَكَائِنْ بِالْعَواصِمِ مِنْ مُعَنّىً","بِشِعْرِي لا يَرِيعُ إِلى ذُهُولِ",80,"ل",1,0],["وَكائن رأَيْنا من جُسُومٍ طَويلةٍ","تَموتُ إِذَا لَمْ تُحْيِهِنَّ أُصُولُ",81,"ل",1,0],["وَكائِن هَزَمنا مِن كَتيبَةِ قائِدٍ","وَقَد عَجَمَتنا في الحُروبِ العَجائِبُ",82,"ب",1,0],["وَكَأَيِّن مِن مُروآتٍ لَهُ","عَمَّتِ العالَمَ بَحراً ثُمَّ بَر",83,"ر",1,0],["وَكائِن تَرى مِن كامِلِ العقلِ يُزدَري","وَمِن ناقِصِ المَعقولِ وَهوَ جَهيرُ",84,"ر",1,0],["وَكائِن كَرَرنا مِن جَوادٍ وَراءَكُم","وَكائِن خَضَبنا مِن سِنانٍ ومُنصَلِ",85,"ل",1,0],["وَكائِن كَرَرنا مِن سَوامٍ عَلَيكُمُ","وَمِن كاعِبٍ وَمِن أَسيرٍ مُكَبَّلِ",85,"ل",1,0],["وكائن كان قَبلك من نعيمٍ","ومُلكٍ ثابتٍ في الناس راسي",86,"ي",1,0],["وَكائِن مِن فَتى سَوءٍ تَرَيهِ","يُعَلِّكَ هَجمَةً حُمراً وَجُونا",87,"ن",2,1],["وَكائِن قَد رَأَينا مِن بَخيل","يُعَلِّكُ هَجمَةً سوداً وَجُونا",88,"ن",2,0],["وكائِنْ بجُمْرانَ مِنْ مُزْعَف","ومِنْ رَجُلٍ وَجْهُهُ قد عُفِرْ",89,"ر",1,0],["وكائن كسرنا من هتوف مرنةٍ","على القوم كانت فيلكون المعابل",90,"ل",1,0],["وكايلَتِ المواضِيَ بالمَوَاضِي","مكايَلَةَ الرِّضا صاعاً بِصاعِ",91,"ع",1,0],["وكائِنْ لَهَا فِي كلِّ مُلكٍ من العدى","وإِنْ جَلَّ من فَتْقٍ يجلُّ عن الرَّقْعِ",92,"ع",1,0],["وكائِنْ لَهُ فِي الأَوْسِ من حَقِّ أُسْوَةٍ","بنَصْرِ الهُدى جَهْراً وبَذْلِ النَّدى خَفْيا",93,"ي",2,0],["وكايلَني بغير يدَيْ زماني","فلم أعرف له صاعا سويَّا",94,"ي",2,0],["وكائن ببغدادَ من آملٍ","ومن زاجرٍ فيك فالاً ففالا",95,"ل",2,0],["وكائنْ لديهم من قراعٍ لنكبةٍ","وللمجد فيهم من أخٍ وقريعِ",96,"ع",1,0],["وكائنْ لنا من موقفٍ متشهِّرٍ","لديك يطيبُ القولُ فيه ويعذُبُ",97,"ب",1,0],["وكائنْ سقى جيشاً كؤوس حمامهِ","دهاقاً وأطرافَ العوالي مجاديح",98,"ح",1,0],["وكائن به من صارخ متضوّر","وذي حاجةٍ يقضي به ويهان",99,"ن",1,0],["وَكائِن أَزَرنا المَوتَ مِن ذي تَحِيَّةٍ","إِذا ما اِزدَرانا أَو أَسَفَّ لِمَأثَمِ",100,"م",1,0],["وكائن ترى من صامت لك معجب","زيادته أو نقصه في التكلم",101,"م",1,0],["وَكائِن تَرى مِن وافِرِ العِرضِ صامِتاً","وَآخَرَ أَردى نَفسَهُ أَن تَكَلَّما",102,"م",2,0],["وكأيِّنْ من وُلوع لم يفد","وكأين من دموع وكأي",103,"ي",1,0],["وَكائِن حُزتَ مِن مَرعى مَرِيئٍ","فَأَيَّةُ حاجَةٍ لَكَ بِالوَخيمِ",104,"م",1,0],["وَكَايّدَني وَلَمْ يُرَقَطُّ أَحْلَى","مِنَ المَعْشُوْقِ لُطْفاً فِي كِيَادِهْ",105,"د",2,0],["وكائن ترى فينا من ابن سبيئة","إِذا لقي الابطالَ يطعنهم شزرا",106,"ر",2,0]]}