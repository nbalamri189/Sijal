poem/77086","الخفيف"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21540","السريع"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81284","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72956","الرمل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52140","الرمل"],[4755,"برقيّةٌ عاجلة إلى الشَّهيد / إبراهيم الحَمدي","https://www.poetsgate.com/ViewPoem.aspx?id=184515",""],[501,"مُرَّ بِي يا وَاعِداً وعداً","https://www.poetsgate.com/ViewPoem.aspx?id=205275",""],[4791,"طلعة البدر","https://www.poetsgate.com/ViewPoem.aspx?id=36953",""],[5277,"المفردان","https://www.poetsgate.com/ViewPoem.aspx?id=198445",""],[5431,"العبودية الجديدة!(1)","https://www.poetsgate.com/ViewPoem.aspx?id=207437",""],[5458,"الاخلاق قبل العلم","https://www.poetsgate.com/ViewPoem.aspx?id=72160",""],[5692,"ياقانصين الصيد","https://www.poetsgate.com/ViewPoem.aspx?id=179109",""],[5776,"لحيةُ الصّبح","https://www.poetsgate.com/ViewPoem.aspx?id=199324",""],[5906,"مَرَّ بي","https://www.poetsgate.com/ViewPoem.aspx?id=188228",""],[6097,"المرأة والحكيم","https://www.poetsgate.com/ViewPoem.aspx?id=190696",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""],[572,"مَرَّ بِنَا فِي كَفِّه بَاشِقٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9177&r=&rc=34",""]],"verses":[["مُرِبّاً إِذا مَخَضَتهُ الجَنوبُ","أَبَسَّت بِهِ شَمأَلٌ لاغِبُ",0,"ب",1,0],["مُر بِأَلفٍ لَهُم وَإِن شِئتَ زِدها","وَأَجِرهُم كَما أَجَرتَ النَصارى",1,"ر",2,0],["مربَّع سور قد أحاط بمثله","محيط بأعلى منه شِيدَ بقرمد",2,"د",1,0],["مرَبَّيَاتِ الحجورِ في ترفٍ","ظباءِ فيح القُصور لا الكُنُس",3,"س",1,0],["مُرَبَّعَةٌ مقسومة بشباكها","كتمثال بيت الوشي حيك مربَّعا",4,"ع",2,0],["مُرَبَّعُ أَعلى حاجِبُ العَينِ أُمُّهُ","شَقيقَهُ عَبدٍ مِن قَطينٍ مُوَلَّدِ",5,"د",1,0],["مرّبهم والأرض في جنة","ربيعها يختال من عجبه",6,"ب",2,0],["مَرَّ بَعدَ السَوادِ ما كانَ يَحلو","مُجتَناهُ مِن عَيشِنا وَيَطيبُ",7,"ب",1,0],["مَرَّ بي خالِياً فَأَطمَعَ في الوَص","لِ وَعَرَّضتُ بِالسَلامِ فَردا",8,"د",2,0],["مرَّ بي عطرُهَا فأسكرَ نفسي","وسرى في جوانحي كيفَ شاءَ",9,"ا",2,0],["مرَّ بهذا الكون في لحظة","طالت كعمر الأبد الأعظم",10,"م",1,0],["مرَّ بنا مقرطَقٌ","ووجهُهُ يحكي القمرْ",11,"ر",1,1],["مربعٌ يخلو ودمعٌ يكفُ","وجوى يحلو وقلبٌ يرجِفُ",12,"ف",1,1],["مربعٌ منْ أنسِ سلمى أوحشا","تَرَكَ الداءَ دفيناً في الحشا",13,"ش",2,1],["مَرَّ بي في نَفَرٍ يُحفِفنَهُ","مِثلَما حَفَّ النَصارى بِالوَثَن",14,"ن",1,0],["مَرَّ بي سِربُ ظِباءِ","رائِحاتٍ مِن قُباءِ",15,"ا",2,1],["مَرَّ بِنا وَهوَ بَدرُ تَمٍّ","يَسحَبُ مِن ذَيلِهِ سَحابا",16,"ب",2,1],["مَرَّ بِنا وَالعُيونُ تَأخُذُهُ","تَجرَحُ مِنهُ مَواضِعَ القُبَلِ",17,"ل",1,1],["مرَّ بنهرٍ دافقٍ سلسبيلْ","تهفو القمارى حوله شاديَهْ",18,"ه",1,0],["مرَّ بي طيفُكما ذاتَ مساء","وأنا ما بينَ أحلامي وكأسي",19,"ي",1,0],["مرَّ بي مثلُكِ لم يُشْعِرنني","غيرَ إشفاقِ الحفيِّ الناصرِ",20,"ر",1,0],["مَرَّ بي في فَلَك من ربرَب","قَمَرٌ مُبْتَسمٌ عن شَنَبِ",21,"ب",1,1],["مَرَّ بِهَا الهَمُّ وَهْوَ عَادٍ","يَنْتَهِبُ الْبَرَّ وَالبِحَارْ",22,"ر",1,0],["مر بِالصَلاةِ وَلا تُضِعها وَاِصطَبِر","تَكفيكَ سورَةُ مَريَم أَو طهَ",23,"ه",1,0],["مَرَّ بالشَّمْسِ فَلمْ تَشْعُر بِهِ","إذْ جَرَى إلاّ ظنُوناً واشْتِباها",24,"ا",3,0],["مر بآلام النوى عيشه","وريقك العطري حلو المذاق",25,"ق",1,0],["مربع بارع ربيع رباه","من دموع سقى بماء الحياة",26,"ه",1,0],["مَرَّ بِنا في قُرْطَقٍ أَخْضَرِ","مُزَرْفَنَ الأَصْداغِ بِالعَنْبَرِ",27,"ر",1,1],["مرْ بما شئتَ فغيرَ ال","حبِّ عندي غيرَ صعبِ",28,"ب",1,0],["مرَّ بها فلم تكنْ","إلا كلمحِ البصرِ",29,"ر",1,0],["مر بي بما شئت وارع قربي","إن هواك الذي بقلبي",30,"ي",1,0],["مُر بِالذي صَرَّحتَ قبلُ بهِ وَقُل","وَاِصدُق فَمِثلُكَ من يقولُ وَيَصدُقُ",31,"ق",1,0],["مربى الصراط إِلى حوض ابن آمنة","لاستقى منه ريا فهو سلسال",32,"ل",1,0],["مَرَّ بِرَيحانِها تَنَفُّسُهُ","بَينَ البَساتينِ وَهوَ مَطلولُ",33,"ل",1,0],["مرَّ بنا لكنَّه لم يَعُج","ما ضَرَّه إذ مَرَّ لو كانَ عاج",34,"ج",1,0],["مربع الأحباب من قدم","ومحط السادة الأول",35,"ل",1,0],["مَرَّ بي بِالآبِ وَالإِبنِ","وَروحِ القُدسِ يَشدو",36,"د",2,1],["مربع كانَ لي كَجَنّة عَدنٍ","وَأَنا مِنهُ بَينَ حورٍ وَعينِ",37,"ن",1,0],["مَرباه بانات نجد","وَسوح ذاكَ المُختَم",38,"م",1,0],["مر بي نافراً من الصيدِ إلا","أنَّه في نفورِه يَتصيَّد",39,"د",1,0],["مُرْ بما شِئتَهُ فقلْتُ مجيباً","رُدَّ قَلبي ثمَّ ارتحِلْ كيفَ شيتا",40,"ت",2,0],["مَربَعٌ بان أَهله ثُمَّ أَضحى","مقفراً موحشاً وَكانَ أَنيسا",41,"س",2,0],["مرْبَعٌ للَّهْو منْذُ انتظما","أطْرَبَ الأَنْفُسَ في رَوْح وراحْ",42,"ح",1,0],["مرّ بنا كالظّبي لكنّهُ","يذعَرُنا والظّبيُ مذعورُ",43,"ر",1,1],["مر بيُمناهُ على طارِهِ","يلمَسُهُ أحسنَ ما لمْسِ",44,"س",1,1],["مرَّ بنا ظَبيٌ هضيم الحشا","يَرقُّ في خديهِ ماءٌ الصِبا",45,"ا",1,1],["مرَّ بنا ظبيٌّ حريريّ","عَذْب اللَمى في عِطْفِه لَيُّ",46,"ي",1,1],["مَرَّ بِنا في مُوَرِّدٍ شَرِقِ","كَأَنَّهُ البَدرُ لاحَ في الشَفَقِ",47,"ق",1,1],["مَرَّ بِنا يَبسِمُ عَن جَوهَرِ","مُفَصَّلُ الأَبيَضِ بِالأَحمَرِ",48,"ر",1,1],["مَرَّ بِنا في قَباءِ ديباجِ","ذو طُرَّةٍ جُنحُ لَيلِها داجِ",49,"ج",1,1],["مربعُ الوجدِ فيه أرسلتُ دمعي","بعدَ بُعدِ الأحبابِ وبلاً وطِلاّ",50,"ل",2,0],["مربي البرايا جل أمر إلهنا","لقد أعجز الإرسال عن درك الشكر",51,"ر",1,0],["مرَّ بالكاسر طافحاً يا ساقي","وانعطف ثانياً على العشاقِ",52,"ق",1,1],["مرَّ باللَّغْوِ وقَوْمي","بالهَوَى مرُّوا كِرَامَا",53,"م",2,0],["مُر بما شئتَ يَمتَثِل لكَ أمراً","ليس يَعصِي لكَ الزَّمانُ كَلاما",54,"م",2,0],["مُرَبَّعُ الجِسْمِ صَفِيُّ الحَشَا","لاَ يَشْبَعُ الدَّهْرَ وَلا يرْوَى",55,"و",2,0],["مرَّ بِنا في كفّه باشِقٌ","فِيه وفي الباشِقِ شئٌ عَجيبْ",56,"ب",1,1],["مُرَّ بي بين ثَنايا","كَ فقد صرتُ خِلاَلا",57,"ل",2,0],["مَربعٌ سامٍ وفخرٌ ثابتٌ","مَرتَعٌ نامٍ ومَجدٌ سَرمَدُ",58,"د",1,0],["مرّ بي خاطراً يكادُ من العُج","بِ به أن يُراعَ في ريعانه",59,"ن",2,0],["مرّ بالمدن والقرى ركبك الفخ","م فهل آن موعد الغربيه",60,"ي",2,0],["مرَّ بالنيل قبل عهدك دهر","كان فيه لا يرتوي الورَّاد",61,"د",1,0],["مَرَّ بِهِ شَخص فَقالَ ماذا","يَا أَيُّها الأَعمى اِرمِ عَنكَ هَذا",62,"ذ",2,0],["مَرَّ بِهِ الصَياد وَهوَ في الكَرى","وَشكّه بِسَيفه وَمُذ دَرى",63,"ر",2,0],["مَرَّ بِهِ مُعَلِّم الأَطفال","وَهوَ يُناديهِ بِصَوتٍ عال",64,"ل",1,0],["مُربكةٌ هيَ الدموعُ ما لها","تسيلُ مِن عينيْ ومِن ضلوعي",65,"ع",2,1],["مربع طال ما قد صحبتُ به ال","عيشَ في غفلاتِ الصِّبا خضلا",66,"ل",2,0],["مَرَّ بِنا يَستَميلُهُ السُكرُ","وَكَيفَ يَصحو وَريقُهُ خَمرُ",67,"ر",1,1],["مَرَّ بِرَوضٍ زاهِرٍ","ذَرَّ عَلَيهِ عُشبُهُ",68,"ب",2,0],["مَرَّ بِنا يَهتَزُّ في خَطوِهِ","ما بَينَ أَغصانٍ وَأَقمارِ",69,"ر",1,1],["مَرَّ بِهِ ضَبْعَا جَوَادٍ مِهْمَرِ","يَنْفُضُ ماءَ العَرَقِ المُسْتَقْطَرِ",70,"ر",1,0],["مربضٌ للأسد كم ينشى بها","من صناديدٍ وأبطالٍ شدادْ",71,"د",1,0],["مربّبة في خدر عزّ كأنّه","ببيشة لللّيث الهصور عريسُ",72,"س",1,0],["مربيتي طفلاً على شط نيلها","ومرضعتي در العلوم الزكية",73,"ه",1,0],["مَرَّ بي ساخطاً بمنْعِ كلامٍ","ومَنُوعُ الكلامِ مُحْيي الكُلُومِ",74,"م",1,0],["مرَّ بنا في ثوبهِ الأزرق","كبدرِ تِمٍ لاح في المَشْرِقِ",75,"ق",1,1],["مربع للهوى ومرتبع الحبب","قديما، ومجمع الأحباب",76,"ب",1,0],["مرّ بي يهتز في هَيَفٍ","تائهاً بالغُنْجِ في نظره",77,"ر",2,0],["مرَّ بي مُذْكراً لياليَ أنس","وزماناً بالخيف عزَّ ارتجاعه",78,"ع",2,0],["مربعُ الشكلِ والأملاكُ تحرسه","من كل ذي حسدٍ والكلُّ ذو حسد",79,"د",1,0],["مَرَّ بِبابِ الدارِ مُستَهزِئاً","مُستَخفِياً مُعتَجِراً مُعرِضا",80,"ض",2,0],["مربع قد اخضلت أفنانه","وزهت إذ روضت كثبانه",81,"ه",1,0],["مربع للقلوب فيه ربيع","متوالٍ إذا الربيع تولى",82,"ل",2,0],["مربعٌ غُصن شبابي قد وهى","فيه ما بينَ غزالٍ ومها",83,"ه",2,0],["مَرَّ بِهِ الموسى فَما أَخطَأت","شفرته ما جلَّ مِنهُ وَدَق",84,"ق",1,0],["مَرَّ بي غُصنٌ عَلَيهِ قَمَرٌ","مُتَجَلٍّ نورُهُ لا يَنجَلي",85,"ل",2,1],["مُرَبَّعُنَا ثُمَّ الحِمَارانِ بَعدَهُ","ضَرايبُهُم كالسلِّبارِ مَعَ النَّسرِ",86,"ر",1,0],["مُرَّبَعَاتِ دَورةِ السَّمَاءِ","وَصُورة المرأه بِلاَ مِرَاءِ",87,"ا",2,0],["مرَّ بي وَهناً فأذكى لاعِجاً","في فُؤادي حرُّهُ قد أُضرِما",88,"م",2,0],["مُرِبّاً بِهِنَّ لَهُ أَمرُهُ","وَهُنَّ لَهُ حاذِراتٌ قَوالي",89,"ل",2,0],["مَرَّ بِنا مُلتفتاً مُسرِعاً","كَالرِّئم في خِيفَةِ روّاغِهِ",90,"غ",2,1],["مربع بين اللوى والاجرع","وليالٍ نلت فيهنَّ المنى",91,"ن",2,0],["مرّبي العالمين لأنت باق","وكم خنقتْ اكفك من ربيب",92,"ب",1,0],["مربع كان للظباء الجوازي","ملعباً يقتنصن فيه الأسودا",93,"د",2,0],["مربَّقةَ الأعناق في مجلسٍ به","يلاحظها حسري القِناع يزيد",94,"د",1,0],["مَربوطَةً بالجاذبيَّة مثلهُ","كَتَرابُط الأَجزآءِ بالأَجزآءِ",95,"ا",2,0],["مُرّ بنا على طريقِ كربلا","مصرعُ سادات بني عمرو العُلا",96,"ل",2,0],["مِر بي عَلَى مايل طلّعهم","عليّه بنثر دَمْعي اسجام",97,"م",1,0],["مُرَبّي نُفوسِ العارِفين وَمُرشِدٌ","لخيرِ طَريقٍ يوصِلُ العبدَ لِلرَّبِّ",98,"ب",1,0],["مربعه لقد سما","فيا له من مربع",99,"ع",1,0],["مُرَّ بِالأَجداث تنظر مَطِيّاً","جُبَّ مِنها غارِبٌ أَو سَنامْ",100,"م",1,0],["مر بي فَرَأيك مثلَ حبك حاكمٌ","وَاحكم فأَمرك مثلَ لحظك ينفذ",101,"ذ",1,0],["مربع ما حكت حصاه الدراري","يقصر التبر أن يكون ترابه",102,"ب",2,0],["مَربَعٌ فاضَت غَمائِمُهُ","وَاِنبَرَت فيهِ نائِمُه",103,"ه",1,0],["مَربَعُ الإيناسَ وَالنَحفِ","وَذَواتُ الدَلِّ وَالهَيفِ",103,"ف",1,0],["مَرَّ بِنا يَخْطُرُ فِي مَشْيَتِهِ","وَالقَلْبُ مِن خَطْرَتِهِ عَلى خَطَرْ",104,"ر",1,0],["مَرَّ بي أَضحى وَأَضحى","أَخلَفاني فيهِ ظَنّي",105,"ن",2,0],["مُرَبَّعُ الرَأسِ بِعُرفٍ أَملَسِ","مِن شَعرِ خَيلٍ هاجَ فَوقَ القَونَسِ",106,"س",1,0],["مُر بِنا في عامِر النَخيلِ","راقَت وَلَو بِظِلِّها الظَليل",107,"ل",1,0],["مَرَّ بي في لداتِه يَتكفا","مائِس القَد عَن مَعاطِفَ بانَه",108,"ن",2,0],["مَرَّ بِبابِ الدارِ فاجتازَها","يا لَيتَهُ لَو دَخَلَ الدَارا",109,"ر",2,0],["مَرّ بِي عابِراً فَأَورَدته نَفس","اً أَصابَت مِن سحر عَينيك مشرع",110,"ع",1,0],["مربضُ الأشبالِ أضحى بيتُهُم","ومجالُ الخيلِ في يوم الطراد",111,"د",1,0],["مرّ بالدهر أبونا أمرداً","وتمشي فيه شيخاً أشيبا",112,"ب",2,0],["مَربُوطَةٌ كالطُّعْمِ أعيُنُهُم","وأَكُفُّهُم في الوَهْمِ تَصطَادُ",113,"د",1,0],["مُرَّ بِي يا وَاعِداً وعداً","مثلما النسمَةُ من بَرَدَى",114,"د",2,1],["مربحي من هواك ومربحي من غلاك","سهم سودٍ تمكّنْ واستقر بحشاي",115,"ا",2,1],["مرْ بي لعلكَ تجلو وحشةَ البيتِ","يا آخرَ الضوءِ في مصباحهِ زيتي",116,"ي",1,1],["مربربةٌ تعجّ على دلاصِ","تلامسه وتغرقُ بالمعاصي!",117,"ص",2,1],["مُربٍّ دون أخلاق يربي","كذئبٍ كيف يأمنه القطيع",118,"ع