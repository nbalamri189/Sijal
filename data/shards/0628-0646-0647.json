{"poems":[[88,"إني دعيت إلى احتفالك فجأة","https://www.aldiwan.net/poem68936.html","الكامل"],[63,"ناديك من مطر الإحسان ممطور","https://www.aldiwan.net/poem51687.html","البسيط"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62240","المتقارب"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62233","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39585","المتقارب"],[215,"رأيت ومن يعش ما عشت يشهد","https://www.aldiwan.net/poem46759.html","الوافر"],[358,"بنهاية الأرب اغتنم لك مأربا","https://www.aldiwan.net/poem40571.html","الكامل"],[438,"يروع الذئب حيث سواك راع","https://www.aldiwan.net/poem12377.html","الوافر"],[505,"رفعت بسري كل أمري لسيدي","https://www.aldiwan.net/poem38020.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87217","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93542","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83241","الكامل"],[3098,"","https://poetry.dctabudhabi.ae/diwan/poem/131896","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132605","المتقارب"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99380","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91366","المتدارك"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117973","الطويل"],[3737,"","https://poetry.dctabudhabi.ae/diwan/poem/138917",""],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138723","البسيط"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62063","الوافر"],[4927,"بنهر الحب","https://www.poetsgate.com/ViewPoem.aspx?id=29827",""],[5273,"عشق أزلي","https://www.poetsgate.com/ViewPoem.aspx?id=179463",""],[5574,"على أرض الخلود - ذكرى ترفرف","https://www.poetsgate.com/ViewPoem.aspx?id=205995",""],[5680,"قريب على بعد أنا منك","https://www.poetsgate.com/ViewPoem.aspx?id=204357",""],[5956,"أحبك يا صديق الناس","https://www.poetsgate.com/ViewPoem.aspx?id=192520",""],[6042,"بنهر معلي والْحَدِيث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=189798",""],[3116,"بنهج الصواب عقود الدرلر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=612458",""]],"verses":[["بِنها لَقَد وُفّيتِ قِسطَكِ مِن مُنىً","وَسَعادَةٍ وَرِعايَةِ وَنِظامِ",0,"م",1,0],["بنهضةٍ خَرَّ فُسطاطُ الكَفورِ لها","خوفاً وأذعنَ بالفُسطاطِ كافورُ",1,"ر",1,0],["بِنَهْدِ المَرِاكِلِ ذِي مَيْعَةٍ","أَزَلِّ العِثَارِ مِعَنٍّ مِفَنْ",2,"ن",1,0],["بِنَهْدِ المَرَاكِلِ ذِي مَيْعَةٍ","إِذَا احْتَفَلَ الشَّدُّ زَادَ احْتِفَالاَ",3,"ل",2,0],["بِنَهدينِ يستقبلانِ السماءَ","كأنهما يُرضعان القمَرْ",4,"ر",1,0],["بنهر النيل تدهمنا الخطوب","وتشتجر الخفايا والغيوب",5,"ب",1,0],["بِنِهاية الأَرَب اِغتنم لَكَ مَأربا","فَهوَ الرَبيع زَها بِأَزهار الرُبى",6,"ب",2,1],["بِنهضتِكَ ارتجعتَ لها بلالاً","أَباكَ وليس يَوْمَ الإِرْتِجاعِ",7,"ع",1,0],["بِنَهضَتهِ ليلاً بِمعْراجِ عَزْمِهِ","بِدَوْلَتهِ إن ماسَ في حَضرةِ الأمْرِ",8,"ر",1,0],["بِنهير يَجري فَيَروي رُباها","وَالتَوابيت حازَها شاطِئاه",9,"ا",2,0],["بِنهرين قَد أَصغى لَهُم ماء واحد","وَآخر قَد صَفوا حَدايقه الغَلبا",10,"ب",2,0],["بِنها تَتيهُ بِكُم مُديراً عادِلاً","حزمَ الأمور بهمةٍ لا تفترُ",11,"ر",1,0],["بنهر الفرات العذب والنخل باسق","تزال به الأوساخ من كل غاسل",12,"ل",1,0],["بنهج الصواب عقود الدرر","فيا درر النهج أنت الغرر",13,"ر",1,1],["بنهر للرياح عليه درع","تذهب بالغروب وبالشروق",14,"ق",1,0],["بِنهارِ جَبينٍ يَتجلَّى","في لَيلِ شعورٍ إِذ يَغشى",15,"ش",2,1],["بنهد حكى الرمان فوق ترائب","وخصر نحيل قيد شبر حزامه",16,"م",2,0],["بنهار الحسن يهدى","وبليل الجعد سلاها",17,"ا",3,0],["بنهلة من غدير الخمر والعسل","سقيا لأيامنا بالجزع دانية",18,"ه",1,0],["بنهر كالسجنجل كوثري","تعبس وجهها فيه السماء",19,"ا",2,0],["بِنَهْرِ الْحُبِّ يَاْ لَيْلَىْ","وَجَدْنَاْ الدُّرَّº وَالْجَوْهَرْ",20,"ر",1,1],["بِنَهجِ مالِكِ مُلكِ الكونِ جئتَ وقد","قَوَّمتَ نهجَ ملوكِ العُرْبِ والعَجَمِ",21,"م",1,0],["١٦- بنهضتهِ حضارتُنا تجلّتْ","كنخْلٍ جاء يمنحُنا صِرامهْ",22,"م",2,0],["بنهج قويم لا التطرف شأنه","ولا اللين للتهديد والضغط والإغرا",23,"ر",2,0],["بنهجك يا بنيَّ فراسَ نقوى","فدمْ بطلاً على الأحداثِ جَلدا",24,"د",2,0],["بنهر معلي والْحَدِيث شجون","غزال رماني والسهام عُيُون",25,"ن",1,1],["بنهج الصواب عقود الدرلر","فيا درر النهج أنت الغرر",26,"ر",1,1]]}