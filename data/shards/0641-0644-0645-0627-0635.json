{"poems":[[74,"قدمت كالسيف إلى غمده","https://www.aldiwan.net/poem18559.html","السريع"],[40,"ضعيف العصا بادي العروق ترى له","https://www.aldiwan.net/poem7728.html","الطويل"],[45,"ملومكما يجل عن الملام","https://www.aldiwan.net/poem10571.html","الوافر"],[54,"سقاني من معتقة الدنان","https://www.aldiwan.net/poem26607.html","الوافر"],[50,"أسير الهم نائي الصبر عان","https://www.aldiwan.net/poem65309.html","الوافر"],[52,"ألا طرقت موهنا مهدد","https://www.aldiwan.net/poem63884.html","الوافر"],[48,"أيا طفل الشفيقة إن ربي","https://www.aldiwan.net/poem22155.html","الوافر"],[52,"ألا طرقت موهناً مهدد","https://www.poetsgate.com/ViewPoem.aspx?id=21823",""],[190,"غلام كان يعشق وهو علق","https://www.aldiwan.net/poem43596.html","الوافر"],[190,"أقول لمنكر فقري قنوعا","https://www.aldiwan.net/poem43650.html","الوافر"],[190,"أخذت من الدبس الرجاني أبيضا","https://www.aldiwan.net/poem43742.html","الطويل"],[324,"قطعنا أباليس البلاد بخيلنا","https://www.aldiwan.net/poem23893.html","الطويل"],[500,"خلقت كما ترى صعب الثقاف","https://www.aldiwan.net/poem10241.html","الوافر"],[548,"أقيدوا القوم إن الظلم لايرضاه ديان","https://www.aldiwan.net/poem1761.html","الهزج"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109055","الوافر"],[2117,"","https://poetry.dctabudhabi.ae/diwan/poem/111325","الوافر"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129850","البسيط"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130374","الوافر"],[548,"","https://poetry.dctabudhabi.ae/diwan/poem/20375","الوافر"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85042","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111502","البسيط"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105175","الوافر"],[5457,"جريح في الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=213313",""],[5616,"حبيبتي أنت","https://www.poetsgate.com/ViewPoem.aspx?id=203493",""]],"verses":[["فلم أصفْ من طاحَ من أجلها","وأجله قلبيَ في وجده",0,"د",2,0],["فَلَمّا صَراهُنَّ التُرابُ لَقيتُهُ","عَلى البيدِ أَذرى عَبرَةً وَتَقَنَّعا",1,"ع",2,0],["فَلَمّا صارَ وُدُّ الناسِ خِبّاً","جَزَيتُ عَلى اِبتِسامٍ بِاِبتِسامِ",2,"م",1,0],["فَلَمّا صَبَّ فيها الماءَ ثارَت","كَما ثارَ الشُجاعُ إِلى الجَبانِ",3,"ن",1,0],["فَلَمّا صَبَّها في صَحنِ كَأسٍ","حَكَت لِلعَينِ لَونَ البَهرَمانِ",4,"ن",1,0],["فَلَمّا صَحَوتُ وَلَم أَلقَها","صَحَوتُ وَقَلبي بِها مُقصَدُ",5,"د",1,0],["فَلَمّا صيحَ بي وَدَنا فِطامي","تَيَمَّمَني الحِمامُ فَما وُقيتُ",6,"ت",1,0],["فلما صحوت ولم ألقها","صحَوْتُ وقلْبِي مُقْتَصد",7,"د",1,0],["فلما صار في خدّيه ليف","وتحت ثيابه شبكات ليف",8,"ف",1,0],["فلمّا صارت الدنيا عجوزا","لها شمطٌ وليس لها قناع",9,"ع",1,0],["فلما صفا واشتدّ رمت ارتشافه","لأسلا به عن غمّ عاقبة الصدر",10,"ر",1,0],["فَلَمّا صَبَحنا بِالمُصَيَّخِ أَهلَهُ","وَطارَ إِباري كَالطُيورِ النَوافِرِ",11,"ر",1,0],["فلم أصحب عدوّاً في صديق","ولم أشرب ذعافاً في سلاف",12,"ف",1,0],["فلمّا صرَّحَ الشَّرُّ","بدا والشَّرُّ وعُريانُ",13,"ن",1,0],["فلما صارَ هذا اليوم شهرا","واصبح فيه حلوُ العيش مرَّا",14,"ر",2,0],["فلما صالت الأعداء دوني","واصبح بيتنا بحر ودرب",15,"ب",1,0],["فلم أصدق بها سروراً","وظلت نشوان دون راح",16,"ح",1,0],["فلم أصحب فتىً لصلاح دين","فألقاه يروم صلاح دينه‏",17,"ن",2,0],["فَلَمّا صَرَّحَ الشَرُّ","بَدا وَالشَرُّ عُريانُ",18,"ن",1,0],["فَلَمّا صاحَ طَيرُ البَينِ فينا","طَواهُ اللَهُ مِن نَشرِ الوُجودِ",19,"د",1,0],["فلم أصد زؤام الموت عنه ولم","أرد عن فتيةٍ هكطور فلهم",20,"م",1,0],["فلما صد لي باللحظ تيها","رمى في مهجتي لهب السعير",21,"ر",1,0],["فلما صرتُ عن وطني غريبًا","بكيتُ لبعدِهِ مثلَ الثكالى",22,"ل",2,0],["فلم أصدق بأن الموت غيّبها","وأنني لم أعد ألقى الحبيب غدا",23,"د",2,0]]}