69516.html","الرمل"],[573,"إنك المخلوق في كبدي","https://www.aldiwan.net/poem2816.html","المديد"],[573,"وجنة فوقها عذار أطلا","https://www.aldiwan.net/poem3027.html","الخفيف"],[573,"عاد قلب الشوق إذ عدت عيده","https://www.aldiwan.net/poem3077.html","الخفيف"]],"verses":[["كُلُّ شَيءٍ مِنَ الزَمانِ طَريفُ","وَاللَيالي مَغانِمٌ وَحُتوفُ",0,"ف",1,1],["كُلُّ شَيءٍ إِلّا التَحِيَّةَ يُرجى","فَهيَ لِلَّهِ وَالدُنا لِلزَوالِ",1,"ل",1,0],["كُلُّ شَأْنٍ لِلدَّهْرِ جَازَ بِهِ","زَادَهُ فِي عَلائِهِ شَانَا",2,"ن",2,0],["كُلُّ شَيْءٍ تَهْوَاهُ أَهْوَاهُ إِلاَّ","أَنْ أَرَى لِي شَرِيكَةً فِي غَرَامِي",3,"ي",1,0],["كلّ شي بالرحم يظهر","وبها هوّت وجود",4,"د",1,0],["كل شيء يعار في الناس إِلا ال","عرض منهم فإنه لا يعار",5,"ر",1,0],["كلّ شيء من عالم الذرّات","كل شيء في كونه كالنبات",6,"ت",1,1],["كل شيء في بدئه من صغير","ثم ينمو في ذاته والصفات",6,"ت",1,0],["كل شيء في أهلها مستعار","من سواه وكل حال تحول",7,"ل",1,0],["كُلَّ شَيءٍ أَحصى كِتاباً وَعِلماً","وَلَدَيهِ تَجَلَّتِ الأَسرارُ",8,"ر",1,0],["كلُّ شعبٍ أنتم به آل شادٍ","فهو شعبي وشعب كل أديب",9,"ب",1,0],["كلّ شهرٍ لنا هلالٌ جديدٌ","مبرز للفناء كلّ مصون",10,"ن",1,1],["كلُّ شيء أراه منك بشيرٌ","صَدَّق الله هذه البُشراءَ",11,"ا",2,0],["كلُّ شيء بالحس يُعرف أو بال","سَمع أو بالأدلَّة الفُصحاءِ",12,"ا",2,0],["كل شيءٍ غُلب الصبْ","رُ إلَيْهِ فمباحُ",13,"ح",1,0],["كلُّ شيءٍ له تَناهٍ وحدٌّ","كل شيءٍ يجري إلى مِقدارِ",14,"ر",1,0],["كل شيءٍ محا حُلاها فزَينٌ","كل شيءٍ وارَى التراب ففرشُ",15,"ش",1,0],["كل شيء أهديه غير بديعٍ","لك عندي إلا اعتذاراً بديعا",16,"ع",2,1],["كل شعر جهدت نفسك فيه","وتكلفت نظمه تفقيع",17,"ع",1,0],["كُلُّ شَيءٍ لِلكُلِّ مِلكٌ حَلالٌ","كُلُّ شَيءٍ فيها كَما الكُلُّ شاءوا",18,"ا",1,0],["كُلُّ شَيءٍ مِنكَ عِندي","غَيرَ إِعراضِكَ سَهلُ",19,"ل",1,0],["كُلُّ شَيءٍ مِنكَ مَقبولُ","وَعَلى العَينَينِ مَحمولُ",20,"ل",1,1],["كُلَّ شَيءٍ رَأَيتُهُ","حَسَناً أَشتَهيهِ لَك",21,"ك",1,0],["كُلُّ شَيءٍ مِن حَبيبي","ما خَلا الغَدرَ اِحتَمَلتُهُ",22,"ت",2,0],["كُلُّ شَيءٍ أَرَدتُهُ فَهُوَ فيهِ","حَسَنُ الذاتِ كامِلُ الأَدَواتِ",23,"ت",1,0],["كلُّ شيءٍ يُعاطِفُ العالَم الحيَّ","ويُذكِي حياته ويُفيدُهْ",24,"ه",1,0],["كلُّ شيءٍ يُسايِرُ الزَّمنَ الماشي","بعزمٍ حتَّى التُّرابُ ودُودُهْ",24,"ه",1,0],["كلُّ شيءٍ إِلاّكَ حَيٌّ عَطوفٌ","يُؤْنِسُ الكونَ شَوْقُهُ ونَشيدُهْ",24,"ه",1,0],["كُلُّ شعبٍ قَدْ طَغَتْ فيهِ الدِّمَا","دونَ أَنْ يَثْأَرَ للحَقِّ الجَلِي",25,"ي",1,0],["كلُّ شيءٍ موقَّعٌ فيكِ حتَّى","لَفْحَةُ الجيدِ واهتزازُ النّهودِ",26,"د",1,0],["كلُّ شَيءٍ وإِنْ أَضَرَّ بجِسمي","لَكَ فيهِ الرِّضَى إليَّ حَبيبُ",27,"ب",1,0],["كُلُّ شَيءٍ مِنَ الدِماءِ حَرامٌ","شُربُهُ ما خَلا دَمَ العُنقودِ",28,"د",1,0],["كُلُّ شِعرٍ نَظيرُ قائِلِهِ في","كَ وَعَقلُ المُجيزِ عَقلُ المُجازِ",29,"ز",1,0],["كل شعرٍ معاصرٍ ليس فيه","غصب العصر نملةٌ عرجاء",30,"ا",2,0],["كُلُّ شَيءٍ فَقَد أَحاطَ بِهِ اللَ","هُ وَأَحصاهُ عِلمُهُ المَخزونُ",31,"ن",1,0],["كُلُّ شَيءٍ فيهِ مَوعِظَةٌ","تَعِظُ الإِنسانَ لَو عَقَلا",32,"ل",2,1],["كُلُّ شَهمٍ أَجرا جَناناً مِنَ الصَق","رِ وَأَبهى حُسناً مِنَ الطاووسِ",33,"س",1,0],["كلُّ شيءٍ مأتمٌ في عينه","لا الكرى طابَ ولا طابَ السهر",34,"ر",1,0],["كل شيء حيّ هنا ونبات القبر","ينمو في غير هذا المكان",35,"ن",1,0],["كل شيء صار مرّاً في فمي","بعد ما أصبحت بالدنيا عليما",36,"م",2,0],["كل شيء من سرور وحَزَن","والليالي من بهيجٍ وشجي",37,"ي",1,0],["كلّ شهمِ القلبِ مرهوبِ الشبا","مُرْتضى الأخلاقِ محمودِ الشيم",38,"م",1,0],["كُلُّ شَيءٍ غَثٌّ إِذا عادَ وَال","مَعروفُ غَثٌّ ما كانَ غَيرَ مُعادِ",39,"د",1,0],["كُلُّ شِعبٍ كُنتُم بِهِ آلَ وَهبٍ","فَهوَ شِعبيِ وَشِعبُ كُلِّ أَديبِ",40,"ب",1,0],["كُلُّ شَيءٍ يَفْنَى وَلَكِنْ هِجَائِي","فِيكَ بَاقٍ مَا عَاقَبَ السَّيْفَ صَقْلُ",41,"ل",1,0],["كلُّ شيءٍ سينقضي غيرَ حبي","لكِ والمدحِ للوزيرِ الكبيرِ",42,"ر",1,0],["كلُّ شيءٍ باطلٌ في حُكمهِ","غير ما يُورِثهُ المجدَ الصُّرَاحا",43,"ح",2,0],["كُلُّ شَيءٍ إِلى اِنقِطاعٍ مَداهُ","وَصُروفُ الأَيّامِ تُبلي الجَديدا",44,"د",2,0],["كُلُّ شُهوري عَلَيَّ واحِدَةٌ","لا صَفَرٌ يُتَّقى وَلا رَجَبُ",45,"ب",1,0],["كل شيء جاء منه","وإليه سيصير",46,"ر",1,0],["كل شيء مَع الجديدين يفنى","ثم يَبقى جلال رَبي تَعالى",47,"ل",2,0],["كل شيء فانه يَتلاشى","بِتَوالي الأزمان إِلّا الأثير",48,"ر",1,0],["كل شعرٍ نظير قابله منك","وعقل المجيز مثل المجاز",49,"ز",1,0],["كُلُّ شِبرٍ فيها عَلَيهِ بِناءٌ","مُشمَخِرٌّ أَو رَوضَةٌ أَو غَديرُ",50,"ر",1,0],["كُلُّ شَيءٍ سَيَرْعَوِي","غَيْرَ قَلْبِي وَلَحْظِهِ",51,"ظ",2,0],["كُلُّ شَيءٍ يَسْلُوهُ ذُو اللُّبِّ إِلَّا","ماضِيَ اللَّهْوِ فِي زَمانِ الشَّبابِ",52,"ب",1,0],["كُلَّ شَأْنٍ يَسُوسُهُ يَبْلُغُ الغَا","يَةَ فِيهِ مِنْ هِمَّةٍ وَمَضَاءِ",53,"ا",2,0],["كُلُّ شَيءٍ يُزْهى بِآيَاتِهِ الحُسْنَى","فَكَيفَ المُخَيَّرُ المَسؤُولُ",54,"ل",1,0],["كُلُّ شُكْرٍ يَصُوغُهُ الرَّوْضُ لاَ","يُوفِي وإِن جَلَّ مِنَّةً للسِّحَابِ",55,"ب",1,0],["كُلُّ شَأْنٍ مِمَّا تَوَلاَّهُ كَا","نَ الفَوْزُ مِنْ غِبِّهِ عَلَى مِيعَادِ",56,"د",1,0],["كلُّ شِبْرٍ بمصر خِصْبٌ على الهرَّا","جِ جدبُ الثرى على الفنّان",57,"ن",1,0],["كُلُّ شَيءٍ بِمِصْرَ يَبْهَرُ عَيْنَيْهِ","جَمَالاً ويَسْتَثِيرُ جَنَانَه",58,"ن",2,0],["كُلُّ شيءٍ يُطَاقُ مِنَ نُوَبِ الأَيَّامِ","إِلاَّ عَمَايةَ الْجُهّالِ",59,"ل",1,0],["كُلُّ شَيءٍ في الدُّنَا حَسَنٌ","أَيُّ شَيءٍ لَيْسَ بالْحَسَن",60,"ن",1,0],["كلُّ شهمٍ أَرْيَحِيّ أغْلَبٍ","من كريمٍ أريحِيّ أَغْلَب",61,"ب",1,0],["كُلُّ شَيْءٍِ لهُ نِصَابٌ سِوَى الْفَنِّ","فَلاَ حَدَّ يَنْتَهِي لِنِصَابِهْ",62,"ب",2,0],["كلُّ شيءٍ له أوانٌ يوفِّي","ه وفوْتُ الشباب قبل أوانه",63,"ن",2,0],["كلُّ شهرٍ أطلّ يدعو عليه","وهْو طفلٌ في مهده بالفناء",64,"ا",2,0],["كلُّ شعر أتى بغير عمودٍ","عُدَّ في الشعر من قبيل المُزَاح",65,"ح",1,0],["كلّ شعر غنيته فهو منها","وإليها والفنّ يحسوه صفوا .",66,"و",2,0],["كل شيء وشى بميلادك الموعود","واشتم دفئه واخضراره",67,"ر",2,0],["كلُّ شيءٍ تحت السماء بلونٍ","شفقيًّ مورَّدٍ مخضوب",68,"ب",1,0],["كل شعر معاصر ليس فيه","غضب العصر نملة عرجاء",69,"ا",2,0],["كل شيء إذا نزلت بلاداً","لم تطأها قبلا فغض جديد",70,"د",1,0],["كُلُّ شَيىء لهُ نِصَابٌ سِوَى الْفَ","نِّ فلا حَدّ ينتهي لنصابه",71,"ب",2,0],["كل شيء باطل في حكمه","غير ما يورث المجد الصراحا",72,"ح",2,0],["كَکلشَّمْسِ تُعْجِبُ مَنْ رَأَى ويزينُها","حسبٌ أغرُّ، إذا تريدُ فخارا",73,"ر",2,0],["كُلّ شَيءٍ هُو مِن