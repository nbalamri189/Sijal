0.html","الخفيف"],[554,"من لداع لا يجاب","https://www.aldiwan.net/poem48097.html","مجزوء الرمل"],[561,"كل شيء لا يرى الرحمن به","https://www.aldiwan.net/poem33521.html","الرمل"],[561,"كل شيء كما أتى النص هالك","https://www.aldiwan.net/poem33538.html","الخفيف"],[561,"فنحت عندنا المليح فاها","https://www.aldiwan.net/poem33654.html","الخفيف"],[561,"كل شيء به تعلق شيء","https://www.aldiwan.net/poem33663.html","الخفيف"],[561,"يا نديمي إن غابت الناس عني","https://www.aldiwan.net/poem33759.html","الخفيف"],[561,"لي وجود بمن يقول أنا","https://www.aldiwan.net/poem33776.html","الخفيف"],[561,"إن من آيات ربي هو قال","https://www.aldiwan.net/poem34210.html","الرمل"],[561,"هذه أثوابهم والحلل","https://www.aldiwan.net/poem34247.html","الرمل"],[561,"جسد في هوى المليح عليل","https://www.aldiwan.net/poem34252.html","الخفيف"],[561,"كل شيء فيه وفي كل شيء","https://www.aldiwan.net/poem34256.html","الخفيف"],[561,"كل شيء لنا على التحقيق","https://www.aldiwan.net/poem34318.html","الخفيف"],[561,"أعط طرفا له وللكون طرفا","https://www.aldiwan.net/poem34343.html","الخفيف"],[561,"انظر الكل لطيفا","https://www.aldiwan.net/poem34353.html","مجزوء الرمل"],[561,"قف على أيمن الحمى كوقوفي","https://www.aldiwan.net/poem34361.html","الخفيف"],[561,"إن شمسي من طاقتي في طلوع","https://www.aldiwan.net/poem34378.html","الخفيف"],[561,"أيها الطلعة التي أخذتنا","https://www.aldiwan.net/poem34407.html","الخفيف"],[561,"شمس وحي ظهرت في قمري","https://www.aldiwan.net/poem34473.html","الرمل"],[561,"يا بديع الحسن بالصور","https://www.aldiwan.net/poem34536.html","المديد"],[561,"قل هو الله أحد","https://www.aldiwan.net/poem34576.html","مجزوء الرمل"],[561,"كل شيء هو خيط أسود","https://www.aldiwan.net/poem34592.html","الرمل"],[561,"حركات سكنات","https://www.aldiwan.net/poem34707.html","مجزوء الرمل"],[561,"أنت قيد الوجود إن غبت غابا","https://www.aldiwan.net/poem34952.html","الخفيف"],[562,"غير ليلي لم يرى في الحي حي","https://www.aldiwan.net/poem69333.html","الرمل"],[565,"طال شوقي لطول هذا البعاد","https://www.aldiwan.net/poem52967.html","الخفيف"],[567,"لو سلمنا من العمائم طراً","https://www.aldiwan.net/poem870.html",""],[567,"إسق يا غيث بكرة وعشية","https://www.aldiwan.net/poem910.html",""],[570,"كيف يبقى من يعرضه","https://www.aldiwan.net/poem69513.html","المديد"],[570,"باكر الصبحة هذا","https://www.aldiwan.net/poem69516.html","الرمل"],[578,"إنك المخلوق في كبدي","https://www.aldiwan.net/poem2816.html","المديد"],[578,"وجنة فوقها عذار أطلا","https://www.aldiwan.net/poem3027.html","الخفيف"],[578,"عاد قلب الشوق إذ عدت عيده","https://www.aldiwan.net/poem3077.html","الخفيف"],[745,"","https://poetry.dctabudhabi.ae/diwan/poem/67407","الخفيف"],[986,"","https://poetry.dctabudhabi.ae/diwan/poem/105727","الرمل"],[987,"","https://poetry.dctabudhabi.ae/diwan/poem/202327","الخفيف"],[512,"كل شئ مصيره للزوال","https://www.poetsgate.com/ViewPoem.aspx?id=27766",""]],"verses":[["كُلُّ شَيءٍ مِنَ الزَمانِ طَريفُ","وَاللَيالي مَغانِمٌ وَحُتوفُ",0,"ف",1,1],["كُلُّ شَيءٍ إِلّا التَحِيَّةَ يُرجى","فَهيَ لِلَّهِ وَالدُنا لِلزَوالِ",1,"ل",1,0],["كُلُّ شَأْنٍ لِلدَّهْرِ جَازَ بِهِ","زَادَهُ فِي عَلائِهِ شَانَا",2,"ن",2,0],["كُلُّ شَيْءٍ تَهْوَاهُ أَهْوَاهُ إِلاَّ","أَنْ أَرَى لِي شَرِيكَةً فِي غَرَامِي",3,"م",2,0],["كلّ شي بالرحم يظهر","وبها هوّت وجود",4,"د",1,0],["كل شيء يعار في الناس إِلا ال","عرض منهم فإنه لا يعار",5,"ر",1,0],["كلّ شيء من عالم الذرّات","كل شيء في كونه كالنبات",6,"ت",1,1],["كل شيء في بدئه من صغير","ثم ينمو في ذاته والصفات",6,"ت",1,0],["كل شيء في أهلها مستعار","من سواه وكل حال تحول",7,"ل",1,0],["كُلَّ شَيءٍ أَحصى كِتاباً وَعِلماً","وَلَدَيهِ تَجَلَّتِ الأَسرارُ",8,"ر",1,0],["كلُّ شعبٍ أنتم به آل شادٍ","فهو شعبي وشعب كل أديب",9,"ب",1,0],["كلّ شهرٍ لنا هلالٌ جديدٌ","مبرز للفناء كلّ مصون",10,"ن",1,1],["كلُّ شيء أراه منك بشيرٌ","صَدَّق الله هذه البُشراءَ",11,"ا",2,0],["كلُّ شيء بالحس يُعرف أو بال","سَمع أو بالأدلَّة الفُصحاءِ",12,"ا",2,0],["كل شيءٍ غُلب الصبْ","رُ إلَيْهِ فمباحُ",13,"ح",1,0],["كلُّ شيءٍ له تَناهٍ وحدٌّ","كل شيءٍ يجري إلى مِقدارِ",14,"ر",1,0],["كل شيءٍ محا حُلاها فزَينٌ","كل شيءٍ وارَى التراب ففرشُ",15,"ش",1,0],["كل شيء أهديه غير بديعٍ","لك عندي إلا اعتذاراً بديعا",16,"ع",2,1],["كل شعر جهدت نفسك فيه","وتكلفت نظمه تفقيع",17,"ع",1,0],["كُلُّ شَيءٍ لِلكُلِّ مِلكٌ حَلالٌ","كُلُّ شَيءٍ فيها كَما الكُلُّ شاءوا",18,"ا",1,0],["كُلُّ شَيءٍ مِنكَ عِندي","غَيرَ إِعراضِكَ سَهلُ",19,"ل",1,0],["كُلُّ شَيءٍ مِنكَ مَقبولُ","وَعَلى العَينَينِ مَحمولُ",20,"ل",1,1],["كُلَّ شَيءٍ رَأَيتُهُ","حَسَناً أَشتَهيهِ لَك",21,"ك",1,0],["كُلُّ شَيءٍ مِن حَبيبي","ما خَلا الغَدرَ اِحتَمَلتُهُ",22,"ت",2,0],["كُلُّ شَيءٍ أَرَدتُهُ فَهُوَ فيهِ","حَسَنُ الذاتِ كامِلُ الأَدَواتِ",23,"ت",1,0],["كلُّ شيءٍ يُعاطِفُ العالَم الحيَّ","ويُذكِي حياته ويُفيدُهْ",24,"ه",1,0],["كلُّ شيءٍ يُسايِرُ الزَّمنَ الماشي","بعزمٍ حتَّى التُّرابُ ودُودُهْ",24,"ه",1,0],["كلُّ شيءٍ إِلاّكَ حَيٌّ عَطوفٌ","يُؤْنِسُ الكونَ شَوْقُهُ ونَشيدُهْ",24,"ه",1,0],["كُلُّ شعبٍ قَدْ طَغَتْ فيهِ الدِّمَا","دونَ أَنْ يَثْأَرَ للحَقِّ الجَلِي",25,"ل",2,0],["كلُّ شيءٍ موقَّعٌ فيكِ حتَّى","لَفْحَةُ الجيدِ واهتزازُ النّهودِ",26,"د",1,0],["كلُّ شَيءٍ وإِنْ أَضَرَّ بجِسمي","لَكَ فيهِ الرِّضَى إليَّ حَبيبُ",27,"ب",1,0],["كُلُّ شَيءٍ مِنَ الدِماءِ حَرامٌ","شُربُهُ ما خَلا دَمَ العُنقودِ",28,"د",1,0],["كُلُّ شِعرٍ نَظيرُ قائِلِهِ في","كَ وَعَقلُ المُجيزِ عَقلُ المُجازِ",29,"ز",1,0],["كل شعرٍ معاصرٍ ليس فيه","غصب العصر نملةٌ عرجاء",30,"ا",2,0],["كُلُّ شَيءٍ فَقَد أَحاطَ بِهِ اللَ","هُ وَأَحصاهُ عِلمُهُ المَخزونُ",31,"ن",1,0],["كُلُّ شَيءٍ فيهِ مَوعِظَةٌ","تَعِظُ الإِنسانَ لَو عَقَلا",32,"ل",2,1],["كُلُّ شَهمٍ أَجرا جَناناً مِنَ الصَق","رِ وَأَبهى حُسناً مِنَ الطاووسِ",33,"س",1,0],["كلُّ شيءٍ مأتمٌ في عينه","لا الكرى طابَ ولا طابَ السهر",34,"ر",1,0],["كل شيء حيّ هنا ونبات القبر","ينمو في غير هذا المكان",35,"ن",1,0],["كل شيء صار مرّاً في فمي","بعد ما أصبحت بالدنيا عليما",36,"م",2,0],["كل شيء من سرور وحَزَن","والليالي من بهيجٍ وشجي",37,"ي",1,0],["كلّ شهمِ القلبِ مرهوبِ الشبا","مُرْتضى الأخلاقِ محمودِ الشيم",38,"م",1,0],["كُلُّ شَيءٍ غَثٌّ إِذا عادَ وَال","مَعروفُ غَثٌّ ما كانَ غَيرَ مُعادِ",39,"د",1,0],["كُلُّ شِعبٍ كُنتُم بِهِ آلَ وَهبٍ","فَهوَ شِعبيِ وَشِعبُ كُلِّ أَديبِ",40,"ب",1,0],["كُلُّ شَيءٍ يَفْنَى وَلَكِنْ هِجَائِي","فِيكَ بَاقٍ مَا عَاقَبَ السَّيْفَ صَقْلُ",41,"ل",1,0],["كلُّ شيءٍ سينقضي غيرَ حبي","لكِ والمدحِ للوزيرِ الكبيرِ",42,"ر",1,0],["كلُّ شيءٍ باطلٌ في حُكمهِ","غير ما يُورِثهُ المجدَ الصُّرَاحا",43,"ح",2,0],["كُلُّ شَيءٍ إِلى اِنقِطاعٍ مَداهُ","وَصُروفُ الأَيّامِ تُبلي الجَديدا",44,"د",2,0],["كُلُّ شُهوري عَلَيَّ واحِدَةٌ","لا صَفَرٌ يُتَّقى وَلا رَجَبُ",45,"ب",1,0],["كل شيء جاء منه","وإليه سيصير",46,"ر",1,0],["كل شيء مَع الجديدين يفنى","ثم يَبقى جلال رَبي تَعالى",47,"ل",2,0],["كل شيء فانه يَتلاشى","بِتَوالي الأزمان إِلّا الأثير",48,"ر",1,0],["كل شعرٍ نظير قابله منك","وعقل المجيز مثل المجاز",49,"ز",1,0],["كُلُّ شِبرٍ فيها عَلَيهِ بِناءٌ","مُشمَخِرٌّ أَو رَوضَةٌ أَو غَديرُ",50,"ر",1,0],["كُلُّ شَيءٍ سَيَرْعَوِي","غَيْرَ قَلْبِي وَلَحْظِهِ",51,"ظ",2,0],["كُلُّ شَيءٍ يَسْلُوهُ ذُو اللُّبِّ إِلَّا","ماضِيَ اللَّهْوِ فِي زَمانِ الشَّبابِ",52,"ب",1,0],["كُلَّ شَأْنٍ يَسُوسُهُ يَبْلُغُ الغَا","يَةَ فِيهِ مِنْ هِمَّةٍ وَمَضَاءِ",53,"ا",2,0],["كُلُّ شَيءٍ يُزْهى بِآيَاتِهِ الحُسْنَى","فَكَيفَ المُخَيَّرُ المَسؤُولُ",54,"ل",1,0],["كُلُّ شُكْرٍ يَصُوغُهُ الرَّوْضُ لاَ","يُوفِي وإِن جَلَّ مِنَّةً للسِّحَابِ",55,"ب",1,0],["كُلُّ شَأْنٍ مِمَّا تَوَلاَّهُ كَا","نَ الفَوْزُ مِنْ غِبِّهِ عَلَى مِيعَادِ",56,"د",1,0],["كلُّ شِبْرٍ بمصر خِصْبٌ على الهرَّا","جِ جدبُ الثرى على الفنّان",57,"ن",1,0],["كُلُّ شَيءٍ بِمِصْرَ يَبْهَرُ عَيْنَيْهِ","جَمَالاً ويَسْتَثِيرُ جَنَانَه",58,"ن",2,0],["كُلُّ شيءٍ يُطَاقُ مِنَ نُوَبِ الأَيَّامِ","إِلاَّ عَمَايةَ الْجُهّالِ",59,"ل",1,0],["كُلُّ شَيءٍ في الدُّنَا حَسَنٌ","أَيُّ شَيءٍ لَيْسَ بالْحَسَن",60,"ن",1,0],["كلُّ شهمٍ أَرْيَحِيّ أغْلَبٍ","من كريمٍ أريحِيّ أَغْلَب",61,"ب",1,0],["كُلُّ شَيْءٍِ لهُ نِصَابٌ سِوَى الْفَنِّ","فَلاَ حَدَّ يَنْتَهِي لِنِصَابِهْ",62,"ب",2,0],["كلُّ شيءٍ له أوانٌ يوفِّي","ه وفوْتُ الشباب قبل أوانه",63,"ن",2,0],["كلُّ شهرٍ أطلّ يدعو عليه","وهْو طفلٌ في مهده بالفناء",64,"ا",2,0],["كلُّ شعر أتى بغير عمودٍ","عُدَّ في الشعر من قبيل الم