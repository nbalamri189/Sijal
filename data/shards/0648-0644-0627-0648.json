{"poems":[[53,"من الركب ما بين النقا والأناعم","https://www.aldiwan.net/poem29748.html","الطويل"],[53,"أبى الله إلا أن يسوء بك العدى","https://www.aldiwan.net/poem30635.html","الطويل"],[55,"أيا زهر الملاحة والجمال","https://www.aldiwan.net/poem26184.html","الوافر"],[34,"فما وجدت وجدي بها أم واحيد","https://www.aldiwan.net/poem4883.html","الطويل"],[77,"أيام قربك عندي ما لها ثمن","https://www.aldiwan.net/poem36028.html","البسيط"],[93,"مضى عصر الرجال الأعاظم","https://www.aldiwan.net/poem11326.html","الطويل"],[27,"أقلي اللوم عاذل والعتابا","https://www.aldiwan.net/poem5686.html","الوافر"],[37,"ولا وقريين في ثلة","https://www.aldiwan.net/poem7168.html","المتقارب"],[47,"ضلال مارأيت من الضلال","https://www.aldiwan.net/poem25209.html","الوافر"],[47,"دعوتك للجفن القريح المسهد","https://www.aldiwan.net/poem25322.html","الطويل"],[23,"ولا والله ما تدري هذيل","https://www.aldiwan.net/poem21332.html","الوافر"],[72,"الحمد لله على إنعامه","https://www.aldiwan.net/poem19685.html","المنسرح"],[72,"بدت ورنت لواحظه دلالا","https://www.aldiwan.net/poem20544.html","الوافر"],[51,"كفي الدموع وإن كان الفراق غدا","https://www.aldiwan.net/poem10879.html","البسيط"],[51,"يا أبا الصقر زادك الله في المجد","https://www.aldiwan.net/poem65411.html","الخفيف"],[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[51,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[51,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[51,"إما تريني قالبا مجني","https://www.aldiwan.net/poem66392.html","الرجز"],[51,"وأشهد ما يكون عل هجاء","https://www.aldiwan.net/poem66727.html","الوافر"],[29,"عفا الجو من سلمى فبادت رسومها","https://www.aldiwan.net/poem6053.html","الطويل"],[91,"وربت أمريكية خلت ودها","https://www.aldiwan.net/poem8794.html","عموديه"],[70,"مالي على الغبن قدره","https://www.aldiwan.net/poem42870.html","المجتث"],[92,"شعري نفاثة صدري","https://www.aldiwan.net/poem38939.html","المجتث"],[92,"ما لآفاقك يا قلبي سودا حالكات","https://www.aldiwan.net/poem38965.html","مجزوء الرمل"],[85,"صغار في الذهاب وفي الإياب","https://www.aldiwan.net/poem7585.html","الوافر"],[85,"شكوت لله من نسلي وكثرته","https://www.aldiwan.net/poem7743.html","البسيط"],[85,"لكم في الخط سياره","https://www.aldiwan.net/poem7918.html","الهزج"],[85,"بحمد الله رب العالمينا","https://www.aldiwan.net/poem63730.html","الوافر"],[56,"سهام لحاظ من قسي الحواجب","https://www.aldiwan.net/poem58453.html","الطويل"],[43,"أظبية الوحش لولا ظبية الأنس","https://www.aldiwan.net/poem9611.html","البسيط"],[43,"لجنية أم غادة رفع السجف","https://www.aldiwan.net/poem9728.html","الطويل"],[62,"ذكرتكم عند الزلال على الظما","https://www.aldiwan.net/poem52304.html","الطويل"],[62,"لعمرك ما أغبك عن فتور","https://www.aldiwan.net/poem52324.html","الوافر"],[62,"لمن في عراص البيد نوق مطاريب","https://www.aldiwan.net/poem52480.html","الطويل"],[45,"تعست فما لي من وفاء ولا عهد","https://www.aldiwan.net/poem63524.html","الطويل"],[45,"محل على القاطول أخلق داثره","https://www.aldiwan.net/poem63630.html","الطويل"],[61,"أقول لحنان العشي المغرد","https://www.aldiwan.net/poem51699.html","الطويل"],[61,"تصابى فأضحى بعد سلوته صبا","https://www.aldiwan.net/poem51769.html","الطويل"],[49,"أراني صالح بغضا","https://www.aldiwan.net/poem64230.html","الهزج"],[66,"نفوس الصيد أثمان المعالي","https://www.aldiwan.net/poem40137.html","الوافر"],[80,"أبى الله إلا أن يكون لك النصر","https://www.aldiwan.net/poem31432.html","الطويل"],[87,"تصابيت بعد الحلم واعتادني شجوي","https://www.aldiwan.net/poem8194.html","الطويل"],[87,"عليل أنت مسقمه","https://www.aldiwan.net/poem8277.html","مجزوء الوافر"],[69,"بهادر عبدي لا بهاء ولا در","https://www.aldiwan.net/poem28375.html","الطويل"],[33,"تعلق روحي روحها قبل خلقنا","https://www.aldiwan.net/poem25949.html","الطويل"],[105,"دعونا نبتدر ورد الحمام","https://www.aldiwan.net/poem43419.html","الوافر"],[40,"إني زائر ظبيا","https://www.aldiwan.net/poem42304.html","الهزج"],[67,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[48,"لقد كنت وما في الناس","https://www.aldiwan.net/poem63347.html","الهزج"],[50,"ألا يا حبذا والله","https://www.aldiwan.net/poem63814.html","الهزج"],[50,"أحبى فيم خليت","https://www.aldiwan.net/poem64745.html","الهزج"],[50,"ألا يا خاتم الملك","https://www.aldiwan.net/poem64747.html","الهزج"],[50,"من المشهور بالحب","https://www.aldiwan.net/poem64848.html","الهزج"],[46,"مجوسية وحنيفية","https://www.aldiwan.net/poem23620.html","المتقارب"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20982","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42688","المتقارب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42696","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55506","الطويل"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12466","الهزج"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199503","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43831","المديد"],[22,"ولما كنتُ جَارَهُمُ حَبَوْنِي","https://www.poetsgate.com/ViewPoem.aspx?id=18932",""],[22,"فلا وأبيك ما ظلمتْ قريعٌ","https://www.poetsgate.com/ViewPoem.aspx?id=19723",""],[18,"لوْ أنَّ خيلي أدركتكَ وجدتهمْ","https://www.poetsgate.com/ViewPoem.aspx?id=22991",""],[51,"لعمري لقد غاب الرضا فتطاولتْ","https://www.poetsgate.com/ViewPoem.aspx?id=30457",""],[51,"يا أبا الصقرِ زادكَ اللَّه في ال","https://www.poetsgate.com/ViewPoem.aspx?id=29584",""],[51,"ومُنْزل الوحْي علي نبيِّهِ","https://www.poetsgate.com/ViewPoem.aspx?id=30760",""],[20,"فإِن لم تندموا فثكلت عمراً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=70007&r=&rc=29",""]],"verses":[["وَلا واهِنٌ إِن عَضَّهُ الأَمرُ هابَهُ","وَأَلقى مَقاليدَ الذَليلِ المُسالِمِ",0,"م",1,0],["وَلا وَجَدَ الراجونَ أُفقَكَ مُظلِماً","وَزَندُ النَدى يَوماً بِكَفِّكَ مُصلِدا",1,"د",2,0],["وَلا وَأَبيكِ ما اِنبَسَطت يَميني","بِفاحِشَةٍ إِلَيكِ وَلا شِمالي",2,"ي",1,0],["وَلا وَجَدَ العُذريُّ عَروَةُ في الهَوى","كَوَجدي وَلا مَن كانَ قَبلي وَلا بَعدي",3,"ي",1,0],["وَلاَ واللهِ مَا سَكَنَتْ نَفْسِي إِلَى أَحَدٍ","يَوْماً وَلاَ رَاقَ عَيْنِي مَنْظَرٌ حَسَنُ",4,"ن",1,0],["وَلا وَجْهَ فِي أَحْيَائِهَا غَيْرُ سَاهِمٍ","وَلا قَلْبَ فِي أَحْنَائِهَا غَيْرُ وَاجِمِ",5,"م",1,0],["وَلا وَأَبيكَ ما لَهُم عُقولٌ","وَلا وُجِدَت مَكاسِرُهُم صِلابا",6,"ب",2,0],["ولا وقريَّين في ثُلَّة","يجاوب فيها الثُّؤاجُ اليُعارا",7,"ر",2,1],["وَلا وَاللَهِ مابَخِلَت يَميني","وَلا أَصبَحتُ أَشقاكُم بِمالي",8,"ي",1,0],["وَلا وَأَبي ما يَفتُقُ الدَهرُ جانِباً","فَيَرتُقُهُ إِلّا بِأَمرٍ مُسَدَّدِ",9,"د",1,0],["وَلا وَاللَهِ ما تَدري هُذَيلٌ","أَمَحضٌ ماءُ زَمزَمَ أَم مَشوبُ",10,"ب",1,1],["ولا ولا أو يعود قائلها","من بعد إفصاحه كتمتامه",11,"م",2,0],["ولا والله لا أزجي ركاباً","لغيرهما ولا أنهي سؤالا",12,"ل",2,0],["ولا وربِّك مالي بالشتاء يدٌ","وقد أتاني يسوق الصِّرَّ والجَمدا",13,"د",2,0],["ولأولى بأن يهنِّئك النا","س ضياعٌ حفظتها أن تضاعا",14,"ع",2,0],["ولا وأى عنك حسن الظن موعده","إلا غدت وهي حاء واصلت قافا",15,"ف",2,0],["ولا واللَّه ما تَسْوَى أمورٌ","تراها قيمتي أبداً قِبالي",16,"ي",1,0],["ولا واسمٌ عِرْضَ امرئٍ كان نالهُ","بسوء وإن لامتْهُ فيه اللوائمُ",17,"م",1,0],["ولا وجدتُ الظلمَ كان مني","ولن يغيب غائبٌ عن جني",18,"ن",2,0],["ولا واللَّه ما حَبَّرتُ فيكم","سِوى مَدْحٍ يُزَيِّنُ لا بسيه",19,"ي",2,0],["وَلا وَجَدوا أُمّاً لَهُ عَرَبِيَّةً","وَلا أَسهَرَتها مِن خِتانٍ كُلومُها",20,"م",3,0],["وَلا وَجهُها شَمس وَلا شَعرُها دُجىً","وَلا صَدُّها حَر وَلا وَصلُها بَردُ",21,"د",1,0],["وَلا وَقى لَكَ نَفساً","وَلا أَقالَكَ عَثرَه",22,"ر",2,0],["ولا وجدتُ اكتئابي","ولا وجدتُ سُروري",23,"ي",1,0],["ولأوتارِكَ لا تَخْفُقُ إلاَّ شاكِياتْ","ولأنغامِكَ لا تَنْطُقُ إلاَّ باكِياتْ",24,"ت",1,0],["ولا والله ما ملكوا متابا","ولا ملكوا القديم من العقاب",25,"ب",1,0],["ولا ووجهك لم أكره تعدّدهم","فأغنهم ثم هبهم لي بلا عدد",26,"د",1,0],["وَلا وَاللَهِ ما كَلَّف","تَ مَحجوباً وَلا بارَه",27,"ر",2,0],["وَلا وَاللَهِ وَالرُسلِ الكِرامِ","وَبَيتِكَ خَيرُ بَيتٍ في الأَنامِ",28,"ا",2,0],["ولا والثنايا الغُرِّ مِنْ فِيكِ إنَّها","لكالغَيثِ أَدَّتْهُ أَكُفُّ السّحائبِ",29,"ب",1,0],["وَلا وَقَفتُ بِجِسمٍ مُسيَ ثالِثَةٍ","ذي أَرسُمٍ دُرُسٍ في الأَرسُمِ الدُرُسِ",30,"س",1,0],["وَلا واحِداً في ذا الوَرى مِن جَماعَةٍ","وَلا البَعضُ مِن كُلٍّ وَلَكِنَّكَ الضِعفُ",31,"ف",1,0],["ولا والذي عافاكمُ وابتلى بكمْ","فؤاديَ ما اجتازَ السُّلوُّ بِبالي",32,"ي",1,0],["ولا واللّهِ ما بي من سكُونٍ","إِذا ما كنتَ لا تقوى حَرَاكا",33,"ك",2,0],["ولا وقفتي الحادثاتُ تبلُّداً","وكيف اتساعُ الخطوِ والقيدُ مكروبُ",34,"ب",1,0],["وَلا واصِلٌ مَن غابَ عَنّي نَسيتُهُ","وَإِن وَصَلَ الإِخوانُ كافَأتُ بِالصَدِّ",35,"د",1,0],["وَلا وَأَلَ المَشكوكُ فيهِ وَلا نَجا","مِنَ السَيفِ ناضي السَيفِ غَدراً وَشاهِرُه",36,"ر",2,0],["ولا وِصْلَ إلا أن أروحَ مُغَرِّراً","بأدهمَ في تَيَّارِ أخضرَ مُزبِدِ",37,"د",1,0],["ولا وصْلَ إلا أن تَبيتَ أكُفُّنا","ركائبَ تُزْجي من مُدامتِنا رَكْبا",38,"ب",2,0],["وَلا وَاللَهِ لا يَنقُ","ضُ إِلّا زِدتُهُ نَقضا",39,"ض",2,0],["وَلا وادي جَهَنَّمَ حينَ حَلَّوا","بِهِ أَمسى عَليهِم شَرَّ فالِ",40,"ل",1,0],["ولا وَرَدوا من مائها حَسْوَ طائرٍ","يُبَلّ بهِ منهُ إِذا يَبِس السَّحْرُ",41,"ر",1,0],["وَلا وَأَبِي مَا النَّصْلُ فِي الْفِعْلِ كَالْعَصَا","وَلا الْقَوْسُ مَلآنَ الْحَقِيبَةِ كَالْخِلْوِ",42,"و",1,0],["وَلا وَاللَّهِ مَا لِي فِي الْ","هَوَى ذَنْبٌ فَأَعْلَمُهُ",43,"م",2,0],["ولا وجهُهُ صبحٌ ولا شعرُهُ دجى","ولا قدُّهُ غصنٌ ولا ريقُهُ خمرُ",44,"ر",1,0],["وَلا وَجِدَ العُذرِيُّ عُروَةُ إِذ قَضى","كَوَجدي وَلا مَن كانَ قَبلي وَلا بَعدي",45,"د",2,0],["وَلا وَاللَه نَرضى الخسفَ دِيناً","كَدأبِ المُستَذَلِّ المُستَضامِ",46,"م",1,0],["وَلا وَاللَهِ ما بِي بُغ","ضُهُ يا صاحِ أُخفِيهِ",47,"ي",2,0],["وَلا وَصْفَ إِلَّا أنْ يَكُونَ لِواصِفٍ","وُرُودٌ عَلَى مَوْصُوفِهِ وصُدُورُ",48,"ر",1,0],["وَلا وَاللَهِ لا وَاللَ","هِ لا وَاللَهِ لا أَقصِر",49,"ر",1,0],["وَلا وَاللَهِ لا أَدري","أَرومُ الوَصلَ أَم هَجرا",50,"ر",2,0],["وَلا وَاللَهِ ما يَصبِ","رُ في البَرِّيَّةِ الحوتُ",51,"ت",1,0],["وَلا وَاللَهِ لَو حَمَّلِ","تِني سِرَّكِ ما خُنتُه",52,"ت",2,0],["وَلا وَاللَهِ ما في الشَر","قِ مِن أُنثى وَلا الغَربِ",53,"ب",1,0],["وَلا وَردُ غابٍ لَهُ حُلَّةٌ","مِنَ الدَمِ في الغيلِ وَردِيَّه",54,"د",3,0],["ولا وَضَعَت إليَّ عَلَى خَلاَءٍ","حَصَانٌ يومَ جِلوتَها قِناعا",55,"ع",2,0],["وَلا وَحِفَاظِكَ وَهْوَ الْيَمِي","نُ مَا حُلْتُ عَنْ عَهْدِكُمْ إِصْبَعَا",56,"ع",2,0],["وَلا وَرَبِّكَ مَا وَجْدِي بِمُنْدَرِسٍ","عَلَى البِعَادِ وَلا صَبْرِي بِمِطْوَاعِ",57,"ع",1,0],["وَلا وَصْفَ إِلاَّ أَنْ يُمَثِّلَ حَالَةً","مِنَ النَّفْسِ لَمْ تَبْلُغْ بَدِيهَةَ بَادِهِ",58,"د",2,0],["وَلا وَاللَهِ ما أَصبَح","تُ في ذَلِكَ مُرتابا",59,"ب",2,0],["ولا وعت إذن كترتيلها","ولا رواها بلبلٌ في غناهْ",60,"ا",2,0],["وَلِأَوقاتٍ ثَلاثَةٍ اِهتَج","بُكرَة أَو ظُهُرٍ أَو عَشِيِّ",61,"ي",1,0],["ولا وأبيك ما ظلمت قريعٌ","ولا برموا بذاك ولا أساءوا",62,"ا",1,0],["ولا وأبيك ما ظلمت قريعٌ","بِعَثْرَة ِ جَارِهم أنْ يَنْعَشُوها",63,"ا",1,0],["وَ لأوردنَّ الخيلَ بطنَ أراكة ٍ","وَ لأقضينَّ بفعل ذاكَ ديوني",64,"ن",2,0],["ولا واسمٌ عِرْضَ امرىء كان نالهُ","بسوء وإنْ لامتْهُ فيه اللوائمُ",65,"م",1,0],["ولأولَى بأن يَهنئك النا سُ ضياعٌ","حفظْتها الرِّعاءُ من أن تضاعا",66,"ع",2,0],["ولا وَمِد الظل ولا وَبيِّهِ","مكِّيّ بين المَجْدِ أخشبيِّه",67,"ب",3,0],["وَلا وَضَعَت يَدايَ عَنانَ طِرفٍ","وَلا أَبصَرتُ مِن شَمسٍ شُعاعا",68,"ع",2,0]]}