//www.aldiwan.net/poem61236.html","البسيط"],[456,"أيوما مثل يوم الجزع","https://www.aldiwan.net/poem55890.html","مجزوء الوافر"],[456,"ظن غداة الخيف أن قد سلِما","https://www.aldiwan.net/poem55900.html","الرجز"],[456,"مالك لا تطرب يا حادي النعم","https://www.aldiwan.net/poem55901.html","الرجز"],[456,"تموق الليالي فيكم ثم تعقِل","https://www.aldiwan.net/poem55908.html","الطويل"],[456,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[456,"أعينوني على طلب المعالي","https://www.aldiwan.net/poem56066.html","الوافر"],[456,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"],[456,"دعوها ترد بعد خمس شروعا","https://www.aldiwan.net/poem56122.html","المتقارب"],[456,"حب إليها بالغضا مرتبعا","https://www.aldiwan.net/poem56125.html","السريع"],[456,"كالشمس من جمرة عبد شمس","https://www.aldiwan.net/poem56156.html","الرجز"],[456,"نفرها عن وردها بحاجر","https://www.aldiwan.net/poem56177.html","الرجز"],[456,"نديمي وما الناس إلا السكارى","https://www.aldiwan.net/poem56204.html","المتقارب"],[456,"رد عليها النوم بعد ما شرد","https://www.aldiwan.net/poem56212.html","الرجز"],[475,"هي الدار قد أقوت ورث جديدها","https://www.aldiwan.net/poem15191.html","الطويل"],[475,"يذكرني ثناياهنلما","https://www.aldiwan.net/poem15199.html","الوافر"],[477,"حللت مكانا في الكهولة بعدما","https://www.aldiwan.net/poem37177.html","الطويل"],[498,"البرق لما لمعا","https://www.aldiwan.net/poem37976.html","مجزوء الرجز"],[511,"لئن كان الرقيب بلاء قوم","https://www.aldiwan.net/poem67777.html","الوافر"],[513,"خذ حديثي فإنه معسول","https://www.aldiwan.net/poem12218.html","الخفيف"],[513,"ولاؤك مفروض على كل مسلم","https://www.aldiwan.net/poem12246.html","الطويل"],[513,"ولاؤك دين في الرقاب ودين","https://www.aldiwan.net/poem12276.html","الطويل"],[513,"أيا سفح المقطم كم سفحنا","https://www.aldiwan.net/poem12289.html","الكامل"],[534,"صحا من سكره وسلا","https://www.aldiwan.net/poem23848.html","مجزوء الوافر"],[549,"لا تقطعن رجاء العيش بالعلل","https://www.aldiwan.net/poem47259.html","البسيط"],[549,"لذ بالعزاء فلا خل تضن به","https://www.aldiwan.net/poem47346.html","البسيط"],[549,"تقول لي إنما الستون مقطعة","https://www.aldiwan.net/poem47829.html","البسيط"],[549,"إلام أرامي في المنى وأُرادي","https://www.aldiwan.net/poem47847.html","الطويل"],[549,"أما رأيت ضحيا","https://www.aldiwan.net/poem47867.html","المجتث"],[556,"أنا العاشق السالي لوجهك يا علو","https://www.aldiwan.net/poem33585.html","الطويل"],[556,"أنا المعروف لي بالله ألوان","https://www.aldiwan.net/poem33827.html","الهزج"],[556,"تفاخر الماء والهواء","https://www.aldiwan.net/poem35076.html","مخلع البسيط"],[565,"أذابت قلبه الزفره","https://www.aldiwan.net/poem69677.html","مجزوء الرجز"],[567,"ذريني أَم مسكين ذريني","https://www.aldiwan.net/poem52024.html","الوافر"],[585,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"]],"verses":[["وَلا واهِنٌ إِن عَضَّهُ الأَمرُ هابَهُ","وَأَلقى مَقاليدَ الذَليلِ المُسالِمِ",0,"م",1,0],["وَلا وَجَدَ الراجونَ أُفقَكَ مُظلِماً","وَزَندُ النَدى يَوماً بِكَفِّكَ مُصلِدا",1,"د",2,0],["وَلا وَأَبيكِ ما اِنبَسَطت يَميني","بِفاحِشَةٍ إِلَيكِ وَلا شِمالي",2,"ي",1,0],["وَلا وَجَدَ العُذريُّ عَروَةُ في الهَوى","كَوَجدي وَلا مَن كانَ قَبلي وَلا بَعدي",3,"ي",1,0],["وَلاَ واللهِ مَا سَكَنَتْ نَفْسِي إِلَى أَحَدٍ","يَوْماً وَلاَ رَاقَ عَيْنِي مَنْظَرٌ حَسَنُ",4,"ن",1,0],["وَلا وَجْهَ فِي أَحْيَائِهَا غَيْرُ سَاهِمٍ","وَلا قَلْبَ فِي أَحْنَائِهَا غَيْرُ وَاجِمِ",5,"م",1,0],["وَلا وَأَبيكَ ما لَهُم عُقولٌ","وَلا وُجِدَت مَكاسِرُهُم صِلابا",6,"ب",2,0],["ولا وقريَّين في ثُلَّة","يجاوب فيها الثُّؤاجُ اليُعارا",7,"ر",2,1],["وَلا وَاللَهِ مابَخِلَت يَميني","وَلا أَصبَحتُ أَشقاكُم بِمالي",8,"ي",1,0],["وَلا وَأَبي ما يَفتُقُ الدَهرُ جانِباً","فَيَرتُقُهُ إِلّا بِأَمرٍ مُسَدَّدِ",9,"د",1,0],["وَلا وَاللَهِ ما تَدري هُذَيلٌ","أَمَحضٌ ماءُ زَمزَمَ أَم مَشوبُ",10,"ب",1,1],["ولا ولا أو يعود قائلها","من بعد إفصاحه كتمتامه",11,"م",2,0],["ولا والله لا أزجي ركاباً","لغيرهما ولا أنهي سؤالا",12,"ل",2,0],["ولا وربِّك مالي بالشتاء يدٌ","وقد أتاني يسوق الصِّرَّ والجَمدا",13,"د",2,0],["ولأولى بأن يهنِّئك النا","س ضياعٌ حفظتها أن تضاعا",14,"ع",2,0],["ولا وأى عنك حسن الظن موعده","إلا غدت وهي حاء واصلت قافا",15,"ف",2,0],["ولا واللَّه ما تَسْوَى أمورٌ","تراها قيمتي أبداً قِبالي",16,"ي",1,0],["ولا واسمٌ عِرْضَ امرئٍ كان نالهُ","بسوء وإن لامتْهُ فيه اللوائمُ",17,"م",1,0],["ولا وجدتُ الظلمَ كان مني","ولن يغيب غائبٌ عن جني",18,"ن",2,0],["ولا واللَّه ما حَبَّرتُ فيكم","سِوى مَدْحٍ يُزَيِّنُ لا بسيه",19,"ي",2,0],["وَلا وَجَدوا أُمّاً لَهُ عَرَبِيَّةً","وَلا أَسهَرَتها مِن خِتانٍ كُلومُها",20,"م",3,0],["وَلا وَجهُها شَمس وَلا شَعرُها دُجىً","وَلا صَدُّها حَر وَلا وَصلُها بَردُ",21,"د",1,0],["وَلا وَقى لَكَ نَفساً","وَلا أَقالَكَ عَثرَه",22,"ر",2,0],["ولا وجدتُ اكتئابي","ولا وجدتُ سُروري",23,"ي",1,0],["ولأوتارِكَ لا تَخْفُقُ إلاَّ شاكِياتْ","ولأنغامِكَ لا تَنْطُقُ إلاَّ باكِياتْ",24,"ت",1,0],["ولا والله ما ملكوا متابا","ولا ملكوا القديم من العقاب",25,"ب",1,0],["ولا ووجهك لم أكره تعدّدهم","فأغنهم ثم هبهم لي بلا عدد",26,"د",1,0],["وَلا وَاللَهِ ما كَلَّف","تَ مَحجوباً وَلا بارَه",27,"ر",2,0],["وَلا وَاللَهِ وَالرُسلِ الكِرامِ","وَبَيتِكَ خَيرُ بَيتٍ في الأَنامِ",28,"ا",2,0],["ولا والثنايا الغُرِّ مِنْ فِيكِ إنَّها","لكالغَيثِ أَدَّتْهُ أَكُفُّ السّحائبِ",29,"ب",1,0],["وَلا وَقَفتُ بِجِسمٍ مُسيَ ثالِثَةٍ","ذي أَرسُمٍ دُرُسٍ في الأَرسُمِ الدُرُسِ",30,"س",1,0],["وَلا واحِداً في ذا الوَرى مِن جَماعَةٍ","وَلا البَعضُ مِن كُلٍّ وَلَكِنَّكَ الضِعفُ",31,"ف",1,0],["ولا والذي عافاكمُ وابتلى بكمْ","فؤاديَ ما اجتازَ السُّلوُّ بِبالي",32,"ي",1,0],["ولا واللّهِ ما بي من سكُونٍ","إِذا ما كنتَ لا تقوى حَرَاكا",33,"ك",2,0],["ولا وقفتي الحادثاتُ تبلُّداً","وكيف اتساعُ الخطوِ والقيدُ مكروبُ",34,"ب",1,0],["وَلا واصِلٌ مَن غابَ عَنّي نَسيتُهُ","وَإِن وَصَلَ الإِخوانُ كافَأتُ بِالصَدِّ",35,"د",1,0],["وَلا وَأَلَ المَشكوكُ فيهِ وَلا نَجا","مِنَ السَيفِ ناضي السَيفِ غَدراً وَشاهِرُه",36,"ر",2,0],["ولا وِصْلَ إلا أن أروحَ مُغَرِّراً","بأدهمَ في تَيَّارِ أخضرَ مُزبِدِ",37,"د",1,0],["ولا وصْلَ إلا أن تَبيتَ أكُفُّنا","ركائبَ تُزْجي من مُدامتِنا رَكْبا",38,"ب",2,0],["وَلا وَاللَهِ لا يَنقُ","ضُ إِلّا زِدتُهُ نَقضا",39,"ض",2,0],["وَلا وادي جَهَنَّمَ حينَ حَلَّوا","بِهِ أَمسى عَليهِم شَرَّ فالِ",40,"ل",1,0],["ولا وَرَدوا من مائها حَسْوَ طائرٍ","يُبَلّ بهِ منهُ إِذا يَبِس السَّحْرُ",41,"ر",1,0],["وَلا وَأَبِي مَا النَّصْلُ فِي الْفِعْلِ كَالْعَصَا","وَلا الْقَوْسُ مَلآنَ الْحَقِيبَةِ كَالْخِلْوِ",42,"و",1,0],["وَلا وَاللَّهِ مَا لِي فِي الْ","هَوَى ذَنْبٌ فَأَعْلَمُهُ",43,"م",2,0],["ولا وجهُهُ صبحٌ ولا شعرُهُ دجى","ولا قدُّهُ غصنٌ ولا ريقُهُ خمرُ",44,"ر",1,0],["وَلا وَجِدَ العُذرِيُّ عُروَةُ إِذ قَضى","كَوَجدي وَلا مَن كانَ قَبلي وَلا بَعدي",45,"د",2,0],["وَلا وَاللَه نَرضى الخسفَ دِيناً","كَدأبِ المُستَذَلِّ المُستَضامِ",46,"م",1,0],["وَلا وَاللَهِ ما بِي بُغ","ضُهُ يا صاحِ أُخفِيهِ",47,"ي",2,0],["وَلا وَصْفَ إِلَّا أنْ يَكُونَ لِواصِفٍ","وُرُودٌ عَلَى مَوْصُوفِهِ وصُدُورُ",48,"ر",1,0],["وَلا وَاللَهِ لا وَاللَ","هِ لا وَاللَهِ لا أَقصِر",49,"ر",1,0],["وَلا وَاللَهِ لا أَدري","أَرومُ الوَصلَ أَم هَجرا",50,"ر",2,0],["وَلا وَاللَهِ ما يَصبِ","رُ في البَرِّيَّةِ الحوتُ",51,"ت",1,0],["وَلا وَاللَهِ لَو حَمَّلِ","تِني سِرَّكِ ما خُنتُه",52,"ت",2,0],["وَلا وَاللَهِ ما في الشَر","قِ مِن أُنثى وَلا الغَربِ",53,"ب",1,0],["وَلا وَردُ غابٍ لَهُ حُلَّةٌ","مِنَ الدَمِ في الغيلِ وَردِيَّه",54,"د",3,0],["ولا وَضَعَت إليَّ عَلَى خَلاَءٍ","حَصَانٌ يومَ جِلوتَها قِناعا",55,"ع",2,0],["وَلا وَحِفَاظِكَ وَهْوَ الْيَمِي","نُ مَا حُلْتُ عَنْ عَهْدِكُمْ إِصْبَعَا",56,"ع",2,0],["وَلا وَرَبِّكَ مَا وَجْدِي بِمُنْدَرِسٍ","عَلَى البِعَادِ وَلا صَبْرِي بِمِطْوَاعِ",57,"ع",1,0],["وَلا وَصْفَ إِلاَّ أَنْ يُمَثِّلَ حَالَةً","مِنَ النَّفْسِ لَمْ تَبْلُغْ بَدِيهَةَ بَادِهِ",58,"د",2,0],["وَلا وَاللَهِ ما أَصبَح","تُ في ذَلِكَ مُرتابا",59,"ب",2,0],["ولا وعت إذن كترتيلها","ولا رواها بلبلٌ في غناهْ",60,"ا",2,0],["وَلِأَوقاتٍ ثَلاثَةٍ اِهتَج","بُكرَة أَو ظُهُرٍ أَو عَشِيِّ",61,"ي",1,0],["ولا وأبيك ما ظلمت قريعٌ","ولا برموا بذاك ولا أساءوا",62,"ا",1,0],["ولا وأبيك ما ظلمت قريعٌ","بِعَثْرَة ِ جَارِهم أنْ يَنْعَشُوها",63,"ا",1,0],["وَ لأوردنَّ الخيلَ بطنَ أراكة ٍ","وَ لأقضينَّ بفعل ذاكَ ديوني",64,"ن",2,0],["ولا واسمٌ عِرْضَ امرىء كان نالهُ","بسوء وإنْ لامتْهُ فيه اللوائمُ",65,"م",1,0],["ولأولَى بأن يَهنئك النا سُ ضياعٌ","حفظْتها الرِّعاءُ من أن تضاعا",66,"ع",2,0],["ولا وَمِد الظل ولا وَبيِّهِ","مكِّيّ بين المَجْدِ أخشبيِّه",67,"ب",3,0],["وَلا وَضَعَت يَدايَ عَنانَ طِرفٍ","وَلا أَبصَرتُ مِن شَمسٍ شُعاعا",68,"ع",2,0],["ولا وَردَ إلاّ ما حَوت وَجَناتُها","ولا غيرُ منظومِ الثّغور أَقاحُ",69,"ح",1,0],["ولا وَصلَ يُتَاحُ اليَومَ إِلاَّ","خَيَالاتٍ وإِلاَّ الطيف يَسرِى",70,"ر",2,0],["وَلا وَاللَهِ يا سَلما","يَ ما بِالحُبِّ مِن باسِ",71,"س",1,0],["وَلا وَاللَهِ لا أَنسى حَياتي","وِثاقَ البابِ دوني وَاِطِّراحي",72,"ي",1,0],["وَلا وَاللَهِ لا يَصبِ","رُ في الدَيمومَةِ الحوتُ",73,"ت",1,0],["ولا واللهِ ما قارفتُ ذنباً","ولا جدَّت يدِى للنصح حَبلا",74,"ل",2,0],["وَلا وُدُّ مَن أَبدى لَكَ الوُدَّ صادِقٌ","وَما هُوَ إِلّا خُدعَةٌ مِن مُخادِعِ",75,"ع",1,0],["وَلا وَاِعتِزامِكَ لا رُوِّعَت","بِتِلكَ البَهائِمِ هَذي البُهَم",76,"م",1,0],["وَلا وَمَن بَرَأَ الأَشياءَ ما وَجَدَت","كَوَجدِنا العيسُ بَل رَقَّت لِشَكوانا",77,"ن",2,0],["وَلا وَنَيتُم إِلى أَن قامَ ماؤُهُم","وَخانَ دَلوَهُمُ مِن عَقدِها الكَرَبُ",78,"ب",1,0],["وَلا وَاللَهِ ما بِدُخُولِ مِثلي","عَلَيكَ يَفُوتُ أَهلَ الذَنبِ ذَحلُ",79,"ل",1,0],["ولا وطنٌ ولا دار وكرم","ولا زرع بسبخ أو دوالي",80,"ي",1,0],["وَلا وَاللَهِ ما اِجتَمَعَت ثَلاثٌ","فِراقُهُم وَجَفني وَالرُقادُ",81,"د",1,0],["ولا وسبيل اللهِ ما أنا آخذٌ","بعذلٍ ولا نهجَ الهوى أنا تارك",82,"ك",1,0],["ولا واللّه ما قلبي","لكم ناسٍ ولا قالي",83,"ل",2,0],["ولا ومَن أسأله راجياً","منه العُلا والعزَّ والنصرا",84,"ر",2,0],["وَلا وَطِئَت غَيرُ الخُطوبِ لَكُم حِمىً","وَلا بَدَّدَت غَيرُ اللَيالي لَكُم شَملا",85,"ل",2,0],["وَلا وَصَفتُ قَبيحاً مِن فِعالِهِمُ","إِلّا وَعِندَهُمُ بي فَوقَ ما أَصِفُ",86,"ف",1,0],["وَلاؤُهُمُ لِلمُذنِبينَ وَسيلَةٌ","فَلولاهُمُ ما حُطَّ عَن مُذنِبٍ وِزرُ",87,"ر",1,0],["وَلا وَدّعُوا يَومَ النوَى جارَةَ الحِمَى","وَلا أَطمَعُونِي فِي الوُصولِ إِلَى دَعدِ",88,"د",1,1],["وَلا والْقَوافِي السّائِراتِ إِذا غَلَتْ","بِحُكْمِ النَّدى عِنْدَ الْكِرامِ مُهُورُها",89,"ر",3,0],["وَلا وَأَبِي الْعُلَى ما قَلَّ نَيْلٌ","بِنَيْلِ أَقَلِّهِ غَنِيَ الْفَقِيرُ",90,"ر",1,0],["وَلا واللَهِ لا أَرجو ليُسري","وَعُسري غيرَ من أَغنى وأَقنى",91,"ن",2,0],["ولا ومن فيه وفى وزنه","إذا أنت حققت عمداً سوى",92,"و",2,0],["وَلا وَرَعٌ لَدَيهِ وَلا وَفاءٌ","وَلا الإِصغاءُ نَحوَ الإِتِّعاظِ",93,"ظ",1,0],["وَلا وَفاءَ وَلا أَدري لَهُ سَبَباً","إِلّا إِذا كانَ سوءَ الحَظِّ أَغراكا",94,"ك",2,0],["وَلا وَجَدَتْ رِيحَ الأَبازِيِرِ لا وَلا","رَأَتْ عينُها لِلمِلْحِ عَيْناً ولا أَثْرا",95,"ر",2,0],["وَلا وَفي بِالعَهدِ لِلَّهِ مَن","وافَقَ غَدّاراً عَلى غَدرِه",96,"ر",2,0],["وَلا وَما مِنكَ لي قَد راحَ نافِلَةً","لَم أَلقَ فيكَ المَنايا غَيرَ بَشّاشِ",97,"ش",1,0],["وَلا وَوِلاكُم لَم أَجِد مِنهُ خالِياً","وَيَستُرُهُ عَمّا لَكُم عِندَهُ الجَهلُ",98,"ل",1,0],["وَلا واجِداً بِالعَقلِ باطِنَ حُسنِكُم","وَكَيفَ يُرى بِالعَقلِ مَن سَرَّهُ العَقلُ",98,"ل",1,0],["وَلا وَبَردٍ حَمى صَدري بِمَشرَبِهِ","ما زاغَ قَلبي عَنهُ في تَقَلُّبِهِ",99,"ه",1,0],["وَلا واواً كواو الصدغ عطفاً","وَلا أَلفاً كَغُصن القدّ لينا",100,"ن",2,0],["وَلا وَقّافَةٌ وَالخَيلُ تَردي","وَلا خالٍ كَأُنبوبِ اليَراعِ",101,"ع",1,0],["ولا واللهِ ما حِفْظي لعَهْدٍ","مَرامٌ أستَحِقُّ به مَلاما",102,"م",2,0],["ولا والّذي يُبقِيك للمجدِ والعُلا","مدَى الدَّهْرِ ما هَبّتْ صَباً وقَبول",103,"ل",1,0],["ولا وأَبي الغوادي ما أَراها","تُرقرِقُ أَيضاً الماءَ المُراقا",104,"ق",2,0],["وَلاؤك أوفَى أبٍ لامْرىءٍ","فَخاراً إذا ما إليه اعتَزى",105,"ا",1,0],["وَلا وَأَبيكِ أُجري دَمعَ جَفنٍ","فَما أجريتُ غَيرَ دَمِ الوَريدِ",106,"د",1,0],["وَلا واعِدٌ يَومي وَلا مُنجِزٌ غَدى","وَلا مُنجِحٌ أَمسي وَلا راحِمٌ صَبري",107,"ي",1,0],["ولاؤكَ خيرُ ما تحتَ الضمير","وأنفسُ ما تمكَّن في الصدورِ",108,"ر",1,1],["وَلا وَصل حَتّى بِأَذن اللَه بِاللُقا","لُمستسلم راحَ الزَمان يُحارِبَه",109,"ب",2,0],["ولا وسيلة ولا حيله سوى محض طول","رباك غذاك بقل لك فنون البقول",110,"ل",1,0],["ولا واللهِ ما بي خوفُ فَقْرٍ","ولكِن كَيفَ أَصْنَعُ بالحقوقِ",111,"ق",1,0],["ولا وسيلة لي أُدْلي إليك بها","إلا رَجائي وتعويلي على كرمِكْ",112,"ك",1,0],["ولا وطئت رجلاه منزل ظالم","ولا مال يوماً للمناصب والنصب",113,"ب",1,0],["ولاَ ومَن يعلمَ الأسرارَ حِلْفَةَ من","يَبَرُّ فيما أتَى إن قَال أو حَلَفَا",114,"ف",2,0],["ولا واللّهِ ما أضمرتُ غدْراً","كما قد أظهَروهُ ولا نَويتُ",115,"ت",1,0],["ولاَ وَمَن أَشْربَ قَلبي لَهُم","حُبّاً جَرى من حَيثُ يَجري الدّمُ",116,"م",1,0],["ولا وَزَرٌ مما قضى الله عاصم","ولا يتّقى منه بدرع ومغفر",117,"ر",1,0],["ولا وَطِئَتْ لِلْكُفْرِ أَرْضاً وإِنْ نَأَى","بِهَا الغَوْلُ إِلّا مَسَّها مِنْهُمُ قَرْحُ",118,"ح",1,0],["ولا وُقِيَ الإِشراكُ مَا مِنْكَ يُتَّقى","ولا عَدِمَ الإِسلامُ مَا منكَ يرجُوهُ",119,"و",2,0],["ولا وَزَرٌ إِلّا وزيرٌ لَهُ يدٌ","تُمِلُّ عَلَى أَيْدِي الربيع فيَسْتَمْلِي",120,"ل",2,0],["ولا وصول للسما","ء قبل يوم النفخة",121,"ه",1,0],["ولا وصفت بغير العقل أبذله","وعظا وفلسفة في جم أشعاري",122,"ي",1,0],["وَلا وَأبِي العُلَى إن كَا","ن ما سَدَّى كما زَعَما",123,"م",2,0],["ولا ونَى مكاشفاً عدوَّكم","بمدحكم معْ كونه محتشما",124,"م",2,0],["ولا وجدتَ من عدوّ فرصةً","إلا عفوتَ ولو اشتدّ الجُرُمْ",125,"م",1,0],["ولا وجه إلا وهو عنِّيَ معرِضٌ","ولا كفَّ إلا وهو دونيَ مقُفَلُ",126,"ل",1,0],["ولا ومن يُلقِمه","تحتَ اللَّهاةِ الجندلا",127,"ل",2,0],["ولا والمجدِ ما شرَقي بريقي","وشربي الملحَ في العذب الزلالِ",128,"ل",1,0],["ولا ومَن كنّ الردى بأمرهِ","لولا القلوبُ لم يجدنَ مَرشَقا",129,"ق",2,0],["ولا وهواكِ ابنةَ النَّهشَلي","يِ ما زاد في البعد إلا ولوعا",130,"ع",2,0],["ولا ومن أولدهم محمدا","واختاره من غصنهم وأفرعا",131,"ع",2,0],["ولا ورى زنديَ إلا رأيُهُ","أبيضُ منه في الخطوب الغُبسِ",132,"س",1,0],["ولا وزرتَ الخلفاءَ عَرَضاً","بل عن يقينٍ من عليم خابرِ",133,"ر",1,0],["ولا ومُقَبَّلِهِ ما فَرَقْتُ","أريقتُه الخمرُ أم ما أدارا",134,"ر",2,0],["ولا ومَنْ قاد الصِّعابَ لَهُمُ","وأوجدوا الفضلَ بهم وقد فُقدْ",135,"د",1,0],["ولا وَجْدَ إلا دونَ وجدي وقد سرى","مع الصبحِ مِن تلكَ المرابعِ غيدُها",136,"د",3,0],["ولا وجدي ولو أسهبتُ مِمّا","يقومُ بوصفِ أيسرِه اللسانُ",137,"ن",1,0],["ولا والدان أيها الربع فيك قد","قضت أمة والدهر ينسي الفجائعا",138,"ع",2,0],["ولا وَظيفَةٌ تُرى","إِلاَّ الثَّناءَ والدُّعا",139,"ع",2,0],["ولا وأبيك ما عاينت شيئاً","أشد من الفرق على القلوب",140,"ب",1,0],["ولا ولا أنت من رجال إذا ما","عزلوهم بمجدهم مهزول",141,"ل",1,0],["ولاؤك مفروض على كل مسلم","وحبك في الدارين أفضل مغنم",142,"م",1,1],["ولاؤك دين في الرقاب ودين","وودك حصن في المعاد حصين",143,"ن",1,1],["ولا وثقت ظنوني أن سري","لديك وديعة الثقة الأمين",144,"ن",1,0],["وَلا وَصَلوا مِنَ التَقوى","إِلى حَظٍّ كَمَن وَصَلا",145,"ل",2,0],["وَلا وسادَ له إلّا جوارحُه","ولا يمُهِّد إلّا جَلْدَةَ السُّبُلِ",146,"ل",1,0],["ولا وفيٌّ إذا أعطيتُه مِقَتِي","أعطَى المحبّةَ أو تاركتُه تركا",147,"ك",2,0],["ولا وفاءٍ ولا غدرٍ ولا كَلَفٍ","ولا ملالٍ ولا إنجازِ موعودِ",148,"د",1,0],["ولا وَزَرٌ منه بزُرقِ أسنّتِي","ولا بيض أسيافي وسُمرِ صِعادِي",149,"ي",1,0],["ولا وهبتُ وداداً","وسُمتُ مُعطاه ردّا",150,"د",2,0],["ولا وحشة والكون إنس وبهجة","يلذّ من الحادي لركبانه الحدو",151,"و",1,0],["ولا وصفٌ بدا لي قطُّ من ذاتي","ولا نعت ولا حال وشان",152,"ن",1,0],["ولا وضوء ولا اغتسال","إلا وبي ما له خفاء",153,"ا",2,0],["وَلاَ واللَّهِ يا أَحْمَ","دُ ما تَبْتَعُني حَرّهْ",154,"ر",2,0],["وَلا وَاللَه ربّك ما أُبالي","لمن كان العشير من الجزورِ",155,"ر",1,0],["ولا واقع بل إن تلك جمعيها","لواحدة في قيله كالأماثل",156,"ل",1,0]]}