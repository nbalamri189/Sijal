{"poems":[[55,"أمبلغي ما أطلب الغزل","https://www.aldiwan.net/poem29910.html","الكامل"],[65,"وعليلة الألحاظ ترقد عن","https://www.aldiwan.net/poem45900.html","أحذ الكامل"],[53,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[94,"غنني أنشودة الفجر الضحوك","https://www.aldiwan.net/poem38961.html","الرمل"],[87,"محمد ما أخلفتنا ما وعدتنا","https://www.aldiwan.net/poem7775.html","الطويل"],[33,"فجعتنا أم بشر","https://www.aldiwan.net/poem41858.html","مجزوء الرمل"],[83,"أذوت سموم النوى ريحانة الأمل","https://www.aldiwan.net/poem61327.html","البسيط"],[52,"من أبي هشام يا رجال قصيدة","https://www.aldiwan.net/poem64740.html","الكامل"],[52,"ذهب الدهر بسمط وبرا","https://www.aldiwan.net/poem64874.html","البسيط"],[48,"لنفسي إن تنأ عن الجسم روعة","https://www.aldiwan.net/poem22657.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/23993","الطويل"],[33,"فَجَعَتْنَا أُمُّ بِشْرٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19012&r=&rc=275",""],[196,"شرب الوصل دستج الهجر فاستطلق","https://www.aldiwan.net/poem27465.html","الخفيف"],[199,"أطربت أم رفعت لعينك غدوة","https://www.aldiwan.net/poem54404.html","الكامل"],[203,"لا تلوموا إذا تعذبت فيه","https://www.aldiwan.net/poem45614.html","الخفيف"],[228,"حاذر الحب إن في الحب شرا","https://www.aldiwan.net/poem41905.html","الخفيف"],[234,"لو تقصيت وصف شوقي وتوقي","https://www.aldiwan.net/poem50809.html","الخفيف"],[234,"إن تكن قد سلوت يا نور عيني","https://www.aldiwan.net/poem51118.html","الخفيف"],[242,"قل لبينك يا حبيبي ينجلي","https://www.aldiwan.net/poem18864.html","عموديه"],[275,"كنت يا أماه أرعى النجما","https://www.aldiwan.net/poem35229.html","الرمل"],[310,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[343,"أإن فات ما كنت أملته","https://www.aldiwan.net/poem68737.html","المتقارب"],[422,"بارق لاح فأبكاني ابتساما","https://www.aldiwan.net/poem54109.html","الرمل"],[438,"ردوا لها أيامها الأوائلا","https://www.aldiwan.net/poem12388.html","الرجز"],[445,"عمرت بطول بقائك الأعمار","https://www.aldiwan.net/poem34878.html","الكامل"],[447,"حزن يفور ومهجة تتقطع","https://www.aldiwan.net/poem14458.html","الكامل"],[458,"عمر ينقضي برشد وغى","https://www.aldiwan.net/poem61787.html","الخفيف"],[466,"لمن الخيل كأمثال السعالي","https://www.aldiwan.net/poem15101.html","الرمل"],[466,"أيها الناطق الذي شغل الأل","https://www.aldiwan.net/poem15153.html","الخفيف"],[519,"ويا وميض بروق المزن إن سفرت","https://www.aldiwan.net/poem20795.html","البسيط"],[534,"ومن يقل أنا أنا","https://www.aldiwan.net/poem37094.html","مجزوء الرجز"],[534,"إلى متى ذا الهم والغم","https://www.aldiwan.net/poem37147.html","السريع"],[556,"من رأى الأظعان فوق","https://www.aldiwan.net/poem47903.html","مجزوء الرمل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138195",""],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34468","المنسرح"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39157","السريع"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104599","البسيط"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104600","الخفيف"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123396","الكامل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202104","الخفيف"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130631","البسيط"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93107","البسيط"],[1677,"","https://poetry.dctabudhabi.ae/diwan/poem/198592","السريع"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128741","الخفيف"],[2038,"","https://poetry.dctabudhabi.ae/diwan/poem/123686","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53217","المتقارب"],[2249,"","https://poetry.dctabudhabi.ae/diwan/poem/202569","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93602","الوافر"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70346","الرمل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134010","الوافر"],[3110,"","https://poetry.dctabudhabi.ae/diwan/poem/204082","الرمل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130093","الطويل"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/132946","الرمل"],[3631,"","https://poetry.dctabudhabi.ae/diwan/poem/144739","الطويل"],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140258",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91078","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114438","المتقارب"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135490","المديد"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111438","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77141","الطويل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44723","الطويل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78276","الكامل"],[4108,"","https://poetry.dctabudhabi.ae/diwan/poem/206283","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73242","الخفيف"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58102","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139587",""],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204289","الوافر"],[4578,"إلامَ أرجى من زماني التدانيا","https://www.poetsgate.com/ViewPoem.aspx?id=49615",""],[4927,"معاقيل الشهادة","https://www.poetsgate.com/ViewPoem.aspx?id=79608",""],[5145,"أعوز الصبر فهل لي من طريق","https://www.poetsgate.com/ViewPoem.aspx?id=108199",""],[5183,"الحمول","https://www.poetsgate.com/ViewPoem.aspx?id=186488",""],[5323,"الأمر لله","https://www.poetsgate.com/ViewPoem.aspx?id=207407",""],[5550,"وردةٌ أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=213309",""],[5563,"غنِّ لي عن ذي البنيّة","https://www.poetsgate.com/ViewPoem.aspx?id=213765",""],[5897,"أول الميزان","https://www.poetsgate.com/ViewPoem.aspx?id=157277",""],[5906,"في الحكمة / الإحسان / الخير فطرة","https://www.poetsgate.com/ViewPoem.aspx?id=189958",""],[6075,"بين الذكرى والأمنيات","https://www.poetsgate.com/ViewPoem.aspx?id=213327",""],[6120,"أَنَا لَنْ أَقُوْلَ بِأَنَّنِي مُشْتَاْقٌ","https://www.poetsgate.com/ViewPoem.aspx?id=215367",""],[6152,"وحدكِ من أناديه بروحي","https://www.poetsgate.com/ViewPoem.aspx?id=203275",""]],"verses":[["فَفُؤادُهُ حَنِقٌ عَلَيكَ وَإِن","طاطا وَذَلَّلَهُ لَكَ الوَجَلُ",0,"ل",1,0],["فَفُؤادُهُ كِسوارِهَا حَرِجٌ","وَوِسادُهُ كوِشَاحِها قَلِقُ",1,"ق",1,0],["ففوَّزَ اللص حتى قاد من معه","وكلُّ مالٍ إذا ضيعته سافا",2,"ف",2,0],["فَفُؤادِي وهوَ مَغْمُورُ الجِرَاحْ","بتَبَارِيحِ الحَيَاةِ البَاكِيَهْ",3,"ه",1,0],["ففوق عليم القوم منك معلِّم","وفوق وزير القوم منك وزير",4,"ر",1,0],["فَفُؤادي مِن هَواها","هائِمٌ أُخرى اللَيالي",5,"ل",2,0],["فَفَوقَ عِطفِي وَفي أنفِي لَهُ وَيَدِي","جَنيٌ وَعَرف وَظِلُّ غَيرُ مُنتَقِلِ",6,"ل",1,0],["فَفُؤادُهُ طُرّاً يَعيشُ بِذِكرِها","وَيَموتُ حينَ تُطِلُّهُ الزَفَراتُ",7,"ت",1,0],["فَفُؤادي كَجَناحَي طائِرٍ","مِن غَدٍ لا بُدَّ مِن مُرِّ القَضا",8,"ا",1,0],["فَفوزوا بِنُسكٍ في الحَياةِ وَثَبِّتوا","لِأَقدامِكُم في الأَرضِ قَبلَ اِنهِيارَها",9,"ر",3,0],["فَفُؤادُهُا يَقِظٌ لَهُ فَرَحٌ بِهِ","وَبِفَرْقَدَيْهِ مِنْ أَبَرِّ سَمَاءِ",10,"ا",2,0],["ففوِّق قِداحي واهدِها بنصالها","وريِّش ورعِّظ لا عدمتُك راعظا",11,"ظ",2,0],["ففؤادي في هواها","هائمٌ أخرى الليالي",12,"ل",2,0],["فَفُؤادُ الحَبيبِ يَنحَلَهُ السَ","لُ وَقَلبي مُعَذَّبٌ بِالمَلال",13,"ل",1,0],["فَفُؤادُهُ رَهنٌ لَها بِمَوَدَّةٍ","وَرَهينُهُنَّ مُعَذَّبٌ مَكبولُ",14,"ل",1,0],["ففؤادي وإن طالَ عذابي","ليسَ يلقى النعبمَ إلا لديهِ",15,"ي",2,0],["فَفُؤادي قَفرٌ بِغَير هِيامي","وَحَياتي بِغَير حُبِّيَ قَفرا",16,"ر",2,0],["ففؤادي إذا صَمَتُّ نَطُوقٌ","ولساني إذا نَطقتُ حُسامُ",17,"م",1,0],["ففؤادي كما عهِدتَ عَميدٌ","وجفوني بدمْعِهِنّ تَجودُ",18,"د",1,0],["فَفُؤَادِي مِنْ نُزُوحِكَ مُصْعِدٌ","فِي مَفَاوِزِ شِدَّةٍ وَتَمَلْمُلِ",19,"ل",1,0],["ففُؤادي بشعاعٍ عالقٌ","خافقٌ مابين أرضٍ وسما",20,"م",2,0],["فَفوقَ طورِ النهى قدرُ النبيِّ علا","وَالقول يقصُرُ عمّا ليس ينفهمُ",21,"م",1,0],["فَفَوِّض إِلى اللَهِ كُلَّ الأُمورِ","فَلَيسَ يَكونُ سِوى ما صَنَع",22,"ع",1,0],["ففؤادي والجوى في صبوتي","لا يَمَلاَّن جدالاً وخصاما",23,"م",2,0],["فَفَوْقَهَا كُلُّ قتيلِ صَبْوَةٍ","يَهْوِي وهَلْ يَهْوَى القتيلُ القاتلا",24,"ل",2,0],["ففُؤادُهُ من ذُعْرِ سيفكَ طائرٌ","طَوْراً ومن عَجلٍ إِليكَ مُطارُ",25,"ر",1,0],["ففؤاده أصل الأصول وذهنه","فرع الأصول به الفروع تفرع",26,"ع",1,0],["ففؤادىِ مازال يبكى على قو","مي كحال اليهو والمبكىّ",27,"ك",2,0],["ففؤادي من أذى مصركُم","شارةٌ أودى بها كرُّ النبال",28,"ل",1,0],["ففؤادي من الجوى في زفيرٍ","ودموعي من الأسى في انْسكابِ",29,"ب",1,0],["ففوّقَ القوسُ نبلَ العين وا حزَني","وقاربَ العقرَبُ المِرّيخَ وا حذَري",30,"ر",2,0],["فَفَوِّضِ الأُمُورَا","ولاتَكُنْ مَغْرورَا",31,"ر",2,0],["فَفَوِّضِ الأَمْرَ وكُنْ واثِقاً","بِمَنْ لَهُ التَّدْبِيرُ والعِلْمُ",32,"م",1,0],["ففؤادِي بعد أن بِن","نَ كما شِئْنَ قَريحُ",33,"ح",1,0],["ففوض الأمر إليهم أجمعه","لن يكونوا إن عصوه في سعة",34,"ه",1,0],["ففؤاد أظهرهها بأجلى مظهر","مُدحت به من بعد طول هجاء",35,"ا",2,0],["فَفوَّقَ السَهمَ مِن لَواحِظِهِ","واِنقَوَسَ الحاجِبانِ واِقتَرَنا",36,"ن",2,0],["فَفوِّضِ الأمْرَ لِتَدْبِيرهِ","مُرتَضِياً مِنهْ بما حُقَّ لَكْ",37,"ك",1,0],["ففوّقَ السّحرُ من انسانِ مُقلتِها","سهماً مصيباً فلا ينفكُّ يَرميني",38,"ن",2,0],["ففؤادي باللَّحظِ والخدِّ منه","بينَ سهمٍ جانٍ ووردٍ جنيِّ",39,"ي",1,0],["ففؤادي منه في تيّ","ار أفكاري غَريقُ",40,"ق",1,0],["ففؤادي مَنْ لاذ منه فؤادي","بولاءٍ يكون في الحَشْر زَادِي",41,"د",2,0],["ففوق بأسك ما يقضي الزمان به","وفوق حكمك ما تقضي به الحكم",42,"م",1,0],["ففوق البين سهم الحادثات له","صمداً فأصمى حشاه عن يد القدر",43,"ر",1,0],["ففوّق السهم ولم يخطني","وإذ رآني ميّتاً أعجبه",44,"ب",2,0],["ففؤآدي قد بان مذ بنت عني","وهو اني خطفت كالبرق خاطف",45,"ف",1,0],["ففؤادي بحبه ذو امتزاج","وبه عنبر المحبة فاحا",46,"ح",2,0],["ففوق الأسرى سامي القباب خصي","ب الجناب رحيب الفنا",47,"ن",2,0],["ففؤاده شعرات فودي ثمّ لم","ما حلنَ حال فما بقينَ ولا بقي",48,"ق",2,0],["فَفوقك لَو علمت أَخو سفار","يَروح في مراعسة المَسير",49,"ر",1,0],["ففوَّض الأمر إلى السلطانِ","وسار في قوم من الشجعانِ",50,"ن",1,0],["ففوَّض الأمر إلى بيبرسِ","الظاهر الجالس فوق الكرسي",50,"ي",1,0],["ففؤادي بين شوقي","وغرامي يتقلى",51,"ل",2,0],["ففوزا بالبنين على رفاء","ودوما فيه ازماناً مديده",52,"د",2,0],["ففؤادي قرح من قولها","ما من الأدواء داء كالعمى",53,"ا",1,0],["ففوزيّة الحَسنا تبشّر بالعُلا","وبالفوز مَقروناً بعزٍّ وغبطةِ",54,"ه",1,0],["ففؤادي أبداً رَهنُ هَوَى","ورِدائي أبداً رَهنُ عُقَار",55,"ر",1,0],["ففؤادي مِنْ ذِكر قَوْمي حَزينٌ","ودموعي على الذُرى سُجَّامُ",56,"م",1,0],["ففؤادي في هواكم مفتتن","وحشائي ذابه حر الأنين",57,"ن",1,0],["فَفُؤاده بِكَ واثق وَلِسانُه","لَكَ مادحٌ وَرجاه أَمّ الساحا",58,"ح",2,0],["ففوقَ لي سهمَ ألحاظِهِ","فقلتُ له العبدُ فيما جنى",59,"ن",2,0],["ففؤادي ضاء ليلاً","بشموسٍ وافراتِ",60,"ت",1,0],["فَفوسيذُ بَينَهُمُ اِندَفَقا","يَحُثُّهُمُ فِرَقاً فِرَقا",61,"ق",2,0],["فَفَوقَ مذَابحي أَبداً أَقامُوا","ذَبائِحهُم مُشَرَّبةً مُداما",62,"م",2,0],["فَفَوقَ رَأسِ البَيضَةِ الرُمحُ وَقَح","لَكِنَّما الفُولاذُ فولاذاً دَفَع",63,"ع",1,0],["ففوراً لجمع النبال انبرت","عن الأرض من حيث قد نثرت",64,"ت",1,0],["ففوسيذ مهما كان من نزعاته","لأذعن وانقاد انقياد الموافق",65,"ق",1,0],["ففوسيذ في بطن العباب قد التجا","ومن نار غيظي في حزازته نجا",65,"ج",2,0],["فَفَوَّضَ لِلَّهِ المُهَيمِن أَمرُهُ","وَعاذَ بِرَبِّ الناسِ مِن شَرِّ ذي حِقدِ",66,"د",1,0],["فَفوِّض إِلى الرَّب الحَكيمِ أَمورَكُم","فَلا يَكسَبُ الإِنسانُ نَفعاً وَلا ضَرّا",67,"ر",2,0],["فَفُؤاده كَالصَلدِ اِلّا أَنَّهُ","تَزهو مَحاسِنَهُ بِروض السُندُس",68,"س",1,0],["ففؤادُ ذي الجأشِ الربيطِ مخافةً","يحكي جناحَ الطائرِ المُترَفْرِفِ",69,"ف",1,0],["ففُؤادي دامٍ وَدَمعِي هامٍ","وَسَقامي نَام وقَلبي مُوَلَّه",70,"ل",2,0],["ففَوْقَ حكمكَ حكمٌ لا مَرَدَّ لهُ","يوماً به تُوزَنُ الأفعَالُ والعَمَلُ",71,"ل",1,0],["ففؤادي من الخطايا شظايا","وجفوني من