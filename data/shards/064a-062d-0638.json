{"poems":[[95,"بالعلم يدرك أقصى المجد من أمم","https://www.aldiwan.net/poem11392.html","البسيط"],[53,"يا طول غلة نفسي المبلاه","https://www.aldiwan.net/poem66717.html","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43730","المجتث"],[189,"لقيت في الحب ما لاقاه من هممى","https://www.aldiwan.net/poem14659.html","البسيط"],[237,"لا والربيع النضير","https://www.aldiwan.net/poem14730.html","المجتث"],[385,"بلغ النوى مني مناه","https://www.aldiwan.net/poem48812.html","مجزوء الكامل"],[942,"","https://poetry.dctabudhabi.ae/diwan/poem/123698","الكامل"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/44793","السريع"],[1065,"","https://poetry.dctabudhabi.ae/diwan/poem/177914","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46529","الرجز"],[1378,"","https://poetry.dctabudhabi.ae/diwan/poem/216840",""],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95537","الكامل"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202169","الكامل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102129","الرجز"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102127","المجتث"],[2176,"","https://poetry.dctabudhabi.ae/diwan/poem/69494","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88977","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62866","الكامل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119391","الرجز"],[4047,"","https://poetry.dctabudhabi.ae/diwan/poem/144066","الرجز"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81719","الكامل"],[5431,"استنساخ!","https://www.poetsgate.com/ViewPoem.aspx?id=202923",""],[5442,"غنى بذكر الحمى فارتاح كل شجى","https://www.poetsgate.com/ViewPoem.aspx?id=114774",""]],"verses":[["يَحْظَى أُولُو الْبَذْلِ إِنْ تَحْسُنْ مَقَاصِدُهُم","بِالبَاقِيَاتَ مِنَ الآلاءِ وَالنِّعَمِ",0,"م",1,0],["يَحْظَى العميدُ بها ويَسْعد راقداً","ويظَلُّ عند النُّبْهِ في إذلاه",1,"ه",1,0],["يَحظى بِكَ السَمعُ فَاِسمَح","بدرّ فيك لِحاظِ",2,"ظ",1,1],["يَحْظَى اللبيبُ بما يَشْقى الجهولُ به","كفاصدِ العرقِ يَبْغِى البُرْءِ بالألم",3,"م",1,0],["يَحظى بِنَيلِ الأَماني","مُنادِمي وَسَميري",4,"ر",2,0],["يَحظى بِهِ القَلب المُشو","ق وَمُقلَتي لَيسَت تَراهُ",5,"ا",2,0],["يحظى بصرف همومه في ضمنها","من يصرف الدينار في لذاته",6,"ت",2,0],["يَحظى بِهِ الكَذّابُ بِالمُشتَهى","وَالتَعسُ لِلمُخلِصِ وَالصادِقِ",7,"ق",1,0],["يحظى به غيري وأحرم وده","وسواي يروى بالوصال وأظمأ",8,"ا",1,0],["يَحظى بِها الجُهال","وَتَنعم الأَنذال",9,"ل",1,0],["يِحظى بفِنيالٍ مخَمّس","ومقَنّد بهالَه ومَسكور",10,"ر",1,0],["يحظى الرقُّى بك الدهورَ مُباهياً","ويفوق شعري فيك عقد جِمانِ",11,"ن",1,0],["يَحْظى مُجالِسُه بأَشرفِ رُتَبةٍ","ما بين عِزِّ عُلى وخِصْب مَراعِ",12,"ع",1,0],["يحظيكُم أماني","سبحانك اللَهُ",13,"ه",1,0],["يُحظيهمُ نورهُ","صَلَّينا عليه",14,"ل",3,0],["يَحظُنُني أَن أَطفتُما بي","وَلَم تَنالا سِوى الكَلامِ",15,"م",1,0],["يحظى بها كفن ويحرم ناظري","فهما وقبر ضمها خصماء",16,"ا",2,0],["يحْظَى بنَيلكم البعيدُ ولا أَرى","قُربى يُقرّبُ انَّ ذا لَعُقُوْقُ",17,"ق",1,0],["يحظى بيه الشارب في","النادي ومن لم يشرب",18,"ب",1,0],["يحظى بما قدّمه","وهمّه ما خلّفَهْ",19,"ف",2,0],["يحظى السَّعيدُ به بطولِ سعادةٍ","وأخو الشَّقاوةِ للشَّقاوةِ يُنْقَلُ",20,"ل",1,0],["يحظى بنسخته الأخيرة دائما","وأنا أنا روحٌ لها إذْ أُنفخُ",21,"خ",1,0],["يحظى بكل نعيم وافر وندا","في ظل ذاك المقام الرحب مندمج",22,"ج",1,0]]}