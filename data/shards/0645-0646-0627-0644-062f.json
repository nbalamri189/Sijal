{"poems":[[57,"من الدنف الذي يمسي حزينا","https://www.aldiwan.net/poem26500.html","الوافر"],[80,"أما لانسكاب الدمع في الخد راحة","https://www.aldiwan.net/poem14228.html","الطويل"],[34,"حلفت لكيما تعلميني أصادقا","https://www.aldiwan.net/poem27789.html","الطويل"],[77,"ألا أيها الوادي المقدس بالندى","https://www.aldiwan.net/poem69025.html","البسيط"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29335","الطويل"],[108,"ماذا سنخسر؟","https://www.poetsgate.com/ViewPoem.aspx?id=179773",""],[164,"على من بالهدى يا ابن الإمامه","https://www.aldiwan.net/poem59206.html","الوافر"],[186,"من آل دلال كريمة معشر","https://www.aldiwan.net/poem61127.html","الكامل"],[186,"من آل دباس الكرام كريم","https://www.aldiwan.net/poem61156.html","الكامل"],[203,"يا للهوى والغزل","https://www.aldiwan.net/poem45354.html","مجزوء الرجز"],[264,"غب دعاء عاطر","https://www.aldiwan.net/poem35755.html","مجزوء الرجز"],[275,"أفق فالديك قد صدحا","https://www.aldiwan.net/poem35294.html","مجزوء الوافر"],[280,"ظهيراك التوكل والمضاء","https://www.aldiwan.net/poem25645.html","الوافر"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[361,"مضت غرة والحمد للّه في أخرى","https://www.aldiwan.net/poem24533.html","الطويل"],[369,"جمال ولكن أين منك جميل","https://www.aldiwan.net/poem60800.html","الخفيف"],[369,"ألم يأن يا صاح أم قد أنى","https://www.aldiwan.net/poem61009.html","المتقارب"],[463,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[509,"حلت حين ما حلت على المصايب","https://www.aldiwan.net/poem38413.html","الطويل"],[519,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[566,"جاري لا تستنكري عذيري","https://www.aldiwan.net/poem27842.html","الرجز"],[581,"من الدارميين الذين دماؤهم","https://www.aldiwan.net/poem1811.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83317","الطويل"],[788,"","https://poetry.dctabudhabi.ae/diwan/poem/206084","الطويل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35407","الوافر"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18485","الرجز"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21671","المتقارب"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80064","المتقارب"],[1586,"","https://poetry.dctabudhabi.ae/diwan/poem/96325","الطويل"],[2071,"","https://poetry.dctabudhabi.ae/diwan/poem/122418","الطويل"],[2074,"","https://poetry.dctabudhabi.ae/diwan/poem/33094","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87327","الرجز"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3245,"","https://poetry.dctabudhabi.ae/diwan/poem/143683","الرجز"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121339","البسيط"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97877","الوافر"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66363","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70128","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127272","السريع"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104894","المتقارب"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120463","الوافر"],[4869,"بحر الصداقه","https://www.poetsgate.com/ViewPoem.aspx?id=151708",""],[592,"تلألأ نور الحق في الخلق واستما","https://www.poetsgate.com/ViewPoem.aspx?id=128815",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[709,"أَتُنْكِرُ بَأْسَ أَحْدَاقِ الْعَذَارَى","https://www.poetsgate.com/ViewPoem.aspx?id=2929",""],[5725,"ترنيمة ام الربيعين","https://www.poetsgate.com/ViewPoem.aspx?id=183386",""],[5894,"مليكة حسن قد أتتنا بصارم","https://www.poetsgate.com/ViewPoem.aspx?id=131433",""],[192,"تعبت","https://www.poetsgate.com/ViewPoem.aspx?id=16345",""],[5956,"سلامة رِجْلِ حبيب العبادِ","https://www.poetsgate.com/ViewPoem.aspx?id=193101",""],[5956,"سلامة مَجدي حبيبِ العبادِ","https://www.poetsgate.com/ViewPoem.aspx?id=194219",""],[5956,"تصدُّ النفسُ","https://www.poetsgate.com/ViewPoem.aspx?id=215870",""],[6260,"يا رجال القلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68348&r=&rc=40",""]],"verses":[["مِنَ الدَنِفِ الَّذي يُمسي حَزيناً","وَبَينَ ضُلوعِهِ قَلبٌ مُصابُ",0,"ب",1,1],["من الدُهمِ أَمّا خلقُها فأساوِدٌ","تَلَوّى وَأَمّا الأَيدُ وَالبَطشُ فالأَسَدُ",1,"د",1,0],["مِنَ الدَهرِ لَو أَخلو بِكُنَّ وَإِنَّما","أُعالِجُ قَلباً طامِحاً حَيثُ يَطمَحُ",2,"ح",1,0],["من الدهم ورد اللون شيبَ بكمتةٍ","كما شيب بالمسك الفتيق خلوق",3,"ق",1,0],["من الدهم رجاف كأن ربابه","جبال الشرى يرمى إليه ويرتمي",4,"م",2,0],["مَنَ الدَّرجات، يا محمودُ، فاسخَر","فماذا -إنْ فقدناها- سنخسَر؟",5,"ر",1,1],["من الدين انسخلت ومن ذويه","علام حصلت بعدهما علامه",6,"م",2,0],["مِن آلِ دَلَّالٍ كَريمةُ مَعشَرٍ","أَدمى النَواظرَ بَينَها وَالأَكبُدا",7,"د",2,1],["مِن آلِ دَبّاسِ الكِرامِ كَريمُ","يَسقي ثَراه المَدمَعُ المَسجومُ",8,"م",1,1],["من الدّمى لا كالدّمى","في حسنها المكتملِ",9,"ل",1,0],["من الدعاء السائر","لقرب ربٍّ ساتر",10,"ر",1,0],["من الدَّهر اغتَنِم فُرَصاً","إذا سَنَحَت وقد سَمَحا",11,"ح",2,0],["مِنَ الدُّهْم السوابق لا لغوب","يُثَبّطُ جَرْيَهُنّ ولا عَناءُ",12,"ا",2,0],["مِنَ الدُروعِ وَعَن عالٍ مِنَ الأَطَمِ","هَذا مُحَمَّدٌ مِن لَذنا بِجانِبِهِ",13,"ه",1,0],["مِنَ الدُنو وَلا مَرقى لِمُستَلِمِ","بَلَغَت أَسنى سَنا بِالعِلمِ جاءَكَ مُذ",13,"ذ",1,0],["من الدائم الحي التحيات اقبلت","تؤمّ محيّاه الكريم به تغرى",14,"ر",2,0],["مَنِ الدَّهْرُ حتّى يَجْسُرَ اليومَ أنّه","إذا قلتَ قولاً ظلَّ عنه يَميل",15,"ل",1,0],["من الدُّررِ الرّائقاتِ الّتي","خلِقْنَ لجِيد المعالي حُلى",16,"ا",1,0],["من الدوحة الغيناء يُضحِك تُربَها","رضاعُ المعالي والترابُ فطيمُ",17,"م",1,0],["من الدهر لا ترحو المنى لفنانه","وما سجن الوجبات السوالب",18,"ب",1,0],["من الدّيباجِ ألبسَها ثِياباً","وصاغَ من النُضارِ لها فِقارا",19,"ر",2,0],["مِنَ الدَبيلِ ناشِطاً لِلدورِ","يَركَبُ كُلَّ عاقِرٍ جُمهورِ",20,"ر",1,0],["مِنَ الدارِمِيِّينَ الَّذينَ دِماؤَهُمُ","شِفاءٌ مِنَ الداءِ المَجَنَّةِ وَالخَبلِ",21,"ل",1,1],["مِنَ الدَهرِ تَشكو أَم عَلى الدَهرِ تَعتَب","وَما صِاحِبُ الأَيّامِ إِلّا مُعَذَّبُ",22,"ب",1,1],["من الدوفا لصمان حتى تنبهت","لها نيط من أهل حوران جثم",23,"م",1,1],["مِنَ الديباجِ راقَ بِصَفحَتَيهِ","خَمائِلُ لُحنَ باكَرَها نَداها",24,"ا",3,0],["من الدوابِ ومن القطانِ","من دعوة الداعي المجاب الداني",25,"ن",2,0],["مِن الدُرِّ يَحفِلُ ياقوتَهُ","كَجَمرِ الغَضا يَتَلَظّى مُجاثا",26,"ث",2,0],["من الدمع محمرَّةٌ أرضه","وسقف السماء به أسودُ",27,"د",1,0],["من الدر والياقوت عن كل حرة","ترى سمطها بين الجمان مثقبا",28,"ب",2,0],["من الدينِ والدنيا جميعاً لك المُنى","وفوقَ المُنى أخلاقُهُ وطبائِعُه",29,"ع",2,0],["مِنَ الدَهاقينَ لَم تُسلِم مَناسِبُها","أَبا نِرارٍ وَقَد جَلَّت عَنِ اليَمَنِ",30,"ن",1,0],["مِنَ الدَّقَل يُرَونَ أو بالصَّحوِ","لأنَّهَا في ذي الطريقِ تَحوي",31,"ي",1,0],["من الدروع وَعَن عال من الأطُم","وَأَسعدُ الناس حظاً في تحبُّبه",32,"ه",1,0],["من الدنو وَلا مرقى لمستنِم","وَفي حظيرة قدس اللَه حَيثُ نُبِذ",32,"ذ",1,0],["من الدِّماءِ مزْجُهُ وصِرْفُه","سِيَّانِ ما قُدّامُهُ وخَلْفُهُ",33,"ف",2,0],["من الديار التي كان الصبا وطري","فيها وكان الهوى العذري من أربي",34,"ي",1,0],["من الدنيا ومن فيها","فهم في بحرها غرقى",35,"ق",2,0],["من الدّمن الأدراس أين أنيسها","عسى عندها ردّ على ذي صدى علا",36,"ل",2,0],["مِن آلِ ديمتري الكَريم كَريمَةً","لابن الكِرام تدبجت بالسندسِ",37,"س",1,1],["من آل دراج ولكنه","قد اغتدى بازا يصيد الحما",38,"م",2,0],["مِن الدُّرُوعِ وعَن عالٍ مِن الاَُطُمِ","شَكَوْتُ دَهْرِي إِلَيهِ في تَقَلُّبِهِ",39,"ه",1,0],["مِن الدُّنُوِّ ولا مَرْقىً لِمُسْتَنِمِ","نُبِّهْتَ لِلقُرْبِ والغَمْرُ الحَسُودُ وُقِذْ",39,"ذ",1,0],["من الدم تشرق أطرافه","بنحر العدى لا بنحر الجزر",40,"ر",1,0],["من الدنيا جرت عبر","بها لاولى النهى عبر",41,"ر",1,1],["من الدنيا ) ويسترنا بستره","ويحفظنا ولايغيّر علينا",42,"ن",2,0],["من الدين والتوحيد والنور والهدى","فليس بها ليس على من تجشما",43,"م",2,0],["من الدعا والعبادات التي شرعت","لا بالوسائط يا من كان حيرانا",44,"ن",2,0],["من الدعوات الصالحات وقد أتى","بذلك نص في الصحيحين مستبد",45,"د",1,0],["مِنَ الدِّبَاجِ أَلْبَسَهَا ثِيَاباً","وصاغَ من النُّضلرِ لها فقارا",46,"ر",2,0],["من الدير القى دموع النسا","على جرس باللقا دندنا",47,"ن",2,0],["من الدر والياقوت باسم ثغرها","بها اللحظ والأجفان حد الجوازم",48,"م",1,0],["من الدنيا أنا مابي سوى عفو العلي التواب","ويحسن خاتمة فعلي ويغفر لي ضلالاتي",49,"ت",2,0],["من الدين حاز جميلَ الصفات","تبارك خالقُ أفضلِ هادِ",50,"د",1,0],["من الدينِ حاز جميلَ الصفاتِ","تبارك خالقُه خيرُ هادِ",51,"د",1,0],["من الدورانِ في أفقٍ","بلا شمسٍ ولا بدرِ",52,"ر",1,0],["من الدم خطوا رؤوس الجبال","وهام الرواسي وكثبانها",53,"ن",3,0]]}