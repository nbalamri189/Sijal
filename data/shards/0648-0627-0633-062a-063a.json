ناة","https://www.poetsgate.com/ViewPoem.aspx?id=185639",""],[5183,"حد الطور","https://www.poetsgate.com/ViewPoem.aspx?id=186609",""],[5183,"صرخة الفحول","https://www.poetsgate.com/ViewPoem.aspx?id=185636",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5186,"ورد الربيع شذا من ربع غسان","https://www.poetsgate.com/ViewPoem.aspx?id=156440",""],[5194,"أقولها لك","https://www.poetsgate.com/ViewPoem.aspx?id=30641",""],[5281,"قانون الصُّحبة","https://www.poetsgate.com/ViewPoem.aspx?id=199349",""],[5281,"ليلة المعراج","https://www.poetsgate.com/ViewPoem.aspx?id=199707",""],[5318,"استغفروا اللهَ عمّا كان من سَفهٍ","https://www.poetsgate.com/ViewPoem.aspx?id=213797",""],[5323,"بارق ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=207293",""],[592,"إلى الله نشكو إننا بمحلة","https://www.poetsgate.com/ViewPoem.aspx?id=128840",""],[592,"سفاسط أملاها الغبي وسطرا","https://www.poetsgate.com/ViewPoem.aspx?id=128722",""],[592,"أكتب ككتبي كما قد كنت أكتبه","https://www.poetsgate.com/ViewPoem.aspx?id=128829",""],[5436,"بغداد/ للشاعر زهير شيخ تراب","https://www.poetsgate.com/ViewPoem.aspx?id=152682",""],[5472,"الى الله من عودتى توبتى","https://www.poetsgate.com/ViewPoem.aspx?id=200466",""],[5582,"ألا غَنِّنا بالعامِرِيَّةِ وَاطْرَبِ","https://www.poetsgate.com/ViewPoem.aspx?id=186673",""],[5582,"هَلْ ذاكَ بَدْرٌ لاحَ تَحْتَ غَمامِ","https://www.poetsgate.com/ViewPoem.aspx?id=63579",""],[5691,"العم سام...!","https://www.poetsgate.com/ViewPoem.aspx?id=207063",""],[5790,"عندي غرام وتبريح وتذكار","https://www.poetsgate.com/ViewPoem.aspx?id=112041",""],[5829,"نفحات السحر","https://www.poetsgate.com/ViewPoem.aspx?id=152736",""],[5845,"لكلِّ خطبٍ مهمٍّ حسبيَ اللهُ","https://www.poetsgate.com/ViewPoem.aspx?id=198425",""],[5953,"طرقتني طوارق مولعات","https://www.poetsgate.com/ViewPoem.aspx?id=93869",""],[6048,"مَا زِلتُ أَهّواهُ !","https://www.poetsgate.com/ViewPoem.aspx?id=198532",""],[6113,"خالد الفيصل","https://www.poetsgate.com/ViewPoem.aspx?id=58846",""]],"verses":[["وَاستَغنِ عَن كُلِّ ذي قُربى وَذي رَحِمٍ","إِنَّ الفَتى الَّذي استَغنى عَنِ الناسِ",0,"س",1,0],["واستغزرَ الأموالَ لا عنَتٌ","فيما يُثَمِّرُهُ ولا غَصبُ",1,"ب",1,0],["وَاستَغفِري لِذُنوبِكِ الرَ","حمَنَ غَفّارَ الذُنوبِ",2,"ب",1,0],["وَاِستَغنِ بِالوَجَباتِ عَن ذَهَبٍ","لَم يَبقَ قَبلَكَ لِاِمرِئٍ ذَهَبُه",3,"ب",2,0],["وَاسْتَغْنِ بِالْوَجَبَاتِ عَنْ ذَهَبٍ","لَمْ يَبْقَ قَبْلَكَ لاِمْرِىء ٍ ذَهَبُهْ",4,"ب",2,0],["وَاِستَغيثوا بِهم إلى اللَّه واِدعوا","وَدَعوا الفاسقينَ والمارقينا",5,"ن",2,0],["وَاِستَغنِ ما أَغناكَ رَبُّكَ بِالغِنى","وَإِذا تُصِبكَ خَصاصَةٌ فَتَجَمَّلِ",6,"ل",1,0],["وَاستَغرَقَت في حُلمٍ مُبهَمِ","فَقالَ لا لا تُعرِضي فَالشَقا",7,"ق",2,0],["وَأَستَغفِرُ اللَه من بُرهَةٍ","منَ العُمرِ لم تَلقَني فيكِ صَبّا",8,"ب",2,0],["وَأَستَغِني غَناءَ السَيفِ يَومَ ال","وَغا بِالفَضلِ عَن غِمدٍ وَجَفنِ",9,"ن",1,0],["وَاسْتَغْفِرِ اللهَ أَنَّ الْعَلِي","يَعُمُّ نَدَاهُ الدَّنِيَّ الْقَلِيلْ",10,"ل",1,0],["وأستَغيث به في كل نائبة","وَما مَلازي في الدارين الا هو",11,"ا",3,0],["واِستغرقَتني الفِكَرُ","حتّى أَتاني الخبَرُ",12,"ر",1,0],["واستغرقت أنوارها","عوالم القلب الخلي",13,"ي",1,0],["وأستغفر اللَه العظيم لزلتي","وعجزي وتقصيري وعظم جرائري",14,"ر",2,0],["وَاِستَغنِ بِاللَهِ عَن كُلِّ فانٍ بِه","غِنىً لِكُلّ وثق بِاللَهِ يَكفيكا",15,"ك",2,0],["وَاِستَغشَأوا مِن دُعاها ما عَلَيهِ نَشوا","مِن رَفضِها وَبِمُستَنِّ الغَرامِ وَشوا",16,"ش",3,0],["وأَستغفِرُ اللّهَ فالحالُ فيه","تَفاوَتَ جِدّاً فيا رَبُّ غَفْرا",17,"ر",2,0],["واستغفر الله عُقَيب اللّعبِ","واحذر من الحلف به والكَذِب",18,"ب",1,0],["واستغفر الله من قول كثير افتراه","يبدي أمورا ويخفى ضد ما قد بداه",19,"ا",2,0],["واستغفر اللله الغفور الرحيم","من كل ذنب حادث أو قديم",20,"م",1,0],["واستغفر الله من قولي","في النثر والسجع والأشعار",21,"ر",1,0],["وأستغفرالله من ذنبي ونقض العقد","ونسأل الله لمن عمره تقضى أو نفد",22,"د",1,0],["واستغفر الله من كل الذنوب ومن","جميع فعلي من خير وسيات",23,"ت",1,0],["وأستغفر الله العظيم عدادما","خلق ربنا في شرقها والمغارب",24,"ب",1,0],["وأستغني به عمَّا سواه","كما يغني الركام عن الجهام",25,"م",1,0],["واستغنم الوقتَ واحضر دائماً معهم","واعلم بأن الرضى يخصُّ من حضرا",26,"ر",2,0],["واستغفري ذا الجلال","واسترحمي فهو ارحم",27,"م",1,0],["واستغفري لذنوبٍ جمةٍ سلفت","وابكي على ما مضى واسترجعي ودعي",28,"ع",2,0],["وأستغن أن استسق كل غمامة","لقبرك دمعي عن ملث الحيا مغني",29,"ن",2,0],["واستغن بي وأغنني عن معشرٍ","سُورَةُ فضلى بينهم لم تُدرَسِ",30,"س",1,0],["وَاِستَغنِمِ الدَجنَ وِاِشرَب تَحتَ هَيبَتِهِ","ما دامَ رَفرَفُهُ في الأَرضِ يَنسَحِبُ",31,"ب",1,0],["واستغفر اللَه من ذنبٍ وقعت به","فاللَه بالفضل ماحٍ الخطيئات",32,"ت",1,0],["واسْتَغْرِبي واسْتَشْرِقي","واسْتَشْمِلي واسْتَقْبِلي",33,"ل",2,0],["واستغفر الله إذا","أذنبت فهو يغفر",34,"ر",1,0],["واستغن بالشوق الذي يحثها","عن منة الحادي وزجر الزاجر",35,"ر",1,0],["واستغنم الفترة من قبل أن","يرتفع الإنجيل بالمصحف",36,"ف",1,0],["واستغرقَ الزمانَ والمَكانا","مُرتَجِياً ببابِكَ الإِحسانا",37,"ن",2,0],["وأُسْتَغَرُّ بما أمّلتُ تخدعني","لَيُّ الحوادثِ إذْ أرْخَتْ من الطِّوَلِ",38,"ل",1,0],["وَاِستَغنِم العَفوَ الَّذي أوتيتَهُ","لا تَأمَنَنَّ عُقوبَةً مِن قادِرِ",39,"ر",1,0],["وَاِستَغزَرَ القَومُ كَأساً مِن دِمائِهِمُ","وَأَحدَقَ المَوتُ بِالكُرّارِ وَالحيدِ",40,"د",1,0],["واستغفر الله للجميع وإن","جاء من الجاهلين تعنيف",41,"ف",1,0],["واستغفر المولى الغفور فإنه","يعفو عن المخطي إليه يعود",42,"د",1,0],["واسْتَغْنِ باللهِ عَمَّنْ","تَشاءُ أنتَ نَظِيرُهْ",43,"ر",2,0],["وأستغنم الوصل كي أشتفي","وهي يشتفي أبداً من عشق",44,"ق",1,0],["واستغلوا بما ملكتم وإن قل","لَ عتاداً لكلِّ جيلٍ وعصر",45,"ر",1,0],["واستغن بالبحر الذي","أمواجه يسرى ويمنى",46,"ن",2,0],["واستغرقوا فِي حب من أنواره","قادت إليه جوامح الأشباح",47,"ح",1,0],["وَاِستغنِ عن سِمنٍ تراه وأنّه","في كونهِ ورمٌ من الأورامِ",48,"م",1,0],["واستغرق العمر في آداب صحبتهِ","وحصّل الدر والياقوت من فيه",49,"ي",2,0],["واستغث من ينزّل الغيث في المح","ل ومن ينشىء السحاب الثقالا",50,"ل",2,0],["واستغفر الله العليم بما بدا","مني وما يبدو من الاسواءِ",51,"ا",2,0],["واستغفر الرحمن جل جلا","وسل الهداية بالرسول الهادي",52,"د",2,0],["واستغفر اللَه لي أنت الرؤف بنا","يا معدن الجود يا هادي المسرات",53,"ت",1,0],["واستغفري اللَه لا تنسيهِ واحتسبي","فإنما يأجرُ اللَهُ الذي احتسبا",54,"ب",2,0],["واستغنم اللذات في زمن الصبا","لا زال كفك للندى مدرارا",55,"ر",2,0],["واستغفرن ما جئت من ذنب مضى","وانا الكفيل بنيل ذا الغفران",56,"ن",1,0],["واستغفر الله","يشفي غليل النفوس",57,"س",1,0],["واستغنِ عن عِدَةِ البخي","ل أَتَتْ بعذرٍ واعتلال",58,"ل",1,0],["واستغث إن عن خطبٌ مُذهل","فَمَلاذ الخَلقِ والركنُ الأشَد",59,"د",1,0],["وَاستَغفِرِي مِمّا جَنَيتِ وَقَد حَدا","حادِي النَوى بِرِكابِكُم وَرِكابِي",60,"ب",2,0],["واستغاثت سلمى بيسوعها تش","كو إليه النسيمَ مما دهاها",61,"ا",3,0],["واستغفروا لي في","ا طالما اقترفتُ الأثاما",62,"م",2,0],["واستغفر اللَه مما قد ولعت به","أيام كان الصبا يا قلب يغرينا",63,"ن",2,0],["واستغذبوا السُم من أم الخبائث وا","لهفي ومذ وردوا حاناتها مردوا",64,"د",3,0],["واستغفرت لذنبها وجددت","توبة خطاء عدا أو اعتدى",65,"د",2,0],["واستغنِ ما اغناك ربّك بالغنى","وإذا تكون خصاصةٌ فتجمل",66,"ل",1,0],["واستغاثت بربها ثم جرت","نحو أشلاء ندبها أذيالا",67,"ل",2,0],["وَاستغفلت عَين الرَقيب بِلَيلة","طابَت لِساهرها فذمَّ صَباحها",68,"ح",3,0],["واستغنم اللذات في عهد الصبا","وأونه لا عطر بعد عروس",69,"س",1,0],["واستغن في نغماته عن لحن داودٍ","وعن نغمات شدو العود",70,"د",1,0],["واستغفرالله ما تغنى الحمام","وما سبح في الجو طائر",71,"ر",1,0],["واستغلق الوحي دون المرتجى لهما","وخابت الفكرُ الغراءُ والحيل",72,"ل",1,0],["واستغن عمن شئت من أهل الغنى","وأظهر له شرف الاباء تكن نظيره",73,"ر",2,0],["واستغفر الغفار وارج بفضله","حسن الختام ونيل غايات الرجا",74,"ج",2,0],["واستغفر اللَه تحمد كل عاقبة","بلغت غاياتها من شدة ورخا",75,"خ",2,0],["واستغفِرُ اللَه الكريم تضرُّعا","بنفسي واستكفى به عن عد أنفاسي",76,"س",2,0],["وَاِستَغنِ عَن كُلِّ ذي قُربى وَذي رَحِمٍ","إِنَّ الغَنِيَّ مَنِ اِستَغنى عَنِ الناسِ",77,"س",1,0],["واستغْنِمِ الشَّيبَ الذي","أهدى وقارَكَ إذْ نَزَلْ",78,"ل",1,0],["وأستغفر اللَه مما اجترمت","زمان انصياعي للشهوة",79,"ه",1,0],["وأستغفر اللَه من كل ما","يخالف شرعي في أمتي",79,"ي",1,0],["وأستغفر اللَه من كلِّ ما","ملأتُ به العينَ من جيرتي",79,"ي",1,0],["وأستغفر اللَه من كل ما","دعاني إليه أبو مرةِ",79,"ه",1,0],["واسْتغْنِ عمّن ضَنَّ وانْأَ بجانبٍ","عن ناكب جانٍ خَؤونٍ مُدْهِنِ",80,"ن",1,0],["واستغفر اللّه العظيم لكلهم","فبذا أتاك الأمر في القرآن",81,"ن",1,0],["واستغن عن بعض أثاث الدار","إن صار رهناً في يد الخمار",82,"ر",1,0],["وَاِستَغفِروا اللَهَ مِمّا كان وابتهلوا","إليهِ يَغفِر لنا فضلاً ويرحَمنا",83,"ن",2,0],["واستغلت كل الكنوز فأضحت","وهي أغنى الملوك مالاً وأثرى",84,"ر",2,0],["واستغاثت بالمسلمين فأغضى","الكل عنها ولم يلبوا نداها",85,"ا",3,0],["واستغن بريقي عن خمرٍ","فيه تصحو مهما تسكر",86,"ر",1,0],["واستغنِ عن مطر السحاب فكفه","يغنيك منه الجود صوب عهاده",87,"د",2,0],["واستغن عن كل كتاب به","فغيره القشر وهذا اللباب",88,"ب",1,0],["وَاستغن عن ظل القصو","ر بظل آجام وَغاب",89,"ب",1,0],["وأستغفر اللَه العظيم من الَّذي","جَنى القَلب من غَي الغُرور وإفكهِ",90,"ه",1,0],["واستغنت الأرض والسماء معًا","عن الشياطين فانطووا جزعا",91,"ع",2,0],["واستغرق العمر في آداب صحبته","مع المشائخ والبرهان يحكيه",92,"ي",2,0],["وأستغفر الله ذنبي فكم","رجاه أثيم فما خيبا",93,"ب",2,0],["واستغفروا اللَه من كل الذنوب عسى","ننال عفواً عن الزلات واللمم",94,"م",1,0],["واستغرقتني عني في اشعتها","واستعلنت لي من مشكاة اطواري",95,"ر",2,0],["وَأَستَغفِر الرحمن مِمّا جَنَيتُه","وَأَنتَ كَريم عِندَهُ يَقبَل العُذر",96,"ر",1,0],["وأستغفر الله من زلتي","فإني من جرمها واجمُ",97,"م",1,0],["واستغرق الفكر في مجرى مجرتها","فذاك بحر بفيض اللطف مسجور",98,"ر",1,0],["واستغني إذا غنى المغني","به عن صرف أقداح الشراب",99,"ب",1,0],["وَاِستَغنِ بِاللَهِ جَزيل العَطا","بِفَضلِهِ يُغنِكَ عمّن سِواه",100,"ا",2,0],["واستغن عمن تشا من بعد ذاك تكن","مثيله واغفر الزلات واحتمل",101,"ل",1,0],["واستغفري واعملي","ما ينفع الثانيه",102,"ن",3,0],["واستَغفِرُوا لصَمتِكُم","واستَنفِرُوا وأحْبِطُوا",103,"ط",3,0],["واستغفر الله عن ذنبٍ وعن عملٍ","ساءت به في غد للمرء أحوال",104,"ل",1,0],["وأستغفرُ الرحمنِ من وزرِ عَبْرَتِيْ","عليكَ ومن ذنبي إلى اللهِ أرجعُ",105,"ع",1,0],["واستغفر الله لكن البوق ملموس","واضح ولا يحتاج شرح وأدلّه",106,"ل",2,0],["واستغلت للقناة وهي إذ","ذاك كانت لمناها