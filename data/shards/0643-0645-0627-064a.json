052",""],[5302,"صلوا عليه وسلموا","https://www.poetsgate.com/ViewPoem.aspx?id=201897",""],[5305,"الاستسعاد بمدح سيد الأسياد","https://www.poetsgate.com/ViewPoem.aspx?id=187378",""],[307,"طافَ الوباءُ بقاع الأرضِ","https://www.poetsgate.com/ViewPoem.aspx?id=215607",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5582,"ما بالُ وُرْقِ الغَضَا تَشْدُو بِأَلْحانِ","https://www.poetsgate.com/ViewPoem.aspx?id=187313",""],[5628,"عودي","https://www.poetsgate.com/ViewPoem.aspx?id=178505",""],[243,"وحي النيروز","https://www.poetsgate.com/ViewPoem.aspx?id=20962",""],[5691,"جيل الحروب","https://www.poetsgate.com/ViewPoem.aspx?id=205892",""],[5776,"انتحارُ عرّافة","https://www.poetsgate.com/ViewPoem.aspx?id=199330",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[5309,"من الضيم ما يذكي بقلبك همة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573756",""],[6198,"عباءة الصمت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79232&r=&rc=6",""],[2220,"لولا لبانة موسى النور ما انقلبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11193&r=&rc=67",""],[6315,"رُؤى على شفير الحداد !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87579&r=&rc=4",""]],"verses":[["كَما يَبيتُ رَميضٌ","بَعدَ السَنامِ الأَجَبُّ",0,"ب",1,0],["كما ينفش البوليس مقصورة البغ","تكب الندى والعشب طاحونة الوغى",1,"غ",2,1],["كما يطبخ البحر المدمى شطوطه","تشوي حراشيف الوجوه التمرغا",1,"غ",2,0],["كم آيةٌ في نقطها ينجلي","نجمك والأحرف لا تنجلي",2,"ل",2,0],["كَمَا يَتَلاقَى فِي طَرِيقٍ مَخُوفَةٍ","غَرِيبَانِ نَالَتْ شُقَّةُ السَّيْرِ مِنْهُمَا",3,"م",2,0],["كم آيةٍ لك قد صدعت بنورها","ليلَ الضلال وإفكّهُ المنحولا",4,"ل",2,0],["كم آيةٍ لك في السعود جليةٍ","خلّدتَ منها عبرة استبصارِ",5,"ر",1,0],["كم آيةٍ لرسولِ الله مُعجزةٍ","تكلُّ عن منتهاها ألْسُنُ الفُصَحَا",6,"ح",2,0],["كَما يَختَبَّ مُعتَدِلٌ مَطاهُ","إِلى وَشَلٍ بِذي الرَدَهاتِ سيدُ",7,"د",1,0],["كما يحق بأن تطوى لذي سفرٍ","نَواك يا خير مُزدار لمزدار",8,"ر",1,0],["كما يشكو امرؤٌ طغيانَ سيلٍ","تساوى الوهدُ فيه والأكامُ",9,"م",1,0],["كما يرى الناس في يومٍ محاسنَهُ","أضعاف ما هو رائيهن في زمنِ",10,"ن",1,0],["كما يَرى الناسُ في يومٍ محاسِنَهُ","ما لا يَراهُنَّ بالمرآةِ في الزمن",11,"ن",1,0],["كَما يُقتَلُ الطَيرُ في الجَنَّةِ","وَيَقتَنِصُ الظَبيُ في السَبسَبِ",12,"ب",1,0],["كَم إِيادٍ أَعُدُّها","لَكَ عِندي وَكَم مِنَن",13,"ن",1,0],["كَمائِدَةِ المَسيحِ يَقومُ بُؤسٌ","حَوالَيها وَتَقعُدُ بائِساتُ",14,"ت",1,0],["كَما يَمضي سُرورٌ وَهوَ جَمُّ","كَذَلِكَ ما يَسوؤُكَ لا يَدومُ",15,"م",1,0],["كَما يَمشي مَهيضُ العَظ","مِ بَعدَ الجَبرِ في الصَعَدِ",16,"د",1,0],["كَما يَألَفُ السَيفُ كَفَّ الكَمِيِّ","وَيَطَّرِحُ القينَ وَالصَيقَلا",17,"ل",2,0],["كَما يَذُودُ البَخيلُ مُحتَزِماً","عَن حَوضِهِ قَبلَ مالِهِ النَهِلا",18,"ل",2,0],["كَما يَلحَقُ الغَيثُ البِلادَ بِسَيلِهِ","وَإِن جادَ في أَرضٍ سِواها بِأَمطارِ",19,"ر",1,0],["كم آيةٍ ظَهَرَتْ فِي حين مَولِدِهِ","بهِ البشائرُ منها والتَّهاويلُ",20,"ل",1,0],["كَما يَنهَزِمُ القُربُ","إِذا ما عايَنَ البُعدا",21,"د",2,0],["كَما يَشُقُّ الصَخرَةَ الناقورُ","أَيّامَ رَأسي قَصَبٌ دَيجورُ",22,"ر",1,0],["كَما يَميلُ الشارِبُ المَخمورُ","مِمّا يُجَزّي بَينَنا السِفسيرُ",22,"ر",1,0],["كَما يُجوزُ اللُجَّةَ القُرقورُ","حَتّى اِنتَهَت وَالمُخُّ مِنها زيرُ",22,"ر",1,0],["كَما يَنظُرُ الصادي أَطالَ بِمَنهَلٍ","فَحَلَّأَهُ الوُرّادُ عَن بارِدٍ عَذبِ",23,"ب",1,0],["كَم أَينُقٍ يَنضو الظَلامَ وَجيفُها","وَإِى تَبارٍ شَفَّهُنَّ تَباري",24,"ر",2,0],["كَم آيَةٍ يُؤنِسُها مَعشَرٌ","فَلا يُبالونَ وَلا يَتَّقون",25,"ن",1,1],["كَما يَكبو الكَميّ إِذا","أَثارَ فَكَبَّهُ الرَهَجُ",26,"ج",1,0],["كَما يَتَرامى بِالمَداري خَرائِدٌ","كَواعِبُ مِنها مُخطِئٌ وَمُصيبُ",27,"ب",1,0],["كما يَمْضي سُرورٌ وَهْوَ جَمٌّ","كذلك ما يَسُوْءُك لا يَدُومُ",28,"م",1,0],["كما يُقْرعُ \" الجَرْسُ \" للناشئينَ","تأتي إلى الناس منه النُّذُر",29,"ر",1,0],["كم أينُقٍ ينضُو، الظلامَ، وجيفُها","، وإلى تَبارٍ شَفّهنّ تَباري",30,"ر",2,0],["كما يذهب الظل اليمينَ ويسرةً","وذو الظل في مثواه ما زال باقيا",31,"ي",2,0],["كم آيةٍ بالصدقِ كان ظهورها","كم آيةٍ بالسَّبق كان نزولها",32,"ل",3,0],["كم آيةٍ لمحمد كم حجةٍ","عزَّ الوليّ بها وذلّ المشرك",33,"ك",1,0],["كَما يَخلُصُ التِبرُ العَتيقُ عَلى السَبكِ","أَتانا وَما مِنّا عَنِ الغَيِّ مُقَصِرُ",34,"ر",1,0],["كما يُخْنَق الصيدُ في خَيَّةٍ","ومهما تفاحص زادتْه خَنْقا",35,"ق",2,0],["كما يفتك النملُ وهْو الضعيف","بشِبْلِ الهِزَبْرِ البعيدِ المَرام",36,"م",1,0],["كَما يُلازِمُ دونَ الحنبَلِ اِبنَتَهُ","بِنَحرِهِ وَيَدَيهِ الأَشمَطُ الخَرِفُ",37,"ف",1,0],["كما يمشي الجبانُ وعن يديهِ","صفوفُ الحارسينَ من الجنودِ",38,"د",1,0],["كما يود الهلال ان لو","كان نطاقا له وبندا",39,"د",2,0],["كم آية كالشمس بت","نا عن سناها معرضين",40,"ن",1,0],["كَما يَجيءُ الهَوى عَنيفاً","يَمضي عَنيف",41,"ف",1,0],["كَما يَثبتُ الصَفصافُ في عاصِفِ الدُجى","وَلِلأُفقِ وَجه هابِط الغيمِ أَربَدُ",42,"د",1,0],["كما يفتُق الريحُ نشرَ الرياضْ","ويشكو لمعشوقه العاشق",43,"ق",1,0],["كما يتَداوَى إذا ما انتشى","من الراح بالراح مخمورُها",44,"ر",3,0],["كما ينظرون الشمس لا غيم دونها","لقد خاب محجوب هناك ممنّع",45,"ع",1,0],["كَمائِمُ النُوّارِ عَن","أَمثالِها لَم تُفتَقِ",46,"ق",1,0],["كما يَنحني غصنٌ لكثرةِ حملهِ","ويشمخُ غصنٌ مورقٌ غير حمّال",47,"ل",1,0],["كم آيةٍ نطقتْ تصدّق أحمدا","حتى الجمادُ أجابه تكليما",48,"م",2,0],["كَما يَشتَكي المالُ مِن راحَتَيك","إِلَيكَ فَلَم تُشكِهِ يا أُسامَه",49,"م",2,0],["كَم آي تَوحيدٍ تَلا فيكُمُ","قَلبي وَأَعياني تَلافيكُمُ",50,"م",1,0],["كَما يَقبض الكَفُّ بِالمعصمِ","فَجُد تَغدُ علياك مَرفوعَةً",51,"ه",1,0],["كما يَتْبَعُ الرّامي إلى الصَّيْدِ سَهْمَه","لِيَلْحَقَه حتّى إذا جاءه ولّى",52,"ل",2,0],["كما يَعْتلي عارِضٌ مُطبِقٌ","بإمطارِها وبإبراقها",53,"ق",3,0],["كما يَقْصِدُ القَمرُ الشّمسَ لا","يَزالُ يُرى صَدَرِي والورُود",54,"د",1,0],["كما يَعْتفِي فاضِلٌ مُفْضِلاً","فهذا يَجودُ وهذا يُجيد",54,"د",1,0],["كما يَنتضِي سيفَه غاضبٌ","وأوّلُ ما غَضِب المُنتضى",55,"ا",1,0],["كَما يَتَزَيّا بِالهَوى غَيرُ أَهلِهِ","كَذا ما تَزَيّا بِالهَوى غَيرُ أَهلِهِ",56,"ل",2,0],["كَم آية نَزَلَت مُوافَقة","آراءُهُ وَالحَق مَنصورُ",57,"ر",1,0],["كَما يَشتاق قَلباً غا","بَ عَن أَحشائِهِ بَدنه",58,"ن",2,0],["كم أيد الله من رأي نطقت به","فصار تتلى به الآيات والسور",59,"ر",1,0],["كم أيادٍ تلك الأَيادي أفاضت","وأسالت من وابل الجود سيلا",60,"ل",2,0],["كم آية لك يا عيسى ومعجزةٍ","يقلّ هزمهمُ فيها وإن كثروا",61,"ر",3,0],["كَما يُخَلِّي الحبيبُ غالِيَةً","فِي عارِضَيْ إِلْفِهِ لِذِكْرَاهُ",62,"ا",2,0],["كم أياد بذلتها وهي قد","ضاعت ضياع الإحسان بين اللئام",63,"م",1,0],["كما يدارِي الصبَر قلبي كارها","قلّما استُمتِع بالصبر كِراها",64,"ا",3,0],["كما يُطيعُ اليأسُ ثم يلتوِي","طماعةً مع الشميم الرائمُ",65,"م",1,0],["كم آيةٍ لي لو تحفَّظتُمُ","بها وفألٍ بعلاكم جرى",66,"ر",2,0],["كم أيكةٍ أنْبتَها جودُك لي","تُربُ ثراها طيِّبٌ والماءُ عِدْ",67,"د",1,0],["كما يجوزُ ضياء الشمس مطلعها","ويبعث العَرْفَ للمستنشق الطيب",68,"ب",1,0],["كما يستعينُ المَشْرَفيُّ بِساعِدٍ","فيَفْرِي رِقابَ الصِّيدِ والشُّجعاء",69,"ا",2,0],["كم آية رويت لكم إسرارها","آل الوصي وللورى إعلانها",70,"ن",3,0],["كم أيادٍ لك في النّا","سِ كأطواق الحَمامِ",71,"م",1,0],["كما يعطي تفكرك المعاني","بتصوير لها يبدي حدوده",72,"د",2,0],["كما يضل كثيراً قال خالقنا","به ويهدي كثيراً يا أخلاء",73,"ا",2,0],["كَما يَعودُ العِيدَ نَصرانِيُّ","وَبَيعَةً لِسُورِها عِلِيُّ",74,"ي",1,0],["كم آيةٍ فيهِ تُخالفُ بعضَهم","لكن عَلَى تغييرها لم يُقدِمَ",75,"م",1,0],["كَما يَعتادُهُ الصافونَ مِنهُ","وَمَن يَرجوهُ في الكَرَمِ العَتيدِ",76,"د",1,0],["كما يَنْحَدرُ السّيْلُ","من الشّاهِقِ بالصَّخْرَهْ",77,"ر",2,0],["كَما يَغدو نَشاصٌ مِن","سَحابِ الصَيفِ مُنطَلِقُ",78,"ق",1,0],["كَما يُنكر الطفل الطَبيب وَعِندَهُ","لَهُ برء أَسقام وَدمل كَلوم",79,"م",1,0],["كما يتمنَّى من تمَنَّى ولا أرى","لياناً من الدنيا لحيٍّ بأنعُمِ",80,"م",1,0],["كما يكنى بأبي البيضاء","أسود كالسروة في الظلماء",81,"ا",2,0],["كم آيةٍ مُحِيتْ بماء وصاله","كانت مُسطّرةً بأنُمل صدّه",82,"د",2,0],["كم آية لكَ بين الناسِ قد ظهرت","كأنّما أنت موسى بن عمرانِ