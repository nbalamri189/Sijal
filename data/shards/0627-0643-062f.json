{"poems":[[55,"شوق يعرض لا إلى الآرام","https://www.aldiwan.net/poem29772.html","الكامل"],[73,"أهاجك شوق أم سنا بارق نجدي","https://www.aldiwan.net/poem4007.html","الطويل"],[74,"ألحب مفروض علي لغادة","https://www.aldiwan.net/poem20284.html","الكامل"],[53,"لا تلح من تفتنه قينه","https://www.aldiwan.net/poem66452.html","السريع"],[47,"أتراك تسمع للحمام الهتف","https://www.aldiwan.net/poem65160.html","الكامل"],[46,"ها إن هذا موقف الجازع","https://www.aldiwan.net/poem30459.html","السريع"],[48,"قد ينصف القوم في الأشياء سيدهم","https://www.aldiwan.net/poem23559.html","البسيط"],[108,"حي البيان","https://www.poetsgate.com/ViewPoem.aspx?id=179367",""],[147,"لا زال ملكك بالعلى مأهولا","https://www.aldiwan.net/poem11789.html","الكامل"],[563,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[788,"","https://poetry.dctabudhabi.ae/diwan/poem/206042","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82282","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205030","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204632","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65490","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89022","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62815","الوافر"],[3582,"","https://poetry.dctabudhabi.ae/diwan/poem/45222","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66344","البسيط"],[4869,"محاكاة صورة","https://www.poetsgate.com/ViewPoem.aspx?id=138048",""],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""],[5500,"على سبيل الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=190252",""],[5751,"كذبةُ سيف","https://www.poetsgate.com/ViewPoem.aspx?id=214773",""],[6202,"رسالة إلى الكبيسي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86725&r=&rc=26",""],[463,"جمَّ لها الوادي وعزَّ الذائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60032&r=&rc=88",""]],"verses":[["أَكدَت عَلَيَّ الأَرضُ مِن أَطرافِها","وَتَدَرَّعَت بِمَدارِعِ الإِظلامِ",0,"م",1,0],["أَكِدُّ وَيُكدي الدَهرُ في كُلِّ مَطلَبٍ","فَيا بُؤسَ حَظّي كَم أَكِدُّ وَكَم يُكدي",1,"د",2,0],["أكَّدت فني في الثنا","ءِ وفي النَّدى والعلم فنّكْ",2,"ك",1,0],["أكَّدتِ الحسنَ بإحسانها","في مهنةٍ ما مثلُها مهنَهْ",3,"ن",2,0],["أَكَّدتَ بَيعَتَهُ وَلَم تَركَن إِلى","جَدَلِ السَفيهِ وَلا كَلامِ المُرجِفِ",4,"ف",1,0],["أَكدى الَّذي يَعتَدُّهُ عُدَّةً","وَضاعَ مَن يَرجوهُ لِلضائِعِ",5,"ع",1,0],["أَكدى فَلاموهُ لَمّا قَلَّ نائِلُهُ","وَلَو حَبا الوَفرُ زاروهُ وَنابوهُ",6,"ب",3,0],["أكداسُ أوراقٍ يغيبُ الشِّعْرُ في","طَيَّاتها، ويطُول عهدُ غيابه",7,"ب",2,0],["أَكدَت مَطالِبُهُ وَهَل يُعدي عَلى ال","قُرآنِ مَن يَستَنصِرُ الإِنجيلا",8,"ل",2,0],["أكدت مدحي بشبه الذم لست أرى","الا العفاف والا الحفظ للذمم",9,"م",1,0],["أكد إذا لاقيت قوماً بخطة","ألح على أكتافهم قتب عقر",10,"ر",1,1],["أكّد وبيّن عدّ أو بالوصف","أو آلة تنوب عند الحذف",11,"ف",1,0],["أكدُّ نَفسي بِالتَّطيينِ مُجتَهِداً","إِمّا أَجيراً وَإِمّا غَيرُ مُؤتَجَرِ",12,"ر",1,0],["أَكدَافُهُ عَالِيَةُ الذُّرعَانِ","كُن عَارِفَ الأَوصَافِ يَا ربَّاني",13,"ي",1,0],["أكدّ واعني لدنيا خؤون","وأجريَ بعد العناء البوار",14,"ر",1,0],["أكداس وهم في شوارع بلدتي","أتجود ريح الغرب لي بزوابع",15,"ع",1,0],["أكدّت في لقاك أفعال شوق","رُبّما أكدّ الرُّقى بالتّمائم",16,"م",1,0],["إِكْدِيشُ ابنُ فلانَ من","دين البهائم كاد يخرجْ",17,"ج",1,1],["أكدُّ العيشَ أطلُبُ فوقَ زادي","ولو أني قَنَعْتُ بهِ كَفاني",18,"ن",2,0],["أَكِدنا وَمَن أَرسى ثَبيراً مَكانَهُ","يُسالُ بِنا لَولا أُتينا المُهَلَّبُ",19,"ب",1,1],["أكّدت خالص ودّي إذ عطفت به","عليَّ في نسق قد جاء بالعجب",20,"ب",1,0],["اكد بالقرش والدينار","والجوع / الاوجاع تهتفله",21,"ل",2,0],["أكد بذم أعاديهم مديحك إذ","لا عيب فيهم سوى تفريق جندهم",22,"م",1,0],["أَكدى وقالَ الجُوعَ قولته","فِي الأَرْضِ بَرٌّ ولا بِرُّ",23,"ر",1,0],["أكدى بنا أرخبيلُ الجَهلِ وانكسرتْ","سيوفُ أهلي ومازلنا صدى طرَبِ",24,"ب",1,0],["أكدت عيون قوافي الشعر معذرة","حتى عييت وكاد الليل ينتصف",25,"ف",1,0],["أكدْ مع الإثقالِ نحوي نظرة ً","تنعشني لحاظها الردائدُ",26,"د",1,0]]}