{"poems":[[44,"يقول الأرذلون بنو قشير","https://www.aldiwan.net/poem50350.html","الوافر"],[88,"أجل هذه أعلامه ومواكبه","https://www.aldiwan.net/poem10687.html","الطويل"],[90,"كل ابن آدم مقهور بعادات","https://www.aldiwan.net/poem44993.html","البسيط"],[90,"لمن تركت فنون العلم والأدب","https://www.aldiwan.net/poem45052.html","البسيط"],[53,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[53,"أبا حسن قد قلت لو كان فعال","https://www.aldiwan.net/poem65941.html","الطويل"],[53,"بخلت علي بجدوى سواك","https://www.aldiwan.net/poem66528.html","المتقارب"],[53,"أبا حسن لم أمس من حال بالكم","https://www.aldiwan.net/poem66724.html","البسيط"],[94,"أتفنى ابتسامات تلك الجفون","https://www.aldiwan.net/poem38959.html","المتقارب"],[45,"إذا كان مدح فالنسيب المقدم","https://www.aldiwan.net/poem10143.html","الطويل"],[47,"هزيع دجا في الرأس بادره بدر","https://www.aldiwan.net/poem64537.html","الطويل"],[35,"أنا الوامق المشغوف والله ناصري","https://www.aldiwan.net/poem25825.html","الطويل"],[42,"إني زائر ظبيا","https://www.aldiwan.net/poem42304.html","الهزج"],[48,"أصاب الأخفشين بصير خطب","https://www.aldiwan.net/poem22696.html","الوافر"],[47,"هزيع دجى في الرأس بارده بدر","https://www.poetsgate.com/ViewPoem.aspx?id=31243",""],[136,"أعاذلتي ويبكما دعاني","https://www.aldiwan.net/poem54715.html","الوافر"],[164,"تقضت ليال ضاعفت لكم الأجرا","https://www.aldiwan.net/poem58864.html","الطويل"],[164,"سرور عم حتى ما عرفنا","https://www.aldiwan.net/poem59038.html","الوافر"],[170,"أصون هدب ردائي ليس يجذبه","https://www.aldiwan.net/poem47029.html","البسيط"],[193,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[234,"أعذلا وما عذلتني النهى","https://www.aldiwan.net/poem51276.html","المتقارب"],[236,"تواضع لرب العرش علك ترفع","https://www.aldiwan.net/poem44582.html","الطويل"],[240,"ليهنك أني في حبالك عاني","https://www.aldiwan.net/poem31742.html","الطويل"],[244,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[308,"إذا ملك الإنسان ثوب قناعة","https://www.aldiwan.net/poem58282.html","الطويل"],[309,"يا رب يا عالم الحال","https://www.aldiwan.net/poem16759.html","المجتث"],[309,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[309,"يا جيرة بالمعهد اليماني","https://www.aldiwan.net/poem16842.html","الرجز"],[318,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[354,"أراني محبوءا على كل حالة","https://www.aldiwan.net/poem15655.html","الطويل"],[371,"ولاح غبار فوق مصقول خده","https://www.aldiwan.net/poem17044.html","الطويل"],[371,"كلفت بتعنيفي بلا طلب عذري","https://www.aldiwan.net/poem17192.html","الطويل"],[371,"يعز على محلي مفارقة القطر","https://www.aldiwan.net/poem17317.html","الطويل"],[376,"خلا طرفه بالسقم دوني يلازمه","https://www.aldiwan.net/poem57103.html","الطويل"],[398,"همام رأى الدنيا سواما فحاطها","https://www.aldiwan.net/poem53553.html","الطويل"],[408,"ألا تعجبن لعمرو وقد","https://www.aldiwan.net/poem46947.html","المتقارب"],[473,"حللت عرى إخائك من إخائي","https://www.aldiwan.net/poem60543.html","الوافر"],[520,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"],[556,"أفي كل وم لي منى أستجدها","https://www.aldiwan.net/poem47870.html","الطويل"],[592,"ألا يا راكباً قف لي فواقا","https://www.aldiwan.net/poem11557.html","عموديه"],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137335",""],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34430","البسيط"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44561","الرجز"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104635","الطويل"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123435","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71026","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145779","المتقارب"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44959","المتقارب"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61248","الرجز"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112853","الطويل"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82271","الهزج"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49927","البسيط"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118412","البسيط"],[1998,"","https://poetry.dctabudhabi.ae/diwan/poem/143439","الطويل"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95315","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27562","البسيط"],[2347,"","https://poetry.dctabudhabi.ae/diwan/poem/89516","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106846","المتقارب"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106879","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65984","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65995","الطويل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26116","الطويل"],[3341,"","https://poetry.dctabudhabi.ae/diwan/poem/139075",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138620",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110061","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92369","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35479","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111520","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86452","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127072","المتقارب"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35414","الطويل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136384",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120510","المجتث"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102007","البسيط"],[4767,"شمس الرشاد","https://www.poetsgate.com/ViewPoem.aspx?id=179938",""],[4929,"ملكة البيان","https://www.poetsgate.com/ViewPoem.aspx?id=208522",""],[5277,"طيف اليقضة","https://www.poetsgate.com/ViewPoem.aspx?id=186589",""],[5397,"أهل بسط كف تحجب الشمس والبدرا","https://www.poetsgate.com/ViewPoem.aspx?id=157931",""],[5628,"ميادة الحناوي تألق دائم *","https://www.poetsgate.com/ViewPoem.aspx?id=182932",""],[5771,"بطاقة زائر","https://www.poetsgate.com/ViewPoem.aspx?id=189060",""],[5894,"وحسنك يا خلي بغيرك لا أهوى","https://www.poetsgate.com/ViewPoem.aspx?id=131436",""],[5943,"دخول الناس بين الناس صعبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=34492",""],[5953,"تشخص للأنام فتشبهوه","https://www.poetsgate.com/ViewPoem.aspx?id=93843",""],[5956,"الرَّصيفُ ذو الحصى العسليّ","https://www.poetsgate.com/ViewPoem.aspx?id=184884",""],[5956,"فاسد يشجع على عقوق الوالدين","https://www.poetsgate.com/ViewPoem.aspx?id=193421",""],[572,"لهُ شُغُلٌ عنْ سؤالِ الطّلَلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9447&r=&rc=304",""]],"verses":[["وَلَم يَخصُص بِها أَحَداً سِواهُم","هَنيئاً ما اصطَفاهُ لَهُم مَرِيّا",0,"ي",2,0],["وَلَم يُخفِهِ عَن أَعيُنِ الحَقِّ مِخدَعٌ","وَلا نَفَقٌ في الأَرضِ جَمٌّ مَسارِبُه",1,"ب",2,0],["ولم يَخَف في أتّباع الحق لائمةً","ولو أتَته بحدّ المَشرَفِيّات",2,"ت",1,0],["ولم يخصّ الأسى داراً نعيت بها","بل عمّ مبتعداً من بعد مقترب",3,"ب",1,0],["ولم يُخْلَقنَ من أَرْيٍ جميعاً","ولكن هُنَّ من أرْيٍ وصَابِ",4,"ب",1,0],["ولم يُخلَقوا أبطالَ عَسفٍ وشدةٍ","ولكنَّهُم بالرفقِ واللينِ أبطالُ",5,"ل",1,0],["ولم يخف عنِّيَ إذ كان ذاك","بما دبَّر الثَّيْتلُ الأقْرنُ",6,"ن",1,0],["ولم يَخْلُ من شوقٍ إلى وجهه غدٌ","فلا انصرفَ الأمسُ المُودَّع تاليا",7,"ل",3,0],["ولم يُخْفَروا بالخرابِ المحيط","ولم يُفْجَعوا في الحبيب الودودْ",8,"د",1,0],["وَلَم يَخلُ مِن أَسمائِهِ عودُ مِنبَرٍ","وَلَم يَخلُ دينارٌ وَلَم يَخلُ دِرهَمُ",9,"م",1,0],["وَلَم يَخلُ مِن جودٍ وَلا صَوبِ عارِضِ","لَهُ أُفُقٌ في الأَرضِ ناءٍ وَلا قُطرُ",10,"ر",1,0],["وَلَم يَخلُ مِنهُ المُصطَفى سَيِّدُ الوَرى","أَبو القاسِمِ الزاكي النَبيُّ المُكَرَّمُ",11,"م",1,0],["وَلَم يَخشَ مِنَ الحَيِّ الَّ","ذي يَطرُقُ كالِيهِ",12,"ي",2,0],["وَلَم يَخِفِ الحِمامَ فَأَلجَأتُهُ","مُطِلّاتُ الصُقورِ إِلى تَواري",13,"ر",2,0],["ولم يخل من وجود ولا صوب عارض","له أفق في الأرض ناء، ولا قطر",14,"ر",1,0],["وَلَم يَخفَق جَنَاني مِن وَعِيدٍ","وَلَو آلَى عَلَيهِ الخَافِقَانِ",15,"ن",1,0],["ولم يخب الداعي إليه ولا أنثنى","عن الخلق المرضى والشيمة الغرا",16,"ر",2,0],["ولم يختص قطرا دون قطر","ولكن عمهم سهراً وحزنا",17,"ن",2,0],["ولم يخُنْ قطُّ إلفٌ في مَوَدَّتهِ","إلا وجدتُ من الألاّفِ آلافا",18,"ف",2,0],["وَلَم يُخلّف غيرهُ بَنينا","لَو بَقِيا قرّا بهِ عُيونا",19,"ن",2,0],["وَلَم يُخلّوا بِشروطِ العهدِ","لَو كانَ موسى منهمُ وعيسى",19,"س",2,0],["ولم يَخْذُل السيفُ منه يداً","ولم يَسْكُنِ الرَّوْعُ منه حَشَا",20,"ا",1,0],["ولم يخلق السبع الطباق ولا الثرى","وهذا دليل ما لهم عنه مدفع",21,"ع",1,0],["وَلَم يَخشَ مِن رَيبِ الزَمانِ وَلَم يَجِد","إِلَيهِ سَبيلاً طارِقُ الحَدَثانِ",22,"ن",1,0],["ولم يخش نجداً عاهل الترك وحده","فإن جوار الأرض في مصر أرعب",23,"ب",1,0],["ولم يخش من فقرٍ رمته سهامه","لأن عليه نعمة الصبر سابغه",24,"ه",1,0],["ولم يخب فيك ظني","يا مالك الملك يا وال",25,"ل",1,0],["ولم يخش أن يفجأه موت مجهز","فإن مجيء الموت غير مؤقت",26,"ت",1,0],["ولم يخيب بالصدود ظني","ويشمت الحساد والشواني",27,"ي",1,0],["ولم يخف ما لا قى إذا انحط هابطاً","إلى الأرض من هول الأمور العظيمة",28,"ه",1,0],["وَلَم يُخفِهِ عَن ناظِري في دُنُوِّهِ","سِوى لَفتَتي عَنهُ إِلى طَيفِهِ الساري",29,"ي",1,0],["وَلَم يُخطِني مِن ذَلِكَ الثَغرِ راحَةٌ","تَناثَرَ دُرٌّ أَو تُرُشِّفَ ريقُ",30,"ق",1,0],["وَلَم يُخرِجِ الدُرَّ الَّذي البَحرُ دارُهُ","سِوى غُلَّةٍ مِنهُ إِلى ذَلِكَ البَحرِ",31,"ر",1,0],["وَلَم يَخفَ عَنهُم أَنَّ مِصرَ وَمُلكَها","وَسيعانِ ضاقا عَنهُ دونَ بَني مِصرِ",32,"ر",1,0],["ولم يُخفه أنَّ الهَوى خفَّ حَملُهُ","ولكن لأنَّ اللَّومَ ليسَ يُلائِمُه",33,"م",2,0],["وَلم يخطب الدُنيا اِحتِفالاً بِقَدرِها","فَموقِعُها من راحَتَيهِ يَسيرُ",34,"ر",1,0],["ولم يَخْتَرِعْها ولكنَّه","تَلَقّفَها عَنْ أخِيهِ عُمَرْ",35,"ر",1,0],["وَلَم يَخجَل صُدودُكَ مِن وِصالي","وَلَم يَستَحي غَدرُكَ مِن وَفائي",36,"ي",1,0],["ولم يخفق بحمد الله سعيي","إلى مصر ولا خاب انتخابي",37,"ب",2,0],["ولم يَخشَ منها نحسَها فيبيتُهُ","عَلى ظَمأٍ إلّا مُحيّاهُ سعدُها",38,"د",3,0],["ولم يخفوكموا يا أهل ودي","ولن نبغي لمهيعهٍ مراما",39,"م",2,0],["ولم يخطئ بنوكَ وهم سكارى","بحبك بعد أن نَشقوا هواكا",40,"ك",2,0],["وَلَم يَخُصَّ بِبشرٍ منه ذا نَشَبٍ","بَل عمَّهم فَضلُهُ بِالبشر والبِشَرِ",41,"ر",1,0],["وَلَم يُخَبِّرُ أَحَدٌ سِواكا","مِنَ النَصارى كُلَّهُم بِذاكا",42,"ك",2,0],["ولم يخلُ مِن قلبي هواها بقدرِ ما","أقولُ أتاهُ فارغاً فتمكَّنا",43,"ن",2,0],["ولم يخش من أعوانه وعُيونه","ولا ارتاع من حُجّابه وحِجابه",44,"ب",2,0],["ولم يخشَ في الرحمن لومة لائم","ولما يُمِلْهُ عن هدى الحق عازلُ",45,"ل",1,0],["ولمْ يَخجلوا مِن دماءِ العراق","متى العُهْرُ قدْ كانَ يوماً خَجولا",46,"ل",2,0],["وَلَم يُخلَقُ المالُ إِلّا لَها","وَما خَلَقتَ غَيرَ أَنسِ النُفوس",47,"س",1,0],["وَلَم يَخف وَقع الحمام بغتة","لَهو جَدير بِعقاب رَبه",48,"ب",2,0],["ولم يخش في مولاه لومة لائم","وأصحابه في ذاك لم يتأخروا",49,"ر",3,0],["وَلَم يُخشَ لَهُ ذَمٌّ","وَلَم يَبرَح لَهُ حَمدُ",50,"د",1,0],["ولم يخْلُ من ذكْره العالي ونائلهِ","في الارض مشرقُها الاقصى ومغربُها",51,"ب",3,0],["ولم يخلوا لدى ابياتهم احدا","بل جاء كلهم شيبا ومرد انا",52,"ن",2,0],["ولم يَخلُ من أخبارهم بطنُ دفترٍ","يَبوحُ بعَلياهُمْ ولا ظَهرُ مِنْبرِ",53,"ر",1,0],["ولم يُخَلِّف لمضناهُ الكئيبِ سِوَى","دَمعٍ صبيبٍ وَحُزنٍ بَعدهُ وَرِثَا",54,"ث",2,0],["ولم يخص بهذا الحكم امرأة","عند الشهود ولا أيضاً به رجلا",55,"ل",2,0],["ولم يخل عن ودي بن منصور مازنٌ","محل صفاء عن تعاديه أجنب",56,"ب",1,0],["ولم يخفق العلمُ المستطيلُ","عليك وحراسُه هجع",57,"ع",1,0],["ولم يخش بعض الناس إشقاءَ بعضهم","لوهمٍ قديم في النفوس توطدا",58,"د",2,0],["ولم يخفوا وعراً ولا البحر إِذ طما","وهاج بموج هائل متلاطم",59,"م",1,0],["ولم يخش في الرحمن لومة لائم","ولا خاف في الأرذال بطش شرارها",60,"ر",3,0],["وَلَم يُخزِ حَوضي ما جَبَت لي رِماحُهم","وَلَكِن لِقوّادِ الكَتائِبِ صُيَّدا",61,"د",2,0],["ولم يخرج عن الإيمان عبد","بدون الكفر لم يُحسن فعالا",62,"ل",2,0],["ولم يخش جبار السماء بقطعه","صلاة ولي الله من شدة الحقد",63,"د",1,0],["ولم يُخَلِ الثَرَى مثلَ الثُرَيَّا","على جِهَةٍ ولا حامٌ كسامِ",64,"م",1,0],["ولم يخطر التفريق منهم بخاطري","ولم نحسب الأيام فينا تعاندُ",65,"د",1,0],["وَلم يَخشَ يَوماً مِن تَعَسُّفِ قَفرَة","أَساوِدُها تَسعى وَآسادُها تَدأى",66,"ا",2,0],["ولم يخل يوماً مذبحي من مدامةٍ","وشحمٍ وإيلامٍ بحسن تصرف",67,"ف",1,0],["ولم يخل دست منك فاز بصالح","كأنكه لا بل كأنكما فيه",68,"ي",2,0],["ولم يخش في الدهر من سبة","وما يبلغ التبر من نبة",69,"ه",1,0],["وَلَم يُخصصِ الأَعمالَ بِاللَهِ مِن يَرى","شَريكاً لَهُ فيها بِمِثقالِ ذَرَّةِ",70,"ه",1,0],["ولم يخش في الاحكام لومة لائم","ولكنه يخشى الاله تعبدا",71,"د",2,0],["ولم يخط كتابا","الا واغلى المدادا",72,"د",2,0],["ولم يخلف دواهي الدهر منك عدا","زفير وجه يضاهي لفحة الشرر",73,"ر",1,0],["ولم يخرج بغير الفتكِ حكماً","وبالتفجير في كل احتشاد",74,"د",1,0],["ولم يخب مستجدٌّ فيك تلبية","إلا وأغنيته جودا بما يرضى",75,"ض",2,0],["ولم يخشَ الفراقَ على عهودٍ","ولكنَّ النوى يرمي المُعنَّى",76,"ن",2,0],["ولم يخلق الأفلاك لولا وجوده","إله السما قدما ولم يبرء الذرا",77,"ر",2,0],["ولمْ يخشَ البحارَ ولا دجاها","فَمَِنْ وَهَجِ المحبّةِ فيهِ شُعْلهْ",78,"ل",2,0],["وَلَمْ يَخُنِّي شُعُورِي طَرفَ عَاشِقَةٍ","لَكِنْ تَعَوَّدتُ مِمنْ خَانَ تَخْوينِي",79,"ن",2,0],["ولم يخش لوما في العدالة دائما","ونار لقاه كم عداه بها تكوي",80,"و",2,0],["ولم يخرجْ من الأبعاضِ بعضٌ","بدون تلوثٍ أو أكلِ جيفة ْ",81,"ف",2,0],["ولم يخف عن العقلاء لما","أتى بالمعجزات فوحدوه",82,"و",2,0],["ولم يخرجوا بعدها للمراحِ","وفي النفس يرقُدُ حبٌّ عميقْ",83,"ق",1,0],["ولم يخرسه بل أصغى","لصوت بلائه الناقدْ",84,"د",1,0],["ولم يخسفِ اللّهُ بالظّالمينَ","ولكنّهُ لا يخافُ العَجَلْ",85,"ل",1,0]]}