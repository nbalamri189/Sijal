{"poems":[[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54199","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80011","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94299","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91550","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72351","الخفيف"]],"verses":[["حلّ داءُ الفيل العُضالُ برِجْلَيْ","ها وألقَى أثقالَه واستبدّا",0,"د",2,0],["حلَّ داراً للمجدِ لم تلد العلياءُ","فيها إلاَّ الأبيَّ الغيورا",1,"ر",2,0],["حل دار النعيم والكل منا","في لظى الوجد والقلوب معنات",2,"ت",1,0],["حلٌّ دَمي ها فاسفكيه وَإِنَّما","أَرعى حقوقَ لواعجِ الأَشجاني",3,"ن",2,0],["ح لديه مقيد التسجيل","كم ثملنا منه بكأس روى",4,"ر",3,0]]}