{"poems":[[93,"وفاء كهذا العهد فليكن العهد","https://www.aldiwan.net/poem9845.html","الطويل"],[83,"سلو البارق النجدي من علمي نجد","https://www.aldiwan.net/poem54324.html","الطويل"],[88,"يا شهر أيار ما أن أنت أيار","https://www.aldiwan.net/poem44420.html","البسيط"],[27,"ألا حي المنازل بالجناب","https://www.aldiwan.net/poem5664.html","الوافر"],[37,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[51,"لعمري لقد سهلت ما ليس بالسهل","https://www.aldiwan.net/poem65942.html","الطويل"],[70,"أراني كلما استخبر","https://www.aldiwan.net/poem42977.html","الهزج"],[89,"بالأمس قد كنت أذنا","https://www.aldiwan.net/poem44700.html","المجتث"],[56,"يا عين لا للغضا ولا الكثب","https://www.aldiwan.net/poem58644.html","المنسرح"],[61,"شباب المرء ثوب مستعار","https://www.aldiwan.net/poem51666.html","الوافر"],[80,"بجمل حدا الغيران بزل جمائله","https://www.aldiwan.net/poem31331.html","الطويل"],[33,"إذا خفنا من الرقباء عينا","https://www.aldiwan.net/poem25987.html","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54813","الرجز"],[133,"تكبيرا لاتظني أن غانية","https://www.aldiwan.net/poem54767.html","الطويل"],[186,"لعل اعترافي باقترافي شافع","https://www.aldiwan.net/poem14578.html","الطويل"],[186,"ألا يا نسيم الريح إن كنت عابرا","https://www.aldiwan.net/poem14661.html","الطويل"],[224,"أتجهل قدر بشر إن بشرا","https://www.aldiwan.net/poem39691.html","الوافر"],[224,"ما لي أرى القلب في عينيك يلتهب","https://www.aldiwan.net/poem41599.html","البسيط"],[230,"كتبت يا واحد الأملاك والبشر","https://www.aldiwan.net/poem51013.html","البسيط"],[238,"سلام مخجل عرف الغوالي","https://www.aldiwan.net/poem18854.html","الوافر"],[260,"نحمد مولانا الذي قد اصطفى","https://www.aldiwan.net/poem35821.html","الرجز"],[271,"إلام تعالج الأسد القيودا","https://www.aldiwan.net/poem35176.html","الوافر"],[271,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[271,"هجرت الأهل والصحبا","https://www.aldiwan.net/poem35399.html","الهزج"],[283,"هنيئا أيها الملك المعظم","https://www.aldiwan.net/poem32628.html","الوافر"],[298,"معاطف أم رماح سمهريات","https://www.aldiwan.net/poem33315.html","البسيط"],[329,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[365,"أعد نظرة تبصر صنيع هواكا","https://www.aldiwan.net/poem60818.html","الطويل"],[440,"وفي غيابات أطباق الخطوب شج","https://www.aldiwan.net/poem34760.html","البسيط"],[441,"أیدرك قومي أن بالأرض مغنما","https://www.aldiwan.net/poem68017.html","عموديه"],[442,"ألق العصي فهذا مقتضى الأرب","https://www.aldiwan.net/poem14330.html","البسيط"],[450,"ربيع العمر","https://www.aldiwan.net/poem1014.html",""],[459,"تغرب فبالدار الحبية دار","https://www.aldiwan.net/poem56195.html","الطويل"],[462,"أقم يا حسامي في صوانك واهجم","https://www.aldiwan.net/poem15092.html","الطويل"],[483,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[501,"آل النبي الطاهر المصطفى","https://www.aldiwan.net/poem37678.html","السريع"],[552,"والله لا كان لي مال أضن به","https://www.aldiwan.net/poem47270.html","البسيط"],[552,"ما لك في ربة الغلائل","https://www.aldiwan.net/poem47285.html","الرجز"],[568,"ألا أبلغ أبا بكر","https://www.aldiwan.net/poem69649.html","مجزوء الكامل"],[568,"أجل هو الرزء جل فادحه","https://www.aldiwan.net/poem69740.html","مجزوء البسيط"],[576,"هواي لمحبوبي الأول","https://www.aldiwan.net/poem3036.html","المتقارب"],[576,"سرى طيفه لا بل سرى بي سرابه","https://www.aldiwan.net/poem3103.html","الطويل"]],"verses":[["وفي غده سلم تقربه النهى","وحلمٌ تصافى عنده الأنفس اللد",0,"د",1,0],["وفي غُمَّةٍ مَنْ لا ترى الشمسَ عينُهُ","وما نفعُ نور الشَّمسِ في الأعين الرُّمدِ",1,"د",1,0],["وفي غيومك عقم أِو بها صلف","ومالها عند مَريِ الريح ادرار",2,"ر",1,0],["وَفي غَطَفانَ فَاِجتَنِبوا حِماهُم","لُيوثُ الغَيلِ في أَجَمٍ وَغابِ",3,"ب",1,0],["وَفِي غَيرِهَا آياً وآياً تَتَابَعَت","لكم نَصَبٌ فِيهَا لِذِي الشَكِّ مُنصِبُ",4,"ب",1,0],["وفي غيرتي خفَّتْ وزفَّتْ نعامتي","ألا فاعذروها أن تَزِفَّ من الرأْلِ",5,"ل",1,0],["وَفي غالِبِ ظَنّي أَنَّ","هَذا الوَجهَ لا يُفلِح",6,"ح",1,0],["وفي غد انت سيف","وخنجر وسنان",7,"ن",1,0],["وفي غَدٍ فاعْلَمَنْ لِقَاؤُهُمُ","فإنّهم يَرْقُبُونَ فارْتَقِبِ",8,"ب",1,0],["وفي غَربيِّ دِجلةَ لي محلٌّ","جِوارُ المِكرُماتِ له جِوارُ",9,"ر",1,0],["وفي غيضةِ الخطيّ ليثٌ كأنما","عليه من الماذيّ لينُ غلائِلِه",10,"ل",2,0],["وَفي غَمرِ الجَوانِحِ مُستَراحٌ","لِحاجاتِ المُحِبِّ إِلى الحَبيبِ",11,"ب",1,0],["وَفِي غَدِ تَرْفُدُ الْبَنِينَا","ثُمَّ عَلَى تَقَادُمِ السَّنِينَا",12,"ن",2,0],["وفي غِنَائِكِ مِن مَحضِ اللَّذَاذَةِ في","قَلبِ اللَّبِيبِ إنزِلاَلٌ هُو قَاتِلُهُ",13,"ل",2,0],["وفيَّ غُرام للأعادي وإنني","ذليلٌ على عَتْبِ الأخِلاّء خاضع",14,"ع",1,0],["وفي غربةِ الدنيا له أيُّ حسرةٍ","ومن بعدِها لا شكَّ غربةُ سام",15,"م",1,0],["وَفي غَضَبٍ تَبَدّى المَوتُ فيهِ","عَلى سَيفَيهِما كَرّاً وَفَرّا",16,"ر",2,0],["وَفي غَدٍ إِذ تُنيرُ الطفل ميعَته","وَتهرمينَ وَيَبقى ذلِكَ الخَشَبُ",17,"ب",1,0],["وفي غِناءٍ إذا حُثَّتْ أوائلُه","أغنَى النَّدامَى عن الأنوارِ والزهَرِ",18,"ر",1,0],["وَفِي غَدِنَا أَسِيرُ بِلاَ وَادَاعٍ","فِرَاراً مِنْ ثُمَالِهِ يَا ثِمَالِي",19,"ل",2,0],["وفي غدٍ يا قومنا يشاهدُ","فتح التداني والّذين جاهدوا",20,"د",3,0],["وفي غَيظي سعيتُ إلى رِضاها","فكانَ جزاءُ إحساني الجحودا",21,"د",2,0],["وفي غفوَتي أو غفلتي جاءني الهُدى","وكانت على غيبُوبةِ النومِ يقظتي",22,"ي",1,0],["وفي غيرِ الهوى قلبي","أراه قاسياً صَلبا",23,"ب",2,0],["وَفي غُدُرِ الدُروعِ تَخوضُ حَتّى","تُريقَ مِنَ العِدا بِحُسامِكَ الدَّم",24,"م",1,0],["وَفي غَراميَ سرٌّ لا أَبوحُ به","وَللمحبّينَ أَسرارٌ خَفيّاتُ",25,"ت",1,0],["وفي غمرةٍ من شعاع الخيل","رأى كوكباً كفّنته الليال",26,"ل",1,0],["وفي غَيمِ نَقعٍ أنت كالشَّمسِ حَشْوَه","تُنيرُ ونَثْرُ التِّبرِ قَطْرُ حَياكا",27,"ك",2,0],["وَفِي غَياباتِ أَطْباقِ الخطوبِ شَجٍ","بالبَيْنِ يَيْأَسُ أَحياناً ويَنْتَظِرُ",28,"ر",1,1],["وفي غابها خصب وحسن وبهجة","وفي جوفها زيت وفي بحرها الدر",29,"ر",1,0],["وفي غدٍ من عذاب النار تخفرني","إن الشفاعة أقوى كل ذي سبب",30,"ب",1,0],["وفي غصن يميل بلا هواء","ولا نسم يداعبه قليلا",31,"ل",2,0],["وفي غيرها المجدُ الذي كان مَرّةً","لها شرفٌ في قُربه وفخارُ",32,"ر",1,0],["وفي غزل العليْاء لو تعلمونه","شفاءُ غرامٍ وادكارُ متيَّم",33,"م",1,0],["وفي غنية عنها وعن زخرفاتها","تفانيت حتى قيل ليس بمثبت",34,"ت",1,0],["وفي غدٍ يحفظُ حقاً بهم","من لفحةٍ النارِ مواليهم",35,"م",1,0],["وفي غدٍ أنا مرموسٌ بمقفرةٍ","ملْساءَ عاطلةٍ من جانبِ الخالِ",36,"ل",1,0],["وفي غدٍ تُبصرها مغيرةً","على المَوامِي كالنّعامِ الجافلِ",37,"ل",1,0],["وَفِي غَرْسِكَ إِنْ جُدْتَ","بِهِ مَعْنًى مِنَ الصِّهْرِ",38,"ر",1,0],["وفي غَدٍ يَعْرِفُ المُخَالِفُ مَنْ","خاسِرُ دينٍ لَهُمْ وَرَابِحُهْ",39,"ح",2,0],["وفي غُصنه ثمَرُ المُجْتَني","ومن وَجْهه قَمر المجْتَلِي",40,"ل",2,0],["وفي غَزَلِي ذكرُ العُذَيبِ وبارقٍ","وما ذَاك إِلا ثَغْرُه ورُضَابُه",41,"ب",2,0]]}