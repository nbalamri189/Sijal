ود الورى فله الحمد","https://www.poetsgate.com/ViewPoem.aspx?id=128841",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5431,"سريتَ إلى الأقصى كأنك فرقدُ","https://www.poetsgate.com/ViewPoem.aspx?id=187915",""],[5459,"غفوة الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=202683",""],[5493,"تاجُ اللغَات","https://www.poetsgate.com/ViewPoem.aspx?id=201747",""],[5582,"أَلا هَلْ تَوَلَّتْ نَوارٌ نَوارا","https://www.poetsgate.com/ViewPoem.aspx?id=186999",""],[5652,"حالة فراق ..!","https://www.poetsgate.com/ViewPoem.aspx?id=136926",""],[5776,"سرةٌ تبلعُ ذقنَ المصباح","https://www.poetsgate.com/ViewPoem.aspx?id=199337",""],[402,"حظيت بملء العين حسنا وروعة","https://www.poetsgate.com/ViewPoem.aspx?id=35387",""],[6124,"مَقَادِيرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=102715",""],[6124,"سواد الهدب","https://www.poetsgate.com/ViewPoem.aspx?id=109744",""],[6202,"هيهات هيهات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86756&r=&rc=57",""],[572,"أَلاَ أَبْلِغْ أَبَا بَكْرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9291&r=&rc=148",""]],"verses":[["وفي غده سلم تقربه النهى","وحلمٌ تصافى عنده الأنفس اللد",0,"د",1,0],["وفي غُمَّةٍ مَنْ لا ترى الشمسَ عينُهُ","وما نفعُ نور الشَّمسِ في الأعين الرُّمدِ",1,"د",1,0],["وفي غيومك عقم أِو بها صلف","ومالها عند مَريِ الريح ادرار",2,"ر",1,0],["وَفي غَطَفانَ فَاِجتَنِبوا حِماهُم","لُيوثُ الغَيلِ في أَجَمٍ وَغابِ",3,"ب",1,0],["وَفِي غَيرِهَا آياً وآياً تَتَابَعَت","لكم نَصَبٌ فِيهَا لِذِي الشَكِّ مُنصِبُ",4,"ب",1,0],["وفي غيرتي خفَّتْ وزفَّتْ نعامتي","ألا فاعذروها أن تَزِفَّ من الرأْلِ",5,"ل",1,0],["وَفي غالِبِ ظَنّي أَنَّ","هَذا الوَجهَ لا يُفلِح",6,"ح",1,0],["وفي غد انت سيف","وخنجر وسنان",7,"ن",1,0],["وفي غَدٍ فاعْلَمَنْ لِقَاؤُهُمُ","فإنّهم يَرْقُبُونَ فارْتَقِبِ",8,"ب",1,0],["وفي غَربيِّ دِجلةَ لي محلٌّ","جِوارُ المِكرُماتِ له جِوارُ",9,"ر",1,0],["وفي غيضةِ الخطيّ ليثٌ كأنما","عليه من الماذيّ لينُ غلائِلِه",10,"ل",2,0],["وَفي غَمرِ الجَوانِحِ مُستَراحٌ","لِحاجاتِ المُحِبِّ إِلى الحَبيبِ",11,"ب",1,0],["وفي غَطَفَانَ عِذْقُ عِزٍّ مُمَنَّعٌ","عَلَى رَغْمِ أَقْوَامٍ مِنَ النَّاسِ يَانِعُ",12,"ع",1,1],["وَفِي غَدِ تَرْفُدُ الْبَنِينَا","ثُمَّ عَلَى تَقَادُمِ السَّنِينَا",13,"ن",2,0],["وفي غِنَائِكِ مِن مَحضِ اللَّذَاذَةِ في","قَلبِ اللَّبِيبِ إنزِلاَلٌ هُو قَاتِلُهُ",14,"ل",2,0],["وفيَّ غُرام للأعادي وإنني","ذليلٌ على عَتْبِ الأخِلاّء خاضع",15,"ع",1,0],["وفي غربةِ الدنيا له أيُّ حسرةٍ","ومن بعدِها لا شكَّ غربةُ سام",16,"م",1,0],["وَفي غَضَبٍ تَبَدّى المَوتُ فيهِ","عَلى سَيفَيهِما كَرّاً وَفَرّا",17,"ر",2,0],["وَفي غَدٍ إِذ تُنيرُ الطفل ميعَته","وَتهرمينَ وَيَبقى ذلِكَ الخَشَبُ",18,"ب",1,0],["وفي غِناءٍ إذا حُثَّتْ أوائلُه","أغنَى النَّدامَى عن الأنوارِ والزهَرِ",19,"ر",1,0],["وَفِي غَدِنَا أَسِيرُ بِلاَ وَادَاعٍ","فِرَاراً مِنْ ثُمَالِهِ يَا ثِمَالِي",20,"ل",2,0],["وفي غدٍ يا قومنا يشاهدُ","فتح التداني والّذين جاهدوا",21,"د",3,0],["وفي غَيظي سعيتُ إلى رِضاها","فكانَ جزاءُ إحساني الجحودا",22,"د",2,0],["وفي غفوَتي أو غفلتي جاءني الهُدى","وكانت على غيبُوبةِ النومِ يقظتي",23,"ي",1,0],["وفي غيرِ الهوى قلبي","أراه قاسياً صَلبا",24,"ب",2,0],["وَفي غُدُرِ الدُروعِ تَخوضُ حَتّى","تُريقَ مِنَ العِدا بِحُسامِكَ الدَّم",25,"م",1,0],["وَفي غَراميَ سرٌّ لا أَبوحُ به","وَللمحبّينَ أَسرارٌ خَفيّاتُ",26,"ت",1,0],["وفي غمرةٍ من شعاع الخيل","رأى كوكباً كفّنته الليال",27,"ل",1,0],["وفي غَيمِ نَقعٍ أنت كالشَّمسِ حَشْوَه","تُنيرُ ونَثْرُ التِّبرِ قَطْرُ حَياكا",28,"ك",2,0],["وَفِي غَياباتِ أَطْباقِ الخطوبِ شَجٍ","بالبَيْنِ يَيْأَسُ أَحياناً ويَنْتَظِرُ",29,"ر",1,1],["وفي غابها خصب وحسن وبهجة","وفي جوفها زيت وفي بحرها الدر",30,"ر",1,0],["وفي غدٍ من عذاب النار تخفرني","إن الشفاعة أقوى كل ذي سبب",31,"ب",1,0],["وفي غصن يميل بلا هواء","ولا نسم يداعبه قليلا",32,"ل",2,0],["وفي غيرها المجدُ الذي كان مَرّةً","لها شرفٌ في قُربه وفخارُ",33,"ر",1,0],["وفي غزل العليْاء لو تعلمونه","شفاءُ غرامٍ وادكارُ متيَّم",34,"م",1,0],["وفي غنية عنها وعن زخرفاتها","تفانيت حتى قيل ليس بمثبت",35,"ت",1,0],["وفي غدٍ يحفظُ حقاً بهم","من لفحةٍ النارِ مواليهم",36,"م",1,0],["وفي غدٍ أنا مرموسٌ بمقفرةٍ","ملْساءَ عاطلةٍ من جانبِ الخالِ",37,"ل",1,0],["وفي غدٍ تُبصرها مغيرةً","على المَوامِي كالنّعامِ الجافلِ",38,"ل",1,0],["وَفِي غَرْسِكَ إِنْ جُدْتَ","بِهِ مَعْنًى مِنَ الصِّهْرِ",39,"ر",1,0],["وفي غَدٍ يَعْرِفُ المُخَالِفُ مَنْ","خاسِرُ دينٍ لَهُمْ وَرَابِحُهْ",40,"ح",2,0],["وفي غُصنه ثمَرُ المُجْتَني","ومن وَجْهه قَمر المجْتَلِي",41,"ل",2,0],["وفي غَزَلِي ذكرُ العُذَيبِ وبارقٍ","وما ذَاك إِلا ثَغْرُه ورُضَابُه",42,"ب",2,0],["وفي غانمٍ والهاشمَين وحمزةٍ","وفي قاسمٍ والمرتضى والمؤيد",43,"د",1,0],["وفي غرامي بالصبابة والأسى","والصبر كالسلوان فيه خائن",44,"ن",1,0],["وفي غيبها المعجوز عنه دونه","تبدت بأحوال لديه مهولة",45,"ه",1,0],["وفي غيب عيني ينظر الحق حقه","ولا هوت ناسوتي يخلق خلقه",45,"ه",1,0],["وفي غوثها بالروح سر مغيثها","كأن المعاني في حروف حديثها",45,"ه",2,0],["وفي غير ما نَظْمٍ تضمّن ذكرَهُمْ","موفّىً بما حازوا قديماً من السّرْوِ",46,"و",1,0],["وَفي غَيرِهِم مَدحُ امْلّبيبِ أَخي امْحِجى","مِن امْهَجْو في أَدنى حَضيضٍ مِن امْهُجْرِ",47,"ر",1,0],["وَفي غَدٍ أَجعله خَطيبا","وَإِن يَشأ أَجعَله طَبيبا",48,"ب",2,0],["وَفي غَدٍ آتي إِلى عناقك","فَلا تُؤاخذني عَلى فِراقك",49,"ك",1,0],["وَفي غَدِ يَومِهِ ضُرِبَت لَدَيهِ","هُنالِكَ قُبّة تُنسي القِبابا",50,"ب",2,0],["وفي غلبات الوجد مكنون سره","مذاع فلا سدل بستر على سر",51,"ر",1,0],["وَفِي غَدٍ إنْ شَاءَ رَبُّ العُلَى","أسْتَغْنِمُ اللُّقْيَا بِكُمْ وَالسَّلاَمْ",52,"م",1,0],["وفي غورث إذ جاءه وفاضلة","وشيبة إعلام بكشف المخادع",53,"ع",1,0],["وفي غراسته للنخل آي الهدى","قد أظهرت سر إعجاز لمن فهما",54,"م",2,0],["وفي غدٍ سوف نمضي","كما أتينا سراعا",55,"ع",2,0],["وفي غد عند شدة العطش ال","أكبر يسقي عطاش أمته",56,"ت",2,0],["وَفي غَدٍ تُبصِرُهُ آمِناً","لِخَوفِهِ اليَومَ مِنَ اللَهِ",57,"ل",2,0],["وفي غده وافى إِلى بيت عامر","يدق عليه الباب قبل ضيا الفجر",58,"ر",1,0],["وَفي غَرامك ما بَينَ الوَرى اِشتَهَرَت","فَتِلكَ روح بِمَجلى الغَيب قَد ظَهَرَت",59,"ت",1,0],["وفي غمرة من صداع الألم","ترامى اليك حنين القمم",60,"م",1,0],["وفي غيرِ نورِك لم تَرمُقِ","أضاءَ سناكَ لها مُبرِقا",61,"ق",2,0],["\"و\" في غيثه الثجاج \"للمعتفي