{"poems":[[53,"أكبح النفس إن جمحت","https://www.aldiwan.net/poem29629.html","مجزوء الخفيف"],[53,"أسل بدمعك وادي الحي إن بانوا","https://www.aldiwan.net/poem29743.html","البسيط"],[30,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[47,"الدين مخترم والحق مهتضم","https://www.aldiwan.net/poem25156.html","البسيط"],[51,"إن الدمشقي عبد حاجته","https://www.aldiwan.net/poem9260.html","المنسرح"],[89,"فقدت مصر فهي سكرى المآقي","https://www.aldiwan.net/poem44745.html","الخفيف"],[85,"يا سادة واسوا الفقير","https://www.aldiwan.net/poem7796.html","مجزوء الرجز"],[85,"قف بالممالك وانظر دولة المال","https://www.aldiwan.net/poem63752.html","البسيط"],[43,"أعددت للغادرين أسيافا","https://www.aldiwan.net/poem9731.html","المنسرح"],[45,"أقصرا قد أطلتما تفنيدي","https://www.aldiwan.net/poem63541.html","الخفيف"],[45,"ألا شعرت برحلة الأظعان","https://www.aldiwan.net/poem66685.html","الكامل"],[49,"لايذهبن بك الأمل","https://www.aldiwan.net/poem63077.html","مجزوء الكامل"],[80,"أنكرت سقم مذاب الجسد","https://www.aldiwan.net/poem31487.html","الرمل"],[105,"طال التحجب فارفع الأستارا","https://www.aldiwan.net/poem42078.html","الكامل"],[105,"جددوا الذكرى لأهل المشرق","https://www.aldiwan.net/poem42122.html","الرمل"],[105,"أرأيت حكمة سيد الكرماء","https://www.aldiwan.net/poem44034.html","الكامل"],[21,"لا يذهبن بك التفريط منتظرا","https://www.aldiwan.net/poem36180.html","البسيط"],[50,"راجعت دينك أم عنت لك الذكر","https://www.aldiwan.net/poem63829.html","البسيط"],[50,"قل للتي هجرت حولين عاشقها","https://www.aldiwan.net/poem63872.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[106,"الربيع الحائل","https://www.poetsgate.com/ViewPoem.aspx?id=179488",""],[116,"يا مصطفى الرحمن يا أحمد","https://www.aldiwan.net/poem41132.html","عموديه"],[144,"سل المقادير ما أحببته تجب","https://www.aldiwan.net/poem11725.html","البسيط"],[367,"أنا منك للأيام عاتب","https://www.aldiwan.net/poem17341.html","مجزوء الكامل"],[381,"هل للمحب المستهام رفيق","https://www.aldiwan.net/poem49204.html","الكامل"],[404,"يا نسيما أذكى لهيب اشتياقي","https://www.aldiwan.net/poem33624.html","الخفيف"],[563,"نزع القريض إلى حمى نقاشه","https://www.aldiwan.net/poem52908.html","الكامل"]],"verses":[["لا يَذِلُّ العَزيزُ إِل","لَا إِذا رامَ مَسَّها",0,"ه",2,0],["لا يُذكَرُ الرَملُ إِلّا حَنَّ مُغتَرِبٌ","لَهُ بِذي الرَملِ أَوطارٌ وَأَوطانُ",1,"ن",1,0],["لا يَذخَرانِ مِنَ الإيغالِ باقِيَة","حَتّى تَكادُ تَفَرّى عَنهُما الأُهُبُ",2,"ب",1,0],["لايُذكَرونَ إِذا مامَعشَرٌ ذُكِروا","وَلا يُحَكَّمُ في أَمرٍ لَهُم حَكَمُ",3,"م",1,0],["لا يذكرُ الخِلَّ عند ذلك في","ضغطة دهرٍ ولا انفراجتِهِ",4,"ت",2,0],["لا يذم الحياة الا فريق","ما لهم من لذاتها من خلاق",5,"ق",1,0],["لا يذهب الخير سدى","ومن يُعِن يوما يُعَن",6,"ن",1,0],["لا يَذهَبِ الدَهرُ بَينَ التُرَّهاتِ بِكُم","وَبَينَ زَهرٍ مِنَ الأَحلامِ قَتّالِ",7,"ل",1,0],["لا يُذكَرُ الخَيرُ إِن ذُكِرتَ وَلا","تُتبِعُكَ المُقلَتانِ تَوكافا",8,"ف",2,0],["لا يَذودُ الحَديدَ عَن أَعظُمِ الأَس","ؤُقِ حَتّى يَذوقَ طَعمَ الحَديدِ",9,"د",1,0],["لا يَذهَبَنَّ عَلَيكِ فَرطُ صَبابَتي","وَتَرادُفُ الكَمَدِ الَّذي أَبلاني",10,"ن",2,0],["لايَذهَبَنَّ بِكَ الأَمَل","حَتّى تُقَصِّرَ في العَمَل",11,"ل",1,1],["لا يَذوقُ المِيلُ فيها إِثمداً","ما لأَحدَاقِ المَها والإِثمِدِ",12,"د",1,0],["لا يذهبنَّ بناؤُكم فبقاؤُه","أن تجعلوا الأخلاقَ فيه جِدارا",13,"ر",2,0],["لا يذوقُ الموتَ من يطعَمُها","فَاصْبَحِ القومَ بها ثمَّ اغْبِقِ",14,"ق",1,0],["لا يذكرِ الأقوامُ أنّ محمداً","يَجزِي الأُلى صَحبُوه شرَّ جَزاءِ",15,"ا",2,0],["لا يَذهَبنَّ بِكَ التَفريطُ مُنتَظِراً","طولَ الأَناةِ وَلا يَطمَع بِكَ العَجَلُ",16,"ل",1,1],["لا يَذكُرُ الدَهرَ أَو يَسري الخَيالُ لَهُ","إِلّا تَغَنّى بِها أَو مَسَّهُ ضَرَرُ",17,"ر",1,0],["لا يَذكُرُ القَلبُ مِن خَودٍ زِيارَتَها","في سالِفِ الدَهرِ إِلّا اِهتَزَّ أَو مادا",18,"د",2,0],["لأيِّ ذكرى وأيِّ ماضٍ","يَسْرِي بها خاطرٌ ويَهْفو",19,"و",1,0],["لا يذهبُ المعروفُ في لُجَّةٍ","ولا يَكُفُّ الْمِسْكُ عن نَشْرِه",20,"ر",2,0],["لا يذوِ زهرُك في الربيع؛ فإنما","هذا أوان تفتح الأزهار",21,"ر",1,0],["لا يذكر الله على غير ما","سن ولا يدعى ولا يعبد",22,"د",1,0],["لا يُذهِلِ الناسَ ما خُوِّلتَ مِن شَرَفٍ","فَمَن سَعى سَعيَكَ اِستَولى عَلى القَصَبِ",23,"ب",1,0],["لا يُذكِرَنكِ يا سَوا","كِبُ جودَهُ إِلّا السَواكِب",24,"ب",1,0],["لا يَذهلنكَ عَن التَوَكُل فاضل","حرم الثَراء وَجاهل مَرزوق",25,"ق",1,0],["لا يذوق المنام طَرْفي المعنى","وصبوحي من أدمعي واغتباقي",26,"ق",2,0],["لا يذكُرُ الإنسانُ أمرَ مَعادِهِ","إذ كان مُشتَغِلاً بأمر مَعاشِهِ",27,"ش",2,0]]}