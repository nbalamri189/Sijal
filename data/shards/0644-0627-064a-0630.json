{"poems":[[55,"أكبح النفس إن جمحت","https://www.aldiwan.net/poem29629.html","مجزوء الخفيف"],[55,"أسل بدمعك وادي الحي إن بانوا","https://www.aldiwan.net/poem29743.html","البسيط"],[32,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[49,"الدين مخترم والحق مهتضم","https://www.aldiwan.net/poem25156.html","البسيط"],[53,"إن الدمشقي عبد حاجته","https://www.aldiwan.net/poem9260.html","المنسرح"],[91,"فقدت مصر فهي سكرى المآقي","https://www.aldiwan.net/poem44745.html","الخفيف"],[87,"يا سادة واسوا الفقير","https://www.aldiwan.net/poem7796.html","مجزوء الرجز"],[87,"قف بالممالك وانظر دولة المال","https://www.aldiwan.net/poem63752.html","البسيط"],[45,"أعددت للغادرين أسيافا","https://www.aldiwan.net/poem9731.html","المنسرح"],[47,"أقصرا قد أطلتما تفنيدي","https://www.aldiwan.net/poem63541.html","الخفيف"],[47,"ألا شعرت برحلة الأظعان","https://www.aldiwan.net/poem66685.html","الكامل"],[51,"لايذهبن بك الأمل","https://www.aldiwan.net/poem63077.html","مجزوء الكامل"],[82,"أنكرت سقم مذاب الجسد","https://www.aldiwan.net/poem31487.html","الرمل"],[107,"طال التحجب فارفع الأستارا","https://www.aldiwan.net/poem42078.html","الكامل"],[107,"جددوا الذكرى لأهل المشرق","https://www.aldiwan.net/poem42122.html","الرمل"],[107,"أرأيت حكمة سيد الكرماء","https://www.aldiwan.net/poem44034.html","الكامل"],[21,"لا يذهبن بك التفريط منتظرا","https://www.aldiwan.net/poem36180.html","البسيط"],[52,"راجعت دينك أم عنت لك الذكر","https://www.aldiwan.net/poem63829.html","البسيط"],[52,"قل للتي هجرت حولين عاشقها","https://www.aldiwan.net/poem63872.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[108,"الربيع الحائل","https://www.poetsgate.com/ViewPoem.aspx?id=179488",""],[119,"يا مصطفى الرحمن يا أحمد","https://www.aldiwan.net/poem41132.html","عموديه"],[147,"سل المقادير ما أحببته تجب","https://www.aldiwan.net/poem11725.html","البسيط"],[371,"أنا منك للأيام عاتب","https://www.aldiwan.net/poem17341.html","مجزوء الكامل"],[385,"هل للمحب المستهام رفيق","https://www.aldiwan.net/poem49204.html","الكامل"],[409,"يا نسيما أذكى لهيب اشتياقي","https://www.aldiwan.net/poem33624.html","الخفيف"],[567,"نزع القريض إلى حمى نقاشه","https://www.aldiwan.net/poem52908.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122795","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122748","البسيط"],[173,"","https://poetry.dctabudhabi.ae/diwan/poem/29611","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100996","البسيط"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131529",""],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87825","الخفيف"],[1982,"","https://poetry.dctabudhabi.ae/diwan/poem/206292","الكامل"],[2005,"","https://poetry.dctabudhabi.ae/diwan/poem/105229","الرمل"],[2309,"","https://poetry.dctabudhabi.ae/diwan/poem/140201",""],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28587","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60900","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/61013","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60873","البسيط"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100514","الرمل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65137","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132763","الخفيف"],[119,"","https://poetry.dctabudhabi.ae/diwan/poem/105953","الخفيف"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74076","السريع"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91069","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206166","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216511","الكامل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119410","الخفيف"],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/145916","الكامل"],[4359,"","https://poetry.dctabudhabi.ae/diwan/poem/141162","الطويل"],[4388,"","https://poetry.dctabudhabi.ae/diwan/poem/115331","البسيط"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119526","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72620","السريع"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72525","الرمل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35108","البسيط"],[4767,"الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=87657",""],[4797,"ريقك عسل","https://www.poetsgate.com/ViewPoem.aspx?id=71826",""],[5072,"يا رمزنا أنت قد بعناك","https://www.poetsgate.com/ViewPoem.aspx?id=53759",""],[3591,"هذا السّريّ إذا نظرت لوجهه","https://www.poetsgate.com/ViewPoem.aspx?id=149444",""],[5197,"يا عظيم الأنبياء","https://www.poetsgate.com/ViewPoem.aspx?id=131027",""],[5232,"ألحان السَّلام","https://www.poetsgate.com/ViewPoem.aspx?id=213566",""],[5582,"أَتِلْكَ لِلحَيِّ أَحْداجٌ وَأَظْعانُ","https://www.poetsgate.com/ViewPoem.aspx?id=63592",""]],"verses":[["لا يَذِلُّ العَزيزُ إِل","لَا إِذا رامَ مَسَّها",0,"ه",2,0],["لا يُذكَرُ الرَملُ إِلّا حَنَّ مُغتَرِبٌ","لَهُ بِذي الرَملِ أَوطارٌ وَأَوطانُ",1,"ن",1,0],["لا يَذخَرانِ مِنَ الإيغالِ باقِيَة","حَتّى تَكادُ تَفَرّى عَنهُما الأُهُبُ",2,"ب",1,0],["لايُذكَرونَ إِذا مامَعشَرٌ ذُكِروا","وَلا يُحَكَّمُ في أَمرٍ لَهُم حَكَمُ",3,"م",1,0],["لا يذكرُ الخِلَّ عند ذلك في","ضغطة دهرٍ ولا انفراجتِهِ",4,"ت",2,0],["لا يذم الحياة الا فريق","ما لهم من لذاتها من خلاق",5,"ق",1,0],["لا يذهب الخير سدى","ومن يُعِن يوما يُعَن",6,"ن",1,0],["لا يَذهَبِ الدَهرُ بَينَ التُرَّهاتِ بِكُم","وَبَينَ زَهرٍ مِنَ الأَحلامِ قَتّالِ",7,"ل",1,0],["لا يُذكَرُ الخَيرُ إِن ذُكِرتَ وَلا","تُتبِعُكَ المُقلَتانِ تَوكافا",8,"ف",2,0],["لا يَذودُ الحَديدَ عَن أَعظُمِ الأَس","ؤُقِ حَتّى يَذوقَ طَعمَ الحَديدِ",9,"د",1,0],["لا يَذهَبَنَّ عَلَيكِ فَرطُ صَبابَتي","وَتَرادُفُ الكَمَدِ الَّذي أَبلاني",10,"ن",2,0],["لايَذهَبَنَّ بِكَ الأَمَل","حَتّى تُقَصِّرَ في العَمَل",11,"ل",1,1],["لا يَذوقُ المِيلُ فيها إِثمداً","ما لأَحدَاقِ المَها والإِثمِدِ",12,"د",1,0],["لا يذهبنَّ بناؤُكم فبقاؤُه","أن تجعلوا الأخلاقَ فيه جِدارا",13,"ر",2,0],["لا يذوقُ الموتَ من يطعَمُها","فَاصْبَحِ القومَ بها ثمَّ اغْبِقِ",14,"ق",1,0],["لا يذكرِ الأقوامُ أنّ محمداً","يَجزِي الأُلى صَحبُوه شرَّ جَزاءِ",15,"ا",2,0],["لا يَذهَبنَّ بِكَ التَفريطُ مُنتَظِراً","طولَ الأَناةِ وَلا يَطمَع بِكَ العَجَلُ",16,"ل",1,1],["لا يَذكُرُ الدَهرَ أَو يَسري الخَيالُ لَهُ","إِلّا تَغَنّى بِها أَو مَسَّهُ ضَرَرُ",17,"ر",1,0],["لا يَذكُرُ القَلبُ مِن خَودٍ زِيارَتَها","في سالِفِ الدَهرِ إِلّا اِهتَزَّ أَو مادا",18,"د",2,0],["لأيِّ ذكرى وأيِّ ماضٍ","يَسْرِي بها خاطرٌ ويَهْفو",19,"و",1,0],["لا يذهبُ المعروفُ في لُجَّةٍ","ولا يَكُفُّ الْمِسْكُ عن نَشْرِه",20,"ر",2,0],["لا يذوِ زهرُك في الربيع؛ فإنما","هذا أوان تفتح الأزهار",21,"ر",1,0],["لا يذكر الله على غير ما","سن ولا يدعى ولا يعبد",22,"د",1,0],["لا يُذهِلِ الناسَ ما خُوِّلتَ مِن شَرَفٍ","فَمَن سَعى سَعيَكَ اِستَولى عَلى القَصَبِ",23,"ب",1,0],["لا يُذكِرَنكِ يا سَوا","كِبُ جودَهُ إِلّا السَواكِب",24,"ب",1,0],["لا يَذهلنكَ عَن التَوَكُل فاضل","حرم الثَراء وَجاهل مَرزوق",25,"ق",1,0],["لا يذوق المنام طَرْفي المعنى","وصبوحي من أدمعي واغتباقي",26,"ق",2,0],["لا يذكُرُ الإنسانُ أمرَ مَعادِهِ","إذ كان مُشتَغِلاً بأمر مَعاشِهِ",27,"ش",2,0],["لا يَذكُرُ النّاسُ شَمسانَا وَلا حَلَباً","وَلا بُراشَ وَلا خَباً وكُحلانَا",28,"ن",2,0],["لا يَذبَحُ الشّاةَ إجلالاً لِطارِقِه","وَلا كَرامَةَ ما لَم تُنحَرِ النَّعَمُ",29,"م",1,0],["لا يَذكُرُ اللَهَ إِلّا عِندَ رابِيَةٍ","يَرقى وَعِندَ اِرتِجاسِ الرَعدِ وَالمَطَرِ",30,"ر",1,0],["لا يذكرون سوى مصرٍ وما لقيت","ما غَيرُ مصرٍ لهم نَجوى ولا سَمَر",31,"ر",1,0],["لا يذكر الأهل إن غائب ذكر","ولا يهزه إلى أوطانه نزوع",32,"ع",1,0],["لائِذٌ بِالفِرارِ مِن دَهرِهِ الطا","غي وَأَينَ المَفَرُّ مِن أَرزائِه",33,"ا",3,0],["لا يذهبن عليك في العواد","ضعف القوى وتفتت الأكباد",34,"د",1,1],["لا يذيع الشوق من يعرفه","أين مبدي الشوق ممن كتما",35,"م",2,0],["لا يذوقون منه مر سؤال","في أمور تعيي البليغ الحدادا",36,"د",2,0],["لا يَذكُروا حَلَباً وَبيضُكَ دونَها","مَشهورَة فَهيَ الظُّبا وَهُمُ هُمُ",37,"م",1,0],["لا يذكر الناسُ النخِيلَ وماءَه","إلاّ حننتُ لمائه المورودِ",38,"د",1,0],["لا يذكر أسمي قط في تهليلة","للخلق إلا يذكر اسمك في الأثر",39,"ر",1,0],["لا يذكرُ اسمُكَ في بادٍ ولا حضرٍ","إلا كأن منك فيه ألف عطار",40,"ر",1,0],["لائذاً بالعسكريين التقيي","ين أوفى الخلق عند اللَه جاها",41,"ا",3,0],["لا يذبُلُ الوردُ النّضيرُ بخده","يوما لما يُسقيه من ماء اللّمى",42,"م",2,0],["لا يذل العزيز في الناس قدراً","ويهون الذي به يستهين",43,"ن",1,0],["لائذ في حماك والدمع يجري","شغله أنت لا سواك وتدري",44,"ي",1,0],["لا يذكرون سوى الدنيا وزينتها","تبا لهم غفلوا عن ذكر ربهم",45,"م",1,0],["لا يَذهَب السقم بِعَزمي وَلا","تقعد بي عين رَقيب وواش",46,"ش",1,0],["لا يذهلنك مقبل أَو مدبر","فَحقيقة العَيش النَضير فَناء",47,"ا",2,0],["لا يُذل الشيوخَ في العيش إلا","كافر بالحياة والأقدار",48,"ر",1,1],["لا يذهبن بك القنوط فربما","عاد الصباح وأنت لاه تطرب",49,"ب",1,0],["لا يذوق الاغفاء الا رجاء","أن يرى طيف مستميح رواحا",50,"ح",2,0],["لا يذبح الجندي طِرفا للوغى","إلا بمرسوم الإمام إذا خرج",51,"ج",1,0],["لا يذكرن اللبيب أمر غد","أفي عناء أم رغدْ",52,"د",1,1],["لا يذكرونَ علياً في مشاهِدهم","ولا بنيه بني البيضِ الميامينِ",53,"ن",1,0],["لائذاً بعضه ببعض كقوم","في عتاب مكرّر واعتذار",54,"ر",1,0],["لائذة قد أخذت حذرها","من وقع نبل عينك الأخرى",55,"ر",2,0],["لائذاني بعبد القادر الغوث العظيم","وبكهف الشيخ نوري ذلك النور المجسد",56,"د",1,0],["لا يَذهَلَنَّ لِتَقليلٍ أَخو سَبَبٍ","مِنَ الأُمورِ وَلا يَركَن لِتَكثيرِ",57,"ر",1,0],["لا يذكرها أو يعرفها","إلا أصحاب العضوية",58,"ي",2,0],["لايذبح الموضوع قل اهتمامك","طعني وشوفلك شيخ يفتليك اليوم",59,"م",1,0],["لِأي ِّ ذُل ٍّ وصلنا في تهاونِنا ؟؟","والعار ُ فينا لحد ِّ الفكر ِ ينجذب ُ",60,"ب",1,0],["لا يذبل الهجران عود مودّتي","أبداً ويبقى عود ودّي يورق",61,"ق",1,0],["لائذًا بالستر أسعى مُهْطِعًا","لشفيعٍ صفحه كل الرجاء",62,"ا",2,0],["لا يذوقُ المرءُ سمَّا ً قاتلا ً","لا ولا يُسقى من الموت ِ الزؤامْ",63,"م",1,0],["لا يَذْمُمُ الدَّهْرُ أَلفاظِي فإِنَّ لَها","سِرًّا تَوافَقَ فِيها الإِنْسُ وَالجانُ",64,"ن",1,0]]}