ة","https://www.poetsgate.com/ViewPoem.aspx?id=180193",""],[5219,"القول المسدد في معارضة همزية أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=193910",""],[572,"صَدَّتْ مخاشَنة ً نوارُ","https://www.poetsgate.com/ViewPoem.aspx?id=25012",""],[572,"منْ يَتُبْ خشية َ العقابِ فإنِّي","https://www.poetsgate.com/ViewPoem.aspx?id=25008",""],[5409,"أنت والحق في العلو سواءُ","https://www.poetsgate.com/ViewPoem.aspx?id=155491",""],[5431,"وفؤادي مولّه ما تخلى","https://www.poetsgate.com/ViewPoem.aspx?id=196916",""],[5442,"اعمل حساب النفس عن هفواتها","https://www.poetsgate.com/ViewPoem.aspx?id=114757",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5700,"يصنع الحق باليقين رجالا","https://www.poetsgate.com/ViewPoem.aspx?id=138929",""],[5956,"الاشتهاء","https://www.poetsgate.com/ViewPoem.aspx?id=181904",""],[5956,"أَمَرَ البصيرُ نبيَّه","https://www.poetsgate.com/ViewPoem.aspx?id=192631",""],[5309,"من اعد العيش فوق السحب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573523",""],[463,"سلْ في الغضا وصبا الأصائل تنفحُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60009&r=&rc=65",""],[6251,"وجه الهلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76470&r=&rc=10",""],[6265,"المهاجرة اليمنية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84177&r=&rc=0",""],[6352,"هي دار غيبته فحي قبابها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22743&r=&rc=4",""]],"verses":[["وَرَأَت وَخطَ بَياضٍ طارِقٍ","وَخَطَ التَهمامُ قَلبي فَوُخِط",0,"ط",1,0],["وَرَأَتْ شَيْبيَ الرَّبابُ فَقالتْ","ما جَناهُ فُقُلتُ حُبُّ الرَّبابِ",1,"ب",1,0],["ورأت ولي العهد فازدانت به","فكأنها قبس يسيل تضرما",2,"م",2,0],["وَرَأَت بِأَنَّ الشَيبَ جا","نَبَهُ البَشاشَةُ وَالبَشارَه",3,"ر",2,0],["وَرَأَت طَبيعَتُكَ الكَريمَةُ نقضَ ما","عَوَّدتَها مِن شيمَةِ الإِسرافِ",4,"ف",1,1],["وَراتِعينَ وَراءَ البَحرِ في دعةٍ","لَهُم بِأَوطانِهِم عِزٌّ وَسلطانُ",5,"ن",1,0],["ورأت جبيناً دونه شمس الضحى","لَبَّتْكَ بالإِجلال والإِكبارِ",6,"ر",1,0],["وَرَأَت أُمامَةُ في العِظامِ تَحَنِّياً","بَعدَ استِقامَتِها وَقَصراً في الخُطا",7,"ا",1,0],["وَرَأَت بِلِحيَتِهِ خِضاباً راعَها","وَالوَيلُ لِلفَتَياتِ مِن خَضبِ اللِحى",7,"ا",1,0],["وَرَأَت حُسَينَةُ بِالعَدابِ فَوارِسي","تَحوي النِهابَ وَتَقسِمُ الأَنفالا",8,"ل",2,0],["ورأت قُضاعة في الأيا","من رأى مثبُورٍ وثابرْ",9,"ر",1,1],["ورأت صَلْصَلاً بفضل علاه","شهدت في الورى صحابٌ وأعدا",10,"د",2,0],["ورأته وجوهُ قوم وِضاءٍ","فرأت وجهَه وضيئاً صبيحا",11,"ح",2,0],["ورأتك أيسر مهلكاً ورزيةً","من دعستين بأيرِ عيرٍ أغرلِ",12,"ل",1,0],["ورأت لهاك عفاتَها أكفاءها","فغدت هناك عواصياً من يعضلُ",13,"ل",1,0],["ورأت أبا العباس عينُك بالغاً","ما قد بلغتَ مُحارباً ومُسالما",14,"م",2,0],["ورأتْ أنَّكَ لم تحفلْ بها","حين دلَّتْك على قصدِ السَّنن",15,"ن",1,0],["وَرَأَت فيها اللَيالي مَقتَلاً","فَرَمَتها فَأَصابَت مُدبِرَه",16,"ر",2,0],["وَرَأَت عَيناكَ غَضبَتُهُ","فَبَكَت خَوفَ الرَدى بِدَمِ",17,"م",1,0],["وَرَأَت بِهِ مَن تَبتَغي","وَكَما رَأَتهُ كذا رَآها",18,"ا",3,0],["ورأتْنِي كذا فلم تتمالَكْ","أن أمالتْ علَيَّ عِطْفَاً وجِيدَا",19,"د",2,0],["ورأتُ وما عرفتْ نزاهةَ شِيمَتي","أني على جُرَعِ الحِياضِ ألُوبُ",20,"ب",1,0],["وَرَأَت عِندَ غَيرِهِم مِن مَديحي","مِثلَ ما كانَ عِندَهُم مِن عِتابي",21,"ب",2,0],["وَرَأَت جِلادَ مُحَبَّبٍ لَم تُخزِهِ","يَوماً مَواقِفُهُ لَدى الأَحبابِ",22,"ب",1,0],["وَرَأَت لِمَّةً أَلَمَّ بِها الشَي","بُ فَريعَت مِن ظُلمَةٍ في شُروقِ",23,"ق",1,0],["وَرَأَتني تَدارَكَ الحِلمُ مِنّي","وَتَناهى عَن عَذلِيَ العُذّالُ",24,"ل",1,0],["ورأت عيني أكاذيب الهوى","واهيات كخيوط العنكبوت",25,"ت",1,0],["وَرَأَت شُحوباً رابَها في جِسمِهِ","ماذا يُريبُكِ مِن جَوادٍ مُضمَرِ",26,"ر",1,0],["وَرَأَتكَ كُفؤاً فَاِنتَحَتكَ عَلى النَوى","وَالبُعدِ بَعدَ السِتَّةِ الأَقطارِ",27,"ر",1,0],["وَرَأَت شُعوبُ الأَرضِ مِن نَهضاتِهِ","مِلءَ العُقولِ الواعِياتِ ذُهولا",28,"ل",2,0],["وَرَأَتكَ تَطلُعُ في الوَغى فَتَطَلَّعَت","فَرَحاً إِلَيكَ وَأَقبَلَت تَتَرَقَّبُ",29,"ب",1,0],["ورأَتْهُ خديجةٌ والتُّقَى وال","زُّهْدُ فيه سجيَّةٌ والحياءُ",30,"ا",2,0],["وَرَأَت عُجاباً شَيبَتي فَبَكَت","جَزَعاً لَها وَالدَهرُ ذو شَغبِ",31,"ب",1,0],["ورأتْ نجيبكَ فاستفاض حنانُها","لسميِّه المرجوِّ في الأحفادِ",32,"د",1,0],["ورأت صُفرةَ الأسى في شفاهٍ","أحرقتها الأنفاسُ والأقداحُ",33,"ح",1,0],["ورأت كفَّيهِ يَندى منهما","أرَجُ الزَّهر فأجَّتْ نظرتاها",34,"ا",3,0],["ورأتْ في صميمَها لَوْعَةَ الحُز","نِ وأصْغَتْ إلى صُراخِ القُلوبِ",35,"ب",1,0],["ورأتْ جَبيناً كالصبا","حِ أضاء مُعْتَكِرَ الدياجرْ",36,"ر",1,0],["ورأتْ مُنىً قدسيَّةً","دقَّ الزمانُ لها البشائرْ",36,"ر",1,0],["ورأت مخَايلَ دَوْلَةٍ","فوْقَ النجوم لها معَابرْ",36,"ر",1,0],["ورأت رجاءَ النيلِ في","ثوبٍ من الإيمان طاهرْ",36,"ر",1,0],["ورأت بَوادرَ هِمَّةٍ","أعظِمْ بهاتيكَ البَوادرْ",36,"ر",1,0],["ورأت سَرِيرة خاشعٍ","سَجدَتْ لخشيتهِ السرائرْ",36,"ر",1,0],["وَرَأتْ مِصْرُ فِيه عِزّاً مَنِيعاً","ومَثَاباً رَحْباً وَرُكْناً شَدِيدا",37,"د",2,0],["ورأتْ بشائرَ يُمنها في طَلْعَةٍ","تُغْني بها البسَماتُ عن إفصاحها",38,"ح",3,0],["ورأت في ابن فؤَادٍ ناشئاً","يملأ الدنيا ويُحيي أممَا",39,"م",2,0],["ورأت عجاباً شيبتي عجباً","إنَّ العجائبَ في \"أبي حربِ\"",40,"ب",1,0],["ورأت جسمه على كرم العنصر","سجّان كنزها المرصود",41,"د",1,0],["ورأت أنك لم تحفل به","حين دلِّتك على قصد السنن",42,"ن",1,0],["ورأت أمامة في العظام تحنياً","بعدَ استقامته وقصراً في الخطا",43,"ا",1,0],["ورأت كلابُ الحىّ رِيبتَنا","فكَرُمن عن نبح وعن هَرِّ",44,"ر",1,0],["وَرَأَت نُمَيرٌ أَنَّ سُخطَكَ عارِضٌ","إِن لَم يُداوُوهُ بِعَفوِكَ غالا",45,"ل",2,0],["ورأت مخائل فيكَ طفلاً ما ترى","فيمن يكون ولا بمن قد كانا",46,"ن",2,0],["ورأت ذؤال العز في الذل الذي","خرت لديك به على الأذقان",47,"ن",1,0],["ورأتْ تاريخهُ مبتكَرا ً","ومتى تجدي الرؤى المبتكرة",48,"ر",2,0],["ورأتْ لساني كالسِّنانِ ذلاقةً","فتذكّرَتْهُ يومَ كلِّ جِلاد",49,"د",1,0],["ورأتْ أكبدَ الورى في ثراها","فمشتْ من دلالها في الهواءِ",50,"ا",2,0],["ورأت غبارَ الليلِ ينفضِ فوقها","في الأفقِ فانطبقتْ كعينِ الأرمدِ",51,"د",1,0],["وَرَأَت مِن جَبينِهِ الجُرحَ يُدمي","وَرَأَت فَوقَ وُجنَتَيهِ الحِماما",52,"م",2,0],["وَرَأَت يا لِهَولِ ما قَد رَأَتهُ","شَبَحَ الروحِ دامِعاً بَسّاما",52,"م",2,0],["ورأتْ عيونَ الكاشحين وأَقبلت","تَصِفُ الهوى بتَخَالُسِ الآماق",53,"ق",1,0],["ورأت إثر ما محوت فقالت","كان لصّا فصار والله فَصّا",54,"ص",2,0],["ورأت قصور الشام حين تشعشعت","أنواره وتباشرت حضاره",55,"ر",2,0],["وَرَأَت بِهِ البَرَكات مِنذُ غَدَت بِهِ","وَأَتانُها في الرَّكبِ خَيرُ أَتانِ",56,"ن",1,0],["وَرَأَت لِواءَ الفَجرِ مَن","شوراً فَأَعجَلَها الذَهابُ",57,"ب",1,0],["وَرَأَتْ مِنْهُ الذِي يُو","ضِحُ بَيْنَ النَّاسِ زَيْنَكْ",58,"ك",1,0],["ورَأتني أصبُو إلى ذلك الخَصر","فأهدت منه السقامَ لجسمي",59,"م",2,0],["وَرَأَتْه لها الإمَارَةُ أَهْلاً","فأَراها بعِبْئِها اسْتِقْلالا",60,"ل",2,0],["ورأتهُ العذراءُ يرمقها حبا","فراحت بنظرة منه سكرى",61,"ر",2,0],["ورأت في هواه أمنيةَ القلب","وراحت تنيله الوصل سرا",61,"ر",2,0],["ورأت حاضراً تلطّخ بالعار","وأضحى من الفضيلة صفرا",61,"ر",2,0],["وَرَأت محاسنه الملوكُ فأَذعَنت","لكنّها بِعيونهم أقذاءُ",62,"ا",2,0],["وَرَأَت سِهامَكَ لَم تَصِدها فَاِلتَوَت","وَاِختَلَّ قَلبُكَ إِذ رَمَتكَ سِهامُها",63,"م",3,0],["ورأتني حيران منتهب العين فحي","ت بالطلعة الفتّانه",64,"ن",2,0],["ورأتني روحاً معطّرة الحس","نِ وقلباً مجمّعا من نقاءِ",65,"ا",2,0],["ورأته روحى عالماً ما فيه","للسلوى مكان",66,"ن",1,0],["ورأتني شاعر النظرة","فارتاحت إليا",67,"ي",2,0],["وَرأتكَ تَشكُو غِلظَةً","قصَرَت يَمينكَ عَن نَداكا",68,"ك",2,0],["ورأت صروفُ الدهر ذلك فرصةً","فتبادرَت نحوي تروحُ وتَغتَدي",69,"د",2,1],["ورأت به النساك مَخبَرَ نُسكِهم","إذ شُفَّ منه فؤاده والأضلع",70,"ع",1,0],["ورأت سمات الأريحية والندى","ودلائل المعروف والإقدام",71,"م",1,0],["وَرَأَت فَوارِسَ مِن صُلَيبَةِ وائِلٍ","صَبَروا إِذا نَقعُ السَنابِكِ ثارا",72,"ر",2,0],["ورأَتْ ما رأَتْ صِقِلِّيَّةٌ من","هُ فَحَقٌّ أَنْ فاخَرَتْ بغدادا",73,"د",2,0],["ورأتْ بديعَ جمالِها فتبسّمتْ","عن لؤلؤ بمثالِه تتقلّدُ",74,"د",1,0],["ورأتهم أحلام جيل وجي","رقصت كالضياء لحنا وشرا",75,"ر",2,0],["ورأت حُبور الناسِ دفأ مُنعشاً","من بَعدِ ما كان الجليدُ ثقيلا",76,"ل",2,0],["ورأتْ في العين من أشباهِها","من قبيلٍ وعديدٍ ما كفاها",77,"ا",3,0],["ورأت على بعد السؤال نصيبهَا","إن النباهة بالسؤال خمولُ",78,"ل",1,0],["ورأت ضعضعةً بَي","ن سكوني وحَرا