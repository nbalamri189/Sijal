{"poems":[[487,"أحديقة رقّمت بوشي أزاهر","https://www.aldiwan.net/poem24435.html","عموديه"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100154","البسيط"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117552","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46522","الرجز"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95123","المجتث"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205055","الطويل"]],"verses":[["فقلت طروس جوامع ببرودها","فاقت رياض فضائل بالراض",0,"ض",1,0],["فقلت طابت لنا البشرى فإن إلى","أكناف ربع أمين اللَه مأوانا",1,"ن",2,0],["فقلتُ طريقُ الحبِّ أصبحَ مُحظراً","مخوفاً فلم تسلك بغيرِ رفيقِ",2,"ق",1,0],["فَقُلت طب نَفساً فَهَذا مَنزل","رَحب وَكنٌ وَالجَميل أَجمَل",3,"ل",1,0],["فَقلتُ طَابَ زمَاني","لَمَّا بدَت لِي زُهُورُ",4,"ر",1,0],["فقلت طريق البر كان طريقه","وهل تغرق الأقدار من سلك البرا",5,"ر",2,0]]}