نّ وبئسَ ما حملت يَدي","يوم اللحاظِ الضاربان الأيدِ",81,"د",1,0],["بئس الزمانُ المرتدي بشِرارِ","يتبدَّل الأخيارَ بالأشرارِ",82,"ر",1,1],["بئس أولها ويابئس المصير","فالحذر منهم فإني لك حذير",83,"ر",1,0],["بئس الغلوُّ فإنَّهُ لَسجيَّةٌ","للمارقينَ ، خيارُها أشرارُها",84,"ر",3,0],["بئس التنطُّعُ لا مكانَ لأهلهِ","في أمَّة درْبُ الرَّشادِ مسَارُها",84,"ر",3,0],["بئس التقدِّم حين يسرق حرَّةً","من حِرْزِها حتى يضيعَ خِمارُها",84,"ر",3,0],["بئسَ التَّقدُّم حين يصبحُ نكسةً","في الدينِ تنشُرُ بيننا أفْكارُها",84,"ر",3,0],["بِئسَ شِعارُ الرَّجلِ الشَّعارَهْ","يُلبِسُهُ ذُلُّ المَعاشِ عارَهْ",85,"ر",2,1],["بِئسَتِ الأُمُّ رَقوبٌ أكثَرَتْ","وُلدَها ثمَّ رَمتْهُمُ بِقِلاها",86,"ا",3,0],["بئستِ الأمُّ رَمَتْ أولادَها","برزاياها ألا بِئْسَ الصَّنيعُ",87,"ع",1,0],["بيَ سُكرٌ منهُ وسِحْرٌ فلا أُر","قَى لهذا ولستُ من ذا أُفيقُ",88,"ق",1,0],["بئس الصداقة عقباها العداوات","وشرها دخنة فيها الهدنات",89,"ت",1,1],["بئسَ السفارةُ تضليلاً وسُخريةً","كأنما هي تمثيلٌ لعميانِ",90,"ن",1,0],["بي سقيمَ الخصر أعدى صحّتي","أهيفَ القامة يزري بالقضيب",91,"ب",1,1],["بئس الذين قد استبدلتهم عوضا","منها فهذا وأيم الله خسران",92,"ن",1,0],["بئس ما نابه ضلالا وزوراً","هو في حكم غيِّه مخذول",93,"ل",1,0],["بئسَ الرجولةُ إِذْ تهادنُ وَعْيَها","وتضيقُ بالنَّزَقِ الشَّقِيِّ وطِفْلِهِ !!",94,"ل",2,0],["بئسَ المواعيدُ رَتَّبْنَا الهواءَ لها","ثُمَّ التقينا مجازًا في قوافينا",95,"ن",2,0],["بئسَ الغُبارُ الذي في عينِ صاحبهِ","كان القَذَى منهُ لمَّا ثار يَنتشِبُ",96,"ب",1,0],["بئسَ الحَياةُ التي مَوجودُها عَدَمٌ","يا لَيتَ لا كانَ موجودٌ ولا عَدَمُ",97,"م",1,0],["بئسَ الحياةُ التي طابت أوائلها","إن لم يكن طابَ منها حُسنُ مُختَتَمِ",98,"م",1,0],["بئسَ الحياةُ حياةٌ لا رَجاء لها","ما بينَ تصويبِ أنفاسٍ وتصعيدِ",99,"د",1,0],["بئس القرينُ العيشُ لمَّا","مِتَّ يا نِعْمَ القَرِينُ",100,"ن",1,0],["بِئسَ الفُحولَةُ حينَ جُدَّتَهِم","عَركُ الرِهانِ وَبِئسَ ما يَخِلوا",101,"ل",3,0],["بئس الحياة حياة كلها كدر","وهل يكون اخو البأساء جذلانا",102,"ن",2,0],["بئس العواهر كم جهولا أغرقت","في لج بحر مصائب وبلاء",103,"ا",2,0],["بئست من