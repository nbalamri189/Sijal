5431,"نارٌ بقلبي ودرب الصالحين دمي..","https://www.poetsgate.com/ViewPoem.aspx?id=190512",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[5691,"بيت الغرابيب","https://www.poetsgate.com/ViewPoem.aspx?id=206248",""],[5759,"سنظلُّ نبكي","https://www.poetsgate.com/ViewPoem.aspx?id=212934",""],[5956,"حفيداي الطفلان أحمد وعابد","https://www.poetsgate.com/ViewPoem.aspx?id=206260",""],[5309,"أولعت بالعدل لا الأحداث تلهيني","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573551",""],[5309,"فرخ من الجن بين المجرمين ربي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573553",""],[5309,"ألشعر عاطفة بروحك تلمع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573519",""],[520,"بئس الكتاب غدت كفى تسطره","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577554",""],[186,"جهد الحزين إذا صرف القضا نزلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55793&r=&rc=56",""],[6192,"هل أتاكم حديث الخيول ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63746&r=&rc=12",""],[6202,"عجز الضعيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86736&r=&rc=37",""],[6238,"بِئسَ الهوى...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86778&r=&rc=7",""],[6255,"الحُزْنُ جَادَ أَبًا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80883&r=&rc=11",""],[581,"أَطردتني حذر الهجاء ولا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69748&r=&rc=35",""]],"verses":[["بِئسَ التَحِيَّةُ بَينَنا المُرّانُ","وَضِرابُ يَومِ وَقيعَةٍ وَطِعانُ",0,"ن",1,1],["بِيُسراهُ بُرهانٌ مِنَ اللَهِ ساطِعٌ","هُدىً وَبِيُمناهُ الكِتابُ المُطَهَّرُ",1,"ر",1,0],["بِئسَ المُناخُ رَفيعٌ عِندَ أَخبِيَةٍ","مِثلِ الكُلى عِندَ أَطرافِ البَراعيمِ",2,"م",1,1],["بِئسَ الفَوارِسُ يا نَوارُ مُجاشِعٌ","خورٌ إِذا أَكَلوا خَزيراً ضَفدَعوا",3,"ع",3,0],["بِئسَ الفَوارِسُ يَومَ نَعفِ قُشاوَةٍ","وَالخَيلُ عادِيَةٌ عَلى بِسطامِ",4,"م",1,1],["بِئسَ الجَزاءَ جَزَيتُم في بَني حَسَنٍ","أَبوهُمُ العَلَمُ الهادي وَأُمُّهُمُ",5,"م",1,0],["بِئسَ البَنونَ وَبِئسَ الشَيخُ شَيخُهُمُ","تَبّاً لِذَلِكَ مِن شَيخٍ وَمِن عَقِبِ",6,"ب",1,0],["بِئسَ ما قاتَلَت خَيابِرُ عَمّا","جَمَعَت مِن مَزارِعٍ وَنَخيلِ",7,"ل",1,1],["بئس البُنَا هِي في المسا","جد والديار فلا تَلِجْ",8,"ج",1,0],["بئستْ لَعمرُ الله تلك طبيعةً","حَرمتْ أبانا قرب أكرم جارِ",9,"ر",1,0],["بئسما بدَّلتَها في لحدِها","بالذي رجَّتْهُ من عائدتِكْ",10,"ك",1,0],["بئسَ التحيةُ حياها الوزير ضُحىً","والحفل من سرواتِ القومِ قد حَفلا",11,"ل",2,0],["بِئسَ ما كافأتَ ما أهْ","دَاهُ من حُرِّ الهدايا",12,"ا",3,0],["بِئسَ الصُحاةُ وَبِئسَ الشَربُ شُربُهُمُ","إِذا جَرى فيهِمِ المُزّاءُ وَالسَكَرُ",13,"ر",1,0],["بِئسَ الفَوارِسُ عِندَ مُعتَرَكِ القَنا","عِدلا الحِمارِ مُحارِبٌ وَسَلولُ",14,"ل",1,1],["بِئسَ القَضاءُ الَّذي في الأَرضِ أَوجَدَني","عِندي الجَمال وَغَيري عِندَهُ النَظَرُ",15,"ر",1,0],["بِئسَ المَدينَةُ إِنَّها سِجنُ النُهى","وَذَوي النُهى وَجَهَنَّمُ الأَحرارِ",16,"ر",1,0],["بِئسَ الوَغى يَجني الجُنودُ حُتوفَهُم","في ساحِها وَالفَخرُ لِلتيجانِ",17,"ن",1,0],["بِئْسَتِ الأَفْراحُ أَفْراحُ الحَيَاهْ","إنَّها أَحْلاَمْ",18,"م",1,0],["بئس مثوى المعززين على ال","أرض ضريح يبلي الكلى والنخاعا",19,"ع",2,0],["بِئسَ اللَيالي سَهِرتُ مِن طَرَبي","شَوقاً إِلى مَن يَبيتُ يَرقُدُها",20,"د",3,0],["بِئسَ المُرَجّى لِلفَتاةِ يَصونُها","وَالمُرتَجى لِصَلاحِ أَمرِ فاسِدِ",21,"د",1,0],["بِئسَت لَقوحاً ذي العِيالِ اِمتَنَحتُما","عَلوقانِ مَن يَعطِفهُما غَيرُ مَريَمِ",22,"م",1,1],["بِئسَ مَن عاشَ في الحَياةِ شَقِيّاً","كاسِفَ اللَونِ هائِماً مُلتاحا",23,"ح",2,0],["بِئسَ ما يسمعُ مِن تَعظيمِها","مَلَكا القبرَ بِهِ مِن مَلِكَيك",24,"ك",1,0],["بئس الفَتَى يقضِي الحُقوقَ رِفاقُه","في النّائباتِ وَمَالُه مَذحورُ",25,"ر",1,0],["بِئسَ الجَزاءُ وَرُبَّما كانَ الأَذى","عَدلاً لِمَن يَأَلو العَدُوَّ قِراعا",26,"ع",2,0],["بِئسَت حَضارَةُ هادِمينَ رَموا بِها","شُمَّ الفَضائِلِ وَالعُلا فَهَوَينا",27,"ن",2,0],["بِئسَ الدُعاةُ سَبيلُهُم مُتَجانِفٌ","وَدَليلُهُم جَمُّ المَعاثِرِ أَنكَدُ",28,"د",1,0],["بَئسَت حَياةٌ حَمَّلَتكَ خُطوبُها","داءً يَهُدُّ الراسِياتِ عُضالا",29,"ل",2,0],["بِئسَ الأميرُ وبئسَ القومُ إذ جعلوا","لك الإمارَةَ كيما يُداركوا الظَّفرا",30,"ر",2,0],["بِئسَ العطاءُ وبِئسَ القومُ أمرُهُم","وأمرُ سيّدهم في الغَيِّ مُؤتلِفُ",31,"ف",1,0],["بِئسما تُورِدُها أهواؤُها","مِن حياضٍ مُرّةٍ ما تُورَدُ",32,"د",1,0],["بِئْسَ الجنودُ أضلّتهم عَمَايَتُهُمْ","فما لهم بجنودِ اللهِ من قِبَلِ",33,"ل",1,0],["بئس المآبُ لعصبةٍ تأبى الهُدَى","بِيضاً مَعالمُه ونعمَ المقدم",34,"م",1,0],["بئسَ الكتابُ عَوَيْتَ فيه ولن ترى","ضِرغامَة الوادي يخاف العاويا",35,"ي",2,0],["بئس المغيرُ انقضَّ في غِرّةً","على لقاحِ الغابةِ الهمَّل",36,"ل",1,0],["بِئسَ المُروءَةُ مِن ذَوي حَسَبٍ","جاعَت قَرابَتُهُم وَقَد ثَمِلوا",37,"ل",3,0],["بِئسَ الشَوانِيُّ لَهُ مَنصِبٌ","في آلِ نِهيا غَيرُ مُرتادِ",38,"د",1,0],["بِئسَ العَطِيَّةُ مِن حُبّى لَنا حَجَرٌ","بَل لَيسَ لي حَجَرٌ مِنها وَلا عودُ",39,"د",1,0],["بِئسَ ما يَأمُرونَ مُستَشعِرَ الهَم","مِ يُقاسي مِن عَبدَةَ الأَتراحا",40,"ح",2,0],["بِئسَ الشَهادَةُ إِذا سَأَلتَ شَهادَةٌ","يَرجو المُلاطِفُ قَرضَها وَقِراضَها",41,"ض",3,1],["بِئسَ المَعاشِرُ إِن ناموا فَلا اِنتَبَهوا","مِنَ الرُقادِ وَإِن غابوا فَلا رَجَعوا",42,"ع",3,0],["بِئسَ العَشيرُ أَنا الغَداةَ","وَصَاحِبي مِثلي فَإِنّي ما نَدِمتُ وَلا نَدِم",43,"م",1,0],["بِئسَتِ الأُمُّ لِلأَنامِ هِيَ الدُن","يا وَبِئسَ البَنونَ لِلأُمِّ نَحنُ",44,"ن",1,0],["بِئْسَ حَالاً بُدِّلَتْ من أُنْسِهَا","وَحْشَةً أو من صلاحِ العيشِ غَي",45,"ي",1,0],["بِئسَ ما قُلتَ لا تَظُنَّنَّ أَنّي","سامِعٌ قَولَ قائِلٍ إِن بَغاها",46,"ا",3,0],["بئس الليالي سهدت من طربي","شوقاً إلى من يبيت يرقدها",47,"د",3,0],["بِئْسَ الْعَشِيرُ وَبِئْسَتْ مِصْرُ مِنْ بَلَدٍ","أَضْحَتْ مُنَاخاً لأَهْلِ الزُّورِ وَالْخَطَلِ",48,"ل",1,0],["بِئْسَتْ رَسُولُ الشَّر تِلْ","كَ وَبِئْسَ وَالِدَةُ الغُمَمْ",49,"م",1,0],["بِئْسَ الفرِيسَةَ عَظْمٌ لا اهْتِياضَ لَهُ","يُغْرِي بِهِ الْحَتْفَ ذِئْباً شَفَّهُ الْجُوعُ",50,"ع",1,0],["بئسَ الشفاهُ التي تغتر باسمةً","وفي الضلوع مصاريعٌ مكاميدُ",51,"د",1,0],["بئس السيوف اذا حلت عواتقكم","وما بها لعتيق المجد أحزان",52,"ن",1,0],["بئس عمر حتم استرجاعه","ريثما حل رأيناه قفل",53,"ل",1,0],["بئس القرارة أ