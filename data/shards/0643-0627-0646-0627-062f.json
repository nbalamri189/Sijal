{"poems":[[88,"أثرت بنا من الشوق القديم","https://www.aldiwan.net/poem68868.html","الوافر"],[32,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[68,"وفى لي فيك الدمع إذ خانني الصبر","https://www.aldiwan.net/poem40123.html","الطويل"],[48,"ماءنا بالواغل يوما على ال","https://www.aldiwan.net/poem22868.html","السريع"],[78,"ورادعة بأنفاس العبير","https://www.aldiwan.net/poem39303.html","البسيط"],[164,"إِذا سفك الدماء لديك حلا","https://www.aldiwan.net/poem58931.html","الوافر"],[170,"وشادن قد بكى عشقا فأعجبني","https://www.aldiwan.net/poem47093.html","البسيط"],[203,"مدادك في ثغر الزمان رضاب","https://www.aldiwan.net/poem45382.html","الطويل"],[230,"نحن لله ما لحي بقاء","https://www.aldiwan.net/poem55098.html","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48785","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108953","البسيط"],[1912,"","https://poetry.dctabudhabi.ae/diwan/poem/145722","الطويل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96026","الخفيف"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100725","البسيط"],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26993","الوافر"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86504","الطويل"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105503","الخفيف"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76758","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139718",""],[5145,"يا أكرم الناس لا مستثنياً أحداً","https://www.poetsgate.com/ViewPoem.aspx?id=108251",""],[5616,"كمل النصاب","https://www.poetsgate.com/ViewPoem.aspx?id=203468",""]],"verses":[["كَأَنَّ أَديمَها أَحشاءُ صَبٍّ","قَدِ اِلتَهَبَت مِنَ الوَجدِ الأَليمِ",0,"م",1,0],["كَأَنَّ أُدمانَها وَالشَمسُ جانِحَةٌ","وَدعٌ بِأَرجائِها فَضٌّ وَمَنظومُ",1,"م",1,0],["كَأَنَّ أَديمَ الأَرضِ قُدَّ مِنِ اِسمِهِ","فَما وُجِدَت إِلّا وَفيها لَهُ ذِكرُ",2,"ر",1,0],["كانَ أَديماً لِمَجَسِّ الأَذى","يَلتَمِسُ الرِزقَ مَعَ الجارِشِ",3,"ش",1,0],["كأنَّ أديمَها ذهبٌ عليهِ","أكاليلٌ منَ الدُّرِّ النَّثيرِ",4,"ر",1,0],["كأَن أديمها الفضي لما","تلمَّع صفرة بالتّبر يُطلي",5,"ل",2,0],["كأنَّ أدمعَهُ والعينَ تسفكُها","درٌّ وهى فَهَوى من جانب العقد",6,"د",1,0],["كأنَّ أديمَ الليل طرسٌ كتبتهِ","وفيهِ تباشيرُ الصباحِ عتابُ",7,"ب",1,0],["كانَ أدرى المَلا بكَسبِ ثناءٍ","آهِ لو خلَّدَ النُفوسَ ثَناء",8,"ا",2,0],["كأن أديم هذي الأرض لما","مشت فيها مواكبهم حرير",9,"ر",1,0],["كأن آدم بالأيتام وكَّلَه","فما يقاتون إلّا من معاطيه",10,"ي",2,0],["كأن أديمَ الجوِّ جوشنُ فارسٍ","وقد جعلت نثرَ النجوم مسامره",11,"ر",2,0],["كان أدلى بها اليك قبور","كنت مغري الجشا بفرط هواها",12,"ا",3,0],["كأن أدمعهم تنهل واكفة","تهطال غيث ملث الودق مدرار",13,"ر",1,0],["كَأَنَّ أَديمَهُ نِصفاً بِنِصفٍ","مِنَ الذَهَبِ الدِلاصِ أَو الوَذيلِ",14,"ل",1,0],["كأن أديم الأرض ملسٌ مخطط","بألوان نجم من مضيءٍ وكامد",15,"د",1,0],["كان أدلى بها الضلال حقوداً","ورثتها آباؤها الأبناءا",16,"ا",3,0],["كأنّ أديم الأرض راحة كفّه","وفي بسطها قبض على كل مجرم",17,"م",1,0],["كأن أديم وجه الأرض أضحى","يعدُّ لنعل ارجله طراقا",18,"ق",2,0],["كأن آدم لما حفّ محمله","وصّى إليك بأهليه وما ولدا",19,"د",2,0],["كأنا دون خلق الله صرنا","غثاءً لا نعيب ولا نُعاب!",20,"ب",1,0]]}