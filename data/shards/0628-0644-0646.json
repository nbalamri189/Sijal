{"poems":[[95,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[53,"كل نفس لموقت ليس حي بمفلت","https://www.aldiwan.net/poem8698.html","مجزوء الخفيف"],[87,"يحكون أن أمة الأرانب","https://www.aldiwan.net/poem8038.html","الرجز"],[71,"قالوا بدا الشعر أما تشعر","https://www.aldiwan.net/poem28916.html","السريع"],[50,"لست بدار عفت وغيرها","https://www.aldiwan.net/poem62428.html","البسيط"],[202,"بلنسية إذا فكرت فيها","https://www.aldiwan.net/poem51960.html","الوافر"],[264,"يا من يغيث الورى من بعد ما قنطوا","https://www.aldiwan.net/poem35529.html","البسيط"],[275,"الخمر في كأسها الياقوت والماس","https://www.aldiwan.net/poem35295.html","البسيط"],[280,"بلنسية يا عذبة الماء والجنى","https://www.aldiwan.net/poem25468.html","الطويل"],[445,"أنورك أم أوقدت بالليل نارك","https://www.aldiwan.net/poem34885.html","الطويل"],[454,"بوركت من نهضة","https://www.aldiwan.net/poem975.html",""],[464,"بلنسية بيني عن القلب سلوة","https://www.aldiwan.net/poem4034.html","الطويل"],[563,"لا معه نحن ولا معنا","https://www.aldiwan.net/poem33753.html","السريع"],[563,"غير الوجود محال","https://www.aldiwan.net/poem34222.html","المجتث"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138390",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138427",""],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77635","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77533","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77614","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77526","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64592","الكامل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78173","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53211","السريع"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60929","البسيط"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115743","الرمل"],[2957,"","https://poetry.dctabudhabi.ae/diwan/poem/198454","المتقارب"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133959","الرجز"],[3162,"","https://poetry.dctabudhabi.ae/diwan/poem/142907","الخفيف"],[3471,"","https://poetry.dctabudhabi.ae/diwan/poem/56446","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110024","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109990","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36771","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102948","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35097","الطويل"],[4644,"","https://poetry.dctabudhabi.ae/diwan/poem/146125","الرمل"],[4767,"بدور شعبان","https://www.poetsgate.com/ViewPoem.aspx?id=197676",""],[4927,"وفاء عفراء","https://www.poetsgate.com/ViewPoem.aspx?id=29604",""],[4927,"سلي القلب","https://www.poetsgate.com/ViewPoem.aspx?id=29656",""],[5131,"ودَّعتُهُ وعلى فؤادي حسرةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=175584",""],[5186,"طاب يا نشء في نهاك الثناء","https://www.poetsgate.com/ViewPoem.aspx?id=156455",""],[5212,"نِداءُ الحُسين","https://www.poetsgate.com/ViewPoem.aspx?id=212030",""],[307,"هلْ زجّ في الأملِ القنوطُ سقاما","https://www.poetsgate.com/ViewPoem.aspx?id=213805",""],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5365,"في رثاء الشاعر العراقي عبد الرزاق عبد الواحد","https://www.poetsgate.com/ViewPoem.aspx?id=191061",""],[5436,"سكن المجد(جواد بركات علي)","https://www.poetsgate.com/ViewPoem.aspx?id=35148",""],[5614,"صرخة القدس","https://www.poetsgate.com/ViewPoem.aspx?id=1356",""],[5725,"انوار محمد","https://www.poetsgate.com/ViewPoem.aspx?id=177543",""],[5956,"ضربتْ سكوني يا إلهُ شجونُها","https://www.poetsgate.com/ViewPoem.aspx?id=192384",""],[454,"بوركت من نهضة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82681&r=&rc=45",""]],"verses":[["بَلْ نُصْرَةَ العُرْبِ فِي حَقٍ أُقِرَّ لَهُمْ","تُؤَيِّدُ الشَّرْعَ فِيهِ حُجَّةُ الغَلَبِ",0,"ب",1,0],["بل نوالاً مُصَبِّحاً","ضاحكاً عَنْ مُنَبِّتِ",1,"ت",1,0],["بَل نَظَروا إِلى كَمالِ العَقلِ","وَاِعتَبَروا في ذاكَ سِنَّ الفَضلِ",2,"ل",1,0],["بل نحلُّهُ قدَ رامَ مِنْ ثغرِهِ","شهداً وخوفُ البرقِ لا يجسرُ",3,"ر",1,0],["بَل نَحنُ أَربابُ ناعِطٍ وَلَنا","صَنعاءُ وَالمِسكُ مِن مَحارِبِها",4,"ب",3,0],["بلنسيةُ إذا فكَّرتَ فيها","وفي آياتها أسْنَى البلاد",5,"د",1,1],["بل نقطة في بحار العفو قد سقطت","وهل تقاسُ بفيض الأبحر النقط",6,"ط",1,0],["بل نادِمَنَّ الألى شاقت كياسَتُهم","إن الكؤوسَ بها قد خُصَّ أكياس",7,"س",1,0],["بَلَنْسِيَّةٌ يَا عَذْبَةَ المَاءِ وَالجَنَى","سُقِيتِ وَإِنْ أَشْقَيْتِ صَوْبَ الرَّواجِسِ",8,"س",1,1],["بَلَنْسِيَةً مثوى الأَمانِيَّ فاطلُبي","كنوزَكِ فِي أَقطارِها وادِّخَارَكِ",9,"ك",1,0],["بل نهضة كلنا أضحى يشاهده","نخالها في رحاب الأرض تيارا",10,"ر",2,0],["بَلَنسِيَةً بَيني عَنِ القَلبِ سُلوَةً","فَإِنَّكِ رَوضٌ لا أَحِنُّ لِزَهرِكِ",11,"ك",1,1],["بل نحن أمر واحد كلنا","إشارة القوسين أو أدنى",12,"ن",2,0],["بل نحن لا شيء لكن","هذا كلام يقال",13,"ل",1,0],["بل نجنا من كل شر","ير علينا منعما",14,"م",2,0],["بل نجنى كل الثمار فلا تقل","من كل فاكهة بها زوجهان",15,"ن",1,0],["بَل نامَ لِلمَقدور تَحتَ خَصمِه","حَتّى سَقاهُ المَوت مِن كَأس فَمِه",16,"ه",1,0],["بَل نامَ لِلمَكتوب وَالأَقدار","وفَوَّض الأَمر لحُكم الباري",17,"ي",1,0],["بَل نَظَر الحُفرة أَرضاً مُقفِرَه","خالِية مِن كُل فلس وَفّرَه",18,"ه",1,0],["بَل نظرتها هَذِهِ الحَمامه","وَهيَ بِوَجه الماء في نَدامه",19,"ه",1,0],["بل نعبد الرب الذي عرفاننا","إياه عرفان بأن لن نعرفه",20,"ف",2,0],["بَل نَحنُ أَقوام نَصوغ مِن الهُدى","حكماً يَفوهُ بِها لِسان الشادي",21,"د",2,0],["بل نفوس تنمي لنشر ثناكم","قد أُعيدت سنية نشأتاها",22,"ا",3,0],["بل نفسي شوقاً إلى وصلكمْ","تحت الدجى مشتعل ذو اضطرام",23,"م",1,0],["بَل نَحنُ أسعَدُ مِنهُمُ بِالحقِّ إذ","قُلنَا هُمَا باللهِ قَائِمَتَانِ",24,"ن",1,0],["بَل نِسبَةُ الرَّحمَنِ عِندَ فَرِيقِهِم","لِلعَرشِ نِسبَتُهُ إلى البُنيَانِ",24,"ن",1,0],["بَل نَفسُ آدَمَ عِندَهُم عَينُ المُحَا","لِ وَلَم يَكُن فِي سِالِفِ الأزمَانِ",24,"ن",1,0],["بل نعمةٌ لطريقٍ حين تسلكها","ولا يزال مُلِثُّ الغيث يُسقيها",25,"ي",3,0],["بل نظام الدين في النظ","م وفي النثر إمام",26,"م",1,0],["بلنسية بلدة جنة","وفيها عيوب متى تُختَبر",27,"ر",1,1],["بل نسبة النحو لإصلاح الكلام","كنسبة الملح لإصلاح الطعام",28,"م",1,0],["بل نلاقي الغفران عن كل ذنب","ونلاقي عند المليك الثوابا",29,"ب",2,0],["بَلْ نَحْنُ كُنَّا أَهْلَها فأَبادَنا","صُروفُ الليالي والجدودُ العواثِرُ",30,"ر",1,1],["بل نِصفُهُ بَشَرٌ قد راق منظرُهُ","ونصفُهُ كاسرٌ بالطبع مفتتكُ",31,"ك",1,0],["بل نورُها ابهى وابهجُ","من بها نُورِ الرقيعِ",32,"ع",1,0],["بَل نُقطَةُ الذات المُحي","طةِ وَالعَريَّة عَن زَمَن",33,"ن",1,0],["بَل نَسيجُ مِن وَردِ جُورَ وَنِسرِينِ","نَصِيبِينَ لُحمَةٌ وسَدَاءُ",34,"ا",2,0],["بل نقطة مغموسة من عنبر","كتبت بها أكرومة وسداد",35,"د",1,0],["بَلَنسِيَةٌ تِلكَ الزَبَرجَدَةُ الَّتي","تَسيلُ عَلَيها كُلُّ لُؤلُؤَةٍ نَهرا",36,"ر",2,0],["بل نكافيه به أضعافه","إن من يفس لنا نخر له",37,"ه",1,0],["بل نال أجرَ الحج زائرُه","فاسأل تجبك بذلك السير",38,"ر",1,0],["بِلَنْدُنَ، وَالْمَزَاْرُ بِهَاْ بَعِيْدٌ","وَفِيْهِ كُلُّ شَيْطَاْنٍ غَوِيِّ",39,"ي",1,0],["بِلَنْدُنَ سَطَّرْنا حِكايةَ حُبِّنَاْ","ولكِنَّنَا كُنَّا نُلامُº وَنَعْشَقُ",40,"ق",1,0],["بل نستكينُ لكِّل أمرٍ حازبٍ","وليبقَ ما في القلب سرًا مضمرا",41,"ر",2,0],["بل نأى زورق النجاة وفي بح","ر المصابين تكثر الأنواء",42,"ا",2,0],["بَلْ نورُ عَرْشِ اللهِ شَعَّ بِأحرُفٍ","ياءٌ وَنونٌ بَعْدَ حاءٍ بَعْدَ سينْ",43,"ن",1,0],["بل نبتغي لُطفَ الجليلِ بحرفِنا","فرضاؤه يبقى هدى سلاما",44,"م",2,0],["بل نثبت الذات والأوصاف كاملة","كما به الله والمعصوم قد وصفا",45,"ف",2,0],["بل نحن قلنا واستفاض بأننا","نقول ولا نخشى عداء ولوما",46,"م",2,0],["بل نحن أنكرنا كإنكار مالكٍ","لقائل زرنا القبر لا مسجد المهد",47,"د",1,0],["بل نحن أنكرنا عليكم مقالكم","بفرضية التقليد فرضاً محتما",48,"م",2,0],["بل نحنُ مَن مِتْنا وذاكَ دليلُنا","فانظُر - فَدَيتُكَ -فالدّيارُ بَوَارُ",49,"ر",1,0],["بل نعصرُ الدمع ان فاضت غواربُهُ","ونقلعَ الجرحَ من آثاره دَرنا",50,"ن",2,0],["بل نريد اليوم أمجاد الأولى","كصلاح الدين ظرغام الوغى",51,"ا",1,0],["بل نهتدي ومحمدُّ انواره","شهبُ العُلئ للنيّرات هِلالا",52,"ل",2,0],["بل نادراً ما نلتقي مجموعة","ذات اقتدارٍ والفداء شؤونُها",53,"ن",3,0],["بل نهضة كلنا أضحى يشاهدها","نخالها في رحاب الأرض تيارا",54,"ر",2,0]]}