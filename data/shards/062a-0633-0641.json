{"poems":[[53,"إذا تغنت شنطف مرة","https://www.aldiwan.net/poem65930.html","السريع"],[107,"ذراني أقم للشعر في مصر مأتما","https://www.aldiwan.net/poem43370.html","الطويل"],[77,"قامت تميس كما تدافع جدول","https://www.aldiwan.net/poem69047.html","الكامل"],[7,"أتاركة تدللها قطام","https://www.aldiwan.net/poem1967.html","الوافر"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29355","الطويل"],[240,"ملكت قلبي في الحكم فاحتكمي","https://www.aldiwan.net/poem31767.html","المنسرح"],[276,"خيال سعد أسعف بالمزار","https://www.aldiwan.net/poem52064.html","الوافر"],[303,"يا حسنها طويثره","https://www.aldiwan.net/poem36842.html","عموديه"],[347,"أنشد الشعر وحي الشهداء","https://www.aldiwan.net/poem55389.html","الرمل"],[463,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[463,"انظر معي فهي نظرة أمم","https://www.aldiwan.net/poem55899.html","المنسرح"],[463,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[473,"يا من هو الأم لنا والأب","https://www.aldiwan.net/poem60460.html","السريع"],[556,"فطيب رياها المقام وضوأت","https://www.aldiwan.net/poem47234.html","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101018","الطويل"],[3092,"","https://poetry.dctabudhabi.ae/diwan/poem/216356","الكان كان"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112662","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91551","الرمل"],[3271,"راهب الغرب","https://www.poetsgate.com/ViewPoem.aspx?id=103195",""],[4045,"نفّر نومي الخبر الساري","https://www.poetsgate.com/ViewPoem.aspx?id=200300",""],[5431,"بك وحيٌ وكلّهم أصنام ....","https://www.poetsgate.com/ViewPoem.aspx?id=202157",""],[2598,"لِسَانُكَ مِنْ شكْرٍ ثَقِيلٌ عَنِ التُّقَى","https://www.poetsgate.com/ViewPoem.aspx?id=20732",""],[5751,"صفرُ وَدِلاءْ","https://www.poetsgate.com/ViewPoem.aspx?id=214712",""],[5776,"(أُتْسُوعةُ الهلاك )","https://www.poetsgate.com/ViewPoem.aspx?id=205841",""]],"verses":[["تسفيلُنا أملحُ من وجهِها","فما تبالي القال والقيلا",0,"ل",2,0],["تَسُفُّ فَتُردي الواضِعينَ وَتَرتَقي","إِلى النَفرِ العالينَ في القَومِ سُلَّما",1,"م",2,0],["تُسْفَى على وجْهِ الصّباحِ كأنّما","في كلّ شارِقَةٍ كثيبٌ أهْيَل",2,"ل",1,0],["تَسَفُّ بَريرَهُ وَتَرودُ فيهِ","إِلى دُبُرِ النَهارِ مِنَ البَشامِ",3,"م",1,0],["تسفهته عن ماله إذ رأيته","غلاما كغصن البائنة المتغايد",4,"د",1,0],["تَسفَحُ عَيني دَموعَها أَسَفاً","عَلى زَمانٍ بِالسَفحِ لَم يَدُمِ",5,"م",1,0],["تسفهني العَواذِل فيه جهلا","وَما عذري سوى خلق العذار",6,"ر",1,0],["تسفُّ ثم ترتقي","كريشةٍ محيَّره",7,"ر",2,0],["تسفك الدمعة من مهجتها","زفرة حرى وناراً ودماء",8,"ا",2,0],["تَسفَهُ في ملامي","لو لم يسعْك حلمي",9,"م",2,0],["تسفِر عن أوجه السعود التي","كانت حياءً بالأمس تلتثمُ",10,"م",1,0],["تَسفِرُ في الحاجات وهي عدّة","على بلوغِ ما ابتغَى سُفَّارُها",11,"ر",3,0],["تُسفِرُ عَنها جَونَةٌ وَجهُها","لِنافِرِ الشَهوَةِ مُستَجذِبُ",12,"ب",1,0],["تسفَّهْتَ لمّا أنْ مررتَ بدارها","وعوجلتَ دون الحِلْمِ أنْ تتحلّما",13,"م",2,0],["تسف بالأحكام غير موفق","وما ظالم في حكمه بموفق",14,"ق",1,0],["تسف في قربانك","سحت الحرام ولا تسل",15,"ل",1,0],["تسفي على جسومِها الرياح","وهي لذؤبانِ الفَلا تُباحُ",16,"ح",1,0],["تسفكون الدَمعَ أَنتُم في الحَشا","إِنّ هَذا مِن أَعاجيبِ الزَمَن",17,"ن",1,0],["تسفِكُ الرّوحَ باللظى وهي ثملى","راوياتٌ من الدماء سُكارى",18,"ر",2,0],["تسفى الرياح الترب من فوقهم","نسجا بإقبال وإدبار",19,"ر",1,0],["تسفك الروح إنْ أردت صعودا","لمقام بلاطه إجرامُ!!",20,"م",1,0],["تَسُفُّ مِنَ الصَّهْباءِ صِرْفاً تَخَالُها","جَنَى النَّحْلِ يُهْدِيهِ إلَيْكَ صَدِيقُ",21,"ق",1,0],["تَسِفُّ مِنْ روحِهِ جَمراً يؤَيِّدُها","حتى إذا اختمرتْ ذابتْ بمَوقدِهِ",22,"د",2,0],["تَسَفْيَنَتِ الطائراتُ","وَدَعوشَ فيما نُكِتْ",23,"ت",1,0]]}