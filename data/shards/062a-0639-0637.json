ttps://www.poetsgate.com/ViewPoem.aspx?id=183315",""],[5956,"يا كوكب العلم","https://www.poetsgate.com/ViewPoem.aspx?id=194140",""],[5956,"شكراً شربنا القهوة الغراءَ","https://www.poetsgate.com/ViewPoem.aspx?id=208050",""],[5956,"يا ليتك تصبح كجواد","https://www.poetsgate.com/ViewPoem.aspx?id=208052",""],[6052,"وقفة على البحر الميت","https://www.poetsgate.com/ViewPoem.aspx?id=35193",""],[6127,"يا نونُ ... يا قلمُ","https://www.poetsgate.com/ViewPoem.aspx?id=188718",""],[6134,"اطلعت نور الهدى للناس في الظلم","https://www.poetsgate.com/ViewPoem.aspx?id=169520",""],[6142,"سل كربلا والوغى والبيض والأسلا","https://www.poetsgate.com/ViewPoem.aspx?id=155747",""],[6223,"يا حادي الركب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1210&r=&rc=7",""],[240,"أُبِثُّكَ مَجْدَ کلدِّينِ حَالاً سَمَاعُهَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26475&r=&rc=0",""],[6259,"ظفر الأسى بمتيَّمٍ لم يظفرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59385&r=&rc=33",""],[6328,"حتّى متى ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84883&r=&rc=24",""]],"verses":[["تعطر عن ذكر الصلاة بمُعرجٍ","وتزكوا بهاو بالسلام محمل",0,"ل",1,0],["تَعَطَّلَتِ الأَحشاءُ مِن كُلِّ أَنَّةٍ","فَلا القُربُ يُضنيني وَلا البُعدُ شائِقي",1,"ق",2,0],["تعطّفَ كهْلانُ بنُ زَيدٍ وحِمْيَرٍ","علَيْهِ فأرْسى مَجْدَها في قَرارِهِ",2,"ر",2,0],["تُعْطِي النُّهَى بِالْعَذْبِ مِنْ نِيلِهَا","حَظَّ الثَّرَى مِنْ نِيلِهَا الْعَذْبِ",3,"ب",1,0],["تُعْطِي كَأَنْكَ لِلْبَرِيَّةِ كَافِلٌ","وَكَأَنَّ أكْثَرَ مَنْ بِهَا أيْتَامُ",4,"م",1,0],["تعطي الذي لا فوقَهُ لمؤمِّلٍ","وتجود بالإحسان قبلَ سؤالِ",5,"ل",1,0],["تعطى مؤجَّلةً لمن يبتاعها","ومتى انتهى الأجل المسمّى يعزل",6,"ل",1,0],["تُعطي المِئينَ فَلا مَنٌّ وَلا سَرَفٌ","وَالحَربَ تَكفي إِذا ما حَميُها وَقَدا",7,"د",2,0],["تُعَطَّفُ مِن تَوابِعِ كُلِّ هَجرٍ","عَصيماً بِالجُلودِ عَلى عَصيمِ",8,"م",1,0],["تعطلت الدنيا به بعد موته","وكانت لنا حيناً به قد تحلَّتِ",9,"ت",1,0],["تَعطّلتِ الدنيا لنا بعد موته","وكانت به أيّامُهُ قد تحلّتِ",10,"ت",1,0],["تعطي الألوف إذا جادت لمطلبٍ","ومثل أعدادها تردِي إذا قتلت",11,"ت",1,0],["تُعطي ووجْهُك مبسوطٌ يُصانعنا","كأنَّ كفَّك لم تُفْضِلْ ولم تَهَبِ",12,"ب",1,0],["تُعْطِي الجزيل بلا وعدٍ تُقدِّمه","ولا تعاقبُ إلا بعد إيعادِ",13,"د",1,0],["تعطي الجزيل فتسترقُّ رقابنا","فتلين ثَمَّ وتغلُظُ الأكبادُ",14,"د",1,0],["تُعطيك أيدي الليالي","عفواً ولا تَسْترِدُّ",15,"د",1,0],["تُعطي وتمنعُ ما منع","تَ وأنتَ مقتدرٌ مخيَّر",16,"ر",1,0],["تعطي الجزيل وما أكبرتَ قيمتَهُ","وأيسرُ الشكر تلقاهُ بإكبارِ",17,"ر",1,0],["تعطي رغابَ العطايا لاعباً فكِهاً","وأنت تُحيي خلال الهزل هُلّاكا",18,"ك",2,0],["تُعطي فيهدم جودُ كفك ثروةً","وتشيد أنت معالياً ومكارما",19,"م",2,0],["تعطي وتمنع ما اعتديتَ وتارةً","تعفو وتبطشُ مُنصفاً لا ظالما",19,"م",2,0],["تَعَطَّفَ في ساقي تَعطُّفَ ارقَمِ","يُساوِرُها عَضّا بِأَنيابِ ضَيغَمِ",20,"م",1,1],["تعطى القلوب جزية","الغرام وهي صاغره",21,"ر",2,0],["تعطى المشارق كل عام عيدها","بمجمل الأعوام والأعصار",22,"ر",1,0],["تُعطى المُنى وَتُنيلُهُنَّ خَليقَةً","بِكَ أَن تُقَدِّمَ في المِنى وَتُؤَخِّرا",23,"ر",2,0],["تُعطي سِلاحَهُمُ وَراحَهُمُ","ما لَم تَكُن لِتَنالَهُ المُقَلُ",24,"ل",1,0],["تُعَطَّفُ فيهِ وَالأَعِنَّةُ شَعرُها","وَتُضرَبُ فيهِ وَالسِياطُ كَلامُ",25,"م",1,0],["تُعطِي وتَمْنَعُ من تشاءُ بإذنِهِ","وبكفِّكَ الأرزاقُ والأعمارُ",26,"ر",1,0],["تُعطيكَ شُهرَتُها النُجومَ طَوالِعاً","وَتُريكَ أَنفُسُها الجِبالَ خَوالِدا",27,"د",2,0],["تُعطى رَبيعَةُ عامِرٍ أَموالَها","في غَيرِ ما اِجتَرَموا وَهُم كَالأَرنَبِ",28,"ب",1,0],["تِعطي حِبالاً مَن عَقَدتَ لَهُ","لَيسَت بِأَرمامٍ وَلا بُترِ",29,"ر",1,1],["تُعطيك بعدَ الكَدِّ ماءً آجناً","طَرْقاً كفَقْدِ الماءِ في الفَلواتِ",30,"ت",1,0],["تُعطي وَتَسأَلُ سائِليكَ مَعَ العَطا","عُذراً فَكُنتَ السائِلَ المَسؤُولا",31,"ل",2,0],["تُعطي وَتَبسُطُ بَعدَ البَذلِ مَعذَرَةً","وَعُذرُ غَيرِكَ دونَ البَذلِ يُبتَدَرُ",32,"ر",1,0],["تُعطيكَ مَنطِقَها فَتَعلَمُ أَنَّهُ","لِجَنيِ عُذوبَتِهِ يَمُرُّ بِثَغرِها",33,"ر",3,0],["تعطيهِ كالمشفقِ لكنَّها","تبطشُ في الأخذِ كبطشِ العدى",34,"د",2,0],["تعطَّلتِ المكارمُ والمعالي","وماتَ العلمُ وارتفعَ الطغامُ",35,"م",1,0],["تُعطى قَليلاً نَزراً إِذا سُئِلَت","وَالبُخلُ فيها سَجيَّةٌ خُلُقُ",36,"ق",1,0],["تُعطي البلادَ إذا تنمَّرَ آخذٌ","وتُفيدُها ما يستفيدُ السَّالبُ",37,"ب",1,0],["تُعطي فَتَحتَفِلُ البِلادُ وَتَحتَفي","أُمَمٌ عَلَيها بِالحَياةِ تَجودُ",38,"د",1,0],["تَعطّفتِ الجبالُ على البطاحِ","وكبّرتِ المدائنُ والضواحي",39,"ي",1,0],["تُعطي الرَغائِبَ حينَ يُخل","لِفُ ما يُؤَمِّلُ كُلَّ آمِل",40,"ل",1,0],["تُعطيكَ وَعدَ أَمانيٍّ تُغِرُّ بِهِ","كَالقَطرِ مَرَّ عَلى ضَجنانَ بَرّاقِ",41,"ق",1,0],["تَعَطعَطَ القَومُ بِهِ حَتّى بَدَر","وَاِفتَتَحَ القَولَ بِعَيٍّ وَحَصَر",42,"ر",1,0],["تُعطي وَتَأخُذُ مِن قُبلٍ وَمِن دُبُرٍ","وَذاكَ شُغلٌ عَنِ المَعروفِ وَالخيرِ",43,"ر",1,0],["تُعطي الغَزيرَةُ دَرَّها فَإِذا أَبَت","كانَت مَلامَتُها عَلى الحَلّابِ",44,"ب",1,0],["تُعطي وَتَأخُذُ حَتّى مَبسِماً دَرِداً","أَعطَت بِأَخذِ الَّذي فيهِ مِنَ الأَشَرِ",45,"ر",1,0],["تُعْطِي اليَتَامَى وَالأَيَامَى غَزْلَهَا","وَتَعِفُّ عَنْ غَزَلٍ وعن تَشْبِيبِ",46,"ب",1,0],["تعطي النفوسَ على مقدارِ جوْهرِها","ما كان لليثِ منها ليس للسيِّد",47,"د",1,0],["تعطيك فتحا وان سدت مغالقه","وطور عقلك في ذا الفتح حيران",48,"ن",1,0],["تعطشوا لاكتساب العلم اذ فهموا","كون الجهالة في حكم الحجى شنعا",49,"ع",2,0],["تعطي القياد وزيرا وهو متّجر","بجوعها فهو فيها البايع الشاري",50,"ر",2,0],["تعطَّل من حَلْيهِ جيدهُ","وعِقدُ الجواهر منه انتثر",51,"ر",1,0],["تعطّري فهذه صبابتي","واكتحلي فهذه حروفي",52,"ف",2,0],["تعطّر في أنغامه ورحيقه","وريّاه :عطري مبسم وسبيب",53,"ب",1,0],["تعطي رغابَ العطايا لاعباً فكِهاً","وأنت تُحي خلال الهزل هُلاّكا",54,"ك",2,0],["تعطي قليلاً نزراً إذا سئلتْ،","وَکلبُخْلُ فِيها سَجِيَّة ٌ خُلُقٌ",55,"ق",1,0],["تُعطى مؤجلة ً لمن يبتاعها","ومتى انقضى الأجل المسمى يُعزَل",56,"ل",1,0],["تُعطَّلُ أربابُ المواهبِ ريثما","يُتمَّمُ تخريجُ الضِّعاف المواهب",57,"ب",1,0],["تعطي لعمرك كل شيء حقه","ونظامها لأولي النهى ميزان",58,"ن",1,0],["تعطي لذراتي هواك وسره","فكأن اعضائي خلقن قلوبا",59,"ب",2,0],["تعطف علينا بلطف خفي","وجد وتكرم بنيل المرام",60,"م",1,0],["تُعطي عَلى الشِعرِ الرَغائِبَ بَعدَ أَن","غَنِيَت صِفاتُكَ عَن بَيانِ مُتَرجِمِ",61,"م",1,0],["تعطي الذي منه يجبي الخرُ متكلاً","على الإِله ونعمَ العونُ والوزرُ",62,"ر",1,0],["تعطه فيها وملكاً دائماً","من رضاه ذلك الملك اليقينا",63,"ن",2,0],["تعطر هذا الجو من طيب نشره","ورق له ظل ورق نسيمه",64,"م",2,0],["تعطى الجزيل فلا يصدق سائل","إن الذي تعطيه مما يوهب",65,"ب",1,0],["تعطّلَ الشعرُ حتى كادَ يحرجني","وكادَ بحري من الأحزان يغدرُ بي",66,"ب",2,0],["تُعطي عَلى الغَضَبِ المُعَلِّهِ وَالرِضا","وَبِذاكُمُ يَقضي العُلى وَالسُؤدُدُ",67,"د",1,0],["تُعطي وَتَمنَعُ ما تَشاءُ وَلا تُرى","إِلّا مُذيلاً عِزَّةً وَمُنيلا",68,"ل",2,0],["تُعطى الذي لا يُواتِيني فإنْ أَخَذَتْ","مني فما ليس لي من بعدِه خَلَف",69,"ف",1,0],["تُعطِي فتَحِقر ما تعطي ولو وهبتْ","كقَدْرِها وهبتْ أضعافَ دُنيانا",70,"ن",2,0],["تُعطِي وأنت مُعدِمٌ وإنما","يُعطِي أخوك الغيثُ وهْو واجد",71,"د",1,0],["تعطّفوا وارحموا محبّاً","قليلُكم عنده كثيرُ",72,"ر",1,0],["تُعطي الرغائب إن سكنت كمثل ما","عند الشدائد تركب الأهوالا",73,"ل",2,0],["تعطفت لي بالعطف حتى كأنما","جريتَ بمجرى الروح بل كنتَ ألطفا",74,"ف",2,0],["تُعطي وَلا تُمنَحُ حَتّى القَليل","في ذلِكَ اللَيلُ وَما أَظلَمَه",75,"ه",1,0],["تعطِيك ما اعتادت وما لم تعتدِ","كأنها جاءت بأعلى ثَهْمَد",76,"د",1,0],["تعطف على ضعفي برؤية وجهك ال","كريم فرؤياه تحط المأثما",77,"م",2,0],["تعطفه برد وروح وراحة","على كبد حرى وقلب مفلذ",78,"ذ",1,0],["تُعطي الأُلوفَ إِذا الجَعدُ اليَدينِ غَدا","يُعطي الدَراهِمَ أَثلاثاً وَأَنصافا",79,"ف",2,0],["تَعَطَّلَ مِنها كُلُّ نادٍ وَمَجمَعٍ","وَأَوحَشَ مِنها مُلتَقى الأُدَباءِ",80,"ا",2,0],["تعطف لي قلب الجليل خليلي","وكل خليل تصطفيه جليل",81,"ل",1,1],["تُعطي بسُورَتِها اللَّيانَ وهكذا","لا يَستقيمُ العودُ ما لم يُغمَز",82,"ز",1,0],["تَعَطُّفاً قَدَّ فُؤادي الأَسَفُ","لَمّا تَثَنّى قَدُّكَ المُهَفهَفُ",83,"ف",1,1],["تعطفي بالقرب والوصال","على حليف المطل والتواني",84,"ي",1,0],["تَعَطَّفَ أَحياناً عَلَيهِ وَتارَةً","تَكادُ وَلَم تَغفُل مِن الوُجدِ تَخرَقُ",85,"ق",1,0],["تَعطّف لُطفاً بِالمَزار وَطالَما","تَحلّت حلى الأَلطاف مِنهُ لَطائفُ",86,"ف",1,0],["تَعطّفتُ إِذ جرّت ذُيول دلالها","لِعلمي بِأَنَّ الجَرَّ يَنشأ عَن عَطفِ",87,"ف",1,0],["تَعَطَّلَ مَسئولٌ لَدَيهِم وَسائِلٌ","فَلا اليَدُ مِن مُعطٍ وَلا الخَيرُ مِن عاطِ",88,"ط",1,0],["تعطيفه المولى لِعَبدِ المحط","وربَّما قَرَّبهُ من المَلِك",89,"ك",1,0],["تَعطف شَكوايَ العِدا لَو أَبُثَها","وَتَبعث لي دَمعاً مِن الحَجر الصَلد",90,"د",1,0],["تَعطر أَنفاسُهُ ما لِخافِقين","وَتَنفج بالمسك أَردانُهُ",91,"ن",2,0],["تُعطيكَ مَشياً حَسَناً مَرَّةً","حَثَّكَ بِالمِروَدِ وَالمُحصَدِ",92,"د",1,0],["تُعطيكَ بِالأَلفاظِ غلظةَ ضَيغَمِ","وَتُريكَ بِالأَلحاظِ رِقَّةِ جؤذَرِ",93,"ر",1,0],["تعطّر من هذا الرَّبيع نسائماً","عليهنَّ أنفاسُ المصيف توقَّدُ",94,"د",1,0],["تعطي وتمنع نائلاً وأبوَّة","لا كانَ من يعطي سواك ويمنعُ",95,"ع",1,0],["تَعطرَ من أنفاسِ مصرَ ونيلها","ومن وَحيها الغالي لنا يتألقُ",96,"ق",1,0],["تُعطي الطريقَ عفوَها وجهدَها","حتى تعود مُضغةً ولا تني",97,"ن",2,0],["تُعطيك في النادي أوائلَ فخرِه","والقومُ بعدَك تابعٌ أو ثاني",98,"ن",2,0],["تعطي السماءُ قليلا وهي باكيةٌ","شحّاً ويُعطي كثيرا وهو يبتسمُ",99,"م",1,0],["تُعطي حياءً مطرِقاً ملثَّماً","وقد وهبتَ مُسنياً ومُجزِلا",100,"ل",2,0],["تعطيهم آراؤهم وسيوفُهم","كفَّ الزمانِ من المخوفِ المُفزعِ",101,"ع",1,0],["تُعطِي السُّرى من غير ذلٍّ أظهرا","حُصَّاً وأعناقاً له خواضعا",102,"ع",2,0],["تعطيك إما ظفَراً أو ردىً","سماتُه العادلة الجائرهْ",103,"ر",2,0],["تعطَّر من طِيبه المجدُ عنه","وعن قومه الأطيبُ الأطهرُ",104,"ر",1,0],["تُعطي على الخِفّة ما","يُعطُون والضَّرعُ دِرَرْ",105,"ر",1,0],["تُعطي المنى ونعود نسألُ ثانياً","فتعود حبّاً للسماح العائدِ",106,"د",1,0],["تعطِي وأنت مُعدِمٌ وإنما","يُعطِي أخوك البحرُ وهو واجدُ",107,"د",1,0],["تُعطى الخِشاشاتِ لَياناً على","أنفٍ لها غضبانَ مستصعَبِ",108,"ب",1,0],["تعطيك منها أَلْسُناً عِدَّةً","مجتمعاتٍ كلَّها في لَهَا",109,"ا",1,0],["تعطَّل جيدي من حُلى كل مِنَّةٍ","وراحَ بما أوليْت أيُّ مُطَوَّقِ",110,"ق",1,0],["تُعطِّر أفواه الرواة قلائدي","وتُزهى بما اُثْني عليكَ المحافلُ",111,"ل",1,0],["تَعَطَّف عَلى مَن لَو رَأَيتَ اِنهِتاكَهُ","جَعَلتَ عَلَيهِ سِترَ وَصلِكَ مُسبَلا",112,"ل",2,0],["تَعطَّرَ مِن دياركمُ النسيمُ","وهبَّ ف