{"poems":[[53,"أثر الهوادج في عراص البيد","https://www.aldiwan.net/poem30633.html","الكامل"],[63,"ألا من لجسم بالثوية قاطن","https://www.aldiwan.net/poem45698.html","الطويل"],[63,"أبا خالد لا تبخس الشعر حقه","https://www.aldiwan.net/poem45880.html","الطويل"],[63,"ألمت ودوني رامة فكثيبها","https://www.aldiwan.net/poem46161.html","الطويل"],[57,"تعمدني بنصحك في انفرادي","https://www.aldiwan.net/poem24673.html","الوافر"],[77,"ما ضر لو سلم أو ودعا","https://www.aldiwan.net/poem35995.html","السريع"],[77,"هنيئا بما خولت من رفعة الشان","https://www.aldiwan.net/poem36064.html","الطويل"],[77,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[77,"أما وخيال في المنام يزور","https://www.aldiwan.net/poem36492.html","الطويل"],[77,"حديث على رغم العلا غير كاذب","https://www.aldiwan.net/poem36768.html","الطويل"],[86,"بلابل وادي النيل بالمشرق اسجعي","https://www.aldiwan.net/poem68896.html","الطويل"],[35,"أبائنة سعدى نعم ستبين","https://www.aldiwan.net/poem38821.html","الطويل"],[35,"وإني لأسمو بالوصال إلى التي","https://www.aldiwan.net/poem39143.html","الطويل"],[93,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[88,"إليك ما شاهدت عيني من العجب","https://www.aldiwan.net/poem44424.html","البسيط"],[88,"قل للحكومات في البلقان هل علقت","https://www.aldiwan.net/poem44467.html","البسيط"],[47,"أسيف الهدى وقريع العرب","https://www.aldiwan.net/poem25374.html","المتقارب"],[72,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[72,"يا من له في طريق زهد","https://www.aldiwan.net/poem19262.html","مخلع البسيط"],[72,"ما الطرف بعدكم بالنوم مكحول","https://www.aldiwan.net/poem19466.html","البسيط"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"يا كريما لم يزل محتمِا","https://www.aldiwan.net/poem66525.html","الرمل"],[89,"تحبهم ثم ارزم ثم سالا","https://www.aldiwan.net/poem44900.html","الوافر"],[85,"هنيئا أمير المؤمنين فإنما","https://www.aldiwan.net/poem63777.html","الطويل"],[62,"قل لمن يطلب الحجر","https://www.aldiwan.net/poem52140.html","مجزوء الخفيف"],[62,"نصحنا لكم نصحا نرجي ثوابه","https://www.aldiwan.net/poem52150.html","الطويل"],[62,"صحا عن فؤادي ظل كل علاقة","https://www.aldiwan.net/poem52368.html","الطويل"],[45,"لدارك يا ليلى سماء تجودها","https://www.aldiwan.net/poem63478.html","الطويل"],[45,"حرمت رضاك من عدمي وخسري","https://www.aldiwan.net/poem63561.html","الوافر"],[45,"عذيري من واش بها لم أواله","https://www.aldiwan.net/poem65537.html","الطويل"],[61,"إذا المجرة مالت بعد تعديل","https://www.aldiwan.net/poem51485.html","البسيط"],[61,"أكان لقلبه عنك انقلاب","https://www.aldiwan.net/poem51816.html","الوافر"],[49,"ألم تر أن للأيام وقعا","https://www.aldiwan.net/poem62167.html","الوافر"],[80,"هذا ابتداء له عند العلى خبر","https://www.aldiwan.net/poem31433.html","البسيط"],[44,"أما إنه لولا الخليط المودع","https://www.aldiwan.net/poem30466.html","الطويل"],[87,"تصابيت بعد الحلم واعتادني شجوي","https://www.aldiwan.net/poem8194.html","الطويل"],[40,"قد رابه ولمثل ذلك رابه","https://www.aldiwan.net/poem42339.html","الكامل"],[22,"إذا قلت أني آيب أهل بلدة","https://www.aldiwan.net/poem22010.html","الطويل"],[46,"ترنم في نهارك مستعينا","https://www.aldiwan.net/poem22214.html","الوافر"],[46,"سرت بقوام يسرق اللب ناعم","https://www.aldiwan.net/poem22256.html","الطويل"],[46,"ثلاث مراتب ملك رفيع","https://www.aldiwan.net/poem22836.html","الوافر"],[46,"ألا يكشف القصاص وال فإن هم","https://www.aldiwan.net/poem22933.html","الطويل"],[46,"النفس في العالم العلوي مركزها","https://www.aldiwan.net/poem22943.html","البسيط"],[46,"جرى الناس مجرى واحدا في طباعهم","https://www.aldiwan.net/poem23118.html","الطويل"],[68,"شربنا على ذكر الحبيب مدامة","https://www.aldiwan.net/poem1525.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85591","المجتث"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/1149","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16637","الطويل"],[58,"","https://poetry.dctabudhabi.ae/diwan/poem/22454","الوافر"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9918","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42667","المتقارب"],[70,"","https://poetry.dctabudhabi.ae/diwan/poem/5577","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142327","الرجز"],[77,"ما ضر لو سلم أو ودعا","https://www.poetsgate.com/ViewPoem.aspx?id=34175",""],[90,"الزهَاوي","https://www.poetsgate.com/ViewPoem.aspx?id=179155",""],[90,"ضحايا الأنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=179024",""],[46,"سرتْ بقوامٍ، يسرِقُ اللُّبَّ، ناعمٍ،","https://www.poetsgate.com/ViewPoem.aspx?id=18248",""]],"verses":[["وَأَنَختُ عيسي في جَنابِكَ طارِحاً","بِفَناءِ دارِكَ أَنسُعي وَقُتودي",0,"د",2,0],["وَإنْ خاشَنَتْنِي النَّائباتُ تُشَبَّثَتْ","بِأَروعَ عَبلِ السَّاعِدَينِ مُخاشِنِ",1,"ن",1,0],["وَإِنْ خِفْتَ هَجْواً وَاتَّقَيْتَ بِنائِلٍ","قَوارِصَ تَأْباها النُّفوسُ المَواجِدُ",2,"د",1,0],["وإنْ خَطَرَتْ وَهْناً صَباً مَشرِقيّةٌ","على كَبِدِي هاجَ الغَرامَ هُبوبُها",3,"ب",3,0],["وَإِن خالَفتَني وَعَصِيتَ قَولي","فَلا تَجزَع إِذا لَم تُعطَ طاعَه",4,"ع",2,0],["وإنْ خبرْتَ القوْمَ ألفَيْتَهُمْ","للّهِ ما أهْدَى وما أوْرَعا",5,"ع",2,0],["وَأن خَصَّكَ الرَّحْمَانُ جَلَّ جَلاَلَهُ","بِمعْجِزَةٍ مَنْسُوبَةٍ لِسُلَيْمَانِ",6,"ن",1,0],["وَإنْ خَلطَوُا عُرفاً بنُكْرٍ وَقَصَّرُوا","وَزَنْتَ بِقِسْطَاسٍ قَوِيمٍ وَمِيزَانِ",7,"ن",1,0],["وإنْ خطّ وجْدي منْ دُموعي رِسالَةً","على صفْحِ خدّي فالنّسيمُ سَفيرُ",8,"ر",1,0],["وَإِنْ خُصَّ مِنْهُمْ مَاجِدٌ بِنَقِيبَةٍ","فَقَدْ حُزْتَ فِي الْعلْيَا جَميِعَ الْمَنَاقِبِ",9,"ب",1,0],["وَإِن خَطَرَت ذِكرى الفُحولِ بِفارِسٍ","وَما خَلَّفوا في القَولِ مِن كُلِّ مُشبِعِ",10,"ع",1,0],["وَإِنَّ خَليلاً يُحدِثُ الصَرمَ كُلَّما","نَأَيتَ وَشَطَّت دارُهُ لَظَنونُ",11,"ن",1,0],["وَإِن خَفِيَت كانَت لِعَينَيكَ قُرَّةً","وَإِن تَبدُ يَوماً لَم يَعُمَّكَ عارُها",12,"ر",3,0],["وَإِنَّ خَيْراً حَلِيفاً مَنْ تَرُوضُ بِهِ","صَعْباً وَتُولِيهِ وُدّاً بَعْدَ عُدوَانِ",13,"ن",1,0],["وأن خبث البرايا في طبائعها","لا بدّ فيه سوى الإطباع من سبب",14,"ب",1,0],["وإن خشِيت على البلدان جِنّتها","فنُط بها من نُهاهم بعض أحراز",15,"ز",1,0],["وَإِنَّ خُراسانَ إِن أَنكَرَت","عُلايَ فَقَد عَرَفَتها حَلَب",16,"ب",1,0],["وإن خطا للمعالي خطوةً بهرت","كأنَّ أولَ ما يخطوه غايات",17,"ت",1,0],["وإن خفى زائداً فأعرض","عنه ودع منطقي يكف",18,"ف",1,0],["وإن خبا ضرم النيران من زمنٍ","فالبحر منسحب الأذيال مسدول",19,"ل",1,0],["وإنْ خيفَ موجٌ عيذ منه بساحلٍ","خليٍّ من الأجرافِ ذات الكَباكبِ",20,"ب",1,0],["وانخدِعْ لي أو تَخَادَعْ إنها","خُدعةٌ فيها رَباحٌ لا غبن",21,"ن",1,0],["وان خيال ليلى لي سراج","سيهديني اذا خفت الضلالا",22,"ل",2,0],["وَإِن خَرَجَت نارٌ فَكانَت جَهَنَّماً","تُغَذّى بِأَجسادِ الوَرى وَتُقاتُ",23,"ت",1,0],["وانخلوه فياله","إن ظفرتم به ظفر",24,"ر",1,0],["وإن خضتم فيه بعلم وحكمة","فصبراً على ما بين أيديكمُ صبرا",25,"ر",2,0],["وإنَّ خَلاصاً كنت أرجوهُ بُرْهَةً","وكان يزيدُ الأمر فيه وينقُصُ",26,"ص",1,0],["وَإِن خَفَّ مِن تِلكَ الرُسومِ أَنيسُها","وَأَخلَقَ مِن بَعدِ الأَنيسِ جَديدُها",27,"د",3,0],["وَإِن خَدَموكَ بِالأَبدانِ إِنّي","لَأَبلَغُ خِدمَةً مِنهُم بِفِكري",28,"ي",1,0],["وَإِنَّ خَراجي لَلخَفيفُ وَلَو غَدا","ثَقيلاً لَما استَحسَنتَ غَيرَ احتِمالِهِ",29,"ل",2,0],["وإن خرَجنا خلَعنا فَضلَ نِعمتِه","على المَناشفِ منا والمناديلِ",30,"ل",1,0],["وإن خفي الصوابُ على ملوكٍ","فإنَّ جميعَ ما تأتي الصَّوابُ",31,"ب",1,0],["وَأَنَّ خُطا الزَمانِ مُواصِلاتٌ","وَأَنَّ لِكُلِّ ما واصَلنَ قَطعا",32,"ع",2,0],["وإن خَفَضْتَ عُداةَ اللّه أو خُذلوا","فأنْتَ باللّهِ تستعلي وتنتصرُ",33,"ر",1,0],["وَإِن خَفَرَت أَموالَ قَومٍ أَكُفُّهُم","مِنَ النَيلِ وَالجَدوى فَكَفّاهُ مَقطَعُ",34,"ع",1,0],["وَإِنْ خَطَرَتْ بَيْنَ النَّدَامَى تَأَوَّدَتْ","كَأَنْ لَيْسَ عُضْوٌ فِي الْقَوَامِ عَلَى عُضْوِ",35,"و",1,0],["وَأَنَختُ مُنعَقِدَ الحِبالِ وَفَوقَهُ","رَحلٌ تَغَشَّت بَزَّهُ أَجلابُهُ",36,"ب",2,0],["وَإِن خافَ مِن وَقعِ المُحَرِّمِ يَنتَحي","عَلى عَضُدٍ رَيّا كَسارِيَةِ القَصرِ",37,"ر",1,0],["وَإِن خالَسنَ غِرَّتَكَ اِرتِقاباً","فَحَقٌّ أَن يَرُحنَ مُشَتَّماتِ",38,"ت",1,0],["وَإِن خَلَجَت عَينٌ لِبَينٍ فَحَسبُها","مِنَ البينِ يَومٌ مِن رَداً مُتَخَلَّجِ",39,"ج",1,0],["وَإِن خَفَضَتهُ هِمَّتُهُ تَهاوى","إِلى جِنسِ البَهائِمِ شَرِّ جِنسِ",40,"س",1,0],["وَإِن خَرَصوا مَيناً بِغَيرِ تَحَرُّجٍ","فَأَوجَبَ شَيءٍ أَن يُهانوا وَيُصفَعوا",41,"ع",3,0],["وَإِنَّ خَنساءَ إِذ تُزجي قَصائِدَها","نَظيرُ خَنساءَ يَدعو ظِمأَها الكرَعُ",42,"ع",1,0],["وَإِن خِفتَ مِن رَبٍّ فَلا تَرجُ عارِضاً","مِنَ المُزنِ تَهوى أَن يَزولَ بِهِ المَحلُ",43,"ل",1,0],["وإن خَطَرَتْ يوماً على خاطرِ امرىءٍ","أقامتْ به الأفراحُ وارتحلَ الهمّ",44,"م",1,0],["وإنّ خير رجاء","ما جاء من بعد ياس",45,"س",1,0],["وَإِن خَطَبتُ إِلَيها صَبرَها جَعَلَت","جِراحَةُ الوَجدِ تَدمى في جَوارِحِها",46,"ح",3,0],["وإنْ خَلَطَتْني بالتّرابِ مَنِيّةٌ","فبَعْضُ تُرابي من مَوَدّتكُم خِلْطُ",47,"ط",1,0],["وَإِن خانَ الصَديقُ فَلا تَخُنهُ","وَدُم بِالحِفظِ مِنهُ وَبِالذِمامِ",48,"م",1,0],["وَإِن خَمَدَت نيرانُ عَبلَةَ مَوهِناً","فَكُن أَنتَ في أَكنافِها نَيِّرَ الوَقدِ",49,"د",1,0],["وَإِنْ خَفِيَ الْحَقُّ فَاصْبِرْ لَهُ","وَبَادِرْ إِلَيْهِ إِذَا حَصْحَصَا",50,"ص",2,0],["وَإِنَّ خَليجاً مِن أَياديهِ للوَرى","يُرى كُلُّ بِحرٍ عِندَهُ يَتَضَحضَحُ",51,"ح",1,0],["وَأَنَّ خُطوباً أَشتَكيها سَتَنجَلي","وَأَنَّ أُموراً أَبتَغيها سَتَنجَحُ",51,"ح",1,0],["وأنّ خال عمه","كان يقود أرحبا",52,"ب",2,0],["وإن خبرت القوم ألفيتهم","لله ما أهدى وما أروعا",53,"ع",2,0],["وإن خيالاً يملأُ الشعرَ رَهبةً","سكونٌ على قبرِ الزهاويِّ سائد",54,"د",1,0],["وان خَشُنَتْ عليك مكاشفاتٌ","فحسبُك أن تُجامَلَ أو تحابَى",55,"ب",2,0],["وإن خلَجتْ عينٌ لبينٍ، فحسبُها","، من البين، يومٌ، من ردىً، مُتخلَّج",56,"ج",1,0]]}