tps://www.poetsgate.com/ViewPoem.aspx?id=175125",""],[4875,"الشعر بيدا","https://www.poetsgate.com/ViewPoem.aspx?id=132539",""],[4902,"أموت من فرقاك","https://www.poetsgate.com/ViewPoem.aspx?id=6530",""],[4927,"الْحُبُّ وَ الْوُشَاْة","https://www.poetsgate.com/ViewPoem.aspx?id=29735",""],[4935,"لاحت لعيني زهرة الزوراء","https://www.poetsgate.com/ViewPoem.aspx?id=129285",""],[2177,"شجاني منهم ربع خلاء","https://www.poetsgate.com/ViewPoem.aspx?id=127080",""],[5010,"أستجرت بنور وجهك خالقي","https://www.poetsgate.com/ViewPoem.aspx?id=189900",""],[585,"مهلاً عليَّ فإني الموجع الدنف","https://www.poetsgate.com/ViewPoem.aspx?id=161915",""],[585,"سل الدار هل في الدار من كنت تألف","https://www.poetsgate.com/ViewPoem.aspx?id=161868",""],[585,"هي الجزيرة فيها الصيحة العمم","https://www.poetsgate.com/ViewPoem.aspx?id=161893",""],[585,"يا شيب إن أوان الشيب لم يحن","https://www.poetsgate.com/ViewPoem.aspx?id=161874",""],[5083,"بُنودُ الشَّام","https://www.poetsgate.com/ViewPoem.aspx?id=53878",""],[5106,"أُسَهَّدُ فِيْ تَذَكُّرِهِ وَأَرْضَى ..","https://www.poetsgate.com/ViewPoem.aspx?id=137167",""],[5135,"طيفَ الأحبةِ","https://www.poetsgate.com/ViewPoem.aspx?id=201973",""],[5145,"سقى السرح من وادي الآراك هطول","https://www.poetsgate.com/ViewPoem.aspx?id=108051",""],[5206,"مناهج الله","https://www.poetsgate.com/ViewPoem.aspx?id=187391",""],[5281,"قانون الصُّحبة","https://www.poetsgate.com/ViewPoem.aspx?id=199349",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5397,"عن الدار نأيا أزمع الركب ترحالا","https://www.poetsgate.com/ViewPoem.aspx?id=157967",""],[5433,"سمها","https://www.poetsgate.com/ViewPoem.aspx?id=36233",""],[5457,"قانون القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=213113",""],[5582,"أَلا اِحببها وَباشرها هبوبا","https://www.poetsgate.com/ViewPoem.aspx?id=63467",""],[5616,"عهد","https://www.poetsgate.com/ViewPoem.aspx?id=203324",""],[5722,"غالية في لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=12683",""],[5756,"اقرب الناس","https://www.poetsgate.com/ViewPoem.aspx?id=5436",""],[5818,"الحبّ في زمن الكوليرا","https://www.poetsgate.com/ViewPoem.aspx?id=188677",""],[469,"جزتَ في المجد والفعال الشريفِ","https://www.poetsgate.com/ViewPoem.aspx?id=76859",""],[5837,"بلاك بيري","https://www.poetsgate.com/ViewPoem.aspx?id=181725",""],[5848,"البقية في حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=50592",""],[6038,"الاقصى","https://www.poetsgate.com/ViewPoem.aspx?id=27219",""],[6093,"أستاذي","https://www.poetsgate.com/ViewPoem.aspx?id=198133",""],[6125,"عَاقَرتُ حُبَّكِ فَاستَحَلتُ مُرِيدَا","https://www.poetsgate.com/ViewPoem.aspx?id=209068",""],[6152,"ذكرك لي حياة","https://www.poetsgate.com/ViewPoem.aspx?id=206727",""],[5309,"إذا رمت ان تحيا سليما من الأذى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573774",""],[563,"بلاء الأنبياء هو البلاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=56271&r=&rc=1",""],[6072,"أرَقٌ وغَرَق !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82190&r=&rc=22",""],[6273,"دانة النور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78508&r=&rc=6",""]],"verses":[["وَأَنَختُ عيسي في جَنابِكَ طارِحاً","بِفَناءِ دارِكَ أَنسُعي وَقُتودي",0,"د",2,0],["وَإنْ خاشَنَتْنِي النَّائباتُ تُشَبَّثَتْ","بِأَروعَ عَبلِ السَّاعِدَينِ مُخاشِنِ",1,"ن",1,0],["وَإِنْ خِفْتَ هَجْواً وَاتَّقَيْتَ بِنائِلٍ","قَوارِصَ تَأْباها النُّفوسُ المَواجِدُ",2,"د",1,0],["وإنْ خَطَرَتْ وَهْناً صَباً مَشرِقيّةٌ","على كَبِدِي هاجَ الغَرامَ هُبوبُها",3,"ب",3,0],["وَإِن خالَفتَني وَعَصِيتَ قَولي","فَلا تَجزَع إِذا لَم تُعطَ طاعَه",4,"ع",2,0],["وإنْ خبرْتَ القوْمَ ألفَيْتَهُمْ","للّهِ ما أهْدَى وما أوْرَعا",5,"ع",2,0],["وَأن خَصَّكَ الرَّحْمَانُ جَلَّ جَلاَلَهُ","بِمعْجِزَةٍ مَنْسُوبَةٍ لِسُلَيْمَانِ",6,"ن",1,0],["وَإنْ خَلطَوُا عُرفاً بنُكْرٍ وَقَصَّرُوا","وَزَنْتَ بِقِسْطَاسٍ قَوِيمٍ وَمِيزَانِ",7,"ن",1,0],["وإنْ خطّ وجْدي منْ دُموعي رِسالَةً","على صفْحِ خدّي فالنّسيمُ سَفيرُ",8,"ر",1,0],["وَإِنْ خُصَّ مِنْهُمْ مَاجِدٌ بِنَقِيبَةٍ","فَقَدْ حُزْتَ فِي الْعلْيَا جَميِعَ الْمَنَاقِبِ",9,"ب",1,0],["وَإِن خَطَرَت ذِكرى الفُحولِ بِفارِسٍ","وَما خَلَّفوا في القَولِ مِن كُلِّ مُشبِعِ",10,"ع",1,0],["وَإِنَّ خَليلاً يُحدِثُ الصَرمَ كُلَّما","نَأَيتَ وَشَطَّت دارُهُ لَظَنونُ",11,"ن",1,0],["وَإِن خَفِيَت كانَت لِعَينَيكَ قُرَّةً","وَإِن تَبدُ يَوماً لَم يَعُمَّكَ عارُها",12,"ر",3,0],["وَإِنَّ خَيْراً حَلِيفاً مَنْ تَرُوضُ بِهِ","صَعْباً وَتُولِيهِ وُدّاً بَعْدَ عُدوَانِ",13,"ن",1,0],["وأن خبث البرايا في طبائعها","لا بدّ فيه سوى الإطباع من سبب",14,"ب",1,0],["وإن خشِيت على البلدان جِنّتها","فنُط بها من نُهاهم بعض أحراز",15,"ز",1,0],["وَإِنَّ خُراسانَ إِن أَنكَرَت","عُلايَ فَقَد عَرَفَتها حَلَب",16,"ب",1,0],["وإن خطا للمعالي خطوةً بهرت","كأنَّ أولَ ما يخطوه غايات",17,"ت",1,0],["وإن خفى زائداً فأعرض","عنه ودع منطقي يكف",18,"ف",1,0],["وإن خبا ضرم النيران من زمنٍ","فالبحر منسحب الأذيال مسدول",19,"ل",1,0],["وإنْ خيفَ موجٌ عيذ منه بساحلٍ","خليٍّ من الأجرافِ ذات الكَباكبِ",20,"ب",1,0],["وانخدِعْ لي أو تَخَادَعْ إنها","خُدعةٌ فيها رَباحٌ لا غبن",21,"ن",1,0],["وان خيال ليلى لي سراج","سيهديني اذا خفت الضلالا",22,"ل",2,0],["وَإِن خَرَجَت نارٌ فَكانَت جَهَنَّماً","تُغَذّى بِأَجسادِ الوَرى وَتُقاتُ",23,"ت",1,0],["وانخلوه فياله","إن ظفرتم به ظفر",24,"ر",1,0],["وإن خضتم فيه بعلم وحكمة","فصبراً على ما بين أيديكمُ صبرا",25,"ر",2,0],["وإنَّ خَلاصاً كنت أرجوهُ بُرْهَةً","وكان يزيدُ الأمر فيه وينقُصُ",26,"ص",1,0],["وَإِن خَفَّ مِن تِلكَ الرُسومِ أَنيسُها","وَأَخلَقَ مِن بَعدِ الأَنيسِ جَديدُها",27,"د",3,0],["وَإِن خَدَموكَ بِالأَبدانِ إِنّي","لَأَبلَغُ خِدمَةً مِنهُم بِفِكري",28,"ر",2,0],["وَإِنَّ خَراجي لَلخَفيفُ وَلَو غَدا","ثَقيلاً لَما استَحسَنتَ غَيرَ احتِمالِهِ",29,"ل",2,0],["وإن خرَجنا خلَعنا فَضلَ نِعمتِه","على المَناشفِ منا والمناديلِ",30,"ل",1,0],["وإن خفي الصوابُ على ملوكٍ","فإنَّ جميعَ ما تأتي الصَّوابُ",31,"ب",1,0],["وَأَنَّ خُطا الزَمانِ مُواصِلاتٌ","وَأَنَّ لِكُلِّ ما واصَلنَ قَطعا",32,"ع",2,0],["وإن خَفَضْتَ عُداةَ اللّه أو خُذلوا","فأنْتَ باللّهِ تستعلي وتنتصرُ",33,"ر",1,0],["وَإِن خَفَرَت أَموالَ قَومٍ أَكُفُّهُم","مِنَ النَيلِ وَالجَدوى فَكَفّاهُ مَقطَعُ",34,"ع",1,0],["وَإِنْ خَطَرَتْ بَيْنَ النَّدَامَى تَأَوَّدَتْ","كَأَنْ لَيْسَ عُضْوٌ فِي الْقَوَامِ عَلَى عُضْوِ",35,"و",1,0],["وَأَنَختُ مُنعَقِدَ الحِبالِ وَفَوقَهُ","رَحلٌ تَغَشَّت بَزَّهُ أَجلابُهُ",36,"ب",2,0],["وَإِن خافَ مِن وَقعِ المُحَرِّمِ يَنتَحي","عَلى عَضُدٍ رَيّا كَسارِيَةِ القَصرِ",37,"ر",1,0],["وَإِن خالَسنَ غِرَّتَكَ اِرتِقاباً","فَحَقٌّ أَن يَرُحنَ مُشَتَّماتِ",38,"ت",1,0],["وَإِن خَلَجَت عَينٌ لِبَينٍ فَحَسبُها","مِنَ البينِ يَومٌ مِن رَداً مُتَخَلَّجِ",39,"ج",1,0],["وَإِن خَفَضَتهُ هِمَّتُهُ تَهاوى","إِلى جِنسِ البَهائِمِ شَرِّ جِنسِ",40,"س",1,0],["وَإِن خَرَصوا مَيناً بِغَيرِ تَحَرُّجٍ","فَأَوجَبَ شَيءٍ أَن يُهانوا وَيُصفَعوا",41,"ع",3,0],["وَإِنَّ خَنساءَ إِذ تُزجي قَصائِدَها","نَظيرُ خَنساءَ يَدعو ظِمأَها الكرَعُ",42,"ع",1,0],["وَإِن خِفتَ مِن رَبٍّ فَلا تَرجُ عارِضاً","مِنَ المُزنِ تَهوى أَن يَزولَ بِهِ المَحلُ",43,"ل",1,0],["وإن خَطَرَتْ يوماً على خاطرِ امرىءٍ","أقامتْ به الأفراحُ وارتحلَ الهمّ",44,"م",1,0],["وإنّ خير رجاء","ما جاء من بعد ياس",45,"س",1,0],["وَإِن خَطَبتُ إِلَيها صَبرَها جَعَلَت","جِراحَةُ الوَجدِ تَدمى في جَوارِحِها",46,"ح",3,0],["وإنْ خَلَطَتْني بالتّرابِ مَنِيّةٌ","فبَعْضُ تُرابي من مَوَدّتكُم خِلْطُ",47,"ط",1,0],["وَإِن خانَ الصَديقُ فَلا تَخُنهُ","وَدُم بِالحِفظِ مِنهُ وَبِالذِمامِ",48,"م",1,0],["وَإِن خَمَدَت نيرانُ عَبلَةَ مَوهِناً","فَكُن أَنتَ في أَكنافِها نَيِّرَ الوَقدِ",49,"د",1,0],["وَإِنْ خَفِيَ الْحَقُّ فَاصْبِرْ لَهُ","وَبَادِرْ إِلَيْهِ إِذَا حَصْحَصَا",50,"ص",2,0],["وَإِنَّ خَليجاً مِن أَياديهِ للوَرى","يُرى كُلُّ بِحرٍ عِندَهُ يَتَضَحضَحُ",51,"ح",1,0],["وَأَنَّ خُطوباً أَشتَكيها سَتَنجَلي","وَأَنَّ أُموراً أَبتَغيها سَتَنجَحُ",51,"ح",1,0],["وأنّ خال عمه","كان يقود أرحبا",52,"ب",2,0],["وإن خبرت القوم ألفيتهم","لله ما أهدى وما أروعا",53,"ع",2,0],["وإن خيالاً يملأُ الشعرَ رَهبةً","سكونٌ على قبرِ الزهاويِّ سائد",54,"د",1,0],["وان خَشُنَتْ عليك مكاشفاتٌ","فحسبُك أن تُجامَلَ أو تحابَى",55,"ب",2,0],["وإن خلَجتْ عينٌ لبينٍ، فحسبُها","، من البين، يومٌ، من ردىً، مُتخلَّج",56,"ج",1,0],["وان خفا حالي فتدري انه","لكل خاف مكتم عنوان",57,"ن",1,0],["وأنخ بعيسك حولها فلاهلها","فضل على الخدام والأمراء",58,"ا",2,0],["وأنخ مطايا القصد في أعتابه","وابشر بنيل الفوز والأكرام",59,"م",1,0],["وأنخ على باب الصراحة ناقتي","حتى يموت بغيظه المتذمر",60,"ر",1,0],["وإِن خُنتِ عَهدِى دُونَ ذَنبٍ جَنيتُهُ","وقَطَّعتِ مِنِّي مُحكَمَاتِ الوَثَائِقِ",61,"ق",1,0],["وَإِنَّ خَطيرَ مُلكِهِ وَصَفِيَّهُ","بِرَبعِكَ نَوءا رَحمَةٍ كَوكَبا سَعدِ",62,"د",1,0],["وإن خفضت في مشرع الطعن أرجيت","عليهم من النقع المثار مضارب",63,"ب",1,0],["وإنْ خَفَتْ راياتُك الحمر سّبَّحتْ","لنَصْرِك أَعلاها ملائكةٌ جُنْد",64,"د",1,0],["وإن خلع العذار غدا أميرا","سرورا أو أسرّ من الأمير",65,"ر",1,0],["وأنَّ خيرَ خلقهِ محمّدُ","رَسولهُ المُتمّمُ المجدّدُ",66,"د",1,0],["وإنَّ خزانةَ الآمالِ ملأى","لمن تلقاهُ مهزولَ الجرابِ",67,"ب",1,0],["وأنخ بسلع فالعذيب فبارق","فالرقمتين فحاجر فالاجرع",68,"ع",1,0],["وان خفق البرق اليماني عشية","فيزداد قلبي من تلهفه خفقا",69,"ق",2,0],["وإنْ خَالفُوهُ كَرَّ فيهم مُصَادمِاً","وَيَرْجِعُ عنهم تائهاً وَهْوَ باسِمُ",70,"م",1,0],["وإن خطرتْ فيه رِيحُ الصَّبَا","تنفّس في الجوّ منه عَبير",71,"ر",1,0],["وَاِنخَرَطنا بِكَ في سِل","كِ الهَوى أَيَّ اِنخِراطِ",72,"ط",1,0],["وَأَنِخ بِهِ مُتَهَلِّلاً","لِلطارِقينَ مُرَحِّبا",73,"ب",2,0],["وان خيال الشمس فيها أسنة","بها طعنت أعطافها وتحورها",74,"ر",3,0],["وان خلتم سواكم لي خليلا","فأن الحب للخل القديم",75,"م",1,0],["وإن خَرَجتُ بِلَيلٍ نَحوَ مَسجِدِهِم","أضَرَّني بَصَرٌ قَد خانَهُ العَمَشُ",76,"ش",1,0],["وإن خُوّفتِ شراً لا تخافي","لأنَّ بقيّةَ الأبطال فينا",77,"ن",2,0],["وإن خَرجوا يويماً للهوٍ ونزهةٍ","تجرُّ جيادُ الخيلِ أغلى المراكب",78,"ب",1,0],["وان خفت الذنوب فبشراني","بعقبي الدار في دار القرار",79,"ر",1,0],["وان خضت في بحر الذنوب جهالة","فعطفك يا فرد الجَلالة بالصفح",80,"ح",1,0],["وإن خفت من حمل المآثم في غد","فلا تسع في كسب الحمولة والفرش",81,"ش",1,0],["وإن خفت لوما في سؤال امرئ فكم","ملام سؤال في ملامس وال",82,"ل",1,0],["وَأَنّ خَطيب المدحِ فيه عطارد","فَيصدعُ آذانَ الأهلّةِ والقلبا",83,"ب",2,0],["وإن خرجنا لم تقل مثل ما","نقول قدم طرفه قدم",84,"م",1,0],["وَإِنَّ خالي فَهمي أَو حُسَينَ أَخي","وَإِن عَمى فُؤاداً أَو أَبى غالي",85,"ل",2,0],["وَإِن خُيِّرتَ بَينَهُمُ فإلصَق","بِأَهلِ العَقلِ مِنهُمُ وَالحَياءِ",86,"ا",2,0],["وَإِنَّ خَلائِقي حَسُنَت وَطابَت","كِرامٌ لا يُسَبُّ بِهِنَّ نَعشي",87,"ش",2,0],["وَأَنّ خَير فَتىً في قَومِهِ شيماً","أَخي وأنزه أَخلاقاً عَن الرِيَبِ",88,"ب",1,0],["وإن خَلتْ منك عَيني حين تُسهِرها","فليس يُخْليك طُولُ الوجْد من فِكَري",89,"ر",2,0],["وَأَنَّ خُيولَ العَيشِ دُهمٌ وَإِن تُنِر","فَنُذرٌ وَأَمّا شُهبُهُ فَبَشيرُ",90,"ر",1,0],["وإن خضعت تلك الحواس لعقلنا","فتأكل معْه من طعام الملائكِ",91,"ك",1,0],["وَاِنخِزالي اِذا رَأَيتُ وشاتي","كَاِنخِزالِ العُصفورِ عِندَ البازِ",92,"ز",1,0],["وإن خضتم في قصة كان همكم","تطاف محلات الشجار وتنظر",93,"ر",1,0],["وأنخْتَ في حَزْنٍ ركائبَ صُحبَتي","والصّارخُ الملهوفُ خَيرُ صَريخِ",94,"خ",1,0],["وَإِن خبت نارها فاعلم بِأَنَّهموا","بِحَدِّ أَسيافهم يَطفون للهبِ",95,"ب",1,0],["وأنخها قلائصاً قد عراها","ما عرانا من الضنى والنحولِ",96,"ل",1,0],["وإن خَطَرت كانت كما خطر القنا","فما نَظَرتْ إلاَّ بأبيض يُنتضى",97,"ض",2,0],["وَإِن خِفتَ مِن دارٍ هَواناً فَوَلِّها","سِواكَ وَعن دارِ الأَذى فَتَحَوَّلِ",98,"ل",1,0],["وإن خاضَ في بحرِ الثغورِ رأيتَهُ","يُنشِّرُنا أطرافُهُ بالجواهِرِ",99,"ر",1,0],["وإِنْ خَلَعَ اللَّيلُ الأَصائلَ فاخلَعي","إِلَى المَلِكَينِ الأَكْرَمَينِ عِذَارَكِ",100,"ك",1,0],["وإن خالطتها فالسر منها","فسر الحيزبون الدردبيس",101,"س",1,0],["وإن خبت البروق فنورتها","وقد هبت بمطلعها صباها",102,"ا",3,0],["وإِن ختمت فجوِّده لتحفظه","ورابط الدرس في وقتي مسا وضحى",103,"ح",2,0],["وإِن خُلُوَّ البال في كل خلوة","مع الأخوة الأَبرار من حيث ينتح",104,"ح",1,0],["وإن خصصت بفضل وانفردت به","فهم به عن جميع العالم انفردوا",105,"د",3,0],["وإِنْ خلا فكري يوماً وصفا","أردِّدُ السجع لكم مراجعا",106,"ع",2,0],["وإن خان عامَيْها الربيعُ فإنها","بماء يديه الآن في القيظ تُربِعُ",107,"ع",1,0],["وأنَّ خُروقَ المجدِ ليستْ لراقع","سوَاه وصدعَ الجودِ ليس لشاعبِ",108,"ب",1,0],["وإن خيفَ حربُ الجدبِ شيموا فأنهلوا","رماحَ الأماني من صدور المواهب",109,"ب",1,0],["وإن خزنَ الناسُ اللهى أنطق اللّها","بمثعنجرِ الشّؤبوب يأبى له الخزنا",110,"ن",2,0],["وأن خفّتْ تداركها بجيشٍ","وجأشٍ ثابتٍ لا يُستطار",111,"ر",1,0],["وان خطرت في يانع الدوح عانقت","قدود غصون وشحت بعقيق",112,"ق",1,0],["وإن خضن لج الآل مرَّت خفائفاً","فتحسبها سفناً مواخر في بحر",113,"ر",1,0],["وإنْ خلع البيضُ البياضَ فإنَّني","لبستُ به ثوبَ النُّهى وهو معلم",114,"م",1,0],["وإن خطبوا الوقعية بالعوالي","غدت أمَّ الحمامِ بلا نكاح",115,"ح",1,0],["وإن خفنا سطى الحدثان عجناً","من الملك العزيز إلى معاج",116,"ج",1,0],["وإن خانَكَ الصَّحبُ والأصفياء","فقد خانَنا مَن لهُ نَنتَمي!",117,"م",2,0],["وإن خان السوى الخضرا فإني","بوزن الأرض ما لا لم أخنها",118,"ن",3,0],["وإن خاضت الأرواح ديباجة القرآ","ن لاح لها سر اقتتاح الكينونيه",119,"ي",2,0],["وان خلق الانسان والحن كلهم","هو المقصد الأقصى سواه وسايل",120,"ل",1,0],["وإنْ خَبَتْ نارُ وجدي بالسُّلوِّ فلا","ورّتْ زنادي ولا أجرى النُهى حِكَمي",121,"م",2,0],["وإنْ خفقَتْ له يوماً بُنودٌ","فأجنحةٌ لدُنيا أو لِدِينِ",122,"ن",1,0],["وإن خفقت راياته خفقت لها","قلوب أعاديه من الخوف والذعر",123,"ر",1,0],["وَإِن خَليلَيكَ السَماحَة وَالنَدى","مُقيمان بِالمَعروف ما دُمت توجد",124,"د",1,0],["وأنختُ بالحرَمِ الشَّريفِ مَطِيَّتي","فَتشرفَت واشتاقَها الأقدامُ",125,"م",1,0],["وَإِنْ خَشَع الأقوامُ يوماً لربّهم","فأين خشوعٌ من خشوع شَمامِ",126,"م",1,0],["وإنّ خُراسانَ زَلْزَلتَها","وما لَكَ من رُكُنٍ زائلِ",127,"ل",1,0],["وَإِن خَصَّ لَم تَعدُ الصَنيعَةُ أَهلَها","وَإِن عَمَّ أَعطى غَيرَ نَزرٍ مُقَلَّلِ",128,"ل",1,0],["وَإِن خَلَت بِحَديثِ النَفسِ فِكرَتُهُ","حَيى الرَجاءُ وَماتَ الخَوفُ مِن وَجَلِ",129,"ل",1,0],["وإن خانك الناس الذين تودهم","وما خنتهم في الود فاصبر على البلوى",130,"و",2,0],["وإن خالطوا الأغيار كانت جنابة","لهم رفعها فرض على القوم قاطع",131,"ع",1,0],["وإن خرقت سفينةْ بحرْ أمرهْ همسْ","أقم جدار الشريعه والصلاة الخمسْ",132,"س",1,0],["وأنخ بتلعات العقيق فإنه","واد هناك عهدته فياحا",133,"ح",2,0],["وانخلع عنك وعربد طرباً","وتهتك في الهوى وافتضح",134,"ح",1,0],["وإن خالطتهم وسلكت معهم","يكون لهم بفعلك ذا رضاء",135,"ا",2,0],["وانْخَلعْ عَنْكَ يا خَليع غَرَامي","لا تَكُنْ غيرُ وجْهنَا لك قبْله",136,"ل",2,0],["وَإِنْ خَرَجْنَا لَمْ تَقُلْ مِثْلَ مَا","نَقُولُ مِنْ تَوَدُّدِ المُكْرِمِ",137,"م",1,0],["وإِن خَرَجْتُ من الدُّنْيَا ولذَّتِها","طوعاً فيا ربْحَ بَخْتيَ بَعْدَ خُسْرانِ",138,"ن",1,0],["وإِن خان الصديق فلا عجيبٌ","أَليس الأَصدقاء بني الزّمان",139,"ن",1,0],["وإِنْ خِفتَ من عاتبٍ فاستترْ","بليل الشَّباب إِذا ما جَنَح",140,"ح",1,0],["وَإِن خَطَرَت سَكرى فَمِن كُلِّ رائِقٍ","مِنَ اللَفظِ وَالمَعنى وَمِن كُلِّ شائِقِ",141,"ق",1,0],["وإن خُضتَ بحراً للمكارمِ والعُلا","فلا تقتطف إلّا من اللؤلؤ الرطبِ",142,"ب",1,0],["وإنّ خوّض الهيجاء سد فجاجها","رجالا وسدتها الجياد السلاهب",143,"ب",1,0],["وإنْ خلاهُمُ فينا تُيوساً","تُناطح كلَّ يومٍ بالصَّياصي",144,"ص",2,0],["وإنْ خطَّ في طُرْسٍ أتَى في كتابِهِ","بأبدَعَ من وَشْيِ البساط المنَمنَمِ",145,"م",1,0],["وإن خلت من مثار الحرب ناحية","يوماً تناولها الإرجافُ والصَّخَب",146,"ب",1,0],["وان خطبوا مجدا فإن سيوفهم","مهور وأطراف القنا لهم رسل",147,"ل",1,0],["وَإِن خَشَعَت أَبصارُهُم وَتَضاءَلَت","مِنَ الأَينِ جَلّى مِثلَ ما يَنظُرُ الصَقرُ",148,"ر",1,0],["وإن خاب من عاداكم يوم حشره","فنحن بكحم دون البرية قد فزنا",149,"ن",2,0],["وإنْ خليلُك قد جافاك صلْه وزرْ","غِبّاً ولا تأتِ مَنْ تهَواه إشرافا",150,"ف",2,0],["وإن خلَوْا بينهم ينمو بمجلسهم","قيلٌ وقالٌ وتصغير وألقاب",151,"ب",1,0],["وإن خابت فلا خابت طريقي","وإن كان الهوى ثانيه عني",152,"ن",2,0],["وَإنْ خَانَ عَهْدِي وَاسْتَمَرَّ عَلىَ غَدْرِي","لَئِنْ كَانَ مَنْ أَهْوَاهُ فِي الْحُبِّ يَرْتَضِي",153,"ي",1,0],["وإن خفت حلومهم وشفت","رجحن له حلوم كالجبالِ",154,"ل",1,0],["وإن خطبته الحرب أمهر بكرها","سيوفا وأرماحا ونقطا وأسهما",155,"م",2,0],["وَإِن خطبٌ أَصاب جَنابَ جارٍ","فَأمّل كَون موقعهِ قَريبا",156,"ب",2,0],["وَإِن خانَني في مدّةِ الدهرِ صاحبٌ","تَعوّضتُ منه في زماني بصاحبِ",157,"ب",1,0],["وإن خلَّصَ النَّاسَ الضياءُ من الدجى","فأَنْتَ لأعلاِم الضَّياءِ ضِيَاءُ",158,"ا",2,0],["وَإِنْ خَبَطْنَ البِيدَ وَالأَسامِرا","مِنْ صُلْبِ قُفٍّ أَوْجَع الأَماعِرا",159,"ر",2,0],["وَإِن خَرَجوا مِن غَمرَةٍ رَدَّها لَهُم","دُعايَ وَتَحريضي لَهُم وَنَشيدِي",160,"د",2,0],["وإن خطاك حكى قطر الندى عددا","فكن على الله بالغفران معتمدا",161,"د",2,0],["وإن خفقت بنود سطاه صاحت","غشا الضرغام وانقضَّ العقابُ",162,"ب",1,0],["وأَنَخْتُها في بَعْلَبكَّ لأنّها","خيرُ البلادِ ومَلْكُهَا خَيْرُ الورَى",163,"ر",2,0],["وإن خاطبت مأموراً","به عاد كلامين",164,"ن",1,0],["وإن خطرت من سفح نجدٍ نسيمةٌ","فلي أنَّةٌ تحت الدُّجى وزفيرُ",165,"ر",1,0],["وَإِن خَانَنِي خِلٌّ أَعُدُّ وَفاءَهُ","فَسَيفِي وَزِيرٌ لِي أَشُدُّ بِهِ أَزرِي",166,"ر",2,0],["وأنخ راحلة الوجد وقل","لستِ يا أربعُ تلك الأربعا",167,"ع",2,0],["وإن خسفت مفارقُ طار منها","فراش الهام شاردة عِزينا",168,"ن",2,0],["وأنخ إذا آنست لمعة بارقٍ","بين الطلول فإنها آثارها",169,"ر",3,0],["وإن خرجت إلى روض السعود فقف","كما عرفت وبت في درب زيتون",170,"ن",1,0],["وأنختها من حول برقة راجياً","منها الوصال لأنني أختارها",171,"ر",3,0],["وإن خالَهُ من شدَّةِ الركضِ ناجِياً","فَما كانَ إِلَّا بَينَ أَنيابها يَعدُو",172,"د",2,0],["وَأَنخ بِباب رِحابه بدن الرَجا","ء وَلا تخم فَالجود فيهِ خيم",173,"م",1,0],["وإِنَّ خَوْفي لذي الشنآن مختلِطٌ","بحيث منه يحلّ الروح والنَّسَمُ",174,"م",1,0],["وأنخ بفياض اليدين كأنما","يَثْنِيه عند المدح كأس مدام",175,"م",1,0],["وأنخ بأطراف الخيام ولا تُرَع","لأسود غابات القنا المتأشب",176,"ب",1,0],["وَإِنَّ خُضوعَ النَفسِ في طَلَبِ الهَوى","لَأَمرٌ إِذا فَكَّرتُ فيهِ عَجيبُ",177,"ب",1,0],["وإن خَبت ناره عشاءً","فسوّ من مات في المهاد",178,"د",1,0],["وأنخها هنيهة وارحها","قد براها فرط السرى والكلاله",179,"ل",2,0],["وإنْ خَرَسَتْ عن نُصرَة الدّين أَلْسُنٌ","فكَمْ ألسنٍ مثلَ الأسنّة ناطقَة",180,"ق",2,0],["وإن خرجت في زينة أو تطيبت","لتمنع وإن خفت الأذى امنع وشدد",181,"د",1,0],["وإن خاف من نسيانه احظر وسنة","بأول ليل في الشتا الختم يا عدي",182,"د",2,0],["وإن خاف منه لم يجب مطلقا سوى","إذا اضطر قط وليحترس خوف مفسد",183,"د",1,0],["وإن خفقت نكباء من أيمن الحما","بدا لفؤادي المستهام خفوق",184,"ق",1,0],["وإن خيَلوا قومٌ لموسى حبائلاً","من الفضل تسعى وعصّياً لها سير",185,"ر",1,0],["وإن خيَّم الليلُ قام السوادُ","بهيماً كعقلٍ أضاعَ الذكاءَ",186,"ا",2,0],["وإن خفقت ريح الشمال تبرجت","على الرغم مني محصنات السرائر",187,"ر",1,0],["وإن خَفِيَتْ انسابُ قومٍ فإنه","لكالشمسِ لا يُبْغَى عليه دليلُ",188,"ل",1,0],["وَأَنِخْ بابن الحُسين إِنّه","غُصُنٌ في تُرْبةِ القُدسِ نما",189,"م",2,0],["وإن خام الفتى العربي يوماً","قلته تغلب وأبت نزار",190,"ر",1,0],["وَإِن خَصيب هذا المصراودي","فَلا مَصر هُناك وَلا خَصيب",191,"ب",1,0],["وإن ختنكم يوماً فخانني المنى","وساء لديكم بعد إحماده ذكري",192,"ر",2,0],["وإن خلتَهُ بين الزبرجد فضّة","فعَمّا قريب سوف تلقاهُ عسجدا",193,"د",2,0],["وإن خفت من قوم هناك خيانة","فحاربهم طرا بجند الصواعق",194,"ق",1,0],["وأنخها وانزل بأكرم حي","فيه يحظى الموعود بالتنجيز",195,"ز",1,0],["وإن خليل الله من ناره نجا","بجاهك عند الله قد جاءها أمر",196,"ر",1,0],["وأَنّ خيام الاهتمام بنُصُرتي","يَلوحُ عَمودُ الفجْر تحتَ عمودها",197,"د",3,0],["وان خطرت يهتزُّ خلف ازارها","كثيب تكاد الريح تسفيه من عل",198,"ل",1,0],["وانخذال الخصم في المي","دان معناه النجاح",199,"ح",1,0],["وأنخ بحيهم المطي وحيهم","عن مغرم دنفٍ كئيب لواء",200,"ا",2,0],["وإن خاب الدفاع فسوف أرجو","سماع رئيس محكمة غفور",201,"ر",1,0],["وأنخ بضال الشعب منه منشداً","هذا الحمى ما بارق والأبرقُ",202,"ق",1,0],["وانخلع عنك يا خليع غرامي","لا يكن غيرنا لوجهك قبله",203,"ل",2,0],["وإن خطَرت بالنَّفس صحبةُ غيرِكم","فلا بَرِحَتْ محمولةً بي على الخطَرْ",204,"ر",1,0],["وإن خَلا المجلسُ مِن شَخصهَا","بَانَ عَليه النَّقصُ وَالاختلال",205,"ل",1,0],["وان خير خلقه محمدا","نبيه وعبده نور الهدى",206,"د",2,0],["وإن خشيت حجة المغاني","وخوفهم من ضامن القيان",207,"ن",1,0],["وأَنِخْ ركابَك فالرِّحابُ بسيطة","وابسط يديك تنالُ فيضَ نَدائه",208,"ا",3,0],["وَإِنْ خِفْتُمُ الغَدْرَ مِن وامقٍ","فإِني وَفِيٌّ علَى كُلِّ حالِ",209,"ل",1,0],["وأنخ مطيك حيث منطلق الهوى","يشفي الجوى والجسم بالتعيين",210,"ن",1,0],["وَإِن خفق البدر يَنحو الحمى","نَزَت كبدى نحوكُم تخفقُ",211,"ق",1,0],["وإن خانه دهره أسلموه","ولم يبق منهم له واحد",212,"د",1,0],["وإنْ خفّ جيشُ النصْرِ أو عادَ قافِلاً","فيكْلأُ في أعْقابِه مَن تقدّما",213,"م",2,0],["وإنْ خذَلَتْ نُعْماك في القومِ أُسْرَةٌ","فما أحْقَرَ المَسْعى وأخْفى وأخْفَقا",214,"ق",2,0],["وإنّ خِلالَك شُهْبٌ تجلّتْ","وراقَتْ بأفْقِ المَعالي شُروقا",215,"ق",2,0],["وَاِن خِلتُموهُ قَد تَعطف بِالَّتي","وَمن بَعد ذاكَ البُعد مالَ لِعَودَةِ",216,"ه",1,0],["وَان خِلتُما في وَجههِ نَظرَة القَلى","فَاِيّاكُما مِمّا",216,"م",2,0],["وَاِن خِلتُموهُ رامَ لي الصَد بَعدَما","حَباني صَفاءَ الوُدِّ قُبلاً وَاِنعَما",216,"م",2,0],["وإن خرجت مروعةً لأحدٍ","فقد عادت بأمنٍ واحتشام",217,"م",1,0],["وَإِن خفت مِن ذَنبي فَمنّ بِعَفوه","نَجَوت مَع الهادي فَمَنّ وَأَنعَما",218,"م",2,0],["وَإِن خفتما مما تهاب صعابه","فكونا عَلى الذكرى حريصين وَاسلما",219,"م",2,0],["وَإِن خانتك طارقةُ اللَيالي","فَخالف كُلَّ جَبار عَنيد",220,"د",1,0],["وَانخفاض وارتفاع","في سهولٍ وَجبال",221,"ل",1,0],["وإن خانَني حزمي وعزمي وهمتي","فإن دموعَ العين ليس تخونُ",222,"ن",1,0],["وإن خطرت حوله الحادثات","ثناها الجمود فما تخطر",223,"ر",1,0],["وإن خص الوضيع رفيع قوم","بمدحته فذاك المدح ذام",224,"م",1,0],["وانخها برحاب لم يؤب","خائباً من حجّها واعتمرا",225,"ر",2,0],["وإن خوطبوا من جاهل أعرضوا ولو","أرادوا لردّوا لكن العقل عقال",226,"ل",1,0],["وأَنَّ خَليقَتي كَرَمٌ وأَنّي","إِذا أَبدَت نَواجِذَها الحروبُ",227,"ب",1,0],["وإن خَفِيتَ بينهم عَذَرْتَهم","فشدَّةُ الظهورِ تُوِرُث الْخَفَا",228,"ا",1,0],["وإن خلأت يوماً لشحط مزارها","فأبدل با عيناً ذات التعرد",229,"د",1,0],["وإن خالفتم أمري فإني","أقابلكم إذا جئتم بطرد",230,"د",1,0],["وإن خط سطراً أو تكلف خطبةً","فلا اللحن محصورُ ولا الهفوات",231,"ت",1,0],["وإنْ خَفَق النسيمُ أطارَ قلبي","وهيَّجَ لوعتي ذاكَ النسيمُ",232,"م",1,0],["وان خانَها صرف اللَيالي فانها","بمن اوجدت ارهاقها لا يطول",233,"ل",1,0],["وَإِن خَطَبَا يَجرِي مَنِيلا مُبَيِّناً","أَدِلَّتَهُ جَرياً وما ثَمَّ إِضمَارُ",234,"ر",1,0],["وَأَنخها في ربع كل عدو","وَإِلَيهم قَدها سَلاهِب جردا",235,"د",2,0],["وإن خلط الدهرُ فاصبر على","تلونهِ فمع اليوم غد",236,"د",1,0],["وإن خص بيعُ ملكِ حر بنعمةٍ","إذا قوبلت بالشكر قارنها المجدُ",237,"د",1,0],["وَأَنَّ خَريرُ الماءِ أَنَّةَ عاشقٍ","يَحنُّ إِلى زَهرِ الغُصونِ وَلِلقَضبِ",238,"ب",1,0],["وَإِن خَلَفت بِنتينِ وَاِبناً فَبَعدَها","يَمدُّ إله العَرشِ مِن فَوقِهِم سترُ",239,"ر",1,0],["وإن خمول الشعب والجهل والونى","لسالبة التوفيق قاصمة الظهر",240,"ر",1,0],["وأنخها بين جمع والصفا","وأثيلات الغض والأبرق",241,"ق",1,0],["وإن خفقت نكباء من أيمن الحمى","بدا لفؤاد المستهام خفوق",242,"ق",1,0],["وأنخ قلوصك في حما","ه ترى النجاة من المضامه",243,"م",2,0],["وأنخ في بابه راحلة العزم","والزم بجاه الادبا",244,"ب",2,0],["وأنخ مطيك ثم وانزل في حمى","خير الورى البر الرحيم الملتجا",245,"ج",2,0],["وإن خرجت فإني","أضيع بين العلوج",246,"ج",1,0],["وانخنت ركب صبابتي برحابه","نظراً أصعد بالرجا واصوب",247,"ب",1,0],["وأَنختُ العيسَ في أَبوابكم","ولأَجواز الفلا لم أَجُبِ",248,"ب",1,0],["وإن خلتَ في الجثمان يوماً تحمُّلاً","سعيراً فجرب بعضَ حرّ الظهيرةِ",249,"ه",1,0],["وإن خلتمُ ميناً بما بالحشا ضرّا","سلوا فاتر الأجفان عن كبدي الحرّا",250,"ر",2,0],["وانَّ خُطُوبي في العُلا اسْتَطِيبُها","ويَصْعُبُ في عَيْنِ الأَبيِّ التَّمَلُّقُ",251,"ق",1,0],["وانْ خَمَدَتْ لَظَى الاقْدامِ فِينا","فَلَمْ يَبْرَحْ لها فيكمْ لَهِيبُ",252,"ب",1,0],["وإن خفقت لهم رايات بطش","فؤاد الخافقين تراه خافق",253,"ق",1,0],["وإن خمدت نيرانها بعد وقدها","يؤججها بالمرهفات القواضب",254,"ب",1,0],["وَإِن خاطَبَتكَ النَفسُ يَوماً بِرَجعَةٍ","فَشَفِّف لَها كَأساً مِنَ السُمِّ ناقِعُ",255,"ع",1,0],["وإن خالفتهم يوما بأمر","يسوغ خلافه نصبوا عدائي",256,"ا",2,0],["وأن ختام المرسلين محمد","إلى الثقلين الجن والإنس مرسل",257,"ل",1,0],["وأنخ مطيك في حماه فإنه","حمد السرى يهنيك طيب قراره",258,"ر",2,0],["وأَنخَابُهُ مِن دَمٍ","ونفطٍ, وغازٍ مُسالْ",259,"ل",1,0],["وإنْ خَبَتْ فِتنَةٌ في الكونِ أجَّجَها","يُضيفُ زيتاً لَها إنْ قَلَّ أوحَطَبا",260,"ب",2,0],["واِنْ خفقَتْ بقلبكَ ياصديقي","فقل يانفسُ خلُّكِ لن يخونا",261,"ن",2,0],["وأن خيالها في كل ليلٍ","يؤرقني ويحرمني المنام",262,"م",1,0],["وأن خيارهن أشدّ لؤماً","وأن الغدر فيهن سواء",263,"ا",2,0],["وإن خانت حروفي جميع التعابير","والدمع راق من العيون الشقيّه",264,"ي",2,0],["وإن خانتك دنياك أو خنت دنياك","إرجع وتلقابي مكانك..مكانك",265,"ك",1,0],["وَإِنْ خَاْنَتْكَ لاْهِيَةٌº وَحَاْمَتْ","عَلَىْ نَاْرِ الْخِيَاْنَةِ كَالْفَرَاْشِ",266,"ش",1,0],["وانخ ركابك في منى حيث المنى","واطرح جمار تلوع وعناء",267,"ا",2,0],["وان خطب دهى في يوم حرب","فاسد لا ينهنهها اللقاء",268,"ا",2,0],["وأنختُ قلبي في رحابِكَ مُوقنًا","بكريمِ فضلكَ يا عظيمَ الشَانِ",269,"ن",1,0],["وإن خلعنا الصبا سلباً وتعريةً","فلم نزل بذيولٍ منه نلتحف",270,"ف",1,0],["وإن خلد الماضون في الصخر ذكرهم","على الدهر إن الدهر بالصخر يعصف",271,"ف",1,0],["وإن خصصت بحبي الناهضين بها","فهل ألام على أني أحبهم",272,"م",1,0],["وإن خففت على الفودين محتشماً","فقد حففت شبابي المحض بالظنن",273,"ن",1,0],["وإنْ خانَ الرفاقُ أَنا الوَدودُ","وذِكري في الأَنامِ هُو الحَمِيدُ",274,"د",1,0],["وَإِنْ خَلَعَ السُّهَاْدُ عِذَاْرَ نَومِيْ","لَيَشْزِرُ نَوْمَتِيْ مَقْتَاً وَبُغْضَا",275,"ض",2,0],["وإنْ خاطبتُ ليلي أنْ تَرَحَّلْ","تقول العينُ : ليلُكَ يستطيلُ",276,"ل",1,0],["وإن خفضته قلت بلقاء عائذ","رموح لها طفل عليه تصول",277,"ل",1,0],["وَانْخَلْ جَميعَ أمُورِهَا يَا ذَا النُّهَى","وارمِ النَّخَالَةَ جَانِبًا يَا نَاخِلُ",278,"ل",1,0],["وإنْ خَنَسْ إبليس ونحوك نَشَبْ","فالعن أبوه من نذل ناشب",279,"ب",1,0],["وإن خالفوا المنصوص كان اتباعنا","لنص رسول الله إذ كان أسلما",280,"م",2,0],["وإن خيف ثغر للمنية فاغر","تخطى به في ثاقب العزم نزالا",281,"ل",2,0],["وان خذتك مني عين ماتسمي","العن الدنيا وابوها وامها",282,"م",3,0],["وإن خانوكَ بعدَ العهدِ يومًا","وعادوا بعدما انقطعَ الرجاءُ",283,"ا",2,1],["وَإِنْ خَطْبٌ أَصابَ جَنابَ جارٍ","تَأَمَّلْ كَوْنَ مَوْقِعِهِ قَرِيبا",284,"ب",2,0],["وإن خان اللقاء وكان وغداً","ولم يطلع عليَّ أقول ويلي",285,"ل",2,0],["وأن خيالك في خاطري","يرف كزنبقة ناديه",286,"ي",2,0],["وأن خاب ضني بأقرب الناس وشلون","بعطيك ضني يارفيق الندامه",287,"م",2,0],["وإنْ خانكِ الصَبْرُ نادي جناحي","وطيري إلى اللهِ وابكي مليّا",288,"ي",2,0],["وأنختُ المطيَّ عندك في عام رب","يعٍ والفصلُ فصلُ مصيف",289,"ف",1,0],["وإن خاب يلقى سيف عمرو بن العاص","يبتر خماله يوم شبره قصيري",290,"ر",2,0],["وان خذتني دمعتي سقت اغنياتي","دام حزني كل ما اطريّك دنّق",291,"ق",1,0],["وانخى بالعربان بني تميم المغاوير","وعيال وايل وعتيبه وباقي خوالك",292,"ك",1,0],["وإنْ خَلوتُ سَألتُ الله َ يَحْفَظُكُمْ","وإنْ ذُكِرْتَ لدَيَّ قلتُ: أُسْتَاذِي",293,"ي",1,0],["وأَنَختُ في المِحرَابِ ذُلًّا هَامَتِي","أَرجُو بِقُربِكِ أَنْ أَكُونَ رَشِيدَا",294,"د",2,0],["وإن خاصمتُ طيفك لا تلمني","ودعني أُسمع الدنيا صداه",295,"ا",2,0],["وَإِن خِلتَ تَعيير الفَتى لا يَضيرُهُ","فَكُلُّكَ سَوءاتٌ أَلسُنُ",296,"ن",1,0],["وإن خالطتهم وسلكت معهم","يكون لهم بفعلك ذا إرضاء",297,"ا",2,0],["وإنْ خَشيتَ بلاداً لم تزلْ وَلَهاً","غَيرَى عليكَ فميلادي هو الواقي !",298,"ق",2,0],["وأنخت الركاب أحثو الأماني .","ماتحا من نميرها فارتويتُ",299,"ت",1,0]]}