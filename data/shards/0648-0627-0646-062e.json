ر"],[513,"أراجعة لي عيشة الزمن النضر","https://www.aldiwan.net/poem12118.html","الطويل"],[514,"والله ما يدري امروء ذو جنابه","https://www.aldiwan.net/poem48701.html","الطويل"],[536,"يا أيها المولى الذي بوجوده","https://www.aldiwan.net/poem47952.html","عموديه"],[549,"عليك أمير المؤمنين سلامي","https://www.aldiwan.net/poem47205.html","الطويل"],[549,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[551,"سرت بملام حين هوم عذلي","https://www.aldiwan.net/poem68431.html","الطويل"],[551,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[556,"سل القلب عن صدق المودة في الذي","https://www.aldiwan.net/poem33586.html","الطويل"],[556,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[556,"غلام نفسك بنفسك فاقتله يا شمس","https://www.aldiwan.net/poem34441.html","المواليا"],[556,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem34658.html","الكامل"],[556,"هيكلي سام سليم الشبح","https://www.aldiwan.net/poem34676.html","الرمل"],[556,"بلاء الأنبياء هو البلاء","https://www.aldiwan.net/poem35089.html","الوافر"],[557,"قد كساني لباس سقم وذله","https://www.aldiwan.net/poem69349.html","الخفيف"],[565,"مالك موفور فما باله اكسبك","https://www.aldiwan.net/poem69501.html","السريع"],[573,"قد كان ما كان من جهلي وطغياني","https://www.aldiwan.net/poem2755.html","البسيط"],[583,"إذا غرت خيول الهجر يوماً","https://www.aldiwan.net/poem1567.html",""],[583,"لقد سمح الدهر بالمقترح","https://www.aldiwan.net/poem1571.html",""]],"verses":[["وَأَنَختُ عيسي في جَنابِكَ طارِحاً","بِفَناءِ دارِكَ أَنسُعي وَقُتودي",0,"د",2,0],["وَإنْ خاشَنَتْنِي النَّائباتُ تُشَبَّثَتْ","بِأَروعَ عَبلِ السَّاعِدَينِ مُخاشِنِ",1,"ن",1,0],["وَإِنْ خِفْتَ هَجْواً وَاتَّقَيْتَ بِنائِلٍ","قَوارِصَ تَأْباها النُّفوسُ المَواجِدُ",2,"د",1,0],["وإنْ خَطَرَتْ وَهْناً صَباً مَشرِقيّةٌ","على كَبِدِي هاجَ الغَرامَ هُبوبُها",3,"ب",3,0],["وَإِن خالَفتَني وَعَصِيتَ قَولي","فَلا تَجزَع إِذا لَم تُعطَ طاعَه",4,"ع",2,0],["وإنْ خبرْتَ القوْمَ ألفَيْتَهُمْ","للّهِ ما أهْدَى وما أوْرَعا",5,"ع",2,0],["وَأن خَصَّكَ الرَّحْمَانُ جَلَّ جَلاَلَهُ","بِمعْجِزَةٍ مَنْسُوبَةٍ لِسُلَيْمَانِ",6,"ن",1,0],["وَإنْ خَلطَوُا عُرفاً بنُكْرٍ وَقَصَّرُوا","وَزَنْتَ بِقِسْطَاسٍ قَوِيمٍ وَمِيزَانِ",7,"ن",1,0],["وإنْ خطّ وجْدي منْ دُموعي رِسالَةً","على صفْحِ خدّي فالنّسيمُ سَفيرُ",8,"ر",1,0],["وَإِنْ خُصَّ مِنْهُمْ مَاجِدٌ بِنَقِيبَةٍ","فَقَدْ حُزْتَ فِي الْعلْيَا جَميِعَ الْمَنَاقِبِ",9,"ب",1,0],["وَإِن خَطَرَت ذِكرى الفُحولِ بِفارِسٍ","وَما خَلَّفوا في القَولِ مِن كُلِّ مُشبِعِ",10,"ع",1,0],["وَإِنَّ خَليلاً يُحدِثُ الصَرمَ كُلَّما","نَأَيتَ وَشَطَّت دارُهُ لَظَنونُ",11,"ن",1,0],["وَإِن خَفِيَت كانَت لِعَينَيكَ قُرَّةً","وَإِن تَبدُ يَوماً لَم يَعُمَّكَ عارُها",12,"ر",3,0],["وَإِنَّ خَيْراً حَلِيفاً مَنْ تَرُوضُ بِهِ","صَعْباً وَتُولِيهِ وُدّاً بَعْدَ عُدوَانِ",13,"ن",1,0],["وأن خبث البرايا في طبائعها","لا بدّ فيه سوى الإطباع من سبب",14,"ب",1,0],["وإن خشِيت على البلدان جِنّتها","فنُط بها من نُهاهم بعض أحراز",15,"ز",1,0],["وَإِنَّ خُراسانَ إِن أَنكَرَت","عُلايَ فَقَد عَرَفَتها حَلَب",16,"ب",1,0],["وإن خطا للمعالي خطوةً بهرت","كأنَّ أولَ ما يخطوه غايات",17,"ت",1,0],["وإن خفى زائداً فأعرض","عنه ودع منطقي يكف",18,"ف",1,0],["وإن خبا ضرم النيران من زمنٍ","فالبحر منسحب الأذيال مسدول",19,"ل",1,0],["وإنْ خيفَ موجٌ عيذ منه بساحلٍ","خليٍّ من الأجرافِ ذات الكَباكبِ",20,"ب",1,0],["وانخدِعْ لي أو تَخَادَعْ إنها","خُدعةٌ فيها رَباحٌ لا غبن",21,"ن",1,0],["وان خيال ليلى لي سراج","سيهديني اذا خفت الضلالا",22,"ل",2,0],["وَإِن خَرَجَت نارٌ فَكانَت جَهَنَّماً","تُغَذّى بِأَجسادِ الوَرى وَتُقاتُ",23,"ت",1,0],["وانخلوه فياله","إن ظفرتم به ظفر",24,"ر",1,0],["وإن خضتم فيه بعلم وحكمة","فصبراً على ما بين أيديكمُ صبرا",25,"ر",2,0],["وإنَّ خَلاصاً كنت أرجوهُ بُرْهَةً","وكان يزيدُ الأمر فيه وينقُصُ",26,"ص",1,0],["وَإِن خَفَّ مِن تِلكَ الرُسومِ أَنيسُها","وَأَخلَقَ مِن بَعدِ الأَنيسِ جَديدُها",27,"د",3,0],["وَإِن خَدَموكَ بِالأَبدانِ إِنّي","لَأَبلَغُ خِدمَةً مِنهُم بِفِكري",28,"ي",1,0],["وَإِنَّ خَراجي لَلخَفيفُ وَلَو غَدا","ثَقيلاً لَما استَحسَنتَ غَيرَ احتِمالِهِ",29,"ل",2,0],["وإن خرَجنا خلَعنا فَضلَ نِعمتِه","على المَناشفِ منا والمناديلِ",30,"ل",1,0],["وإن خفي الصوابُ على ملوكٍ","فإنَّ جميعَ ما تأتي الصَّوابُ",31,"ب",1,0],["وَأَنَّ خُطا الزَمانِ مُواصِلاتٌ","وَأَنَّ لِكُلِّ ما واصَلنَ قَطعا",32,"ع",2,0],["وإن خَفَضْتَ عُداةَ اللّه أو خُذلوا","فأنْتَ باللّهِ تستعلي وتنتصرُ",33,"ر",1,0],["وَإِن خَفَرَت أَموالَ قَومٍ أَكُفُّهُم","مِنَ النَيلِ وَالجَدوى فَكَفّاهُ مَقطَعُ",34,"ع",1,0],["وَإِنْ خَطَرَتْ بَيْنَ النَّدَامَى تَأَوَّدَتْ","كَأَنْ لَيْسَ عُضْوٌ فِي الْقَوَامِ عَلَى عُضْوِ",35,"و",1,0],["وَأَنَختُ مُنعَقِدَ الحِبالِ وَفَوقَهُ","رَحلٌ تَغَشَّت بَزَّهُ أَجلابُهُ",36,"ب",2,0],["وَإِن خافَ مِن وَقعِ المُحَرِّمِ يَنتَحي","عَلى عَضُدٍ رَيّا كَسارِيَةِ القَصرِ",37,"ر",1,0],["وَإِن خالَسنَ غِرَّتَكَ اِرتِقاباً","فَحَقٌّ أَن يَرُحنَ مُشَتَّماتِ",38,"ت",1,0],["وَإِن خَلَجَت عَينٌ لِبَينٍ فَحَسبُها","مِنَ البينِ يَومٌ مِن رَداً مُتَخَلَّجِ",39,"ج",1,0],["وَإِن خَفَضَتهُ هِمَّتُهُ تَهاوى","إِلى جِنسِ البَهائِمِ شَرِّ جِنسِ",40,"س",1,0],["وَإِن خَرَصوا مَيناً بِغَيرِ تَحَرُّجٍ","فَأَوجَبَ شَيءٍ أَن يُهانوا وَيُصفَعوا",41,"ع",3,0],["وَإِنَّ خَنساءَ إِذ تُزجي قَصائِدَها","نَظيرُ خَنساءَ يَدعو ظِمأَها الكرَعُ",42,"ع",1,0],["وَإِن خِفتَ مِن رَبٍّ فَلا تَرجُ عارِضاً","مِنَ المُزنِ تَهوى أَن يَزولَ بِهِ المَحلُ",43,"ل",1,0],["وإن خَطَرَتْ يوماً على خاطرِ امرىءٍ","أقامتْ به الأفراحُ وارتحلَ الهمّ",44,"م",1,0],["وإنّ خير رجاء","ما جاء من بعد ياس",45,"س",1,0],["وَإِن خَطَبتُ إِلَيها صَبرَها جَعَلَت","جِراحَةُ الوَجدِ تَدمى في جَوارِحِها",46,"ح",3,0],["وإنْ خَلَطَتْني بالتّرابِ مَنِيّةٌ","فبَعْضُ تُرابي من مَوَدّتكُم خِلْطُ",47,"ط",1,0],["وَإِن خانَ الصَديقُ فَلا تَخُنهُ","وَدُم بِالحِفظِ مِنهُ وَبِالذِمامِ",48,"م",1,0],["وَإِن خَمَدَت نيرانُ عَبلَةَ مَوهِناً","فَكُن أَنتَ في أَكنافِها نَيِّرَ الوَقدِ",49,"د",1,0],["وَإِنْ خَفِيَ الْحَقُّ فَاصْبِرْ لَهُ","وَبَادِرْ إِلَيْهِ إِذَا حَصْحَصَا",50,"ص",2,0],["وَإِنَّ خَليجاً مِن أَياديهِ للوَرى","يُرى كُلُّ بِحرٍ عِندَهُ يَتَضَحضَحُ",51,"ح",1,0],["وَأَنَّ خُطوباً أَشتَكيها سَتَنجَلي","وَأَنَّ أُموراً أَبتَغيها سَتَنجَحُ",51,"ح",1,0],["وأنّ خال عمه","كان يقود أرحبا",52,"ب",2,0],["وإن خبرت القوم ألفيتهم","لله ما أهدى وما أروعا",53,"ع",2,0],["وإن خيالاً يملأُ الشعرَ رَهبةً","سكونٌ على قبرِ الزهاويِّ سائد",54,"د",1,0],["وان خَشُنَتْ عليك مكاشفاتٌ","فحسبُك أن تُجامَلَ أو تحابَى",55,"ب",2,0],["وإن خلَجتْ عينٌ لبينٍ، فحسبُها","، من البين، يومٌ، من ردىً، مُتخلَّج",56,"ج",1,0],["وان خفا حالي فتدري انه","لكل خاف مكتم عنوان",57,"ن",1,0],["وأنخ بعيسك حولها فلاهلها","فضل على الخدام والأمراء",58,"ا",2,0],["وأنخ مطايا القصد في أعتابه","وابشر بنيل الفوز والأكرام",59,"م",1,0],["وأنخ على باب الصراحة ناقتي","حتى يموت بغيظه المتذمر",60,"ر",1,0],["وإِن خُنتِ عَهدِى دُونَ ذَنبٍ جَنيتُهُ","وقَطَّعتِ مِنِّي مُحكَمَاتِ الوَثَائِقِ",61,"ق",1,0],["وَإِنَّ خَطيرَ مُلكِهِ وَصَفِيَّهُ","بِرَبعِكَ نَوءا رَحمَةٍ كَوكَبا سَعدِ",62,"د",1,0],["وإن خفضت في مشرع الطعن أرجيت","عليهم من النقع المثار مضارب",63,"ب",1,0],["وإنْ خَفَتْ راياتُك الحمر سّبَّحتْ","لنَصْرِك أَعلاها ملائكةٌ جُنْد",64,"د",1,0],["وإن خلع العذار غدا أميرا","سرورا أو أسرّ من الأمير",65,"ر",1,0],["وأنَّ خيرَ خلقهِ محمّدُ","رَسولهُ المُتمّمُ المجدّدُ",66,"د",1,0],["وإنَّ خزانةَ الآمالِ ملأى","لمن تلقاهُ مهزولَ الجرابِ",67,"ب",1,0],["وأنخ بسلع فالعذيب فبارق","فالرقمتين فحاجر فالاجرع",68,"ع",1,0],["وان خفق البرق اليماني عشية","فيزداد قلبي من تلهفه خفقا",69,"ق",2,0],["وإنْ خَالفُوهُ كَرَّ فيهم مُصَادمِاً","وَيَرْجِعُ عنهم تائهاً وَهْوَ باسِمُ",70,"م",1,0],["وإن خطرتْ فيه رِيحُ الصَّبَا","تنفّس في الجوّ منه عَبير",71,"ر",1,0],["وَاِنخَرَطنا بِكَ في سِل","كِ الهَوى أَيَّ اِنخِراطِ",72,"ط",1,0],["وَأَنِخ بِهِ مُتَهَلِّلاً","لِلطارِقينَ مُرَحِّبا",73,"ب",2,0],["وان خيال الشمس فيها أسنة","بها طعنت أعطافها وتحورها",74,"ر",3,0],["وان خلتم سواكم لي خليلا","فأن الحب للخل القديم",75,"م",1,0],["وإن خَرَجتُ بِلَيلٍ نَحوَ مَسجِدِهِم","أضَرَّني بَصَرٌ قَد خانَهُ العَمَشُ",76,"ش",1,0],["وإن خُوّفتِ شراً لا تخافي","لأنَّ بقيّةَ الأبطال فينا",77,"ن",2,0],["وإن خَرجوا يويماً للهوٍ ونزهةٍ","تجرُّ جيادُ الخيلِ أغلى المراكب",78,"ب",1,0],["وان خفت الذنوب فبشراني","بعقبي الدار في دار القرار",79,"ر",1,0],["وان خضت في بحر الذنوب جهالة","فعطفك يا فرد الجَلالة بالصفح",80,"ح",1,0],["وإن خفت من حمل المآثم في غد","فلا تسع في كسب الحمولة والفرش",81,"ش",1,0],["وإن خفت لوما في سؤال امرئ فكم","ملام سؤال في ملامس وال",82,"ل",1,0],["وَأَنّ خَطيب المدحِ فيه عطارد","فَيصدعُ آذانَ الأهلّةِ والقلبا",83,"ب",2,0],["وإن خرجنا لم تقل مثل ما","نقول قدم طرفه قدم",84,"م",1,0],["وَإِنَّ خالي فَهمي أَو حُسَينَ أَخي","وَإِن عَمى فُؤاداً أَو أَبى غالي",85,"ل",2,0],["وَإِن خُيِّرتَ بَينَهُمُ فإلصَق","بِأَهلِ العَقلِ مِنهُمُ وَالحَياءِ",86,"ا",2,0],["وَإِنَّ خَلائِقي حَسُنَت وَطابَت","كِرامٌ لا يُسَبُّ بِهِنَّ نَعشي",87,"ي",1,0],["وَأَنّ خَير فَتىً في قَومِهِ شيماً","أَخي وأنزه أَخلاقاً عَن الرِيَبِ",88,"ب",1,0],["وإن خَلتْ منك عَيني حين تُسهِرها","فليس يُخْليك طُولُ الوجْد من فِكَري",89,"ر",2,0],["وَأَنَّ خُيولَ العَيشِ دُهمٌ وَإِن تُنِر","فَنُذرٌ وَأَمّا شُهبُهُ فَبَشيرُ",90,"ر",1,0],["وإن خضعت تلك الحواس لعقلنا","فتأكل معْه من طعام الملائكِ",91,"ك",1,0],["وَاِنخِزالي اِذا رَأَيتُ وشاتي","كَاِنخِزالِ العُصفورِ عِندَ البازِ",92,"ز",1,0],["وإن خضتم في قصة كان همكم","تطاف محلات الشجار وتنظر",93,"ر",1,0],["وأنخْتَ في حَزْنٍ ركائبَ صُحبَتي","والصّارخُ الملهوفُ خَيرُ صَريخِ",94,"خ",1,0],["وَإِن خبت نارها فاعلم بِأَنَّهموا","بِحَدِّ أَسيافهم يَطفون للهبِ",95,"ب",1,0],["وأنخها قلائصاً قد عراها","ما عرانا من الضنى والنحولِ",96,"ل",1,0],["وإن خَطَرت كانت كما خطر القنا","فما نَظَرتْ إلاَّ بأبيض يُنتضى",97,"ض",2,0],["وَإِن خِفتَ مِن دارٍ هَواناً فَوَلِّها","سِواكَ وَعن دارِ الأَذى فَتَحَوَّلِ",98,"ل",1,0],["وإن خاضَ في بحرِ الثغورِ رأيتَهُ","يُنشِّرُنا أطرافُهُ بالجواهِرِ",99,"ر",1,0],["وإِنْ خَلَعَ اللَّيلُ الأَصائلَ فاخلَعي","إِلَى المَلِكَينِ الأَكْرَمَينِ عِذَارَكِ",100,"ك",1,0],["وإن خالطتها فالسر منها","فسر الحيزبون الدردبيس",101,"س",1,0],["وإن خبت البروق فنورتها","وقد هبت بمطلعها صباها",102,"ا",3,0],["وإِن ختمت فجوِّده لتحفظه","ورابط الدرس في وقتي مسا وضحى",103,"ح",2,0],["وإِن خُلُوَّ البال في كل خلوة","مع الأخوة الأَبرار من حيث ينتح",104,"ح",1,0],["وإن خصصت بفضل وانفردت به","فهم به عن جميع العالم انفردوا",105,"د",3,0],["وإِنْ خلا فكري يوماً وصفا","أردِّدُ السجع لكم مراجعا",106,"ع",2,0],["وإن خان عامَيْها الربيعُ فإنها","بماء يديه الآن في القيظ تُربِعُ",107,"ع",1,0],["وأنَّ خُروقَ المجدِ ليستْ لراقع","سوَاه وصدعَ الجودِ ليس لشاعبِ",108,"ب",1,0],["وإن خيفَ حربُ الجدبِ شيموا فأنهلوا","رماحَ الأماني من صدور المواهب",109,"ب",1,0],["وإن خزنَ الناسُ اللهى أنطق اللّها","بمثعنجرِ الشّؤبوب يأبى له الخزنا",110,"ن",2,0],["وأن خفّتْ تداركها بجيشٍ","وجأشٍ ثابتٍ لا يُستطار",111,"ر",1,0],["وان خطرت في يانع الدوح عانقت","قدود غصون وشحت بعقيق",112,"ق",1,0],["وإن خضن لج الآل مرَّت خفائفاً","فتحسبها سفناً مواخر في بحر",113,"ر",1,0],["وإنْ خلع البيضُ البياضَ فإنَّني","لبستُ به ثوبَ النُّهى وهو معلم",114,"م",1,0],["وإن خطبوا الوقعية بالعوالي","غدت أمَّ الحمامِ بلا نكاح",115,"ح",1,0],["وإن خفنا سطى الحدثان عجناً","من الملك العزيز إلى معاج",116,"ج",1,0],["وإن خان السوى الخضرا فإني","بوزن الأرض ما لا لم أخنها",117,"ن",3,0],["وإن خاضت الأرواح ديباجة القرآ","ن لاح لها سر اقتتاح الكينونيه",118,"ي",2,0],["وان خلق الانسان والحن كلهم","هو المقصد الأقصى سواه وسايل",119,"ل",1,0],["وإنْ خَبَتْ نارُ وجدي بالسُّلوِّ فلا","ورّتْ زنادي ولا أجرى النُهى حِكَمي",120,"م",2,0],["وإنْ خفقَتْ له يوماً بُنودٌ","فأجنحةٌ لدُنيا أو لِدِينِ",121,"ن",1,0],["وإن خفقت راياته خفقت لها","قلوب أعاديه من الخوف والذعر",122,"ر",1,0],["وَإِن خَليلَيكَ السَماحَة وَالنَدى","مُقيمان بِالمَعروف ما دُمت توجد",123,"د",1,0],["وأنختُ بالحرَمِ الشَّريفِ مَطِيَّتي","فَتشرفَت واشتاقَها الأقدامُ",124,"م",1,0],["وَإِنْ خَشَع الأقوامُ يوماً لربّهم","فأين خشوعٌ من خشوع شَمامِ",125,"م",1,0],["وإنّ خُراسانَ زَلْزَلتَها","وما لَكَ من رُكُنٍ زائلِ",126,"ل",1,0],["وَإِن خَصَّ لَم تَعدُ الصَنيعَةُ أَهلَها","وَإِن عَمَّ أَعطى غَيرَ نَزرٍ مُقَلَّلِ",127,"ل",1,0],["وَإِن خَلَت بِحَديثِ النَفسِ فِكرَتُهُ","حَيى الرَجاءُ وَماتَ الخَوفُ مِن وَجَلِ",128,"ل",1,0],["وإن خانك الناس الذين تودهم","وما خنتهم في الود فاصبر على البلوى",129,"و",2,0],["وإن خالطوا الأغيار كانت جنابة","لهم رفعها فرض على القوم قاطع",130,"ع",1,0],["وإن خرقت سفينةْ بحرْ أمرهْ همسْ","أقم جدار الشريعه والصلاة الخمسْ",131,"س",1,0],["وأنخ بتلعات العقيق فإنه","واد هناك عهدته فياحا",132,"ح",2,0],["وانخلع عنك وعربد طرباً","وتهتك في الهوى وافتضح",133,"ح",1,0],["وإن خالطتهم وسلكت معهم","يكون لهم بفعلك ذا رضاء",134,"ا",2,0],["وانْخَلعْ عَنْكَ يا خَليع غَرَامي","لا تَكُنْ غيرُ وجْهنَا لك قبْله",135,"ل",2,0],["وَإِنْ خَرَجْنَا لَمْ تَقُلْ مِثْلَ مَا","نَقُولُ مِنْ تَوَدُّدِ المُكْرِمِ",136,"م",1,0],["وإِن خَرَجْتُ من الدُّنْيَا ولذَّتِها","طوعاً فيا ربْحَ بَخْتيَ بَعْدَ خُسْرانِ",137,"ن",1,0],["وإِن خان الصديق فلا عجيبٌ","أَليس الأَصدقاء بني الزّمان",138,"ن",1,0],["وإِنْ خِفتَ من عاتبٍ فاستترْ","بليل الشَّباب إِذا ما جَنَح",139,"ح",1,0]]}