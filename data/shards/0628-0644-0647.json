Poem.aspx?id=108233",""],[5145,"إني باقسان غريب حريب","https://www.poetsgate.com/ViewPoem.aspx?id=108080",""],[5147,"روح النفس فهي ضيف بمغناك","https://www.poetsgate.com/ViewPoem.aspx?id=166733",""],[592,"يا راكباً جلعداً وجناء عيهلة","https://www.poetsgate.com/ViewPoem.aspx?id=128816",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""],[5425,"فأتِنَةُ الشُرفَةِ","https://www.poetsgate.com/ViewPoem.aspx?id=199027",""],[5431,"ماكيافيلي والحصاد...","https://www.poetsgate.com/ViewPoem.aspx?id=205414",""],[5795,"يرنو بعين الانتقاد أن رأى","https://www.poetsgate.com/ViewPoem.aspx?id=167912",""],[5829,"درة الدهر الشآم","https://www.poetsgate.com/ViewPoem.aspx?id=152342",""],[5956,"الغبي بوش","https://www.poetsgate.com/ViewPoem.aspx?id=192356",""],[5970,"آه لو كانت تفيد النفس آه","https://www.poetsgate.com/ViewPoem.aspx?id=130619",""],[6004,"عروسُ الشَّرق","https://www.poetsgate.com/ViewPoem.aspx?id=71985",""],[6034,"خطب ألم فسار في الآفاق","https://www.poetsgate.com/ViewPoem.aspx?id=169608",""],[6289,"دِمّشْقْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81753&r=&rc=5",""]],"verses":[["بُلهٌ عَنِ المَجدِ غَيرَ أَنَّهُمُ","قَد شَغَلوا بِالمَعايِبِ الفِطَنا",0,"ن",2,0],["بَل هَل تَرى بَرقاً عَلى ال","جَبَلَينِ يُعجِبُني اِنجِيابُه",1,"ب",2,0],["بَلْهَ المُعِدَّ لَهُ مِنْ وُلْدِهِ نُجُباً","إِن سُوبِقُوا سَبَقُوا فِي كُلِّ مَيْدَانِ",2,"ن",1,0],["بَلْ هُمْ قِوَامُ عُلُومِهِ وَفُنُونِهِ","وَلِكُلِّ أَسْبَابِ الحَيَاةِ قِوَامُ",3,"م",1,0],["بِل هِيَ لَّما أَن رَأَت عَاشِقاً","صبَّاً رَمَتهُ اليَومَ فِيمَن رَمَى",4,"م",2,0],["بل هم اليوم عازمون على الزح","ف بجيش به تغصّ البطاح",5,"ح",1,0],["بله أطناب شرحه بقياس","أن في تجرباته أيجازه",6,"ز",2,0],["بل هَوَايَ الذي أُجِنُّ وأُبدي","لِبَنِي هَاشِمٍ فُرُوعِ الأنَامِ",7,"م",1,0],["بل هو الباردُ الزُّلالُ إذا وا","فق من صائم حلول عَشاءِ",8,"ا",2,0],["بل هبه عيباً لا يجوز ألم يكن","من حق خِلِّكَ أن تحوط مغيبَهُ",9,"ب",2,0],["بِلُهاً فتحْنَ لُهَا الرجالِ فَكُلُّهُمْ","ذو منطقٍ سَلِسٍ عليه سَرِيح",10,"ح",1,0],["بل هُوَ مِنْ طيب الثنا مُضَمَّخُ","كأنه بالمسك محضاً يُنضخُ",11,"خ",1,0],["بل هي العيش لا يزال متى استُعْ","رض يملي غرائباً ويُفِيدُ",12,"د",1,0],["بل هو الظالم الذي ظل يرقى","راكباً مركباً من التدليس",13,"س",1,0],["بل هي عن ذاك وثيقاتُ العُقُل","وعن سبيلِ عاندٍ عنك ضُلُل",14,"ل",1,0],["بل هي المستعارُ ذلك منها","للمها والظباء غيرَ انتحالِ",15,"ل",1,0],["بل هو المرءُ يحجمُ العذلُ عنه","لا لخوفِ الخنا بل الإجلالِ",15,"ل",1,0],["بل هندسِيٌّ تُريني الشمسَ هَنْدستي","على الحقيقةِ في شخصٍ له عِظَم",16,"م",1,0],["بل هو البدرُ كلّلته سعودٌ","طالعاتٌ في ليلةٍ إضحيانِ",17,"ن",1,0],["بل هُمْ أحقُّ بأن تقومَ بشكرهم","إذ صرّحوا لك بالعِهار وما كَنَوا",18,"ن",3,0],["بل هو الفنُّ واكتئابهُ والفنَّ","ان جمٌّ أَحزانُهُ وهُمُومُهْ",19,"م",2,0],["بل هو معنى ثائر","قد قيدته الكلم",20,"م",1,0],["بل هو الشيب والكآبة وال","أمراض يمشين بي اليها سراعا",21,"ع",2,0],["بُلهُ الأَكُفِّ وَفي أَفخاذِهِم كَرَمٌ","مَرضى الأُيورِ وَفي اِستِهِم شَبَقُ",22,"ق",1,0],["بُلهٌ إِذا لَبِسوا الحَديدَ حَسِبتَهُم","لَم يَحسِبوا أَنَّ المَنِيَّةَ تُخلَقُ",23,"ق",1,0],["بَلِهٌ نَشَأْتُ مَعَ النَّبَاتِ بِأَرْضِهَا","وَلَثَمْتُ ثَغْرَ غَدِيرِهِ الْمُتَبَسِّمِ",24,"م",1,0],["بَل هَل تَرى ذا الظَعنَ لَو","قامَت رِفاقي لَاِشتَفى",25,"ف",2,0],["بَلهَ المَنايا السودَ قد غُودِرَتْ","وُشْحاً على أقرابِهِ اللُّحْق",26,"ق",1,0],["بَلْ هَلْ تَرَى ظُعُناً كُبَيْشَة وَسْطَهَا","مُتَذَنِّبَاتِ الخَلِّ مِنْ أَوْرَالِ",27,"ل",1,0],["بَلهَ التَّرايِعِ منهُ في مَرابِطِكُم","والصَّافِناتُ إذا جُرِّدنَ أَبشارا",28,"ر",2,0],["بِلَهْذَمٍ لَيْسَتْ لَهُ صَعْدَةٌ","لَكِنَّهُ يَمْضِي إِذَا سُدِّدَا",29,"د",2,0],["بَلْ هُوَ مَا هَيَّأَهُ حَزْمُهُ","وَجَأْشُهُ الرَّابِطُ وَالفِكْرُ",30,"ر",1,0],["بل هل ترى عارضاً قد بت أرمقه","كأنما البرق في حافاته شعل",31,"ل",1,0],["«بل هو الفنُّ واكتئابُه، والفنَّ","جمٌّ أحزانهُ وهمومُهُ",32,"م",2,0],["بلهفة الغرام","امالني هيامي",33,"م",2,1],["بَلهَ الكَرَامَاتِ قَد جَلَّت وأعظَمُهَا","أنَّ المَحَارِمَ صَارَت غَيرَ مُحتَرَمَه",34,"م",2,0],["بِلُهىً يُرَوِّضُ ما أَظَلَّ سَحابُها","وَلَوَ اِنَّها مَرَّت عَلى صَفوانِ",35,"ن",1,0],["بَل هُم بِهِ أَدرى الوَرى أَنَّهُم","لَو جَهِلوا فَضليَ لَم يَحسدوهْ",36,"ه",1,0],["بُلهُ العُيونِ ضخام كُلَّما وَغَلوا","في مَسرَبِ مِن دياميس اللَظى صَغِروا",37,"ر",3,0],["بَلهُ سُبِيٌّ حَوَتها الخَيلُ تَحسَبُها","زُهاءَ شاءٍ مِنَ الأَذرِيِّ مَجلوبِ",38,"ب",1,0],["بَل هَل أَتاها عَلى ما كانَ مِن حَدَثٍ","أَنَّ الحُروبَ اِتَّقَتنا بِالصَناديدِ",39,"د",1,0],["بَل هُو اِسم وَأَنتَ عَين مسمّاه","وَالمُسمّى عَين اِسمه لا محالا",40,"ل",2,0],["بل هو خَدٌّ ناضِرُ وَقّادُه","لمّا التظَى زِينَ بخالٍ أسود",41,"د",1,0],["بلْ هو رَطبٌ كلسانِ الماء","أنعَمُ ساقَىْ بانةٍ غَنّاء",42,"ا",2,0],["بَلْ هَلْ شَجتْكَ الظُّعْن باكِرَةً","كأنَّهنَّ النَّخْلُ مِنْ مَلْهَمْ",43,"م",1,0],["بُلَهنيةٌ ولت كأن لم أكن بها","أُجلي بها وجهَ النعيم مسرَّجا",44,"ج",2,0],["بل هذه نُقلةٌ تدعو جنابك من","فردوس أرضٍ إلى فردوس مولاك",45,"ك",1,0],["بُلَهنِيَةٌ من الدنيا وظلٌّ","وروضٌ أرضُه يصفُ السمِيِّا",46,"ي",2,0],["بلهاء يَرتبِطُ الحلي","مَ من الرجال إسارُها",47,"ر",3,0],["بَل هُم عَلى خَيرِ ما عَهِدتُ وَما","ذَلِكَ إِلا التأميلُ والطَّمَعُ",48,"ع",1,0],["بلهفَتِهِمْ إذْ يَخْشَعونَ تبتُّلاً","إليكَ وللأَغْيارِ ما حَمَلوا هَمَّا",49,"م",2,0],["بِلَهفةِ أرْواحٍ وتَنْزيهِ أنفُسٍ","وصِدْقِ قُلوبٍ ما تَلاهَتْ عن الفِكْرِ",50,"ر",1,0],["بَل هَل تَرى ظُعُناً تُحدى مُقَفِّيَةً","لَها تَوالَ وَحادٍ غَيرُ مَسبوقِ",51,"ق",1,0],["بل هِيَّ أفكارُ الورَى","أتت بِعُجبِ العَجَبِ",52,"ب",1,0],["بل هو حق مطلق ليس له","قيد بوجه لا ولا كيفيه",53,"ي",2,0],["بل هو الله لا سواه وكلٌّ","هالك في وجوده الحق فاني",54,"ن",2,0],["بل هي الشمس بل أجلُّ سناً","كل حسن من حسنها أثر",55,"ر",1,0],["بل ها هنا مضماركم فتسابقوا","يا أهل مصر لاخت مصر الشام",56,"م",1,0],["بل هنأوا بعضاً فكل بعدما","خشىَ اضطراب الامن في مصرٍ امن",57,"ن",1,0],["بَلهاءُ أثمَلَها الصِّبا فكَأنها","أصفَى سًلافاً مِن سُلافِ الكاس",58,"س",1,0],["بَلهاءُ لا وَصلُها بِمتَّصِل","طَيفاً وَلا صَرمُها بِمُنصَرِمِ",59,"م",1,0],["بَلهاءُ إن وَعَدَتكَ أُخلِفَ وَعدُها","طَبعاً وَإن هيَ أوعَدَت لَم تُخلِفِ",60,"ف",1,0],["بل هَلْ يُبَلِّغُني وَخْد المَطِيِّ عَلى","شَحْطِ المزارِ إلى رَبْعٍ بذي سَلَمِ",61,"م",1,0],["بَل هُوَ كَالضَيف الَّذي أَقاما","يَومين في دارٍ وَإِلّا عاما",62,"م",2,0],["بل هم صفاً عن مع","دن الفواحش صاروا",63,"ر",3,0],["بل هو قطر مغدق","لوارد وصادر",64,"ر",1,0],["بلهٌ عن العيش لا سعى ولا عمل","لديهم فكأن القوم أوثان",65,"ن",1,0],["بل هم دون عيوب النا","س والنار حجاب",66,"ب",1,0],["بَلهَ القصور على الغمائم","والمنائر للضباب",67,"ب",1,0],["بَلْ هاجَ لِي شَوْقاً بِنَهْيِ المَحْضَرِ","وَلَسْتُ مِنْ تِلْكَ الغُواةِ الزُجَّرِ",68,"ر",1,0],["بل همج من همج إذا مشوا","يضيقوا على التقي طرقه",69,"ه",1,0],["بل هو من فعل حكيم قادر","وخالق للعالمين فاطر",70,"ر",1,0],["بَل هَل رَأَيت السُيوف مصلتةً","أَشهَرَها في الأَسواقِ شاهرها",71,"ر",3,0],["بل هو الفردوس الاعلى مقاما","عند ما قد تخذاه رموسا",72,"س",2,0],["بل هاجني طرباً من عاد مبتسماً","في قُربه ابتسمت دنيا أمانينا",73,"ن",2,0],["بل هو توكيد لمعنى أو صله","للفظ في آياته المفصّله",74,"ه",1,0],["بل هز أرجاء الثرى","فأثار للفلك الترابا",75,"ب",2,0],["بَل هَل عَرَفتَ لَها الدِيارَ بِناعِقٍ","مَعفُوَّةً لَبِسَ البِلى أَطلالَها",76,"ل",3,0],["بل هو في الأُمَّة مهديُّها","وحبّه صالح أعمالِها",77,"ل",3,0],["بل هو عنوانُ كلّ فضلٍ","وهم جميعاً له شروحُ",78,"ح",1,0],["بل هو العقدُ زانها وكذا العق","دُ يزين الفتاةَ جيداً ونحرا",79,"ر",2,0],["بَل هوَ الباعِثُ المُجِدُّ علَيهِ","ولكَم فيهِ أحسَنَ البُلغاءُ",80,"ا",2,0],["بل هوَ الجوهرُ لكنَّ الممات","حاكمٌ فينا بتغيير الصفات",81,"ت",1,0],["بلهيب من الطلا","وبنارٍ من العنم",82,"م",1,0],["بل هو الجد والعزيمة تدعو","ه لحظ من المعالي عظيم",83,"م",1,0],["بلهيبيها احترقت ولكن","بردا باللما فلقب أشنب",84,"ب",1,0],["بل هو في دائرة الدوائر","مديرها عند أولي البصائر",85,"ر",1,0],["بل هو روح عالم الأرواح","وجاعل الأرواح في الأشباح",85,"ح",1,0],["بل هو أصل الكتب المنزله","فانه نقطة باء البسمله",86,"ه",1,1],["بل هو الفرد في العلوم جميعا","ولكل من علمه استملاء",87,"ا",2,0],["بل هوت سجداً لها فاستقامت","شرط أن تستقيم في أهواها",88,"ا",3,0],["بَل هُو عَينُ السَّعدِ أجمَعُ لم يَفُتْ","مَنْ حَازَهُ ما فَات