{"poems":[[79,"أثار سراها والديار نوازح","https://www.aldiwan.net/poem36644.html","الطويل"],[4,"ألم تلمم على الدمن الخوالي","https://www.aldiwan.net/poem21182.html","الوافر"],[23,"قد تعفى بعدنا عاذب","https://www.aldiwan.net/poem21403.html","المديد"],[53,"أنا غيران ولا زوجة لي","https://www.aldiwan.net/poem65445.html","الرمل"],[47,"خير يوميك في الهوى واقتباله","https://www.aldiwan.net/poem65606.html","الخفيف"],[47,"خَيرُ يَوْمَيكَ في الهوَى وَاقتِبَالِهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32129",""],[23,"قَدْ تَعَفّى بَعْدَنا عاذِبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=12807&r=&rc=11",""],[254,"أحق ما رأيت أم احتلام","https://www.aldiwan.net/poem2096.html","الوافر"],[376,"أما بهواه تيمني هواه","https://www.aldiwan.net/poem56988.html","الخفيف"],[463,"متى وصلت تحية مستهامِ","https://www.aldiwan.net/poem55870.html","الوافر"],[545,"جزى الله إبراهيم عن جل قومه","https://www.aldiwan.net/poem56863.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138288",""],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82282","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79902","الطويل"],[2021,"","https://poetry.dctabudhabi.ae/diwan/poem/139347",""],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67889","الخفيف"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116519","الطويل"],[3145,"","https://poetry.dctabudhabi.ae/diwan/poem/128318","الكامل"],[3553,"","https://poetry.dctabudhabi.ae/diwan/poem/17664","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216821","الرمل"],[3987,"","https://poetry.dctabudhabi.ae/diwan/poem/146888","الخفيف"],[4691,"طفلة اسمها (ليان)","https://www.poetsgate.com/ViewPoem.aspx?id=114274",""],[4778,"التأويل","https://www.poetsgate.com/ViewPoem.aspx?id=208696",""],[5956,"ولدي تراث كأخيه","https://www.poetsgate.com/ViewPoem.aspx?id=199929",""],[549,"سيرةٌ إنسانيَّةٌ للرِّمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87656&r=&rc=8",""],[6308,"انكسارات آخر الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87730&r=&rc=8",""]],"verses":[["كإخْبارِهِ بالغائِباتِ فعنْدَهُ","لأبوابِ أسْرارِ الغُيوبِ مَفاتِحُ",0,"ح",1,0],["كَأَخنَسَ ناشِطٍ جادَت عَلَيهِ","بِبُرقَةِ واحِفٍ إِحدى اللَيالي",1,"ل",2,0],["كَأَخٍ لي لا أُعاتِبُهُ","رُبَّما يُستَكثَرُ العاتِبُ",2,"ب",1,0],["كأخي الثأر الذي قد فاته","طلب الثأر فأضحى ذا أسف",3,"ف",1,0],["كَأَخيكَ اِبنِ صالِحِ اِبنِ عَلِيٍّ","في اِحتِمالِ الجَليلِ وَاِستِقلالِه",4,"ل",2,0],["كأخيك ابنِ صَالِح بْنِ عَليٍّ","في احتِمالِ الجَليلِ، وَاستِقلالِهْ",5,"ل",2,0],["كأخٍ لي لا أعاتبهُ","وبما يستكثرُ العاتبُ",6,"ب",1,0],["كَأَخنَسَ ناشِطٍ باتَت عَلَيهِ","بِحَربَةَ لَيلَةٌ فيها جَهامُ",7,"م",1,0],["كأخلاقِ ابنِ إبراهِيمَ لمَّا","سَقَى زهَراتِ رَوضَتِها نَداهُ",8,"ا",2,0],["كآخر إن شكوتُ إليك منه","شكوتُ من السَّقام إلى السَّقامِ",9,"م",1,0],["كآخر لَم تبرح له النَدى","ممهَّدة يعطي طَريفاً ومتلدا",10,"د",2,0],["كاخي الندى عبدالرحيم وقد همى","إحسانه كالغيث ساعة ينهمر",11,"ر",1,0],["كَإِخوَتي دائِباً أَشقى شَقاءَهُم","في الحَرِّ وَالبَردِ وَالإِدلاجِ وَالبُكَرِ",12,"ر",1,0],["كأخلاقه أزهارها اللآء دُبِّجت","بوطفاء خِلنا من يَديه انبعاثها",13,"ث",3,0],["كآخر ذا نابٍ حديد ومخلبٍ","ولم يتَّخذ عِرساً ولم يحم مَعقلا",14,"ل",2,0],["كأخٍ عهدُهُ وعهديَ في الود","دِ كعهدِ الأنواءِ والأمطارِ",15,"ر",1,0],["كاخباره العليا واخلاقه الرضا","وافعاله احواله وانطوى الامر",16,"ر",1,0],["كأخي الفلاة يغرّهُ من مائها","قطعُ السراب جرى بقاع صفصف",17,"ف",1,0],["كَأَخنَسَ مَوشِيِّ الأَكارِعِ راعَهُ","بِرَوضَةِ مَعروفٍ لَيالٍ صَوارِدُ",18,"د",1,0],["كاختلاف اللون في الصبح لنا","وتساوي بعد قبح ورواء",19,"ا",2,0],["كأخيه الزمان يأخذ ما يع","طي. وما ضل مقتد بأخيه",20,"ي",2,0],["كاخضرار الحياة في البستان ِ","وكصوتِ الخرير في الغدران ِ",21,"ن",1,1],["كأخ الكليم إذا السفينة عابها","عن علمه فتضارب التأويل",22,"ل",1,0],["كأخيه خرَّجَ ناجحِينَ مثيلَه","وجميعهُمْ يتوارثون جميلَهُ..",23,"ل",2,1],["كاختيارِ الأنبياءِ اخْتَارَنا","فقَبِلْنَاهُ وقَبَّلْنَا اختيارَهْ",24,"ر",2,0],["كآخِر الليلِ كالأيْتَام كالمَوْتى","كأيِّ نَجْمٍ بعيدٍ أدمَنَ الصَّمْتَا",25,"ت",2,1]]}