{"poems":[[77,"أثار سراها والديار نوازح","https://www.aldiwan.net/poem36644.html","الطويل"],[4,"ألم تلمم على الدمن الخوالي","https://www.aldiwan.net/poem21182.html","الوافر"],[23,"قد تعفى بعدنا عاذب","https://www.aldiwan.net/poem21403.html","المديد"],[51,"أنا غيران ولا زوجة لي","https://www.aldiwan.net/poem65445.html","الرمل"],[45,"خير يوميك في الهوى واقتباله","https://www.aldiwan.net/poem65606.html","الخفيف"],[45,"خَيرُ يَوْمَيكَ في الهوَى وَاقتِبَالِهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32129",""],[23,"قَدْ تَعَفّى بَعْدَنا عاذِبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=12807&r=&rc=11",""],[247,"أحق ما رأيت أم احتلام","https://www.aldiwan.net/poem2096.html","الوافر"],[369,"أما بهواه تيمني هواه","https://www.aldiwan.net/poem56988.html","الخفيف"],[456,"متى وصلت تحية مستهامِ","https://www.aldiwan.net/poem55870.html","الوافر"],[538,"جزى الله إبراهيم عن جل قومه","https://www.aldiwan.net/poem56863.html","الطويل"]],"verses":[["كإخْبارِهِ بالغائِباتِ فعنْدَهُ","لأبوابِ أسْرارِ الغُيوبِ مَفاتِحُ",0,"ح",1,0],["كَأَخنَسَ ناشِطٍ جادَت عَلَيهِ","بِبُرقَةِ واحِفٍ إِحدى اللَيالي",1,"ل",2,0],["كَأَخٍ لي لا أُعاتِبُهُ","رُبَّما يُستَكثَرُ العاتِبُ",2,"ب",1,0],["كأخي الثأر الذي قد فاته","طلب الثأر فأضحى ذا أسف",3,"ف",1,0],["كَأَخيكَ اِبنِ صالِحِ اِبنِ عَلِيٍّ","في اِحتِمالِ الجَليلِ وَاِستِقلالِه",4,"ل",2,0],["كأخيك ابنِ صَالِح بْنِ عَليٍّ","في احتِمالِ الجَليلِ، وَاستِقلالِهْ",5,"ل",2,0],["كأخٍ لي لا أعاتبهُ","وبما يستكثرُ العاتبُ",6,"ب",1,0],["كَأَخنَسَ ناشِطٍ باتَت عَلَيهِ","بِحَربَةَ لَيلَةٌ فيها جَهامُ",7,"م",1,0],["كأخلاقِ ابنِ إبراهِيمَ لمَّا","سَقَى زهَراتِ رَوضَتِها نَداهُ",8,"ا",2,0],["كآخر إن شكوتُ إليك منه","شكوتُ من السَّقام إلى السَّقامِ",9,"م",1,0],["كآخر لَم تبرح له النَدى","ممهَّدة يعطي طَريفاً ومتلدا",10,"د",2,0]]}