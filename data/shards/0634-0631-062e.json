{"poems":[[47,"شرخ الشباب أخو الصبا وأليفه","https://www.aldiwan.net/poem65161.html","الخفيف"],[46,"بوأت رحلي في المراد المبقل","https://www.aldiwan.net/poem30384.html","الكامل"],[47,"شَرْخُ الشّبابِ أخو الصّبَا، وأليفُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=32840",""],[237,"شرخ الشباب بحبكم أفنيته","https://www.aldiwan.net/poem14824.html","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46510","الرجز"],[1550,"","https://poetry.dctabudhabi.ae/diwan/poem/131379","الرجز"],[1910,"","https://poetry.dctabudhabi.ae/diwan/poem/116547","الكامل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131998","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77098","البسيط"],[4684,"حمحمة الخاء","https://www.poetsgate.com/ViewPoem.aspx?id=201572",""],[5002,"القصيدة الباكية","https://www.poetsgate.com/ViewPoem.aspx?id=204939",""],[5431,"ما كان لله أن ينسى أحبته ....","https://www.poetsgate.com/ViewPoem.aspx?id=200831",""]],"verses":[["شَرخُ الشَبابِ أَخو الصِبا وَأَليفُهُ","وَالشَيبُ تَزجِيَةُ الهَوى وَخُفوقُهُ",0,"ه",1,1],["شَرخٌ مِنَ الشَرَفِ المُنيفِ يَهُزُّهُ","هَزَّ الصَفيحَةِ شَرخُ عُمرٍ مُقبِلِ",1,"ل",1,0],["شَرْخُ الشّبابِ أخو الصّبَا، وأليفُهُ،","والشَّيبُ تَزْجِيَةُ الهَوَى وَخُفُوفُهُ",2,"ف",2,1],["شَرخُ الشَبابِ بِحُبِّكُم أَفنَيتُهُ","وَالعُمرُ مِن كَلفي بِكُم قَضِيَّتُهُ",3,"ت",2,1],["شر خِلال المَرء قَتل الأَسرى","أَول مَقتول يُقال صَبرا",4,"ر",2,0],["شرخ الشباب عنه ما اطّباني","ولا أراني منه خوط بان",5,"ن",1,0],["شرخَ الشبيبة والغنى","وعُمانَ والإلفَ الموافق",6,"ق",1,0],["شرخ الشباب فديت عهدك هل تنا","جي لي المنى فلقد أطالت صدها",7,"د",3,0],["شَرخ الشَبابِ تولى وَالهَوى اِنصَرَمَت","أَيّامُهُ وَفُؤادي لِلهَوى أَما",8,"م",2,0],["شرخت صروف الدَّهر حدَّ نيوبنا","العزم شخْرٌ والزَّئيرُ مواءُ",9,"ا",2,0],["شرخٌ غدا لم تكُ الأفراحُ بلسَمَهُ","قصيدةٌ فيه كانتْ مَنْ تَلفِّعهُ",10,"ع",2,0],["شرخٌ يُقيمُ على أعناقنا مسدا","كأننا الكبش للأعياد منذورُ",11,"ر",1,0]]}