{"poems":[[68,"أفدي غزالا من آل ليث","https://www.aldiwan.net/poem39221.html","مجزوء البسيط"],[33,"هيج القلب مغان وصير","https://www.aldiwan.net/poem42520.html","الرمل"],[119,"صحف الفضاء لما نقول دفاتر","https://www.aldiwan.net/poem40935.html","عموديه"],[762,"","https://poetry.dctabudhabi.ae/diwan/poem/103653","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25326","الرجز"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110345","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3551,"","https://poetry.dctabudhabi.ae/diwan/poem/46154","المواليا"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109977","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127060","السريع"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94582","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73356","الدوبيت"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73373","الدوبيت"],[4717,"هبي كل عشقٍ في سواك قليلا","https://www.poetsgate.com/ViewPoem.aspx?id=199573",""],[4914,"يا شامخا فوق هام المجد موضعه","https://www.poetsgate.com/ViewPoem.aspx?id=170942",""],[5121,"صحبة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=36287",""],[259,"طيف","https://www.poetsgate.com/ViewPoem.aspx?id=180839",""],[5397,"خضعت لعزة ذاتك الدول","https://www.poetsgate.com/ViewPoem.aspx?id=157897",""],[5667,"هند","https://www.poetsgate.com/ViewPoem.aspx?id=214871",""],[6068,"فِي الْحَيِّ أَلْمَى شَادِنٌ -10-","https://www.poetsgate.com/ViewPoem.aspx?id=175790",""]],"verses":[["ذا حاجِبٍ خُطَّ تَحتَ صَلتٍ","مُنَوِّرٍ بِالجَمالِ حالِ",0,"ل",1,0],["ذا حَبيبٌ لَم يَعَرِّج دونَنا","ساقَهُ الحَينُ إِلَينا وَالقَدَر",1,"ر",1,0],["ذا حافظ الاصوات انبأ نابما","هو في غد من ذي الحقائق صادر",2,"ر",1,0],["ذا حسب يعلى وعقل يحري","هبه لأخوالك يوم الفطر",3,"ر",1,0],["ذا حِبَبٍ دِلْهاثَةً لَمْ يَخْصَرِ","أَبْلَخَ يَمْشِي مِشْيَةَ التَبَخْتُرِ",4,"ر",1,0],["ذا حظ لبنانٍ فكل فتىً له","عالي النهى يقصيه ما أقصاكا",5,"ك",2,0],["ذا حالهم مع حال أهل العلم ان","صار الرسول فوراس الايمان",6,"ن",1,0],["ذا حسن فائق أَو جمال فاتِن","حوري جِناني وَالجنان مَعادِن",7,"ن",1,0],["ذا حدُّها وقِياسُها إحراقُها","بشُموعها ووهيجِ كل مقاسِ",8,"س",1,0],["ذا حجة الله وهذا الذي","زان له المنظر والمخبر",9,"ر",1,0],["ذا حبُّ واصه أن مغناطيسهُ","لم يحكهِ في ذا التجاذب جاحدُ",10,"د",1,0],["ذا حثُّكَ والزَّجرُ لها لو تَرَكا","مِنها أَثَراً لأدركتهُ العَينُ",11,"ن",1,0],["ذا حَظُّكَ ما أقلَّهُ قُلتُ لها","لو شئتِ لما كُنتُ قليلَ الحَظُ",12,"ظ",1,0],["ذا حلَّتِ الحسناءُ قلباً ومُكِّنتْ","رأيتَ محبَّْاً في هواه ذليلا",13,"ل",2,0],["ذا حاتم الجود إن تطوى مكارمه","وذا ابن مامة أما كنت تسمعه",14,"ع",2,0],["ذَا (حَامِدِيٌّ) كَمَا الْتِّرْيَاقُ يَسْكُبُهَا","يُشْفِي عَلِيِلاً مِنَ الأَشْجَانِ وَالْكَرْبِ",15,"ب",1,0],["ذا حبيبي في جِنانٍ","وأنا بيتي جحيمُ",16,"م",1,0],["ذا حجة الله التي كبرت","ما عاض عنها بالهدى بدل",17,"ل",1,0],["ذا حُسنُكِ العذبُ يا هندٌ وأعذبُهُ","ذاكَ الرضابُ إذا ما دَرَّ والكَلِمُ",18,"م",1,0],["ذَا حِينَ يَبْصُرُ ضَاحَكًا","يُغْضِي لِوَقْتِ رَمَقْتُهُ",19,"ت",2,0]]}