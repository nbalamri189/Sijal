يل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52130","الطويل"],[4701,"عابر سبيل","https://www.poetsgate.com/ViewPoem.aspx?id=50540",""],[4755,"على وطني إذا لُمِحَ الهُبُوطُ","https://www.poetsgate.com/ViewPoem.aspx?id=184227",""],[4767,"تاج الكمال","https://www.poetsgate.com/ViewPoem.aspx?id=179616",""],[4927,"مؤامرات ومؤتمرات سورية","https://www.poetsgate.com/ViewPoem.aspx?id=79602",""],[4963,"الزين كله وسط نجد العذيه","https://www.poetsgate.com/ViewPoem.aspx?id=36268",""],[5005,"سوسن..","https://www.poetsgate.com/ViewPoem.aspx?id=189350",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5096,"يا لطف يومي","https://www.poetsgate.com/ViewPoem.aspx?id=206821",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5277,"سلامٌ على أرضِ البراق","https://www.poetsgate.com/ViewPoem.aspx?id=194416",""],[5344,"تم إيداع الراتب ..!","https://www.poetsgate.com/ViewPoem.aspx?id=180711",""],[5431,"لروح البريهي...","https://www.poetsgate.com/ViewPoem.aspx?id=210255",""],[470,"بيضُ وجوهُ بني عمي كما الغُررُ","https://www.poetsgate.com/ViewPoem.aspx?id=18590",""],[5582,"أَغِزْلانَ رِيمٍ فِي الهَوادِجِ أَمْ دُمَى","https://www.poetsgate.com/ViewPoem.aspx?id=63578",""],[3469,"نأتك أمامة ُ إلا سُؤالاً","https://www.poetsgate.com/ViewPoem.aspx?id=17626",""],[5648,"انا احترم بالخلا ماطاك","https://www.poetsgate.com/ViewPoem.aspx?id=164274",""],[5686,"دروب الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=203361",""],[5690,"غريبٌ فقده أبكى","https://www.poetsgate.com/ViewPoem.aspx?id=172278",""],[5717,"هذا الكتاب معجز مشاهد","https://www.poetsgate.com/ViewPoem.aspx?id=170606",""],[5722,"أحبابي الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=12692",""],[5739,"زوايا الحبر ..!","https://www.poetsgate.com/ViewPoem.aspx?id=126878",""],[5790,"متى بت إلا في هواك موحدا","https://www.poetsgate.com/ViewPoem.aspx?id=112031",""],[5887,"دعونا اليوم نعلنها صراحة","https://www.poetsgate.com/ViewPoem.aspx?id=28327",""],[5943,"نسيبة إنَّ بقلبي أسى","https://www.poetsgate.com/ViewPoem.aspx?id=34287",""],[6031,"أكفُّ البَرَايَا مِنْ تُرَاثِهِمُ صُفْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=46279",""],[6149,"بأرض الحمى لا زال قلبي عاكف","https://www.poetsgate.com/ViewPoem.aspx?id=169625",""],[5309,"يا علمي رمز المنى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573570",""],[6187,"الدائرة الحمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82160&r=&rc=4",""],[6199,"بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66252&r=&rc=5",""],[6205,"أشواق الخوابي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88156&r=&rc=8",""],[5464,"بغداد والخمسون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=491&r=&rc=5",""],[6288,"مسيرة العمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79611&r=&rc=37",""],[2638,"من بين الدموع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87872&r=&rc=29",""],[572,"ومستهجنٍ مَدْحي لهُ إ،ْ تأكّدَتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9203&r=&rc=60",""]],"verses":[["وَيَأبى الجَوى أَن أُسِرَّ الجَوى","إِذا مُلِئَ القَلبُ فاضَ اللِسانُ",0,"ن",1,0],["وَيا بانَةَ الوادي أَدَمعِيَ في الهَوى","أَبَرُّ حَياً أَم ما سَقاكِ مِنَ الوَبلِ",1,"ل",1,0],["وَيَأبى الفَتى وَالسَيفُ يَحطِمُ أَنفَهُ","وَفي الناسِ مَصبورٌ عَلى السَيفِ صابِرُ",2,"ر",1,0],["وَيا بُؤسَ لِلقُربِ الَّذي لا نَذوقُهُ","سِوى ساعَةٍ ثُمَّ البِعادُ مَدى الدَهرِ",3,"ر",1,0],["وَيأبى أُوامى أَن يَبُلَّ غَليلَهُ","سِوى مَلِكٍ فاقَ البَريَّةَ سؤدَدا",4,"د",2,0],["وَيا بَرقُ بَلِّغها الغَداةَ تَحِيَّتي","وَحَيِّ دِياري في الحِمى وَمَضاجِعي",5,"ع",2,0],["وَيَا بَشِيراً بِنُعْمَى جَلَّ مَوْقِعُها","لَكَ الْبِشَارَةُ مِمَّا شِئْتَ فَاحْتَكِمِ",6,"م",1,0],["ويا بِدَرَ المالِ الصّموتِ تبرّجي","وشأنُكِ فابْيَضّي إذا شِئْتِ واصْفَرّي",7,"ر",2,0],["ويأبَى لكَ المجْدُ الذي أنْتَ أهْلُهُ","على الدّهْرِ إلا أنْ تُتَمِّمَ ما بُدِي",8,"د",2,0],["وَيا بَني الشَوقِ وَأَهلَ الأَسى","وَمَن قَضَوا في هَذِهِ الأَربُعِ",9,"ع",1,0],["وَيَا بَحْراً هُنَاكَ أعِرْ ثَنَائِي","نَفيسَ الدُّرِّ يُنْظَمُ فِي الْكَلامِ",10,"م",1,0],["وَيَأبى غُواةُ الناسِ إِلّا تَوافُداً","عَلَيَّ وَيَأبى أَن يَرِقَّ لَهُم عَظمي",11,"م",2,0],["ويأبى جلوسي من مراتبه إلى","كبير أناسٍ في بجادٍ مزمَّل",12,"ل",1,0],["ويابسةُ الأسافلِ والأعالي","كأنكِ في المجالس عَنكبوتُ",13,"ت",1,0],["ويا بؤس لِلأخْت الشقية بعده","من الحَزَنِ الباقي وطول استعاره",14,"ر",2,0],["ويا بؤس للطفل الصغير وشادنٍ","تعجَّلَ بؤس اليُتْم قبل اتِّغاره",14,"ر",2,0],["وَيا بِنتَ كولَمبَ كَم تَضحَكينَ","كَأَنَّكِ أَبصَرتِ مُستَغرَبا",15,"ب",2,0],["ويابن السابق المزرى أرتجالا","بروّاض القصائد وابتداعا",16,"ع",2,0],["ويا بني مصر أهرعوا وأضرعوا","بحفظ مولى مصر والموئل",17,"ل",1,0],["وَيا بَياضَ العَيشِ في ال","أَيّامِ ذاتِ الحَلَكِ",18,"ك",1,0],["وَيا بَحرُ تَدري قَدرَ مَن أَنتَ حامِلٌ","وَيا أَرضُ صونيهِ وَيا رَبّي اِرحَمِ",19,"م",1,0],["ويا بَرَدَاً ما ذُقْتُه غيرَ أنَّهُ","على ما أرى عَذْبُ المذَاقِ بَرودُ",20,"د",1,0],["وَيا بُؤسَ الضَجيعِ وَقَد تَطَلّى","بِخِلطَي جامِدٍ مَعَهُ وَجارِ",21,"ر",1,0],["ويَأبى زَهرُها إلاّ هُجوعاً","ويأبَى عَرفُها إلا انتباها",22,"ا",3,0],["ويأبَى الوَفاء عَليه اندمالا","ويأبَى التَّذَكُّر أن يشفقا",23,"ق",2,0],["وَيا بِأَبي مَن لَم يَزَلْ مِن حُلِيِّها","لَدى الغيدِ غَرثانانِ قَلبٌ وَخلخالُ",24,"ل",1,0],["ويا بنَ البارزيِّ إذا برزنا","بثوبِ الحزنِ فيك فلا نُلامُ",25,"م",1,0],["ويا بديعَ المعاني والبيان خذي","غيري فقدْ أخذَتْني حرفةُ الأدبِ",26,"ب",1,0],["ويابنَ التي لم يَضَعْ مِثْلُها","كمِثْلِكِ حَمْلاً ولم تُرْضِعِ",27,"ع",1,0],["ويابنَ البَطِينِ بلا بِطْنَةٍ","ويابنَ الفتى الحاسرِ الأنْزَعِ",27,"ع",1,0],["ويا بساطاً منَ الخضراءِ طرَّزهُ","صوبُ الغمام أفانيناً أفانينا",28,"ن",2,0],["ويأبى العدلَ أَكثرُهم جُنوداً","فلا عَتْباً يَخافُ ولا مَلاما",29,"م",2,0],["ويَأبَى لك الذَمَّ طِيبُ النِّجارِ","وطِيبُ الخِلالِ وطِيبُ الشِّيَم",30,"م",1,0],["ويَأبَى لكُم من أن يُطَلّ نَجِيعُها","فُتُوٌّ غِضابٌ مِنْ كمِيٍّ ومُعْلِم",31,"م",1,0],["وَيا بَطبَطَ صينِيٍّ","وَيا سَوسَنَ بُستانِ",32,"ن",1,0],["وَيا بِلاداً مَشى عَليها","أُولوا اِفتِقارٍ وَأَغنِياءُ",33,"ي",3,0],["وَيا بَنانِيَ لا تُبسَط لِعارِفَةٍ","وَيا لِساني بِغَيرِ الصِدقِ لا تَجُل",34,"ل",1,0],["وَيا بروق امسكي","وَيا غيوم أقشَعي",35,"ع",2,0],["وَيأبى لسان الطَبيعة أَن","يَبوح بِما نحن نَستَعلِم",36,"م",1,0],["ويأبَى ذُبابٌ أنْ يَطُورَ ذُبابَهُ","ولو ذابَ مِن أرْجائِهِ عَمَلُ الرُّصْع",37,"ع",1,0],["وَيا بَرقُ إِن عَرَّضتَ مِن جانِبِ الحِمى","فَحَيِّ بَني عَبسٍ عَلى العَلَمِ السَعدي",38,"د",2,0],["وَيَأْبَى لِيَ السُّلْوَانَ مَا طُفتُ بِالحِمَى","مَوَائِلُ مِنْ آثَارِهِمْ وَمَعاهِدُ",39,"د",1,0],["ويا بحارُ اجْعَلي الماءَ الأُجَاجَ دَماً","إذا عَلَتْ رَايةٌ يَوْماً لصهيونَا",40,"ن",2,0],["ويأبى حكمها للهن","د حكم الحر للعبد",41,"د",1,0],["ويا بني عمنا ذبيان مجدكم","أنا وإياكم في المجد صنوان",42,"ن",1,0],["ويا بني غافر عليا قريش لكم","أصل وانتم لذاك الأصل أغصان",42,"ن",1,0],["ويا بني ملة الاسلام تعزية","مني اليكم وقلبي بالأسى اضطرما",43,"م",2,0],["ويا بني الجبت والطاغوت حسبكم","من رمية الله في الدنيا وفي سقر",44,"ر",1,0],["ويا بشير بنعمى جل موقعها","لك البشارة مما شئت فاحتكم",45,"م",1,0],["ويأبى التنازعُ طولَ البقاء","وتأباهُ بُقْيا نفوسٍ أُخر",46,"ر",1,0],["ويا بدر من سامرته وجدك انقضى","فمن لك بعد اليوم خل تسامره؟",47,"ر",2,0],["وَيَا بُؤس الضجيع قَدْ تَطَلّى","بِخِلْطَي جامِدٍ مَعْهُ، وَجارِ",48,"ر",1,0],["ويأبى احتمال الضيم من لا يطيقه","فينكب أو ينفى من الأرض صاحبه",49,"ب",2,0],["ويا بعدي وريم الروض جاري","ويا شوقي ومحبوبي قريب",50,"ب",1,0],["ويا بارئ برء من العيب مسلكي","مصور فاحفظني وغفار زل وزري",51,"ر",2,0],["ويا باسط ابسط عناية","ويا خافض اخفض قدر من قصده ضري",51,"ر",2,0],["ويا بر يا تواب اقبل لتوبتي","ومنتقم ممن تعامل بالمكر",51,"ر",1,0],["ويأبى هواني واتضاعيَ بعدما","مضى ما مضى في العز معْ رفعة القدرِ",52,"ر",1,0],["ويا بَردَها عند الفؤادِ بأن تَرى","على قارعات الطُّرْق كفيّك باسِطا",53,"ط",2,0],["ويأبَى على سرَف الطالبي","نَ ألاّ يُصدِّق فيه الظنونا",54,"ن",2,0],["وَيَأبى الغِناءَ وَلَكِنَّهُ","لِوَقعِ السُيوفِ كَثيرُ الطَرَب",55,"ب",1,0],["ويا بقية من أفنت صوارمه","لو شئتم ما خلت منكم دياركم",56,"م",1,0],["ويا برقا تالق من زرود","لقد أطلقت دمعي كالفرات",57,"ت",1,0],["وَيَأبى لَهُ البَيتُ الرَفيعُ عِمادُهُ","رُجوعي بِحالٍ نَشرُها لَيسَ يَجملُ",58,"ل",1,0],["وَيا باسِطاً كَفّاً لِإِدراكِ شَأوِهِ","بِكَفِّكَ فَاِضمُمها إِلَيكَ جُذامُ",59,"م",1,0],["وَيأَبى لِيَ الكُفرانَ أَنّي اِبنُ حُرَّةٍ","كَريمٌ مَتى صَرَّفتُ عَزمي تَصَرَّفا",60,"ف",2,0],["ويابانَة الوادِى هَل أنتِ مُثِيبَةٌ","فُؤَادَ فَتىً أَعلَقتِهِ فى حِبَالِكِ",61,"ك",1,0],["ويا بانَةَ الوادِى أَلَيسَ بَلِيَّةً","مِنَ الأَمرِ أَن يُحمَى عَلَىّ ظِلالُكِ",61,"ك",1,0],["ويابانَةَ الوادى أَثِيبى مُتَيَّماً","أَخا سَقَمٍ لَبَّستِهِ في حِبَالِكِ",62,"ك",1,0],["ويا بانتي ميلي ويا زهرتي انفتحي","ويا نسمةَ الأسحارِ في روضنا هبي",63,"ب",2,0],["ويا بدرُ خذ عيني فذاكَ سريرُها","وتلكَ وإن لمْ أدعُها باسمِها هيا",64,"ي",2,0],["ويا بدرُ كيفَ صعدتَ الفؤاد","وكنتَ بآفاقهِ تطلعُ",65,"ع",1,0],["ويا بحر جود فاض فضلا ونائلا","مصادره محمودة والموارد",66,"د",1,0],["ويا بمن اذا ما السحب بالغيث اقلعت","فسيب نداه بالحيا متتابع",67,"ع",1,0],["ويا برّا بنا أضحى وبحرا","فدتك النفس من بر وبحر",68,"ر",1,0],["ويا بحر النوال ودوح فضل","عطاياه الجواهر والثما ر",69,"ر",1,0],["ويا بدر أهلوك ما خطبهم","فما أعين منهمو باكيه",70,"ي",2,0],["وَيا بَصري حِد مَرَّةً عَن طَريقِها","كَأَنَّكَ مَمدودٌ بِخيطٍ مِن القَلَق",71,"ق",1,0],["ويا بن الملوك الشُمِّ من آل هاشمٍ","ومن طاب منهم ظاهر وضمير",72,"ر",1,0],["ويَا بنَ المشَاعر والمَرْوَتْينِ","ويا بن الحَطِيم ويا بنَ الصَّفَا",73,"ا",1,0],["ويا بشراً من بشره لعفاته","سؤال فما بشر المعنى وهنده",74,"د",2,0],["ويأبى بما يختاره الدهر طائعا","ففي راحتيك الحل للأمر والعقد",75,"د",1,0],["ويا بحر فضل يخجل البحر ما رأى","عجائبه والبحر يحوي العجائبا",76,"ب",2,0],["ويا بشراً بدا ملكاً كريماً","هبوطُ الوحي منهُ على النبي",77,"ي",1,0],["ويَا بِأبِي تلْكَ الجُسوم نَواحِلاً","بإِجْرائِها نَحْوَ الأجُورِ الجَسائِمِ",78,"م",1,0],["وَيا بِأبي المُخْتَارُ من سرِّ هاشِم","ومَنصِبُه المُختارُ من صَفوَةِ العُرْب",79,"ب",1,0],["وَيا باكِيَ الْعلْياءِ دُونَكَ عَبْرَةً","مَلِيّاً بِإِسْعادِ الْخَلِيلِ هُمُولها",80,"ل",3,0],["وَيَأْبى اللهُ إِنْ أَبَتِ الأَعادي","لِنَاصِرِ دينِهِ إِلاَّ انْتِصارا",81,"ر",2,0],["ويا بلادي سنجلوا كل غاشيَةٍ","وسوف يبعثُ حيا عهدُك النَضِر",82,"ر",1,0],["وَيا بَليغاً حوَت بلاغتهُ","دُرَّ المَعاني وجَوهر الأَدبِ",83,"ب",1,0],["وَيأبى لي الغنى كَسْباً حلالاً","وَيأْخذُ بالحرام أو الحلال",84,"ل",1,0],["وَيا بارياً أنفاسَنا وَنفوسنا","تَعاليتَ نفِّس كَربنا فَلقد عمّا",85,"م",2,0],["وَيا بَدر لا غبت عَن مُهجة","بِحُكم الوَفاءِ غَدَت مَنزلك",86,"ك",1,0],["وَيا بَشير التَهاني إِن حَجَجتَ إِلى ال","بيت المحرّم إيفاءاً لِما فَرَضا",87,"ض",2,0],["وَيا بَهجة الأَيّام لا زلت سالِماً","لِتسعد أَعوامٌ لَنا وَشُهورُ",88,"ر",1,0],["وَيا بُلبل الأَغصان هجت بَلابِلي","أَعندك مِن حرّ الجَوى بَعض ما عِندي",89,"د",2,0],["ويَأْبَى جديدُ الدهرِ أن يُعدمَ البِلى","عليه وحاشا وُدَّكنَّ جديد",90,"د",1,0],["وَيا بَحرُ كَم هَذي القَعاقِعُ كُلُّها","فَما دَرُّكَ البادي وَلا ماؤُكَ العَذبُ",91,"ب",1,0],["ويا باعِثَ السُّقم حَسبي فقَد","شُكرتَ على بِرِّكَ الواصِلِ",92,"ل",1,0],["ويا بُعد ما رمتُ من عَطْفِهِ","مَتَى حالَ عن حالِه وانتقَلْ",93,"ل",1,0],["ويا بدراً منازله قلوب","لها من خوف جفوته ضرام",94,"م",1,0],["ويأباه مولانا الإِمام الذي علا","على هامة العلياء أفخر مقعد",95,"د",1,0],["ويأباه من أبناء أحمد عصبة","هُمُ زبدة الأشراف في كل مشهد",95,"د",1,0],["ويأباه من كان الوصيُّ نجاره","وكل تقيٍّ صالح متهجد",95,"د",1,0],["ويأباه من كانت بصنعاء داره","هم جيرتي من سيد ومسود",95,"د",1,0],["ويا برق خذ من نار وَجْدِي جَذْوَةً","وَزُرْ أرض من تَهْوَى لعلك تسعد",96,"د",1,0],["ويأبى ذاكَ لي قَدَرٌ متاح","ونحنُ بقبضةِ القدر المتاحِ",97,"ح",1,0],["ويا بأبي دمية حلّلت","دمي فاغتدى للنوى منسكب",98,"ب",1,0],["ويا بئس من لم يكن ذا نهى","ولم يمحض اللَه إيمانه",99,"ن",2,0],["ويأبى اللَه أن ننساه لما","عن الأبصار واراه الرجام",100,"م",1,0],["ويأبى الحق دعواهم","وجل الحق ان يخفى",101,"ا",1,0],["ويأبى لحسناءَ إن أقبلت","تعرُّضَها قمراً مقبلا",102,"ل",2,0],["ويا بردَ صدري لو حُرِمتُ بعفّتي","ويسريَ لو أني بفضليَ أُرزقُ",103,"ق",1,0],["ويأبى اللّهُ إلا مَزْيَدِيّا","على أسَدٍ يؤمَّرُ أو يسودُ",104,"د",1,0],["ويأبى فيأتي مَشرَعَ الدمِ وارداً","حريصاً ويأتي