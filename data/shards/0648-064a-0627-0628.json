0],["ويا باري الورى طرا أنلني","مقامات الرضى وأقم مناري",129,"ر",2,0],["ويا بشر محزون ويا أنس موحش","ويا غيث محتاج ويا غوث هالع",130,"ع",1,0],["ويا بأنه رام القضيب انشاءها","بلا حسد للغصن قدك أقوم",131,"م",1,0],["ويا بنيَّ الطهر إن غابت جسومكم","عن رأي عيني فما تنأون بالرحل",132,"ل",1,0],["وَيا بنَ الشَريعَةِ وَاِبنَ الكِتا","بِ وَاِبنَ الرِوايَةِ وَاِبنَ الأَثَر",133,"ر",1,0],["وَيا بنَ المَشاعِرِ وَاِبنَ المَقام","وَزَمزَم وَالرُكنِ وَاِبنَ الحَجَر",133,"ر",1,0],["ويابس الجذع حين مربه","حن منيبا إلى جلالته",134,"ت",2,0],["ويا بدر قد طال السهادُ وساءني","ويا غصن قد أبكى زهور الربى صدحي",135,"ح",2,0],["ويابن العالم العلم الملبي","إذا استدعى الأنام إلى الثواب",136,"ب",1,0],["ويا بأبي ذات الوشاح إذا بدت","كشمس الضحى وجهاً وجنحِ الدجى شَعْرا",137,"ر",2,0],["ويأبى لها النهدان والردف أن ترى","تمس له الأثواب بطناً ولا ظهرا",137,"ر",2,0],["ويَا بُغيَةَ المُرتَادِ ويَا نهية المُنَى","ويا مَنجِعَ الرُّوَادِ يا مُطعِمَ السَّفرِ",138,"ر",1,0],["ويا برق نجدٍ هات عن أيمن الحمى","حديثاً ففي بثِّ الغرام سرورُ",139,"ر",1,0],["ويا بؤسَ منصورٍ وفي يومِ سرخسٍ","تمزَّقَ عنهُ مُلْكُهُ وهْوَ طامِحُ",140,"ح",1,0],["ويا باعث ابعث راية الحق حولها","جنودك تبلو في رضاك وتبتلى",141,"ل",2,0],["ويا باطن الذات الحميد ثناؤه","امط حجب مجهولات عقلي وزيلا",142,"ل",2,0],["ويا باريء ابرء نور قلبي وزكه","يكن لفيوض السر منك مؤهلا",142,"ل",2,0],["ويا بر أهل البر يا محسناً على","خليقته منا بكل مبرة",143,"ه",1,1],["ويا باطن الذات اختفيت بلا اختفا","بطوناً عن الأفثكار والنظرية",144,"ه",1,1],["ويا بارىء الموجود موجده بلا","مقال خلا من غيره للبرية",145,"ه",1,1],["ويا بر خولني ببرك نعمة","فاغدو بنعماء المليك مخولا",146,"ل",2,0],["ويا باسط أبسط لي من المال بسطة","وهبني انبساطاً في الشهود مكملا",146,"ل",2,0],["ويا باعث الأجسام عوداً كبدئها","وقد فنيت في عالم زخية",147,"ه",1,1],["ويا باعث الرسل الهداة بدينه","لينفذ حكم العدل من بعد حجة",147,"ه",1,0],["ويا باعث الأفعال كسباً من الورى","بخلق الدواعي فيهم والارادة",147,"ه",1,0],["ويا باعثاً في الذنب بالتوب عبده","وباعثه في عجزه بالمعونة",147,"ه",1,0],["ويا باعث الأرواح بالعلم والهدى","ببعثك سارت في هداها وحلت",147,"ت",1,0],["ويا باسط الأرزاق بسطاً مقدراً","ببسطك ربي كل خير وبسطة",148,"ه",1,1],["ويا باسط الحب الثقال كما يشا","ليبسط منها رزقه كل نسمة",148,"ه",1,0],["ويا باسط الأنوار والظل باسطاً","بقدرته العظمى بساط البسيطة",148,"ه",1,0],["ويا بساطاً للروح في الجسم باسط ال","قلوب بروح الأنس بالواحدية",148,"ه",1,0],["ويا باسط المبقى بكشف جماله","ويا باسطاً للعفو عن ذي الجريرة",148,"ه",1,0],["ويأبَى لَها أن يُعْلفَ الضّيْمَ ربُّها","غِضابُ الموالي يَدَّعُونَ إلى النَّصْرِ",149,"ر",1,0],["ويابا المعالي عشْ وأقبلَ بالمنى","إليك أبا عبد الإله بشيرُها",150,"ر",3,0],["ويا بدرَ تِمٍّ في ذرى غصن بانةٍ","تثنّى على دعص النّقا وهو مورقُ",151,"ق",1,0],["ويابا المعالي حبتك الليالي","بنفع الموالي وكبْت الأعادي",152,"د",2,0],["وَيَا بِأَبِي مِنْ آلِ كَعْبٍ كَوَاعِبٌ","مَتَى شِئْنَ إِحْدَاثاً لِوَجْدِيَ يَحْدُثِ",153,"ث",1,0],["وَيَا بِأَبِي حَسْنَاءَ مِنْ غُنْجِ طَرْفِهَا","هُوَ الدَّاءُ لَكِنْ مِنْ مَرَاشِفِهَا الدَّوَا",154,"و",2,0],["وَيَا بِأَبِي مِنْهُنَّ حَسْنَاءُ لَحْظُهَا","لَهُ جَانِبٌ يُخْشَى وَلِلسَّيْفِ جَانِبُ",155,"ب",1,0],["وَيَا بَحْرَهَا رِفْقاً بِبَحْرٍ حَمَلْتَهُ","وَلَكِنَّهُ يَا بَحْرُ يَعْذُبُ مَوْرِدَا",156,"د",2,0],["ويا بروحي من حالت لبينهم","حالي فيا ليت معهم كان ترحالي",157,"ل",2,0],["ويا بحر علم طاب وردا وكم لنا","على حوضه يوم الزحام تجسر",158,"ر",1,0],["ويا بروحي من باتوا فبان بهم","صبري وبان سقامي وانقضى رمقي",159,"ق",2,0],["ويا بروحي حتى العيس ما برحت","شوقا لمحبوبها تبكي وتنتحب",160,"ب",1,0],["ويا بن الأُلى ورثوا كابراً","خميدَ المآثر عن كابرِ",161,"ر",1,0],["ويا بنتَ أُمي أَميطي اللثام","فأنتِ من الصَّون في بُرقُع",162,"ع",1,0],["ويأبى عليّ السرَّ جسمٌ كما ترى","وهل أنتَ راءٍ غيرَ جسمٍ تَهدّما",163,"م",2,0],["ويأبى بهِ الاَّ التغزُّلَ عفةً","فان رحتُ اشكو لم الاقِ سوى الشكر",164,"ر",1,0],["وَيَا بَارِيَّ النَّعْمَاءِ زِد فَيْضَ نِعْمَةٍ","أَفَضْتَ عَلَيْنَا يَا مُصَوِّرُ أَوَّلاَ",165,"ل",2,0],["وَيَا بَرُّ يَا رَبُّ الْبَرَايَا وَمُوهِبَ الْ","عَطَايَا وَيَا تَوَّابُ تُبْ وَتَقَبَّلاَ",165,"ل",2,0],["ويأبى معز الشيء إلا ارتجاعه","فيا أدعياء السرو ردوا العواريا",166,"ي",2,0],["ويأْبَوْنَ إلا لَيْتَه وَلَعَلَّهُ","ومنْ أينَ للمقصوصِ بالطيران",167,"ن",1,0],["ويا با الحسينِ ويا ابنَ الربيع","وناهيكَ أسبابَ مجدٍ مِتَانا",168,"ن",2,0],["ويا بدر ما بدر السماء بمرتق","اليك ولو ان الكواكب سلم",169,"م",1,0],["ويا بدرا ويا بحرا خضما","ويا غيثا مغيثا للعباد",170,"د",1,0],["وَيا بَثَّ حُزني لِدَرس لَهُ","يميط سَناه كَثيف الحجب",171,"ب",1,0],["ويا براً غدا في الجود بحراً","رعاك اللَه من بَرٍّ وبحر",172,"ر",1,0],["ويا بطريرك الشرق تهنيك رحلةٌ","وعودٌ به البشرى على الشرق تمتد",173,"د",1,0],["وَيَابارِقاتٍ من رُباهُ ألا أومضِي","وَيَا نَسَماتٍ مِن حِمَاهُ ألا هُبّي",174,"ب",2,0],["ويا برد حر الشوق منك بوقفة","بملتزم تنهي وتشرح ما بكا",175,"ك",2,0],["وَيَأبي الذَمَّ لي أَنّي كَريمٌ","وَأَنَّ مَحَلّي القَبَلُ اليَفاعُ",176,"ع",1,0],["ويا بأبي عقائل من عقيل","نوافر تقنص اللُّب الأبيّا",177,"ي",2,0],["ويأبى جنابُ الحقِّ إلا اتساعه","لتشهدَه الأبصار في كلِّ معتقد",178,"د",1,0],["ويابس العود لو زالت قساوته","بشربه الماء لا يرجى له ثمر",179,"ر",1,0],["وَيا بَرقَ الغُوَيرِ دَنَوتَ حَتَّى","يَغارُ عَليَّ مِنكَ شَبا قَضيبي",180,"ب",2,0],["ويا بأهلي عُرباً ما ذكرتهمو","إلاّ وعدتُ من التِذكار نشوانا",181,"ن",2,0],["ويأبى رفعتي ويسُوم خفضي","ويأبى المجدُ لي غير احترامي",182,"م",2,0],["ويا بنفسي من ظباهم طفلة","ما أنكرت ناشئة أطواقها",183,"ق",3,0],["ويا بؤس هذا الدهر من ذي تلون","وذي فجعات ما أفظ وأفظعا",184,"ع",2,0],["وَيابن الكماة الصيد مِن آل هاشم","سَنام العلى مِمَن أَغار وَأَنجَدا",185,"د",2,0],["ويا بابَ النبيِّ اليك أُزجِى","مُناى فهل فتحتَ لهن بابا",186,"ب",2,0],["وَيَأبى جَمعُكُم إِلّا فِراراً","وَيَأبى جَمعُنا إِلّا وُرودا",187,"د",2,0],["وَيا بدرُ كُم قَد شبَّهوكَ بوجهها","لَقَد غَلِطوا ما مشرقٌ مثلَ خاسِفِ",188,"ف",1,0],["ويا بأبي افدي وامي وأسرتي","غزالاً رعى بالرمل ضالاً وزنبقا",189,"ق",2,0],["ويا بدر السماء حجبت عني","بنورك نور أطفال النجوم",190,"م",1,0],["ويا بحر أنت الحس أهوى به الفنا","فأغرق في لجّيكما أنا والفكر",191,"ر",1,0],["وَيا بضعة الأَطهار مِن آل هاشم","لَقَد فقت أَهلاً في العِباد وَآلا",192,"ل",2,0],["وَيا بَيت النُبوة وَهوَ بَيت","تدين لَهُ السَموات العِظام",193,"م",1,0],["ويا بني التيمِ مَهلاً","ماذا جَرى من فؤادِ",194,"د",1,0],["ويا بني النيل هبّوا","لِنَصرهِ في الجهادِ",194,"د",1,0],["ويا بني مصر إنّ الدهر أنصَفَكم","وَقَد بَلغتم منَ المأمول أقصاهُ",195,"ا",2,0],["ويأبى مَنطقي إلّا اِعتدالاً","كما عوّدتني الزمنَ الطويلا",196,"ل",2,0],["وَيَأبى لِيَ الضَيمَ ما قَد مَضى","وَعِندَ الخِصامِ فَنَعلو جِدالا",197,"ل",2,0],["وَيأبى أَن تَكون لَه بِلاد","يَعيش الحرّ فيها وَهوَ عبدُ",198,"د",1,0],["ويا بدْرَ تمٍّ ضمّهُ التُرْبُ مَغْرباً","وكانَ له أفْقُ المكارِمِ مطْلِعا",199,"ع",2,0],["ويا بأبي أفدي الأماثل صحبه","غداة تفانوا دون خدر الفواطم",200,"م",1,0],["ويا بدر أفق الدين من فيه تنجلى","غواشي الدجى كيف اعتراه أفول",201,"ل",1,0],["ويا باب الرضا المرضي صنيعاً","رجائي فيك تحسن لي صنيعا",202,"ع",2,0],["ويا باب المراد أنل بعز","عبيدك ما تمناه سريعا",202,"ع",2,0],["ويا باب الهدى الهادي اهدني في","جميع مطالبي النهج الوسيعا",202,"ع",2,0],["ويا بعثةٌ عم الخلائق خيرها","ودام فلا يلفي له الدهرُ آخرُ",203,"ر",1,0],["ويا بلى لا تغير حسن طلعته","وإن مضت سنوات وهو في الترب",204,"ب",1,0],["ويا بيت شعري ان اردت قصيدةً","وزبدة قولي ان عدلت الى النثرِ",205,"ر",1,0],["ويأبين درك الحق حتى تخاله","من الأسد في أظفارها والمخالب",206,"ب",1,0],["وَيا بُعداً لمن يُفني الليالي","عَلى جهدٍ بحبِّ الهاجدينا",207,"ن",2,0],["وَيا بَدرَ ذاكَ الأُفقِ كَيفَ جَبينُه","وَيا وَمضَ هَذا البَرقِ هَل من تَبَسُّم",208,"م",1,0],["وَيا بخل عَيني بِالمَدامع إِذ رَأَت","مَعاهدنا تخلو وَلم تَك تَمتلي",209,"ل",2,0],["ويا بريء الوجه في ناظري","ويا أثيماً في الفؤاد الكليم",210,"م",1,0],["ويا بؤس الفناء نحسْ","سُه في كل ميقات",211,"ت",1,0],["ويا باخلين وإن تبخلوا","فأهوِنْ بمن شاء أن يبذلا",212,"ل",2,0],["ويا بؤس فانٍ يري ما بدا","من الكون بالنظرة الخالدة",213,"د",2,0],["ويا بطن نعمان تراك علمت من","بك اجتاز بين البان والسمرات",214,"ت",1,0],["ويا بنى مصر زوروهم ولا تثقوا","بمارقين من الإسلام ضلال",215,"ل",1,0],["ويا بديع يا حسيبُ ليَ غِثْ","بما أريدُ يا عفوُّ يا مغيثْ",216,"ث",1,0],["ويا بصير حكمٌ يا عدلُ يا","لطيفٌ يا خبير لي تولّيا",217,"ي",2,0],["ويا بحر علم الهاشمي محمد","تفجر علينا من قلوب ومسند",218,"د",1,0],["ويا بارىءٌ سقمي فعجّل شفاءه","لترفع لي ذكري وتشرح لي صدري",219,"ر",2,0],["ويا باسط فابسط علينا بنعمة","تعمُّ لنا بالعافيات وبالخير",219,"ر",1,0],["ويا باطنٌ في الناس أسرِ محبَّتي","وأعلِ بتبجيلي لديهم على جهر",219,"ر",1,0],["ويا برُّ فاغمرني ببرّك واكفني","حوادث دهري بالحَسِينِ من البرِّ",219,"ر",1,0],["ويا بصير عافينّ بصري","وبرّ بي يا برُّ كل عمري",220,"ي",1,0],["ويا بائناً بأن العزاء ببينه","فأصبحتُ مسلوبَ العزيمة والقلبِ",221,"ب",1,0],["ويابنه أحلى الطير طوقا وبزةً","وآلفها للمغرس المتفاوح",222,"ح",1,0],["ويا بؤسَ للأيّام والدهر هالكا","وصرف الليالي يختلفن كذلكا",223,"ك",2,1],["ويا بنان الكف لا تقضني","دمي فقد زانك أم طرفك",224,"ك",1,0],["ويابن الصفا والمازمين وزمزم","ويابن منى والخيف أعظم بها قدرا",225,"ر",2,0],["ويأبى الله إلا أن يتم الض","ضياء لكم ويعمي الحاسدينا",226,"ن",2,0],["ويا بدرا بنو العدل جلى","ظلام الظلم لما اسود جدا",227,"د",2,0],["ويأبى أبي النفس إظهار ذلة","لمن ضل في طرق الكرام وما اهتدى",228,"د",2,0],["ويا برق الحما رفقا بصب","روت عن صب مدمعه الغوادي",229,"د",2,0],["ويا بشراً يوحى إليه إلهكم","إله إلى توحيده الرسل أرسلا",230,"ل",2,0],["وَيا بَسمَةَ العَلياءِ زُرهُ سَعادَةً","وَأرّخ بِها ذي نُزهَةُ البَرِّ وَالبَحر",231,"ر",1,0],["وَيا بابَ فردوسٍ إلى كل طارقٍ","على منهجِ الإيمان راجٍ سخا البكرِ",232,"ر",1,0],["ويأبى للمروءة حين يخلو","مطايبةً مع الرشأ الرشيق",233,"ق",1,0],["ويا بعاداً لدهر","تبا له من منافي",234,"ف",2,0],["ويا بقية من أبقوا لنسلهم","مالا تزال له الألباب في عجب",235,"ب",1,0],["وَيا بَصَري عوفيت من قصرٍ بَدا","وَكنت كَزَرقاءِ اليَمامَةِ تنظُرُ",236,"ر",1,0],["وَيَأبى عَزيزٌ أَن يُرى مُتَذَلِّلا","أَلَم تَرَ أَنّ الحرب إِذ عَمَّتِ المَلا",237,"ل",2,0],["وَيا بَدر لَولا هذه الشَمس لم تزل","تمدّك بِالأَنوار هل كنت تبدرُ",238,"ر",1,0],["ويا بُؤْسَ عَيْشِي الحياةُ شَقِيَّةٌ","يُمَلِّكُها في رَبْقَةِ الهُونِ سافلُ",239,"ل",1,0],["ويا بهجةَ الدُّنيا تَهنَّأ ولا تَزَلْ","وأَنت على هامِ المفاخرِ صاعدُ",240,"د",1,0],["ويا بهجةَ الدنيا جلوسُك بهجةٌ","ويوبلك الميمونُ فخرُ الخلائقِ",241,"ق",1,0],["ويا بلدي حين أطوي البلادَ","ولا بلدٌ فيكِ إلّا وفيّْ",242,"ي",1,1],["ويَأبَى أن يُصَدِّقَنِي, ويَرجُو","مُعانَقَتِي فَتُقعِدُهُ الضُّغُوطُ",243,"ط",1,0],["ويا بدراً تجلى فاستضاءت","بنورٍ منه ألبابُ الرجال",244,"ل",1,0],["وَيَأْبَوْنَ الْحِوَاْرَ إِبَاْءَ حُرٍّ","وَإِنْ فَجَرَ الْمُنَاْفِقُ بِاقْتِدَاْرِ",245,"ر",1,0],["ويابنت مهما صار ومهما يقولون","الزين في عيونك يحسم القضيه",246,"ي",2,0],["ويا باباً إلى الجنات إني","أمينٌ فافتحي للقلب بابا",247,"ب",2,0],["ويابى طلى الأسد الطلاء ولن ترى","جدا الدهر طلواً يقتفيه جداء",248,"ا",2,0],["ويأْبى كمَالاً مذْ مَدَدْتُ تساؤلاً","لِيفْضِي بصمْتٍ ساد فعْلٌ فأُطْرشا",249,"ش",2,0],["ويا بر يا تواب هب لي عاجلا","متاباً نصوحاً بالقبول تلقاه",250,"ا",2,0],["ويا بذرةَ الزيتونِ تُرمى زروعُنا","وزيتُكِ وسْطَ الروضِ فينا قدِ احْتمى",251,"م",2,0],["ويا بنك وزعته ولا عاد بك شين","ولا عاد تبعث هالرسايل علينا..",252,"ن",2,0],["ويابشراك من عبقٍ","زهور الحوض ملتمّة",253,"م",2,0],["ويا بني عمنا لسنا نذكرهم","لكن مكابدة تستنطق الذكر",254,"ر",1,0],["وَيا بانَتَيْ سَفْحِ اللِّوَى هَلْ سَأَلْتُما","عَنْ المُكْثِرِ التَّسْآلَ فِي النَّاسِ عَنْكُمَا",255,"م",2,0],["ويأبى لي الضِّيمَ ما قد مضى","وعند الخصامِ فيعلوا جدالا",256,"ا",1,0],["ويابعد روح الذي ناجاك","وجدي على يديك بيديني",257,"ن",2,0],["ويا بوح ذاك الصدى دلني","سبيلاً إليك به أرتحلْ",258,"ل",1,0],["ويا بدراً سرى من أف","ق بيروتٍ إلى الغربِ",259,"ب",1,0],["ويابني الاسلام فيه فافخري","فذا هو العز الذي لم يرم",260,"م",1,0],["ويا بؤسَ محيانا ويا طولَ غمّنا","ويا شدَّ ما نلقاهُ في الدهر من قسْر",261,"ر",1,0],["ويا بحور ٍ عن يساري واليمين.","كل محاره ..... لها بحّارها.",262,"ر",3,0],["ويا بدر لاتغضب فإنك عبده","وإلا فقابله بوجهك إن بدا",263,"د",2,0],["ويأبى القدس أن يبقى ذليلاً","وقد كسر اليهود له جناحه",264,"ح",2,0],["ويأبى التصبرَ مالم يكنْ","لأجلِ الصلاح بهذا الوجودْ",265,"د",1,0],["ويا بَلَدَ الخَطِّ اعْتَرَاكِ لفقدِهِ","مدَى الدهرِ كَسْرٌ لا يُرَامُ لهُ جَبْرُ",266,"ر",1,0],["ويا بردا من بارد الثغر لم يكن","يعيبك إلا أن برقك خاطف",267,"ف",1,0],["وَيا بِلادي ها أَنا","أَحميكِ مِن كَيد العِدا",268,"د",2,0],["ويأبى حياء الدين ياأخوة الصفا","بأن أصف الرمان يختال مثمرا",269,"ر",2,0],["ويا بنت عزّ الرّشيد العظيم","وحاضنة العلم والعلماء",270,"ا",2,0],["ويابن العمّ تشتاق الخوابي","لكفّك تعصر الأعنابَ فيّا",271,"ي",2,0],["ويابغداد و«الخمسون»","بدءُ صبا يدي نِعَم",272,"م",1,0],["ويابريق الفجر في ليلة ٍ","مثل شعاع البدر في طهره ِ",273,"ر",2,0],["ويا بيض أيّامي ويا أنس وحشتي","مضى الدّهر بالسلوان إثر انقضائها",274,"ا",3,0],["ويأبَى الّذي في القلبِ إلاَّ تَبَيُّناً","وكلُّ إناءٍ بالذي فيهِ ينضَحُ",275,"ح",1,0]]}