من كنت تألف","https://www.poetsgate.com/ViewPoem.aspx?id=161868",""],[5081,"أَعْلَنْتُ حُبِّى","https://www.poetsgate.com/ViewPoem.aspx?id=185577",""],[5081,"وَهْمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=185880",""],[592,"على الحبر بحر العلم بدر المنابر","https://www.poetsgate.com/ViewPoem.aspx?id=128847",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5392,"..للخيوط ذهولُ","https://www.poetsgate.com/ViewPoem.aspx?id=11293",""],[475,"أَقُولُ بِعَمّانٍ وَهَلْ طَرَبِي بِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=20596",""],[5431,"قارورة عطر...","https://www.poetsgate.com/ViewPoem.aspx?id=202545",""],[5535,"تفقهت في عشقي لمن قد هويته","https://www.poetsgate.com/ViewPoem.aspx?id=201503",""],[2332,"تعرضن مرمى الصيد ثم رميننا","https://www.poetsgate.com/ViewPoem.aspx?id=99442",""],[470,"بيضُ وجوهُ بني عمي كما الغُررُ","https://www.poetsgate.com/ViewPoem.aspx?id=18590",""],[5582,"أَتَعْلَمُ ذاتُ الغُنْجِ أَمْ لَيْسَ تَعْلَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=187302",""],[5596,"سمائل المذهلة","https://www.poetsgate.com/ViewPoem.aspx?id=206486",""],[5596,"جامع الإمام الخليل بن شاذان","https://www.poetsgate.com/ViewPoem.aspx?id=206784",""],[5688,"عَذَابُ الشَّوْقِ","https://www.poetsgate.com/ViewPoem.aspx?id=200684",""],[5690,"صدقتم لحظهُ لحظ الغزالِ","https://www.poetsgate.com/ViewPoem.aspx?id=172173",""],[5725,"سفير العشاق","https://www.poetsgate.com/ViewPoem.aspx?id=191746",""],[5776,"فهارس الفراغ","https://www.poetsgate.com/ViewPoem.aspx?id=199335",""],[5786,"إن رمتَ منّي السلوَّ بالفند","https://www.poetsgate.com/ViewPoem.aspx?id=50657",""],[5956,"لماذا حياتي ؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=183869",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[5724,"بيارق النصر رفي فوق وادينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55137&r=&rc=4",""],[6304,"الشمس الجريحة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1611&r=&rc=1",""],[4228,"حيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69257&r=&rc=11",""]],"verses":[["وَلِلعُمرِ نَهجٌ إِن تَسَنَّمَهُ الفَتى","إِلى الغايَةِ القُصوى أَزَلَّ وَأَزلَقا",0,"ق",2,0],["وَلِلْعافي بِعَقْوَتِي احْتِكامٌ","على شِيَمٍ تَرِفُّ عَلَيْهِ مِيثِ",1,"ث",1,0],["وللعُرَيْبِ بأكْنافِ الحِمى حِلَلٌ","طَرَقْتُها والهَوى ذُهْلٌ وشَيْبانُ",2,"ن",1,0],["وَلِلعُلجومِ في الأُفقِ اِرتِعادُ ال","جبانِ مَخافَةَ الحوتِ الجَنوبي",3,"ب",2,0],["وَلِلعَبيرِ عَلى أَصداغِها عَبَقٌ","كَأَنَّهُ بِجَنوبِ المِحجَرِ العَلَقُ",4,"ق",1,0],["وَلِلعَيِن لا تَنَفكَّ ينَحى سَوادُها","عَلى إِثر حادٍ حَيثُ حاذَرتُ سالِكِ",5,"ك",1,0],["وللعلم فخر الدين والفتك بالعدا","بأوْتَ به يا ابن الخطيب على الفخرِ",6,"ر",1,0],["وللعواطف في أثنائه صور","جادت بها ريشة في كفّ فنّان",7,"ن",1,0],["وَلِلعَبّاسِ مَكرُمَةٌ وَبَيتٌ","عَلى العَلياءِ مُرتَفِعُ السَواري",8,"ر",2,0],["وَلِلعارِ خَلّى رَبُّ غَسّانَ مُلكَهُ","وَفارَقَ دينَ اللَهِ غَيرَ مُصيبِ",9,"ب",1,0],["وللعلوم تصانيفٌ بدت فغدت","نعم السوارُ على الإسلام والسور",10,"ر",1,0],["وللعروق ثمارُ الفرع تمنحها","أغصانُهُ وللبِّ الهامة الشعر",11,"ر",1,0],["وَلِلعُيونِ رِسالاتٌ مُرَدَّدَةٌ","تَدري القُلوبُ مَعانيها وَنُخفيها",12,"ي",3,0],["وللعيش الصبا فإذا تولى","فكل بقية في الكأس صاب",13,"ب",1,0],["وَلِلعَنزِيِّ قَد أَفرَغتُ سَجلاً","شَفَيتُ بِهِ الحَرارَةَ وَالغَليلا",14,"ل",2,0],["وَللعلم في لُبنان شيدت مَعاهِدٌ","فَلَم تبقِ أَيدي الجَهلِ مِنهن مَعهَدا",15,"د",2,0],["وَلِلْعُلُوقِ وَأَنْواعِ الْفُسُوقِ مَعاً","وَلِلْخُرُوقِ الْكَثِيراتِ التَّلاوِينِ",16,"ن",1,0],["وللعَرَبِ العَرْباءِ ذَلّتْ خدُودُهَا","وللفَترَةِ العَمْياءِ في الزّمَنِ العَمي",17,"م",2,0],["وللعِزّ في مِصرٍ يُرَدُّ سَريرُهُ","إلى ناعِبٍ بالبَينِ يَنْعِقُ أسْحَم",17,"م",1,0],["وَللعلم أَيام هي السعد كله","وأَمّا لَيالي الجهل فهي مناحس",18,"س",1,0],["وَلِلْعُلَمَاءِ وَالأُدَبَاءِ فِيمَا","نَأَت غَايَاتُهُ مَهَّدْتُ سُبْلِي",19,"ل",2,0],["وَلِلعُداةِ الغَمْرُ مِنْ بَأْسِهِ","وَلِلوُلاَةِ النَّائِلُ الغمْرُ",20,"ر",1,0],["وللعلا من صفات الغِيدِ أنّ لها","دَلاً يروِّع تقريباً بتبعيد",21,"د",1,0],["وللعيُونِ أحاديثٌ بلا كلِمِ","وكم لها في الهَوى شرحٌ وتبيانُ",22,"ن",1,0],["وللعلم مثل َ الشعب عمرٌ مقدر","وكلا أراه حان للموت حينه",23,"ن",2,0],["وللعلم فياضاً فماجَتْ مصادرٌ","عُنيتَ بها بحثاً وجاشَتْ موارد",24,"د",1,0],["ولِلعْقلِ من معنى العقالِ اشتقاقُه","إذا اقتِيدَ إنسان به فهو عاقل",25,"ل",1,0],["وَلِلْعَبِيرِ عَلَى أَصْدَغِهَا عَبَقٌ","كَأَنَّهُ بِجَنُوبِ المِحْجَرِ العَلَقُ",26,"ق",1,0],["وَلِلعُذرِ عِندَكَ إيساعُهُ","قَبولاً وَلِلذَنبِ أَن يُغتَفَر",27,"ر",1,0],["وَلِلعارِ كَشّافونَ إِن غَشِيَتهُمُ","وَغىً كَشَفَت عَمّا وَراءَ البَراقِعِ",28,"ع",1,0],["وللعَتْبِ بين جديد الوصالِ","وهجر الدلالِ حَواشٍ رقاق",29,"ق",1,0],["وللعين مرعى في الملاح وطالما","أضاع الهوى ما المرء بالحزم حافظه",30,"ظ",2,0],["وَلِلعقلِ حدٌّ لا يجاوزهُ كَما","لأبصارِنا حَدٌّ تُرى بعده حسرى",31,"ر",2,0],["وَلِلعِدى كُلُّ ما يُخشى عَواقِبُهُ","وَكُلُّ ما تَتَرجّى خَيرهُ فَلَكِ",32,"ك",1,0],["وَلِلعَلياءِ نَهجٌ مُستَقيمٌ","فَما لي تارِكاً ذا النَهجَ ما لي",33,"ل",2,0],["وللعود تلويحٌ وللدفّ نقرة","وفي الصنج تلميح الإشارة يُفهم",34,"م",1,0],["وللعصفورِ زَقزَقَةٌ","كَتَطريبٍ جَلا ترَحا",35,"ح",2,0],["وللعروشِ طوافٌ بالسرير إذا","قامَ الخليفةُ يعطي الناسَ تأمينا",36,"ن",2,0],["وللْعَوَاذِل عَنَّاني تَصَنُّعُهَا","كَما تُعَنِّي الخُصُورَ الهِيفَ أكْفالُ",37,"ل",1,0],["وللعلومِ خَليلا","وعنْ سواها خَليا",38,"ل",3,0],["وَلِلعِشارِ ضَجَّةٌ","مَخافَةً أَن تُنحَرا",39,"ر",2,0],["وللعفو والغفران والصفح أرتجي","من اللَه غفار الذنوب الكبائر",40,"ر",1,0],["وللعبدِ إرْثٌ من قديمِ وَلائه","غدا شافعاً منه طَريفاً بتالد",41,"د",1,0],["وللعفو أو للعذرِ منك ترقُّبي","لئن كُنَّ لي أو لم يكُنَّ ذنوب",42,"ب",1,0],["وَلِلعُقوبَةِ أَسبابٌ إِذا وَقَعَت","مِنهُم وَما لِلعَطايا عِندَهُم سَبَبُ",43,"ب",1,0],["وَلِلعَزيزِ مِنَ المُملوكِ أَربَعَةٌ","قلبٌ ونطقٌ وأخلاقٌ وإحمادُ",44,"د",1,0],["ولِلعيدِ أَيامٌ تَمرُّ وسَعدُها","عَلَى ما بِها مُلقي العَصا واضِعَ الرَّحلِ",45,"ل",1,0],["وللعاذلينَ معي شيمةٌ","إذا رغبوا في هوىً أزهدُ",46,"د",1,0],["وللعلم والتعليم والبر والهدى","وللمنهج المرضي للواحد الفرد",47,"د",1,0],["وللعبد مع الله","في الأديان حالات",48,"ت",1,0],["وللعبد مع النا","س أحوال وتارات",48,"ت",1,0],["وللعين كانوا قرة ثم أصبحوا","وهم عبرة تجري بها كل عبرة",49,"ه",1,0],["وَللعرب العرباء مِنهُ مَعاقِل","تُطلُّ عَلى الشِعرى العبور قُصورُها",50,"ر",3,0],["وللعدوّ على مج","دِهِ ثناء الصديقِ",51,"ق",1,0],["وللعرب الأحرار عشرون دولة","وثنتان والأخرى غداً ستسود",52,"د",1,0],["وللعود من صوتِ القِيان مساجل","وللزِّير من شدو الحمام مطارح",53,"ح",1,0],["وَلِلعَينِ أَسرابٌ تَفيضُ كَأَنَّما","تُعَلُّ بِكُحلِ الصابِ مِنها المَدامِعُ",54,"ع",1,0],["وللعطايا يا موسم جامع","فيها وللشعر بها معشر",55,"ر",1,0],["وللعلى ألسن تثني محامدها","على الحميدين من فعل ومن شيم",56,"م",1,0],["وللعيس من طولِ الوجيفِ مع الوَجى","على كلّ ملحوبِ السَّراةِ بُغامُ",57,"م",1,0],["وللعلوم والتقى","وسيرة المهديين",58,"ن",1,0],["وللعقل أيضا لذةٌ في جمالها","وسر بدا منها له وجب الكتم",59,"م",1,0],["وَلِلعَقلِ طولُ العُمرِ بِالعِلمِ صَبوَةٌ","بِلا سَلوَةٍ وَالأَلفِ بِالأَلفِ هائِمُ",60,"م",1,0],["وَلِلعُلُوِّ دَلالاتٌ يُبَيِّنُها","في العالَمِ البَشَريّ الهَمُّ والهِمَمُ",61,"م",1,0],["وِللعز قال المَجد فيهِ مؤرِخاً","أَيا عز تَوفيق لِمصر أَمير",62,"ر",1,0],["وَللعلماء وَالأمراء فيها","كَما تَهوى لكعبتها الوُفود",63,"د",1,0],["وَلِلعَدوِّ بِما أَنويهِ يُخبرُهُ","وَعَن عَدوّي وَما يَنويهِ ينقلُ لي",64,"ل",2,0],["ولِلعُلى مُرتقىً دَحْضٌ وكم زَلَقَتْ","عنه الأُيومُ فمن للأَبْلَق الزَّلَق",65,"ق",1,0],["وللعدا ضرْبُ سيفٍ في رقابهمُ","مِن بْعد قولٍ وإنذارٍ وتهديد",66,"د",1,0],["وَللعَلَمِ الخَافِقِ المُسْتَضَاء","بِهِ يَرفَعُ الثائِرونَ الجِبَاهَا",67,"ا",3,0],["وللعقبى عقول عارفات","بما يأتي بتخمين وحَدْسِ",68,"س",1,0],["وللعفو في وجهه آية","وفي سيفه دركات العقابْ",69,"ب",1,0],["وَلِلْعَضْبِ مَتْنٌ بِالْفُلُولِ مُنَقَّشٌ","وَلِلرمْحِ كَف بِالنَّجِيعِ مُخَضَّبُ",70,"ب",1,0],["وللعذار حروف بالبهار سمت","في وجنتيه فمنقوط ومشكول",71,"ل",1,0],["وَلِلْعَوَارِضِ إعْلاَمٌ بِصَفْحَتِهِ","قد سَجَّلَتْهُ الخدُودُ العَنْدَمِيَّاتُ",72,"ت",1,0],["وللعذارى حديث صح مسنده","إذ خرجته عن الخد الروايات",73,"ت",1,0],["وَلِلعَفافِ مَناراً فَوقَهُ لَمَعَت","أَنوار فَضلكَ فَاِستَهدَت بِها المُقَلُ",74,"ل",1,0],["وللعدل أن ينقاد كل ملوكنا","لكيما يحل الدين أعلى العواصم",75,"م",1,0],["وَلِلْعَرُوْضِ بَديْعٌ لَيْسَ يُنْطِقُهُ","إلا جَمِيْلُ الهَوى شِعْرِيْ يُنَاجِيْهِ",76,"ي",2,0],["وللعلم فيه والعبادة معلمٌ","جديدٌ على مر الجديدين مونق",77,"ق",1,0],["وللعروض عندهم فوائد","بها الصحيح معلم والفاسد",78,"د",1,0],["وللعشاق أنشد في حجاز","ألا جز بالديار وحيهّنه",79,"ن",2,0],["وللعدلِ أن ينجلي مُشرقا","وللظلم أن يختفي مُديرا",80,"ر",2,0],["وللعصر احكامٌ ولِلدهر حكمةٌ","وللبعض اقوالٌ وللبعض افعالُ",81,"ل",1,0],["وللعروبة في اظلالكم لجب","لها من الوحي والقرأن تأييد",82,"د",1,0],["وللعدا دُونَها من حَرِّ مَلْحَمَةٍ","يكادُ منها الهواءُ الرَّطبُ يشتْعل",83,"ل",1,0],["وللعلم من آثارنا في جبالنا","على الدهر آياتٌ بها ينطِق الصَخر",84,"ر",1,0],["وللعيوب جميعا","سين وتاء وراء",85,"ا",2,0],["وللعدوّين منه","حاء وتاء وفاء",85,"ا",2,0],["وَلِلعِلمِ فَاِعلَم شَوكُهُ وَزُهورُهُ","فَأَزهارُهُ تَذوي وَأَشواكُهُ تَنمو",86,"م",2,0],["وَلِلعَينِ فَيضاتٌ إِذا ماذَكَرتُها","وَلِلصدرِ بَلبالٌ إِذا العَينُ كَلَّتِ",87,"ت",1,0],["وَلِلعادِياتِ القَهقَري بينَ رِيِّهِ","وبينَ الوِحافِ مِن كُماتٍ وَمِن شُقرِ",88,"ر",1,0],["وللعضو إن أودى وفي الجسم مثله","من الدية العُظمى فنصفٌ مكملُ",89,"ل",1,0],["وللعبد ثنتان وللحر ضعفها","من البيض غيدٌ وضحُ الخلق رجحُ",90,"ح",1,0],["وللعديم فشهران يصومهما","عن كل حجٍ يسميه إلى أجل",91,"ل",1,0],["وللعمة الوسطى مع ابنةِ ابنهِ","من المال سدسٌ لا يزادُ إن اقرعُ",92,"ع",1,0],["وللعذال الغراء بلومي","يخالوني المت وما المت",93,"ت",1,0],["وَللعرب مِن هَذا كَثيرٌ وَهَل لَنا","بِمَن نَقتَدي في الشعر إِلا الأَعارب",94,"ب",1,0],["ولِلعُيونِ اللَّواتي هُنَّ من أَسَدٍ","إلى القُلوبِ سِهامٌ هُنَّ من ثُعَلِ",95,"ل",1,0],["وَلِلعُلومِ التي تَخفى غَوامِضُها","على الفُحولِ من الأحبارِ وَالعُلما",96,"م",2,0],["وللعجاج ستور","رقومها لمع قُضبِه",97,"ب",2,0],["وللعقولِ منه","ظِلٌّ مُظلل",98,"ل",1,0],["وللعقل باستقلال ما قلتهُ به","دليلٌ كحد الهنداونيّ قاطع",99,"ع",1,0],["وللعدل إسعادٌ وللعلم دَوْلَةٌ","وللشّرع إعزازٌ تَيَسَّ