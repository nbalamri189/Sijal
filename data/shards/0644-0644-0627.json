{"poems":[[63,"سرت وجنح الليل غربيب","https://www.aldiwan.net/poem46147.html","السريع"],[93,"مليكتانا أدام الله عزهما","https://www.aldiwan.net/poem11199.html","البسيط"],[93,"قف خاشعاً بضريح عز الدين","https://www.aldiwan.net/poem11214.html","الكامل"],[93,"أهديت والمهدى ثمين","https://www.aldiwan.net/poem11276.html","مجزوء الكامل"],[88,"أنا بالحكومة والسياسة أعرف","https://www.aldiwan.net/poem44808.html","الكامل"],[51,"يا من أغار عليه من غلائله","https://www.aldiwan.net/poem65939.html","البسيط"],[91,"وطن النجوم أنا هنا","https://www.aldiwan.net/poem62783.html","عموديه"],[92,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[85,"الله أعطى عهد مصر محمدا","https://www.aldiwan.net/poem6823.html","الكامل"],[85,"للأم والابن وللبنت","https://www.aldiwan.net/poem6957.html","الرجز"],[85,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[45,"صب يخاطب مفحمات طلول","https://www.aldiwan.net/poem65548.html","الكامل"],[45,"أتراه يظنني أو يراني","https://www.aldiwan.net/poem66786.html","الخفيف"],[80,"للأقاحي بفيك نور ونور","https://www.aldiwan.net/poem31434.html","الخفيف"],[90,"أرح ركابك من أين ومن عثر","https://www.aldiwan.net/poem60154.html","عموديه"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85335","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39552","الخفيف"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50358","الطويل"],[106,"تحيْة وقضيّة","https://www.poetsgate.com/ViewPoem.aspx?id=179505",""],[106,"الكلب هول","https://www.poetsgate.com/ViewPoem.aspx?id=179445",""],[90,"تحرك اللحد !","https://www.poetsgate.com/ViewPoem.aspx?id=179160",""],[90,"تحية الحلة","https://www.poetsgate.com/ViewPoem.aspx?id=179146",""],[90,"حافظ إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=179126",""],[45,"أتَرَاهُ يَظُنُّني، أوْ يَرَانِي","https://www.poetsgate.com/ViewPoem.aspx?id=32077",""],[113,"للاسد ضمن الفلاة غاب","https://www.aldiwan.net/poem41241.html","عموديه"],[140,"كما قلتما برء الصبابة في الياس","https://www.aldiwan.net/poem58452.html","الطويل"],[167,"كره الله ما أحب الأعادي","https://www.aldiwan.net/poem1621.html",""],[184,"للأديب اللبيب هم بشانه","https://www.aldiwan.net/poem43245.html","الخفيف"],[191,"للأقحوان على ملاحته وخز","https://www.aldiwan.net/poem13081.html","أحذ الكامل"],[209,"غنى المغنون من حولى فما سمعت","https://www.aldiwan.net/poem46768.html","البسيط"],[220,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[259,"عطفاً علينا يا زمان","https://www.aldiwan.net/poem38163.html","مجزوء الكامل"],[268,"لأبي عبيدة في دمشق وخالد","https://www.aldiwan.net/poem35645.html","الكامل"],[273,"أسرف الدهر فهلا قصدا","https://www.aldiwan.net/poem25585.html","الرمل"],[280,"ذكر الصبا منه لي هاجت صبابات","https://www.aldiwan.net/poem32859.html","البسيط"],[303,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[318,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[326,"رأيتها تمشي وفي كفها","https://www.aldiwan.net/poem54920.html","السريع"],[362,"إلى خيال خيال في الظلام سرى","https://www.aldiwan.net/poem60879.html","البسيط"],[369,"أطلعني الحب على غيبه","https://www.aldiwan.net/poem56941.html","السريع"],[397,"برقية شعرية إلى الصحافة العربية","https://www.aldiwan.net/poem10295.html","عموديه"],[400,"هل أهنيك أم أهني المعالي","https://www.aldiwan.net/poem33473.html","الخفيف"],[477,"أبدى البيانو بيانا","https://www.aldiwan.net/poem36976.html","المجتث"],[512,"خلط الغرام الشجو في أمشاجه","https://www.aldiwan.net/poem20829.html","الكامل"],[513,"إن كان عطفك للإعجاب يختال","https://www.aldiwan.net/poem12212.html","البسيط"],[536,"للأرض شهب كالسما لا يرتجي","https://www.aldiwan.net/poem47988.html","عموديه"],[556,"إن ترم أن تعرف الأحوال","https://www.aldiwan.net/poem34230.html","المديد"],[560,"نحن النصارى آل عيسى المنتمي","https://www.aldiwan.net/poem52748.html","الكامل"]],"verses":[["للأسَلِ اللُّدْنِ بأرْجائِها","والخَيْلُ أُخْدودٌ وأُلْهوبُ",0,"ب",1,0],["لِلاتِّحَادِ بِهِ مَرْمَى أَرَادَ بِهِ","رُقِيَّ أُمَّتِهِ فِي شَطْرِهَا الثَّانِي",1,"ن",2,0],["لِلأَكْرَمِينَ بَنِي طَرَابُلُسٍ يَدٌ","عِنْدِي وَفَضْلٌ لَيْسَ بِالمَمْنُونِ",2,"ن",1,0],["لِلأَلمعِيَّةِ أَيُّ شَّأ","نٍ حَيْثُ تَشْتَبِهُ الشُّؤُونُ",3,"ن",1,0],["للإنكَليز مطامع ببلادكم","لا تنتهي إلاّ بأن تتبلشفُوا",4,"ف",3,0],["للأريحية مشيٌ في مفاصلِه","وليس للراح مشيٌ في مفاصلِهِ",5,"ل",2,0],["لِلآرزِ يَهزَءُ بِالرِياحِ","وَبِالدُهورِ وَبِالفَنا",6,"ن",2,0],["للأغاني التي يُرَدِّدُها الرَّا","عي بمزمارِهِ الصَّغيرِ الأَمينِ",7,"ن",1,0],["للأصل طهرا والفروع كريمة","والبر حقا والحنان مؤكدا",8,"د",2,0],["للأم والابن وللبنت","أجل وكل من متَّ لنا بالنسبِ",9,"ب",1,1],["لِلأَرضِ يَومٌ وَالسَماءِ قِيامَةٌ","وَقِيامَةُ الوادي غَداةَ تُحَلِّقُ",10,"ق",1,0],["لِلأَروَعِ البُهلولِ ثابَ بِهِ النَدى","مِن كُلِّ أَروَعَ مِنهُمُ بُهلولِ",11,"ل",1,0],["لِلإِمامِ المُعتَزِّ بِاللَهِ إِعزا","زٌ مِنَ اللَهِ قاهِرِ السُلطانِ",12,"ن",1,0],["للأقاحي بفيكِ نَوْرٌ ونورُ","ما كذا تَسْنَحُ المهاةُ النّفُورُ",13,"ر",1,1],["للآنَ يُطرب سمعي في شواطئه","صدحُ الحمام وثغيُ الشاة والبقر",14,"ر",1,0],["للأناشيد ينشدون بصوتٍ","في النفوس الحرَّى لها تأثير",15,"ر",1,0],["للأَرض أَدوار وَلست بعارف","حَتّى مَتى تَتعاقب الأدوار",16,"ر",1,0],["للأنفس الظمأى إِليك التفات","ولهفةٌ ملءَ اللّحاظ الجياع",17,"ع",1,0],["للإلهِ العظيم من لُجِّه السا","كنِ أتلو الجميلَ من صلواتي",18,"ي",1,0],["لَلاقَتْ حقوقُ القَوْمِ حِلفَةَ باطلٍ","كما لاقَتِ الشَّجراءُ إحدى الصَّواعِقِ",19,"ق",1,0],["للأنف والعينين من","أزهاره طيفٌ وطيب",20,"ب",1,0],["للأمن شرطيِّ علي","هِ ساهر يحمي حماه",21,"ا",2,0],["للآن لمْ يُلغَ شبرٌ من مَزارعِهم","ولا تَزحزح مّمِا شيَّدوا حَجر",22,"ر",1,0],["للآنَ يُحتاجُ في إصلاحِ مملكةٍ","نظامُ دولةِ آشورٍ وكِلدان",23,"ن",1,0],["للأريحيَّةِ مَنْشاهُ ومَصْدرُهُ","وللشَّجاوةِ والإيناسِ حَدّاه",24,"ا",2,0],["للإمَامِ المُعْتَزّ بالله إعْزَا","رٌ مِنَ الله قاهِرِ السّلْطانِ",25,"ن",1,0],["للاسد ضمن الفلاة غاب","تنبح اطرافه الكلاب",26,"ب",1,1],["للا رِقبةٍ جَورُ الزمان وعدلُهُ","وتحريجُه جارٍ على غير مقياسِ",27,"س",1,0],["لِلإِجازات وَالجَوائِزِ يُمنا","هُ وَبيضِ الظُبا وَسُمرِ الصِعادِ",28,"د",1,0],["للأديب اللبيب همّ بشانه","وانشغال بحاله في مكانه",29,"ن",2,1],["لِلأقحُوانِ عَلى مَلاحَتِهِ وَخزُ","بِقَلبٍ يَشتَكي العِشقا",30,"ق",2,1],["للأعين الخضرِ سحرٌ قاهرٌ خضعت","له الفواتك من صلّ وثعبان",31,"ن",1,0],["للاضطراب والاباء والحرف","والصوت أو للسير جاء كوجف",32,"ف",1,0],["للأعجمي وللفصيح على","الدقائق ترجمان",33,"ن",1,0],["للإنكليز وللفَرنسيسِ الوَرى","والأرضُ مِثلُ غنائمٍ وطرائد",34,"د",1,0],["لِلإمَامِ المُرْتَضَى مِما مَضى","خَلَفٌ يُولِيكَ عَيْشاً رَغَدا",35,"د",2,0],["لِلأَولِياءِ وِلاياتٌ بِها لَبِسوا ال","آلاتِ مِنهُ وَلِلأَعداءِ وَيلاتُ",36,"ت",1,0],["لِلأرضِ يرجعُ ما عَليها إنّما","هِيَ مستقرٌّ بعده مستودعُ",37,"ع",1,0],["لِلأَمنِ مِن شَرِّهِ في حالِ قُوَّتِهِ","أَحَلَّ أُمَّتَهُ في حَرزِ مِلَّتِهِ",38,"ه",1,0],["للأرض عندي عالم فاضل","وللسماء العالم الأفضل",39,"ل",1,0],["للأُمَّةِ الدَّهرَ يَسعَى والإمام معاً","سعْياً له العَبْدُ والمعبود قد شَكَرا",40,"ر",2,0],["للأهيَف الأغيَد والنَّفسُ ما","آلفَها للأهيفِ الأغيَدِ",41,"د",1,0],["للأمر بالمعروف منهم خنجر","يدمي وشتم معلن وسباب",42,"ب",1,0],["للإِمام العظيم ذي الأمر والنهي","قرين الإِسعاد والإِقبال",43,"ل",1,0],["للأصرمي المغاني","قد ألقت السمع قسرا",44,"ر",2,0],["للأعرَجينِ وإن بدَتْ شُرُفاتُه","لن يَبلُغا المِعشارَ من مِعراجِهِ",45,"ج",2,0],["للأقحوانة منها حسن مبسمها","وللشقائق منها الخد والخال",46,"ل",1,0],["لِلأرضِ شُهبٌ كالسَّما لا يَرتَجي","إلا الظَّلومُ المُستبِدُّ زَوالَها",47,"ل",3,1],["للإله الحق خالقنا","منجح المقصود والآمال",48,"ل",1,0],["للآبِ لاهوتُ ابنهِ وَكذا ابنُهُ","وكذا هما والرُّوحُ تحتَ تَقنُّمِ",49,"م",1,0]]}