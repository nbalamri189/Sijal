.aspx?id=191300",""],[6305,"رؤى في أخريات الطريق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87346&r=&rc=19",""],[4222,"أهدى النسيم لنا ريا الرياحين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52910&r=&rc=202",""],[5190,"للأرض وجهٌ آخر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78324&r=&rc=37",""],[5567,"وسواس الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81769&r=&rc=37",""]],"verses":[["للأسَلِ اللُّدْنِ بأرْجائِها","والخَيْلُ أُخْدودٌ وأُلْهوبُ",0,"ب",1,0],["لِلاتِّحَادِ بِهِ مَرْمَى أَرَادَ بِهِ","رُقِيَّ أُمَّتِهِ فِي شَطْرِهَا الثَّانِي",1,"ن",2,0],["لِلأَكْرَمِينَ بَنِي طَرَابُلُسٍ يَدٌ","عِنْدِي وَفَضْلٌ لَيْسَ بِالمَمْنُونِ",2,"ن",1,0],["لِلأَلمعِيَّةِ أَيُّ شَّأ","نٍ حَيْثُ تَشْتَبِهُ الشُّؤُونُ",3,"ن",1,0],["للإنكَليز مطامع ببلادكم","لا تنتهي إلاّ بأن تتبلشفُوا",4,"ف",3,0],["للأريحية مشيٌ في مفاصلِه","وليس للراح مشيٌ في مفاصلِهِ",5,"ل",2,0],["للأَرْزِ يَهزأُ بالرياحِ","وبالدهورِ وبالفَنا",6,"ن",2,0],["لِلآرزِ يَهزَءُ بِالرِياحِ","وَبِالدُهورِ وَبِالفَنا",7,"ن",2,0],["للأغاني التي يُرَدِّدُها الرَّا","عي بمزمارِهِ الصَّغيرِ الأَمينِ",8,"ن",1,0],["للأصل طهرا والفروع كريمة","والبر حقا والحنان مؤكدا",9,"د",2,0],["للأم والابن وللبنت","أجل وكل من متَّ لنا بالنسبِ",10,"ب",1,1],["لِلأَرضِ يَومٌ وَالسَماءِ قِيامَةٌ","وَقِيامَةُ الوادي غَداةَ تُحَلِّقُ",11,"ق",1,0],["لِلأَروَعِ البُهلولِ ثابَ بِهِ النَدى","مِن كُلِّ أَروَعَ مِنهُمُ بُهلولِ",12,"ل",1,0],["لِلإِمامِ المُعتَزِّ بِاللَهِ إِعزا","زٌ مِنَ اللَهِ قاهِرِ السُلطانِ",13,"ن",1,0],["للأقاحي بفيكِ نَوْرٌ ونورُ","ما كذا تَسْنَحُ المهاةُ النّفُورُ",14,"ر",1,1],["للآنَ يُطرب سمعي في شواطئه","صدحُ الحمام وثغيُ الشاة والبقر",15,"ر",1,0],["للأناشيد ينشدون بصوتٍ","في النفوس الحرَّى لها تأثير",16,"ر",1,0],["للأَرض أَدوار وَلست بعارف","حَتّى مَتى تَتعاقب الأدوار",17,"ر",1,0],["للأنفس الظمأى إِليك التفات","ولهفةٌ ملءَ اللّحاظ الجياع",18,"ع",1,0],["للإلهِ العظيم من لُجِّه السا","كنِ أتلو الجميلَ من صلواتي",19,"ت",2,0],["لَلاقَتْ حقوقُ القَوْمِ حِلفَةَ باطلٍ","كما لاقَتِ الشَّجراءُ إحدى الصَّواعِقِ",20,"ق",1,0],["للأنف والعينين من","أزهاره طيفٌ وطيب",21,"ب",1,0],["للأمن شرطيِّ علي","هِ ساهر يحمي حماه",22,"ا",2,0],["للاستقامة في تقديره قبس","فظنه تحت نور الله ايقان",23,"ن",1,0],["للآن لمْ يُلغَ شبرٌ من مَزارعِهم","ولا تَزحزح مّمِا شيَّدوا حَجر",24,"ر",1,0],["للآنَ يُحتاجُ في إصلاحِ مملكةٍ","نظامُ دولةِ آشورٍ وكِلدان",25,"ن",1,0],["للأريحيَّةِ مَنْشاهُ ومَصْدرُهُ","وللشَّجاوةِ والإيناسِ حَدّاه",26,"ا",2,0],["للإمَامِ المُعْتَزّ بالله إعْزَا","رٌ مِنَ الله قاهِرِ السّلْطانِ",27,"ن",1,0],["للأقوياء شريعة مكتوبة","بالسيف شيب حلالها بحرامها",28,"م",3,0],["للاسد ضمن الفلاة غاب","تنبح اطرافه الكلاب",29,"ب",1,1],["للا رِقبةٍ جَورُ الزمان وعدلُهُ","وتحريجُه جارٍ على غير مقياسِ",30,"س",1,0],["لِلإِجازات وَالجَوائِزِ يُمنا","هُ وَبيضِ الظُبا وَسُمرِ الصِعادِ",31,"د",1,0],["للأديب اللبيب همّ بشانه","وانشغال بحاله في مكانه",32,"ن",2,1],["لِلأقحُوانِ عَلى مَلاحَتِهِ وَخزُ","بِقَلبٍ يَشتَكي العِشقا",33,"ق",2,1],["للأعين الخضرِ سحرٌ قاهرٌ خضعت","له الفواتك من صلّ وثعبان",34,"ن",1,0],["للاضطراب والاباء والحرف","والصوت أو للسير جاء كوجف",35,"ف",1,0],["للأعجمي وللفصيح على","الدقائق ترجمان",36,"ن",1,0],["للإنكليز وللفَرنسيسِ الوَرى","والأرضُ مِثلُ غنائمٍ وطرائد",37,"د",1,0],["لِلإمَامِ المُرْتَضَى مِما مَضى","خَلَفٌ يُولِيكَ عَيْشاً رَغَدا",38,"د",2,0],["لِلأَولِياءِ وِلاياتٌ بِها لَبِسوا ال","آلاتِ مِنهُ وَلِلأَعداءِ وَيلاتُ",39,"ت",1,0],["لِلأرضِ يرجعُ ما عَليها إنّما","هِيَ مستقرٌّ بعده مستودعُ",40,"ع",1,0],["لِلأَمنِ مِن شَرِّهِ في حالِ قُوَّتِهِ","أَحَلَّ أُمَّتَهُ في حَرزِ مِلَّتِهِ",41,"ه",1,0],["للأرض عندي عالم فاضل","وللسماء العالم الأفضل",42,"ل",1,0],["للأُمَّةِ الدَّهرَ يَسعَى والإمام معاً","سعْياً له العَبْدُ والمعبود قد شَكَرا",43,"ر",2,0],["للأهيَف الأغيَد والنَّفسُ ما","آلفَها للأهيفِ الأغيَدِ",44,"د",1,0],["للأمر بالمعروف منهم خنجر","يدمي وشتم معلن وسباب",45,"ب",1,0],["للإِمام العظيم ذي الأمر والنهي","قرين الإِسعاد والإِقبال",46,"ل",1,0],["للأصرمي المغاني","قد ألقت السمع قسرا",47,"ر",2,0],["للأعرَجينِ وإن بدَتْ شُرُفاتُه","لن يَبلُغا المِعشارَ من مِعراجِهِ",48,"ج",2,0],["للأقحوانة منها حسن مبسمها","وللشقائق منها الخد والخال",49,"ل",1,0],["لِلأرضِ شُهبٌ كالسَّما لا يَرتَجي","إلا الظَّلومُ المُستبِدُّ زَوالَها",50,"ل",3,1],["للإله الحق خالقنا","منجح المقصود والآمال",51,"ل",1,0],["للآبِ لاهوتُ ابنهِ وَكذا ابنُهُ","وكذا هما والرُّوحُ تحتَ تَقنُّمِ",52,"م",1,0],["للإشتراكية العقبى إذا شملت","شتى الشعوب وجاراها المجارونا",53,"ن",2,0],["للأكثرين رضاهمُ ولمن أبى","عذر الذي طلب البعيد فهاما",54,"م",2,0],["للأفاعي الجُحورُ مهما تمادى","مدَّعوها وللصقورِ السماءُ",55,"ا",2,0],["للألم الأقداح من ثغره","ووردتي خدِّيه فوق القداح",56,"ح",1,0],["للآم سالفه في لوح وجنته","خط سعيد به للصب تعليل",57,"ل",1,0],["لِلأَولِياءِ رَخاؤُهُ وَرُخاؤُهُ","وَعَلى العِداةِ سَمومُهُ وَسِمامُهُ",58,"م",2,0],["لِلإِمامِ المَنصورِ أَحمَدَ أَضحَت","كُلُّ أَملاكِ الأَرضِ طُرّاً مَوالِ",59,"ل",1,0],["للأجر مُنشيه أخو الْ","خَبرِ الوجيز أبو الهِبات",60,"ت",1,0],["للامام الذي ترقى مقاما","شاملا واقتفى الرجال الفحولا",61,"ل",2,0],["للاسم أل واجرر وناد","انسب أضف",62,"ف",1,0],["للاسم أربعون والفعليّه","ستّون والخمسون للحرفيّه",62,"ه",1,0],["للاسم ثم الفعل ثم الحرف","ستون وجها من وجوه الحذف",62,"ف",1,0],["للايمن اللامُ ونونٌ ثم با","وألف والكافُ أيضا رُتِّبا",63,"ب",2,0],["للإمارات ألف ألف عزاء","وعزاء من أختها \"مريتان\"",64,"ن",1,0],["للآس فضل بقائه ووفائه","ودوام نضرته على الأوقات",65,"ت",1,1],["للإنس وللجن رحمة وحباه","نصرا وعليه بذاك أنزل قرآن",66,"ن",1,0],["للأرض شمسَ السما للرائي","سبحانه ناشراً إحسانا",67,"ن",2,0],["لِلآبداتِ وللعَواقِلِ لم يَدَع","من مَجثَمٍ منها ولا من معقِلِ",68,"ل",1,0],["للإمام الخليفه فخذ من شي وعاد","سوف تأتي بشائر كثيره",69,"ر",2,0],["للأكل أهل لا يجاوز غيرهم","أيديهم فيه كما الفصال",70,"ل",1,0],["للأول النصف والثاني له ربعٌ","والثمن للثالث الذي طلبا",71,"ب",2,0],["للأميرين اللذين زهى","بهما قصر وإيوان",72,"ن",1,0],["للامهات وللقرائن مثكلاً","وملامِلاً وصغارهن ميتِما",73,"م",2,0],["للانتقال من البسيطة قاصداً","جهة اليمينِ ومغربَ الأسرارِ",74,"ر",1,0],["للإِبتدَاءِ وَالإنتِهَاءِ وَذَانِ لِل","أجسَامِ أينَ الله مِنَ هَذَانِ",75,"ن",1,0],["للإخا ما زال يرعى ذمما","عهدها عند سواه ما رعى",76,"ع",2,0],["للاسم لاح عُلوٌ","سما السماءَ عُلاهُ",77,"ا",2,0],["لِلآسِ والسوسَنِ وَالياسمي","ن الغَض وَالخَيريّ فضلٌ شَديد",78,"د",1,1],["للأرض قالت مبانيه مؤرخة","باهت جمال سموا قبة الفلك",79,"ك",1,0],["للأكل واللبس أضحت كلُّ حاجتهمْ","والناسُ أحوج ما كانوا الى الأدب",80,"ب",1,0],["للأذن لم يعرفوا الطريق وقد","عرفتُ شتى الدروب للقلب",81,"ب",1,0],["للأهل بي شاعر بالحس مشتعل","بي فيلسوف لفحص الكون للرؤيا",82,"ي",2,0],["للأمير الجليل لا","حط من نبل قدره",83,"ر",2,1],["لِلاجِئِينَ غَمَامُ العِشْقِ دَانِيَةٌ","قُطُوفُهَا بِقَشِيْبِ الحَرْفِ وَالصُّحُفِ",84,"ف",1,0],["للإنجليز علينا ذمة عظمت","من أن تداس بتسويف ونسيان",85,"ن",1,0],["للأرض منها مستقرّ بينما","هي للسماء معارج ومفاتح",86,"ح",1,0],["للأمر قومٌ وقومٌ جل أمرهم","أن ينتهي الكل منهم وهو مأمور",87,"ر",1,0],["للأولياء نعمة","ونقمة على العدى",88,"د",2,0],["للآسى فيها تعاليل ولليأس تمنى","وهو احساسى الذى ينساب كالجدول منى",89,"ن",2,0],["لِلأَمامِ لِلأَمامِ","يا بَني مِصرَ الكِرام",90,"م",1,1],["للأجْرِ تُحْرِزُهُ للوعْدِ تُنجزُهُ","للجيْشِ تُنْهِدُهُ للرّشْدِ تُلْهِمُهُ",91,"م",2,0],["لِلأَفضَلِ الأَفضَلِ الخَليفَةِ عَب","دِ اللَهِ مِن دونِ شَأوِهِ صُعُدُ",92,"د",1,0],["لِلاِنتِهَا حَتَّى وَلامٌ وَإلَى","وَمِن وَباءٌ يُفهِمَانِ بَدَلاَ",93,"ل",2,0],["للإمام الذي لرفعته","لثم العالمون أعتابه",94,"ب",2,0],["للإِنشقاقِ الرَذلِ شَرُّ مَعانِ","في أمرهِ قد حارَ كلُّ مُعانِ",95,"ن",1,1],["للأبرق الفرد حن القلب وهو على","غلاته قد طوى شوقاً لناشره",96,"ر",2,0],["للأُنس والشوق قومٌ نحن أَولُّهم","تخشى عيون الظِّبى والأُسد تخشانا",97,"ن",2,1],["لِلأّجْرِ وَالشُّكْرِ خازِنٌ أَبَداً","وَلَمْ يَصُنْ مالَهُ وَلاَ خَزَنَهْ",98,"ن",2,0],["للارتحال والنحاس صفر","والصفر للفارغ ثم العشر",99,"ر",1,0],["للاختلاط وعلى محمد","طُلاوة من يتأَمل يشهد",100,"د",1,0],["للأولى يثقلهم هول الصعاب","فاتبعوني واحملوا طرا فلا",101,"ل",2,0],["للإنس خلي الحرب نرقبها","من فوق ذاك التل طي غطا",102,"ط",2,0],["للأَرضِ أُلقِيَ يَستَغِيثُ بِقَومِهِ","لَكِنَّ فِيرُؤُس تَقَدَّمَ عادِي",103,"د",2,