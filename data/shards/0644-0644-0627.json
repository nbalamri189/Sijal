{"poems":[[65,"سرت وجنح الليل غربيب","https://www.aldiwan.net/poem46147.html","السريع"],[95,"مليكتانا أدام الله عزهما","https://www.aldiwan.net/poem11199.html","البسيط"],[95,"قف خاشعاً بضريح عز الدين","https://www.aldiwan.net/poem11214.html","الكامل"],[95,"أهديت والمهدى ثمين","https://www.aldiwan.net/poem11276.html","مجزوء الكامل"],[90,"أنا بالحكومة والسياسة أعرف","https://www.aldiwan.net/poem44808.html","الكامل"],[53,"يا من أغار عليه من غلائله","https://www.aldiwan.net/poem65939.html","البسيط"],[93,"وطن النجوم","https://www.aldiwan.net/poem49843.html","عموديه"],[93,"وطن النجوم أنا هنا","https://www.aldiwan.net/poem62783.html","عموديه"],[94,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[87,"الله أعطى عهد مصر محمدا","https://www.aldiwan.net/poem6823.html","الكامل"],[87,"للأم والابن وللبنت","https://www.aldiwan.net/poem6957.html","الرجز"],[87,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[47,"صب يخاطب مفحمات طلول","https://www.aldiwan.net/poem65548.html","الكامل"],[47,"أتراه يظنني أو يراني","https://www.aldiwan.net/poem66786.html","الخفيف"],[82,"للأقاحي بفيك نور ونور","https://www.aldiwan.net/poem31434.html","الخفيف"],[92,"أرح ركابك من أين ومن عثر","https://www.aldiwan.net/poem60154.html","عموديه"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85335","الكامل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39552","الخفيف"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/50358","الطويل"],[108,"تحيْة وقضيّة","https://www.poetsgate.com/ViewPoem.aspx?id=179505",""],[108,"الكلب هول","https://www.poetsgate.com/ViewPoem.aspx?id=179445",""],[111,"تلك البوارق حاديهن مرنان","https://www.poetsgate.com/ViewPoem.aspx?id=100",""],[92,"تحرك اللحد !","https://www.poetsgate.com/ViewPoem.aspx?id=179160",""],[92,"تحية الحلة","https://www.poetsgate.com/ViewPoem.aspx?id=179146",""],[92,"حافظ إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=179126",""],[47,"أتَرَاهُ يَظُنُّني، أوْ يَرَانِي","https://www.poetsgate.com/ViewPoem.aspx?id=32077",""],[96,"فترقبوا الغارات من أيتامها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67400&r=&rc=87",""],[119,"للاسد ضمن الفلاة غاب","https://www.aldiwan.net/poem41241.html","عموديه"],[146,"كما قلتما برء الصبابة في الياس","https://www.aldiwan.net/poem58452.html","الطويل"],[173,"كره الله ما أحب الأعادي","https://www.aldiwan.net/poem1621.html",""],[190,"للأديب اللبيب هم بشانه","https://www.aldiwan.net/poem43245.html","الخفيف"],[197,"للأقحوان على ملاحته وخز","https://www.aldiwan.net/poem13081.html","أحذ الكامل"],[215,"غنى المغنون من حولى فما سمعت","https://www.aldiwan.net/poem46768.html","البسيط"],[226,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[265,"عطفاً علينا يا زمان","https://www.aldiwan.net/poem38163.html","مجزوء الكامل"],[274,"لأبي عبيدة في دمشق وخالد","https://www.aldiwan.net/poem35645.html","الكامل"],[279,"أسرف الدهر فهلا قصدا","https://www.aldiwan.net/poem25585.html","الرمل"],[286,"ذكر الصبا منه لي هاجت صبابات","https://www.aldiwan.net/poem32859.html","البسيط"],[309,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[324,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[332,"رأيتها تمشي وفي كفها","https://www.aldiwan.net/poem54920.html","السريع"],[368,"إلى خيال خيال في الظلام سرى","https://www.aldiwan.net/poem60879.html","البسيط"],[375,"أطلعني الحب على غيبه","https://www.aldiwan.net/poem56941.html","السريع"],[404,"برقية شعرية إلى الصحافة العربية","https://www.aldiwan.net/poem10295.html","عموديه"],[407,"هل أهنيك أم أهني المعالي","https://www.aldiwan.net/poem33473.html","الخفيف"],[482,"أبدى البيانو بيانا","https://www.aldiwan.net/poem36976.html","المجتث"],[517,"خلط الغرام الشجو في أمشاجه","https://www.aldiwan.net/poem20829.html","الكامل"],[518,"إن كان عطفك للإعجاب يختال","https://www.aldiwan.net/poem12212.html","البسيط"],[541,"للأرض شهب كالسما لا يرتجي","https://www.aldiwan.net/poem47988.html","عموديه"],[561,"إن ترم أن تعرف الأحوال","https://www.aldiwan.net/poem34230.html","المديد"],[565,"نحن النصارى آل عيسى المنتمي","https://www.aldiwan.net/poem52748.html","الكامل"]],"verses":[["للأسَلِ اللُّدْنِ بأرْجائِها","والخَيْلُ أُخْدودٌ وأُلْهوبُ",0,"ب",1,0],["لِلاتِّحَادِ بِهِ مَرْمَى أَرَادَ بِهِ","رُقِيَّ أُمَّتِهِ فِي شَطْرِهَا الثَّانِي",1,"ن",2,0],["لِلأَكْرَمِينَ بَنِي طَرَابُلُسٍ يَدٌ","عِنْدِي وَفَضْلٌ لَيْسَ بِالمَمْنُونِ",2,"ن",1,0],["لِلأَلمعِيَّةِ أَيُّ شَّأ","نٍ حَيْثُ تَشْتَبِهُ الشُّؤُونُ",3,"ن",1,0],["للإنكَليز مطامع ببلادكم","لا تنتهي إلاّ بأن تتبلشفُوا",4,"ف",3,0],["للأريحية مشيٌ في مفاصلِه","وليس للراح مشيٌ في مفاصلِهِ",5,"ل",2,0],["للأَرْزِ يَهزأُ بالرياحِ","وبالدهورِ وبالفَنا",6,"ن",2,0],["لِلآرزِ يَهزَءُ بِالرِياحِ","وَبِالدُهورِ وَبِالفَنا",7,"ن",2,0],["للأغاني التي يُرَدِّدُها الرَّا","عي بمزمارِهِ الصَّغيرِ الأَمينِ",8,"ن",1,0],["للأصل طهرا والفروع كريمة","والبر حقا والحنان مؤكدا",9,"د",2,0],["للأم والابن وللبنت","أجل وكل من متَّ لنا بالنسبِ",10,"ب",1,1],["لِلأَرضِ يَومٌ وَالسَماءِ قِيامَةٌ","وَقِيامَةُ الوادي غَداةَ تُحَلِّقُ",11,"ق",1,0],["لِلأَروَعِ البُهلولِ ثابَ بِهِ النَدى","مِن كُلِّ أَروَعَ مِنهُمُ بُهلولِ",12,"ل",1,0],["لِلإِمامِ المُعتَزِّ بِاللَهِ إِعزا","زٌ مِنَ اللَهِ قاهِرِ السُلطانِ",13,"ن",1,0],["للأقاحي بفيكِ نَوْرٌ ونورُ","ما كذا تَسْنَحُ المهاةُ النّفُورُ",14,"ر",1,1],["للآنَ يُطرب سمعي في شواطئه","صدحُ الحمام وثغيُ الشاة والبقر",15,"ر",1,0],["للأناشيد ينشدون بصوتٍ","في النفوس الحرَّى لها تأثير",16,"ر",1,0],["للأَرض أَدوار وَلست بعارف","حَتّى مَتى تَتعاقب الأدوار",17,"ر",1,0],["للأنفس الظمأى إِليك التفات","ولهفةٌ ملءَ اللّحاظ الجياع",18,"ع",1,0],["للإلهِ العظيم من لُجِّه السا","كنِ أتلو الجميلَ من صلواتي",19,"ت",2,0],["لَلاقَتْ حقوقُ القَوْمِ حِلفَةَ باطلٍ","كما لاقَتِ الشَّجراءُ إحدى الصَّواعِقِ",20,"ق",1,0],["للأنف والعينين من","أزهاره طيفٌ وطيب",21,"ب",1,0],["للأمن شرطيِّ علي","هِ ساهر يحمي حماه",22,"ا",2,0],["للاستقامة في تقديره قبس","فظنه تحت نور الله ايقان",23,"ن",1,0],["للآن لمْ يُلغَ شبرٌ من مَزارعِهم","ولا تَزحزح مّمِا شيَّدوا حَجر",24,"ر",1,0],["للآنَ يُحتاجُ في إصلاحِ مملكةٍ","نظامُ دولةِ آشورٍ وكِلدان",25,"ن",1,0],["للأريحيَّةِ مَنْشاهُ ومَصْدرُهُ","وللشَّجاوةِ والإيناسِ حَدّاه",26,"ا",2,0],["للإمَامِ المُعْتَزّ بالله إعْزَا","رٌ مِنَ الله قاهِرِ السّلْطانِ",27,"ن",1,0],["للأقوياء شريعة مكتوبة","بالسيف شيب حلالها بحرامها",28,"م",3,0],["للاسد ضمن الفلاة غاب","تنبح اطرافه الكلاب",29,"ب",1,1],["للا رِقبةٍ جَورُ الزمان وعدلُهُ","وتحريجُه جارٍ على غير مقياسِ",30,"س",1,0],["لِلإِجازات وَالجَوائِزِ يُمنا","هُ وَبيضِ الظُبا وَسُمرِ الصِعادِ",31,"د",1,0],["للأديب اللبيب همّ بشانه","وانشغال بحاله في مكانه",32,"ن",2,1],["لِلأقحُوانِ عَلى مَلاحَتِهِ وَخزُ","بِقَلبٍ يَشتَكي العِشقا",33,"ق",2,1],["للأعين الخضرِ سحرٌ قاهرٌ خضعت","له الفواتك من صلّ وثعبان",34,"ن",1,0],["للاضطراب والاباء والحرف","والصوت أو للسير جاء كوجف",35,"ف",1,0],["للأعجمي وللفصيح على","الدقائق ترجمان",36,"ن",1,0],["للإنكليز وللفَرنسيسِ الوَرى","والأرضُ مِثلُ غنائمٍ وطرائد",37,"د",1,0],["لِلإمَامِ المُرْتَضَى مِما مَضى","خَلَفٌ يُولِيكَ عَيْشاً رَغَدا",38,"د",2,0],["لِلأَولِياءِ وِلاياتٌ بِها لَبِسوا ال","آلاتِ مِنهُ وَلِلأَعداءِ وَيلاتُ",39,"ت",1,0],["لِلأرضِ يرجعُ ما عَليها إنّما","هِيَ مستقرٌّ بعده مستودعُ",40,"ع",1,0],["لِلأَمنِ مِن شَرِّهِ في حالِ قُوَّتِهِ","أَحَلَّ أُمَّتَهُ في حَرزِ مِلَّتِهِ",41,"ه",1,0],["للأرض عندي عالم فاضل","وللسماء العالم الأفضل",42,"ل",1,0],["للأُمَّةِ الدَّهرَ يَسعَى والإمام معاً","سعْياً له العَبْدُ والمعبود قد شَكَرا",43,"ر",2,0],["للأهيَف الأغيَد والنَّفسُ ما","آلفَها للأهيفِ الأغيَدِ",44,"د",1,0],["للأمر بالمعروف منهم خنجر","يدمي وشتم معلن وسباب",45,"ب",1,0],["للإِمام العظيم ذي الأمر والنهي","قرين الإِسعاد والإِقبال",46,"ل",1,0],["للأصرمي المغاني","قد ألقت السمع قسرا",47,"ر",2,0],["للأعرَجينِ وإن بدَتْ شُرُفاتُه","لن يَبلُغا المِعشارَ من مِعراجِهِ",48,"ج",2,0],["للأقحوانة منها حسن مبسمها","وللشقائق منها الخد والخال",49,"ل",1,0],["لِلأرضِ شُهبٌ كالسَّما لا يَرتَجي","إلا الظَّلومُ المُستبِدُّ زَوالَها",50,"ل",3,1],["للإله الحق خالقنا","منجح المقصود والآمال",51,"ل",1,0],["للآبِ لاهوتُ ابنهِ وَكذا ابنُهُ","وكذا هما والرُّوحُ تحتَ تَقنُّمِ",52,"م",1,0]]}