s://www.poetsgate.com/ViewPoem.aspx?id=178990",""],[4830,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=193597",""],[4578,"خطرت لأعطاف المحاسن ثانية","https://www.poetsgate.com/ViewPoem.aspx?id=49618",""],[4929,"المعلم","https://www.poetsgate.com/ViewPoem.aspx?id=199256",""],[4929,"دردشة مع ابن زيدون","https://www.poetsgate.com/ViewPoem.aspx?id=202227",""],[5198,"نود الاشعار","https://www.poetsgate.com/ViewPoem.aspx?id=136094",""],[5219,"كن عاقلا ....","https://www.poetsgate.com/ViewPoem.aspx?id=195013",""],[5246,"زرت المنازل بعد بين أنيسها","https://www.poetsgate.com/ViewPoem.aspx?id=187060",""],[5324,"وللحمير حظوظ.","https://www.poetsgate.com/ViewPoem.aspx?id=212811",""],[5365,"في رثاء الشاعر العراقي عبد الرزاق عبد الواحد","https://www.poetsgate.com/ViewPoem.aspx?id=191061",""],[5381,"سُكنى الروح","https://www.poetsgate.com/ViewPoem.aspx?id=214673",""],[5431,"أتظنُ أنك من أنينك هالكُ","https://www.poetsgate.com/ViewPoem.aspx?id=195340",""],[5431,"للدار أنت مودِعٌ وموَدّعُ","https://www.poetsgate.com/ViewPoem.aspx?id=196999",""],[5431,"وتفيض في آباري العطشى...","https://www.poetsgate.com/ViewPoem.aspx?id=200190",""],[5493,"أنا التِي تزرعُ الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=197005",""],[5493,"الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=206881",""],[5561,"حبٌّ في زمن الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=192736",""],[5612,"عَنْتَرةُ وكأْسُ الهَوانْ","https://www.poetsgate.com/ViewPoem.aspx?id=179852",""],[5674,"نشيد هزاري","https://www.poetsgate.com/ViewPoem.aspx?id=200229",""],[5717,"وهل قرأت من كتاب النفس ما","https://www.poetsgate.com/ViewPoem.aspx?id=170602",""],[5725,"مالي ارى الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=215175",""],[5842,"أعُوذُ باللهِ / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=137108",""],[5861,"بلسان زوجة مغدورة","https://www.poetsgate.com/ViewPoem.aspx?id=190742",""],[2765,"برح الخفا ما الحق فيه خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=136825",""],[5956,"نورُ البحر","https://www.poetsgate.com/ViewPoem.aspx?id=183249",""],[5960,"بغدادُ أغلى انتماءاتي","https://www.poetsgate.com/ViewPoem.aspx?id=30808",""],[6052,"روضة الايمان","https://www.poetsgate.com/ViewPoem.aspx?id=35138",""],[6117,"بهوُ الجمَال","https://www.poetsgate.com/ViewPoem.aspx?id=182786",""],[6124,"ليل وموعد","https://www.poetsgate.com/ViewPoem.aspx?id=128746",""],[6147,"عقيم العمر ينتظر الجنين","https://www.poetsgate.com/ViewPoem.aspx?id=151501",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""],[6323,"زلزال الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82178&r=&rc=9",""]],"verses":[["تَسقي مَعالِمَ مِنكُمُ لَولا النَوى","لَم أَرمِها بِقِلىً وَلا بِصُدودِ",0,"د",1,0],["تَسْقِي مَدَارِجَهَا وَتُلْقَى دَرَّهَا","عَفْواً عَلَى الأَغْوَارِ وَالقِيعَانِ",1,"ن",1,0],["تَسْقِي عُيُونَ النَّاسِ شِبْهَ النَّدَى","مِنْ نُورِهَا الصَّافِي فَتَشْفِي الأُوَامْ",2,"م",1,0],["تُسقي إِذا عُجنَ مِن أَجيادِهِنَّ لَنا","عَوجَ الأَعِنَّةِ أَعناقَ العَناجيجِ",3,"ج",1,0],["تُسقى الصَريحَ فَما تَذوقُ كَرامَةً","حَدَّ الشِتاءِ لَدى القِبابِ مَديدا",4,"د",2,0],["تَسقي اِمتِياحاً نَدى المِسواكِ ريقَتَها","كَما تَضَمَّنَ ماءَ المُزنَةِ الرَصَفُ",5,"ف",1,0],["تسقط الطيرُ حيث تلتقطُ الح","بَّ وتغشى منازلَ الكرماء",6,"ا",2,0],["تسقي ثراك وليس ذاك بنافعي","لكن أغالط مهجتي وأداري",7,"ر",2,0],["تَسقي مَذانِبَ قَد زالَت عَصيفَتُها","حُدورُها مِن أَتِيِّ الماءِ مَطمومُ",8,"م",1,0],["تُسَقِّيني البَخيلَةُ كَأسَ صَدٍّ","وَتَمزُجها لِتَعليلي بِراحِ",9,"ح",1,0],["تَسقِى وتُسقَى من لعا","ب النحل أو طَلِّ الزهور",10,"ر",1,0],["تَسقي وَتُطعِمُ لا إِناؤُكَ ضائِقٌ","بِالوارِدينَ وَلا خُوّانُكَ يَنفُقُ",11,"ق",1,0],["تَسْقِيكَ كَأْسَ مُدامَةٍ مِنْ كَفِّها","وَرْدِيّةٍ ومُدامةً مِنْ ثَغْرِهَا",12,"ر",3,0],["تسقيهم فهي بهم برة","من لبن العذراء ما يحصر",13,"ر",1,0],["تَسقي المُلوكَ بِكَأسِ حَتفٍ مُرَّةٍ","وَلِتُلبِسَنَّكَ إِن بَقيتَ جَلالَها",14,"ل",3,0],["تسقيكَ شمسَ سلافةٍ عِنبِيّةٍ","طَلَعَتْ على فَلَكٍ من العُنّابِ",15,"ب",1,0],["تَسقطُ الجُردُ المَذَاكِي دونه","وتطير البيضُ مِلءَ المأزميْنْ",16,"ن",1,0],["تَسقُطَنَّ الأَمطارُ حَتّى تَثَنّى ال","نورُ وَاِبتَلَّ في جَناحِ الهَواءِ",17,"ا",2,0],["تَسقيكَ عَيناهُ مِثلَ راحَتِهِ","مِن شَغَفٍ في الفُؤادِ مَولوجِ",18,"ج",1,0],["تَسقيكَ مِن عَينِها خَمراً وَمِن يَدِها","خَمراً فَما لَكَ مِن سُكرَينِ مِن بُدِّ",19,"د",1,0],["تَسقيكَ مِن كَفٍّ لَها رَطبَةٍ","كَأَنَّها فِلقَةُ جُمّارِ",20,"ر",1,0],["تَسقيكَها كَفٌّ إِلَيكَ حَبيبَةٌ","لا بُدَّ إِن بَخِلَت وَإِن لَم تَبخَلِ",21,"ل",1,0],["تَسقي الضَجيعَ إِذا اِستَسقى بِذي أَشَرٍ","عَذبِ المَذاقَةِ بَعدَ النَومِ مِخمارِ",22,"ر",1,0],["تَسقونَهُم مِن حَليبِ الجَفنِ صافِيَةً","بِبارِدٍ كَحَليبِ الجَفنِ ما شيبا",23,"ب",2,0],["تَسقيك والأرْيَ الضريبَ ولو عَدَتْ","نَهْيَ الإلهِ لثَلّثَتْ بسُلافِ",24,"ف",1,0],["تسقي أُزَيْغِبَ تُرويه مُجاجتها","وذاك من ظَمْأةٍ من ظِمْئها شَرَبُ",25,"ب",1,0],["تسقسق لا أدري أحزناً على الدجى","وإمّا إلى ضوءِ الصّباح تطرُّبا",26,"ب",2,0],["تسقيه كأسًا حُلْوَة الطعم من","خمر الجنان الشَّبِمِ البارد",27,"د",1,0],["تسقيكَ كأسَ مدامةٍ من كفِّها","ورديَّةٍ ودامة من ثغرها",28,"ر",3,0],["تسقى الهموم إذا وردن حنانها","بمعطّر كالسلسبيل قراح",29,"ح",1,0],["تَسقي لَواحِظُهُ العُقول مُدامة","الصَحو مِنها لا يَزالُ محرّما",30,"م",2,0],["تَسقيكَ كأس مُدامةٍ من ثَغْرِها","ما الشّهْدُ ما السَّلسالُ ما الصهباءُ",31,"ا",2,0],["تسقى بعينيها المحب من الهوى","خمراً تراوحه بها وتباكر",32,"ر",1,0],["تَسقي السَحائبُ كُلَّ يَومٍ تُربهُ","وَملائِكُ الرَحمَنِ تَغشى لحدَهُ",33,"د",2,0],["تَسقيكَ أَجفانُهُ أَرِّخ بِادمُعِها","يا غُصنَ بانٍ لَواهُ البَينُ فَاِنكَسَرا",34,"ر",2,0],["تُسقى وَما زالَت تُذا","دُ عَنِ المَناهِلِ وَالمَشارِب",35,"ب",1,0],["تَسقي الأَقاليمَ الحَيا أَقلامُهُ","وَبِهِنَّ أَظفارُ الخُطوبِ تُقَلّمُ",36,"م",1,0],["تسقي الزعاق عدوها","ترضي الضعيف اذا غضب",37,"ب",1,0],["تسقى بِماءٍ قَطّ ما سُقيت بِهِ","إِلّا زَكَت أَصلاً وَطابَت مغرسا",38,"س",2,0],["تسقي يمينك للأحباب غيث ندى","وللرماح من الأعداء غيث دمِ",39,"م",1,0],["تسقيك والجيران حولك كلما","قشعت بدت أخرى عليك طلوعا",40,"ع",2,0],["تسقى أبا نصرٍ ثراك حميَّةً","للفضل إن ذُمَّ الحيا المفضولُ",41,"ل",1,0],["تَسقي الهَوى..يا رُبَّ عَوْسَجَةٍ بِهِ","بَقيَتْ طِوالَ حَياتِها تَخضَوضِرُ!",42,"ر",1,0],["تسقي المتيم بالسلاذ","فة إنها تنسي العقود",43,"د",1,0],["تسقي العقول سلافة لم تعتصر","من بابل أبداً ولا من عكبرى",44,"ر",2,0],["تسقّونه في كلّ يومٍ وليلةٍ","بلا ظمأٍ كأس العداوة والغدرِ",45,"ر",1,0],["تُسَقّى الهيامُ حولَهُ وهو ظامئٌ","فلا الوِرْدُ يُدنيهِ ولا هو يبرحُ",46,"ح",1,0],["تَسقِي ثَرَى أنطونِ طُعمةَ رحمةٌ","إذ كانَ في الدُّنيا يَرِقُّ ويَرحَمُ",47,"م",1,1],["تسقي المدامعُ بالدِّماءِ ضريحَها","سَحَراً ويغسِلُهُ السَّحابُ إذا هَمى",48,"م",2,0],["تَسقِي مدامُعنا ثراكَ فإنَّها","أصفَى وأفضلُ مِن مياهِ العُنصُرِ",49,"ر",1,0],["تَسقِي ببيروتَ المدامعُ دارَهُ","وثَراهُ في تَرْسيسَ يَسقيهِ النَّدَى",50,"د",2,0],["تسقي مدامعنا ثراها كلَّما","روَّت مراحم ربّها ذاك الثَرَى",51,"ر",2,0],["تسقي مدامعُها جوانبَ تربهِ","مثل السحابِ منظَّماً ومنثَّرا",52,"ر",2,0],["تَسقي الثرى فَمَتى لامَ العذولُ أَقُل","دَعها سمائيّةً تَجري عَلى قدرِ",53,"ر",1,0],["تسقي من الظّفرة الى ساحل الختم","وْعلى أبوظبي ودبي ربّي يقودها",54,"د",3,0],["تَسقيكَ مِن عَذبِ مَعناها الرّقيق طُلىً","أَحلى مِنَ الشّهدِ تُزري بِاِبنَةِ العنبِ",55,"ب",1,0],["تسقى البشام ندىً يجرى على بَرَدٍ","ما في مراكزِهِ جَذٌّ ولا وَرَقُ",56,"ق",1,0],["تسقي الصواديَ من خلاصة صفوه","والسيلُ منه على البرا منساح",57,"ح",1,0],["تُسْقَى بِأكْوَابِ النَّوَاعِرِ قَهْوَةً","مَمْزُوجُةً بِالشَّهْدِ وَالسَّلْسَالِ",58,"ل",1,0],["تسقى الجفون الراويات من الكرى","وتضن بالسُقيا على القرحان",59,"ن",1,0],["تسقى رذيَّينِ بالموماة قُوتُهما","فى ثُغرةِ النحرِ من أَعلى تراقيها",60,"ي",3,0],["تَسقيكَ في لَيلٍ شَبيهٍ بِفَرعِها","شَبيهاً بِعَينَيها وَشَكلاً بِخَدِّها",61,"ه",2,1],["تَسْقِي وَتُسْقَى الدِفِقَى ذِنَابُها","كَمْ مِنْ عِديً مَذْرُوبَة أَذْرابُها",62,"ب",3,0],["تسقى بماء واحد أشجارها","ونبعَةٌ واحدة قرارها",63,"ه",2,0],["تسقي مجاذيفها ماء وتنفضه","نفض العقاب جناحهيا من البلل",64,"ل",1,0],["تَسقي الغَمامَةُ قَطراً وَهو يُخجِلُها","إِذا سقى النَقد لِلمُحتاجِ في العَدَمِ",65,"م",1,0],["تسقي ببَرد ثَناياها مَلاثمَهُ","ما أودعتنا حُمياها من اللَّهَبِ",66,"ب",1,0],["تسقيك راحاتهم راحا معتّقَة","مما انتقى مالك في الفقه والعتقى",67,"ق",2,0],["تسقي القلوب بلحظها وَبلفظها","فَتَجود بالأَرواح وَالأَكياس",68,"س",1,0],["تسقي عذاب الهَوى كؤوساً","تدري فتصحي وَلَيسَ تدري",69,"ر",2,0],["تسقي العَليل علائلا يَزهو بها","وَرَسائِل رقمت بها كفّاها",70,"ا",3,0],["تسقي المحبة وَالبشرى أَحبتها","غبّاً وَتفهمهم فحوى مَعانيها",71,"ي",3,0],["تسقى ونسقيهم سَمَّاً على حنقٍ","مستأنفي الليل حتى أسفر السحر",72,"ر",1,0],["تسقي بنظر عيونها سقما كما","يسقى الخلائق قطبها وتفالها",73,"ل",3,0],["تسقي الفراخَ بافواهٍ جؤجؤها","أو جروَ حَنظَلَةٍ لم يعدُ راميها",74,"ي",3,0],["تسقيكَ من يدِها كوردةِ خدهِّا","صهباءَ دَنٍّ للخدودِ تُعَنْونُ",75,"ن",1,0],["تسقي إذا استْجدَى مَراشِفَ ثغرِها","ماءَ الغمامةِ ثغرَ عاشِقها الصَدِي",76,"د",2,0],["تَسْقي الخدودَ مآقينا وتزفر في ال","أحشاءِ من فَرَطِ التبريح نيرانُ",77,"ن",1,0],["تسقي العدا ماء الرَّدى قناته","في حيث نار الحرب في توقد",78,"د",1,0],["تسقي وطن لي بَهْ تفانيت","وِتخْضَرّ داره عِقب الآملاح",79,"ح",1,0],["تسقي من الظَّفره إلى شرقيِ السَّاد","يودٍ يعِمّ الحَضْر وَيّا البوادي",80,"د",2,0],["تُسقى مَنابِتُ وَردِها وَأَقاحِها","بِرَوائِحَ مِن عَبرَتَيّ غَوادي",81,"د",2,0],["تسقى الرحيق على الارائك والحشا","تشكو الحريق عليك بالأشجان",82,"ن",1,0],["تسقي الغمامُ بيومِ مَحل","عُدِمَ المَثيلَ فمن يُضاهيهِ بفَضلٍ أو بنبل",83,"ل",1,0],["تسقف ايليا الذي طار ذكره","يعطر طول الارض في النشر والعرضا",84,"ض",2,1],["تسقون من قد شئتم من مائكم","وأنا أموت بلوعتي وظمائي",85,"ي",1,0],["تُسقِطُ مَا زادَ بكلِّ راسِ","نِصفاً وَمَا يَنقُصُ فبالقياسِ",86,"س",1,0],["تسقينني خمراً واسقيك","بظل الزهر قرب الداليه",87,"ه",1,0],["تسقي ندامى كالنجوم غدوا","بيض الوجوه تخالها بردا",88,"د",2,0],["تسقي غضارتها رياً طراوتها","ماء الشباب الذي ما أن يزال طري",89,"ر",2,0],["تسقط الساعات من أعمارنا","والتواقيع صدى سقطتها",90,"ه",2,0],["تسقون من لحن الطبيعة صافيا","ونعب في متلوث الأقداح",91,"ح",1,0],["تسقى القبر لا صوب مزنة","شحيح بها صوب الحيا وضنين",92,"ن",1,0],["ت