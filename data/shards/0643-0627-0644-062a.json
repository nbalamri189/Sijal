{"poems":[[9,"ما تعيف اليوم في الطير الروح","https://www.aldiwan.net/poem21921.html","الرمل"],[74,"عطفت كأمثال القسي حواجبا","https://www.aldiwan.net/poem18230.html","الكامل"],[93,"بات والكأس في الظلام","https://www.aldiwan.net/poem62746.html","عموديه"],[87,"من صور السحر المبين عيونا","https://www.aldiwan.net/poem63011.html","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54236","المجتث"],[92,"تحية الحلة","https://www.poetsgate.com/ViewPoem.aspx?id=179146",""],[119,"بالله يا نديمي","https://www.aldiwan.net/poem40900.html","عموديه"],[132,"يا بتعة فاقت ببهجتها","https://www.aldiwan.net/poem50579.html","مجزوء الكامل"],[310,"فسحة العمر وإن طالت قصيره","https://www.aldiwan.net/poem56510.html","الرمل"],[369,"لمن الركائب سيرهن تهاد","https://www.aldiwan.net/poem60948.html","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119981","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56145","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46627",""],[1763,"","https://poetry.dctabudhabi.ae/diwan/poem/146062","الكامل"],[1845,"","https://poetry.dctabudhabi.ae/diwan/poem/132182","السريع"],[1997,"","https://poetry.dctabudhabi.ae/diwan/poem/202565","المتقارب"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71039","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27685","البسيط"],[2638,"","https://poetry.dctabudhabi.ae/diwan/poem/142151","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200744","البسيط"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115539","المنسرح"],[3003,"","https://poetry.dctabudhabi.ae/diwan/poem/126534","البسيط"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103964","السريع"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117965","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36263","الدوبيت"],[4530,"","https://poetry.dctabudhabi.ae/diwan/poem/20958","الرمل"],[4767,"العزيمة","https://www.poetsgate.com/ViewPoem.aspx?id=209008",""],[4862,"دجل الناي","https://www.poetsgate.com/ViewPoem.aspx?id=55608",""],[5186,"أبدا تعن عليكم الأرباح","https://www.poetsgate.com/ViewPoem.aspx?id=156526",""],[5275,"شهداء الخبزفي بلادي_جابر الشكرجي","https://www.poetsgate.com/ViewPoem.aspx?id=35816",""],[5277,"فمتى ستشرقُ يا سلامُ","https://www.poetsgate.com/ViewPoem.aspx?id=208712",""],[5809,"ترقيق","https://www.poetsgate.com/ViewPoem.aspx?id=205315",""],[5939,"منذ التقى يوليو ببرد يناير","https://www.poetsgate.com/ViewPoem.aspx?id=179997",""],[5952,"مَايا","https://www.poetsgate.com/ViewPoem.aspx?id=202877",""]],"verses":[["كَالتَماثيلِ عَلَيها حُلَلٌ","ما يُوارينَ بُطونَ المُكتَشَح",0,"ح",1,0],["كالتبرِ سيَّالاً فلا أدري بهِ","جفني المسهد سابكاً أم ساكِبا",1,"ب",2,0],["كَالتَماثيلِ حَولَهُ","مِن نُحاسٍ وَمِن رُخام",2,"م",1,0],["كَالتِبرِ أُفقاً وَالزَبَرجَدِ رَبوَةً","وَالمِسكِ تُرباً وَاللُجَينِ مَعينا",3,"ن",2,0],["كَالتبْرِ غَطَّاهُ تُرْبٌ","وَالدرِّ فِي الْبَحْرِ غَابا",4,"ب",2,0],["كالتْ ليَ الشَتْمَ ما شاءَت مكارمُها","سمحاءَ من دون تطفيف ونُقصان",5,"ن",1,0],["كالت له دموعي","صاع الهوى بصاع",6,"ع",1,0],["كالتبَّةِ الزرقاءِ في","بطنِ الوهادِ أوِ القلاعِ",7,"ع",1,0],["كالّتي لَم يَنسها مَضجَعها","في ثرى اللّحدِ حَشاياها الوَثيره",8,"ر",2,0],["كالتِّبرِ حين يَروقُ أَفناءَ الورى","وتَزيدُ قيمتُه لدى النُّقّاد",9,"د",1,0],["كالتفات الحبيب نحو محب","ونسيم الصبا وعهد التصابي",10,"ب",2,0],["كالتين منه ميبّسٌ ومدّبسٌ","أو كالذي يدعى بجني النحلةِ",11,"ه",1,0],["كالتعاويذِ والتصاويرِ ما في","هم من الناس غيرُ حُسنِ الشُّخوصِ",12,"ص",1,0],["كالتيس أصبح باحثاً عن مدية","بك لا بظبي بالصريمة أعفرا",13,"ر",2,0],["كالت لك الود بصاع الوفا","لم ذا أتى منك طروق احتمال",14,"ل",1,0],["كالتي في رمضان لم تصم","بلها منها وصامت رجبا",15,"ب",2,0],["كالتِّبْرِ لا يُقْنَي وفيه رذيلةٌ","تُزْري به في السَّومِ حين يُقَوَّمُ",16,"م",1,0],["كالتونسيّ ومن يجري بحلبته","من القلوبِ التي تعطي وتكتمه",17,"م",2,0],["كالتماع النجوم في حلك الليل","تهادى على الطريق منارا",18,"ر",2,0],["كالتّبر في التُرب يهوى كل مجتهد","والدرّ في البحر يهوى كل غوّاص",19,"ص",1,0],["كالتبرِ كلّ النفوس تعشقُها","وذاك سرُّ الإله في البَشَر",20,"ر",1,0],["كالتين تعلق بالاذواق مدحته","اقرأ فرائدها يا صاح واغتنم",21,"م",1,0],["كالتبر إن تمزج به فضة","جازت على كل فتى جاهل",22,"ل",1,0],["كالتستري وكالسري وكالجني","د الحبر والشبلي أو كالشاذلي",23,"ل",2,0],["كالتُربِ تُهنيني لِريحٍ رَكَدَت","ناري اِنطفأت وَماءُ وَجهي نَضَبا",24,"ب",2,0],["كالتَؤاميَّة إِن باشَرتَها","قَرَّت العَينُ وَطابَ المُضطَجَع",25,"ع",1,0],["كالت وما زالت تكيل شتائماً","مِمَّن على أهل السفينة يحقد",26,"د",1,0],["كالتيس أجرب قد أزرى الهزال به","أودت به رعدة من شاهق وعلِ",27,"ل",1,0],["\"كالتين \"\"ستفا\"\" والزبيب تكدسا، \"","وظهورها وبحورها مسطاح",28,"ح",1,0],["كالت راح ابوي ايجيب من السوك ْ","خبز ويريد كل البيت يتغده",29,"د",2,1],["كالتوأمان بكل عصرٍ فتنةٌ","تدمي الفؤادَ وليس ثمَّ عريفُ",30,"ف",1,0],["كالتبرِ أنفسُ معدنٍ","نوعاً واجملُها بريقا",31,"ق",2,0],["كالتائهَيْنِ قد التقينا مرةً","وعواصفٌ تَمحو سبيلَ العابرِ",32,"ر",1,0],["كالتي حازت عصاً سحريةً","أنقذتها عند يَمٍّ للمَنايا",33,"ا",3,0]]}