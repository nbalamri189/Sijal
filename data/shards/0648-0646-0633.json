96,"قد ظل يجرح صدري","https://www.aldiwan.net/poem53660.html","المجتث"],[397,"في أحضان الطبيعة","https://www.aldiwan.net/poem24309.html","عموديه"],[406,"غنت الورق فوق غصن البان","https://www.aldiwan.net/poem33370.html","الخفيف"],[406,"صدرت لإِهداء السلام","https://www.aldiwan.net/poem33429.html","مجزوء الكامل"],[406,"إليكم يا صفي الدين مني","https://www.aldiwan.net/poem33431.html","الوافر"],[406,"كم أقاسي في الهوى من شغل","https://www.aldiwan.net/poem33482.html","الرمل"],[406,"صبابة حلت وفرط وجد","https://www.aldiwan.net/poem33974.html","الرجز"],[406,"عسى توبة تمحى بها كل زلة","https://www.aldiwan.net/poem34112.html","الطويل"],[412,"قل للرجاء إليك قد","https://www.aldiwan.net/poem32001.html","مجزوء الكامل"],[419,"يا قبر محمود لا جازتك غادية","https://www.aldiwan.net/poem53903.html","البسيط"],[419,"أمن بعد الهمام القرم وادي","https://www.aldiwan.net/poem54153.html","الوافر"],[419,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[432,"فز برشف الانس من صافي سنا","https://www.aldiwan.net/poem41062.html","الرمل"],[432,"بلبل يشدو ويصدح","https://www.aldiwan.net/poem41415.html","مجزوء الرمل"],[435,"نضا عضبا من الجفن","https://www.aldiwan.net/poem12740.html","الهزج"],[437,"ونسي الحمد فما","https://www.aldiwan.net/poem25671.html","مجزوء الرجز"],[444,"بنفسي رسوم بين نفعي وغرب","https://www.aldiwan.net/poem14331.html","الطويل"],[444,"عزاء بني سمح فما قد لقي سمح","https://www.aldiwan.net/poem14443.html","الطويل"],[444,"نجمع والمجموع يكلا ويترك","https://www.aldiwan.net/poem14471.html","الطويل"],[446,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[446,"زرت لندن ربة المدن والشمس","https://www.aldiwan.net/poem55989.html","عموديه"],[450,"أعرفت ما ألقاه بعدك","https://www.aldiwan.net/poem53725.html","مجزوء الكامل"],[454,"حيا الصبا ونعيمه","https://www.aldiwan.net/poem13621.html","مجزوء الكامل"],[455,"رئيس العزف حين تشير تحيى","https://www.aldiwan.net/poem61720.html","الوافر"],[460,"ما على منجد رأى ما أهمه","https://www.aldiwan.net/poem55903.html","الخفيف"],[460,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[460,"لمن طالعات في السراب أفول","https://www.aldiwan.net/poem55924.html","الطويل"],[460,"ذكر العيش بالحمى فبكى له","https://www.aldiwan.net/poem55940.html","الخفيف"],[460,"ما كان سهما غار بل ظبي سنح","https://www.aldiwan.net/poem56256.html","الكامل"],[463,"راسي الحبى في سلمه ونديه","https://www.aldiwan.net/poem16423.html","الكامل"],[465,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[467,"يا وارف الظِّل","https://www.aldiwan.net/poem43684.html","عموديه"],[467,"قدمت وعفوك عن مقدمي","https://www.aldiwan.net/poem59035.html","عموديه"],[502,"لا تعنف مولها أحمديا","https://www.aldiwan.net/poem37649.html","الخفيف"],[502,"غنى الهزار على روض العرار بكم","https://www.aldiwan.net/poem37798.html","البسيط"],[502,"يا عيون النرجس الغض ألا","https://www.aldiwan.net/poem38029.html","الرمل"],[516,"كتم الهوى فوشى النحول بسره","https://www.aldiwan.net/poem20801.html","الكامل"],[516,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[517,"ردا أحاديث المنى وأعيدا","https://www.aldiwan.net/poem12092.html","الكامل"],[553,"أرأيت ما صنعت بنا الأيام","https://www.aldiwan.net/poem47248.html","الكامل"],[553,"خل من كان للجنادل جارا","https://www.aldiwan.net/poem47802.html","الخفيف"],[560,"عطشى العتيق من الجديد قد ارتوى","https://www.aldiwan.net/poem33582.html","الكامل"],[560,"إني أنا لست أنا","https://www.aldiwan.net/poem33847.html","مجزوء الرجز"],[560,"قضى الأمر وجف القلم","https://www.aldiwan.net/poem34195.html","الرمل"],[560,"رفعت ولم أرفع إلى غير منزلي","https://www.aldiwan.net/poem34215.html","الطويل"],[560,"هذه أثوابهم والحلل","https://www.aldiwan.net/poem34247.html","الرمل"],[560,"هلا غنيتم بما غنى به الوتر","https://www.aldiwan.net/poem34534.html","البسيط"],[560,"سلام عظيم من عظيم تفردا","https://www.aldiwan.net/poem34594.html","الطويل"],[575,"يا من لصبح الشيب كيف تنفسا","https://www.aldiwan.net/poem3649.html","الكامل"],[577,"لي في كل ساعة ألف قبله","https://www.aldiwan.net/poem2710.html","الخفيف"],[589,"تذكرت والذكرى تهيج البواكيا","https://www.aldiwan.net/poem11512.html","عموديه"],[651,"","https://poetry.dctabudhabi.ae/diwan/poem/216932","الخفيف"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/202201","الخفيف"],[1080,"","https://poetry.dctabudhabi.ae/diwan/poem/2571","الطويل"],[1123,"","https://poetry.dctabudhabi.ae/diwan/poem/58","الوافر"]],"verses":[["وَنَستَلِذُّ الأَماني وَهيَ مُروِيَةٌ","كَشارِبِ السُمِّ مَمزوجاً مَعَ العَسَلِ",0,"ل",1,0],["وَنَسرَحُ آمِنينَ وَلِلمَنايا","شَباً بَينَ الأَخامِصِ وَالنِعالِ",1,"ل",1,0],["ونَسْحَبُ أذيالَ السّوابِغِ والقَنا","شَوارِعُ والهَيجاءُ شتَّى دُعَاتُها",2,"ت",3,0],["وَنَسْأَلُ اللهَ فِي عُقْبَى نُسَرُّ بِهَا","فَقَدْ تَسَاوَى لَدَيْهِ السِّرُّ وَالْعَلَنُ",3,"ن",1,0],["وَنُسيحُ سَيَلانَ صَوبِهِ","وَهوَ تَسياحٌ مِنَ الراحِ مِسَح",4,"ح",1,0],["وَنَسينا ذِكرَ حِفني بَعدَهُ","وَدَفَنّا فَضلَهُ دَفنَ الغَريبِ",5,"ب",1,0],["وَنَسيتَ الآباءَ وَالمَجدَ وَالسُؤ","دُدَ وَالعِزَّ يا كَريمَ الجُدودِ",6,"د",1,0],["وَنَسيبٍ وَمِدحَةٍ وَهِجاءٍ","وَرِثاءٍ وَفِتنَةٍ وَضَلالِ",7,"ل",1,0],["وَنَسوا أَنَّ جودَ كَفِّكَ غَيثٌ","ظَلَّ لِلمُرتَجى الوُرودَ قَريبا",8,"ب",2,0],["وَنَسوا رَبَّهُم وَقالوا ضَمِنّا","بُعدَهُ عَن رِحابِ ذاكَ الجَنابِ",9,"ب",1,0],["ونساء بكل حسن وإحسا","ن شريف هن الغواني الحوالي",10,"ل",2,0],["ونسمانا شذاهم في إيابكما","فما بنا غير ملتاح وظمآن",11,"ن",1,0],["ونسألُ فتحاً للخليفةِ يوسفٍ","يُملّكُه أقصى البلاد ومن فيها",12,"ي",3,0],["ونستفرغ الأنعام ما في ضروعها","عشياً لتغدو والضروع حوافلُ",13,"ل",1,0],["ونسبتها صنهاجة غير أنها","تُقَصِّرُ عمَّا قد حوى خلفاؤها",14,"ا",3,0],["ونستَمطِر الأهوال حتى نُخيضكم","بسيل دم فوق البسيطة منصّب",15,"ب",1,0],["ونستنزف الدمع الغزير لتُربه","كما ستنزفت دمع المحبّين أطلال",16,"ل",1,0],["ونستشهد الدنيا على حسناته","وقد كثرت فيها عليها الشواهد",17,"د",1,0],["ونسلُك منها في مجاهل قفرة","فنخرج من قفر وندخل في قفر",18,"ر",1,0],["وَنَسيتَ أَعيَنَ وَالرَبابَ وَجارَكُم","وَنَوارَ حَيثُ تَصَلصَلَ الحِجلانِ",19,"ن",1,0],["ونسيانهم ما أشربوا من عداوة","إذا نسيت عُرج الضباع خُمالَها",20,"ه",2,1],["ونستخلفُ الأمواتُ غيرك كلَّهم","ونُعتَبُ لو كنا على الحق نُعتَبُ",21,"ب",1,0],["وَنَسوا وَصاةَ مُحَمَّدٍ في صِهرِهِ","وَتَبَدَّلوا بِالعِزِّ دارَ بَوارِ",22,"ر",1,0],["وَنَسيتَ فاحِشَةً أَتَيتِ بِها","يا هِندُ وَيحَكِ سُبَّةَ الدَهرِ",23,"ر",1,0],["ونسيم الصّبا على الأفقِ يُذكي","سحراً من مجامر الزهرِ ندَّا",24,"د",2,0],["ونسيمُ الريح يهدي لهما","نَفَحَاتِ الورد من تِلْكَ الفُسَحْ",25,"ح",1,0],["ونسيمُ الشَّمَالِ أهدى سُحيْراً","من شَذَا الزهرِ عَرْفَهُ الفيَّاحَا",26,"ح",2,0],["ونسيمهنّ وما مَسَسْ","نَ من العبيرِ معاً عبيرُ",27,"ر",1,0],["وَنَسيرُ بِالثَغرِ المَخوفِ فِجاجُهُ","بِسَلاهِبٍ جُردِ المُتونِ طِوالِ",28,"ل",1,0],["وَنَسهَرُ اللَيلَ لِغَيرِ الهَوى","ما تَنفَعُ اليَقَظَةُ وَالقَلبُ نام",29,"م",1,0],["وَنَسيمَهُ الساري كَأَنفاسِ الرِضى","وَشُعاعَهُ يَغشى المُروجَ فُتونا",30,"ن",2,0],["وَنَسيمُ الفَجرِ في أَشجارِها","وَشوَشاتٌ يُطرِبُ النَهرَ صَداها",31,"ا",3,0],["ونَسيماً ساحرَ الخطوَةِ","مَوْفُورَ الدَّلالْ",32,"ل",1,0],["ونسينا الحياة والموتَ والسُّكو","نَ وما فيهِ مِنْ مُنًى ومَنُونِ",33,"ن",1,0],["ونسُوكَ مِنْ دنياهُمُ حتَّى","كأَنْ لمْ يَعْرفوكْ",34,"ك",1,0],["ونسُوا وداعَةَ وجهكَ الهادي","ومنظَرَكَ الوسيمْ",34,"م",1,0],["ونسُوا تَغَنِّيكَ الجميلَ","بِصَوتكَ الحلوِ الرَّخيمْ",34,"م",1,0],["ونَسيمُ الصُّبْحِ يَسْري","سَجْسَجاً فَوقَ البِطاحِ",35,"ح",1,0],["ونسنّ رضوان الخليفة خطة","ولكل جيل خطة ومبادى",36,"د",2,0],["ونسيب تحاذر الغيد منه","شرك الحسن أو شباك الدلال",37,"ل",1,0],["ونُسأل ما جنى ماذا أساء","ليلقى عن جنايته الجزاء",38,"ا",2,0],["ونسقيها من الماء المصفّى","لدى التعطيش ما يشفي العليلا",39,"ل",2,0],["ونسلخ ظلها عنها برفق","يخفف من طبيعتها الثقيلا",39,"ل",2,0],["وَنُسَيَّةٌ لِبَني كُلَيبٍ عِندَهُم","مِثلُ الخَنافِسِ بَينَهُنَّ وِبارُ",40,"ر",1,0],["ونسالم الأيام وهي تدوسنا","بوقائع محمرة الآفاق",41,"ق",1,0],["ونَسألُ مِن مَعالِمها مُحِيلاً","فنطلُبُ من إجابِته مَحالا",42,"ل",2,0],["ونسألُ منه بارِعاً في سَماحَةٍ","فإنْ نحنُ أغفَلْنا السؤالَ تبرَّعا",43,"ع",2,0],["ونسيمٌ عطَّرَ الروضَ فإنْ","طارَ في الصُّبحِ ارتديناه عُطُر",44,"ر",1,0],["ونَسيبَ الحُسامِ أسْرَفَ في الجُو","دِ فَخِلناه للسَّحابِ نَسيبا",45,"ب",2,0],["وَنَسمو إِلى الدُنيا لِنَشرَبَ صَفواها","بِغَيرِ قُنوعٍ عَن قَذاها وَلا صَبرِ",46,"ر",1,0],["وَنَسيتَ ما لا بُدَّ مِن","هُ وَكانَ أَولى بِادِّكارِك",47,"ك",1,0],["وَنَسمَةُ الخَريفِ قَد تَأَرَّجَت","وَقَد صَفَت مِياهُهُ وَرَجَّجَت",48,"ت",1,0],["ونُسورٍ تَغتَدي أَحشاؤُها","مِن بَني الهَيجاءِ لِلقَتلى لُحود",49,"د",1,0],["وَنَسيتُ سوءَ فَعالِكُم نِسيانَكُم","آساسَكُم في كورَةِ البَشرودِ",50,"د",1,0],["وَنَسَيتِ الَّذي عَهِدتِ إِلَينا","في أُمورٍ خَلَونَ أَن تَعلَمينا",51,"ن",2,0],["وَنَسيتُ الَّذي جَمَعتُ مِنَ القَو","لِ لَدَيها وَغابَ عَنّي بَياني",52,"ن",2,0],["وَنَسري وَقَد قَرَّ لَيلُ السُرى","فَنَقبَسُ مِن نارِ ذاكَ الفَهَم",53,"م",1,0],["وَنَسَختَ ما كَتَبَ الَّذينَ تَقَدَّموا","مِن تُرُّهاتِ الكُتبِ وَالأَسفارِ",54,"ر",1,0],["وَنُسلِمُها إِلى الأَعداءِ طَوعاً","بِلا حَربٍ تُقامُ وَلا قِتالِ",55,"ل",1,0],["ونسيمٌ يداعبُ الدوحَ والبح","رَ شجيُّ الغناء عذْب المجون",56,"ن",1,0],["وَنَسَبٍ صَحيحٍ","يَنطُقُ عَنّي جَهرا",57,"ر",2,0],["وَنَستَرزِقُ اللَهَ تَمليكَهُ","وَنَستَعجِلُ الدَهرَ فيما نُحِب",58,"ب",1,0],["ونَسَبتُ فضلَ العالَمِينَ لفضلِهِ","فَنسَبتُ مِنهُ إِلى الكَثيرِ قَليلا",59,"ل",2,0],["وَنَسِيتَ ما لَمْ يُنْسَ مِنْ لَذَّاتِها","وَعَدَتْتَها مِنُ جُمْلَةِ الآثامِ",60,"م",1,0],["وَنَسيتَ قَولَكَ حينَ تَمزِجُها","فَتُريكَ مِثلَ كَواكِبِ النِسرِ",61,"ر",1,0],["وَنَسورُ لِلرُتبِ العُلا فَيَرُدُّنا","لِلقَدرِ صَرفُ نَوائِبٍ سَوّارُ",62,"ر",1,0],["وَنِساءٌ مّهورَةٌ في البَرايا","وَسَبايا سيقَت بِغَيرِ مُهورِ",63,"ر",1,0],["وَنَسيرُ لِلحَربِ العَوانِ إِذا بَدَت","حَتّى نَلُفَّ ضِرامَها بِضِرامِ",64,"م",1,0],["وَنسوا حقوقاً لا يَكو","ن بدونهنَّ العيش رغدا",65,"د",2,0],["ونَسْجُ دَاوُدَ مِنْ بِيضٍ مُضَاعَفَةٍ","مِنْ عَهْدِ عَادٍ وبَعْد الحَيِّ مِنْ إِرَمِ",66,"م",1,0],["ونِسْوَةُ عَامِرٍ وبَنِي سُلَيْمٍ","وأعْصُرَ مَا سُلِينَ ولاَ خَزينَا",67,"ن",2,0],["ونسيمُ الصباح يعبث بالغا","بِ ويثني ذوائبَ الأعشابِ",68,"ب",1,0],["ونسيمٌ معطَّرٌ خفقتْ في","هِ قلوبٌ ورفرفت أرواحُ",69,"ح",1,0],["ونسلُبُ ما رزِقُوا من حجىً","ونهدمُ ما رفعوا من قِبابْ",70,"ب",1,0],["ونسيتَ أنتَ وما نسيتُ وأنني","لأعيشُ بالذكرى لعلك ذاكري",71,"ر",2,0],["ونَسّتْ إليها المُرْعِفاتِ قَضِيّةٌ","فأُبْنَ وما فيهِنّ إلاّ النّسائِس",72,"س",1,0],["ونَسْتَشْفي بِسُؤرِ جَوادِ خَيْلٍ","قَدِمْتَ عليه إنْ خِفْنا الجُوَادا",73,"د",2,0],["ونَسِيتُ ما صَنعَ الهَوَى بتَنُوفَةٍ","عُقِمَ الجَديلُ بها وأعْقَبَ أخدَر",74,"ر",1,0],["وَنَستَولي عَلى العَقَباتِ إِلّا","كَمينَ الغَيبِ وَالقَدَرَ المُتاحا",75,"ح",2,0],["وَنَستَغفِرُ الرَحمَنُ مِن كُلِّ ما جَرى","وَيَرجِعُ مِنّا صالِحاً كُلُّ طالِحِ",76,"ح",1,0],["وَنَسِيمَاً إِذَا سَرَى ضَوَّعَ الآ","فَاقَ مِسْكَاً وَعَطَّرَ الْجَوَّ نَدَّا",77,"د",2,0],["وَنَسْمَةٌ كَشَمِيمِ الْخُلْدِ قَدْ حَمَلَتْ","رَيَّا الأَزَاهِيرِ مِنْ مِيثٍ وَأَجْرَاعِ",78,"ع",1,0],["وَنُسْوَةٌ خَيْرٍ بَدَّلتْ مِنْ نَعِيمِهَا","جَحِيماً فكَانتْ مِنْ مَلائِكةِ البِرِّ",79,"ر",1,0],["وَنَسْمعُ مِنْهُ فِي السُّكُونِ تَنَهُّداً","وَذَاكَ صَدَى أَنْفَاسِنَا فِي المَخَايِلِ",80,"ل",1,0],["وَنَسِيبٌ يَكادُ يَبْعَثُ فِينَا","مِنْ جَديدٍ كُثَيِّراً وَجَمِيلاَ",81,"ل",2,0],["ونَسْبَحُ في أنْهَارِ عَدْنٍ كأنَّما","سَرَائِرُنَا مِن مائِها المُتَدَفِّق",82,"ق",1,0],["ونسامُ في أرواحنا","فنبيعها بيع السماح",83,"ح",1,0],["ونسورٍ في الجوِّ تعصف بالنا","سِ وبالأرض عصفَ هُوجِ الرياح",84,"ح",1,0],["ونسينا في غمره البشر عهدا","أسود القلب أحمر السيف قاتم",85,"م",1,0],["ونسمّي لصّ الحياة شجاعا","ونسمّي عفّ اليدين جبانا",86,"ن",2,0],["ونسمّي بخل الرجال اقتصادا","والبراءات غفلة وطفوله",87,"ل",2,0],["ونسمّي شراسة الوحش طغيا","نا ووحشيّة الأناس بطوله",87,"ل",2,0],["ونسيت اللّقا وعفت التلاقي","والتصابي والحسن والحسناء",88,"ا",2,0],["وَنَسَمٍ قَوَاتِلٍ لِلدَّاءِ","يَشْفِينَ كُلَّ فَاقِدِ الشِّفَاءِ",89,"ا",2,0],["ونساء العراقِ تُمنعُ أن ترسمَ خطّاً","أَوْ تَقْرأَ الأسفارا",90,"ر",2,0],["ونسيم في أشجارها","وشوشات يطرب النهر صداها",91,"ا",3,0],["ونسيت أنت وما نسيت أنني","لأعيش بالذكرى...لعلك ذاكري !!!",92,"ر",2,0],["ونسهر من جفاكم باصطلام","وان