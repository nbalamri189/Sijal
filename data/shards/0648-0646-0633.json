ولنا","وللأهل والأولاد والخال والعم",171,"م",1,0],["ونسألك جنة الفردوس","وانجنا من عذاب النار",172,"ر",1,0],["ونسأل مولانا بمن بتوبة","علينا يبلغنا بها غاية السعد",173,"د",1,0],["وَنسلُهُم خيرُ فرعٍ","يَزهو بِهِ خيرُ نَجرِ",174,"ر",1,0],["ونسيم القرى المغازل أوفى","لعهود الهوى من الآدميّ",175,"ي",1,0],["ونسيم الصبا تلاعب في الرو","ض فعنها تلاعب الأغصان",176,"ن",1,0],["ونسيمها أهدى لنا","في طيه نشر الخزام",177,"م",1,0],["ونسأل عنكم البرق اليماني","إذا ما كان للبرق ابتسام",178,"م",1,0],["ونسيم الروض يحكي خلقه","ولقد أخطأت فاستغفر لي",179,"ل",2,0],["ونسمه مذ عبر بي سحراً","أهدت أريج عنبر وندِّ",180,"د",1,0],["ونسقيك خمراً عتقت من غباوة","فيا شربة غطَّتْ على كل فكرة",181,"ه",1,0],["ونسيبَ الوُدِّ لا نِسْ","بَةَ آباءٍ وعَمِّ",182,"م",1,0],["ونستظلُّ بحيث الدَّهر هاجرة","ولا ظلال بظلٍّ منك ممدود",183,"د",1,0],["ونسلو عن أحبتنا ولسنا","بملتقيين إلاَّ في المعاد",184,"د",1,0],["ونسَّمَتْ ريح الصبا عرارها","فهزّ عطفيه لها بانُ النقا",185,"ا",1,0],["ونسيمات الصفا في روضها","عن هناء وسرور قد روت",186,"ت",1,0],["ونسيم الشوق ينشي","من شذا الحب ويشرح",187,"ح",1,0],["ونستغرقُ في وصفِ ال","معالي وله نَعْني",188,"ن",2,0],["وَنَسِيَ الحَمدَ فَمَا","مَرَّت لَهُ عَلَى خَلَد",189,"د",1,1],["ونستمطر الأجفان ماء كأنه","لأطلالها ملقى سماك وعقرب",190,"ب",1,0],["ونسبح في لج الأَماني ودون ما","ترجى المنايا حيث لم ينجنا السبح",191,"ح",1,0],["ونسلك منهاجاً ولم ندر بالذي","إليه على العقبى من الحال يسلك",192,"ك",1,0],["ونسلك قد أودى وإنك بعدهم","تعود ولا أصل وفرع مشبك",192,"ك",1,0],["ونسوان بلا مال","ولا عون ولا مأوى",193,"ا",1,0],["ونسبي كل اسطول","ويعلو مجدنا الشعرى",193,"ا",1,0],["ونساء يعرضن في سوق فسق","ويبعن الأعراض بالأعراض",194,"ض",1,0],["ونسيت عهد مودّتي","وأنا الذي لم أنس عهدك",195,"ك",1,0],["ونسيمه اللَّدنُ العطِي","رُ يكاد يعْثَرُ في ردائه",196,"ا",3,0],["وَنسمعها مُغازَلةً وَنجوَى","وأطيافاً سَوَاهمَ راقصات",197,"ت",1,0],["ونَسبتَ الجبالَ وهو يدارِي","نسبةً مستدِقَّةً مسترِمَّهْ",198,"م",2,0],["ونسختَ لي بالجود كلَّ يد","وُضعت شريعتُها على البخلِ",199,"ل",1,0],["ونسأل عن ظمياء إلا يرا