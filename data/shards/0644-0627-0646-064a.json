,[5956,"حول الأوزان والحداثة","https://www.poetsgate.com/ViewPoem.aspx?id=186235",""],[5956,"مُكافأة من الله","https://www.poetsgate.com/ViewPoem.aspx?id=194053",""],[5956,"سأُفْصِح عن بعض وُدّي إليهِ","https://www.poetsgate.com/ViewPoem.aspx?id=194180",""],[5956,"بوساطة محمد عصفور","https://www.poetsgate.com/ViewPoem.aspx?id=205162",""],[5957,"لأني أحبكَ","https://www.poetsgate.com/ViewPoem.aspx?id=51200",""],[5957,"أحبكَ أكثر مما مضى","https://www.poetsgate.com/ViewPoem.aspx?id=119167",""],[5957,"عزة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=177510",""],[5966,"جريح الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=158860",""],[5969,"رَبيعُ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=198726",""],[5969,"حِداداً على روحي","https://www.poetsgate.com/ViewPoem.aspx?id=198800",""],[5988,"هديتي التحية للامام","https://www.poetsgate.com/ViewPoem.aspx?id=99724",""],[6003,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=200570",""],[6027,"دهاء أنثى","https://www.poetsgate.com/ViewPoem.aspx?id=198422",""],[6056,"كبش الفداء","https://www.poetsgate.com/ViewPoem.aspx?id=156713",""],[6088,"حسان","https://www.poetsgate.com/ViewPoem.aspx?id=207592",""],[6113,"موقف شيخ وقصيدة شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=26372",""],[6113,"لعبة الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=120905",""],[6125,"بكل نقيصةٍ في الحب جاؤوا","https://www.poetsgate.com/ViewPoem.aspx?id=209069",""],[6131,"نحَّاتُ نورٍ","https://www.poetsgate.com/ViewPoem.aspx?id=189270",""],[5014,"مفقودة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76222&r=&rc=18",""],[6189,"أحزان جديدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83596&r=&rc=63",""],[5355,"لأنِّي أُحِبُّك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87131&r=&rc=26",""],[6348,"أنثى وطريق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87164&r=&rc=0",""],[5567,"وكن روحي لتفنى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69067&r=&rc=6",""]],"verses":[["لِأَنّي ما تَحَيَّفَني زَمانٌ","فَأَحوَجَني الحُسامُ إِلى نَصيرِ",0,"ر",1,0],["لا نَيلُنا يُرجى وَلا أَضيافُنا","تُقرى وَلا نُدعى لدَفعِ مَخوفِ",1,"ف",1,0],["لأني أتيت الحظ من نحو بابه","فإن يك حرمانٌ فذاك على جَدِّي",2,"د",2,0],["لأني متى أتلفتُه احتجتُ حاجةً","تُذيل مصونَ العِرض في طلب القرضِ",3,"ض",1,0],["لأني على ثقة أنني","متى رمت رفدك لم يمتنع",4,"ع",1,0],["لأني أرى الناس قد خُبِّلوا","وأصبح زِيُّهُمُ من خلاف",5,"ف",1,0],["لِأَنّي كُلَّما رَفَّهتُ عَنهُ","طَرِبتُ كَأَنَّني رَفَّهتُ عَنّي",6,"ن",2,0],["لِأَنِّيَ أَدري أَنَّ لي مِنكَ جانِباً","سَيُسعِدُني طولَ الزَمانِ وَيُسعِفُ",7,"ف",1,0],["لِأَنّي كُلَّما فارَقتُ طَرفي","بَعيدٌ بَينَ جَفني وَالصَباحِ",8,"ح",1,0],["لِأَنّي سَأَلتُكَ رَدَّ الجَوابِ","وَلا تَعرِفُ الرَدَّ لِلسائِلِ",9,"ل",1,0],["لِأَنّي لا أَخونُ عُهودَ خِلٍّ","وَلَو حَفَّت بِيَ النُوَبُ الثِقالُ",10,"ل",1,0],["لِأَنِّيَ مِن أَهلِ اليَقينِ عَلى الوَفا","وَقَد يَحدُثُ التَغييرُ عِندَ ذَوي الشَكِّ",11,"ك",1,0],["لِأَنّي قَد حَلَلتُ حِمى مُلوكٍ","رُبوعُ عَبيدِهِم كَهفُ الطَريدِ",12,"د",1,0],["لِأَنّي رَأَيتُ العُربَ تَخفُرُ بِالعَصا","وَتَحمي إِذا ما أَمَّها مُستَجيرُها",13,"ر",3,0],["لِأَنّي فَعَلتُ وَما قُلتُ قَطُّ","وَأَنتَ تَقولُ وَلا تَفعَلُ",14,"ل",1,0],["لِأَني كُلَّما أَرسَ","لَ أَن إِيتِ أُمَنِّيهِ",15,"ي",2,0],["لِأَنّي رُمتُ قُبلَتَهُ","عَلى ميقاتِ غَفلَتِهِ",16,"ت",2,0],["لِأَنّي عالِمٌ أَن سَوفَ تَنأى","مَسافَةُ بَينِ جُثماني وَروحي",17,"ح",2,0],["لِأَنّي وَإِن كانَت مِنَ الناسِ واثِقٌ","لِنَفسِيَ مِنها بِالدَوامِ عَلى العَهدِ",18,"د",1,0],["لأني أحب كل طفله","أحب كل خصلة",19,"ه",1,0],["لأني استحليت أمسية","يردني عن درسه موجعا",20,"ع",2,0],["لأني رضِيعُ بَيانٍ وصَرفْ","أَجوعُ لِحرفٍ.. وأقتاتُ حرفْ",21,"ف",1,1],["لأَني وُلِدتُ ببابِ النُّحَاةِ","أَظَلُّ أُوَاصِلُ هَرْفًا بهَرفْ",21,"ف",1,0],["لأني ماني قادر اوادعك وأنت قريب","كيف وأنت بعيد تبغاني أقول الوداع",22,"ع",1,0],["لأني أطهر من بيخسر على الدنيا حبيب","ولأنك أنقى من وطت رجله ظهر وقاع",22,"ع",1,0],["لاني.؟ أعرف.. من يجيد.؟ الطلي فوق الوبر.؟","ولاني أعرف....؟ كيف أحجمك..؟ يالسمك.؟ الغليض..؟",23,"ض",1,0],["لأن يد القوم في أهلها","تسد على الغير باب الطلب",24,"ب",1,0],["لأني لاجٍ فيك واللَه شاهدي","وأنت الذي تعطي ولم ترهب الفقرا",25,"ر",2,0],["لأَنيَ بِالمُختارِ وَاللَهِ أَهتَدي","ثَنَيتُ إِلى مَدحِ النَبيِّ مُحَمَّدٍ",26,"د",1,0],["لأني قدِ ازدَدْتُ عمراً بِهِ","فيوميَ شهرٌ وشَهري سَنَه",27,"ه",1,0],["لأَنِّي إِنْ ضَلَّ الغَرِيمُ غَرِيمُهَا","وَإِنْ فُحِمَ الخُطَّابُ مِنْهَا خَطِيبُهَا",28,"ب",3,0],["لأني إنْ أطلتُ المدحَ جهدي","فبالتَّقْصيرِ آخرُه اعْترافِي",29,"ف",2,0],["لاني بحسن الظن بالله واثق","وما خاب من بالله قد احسن الظنا",30,"ن",2,0],["لِأَنّي لَم أَدرِ ماذا بِها","مِن العَذبِ يشبهُ محبوبَتي",31,"ي",1,0],["لِأَنّي لا أَمشي عَلى نَهجِ جاهِلٍ","يَسيرُ شَموخَ الأَنفِ في ظُلمَةِ الجَهلِ",32,"ل",1,0],["لأنّي يَسُرّ ارتياحي المُدام","ويَرضى خصالي عليها النَّديمُ",33,"م",1,0],["لأني ليس في طبعي انقِلابٌ","يُذَمُّ وليس في ودّي خِداع",34,"ع",1,0],["لأني إذا هنَّأته كنت في الذي","أهنيه كالمهدي إلى نفسِهِ الشكرا",35,"ر",2,0],["لأنّي بلوتُ الدهر ثم علمتُه","وجرّبتُ ما لم يَلْقَ قبلي مُجَرِّب",36,"ب",1,0],["لِأَنِّيَ حَيٌّ وَهَذا الَّذي","بَعَثتُم بِهِ بابَهُ المَيِّتِ",37,"ت",1,0],["لأني ما قرأتُ لهُ صحاحاً","ولا نحوا على الشيخ ابن بَرِّي",38,"ر",2,0],["لأني ما خلتُ أن القتي","ل يُوصي لقاتله بالدِّيَه",39,"ي",2,0],["لأني إذا جردت لحت لناظر","هلالاً وان صفحت كنت هلاكا",40,"ك",2,0],["لِأَنّي لَم أَجِد مصارعَ بابٍ","يَكونُ مِنَ السَحابِ إِلى التُرابِ",41,"ب",1,0],["لأني فيه قمت غير موجه","لدى فعله وجهي إلى وجه وجهتي",42,"ي",1,0],["لِأَنّي على البَيضاءِ أَوَّبتُ دونَهُم","إِلَيهِ وَفي الوَعساءِ عَنِّيَ أَدلَجوا",43,"ج",3,0],["لِأَنّي لَكَ لَم أَعدَ","م ما أَوجَدَني الوَجدُ",44,"د",1,0],["لِأَنّي في حَجرِ النُهى رُحتُ ناشِئاً","وَفي حِجرِ رِبّاتِ النُهى ضَمَّني القَمطُ",45,"ط",1,0],["لِأَنّي لَم أَجِد مِثلي كَتوماً","لِسِرِّكَ إِن رَأى الكِتمانَ حَقّا",46,"ق",2,0],["لِأَنّي مُذ تَأَتّى مِنهُ سَمعي","تَجَلّى عَنهُ طَرفي ما تَجَلّى",47,"ل",2,0],["لأنّيَ راحِلٌ عنكمْ برَغْمي","وسارٍ وهْو مُنحدِرٌ إليكم",48,"م",1,0],["لأن يومك سر المؤمنين كما","ساء الألى كفروا من غير ما بحث",49,"ث",1,0],["لأني في حمى خير البرايا","وخير مدافع عني وحام",50,"م",1,0],["لأنّي حييت إلى أن لقي","ت بعد العدو صديقاً حبيبا",51,"ب",2,0],["لأنِّي بحضرتك المستجير","وإنِّي بحبلك مستعصم",52,"م",1,0],["لِأَنّي أَخو النَفسِ الَّتي تَحمِلُ الطَوى","أَخَفَّ عَلَيها مِن سُؤالِ بَخيلِ",53,"ل",1,0],["لِأَنّي لَستُ آمُلُ بُقياً","وَهَل يَبقى عَلى القَمَرِ المَحاقُ",54,"ق",1,0],["لِأَنّي المَرءُ لَيسَ لَهُ اِعتِمادٌ","عَلى غَيرِ العَزائِمِ وَالمَساعي",55,"ع",2,0],["لِأَنِّيَ لَمّا صُغتُهُ وَنَظَمتُهُ","مَدَحتُ بِهِ مَن ما خَلا قَطُّ مِن سَبّي",56,"ب",2,0],["لِأَنّي لَم أَزَل مُذ كُنتُ مِمَّن","يُزَلَّلُ مِن وَلائِمِهِ الرَجاءُ",57,"ا",2,0],["لأني تفيّأت تلك الظلال","ولا زلت عنها بشعري أذود",58,"د",1,0],["لِأَنّي لاخشى مِن قَلاص اِبن مُحرِز","إذا وَخدت بِالدَوّ وَخُذ النَعائِم",59,"م",1,1],["لأَنّي رَجَوْتُ الْكَريمَ الّذِي","يُجيبُ كَما وَعَدَ السّائِلِينا",60,"ن",2,0],["لأني وفي إن صفى لي وان جفى","حرام على قلبي الجفاء الذي يعنى",61,"ن",2,0],["لأَنِّي مصونُ العِرْضِ منتَهبُ الغِنى","وأَنِّي مَوْلَى حُسَّدِي عِنْدَ ضِيفَاني",62,"ن",2,0],["لأنّي رَأيتُ الموتَ أكبَرَ سِربِه","عِذابُ الثَّنايا الرُّوقِ دُونَ المَقارِفِ",63,"ف",1,0],["لِأَني مِن الآداب أَدركت بغيتي","بِثاقب فكر وَاجتهاد يصاحبه",64,"ب",2,0],["لِأَني عَزيز في بِلادي مقرّب","وَلي أَذعنت بِالسَبق فيها الأَجانب",65,"ب",1,0],["لِأَنِّيَ لَم أَفخَر بِنَشر فضائلٍ","لعرفانه المَولى زَعيم عصام",66,"م",1,0],["لا نيلكم عن مجاريه بمنصرف","يوماً ولا الهرم العالي بمهدود",67,"د",1,0],["لأني رأيت الشر فيها معززاً","قوياً لدى أبنائها متماديا",68,"ي",2,0],["لأنّي إِذا سُومحتُ عبدُ مسامحي","ولكنْ إذا مونعتُ مَوْلَى مُمانعي",69,"ع",2,0],["لأني اقترفْتَ ذنوباً عظاماً","وقد كنتُ في ملَّة الجاهلينا",70,"ن",2,0],["لأني ومَنْ أهواه جسم وروحه","وهل يكره الجسمُ الصحيحُ حياتَه",71,"ه",1,0],["لأَنِّي فَقِيرٌ لِلشَّفَاعَةِ أَشْحَذُ","نَبيٌّ تَسَامى فِي الأْنَامِ بِمَجْدهِ",72,"ه",1,0],["لأني منك في نسب قريب","فدع نسب القريض وأنت مني",73,"ن",2,0],["لأنّي يا مخطّفة الحشا في","هواكِ لبايعٌ أبداً وشارِ",74,"ر",1,0],["لأني غريبٌ فؤادي حَريبٌ","عليه الليا