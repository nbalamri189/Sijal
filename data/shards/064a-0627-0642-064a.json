{"poems":[[3,"جازت مُلمات الزمان حدوده","https://www.aldiwan.net/poem147.html",""],[3,"يا صاحبي لا تبك ربعاَ قد خل","https://www.aldiwan.net/poem198.html",""],[87,"اجعل رثاءك للرجال جزاء","https://www.aldiwan.net/poem62936.html","الكامل"],[30,"أنا ابن خندف والحامي حقيقتها","https://www.aldiwan.net/poem5096.html","البسيط"],[107,"قل للألى رقدوا والعدل يقظان","https://www.aldiwan.net/poem42055.html","البسيط"],[107,"هم سادة الحرب من شيب وشبان","https://www.aldiwan.net/poem43573.html","البسيط"],[17,"لم يقض من حاجة الصبا أربا","https://www.aldiwan.net/poem1189.html",""],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9968","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9915","الكامل"],[92,"الشهيد قيس","https://www.poetsgate.com/ViewPoem.aspx?id=179228",""],[214,"ما كنت أدري قبل نبت العذار","https://www.aldiwan.net/poem13361.html","السريع"],[214,"ليهنك العود نحو الأهل والوطن","https://www.aldiwan.net/poem13515.html","البسيط"],[500,"ويحك ما أغراك بالحاضره","https://www.aldiwan.net/poem9879.html","السريع"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48563","الكامل"],[1177,"","https://poetry.dctabudhabi.ae/diwan/poem/28345","الرجز"],[1610,"","https://poetry.dctabudhabi.ae/diwan/poem/115012","البسيط"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114043","البسيط"],[2089,"","https://poetry.dctabudhabi.ae/diwan/poem/28821","الرجز"],[2346,"","https://poetry.dctabudhabi.ae/diwan/poem/18012","المنسرح"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26214","الكامل"],[3426,"","https://poetry.dctabudhabi.ae/diwan/poem/21220","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111422","الخفيف"],[4767,"لا عودة","https://www.poetsgate.com/ViewPoem.aspx?id=190159",""],[4862,"هجير الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=55375",""],[4935,"حسن المطالع في صفاء براعة","https://www.poetsgate.com/ViewPoem.aspx?id=129288",""],[5038,"البضعة الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=196622",""],[5136,"يا ملك العترة الزكية يا","https://www.poetsgate.com/ViewPoem.aspx?id=121602",""],[5431,"ياقيسُ ليلاكَ قد عادت بلوعتها","https://www.poetsgate.com/ViewPoem.aspx?id=186644",""],[5459,"ليلاكَ ليلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=203504",""],[5573,"أشعلت لي في داجر الليل مصباح","https://www.poetsgate.com/ViewPoem.aspx?id=200076",""],[6145,"من نحن ؟","https://www.poetsgate.com/ViewPoem.aspx?id=7794",""],[6237,"سوزان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77873&r=&rc=15",""]],"verses":[["يا قَيسُ إِنَّ صُدورَنا وَقَدَت بِه","نارٌ بِأَضلُعِنا تَشُبُّ وَقودَها",0,"د",3,0],["يا قَيسُ أَنتَ تَعُدُّ نَفسَكَ سَيِّد","وَأَبوكَ أَعرِفُهُ أَجَلَّ وَأَفضَلا",1,"ل",2,0],["يا قَيِّمَ الدارِ الَّتي قَد أَخرَجَت","لِلمُدلِجينَ مَنارَةً زَهراءَ",2,"ا",2,0],["يا قَيسَ عَيلانَ إِنّي كُنتُ قُلتُ لَكُم","يا قَيسَ عَيلانَ أَن لا تُسرِعوا الضَجَرا",3,"ر",2,0],["يا قيسُ ويَحكَ ليلى عنك في شُغُلٍ","وأنت يا قيسُ صَبُّ القلب ولهانُ",4,"ن",1,0],["يا قيسُ إنّ رسولَ اللهِ شاهِدُهُ","فَعَدِّ نَفسَكَ عن وصفٍ وتبيانِ",5,"ن",1,0],["يا قَيسُ إِنَّ الأَحسابَ أَحرَزَها","مَن كانَ يَغشى الذَوائِبَ القُضُبا",6,"ب",2,0],["يا قَيسُ أَنتَ تَعُدُّ نَفسَكَ سَيِّداً","وَأَبوكَ أَعرِفُهُ أَجَلَّ وَأَفضَلا",7,"ل",2,0],["يا قَيسُ إِنَّ صُدورَنا وَقَدَت بِها","نارٌ بِأَضلُعِنا تَشُبُّ وَقودَها",8,"د",3,0],["يا قيسُ : يا لُطفَ الربيعِ","ووقدَ رَونقه الشَبُوبِ",9,"ب",1,1],["يا قيس : يا همسَ الحبيب يذوب","في سَمع الحبيب",9,"ب",1,0],["يا قيس : يا هَزَج الرُعاة يَشيعُ","في الحقل الخَصيب",9,"ب",1,0],["يا قيس : يا شَجْوَ \" الهزار \"","يُهيبُ بالغصن الرطيب",9,"ب",1,0],["يا قيس : يا حُلُمَ \" العذاري \"","يزدَحِمْنَ على \" القَليب \"",9,"ب",1,0],["يا قيس : يا ذَوْبَ \" الغَضارة \"","قُطِّرت بأرَقِّ كُوب",9,"ب",1,0],["يا قيس : يا لَحْنَ الحياة","ونغمةَ الأمَلِ الرَتيب",9,"ب",1,0],["يا قيس : يا لمحَ السَنا","يا قيسُ : يا نفْحَ الطُيُوب",9,"ب",1,0],["يا قيس : هل تَدري بما","خلَّفتَ بعدَك من نُدوب",9,"ب",1,0],["يا قيسُ أُمُّك لا تزالُ","تعيشُ بالأمَل الكَذوب",9,"ب",1,0],["يا قيسُ : يا رمزَ الشهادةِ","عُطِّرت بدَمٍ خَضيب",9,"ب",1,0],["يا قيسُ : يا قيسُ الملوِّح","في شبابك بالحُروب",9,"ب",1,0],["يا قينة العشق اذا ما رنا","ومال تيها فالفرار الفرار",10,"ر",1,0],["يا قيس في الرأي قد فقت الانام ولا","ند بضاهيك في شام ولا يمن",11,"ن",1,0],["يا قيمتي من غبَن ظاهر","وسومها من صفقة خاسره",12,"ه",1,0],["يا قيصر الألمان أدركنا فقد","آلت كريد إلى الفتى اليوناني",13,"ن",2,0],["يا قَيس عيلان أَصَبتُم فُرصَتي","وَما أُبالي إِن أَتَت مَنيتي",14,"ت",2,0],["يا قيسَ عَيلانَ قيسَ الذُّل إنّكُمُ","في الحرب سيّانِ أنتُم والعصافيرُ",15,"ر",1,1],["يا قيروان لك العلياء والشان","لقد غدا فيك سادات وأعيانُ",16,"ن",1,1],["يا قَيِّمَ الدينِ أَقِمنا نَستَقِمْ","فَإِن أُصادِف مَأثَماً فَلَم أَلَمْ",17,"م",1,0],["يا قَيسُ أَنتُم شِرارُ قَومِكُمُ","قِدماً وَأَنتُم أَغَثُّهُم نَسَبا",18,"ب",2,1],["يا قَيسُ إِنَّ الأَسلابَ أَحرَزَها","مَن كانَ يُغشي الذَوائِبَ القُضُبا",18,"ب",2,0],["يا قَيرَوانَ وَدِدتُ أَنّي طائِرٌ","فَأَراكِ رُؤيَةَ باحِثٍ مُتَأَمِّلِ",19,"ل",1,1],["يا قَيسُ أَرسِل أَسيراً مِن بَني جُشَمٍ","إِنّي بِكُلِّ الَّذي تَأتي بِهِ جازي",20,"ز",2,1],["يا قِيانَ الأُولِمبِ لي قُلنَ مَن كا","نَ بِذَاكَ الوَغى رُؤُوساً وجُندا",21,"د",2,1],["يا (قيس) صدقتَ فنخوتنا","ماتتْ من زمنٍ في المنبع",22,"ع",1,0],["يا قيود القهر في معصمه","بينما أيدي الردى لفت حريرا",23,"ر",2,0],["يا قيم الدين الحنيف وجامع","شمل الأنام ومقتف للملة",24,"ه",1,0],["يا قَيلَةٌ أَيْنَ الْعُهودُ وَبَيعَةٌ","يَومَ الْغَديرِ وَسُورَةِ الْإِسْراءِ",25,"ا",2,0],["يا قيس يا قيس لا غلطت فلا","قيس شبيه له ولا قس",26,"س",1,0],["ياقيسُ ليلاكَ قد عادت بلوعتها","كم هدها البعدُ والأشواق والأرقُ",27,"ق",1,0],["يَا قيسُ لَوْ عَاصرتَنَا","والسُّخفُ ثَارَ عجاجهُ..",28,"ج",2,0],["ياقيس قلبي لو تولاه جراح","شاف الغزل منهو يدير الشهارق",29,"ق",1,0],["يا قَينقاعُ ويا نَضيرُ تَأَهّبوا","أُسْدُ الجَزيرةِ للوَغى تتقدّمُ",30,"م",1,0],["يا قيس ليلى هذه نغمة","من قيس (سوزان) وهذا شَبهْ",31,"ب",2,0]]}