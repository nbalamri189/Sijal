{"poems":[[91,"انت في شعر كان فتحا مبينا","https://www.aldiwan.net/poem44626.html","الخفيف"],[91,"أنا لولا الرحمن والعفو منه","https://www.aldiwan.net/poem45102.html","الخفيف"],[47,"لأخي الحب عبرة ما تجف","https://www.aldiwan.net/poem65151.html","الخفيف"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85861","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[91,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[168,"إنما فازت قداح المنايا","https://www.aldiwan.net/poem67815.html","المديد"],[226,"صمدت للعظات هذي الطلول","https://www.aldiwan.net/poem55287.html","الطويل"],[399,"أجراس سوداء","https://www.aldiwan.net/poem17746.html","عموديه"],[458,"يا رذاذ الربيع يا معلن اليقظة","https://www.aldiwan.net/poem61337.html","الخفيف"],[738,"","https://poetry.dctabudhabi.ae/diwan/poem/147209","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38209","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38937","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62453","الرمل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80179","الرمل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115895","الرمل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95571","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74092","الخفيف"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86291","الرمل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76446","الرمل"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102011","الرمل"],[5136,"شرف باذخ رفيع منيف","https://www.poetsgate.com/ViewPoem.aspx?id=121621",""],[5725,"يا عراق فقل لصبرك زدني","https://www.poetsgate.com/ViewPoem.aspx?id=211338",""],[5732,"ان دك به هاجوس","https://www.poetsgate.com/ViewPoem.aspx?id=177916",""],[5952,"عاشوا","https://www.poetsgate.com/ViewPoem.aspx?id=211568",""],[5956,"نحن أرواح","https://www.poetsgate.com/ViewPoem.aspx?id=182625",""],[5956,"أنا وشقيقي والحمامة","https://www.poetsgate.com/ViewPoem.aspx?id=184560",""],[5956,"أنا أرتينُ المُشاغِبْ","https://www.poetsgate.com/ViewPoem.aspx?id=205157",""]],"verses":[["انما في الشعر الحقيقة اصل","والخيالات كلها اثواب",0,"ب",1,0],["إنما في سلاسل ذرعها سبعون","أمشي رسفا وفي أقياد",1,"د",1,0],["إِنَّما فُوِّضَ التَخَيُّرُ في الحُك","مِ إِلَيهِم لِيَصفَحوا أَو لِيَعفوا",2,"ف",3,0],["إنما فضلُكَ الزَّمَانُ وآيا","تُكَ فيما نَعُدُّهُ الآناءُ",3,"ا",2,0],["إنما فكرة","من الجهل تنجم",4,"م",1,0],["إنما في اقتناء حورٍ حسانٍ","بصلاةٍ تجارةٌ لا تبورُ",5,"ر",1,0],["إنما في الحجاب شلٌّ لشعبٍ","وخفاءٌ وفي السفور ظهور",5,"ر",1,0],["إنما في الدارين عسفٌ وحيفٌ","غير أنَّ السماءَ ليست تمور",5,"ر",1,0],["إنما فازَ في الجهاد من النا","س بآماله الكبار الكبير",5,"ر",1,0],["إنما في الحياة جمع لما ش","ت وفي الموت للجميع شتات",6,"ت",1,0],["إنما في الهواء طلقاً لمن يحي","ا وفي نور الشمس عيش رغيد",6,"د",1,0],["إِنَّما فازَت قِداحُ المَنايا","يَومَ حازَت خَصلَها بِتَنوفا",7,"ف",2,1],["إن ما فات لا يعود كمن ما","ت وطول الكلام عنه فضول",8,"ل",1,0],["أن ما في الكؤوس يوشكُ أن ين","ضبَ إلا من حفنةٍ من همومِ",9,"م",1,0],["أنَّ ما في العيونِ من عَطش الأح","لامِ أمسى رمادَ حبٍّ قديم",9,"م",1,0],["إنما فهفمها لمن أشعروا الكون","جمالا وأشعروا قلب راحم",10,"م",1,0],["إنما فوك فقحة كل وقت","تتصدى الأنوف كالنشاب",11,"ب",1,0],["إِنّما في حُسنِهِ الباهي البَديعْ","ظَلّ يَحلو مِن نَشيبٍ غَزلي",12,"ي",1,0],["إِنّما فَخرُهُ بِعِلمٍ وَحِلم","وَبِعدلٍ في القاصي ثمّ الدّاني",13,"ن",2,0],["إنما فيصل بحرٌ","فاض في كل الجهات",14,"ت",1,0],["إِنَّما فِكري لَهُ في قَطعِها","حَرَكاتٌ يَسبُقُ البَرقَ سَراها",15,"ا",3,0],["إنّما فرقةُ مَن أعشقُهُ","دُونها فُرقَةُ روحى والجسد",16,"د",1,0],["إن ما فيك من رجاحة مجد","يُعجز القول عن نداك المبينِ",17,"ن",1,0],["إنما فتح مكة بيديه","لم يكن من أموره أسناها",18,"ا",3,0],["إِنَّ ما فاتَ كانَ ضَنكاً وَضيقاً","فَعَسى فرجة بِما هُوَ آتِ",19,"ت",1,0],["اِنَّما في العَدلِ أَمنٌ لِلوَرى","حَيثُ يَرعى الذِئبُ فيهِ وَالحَمل",20,"ل",1,0],["انما في الروح يَشكو أَلَما","واعتلال الروح ذو قال وَقيل",21,"ل",1,0],["إنما فرط الهوى دللها","فغدت تزهو بأثواب الدلال",22,"ل",1,0],["إنما فعله جزاء وفاقاً","عن خلوص في نصره لا يريف",23,"ف",1,0],["إن مافيك للمكارم روحاً","تجعل السيف للطريد أمينا",24,"ن",2,0],["ان ما فزعت لغالي الروح تفداك","اكبر خطر هجم علي ومسكها",25,"ك",3,0],["إنّ ما في يدنا . في يدهم","فاهتفي \"عاشوا\" و\"فلْيحيوا كراما\"",26,"م",2,0],["إنما في العمق أُجري","بعدَ أن يجري الزّواجْ",27,"ج",1,0],["إنَّما في ذاتِ يومٍ شئْتُ ألهو","قلتُ: يا (فاروق) حَدّقْ بالحمامةْ",28,"م",2,0],["إنما في دار جَدِّي","لا أرى لي أيَّ جاذبْ",29,"ب",1,0]]}