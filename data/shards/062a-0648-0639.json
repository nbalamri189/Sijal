{"poems":[[53,"ألا بكرت حرى الملام تسعر","https://www.aldiwan.net/poem62892.html","السريع"],[53,"أبا العباسِ عمرت","https://www.aldiwan.net/poem66081.html","الهزج"],[91,"أعاشر قوما عندهم لي عداوة","https://www.aldiwan.net/poem45081.html","الطويل"],[64,"توعدني في حب آل محمد","https://www.aldiwan.net/poem52388.html","الطويل"],[47,"توعدني شيبان بغيا وما","https://www.aldiwan.net/poem66845.html","البسيط"],[63,"تلاف السهم أثبت في الشغاف","https://www.aldiwan.net/poem51548.html","الوافر"],[63,"أناشد دهري أن يعود كما بدا","https://www.aldiwan.net/poem51709.html","الطويل"],[52,"توعدني أبو خلف","https://www.aldiwan.net/poem62249.html","مجزوء الوافر"],[369,"أساير ركب الجو وهو كواكب","https://www.aldiwan.net/poem60997.html","الطويل"],[463,"مالك لا تطرب يا حادي النعم","https://www.aldiwan.net/poem55901.html","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48769","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96634","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79876","المتقارب"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125471","الوافر"],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/138001",""],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74079","المنسرح"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206137","البسيط"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35560","السريع"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125841","المتقارب"],[4217,"","https://poetry.dctabudhabi.ae/diwan/poem/123951","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33362","الوافر"],[5288,"الزمان غروب","https://www.poetsgate.com/ViewPoem.aspx?id=1152",""],[5582,"أَهذا الَّذِي تَحْتَ النِّقابِ هُوَ الخَدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=63487",""],[5829,"ودائرة على الباغي تدور","https://www.poetsgate.com/ViewPoem.aspx?id=148335",""],[6035,"كذبة يوم القدس .. !","https://www.poetsgate.com/ViewPoem.aspx?id=175126",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"]],"verses":[["توعّدُني بالشيب أنْ قد أظلني","وما ذكَّرتني غير ما كنت أذكر",0,"ر",1,0],["توعَّدتُ بك الدهر","فأعطى بيد السلمِ",1,"م",1,0],["توعدني بالقتل قوم وإنما","لكل امرئ في الموت يوم وميقات",2,"ت",1,0],["توعَّدَنِي في حُبِّ آلِ محمَّدٍ","وحبِّ ابنِ فضلِ اللّه قومٌ فأكثروا",3,"ر",3,1],["توعِدُني شَيبانُ بَغياً وَما","تَعلَمُ مَن توعِدُ شَيبانُ",4,"ن",1,1],["توعَّرَ نَهْجُها بك وهو سَهلٌ","وَكُدِّرَ وِرْدُها بك وهو صافي",5,"ف",2,0],["توعَّدَني من بَعْدِ ما وَعَدَ الغِنى","فأنجزَ إبعاداً وأخلَفَ مَوعِدا",6,"د",2,0],["تَوَعَّدَني أَبو خَلَفٍ","وَعَن أَوتارِهِ ناما",7,"م",2,1],["تَوعّدني الغيرانُ بالموتِ دونكم","وتلك الأماني يا أُميمَ الكواذِب",8,"ب",1,0],["تَوَعَّدَ اللوّامَ في الجود فلو","جادَ بما خلف الضلوع لم يُلَمْ",9,"م",1,0],["توعَّدوا بانتقاضٍ أو بمؤتمر","فهل مضى يوم تأديب المحاماة",10,"ه",1,0],["توعّدهم في البعدِ حتّى أَتاهمُ","وَلم يثنهِ عَن وطء أرضهم البعدُ",11,"د",1,0],["توعَّدَني زمني بالظما","وفي زعمِه أنَّني أضجرُ",12,"ر",1,0],["توعدتَ الحبيبةَ بانتقامٍ","وظلماً قد حملتَ على الحبيبِ",13,"ب",1,0],["توعد بمبناها وعادك وليد","واليوم ذي اخسر وعيده",14,"د",2,0],["توعّدني باللّقا وأحسبها","تنجز يوم الحِساب موعدها",15,"د",3,0],["توعدوني بإعنات وقد صدقوا","قد يُعنت النمل أعضاد الأشداء",16,"ا",2,0],["تَوَعّدوني بِوَشك بَينهم","وَالبين يَمحو الرَجاءَ بِاليَأسِ",17,"س",1,0],["توعدتم مربعا والعدى","من الهزءِ بالضَّحِكِ استغرقوا",18,"ق",3,0],["توعرت سُبلي عن توبتي وسرت","نفسي الى شربها في مسلك دمث",19,"ث",1,0],["توعَّدَ بالسهادِ بطولِ ليلٍ","ويأتيني الصباحُ من الطلوعِ",20,"ع",1,0],["توعديني وأنسى الوعد .. وأترك بالحشى لاهوب","ولا منّك نسيتي الوعد .. أجيك وأغصبك وعدك",21,"ك",1,0],["تَوَعَّدَهُمْ فِي البُعْدِ حَتَّى أَتاهُمُ","وَلَمْ يَثْنِهِ عَنْ وَطْىءِ أَرْضِهِمُ البُعْدُ",22,"د",1,0],["توعدنا برد لو رددنا","على طغيانه ذاك الخؤورُ",23,"ر",1,0],["توعدوا ، أقسموا ، بُحَّت حناجرهم","وصمّ آذاننا التهديد والقسم",24,"م",1,0],["تِ وَعاث الفَساد بَين البَرايا","حيث قيدوا بِكاهِن للدنايا",25,"ي",2,0]]}