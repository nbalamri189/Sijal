{"poems":[[189,"أرى الشر طبع نفوس الأنام","https://www.aldiwan.net/poem14667.html","المتقارب"],[276,"تعلقت بالاسباب دون مدبري","https://www.aldiwan.net/poem52080.html","الطويل"],[309,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[505,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[563,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"],[563,"أنت قيد الوجود إن غبت غابا","https://www.aldiwan.net/poem34952.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122820","الوافر"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137557",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37799","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136132","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45902","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83202","الرجز"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35415","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72819","الطويل"],[4680,"أنت الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=203971",""],[4726,"ألا بالصبر تبلغ ما تريدُ","https://www.poetsgate.com/ViewPoem.aspx?id=146641",""],[5206,"مَرثاة الصديق الغِشْرِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=187432",""],[5295,"بَيْنَ الثُّلُوجِ","https://www.poetsgate.com/ViewPoem.aspx?id=177209",""],[592,"ألا قل لذي الجهل المركب إنما","https://www.poetsgate.com/ViewPoem.aspx?id=128806",""],[592,"إذا رمت أن تنجو من النار سالماً","https://www.poetsgate.com/ViewPoem.aspx?id=128832",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[5689,"أراك بذي الدنيا الجفاء حبورها","https://www.poetsgate.com/ViewPoem.aspx?id=143409",""],[5977,"عالمي","https://www.poetsgate.com/ViewPoem.aspx?id=212746",""]],"verses":[["وكن سائِسا آمِرا في الملوكِ","وسائسْ لأَمرك أقلَّ الأنام",0,"م",1,0],["وَكن سَيدي عوني وَغوثي دائِما","وَعزى وَحرزى دائما وَغنى فقري",1,"ر",2,0],["وكنس ضمير القلب كي يبق فارغاً","من الحب للدنيا الغرور الدنية",2,"ه",1,0],["وكنْ سخِيًّا من حلالٍ وارِدٍ","إليكَ من إِحسانِ رافِعِ العُلَى",3,"ا",1,0],["وكن سائراً بشراع التقى","إليه به إن جدواه يمّ",4,"م",1,0],["وكنست الكنائس السود مما","كان فيها حتى البياض أجابا",5,"ب",2,0],["وَكُن سَروَى أَبيكَ فَأنتَ قِنوٌ","مِنَ النَّخلِ البَواسِقِ وَهُوَ قِنوُ",6,"و",1,0],["وكن ساعيا أبدا لارتزاق","ولا تك منزويا كالحجر",7,"ر",1,0],["وَكُن سَيِّداً بِالحَزمِ باتِرُ عَزمِهِ","يقدُّ بِهِ هامَ الصخورِ فَتَنقدُّ",8,"د",1,0],["وكنس ضمير القلب عن ميله إلى","خيالات تخييلات هذي الدنية",9,"ه",1,0],["وَكُن سالِكاً في مَنهَج الحَق وَاِتَبع","سَبيل الهُدى لا تَترُك الحَق مهملا",10,"ل",2,0],["وَكُن سَليمَ الجانِبِ","وَاِنظُر إِلى العَواقِبِ",11,"ب",1,0],["وَكُن ساكِناً يا صاحِ إِن كُنتَ كَيِّساً","إِلَيهِ وَدَع مَن بِالسِوى يَتَعَلَّقُ",12,"ق",1,0],["وكن ساجعاً طولَ المدى فوق بانها","كورقِ والا فالغرامُ له أهلُ",13,"ل",1,0],["وكُنْ سحابة آمالٍ بأفق غدي","إن أمطرتْ أخبرتْ عن أكرم الناسِ",14,"س",1,0],["وكن سَمْحاً ببذل المال جوداً","ففي مرقى الفلاح لك الصعود",15,"د",1,0],["وَكُنْ سَاكِنًا تَحتَ القَضَا راضِيًا بِهِ","فَمِنْهُ الذي تَهْوَى وتَرضَاهُ مَنْتوجُ",16,"ج",1,0],["وكَنَسْمةٍ بينْ الثَّلُوجِ تَدَلَّلَتْ","قَدْ جاءَ هَمْسُكَ والرَّبيعُ تَجَدَّدَا",17,"د",2,0],["وكن سالكاً إن كنت للرشد طالباً","مريداً وللحق الصواب ميمما",18,"م",2,0],["وكن سلساً سهلاً لبيباً مهذباً","كريماً طليق الوجه سامي التطلب",19,"ب",1,0],["وكن سلسا سهلاً رفيقاً ومكرماً","لأهل التقى والخير في سائر الدهر",20,"ر",1,0],["وكن ساعيا خلف الكمال فإنما","يحط بهمات الرجال قصورها",21,"ر",3,0],["وكنسمة حملت أريج محبةٍ","في قلبه ..و النطق من شفتيه",22,"ي",2,1]]}