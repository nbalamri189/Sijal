{"poems":[[74,"شاب فود الصب حزنا مثل ما","https://www.aldiwan.net/poem19191.html","الرمل"],[112,"يالشعر؟","https://www.poetsgate.com/ViewPoem.aspx?id=8401",""],[96,"طمع الأقوياء","https://www.poetsgate.com/ViewPoem.aspx?id=15664",""],[234,"ما تقاضت منا ليالي الزمان","https://www.aldiwan.net/poem50777.html","الخفيف"],[333,"لا أنا خالد ولا أمنياتي","https://www.aldiwan.net/poem54952.html","الخفيف"],[333,"من ترانيم وحيك القدسي","https://www.aldiwan.net/poem55045.html","الخفيف"],[699,"","https://poetry.dctabudhabi.ae/diwan/poem/104491","السريع"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136988",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204763",""],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90831","الرمل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72468","الخفيف"],[4785,"وقفة على الشاطئ","https://www.poetsgate.com/ViewPoem.aspx?id=12037",""],[4869,"محاكاة صورة","https://www.poetsgate.com/ViewPoem.aspx?id=138048",""],[4869,"بارحل عشانك ماوصلتي عشاني","https://www.poetsgate.com/ViewPoem.aspx?id=151615",""],[4869,"الشعر يفضح الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=151650",""],[4874,"أمل","https://www.poetsgate.com/ViewPoem.aspx?id=176614",""],[5061,"ياخوي الدرب","https://www.poetsgate.com/ViewPoem.aspx?id=147429",""],[5212,"مملكة النّمل","https://www.poetsgate.com/ViewPoem.aspx?id=212581",""],[5388,"شكوى","https://www.poetsgate.com/ViewPoem.aspx?id=206904",""],[333,"نشيد الصفاء","https://www.poetsgate.com/ViewPoem.aspx?id=101256",""],[5431,"أهواك حيّا ..","https://www.poetsgate.com/ViewPoem.aspx?id=196754",""],[5747,"شوق شما","https://www.poetsgate.com/ViewPoem.aspx?id=61618",""],[5795,"نصرت دولة المهى التركيه","https://www.poetsgate.com/ViewPoem.aspx?id=167910",""],[6093,"يا لشهد ليتني من رشفه","https://www.poetsgate.com/ViewPoem.aspx?id=203797",""],[6096,"ياترى","https://www.poetsgate.com/ViewPoem.aspx?id=202963",""]],"verses":[["يا لشيب عم وجهاً فبكى","كيف لا يبكي لشيبٍ قنّعه",0,"ع",2,0],["يالشعر؟ يخصاال ورث العرب واحلا الخصل","أبكلي فيعيرن؟ بشرى؟ عشان أضحك عليك",1,"ك",1,1],["يالشكوى تغصّ دجلة بالدمع","حنانا وتحزن الأهراما",2,"م",2,0],["يا لشَواَّلَ مِن مُعِينٍ على اللّذْ","ذَةِ والقَصْف تحت خيرِ أَوانِ",3,"ن",1,0],["يا لشرق أعطاه قلبه العا","شق أغلى الدموع والبسمات",4,"ت",1,0],["يا لشعب عبدانه البيض أحرار","يسومونه عذاب العصي",5,"ي",1,0],["يا لشعب عزت عليه الأماني","فهو في الدهر كالذليل الأبي",5,"ي",1,0],["يالشعوب العرب من رقدة","أمست بها كالشاة بين الذئاب",6,"ب",1,0],["يا لشعر سحر القوم به","وبه ابطل كيد الساحرين",7,"ن",1,0],["يا لشيطان شعري اللاهي","بالتفاهات جاهلا ما هي",8,"ا",3,1],["يا لشمس للهلالي كلمت","بلسان عربي أي لسان",9,"ن",1,0],["يا لشمس على الوجود أفادت","لا عراها الزوال بالأفياء",10,"ا",2,0],["يا لَشَوْقي إلى مَحاسِنِ قُطْرٍ","هَبَطَ الوَحْيُ فيهِ والإلْهامُ",11,"م",1,0],["يالشمس كفّي لهيب النار","إدروب الافراح منقفله",12,"ل",2,1],["يالشمس ليه انتي عليهم تضوين","وانا الذي كنت احسب انك عشاني",13,"ن",2,1],["يالشمس قبل انك معاهم تغيبين","اخذي الكلام اللي بطارف لساني",13,"ن",2,0],["يالشعر ما اشوف غيرك صاحبٍ غالي","بالحزن وألا الفرح ماتترك اصحابك",14,"ك",1,1],["يالشعر ردد على لساني من اقوالي","من قاع حزني على مافيني ارقابك",14,"ك",1,0],["يالشعر مافيه غيرك صاحبٍ غالي","لكنك اللي بقافك تفضح اصحابك",14,"ك",1,0],["يالشيح عمك ياالخزاما بناخيك","ياالشمس تشرق بين شرقة ثناياك",15,"ك",1,0],["يالشجاع القرم يانسل الفهد","المعزه دايمه طول السنين",16,"ن",1,0],["يالشّابع خبز، بالصحره نص الليل","ما يشبع طفل بالخبزه الزغيره",17,"ر",2,0],["يَا لَشِعرٍ حَرفُهُ أَضنَى بِهِ","مَارِقٌ فَوقَ العَنَا قَدْ وَسَّدَهْ",18,"د",2,0],["يا لشعب عبدانه البيض أحرار يسومونه عذاب العصيّ","يا لشعب عزّت عليه الأماني فهو في الدهر كالذليل الأبيّ",19,"ي",1,0],["يالشوق الريّ يجري","في الروابي في المحيا",20,"ي",2,0],["يالشاعر اللي ماكسر كل ضما","شاعر وشعرك مااختلف بينه اثنين",21,"ن",1,0],["يا لشمس نظامها فيه دارت","واستنارت سيارة بشريه",22,"ي",2,0],["يا لِشَهْدٍ ليتَني مَنْ رشَفَهْ","دونهُ الجندانِ :سِنٌ وشَفَةْ",23,"ف",2,1],["يا لشعر .. كجنون","يعشق النبض اشتعالهْ",24,"ل",2,0]]}