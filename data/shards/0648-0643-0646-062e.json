{"poems":[[23,"كبرت كذاك المرء ما عاش يكبر","https://www.aldiwan.net/poem21567.html","الطويل"],[64,"اعمل بجد وجلد","https://www.aldiwan.net/poem52155.html","مجزوء الرجز"],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[435,"الحمد لله الذي قد حللا","https://www.aldiwan.net/poem40815.html","الرجز"],[534,"ما لبسك الديباج والتاج مع","https://www.aldiwan.net/poem37420.html","السريع"],[563,"وجودي جل عن جسمي","https://www.aldiwan.net/poem34248.html","الهزج"],[564,"إذا بريق الحمى استنارا","https://www.aldiwan.net/poem69359.html","مخلع البسيط"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66707","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38055","المجتث"],[2897,"","https://poetry.dctabudhabi.ae/diwan/poem/122225","الرجز"],[3882,"","https://poetry.dctabudhabi.ae/diwan/poem/124627","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77125","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123508","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123513","المتقارب"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133148","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58067","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57993","الطويل"],[592,"رسائل أخوان الصفا والتودد","https://www.poetsgate.com/ViewPoem.aspx?id=128837",""]],"verses":[["وَكُنَّ خِلالي يَومَ شَعري كَأَنَّهُ","جَناحُ غُدافٍ أَسوَدٍ حينَ يُنثَرُ",0,"ر",1,0],["وكن خبيراً بالأدا","ة والسداد والمدد",1,"د",1,0],["وكن خائفا من بطشه بعد لطفه","ألا كل يوم رب شأنك في شان",2,"ن",1,0],["وكن خبيراً محكم التهذيب","واتخذ الأعمال بالترتيب",3,"ب",1,0],["وكُنْ خَلِيلاً لِلخَليلِ الّذي","عِلْمُ الأَعارِيضِ بِهِ أَسْفَرا",4,"ر",2,0],["وكن خمراً بلا كأس","وكن شمساً بلا ظل",5,"ل",1,0],["وكنْ خليعاً كما ترَاني","لم يُبْقِ لي شربها اِختيارا",6,"ر",2,0],["وكن خاذِلاً للأولى يخذلون","وكن للأولى يَنصرون نَصيرا",7,"ر",2,0],["وَكُن خَليلي صَدوقاً","فَالصّدقُ مَجدٌ وَعِزُّ",8,"ز",1,0],["وكن خميص البطن من زاد الربا","وخمرة التقوى اصطبح واغتبق",9,"ق",1,0],["وكُن خاشعا فيها بقلب وقالب","ولا تتفكر في بحور المغارق",10,"ق",1,0],["وَكُن خَليقاً بِصِدقِ البُأسِ يَومَ وَغى","فَشَر عَيبَ الفَتى بِالجُبنِ وَالخورِ",11,"ر",1,0],["وكن خلفى فيمن أخلف واحمهم","من السوء وامنحهم معاشا مفضفضا",12,"ض",2,0],["وكن خلفى فبهم واحمهم","مريعا وأحسن لهم مرجعا",13,"ع",2,0],["وكن خضوعاً خشوعاً خائفاً وجلاً","من شؤم ذنبٍ وصرف العيش في اللعب",14,"ب",1,0],["وكن خاشعاً بين الوَرَى متواضعاً","تُعَافَى ولا تخشى مطالاً ولا وكزا",15,"ز",2,0],["وكن خاشعاً ذا عفة متواضعاً","صبوراً شكوراً زاهداً ذا إنابةِ",16,"ه",1,0],["وكن خاضعاً لله ربك لا لمن","تعظمه واركع لربك واسجد",17,"د",1,0]]}