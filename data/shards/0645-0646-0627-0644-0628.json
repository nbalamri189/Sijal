في كانون والليل خيما","https://www.poetsgate.com/ViewPoem.aspx?id=156441",""],[5199,"حبرى وقرطاسى","https://www.poetsgate.com/ViewPoem.aspx?id=150497",""],[5320,"رائد الأعلام","https://www.poetsgate.com/ViewPoem.aspx?id=40898",""],[592,"سفاسط أملاها الغبي وسطرا","https://www.poetsgate.com/ViewPoem.aspx?id=128722",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[592,"تبصر نور الحق من كان يبصر","https://www.poetsgate.com/ViewPoem.aspx?id=128795",""],[5351,"هنا صنعاء هنا صعدة","https://www.poetsgate.com/ViewPoem.aspx?id=202119",""],[5582,"ثَنَتْ لِوَداعِي جِيدَها غُدْوَةً يُسْرَا","https://www.poetsgate.com/ViewPoem.aspx?id=187150",""],[5582,"أَحَلَّكَ فِي أَسْرِ الغَرامِ حُلاحِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187218",""],[5582,"أَمِنْ بارِقٍ أَعْلَى الأُبَيْرِقِ يُلْمَحُ","https://www.poetsgate.com/ViewPoem.aspx?id=186780",""],[5582,"لَئِنْ تُخْفِ ما بِكَ أَوْ تَصْبِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=187009",""],[5582,"حشا قَلْبَهُ مِنْ لاعِجِ الشَّوقِ ما حَشا","https://www.poetsgate.com/ViewPoem.aspx?id=63528",""],[5582,"بريقٌ بِأَعْلَى الأَبْرَقَيْنِ تأَلَّقَا","https://www.poetsgate.com/ViewPoem.aspx?id=63544",""],[5582,"قِفا وَاسْأَلا عَنْ دارِ سُعْدَى وَعَنْ سُعْدَى","https://www.poetsgate.com/ViewPoem.aspx?id=63483",""],[5582,"قِفَا بِالرُّسُومِ الخَوالِي القِفارِ","https://www.poetsgate.com/ViewPoem.aspx?id=63523",""],[5582,"أَمِنْ ذِكْرِ أَطْلالٍ خَلَتْ وَتَعَفَّتِ","https://www.poetsgate.com/ViewPoem.aspx?id=63472",""],[5616,"محنة","https://www.poetsgate.com/ViewPoem.aspx?id=203469",""],[5848,"عمري وقف","https://www.poetsgate.com/ViewPoem.aspx?id=48841",""],[5855,"من البرِّ أن تلقى الجفاءَ بمثلهِ","https://www.poetsgate.com/ViewPoem.aspx?id=208621",""],[5956,"جروحي","https://www.poetsgate.com/ViewPoem.aspx?id=197512",""],[5956,"من البجَّاع دكتورٌ عظيمُ","https://www.poetsgate.com/ViewPoem.aspx?id=214191",""],[5956,"تصدُّ النفسُ","https://www.poetsgate.com/ViewPoem.aspx?id=215870",""],[5969,"مؤامرة","https://www.poetsgate.com/ViewPoem.aspx?id=205051",""],[6142,"بنت النبوة أخت الذكر أم هدا","https://www.poetsgate.com/ViewPoem.aspx?id=155741",""],[186,"من آل بسترس الكرام موسد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55966&r=&rc=229",""],[6345,"مايد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78663&r=&rc=34",""]],"verses":[["مِنَ البيضِ العَقائِلِ مِن مَعَدٍّ","بَنَينَ قِبابَهُنَّ عَلى الجَلالِ",0,"ل",1,0],["مِنَ البيضِ غُرّانِ المَجالي إِذا اِنتَدوا","بَدا لَكَ بَسّامونَ شُمُّ المَراعِفِ",1,"ف",1,0],["مِنَ البيضِ لَولا بُردُها قُلتُ دَمعَةٌ","مُرَنَّقَةٌ ما أَسلَمَتها المَدامِعُ",2,"ع",1,0],["مِنَ البيضِ يَستامونَ وَالعامُ كالِحٌ","جُدوباً وَمَطّارونَ في الحِجَجِ الغُبرِ",3,"ر",1,0],["مِنَ البِيضِ لا تَزدادُ إِلّا تَجَنِّياً","عَلينا وَلَولا بُخلُها ما تَجَنَّتِ",4,"ت",1,0],["مِنَ البيضِ لَم تَعرِف سِوى البُخلِ شيمَةً","وَلَم يُرجَ إِلّا بِالأَحاديثِ جودُها",5,"د",3,0],["مِنَ البيضِ لا تَلقاكَ إِلّا مَصونَةً","وَتَمشي كَغُصنِ البانِ بَينَ الوَلائِدِ",6,"د",1,0],["مِنَ البيضِ كَالآرامِ وَالأُدمِ كَالدُمى","حَواصِنُها وَالمُبرِقاتِ الرَواني",7,"ن",2,0],["مِنَ البَحرِ حَمحامٌ صُراحٌ غَمامُهُ","إِذا حَنَّ فيهِ رَعدُهُ يَتَكَشَّفُ",8,"ف",1,0],["مِنَ البيضِ مِبهاجٌ عَلَيها مَلاحَةٌ","نُضارٌ وَرَيعانُ الحِسانِ الرَوائِعِ",9,"ع",1,0],["مِنَ البُعدِ خَلفَ الرَكبِ يَلوونَ نَحوَها","بِأَعناقِهِم كَم دونَها نَظَراً شَزرا",10,"ر",2,0],["مِنَ البيضِ أَطرافاً كَأَنَّ بَنانَها","مَنابِتُ ثَدّاءٍ مِنَ الأَجرَعِ المُثري",11,"ر",2,0],["مِنَ البيضِ لَم تَظعَن بَعيداً وَلَم تَطَأ","عَلى الأَرضِ إِلّا نيرَ مِرطٍ مُرَحَّلِ",12,"ل",1,0],["من آل بدرٍ طلعةً أو نسبةً","والرقمتين سوالفاً أو موْلدا",13,"د",2,0],["من الباذلي الأموال والقامعي العدا","فأعداؤهُ تشكو النثارَ ونثره",14,"ر",2,0],["مِنَ البَحرِ تَصعَدُ هَذي الغُيوثُ","وَتَحطُلُ في البَحرِ إِذ تَهطُلُ",15,"ل",1,0],["مِنَ البَهَاليلِ آلِ فاطمةٍ","أَهْلِ المعالي والسّادةِ النُّجُبِ",16,"ب",1,0],["من الباسطاتِ الظِلَّ أَمّا قوامُها","فشطبٌ وأمّا تُربُها فمريعُ",17,"ع",1,0],["مِنَ البَقَرِ الَّذينَ رُزِئتُ خَلّوا","عَلَيَّ المُضلِعاتِ مِنَ الأُمورِ",18,"ر",1,0],["مِنَ البيضِ لَم تَنضُ الأَكُفُّ كَنَصلِهِ","وَلا حَمَلَت مِثلاً إِلَيهِ الحَمائِلُ",19,"ل",1,0],["مَنِ البَأسُ وَالمَعروفُ وَالجودُ وَالتُقى","عِيالٌ عَلَيهِ رِزقُهُنَّ شَمائِلُه",20,"ل",2,0],["مِنَ البيضِ مَحجوبٌ عَنِ السوءِ وَالخَنا","وَلا تَحجُبُ الأَنواءَ مِن كَفِّهِ الحُجبُ",21,"ب",1,0],["مِنَ البيضِ مِكسالُ الضُحى بَختَرِيَّةٌ","ثَقالٌ مَتى تَنهَض إِلى الشَيءِ تَفتِرُ",22,"ر",1,0],["مَنِ البَكَراتِ عِراقِيَّةٌ","تُسَمّى سُبَيعَةَ أَطرَيتُها",23,"ت",3,1],["مِنَ البيضِ كَوماءِ العِظامِ كَأَنَّما","يُلاثُ عَلى دَعصٍ هَيالٍ إِزارُها",24,"ر",3,0],["مَنِ البَواسِلُ هَزَّ الأَرضَ ما صَنَعوا","وَغادَرَ الفَلَكَ الدَوّارَ مُرتَعِبا",25,"ب",2,0],["مِنَ البيضِ إِمّا ما يُوارى إِزارُها","فَفَقمٌ وَإِمّا ما عَلاهُ فَمُرهَفُ",26,"ف",1,0],["مِنَ البَربَرِيّاتِ اللَواتي وُجُوهُها","بِكُلِّ فَعالٍ صالِحٍ تَتَهلَّلُ",27,"ل",1,0],["مِنَ البيضِ كَالغِزلانِ وَالغُرِّ كَالدُمى","حِسانٌ عَلَيهِنَّ المَعاطِفُ وَالأُزُر",28,"ر",1,0],["مِنَ البيضِ ما تَلقاكَ إِلّا مَصونَةً","ثَقالاً وَمَشيَ الخَيزَلى في الوَلائِدِ",29,"د",1,0],["مِنَ البيضِ لَم تَسرَح عَلى أهل غُنَّةٍ","وَقيراً وَلَم تَرفَع حِداجَ قَعودِ",30,"د",1,0],["مِنَ البيضِ تَجمَعُ هَمَّ الفَتى","كَما يَجمَعُ اللَبَنَ الإِنفَحُ",31,"ح",1,0],["مِنَ البيضِ مِعلاقُ القُلوبِ كَأَنَّما","جَرى بِالرُقى في عَينِها لَكَ ماءُ",32,"ا",2,0],["من البَنين والعِيالِ والحشمْ","وكُلِّ من لاذَ بهمْ من الخَدَمْ",33,"م",1,0],["مِن البيضِ ما حِرْباؤها مُتَعَوَّدٌ","سِوَى مَرْكَبِ الخُرْصانِ رِكْبةَ أجذال",34,"ل",1,0],["مِن البِيضِ فِرْعَوْنِيّةٌ ليس مِثلُها","بمُشْتَمَلٍ حَيْرِيَّ دهرٍ على حال",34,"ل",1,0],["مِنَ الْبِيضِ مَيْسَانُ الْعَشِيَّاتِ غَادَةٌ","سَلِيمَةٌ مَا تَحْوِي الْمَعَاقِدُ وَالأُزْرُ",35,"ر",1,0],["مِنْ آلِ بَدْرَ الْبَاسِلِين","الْباِذِلينَ ذَوِي المَفَاخِرْ",36,"ر",1,0],["مِنَ البِيضِ كالغِزْلانِ والعُزِّ كالدُّمَى","حِسَانٌ عليهنّ المَعَاطِفُ والأُزُرْ",37,"ر",1,0],["من البحر تصعدي هذي الغيوث","وتهطل في البحر إذ تهطل",38,"ل",1,0],["مِنَ البَكَراتِ عِرَاقِيَّة ً","تسمى سبيعة َ، أطربتها",39,"ت",3,1],["مِن البَشانِقَة الغُر الذينَ لَهُم","لِواء حُسن عَلى الأَقمار مَعقودُ",40,"د",1,0],["من البيض الوجوه شموس مجد","كرام البيت في البيت الحرام",41,"م",1,0],["مِنَ البَسيطِ المُوَشَّى قالَ راويها","يائيّةَ الحَرفِ ما أحلى قَوافيها",42,"ي",3,1],["مِنَ البيضِ مِفضالٌ أَبِيٌّ عَلى العِدا","تَمَكَّنَ في الفَرعَينِ في حَيِّ هاشِمِ",43,"م",1,0],["مِنَ البِيضِ حَوراءُ المَدامِعِ طَفلَةٌ","يَشُوبُ بَياضَ الكفِّ مِنها خِضابُها",44,"ب",3,1],["مِن البِيضِ لاَ تَخزَى غِذا الرِّيحُ أَلزَقَت","بها مِرطَها أَو زايلَ الحَلىَ جِيدُها",45,"د",3,0],["مِنَ البيضِ نَجلاَ والعُيُونِ غَذَاهما","نَعيمٌ وعَيشٌ ضارِبٌ بِجِرَانِ",46,"ن",1,0],["مِن آلِ بِستِرسَ الكِرامَ مُوَسّدٌ","تَسقي المَراحمُ كُلَّ يَومٍ لَحدَهُ",47,"د",2,1],["من البيد قد ربنا المخارم قفرةً","بحافاتها الجنّان بالليل تعزف",48,"ف",1,0],["من البحر إلى البحر","إلى الساحل فالغوطه",49,"ط",2,0],["من البيض التي تسمو","باعطاف من السمر",50,"ر",1,0],["مِن البؤس والنعماءِ نلتُ فما انْحَنَتْ","قناتِي ولا أَبديت فرط تضيّقِ",51,"ق",1,0],["مِنَ البيضِ الخُدودِ بِذي سُدَيرٍ","يَنُشنَ الغُصنَ مِن ضالٍ قِضافِ",52,"ف",1,0],["من آل بيتٍ شيد بالكرم الّذي","عذبت موارده إلى الورّاد",53,"د",1,0],["مِن البَاسِقَاتِ السابِقاتِ بِحَملِها","إذا تُعْسِرُ الأشجار كانَ لها وَجْدُ",54,"د",1,0],["مِن البيضِ حمْراءُ المَطارفِ والحُلى","إذا طَلَعتْ حُلّتْ لطلعَتها الحُبى",55,"ب",2,0],["من البصرة الخضراء يخترق القرى","ويلحق أغواراً لها بآكام",56,"م",1,0],["من البرو والتقوى وحسن شمائل","كرام السجايا أردفت بكرام",56,"م",1,0],["مِنَ البيضِ أَعطافاً إِذا اِتَّصَلَت دَعَت","فِراسَ بنَ غَنمٍ أَو لَقيطَ بنَ يَعمُرا",57,"ر",2,0],["من آل بَدْرٍ وحِصْنٍ رَشّحوكَ لَها","بَدْراً هَداها وحِصناً ظَلَّ يَحميها",58,"ي",3,0],["من البُلْقِ يَعلو ظَهرُها هامَ أهلِها","وفي السَّيرِ تَعلو أظهُرَ الخيلِ والإبل",59,"ل",1,0],["من البيضِ يَهْدي الركبَ باللّيلِ وجْهُها","إذا ضلّ مثْلي في غدائِرها المُشط",60,"ط",1,0],["منَ البِيضِ أمّا بَحرُه لعُفاتِه","فَطامٍ وأمّا دُرُّه فكِبار",61,"ر",1,0],["من البِيض يُعْرَوري به السّيفَ عَزْمُه","وإن هو لم تُسْدَدْ عليه المَذاهب",62,"ب",1,0],["من البَدْوِ تُذْكَى لِلْملمّين نارُه","تَرى حَولَه مِنها جبالَ رمادِ",63,"د",1,0],["من آل بيت رسول الله يسكنها","قوم لهم من رجال الغيب أحلاف",64,"ف",1,0],["من البديع ومن سحر البيان لقد","لقد أوتيت سؤلك يا موسى على قدر",65,"ر",1,0],["من البطل المشهور في عظم فعله","يلوح سناها في ابتهاج كومض",66,"ض",1,0],["من البين في قلبي وخدي ومقلتي","ندوب من الأشواق أي ندوب",67,"ب",1,0],["من البدلاء الكرام المساعي","فأكرم به من فتى أحوذي",68,"ي",1,0],["من البيضِ ما طبعَ الفُرسُ من","ه للهندِ زُبرةَ مَجدِ تميمِ",69,"م",1,0],["من البيت الذي بذؤابتيه","سما والمنبت الزاكي الأرومِ",70,"م",1,0],["من الباقياتِ الصالحاتِ أروضُها","بنفسي إذا طابت وقلبي إذا خلا",71,"ل",2,0],["من الباهراتِ لم تُحدَّثْ بمثلها ال","نفوسُ ولم تُوصَل إليها القرائحُ",72,"ح",1,0],["من البَهْمِ لو طَلَب النطقَ ضلَّ","وفي الأنبياءِ إذا ما طُلِبْ",73,"ب",1,0],["من البيض إلا أن يُحلِّي وجوهَهُم","إذا هُجِروا خَلْفَ الترابِ شُحوبُ",74,"ب",1,0],["من البيضِ أما ودّهُ فهو قاطِعٌ","صَرومٌ وأما وعْده فهو ماطِلُ",75,"ل",1,0],["من آلِ بيتٍ كِرامٍ مسكُ سيرَتِهِمْ","يَفوحُ في النَّاس من جيلٍ إلى جيلِ",76,"ل",1,0],["من آلِ بيتٍ عن أبي العَبَّاسِ قد","وَرِثوا القُوى واسْتَبْسَموا العَبَّاسا",77,"س",2,0],["من البشيرِ أَبي الزَّهراءِ سيِّدِنا","لنا برفْعَةُ هذا الشَّأْنِ تَبْشيرُ",78,"ر",1,0],["من آلِ بَيتٍ عَظيمِ الشَّأنِ عِتْرَتُهُ","مُعَظَّمونَ رِجاحُ القَدْرِ أخيارُ",79,"ر",1,0],["من البدء ما عودت نفسي بمفسد","لكل امرء من دهره ما تعودا",80,"د",2,0],["من البعد هم قد تكمل في الحشا","على قدر خطواتي الى القرب ذايل",81,"ل",1,0],["من البرية ما استثنيت لي سندا","الاجناب رسول الله ذي العظم",82,"م",1,0],["مِنَ البَياضِ مُدَّ بِالمِقاطِ","فَثارَ يَرقَدُّ مِنَ النَشاطِ",83,"ط",1,0],["من البِيضِ إِلاَّ أَن تَرَى سُمْرة اللَّمى","فتحلفُ حقّاً أَنَّها سمرةُ القَنا",84,"ن",2,0],["مِنَ البُدُورِ التَّمامِ كانَتْ","فَلِمْ غَدَتْ مِنْ بَناتِ نَعْشِ",85,"ش",1,0],["مِنَ البَهاليلِ مِن أُمَيَّةَ يَز","دادُ إِذا ما مَدَحتَهُ كَرَما",86,"م",2,0],["مِن آل بابان شهمٌ قَد زَكى نَسباً","وَحطّ فَخراً على هامِ السهى قدما",87,"م",2,