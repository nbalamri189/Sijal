.com/modules.php?name=Sh3er&doWhat=shqas&qid=87329&r=&rc=2",""]],"verses":[["بِرُغمِيَ أَنزَلتُ الهَوى عِندَ مانِعٍ","وَدُمتُ عَلى عَهدِ اِمرِئٍ غَيرِ دائِمِ",0,"م",1,0],["بِرُغمِكَ أَجمَمتَ الصَوارِمَ وَالقَنا","وَأَخلَيتَ يَومَ الرَوعِ بيضاً وَأَدرُعا",1,"ع",2,0],["بِرُغمي أَن يَكُنَّ قَنا تَميمٍ","قَضَينَ عَلى الذَنائِبِ مِنكَ حاجا",2,"ج",2,0],["بِرُغمِيَ تُمسي نازِلاً فارَ هِجرَةٍ","وَأَنتَ المُصافي وَالقَريبُ المُنافِثُ",3,"ث",1,0],["برَغْمِ العُلا تُمْسي وتُصْبِحُ دُورُهُمْ","وهُنَّ رُسومٌ رثّةٌ وطُلولُ",4,"ل",1,0],["بِرُغمي أُطيلُ الصَدَّ عَنكِ وَأَبتَلي","بِهَجرِكِ قَلباً لَم يَزَل فيكِ مُتعَبا",5,"ب",2,1],["بِرَغمِ النيلِ أَن عَدَتِ العَوادي","عَلَيكَ وَأَنتَ خادِمُهُ الأَمينُ",6,"ن",1,0],["بِرَغمِ الثَغرِ أَن غُيِّبتَ عَنهُ","وَأَن نَزَلَت بِساحَتِكَ المَنونُ",6,"ن",1,0],["بِرَغْمِ المَجْدِ أَنْ وَلَّيْتَ عَنَّا","صرِيعاً لَمْ تَجُزْ حَدَّ الشَّبَابِ",7,"ب",1,0],["بِرَغْمِهِ أَنَّ عَيْنَ الشَّرْقَ نَائِمَةٌ","عَنِ المَعَالِي وَعَيْنُ الْغَرْبِ لم تَنَمِ",8,"م",1,0],["بِرَغْمِ كُلِّ شُجَاعٍ","يَا شِبْلُ أَنَّكَ رَاغِمْ",9,"م",1,0],["بِرَغْمِ المَعالِي أَنَّكَ اليَوْمَ نَائِمُ","لِغَيْرِ غَدٍ تَرْجُوهُ مِنْكَ العَظَائِمُ",10,"م",1,1],["برغم العدى إنا فقدناك أوحداً","إذا اجتمعت أرباب فضل وسؤدد",11,"د",1,1],["برغمي بنات الرُّوم حزناً رقابها","وحالُ الهوى بالشيب والهمّ فاسد",12,"د",1,1],["برغم العلى تاجٌ تحلى به الثرى","وكانت ثراهُ هامةَ السحب في الذرا",13,"ر",2,1],["برغمي أن شرعت له رثاءً","ولم ألزمْ بتهنئةٍ شروعا",14,"ع",2,1],["برغميَ أن غاض الندى بكماله","فلم يبق إلا زورة من خياله",15,"ل",2,1],["برغميَ طرف غاب عنه عزيزه","فعوضه ماء البكا بمهينه",16,"ن",2,0],["برغمِي أن أهاديكم بمعنى","دقيق في مقابلة العطايا",17,"ي",2,1],["بِرَغمِكَ فارَقتَ الرُبوعَ وَإِنَّنا","عَلى الرُغمِ مِنّا سَوفَ نَلحَقُ بِالظَعنِ",18,"ن",1,0],["بِرَغمِ القُلوبِ وَحَبّاتِها","وَرَغمِ السَماعِ وَرَغمِ البَصَر",19,"ر",1,0],["بِرَغمِ شَبيبٍ فارَقَ السَيفُ كَفَّهُ","وَكانا عَلى العِلّاتِ يَصطَحِبانِ",20,"ن",1,0],["برغمي خلا رَبْعِي وأُسْكِنتِ خاطري","وغُيِّبْتِ عن عيني وأُحضِرْتِ في فكري",21,"ر",2,0],["برغم العُلَى أن أُشهِد الأمرَ غُيَّبٌ","وغُيِّبَ عنه حاضرُ اللُّبِّ شاهدُ",22,"د",1,0],["بِرُغمي أَن تَبيتَ غَريبَ دارٍ","وَعِشتَ وَأَنتَ في الدُنيا غَريبُ",23,"ب",1,0],["بِرُغمِ أَنفِيَ أَن يَدعوكَ ذو أَمَلٍ","فَلا يَسُحُّ عِهادٌ مِنكَ مَعهودُ",24,"د",1,0],["بِرَغمي وَما في الحُبِّ بِالرغمِ لذَّةٌ","أُحِبّ مشيبي والغواني فَوَارِكُهْ",25,"ك",2,0],["برغمي نَعَتْها ألْسُنُ الركب للعلى","فكيف أرُدّ النّعْيَ في ألسُنِ الرَكبِ",26,"ب",1,0],["بِرُغمِيَ أَن أورِدتَ قَبلي بِمَورِدٍ","تَبَرَّضتَ مِنهُ لا زُلالاً وَلا بَردا",27,"د",2,0],["برغمي أنَّ بيتكمُ يضامُ","ويبعدُ عنكمُ القاضي الإمامُ",28,"م",1,1],["بِرَغمي أُطيلُ الصَدَّ عَنها إِذا نَأَت","أُحاذِرُ أَسماعاً عَلَيها وَأَعيُنا",29,"ن",2,1],["بِرُغمِ كُلِّ حاسِدٍ يَبغيهِ","يَهدِمُهُ كَأَنَّهُ يَبنيهِ",30,"ه",1,0],["بِرُغمِ البَينِ لا صارَمتُ شُرّاً","وَلا زالَت وَإِن بَعُدَت صَديقا",31,"ق",2,0],["بِرُغمِ حُجّابٍ وَحُرّاسِ","صِيانَةَ الوَجهِ عَنِ الناسِ",32,"س",1,0],["برَغْمِهِمُ أن أيّدَ الحَقَّ أهلُهُ","وأن باءَ بالفعلِ الحميدِ حميد",33,"د",1,0],["برغم حنان أَهلك الدهر نجلها","وأَبكى حناناً من حنان عَلى النجل",34,"ل",1,0],["برغم قلبي صحتُ لا تُقدمي","وكان ما كان فلم تسمعي",35,"ي",1,0],["بِرَغْمِ العُلَى أَنْ يُمْسِيَ الصَّفْوَةُ الأُلَى","بَنَوْا شُرُفَاتِ العِزِّ رَهْنَ يَبَابِ",36,"ب",1,0],["بِرَغْمِ المُنَى أَنْ غُيِّبَ القَبْرَ فَرْقَدٌ","أَضَاءَتْ بِمَا أَضْفَى عَلَيْهَا الفَرَاقِدُ",37,"د",1,0],["بِرَغْمِهَا أَنْ نَوَّهُوا بِاسْمِهَا","وَرَجَّعُوا أَصْدَاءَهُ فِي المَلاَ",38,"ل",2,0],["بِرغْمِ المُنَى ذَاكَ الخِتَامُ المُحَيِّرُ","كِتَابُكَ تطْوِيهِ وَمَنْعَاكَ يُنْشَرُ",39,"ر",1,1],["بِرَغْمِ النَّدَى وَالمَحْمَدَاتِ بُلُوغُهِ","عَشِيَّتَهُ وَالعُمْرُ فِي وَقْتِ إِصْبَاحِ",40,"ح",1,0],["برغْمِ أُولى الأَلبَابِ عَجَّلَ بَيْنَهُ","وَكَانَ لَهُمْ ذُخْراً وَكَانَ رَجَاءَ",41,"ا",2,0],["بِرَغْمِ وَفَائِي إِنَّهُ الْيَوْمَ خَاذِلِي","وَمَاذَا يَرُد البَث وَالْمَدْمَعُ الجَزْلُ",42,"ل",1,0],["برغم الحنين بهذا الفؤاد","ورغم البريق بذاك القمر",43,"ر",1,0],["بِرغمِ أَبيكَ اللَيث بَزّتكَ عَن يَدٍ","يَدٌ يَتَساوى عِندَها الشِبلُ وَالجَحشُ",44,"ش",1,0],["برغمي أنَّ داءك لاأقيه","وجرَحكَ لاأطيق له ضمادا",45,"د",2,0],["برغمي أن تروقَ لهم فتحلوا","مواردُهم وعيشي فيك مرّ",46,"ر",1,0],["برغمِ أنفِ الصِّبا وأنفي","يَخضِبُ فَودي منكَ الصديد",47,"د",1,0],["برغمِ الإِباءِ ورغمِ العُلى","ورغمِ أُنوفِ كِرامِ المَلا",48,"ا",1,1],["برغمِ الشُعورِ يشُلُّ البِلى","لسانَكَ أو يعتريكَ الكدَر",49,"ر",1,0],["برغم سنة خير العجم والعرب","أضحت مساجدها للهو واللعب",50,"ب",1,1],["برغم الذي ألقاه من جور حكمكم","ألوذ بكم عند الخصام وأستعدى",51,"د",2,0],["بِرَغمي أن تَقَلَّصَ منكَ ظِلٌّ","وَقاني حِقبَةً لَفحَ الحياةِ",52,"ه",1,0],["بِرَغمِ الحجا وَالمجدِ أَن مسَّك البِلى","بِسوءٍ فَأَضحى عودكَ الصُلبُ ذاوِيا",53,"ي",2,0],["بِرَغمِيَ أن يُدعى تُرابا وَأَعظُماً","فتىً كان يُدعى قبلُ أَكتبَ كاتِب",54,"ب",1,0],["بِرَغمِ أَنفِ المعالي ياِبنُ بِجدَتِها","أن غَيَّبَت شَخصَكَ الأَيّامُ وَالغِيَرُ",55,"ر",1,0],["بِرَغمي أَن تَبيتَ عَلى مِهادٍ","حَشاياهُ الجَنادِلُ وَالرَغامُ",56,"م",1,0],["بِرَغمِكَ عن أمرِ الخديوي تجنَّدَت","وإن لم يَكن نَهىٌ فَفيمَ جنود",57,"د",1,0],["برٌّ غدا بحر الندى","والبحر بات إليه جار",58,"ر",1,0],["بِرَغْمِيَ أزْمَعْتُ المَسِيرَ عَنِ العُلَى","وَصَرْفُ الليالي لِلْمُحِبيِّنَ مُرْغِمُ",59,"م",1,0],["بِرُغْمِ الْعِدى أَنْ بِتَّ وارِثَ مَجْدِهِ","وَذلِكَ حَقٌّ لَمْ تَكُنْ عَنْهُ تُفْرجُ",60,"ج",1,0],["برغم العَوالي السمهريَّة والظُبى","أصيبَ ولم تطعن عليه ولَم تَنكِ",61,"ك",1,0],["بِرَغْمِي إنْ خَلَتْ منهُ المَذاوِدْ","وَرَاحَتْ عُطَّلاً منهُ القَلائِدْ",62,"د",1,1],["بِرَغمِ كُلّ حَسودٍ ما حُبيتَ بِهِ","مِن المَناقب وَالعَلياء وَالرُتَبِ",63,"ب",1,0],["برَغْمي أنْ مضَى مَوروثُ عُمْرٍ","من الأترابِ لا مَوروثُ مال",64,"ل",1,0],["برَغْمِ العِدا أن قد سمَوْتَ منَ العُلا","إلى رُتَبٍ منها طَريفٌ ومُطَّرف",65,"ف",1,0],["برغم الحاقدين تظلُّ رمز","به الإيمانُ يُشرقُ والأَمَانُ",66,"ن",1,0],["برغمهم تم ما أراد به","من نشره للفروض والسنن",67,"ن",1,0],["بِرغْمَى أن تُمسِي وتُصبحَ دُونكُم","فَيافٍ لأيدي الجُردِ في وعْرِهَا لَغْطُ",68,"ط",1,0],["برغم الأَعادي نالَ همَّة نائل","فجدَع آناف العداة وأ