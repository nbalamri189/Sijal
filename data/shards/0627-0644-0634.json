"الشهيد قيس","https://www.poetsgate.com/ViewPoem.aspx?id=179228",""],[90,"البادية في إيران","https://www.poetsgate.com/ViewPoem.aspx?id=179050",""],[90,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[90,"الريف الضاحك","https://www.poetsgate.com/ViewPoem.aspx?id=179018",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"لبنان في العراق","https://www.poetsgate.com/ViewPoem.aspx?id=178952",""],[47,"الشّعرُ دِيوانُ العَرَبْ،","https://www.poetsgate.com/ViewPoem.aspx?id=14647",""],[91,"عصر الشبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=53194",""],[91,"الشجاع","https://www.poetsgate.com/ViewPoem.aspx?id=53313",""],[64,"كانَت لِقَلبي أَهواءٌ مُفَرَّقَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=93392",""],[99,"من مفكرة عاشق دمشقي","https://www.poetsgate.com/ViewPoem.aspx?id=568",""],[99,"يدك","https://www.poetsgate.com/ViewPoem.aspx?id=553",""],[51,"أحمدُ اللَّه مُبدِئاً ومُعيد","https://www.poetsgate.com/ViewPoem.aspx?id=27043",""],[89,"أوَ هل يعود إلى العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=55711",""],[101,"سارِي الْهَواءِ مَلَكْتَ أيَّ جَناحِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62448&r=&rc=40",""],[101,"جَمَعْتُ مِنْ فَرْعِ ذَاتِ الدَّلِّ أوْتَارِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62438&r=&rc=30",""],[85,"أعطى البرية َ إذ أعطاكَ باريها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9736&r=&rc=226",""],[96,"في القرية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66357&r=&rc=33",""]],"verses":[["الشَيبُ أَحسَنُ غَيرَ أَنَّ غَضارَةً","لِلمَرءِ في وَرَقِ الشَبابِ الآني",0,"ي",1,0],["الشَكُّ أَبرَدُ لِلحَشا مِن مِثلِهِ","يا لَيتَ شَكّي فيهِ دامَ وَطالا",1,"ل",2,0],["الشِّعْرُ سِحْرٌ وَعِنْدي مِنْ رَوائِعِهِ","أَصْفَى منَ المَاءِ أَوْ أَبْهى مِنَ الدُّرَرِ",2,"ر",1,1],["الشاتِمَي عِرضي وَلَم أَشتِمهُم","وَالناذِرَينِ إِذا لَم اَلقَهُما دَمي",3,"م",2,0],["الشَمسُ أَحسنُ شَيءٍ","رَأَيتُهُ حاشاهُ",4,"ا",2,0],["الشيب نبه ذا النهى فتنبها","ونهى الجهول فما أفاق ولا انتهى",5,"ه",2,1],["الشَّمْسُ أَنْتَ قَدِ انْفَرَدْتَ وَهَل يُرَى","بَيْنَ الْوَرَى فِي مَطْلَعٍ شَمْسَانِ",6,"ن",1,0],["الشُّكْرُ يَصْغُرُ والهِباتُ تَزيدُ","فمتَى يُجيدُ القوْلَ فيكَ مُجيدُ",7,"د",1,1],["الشَرقُ أَثبَتَ يَومَ عيدِكَ أَنَّهُ","مازالَ في رِيٍّ وَخِصبِ جَنابِ",8,"ب",1,0],["الشَعبُ يَدعو اللَهَ يا زَغلولُ","أَن يَستَقِلَّ عَلى يَدَيكَ النيلُ",9,"ل",1,1],["الشِبرُ في عُرفِ السِياسَةِ فَرسَخٌ","وَاليَومُ في فَلَكِ السِياسَةِ جيلُ",9,"ل",1,0],["الشِعرُ في أَوزانِهِ لَو قِستَهُ","لَظَلَمتَهُ بِالدُرِّ في ميزانِهِ",10,"ن",2,0],["الشَمسُ أَنتِ تَوارَت","عَن ناظِري بِالحِجابِ",11,"ب",1,0],["الشائقين نهى العباد وما رأى","منهم سوى الأثر الجميل عباد",12,"د",1,0],["الشمس في أوج السماء ورسمها","في الماء يدنيه السنى الوقاد",12,"د",1,0],["أَلشعْرُ مِنْ مَبْدَأِ الخَل","قِ كَانَ فَنا سَنِيَّا",13,"ي",2,1],["الشَّرْقُ يَعْرِفُ قَدْرَهُ وَيَجِلُّهُ","وَيَرَاهُ مِنْ أَعْلَى الذُّرَى بِمَكَانِ",14,"ن",1,0],["أَلشَّعْبُ إٍِنْ يَصْدُقْ تَكَافُلُهُ","بِلُوغِ غَايَاتِ العُلَى قَمِنُ",15,"ن",1,0],["أَلشَّرْقُ طَالَ سُبَاتُهُ الرَّوحَانِي","هَلْ أَيْقَظَتْهُ الرِّيحَاني",16,"ن",2,1],["أَلشَّاعِرُ الْحَقُّ مَنْ يَجْلُو الشُّعُورُ لَهُ","شَمْساً مِنَ الْوَحْيِ فِي دَاجٍ مِنَ الظُّلَمِ",17,"م",1,0],["أَلشَّعْبُ يَحْيَا بِأَنْ يُفْدَى وَمَطْمَعُهُ","مَالُ الْبَنِين مُزَكَّى وَالشَّرَابُ دَمُ",18,"م",1,0],["الشَّمْسُ فِي عَلَيْائِهِ مَجْلُوَّةٌ","وَيضدُ النَّوَالِ تَصُوبُ صَوْبَ غَمَامِ",19,"م",1,0],["الشموس تحسده حسن","فلذا تصفر عشيّا",20,"ي",2,0],["الشهب ترقب هذا الولادا","تهش لوكف تبس باديه",21,"ه",1,0],["الشمس تطلب تكن ل ديدا","وأن تشرف بأن تربيه",21,"ه",1,0],["إلش يردّه من قبل","إلى الخمر أو للمليح",22,"ح",1,0],["الشمس هوو جه البديع","والبدر لو من الجنن",22,"ن",1,0],["الشموس تغير لحسنوا","ولذا تصفر عشيّا",23,"ي",2,0],["الشعر معنىً ألفاظه حسنت","فنسّقت في بلاغة جمله",24,"ل",2,0],["الشعب في جزع فلا تستعبدوا","يوماً تثور به الجيوش وتزحف",25,"ف",1,0],["الشعر فَنٌ لا تزال ضُرُوبه","تتلو الشعور بألْسُن الموسيقى",26,"ق",2,0],["الشعر مفتقر مني لمبتكر","ولست للشعر في حالِ بمفتقر",27,"ر",1,1],["الشعر بعد مصابه بكبيره","في مصر جلّ مصابه بأميره",28,"ر",2,1],["الشعر كنت أميرة وسميرة","فمن المسامر بعد فقد سميرة",28,"ر",2,0],["الشعر قد ثلّت بمصر عروشه","بوفاة سيده وموت أميره",28,"ر",2,0],["الشاتِميَّ وَلَم أَهتِك حَريمَهُمُ","تِلكَ العَجائِبُ يا اِبنَي أُمَّ قَرّادِ",29,"د",1,0],["الشاتِمينَ بَني بَكرٍ إِذا بَطِنوا","وَالجانِحينَ إِلى بَكرٍ إِذا اِفتَقَروا",30,"ر",3,0],["الشمس أدتك إلا أنا امرأة","والبدر ادَّاك إلا أنه رجلُ",31,"ل",1,0],["الشِعرُ ديوانُ العَرَب","أَبَداً وَعُنوانُ الأَدَب",32,"ب",1,1],["الشامُ لابَلَدُ الجَزيرَةِ لَذَّتي","وَيَزيدُ لاماءُ الفُراتِ مُنائي",33,"ي",1,0],["الشائدين الملك بالهمم التي","وقف السهى ساهٍ لها يتعجب",34,"ب",1,0],["الشعر محتاجٌ إلى قابلٍ","والإبن محتاجٌ إلى قابلهْ",35,"ه",1,0],["ألشام منزلنا وأنت ملاذنا","دارٌ مباركةٌ وعزّ دائم",36,"م",1,0],["الشعر فيك ملك قابل","وقابل في الغير شيطانه",37,"ن",2,0],["أَلِشُكرٍ فعنديَ الشكر والحم","دُ الذي لم يزل له خُطَّابُ",38,"ب",1,0],["الشيءُ بالشيء يستَخفُّ به","والجِذْعُ ما لا يصونهُ شَذبُهْ",39,"ب",2,0],["الشيب أحلم والشبيبة أظرفُ","والرشد أسلم والغواية أترفُ",40,"ف",1,1],["الشَمسُ تُلقي في الصَباحِ حِبالَها","وَتَبيتُ تَنظُرُ في الغَديرِ خَيالَها",41,"ا",1,0],["الشَمسُ تَزَلُّ عَنِ الأُفقِ","كَالروحِ المُحتَضِرِ الساجي",42,"ي",1,0],["الشَعبُ مُبتَهِجٌ وَالعَرشُ مُغتَبِطٌ","وَروحُ جَدِّكَ في الفِردَوسِ تَحتَفِلُ",43,"ل",1,0],["الشَمسُ لي وَلَهُ وَلَألاءُ الضُحى","وَالنَيِّراتُ وَمِثلُنا المُتَسَوِّلُ",44,"ل",1,0],["الشَرقُ تاجٌ وَمِصرٌ مِنهُ دَرَّتُهُ","وَالشَرقُ جَيشٌ وَمِصرٌ حامِلُ العَلَمِ",45,"م",1,0],["الشُجاعُ عِندِيَ مَن أَم","سى يُغَنّي وَالدَمعُ في الأَجفانِ",46,"ن",1,0],["الشَيخُ يَلمُسُ في جَوانِبِها","صُوَرَ الهَوى وَالحِكَمَةَ الوَلدُ",47,"د",1,0],["الشَوقُ نارٌ حامِيَه","وَلقَد تَزايَدَ ما بِيَه",48,"ي",2,0],["الشِّعْرُ إنْ لم يكنْ في","جمالِهِ ذا جَلالِ",49,"ل",1,0],["الشَّاعرُ الموهوبُ يَهْرِقُ فنَّه","هدراً على الأقدامِ والأعْتابِ",50,"ب",1,0],["الشَمسُ تَخجَلُ مِن جمالِك","