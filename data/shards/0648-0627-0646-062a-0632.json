{"poems":[[55,"ألمع برق أم ضرم","https://www.aldiwan.net/poem29820.html","مجزوء الرجز"],[55,"أي طود دك من أي جبال","https://www.aldiwan.net/poem29889.html","الرمل"],[55,"آب الرديني والحسام معا","https://www.aldiwan.net/poem30137.html","المنسرح"],[88,"أي رجال الدنيا الجديدة مهلاً","https://www.aldiwan.net/poem10706.html","الخفيف"],[92,"أعيذك أن يعاصيك القصيد","https://www.aldiwan.net/poem60159.html","عموديه"],[102,"","https://poetry.dctabudhabi.ae/diwan/poem/142337","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54280","البسيط"],[240,"يا بأبي المختلس المستلب","https://www.aldiwan.net/poem32142.html","السريع"],[376,"دنا فزاد اشتعال الشوق بالبلل","https://www.aldiwan.net/poem57208.html","البسيط"],[408,"لكسب العلى فاجعل همومك تحمد","https://www.aldiwan.net/poem46939.html","الطويل"],[438,"لي في المصيف طريق","https://www.aldiwan.net/poem12420.html","المجتث"],[445,"بحكم العدل من قاضي السماء","https://www.aldiwan.net/poem34836.html","الوافر"],[463,"من موصل بالسؤال والقسم","https://www.aldiwan.net/poem55894.html","المنسرح"],[463,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61145","البسيط"],[1419,"","https://poetry.dctabudhabi.ae/diwan/poem/116681","الوافر"],[1421,"","https://poetry.dctabudhabi.ae/diwan/poem/117105","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124723","السريع"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26183","السريع"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87327","الرجز"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141210","السريع"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83228","الرمل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58280","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132683","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112659","الرجز"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112340","المتقارب"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94463","الوافر"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83201","الرجز"],[4469,"","https://poetry.dctabudhabi.ae/diwan/poem/103159","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72347","البسيط"],[4755,"ُرَوَّعٌ.. ما أَدَارَ العَينَ في جِهَةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=185918",""],[4954,"هلْ لي منْ غزالٍ سماحةً","https://www.poetsgate.com/ViewPoem.aspx?id=208832",""],[4984,"دوامة الفتن","https://www.poetsgate.com/ViewPoem.aspx?id=180639",""],[5009,"في ذكرى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=24366",""],[5081,"نَهْرُ الْحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=190167",""],[5277,"لا تطلقي الآهَ","https://www.poetsgate.com/ViewPoem.aspx?id=215148",""],[5770,"نجوى طائر","https://www.poetsgate.com/ViewPoem.aspx?id=178264",""],[161,"زَهْرَةُ الحيَاةْ","https://www.poetsgate.com/ViewPoem.aspx?id=202595",""]],"verses":[["وَاِنتَزَعَت مِن عِزِّهِم","تِلكَ العِمادَ وَالدُعُم",0,"م",1,0],["وَاِنتَزَعتَ النَصلَ مِن مُقلَتِها","بَعدَ غاياتِ نِزاعٍ وَمَطالِ",1,"ل",1,0],["وَاِنتَزَعَ الثارَ مِن مَظنَّتِه","مُعاجِلاً بِالدَمِ الَّذي اِنتَزَعَه",2,"ع",2,0],["وَاِنتَزَعتُم مِن كُلِّ شِبرٍ بِظَهرِ ال","أَرضِ أَو بَطنِها المُحَجَّبِ مالا",3,"ل",2,0],["وإن تَزِدِ الميوعةُ من بَنِيها","فأم الضرِّ والبلوى ولود",4,"د",1,0],["وانتزفت اللّحون من غور أغوا","ري كأنّي أذوب من كلّ مفصل",5,"ل",1,0],["وَإِنْ تَزُرْ كَعْبَةَ الآمالِ مُشْرِقَةً","مِنْ عابِدينَ فطُفء مِنها بأَرْكان",6,"ن",1,0],["وَانتَزَعَتهُ لِلمَنايا يَدٌ","مُغتالَةٌ مِن حُجرِ أُمٍّ وَأَب",7,"ب",1,0],["وإن تزَحزَحَ عن أرضٍ ثَبتَّ بِها","للدَّارِعَين ثَباتَ الرَّسمِ والطَّلَلِ",8,"ل",1,0],["وإنْ تَزْدَهيني والتُّقى لي رادعٌ","مَعَاطفُ خَوْدٍ أو سوالفُ أغيدِ",9,"د",1,0],["وإِنْ تزايَدَ شيئاً","فماءُ رأْسِ العَيْنِ",10,"ن",1,0],["وإِنْ تَزْدَدْ فَثانِيَةُ المثانِي","وإِنْ تَزْدَدْ فرابِعَةُ النِّساءِ",11,"ا",2,0],["وأن تزولَ الدنيا وأنت على","عهدك لي لم تَزُل ولم تَرِمِ",12,"م",1,0],["وانتزعَ العاملَ من قناته","فرُدَّ بالكُرهِ فشدَّ فحمَلْ",13,"ل",1,0],["وانتزع الحق من المحق","فرده لغير مستحق",14,"ق",1,0],["وَإِن تزد نقطة في كُل شَطر يَكن","نَعتاً لطعم شَهي الأَكل فَافتطن",15,"ن",1,0],["وأنتَ زَعَمتَ أنَّكَ مِن يزيدٍ","وَقَد أُدحِقتُمُ دَحَقَ العُبورِ",16,"ر",1,0],["وأنت زينة وادينا وبهجته","إذ كنت ترسل ألحانا فألحانا",17,"ن",2,0],["وإن تزد خمساً ففيها إذن","بنت مخاضٍ سنها أوضعُ",18,"ع",1,0],["وإن تزد عشرا فعيرانه","طروقه للفحل لا تمنعع",18,"ع",1,0],["وإن تزد واحدةً قبلها","تسعون في مبركها وقع",18,"ع",1,0],["وَاَنتَ زَيدُ الخَيلِ أَم عامِر","وَمالِكُ بنُ الرَيبِ أَم ذي الخِمار",19,"ر",1,0],["وَإن تَزِد أربَع على عشرينَا","في البَلدِ لَم يَحوِكَ يَا فطينَا",20,"ن",2,0],["وإن تزده النصف منه يكن","حاجب من يرمي بقلبي نبال",21,"ل",1,0],["وَاِنتَزِع مِن غاصِبٍ أَوطانَنا","شَرَفاً وَاِبعَث فَخاراً أَقدَما",22,"م",2,0],["وأَنتَ زوجُ الفراشِ لا عِشْتَ أَم أَن","تَ حكيمٌ كما يُقالُ بِوصلَه",23,"ل",2,0],["وأنت زعيم القوم واحد عصره","كريم المساعي راتق للفواتق",24,"ق",1,0],["وانتزعوا ملاحف النساء","وقد بدت تركض في البيداء",25,"ا",2,0],["وأنتَ زمان الخريف","فيا حزن روحي عليك",26,"ك",1,0],["وإن تزهو بأفلاك بدورٌ","فَكَم قد أخجلتها وجنتاها",27,"ا",3,0],["وَإِن تَزُرهُ وَهوَ في دِيوانِهِ","فَلا تُداعِبهُ لَدى إِخوانِهِ",28,"ه",1,0],["وانتزحت دولة التنائي","واقتربت دولة التداني",29,"ن",2,0],["وأنت زوج ابنة الهادي إلى سنن","من حاد عنه عداه الرشد فانخزعا",30,"ع",2,0],["وإِنْ تَزَمَّلَ مِثلي بالضَّيَاعِ بَكى","بُكاءَ مَن ضَيَّعَت كَفَّاهُ ما رَأَتَا",31,"ت",2,0],["وإنْ تزْعُمي أنّي سَلوْتُ فأمْعِني","فلمْ أسْلُ،غيْرَ أنّ حمْزةَ مشْهُودُ",32,"د",1,0],["وإن تزر أردنا أو جئت شارقة","سلم كطير شدا صبحا على فنن",33,"ن",1,0],["وإن تزل دولة الرومان فالتمسوا","في الإنجليز وفي الأمريك رومانا",34,"ن",2,0],["وَأَنْتَ زَعِيمُهُمْ لَوْ كُنْتَ تَدْرِي","وَقَدْرُكَ فِي الْفُؤَادِ يَزِيدُ قَدْرَا",35,"ر",2,0],["وإنْ تزيّلتي بالترحالِ عنْ وطني","لا تطلقي الآهَ...إنّ الآهَ فضّاحهْ",36,"ح",2,0],["وانتُزعت أكبادنا عُنوةً","فانصدعت تحت الحنايا قلوب",37,"ب",1,0],["وَ إنْ تَزْرَعِ الخَيْرَ النَّقَاءُ حَصَادُهُ","وَ تَجْنِيهِ أَرْضًا أَزْهَرَتْ ثَمَرَاتُهَا",38,"ت",3,0]]}