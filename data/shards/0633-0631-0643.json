{"poems":[[88,"أجاد مطران كعاداته","https://www.aldiwan.net/poem10857.html","السريع"],[75,"سرك الدهر وساء","https://www.aldiwan.net/poem11921.html","مجزوء الرمل"],[95,"إلى الأديب العبقري","https://www.aldiwan.net/poem9842.html","السريع"],[47,"عش حميدا في ظل عيش حميد","https://www.aldiwan.net/poem63491.html","الطويل"],[68,"سرك إن صنته بصمت","https://www.aldiwan.net/poem38561.html","مجزوء البسيط"],[70,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54931","الكامل"],[108,"تحية مولود","https://www.poetsgate.com/ViewPoem.aspx?id=179510",""],[47,"ما بِعَيْنَيْ هذا الغَزَالِ الغَرِيرِ","https://www.poetsgate.com/ViewPoem.aspx?id=31251",""],[47,"عش حميداً في ظل عيش حميد","https://www.poetsgate.com/ViewPoem.aspx?id=31607",""],[190,"قد ظهر الجور من الوالي","https://www.aldiwan.net/poem43468.html","السريع"],[484,"وقفوا هناك وحسبهم","https://www.aldiwan.net/poem36960.html","مجزوء الكامل"],[487,"لما يرى حبها فؤادي","https://www.aldiwan.net/poem24552.html","عموديه"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122886","الرمل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101048","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110327","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74043","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91637","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85072","الخفيف"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45075","الخفيف"],[4470,"","https://poetry.dctabudhabi.ae/diwan/poem/125350","الرجز"],[4806,"ماخنت ابنظر","https://www.poetsgate.com/ViewPoem.aspx?id=190863",""],[4882,"سمّي العراقَ اذا ما اصْلحتْ ذِمما-بهاء الدين الخاق","https://www.poetsgate.com/ViewPoem.aspx?id=11522",""],[5413,"العلم إكسير الرقي","https://www.poetsgate.com/ViewPoem.aspx?id=200577",""],[5693,"دائما أنت بقلبي.","https://www.poetsgate.com/ViewPoem.aspx?id=34962",""]],"verses":[["سَركيسُ إِن راقَكَ ما قُلتُهُ","في مَعرِضِ الهَزلِ فَقُل مِرسي",0,"س",2,0],["سَرَّكَ الدَهرُ وَساءَ","فَاقنَ شُكراً وَعَزاءَ",1,"ا",2,1],["سركيس قلبي بينكم حاضر","والجسم في قيد النوى بادي",2,"د",2,0],["سَرَّكَ اللَهُ بَل سُرورُكَ فيما","أَنتَ فيهِ مِنَ النَدى وَالجودِ",3,"د",1,0],["سِرُّكَ إِن صُنتَهُ بِصَمتٍ","أَصلَحَ بَينَ الأَنامِ خانَك",4,"ك",1,1],["سِرُّكُمْ عِنْديَ ما أعلَنَه","غَيرُ دمعٍ عَندَ ميٍّ عن دُمَي",5,"ي",1,0],["سِرْ كَيْفَ شِئْتَ لَكَ القُلُوبُ مَنَازِلٌ","أَنَّى انْتَقَلْتَ فَمِصْرُ فِي الأَمْصَارِ",6,"ر",1,0],["سرَّكَ اليوم قولهم أم ساءَكْ","حينَ قالوا: هذا غلامٌ جاءَكْ؟",7,"ك",1,1],["سَرّكَ الله في جَمِيعِ الأُمُورِ،","وَوقاكَ المَحذورَ بالمَحْذُورِ",8,"ر",1,0],["سرك الله بل سروك فيما","أنت فيه من الندى والجود",9,"د",1,0],["سر كيف ما شئت فإن الورى","في الكسب محتال ابن محتال",10,"ل",1,0],["سر كالزمان بحكمة","سير الليالي بالفصول",11,"ل",1,0],["سرك عندي خلال سري","لا لا أبوح وقد ارقت",12,"ت",1,0],["سرَّك اللَهُ بمن تلهو به","وبنوروزك يوم الجمعه",13,"ع",2,1],["سر كما شئت في طلاب المعالي","ليس من يطلب العلا بمليم",14,"م",1,0],["سركيسه اهل لبستانيه","وكلاهما للعلم أكرمُ آل",15,"ل",1,0],["سركيسُ حَسبُكَ قبّة","فضلت بِمَعناها القبب",16,"ب",1,0],["سرَّكم مِنهُ جَمالٌ ساعةً","وَأَنا اليَوم دُهوراً في هَوان",17,"ن",1,0],["سركم واحد وأنتم جيمعا","فيضكم من هبات تاج الرؤس",18,"س",1,0],["سَرَّكَ اللَهُ بالخَلاصِ مِنَ الأَس","رِ وَسامرتَ في الدُجى رَيحانَه",19,"ن",2,0],["سرٌّ كتيم لفظُه سيفٌ جسيمٌ لحظُه","شمسُ الضحى لا تختفي إلا بسحَّار سحر",20,"ر",1,0],["سرك والسوالف عايشات ابراس","ماصَبَح صُبُح وحجابهن مكشوف",21,"ف",1,0],["سرْ كاظميا والجوادين اللذان هما","ربّوك سيفا الى ال الهدى قلما",22,"م",2,0],["سِرْ كالهِزَبْرِ إلى المكارم مُوقنًا","أن الكفاح هو النجاح الأعظمُ",23,"م",1,0],["سرّكم يشفي العليل","وجدكم للذات يحبي",24,"ب",2,0]]}