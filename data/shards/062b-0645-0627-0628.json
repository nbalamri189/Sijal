سرح"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97101","الخفيف"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45035","الكامل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81931","الكامل"],[4434,"","https://poetry.dctabudhabi.ae/diwan/poem/130704","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58031","الكامل"],[412,"","https://poetry.dctabudhabi.ae/diwan/poem/31277","الخفيف"],[4591,"","https://poetry.dctabudhabi.ae/diwan/poem/144256","الكامل"],[4767,"عودة الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=94471",""],[1536,"بَارَكَ اللهُ لِلأَمِيرِ أَبِي الْعب","https://www.poetsgate.com/ViewPoem.aspx?id=85707",""],[5150,"شهادة الدم ...!","https://www.poetsgate.com/ViewPoem.aspx?id=204039",""],[5431,"صحوة الأرض...","https://www.poetsgate.com/ViewPoem.aspx?id=208842",""],[5533,"جاءَ البَشير","https://www.poetsgate.com/ViewPoem.aspx?id=186841",""],[5596,"وادي محرم","https://www.poetsgate.com/ViewPoem.aspx?id=206487",""],[5606,"العام الأول قلت باروح للصيد","https://www.poetsgate.com/ViewPoem.aspx?id=197740",""],[5887,"كفكف الدمع أنت على الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=37214",""],[5956,"خطفوا الصغيرة","https://www.poetsgate.com/ViewPoem.aspx?id=184696",""],[5956,"ضمُّ أحفادي لصدري","https://www.poetsgate.com/ViewPoem.aspx?id=193147",""],[6068,"أَمِنَ اللُّبَانَاتِ الَّتِي أَتَحَمَّلُ -10-","https://www.poetsgate.com/ViewPoem.aspx?id=175808",""],[6152,"دروب المجد","https://www.poetsgate.com/ViewPoem.aspx?id=207353",""],[6259,"لست في بينها الغداة بلاحِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59363&r=&rc=11",""]],"verses":[["ثُمَّ أَبو الفَضلِ مَع حَماقَتِهِ","يَقطَعُ عُمرَ النَهارِ بِالضَربِ",0,"ب",1,0],["ثمَّ أبدلت حين نقصت حرفاً","فوجدت القماش أصبحَ شاشا",1,"ش",2,0],["ثم آبوا فاستقبلَتْهُم حِسانٌ","من بناتِ النعيم فُقْن الحسانا",2,"ن",2,0],["ثُمَّ أَبقَت بِزَعمِها لِيَ عوداً","عَجَمَتهُ الخُطوبُ وَهُوَ صَليبُ",3,"ب",1,0],["ثُمَّ أَبدى نَدامَةً فَتَنَصَّل","تُ لِأُرضيهِ فَاِستَشاطَ فَعادا",4,"د",2,0],["ثُمَّ آبَت وَأَنتَ خَوفَ الغَمامِ ال","غَطِّ ذو فِكرَةٍ وَقَلبٍ خَفوقِ",5,"ق",1,0],["ثُمَّ اِبتَنى سَيِّدُ الكَونَينِ مَسحِدَهُ","بُنيانَ عِزٍّ فَأَضحى قائِمَ الدّعَمِ",6,"م",1,0],["ثُمَّ أَبدَت إِذ سَلَبتُ ال","مِرطَ مُبيَضّاً هَضيما",7,"م",2,0],["ثُمَّ أَبصَرتُ الَّتي زا","دَت عَلى الشَمسِ بُروعا",8,"ع",2,0],["ثم آبوا كالنُّجومِ الزُّهرِ في","نِعمةٍ ممّا أصابوا وَسَعَهْ",9,"ع",2,0],["ثُمَّ اِبنُ زَيدٍ بَعدَ ذاكَ قَد قُتِل","لَم يُنجِهِ حِصنٌ وَلا رَأسُ جَبَل",10,"ل",1,0],["ثُمَّ اِبتَدَرنا الطَيرَ في اِعتِلائِها","بَنادِقاً تُعجِبُ لِاِستِوائِها",11,"ا",3,0],["ثُمَّ اِبتَدَأنا الطِلا بِاللَهوِ مِن أَمَمٍ","في نِعمَةٍ غابَ عَنها الضيقُ وَالنَكَدُ",12,"د",1,0],["ثُمَّ آبائُهُ إِلى المُبتَدى مِن","آدَمَ لا أَبٌ وَأُمٌّ تَعُدَّه",13,"د",2,0],["ثم أبدت عن مشقٍّ","مثل صحراءِ العتيكْ",14,"ك",1,0],["ثُمَّ أَبري نِحاضَها فَتَراها","ضامِراً بَعدَ بُدنِها كَالهِلالِ",15,"ل",1,0],["ثم أَبكي بحرقة ثم أَبكي","هكَذا هكَذا ليوم الممات",16,"ت",1,0],["ثم أَبعدتها لأنظر فيها","ثم أَدنيتها إلى أحضاني",17,"ن",2,0],["ثم آبتْ إليكِ منكوسةَ الصو","رِ يئنُّ الجريحُ فيها أنينه",18,"ن",2,0],["ثم ابتغيت مودتي","أنى وقد علق الجناح",19,"ح",1,0],["ثم ابدَهيني كلَّ آونةٍ","منها بما يستامُني رَهَقا",20,"ق",2,0],["ثم ابن روبك قائم من دونه","ومخادع بالشعر للسلطان",21,"ن",1,0],["ثُمَّ اِبنُ هِندٍ باشَرَت نيرانُهُ","يَومَ أُوارات تَميماً بِالصلى",22,"ا",1,0],["ثُمَّ أَبدَت كَالأُقحُوانِ جَلَتهُ","شَمسُ دَجنٍ فَاِرفَضَّ عَنهُ السَقيطُ",23,"ط",1,0],["ثُمَّ ابتِسَامَتُهَا كَالبَرقِ عَن أُشرٍ","حَمشِ اللِّثاتِ تَرَى فِى ثَغرِها شَنَبَا",24,"ب",2,0],["ثم أبدلتني الرزايا بدار","منزل القرب بالمحل الشسيع",25,"ع",1,0],["ثم أبلغ الغاية القصوى أَبوحَسَن","وابتاه أَيضا وَعماه الكَريمان",26,"ن",1,0],["ثمَّ أبَحْتَ المُلوكَ كَفّاً","هامُوا بِتَقْبيلِها وَرِدْنَا",27,"ن",2,0],["ثمّ أبدتهُ كاملَ الخلقِ والخُل","قِ سريّاً سبطَ القفا والبنانِ",28,"ن",1,0],["ثمّ اِبتدرت مذكّراً مستنجزاً","وَعداً تقاضيه دليل تقرّبي",29,"ب",2,0],["ثُمَّ اِبتِداء ظُهور مِن مُلوك بَني","أُميَّةٍ حازَ تاريخاً بِرَمز إِلى",30,"ل",2,0],["ثم ابتَدى فاحتَوى على قَصب الس","سَبقِ على السابقين مُستاثِر",31,"ر",1,0],["ثم ابنِ فوق الطباق الخضر من شرف","يفرخ الدهر في أظلالها طبقا",32,"ق",2,0],["ثمَّ أَبْداهُ بالبُروزِ عَزيزاً","يا لِجَمْعٍ في مَهْمَهٍ فَرْقِيِّ",33,"ي",1,0],["ثُمَّ أُبنا وَالخَيلُ تَجنِبُ شُعثاً","كَالسَعالى عَفائِفاً وَمُحولا",34,"ل",2,0],["ثمَّ أبقى هكذا لا","مَن أراهُ ويَراني",35,"ن",2,0],["ثم إبليس ضل عنه وفيه","حسد قام واعترته الأماني",36,"ن",2,0],["ثم أبدى لحمةً منه له","حائك الأسماء لما ظهرا",37,"ر",2,0],["ثم ابن عفان عداه الخير","وطلحة الناكث والزبير",38,"ر",1,0],["ثم أبو بكر وبعده عمر","ثم معاذ في القضاء قد ذكر",38,"ر",1,0],["ثم ابن مسعود على ما خبروا","والشعري في القضاء ذكروا",38,"ر",3,0],["ثم ابن عوف ذكروه إذ برع","قلنا فمن يعد في حال الورع",38,"ع",1,0],["ثُمَّ اِبنُ أَيّوبٍ جاءَهُ خَلَفا","وَلَيسَ إِلّا سُروجِهِ سُرَرُ",39,"ر",1,0],["ثم ابنُه موسى ومن بعدِهِ","وارثُه علمَ وصاياهُ",40,"ا",2,0],["ثم ابنُه السِبطُ نِصف العامِ ثم أتى","بنو أميّةَ يبغون الوغى زُمَرا",41,"ر",2,0],["ثم ابنهُ وهو المهديُّ ماتَ لدى","تسعٍ وستينَ مسموماً كما ذُكِرا",41,"ر",2,0],["ثم ابنهُ وهو الهادي ومَوتَتُهُ","في عامِ سبعين لمّا همَّ أن غُدرا",41,"ر",2,0],["ثم ابنه الواثقُ المالي الوَرى رُعباً","وفي ثلاثين مع ثنتين قد غَبَرا",41,"ر",2,0],["ثم ابنُه المكتفي باللَه أحمدُ في","خمسٍ وتسعينَ سُبحانَ الذي قَدَرا",41,"ر",2,0],["ثم ابنهُ الطائعُ المقهورُ مخلعُهُ","عام الثمانين مع إحدى كما أَثَرا",41,"ر",2,0],["ثم ابنُه قائمٌ باللَهِ ماتَ لدى","سبعٍ وستينَ من شعبانَ قد سُطرا",41,"ر",2,0],["ثم ابنُهُ الراشدُ المقهورُ مخلَعُهُ","من بعدِ عامٍ فلا عَينٌ ولا أَثَرا",41,"ر",2,0],["ثُمَّ آبوا بجانِبٍ طَيِّب النَّشْ","رِ وَأُبْنا بِجانِبٍ مَحْبوز",42,"ز",1,0],["ثم أبقتْ فيها الذين طوالَ الدْ","د هر لما نجِدْ إليهم سبيلا",43,"ل",2,0],["ثم آبُوا بالخِزى منها وبالخيْ","بة والخُسْر والردى والنفاد",44,"د",1,0],["ثم ابنِ عفانَ في الجنانِ معَ ال","أبرارِ ذلك القتيل مُصطَبِرا",45,"ر",2,0],["ثُمَّ ابنُهُ مِن بَعدِهِ فَتَمَنَّعَت","وَإِخَالُ أَنَّ قَرِينَهُ لَم يَخذُلِ",46,"ل",1,0],["ثم أبو عمرو أبو الذكاء","وهو الذي يعزى إلى العلاء",47