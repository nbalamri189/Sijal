{"poems":[[53,"بود الرذايا أنها في السوابق","https://www.aldiwan.net/poem29954.html","الطويل"],[44,"أرامة كنت مألف كل ريم","https://www.aldiwan.net/poem30367.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85477","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85587","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39590","الطويل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/142182","الوافر"],[129,"توفى بحر الجود والزهد والتقى","https://www.aldiwan.net/poem50512.html","الطويل"],[148,"أمسعود جاء السعد والخير واليسر","https://www.aldiwan.net/poem47624.html","الطويل"],[190,"مقام أجل الرسل أعلى وأعظم","https://www.aldiwan.net/poem35106.html","الطويل"],[212,"وصوت بغوم في الصباح سمعته","https://www.aldiwan.net/poem46270.html","الطويل"],[212,"حضرنا ننظر النهرا","https://www.aldiwan.net/poem46274.html","مجزوء الوافر"],[224,"أتيت فأورق الأدب السني","https://www.aldiwan.net/poem41440.html","الوافر"],[257,"جميع ما لي صدقه","https://www.aldiwan.net/poem48524.html","مجزوء الرجز"],[271,"لقد هاج الهوى هذا الحرير","https://www.aldiwan.net/poem35446.html","الوافر"],[271,"أرى حبي شرارا مستطيرا","https://www.aldiwan.net/poem35589.html","الوافر"],[305,"غزال الحمى قلبي بحبك قد ملى","https://www.aldiwan.net/poem16887.html","الطويل"],[343,"وليلة قضيتها في الاسى","https://www.aldiwan.net/poem55332.html","السريع"],[365,"لها في حمى مني وراء الترائب","https://www.aldiwan.net/poem60994.html","الطويل"],[367,"لعينيه على العشاق إمره","https://www.aldiwan.net/poem17205.html","الوافر"],[404,"لقد صدرت إلى أعلى مقام","https://www.aldiwan.net/poem33449.html","الوافر"],[417,"بحيث انعطف البان","https://www.aldiwan.net/poem54026.html","الهزج"],[430,"يهيجني التذكار عشقا ولوعة","https://www.aldiwan.net/poem41065.html","الطويل"],[440,"هو البدر في فلك المجد دارا","https://www.aldiwan.net/poem34793.html","المتقارب"],[450,"ربيع العمر","https://www.aldiwan.net/poem1014.html",""],[454,"مسكينة إن من خانوك أوقحهم","https://www.aldiwan.net/poem61279.html","البسيط"],[459,"شوارد حظ لا يقر نفورها","https://www.aldiwan.net/poem56200.html","الطويل"],[465,"سقى دمع العين لا دموع الغمائم","https://www.aldiwan.net/poem3271.html","عموديه"],[465,"أما واللمى وجداً بساكنه الملا","https://www.aldiwan.net/poem3589.html","عموديه"],[539,"يا طيب الإسم والأفعال والشيم","https://www.aldiwan.net/poem47937.html","عموديه"],[559,"صدقت عباد الله أسماؤه الحسنى","https://www.aldiwan.net/poem33741.html","الخفيف"]],"verses":[["وَفي شِدَّةِ الدَهرِ اِعتِبارٌ لِعاقِلٍ","وَفي لَذَّةِ الدُنيا غُرورٌ لِواثِقِ",0,"ق",1,0],["وَفي شَرَفِ الحَديثِ دَليلُ صِدقٍ","لِمُختَبِرٍ عَلى الشَرَفِ القَديمِ",1,"م",1,0],["وَفي شَيخوخَتي سأَسير منه","وإن الشيخ ليسَ له مآب",2,"ب",1,0],["وَفي شهيق المعاني","نَ للأسى وَالزَفير",3,"ر",1,0],["وفي شُعَبِ الوادي وفوقَ رماله","عصِيُّ نبيٍّ أو تهاويلُ ساحرِ",4,"ر",1,0],["وفي شفتي أبيات حزاني","تغنت وهي تجهش للصباح",5,"ح",1,0],["وفي شهر شعبان توافتْ وفاتُه","بتدبيرِ خلاَّقِ البريةِ حاكمِ",6,"م",1,0],["وفي شمّها حقا بذلنا نفوسنا","فهان علينا كلّ شيء له قدر",7,"ر",1,0],["وَفي شرعهِ كلٌّ إمامٌ مقدّمُ","عليهِ عبادَ اللَّه صلّوا وسلّموا",8,"م",3,0],["وفي شهر يوليو سوف نشرب أكؤسا","نحيى بها تلك السنين الثمانيا",9,"ي",2,0],["وفي شطيه ملعبه","بها صور وولدان",10,"ن",1,0],["وَفي شَفَتَيكِ إِغواءٌ لَذيذٌ","يَذوبُ عَلَيهِ قُربانٌ نَقِيُّ",11,"ي",1,0],["وفيشتي لا بد أن","أسبكها في البوتقة",12,"ق",2,0],["وفي شفتيكِ لي ماءٌ ونارٌ","فقلبي لابتِسامِهما مُنير",13,"ر",1,0],["وفي شهَواتهِ يُبدي عَفافاً","ويُظهِرُ نارَهُ للناسِ نورا",14,"ر",2,0],["وفي شهوات ليس يحمد غيها","وفي غفلات رخصة المتأول",15,"ل",1,0],["وفي شجون طال تردادها","وفي شؤون انقضت كلكلي",16,"ل",2,0],["وفي شُعبِ الأكوارِ ميلاً من الكرَى","عصائبُ ألوْى لوْنُهُم بالعصائب",17,"ب",1,0],["وَفي شِعرِ الوَرى غُرٌّ وَدُهمٌ","وَهَذا كُلُّ بَيتٍ مِنهُ غُرَّه",18,"ر",2,0],["وفي شرح المواقف كم وقفنا","عليه وقوف صب مستهام",19,"م",1,0],["وفي شكري لنعمائك","إعلامٌ وإعلان",20,"ن",1,0],["وفي شرح تأليف العذار مسطر","أساطير ياقوت كتبن بذي ند",21,"د",1,0],["وَفِي شَنْتِ ياقُبَ أَوْرَدْتَها","شوارِبَ يَبْغِينَ فِي البحرِ ثارا",22,"ر",2,0],["وفي شفة تخبئ عقد درّ","وتتخذ السلافة سلسبيلا",23,"ل",2,0],["وفي شقائك يتلو حوله سورا","من النفاق وتبدو مثل فاديك",24,"ك",1,0],["وفي شطَطِ الآمالِ فيك لنفسه","وأكثرُ آمالِ النفوس غُرورُها",25,"ر",3,0],["وفي شركة الألفاظ عندي حفيظة","وأين هشام من ذوائبه هاشم",26,"م",1,0],["وفي شعب الأكوار كلُّ ابن لوعة","إذا هاجها برد النسيم تململا",27,"ل",2,0],["وفي شفاكَ شفاءُ الرأيِ من خَطَلٍ","وفي شِفاكَ شفَاءُ العدلِ والهِمَمِ",28,"م",1,0],["وفي شغل عن ربهم أهل جنة","كما الله في القرآن أسمعه الأذنا",29,"ن",2,0]]}