{"poems":[[55,"حييا دون الكثيب","https://www.aldiwan.net/poem30763.html","مجزوء الرمل"],[74,"رب غيث رام أن يحكي ندى","https://www.aldiwan.net/poem19660.html","الرمل"],[53,"رب غلام وجهه لا يفضحه","https://www.aldiwan.net/poem9417.html","الرجز"],[53,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[91,"افتحوا للفتى الهضيم الطريقا","https://www.aldiwan.net/poem44844.html","الخفيف"],[47,"أبلغ ذفافينا رسالة مشتاق","https://www.aldiwan.net/poem66811.html","المنسرح"],[46,"رب غليظ الطباع يغلظ عن","https://www.aldiwan.net/poem30000.html","المنسرح"],[50,"رب غزال كأنه قمر","https://www.aldiwan.net/poem62561.html","المنسرح"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19262","الرمل"],[108,"في ربا الخلد","https://www.poetsgate.com/ViewPoem.aspx?id=179685",""],[108,"فيلسوف الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179354",""],[369,"زد علوا في كل يوم ورفعه","https://www.aldiwan.net/poem60844.html","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59242","الخفيف"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64594","الطويل"],[1439,"","https://poetry.dctabudhabi.ae/diwan/poem/178007",""],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109699","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77202","الخفيف"],[2638,"","https://poetry.dctabudhabi.ae/diwan/poem/142139","الخفيف"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11262","الرجز"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100740","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117848","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114526","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103004","الخفيف"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35445","الكامل"],[1901,"حببَّتْني فيكَ أيامُ الصِّبا","https://www.poetsgate.com/ViewPoem.aspx?id=160374",""],[4915,"غيبوبة !","https://www.poetsgate.com/ViewPoem.aspx?id=212763",""],[5431,"وفؤادي مشعشعٌ لا أفولُ","https://www.poetsgate.com/ViewPoem.aspx?id=197691",""],[5431,"هذا بعلي!!....","https://www.poetsgate.com/ViewPoem.aspx?id=201150",""],[5853,"((غيمٌ بلا مخاض))","https://www.poetsgate.com/ViewPoem.aspx?id=175650",""],[6244,"ما هو الكون ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=510&r=&rc=3",""]],"verses":[["رُبَّ غاوٍ طُرُقَ المَج","دِ طُروقَ المُستَريبِ",0,"ب",1,0],["ربَّ غيث رام أن يحكي ندىً","لكَ فينا ثمَّ ولَّى واسْتحال",1,"ل",1,1],["رُبَّ غُلامٍ وجهُهُ لا يفْضَحُهْ","في بيت عزٍّ لا يُرامُ مُسْرَحُهْ",2,"ح",2,1],["رُبّ غرمول نائكٍ لم تَهُلْه","شعراتٌ تلوحُ في استك شُمط",3,"ط",1,0],["رب غر اذا علا اكمة ظنّ","غرروا ان صافح العيوقا",4,"ق",2,0],["رُبَّ غَداةٍ لِلقَصفِ في حَلَبٍ","يَجني ضُحىً وَردَها وَسَوسَنَها",5,"ن",3,0],["رُبَّ غَليظِ الطِباعِ يُغلِظُ عَن","رِقَّةِ مِثلي في لَحمِهِ وَدَمِه",6,"م",2,1],["رُبَّ غَزالٍ كَأَنَّهُ قَمَرٌ","لاحَ فَجَلّى الدُجونَ في البَلَدِ",7,"د",1,1],["رُبَّ غَرسٍ مَرَّ لِلبِرِّ بِها","ماجَ بِالخَيرِ وَالسَمحِ المُنيل",8,"ل",1,0],["ربَّ غازٍ في الله ما سلَّ سيفًا","وهُو أمضى من صارم ابنِ الوليد",9,"د",1,0],["رب غِرٍّ رام منه لفْتةً","فرماهُ بالنُّعُوت المقذعة",10,"ع",2,0],["رُبَّ غُرٍّ من غِلمةٍ وجيادٍ","أَن أَتتْه من صارخِ الحَيِّ فَزْعه",11,"ع",2,0],["رُبَّ غُصْنٍ هَزَزْتُ مائسَ عِطْفِه","وَغزَالٍ غازَلْتُ ناعسَ طَرْفِهْ",12,"ف",2,1],["رب غوثاه جلها ظلمات","بؤت فيها بصفقة المغبونِ",13,"ن",1,0],["ربّ غلامٍ صار في","بغداد إحدى الفتن",14,"ن",1,1],["رب غيدٍ تختال في يوم عيدٍ","كغصون من فوقها اقمارُ",15,"ر",1,1],["رُبَّ غَمٍّ عَنِ القَريضِ لَواني","وَهُمومٍ رَبّي بِهِنَّ البَصيرُ",16,"ر",1,0],["رب غرٍ رأى الأمور كما تبدو","لعينيه فاستراح وأغضى",17,"ض",2,0],["رُبَّ غَريبٍ ناصِحِ الجَيبِ","وَاِبنِ أَبٍ مُتَّهَمِ الغَيبِ",18,"ب",1,1],["ربَّ غاوٍ تلفظ قولاً","عدَّ ما بين قومهِ ثرثارا",19,"ر",2,0],["ربّ غثنا بهم فإنك بالعب","اس غثت الأنام عام الرماده",20,"د",2,0],["رُبَّ غُصنٍ بَرَى فُؤادي فإنِّي","كَنَسيمٍ من أن يُمِيلَهُ أخفى",21,"ف",2,1],["ربّ غِرٍّ مستنصرٍ بالأماني","مثلما استنصر الثكول العويلا",22,"ل",2,0],["رَبُّ غَفورٌ لَو يُؤاخِذُ خَلقَهُ","لَم يَبقَ دِيّاراً مِنَ الأَحياءِ",23,"ا",2,0],["رُبَّ غُصنٍ قد ذوتْ أوراقَهُ","فسقاهُ الغيثُ مُزْنا فنبَتْ",24,"ت",1,0],["رُبَّ غيبوبةٍ تُشابهُ وعياً","ظنَّها الحُمقُ ثورةً فأَتاها",25,"ا",3,0],["ربّ غمٍ مسلطٍ مثل سيفٍ","يتمادى في طعنه لو يطولُ",26,"ل",1,0],["ربّ غيثٍ يُخفف الحرْقَ يهمي","في روابي بحرقة تشتهيه",27,"ي",2,0],["رُبَّ غيمٍ بلا مخاضٍ نراه","ووجيبٍ بنشوةٍ يتوهمْ؟",28,"م",1,0],["رب غاوٍ يلومني في نشيدي","وهو لا ينتهي عن الفحشاءِ",29,"ا",2,0]]}