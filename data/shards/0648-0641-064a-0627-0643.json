{"poems":[[72,"يعز علي فقدك يا علي","https://www.aldiwan.net/poem42403.html","الوافر"],[45,"عقبى اليمين على عقبى الوغى ندم","https://www.aldiwan.net/poem10529.html","البسيط"],[276,"أرى برق الغوير اذا تراءى","https://www.aldiwan.net/poem52103.html","الوافر"],[287,"هب نسيم بالطل مبلول","https://www.aldiwan.net/poem32639.html","المنسرح"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17570","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64939","المجتث"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79819","الطويل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116511","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72775","السريع"]],"verses":[["وَفي أَكفانِهِ نَدبٌ سَرِيٌّ","تَخَلَّفَ بَعدَهُ ذِكرٌ سَنِيُّ",0,"ي",1,0],["وَفي أَكُفِّهِمِ النارُ الَّتي عُبِدَت","قَبلَ المَجوسِ إِلى ذا اليَومِ تَضطَرِمُ",1,"م",1,0],["وَفي اكناف طيبة هاشمي","تصرفه السَماحَة حيث شاء",2,"ا",2,0],["وَفي أَكُفِّ المَنثورِ مُنتَظِماً","مِن كُلِّ لَونٍ يَروقُ مَعمولُ",3,"ل",1,0],["وَفي أَكلُب عِزّ تِلادٌ وَطارِفٌ","بعيد مِنَ التَقصيرِ وَالتَبراتِ",4,"ت",1,0],["وفي اكْتِسابِ سُرورٍ","مِنْ خَيْرِ طالعِ نَجْمِ",5,"م",1,0],["وفي أكبد الأبطال تُغرس سمرهم","ومن دَمها خرصانُهنَّ نواهل",6,"ل",1,0],["وفي اكله نهش ويختار عجوة","ففيها من السم الشفا ومن السحر",7,"ر",1,0],["وفي اكفّ الكفِّ عن كل مَن","يُحبَّه الإنعام قد بردا",8,"د",2,0]]}