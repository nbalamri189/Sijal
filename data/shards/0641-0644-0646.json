{"poems":[[55,"ليس الحبيب على ما كنت تعهده","https://www.aldiwan.net/poem26066.html","الخفيف"],[55,"لعمري لقد جلبت نظرتي","https://www.aldiwan.net/poem26176.html","المتقارب"],[9,"أجدك لم تغتمض ليلة","https://www.aldiwan.net/poem21928.html","المتقارب"],[24,"بان الشباب وأمسى الشيب قد أزفا","https://www.aldiwan.net/poem21869.html","البسيط"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[86,"سل قاهر الفرس والرومان هل شفعت","https://www.aldiwan.net/poem68918.html","البسيط"],[5,"إن لله علينا نعم","https://www.aldiwan.net/poem309.html",""],[93,"حي العزيمة والشبابا","https://www.aldiwan.net/poem9790.html","عموديه"],[93,"من عذيري والدمع جار سخين","https://www.aldiwan.net/poem11202.html","الخفيف"],[88,"لو كنت أعبد فانيا في ذي الدنى","https://www.aldiwan.net/poem44427.html","الكامل"],[88,"ياسين إنك بالقلوب مشيع","https://www.aldiwan.net/poem44806.html","الكامل"],[27,"أقلي اللوم عاذل والعتابا","https://www.aldiwan.net/poem5686.html","الوافر"],[27,"لجت أمامة في لومي وما علمت","https://www.aldiwan.net/poem5769.html","البسيط"],[27,"أتنسى يوم حومل والدخول","https://www.aldiwan.net/poem5965.html","الوافر"],[27,"حي الغداة برامة الأطلالا","https://www.aldiwan.net/poem5968.html","الكامل"],[37,"ألا لا أرى الأيام يقضى عجيبها","https://www.aldiwan.net/poem6494.html","الطويل"],[23,"إن تصلح فإنك عابدي","https://www.aldiwan.net/poem21390.html","الوافر"],[51,"أيها المهدي ثناء جميلا شارك التنميق فيه الصواب","https://www.aldiwan.net/poem8504.html","الخفيف"],[51,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[51,"يا ابن الوزيرين سمعا من أخي طلب","https://www.aldiwan.net/poem10000.html","البسيط"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[51,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[51,"آليت أهجو كريما عند نبوته","https://www.aldiwan.net/poem66339.html","البسيط"],[91,"لا تسل أين الهوى والكوثر","https://www.aldiwan.net/poem8828.html","عموديه"],[91,"إذا سحقت أرضنا القنبله","https://www.aldiwan.net/poem62634.html","عموديه"],[91,"دار السلام وأرض الهنا","https://www.aldiwan.net/poem62784.html","عموديه"],[70,"قال لي العاذل تسلو","https://www.aldiwan.net/poem43031.html","مجزوء الرمل"],[38,"ألا يا اسلمي حييت أخت بني بكر","https://www.aldiwan.net/poem7715.html","الطويل"],[89,"ماذا برقراق السحائب","https://www.aldiwan.net/poem44965.html","مجزوء الكامل"],[85,"يحكون أن أمة الأرانب","https://www.aldiwan.net/poem8038.html","الرجز"],[45,"بوركت من قبل ظريف كيس","https://www.aldiwan.net/poem64592.html","الكامل"],[45,"تبيت له من شوقه ونزاعه","https://www.aldiwan.net/poem64716.html","الطويل"],[28,"فأنت إذ لم تكن إياه صاحبه","https://www.aldiwan.net/poem5082.html","البسيط"],[28,"يا ابن المراغة إنما جاريتني","https://www.aldiwan.net/poem5241.html","الكامل"],[2,"بان الخليط ولم يأووا لمن تركوا","https://www.aldiwan.net/poem25061.html","البسيط"],[58,"أمن بعد تكفين النبي ودفنه","https://www.aldiwan.net/poem31202.html","الطويل"],[49,"خير أيام الفتى يوم نفع","https://www.aldiwan.net/poem62155.html","الرمل"],[66,"تغرب وابغ في الأسفار رزقا","https://www.aldiwan.net/poem38545.html","الوافر"],[44,"لامته لام عشيرها وحميمها","https://www.aldiwan.net/poem30348.html","الكامل"],[44,"دنف بكى آيات ربع مدنف","https://www.aldiwan.net/poem30401.html","الكامل"],[31,"أبهجر يودع الأجوار أم","https://www.aldiwan.net/poem42534.html","الخفيف"],[33,"فإن يحجبوها أو يحل دون وصلها","https://www.aldiwan.net/poem25903.html","الطويل"],[105,"أما والليالي وأحداثها","https://www.aldiwan.net/poem43141.html","المتقارب"],[105,"لمن تجمع الروم أبطالها","https://www.aldiwan.net/poem44030.html","المتقارب"],[105,"ما للسيوف أما تثوب فتعطف","https://www.aldiwan.net/poem44198.html","الكامل"],[105,"إلى القوم الألى جمعوا الجموعا","https://www.aldiwan.net/poem44203.html","الوافر"],[105,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[81,"أهدى نسيم الصباح","https://www.aldiwan.net/poem61390.html","المجتث"],[40,"أقول اشتكاء بالحرام لصاحبي","https://www.aldiwan.net/poem42296.html","الطويل"],[22,"سالت قرابين بالخيل الجياد لكم","https://www.aldiwan.net/poem21698.html","البسيط"],[50,"تعجبت جارتي مني وقد رقدت","https://www.aldiwan.net/poem63950.html","البسيط"],[7,"فلن أذكر النعمان إلا بصالح","https://www.aldiwan.net/poem1937.html","الطويل"],[46,"أواني هم فألقى أواني","https://www.aldiwan.net/poem23545.html","المتقارب"],[19,"عيني لا بد من سكب وتهمال","https://www.aldiwan.net/poem360.html",""],[19,"أبا دليجة من لحي مفرد","https://www.aldiwan.net/poem361.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[22,"","https://poetry.dctabudhabi.ae/diwan/poem/732","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39569","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42609","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42564","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54656","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54517","الرمل"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12640","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54290","المجتث"],[106,"أنصاف رجال","https://www.poetsgate.com/ViewPoem.aspx?id=179440",""],[90,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[24,"بان الشبابُ وأَمْسَى الشَّيْبُ قد أَزِفَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10871&r=&rc=12",""],[31,"أبهَجْرٍ يُوَدَّعُ الأَجْوَارُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18868&r=&rc=131",""]],"verses":[["فَلَن تَزالَ عَلَيهِ العَينُ باكِيَةً","وَلَن يَعودَ إِلى ما كانَ ما كانا",0,"ن",2,0],["فَلَن تَستَطيعَ إِلَيها الصُعودَ","وَلَن تَستَطيعَ إِلَيكَ النُزولا",1,"ل",2,0],["فَلَن يَطلُبوا سِرَّها لِلغِنى","وَلَن يُسلِموها لِإِزهادِها",2,"د",3,0],["فَلَن أَزالَ وَإِن جامَلتُ مُضطَّغِناً","في غَيرِ نأَرَةٍ ضَبَّا لَها شَنَفا",3,"ف",2,0],["فلن تَعيبَ حَصيفَ الرأيِ زَلّتُه","حتى يَعيبَ سُيوفَ الهِندِ يَطويها",4,"ي",3,0],["فَلَن تَعيبَ حَصيفَ الرَأيِ زَلَّتُهُ","حَتّى يَعيبَ سُيوفَ الهِندِ نابيها",5,"ي",3,0],["فَلَنا الفَضلُ عَلَيهِم بِالَّذي","صَنَعَ اللَهُ فَمَن شاءَ رَغَم",6,"م",1,0],["فَلْنْقضِ مِنْ حَقِّ الْحِمَى","مَا لَيْسَ يَأْلُوهُ ارْتِقَابَا",7,"ب",2,0],["فَلْنحَيِّ النِّقَابَةَ اليَوْمَ قَامَتْ","وَلَهَا عِنْدَ قَبْرِهِ تَكْوِينُ",8,"ن",1,0],["فَلْنكْنِه بأبي اليتامى بعد ذا","إذ لا يخاطب مثله بسوى الكنى",9,"ن",2,0],["فَلنَملأنّ بك البلاد هزاهزاً","حتى يضيق بها الفضاء الأوسع",10,"ع",1,0],["فَلَن تَسطيعَ حَنظَلَتى وَسُعدى","وَلا عَمرى بَلَغتَ وَلا الرِبابا",11,"ب",2,0],["فَلَن تَزالَ لِهَذا الدينِ ما عَمِروا","مِنكُم عَمارَةُ مُلكٍ واضِحِ الغُرَرِ",12,"ر",1,0],["فَلَن تَسطيعَ يا اِبنَ دَعيِّ تَيمٍ","عَلى دَحضٍ مُزَحَمَةَ القُيولِ",13,"ل",1,0],["فَلَنَحنُ أَكرَمُ في المَنازِلِ مَنزِلَ","مِنكُم وَأَطوَلُ في السَماءِ جِبالا",14,"ل",2,0],["فلن تجد الآذان إلا مطيعة","لها في الرضا أو ساخطاتٍ قلوبُها",15,"ب",3,0],["فَلَن أَنفَكَّ أَهجو عابِدِيّاً","طَوالَ الدَهرِ ما نادى المُنادي",16,"د",2,0],["فلنا منه العلومُ الصَّفايا","ولنا منه العطايا الرِّغابُ",17,"ب",1,0],["فلن تعدموا ما حنَّت النيَّب فتنةً","تُحشُّ كما حُشَّ الحريقُ المؤجَّجُ",18,"ج",1,0],["فلَنْ أرَى اليأس نَعْياً حين يُؤيسُنِي","من سَيْب كفِّك بل بشرى بمولودِ",19,"د",1,0],["فلن تراه وفي عرفٍ يجود به","ترشيح شكر وهل للغيث مُتَّجر",20,"ر",1,0],["فلنا ندى من كفِّه ولنا هدىً","من رأيه في الليل ذي الأغباس",21,"س",1,0],["فلنُعمى يديك أولى بأن تَنْ","مَى على الدهر من رواسي الجبالِ",22,"ل",1,0],["فلن أرى ما تولاني به تِرةً","بل نعمةً تستحق الشكرَ بل نِعَما",23,"م",2,0],["فَلنَعِش في الأَرضِ زَهراً وَليَطُل","أَجَلُ الشَوكِ الَّذي لا يُزهِرُ",24,"ر",1,0],["فَلَن يُدَعَ المَوتُ حَيّاً يَلو","مُ سِواهُ عَلى هَذِهِ المَقتَلَه",25,"ل",2,0],["فَلُندُنُ أَرحَبُ مِن قُدسِنا","وَأَنتُم أَحَبُّ إِلى لُندُنا",26,"ن",2,0],["فَلِنَفسي أَنا أُطري","وَلِنَفسي أَنا أَطرَب",27,"ب",1,0],["فَلَن تَشرَبي إِلّا بِرَنقٍ وَلَن تَرَي","سَواماً وَحَيّاً بِالقُصَيبَةِ فَالبِشرِ",28,"ر",1,0],["فَلَن يَنشُرَ المَوتى وَلَن يُذهِبَ الجِزى","هَوِيُّ القَوافي بَينَ أَنيابِكَ الخُضرِ",28,"ر",1,0],["فلننتظر حتى نرى","من ذا من الجيشين غالب",29,"ب",1,0],["فَلنَدعُهُ يُمِدُّنا بِحِكمَتِهِ","وَيَأخُذُ اِثنَينِ جَزاءَ خِدمَتِهِ",30,"ه",1,0],["فَلَنِعمَ رَيحانُ النَدامى أَنتَ إِن","عَزَموا الصَبوحَ وَنِعمَ حَشوُ المَجلِسِ",31,"س",1,0],["فَلَن تَكبُرَ الدُنيا عَلَيهِ بِأَسرِها","وَقَد وَسِعَتها ساحَةٌ مِن رِباعِهِ",32,"ع",2,0],["فَلَن تَزالُ لَكُم وَاللَهُ أَثبَتَها","فيكُم إِلى نَفخَةِ الرَحمَنِ في الصورِ",33,"ر",1,0],["فَلَنَحنُ أَوثَقُ في صُدورِ نِسائِكُم","عِندَ الطِعانِ وَقُبَّةِ الجَبّارِ",34,"ر",1,0],["فَلَن يَقولوا بِحَبلٍ واهِنٍ خَلَقٍ","لَو كانَ قَومُكَ في أَسبابِهِ هَلَكوا",35,"ك",3,0],["فَلَن يَستَقِلَّ الناسُ ما حَلَّ فيهُمُ","وَلَن يُجبِرَ العَظمُ الَّذي مِنهُمُ وَهَى",36,"ا",1,0],["فَلِنَفسي عِلَلٌ لاتَنقَضي","وَلَها مَكرٌ لَطيفٌ وَخُدَع",37,"ع",1,0],["فَلَن تَجِدَ الثَراءَ بِغَيرِ سَعيٍ","وَهَل يوري الزِنادُ بِغَيرِ قَدحِ",38,"ح",1,0],["فَلَنا أَمينُ فُصوصِها وَشُخوصِها","وَلَها وَرِيُّ سَديفِها وَلُحومُها",39,"م",3,0],["فَلِنُؤيِها في القَلبِ نُؤيٌ شَفَّهُ","وَلَهٌ بِظاعِنِها وَبِالمُتَخَلِّفِ",40,"ف",1,0],["فَلَنَفسي أَحَقُّ بِاللَومِ عَمداً","حَيثُ ما كُنتُ يَومَ لُفَّ الجِمارُ",41,"ر",1,0],["فَلَن يَمنَعوا عَينَيَّ مِن دائِمِ البُكا","وَلَن يُخرِجوا ما قَد أُجَنَّ ضَميري",42,"ر",2,0],["فَلَن يَلبَثَ الأَمرُ أَن يَستَقيمَ","إِذا اِجتَمَعَ القَومُ بَعدَ الشَتاتِ",43,"ت",1,0],["فلن يَعرِفَ النّاسُ أمثالَهم","ولن يَشهد الدّهرُ أمثالَها",44,"ل",3,0],["فَلنُخرجَنَّ مُحمداً منها غَداً","وليعلمنَّ الأمرَ ساعةَ يأزف",45,"ف",1,0],["فلن تجد الوليَّ ولا الشفيعا","يقول غويرثٌ كن خيرَ مولى",46,"ل",2,0],["فلن تجدَ الشريكَ ولا المثيلا","أَجلْ اللّهُ أكبرُ لا مِراءَ",47,"ا",2,0],["فَلَن يَزالَ حَبيسا","يُطوى عَلَيكَ وَيُنشَر",48,"ر",1,0],["فَلِن لِلَّذي يَهواكَ وَاغلُظ عَلى الَّذي","قَلاكَ وَعَوِّدهُ الَّذي قَد تَعَوَّدا",49,"د",2,0],["فَلَن تُحِبّوا لَنا خَيراً وَوُدُّكُمُ","لَنا يَبيسٌ عَلَتهُ النارُ فَاِضطَرَما",50,"م",2,0],["فَلَن أَكونَ حَديداً في مَقالَتِكُم","كَما خُلِقتُ وَلا صَوّانَةً صَلَدا",51,"د",2,0],["فَلَن أَذكُرَ النُعمانَ إِلّا بِصالِحٍ","فَإِنَّ لَهُ عِندي يُدِيّاً وَأَنعُما",52,"م",2,1],["فَلَن تَقذَيا بِاِغتِفارِ الذُنوبِ","وَلَكِن بِغُفرانِها تَصفُوانِ",53,"ن",1,0],["فَلَن يَزالَ ثَنائي غَيرَ ما كَذِبٍ","قَولَ اِمرِئٍ غَيرَ ناسيهِ وَلا سالي",54,"ل",2,0],["فَلَنِعمَ رِفدُ الحَيِّ يَنتَظِرونَهُ","وَلَنِعمَ حَشوُ الدِرعِ وَالسِربالِ",55,"ل",1,0],["فلناس تعاشةٌ وشقاءٌ","ولناسٍ سعادةٌ وسرور",56,"ر",1,0],["فَلَن تَعلِفونا الضَيمَ ما دامَ جِذمُنا","وَلَمّا تَرَوا شَمسَ النَهارِ اِستَسَرَّتِ",57,"ت",1,0],["فلنحبَّ الغداة ولنحي حُبَّا","ولنكنْ في الحياةِ بعضاً لبعضِ",58,"ض",1,0],["فلن تُنبِتَا فيه إلَّا السلامَ","والحُبَّ والزهَرَ الأبيضا",59,"ض",2,0],["فَلَنِعْمَ ما بَقِيَتْ لَدَيَّ مَهَابَةٌ","تَقْذَى بِهَا عَيْنُ الْعِدَا وَوَقَارُ",60,"ر",1,0],["فَلَنِعْمَ ذَاكَ الْعَيْشُ لَوْ لَمْ يَنْقَضِ","وَلَنِعْمَ هَذَا الْعَيْشُ إِنْ لَمْ يَنْفَدِ",61,"د",1,0],["فَلْنُيَمِّمْ شَطْرَ الطَّبِيبِ وَفِي الرَّوْ","ضَةِ مَا يُجْتَنَى بِكُلِّ التِفَاتِ",62,"ت",1,0],["فَلَنَا اليَوْمَ بِهِ أَجْنِحَةٌ","وَلَنَا أَبْطَالُنَا وَالشُّهَدَاءْ",63,"ا",2,0],["فَلَن أَصِحَّ إِذا ما كانَ ذا سَقَمٍ","وَلَن أَعيشَ إِذا ما اِستُودِعَ اللَحَدا",64,"د",2,0],["فَلَنْ يَرُوعَكِ رِقٌّ","وَلَنْ يَمَسَّك أَسرُ",65,"ر",1,0],["فلن ترضاه كالطاووس شكلاً","ولكن كاسرًا مثل العقاب",66,"ب",1,0],["فَلْنرجّف أعصابهَ وهو يقظانُ","ونزعجْ أحلامه وهو نائم",67,"م",1,0],["فلن أزالَ ، وإنْ جاملتُ ، مضطغِناً","في غيرِ نائرِة ٍ ضبَّا لها شنَفَا",68,"ف",2,0],["فَلَنَفْسي أَحَقُّ بِکللَّوْمِ عَمْداً","حيثُ ما كنتُ يومَ لفّ الجمار",69,"ر",1,0]]}