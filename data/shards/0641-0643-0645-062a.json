.poetsgate.com/ViewPoem.aspx?id=206377",""],[5616,"أبها","https://www.poetsgate.com/ViewPoem.aspx?id=205245",""],[5667,"الطبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=214892",""],[5689,"على قدر ما تعطي الملاح من الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=143395",""],[5730,"تساؤلات عاشقة","https://www.poetsgate.com/ViewPoem.aspx?id=210417",""],[5736,"حزن","https://www.poetsgate.com/ViewPoem.aspx?id=208888",""],[5762,"سلمى","https://www.poetsgate.com/ViewPoem.aspx?id=13134",""],[5830,"يَاقُدْسُ","https://www.poetsgate.com/ViewPoem.aspx?id=200771",""],[5908,"لي لا لغيري آلت نوبة الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=170970",""],[5956,"شكرتُ عواطفَ الناي الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=207913",""],[6004,"الخَطِيئة","https://www.poetsgate.com/ViewPoem.aspx?id=59138",""],[6031,"جَذَّ الردَى سَبَبَ الإسلامِ فَانْجذَمَا","https://www.poetsgate.com/ViewPoem.aspx?id=46278",""],[6093,"العيد","https://www.poetsgate.com/ViewPoem.aspx?id=198363",""],[6102,"قاف قهر","https://www.poetsgate.com/ViewPoem.aspx?id=184627",""],[199,"أَتَعْرِفُ الدارَ أَمْ لا تعرفُ الطَّلَلاَ","https://www.poetsgate.com/ViewPoem.aspx?id=20770",""],[6120,"يَحِنُّ قَلبِي لِأيَّامٍ مِنَ الغَزَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=213518",""],[6142,"لمن أذيل عقيق الأدمع السجم","https://www.poetsgate.com/ViewPoem.aspx?id=155760",""],[6142,"ما أوتيت أنبياء الله قبل من ال","https://www.poetsgate.com/ViewPoem.aspx?id=155711",""],[6182,"سقوف الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86106&r=&rc=3",""],[2220,"الله يعلمُ نفسي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11246&r=&rc=120",""],[6300,"الأعْيُنُ النُجُل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81627&r=&rc=4",""],[6318,"رسالة المسجد الأَقصى إلى المسلمين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66163&r=&rc=13",""]],"verses":[["فَكَم تَكونُ ناظِماً وَقائِلاً","وَأَنتَ غِبَّ القَولِ غَيرُ فاعِلِ",0,"ل",1,0],["فَكَم تَلاحَكَ بابُ الخَطبِ ثُمَّ رُمي","بِقارِعٍ مِن يَمينِ اللَهِ فَاِنفَتَحا",1,"ح",2,0],["فَكَم تُجَرِّعُني غَيظاً تَفورُ بِهِ","جَوانِحٌ بِتُّ أَطويها عَلى لَهَبِ",2,"ب",1,0],["فَكَمْ تُقيمُ بِأَرْضٍ في خَمائِلِها","مَرْعىً يَضيقُ على مَهْرِيَّةٍ نَفَشِ",3,"ش",1,0],["فَكَمْ تَمَرَّسَ بي في الفَخْرِ جاهِلُهُمْ","تَمَرُّسَ الأَجْرَبِ المَهْنوءِ بِالطّالي",4,"ل",2,0],["فكَم تُدمي أخِشَّتَها بِسَيرٍ","يُحَكِّمُ في غَوارِبِها الرِّحالا",5,"ل",2,0],["فَكَمْ تُنَضِّدُ رَيْحَاناً وَتَفْرِشُهُ","فِي مَسْقِطٍ خَرِبٍ أَوْ مَنْزِلٍ خَالِي",6,"ل",2,0],["فكمْ تَلْعةٍ قد كلّلَ النَّوْرُ تاجَها","ورَفّ علَيْها للنّباتِ نَسيجُ",7,"ج",1,0],["فكم ترى العين خرقاً غير مرتقع","في جانبيه وفتقاً غير مَنصوح",8,"ح",1,0],["فكم تكوني تعستِ رافعة","رجلاً للعب المدَحلجة حَلجَهْ",9,"ج",2,0],["فَكَم تَماوَجَ في سِربالِ غانِيَةٍ","وَكَم تَأَلَّقَ في أَسمالِ مِسكينِ",10,"ن",1,0],["فَكَم تَخَطَّت إِلَيكُم مِن ذَوي تِرَةٍ","كَأَنَّ أَبصارَهُم نَحوي مَساميرُ",11,"ر",1,0],["فكم تثقف في ناس به عوج","وكم تهذب في ناس به خلق",12,"ق",1,0],["فَكَم تَرَكوا مِن ناشئٍ ذو حَمِيَّةٍ","صَريعاً وَمِن ذي نَجدَةٍ مِنهُمُ كَهلِ",13,"ل",1,0],["فَكَم تَرى عَزَّ عِندَ ذَلِكَ مِن","مَعشَرِ قَومٍ وَذَلَّ مِن مَعشَر",14,"ر",1,0],["فَكَم تَرى مِن أَسيرٍ لا حِراكَ بِهِ","وَشارِدٍ سارَ مِن فَجٍّ إِلى أَكَمِ",15,"م",1,0],["فَكَمْ تَرَى بَيْنَهُمْ مِنْ شَاعِرٍ لَسِنٍ","أَوْ كَاتِبٍ فَطِنٍ أَوْ حَاسِبٍ فَهِمِ",16,"م",1,0],["فكمْ تهدي لقومِكَ مِنْ سبابٍ","ولستُ بمنكرٍ منكَ الهدايا",17,"ا",3,0],["فَكَم تَرى مِن مُجَوِّدٍ أَظهَرَ ال","عَبّاسُ مِنهُ طِباعَ مَستوقِ",18,"ق",1,0],["فَكَمْ تَرَكْنا بِها مِنْ سَيِّدٍ بَطَلٍ","حامي الذِمارِ كريمِ الجَدّ والحَسبِ",19,"ب",1,0],["فكم تمنّيتُ لكن","ماذا أفاد التمنِّي",20,"ن",2,0],["فَكَمْ تَرَكُوا مِنْ ناشىء ٍ ذِي حَمِيَّة","ٍ صَريعا وَمِنْ ذِي نَجْدَة ٍ مِنْهُمُ كَهْلِ",21,"ل",1,0],["فكم ترشفت معسولاً بمبسمها","وكم تثنى على عطفيّ عسالُ",22,"ل",1,0],["فكَم تزوجتُ بنتَ كرمٍ","صلّى عليها أبو نواسِ",23,"س",1,0],["فَكَم تَستُرُ الشَوقَ الَّذي خامَرَ الحَشا","وَدَمعُ المَآقي لِلمُحِبِّينَ فاضِحُ",24,"ح",1,0],["فَكَم تَمضُغُ الأَيّامُ لَحمي وَأَنتُمُ","نُيوبٌ لَها تَستَهلِكُ اللَحمَ وَالدَما",25,"م",2,0],["فَكَم تضمّن مِن آلاف مُعجزةٍ","تَفسيرُها ما له في الناس تأويلُ",26,"ل",1,0],["فكم تدفعون الحقَّ والحقُّ واضحٌ","دنا منكُم ما كان ليس بِدانِ",27,"ن",1,0],["فكم تغضبُ الغاداتُ عمداً ولم تزل","تُنقِّرُ حبَّا ثم تقطَعُ أشراكا",28,"ك",2,0],["فكم تعَشَّقتُ بكراً","في خدِّها زَغبات",29,"ت",1,0],["فكم تُضَحُّونَ مِنّا حائمين على","تلكَ الضحيّاتِ كالغُربان والرّخم",30,"م",1,0],["فكم تحتَها دَمعاً وكم فوقها ندى","أجَفَّتهُما شمسُ الضُحى ولماك",31,"ك",1,0],["فَكَم تقسم قَلبي نية عرضت","مَقسومة بين انجاد واغوار",32,"ر",1,0],["فَكَم تُحالِفُ قَوماً لا وَفاءَ لَهُم","وَلا عُهودٌ وَلا دِينٌ وَلا ذِمَمُ",33,"م",1,0],["فكم توالى الليلُ بعدَ النهارِ","وطالَ بالأنجمِ هذا المدارِ",34,"ر",1,0],["فكم تورعتُ عن مولى تعرض لي","رفهتُ عنه ولول أتعبته ظلعا",35,"ع",2,0],["فكم تَرى رجلاً فيها بلا عمَلٍ","وكم تَرى عَمَلاً فيها بلا رَجُل",36,"ل",1,0],["فَكَم تَعالى قِفا نَبكِ وَأَسيَرُ مِن","أَبياتِها فَوقَ أَلفاظِ الوَرى مَثَلا",37,"ل",2,0],["فَكَم تَعَللَّتُ فيهِ بِالمُنى","وَذَلِكَ الصَفوُ قَد أَودى بِهِ الكَدَرُ",38,"ر",1,0],["فكَمْ تخيّلتُ في عينيكِ أمثلة ً","تلتَفُّ حولَ زماني، حَوْلَ خاصِرَتي",39,"ت",2,0],["فكم تحجَّبتَ عن عيني فأرَّقها","منكم حجابٌ ولكن لستَ تستتر",40,"ر",1,0],["فكم تفضل وكم أولى","على عصاة وفجار",41,"ر",1,0],["فَكَم تركنا هلال الكأسِ طالعة","فيهِ تُغَيِّب هَمَّ النَفسِ مطلِعُهُ",42,"ع",2,0],["فكم تجلّى لنا من وجهه قمرٌ","فراح يجلو به همّي وأحزاني",43,"ن",2,0],["فكم تركوا في المادحين أخا ندًى","قديم العُلى يسعى الممجد ممجّد",44,"د",1,0],["فكَمْ تركوا معاهِدَ مُوحشاتٍ","عَفَتْ حَتَّى عفا فِيهَا العفاءُ",45,"ا",2,0],["فكم تمتع سمعي والهوى أمم","يوماً بأوصاف شهم طيب الأثر",46,"ر",1,0],["فكم تموتُ ويُحييها برجعته","وكم تَعُقُّ أباها الخالقَ الباري",47,"ر",2,0],["فكم تركوا منهم هُماماً على الثّرى","طريحاً ومنهُ الرأسُ بالجوِّ طائِرُ",48,"ر",1,0],["فكم تزهو به جنّاتُ حُسْنٍ","وكم تجري عليهِ عُيونُ عانِ",49,"ن",1,0],["فكمْ تنازلتَ عن عينيكَ ذاتَ هوًى","وما تنازلتَ عَمَّنْ فيهما سَكَنَا",50,"ن",2,0],["فَكم تَدرّون شرّاً كلّ شارقةٍ","وإنّما الشرُّ يُستَدنى بإبساسِ",51,"س",1,0],["فكم تسيئون ظناً تغلبون به","فيظهر القهر والدنيا لمن قهرا",52,"ر",2,0],["فكم تركتَ بها كَفَّاً بلا عَضُدٍ","وقد توسَّدها رأْسٌ بلا عُنق",53,"ق",1,0],["فكَمْ تَركَتْ في ذَلكَ الحي مَيِّتاً","وكم حَمَلَتْ مِنْها الضُّلوعُ عَلى ظَلْعِ",54,"ع",1,0],["فَكَمْ تَلقاهُ بالإِبْعا","دِ وَالإِيْعَادِ والنَّفْرَهْ",55,"ر",2,0],["فَكَم تَحسُنُونِ لِشَرِ يَعُمُّ","ولا تَحسُنُون لِخيرٍ يَخُص",56,"ص",1,0],["فَكَم تائِبٍ مُستَغفِرٍ مُتَيَقِّنٍ","بِمَغفِرَة تَهمي بفيض سجالها",57,"ل",3,0],["فكم تغطّي الهدى جهلاً وتستره","بأسود الكفر والايمان يقشعه",58,"ع",2,0],["فكم تبدَّلَ حالٌ واعترَتْ نُوَبٌ","وأنت كالطوْدِ ما اهتزتْ له جُنُبُ",59,"ب",1,0],["فكم تراها إلى لقياه هايمةً","تشوّقاً كلما قد حان موسمها",60,"م",3,0],["فكم تراها إذاً تسدي الدعاءَ له","إذ لم تجد مثله من كان يرحمها",60,"م",3,0],["فكم ترى وهبة الحنّان والده","يبكيه في أدمعٍ كالسحب مندفقهْ",61,"ق",2,0],["فكم ترغب العلياء عن وصل معرض","وكم ترغب العلياء في وصل مغرم",62,"م",1,0],["فكم توبة أخلصتها بتثبت","وكم نقضتها النفس بعد التثبت",63,"ت",1,0],["فكم تعرضها قوم وما بلغوا","منها المنى وقصارى نعتهم تعب",64,"ب",1,0],["فكم ترى عملاً فيها بلا رجلٍ","وكم ترى رجلاً فيها بلا عمل",65,"ل",1,0],["فكم ترى فيئكم نهباً وشرعكم","ممزقاً وكتاب اللَه مهجورا",66,"ر",2,0],["فكم تذكرت بها","سرور عيش ظعنا",67,"ن",2,0],["فكم ترى في الخلق من آيةٍ","خفيّة الجسمان في قعر",68,"ر",1,0],["فكم تراه في فن","اه ركعاً وسجدا",69,"د",2,0],["فكم تَثَنَّتْ بوشْيِ الخَزِّ ناعمةٌ","حوراءُ ساليةٌ للصبِّ حَوْبَاهُ",70,"ا",2,0],["فكم تحت أستار الخطوب فوائد","وما ساء خطب وخزه أيقظ الشعبا",71,"ب",2,0],["فكم تقيمون على ذلة","وروضة الصبر ذو آسها",72,"س",3,0],["فكم توبة قد تابها فأضاعها","فمن سيء أخفى بما حسن أبدى",73,"د",2,0],["فكم تركت لحفظ الملك من أسد","عَبْل الذِّراعين مرهوب المخاليبِ",74,"ب",1,0],["فكم تبتُ وما تبتُ","فلم أحظَ بمطلوبِ",75,"ب",1,0],["فكم تغنى لها الحادي ورنحها","سجع الحمام على القُضْب الأماليد",76,"د",1,0],["فكم تمنيت نفوسٌ","إدراكها واطمأنت",77,"ت",1,0],["فكم تسنمت من صعب العلوم مطا","وكم كشفت من الرمز الخفي عطا",78,"ط",2,0],["فكم تركوا علة لا تبوخ","ونار جوى في الحشى تشتعل",79,"ل",1,0],["فكم تعد نازلاً وصاعداً","أطائباً ان نزلوا أو صعدوا",80,"د",3,0],["فكمْ تروِي بأدمعِنا خدوداً","لنا جرحَى وأنفسُنا صوادِ",81,"د",1,0],["فكم تحيي المواليَ بامتنان","وكم تُرْدي المعاديَ باجتياح",82,"ح",1,0],["فكم تُحيلُ على الأَيّام صُنْعَك بي","ودونَه تَعْجز الأيّام والأُمَم",83,"م",1,0],["فَكَم تَرى أَطوابنا إِذ هدَرَت","مِثل صَواعِق السَما إِذ رَعَدت",84,"ت",1,0],["فَكَم ترى تَطايُر البِناء","كَم أَرسَلَت شَخصاً إِلى الفَناء",84,"ا",2,0],["فكم ترى في الحان من شارب","يحرّم الخمر بأفعاله",85,"ل",2,0],["فكم تصوّح عودى بعد نضرته","وكم خبا فيدياجي عمرى الأمل",86,"ل",1,0],["فكم تجلت بوجه منه مظلمة","وكم تحلت بعين منه آثار",87,"ر",1,0],["فكم تراني صابراً للبلا؟","ستغلب البلوى على صبري",88,"ر",2,0],["فكم تركوا محرابَ آيٍ معطلاً","وكم تركوا من ختمةٍ لم تتمم",89,"م",1,0],["فكم ترى من مذاع","أهدى لضنك القبور",90,"ر",1,0],["فَكَم تَعاطَينا بِهِ","خمر أَحاديث الأدَب",91,"ب",1,0],["فَكُم تَرَكوا جَيشاً كَثيراً عَديده","عَلَيهِ تَطيل الثاكِلات عَديدا",92,"د",2,0],["فكم تحرصُ الدُّنيا لتحظى بودّه","فيصرف وجهَ الزهدِ عن رغبة الحرص",93,"ص",1,0],["فَكَم تَجلّى صَباحٌ من مُنَى أَملٍ","إِذا دُجَى اليَأسِ في جون الظَلام دَجَا",94,"ج",2,0],["فَكم تقرّ عيونٌ من لقاء فتىً","حتى تكذّبَها الأَخبارُ وَالمَلَكَه",95,"ك",2,0],["فَكَم تهتّكتَ يَوم البين إِذ عجلت","بِكَ المَطايا وَجادَ الدَمعُ إِذ بَخِلوا",96,"ل",3,0],["فكم تهت من قد هناك وطلعة","بغصن ولا غصن وبدر ولا بدر",97,"ر",1,0],["فكم ترى من قاذف مُقَزّز","من الغداء والعشاء محترز",98,"ز",1,0],["فكم تلاعب بالإمجاد حادثه","كما تلاعبت الغلمان بالأكر",99,"ر",1,0],["فَكَم ترحةٍ فيهِ أديلَت بِفَرحةٍ","وَكَم حالِ عُسرٍ فيهِ آلَت إِلى اليسرِ",100,"ر",1,0],["فكم تعدى الطرف منك حدا","في مهجتي ولم أقل تعدّى",101,"د",2,0],["فَكَم تَرى لِلشَيخِ مِن خريج","في عِلمِهِ ذي خُلُق بَهيج",102,"ج",1,0],["فَكَم تَحَلَّت بِنُظمي كُلُّ غانِيَةٍ","عِقداً أَفصِلُهُ دُراً وَعُقيانا",103,"ن",2,0],["فكم تصغر قدري","وكم تصحر خدك",104,"ك",1,0],["فكم تركت أخا لب صريعا