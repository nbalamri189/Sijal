امل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72789","الرمل"],[4724,"ماس وغصونه مواريجي","https://www.poetsgate.com/ViewPoem.aspx?id=25792",""],[4767,"شمس الإمامة","https://www.poetsgate.com/ViewPoem.aspx?id=180572",""],[4899,"الغني الله","https://www.poetsgate.com/ViewPoem.aspx?id=179784",""],[4924,"صاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=34877",""],[5160,"يا شباب الجيل","https://www.poetsgate.com/ViewPoem.aspx?id=175135",""],[5186,"لا تعد بي إلى ربوع الخيام","https://www.poetsgate.com/ViewPoem.aspx?id=156442",""],[5364,"المرجلة ماهي ب خواريف واوهام","https://www.poetsgate.com/ViewPoem.aspx?id=177124",""],[5459,"فلق الصبح","https://www.poetsgate.com/ViewPoem.aspx?id=201909",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5848,"بديت اختنق","https://www.poetsgate.com/ViewPoem.aspx?id=53326",""],[5848,"الدلوعه","https://www.poetsgate.com/ViewPoem.aspx?id=50613",""],[5956,"البلدة السعيدة","https://www.poetsgate.com/ViewPoem.aspx?id=185792",""],[5956,"كم من نتائج حققت لقيانا","https://www.poetsgate.com/ViewPoem.aspx?id=192239",""],[5956,"هلّل إلى التحرير","https://www.poetsgate.com/ViewPoem.aspx?id=192293",""],[4442,"يبدو الشباب بشكل الخرد العين","https://www.poetsgate.com/ViewPoem.aspx?id=171001",""]],"verses":[["بالترك بالروم بالألبان قاطبة","بالأرمنيين بالبلغار باللاز",0,"ز",1,0],["بالتسعة المتتابعين","خلائفاً وبخير عاشر",1,"ر",1,0],["بِالتَلِّ تَلِّ رَبيعَ بَينَ مَواضِعٍ","مازالَ دينُ اللَهِ فيها يوقى",2,"ق",2,0],["بِالَّتي قَد كُنتُ آمُلُها","فَفُؤادي موجَعٌ حَذِرُ",3,"ر",1,0],["بِالتَلِّ وَالجَوسَقِ وَالقَطائِعِ","كَم ثَمَّ مِن دارٍ لَهُم بِلاقِعِ",4,"ع",1,0],["بِالَّتي إِن جِئتُ أَخطُبُها","حُلِّيَت حَلياً مِنَ الذَهَبِ",5,"ب",1,0],["بِالتَّقِيِّ النَّقِيِّ مِنْ كُلِّ عَيْبٍ","كعْبَةِ الفَضْلِ قُدْوِةِ الأَتقياءِ",6,"ا",2,0],["بالتصابي يُذكي الشبابُ ويغتُّر","كما بالرِّياح يُذكى اللهيب",7,"ب",1,0],["بِالتيهِ تاهَ ضَلالاً","عَن ظِلِّ كَهفِ رَقيمَه",8,"م",2,0],["بالتجلي لك تبدو خلقة","ثم تخفى ليس تدري ما هي",9,"ي",1,0],["بالتبر في التاريخ دُوّن ذكرهم","بل خير ذكر بالثناء مخلد",10,"د",1,0],["بِاِلتِياعٍ وَغَرامٍ أحرما","مُقلَتَيهِ ذَوقَ طَعمِ النّعسِ",11,"س",1,0],["بالتعفّف تلقاه ملتحفاً","بالتَّكرم تلقاه مُشتملا",12,"ل",2,0],["بالتسع من ذي الحجة اعتلنت لنا","بشراه واحتاطت بكل بلاد",13,"د",1,0],["بِالتَهاني وَالأَماني","بَينَ ناياتٍ وَعودِ",14,"د",1,0],["بالتسع من ذي الحجة اعتلت لنا","بشراه واحتاطت بكل بلاد",15,"د",1,0],["بالتماس الرضا وَترك المَعاصي","وَببذل اليدين بالإِنفاق",16,"ق",1,0],["بالتّأني فِيْ خطاها تستخيل","كنّها تمشي عَلَى مايٍ زلال",17,"ل",1,0],["بالتملى وبالرجا والسرور","يا حياتي والمنزل المعمور",18,"ر",1,0],["بالْتَعكُر المحروس أَو بالمنظر الْ","مأْنوس نَجْمَيْ فَرْقَدٍ وسِماكِ",19,"ك",1,0],["بالتصاريفِ بعدما وَهَنَتهُ","يا لِعبدٍ فى جهلهِ دَفَنَتهُ",20,"ه",1,0],["بالتقى والنهى بلغت مقاما","شأوه في الزمان ليس يسامى",21,"م",2,1],["بالتّنس قد لعبت فتاة بضّة","لا غرو إن فاقت على الأقرن",22,"ن",1,1],["بالتُّرْسِ تسْرِي الشمسُ فوق أُفْقِهِ","والصُّبْحُ يلْقاه بعَضْبٍ مُنْتضَى",23,"ا",1,0],["بالتبع المعمول خمسة يعد","فالنعت والعطف كمن جدّ وجد",24,"د",1,1],["بِالتَّأنِّي يُدْرِكُ المَرْءُ وكَمْ","فَازَ مِقْدَامٌ وَأصْحَابُ العَجَلْ",25,"ل",1,0],["بِالتِفَاتٍ عَطفَةً فَتَرَى","دَمعَ جَفنِي بِكَ قَد فَتَرَا",26,"ر",2,0],["بِالتَهاني وَبالمَسَرَّةِ حَيّا","فَليُقِم في السُرورِ مادامَ حَيّا",27,"ي",2,0],["بالتثني قد حكت قامتُها","سدرة الحسنِ وهذا منتهاها",28,"ا",3,0],["بالتقى أوصى مصاديجي","والوفا ومتابع السنّه",29,"ن",2,0],["ب (التوبة) المختارُ أرجعَ غيرَه","حتى يبلغَها الإمام بما معَه",30,"ع",2,0],["بالتجاره فيه ربح ومخسرا","التجاره مابها رجلً فريم",31,"م",1,0],["بالتواصيف ماله بالبشر جنس","خف دم وجمال وقد وعيون",32,"ن",1,0],["بالتسامح والتآخي","بالمحبة كُنْ بهيَّا",33,"ي",2,0],["بالتآخي نحيى وبالعلم نهنا","وننال المرام بعد المرام",34,"م",1,0],["بالتضحية والصبر حطمنا الارقام","رغم المصاب ورغم كل من طعنا",35,"ن",2,0],["بالْتئام الشمل نبني غدَنَا","وبِهِ نَرتِقُ ما قد فُتِقَا",36,"ق",2,0],["بالترنم بينهن ورق الحمام","حركن مني اشجونٍ خافيات",37,"ت",1,0],["بالتفاق بين سادات عظام","سنو الاشهر عليهم حارمات",37,"ت",1,0],["بالتقي بالدموع ومعك عنك افترق","في ملامح حنانك يالصغير الكبير",38,"ر",1,0],["بالتعب والحزن والهم وهلمّ جرا","وونةٍ تسمع وونة ماهي ب مسموعة",39,"ع",2,0],["بالتسلِّي بمزاحٍ فكَهِيٍّ","عَزَّ أن يُوغِرَ صدراً أو يُهِينْ",40,"ن",1,0],["بالتوعياتِ وغيرها في \"واتسنا\"","ونُشيدُ أركاناً بنت أركانا",41,"ن",2,0],["بالتكنولوجيا بالتقدمِ عالياً","وبأحدث التصنيع والخُطُواتِ",42,"ت",1,0],["بالتين اقسم من نهديك بارزة","فان بدا حاجب أقسمت بالنون",43,"ن",1,0]]}