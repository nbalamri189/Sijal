{"poems":[[53,"أذاع بذي العهد عرفانه","https://www.aldiwan.net/poem29731.html","المتقارب"],[53,"لو كان يرتدع القضاء بمردع","https://www.aldiwan.net/poem30148.html","الكامل"],[63,"جهد الصبابة أن أكون ملوما","https://www.aldiwan.net/poem46195.html","الكامل"],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[73,"أضحى التنائي بديلا من تدانينا","https://www.aldiwan.net/poem11836.html","البسيط"],[93,"لانت صلاب العزائم","https://www.aldiwan.net/poem11341.html","المجتث"],[72,"ليلاي كم ليلة بالشعر ليلاء","https://www.aldiwan.net/poem18172.html","البسيط"],[72,"فتانة الصب تجلى في حماه فيا","https://www.aldiwan.net/poem19558.html","البسيط"],[51,"قلبي من الطرفِ السقيم سقيم","https://www.aldiwan.net/poem66338.html","الكامل"],[91,"أنا من أنا يا ترى في الوجود","https://www.aldiwan.net/poem8977.html","عموديه"],[89,"ابناء دجلة والفرات نيام","https://www.aldiwan.net/poem44882.html","الكامل"],[89,"وصف الدنيا كثيرون","https://www.aldiwan.net/poem44886.html","مجزوء الرمل"],[45,"شط من ساكن الغوير مزاره","https://www.aldiwan.net/poem63580.html","الخفيف"],[99,"من مفكرة عاشق دمشقي","https://www.aldiwan.net/poem5856.html","عموديه"],[58,"ما هذه الدنيا وطالبها","https://www.aldiwan.net/poem31058.html","السريع"],[49,"دار بليت بحبها خوانة لمحبها","https://www.aldiwan.net/poem10386.html","مجزوء الكامل"],[66,"يعطى البليد مع الخمول من الغنى","https://www.aldiwan.net/poem38554.html","الكامل"],[66,"ضعف رأسي وقلة الإيمان","https://www.aldiwan.net/poem39039.html","الخفيف"],[66,"كان الزمان بلقياكم يمنينا","https://www.aldiwan.net/poem40132.html","البسيط"],[69,"هذي فصوص لم تكن","https://www.aldiwan.net/poem28042.html","مجزوء الكامل"],[69,"اترك بحقك ما يقول المبغض","https://www.aldiwan.net/poem28754.html","الكامل"],[69,"مربع يخلو ودمع يكف","https://www.aldiwan.net/poem28817.html","الرمل"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[46,"إن التجارب طير تألف الخمرا","https://www.aldiwan.net/poem22614.html","البسيط"],[46,"ما لمت في أفعاله صالحا","https://www.aldiwan.net/poem22744.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85508","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85308","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39552","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30455","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54214","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205801","الخفيف"],[99,"من مفكرة عاشق دمشقي","https://www.poetsgate.com/ViewPoem.aspx?id=568",""],[3,"دَعني أَجِدُّ إلى العَلْيَاءِ في الطَّلبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10658&r=&rc=12",""],[109,"يا أخا الريم في النفار وكالغص","https://www.aldiwan.net/poem16470.html","الخفيف"],[109,"هب يجلو الراح في كاس اللجين","https://www.aldiwan.net/poem16521.html","الرمل"],[143,"بك اقتضى الدين دينا كان قد وجبا","https://www.aldiwan.net/poem11722.html","البسيط"],[143,"هو ذاك ربع المالكية فاربع","https://www.aldiwan.net/poem11770.html","الكامل"],[197,"أترعي الأقداح يا حوا","https://www.aldiwan.net/poem39879.html","مجزوء الرمل"],[204,"ما تركت اللقاء يوم الفراق","https://www.aldiwan.net/poem53223.html","الخفيف"],[207,"أبلغ قحافة عنا في ديارهم","https://www.aldiwan.net/poem27941.html","البسيط"],[210,"أنا قاصم الأعداء في يوم الوغى","https://www.aldiwan.net/poem13561.html","الكامل"],[211,"وجهه البدر في ليل التمام","https://www.aldiwan.net/poem46276.html","الرمل"],[223,"نام إلا الهوى فأهلك ناموا","https://www.aldiwan.net/poem39722.html","الخفيف"],[223,"شاعر الدمع ما جنيت بشيء","https://www.aldiwan.net/poem41636.html","الخفيف"],[225,"سفرت فلاح لنا هلال سعود","https://www.aldiwan.net/poem55248.html","الكامل"],[235,"ما كنت أول حافظ لمضيع","https://www.aldiwan.net/poem31823.html","الكامل"],[235,"حان إسفار الصباح","https://www.aldiwan.net/poem32120.html","مجزوء الرمل"],[237,"أبلغهم مألكا عن قلب من ملكوا","https://www.aldiwan.net/poem18848.html","البسيط"],[250,"ما لي أراك أضعت ودي","https://www.aldiwan.net/poem14944.html","مجزوء الكامل"],[280,"لئن عداني زمان عن لقائكم","https://www.aldiwan.net/poem60782.html","البسيط"],[282,"روحي مذللة بحب مدلله","https://www.aldiwan.net/poem32649.html","الكامل"],[297,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[304,"ما حل قلبي ولا سكن","https://www.aldiwan.net/poem16880.html","مخلع البسيط"],[305,"خطب له الدين أرنى لحظ مذعور","https://www.aldiwan.net/poem56539.html","البسيط"],[320,"لا تعجبن لآل بيت جودهم","https://www.aldiwan.net/poem61715.html","الكامل"],[320,"أي شكر به يقوم لساني","https://www.aldiwan.net/poem67146.html","الخفيف"],[328,"وسألتني من أنت لما جئت","https://www.aldiwan.net/poem54986.html","مجزوء الكامل"],[328,"نذر العمر للغرام صبيا","https://www.aldiwan.net/poem55029.html","الخفيف"],[328,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[328,"بيننا أو بين زهر وشذاه","https://www.aldiwan.net/poem55043.html","الطويل"],[328,"كم ليال سهرتها","https://www.aldiwan.net/poem55072.html","مجزوء الخفيف"],[342,"آه نفسي إلى متى أتألم","https://www.aldiwan.net/poem55336.html","الخفيف"],[364,"إن أقمر الليل للسارين في حضن","https://www.aldiwan.net/poem60631.html","البسيط"],[364,"في الجيرة الغادين بدر","https://www.aldiwan.net/poem60895.html","مجزوء الكامل"],[364,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[364,"وعدت باستراقة للقاء","https://www.aldiwan.net/poem61018.html","الخفيف"],[371,"قل لعلي الخيل قد خيلت","https://www.aldiwan.net/poem57148.html","السريع"],[371,"رسل المدامع أبلغ الرسل","https://www.aldiwan.net/poem57203.html","أحذ الكامل"],[371,"أصبحوا يفرقون من إفراقي","https://www.aldiwan.net/poem57285.html","الخفيف"],[403,"إن كنت ترضى في الهوى بتلافي","https://www.aldiwan.net/poem33642.html","الكامل"],[403,"يا قبور الأحباب هل من مجيب","https://www.aldiwan.net/poem33960.html","الخفيف"],[403,"مثلي يغر بنقش كف الغيد","https://www.aldiwan.net/poem33972.html","الكامل"],[409,"حمائم الأيك هيجتن أشجانا","https://www.aldiwan.net/poem31850.html","البسيط"],[421,"يا من علا فرأى ما في القلوب وما","https://www.aldiwan.net/poem46385.html","البسيط"],[432,"عزمي وحزمي والحسام الماضي","https://www.aldiwan.net/poem12440.html","مشطور الرجز"],[432,"دوعدت ولم تف لي بذاك الموعد","https://www.aldiwan.net/poem12481.html","الكامل"],[439,"كل الكواكب ما طلعت سعود","https://www.aldiwan.net/poem34910.html","الكامل"],[449,"رثاء جمال عبد الناصر","https://www.aldiwan.net/poem979.html",""],[458,"ألم أتحدث والحديث شجون","https://www.aldiwan.net/poem55857.html","الطويل"],[473,"يا من به أنا مغرم","https://www.aldiwan.net/poem4119.html","مجزوء الكامل"],[479,"أطلق الشوق دمعتي","https://www.aldiwan.net/poem37067.html","مجزوء الخفيف"],[500,"ما عرفت الولي إلا بدلق","https://www.aldiwan.net/poem37938.html","الخفيف"],[500,"قد أبصر الزمان علوى وغفا","https://www.aldiwan.net/poem37959.html","الرجز"],[500,"كتب الظلام على الوجود سطورا","https://www.aldiwan.net/poem38003.html","مجزوء الكامل"],[515,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[515,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[558,"أيها السائر بالركبان حي","https://www.aldiwan.net/poem33571.html","الرمل"],[558,"كيف أخشى من اللعين اللاهي","https://www.aldiwan.net/poem33635.html","الخفيف"],[558,"أنا صاحب الأمر الإلهي","https://www.aldiwan.net/poem33662.html","مجزوء الكامل"],[558,"غصن بان فوقه البدر بدا","https://www.aldiwan.net/poem34653.html","الرمل"],[586,"ما كنت أندب رامة وطويلعا","https://www.aldiwan.net/poem17588.html","الكامل"]],"verses":[["أَناقِشُكُم وَوَراءَ النِقا","شِ أَنفُ العَلوقِ وَرِئمانُهُ",0,"ن",2,0],["إِن أَقضِ مَفروضَ البُكاءِ عَليكُمُ","مُتَحَرِّجاً يُجري الدُموعَ تَبَرُّعي",1,"ع",2,0],["إنْ أقدَموا بَرزوا إليكَ صَوارِماً","أو أنعَموا مَطَروا عليْكَ غُيوما",2,"م",2,0],["إِنَّا قُتِلْنَا بِالنَّوَى سِيَّان مَنْ","يُجْلَى عَنِ الأَوْطَانِ أَوْ مَنْ يُقْتَلُ",3,"ل",1,0],["إِنّا قَرَأنا الأَسى يَومَ النَوى سُوَراً","مَكتوبَةً وَأَخَذنا الصَبرَ تَلقينا",4,"ن",2,0],["إِنْ أَقْبَلَ الدَّهْرُ يَوْماً","قَاسَمْتَ كُلَّ مُقَاسِمْ",5,"م",1,0],["أن أقطع الليل في مدحي له فلقد","حمدت عند صباح البشر إسرائي",6,"ا",2,0],["إن أقبل الوجه أشكو جور ناظره","أو أقبل القدّ أشكو جور عادله",7,"ل",2,0],["إنْ أقبلتْ فالبدرُ لاح وإن مَشَتْ","فالغصنُ راح وإنْ رنَتْ فالرِّيم",8,"م",1,0],["أَنا قَطرَةٌ لَمَعَت في الضُحى","قَليلاً عَلى ضِفَّةِ المَشرَعِ",9,"ع",1,0],["انا قد يئست فلا الحياة جميلة","عندي ولا وجه المنى بسام",10,"م",1,0],["انا قد ولى شبابي","آه لو عاد الشباب",11,"ب",1,0],["إِن أَقامَ اِرتَوى الظِماءُ وَإِن سا","رَ أَقامَت أَنيقَةً آثارُه",12,"ر",2,0],["أنا قبيلة عشاقٍ بكامله","ومن دموعي سقيت البحر والسحبا",13,"ب",2,0],["إِن أَقبَلَت شَغَلَت دِيانَتَهُ","أَو أَدبَرَت شَغلَتَهُ بِالفَقرِ",14,"ر",1,0],["إِن أَقبَلَت بِغَضارَةٍ","سَحَّ النَعِيُّ بِجَنبِها",15,"ب",3,0],["إِن أَقبَلَت وَهَبَت مَحاسِنَ غيرِهِ","أَو أَدبَرَت سَلَبَت مَحاسِنَ نَفسِهِ",16,"س",2,0],["إِن أَقُل كُفَّ قالَ هاكَ بِحَقّي","أَو أَقُل مُتُّ قالَ لي في ضَماني",17,"ي",1,0],["إِنّا قَرَأنا الأَسى يَومَ النَوى سُوَرا","مَتلُوَّةً وَاِتَّخَذنا الصَبرَ تَلقينا",18,"ن",2,0],["أنا قدْ قرأتُ نقوشَها","فصوابُها في عكسِها",19,"ه",2,0],["أنا قدْ رضيتُ بأنْ أموتَ بحبِّهم","كمداً فلا يتعرَّضِ المتعرِّضُ",20,"ض",1,0],["أنا قَدْ سبَّلتُ عرضي لهم","فلهم أنْ يمدحوا أو يقذفوا",21,"ف",3,0],["إنْ أَقْفُ آثارَهُ إني الغَداةَ بها","على طَرِيقِ نَجَاحٍ مِنكَ مَدْلُولُ",22,"ل",1,0],["أَناقَةٌ هُوَ أَم شاةٌ فَيَمنَحَها","عُسّاً تَغيثُ بِهِ الأَضيافَ أَو غُمَرا",23,"ر",2,0],["إِن أَقمَرَ اللَيلُ عَلى وَفدِكُم","وَجَدتُكُم مِن قَمَرٍ أَو قَمير",24,"ر",1,0],["أنا قد طرت في سماء المعاني","وهو في جو روضة قد طارا",25,"ر",2,0],["إن أَقبلت فَلا أَرى","أَو حدثت فَلا أَعي",26,"ي",1,0],["أنا قيثارةٌ جَفَتْها الليالي","في زوايا النسيانِ والغفلاتِ",27,"ت",1,0],["إِنْ أَقضِكُم حقَّكُم مِن قِلَّةٍ عُمُرِي","إِنِّي إِلى اللَّهِ لا حقٌّ ولا عُمُرُ",28,"ر",1,0],["أنَا قَلْبِي مِنَ الشَّبَابِ وَجِسْمِي","أَثْخنَ الشَّيْبُ رَأْسَهُ بِحِرَابِهْ",29,"ب",2,0],["إنا قرأنا الليالي من عواقِبها","فصار ما يُضحكُ الأغْرارَ يُبكينا",30,"ن",2,0],["إن أقسى الأشياء للنفس ظلما","قلم في يد الجبان الجبان",31,"ن",1,0],["أنا قبيلةُ عشّاقٍ بكاملها","ومن دموعي سقيتُ البحرَ والسّحُبا",32,"ب",2,0],["إن أقبلتْ حدقُ الفرسانِ ترمقني","وكلُّ مقدام حربٍ مالَ للهربِ",33,"ب",1,0],["إِن أَقداحك الَّتي تَرَكتَني","غَير صاح تُدار مِن أَحداقك",34,"ك",1,0],["إِن أَقَل هاتَ أَسمعينا نَغمة","يا حَمام الايك غَنَت نَغمتين",35,"ن",1,0],["إِن أَقلَعَت غِيَرُ الأَيّامِ راغِمَةً","فَبَعدَ أَن أَكثَرَت مِن صَبرِكَ العَجَبا",36,"ب",2,0],["إِن أَقتَرِب فَنَوَلُ كَفِّكَ مَوطِني","أَو أَغتَرِب فَإِلى جَميلِكَ مَرجِعي",37,"ع",2,0],["أَنا قائِلٌ بِفَناءِ عِزِّكَ قائِلٌ","لِلنائِباتِ خُذي بِحُكمِكَ أَو دَعي",37,"ع",2,0],["أنا قيس في هواها","وهي في حبي ليلى",38,"ل",2,0],["إن أقامت أجسامُنا إذ ترحَّل","تَ فأرواحُنا أمامَ الرِّفاقِ",39,"ق",1,0],["أَنّا قَتَلنا بِتَرجٍ مِن سَراتِهِمُ","سَبعينَ مُقتَبِلاً صَرعى بِعَبّاسِ",40,"س",1,0],["أنا قاصم الأعداء في يوم الوغى","ومجندل الفرسان عند طعان",41,"ن",1,1],["أنا قبلت بروحي شفتيك","وأطعت الحب في عطفي عليك",42,"ك",1,0],["أَنا قَلبٌ يُعطي وَهم جَسدٌ يُع","طي لَهُم شَهوَةٌ وَلي أَحلامُ",43,"م",1,0],["أَنا قَيثارَةٌ ضَربتَ عَلَيها","فَبَكى لَحنُها وَأَنتَ المُغَنّي",44,"ن",2,0],["أَنا قائم أَبدا بِمَفروض الهوى","مستبدِلٌ لِلنَّومِ بِالتَسهيد",45,"د",1,0],["إِن أَقتَرَت كَفّي فَأَنتَ ذَخيرَتي","أَو أَجدَبَت أَرضي فَأَنتَ رَبيعي",46,"ع",2,0],["إِنَّ إِقبالَكَ يُضفي","لِثَنائي وَاِمتِداحي",47,"ح",2,0],["أَنَّا قَرَأْنَا مَسِيكَ الدِّينِ جَامِعَهُ","عَلَى الذِي فِي عُلاَهُ حَارَتِ الْمُسَكُ",48,"ك",1,0],["أنا قد أَتيتُكَ قاصِداً","فعساك تعرف حَقَّ قَصدي",49,"ي",1,0],["إِنْ أَقْلَقَ الْخَطْبُ كَانَتْ مَعْقِلاً حَرَماً","أَوْ الْمَحْلُ طبق كَانَتْ رَوْضَةً أُنُفا",50,"ف",2,0],["إِن أَقبَلَت قَتَلَت وَإِن وَلت سَبت","بِأَبي الموَلِّيَةِ القَوام المُقبِلَه",51,"ل",2,0],["إِن أَقبل القنّاصُ","فما لنا مناصُ",52,"ص",1,0],["إن أقبلت طاب لي الزمن","وإن جفت ضاق بي الوجود",53,"د",1,0],["إِن أَقصَدتك المنايا فهيَ مرصدةٌ","لكلّ مدّرعٍ بِالفضل مذكورِ",54,"ر",1,0],["إِن أَقعَدوهُ فَلَيسَ ثَمَّ يُقيمُهُ","غَيرَ اِنتِهاضٍ 