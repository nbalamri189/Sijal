{"poems":[[53,"أذاع بذي العهد عرفانه","https://www.aldiwan.net/poem29731.html","المتقارب"],[53,"لو كان يرتدع القضاء بمردع","https://www.aldiwan.net/poem30148.html","الكامل"],[63,"جهد الصبابة أن أكون ملوما","https://www.aldiwan.net/poem46195.html","الكامل"],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[73,"أضحى التنائي بديلا من تدانينا","https://www.aldiwan.net/poem11836.html","البسيط"],[93,"لانت صلاب العزائم","https://www.aldiwan.net/poem11341.html","المجتث"],[72,"ليلاي كم ليلة بالشعر ليلاء","https://www.aldiwan.net/poem18172.html","البسيط"],[72,"فتانة الصب تجلى في حماه فيا","https://www.aldiwan.net/poem19558.html","البسيط"],[51,"قلبي من الطرفِ السقيم سقيم","https://www.aldiwan.net/poem66338.html","الكامل"],[91,"أنا من أنا يا ترى في الوجود","https://www.aldiwan.net/poem8977.html","عموديه"],[89,"ابناء دجلة والفرات نيام","https://www.aldiwan.net/poem44882.html","الكامل"],[89,"وصف الدنيا كثيرون","https://www.aldiwan.net/poem44886.html","مجزوء الرمل"],[45,"شط من ساكن الغوير مزاره","https://www.aldiwan.net/poem63580.html","الخفيف"],[99,"من مفكرة عاشق دمشقي","https://www.aldiwan.net/poem5856.html","عموديه"],[58,"ما هذه الدنيا وطالبها","https://www.aldiwan.net/poem31058.html","السريع"],[49,"دار بليت بحبها خوانة لمحبها","https://www.aldiwan.net/poem10386.html","مجزوء الكامل"],[66,"يعطى البليد مع الخمول من الغنى","https://www.aldiwan.net/poem38554.html","الكامل"],[66,"ضعف رأسي وقلة الإيمان","https://www.aldiwan.net/poem39039.html","الخفيف"],[66,"كان الزمان بلقياكم يمنينا","https://www.aldiwan.net/poem40132.html","البسيط"],[69,"هذي فصوص لم تكن","https://www.aldiwan.net/poem28042.html","مجزوء الكامل"],[69,"اترك بحقك ما يقول المبغض","https://www.aldiwan.net/poem28754.html","الكامل"],[69,"مربع يخلو ودمع يكف","https://www.aldiwan.net/poem28817.html","الرمل"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[46,"إن التجارب طير تألف الخمرا","https://www.aldiwan.net/poem22614.html","البسيط"],[46,"ما لمت في أفعاله صالحا","https://www.aldiwan.net/poem22744.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85508","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85308","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39552","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30455","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54214","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205801","الخفيف"],[99,"من مفكرة عاشق دمشقي","https://www.poetsgate.com/ViewPoem.aspx?id=568",""],[3,"دَعني أَجِدُّ إلى العَلْيَاءِ في الطَّلبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10658&r=&rc=12",""]],"verses":[["أَناقِشُكُم وَوَراءَ النِقا","شِ أَنفُ العَلوقِ وَرِئمانُهُ",0,"ن",2,0],["إِن أَقضِ مَفروضَ البُكاءِ عَليكُمُ","مُتَحَرِّجاً يُجري الدُموعَ تَبَرُّعي",1,"ع",2,0],["إنْ أقدَموا بَرزوا إليكَ صَوارِماً","أو أنعَموا مَطَروا عليْكَ غُيوما",2,"م",2,0],["إِنَّا قُتِلْنَا بِالنَّوَى سِيَّان مَنْ","يُجْلَى عَنِ الأَوْطَانِ أَوْ مَنْ يُقْتَلُ",3,"ل",1,0],["إِنّا قَرَأنا الأَسى يَومَ النَوى سُوَراً","مَكتوبَةً وَأَخَذنا الصَبرَ تَلقينا",4,"ن",2,0],["إِنْ أَقْبَلَ الدَّهْرُ يَوْماً","قَاسَمْتَ كُلَّ مُقَاسِمْ",5,"م",1,0],["أن أقطع الليل في مدحي له فلقد","حمدت عند صباح البشر إسرائي",6,"ا",2,0],["إن أقبل الوجه أشكو جور ناظره","أو أقبل القدّ أشكو جور عادله",7,"ل",2,0],["إنْ أقبلتْ فالبدرُ لاح وإن مَشَتْ","فالغصنُ راح وإنْ رنَتْ فالرِّيم",8,"م",1,0],["أَنا قَطرَةٌ لَمَعَت في الضُحى","قَليلاً عَلى ضِفَّةِ المَشرَعِ",9,"ع",1,0],["انا قد يئست فلا الحياة جميلة","عندي ولا وجه المنى بسام",10,"م",1,0],["انا قد ولى شبابي","آه لو عاد الشباب",11,"ب",1,0],["إِن أَقامَ اِرتَوى الظِماءُ وَإِن سا","رَ أَقامَت أَنيقَةً آثارُه",12,"ر",2,0],["أنا قبيلة عشاقٍ بكامله","ومن دموعي سقيت البحر والسحبا",13,"ب",2,0],["إِن أَقبَلَت شَغَلَت دِيانَتَهُ","أَو أَدبَرَت شَغلَتَهُ بِالفَقرِ",14,"ر",1,0],["إِن أَقبَلَت بِغَضارَةٍ","سَحَّ النَعِيُّ بِجَنبِها",15,"ب",3,0],["إِن أَقبَلَت وَهَبَت مَحاسِنَ غيرِهِ","أَو أَدبَرَت سَلَبَت مَحاسِنَ نَفسِهِ",16,"س",2,0],["إِن أَقُل كُفَّ قالَ هاكَ بِحَقّي","أَو أَقُل مُتُّ قالَ لي في ضَماني",17,"ي",1,0],["إِنّا قَرَأنا الأَسى يَومَ النَوى سُوَرا","مَتلُوَّةً وَاِتَّخَذنا الصَبرَ تَلقينا",18,"ن",2,0],["أنا قدْ قرأتُ نقوشَها","فصوابُها في عكسِها",19,"ه",2,0],["أنا قدْ رضيتُ بأنْ أموتَ بحبِّهم","كمداً فلا يتعرَّضِ المتعرِّضُ",20,"ض",1,0],["أنا قَدْ سبَّلتُ عرضي لهم","فلهم أنْ يمدحوا أو يقذفوا",21,"ف",3,0],["إنْ أَقْفُ آثارَهُ إني الغَداةَ بها","على طَرِيقِ نَجَاحٍ مِنكَ مَدْلُولُ",22,"ل",1,0],["أَناقَةٌ هُوَ أَم شاةٌ فَيَمنَحَها","عُسّاً تَغيثُ بِهِ الأَضيافَ أَو غُمَرا",23,"ر",2,0],["إِن أَقمَرَ اللَيلُ عَلى وَفدِكُم","وَجَدتُكُم مِن قَمَرٍ أَو قَمير",24,"ر",1,0],["أنا قد طرت في سماء المعاني","وهو في جو روضة قد طارا",25,"ر",2,0],["إن أَقبلت فَلا أَرى","أَو حدثت فَلا أَعي",26,"ي",1,0],["أنا قيثارةٌ جَفَتْها الليالي","في زوايا النسيانِ والغفلاتِ",27,"ت",1,0],["إِنْ أَقضِكُم حقَّكُم مِن قِلَّةٍ عُمُرِي","إِنِّي إِلى اللَّهِ لا حقٌّ ولا عُمُرُ",28,"ر",1,0],["أنَا قَلْبِي مِنَ الشَّبَابِ وَجِسْمِي","أَثْخنَ الشَّيْبُ رَأْسَهُ بِحِرَابِهْ",29,"ب",2,0],["إنا قرأنا الليالي من عواقِبها","فصار ما يُضحكُ الأغْرارَ يُبكينا",30,"ن",2,0],["إن أقسى الأشياء للنفس ظلما","قلم في يد الجبان الجبان",31,"ن",1,0],["أنا قبيلةُ عشّاقٍ بكاملها","ومن دموعي سقيتُ البحرَ والسّحُبا",32,"ب",2,0],["إن أقبلتْ حدقُ الفرسانِ ترمقني","وكلُّ مقدام حربٍ مالَ للهربِ",33,"ب",1,0]]}