{"poems":[[55,"لأغنتك عن وصلي الهموم القواطع","https://www.aldiwan.net/poem30154.html","الطويل"],[55,"ألا لله بادرة الطلاب","https://www.aldiwan.net/poem30747.html","الوافر"],[65,"أليلتنا بالحزن عودي فإنني","https://www.aldiwan.net/poem45776.html","الطويل"],[79,"مقامك مرفوع على عمد السعد","https://www.aldiwan.net/poem36604.html","الطويل"],[37,"عرفت الدار قد أقوت بريم","https://www.aldiwan.net/poem38828.html","الوافر"],[85,"لقد علم الله أني امرؤ","https://www.aldiwan.net/poem54339.html","المتقارب"],[90,"بدت كالشمس يحضنها الغروب","https://www.aldiwan.net/poem45008.html","الوافر"],[74,"أفدي قمر","https://www.aldiwan.net/poem18700.html","منهوك الرجز"],[72,"لم يقض زيدكم من وصلكم وطره","https://www.aldiwan.net/poem42926.html","البسيط"],[47,"عهدي بربعك مأنوسا ملاعبه","https://www.aldiwan.net/poem10906.html","البسيط"],[47,"حلفت لها بالله يوم التفرق","https://www.aldiwan.net/poem65186.html","الطويل"],[68,"لئن ثلمت حدي صروف النوائب","https://www.aldiwan.net/poem41586.html","الطويل"],[46,"أألله إني خالد بعد خالد","https://www.aldiwan.net/poem30315.html","الطويل"],[46,"نعاء إلى كل حي نعاء","https://www.aldiwan.net/poem30325.html","المتقارب"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54258","الوافر"],[132,"هو الحق ما قال الحكيم فإنها","https://www.aldiwan.net/poem50484.html","الطويل"],[135,"دعوت الحي نصرا فاستهلوا","https://www.aldiwan.net/poem24171.html","الوافر"],[136,"هو الموت صمصامة منتضى","https://www.aldiwan.net/poem54809.html","المتقارب"],[147,"بقيت لذا العز الذي عز مطلبا","https://www.aldiwan.net/poem11733.html","الطويل"],[147,"ليهنك ما أنالتك الجدود","https://www.aldiwan.net/poem11748.html","الوافر"],[147,"أما الزمان فقد ألزمته الجددا","https://www.aldiwan.net/poem11751.html","البسيط"],[154,"قضى القلب من عهد الشباب ديونه","https://www.aldiwan.net/poem68583.html","الطويل"],[173,"أتدري الليالي أي خصم تشاغبه","https://www.aldiwan.net/poem1602.html",""],[190,"جزى الله من أقصى وصار مخالفي","https://www.aldiwan.net/poem43799.html","الطويل"],[254,"عفا رسم برامة فالتلاع","https://www.aldiwan.net/poem2111.html","الوافر"],[303,"لياليك يا بغداد في الحسن كالفجر","https://www.aldiwan.net/poem36830.html","عموديه"],[369,"أأجفان بيض هن أم بيض أجفان","https://www.aldiwan.net/poem60628.html","الطويل"],[369,"أصح عيون البابلية ما اعتلا","https://www.aldiwan.net/poem60796.html","الطويل"],[369,"ألا طرقتنا والثريا كقرطها","https://www.aldiwan.net/poem60853.html","الطويل"],[370,"صبرت على اللذات لما تولت","https://www.aldiwan.net/poem44364.html","الطويل"],[438,"نضا من شبيبته ما نضا","https://www.aldiwan.net/poem12653.html","المتقارب"],[445,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[463,"نعم هذه يا دهر أم المصائب","https://www.aldiwan.net/poem56291.html","الطويل"],[463,"رعى الله في الحاجات كل نجيب","https://www.aldiwan.net/poem56301.html","الطويل"],[469,"سرى موهناً والأنجم الزهر لا تسري","https://www.aldiwan.net/poem3632.html","عموديه"],[473,"جمالي وزيني إذا ما حضر","https://www.aldiwan.net/poem59983.html","المتقارب"],[511,"صلاح الدين انت له نظام","https://www.aldiwan.net/poem2399.html","الوافر"],[520,"أمالي من عذولكم عذير","https://www.aldiwan.net/poem12131.html","الوافر"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/124038","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48507","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38652","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96706","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96605","الوافر"],[1206,"","https://poetry.dctabudhabi.ae/diwan/poem/143132","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112850","الوافر"],[1477,"","https://poetry.dctabudhabi.ae/diwan/poem/134231","البسيط"],[1600,"","https://poetry.dctabudhabi.ae/diwan/poem/146092","الطويل"],[276,"","https://poetry.dctabudhabi.ae/diwan/poem/80445","الوافر"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74993","الوافر"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42462","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53170","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124763","الطويل"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99083","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94038","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94221","الوافر"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113839","الطويل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109820","الوافر"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132665","الطويل"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110771","البسيط"],[3291,"","https://poetry.dctabudhabi.ae/diwan/poem/106685","الطويل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104301","الطويل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123920","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66348","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110085","الطويل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118757","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91754","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91244","المجتث"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117862","الوافر"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36743","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85240","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77007","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136605",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136555",""],[4375,"","https://poetry.dctabudhabi.ae/diwan/poem/107148","الطويل"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127931","الوافر"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83200","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58078","الطويل"],[4483,"","https://poetry.dctabudhabi.ae/diwan/poem/101300","الطويل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136403",""],[4579,"","https://poetry.dctabudhabi.ae/diwan/poem/205455","المتقارب"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139556",""],[4927,"لُجَّةُ الأَحْزَاْن","https://www.poetsgate.com/ViewPoem.aspx?id=29830",""],[5031,"شدوُ البلابل","https://www.poetsgate.com/ViewPoem.aspx?id=165139",""],[5111,"نَجوَى","https://www.poetsgate.com/ViewPoem.aspx?id=212383",""],[5111,"غَيْمُ الْخَلِيجِ","https://www.poetsgate.com/ViewPoem.aspx?id=212608",""],[5284,"النسب العالي","https://www.poetsgate.com/ViewPoem.aspx?id=205727",""],[307,"جَمَالُ الشّيْبِ","https://www.poetsgate.com/ViewPoem.aspx?id=214156",""],[5324,"بغداد..","https://www.poetsgate.com/ViewPoem.aspx?id=211170",""],[5397,"متى آمن الدنيا من الغدر أخدع","https://www.poetsgate.com/ViewPoem.aspx?id=157923",""],[3912,"كفى حَزَنًا بالهائم الصبِّ أن يرى","https://www.poetsgate.com/ViewPoem.aspx?id=136749",""],[5493,"لِيثربِ أمي","https://www.poetsgate.com/ViewPoem.aspx?id=199921",""],[5598,"هي الرّوح","https://www.poetsgate.com/ViewPoem.aspx?id=213847",""],[5703,"أمي","https://www.poetsgate.com/ViewPoem.aspx?id=207891",""],[5845,"كلفتُ بكمْ ففاضَ دمي دموعاً","https://www.poetsgate.com/ViewPoem.aspx?id=16698",""],[6198,"الأفق المحترق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79279&r=&rc=53",""],[6318,"حب ووفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66154&r=&rc=4",""]],"verses":[["فَكَم غارَةٍ تَستَرجِفُ اللَيلَ أَيقَظَت","صُدورَ القَنا وَالغادِرونَ هَواجِعُ",0,"ع",1,0],["فَكَم غَدَتِ الضَغائِنُ وَهيَ سَكرى","تُديرُ عَلَيهِمُ كَأسَ المُصابِ",1,"ب",1,0],["فَكَم غادَةٍ جَلَّى ظَلامَكِ وَجهُها","وَبَدرُ الدُّجَى مِن حاسديها عَلى الحُسْنِ",2,"ن",1,0],["فكمْ غادَةٍ تخْتالُ تحتَ منصَّةٍ","مُعَصْفَرَةِ السِّرْبالِ مصْقولَةِ الخَدِّ",3,"د",1,0],["فَكَم غادَرنَ دونَكَ مِن جَهيضٍ","وَمِن نَعلٍ مُطَرَّحَةٍ جَذيمِ",4,"م",1,0],["فكم غمّض الدهرُ أجفانه","وفازت قِداحي بوصل الحبيبْ",5,"ب",1,0],["فكم غالبتها بهواك سُهداً","ونجم القطب مُطّلع رقيب",6,"ب",1,0],["فكم غفر","وكم نصر",7,"ر",1,0],["فَكَم غَرَستُ وَفائي في مَحَبَّتِكُم","فَما جَنَيتُ لِغَرسٍ فيكُمُ ثَمَرَه",8,"ر",2,0],["فَكَم غَنَيتُ أَخا لَهوٍ يُطالِبُني","بِهِ أُناسِيُّ مِمَّن لا أُطالِبُهُ",9,"ب",2,0],["فَكَم غُلَّةٍ لِلشَوقِ أَطفَأتُ حَرَّها","بِطَيفٍ مَتى يَطرُق دُجى اللَيلِ يَطرُقِ",10,"ق",1,0],["فَكَم غايَةٍ أَدرَكتُها غَيرَ جاهِدٍ","وَكَم رُتبَةٍ قَد نِلتُها غَيرَ طالِبِ",11,"ب",1,0],["فَكَم غالَ ذاكَ التُربُ لي وَلِمَعشَري","وَلِلناسِ طُرّاً مِن طَريفٍ وَتالِدِ",12,"د",1,0],["فَكَم غَيَّبَ التَربُ مِن سُؤدَدٍ","وَغالَ البِلى مِن جَميلِ البَلاءِ",13,"ا",2,0],["فكم غازٍ به أمسى رميماً","وكم فُلْكٍ به أمست حُطَامَا",14,"م",2,0],["فكمْ غادرتْ بالرَّمْسِ قوماً بغدرها","وكمْ ضَرَّسَت منها نواجذَ فيهَا",15,"ي",3,0],["فَكَم غادَرنَ مِن كابٍ صَريعٍ","يَمُجُّ نَجيعَ جائِفَةٍ ذَنوبِ",16,"ب",1,0],["فَكَم غَرَّ غِراًّ بِاقِبَالِهِ","فَلَمَّا تَيَقَّنَهُ أعرَضَا",17,"ض",2,0],["فَكَم غُضَّتِ الأَبصارُ عِندَ لِقائِكُم","خُضوعاً وَفُضَّت عِندَ ذِكرِكُمُ الحُبا",18,"ب",2,0],["فَكَم غُلَلٍ خَفاها حَرُّ ضَربٍ","وَقَد أَعيا بِها الماءُ البَرودُ",19,"د",1,0],["فَكَم غَمَرتَ أَكُفَّ الطالِبينَ لُهىً","مَلَأتَ أَلفاً فَأَلفاً لايَداً فَيَدا",20,"د",2,0],["فَكَم غايَةٍ قَد حازَها بَعدَ غايَةٍ","إِلى أَن رأى لِلرَّبِّ أَكبَرَ آيَةٍ",21,"ه",1,0],["فَكَم غارَةٍ قَد شَنَّها بَعدَ غارَةٍ","عَلَيَّ وَفَرَّت مِن قِراعي مَقانِبُهْ",22,"ب",2,0],["فكم غصّة جرّعتها متكارها","بإجمال محبوب ونفرة نافر",23,"ر",1,0],["فَكَم غادَرنَ مِن كابٍ صَريعٍ","تُطيفُ بِشِلوِهِ عُرجُ الضِباعِ",24,"ع",1,0],["فكمْ غادةٍ تصبي الحليمَ بسحرِها","تضيءُ ظلامَ الليل كالكوكبِ الدري",25,"ر",2,0],["فكم غازَلتْنا من لواحظِ رَبْرَب","ومالَتْ إلينا من سَوالفِ غِزْلان",26,"ن",1,0],["فكمْ غايةٍ للمجدِ مُمْتدَّةِ المدَى","مَلكْتُ إليها للجَديليَّة الجُدْلا",27,"ل",2,0],["فكم غايةٍ يا ابْنَ الكرامِ بلَغْتَها","على صَهوةٍ من صَعبةٍ لم تُوَطّها",28,"ط",3,0],["فكم غَمرةٍ دافعتُها بعد غَمرةِ","تَجَرَّعتُها بالصبرِ حتى تَوَلَّتِ",29,"ت",1,0],["فكم غادةٍ عنهُ قد أعرضَتْ","وكم رشأٍ عنه قد أعْرَضا",30,"ض",2,0],["فكم غالَ من أجسامِها غَوْلُ قَفْرَةٍ","وَخَرَّمَ من أَلْبابِهِنَّ المَخارِمُ",31,"م",1,0],["فكم غامَ من أخباره ثم أقشعتْ","سحابتهُ عن صالحِ الحالِ ثائبِ",32,"ب",1,0],["فكم غمّة عَمياء أعضلَ داؤها","رماها برأيٍ من نُهاهُ طبيبِ",33,"ب",1,0],["فكم غصنٍ نضرٍ يميس على نقا","وكم قمرٍ تمٍ على غصن نضر",34,"ر",1,0],["فَكَم غازَلَتنِيَ غِزلانُهُ","وَوَجهُ الزَمانِ جَميلٌ نَضِر",35,"ر",1,0],["فكم غمر أضلُّوا واستزلّوا","قحُمّ على الضّلاَل له الحِمام",36,"م",1,0],["فكم غناكم قلم وسيف","فأطربكم صليل أو صرير",37,"ر",1,0],["فكم غادروا من مثقلٍ في قيوده","وكم من قتيل فاته العقل والثار",38,"ر",1,0],["فكم غيرت غاراتُها طبعَ دولةٍ","وغاراتُها الشعواء لا تتغير",39,"ر",1,0],["فَكَم غَضبتَ وَكنّا قَد نَرى علناً","في وَجهِكَ الحلم أَضحى يُطفِئُ الغضبا",40,"ب",2,0],["فَكَم غدا مُخصب يرعى المحول به","وَكَم ربيع غَدا يرعاهُ ماحلهُ",41,"ل",2,0],["فَكم غازَلت مِن غِزلا","نِهنّ الخرّدِ العُرُبا",42,"ب",2,0],["فكم غصَّة في صدر صدر وصاحب","وكم حسرة في قلب حرٍّ وحرَّة",43,"ه",1,0],["فكم غفرت بكم ونأت خطايا","وكم شدت لنحوكم المطايا",44,"ي",2,0],["فكم غريبة شكل صاغ صورتها","من كل معنى بحجب الغيب مستتر",45,"ر",1,0],["فكم غَرِدٍ لما استقلّ ركابها","حدا طرباً والليل غضبان مدَّجي",46,"ج",2,0],["فكَم غمر طَغى وَبَغى عليهم","فَبات مجندل الغبرا ضَجيعا",47,"ع",2,0],["فَكَم غرب الهلال وكم تبدى","وكم تغرب عَلى وفدي منون",48,"ن",1,0],["فكم غيبتْ في الأرضِ وجهاً منعماً","وكم كسفَتْ شمساً وكم خَسفَتْ بدرا",49,"ر",2,0],["فكم غدت العقبان فوق عقابه","تشق عجاجاً ظلَّ ينسلها نسلا",50,"ل",2,0],["فكم غبن مغبون بنعمة صحة","ونعمة إمكان اكتساب التعبد",51,"د",1,0],["فكم غزال أخذت قسراً","وكم مليح حوت يميني",52,"ن",2,0],["فكم غرر لاحت على جبهه العلى","ولم ترها عين بسالف أزمان",53,"ن",1,0],["فكم غاد بمركبه","وكم من رائح ماشي",54,"ش",2,0],["فكم غمرتني بالنوال يمينه","وكم توجتني بالمهابة والبر",55,"ر",1,0],["فكم غضبوا على الايام ظلماً","وكم حنقوا على الدنيا وثاروا",56,"ر",3,0],["فكم غيبت فيه نجوماً وحجبت","بدو رعلا فيها المنايا الخواسف",57,"ف",1,0],["فكم غنى بسماح من مكارمه","فقراً وقوم بالإعطاء من عوج",58,"ج",1,0],["فَكَم غَادةٍ حَسناءَ مَاسَت كَأنَّهَا","قَضِيبُ رِيَاضِ صَافحَتهُ رِياحُ",59,"ح",1,0],["فكم غارت الكف الخضيب خضيبة","وكم قارب للقوس قوس مفرق",60,"ق",1,