{"poems":[[55,"سل الهضب ما بين الهضاب الأطاول","https://www.aldiwan.net/poem29837.html","الطويل"],[53,"أجد بربات الحجال صدودها","https://www.aldiwan.net/poem61836.html","الطويل"],[47,"أصابت قلبه حدق الظباء","https://www.aldiwan.net/poem10202.html","الوافر"],[47,"أبا سعيد وفي الأيام معتبر","https://www.aldiwan.net/poem63565.html","البسيط"],[46,"تصدت وحبل البين مستحصد شزر","https://www.aldiwan.net/poem29676.html","الطويل"],[76,"أيجني على مهجتي طرفه","https://www.aldiwan.net/poem13177.html","المتقارب"],[107,"ألا رددوا الأنباء عن فوز ماهر","https://www.aldiwan.net/poem42126.html","الطويل"],[48,"العيش ماض فأكرم والديك به","https://www.aldiwan.net/poem23516.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85585","البسيط"],[79,"نبيت على علم يقين من الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=34136",""],[119,"عجبت لقلبي كيف لا يتفطر","https://www.aldiwan.net/poem41117.html","عموديه"],[147,"محل لهم بين النقا والأجارع","https://www.aldiwan.net/poem11772.html","الطويل"],[358,"بدت لك شمس الخدر من فلق السجف","https://www.aldiwan.net/poem40039.html","الطويل"],[422,"سألتك عن منازلنا بنجد","https://www.aldiwan.net/poem53908.html","الوافر"],[445,"محلك بالدنيا وبالدين آهل","https://www.aldiwan.net/poem34914.html","الطويل"],[449,"بالله يا نسمات الرند والبان","https://www.aldiwan.net/poem55955.html","عموديه"],[463,"تظن ليالينا عودا","https://www.aldiwan.net/poem56231.html","المتقارب"],[469,"صبر قلبي عان ودمعي طليق","https://www.aldiwan.net/poem3398.html","عموديه"],[505,"هو البدر أم وجه الحبيب الذي يبدو","https://www.aldiwan.net/poem38023.html","الطويل"],[534,"نظام يا ابن ودي أم لآلي","https://www.aldiwan.net/poem37270.html","الوافر"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126769","المتقارب"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59766","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59091","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59424","الطويل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96033","الطويل"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67913","الطويل"],[2253,"","https://poetry.dctabudhabi.ae/diwan/poem/115142","الطويل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137444",""],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74072","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62739","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105569","الرجز"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102743","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58127","الطويل"],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/199661","الطويل"],[4679,"من الشهبُ المحاطة بالضبابِ","https://www.poetsgate.com/ViewPoem.aspx?id=142741",""],[4882,"اجبني فحتى الماء فجره الصخرُ_بهاء الدين الخاقاني","https://www.poetsgate.com/ViewPoem.aspx?id=7332",""],[585,"هو الصوت دوّى من فلسطين عالياً","https://www.poetsgate.com/ViewPoem.aspx?id=161906",""],[6068,"سؤال وجواب (الحب)؟ -06-","https://www.poetsgate.com/ViewPoem.aspx?id=175849",""],[6088,"سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=207606",""],[6338,"محلك بالدنيا وبالدين آهل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52543&r=&rc=5",""]],"verses":[["وَهَل خُضِدَت تِلكَ الرِماحُ لِغامِزٍ","وَهَل أَكثَبَت تِلكَ النُجومُ لِنائِلِ",0,"ل",1,0],["وهل خُلَّةٌ معسولة الطعم تُجْتَنَى","من البيض إلّا حيث واشٍ يكيدها",1,"د",3,0],["وَهَل خُلِقَ الفَتى إِلّا لِيَهوى","وَيَأنَسَ بِالدُموعِ وَبِالدِماءِ",2,"ا",2,0],["وَهَل خَلا الدَهرُ أولاهُ وَآخِرُهُ","مِن قائِمٍ بِهُدىً مُذ كُوِّنَ البَشَرُ",3,"ر",1,0],["وَهَل خابَ مَن جِذماهُ في ضَنءِ طَيِّئٍ","عَدِيُّ العَدِيّينَ القَلَمَّسُ أَو عَمرُو",4,"ر",2,0],["وَهَل خاضَ جَرعاءَ وادي الغَضا","يُلاعِبُ أَفنانَها عِطفُهُ",5,"ف",2,0],["وهل خاصم الحرَّ الكريمَ سِوَى امرئٍ","على دولة الأحرارِ غضبانَ ثائرِ",6,"ر",1,0],["وَهَل خَلَت قَبلُ مِن جورٍ وَمَظلَمَةٍ","أَربابُ فارِسَ أَو أَربابُ غَسّانِ",7,"ن",1,0],["وَهَل خلت قط نفس من مآربها","ما إن قضى وطراً في نفسه أَحدٌ",8,"د",1,0],["وهل خفض التأنيث للشمس رتبة","وهل رفع التذكير من رتبة البدر",9,"ر",1,0],["وهل خاطري يصفو وقلبي يرعوي","ولي لوعة عن طور يعقوب تسفر",10,"ر",1,0],["وَهَل خَرَجَت أَفعالُهُ عَن مَحاسِنٍ","تُخَبِّرُ أَو أَقوالُهُ عَن شَوافِعِ",11,"ع",1,0],["وَهَل خَلق الرَحمَن ثَغرَك وَاللَمى","فَدَيتك إِلّا وَهوَ للثم وَالرَشفِ",12,"ف",1,0],["وهل خَطَبَتْ على الأَثلاثِ منه","حمائِمُها بأَلْسِنَةٍ فِصاح",13,"ح",1,0],["وهل خَيَّبَتْ يمناك مَنْ جاءَ آمِلاً","فيُكْذِبَ ربُّ العرش مَا أَنت آملُ",14,"ل",1,0],["وهل خليفته المأمون رد لنا","علم الأوائل من أقوام يونان",15,"ن",1,0],["وهل خبرُ الطيفِ من بعدهم","إذا طاب يصدُقُك المَوعِدا",16,"د",2,0],["وهل خدُّه ماءٌ وخمرٌ تألقا","ويا عجباً أم ذلك الماءُ والخمر",17,"ر",1,0],["وهل خالُهُ أم نقطَةُ المِسكِ عبَّقَتْ","وهل خلقُهُ أَم جنَّةٌ وقتُها خُلْدُ",18,"د",1,0],["وَهَلْ خَيْرُ الْقُرونِ ومَنْ يَليهِ","سَعَوْا يَوْماً إلى قِيلٍ وقالِ",19,"ل",1,0],["وهَلْ خَصَّ الإلَهُ بفَضْلِهِ مَنْ","يُعَدُّ مُقَدّماً مِنْ دُونِ تَالي",19,"ل",2,0],["وَهَل خابَ مَن جاءه زائراً","إِذا ما أتاه بقلب حسيرِ",20,"ر",1,0],["وهل خطرت بالرمل آهاً من أهله","سقاه رباب المزن سحاً ووابلا",21,"ل",2,0],["وَهَلْ خَطَرَتْ أعْطَافُ أغْصَانك الَّتِي","بِأفنَانهَا وُرْقُ الحَمَائِمِ غَنَّتِ",22,"ت",1,0],["وهل خضتما بحر الأسى أو وقفتما","بساحله والبحر يخشى إذا طما",23,"م",2,0],["وهل خبرت فيما تروم أمية","بأن العلى لم تلف للضيم مدفعا",24,"ع",2,0],["وهل خَلفوا إلاَّ أبانا فَفخرُهم","علينا به نكراءُ من وجهِ عارفِ",25,"ف",1,0],["وهل خصلةٌ من سؤددٍ لم يكن لها","أبو حسنٍ من بينهم ناهضاً قدما",26,"م",2,1],["وهل خذ هذا الدهر يمسى موردا","وخال العلا بين المقابر قد أضحى",27,"ح",2,0],["وَهَل خفّف الصبر وَقع المُصاب","إِذا كانَت الكبد الداميَه",28,"ي",2,0],["وهل خلَقَ اللهُ السرورَ فقال لا","فقلتُ أثِرْها أنْتَ لي اليومَ صاحِبُ",29,"ب",1,0],["وهل خلت العهود تصح","ح بين الذئب والنقد",30,"د",1,0],["وهل خيال طارق يخبرنا","أن النقا تفوفت أفوافها",31,"ف",3,0],["وهل خصرها باق على جور ردفها","فعهدي بذاك الردف في الجور يشتط",32,"ط",1,0],["وهل خصَّ ذا مال بها دونَ غيره","ولو أنَّهُ نَزْرُ الصنيعِ جَهُولُ",33,"ل",1,0],["وهل خاطب الله الخليقة بالتقى","وخص ذوي الألباب إلا ليتقوا",34,"ق",3,0],["وهل خلق الجمال الله إلا","لنبصره ونشكرَ بارتعابِ",35,"ب",1,0],["وهل خفت شيطانا بدهر لتتقي","قتييلُ يقين ٍ بات يطعنك الكفرُ؟",36,"ر",1,0],["وهل خلعت عنها النهار تفجعاً","وهل لبست حزناً عليها اللياليا",37,"ي",2,0],["وهل خالفتُ إيمانا بقدْر","وجاوزتُ الشريعة والأمينا",38,"ن",2,0],["وهل خيام بني طيء بها قبس","وهل قرى ضيفهم ما زال مأمولا",39,"ل",2,0],["وهل خيبت يمناك من جاء آمالا","فيكذب رب العرش ما أنت آمل",40,"ل",1,0]]}