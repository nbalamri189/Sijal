{"poems":[[55,"ما عند عينك في الخيال الزائر","https://www.aldiwan.net/poem30448.html","الكامل"],[47,"يأبى الخلي بكاء المنزل الخالي","https://www.aldiwan.net/poem65572.html","البسيط"],[132,"أنت الحبيب المرتضى ولك الهنا","https://www.aldiwan.net/poem50490.html","الكامل"],[203,"ما بال ألأنفك هذا قد شمخت به","https://www.aldiwan.net/poem45505.html","البسيط"],[208,"للدهر ما بين الأنام وزيف","https://www.aldiwan.net/poem53097.html","الكامل"],[302,"وافاك نشوان المعاطف ناشي","https://www.aldiwan.net/poem33234.html","الكامل"],[369,"يا أهل بغداد سقى عهدي بكم","https://www.aldiwan.net/poem60985.html","الكامل"],[422,"هاج القرام وهيجا بلبالي","https://www.aldiwan.net/poem54163.html","الكامل"],[463,"ألا فتى يسأل قلبي ماله","https://www.aldiwan.net/poem55905.html","الرجز"],[469,"أجنها الفكر وأبداها العبق","https://www.aldiwan.net/poem3442.html","عموديه"],[469,"لو عاد طيفكم فعاد عليلا","https://www.aldiwan.net/poem3602.html","عموديه"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48696","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46532","الرجز"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118299","البسيط"],[2441,"","https://poetry.dctabudhabi.ae/diwan/poem/73687","الكامل"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136962",""],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58303","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110060","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216494","المجتث"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131011",""],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86514","البسيط"],[3886,"","https://poetry.dctabudhabi.ae/diwan/poem/130556","الكامل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44702","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136623",""],[5186,"تالله ما أنا واقف في الباب","https://www.poetsgate.com/ViewPoem.aspx?id=156550",""],[5307,"حبك ملك قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=10542",""],[5431,"قصيدة تفكيكية (2)","https://www.poetsgate.com/ViewPoem.aspx?id=215499",""],[5829,"رياضُ الشّام","https://www.poetsgate.com/ViewPoem.aspx?id=212095",""],[5861,"نسائم البوح","https://www.poetsgate.com/ViewPoem.aspx?id=188033",""]],"verses":[["لَولا خُمولُكُمُ لَقَد قُلِّدتُمُ","عاراً بِنَظمِ غَرائِبي وَسَوائِري",0,"ر",2,0],["لَولا خِلالُ مِنَ الشاهِ اِستَبَدَّ بِها","لَأَصبَحَ الجودُ فينا كاسِفَ البالِ",1,"ل",1,0],["لولا خيالُكمُ وذكرُ ملاعبٍ","بالمُنْحَنَى والرقمين لما اهْتَنَى",2,"ن",2,0],["لولا خشيتُ إذا ما كنت رافعهُ","من أجلِ واحدةٍ أن يقفأ الأخرى",3,"ر",2,0],["لولا خلائق في الكريم كريمةٌ","لم يستَبِن أنَّ الشريف شريفُ",4,"ف",1,0],["لَولا خفوقُ جَوانحي لفرشتُها","لمبيته وطويتَ عنه فِراشي",5,"ش",2,0],["لولا خُطوبُ الدّهرِ كنتُ لعَودةٍ","منّي إليكم قبلَ مَوْتِي خاطبا",6,"ب",2,0],["لولا خبال الدهر ما نال الفنى","في الناس ذو بَلَهٍ به وخبال",7,"ل",1,0],["لولا خشوعي لهواه لم يدُسْ","ظهرَ الثرى من اجتدى نوالَه",8,"ل",2,0],["لولا خيالات الدجى ما فضّلت","بنفسجَ الليل على ورد الشَّفقْ",9,"ق",1,0],["لولا خياناتُ الزمانِ وأهله","ما كنتُ متَّخذَ النسيمِ رسولا",10,"ل",2,0],["لولا خضوع وزارة هيابة","لم يستقم لك في السياسة مضرب",11,"ب",1,0],["لَولا خطار عنتر","بِنَفسهِ لَم يُذكر",12,"ر",1,0],["لولا خشاتي عليها سوء عاقبة","لما يعقب تصاديها بانهائي",13,"ا",2,0],["لَولا خُروجُ الفَصلِ عَن مُعتادِهِ","لَم يُمهَلوا مِقدارَ سمِّ خِياطِ",14,"ط",1,0],["لولا خطوب جسام في مرابعهم","حلت تباعا لطالوا قبلك السحبا",15,"ب",2,0],["لولا خُلوق ثَوبه","لَكدت أنْ أُخَلِّقَه",16,"ق",2,0],["لولا خَطاؤُكُمُ وزَلَّةُ آدَمٍ","ما استهدَفَتني الآنَ هذي الأَسهُمُ",17,"م",1,0],["لولا خداع مناها","أفاق وهو غبين",18,"ن",1,0],["لولا خلاف في السياسة بينها","لما تركت والله من ارضنا شبرا",19,"ر",2,0],["لولا خفوق حشاهم ما سرى دمهم","لما تخونه التبريح والشجن",20,"ن",1,0],["لولا خلائق للفتى محمودة","لوطأت في نعليّ فوق الهام",21,"م",1,0],["لَولا خِتامه في مَجالسِ إِنسِنا","لَمَكَثنا في الدُنيا بِدون صَباحِ",22,"ح",1,0],["لولا خيالٌ منه يؤرقني","ما بتُّ رهن السُهاد والسَقم",23,"م",1,0],["لولا خزامى شعره في نشرها","أرجا يفوح على شذا الأطياب",24,"ب",1,0],["لولا خيالك في منامي فلا غضيت","يا منوة المقصود في غاية اوقاته",25,"ت",2,0],["لولا خطيئتنا ماسار كوكبنا","صيرورة وبها قد سُعّرت قرصا",26,"ص",2,0],["لولا خلقتُ بحِجْرها لاخترتُها","فهي الجنانُ وزهرةُ البلدانِ",27,"ن",1,0],["لولا خيالٌ وشوقٌ لي يلازمُني","لأنْشَدَ النَظمُ بالأشجانِ يرثيني",28,"ن",2,0]]}