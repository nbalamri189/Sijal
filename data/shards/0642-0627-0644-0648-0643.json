{"poems":[[71,"هنيت عاما مقبلا مقبلا","https://www.aldiwan.net/poem28741.html","السريع"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77649","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77601","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77614","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77558","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46522","الرجز"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26425","السريع"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124716","الطويل"],[4718,"الشام راحت بدين الفرس ياساده","https://www.poetsgate.com/ViewPoem.aspx?id=137565",""]],"verses":[["قالَ وكمْ قلبٍ على منصبٍ","شُوي بنارِ العذلِ حتى انسلى",0,"ل",2,0],["قالَ وَكانَ فَوقَها شوحيّه","كَأَنَّها قنطرةٌ مبنيّه",1,"ه",1,0],["قالَ وَكانَ الذئب في الجوارِ","مُستَتِراً مُستَرِق الأَخبارِ",2,"ر",1,0],["قالَ وَكَيفَ راحَ مِنكَ قُل لي","وَلم دَفَنتهُ بِهَذا الطَلَل",3,"ل",1,0],["قالَ وَكانَ الفارُ في الطَريق","وَخارِجاً مِن أَحَد الشُقوق",4,"ق",1,0],["قالَ وَكَيفَ جاءَكَ الطاووس","ضَيفاً حلفت أَنَّهُ مَنحوس",5,"س",1,0],["قالَ وَكَيفَ البَأسُ عِندَ الوَغى","قُلتُ أَتاكَ النَبَأُ الأَكبَرُ",6,"ر",1,0],["قال وكل واردٌ حرَّ قعرِها","على الرب حتماً في مواردِها السدم",7,"م",1,0],["قالو كثيرٍ وحنا مابنا زياده","قال انتم اكثر ولكن مابكم فوده",8,"د",2,0]]}