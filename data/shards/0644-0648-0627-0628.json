{"poems":[[55,"يا دار ما طربت إليك النوق","https://www.aldiwan.net/poem29956.html","الكامل"],[85,"ما للعوالم جمعت في قبة","https://www.aldiwan.net/poem54315.html","الكامل"],[53,"لا أسأل الله في جهمان مسألة","https://www.aldiwan.net/poem7952.html","البسيط"],[53,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[93,"أبصرتها والشمس عند شروقها","https://www.aldiwan.net/poem8848.html","عموديه"],[87,"لنا رقيب كان ما أثقله","https://www.aldiwan.net/poem7302.html","السريع"],[45,"ما أنصف القوم ضبه وأمه الطرطبه","https://www.aldiwan.net/poem9511.html","المجتث"],[47,"توعدني شيبان بغيا وما","https://www.aldiwan.net/poem66845.html","البسيط"],[77,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[81,"","https://poetry.dctabudhabi.ae/diwan/poem/97567","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55059","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[111,"لا تكترث بالليالي إنها دول","https://www.poetsgate.com/ViewPoem.aspx?id=519",""],[92,"بريد الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=179052",""],[132,"مني السلام على الولى الوالي","https://www.aldiwan.net/poem50536.html","الكامل"],[147,"عوضونا من السهاد الرقادا","https://www.aldiwan.net/poem11742.html","الخفيف"],[147,"هل للأماني عن جنابك مدفع","https://www.aldiwan.net/poem11771.html","الكامل"],[164,"ما في شجاعة ذى السخا من شك","https://www.aldiwan.net/poem58845.html","الكامل"],[208,"أهيف يحكي بقده الألفا","https://www.aldiwan.net/poem53029.html","المنسرح"],[214,"آيات حسنك قد أبدت لنا عجبا","https://www.aldiwan.net/poem13309.html","البسيط"],[242,"أشكو إلى الله السميع المجيب","https://www.aldiwan.net/poem18044.html","السريع"],[242,"سل الفؤاد ودع خنى شعرور","https://www.aldiwan.net/poem18197.html","الكامل"],[266,"عليل هوي الأحبة لن يعادا","https://www.aldiwan.net/poem38335.html","الوافر"],[280,"عبر البحر يؤم الأبحرا","https://www.aldiwan.net/poem25568.html","الرمل"],[286,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[302,"يا كوكبا لم تحوه الأفلاك","https://www.aldiwan.net/poem33205.html","الكامل"],[302,"لو أبانت حجابها أسماء","https://www.aldiwan.net/poem33339.html","الخفيف"],[382,"عيني تلت ما سطرته يميني","https://www.aldiwan.net/poem59232.html","الكامل"],[385,"بأي حال تراه يصطبر","https://www.aldiwan.net/poem48834.html","المنسرح"],[385,"مزجت دموع جفونه بدماء","https://www.aldiwan.net/poem49210.html","الكامل"],[385,"من منصفي أَو من مجيري","https://www.aldiwan.net/poem49231.html","مجزوء الكامل"],[408,"أهديت للأبصار والأسماع","https://www.aldiwan.net/poem46499.html","الكامل"],[408,"حب علي وبنيه","https://www.aldiwan.net/poem46962.html","مجزوء الرجز"],[412,"حكم المنية في البرية جاري","https://www.aldiwan.net/poem50178.html","الكامل"],[415,"يلط بالدين من مولاه مسلمه","https://www.aldiwan.net/poem32251.html","البسيط"],[422,"لهذي النوق تنحط كلالا","https://www.aldiwan.net/poem54004.html","الرمل"],[422,"أنا في هواكم مطلق ومقيد","https://www.aldiwan.net/poem54136.html","الكامل"],[438,"بان الحبيب فبان الصبر والجلد","https://www.aldiwan.net/poem12477.html","البسيط"],[466,"الق الحدائج ترع الضمر القود","https://www.aldiwan.net/poem15103.html","البسيط"],[473,"نحن أناس نوالنا خضل","https://www.aldiwan.net/poem59746.html","المنسرح"],[473,"بنفسي أخ لي خلقه مثل خلقه","https://www.aldiwan.net/poem59795.html","الطويل"],[556,"ما بال حقف بكثيب اللوى","https://www.aldiwan.net/poem47287.html","السريع"],[567,"لا الدر در ولا المرجان مرجان","https://www.aldiwan.net/poem52750.html","البسيط"],[567,"جمعت من أفضل الأسماء في القدم","https://www.aldiwan.net/poem52833.html","البسيط"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/67013","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64601","البسيط"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82308","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100953","الكامل"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42446","الكامل"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42466","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109756","البسيط"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47193","الكامل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122467","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203494","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204716","البسيط"],[3009,"","https://poetry.dctabudhabi.ae/diwan/poem/102379","الوافر"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118838","الدوبيت"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67981","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62762","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48276","السريع"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129331","السريع"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91071","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205672","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131038",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135915","الرجز"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44637","الكامل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199081","البسيط"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36669","الدوبيت"],[4347,"","https://poetry.dctabudhabi.ae/diwan/poem/134252","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117283","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117261","الكامل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35433","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120298","السريع"],[5020,"زينب مالى عنك من صبر","https://www.poetsgate.com/ViewPoem.aspx?id=201045",""],[5185,"القصيدة اليمانية","https://www.poetsgate.com/ViewPoem.aspx?id=74641",""],[5459,"مُنساق ..","https://www.poetsgate.com/ViewPoem.aspx?id=196575",""],[5463,"نظرة إرتياب","https://www.poetsgate.com/ViewPoem.aspx?id=33839",""],[5579,"مهرة","https://www.poetsgate.com/ViewPoem.aspx?id=186470",""],[5608,"أحلا قصيد","https://www.poetsgate.com/ViewPoem.aspx?id=33532",""],[6056,"عابر سبيل","https://www.poetsgate.com/ViewPoem.aspx?id=130378",""],[6115,"لو ابليس اطاع الله ابد مايكون ملعون","https://www.poetsgate.com/ViewPoem.aspx?id=181765",""]],"verses":[["لَو أَبدَتِ الأَيّامُ جانِبَ وَجهِهِ","لَتَشَبَّثَتهُ مَظالِمٌ وَحُقوقُ",0,"ق",1,0],["لو أبصرتُ صنهاجةٌ أوضاعَه","دانت له أملاكُها بتعبُّدِ",1,"د",1,0],["لو أبصرتْ عينه من بُغضهِ طَرَفاً","لذاب حتى تراه كالخيالِ ضَنى",2,"ا",1,0],["لو أبى الراغبون يوماً نداهُ","لدعاهُمْ إليه بالترهيبِ",3,"ب",1,0],["لَو أَبصَرَت عَيناكَ فيهِ خَيالَها","لَرَأَيتَ مِرآةً بِغَيرِ إِطارِ",4,"ر",1,0],["لو ابتلى الله به عاشقا","مات به لا بالجوى والوله",5,"ل",2,0],["لَو أَبصَرَ الجِذعَ شَيئاً","أَحَبَّ في الجِذعِ صَلبَه",6,"ب",2,0],["لَو أَبصَروا خَيلي وَأَبطالَها","وَبَعدَها رَجلٌ وَفُرسانُ",7,"ن",1,0],["لو أبصرَتكَ الرّومُ يومئذٍ دَرَتْ","أنّ الإلهَ بما تَشاءُ كَفيل",8,"ل",1,0],["لَو أبصرت أيراً على نخلة","صارَت منَ الطيرِ الأبابيلِ",9,"ل",1,0],["لَوْ أُبِيدَ الأَشْرَارُ لَمْ تَفِ إِلاَّ","دِيَةَ المَجْدِ بِالدَّمِ المُهْرَاقِ",10,"ق",1,0],["لو أبصروا في الشمسِ موضعَ مَهْجَرٍ","لتسلّقوا لسعيرها اللّواح",11,"ح",1,0],["لو ابصر الحر ما بيدي مزيته","من المكاره طابت عنك الغيل",12,"ل",1,0],["لو أُبرم الميثاقُ ما كَمَلَ الهوى","شرطُ الهوى ان يُنقَض الميثاق",13,"ق",1,0],["لو أبتلى بفراقِ ألْفَىْ صاحبٍ","ولقيتُ مرآه فلستُ أبالِي",14,"ل",2,0],["لَو أَبانَت عَن ذِكرِمَن عاصَرَتهُ","ذَكَرَت تُبَّعاً وَلَم تَنسَ عادا",15,"د",2,0],["لَو أَبصَرَت فِهرٌ فَريقاً مِنهُمُ","ما قيلَ لِلفِهرِيِّ أَنتَ مُجَمَّعُ",16,"ع",1,0],["لو أبصروك مؤرخوا كرمائهم","ندموا وقالوا من لنا بالترك",17,"ك",1,0],["لو أبصر الوجهَ منه منهزمٌ","يطلبه ألفُ فارسٍ وَقفا",18,"ف",2,0],["لو ابصر المتنبي فضل معجزها","لقال عندي لهذا المدح أي نبا",19,"ب",2,0],["لَوْ أَبْصَرَتْ عَيْنَاكَ صُورَتَهُ","أَبْصَرْتَبَدْراً فَوْقَ غُصْنٍ رَطِيبْ",20,"ب",1,0],["لَوْ أَبْصَرَ النُّعْمَانُ بَهْجَةَ حُسْنِهِ","لَمْ يَبْتَهِجْ بِخَوَرْنَقٍ وَسَدِيرِ",21,"ر",1,0],["لو أبصر بعضها ابن أبي حديد","اقام على قصائده الحدادا",22,"د",2,0],["لَوْ أَباحُوا لِلسُّهى أن يَرْتدِي","نُورَهُم أخْفَى سَناهُ القَمَرا",23,"ر",2,0],["لو أبصروا كيف حال الحال بعدهم","رقوا لنا وأراقوا الأدمع الذرفا",24,"ف",2,0],["لَو أَبصر النُسّاكُ بارقَ ثغره","ضَلَّت سَبيلَ رشادِها النُسّاكُ",25,"ك",1,0],["لَو أَبانَت حجابَها أَسماءُ","ما أَبانَت عَن غيرها الأَسماءُ",26,"ا",2,1],["لو أبصرت عيناك يومَ طعانِه","بصدور أهل الكفر والتنّين",27,"ن",1,0],["لَو أَبصَر العاذِلون طَلعتُهُ","ماتوا غَراماً بِهِ وَما شَعَروا",28,"ر",3,0],["لَو أَبصَرَتهُ القاصِرات العين لاف","تَتَنَت بِسحر المُقلة النَجلاءِ",29,"ا",2,0],["لَو أَبصَرتكُ القاصِرا","ت الطَرف مِن غُرف القُصور",30,"ر",1,0],["لو أَبْصَر الأدباءُ فيما قد مَضى","شبهاً لَه ماتوا بغير نِزاع",31,"ع",1,0],["لو أَبْغَضَتْهُمْ مُهْجتي","أخْرَجتُها من جَسَدي",32,"د",2,0],["لَو أَبصَروا بِقُلوبِهِم لاستَبصَروا","وَعمى البَصائِرِ مَن عَمى الأَبصارِ",33,"ر",1,0],["لو أبصرتْ لا رأت سوءاً عُيونكُم","جَوارحي اليوم فيكُم وهي تَختَصِمُ",34,"م",1,0],["لو أباحَتْني جنى مرشفها","لَشَفَتْ مِنْ ريقها الدَّاء العضالا",35,"ل",2,0],["لو أبْصَرَتْ عيناك جامِدَ كأسنا","لرأيت كيف يُذاب فيها العسجد",36,"د",1,0],["لو أبصروكِ وحقِّ الله طالعةً","كالبدرِ فوق قضيبٍ ناعمٍ سجدوا",37,"د",3,0],["لو أبصرت عينُ داوودٍ منافذه","لما تحدى بنسج السَّرْدِ داوودُ",38,"د",1,0],["لَو أَبصَرَ البَحرُ فَيضُ أَنمُلِهِ","فاضَ عَلى وَجهِ فَيضِهِ الخَجَلُ",39,"ل",1,0],["لَو أَبصَرَتِ الحُذّاقُ مِن صاغَةِ النَدى","حُلِيَّ عَطاياهُ أَقَرَّت بِحِذقِهِ",40,"ق",2,0],["لو أبصرتني ناحلاً عينُهُ","لاِستَأنس النّاحلُ بالنّاحلِ",41,"ل",1,0],["لو ابتَغَى أحمَدُ الكِنديُّ مدحَكَ لم","تَقُم لهُ في وفاءِ الحقِّ أركانُ",42,"ن",1,0],["لَوِ ابتغَى لكَ ياقوتٌ مُفاخرةً","لكذَّبَتْهُ شُهُودُ النُّونِ والقَلَمِ",43,"م",1,0],["لو أَبْصَرَتْهُ الفُرْسُ قَدَّسَ نُوْرَهُ","كِسْرَى وأَخْبَتْ نارَها شِيْرِيْنُ",44,"ن",1,0],["لو أبصَر الحرُّ ما يبدي مزيته","من المكاره طابَتْ عنكَ الغِيَل",45,"ل",1,0],["لَو أَبصَروا فيكَ وَجهَ الرَأيِ ما تَرَكوا","حَتّى يَشُدّوكَ كُرهاً شَدَّ مَجنونِ",46,"ن",1,0],["لو أبصر الحسنى فأنذر قومَه","رجعوا إلى الحق المبين وثابوا",47,"ب",3,0],["لو أبصرَ العذّال مسكَ عذارهِ","والخالَ مستتراً يبثُّ العنبَرا",48,"ر",2,0],["لو أبصرَ النُّساكُ فائقَ حسنِهِ","عذلوا العذولَ وحاربوا التفنيدا",49,"د",2,0],["لو أبصر البدر جزءاً من سناك غدا","لفرط حسنك مغتاظاً وممقوتا",50,"ت",2,1],["لَوْ أَبْصَرَ النّعمانُ بهجةَ حُسْنِهِ","لاهتزّ عِطْفاً كاهتزازِ العاصف",51,"ف",1,0],["لَو أبصَرَ المُسلِمُونَ الأوَّلُونَ مُصَا","باً كانَ فِي ظلُمات الغَيبِ مُستَترَا",52,"ر",2,0],["لو أبصروا في الدين نفعا آمنوا","فهم لدين النفع قديسونا",53,"ن",2,0],["لو أبصرت عينه حسن الوجود اذن","لكان أجبره أن يعبد الله",54,"ه",1,0],["لوابس للقتام بكل فجّ","كأن شخوصهنّ قداح بار",55,"ر",1,0],["لو أبصره عويذلي جُن به","كم من أسد بلحظه قد هلكا",56,"ك",2,0],["لو أبصرتْه نِسوةُ المكرِ الَّتِي","قَدْ أُفْتِنتْ لَمْ يَكْفِها قَلْعُ البصر",57,"ر",1,0],["لو أبصرتْ عيناكَ آل مهلّبٍ","والخيلُ راويةُ النحورِ صَوادِ",58,"د",1,0],["لوْ أبْصرتْ منهُ مُلوكٌ مضتْ","مآثراً عن ذاتِه تُعرِبُ",59,"ب",1,0],["لو ابن هاني كان في عصره","لما رأى مصر وزار الخصيب",60,"ب",1,0],["لَو أَبصرت حسنَ مَعناه زليخا نُهىً","لَم تَتَّخذ في هَوى الصديق متّكأ",61,"ا",1,0],["لو أبصروا الموعد الموموق مقتربًا","لجفَّلته إذن من لؤمهم رِيَب",62,"ب",1,0],["لو أبصرت مقلتاك الوقف مبتذلا","آثرت أن تتولاه الشياطين",63,"ن",1,0],["لو أبرموا أمرهم فبالدعا","لك رددناهم مجيبَ من دعا",64,"ع",2,0],["لَو أَبَصَرَت أَهل الطَبيعة ذاتها","رَفَعت لَهُم بِدَليلها آياتُ",65,"ت",1,0],["لو أبت بالبعد قلبي ما يفارقها","هي الخيال ومن قلبي مطالعها",66,"ع",3,0],["لَو أَبصَرَها المَيِّتُ في حُفرَتِهِ","حَقّا نَفَضَ التُربَ وَشَقَّ الكَفَنا",67,"ن",2,0],["لو أبصرت عيناك أقمار البها","من فوق كتبان سمت وغصون",68,"ن",1,0],["لو أبصرت عيناك حالي بعدهم","لأسفت من اسفى وذل خضوعي",69,"ع",2,0],["لو أبصرت عيناك يوم وداعهم","يا صاح وجدى في الخليط ومصرعي",70,"ع",2,0],["لَو أَبصَرَت عَيناكَ ما أَبصَرتُ لَم","تَعتَب عَليَّ وَكُنتَ حَقّاً عاذِري",71,"ر",2,0],["لو ابقت الدنيا على من سلف","لم تك اخلافا وكانوا سلف",72,"ف",1,1],["لو أبصر العاذل منك الّذى","أبصرته أسرع بالعذر",73,"ر",1,0],["لو أبصرت شمس الصباح شموسهم","سقطت كسوفا ، واهتدى نيسان",74,"ن",1,0],["لو أبْصرَتْ وجهي ..فهل ستحبني ..؟","أم هل ستَلعَنُ عندها أشواقها ..؟",75,"ق",3,0],["لو أبنظر في عيونك شفت نظرة إرتياب","شك وناقض في وجوده كل معنى لليقين",76,"ن",1,1],["لَو أَبْلَجَتْ في بَهِيّمِ اللَيّلِ غُرَتُهَا","أضَاءَ مَا بَينَ أَرضِ الرُومِ والعَرَبِ",77,"ب",1,0],["لو أبوصف في جمالك .. من هنا لآخر شهر","والله اني ما وصفتك .. لا ولا جيت بجديد",78,"د",1,0],["لوأبا أخفيها عن العالم بدت","بالنواظر دمعتي أكبر دليل",79,"ل",1,0],["لو ابليس اطاع الله ابد مايكون ملعون","لاكنّه تكبّر لأمر مولاه لاكنّه",80,"ن",2,0]]}