{"poems":[[55,"أثر الهوادج في عراص البيد","https://www.aldiwan.net/poem30633.html","الكامل"],[95,"أمر من يطلب الخلود عسير","https://www.aldiwan.net/poem9165.html","الخفيف"],[95,"قف خاشعاً بضريح عز الدين","https://www.aldiwan.net/poem11214.html","الكامل"],[39,"سلفى نزار إذ تحولت","https://www.aldiwan.net/poem7193.html","مجزوء الكامل"],[53,"قل للأمير إذا مثلت له","https://www.aldiwan.net/poem64651.html","أحذ الكامل"],[87,"ضربوا القباب على اليباب","https://www.aldiwan.net/poem62925.html","مجزوء الكامل"],[87,"قف ناج أهرام الجلال وناد","https://www.aldiwan.net/poem63772.html","الكامل"],[47,"حضرموت وأينما حضرموت","https://www.aldiwan.net/poem65149.html","الخفيف"],[46,"طلل الجميع لقد عفوت حميدا","https://www.aldiwan.net/poem30553.html","الكامل"],[83,"سل في الظلام أخاك البدر عن سهري","https://www.aldiwan.net/poem61518.html","البسيط"],[104,"أيها الموت أي مجلس أنس","https://www.aldiwan.net/poem32933.html","الخفيف"],[48,"راعد تحته صلف","https://www.aldiwan.net/poem23007.html","مجزوء الخفيف"],[15,"حلت كبيشة بطن ذات رؤام","https://www.aldiwan.net/poem45247.html","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62235","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54826","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[79,"حيى ربوع الحي من نعمان","https://www.poetsgate.com/ViewPoem.aspx?id=34207",""],[92,"الأحاديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=179020",""],[190,"ذهب الذين عيهم وجدي","https://www.aldiwan.net/poem43880.html","الكامل"],[233,"قسمة الموت قسمة لا تجور","https://www.aldiwan.net/poem51020.html","الخفيف"],[235,"لي بين سلع والعقيق عهود","https://www.aldiwan.net/poem44566.html","الكامل"],[235,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[239,"جادك الواكف الهتن","https://www.aldiwan.net/poem31739.html","مجزوء الخفيف"],[263,"سل في الظلام أخاك البدر عن سهري","https://www.aldiwan.net/poem35511.html","البسيط"],[275,"أعد الوداع فما أراك تراني","https://www.aldiwan.net/poem52062.html","الكامل"],[370,"الأرض واسعة نعم لكنهم","https://www.aldiwan.net/poem17335.html","الكامل"],[436,"عاف سمعي ذكر المحل العافي","https://www.aldiwan.net/poem12674.html","الخفيف"],[461,"سل في الغضا وصبا الأصائل تنفح","https://www.aldiwan.net/poem56248.html","الكامل"],[503,"قل لمستصغرنا عن حسد","https://www.aldiwan.net/poem38008.html","الرمل"],[517,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[561,"إنما الدين كله تقليد","https://www.aldiwan.net/poem34595.html","الخفيف"]],"verses":[["سَلَفٌ لِكُلِّ كَتيبَةٍ يَطَأُ العِدى","فيها مُفاجَأَةٌ بِغَيرِ وَعيدِ",0,"د",1,0],["سل فحول القريض ممن بهم أث","ل مجداً هذا الزمان الأخير",1,"ر",1,0],["سَلْ فِي التِّجَارَةِ كَيْفَ كَانَ نَجَاحَهُ","وَبُلُوغُهُ مَا لَيْسَ بِالمَظْنُونِ",2,"ن",1,0],["سلفى نِزار إذ تحو","لت المناسمُ كالعَراعرْ",3,"ر",1,1],["سَلَّفتَ فيه فراسةً صَدَقتْ","فحمدتَ ما سلَّفتَ بالأمس",4,"س",1,0],["سَل فاتِحَ الأَبوابِ يَف","تَح لِلكِنانَةِ خَيرَ بابِ",5,"ب",1,0],["سَلَفَ الزَمانُ عَلى المَوَدَّةِ بَينَنا","سَنَواتُ صَحوٍ بَل سَناتُ رُقادِ",6,"د",1,0],["سَلَفٌ لَو رَأَيتَهُمُ لَتَبَيَّن","تَ لَهُم زُلفَةً عَلى الأَسلافِ",7,"ف",1,0],["سَلَفوا يَرَونَ الذِكرَ عَقباً صالِحاً","وَمَضَوا يَعُدّونَ الثَناءَ خُلودا",8,"د",2,0],["سَل في الظَلامِ أَخاكَ البَدرَ عَن سَهَري","تَدري النُجومُ كَما يَدري الوَرى خَبري",9,"ر",2,1],["سلف صالح بَقية قَومٍ","بارك اللَهُ عَهدَهُم في العُهودِ",10,"د",1,0],["سُلِّفَ القَومُ نِعمَةً","ثُمَّ بادوا كَمَن سَلَف",11,"ف",1,0],["سَلَفاً لِأَرعَنَ ما يَخِفُّ ضَبابُهُ","مُتَقَنِّسٍ بادي الحَديدِ لُهامِ",12,"م",1,0],["سَلَفاً لها الخُنُفُ المَرَاخِي تَبْتغِي","جُونَ المَسَاحِلِ والبِطَاءُ تَوَالِي",13,"ل",2,0],["سَلْ فُحُولَ الْقَرِيضِ ممَّنْ بِهِمْ","أَنَلْ مَجْداً هَذَا الزمَانُ الأَخِيرُ",14,"ر",1,0],["سَل فَتاةَ مُدرِكَةٍ","ما لِقَطعِ أَبهَرِها",15,"ر",3,0],["سلفت نسيم الروض رقة عطفها","ووقارها على ثهلان",16,"ن",1,0],["سلَفَت فيهم سنونٌ تَرفاً","واتَتهْم بالبَلِّيات سنون",17,"ن",1,0],["سلفٌ مضوا وبقيت بعدهم","وكذاك يذهب من أتى بعدي",18,"د",2,0],["سَلَفٌ صالح وأملاكُ صِدقٍ","بهمُ تستوي وتُلْوَي الأمور",19,"ر",1,0],["سلفت لنا بين القبب فهل لها","كزماننا الماضي علي معيد",20,"د",1,0],["سَل فِيَّ رَبَّكَ أَن يُوَفِّقَ باطِني","لِرِضاهُ في سِرّي وَفي إِعلاني",21,"ن",2,0],["سَلَّفَ المالَ في الثَنا","ءِ إِذا غَيرُهُ اِحتَجَن",22,"ن",1,0],["سل في الظلام أخاك البدر عن سهري","وسل سميريَ نجم الليل عن سمري",23,"ر",2,1],["سلف ابو خلف غدت آثارهم","في الجود مثل شَرائع الاعيان",24,"ن",1,0],["سَلَفٌ يَعيشُ بِذِكرِنا فَكَأَنَّهُ","مِن بَعدُ لَو سَكَنَ التُرابَ نَبا بِنا",25,"ن",2,0],["سَلفيٌّ مُخايلُ الفضْلِ دلّتْ","أنه من بقيةِ الأسْلافِ",26,"ف",1,0],["سَلْ في الغضا وصَبا الأصائِل تنفحُ","هل ريحُ طيبةَ في الذي يُستروَحُ",27,"ح",1,1],["سَلَفٌ ورَّثَ حالاً خَلَفاً","صدرُهُ المُزَمِّلُ المُدَّثِرُ",28,"ر",1,0],["سلفٌ دعَتْكَ إلى العُلا فنهضْتَ في","أعبائه وحلَلْتَ في شُرُفاتِهِ",29,"ت",2,0],["سلف صالحون صلوا وصاموا","باتباع جميعه تقليد",30,"د",1,0]]}