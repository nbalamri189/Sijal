{"poems":[[53,"أثر الهوادج في عراص البيد","https://www.aldiwan.net/poem30633.html","الكامل"],[93,"أمر من يطلب الخلود عسير","https://www.aldiwan.net/poem9165.html","الخفيف"],[93,"قف خاشعاً بضريح عز الدين","https://www.aldiwan.net/poem11214.html","الكامل"],[37,"سلفى نزار إذ تحولت","https://www.aldiwan.net/poem7193.html","مجزوء الكامل"],[51,"قل للأمير إذا مثلت له","https://www.aldiwan.net/poem64651.html","أحذ الكامل"],[85,"ضربوا القباب على اليباب","https://www.aldiwan.net/poem62925.html","مجزوء الكامل"],[85,"قف ناج أهرام الجلال وناد","https://www.aldiwan.net/poem63772.html","الكامل"],[45,"حضرموت وأينما حضرموت","https://www.aldiwan.net/poem65149.html","الخفيف"],[44,"طلل الجميع لقد عفوت حميدا","https://www.aldiwan.net/poem30553.html","الكامل"],[81,"سل في الظلام أخاك البدر عن سهري","https://www.aldiwan.net/poem61518.html","البسيط"],[102,"أيها الموت أي مجلس أنس","https://www.aldiwan.net/poem32933.html","الخفيف"],[46,"راعد تحته صلف","https://www.aldiwan.net/poem23007.html","مجزوء الخفيف"],[15,"حلت كبيشة بطن ذات رؤام","https://www.aldiwan.net/poem45247.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54826","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[77,"حيى ربوع الحي من نعمان","https://www.poetsgate.com/ViewPoem.aspx?id=34207",""],[90,"الأحاديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=179020",""],[186,"ذهب الذين عيهم وجدي","https://www.aldiwan.net/poem43880.html","الكامل"],[229,"قسمة الموت قسمة لا تجور","https://www.aldiwan.net/poem51020.html","الخفيف"],[231,"لي بين سلع والعقيق عهود","https://www.aldiwan.net/poem44566.html","الكامل"],[231,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[235,"جادك الواكف الهتن","https://www.aldiwan.net/poem31739.html","مجزوء الخفيف"],[259,"سل في الظلام أخاك البدر عن سهري","https://www.aldiwan.net/poem35511.html","البسيط"],[271,"أعد الوداع فما أراك تراني","https://www.aldiwan.net/poem52062.html","الكامل"],[366,"الأرض واسعة نعم لكنهم","https://www.aldiwan.net/poem17335.html","الكامل"],[432,"عاف سمعي ذكر المحل العافي","https://www.aldiwan.net/poem12674.html","الخفيف"],[458,"سل في الغضا وصبا الأصائل تنفح","https://www.aldiwan.net/poem56248.html","الكامل"],[500,"قل لمستصغرنا عن حسد","https://www.aldiwan.net/poem38008.html","الرمل"],[514,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[558,"إنما الدين كله تقليد","https://www.aldiwan.net/poem34595.html","الخفيف"]],"verses":[["سَلَفٌ لِكُلِّ كَتيبَةٍ يَطَأُ العِدى","فيها مُفاجَأَةٌ بِغَيرِ وَعيدِ",0,"د",1,0],["سل فحول القريض ممن بهم أث","ل مجداً هذا الزمان الأخير",1,"ر",1,0],["سَلْ فِي التِّجَارَةِ كَيْفَ كَانَ نَجَاحَهُ","وَبُلُوغُهُ مَا لَيْسَ بِالمَظْنُونِ",2,"ن",1,0],["سلفى نِزار إذ تحو","لت المناسمُ كالعَراعرْ",3,"ر",1,1],["سَلَّفتَ فيه فراسةً صَدَقتْ","فحمدتَ ما سلَّفتَ بالأمس",4,"س",1,0],["سَل فاتِحَ الأَبوابِ يَف","تَح لِلكِنانَةِ خَيرَ بابِ",5,"ب",1,0],["سَلَفَ الزَمانُ عَلى المَوَدَّةِ بَينَنا","سَنَواتُ صَحوٍ بَل سَناتُ رُقادِ",6,"د",1,0],["سَلَفٌ لَو رَأَيتَهُمُ لَتَبَيَّن","تَ لَهُم زُلفَةً عَلى الأَسلافِ",7,"ف",1,0],["سَلَفوا يَرَونَ الذِكرَ عَقباً صالِحاً","وَمَضَوا يَعُدّونَ الثَناءَ خُلودا",8,"د",2,0],["سَل في الظَلامِ أَخاكَ البَدرَ عَن سَهَري","تَدري النُجومُ كَما يَدري الوَرى خَبري",9,"ر",2,1],["سلف صالح بَقية قَومٍ","بارك اللَهُ عَهدَهُم في العُهودِ",10,"د",1,0],["سُلِّفَ القَومُ نِعمَةً","ثُمَّ بادوا كَمَن سَلَف",11,"ف",1,0],["سَلَفاً لِأَرعَنَ ما يَخِفُّ ضَبابُهُ","مُتَقَنِّسٍ بادي الحَديدِ لُهامِ",12,"م",1,0],["سَلْ فُحُولَ الْقَرِيضِ ممَّنْ بِهِمْ","أَنَلْ مَجْداً هَذَا الزمَانُ الأَخِيرُ",13,"ر",1,0],["سَل فَتاةَ مُدرِكَةٍ","ما لِقَطعِ أَبهَرِها",14,"ر",3,0],["سلفت نسيم الروض رقة عطفها","ووقارها على ثهلان",15,"ن",1,0],["سلَفَت فيهم سنونٌ تَرفاً","واتَتهْم بالبَلِّيات سنون",16,"ن",1,0],["سلفٌ مضوا وبقيت بعدهم","وكذاك يذهب من أتى بعدي",17,"د",2,0],["سَلَفٌ صالح وأملاكُ صِدقٍ","بهمُ تستوي وتُلْوَي الأمور",18,"ر",1,0],["سلفت لنا بين القبب فهل لها","كزماننا الماضي علي معيد",19,"د",1,0],["سَل فِيَّ رَبَّكَ أَن يُوَفِّقَ باطِني","لِرِضاهُ في سِرّي وَفي إِعلاني",20,"ن",2,0],["سَلَّفَ المالَ في الثَنا","ءِ إِذا غَيرُهُ اِحتَجَن",21,"ن",1,0],["سل في الظلام أخاك البدر عن سهري","وسل سميريَ نجم الليل عن سمري",22,"ي",1,1],["سلف ابو خلف غدت آثارهم","في الجود مثل شَرائع الاعيان",23,"ن",1,0],["سَلَفٌ يَعيشُ بِذِكرِنا فَكَأَنَّهُ","مِن بَعدُ لَو سَكَنَ التُرابَ نَبا بِنا",24,"ن",2,0],["سَلفيٌّ مُخايلُ الفضْلِ دلّتْ","أنه من بقيةِ الأسْلافِ",25,"ف",1,0],["سَلْ في الغضا وصَبا الأصائِل تنفحُ","هل ريحُ طيبةَ في الذي يُستروَحُ",26,"ح",1,1],["سَلَفٌ ورَّثَ حالاً خَلَفاً","صدرُهُ المُزَمِّلُ المُدَّثِرُ",27,"ر",1,0],["سلفٌ دعَتْكَ إلى العُلا فنهضْتَ في","أعبائه وحلَلْتَ في شُرُفاتِهِ",28,"ت",2,0],["سلف صالحون صلوا وصاموا","باتباع جميعه تقليد",29,"د",1,0]]}