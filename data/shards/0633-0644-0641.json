{"poems":[[55,"أثر الهوادج في عراص البيد","https://www.aldiwan.net/poem30633.html","الكامل"],[95,"أمر من يطلب الخلود عسير","https://www.aldiwan.net/poem9165.html","الخفيف"],[95,"قف خاشعاً بضريح عز الدين","https://www.aldiwan.net/poem11214.html","الكامل"],[39,"سلفى نزار إذ تحولت","https://www.aldiwan.net/poem7193.html","مجزوء الكامل"],[53,"قل للأمير إذا مثلت له","https://www.aldiwan.net/poem64651.html","أحذ الكامل"],[87,"ضربوا القباب على اليباب","https://www.aldiwan.net/poem62925.html","مجزوء الكامل"],[87,"قف ناج أهرام الجلال وناد","https://www.aldiwan.net/poem63772.html","الكامل"],[47,"حضرموت وأينما حضرموت","https://www.aldiwan.net/poem65149.html","الخفيف"],[46,"طلل الجميع لقد عفوت حميدا","https://www.aldiwan.net/poem30553.html","الكامل"],[83,"سل في الظلام أخاك البدر عن سهري","https://www.aldiwan.net/poem61518.html","البسيط"],[104,"أيها الموت أي مجلس أنس","https://www.aldiwan.net/poem32933.html","الخفيف"],[48,"راعد تحته صلف","https://www.aldiwan.net/poem23007.html","مجزوء الخفيف"],[15,"حلت كبيشة بطن ذات رؤام","https://www.aldiwan.net/poem45247.html","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62235","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54826","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[79,"حيى ربوع الحي من نعمان","https://www.poetsgate.com/ViewPoem.aspx?id=34207",""],[92,"الأحاديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=179020",""],[190,"ذهب الذين عيهم وجدي","https://www.aldiwan.net/poem43880.html","الكامل"],[234,"قسمة الموت قسمة لا تجور","https://www.aldiwan.net/poem51020.html","الخفيف"],[236,"لي بين سلع والعقيق عهود","https://www.aldiwan.net/poem44566.html","الكامل"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[240,"جادك الواكف الهتن","https://www.aldiwan.net/poem31739.html","مجزوء الخفيف"],[264,"سل في الظلام أخاك البدر عن سهري","https://www.aldiwan.net/poem35511.html","البسيط"],[276,"أعد الوداع فما أراك تراني","https://www.aldiwan.net/poem52062.html","الكامل"],[371,"الأرض واسعة نعم لكنهم","https://www.aldiwan.net/poem17335.html","الكامل"],[438,"عاف سمعي ذكر المحل العافي","https://www.aldiwan.net/poem12674.html","الخفيف"],[463,"سل في الغضا وصبا الأصائل تنفح","https://www.aldiwan.net/poem56248.html","الكامل"],[505,"قل لمستصغرنا عن حسد","https://www.aldiwan.net/poem38008.html","الرمل"],[519,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[563,"إنما الدين كله تقليد","https://www.aldiwan.net/poem34595.html","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64040","الخفيف"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100143","المديد"],[982,"","https://poetry.dctabudhabi.ae/diwan/poem/199800","الرمل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136301","الرجز"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136175","الكامل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78113","الرمل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115877","الرجز"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52077","الرمل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202132","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53168","الرجز"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28517","الرمل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/61013","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100245","السريع"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100330","الرمل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82825","الرمل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88899","الكامل"],[3536,"","https://poetry.dctabudhabi.ae/diwan/poem/20641","الكامل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132020","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91755","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91715","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91376","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131247",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114588","السريع"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36626","الدوبيت"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91003","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90831","الرمل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136675",""],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66142","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33706","الرمل"],[3464,"خلع الزمان على الربا","https://www.poetsgate.com/ViewPoem.aspx?id=158715",""],[4830,"يالِقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=213988",""],[5183,"فارس الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=186549",""],[5185,"القصيدة اليمانية","https://www.poetsgate.com/ViewPoem.aspx?id=74641",""],[5756,"قدها وقدود","https://www.poetsgate.com/ViewPoem.aspx?id=5439",""],[5879,"يا نبض القلب","https://www.poetsgate.com/ViewPoem.aspx?id=215451",""],[5956,"جاءني طفلٌ نحيل","https://www.poetsgate.com/ViewPoem.aspx?id=192779",""],[6142,"أين يا مسنح الجآذر إذا","https://www.poetsgate.com/ViewPoem.aspx?id=155729",""],[6354,"منابر موبوءة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87923&r=&rc=0",""]],"verses":[["سَلَفٌ لِكُلِّ كَتيبَةٍ يَطَأُ العِدى","فيها مُفاجَأَةٌ بِغَيرِ وَعيدِ",0,"د",1,0],["سل فحول القريض ممن بهم أث","ل مجداً هذا الزمان الأخير",1,"ر",1,0],["سَلْ فِي التِّجَارَةِ كَيْفَ كَانَ نَجَاحَهُ","وَبُلُوغُهُ مَا لَيْسَ بِالمَظْنُونِ",2,"ن",1,0],["سلفى نِزار إذ تحو","لت المناسمُ كالعَراعرْ",3,"ر",1,1],["سَلَّفتَ فيه فراسةً صَدَقتْ","فحمدتَ ما سلَّفتَ بالأمس",4,"س",1,0],["سَل فاتِحَ الأَبوابِ يَف","تَح لِلكِنانَةِ خَيرَ بابِ",5,"ب",1,0],["سَلَفَ الزَمانُ عَلى المَوَدَّةِ بَينَنا","سَنَواتُ صَحوٍ بَل سَناتُ رُقادِ",6,"د",1,0],["سَلَفٌ لَو رَأَيتَهُمُ لَتَبَيَّن","تَ لَهُم زُلفَةً عَلى الأَسلافِ",7,"ف",1,0],["سَلَفوا يَرَونَ الذِكرَ عَقباً صالِحاً","وَمَضَوا يَعُدّونَ الثَناءَ خُلودا",8,"د",2,0],["سَل في الظَلامِ أَخاكَ البَدرَ عَن سَهَري","تَدري النُجومُ كَما يَدري الوَرى خَبري",9,"ر",2,1],["سلف صالح بَقية قَومٍ","بارك اللَهُ عَهدَهُم في العُهودِ",10,"د",1,0],["سُلِّفَ القَومُ نِعمَةً","ثُمَّ بادوا كَمَن سَلَف",11,"ف",1,0],["سَلَفاً لِأَرعَنَ ما يَخِفُّ ضَبابُهُ","مُتَقَنِّسٍ بادي الحَديدِ لُهامِ",12,"م",1,0],["سَلَفاً لها الخُنُفُ المَرَاخِي تَبْتغِي","جُونَ المَسَاحِلِ والبِطَاءُ تَوَالِي",13,"ل",2,0],["سَلْ فُحُولَ الْقَرِيضِ ممَّنْ بِهِمْ","أَنَلْ مَجْداً هَذَا الزمَانُ الأَخِيرُ",14,"ر",1,0],["سَل فَتاةَ مُدرِكَةٍ","ما لِقَطعِ أَبهَرِها",15,"ر",3,0],["سلفت نسيم الروض رقة عطفها","ووقارها على ثهلان",16,"ن",1,0],["سلَفَت فيهم سنونٌ تَرفاً","واتَتهْم بالبَلِّيات سنون",17,"ن",1,0],["سلفٌ مضوا وبقيت بعدهم","وكذاك يذهب من أتى بعدي",18,"د",2,0],["سَلَفٌ صالح وأملاكُ صِدقٍ","بهمُ تستوي وتُلْوَي الأمور",19,"ر",1,0],["سلفت لنا بين القبب فهل لها","كزماننا الماضي علي معيد",20,"د",1,0],["سَل فِيَّ رَبَّكَ أَن يُوَفِّقَ باطِني","لِرِضاهُ في سِرّي وَفي إِعلاني",21,"ن",2,0],["سَلَّفَ المالَ في الثَنا","ءِ إِذا غَيرُهُ اِحتَجَن",22,"ن",1,0],["سل في الظلام أخاك البدر عن سهري","وسل سميريَ نجم الليل عن سمري",23,"ر",2,1],["سلف ابو خلف غدت آثارهم","في الجود مثل شَرائع الاعيان",24,"ن",1,0],["سَلَفٌ يَعيشُ بِذِكرِنا فَكَأَنَّهُ","مِن بَعدُ لَو سَكَنَ التُرابَ نَبا بِنا",25,"ن",2,0],["سَلفيٌّ مُخايلُ الفضْلِ دلّتْ","أنه من بقيةِ الأسْلافِ",26,"ف",1,0],["سَلْ في الغضا وصَبا الأصائِل تنفحُ","هل ريحُ طيبةَ في الذي يُستروَحُ",27,"ح",1,1],["سَلَفٌ ورَّثَ حالاً خَلَفاً","صدرُهُ المُزَمِّلُ المُدَّثِرُ",28,"ر",1,0],["سلفٌ دعَتْكَ إلى العُلا فنهضْتَ في","أعبائه وحلَلْتَ في شُرُفاتِهِ",29,"ت",2,0],["سلف صالحون صلوا وصاموا","باتباع جميعه تقليد",30,"د",1,0],["سَلَفٌ كان فيهمُ من ملوكٍ","ورثوا مُلْكَهم عن الأسلاف",31,"ف",1,0],["سلفاً كلفتني شغفاً","شغفاً كلفتني سلفا",32,"ف",2,1],["سل في فودي ما اغ","مد منه في فؤادي",33,"ي",1,0],["سلفي يا نعم السلف","أهل المقامات العوال",34,"ل",1,0],["سلف على نهج الرسول توجهوا","يقفونه مع قوة استعداد",35,"د",1,0],["سَلَّ فينا اللَحظ هنديّا","وَأَرانا القَد خَطيّا",36,"ي",2,1],["سلفنَ أيّامى وما","جادت به ولا حَبَت",37,"ت",1,0],["سلفوا ونالوا المجد من آبائهِ","انقذتهُ ويلاهُ عزَّ تصبري",38,"ي",1,0],["سَلْ فَسِيحَ الأرض عَنْ أفلاذه","أينَ مَرَّتْ فِي فِجَاج السُّبَلِ",39,"ل",1,0],["سل فجاجًا بهنَّ كنت سراجًا","لسُراةٍ تبغي المسيرَ أماما",40,"م",2,0],["سل فتيات الحله","قتليَ مَنْ أحله",41,"ل",2,1],["سَل فُروعَ البانِ عَن قَلبي فَقَد","وَهِمَ البارِقُ فيما ذَكَرا",42,"ر",2,0],["سَلْ فيَّ رَبَّك إن يُسَهل مخرجي","عَجِلاً فقلبكُ ما أحَن ومَا ابر",43,"ر",1,0],["سل فصحاء العصر تخبرك كم","ردهم بالقول غير الفصاح",44,"ح",1,0],["سلفت ما بين جمعٍ ومنى","طارحتني الغيد فيها زمنا",45,"ن",2,0],["سَل فَرنسا سَل سُوِسرا","لُندُرا لا شَكَّ أَدرى",46,"ر",2,0],["سلفت ليال فيه وهي لنا المعي","شة في الدنا واللب من أزماني",47,"ن",2,0],["سَلَفَت سَوالِفُها بِأَنفُسِ مَن مَضى","وَكَذاكَ يَتبَعُ باقِياً أُخراها",48,"ا",3,0],["سلف كان لنا مستعصما","بكتاب الله في دنيا ودين",49,"ن",1,0],["سَلفت كَأَنا لَم نَكُن وَكَأَنها","قَد أَسرعت في غَربها بِالعَين",50,"ن",1,0],["سلفت بِأَيّ أَحبة وَسلافة","وَالعُمر ميدانٌ عليهِ يركض",51,"ض",1,0],["سَلفت بِأَحسن حالةٍ وألذِّها","يا لَيت ذاكَ الوَصلَ جادَ بطيفه",52,"ف",2,0],["سل فروقاً والخطب يغشى ذراها","أين تلك العلى وذاك الشان",53,"ن",1,0],["سلفتُ في أيامِنا الماضيَه","معَ حبيبٍ عيشَةً راضيَه",54,"ض",3,1],["سَل فاتِنَةَ القَدّ فُؤادي حَلَّت","في العِشق دِماءٌ سُفِكَت هَل حَلَّت",55,"ت",1,1],["سلف مآثرهم أتى في مثلها","خلف لبنيان المساجد احكموا",56,"م",3,0],["سلف ابقى لنا من بعده","خلفا للسر فيه سريان",57,"ن",1,0],["سلَّ في ناظِريه للفَتك عَضباً","ليس يُجي المشوق منه الحِذار",58,"ر",1,0],["سَلَفٌ امامَ الناسِ قَدْ سارُوا الوَحَي","والخَلْفُ سارُوا خَلْفَ كلِّ رِكاب",59,"ب",1,0],["سل فُؤادي أيُّها الظالمُ لي","في الهَوى أيّ طريقٍ سَلَكا",60,"ك",2,0],["سلفت ليال فيه فه","ي لنا المعيشة في الدنا",61,"ن",2,0],["سَلْ فؤادي بالهوى كيفَ افتَتَنْ","وجفونَ العينِ عن هجرِ الوَسَنْ",62,"ن",1,1],["سل \"فارس الضاد\" عن كنز اللغات وعن","عالي \"المقامات\" لا تقنع بمنعطف",63,"ف",1,0],["سلفية تلك العيون وتحتها","من خير ربي رحمة وحنان",64,"ن",1,0],["سلفنا ما لحقناهم تحت قاع التراب رقود","ولا يبقي من الميت سوى ذكراه وعظامه",65,"م",2,0],["سَلَفُ العشاق لنا رسموا","دربا نرعاه فلا نحدُ",66,"د",1,0],["سلَفاً أعرف حُلْمي","محضَ أمرٍ مستحيلْ",67,"ل",1,0],["سل فيه على الهدى أي عضب","شحذته يد الضلالة شحذا",68,"ذ",2,0],["سلفيةٌ .. شيعيةٌ .. جاميةٌ","فمنابرٌ موبوءةٌ .. وهراءُ",69,"ا",2,0]]}