{"poems":[[11,"أبلغ الحارث بن عمرو بأني","https://www.aldiwan.net/poem226.html",""],[93,"خير ما يكتبه ذو مرقم","https://www.aldiwan.net/poem8865.html","عموديه"],[91,"لم تكن هذه الحياة سوى حرب","https://www.aldiwan.net/poem44902.html","الخفيف"],[45,"إنما بدر بن عمار سحاب","https://www.aldiwan.net/poem9467.html","الرمل"],[52,"لا تلمني على عبيدة صاح","https://www.aldiwan.net/poem63969.html","الخفيف"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140868",""],[92,"بشرى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179106",""],[136,"لمعان البروق هاج الهموما","https://www.aldiwan.net/poem54745.html","الخفيف"],[141,"شاع شعري في سليمى وظهر","https://www.aldiwan.net/poem68001.html","الرمل"],[230,"إن ما بت تشتكي منه داء","https://www.aldiwan.net/poem55207.html","الخفيف"],[242,"لا تخف أن ينقض الذن","https://www.aldiwan.net/poem19285.html","مجزوء الرمل"],[264,"عند قطب التصريف طولا وعرضا","https://www.aldiwan.net/poem35966.html","الخفيف"],[358,"أترع الأكواب من صافي الشراب","https://www.aldiwan.net/poem40771.html","الرمل"],[505,"بدر حسن راق العيون شهوده","https://www.aldiwan.net/poem38027.html","الخفيف"],[563,"إن ترم أن تعرف الأحوال","https://www.aldiwan.net/poem34230.html","المديد"],[563,"إنما بيت عزتي وهو قلبي","https://www.aldiwan.net/poem34927.html","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37952","الخفيف"],[978,"","https://poetry.dctabudhabi.ae/diwan/poem/73897","الرمل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95570","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48966","الخفيف"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46467","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77216","المديد"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106893","الخفيف"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106849","الخفيف"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137106",""],[3162,"","https://poetry.dctabudhabi.ae/diwan/poem/142907","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125858","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86451","الخفيف"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136941",""],[4291,"","https://poetry.dctabudhabi.ae/diwan/poem/142469","الرمل"],[4620,"","https://poetry.dctabudhabi.ae/diwan/poem/199988","الخفيف"],[5121,"التَّحَايَا","https://www.poetsgate.com/ViewPoem.aspx?id=215348",""],[5338,"« يا رسول الله خذ بيدي »","https://www.poetsgate.com/ViewPoem.aspx?id=187760",""],[5414,"الهابطون والصاعدون","https://www.poetsgate.com/ViewPoem.aspx?id=12938",""],[5956,"حُلُمُ أمِّ فقير ‏","https://www.poetsgate.com/ViewPoem.aspx?id=184622",""],[5970,"محنة تأتي وأخرى في رواح","https://www.poetsgate.com/ViewPoem.aspx?id=130629",""]],"verses":[["إِنَّما بَينَنا وَبَينَكَ فَاِعلَم","سَيرُ تِسعٍ لِلعاجِلِ المُنتابِ",0,"ب",1,0],["إِنَّما بَأسُ الأُلى قَد سَلَفوا","قَتلَ النَهمَةَ فيه وَالشَرَه",1,"ر",2,0],["انما بين الشعب والعلم والش","شِعر اذا صحت نهضة اوشاج",2,"ج",1,0],["إِنَّما بَدرُ بنُ عَمّارٍ سَحابُ","هَطِلٌ فيهِ ثَوابٌ وَعِقابُ",3,"ب",1,1],["إِنَّما بَدرٌ رَزايا وَعَطايا","وَمَنايا وَطِعانٌ وَضِرابُ",3,"ب",1,0],["إِنَّما بِالفُؤادِ وَالعَينِ مِنّي","حُبُّ شَبعى الخَلخالِ غَرثى الوِشاحِ",4,"ح",1,0],["إنما بدر ابن عمارٍ سحابٌ","هطلٌ فيه ثوابٌ وعقاب",5,"ب",1,1],["إن ما بين حالَتَيْهِ لَفَرقاً","مثلَ ما بين مشِيةٍ وَوُقوف",6,"ف",1,0],["إِنَّ مَأ بي لِمن فَتَاةٍ سَبتني","وكَستني هَوىً لَذِيذاً أَلِيمَا",7,"م",2,0],["إِنَّما بِنتُ سَعيدٍ قَمَرٌ","هَل حَرِجنا إِن سَجَدنا لِلقَمَر",8,"ر",1,0],["إِنَّ ما بِتَّ تَشتَكي منه داءُ","هيَ أَدرى بِبُرئِه لَو تَشاءُ",9,"ا",2,1],["إِنَّ مَا بَيْنِي وَبَيْنَكَْ","لَوْ بَدَا أَعْجَبَ عَيْنَكْ",10,"ك",1,0],["إِنَّما بِاِعتِبارِ حَجبِيَ أَبدَي","تُ لَهُ الحالَ إِذ بِيَ الحالُ أَفضى",11,"ض",2,0],["إِنَّما بَينَكُما أَصل العَنا","فَهوَ أَغرى بِي عَلى طول اِغتِرابي",12,"ب",2,0],["إِنَّما بُرْعَةُ الوُجودِ كَعامٍ","وهو في شِرعَةِ الحَقيقةِ عيدُهْ",13,"د",2,0],["إنما بالله جل إذا","لازم التقوى بلا إهمال",14,"ل",1,0],["إنما بيت عزتي وهو قلبي","نازل فيه منه قرآن ربي",15,"ب",2,1],["إِنَّ ما بي لَو كانَ فَوقَ حَديدٍ","كانَ قَد ذابَ مِن أَقسى الحَديدِ",16,"د",1,0],["إِنَّما بي حِينَ يَدنُو أَجَلي","لَستُ أَلقاكَ وأَلقَى الأَجَلا",17,"ل",2,0],["إنما بغيتى من النيل كأسٌ","هى آشهى رشفاً وأحلى رضابَا",18,"ب",2,0],["إنما برّاته محكمةُ الحبِّ","كأَنَّ البَها رشا الحُكَّاما",19,"م",2,0],["إِنَّما بابك باب الن","في لا باب الجَزاء",20,"ا",2,0],["إِنَّ ما بي لَستَ تَعرِفُهُ","نارُ شَوقٍ أَنضَجَت كَبِدي",21,"د",2,0],["إن ما بين أضلعي جمرات","أَطفئوا نار هذه الجمرات",22,"ت",1,0],["إنما بينهم عزيزةُ كالجاني","ولا عفو عندهم للجناة",23,"ه",1,0],["انما بولس كبيت قصيد","وهو مهوى ضمائر القصاد",24,"د",1,0],["إنما بعد أن يفوت أوان","ونلاقي يوم التنادي الحسابا",25,"ب",2,0],["إنما بالظلم منهم","طفحت منا الكؤوسُ",26,"س",1,0],["إنما بينهم على ما عراه","بيت عز شأى البيوت ارتفاعا",27,"ع",2,0],["ان ما بيننا حديث عتابٍ","من هديل الحمام أشجى وأوقع",28,"ع",1,0],["إنما بالخوف عبد","قبل الذل مراحا",29,"ح",2,0],["إنما بيننا السكوت وإني","إن تحدثت فالحديث شجون",30,"ن",1,0],["إِنَّمَا بُخْلٌ أَمْ عِنَادٌ وَرَبِّي","لَسْتُ أَدْرِي كَيْفَ الطِّبَاعُ تُثِيرُ",31,"ر",1,0],["إِنَّمَا بُغْضًا لِمَنْ نَزَلَتْ","فِيهِ آيُ الذِّكْرِ ذِي الرَّشَدِ",32,"د",1,0],["إن ما بِعْتُمُو عزيزٌ نفيسٌ","بحقير \"مقاسُه أمتارُ\"",33,"ر",1,0],["إنما بيعتْ ولم نشهد لها","مَثَلاً.. حتى تولَّانا الكدرْ",34,"ر",1,0],["إنما بلسمنا في كفنا","كيف لا نأسو به كل الجراح",35,"ح",1,0]]}