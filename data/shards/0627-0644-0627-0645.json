m/54563","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67334","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141986","الكامل"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9557","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[106,"هرم يهوي 2","https://www.poetsgate.com/ViewPoem.aspx?id=179486",""],[106,"الملاح التائه","https://www.poetsgate.com/ViewPoem.aspx?id=179552",""],[106,"تحيْة الرسالة","https://www.poetsgate.com/ViewPoem.aspx?id=179503",""],[106,"صدى الجمهورية","https://www.poetsgate.com/ViewPoem.aspx?id=179586",""],[106,"طوى الموت إبراهيم!","https://www.poetsgate.com/ViewPoem.aspx?id=179679",""],[106,"أدب الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=179476",""],[106,"إلى الغزاة الهادمين","https://www.poetsgate.com/ViewPoem.aspx?id=179650",""],[106,"سلوا الدرجات","https://www.poetsgate.com/ViewPoem.aspx?id=179772",""],[106,"بيوت الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=179528",""],[106,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""],[106,"حديث خرافة","https://www.poetsgate.com/ViewPoem.aspx?id=179406",""],[106,"أعياد النصر","https://www.poetsgate.com/ViewPoem.aspx?id=179343",""],[77,"هاجتك إذ جئت اللوى فزرودا","https://www.poetsgate.com/ViewPoem.aspx?id=34092",""],[90,"بين قطرين","https://www.poetsgate.com/ViewPoem.aspx?id=179019",""],[90,"في ذكرى الخالصي","https://www.poetsgate.com/ViewPoem.aspx?id=179047",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[54,"أَلاَ مَا لِعَيني بالدُّمُوعِ استهلَّتِ","https://www.poetsgate.com/ViewPoem.aspx?id=13860",""],[91,"وردة وأميل","https://www.poetsgate.com/ViewPoem.aspx?id=53233",""],[51,"الدينُ والعلمُ والنَّعماءُ والشرفُ","https://www.poetsgate.com/ViewPoem.aspx?id=29594",""],[32,"ومما شجاني أنها يوم ودعت","https://www.poetsgate.com/ViewPoem.aspx?id=111",""],[39,"أَلاَ مَنْ لِعَيْنٍ لاَ يَجِفُّ سُجُومُها","https://www.poetsgate.com/ViewPoem.aspx?id=4270",""],[97,"الغريب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63520&r=&rc=67",""],[31,"ألا من يرى رأيَ امرىء ٍ ذي قرابة ٍ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18938&r=&rc=201",""],[31,"إحرجي وتأثمي،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19045&r=&rc=308",""],[20,"أرِقت لمكفهِر بات فيه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69759&r=&rc=0",""]],"verses":[["أَلا ما أُفَيصِحَ هَذا الكَلام","لَوَ اَنَّ لَهُ أُذُناً واعِيَه",0,"ي",2,0],["أَلا مُخبِرٌ فيما يَقولُ جَلِيَّةً","يُزيلُ بِها الشَكَّ المُريبَ يَقينُ",1,"ن",1,1],["أَلا مَن مُبلِغُ الأَحياءِ أَنّي","قَطَعتُ قَرائِنِ الزَمَنِ القَديمِ",2,"م",1,0],["أُلامُ أَنّي رَثَيتُ زافِرَةً","كانوا نَجومَ الفَخارِ أَو لُمَعَه",3,"ع",2,0],["أَلا مَن لِأَضيافِ الشَتاءِ يَلُفُّهُم","سَقيطُ ظَلامٍ قِطقِطٍ وَصَقيعُ",4,"ع",1,0],["أَلا مَن كُنتُ شاعِرَهُ","فَإِنَّ المَجدَ شاعِرُه",5,"ر",2,0],["أَلا مَن يُمطِرُ السَنَةَ الجَمادا","وَمَن لِلجَمعِ يُطلِعُهُ النِجادا",6,"د",2,1],["أُلامُ فيكَ وَأُذني غَيرُ سامِعَةٍ","فَاللَومُ مُطَّرَحٌ وَالعَذلُ مَردودُ",7,"د",1,0],["أَلا مَن عَذيري في رِجالٍ تَواعَدوا","لِحَربِيَ مِن رامي عُقوقٍ وَرامِحِ",8,"ح",1,1],["إِلامَ أُصفيكُمُ وُدّي عَلى مَضَضٍ","وَكَم أُنيرُ وَأُسدي فيكُمُ المِدَحا",9,"ح",2,0],["أَلا مَن لِجسمٍ بِالثَّويَّةِ قاطِنِ","وَقَلبٍ مَعَ الرَّكبِ الحِجازيِّ ظاعِنِ",10,"ن",1,1],["ألا مَن لِصَبٍّ إِن تَغَشَّتهُ نَعسَةٌ","سَرى البَرقُ نَجديَّ السَّنا وَهوَ شائِقُهْ",11,"ق",2,1],["أُلامُ عَلى نَجدٍ وَأَبكي صَبابَةً","رُوَيدَكَ يا دَمعي وَيا عاذِلي رِفقا",12,"ق",2,1],["أَلا ما لَحيٍّ بالعُذَيبِ خِماصِ","فَلا مالَ إِلّا صارمي وَدِلاصي",13,"ي",1,1],["ألا مَنْ لنَفْسٍ لا تزالُ مُشيحَةً","على كَمَدٍ لمْ يَبْقَ إلا ذَماؤُها",14,"ا",3,1],["أَلا مَن مُبلِغٌ أَهلَ الجُحودِ","مَقالَ فَتىً وَفِيٍّ بِالعُهودِ",15,"د",1,1],["أَلا ما لي وَلِلرُقَباءِ ما لي","وَما لَهُمُ أَأَسكُتُ أَم أَصيحُ",16,"ح",1,0],["أَلا مَن يَرحَمُ الظَمآ","نَ يَستَسقي فَلا يُسقى",17,"ا",1,0],["أَلاَ مَنْ نَصِيرِي فِي جِلاَدِ تَبَاعُدٍ","ألا من مُجِيِري مِنْ نَوىً مَدَّ أَشْطَانَا",18,"ن",2,0],["إلا مَواقِدَ كالحَمامِ جَواثِماً","وترى بأظْلافِ الظِّباءِ كَديدا",19,"د",2,0],["ألا مَن مُبلِغٌ عَنّي حُرَيثاً","مُغَلغَلَةً أَحانَ أَمِ اِزدَرانا",20,"ن",2,1],["الأُمُّ مَدرَسَةٌ إِذا أَعدَدتَها","أَعدَدتَ شَعباً طَيِّبَ الأَعراقِ",21,"ق",1,0],["الأُمُّ رَوضٌ إِن تَعَهَّدَهُ الحَيا","بِالرِيِّ أَورَقَ أَيَّما إيراقِ",21,"ق",1,0],["الأُمُّ أُستاذُ الأَساتِذَةِ الأُلى","شَغَلَت مَآثِرُهُم مَدى الآفاقِ",21,"ق",1,0],["أَلا مَن مُبلِغٌ عَمرَو بنَ هِندٍ","فَما رُعِيَت ذَمامَةُ مَن رَعَيتا",22,"ت",2,1],["أُلامُ عَلى أُمِّ الوَلِيدِ وَحُبُّها","جَوىً داخِلٌ تحت الشّراسيفِ مُلهَبُ",23,"ب",1,0],["أَلا ما لِعَينَيكِ لا تَهجَعُ","تُبَكّي لَوَ اِنَّ البُكاءَ يَنفَعُ",24,"ع",1,1],["أَلا مَن لِعَينٍ لا تَجِفُّ دُموعُها","إِذا قُلتُ أَفثَت تَستَهِلُّ فَتَحفِلُ",25,"ل",1,0],["أَلا ما لِعَينِكِ أَم ما لَها","لَقَد أَخضَلَ الدَمعُ سِربالَها",26,"ل",3,1],["الأم كانت أتانا","لكنما المهر خالي",27,"ي",1,0],["الأَمْرُ أَمْرُ اللهِ إِنْ يَعْجِلْ وَإِنْ","يَمْهِلْ وَمَا تَعْدُوهُ حِيلَةُ عَبْدِهِ",28,"د",2,0],["أَلأَمَانَ الأَمَانَ أَلْقَيْتُ سَيْفِي","وَطَوَيْتُ اللِّوَاءَ تَسْلِيمَ رَاغِمْ",29,"م",1,0],["أَلأَمرُ لِلهِ فِي الدُّنْيَا وَغَايَتِهَا","أَكُنْتَ مُمْتَثِلاً أَمْ غَيْرَ مُمتَثِلِ",30,"ل",1,0],["أَلا ما لِعَيني بِالدُموعِ اِستَهَلَّتِ","وَلَو نَفِدَت ماءُ الشُؤونِ لَقَلَّتِ",31,"ت",1,1],["أُلامُ عَلى بُغضي لِما بَينَ حَيَّةٍ","وَضَبعٍ وَتِمساحٍ تَغَشّاكَ مِن بَحرِ",32,"ر",1,1],["الأمير بدر المواكب","زدل ناجم فالكواكب",33,"ب",1,1],["ألا من مبلغ عنّي زنيماً","من اللقطاء ذا نزق وهَذر",34,"ر",1,1],["ألا ما لأهل الشرق في بُرَحاء","يعيشون في ذُلّ به وشقاء",35,"ا",2,1],["ألا ما بال دمعي ليس يرقا","كأنّ بمُقلتي عِرقاً ضَرِيّا",36,"ر",3,0],["أُلامُ عَلى الصَبابَةِ وَالمَهارى","تَحِنُّ إِذا تَذَكَّرَتِ النِزاعا",37,"ع",2,0],["أَلا مُبلِغٌ عَنّي اِبنَ عَمّي أَلوكَةً","بَثَثتُ بِها بَعضَ الَّذي أَنا كاتِمُه",38,"م",2,0],["أَلا مُبلِغٌ عَنّي الحُسَينَ أَلوكَةً","تَضَمَّنَها دُرُّ الكَلامِ المُنَظَّمِ",39,"م",1,0],["أُلامُ عَلى التَعَرُّضِ لِلمَنايا","وَلي سَمعٌ أَصَمُّ عَنِ المَلامِ",40,"م",1,0],["أَلا مَن مُبلِغٌ سَرَواتِ قَومي","وَسَيفَ الدَولَةِ المَلِكِ الهُماما",41,"م",2,1],["أَلا ما لِمَن أَمسى يَراكَ وَلِلبَدرُ","وَما لِمَكانٍ أَنتَ فيهِ وَلِلقَطرِ",42,"ر",1,1],["أَلا مَن مُبلِغٌ عَنّي رَبيعاً","فَما أَحدَثتَ في الحَدَثانِ بَعدي",43,"د",2,1],["أَلا مَن مُبلِغٌ عَنّي أُبَيّاً","لَقَد أُلقيتَ في سُحقِ السَعيرِ",44,"ر",1,1],["الأمر أدهى والذي غاب من","شكوى الورى أكثر مما سنح",45,"ح",1,0],["ألا من لمسلوب الفؤاد رهينه","معنى بمحجوب الوداد ضنينه",46,"ن",2,1],["ألا من لصبٍّ من جفاه وشجوه","شكى السقم حتَّى ما يكادُ يبين",47,"ن",1,0],["الأمانَ الأمانَ منك ومنه","جَنِّباني لظَاكما الكَوّاءَ",48,"ا",2,0],["الأمنُ والخصبُ للثَّاوي بعقْوَتِهِ","وقْفَيْنِ قد كَفَياهُ كلّ مضطرَبِ",49,"ب",1,0],["ألا من يريني غايتي قبل مذهبي","ومن أين والغاياتُ بعد المذاهبِ",50,"ب",1,0],["ألا ماجدُ الأخلاقِ حُرٌّ فَعالُهُ","تُباري عطاياهُ عطايا السحائبِ",50,"ب",1,0],["ألامُ لما أُبْدي عليك من الأسى","وإني لأخفي منه أضعاف ما أُبْدي",51,"ي",1,0],["ألأمَ اللائمين نفْ","ساً وأمّاً ووالدا",52,"د",2,0],["ألا من لي بتعويذٍ","من العين على النحر",53,"ر",1,0],["ألا مات من مات الوفاء بموته","فأعوزَ من يوفي بذمة جاره",54,"ر",2,0],["ألا مات من مات السماح بموته","وكل عطاء نقدُهُ كضِماره",54,"ر",2,0],["ألا من لمن طردته الغيو","ث عن موقع السبَلِ الهامع",55,"ع",1,0],["ألا من لمن وكلته البحا","ر ظلماً إلى الوَشَلِ الدامع",55,"ع",1,0],["إلا مدائح ما تنفك سائرة","لركبها كل يوم نية فذف",56,"ف",1,0],["ألا ما لحاجاتٍ تَساعَى وحاجتي","مقيّدةٌ تمشي الهُوَيْنا على رِسلِ",57,"ل",1,0],["إلا مُباضعةَ العبيدِ فإنها","عنها وعن خَطراتها لم تذهلِ",58,"ل",1,0],["إلا منازعة تجُرُّ جنابةً","وتَشُبُّ في الأحشاءِ أيّ ضِرامِ",59,"م",1,0],["ألا من أراه صاحباً غيرَ خائنٍ","ألا من أراهُ مُؤنِساً غيرَ مُحْتَشَمْ",60,"م",1,0],["ألا من تليني منه في كُلِّ حالةٍ","أبرُّ يدٍ برَّتْ بذي شعثٍ يُلمْ",60,"م",1,0],["ألا من إليه أشتكي ما يَنُوبُني","فيُفْرجُ عنِّي كُلَّ غمٍّ وكُلَّ هَمْ",60,"م",1,0],["أَلا مَن مُبلِغٌ قَيساً رَسولاً","فَكَيفَ وَجَدتُمُ طَعمَ الشِقاقِ",61,"ق",1,0],["الأَمسُ كانَ لَها وَإِنَّ لَها غَدا","تَتَلَفَّتُ الدُنيا لَهُ إِعجابا",62,"ب",2,0],["إِلّا مُهَفهَفَةٌ بِها نَزَلَ الهَوى","ضَيفاً وَلَكِن لا يُريدُ رَحيلا",63,"ل",2,0],["الأَمرُ أَعظَمُ وَالأَفكارُ حائِرَةٌ","وَالشَرعُ يَصدُقُ وَالإِنسانُ يَمتَثِلُ",64,"ل",1,0],["الأُمُّ تَلْثُمُ طِفْلَها وتَضُمُّهُ","حرمٌ سَمَاويُّ الجمالِ مُقَدَّسُ",65,"س",1,1],["أُلامُ وَما لَومي عَلى الحُبِّ واجِبُ","وَقَد صادَني طَرفٌ كَحيلٌ وَحاجِبُ",66,"ب",1,1],["أَلا مِن لِقَلبٍ لا يَمُلُّ فَيَذهَلُ","أَفِق فَالتَعَزّي عَن بُثَينَةَ أَجمَلُ",67,"ل",1,1],["الام اذا شط امرؤ ذو روية","كأني على اهل الروية قيم",68,"م",1,0],["الامهات منابت","اولادهن لها زهور",69,"ر",1,0],["الام يقاسى العقل برد جموده","وحتام يبقى الرأي في الرأس محجورا",70,"ر",2,0],["ألا ملائكة بزىّ أوادم","ندعوهم لخشوعهم خدّامها",71,"م",3,0],["الأمر فيه لكاهن","والنهى مرجعه لساحر",72,"ر",1,0],["الأَمرُ آل أَحسَنَ المآلِ","بِيُمنِ إِبراهيمَ رَأسِ الآلِ",73,"ل",1,1],["الأَماني حُلمٌ في يَقظَةِ","وَالمَنايا يَقظَةٌ مِن حُلُمِ",74,"م",1,0],["الأَمرُ شورى لا يَعيثُ مُسَلَّطٌ","فيهِ وَلا يَطغى بِهِ جَبّارُ",75,"ر",1,0],["الأُمَّةُ اِئتَلَفَت وَرَصَّ بِناءَها","بانٍ زَعامَتُهُ هُدىً وَمَنارُ",75,"ر",1,0],["الأُمَّةُ اِنتَقَلَت إِلَيكِ كَأَنَّما","أَنزَلتِها مِن بَيتِها بِجَناحِ",76,"ح",1,0],["إِلامَ الخُلفُ بَينَكُمُ إِلاما","وَهَذي الضَجَّةُ الكُبرى عَلاما",77,"م",2,1],["إِلامَ رُكوبُكَ مَتنَ الرِمالِ","لِطَيِّ الأَصيلِ وَجَوبِ السَحَر",78,"ر",1,0],["الآمِراتُ عَلى الوُلا","ةِ الناهِياتُ عَلى الصُدور",79,"ر",1,0],["أَلا ما لِسَيفِ الدَولَةِ اليَومَ عاتِبا","فَداهُ الوَرى أَمضى السُيوفِ مَضارِبا",80,"ب",2,1],["إِلامَ طَماعِيَةُ العاذِلِ","وَلا رَأى في الحُبِّ لِلعاقِلِ",81,"ل",1,1],["الأمر في واحد لا غير معتدل","وما سواه فلغو غير ذي ثمرِ",82,"ر",1,0],["إلامَ التجنِّي والإساءةُ منكمُ","عتبتمْ وأعتَبْنَا وخُنْتُم وما خُنَّا",83,"ن",2,0],["ألا مَنْ لصَبٍّ بالعراق يشوقه","تخلُّجُ برقٍ بالعُذَيبِ يماني",84,"ي",1,0],["ألامُ ولي شُغْلٌ عن اللوم شاغِلٌ","وأهونُ ما يلقَى المحبُّ كلامُ",85,"م",1,0],["ألامُ على هِجرانهمْ وهمُ المُنَى","وكيف يُقيمُ الحرُّ وهو يُضَامُ",86,"م",1,0],["ألا من للغريب يَنالُ منه","جوىً ما بين أضلعِه دخيلُ",87,"ل",1,0],["أُلامُ إِذا ذَكَرتُكَ فَاِستَهَلَّت","غُروبُ العَينِ تَتبَعُها الغُروبُ",88,"ب",1,0],["الإِمامُ المُعتَزُّ بِاللَهِ أَولى","هاشِمِيٍّ بِالنَصرِ وَالتَأييدِ",89,"د",1,0],["أَلامَت سَجاياهُم وَضَنَّت أَكُفُّهُم","فَإِحسانُهُم سوءٌ وَمَعروفُهُم نُكرُ",90,"ر",1,0],["إِلامَ بابُكَ مَعقوداً عَلى أَمَلٍ","وَراءَهُ مِثلُ ماءِ المُزنِ مَحلولِ",91,"ل",1,1],["أُلامُ عَلى هَواكِ وَلَيسَ عَدلاً","إِذا أَحبَبتُ مِثلَكِ أَن أُلاما",92,"م",2,0],["أُلامُ عَلى هَوى الحَسناءِ ظُلماً","وَقَلبي في يَدِ الحَسناءِ عانِ",93,"ن",1,0],["أَلا مَن لِمُعتادٍ مِنَ الحُزنِ عائِدي","وَهَمٍّ أَتى دونَ الشَراسيفِ عامِدي",94,"د",2,1],["أَلا مَن مُبلِغٌ عَنّي زِياداً","بِأَنّي قَد لَجَأتُ إِلى سَعيدِ",95,"د",1,1],["أَلا مَن لِشَوقٍ أَنتَ بِاللَيلِ ذاكِرُه","وَإِنسانِ عَينٍ ما يُغَمِّضُ عائِرُه",96,"ر",2,1],["إِلامَ تَلَفَّتينَ وَأَنتِ تَحتي","وَخَيرُ الناسِ كُلَّهُمُ أَمامي",97,"م",2,0],["إلامَ يَرومُ الحَاسِدونَ نِضالي","وأَيمانُهُم في الرَّمْيِ دونَ شِمالي",98,"ي",1,1],["ألا مُتَجَرِّدٌ للهِ نَدْبٌ","يُقَرِّبُ منكُمُ الحَيْنَ الشَّنيعا",99,"ع",2,0],["إِلامَ تَجُرُّ أَذيالَ التَصابي","وَشَيبُكَ قَد نَعى بُردَ الشَبابِ",100,"ب",1,1],["أَلا ما لِلكُهولِ وَلِلتَصابي","إِذا ما اِغتَرَّ مُكتَهِلُ تَصابى",101,"ب",2,0],["أَلا مَن لِنَفسٍ في الهَوى قَد تَمادَتِ","إِذا قُلتُ قَد مالَت عَنِ الجَهلِ عادَتِ",102,"ت",1,1],["أَلا ما عَلاماتُ البِلى بِخَفِيَّةٍ","وَلَكِنَّما غَرَّ ابنَ آدَمَ جَهلُهُ",103,"ل",2,0],["أَلا مَن لِمَهمومِ الفُؤادِ حَزينِهِ","إِذا ابتَزَّ مِنهُ العَزمَ ضَعفُ يَقينِهِ",104,"ن",2,1],["أَلا مَن لي بِأُنسِكَ يا أُخَيّا","وَمَن لي أَن أَبُثَّكَ ما لَدَيّا",105,"ي",2,1],["أَلا ما لِسَيِّدَتي ما لَها","أَدَلّا فَأَحمِلَ إِذلالَها",106,"ل",3,1],["أَلا مَن لي بِأُنسِكَ يا أُخَيّا","وَمَن لي أَن أَبُشَّكَ ما لَدَيَّ",107,"ي",1,1],["الأمر كلُّ الأمر أن","يغدو يدافع دونها",108,"ه",2,0],["الأماني غرور","في فم البركان",109,"ن",1,0],["إِلامَ وَكَم يَقيكَ أَذايَ صَفحٌ","وَمَجدٌ عَنكَ في غَضَبي حَليمُ",110,"م",1,0],["أُلامُ عَلَى أَنِّي صَبَرْتُ وَهَلْ فَتَىً","عَلَى الصَّبْرِ إِنْ قَلَّ الْمُعِينُ يُلامُ",111,"م",1,0],["أَلا مَنْ مُعِينِي عَلَى صَاحِبٍ","جَرَعْتُ بِصُحْبَتِهِ الْعَلْقَمَا",112,"م",2,1],["الأمرُ للهِ الذي مهما يشا","يفعلُ فلمْ يكُ للتعرُّضِ موضعُ",113,"ع",1,0],["ألا مبلغاً قاضي القضا تحيةً","يُخصُّ بها فَهْوَ المحبُّ المحبَّبُ",114,"ب",1,0],["أُلامُ عَلى حُبِّ كَأَنّي سَنَنتُهُ","وَقَد سُنَّ هَذا الحُبُّ مِن قَبلِ جُرهُمِ",115,"م",1,0],["أَلا مَن يَرى رَأيَ اِمرِئٍ ذي قَرابَةٍ","أَبَت نَفسُهُ بِالبُغضِ إِلّا تَطَلُّعا",116,"ع",2,1],["أَلا ماءَ إِلّا فَوقَ نَصلٍ يُجَرَّدُ","وَلا ظِلَّ إِلّا تَحتَ رُمحٍ يُسَدَّدُ",117,"د",1,1],["أَلا مَضى عَصرُ الصِبا فَاِنقَضى","وَحَبَّذا عَصرُ شَبابٍ مَضى",118,"ض",2,1],["الإِمامُ المُستَقِلُّ بِهِ","رُكنُ بَيتِ الفَضلِ وَالكَرَمِ",119,"م",1,0],["أَلا مَن لِنَفسٍ حُبُّ لَيلى شِعارُها","مُشارِكُها بَعدَ العَصِيِّ اِئتِمارُها",120,"ر",3,1],["أُلامُ عَلى لَيلى وَلَو أَنَّ هامَتي","تُداوى بِلَيلى بَعدَ يُبسٍ لَبُلَّتِ",121,"ت",1,0],["الأمرُ فوضَى والحياةُ ذميمةٌ","والشَّرُّ لا يَفْنَى ولا هو يَنْفَدُ",122,"د",1,0],["الأمرُ جِدٌّ مابه من ريبةٍ","والبعثُ حقٌّ ليس فيه جدالُ",122,"ل",1,0],["الأمرُ جَدَّ فما لنا من عاذرٍ","إن نَحنُ نِمْنا والشُّعوبُ تطيرُ",123,"ر",1,0],["الأَمرُ غَيبٌ والذّرائعُ جَمّةٌ","والصَّبرُ نِعمَ العَونُ للمُتذرِّعِ",124,"ع",1,0],["الأُمّةُ ائتمرتْ بأمرِكَ فَاسْتَعِنْ","بِصُفوفِها والشّملَ حُوْلَكَ فَاجْمَعِ",124,"ع",1,0],["الأُمّهاتُ المجدُ حين ولدنهم","والسُّؤددُ الآباءُ والأجدادُ",125,"د",1,0],["الأمر إن ياسرتَ ليس بفادحٍ","والدّاءُ إن سامحتَ غيرُ عُضالِ",126,"ل",1,0],["الأَمرُ مُشتَرِكٌ وَمِصرُ لَنا مَعاً","في العالَمينَ مَنازِلٌ وَلُحودُ",127,"د",1,0],["إِلامَ تَجُنُّ الحادِثاتُ وَتَظلمُ","وَحَتّى مَتى تَبغي العِداةُ وَتظلُمُ",128,"م",1,1],["أَلا مُصلحٌ يَبني الحَياةَ لِقَومِهِ","أَلا مُنقِذٌ يَحمي البِلادَ وَيَعصمُ",128,"م",1,0],["الأمرُ غَيْبٌ ما لمثلِكَ مطمعٌ","في علمِهِ والغيبُ بابٌ مُبْهَم",129,"م",1,0],["الأمرُ بانَ فأين يلتمسُ الهدى","مَن ضلَّ بينَ حَلالِهِ وحرامِهِ",130,"م",2,0],["الأمرُ رَهنُ الجِدِّ ليس بنافعٍ","قَولُ الضّعيفِ لعلّه وَعَساهُ",131,"ا",2,0],["أَلا مَن مُبلِغٌ عَنّي بَشيراً","عَلانِيَةً وَنِعمَ أَخو العِلانِ",132,"ن",1,0],["أَلا مَن لِعَينٍ يَجِفُّ سُجومُها","تَأَوَّبُها حاجاتُها وَهُمومُها",133,"م",3,1],["أَلا مَن مُبلِغٌ فِتيانَ فَهمٍ","بِما لاقَيتُ عِندَ رَحى بِطانِ",134,"ن",1,1],["أَلا مَن لِعَينٍ لا تَزالُ تَسِيلُ","وَعَينُ المُحبِّ المُستَهامِ هَمُولُ",135,"ل",1,1],["إِلّا مَخافَةَ أَن أُصارِمَ صاحِباً","وَالصرمُ فاعلَم وَالمِرا أَسبابُهُ",136,"ب",2,0],["أَلا مَن لِقَلبٍ عارِمِ النَظَراتِ","يُقَطِّعُ طولَ اللَيلِ بِالزَفَراتِ",137,"ت",1,1],["أَلا مَن لِقَلبٍ في الهَوى غَيرَ مُنتَهِ","وَفي الغَيِّ مِطواعٍ وَفي الرَشدِ مُكرَهِ",138,"ه",1,1],["أَلا مُذكِرٌ بي عِندَ خَيرِ خَليفَةٍ","جَزيلِ العَطايا واسِعِ الفَضلِ وَالمَنِّ",139,"ن",1,0],["أَلا ما لِقَلبٍ لا تُقَضّى حَوائِجُه","وَوَجدٍ أَطارَ النَومَ بِاللَيلِ لاعِجُه",140,"ج",2,1],["أَلا مَن لِعَينٍ وَتَسكابِها","تَشَكّى القَذى وَبُكاها بِها",141,"ب",3,1],["الأمانَ الأمانَ إنَّ فُؤادِي","من ذُنوبٍ أَتَيْتُهُنَّ هَواءُ",142,"ا",2,0],["أَلا ما لِلمَشيبِ وَما لِرَأسي","حَمى عَنّي العُيونَ وَما حَماني",143,"ي",1,0],["ألا ما لاست زنبورٍ إذا ما","رأتني لا تمالك من عطاس",144,"س",1,1],["إِلّا مَقالَةَ زائِرٍ","نَثَرَت لِيَ الأَحزانَ نَثرا",145,"ر",2,0],["أَلا مَن لِصَبٍّ عازِبِ النَومِ ساهِدِ","وَمَن لِمُحِبٍّ مُثبَتٍ لِلعَوائِدِ",146,"د",1,1],["أَلا مَن لِمَطروبِ الفُؤادِ عَميدِ","وَمَن لِسَقيمٍ باتَ غَيرَ مَعودِ",147,"د",1,1],["أَلا ما لِقَلبي لا يَزولُ عَنِ الهَوى","وَقَد زَعَموا أَنَّ القُلوبَ تُقَلَّبُ",148,"ب",1,1],["إِلّا مَطايا المِرجَلِ الصَخّابِ","وَمَلعَبُ الأَحبابِ وَالأَحبابِ",149,"ب",1,0],["أَلا مَن مُبلِغٌ عَنّي خُزَيماً","وَزَبّانِ الَّذي لَم يَرعَ صِهري",150,"ر",2,1],["إِلّا مَقالَةَ أَقوامٍ شَقيتُ بِها","كانَت مَقالَتُهُم قَرعاً عَلى الكَبِدِ",151,"د",1,0],["الأَمرُ أَيسَرُ مِمّا أَنتَ مُضمِرُهُ","فَاِطرَح أَذاكَ وَيَسِّر كُلَّ ما صَعُبا",152,"ب",2,1],["إلامَ وفيمَ تَنْقُلُنا رِكابٌ","وتأمُلُ أن يكُونَ لنا أوَان",153,"ن",1,0],["الأم عاتبة عَلى أَولادها","إن لم تذد عَن أمها الأولاد",154,"د",1,0],["ألا ما أَقل الصحب في محنة الفَتى","على أنهم في يوم نعمته كثر",155,"ر",1,0],["الأمْنُ قد زالَ والأيام قد فسدت","وَالعُود بعد اِعتدال منه قد أودا",156,"د",2,0],["الأمُّ لو رقيت لرب","بت عَن هدى للشعب وُلْدا",157,"د",2,0],["الأمرُ ما شئت فذنب الهوى","على الذي يكفر يوماً به",158,"ه",1,0],["إِلّا مَواعِظَ قادَها لَكَ سَمحَةً","إِسجاجُ لُبِّكَ سامِعاً أَو قائِلا",159,"ل",2,0],["إلامَ تطوين عُباب السنينْ","شوقاً إلى فردوسكِ الضائعِ",160,"ع",1,0],["ألا ما لهذا البحر غضبانَ مثلما","تنفَّسُ فيه الريحُ عن صدرِ ثائرِ",161,"ر",1,0],["ألا ما لأختيكِ ما تبغيان","أقلبيَ والخنجرَ المُنتَضَى",162,"ض",2,0],["ألا ما لهذا الليلِ تَدجى جوانبُهُ","على شَفَقٍ دامٍ تلظَّى ذوائبُهْ",163,"ب",2,1],["إلام الحرص والرغب","ة في أشيب كالأشمط",164,"ط",1,1],["إلامَ تُكَلِّفُ البِيدَ المَطايا","بِعَزْمٍ لا يَقَر له قَرارُ",165,"ر",1,0],["إلا مقاما قمتما لن يقبلا","تصرّف الدهر ولا حكم البلى",166,"ل",2,0],["الأماني حلم في يقظة","والمنايا يقظة في حلم",167,"م",1,0],["أَلا مَسَخَ اللَّهُ القِطار حِجارةً","تصوبُ عَلَينا وَالغمامَ غموما",168,"م",2,1],["أَلا ما لِلَيلى لا تُرى عِندَ مَضجَعي","بِلَيلٍ وَلا يَجري بِذَلِكَ طائِرُ",169,"ر",1,1],["أَلاَ مضن مُبلغُ النُّعمانَ عَنِّي","وقد تُهدَى النَّصيحَةُ بالَمغيبِ",170,"ب",1,0],["ألا مَن مُبلِغُ النُّعمانَ عَنِّي","فَبَينَا الَمرءُ أَغَربَ إذ أَراحا",171,"ح",2,1],["إِلامَ يَهْفُو بِحِلْمِكَ الطَّرَبُ","أَبَعْدَ خَمْسِينَ في الصِّبَا أَرَبُ",172,"ب",1,1],["الأُمُّ شَمْسٌ وَالثَّرَيَّا لَكُمْ","أُخْتٌ وَمَا مِنْكُمْ سِوى بَدْرِ",173,"ر",1,0],["أَلأَمْنُ قَتَّالُ الشَّجَاعَةِ فِيهِمُ","وَحَيَاتُهَا فِيهِمْ مَخَاوِفُ تُرْقَبُ",174,"ب",1,0],["ألاَ مَنْ مُبَلغٌ عنّي لؤيّاً","فَبَعْدَ اليومِ دَائِلَةٌ تَدُولُ",175,"ل",1,0],["إلا مشقّات الطريق إلى الثّرى","بينَ الأسى وتَفَتّتِ الأكباد",176,"د",1,0],["أَلا مَن لِنَفسٍ وَأَحزانِها","وَدارٍ تَداعَت بِحيطانِها",177,"ن",3,1],["الأَمْسُ يَجْزَع أنْ تَقَدَّمَ خُطْوَةً","وغَدٌ أَطَارَ صَوابَه اسْتِئْخار",178,"ر",1,0],["ألا، ما لسيف الهند فلَّ غِراره؟","وما لجواد السبق أصبح كابيا؟",179,"ي",2,0],["ألا ما لشعرك في البحر تاهَ","وشعرُك أعمقُ من مائه؟",180,"ا",3,0],["ألا ما أقلَّ الثمارَ إذا ما","تعالى الضجيج وزاد الصخب!",181,"ب",1,0],["الأمرُ ما شاءَ أو شاءتْ بطانَتُهُ","وليس للشَّعبِ غيرُ الهَمِّ والكَمَدِ",182,"د",1,0],["ألا، ما هذا الروض صوَّحَ زاهرهُ","وذابت أغانيه وأجفَلَ طائره؟",183,"ر",2,1],["ألا، ما لهذا البحر غِيضَ عبابهُ","وعُطِّلُ مُرساه وأُسكت هادره؟",183,"ر",2,0],["ألا، ما لهذا الطودِ خرَّ أساسُهُ؟","ألا، ما لهذا الغيثِ أخلف ماطره؟",183,"ر",2,0],["الأمهاتُ بريف مص","رَ يهمن في وادي الضلال",184,"ل",1,0],["الأمنُ: شاكٍ، جريحٌ، سائلٌ دُمه","ومجلس الأمن: لا سمعٌ، ولا بصر",185,"ر",1,0],["ألا مَن يَبلغُ الوكلاءَ عني:","أزيلوا اسم الخفيف من الكُشُوف؟",186,"ف",1,0],["ألا، من يشتري أبياتَ شعري","بكوخ شِيدَ من طينِ وماء؟",187,"ا",2,0],["الأمر في يد نَاصرٍ","لا «لمْبسونَ»، ولا «لُوِيد»",188,"د",1,0],["إلا ما آسَنَ الشعرَ","إذا لم يَكُ من بحر!",189,"ر",1,0],["إلاَم سُكُوتك عن عصبة","تَولىَّ الشياطينُ إيجَادها؟",190,"د",3,0],["إلا مواقد كالحمام جواتما","وترى بأظلاف الظباء كديدا",191,"د",2,0],["ألا مُبلغٌ عني \" المعرِّيَ \" أحمداً","ليسمَعَه والشعر كالريح جوّال",192,"ل",1,0],["آلامُه صدعُ الشقاق بأهله","وبلاؤهُ الأوهامُ والتضليل",193,"ل",1,0],["ألا مِن كريمٍ يَسُرُّ الكرامَ","بجيفةِ جلْفٍ زَنيمٍ عَتا",194,"ا",1,0],["أَلاَ مَا لِعَيني بالدُّمُوعِ استهلَّتِ","ولو فَقَدَتْ ماءَ الشُّؤُون لَقَرَّتِ",195,"ت",1,1],["إلا مهفهفة بها نزل الهوى","ضعيفا ولكن لا يريد رحيلا",196,"ل",2,0],["إلا مدائح ما تنفكُّ سائرة ً","لركْبها كل يوم نيَّة قذفُ",197,"ف",1,0],["أُلامُ إذا حنّت قلوصي من الهوى","ولا ذنب لي في أن تحنّ الأباعر",198,"ر",1,0],["أَلاَ مَنْ لِعَيْنٍ لاَ يَجِفُّ سُجُومُها","تَأَوَّبُهَا حَاجَاتُها وهُمُومُها",199,"م",3,1],["ألامس الجرحَ ما الذي صنعتْ","به شفاهٌ رحيمةٌ ويدُ",200,"د",1,0],["ألا من يرى رأيَ امرىء ٍ ذي قرابة ٍ،","أَبَتْ نَفْسُهُ بِکلْبُغْضِ إلاَّ تَطَلُّعا",201,"ع",2,1],["أُلامُ عَلَى حُبِّي، كَأَنِّي سَنَنْتُهُ،","وَقَدْ سُنَّ هذا الحُبُّ مِنْ قَبْلِ جُرْهُم",202,"م",1,0],["أَلا مَن مُبلِغُ النُعمان عَنّي","وَقَد تُهوى النَصيحَةُ بِالمَغيبِ",203,"ب",1,0]]}