{"poems":[[23,"ما هاج حسان رسوم المقام","https://www.aldiwan.net/poem21255.html","السريع"],[53,"نعال كنباية والعنبر","https://www.aldiwan.net/poem62886.html","الطويل"],[21,"نهرا جاريا وبيتا عليا","https://www.aldiwan.net/poem36186.html","الطويل"],[102,"الخضر المغمور","https://www.poetsgate.com/ViewPoem.aspx?id=50346",""],[136,"دمن الأحبة لو عصيت العاذلا","https://www.aldiwan.net/poem54777.html","الكامل"],[234,"سألته قبله فجادا","https://www.aldiwan.net/poem51138.html","مخلع البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46517","الرجز"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124721","الوافر"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96026","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93554","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74055","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69918","البسيط"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35452","الوافر"],[5002,"كورونا....","https://www.poetsgate.com/ViewPoem.aspx?id=210891",""],[5064,"أهازيجُ الغُبار","https://www.poetsgate.com/ViewPoem.aspx?id=199174",""],[5431,"إني هززتُ فهل عسايَ سأولدُ","https://www.poetsgate.com/ViewPoem.aspx?id=193134",""],[5431,"وقفة عزّة....","https://www.poetsgate.com/ViewPoem.aspx?id=206595",""],[5691,"أنَا والدجى","https://www.poetsgate.com/ViewPoem.aspx?id=206743",""],[5770,"يبكي ويضحك","https://www.poetsgate.com/ViewPoem.aspx?id=178252",""],[6115,"بيض الله وجه بعض الشدايد والضروف","https://www.poetsgate.com/ViewPoem.aspx?id=180470",""],[5014,"مفقودة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76222&r=&rc=18",""],[5064,"شروحُ الفتوح على أسانيد بلقيس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87507&r=&rc=2",""]],"verses":[["لا نَخذُلُ الجارَ وَلا نُسلِمُ ال","مَولى وَلا نُخصَمُ يَومَ الخِصام",0,"م",1,0],["لا نَخلُ من جملة ألطافكم","لا يخلُ من شكركُم مَحضر",1,"ر",1,0],["لا نَخافُ المُحولَ إِن هَرَشَ","الدَهرُ وَلا نَنتَوي لِأَهلٍ سِواكا",2,"ك",2,0],["لأنّ خطاه ، تنبت الورد في الصفا","وفي الرمل أضحى ، يعشق الحسن أحمرا",3,"ر",2,0],["لأنّ خطاه برعمت شهوة الحصى","لأنّ هواه ، في دم البذر أقمرا",3,"ر",2,0],["لا نَختَشِي تَشحَاجَ أبقَعَ بالنَّوَى","والوَصلُ عَذبٌ لا صُدُودَ ولاَ قِلَى",4,"ل",2,0],["لأنّ خَدِّي من مُدَام","يكتُب فيها الِلئام صادا",5,"د",2,0],["لان خَلفي مِن جيوش الجن","ما يَدفع الأَعداء جَمعاً عَني",6,"ي",1,0],["لأن خطابة الخطباء قامت","بشطرٍ والصلاة تكون شطرا",7,"ر",2,0],["لا نخليك أن نخلي الأعادي","تتخلى رؤسها عن طلاها",8,"ا",3,0],["لا نَخاف السُيوف إِلا إِذا ما","مِن سُيوف الظِبا تسل الظُباة",9,"ه",1,0],["لا نَخاف الزَمان نمّ علينا","أَو وَشى عنده بِنا الواشونا",10,"ن",2,0],["لِأَنخيسَ قَد كانَ صِهراً صَفِيّا","عَلى بِنتِهِ البِكرِ هيفوذَمِيّا",11,"ي",2,0],["لا نختشي مِن صُروفِ الدَهر لَو طرقت","وَلا تَغيرُ مبنانا زَوابعهُ",12,"ع",2,0],["لِأَنّ خِطابَها سُؤلى وَمَن لي","وَلَو بِتَوَعُّد إِيّايَ تَعني",13,"ن",2,0],["لا نَخَافُ المَوْتَ والإيمانُ لَا","زَالَ.. فِي الوِجْدَانِ للِه انْصَرَفْ",14,"ف",1,0],["لأنَّ خُطَاهُ مِنْ سرَابٍ تورَّمَتْ","بأسفَارهِ الآمَالُ فِي كُلِّ صبوَةِ",15,"ه",1,0],["لانخلةٌ بقيتْ هناك تضمنا","لانبعةٌ في حقلها نتمددُ",16,"د",1,0],["لانخلَ بعد اليوم تفرد فيأها","إني بنخلك سيدي أتوحدُ",16,"د",1,0],["لانخلةَ الأخلاق أعطت تمرها","لا غيمةٌ منها الشرائع ممطرة",17,"ر",2,0],["لا نُخْطئُ الإنسانَ مذ ْبدأتْ","فوقَ البسيطةِ هذه البَشَرُ",18,"ر",1,0],["لا نخل بغداد يحنو فوق هامته","أو شط دجلة حيا قاربا جنحا",19,"ح",2,0],["لا نخيته سكّر اذنه وكنّه مايشوف","وأن بغاك بحاجته جاك يرمي مشلحه",20,"ح",2,0],["لأن خزانتي صفرٌ","تساوى السلب والمنحُ",21,"ح",1,0],["لأنَّ خيولَ العُمْرِ يحلُو صهِيلُها","فكُلٌّ لمَا \"وارَى الحِجَابُ\" جَمُوحُ",22,"ح",1,0]]}