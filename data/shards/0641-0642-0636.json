{"poems":[[55,"بلغي يا ريح عنا","https://www.aldiwan.net/poem26130.html","مجزوء الرمل"],[86,"فتية الصهباء خير الشاربين","https://www.aldiwan.net/poem10937.html","الرمل"],[71,"ورب أخ حميم بت ليلي","https://www.aldiwan.net/poem3811.html","الوافر"],[73,"هو الدهر فاصبر للذي أحدث الدهر","https://www.aldiwan.net/poem11936.html","الطويل"],[93,"فجع القريض وقد ثوى حسان","https://www.aldiwan.net/poem11217.html","البسيط"],[93,"كيف قوضت يا علم","https://www.aldiwan.net/poem11343.html","مجزوء الخفيف"],[88,"أدهق الدهر بالمنية كاسه","https://www.aldiwan.net/poem45051.html","الخفيف"],[72,"من لي بها حسناء معرب حسنها","https://www.aldiwan.net/poem19981.html","الكامل"],[51,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[70,"مقيم على العهد من صبوتي","https://www.aldiwan.net/poem42995.html","المتقارب"],[92,"غنني أنشودة الفجر الضحوك","https://www.aldiwan.net/poem38961.html","الرمل"],[92,"أيها الحب أنت سر بلائي","https://www.aldiwan.net/poem38975.html","الخفيف"],[78,"وليل ظللنا فيه نعمل كأسنا","https://www.aldiwan.net/poem14277.html","الطويل"],[89,"لهفي على الحر الموس","https://www.aldiwan.net/poem44925.html","مجزوء الكامل"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[45,"دع دموعي في ذلك الاشتياق","https://www.aldiwan.net/poem65177.html","الخفيف"],[2,"أمن أم أوفى دمنة لم تكلم","https://www.aldiwan.net/poem25065.html","الطويل"],[66,"أنف الخمار من فرط خباها","https://www.aldiwan.net/poem39074.html","الرمل"],[66,"لعل ليالي الربوتين تعود","https://www.aldiwan.net/poem41357.html","الطويل"],[44,"إصبري أيتها النف","https://www.aldiwan.net/poem29699.html","مجزوء الرمل"],[31,"أقل الملام يا عتيق فإنني","https://www.aldiwan.net/poem41820.html","الطويل"],[74,"أفي ما تؤدي الريح عرف سلام","https://www.aldiwan.net/poem13260.html","الطويل"],[105,"الكتب تترى والكتائب تدلف","https://www.aldiwan.net/poem43999.html","الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"يا رب خرق نازح حديب","https://www.aldiwan.net/poem62452.html","الرجز"],[48,"يا من رآني في الكرى زعما","https://www.aldiwan.net/poem66263.html","أحذ الكامل"],[50,"حييا صاحبي أم العلاء","https://www.aldiwan.net/poem64891.html","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39667","الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30464","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20997","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55113","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54942","الكامل"],[18,"أثبت مرة والسيوف شواهر","https://www.poetsgate.com/ViewPoem.aspx?id=27779",""],[31,"أقلَّ الملامَ، يا عتيقُ، فإنني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19049&r=&rc=312",""]],"verses":[["فَقَضى اللَهُ عَلَينا","أَن شَحَطنا وَأَقاما",0,"م",2,0],["فَقَضَيناهُ وَلَم نَحفِل بِما","سَطَّرَت أَيدي الكِرامِ الكاتِبين",1,"ن",1,0],["فَقَضَّيتُ الشِتاءَ كَما تَقَضّى","شِتا البُرغوثِ في ذَقنِ اِبنِ سيما",2,"م",2,0],["فَقَضَيتِ مِن فَرضِ الصَلاةِ لُبانَةً","مُشَيِّعُها نُسكٌ وَفارِطُها طُهرُ",3,"ر",1,0],["فَقَضَى قَرِيضَةَ حَجِّهِ يَحْتَثُّهُ","شَوْقٌ وَيَحْدُو رَكْبَهُ الإِيمَانُ",4,"ن",1,0],["فَقَضَى وَهْوَ فِي الْجِهَا","دِ وَمَطْلُوبُهُ أَمَمْ",5,"م",1,0],["فقضى بعد نأيه عن إناس","طلبوا علمه وراموا اقتباسه",6,"س",2,0],["فقضيت فرضاً كالصلاة مسلماً","ودخلت جنات الهنا بسلام",7,"م",1,0],["فقضاكَ ريْعُ العدلِ ما أعطيتهم","أوفى قضاءٍ واصطنعْتَ جميلا",8,"ل",2,0],["فقضى حاجتي وكان كسَيْفٍ","هُزَّ فاهتَزَّ وهْوَ غيْرُ كَهام",9,"م",1,0],["فقضوْا من مقالهم ما قضوْه","ثم آبوا بالرِّفدِ والحُمْلانِ",10,"ن",1,0],["فَقَضَّيتُها في الهَوى لَيلَةً","إِخالُ الخَليفَةَ في خِدمَتي",11,"ت",2,0],["فَقَضَتْ صمْتاً أَناشيدُ الغَرامْ","بَيْنَ أَزْهارِ الخَريفِ الذَّاوِيَهْ",12,"ه",1,0],["فَقَضَى وقدْ غَاضَتْ","أَغاريدُ الحَياةِ الطَّاهِرَهْ",13,"ه",1,0],["فَقَضَّيتُ مِن هَذا وَذاكَ لُبانَةً","وَثَمَّ لَنا فَتحٌ مُبينٌ وَآمالُ",14,"ل",1,0],["فقضي برجحان اليراع","على البنادق والسيوف",15,"ف",1,0],["فَقَضى اللَهُ أَن تُضَيِّعَ هَذا ال","مُلكَ أُنثى صَعبٌ عَلَيها الوَفاءُ",16,"ا",2,0],["فَقَضى ما قَضى وَعادَ إِلَيها","وَالدُجى في ثِيابِهِ الأَخلاقِ",17,"ق",1,0],["فَقَضَّوا مَنايا بَينَهُم ثُمَّ أَصدَروا","إِلى كَلَأٍ مُستَوبِلٍ مُتَوَخَّمِ",18,"م",1,0],["فَقَضَينا لَذَّةَ النَفسِ بِها","في صَفا عَيشٍ بِهِ الدَهرُ حَباها",19,"ا",3,0],["فَقَضَّيتُ عَيشاً لَو قَضَيناهُ يَقظَةً","لَقامَت عَلينا لِلإِلَهِ حُدودُ",20,"د",1,0],["فَقَضَينا مَنسِكَ اللَ","هِ وَإِن لَم نَنوِ حَجّا",21,"ج",2,0],["فَقَضَّ مَلامي وَاِطلُبِ الطِبَّ إِنَّني","أُسِرُّ جَوىً مِن حُبِّها فَهوَ رازِمُ",22,"م",1,0],["فَقَضَّيتُها ما بَينَ رَشفَةِ لَوعَةٍ","وَأَنَّةِ شَكوى وَاِعتِناقِ غَرامِ",23,"م",1,0],["فَقَضى إليهِ الأمرَ يأخذُهم بهِ","ويُقيمُه بالحقِّ لا يَتحرَّفُ",24,"ف",1,0],["فَقَضَيْنَا بها مَناسِكَ لا يُح","مَدُ إلّا في فِعْلِهِنَّ القضاءُ",25,"ا",2,0],["فَقَضقَضَ العَجبَ إِلى الظُنبوبِ","وَانتَهَسَ الأَرفاغَ بِالنُيوبِ",26,"ب",1,0],["فقضيتُ منه في الكرى وطري","فصرتُ لم أبلغ مدى وطره",27,"ر",2,0],["فَقَضى اللَهُ أَن يَموتَ كَما ما","تَ بَنونا وَسالِفُ الآباءِ",28,"ا",2,0],["فقضيتَ ليلكَ لا هدوءَ ولا كرىً","ووثبتَ في غسَقِ الظلام الجانِحِ",29,"ح",1,0],["فَقَضَيتُ ما لم أَقْضِ فيه بِرِيبَةٍ","يَأْبَى العَفافُ وعِصْمتي بحُضُورِه",30,"ر",2,0],["فَقَضَينا حاجَةً مِن لَذَّةٍ","وحَيَاةُ الُمرءِ كالشَّيءِ الُمعارِ",31,"ر",1,0],["فَقَضَيْتَ حَقَّ الصاحِيَبْنِ","بِمَا بِهِ الإِلْهَامُ جَادَكْ",32,"ك",1,0],["فَقَضَى مَأْربَهُ ثُمَّ انْثنَى","بِرِضَى مَنْ فعَلَ الفِعْلَة بِكْرَا",33,"ر",2,0],["فقضَى حِينَ اقْتَضَى مُنتَحِراً","بِيَديْ مسْتأْجَرٍ أَوسِعَ بِرَّا",33,"ر",2,0],["فَقَضَيْتُ حيناً فِي العَذَابِ وَلمْ","تَدْرِي عَلاَمَ وَمِت لَمْ تَدْرِي",34,"ر",2,0],["فقضين دينا كن قد ضمنه","بعزائم غلب الرقاب سوام",35,"م",1,0],["فَقَضِّ ملامي، وکطْلُبِ الطِّبَّ، إنَّني","أسرّ جوى في حبها، فهو رازمُ",36,"م",1,0]]}