{"poems":[[57,"بلغي يا ريح عنا","https://www.aldiwan.net/poem26130.html","مجزوء الرمل"],[88,"فتية الصهباء خير الشاربين","https://www.aldiwan.net/poem10937.html","الرمل"],[73,"ورب أخ حميم بت ليلي","https://www.aldiwan.net/poem3811.html","الوافر"],[75,"هو الدهر فاصبر للذي أحدث الدهر","https://www.aldiwan.net/poem11936.html","الطويل"],[95,"فجع القريض وقد ثوى حسان","https://www.aldiwan.net/poem11217.html","البسيط"],[95,"كيف قوضت يا علم","https://www.aldiwan.net/poem11343.html","مجزوء الخفيف"],[90,"أدهق الدهر بالمنية كاسه","https://www.aldiwan.net/poem45051.html","الخفيف"],[74,"من لي بها حسناء معرب حسنها","https://www.aldiwan.net/poem19981.html","الكامل"],[53,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[53,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[72,"مقيم على العهد من صبوتي","https://www.aldiwan.net/poem42995.html","المتقارب"],[94,"غنني أنشودة الفجر الضحوك","https://www.aldiwan.net/poem38961.html","الرمل"],[94,"أيها الحب أنت سر بلائي","https://www.aldiwan.net/poem38975.html","الخفيف"],[80,"وليل ظللنا فيه نعمل كأسنا","https://www.aldiwan.net/poem14277.html","الطويل"],[91,"لهفي على الحر الموس","https://www.aldiwan.net/poem44925.html","مجزوء الكامل"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[47,"دع دموعي في ذلك الاشتياق","https://www.aldiwan.net/poem65177.html","الخفيف"],[2,"أمن أم أوفى دمنة لم تكلم","https://www.aldiwan.net/poem25065.html","الطويل"],[68,"أنف الخمار من فرط خباها","https://www.aldiwan.net/poem39074.html","الرمل"],[68,"لعل ليالي الربوتين تعود","https://www.aldiwan.net/poem41357.html","الطويل"],[18,"أثبت مرة والسيوف شواهر","https://www.aldiwan.net/poem23929.html","الكامل"],[46,"إصبري أيتها النف","https://www.aldiwan.net/poem29699.html","مجزوء الرمل"],[33,"أقل الملام يا عتيق فإنني","https://www.aldiwan.net/poem41820.html","الطويل"],[76,"أفي ما تؤدي الريح عرف سلام","https://www.aldiwan.net/poem13260.html","الطويل"],[107,"الكتب تترى والكتائب تدلف","https://www.aldiwan.net/poem43999.html","الكامل"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[50,"يا رب خرق نازح حديب","https://www.aldiwan.net/poem62452.html","الرجز"],[50,"يا من رآني في الكرى زعما","https://www.aldiwan.net/poem66263.html","أحذ الكامل"],[52,"حييا صاحبي أم العلاء","https://www.aldiwan.net/poem64891.html","الخفيف"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62217","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39667","الكامل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30464","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20997","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55113","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54942","الكامل"],[33,"أقلَّ الملامَ، يا عتيقُ، فإنني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19049&r=&rc=312",""],[118,"قتل الاعداء يا هند الحسد","https://www.aldiwan.net/poem41154.html","عموديه"],[127,"هات اسقنيها يا غلام","https://www.aldiwan.net/poem23753.html","مجزوء الكامل"],[131,"يا نفس أنت محادده","https://www.aldiwan.net/poem50643.html","مجزوء الكامل"],[146,"إباؤك للمجد أن يبتذل","https://www.aldiwan.net/poem11800.html","المتقارب"],[146,"يا للرجال لنظرة سفكت دما","https://www.aldiwan.net/poem11808.html","الكامل"],[163,"كذا فليعاني الملك من أعطي الملكا","https://www.aldiwan.net/poem58826.html","الطويل"],[163,"هكذا فلتكن إلى الغلمان","https://www.aldiwan.net/poem58854.html","الخفيف"],[163,"يا من لدمع مارقي وصبيبه","https://www.aldiwan.net/poem58943.html","الكامل"],[188,"هجر العذول وراح طوع غواته","https://www.aldiwan.net/poem14131.html","الكامل"],[192,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[198,"عما يا ابنتي قيس صباحا ومظلما","https://www.aldiwan.net/poem54406.html","الطويل"],[198,"أرواح أم بكرة فاغتداء","https://www.aldiwan.net/poem54413.html","الخفيف"],[200,"نوحي بعقر السجن نوحي","https://www.aldiwan.net/poem39896.html","مجزوء الكامل"],[224,"يا خليلا أجل كل خليل","https://www.aldiwan.net/poem55251.html","الخفيف"],[232,"أيها الفاضل الذي فضل العالم","https://www.aldiwan.net/poem50800.html","الخفيف"],[234,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[238,"وبخيلة سمح الرقا","https://www.aldiwan.net/poem32174.html","مجزوء الكامل"],[274,"سقاك خيام الغور صوب الحيا عهدا","https://www.aldiwan.net/poem52068.html","الطويل"],[282,"أحكمت عرسه ضروب الأغاني","https://www.aldiwan.net/poem2634.html","الخفيف"],[285,"عجبا لمملوكي الذي ملكته","https://www.aldiwan.net/poem32858.html","الكامل"],[293,"يا ليالينا بوادي السلط قد","https://www.aldiwan.net/poem11711.html","الرمل"],[308,"أعيذ صفاء الود من كدر العتب","https://www.aldiwan.net/poem56604.html","الطويل"],[323,"طاب حظ بدا بعود الدريني","https://www.aldiwan.net/poem67173.html","الخفيف"],[352,"شاغل القلب هوى عذب اللمي","https://www.aldiwan.net/poem16030.html","الرمل"],[369,"أوثق ما كان بأيامه","https://www.aldiwan.net/poem17359.html","السريع"],[374,"كل من يستكفني يغريني","https://www.aldiwan.net/poem57066.html","الخفيف"],[380,"طوبى لمن قد تاب بعد خطائهِ","https://www.aldiwan.net/poem66970.html","الكامل"],[383,"طرف جفاه هجوعه","https://www.aldiwan.net/poem48798.html","مجزوء الكامل"],[406,"كم ذا التلعب يا غزال الأجرع","https://www.aldiwan.net/poem33672.html","الكامل"],[409,"نفسي الفِداء لِلحظِها من رامِ","https://www.aldiwan.net/poem50116.html","الكامل"],[419,"أعد اللهو فإن اللهو أحمد","https://www.aldiwan.net/poem54100.html","الرمل"],[419,"قلب يذوب عليك وجدا","https://www.aldiwan.net/poem54142.html","مجزوء الكامل"],[442,"لك الخير قد أوفى بعهدك خيران","https://www.aldiwan.net/poem34887.html","الطويل"],[444,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[446,"بعد خلق الأكوان خلقا بديعا","https://www.aldiwan.net/poem56043.html","الخفيف"],[460,"بكر العارض تحدوه النعامى","https://www.aldiwan.net/poem55884.html","الرمل"],[466,"صبر قلبي عان ودمعي طليق","https://www.aldiwan.net/poem3398.html","عموديه"],[470,"أيا من ما له في الجود ثان","https://www.aldiwan.net/poem59611.html","الوافر"],[470,"وصديق سروره بالصديق","https://www.aldiwan.net/poem59814.html","الخفيف"],[517,"خلعت عليك مواسم الأيام","https://www.aldiwan.net/poem12251.html","الكامل"],[553,"دع الجزع عن يمناك لا عن شمالكا","https://www.aldiwan.net/poem47348.html","الطويل"],[569,"عجبي ممن تعالت حاله","https://www.aldiwan.net/poem69813.html","الرمل"],[792,"","https://poetry.dctabudhabi.ae/diwan/poem/29555","الكامل"]],"verses":[["فَقَضى اللَهُ عَلَينا","أَن شَحَطنا وَأَقاما",0,"م",2,0],["فَقَضَيناهُ وَلَم نَحفِل بِما","سَطَّرَت أَيدي الكِرامِ الكاتِبين",1,"ن",1,0],["فَقَضَّيتُ الشِتاءَ كَما تَقَضّى","شِتا البُرغوثِ في ذَقنِ اِبنِ سيما",2,"م",2,0],["فَقَضَيتِ مِن فَرضِ الصَلاةِ لُبانَةً","مُشَيِّعُها نُسكٌ وَفارِطُها طُهرُ",3,"ر",1,0],["فَقَضَى قَرِيضَةَ حَجِّهِ يَحْتَثُّهُ","شَوْقٌ وَيَحْدُو رَكْبَهُ الإِيمَانُ",4,"ن",1,0],["فَقَضَى وَهْوَ فِي الْجِهَا","دِ وَمَطْلُوبُهُ أَمَمْ",5,"م",1,0],["فقضى بعد نأيه عن إناس","طلبوا علمه وراموا اقتباسه",6,"س",2,0],["فقضيت فرضاً كالصلاة مسلماً","ودخلت جنات الهنا بسلام",7,"م",1,0],["فقضاكَ ريْعُ العدلِ ما أعطيتهم","أوفى قضاءٍ واصطنعْتَ جميلا",8,"ل",2,0],["فقضى حاجتي وكان كسَيْفٍ","هُزَّ فاهتَزَّ وهْوَ غيْرُ كَهام",9,"م",1,0],["فقضوْا من مقالهم ما قضوْه","ثم آبوا بالرِّفدِ والحُمْلانِ",10,"ن",1,0],["فَقَضَّيتُها في الهَوى لَيلَةً","إِخالُ الخَليفَةَ في خِدمَتي",11,"ت",2,0],["فَقَضَتْ صمْتاً أَناشيدُ الغَرامْ","بَيْنَ أَزْهارِ الخَريفِ الذَّاوِيَهْ",12,"ه",1,0],["فَقَضَى وقدْ غَاضَتْ","أَغاريدُ الحَياةِ الطَّاهِرَهْ",13,"ه",1,0],["فَقَضَّيتُ مِن هَذا وَذاكَ لُبانَةً","وَثَمَّ لَنا فَتحٌ مُبينٌ وَآمالُ",14,"ل",1,0],["فقضي برجحان اليراع","على البنادق والسيوف",15,"ف",1,0],["فَقَضى اللَهُ أَن تُضَيِّعَ هَذا ال","مُلكَ أُنثى صَعبٌ عَلَيها الوَفاءُ",16,"ا",2,0],["فَقَضى ما قَضى وَعادَ إِلَيها","وَالدُجى في ثِيابِهِ الأَخلاقِ",17,"ق",1,0],["فَقَضَّوا مَنايا بَينَهُم ثُمَّ أَصدَروا","إِلى كَلَأٍ مُستَوبِلٍ مُتَوَخَّمِ",18,"م",1,0],["فَقَضَينا لَذَّةَ النَفسِ بِها","في صَفا عَيشٍ بِهِ الدَهرُ حَباها",19,"ا",3,0],["فَقَضَّيتُ عَيشاً لَو قَضَيناهُ يَقظَةً","لَقامَت عَلينا لِلإِلَهِ حُدودُ",20,"د",1,0],["فَقَضَينَ دَيناً كُنَّ قَد ضُمِّنَّهُ","بِعَزائِمٍ غُلبِ الرِقابِ سَوامِ",21,"م",1,0],["فَقَضَينا مَنسِكَ اللَ","هِ وَإِن لَم نَنوِ حَجّا",22,"ج",2,0],["فَقَضَّ مَلامي وَاِطلُبِ الطِبَّ إِنَّني","أُسِرُّ جَوىً مِن حُبِّها فَهوَ رازِمُ",23,"م",1,0],["فَقَضَّيتُها ما بَينَ رَشفَةِ لَوعَةٍ","وَأَنَّةِ شَكوى وَاِعتِناقِ غَرامِ",24,"م",1,0],["فَقَضى إليهِ الأمرَ يأخذُهم بهِ","ويُقيمُه بالحقِّ لا يَتحرَّفُ",25,"ف",1,0],["فَقَضَيْنَا بها مَناسِكَ لا يُح","مَدُ إلّا في فِعْلِهِنَّ القضاءُ",26,"ا",2,0],["فَقَضقَضَ العَجبَ إِلى الظُنبوبِ","وَانتَهَسَ الأَرفاغَ بِالنُيوبِ",27,"ب",1,0],["فقضيتُ منه في الكرى وطري","فصرتُ لم أبلغ مدى وطره",28,"ر",2,0],["فَقَضى اللَهُ أَن يَموتَ كَما ما","تَ بَنونا وَسالِفُ الآباءِ",29,"ا",2,0],["فَقَضَيْنَ مَا قَضَّيْنَ ثُمَّ تَرَكْنَهُمْ","عُزُبَ المَبَاءَةِ غُيَّبَ الأَنْفَارِ",30,"ر",1,0],["فقضيتَ ليلكَ لا هدوءَ ولا كرىً","ووثبتَ في غسَقِ الظلام الجانِحِ",31,"ح",1,0],["فَقَضَيتُ ما لم أَقْضِ فيه بِرِيبَةٍ","يَأْبَى العَفافُ وعِصْمتي بحُضُورِه",32,"ر",2,0],["فَقَضَينا حاجَةً مِن لَذَّةٍ","وحَيَاةُ الُمرءِ كالشَّيءِ الُمعارِ",33,"ر",1,0],["فَقَضَيْتَ حَقَّ الصاحِيَبْنِ","بِمَا بِهِ الإِلْهَامُ جَادَكْ",34,"ك",1,0],["فَقَضَى مَأْربَهُ ثُمَّ انْثنَى","بِرِضَى مَنْ فعَلَ الفِعْلَة بِكْرَا",35,"ر",2,0],["فقضَى حِينَ اقْتَضَى مُنتَحِراً","بِيَديْ مسْتأْجَرٍ أَوسِعَ بِرَّا",35,"ر",2,0],["فَقَضَيْتُ حيناً فِي العَذَابِ وَلمْ","تَدْرِي عَلاَمَ وَمِت لَمْ تَدْرِي",36,"ر",2,0],["فَقَضِّ ملامي، وکطْلُبِ الطِّبَّ، إنَّني","أسرّ جوى في حبها، فهو رازمُ",37,"م",1,0],["فقضى بالخزي مطموسا إلى","حيث القت رحلها ام لبد",38,"د",1,0],["فقضو عليك بما قضوا","وأَنوف قومك في الرغام",39,"م",1,0],["فقَضى بأن القلب سل","طانٌ عليهم قاعِدَهْ",40,"د",2,0],["فَقَضّى المَآرِبَ ما عاقَها","شِماسٌ وَلا عاقَ عَنها فَشَل",41,"ل",1,0],["فَقَضَت لِذِكرِكَ أَن يَسيرَ مُفَوِّزاً","وَقَضَت لِذُكرِكَ أَن يَجِلَّ وَيَعظُما",42,"م",2,0],["فقضيت اشجانا وعدت مظفرا","لما عاد كمه سمع أعداك منشكا",43,"ك",2,0],["فقضي ما قضى وأصلح ما شاء","ووافي ونحنُ في شعبانِ",44,"ن",1,0],["فقضاؤه حق العلى لي مطرب","فاعجب لحق ينقضي وطريبه",45,"ب",2,0],["فَقضَيتُ تَطْوافي بكَعْبِة جُوده","وسَعَيت ثم وقفْت في عَرَفاته",46,"ت",2,0],["فقضى من قضى شهيداً ولا حي","لَة تُنجي ممّا يسوق القضاءُ",47,"ا",2,0],["فَقَضَت حكمةُ الحكيمِ بعجزٍ","عنهُ كَي لا ينالهم الاِزدهاءُ",47,"ا",2,0],["فَقَضى بِإِحدى حاجَتَيهِ وَلَم يَجِد","لِحاجَتِهِ الأُخرى بِحَقٍّ تَصَرَّما",48,"م",2,0],["فَقَضَينَ الغَليلَ ثُمَّ تَوَلَّينَ","بِلَيلٍ وَهُنَّ مِنهُ رَواءُ",49,"ا",2,0],["فقضوا على آمالنا","وجنوا على الحب الرفيع",50,"ع",1,0],["فقضينا على المودة عهدا","خير عهد في ظل ود ظليل",51,"ل",1,0],["فقضينا فيه ذِمامَك إذ لي","س لخَلق سواك عندي ذمام",52,"م",1,0],["فَقَضاهُم وَالتَمرُ بَعدُ بِحالِهِ","أَرضى الغَريمَ وَوارِثَ المِديانِ",53,"ن",1,0],["فَقَضَت عَلَيهِ بِما اِستَبا","حَ مِنَ القُلوبِ وَما سَبا",54,"ب",2,0],["فقض لباناتي وانجح مَطالِبي","وَما اِسطَعت من بر فَلا تألنى جهدا",55,"د",2,0],["فقضيباً لاسمٍ وناياً لشكلٍ","ورَباباً للجرِّ والتصحيف",56,"ف",1,0],["فَقَضِيَّتي كَالنَصِّ في القُرآنِ مَع","داوودَ وَالخَصمِ الَّذي أَشبَهتُهُ",57,"ت",2,0],["فقضينا ليلنا في غبطةٍ","وعلى البر بعهدينا افترقنا",58,"ن",2,0],["فَقضّيتُ منه العجب أنّى تصوّرت","سِفارَته عن مُسفرٍ سافرِ الحجبِ",59,"ب",1,0],["فَقَضى حَجَّهُ وَساقَ المَطايا","نَحوَ روحِ الوُجودِ خَيرُ أَمينِ",60,"ن",1,0],["فَقَضى حَقَّ هَواهُ إِذا قَضى","فَعَلَيهِ نادِ في الأَحياءِ حَي",61,"ي",1,0],["فَقَضَّبَت أَحداثُها دَوحَهُ","وَقَصَفَت مِن بَعدُ أَغصانَه",62,"ن",2,0],["فَقَضَى لي علَيه أنَّ يَسارى","وسَّدَته وقلَّبتهُ يَميني",63,"ن",2,0],["فقضيةٌ حكمت بأمرٍ جازمٍ","وظهورُه يُنبي بصدق خفائه",64,"ا",3,0],["فَقَضى هُناكَ وَلَم يَجد","سَبب الصُدود صَريعه",65,"ع",2,0],["فقضى بأنك للبلاغة مالك","حقاً وأن سواك فيها مدع",66,"ع",1,0],["فَقَضى بِحُكمِ الجور في أَموالِهِ","وَقَضى بِحُكم اللَهِ في الأَيتامِ",67,"م",1,0],["فَقَضَت عيناي منها عجباً","ومن القمريّ 