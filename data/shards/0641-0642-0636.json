gate.com/ViewPoem.aspx?id=189964",""],[5050,"صبرا على مضض المصارع","https://www.poetsgate.com/ViewPoem.aspx?id=38198",""],[5183,"ركب الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=180181",""],[5183,"السمحاء","https://www.poetsgate.com/ViewPoem.aspx?id=180179",""],[5186,"قلب الدهر اختيارا","https://www.poetsgate.com/ViewPoem.aspx?id=156521",""],[5204,"قل لعبد الصمد","https://www.poetsgate.com/ViewPoem.aspx?id=200364",""],[5397,"لمن الرواسم بين تلك الأرسم","https://www.poetsgate.com/ViewPoem.aspx?id=157956",""],[5442,"ألف الصبوة واستحلى الغرما","https://www.poetsgate.com/ViewPoem.aspx?id=114748",""],[5582,"لِمَنْ المَنازِلُ بِالصَّفِيحَةِ تُعْرَفُ","https://www.poetsgate.com/ViewPoem.aspx?id=187184",""],[5582,"إِنَّما نَوْحُ الحَمامِ","https://www.poetsgate.com/ViewPoem.aspx?id=63567",""],[5809,"إبحار","https://www.poetsgate.com/ViewPoem.aspx?id=205094",""],[5997,"يا جاحداً","https://www.poetsgate.com/ViewPoem.aspx?id=214228",""],[6102,"فرات وذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=184550",""],[469,"يا نديمي والنديم معين","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574762",""],[520,"خلعت عليك مواسم الأيام","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577640",""]],"verses":[["فَقَضى اللَهُ عَلَينا","أَن شَحَطنا وَأَقاما",0,"م",2,0],["فَقَضَيناهُ وَلَم نَحفِل بِما","سَطَّرَت أَيدي الكِرامِ الكاتِبين",1,"ن",1,0],["فَقَضَّيتُ الشِتاءَ كَما تَقَضّى","شِتا البُرغوثِ في ذَقنِ اِبنِ سيما",2,"م",2,0],["فَقَضَيتِ مِن فَرضِ الصَلاةِ لُبانَةً","مُشَيِّعُها نُسكٌ وَفارِطُها طُهرُ",3,"ر",1,0],["فَقَضَى قَرِيضَةَ حَجِّهِ يَحْتَثُّهُ","شَوْقٌ وَيَحْدُو رَكْبَهُ الإِيمَانُ",4,"ن",1,0],["فَقَضَى وَهْوَ فِي الْجِهَا","دِ وَمَطْلُوبُهُ أَمَمْ",5,"م",1,0],["فقضى بعد نأيه عن إناس","طلبوا علمه وراموا اقتباسه",6,"س",2,0],["فقضيت فرضاً كالصلاة مسلماً","ودخلت جنات الهنا بسلام",7,"م",1,0],["فقضاكَ ريْعُ العدلِ ما أعطيتهم","أوفى قضاءٍ واصطنعْتَ جميلا",8,"ل",2,0],["فقضى حاجتي وكان كسَيْفٍ","هُزَّ فاهتَزَّ وهْوَ غيْرُ كَهام",9,"م",1,0],["فقضوْا من مقالهم ما قضوْه","ثم آبوا بالرِّفدِ والحُمْلانِ",10,"ن",1,0],["فَقَضَّيتُها في الهَوى لَيلَةً","إِخالُ الخَليفَةَ في خِدمَتي",11,"ت",2,0],["فَقَضَتْ صمْتاً أَناشيدُ الغَرامْ","بَيْنَ أَزْهارِ الخَريفِ الذَّاوِيَهْ",12,"ه",1,0],["فَقَضَى وقدْ غَاضَتْ","أَغاريدُ الحَياةِ الطَّاهِرَهْ",13,"ه",1,0],["فَقَضَّيتُ مِن هَذا وَذاكَ لُبانَةً","وَثَمَّ لَنا فَتحٌ مُبينٌ وَآمالُ",14,"ل",1,0],["فقضي برجحان اليراع","على البنادق والسيوف",15,"ف",1,0],["فَقَضى اللَهُ أَن تُضَيِّعَ هَذا ال","مُلكَ أُنثى صَعبٌ عَلَيها الوَفاءُ",16,"ا",2,0],["فَقَضى ما قَضى وَعادَ إِلَيها","وَالدُجى في ثِيابِهِ الأَخلاقِ",17,"ق",1,0],["فَقَضَّوا مَنايا بَينَهُم ثُمَّ أَصدَروا","إِلى كَلَأٍ مُستَوبِلٍ مُتَوَخَّمِ",18,"م",1,0],["فَقَضَينا لَذَّةَ النَفسِ بِها","في صَفا عَيشٍ بِهِ الدَهرُ حَباها",19,"ا",3,0],["فَقَضَّيتُ عَيشاً لَو قَضَيناهُ يَقظَةً","لَقامَت عَلينا لِلإِلَهِ حُدودُ",20,"د",1,0],["فَقَضَينَ دَيناً كُنَّ قَد ضُمِّنَّهُ","بِعَزائِمٍ غُلبِ الرِقابِ سَوامِ",21,"م",1,0],["فَقَضَينا مَنسِكَ اللَ","هِ وَإِن لَم نَنوِ حَجّا",22,"ج",2,0],["فَقَضَّ مَلامي وَاِطلُبِ الطِبَّ إِنَّني","أُسِرُّ جَوىً مِن حُبِّها فَهوَ رازِمُ",23,"م",1,0],["فَقَضَّيتُها ما بَينَ رَشفَةِ لَوعَةٍ","وَأَنَّةِ شَكوى وَاِعتِناقِ غَرامِ",24,"م",1,0],["فَقَضى إليهِ الأمرَ يأخذُهم بهِ","ويُقيمُه بالحقِّ لا يَتحرَّفُ",25,"ف",1,0],["فَقَضَيْنَا بها مَناسِكَ لا يُح","مَدُ إلّا في فِعْلِهِنَّ القضاءُ",26,"ا",2,0],["فَقَضقَضَ العَجبَ إِلى الظُنبوبِ","وَانتَهَسَ الأَرفاغَ بِالنُيوبِ",27,"ب",1,0],["فقضيتُ منه في الكرى وطري","فصرتُ لم أبلغ مدى وطره",28,"ر",2,0],["فَقَضى اللَهُ أَن يَموتَ كَما ما","تَ بَنونا وَسالِفُ الآباءِ",29,"ا",2,0],["فَقَضَيْنَ مَا قَضَّيْنَ ثُمَّ تَرَكْنَهُمْ","عُزُبَ المَبَاءَةِ غُيَّبَ الأَنْفَارِ",30,"ر",1,0],["فقضيتَ ليلكَ لا هدوءَ ولا كرىً","ووثبتَ في غسَقِ الظلام الجانِحِ",31,"ح",1,0],["فَقَضَيتُ ما لم أَقْضِ فيه بِرِيبَةٍ","يَأْبَى العَفافُ وعِصْمتي بحُضُورِه",32,"ر",2,0],["فَقَضَينا حاجَةً مِن لَذَّةٍ","وحَيَاةُ الُمرءِ كالشَّيءِ الُمعارِ",33,"ر",1,0],["فَقَضَيْتَ حَقَّ الصاحِيَبْنِ","بِمَا بِهِ الإِلْهَامُ جَادَكْ",34,"ك",1,0],["فَقَضَى مَأْربَهُ ثُمَّ انْثنَى","بِرِضَى مَنْ فعَلَ الفِعْلَة بِكْرَا",35,"ر",2,0],["فقضَى حِينَ اقْتَضَى مُنتَحِراً","بِيَديْ مسْتأْجَرٍ أَوسِعَ بِرَّا",35,"ر",2,0],["فَقَضَيْتُ حيناً فِي العَذَابِ وَلمْ","تَدْرِي عَلاَمَ وَمِت لَمْ تَدْرِي",36,"ر",2,0],["فقضى بها سود الليالي زواهراً","بصوت لعرش الله قطعا ً توصلا",37,"ل",2,0],["فَقَضِّ ملامي، وکطْلُبِ الطِّبَّ، إنَّني","أسرّ جوى في حبها، فهو رازمُ",38,"م",1,0],["فقضى بالخزي مطموسا إلى","حيث القت رحلها ام لبد",39,"د",1,0],["فقضو عليك بما قضوا","وأَنوف قومك في الرغام",40,"م",1,0],["فقَضى بأن القلب سل","طانٌ عليهم قاعِدَهْ",41,"د",2,0],["فَقَضّى المَآرِبَ ما عاقَها","شِماسٌ وَلا عاقَ عَنها فَشَل",42,"ل",1,0],["فَقَضَت لِذِكرِكَ أَن يَسيرَ مُفَوِّزاً","وَقَضَت لِذُكرِكَ أَن يَجِلَّ وَيَعظُما",43,"م",2,0],["فقضيت اشجانا وعدت مظفرا","لما عاد كمه سمع أعداك منشكا",44,"ك",2,0],["فقضي ما قضى وأصلح ما شاء","ووافي ونحنُ في شعبانِ",45,"ن",1,0],["فقضاؤه حق العلى لي مطرب","فاعجب لحق ينقضي وطريبه",46,"ب",2,0],["فَقضَيتُ تَطْوافي بكَعْبِة جُوده","وسَعَيت ثم وقفْت في عَرَفاته",47,"ت",2,0],["فقضى من قضى شهيداً ولا حي","لَة تُنجي ممّا يسوق القضاءُ",48,"ا",2,0],["فَقَضَت حكمةُ الحكيمِ بعجزٍ","عنهُ كَي لا ينالهم الاِزدهاءُ",48,"ا",2,0],["فَقَضى بِإِحدى حاجَتَيهِ وَلَم يَجِد","لِحاجَتِهِ الأُخرى بِحَقٍّ تَصَرَّما",49,"م",2,0],["فَقَضَينَ الغَليلَ ثُمَّ تَوَلَّينَ","بِلَيلٍ وَهُنَّ مِنهُ رَواءُ",50,"ا",2,0],["فقضوا على آمالنا","وجنوا على الحب الرفيع",51,"ع",1,0],["فقضينا على المودة عهدا","خير عهد في ظل ود ظليل",52,"ل",1,0],["فقضينا فيه ذِمامَك إذ لي","س لخَلق سواك عندي ذمام",53,"م",1,0],["فَقَضاهُم وَالتَمرُ بَعدُ بِحالِهِ","أَرضى الغَريمَ وَوارِثَ المِديانِ",54,"ن",1,0],["فَقَضَت عَلَيهِ بِما اِستَبا","حَ مِنَ القُلوبِ وَما سَبا",55,"ب",2,0],["فقض لباناتي وانجح مَطالِبي","وَما اِسطَعت من بر فَلا تألنى جهدا",56,"د",2,0],["فقضيباً لاسمٍ وناياً لشكلٍ","ورَباباً للجرِّ والتصحيف",57,"ف",1,0],["فَقَضِيَّتي كَالنَصِّ في القُرآنِ مَع","داوودَ وَالخَصمِ الَّذي أَشبَهتُهُ",58,"ت",2,0],["فقضينا ليلنا في غبطةٍ","وعلى البر بعهدينا