{"poems":[[111,"لا تكترث بالليالي إنها دول","https://www.poetsgate.com/ViewPoem.aspx?id=519",""],[208,"قد كنت أطلب منك الوصل مقتصدا","https://www.aldiwan.net/poem53337.html","البسيط"],[261,"يا سائلي عن بكاي حين رأى","https://www.aldiwan.net/poem48546.html","المنسرح"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[382,"أولى مسيري ذا الأمان","https://www.aldiwan.net/poem59233.html","مجزوء الكامل"],[563,"يا صاحبي في الرخا وفي الضيق","https://www.aldiwan.net/poem34307.html","المنسرح"],[1625,"","https://poetry.dctabudhabi.ae/diwan/poem/146970","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71037","السريع"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93651","الكامل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102663","الرجز"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121558","الدوبيت"],[3291,"","https://poetry.dctabudhabi.ae/diwan/poem/106684","السريع"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133298","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133261","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90743","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133129","البسيط"],[4690,"لا تقْلقي","https://www.poetsgate.com/ViewPoem.aspx?id=153095",""],[4767,"اعتقادي","https://www.poetsgate.com/ViewPoem.aspx?id=200454",""],[5661,"يا سائلي عن بكاي حين أرى","https://www.poetsgate.com/ViewPoem.aspx?id=181400",""],[5956,"أقصوصة امرأة بوصلتها الجنس","https://www.poetsgate.com/ViewPoem.aspx?id=182704",""],[6102,"غُفران ..","https://www.poetsgate.com/ViewPoem.aspx?id=184542",""],[6152,"الوداد لا يموت","https://www.poetsgate.com/ViewPoem.aspx?id=204956",""],[5309,"وطني هو الأرض التي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573566",""]],"verses":[["هذا اعتذاري الى العلياء ان طمحت","ما لزني خور عنها ولا فشل",0,"ل",1,0],["هذا اعتقادي ومجهودي ومقدرتي","حتى الممات وفي يوم الحساب غدا",1,"د",2,0],["هذا اعتقادي وهكذا أبداً","أرى لنفسي فأنت كيف ترى",2,"ر",2,0],["هَذا اِعتِزالٌ وَتَخطيطٌ بِلا أَدَبِ","أَكلُ مَن رامَ وَحَيا جاءَ عَن طَلَبِ",3,"ب",1,0],["هذا اعتقادي إنني","أُبديهِ يومَ الإعتلان",4,"ن",1,0],["هذا اعتقاد الهداة سادتنا","لا عقد غاوٍ غَوَى وزنديق",5,"ق",1,0],["هذا اعتقادي والذي أرجو به","فوزي وعتقي من عذاب النار",6,"ر",1,0],["هذا اعتقادي فَاقْفُ أَو فاعْتَزِلْ","طِرْتُ فلازِمْ صِفَةَ الرازِحِ",7,"ح",1,0],["هذا اِعتِقادي قَد كَشفت غِطاءه","سَيضر معتقداً لَهُ أَو يَنفَع",8,"ع",1,0],["هذا اعتذاري قد ورد محقق","عنه فلا نعتوا ولا نضادد",9,"د",1,0],["هذا أعجب ولم يذق ذو نظر","في الوجودات من حلاه أحلى",10,"ل",2,0],["هَذا اعتِذَارِي فِي الصَّبَابَةِ لاَح","لمَّا تَبَدَّت طَلعَةٌ كَالصَّبَاح",11,"ح",1,1],["هذا اعتقادي والأحبة أسوتي","من شاء فليؤمن ومن شاء اعتزل",12,"ل",1,0],["هذا اعتقادي وهذا كلّ مدّخَري","لموقفٍ أنت فيه جامعُ الأمَمِ",13,"م",1,0],["هذا اعترافي بالقصور مقدم","عذري وأنك سيدي أولى بي",14,"ب",2,0],["هذا اعتقادي ولي في ربنا أمل","أسأله ختماً على الإسلام للعمر",15,"ر",1,0],["هذا اعترافي صُغتُهُ لكِ زهْرة","من قطف شِعري يا فَتاتي،فانْشقي",16,"ق",2,0],["هذا اعتقادي في الذي لي طاب، إن","لم تعتقد، جئني بما هو أطيب",17,"ب",1,0],["هذا اعتقادي وهكذا أبداً","أرى لنفسي وأنت كيف ترى؟",18,"ر",2,0],["هذا اعتناق مذاهبٍ هدامة‎","ويظنها الحمقى هدىً وسَدادا ‏‎ ‏ ‏",19,"د",2,0],["هَذا اعتِرافٌ بِالذُّنُوبِ أَسُوقُهُ","وَ أُقِرُّ : ( إِنَّي قَدْ فَعَلتُ ! فَما العَمَلْ ؟ )",20,"ل",1,0],["هذا اعتذاري بالدموع كتبته","والله عما في الصدور عليم",21,"م",1,0],["هذا اعتِقادي فَليَكُن","يَومَ الفَخارِ قِلادَتي",22,"ت",2,0]]}