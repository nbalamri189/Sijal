غرام لو ذقتماهُ","لم تلومَا المتيمَ المظلوما",113,"م",2,0],["إن صدراً وراءهُ شمس علم","لجديرٌ بحمل هالة بدرِ",114,"ر",1,0],["إن صح أن الصدغ عن","قودِ ففي الثغر العقارْ",115,"ر",1,0],["إن صانها بُعدُ المدَى فلمثلها","تقتادُ كلّ نجيبةٍ مِذاعانِ",116,"ن",1,0],["إِن صُلتَ كُنتَ مُجَبِّنَ الشُجعانِ أَو","ظافَرتَ كُنتَ مُشَجِّعَ الجُبَناءِ",117,"ا",2,0],["إِن صالَ كَفَّ اللَيالي عَن إِرادَتِها","قَهراً وَإِن قالَ طالَ الأَلسُنَ الذُرُبا",118,"ب",2,0],["أنصار دين النبي من بعد غيبته","في نصره بذلوا نفسا وأموالا",119,"ل",2,0],["إن صدّ إلفك بعد ودّه","والبحر يحزر بعد مدّه",120,"د",2,1],["انصفوني فقد مللت العتابا","كم أداري وكم أقاسي العذابا",121,"ب",2,1],["اُنصُر أَخاكَ إِنِ اِجتَداكَ فَواسِهِ","وَإِنِ اِستَغاثَكَ وَاثِقاً بِكَ مالِهِ",122,"ل",2,0],["إن صحَّ عيدُ هوانا كان خاطبُنا","فيه ومنبرُنا الأوتارَ والعُودا",123,"د",2,0],["إن صفو العيشحقا فرصة","ساعة تلقى ودهرا تنعدم",124,"م",1,0],["إن صحّ ما زعموا والإفك ما زعموا","فكيف ألّفت ما أبدعت من كتب",125,"ب",1,0],["إنْ صالَ فالأجَلُ المحتومُ صارمُه","أو طالَ طاولَ وَبْلَ العارضِ الرَذِمِ",126,"م",1,0],["إِنَّ صَدراً حنَوتَ طفلاً عَلَيهِ","لهوَ صَدرٌ مهشَّمُ الأَعضاءِ",127,"ا",2,0],["أَنصفَ اللَيلُ ما لِقَلبي يُناجي","في سُكون الدُجى هَوى سكّانِه",128,"ن",2,0],["أَنصِفوني من لُطفِكُم فَلَقَد غا","دَرَني راحِلا بِغَير فُؤاد",129,"د",1,0],["أنصت الغرب لها واستمتعت","أذن العالم من خلف الحجب",130,"ب",1,0],["إنّ صُبْحاً تغِيبُ عنه ظلامٌ","وظلاماً تكون فيه نهار",131,"ر",1,0],["أُنصر أخاك فإن القوم قد نصروا","غِلْمانهم واسمُ في تأخير منتصِر",132,"ر",1,0],["إن صارمتك لياليه فما رَجَعت","إلاّ على نفسها بالوَيْل والحَرَب",133,"ب",1,0],["إِن صَحَّ لي خُبزُ بُرٍّ","أَولا فَخُبزُ شَعيرِ",134,"ر",1,0],["أَنصَفَكَ الحُسنُ فَحا","شاكَ بِأَن تَظلِمَني",135,"ن",2,0],["أنصفوني ياشهودي","من حبيبٍ شَنَّ حربا",136,"ب",2,0],["إن صحوي وماء دجلة يجري","تحت غيمٍ يصوبُ غير صواب",137,"ب",1,0],["إن صال في حومة الهيجا وخال بها","فأيّ قرمٍ تراه غير رعديد",138,"د",1,0],["ان صدني عنك دهر لا زمام له","فالدهر يغدر بالأنسان ما أمنا",139,"ن",2,0],["إن صادموا جبلاً