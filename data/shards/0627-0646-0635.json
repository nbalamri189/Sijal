,"الخفيف"],[430,"من مجيري من قده السمهري","https://www.aldiwan.net/poem40092.html","الخفيف"],[433,"زهرن فاعجب لروض ماله زهر","https://www.aldiwan.net/poem12341.html","البسيط"],[433,"أبدى شمائل جفوة وبعاد","https://www.aldiwan.net/poem12600.html","الكامل"],[433,"ما أطول الليل على الساهر","https://www.aldiwan.net/poem12619.html","السريع"],[449,"إن صدغ الحبيب والفم والعارض","https://www.aldiwan.net/poem53760.html","الطويل"],[450,"الحكم للعمل","https://www.aldiwan.net/poem1013.html",""],[459,"مالك لا تطرب يا حادي النعم","https://www.aldiwan.net/poem55901.html","الرجز"],[459,"نوازع الشوق والغليلِ","https://www.aldiwan.net/poem55990.html","مخلع البسيط"],[459,"آنس برقا بالشريف لامعا","https://www.aldiwan.net/poem56123.html","الرجز"],[459,"بلوت هذا الدهر أطواره","https://www.aldiwan.net/poem56171.html","السريع"],[459,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[462,"حي نجدا وأين من مرو نجد","https://www.aldiwan.net/poem15112.html","الخفيف"],[462,"كرار بأس وجود لا تملهما","https://www.aldiwan.net/poem16357.html","البسيط"],[465,"ما للخيال جفا وقد بعد المدى","https://www.aldiwan.net/poem3191.html","عموديه"],[465,"سفرت والليل داج فأنارا","https://www.aldiwan.net/poem3476.html","عموديه"],[465,"جد الغرام وزاد القال والقيل","https://www.aldiwan.net/poem3635.html","عموديه"],[469,"إن صام إبراهيم عن ذكري","https://www.aldiwan.net/poem59998.html","الخفيف"],[480,"لا الترك ترضى بما أجرت حكومتها","https://www.aldiwan.net/poem37042.html","البسيط"],[480,"وحق سيف أنور","https://www.aldiwan.net/poem37204.html","مجزوء الرجز"],[480,"قرنت قلوصك ربها بزميله","https://www.aldiwan.net/poem37580.html","الكامل"],[480,"في الجد أو في اللعب","https://www.aldiwan.net/poem37612.html","مجزوء الرجز"],[501,"جاء البشير ليعقوبي بيوسفه","https://www.aldiwan.net/poem38078.html","البسيط"],[506,"خيال الحقل","https://www.aldiwan.net/poem27894.html","مجزوء الوافر"],[517,"ألا ليت شعري ما الذي تحدثين بي","https://www.aldiwan.net/poem48693.html","الطويل"],[530,"بالله يا علم الهدى","https://www.aldiwan.net/poem37382.html","مجزوء الكامل"],[530,"هذا العقيق فقف على أبوابه","https://www.aldiwan.net/poem37529.html","الكامل"],[539,"فقد الأحبة موقف كالموقف","https://www.aldiwan.net/poem47555.html","عموديه"],[539,"سال بالسحر منك خير يراع","https://www.aldiwan.net/poem47556.html","عموديه"],[539,"يا له حبا اتحد","https://www.aldiwan.net/poem48224.html","عموديه"],[541,"أنصب للمنية تعتريهم","https://www.aldiwan.net/poem56693.html","الوافر"],[545,"أنّى التفتّ فثمّ إسمك","https://www.aldiwan.net/poem67251.html","عموديه"],[559,"إنني غير من أحب وإني","https://www.aldiwan.net/poem33562.html","الخفيف"],[568,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[576,"لا كانت الشمس فكم أصدأت","https://www.aldiwan.net/poem2808.html","السريع"],[576,"جاد وما ضن عليه ضناه","https://www.aldiwan.net/poem2996.html","السريع"],[587,"إن صد وأضحى للجفا يعتمد","https://www.aldiwan.net/poem17482.html","الدوبيت"],[588,"يا راكباً من رياض المجد مرتحلا","https://www.aldiwan.net/poem11553.html","عموديه"]],"verses":[["إِن صينَ سَردُكَ في العِيابِ فَطالَما","أَمسى عَلَيكَ مُذَيَّلاً وَمُذالا",0,"ل",2,0],["إِن صاحَ صائِحُهُم يَومَ الوَغى هَجَموا","عَلى السَوابِقِ بِالبيضِ المَذاويدِ",1,"د",1,0],["أُنْصِفُ إنْ جارَ وأعْنو إذا","سَطا وألْقى بالخُشوعِ الجِماحْ",2,"ح",1,0],["إنْ صابَرَتْ نَفْسي أذاهُ تعبّدَتْ","أو صِحْتُ منْهُ أنِفْتُ منْ تَحْنيثي",3,"ث",2,0],["أَنْصَفَتَ جَيْشَ الْمُسْلِمِينَ فَمَا الْقَنَا","صَعْبَ الْمَهَزِّ وَمَا الْحُسَامُ بِنَابِي",4,"ب",2,0],["إِن صَحَّ ما قالوا وَما أَرجَفوا","وَأَلصَقوا زوراً بِدينِ العَميد",5,"د",1,1],["إِن صَوَّروكَ فَإِنَّما قَد صَوَّروا","تاجَ الفَخارِ وَمَطلَعَ الأَنوارِ",6,"ر",1,1],["إِن صُغِّرَ الكَذّابُ مِن قَبلِهِ","فَلا تُصغِّرهُ وَقُل مَسلَمَه",7,"م",2,0],["إِنَّ صَخراً كانَ حِصناً","وَرُبىً لِلنُطَفَه",8,"ف",2,0],["أَنْصَبَتْ دَمْعَهَا العُيُو","نُ وَلانَتْ صَفَا الأَكَمْ",9,"م",1,0],["أنصار ملته أعلام بيعته","مناقب شرفت أثنى بها اللَّهُ",10,"ه",1,0],["أنصار خير الورى مختار هجرته","جيران روضته أكرمُ بأهلِيها",11,"ي",3,0],["أنصارُ دين الله حزبُ رسوله","والسابقون بحلبة العلياءِ",12,"ا",2,0],["إن صحّ أن العدوّ اليوم مقترب","إلى العراق فقد أكدى وقد أفنا",13,"ن",2,0],["أن صحّ نَقْلكم بذاك فبيِّنوا","أو قام عندكم الدليل فهاتوا",14,"ت",3,0],["أَنصارُ حَقٍّ عَلى بُلقٍ مُسَوَّمَةٍ","إِمدادُ رَبِّكَ كانوا خَيرَ إِمدادِ",15,"د",1,0],["أَنَصَرتَ قَينَ بَني قُفَيرَةَ مُحلِباً","أَسُراقَ لَيسَ لِبارِقَ التَخيِيرُ",16,"ر",1,0],["انصف امرىء من نصف حيَ يسبني","لعمري لقد لاقيت خطباً من الخطبِ",17,"ب",1,1],["انصرم الحبلَ حبلَ البيض أم تصِلُ","وكيف والشيبُ في فوديك مشتعلُ",18,"ل",1,1],["أنصارُ دينِ الإسلام عبية خ","ير الخلق أهل الإيواءِ والصُّحبه",19,"ب",2,0],["إن صار سفري كالسعيد الذي","يسمى فمدحي كعبيد الرحيم",20,"م",1,1],["إن صدَّها عني المشيب فطالما","عطفت شمائِلها بما أرضاني",21,"ن",2,0],["أن صادفوا من قد عَلِمْ","تَ وعَبْدَهُ يحشو جِرابهْ",22,"ب",2,0],["أنْصُلٌ يُنْتَضَيْنَ من أنْصُلٍ بي","ضٍ كأمْثَالِهِنَّ لا من غُمُودِ",23,"د",1,0],["أنصفت بعض الناس من بعضهم","فأنصف الناسَ من الدهر",24,"ر",1,0],["إن صكت الوجه فسفاعة","أو صكت الرأس فقمّاعه",25,"ع",2,0],["أنُصابُ فيكمْ بالرَّدى","وتسدُّ دونكُمُ المسالكْ",26,"ك",1,0],["إن صحَّ علمُ النجومِ كان لكم","حقاً إذا ما سواكمُ انتحلا",27,"ل",2,0],["أنصفتَهم وأقمتَ عدلكَ فيهمُ","ميزانَ قِسطٍ لا يميلُ مَميلا",28,"ل",2,0],["أنصفَ اللَّهُ صاحبَ العذْلِ منها","عاشقاً والمحسّنات الحسانا",29,"ن",2,0],["اُنصُر أَخاكَ فَإِن فَعَلتَ كَفَيتَهُ","ذُلَّ السُؤالِ وَمِنَّةَ البُخَلاءِ",30,"ا",2,0],["إِن صَحَونا فَأَحاديثُ الوَغى","في الحِمى الآهِلِ وَالأَرضِ العَراء",31,"ا",2,0],["إِنَّ صِدقاً لا أُحِسُّ بِهِ","هُوَ شَيءٌ يُشبِهُ الكَذِبا",32,"ب",2,0],["إِن صَحَّ ما قالَ الرَسو","لُ وَهبتُهُ روحي بِشارَه",33,"ر",2,0],["أنصتوا أنصتوا فقد طاف بالور","د صباحاً يغرّد العندليب",34,"ب",1,1],["اِنصَرَف الكُرّارُ وَالكُماةُ","وَاِنحَرَف الأَنصارُ وَالحُماةُ",35,"ه",1,0],["إِن صَحَّ فَهيَ عَلى الزَمانِ صَحيحَةٌ","أَو زافَ كانَت ظاهِراً وَطِلاءَ",36,"ا",2,0],["إِن صَدَقَت يا رَبِّ أَحلامُهُ","فَإِنَّ خَطبَ المُسلِمينَ الجَليل",37,"ل",1,0],["أَنصُر بِجودِكَ أَلفاظاً تَرَكتُ بِها","في الشَرقِ وَالغَربِ مَن عاداكَ مَكبوتا",38,"ت",2,1],["إن صبغ الأجساد إن تم في الأج","ساد فافطن تفز ملك كبيرِ",39,"ر",1,0],["أَنصَلتُ مِن عَودِ الحَياءِ وَبَدئِهِ","وَخَرَجتُ مِن طولِ الوَفاءِ وَعَرضِهِ",40,"ض",2,0],["إِن صَدَّ عَنّي بِوَجهِهِ عَبَثاً","فَفي قَفاهُ مِن وَجهِهِ عِوَضُ",41,"ض",1,0],["أَنَصرَ بنَ سَيّارٍ بِكَفَّيكَ ضُمِّنَت","مَعَ الجودِ ضَربَ الهامِ عِندَ الوَقائِعِ",42,"ع",1,0],["أَنصِف هُديتَ إِذا ما كُنتَ مُنتَصِفاً","لا تَرضَ لِلناسِ شَيئاً لَستَ تَرضاهُ",43,"ا",2,0],["اِنصَح صَديقَكَ مَرَّتَينِ","فَإِن عَصاكَ فَغُشَّهُ",44,"ه",1,1],["إِنَّ صَفوَ عَيشَتِنا","لا يَشوبُهُ كَدَرُ",45,"ر",1,0],["أَنصَفتُهُ جُهدي وَلي ما أَنصَفا","وَلَكَم صَفَوتُ لَهُ وَلي ما إِن صَفا",46,"ف",2,1],["إِن صَدَّني ثانِ","عَمّا أَروم",47,"م",1,0],["إِن صَمَتوا كانَ صَمتُهُم أَدَباً","أَو نَطَقوا كانَ نُطقُهِم حِكَمُ",48,"م",1,0],["إِن صُلتَ غادَرنا العُدا","ةَ بِكُلِّ فَجٍّ تُفجَأُ",49,"ا",1,0],["إن صانَ العِرْضَ وأكْرَمهُ","فقذال الوفر قد امتهنا",50,"ن",2,0],["أنصفتَ همّاتِكَ أعْظِمْ بها","لم يُنْصِفِ الهمّاتِ مثلُ الهمام",51,"م",1,0],["إن صادقَتْهُ زمانَ صادَقَهُ الصّبا","فهيَ الَّتي عادَتْهُ لمّا عَادى",52,"د",2,0],["إِنْ صَالَ فَلَّ الْعِدَا بِصَوْلَتِهِ","أَوْ قَالَ أَرْوَتْ مُشَاشَنَا كَلِمُهْ",53,"م",2,0],["إنَّ صبري وأنَّتي وهواهُ","بينَ واهٍ وذائعٍ ومصونِ",54,"ن",1,0],["إن صحا الدهرُ لهُ","سترى ما سترا",55,"ر",2,0],["إِن صَدَّ عَنّي كُنتُ أَكرَمَ مُعرِضٍ","وَوَجَدتُ عَنهُ مَرحَلاً وَمَكانا",56,"ن",2,0],["أَنصابِ عَمرَةَ وَالمَطِيُّ كَأَنَّها","قِطَعُ القَطا صَدَرَت عَنِ الأَجبابِ",57,"ب",1,0],["أَنصَفْتَ دينَ النّورِ فانْتبَهَتْ له","أحلامُ قومٍ في الظّلامِ نيامِ",58,"م",1,0],["أنصارُ دينِ الله حول نَبيِّهِ","وصلوا بيَثربَ حَبْلَهُ المصروما",59,"م",2,0],["أَنْصَفْتِ دينَ اللهِ مِن أعدائِه","وهَزَمْتِ دِينَ الكُفْرِ والإِلحادِ",60,"د",1,0],["إن صال منهم في الكريهةِ مُقدِمٌ","صالَ الزُّبَيرُ وأقدم المقدادُ",61,"د",1,0],["أنصفتَ قومَكَ والمظالمُ وُقَّعٌ","بِكَ لا تُغيِّرُ بعد حالٍ حالا",62,"ل",2,0],["أنصت لتسمعَ ما ضمَّت جَوانِحُها","إِنّي لَأَسمَعُ فيها الحُزنَ يَصطَخِبُ",63,"ب",1,0],["أَنصِفي الظالِمينَ يا دَولَةَ الفا","روقِ مِنّا وَعَلِّمي الجُهّالا",64,"ل",2,0],["أَنَصدَعُ رُكنَ الدَهرِ مِن بَعدِ ما رَسا","وَقَرَّت أَواسيهِ بِنا وَالقَوائِمُ",65,"م",1,0],["أنصارُهُ في الحادِثَاتِ إذا طَغَتْ","وجنودُهُ في الحربِ سَاعَةَ تَعصِفُ",66,"ف",1,0],["انصروا اللَّهَ وصُونُوا دِينَهُ","إنّ خيرَ الدّينِ دِينُ المسلمِ",67,"م",1,0],["أنصتي فالليلُ مُصغٍ أنصتي","وَقَع الخطبُ فماذا تصنعين",68,"ن",1,0],["إنْ صالَ كانَ اللَّيْثُ منهُ شَعْرَةً","أَوْ جادَ كانَ البحْرُ منه أُنْمُلَهْ",69,"ل",2,0],["أَنصَفتُمونا فَعابوا حُكمَكُم حَسَداً","وَاللَهُ يَعصِمُكُم مِن غِلِّ حُسّادِ",70,"د",1,0],["إِن صَحَّ تَعذيبُ رَمسٍ مَن يَحُلُّ بِهِ","فَجَنِّبانِيَ مَلحوداً وَمَضروحا",71,"ح",2,0],["إِن صَحَّ لي أَنَّني سَعيدُ","فَلَيتَني ضَمَّني صَعيدُ",72,"د",1,1],["إِن صَحَّ جِسمٌ فَإِنَّ الدينَ مُنتَكِسٌ","تَظُنُّهُ كُلَّ حينٍ مُدنَفاً هَجَرا",73,"ر",2,0],["إِن صُمتَ عَن مَأكَلِ العادي وَمَشرَبِهِ","فَلا تُحاوِل عَلى الأَعراضِ إِفطارا",74,"ر",2,0],["إِن صادَفَت أَرضاً أَرَتكَ خُمودَها","أَو وافَقَت أُكُلاً أَرَتكَ مَنارَها",75,"ر",3,0],["إِن صَحَ عَقلُكَ فَالتَفَرُّدُ نِعمَةٌ","وَنَوى الأَوانِسِ غايَةُ الإيناسِ",76,"س",1,0],["اِنصَح فَإِنَّ النُصحَ لِلمَرءِ مِث","لُ الغَيثِ أَروى بِوابِلٍ وَبَغَش",77,"ش",1,1],["أَنُصفِقُ أَن تُغَيِّرَنا اللَيالي","وَيُسمَعُ مِن مَزاهِرِنا اِصطِفاقُ",78,"ق",1,0],["إِن صَحَّ قَولُكُما فَلَستُ بِخاسِرٍ","أَو صَحَّ قَولي فَالخُسارُ عَلَيكُما",79,"م",2,0],["أَنصَفَ مَولانا وَكُلُّ اِمرِئٍ","يَظلِمُ وَالظُلمُ مِنَ اللُومِ",80,"م",1,0],["إنْ صالَ صِلُّ عِذَارَيْهِ فلا حَرَجٌ","أنْ يجْنِ لَسْعاً وأني أجتَني لَعَسَا",81,"س",2,0],["إن صدقت كذبها","أَو كذبت صدقها",82,"ق",3,0],["إن صح ما قد شاع يومئذٍ","فلأَنتَ آخر من به نكبوا",83,"ب",3,0],["إن صُدَّ عَن بحر فنار قد بَدَت","أَو صد عَن نار فَلُجٌّ داني",84,"ن",2,0],["إنْ صَعَّدتْ فالجبالُ الشمُّ هاويةٌ","أو عربدت فالصخورُ الصمُّ أشلاءُ",85,"ا",2,0],["إِنَّ صَدرَ السَعيرِ أَحنى عَلَينا","مِن شُلَيرٍ وَأَينَ مِنّا السَعيرُ",86,"ر",1,0],["أَنصَفَت أَهلَ الفَقرِ مِن أَهلِ الغِنى","فَ