,3,0],["إن صار إيذاء المشاعر غاية","فقد اختفى عقلٌ وطار صوابُ",167,"ب",1,0],["أنصفت والعالم اللبيب يرى","إنصاف أهل الكمال من شيمه",168,"م",2,0],["إِن صَدَّني عَنكَ الزَمان فَإِنَّهُ","صَدَّ امرىءٍ يَلقاكَ في أَحلامِهِ",169,"م",2,0],["انصر شَكوراً ذاكِراً","لَكَ بِالجَميلِ بِلا فُتور",170,"ر",1,0],["أَنصِفِ المال مِن نوالك يا مَن","بيديه أَمرُ المَظالِمِ طُرّا",171,"ر",2,0],["إنَّ صبرَ الكلِيمِ وهو طَريدُ الْ","خَوفِ أفضَى بِهِ إلى طُورِ سينَا",172,"ن",2,0],["أنصِفونا من هجركم بوصول","أنا راضٍ منكم بحتّى ولمّا",173,"م",2,0],["أن صبح الجبين لاح وغنّت","في رياض الجمال ورق الحلي",174,"ي",1,0],["أَنْصَفْتُهَا بكَ نِصْفَ الشهرِ شَيِّقَةً","تكادُ لو أُخِّرَتْ للفِطْرِ تَنْفَطِر",175,"ر",1,0],["إن صنتُ دمعَ العينِ بعد عظيم ما","لاقيتُ من فَجْعي بأهلِ وِدادي",176,"د",2,0],["إن صدّ نيل الدمعِ عن نيلِه","فإنّهُ جاءَ على الحاجر",177,"ر",1,0],["إن صدغ الحبيب والفم والعا","رض منه واو وصاد ولام",178,"م",1,1],["إن صنف الجهل خلف الركب راحلتي","فالحكم للعمل لاما صنف الجهلا",179,"ل",2,0],["أنصحهُم جيباً وأمضاهم شَباً","والسيفُ نابٍ والشقيقُ متَّهَمْ",180,"م",1,0],["أنصلَ كرُّ السّقامِ شِلواً","منّي ومنها كَزَّ السيولِ",181,"ل",1,0],["أنصفني من الزمان حاكمٌ","لم يُبْقِ للفضلِ نصيباً ضائعا",182,"ع",2,0],["إن صَمَّ عنك الناسُ أو غَمَضتْ","في الخطب عينٌ وهي نظّارَهْ",183,"ر",2,0],["إن صاحبتْ يوماً إليكم عاطلاً","حلَّتْه أو تَفِلَ النواحي عَطَّرتْ",184,"ت",1,0],["أنَّ صبري صبرَ الدِّلاص على الطَّ","عْنِ وقد أحكمَ القُوى والسَّرْدُ",185,"د",1,0],["إنْ صالَ أو قالَ في سلمٍ ومُعتركٍ","أقَرَّ بالفضْلِ أبْطالٌ وأحْبارُ",186,"ر",1,0],["إن صال كان غضنفرا أو سيل كا","ن كنهوراً أو سل كان مهندا",187,"د",2,0],["إنَّ صبري ضلَّ في ضال الحمى","وهجوعي في الدجى يا حارِ حارا",188,"ر",2,0],["إن صال أو قال أودى في مواقفه","مجدّل من أعاديه ومجدول",189,"ل",1,0],["إِن صامَ إِبراهيمُ عَن ذِكري","فَطَّرتُهُ مِنّي عَلى صَبري",190,"ي",1,1],["إن صح هذا فبشرهم بعاقبة","خسرى ولكن بودي أنه الكذب",191,"ب",1,0],["أنصار دستور عظام","وحق سلطان الأنام",192,"م",1,0],["أنصت لساجعة القريض ويا له","صوتا شجيا من نشيد جميله",193,"ل",2,0],["إن صاح مظلوم يق","ولوا محدث للشغب",194,"ب",1,0],["إِنْ صحَّ لي وشُؤُنُ الكونِ عاطِلَةٌ","فلا ضِرارَ لَعَمْري ذاكَ مطْلوبي",195,"ب",2,0],["أنصحبُ من اذا استغنى","سيلدُغنا كما العقربْ؟!",196,"ب",1,0],["انصرِمني عِندَ الأَلى لَنا العِدا","فَتشمتهُم بي ام تَدومُ عَلى العَهد",197,"د",1,0],["اُنصُرْهُ في أَمْرٍ بمَعْ","رُوفٍ وإنكارِ النُّكُرْ",198,"ر",1,0],["إِنْ صَحَّ ما نَقَلَ الأَئِمَّةُ عَنْهُمُ","فالكفْرُ ضَرْبَةُ لازب بِصحابِهِ",199,"ب",2,0],["أنصف بحقِّك يَا زمانُ مُسَهَّدا","لم يلقَ فيمَن حولَه مِن مُنصِفِ",200,"ف",1,0],["أنصِفُوهُم فإنهُم في عَذَابٍ","واتقُوا اللهَ يا أُولي الإنصَافِ",201,"ف",1,0],["أنصفِ النفسَ أيها الش","شِعر وأبلغ في ذا الصَّدَد",202,"د",1,0],["أَنَصبٌ لِلمَنِيَّةِ تَعتَريهِم","رِجالي أَم هُمُ دَرجُ السيولِ",203,"ل",1,1],["إنْ صحتُ: (فاطمةٌ) أجابَنِيَ المدَى","عبر الجهات وشَعَّ ضوءٌ أخضرُ",204,"ر",1,0],["إن صحونا من سكرة الجمع أما","إن سكرنا فالسكر غيب الهويه",205,"ي",2,0],["إِنْ صُدِّعَ الرَّأْسُ مِنْ شَرَابٍ","فَهْيَ يُدَاوَى بِهَا الصُّدَاعُ",206,"ع",1,0],["إِن صَدأَ الطرف فما صَقْلُه","إِلاَّ التحلِّي بِمُحَيّاً جَمِيل",207,"ل",1,0],["إِنَّ صَفيَّ الدّين حِصْني فما","يَقْرعُ هذا الدَّهرُ لي من صَفاه",208,"ا",2,0],["إِنْ صَدَّ وأَضْحَى لِلجَفَا يَعْتَمِدُ","أَوْ زَالَ وِدَادُهُ الَّذي أَعْتَقِدُ",209,"د",1,1],["أنصار دين الهدى في كل معضلة","كهف العفاة وأرحام وأيتام",210,"م",1,0]]}