616.html","البسيط"],[46,"يغدو إلى كسب قيراط أخو عمل","https://www.aldiwan.net/poem22623.html","البسيط"],[46,"مثل الفتى عند التغرب والنوى","https://www.aldiwan.net/poem22634.html","الكامل"],[46,"أنسيت حق الله أم أهملته","https://www.aldiwan.net/poem22843.html","الكامل"],[46,"انصح فإن النصح للمرء مث","https://www.aldiwan.net/poem22872.html","المنسرح"],[46,"أنافق في الحياة كفعل غيري","https://www.aldiwan.net/poem23022.html","الوافر"],[46,"قال المنجم والطبيب كلاهما","https://www.aldiwan.net/poem23355.html","الكامل"],[46,"نطقت حيا نيرا فاعذري","https://www.aldiwan.net/poem23416.html","السريع"],[68,"قف بالديار وحي الأربع الدرسا","https://www.aldiwan.net/poem1503.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85577","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85445","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85430","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39630","البسيط"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20203","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202637","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54915","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54823","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54773","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54890","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54718","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142017","الخفيف"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5177","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[106,"من وحي السد","https://www.poetsgate.com/ViewPoem.aspx?id=179600",""],[106,"حفظ الله صالحًا","https://www.poetsgate.com/ViewPoem.aspx?id=179358",""],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[106,"شعب واحد ورب واحد","https://www.poetsgate.com/ViewPoem.aspx?id=179304",""],[106,"يا أخت عموريْة!","https://www.poetsgate.com/ViewPoem.aspx?id=179607",""],[90,"أمين الريحاني","https://www.poetsgate.com/ViewPoem.aspx?id=178954",""],[91,"عطش الارواح","https://www.poetsgate.com/ViewPoem.aspx?id=53426",""],[46,"يغدو، إلى كسبِ قيراطٍ، أخو عملٍ،","https://www.poetsgate.com/ViewPoem.aspx?id=20191",""],[105,"هذا الدفاع وهذه الأجناد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55039&r=&rc=209",""]],"verses":[["إِن صينَ سَردُكَ في العِيابِ فَطالَما","أَمسى عَلَيكَ مُذَيَّلاً وَمُذالا",0,"ل",2,0],["إِن صاحَ صائِحُهُم يَومَ الوَغى هَجَموا","عَلى السَوابِقِ بِالبيضِ المَذاويدِ",1,"د",1,0],["أُنْصِفُ إنْ جارَ وأعْنو إذا","سَطا وألْقى بالخُشوعِ الجِماحْ",2,"ح",1,0],["إنْ صابَرَتْ نَفْسي أذاهُ تعبّدَتْ","أو صِحْتُ منْهُ أنِفْتُ منْ تَحْنيثي",3,"ث",2,0],["أَنْصَفَتَ جَيْشَ الْمُسْلِمِينَ فَمَا الْقَنَا","صَعْبَ الْمَهَزِّ وَمَا الْحُسَامُ بِنَابِي",4,"ب",2,0],["إِن صَحَّ ما قالوا وَما أَرجَفوا","وَأَلصَقوا زوراً بِدينِ العَميد",5,"د",1,1],["إِن صَوَّروكَ فَإِنَّما قَد صَوَّروا","تاجَ الفَخارِ وَمَطلَعَ الأَنوارِ",6,"ر",1,1],["إِن صُغِّرَ الكَذّابُ مِن قَبلِهِ","فَلا تُصغِّرهُ وَقُل مَسلَمَه",7,"م",2,0],["إِنَّ صَخراً كانَ حِصناً","وَرُبىً لِلنُطَفَه",8,"ف",2,0],["أَنْصَبَتْ دَمْعَهَا العُيُو","نُ وَلانَتْ صَفَا الأَكَمْ",9,"م",1,0],["أنصار ملته أعلام بيعته","مناقب شرفت أثنى بها اللَّهُ",10,"ه",1,0],["أنصار خير الورى مختار هجرته","جيران روضته أكرمُ بأهلِيها",11,"ي",3,0],["أنصارُ دين الله حزبُ رسوله","والسابقون بحلبة العلياءِ",12,"ا",2,0],["إن صحّ أن العدوّ اليوم مقترب","إلى العراق فقد أكدى وقد أفنا",13,"ن",2,0],["أن صحّ نَقْلكم بذاك فبيِّنوا","أو قام عندكم الدليل فهاتوا",14,"ت",3,0],["أَنصارُ حَقٍّ عَلى بُلقٍ مُسَوَّمَةٍ","إِمدادُ رَبِّكَ كانوا خَيرَ إِمدادِ",15,"د",1,0],["أَنَصَرتَ قَينَ بَني قُفَيرَةَ مُحلِباً","أَسُراقَ لَيسَ لِبارِقَ التَخيِيرُ",16,"ر",1,0],["انصف امرىء من نصف حيَ يسبني","لعمري لقد لاقيت خطباً من الخطبِ",17,"ب",1,1],["انصرم الحبلَ حبلَ البيض أم تصِلُ","وكيف والشيبُ في فوديك مشتعلُ",18,"ل",1,1],["أنصارُ دينِ الإسلام عبية خ","ير الخلق أهل الإيواءِ والصُّحبه",19,"ب",2,0],["إن صار سفري كالسعيد الذي","يسمى فمدحي كعبيد الرحيم",20,"م",1,1],["إن صدَّها عني المشيب فطالما","عطفت شمائِلها بما أرضاني",21,"ي",1,0],["أن صادفوا من قد عَلِمْ","تَ وعَبْدَهُ يحشو جِرابهْ",22,"ب",2,0],["أنْصُلٌ يُنْتَضَيْنَ من أنْصُلٍ بي","ضٍ كأمْثَالِهِنَّ لا من غُمُودِ",23,"د",1,0],["أنصفت بعض الناس من بعضهم","فأنصف الناسَ من الدهر",24,"ر",1,0],["إن صكت الوجه فسفاعة","أو صكت الرأس فقمّاعه",25,"ع",2,0],["أنُصابُ فيكمْ بالرَّدى","وتسدُّ دونكُمُ المسالكْ",26,"ك",1,0],["إن صحَّ علمُ النجومِ كان لكم","حقاً إذا ما سواكمُ انتحلا",27,"ل",2,0],["أنصفتَهم وأقمتَ عدلكَ فيهمُ","ميزانَ قِسطٍ لا يميلُ مَميلا",28,"ل",2,0],["أنصفَ اللَّهُ صاحبَ العذْلِ منها","عاشقاً والمحسّنات الحسانا",29,"ن",2,0],["اُنصُر أَخاكَ فَإِن فَعَلتَ كَفَيتَهُ","ذُلَّ السُؤالِ وَمِنَّةَ البُخَلاءِ",30,"ا",2,0],["إِن صَحَونا فَأَحاديثُ الوَغى","في الحِمى الآهِلِ وَالأَرضِ العَراء",31,"ا",2,0],["إِنَّ صِدقاً لا أُحِسُّ بِهِ","هُوَ شَيءٌ يُشبِهُ الكَذِبا",32,"ب",2,0],["إِن صَحَّ ما قالَ الرَسو","لُ وَهبتُهُ روحي بِشارَه",33,"ر",2,0],["أنصتوا أنصتوا فقد طاف بالور","د صباحاً يغرّد العندليب",34,"ب",1,1],["اِنصَرَف الكُرّارُ وَالكُماةُ","وَاِنحَرَف الأَنصارُ وَالحُماةُ",35,"ه",1,0],["إِن صَحَّ فَهيَ عَلى الزَمانِ صَحيحَةٌ","أَو زافَ كانَت ظاهِراً وَطِلاءَ",36,"ا",2,0],["إِن صَدَقَت يا رَبِّ أَحلامُهُ","فَإِنَّ خَطبَ المُسلِمينَ الجَليل",37,"ل",1,0],["أَنصُر بِجودِكَ أَلفاظاً تَرَكتُ بِها","في الشَرقِ وَالغَربِ مَن عاداكَ مَكبوتا",38,"ت",2,1],["إن صبغ الأجساد إن تم في الأج","ساد فافطن تفز ملك كبيرِ",39,"ر",1,0],["أَنصَلتُ مِن عَودِ الحَياءِ وَبَدئِهِ","وَخَرَجتُ مِن طولِ الوَفاءِ وَعَرضِهِ",40,"ض",2,0],["إِن صَدَّ عَنّي بِوَجهِهِ عَبَثاً","فَفي قَفاهُ مِن وَجهِهِ عِوَضُ",41,"ض",1,0],["أَنَصرَ بنَ سَيّارٍ بِكَفَّيكَ ضُمِّنَت","مَعَ الجودِ ضَربَ الهامِ عِندَ الوَقائِعِ",42,"ع",1,0],["أَنصِف هُديتَ إِذا ما كُنتَ مُنتَصِفاً","لا تَرضَ لِلناسِ شَيئاً لَستَ تَرضاهُ",43,"ا",2,0],["اِنصَح صَديقَكَ مَرَّتَينِ","فَإِن عَصاكَ فَغُشَّهُ",44,"ه",1,1],["إِنَّ صَفوَ عَيشَتِنا","لا يَشوبُهُ كَدَرُ",45,"ر",1,0],["أَنصَفتُهُ جُهدي وَلي ما أَنصَفا","وَلَكَم صَفَوتُ لَهُ وَلي ما إِن صَفا",46,"ف",2,1],["إِن صَدَّني ثانِ","عَمّا أَروم",47,"م",1,0],["إِن صَمَتوا كانَ صَمتُهُم أَدَباً","أَو نَطَقوا كانَ نُطقُهِم حِكَمُ",48,"م",1,0],["إِن صُلتَ غادَرنا العُدا","ةَ بِكُلِّ فَجٍّ تُفجَأُ",49,"ا",1,0],["إن صانَ العِرْضَ وأكْرَمهُ","فقذال الوفر قد امتهنا",50,"ن",2,0],["أنصفتَ همّاتِكَ أعْظِمْ بها","لم يُنْصِفِ الهمّاتِ مثلُ الهمام",51,"م",1,0],["إن صادقَتْهُ زمانَ صادَقَهُ الصّبا","فهيَ الَّتي عادَتْهُ لمّا عَادى",52,"د",2,0],["إِنْ صَالَ فَلَّ الْعِدَا بِصَوْلَتِهِ","أَوْ قَالَ أَرْوَتْ مُشَاشَنَا كَلِمُهْ",53,"م",2,0],["إنَّ صبري وأنَّتي وهواهُ","بينَ واهٍ وذائعٍ ومصونِ",54,"ن",1,0],["إن صحا الدهرُ لهُ","سترى ما سترا",55,"ر",2,0],["إِن صَدَّ عَنّي كُنتُ أَكرَمَ مُعرِضٍ","وَوَجَدتُ عَنهُ مَرحَلاً وَمَكانا",56,"ن",2,0],["أَنصابِ عَمرَةَ وَالمَطِيُّ كَأَنَّها","قِطَعُ القَطا صَدَرَت عَنِ الأَجبابِ",57,"ب",1,0],["أَنصَفْتَ دينَ النّورِ فانْتبَهَتْ له","أحلامُ قومٍ في الظّلامِ نيامِ",58,"م",1,0],["أنصارُ دينِ الله حول نَبيِّهِ","وصلوا بيَثربَ حَبْلَهُ المصروما",59,"م",2,0],["أَنْصَفْتِ دينَ اللهِ مِن أعدائِه","وهَزَمْتِ دِينَ الكُفْرِ والإِلحادِ",60,"د",1,0],["إن صال منهم في الكريهةِ مُقدِمٌ","صالَ الزُّبَيرُ وأقدم المقدادُ",61,"د",1,0],["أنصفتَ قومَكَ والمظالمُ وُقَّعٌ","بِكَ لا تُغيِّرُ بعد حالٍ حالا",62,"ل",2,0],["أنصت لتسمعَ ما ضمَّت جَوانِحُها","إِنّي لَأَسمَعُ فيها الحُزنَ يَصطَخِبُ",63,"ب",1,0],["أَنصِفي الظالِمينَ يا دَولَةَ الفا","روقِ مِنّا وَعَلِّمي الجُهّالا",64,"ل",2,0],["أَنَصدَعُ رُكنَ الدَهرِ مِن بَعدِ ما رَسا","وَقَرَّت أَواسيهِ بِنا وَالقَوائِمُ",65,"م",1,0],["أنصارُهُ في الحادِثَاتِ إذا طَغَتْ","وجنودُهُ في الحربِ سَاعَةَ تَعصِفُ",66,"ف",1,0],["انصروا اللَّهَ وصُونُوا دِينَهُ","إنّ خيرَ الدّينِ دِينُ المسلمِ",67,"م",1,0],["أنصتي فالليلُ مُصغٍ أنصتي","وَقَع الخطبُ فماذا تصنعين",68,"ن",1,0],["إنْ صالَ كانَ اللَّيْثُ منهُ شَعْرَةً","أَوْ جادَ كانَ البحْرُ منه أُنْمُلَهْ",69,"ل",2,0],["أَنصَفتُمونا فَعابوا حُكمَكُم حَسَداً","وَاللَهُ يَعصِمُكُم مِن غِلِّ حُسّادِ",70,"د",1,0],["إِن صَحَّ تَعذيبُ رَمسٍ مَن يَحُلُّ بِهِ","فَجَنِّبانِيَ مَلحوداً وَمَضروحا",71,"ح",2,0],["إِن صَحَّ لي أَنَّني سَعيدُ","فَلَيتَني ضَمَّني صَعيدُ",72,"د",1,1],["إِن صَحَّ جِسمٌ فَإِنَّ الدينَ مُنتَكِسٌ","تَظُنُّهُ كُلَّ حينٍ مُدنَفاً هَجَرا",73,"ر",2,0],["إِن صُمتَ عَن مَأكَلِ العادي وَمَشرَبِهِ","فَلا تُحاوِل عَلى الأَعراضِ إِفطارا",74,"ر",2,0],["إِن صادَفَت أَرضاً أَرَتكَ خُمودَها","أَو وافَقَت أُكُلاً أَرَتكَ مَنارَها",75,"ر",3,0],["إِن صَحَ عَقلُكَ فَالتَفَرُّدُ نِعمَةٌ","وَنَوى الأَوانِسِ غايَةُ الإيناسِ",76,"س",1,0],["اِنصَح فَإِنَّ النُصحَ لِلمَرءِ مِث","لُ الغَيثِ أَروى بِوابِلٍ وَبَغَش",77,"ش",1,1],["أَنُصفِقُ أَن تُغَيِّرَنا اللَيالي","وَيُسمَعُ مِن مَزاهِرِنا اِصطِفاقُ",78,"ق",1,0],["إِن صَحَّ قَولُكُما فَلَستُ بِخاسِرٍ","أَو صَحَّ قَولي فَالخُسارُ عَلَيكُما",79,"م",2,0],["أَنصَفَ مَولانا وَكُلُّ اِمرِئٍ","يَظلِمُ وَالظُلمُ مِنَ اللُومِ",80,"م",1,0],["إنْ صالَ صِلُّ عِذَارَيْهِ فلا حَرَجٌ","أنْ يجْنِ لَسْعاً وأني أجتَني لَعَسَا",81,"س",2,0],["إن صدقت كذبها","أَو كذبت صدقها",82,"ق",3,0],["إن صح ما قد شاع يومئذٍ","فلأَنتَ آخر من به نكبوا",83,"ب",3,0],["إن صُدَّ عَن بحر فنار قد بَدَت","أَو صد عَن نار فَلُجٌّ داني",84,"ن",2,0],["إنْ صَعَّدتْ فالجبالُ الشمُّ هاويةٌ","أو عربدت فالصخورُ الصمُّ أشلاءُ",85,"ا",2,0],["إِنَّ صَدرَ السَعيرِ أَحنى عَلَينا","مِن شُلَيرٍ وَأَينَ مِنّا السَعيرُ",86,"ر",1,0],["أَنصَفَت أَهلَ الفَقرِ مِن أَهلِ الغِنى","فَالكُلُّ في حَقِّ الحَياةِ سَواءُ",87,"ا",2,0],["إن صد عني حبيبي","فلست عنه بسالي",88,"ي",1,0],["أَنْصَفْتُمُوهُ بِهَذهِ الذِّكْرى وَمَا","أَحْرَاهُ بِالتخْلِيدِ وَالإِكْبارِ",89,"ر",1,0],["أُنْصُرْ أَبِي وَانْتَقِمْ لِقَوْمِي","وَلاَ تُبِحْ هَذِه الدِّيَارْ",90,"ر",1,0],["إِنْ صُفِّيَ النَّد أَيُهْدَى إِلى","شَمَائِلَ أَذْكَى مِنَ النَّدِّ",91,"د",1,0],["أُنْصِفْت بعْضَ الشَّيءِ بلْ هِي تَوْبة","فِي بدْئِهَا وَلِكُلِّ بَدْءٍ تَالِ",92,"ل",1,0],["أَنْصَفْتَ كُلاًّ بِالثَّنَاءِ","وَمَا ضَنَنْتَ عَلى جَديرِ",93,"ر",1,0],["أَنْصَفْتِ يَا نُورَ الهُدَى وَلِحِكْمَةٍ","أَذَكَيْتِ شُعْلَةَ عَزْمِكِ المُتَوَقِّد",94,"د",1,0],["انصف الليل والأنامْ","كلهم كلهم نيامْ",95,"م",1,0],["إِن صَمَتنا لَم يَدَعنا جودُهُ","وَإِذا لَم يَحسُنِ الصَمتُ فَقُل",96,"ل",1,0],["أنصفتها من معشرٍ مستعجم","الغرب أصبح آخذاً بعنانه",97,"ن",2,0],["إن صانَ ماءَك في حرزٍ بنوك، فكم","فدَّوْهُ من قبلِ هذا بالدم القاني",98,"ن",2,0],["إن صور الأحرار يعلو وإن هُمْ","كمَّمُوا كل ناطقٍ بكمامة",99,"م",2,0],["أنصِتْ إليه إذا المَدَافعُ أَطلَقتْ","تَسْمَعْهُ من أفواههن مُفَسَّرا",100,"ر",2,0],["إنْ صحَّ ظنيِّ، فإن النصرَ عن كثَب","من شعبها. لِمَ لا، والله ناصره؟",101,"ر",2,0],["إِن صَمَّت الآذانُ، لن تَسمعْ سوى","قَصْفِ المدافع منطِقًا معقولا",102,"ل",2,0],["أنصِفْ شكية شاعر قد حَّلقت","بالصبر منه فظائع الأنكاد",103,"د",1,0],["إن صحوتا فأحاديث الوغى","في الحمى الآهل والأرض العراء",104,"ا",2,0],["إن صُمْتَ عن مأكل العاي ومشرَبهِ","، فلا تحاوِلْ، على الأعراضِ، إفطارا",105,"ر",2,0],["إن صال منهم في الكريهة مقدم","صال الزبير وأقدام المقداد",106,"د",1,0]]}