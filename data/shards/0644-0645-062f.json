{"poems":[[72,"هنيئا لأفق الفضل إنك بدره","https://www.aldiwan.net/poem18711.html","الطويل"],[66,"طويل له دون البحور فضائل","https://www.aldiwan.net/poem38472.html","الطويل"],[80,"صفا لي من ورد الشبيبة ما صفا","https://www.aldiwan.net/poem31377.html","الطويل"],[44,"أحسن بأيام العقيق وأطيب","https://www.aldiwan.net/poem30589.html","الكامل"],[183,"لعل زماني بالعذيب يعود","https://www.aldiwan.net/poem14502.html","الطويل"],[362,"خطبن وأيمان الكماة المنابر","https://www.aldiwan.net/poem60906.html","الطويل"],[436,"كذا تتجلى الشمس بعد كسوفها","https://www.aldiwan.net/poem34867.html","الطويل"],[436,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[438,"عذاب الهوى في قلب من رامه عذب","https://www.aldiwan.net/poem14329.html","الطويل"],[456,"شوارد حظ لا يقر نفورها","https://www.aldiwan.net/poem56200.html","الطويل"],[573,"سعودك ردت ما ادعاه المنجم","https://www.aldiwan.net/poem3015.html","الطويل"]],"verses":[["لمدحك يا معنى النسيب تأخرت","قوافي نسيبٍ طالما طار شعره",0,"ر",2,0],["لَمَديدِ الشِعرِ عِندي صِفاتُ","فاعِلاتُن فاعِلُن فاعِلاتُ",1,"ت",1,0],["لمدحك أضحت كلّ فكرةِ شاعرٍ","مصنّفةً منه غريباً مصنفا",2,"ف",2,0],["لِمَدينَةٍ عَجماءَ قَد أَمسى البِلى","فيها خَطيباً بِاللِسانِ المُعرِبِ",3,"ب",1,0],["لمدحِك بين النظم والنثر بهجةٌ","تَجمَّل منها خطبةٌ وقَصيد",4,"د",1,0],["لِمُدْنٍ ذَراها في الرياح لخيلهم","بكَرٍّ وفَرّ بينهنَّ الحوافر",5,"ر",1,0],["لَمَدَّتْ عَلَيْنَا ظِلَّها مِنْ مِهادِها","ونُورَ سَناها مِنْ وَرَاءِ سُجُوفِها",6,"ف",3,0],["لِمَدىً تَنَاهى فِي الغِوَايَةِ فانْتَهى","فِينا إِلَى أَمَدٍ لَهُ وكِتَابِ",7,"ب",1,0],["لمدحي رسول اللَه في كل مشهد","دعاني ورجوى في شفاعته الحب",8,"ب",1,0],["لمدَّ على العلياء منك فنالها","يداً يذرَعُ الرمحَ الطويلَ قصيرُها",9,"ر",3,0],["لمدحك أَخَّرتُ النسيبَ تهيُّباً","وعندُهمُ أَنَّ النَّسيبَ يُقدَّم",10,"م",1,0]]}