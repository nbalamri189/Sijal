{"poems":[[74,"هنيئا لأفق الفضل إنك بدره","https://www.aldiwan.net/poem18711.html","الطويل"],[68,"طويل له دون البحور فضائل","https://www.aldiwan.net/poem38472.html","الطويل"],[82,"صفا لي من ورد الشبيبة ما صفا","https://www.aldiwan.net/poem31377.html","الطويل"],[46,"أحسن بأيام العقيق وأطيب","https://www.aldiwan.net/poem30589.html","الكامل"],[189,"لعل زماني بالعذيب يعود","https://www.aldiwan.net/poem14502.html","الطويل"],[369,"خطبن وأيمان الكماة المنابر","https://www.aldiwan.net/poem60906.html","الطويل"],[445,"كذا تتجلى الشمس بعد كسوفها","https://www.aldiwan.net/poem34867.html","الطويل"],[445,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[447,"عذاب الهوى في قلب من رامه عذب","https://www.aldiwan.net/poem14329.html","الطويل"],[463,"شوارد حظ لا يقر نفورها","https://www.aldiwan.net/poem56200.html","الطويل"],[580,"سعودك ردت ما ادعاه المنجم","https://www.aldiwan.net/poem3015.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138353",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122550","الوافر"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70672","المضارع"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67827","الطويل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78030","الطويل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137931",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93798","الرمل"],[2881,"","https://poetry.dctabudhabi.ae/diwan/poem/113839","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62796","الوافر"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94442","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120448","الوافر"],[4968,"أمّاه","https://www.poetsgate.com/ViewPoem.aspx?id=206754",""],[5045,"لك الله أيها المغوار","https://www.poetsgate.com/ViewPoem.aspx?id=185178",""],[5561,"آثار مجدك","https://www.poetsgate.com/ViewPoem.aspx?id=192893",""],[5621,"صهوة","https://www.poetsgate.com/ViewPoem.aspx?id=24565",""],[6323,"نفثة عاشق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82171&r=&rc=2",""],[6345,"ألم المسيح ردائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78632&r=&rc=3",""],[6353,"خواطر الوداع الأولى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64578&r=&rc=1",""]],"verses":[["لمدحك يا معنى النسيب تأخرت","قوافي نسيبٍ طالما طار شعره",0,"ر",2,0],["لَمَديدِ الشِعرِ عِندي صِفاتُ","فاعِلاتُن فاعِلُن فاعِلاتُ",1,"ت",1,0],["لمدحك أضحت كلّ فكرةِ شاعرٍ","مصنّفةً منه غريباً مصنفا",2,"ف",2,0],["لِمَدينَةٍ عَجماءَ قَد أَمسى البِلى","فيها خَطيباً بِاللِسانِ المُعرِبِ",3,"ب",1,0],["لمدحِك بين النظم والنثر بهجةٌ","تَجمَّل منها خطبةٌ وقَصيد",4,"د",1,0],["لِمُدْنٍ ذَراها في الرياح لخيلهم","بكَرٍّ وفَرّ بينهنَّ الحوافر",5,"ر",1,0],["لَمَدَّتْ عَلَيْنَا ظِلَّها مِنْ مِهادِها","ونُورَ سَناها مِنْ وَرَاءِ سُجُوفِها",6,"ف",3,0],["لِمَدىً تَنَاهى فِي الغِوَايَةِ فانْتَهى","فِينا إِلَى أَمَدٍ لَهُ وكِتَابِ",7,"ب",1,0],["لمدحي رسول اللَه في كل مشهد","دعاني ورجوى في شفاعته الحب",8,"ب",1,0],["لمدَّ على العلياء منك فنالها","يداً يذرَعُ الرمحَ الطويلَ قصيرُها",9,"ر",3,0],["لمدحك أَخَّرتُ النسيبَ تهيُّباً","وعندُهمُ أَنَّ النَّسيبَ يُقدَّم",10,"م",1,0],["لمدينة الشمس المنيرة قرروا","بتجلة جثمانه ان ينقلوا",11,"ل",3,0],["لَمَدحُكَ في النّفوسِ أشَدُّ حُبا","وأعلَقُ بالقُلُوبش مِن النَّسيب",12,"ب",1,0],["لمدحِ النبي كبِّر","ودعْ مدحَ ذا وذاكا",13,"ك",2,1],["لِمَدْحِ نَبيِّ مَدْحُهُ جَاءَ فِي الذِّكْرِ","لَهُ أُمَّةٌ يَوْمَ الْحِسَابِ رُجُوعُهُمْ",14,"م",1,0],["لِمَدمَعِهِ فَوقَ الحُدودِ سَباحَةُ","جَريحٌ لَهُ في كُل عُضوٍ جِراحَةُ",15,"ه",1,0],["لم دعاها للعود وهي رميم","لو سرى عابد بها لذراها",16,"ا",3,0],["لمدافعَ تقذف من فمها","برقاً يتخللهُ رعدُ",17,"د",1,0],["لمدير الكاس في أدواحها","لم تلح شمس سوى شمس الدنان",18,"ن",1,0],["لمدحك أوقات السعادة أرخت","بدا سعد إبراهيم في ليلة القدر",19,"ر",1,0],["لمدحكَ ما أُهذبُ من لِساني","ونصركَ ما أُثقّفُ من قَناتي",20,"ت",2,0],["لِمَدِّهَا فَعلاءُ أفعِلاَءُ","مُثَلَّثَ العينِ وَفَعللاَءُ",21,"ا",2,0],["لمدرسة المسيحيين نورٌ","ينير سما العقول العبقريَّة",22,"ي",2,1],["لمدحته احب الى من ان","اعاطي الراح من ساق مراض",23,"ض",1,0],["لِمَ دَنَّسُوا أرضِي بمَخْضُوبِ الدِّمَا","لِمَ أجْهَضُوا أحْلاَمَنَا وثَبَاتَنَا",24,"ا",1,0],["لمدة عام حلق ضغننهم في هيبتك والتم","من العالم تحالف شر مترقب متى تهلك",25,"ك",1,0],["لمدائحي إنْ ظلَّ مدحُك مُلزِما","شَفقٌ يُصارِعُ في السماءِ مَدارا",26,"ر",2,0],["لِمُدُنٍ تعدو بي مُهَرْوِلةً","دُروبُها الموحِلاتُ بالزّلَقِ",27,"ق",1,0],["لَمَددتِ كَفَّكِ بِالضِّياءِ يَحثُّني","وَيقُودُني في رِحْلَةِ الأَمجادِ",28,"د",1,0],["لمدبر الأقدار من في علمه","السر في موتي وفي إحيائي",29,"ا",3,0],["لمدى الاحساس بما أحوى","أو شوق أصبح يُختزلُ",30,"ل",1,0]]}