{"poems":[[93,"أطال الليل أم طال المقام","https://www.aldiwan.net/poem62708.html","عموديه"],[159,"وغادة ترفل في الشباب","https://www.aldiwan.net/poem55794.html","الرجز"],[193,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[202,"أقبلت تمشي لنا مشي الحباب","https://www.aldiwan.net/poem51985.html","الرمل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16738","الطويل"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102284","السريع"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65130","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91592","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135496","الرجز"]],"verses":[["كَذكَ الهَمُّ أَعسَرُ ما تَراهُ","إِذا سَكَتَ الدُجى وَغَفى الأَنامُ",0,"م",1,0],["كَذِكْرِكَ المظلم في الكتابِ","يا واحِد العُجْب بلا إعجابِ",1,"ب",1,0],["كَذِكرهِ الخلّاقَ والمَعادا","وَمدحهِ النبيَّ والأولادا",2,"د",2,0],["كذُكاءِ الدَّجنِ مهما هَطَلَتْ","عَبْرَةُ المُزْنِ توارتْ بالحِجابِ",3,"ب",1,0],["كَذِكرى الحِمى وَالحَيِّ في مَنعَجِ اللَوى","وَذِكرُ الصِبا وَالرَأسُ أَخلَسُ أَشيَبُ",4,"ب",1,0],["كذكرنا العهد ولم ننسه","فيوجب النسيان أن يذكرا",5,"ر",2,0],["كذك كلُّ غريب الدّار مثلي لا","أهلٌ لديه ولا دارٌ كمن خملا",6,"ا",1,0],["كذُكاءَ من ياقوتةٍ في دارةٍ","من لؤلؤٍ بِسَما زُمرَّد أَزهر",7,"ر",1,0],["كذكر ذي الجنان في دار السلامْ","صلِّ على محمدٍ مع السلام",8,"م",1,0]]}