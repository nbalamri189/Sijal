wPoem.aspx?id=215382",""],[5966,"هذا المصيف","https://www.poetsgate.com/ViewPoem.aspx?id=158863",""],[6019,"رقصةٌ بفتنةِ الإشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=137042",""],[6024,"الإنبيق","https://www.poetsgate.com/ViewPoem.aspx?id=186350",""],[6093,"أنَسيتَ عهداً في الغرام جميلا","https://www.poetsgate.com/ViewPoem.aspx?id=176446",""],[6093,"لولا المعلم","https://www.poetsgate.com/ViewPoem.aspx?id=191822",""],[6093,"سمع الوطن وبصره","https://www.poetsgate.com/ViewPoem.aspx?id=200187",""],[6102,"لحظة وداع","https://www.poetsgate.com/ViewPoem.aspx?id=184862",""],[520,"ثغر الهدى متبلج بسام","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577634",""],[520,"العلم مذ كان محتاج الى العلم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577651",""],[242,"أملى الهنا والسعد ردد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563696",""],[6160,"أَجنِحَةُ الضَّوء ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87084&r=&rc=1",""],[6167,"هذا المساء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85537&r=&rc=20",""],[6212,"مُكَاشَفَاتٌ أَخِيْرَةٌ في مَهَبِّ اللَّيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1623&r=&rc=4",""],[6264,"مولد النور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79129&r=&rc=37",""]],"verses":[["هذا المَديحُ الَّذي ما شانَهُ خَلَلٌ","كَلّا وَلا شابَهُ في مَجدِكُم كَذِبُ",0,"ب",1,0],["هَذَا المَعَاشُ وَإِنَّهُ غُنْمٌ لِمَنْ","يَهْوَى الحَيَاةَ خَلَتْ مِنَ الأَدْرَانِ",1,"ن",1,0],["هذا المؤيد صان الله دولته","قلْ في مناقبه الحسنى ورد وزد",2,"د",1,0],["هَذا المَصيرُ أَكانَ طولَ سَلامَةٍ","أَم لَم يَكُن إِلّا قَليلَ بَقاءِ",3,"ا",2,0],["هَذا المُقامُ عَرَفتُهُ","وَسَبَقتُ فيهِ القائِلين",4,"ن",1,0],["هَذا المُعَدُّ لِرَيبِ الدَهرِ مُنصَلِتاً","أَعَدَّ هَذا لِرَأسِ الفارِسِ البَطَلِ",5,"ل",1,0],["هَذا المُغيريُّ الَّذي كُنّا بِهِ","نَهذي وَرَبِّ البَيتِ يا أَترابي",6,"ب",2,0],["هَذا المَقامُ فَدَيتُكُنَّ مُشَهِّرٌ","فَاِحذَرنَ قَولَ الكاشِحِ المُرتابِ",6,"ب",1,0],["هذا المُعِزُّ وسيْفُ اللّهِ في يَدِهِ","فهل لأعْدائِهِ باللّهِ من قِبَل",7,"ل",1,0],["هذا المُعِزُّ ابنُ النبيِّ المُصْطفَى","سَيذُبُّ عن حَرَمِ النبيِّ المُصْطفى",8,"ف",2,0],["هذا المزمجرُ لست أنكرُ صوتهُ","إنّ الوضوحَ يشيع في نبراتهِ",9,"ه",1,0],["هذا المآبُ المُرجَّى شُقَّةٌ قصُرَتْ","وغُربةٌ عن ثَراكِ الطُّهْرِ لم تطُلِ",10,"ل",1,0],["هذا المدلّ على الدّنيا بصولته","ما صال إلاّ على قومي ولا حشدا",11,"د",2,0],["هَذَا المَقَامُ وَمِصْرُ نَادِبَةٌ لَهُ","أَحْرَى مَقَامٍ أَنْ يَكُونَ جَلِيلاَ",12,"ل",2,0],["هذا المليكُ العبقريُّ عَنَتْ له","أُمَمُ ودانتْ صَوْلَةُ الأبطال",13,"ل",1,0],["هذا المشرَّدُ كان مَأمَلَ طالبٍ","ومناخَ أطلاح وخدنَ عوالي",14,"ل",2,0],["هذا المَعينُ ، وقد أسلتَ نَميرَهُ","وجهُ الحياةِ به سيُصبْحُ عاشبا",15,"ب",2,0],["هذا المشيِّدُ للعُمران ريِّقَه","في الرافدين به العُمرانُ يندثر",16,"ر",1,0],["هذا المسلسل زبدة القوم الاولى","بحر العناية وافر النفحات",17,"ت",1,0],["هذا المرام الذي قد كنت تأمله","فطب مآلا بلقياه وطب حالا",18,"ل",2,0],["هذا المهابُ إن نهى","هذا المطاع إن أمر",19,"ر",1,0],["هَذا المقام الَّذي نَأوي إَلَيهِ وَمَن","أَحشائِهِ في مَقامِ الحَشرِ نَرتَجعُ",20,"ع",1,0],["هذا المورث قال لي","قولا بغير لسانه",21,"ن",2,1],["هَذَا الْمُلاَعِبُ لِلأَسِ","نَّةِ إِذْ جَبِينُ الْحَرْبِ أَسْوَدْ",22,"د",1,0],["هَذَا الْمُصَادِمُ وَالْمُقَا","وِمُ وَالْمُسَدَّدُ وَالْمُؤَيَّدْ",22,"د",1,0],["هَذَا الْمُضَارِبُ وَالطَّا","عِنُ فَضْلُ هَذَا لَيْسَ يُجْحَدْ",22,"د",1,0],["هَذَا الْمُقَوَّمُ رُمْحَهُ","فِي ثَغْرَةِ الْبَطَلِ الْمُزَرَّدْ",22,"د",1,0],["هَذَا الْمُبَدِّدُ مَنْ تَأَ","لَّبَ فِي الْغَوَايَةِ إِذْ تَوَدَّدْ",22,"د",1,0],["هَذَا الْمُرَفِّعُ كُلَّ أَرْ","وَعَ وَالْمُعَفِّرُ كُلَّ أَوْغَدْ",22,"د",1,0],["هَذَا الْمُنَظِّمُ فَضْلُهُ","عِقْدَ الْمَعَالِي اللَّذْ تَبَدَّدْ",22,"د",1,0],["هذا المقام مقام إبراهيم مَن","فيه غدا قلب المحبّ حطيما",23,"م",2,0],["هذا المُحيَّا عليهِ أشرَقَ النورُ","فنوَّرَ الزَّهرُ فيهِ وهو ممطورُ",24,"ر",1,1],["هَذا المصلَّى وذا النخيلُ","يا حبَّذا ظلُّه الظَّليلُ",25,"ل",1,1],["هَذا المصلّى وَالبَقيعُ الَّذي","طابَ به المنهلُ والمورِدُ",26,"د",1,0],["هذا المديح ُمن الأشواقِ منبعه","وفي الجوارح فاقبلْ حينما أفدُ",27,"د",1,0],["هَذا المَصيرُ وكلّ نفسٍ ذائقه","موتاً فَفائزةٌ غَداً أَو بائِقَه",28,"ق",2,1],["هذا المجدد قد أعيد بحزمه","للدين والدنيا سنى وسناءُ",29,"ا",2,0],["هذا المؤيد في جنود مهابة","عمرية راياتها الآراءُ",29,"ا",2,0],["هَذا المُحِبُّ المُخِبُّ السَيرِ نَحوَكُمُ","تُراهُ يَرجِعُ عَنكُم خائِبَ الخَبَبِ",30,"ب",1,0],["هَذا المُسامِرُ مِن نُجو","مِ اللَيلِ سارٍ أَم مُسَمَّر",31,"ر",1,0],["هذا المسيح وقد بدا من قبره","يستوقف الأبصارَ عند المُشرِف",32,"ف",1,0],["هذا المنادى كل يوم صارخا","هيا ارحلوا هيا ارحلوا هيا ارحلوا",33,"ل",3,0],["هذا المحال كمثل صبري عندكم","إن الجميع كطفرة النظام",34,"م",1,0],["هذا المشير أعزّ الله دولته","أبانَ فضلك إعلاناً لكلّ غبي",35,"ب",2,0],["هذا المنى هذا الغنى هذا التقى","هذا الهُدى هذا العُلى والمفخر",36,"ر",1,0],["هذا المعظم لا خلق يماثلهُ","من البرايا فمن عاد بن شدّاد",37,"د",1,0],["هذا المحصب يا قلوصي من منى","قدح المناخ به وقد نلت المنى",38,"ن",2,1],["هذا المشفع يوماً لا شفيع به","أب لابنٍ ولا إبنٌ شفيع أب",39,"ب",1,0],["هذا الممات فهل ليوم لقائكم","بعث يزيل الكفر والإلحادا",40,"د",2,0],["هذا المسجي نعم هذا شقيق أبي","هذا الشبيه به في الموت ثانيه",41,"ي",2,0],["هذا المشاهد والذي في علمه","خفيت حقيقته عن الحكماء",42,"ا",2,0],["هذا المثال المرتسم","للطاهر الآغا الأشم",43,"م",1,1],["هذا المحبّذ صهيونية ملئت","حمقا وذلك بالتجنيس مفتون",44,"ن",1,0],["هذا المحسين بيننا","في بيت أهليه البديع",45,"ع",1,0],["هذا المُجَرَّبُ تِرياقُ القُلوبِ فخُذْ","منه الأَماني ودعْ زعمَ التَّجاريبِ",46,"ب",1,0],["هذا المُحَجَّبُ في الأَقْطابِ سيِّدِهُمْ","في كلِّ بابٍ بإِطراقٍ وتَأْويبِ",46,"ب",1,0],["هذا المقام الذي لولا كرامته","ما أشرفت في السماء السبعة الشهب",47,"ب",1,0],["هذا المقام الذي لولا أوامره","لم يشرف البيت والأستار والحجب",47,"ب",1,0],["هذا المظفر قبلة الكرم التي","نصبت لشد على وسد مفاقر",48,"ر",1,0],["هذا المقام العاضدي مخلد","أبداً عليك ودائم ما داموا",49,"م",3,0],["هذا المقال عليه قبح عقيدة","عند المحقق ظاهر البطلان",50,"ن",1,0],["هذا المدام وهذا الكاس ممتلئٌ","من المدام إلى أطراف أطواقي",51,"ق",2,0],["هذا المليح وهذه أوصافه","كم أطلعت منه لقلبي كوكبا",52,"ب",2,0],["هذا المَقامُ لشيخِنا المُفتي غدا","بينَ البُروجِ يلوحُ مثلَ الفَرقَدِ",53,"د",1,1],["هذا المُقلَّدُ بالحسامِ وعَزْمُهُ","أمضى منَ السَّيفِ الصَّقيلِ وأَقطَعُ",54,"ع",1,0],["هَذا المُصابُ الَّذي كُنّا نُحاذِرهُ","نَظَلُّ نَلبِسُ مِنهُ جِلدَ مَرعوبِ",55,"ب",1,0],["هذا المحرّم قَد لاحَت لوائحهُ","فَلا يَكُن لك غير النوح من شغلِ",56,"ل",1,0],["هذا المعد له من حر غايته","في كل جارحة تاجاً وإيوانا",57,"ن",2,0],["هذا الموكل منا يومنا وغداً","بما يكون من العقبى وما كانا",57,"ن",2,0],["هذا المقدس فينا والمتاح له","فك العشيرة أرواحاً وأبدانا",57,"ن",2,0],["هذا المُلامُ بموطِنٍ","أدمى ملامحَهُ الجُذامُ",58,"م",1,0],["هَذا المُصاب الَّذي عم الأنام أَسى","أَمسَت به أَنفس الأَمجاد في شرق",59,"ق",1,0],["هذا المنى والغنى هذا الذي ظهرت","منه المعارف يبديها لنا العمل",60,"ل",1,0],["هذا المقام وبيت ربك حاضرٌ","والحجر والحجَرُ المكرم مربع",61,"ع",1,0],["هذا المقام الذي خير البقاع به","وخير عيشٍ وخير العرب والعَجَمِ",62,"م",1,0],["هَذا المقامُ وَحجر عِنده حجر","فيهِ يَطيبُ لِخلقِ اللَهِ تَقبيلُ",63,"ل",1,0],["هذا المسير مسير السادة الكبرا","أخوه قط لبحر الشوق ما عبرا",64,"ر",2,1],["هذا المنوَّهُ في المعالي","باسمه هذا المنوَّه",65,"و",2,0],["هذا المحرّم قد وافتك صارخةً","ممَّا استحلُّوا به أيامهُ الحُرمُ",66,"م",1,0],["هذا الموفَّقُ في علياء سُؤدُدِهِ","يذْكو كبدرِ الدجى في الغَيهَب الداجي",67,"ج",2,0],["هذا المحرم جاء يا حرم التقى","يبغي رضاك ويطلب الإمناحا",68,"ح",2,0],["هذا المقام لإبراهيم بانيه","اللَه يحفظه من عين شانيه",69,"ي",2,1],["هذا المصاب فيا له من فادح","أبكي النبي محمداً والآلا",70,"ل",2,0],["هذا المسيء الى متى","تلك القبائح لاقطا",71,"ط",2,0],["هذا المؤذن قد بدا بأذانه","يرجو بذاك العفو من رحمانه",72,"ه",1,1],["هذَا المُصَفَّى مِن لُؤَىِّ وغالِبٍ","هذَا الَّذِى جازَ العُلاَ والرَّفرَفا",73,"ف",2,0],["هذا المكان الأعظمُ الأسمى الذي","قد كان فيه المصطفى يَتَغوَّرُ",74,"ر",1,0],["هذا المقام الذي أبغيه فزتُ به","وإنني فيه محفوظٌ ومعصوم",75,"م",1,0],["هذا المقام وهذه أس