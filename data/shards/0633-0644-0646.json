{"poems":[[53,"لواعج الشوق تخطيهم وتصميني","https://www.aldiwan.net/poem29744.html","البسيط"],[77,"إن كنت تنكر ما تجن ضلوعي","https://www.aldiwan.net/poem35994.html","الكامل"],[77,"أبدى لداعي الفوز وجه منيب","https://www.aldiwan.net/poem36767.html","الكامل"],[86,"حبس اللسان وأطلق الدمعا","https://www.aldiwan.net/poem10350.html","الكامل"],[73,"أنى أضيع عهدك","https://www.aldiwan.net/poem11869.html","مجزوء الكامل"],[51,"يا سائلي بأميرنا","https://www.aldiwan.net/poem10871.html","مجزوء الكامل"],[51,"سلني قد مللت طول الغرام","https://www.aldiwan.net/poem66361.html","الخفيف"],[70,"ما للعذول وما ليه","https://www.aldiwan.net/poem42394.html","مجزوء الكامل"],[70,"ركد الرجاء فما يهزك مأرب","https://www.aldiwan.net/poem43107.html","الكامل"],[80,"أإن بكت ورقاء في غضن بان","https://www.aldiwan.net/poem31262.html","السريع"],[44,"ما لي بعادية الأيام من قبل","https://www.aldiwan.net/poem30374.html","البسيط"],[105,"لمن الرواسم يرتمين صواديا","https://www.aldiwan.net/poem43382.html","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[77,"إن كنت تنكر ما تكن ضلوعي","https://www.poetsgate.com/ViewPoem.aspx?id=34176",""],[90,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[120,"أهواك والحب داء أيما داء","https://www.aldiwan.net/poem49314.html","البسيط"],[185,"مقل لأفئدة القلوب أواخي","https://www.aldiwan.net/poem14144.html","الكامل"],[186,"سلني عن الدهر وأخباره","https://www.aldiwan.net/poem43830.html","السريع"],[198,"زارتك من رقبة الواشي على فرق","https://www.aldiwan.net/poem51917.html","البسيط"],[271,"بمحمد خطر المحامد يعظم","https://www.aldiwan.net/poem52125.html","الكامل"],[403,"وافت على وفق احتياجي","https://www.aldiwan.net/poem34096.html","مجزوء الكامل"],[432,"سلني أجبك فإني عندي الخبر","https://www.aldiwan.net/poem12497.html","البسيط"],[432,"سلني عن الحب يا من ليس يعرفه","https://www.aldiwan.net/poem12598.html","البسيط"],[441,"حتى متى أنا بين الجد واللعب","https://www.aldiwan.net/poem14347.html","البسيط"],[458,"دمعي وإن كان دما سائلا","https://www.aldiwan.net/poem56004.html","السريع"],[458,"حملت ركاب الغرب شمس شروق","https://www.aldiwan.net/poem56100.html","الكامل"],[458,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[458,"أصبت لو أحمدت أن أصيبا","https://www.aldiwan.net/poem56297.html","الرجز"],[479,"يهتز صوتهما الرنين","https://www.aldiwan.net/poem37615.html","مجزوء الكامل"],[515,"ما عن هوى الرشأ العذري أعذار","https://www.aldiwan.net/poem12136.html","البسيط"],[529,"ما للطعام وللثياب أتيته","https://www.aldiwan.net/poem37126.html","الكامل"],[551,"صارمت بعدك أشجاني فلا تلم","https://www.aldiwan.net/poem47218.html","البسيط"],[558,"أنا صاحب الأمر الإلهي","https://www.aldiwan.net/poem33662.html","مجزوء الكامل"],[575,"قد كان ما كان من جهلي وطغياني","https://www.aldiwan.net/poem2755.html","البسيط"],[575,"سلني بالله عن فلان","https://www.aldiwan.net/poem2845.html","مخلع البسيط"],[575,"أنا أمير العشاق","https://www.aldiwan.net/poem2905.html","مجزوء الرجز"]],"verses":[["سَلني عَنِ الوَجدِ إِنّي كُلُّ شارِقَةٍ","يُريشُني الوَجدُ وَالأَيّامُ تَبريني",0,"ي",1,0],["سلْ نحْوَ سائِلِ عَبْرَتي أو زَفْرَتي","يأتيكَ بالمَخْفوضِ والمَرْفوعِ",1,"ع",1,0],["سَلْنِي عَنِ الدَّهْرِ الْخَؤونِ وَأَهْلِهِ","تَسَل الْمُهَلَّب عَنْ حُرُوب شَبِيبِ",2,"ب",1,0],["سَلني فَإِنّي مِن صَنائِعِهِ","وَسَلِ المَعارِفَ كَم جَنَت نَفعا",3,"ع",2,0],["سَلني حَياتي أَهَبها","فَلَستُ أَملِكُ رَدَّك",4,"ك",1,0],["سلْني فإنِّي عالمٌ","بأموره عدْلُ الشهادَهْ",5,"د",2,0],["سَلِّني قد مللْتُ طولَ الغرامِ","واحتمالِ الأحزانِ والأسقامِ",6,"م",1,1],["سَلني أُجِبكَ بِما يَسُرُّ","كَ ذِكرُهُ مِن حالِيَه",7,"ي",2,0],["سَلني بِأَدواءِ الشُعوبِ فَإِنَّني","طَبٌّ بِأَدواءِ الشُعوبِ مُجَرِّبُ",8,"ب",1,0],["سلني عن الدّنْيا فعندي لها","في كلّ فنّ خَبَرٌ أو عيَان",9,"ن",1,0],["سَلني عَنِ الدينِ وَالدُنيا أُجِبكَ وَعَن","أَبي سَعيدٍ وَفِقدَيهِ فَلا تَسَلِ",10,"ل",1,0],["سَلني أُنَبِّئكَ اليَقينَ فَإِنَّ لي","عِلماً بِما تُخفي السَرائِرُ وافِيا",11,"ي",2,0],["سِلْنَ من خَدِّ كلِّ سيفٍ نُضارا","بعد ما حَطَّم الحديدُ الحديدا",12,"د",2,0],["سل نحر سائل عبرتي أو زفرتي","يأتك بالمخفوض والمرفوع",13,"ع",1,0],["سِلْنَ في الحَقْل مثلَ رُوحٍ لجسمٍ","وتمدَّدْنَ فيهِ كالأعصاب",14,"ب",1,0],["سلني إذا شئت عن ماضيك مبتدئاً","أرو قلبك منه أي أرواء",15,"ا",2,0],["سَلْنِي أُفِدْك عن الهوى بروايتي","ماذا مَضَى لي ليس عن أَشْياخي",16,"ي",1,0],["سلني عن الدهر وأخباره","وما طواه الدهر من مكره",17,"ر",2,1],["سَلني أُخَبِّرْك عنها إنَّ مَوْردَها","لم يصفُ للحرِّ إلا عادَ ذا رَنَقِ",18,"ق",1,0],["سلني بحقك ما أَحق وَأَوجبا","بخلاف من يعطى سواك وَيحرم",19,"م",1,0],["سلني أُبَيِّنْ حالهم","من دون عَيٍّ وارتياج",20,"ج",1,0],["سَلْني أُجبْكَ فإني عنديَ الخبَرُ","ما أكبرَ الذّنْبَ إن قالوا هو الكِبَرُ",21,"ر",1,1],["سلني عن الحب يا من ليس يعرفُهُ","ما أطيبَ الحُبَّ لولا أنه نكِدُ",22,"د",1,1],["سلني فإني بهذا الدهر مختبر","وعالم ببنيه الكل غير غبي",23,"ي",1,0],["سل نافثَ السحر بنجدٍ متى","حُوّل نجدٌ بعدنا بابلا",24,"ل",2,0],["سلني بهم فلقد حلبت أمورَهم","شطرين من محضٍ ومن ممذوقِ",25,"ق",1,0],["سل ناخساً إبلي بأي","يِ تدنُّسٍ عَوّارُها",26,"ر",3,0],["سَلْني به وقِسْ عليَّ معَهُ","فقد قَتلتُ أهلَه تجريبا",27,"ب",2,0],["سلنا فنحن شروحها","سلنا فنحن لها متون",28,"ن",1,0],["سلني به فلساني فيه يحفظ ما","أقول وهي تواريخ وأخبار",29,"ر",1,0],["سَلْ نَجْدَها وسَلِ التَّهائِمَ كُلَّها","وسَلِ الأقَاصِي في الدُّنا والدّاني",30,"ي",1,0],["سَلني عن الزّمن المَعسولِ منهلهُ","فربَّ قولٍ جَلا عن ناظر الفهمِ",31,"م",1,0],["سل نغمة الطنبور عن","أمري الذي في تلك باهي",32,"ا",3,0],["سَلني عن الدَّهر لا تَسْأَلْ سَوَايَ به","ولا تسلْنيَ عن همِّي وأَحْزَاني",33,"ي",1,0],["سَلِّني بالله عن فلانِ","فقد تسلَّيت عَنْ فُلانَهْ",34,"ن",2,1],["سَلْنيَ عن مِعْصَمِهِ","ولا تَسَلْ عَنِ السَّاقْ",35,"ق",1,0]]}