{"poems":[[55,"لواعج الشوق تخطيهم وتصميني","https://www.aldiwan.net/poem29744.html","البسيط"],[79,"إن كنت تنكر ما تجن ضلوعي","https://www.aldiwan.net/poem35994.html","الكامل"],[79,"أبدى لداعي الفوز وجه منيب","https://www.aldiwan.net/poem36767.html","الكامل"],[88,"حبس اللسان وأطلق الدمعا","https://www.aldiwan.net/poem10350.html","الكامل"],[75,"أنى أضيع عهدك","https://www.aldiwan.net/poem11869.html","مجزوء الكامل"],[53,"يا سائلي بأميرنا","https://www.aldiwan.net/poem10871.html","مجزوء الكامل"],[53,"سلني قد مللت طول الغرام","https://www.aldiwan.net/poem66361.html","الخفيف"],[72,"ما للعذول وما ليه","https://www.aldiwan.net/poem42394.html","مجزوء الكامل"],[72,"ركد الرجاء فما يهزك مأرب","https://www.aldiwan.net/poem43107.html","الكامل"],[82,"أإن بكت ورقاء في غضن بان","https://www.aldiwan.net/poem31262.html","السريع"],[46,"ما لي بعادية الأيام من قبل","https://www.aldiwan.net/poem30374.html","البسيط"],[107,"لمن الرواسم يرتمين صواديا","https://www.aldiwan.net/poem43382.html","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[79,"إن كنت تنكر ما تكن ضلوعي","https://www.poetsgate.com/ViewPoem.aspx?id=34176",""],[92,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[124,"أهواك والحب داء أيما داء","https://www.aldiwan.net/poem49314.html","البسيط"],[189,"مقل لأفئدة القلوب أواخي","https://www.aldiwan.net/poem14144.html","الكامل"],[190,"سلني عن الدهر وأخباره","https://www.aldiwan.net/poem43830.html","السريع"],[202,"زارتك من رقبة الواشي على فرق","https://www.aldiwan.net/poem51917.html","البسيط"],[276,"بمحمد خطر المحامد يعظم","https://www.aldiwan.net/poem52125.html","الكامل"],[409,"وافت على وفق احتياجي","https://www.aldiwan.net/poem34096.html","مجزوء الكامل"],[438,"سلني أجبك فإني عندي الخبر","https://www.aldiwan.net/poem12497.html","البسيط"],[438,"سلني عن الحب يا من ليس يعرفه","https://www.aldiwan.net/poem12598.html","البسيط"],[447,"حتى متى أنا بين الجد واللعب","https://www.aldiwan.net/poem14347.html","البسيط"],[463,"دمعي وإن كان دما سائلا","https://www.aldiwan.net/poem56004.html","السريع"],[463,"حملت ركاب الغرب شمس شروق","https://www.aldiwan.net/poem56100.html","الكامل"],[463,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[463,"أصبت لو أحمدت أن أصيبا","https://www.aldiwan.net/poem56297.html","الرجز"],[484,"يهتز صوتهما الرنين","https://www.aldiwan.net/poem37615.html","مجزوء الكامل"],[520,"ما عن هوى الرشأ العذري أعذار","https://www.aldiwan.net/poem12136.html","البسيط"],[534,"ما للطعام وللثياب أتيته","https://www.aldiwan.net/poem37126.html","الكامل"],[556,"صارمت بعدك أشجاني فلا تلم","https://www.aldiwan.net/poem47218.html","البسيط"],[563,"أنا صاحب الأمر الإلهي","https://www.aldiwan.net/poem33662.html","مجزوء الكامل"],[580,"قد كان ما كان من جهلي وطغياني","https://www.aldiwan.net/poem2755.html","البسيط"],[580,"سلني بالله عن فلان","https://www.aldiwan.net/poem2845.html","مخلع البسيط"],[580,"أنا أمير العشاق","https://www.aldiwan.net/poem2905.html","مجزوء الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122544","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87063","البسيط"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39076","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64005","السريع"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70859","السريع"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120096","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96619","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96604","الكامل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61018","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56285","الكامل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115840","الكامل"],[1483,"","https://poetry.dctabudhabi.ae/diwan/poem/130673","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79987","الكامل"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45373","البسيط"],[1692,"","https://poetry.dctabudhabi.ae/diwan/poem/101569","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101049","البسيط"],[1910,"","https://poetry.dctabudhabi.ae/diwan/poem/116543","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69422","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69404","السريع"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202132","الخفيف"],[2273,"","https://poetry.dctabudhabi.ae/diwan/poem/143411","البسيط"],[2539,"","https://poetry.dctabudhabi.ae/diwan/poem/113619","المديد"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94306","البسيط"],[3655,"","https://poetry.dctabudhabi.ae/diwan/poem/205640","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91546","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205735","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85151","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59480","الرمل"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105509","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73406","الخفيف"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117296","الكامل"],[4755,"فِي البَالِ مَا لا يَنْحَكِيْ يَا (فِيْسُ)","https://www.poetsgate.com/ViewPoem.aspx?id=184672",""],[4856,"يا أيها الساري","https://www.poetsgate.com/ViewPoem.aspx?id=36273",""],[4888,"مدرسة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=207751",""],[5038,"جيش العراق","https://www.poetsgate.com/ViewPoem.aspx?id=195220",""],[5131,"يا ليلُ مدَّ من الظلامِ سدولا","https://www.poetsgate.com/ViewPoem.aspx?id=175520",""],[5213,"سلني عن الدهر العسير","https://www.poetsgate.com/ViewPoem.aspx?id=170464",""],[5324,"سلني أجبك عن الحياة..","https://www.poetsgate.com/ViewPoem.aspx?id=212810",""],[5582,"شاقَتْكَ هِنْدٌ وَأَمْسَى الحَبْلُ مُنْصَرِمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63568",""],[5847,"المحبةُ","https://www.poetsgate.com/ViewPoem.aspx?id=209058",""],[520,"ما عن هوى الرشإ العذري اعذار","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577540",""],[463,"لمنَ الطلولُ تراقصتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60065&r=&rc=121",""]],"verses":[["سَلني عَنِ الوَجدِ إِنّي كُلُّ شارِقَةٍ","يُريشُني الوَجدُ وَالأَيّامُ تَبريني",0,"ن",2,0],["سلْ نحْوَ سائِلِ عَبْرَتي أو زَفْرَتي","يأتيكَ بالمَخْفوضِ والمَرْفوعِ",1,"ع",1,0],["سَلْنِي عَنِ الدَّهْرِ الْخَؤونِ وَأَهْلِهِ","تَسَل الْمُهَلَّب عَنْ حُرُوب شَبِيبِ",2,"ب",1,0],["سَلني فَإِنّي مِن صَنائِعِهِ","وَسَلِ المَعارِفَ كَم جَنَت نَفعا",3,"ع",2,0],["سَلني حَياتي أَهَبها","فَلَستُ أَملِكُ رَدَّك",4,"ك",1,0],["سلْني فإنِّي عالمٌ","بأموره عدْلُ الشهادَهْ",5,"د",2,0],["سَلِّني قد مللْتُ طولَ الغرامِ","واحتمالِ الأحزانِ والأسقامِ",6,"م",1,1],["سَلني أُجِبكَ بِما يَسُرُّ","كَ ذِكرُهُ مِن حالِيَه",7,"ي",2,0],["سَلني بِأَدواءِ الشُعوبِ فَإِنَّني","طَبٌّ بِأَدواءِ الشُعوبِ مُجَرِّبُ",8,"ب",1,0],["سلني عن الدّنْيا فعندي لها","في كلّ فنّ خَبَرٌ أو عيَان",9,"ن",1,0],["سَلني عَنِ الدينِ وَالدُنيا أُجِبكَ وَعَن","أَبي سَعيدٍ وَفِقدَيهِ فَلا تَسَلِ",10,"ل",1,0],["سَلني أُنَبِّئكَ اليَقينَ فَإِنَّ لي","عِلماً بِما تُخفي السَرائِرُ وافِيا",11,"ي",2,0],["سِلْنَ من خَدِّ كلِّ سيفٍ نُضارا","بعد ما حَطَّم الحديدُ الحديدا",12,"د",2,0],["سل نحر سائل عبرتي أو زفرتي","يأتك بالمخفوض والمرفوع",13,"ع",1,0],["سِلْنَ في الحَقْل مثلَ رُوحٍ لجسمٍ","وتمدَّدْنَ فيهِ كالأعصاب",14,"ب",1,0],["سلني إذا شئت عن ماضيك مبتدئاً","أرو قلبك منه أي أرواء",15,"ا",2,0],["سَلْنِي أُفِدْك عن الهوى بروايتي","ماذا مَضَى لي ليس عن أَشْياخي",16,"خ",2,0],["سلني عن الدهر وأخباره","وما طواه الدهر من مكره",17,"ر",2,1],["سَلني أُخَبِّرْك عنها إنَّ مَوْردَها","لم يصفُ للحرِّ إلا عادَ ذا رَنَقِ",18,"ق",1,0],["سلني بحقك ما أَحق وَأَوجبا","بخلاف من يعطى سواك وَيحرم",19,"م",1,0],["سلني أُبَيِّنْ حالهم","من دون عَيٍّ وارتياج",20,"ج",1,0],["سَلْني أُجبْكَ فإني عنديَ الخبَرُ","ما أكبرَ الذّنْبَ إن قالوا هو الكِبَرُ",21,"ر",1,1],["سلني عن الحب يا من ليس يعرفُهُ","ما أطيبَ الحُبَّ لولا أنه نكِدُ",22,"د",1,1],["سلني فإني بهذا الدهر مختبر","وعالم ببنيه الكل غير غبي",23,"ب",2,0],["سل نافثَ السحر بنجدٍ متى","حُوّل نجدٌ بعدنا بابلا",24,"ل",2,0],["سلني بهم فلقد حلبت أمورَهم","شطرين من محضٍ ومن ممذوقِ",25,"ق",1,0],["سل ناخساً إبلي بأي","يِ تدنُّسٍ عَوّارُها",26,"ر",3,0],["سَلْني به وقِسْ عليَّ معَهُ","فقد قَتلتُ أهلَه تجريبا",27,"ب",2,0],["سلنا فنحن شروحها","سلنا فنحن لها متون",28,"ن",1,0],["سلني به فلساني فيه يحفظ ما","أقول وهي تواريخ وأخبار",29,"ر",1,0],["سَلْ نَجْدَها وسَلِ التَّهائِمَ كُلَّها","وسَلِ الأقَاصِي في الدُّنا والدّاني",30,"ن",2,0],["سَلني عن الزّمن المَعسولِ منهلهُ","فربَّ قولٍ جَلا عن ناظر الفهمِ",31,"م",1,0],["سل نغمة الطنبور عن","أمري الذي في تلك باهي",32,"ا",3,0],["سَلني عن الدَّهر لا تَسْأَلْ سَوَايَ به","ولا تسلْنيَ عن همِّي وأَحْزَاني",33,"ن",2,0],["سَلِّني بالله عن فلانِ","فقد تسلَّيت عَنْ فُلانَهْ",34,"ن",2,1],["سَلْنيَ عن مِعْصَمِهِ","ولا تَسَلْ عَنِ السَّاقْ",35,"ق",1,0],["سَلني وأبناء الزمانِ فإنَّني","جربتُهم فقتلتُهم تَجريبا",36,"ب",2,0],["سلني عَن الصادق المَنصور إن لَهُ","مناقباً تاهَ في إِحصائِها العُلَما",37,"م",2,0],["سَلْ نَفْحَةَ الخِيريِّ في غَسَقِ الدُّجى","ما بالُهُ لَبِسَ الظَّلامَ رداءَ",38,"ا",2,1],["سَلْ نكبةَ الدهرِ متى تُقْلِعُ","وَدُولَةَ الوصلِ متى تَرْجِعُ",39,"ع",1,1],["سلني وسل غيري فكم عاشقٍ","قتيل ألحاظٍ وطولِ الأنوف",40,"ف",1,0],["سلني فإني بالرجا","لِ إذا أردت الخبر أخبر",41,"ر",1,0],["سَلني وَخُذ رَأيي تجدني صادقاً","في الرأيِ أقصد ما وجدت وأصوبا",42,"ب",2,0],["سَلني عنِ الدنيا تَجدني مخبراً","عَنها فَصيحاً في المَقالةِ خاطِبا",43,"ب",2,0],["سَلني بِهِ فَلَقَد رَأَي","تُ الهَول وَالعَجَب العَجيب",44,"ب",1,0],["سلني فأورثك الشعوب جميعها","إذ أنت في ميراثها أولى ولي",45,"ل",2,0],["سَلنى عسى تُنبيك مُقلتُهُ","مَن ذا أباح للحظها سَلبِى",46,"ب",2,0],["سلني الذي شئت يا ذا الفضل والأدب","فليس غير العلا والمجد من ارب",47,"ب",1,1],["سلني بها فلقد قتلتُ","بخبرتي أنباءها",48,"ا",3,0],["سَلني عَنِ الدَهرِ تَسأَل غَيرَ إِمَّعَةٍ","فَأَلقِ سَمعَكَ وَاِستَجمِع لِإيرادي",49,"د",2,0],["سلني أيا باغي الهوى أخبرك عن","أحوالهِ فأنا به متقدِّم",50,"م",1,0],["سل نسج داود إذ هم يخطرون به","في كل مصطرخ عال ومصطم",51,"م",1,0],["سَلني أقفك على الهوى وشروطهِ","لا عار أن يستسقي الظمآنُ",52,"ن",1,0],["سَلنِي أَبُثُّكَ عَن أَخِي ثِقَةٍ","يَسرِي بِضَوءِ جَبِينِهِ السَفرُ",53,"ر",1,0],["سَلني عَنِ الشِعرِ وَسَلهُم تَجِد","أَكثَرَنا ذا خَجَلٍ وَافتِضاح",54,"ح",1,0],["سلْ نقوشًا بهنَّ زِنْتُ عروشًا","راكبًا من بنات نعشٍ سَناما",55,"م",2,0],["سل نجومًا تخذتهنَّ رُجومًا","أذِنَ اللهُ أن يُصبْنَ اللِّئاما",55,"م",2,0],["سَلْني فعندي من أخباره جُمَلٌ","تُنْسيكَ ما قيلَ في عادٍ وفي إرَمِ",56,"م",1,0],["سل نجوم الأفق عن قلقي","فعسى تنبيك بالخبر",57,"ر",1,0],["سلنى إذا رمت فحصا عن مآثره","مذ كان سيفا على الأعداء مستلا",58,"ل",2,0],["سل نجوم الدجى إذا ما استنارت","ما الذي في وقت الظهيرة تلقى",59,"ق",2,0],["سَلني فَإِني قَد أَقولُ هويتُه","حَقاً وَسَلهُ يَقول قَد يَهواني",60,"ن",2,0],["سلنا بحقك من أين استجدَّ لنا","هذا السرور الذي في القلب ينتشر",61,"ر",1,0],["سلني به فأنا الخبير بحال من","أن ماس يزري بالغصون الميس",62,"س",1,0],["سلْ نبي عَمْروٍ وسائلْ عامراً","وعميراً حين تحمرُّ الحَدقْ",63,"ق",1,0],["سل نجل عينيك كم قد غادرت كبدي","نصباً لأسهم جفن منك منكسر",64,"ر",1,0],["سَل نسيمَ الصَّبا إِذا ريضَ في مِس","كيِّ رَوضِ الحِمىَ الأَريضِ جِماحُه",65,"ح",2,0],["سل ناصعا من مفرقيك تجد به","مهما تسله زاجرا متعنفا",66,"ف",2,0],["سَلْنِيْ عَنِ الحُبِّ القَدِيمِ , ومَا الذِي","أوْدَى بهِ ؟ سُجَّادَةٌ ؟ أمْ كِيْسُ ؟!",67,"س",1,0],["سَلْ نَورساً مِنْ سيلِ يأسي قدْ يَئسْ","كمْ سارقاً في بؤسِ هذا المُفلسِ؟",68,"س",1,0],["سَلْ نظرةً فتّاكةً من لَحْظها","سبقتْ لقلبكَ كلَّ سهمٍ يُرشَقُ",69,"ق",1,0],["سَلْ نَينَوى وَسَلِ الرَّمادي آيَةً","قُرِئَتْ على ذاكَ الْكَفورِ فَدانا",70,"ن",2,0],["سلني عنِ الوطنِ العزيز لو أنني","مازلتُ أدلج في الظلام رحيلا",71,"ل",2,0],["سلني عنِ الحكام كيف تجاهلوا","شعبًا وأصبح حكمهمْ تضليلا",71,"ل",2,0],["سلني عن الأشياخ كيف هوى بهم","طمعٌ لأكتبَ حول ذاك فصولا",71,"ل",2,0],["سلني عن الأحرار كيف تشرَّدوا","فالحرُّ صار بهمّهِ مشغولا",71,"ل",2,0],["سلني عن الشعب الأبي تزعزتْ","جنباتهُ فغدا يعيشُ فلولا",71,"ل",2,0],["سلني عن الوطن الكريم تعدَّدتْ","آفاته ورأى الطريق طويلا",71,"ل",2,0],["سلني فعندي للمصابِ مظاهرٌ","يغدو بها عقلُ الحكيم جهولا",71,"ل",2,0],["سلني