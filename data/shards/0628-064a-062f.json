س","https://www.poetsgate.com/ViewPoem.aspx?id=200340",""],[5956,"إشعاع العرب","https://www.poetsgate.com/ViewPoem.aspx?id=185592",""],[5957,"في ذكرى الجواهري","https://www.poetsgate.com/ViewPoem.aspx?id=177637",""],[5957,"وأنا جئتُ إليكم","https://www.poetsgate.com/ViewPoem.aspx?id=180652",""],[6046,"فراغ في الصورة","https://www.poetsgate.com/ViewPoem.aspx?id=35242",""],[6075,"الْمَوْتُ أَطْلَقَ سَهْمَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=210328",""],[6093,"بِيْدُ القصائد ( البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=181742",""],[6093,"عناق ظل","https://www.poetsgate.com/ViewPoem.aspx?id=194811",""],[6097,"بيدي ودَعتُك...","https://www.poetsgate.com/ViewPoem.aspx?id=190689",""],[6202,"لقاء العيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86750&r=&rc=51",""],[6213,"وهدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80548&r=&rc=80",""],[5555,"فِيْ حَضْرَةِ المُتَنَبِّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87405&r=&rc=1",""],[2638,"المُتْرَار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87860&r=&rc=17",""],[5126,"صَدْمَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87817&r=&rc=32",""],[6328,"ليته جاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82087&r=&rc=6",""]],"verses":[["بِيَدَي أَغَرَّ يَرُدُّ أَلوِيَةَ القَنا","غِبَّ الوَقائِعِ يُعتَصَرنَ مِنَ الدَمِ",0,"م",1,0],["بِيَدي مِنَ الهِندِيِّ فَضلُ عِمامَةٍ","لا بُدَّ أَعصِبُها بِرَأسِ مُسَوَّدِ",1,"د",1,0],["بِيَدَيهِ رَكدَةُ السَل","مِ وَزَلزالُ الحُروبِ",2,"ب",1,0],["بِيَ داءٌ شِفاؤُهُ أَنتَ لَو تَد","نو وَأَينَ الطَبيبُ لِلمُستَطِبِّ",3,"ب",1,0],["بِيَدٍ يُشامُ لَها بُرَيْقٌ خُلَّبٌ","عَلِقَتْ بهِ ذَيلَ الجَهامِ مَحائِلُ",4,"ل",1,0],["بَيْداءُ لُجّ أصْبَحَتْ فيهِ الرُّبا","فِيحاً وأطْوادُ السّفين قُدودا",5,"د",2,0],["بيَدَيْ هَلْهَلِ الحِجَى فاقِدِ الدّي","نِ أخي جُرأةٍ ورَبِّ اجْتِراح",6,"ح",1,0],["بيَدي حَياةُ مُتَيَّمي وحِمامُهُ","فلَكمْ تَلافَيْتُ الذي أفْنَيْتُهُ",7,"ت",2,0],["بِيَدي أَغَرَّ إِذا اِنتَمى لَم يُخزِهِ","نَسَبُ القِصارِ