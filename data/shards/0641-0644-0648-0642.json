","https://poetry.dctabudhabi.ae/diwan/poem/65488","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65276","المتقارب"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65109","الطويل"],[3170,"","https://poetry.dctabudhabi.ae/diwan/poem/115113","الطويل"],[3291,"","https://poetry.dctabudhabi.ae/diwan/poem/106685","الطويل"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71305","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127055","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205597","المتقارب"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73196","الطويل"],[4332,"","https://poetry.dctabudhabi.ae/diwan/poem/73636","الطويل"],[4375,"","https://poetry.dctabudhabi.ae/diwan/poem/107144","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120511","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139598",""],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4717,"مرثية الدكتور أحمد زويل","https://www.poetsgate.com/ViewPoem.aspx?id=199624",""],[4755,"مَسَاءَ الوَردْ يا طَشِّي","https://www.poetsgate.com/ViewPoem.aspx?id=183717",""],[4767,"النهج الأصيل","https://www.poetsgate.com/ViewPoem.aspx?id=179919",""],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4852,"خنسا","https://www.poetsgate.com/ViewPoem.aspx?id=214396",""],[4884,"جمعيَّةُ البرِّ","https://www.poetsgate.com/ViewPoem.aspx?id=201733",""],[4929,"غثاء الحداثة","https://www.poetsgate.com/ViewPoem.aspx?id=208719",""],[4119,"أمعظمة الصليب وددت أني","https://www.poetsgate.com/ViewPoem.aspx?id=16073",""],[5038,"حان الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=188122",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5413,"وبي مالا يبوح الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=201608",""],[5784,"تهجين","https://www.poetsgate.com/ViewPoem.aspx?id=189824",""],[5920,"عروس الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=144140",""],[5956,"رواسب","https://www.poetsgate.com/ViewPoem.aspx?id=183896",""],[199,"ومما شجاني أنني كنتُ نائماً","https://www.poetsgate.com/ViewPoem.aspx?id=22437",""],[6259,"خليليَّ هل من رقدة أستعيرها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59381&r=&rc=29",""]],"verses":[["فَلَو قَيلَ يَوماً أَينَ صَفوَةُ يَعرُبٍ","رَأَيتَ العُلى تومي إِلى ذَلِكَ المَهدِ",0,"د",1,0],["فَلَو قَد تَوَلّى وَسارَ الحَبيبُ","لَكانَ مَكانَ دُموعي دَمُ",1,"م",1,0],["فَلَو قَوِيَت لَعَزَّت عَنكِ نَفسي","وَلَكِنَّ المُحِبَّ هُوَ الذَليلُ",2,"ل",1,0],["فَلَو قامَ خَلقُ اللَهِ صَفّاً وَأُفرِدَت","لَشايَعتُها وَحدي وَمِلتُ عَنِ الصَفِّ",3,"ف",1,0],["فلو قام هذا الفيل واستجمع القوى","لهزّ بها شُمَّ الجبال وقلقلا",4,"ل",2,0],["فلو قيلَ من يستنهض الناس للعلا","إذا ساءَ محياهم لقلت المعلمّ",5,"م",1,0],["فلو قلتَ بعض الشعر في يوم حَفْلهم","تَشُدّ به منَا لمصر الأواصرا",6,"ر",2,0],["فَلَو قُتِلوا يَومَ الرَجيعِ بِأَسرِهِم","بِذي الدَبرِ ما كانوا لَهُ بِكَفاءِ",7,"ا",2,0],["فلو قيل فارق ولا تبتئس","أيست لقولهُم فارق",8,"ق",1,0],["فَلَو قارونُ فَوقَ الأَرضِ إِلّا","تَمَنّى لَو رَضيتَ بِهِ قَرينا",9,"ن",2,0],["فَلَو قَدَرَ السِنانُ عَلى لِسانٍ","لَقالَ لَكَ السِنانُ كَما أَقولُ",10,"ل",1,0],["فَلَو قَدَّمَ صَبّاً في","هَواهُ الصَبرُ وَالرِفقُ",11,"ق",1,0],["فلو قضيتَ لقلبي","لما شكا من وجيب",12,"ب",1,0],["فَلَو قَتَلوا بِحَربٍ أَلفَ أَلفٍ","مِنَ اَلجَنّانِ والإِنسِ الكِرامِ",13,"م",1,1],["فلو قَرُبَتْ مِنْ سَدِّ يأْجُوجَ بَعْدَمَا","بَنَى منه ذُو القَرْنَيْنِ دُكَّ بها السَّدُّ",14,"د",1,0],["فَلَوْ قَفَوْتُ بأَخْذِ المالِ إثرَهم","لَعَوَّقَتْني القَوافِي فيكَ والفِقَرُ",15,"ر",1,0],["فَلَو قُلتَ لَهُم مَهلاً","كَما قُلتَ لَهُم قولوا",16,"ل",3,0],["فَلَو قيلَ الغُواةُ عَرَفتِ كَشفي","مِنَ الكَذِب المُمَوَّهِ ما تَوارى",17,"ر",2,0],["فَلَوْ قَبْلَ مَبْكَاهَا بَكَيْتُ صَبَابَةً","بِلَيْلَى شَفَيْتُ النَّفْسَ قَبْلَ التَّنَدمِ",18,"م",1,1],["فَلَوْ قَدَرْتُ عَلَى شَيءٍ هَمَمْتُ بِهِ","فِي الْحُبِّ لَكِنْ قَضَاءٌ خَطَّهُ الأَزَلُ",19,"ل",1,0],["فَلَوْ قُلْتِ قُمْ فَاصْعَدْ إِلَى رَأْس شَاهِقٍ","وَأَلْقِ إِذَا أَشْرَفْتَ نَفْسَكَ لِلْوَهْدِ",20,"د",1,0],["فَلَوْ قَدَرَ السَّلَفِ الأَمْجَدُو","نَ لَدَانَ لِمُحْدَثِهَا الأَقْدَمُ",21,"م",1,0],["فلو قدرتها هاشم حق قدرها","هشمن ابن صخر للحروب صخور",22,"ر",1,0],["فلو قالوا تمنَّ لقلتُ يوماً","يكرُّ وما به خطبٌ يكر",23,"ر",1,0],["فَلَوْ قلََبْتَ جميعَ الأَرضِ قاطِبَةً","وسرتَ في الأَرضِ أَوساطاً وأَطرافا",24,"ف",2,0],["فلو قست ما بي بالمحبين جملة","وجدت الذي بي منك مما بهم أقوى",25,"و",2,0],["فلو قدرت عن بابه لك غيبة","لفرج بالغارات كرب المحاصر",26,"ر",1,0],["فَلَو قُلتِ طَأ فِى النّارِ أَعلَمُ أَنَّهُ","هَوًى مِنكِ أَو مُدنٍ لَنا مِن وِصالِكِ",27,"ك",1,0],["فَلَو قوبِلَت بِنَسيمِ الصَبا","تَهُبُّ سُحَيراً لَكانَت أَرَقّا",28,"ق",2,0],["فَلَو قيلَ لي ماذا تَمَنّى وَقَد خَدَت","بي العرمِسُ الوَجناءُ قُلتُ أَعودُ",29,"د",1,0],["فلو قلت حقا ما مدحت أخا كسل","ومع ذاك لم تعلم عيوبا أراكا",30,"ك",2,0],["فَلَو قَبَّلتَني وَقَبِلتَ مِنّي","فَقالَ أَخافُ بَعدَ الحَجِّ عُمرَه",31,"ر",2,0],["فَلو قَد حلَفتَ وردَّ الهوَى","يقُودُكَ ردَّ عَليه الوَسَن",32,"ن",1,0],["فلو قوم موسى في ذراها تفيّأوا","لما جهلوا في غيّهم حين أسرفوا",33,"ف",3,0],["فلو قلدته بنت تسعين حجة","لأضحى عليها للملاحة وإشراق",34,"ق",1,0],["فلوقيس أَهل الأَرض دَع عَنكَ حاتِماً","بخِنصِرِه أَربى عَليهِم عَشيرُها",35,"ر",3,0],["فلو قارعتكم منه يوماً قوارعٌ","لأَصبَحَ منكم قارعاً سنَّ نادم",36,"م",1,0],["فلو قلنا الأَنامُ لهم فِداءٌ","لأَقلَلْنَا لحَقِّهِمُ الفِداءَ",37,"ا",2,0],["فلو قفت حادثات الدهر نهجهم","لم تختلف في مجاريها ولا اختلفا",38,"ف",2,0],["فلو قننُ الجبال زحمنَ جنبي","وقعنَ أخفَّ من مِننِ الرجالِ",39,"ل",1,0],["فلو قلتُ إني في مديح سواهُمُ","صدقتُ لقال الشعرُ في السرِّ تَكذبُ",40,"ب",1,0],["فلو قدر البحر الخضمُّ لجاءهُ","بآذيه من فيض كفّيهِ يستجدي",41,"د",2,0],["فَلَو قَلَّ دينُ البَربَرِيِّ قَضَيتُهُ","وَلَكِنَّ دينَ البَربَرِيِّ كَثيرُ",42,"ر",1,0],["فَلَو قُتِلتَ وَرِجلي غَيرُ كارِهَةِ ال","إِدلاجِ فيها قَبيضُ الشَدِّ وَالنَسَلُ",43,"ل",1,0],["فَلَو قَبلَ مَبكاها بَكيت صَبابَة","بِسُعدى شَفيت النَفسَ قَبل التَندم",44,"م",1,0],["فَلَو قبَضتَ البَنانَ شُحَا","بِبَذلِه لم تَكُن أميرا",45,"ر",2,0],["فلو قدرت ربوعٌ حلَّ فيها","لكانت نحوَ ملقاهُ تسيرُ",46,"ر",1,0],["فَلو قَبضوكُما بِفراش سُوءٍ","لَكان اليَوم فَوقَكُما التُراب",47,"ب",1,0],["فلو قست ذلك يا ذا الفكر","لأيقنت أنك بعض البشر",48,"ر",1,1],["فلو قابلتْ خَدَّيْهِ ألحاظُ رامقٍ","لأتَّرَ في خديْهِ باللحظِ رامقُه",49,"ق",2,0],["فَلَو قامَ يَمشي فَوقَ إِنسانِ مُقلَتي","لَما عَلِمَت فيهِ وَما كانَ يُؤذيها",50,"ه",2,0],["فَلَو قَد بَدا في مَوكِبٍ أَو بِجَحفَلٍ","فَشَمس الضّحى مِنها النُّجومُ الطّوالِعُ",51,"ع",1,0],["فَلَو قامَتِ الحَرب العوانُ لَدى الوَغى","عَلى ساقِها فَهوَ الهِزَبرُ المجرّبُ",52,"ب",1,0],["فلو قد حَساها في البِلا رهنُ رَمِسهِ","أقامت عليه للحياة دليلا",53,"ل",2,0],["فَلو قيلَ لِلإِسلام مَن كُنت تَرتَجي","لَقالَ لَنا يَعقوب ذاكَ الغَضَنفَرُ",54,"ر",1,0],["فلو قَطَبَتْ راحا لما قطَّبتْ لها","وُجوهٌ ولا غطّت على حِلْم شارب",55,"ب",1,0],["فلو قد رَأَتْهُ أمُّه وَبَدَتْ لها","مَساويه وَدَّتْ أنّ مَن وَلَدَت سقْطُ",56,"ط",1,0],["فلو قطعتَ بها البيداءَ مُعْتَسِفاً","جَرتْ ولم يعْيِها سهلٌ ولا عَلَم",57,"م",1,0],["فلو قدرتُ على أدنى مكافأةِ","له لأهديتُ أكبادي له فِلَذا",58,"ذ",2,0],["فلو قال طأفي النار والنار جمرها","له لهب يرمى الشرارة كالقصر",59,"ر",1,0],["فلو قدرت تسير بنات نعش","بنعش كن بعض الحامليها",60,"ي",3,0],["فلو قيل مل عن نقله تسترح لما","رضيت سوى أني إليه أميل",61,"ل",1,0],["فَلَو قَد ذُقتَ مِن حَلواهُ طَعماً","لَآثَرتَ التَعَلُّمَ وَاِجتَهَدتا",62,"ت",2,0],["فلو قد وَفَوا كُنّا أُسارى حَقوقِهِم","نُراوحُ ما بين النَسيئةَ والنَقدِ",63,"د",1,0],["فلو قد فَرَغنا من علاجِ نفوسِنا","لحطّوا الدنايا من عيوبي وأنصفوا",64,"ف",3,0],["فَلَو قِيل عَبدٌ شَرَتهُ التِّجَارُ","سَبِيٌّ مِنَ الرُّومِ لَم يُنكرِ",65,"ر",1,0],["فلو قلت ما معنى معاً قد تعزه","وما المثل الأعلى يقولون زخرف",66,"ف",1,0],["فلو قضت شدّة أو حسرة أجلا","لكنت ممن قضى من حسرة فمضى",67,"ض",2,0],["فلو قبلتني الحادثات مكانكم","لأنهبتها وفري وأوطأتُها خدّي",68,"د",2,0],["فلو قطعت فيكم جميع مفاصلي","لكان لكم في كل عضو لها وصل",69,"ل",1,0],["فلو قيس بالأحلام مورد ذكره","بلا شبهةٍ لاحتاج عندي لتعبير",70,"ر",1,0],["فلو قالت الأقمار من ذا الذي بهم","يفاخرنا قدراً لقلت لها أنا",71,"ن",2,0],["فلو قيل لي يا صاحب الرأي ما الذي","تقول بصدر ليس فيه غرامُ",72,"م",1,1],["فلو قسمت في الجن والانس عبرتي","عليه بكى من حرها الثقلان",73,"ن",1,0],["فلو قام داعٍ خلفَ سبعةِ أبحر","دعا دعوةً يا فضلُ يا فضلُ لبّاه",74,"ا",2,0],["فلو قسته ضوءا وجودا وجرأة","بشمس وضرغام ووبل متى همى",75,"م",2,0],["فلو قلت يا للعجم والغتم يالهم","إذا لعسى أمددت بالعجم والقلف",76,"ف",1,0],["فلو قيس قسٌّ في فصاحة لفظه","لردَّت لنا قسّاً فصاحته عيّاً",77,"ي",2,0],["فلو قد خط مجمل ما جناه","على ثهلان لانساخ انفطارا",78,"ر",2,0],["فلو قرنت بجسمي ذرّة لترى","أبدى الخفيفين كان الذّرُّ أبدانا",79,"ن",2,0],["فلو قابل الجيش في حربه","بذاك السّلاح لهُ ما امتنع",80,"ع",1,0],["فلو قيل من أزكى الملوك بأسرها","لقالت عليّ بن الحسين تُجاوبُ",81,"ب",1,0],["فلو قِيلَ هاتُوا فيكمُ مثلَهُ","لَعَزَّ عليكم أَن تجيئُوا بواحدِ",82,"د",1,0],["فلو قَابَلَتنِي فِي الظَّلاَمِ نَوَاظِرُ ال","مَجُوسِ لَحرُّوا سَاجِدينَ وَصَاحُوا",83,"ح",3,0],["فَلَوْ قِيْسَتْ الأَبْعَادُ مِنْ كُلِّ جَانِبٍ","تَسَاوَتْ فَلاَ بُعْدٌ يُرَامُ وَلاَ قُرْبُ",84,"ب",1,0],["فلو قد رآها المرتضى في احتجاجه","رأى حجباً من محكم الذكر وافيه",85,"ي",2,0],["فلو قلت أطعمتني قبلة","لأنبأت عن صدقي الطازجِ",86,"ج",1,0],["فلو قيلَ لي أَينَ الذينَ تحبُّهم","مَحبَّةَ إِرضاعِ بغيرِ فِطامِ",87,"م",1,0],["فَلَو قيلَ لي اِختَر ما تُرِيد لَقُلتُ لا","أُريدُ سِوَى قُربِ الفَقيهِ أَبي بَكرِ",88,"ر",1,0],["فلو قيل لي من أنت قلت معذب","بنار مواجيد يضرمها العتب",89,"ب",1,0],["فلو قال امرؤ هذي بلاد","ثراها عسجد حج الممارى",90,"ر",2,0],["فلو قسَّم الرحمن نصفَ صلاحه","على الدهر لم تنظر إلى غير صالح",91,"ح",1,0],["فَلَو قيسَ ما قاسَيتُهُ بِجَهَنَّم","مِنَ الوَجدِ كانَت بَعضَ ما أَنا قارِعُ",92,"ع",1,0],["فلو قالوا لهذا الفسلِ نجمٌ","فقلْ ومتى تنجَّمتْ الفسولُ",93,"ل",1,0],["فلَو قَصْدَكْ مَعي تِمشِي","طَريقَ العاشِقَ الغَشَّاشْ",94,"ش",1,0],["فلو قطعت إربا في سواها","فلن يرضى فؤادي بالبديل",95,"ل",1,0],["فلو قلت بالتأويل فيها بظاهر","لعدت إلى الإسلام من بعد إيماني",96,"ن",2,0],["فلو قابلتَ بعضي بالثّرى","فبذراً ..لاجل طرحٍ يستريح",97,"ح",1,0],["فلو قدَّرَ الرّحْمنُ للخيرِ منْطقاً","لأَثْنى عليهم حيثُ بالفضْلِ قد عادوا",98,"د",3,0],["فلو قدَّر الرحمن فيكم مصيره","فلن تشهد الأيام الا وباله",99,"ل",2,0],["فلو قديسها ناجاه لفظي","لأمسى والنسيب له نسيب",100,"ب",1,0],["فلو قالوا يشيخُ وأنْتَ تدْري","ترعْرعَ بينَ أكْنافي صِباكا",101,"ك",2,0],["فلو قلت قولا ًغير هذا مملحاً","بنوع من التمويه ساغ لمن جهل",102,"ل",1,0],["فلو قلت واستدركت للعدل قائلاً","ليتبعه إن مال لكن إذا اعتدل",102,"ل",1,0],["فلو قال قولاً تستبين لذي النهى","محامله أو كان تخفى دلائله",103,"ل",2,0],["فلو قابلْتَ عينيها مَسَاءً","لكنتَ أَحَبَّ منْ\"قيسٍ\" وأضْنَى",104,"ن",2,0],["فلو قرأت على الجعفيِّ قافيةً","لأنكر السيف والقرطاس والقلما",105,"م",2,0],["فلو قَطَّعوا جِسْمي لفاحتْ قَصَائِدٌ","من العَنْبَر الافرِيقي وانْتَشَر العِطْرُ",106,"ر",1,0],["فلو قلبي صَفَا أحيا","سعيداً دونما ضِغْنِ",107,"ن",1,0],["فَلَوْ قَبْلَ مَبْكَاهَا بَكَيْتُ صَبَابَة","ً سُعْدَى شَفَيْتُ النَّفْسَ قَبْلَ التَّنَدُّمِ",108,"م",1,0],["فلو قيس أهل الأرض دع عنك حاتماً","بخنصره أربى عليهم قصيرها",109,"ر",3,0]]}