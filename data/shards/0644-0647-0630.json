etsgate.com/ViewPoem.aspx?id=215888",""],[4722,"نفيتم صفات الله فالله أكمل","https://www.poetsgate.com/ViewPoem.aspx?id=26476",""],[4755,"هو الآنَ يَنهارُ.. أَو يُوشِكُ","https://www.poetsgate.com/ViewPoem.aspx?id=201066",""],[4859,"مرحى@","https://www.poetsgate.com/ViewPoem.aspx?id=213582",""],[4884,"من ماجدٍ إلى ماجد","https://www.poetsgate.com/ViewPoem.aspx?id=210428",""],[4929,"الزمن المُعَرَّب.","https://www.poetsgate.com/ViewPoem.aspx?id=201086",""],[4935,"مفاخر مصر بالكذب","https://www.poetsgate.com/ViewPoem.aspx?id=129308",""],[4935,"إلهي فرج الكربا","https://www.poetsgate.com/ViewPoem.aspx?id=129287",""],[5046,"أنشكو سقاما.. !","https://www.poetsgate.com/ViewPoem.aspx?id=200960",""],[5072,"كفى هوساً","https://www.poetsgate.com/ViewPoem.aspx?id=52569",""],[5281,"أصيل","https://www.poetsgate.com/ViewPoem.aspx?id=200083",""],[5410,"طريق مستديرة","https://www.poetsgate.com/ViewPoem.aspx?id=140753",""],[5431,"لهذا القلب قد أودعتُ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=185436",""],[5431,"له...له...","https://www.poetsgate.com/ViewPoem.aspx?id=191170",""],[5612,"الطريقُ الصَّعْب","https://www.poetsgate.com/ViewPoem.aspx?id=179789",""],[5628,"لا أمل في البقاء","https://www.poetsgate.com/ViewPoem.aspx?id=178512",""],[5628,"غيرة العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=179895",""],[5642,"مُذكرات طفل سوري","https://www.poetsgate.com/ViewPoem.aspx?id=131268",""],[5689,"على قدر ما تعطي الملاح من الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=143395",""],[5770,"على اليرموك","https://www.poetsgate.com/ViewPoem.aspx?id=178268",""],[5776,"انتحارُ عرّافة","https://www.poetsgate.com/ViewPoem.aspx?id=199330",""],[5776,"أطوارُ ......عنكبوت الهولوكوست","https://www.poetsgate.com/ViewPoem.aspx?id=199338",""],[5776,"هيبة حضور","https://www.poetsgate.com/ViewPoem.aspx?id=199371",""],[5956,"وداعاً لعهد وداد العيون ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181956",""],[5956,"رحلةٌ نفسية","https://www.poetsgate.com/ViewPoem.aspx?id=183278",""],[5956,"أنا وشعري","https://www.poetsgate.com/ViewPoem.aspx?id=185596",""],[5956,"شعري ورقابة المطبوعات","https://www.poetsgate.com/ViewPoem.aspx?id=185624",""],[5956,"حول الأوزان والحداثة","https://www.poetsgate.com/ViewPoem.aspx?id=186235",""],[5956,"منْعُ نشْر شعري كمنْع نور البدرِ","https://www.poetsgate.com/ViewPoem.aspx?id=192459",""],[5956,"نُغنّي للقياك يا أبتاه","https://www.poetsgate.com/ViewPoem.aspx?id=192780",""],[5956,"يُقيم مبادرات باسلات","https://www.poetsgate.com/ViewPoem.aspx?id=193203",""],[5956,"أغَرّد","https://www.poetsgate.com/ViewPoem.aspx?id=193293",""],[5956,"المجد الجديد","https://www.poetsgate.com/ViewPoem.aspx?id=194172",""],[5956,"تعالوا","https://www.poetsgate.com/ViewPoem.aspx?id=195019",""],[5969,"مؤامرة","https://www.poetsgate.com/ViewPoem.aspx?id=205051",""],[6079,"قسوة الجوى","https://www.poetsgate.com/ViewPoem.aspx?id=207049",""],[6097,"ألا يا خاطب الحسنا","https://www.poetsgate.com/ViewPoem.aspx?id=186339",""],[6102,"أَحَقُّ !!","https://www.poetsgate.com/ViewPoem.aspx?id=182816",""]],"verses":[["لِهَذِهِ كانَ الزَمانُ يُنتَظَر","لَم يَبقَ مِن بَعدِكَ لِلمَجدِ وَطَر",0,"ر",1,1],["لَهُ ذَيْلٌ يُشِيرُ بِه دَلاَلاً","إلا ذَاتِ الشَّمَالِ أَوِ الْيَمِينِ",1,"ن",1,0],["لهذا اليوم في التأريخ ذكر","به الآناف يفغمهنّ طيب",2,"ب",1,1],["له ذَمَرات حين يوعد قِرنهُ","تكاد له صُم السِّلام تَفطَّر",3,"ر",1,0],["له ذكاء الفتى وقد كمُلت","فيه على ذاك حُنكةُ النَصف",4,"ف",1,0],["له ذِكَرٌ إليها مُستراحٌ","وناحيةٌ إليها مُستنامُ",5,"م",1,0],["لِهَذا اليَومِ بَعدَ غَدٍ أَريجٍ","وَنارٌ في العَدوِّ لَها أَجيجُ",6,"ج",1,1],["لَهُ ذَنَبٌ مِثلُ الرَشاءِ يَجُرُّهُ","وَمَتنٌ كَمَتنِ القَوسِ أَعوَجَ مُنئَدُّ",7,"د",1,0],["له ذَنَبٌ مُسْتَنْبَطٌ منه سَوْطُهُ","ترَى الأرض منه وهي مضروبة الظهرِ",8,"ر",1,0],["لَهُ ذَنَبٌ مثلَ ذيلِ العَرُوسِ","عَلَى سُبَّةٍ مثلِ حُجرِ اللَّجَم",9,"م",1,0],["لِهَذَا الفَنِّ سِحْرٌ","يَصْحَبُ الإِبْدَاعَ وَالحِذْقَا",10,"ق",2,0],["لهذا التمادي آخر بعد آخر","أليس له بدآن: أصل، ووافد؟",11,"د",1,0],["لهذا تغني بدون انقطاع","تثور على وجهك (ابن الحرام)",12,"م",1,0],["لَهُ ذَنَبٌ مثلُ الرِّشَاءِ يَجُرّهُ،","وَمَتنٌ كَمَتنِ القَوْسِ أعوَجُ، مُنْأدّ",13,"د",1,0],["لِهذا اللَّيلِ شَمْسٌ مَشْرِقِيَّهْ","و(عند علي) طَلْعَتُها بَهِيَّةْ",14,"ي",2,1],["لهذه الأسباب قد حكمنا","للرافعي بالنصف إذ قسمنا",15,"ن",2,1],["لِهَذا العُلى مُلكٌ بِغَيرِ مُشارِكٍ","لِأَكرَمِ مَن أَعطى وَأَشرُفِ مَن سَما",16,"م",2,0],["له ذخر النصر المبين على العدا","وإن شئت فلتسأل بطون المفارق",17,"ق",1,0],["لَهُ ذِمَّةٌ يُثنى مِنَ العَرشِ حَبلُها إِلى","حَبلُها إِلى الفَرشِ مَمدوداً عَلى الخَلقِ ظِلُّها",18,"ه",2,0],["لَهُ ذِروَةُ المَجدِ المُؤَثَّلِ وَالعُلى","إِذا اِنشَعَبَت يَومَ الفَخارِ القَبائِلُ",19,"ل",1,0],["لِهذا الجلال الذي لا يُرامُ","مَعانِ تَحَيَّر فيها الكلامُ",20,"م",1,1],["لِهذا أَودُّكِ فَوق الوُجود","وَفَوقَ عَناصِرِ هذا الفَلك",21,"ك",1,0],["لهذا بجود الغيث ما لاح بارقه","ومن فيك لي برق لقد ضن ثادقه",22,"ق",2,1],["له ذروة الدار التي فضل الوري","بادرا كها فضل الوقار على الطيش",23,"ش",1,0],["له ذمة لا تقرأ الغدر من وفا","بها ولو ان الدهر حرره سطرا",24,"ر",2,0],["له ذروة المجد المؤثل هامها","ينكس هاماً للسهى ومناكبا",25,"ب",2,0],["لِهَذا الهَوى بابٌ وَسَهلٌ دُخولُهُ","كَما كانَ لَكِنَّ الخُروجَ هُوَالصَعبُ",26,"ب",1,0],["لهذا كنت في العهدين حدّاً","به وقف الكمال بمن حملتِ",27,"ت",1,0],["لهذا يفرح الثالوث حقّاً","مع الآبا وحزب الأولياء",28,"ا",2,0],["لهذي النُّوقِ تنحَطُّ كَلالا","وتَجوبُ البيد حِلاًّ وارتحالا",29,"ل",2,1],["له ذِكْرٌ علا فوق الثريا","وجاهٌ من ذوي الحاجاتِ داني",30,"ن",2,0],["لهذا خلقنا والجديد سيخلق","وما ترتق الآمال فالموت يفتق",31,"ق",1,1],["لهذا وَقفنا عُراةَ الجراح","كباراً على لؤمِها الألأمِ",32,"م",1,0],["لهذه العزة حيث الفلا","قد عفت أرضي وتركت الهوان",33,"ن",1,0],["له ذخائر اسراري أوجهها","وهو اختباري وأعلى مبتغى هممي",34,"م",2,0],["لهذا متى ذو اللبس يخلو بربه","يسيءُ له الآداب يغلبه الفقد",35,"د",1,0],["لِهذا الفَرْقِ دانَ الفَرْقدانِ","على خَجَلٍ فليسَ الفَرْقُ داني",36,"ن",2,1],["لهذا العدوّ الذي أمنا حرقَ","الزرع في أرضنا فاحترقْ",37,"ق",1,0],["لَهُ ذِهنُ بِهِ الأَسرارُ طرّاً","لِأَحرُفها بَدا حسنُ اِرتِسامِ",38,"م",1,0],["لهذا تراها كل مغرب ليلةٍ","تحييه بالتسليم قبل التباينِ",39,"ن",1,0],["لهذا أنا أرتد لله راجعاً","لأعدل ديوانٍ وأرهب محفلِ",40,"ل",1,0],["لهذا الخطبِ تدَّخرُ الدموعُ","وينفرُ عن نواظرِنا الهجوعُ",41,"ع",1,1],["لهذا وأيم اللَه جود ابن حرَّةٍ","ألذُّ وأهمى من سلاف الغمامةِ",42,"ه",1,0],["لهذا الفضل كم أفلت شموس","وشمس المصطفى في الدهر سافر",43,"ر",1,0],["لهذه والبشاشة في التلاقي","ومهما غبت عن مرآه حنا",44,"ن",2,0],["لهذا قد صرفت عنان طرفي","بمدحك حيث لا أخشى عثاري",45,"ر",2,0],["لهذا الذي قد قلته وزن شرعه","وأما الذي للكل فاضربه في الكل",46,"ل",1,0],["لهذه الساعة صوت طلقُ","وهي به اذا سكتنا تنطق",47,"ق",1,1],["لهذا يكون العقل بالزهد راغباً","ومن بعده لا يعتريه التوهم",48,"م",1,0],["لَهُ ذِئَبٌ للريحِ بَينَ فُروجِهِ","مَزاميرُ يَنفُخنَ الكسير المهزَّما",49,"م",2,0],["لَهُ ذرى المنبرِ الأَعلى إِذا اِحتَشَدَت","لِلاستماع رِجالٌ تَلقف الحِكَما",50,"م",2,0],["لَهُ ذَنبٌ مُرخىً طَويلٌ يُقيمُهُ","يلُفُّ بِهِ مَن كانَ في الناسِ يفقدُ",51,"د",1,0],["له ذكاء أشرقت ذكاؤه","وحيث تخطي الأذكيا يصبب",52,"ب",1,0],["له ذكاء ذكاء ليس يحجبها","من حيث تشرق غيم الشك والريب",53,"ب",1,0],["لهذا التخفي مدة بانقضائها","لنا تسفر الدنيا وذو الدين يستر",54,"ر",1,0],["لِهَذا اليَومِ فَضلٌ مُستَبينٌ","عَلى الأَيّامِ تَعرِفُهُ وَشَأنُ",55,"ن",1,0],["لهذا تراها في نكوص بسرعة","وتهذي وما طيف الجنون أتاها",56,"ا",3,0],["لَهَذِي فَتكَةٌ بِكرٌ","عَتَا في بَدئِها نَصلُ",57,"ل",1,0],["لهذا النبي المصطفى أذعن الورى","بتفصيل آيات وضربة فيصل",58,"ل",1,0],["لهُ ذِمَمٌ مَن رامَ بالغَدْرِ خَفْرَها","أبَتْ أنْ يُرى إلا خَذولاً مُذَمَّما",59,"م",2,0],["لَهُ ذِكرة يَستَوهِب النَدُّ نَفحَها","وَعَرضٌ طَهورٌ لَم تَشبه شَوائِب",60,"ب",1,0],["لَهُ ذكرة كَم عَطرت من مَشارِق","وَعم شَذاها في جَميعِ المَغارِب",61,"ب",1,0],["لَهُ ذِكرَة كَم شَنَفَت من مَسامِعَ","فَغَنىَّ بِها حادي الظعون وَقَد حَدا",62,"د",2,0],["لِهَذا قَد اِندَقَت مَفاصل فَيصَل","وَكادَت عَلَيهِ الدائِرات تَدور",63,"ر",1,0],["لَهذا هُوَ ابني المُجتَبَى فاسمعوا لهُ","فصاخَ لهُ النَدبُ السَرِي وَهوَ حازمُ",64,"م",1,0],["لهذا هجرت اللهو والانس والصفا","إِلى أن يجيء الله بالخير واليسر",65,"ر",1,0],["لهذا تراهم يرفعون أكفهم","إذا اجتهوا عند الدعاء إلى العل",66,"ل",1,0],["لهذا هجرتك يا خمرتي","وان قيل هذا من المستحيل",67,"ل",1,0],["لِهذا اليومِ تُنْتَخَب القوافي","وَيذخرُ نَفسه الدُّرُّ المَصُونُ",68,"ن",1,0],["لهذا حُرِمنا من رجال تسوسنا","وهل يُحرَمُ الخيراتِ إلا كفورها",69,"ر",3,0],["له ذكركم وِردٌ يردِّده إذا","أتته دواعي الشوق تقضي بأنكاد",70,"د",1,0],["له ذهن يغوص على المعاني","فيبرز كل دُرٍّ مستجاد",71,"د",1,0],["لهذا فإِنّي والخلائقَ كلهم","نُعيد تعازينا، نُجاوبُ ذِكراه",72,"ا",2,0],["لهذا له وجهت خالص وجهتى","مع السقم من أثقال وزرى والجهش",73,"ش",1,0],["لهذا أمير المؤمنين عليه قد","أفاض فيوضات طمت وتكاثرت",74,"ت",1,0],["لهُ ذكاءٌ وفي فخر اللغات بدا","فِنّاً يلاعب أفنان الأفانين",75,"ن",1,0],["له ذكرٌ وفكرٌ واعتبارٌ","غزير الدمع إن ذكر ارتجاعه",76,"ع",2,0],["لهذا تركها الزاهدون وحذروا","جميع الورى منها على أي حالة",77,"ه",1,0],["لهذا فَوَالِ الحمدِ إنْ كنتَ حامداً","ودَعْ ما سواهُ فهو تِرْبٌ وجَلْمَدُ",78,"د",1,0],["له ذلَّ قومٌ مجدهم ملأ السما","مناقب ترب النيِّرات الثواقب",79,"ب",1,0],["لهذا أستعير العطرَ منكم","إذا في مهجتي شعرٌ ملحُّ",80,"ح",1,0],["لهذا تراهم يرفعون أكفهم","إذا اجتهدوا عند الدعاء إلى العلو",81,"ل",2,0],["لِهذا الذي طالَ وَهْمٌ، ولِي","يَقِينٌ بِتَركِيعِهِ مُدرِكُ",82,"ك",1,0],["لهذا الشطر تبتهج المعاني","كبهجة صائم لقي الهلالا",83,"ل",2,0],["لهذا يخرُّ المرءُ للهِ ساجداً","على فضْلِه الزّاكي الكثيرِ الفوائدِ",84,"د",1,0],["لهذه الأسباب ياصاحبي","لا بد من فتوى ومن مذهبِ",85,"ب",1,0],["(لهذا أصبح الرومي","وذو السردين والعلب)",86,"ب",1,0],["لهذا لم يكن في الكو","ن من شبه إذا خطبا",87,"ب",2,0],["لهذا يظل الحب شمعة سائرٍ","إذا ضل عن درب الصبابة روحنا",88,"ن",2,0],["لهذا غاب َ عن سَنتي حصادي","لأن َّ الكل َّ قد قطعوا زروعي",89,"ع",2,0],["لهذا سوف نحيا في انتظارٍ","وإن لم تفلحوا فهي القيامه",90,"م",2,0],["لهذا رحت أزرع في مداها","زروعاً سوف تجعلها وفيرة",91,"ر",2,0],["لهذا القلب قد أودعتُ قلبي","تراتيلا تُصعَّد للسماءِ",92,"ا",2,0],["له ذاتي ..له جمرات روحي","لتتركني بحرقتها رماده",93,"د",2,0],["لهذي الشمسِ لن تسْطيعَ طيْراً","ولن تأتيكَ إنْ دهْراً نظرْتا",94,"ت",2,0],["لهذا نويتُ الرحيلَ غدا","نويتُ التعلّق بالأشرعهْ ْ",95,"ع",2,0],["لهذا أغارُ عليك ِ لِذا","أخافُ مِن الغيرة المُحرِقه ْ",96,"ق",2,0],["لِهَذا العالمِ الأعمَى .. يدٌ لا تعرفُ الدعما","وأُذْنٌ ماتَ فيها السمعُ عن أنَّاتِنا صَمَّا",97,"م",2,1],["لهذا نرى صرح الحياة مزعزعا","وما به زلزال ولا غارة المزن",98,"ن",1,0],["لهذا الحُسن عن بعد تبدَى","وكفك بعدُ لم تمط اللثاما",99,"م",2,0],["لهذا... الصّبرُ ذلٌ حينَ نرضى","وموتٌ حينَ تنتحرُ العرافهْ...",100,"ف",2,0],["لهذهِ الرّيحُ زوجٌ في أسرّتِها","تبعّلتْ عُقمَها هَذي المَمَرّاتُ",101,"ت",1,0],["لهذا الليلِ نافذةٌ وأبوابُ","وثمّ هناك للأنوار حجّابُ",102,"ب",1,1],["لهذا خسِرتُك لم يبقَ عندي","سوى أن أجود بدمعي الهتونْ",103,"ن",1,0],["لهذا اقبروا نصفَ جسمي ببحرٍ","ونصفي على التلّ في بيتِ خالْ*",104,"ل",1,0],["لهذا فإني سأبقى أجودُ","بشعري أداوي جميعَ الكبودْ",105,"د",1,0],["لهذا أراني في اكتفاءٍ لبعض ما","ألاقيه مِن ذكرَى تلوح وتغربُ",106,"ب",1,0],["لهذا فإن الشعر يحتاج صنعة","ولو كان عفويّاً طريفاً وملهَما",107,"م",2,0],["لهذا فإنّ العيب بي أنا سيدي","فلا تَكرهنْ رأياً يكونُ مُعاديا",108,"ي",2,0],["لهذا تراني في القصيدِ أقَلّنا","تَطَوُّر شِعْرٍ سَاذَجٍ ليس راقيا",108,"ي",2,0],["لهذا تأصَّلَ حبّي وأضحى","كحبك نفسِهِ يعلو بنا",109,"ن",2,0],["لهذا كم رجوت تعود فوراً","ليهدأ روع بالي وانتحابي",110,"ب",2,0],["لهذا نقاومه باقتدارٍ","ونرفض منه المزيد ونقْلى",111,"ل",2,0],["لهذا النوع تأثيرٌ كبير","على الأشعار يثريها ابتكارا",112,"ر",2,0],["لهذا قد تعالى نهجُ ربي","عزيزاً عن مناهجَ فوضويّةْ",113,"ي",2,0],["لهذا سيهذي من يريدكَ خائراً","يُريد ازدراءَ الحسن فيكَ يُباهلُ",114,"ل",1,0],["لهذا سيفنى من يُريدكَ صاغراً","لأنك ممدوحٌ وَحجمُكَ هائِلُ",114,"ل",1,0],["لهذا تراني رغمَ كلّ مُصيبةٍ","أؤمّلُ تيسيرًا يجيءُ معَ العُسرِ",115,"ر",1,0],["لِهَذي فاسْعَ مُجْتَهِدًا","وأعْرِضْ عنْ بَدِيلتِها",116,"ت",3,0],["لِهَذا اللَّيلِ أَرتَقِبُ انفِراجًا","وَأَستَجدِي , وَما لِلفَجرِ بَثقُ",117,"ق",1,0]]}