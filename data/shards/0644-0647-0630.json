{"poems":[[53,"لهذه كان الزمان ينتظر","https://www.aldiwan.net/poem30211.html","الرجز"],[93,"عذيري من ضنى القلب الحزين","https://www.aldiwan.net/poem11221.html","الوافر"],[88,"لهذا اليوم في التأريخ ذكر","https://www.aldiwan.net/poem44990.html","الوافر"],[51,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[51,"ما القلب في إثرهم بمختطف","https://www.aldiwan.net/poem65441.html","المنسرح"],[51,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[43,"لهذا اليوم بعد غد أريج","https://www.aldiwan.net/poem9519.html","الوافر"],[45,"سلام عليكم لا وفاء ولا عهد","https://www.aldiwan.net/poem63506.html","الطويل"],[80,"وليث مقيم في غياض منيعة","https://www.aldiwan.net/poem31232.html","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21097","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55073","الوافر"],[100,"استنطاق","https://www.poetsgate.com/ViewPoem.aspx?id=206345",""],[100,"زامر القفر العامر","https://www.poetsgate.com/ViewPoem.aspx?id=50393",""],[45,"سَلامٌ عَلَيْكُمْ، لا وَفَاءٌ وَلاَ عَهْدُ","https://www.poetsgate.com/ViewPoem.aspx?id=31425",""],[117,"مراكش (عندا علي)(1)","https://www.aldiwan.net/poem24035.html","الوافر"],[135,"لهذه الأسباب قد حكمنا","https://www.aldiwan.net/poem49101.html","الرجز"],[143,"أرى الشرف الأعلى إليك مسلما","https://www.aldiwan.net/poem11811.html","الطويل"],[150,"إلى الله فلترفع أكف الخلائق","https://www.aldiwan.net/poem68501.html","الطويل"],[150,"لكل نبي عصمة وأمانة","https://www.aldiwan.net/poem68578.html","الطويل"],[169,"صداق المعالي مشرفي وذابل","https://www.aldiwan.net/poem1647.html",""],[185,"لهذا الجلال الذي لا يرام","https://www.aldiwan.net/poem14664.html","المتقارب"],[223,"أودك جاحظة المقلتين","https://www.aldiwan.net/poem41903.html","المتقارب"],[261,"لهذا بجود الغيث ما لاح بارقه","https://www.aldiwan.net/poem38147.html","الطويل"],[261,"أقول لحر ساءه الدهر والنوى","https://www.aldiwan.net/poem38251.html","الطويل"],[261,"أألزم قلبي فيك حبك والصبرا","https://www.aldiwan.net/poem38279.html","الطويل"],[261,"لقد آن إعراضي عن الغي جانبا","https://www.aldiwan.net/poem38364.html","الطويل"],[366,"أبى الغمض والتمهيد جفناي والجنب","https://www.aldiwan.net/poem17158.html","الطويل"],[377,"سموت الأنبيا يا بكر علما","https://www.aldiwan.net/poem66898.html","الوافر"],[377,"بمولد مريم العذراء تمت","https://www.aldiwan.net/poem66963.html","الوافر"],[416,"لهذي النوق تنحط كلالا","https://www.aldiwan.net/poem54004.html","الرمل"],[432,"خليلي اتركا ما تعدلاني","https://www.aldiwan.net/poem12479.html","الوافر"],[441,"لهذا خلقنا والجديد سيخلق","https://www.aldiwan.net/poem14465.html","الطويل"],[465,"في رحاب الحسين","https://www.aldiwan.net/poem59034.html","عموديه"],[495,"لو كان بالدهر لحر يدان","https://www.aldiwan.net/poem10281.html","السريع"],[558,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[558,"أنا البرق والرب المناجي هو الرعد","https://www.aldiwan.net/poem34590.html","الطويل"],[562,"لهذا الفرق دان الفرقدان","https://www.aldiwan.net/poem52922.html","الوافر"]],"verses":[["لِهَذِهِ كانَ الزَمانُ يُنتَظَر","لَم يَبقَ مِن بَعدِكَ لِلمَجدِ وَطَر",0,"ر",1,1],["لَهُ ذَيْلٌ يُشِيرُ بِه دَلاَلاً","إلا ذَاتِ الشَّمَالِ أَوِ الْيَمِينِ",1,"ن",1,0],["لهذا اليوم في التأريخ ذكر","به الآناف يفغمهنّ طيب",2,"ب",1,1],["له ذَمَرات حين يوعد قِرنهُ","تكاد له صُم السِّلام تَفطَّر",3,"ر",1,0],["له ذكاء الفتى وقد كمُلت","فيه على ذاك حُنكةُ النَصف",4,"ف",1,0],["له ذِكَرٌ إليها مُستراحٌ","وناحيةٌ إليها مُستنامُ",5,"م",1,0],["لِهَذا اليَومِ بَعدَ غَدٍ أَريجٍ","وَنارٌ في العَدوِّ لَها أَجيجُ",6,"ج",1,1],["لَهُ ذَنَبٌ مِثلُ الرَشاءِ يَجُرُّهُ","وَمَتنٌ كَمَتنِ القَوسِ أَعوَجَ مُنئَدُّ",7,"د",1,0],["له ذَنَبٌ مُسْتَنْبَطٌ منه سَوْطُهُ","ترَى الأرض منه وهي مضروبة الظهرِ",8,"ر",1,0],["لَهُ ذَنَبٌ مثلَ ذيلِ العَرُوسِ","عَلَى سُبَّةٍ مثلِ حُجرِ اللَّجَم",9,"م",1,0],["لِهَذَا الفَنِّ سِحْرٌ","يَصْحَبُ الإِبْدَاعَ وَالحِذْقَا",10,"ق",2,0],["لهذا التمادي آخر بعد آخر","أليس له بدآن: أصل، ووافد؟",11,"د",1,0],["لهذا تغني بدون انقطاع","تثور على وجهك (ابن الحرام)",12,"م",1,0],["لَهُ ذَنَبٌ مثلُ الرِّشَاءِ يَجُرّهُ،","وَمَتنٌ كَمَتنِ القَوْسِ أعوَجُ، مُنْأدّ",13,"د",1,0],["لِهذا اللَّيلِ شَمْسٌ مَشْرِقِيَّهْ","و(عند علي) طَلْعَتُها بَهِيَّةْ",14,"ي",2,1],["لهذه الأسباب قد حكمنا","للرافعي بالنصف إذ قسمنا",15,"ن",2,1],["لِهَذا العُلى مُلكٌ بِغَيرِ مُشارِكٍ","لِأَكرَمِ مَن أَعطى وَأَشرُفِ مَن سَما",16,"م",2,0],["له ذخر النصر المبين على العدا","وإن شئت فلتسأل بطون المفارق",17,"ق",1,0],["لَهُ ذِمَّةٌ يُثنى مِنَ العَرشِ حَبلُها إِلى","حَبلُها إِلى الفَرشِ مَمدوداً عَلى الخَلقِ ظِلُّها",18,"ه",2,0],["لَهُ ذِروَةُ المَجدِ المُؤَثَّلِ وَالعُلى","إِذا اِنشَعَبَت يَومَ الفَخارِ القَبائِلُ",19,"ل",1,0],["لِهذا الجلال الذي لا يُرامُ","مَعانِ تَحَيَّر فيها الكلامُ",20,"م",1,1],["لِهذا أَودُّكِ فَوق الوُجود","وَفَوقَ عَناصِرِ هذا الفَلك",21,"ك",1,0],["لهذا بجود الغيث ما لاح بارقه","ومن فيك لي برق لقد ضن ثادقه",22,"ق",2,1],["له ذروة الدار التي فضل الوري","بادرا كها فضل الوقار على الطيش",23,"ش",1,0],["له ذمة لا تقرأ الغدر من وفا","بها ولو ان الدهر حرره سطرا",24,"ر",2,0],["له ذروة المجد المؤثل هامها","ينكس هاماً للسهى ومناكبا",25,"ب",2,0],["لِهَذا الهَوى بابٌ وَسَهلٌ دُخولُهُ","كَما كانَ لَكِنَّ الخُروجَ هُوَالصَعبُ",26,"ب",1,0],["لهذا كنت في العهدين حدّاً","به وقف الكمال بمن حملتِ",27,"ت",1,0],["لهذا يفرح الثالوث حقّاً","مع الآبا وحزب الأولياء",28,"ا",2,0],["لهذي النُّوقِ تنحَطُّ كَلالا","وتَجوبُ البيد حِلاًّ وارتحالا",29,"ل",2,1],["له ذِكْرٌ علا فوق الثريا","وجاهٌ من ذوي الحاجاتِ داني",30,"ي",1,0],["لهذا خلقنا والجديد سيخلق","وما ترتق الآمال فالموت يفتق",31,"ق",1,1],["لهذا وَقفنا عُراةَ الجراح","كباراً على لؤمِها الألأمِ",32,"م",1,0],["لهذه العزة حيث الفلا","قد عفت أرضي وتركت الهوان",33,"ن",1,0],["له ذخائر اسراري أوجهها","وهو اختباري وأعلى مبتغى هممي",34,"م",2,0],["لهذا متى ذو اللبس يخلو بربه","يسيءُ له الآداب يغلبه الفقد",35,"د",1,0],["لِهذا الفَرْقِ دانَ الفَرْقدانِ","على خَجَلٍ فليسَ الفَرْقُ داني",36,"ي",1,1]]}