aspx?id=187724",""],[5295,"أنين","https://www.poetsgate.com/ViewPoem.aspx?id=171625",""],[5377,"تحية الخروج من العزلة","https://www.poetsgate.com/ViewPoem.aspx?id=61892",""],[5409,"روحي النس لا يهم الزمانا","https://www.poetsgate.com/ViewPoem.aspx?id=155516",""],[5431,"مات طفلي...","https://www.poetsgate.com/ViewPoem.aspx?id=202275",""],[5459,"إن الحياة معارك ..","https://www.poetsgate.com/ViewPoem.aspx?id=194011",""],[5512,"بباب الحي","https://www.poetsgate.com/ViewPoem.aspx?id=204219",""],[470,"الوهم","https://www.poetsgate.com/ViewPoem.aspx?id=177985",""],[470,"يا سيدى المتنبى","https://www.poetsgate.com/ViewPoem.aspx?id=63453",""],[5582,"هَلْ لِلنَّوَى ذلِكَ الظَّبْيُ الأَغَنُّ سَرَى","https://www.poetsgate.com/ViewPoem.aspx?id=63509",""],[5596,"مجلس الدولة","https://www.poetsgate.com/ViewPoem.aspx?id=206753",""],[5691,"أسرجوا خيلكم...!","https://www.poetsgate.com/ViewPoem.aspx?id=206157",""],[5756,"الجريمة","https://www.poetsgate.com/ViewPoem.aspx?id=5418",""],[5762,"إقرأ كتابك","https://www.poetsgate.com/ViewPoem.aspx?id=13131",""],[5829,"رسالة إلى أمي في ذكرى وفاتها","https://www.poetsgate.com/ViewPoem.aspx?id=175530",""],[5897,"بشائر على أبواب المدينة","https://www.poetsgate.com/ViewPoem.aspx?id=157555",""],[5903,"لي هوىً","https://www.poetsgate.com/ViewPoem.aspx?id=124149",""],[5952,"لا تبتئس","https://www.poetsgate.com/ViewPoem.aspx?id=196903",""],[6096,"من دون وداع","https://www.poetsgate.com/ViewPoem.aspx?id=177528",""],[6223,"أعتقيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1205&r=&rc=12",""],[6237,"الحب الكاذب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77889&r=&rc=31",""],[6265,"المهاجرة اليمنية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84177&r=&rc=0",""],[6285,"هذه الشام لا تقولي كفانا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86807&r=&rc=0",""]],"verses":[["وَاِستَفظَعوا خِلَعَ المُلوكِ وَأَيقَنوا","أَنَّ اللِباسَ لَها اِدراعُ العاري",0,"ر",2,0],["وَاِستَفسَحوا الأَعطانَ وَالرِحابا","وَطَبَّقوا السُهولَ وَالعِقابا",1,"ب",2,0],["وأسْتَفُّ تُرْبَ الأرضِ إنْ عَضّني الطّوى","ويُجْزِئُ عنْ لَسِّ الغُمَيْرِ هَشيمُ",2,"م",1,0],["واستفاضت يقظة الصحرا على","هجعة الأكوان بعثاً وقياما",3,"م",2,0],["واستفحلت فتنة عمياء جائحة","تَمخّضت عن دم في الأرض مسفوح",4,"ح",1,0],["واستفتح الباب الذي دونها","تفتح لدى فتحكه قلعه",5,"ع",2,0],["واستفادوا بشاشةً وسروراً","ينفيانِ الشرورَ والأحزانا",6,"ن",2,0],["وَاِستَفتِ أَصداءَ القُبورِ فَإِنَّها","لَتَبينُ عَن مَعنى الحَياةِ وَتُعرِبُ",7,"ب",1,0],["وَأَستَفُّ تُربَ الأَرضِ كَيلا يَرى لَهُ","عَلَيَّ مِنَ الطَولِ اِمُرؤ مُتَطَوَّلُ",8,"ل",1,0],["واِستفهمت إِن كُنتُ ذا علةٍ","أَو ذا اِشتياقٍ نارُهُ تُسعَرُ",9,"ر",1,0],["واستفدْ يا زمانُ عطفاً ولطفاً","في هواها من خلقِهِ المشكورِ",10,"ر",1,0],["وَاِستَفَّ في نُطَفِ النُجومِ عَلى السُرى","وَاِلتَفَّ في وَرَقِ الظَلامِ الأَخضَرِ",11,"ر",1,0],["وَاِستَفهِموها مَن سَقاكِ وَما دَرَوا","ما اِستودِعَت مِن مَبسِمٍ وَجُفونِ",12,"ن",1,0],["واسْتَفْرِغِ الدَّمْعَ مِنْ عَيْنٍ قد امْتَلأَتْ","مِنَ المَحارِمِ وَالْزَمْ حِمْيَةَ النَّدَمِ",13,"م",1,0],["وَاسْتَفْتَحُوا بَرْلِينَ وَهْيَ مَنِيعَةٌ","وَقَضَوْا بِهَا الأَيَّامَ كَالأَعْيَادِ",14,"د",1,0],["وَاسْتَفْتَحُوا بَارِيسَ فَاسْتَوْفوْا بِهَا","أَوْتَارَهُمْ وَشَفَوْا صَدَى الأَكْبَادِ",14,"د",1,0],["واستَفْتِ قلبَكَ فيما أنتَ فاعلُهُ","ما دْمتَ تَرْعَى الحمى، والحقَّ، والحَسَبَا",15,"ب",2,0],["واستفْتِ هذا الثغرَ عن تاريخِهِ","فالعلم -قبل الماءِ- منه تفجَّرا",16,"ر",2,0],["واستفاقت مواطن العرب الش","مّ فعودي يا راية العرب عودي",17,"د",2,0],["واستفرَشَ الشعْبُ الثرى ، ودُروبهُمْ","مملوءةٌ بنُثارةِ الأزهار!",18,"ر",1,0],["وا;ستفرِشِي صُمَّ الحَصَى","وَتَلَحَّفي ظُلَلَ الغَمَامِ",19,"م",1,0],["واستفزتنا عيونهم","فخلعنا البيضَ والأسلا",20,"ل",2,0],["وَاستَفَزَّ الحُلُومَ حتى ازدَهَاهَا","وسنَا البَرقِ يَستَفِرُّ الحُلُومَا",21,"م",2,0],["واستفهموا الطيف وقالوا له","تعلَم من عشَّاقِنا مَن بقِى",22,"ق",2,0],["وَاِستَفاضت أخبارهُ في البرايا","فَحَكاها الملّاح والحدّاءُ",23,"ا",2,0],["واِستفاضَت بصدقهِ معجزاتٌ","بعضُها كلُّ ما أتى الأنبياءُ",23,"ا",2,0],["واستفرت أخت ونادت طفلة","والكل منهم شقة ما يجمل",24,"ل",1,0],["واستفدْ من خزرِ الصحا","بِ فكم لآلٍ في السموطِ",25,"ط",1,0],["وَاِستَفاقَت مِن نَومِهِنَّ العَذارى","حائِراتٍ وَالعاشِقونَ اِستَفاقوا",26,"ق",3,0],["وَاِستَفاقَ الجَميعُ مِن نَشوَةِ الخَم","رَةِ حَتّى الآمالِ وَالأَشواقِ",26,"ق",1,0],["وَاِستَفاقَ المَريضُ من هَذَيانِه","وَلَهيبُ النيرانِ في أَجفانِه",27,"ن",2,1],["وَاِستَفاقَ المَسيحُ من سُكرَةِ الحُ","بِّ يخالُ السَماءَ أَمسَت ضراما",28,"م",2,0],["وَاسْتَفَدْنَا قَرَائِحاً تَنْظِمُ الشِّعْ","رَ الْبَدِيعَ الْحُلَى الأَنِيقَ الْجِنَاسِ",29,"س",1,0],["واستفحل الجهال واشتد البلا","واستصغر العلماء حزب الأمين",30,"ن",1,0],["واِستفرَغَتهُ صَباباتي فما بقيَت","بَعدي لأَهل الهوى إلّا صباباتُ",31,"ت",1,0],["وَاِستَفاضَت مِنَ العُيونِ الدُموعُ","فَإِذا الشَمسُ تَستَحي مِن سَناها",32,"ا",1,0],["وَاِستَفصَحَت عِبارَةً الهِزارِ","فَهوَ لمَنشورِ الرَبيعِ قاري",33,"ي",1,0],["وإستفرقت في ذاته مستمدةً","سناه وذا قد أدركت في المحبة",34,"ه",1,0],["واستفاقت تنفض الطل وقد","سألت أين نسيم الروض منا",35,"ن",2,0],["واستفاقوا يدبرون خلاصاً","من هلاك قد ضمهم في الحباله",36,"ل",2,0],["واستفرّت ظبيّة وتبدّت","بدرتم واسترخصت كل غال",37,"ل",1,0],["واستفادَ الدهرُ من آدابِه","بعدما كان اعتدى فاعْتَدَلا",38,"ل",2,0],["واسْتَفْتِحِ الدَّهرَ أبواباً مفاتِحُها","إمَّا سيوفُكَ فِي الأعداءِ أو نِعَمُكْ",39,"ك",1,0],["وأَستَفْظِعُ الشَّهْدَ اللذِيذَ مَذَاقُهُ","لِمَطْعَمِهِ الموجودِ فِي شَفَتَيْكِ",40,"ك",1,0],["واسْتَفْتَحَ الكَعْبَةَ العَلْياءَ فافْتُتِحَتْ","لَهُ إِلَى الجَنَّةِ الأَبوابُ والشِّرَعُ",41,"ع",1,0],["واستفادتْ نفسُه من كسبهِ","شرفا زاد عليها وعَلاها",42,"ا",3,0],["واستفتهم في المجدِ تسألْ أنفساً","لَقِنتْ على جهل الورى وتفهَّمتْ",43,"ت",1,0],["واستفرغ الجهد في التأديب مبتدئا","فيك النصيحة واسترسل الى الأخر",44,"ر",1,0],["واستفت غادية صبا هل صافحت","مثل التراح مثخنا بتراح",45,"ح",1,0],["واِستَفرَشوا ولبسوا الد","دِيباجَ والإستبرَقا",46,"ق",2,0],["وَاِستَفتَحوا القُدسَ وَالبِلادِ وَلَم","يَعصِ عَلَيهِم بَدوٌ وَلا حَضَرُ",47,"ر",1,0],["واستفرغ الأجفان من در مدمعي","بما ملأ الأحداق منه محمد",48,"د",1,0],["واستفادوا نعيمها واستزادوا","رغدهم في حفاظها والذمار",49,"ر",1,0],["واستفاضُوا بقتلِ بسطامٍ الذكْ","رَ فأكْرِمْ بذكرِهِ المستفاض",50,"ض",1,0],["واسْتَفَاضَ السُّرُورُ في سَائِرِ ال","نَّاسِ بِمُلْكِ الْمُهَذَّبِ الْفَيَّاضِ",51,"ض",1,0],["واستفرغ العبرة حتى نضبت","فاستأنف البكا على فقد البكا",52,"ا",1,0],["واستفتِ نفسك واحذَرْ من دسائسها","وكن لسنَّةِ خير الخلق متّبعا",53,"ع",2,0],["وَاِستفتحت منهُ قسراً ثمَّ قيلَ له","عَفواً لَكَ اليوم إنّ الذنبَ قَد غُفِرا",54,"ر",2,0],["وَاِستفرغَ الجيشَ من خيلٍ ومن رجلٍ","قتلاً وقتل صغير الشرِّ قد كبرا",54,"ر",2,0],["واستفزوا مرابض الشام حتى","خنق الضيمُ في الجوانح صبرا",55,"ر",2,0],["واستفاق العلم من رقدته","مشرقَ الطلعة جبارَ الجهود",56,"د",1,0],["واستفاق الفجر من أحلامه","شاحب الألوان معتل الضياء",57,"ا",2,0],["واستفاقت على يديك الأماني","حالمات الألوان والأوراد",58,"د",1,0],["واستفصل العمل الموصول في سعة ال","اطلاق بالامل المقى باثباته",59,"ت",2,0],["واستفقحوني واستنكهوه تروا","أن لسرمي فضلاً على فيه",60,"ي",2,0],["واستفرغ الوسع حتى طم خا","دمك المهلبي وقاسى فيه أشجانا",61,"ن",2,0],["وَاسْتَفْتِ عَمَّا غَابَ عَنْكَ لحاظَهُ","فاللَّحْظُ يعرِفُ منه هَدْيَ المُهْتَدِي",62,"د",2,0],["وَاستَفَزَّ السُرورُ مَغناهُ وَاهتَز","ز بِمَن فَوقَ أَرضِهِ مِن ندامه",63,"م",2,0],["واستفَّ يسترسلُ في المنكرات","مستهلكاً ثروته بالقمار",64,"ر",1,0],["وَاِستَفتِ بُقراطاً فَما في طِبِّهِ","مِثلَ الصِيامِ لِصِحَّةِ الأَبدانِ",65,"ن",1,0],["وَاستفاد الهِلال مِنكَ ضِياءً","حينَ قابلته بِشَمس الجَبين",66,"ن",1,0],["واستفاض الليل فيها فيضة","أيقن النجم لها بالغرق",67,"ق",1,0],["واستفزت صبابة نغمة الو","رق وهاج الجوى جفون النسيم",68,"م",1,0],["واِستفرغ الدمع من عَين قد امتلأت","وَالأزم يشفى كَما قالوا بطبهم",69,"م",1,0],["وَاستفرغ الدمع مِن عَين قَد امتَلأت","مِن نَظرة السوء للعورات وَالحرم",70,"م",1,0],["واستفاد الموظفون زيادا","ت اغاثت بخيرها المستفاض",71,"ض",1,0],["واستفادت من بطن نعمان طيباً","فشذاه ينباع من ذفراها",72,"ا",3,0],["واستفتحي باب الرموز تمدنا","بالسحر لفظًا صادقًا وخيالا",73,"ل",2,0],["واستفهمت مع علمها بحقيقتي","أ