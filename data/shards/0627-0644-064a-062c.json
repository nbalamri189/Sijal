{"poems":[[55,"أسائل سيفي أي بارقة تجدي","https://www.aldiwan.net/poem30621.html","الطويل"],[95,"وارحمتا لمصاب","https://www.aldiwan.net/poem11151.html","المجتث"],[32,"ألا حييا بالزرق دار مقام","https://www.aldiwan.net/poem29529.html","الطويل"],[23,"سائل قريشا وأحلافها","https://www.aldiwan.net/poem21470.html","المتقارب"],[74,"بكيت وما يجدي البكاء على العاني","https://www.aldiwan.net/poem20162.html","الطويل"],[87,"قفوا بالقبور نسائل عمر","https://www.aldiwan.net/poem62868.html","المتقارب"],[76,"بمثل علاك من ملك حسيب","https://www.aldiwan.net/poem12865.html","الوافر"],[42,"إلى جيداء قد بعثوا رسولا","https://www.aldiwan.net/poem42262.html","الوافر"],[77,"أما والمذاكي يلكن الشكم","https://www.aldiwan.net/poem69039.html","المتقارب"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85390","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39595","الطويل"],[98,"صدى الوحي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66383&r=&rc=59",""],[118,"أرقت فبت لم أذق المناما","https://www.aldiwan.net/poem20956.html","الوافر"],[189,"نحا البين في تشتيت شملي مقاصدا","https://www.aldiwan.net/poem14496.html","الطويل"],[193,"مقام أجل الرسل أعلى وأعظم","https://www.aldiwan.net/poem35106.html","الطويل"],[215,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[240,"ترى الظاعن الغادي مقيما على العهد","https://www.aldiwan.net/poem32031.html","الطويل"],[280,"أتجحد قتلي ربة الشنف والخرص","https://www.aldiwan.net/poem25494.html","الطويل"],[285,"ويوم أخذنا به فرصة","https://www.aldiwan.net/poem60709.html","المتقارب"],[287,"هنيئا لقد أوتيت سؤلك يا موسى","https://www.aldiwan.net/poem32738.html","الطويل"],[358,"أعد ذكر ربع البان سفحا وأجرعا","https://www.aldiwan.net/poem40148.html","الطويل"],[369,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[402,"وارحمتا لمصاب","https://www.aldiwan.net/poem11022.html","عموديه"],[409,"أتسأل عن رحيلي يا بن ودي","https://www.aldiwan.net/poem33966.html","الوافر"],[416,"أفي كل يوم أنت صب وليلة","https://www.aldiwan.net/poem67502.html","الطويل"],[422,"سأبكي وأستبكي عليك المعاليا","https://www.aldiwan.net/poem53972.html","الطويل"],[422,"مضى سيد من غر أبناء هاشم","https://www.aldiwan.net/poem54067.html","الطويل"],[422,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[443,"هناء أيها الملك السعيد","https://www.aldiwan.net/poem2544.html","الوافر"],[510,"الوصيّة","https://www.aldiwan.net/poem27795.html","الطويل"],[519,"يا طرس إن جئت عني صاحب المن","https://www.aldiwan.net/poem20894.html","المواليا"],[563,"قلوبنا بك أبلتها النوى كمدا","https://www.aldiwan.net/poem34643.html","البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83317","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66653","الوافر"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54182","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63815","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38333","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59619","الطويل"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17577","الطويل"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96579","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96699","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96720","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126124","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64878","البسيط"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78181","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50008","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49924","البسيط"],[1470,"","https://poetry.dctabudhabi.ae/diwan/poem/216503","الطويل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35758","المتقارب"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113957","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77906","المتقارب"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49590","الرجز"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101032","البسيط"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11151","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27529","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27269","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/141739","الطويل"],[2390,"","https://poetry.dctabudhabi.ae/diwan/poem/199135","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60894","البسيط"],[2598,"","https://poetry.dctabudhabi.ae/diwan/poem/17414","الطويل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102535","الوافر"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87337","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87339","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87335","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2664,"","https://poetry.dctabudhabi.ae/diwan/poem/143108","الطويل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205421","الهزج"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112511","البسيط"],[3484,"","https://poetry.dctabudhabi.ae/diwan/poem/216392",""],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48321","الطويل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102388","الطويل"],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26954","السريع"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45760","الطويل"],[3640,"","https://poetry.dctabudhabi.ae/diwan/poem/141895","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91075","الطويل"],[3810,"","https://poetry.dctabudhabi.ae/diwan/poem/18717","الوافر"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123504","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94880","الوافر"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127927","الرجز"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146767","الوافر"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83182","البسيط"],[4562,"","https://poetry.dctabudhabi.ae/diwan/poem/199212","المجتث"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139475",""],[4691,"حنين للطفولة !!","https://www.poetsgate.com/ViewPoem.aspx?id=111815",""],[4728,"على قبر أبي","https://www.poetsgate.com/ViewPoem.aspx?id=176882",""],[4767,"دوحة الآداب","https://www.poetsgate.com/ViewPoem.aspx?id=194943",""],[4797,"صباح الغلا المنقي من الشك والتزوير","https://www.poetsgate.com/ViewPoem.aspx?id=132230",""],[4964,"هم رحلوا يوم الخميس عشيّةً","https://www.poetsgate.com/ViewPoem.aspx?id=191702",""],[5038,"تراتيل وموّال","https://www.poetsgate.com/ViewPoem.aspx?id=189578",""],[5183,"إلى الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=180189",""],[5302,"قرب الخليل","https://www.poetsgate.com/ViewPoem.aspx?id=200554",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[5371,"إلى جيرة بالحي لي مهجة تصبو","https://www.poetsgate.com/ViewPoem.aspx?id=170925",""],[5431,"وحقك لاتعتب....","https://www.poetsgate.com/ViewPoem.aspx?id=214590",""],[5663,"فلينبت القمح","https://www.poetsgate.com/ViewPoem.aspx?id=200907",""],[5718,"\"إلهى\"","https://www.poetsgate.com/ViewPoem.aspx?id=213785",""],[5953,"سئمت المقام بأرض الشّام","https://www.poetsgate.com/ViewPoem.aspx?id=93800",""],[5956,"إلى جنات عدن","https://www.poetsgate.com/ViewPoem.aspx?id=181920",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6149,"شهدت ليس الشهد غير ريقه","https://www.poetsgate.com/ViewPoem.aspx?id=169627",""],[6175,"عبيدكَ ليسوا حَجَرْ!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72850&r=&rc=75",""]],"verses":[["إِلى جَدِّهِ تُنمى شَمائِلُ مَجدِهِ","وَهَل تَرجِعُ الأَشبالُ إِلّا إِلى الأُسدِ",0,"د",1,0],["إِلَى جُرُوحِكَ يُهْدِي","صُبَابَةً مِنْ جُرُوحِهْ",1,"ح",2,0],["إِلى جَنبِ مَأوى جامِلٍ لَم تَدَع بِهِ","مِن العُنَنِ الأَرواحُ غَيرَ حُطامِ",2,"م",1,0],["إِلى جِذمِ قَينٍ لَئيمِ العُروقِ","عُرقوبُ والِدِهِ أَصهَبُ",3,"ب",1,0],["إلى جبلٍ من حلمه يقرع الثنا","إذا غاص من جدواه في فيض طوفان",4,"ن",1,0],["إِلى جَنَّةٍ خُلِقَت لِلكَريمِ","وَمَن عَرَفَ اللَهَ أَو مَن قَدَر",5,"ر",1,0],["إِلى جَذلانَ وَضّاحِ المُحَيّا","سَليمِ القَلبِ وَالصَدرِ الرَحيبِ",6,"ب",1,0],["إِلى جَبَلٍ أَصُدُّ بِهِ العَوادي","وَأَقتادُ المُنى قَودَ الجَنيبِ",6,"ب",1,0],["إِلى جَيداءَ قَد بَعَثُوا رَسُولاً","لِيُخبِرَها فَلا صُحِبَ الرَسُولُ",7,"ل",1,1],["إلى جَعْفَرٍ يَتَنَاهَى المديحُ","وفِيهِ تُثِيرُ القَوافي الحِكَم",8,"م",1,0],["إلى جدث داجي القرارة ضيقٍ","يجاور أَجداثاً بُنينَ عَلى تل",9,"ل",1,0],["إلى جبلِ النورِ انتهى سرُّ وحيهِ","وما هو إلا ملهِمُ اليومِ والغدِ",10,"د",1,0],["إلى جبل النّور انتهى وحيه","وما هو إلا ملهم اليوم والغد",11,"د",1,0],["إِلى جَدَثٍ بِجَنبِ الجَوِّراسٍ","بِهِ ما حَلَّ ثُمَّ بِهِ أَقاما",12,"م",2,0],["إلى جانبَي قصرِ الدخان مغربا","إلى المُقْس رَوى العهدُ تلك المعَاهِدا",13,"د",2,0],["إِلى جنّةٍ أو لا فتلكَ جهنّمُ","عليهِ عبادَ اللَّه صلّوا وسلّموا",14,"م",3,0],["إلى جفن الحمى بالثغر عادوا","كما عاد الجراز إلى القراب",15,"ب",1,0],["إِلى جَدِّهِ المَنصورِ يَنزَعُ جَدُّهُ","فَناهيكَ مِن جَدٍّ سَعيدٍ وَمِن جَدِّ",16,"د",1,0],["إلَى جُودِهِ تَثنِي الأَمانِي وُجُوهَها","ومَنْ يَتَعَدَّ القَبْضَ أَفْضَى إلَى القَبْصِ",17,"ص",1,0],["إِلى جَنَّةٍ لا مَدى عَرْضِها","يَضِيقُ وَلا ظِلُّها يَقْلِصُ",18,"ص",1,0],["إلى جودِهِ أَشكو مِنَ الكُرَبِ الَّتي","أُؤَمِّلُ أَن أَلقى لَها مِنهُ تَنفيسا",19,"س",2,0],["إِلى جيرَةٍ في السوح من يَستجِر بهم","تَمنّى وَعَن جور الزَمان تَمنَّعا",20,"ع",2,0],["إلى جاعلٍ عزاً مكانِيَ عَيْنَه","ومَن يَعشَقِ العلياءَ بالوفدِ يَلْهَج",21,"ج",1,0],["إلى جروحك يهدي","صبابنة من جروحه",22,"ح",2,0],["إلى جبل الوقار وخير بر","وأفضل كل ذي علم وزهد",23,"د",1,0],["إِلى جَعفَرٍ سارَت بِنا كُلُّ جَسرَةٍ","طَواها سُراها نَحوَهُ وَالتَهَجُّرُ",24,"ر",1,0],["إلى جنَّة الفردوسِ والعفو والرّضى","وفي رحمة الرَّحمن أَصْبَحتَ ثاويا",25,"ي",2,0],["إلى جنَّة الملوى إلى العفو والرضا","إلى رحمة الله الَّتي تتجدَّد",26,"د",1,0],["إلى جانب أصبو وتصبو لجانب","فما بالنا لم نتَّفق في المذاهب",27,"ب",1,0],["إلى جدوال أضحى الناس صورا","وشخصك قبلتي ولك السجود",28,"د",1,0],["إلى جنّة الصّبا بغزةَ ميلي","وفي ظلِّ برتقال فاطمَ قيلي",29,"ل",2,1],["إلى جنابهِ سلمت ركائبك عنّي","واِلثم يمينه أمانة يا طرس عنّي",30,"ي",1,0],["إلى جنابك قلباً سالماً ويدا","عودتنا الخير واستعبدت سائبة",31,"ه",1,0],["إِلى جانِبِ الوَرقاءِ تَندُبُ في الدُجى","شَجبَينِ طولُ اللَيلِ نَشكو وَنَندُبُ",32,"ب",1,0],["إلى جامع الإجماع في يوم جمعة","أشاهده في كل غيب وشاهد",33,"د",1,0],["إلى جُحر له فانساب فيه","بعيدِ القعر لم يُرتَجْ ببابِ",34,"ب",1,0],["إلى جدثٍ بيتِ التغريب والبلى","يقيمُ به حتى القيامةِ والحشرِ",35,"ر",1,0],["إلى جَنَّةٍ زهراءَ تزدادُ زهرةً","بما واجهتْ منهمْ من الأوجِهِ الزُّهْر",36,"ر",1,0],["إِلى جَنّةِ الدّنيا وَجَبهَةِ حُسنِها","وَغُرَّتِها البيضاءِ وَالفَضل زائِدُ",37,"د",1,0],["إلى جبل بالفتح يصدُق فَالُه","فبعد تَولي العسر لا بُد من يُسر",38,"ر",1,0],["إِلَى جَنبِها أُختٌ لَها يَعرِضونَها","وَعِندَكَ مالٌ لِلهِباتِ عَتيدُ",39,"د",1,0],["إِلى جؤجؤ مثل المداك جرت به ال","أَكف على مسفوحة الخلق عندلِ",40,"ل",1,0],["اليجشبيّ الأمجد الملك الّذي","أَفنت مَواهبهُ جزيل المالِ",41,"ل",1,0],["اليجشبيّ الأمجد الملك الّذي","شَرقت بِبهجةِ ملكهِ أيّامهُ",42,"م",2,0],["إلى جنايه الرفيع من لجا","فانه به من السوء نجا",43,"ج",2,0],["إلى جنابِكَ يَلْجَا كلُّ مَلْهوفِ","ومِنْ ثَوابِكَ يُرْجَى كلُّ مَعروفِ",44,"ف",1,1],["إِلى جامع الصِدق الرَفيع مَنارَهُ","إِلى البُقعَة الخَضراءِ وَالرَفرف الأَسنى",45,"ن",2,0],["إلى جبل الأزد المحامين دونه","بجُرد المذاكي والوشيج الموكّلِ",46,"ل",1,0],["إلى جوادٍ شُجِاعٍ ذي ندىً وَرَدىً","بالجود والبأسِ مَرْجُوٍ ومَرهوبِ",47,"ب",1,0],["الى جولة أخرى تدوّى عنيدة","وتصرخ بالأحرار والخيل والقضب",48,"ب",1,0],["إِلى جَعفَرٍ نَزَعَت رَغبَةٌ","وَأَيُّ فَتىً نَحوَهُ تَنزِعُ",49,"ع",1,0],["إليَ جعفَر حبِّ النبي وابنِ عمِّهِ","هُوَ الفَحلُ من يكلَف مساعيهِ يظلَعِ",50,"ع",1,0],["إِلى جنة الخلد فاِستيقظي","وَقومي لربك واِستنهضي",51,"ي",1,0],["إلى جَنَابٍ للأمانِ خَضل","تَعانَقَ الوسميُّ فيهِ والولي",52,"ل",2,0],["إلى جهينة ينمي فرعه نسبٌ","له على المجد إشرفاٌ وإطلال",53,"ل",1,0],["