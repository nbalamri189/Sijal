{"poems":[[55,"أسائل سيفي أي بارقة تجدي","https://www.aldiwan.net/poem30621.html","الطويل"],[95,"وارحمتا لمصاب","https://www.aldiwan.net/poem11151.html","المجتث"],[32,"ألا حييا بالزرق دار مقام","https://www.aldiwan.net/poem29529.html","الطويل"],[23,"سائل قريشا وأحلافها","https://www.aldiwan.net/poem21470.html","المتقارب"],[74,"بكيت وما يجدي البكاء على العاني","https://www.aldiwan.net/poem20162.html","الطويل"],[87,"قفوا بالقبور نسائل عمر","https://www.aldiwan.net/poem62868.html","المتقارب"],[76,"بمثل علاك من ملك حسيب","https://www.aldiwan.net/poem12865.html","الوافر"],[42,"إلى جيداء قد بعثوا رسولا","https://www.aldiwan.net/poem42262.html","الوافر"],[77,"أما والمذاكي يلكن الشكم","https://www.aldiwan.net/poem69039.html","المتقارب"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85390","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39595","الطويل"],[98,"صدى الوحي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66383&r=&rc=59",""],[118,"أرقت فبت لم أذق المناما","https://www.aldiwan.net/poem20956.html","الوافر"],[189,"نحا البين في تشتيت شملي مقاصدا","https://www.aldiwan.net/poem14496.html","الطويل"],[193,"مقام أجل الرسل أعلى وأعظم","https://www.aldiwan.net/poem35106.html","الطويل"],[215,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[239,"ترى الظاعن الغادي مقيما على العهد","https://www.aldiwan.net/poem32031.html","الطويل"],[279,"أتجحد قتلي ربة الشنف والخرص","https://www.aldiwan.net/poem25494.html","الطويل"],[284,"ويوم أخذنا به فرصة","https://www.aldiwan.net/poem60709.html","المتقارب"],[286,"هنيئا لقد أوتيت سؤلك يا موسى","https://www.aldiwan.net/poem32738.html","الطويل"],[357,"أعد ذكر ربع البان سفحا وأجرعا","https://www.aldiwan.net/poem40148.html","الطويل"],[368,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[401,"وارحمتا لمصاب","https://www.aldiwan.net/poem11022.html","عموديه"],[407,"أتسأل عن رحيلي يا بن ودي","https://www.aldiwan.net/poem33966.html","الوافر"],[414,"أفي كل يوم أنت صب وليلة","https://www.aldiwan.net/poem67502.html","الطويل"],[420,"سأبكي وأستبكي عليك المعاليا","https://www.aldiwan.net/poem53972.html","الطويل"],[420,"مضى سيد من غر أبناء هاشم","https://www.aldiwan.net/poem54067.html","الطويل"],[420,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[441,"هناء أيها الملك السعيد","https://www.aldiwan.net/poem2544.html","الوافر"],[508,"الوصيّة","https://www.aldiwan.net/poem27795.html","الطويل"],[517,"يا طرس إن جئت عني صاحب المن","https://www.aldiwan.net/poem20894.html","المواليا"],[561,"قلوبنا بك أبلتها النوى كمدا","https://www.aldiwan.net/poem34643.html","البسيط"],[1073,"","https://poetry.dctabudhabi.ae/diwan/poem/18717","الوافر"]],"verses":[["إِلى جَدِّهِ تُنمى شَمائِلُ مَجدِهِ","وَهَل تَرجِعُ الأَشبالُ إِلّا إِلى الأُسدِ",0,"د",1,0],["إِلَى جُرُوحِكَ يُهْدِي","صُبَابَةً مِنْ جُرُوحِهْ",1,"ح",2,0],["إِلى جَنبِ مَأوى جامِلٍ لَم تَدَع بِهِ","مِن العُنَنِ الأَرواحُ غَيرَ حُطامِ",2,"م",1,0],["إِلى جِذمِ قَينٍ لَئيمِ العُروقِ","عُرقوبُ والِدِهِ أَصهَبُ",3,"ب",1,0],["إلى جبلٍ من حلمه يقرع الثنا","إذا غاص من جدواه في فيض طوفان",4,"ن",1,0],["إِلى جَنَّةٍ خُلِقَت لِلكَريمِ","وَمَن عَرَفَ اللَهَ أَو مَن قَدَر",5,"ر",1,0],["إِلى جَذلانَ وَضّاحِ المُحَيّا","سَليمِ القَلبِ وَالصَدرِ الرَحيبِ",6,"ب",1,0],["إِلى جَبَلٍ أَصُدُّ بِهِ العَوادي","وَأَقتادُ المُنى قَودَ الجَنيبِ",6,"ب",1,0],["إِلى جَيداءَ قَد بَعَثُوا رَسُولاً","لِيُخبِرَها فَلا صُحِبَ الرَسُولُ",7,"ل",1,1],["إلى جَعْفَرٍ يَتَنَاهَى المديحُ","وفِيهِ تُثِيرُ القَوافي الحِكَم",8,"م",1,0],["إلى جدث داجي القرارة ضيقٍ","يجاور أَجداثاً بُنينَ عَلى تل",9,"ل",1,0],["إلى جبلِ النورِ انتهى سرُّ وحيهِ","وما هو إلا ملهِمُ اليومِ والغدِ",10,"د",1,0],["إلى جبل النّور انتهى وحيه","وما هو إلا ملهم اليوم والغد",11,"د",1,0],["إِلى جَدَثٍ بِجَنبِ الجَوِّراسٍ","بِهِ ما حَلَّ ثُمَّ بِهِ أَقاما",12,"م",2,0],["إلى جانبَي قصرِ الدخان مغربا","إلى المُقْس رَوى العهدُ تلك المعَاهِدا",13,"د",2,0],["إِلى جنّةٍ أو لا فتلكَ جهنّمُ","عليهِ عبادَ اللَّه صلّوا وسلّموا",14,"م",3,0],["إلى جفن الحمى بالثغر عادوا","كما عاد الجراز إلى القراب",15,"ب",1,0],["إِلى جَدِّهِ المَنصورِ يَنزَعُ جَدُّهُ","فَناهيكَ مِن جَدٍّ سَعيدٍ وَمِن جَدِّ",16,"د",1,0],["إلَى جُودِهِ تَثنِي الأَمانِي وُجُوهَها","ومَنْ يَتَعَدَّ القَبْضَ أَفْضَى إلَى القَبْصِ",17,"ص",1,0],["إِلى جَنَّةٍ لا مَدى عَرْضِها","يَضِيقُ وَلا ظِلُّها يَقْلِصُ",18,"ص",1,0],["إلى جودِهِ أَشكو مِنَ الكُرَبِ الَّتي","أُؤَمِّلُ أَن أَلقى لَها مِنهُ تَنفيسا",19,"س",2,0],["إِلى جيرَةٍ في السوح من يَستجِر بهم","تَمنّى وَعَن جور الزَمان تَمنَّعا",20,"ع",2,0],["إلى جاعلٍ عزاً مكانِيَ عَيْنَه","ومَن يَعشَقِ العلياءَ بالوفدِ يَلْهَج",21,"ج",1,0],["إلى جروحك يهدي","صبابنة من جروحه",22,"ح",2,0],["إلى جبل الوقار وخير بر","وأفضل كل ذي علم وزهد",23,"د",1,0],["إِلى جَعفَرٍ سارَت بِنا كُلُّ جَسرَةٍ","طَواها سُراها نَحوَهُ وَالتَهَجُّرُ",24,"ر",1,0],["إلى جنَّة الفردوسِ والعفو والرّضى","وفي رحمة الرَّحمن أَصْبَحتَ ثاويا",25,"ي",2,0],["إلى جنَّة الملوى إلى العفو والرضا","إلى رحمة الله الَّتي تتجدَّد",26,"د",1,0],["إلى جانب أصبو وتصبو لجانب","فما بالنا لم نتَّفق في المذاهب",27,"ب",1,0],["إلى جدوال أضحى الناس صورا","وشخصك قبلتي ولك السجود",28,"د",1,0],["إلى جنّة الصّبا بغزةَ ميلي","وفي ظلِّ برتقال فاطمَ قيلي",29,"ل",2,1],["إلى جنابهِ سلمت ركائبك عنّي","واِلثم يمينه أمانة يا طرس عنّي",30,"ي",1,0],["إلى جنابك قلباً سالماً ويدا","عودتنا الخير واستعبدت سائبة",31,"ه",1,0],["إِلى جَزعِ الدَواهي ذاكَ مِنكُم","مَغانٍ فَالخَمائِلِ فَالصَعيدِ",32,"د",1,0]]}