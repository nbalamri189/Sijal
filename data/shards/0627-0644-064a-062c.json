{"poems":[[53,"أسائل سيفي أي بارقة تجدي","https://www.aldiwan.net/poem30621.html","الطويل"],[93,"وارحمتا لمصاب","https://www.aldiwan.net/poem11151.html","المجتث"],[30,"ألا حييا بالزرق دار مقام","https://www.aldiwan.net/poem29529.html","الطويل"],[23,"سائل قريشا وأحلافها","https://www.aldiwan.net/poem21470.html","المتقارب"],[72,"بكيت وما يجدي البكاء على العاني","https://www.aldiwan.net/poem20162.html","الطويل"],[85,"قفوا بالقبور نسائل عمر","https://www.aldiwan.net/poem62868.html","المتقارب"],[74,"بمثل علاك من ملك حسيب","https://www.aldiwan.net/poem12865.html","الوافر"],[40,"إلى جيداء قد بعثوا رسولا","https://www.aldiwan.net/poem42262.html","الوافر"],[75,"أما والمذاكي يلكن الشكم","https://www.aldiwan.net/poem69039.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85390","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39595","الطويل"],[112,"أرقت فبت لم أذق المناما","https://www.aldiwan.net/poem20956.html","الوافر"],[183,"نحا البين في تشتيت شملي مقاصدا","https://www.aldiwan.net/poem14496.html","الطويل"],[187,"مقام أجل الرسل أعلى وأعظم","https://www.aldiwan.net/poem35106.html","الطويل"],[209,"بأهل اسكندرية بعض ما بى","https://www.aldiwan.net/poem46771.html","الوافر"],[233,"ترى الظاعن الغادي مقيما على العهد","https://www.aldiwan.net/poem32031.html","الطويل"],[273,"أتجحد قتلي ربة الشنف والخرص","https://www.aldiwan.net/poem25494.html","الطويل"],[278,"ويوم أخذنا به فرصة","https://www.aldiwan.net/poem60709.html","المتقارب"],[280,"هنيئا لقد أوتيت سؤلك يا موسى","https://www.aldiwan.net/poem32738.html","الطويل"],[351,"أعد ذكر ربع البان سفحا وأجرعا","https://www.aldiwan.net/poem40148.html","الطويل"],[362,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[394,"وارحمتا لمصاب","https://www.aldiwan.net/poem11022.html","عموديه"],[400,"أتسأل عن رحيلي يا بن ودي","https://www.aldiwan.net/poem33966.html","الوافر"],[407,"أفي كل يوم أنت صب وليلة","https://www.aldiwan.net/poem67502.html","الطويل"],[413,"سأبكي وأستبكي عليك المعاليا","https://www.aldiwan.net/poem53972.html","الطويل"],[413,"مضى سيد من غر أبناء هاشم","https://www.aldiwan.net/poem54067.html","الطويل"],[413,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[434,"هناء أيها الملك السعيد","https://www.aldiwan.net/poem2544.html","الوافر"],[503,"الوصيّة","https://www.aldiwan.net/poem27795.html","الطويل"],[512,"يا طرس إن جئت عني صاحب المن","https://www.aldiwan.net/poem20894.html","المواليا"],[556,"قلوبنا بك أبلتها النوى كمدا","https://www.aldiwan.net/poem34643.html","البسيط"]],"verses":[["إِلى جَدِّهِ تُنمى شَمائِلُ مَجدِهِ","وَهَل تَرجِعُ الأَشبالُ إِلّا إِلى الأُسدِ",0,"د",1,0],["إِلَى جُرُوحِكَ يُهْدِي","صُبَابَةً مِنْ جُرُوحِهْ",1,"ح",2,0],["إِلى جَنبِ مَأوى جامِلٍ لَم تَدَع بِهِ","مِن العُنَنِ الأَرواحُ غَيرَ حُطامِ",2,"م",1,0],["إِلى جِذمِ قَينٍ لَئيمِ العُروقِ","عُرقوبُ والِدِهِ أَصهَبُ",3,"ب",1,0],["إلى جبلٍ من حلمه يقرع الثنا","إذا غاص من جدواه في فيض طوفان",4,"ن",1,0],["إِلى جَنَّةٍ خُلِقَت لِلكَريمِ","وَمَن عَرَفَ اللَهَ أَو مَن قَدَر",5,"ر",1,0],["إِلى جَذلانَ وَضّاحِ المُحَيّا","سَليمِ القَلبِ وَالصَدرِ الرَحيبِ",6,"ب",1,0],["إِلى جَبَلٍ أَصُدُّ بِهِ العَوادي","وَأَقتادُ المُنى قَودَ الجَنيبِ",6,"ب",1,0],["إِلى جَيداءَ قَد بَعَثُوا رَسُولاً","لِيُخبِرَها فَلا صُحِبَ الرَسُولُ",7,"ل",1,1],["إلى جَعْفَرٍ يَتَنَاهَى المديحُ","وفِيهِ تُثِيرُ القَوافي الحِكَم",8,"م",1,0],["إلى جدث داجي القرارة ضيقٍ","يجاور أَجداثاً بُنينَ عَلى تل",9,"ل",1,0],["إلى جبلِ النورِ انتهى سرُّ وحيهِ","وما هو إلا ملهِمُ اليومِ والغدِ",10,"د",1,0],["إِلى جَدَثٍ بِجَنبِ الجَوِّراسٍ","بِهِ ما حَلَّ ثُمَّ بِهِ أَقاما",11,"م",2,0],["إلى جانبَي قصرِ الدخان مغربا","إلى المُقْس رَوى العهدُ تلك المعَاهِدا",12,"د",2,0],["إِلى جنّةٍ أو لا فتلكَ جهنّمُ","عليهِ عبادَ اللَّه صلّوا وسلّموا",13,"م",3,0],["إلى جفن الحمى بالثغر عادوا","كما عاد الجراز إلى القراب",14,"ب",1,0],["إِلى جَدِّهِ المَنصورِ يَنزَعُ جَدُّهُ","فَناهيكَ مِن جَدٍّ سَعيدٍ وَمِن جَدِّ",15,"د",1,0],["إلَى جُودِهِ تَثنِي الأَمانِي وُجُوهَها","ومَنْ يَتَعَدَّ القَبْضَ أَفْضَى إلَى القَبْصِ",16,"ص",1,0],["إِلى جَنَّةٍ لا مَدى عَرْضِها","يَضِيقُ وَلا ظِلُّها يَقْلِصُ",17,"ص",1,0],["إلى جودِهِ أَشكو مِنَ الكُرَبِ الَّتي","أُؤَمِّلُ أَن أَلقى لَها مِنهُ تَنفيسا",18,"س",2,0],["إِلى جيرَةٍ في السوح من يَستجِر بهم","تَمنّى وَعَن جور الزَمان تَمنَّعا",19,"ع",2,0],["إلى جاعلٍ عزاً مكانِيَ عَيْنَه","ومَن يَعشَقِ العلياءَ بالوفدِ يَلْهَج",20,"ج",1,0],["إلى جروحك يهدي","صبابنة من جروحه",21,"ح",2,0],["إلى جبل الوقار وخير بر","وأفضل كل ذي علم وزهد",22,"د",1,0],["إِلى جَعفَرٍ سارَت بِنا كُلُّ جَسرَةٍ","طَواها سُراها نَحوَهُ وَالتَهَجُّرُ",23,"ر",1,0],["إلى جنَّة الفردوسِ والعفو والرّضى","وفي رحمة الرَّحمن أَصْبَحتَ ثاويا",24,"ي",2,0],["إلى جنَّة الملوى إلى العفو والرضا","إلى رحمة الله الَّتي تتجدَّد",25,"د",1,0],["إلى جانب أصبو وتصبو لجانب","فما بالنا لم نتَّفق في المذاهب",26,"ب",1,0],["إلى جدوال أضحى الناس صورا","وشخصك قبلتي ولك السجود",27,"د",1,0],["إلى جنّة الصّبا بغزةَ ميلي","وفي ظلِّ برتقال فاطمَ قيلي",28,"ي",1,1],["إلى جنابهِ سلمت ركائبك عنّي","واِلثم يمينه أمانة يا طرس عنّي",29,"ي",1,0],["إلى جنابك قلباً سالماً ويدا","عودتنا الخير واستعبدت سائبة",30,"ه",1,0]]}