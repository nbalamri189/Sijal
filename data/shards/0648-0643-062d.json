{"poems":[[77,"تألق نجديا فأذكرني نجدا","https://www.aldiwan.net/poem36536.html","الطويل"],[72,"بلغا القاصدين أن الليالي","https://www.aldiwan.net/poem19529.html","الخفيف"],[107,"فواد صبا لم يرجعنه حذار","https://www.aldiwan.net/poem16295.html","الطويل"],[221,"إمحي السواد عن الأهداب في المقل","https://www.aldiwan.net/poem41914.html","البسيط"],[347,"رب حسن من النفوس قريب","https://www.aldiwan.net/poem15515.html","الخفيف"],[462,"أمعنى فيمن هويت جهالة","https://www.aldiwan.net/poem3312.html","عموديه"],[498,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[549,"لما طلعن علي في غسق","https://www.aldiwan.net/poem47773.html","أحذ الكامل"],[556,"اجتمعوا يا إخوتي واحشدوا","https://www.aldiwan.net/poem34637.html","السريع"],[556,"غصن بان فوقه البدر بدا","https://www.aldiwan.net/poem34653.html","الرمل"]],"verses":[["وكحّلْتُ جَفْني منْ غُبارِ طَريقِهِ","فأعْقَبَها دَمْعاً وأوْرَثَها سُهْدا",0,"د",2,0],["وكحَّلنا الجفون بالسهدِ حتَّى","باتَ منها الكرى على أميال",1,"ل",1,0],["وَكَحلت أَجفاني بِأَثمَد تَربها","فَصحت وَهَل يَشفي العُيون غُبار",2,"ر",1,0],["وَكحلّي الجِفنَ بِالآدابِ وَاِفتَخِري","بِأَنَّ كَحلَكِ من جَنّاتِ لُبنانِ",3,"ن",1,0],["وَكَحرفِ السُيوفِ أَقضى وَأَمضى","فَعَلَّ جَفنَيهِ في جَميعِ القُلوبِ",4,"ب",1,0],["وكحيَّةٍ أو عقربٍ في خدّها","أبداً يسيءُ فعالها وتقبل",5,"ل",1,0],["وكحِّلِ العينَ بإِثْمَدِ التُّقَى","فإنَّما الوِزْرُ إلى العينِ عَمَا",6,"ا",1,0],["وَكحلنَ عينِي كلّما مَرِهَتْ","ببكائها منهنّ بالسَّهَرِ",7,"ر",1,0],["وكحل في أعين خلقة","ليس كعين كحلها الإثمد",8,"د",1,0],["وكحلت العين بالعين وما","بعدها عدت شكوت الرمدا",9,"د",2,0]]}