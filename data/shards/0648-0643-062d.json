{"poems":[[79,"تألق نجديا فأذكرني نجدا","https://www.aldiwan.net/poem36536.html","الطويل"],[74,"بلغا القاصدين أن الليالي","https://www.aldiwan.net/poem19529.html","الخفيف"],[102,"الطريق الهادر","https://www.poetsgate.com/ViewPoem.aspx?id=50202",""],[113,"فواد صبا لم يرجعنه حذار","https://www.aldiwan.net/poem16295.html","الطويل"],[228,"إمحي السواد عن الأهداب في المقل","https://www.aldiwan.net/poem41914.html","البسيط"],[354,"رب حسن من النفوس قريب","https://www.aldiwan.net/poem15515.html","الخفيف"],[469,"أمعنى فيمن هويت جهالة","https://www.aldiwan.net/poem3312.html","عموديه"],[505,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[556,"لما طلعن علي في غسق","https://www.aldiwan.net/poem47773.html","أحذ الكامل"],[563,"اجتمعوا يا إخوتي واحشدوا","https://www.aldiwan.net/poem34637.html","السريع"],[563,"غصن بان فوقه البدر بدا","https://www.aldiwan.net/poem34653.html","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38208","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59424","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59148","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96752","المتقارب"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55886","الرمل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78167","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28598","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93573","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132709","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132582","الكامل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121584","الكامل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3574,"","https://poetry.dctabudhabi.ae/diwan/poem/188172",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45784","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129364","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114503","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114129","الرمل"],[4087,"","https://poetry.dctabudhabi.ae/diwan/poem/131668",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83594","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139728",""],[4578,"محاسن رياً نشرها طيب الشذى","https://www.poetsgate.com/ViewPoem.aspx?id=49418",""],[5302,"ملكت فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=202727",""],[5956,"أعِنّا يا إله الناس","https://www.poetsgate.com/ViewPoem.aspx?id=192567",""]],"verses":[["وكحّلْتُ جَفْني منْ غُبارِ طَريقِهِ","فأعْقَبَها دَمْعاً وأوْرَثَها سُهْدا",0,"د",2,0],["وكحَّلنا الجفون بالسهدِ حتَّى","باتَ منها الكرى على أميال",1,"ل",1,0],["وكحّل جفونك بالنيّرات","وصغ من سنى فجرك المرودا",2,"د",2,0],["وَكَحلت أَجفاني بِأَثمَد تَربها","فَصحت وَهَل يَشفي العُيون غُبار",3,"ر",1,0],["وَكحلّي الجِفنَ بِالآدابِ وَاِفتَخِري","بِأَنَّ كَحلَكِ من جَنّاتِ لُبنانِ",4,"ن",1,0],["وَكَحرفِ السُيوفِ أَقضى وَأَمضى","فَعَلَّ جَفنَيهِ في جَميعِ القُلوبِ",5,"ب",1,0],["وكحيَّةٍ أو عقربٍ في خدّها","أبداً يسيءُ فعالها وتقبل",6,"ل",1,0],["وكحِّلِ العينَ بإِثْمَدِ التُّقَى","فإنَّما الوِزْرُ إلى العينِ عَمَا",7,"ا",1,0],["وَكحلنَ عينِي كلّما مَرِهَتْ","ببكائها منهنّ بالسَّهَرِ",8,"ر",1,0],["وكحل في أعين خلقة","ليس كعين كحلها الإثمد",9,"د",1,0],["وكحلت العين بالعين وما","بعدها عدت شكوت الرمدا",10,"د",2,0],["وَكَحّلوا قَلبَهم في قُبحِ جَهلهمِ","فَكَحّلوهُ بِما لا شَكَّ يُعميهِ",11,"ي",2,0],["وكحل بالياقوت جفنا وناضرا","وخضب بالحنا كفا ومعصما",12,"م",2,0],["وَكَحيلَةِ الأجْفَانِ لَوْلاَ لحظُهَا","لَمْ أدْرِ أنّ الغنجَ يُمْزَحُ بِالحَوَرْ",13,"ر",1,0],["وكحل النقع عين الشمس فانطمست","وسال دمع الدما في الأرض وانسجما",14,"م",2,0],["وكحلاء أضحى لأجفانها","عن الكحلِ مستطرف السِّحرِ كحلا",15,"ل",2,0],["وكحيل الطرف جفني بعده","بات مكحولاّ بأميال السهاد",16,"د",1,0],["وَكَحَلنَ بِالياقوت باطن ناظر","وَخَضَبنَ بِالحِناءِ ظاهر معصم",17,"م",1,0],["وَكَحلاء الجُفونِ قَرَعتُ مِنها","نِجادَ السَّيفِ بِالعِقدِ النَّظيمِ",18,"م",1,0],["وَكحوض زَمزَم مترعات جفانه","زَمر تَقوم لَها وَأُخرى تَقعد",19,"د",1,0],["وكحيل الجفون غادر جفني","صبوة وهو بالسهاد كحيل",20,"ل",1,0],["وكحيلة الأجفان قاتلة الهوى","قال الجمال لمقلتيها سودا",21,"د",2,0],["وكحلت طرفي بالسهاد صبابة","ووهبت نومي للعيون النعس",22,"س",1,0],["وَكحُبَارَى سُمَّهَى سِبَطرَى","ذِكرَى وحِثِّيثَى مَعَ الكُفرِّى",23,"ر",2,0],["وكحيل بات يفتك بي","حين يرنو وهو منكسر",24,"ر",1,0],["وَكَحلت الأَجفان بالميل مُذ هَوَت","كَما قَد هَوَت نَحوَ الحَمام صُقور",25,"ر",1,0],["وكحيل طرف شعره","ليلي ومبسمه نهاري",26,"ر",2,0],["وكحيلُ الطرف قد أحسن","ربي صبغه",27,"ه",1,1],["وكَحِيلٍ تَسرِقُ الغِز","لاَنُ مِنهُ غُنجَه",28,"ه",1,1],["وكحلة الصبح من طبع الحريم","فلا تكحل وما قد جا غداك",29,"ك",1,0],["وَكَحَّلتُ عيني في ثراه بِإثمدٍ","وَموطئُ نعلِ المُصطَفى الإِثمدُ الكحلُ",30,"ل",1,0],["وكحَّل ناظرَيه السهدُ لمّا","رمَتهُ بأسهم الطرف الكحيلِ",31,"ل",1,0],["وكحلاء اقذى صدها جفن صبها","فهل كحل مرآها يزول به القذى",32,"ذ",2,0],["وكحيلة الألحاظ بين عيونها","سيف يمزقني إلى أنصاف",33,"ف",1,0],["وكحّلْ عيننا بألذ إثمدْ","فما عين بنور الله ترْمَدْ",34,"د",1,0]]}