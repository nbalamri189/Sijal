ر",141,"ر",1,0],["أهذا أم العبد الذي ليس خائفاً","ولا راجياً إلا إلهاً معظما",142,"م",2,0],["أهذا الذي أدى العبادات كلها","بأنواعها لله حقاً معظما",142,"م",2,0],["أهذا لأن الله أهدى سحابه","لتنبت من نعمائه ما يفوحهُ",143,"ح",2,0],["أهذي أنت يا أماه من سقطتْ","فخلفتِ المدى قفراً وقيعانا",144,"ن",2,0],["أهذا نحن..؟ ما أقساه","ما تجنيه أيدينا",145,"ن",2,0],["أهذا الذي قد هممت به","وهل فيه حتفك أم مخدعك!؟",146,"ك",1,0],["أَهذِي قُدْرَةُ الحُكَّامِ؟ وَيلٌ","لَهُمْ مِنْ غَضْبَةٍ فيهَا اقْتدَارُ",147,"ر",1,0],["أهَذِي الجَاهِلِيَّةُ قَدْ أفَاقَتْ","تُمَزِّقُ كَفْنَهَا ، نَفَثَتْ بسُمّ",148,"م",1,0],["أَهَذِي الشَّمْسُ فِي الأَسْجافِ هَذِي","فَما مَنْ يَدَّعِيها الشَّمْسَ هاذِ",149,"ذ",1,1],["أهذي الأرضُ منها طينُ وجهي","وهذا الحالُ في البلوى يُرامُ",150,"م",1,0],["أَهْذي بكم حَسْبُ ما أحيا فإِن حضَرَتْ","منّي الوفاةُ وَأوْفَى دُونِيَ الأَجَلُ",151,"ل",1,0],["أهذا الذي نعتده عن تيقظ","لاصلاحنا المرجو أم نحن نحلم",152,"م",1,0],["أُهذّب الوقتَ .. عن أطرافِ جلستنا","لو التقينا وأرشو جيبهُ عطرا",153,"ر",2,0],["آه ذكاء لما عرضت لمتعب","خارت قواه وهدّ ه المجهود",154,"د",1,0],["أهذا حالنا ياشام نشقى","وقوت الناس منهوبٌ سليبُ",155,"ب",1,0],["أهذي صريحاً..كأن الوقت يصفعني","مستجوباً..وكأن دليلهم ذاتي!",156,"ت",2,0],["أ هذا التعاطف بيني وبينك","ما قد به أُوصِيَ المُسْلِمُ؟",157,"م",1,0],["أهذا الدهر تغريبٌ ومسكنةٌ","فما سرنا نلاقِي البؤسَ والكُرَبا؟",158,"ب",2,0],["أهذا ما وعدتِ به فؤادي","أهذا الحبُّ ؟ أم هذا الودادُ ؟",159,"د",1,0],["أهذي كنت أعشقها","وشوقي نحوها سيقا",160,"ق",2,0],["أَهذِي بِها مُنذُ أَنْ عَاقَرتُ خَمرَتَها","كَأَنَّنِي - مِنْ لَمَى أَقدَاحِها - الثَّمِلُ",161,"ل",1,0],["أهذي أمَّةٌ بُعِثَتْ لِتَحيَا","ومَا يَحيَا مع العَجزِ الفَلاحُ",162,"ح",1,0],["أهذه عللُ الإيجاد وهي إلى الوجود","مفتاقةٌ أهون بها عللا",163,"ل",2,0],["أهذي السما أم كربلا وبروجها ال","قباب وبرج الليث ظهر المطهم",164,"م",1,0],["أهذا شمع عروتنا عزاءٌ","أكانَ الموتَ أمْ دمعًا ترامى ؟",165,"م",2,0],["أهذا الصبحُ أعْنقَ واشْرَأبّا؟","وصَبّ النورَ من فودَيهِ صَبّا",166,"ب",2,1],["أهذي وخصلاتها السكرى تغالطني","أن الهوى ليس تحديقا ولا سهرا",167,"ر",2,0]]}