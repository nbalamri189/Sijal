نام","https://www.poetsgate.com/ViewPoem.aspx?id=155538",""],[5829,"وقلب العاشقين هنا يذوب","https://www.poetsgate.com/ViewPoem.aspx?id=210213",""],[5859,"تلك اللتي","https://www.poetsgate.com/ViewPoem.aspx?id=29418",""],[5956,"أ أنتِ بقربي ؟","https://www.poetsgate.com/ViewPoem.aspx?id=183476",""],[5956,"تكاد البنت نحو الموت أن تثبا","https://www.poetsgate.com/ViewPoem.aspx?id=194711",""],[5975,"معذبتي","https://www.poetsgate.com/ViewPoem.aspx?id=53260",""],[6093,"لقد كانت ( مجزوء الوافر )","https://www.poetsgate.com/ViewPoem.aspx?id=176004",""],[6102,"طلل","https://www.poetsgate.com/ViewPoem.aspx?id=184437",""],[6125,"فَظِيعٌ ما أحلُّوا أو أبَاحُوا","https://www.poetsgate.com/ViewPoem.aspx?id=210570",""],[6142,"بديع كون تحلى بالوجود طلى","https://www.poetsgate.com/ViewPoem.aspx?id=155673",""],[6142,"إذا غرب سيف أم هلال المحرم","https://www.poetsgate.com/ViewPoem.aspx?id=155752",""],[6270,"لنا حجرٌ ودون الموت صدرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69080&r=&rc=4",""],[5490,"أهذا الصبح..؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81929&r=&rc=15",""],[6296,"مد جديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75694&r=&rc=25",""]],"verses":[["أَهَذا البَدرُ يُكسَفُ بِالدَياجي","وَهَذي الشَمسُ تُطمَسُ بِالضَبابِ",0,"ب",1,0],["أُهَذِّبُ في مَدحِ اللِئامِ خَواطِري","فَأَصدُقُ في حُسنِ المَعاني وَأَكذِبُ",1,"ب",1,0],["أهذِهِ قَصَباتُ المُلْكِ تُعْمِلُها","أمِ الضّرائِرُ للخَطّيّةِ الذُّبُلِ",2,"ل",1,0],["أهذه خَطَراتُ الرَّبْرَبِ العِينِ","أمِ الغُصونُ على أنْقاءِ يَبْرينِ",3,"ن",1,1],["أهذا الحطامُ المرتمي كان قامتي؟","أما كنتُ قبل الهدم، هدماً مصمَّغا؟",4,"غ",2,0],["أَهَذِي الَّتِي كُنَّا لِلْهَاصِرِينَ قِطَافُهَا","فَكَانَ كَلاَمُ الْقَوْمِ بَعْضاً إِلَى بَعْضِ",5,"ض",1,0],["أَهَذِي الَّتِي كُنَّا وُعِدْنَا بِنَيْلِهَا","وَجَنَّةُ عَدْنٍ فِي السَّمَا أَمْ مِنَ الأَرْضِ",5,"ض",1,0],["أَهَذَا الَّذِي نَعْتَدُّهُ عَنْ تَيَقُّظٍ","إِصلاحِنَا الْمَرْجُوِّ أَمْ نَحْنُ نَحْلَمُ",6,"م",1,0],["أهذا هو العصر الذي يدّعونه","فسحقاً له سحقاً ودفراً له دفرا",7,"ر",2,0],["أَهَذا البُخلُ زادَكِ نَأيَ دارٍ","فَلَيتَ الحُبَّ زادَكُمُ اِقتِرابا",8,"ب",2,0],["أَهَذا الوُدُّ زادَكِ كُلَّ يَومٍ","مُباعَدَةً لِإِلفِكَ وَاِجتِنابا",9,"ب",2,0],["أَهَذا الوُدُّ غَرَّكِ أَن تَخافي","تَشَمُّسَ ذي مُباعَدَةٍ عَذومِ",10,"م",1,0],["أهذي بظبية لو تساعف دارُها","كَلفَا وأحفِلُ صُرْمَها وأبالي",11,"ي",1,1],["أهذا الغلاء وهذا البلاءُ","وهذا الضُّراط وهذي الفتنْ",12,"ن",1,0],["أَهَذا كَمَن يُمسي وَيُضحي مُعَربِداً","وَقُدّامُهُ طَبل وَمِن خَلفِهِ زَمرُ",13,"ر",1,0],["أَهَذا كَمُغتابٍ يَروح وَيَغتَدي","وَفي نُطقِهِ شَر وَفي صَمتِهِ شَرُّ",13,"ر",1,0],["أَهَذا كَمَفطورٍ عَلى الشَر وَالأَذى","أَحاديثُهُ نُكر وَأَعمالُهُ نُكرُ",13,"ر",1,0],["أَهَذا كَأَفعى هَمُّها نَفثُ سُمِّها","وَنَهشُ الَّذي تَلقى وَلَو أَنَّهُ صَخرُ",13,"ر",1,0],["أَهَذا الَّذي قَد حارَبَ المَكرَ جَهدَهُ","كَمَن شابَ فَوداه وَدَيدَنَهُ المَكرُ",13,"ر",1,0],["أَهَذا هُوَ النَخلُ مَلكُ الرِياضِ","أَميرُ الحُقولِ عَروسُ العِزَب",14,"ب",1,0],["أَهَذا هُوَ الذَودُ الَّذي تَدَّعونَهُ","وَنَصرُ كَريدٍ وَالوَلا وَالتَحَبُّبُ",15,"ب",1,0],["أَهَذا الَّذي لِلمُلكِ وَالعِرضِ عِندَكُم","وَلِلجارِ إِن أَعيا عَلى الجارِ مَطلَبُ",15,"ب",1,0],["أَهَذا سِلاحُ الفَتحِ وَالنَصرِ وَالعُلا","أَهَذا مَطايا مَن إِلى المَجدِ يَركَبُ",15,"ب",1,0],["أَهَذا الَّذي لِلذِكرِ خُلَّبُ مَعشَرٌ","عَلى ذِكرِهِم يَأتي الزَمانُ وَيَذهَبُ",15,"ب",1,0],["أَهَذا جَزاءُ الصِدقِ إِن كُنتُ صادِقاً","أَهَذا جَزاءُ الكِذبِ إِن كُنتُ كاذِبا",16,"ب",2,0],["أَهَذِهِ قابَلَتكَ راقِصَةً","أَم رَفَعَت رِجلَها مِنَ التَعَبِ",17,"ب",1,0],["أَهَذا اللَذَيّا بِنتُ وَردانَ بِنتُهُ","هُما الطالِبانِ الرِزقَ مِن شَرِّ مَطلَبِ",18,"ب",1,0],["أهذا الربيعُ الفخمُ والجنةُ التي","أكاد بها أستافُ رائحةَ الخلدِ",19,"د",1,0],["أهذا الحُلم يمضي شبه لمحٍ","أم الأبدُ المديد بلا انتهاء",20,"ا",2,0],["أَهَذا سِحرُكَ النِسوا","نَ قَد خَبَّرنَني خَبَرَك",21,"ك",1,0],["أَهَذا الَّذي أَطرَيتِ نَعتاً فَلَم أَكُن","وَعَيشِكِ أَنساهُ إِلى يَومِ أُقبَرُ",22,"ر",1,0],["أَهَذا الَّذي يَبكي مِنَ الهونِ وَالبَلا","أَم آخَرَ يَبكي شَجوَهُ وَيَهيمُ",23,"م",1,0],["أَهذا هُوَ الفتحُ الذي طَارَ ذِكرُه","وضجَّ يُحيّيه الحليفُ المُشايعُ",24,"ع",1,0],["أَهَذا هُوَ العَدلُ الَّذي فيهِ أَطنَبوا","وَراحَ بِهِ مِنهُم فَخورٌ وَمُعجَبُ",25,"ب",1,1],["أَهذي ديارُ القَومِ غَيَّرها الدَهرُ","فَعُوجوا عَليها نَبكِها أَيُّها السَّفْرُ",26,"ر",1,1],["أَهَذا جَزاءُ المُحسِنينَ وَفوا بِهِ","فَيا بئسما يَجزي اللَئيمُ المُذَمَّمُ",27,"م",1,0],["أهذا هو العهدُ الذي كان بيننا","أهذا الذي يَجْنِي العقيدُ المحالِفُ",28,"ف",1,0],["أَهذي بِكُم يَقظانَ قَد عَلِموا","وَأَبيتُ مِنكِ عَلى هَوى ذِكرِ",29,"ر",1,0],["أَهذي بِكُم ما عِشتُ إِنَّكُمُ","يا حِبُّ وافَقَ شِعبُكُم شِعبي",30,"ب",2,0],["أَهَذي الدارُ مُلكٌ لِاِبنِ أَرضٍ","بِها رامَ المُقامَ أَمِ اِكتَراها",31,"ا",3,0],["أهذي القُصاصةُ لا إنني","أضمُّ عليها يداً تُرعَشُ",32,"ش",1,0],["أهذي القُصاصةُ يا للحريق","ويا للبلى شدَّ ما يُؤلمُ",32,"م",1,0],["أهذا هو الآدميّ العظيمُ","ألا شدّ ما يخدعُ المنظر",33,"ر",1,0],["أهذي أنتِ؟.. أم هذا خيالي","جلاكِ... وبيننا بحرُ الليالي؟",34,"ل",2,1],["أهذه شعب الايمان عندكم","أهكذا سنة قالت وقرآن",35,"ن",1,0],["أهذي التي كنا وعدنا بنيلها","وجنة عدن في السماء أم الأرض",36,"ض",1,0],["أهذا استجد الآن، أم كان جارياً","وما قيل عنه؟ مالجارٍ قواعد",37,"د",1,0],["أهذه الحرب ، يا تأريخ ، كيف ترى","من خلف (جنات عدن) أومأت (سقر)",38,"ر",1,0],["أهذي رعايا أُمَّةٍ قد تهيَّأتْ","لِتسْقَبْلَ الدُّنيا بعزمِ المُهاجم!؟",39,"م",1,0],["أهذا سوادٌ يُبتغىَ لِمُلِمَّةٍ","ونحتاجُهُ في المأزِق المتلاحِم ؟",39,"م",1,0],["أهذي النفوسُ الخاوياتُ ضَراعةً","نُباهي بها الأقرانَ يومَ التَّصادم؟",39,"م",1,0],["أهذا مصيري بعد عشرين حِجَّةً","تحلت بأشعاري فهن أواهل ؟",40,"ل",1,0],["أهذا مصيرُ الشعرِ ريّانَ تنتمي","إليه القوافي المغدقاتُ الحوافل!؟",40,"ل",1,0],["أهذا كمن يمسي ويضحي معربدا","وقدّمه طبل ومن خلفه زمر ؟",41,"ر",1,0],["أهذا كمغتاب يروح ويغتدي","وفي نطفة شرّ وفي صمته شرّ ؟",41,"ر",1,0],["أهذي مغاني جلّق والمعالم","لك الخير أم هل أنت وسنان حالم",42,"م",1,1],["\"أهذا الذي اطربتِ عتاً، فلم اكن،","وعيشكِ، انساهُ إلى يومَ أقبر\"",43,"ر",1,0],["أَهَذَا سِحْرُكَ النِّسْوَا","نَ قَدْ خَبَّرْنَنَي الخَبَرَا",44,"ر",2,0],["أهذهِ نَجْدُ يا صَحْبِي الَّتي خَلُدَتْ","عَبْرَ الزَّمانِ لها في صَدْرِهِ نَهْدُ",45,"د",1,0],["أهذا ما يريد الله منا","ب نجعلكم على أرضٍ خلائف",46,"ف",1,0],["أهذا جزاءُ الشوقِ إن كنتَ منصفاً","أما للهوى حقٌّ أما للنوى بُدُّ",47,"د",1,0],["أهذا زئيرُ الكون أم تلك صرخةٌ","مضرجة الأنفاس يرمى بها قلبي",48,"ب",2,0],["أهذا جزائي في العراق وحبّه","أهذا جزائي في رواحي وإسرائي",49,"ي",1,0],["أَهَذا كَيفَ لا آتي بَخيلٍ","وَغِلمان وَلا يُغنى الأَميرُ",50,"ر",1,0],["أَهذا كُلُّهُ فَرطُ","أَسىً مِنكَ عَلى هَيلا",51,"ل",2,0],["أَهذي نَكهَةُ المِعدَ","ةِ أم ضِرسُكَ مَأكولُ",52,"ل",1,0],["أهذا الشعرُ يصلحُ للبقاءِ","وفيهِ كلُّ أعراضِ الفناءِ",53,"ا",2,1],["أهذا جزاءُ الخيرِ يُقتلُ مُحسِنٌ","ويُصقلُ متنُ السيفِ في كفِّ ضارب",54,"ب",1,0],["أَهذه طيبة ما بين منبرها","وَقبرها روضة مَسلوكة السبل",55,"ل",1,0],["أَهَذا وَما كابَدتُما غُربَةَ النَوى","فَكَيفَ الغَريبُ الدارِ مُنذُ زَمانِ",56,"ن",1,0],["أهذي جنَّةُ الفرْدوس أَم ذي","رُبى (البردون) لولا الجاثليق",57,"ق",1,0],["أهذا المزار أم الإزورار","والمامكم ألم أم لم",58,"م",1,0],["أَهذي بِها في مَنامي وَهِيَ نازِحَةٌ","كَأَنَّني مُوثَقٌ في القِدِّ مُكتَبَلَ",59,"ل",1,0],["أَهَذِهِ سِيَرٌ في المَجدِ أَم سُوَرُ","وَهَذِهِ أَنجُمٌ في السَعدِ أَم غُرَرُ",60,"ر",1,1],["أَهذي كَفُّهُ أَم غَوثُ غَيثٍ","وَلا بَلَغَ السَحابُ وَلا كَرامَه",61,"م",2,1],["أهذا الذي في كأس نظمك قرقف","أبن لي أم السحر الحلال المزخرف",62,"ف",1,1],["أَهَذا التِهامِيُّ من مَكَّةٍ","بِرِجلَيهِ يَسعى إِلى حَتفِهِ",63,"ف",2,0],["أهذا هو الفنانُ نسمعه فنَّا","وليس الذي قد عاش في الأرضِ وافتنا",64,"ن",2,1],["أهذا ثناءٌ من كلامكَ أم سحرُ","وألفاظُ شعرٍ ما تنحلت أم درُّ",65,"ر",1,1],["أهَذهِ أنتِ يا فِلسطيْ","نُ؟ أمْ أرَى ما يرَى الشَّريبُ؟",66,"ب",1,0],["أَهذي السَحابُ الغُرُّ وَهيَ مُلِثَّةٌ","بَواكيهِ أَم تِلكَ الرُعودُ نَوادِبُه",67,"ب",2,0],["أَهذا الظَّبيُ لا أَرضاكَ شِبهاً","لِمَن أَهوى ولكنِّي كَنَيتُ",68,"ت",1,0],["أَهَذا البَدرُ في كأسِ التَّهَانِي","معَ الإِشراقِ أَم شَفَقاً حَسَيتُ",68,"ت",1,0],["أَهذِهِ الأَرض ما زالَت 