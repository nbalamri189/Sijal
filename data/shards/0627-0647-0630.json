,1,0],["أهذى جمال البين مسيا تُنَوّخ","وهذا غراب البين بالبين يصرخ",96,"خ",1,1],["أهذا براه إله البرايا","ومن قاس ذا الكون شبراً فشبرا",97,"ر",2,0],["أهذا خلاصة كلّ الوجو","د عميد الخلائق برّاً وبحرا",97,"ر",2,0],["أهذا عناه إله السما","ء أهذا قضاه فأحكم أمرَا",97,"ر",2,0],["أهذا وديعة ربّ السما","ء يبيتُ على مثل شوك القتاد",97,"د",1,0],["أَهَذا خَليلُ الغولِ وَالذِّئبِ وَالَّذي","يَهيمُ بِرَبّاتِ الحِجالِ الهَراكِلِ",98,"ل",1,0],["أهذه غرةٌ في جبهة الزمنِ","أم ليلة المولد الموصوف بالمننِ",99,"ن",1,1],["أَهَذا بغام ظباء النقا","أَم العود حرّك أَوتارهُ",100,"ر",2,0],["أهذا جزى من ظل يرعى لك الوفا","لعمري ان الحب تأبى شمائله",101,"ل",2,0],["أهذا الذي غنى بسمراء موهناً","أتاح له حسن الغناء متيحُ",102,"ح",1,0],["أهذا أنت يا قمر الجمال","ويارب التجنى والدلال",103,"ل",1,1],["أهذه مكافأة القلوب التي غدت","تهب بنار الحب إنك نهجر",104,"ر",1,0],["أهذا ابن الثرى قصد الثريا","من الغبراء يصعد بارتقاء",105,"ا",2,0],["اهذا سَنَى اللاهوتِ أَومضَ في الذُرى","ام المجدُ بالناسوتِ لِله خادمُ",106,"م",1,0],["اهذه رموزٌ ملَّ منهنَّ كاشفٌ","اهذه كنوزٌ كلَّ عنهنَّ فاصمُ",106,"م",1,0],["اهذا نَهارُ البَعثِ فالمَيتُ قائمٌ","اليوم يومُ اللُبثِ فالحيُّ نائِمُ",106,"م",1,0],["اهذا يشوعُ المُوقِفُ الشمسِ واقفٌ","تُرَى ام يسوع بحلَّةِ الإِنس قائِمُ",106,"م",1,0],["أَهذي شؤونُ المحبين جَمعاً","وَإِلا خُصِصتُ بهذا التَلاشي",107,"ش",2,0],["أهذا الجزاء لمن أوجدوك","لعمري هذا خلاف الاصول",108,"ل",1,0],["أهذا الداء ليس له دواء","وهذا الكسر ليس له انجبار",109,"ر",1,0],["أهذهِ جواهِرٌ منتظمه","في السلكِ أم أزاهرٌ مبتسمه",110,"ه",1,1],["أهذيم لا تنكر بمثل شرابهم","طربي ومن يشرب يلذ ويطرب",111,"ب",1,0],["أهذي سمائلك الزاهرا","ت أهيدتها أم ثغورُ الحسان",112,"ن",1,0],["أهذي رياض قد سقاهن مغدق","فأصبح نشر المسك منهن يعيق",113,"ق",1,1],["أهذا الصبح آذن بانبلاج","أم الصهباء تشرق كالزجاج",114,"ج",1,1],["أَهذي سَماءٌ زُيِّنَت بالكَواكِبِ","وَإِلّا لآلٍ في نُحور الكَواعِبِ",115,"ب",1,1],["أهذي فعال الشؤُم أم لؤم حاسدٍ","أحلّا لنا بالخِلب لسعَ العقاربِ",116,"ب",1,0],["أ هذي فعالٌ بالمنون لقد نمت","وقد ضيَّعت مني ال