{"poems":[[55,"أين الغزال الماطل","https://www.aldiwan.net/poem29906.html","مجزوء الرجز"],[29,"ما هاج شوقك من عهود رسوم","https://www.aldiwan.net/poem6009.html","الكامل"],[77,"الحب حيث المعشر الأعداء","https://www.aldiwan.net/poem69109.html","الكامل"],[50,"يا من جداه قليل","https://www.aldiwan.net/poem65017.html","المجتث"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202688","الكامل"],[77,"الحِبّ حيثُ المعشرُ الأعداءُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10780&r=&rc=0",""],[230,"يا راميا من تحت أج","https://www.aldiwan.net/poem55195.html","مجزوء الكامل"],[280,"أف لدنيا لم يزل أبناؤها","https://www.aldiwan.net/poem25387.html","الكامل"],[369,"هبني أقصر بالخطا","https://www.aldiwan.net/poem60794.html","مجزوء الكامل"],[409,"فأغضب الكرم إذ بالفخر قد هدرت","https://www.aldiwan.net/poem33442.html","البسيط"],[505,"في كل عصر من علي واحد","https://www.aldiwan.net/poem37549.html","الكامل"],[563,"يا من يريد يحب الله بالتحقيق","https://www.aldiwan.net/poem34305.html","المواليا"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138195",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38768","البسيط"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114700","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106856","البسيط"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137024",""],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130045","الكامل"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3641,"","https://poetry.dctabudhabi.ae/diwan/poem/202280","الرجز"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69918","البسيط"],[4767,"شمس الإمامة","https://www.poetsgate.com/ViewPoem.aspx?id=180572",""],[4802,"ذهول","https://www.poetsgate.com/ViewPoem.aspx?id=33013",""],[4802,"فلا أخضع","https://www.poetsgate.com/ViewPoem.aspx?id=34417",""],[1012,"ضبط الصواع","https://www.poetsgate.com/ViewPoem.aspx?id=186326",""],[4921,"بك أستجير فمن يجير سواكا","https://www.poetsgate.com/ViewPoem.aspx?id=3652",""],[5057,"الخطوة الأولى","https://www.poetsgate.com/ViewPoem.aspx?id=197231",""],[5064,"يا رَاحِلاً","https://www.poetsgate.com/ViewPoem.aspx?id=199130",""],[5072,"يا رمزنا أنت قد بعناك","https://www.poetsgate.com/ViewPoem.aspx?id=53759",""],[5305,"الاستسعاد بمدح سيد الأسياد","https://www.poetsgate.com/ViewPoem.aspx?id=187378",""],[5324,"عين السماء على العراق تسيلُ .","https://www.poetsgate.com/ViewPoem.aspx?id=207659",""],[5397,"زهت ابتهاجاً ليلة الأسراء","https://www.poetsgate.com/ViewPoem.aspx?id=157893",""],[5830,"يَا صَاحِبَ الكَلِمَاتِ","https://www.poetsgate.com/ViewPoem.aspx?id=200769",""],[5848,"دمعه مالها داعي","https://www.poetsgate.com/ViewPoem.aspx?id=50586",""],[5956,"الهواء لفح جيد فراس","https://www.poetsgate.com/ViewPoem.aspx?id=193304",""],[523,"ما أصعب الكلام (رثاء ناجي العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""]],"verses":[["وَاللَهُ فيهِ ضامِنٌ","لِما أَرَدتَ كافِلُ",0,"ل",1,0],["وَاللَهُ فَضَّلَ والِدَيكَ فَأَنجَبا","وَعَدَدتَ خَيرَ خُؤولَةٍ وَعُمومِ",1,"م",1,0],["واللهُ في علياك أصدق قائل","فكأنّ قولَ القائلين هُذاء",2,"ا",2,0],["وَاللَهُ في كُلِّ هَذا","حَسبي وَنِعمَ الوَكيلُ",3,"ل",1,0],["والله فوق الخلق فيها وحده","والناس تحت لوائها أكفاء",4,"ا",2,0],["واللهُ في علياكَ أصدقُ قائلٍ","فكأنّ قولَ القافلينَ هُذاء",5,"ا",2,0],["وَاللَهُ فَوقَ الظالِم","ينَ وَفَوقَ ظُلمِهِمُ مُطلُّ",6,"ل",1,0],["واللّه في تنزيله قد ذمّها","فاقرأ كتابا ليس بالمتشابه",7,"ه",1,0],["واللهُ فوقَ سَمائه","مِمَّن دَعانا بالرِّجال",8,"ل",1,0],["واللّه في سورة الأنعام أسكنني","الجنات فاسمع من الأنعام يا نعم",9,"م",1,0],["والله فضلاً لا يخيب وجهه","ودعاؤه ضمن الغيوب يجاب",10,"ب",1,0],["والله في الغيب مطلق ما له تضييق","وكل ممنوع نحوه العقل ذو التشويق",11,"ق",1,0],["والله في الكتاب قد قرنها","بطاعة الرسول إذ بيّنها",12,"ه",2,0],["والله فضلها وظلل أرضها","فضلا بأصفى قبة زرقاء",13,"ا",2,0],["وَاللَّهُ فَضَّلَهُ فيهِم فَلا عَجَبٌ","فَكَم تَقَدَّم خَير الأَنبياءِ نَبي",14,"ب",2,0],["واللَهُ في أجرِه الموفُورِ ينظمهُ","فإنّهُ في الثَّرى تَهتَزّ أعظمهُ",15,"ه",1,0],["وَاللهُ فَهوَ إِلَه حَقٌّ دَائِماً","أفَعَنهُ ذَا الوَصفَانِ مَسلُوبَانِ",16,"ن",1,0],["والله فَوقَ العَرشِ يُبصِرُ خَلقَهُ","فَانظُرهُ إن سَمَحَت لَكَ العَينَانِ",16,"ن",1,0],["وَاللهُ فَوقَ العَرشِ جَلَّ جَلاَلُه","سُبحَانَهُ عَن نَفي ذِي البُهتَانِ",16,"ن",1,0],["وَالله فَاعِلُ فِعلِنَا مِن طَاعَةٍ","وَمِنَ الفُسُوقِ وَسَائِرَِ العِصيَانِ",16,"ن",1,0],["والله في القرآن أبطلها فلا","تعدل عن الآثار والقرآن",16,"ن",1,0],["واللَه فيه عز وجلّا","يدبِّرُ الكلَّ بالسواء",17,"ا",2,0],["والله في ملكوته اثنى عليك","وانفسٌ كادت لسقم تزهق",18,"ق",1,0],["واللّه في نجوايَ كم ناديتهُ","أن تَظفري يوماً بما تتطلّبين",19,"ن",1,0],["وَاللَهُ في القرآنِ أَخبَرَ أَنَّهُ","يأَتي بِغَيرِ تَنَقُّلٍ وَتَدانِ",20,"ن",1,0],["والله في الجيش أجاب القيلا","ولم يكن ناصره مخذولا",21,"ل",2,0],["والٍ لَهُ في ذرى العلياءِ مَنزلةً","فوق الثُريا وَرَب العَرش رافعهُ",22,"ع",2,0],["والله في التوراة قد قرنَ اسمه","باسم النبيِّ فما تقول الشانِعة",23,"ع",2,0],["والله ...فلا خنتك ولا...خنت ذاتى","للى بى اكبر من بلا الناس والعوز",24,"ز",1,0],["والله فلا اخضع لو ملكني غلاها","وان طوعتني مابقا بالبشر خير",25,"ر",1,0],["والله فاشكره على نشر الهدى","منه وكن لله ربك خاشي",26,"ش",2,0],["والله في كل العجائب مبدع","إن لم تكن لتراه فهو يراكا",27,"ك",2,0],["واللهُ في عونِ الفتى إن كانَ في","أسرِ الذنوبِ يتوقُ للتحريرِ",28,"ر",1,0],["واللهِ في الرُّوحِ سكّينٌ تمزّقُني","إذا تذكَّرتُ شيئًا من بقاياهُ",29,"ا",2,0],["والله ُ في الملأ ِ الأعلى مُدَوّية ٌ","صلاتُه ُ والليالي حفّها الطرب ُ",30,"ب",1,0],["والله فصل في القرآن شرعته","والسر قد ضمه ذكر وتنزيل",31,"ل",1,0],["والله فجرك قادم رغم الدجى...","تبقى عراقا والهموم تزولُ",32,"ل",1,0],["والله فوق العرش أقعد شخصه","وحباه منه بعزة وثناء",33,"ا",2,0],["وَاللهُ فَوْقَ الكَوْنِ يَرْقُبُ قَوْلَنَا","فَاحْذَرْ فَكُلُّ القَوْلِ مِنْكَ سَيُحْسَبُ",34,"ب",1,0],["واللهفه اللي بيدك تحن لاشباعي","عن جوع قلبي من الدنيا وما فيها",35,"ي",3,0],["واللهُ في القرآن أوضح ضعفنا","لولا نظامُهُ هكذا تفنىَ الدّنا",36,"ن",2,0],["واللهُ في كلِّ البلادِ مُطاردٌ","لضلوعهِ بإثارةِ الغوغاءِ",37,"ا",2,0]]}