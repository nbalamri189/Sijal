{"poems":[[51,"حببت درة القيان إلينا","https://www.aldiwan.net/poem66421.html","الخفيف"],[97,"أصبحت من يأسي لو ان الردى","https://www.aldiwan.net/poem25075.html","السريع"],[52,"يا صاحبي شيبت عفوا","https://www.aldiwan.net/poem26585.html","مجزوء الكامل"],[75,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"],[106,"الطبيب الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=179681",""],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[31,"عاودّ القلبَ من سلامة َ نصبُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18796&r=&rc=59",""],[141,"إن العلى المعيي الملوك طلابها","https://www.aldiwan.net/poem11732.html","الكامل"],[141,"عوضونا من السهاد الرقادا","https://www.aldiwan.net/poem11742.html","الخفيف"],[141,"ضل من يستزير طيف الخيال","https://www.aldiwan.net/poem11795.html","الخفيف"],[158,"سود العيون أم المواضي البيض","https://www.aldiwan.net/poem58917.html","الكامل"],[158,"كل يحب ولا تصح مودة","https://www.aldiwan.net/poem58944.html","الكامل"],[167,"عني إليك حوادث الأيام","https://www.aldiwan.net/poem1669.html",""],[197,"شادن يفتن الورى","https://www.aldiwan.net/poem45168.html","مجزوء الخفيف"],[220,"ومليك حسن في القلوب","https://www.aldiwan.net/poem55447.html","مجزوء الكامل"],[362,"طلعت نجوم الدين فوق الفرقد","https://www.aldiwan.net/poem60958.html","الكامل"],[363,"ما فوق ما نالت يداي به","https://www.aldiwan.net/poem44376.html","الكامل"],[441,"يا جنان الشام يا ذات البها","https://www.aldiwan.net/poem56030.html","عموديه"],[456,"يا دار بين شراف فالنخلِ","https://www.aldiwan.net/poem55992.html","السريع"],[456,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[549,"نادمت طيفك ليلة الرمل","https://www.aldiwan.net/poem47275.html","أحذ الكامل"],[549,"ما قربوا إلا لبين نوقا","https://www.aldiwan.net/poem47365.html","الكامل"],[549,"من أين زرت خيال ذات البرقع","https://www.aldiwan.net/poem47707.html","الكامل"],[549,"كم ذا نخيب وتكذب الأطماع","https://www.aldiwan.net/poem47724.html","الكامل"],[549,"إِن كان غيبك التراب الأحمر","https://www.aldiwan.net/poem47823.html","الكامل"],[549,"خل المدامع في المنازل تسفح","https://www.aldiwan.net/poem47902.html","الكامل"],[565,"بأبي أنت تباغضت","https://www.aldiwan.net/poem69622.html","مجزوء الرمل"]],"verses":[["ولقدُ فزن إذْ يُناغِينَ فاها","ويديْها وعُودها الألحانا",0,"ن",2,0],["ولقد فرغتُ من التعلل بالمنى","إلا وميضاً في الرماد الخابي",1,"ا",3,0],["وَلَقَد فَضَضتُ عَنِ الصَبا","حِ ظَلامَهُ سَحَراً وَغُدوا",2,"و",2,0],["ولقد فاتَ بنَا أنفسَنا","وإذا ما فات شيءٌ لم يُرَد",3,"د",1,0],["ولقد فقدتُكَ؛ فافتقدتُ مدامعي","فوجدتُها نَزَحتْ من الآماق",4,"ق",1,0],["ولقد فَتَكَتْ بنا الأمراضُ فتكًا","وأيدي الطبِّ عاجزةٌ قصَار",5,"ر",1,0],["ولقدْ فلتُ أيها القلبُ ذو الشوقِ","الذي لا يحبُّ حبكَ حبّ",6,"ب",1,0],["وَلَقَد فَرَعتَ بِما صَنَعتَ مَحَلَّةً","لَولا النُجومُ تَعَذَّرَت أَترابُها",7,"ب",3,0],["وَلَقَد فازَ بِالخُلودِ كِرامٌ","تَخِذوا الحَمدَ عُدَّةً وَعَتادا",8,"د",2,0],["وَلَقَد فازَ بِالثَناءِ هِلالٌ","بَشَّرَ البِدرَ قَبلَهُ بِهِلالِ",9,"ل",1,0],["ولقد فقدت وأنت أعلم منكم","أنساً ولطفاً ما به تعويضُ",10,"ض",1,0],["ولقد فررت وهل يفر مخافة","من محسن من ليس منه زلة",11,"ه",1,0],["وَلَقَد فَقَدنا مِنهُ أَروَعَ ماجِداً","سَهلَ الجَنابِ مُؤَدَّبَ الخُدّامِ",12,"م",1,0],["ولقد فات عاذلي","عصر تحويل قبلتي",13,"ي",1,0],["ولقد فنيت وإنما","شاهدت صورة رسمه",14,"م",2,0],["ولقد فعلْتَ فَدُمْ كذلك مُنْعماً","أبداً تُعيدُ صنيعةً أو تَبْتَدي",15,"د",2,0],["ولقد فَجَعتُ الفرسَ غيرَ مُذَمَّمٍ","لمَّا طَغَوا بعنيدهم بُورانِ",16,"ن",1,0],["ولقد فزت بعز اقعس","فاخر الغرب به مشرقنا",17,"ن",2,0],["ولقد فضَلتَ بأنهم وهبوا","من كثرةٍ ووهبت من قُلِّ",18,"ل",1,0],["ولقد فَرجتُ إلى العلا","نقعاً يضيق مخنَّقُهْ",19,"ق",2,0],["ولقد فرغتُ من الأمور معاً","وثناؤكمْ ومديحكمْ شُغلي",20,"ي",1,0],["ولقد فخرتُ بمعشرٍ لمّا اِعتلَوْا","لم يرتَضوا النَّسْرين والعَيّوقا",21,"ق",2,0],["وَلَقد فَخرتَ على الملوك جميعهمْ","بالأصل منك وفرعك المتفرِّعِ",22,"ع",1,0],["وَلَقد فُجعتُ وكلُّ مَن لم يُصْمِهِ","سَهمُ المنيّةِ زارَه الإفجاعُ",23,"ع",1,0],["ولقد فقدتُ معاشراً ومعاشراً","ويسرّني أنْ لم يكن لِيَ معشَرُ",24,"ر",1,0],["وَلَقدْ فضحتَ مَعاشراً لم يبلغوا","شأْواً بلغتَ وفضلُ مثلك يفضحُ",25,"ح",1,0],["وَلَقَدْ فَاتَكَ لَهْوٌ","لِسْتَ مِنْهُ مُسْتَعِيْضَا",26,"ض",2,0]]}