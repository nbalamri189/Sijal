{"poems":[[53,"حببت درة القيان إلينا","https://www.aldiwan.net/poem66421.html","الخفيف"],[99,"أصبحت من يأسي لو ان الردى","https://www.aldiwan.net/poem25075.html","السريع"],[54,"يا صاحبي شيبت عفوا","https://www.aldiwan.net/poem26585.html","مجزوء الكامل"],[77,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"],[108,"الطبيب الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=179681",""],[108,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[33,"عاودّ القلبَ من سلامة َ نصبُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18796&r=&rc=59",""],[147,"إن العلى المعيي الملوك طلابها","https://www.aldiwan.net/poem11732.html","الكامل"],[147,"عوضونا من السهاد الرقادا","https://www.aldiwan.net/poem11742.html","الخفيف"],[147,"ضل من يستزير طيف الخيال","https://www.aldiwan.net/poem11795.html","الخفيف"],[164,"سود العيون أم المواضي البيض","https://www.aldiwan.net/poem58917.html","الكامل"],[164,"كل يحب ولا تصح مودة","https://www.aldiwan.net/poem58944.html","الكامل"],[173,"عني إليك حوادث الأيام","https://www.aldiwan.net/poem1669.html",""],[203,"شادن يفتن الورى","https://www.aldiwan.net/poem45168.html","مجزوء الخفيف"],[227,"ومليك حسن في القلوب","https://www.aldiwan.net/poem55447.html","مجزوء الكامل"],[369,"طلعت نجوم الدين فوق الفرقد","https://www.aldiwan.net/poem60958.html","الكامل"],[370,"ما فوق ما نالت يداي به","https://www.aldiwan.net/poem44376.html","الكامل"],[449,"يا جنان الشام يا ذات البها","https://www.aldiwan.net/poem56030.html","عموديه"],[463,"يا دار بين شراف فالنخلِ","https://www.aldiwan.net/poem55992.html","السريع"],[463,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[556,"نادمت طيفك ليلة الرمل","https://www.aldiwan.net/poem47275.html","أحذ الكامل"],[556,"ما قربوا إلا لبين نوقا","https://www.aldiwan.net/poem47365.html","الكامل"],[556,"من أين زرت خيال ذات البرقع","https://www.aldiwan.net/poem47707.html","الكامل"],[556,"كم ذا نخيب وتكذب الأطماع","https://www.aldiwan.net/poem47724.html","الكامل"],[556,"إِن كان غيبك التراب الأحمر","https://www.aldiwan.net/poem47823.html","الكامل"],[556,"خل المدامع في المنازل تسفح","https://www.aldiwan.net/poem47902.html","الكامل"],[572,"بأبي أنت تباغضت","https://www.aldiwan.net/poem69622.html","مجزوء الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87187","الخفيف"],[933,"","https://poetry.dctabudhabi.ae/diwan/poem/35029","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62534","الكامل"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79538","الكامل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35793","الكامل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111856","الكامل"],[1910,"","https://poetry.dctabudhabi.ae/diwan/poem/116543","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114798","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53191","الكامل"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105671","الرمل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100374","الكامل"],[3369,"","https://poetry.dctabudhabi.ae/diwan/poem/117045","الرمل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48279","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138605",""],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85120","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59496","الكامل"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2521","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127242","الرمل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127075","الرمل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83468","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120543","الكامل"],[4767,"الأفول","https://www.poetsgate.com/ViewPoem.aspx?id=94892",""],[5458,"العلياء","https://www.poetsgate.com/ViewPoem.aspx?id=72384",""],[5829,"خطاب لم يصل","https://www.poetsgate.com/ViewPoem.aspx?id=152684",""]],"verses":[["ولقدُ فزن إذْ يُناغِينَ فاها","ويديْها وعُودها الألحانا",0,"ن",2,0],["ولقد فرغتُ من التعلل بالمنى","إلا وميضاً في الرماد الخابي",1,"ا",3,0],["وَلَقَد فَضَضتُ عَنِ الصَبا","حِ ظَلامَهُ سَحَراً وَغُدوا",2,"و",2,0],["ولقد فاتَ بنَا أنفسَنا","وإذا ما فات شيءٌ لم يُرَد",3,"د",1,0],["ولقد فقدتُكَ؛ فافتقدتُ مدامعي","فوجدتُها نَزَحتْ من الآماق",4,"ق",1,0],["ولقد فَتَكَتْ بنا الأمراضُ فتكًا","وأيدي الطبِّ عاجزةٌ قصَار",5,"ر",1,0],["ولقدْ فلتُ أيها القلبُ ذو الشوقِ","الذي لا يحبُّ حبكَ حبّ",6,"ب",1,0],["وَلَقَد فَرَعتَ بِما صَنَعتَ مَحَلَّةً","لَولا النُجومُ تَعَذَّرَت أَترابُها",7,"ب",3,0],["وَلَقَد فازَ بِالخُلودِ كِرامٌ","تَخِذوا الحَمدَ عُدَّةً وَعَتادا",8,"د",2,0],["وَلَقَد فازَ بِالثَناءِ هِلالٌ","بَشَّرَ البِدرَ قَبلَهُ بِهِلالِ",9,"ل",1,0],["ولقد فقدت وأنت أعلم منكم","أنساً ولطفاً ما به تعويضُ",10,"ض",1,0],["ولقد فررت وهل يفر مخافة","من محسن من ليس منه زلة",11,"ه",1,0],["وَلَقَد فَقَدنا مِنهُ أَروَعَ ماجِداً","سَهلَ الجَنابِ مُؤَدَّبَ الخُدّامِ",12,"م",1,0],["ولقد فات عاذلي","عصر تحويل قبلتي",13,"ي",1,0],["ولقد فنيت وإنما","شاهدت صورة رسمه",14,"م",2,0],["ولقد فعلْتَ فَدُمْ كذلك مُنْعماً","أبداً تُعيدُ صنيعةً أو تَبْتَدي",15,"د",2,0],["ولقد فَجَعتُ الفرسَ غيرَ مُذَمَّمٍ","لمَّا طَغَوا بعنيدهم بُورانِ",16,"ن",1,0],["ولقد فزت بعز اقعس","فاخر الغرب به مشرقنا",17,"ن",2,0],["ولقد فضَلتَ بأنهم وهبوا","من كثرةٍ ووهبت من قُلِّ",18,"ل",1,0],["ولقد فَرجتُ إلى العلا","نقعاً يضيق مخنَّقُهْ",19,"ق",2,0],["ولقد فرغتُ من الأمور معاً","وثناؤكمْ ومديحكمْ شُغلي",20,"ل",2,0],["ولقد فخرتُ بمعشرٍ لمّا اِعتلَوْا","لم يرتَضوا النَّسْرين والعَيّوقا",21,"ق",2,0],["وَلَقد فَخرتَ على الملوك جميعهمْ","بالأصل منك وفرعك المتفرِّعِ",22,"ع",1,0],["وَلَقد فُجعتُ وكلُّ مَن لم يُصْمِهِ","سَهمُ المنيّةِ زارَه الإفجاعُ",23,"ع",1,0],["ولقد فقدتُ معاشراً ومعاشراً","ويسرّني أنْ لم يكن لِيَ معشَرُ",24,"ر",1,0],["وَلَقدْ فضحتَ مَعاشراً لم يبلغوا","شأْواً بلغتَ وفضلُ مثلك يفضحُ",25,"ح",1,0],["وَلَقَدْ فَاتَكَ لَهْوٌ","لِسْتَ مِنْهُ مُسْتَعِيْضَا",26,"ض",2,0],["وَلَقَد فاتَنا التَرقّي وَلَولا","خَفضنا في حَضيضها لارتفعنا",27,"ن",2,0],["وَلَقَد فُجِعتُ بِسادَةٍ وَفَوارِسٍ","لِلحَربِ سُعرٍ مِن بَني شيبانِ",28,"ن",1,1],["ولقد فشا من شيخكم خلفان ما","ضاقت به نخل بحمل الكاهلِ",29,"ل",1,0],["ولقد فَرَشْتَ مهادَ عدلِكَ فاغْتَدَتْ","تتواردُ الآسادُ والآرامُ",30,"م",1,0],["وَلَقَد فَضَضناها بِخاتمِ رَبِّها","بكراً وَلَيسَ البِكرُ مِثلَ الأَيّمِ",31,"م",1,0],["ولقد فصمث عرى الوداد جهالة","وغدوت من بعد الجهالة تزلخُ",32,"خ",1,0],["ولقد فرى حالي بمخلب ضيمه","ليثٌ خلى عن مثله خفَّانُ",33,"ن",1,0],["ولقَد فقدتُ سَمِيَّهُ مِن قَبلِهِ","مُتَضَرِّجاً بدمِ الفؤاد مُقَتَّلا",34,"ل",2,0],["ولقد فرعت صَفَاتَها بعزائم","تقضي على ريب الزمان وتحكم",35,"م",1,0],["ولقد فقهتني درس الهوى","طاهراً مثل ابتسامات الصبايا",36,"ا",3,0],["ولقد فقدتك ناظراً ذا حوة","وسنان من نجل العيون كحيلا",37,"ل",2,0],["ولقد فاز أناس","بثناء الله فاهوا",38,"ا",1,0],["ولقد فرَعْتَ من الخِلافة مَرْقَباً","أطْلَعْتَ فيه للعُيونِ هِلالَها",39,"ل",3,0],["ولقد فضل من قد جاهدوا","درجاتٍ فوق من كانوا قعودا",40,"د",2,0],["ولقد فقدت له المظنه","كن بالغنى والعا",41,"ا",1,0],["ولقد فني مالي الجزي","لُ على الوسائلِ والسوائلْ",42,"ل",1,0],["وَلَقَد فَخَرتَ بِباطِلٍ عَدَّدتَهُ","فَإِذا أَتَيتَ بُيوتَ قَومِكَ فَاِحسُبِ",43,"ب",1,0],["ولقد فاح بها مسك الثنا","وثنى غصن العلى فيها القوام",44,"م",1,0],["ولقد فتت قلب الحجر ال","حزن والحجر بكى مما جرى",45,"ا",1,0],["وَلَقَد فَزعتُ من الخطوبِ وَقد وَهى","عزمي فَأَدركني فَإِنَّك مَفزَعي",46,"ع",2,0],["ولقد فتحت عليك ابواب الردى","فيريك منها الحتف باب واحد",47,"د",1,0],["ولقد فاز الذي والاهمُ","بجِنان الخُلد في يوم الحساب",48,"ب",1,0],["ولقد فتنت بكل اسم قلتَه","وأحبها عندي هو العلياء",49,"ا",2,0],["ولقد فَرَقت , وكل شيء هالك","والكون بعد فنائه سيُجمَّع",50,"ع",1,0]]}