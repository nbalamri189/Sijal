{"poems":[[47,"أمنك تأوب الطيف الطروب","https://www.aldiwan.net/poem10650.html","الوافر"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62275","الطويل"],[190,"خذ من زمانك ما صفا","https://www.aldiwan.net/poem43606.html","مجزوء الكامل"],[275,"شربناها على ذكر الوليد","https://www.aldiwan.net/poem35590.html","الوافر"],[396,"نسأل من الله مولانا الكريم","https://www.aldiwan.net/poem54598.html","عموديه"],[406,"على طريق العفاف","https://www.aldiwan.net/poem6793.html","عموديه"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126127","الرجز"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130772","الكامل"],[4987,"نهار الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=49578",""]],"verses":[["كَنَخلِ سُمَيحَةَ اِستَعلى رَكيبٌ","تُكَفّيهِ الرِياحُ عَلى رَكيبِ",0,"ب",1,0],["كَنَخْلٍ بِأَعْلَى قَرْحَ حِيطَ فَلَمْ يَزَلْ","لَهُ مَانِعٌ حَتَّى أَنَى فَتَمَتَّعَا",1,"ع",2,1],["كن خيّرا لهمُ وإن","أولوك شرّا مسرفا",2,"ف",2,0],["كنَخلتِه غريباً حنَّ لما","رأى في الخمرِ أمناً للطريد",3,"د",1,0],["كن خامل الذكر للخلوة مديم","تارك لما ليس يعني في النهج",4,"ج",1,0],["كنخلِ باسقٍ يُعطي عطاءً","لذيذَ الطَّعْم، تحمله العذوقُ",5,"ق",1,0],["كن خادماً لهم بصدق النية","تبلغ بذاك الأمن والأنية",6,"ه",1,0],["كن خير من ملك القيا","د إلى السلامة باعتصام",7,"م",1,0],["كن خدك الطاهر بروقوشعاع","اثرها رحمة(ن) للناس بعض الغشاوي",8,"ا",3,0]]}