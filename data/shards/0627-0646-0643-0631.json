wPoem.aspx?id=189122",""],[5512,"ربيعٌ أم خريف","https://www.poetsgate.com/ViewPoem.aspx?id=204667",""],[5533,"رَغْمَ الجِراح","https://www.poetsgate.com/ViewPoem.aspx?id=184051",""],[5616,"الحجاب","https://www.poetsgate.com/ViewPoem.aspx?id=204841",""],[5628,"النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=178442",""],[5628,"الشوق والمستحيل","https://www.poetsgate.com/ViewPoem.aspx?id=178554",""],[5674,"داء ليس منه شفاء","https://www.poetsgate.com/ViewPoem.aspx?id=213838",""],[5717,"فالقول بالعدل أساس يبتنى","https://www.poetsgate.com/ViewPoem.aspx?id=170603",""],[5725,"قضي بعرشك ظهر الجان ياسبأُ","https://www.poetsgate.com/ViewPoem.aspx?id=181731",""],[5889,"قلب المحب لحبه ثمن","https://www.poetsgate.com/ViewPoem.aspx?id=212598",""],[5922,"محاورة النجوم","https://www.poetsgate.com/ViewPoem.aspx?id=185133",""],[5977,"روح تسكنني","https://www.poetsgate.com/ViewPoem.aspx?id=213079",""],[6093,"أنَسيتَ عهداً في الغرام جميلا","https://www.poetsgate.com/ViewPoem.aspx?id=176446",""],[6093,"بلاغة جمال","https://www.poetsgate.com/ViewPoem.aspx?id=206682",""],[6131,"الكونُ المُسَافرُ للفَراغْ","https://www.poetsgate.com/ViewPoem.aspx?id=189269",""],[5309,"أنكرت عيناي اطياف الذهب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573562",""],[5309,"ذلك البدر كنت ادري مصيره","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573542",""],[6317,"دموع التاريخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86079&r=&rc=4",""],[5190,"إشارة حمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85037&r=&rc=112",""]],"verses":[["أَنكَرتُ أَفراحَ الزَمانِ بَعدَهُم","مِن طولِ بَلوايَ بِرَوعاتِ الحَزَن",0,"ن",1,0],["أَنكَرتُ مَن وُدَّكُم ما كُنتُ أَعرِفُهُ","ما أَنتُمُ لي كَما كُنتُم تَكونونا",1,"ن",2,0],["أنْكَرتُهُ لمّا أطَلَّ عارِضُهُ","فقالَ لي حينَ رابَهُ نظَري",2,"ي",1,1],["أَنكَرَ النيلُ مَوقِفَ الخَزّانِ","فَاِنثَنى قافِلاً إِلى السودانِ",3,"ن",1,1],["أَنكَرَ الأُنسُ مَكاني","وَنَأى عَنّي الجَليسُ",4,"س",1,0],["إِن كَرَّ في الجَيشِ فَرَّ الجَيشُ مُنهَزِماً","عَنهُ فَتَعثُرُ أَبدانٌ بِهاماتِ",5,"ت",1,0],["أَنكَرتُ أَن تَفتَرَّ عَنكَ صَنيعَةٌ","في صالِحِ اِبنِ عَطِيَّةَ الحَجّامِ",6,"م",1,0],["أَنكَرنَ مَركَبِيَ الحِمَا","رَ وَكُنَّ لاَ يُنكِرنَ طِرفَا",7,"ف",2,0],["أَنكَرنَ عَهدَكَ بَعدَما عَرَّفنَهُ","وَفَقَدنَ ذا القَصَبَ الغُدافَ الأَسوَدا",8,"د",2,0],["أَنكَرنَ عَهدَكَ بَعدَ ما يَعرِفنَهُ","وَلَقَد يَكُنُّ إِلى حَديثِكَ صورا",9,"ر",2,0],["أَنكَرتَ عَهدَكَ غَيرَ أَنَّكَ عارِفٌ","طَلَلاً بِأَلوِيَةِ العُنابِ مُحيلا",10,"ل",2,0],["أَنكَرتُ باطِلَها وَبُؤتُ بِحَقِّها","عِندي وَلَم يَفخَر عَلَيَّ كِرامُها",11,"م",3,0],["أنكروا حالتي التي قد صلحتْ","بعد دهرٍ صمَّ عن عاتبه",12,"ه",1,1],["أنكر المنكرون إفرادَ نجْمَيْ","ك وحزمٌ أصبحتَ من أفرادِهْ",13,"د",2,0],["أنكروا أن يكون مسلكَ أيرٍ","ثُقْبَةٌ لا تزال مسلكَ جَعْس",14,"س",1,0],["أنكر اللَّهُ أن يُرى مثلُ مدحي","في أبي الفقْرِ وهْو غيرُ مُنيل",15,"ل",1,0],["أنكِرا منكراً من الأمرِ نُكراً","واعدِلا بي هُديتما إعدالي",16,"ل",2,0],["أنكره إنكار امرئٍ عرف الردى","ورأى النفوس بأن يَمتْن رهائنا",17,"ن",2,0],["أَنكَرَت مُقلَتي الكَرى","حينَ عَرَّفتَها السَهَر",18,"ر",1,0],["أَنكَرَ العاذِلُ مِنّي","أَنَّ قَلبي يَتَقَلَّب",19,"ب",1,0],["إِنَّ كَرمَها","آدَمُ العِنَب",20,"ب",1,0],["أَنكَرتُ طارِقَةَ الحَوادِثِ مَرَّةً","ثُمَّ اِعتَرَفتُ بِها فَصارَت دَيدَنا",21,"ن",2,0],["أنكرته إذ رأيته وجنته","وحسنه قد محته لحيته",22,"ت",2,1],["أَنكَرَ الصُبحُ دَمَ اللَي","لِ وَفي العُذرِ تَوَصَّل",23,"ل",1,1],["إِن كَرَّرَ العاذِلونَ ذِكرَكُمُ","صَغا وَأَصغى إِلَيهِمُ أُذُنَه",24,"ن",2,0],["أنكرتَ بي ناري عشيةَ لامست","شفتاي منك أناملَ العنابِ",25,"ب",1,0],["إن كرّمتكِ البلادُ","ودانت لمعبودةٍ قادره",26,"ر",2,0],["أنكرتنا وهي كانت إن رأتنا","يضحك النور إلينا من بعيد",27,"د",1,0],["أنكرتُها طُرّاً ولم أعترف","إلا بطيبٍ جاء من جنّتك",28,"ك",1,0],["أنكر الجنة قلبٌ ضجر","أبدي النار موصول الجحيم",29,"م",1,0],["أَنْكَرْتَ أَرْبَابَ قَوْمٍ مِنْ صِنَاعَتِهِمْ","وَرُبَّمَا صَنَعَ الإنْسَانُ مَا عَبَدَا",30,"د",2,0],["أَنكَرَتني حَليلَتي إِذ رَأَتني","كاسِفَ اللَونِ لا أُطيقُ المُزاحا",31,"ح",2,0],["إِن كرَّ في ضَربِ الكماةِ بِمرهَفٍ","قدّ الحديدَ على الكميّ بجدوَلِ",32,"ل",1,0],["أنْكَرَتْ سُقْمَ مُذابِ الجَسَدِ","وهوَ مِن جِنسِ عُيونِ الخُرُدِ",33,"د",1,1],["أَنكَرَتهُم نَفسي وَما ذَلِكَ الإِن","كارُ إِلّا مِن شِدَّةِ العِرفانِ",34,"ن",1,0],["أنكرتْ شيبي فصدتْ ونأتْ","قلتُ إنَّ المالَ للشيبِ دوا",35,"د",3,1],["أنكرَ حبّي مدمَعِي","وقالَ هذا مِنْ هوى",36,"ه",3,1],["أَنكَرتِني اليَومَ بَعدَ مَعرِفَتي","وَبَعدَ جَرّي إِلَيكُمُ رَسَني",37,"ن",2,0],["أنكرتُمُ الإسلامَ دِينَ الهُدَى","والله والسَّيفُ لمن أنكرا",38,"ر",2,0],["أنكرتَ حُسْنَ الفارسيَّةِ غَيْرَةً","وحَسَدْتَها فجعلت نفسَكَ واشيا",39,"ي",2,0],["أنكرتَ فِعلَةَ عمروٍ حين همّ بها","فالنَّفسُ غاضبةٌ والمالُ مبذول",40,"ل",1,0],["أنكروا الحقَّ وراموا غيره","فكأنَّ اللّهَ لا يَجزِي العبادا",41,"د",2,0],["أنكرَ النّاسُ رَبَّهم وتَولَّوْا","يَحسبون الحياةَ إفكاً وَزورا",42,"ر",2,0],["أَنكَرَ العُذّالُ إِعلاني بِهِ","شَأنُ مَن يَعذِلُ فيهِ غَيرُ شاني",43,"ن",2,0],["أَنكَرَت هِندٌ مَشيبي وَوَلَّت","بِدُموعٍ في الرِداءِ تَحومُ",44,"م",1,1],["أنْكَرَتْ مِصْرَ فَهيَ تَنْفِرُ ما لا","حَ بِنَاءٌ لِعَيْنِهَا أوْ خَلاءُ",45,"ا",2,0],["أَنكَرتُها مِنهُ فَعاتَبتُهُ","وَالنُصحُ في الإِخوانِ مَضمونُ",46,"ن",1,0],["أَنكَرتُ ما قَد كُنتُ أَعرِفُهُ","مِنها سِوى المَوعودِ وَالغَدرِ",47,"ر",1,0],["أُنكِرُ النَفسَ وَالفُؤادَ وَلا أَع","رِفُ مَأتى غِوايَةٍ مِن رَشادِ",48,"د",1,0],["أَنكَرتَني حينَ عَرَفتَ الغِنى","أُفٍّ وَتُفٍّ لَكَ يا حارِثُ",49,"ث",1,0],["أَنكَرتَ عَيشَكَ بَعدَهُ","وَالدَهرُ ضاقَ عَلَيكَ رَحبُه",50,"ب",2,0],["أَنكرت ما أَتى المروءة والدس","تور والعدل وَالحجى إنكارا",51,"ر",2,0],["أَنكرت ما حمد الوَرى","وَحمدت ما قَد أَنكروا",52,"ر",3,0],["أُنكِرُ أو أفزع ممن أراه","سيان من يذهب أو من يجيء",53,"ي",2,0],["أنكرتِ ميثاقي وأنكرتني","أَكُلُّ ماضينا وليد الخيال",53,"ل",1,0],["أنكرتُ معناها بغيرِك واستوت","وتشابهت سعةً عليَّ وضيفا",54,"ف",2,0],["أنكرتَ ضَجَّةَ معشرٍ","لم ينصفوك وقد غُبِنْتْ",55,"ت",1,0],["أنكرُوهُ فَحَكَوا عن شاعرِ","جُنَّ بالخمر وأغوتْه النساءْ",56,"ا",2,0],["أَنكَرَ الوَقفَ شَرعُهُم فَلِهَذا","كُلُّ رَبعٍ بِأَرضِهِم مَعمورُ",57,"ر",1,0],["أنكرونا يشهد حطيم قيود","وسمت منكم رقابا وسوقا",58,"ق",2,0],["أنكرِّم الأبطال بال","تَّهريج حولَ المسجد؟",59,"د",1,0],["أنكر الملحدون ما أنكروه","فرددت التنكير بالتعريف",60,"ف",1,0],["أنكر (النهرين) وجهينا من","قبله ، أنكرنا (باب السّبح)",61,"ح",1,0],["أنكرتني حليلتي مذ رأتني","كاسف اللون لا أطيق المزاح",62,"ح",1,0],["انكَرتُ ضَعفاً في شكيمتِه","ومرونةً تدعو إلى الرِيَب",63,"ب",1,0],["أنْكَرْتُ أَن تُغْترَّ عَنْكَ صَنِيعة","ٌ فِي صَالحِ بنِ عطيَّة ِ الحجَّامِ",64,"م",1,0],["أنكر المنكرون إفرادَ نَجْمَيْ","مك وحزمٌ أصبحتَ من أفرادهْ",65,"د",2,0],["أنكره إنكار امرىء عرف الردى","ورأى النفوس بأن يَمتْن رهائنا",66,"ن",2,0],["أنكرت بي ناري عشية لاَمَسَتْ","شفاتي مِنْكَ أناملَ العنابِ",67,"ب",1,0],["أنكر العاذلون ثابتَ حبي","وكفى شاهداً بدمعي عدلات",68,"ل",3,0],["أنكرونا على المشيب كأنّا","لم نكن قبلهم غرانيق مردا",69,"د",2,0],["إن كرّ جيش المشكلاتِ أبادهُ","بصوارمِ الإيضاحِ والتبيينِ",70,"ن",1,0],["أَنكَرَت شَدقَماً وَأَلغَت جَديلاً","مُعرِباتٍ عَنِ الرِياحِ السَوافي",71,"ف",2,0],["أَنْكَرَني حَتَّى كَأَنْ لَمْ يَكُنْ","يَعْرِفُني مِنْ دَهْرِهِ يَوْمَا",72,"م",2,0],["أنكرت ياعاذل ما يجهله","لو ذقت بسطت عذرى",73,"ر",2,0],["أنكرت حراً بات طول ليله","يكثر في العيب الجدال عنكما",74,"ك",3,0],["أَنكَرتِني لِلشّيبِ وَهوَ جَلالَةٌ","أَوَ كَيفَ يُنكَرُ لِلصِقالِ مُهَنَّدُ",75,"د",1,0],["أَنكَرتَني وَلَسَوفَ تَعرِفُني","فَتُقِرُّ أَنّي واحِدُ العَصرِ",76,"ر",1,0],["أَنكَرَ العَبدُ بَزَّهُ وَحُلاَهُ","لِسُؤَالٍ أَتَاهُ مِن مَولاَهُ",77,"ا",2,1],["أَنكَرتِ مِن أَدمُعي تَترى سَواكِبُها","سَلِي دُمُوعي هَل أَبكي سِواكِ بِها",78,"ه",2,1],["إنْ كَرَّ يومَ وغىً بالنَّصْرِ مَدَّرِعاً","كأنَّهُ نَجْمُ قَذْفٍ وهو طَفَّاقُ",79,"ق",1,0],["أنكرت منذ رأتك معرفة النو","م كما أنكرت لحسنك ثان",80,"ن",1,0],["أَنكَرَ النومُ مقلَةَ الأُختِ حَتّى","آلَفَت رهبَةَ الدُجى وَالسَريرا",81,"ر",2,0],["أَنكَرنَ مِنّي شَيباً وَعُدماً","وَلا بِضاعٌ وَلا بِضاعَه",82,"ع",2,0],["أَنكَرَ الغانِياتُ عَهدي وَما أَن","كَرنَ مِنّي بَياضَ القَتيرِ",83,"ر",1,0],["أَنكَرتُهُ وَنُحولُ جِس","مي فيهِ وَالعبَراتُ تَشهَد",84,"د",1,0],["أنكرتَ ما بي من جَوى","غالبَ صبري فانَغَلَب",85,"ب",1,0],["أَنكَروا شَكوايَ مِمّا أَجِدُ","مِثلُ حالي حَقُّها أَن تَشتَكي",86,"ي",1,0],["انكرت ربعه الرياح جنوبا","وَشمالا شامية وَقبولا",87,"ل",2,0],["أَنْكَرْتَ فِيها الْهَوى ثُمَّ اعْتَرَفْتَ بِهِ","وَما اعْتِرافُكَ إلاّ دَمْعُكَ الْجارِي",88,"ر",2,0],["أنكرتَهم وزهدتَ في دنيا","همُ دنيا الكذاب",89,"ب",1,0],["انكرت فعل السحر دهراً وقد","آمنت بالسحر لدن رؤيته",90,"ت",2,0],["انكرَتنا كنانةُ اللَه إن لم","نتبوّأ مكاننا المسلوبا",91,"ب",2,0],["أنكري إن قدرت حزن أغاري","دي وقد أنكرت الغرام الحزينا",92,"ن",2,0],["أنكروا الحبّ طاهرا وأغاروا","بقَناهُم على معاقل حبّي",92,"ي",1,0],["أَنكرُوا المعروفَ حتَّى","صارَ بينَ القَوْم مُنْكَرْ",93,"ر",1,1],["أَنكَروها إِذا بَدَت وَعَلى","طَيفِها لَمّا اِختَفَت داروا",94,"ر",3,0],["أنكر الحِبُّ إِذ لَثمتُ يَمينا","مِنهُ حالي فَقال شُرّفتَ قَدرا",95,"ر",2,1],["أَنكَرا حبه وَجارا عَلى خَص","ر تَشكى أَردافَهُ المللآنه",96,"ن",2,0],["أنكرتْ أنّني أَبِيتُ مَشوقاً","وكفَى الصَّبَّ بالنّجومِ شُهودا",97,"د",2,0],["أَنكَرتُ بَعدَكُما الوُجوهُ فَكُلُّ مَن","قَد كانَ ذا وَجهٍ لَهُ وَجهانِ",98,"ن",1,0],["أنكرتُ أنَّ اسماً يكون","مِن الأَنامِ لِغَيرِ مَعنَى",99,"ن",2,1],["أنكروها غَوايةً من رشيد","فغَدوا يهتفون بالتفنيدِ",100,"د",1,1],["إِن كَرَّ يَوماً رَأَيت الهَام طائِرة","كَما تَدَحرج في مَيدانِها الأَكرُ",101,"ر",1,0],["إِنكَرى مَعرضاً عَني","وَتُهمِلُني وَتَهتَضم",102,"م",1,0],["أنكرتُمُ حالَهُ مِن بعد مُعْرفةٍ","بهِ وكيفَ وقَدْ مَيّزّتُم الحَالاَ",103,"ل",2,0],["أنكرَ العَاذِلُ وجْدي","وعلى الوجْدِ دلائِلْ",104,"ل",1,0],["أنكرتِ من أدمُعي نَثري سواكِبَها","سَلي دُموعي هلْ أبكي سِواكِ بِها",105,"ه",2,1],["أَنكرتُ قسوتَهُمْ وأعرفُهُمْ","كُرمَاءَ إمّا استُعطِفُوا عَطَفُوا",106,"ف",3,0],["أنكرتُ هجري والزّمانُ بِجَوره","يَقضِي بأن يَتهاجرَ الأحبابُ",107,"ب",1,0],["أَنكرتَ معرفتي على عهد النوى","ومَنَحْتَني بَعدَ الوصال صدودا",108,"د",2,0],["انكرتم اليوم ناصيفا واسرته","نبشتم قبر شديقان وبستاني",109,"ن",2,0],["أنكرتْ صبغتين خنساء في شَع","ري بياضاً