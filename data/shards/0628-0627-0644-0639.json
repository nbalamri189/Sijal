",""],[6106,"تحية للمستشارة : د . نهى الصادق الزيني","https://www.poetsgate.com/ViewPoem.aspx?id=6309",""],[6142,"يا مفعم البئر في بدر أشاوسة","https://www.poetsgate.com/ViewPoem.aspx?id=155712",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577049",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""],[5309,"فرخ من الجن بين المجرمين ربي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573553",""],[496,"دع ذكر ايام الشباب الراحل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=599109",""],[520,"بصفات مجدك يشرف التمجيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577470",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[402,"مولاي أيدك الرحمن في نعم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54040&r=&rc=892",""]],"verses":[["بِالعَقلِ يُبلَغُ ما تَعَذَّرَ بِالقَنا","وَظُبى القَواضِبِ وَالعُقولُ مَواهِبُ",0,"ب",1,0],["بِالْعَفْوِ خُذْ مِنْهُمْ وَلاَ تَكْشِفْ لَهُمْ","سِتْراً فَلَسْتَ عَلَى كَبِيرٍ تَحْصُلُ",1,"ل",1,0],["بِالعَدلِ قُمتَ أَميناً حينَ خالَفَهُ","أَهلُ الهوَى وَذَووُ الأهواءِ وَالزورِ",2,"ر",1,0],["بِالعِلمِ حَلَّت صَدرَها","لا بِاللَآلِئِ وَالدُرَر",3,"ر",1,0],["بالعلم والحزم اعتضد واعتدد","لتغدو الأرشد والأمثلا",4,"ل",2,0],["بِالعَدْلِ يَقْضِي فِي الحُقُوقِ وَبِالنَّدَى","يَقْضِي حُقُوقَ الأَهْلِ وَالجِيرَانِ",5,"ن",1,0],["بِالعِيدِ وَالضَّيْفِ المَجِي","دِ جَمِيعُ مَنْ فِي مَصْرَ هَانِي",6,"ن",2,0],["بِالعَفْوِ عَنْهُ وَكَادَتْ كُل مُدَّتِهِ","تُقْضَى فَمَا ثَمَّ إِلاَّ لَفْظَةٌ بِفَمِ",7,"م",1,0],["بِالعِلْمِ يُدْرِكُ أَقصَى المَجْدِ مِنْ أَمَمٍ","وَلا رُقِيَّ بِغَيْرِ العِلْمِ لِلأُمَمِ",8,"م",1,1],["بالعشيّ لو تراني","حن نصرّف خنزوانا",9,"ن",2,0],["بالعبقري بفيلسوف زمانه","بأديب أمته بداهي جِيله",10,"ل",2,0],["بالعلم تَنْتظِم البلاد فإنه","لرُقِيِّ كل مدينة مِرقاة",11,"ه",1,0],["بِالعَذبِ في رَصَفِ القِلاتِ مَقيلُهُ","قَضُّ الأَباطِحِ لا يَزالُ ظَليلا",12,"ل",2,0],["بِالعَنبَرِيَّةِ وَالنَحيتِ أَوانِسٌ","قُدنَ الهَوى بِتَخَلُّبٍ وَعِذامِ",13,"م",1,0],["بِالعَذبِ في رَضَفِ القِلاتِ مُقيلَةً","قِضنَ الأَباطِحَ لا يَزالُ ظَليلا",14,"ل",2,0],["بالعيشجور كأنني وقتودها","بالسهب فوق سراة أزعر نقنق",15,"ق",1,0],["بِالعارِ وَالذُلُّ المُبَيِّنِ إِذ رَأَوا","بيضَ السُيوفِ تَسوقُ كُلَّ هُمامِ",16,"م",1,0],["بالعلم والعمل المبرورِ قد ملئت","أرضٌ بكم وسماءٌ عن أبٍ فأب",17,"ب",1,0],["بالعُشبِ بالفَنَن المنوِّرِ","بالسَّنابلِ بالسَّفيرْ",18,"ر",1,0],["بِالعَقلِ تَزدَحِمُ الهُمومُ عَلى الحَشا","فالعَقلُ عِندي أَن تَزولَ عُقولُ",19,"ل",1,0],["بالعبقرية بالهدى","بممثلي مصر الرؤم",20,"م",1,0],["بِالعِلمِ يُبنى المُلكُ حَقَّ بِنائِهِ","وَبِهِ تُنالُ جَلائِلُ الأَخطارِ",21,"ر",1,0],["بِالعِلمِ وَالمالِ يَبني الناسُ مُلكَهُمُ","لمَ يُبنَ مُلكٌ عَلى جَهلٍ وَإِقلالِ",22,"ل",1,0],["بِالعِلمِ سادَ الناسُ في عَصرِهِم","وَاِختَرَقوا السَبعَ الطِباقَ الشِداد",23,"د",1,0],["بالعدل قام الخلق وهو ملاكهُ","وبه استقام نظامه ومساكُه",24,"ك",2,1],["بِالعَنبَرِيَّةِ دارٌ قَد كَلِفتُ بِها","لَو كانَ يَرجِعُ مَأهولاً لِيَ القَدَرُ",25,"ر",1,1],["بِالعيسِ قاسَمنا الفَلا أَشلاءَها","وَالبيدُ لا يُعطى السَواءَ قَسيمُها",26,"م",3,0],["بِالعَوالي يَهتِكنَ عَن كُلِّ قَلبٍ","صَدرَهُ أَو حِجابَهُ المَحجوبا",27,"ب",2,0],["بالعبدِ شوقٌ ثوى بهْ","فاغنمْ جزيلَ ثوابِهْ",28,"ب",2,0],["بِالعَرصَتَينِ فَمَجرى السَيلِ بَينَهُما","إِلى القَرينِ إِلى ما دونَهُ البُسُرُ",29,"ر",1,0],["بالعاديات لديْه ضبحاً","والأَسنَّةُ في اللَّبانِ",30,"ن",1,0],["بِالعيسِ مُصغِيَةَ الخُدو","دِ لِأَزمَلِ الحادي المُوائِل",31,"ل",1,0],["بالعلومِ التي عَليكَ مِن الل","هِ بلا كاتِبٍ لها إِمْلاءُ",32,"ا",2,0],["بالعبقرية بالإبداع في الأدبِ","الشعر أَصبح بالأستاذ مغتبطاً",33,"ط",2,0],["بالعقل لوذوا إذا حمَّت مخالفة","فإنه وحده بالحق يحتكم",34,"م",1,0],["بالعلم تحيا الأرض فاِع","لَم بين دجلة وَالفرات",35,"ت",1,0],["بالعلم طار المرء حت","تى مر من بين السحائب",36,"ب",1,0],["بالعلم قد تم اتصا","ل للمشارق بالمغارب",36,"ب",1,0],["بالعلم صار يكلم ال","إنسان آخر وَهوَ عازب",36,"ب",1,0],["بالعلم أَضحى الناس يط","وون البحار مَع السباسب",36,"ب",1,0],["بالعلم تتحد الآراء صائبة","والرأي يفعل مالا يفعل الأسل",37,"ل",1,0],["بالعلم أطلعت البلاد كواكباً","بالعلم صارَت تنطق الأحجار",38,"ر",1,0],["بالعلم قد ناجى مقيم نازحاً","وَعَلى الأثير تمشت الأخبار",38,"ر",1,0],["بالعلم أدنى الناس شقة أَرضهم","بالعلم غاصوا في البحار وَطاروا",38,"ر",3,0],["بالعلم قد طالَت فأدركت المنى","أَيدٍ عن الغرض الرَفيع قصار",38,"ر",1,0],["بالعلم قد لبس العراق حضارة","ما إن تردت مثلها الأمصار",38,"ر",1,0],["بالعلم قَد ملكت شعو","ب الغرب ناصية المَعالي",39,"ل",2,0],["بالعَقل لَيسَ الفَيلَسوف بمدرك","ما يطمئن له من الآباد",40,"د",1,0],["بِالعَنْدَلِ البَازِلِ المِقْلاَتِ عُرْضَتُهَا","بُزْلُ المَطِيِّ إِذَمَا ضَمَّهَا النِّسَعُ",41,"ع",1,0],["بالعدل والدّرّة طار بالعرب","وسار في الجوّ بهم وفي السّرب",42,"ب",1,0],["بالعِلمِ يفخر يوْم الحفلِ حامِلُه","وبالعفافِ غداة الجمْعِ يزدانُ",43,"ن",1,0],["بِالعَزْمِ ما بَعُدَ الفَتْحُ العزِيزُ مَضَى","وَالرَّأْيِ مَا رَقِيَ القَصْدُ المَرُومُ رَقِي",44,"ق",2,0],["بِالعَازِمِ العزمَاتِ وَهيَ صَوَادِقٌ","وَمُعَاقِبِ الظُّلُمَاتِ بِالأَسْحَارِ",45,"ر",1,0],["بِالْعُزْلَةِ اكْتَمَلُوا وَرُبُّ مُرَوِّضٍ","لِلنَّفْسِ حَرَّرَهَا بِالاسْتئْسَارِ",46,"ر",1,0],["بِالعِلْمِ وَالخِبْرَةِ ضم الْقُوَى","فِي الْقطْرِ فَانْضَمَّتْ وَكَانَتْ بَدَادْ",47,"د",1,0],["بِالعَزْمِ وَالحَزْمِ يَسْتَوْفِي مَطَالِبَهَا","وَهَلْ بِغَيْرِهِمَا إِدْرَاكُ مَنْشُودِ",48,"د",1,0],["بِالْعِلْمِ وَالْفَن مُصْلِحَاتٌ","مَا بَثهُ الجَّهْلُ مِنْ فَسَاد",49,"د",1,0],["بِالْعلْمِ نَنْشُرُ مَا انْطَوَى مِنْ مَجْدِنا","وَبِهِ نُزَكِّي فِي الوَرَى ذِكْرَاكِ",50,"ك",1,0],["بِالعِلْمِ لاَ يَسْمُو إِلَيْهِ مُنَافِسٌ","وَالحِلْمِ لاَ يَرْقَى إِلَيْهِ نَدِيدُ",51,"د",1,0],["بالعناقيد سرت نفحةُ طيب","فإذا الزهراةُ ترنو من علِ",52,"ل",1,0],["بالعدْلِ قمعتَ مظالِمَها","وَبِحُسنِ الرأَيِ تُسَدِّدهُ",53,"د",2,0],["بِالْعِلْمِ مَرْكُونِي تَسَلَّقَ لِلْعُلا","وَبعَزْمَةِ الْوَثّابَةِ الطمّاحِ",54,"ح",1,0],["بالعدل تهتف وهْوَ من","أحكامها دامي الجراح",55,"ح",1,0],["بالعصيين دمعه وبيانه","لا تلم شاعراً على خذلانه",56,"ن",2,1],["بالعزم نِلْ يا شرق ما لم يُنَلْ","فالغرب قد طار بِهذا الجَناح",57,"ح",1,0],["بالعندل البازل المقلات عرضتها","بزل المطيِّ إذا ما ضمها النِّسغ",58,"غ",1,0],["بالعابدين الخلص الخاشعي","ن الزاهدين الركع الساجدين",59,"ن",1,0],["بالعلماء السادة الأعلام","والصلحاء القادة الكرام",60,"م",1,0],["بالعارف المكمل الموجز","الكمال القطب أبي القرمزي",60,"ي",1,0],["بالعذلِ تُوقَد لوعتى","وبقَدحِه يُوَرى الزنَّادُ",61,"د",1,0],["بِالعَزمِ حينَ يَخونُ العَزمُ طالِبَهُ","وَالغَزوِ حينَ يُمَلُّ السَرجُ وَالقَتَبُ",62,"ب",1,0],["بِالعُشرِ مِن مِعشارِها وَكانَ كَال","حَسوَةِ في آذِيِّ بَحرٍ قَد طَما",63,"ا",1,0],["بالعشقِ عمَّدناهُ منتصراً","بالحبّ \"رقَّصْناهُ \" بالزّجَلِ",64,"ل",1,0],["بالعِزِّ والفَخْرِ والعَلْياءِ مُرْتدياً","وبالسَخَاءِ ورَبُّ السيفِ والقَلَمِ",65,"م",1,0],["بِالعَين عن كلِّ وجهٍ","سواكَ مذ غبتَ صَوْمُ",66,"م",1,0],["بالْعِلْمِ وَالحِْلْمِ والإِدْراكِ في مَهَلٍ","لمَّا تَعَاصَى على السُّمَّارِ في الدَّاجِ",67,"ج",1,0],["بالعدل يأمر والإحسان ينشره","والخير يبذر والإيمان يرسيه",68,"ي",2,0],["بالعارف النابُلُسي عبدِ الغني","روض الهبات زهرة الفتح الجني",69,"ي",1,0],["بالعدلِ أرسلها لخيرِ عبادِهِ","تنهَى كما يقضي الرشاد وتأمر",70,"ر",1,0],["بِالْعَالَمِ العُلْوِيِّ في حَضَرٍ وفي","سَفَرٍ يُحَفُّ وذاكَ ما لا يُدْفَعُ",71,"ع",1,0],["بِالْعَزْمِ إِذْ يُنْطِيكَ عَفْوَ نَجاحِهِ","والْحَزْمَ إِذْ يُمْطِيكَ ظَهْرَ أَمُونِهِ",72,"ن",2,0],["بِالعَدلِ تَزدانُ المُلوكُ وَما","شانَ اِبنَ أَيّوبَ سِوى العَدلِ",73,"ل",1,1],["بِالعَدلِ آثَرَكَ المَليكُ عَلَيهِمُ","يا مُؤثِراً أوزِعتَ شُكرَ المُؤثِرِ",74,"ر",1,0],["بالعلم نلت لدى الملوك مكانة","علياء يقصر عن ذراها المعرب",75,"ب",1,0],["بالعشرِ يحرسُ عشركم","وَلَكم مُناويكم فدى",76,"د",2,0],["بِالعَدَدِ الكامِلِ لَمّا بَدا","تَمَّت لَهُ في ا