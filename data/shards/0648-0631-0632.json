{"poems":[[53,"رائعات أخفهن ثقيل","https://www.aldiwan.net/poem29826.html","الخفيف"],[53,"رجونا أبا الهيجاء إذ مات حارث","https://www.aldiwan.net/poem30665.html","الطويل"],[53,"لأظما معلينا وأروى المصائبا","https://www.aldiwan.net/poem30735.html","الطويل"],[57,"دع الأيام تفعل ما تشاء","https://www.aldiwan.net/poem24737.html","الوافر"],[72,"ما بت فيك بدمع عيني أشرق","https://www.aldiwan.net/poem19350.html","الكامل"],[92,"يا موت قد مزقت صدري","https://www.aldiwan.net/poem38940.html","مجزوء الكامل"],[85,"يتنازع الأرباب فيك نفاسة","https://www.aldiwan.net/poem7252.html","الكامل"],[45,"أنظر إلى العلياء كيف تضام","https://www.aldiwan.net/poem65657.html","الكامل"],[61,"أسمعتما أن الجبال تضام","https://www.aldiwan.net/poem51425.html","الكامل"],[49,"ما أنا إلا لمن بغاني","https://www.aldiwan.net/poem63146.html","مجزوء البسيط"],[44,"أللعمر في الدنيا تجد وتعمر","https://www.aldiwan.net/poem29671.html","الطويل"],[44,"غطت يداك علي في لحدي","https://www.aldiwan.net/poem30259.html","الكامل"],[105,"حي الخليل وطف بتلك الدار","https://www.aldiwan.net/poem43086.html","الكامل"],[48,"يا رستم بن خداهى","https://www.aldiwan.net/poem66570.html","المجتث"],[46,"تحفظ بدينك يا ناسكا","https://www.aldiwan.net/poem22753.html","المتقارب"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[115,"بدأت ببسم الله في مبدأ الأمر","https://www.aldiwan.net/poem42205.html","الطويل"],[135,"شفيق مضى والدهر خانك يا مصر","https://www.aldiwan.net/poem49167.html","الطويل"],[186,"ومحبرة توانسني بحبر","https://www.aldiwan.net/poem43526.html","الوافر"],[235,"أتظنني ما عشت أنعم بالا","https://www.aldiwan.net/poem31787.html","الكامل"],[270,"حياة الناس تقتير وحرص","https://www.aldiwan.net/poem35180.html","الوافر"],[282,"إلى الملك المهيمن نستغيث","https://www.aldiwan.net/poem32839.html","الوافر"],[371,"نكرت معرفتي لما حكم","https://www.aldiwan.net/poem57166.html","الرمل"],[458,"لها كل يوم نشطة وعقال","https://www.aldiwan.net/poem55906.html","الطويل"],[551,"لك الليل بعد الذاهبين طويلا","https://www.aldiwan.net/poem47299.html","الطويل"],[551,"ما للخيال ببطن مر يطرق","https://www.aldiwan.net/poem47378.html","الكامل"],[551,"قف بالديار المقفرات","https://www.aldiwan.net/poem48026.html","مجزوء الكامل"],[567,"أتأسى يا أبا بكر","https://www.aldiwan.net/poem69652.html","مجزوء الوافر"],[567,"غدر الزمان وجار في أحكامه","https://www.aldiwan.net/poem69653.html","الكامل"],[567,"نفسي الفداء لمن إذا جرح الأسى","https://www.aldiwan.net/poem69820.html","الكامل"],[575,"لئن كنت من عيني نقلت إلى قلبي","https://www.aldiwan.net/poem2789.html","الطويل"]],"verses":[["وَرَزايا تَهفو لَهُنَّ حُلومٌ","راسِياتٌ وَتَستَزِلُّ عُقولُ",0,"ل",1,0],["وَرُزءٌ رَمى بَينَ القُلوبِ شَواظَهُ","أَجيجُ المَصالي أَسعَرَتها المَحارِثُ",1,"ث",1,0],["وَرَزءٌ رَمى صَدرَ الأَماني بِيَأسِها","وَكُنَّ إِلى وِردِ المَعالي قَوارِبا",2,"ب",2,0],["وَرِزقُكَ لَيسَ يُنقِصُهُ التَأَنّي","وَلَيسَ يَزيدُ في الرِزقِ العَناءُ",3,"ا",2,0],["ورزقت من جفنيك ما حسد الورى","حظي عليه وهو رزق ضيق",4,"ق",1,0],["وَرَزَأْتَني في عُمْدَتي","ومَشُورَتي في كلِّ أمْرِ",5,"ر",1,0],["ورزقته دار المؤيد فابتنى","فيها القصور وشيد الأملاكا",6,"ك",2,0],["وَرَزيئَةٌ حَمَلَ الخَليفَةُ شَطرَها","وَالمُسلِمونَ وَشَطرَها الإِسلامُ",7,"م",1,0],["وَرَزيَّةٌ أَخَذَ الرَّدَى ما يبتَغي","منّا ونالَ بها الذي يَستامُ",8,"م",1,0],["وَرِزقُ رَبّي لَهُ وُجوهٌ","هُنَّ مِنَ اللَهِ في ضَمانِ",9,"ن",1,0],["وَرِزقُكَ لا يَعدوكَ إِمّا مُعَجَّلٌ","عَلى حالَةٍ يَوماً وَإِمّا مُؤَخَّرُ",10,"ر",1,0],["وَرُزِقتُ مِنكَ العَطفَ ما حَمَلَت","عَيني الدُموعَ وَدامَ لي وَجدي",11,"ي",1,0],["وَرُزِقتَ ميراثَ النَوابِغِ كُلِّهِم","فيما وَرِثتَ اليَومَ مِن أَشعاري",12,"ر",2,0],["ورزّةِ العيدانِ","وكلّ بم وثانِ",13,"ن",1,0],["وَرِزقُكَ يَأتي بِلا رَيبَةٍ","فَسِر في بِلادِكَ أَو لا تَسِر",14,"ر",1,0],["ورزقتْ أرباب سيف قادهْ","أعطتهمو الممالك المقادهْ",15,"ه",1,0],["ورزاق فارزقني الهداية والتقى","وبالفتح يا فاتح تمم علا قدري",16,"ي",1,0],["ورزء لا يُطاقُ عليه صبرٌ","ولا يجدي التحسُّرُ والبكاءُ",17,"ا",2,0],["ورزمة كاغد في البيت عندي","أحبّ إلي من عدل الدقيق",18,"ق",1,0],["وَرُزِئتُ مِنكَ بِهِمَّةٍ عَلَوِيَّةٍ","أَحرَزتَ مِنها الفَضلَ وَالإِفضالا",19,"ل",2,0],["ورزقُ الوحشِ والأطيارِ يأتي","بلا كدٍّ ورزقُ المرءِ قَنص",20,"ص",1,0],["وَرُزءٌ كُوِّرَت شَمسُ المَعالي","لَهُ أَسَفاً وَأُبهِجَ مَن يَعيثُ",21,"ث",1,0],["ورَزايا المُصطَفَى في أهلِهِ","فاتِحاتٌ لِلرَّزايا وختم",22,"م",1,0],["ورزقُ يد المسئول مفتاحُ بابه","وشرُّ نوالٍ ما جناه سؤالُ",23,"ل",1,0],["ورُزءٌ حملتُ الثِّقْلَ منه كأنّني","مدى الدّهر لم أحملْ سواه ثقيلا",24,"ل",2,0],["ورُزقتُ لمّا أن سعيتُ إلى العُلا","فاِسعوا كما أنّي سعيتُ لتُرزقوا",25,"ق",3,0],["وَرَزيّةٍ للدّين لي","ستْ كالرّزايا الماضِياتِ",26,"ت",1,0],["وَرُزْءٌ أَشْبَهَ النِّعْمَ","ةَ فِي المَوْقِعِ وَالقَدْرِ",27,"ر",1,0],["وَرُزِئْتُ أَعْلاَقَاً عَلَيَّ كَرِيْمَةً","مِنْ قَبْلِ أَنْ تُقْضَى بِهَا أَوْطَارِي",28,"ر",2,0],["ورزقته حَسَنَ القبول مهنِّئاً","فيه عطاءُ الله ذي الألاءِ",29,"ا",2,0],["وَرُزؤُكِ أَشْهى من سُهادِي لناظِرِي","ورُوحي إِلى جسْمِي وأَمْنى إِلى قَلْبي",30,"ي",1,0]]}