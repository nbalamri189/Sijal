{"poems":[[53,"رائعات أخفهن ثقيل","https://www.aldiwan.net/poem29826.html","الخفيف"],[53,"رجونا أبا الهيجاء إذ مات حارث","https://www.aldiwan.net/poem30665.html","الطويل"],[53,"لأظما معلينا وأروى المصائبا","https://www.aldiwan.net/poem30735.html","الطويل"],[57,"دع الأيام تفعل ما تشاء","https://www.aldiwan.net/poem24737.html","الوافر"],[72,"ما بت فيك بدمع عيني أشرق","https://www.aldiwan.net/poem19350.html","الكامل"],[92,"يا موت قد مزقت صدري","https://www.aldiwan.net/poem38940.html","مجزوء الكامل"],[85,"يتنازع الأرباب فيك نفاسة","https://www.aldiwan.net/poem7252.html","الكامل"],[45,"أنظر إلى العلياء كيف تضام","https://www.aldiwan.net/poem65657.html","الكامل"],[61,"أسمعتما أن الجبال تضام","https://www.aldiwan.net/poem51425.html","الكامل"],[49,"ما أنا إلا لمن بغاني","https://www.aldiwan.net/poem63146.html","مجزوء البسيط"],[44,"أللعمر في الدنيا تجد وتعمر","https://www.aldiwan.net/poem29671.html","الطويل"],[44,"غطت يداك علي في لحدي","https://www.aldiwan.net/poem30259.html","الكامل"],[105,"حي الخليل وطف بتلك الدار","https://www.aldiwan.net/poem43086.html","الكامل"],[48,"يا رستم بن خداهى","https://www.aldiwan.net/poem66570.html","المجتث"],[46,"تحفظ بدينك يا ناسكا","https://www.aldiwan.net/poem22753.html","المتقارب"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"]],"verses":[["وَرَزايا تَهفو لَهُنَّ حُلومٌ","راسِياتٌ وَتَستَزِلُّ عُقولُ",0,"ل",1,0],["وَرُزءٌ رَمى بَينَ القُلوبِ شَواظَهُ","أَجيجُ المَصالي أَسعَرَتها المَحارِثُ",1,"ث",1,0],["وَرَزءٌ رَمى صَدرَ الأَماني بِيَأسِها","وَكُنَّ إِلى وِردِ المَعالي قَوارِبا",2,"ب",2,0],["وَرِزقُكَ لَيسَ يُنقِصُهُ التَأَنّي","وَلَيسَ يَزيدُ في الرِزقِ العَناءُ",3,"ا",2,0],["ورزقت من جفنيك ما حسد الورى","حظي عليه وهو رزق ضيق",4,"ق",1,0],["وَرَزَأْتَني في عُمْدَتي","ومَشُورَتي في كلِّ أمْرِ",5,"ر",1,0],["ورزقته دار المؤيد فابتنى","فيها القصور وشيد الأملاكا",6,"ك",2,0],["وَرَزيئَةٌ حَمَلَ الخَليفَةُ شَطرَها","وَالمُسلِمونَ وَشَطرَها الإِسلامُ",7,"م",1,0],["وَرَزيَّةٌ أَخَذَ الرَّدَى ما يبتَغي","منّا ونالَ بها الذي يَستامُ",8,"م",1,0],["وَرِزقُ رَبّي لَهُ وُجوهٌ","هُنَّ مِنَ اللَهِ في ضَمانِ",9,"ن",1,0],["وَرِزقُكَ لا يَعدوكَ إِمّا مُعَجَّلٌ","عَلى حالَةٍ يَوماً وَإِمّا مُؤَخَّرُ",10,"ر",1,0],["وَرُزِقتُ مِنكَ العَطفَ ما حَمَلَت","عَيني الدُموعَ وَدامَ لي وَجدي",11,"ي",1,0],["وَرُزِقتَ ميراثَ النَوابِغِ كُلِّهِم","فيما وَرِثتَ اليَومَ مِن أَشعاري",12,"ر",2,0],["ورزّةِ العيدانِ","وكلّ بم وثانِ",13,"ن",1,0],["وَرِزقُكَ يَأتي بِلا رَيبَةٍ","فَسِر في بِلادِكَ أَو لا تَسِر",14,"ر",1,0],["ورزقتْ أرباب سيف قادهْ","أعطتهمو الممالك المقادهْ",15,"ه",1,0]]}