{"poems":[[55,"رائعات أخفهن ثقيل","https://www.aldiwan.net/poem29826.html","الخفيف"],[55,"رجونا أبا الهيجاء إذ مات حارث","https://www.aldiwan.net/poem30665.html","الطويل"],[55,"لأظما معلينا وأروى المصائبا","https://www.aldiwan.net/poem30735.html","الطويل"],[59,"دع الأيام تفعل ما تشاء","https://www.aldiwan.net/poem24737.html","الوافر"],[74,"ما بت فيك بدمع عيني أشرق","https://www.aldiwan.net/poem19350.html","الكامل"],[94,"يا موت قد مزقت صدري","https://www.aldiwan.net/poem38940.html","مجزوء الكامل"],[87,"يتنازع الأرباب فيك نفاسة","https://www.aldiwan.net/poem7252.html","الكامل"],[47,"أنظر إلى العلياء كيف تضام","https://www.aldiwan.net/poem65657.html","الكامل"],[63,"أسمعتما أن الجبال تضام","https://www.aldiwan.net/poem51425.html","الكامل"],[51,"ما أنا إلا لمن بغاني","https://www.aldiwan.net/poem63146.html","مجزوء البسيط"],[46,"أللعمر في الدنيا تجد وتعمر","https://www.aldiwan.net/poem29671.html","الطويل"],[46,"غطت يداك علي في لحدي","https://www.aldiwan.net/poem30259.html","الكامل"],[107,"حي الخليل وطف بتلك الدار","https://www.aldiwan.net/poem43086.html","الكامل"],[50,"يا رستم بن خداهى","https://www.aldiwan.net/poem66570.html","المجتث"],[48,"تحفظ بدينك يا ناسكا","https://www.aldiwan.net/poem22753.html","المتقارب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[119,"بدأت ببسم الله في مبدأ الأمر","https://www.aldiwan.net/poem42205.html","الطويل"],[139,"شفيق مضى والدهر خانك يا مصر","https://www.aldiwan.net/poem49167.html","الطويل"],[190,"ومحبرة توانسني بحبر","https://www.aldiwan.net/poem43526.html","الوافر"],[240,"أتظنني ما عشت أنعم بالا","https://www.aldiwan.net/poem31787.html","الكامل"],[275,"حياة الناس تقتير وحرص","https://www.aldiwan.net/poem35180.html","الوافر"],[287,"إلى الملك المهيمن نستغيث","https://www.aldiwan.net/poem32839.html","الوافر"],[376,"نكرت معرفتي لما حكم","https://www.aldiwan.net/poem57166.html","الرمل"],[463,"لها كل يوم نشطة وعقال","https://www.aldiwan.net/poem55906.html","الطويل"],[556,"لك الليل بعد الذاهبين طويلا","https://www.aldiwan.net/poem47299.html","الطويل"],[556,"ما للخيال ببطن مر يطرق","https://www.aldiwan.net/poem47378.html","الكامل"],[556,"قف بالديار المقفرات","https://www.aldiwan.net/poem48026.html","مجزوء الكامل"],[572,"أتأسى يا أبا بكر","https://www.aldiwan.net/poem69652.html","مجزوء الوافر"],[572,"غدر الزمان وجار في أحكامه","https://www.aldiwan.net/poem69653.html","الكامل"],[572,"نفسي الفداء لمن إذا جرح الأسى","https://www.aldiwan.net/poem69820.html","الكامل"],[580,"لئن كنت من عيني نقلت إلى قلبي","https://www.aldiwan.net/poem2789.html","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54085","الطويل"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146215","المديد"],[816,"","https://poetry.dctabudhabi.ae/diwan/poem/107105","الكامل"],[849,"","https://poetry.dctabudhabi.ae/diwan/poem/105612","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77610","الرجز"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100133","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120075","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120141","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64678","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80020","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49057","الكامل"],[1715,"","https://poetry.dctabudhabi.ae/diwan/poem/17527","الوافر"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144778","الطويل"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96502","الطويل"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95402","الوافر"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118430","البسيط"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88645","المتقارب"],[2452,"","https://poetry.dctabudhabi.ae/diwan/poem/141053","الكامل"],[2554,"","https://poetry.dctabudhabi.ae/diwan/poem/198814","الطويل"],[2565,"","https://poetry.dctabudhabi.ae/diwan/poem/103727","الطويل"],[2888,"","https://poetry.dctabudhabi.ae/diwan/poem/46729","الكامل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97964","الكامل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100196","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/63016","البسيط"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127022","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66429","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135230","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135867","الرجز"],[4110,"","https://poetry.dctabudhabi.ae/diwan/poem/101162","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97069","المتقارب"],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101933","الرمل"],[4664,"","https://poetry.dctabudhabi.ae/diwan/poem/101169","الكامل"],[4858,"الى الام التي ترضع طفلها الحليب الصناعي","https://www.poetsgate.com/ViewPoem.aspx?id=138297",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5186,"طاب يا نشء في نهاك الثناء","https://www.poetsgate.com/ViewPoem.aspx?id=156455",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5370,"قال اسمعي","https://www.poetsgate.com/ViewPoem.aspx?id=85930",""],[5561,"في ذكرى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=193375",""],[6008,"المكوك","https://www.poetsgate.com/ViewPoem.aspx?id=61067",""],[6034,"خطب ألم فسار في الآفاق","https://www.poetsgate.com/ViewPoem.aspx?id=169608",""],[6058,"الأنفاس","https://www.poetsgate.com/ViewPoem.aspx?id=192258",""],[463,"لها كلَّ يومٍ نشطة ٌ وعقالُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60292&r=&rc=348",""]],"verses":[["وَرَزايا تَهفو لَهُنَّ حُلومٌ","راسِياتٌ وَتَستَزِلُّ عُقولُ",0,"ل",1,0],["وَرُزءٌ رَمى بَينَ القُلوبِ شَواظَهُ","أَجيجُ المَصالي أَسعَرَتها المَحارِثُ",1,"ث",1,0],["وَرَزءٌ رَمى صَدرَ الأَماني بِيَأسِها","وَكُنَّ إِلى وِردِ المَعالي قَوارِبا",2,"ب",2,0],["وَرِزقُكَ لَيسَ يُنقِصُهُ التَأَنّي","وَلَيسَ يَزيدُ في الرِزقِ العَناءُ",3,"ا",2,0],["ورزقت من جفنيك ما حسد الورى","حظي عليه وهو رزق ضيق",4,"ق",1,0],["وَرَزَأْتَني في عُمْدَتي","ومَشُورَتي في كلِّ أمْرِ",5,"ر",1,0],["ورزقته دار المؤيد فابتنى","فيها القصور وشيد الأملاكا",6,"ك",2,0],["وَرَزيئَةٌ حَمَلَ الخَليفَةُ شَطرَها","وَالمُسلِمونَ وَشَطرَها الإِسلامُ",7,"م",1,0],["وَرَزيَّةٌ أَخَذَ الرَّدَى ما يبتَغي","منّا ونالَ بها الذي يَستامُ",8,"م",1,0],["وَرِزقُ رَبّي لَهُ وُجوهٌ","هُنَّ مِنَ اللَهِ في ضَمانِ",9,"ن",1,0],["وَرِزقُكَ لا يَعدوكَ إِمّا مُعَجَّلٌ","عَلى حالَةٍ يَوماً وَإِمّا مُؤَخَّرُ",10,"ر",1,0],["وَرُزِقتُ مِنكَ العَطفَ ما حَمَلَت","عَيني الدُموعَ وَدامَ لي وَجدي",11,"د",2,0],["وَرُزِقتَ ميراثَ النَوابِغِ كُلِّهِم","فيما وَرِثتَ اليَومَ مِن أَشعاري",12,"ر",2,0],["ورزّةِ العيدانِ","وكلّ بم وثانِ",13,"ن",1,0],["وَرِزقُكَ يَأتي بِلا رَيبَةٍ","فَسِر في بِلادِكَ أَو لا تَسِر",14,"ر",1,0],["ورزقتْ أرباب سيف قادهْ","أعطتهمو الممالك المقادهْ",15,"ه",1,0],["ورزاق فارزقني الهداية والتقى","وبالفتح يا فاتح تمم علا قدري",16,"ر",2,0],["ورزء لا يُطاقُ عليه صبرٌ","ولا يجدي التحسُّرُ والبكاءُ",17,"ا",2,0],["ورزمة كاغد في البيت عندي","أحبّ إلي من عدل الدقيق",18,"ق",1,0],["وَرُزِئتُ مِنكَ بِهِمَّةٍ عَلَوِيَّةٍ","أَحرَزتَ مِنها الفَضلَ وَالإِفضالا",19,"ل",2,0],["ورزقُ الوحشِ والأطيارِ يأتي","بلا كدٍّ ورزقُ المرءِ قَنص",20,"ص",1,0],["وَرُزءٌ كُوِّرَت شَمسُ المَعالي","لَهُ أَسَفاً وَأُبهِجَ مَن يَعيثُ",21,"ث",1,0],["ورَزايا المُصطَفَى في أهلِهِ","فاتِحاتٌ لِلرَّزايا وختم",22,"م",1,0],["ورزقُ يد المسئول مفتاحُ بابه","وشرُّ نوالٍ ما جناه سؤالُ",23,"ل",1,0],["ورُزءٌ حملتُ الثِّقْلَ منه كأنّني","مدى الدّهر لم أحملْ سواه ثقيلا",24,"ل",2,0],["ورُزقتُ لمّا أن سعيتُ إلى العُلا","فاِسعوا كما أنّي سعيتُ لتُرزقوا",25,"ق",3,0],["وَرَزيّةٍ للدّين لي","ستْ كالرّزايا الماضِياتِ",26,"ت",1,0],["وَرُزْءٌ أَشْبَهَ النِّعْمَ","ةَ فِي المَوْقِعِ وَالقَدْرِ",27,"ر",1,0],["وَرُزِئْتُ أَعْلاَقَاً عَلَيَّ كَرِيْمَةً","مِنْ قَبْلِ أَنْ تُقْضَى بِهَا أَوْطَارِي",28,"ر",2,0],["ورزقته حَسَنَ القبول مهنِّئاً","فيه عطاءُ الله ذي الألاءِ",29,"ا",2,0],["وَرُزؤُكِ أَشْهى من سُهادِي لناظِرِي","ورُوحي إِلى جسْمِي وأَمْنى إِلى قَلْبي",30,"ب",2,0],["ورزق الفتى بالعدل قدر قسمه","فكن واثقاً منه بأفضل مقسومِ",31,"م",1,0],["ورزيق إذ تخلّفه","نسبٌ عمرك مجهول",32,"ل",1,0],["ورزئت قلبك بالنبيّ محمّد","ولرزؤه أدهى لديّ وأعظمُ",33,"م",1,0],["ورزؤك أشجى المسلمين فأصبحوا","يعومون في بحر من الهم تيارا",34,"ر",2,0],["وَرزقه وَإِن يَكُن مَقدورا","أَصبَح مَضموناً لَهُ مَوفورا",35,"ر",2,0],["ورزية أزجى طلائعها الردى","إذ أنت بين المسلمين تهادى",36,"د",2,0],["ورزانة ما إن تخف فطودها","إن خفت الأحلام لود أيهمُ",37,"م",1,0],["ورزقت مجدا لا يؤو","ل مدى الزمان إلى انقطاعِ",38,"ع",1,0],["ورُزْءٌ أَمِنَّا كلَّ رُزْءٍ لِخَوْفِهِ","وهالَ عَمودَ المُلْكِ فانْهالَ كاتِبُهْ",39,"ب",2,0],["ورزئك ما هذي الدموع وإن جرت","بماءٍ ولا هذي السيولُ سيولها",40,"ل",3,0],["ورزقتُ من فضل المهيمنِ سبعةً","إني إذا نَجُبُوا المرِّبي الفائزُ",41,"ز",1,1],["وَرِزقُ الخَلقِ مَجلوبٌ إِلَيهم","مَقاديرٌ يُقَدِّرُها الجَليلُ",42,"ل",1,0],["ورزء تكل اللسن عن شرح وصفه","وفي القلب منه مقعد ومقيم",43,"م",1,0],["ورزقهم من رائحات تزينها","ضروع عريضات الخواصر كوم",44,"م",1,0],["ورز بالحليب وما يليه","كبالوظة وصحن مهلبي",45,"ي",1,0],["ورزقنا ابسط قوته والعرضا","حتى يعم طولها والعرضا",46,"ض",2,0],["ورزؤك مِمّا يشيب الرؤس","فَلَو كانَ في صخرة اثرا",47,"ر",2,0],["ورزيت علق مضنةٍ لو أنه","للّدهر ما خطر السلوّ بباله",48,"ل",2,0],["ورزؤك فوز إن ظفرت بصبره","وسيان صبر في القضا ونحيب",49,"ب",1,0],["ورز كل ما قد شئته فهو كائن","وحاول فلا برد يفوت ولا بحرُ",50,"ر",1,0],["وَرُزِئتَ عمرَ أَخيكَ فَهوَ لِحالِهِ","كَالغابِرِ المودي وَإِن لَم يَغبُرِ",51,"ر",1,0],["ورزئت في ولدي وكان بجانبي","تذرى محبته بألف صديق",52,"ق",1,0],["ورزين حلمي لا يطيش لمحنةٍ","جلت وإن قطع الزمان وتيني",53,"ن",2,0],["ورزقتُ من جفنيكِ ما حسدَ الورى","رزْقي عليهِ وهو رزقٌ ضَيّقُ",54,"ق",1,0],["ورزؤهم عم البرية شجوه","كما عمها منهم علا ونوال",55,"ل",1,0],["ورزقت في الدارين خير سعادة","وقطفت من أثمارها أهنى الجنا",56,"ن",2,0],["ورزقك يا رزَّاق فابسطه دائماً","علينا بلا كدٍّ من العبد والحرِّ",57,"ر",1,0],["ورِزقَنا كثِّرْ برا الرزّاقِ","وآتنا به من الآفاقِ",58,"ق",1,0],["ورزية حمل الأئمة شطرها","والمسلمون وشطرها الاسلام",59,"م",1,0],["ورزء عرا المجد والمكرمات","فأزهق منهن روحاً فروحا",60,"ح",2,0],["ورزايا كربلا قد أودعت","جمرات في الحشى متقدات",61,"ت",1,0],["ورزية خصت قريش كلها","بالخطب مذ عمت به عدنانها",62,"ن",3,0],["ورُزقته من بعد ذلكِ كلِّه","هيا امنحيه حشاشةً وجَنانا",63,"ن",2,0],["ورزقي يا رزاق وسعه طيباً","وفتحك يا فتاح هب لي أسناه",64,"ا",2,0],["ورزايا مدارس درستنا","وتوالت بفضلها الأرزاء",65,"ا",2,0],["ورزاق مدبر كل أمر","وحي قادر رب العوالي",66,"ل",2,0],["ورزّيت نفسي واتظاهر قويه","يعني كأني ما تأثرت بفراق",67,"ق",1,0],["وَرُزِقْتَ بالإسلامِ دينا قيِّما","فيه الحياةُ بنورِه تتوالى",68,"ل",2,0],["ورزقك على اللي بيده العرش مسموك","رب ٍ رحوم ٍ عن خطاياك ياقاك",69,"ك",1,0],["ورزية جلت وجالت خيلها","في الخافقين مع الهوى الخفاق",70,"ق",1,0],["ورزق الناس ربي حطْ بيد الناس","مثل ما حط سره في رقم سبعه !!",71,"ع",2,0],["ورزقُ يد السئول مفتاحُ بابه","وشرُّ نوالٍ ما جناه سؤالُ",72,"ل",1,0]]}