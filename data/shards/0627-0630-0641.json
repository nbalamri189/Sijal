{"poems":[[88,"رأيت إبليس عدو البشر","https://www.aldiwan.net/poem44468.html","السريع"],[88,"جئت إلى الدير ضحا يوم الأحد","https://www.aldiwan.net/poem44804.html","الرجز"],[51,"قل للأمير أدام الله نعماكا","https://www.aldiwan.net/poem65761.html","البسيط"],[56,"يا قبر فاطمة الذي ما مثله","https://www.aldiwan.net/poem58628.html","الكامل"],[44,"صحبي قفوا مليتكم صحبا","https://www.aldiwan.net/poem30062.html","السريع"],[44,"أرض مصردة وأخرى تثجم منها","https://www.aldiwan.net/poem30363.html","الكامل"],[44,"ليس الوقوف بكفء شوقك فانزل","https://www.aldiwan.net/poem30386.html","الكامل"],[44,"لا أنت أنت ولا الديار ديار","https://www.aldiwan.net/poem30516.html","الكامل"],[31,"هاج ذا القلب منزل","https://www.aldiwan.net/poem41864.html","مجزوء الخفيف"],[31,"ما على الرسم بالبليين لو","https://www.aldiwan.net/poem42636.html","الخفيف"]],"verses":[["إذ في بني رومة عذر لنا","يستسلم السمع له والبصر",0,"ر",1,0],["إذ فيّ عاثُوا عَيث ذئب في نَقَد","تعاوَرتني منهم يدٌ فيد",1,"د",1,0],["إذ فيهما كل بر أنت فاعله","في يومِ فطرِك أو في يوم أضحاكا",2,"ك",2,0],["إِذْ فيكَ حَلّتْ بِضْعَةُ الهَادي الّتي","تُجلى مَحاسِنُ وَجْهِها حُلِّيتا",3,"ت",2,0],["إِذ فيهِ كُلُّ خَريدَةٍ فُنُقٍ","عُذرُ الفَتى إِن هامَ أَو حَبّا",4,"ب",2,0],["إِذ في دِيارِ رَبيعَةَ المَطَرُ الحَيا","وَعَلى نَصيبَينَ الطَريقُ الأَعظَمُ",5,"م",1,0],["إِذ فيهِ مِثلُ المُطفِلِ الظَمأى الحَشا","رَعَتِ الخَريفَ وَما القَتولُ بِمُطفِلِ",6,"ل",1,0],["إِذ في القَتادَةِ وَهيَ أَبخَلُ أَيكَةٍ","ثَمَرٌ وَإِذ عودُ الزَمانِ نُضارُ",7,"ر",1,0],["إِذ فُؤادي بِزَينَبٍ","أُمِّ يَعلى مُوَكَّلُ",8,"ل",1,0],["إِذ فُؤادي يَهوى الرَبابَ وَيَأبى ال","دَهرَ حَتّى المَماتِ يَنسى الرَبابا",9,"ب",2,0]]}