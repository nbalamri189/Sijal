{"poems":[[90,"رأيت إبليس عدو البشر","https://www.aldiwan.net/poem44468.html","السريع"],[90,"جئت إلى الدير ضحا يوم الأحد","https://www.aldiwan.net/poem44804.html","الرجز"],[53,"قل للأمير أدام الله نعماكا","https://www.aldiwan.net/poem65761.html","البسيط"],[58,"يا قبر فاطمة الذي ما مثله","https://www.aldiwan.net/poem58628.html","الكامل"],[46,"صحبي قفوا مليتكم صحبا","https://www.aldiwan.net/poem30062.html","السريع"],[46,"أرض مصردة وأخرى تثجم منها","https://www.aldiwan.net/poem30363.html","الكامل"],[46,"ليس الوقوف بكفء شوقك فانزل","https://www.aldiwan.net/poem30386.html","الكامل"],[46,"لا أنت أنت ولا الديار ديار","https://www.aldiwan.net/poem30516.html","الكامل"],[33,"هاج ذا القلب منزل","https://www.aldiwan.net/poem41864.html","مجزوء الخفيف"],[33,"ما على الرسم بالبليين لو","https://www.aldiwan.net/poem42636.html","الخفيف"],[242,"إن الشمائل أزهار وأنوار","https://www.aldiwan.net/poem18809.html","البسيط"],[310,"بشرى فذا صبح التهاني أسفرا","https://www.aldiwan.net/poem56548.html","الكامل"],[382,"يا قلب طِر من وكنة الأحشاء","https://www.aldiwan.net/poem66956.html","الكامل"],[409,"زارت فكان لها الفؤاد مقيلا","https://www.aldiwan.net/poem33489.html","الكامل"],[409,"أشغلت بالورقا عن الأوراق","https://www.aldiwan.net/poem33625.html","الكامل"],[475,"قد لعمري بت ليلي","https://www.aldiwan.net/poem4761.html","مجزوء الرمل"],[699,"","https://poetry.dctabudhabi.ae/diwan/poem/104490","المجتث"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64200","السريع"],[985,"","https://poetry.dctabudhabi.ae/diwan/poem/111239","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72296","البسيط"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72293","الكامل"],[1113,"","https://poetry.dctabudhabi.ae/diwan/poem/101183","البسيط"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126159","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56311","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49994","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79856","الرجز"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128070","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118380","الرجز"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87317","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87331","الرجز"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105660","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94296","الرجز"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65116","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65178","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110003","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119624","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91020","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90880","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54498","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72894","الرجز"],[5121,"أُنْشُودَةُ السَّهَرِ","https://www.poetsgate.com/ViewPoem.aspx?id=33583",""],[5956,"القهوة وكف المحبوب","https://www.poetsgate.com/ViewPoem.aspx?id=182087",""]],"verses":[["إذ في بني رومة عذر لنا","يستسلم السمع له والبصر",0,"ر",1,0],["إذ فيّ عاثُوا عَيث ذئب في نَقَد","تعاوَرتني منهم يدٌ فيد",1,"د",1,0],["إذ فيهما كل بر أنت فاعله","في يومِ فطرِك أو في يوم أضحاكا",2,"ك",2,0],["إِذْ فيكَ حَلّتْ بِضْعَةُ الهَادي الّتي","تُجلى مَحاسِنُ وَجْهِها حُلِّيتا",3,"ت",2,0],["إِذ فيهِ كُلُّ خَريدَةٍ فُنُقٍ","عُذرُ الفَتى إِن هامَ أَو حَبّا",4,"ب",2,0],["إِذ في دِيارِ رَبيعَةَ المَطَرُ الحَيا","وَعَلى نَصيبَينَ الطَريقُ الأَعظَمُ",5,"م",1,0],["إِذ فيهِ مِثلُ المُطفِلِ الظَمأى الحَشا","رَعَتِ الخَريفَ وَما القَتولُ بِمُطفِلِ",6,"ل",1,0],["إِذ في القَتادَةِ وَهيَ أَبخَلُ أَيكَةٍ","ثَمَرٌ وَإِذ عودُ الزَمانِ نُضارُ",7,"ر",1,0],["إِذ فُؤادي بِزَينَبٍ","أُمِّ يَعلى مُوَكَّلُ",8,"ل",1,0],["إِذ فُؤادي يَهوى الرَبابَ وَيَأبى ال","دَهرَ حَتّى المَماتِ يَنسى الرَبابا",9,"ب",2,0],["إِذْ فَاسُ لَيْسَتْ تُبَالِي إِذْ يُجَاوِرُهَا","أَلَّا يُجَاوِرَهَا إِلَّاهُ دَيَّارُ",10,"ر",1,0],["إِذ في بقائِكَ لي أعزُّ غنيمةٍ","علقت يَدي مِنها بِمَوثوقِ العُرى",11,"ر",2,0],["إذ فاز بالأفراح طرّاً قلبه","بل حاز أسنى عفّةٍ بِطِلاء",12,"ا",2,0],["إذ فيه تجويز العذاب بعلمه","أيوافق التجويز ذا المعقولا",13,"ل",2,0],["إذ فارقت إلفاً وروضاً يانعاً","ونأت عن الأغصان والأوراق",14,"ق",1,0],["إِذ فَقَدنا سَيِّداً كا","نَ لَنا غَيرَ مُضيعِ",15,"ع",1,0],["إذ فيك تصدح ورق","وفيه تنعب بوم",16,"م",1,0],["إِذ فارةُ المسكِ سمعنا بها","وهذه فأرةُ كافور",17,"ر",1,0],["إذ في شمس العلم سارت","والسما الشمس المضيه",18,"ي",2,0],["إذ فاتني من زمان الورد رونقه","ظللت من خده للورد مقتطفا",19,"ف",2,0],["إذ فيهم شهر الزمان صوارماً","ونحاهم في هبذر المتدرع",20,"ع",1,0],["إذ فيك صرف زماني غافل سنة","عني وعن مجلسي طرف الرقيب غفا",21,"ف",2,0],["إذ فيه تفويض الأمور لمن له","في كل شيء شاء أن يتصرفا",22,"ف",2,0],["إذ فتيتي الأطفال كم","جاءت تنادي منحبهْ",23,"ب",2,0],["إذ في صحيح مسلم نقاع لا","ومن يقل بعقله فقد علا",24,"ل",2,0],["إذ فيّ أبهجة الشباب وغرَّة","تجْزي الحَبيب إذا تدلّل أو جَفا",25,"ف",2,0],["إذ في ختان قرَّتي عين العُلى","سرَّ الأنامَ أسوداً وأبيضا",26,"ض",2,0],["اذ فقده فقد العلوم بأسرها","أو لم تكن من قبل في اغلاق",27,"ق",1,0],["اذ فيه يخشى الزلقا","سواك كل مرتق",28,"ق",1,0],["إذ فِيهِمَا ضِدُّ الذِيي قُلتُمُ وَمَا","ضِدَّانِ فِي المعقُولِ يَجتَمِعَان",29,"ن",1,0],["إذ في زماني كَثُرَ الجُهَلاَء","لم يُعرَفِ الفَدمُ مِنَ العُلمَاء",30,"ا",2,0],["إذ فيهمُ إصبَع بإصبَعَينِ","في غيرِهِم لَم أرَهُ بعيني",31,"ي",1,0],["إذ فيه كنا لاعبين أنا وأنت","كمثل أفراخ الحمام",32,"م",1,0],["إذ فارق الدنيا وخلى أهلها","وحل بالفردوس أسمى منزل",33,"ل",1,0],["إذ فتحُ جمّال غدا لك مُنبئا","عن فتح وسلات على أدنى المدى",34,"د",2,0],["إذ في سواهُ غريبٌ في مواطنه","وما سوى صدره للفقه أوطانُ",35,"ن",1,0],["إذ في بَواديكِ ابتدى مستأنَفاً","رَبٌّ قديمٌ ليسَ بالمُستأنَفِ",36,"ف",1,0],["إذ فِيهِ تَقدِيمٌ وَتأخِيرٌ مَعَا","وَهوَ تَنَافٍ ظَاهِرٌ لِمَن وَعَا",37,"ع",2,0],["إِذ فِيهِ جَمعُ المُتَنَافِيَينِ","فِى وَاحِدٍ مِن مُتَسَاوِيَينِ",37,"ن",1,0],["إذ فَسَّرُوا الرُّؤيَةَ بِالشُّعَاعِ","وَذَاكَ فِى ذَا البَابِ ذُو امتِنَاعِ",37,"ع",1,0],["إذ فَسَّرُوا الوَجه بِذَاتٍ وَاليَدَا","بِقُدرَةٍ وَذَا الإِمَامُ أيَّدَا",37,"د",2,0],["إذ فيه سارة بنت عب","د اللَه جوهرة فريدة",38,"د",2,0],["إذ في سلالة بدر خان باشا غدت","منها تنير عدالة وأمان",39,"ن",1,0],["إذ في سنا ليلة المحيا الشريف سما","تاريخ قدر زفاف الشمس للقمر",40,"ر",1,0],["إذْ في السَّوابغِ تُحْطَمُ السُّمرُ القنا","والبيضُ تُخْضَبُ بالنّجيعِ القاني",41,"ن",2,0],["إذ فازَوهو ماله من شبه","بنسخةِ الأشباهِ والنظائرِ",42,"ر",1,0],["إِذْ فَاضَ سَيْلٌ بِأَلْحَانٍ تُأَرْجِحُنِي","مَا بَيْنَ شَوْقِي وَبَيْنَ التَّيْهِ فِي الْقَفَرِ",43,"ر",1,0],["إذْ فجأة صاحبي المحبوب قد كُسِيتْ","كفّ له بضمادٍ دونه الحَجَرُ",44,"ر",1,0]]}