{"poems":[[88,"كل شيء من عالم الذرات","https://www.aldiwan.net/poem44975.html","الخفيف"],[85,"صرح على الوادي المبارك ضاحي","https://www.aldiwan.net/poem62982.html","الكامل"],[97,"أمل ضائع ولب مشرد","https://www.aldiwan.net/poem24804.html","الخفيف"],[105,"يوم الشهيد رجعت أيمن مرجع","https://www.aldiwan.net/poem42070.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54716","الخفيف"],[99,"إلى تلميذة","https://www.poetsgate.com/ViewPoem.aspx?id=12903",""],[113,"جانب زمانك ان اردت وواله","https://www.aldiwan.net/poem40616.html","عموديه"],[176,"برق تجلى من ثنيات الديم","https://www.aldiwan.net/poem50710.html","الكامل"],[209,"أيها الحب وبالذكرى أراك","https://www.aldiwan.net/poem46313.html","الرمل"],[221,"ملقيه بحسنك المأجور","https://www.aldiwan.net/poem41602.html","الخفيف"],[269,"ضربت سعاد خيامها بفؤادي","https://www.aldiwan.net/poem52108.html","الكامل"],[273,"مرقوم الخد مورده","https://www.aldiwan.net/poem25586.html","المتدارك"],[347,"إن الذي عاينته","https://www.aldiwan.net/poem15540.html","المجتث"],[462,"ما على الركب من تلافي تلافي","https://www.aldiwan.net/poem3215.html","عموديه"],[498,"زاحمتنا بوهمها أسماء","https://www.aldiwan.net/poem37652.html","الخفيف"],[536,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"],[556,"إنما وحدة الوجود فنون","https://www.aldiwan.net/poem33762.html","الخفيف"],[556,"كل ما يخلقه العقل أمل","https://www.aldiwan.net/poem34236.html","الرمل"],[556,"حرف عين العمى إلى النور داعي","https://www.aldiwan.net/poem34379.html","الخفيف"],[556,"نحن عن شمس أمره كالشعاع","https://www.aldiwan.net/poem34395.html","الخفيف"],[556,"باطن الباطن ظاهر","https://www.aldiwan.net/poem34520.html","مجزوء الرمل"],[556,"إن للثاء في الحروف ثبات","https://www.aldiwan.net/poem34713.html","الخفيف"],[556,"إنما بيت عزتي وهو قلبي","https://www.aldiwan.net/poem34927.html","الخفيف"]],"verses":[["هو هَيْن على الذي قال هاكم","حين يعطيه للذي قال هات",0,"ت",1,0],["هُوَ هَيكَلُ الحُرِيَّةِ القاني لَهُ","ما لِلهَياكِلِ مِن فِدىً وَأَضاحِ",1,"ح",1,0],["هو همس الشقاء ما هو شك","لا ولا ثورةٌ فعدلك أخلد",2,"د",1,0],["هُو ها هنا في صَحْبِه وَرِفاقهِ","بأجلِّ مَنزلةٍ وأَشْرفِ مَوضعِ",3,"ع",1,0],["هُوَ ها هنا في نِعمةٍ أبديّةٍ","للهِ ما في مثلِها مِن مَطمعِ",3,"ع",1,0],["هو ها هنا يا مصر يُعطَى حَقَّهُ","والحقُّ عِند اللهِ غيرُ مُضيَّعِ",3,"ع",1,0],["هُوَ ها هُنَا يحمي لواءكِ فَانْظُرِي","هُوَ هُا هُنا يَشدو بِذكركِ فَاسْمَعي",3,"ع",2,0],["هُوَ هَادِي الهُدَاةِ وَالقَائِدُ الأَعْ","لَى لأَبْنَاءِ مِصْرَ شَعْباً وَجُنْدَا",4,"د",2,0],["هو هذه الأزمات تسحقنا معاً","فنموت نحن .. وتزهر الآمال",5,"ل",1,0],["هو هذه الكف التي تغتالنا","ونقبل الكف التي تغتال",5,"ل",1,0],["هو هكذا فيما مضى وبحاله","فيما ترى وبمبهم استقباله",6,"ل",2,0],["هُوَ هكذا جَمْرُ الصَّبابَةِ جاحِمٌ","ما مِنْ فؤادٍ مَسَّهُ إلا احْتدَمْ",7,"م",1,0],["هو هذا فليصن دهري شداه","من مغير عارم الفتك صؤول",8,"ل",1,0],["هوَّة أَطلَعَت جَهَنَّمُ مِنها","شَهواتٍ تَفَجَّرَت في الصُدور",9,"ر",1,0],["هُو هازم الاقران في فتكاته","وَمدمر العشرات بالآحاد",10,"د",1,0],["هُو هادي الخلقِ ومُرْشِدُهم","مِمّا يَهْديهِ ويُرْشِدُهُ",11,"د",2,0],["هوهي وَجوداً وَما هي","هو في حُدودٍ وَنَعتِ",12,"ت",1,0],["هو هدامها ومطامعها المحمود","يومي صفاحها والصحاف",13,"ف",1,0],["هو هذا العطاءُ والله ممضٍ","رغم حسادِ وهبهِ ما يشاءُ",14,"ا",2,0],["هُوَ هُوَ الباشا التهاميِّ الذي","قد حازَ في العليَاءِ قصبَ السَّبَقِ",15,"ق",1,0],["هو هذا نعم وما هو هذا","والتجلي له به تلوين",16,"ن",1,0],["هو هذا فاقلب العين وما","هو هذا وعلى هذا اشتمل",17,"ل",1,0],["هو هذا به وما هو هذا","قاطع للرجا وللأطماع",18,"ع",1,0],["هو هذا الذي ترون ولكن","نملنا فيه عندكم كالسباع",19,"ع",1,0],["هو هذا لا سواه","عند طرف فيه ساهر",20,"ر",1,0],["هو هذا هذا وهذا وهذا","تتسامى آياتُهُ البيناتُ",21,"ت",1,0],["هو هذا نعم وما هو هذا","واسألوا عنه كل صاحب قلب",22,"ب",1,0]]}