{"poems":[[90,"كل شيء من عالم الذرات","https://www.aldiwan.net/poem44975.html","الخفيف"],[87,"صرح على الوادي المبارك ضاحي","https://www.aldiwan.net/poem62982.html","الكامل"],[99,"أمل ضائع ولب مشرد","https://www.aldiwan.net/poem24804.html","الخفيف"],[107,"يوم الشهيد رجعت أيمن مرجع","https://www.aldiwan.net/poem42070.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54716","الخفيف"],[101,"إلى تلميذة","https://www.poetsgate.com/ViewPoem.aspx?id=12903",""],[119,"جانب زمانك ان اردت وواله","https://www.aldiwan.net/poem40616.html","عموديه"],[182,"برق تجلى من ثنيات الديم","https://www.aldiwan.net/poem50710.html","الكامل"],[215,"أيها الحب وبالذكرى أراك","https://www.aldiwan.net/poem46313.html","الرمل"],[228,"ملقيه بحسنك المأجور","https://www.aldiwan.net/poem41602.html","الخفيف"],[276,"ضربت سعاد خيامها بفؤادي","https://www.aldiwan.net/poem52108.html","الكامل"],[280,"مرقوم الخد مورده","https://www.aldiwan.net/poem25586.html","المتدارك"],[354,"إن الذي عاينته","https://www.aldiwan.net/poem15540.html","المجتث"],[469,"ما على الركب من تلافي تلافي","https://www.aldiwan.net/poem3215.html","عموديه"],[505,"زاحمتنا بوهمها أسماء","https://www.aldiwan.net/poem37652.html","الخفيف"],[543,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"],[563,"إنما وحدة الوجود فنون","https://www.aldiwan.net/poem33762.html","الخفيف"],[563,"كل ما يخلقه العقل أمل","https://www.aldiwan.net/poem34236.html","الرمل"],[563,"حرف عين العمى إلى النور داعي","https://www.aldiwan.net/poem34379.html","الخفيف"],[563,"نحن عن شمس أمره كالشعاع","https://www.aldiwan.net/poem34395.html","الخفيف"],[563,"باطن الباطن ظاهر","https://www.aldiwan.net/poem34520.html","مجزوء الرمل"],[563,"إن للثاء في الحروف ثبات","https://www.aldiwan.net/poem34713.html","الخفيف"],[563,"إنما بيت عزتي وهو قلبي","https://www.aldiwan.net/poem34927.html","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87217","الخفيف"],[1378,"","https://poetry.dctabudhabi.ae/diwan/poem/216850",""],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69403","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27955","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27666","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27402","الخفيف"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102530","الكامل"],[5072,"نجاة الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=52564",""],[3591,"يا أمير البلاد أهدي سلاماً","https://www.poetsgate.com/ViewPoem.aspx?id=149442",""],[5121,"عُمْقِ الْهَوَى","https://www.poetsgate.com/ViewPoem.aspx?id=215230",""],[5225,"بو خليفه لي يشجعنا","https://www.poetsgate.com/ViewPoem.aspx?id=27618",""],[1696,"اللَه اللَه اللَه","https://www.poetsgate.com/ViewPoem.aspx?id=173328",""],[5268,"رصيفُ الجامِعَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=206995",""],[5277,"عيونُ المها","https://www.poetsgate.com/ViewPoem.aspx?id=194946",""],[5277,"نوافلُ الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=200533",""],[5277,"بيتُ الضاد..","https://www.poetsgate.com/ViewPoem.aspx?id=201154",""],[5277,"ظلالُ اليقين","https://www.poetsgate.com/ViewPoem.aspx?id=204874",""],[5277,"آهةٌ خرساءُ","https://www.poetsgate.com/ViewPoem.aspx?id=205799",""],[5277,"وجهُ أبي","https://www.poetsgate.com/ViewPoem.aspx?id=206845",""],[5277,"زينبُ القلب","https://www.poetsgate.com/ViewPoem.aspx?id=210873",""],[5277,"جئنى ندىً","https://www.poetsgate.com/ViewPoem.aspx?id=214908",""],[5277,"لا تستعرْ ناراً وماؤكَ ناضبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=215559",""],[5376,"لستُ عنه من أنسِه ببعيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=191853",""],[5574,"أغلقْ فماً","https://www.poetsgate.com/ViewPoem.aspx?id=206046",""],[5732,"ذابت الروح","https://www.poetsgate.com/ViewPoem.aspx?id=177904",""],[5769,"أُغنية للحب","https://www.poetsgate.com/ViewPoem.aspx?id=215969",""],[5865,"هذا المساء","https://www.poetsgate.com/ViewPoem.aspx?id=179857",""],[5956,"أوقات الإلهام","https://www.poetsgate.com/ViewPoem.aspx?id=186120",""],[5956,"أولادي والحمد لله وعقبال أولاد الجميع وأكثر","https://www.poetsgate.com/ViewPoem.aspx?id=192025",""],[5956,"بداية الصلوات لجلال الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=194045",""],[6019,"عِناقُ الورد","https://www.poetsgate.com/ViewPoem.aspx?id=162129",""],[5080,"عن حجّ شريان الحروف لقدسه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88136&r=&rc=6",""]],"verses":[["هو هَيْن على الذي قال هاكم","حين يعطيه للذي قال هات",0,"ت",1,0],["هُوَ هَيكَلُ الحُرِيَّةِ القاني لَهُ","ما لِلهَياكِلِ مِن فِدىً وَأَضاحِ",1,"ح",1,0],["هو همس الشقاء ما هو شك","لا ولا ثورةٌ فعدلك أخلد",2,"د",1,0],["هُو ها هنا في صَحْبِه وَرِفاقهِ","بأجلِّ مَنزلةٍ وأَشْرفِ مَوضعِ",3,"ع",1,0],["هُوَ ها هنا في نِعمةٍ أبديّةٍ","للهِ ما في مثلِها مِن مَطمعِ",3,"ع",1,0],["هو ها هنا يا مصر يُعطَى حَقَّهُ","والحقُّ عِند اللهِ غيرُ مُضيَّعِ",3,"ع",1,0],["هُوَ ها هُنَا يحمي لواءكِ فَانْظُرِي","هُوَ هُا هُنا يَشدو بِذكركِ فَاسْمَعي",3,"ع",2,0],["هُوَ هَادِي الهُدَاةِ وَالقَائِدُ الأَعْ","لَى لأَبْنَاءِ مِصْرَ شَعْباً وَجُنْدَا",4,"د",2,0],["هو هذه الأزمات تسحقنا معاً","فنموت نحن .. وتزهر الآمال",5,"ل",1,0],["هو هذه الكف التي تغتالنا","ونقبل الكف التي تغتال",5,"ل",1,0],["هو هكذا فيما مضى وبحاله","فيما ترى وبمبهم استقباله",6,"ل",2,0],["هُوَ هكذا جَمْرُ الصَّبابَةِ جاحِمٌ","ما مِنْ فؤادٍ مَسَّهُ إلا احْتدَمْ",7,"م",1,0],["هو هذا فليصن دهري شداه","من مغير عارم الفتك صؤول",8,"ل",1,0],["هوَّة أَطلَعَت جَهَنَّمُ مِنها","شَهواتٍ تَفَجَّرَت في الصُدور",9,"ر",1,0],["هُو هازم الاقران في فتكاته","وَمدمر العشرات بالآحاد",10,"د",1,0],["هُو هادي الخلقِ ومُرْشِدُهم","مِمّا يَهْديهِ ويُرْشِدُهُ",11,"د",2,0],["هوهي وَجوداً وَما هي","هو في حُدودٍ وَنَعتِ",12,"ت",1,0],["هو هدامها ومطامعها المحمود","يومي صفاحها والصحاف",13,"ف",1,0],["هو هذا العطاءُ والله ممضٍ","رغم حسادِ وهبهِ ما يشاءُ",14,"ا",2,0],["هُوَ هُوَ الباشا التهاميِّ الذي","قد حازَ في العليَاءِ قصبَ السَّبَقِ",15,"ق",1,0],["هو هذا نعم وما هو هذا","والتجلي له به تلوين",16,"ن",1,0],["هو هذا فاقلب العين وما","هو هذا وعلى هذا اشتمل",17,"ل",1,0],["هو هذا به وما هو هذا","قاطع للرجا وللأطماع",18,"ع",1,0],["هو هذا الذي ترون ولكن","نملنا فيه عندكم كالسباع",19,"ع",1,0],["هو هذا لا سواه","عند طرف فيه ساهر",20,"ر",1,0],["هو هذا هذا وهذا وهذا","تتسامى آياتُهُ البيناتُ",21,"ت",1,0],["هو هذا نعم وما هو هذا","واسألوا عنه كل صاحب قلب",22,"ب",1,0],["هوَ هَذا محمد خورشيد","شَمس هَذا الزَمان في قُرَناه",23,"ا",2,0],["هُوَ هَذا الحَليم خَير وَليدٍ","أَيد الحَق بَعدَهُ وَرَعاه",23,"ا",2,0],["هوه دون الهم تَفريجي","زِد خلق الله موِدِّنَّه",24,"ن",2,0],["هو هادي الأملاك في العالم الأع","لى ولولاهُ ما استقام هداها",25,"ا",3,0],["هُوَ هالَةٌ كَالبَدرِ بَدرِ عَشِيرَةٍ","أَمِنُوا غَياهِبَ ظُلمِهِ وَظَلامِهِ",26,"م",2,0],["هو همي في سروري","وفي أفراحي وغمي",27,"م",2,0],["هو هود والذي أخبركم","أحمد المبعوث في خير الأمم",28,"م",1,0],["هو هذا تمتعوا","فهو خيرُ المنازل",29,"ل",1,0],["هو هو تعالى عن شريك ثانيا","فأثق به نعم الوليّ الواليا",30,"ي",2,0],["هو هكذا قد جاء َ مثل مَعادِه ِ","داني الضمير ِ مُقارب ٌ لا يُوصَل",31,"ل",1,0],["هو هذا الكتاب أبرز ذا العص","ر بهذا الوجه الجميل السّابي",32,"ب",2,0],["هُو هَكَذَا العُشَّاقُ فِي عُمْقِ الْهَوَى","إِمَّا غَرِيقٌ أَوْ يَعِيشُ خَيَالَا",33,"ل",2,0],["هوه لى يحمّس تنافسنا","والتنافس بين لاثنينا",34,"ن",2,0],["هو هازم الأقران في وثباته","كالليث في آجامه ايقان",35,"ن",1,0],["هو هكذا القلبُ المُحِبُّ حبيبتي","يدنو من الدنيا ليَحمِلَها مَعَهْ",36,"ع",2,0],["هو هكذا طبعُ الحرائرِ في الورى","خفرٌ...ولكنْ في الحلالِ جليلُ",37,"ل",1,0],["هو هكذا لكنني قلبٌ","أوفيهِ كيلاً والهوى مَطْلُ",38,"ل",1,0],["هوَ هكذا سهمٌ أصابَ حشاشتي","فتمكّنتْ طعناتُهُ بفؤادي",39,"د",2,0],["هو هكذا صدقُ المحبةِ دائماً","كالظلّ..يرسمُ حدَّهُ الحدثانِ",40,"ن",1,0],["هو هكذا قدرُ المحبةِ بيننا","ما صدقُها فيمنْ هوى..بمحرّمِ",41,"م",1,0],["هوَ هكذا وجهْ يُطَرِّزُ بسمتي","فكأنّهُ مسكٌ يضاحِكُ عنبرا",42,"ر",2,0],["هو هكذا قلبي يحبكِ جمرةً","تكوي الشغافَ وتستبيحُ المحتوى",43,"ا",1,0],["هو هكذا قلبي..مروجُ سماحةٍ","مهما تقولُ فلست غِرّاً ناحبا",44,"ب",2,0],["هو هكذا قلبي..مروجُ سماحةٍ","مهما تقوّلَ في الخصومةِ قائلُ",45,"ل",1,0],["هو همسٌ للعاشقين وبكاءٌ","كأنينٍ بالطائر الغريد",46,"د",1,0],["هو هكذا نبضٌ وأُكسيرٌ، إذن:","هل يُستطاعُ العيشُ دونَ هواء؟",47,"ا",2,0],["هو هوا النفس من كل الورا","الله اللي من الفتنه عطاه",48,"ا",2,0],["هوَ هاهُنا أو ها هُنالِكَ واحدٌ","أو حيثما يَمَّمْتَ قَلبكَ كَبَّرا",49,"ر",2,0],["هو هكذا متسربلٌ بوسامةٍ","يَسبي جنوبَ القلبِ بعدَ شمالهِ",50,"ل",2,0],["هو هكذا قد جاء بي ليحيطني","عطفاً وأصنع للبلاد معاليا",51,"ي",2,0],["هو هكذا الفنّانُ لا يدري متى","هو في انفعالٍ، فليجرّبْ لاهيا",51,"ي",2,0],["هو هكذا أنا والرفاهة أمُّهُم","وكذلك الأحفاد كالأولادِ..",52,"د",1,0],["هو هكذا بِرُّ البنينَ بأهلهم","يجتاز كلَّ تصورٍ كي ينفعا",53,"ع",2,0],["هو هكذا اختصرَ المدى مُتولعاً","وأتى ببعضِ الحُلمِ فيَّ مُثيرا",54,"ر",2,0],["هو هكذا لا تحتويهِ مساحةٌ","دمجَ الزمانَ مع المكانِ بكأسهِ",55,"س",2,0]]}