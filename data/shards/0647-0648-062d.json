abi.ae/diwan/poem/141567","الكامل"],[4677,"لك با حنونة","https://www.poetsgate.com/ViewPoem.aspx?id=203949",""],[4683,"قلبي لودادك حين هوى","https://www.poetsgate.com/ViewPoem.aspx?id=166760",""],[5219,"رفقا معذبتي","https://www.poetsgate.com/ViewPoem.aspx?id=194913",""],[5266,"الفارس","https://www.poetsgate.com/ViewPoem.aspx?id=210744",""],[5281,"لا محلّه","https://www.poetsgate.com/ViewPoem.aspx?id=199497",""],[5285,"خالد","https://www.poetsgate.com/ViewPoem.aspx?id=204393",""],[5295,"شذا القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=210634",""],[5397,"بكى الدين والدنيا عليك فأفجعا","https://www.poetsgate.com/ViewPoem.aspx?id=157901",""],[5411,"ضفاف الحب","https://www.poetsgate.com/ViewPoem.aspx?id=187954",""],[5411,"سَبَّحَ الشِّعْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=190638",""],[5457,"ما معنى الوطن؟","https://www.poetsgate.com/ViewPoem.aspx?id=213236",""],[5542,"شعري وحبي فيكَ يلتقيانِ","https://www.poetsgate.com/ViewPoem.aspx?id=24756",""],[5650,"امْلأْ فُؤادَكَ بِالْحَبيب","https://www.poetsgate.com/ViewPoem.aspx?id=131222",""],[5725,"ولجارتي عتب عليّ","https://www.poetsgate.com/ViewPoem.aspx?id=192275",""],[5732,"الصدر ضاق وحاير الدمع دفاق","https://www.poetsgate.com/ViewPoem.aspx?id=177846",""],[5956,"من صفات الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=185778",""],[5956,"لهفي عليه ككل حر سابح","https://www.poetsgate.com/ViewPoem.aspx?id=192994",""],[5956,"ما درَّ شعري هكذا لسواكما","https://www.poetsgate.com/ViewPoem.aspx?id=193703",""],[5956,"الذكرى الخالدة لوحدة الجمهورية العربية المتحدة","https://www.poetsgate.com/ViewPoem.aspx?id=193991",""],[5956,"أرجوك ربي صِلْ فؤاده بي","https://www.poetsgate.com/ViewPoem.aspx?id=204462",""],[5956,"يسري النسيمُ العذب في الصحراءِ","https://www.poetsgate.com/ViewPoem.aspx?id=205124",""],[5956,"أوعى لواء","https://www.poetsgate.com/ViewPoem.aspx?id=214092",""],[6100,"اقفيت لكن دمعك سال","https://www.poetsgate.com/ViewPoem.aspx?id=52553",""],[6247,"بين عتابها وعتابهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80265&r=&rc=4",""]],"verses":[["هُوَ حَربٌ بَينَ فَقرٍ وَغِنىً","وَصِراعٌ بَينَ بُرءٍ وَسَقَم",0,"م",1,0],["هُوَ حُوَّلٌ هُوَ قُلَّبٌ هُوَ واضِحٌ","هُوَ غامِضٌ هُوَ قاطِعٌ هُوَ نابي",1,"ب",2,0],["هُوَ حَيٌّ ما دُمْتَ حَيّاً وَمَا دامَ","يَلِيهِ الأَبَرُّ فِي الأنْجَالِ",2,"ل",1,0],["هو حيّ أبد الدهر فما","ضرهّ من هذه الدنيا انتقال",3,"ل",1,0],["هو حبٌّ جاء الهوى فيه والرأ","ي سواءً وليس بالإلهاجِ",4,"ج",1,0],["هُوَ حينَ يَجري مَع هَواهُ خائِنٌ","وَإِذا سَمَت أَخلاقُهُ سِمسارُ",5,"ر",1,0],["هُوَ حَظّي قَد عَرَفتُهُ","لَم يَحُل عَمّا عَهِدتُهُ",6,"ت",2,1],["هُوَ حِليَةُ المَلِكِ الرَشي","دِ وَعِصمَةُ المَلِكِ الغَرير",7,"ر",1,0],["هو حُبِّي هامَ في الليل شريدا","مثلما هِمْتُ لنلقاكَ جميعا",8,"ع",2,0],["هُوَ حَاجَةُ الأَوْطَانِ مَا دَالَتْ بِهَا","دُوَلٌ مِنَ السَّرَّاءِ وَالضَّرَّاءِ",9,"ا",2,0],["هُوَ حَالٌ ثُمَّ حَالٌ","هُوَ حَرٌّ ثُم قَرُّ",10,"ر",1,0],["هُوَ حِيناً حَوْلَ الرُّبَا مِنْ نُضَارٍ","وَهْوَ حِيناً مِنْ فضَّةٍ بَيْضَاءِ",11,"ا",2,0],["هو حيٌّ يُطلُّ من كلِّ بيتٍ","دبَّجته عصارةُ الوجدان",12,"ن",1,0],["هو حصن إسعاف وبحر عنايةٍ","يوم المخاف وذلة العظماء",13,"ا",2,0],["هو حمى الجليس يدفع في الصد","ر ثقيل الكلام والإيماء",14,"ا",2,0],["هو حاتم في وجوده هو أحنف","في حلمه هو حيدر في جده",15,"د",2,0],["هو حظكم والحظ إن فات امرؤ","وجفاه أوسعه الزمانُ عِنادا",16,"د",2,0],["هو حظّي أموتُ وجداً وشوقاً","وَحبيبي بِمُبغضي مَشغول",17,"ل",1,0],["هُوَ حَيٌّ في قَبرِهِ بِحَياةٍ","كُلُّ حَيٍّ مِنها لَهُ اِستِملاءُ",18,"ا",2,0],["هوَ حَيٌّ في قبرهِ ولهذا","حُرِمَت مِن تراثهِ الزهراءُ",18,"ا",2,0],["هو حلمٌ وإن شهدناهُ فالغف","لةُ نومٌ لأعينِ الجُّهَّالِ",19,"ل",1,0],["هو حال أراده الله للنا","س لأمر به المهيمن أعلم",20,"م",1,0],["هو حظي وأنا في حمله","مرغم طوعاً لأحكام القضاء",21,"ا",2,0],["هُوَ حاكِمٌ يَشقى اليَتيمُ بِعَهدِهِ","جَوراً وَمِن خُبزِ اليَتامى يُطعَمُ",22,"م",1,0],["هو حاكم الحسن المطاع وعنده","للمحبة ثابت لا ينسخ",23,"خ",1,0],["هُو حِصنٌ لِلمُسلِمينَ حَصينٌ","وَهوَ غابٌ وَأَنتَ لَيثُ الغابِ",24,"ب",1,0],["هو حجّةٌ للّه بينَ عبادهِ","ردّت إِليه غَير ما مَحجوجه",25,"ج",2,0],["هو حي ميت ولقد","فارقته سورة الارن",26,"ن",1,0],["هُو حَتفُ النَّفسِ لا شك","كَ فلِم سمَّوهُ عِشقا",27,"ق",2,0],["هو حُكمُ عدلٍ لا يُردُّ وكان ما","يَهِنُ القلوبَ لو انه من جائرِ",28,"ر",1,0],["هو حاضرٌ إن كان نادى باسمِهِ","أولا فإنَّ عظيمَ أجرِهِ يَغنَمُ",29,"م",1,0],["هو حق وسواه باطل","جاء في القرآن هذا علنا",30,"ن",2,0],["هو حظهم في النشأتين من الذي","عشقوه بالقلب الطهور الصائم",31,"م",1,0],["هو حق بعد الفنا عن سواه","يتجلى فتضمحل العقول",32,"ل",1,0],["هو حق وباطل ما سواه","من جميع الأكوان غرب وشرق",33,"ق",1,0],["هو حق وسواه باطل","مثل ما قال لنا في الصحف",34,"ف",1,0],["هو حق وسواه","باطل جاء لفيفا",35,"ف",2,0],["هو حاضر لكن بغير إشارة","فإذا جهلت تقول عنه هذا",36,"ذ",2,0],["هو حق وأنت والكون طراً","باطل زاهق بحكم نفوده",37,"د",2,0],["هو حق ما قد ظننتم ولكن","إن يكن ذاك لا بكم يا جنودي",38,"د",2,0],["هو حلية المتأدبين وزينهم","بين الشباب الجيد الأغراس",39,"س",1,0],["هوَ حيٌّ بالذكر والذكرُ يبقى","في فؤاد التاريخ مسكاً وطيبا",40,"ب",2,0],["هو حجة اللَه العظيم فمن عشا","عنه تخبط للضلال بغيهب",41,"ب",1,0],["هو حول هو قلب هو مظهر","للملة الغرا وسر المذهب",41,"ب",1,0],["هو حجة النسب الزكي على الأولى","أشقاهمُ التحريضُ والتنفير",42,"ر",1,0],["هو حط لى فى الرجل حلقة ودوّار","قيد العيم ياللي رسومه ثقالي",43,"ل",2,0],["هوَ حجَّةٌ لِلدينِ غيرُ مُعارِض","وَكَأَنَّهُ لِلدّينِ سَيفٌ أَصمَعُ",44,"ع",1,0],["هو حزن أسداه عشاور لما","طَرَدَ السُبطَ فيه نغلُ الطريد",45,"د",1,0],["هو حسبي وناصري ووكيلي","حسبي الله ناصرا ووكيلا",46,"ل",2,0],["هو حال عجزي والمعجز حاضر","وهو التكهل والنحول البادي",47,"د",2,0],["هو حبنا ونبينا ورسولنا","وشفيعنا وبه لنا الوعد الوفي",48,"ف",2,0],["هو حارس الإسلام راصدٌ ثغره","فيه يرد من الضلال الجحفل",49,"ل",1,0],["هو حادث لكنه","ينيبيك عن سر القدم",50,"م",1,0],["هو حاجب البابِ الذي خضعتْ له","غلبُ الرقابِ وآمرُ الأمراء",51,"ا",2,0],["هو حبل الله لم يختلف ال","ناس لو كانوا به معتصمينا",52,"ن",2,0],["هو حقاً مطر وابن مطر","وبله ينبت في الصخر الكلا",53,"ل",2,0],["هو حيدرً الكرَّار صنو المصطفى","أعلى الورى قدراً وأعظمُ منزِلا",54,"ل",2,1],["هو حارس الإسلام سر محمد","ما حطم الأعداء إلا وطدا",55,"د",2,0],["هو حاديا فانظر إلى أين حا","ديه لِلّه أو للحفظ والتماويه",56,"ه",1,0],["هو حمدى وفيه ألسن حمدى","مطلقات العقال تنثر درا",57,"ر",2,0],["هو حبر أشمون على الشان من","درر المدائح فيه منتظمات",58,"ت",1,0],["هو حمزة وبفيه خمرة ورده","وبخده الوردي حمرة ورده",59,"ه",1,1],["هو حصن لنا ولا غرو يوماً","أن إلى كهفه أوى ذو الرقيم",60,"م",1,0],["هو حجة الإسلام من نشرت","فوق المنابر باسمه الخطب",61,"ب",1,0],["هو حشد أثار ضرب خوافي","هِ غبار السحاب يعمي بذرّه",62,"ر",2,0],["هو حلم مجنّح رافق الشا","عِر يطوي الأجيال جيلاً فجيلا",63,"ل",2,0],["هو حقا لا منطقي ولكنْ","هكذا الشعر والهوى والجنون",64,"ن",1,0],["هوَ حَدُّ بَيْنَ السرور وبَينِي","كَدَّرَ العيْشَ عَكْسُه واطرادُهْ",65,"د",2,0],["هو حق وغيره شبهات","وهو نور وغيره ظلمات",66,"ت",1,0],["هوَ حَيٌّ ولئن زارَ الضّريح","دُقّ يا قلبي إِلى يومِ النّشور",67,"ر",1,0],["هو حظي من الزمان ولكن","عز وصلي له وقربي لديه",68,"ه",1,1],["هُو حَلَّ قَصدي في العِبادِ وَاِنَّما","باقِيَه في طَي الفُؤاد ضرام",69,"م",1,0],["هُوَ حُكمُهُ هُوَ عِلمُهُ هو نوره","وَصِراطُهُ الهادي إِلى الرِضوانِ",70,"ن",1,0],["هو حب فإذا فرقته","فهو ما راع قديمًا ويروع",71,"ع",1,0],["هو حب واحد لكنه","شائع كالنور من حيث يشيع",71,"ع",1,0],["هو حي، إن لم يكن قد تَسمَّى","باسمه في قرابه فكأن قد",72,"د",1,0],["هو حقٌّ عنده جَلَلٌ","حاضر الميعاد والأثرِ",73,"ر",1,0],["هُوَ حَليُ جِيدِ الدَّهرِ لَولاَهُ لَهُ","لَدَفَعتُ عَنِّي الدَّهرَ بِالرَّاحَاتِ",74,"ت",1,0],["هُوَ حُبُّ الذينَ قَد ذَكَروهُ","وَشَجاهُم بَعدَ الفُراقِ الحَنينُ",75,"ن",1,0],["هُو حبرنا الدبسيُّ يوسف عصرهِ","حلو الشَمائل لجُّ بحر مَكارِما",76,"م",2,0],["هو حاتميُّ الجودِ ليس يرى","إسْداءَ نائلهِ سوى حَتْمِ",77,"م",1,0],["هو حسبي فيما مَضى من أُمور","وَهو حَسبي لكلّ أَمرٍ آتِ",78,"ت",1,0],["هو حافظٌ تنزيله بجلاله","وموفقٍ يحميه من أعداء",79,"ا",2,0],["هو حبر وصدره الرحب بحر","أودع الله فيه قلبا سليما",80,"م",2,0],["هو حصرم في طرف من يغتابه","ما زال أن ذكر اسمه مطروفا",81,"ف",2,0],["هو حضنك الدافي يلملم أضلعي","من دمعة الأعباء إذ تُبكيني",82,"ن",2,0],["هو حيدرة أرجو بولا","ئه من والاه يقوى",83,"و",2,0],["ه وحدثتني بسر ما أبحت به .",". لكنها فضحت بالشجو مشتاقا",84,"ق",2,0],["هو حاتم لما المكارم تنتعى","يعطي كما تعطي البحار تدفقا",85,"ق",2,0],["هو حبّْ عُمري في الحَيَاه كُلِّي لِكُلِّه","لا عيشْ يِهنَا لي سِوى في قُربْ وصله",86,"ل",2,0],["هو حضنيَ المفتوحُ في شغفٍ","لكَ يا صديقي فلتنمْ فيهِ",87,"ي",2,0],["هُوَ حالُ عِشقٍ ما استقامَ لِغيرِنا","والكلُّ خلفَ مَسيرِنا لَضَحايا",88,"ا",3,0],["هو حيث في المحراب قد كنت ساجداً","وخلفك قد صلى الملائك ركعا",89,"ع",2,0],["هُو حُبُّكَ الْمُرْتَدّ نَحْوَ تَولُّهي","أمَّا عُيونكَ لَيْسَ لي عَنْها غِنى",90,"ن",2,0],["هُوَ حَسْبي لَقَدْ غُلِبْتُ عَلى أَمْ","ري,وَحالي كَمَنْ تَسَرَّبَ حُوتُهْ",91,"ت",2,0],["هو حضنُ جدي حينَ أبكي خائفًا","يتلو عليَّ حكايةً قبلَ الوسنْ",92,"ن",1,0],["هو حبُّنا في الله أَثمَرَ غُصنُه","شعراً يبثُّ كوامنَ الوُجدانِ",93,"ن",1,0],["هُوَ حِبُّنَا ، صَلّوا عَليهِ وسَلّمُوا","ترْوُوا بِهِ شُغُفَ القُلوبِ المدْبِرَهْ",94,"ر",2,0],["هو حتفها خزم النزال هزيمة","إن نال من قلب الرقيق المرجفُ",95,"ف",1,0],["هو حط ذرعانه لي فراش وارواق","وأنا لويت العضد لمعنقه طوق",96,"ق",1,0],["هو حِيناً كحريرٍ","هُو أحياناً كحَرْبةْ",97,"ب",2,0],["هو حسب رأيي لم يقم بجريمةٍ","بل إنهم قاموا بذي الأفعالِ",98,"ل",1,0],["هو حَبَّبَ الأجيال في إسلامه","مهما ينفِّرْها ذوو التخريبِ",99,"ب",1,0],["هو حكمٌ مثل ليل القدْر خيرٌ","للورى من ألفِ حكمٍ أرعنِ",100,"ن",1,0],["هو حائز لمحبة الناس التي","ليست تتاح سوى لعشاق الرُّسُلْ",101,"ل",1,0],["هو حسْبَ رأيي أنبلُ النُّبلاءِ","هو حسْب حدْسي أعظمُ العظماءِ",102,"ا",2,0],["هو حاملٌ جيناتِ والدِهِ الذي","هو فلتة تستسهل الأتعابا..",103,"ب",2,0],["هو حّرك القلب ساعة طال","غصن المواعيد واجترك",104,"ك",1,0],["هو حائرٌ .. هو سادرٌ في ذنبه","أوْلى به أن ينتهي ..أولى بهِ",105,"ب",2,0]]}