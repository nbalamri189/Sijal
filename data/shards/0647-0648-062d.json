{"poems":[[86,"قد غفونا وانتبهنا فإذا","https://www.aldiwan.net/poem10358.html","الرمل"],[86,"لعب البلى بملاعب الألباب","https://www.aldiwan.net/poem10375.html","الكامل"],[93,"هكذا هكذا نبوغ الرجال","https://www.aldiwan.net/poem11470.html","الخفيف"],[88,"هكذا يدرك في الدنيا الكمال","https://www.aldiwan.net/poem45045.html","الرمل"],[51,"شجو قلبي من سائر الخلق شاجي","https://www.aldiwan.net/poem9250.html","الخفيف"],[91,"قالوا قضى موسى فقلت قد انطوى","https://www.aldiwan.net/poem8827.html","عموديه"],[70,"هو حظي قد عرفته","https://www.aldiwan.net/poem42989.html","مجزوء الرمل"],[85,"سل يلدزا ذات القصور","https://www.aldiwan.net/poem63770.html","مجزوء الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39539","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54921","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54285","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54330","الخفيف"],[113,"عج بالركائب ساحة الجرعاء","https://www.aldiwan.net/poem42181.html","الكامل"],[118,"بعض بغضائكم أولى البغضاء","https://www.aldiwan.net/poem49357.html","الخفيف"],[158,"أترى النسيم إذا سرى من نجده","https://www.aldiwan.net/poem58724.html","الكامل"],[158,"ألقى على كرسيه أجسادا","https://www.aldiwan.net/poem58793.html","الكامل"],[159,"ملت عني لما حكاه العذول","https://www.aldiwan.net/poem4115.html","الخفيف"],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[197,"كوكب أبدلته ايديي الليالي","https://www.aldiwan.net/poem45366.html","الخفيف"],[219,"سئمت نفسي الحياة وملت","https://www.aldiwan.net/poem55253.html","الخفيف"],[219,"أيها المعرض ما هذا الجفاء","https://www.aldiwan.net/poem55261.html","الرمل"],[221,"حرم الجمال على سريرك يحلم","https://www.aldiwan.net/poem39695.html","الكامل"],[229,"لمن المطايا في رباها تنفخ","https://www.aldiwan.net/poem44593.html","الكامل"],[280,"من علا الصاحب الطويل الركاب","https://www.aldiwan.net/poem32864.html","الخفيف"],[303,"خطب عيون الدين منه ثجوجه","https://www.aldiwan.net/poem56586.html","الكامل"],[340,"دمعة حرى على وطن","https://www.aldiwan.net/poem55385.html","المديد"],[369,"سيدي رفقا وإن أصبحت","https://www.aldiwan.net/poem57282.html","مجزوء الكامل"],[456,"خدع الزمان مودة من ثائر","https://www.aldiwan.net/poem56205.html","الكامل"],[536,"قد رمت وصفك وهو شيء يلزم","https://www.aldiwan.net/poem47954.html","عموديه"],[556,"لا تكن إلا لمولاك أنا","https://www.aldiwan.net/poem33718.html","الرمل"],[556,"أهل المحبة في السرور الدائمِ","https://www.aldiwan.net/poem33857.html","الكامل"],[556,"إنما وحدة الوجود لدينا","https://www.aldiwan.net/poem34218.html","الخفيف"],[556,"كل قول على العقول يشق","https://www.aldiwan.net/poem34304.html","الخفيف"],[556,"شرفي يا شرفي يا شرفي","https://www.aldiwan.net/poem34339.html","الرمل"],[556,"انظر الكل لطيفا","https://www.aldiwan.net/poem34353.html","مجزوء الرمل"],[556,"غلب الهوى واستحوذ استحواذا","https://www.aldiwan.net/poem34561.html","الكامل"],[556,"انظر الكون خارجا من وجوده","https://www.aldiwan.net/poem34563.html","الخفيف"],[556,"بسط الله لي بساط الوجود","https://www.aldiwan.net/poem34593.html","الخفيف"]],"verses":[["هُوَ حَربٌ بَينَ فَقرٍ وَغِنىً","وَصِراعٌ بَينَ بُرءٍ وَسَقَم",0,"م",1,0],["هُوَ حُوَّلٌ هُوَ قُلَّبٌ هُوَ واضِحٌ","هُوَ غامِضٌ هُوَ قاطِعٌ هُوَ نابي",1,"ب",2,0],["هُوَ حَيٌّ ما دُمْتَ حَيّاً وَمَا دامَ","يَلِيهِ الأَبَرُّ فِي الأنْجَالِ",2,"ل",1,0],["هو حيّ أبد الدهر فما","ضرهّ من هذه الدنيا انتقال",3,"ل",1,0],["هو حبٌّ جاء الهوى فيه والرأ","ي سواءً وليس بالإلهاجِ",4,"ج",1,0],["هُوَ حينَ يَجري مَع هَواهُ خائِنٌ","وَإِذا سَمَت أَخلاقُهُ سِمسارُ",5,"ر",1,0],["هُوَ حَظّي قَد عَرَفتُهُ","لَم يَحُل عَمّا عَهِدتُهُ",6,"ت",2,1],["هُوَ حِليَةُ المَلِكِ الرَشي","دِ وَعِصمَةُ المَلِكِ الغَرير",7,"ر",1,0],["هو حُبِّي هامَ في الليل شريدا","مثلما هِمْتُ لنلقاكَ جميعا",8,"ع",2,0],["هُوَ حَاجَةُ الأَوْطَانِ مَا دَالَتْ بِهَا","دُوَلٌ مِنَ السَّرَّاءِ وَالضَّرَّاءِ",9,"ا",2,0],["هُوَ حَالٌ ثُمَّ حَالٌ","هُوَ حَرٌّ ثُم قَرُّ",10,"ر",1,0],["هُوَ حِيناً حَوْلَ الرُّبَا مِنْ نُضَارٍ","وَهْوَ حِيناً مِنْ فضَّةٍ بَيْضَاءِ",11,"ا",2,0],["هو حيٌّ يُطلُّ من كلِّ بيتٍ","دبَّجته عصارةُ الوجدان",12,"ن",1,0],["هو حصن إسعاف وبحر عنايةٍ","يوم المخاف وذلة العظماء",13,"ا",2,0],["هو حمى الجليس يدفع في الصد","ر ثقيل الكلام والإيماء",14,"ا",2,0],["هو حاتم في وجوده هو أحنف","في حلمه هو حيدر في جده",15,"د",2,0],["هو حظكم والحظ إن فات امرؤ","وجفاه أوسعه الزمانُ عِنادا",16,"د",2,0],["هو حظّي أموتُ وجداً وشوقاً","وَحبيبي بِمُبغضي مَشغول",17,"ل",1,0],["هُوَ حَيٌّ في قَبرِهِ بِحَياةٍ","كُلُّ حَيٍّ مِنها لَهُ اِستِملاءُ",18,"ا",2,0],["هوَ حَيٌّ في قبرهِ ولهذا","حُرِمَت مِن تراثهِ الزهراءُ",18,"ا",2,0],["هو حلمٌ وإن شهدناهُ فالغف","لةُ نومٌ لأعينِ الجُّهَّالِ",19,"ل",1,0],["هو حال أراده الله للنا","س لأمر به المهيمن أعلم",20,"م",1,0],["هو حظي وأنا في حمله","مرغم طوعاً لأحكام القضاء",21,"ا",2,0],["هُوَ حاكِمٌ يَشقى اليَتيمُ بِعَهدِهِ","جَوراً وَمِن خُبزِ اليَتامى يُطعَمُ",22,"م",1,0],["هو حاكم الحسن المطاع وعنده","للمحبة ثابت لا ينسخ",23,"خ",1,0],["هُو حِصنٌ لِلمُسلِمينَ حَصينٌ","وَهوَ غابٌ وَأَنتَ لَيثُ الغابِ",24,"ب",1,0],["هو حجّةٌ للّه بينَ عبادهِ","ردّت إِليه غَير ما مَحجوجه",25,"ج",2,0],["هو حي ميت ولقد","فارقته سورة الارن",26,"ن",1,0],["هُو حَتفُ النَّفسِ لا شك","كَ فلِم سمَّوهُ عِشقا",27,"ق",2,0],["هو حُكمُ عدلٍ لا يُردُّ وكان ما","يَهِنُ القلوبَ لو انه من جائرِ",28,"ر",1,0],["هو حاضرٌ إن كان نادى باسمِهِ","أولا فإنَّ عظيمَ أجرِهِ يَغنَمُ",29,"م",1,0],["هو حق وسواه باطل","جاء في القرآن هذا علنا",30,"ن",2,0],["هو حظهم في النشأتين من الذي","عشقوه بالقلب الطهور الصائم",31,"م",1,0],["هو حق بعد الفنا عن سواه","يتجلى فتضمحل العقول",32,"ل",1,0],["هو حق وباطل ما سواه","من جميع الأكوان غرب وشرق",33,"ق",1,0],["هو حق وسواه باطل","مثل ما قال لنا في الصحف",34,"ف",1,0],["هو حق وسواه","باطل جاء لفيفا",35,"ف",2,0],["هو حاضر لكن بغير إشارة","فإذا جهلت تقول عنه هذا",36,"ذ",2,0],["هو حق وأنت والكون طراً","باطل زاهق بحكم نفوده",37,"د",2,0],["هو حق ما قد ظننتم ولكن","إن يكن ذاك لا بكم يا جنودي",38,"ي",1,0]]}