{"poems":[[29,"متى ما التوى بالظاعنين نزيع","https://www.aldiwan.net/poem5805.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85589","المتقارب"],[369,"بما عن من شكوى زمان تعرضا","https://www.aldiwan.net/poem60860.html","الطويل"],[409,"سؤالكم وافى لتحقيق مشكل","https://www.aldiwan.net/poem33470.html","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204782","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110085","الطويل"]],"verses":[["وَلَيسَ زَمانٌ بِالكُمَيتَينِ راجِعاً","وَلَيسَ إِلى ذاكَ الزَمانِ رُجوعُ",0,"ع",1,0],["وَلَيسَ زحام على آجن","ولكن على العذب تلفي الزحاما",1,"م",2,0],["وليس زَماني ما بَقِيتُ وإن جَفا","بذَمّي له أَهلاً لأنْ أتعَرَّضا",2,"ض",2,0],["وليس زمان الصوم شهراً معيناً","فيشكل ما يروى به فتأمل",3,"ل",1,0],["وليس زواج الناس في نظري سوى","معاهدة تنفي التكافؤ في العقد",4,"د",1,1],["وليسَ زكاةُ الجاهِ الَّا حِمايةً","لَدَى العجز من بَغي الأَلدِّ المخاصمِ",5,"م",1,0],["وليسَ زكاةُ النُطقِ الَّا إِقامةً","لحُجَّةِ ذي حصرٍ عن القَولِ واجمِ",5,"م",1,0]]}