{"poems":[[55,"أمبلغي ما أطلب الغزل","https://www.aldiwan.net/poem29910.html","الكامل"],[85,"حياك يا دار الهوى من دار","https://www.aldiwan.net/poem54294.html","الكامل"],[87,"لله ريشة صادق من ريشة","https://www.aldiwan.net/poem6829.html","الكامل"],[47,"أأفاق صب من هوى فأفيقا","https://www.aldiwan.net/poem65176.html","الطويل"],[108,"أسطول معاوية","https://www.poetsgate.com/ViewPoem.aspx?id=179631",""],[108,"زمزم طليعة الأسطول المصري","https://www.poetsgate.com/ViewPoem.aspx?id=179646",""],[147,"بالحول نلت ونال الناس بالحيل","https://www.aldiwan.net/poem11794.html","البسيط"],[214,"لله روض حللنا دوحه سحرا","https://www.aldiwan.net/poem13479.html","البسيط"],[240,"حتام مطلك يا ظلوم","https://www.aldiwan.net/poem31762.html","مجزوء الكامل"],[276,"صدوا عن الصب الكئيب واعرضوا","https://www.aldiwan.net/poem52111.html","الكامل"],[285,"مولاي تصبر عن أديبك","https://www.aldiwan.net/poem60571.html","مجزوء الكامل"],[287,"ضربت لزينب بالغوير خيام","https://www.aldiwan.net/poem32462.html","الكامل"],[302,"لله روض بات نرجسه به","https://www.aldiwan.net/poem33157.html","الكامل"],[303,"يفنى الزمان وذكره يتجدد","https://www.aldiwan.net/poem36263.html","عموديه"],[308,"لله روض شقق الأكمام مذ","https://www.aldiwan.net/poem57832.html","الطويل"],[309,"خذ ما صفا ودع الكدر","https://www.aldiwan.net/poem16879.html","مجزوء الكامل"],[435,"ورق التهاني الوافيه","https://www.aldiwan.net/poem41000.html","مجزوء الكامل"],[438,"لمن ربوع مقفرات باللوى","https://www.aldiwan.net/poem12472.html","الرجز"],[449,"لله رب العرش والأكوان","https://www.aldiwan.net/poem56035.html","عموديه"],[457,"لله ربوة جلق من روضة","https://www.aldiwan.net/poem13852.html","الكامل"],[463,"لعدو حسنك ما لسمع العاذل","https://www.aldiwan.net/poem56068.html","الكامل"],[463,"سل أبرق الحنان واحبس به","https://www.aldiwan.net/poem56091.html","السريع"],[463,"نفرها عن وردها بحاجر","https://www.aldiwan.net/poem56177.html","الرجز"],[463,"الليل فالأرض لليث الشرى","https://www.aldiwan.net/poem56180.html","السريع"],[463,"خاطر بها إما ردى أو مراد","https://www.aldiwan.net/poem56227.html","الرجز"],[466,"يا عاقدا وضن الجمال البزل","https://www.aldiwan.net/poem16248.html","الكامل"],[505,"زر حيش لا تلو النياق لحاسا","https://www.aldiwan.net/poem37995.html","الكامل"],[519,"لا بر في الحب يا أهل الهوى قسمي","https://www.aldiwan.net/poem20785.html","البسيط"],[591,"خافت من الرقباء يوم وداعي","https://www.aldiwan.net/poem17593.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138358",""],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96973","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48680","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38925","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38207","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136270","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136327","السريع"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93095","الكامل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93137","البسيط"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95511","البسيط"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77818","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100984","الكامل"],[1754,"","https://poetry.dctabudhabi.ae/diwan/poem/107351","الكامل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100467","الكامل"],[1958,"","https://poetry.dctabudhabi.ae/diwan/poem/105640","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48218","البسيط"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105013","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88650","الكامل"],[2426,"","https://poetry.dctabudhabi.ae/diwan/poem/138831",""],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105407","الكامل"],[2496,"","https://poetry.dctabudhabi.ae/diwan/poem/100442","البسيط"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137373",""],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137353",""],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137424",""],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65988","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94306","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94142","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94034","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93922","البسيط"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109799","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132615","الرجز"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97948","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74056","البسيط"],[3493,"","https://poetry.dctabudhabi.ae/diwan/poem/100577","الكامل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61276","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114198","المجتث"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133232","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102985","البسيط"],[4047,"","https://poetry.dctabudhabi.ae/diwan/poem/144067","الرجز"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36360","الدوبيت"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36467","الدوبيت"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127214","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97095","البسيط"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97097","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90750","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90868","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54336","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94774","البسيط"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117274","البسيط"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62184","المتقارب"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/178104","البسيط"],[4782,"دموع وطن","https://www.poetsgate.com/ViewPoem.aspx?id=210287",""],[4888,"ضياء الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=207674",""],[5072,"يا صاحب العقل","https://www.poetsgate.com/ViewPoem.aspx?id=53672",""],[5756,"أول الغيث","https://www.poetsgate.com/ViewPoem.aspx?id=5365",""],[5790,"قدست من ملكٍ عظيم الشان","https://www.poetsgate.com/ViewPoem.aspx?id=111870",""],[5845,"صدوا عن الصبِّ الكئيبِ وأعرضوا","https://www.poetsgate.com/ViewPoem.aspx?id=16705",""],[5923,"تلكم جنتي","https://www.poetsgate.com/ViewPoem.aspx?id=150027",""],[5940,"أنشأت نظمًا زاهرًا قد طابا","https://www.poetsgate.com/ViewPoem.aspx?id=124948",""],[463,"سلْ أبرقَ الحنَّانِ واحبسْ بهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60166&r=&rc=222",""],[6354,"أحاديث النازحين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87924&r=&rc=1",""]],"verses":[["لِلَّهِ رُمحُكَ يَومَ تورِدُهُ","وَالماءُ لا صَردٌ وَلا عَلَلُ",0,"ل",1,0],["للهِ رحلتك التي نلنا بها","أجرَ الجهاد ونزهة الأبصارِ",1,"ر",1,0],["لله ريشة صادق من ريشة","تزرى طلاوتها بكل جديد",2,"د",1,1],["لِلَّهِ رَكضُكَ إِذ يُبادِرُكَ المَدى","وَمُبِرُّ سَبقِكَ إِذ أَتى مَسبوقا",3,"ق",2,0],["لله «رودِسُ» إِذ تُصيخُ، «وقُبْرُصٌ»","لصَدَى الأذانِ مُرَتَّلَ الأنغام",4,"م",1,0],["لله رايةُ مصرَ عاطرةً","بشذَا نسيم البحرِ إِذ يسري!",5,"ر",2,0],["لِلَّهِ رَأيُ إِمامِ الخَلقِ كَيفَ سَرى","إِلَيكَ وَالوَقتُ داجٍ مُظلِمُ السُبُلِ",6,"ل",1,0],["لله روض حللنا دوحه سحرا","والورد يشرق والأغصان في ميل",7,"ل",1,1],["لِلَّهِ رَونَقُهُ وَقَد","مالَت إِلى الغَربِ النُجومُ",8,"م",1,0],["لِلَّه ركب أَزمعوا راد الضحى","وَالشَمس تلفح وَالقَلائض تركض",9,"ض",1,0],["للهِ رَوْحُ صَباكَ كَمْ","تَرِدُ الْمُنى وَنَدى جَنُوبِكْ",10,"ك",1,0],["لِلَهِ رَبِّكَ صَلِّ وَاِنحَر مُخلِصاً","فَلِشانِئيكَ الذُلُّ وَالإِرغامُ",11,"م",1,0],["لِلَّه روضٌ باتَ نرجسُه به","ساهي العيونِ ملاحظاً نمَّامَهُ",12,"ه",1,1],["للهِ رأْيكَ في السِّياسةِ إنَّهُ","سهمٌ إلى كبدِ الصَّوابِ مُسدَّدُ",13,"د",1,0],["لله روضٌ شقق الأكمام مذ","جرت به أذيالها النسمات",14,"ت",1,1],["للَه رب العالمين","تعط المزيد كما ذكر",15,"ر",1,0],["للَه راحته التي","أبداً بجورٍ راوية",16,"ي",2,0],["لله ريمٌ في سُوَيدا القلبِ قد","حلّ إذا أحْوى الجمالِ قد حوى",17,"ا",1,0],["لله رب العرش والأكوان","فكر تفوت تصور الإنسان",18,"ن",1,1],["للهِ ربوة جِلّقٍ من روضةٍ","للغُوطَتين بها المحلُّ الأْشرَفُ",19,"ف",1,1],["لله راضٍ بالقليل لنفسه","متذمّمٌ لي بالكثير الفاضلِ",20,"ل",1,0],["للّه رهن لك يومَ النقا","لولا وفاء الحبّ لم يَغلَقِ",21,"ق",1,0],["للّه راعٍ منهمُ مستيقظٌ","لم يتظلَّم طولَ ليلِ الساهرِ",22,"ر",1,0],["للّه رامٍ سهمهُ رأيُهُ","إذا رأى شاكلةً فكَّرا",23,"ر",2,0],["للّهِ رامٍ بلُبَانَاتِهِ","طولَ الليالي وعروضَ البلادْ",24,"د",1,0],["للّهِ ربِّ العرشِ دَرُّ خليفَةٍ","أدْناكَ منْ شرفِ المَقامِ الأفْضلِ",25,"ل",1,0],["لله رَوْضَتهُ وجَلْجَلَها الثَّرى","وكأنَّها قد رُصِّعَتْ ألماسا",26,"س",2,0],["للّهِ رَوضةُ قُدسٍ عندَ مِنبَرِهِ","تعُدُّها الرُّسْلُ منْ جنّاتِ عدْنِهمِ",27,"م",1,0],["لِلَّه رَكْبٌ لَيْسَ عَهْدُ وِدَادِهمْ","عِنْدَ المُحِبِّ وَإنْ نأَى بِمُضَاعِ",28,"ع",1,0],["لله رتبة مجد نالها شرفا","فكان بين الملا اهلاً لما حصلا",29,"ل",2,0],["للَه رزء قد أصاب لنا","ندباً فعطل بعده الفرضا",30,"ض",2,0],["للّه رأيك نائلاً ومنوِّلاً","ما لا تحاوله قنا وصوارم",31,"م",1,0],["للَّهِ ربّي الحمدُ آمنَ أَهلها","مِن لُطفِهِ بِالفضلِ في أَوطانِها",32,"ن",3,0],["للَّهِ رَبّي دَرُّه مِن كامِلٍ","جَمَعَ الكَمالَ بمجملٍ ومفصَّلِ",33,"ل",1,0],["لله ربي جزيل الحمد حيث على","موارد السر قد حطت بنا الابل",34,"ل",1,0],["لله روح عاطر ناعم","أهداه للأرواح ذاك النسيم",35,"م",1,0],["لله رزؤك لم يدع","لقلوبنا إلا اكتئآبا",36,"ب",2,0],["لله رزؤك لم يترك لنا أبداً","ولو تعاقبت الأزمان سلوانا",37,"ن",2,0],["لله رتبةُ مجدٍ زاد سؤددها","بهم تحلّت وحَلَّت بالعلا رجبَا",38,"ب",2,0],["لِلَّه ركبان لها ساحت بهم","مَهما يَقول لها السمهسر سيحي",39,"ح",2,0],["للَه ركبٌ كان بدر سراهم","ورواحلٌ بعلاه كان نفارها",40,"ر",3,0],["للَه راحٌ قد سمت فمديرها","كان المسيح المفتدى القدّوسا",41,"س",2,0],["للَه رزؤك يا ابن بنت محمدٍ","في قلب كل موحدٍ لك مأتم",42,"م",1,0],["لِلَّهِ رَاسُ العَينِ فيها إِنَّهُ","مَجلَى الهُمُومِ ومَكمَدُ الأَعدَاءِ",43,"ا",2,0],["لله روضةُ أنسٍ حَسْبُ ناظرِها","يحظَى السرورَ وعنه يذهب المضَضُ",44,"ض",1,0],["لله رزؤك مذ أطلَّ على الهدى","أنساه ما قد مرَّ من أرزائه",45,"ا",3,0],["لِلَّه رزء جل وقع مصابه","وبه جميل الصبر غير جَميل",46,"ل",1,0],["لله رزءٌ جليلٌ لا يُرى أبداً","إلاّ لتقطيعِ أكبادِ المحبّينا",47,"ن",2,1],["للَه رزء قد أطل وحادث","طاشت له لمادهى الأحلام",48,"م",1,0],["للَه رجل لها رجل الخطوب سعت","وما رعت في بني الدنيا مساعيها",49,"ي",3,0],["لله رقة شعرها فلقد غدا","يزرى بحسن قلائد العقيان",50,"ن",1,0],["لله رحلتك التي وافى بها","عيد على أهل الصعيد سعيد",51,"د",1,0],["لله رونقه الذي أمسى به","غصن الملاحة مائسا متأودا",52,"د",2,0],["للّه رمّلنا صباح الكرم","ونوتم الأبنا وإن لم نوتم",53,"م",1,0],["لله روضة قبر ضم أعظمه","على ثراها أسحاب الرحمة انهلا",54,"ل",2,0],["للَه روض محاسن","أزهاره أبدا تجدد",55,"د",1,1],["للَه روض ثغور الزهر قد ضحكت","فيه لمن جاء يجني غض أثمار",56,"ر",1,0],["للَه راية إفراح بنصرته","قد صانها سعدها من نحس انكيس",57,"س",1,0],["لِلّه روضتها وقد حيى الصبي","اغصانها فحنت لها هاماتها",58,"ت",3,0],["لله ركب ضمنت خدوره","زهر الدراري وشذا الازاهر",59,"ر",1,0],["للَه رب أو الوجوب أو التي","ستجيء لابنك بالنتاج وبالقرف",60,"ف",1,0],["لِلَّه رابطة للشرق رابطة","حبل التَعارف إِمّا اِنبتّ واِنجزعا",61,"ع",2,0],["للَه رزؤك مثل فضلك ليس","يبليه الجديد إلى مدى الأعوام",62,"م",1,0],["لِلّه رَأي الملك المسدّدِ","مُطلِع نجمِ سَعدك المجدَّدِ",63,"د",1,0],["لِلَّهِ رَبِّي أشكُو","مَا لَم أطِق لَهُ صَبرَا",64,"ر",2,0],["لله ربع به الأغصان مائسة","وروضة الغض حسن الزهر وشاه",65,"ا",2,0],["للَه رمحك إذ ناجى نفوسهم","بصادق الطعن دون الكاذب الأشر",66,"ر",1,0],["لله ريْعانُ الشّبا","بِ زائراً ما أعجبا",67,"ب",2,0],["لِلَّهِ روَيحَةٌ سرت مِن نَجدِ","شَجواءَ تَقول لي وَتَشفي وَجدي",68,"ي",1,1],["لِلَّهِ رُوَيحَةٌ هَفَت بالآسِ","لِلوَردِ تَقول حالَةَ اِستئناسِ",69,"س",1,1],["لله ريم راح نمل عذاره","يرتاد شهد رضاب فيه السلسل",70,"ل",1,1],["للَه رزء به كم للرشاد هوى","ركن وكم فيه بيت للضلال بني",71,"ن",2,0],["للَه رزء هد أركان الهدى","عظماً ونادى بالرزايا هوني",72,"ن",2,0],["للَه رب ملاحة أبداً على","عرش الجمال لذاته استيلاء",73,"ا",2,0],["للَه رب محاسن","لولا الديانة قلت يعبد",74,"د