{"poems":[[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[79,"هدم السد وهو ما هو فار","https://www.aldiwan.net/poem36415.html","الخفيف"],[60,"أنا للحراب اليها","https://www.aldiwan.net/poem30806.html","مجزوء الرمل"],[52,"من فتاة صب الجمال عليها","https://www.aldiwan.net/poem24540.html","الخفيف"],[52,"أنجزي يا سلامة الموعودا","https://www.aldiwan.net/poem63951.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20993","الخفيف"],[6,"معلقة الحارث بن حلزة اليشكري","https://www.poetsgate.com/ViewPoem.aspx?id=11409",""],[52,"أنجزي يا سلامة الموعودا","https://www.poetsgate.com/ViewPoem.aspx?id=21672",""],[193,"لست أنسى زمنا قد سلفا","https://www.aldiwan.net/poem35098.html","الرمل"],[226,"ذكريني يا نجمتي ذكريني","https://www.aldiwan.net/poem55266.html","الخفيف"],[240,"جاء بدستبوية","https://www.aldiwan.net/poem32151.html","مجزوء الرجز"],[310,"كل امرئ دنياه ذا حدها","https://www.aldiwan.net/poem56557.html","السريع"],[385,"وأصل المحبوب والقدحا","https://www.aldiwan.net/poem49239.html","المديد"],[449,"زرت لندن ربة المدن والشمس","https://www.aldiwan.net/poem55989.html","عموديه"],[463,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[495,"أيها الساعي على آثارنا","https://www.aldiwan.net/poem659.html",""],[563,"أيها الطالب النجاة أتاكا","https://www.aldiwan.net/poem34266.html","الخفيف"],[563,"إن هذا بعض ما قد ظهرا","https://www.aldiwan.net/poem34511.html","الرمل"],[563,"ظلمات تقدرت تقديرا","https://www.aldiwan.net/poem34518.html","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63866","المنسرح"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/77454","السريع"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70830","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70798","الخفيف"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138145",""],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/126587","الخفيف"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46516","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79867","السريع"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113977","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28010","المديد"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87320","الرجز"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130843",""],[2940,"","https://poetry.dctabudhabi.ae/diwan/poem/113685","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205009","الخفيف"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105622","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62894","الخفيف"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86297","الرجز"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32367","الخفيف"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66333","الرمل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128915","الخفيف"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59503","الرمل"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88573","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111425","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111390","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111475","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111423","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111472","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111440","الخفيف"],[1043,"ابنتي فاتن","https://www.poetsgate.com/ViewPoem.aspx?id=94023",""],[5414,"حوار مع منافق","https://www.poetsgate.com/ViewPoem.aspx?id=12929",""],[5956,"أقصوصة أنثى سُحاقية","https://www.poetsgate.com/ViewPoem.aspx?id=182690",""],[5956,"حُلُمُ أمِّ فقير ‏","https://www.poetsgate.com/ViewPoem.aspx?id=184622",""],[5956,"قد دهانا الانفصال","https://www.poetsgate.com/ViewPoem.aspx?id=192969",""],[6124,"منك كلي","https://www.poetsgate.com/ViewPoem.aspx?id=128747",""],[6328,"ليته جاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82087&r=&rc=6",""]],"verses":[["ثُمَّ فاءَوا مِنهُم بِقاصِمَةِ ال","ظَّهرِ وَلا يَبرُدُ الغَليلَ الماءُ",0,"ا",2,0],["ثمّ في القَيْرَوانِ عادَ فكا","نَ الشّؤمُ مُستَصْحِباً له والفِرارُ",1,"ر",1,0],["ثُمَ فَخري بِرَسولِ ال","لَهِ إِذ زَوَّجنيها",2,"ي",3,0],["ثُمَّ فارَقتُ ذاكَ غَيرَ ذَميمٍ","كُلُّ عَيشِ الدُنيا وَإِن طالَ فانِ",3,"ن",1,0],["ثُمَّ فارَقتُهُم أَميدُ غُدُوّاً","وَحَرِيٌّ نَدمانُهُم أَن يَميدا",4,"د",2,0],["ثم في جبريل الذي هو بين ال","لَهِ ذي العرش والرسول سفير",5,"ر",1,0],["ثم في الأبرار الملائك حول ال","عرشِ والعرش قد زهاه النور",5,"ر",1,0],["ثم في الخناسِ الذي ليس من وس","واسه في الحياة تخلو الصدور",5,"ر",1,0],["ثم فيها عقاربٌ وأفاعٍ","ثمَّ فيها ضراغمٌ ونمور",5,"ر",1,0],["ثم فازوا بها وقاموا بما يو","جبهُ النصر والنهى والضمير",5,"ر",1,0],["ثم فاِعلَم يدور في الجو أورا","نوس مخفياً عَن عيون الرائي",6,"ا",2,0],["ثُمَّ فُضَّ الخِتَامُ عَن حاجِبِ الدَّ","نِّ وحانَت مِنَ اليَهُودِيِّ سُوقُ",7,"ق",1,0],["ثم فاؤوا منهم بقاصمة الظه","ر لا يبرد الغليل الماء",8,"ا",2,0],["ثم فرقتهم أميد غدواً","وَحَرِيُّ نَدْمَانُهُمْ أنْ يَمِيدَا",9,"د",2,0],["ثمَّ في الليلِ اِنثَنى نحوَ الحطيم","فَأتاهُ قبلَ إسفارِ الظلام",10,"م",1,0],["ثمَّ في الأمَّةِ يُرضيه الجَواد","وَينالُ الخلدُ في أعلى مقام",10,"م",1,0],["ثم في الحالتين أبت وفي النف","س شقاءان لا شقاء غبين",11,"ن",1,0],["ثُمَّ فَراها فَرَأَي","نا عَجَباً مِنَ العَجَب",12,"ب",1,0],["ثمّ في شهرِ الصومِ في ليلة ال","جمعةِ ماتَت وَالثرى مَهدها",13,"د",3,0],["ثُمَّ فاضَت نَفسُهُ فَقَضى","وَالجَوى وَالوَجد ما بَرَحا",14,"ح",2,0],["ثم فيها التأميز كالسين يجري","وكثير من واسعات الحياض",15,"ض",1,0],["ثم فيها من المحاسن والاض","اد ما في باريز ذات الارباض",15,"ض",1,0],["ثمَّ فحلَّتْ أربعي","نَ عشرةٌ من العُمُرْ",16,"ر",1,0],["ثُمَّ فينا لِلقِرى نارٌ يُرى","عِندَها لِلضَيفِ رُحبٌ وَسِعَه",17,"ع",2,0],["ثم فيه من روحه كان نفخ","من إلهٍ في غيبه لا يُحاكى",18,"ك",2,0],["ثم في ثوبيهما كان بدا","وأعيد الآن لما قبرا",19,"ر",2,0],["ثم في الأربع المراتب كشف","هو هذا للنور ثم استعيرا",20,"ر",2,0],["ثم فطيرٌ فليس من أَحدِ","يَعْجِنه آنفاً ويخبزه",21,"ز",2,0],["ثُمَّ فُتوح الشام بِاجتِهاد","وَبَعده المَعروف بِالإِنجاد",22,"د",1,0],["ثم فار الدخانُ بالبيت حتى","خلتُهم أُغرقوا وما مِنْ صريخ",23,"خ",1,0],["ثم فجِّر أبا ذؤابة تفجيرا","إلى أنْ تَفيضَ منه المجاري",24,"ر",2,0],["ثم فارقتنا ففاقنا الأن","س وساد الظلامُ فوق الربوع",25,"ع",1,0],["ثم فضت ختم العتاب وقلت","أنت لو كنت عاشقاً مت عشقاً",26,"ق",2,0],["ثُم فإنا ههنا لا نبقى","فأنت ذو تيقظ وَحذق",27,"ق",1,0],["ثمَّ فلم يختنه إلاَّ سنَّةً","أدامهُ الله لإحياءِ السنن",28,"ن",1,0],["ثُمِّ فارَقتُهم وقد فارقوني","غيرَ قالينَ لي ولا أنا قالِ",29,"ل",1,0],["ثم في يومِ النشور إذا","جمعوا للعرش في الحشرِ",30,"ر",1,0],["ثُمَّ فَلِي بَنجَ وَأندَرفُورَه","أَربَعَةٌ عندَ الملا مِشهُورَه",31,"ه",1,0],["ثم في بضع سنين نعتلي","ظهره الاسمى به نستوطن",32,"ن",1,0],["ثم فصلُ الخريفِ عنديَ أحلى","لاجتنائي فيه لذيذ الثِّمارِ",33,"ر",1,0],["ثم فارقته فما غاب عن قلبي","وان كان غاب عن ناظريا",34,"ي",2,0],["ثم فزعنا للصلاة والدعا","والفجر في روض الدياجي قد دعى",35,"ع",2,0],["ثم فوق الندى وفوق الأمانى","عُمَرُ المكرماتِ جُوداً وبذلا",36,"ل",2,0],["ثُم في امان مطمئنّا مِن محن","نَوماً اِذا في صَرفِهِ صافي الزَمَن",37,"ن",1,0],["ثُمَّ فِعَالاً فُعلُلاَ فَاعُولاَ","وَفَاعِلاَءُ فِعلَيَا مَفعُولاَ",38,"ل",2,0],["ثُمَّ فارَقتُها عَلى خَيرِ ما كا","نَ قَرينٌ مُفارِقاً لِقَرينِ",39,"ن",1,0],["ثم في مولده ما","بين أحبابك عيد",40,"د",1,0],["ثم فارقتني ولبيت داعي الحق","لما دعا بغير توان",41,"ن",1,0],["ثمَّ فِئنا لفراشٍ ناعمٍ","واعتناقٍ والتزامٍ ونعِمْ",42,"م",1,0],["ثم فارقتُها على ما كا","ن قرين مفارقاً لقرين",43,"ن",1,0],["ثم فريام صاح فيهم سريعا","يا سراة الطرواد قوموا فسيروا",44,"ر",3,0],["ثُمَّ فِرَخمس بالفِيُونيَِّينا","حُدبِ القِسيِّ قَومِ آمِيدُونا",45,"ن",2,0],["ثُمَّ في غُربَتِهِ تَمَّ عَلى","بِنتِ أَدرَستَ لَهُ عَقدُ القِران",46,"ن",1,0],["ثُمَّ في عُزَلَةٍ دَعَا وَدُعَاهُ","لاِبنِ لاَطُونَةٍ أَفُلُّونض رَاقي",47,"ق",2,0],["ثُمَّ فِينِكسُ نامَ يَرقُبُ صُبحا","وأَخِيلٌ إِلى الزَّوَايا تَنَحَّى",48,"ح",2,0],["ثُمَّ فَطرُقلُ في الخِباءِ المُقَابِل","وَليَتهُ إِيفِيسُ ذاتُ الشَّمائِل",48,"ل",1,0],["ثمَّ فُرُوثُو بنُ تَنثرِيدُونا","بمن أَتى مِن غابِ فِيليُونا",49,"ن",2,0],["ثُمَّ فِينِكسُ والدُّمُوعُ هَوَامٍ","لاَشتِدادِ الوَبالِ قالَ مُصِراَّ",50,"ا",1,0],["ثُمَّ فَرضَ المَرِيشِ بِالعُنفِ أَمسك","وإلى صَدرِهِ السَّرِيَّةَ أَضنَك",51,"ك",1,0],["ثم فارقتنا ففارقنا الأنْ","س وساد الظلامُ فوق الربوع!",52,"ع",1,0],["ثم فاضت منارةُ الحق بالن","ور وعزمِ الخليفةِ الصدِّيق",53,"ق",1,0],["ثم فكرتُ عساني","بالهُدى أُغسلُ رِجْسهْ",54,"س",2,0],["ثمَّ في الصبح أفاقت ورَوَتْ","ما رأته من منامٍ وصُوَرْ",55,"ر",1,0],["ثم فوراً فاجأونا بانفصال","تقشعر النفس منه والجبينْ",56,"ن",1,0],["ثُمَّ فِيضي فوق صدري كالأغاني","أو فَفِيضِيْ بينَ أشواقي دليلي",57,"ل",2,0],["ثم فيضي فرحا في مأتمي","ليس إلاك لدى الشكوى عزاء",58,"ا",2,0]]}