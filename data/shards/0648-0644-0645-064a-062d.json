{"poems":[[55,"أحبك بالطبع البعيد من الحجى","https://www.aldiwan.net/poem29875.html","الطويل"],[65,"سرى طيفها والملتقى متدان","https://www.aldiwan.net/poem46182.html","الطويل"],[88,"أجل هذه أعلامه ومواكبه","https://www.aldiwan.net/poem10687.html","الطويل"],[75,"هو الدهر فاصبر للذي أحدث الدهر","https://www.aldiwan.net/poem11936.html","الطويل"],[29,"ألا حي المنازل والخياما","https://www.aldiwan.net/poem6017.html","الوافر"],[53,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[53,"ألست ترى اليوم المليح المغايظا","https://www.aldiwan.net/poem65034.html","الطويل"],[30,"منعت عطاء من يد لم يكن لها","https://www.aldiwan.net/poem5404.html","الطويل"],[63,"على أبن العصب الملحي","https://www.aldiwan.net/poem51279.html","الهزج"],[68,"اليوم زعزع ركن المجد وانهدما","https://www.aldiwan.net/poem40121.html","البسيط"],[68,"نفوس الصيد أثمان المعالي","https://www.aldiwan.net/poem40137.html","الوافر"],[46,"أمالك إن الحزن أحلام حالم","https://www.aldiwan.net/poem30352.html","الطويل"],[46,"خذي عبرات عينك عن زماعي","https://www.aldiwan.net/poem30464.html","الوافر"],[77,"تقدم خطى أو تأخر خطى","https://www.aldiwan.net/poem69107.html","المتقارب"],[48,"صحبت الحياة فطال العناء","https://www.aldiwan.net/poem22156.html","المتقارب"],[48,"عجبت لشارب بزجاج راح","https://www.aldiwan.net/poem22480.html","الوافر"],[48,"إذا كان لم يقتر عليك عطاءه","https://www.aldiwan.net/poem22514.html","الطويل"],[1,"وإنا إذا ما الغيم أمسى كأنه","https://www.aldiwan.net/poem34005.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54771","المتقارب"],[95,"فتاة الجبل","https://www.poetsgate.com/ViewPoem.aspx?id=12714",""],[122,"ما بالرزايا وما بالنأي من باس","https://www.aldiwan.net/poem492.html",""],[136,"أبرق لاح من خلل الغمام","https://www.aldiwan.net/poem54734.html","الوافر"],[147,"ليهنك ما أنالتك الجدود","https://www.aldiwan.net/poem11748.html","الوافر"],[164,"هذا التأني وهذا الحلم قد فعلا","https://www.aldiwan.net/poem58892.html","البسيط"],[164,"من سلب الدهر رد أشبابه","https://www.aldiwan.net/poem58893.html","الرجز"],[164,"من عاش حدث عن أيامه العجبا","https://www.aldiwan.net/poem58910.html","البسيط"],[164,"أطمع في الوصل وما أناله","https://www.aldiwan.net/poem58915.html","الرجز"],[164,"سرور عم حتى ما عرفنا","https://www.aldiwan.net/poem59038.html","الوافر"],[173,"ألا رحلت نعم وأقفر نعمان","https://www.aldiwan.net/poem1683.html",""],[190,"وليل بت أقطعه طويل","https://www.aldiwan.net/poem43920.html","الوافر"],[190,"إذا جاء الثناء على فقير","https://www.aldiwan.net/poem43925.html","الوافر"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[234,"أعذلا وما عذلتني النهى","https://www.aldiwan.net/poem51276.html","المتقارب"],[261,"يا من رأى البدر حسن صورته","https://www.aldiwan.net/poem48488.html","المنسرح"],[266,"طرف بكى وفؤاد أن من وصب","https://www.aldiwan.net/poem38369.html","البسيط"],[302,"بنفسي هيفاء المعاطف ناهد","https://www.aldiwan.net/poem33285.html","الطويل"],[354,"فنيت بوجدي عن وجدي فدام لي","https://www.aldiwan.net/poem15570.html","الطويل"],[369,"أطاعك مني القلب العصي","https://www.aldiwan.net/poem60562.html","الوافر"],[369,"إذا ضربوا بكاظمة الخياما","https://www.aldiwan.net/poem60656.html","الوافر"],[376,"وراءك إن زندك غير واري","https://www.aldiwan.net/poem57454.html","الوافر"],[409,"رجعت عن النظم الذي قلت في النجدي","https://www.aldiwan.net/poem33948.html","الطويل"],[463,"يذنب دهر ويستقيل","https://www.aldiwan.net/poem55932.html","مخلع البسيط"],[466,"يكل الركب عن ابلاغ شوقي","https://www.aldiwan.net/poem15438.html","الوافر"],[491,"أرسم ديار بالستارين تعرفُ","https://www.aldiwan.net/poem482.html",""],[563,"عليك بروحك السر الإلهي","https://www.aldiwan.net/poem33652.html","الوافر"],[566,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138202",""],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96363","البسيط"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202072","الرجز"],[1116,"","https://poetry.dctabudhabi.ae/diwan/poem/117085","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46508","الرجز"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132857","الطويل"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82271","الهزج"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113976","الطويل"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26661","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100981","الطويل"],[1889,"","https://poetry.dctabudhabi.ae/diwan/poem/103247","المتقارب"],[2216,"","https://poetry.dctabudhabi.ae/diwan/poem/100482","المتقارب"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27956","الطويل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121190","الطويل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132362","الوافر"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137076",""],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87318","الرجز"],[2889,"","https://poetry.dctabudhabi.ae/diwan/poem/122957","الطويل"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203545","الوافر"],[3469,"","https://poetry.dctabudhabi.ae/diwan/poem/1","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108078","الوافر"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85204","البسيط"],[3784,"","https://poetry.dctabudhabi.ae/diwan/poem/18575","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131278",""],[3814,"","https://poetry.dctabudhabi.ae/diwan/poem/97729","الطويل"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103550","الطويل"],[3944,"","https://poetry.dctabudhabi.ae/diwan/poem/131390","الطويل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125865","الوافر"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123496","البسيط"],[4140,"","https://poetry.dctabudhabi.ae/diwan/poem/34707","البسيط"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135119","الطويل"],[4767,"عين الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=93516",""],[4767,"راية الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=179929",""],[1012,"أباة الضيم","https://www.poetsgate.com/ViewPoem.aspx?id=186325",""],[1012,"فتح بلدة نفعا","https://www.poetsgate.com/ViewPoem.aspx?id=124499",""],[5183,"الحزن العميق","https://www.poetsgate.com/ViewPoem.aspx?id=180262",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[5701,"رعى الله على دِجل","https://www.poetsgate.com/ViewPoem.aspx?id=164597",""],[5804,"لا خيرَ في الخير","https://www.poetsgate.com/ViewPoem.aspx?id=186971",""],[5937,"خَلْفَ اللثام","https://www.poetsgate.com/ViewPoem.aspx?id=211889",""],[5937,"باحثٌ عن أناهُ في مابعد الحداثة","https://www.poetsgate.com/ViewPoem.aspx?id=211893",""],[5956,"الرسالة المحمدية","https://www.poetsgate.com/ViewPoem.aspx?id=184653",""],[5956,"رغم التآمرِ","https://www.poetsgate.com/ViewPoem.aspx?id=192938",""],[6092,"إذا المرء لم يغضب له حين يغضب","https://www.poetsgate.com/ViewPoem.aspx?id=99576",""],[6302,"اشْتِبَاهْ !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86226&r=&rc=24",""],[572,"أَخوكَ الذي إنْ أفسَدَ الدَّهرُ وُّدّهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9463&r=&rc=320",""]],"verses":[["وَلَم يُحسِنِ الصَبُّ التَقاضي وَدونَهُ","غَريمٌ مُسيءٌ لا يَمَلُّ مِنَ المَطلِ",0,"ل",1,0],["ولمْ يَحْزُنِ الحَيَّ الكِنانِيَّ أنْ أُرَى","أسيراً لِهذا الحَيِّ من غَطَفانِ",1,"ن",1,0],["وَلَم يَحمِهِ حِصنٌ وَلَم تَرِم دونَهُ","دَنانيرُهُ وَالأَمرُ بِالأَمرِ حازِبُه",2,"ب",2,0],["وَلَم يَحمِ مِن أَن يُستَباحَ حِمى الهُدى","فَلَم يُرضِهِ إِلّا أَنِ ارتُجِعَ الثَغرُ",3,"ر",1,0],["وَلَم يَحموا النِساءَ وَقَد رَأَوها","حَواسِرَ ما يُوارينَ الخِداما",4,"م",2,0],["ولم يحاولْ مستزادي له","ولم يجِد في فعلكم مَعتبا",5,"ب",2,0],["ولم يحك شيئاً من ذكائك إنه","إذا كنتَ فيه شاتياً كنت قائظا",6,"ظ",2,0],["وَلَم يَحتَضِنها مُرضِعٌ مِن مُحارِبٍ","وَلا مِن غَنِيِّ اللُؤمِ كانَت أَوائِلُه",7,"ل",2,0],["ولم يحو به الأجر","ولم نعدم به المنا",8,"ن",2,0],["وَلَم يُحَرِّك لِساناً في أَذى أَحَدٍ","مِنَ العِبادِ وَلا أَجرى بِهِ قَلَما",9,"م",2,0],["وَلَم يَحُزِ العُلى إِلّا كَمِيٌّ","رَحيبُ الصَدرِ في ضيقِ المَجالِ",10,"ل",1,0],["وَلَم يَحمَدوا مِن عالِمٍ غَيرِ عامِلٍ","خِلافاً وَلا مِن عامِلٍ غَيرِ عالِمِ",11,"م",1,0],["وَلَم يَحفَظ مُضاعَ المَجدِ شَيءٌ","مِنَ الأَشياءِ كَالمالِ المُضاعِ",12,"ع",1,0],["ولم يَحْكِكَ الغَيثُ في نائلٍ","ولكن رأى شِيمةً فاقتَدَى",13,"ا",1,0],["وَلَم يَحُبُّني أَحَدٌ نِعمَةً","وَلَكِن مَولى المَوالي حَبا",14,"ب",2,0],["وَلَم يَحتَج إِلى عَونٍ بِقَطرٍ","وَلَم يَكُ صاحِبَ الأَيدِ الشَديدِ",15,"د",1,0],["وَلَم يَحمِ ظَبياً نافِراً كَونُ مَسكِهِ","عَتيرَةَ مِسكٍ أَن يُلِمَّ بِهِ العَترُ",16,"ر",1,0],["وَلَم يَحمِ أَهلَ الحَيِّ إِلّا اِبنُ حُرَّةٍ","وَعَمَّ الدُعاءَ المُرهَقُ المُتَلَهِّفُ",17,"ف",1,0],["وَلَمْ يَحْسَبُوا أَنَّ ذَا جُرْأَةٍ","يُهَاجِمُ جَمْعاً بِلاَ مُسْعِدِ",18,"د",1,0],["ولم يحسبوه ان ذا جراة","يهاجم جمعا بلا مسعد",19,"د",1,0],["ولم يحل دون ما يمّمت داهيَةٌ","متى تجاوزُها من شدّة الباس",20,"س",1,0],["ولَم يَحصُل علَى جِسمٍ أَنِيقٍ","فَيُحسَب مِن أُولِى الرُّتَبِ الجِسَامِ",21,"م",1,0],["وَلَم يَحلُم بِشَرواكَ التَمَنّي","وَلا جادَ الزَمانُ وَلا يَجودُ",22,"د",1,0],["ولم يحجك إِله العرشِ فيه إلى","ضرب الرقاب ولا ما يؤثم الرُجلا",23,"ل",2,0],["ولم يحاربه الجهول ضاحكاً","الا انتحى به إِلى انتحابه",24,"ب",2,0],["ولم يحجهم إِلى غزوٍ يكلفُهم","إِن يحملوا الزاد أو أنْ يأخذوا الأهبا",25,"ب",2,0],["ولم يحاربه امرؤ ذو حيلة","إلا رأى أعماله أعمى لهُ",26,"ل",2,0],["ولم يحوجه ملك أبيه سعيا","إلى شرف يشاد له وَيُبنى",27,"ن",2,0],["وَلَم يَحمِ كِسرى مِن حُدودِ سُيُوفِهِم","لُيُوثٌ لَها بِالجَوِّ زَأرٌ وَزُورانُ",28,"ن",1,0],["ولم يحدوا عليّ لهم ظهيرا","سوى وثب كشاردة الفهود",29,"د",1,0],["ولم يحتل له ثوبين أيضا","تردّ البرد عزما واجتهادا",30,"د",2,0],["وَلَم يحتجِ الشيخانِ في الدرس ناصراً","عَلى كثرةِ الأنصارِ للسنّةِ الغرّا",31,"ر",2,0],["ولم يَحْمِل الموتُ حتى حملتَ","ولولاك ما خاض ذاك اللَّظى",32,"ا",1,0],["ولم يحور لي الدقيق ولا","كانت تحوز المسلقات يدي",33,"د",2,0],["ولم يحط بعض وصف فيك أجمعها","ولو أتتك بما في سالف الحقب",34,"ب",1,0],["وَلَم يَحمها من فَتكتي عند طَعِنها","لَمى شَفتَيها والثُديّ النواهِدُ",35,"د",1,0],["وَلَم يَحظَ بِالحَظَّ العَظيمِ وَسَرمَدِ ال","بَقاءِ فَتىً بِالوَجدِ لَم يُفنِهِ الوَجدُ",36,"د",1,0],["ولم يُحْسَنْ إليّ بحِفْظِ غَيبٍ","ومثْلُك حينَ لم يُحسِنْ مَسيّ",37,"ي",1,0],["ولم يَحلُلْ بأَعْلَى المجدِ إلاّ","عظيمٌ يُفرِجُ الكُرَبَ العِظاما",38,"م",2,0],["ولم يحجُب بياضَ العيشِ عَني","بياضٌ لاح يلمعُ في عِذاري",39,"ر",2,0],["ولم يحفر الأخدود في باب كندة","ليحرقهم فافهمه إن كنت تستهدي",40,"د",2,0],["ولم يحوِّلك عن وفاءٍ","عهدتُهُ دولةٌ تدولُ",41,"ل",1,0],["ولم يُحدثْ لي الاِحسانُ حُبّاً","هوى نفسي بودكمْ قديمُ",42,"م",1,0],["وَلَم يَحلُ في عَيني بَديلٌ مَكانَها","وَلَم يَلتَبِس بي حَبلُ مَن يَتَعَطَّفُ",43,"ف",1,0],["ولم يحفظ عليك الوقت حتى","يضلَّك بالمعاند والمضاهي",44,"ي",1,0],["وَلَم يُحَمَّل مَغرَماً فَيُثقَلِ","مِن بَعدِ ما قالَ البَريدُ عَجِّلِ",45,"ل",1,0],["ولم يحد عنه جهول مارق","معاند إلا كفاه الخالق",46,"ق",1,0],["ولم يحد عن وصايا الحق في عمل","وحالف العلم طول الدهر واصطحبا",47,"ب",2,0],["ولم يَحِلّوا باحواسِ الغميسِ إِلى","شَطَّي عُويقةَ فالرَّوحاءِ من خِيمَا",48,"م",2,0],["ولم يَحولوا سَاعةً عن طَاعةٍ","مَحْمُودَةٍ لأمركم ولم يَحُلْ",49,"ل",1,0],["ولَم يَحُجَّ المَسجِدَ المُكَرَّمَا","ولَم يَزُر حَطِيمَهُ وزَمزَمَا",50,"م",2,0],["وَلَم يُحارب عَن بَني ذبيان","مخاطراً بِالنفس وَالحصان",51,"ن",1,0],["ولم يُحذِر الواشين من لحظاتِهِ","تَقَلُّب سَيفٍ بين جَفنَيِه مُرهَفاً",52,"ف",2,0],["وَلَم يَحضُر مَعَ الحضّا","رِ في خَيرٍ وَلَم يَبدُ",53,"د",1,0],["ولَم يَحمِ دينا مستباحاً حريمُهُ","منَ المُعتدي إلّا القَنا والقنابِلُ",54,"ل",1,0],["ولم يحملك طرفك بل فؤاد","تعوّد أن يخاض به الحمام",55,"م",1,0],["ولم يحتفل بالعيد برّاً بشعبه","فلا حفل في عيدٍ لديه ولا حشد",56,"د",1,0],["ولم يحذل العين مثل الفراق","ولم يرمَ قلبُ بمثل الهوى",57,"ه",3,1],["ولم يحل لي بعدكم ذو دلال","وخصر دقيق وردفٌ ثقيل",58,"ل",1,0],["ولم يحكم التكليفَ فينا بحالة","وجاء به الله المهيمنُ أنباء",59,"ا",2,0],["ولم يحل لي الا مرادة هجرها","دلالا وذا حال لمن ذاق حاليا",60,"ي",2,0],["ولم يحجبهُ شيءٌ دونَ شيءٍ","ولم يشغلهُ حالٌ دونَ حالِ",61,"ل",1,0],["ولم يحك تحنان الاغاريد حنة","به لدواليبٍ هي الورق اذ تشدو",62,"د",2,0],["ولَم يُحقِّقوا قياساً أُصِّلا","على جَنُوبِيهِ محلُّ الجُهَلاَ",63,"ل",2,0],["ولم يحد حاد بالرحيل ولم يزع","عن الإلف حزن أو يحول كثيب",64,"ب",1,0],["ولم يحتجْ إلى بنت الزُجاج","ولم يبعد عن العزماتِ حِذرا",65,"ر",2,0],["وَلم يَحمِ فَرجَ الحَيِّ إِلّا مُحافِظٌ","كَريمُ المُحَيّا ماجِدٌ غَيرُ أَحرَدا",66,"د",2,0],["ولم يحظر على الصب المعنى","دم الوجنات فهو دم الجمال",67,"ل",1,0],["ولم يحم في نهار لون طرته","إلا وأولاه أثواباً من الغسق",68,"ق",1,0],["وَلَم يحرمِ البيض اللَواتي كَأَنَّها","نُجوم الثُرَيّا مَسقَطَ النَسرِ طُلَّعا",69,"ع",2,0],["ولم يحمك الحصن المنيع وقد ثوى","لدى بابه الحراس فرداً وتوأما",70,"م",2,0],["ولَم يَحتطب أمّي على غير ثلّةٍ","وَلَم يَحتطب إلّا بطعنِ المقاتلِ",71,"ل",1,0],["ولم يحمهم من أن يسقوا بكأسهم","تناوش أطراف القنا واشتجاره",72,"ر",2,0],["ولم يحل لهو من خليل ملاطف","مهذّب خلق لا يعاب له فعل",73,"ل",1,0],["وَلَم يُحَقَّق غَيرُ ذَينِ قَسمُ","وَكُلُّ مَا ألِّفَ فَهوَ الجِسمُ",74,"م",1,0],["ولم يحفلّ بِذي الدنيا","ولم يعرف أبيقوراً",75,"ر",2,0],["ولم يحك غيرهم ما عشت في خلدى","ولم يحل عنهمو ودّ بهم عاذا",76,"ذ",2,0],["وَلَم يَحُلَّكَ مَحزونٌ بِهِ سَقَمٌ","إِلّا تَحَلَّلَ عَنهُ ذَلِكَ السَقَمُ",77,"م",1,0],["ولم يحمنا حزن ولم يحم سهلها","ولم يحتمى منه بغور ولا نجد",78,"د",1,0],["ولم يحفظ لذي شأنٍ مقاماً","ولو كان الذي نَعني مُهابا",79,"ب",2,0],["ولم يحملْ لنا التاري","خُ من آثارها نقلا",80,"ل",2,0],["ولم يحص الذي قد حل فيهم","سوى رب تنزه عن ملام",81,"م",1,0],["ولم يحصي الذي قد حلَّ فيهم","سوى ربٍّ تنزه عن ملامِ",82,"م",1,0],["ولم يحد بك عن نور الهدى عمَها","حب المقلد أغوته الأقاويل",83,"ل",1,0],["ولم يحفر الأخدود في باب كندة","ليحرقهم فافهم إذا كنت تستهد",84,"د",1,0],["ولم يحمل سوى الحق","فلا زورا ولا هجرا",85,"ر",2,0],["ولم يحملْ الزادَ في عمرِهِ","ولم يغنِهِ بعدها ما كسبْ",86,"ب",1,0],["ولم يحتج الماءَ قلبي ، فإنّي","ملأتُ بعينيك هذا السنامْ",87,"م",1,0],["ولم يحمل سوى كفّيه درعاً","ولم يصنع سوى الكلمات مَتْرَسْ",88,"س",1,0],["ولم يحكم بلا حِكَمٍ","وبالإحسان قد أمرا",89,"ر",2,0],["ولم يُحَقِّرْ إلهي الشِّعْرَ أجمَعَهُ","بل باركَ الشِّعرَ إنْ بالخيرِ قد صَدَرا",90,"ر",2,0],["ولم يحبه بالنصر قومٌ أعزةٌ","مقاحيم في الأمر الذي يتهيب",91,"ب",1,0],[".. ولَم يحفلْ بها .. مَا حلَّ يوماً..",".. لَها لُغةً.. وما اسْتَحلَى دُنُوَّهْ؟!",92,"و",2,0],["ولم يحتفلْ مستأنِفاً ودَّ صاحبٍ","لعلَّكَ تلقاهُ أعقَّ وأظلما",93,"م",2,0]]}