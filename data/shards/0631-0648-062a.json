{"poems":[[88,"أجل هذه أعلامه ومواكبه","https://www.aldiwan.net/poem10687.html","الطويل"],[74,"روت عيني التسهد عن قتاده","https://www.aldiwan.net/poem18598.html","الطويل"],[74,"جرى دمعي إلى والدي وأهلي","https://www.aldiwan.net/poem18602.html","الوافر"],[74,"روت عنك أخبار المعالي محاسن","https://www.aldiwan.net/poem18670.html","الطويل"],[87,"قم حي هذي النيرات","https://www.aldiwan.net/poem63775.html","مجزوء الكامل"],[216,"بنى نجل سلطان سعيد بعزمه","https://www.aldiwan.net/poem37857.html","البسيط"],[264,"إلام الحشا من لاعج الشوق في سخط","https://www.aldiwan.net/poem35776.html","الطويل"],[275,"أدمشق ما أمضى سيوف بنيك","https://www.aldiwan.net/poem35644.html","الكامل"],[302,"من عم طلعتك الغراء بالبلج","https://www.aldiwan.net/poem33309.html","البسيط"],[358,"رواية سيف النصر أبهى رواية","https://www.aldiwan.net/poem40568.html","الطويل"],[366,"ما زلت بين الورى حيران ذا كلف","https://www.aldiwan.net/poem68085.html","البسيط"],[409,"بروق بأكناف الحمى تتردد","https://www.aldiwan.net/poem33980.html","الطويل"],[422,"الدين أصبح منصورا بتأييد","https://www.aldiwan.net/poem54113.html","البسيط"],[457,"أجل حديث لا يمل دوامه","https://www.aldiwan.net/poem13898.html","الطويل"],[487,"كتبت إلى سري بسطر من الهوى","https://www.aldiwan.net/poem24288.html","الطويل"],[519,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103064","الطويل"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/139001",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87000","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70681","البسيط"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67827","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62633","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62559","المجتث"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128696","البسيط"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111789","البسيط"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71084","الطويل"],[2216,"","https://poetry.dctabudhabi.ae/diwan/poem/100480","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27147","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109366","الطويل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106986","الوافر"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137005",""],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137445",""],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75906","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93885","المتقارب"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140092",""],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74208","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74281","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87630","الوافر"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87522","البسيط"],[3281,"","https://poetry.dctabudhabi.ae/diwan/poem/114048","الكامل"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71315","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/63001","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45769","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45811","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45796","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45816","الطويل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132121","الكامل"],[3720,"","https://poetry.dctabudhabi.ae/diwan/poem/146963","الطويل"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107291","الطويل"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105527","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90848","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94556","الوافر"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198239","البسيط"],[4391,"","https://poetry.dctabudhabi.ae/diwan/poem/114046","المتقارب"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139669",""],[4767,"الغدير","https://www.poetsgate.com/ViewPoem.aspx?id=179578",""],[4858,"شوق والد إلى أولاده","https://www.poetsgate.com/ViewPoem.aspx?id=30458",""],[4884,"هي الحوراء","https://www.poetsgate.com/ViewPoem.aspx?id=202365",""],[4898,"وطني الكبير !","https://www.poetsgate.com/ViewPoem.aspx?id=35778",""],[4984,"سهام الشروق","https://www.poetsgate.com/ViewPoem.aspx?id=175750",""],[5277,"سرُّ المصون","https://www.poetsgate.com/ViewPoem.aspx?id=191106",""],[5277,"البحثُ عن الذات","https://www.poetsgate.com/ViewPoem.aspx?id=206877",""],[5444,"جَنَى الأردن","https://www.poetsgate.com/ViewPoem.aspx?id=205519",""],[6117,"بهوُ الجمَال","https://www.poetsgate.com/ViewPoem.aspx?id=182786",""]],"verses":[["رَوَت قَولَ بَشّارٍ فَثارَت وَأَقسَمَت","وَقامَت إِلى عَبدِ الحَميدِ تُحاسِبُه",0,"ب",2,0],["روت عيني التسهد عن قتاده","ومن لوني وسقمي عن جراده",1,"د",2,1],["روت عن قرَّةٍ عينٌ تراكم","وعين الضد تروي عن قتاده",2,"د",2,0],["روت عنك أخبار المعالي محاسن","كفت بلسان الحال عن ألسن الحمد",3,"د",1,1],["رَوَتِ الحَديثُ وَفَسَّرَت","آيَ الكِتابِ البَيِّناتِ",4,"ت",1,0],["روت عن ثناه الصافناتُ وقَدْ رَوَتْ","نجيعاً بيمناه قَناً وسيوفُ",5,"ف",1,0],["روت عنه في العليا مسلسلَ فضله","ومرسلَ ذوقٍ صحّ معتبرَ الشرط",6,"ط",1,0],["روّت دموعُ الأمّهاتِ غُصونها","ما أشبهَ المذروفِ بالمسفوك",7,"ك",1,0],["روت أَحاديثَ سُكّان الحِمى وَسَرت","تَهيجُ كلَّ فؤادٍ بالغَرام شَجِ",8,"ج",1,0],["رَوَت حكماً تَشخيصها شَخَصت لَهُ","عُيون وَأَلباب تقرُّ وَتطربُ",9,"ب",1,0],["رَوَت يَداهُ حَديث الجودِ عَن عَطا","بمسند صح عن بشر وَعن خلف",10,"ف",1,0],["رَوَتْ مهجتي عن مقلتي عن جفونهم","بأن لهم سهماً إلى القلب يورَدُ",11,"د",1,0],["روت معاليه عن سعد وما عدلت","بالعدل إذ ذاك عن حكم ابن مسعود",12,"د",1,0],["رَوَتْ هديَه الأصحابُ ثم رُواتُهم","وسُلْسِلَ عنهم ضبطُه ونظامُه",13,"م",2,0],["روته مجاري الدمع عن حب قالبي","وحبي عن روحي وروحي عن ربي",14,"ب",2,0],["روَتْ عن تَراقيها العُقودُ عن النّحْرِ","محاسِنَ تَرويها النُجومُ عن الفَجْرِ",15,"ر",1,1],["روت عنه أنباء العلوم رسائلاً","فأروت مَحَالَ الجهل من حكم مزنا",16,"ن",2,0],["روت لنا مصر عن فواكهها","أخبار صدقٍ صحيحة الخبر",17,"ر",1,1],["روت مَعاليه عَن مَجدي مؤرخةً","محمد شبل تَوفيق الأَصيل عَلي",18,"ل",2,0],["رَوَّتْ مدامعُها الدَّقْعا وأَمْعَدَ مِنْ","دمُوعِها حيوانُ البَر إِمْعادا",19,"د",2,0],["رَوَتْ هَبَراً رِيحُ الصَّبَا إذْ سَرَتْ بِهِ","لِصَبِّ هَوى نَجْدٍ يَطِيرُ بِلُبِّهِ",20,"ه",1,1],["روت أجسامنا عنه صحاحاً","كما نروي الصحاح عن الربيع",21,"ع",1,0],["روت حديث ظباء","فجدّدت لي عهدا",22,"د",2,0],["روَت جفونكم أنّي قتلت بها","فيا له خبرا يرويه مكحول",23,"ل",1,0],["روَت لعاشقها معنى الهوى فسلا","حديث قومٍ قديمٌ عهد جهمِ",24,"م",1,0],["رَوَتْ قَبْلَها بالسيف وَهْيَ خواضِعٌ","كما خَضَعَتْ خَوْفَ اللُّيوث نَعامُ",25,"م",1,0],["روت لنا سحراً ريح الصبا خبرا","عن النسيم صحيح النقل معتبرا",26,"ر",2,1],["رَوَتهُ الصَبا عَنهُم حَديثاً مُعَنعناً","عَنِ البَثِّ عَن وَجدي عَنِ الحُزنِ عِن كَربي",27,"ب",2,0],["روَّت رياض الفكر من غيث وصفه","فاخصب مرعاها وطابت مجانيا",28,"ي",2,0],["روت عنه غدير الدمع لكن","حديث ولا علي فيه أشهر",29,"ر",1,0],["روت عن راحتيه السحب سحاً","وعنه البدر قد اخذ الكمالا",30,"ل",2,0],["روت غليل ذوى الحاجات راحته","وقد روت عن نداه أرفع السند",31,"د",1,0],["رَوَت مِن أَحاديثِ الرَسولِ مَسانِداً","وَكانَ لَها روحٌ بِتَسماعِها غُذي",32,"ذ",2,0],["روت عن أمام جليل همام","تجلت مجانيه عن طيب غرس",33,"س",1,0],["روتيلة جبل وشمعون كذا","في فلت نابر حده في القرنة",34,"ه",1,0],["رَوَت مِن عباب الدين فَاِشتَد ساقها","وَأَغصانها مُدت إِلى مُنتَهى البَحر",35,"ر",1,0],["رَوَت عَنكُم الدُنيا أَحاديث سُؤدد","صحائفها شكر وَأقلامها حمد",36,"د",1,0],["روت تأريخَها عنهُ وَقالَت","لكم منّا التَهاني بالبشارَه",37,"ر",2,0],["رَوَت لنا عَن قَديم الاعصر الأُولِ","وَالحسنُ فيها جَديدٌ غيرُ منَتحلِ",38,"ل",1,1],["روت اليك وجوه آمال الورى","عطشا لورد نوالك الدفاق",39,"ق",1,0],["رَوَتْ نَفَحَاتُ الطِّيبِ عَنْ نَسْمِةِ الصِّبَا","حَدِيثَ غَرَامٍ عَنْ سُوَيْكِنَةِ الخِبَا",40,"ب",2,1],["روتْ عنكَ أَخبارُ المعالى محاسناً","كَفَتْ بلسان الحالِ عن أَلْسُنِ الحَمْدِ",41,"د",1,1],["رَوَت بازدياد النيل مَصر وَأَخضبت","فَأَجرى بِها مِن نيل جَدواه كَوثَرا",42,"ر",2,0],["رَوَت عَنهُم زُرق الأَسنة ما رَوَت","وَكلمت الأَبطال بيض الصَوارم",43,"م",1,0],["رَوَت الوَرى عَن فَضلِهِ حَتى اِرتَوَت","مَصر فَجَنَّ النيل ثُم تَسَلسَلا",44,"ل",2,0],["رَوَت بِالنَدى حَتّى تَغانَت عَن النَدى","وَقَد أَخصَبَت مِنها الرُبى وَالمَعالم",45,"م",1,0],["روت الرواة فهل أصدق ما روت","أم لا أصدق أنهم قتلوكِ",46,"ك",1,0],["روت خبرا عنكم فقلت لصاحبي","أتفهم ما يروى النسيم وتدرك",47,"ك",1,0],["رَوَت من حَديثٍ بَينَنا طابَ فانبَرَت","تَعثَّرُ في تِلكَ الهِضابِ من السُكرِ",48,"ر",1,0],["روت الفلك في متون البحار","نبأ البرق عن صحيح البخاري",49,"ر",2,1],["روت عن سليم الذوق يا رويها","معاني اصفي من معين زلال",50,"ل",1,0],["روت سرّاً فأنجم مهُ سُرٌّ","وكم سرَّت قلوباً بالنشيدِ",51,"د",1,0],["روَتْ ((عُمَانُ)) حَديثاً عَنْ شَهَامَتِهِم","مُسَلْسَلاً مَنْ وَعاهُ لَيْسَ يَنْسَاهُ",52,"ا",2,0],["روت لي فتاة حديثا جرى","بإحدى مدارس بعض القرى",53,"ر",2,1],["روت حكم السبع المثاني وأفصحت","فصاحتها عما حوى الذكر من سرّ",54,"ر",1,0],["روَّت بلاد المسلمي","ن البائسين دماؤه",55,"ا",3,0],["روّتْ ظماءَ قلوبهمْ قبلاتهمْ","وغفواْ على همْسٍ كهمسِ رَبابِ",56,"ب",1,0],["روتني جهينةُ صدقَ اليقينِ","وسوفَ أعيدُ يقينَ الخبرْ",57,"ر",1,0],["رَوَت العُيونَ،وقد تدَفق حُسنها،","مِن فيض سِحْر بَاهر فتّان ِ",58,"ن",1,0],["روت كل شبر بأرض الرباط","ورُدًّ الأعادي بعزم صدوق",59,"ق",1,0],["روتْ قلبي بغُنّتها وألقتْ","مسامعَها وقالتْ أنتَ أحرى",60,"ر",2,0],["َروّتْ عجافَ الروحِ..ويحَ رضابِها","شهدٌ..أذاق القلبَ طعمَ الضائعهْ",61,"ع",2,0],["رَوَتْه (نَزَوى) بأفلاجٍ مُعطرِّةٍ","بماءِ وردٍ وأشواق الهوى عُجِنا",62,"ن",2,0],["روَّت ينابيعُ الضياءِ خباءَها","وتنفسَ الصبحُ البديعُ بهاءَها",63,"ا",3,1]]}