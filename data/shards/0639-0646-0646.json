1,"","https://poetry.dctabudhabi.ae/diwan/poem/71083","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126193","الرجز"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133952","الرجز"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112555","الرمل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112626","الرجز"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216545",""],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216539",""],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126967","الرمل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86274","البسيط"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199177",""],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86355","الرمل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36333","الدوبيت"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72447","البسيط"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76764","الكامل"],[4755,"عَن نَكبَةٍ فِي عَامِهَا الثَّالِثِ","https://www.poetsgate.com/ViewPoem.aspx?id=191999",""],[4767,"المعيار","https://www.poetsgate.com/ViewPoem.aspx?id=187543",""],[4802,"ياوسع صدرك","https://www.poetsgate.com/ViewPoem.aspx?id=32342",""],[4859,"بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=207372",""],[4984,"افْتَحْ من العهد القديم ..","https://www.poetsgate.com/ViewPoem.aspx?id=191325",""],[5038,"الحدباء تناديني","https://www.poetsgate.com/ViewPoem.aspx?id=195227",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5304,"اقف على درب المحبين","https://www.poetsgate.com/ViewPoem.aspx?id=155912",""],[5431,"أبي وسرمد تحنان على شفتي","https://www.poetsgate.com/ViewPoem.aspx?id=192441",""],[5525,"كثرة عذاريبي","https://www.poetsgate.com/ViewPoem.aspx?id=7208",""],[5875,"صراخ المهابيل","https://www.poetsgate.com/ViewPoem.aspx?id=211769",""],[5953,"علت قباب لكم هداتي","https://www.poetsgate.com/ViewPoem.aspx?id=93794",""],[6142,"أين يا مسنح الجآذر إذا","https://www.poetsgate.com/ViewPoem.aspx?id=155729",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[242,"يا حسنه والحسن قيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563695",""],[5555,"مُعَلَّقَةٌ لِلِاحتِفَاءِ بِالْهَشَاشَةِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87404&r=&rc=0",""]],"verses":[["عَنَنتِ لَهُم بِمورَةَ بِنتَ عَشرٍ","وَسَيفُ المَوتِ في هامِ الكُماةِ",0,"ه",1,0],["عن نَفَلٍ أسْألُ أو حَنْوَةٍ","سُؤالَ مُزْجي فِيلِهِ عن نُفَيْل",1,"ل",1,0],["عَنْ نُطْقِهِ تَقَعُ الصُّرُوفُ مَواعِظاً","وَكَأَمْرِهِ أَمْرُ الزَّمَانِ مُصَرَّفَا",2,"ف",2,0],["عَنْ نَبْعَتيْكِ صَدَرْتِ بِال","أَخْلاَقِ وَالأَدَبِ النَّفِيسْ",3,"س",1,0],["عنناً باطلاً وظلماً كما تع","تر عن حجرة الربيض الظباء",4,"ا",2,0],["عن نبض أعراقي وعن لغني","عن منبتي من عقم أكفاني",5,"ن",2,0],["عن نعاس يملك الأحلام عن","شجن أعمق من تيه الضبابة",6,"ب",2,0],["عن نُفوسٍ ظَفِرَت في عَيشِها","بالذي يرجو مُحبّ قد صَبَر",7,"ر",1,0],["عن نافع حدثنا وصله","وهجره حدثنا عن ضرار",8,"ر",1,0],["عن نار قلبي وعن تضرمه","وهل حديث اللقا يسوغه",9,"ه",1,0],["عَنْ نَاصِرِ الدِّينِ بْنِ نَا","صِرٍ الذِي أَحْيَا وَجَدَّدْ",10,"د",1,0],["عَنْ نُورِ هَدْيِكَ ثَغْرُ الدَّهْرِ مُبْتَسِمُ","يَا وَاحِداُ وَرَدَتْ مِنْ بَحْرِهِ أُمَمُ",11,"م",1,1],["عَن ناظِري سِرتُم إِلى قَلبي فَما","لَكُمُ وَلِلتَبريحِ عَنهُ بَراحُ",12,"ح",1,0],["عَن نَفسِهِ فاراها إيما شَمَمِ","وَكَيفَ يَرضى وَقَد كانَت وَتيرَتُهُ",13,"ه",1,0],["عن نُطَفٍ فيها خَصَر","حتّى أتى وقد أَشِر",14,"ر",1,0],["عن نابِ خَطْبٍ قد فَطَر","نِكْسٌ له القَلْبُ انفَطَر",15,"ر",1,0],["عن نَشْرِه فاحَ النسيمُ معطّراً","وبشكرِه غنّى الحمامُ مرَجّعا",16,"ع",2,0],["عن نديم الصوت عن خمر بدت","بكؤوس رصعت من لعس",17,"س",1,0],["عن نفسه بربه مشتغل","وربه كما يقول المرسل",18,"ل",1,0],["عن نعته صام ال","عقول فليس تلقى من افطور",19,"ر",1,0],["عَن نَظيرٍ خَلا وَلَيسَ عَجيباً","أَفَلا الشّمسُ قَد خَلَت عَن خدينِ",20,"ن",1,0],["عَنْ نَفَسِ المُكْرُوبِ حَرَّ اللَفْحِ","في كُلِّ يَوْمٍ مُسْمَهِرِّ الصَمْحِ",21,"ح",1,0],["عن نوار صاح شغل شاغل","من يكن فكر في معنى نوار",22,"ر",1,0],["عن نصب الاسم السابق الفعل اشتغل","بمضمر أو سبب أو المحل",23,"ل",1,0],["عن نصر بن عاصم والدؤلي","من قبله يروي الأول عن علي",24,"ي",1,0],["عَنْ نَافِعٍ أَسْنِدْ حَدِيثَ أَحِبَّتِي","يَا مَالِكاً رِقِّي بِحُسْنِ صَنَائِعِ",25,"ع",1,1],["عن نَقْمِ ثأَراتٍ لكم وطوائِلٍ","إِنَّ العبيدَ عُقودُها لم تُحْلَل",26,"ل",1,0],["عَن نَيلِ مَقصِدِهِ فَذَاك عَدُوُّهُ","وَلَو أنَّهُ مِنهُ القَرِيبُ الدَّانِي",27,"ن",2,0],["عن نَظَرشى الإقبالِ والإدبارِ","منّى إليها سائرَ الأطوارِ",28,"ر",1,0],["عَن نفسه فأراها أَيما شَمَم","وَأوقَفت مدّ عينيه بصيرتُه",29,"ه",1,0],["عن نية المعنى الحقيقي كما","تقول أنبت الربيع الباسما",30,"م",2,0],["عن نمير أو نضير يرعوي","بينما يزهى بتمويه السراب",31,"ب",1,0],["عن نَفسِهِ بنَفسِهِ عزّاها","وبالرضا والصبرِ أوصاها",32,"ه",2,0],["عَنْ نَدْمِتَهْ مَا يعيضني حَدّ","لَو مِنْ بَنَات الحُور بيَّاب",33,"ب",1,0],["عن ناطحات السحْب أعْجَبْ","وشَكْلَهْ يِمَلْ عَنْ كِلّ الاشكال",34,"ل",1,0],["عن نساكم هتكوا حجب الخدور","فبنات الوحي من غير ستور",35,"ر",1,0],["عَن نِعمَةِ اللَهِ يُبدي الشُكرَ في علن","وَإِنَّما البِرُّ قَد يُسديهِ مُستَتِرا",36,"ر",2,0],["عن نيلنا ثم قد شربنا","ملحا فزاد الكبود حرا",37,"ر",2,0],["عن ندى كفِّ نداها أخجلا","طله غيث الغمام الوكف",38,"ف",1,0],["عَن نَورِ رُبىً تَقاضَتِ الأَرواحُ","أَي قُم سَحَراً فَوَعدُنا الإِصباحُ",39,"ح",1,1],["عَن نَفْسِهِ فأَراها أَيَّما شَمَمِ","جَفَتْهُ لِلزُّهْدِ في الدُّنيا عَشِيرَتُهُ",40,"ه",1,0],["عن نيل ما تقتضي علاه","ما عاقه في الأنام عائق",41,"ق",1,0],["عن ناصر الاملاك حدث واطرح","ما قيل عن كسرى وعن ساسان",42,"ن",1,0],["عَن نَكبَةٍ فِي عَامِهَا الثَّالِثِ؟!","أَمْ وَارِثٍ لِلشَّعبِ مِن وَارِثِ؟!",43,"ث",1,1],["عن نورِ شمسِك زاغت الأبصار","حتى انتفَى الإحساس والإبصارُ",44,"ر",1,1],["عن ناس ماهم..؟ عن بلادك وعن ماك","عن حبك لناس وعن ناس حبّوك",45,"ك",1,0],["عن نيل ما يبغي بنوها إنّها","حلفت بأن جراحها ستموتُ",46,"ت",1,0],["عن نشأة كانت وبدء خليقة","وتحولت بعد القرون ترابا",47,"ب",2,0],["عَنْ نَسْمَةِ الصُّبْحِ عَنْ أَنْداءِ شاطِئِها","عَنْ قُبْلَةِ الدِّفْءِ في لَيلِ الْكَوانِينِ",48,"ن",1,0],["عَنْ نَينَوى وَبَني حَمْدانَ أَسْيُفُها","عَنِ الْعَزائِمِ في الشُّمِّ الْعَرانِينِ",48,"ن",1,0],["عن نرجس تحت أجفان مكسرة","أشفارها بات ذوب الليل يُرويها",49,"ي",3,0],["عن نفحة الآس والريحان تعبق عن","خد سقته من النعمى سواقيها",49,"ي",3,0],["عن ناضر داعبته الكبرياء على","رمانتيه فحيى روضه فيها",49,"ي",3,0],["عن نومها بالليل والصبح باكرك","والليل برد ٍ من عراياه يكساك",50,"ك",1,0],["عن نجمة ولدت من رحمها وطنا","هاج الحنين له واستأسد الكمدُ",51,"د",1,0],["عن نية الجود صعب اليوم تجنيبي","من قيل ذا النجم جدك غصب يسري به",52,"ب",2,0],["عن ناقصين الكيل ماحط لي كيل","بين الجدي وسهيل عن الرزيه",53,"ي",2,0],["عن نور نورٍ لنور نورٍ","من نور أنوار نيرات",54,"ت",1,0],["عن نبي الهدى كمالا تردى","وبدر العلوم منه تغذى",55,"ذ",2,0],["عَن ناحَتي وَكَحيل ملا سدا وهم","كُل الفَرايا بِالجبل دمرونها",56,"ن",3,0],["عَن ناصِرِ الدينِ اِبنِ نا","صِرِ الَّذي أَحبى وَجَدَّدَ",57,"د",1,0],["عَنْ نَّجْمَةٍ وَالزَّمَانُ يُسْعِدُهَا","وَنَجْمَةٍ فِي الظَّلَامِ آفِلَةِ",58,"ه",1,0]]}