{"poems":[[95,"ليلى اجمعي الناس إلى محفل","https://www.aldiwan.net/poem11104.html","السريع"],[51,"من لعبد أذله مولاه","https://www.aldiwan.net/poem65354.html","الخفيف"],[89,"من لعين إنسانها لا يناميب كفا","https://www.aldiwan.net/poem8242.html","الخفيف"],[33,"من لعين تذري من الدمع غربا","https://www.aldiwan.net/poem42643.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54986","الخفيف"],[284,"من لعيني بالكرى","https://www.aldiwan.net/poem2648.html","مجزوء الخفيف"],[358,"من لعين اروقة لا تنام","https://www.aldiwan.net/poem40589.html","عموديه"],[460,"من لعين كثيرة الهملان","https://www.aldiwan.net/poem26633.html","الخفيف"],[466,"نبأ عاد له الصبح دجى","https://www.aldiwan.net/poem16016.html","الرمل"],[505,"دمعي كسيل تنمنم","https://www.aldiwan.net/poem37779.html","المجتث"],[563,"من لعبد بجسمه السقم بادي","https://www.aldiwan.net/poem34600.html","الخفيف"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2423","المديد"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122777","المنسرح"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48732","الكامل"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216944","الخفيف"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133873","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79905","الخفيف"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101030","السريع"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87838","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202156","الرمل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104814","الخفيف"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93354","الخفيف"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104671","الرمل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109855","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83557","الخفيف"],[4572,"","https://poetry.dctabudhabi.ae/diwan/poem/22800","الخفيف"],[4759,"من لعينيك؟","https://www.poetsgate.com/ViewPoem.aspx?id=204210",""],[460,"مَنْ لِعينٍ كثيرة ِ الهَمَلانِ","https://www.poetsgate.com/ViewPoem.aspx?id=22249",""],[5049,"المسكنة الله","https://www.poetsgate.com/ViewPoem.aspx?id=186335",""],[4572,"منْ لعينٍ رأتْ مطيفاً","https://www.poetsgate.com/ViewPoem.aspx?id=15004",""],[5563,"جنون العشق","https://www.poetsgate.com/ViewPoem.aspx?id=211921",""],[6314,"جدارية عارية للبحر والجسد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88073&r=&rc=8",""]],"verses":[["مَنْ لِعَرُوسٍ فَارَقَتْ خِدْرَهَا","وَأَصْبَحَتَ بَعْدَ الحُلَى عَارِيَهْ",0,"ي",2,0],["مَن لِعَبدٍ أَذَلَّهُ مَولاهُ","ما لَهُ شافِعٌ إِلَيهِ سِواهُ",1,"ه",1,1],["مَنْ لِعَيْنٍ إِنْسَانُهَا لا يَنَامُ","وَفُؤَادٍ قَضَى عَلَيْهِ الْغَرَامُ",2,"م",1,1],["مَن لِعَينٍ تُذري مِنَ الدَمعِ غَربا","مُعمَلٍ جَفنُها اِختِلاجاً وَضَربا",3,"ب",2,1],["منْ لِعَانٍ هوَاكِ يصْرَعُهُ","حِينَ يَغْشاهُ مِنْكِ مَا يَغْشى",4,"ش",2,1],["من لِعْينَّي بالكَرى","فأَرى الطيفَ إِن سرى",5,"ر",2,1],["من لعين اروقة لا تنام","مل منها يا للرجال الظلام",6,"م",1,1],["مَن لِعينٍ كَثيرَةِ الهَمَلانِ","وَالحُزنِ قَد شَفَّني وَبَراني",7,"ن",2,1],["منْ لِعَقْرِ النِّيبِ في مُغْبرَّةٍ","ولِقَوْدِ الخيلِ جُرْداً كالَّسعالي",8,"ل",2,0],["من لَعْلَعٍ يتَرامى","بالرُّكبِ نحوَ اليَلَمْلَمْ",9,"م",1,0],["من لعبدٍ بجسمه السقم بادي","بين أيدي حواسد وأعادي",10,"د",2,1],["مَن لِعَينٍ تُمنَحُ الأَرَقا","وَلِهَمٍّ حادِثٍ طَرَقا",11,"ق",2,0],["مَن لَعَميدِ الفُؤادِ مُدنِفُهُ","مَن مُنصِفي في هَواهُ أَو حَكَمي",12,"م",2,0],["من لعرش سواك عبرة واعظ","ولعرشك العالي ارتياح الشادي",13,"د",2,0],["مَنْ لعينٍ بدمعها مُوليه","ولنفسٍ ممّا عَنَاها شَجيّه",14,"ي",2,1],["من لعين تجود بالهملان","ولقلب مدله حيران",15,"ن",1,1],["مَن لعيني بطلعةٍ هي منكم","طلعةُ البِشرِ طلعةُ الأفراح",16,"ح",1,0],["من لعزيز بوأته العلا","بالملك مجداً في الورى آثلا",17,"ل",2,0],["مَن لِعَينَيكَ أَن تَرى ما أَراهُ","مِن مَجالٍ لَيسَت تَمُرُّ بِبالِك",18,"ك",1,0],["من لعميان عدوا نهج الهدى","ولموتى بعد موتى يعبرون",19,"ن",1,1],["مَن لِعَينِىَ أن تَرَى","نُورَ أحمضدَ بانفِرَاد",20,"د",1,0],["مِن لعانٍ مِنهنّ غَير طَليق","وَسَقيمٍ مِنهنَّ غَيرِ معودِ",21,"د",1,0],["مَن لِعَيني أن تَرى كَعبَتَها","في بَهاها وَسَناً أَو عَلَنا",22,"ن",2,0],["من لعقد من جوهر في نظام","يغتدي في الجمال مثل كلامك",23,"ك",1,0],["من لِعَبدٍ مُستَضعَف في زَمانٍ","شِبهُ ذِئبٍ مكشّرٍ عن نابه",24,"ب",2,0],["مَن لِعَينٍ رَأَت خَيالاً مُطيفا","واقِفاً هَكَذا عَلَينا وُقوفا",25,"ف",2,1],["من لعينيك إن أسرت فؤادي","يستطيب السراح في عينيك",26,"ك",1,1],["مَنْ لِعينٍ كثيرة ِ الهَمَلانِ","ولحزنٍ قد شفَّني وبراني",27,"ن",2,1],["من لعبد خلقت من كل وجه","جاهلا ما بكل ذم قمينا",28,"ن",2,0],["منْ لعينٍ رأتْ مطيفاً","وفقاً هكذا علينا وقوفاَ",29,"ف",2,1],["‏منْ لَعُوْبٍ في جمالٍ","ألْبَسَتْكَ الحُسْنَ بُردَةْ",30,"د",2,0],["من لعنة اللاوصل هاكِ قصيدةً","علَّ الوِصال بها يجيء علانيةْ",31,"ي",2,0]]}