{"poems":[[64,"قيامتنا جمع أرواحنا","https://www.aldiwan.net/poem52160.html","المتقارب"],[19,"لليلى بأعلى ذي معارك منزلُ","https://www.aldiwan.net/poem358.html",""],[147,"أما وبديع ما تأتي يمينا","https://www.aldiwan.net/poem11835.html","الوافر"],[201,"قومي اسمعي يا بنت جاري","https://www.aldiwan.net/poem39947.html","مجزوء الكامل"],[342,"عفا بطن قو من سليمى فعالز","https://www.aldiwan.net/poem45428.html","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136143","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92055","البسيط"],[4679,"ذو الحزم يسمو والمهيمن ينصر","https://www.poetsgate.com/ViewPoem.aspx?id=142728",""],[5183,"إلى الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=180189",""],[487,"هي الدرة البيضا وعين الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=129583",""],[6093,"صدق المشاعر لا يباع ليشترى","https://www.poetsgate.com/ViewPoem.aspx?id=206348",""]],"verses":[["فمظلمها في قرار الجحيم","ونيّرها في محل الكرامه",0,"م",2,0],["فَمَظَّعَها حَولَينِ ماءَ لِحائِها","تُعالى عَلى ظَهرِ العَريشِ وَتُنزَلُ",1,"ل",1,0],["فَمَظلومٌ يَحِنُّ إِلَيكَ شَوقاً","وَظَلّامٌ يُحاذِرُ أَن يَحينا",2,"ن",2,0],["فمظاهرٌ خلّابةٌ","والآلُ يخدعُ في الصحاري",3,"ر",2,0],["فَمَظَّعَها عامَينِ ماءَ لِحائِها","وَيَنظُرُ مِنها أَيَّها هُوَ غامِزُ",4,"ز",1,0],["فمظهر من تلقاه من أهل رامة","يرجح ان تختار في الحلف للحنث",5,"ث",1,0],["فَمظهر الفضل وَالإِنصاف راحتُه","وَرَأيُه حبذاك المجد كَم خصما",6,"م",2,0],["فمظاهر للسعد ما بين الملا","كثرت وآمال بشخصك وأكثرُ",7,"ر",1,0],["فمظلوم ومقتول وعاد","بقوته يحاذر أن يهونا",8,"ن",2,0],["فمظهرة للخلق مجلى هداية","وظل سحاب للورى ووقاية",9,"ه",1,0],["فمظاهرُ الحبِّ الجليِّ صلاتُنا","وسلامُنا عندَ الغَداةِ وبالعِشَا",10,"ش",2,0]]}