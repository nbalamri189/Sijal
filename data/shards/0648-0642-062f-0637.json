{"poems":[[53,"غزال ماطل ديني","https://www.aldiwan.net/poem29739.html","الهزج"],[53,"ضربن إلينا خدودا وساما","https://www.aldiwan.net/poem29807.html","المتقارب"],[63,"سرت والليل يرمز بالصباح","https://www.aldiwan.net/poem46156.html","الوافر"],[3,"دعني أجد إلى العلياء في الطلب","https://www.aldiwan.net/poem131.html",""],[77,"لنا في الفخر أسنمة مطلة","https://www.aldiwan.net/poem36334.html","الوافر"],[77,"أما وخيال في المنام يزور","https://www.aldiwan.net/poem36492.html","الطويل"],[9,"أتهجر غانية أم تلم","https://www.aldiwan.net/poem21984.html","المتقارب"],[0,"أرانا موضعين لأمر غيب","https://www.aldiwan.net/poem60.html","الوافر"],[88,"قرأت وما غير الطبيعة من سفر","https://www.aldiwan.net/poem45075.html","الطويل"],[27,"عشية أعلى مذنب الجوف قادني","https://www.aldiwan.net/poem5953.html","الطويل"],[37,"وقد طال ما يا آل مروان ألتم","https://www.aldiwan.net/poem7435.html","الطويل"],[47,"ولي منة في رقاب الضباب","https://www.aldiwan.net/poem25271.html","المتقارب"],[72,"أرى الشعراء مضوا سوقة","https://www.aldiwan.net/poem18597.html","المتقارب"],[72,"رمى حشاي ويا شوقي إلى الرامي","https://www.aldiwan.net/poem19676.html","البسيط"],[51,"مطايب عيش زايلته مخابثه","https://www.aldiwan.net/poem9226.html","الطويل"],[51,"ألا قل لذي العطن الواسع","https://www.aldiwan.net/poem65403.html","المتقارب"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[51,"شربت وقد كان الشباب محللا","https://www.aldiwan.net/poem66057.html","الطويل"],[26,"أبالصرم من أسماء حدثك الذي","https://www.aldiwan.net/poem24096.html","الطويل"],[70,"علا حس النواعير","https://www.aldiwan.net/poem42906.html","الهزج"],[78,"مجن حكى صانعوه السماء","https://www.aldiwan.net/poem14057.html","المتقارب"],[43,"أجاب دمعي وما الداعي سوى طلل","https://www.aldiwan.net/poem9943.html","البسيط"],[45,"إذا عرضت أحداج سلمى فنادها","https://www.aldiwan.net/poem63485.html","الطويل"],[45,"لما وصلت أسماء من حبلنا شكر","https://www.aldiwan.net/poem63563.html","الطويل"],[61,"سحابك في السماح لها انسجام","https://www.aldiwan.net/poem51440.html","البسيط"],[66,"أيا ابن الكرام الكماة الحماة","https://www.aldiwan.net/poem39059.html","المتقارب"],[80,"أعطيت حكمك في الأيام فاحتكم","https://www.aldiwan.net/poem31290.html","البسيط"],[80,"أبى الله إلا أن يكون لك النصر","https://www.aldiwan.net/poem31432.html","الطويل"],[44,"فحواك عين على نجواك يا مذل","https://www.aldiwan.net/poem30389.html","البسيط"],[74,"يا ليل وجد بنجد","https://www.aldiwan.net/poem12924.html","المجتث"],[74,"تشفع بعلق للشباب خطير","https://www.aldiwan.net/poem12959.html","الطويل"],[74,"ألا إنها سن تزيد فأنقص","https://www.aldiwan.net/poem12975.html","الطويل"],[81,"وزاهرة المرأى معطرة الشذا","https://www.aldiwan.net/poem61510.html","الطويل"],[52,"لقد كان يصطاد المحبين يوسف","https://www.aldiwan.net/poem26797.html","الطويل"],[52,"لقد شد ملك بني هاشم","https://www.aldiwan.net/poem27156.html","المتقارب"],[52,"ألا عللاني قبل أن يأتي الموت","https://www.aldiwan.net/poem27217.html","الطويل"],[52,"رعين كما شئن الربيع سوارحا","https://www.aldiwan.net/poem27302.html","الطويل"],[67,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[48,"ألا يا جبل المقت الذي","https://www.aldiwan.net/poem62535.html","الهزج"],[50,"أأحزنك الألى ظعنوا فساروا","https://www.aldiwan.net/poem63810.html","الوافر"],[50,"أعادك طيفها وبما يعود","https://www.aldiwan.net/poem63923.html","الوافر"],[46,"لعمري لقد أدلجت والركب خائف","https://www.aldiwan.net/poem22322.html","الطويل"],[46,"قد باشروك بمكروه أديت به","https://www.aldiwan.net/poem22664.html","البسيط"],[8,"ألم تسأل الدار الغداة متى هيا","https://www.aldiwan.net/poem21854.html","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16684","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16637","الطويل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24724","الرمل"],[77,"أما وخيال في المنام يزور","https://www.poetsgate.com/ViewPoem.aspx?id=34134",""],[32,"على الدار التي لبست بلاها","https://www.poetsgate.com/ViewPoem.aspx?id=126",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"]],"verses":[["وَقَد طُلَّ دَمٌ تَطلُ","بُهُ عِندَ الجَديدَينِ",0,"ن",1,0],["وَقَد طَوَّحَ الأَلمَعِيُّ العِنانَ","مِنَ الرَوعِ وَالأَعوَجِيُّ الحِزاما",1,"م",2,0],["وقد طالَ الثّواءُ على الهُوَيْنى","وحَنَّ إِلى مَسارِحِها لِقاحي",2,"ح",2,0],["وَقَد طَلَبتُ مِنَ العَلياءِ مَنزِلَةً","بِصارِمي لا بِأُمّي لا وَلا بِأَبي",3,"ب",2,0],["وَقَدْ طَعَنَ الصِّبَا إِلاَّ ادّكَارٌ","وَقَدْ ذَهَبَ الْهَوَى إلاَّ تَعِلَّهْ",4,"ل",2,0],["وقد طلَعَتْ للرّاحِ في ظُلُماتِهِ","نُجومٌ تُوالي حثّهُنّ بُدورُ",5,"ر",1,0],["وَقَد طُفتُ لِلمالِ آفاقَهُ","عُمانَ فَحِمصَ فَأوريشَلِم",6,"م",1,0],["وَقَد طَوَّفتُ في الآفاقِ حَتّى","رَضيتُ مِنَ الغَنيمَةِ بِالإِيابِ",7,"ب",1,0],["وقد طلعت شمس النهار كأنّها","مليك من الأضواء في عسكر مجر",8,"ر",1,0],["وَقَد طالَ أَبسي قَبلَ ذاكَ مُجاشِعاً","بِحَدراءَ يَلقَونَ الصَواعِقَ وَالأَزلا",9,"ل",2,0],["وقد طال ما يا آل مروان أُلتم","بلا دَمَس أمر العُريب ولا غَمل",10,"ل",1,1],["وَقَد طالَ ماوَرَدَت بِالجِباةِ","وَعاوَدَتِ الماءَ في تَدمُرِ",11,"ر",1,0],["وقد طوبقوا باسمه في القريض","فمنهم شقيٌّ ومنهم سعيد",12,"د",1,0],["وقد طوى نظمك الطائيّ منهزماً","لما برزت بأطراسٍ كأعلام",13,"م",1,0],["وقد طلعتْ باليُمن والسعد كلِّه","لنا والثرى ريَّان تندى مباحِثُهْ",14,"ث",2,0],["وقد طبق الأرضَ إنصافُكم","فعمَّ المطيع مع الخالع",15,"ع",1,0],["وقد طال ما ذادتِ بها غير أنه","أتيح لها رأسٌ من الكيدِ مِصْدَمُ",16,"م",1,0],["وقد طابقَ الشيبُ الكتابَ فحرمتْ","على فيك تحريمين إن كنت مسلما",17,"م",2,0],["وَقَد طُفتُ مِن أَحوالِها وَأَرَدتُها","سِنينَ فَأَخشى بَعلَها أَو أَهابُها",18,"ب",3,0],["وَقَد طابَ لَنا وَقتٌ","صَفا مِن غَيرِ تَكديرِ",19,"ر",1,0],["وَقَد طَوَقوهُ بِذَوب النضار","كَما لَبس الأُفق ثَوب الصَباحِ",20,"ح",1,0],["وَقَد طَرَقتُ فَتاةَ الحَيِّ مُرتَدِياً","بِصاحِبٍ غَيرِ عِزهاةٍ وَلا غَزِلٍ",21,"ل",1,0],["وَقَد طارَدَتهُم بِالثُدَيَّينِ خَيلُهُ","فَباتَت حُماةُ الكُفرِ صَرعى طِرادِها",22,"د",3,0],["وَقَد طَرَفَت عَيناكِ عَينَيَّ لا قَذى","أَصابَهُما مِن عِندِ عَينَيكِ بَل سِحرُ",23,"ر",1,0],["وقد طلبَ الملوكُ مَداكَ شأواً","فَخَامَوا عن مَداكَ وهم كِرامُ",24,"م",1,0],["وَقَد طَبَّقَ الجَوَّ جَهامٌ","أَحاطَ بِهِ مِن جَميعِ الجِهاتِ",25,"ت",1,0],["وقد طويتَ من الطّائيّ ما نَشَرَتْ","من المفاخرِ عنه ألسنُ الأممِ",26,"م",1,0],["وقَد طَمِعوا في الزَّعمِ أن يُثبتوا له","جناحَين يُضْحي مِنهُما وهوَ النّسْرُ",27,"ر",1,0],["وَقَد طَوى الشَوقَ في أَحشائِنا بَقَرٌ","عَينٌ طَوَتهُنَّ في أَحشائِها الكِلَلُ",28,"ل",1,0],["وَقَد طَمى بَحرُ لَيلٍ","لَم يُعقِبِ المَدَّ جَزرا",29,"ر",2,0],["وَقَد طارَحَ السَيفُ اليَراعَ فَأَطرَبا","بِرَجعِ صَليلٍ رائِعٍ وَصَريرِ",30,"ر",1,0],["وَقَد طَلَعَت لِلشَيبِ بيضُ كَواكِبٍ","أُقَلِّبُ فيها ناظِري أَتَخَرَّصُ",31,"ص",1,0],["وَقَد طَرَّفَت بيضَ البَنانِ بِأَسوَدٍ","كَما تَستَمِدُّ المِسكَ أَقلامُ كافورِ",32,"ر",1,0],["وَقَد طالَما نادَوهُ يا قَمَرَ الدُجى","فَلَمّا اِلتَحى نادَوهُ يا نافِخَ الزَقِّ",33,"ق",1,0],["وَقَد طالَ شَوقي إِلى وَجهِهِ","وَضاقَ بِسِرِّيَ صَبري فَباحا",34,"ح",2,0],["وَقَد طالَ ما أَترَعتُ كَأسي مِنَ الصِبا","زَماناً فَقَد عَطَّلتُ كَأسي وَأَفضَيتُ",35,"ت",1,0],["وَقَد طالَما أَجرَيتُ في زَمَنِ الصِبا","وَآمَنَ شَيطاني مِنَ الآنَ أَو تابا",36,"ب",2,0],["وَقَدْ طَلَعَتْ لِبَعْضِهِمُ ذُقُونٌ","ولكِنْ بَعْدَ ما نَتَفُوا ذُقونا",37,"ن",2,0],["وَقَد طَوَّلتُ تَفكيري","فَما أَدري لِما تَصلُح",38,"ح",1,0],["وَقَد طافَت بِأَضبَعِ آلِ كَلبٍ","كَتائِبُنا فَصارَ بِحَيثُ صاروا",39,"ر",3,0],["وَقَد طَفِقَ الوَليدُ يَلومُ فيها","وَأَيَّ الدَهرِ ساعَفَكَ الوَليدُ",40,"د",1,0],["وَقَد طالَ عَهدي بِالشَبابِ وَغَيَّرَتُ","عُهودَ الصِبا لِلحادِثاتِ عُهودُ",41,"د",1,0],["وَقَد طَوَتني كَأَنّي ضَربُ مُنسَرِحٍ","فَيا لَطَيٍّ لِطَيٍّ غَيرِ مُنتَشِرِ",42,"ر",1,0],["وَقَد طالَ عَهدِي بالشّبابِ وَأَهلِهِ","وَلاقَيتُ رَوعاتٍ يُشِبنَ النَواصِيا",43,"ي",2,0],["وقد طالَ فوْق الأرضِ كوْني وشَبَّهَ","تْ ثَغاماً بجَوْني عاذلاتي وعُذّالي",44,"ل",2,0],["وقد طَرَحتْ حوْلَ الفراتِ جِرانَها","إلى نِيلِ مصْرٍ فالوَساعُ بها تَقْطُو",45,"ط",2,0],["وقد طال المِطالُ به","وخفتُ حوادثَ الزمنِ",46,"ن",1,0],["وقد طلعت للريح في ظلماته","نجوم توالي حثهن بدور",47,"ر",1,0],["وقد طالبتها حتى مللنا","مواعدها وأعيانا مناها",48,"ا",3,0],["وَقَدْ طُوِيَتْ أَحْشَاؤُهُ طِيَّةَ الصِّلِّ","وَكَانَ كَثِيراً مَا يَوَد خِطَابَهَا",49,"ه",2,0]]}