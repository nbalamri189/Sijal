,"","https://poetry.dctabudhabi.ae/diwan/poem/141676","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120361","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120195","السريع"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139659",""],[4759,"يعودني اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=204568",""],[4927,"ضياع الحب","https://www.poetsgate.com/ViewPoem.aspx?id=29620",""],[5054,"فديتك","https://www.poetsgate.com/ViewPoem.aspx?id=214799",""],[5131,"مكانَكِ يا نفسُ لا تنطقي","https://www.poetsgate.com/ViewPoem.aspx?id=53814",""],[5136,"أرقت فأيقظت لي صاحباً","https://www.poetsgate.com/ViewPoem.aspx?id=121577",""],[5145,"خليليّ إن لم تسعدا فدعاني","https://www.poetsgate.com/ViewPoem.aspx?id=108058",""],[5183,"حائم المنية","https://www.poetsgate.com/ViewPoem.aspx?id=180264",""],[5183,"إلى الحسنى","https://www.poetsgate.com/ViewPoem.aspx?id=180186",""],[5183,"الطعنة النجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=180183",""],[5219,"المتهمة البريئة","https://www.poetsgate.com/ViewPoem.aspx?id=194914",""],[5246,"تقلب الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=187046",""],[5302,"سأمضي","https://www.poetsgate.com/ViewPoem.aspx?id=200676",""],[5319,"تذكر عزيز ليالينا","https://www.poetsgate.com/ViewPoem.aspx?id=189016",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5431,"رياض العاشقين ...","https://www.poetsgate.com/ViewPoem.aspx?id=207521",""],[5582,"فَما كُنْتُ أَدْرِي أَنْ يَكُونَ سَعِيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=186978",""],[5582,"لِمَنْ مَرْبَعٌ للبُقْعِ فِيهِ نَعِيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=186672",""],[4623,"دعوني فاني لست أخشى من العين (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146684",""],[5785,"ذكرتك وقد فاض دمع الغمام","https://www.poetsgate.com/ViewPoem.aspx?id=131563",""],[5829,"وليس لعاشق عنها حياد","https://www.poetsgate.com/ViewPoem.aspx?id=204665",""],[5894,"كل الحواسد راعوا ما أنا فيه","https://www.poetsgate.com/ViewPoem.aspx?id=131407",""],[5964,"تمكن حب علوة من فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=181308",""],[6003,"عيد الاستقلال","https://www.poetsgate.com/ViewPoem.aspx?id=189045",""],[6167,"غيوم السماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85553&r=&rc=36",""]],"verses":[["وقد طوعوا الدنيا كراء وكبرت","على شارف الآفاق فيها مساجد",0,"د",1,0],["وَقَد طُلَّ دَمٌ تَطلُ","بُهُ عِندَ الجَديدَينِ",1,"ن",1,0],["وَقَد طَوَّحَ الأَلمَعِيُّ العِنانَ","مِنَ الرَوعِ وَالأَعوَجِيُّ الحِزاما",2,"م",2,0],["وقد طالَ الثّواءُ على الهُوَيْنى","وحَنَّ إِلى مَسارِحِها لِقاحي",3,"ح",2,0],["وَقَد طَلَبتُ مِنَ العَلياءِ مَنزِلَةً","بِصارِمي لا بِأُمّي لا وَلا بِأَبي",4,"ب",2,0],["وَقَدْ طَعَنَ الصِّبَا إِلاَّ ادّكَارٌ","وَقَدْ ذَهَبَ الْهَوَى إلاَّ تَعِلَّهْ",5,"ل",2,0],["وقد طلَعَتْ للرّاحِ في ظُلُماتِهِ","نُجومٌ تُوالي حثّهُنّ بُدورُ",6,"ر",1,0],["وَقَد طُفتُ لِلمالِ آفاقَهُ","عُمانَ فَحِمصَ فَأوريشَلِم",7,"م",1,0],["وَقَد طَوَّفتُ في الآفاقِ حَتّى","رَضيتُ مِنَ الغَنيمَةِ بِالإِيابِ",8,"ب",1,0],["وقد طلعت شمس النهار كأنّها","مليك من الأضواء في عسكر مجر",9,"ر",1,0],["وَقَد طالَ أَبسي قَبلَ ذاكَ مُجاشِعاً","بِحَدراءَ يَلقَونَ الصَواعِقَ وَالأَزلا",10,"ل",2,0],["وقد طال ما يا آل مروان أُلتم","بلا دَمَس أمر العُريب ولا غَمل",11,"ل",1,1],["وَقَد طالَ ماوَرَدَت بِالجِباةِ","وَعاوَدَتِ الماءَ في تَدمُرِ",12,"ر",1,0],["وقد طوبقوا باسمه في القريض","فمنهم شقيٌّ ومنهم سعيد",13,"د",1,0],["وقد طوى نظمك الطائيّ منهزماً","لما برزت بأطراسٍ كأعلام",14,"م",1,0],["وقد طلعتْ باليُمن والسعد كلِّه","لنا والثرى ريَّان تندى مباحِثُهْ",15,"ث",2,0],["وقد طبق الأرضَ إنصافُكم","فعمَّ المطيع مع الخالع",16,"ع",1,0],["وقد طال ما ذادتِ بها غير أنه","أتيح لها رأسٌ من الكيدِ مِصْدَمُ",17,"م",1,0],["وقد طابقَ الشيبُ الكتابَ فحرمتْ","على فيك تحريمين إن كنت مسلما",18,"م",2,0],["وَقَد طُفتُ مِن أَحوالِها وَأَرَدتُها","سِنينَ فَأَخشى بَعلَها أَو أَهابُها",19,"ب",3,0],["وَقَد طابَ لَنا وَقتٌ","صَفا مِن غَيرِ تَكديرِ",20,"ر",1,0],["وَقَد طَوَقوهُ بِذَوب النضار","كَما لَبس الأُفق ثَوب الصَباحِ",21,"ح",1,0],["وَقَد طَرَقتُ فَتاةَ الحَيِّ مُرتَدِياً","بِصاحِبٍ غَيرِ عِزهاةٍ وَلا غَزِلٍ",22,"ل",1,0],["وَقَد طارَدَتهُم بِالثُدَيَّينِ خَيلُهُ","فَباتَت حُماةُ الكُفرِ صَرعى طِرادِها",23,"د",3,0],["وَقَد طَرَفَت عَيناكِ عَينَيَّ لا قَذى","أَصابَهُما مِن عِندِ عَينَيكِ بَل سِحرُ",24,"ر",1,0],["وقد طلبَ الملوكُ مَداكَ شأواً","فَخَامَوا عن مَداكَ وهم كِرامُ",25,"م",1,0],["وَقَد طَبَّقَ الجَوَّ جَهامٌ","أَحاطَ بِهِ مِن جَميعِ الجِهاتِ",26,"ت",1,0],["وقد طويتَ من الطّائيّ ما نَشَرَتْ","من المفاخرِ عنه ألسنُ الأممِ",27,"م",1,0],["وقَد طَمِعوا في الزَّعمِ أن يُثبتوا له","جناحَين يُضْحي مِنهُما وهوَ النّسْرُ",28,"ر",1,0],["وَقَد طَوى الشَوقَ في أَحشائِنا بَقَرٌ","عَينٌ طَوَتهُنَّ في أَحشائِها الكِلَلُ",29,"ل",1,0],["وَقَد طَمى بَحرُ لَيلٍ","لَم يُعقِبِ المَدَّ جَزرا",30,"ر",2,0],["وَقَد طارَحَ السَيفُ اليَراعَ فَأَطرَبا","بِرَجعِ صَليلٍ رائِعٍ وَصَريرِ",31,"ر",1,0],["وَقَد طَلَعَت لِلشَيبِ بيضُ كَواكِبٍ","أُقَلِّبُ فيها ناظِري أَتَخَرَّصُ",32,"ص",1,0],["وَقَد طَرَّفَت بيضَ البَنانِ بِأَسوَدٍ","كَما تَستَمِدُّ المِسكَ أَقلامُ كافورِ",33,"ر",1,0],["وَقَد طالَما نادَوهُ يا قَمَرَ الدُجى","فَلَمّا اِلتَحى نادَوهُ يا نافِخَ الزَقِّ",34,"ق",1,0],["وَقَد طالَ شَوقي إِلى وَجهِهِ","وَضاقَ بِسِرِّيَ صَبري فَباحا",35,"ح",2,0],["وَقَد طالَ ما أَترَعتُ كَأسي مِنَ الصِبا","زَماناً فَقَد عَطَّلتُ كَأسي وَأَفضَيتُ",36,"ت",1,0],["وَقَد طالَما أَجرَيتُ في زَمَنِ الصِبا","وَآمَنَ شَيطاني مِنَ الآنَ أَو تابا",37,"ب",2,0],["وَقَدْ طَلَعَتْ لِبَعْضِهِمُ ذُقُونٌ","ولكِنْ بَعْدَ ما نَتَفُوا ذُقونا",38,"ن",2,0],["وَقَد طَوَّلتُ تَفكيري","فَما أَدري لِما تَصلُح",39,"ح",1,0],["وَقَد طافَت بِأَضبَعِ آلِ كَلبٍ","كَتائِبُنا فَصارَ بِحَيثُ صاروا",40,"ر",3,0],["وَقَد طَفِقَ الوَليدُ يَلومُ فيها","وَأَيَّ الدَهرِ ساعَفَكَ الوَليدُ",41,"د",1,0],["وَقَد طالَ عَهدي بِالشَبابِ وَغَيَّرَتُ","عُهودَ الصِبا لِلحادِثاتِ عُهودُ",42,"د",1,0],["وَقَد طَوَتني كَأَنّي ضَربُ مُنسَرِحٍ","فَيا لَطَيٍّ لِطَيٍّ غَيرِ مُنتَشِرِ",43,"ر",1,0],["وَقَد طالَ عَهدِي بالشّبابِ وَأَهلِهِ","وَلاقَيتُ رَوعاتٍ يُشِبنَ النَواصِيا",44,"ي",2,0],["وقد طالَ فوْق الأرضِ كوْني وشَبَّهَ","تْ ثَغاماً بجَوْني عاذلاتي وعُذّالي",45,"ل",2,0],["وقد طَرَحتْ حوْلَ الفراتِ جِرانَها","إلى نِيلِ مصْرٍ فالوَساعُ بها تَقْطُو",46,"ط",2,0],["وقد طال المِطالُ به","وخفتُ حوادثَ الزمنِ",47,"ن",1,0],["وقد طلعت للريح في ظلماته","نجوم توالي حثهن بدور",48,"ر",1,0],["وقد طالبتها حتى مللنا","مواعدها وأعيانا مناها",49,"ا",3,0],["وَقَدْ طُوِيَتْ أَحْشَاؤُهُ طِيَّةَ الصِّلِّ","وَكَانَ كَثِيراً مَا يَوَد خِطَابَهَا",50,"ه",2,0],["وَقَد طَوَقوهُ بِذَوب النُّضارِ","كَما جَلّلَ الأُفقَ ضوءُ الصَّباح",51,"ح",1,0],["وَقَد طالَت صُدودك وَالتَجافي","وَعُمرُ أَخي الهَوى أَبَداً قَصيرُ",52,"ر",1,0],["وقد طوى لك الهوى","قلبا ونعم ما طوى",53,"و",2,0],["وقد طوى في القوم احواله","وعم فيهم بحره المزبد",54,"د",1,0],["وقد طبعت بطينتك المعالي","وحكم الطبع ليس به مراء",55,"ا",2,0],["وقد طلع الهدى من كل وجهٍ","عليكم طلعة تبري العماء",56,"ا",2,0],["وقَد طَالَما أورَت تَبَارِيحَ وَجدِهِ","ولم تَمنَحهُ الوَصلَ إِن مُنِحَ الوَصلُ",57,"ل",1,0],["وقد طلعت كواكبه","بأفْق العزّ والسعدِ",58,"د",1,0],["وَقَد طالَما أَخَّرتَ جَيشاً عَنِ العِدى","وَأَرسَلتَ رَأياً مِثلَ باعِثِهِ صَدقا",59,"ق",2,0],["وَقَد طالَما اِستَنقَذتَ بِالأَمنِ خائِفاً","وَبِالجودِ مِعداماً وَبِالعَفوِ مُجرِما",60,"م",2,0],["وقد طالَ وجدي في ليالٍِ طويلةٍ","لبعدك كانت حين قُربِكَ تَقصُرُ",61,"ر",1,0],["وَقَد طَمَتِ الأَمواجُ واِنتَزَحَ الشَطُّ","بِحارُ عُلومٍ قَد رَوَينا بِفَضلِها",62,"ه",2,0],["وقد طلعت وأنت بها صريعٍ","تقاسمك الأسنة والصفاح",63,"ح",1,0],["وَقد طالَ هَذا الذُلُّ وَالمَوتُ رائِحٌ","وَغادٍ وَيَأتي كُلَّ نَفسٍ حِمامُها",64,"م",3,0],["وقد طَلَّ سلطانُ النَّوى من مَدامِعي","دما لأُسودِ الشوقِ فيه وُلوغ",65,"غ",1,0],["وقد طَوَّلت وصفَها المادِحون","وأقصرُ ما مرَّ فيها التَّمام",66,"م",1,0],["وقد طلب البوار بكل وجه","ولا سيما إذا بذل السماحه",67,"ح",2,0],["وَقَد طَلبوا الدُنيا بِغايةِ جهدهم","كَما جَعلوا في حيّزِ العدمِ الأُخرى",68,"ر",2,0],["وقد طويتْ تلك الليالي بأهلها","فمن جهلَ الأيامَ فليتعلم",69,"م",1,0],["وقد طال لمَّا جالَ في مَعلبِ له","بنظمِ بديعِ الشعرِ فهو مُرَعَّثُ",70,"ث",1,0],["وقد طال المطال فليت شعري","أيحسن أن يقول الناس باحا",71,"ح",2,0],["وَقد طَفَت الأَزهارُ فَوقَ مِياهِهِ","كَحُلمٍ نَقِيِّ اللَونِ يَأتي وَيَعبُرُ",72,"ر",1,0],["وقد طالعْتنا نجومُ المجُونِ","ولا بُدّ واللهِ أن نَمْجُنا",73,"ن",2,0],["وقد طارت قلوبهمُ خُفُوقاً","إلى أن لم تَحصِّنها الصدور",74,"ر",1,0],["وقد طال العذابُ عليَّ فيها","لمَا قَدَّمتُ من بَخسِ ووِزرِ",75,"ر",1,0],["وقد طبخت بنار الله حتى","لقد صارت من النطف النضاح",76,"ح",1,0],["وقد طافت بها خُودٌ رِداحٌ","تُريكَ الرَّوضَ في رَيٍّ وريّا",77,"ي",2,0],["وقد طلعت راياتُهم فتطلّعت","إليها شُعوبٌ أثقَلَتها المغارِم",78,"م",1,0],["وَقَدْ طَهُرَتْ خَلائِقُهُمْ صَفاءً","فَلَمْ تَعْلقْ بِعِرْضِهِم العُيوبُ",79,"ب",1,0],["وَقَد طالَ البِعادُ وَزاد شوقي","إليكَ وعاقَني دهري وأونى",80,"ن",2,0],["وَقَد طارَت قُلوبُ القَومِ مِنّا","وَسَروا الضَربَ بِالبيضَ الخفافِ",81,"ف",1,0],["وَقَدْ طَافَ في الدُّنيا أرِيجُ ثَنائِه","فإنْ لَمْ يَكُنْ خِضْراً فإنَّ ابنَهُ الخِضْرُ",82,"ر",1,1],["وَقَد طالَ بِها عَهدي","وَلَم يَنفَكَّ مِن فِكري",83,"ر",2,0],["وَقَد طَلَعت عَلَينا بِالهَنا قَمَراً","سَناؤُهُ حُجبَ الأَتراح قَد هَتَكا",84,"ك",2,0],["وَقَد طَرَح الأنذال مِن جَمع ودّهِ","كَما يَطرَح الجاني النَواة مِن التَمرَه",85,"ر",2,0],["وقد طوَّلْتُ في الأبياتِ جِدّاً","وإنْ أَدلَلْتُ بالوُدِّ القديم",86,"م",1,0],["وقد طَلّقْنَ من فِرْكٍ دُجَيْلاً","وقد راجَعْنَ دِجلةَ والعِراقا",87,"ق",2,0],["وقد طالَبوني مُرهِقينَ بِرَدِّهِ","فقلتُ لدهرٍ لَجَّ في غُلَوائه",88,"ه",1,1],["وقد طرَّزتها بالمديح مقامةٌ","يعزُّ على ذاك الحريري حريرها",89,"ر",3,0],["وقد طرزت أرض الرياض يد الحيا","وجاد عليها السحب بالويل والطل",90,"ل",1,0],["وقد طالما فتشتُ كل دقيقة","وساءلت عنها كل ذي فكرة ندب",91,"ب",1,0],["وقد طاب الزمان فلا رقيب","يكدر صَفْوَ عيشي بالملام",92,"م",1,0],["وقد طوَّحَتْ من بعد عيسى وبندر","وفَهْدٍ بهاتيك الديار الطوائح",93,"ح",1,0],["وقد طلعتْ رماحُ الخطّ غاباً","جرَتْ أنهاره بيضَ النُصولِ",94,"ل",1,0],["وقد طلعت بعد الفراق بمغرقي","نجوم مشيب إثرها الموت ناجمُ",95,"م",1,0],["وقد طهّر الله أخلاقهُ","فإن تلقهُ تلق فيه العبادا",96,"د",2,0],["وقد طَلَعَ الدِّيباجُ والوشيُ فَوقَها","حَدَائِقَ زَهرٍ فِي الغصونِ نَضِيدا",97,"د",2,0],["وَقَدْ طالَما لاقاهُ قِرْناً مُساوِراً","فَوَشْكَانَ مَا لاقاهُ حِزْباً مُسَلِّما",98,"م",2,0],["وَقَدْ طَمَتْ فَوْقَه أَمواجُ أَبْحُرِهِ","حَتَّى تَيَقَّنَ أَنْ قَدْ غَرَّهُ الآلُ",99,"ل",1,0],["وقد طرحتُ شَنّي","في الزاخر الخضمِّ",100,"م",1,0],["وقد طَلَقَتْ بناتُ الصبرِ منّي","كأني لم أكن للصّبر صِهرا",101,"ر",2,0],["وقد طالما منَّيْتَها الوصلَ مُعرِضاً","وباعدتَها من حيث أنتَ قريبُها",102,"ب",3,0],["وقد طلسمته التدبيرات ما بدا","على كرة التخطيط مجلى الواحديه",103,"ي",2,0],["وقدْ طَوَيْنا الحادِثاتِ كلَّها","تَرَفُّعاً عن شَرْقِنا وغَرْبِنا",104,"ن",2,0],["وقد طوَيْنا بها سِرَّ الطَّريقِ وقد","زِينَتْ بطَيٍّ بمُلْكِ اللهِ مَنْشورِ",105,"ر",1,0],["وقد طرقْنا له الصَّحراءَ عافِيَةً","نَخُبُّ وجداً بتمزيقِ الجَلابيبِ",106,"ب",1,0],["وقدْ طالَ نومُكمْ وما طالَ يومُكمْ","فبتُّم ترونَ كلَّ خصمٍ مُخلَّدا",107,"د",2,0],["وَقَد طالَعَتني يَوم اسفَل عاقِل","كَذوب المُنى لِلسائِلينَ حروم",108,"م",1,0],["وقَدْ طَلَعَتْ شَمْسُ النَّهارِ بعارِضِي","وقَدْ كَانَ لَيْلاً فاحِماً بِسَوادِ",109,"د",1,0],["وَقَد طلبنا فلا نجحٌ ولا ظَفَرٌ","وقد هربنا فلا منجىً ولا عَصَرُ",110,"ر",1,0],["وقد طلبتُ ولكنْ ما ظَفِرتُ به","من الفراقِ الّذي أَمُّوه مُنْتَدَحا",111,"ح",2,0],["وَقَد طَرد الرّدى عنكمْ قِراعي","كما طرح النّدى فيكمْ سحابي",112,"ب",2,0],["وقد طبت في روض المحبة مغرسا","أقول وكم قد قلت في القرب مجلسا",113,"س",2,0],["وقد طاب عيشي من دواهم وطبهم","خذي يا صبا عني أحاديث قربهم",114,"م",1,0],["وَقَد طارَ حَتّى قَرَّ في مَطلَعِ الهُدى","فَسَوداءَهُ حَضرٌ وَأَضلاعُهُ بَدوُ",115,"و",1,0],["وقد طُوِيَتْ من قبلِ أَنْ يَنْطوِي الصِّبا","وقدْ بَلِيَتْ من قبلِ أَثْوَابِها القُشْبِ",116,"ب",1,0],["وقد طُمِسَتْ أَوجهُ المَكْرُمات","وقد عُطِّلَتْ هُجْنُها والصُّرُح",117,"ح",1,0],["وقد طال الزمان وليت شعري","أهل تدرون ما َأضرى وساما",118,"م",2,0],["وقد طفح الوادي جمالاً وبهجة","بما اقترحت فيه الطبيعة من هنا",119,"ا",1,0],["وقد طهرت من الأوزار يا ملكا","مقره في سماء لا بدنياء",120,"ا",2,0],["وَقَد طالَما أَرهَفَت حَدَّ يَراعَتي","فَلَمّا تَعالى الخَطبُ عُدَّت لِصارِمي",121,"م",2,0],["وَقَد طالَما حَدَثَت نَفسي وَعاقَني","تَرَدُّدُها ما بَينَ أَقدِم وَأَحجِمِ",122,"م",1,0],["وَقَد طالَما بِتنا نُغالِطُ أَنفُساً","وَنَبغي مِنَ الأَعلاجِ سَلَّ ضُغونَها",123,"ن",3,0],["وقد طُبَعت على عشقِ المعاني","قلوبُ الغيد مذ وُجدَ السديم",124,"م",1,0],["وَقَد طبَّقَ الآفاقَ عِلماً وَحِكمَةً","وَأَحيى دُرُوسَ العِلمِ وَالشَّرعَ أَفشَاهُ",125,"ا",2,0],["وقد طار نسر الليل للغرب جافلاً","عن الوكر من باز الصباح وطرده",126,"د",2,0],["وقد طال عهدي باكرام ولم أجد","سواك فتى تثنى عليه الاصابع",127,"ع",1,0],["وقد طوَّقني شكراً","على شكرٍ على شكر",128,"ر",1,0],["وَقَد طالَ ذاكَ اللّيلُ بِالصّفوِ وَالهنا","وَبِالأُنسِ ممّا لا نُطيلُ بِهِ الشّرحا",129,"ح",2,0],["وَقَد طيَّبَ الأَسحارَ في عِطر وَدّه","وَعَطَّرَ في أَذكارِهِ حَلَقَ الذّكرِ",130,"ر",1,0],["وقَدْ طَفى ريقُهُ نارَ الحَشا وجَنى","مِنْ خدِّه نَظَري للوَرْدِ وَاِقْتَطفا",131,"ف",2,0],["وَقَد طالَت حَياةٌ أَورَثَتهُ","رِداءَ نُحولِهِ فَرضاً وِردا",132,"د",2,0],["وَقَد طابَ لِلأَسماعِ منهُ شنوفُها","وَقَد بَهَرَ الأَلباب منهُ الفَرائِدُ",133,"د",1,0],["وَقَد طَغوا وَبغَوا إِذ بِالفَسادِ سعَوا","وَلَم يَكُن لهُمُ عَن ذاكَ تَحويلُ",134,"ل",1,0],["وَقَد طَرَقَتني عَبدَةُ اِبنَةُ مَرثَدٍ","هُدُوّاً وَأَصحابي بِذاتِ الحَوافِرِ",135,"ر",1,1],["وقد طال ليلُ بيني وبينكم","فهلا يُرى صبح الوصال مُساعدي",136,"د",2,0],["وقد طارحتها شجناً فلما","بكيت صبابةً أخذت تغني",137,"ن",2,0],["وَقَدْ طَالَ نَوْحِي فِي النَّوَاحِي فَلَمْ يُغْنِ","غَدَوا وَفُؤَادِي مَعْهُمُ حِينَ أنْجَدُوا",138,"د",3,0],["وَقد طال ما أنقذته من مهالكٍ","وَلولاك لَم يبرح أسير هلاكِ",139,"ك",1,0],["وَقَد طلعَت مِن جانبِ الشرقِ بعده","نحوسٌ ومالَت لِلمغيب سعودُ",140,"د",1,0],["وَقَد طالَ ما قَد هذبته نجالها","وَقائعَ منه في العدا وحروبُ",141,"ب",1,0],["وقد طال ما قد كنت رمت اجتماعكم","ولم ارَ من هذا المرام وصولا",142,"ل",2,0],["وقد طَوَى الدَّهْرُ بُرْدَ عُمْري","في نَشْرِ ضُرِّ وطَيِّ نَفْعِ",143,"ع",1,0],["وقد طالما ظلَّتْ بِتَدْبِيرِ أَهْوَجٍ","يَخيبُ مُرَجِّيهِ ويُحرَمُ سائلُهْ",144,"ل",2,0],["وقد طبت قبل على الأمهات","فطب بعد واطرب على ذي البنات",145,"ت",1,0],["وقد طال المطال عليّ حتى","قسى من كثرة الزلاة قلبي",146,"ب",2,0],["وَقَد طَوى إليكا","توكلا عَلَيكا",147,"ك",2,0],["وَقَد طُفتُ لِلمَالِ شَرقَ البِلاَدِ","وغَربيَّهَا وَبَلوتُ الرِّجَالا",148,"ل",2,0],["وَقَد طُبِخَت بِنارِ اللَّهِ حَتّى","لَقَد كانَت مِنَ النُّطفِ النِّضاجِ",149,"ج",1,0],["وَقَدْ طَلَعَتْ خُوصُ الرِّكَابِ كَأَنَّهَا","سُيُوفٌ تَقُدُّ الْبِيدَ مَثْنَى وَمَوْحِدَا",150,"د",2,0],["وقد طلعت شمس الضحى وهو طالع","على شعبه باليُمن والسعد والنالِ",151,"ل",1,0],["وقد طلب ابن صخر يوم قيظٍ","إلى عبد الكلال بأن يكونا",152,"ن",2,0],["وقد طلبت تميمٌ صهرَ جارٍ","لهم منا فأضحوا مبعدينا",152,"ن",2,0],["وقد طَلَّحَتْ زُهْرُ النجومِ منَ السُّرَى","وَرَابَكَ في أجفانها أَثرُ السُّهد",153,"د",1,0],["وقَدْ طَار سِربُ الخيلِ فِي أخرْياتِهمْ","يَردُّ عَلَى أعقْابِهِ كُلَّ سَارِبِ",154,"ب",1,0],["وقد طال ما باتت سليمى ضجيعتي","وبات وسادي ثنى كفٍّ ومعصمِ",155,"م",1,0],["وقد طاب منك الاصل والفرع مثله","فمن طاب اصلا طاب منه فروع",156,"ع",1,0],["وَقَد طاوَلَتهُ النَيِّراتُ فَطالَها","وَأَيُّ امرِئٍ بَعدَ النُجومِ يُطاوِلُه",157,"ل",2,0],["وَقَد طَوَّقُوكَ بِأَطواقِهِم","وَلَكِن إِمامِيُّها الأَفضَلُ",158,"ل",1,0],["وقد طبعت على عَزْمٍ عُرِفْتُ به","يمْلا الفَرائِص حتَّى ليس يُكْتَظَم",159,"م",1,0],["وقد طالما عوّلتُ ثُمَّتَ كلما","شددت رحالي نحوكم ثار ثائرُ",160,"ر",1,0],["وقد طال الزمان وكل يوم","من اللأواء نحسبه سنينا",161,"ن",2,0],["وقد طال تهويم المذاكي فلم تذق","كعادتها سهداً وتطرح الثكلا",162,"ل",2,0],["وقد طبعت فينا على الزهد والتقى","وحسن الوفا والحلم منهُ الطبائع",163,"ع",1,0],["وقد طبق الدنيا علوماً وحكمةً","وذكراً غدا في الشرق والغرب ساريا",164,"ي",2,0],["وَقَد طَمِعَت في حاتِم فَلَعَلَّهُ","بِسَعدِكُمُ يَشتاقُها فَيَزورُها",165,"ر",3,0],["وقد طلق الدنيا فالقت بنفسها","فَلَم يرض مختارا بغير اعتزالها",166,"ل",3,0],["وقد طرد الناسَ عنك الخريفُ","فأَوحشكَ المؤنسُ المقلع",167,"ع",