يد الرغائب عيدا","https://www.aldiwan.net/poem34786.html","الطويل"],[436,"ألا هكذا فليسم للمجد من سما","https://www.aldiwan.net/poem34814.html","الطويل"],[436,"إقبال جدك للإسلام إقبال","https://www.aldiwan.net/poem34829.html","البسيط"],[456,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[456,"لعل لها مع النسرين سرا","https://www.aldiwan.net/poem56198.html","الوافر"],[456,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[480,"ألا ليت شعري ما تقول عظائم الد","https://www.aldiwan.net/poem24527.html","عموديه"],[498,"منهاجنا أوله محبة","https://www.aldiwan.net/poem37753.html","الرجز"],[498,"قد قام ينفخ داعي الصور في الصور","https://www.aldiwan.net/poem37999.html","البسيط"],[498,"جاء البشير ليعقوبي بيوسفه","https://www.aldiwan.net/poem38078.html","البسيط"],[503,"أقلّوا","https://www.aldiwan.net/poem61087.html","الطويل"],[514,"جزى الله أيام الفراق ملامة","https://www.aldiwan.net/poem48613.html","الطويل"],[527,"وفود حبيب أم ورود عهاد","https://www.aldiwan.net/poem37457.html","الطويل"],[549,"من مثلها كنت تخشى أيها الحذر","https://www.aldiwan.net/poem47824.html","البسيط"],[549,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[549,"إذا سارت بنا خوص الركاب","https://www.aldiwan.net/poem48058.html","الوافر"],[556,"سريت ولا رد هناك ولا منع","https://www.aldiwan.net/poem34387.html","الطويل"],[556,"رفعنا إلى أوج العلاء رؤسنا","https://www.aldiwan.net/poem34942.html","الطويل"],[571,"أجيرة بيتي ما لكم بكم السهو","https://www.aldiwan.net/poem3636.html","الطويل"],[573,"لئن كنت من عيني نقلت إلى قلبي","https://www.aldiwan.net/poem2789.html","الطويل"],[583,"لقد سمح الدهر بالمقترح","https://www.aldiwan.net/poem1571.html",""],[585,"ألا يا راكباً قف لي فواقا","https://www.aldiwan.net/poem11557.html","عموديه"]],"verses":[["وَقَد طُلَّ دَمٌ تَطلُ","بُهُ عِندَ الجَديدَينِ",0,"ن",1,0],["وَقَد طَوَّحَ الأَلمَعِيُّ العِنانَ","مِنَ الرَوعِ وَالأَعوَجِيُّ الحِزاما",1,"م",2,0],["وقد طالَ الثّواءُ على الهُوَيْنى","وحَنَّ إِلى مَسارِحِها لِقاحي",2,"ح",2,0],["وَقَد طَلَبتُ مِنَ العَلياءِ مَنزِلَةً","بِصارِمي لا بِأُمّي لا وَلا بِأَبي",3,"ب",2,0],["وَقَدْ طَعَنَ الصِّبَا إِلاَّ ادّكَارٌ","وَقَدْ ذَهَبَ الْهَوَى إلاَّ تَعِلَّهْ",4,"ل",2,0],["وقد طلَعَتْ للرّاحِ في ظُلُماتِهِ","نُجومٌ تُوالي حثّهُنّ بُدورُ",5,"ر",1,0],["وَقَد طُفتُ لِلمالِ آفاقَهُ","عُمانَ فَحِمصَ فَأوريشَلِم",6,"م",1,0],["وَقَد طَوَّفتُ في الآفاقِ حَتّى","رَضيتُ مِنَ الغَنيمَةِ بِالإِيابِ",7,"ب",1,0],["وقد طلعت شمس النهار كأنّها","مليك من الأضواء في عسكر مجر",8,"ر",1,0],["وَقَد طالَ أَبسي قَبلَ ذاكَ مُجاشِعاً","بِحَدراءَ يَلقَونَ الصَواعِقَ وَالأَزلا",9,"ل",2,0],["وقد طال ما يا آل مروان أُلتم","بلا دَمَس أمر العُريب ولا غَمل",10,"ل",1,1],["وَقَد طالَ ماوَرَدَت بِالجِباةِ","وَعاوَدَتِ الماءَ في تَدمُرِ",11,"ر",1,0],["وقد طوبقوا باسمه في القريض","فمنهم شقيٌّ ومنهم سعيد",12,"د",1,0],["وقد طوى نظمك الطائيّ منهزماً","لما برزت بأطراسٍ كأعلام",13,"م",1,0],["وقد طلعتْ باليُمن والسعد كلِّه","لنا والثرى ريَّان تندى مباحِثُهْ",14,"ث",2,0],["وقد طبق الأرضَ إنصافُكم","فعمَّ المطيع مع الخالع",15,"ع",1,0],["وقد طال ما ذادتِ بها غير أنه","أتيح لها رأسٌ من الكيدِ مِصْدَمُ",16,"م",1,0],["وقد طابقَ الشيبُ الكتابَ فحرمتْ","على فيك تحريمين إن كنت مسلما",17,"م",2,0],["وَقَد طُفتُ مِن أَحوالِها وَأَرَدتُها","سِنينَ فَأَخشى بَعلَها أَو أَهابُها",18,"ب",3,0],["وَقَد طابَ لَنا وَقتٌ","صَفا مِن غَيرِ تَكديرِ",19,"ر",1,0],["وَقَد طَوَقوهُ بِذَوب النضار","كَما لَبس الأُفق ثَوب الصَباحِ",20,"ح",1,0],["وَقَد طَرَقتُ فَتاةَ الحَيِّ مُرتَدِياً","بِصاحِبٍ غَيرِ عِزهاةٍ وَلا غَزِلٍ",21,"ل",1,0],["وَقَد طارَدَتهُم بِالثُدَيَّينِ خَيلُهُ","فَباتَت حُماةُ الكُفرِ صَرعى طِرادِها",22,"د",3,0],["وَقَد طَرَفَت عَيناكِ عَينَيَّ لا قَذى","أَصابَهُما مِن عِندِ عَينَيكِ بَل سِحرُ",23,"ر",1,0],["وقد طلبَ الملوكُ مَداكَ شأواً","فَخَامَوا عن مَداكَ وهم كِرامُ",24,"م",1,0],["وَقَد طَبَّقَ الجَوَّ جَهامٌ","أَحاطَ بِهِ مِن جَميعِ الجِهاتِ",25,"ت",1,0],["وقد طويتَ من الطّائيّ ما نَشَرَتْ","من المفاخرِ عنه ألسنُ الأممِ",26,"م",1,0],["وقَد طَمِعوا في الزَّعمِ أن يُثبتوا له","جناحَين يُضْحي مِنهُما وهوَ النّسْرُ",27,"ر",1,0],["وَقَد طَوى الشَوقَ في أَحشائِنا بَقَرٌ","عَينٌ طَوَتهُنَّ في أَحشائِها الكِلَلُ",28,"ل",1,0],["وَقَد طَمى بَحرُ لَيلٍ","لَم يُعقِبِ المَدَّ جَزرا",29,"ر",2,0],["وَقَد طارَحَ السَيفُ اليَراعَ فَأَطرَبا","بِرَجعِ صَليلٍ رائِعٍ وَصَريرِ",30,"ر",1,0],["وَقَد طَلَعَت لِلشَيبِ بيضُ كَواكِبٍ","أُقَلِّبُ فيها ناظِري أَتَخَرَّصُ",31,"ص",1,0],["وَقَد طَرَّفَت بيضَ البَنانِ بِأَسوَدٍ","كَما تَستَمِدُّ المِسكَ أَقلامُ كافورِ",32,"ر",1,0],["وَقَد طالَما نادَوهُ يا قَمَرَ الدُجى","فَلَمّا اِلتَحى نادَوهُ يا نافِخَ الزَقِّ",33,"ق",1,0],["وَقَد طالَ شَوقي إِلى وَجهِهِ","وَضاقَ بِسِرِّيَ صَبري فَباحا",34,"ح",2,0],["وَقَد طالَ ما أَترَعتُ كَأسي مِنَ الصِبا","زَماناً فَقَد عَطَّلتُ كَأسي وَأَفضَيتُ",35,"ت",1,0],["وَقَد طالَما أَجرَيتُ في زَمَنِ الصِبا","وَآمَنَ شَيطاني مِنَ الآنَ أَو تابا",36,"ب",2,0],["وَقَدْ طَلَعَتْ لِبَعْضِهِمُ ذُقُونٌ","ولكِنْ بَعْدَ ما نَتَفُوا ذُقونا",37,"ن",2,0],["وَقَد طَوَّلتُ تَفكيري","فَما أَدري لِما تَصلُح",38,"ح",1,0],["وَقَد طافَت بِأَضبَعِ آلِ كَلبٍ","كَتائِبُنا فَصارَ بِحَيثُ صاروا",39,"ر",3,0],["وَقَد طَفِقَ الوَليدُ يَلومُ فيها","وَأَيَّ الدَهرِ ساعَفَكَ الوَليدُ",40,"د",1,0],["وَقَد طالَ عَهدي بِالشَبابِ وَغَيَّرَتُ","عُهودَ الصِبا لِلحادِثاتِ عُهودُ",41,"د",1,0],["وَقَد طَوَتني كَأَنّي ضَربُ مُنسَرِحٍ","فَيا لَطَيٍّ لِطَيٍّ غَيرِ مُنتَشِرِ",42,"ر",1,0],["وَقَد طالَ عَهدِي بالشّبابِ وَأَهلِهِ","وَلاقَيتُ رَوعاتٍ يُشِبنَ النَواصِيا",43,"ي",2,0],["وقد طالَ فوْق الأرضِ كوْني وشَبَّهَ","تْ ثَغاماً بجَوْني عاذلاتي وعُذّالي",44,"ل",2,0],["وقد طَرَحتْ حوْلَ الفراتِ جِرانَها","إلى نِيلِ مصْرٍ فالوَساعُ بها تَقْطُو",45,"ط",2,0],["وقد طال المِطالُ به","وخفتُ حوادثَ الزمنِ",46,"ن",1,0],["وقد طلعت للريح في ظلماته","نجوم توالي حثهن بدور",47,"ر",1,0],["وقد طالبتها حتى مللنا","مواعدها وأعيانا مناها",48,"ا",3,0],["وَقَدْ طُوِيَتْ أَحْشَاؤُهُ طِيَّةَ الصِّلِّ","وَكَانَ كَثِيراً مَا يَوَد خِطَابَهَا",49,"ه",2,0],["وَقَد طالَت صُدودك وَالتَجافي","وَعُمرُ أَخي الهَوى أَبَداً قَصيرُ",50,"ر",1,0],["وقد طوى لك الهوى","قلبا ونعم ما طوى",51,"و",2,0],["وقد طوى في القوم احواله","وعم فيهم بحره المزبد",52,"د",1,0],["وقد طبعت بطينتك المعالي","وحكم الطبع ليس به مراء",53,"ا",2,0],["وقد طلع الهدى من كل وجهٍ","عليكم طلعة تبري العماء",54,"ا",2,0],["وقَد طَالَما أورَت تَبَارِيحَ وَجدِهِ","ولم تَمنَحهُ الوَصلَ إِن مُنِحَ الوَصلُ",55,"ل",1,0],["وقد طلعت كواكبه","بأفْق العزّ والسعدِ",56,"د",1,0],["وَقَد طالَما أَخَّرتَ جَيشاً عَنِ العِدى","وَأَرسَلتَ رَأياً مِثلَ باعِثِهِ صَدقا",57,"ق",2,0],["وَقَد طالَما اِستَنقَذتَ بِالأَمنِ خائِفاً","وَبِالجودِ مِعداماً وَبِالعَفوِ مُجرِما",58,"م",2,0],["وقد طالَ وجدي في ليالٍِ طويلةٍ","لبعدك كانت حين قُربِكَ تَقصُرُ",59,"ر",1,0],["وَقَد طَمَتِ الأَمواجُ واِنتَزَحَ الشَطُّ","بِحارُ عُلومٍ قَد رَوَينا بِفَضلِها",60,"ه",2,0],["وقد طلعت وأنت بها صريعٍ","تقاسمك الأسنة والصفاح",61,"ح",1,0],["وَقد طالَ هَذا الذُلُّ وَالمَوتُ رائِحٌ","وَغادٍ وَيَأتي كُلَّ نَفسٍ حِمامُها",62,"م",3,0],["وقد طَلَّ سلطانُ النَّوى من مَدامِعي","دما لأُسودِ الشوقِ فيه وُلوغ",63,"غ",1,0],["وقد طَوَّلت وصفَها المادِحون","وأقصرُ ما مرَّ فيها التَّمام",64,"م",1,0],["وقد طلب البوار بكل وجه","ولا سيما إذا بذل السماحه",65,"ح",2,0],["وَقَد طَلبوا الدُنيا بِغايةِ جهدهم","كَما جَعلوا في حيّزِ العدمِ الأُخرى",66,"ر",2,0],["وقد طويتْ تلك الليالي بأهلها","فمن جهلَ الأيامَ فليتعلم",67,"م",1,0],["وقد طال لمَّا جالَ في مَعلبِ له","بنظمِ بديعِ الشعرِ فهو مُرَعَّثُ",68,"ث",1,0],["وقد طال المطال فليت شعري","أيحسن أن يقول الناس باحا",69,"ح",2,0],["وَقد طَفَت الأَزهارُ فَوقَ مِياهِهِ","كَحُلمٍ نَقِيِّ اللَونِ يَأتي وَيَعبُرُ",70,"ر",1,0],["وقد طالعْتنا نجومُ المجُونِ","ولا بُدّ واللهِ أن نَمْجُنا",71,"ن",2,0],["وقد طارت قلوبهمُ خُفُوقاً","إلى أن لم تَحصِّنها الصدور",72,"ر",1,0],["وقد طال العذابُ عليَّ فيها","لمَا قَدَّمتُ من بَخسِ ووِزرِ",73,"ر",1,0],["وقد طبخت بنار الله حتى","لقد صارت من النطف النضاح",74,"ح",1,0],["وقد طافت بها خُودٌ رِداحٌ","تُريكَ الرَّوضَ في رَيٍّ وريّا",75,"ي",2,0],["وقد طلعت راياتُهم فتطلّعت","إليها شُعوبٌ أثقَلَتها المغارِم",76,"م",1,0],["وَقَدْ طَهُرَتْ خَلائِقُهُمْ صَفاءً","فَلَمْ تَعْلقْ بِعِرْضِهِم العُيوبُ",77,"ب",1,0],["وَقَد طالَ البِعادُ وَزاد شوقي","إليكَ وعاقَني دهري وأونى",78,"ن",2,0],["وَقَد طارَت قُلوبُ القَومِ مِنّا","وَسَروا الضَربَ بِالبيضَ الخفافِ",79,"ف",1,0],["وَقَدْ طَافَ في الدُّنيا أرِيجُ ثَنائِه","فإنْ لَمْ يَكُنْ خِضْراً فإنَّ ابنَهُ الخِضْرُ",80,"ر",1,1],["وَقَد طالَ بِها عَهدي","وَلَم يَنفَكَّ مِن فِكري",81,"ي",1,0],["وَقَد طَلَعت عَلَينا بِالهَنا قَمَراً","سَناؤُهُ حُجبَ الأَتراح قَد هَتَكا",82,"ك",2,0],["وَقَد طَرَح الأنذال مِن جَمع ودّهِ","كَما يَطرَح الجاني النَواة مِن التَمرَه",83,"ر",2,0],["وقد طوَّلْتُ في الأبياتِ جِدّاً","وإنْ أَدلَلْتُ بالوُدِّ القديم",84,"م",1,0],["وقد طَلّقْنَ من فِرْكٍ دُجَيْلاً","وقد راجَعْنَ دِجلةَ والعِراقا",85,"ق",2,0],["وقد طالَبوني مُرهِقينَ بِرَدِّهِ","فقلتُ لدهرٍ لَجَّ في غُلَوائه",86,"ه",1,1],["وقد طرَّزتها بالمديح مقامةٌ","يعزُّ على ذاك الحريري حريرها",87,"ر",3,0],["وقد طرزت أرض الرياض يد الحيا","وجاد عليها السحب بالويل والطل",88,"ل",1,0],["وقد طالما فتشتُ كل دقيقة","وساءلت عنها كل ذي فكرة ندب",89,"ب",1,0],["وقد طاب الزمان فلا رقيب","يكدر صَفْوَ عيشي بالملام",90,"م",1,0],["وقد طوَّحَتْ من بعد عيسى وبندر","وفَهْدٍ بهاتيك الديار الطوائح",91,"ح",1,0],["وقد طلعتْ رماحُ الخطّ غاباً","جرَتْ أنهاره بيضَ النُصولِ",92,"ل",1,0],["وقد طلعت بعد الفراق بمغرقي","نجوم مشيب إثرها الموت ناجمُ",93,"م",1,0],["وقد طهّر الله أخلاقهُ","فإن تلقهُ تلق فيه العبادا",94,"د",2,0],["وقد طَلَعَ الدِّيباجُ والوشيُ فَوقَها","حَدَائِقَ زَهرٍ فِي الغصونِ نَضِيدا",95,"د",2,0],["وَقَدْ طالَما لاقاهُ قِرْناً مُساوِراً","فَوَشْكَانَ مَا لاقاهُ حِزْباً مُسَلِّما",96,"م",2,0],["وَقَدْ طَمَتْ فَوْقَه أَمواجُ أَبْحُرِهِ","حَتَّى تَيَقَّنَ أَنْ قَدْ غَرَّهُ الآلُ",97,"ل",1,0],["وقد طرحتُ شَنّي","في الزاخر الخضمِّ",98,"م",1,0],["وقد طَلَقَتْ بناتُ الصبرِ منّي","كأني لم أكن للصّبر صِهرا",99,"ر",2,0],["وقد طالما منَّيْتَها الوصلَ مُعرِضاً","وباعدتَها من حيث أنتَ قريبُها",100,"ب",3,0],["وقد طلسمته التدبيرات ما بدا","على كرة التخطيط مجلى الواحديه",101,"ي",2,0],["وقدْ طَوَيْنا الحادِثاتِ كلَّها","تَرَفُّعاً عن شَرْقِنا وغَرْبِنا",102,"ن",2,0],["وقد طوَيْنا بها سِرَّ الطَّريقِ وقد","زِينَتْ بطَيٍّ بمُلْكِ اللهِ مَنْشورِ",103,"ر",1,0],["وقد طرقْنا له الصَّحراءَ عافِيَةً","نَخُبُّ وجداً بتمزيقِ الجَلابيبِ",104,"ب",1,0],["وقدْ طالَ نومُكمْ وما طالَ يومُكمْ","فبتُّم ترونَ كلَّ خصمٍ مُخلَّدا",105,"د",2,0],["وَقَد طالَعَتني يَوم اسفَل عاقِل","كَذوب المُنى لِلسائِلينَ حروم",106,"م",1,0],["وقَدْ طَلَعَتْ شَمْسُ النَّهارِ بعارِضِي","وقَدْ كَانَ لَيْلاً فاحِماً بِسَوادِ",107,"د",1,0],["وَقَد طلبنا فلا نجحٌ ولا ظَفَرٌ","وقد هربنا فلا منجىً ولا عَصَرُ",108,"ر",1,0],["وقد طلبتُ ولكنْ ما ظَفِرتُ به","من الفراقِ الّذي أَمُّوه مُنْتَدَحا",109,"ح",2,0],["وَقَد طَرد الرّدى عنكمْ قِراعي","كما طرح النّدى فيكمْ سحابي",110,"ي",1,0],["وقد طبت في روض المحبة مغرسا","أقول وكم قد قلت في القرب مجلسا",111,"س",2,0],["وقد طاب عيشي من دواهم وطبهم","خذي يا صبا عني أحاديث قربهم",112,"م",1,0],["وَقَد طارَ حَتّى قَرَّ في مَطلَعِ الهُدى","فَسَوداءَهُ حَضرٌ وَأَضلاعُهُ بَدوُ",113,"و",1,0],["وقد طُوِيَتْ من قبلِ أَنْ يَنْطوِي الصِّبا","وقدْ بَلِيَتْ من قبلِ أَثْوَابِها القُشْبِ",114,"ب",1,0],["وقد طُمِسَتْ أَوجهُ المَكْرُمات","وقد عُطِّلَتْ هُجْنُها والصُّرُح",115,"ح",1,0],["وقد طال الزمان وليت شعري","أهل تدرون ما َأضرى وساما",116,"م",2,0]]}