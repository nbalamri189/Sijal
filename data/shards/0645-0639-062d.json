{"poems":[[132,"يا نفس أنت محادده","https://www.aldiwan.net/poem50643.html","مجزوء الكامل"],[396,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38925","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59736","الكامل"],[3369,"","https://poetry.dctabudhabi.ae/diwan/poem/117044","الرمل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133067","البسيط"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104949","السريع"],[5206,"مسألَة في قراءة القرآن على القبر","https://www.poetsgate.com/ViewPoem.aspx?id=187420",""],[5401,"دايم السيف","https://www.poetsgate.com/ViewPoem.aspx?id=179866",""]],"verses":[["مع حُورِ عِينٍ خُرَّدٍ","بيضٍ حسانٍ ناهِدَهْ",0,"د",2,0],["مع حسن العواقب","وحفظ من بليات",1,"ت",1,0],["مع حالة القراية المعروفة","والصهر والتربية الموصوفة",2,"ه",1,0],["مَع حكمِ عكّاءَ الّتي تزري بِمص","رَ مِنَ العَريشِ لِمنتهى أَسوانِها",3,"ن",3,0],["مع حلمهم فمضاؤهم","لا بالحليم ولا الرؤف",4,"ف",1,0],["مع حفظ مع نصر","بهما الملك يصان",5,"ن",1,0],["مع حور في دار رضوان","في أعلا الجنان",6,"ن",1,0],["مع حذف أولاه إذا لم تكن","علمت أن قد سال واديه",7,"ي",2,0],["مَعَ حُفْرَةٍ حُفِرَتْ لِدَسِّ عِظَامِهِ","طَلَبًا لِفَضْلِ الوَاحِدِ المَنَّانِ",8,"ن",1,0],["مع حروف الضاد ماسك لي خفاره","وقبل لا أختار اصلي استخاره",9,"ر",2,1]]}