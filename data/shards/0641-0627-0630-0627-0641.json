{"poems":[[73,"لا رعى الله ليلتي في بخارى","https://www.aldiwan.net/poem3902.html","الخفيف"],[53,"يا بني السمري لا تجشموني","https://www.aldiwan.net/poem66503.html","الخفيف"],[93,"مهبط الوحي مطلع الأنبياء","https://www.aldiwan.net/poem8724.html","عموديه"],[93,"ليس يدري الهم غير المبتلي","https://www.aldiwan.net/poem9064.html","عموديه"],[87,"أحمدك الله وأطري الأنبياء","https://www.aldiwan.net/poem8099.html","الرمل"],[68,"لن يقضي الحاجات إلا درهم","https://www.aldiwan.net/poem38557.html","الكامل"],[82,"عجبي من سكينتي ووقاري","https://www.aldiwan.net/poem31439.html","الخفيف"],[46,"لطمحت في الإبراق والإرعاد","https://www.aldiwan.net/poem30535.html","الكامل"],[69,"حي بلبيس منزلا في العماره","https://www.aldiwan.net/poem18062.html","الخفيف"],[77,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20987","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54573","الكامل"],[102,"بين ليل وفجر","https://www.poetsgate.com/ViewPoem.aspx?id=50195",""],[93,"أنت","https://www.poetsgate.com/ViewPoem.aspx?id=53420",""],[136,"كتب الآداب همت بها","https://www.aldiwan.net/poem54844.html","المديد"],[164,"اضرب بسيف العزم أَعناق الكرى","https://www.aldiwan.net/poem58719.html","الكامل"],[185,"يا صاحبى قفا على الأطلال","https://www.aldiwan.net/poem58842.html","الكامل"],[240,"خجلت من عطائك الأنواء","https://www.aldiwan.net/poem32200.html","الخفيف"],[275,"سيفي عشقت كما عشقت الحاجبا","https://www.aldiwan.net/poem35456.html","الكامل"],[280,"مرقوم الخد مورده","https://www.aldiwan.net/poem25586.html","المتدارك"],[303,"ورقاء ذات تفجع","https://www.aldiwan.net/poem36852.html","عموديه"],[371,"وصل الكتاب إلى الكثيب","https://www.aldiwan.net/poem17888.html","مجزوء الكامل"],[449,"في إثر سعيد يا أسعد","https://www.aldiwan.net/poem55931.html","عموديه"],[449,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[469,"جزت حد المديح قولاً وفعلا","https://www.aldiwan.net/poem3134.html","عموديه"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138359",""],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18530","الرمل"],[1033,"","https://poetry.dctabudhabi.ae/diwan/poem/18189","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80215","الكامل"],[1206,"","https://poetry.dctabudhabi.ae/diwan/poem/143131","الكامل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113979","الكامل"],[1795,"","https://poetry.dctabudhabi.ae/diwan/poem/198771","الكامل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46439","الوافر"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100887","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74321","الخفيف"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100860","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62897","الكامل"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46019","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91879","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132097","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83486","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120446","الرمل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139470",""],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204248",""],[4815,"في حكمة (السِّر)","https://www.poetsgate.com/ViewPoem.aspx?id=210467",""],[4978,"تشطير بلقيسيات","https://www.poetsgate.com/ViewPoem.aspx?id=177255",""],[5082,"قَبسٌ من ثنيّاتِ الضّياء","https://www.poetsgate.com/ViewPoem.aspx?id=213052",""],[5147,"أنا شيء وكنه هيكلي المشهود","https://www.poetsgate.com/ViewPoem.aspx?id=166689",""],[5351,"تراجيديا","https://www.poetsgate.com/ViewPoem.aspx?id=202052",""],[5376,"لو جادَ غيثُكِ ما مكثْتُ عليلا","https://www.poetsgate.com/ViewPoem.aspx?id=205151",""],[5431,"قبلة الأمس...","https://www.poetsgate.com/ViewPoem.aspx?id=210259",""],[5493,"فيمَ السؤالُ","https://www.poetsgate.com/ViewPoem.aspx?id=211622",""],[5691,"الحبر والورقة","https://www.poetsgate.com/ViewPoem.aspx?id=206386",""],[5997,"عِلْمُ الْبَيَاْن","https://www.poetsgate.com/ViewPoem.aspx?id=214993",""],[6068,"قال العواذل هل نسيت غرامها -20-","https://www.poetsgate.com/ViewPoem.aspx?id=175899",""],[231,"الدنيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79157&r=&rc=31",""]],"verses":[["فَإِذا فاتَني كَريمٌ يُغَدّي","ني تَعشيتُ قُرصَةً مِن شَعيرِ",0,"ر",1,0],["فإذا فارقَتْهُ صَبّ إليها","واعتراه لفقدها كالجنون",1,"ن",1,0],["فَإِذا فاتَنا عَدُوٌّ تَجَنّى","فَأَرانا الأَحبابَ في الأَعداءِ",2,"ا",2,0],["فَإِذا فارَقَتِ الدارُ ضُحىً","لَم تَعُد إِلّا قُبَيلَ الطَفَلِ",3,"ل",1,0],["فَإِذا فاتَكَ تَوفيقُ العَليم","فَاِمتَنِع عَن كُلِّ تَحصيلٍ عَقيم",4,"م",1,0],["فَإِذا فَهِمتَ السِرَّ فيهِ رَأَيتَهُ","ذُخرَ المُؤَمِّلِ نُزهَةَ المُتَأَمِّلِ",5,"ل",1,0],["فإذا فُضَ خاتَمٌ عنه أهْدَت","أرَجَ المِسكِ وهيَ في ثَوبِ نارِ",6,"ر",1,0],["فَإِذا فَضَضتُ مِنَ اللَيالي فُرجَةً","خالَفنَها فَسَدَدنَها بِبِعادِ",7,"د",1,0],["فإذَا فازَ كَفُّ حُرٍّ بِبِرٍّ","فَهْوَ إمَّا بِنَقْضَةٍ أَو نِشَارَهْ",8,"ر",2,0],["فإذا فَوَّقَهُ انْفَلَّ لَهُ","بَينَ صُدَّينِ فُؤادٌ وكَبِد",9,"د",1,0],["فاذا فاذا قُمتَ نادِماً تَنفُضُ الكَفَّ","ينِ مِن حَسرَةٍ فَقُل لا أُبالي",10,"ل",2,0],["فَإِذَا فَعَلْتُمْ فالَّذِي","في الغَيْبِ شَفَّافُ الحِجَابِ",11,"ب",1,0],["فإذا فتى قلق الملامح يختفي","تحت الجراح الحمر والخفقات",12,"ت",1,0],["فإذا فاتنا عدو تجنّى","فأنارانا الأحباب في الأعداء",13,"ا",2,0],["فإِذا فَارقتُها هَملَت","مُقلَتِى بالدَّمعِ مُنتَثِرَه",14,"ر",2,0],["فإذا فتى لم يروِ وجهَ صنيعه","دوني ولا رمق الغنى فاستكثرا",15,"ر",2,0],["فإذا فَقَدنَ زيارَتِي فَهىَ المُنَى","ويَزِيدُهُنَّ بها هَوَى الأَطلالِ",16,"ل",1,0],["فَإِذا فارَقوا بِلادَكَ ظَنّوا","أَنَهُم في بِلادِهِم غُرَباءُ",17,"ا",2,0],["فإذا فتحتُ القلبَ أُبصرُ حاجباً","وإذا فتحتُ الثوبَ أُبصرُ قاضبا",18,"ب",2,0],["فَإذا فَلَقُ الإصْباح بَدا","مَنْ يُنْكِره أَو يَجْحَدُهُ",19,"د",2,0],["فإِذا فرغت فما علي","ك باَن تكفكفَ مدمعي",20,"ع",2,0],["فَإِذا فَنِيَ وَصلُ الحَبي","بِ فَإِن حُسنُ العَهدِ باقِ",21,"ق",1,0],["فإذا فكرت بفقدكما","الفيت حياة لا تحمد",22,"د",1,0],["فإذا في جانب الماء مبيت","قد غدا نزلا لابناء السبيل",23,"ل",1,0],["فإذا فارقته لا عن هلاكٍ","فاض للبين دمعهُ واستهلا",24,"ل",2,0],["فإذا فعلتم نابذين شقاقكم","لافاضل فيكم ولا مفضول",25,"ل",1,0],["فَإِذا فاخَرتُمونا فَاِذكُروا","ما فَعلَنا بِكُمُ يَومَ الجَمَل",26,"ل",1,0],["فَإِذا فَزِعتُ غَدَت بِبِزّي نَهدَةٌ","جَرداءَ مُشرِفَةُ القَذالِ دَؤولُ",27,"ل",1,0],["فَإِذا فَتَكتَ فَعادِلٌ في حُكمِهِ","وَإِذا عَفَوتَ فَمانِحٌ مَأمولا",28,"ل",2,0],["فإذا فرعن ذرى الجبال حسبها","ترمي بأفلاق الصخور صخورها",29,"ر",3,0],["فإذا فعَلتَ فجِدَّ في أمداحِهم","وابكِ المكارمَ فعلَ من لم يفعَلِ",30,"ل",1,0],["فإذا فعَلتَ فإنَّ ذاك قلالَةٌ","في وُدِّ قُربى خيرِ خيرِ المرسلِ",30,"ل",1,0],["فإذا فنون الشعر كانت زينةً","لك عقدها، فيمن غدا تزدان؟",31,"ن",1,0],["فَإِذ أَفرغته في نار خُبرٍ","طَلَبت فَلَم أَجد غَيرَ الدُخان",32,"ن",1,0],["فَإذا فَرَغنا مِنهُمُ فَخِلاَفُنَا","سَهلٌ وَنَحنُ وَأنتُمُ أخَوَانِ",33,"ن",1,0],["فإذا فعلت فعنده أمثالها","فنزال آخر دعوة الفرسان",33,"ن",1,0],["فاذا فى مدارِج الليلِ جسمٌ","شاحب اللَّونِ غامض الأسرارِ",34,"ر",1,0],["فَإِذا فاخرت فَفَخرهم مِنك","وَإِن طاوَلت فَقَدرك كاف",35,"ف",1,0],["فاذا فعلتم كنتم أعلى الورى","كعبا وارسخ في العلى اقداما",36,"م",2,0],["فاذا فَزعتُ اليهمُ نَصَروا","واذا رغبتُ اليهم بَذَلُوا",37,"ل",3,0],["فَإِذا فَطَنتَ فَلا تَرى في خُلقِهِ","مَعنىً إِلى طولِ الحَياةِ يَقودُ",38,"د",1,0],["فإذا فقدت الجدّ فاختر بعده","أن تنتمي لأب شريف كالأدب",39,"ب",1,0],["فإذا فعلت فقد سلمت من الأذى","أو لا فليس سوى المهيمن واق",40,"ق",1,0],["فَإِذا في الثَغرِ جَرحى الأُمرا","مِن بَني زَفسَ تَراءَوا زُمَرا",41,"ر",2,0],["فَإِذا فَعَلتُم كان ما يُرجى لَكُم","وَإِذا تقاعدتُم لحاكم لاحِ",42,"ح",1,0],["فاذا فاتك هذا","لم يكن الا الفناء",43,"ا",2,0],["فإذا في ثبوت علياه فُهنا","سلقتنا بالألسن الأعداء",44,"ا",2,0],["فإذا فتحتهما رأي","ت بيان ذاك بلحظ عين",45,"ن",1,0],["فإذا فضولِيَ قد أغارَ بسيفِهِ","وَجدَ الذي سكنَ الفؤادَ مَلاذا",46,"ذ",2,0],["(فإذا فكرتُ فيه )","راحَ قلبي يتهالَكْ",47,"ك",1,0],["فإذا في سحابةِ النّورِ أغفو","حينَ رفَّتْ سحائبٌ وحمامُ",48,"م",1,0],["فإذا فارقت كيانك نفسي","فارقته الأعوان والنصراء",49,"ا",2,0],["فإذا فنيتُ فشيعوا جسدي","في موضع يخلو من الغيدِ",50,"د",1,0],["فإذا فعلتِ فلا تزيدي لوعتي","إن شئت حفظاً بالودادِ قليلا",51,"ل",2,0],["فإذا فارت المواجع فيها","شطرتني بنظرةٍ خنجرية",52,"ي",2,0],["فإذا فتحتُهما حملتُ مواجعي","سِفرا ثقيلا فوق ظهرِي مُجبَرَةْ",53,"ر",2,0],["فإذا فرِّقْتُما لنْ تنفَعا","أحَداً يرْجوكُما كيْ يرْتَقي",54,"ق",2,0],["فَإِذَاْ فَرَغْتَ مِنَ الْفُصُوْلِ تَوَدّدَاً","فاجْعَلْ بَقَاْيَاْ الرُّوْحَ لِاسْتِشَهاْدِ",55,"د",1,0],["فإذا فعلت فعال بغض واضح","وأفاضتِ الدمع الكذوب بكاها",56,"ا",3,0],["فإذا فتشت عن مبعثها","لم تجد شيئا تخبيه الوكون !",57,"ن",1,0]]}