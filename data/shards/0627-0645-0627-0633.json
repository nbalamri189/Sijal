َا أطرق","https://www.poetsgate.com/ViewPoem.aspx?id=190308",""],[5431,"نزفٌ مفترس...","https://www.poetsgate.com/ViewPoem.aspx?id=208994",""],[5582,"سَقاكِ دِيارَ الظَّاعِنِينَ غَمامُ","https://www.poetsgate.com/ViewPoem.aspx?id=187273",""],[5596,"جودي بحُبك يا هذي ولا تودي","https://www.poetsgate.com/ViewPoem.aspx?id=206380",""],[5596,"الخسارة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=206771",""],[5694,"من العايدين","https://www.poetsgate.com/ViewPoem.aspx?id=132100",""],[5829,"أمانة الكلمة","https://www.poetsgate.com/ViewPoem.aspx?id=189845",""],[5906,"قصدتك يا كريم","https://www.poetsgate.com/ViewPoem.aspx?id=188230",""],[5939,"بسكوتة!","https://www.poetsgate.com/ViewPoem.aspx?id=195175",""],[5956,"أيا نبع الرياء","https://www.poetsgate.com/ViewPoem.aspx?id=193521",""],[5956,"لا تستحقك لا أرضٌ ولا شهبُ","https://www.poetsgate.com/ViewPoem.aspx?id=208505",""],[6102,"ذِكرى الأَمس !!","https://www.poetsgate.com/ViewPoem.aspx?id=184048",""],[6142,"الله ما أسناك يا كوكب","https://www.poetsgate.com/ViewPoem.aspx?id=155677",""],[243,"يا ليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68157&r=&rc=149",""],[5601,"نهر الغضب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65792&r=&rc=131",""],[6324,"سهد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87940&r=&rc=5",""]],"verses":[["أَم أَستَزيدُ لَكُم عُلاً بِمَدائِحي","أَينَ الجِبالُ مِنَ الرُبى وَوِهادِها",0,"د",3,0],["أمّا سياستُكَ التي أحْكَمْتَها","فرمَيْتَ بالتّقْصيرِ أسْطالِيسا",1,"س",2,0],["أَمَّا سُعُودُكَ فَهُوَ دُونَ مُنَازِعٍ","عَقْدٌ بِأَحْكَامِ الْقَضَاءِ مُسَجَّلُ",2,"ل",1,0],["أمَّا سَرِيرَتُهُ وَسِيرَتُهُ فَلَمْ","تَتَخَالَفَا فِي السِّرِّ وَالإعْلاَنِ",3,"ن",1,0],["أما سعودك في الوغى فتكفَّلتْ","بسلامةِ الإسلامِ فاخلُدْ واسْلَمِ",4,"م",1,0],["أَمّا سِبابي فَالعَذابُ عَلَيهِمُ","وَالمَوتُ لِلنَخَباتِ عِندَ قِتالي",5,"ل",2,0],["أمَّا سواد الليل فهو كما ترى","طرف المنام على الدوام سهادِي",6,"د",2,0],["أم استعهدتَ حلمي واغتفاري","أم استكفيتَ حزمي في حَوالي",7,"ل",2,0],["أم استعليتَ عن إتيانِ سوءٍ","فكنْ في ذاك فوقي أو حِيالي",7,"ل",2,0],["أم استفسدتْ ذاك الوفاء ملالَةٌ","فأصبحتَ لا يُثني عليكَ به المُثْني",8,"ن",2,0],["أَما سَمِعتَ بِسُلطانِ شبيهكَ قَد","بَزَّتهُ سودُ خُطوب الدَهر سُلطانا",9,"ن",2,0],["إِمّا سَأَلتَ بِشَخصَينا هُناكَ فَقَد","غابا وَأَمّا خَيالانا فَقَد شَهِدا",10,"د",2,0],["أَمِ اِستَشرَطَتهُ فَخافَت بِأَن","يَظُنُّ بِها أَنَّها واسِعَه",11,"ع",2,0],["أَما سَمِعتَ بِمَن أَضحى لَهُ سَبَبٌ","إِلى النَجاةِ بِحَرفٍ واحِدٍ سَمِعَه",12,"ه",1,0],["أما سمعتِ نداءَ ال","قلبِ الجريحِ تعالي",13,"ل",2,0],["أما سلبتْ منك بُرْدَ الشباب","فهل يُسْتَرَدّ من السالبه",14,"ب",2,0],["أما سليمانُ على ملكِهِ","قدْ قالَ ما لي لا أرى الهُدْهُدا",15,"د",2,0],["أما سمعَتْهُ خيبرُ حين يَهذِي","فَصَدَّتْ عنه تُوجِعه عتابا",16,"ب",2,0],["أمَّا سماسرةُ البلاد فعصبة","عارٌ على أهل البلاد بقاؤها",17,"ا",3,1],["أَما سَمِعتَ بِما قَد شاعَ في مُضَرٍ","وَفي الحَليفَينِ مِن نَجدٍ وَقَحطانِ",18,"ن",1,0],["أَمّا سَرابيلُ دُنياكُم فَضافِيَةٌ","وَما كُسيتُم مِنَ التَقوى سَرابيلا",19,"ل",2,0],["أمِ استُعِيرَتْ من الأراقِمِ فارْ","تَدّتْ عَوَارِيَّها بَنو الرَّقَم",20,"م",1,0],["أَمَّا سُلَيْمى فَما زاغَتْ وَلا عَثَرَتْ","فَالْحُبُّ وَالطُّهْرُ يُمْنَاها وَيُسْراها",21,"ا",3,0],["أما سليمى فلا أدري أدمعتها","تلك التي لمعت لي أم ثناياها",22,"ا",3,0],["أما سلبتْ بُرْدَ الشباب؟","فهل يُستردّ من السالبه",23,"ب",2,0],["أما سمعتم بحادينا وقد سَجَعَت","وُرق الحمائمِ فوق الأيكِ والسَّمُر",24,"ر",1,0],["أما سمعتم جريراً عن هنيدته","يثني يرى أنها في الجودِ غاياتُ",25,"ت",1,0],["أمَا سمعتم لبولاذٍ وأسرتِهِ","أحدوثةً شَرَدت فوضَى مع المَثَلِ",26,"ل",1,0],["أما سد سمعا ويحكم عن زمارة","لراعي غنيمات له ظل يقصب",27,"ب",1,0],["أَما سَهمُنا في بَحرها المِلحُ ماؤُهُ","وَفي نَخلِها العُمِّ الطَوادي جُذُوعُها",28,"ع",3,0],["أَما سَمِعتَ صُدورَ الشَعبِ تَهتِفُ لي","فَالشَعبُ مِلكيَ وَالأَيّامُ أَعواني",29,"ن",2,0],["أَما سَمِعتَ هُبوبَ الريحِ إِنَّ لَهُ","صَدى تَزَحُّفِ أَشباحٍ وَأَكفانِ",29,"ن",1,0],["أَمِ اِستَحقَبَ الشَوقَ الفَؤادُ فَإِنَّني","وَجَدِّكَ مَشعوفٌ بِرَملَةَ موجَعُ",30,"ع",1,0],["أَما ساءَ الْبُدُورَ وَأَنْتَ مِنها","طُلُوعٌ مِنْكَ أَعْقَبَهُ الأُفُولُ",31,"ل",1,0],["أَما سُبَّةٌ أَنْ تَخْذُلا ذا صَبابَةٍ","دَعا وَجْدَهُ الشَّوْقُ الْقَدِيمُ فَلَبّاهُ",32,"ا",2,0],["أم استعذبت باللَه ارتحالا","على عجل ليقترب المزار",33,"ر",1,0],["أما سريرهُ من خانوا فقد فُضحت","وَانماز عن ثابتِ الإيمانِ فاسده",34,"د",2,0],["أمِ اِستهلّ هلالٌ في سماءِ عُلى","أَضحت منازلُه بالسعدِ مُكتنفه",35,"ف",2,0],["أَم اِستام بالإغضاب أن يَستفزّني","لِبادرةٍ لا تستردّ من العطبِ",36,"ب",1,0],["أَما سَمّوكَ فَالإِقبالُ أَرخَهُ","سَعيدُ يُمنِكَ يا مَحمودٌ مَضمونُ",37,"ن",1,0],["أَما سُلالَتُهُ الغَرّا وَبِضعَتُهُ","فَقُل عَلى مَن جَفاهُم بِئسَ وَقعَتُهُ",38,"ت",2,0],["أمّا سديدُ الحَضرتَيْنِ فلم يَزَلْ","بمديحه دون الأنامِ ولوعي",39,"ع",2,0],["أَمّا سُيوفُكَ لِلمَعنى فَتَفهَمُهُ","وَما عَلَيكَ إِذا لَم تَفهَمِ البَقَرُ",40,"ر",1,0],["أمأسُورٌ فؤادُكَ أَمْ فؤادي","ومَسْلُوبٌ رُقادُكَ أَمْ رُقادي",41,"د",2,0],["أَمَّا سواهُم فأبتْ","هُ نَفْسيَ الأَبيَّهْ",42,"ي",2,0],["أما سؤال قصد الرشد حرره","ذو فطنة آخذ للعلم عن عَلَمِ",43,"م",1,0],["أَمِ استهامَتْ هوادِي اللَّيْلِ فاقْتَبَسَتْ","أَمْ هل تَضَلَّلَ حادِي المزنِ فَاقْتَدَحَا",44,"ح",2,0],["إِمَّا سَمَحْتَ بِهِ للجَوِّ يَحْمِلُهُ","طِيباً إِلَى كلِّ رُوحٍ عنكَ يُتْحِفُهُ",45,"ف",2,0],["أما سمعتم أبا اسحاق ينشدكم","يا بعض لبنان قد مزقت اكفاني",46,"ن",2,0],["أم استنامت إلى وعد تزوّقه","مثل الفقاقيع لا يبقى لها أثر",47,"ر",1,0],["أَما سَمِعْتِ قَوْلَهُمْ","في عَتْبِهِمْ نَفْسَكَ لُمْ",48,"م",1,0],["إمّا سألتَ به فلا تسألْ بِهِ","ناياً يناغِي في البَطالة مِزْمَرا",49,"ر",2,0],["أمَا سمعتَ حَمامَ الأيْكِ إذْ صَدَحا","غَنَّى ولمْ يدرِ أنّي بعضُ مَنْ جَرحا",50,"ح",2,1],["أما سمعتم به وهو المحيط بكم","كما لكم هو في القرآن أسمعها",51,"ع",3,0],["أما سمعت الذي فيه المثل سايرْ","حبي معي وعلى حبي أنا دايرْ",52,"ر",1,0],["أم أسلم الشيطان إرث الذي","عن النبي المصطفى يستند",53,"د",1,0],["أما سمعت الله في كتابه","إن كنت تتلوه على صوابه",54,"ه",1,0],["أَمَا سهرتْ عيني لفقد أحبّتي","فمن لم يذقْ طعمَ الكرى كيف يسهد",55,"د",1,0],["أَما سَمعت بِأَن الانكليز رَأوا","أَعماله فَأَقرّوها بِلا جَدَل",56,"ل",1,0],["أما سياسيّاً فلست أبدي","للروس في ذي الحرب غير الودِّ",57,"د",1,0],["أمّا سنانُ سنانٍ عند وَخضَتِه","فلو أحسَّ من الموخوضُ ما وخضا",58,"ض",2,0],["أَما سَمعتم ما حَكاه المَثَلُ","وَما تَقوله الرِجالُ الأولُ",59,"ل",1,0],["أَما سَمعتَ القَوافي","وَما قَرَأتَ المثالا",60,"ل",2,0],["أَما سَمعت ما رَواهُ الراوي","شُهدَ حَديثٍ لِلغَليل راوي",61,"ي",1,0],["أَما سَأَلت اللَّهَ عِندَ المُصطَفى","وَالسُؤل عِندَهُ يُوافى بِالوَفا",62,"ف",2,0],["أما سلموا في حُسن سلمى وإنه","إذا حلَّ في قلب فليس يَحول",63,"ل",1,0],["أما سواها من مُشبهة بها","فنشيدةُ التعذال والتنفيد",64,"د",1,0],["أما سَمِعتَ بأنَّ الريحَ مُرسلةٌ","في الدهرِ كانت هَلاكَ الحيَّ مِن إرَما",65,"م",2,0],["أما ساعة تأتي فتقضى تودعا","ويومٌ يُواتى لا يُريني المَتَاعِبَا",66,"ب",2,0],["أَمْ استَجَارَ بالنَّوى من الهَوى","فَشَفَّهُ هَذا وهذا لَمْ يزَلْ",67,"ل",1,0],["أَما سنوكَ فَبِالإِسعاد أَجمَعِها","في الخَصب وَالرَغد فَوقَ السَهل وَالجَبَلِ",68,"ل",1,0],["أَما سَمعت خبر الطاووس","إِذ باتَ ضَيف اليَوم في الناووس",69,"س",1,0],["أَما سمعتم قصة الحجام","وَملك الأَهواز في الحَمام",70,"م",1,0],["أَما سمعت قصة العَدلين","وأَنَّها صدق بِغَير مَين",71,"ن",1,0],["أَما سمعت قصةَ الظليم","وَفتكه بالناجش المليم",72,"م",1,0],["أَما سمعت خَبَر الغُراب","إِذ خَشي الشر مِن العقاب",73,"ب",1,0],["أم استعارت سناها من توقُّده","إذا هوى يلقِطُ الألبابَ من يده",74,"ه",1,0],["أما سمِعتِ بما قامَ النَعِيُّ به","صمّاءُ صَمَّ لَها يا أسمَ أسماعي",75,"ع",2,0],["أما سمعت نشيد المرّ منفرداً","كبلبل الرّوضة الشّادي على الغصن",76,"ن",1,0],["أما سمعت من الأمثال مطّرداً","أباك أباك والإغراء في الوسط",77,"ط",1,0],["أَمِ اِستَعصَمتِ بِالصَدِّ","أَمِ اِستَعذَبتِ إيلامي",78,"ي",1,0],["أمّا سياستهُ العُظمى فقَد بُنِيَت","على أساسٍ قيومٍ ليس ينهَدِمُ",79,"م",1,0],["أما سهامي فمن اليَعضيد","نحتُّها من غصن خضيد",80,"د",1,0],["أَم أَسكُنُ الجَنَّةَ الَّتي وُعِدَ ال","أبرارُ مَصفوفَةً نَمارِقُها",81,"ق",3,0],["أما سَبَّحت صُمُّ الحصى بيَمينهِ","أما أخبرته الشاةُ عن سُمِّها النَقعِ",82,"ع",1,0],["أم أستزيدك نائلاً ويدي على","من كان يرفضني تفيض أيادي",83,"د",2,0],["أَما سَمِعتُم بِأَحاديثِهِ","شارِدَة في الأَرضِ جَوّالَه",84,"ل",2,0],["أَم استَطالَت بِهِم أَرضٌ لتَقذِفَهُم","إِلى المويزجِ أَو يَدعوهُم البَرَكُ",85,"ك",1,0],["أما سمعتَ بقارونٍ وَمَا جَمَعتْ","كفاه راحَ وراح الذّئب والغَنَمُ",86,"م",1,0],["أم أسفرت سلمى فشق بهاؤها","جنح الدجنة عن صباح خدود",87,"د",1,0],["أم استبدلوا أهل العلى بك منزلا","فساروا إليه أم أبو الموت كبرا",88,"ر",2,0],["أَما سَمعتَ قَولَهُم","إِن مَعَ اليَوم غَدا",89,"د",2,0],["أَمِ اِستَبدلتِ بي وَمَللتِ وَصلي","فبُوحي لي بِهِ وَذَري الخِتالا",90,"ل",2,0],["اما سليمان فما في ظاهر","من فضله وقريضه اخفاء",91,"ا",2,0],["أمّا سُهَيلِي فَهيَ عَن كَفِّيني","في الغربِ سِت أزوامِ باليقينِ",92,"ن",1,0],["أَمَّا سُهَيلِيها فَرَاقِد ستَّه","خُذ وَصفَ مَن ميِّزها ونَعتَه",93,"ه",1,0],["أمَّا سُهَيلَي الجزيرَه قِسهُمَا","وَهيَ على اليَسَارِ ثُمَّ آعرِفهُمَا",94,"م",2,0],["أمَّا سُهَيلُ سَبعةٌ والمَعقِل","وَنصفُ ياتي في القِيَاسِ فَآعقِل",94,"ل",1,0],["أمّا سهيليهَا عليه المعقِل","مَعَ سهيلٍ خُذهُ منِّي وَآعقِل",94,"ل",1,0],["أمَّا سُفَالَه لِمُنَى مَنَاوي","وَرَسم تَختِ مَلكِ زُنبَاوي",95,"ي",1,0],["أمّا سُفَالَه بَندُرُ النُّضَارِ","يَحكُمُهَا الكِلوي فَلاَ تُمَارِ",95,"ر",1,0],["أَمَّا سُهيل فَهُو رقيبُ الذابحِ","إن غابَ ذا يَطلُعُ ذا يا ناصحِي",96,"ي",1,0],["أما سلوى عن حلاك فماله","عندي سبيل في الغرام يرام",97,"م",1,0],["أما سمعت لسان الحال ينشدنا","بيتا مدائحهم فيه لها طنات",98,"ت",1,0],["أم استحالت إلى نومانَ عيشته","من فرط أوهامها أضغاث أحلام",99,"م",1,0],["أم أسفرت وجناتُه فحسبتها","أسنى شهاب في السّماء توقّدا",100,"د",2,0],["أما ساخ من في إثره جاء مُدركاّ","أما ضلّ بالأملاك من كان مُشركا",101,"ك",2,0],["اما سقطت بأم رأسك في لظى","وبما جنيت الرب قد جازاكا",102,"ك",2,0],["أما سمِعتُم قولَ جَدّي فينا","واستعملوا إن رُمتُمُ اليقينا",103,"ن",2,0],["أم أسعدتنا بالبشائر والمنى","أخبارُ عرسٍ للرواةِ صِحاح",104,"ح",1,0],["أما سن بذل النفس في الله حيدرٌ","وأورثه حتى بنيه الاصاغرا",105,"ر",2,0],["أم استدار الخط لما غدت","نقطته مركز ذاك ال