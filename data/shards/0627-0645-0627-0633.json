{"poems":[[53,"هذي المنازل بالغميم فنادها","https://www.aldiwan.net/poem30606.html","الكامل"],[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[93,"تمضي وأنت مضنة الأوطان","https://www.aldiwan.net/poem11245.html","الكامل"],[83,"أللمحة من بارق متبسم","https://www.aldiwan.net/poem54240.html","الكامل"],[27,"لمن الديار رسومهن خوالي","https://www.aldiwan.net/poem5974.html","الكامل"],[72,"قف بالحمى بعد البدور وناد","https://www.aldiwan.net/poem18572.html","الكامل"],[51,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[51,"ألا أيها الموسوم باسم وكنية","https://www.aldiwan.net/poem66404.html","الطويل"],[78,"اقنع بحظك في دنياك ما كانا","https://www.aldiwan.net/poem14235.html","البسيط"],[45,"أما معين على الشوق الذي غريت","https://www.aldiwan.net/poem63500.html","البسيط"],[45,"أبيني لنا أيها الواسعه","https://www.aldiwan.net/poem65134.html","المتقارب"],[49,"ما بال نفسك بالآمال منخدعه","https://www.aldiwan.net/poem62173.html","الكامل"],[97,"بين الضنى والملالِ","https://www.aldiwan.net/poem24398.html","المجتث"],[80,"وعظت بلمتك الشائبه","https://www.aldiwan.net/poem31548.html","المتقارب"],[69,"قولوا لمن غيره منصب","https://www.aldiwan.net/poem28869.html","السريع"],[105,"أعدي النمل خيبر والذبابا","https://www.aldiwan.net/poem44062.html","الوافر"],[102,"أما سماسرة البلاد فعصبة","https://www.aldiwan.net/poem32964.html","الكامل"],[50,"وقائل هات شوقنا فقلت له","https://www.aldiwan.net/poem24571.html","البسيط"],[46,"دع آدما لا شفاه الله من هبل","https://www.aldiwan.net/poem23166.html","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16686","المنسرح"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141930","البسيط"],[98,"سلمى الكورانية","https://www.poetsgate.com/ViewPoem.aspx?id=53904",""],[80,"وُعِظْتُ بلمتك الشائبه وفقد شبيبتك الذاهبَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=3010",""],[123,"متى أقول وقد كلت ركائبنا","https://www.aldiwan.net/poem4084.html","البسيط"],[131,"كانت محل أناس قبلنا فخلوا","https://www.aldiwan.net/poem4247.html","البسيط"],[140,"من علم القلب ما يملى من الغزل","https://www.aldiwan.net/poem58449.html","البسيط"],[158,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[167,"دع الدار بالبحرين تعفو ربوعها","https://www.aldiwan.net/poem1634.html",""],[221,"لبيك يا قلب ماض فيك ناداني","https://www.aldiwan.net/poem39693.html","البسيط"],[247,"أصوت مناد من رميلة تسمع","https://www.aldiwan.net/poem2109.html","الطويل"],[278,"سوى باكيك من ينهى العذول","https://www.aldiwan.net/poem60710.html","الوافر"],[278,"هبوا طيفكم أعدى على النأي مسراه","https://www.aldiwan.net/poem60774.html","الطويل"],[283,"ألا يا ضيف هل وجب الفرار","https://www.aldiwan.net/poem39341.html","الوافر"],[296,"أمده الدمع حتى غاض جائده","https://www.aldiwan.net/poem36819.html","عموديه"],[303,"در أيادي التهاني فتحت صدفه","https://www.aldiwan.net/poem56474.html","البسيط"],[303,"أعيذ صفاء الود من كدر العتب","https://www.aldiwan.net/poem56604.html","الطويل"],[318,"مدحي لذاتك مفروض ومسنون","https://www.aldiwan.net/poem67139.html","البسيط"],[318,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[362,"عدد لكم أن سرت في تشييعي","https://www.aldiwan.net/poem60845.html","الكامل"],[364,"كان الفرنج لهم نون وقد حذفت","https://www.aldiwan.net/poem17203.html","البسيط"],[399,"مقيم في اقترابي وابتعادي","https://www.aldiwan.net/poem46727.html","الوافر"],[399,"وأن كل الحق","https://www.aldiwan.net/poem46958.html","مجزوء الرجز"],[400,"لا توردن على سمعي من الكلم","https://www.aldiwan.net/poem33446.html","البسيط"],[436,"شيما سنا البارق المنهل فالتمحا","https://www.aldiwan.net/poem34813.html","البسيط"],[436,"إن يجر زاكي دم للحمد تتلفه","https://www.aldiwan.net/poem34844.html","البسيط"],[441,"بالله يا نسمات الرند والبان","https://www.aldiwan.net/poem55955.html","عموديه"],[451,"عصابة من لصوص أمنها خطر","https://www.aldiwan.net/poem61283.html","البسيط"],[527,"يا نفسي الأماره","https://www.aldiwan.net/poem37370.html","مجزوء الرجز"],[549,"لو لم يعاجله النوى لتحيرا","https://www.aldiwan.net/poem47806.html","الكامل"],[549,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[556,"يا مؤمنون بأن الله خالقكم","https://www.aldiwan.net/poem34369.html","البسيط"],[556,"كن عادلا في أمورك لا تكن جاير","https://www.aldiwan.net/poem34540.html","المواليا"],[556,"اجتمعوا يا إخوتي واحشدوا","https://www.aldiwan.net/poem34637.html","السريع"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["أَم أَستَزيدُ لَكُم عُلاً بِمَدائِحي","أَينَ الجِبالُ مِنَ الرُبى وَوِهادِها",0,"د",3,0],["أمّا سياستُكَ التي أحْكَمْتَها","فرمَيْتَ بالتّقْصيرِ أسْطالِيسا",1,"س",2,0],["أَمَّا سُعُودُكَ فَهُوَ دُونَ مُنَازِعٍ","عَقْدٌ بِأَحْكَامِ الْقَضَاءِ مُسَجَّلُ",2,"ل",1,0],["أمَّا سَرِيرَتُهُ وَسِيرَتُهُ فَلَمْ","تَتَخَالَفَا فِي السِّرِّ وَالإعْلاَنِ",3,"ن",1,0],["أما سعودك في الوغى فتكفَّلتْ","بسلامةِ الإسلامِ فاخلُدْ واسْلَمِ",4,"م",1,0],["أَمّا سِبابي فَالعَذابُ عَلَيهِمُ","وَالمَوتُ لِلنَخَباتِ عِندَ قِتالي",5,"ي",1,0],["أمَّا سواد الليل فهو كما ترى","طرف المنام على الدوام سهادِي",6,"ي",1,0],["أم استعهدتَ حلمي واغتفاري","أم استكفيتَ حزمي في حَوالي",7,"ي",1,0],["أم استعليتَ عن إتيانِ سوءٍ","فكنْ في ذاك فوقي أو حِيالي",7,"ي",1,0],["أم استفسدتْ ذاك الوفاء ملالَةٌ","فأصبحتَ لا يُثني عليكَ به المُثْني",8,"ي",1,0],["أَما سَمِعتَ بِسُلطانِ شبيهكَ قَد","بَزَّتهُ سودُ خُطوب الدَهر سُلطانا",9,"ن",2,0],["إِمّا سَأَلتَ بِشَخصَينا هُناكَ فَقَد","غابا وَأَمّا خَيالانا فَقَد شَهِدا",10,"د",2,0],["أَمِ اِستَشرَطَتهُ فَخافَت بِأَن","يَظُنُّ بِها أَنَّها واسِعَه",11,"ع",2,0],["أَما سَمِعتَ بِمَن أَضحى لَهُ سَبَبٌ","إِلى النَجاةِ بِحَرفٍ واحِدٍ سَمِعَه",12,"ه",1,0],["أما سمعتِ نداءَ ال","قلبِ الجريحِ تعالي",13,"ل",2,0],["أما سلبتْ منك بُرْدَ الشباب","فهل يُسْتَرَدّ من السالبه",14,"ب",2,0],["أما سليمانُ على ملكِهِ","قدْ قالَ ما لي لا أرى الهُدْهُدا",15,"د",2,0],["أما سمعَتْهُ خيبرُ حين يَهذِي","فَصَدَّتْ عنه تُوجِعه عتابا",16,"ب",2,0],["أمَّا سماسرةُ البلاد فعصبة","عارٌ على أهل البلاد بقاؤها",17,"ا",3,1],["أَما سَمِعتَ بِما قَد شاعَ في مُضَرٍ","وَفي الحَليفَينِ مِن نَجدٍ وَقَحطانِ",18,"ن",1,0],["أَمّا سَرابيلُ دُنياكُم فَضافِيَةٌ","وَما كُسيتُم مِنَ التَقوى سَرابيلا",19,"ل",2,0],["أمِ استُعِيرَتْ من الأراقِمِ فارْ","تَدّتْ عَوَارِيَّها بَنو الرَّقَم",20,"م",1,0],["أَمَّا سُلَيْمى فَما زاغَتْ وَلا عَثَرَتْ","فَالْحُبُّ وَالطُّهْرُ يُمْنَاها وَيُسْراها",21,"ا",3,0],["أما سليمى فلا أدري أدمعتها","تلك التي لمعت لي أم ثناياها",22,"ا",3,0],["أما سلبتْ بُرْدَ الشباب؟","فهل يُستردّ من السالبه",23,"ب",2,0],["أما سمعتم بحادينا وقد سَجَعَت","وُرق الحمائمِ فوق الأيكِ والسَّمُر",24,"ر",1,0],["أما سمعتم جريراً عن هنيدته","يثني يرى أنها في الجودِ غاياتُ",25,"ت",1,0],["أمَا سمعتم لبولاذٍ وأسرتِهِ","أحدوثةً شَرَدت فوضَى مع المَثَلِ",26,"ل",1,0],["أما سد سمعا ويحكم عن زمارة","لراعي غنيمات له ظل يقصب",27,"ب",1,0],["أَما سَهمُنا في بَحرها المِلحُ ماؤُهُ","وَفي نَخلِها العُمِّ الطَوادي جُذُوعُها",28,"ع",3,0],["أَما سَمِعتَ صُدورَ الشَعبِ تَهتِفُ لي","فَالشَعبُ مِلكيَ وَالأَيّامُ أَعواني",29,"ي",1,0],["أَما سَمِعتَ هُبوبَ الريحِ إِنَّ لَهُ","صَدى تَزَحُّفِ أَشباحٍ وَأَكفانِ",29,"ن",1,0],["أَمِ اِستَحقَبَ الشَوقَ الفَؤادُ فَإِنَّني","وَجَدِّكَ مَشعوفٌ بِرَملَةَ موجَعُ",30,"ع",1,0],["أَما ساءَ الْبُدُورَ وَأَنْتَ مِنها","طُلُوعٌ مِنْكَ أَعْقَبَهُ الأُفُولُ",31,"ل",1,0],["أَما سُبَّةٌ أَنْ تَخْذُلا ذا صَبابَةٍ","دَعا وَجْدَهُ الشَّوْقُ الْقَدِيمُ فَلَبّاهُ",32,"ا",2,0],["أم استعذبت باللَه ارتحالا","على عجل ليقترب المزار",33,"ر",1,0],["أما سريرهُ من خانوا فقد فُضحت","وَانماز عن ثابتِ الإيمانِ فاسده",34,"د",2,0],["أمِ اِستهلّ هلالٌ في سماءِ عُلى","أَضحت منازلُه بالسعدِ مُكتنفه",35,"ف",2,0],["أَم اِستام بالإغضاب أن يَستفزّني","لِبادرةٍ لا تستردّ من العطبِ",36,"ب",1,0],["أَما سَمّوكَ فَالإِقبالُ أَرخَهُ","سَعيدُ يُمنِكَ يا مَحمودٌ مَضمونُ",37,"ن",1,0],["أَما سُلالَتُهُ الغَرّا وَبِضعَتُهُ","فَقُل عَلى مَن جَفاهُم بِئسَ وَقعَتُهُ",38,"ت",2,0],["أمّا سديدُ الحَضرتَيْنِ فلم يَزَلْ","بمديحه دون الأنامِ ولوعي",39,"ي",1,0],["أَمّا سُيوفُكَ لِلمَعنى فَتَفهَمُهُ","وَما عَلَيكَ إِذا لَم تَفهَمِ البَقَرُ",40,"ر",1,0],["أمأسُورٌ فؤادُكَ أَمْ فؤادي","ومَسْلُوبٌ رُقادُكَ أَمْ رُقادي",41,"ي",1,0],["أَمَّا سواهُم فأبتْ","هُ نَفْسيَ الأَبيَّهْ",42,"ي",2,0],["أما سؤال قصد الرشد حرره","ذو فطنة آخذ للعلم عن عَلَمِ",43,"م",1,0],["أَمِ استهامَتْ هوادِي اللَّيْلِ فاقْتَبَسَتْ","أَمْ هل تَضَلَّلَ حادِي المزنِ فَاقْتَدَحَا",44,"ح",2,0],["إِمَّا سَمَحْتَ بِهِ للجَوِّ يَحْمِلُهُ","طِيباً إِلَى كلِّ رُوحٍ عنكَ يُتْحِفُهُ",45,"ف",2,0],["أما سمعتم أبا اسحاق ينشدكم","يا بعض لبنان قد مزقت اكفاني",46,"ن",2,0],["أم استنامت إلى وعد تزوّقه","مثل الفقاقيع لا يبقى لها أثر",47,"ر",1,0],["أَما سَمِعْتِ قَوْلَهُمْ","في عَتْبِهِمْ نَفْسَكَ لُمْ",48,"م",1,0],["إمّا سألتَ به فلا تسألْ بِهِ","ناياً يناغِي في البَطالة مِزْمَرا",49,"ر",2,0],["أمَا سمعتَ حَمامَ الأيْكِ إذْ صَدَحا","غَنَّى ولمْ يدرِ أنّي بعضُ مَنْ جَرحا",50,"ح",2,1],["أما سمعتم به وهو المحيط بكم","كما لكم هو في القرآن أسمعها",51,"ع",3,0],["أما سمعت الذي فيه المثل سايرْ","حبي معي وعلى حبي أنا دايرْ",52,"ر",1,0],["أم أسلم الشيطان إرث الذي","عن النبي المصطفى يستند",53,"د",1,0],["أما سمعت الله في كتابه","إن كنت تتلوه على صوابه",54,"ه",1,0]]}