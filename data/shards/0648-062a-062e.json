em.aspx?id=31120",""],[28,"ترى كل منشق القميص كأنما","https://www.poetsgate.com/ViewPoem.aspx?id=21733",""],[99,"أحبكِ لا أدري","https://www.poetsgate.com/ViewPoem.aspx?id=206832",""],[24,"أمِنْ أُمِّ شَدّادٍ رُسُومُ المَنَازِلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10881&r=&rc=22",""],[18,"أليلتنا بذي حسمٍ أنيري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26445&r=&rc=11",""],[66,"تَوِسّدَ في الفَلا أيدي المَطايا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19705&r=&rc=10",""]],"verses":[["وَتَختَلِفُ الأَيّامُ حَتّى تَرى العُلى","عَناءً وَيَغدو ما يَروقُ يَهولُ",0,"ل",1,0],["وَتَخدَعُني وُرقُ الحَمامِ بِشَدوِها","وَرَجعُ زَفيري لِلحَمائِمِ خادِعُ",1,"ع",1,0],["وَتَختَلِفُ الأَمالُ في ثَمَراتِها","إِذا شَرِقَت بِالرَيِّ وَالماءُ واحِدُ",2,"د",1,0],["وَتَخفى بِها الأَمطارُ مِن طولِ ما جَرى","عَليها نَجيعُ الطَعنِ وَالضَربِ سَرمَدا",3,"د",2,0],["وَتَخِذتُكُم لي جُنَّةً فَكَأَنَّما","نَظَرَ العَدُوُّ مَقاتِلي مِن جُنَّتي",4,"ي",1,0],["وَتَخْطِرُ أَحْيانَاً بِبالي مَطامِعٌ","فَيَمْنَعُ عِرْضِي أَنْ يُلابِسَها المَجْدُ",5,"د",1,0],["وتَخْتَفِقُ الراياتُ فيهِ كأنّما","هَفَتْ بحَواشِيها قَوادِمُ طائرِ",6,"ر",1,0],["وتَخْدي بهِمْ خُوصٌ تَخايَلُ في البُرى","إذا اقْتادَهُنّ المَهْمَهُ المُتعَسَّفُ",7,"ف",1,0],["وتَخْطِرُ في نَجيعٍ غِبَّ طَعْنٍ","وَجيعٍ يَسْلُبُ البَطَلَ الشّليلا",8,"ل",2,0],["وتختالُ فيهمْ عَزْمَةٌ نَبَويَّةٌ","إذا الحربُ طاشَتْ وقَّرَتْها أناتُها",9,"ت",3,0],["وَتَخالُ أَنفاسي إِذا رَدَّدتُه","بَينَ الطُلولِ مَحَت نُقوشَ المِبرَدِ",10,"د",1,0],["وتَخاذَلَ الجيْشُ اللُّهامُ وأصْ","بَحَ الأبطالُ بينَ تقاعُدٍ وفِرارِ",11,"ر",1,0],["وتُخْرِجُ منْ بحْرِ الجُفونِ جَواهِرا","تُحاجُ بها مَنْ أنْكرَ الجوْهَرَ الفَرْدا",12,"د",2,0],["وتَخْلُفُ جَوْدَ الغيْثِ إنْ أخْلَفَ الحَيا","وتَكْفُلُ للعافِينَ بالرِّفْقِ والرِّفْدِ",13,"د",1,0],["وتَخْلُفُ فيمَنْ خلّفَتْهُ مُلوكُها","برَعْي الذِّمامِ الحُرِّ والحِفْظِ للعَهْدِ",14,"د",1,0],["وتَخالُ غُصْنَ البانِ فيه عابِدا","ما إنْ يَريمُ رُكوعُهُ وسُجودُهُ",15,"د",2,0],["وَتَخَلَّصَ مِنْ دَرَكِ الْمَهْوَى","فَلْيَفكُكْ عَنْ شُكْرٍ رَقَبَةْ",16,"ه",1,0],["وَتَخْتَرِقُ الأَرْجَاءَ مِنْ طِيبِ ذِكْرِهِ","جنَائِبُ تَحْدُوهَا الصَّبَا وَالْجَنَائِبُ",17,"ب",1,0],["وتَخالُ الأفْقَ ثغْراً قاصِياً","غلَبَ الرّومُ عليْهِ الحَبَشا",18,"ش",2,0],["وَتَخطو عَلى بَردِيَّتَينِ غَذاهُما","أَهاضيبُ رَجّافِ العَشِيّاتِ هاطِلِ",19,"ل",1,0],["وَتَخالُهُم آناً لِفَرطِ خُشوعِهِم","عِندَ المُصَلّى يُنصِتونَ لِقاري",20,"ر",2,0],["وَتَخِذتُم مَوجَ الأَثيرِ بَريداً","حينَ خِلتُم أَنَّ البُروقَ كُسالى",21,"ل",2,0],["وَتَخرُجُ مِنهُ لامِعاتٌ كَأَنَّه","أَكُفٌّ تَلَقّى الفَوزَ عِندَ المَفيضِ",22,"ض",1,0],["وَتُخلِقُ أَثوابُ الصِيا وَتَنَكَّرَت","نَواحٍ مِنَ المَعروفِ كانَت تُقيمُها",23,"م",3,0],["وَتَخَطَّتها العُصورُ فَلَو","نَطَقَت في الكَأسِ بِالكَلِمِ",24,"م",1,0],["وتخفُقُ بالنصر العزيز بنودُهُ","إذا خَفَقَت فيها الصّبا والشمائلُ",25,"ل",1,0],["وتخالها حيناً قذيفة مدفع","فتمرّ صائتة لها أرزام",26,"م",1,0],["وتخفق أحشاؤنا دونه","كما خفقت في الرياح العذب",27,"ب",1,0],["وتخترق الطود الأشم إذا انبرى","وقد وجدت من تحت فنّته نقبا",28,"ب",2,0],["وتخلَّوا عن البلاد وأبقَوا","حرمات تدوسها الأقدام",29,"م",1,0],["وتخطب في الجموع بيوم حَفل","كما خطب النبيّ بيوم حَج",30,"ج",1,0],["وتختبط الهواء بساعدَيها","فتعصف منهما الريح الرخاء",31,"ا",2,0],["وَتَخافُني كومُ اللِقا","حِ وَقَد أَمِنَّ عِداتِيَه",32,"ي",2,0],["وَتَخفِقُ حَولِيَ الراياتُ حُمراً","وَتَتبَعُني الخَضارِمُ مِن نِزارِ",33,"ر",1,0],["وَتَخاذَلَت يَومَ الحَفيظَةِ إِنَّهُم","لَيسوا هُنالِكُمُ مِنَ الأَخيارِ",34,"ر",1,0],["وتخذتها عيناً ترَوّيني غداً","وترى لذي الدارين منجاً منجعي",35,"ع",2,0],["وتخدمه حتَّى النجوم محبَّة","ومن أجل ذا تعزى النجوم إلى عقل",36,"ل",1,0],["وتخيَّفوا رزقي الزَّهيد وما رثوا","عندِي لجوع قبائلٍ وبطون",37,"ن",1,0],["وتخالُ انْسرابهُ في مجاري","هِ افتراعَ الأبكارِ والإغفاءَ",38,"ا",2,0],["وتخطَّته كلُّ بأساءَ لكن","صادمتْ مِن ورائه الأعداءَ",38,"ا",2,0],["وتَخلَّلتَ بالخليل وأضحى","سيبويه لديك رَهْنَ سِباءِ",39,"ا",2,0],["وتخرج من أحكام قومٍ تشدّدوا","فقد جعلوا آلاءهم كالمصائبِ",40,"ب",1,0],["وتُخلِّيني لما أمتاحُهُ","منك فالأشْغال بالحال قيودُ",41,"د",1,0],["وتخفُّ للداعي اللهيف وإن بدا","روعٌ يخف له فطودُك راس",42,"س",1,0],["وتخضب رأسها والوج","ه يشهد أنها خلق",43,"ق",1,0],["وتُخيلك الماءَ النقاحَ كأنه","في فيك مازجه نقيعُ الحنظلِ",44,"ل",1,0],["وتخطَّاك إلى حسْ","سادِ نُعماك الحِمامُ",45,"م",1,0],["وتخفيفٌ عن الإخوان منه","وإنْ هم ثقَّلوا في كل آن",46,"ن",1,0],["وَتَخاذَلَت أَسيافُهُم عَن سَحقِهِ","في حينِ كانَ النَصرُ مِنهُم قابا",47,"ب",2,0],["وَتَخضُبُ بَِلدَمِ راياتِها","وَكانَت تَذُمُّ الَّذي تَصنَعُ",48,"ع",1,0],["وَتَخُطُّ بِالعَجَلاتِ سائِرَةً","في الأَرضِ إِسطارا وَلا تَدري",49,"ر",2,0],["وَتَختَبي هِندٌ فَأَشتقُها","وَأَختَبي عَنها فَأُغريها",50,"ي",3,0],["وَتُخالُ مُدبِرَةً إِذا","ما أَقبَلَت مُستَعجِلَه",51,"ل",2,0],["وتختالُ فيهِ عَروسُ الصَّباحِ","وتمرَحُ نَشْوَى بذاكَ النَّشيدْ",52,"د",1,0],["وَتَخرُّ أَمواجُ الزَّمانِ بهَيْبةٍ","قُدْسِيَّةٍ في يَمِّها المُتَرامي",53,"ي",1,0],["وتخفف ويلات الحيا","ة فان للارزاء حدا",54,"د",2,0],["وَتُخلِفُ بِالنَهيِ البيضَ المَواضي","وَبِالخُلقِ المُثَقَّفَةِ الصِعادا",55,"د",2,0],["وَتَخلُدُ أَم كَزَعمِ القَولِ تَبلى","كَما تَبلى العِظامُ أَوِ الرُفاتُ",56,"ت",1,0],["وَتَخَيَّروا الحَبلَ المَهينَ مَنِيَّةً","لِلَّيثِ يَلفِظُ حَولَهُ الحَوباءَ",57,"ا",2,0],["وَتَخَيَّلتُ مَن تَخَلَّفَ مِنهُمُ","ظَنَّ لَيلَ القِيامِ ذاكَ فَنامَه",58,"م",2,0],["وَتَخَيَّرَ الأَخلاقَ أَحسَنَها لَهُم","وَمَكارِمُ الأَخلاقِ مِنهُ تَعالى",59,"ل",2,0],["وَتَخَيَّروا لِلمِهرَجانِ مَكانَهُ","وَجَعَلتُ مَوضِعَ الاِحتِفاءِ فُؤادي",60,"د",2,0],["وَتَخالُهُ سَلَبَ الوَرى أَحلامَهُم","مِن حِلمِهِ فَهُمُ بِلا أَحلامِ",61,"م",1,0],["وتُخَلِّفُ الباغينَ شأوَكَ في العُلَى","ما بَينَ حَسْرَى في الغُبارِ وظُلَّعِ",62,"ع",1,0],["وتخوضُ منخرقَ الصفوفِ بذُبَّلٍ","سُمْرٍ تثقفهنُّ عُوجُ الأضلُعِ",62,"ع",1,0],["وَتَخطو إِلَيهِ صَبوَتي وَصَبابَتي","وَلَم يَخطُهُ بَثّي وَلَم يَعدُهُ وَجدي",63,"ي",1,0],["وَتَخلِيَةُ الدِيارِ فَلا سَروجٌ","مَحَلٌّ لِلقَويمِ وَلا الفِراغُ",64,"غ",1,0],["وَتَخالُهُ كُسِيَ الخُدودَ نَواعِماً","مَهما تُواصِلُها بِلَحظٍ تَخجَلِ",65,"ل",1,0],["وَتَخَوُّفُ المَصّاصِ أَن يَغشى لَنا","رِجلاً فَماذا يَرهَبُ الحَجّامُ",66,"م",1,0],["وَتَخلَدُ في القَومِ حَتّى يَكونَ","فَعالُكَ أَنجَدَ أَعوانِها",67,"ن",3,0],["وَتَختَمِري عَجلى عَلى ظَهرِ رَسلَةٍ","لَها ثَبَجٌ عاري المَعَدَّينِ كاهِلُه",68,"ل",2,0],["وتَخيَّرْتَ حَلْيَهُنَّ فلم تع","دُ خِيارَ النُّحورِ والأعناقِ",69,"ق",1,0],["وَتَخشى عُيونَ الناسِ أَن يَنظُروا بِها","وَلَم تَخشَ عَينَ اللَهِ وَاللَهُ يَنظُرُ",70,"ر",1,0],["وَتَخَيَّرَ الشُبَهاتِ مَن لَم يَنهَهُ","عَنهُنَّ تَسليمٌ وَلا اِستِسلامُ",71,"م",1,0],["وَتَخطُبُ بَعدَ ذَلِكَ صَفوَ وُدّي","فَهَل يُرضيكَ وُدٌّ مُستَعارُ",72,"ر",1,0],["وَتَخلو مِنكَ أُمنِيَةُ المَعالي","وَيَمحَلُ ذَلِكَ المَرعى الخَصيبُ",73,"ب",1,0],["وَتَخطو إِلى عَبدِ الكَريمِ خُطوبُهُ","وَيُطلَبُ مِنّا اليَومَ غُفرانُ ذَنبِهِ",74,"ب",2,0],["وَتَخفُقُ دونَ مَحمِلِهِ بُنودٌ","كَأَنّي بَعضُ أَملاكِ خَطايا",75,"ا",3,0],["وتخالُها والشمسُ تجلو لونَها","ناراً وألسُنَها اللواحسَ نورا",76,"ر",2,0],["وتخالهمُ فيها ادّرَعوا","بِسَلُوق وقد سَلّوا اليَمنَا",77,"ن",2,0],["وتخذتُ تَجِنّةَ لي وطناً","وهجرتُ صقلّيَةً وطنا",77,"ن",2,0],["وتخوضُ من سَفَهِ الصِّبا مُلَحاً","فتحلّ منك معاقدَ الحِلْمِ",78,"م",1,0],["وتَخشَى عَلَيهِ الخطفَ مِن كلِّ كاسِرٍ","إذا لم تُذِقْهُ الحتفَ كِفّةُ حابِلِ",79,"ل",1,0],["وتخالُ يومَ الطّعْنِ مهجةَ قِرنِهِ","تُجْري السليطَ على السنانِ المُشعَلِ",80,"ل",1,0],["وتخلعُ إن سمِعَتْهُ الحَمامُ","عليها قلائدَ أطواقها",81,"ق",3,0],["وتَخَيّلٌ يُحييكَ في فِكري فذا","مَسْعاكَ في بِرّي ومَحض وِدادي",82,"د",2,0],["وَتَخَلَّفتُ بَعدَهُ في أُناسٍ","أَلبَسوني صَبراً عَلى الحَدَثانِ",83,"ن",1,0],["وَتَخويفي نَوىً عَرُضَت وَطالَت","فَبُعدُ الغايَ مِن حَظِّ العِتاقِ",84,"ق",1,0],["وَتَخَطَّ بَزَّتَهُ فَرُبَّت خَلَّةٍ","في دَرجِ ثَوبِ اللابِسِ المُتَنَوِّقِ",85,"ق",1,0],["وتخاذَلَتْ خُطواتُنا من فَرْط ما","جَدَّ السُرى ، والشدُّ ، والتقريب",86,"ب",1,0],["وَتَخَلَّقتِ لي خَلائِقَ أَعطَت","كِ قِيادي فَما مَلَكتُ اِحتِمالا",87,"ل",2,0],["وَتَخطو عَلى بَردِيَّتَينِ غَذاهُما","سَوائِلُ مِن ذي جَمَّةٍ مُتَحَيِّرِ",88,"ر",1,0],["وَتَخَتَّمَت مِن فَصِّهِ بِغَمامَةٍ","كَفٌّ تَكونُ عَلى السَماحِ سَماءَ",89,"ا",2,0],["وَتَخايَلَت بِهِمِ الجِيادُ كَأَنَّما","شَرِبَت مَعاطِفَ كُلِّ طِرفٍ راحا",90,"ح",2,0],["وَتَخايَلَت عِزّاً بِهِ في عِصمَةٍ","صَحَّت بِها مِن كُلِّ داءٍ ناخِسِ",91,"س",1,0],["وَتَخَلّى عَنكَ إِلّا","أَسَفاً لايَتَخَلّى",92,"ل",2,0],["وتخيَّرِ الأخلاقَ إنّ أجلَّها","ما ليس بالواهي ولا المُتصدِّعِ",93,"ع",1,0],["وتخرجُ ذاتُ الخِدْرِ ما إن تَروعُها","إساءةُ جانٍ أو مَضرّةُ جَارِمِ",94,"م",1,0],["وَتَخدِشُ في وَجهِ الصُدودِ بِزَورَةٍ","يُصَيِّرُ فيها الشَوقُ حُرَّ المُنى عَبدا",95,"د",2,0],["وتخالهنّ بلا رؤو","س حين يُقبلُ ليلهنّه",96,"ن",2,0],["وَتَخالُ كُلَّ قَرارَةٍ","دَمعاً يَحولُ مُوَقَّفا",97,"ف",2,0],["وَتَخالُهُ يَومَ الرِهانِ غَمامَةٌ","خَطَرَت بِريحٍ في غَمائِمَ فُرَّغِ",98,"غ",1,1],["وَتُخرِجُ أَفواهَها أَلسُناً","كَشَقِّ الخَناجِرِ أَغمادَها",99,"د",3,0],["وتَخَالُ الوجوهَ إنْ قابَلَتْه","أَلْبَسَتْهَا ألوانَهَا الحِرْبَاءُ",100,"ا",2,0],["وَتَخْشَى بيوتُ النارِ حَرَّ دُخانِها","وَيَزْدَادُ طُغياناً بها الفُرسُ والهِندُ",101,"د",1,0],["وَتَخَالُ مِن تَحرِيمِ حُرمَتِهِ العِدا","عُزلاً وإن لَبِسُوا السِّلاحَ ومِيلا",102,"ل",2,0],["وتَخْضِبُ الحَلَقَ الماذِيّ من عَلَقٍ","كأنّما صاغَها داودُ من ذَهَب",103,"ب",1,0],["وَتَخافُ تَهدُرُهُ فَتَرفَعُ جَفنَها","فَالدَمعُ بَينَ تَحَدُّرٍ وَتَصَعُّدِ",104,"د",1,0],["وَتَختُمُ ذاكَ بِفَخرٍ عَلَيهِ","بِكِندَةَ فَاِسلَح عَلى كِندَه",105,"د",2,0],["وَتُخبِرُ مَن لاقَيتَ أَنَّكَ صائِمٌ","وَتَغدو بِجَحرٍ مُفطِراً غَيرَ صائِمِ",106,"م",1,0],["وَتَخالُ ما جَمَعَت عَلَي","هِ ثِيابَها ذَهَباً وَعِطرا",107,"ر",2,0],["وَتُخضَب لِحيَةٌ غَدَرَت وَخانَت","بِأَحمَرَ مِن نَجيعِ الجَوفِ آني",108,"ي",1,0],["وَتَخونُهُ الأَيّامُ حَتّى","لا يَرى شَيئاً يَسُرُّه",109,"ر",2,0],["وَتَختَلِفُ الإِنسُ في شَأنِها","وَأَبعِد بِمَن باعَ مِمَّن شَرى",110,"ر",2,0],["وَتَخالُفُ الرُؤَساءِ يَشهَدُ مُقسِماً","إِنَّ المَعاشِرَ ما اِهتَدَت لِصَوابِها",111,"ب",3,0],["وَتَخافُ مِن كَونِ الرَدى وَكَأَنَّهُ","صَيدٌ لِضارِيَةِ الخُطوبِ مُثارُ",112,"ر",1,0],["وَتَخالَفُ الأَهواءُ هَذا مُدَّعٍ","فِعلاً وَذَلِكَ دينُهُ الإِجبارُ",113,"ر",1,0],["وَتَخمَصُ مِن مَطاعِمِها رِجالٌ","لِأَنَّ هُمومَها مِلءُ الصُدورِ",114,"ر",1,0],["وَتَختَلِفُ الأَغراضُ ماءٌ عَلى الصَلى","يُحَمُّ وَماءٌ في الشَمالِ يُغَرَّسُ",115,"س",1,0],["وَتَخالَسوا الغَرَضَ الحَرامَ وَقَد رَأوا","شَعراً كَمُلوِيَةِ الرِياضِ خَليسا",116,"س",2,0],["وَتَخَيَّرَ المَغرورُ طولَ بَقائِهِ","سَفَهاً وَما طولُ البَقاءِ بِطائِلِ",117,"ل",1,0],["وتخونهُ الأنفاسُ وهو رحابةٌ","كم نفَّستْ عن أمّةٍ وبلادِ",118,"د",1,0],["وتخلو بيَ الدارُ عِندَ الغروبِ","وأجلسُ وحدي على بابها",119,"ه",2,0],["وتخوّفوا وَمْضَ الشَّهابِ إذا هوى","وَبُروقَ كلِّ غمامةٍ تتهادى",120,"د",2,0],["وتُخرس الطير بليلٍ شفيف","يروعُ فيه القلبَ أن ينبِضا",121,"ض",2,0],["وتَخالُ أغراسَ المَنونِ أتَتْ بها","عندَ الحَوادثِ أُمّهاتُ رِباعِها",122,"ع",3,0],["وتَخالُ الشِّفارَ في وِرْدِها الكُفْ","فَارَ زاروا مِن الجَحيمِ شَفيرا",123,"ر",2,0],["وتَخالُها عندَ الجَريحِ إذا هَوى","أُمّاً يَقَرّ بها ابْنُها المَنْهوك",124,"ك",1,0],["وَتَخالُ أَنفاسي إِذا رَدَّدتُها","بَينَ الطُلولِ مَحَت نُقوشَ المِبرَدِ",125,"د",1,0],["وَتَخْلِيدُ ذِكْرِ الْمَرءِ بَعْدَ وَفاتِهِ","حَيَاةٌ لَهُ لا مَوْتَ يَلْحَقُها بَعْدُ",126,"د",1,0],["وَتخْطِرُ لا تعْدُو الهُدَى خَطَرَاتُهَا","بِأَزْهَرَ مِنْ غُصْنٍ نَضِيرٍ وَأَمْيَسِ",127,"س",1,0],["وَتَخَلَّفَتْ بَيْنَ الرِّمَالِ مَظِنَّةٌ","لِتَفَجُّرٍ فِي الصَّخْرَةِ الصَّمَّاءِ",128,"ا",2,0],["وَتَخَيَّلَ السَّادَاتُ فِي أَقْوَامِهِمْ","شُعَرَاءَهَا ضَرْباً مِنَ الأُجرَاءِ",128,"ا",2,0],["وَتخَرِّجُ المُتَادِّبِينَ لِيُحْسِنوا","فِي العَيْشِ مَا يُجْدِي مِنَ الأشْغَالِ",129,"ل",1,0],["وتخالها ما قد تجمّد من دم","خلل السنين على يدي جلاّد",130,"د",1,0],["وتخالها إذ صعدت","في الجو مراداً عظام",131,"م",1,0],["وَتَخَلَّصتَ مِنَ الدُنيا الَّتي","طَبقاً تركبُ فيها عَن طَبَق",132,"ق",1,0],["وَتَخرُجُ مِنهُ لامِعاتٌ كَأَنَّها","أَكُفٌّ تَلَقّى الفَوزَ عِندَ المَفيضِ",133,"ض",1,0],["وتَخطَّرتْ مِصْرٌ إلى فَاروُقِها","غَيْداءَ ما شانَ الْجَمالَ إِسَار",134,"ر",1,0],["وَتَخَيَّرْ مِنَ الْخَمائِلِ أَنْدَا","هَا وَرَدِّدْ خِلالَها تَرْدِيدَا",135,"د",2,0],["وَتَخَيَّرْ مِنْ سِحْرِ مَنْفِيسَ سِرّاً","كَتَمَتْهُ الْكُهَّانُ عَهْداً عَهِيدَا",135,"د",2,0],["وتخرج من بحر الجفون جواهرا","تحاجي بها من أذكر الجوهر الفردا",136,"د",2,0],["وتخْتَرِقُ الأرجاءَ من طيبِ ذكرِهِ","جنادِبُ تحْدوها الصّبا والجنائبُ",137,"ب",1,0],["وتَخْشَى الخُلدَ ، مُفزعةً ، نفوساً","وتهواه ، مُكرِّمةً طُباعا",138,"ع",2,0],["وتختلِفُ الدُروبُ وسالكوها","وغايتُها ، دُنوّاً وابتعادا",139,"د",2,0],["وتخمُد جذوةٌ لولا تردِّي","نظاماتٍ لألهبها الرَّجاء",140,"ا",2,0],["وتختارُ محموداً من الذِكرِ خالداً","على العيش مذمومَ المغَبَة مُنكَرا",141,"ر",2,0],["وتَخارَسوا وعَموا فملءُ عُيونِهِمْ","رَمَدٌ ، وملُّ حُلوقِهم إفحام",142,"م",1,0],["وتخطَّت جمرَة الغيضِ إلى","\" وقدةِ \" المَوتِ فزادتها اشتِعالا",143,"ل",2,0],["وتخازَرْنَ والمَعاصِرُ أبصاراً","حِداداً مَلِيئةً بالسّباب",144,"ب",1,0],["وتخلتِ الأقدارُ عن متجبِّرٍ","ملأ البلادَ وأهلَها تنكيلا",145,"ل",2,0],["وَتَخَوُّفُ المَصَّاصِ أَن يَغَشى لنا","رِجْلاً ،فمادا يَرْهَبُ الحَجَّامُ",146,"م",1,0],["وَتخْلَدُ في القَوْمِ حتّى يَكُونَ","فِهَالُكَ أنْجَزَ أعْوَانِهَا",147,"ن",3,0],["وتَخشَى بإلا يُخلِدَ الدّهرُ حُبَّنَا،","وَما كلُّ ما تَخشَى النّفوسُ يَضِيرُهَا",148,"ر",3,0],["وَتَخْلِيَةُ الدّيَارِ، فَلا سَرُوجٌ","مَحَلٌّ للقَوِيمِ، وَلا الفِرَاعُ",149,"ع",1,0],["وَتَخْتَمري عَلى عجلى ظَهرِ رَسْلَةٍ","لِها ثَبَجٌ عَاري الَمعَدَّين كاهِلُهْ",150,"ل",2,0],["وتخطيطُ أكوانٍ وتعميرُ أنجمٍ","ورسمُ زمانٍ مالَهُ مالَهُ شَكلُ",151,"ل",1,0],["وتخطو على بردتينِ غذاهما","أهاضيبُ رجَّافٍ العشياتِ هاطلِ",152,"ل",1,0],["وَتَخْبُو الشُّعْرَيَانِ إِلَى سُهَيْلٍ","يَلُوحُ كَقُمَّة ِ الْجَبَلِ الْكَبِيرِ",153,"ر",1,0],["وتخفقُ دونَ محملهِ بنودٌ","كأنّي بعضُ أملاكِ البَرايا",154,"ا",3,0]]}