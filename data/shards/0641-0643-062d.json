{"poems":[[52,"فك حرا للوجد قيد البكاء","https://www.aldiwan.net/poem27332.html","الخفيف"],[230,"إذا حذرت زمانا لم تستر به","https://www.aldiwan.net/poem51221.html","البسيط"],[260,"نحمد مولانا الذي قد اصطفى","https://www.aldiwan.net/poem35821.html","الرجز"],[430,"أخلاي أن الشوق هبت نواسمه","https://www.aldiwan.net/poem40836.html","الطويل"],[438,"سفها بكيت بدمع عين هام","https://www.aldiwan.net/poem2585.html","الكامل"]],"verses":[["فُكَّ حُرّاً لِلوَجدِ قَيدَ البُكاءِ","فَاِعذُريني أَولا فَموتي بِدائي",0,"ا",2,1],["فكُحلُ عينيه ممنوع بِخنْجره","ووردُ خدّيه مَحْمِيّ بعقربه",1,"ب",2,0],["فكحّل الأعينَ من سناها","ففيه للأرواح مشتهاها",2,"ه",2,0],["فكحل بعفو منك قاصر جفنها","فهيهات اني حصي مديحك ناظر",3,"ر",1,0],["فكحاتم في جوده وكأصنف","في الحلم بل عمر ولدى الإقدام",4,"م",1,0]]}