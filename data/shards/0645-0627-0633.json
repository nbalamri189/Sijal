ُ نَشا","تَجلُو صَدى القَلبِ إِلّا وَهوَ مُنشيها",119,"ي",3,0],["مَأْسُورُ آبٍ فَكَّ أَي","لُولٌ لَنا عَنْ أَسْرِهِ",120,"ر",2,0],["مَا سَوَّدَ النَّسْكُ مِنِّي","إلاّ بَياضَ ذُنُوبي",121,"ي",1,0],["ما سار حَولا كاملا","إلا ليسرقَ منك معنى",122,"ن",2,0],["ما سكوتي عن الزمان لعيّ","نقص حالي أشدّ ذمّ الزمان",123,"ن",1,0],["ما سرّني في حاجة","إلا بلانا أو قلانا",124,"ن",2,0],["ما سرّ بالعيد إلا من له جدةٌ","من المياسير أوفي جملة العجم",125,"م",1,0],["ما سويت حكمتي وفلسفتي","وحسن فهمي فلامة القلم",126,"م",1,0],["ما سرّ ضرّ ويوم القصف يتبعه","بعد التنعّم في أعقابه الندم",127,"م",1,1],["ما سميت مفتحا إلا وقد فتحت","فيها المخازي وزال المجد والجود",128,"د",1,0],["ما سببٌ من صروفه عجبٌ","إلا اجتماعٌ لهله سببه",129,"ب",2,0],["ما سرّ أخا لك مسخوطه","تريد أن تؤجر بالماثم",130,"م",1,0],["ما سَبى عَقلي المدام الرَحيقُ","بَل جُفونٌ نَشوانُها لا يفيقُ",131,"ق",1,1],["ماس من التيه في غلائل","بدر بديع الجمال كامل",132,"ل",1,1],["ما سعاد وزينب وسليمى","غير اسما وما عنيت سواك",133,"ك",1,0],["ما سألنا اللحاد يوما عليكم","دلنا عنكمو هنالك طيب",134,"ب",1,0],["ما سرت إلا وطيف منك يبتعنى","كأنني هارب من أسر سجان",135,"ن",1,0],["ما سطا قبلنا على الدهر ساطٍ","يعطم الدهر فاتكات المنون",136,"ن",1,0],["ما ساور الحبّ قلبي تلك مشكلةٌ","أثارها لاغتيابي بعض جيراني",137,"ي",1,0],["ما سرّ حسنك ما جسم يحيط به","ثوبٌ ليدفع عنه فتك أحداقي",138,"ي",1,0],["ما سرارُ القلب مما يعرف","ما ضمير الروح مما يوصف",139,"ف",1,0],["ما سرني شخص اذا","ما مر أهداني سلامه",140,"م",2,0],["ماسَ دلالاً وَرَنا قائِلاً","بيضُ الظُبا وَالسُمرُ من جُندي",141,"ي",1,0],["ما سِرُّكم يستسرُّ بِي وَلَهٌ","منكم إذا قلتُ قد خَفَى ظهرا",142,"ر",2,0],["ما ساءَهُ ما فَعَلتُ إِلّا","لِأَنَّهُ لَم يَكُن وَسيطا",143,"ط",2,0],["ما سَرَّني بَعدَ الشَبابِ مُوَدَّعاً","خَلَفٌ وَلا عِوضٌ مِنَ الأعواضِ",144,"ض",1,0],["ما سَمُحَت وَاللَهِ يا سادَتي","نَفسي بِبَيعِ المِطرَفِ الخَزِّ",145,"ز",1,1],["ما سَمِعَ الناسُ وَلا أَبصَروا","أَلأَمَ نَفساً مِن أَبي جَعفَرِ",146,"ر",1,1],["ما سِرتَ إِلّا وَجَيشٌ","حَولَيكَ مِنها يَسيرُ",147,"ر",1,0],["مَاسَتْ ل