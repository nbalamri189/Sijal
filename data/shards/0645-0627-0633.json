,0],["ما سمعتْ أذنٌ وقد رَّجعتْ","كصوتِها طيباً ولا تَسمعُ",253,"ع",1,0],["ما سوى اللذائذ ل","لحي لو درى أرب",254,"ب",1,0],["ما ساغ شرعا ولا عقلا تمسكنا","بالمخزيات فراجت بيننا سلعا",255,"ع",2,0],["ما سرى الركبُ للمدينة حتى","ناح قلبي بألسيَّر نوح الحمامه",256,"م",2,0],["ما سمعْتُ الواشي ولا عذلَ خِبٍّ","راحَ يروي عنِّي العَجائِبَ ظُلْمَا",257,"م",2,0],["ما سارَ ريحٌ من قِبابِ طُلولِكُمْ","إِلاَّ وراحَ بآهِهِ السَّيَّارِ",258,"ر",1,0],["ما سدّت الطرقاتُ إنّما فُتحتْ","خلا الطريقَ إلى داري فمنغلقُ",259,"ق",1,1],["ما سعتْ بالمُدامِ إلّا أرَتنا","قُضُبَ البانِ في هِضابِ ثَبيرِ",260,"ر",1,0],["ما سَطا الدهرُ علَيهِ وحدَهُ","بل سَطا الدَّهرُ عليهِ وَعَلي",261,"ي",1,0],["ماسَ غُصناً وتَبَدَّى","بَدرَ تَمٍّ يَتَلالى",262,"ل",2,0],["ما سُرعةُ الضياءِ","ما البرقُ في السَماء",263,"ا",2,0],["ما سَوَّسَ اللحمُ إلا سيفَ قاتلِهِ","حتَّى انثنَى السيفُ مخزيًّا ومُمْتَهَنَا",264,"ن",2,0],["ما سرّني وكنّ لِي","بأنّ لي حُمْرَ النَّعَمْ",265,"م",1,0],["ما سرّنِي أنّني أحوِي الغِنى وبدا","في كفّ جارِيَ إعسارٌ وإقتارُ",266,"ر",1,0],["ما سرّني أنِّي خرق","تُ إهابَ جسمي وَاِشتَفيتُ",267,"ت",1,0],["ما سمعتم بأن ربي محيط","بجميع الأشياء إنسٍ وجان",268,"ن",1,0],["ما سرت نسمة ومالت غصون","تتثنى على غناء الحمام",269,"م",1,0],["ما سَمعنا براحلٍ أوْحشَ الأح","بابَ عِندَ ارتحالِهِ والأعادي",270,"د",2,0],["ما سَمِعْنا بالبدرِ يَكْملُ في عشرٍ","ولم تَأْتِ أَربعٌ بَعْدَ عَشْر",271,"ر",1,0],["مَا سَارَ وَهْناً رَكْبهُ","إلّا وزَادَ كَرْبُهُ",272,"ب",2,0],["ما سِحْرُ هَارُونَ المُفَرِّق غِيْرُ ما","في مُقْلَتَيْكَ مِنَ الفُتُورِ تَجَمَّعَا",273,"ع",2,0],["مَاستْ فَقِيلَ هِي القَضيبُ الأَمْيدُ","وَرنتْ فَقِيلَ هي الغَزالُ الأَغْيَدُ",274,"د",1,1],["ما سَبانا لِينُ المَعاطِف مِنْهُ","مُذْ تَثنَّى إلَّا وَقَدْ مَاسَ بَانَا",275,"ن",2,0]]}