.net/poem22416.html","الكامل"],[46,"ما جدري أمات صاحبه","https://www.aldiwan.net/poem22597.html","المنسرح"],[46,"سبحان ربك هل يزول كغيره","https://www.aldiwan.net/poem22706.html","الكامل"],[46,"الدهر كالشاعر المقوي ونحن به","https://www.aldiwan.net/poem22944.html","البسيط"],[46,"عش يا ابن آدم عدة الوزن الذي","https://www.aldiwan.net/poem23094.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85473","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85639","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85591","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/66003","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54883","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54716","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54704","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54296","الخفيف"],[106,"تهنئة بوسام","https://www.poetsgate.com/ViewPoem.aspx?id=179504",""],[106,"ذكرى فريد !","https://www.poetsgate.com/ViewPoem.aspx?id=179479",""],[106,"ثغر لا يتبسم","https://www.poetsgate.com/ViewPoem.aspx?id=179422",""],[106,"زيارة طرابلس","https://www.poetsgate.com/ViewPoem.aspx?id=179604",""],[106,"على شاطئ البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179312",""],[106,"انتصار الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179290",""],[106,"شعب واحد ورب واحد","https://www.poetsgate.com/ViewPoem.aspx?id=179304",""],[106,"حي البيان","https://www.poetsgate.com/ViewPoem.aspx?id=179367",""],[100,"حزبية.. ومخبرون","https://www.poetsgate.com/ViewPoem.aspx?id=183586",""],[78,"الخضوع سياسة","https://www.poetsgate.com/ViewPoem.aspx?id=12697",""],[67,"البردة","https://www.poetsgate.com/ViewPoem.aspx?id=14575",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[90,"فلسطين الدامية","https://www.poetsgate.com/ViewPoem.aspx?id=179033",""],[54,"إِنَّ مَنْ ضَنَّ بالكَنِيفِ عَلَى","https://www.poetsgate.com/ViewPoem.aspx?id=14242",""],[3,"مَا دُمْتُ مُرْتَقياً إلى العَلْيَاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10647&r=&rc=2",""]],"verses":[["ما سَرَّني وَقَنا اللِحاظِ تَنوشُني","أَنّي هُناكَ قَتيلُ غَيرِ الأَعيُنِ",0,"ن",1,0],["ما سَوَّغوني بَردَ الماءِ مُذ حَظَروا","عَلَيَّ بَردَ اللَمَي وَالشَوقُ يُظميني",1,"ي",1,0],["ما ساجَلَتكَ مِنَ المَقاوِلِ عُصبَةٌ","إِلّا وَضَلَّ مَقالُها وَغَريمُها",2,"م",3,0],["ما ساعَفَتني اللَيالي بَعدَ بَينِهِمُ","إِلّا بَكَيتُ لَيالينا بِذي سَلَمِ",3,"م",1,0],["ما سَرَّني مِن بَعدِهِ","الأَعواضُ وَالبَدائِلُ",4,"ل",1,0],["ما سَرَّني إِقبالُهُ","فَيَسوءُني إِعراضُهُ",5,"ض",2,0],["ما سِرتَ حَتّى سارَ نَعتُكَ أَوَّلاً","فَسَرَيتَ تَتبَعُهُ وَهَمُّكَ آخِرُ",6,"ر",1,0],["ما سَرَّني أَنَّ القِنانَ تَخَرَّفَت","عَمّا أَصابَت مِن حِجاجِ المَحجَرِ",7,"ر",1,0],["ما ساءَني لَوني وَإِسمُ زَبيبَةٍ","إِذ قَصَّرَت عَن هِمَّتي أَعدائي",8,"ا",2,0],["ما سابَقَ الناسُ يَومَ الفَضلِ مَكرُمَةً","إِلّا بَدَرتُ إِلَيها حَيثُ تُستَبِقُ",9,"ق",1,0],["ما سُمِّيَت قَطُّ إِلاّ هِجتُ أَذكُرُها","كأَنّما أُشعِلَت في قَلبيَ النارُ",10,"ر",1,0],["ماسَت غُصونُ رِماحِهِ وتفتّحَتْ","بشَقائِقِ النّصْرِ العَزيزِ بُنودُهُ",11,"د",2,0],["ما سَوَّدا بَيضاءَ إِلّا بَيَّضا","بِالكاتِبَينِ صَحيفَةَ الإِعجابِ",12,"ب",1,0],["ما سِرُّ سُكانِ الحِمى بِمُذاعِ","عِندي وَلا عَهدُ الهَوى بِمضاعِ",13,"ع",1,1],["ما سَرَّحَ الدَمعَ مِن عَيني وَأَطلَقَهُ","إِلّا اعتِيادُ أَسىً في القَلبِ مَسجونِ",14,"ن",1,0],["ما سُرَّ مَن را بِسُرَّ مَن را","بَل هِيَ بُؤسى لِمَن يَراها",15,"ا",3,0],["ما سارِقُ الدِرعَينِ إِن كُنتَ ذاكِراً","بِذي كَرَمٍ مِنَ الرِجالِ أُوادِعُه",16,"ع",2,1],["ما سَبَّني العَوّامُ إِلّا لِأَنَّهُ","أَخو سَمَكٍ في البَحرِ جارُ التَماسِحِ",17,"ح",1,1],["ما سمِّيت بالسحبِ إلاَّ أنَّها","في أُفقها من خجلةٍ تتسحب",18,"ب",1,0],["ما سرى في الكتاب إلا وأضحى","شغب الدّهرِ آمناً بالكتاب",19,"ب",1,0],["ما سرق المادحون وصفاً","فيك فلا تقطع الأيادي",20,"ي",1,0],["ما سمعنا للأفضل الفرد ثانٍ","حبَّذا في ثنائنا من بديع",21,"ع",1,0],["ما سرّني أنّ الكميت تحثها","نحوي السقاة وأن فوْدي أبلق",22,"ق",1,0],["ما سخنت فيها عيون الورى","حتى تجليت فقرت عيون",23,"ن",1,0],["ما سعى والسعاةُ للمجد إلا","سبقَ المُحْضِرينَ بالتقريبِ",24,"ب",1,0],["ما سرني بَدَلاً بما وفَّرْتهُ","منها مَكانُكَ واصلاً لجناحي",25,"ح",2,0],["ما ساقك الله نحوي","فيما أظن لخيري",26,"ي",1,0],["ما سار مدحكُمُ في الأرض منشمِراً","إلا بعُرفٍ لكم في الناس سيار",27,"ر",1,0],["ما سُخْطُنا لك خُطةً مُسْخُوطةً","تُضحي وأنت بها لنفسك راضي",28,"ض",2,0],["ما سرني اللؤم والغضارة في ال","عيش بديلاً بالمجد والقشف",29,"ف",1,0],["ما سوَّلتْ نفسٌ لصاحبها الغنى","إلا انبريتَ تُصدّقُ التسويلا",30,"ل",2,0],["ما ساءني إعراضُه","عني ولكنْ سرني",31,"ن",2,1],["ما سمعنا فيما سمعنا بأذنٍ","بُليت قبلها بداء اللكون",32,"ن",1,0],["ما ساءَ نَفسي مِنَ الدُنيا سِوى نَفَرٌ","لا خَيرَ فيهِم وَلَكِن شَرُّهُم عَمَمُ",33,"م",1,1],["ما سَرّني وَأحاشي عَصر عَطفِكمُ","يَومَ أَخَلّ في القَنا وَالهامُ نَنتَثِرُ",34,"ر",1,0],["ما سرتُ قَطُّ إِلى القِتا","ل وَكان مِن أَمَلي الرُجوعُ",35,"ع",1,0],["مأسورة ابدا تروح وتغتدى","وهلاكها في أن يفك إسار",36,"ر",1,0],["ما سِوى الحَديثِ بِهِ","يُبتَغى وَيُجتَذَبُ",37,"ب",1,0],["ما سَدِكَت عِلَّةٌ بِمَورودِ","أَكرَمَ مِن تَغلِبَ بنِ داوُّدِ",38,"د",1,1],["ما سَمِعنا بِمَن أَحَبَّ العَطايا","فَاِشتَهى أَن يَكونَ فيها فُؤادُه",39,"د",2,0],["ما سُمتُهُ سَردَ سِوى سِروالِ","وَكَيفَ لا وَإِنَّما إِدلالي",40,"ل",2,0],["ما ساءَني نقصُ جُهَّالٍ تَنَقَّصُني","سيَّانِ عنديَ أنْ يأسوا وأن كَلِمُوا",41,"م",3,0],["ما سَعَوا يَخلُفونَ غَيرَ أَبيهِم","كُلُّ ساعٍ مِنّا يُريدُ نِصابَه",42,"ب",2,0],["ما سَعى في نَقيصَةِ المُلكِ إِلّا","حائِرٌ مُرسَلٌ عَلَيهِ نَكالُه",43,"ل",2,0],["ما سالَها أَحَدٌ سِوايَ خَليفَةً","في الناسِ مَرئِيّاً وَلا مَسموعا",44,"ع",2,0],["ما سَرَّهُ أن ذاعَ من أسرارِه","ما غَيَّبَ الكِتمانُ في إضمارِه",45,"ر",2,1],["ما سَوَّلَتْ لي النَّفسُ هجرَ جَنابِه","عند الرحيل ولا اجتنابَ جِنابِه",46,"ب",2,0],["ما سِلمُ كَفِّكَ إِلّا مَن يُناوِلُها","وَلا عَدُوُّكَ إِلّا مَن يُرَجّيها",47,"ه",2,0],["ما سَهَرُ الوالِهِ مُعطٍ لَهُ","وَصلاً وَلَو داوَمَ طولَ السُهاد",48,"د",1,0],["ما سَرى في جَفنِها الغَنجُ إِلّا","أَوثَقَت مِنّا القُلوبَ جِراحا",49,"ح",2,0],["ما سَرايا أَبي وَما اِبنُ أَبي القا","سِمِ عَمّي وَما مَحاسِنُ جَدّي",50,"د",2,0],["ما ساءَهُ غَيرُ فَوتِ مُدَّتِهِ","وَما قَضى تَحتَ ظِلِّكُم زَمَنَه",51,"ن",2,0],["مَأسورَةٌ تَحيا بِقَطعِ رُؤوسِها","وَتَزيدُ نُطقاً عِندَ قَطِّ لِسانِها",52,"ن",3,0],["ما سارَ لِلناسِ ثَناءٌ سائِرٌ","إِلّا وَحَطَّ رَحلَهُ بِبابِهِ",53,"ب",2,0],["ما سَرَّ قَومَكَ أَن تَبقى لَهُم أَبَداً","وَأَنَّ غَيرَكَ كانَ اِستَنزَلَ الكَذَجا",54,"ج",2,0],["ما سَجسَجُ الشَوقِ مِثلَ جاحِمِهِ","وَلا صَريحُ الهَوى كَمُؤتَشِبِه",55,"ب",2,0],["ما سَرَّني بِخِداجِها مِن حُجَّةٍ","ما بَينَ أَندَلُسٍ إِلى صَنعاءِ",56,"ا",2,0],["ما سُنَّتي رفضُ الودادِ لصاحبٍ","ولكلِّ مَنْ رفضَ المودةَ مصرَعُ",57,"ع",1,0],["ما سمعنا يوماً بأشعرَ منْهُ","منذُ عهدِ الأمينِ والمأمونِ",58,"ن",1,0],["ما سرتُ إلا وطيفٌ منك يصحبني","سُرى أمامي وتأويباً على أثري",59,"ر",2,0],["ما سلسلٌ عذبٌ سقاه وابل","وهناً فويقَ حصى بروقِ غديرها",60,"ر",3,0],["ما سُمِّيَ القَلبُ إِلّا مِن تَقَلُّبِهِ","وَلا الفُؤادُ فُؤاداً غَيرَ أَن عَقَلا",61,"ل",2,0],["ما ساوَموا في حقِّ مِصرَ ولا رضوا","بالضْيمِ يُرهقُها ولا الإذلالِ",62,"ل",1,0],["ما سبيلُ المرءِ يَرتادُ الهُدَى","كسبيلِ المرْء يَبْغِي المنفعهْ",63,"ع",2,0],["ما سَلِيمنا إِلَيكَ مُنذُ اِصطَحَبنا","في الَّذي تَشتَهي وَما إِن عُصِيتا",64,"ت",2,0],["مَا سِوَى خُلْقِهِ النسيمُ وَلا غَيْ","رَ مُحَيَّاهُ الرَّوْضَةُ الغَنَّاءُ",65,"ا",2,0],["ما سُيِّرَتْ ما بَيْنَ يوسُفَ مِثْلَمَا","قد سُرَّ فيه أَحْمَدٌ بِمُحَمَّدِ",66,"د",1,0],["ما سامَنِي الدَّهْرُ ضَيْماً وَاسْتَجَرْتُ به","إلاَّ اسْتَلَمتُ النَّدَى مِنْ خَيْرِ مُسْتَلَمِ",67,"م",1,0],["ما سِرتُ مُذ جاوَزتُ مي","لاً دارَ ذاكَ الخَرِقُ",68,"ق",1,0],["ما ساقَني لَكِ مَملوكاً وَعَلَّقَني","إِلاَّ العُيونُ اللَواتي جِئنَ مِن صَدَدِ",69,"د",1,0],["ما ساقَ لي حُبُّها وَأَتعَبَني","وَهناً وَلَكِن خُلِقتُ مِن كَبَدِ",70,"د",1,0],["ما سَيِّدٌ غَيرُ رِعديدٍ عَلِمتُ بِهِ","كَأَنَّما الحَتفُ إِن لاقاهُ رِعديدُ",71,"د",1,0],["ما سَرَّني أَنّي إِمامُ زَمانِهِ","تُلقى إِلَيَّ مِنَ الأُمورِ مَقالِدُ",72,"د",1,1],["ما سَرَّ غاوينا الجَهولَ وَإِنَّما","هَتَفَ الحَمامُ بِهِ وَناحَ العودُ",73,"د",1,0],["ما سَدِرَت في العِيانِ أَعيُنُهُم","لَكِن عُيونُ الحِجى بِها سَدَرُ",74,"ر",1,0],["ما سَرَّني بِقَناعَةٍ أوتيتُها","في العَيشِ مُلكا غالِبٍ وَذِمارِ",75,"ر",1,0],["ما سَرَّ يَوماً بِشَيءٍ مِن مَحاسِنِهِ","إِلّا وَذاكَ بِسوءِ الفِعلِ مَشفوعُ",76,"ع",1,0],["ما سَرَّني وَاللَهُ يَعلَمُ غايَتي","أَنّي كَخانٍ في المُلوكِ وَآلِكا",77,"ك",2,0],["ما ساد قوماً جاهل","بحقوقهم إلا اِستبدا",78,"د",2,0],["ما سواد يجيء بعد بياضٍ","كبياض يجيء بعد سواد",79,"د",1,0],["ما سر بالنفع قوماً","في الغرب إلا الوفاق",80,"ق",1,0],["ما سَعيد إلا الَّذي عاشَ عمراً","مَع جيرانه حَليف الولاء",81,"ا",2,0],["ما ساءَ هذا الناس من عَليِّ","وحاد بالناصرِ والوليِّ",82,"ي",1,0],["ما سُكوتُ السَّماءِ إلاَّ وُجومٌ","ما نشيدُ الصَّباحِ غيرُ نحيبِ",83,"ب",1,0],["مَا سودَ الأَيَّامَ وَهْيَ بَهِيجَةٌ","بِبَيَاضِها كالعَيْشِ بَيْنَ مَحَابِرِ",84,"ر",1,0],["مَا سَنَى شُعلَةٍ إِلى الشَّمْسِ تُهْدَى","هَلْ لِرَمْزٍ أَدَاءُ مَا لاَ يُؤَدَّى",85,"د",2,1],["مَا سمِعْنَا نُطْقاً بِهِ يَزْدَهِي المِنْ","بَرُ عجْباً وَتطْرَبُ الأَعْوادُ",86,"د",1,0],["مَا سَمُومٌ نفَخَتْهَا سَقَرٌ","نَتْسِفُ الدَّوْحَ وَتُذْوِي العُشْبَ صَقَرا",87,"ر",2,0],["مَاسَتِ الباسِقاتُ في ضِفَّةِ الوا","دِي وأَرْخَتْ شُعورَها للرِّياح",88,"ح",1,0],["ما ساد بالحسب العريق، وإنما","نزع السيادةَ بعد طول جهاد",89,"د",1,0],["ما سال خلفَ سريره دمعٌ، ولا","خفَّ السُّعاةُ إلى السرير وفودا",90,"د",2,0],["ما ساهمت في الحرب إلا أنها","بالصمت عن هول الحروب تترجم",91,"م",1,0],["ماسَتْ غصونُكُمو من تِيهها بكمو","بين الرياض، ولولا التِّيهُ لم تَمسِ",92,"س",1,0],["ما سحَّ فوقك غيثٌ، أو جرى نهَرٌ","إليكَ إلا اعترافا منه بالنِّعم",93,"م",1,0],["ما سلَّم العادِي بهِ","عن طيبِ نفسٍ أو سَمَاح",94,"ح",1,0],["ما سال من دمكم لهُ","عَرْفٌ كعَرفٍ المسْكِ فاح",94,"ح",1,0],["ما سرُّ قوته في غير وحدتهِ","على مبادئها قامَتْ شعائره",95,"ر",2,0],["ما سار ركبُ الفنِّ في ملكوتِهِ","إلا وسارَ النقدُ خلفُ رِكابه",96,"ب",2,0],["ما سار وانيةً خُطَاه؛ وإِنما","حَدَّت دواعي العيش من إخْصابه",96,"ب",2,0],["ماسمعنا، يقلن هذا وسيمٌ","ذا أنيقٌ، أو ذاك غير أنيقِ",97,"ق",1,0],["ماسرت قط على القتا","ل وكان من املي الرجوع",98,"ع",1,0],["ما سامَنِي الدَّهرُ ضيمَاً واستَجَرتُ بِهِ","اِلا ونِلتُ جِوَارَاً منه لم يُضَمِ",99,"م",1,0],["ماسرَّهُ \" والبِيضُ \" تُنْكِرهُ","أنَّ المراعي الخُضْرَ تَحْمَده!",100,"د",2,0],["ما سرني ومَضاءُ السيفِ يُعوزوني","أني ملكتُ لساناً نافثاً ضَرما",101,"م",2,0],["مَا سَمِعْنا وَلاَ رَأَينا بِحُشٍّ","قبلَ هذا لبابهِ إقليدُ !",102,"د",1,0],["ما ساءني لوني وإسمُ زبيبة ٍ","إنْ قَصَّرَتْ عَنْ هِمَّتي أعدَائي",103,"ا",2,0]]}