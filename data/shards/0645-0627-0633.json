د ضيق","غير الصلاح فلا يرون شفيعا",226,"ع",2,0],["ما سرت نسمة القبول على الرو","ض فمالت بكلِّ غصن رطيبِ",227,"ب",1,0],["ما سرتْ نسمة الصباح بروضٍ","عبقريٍّ فهيَّجتْ أطياره",228,"ر",2,0],["ما سقوط المصباح يتبعه المص","باح إلا كثورتي في ضميري",229,"ي",1,0],["ما سف يوما وإن بجهلة من جهلة","أن الحياة تعالت فوق أحلام",230,"م",1,0],["ما سألتُ الدار أبغى رجعَها","ربَّ مسؤول سواها لم يُجِبْني",231,"ي",1,0],["ما سرَّني منه وفي أفعالِهِ","سخطُ المكارم أنه يرضاني",232,"ي",1,0],["ما سلِمَتْ قبلك القلوبُ على ال","حُسن ولا الراجمون بالمقلِ",233,"ل",1,0],["ما سهري ببابلٍ ونومُها","بحاجرٍ إلا النعيمُ والشقا",234,"ق",2,0],["ما سُمُحٌ وفاقهنّ خُلفُ","شتّى الصفاتِ ضمّهن وصفُ",235,"ف",1,1],["ما سلّط اللّه أجفاني على جلَدي","إلا ومحفوظُ سِرّي فيك ضائعُهُ",236,"ع",2,0],["ما سرّني في مدلهمِّ ليلها","أنّي أرى نجومَه طوالعا",237,"ع",2,0],["ما سعى للبيت يمشي حاسراً","راجلٌ وابنُ ركابٍ ركضا",238,"ض",2,0],["ما سائر بين الورى دائرٌ","بآيةٍ سائرةٍ دائرَهْ",239,"ر",2,1],["ما سار في كتيبةٍ إلا حَمَى","وما امتطى وسادةً إلا وزَرْ",240,"ر",1,0],["ما سكَنتْ أرضٌ إلى حضورِها","إلا بكتْ أخرى على افتقادِها",241,"د",3,0],["ما سمعنا بالسُّرى مِن قبله","بابن ليلٍ ساءه أن يُصبِحا",242,"ح",2,0],["ماس تيهاً وتغنّى طرباً","فهو ورقاً هتفتْ من فوق غصن",243,"ن",1,0],["ما سرت عن جلق أبغي البديل بها","لولا طلابي محلاً في العلى قذفا",244,"ف",2,1],["ما سمعنا بمن يزفُّ المعاني","ثمَّ يحبو خطابها بالمهور",245,"ر",1,0],["ما سادَ سادةَ قومهِ","لولا النجابةُ والشهامة",246,"م",2,0],["ما سمنت أعراض دنياهمُ","إلاَّ وأعراضهمُ للهزال",247,"ل",1,0],["ما سَمِعَ الناسُ وَلا حُدِّثوا","بِمِثلِ فَضلٍ في أَبي الفَضلِ",248,"ل",1,1],["ما سِرتُ بِالشَكوى إِلى سَمعِهِ","قَطُّ فَأَشرَفتُ عَلى وَعدِ",249,"د",1,0],["ما سُمّيَ القَلبُ إِلا مِن تَقَلُّبِهِ","وَالرّأيُ يُصرَفُ والأَهواءُ أَطوارُ",250,"ر",1,0],["ما سرتْ ريحُ الصَّبا مِن نشرِها","نحوَه إلا وقد راجعَ خبلَه",251,"ل",2,0],["ما سمعتْ أذنٌ وقد رَّجعتْ","كصوتِها طيباً ولا تَسمعُ",252,"ع",1,0],["ما سوى اللذائذ ل","لحي لو درى أرب",253,"ب",1,0],["ما ساغ شرعا ولا عقلا تمسكنا","بالمخزيات ف