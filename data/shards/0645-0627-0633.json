5,"بك طالت يد الزمان القصيرِ","https://www.aldiwan.net/poem3316.html","عموديه"],[465,"لولا صدودك يا أمامه","https://www.aldiwan.net/poem3491.html","عموديه"],[465,"عثرة قلبي فيكم لا تقال","https://www.aldiwan.net/poem3558.html","عموديه"],[469,"ما سمع الناس ولا حدثوا","https://www.aldiwan.net/poem59744.html","السريع"],[469,"لا يقبل الرشوة في ودي","https://www.aldiwan.net/poem60164.html","الطويل"],[471,"لا تأمني الصرم مني أن تري كلفي","https://www.aldiwan.net/poem4698.html","البسيط"],[478,"حي عني منحني الوادي وأثله","https://www.aldiwan.net/poem15200.html","الخفيف"],[478,"برق على الجزع بدا يلمع","https://www.aldiwan.net/poem15226.html","السريع"],[480,"راحة النهى الطرب","https://www.aldiwan.net/poem37059.html","المقتضب"],[480,"إن كنت مثلي على الأحوال مطلعا","https://www.aldiwan.net/poem37575.html","البسيط"],[501,"ما على عاشق الحبيب ملامة","https://www.aldiwan.net/poem37642.html","الخفيف"],[501,"قد تداعت من الأقاح خيوط","https://www.aldiwan.net/poem37784.html","الخفيف"],[501,"هب النسيم فسار بالأسرار","https://www.aldiwan.net/poem38018.html","الكامل"],[506,"القضيّة","https://www.aldiwan.net/poem27792.html","البسيط"],[515,"بزغت بالظلام شمس الديور","https://www.aldiwan.net/poem20787.html","الخفيف"],[539,"أى سهم راشه الدهر إلى","https://www.aldiwan.net/poem47499.html","عموديه"],[539,"كلما تهت دلالا","https://www.aldiwan.net/poem47979.html","عموديه"],[539,"السحر هذا ما أرى","https://www.aldiwan.net/poem48280.html","عموديه"],[545,"سقياك يا والد النهرين","https://www.aldiwan.net/poem67249.html","عموديه"],[552,"زارك زوار الحلم","https://www.aldiwan.net/poem47191.html","مجزوء الرجز"],[552,"يا سائلي عن ذنوب الدهر آونة","https://www.aldiwan.net/poem47821.html","البسيط"],[552,"قل للذين إذا دعوا","https://www.aldiwan.net/poem48036.html","مجزوء الكامل"],[559,"ادخلو في تصرف الرحمان","https://www.aldiwan.net/poem33743.html","الخفيف"],[559,"تب إلى الله من علوم الكلام","https://www.aldiwan.net/poem33868.html","الخفيف"],[563,"طال شوقي لطول هذا البعاد","https://www.aldiwan.net/poem52967.html","الخفيف"],[576,"قمر بات بين سحري ونحري","https://www.aldiwan.net/poem3061.html","الخفيف"],[587,"هذا الذي أحبه","https://www.aldiwan.net/poem17421.html","مجزوء الرجز"],[587,"ما كنت أندب رامة وطويلعا","https://www.aldiwan.net/poem17588.html","الكامل"],[587,"ماست فقيل هي القضيب الأميد","https://www.aldiwan.net/poem17979.html","الكامل"],[587,"إن شكونا له ظمانا وجدنا","https://www.aldiwan.net/poem18022.html","الخفيف"]],"verses":[["ما سَربَلَت ليلةٌ أشلاءَ غارَتِهِ","إلا تَنَفَّسَ صُبحُ الغارَةِ الصُّعَدا",0,"د",2,0],["ما سَرَّني وَقَنا اللِحاظِ تَنوشُني","أَنّي هُناكَ قَتيلُ غَيرِ الأَعيُنِ",1,"ن",1,0],["ما سَوَّغوني بَردَ الماءِ مُذ حَظَروا","عَلَيَّ بَردَ اللَمَي وَالشَوقُ يُظميني",2,"ن",2,0],["ما ساجَلَتكَ مِنَ المَقاوِلِ عُصبَةٌ","إِلّا وَضَلَّ مَقالُها وَغَريمُها",3,"م",3,0],["ما ساعَفَتني اللَيالي بَعدَ بَينِهِمُ","إِلّا بَكَيتُ لَيالينا بِذي سَلَمِ",4,"م",1,0],["ما سَرَّني مِن بَعدِهِ","الأَعواضُ وَالبَدائِلُ",5,"ل",1,0],["ما سَرَّني إِقبالُهُ","فَيَسوءُني إِعراضُهُ",6,"ض",2,0],["ما سِرتَ حَتّى سارَ نَعتُكَ أَوَّلاً","فَسَرَيتَ تَتبَعُهُ وَهَمُّكَ آخِرُ",7,"ر",1,0],["ما سَرَّني أَنَّ القِنانَ تَخَرَّفَت","عَمّا أَصابَت مِن حِجاجِ المَحجَرِ",8,"ر",1,0],["ما ساءَني لَوني وَإِسمُ زَبيبَةٍ","إِذ قَصَّرَت عَن هِمَّتي أَعدائي",9,"ا",2,0],["ما سابَقَ الناسُ يَومَ الفَضلِ مَكرُمَةً","إِلّا بَدَرتُ إِلَيها حَيثُ تُستَبِقُ",10,"ق",1,0],["ما سُمِّيَت قَطُّ إِلاّ هِجتُ أَذكُرُها","كأَنّما أُشعِلَت في قَلبيَ النارُ",11,"ر",1,0],["ماسَت غُصونُ رِماحِهِ وتفتّحَتْ","بشَقائِقِ النّصْرِ العَزيزِ بُنودُهُ",12,"د",2,0],["ما سَوَّدا بَيضاءَ إِلّا بَيَّضا","بِالكاتِبَينِ صَحيفَةَ الإِعجابِ",13,"ب",1,0],["ما سِرُّ سُكانِ الحِمى بِمُذاعِ","عِندي وَلا عَهدُ الهَوى بِمضاعِ",14,"ع",1,1],["ما سَرَّحَ الدَمعَ مِن عَيني وَأَطلَقَهُ","إِلّا اعتِيادُ أَسىً في القَلبِ مَسجونِ",15,"ن",1,0],["ما سُرَّ مَن را بِسُرَّ مَن را","بَل هِيَ بُؤسى لِمَن يَراها",16,"ا",3,0],["ما سارِقُ الدِرعَينِ إِن كُنتَ ذاكِراً","بِذي كَرَمٍ مِنَ الرِجالِ أُوادِعُه",17,"ع",2,1],["ما سَبَّني العَوّامُ إِلّا لِأَنَّهُ","أَخو سَمَكٍ في البَحرِ جارُ التَماسِحِ",18,"ح",1,1],["ما سمِّيت بالسحبِ إلاَّ أنَّها","في أُفقها من خجلةٍ تتسحب",19,"ب",1,0],["ما سرى في الكتاب إلا وأضحى","شغب الدّهرِ آمناً بالكتاب",20,"ب",1,0],["ما سرق المادحون وصفاً","فيك فلا تقطع الأيادي",21,"ي",1,0],["ما سمعنا للأفضل الفرد ثانٍ","حبَّذا في ثنائنا من بديع",22,"ع",1,0],["ما سرّني أنّ الكميت تحثها","نحوي السقاة وأن فوْدي أبلق",23,"ق",1,0],["ما سخنت فيها عيون الورى","حتى تجليت فقرت عيون",24,"ن",1,0],["ما سعى والسعاةُ للمجد إلا","سبقَ المُحْضِرينَ بالتقريبِ",25,"ب",1,0],["ما سرني بَدَلاً بما وفَّرْتهُ","منها مَكانُكَ واصلاً لجناحي",26,"ح",2,0],["ما ساقك الله نحوي","فيما أظن لخيري",27,"ر",2,0],["ما سار مدحكُمُ في الأرض منشمِراً","إلا بعُرفٍ لكم في الناس سيار",28,"ر",1,0],["ما سُخْطُنا لك خُطةً مُسْخُوطةً","تُضحي وأنت بها لنفسك راضي",29,"ض",2,0],["ما سرني اللؤم والغضارة في ال","عيش بديلاً بالمجد والقشف",30,"ف",1,0],["ما سوَّلتْ نفسٌ لصاحبها الغنى","إلا انبريتَ تُصدّقُ التسويلا",31,"ل",2,0],["ما ساءني إعراضُه","عني ولكنْ سرني",32,"ن",2,1],["ما سمعنا فيما سمعنا بأذنٍ","بُليت قبلها بداء اللكون",33,"ن",1,0],["ما ساءَ نَفسي مِنَ الدُنيا سِوى نَفَرٌ","لا خَيرَ فيهِم وَلَكِن شَرُّهُم عَمَمُ",34,"م",1,1],["ما سَرّني وَأحاشي عَصر عَطفِكمُ","يَومَ أَخَلّ في القَنا وَالهامُ نَنتَثِرُ",35,"ر",1,0],["ما سرتُ قَطُّ إِلى القِتا","ل وَكان مِن أَمَلي الرُجوعُ",36,"ع",1,0],["مأسورة ابدا تروح وتغتدى","وهلاكها في أن يفك إسار",37,"ر",1,0],["ما سِوى الحَديثِ بِهِ","يُبتَغى وَيُجتَذَبُ",38,"ب",1,0],["ما سَدِكَت عِلَّةٌ بِمَورودِ","أَكرَمَ مِن تَغلِبَ بنِ داوُّدِ",39,"د",1,1],["ما سَمِعنا بِمَن أَحَبَّ العَطايا","فَاِشتَهى أَن يَكونَ فيها فُؤادُه",40,"د",2,0],["ما سُمتُهُ سَردَ سِوى سِروالِ","وَكَيفَ لا وَإِنَّما إِدلالي",41,"ل",2,0],["ما ساءَني نقصُ جُهَّالٍ تَنَقَّصُني","سيَّانِ عنديَ أنْ يأسوا وأن كَلِمُوا",42,"م",3,0],["ما سَعَوا يَخلُفونَ غَيرَ أَبيهِم","كُلُّ ساعٍ مِنّا يُريدُ نِصابَه",43,"ب",2,0],["ما سَعى في نَقيصَةِ المُلكِ إِلّا","حائِرٌ مُرسَلٌ عَلَيهِ نَكالُه",44,"ل",2,0],["ما سالَها أَحَدٌ سِوايَ خَليفَةً","في الناسِ مَرئِيّاً وَلا مَسموعا",45,"ع",2,0],["ما سَرَّهُ أن ذاعَ من أسرارِه","ما غَيَّبَ الكِتمانُ في إضمارِه",46,"ر",2,1],["ما سَوَّلَتْ لي النَّفسُ هجرَ جَنابِه","عند الرحيل ولا اجتنابَ جِنابِه",47,"ب",2,0],["ما سِلمُ كَفِّكَ إِلّا مَن يُناوِلُها","وَلا عَدُوُّكَ إِلّا مَن يُرَجّيها",48,"ه",2,0],["ما سَهَرُ الوالِهِ مُعطٍ لَهُ","وَصلاً وَلَو داوَمَ طولَ السُهاد",49,"د",1,0],["ما سَرى في جَفنِها الغَنجُ إِلّا","أَوثَقَت مِنّا القُلوبَ جِراحا",50,"ح",2,0],["ما سَرايا أَبي وَما اِبنُ أَبي القا","سِمِ عَمّي وَما مَحاسِنُ جَدّي",51,"د",2,0],["ما ساءَهُ غَيرُ فَوتِ مُدَّتِهِ","وَما قَضى تَحتَ ظِلِّكُم زَمَنَه",52,"ن",2,0],["مَأسورَةٌ تَحيا بِقَطعِ رُؤوسِها","وَتَزيدُ نُطقاً عِندَ قَطِّ لِسانِها",53,"ن",3,0],["ما سارَ لِلناسِ ثَناءٌ سائِرٌ","إِلّا وَحَطَّ رَحلَهُ بِبابِهِ",54,"ب",2,0],["ما سَرَّ قَومَكَ أَن تَبقى لَهُم أَبَداً","وَأَنَّ غَيرَكَ كانَ اِستَنزَلَ الكَذَجا",55,"ج",2,0],["ما سَجسَجُ الشَوقِ مِثلَ جاحِمِهِ","وَلا صَريحُ الهَوى كَمُؤتَشِبِه",56,"ب",2,0],["ما سَرَّني بِخِداجِها مِن حُجَّةٍ","ما بَينَ أَندَلُسٍ إِلى صَنعاءِ",57,"ا",2,0],["ما سُنَّتي رفضُ الودادِ لصاحبٍ","ولكلِّ مَنْ رفضَ المودةَ مصرَعُ",58,"ع",1,0],["ما سمعنا يوماً بأشعرَ منْهُ","منذُ عهدِ الأمينِ والمأمونِ",59,"ن",1,0],["ما سرتُ إلا وطيفٌ منك يصحبني","سُرى أمامي وتأويباً على أثري",60,"ر",2,0],["ما سلسلٌ عذبٌ سقاه وابل","وهناً فويقَ حصى بروقِ غديرها",61,"ر",3,0],["ما سُمِّيَ القَلبُ إِلّا مِن تَقَلُّبِهِ","وَلا الفُؤادُ فُؤاداً غَيرَ أَن عَقَلا",62,"ل",2,0],["ما ساوَموا في حقِّ مِصرَ ولا رضوا","بالضْيمِ يُرهقُها ولا الإذلالِ",63,"ل",1,0],["ما سبيلُ المرءِ يَرتادُ الهُدَى","كسبيلِ المرْء يَبْغِي المنفعهْ",64,"ع",2,0],["ما سَلِيمنا إِلَيكَ مُنذُ اِصطَحَبنا","في الَّذي تَشتَهي وَما إِن عُصِيتا",65,"ت",2,0],["مَا سِوَى خُلْقِهِ النسيمُ وَلا غَيْ","رَ مُحَيَّاهُ الرَّوْضَةُ الغَنَّاءُ",66,"ا",2,0],["ما سُيِّرَتْ ما بَيْنَ يوسُفَ مِثْلَمَا","قد سُرَّ فيه أَحْمَدٌ بِمُحَمَّدِ",67,"د",1,0],["ما سامَنِي الدَّهْرُ ضَيْماً وَاسْتَجَرْتُ به","إلاَّ اسْتَلَمتُ النَّدَى مِنْ خَيْرِ مُسْتَلَمِ",68,"م",1,0],["ما سِرتُ مُذ جاوَزتُ مي","لاً دارَ ذاكَ الخَرِقُ",69,"ق",1,0],["ما ساقَني لَكِ مَملوكاً وَعَلَّقَني","إِلاَّ العُيونُ اللَواتي جِئنَ مِن صَدَدِ",70,"د",1,0],["ما ساقَ لي حُبُّها وَأَتعَبَني","وَهناً وَلَكِن خُلِقتُ مِن كَبَدِ",71,"د",1,0],["ما سَيِّدٌ غَيرُ رِعديدٍ عَلِمتُ بِهِ","كَأَنَّما الحَتفُ إِن لاقاهُ رِعديدُ",72,"د",1,0],["ما سَرَّني أَنّي إِمامُ زَمانِهِ","تُلقى إِلَيَّ مِنَ الأُمورِ مَقالِدُ",73,"د",1,1],["ما سَرَّ غاوينا الجَهولَ وَإِنَّما","هَتَفَ الحَمامُ بِهِ وَناحَ العودُ",74,"د",1,0],["ما سَدِرَت في العِيانِ أَعيُنُهُم","لَكِن عُيونُ الحِجى بِها سَدَرُ",75,"ر",1,0],["ما سَرَّني بِقَناعَةٍ أوتيتُها","في العَيشِ مُلكا غالِبٍ وَذِمارِ",76,"ر",1,0],["ما سَرَّ يَوماً بِشَيءٍ مِن مَحاسِنِهِ","إِلّا وَذاكَ بِسوءِ الفِعلِ مَشفوعُ",77,"ع",1,0],["ما سَرَّني وَاللَهُ يَعلَمُ غايَتي","أَنّي كَخانٍ في المُلوكِ وَآلِكا",78,"ك",2,0],["ما ساد قوماً جاهل","بحقوقهم إلا اِستبدا",79,"د",2,0],["ما سواد يجيء بعد بياضٍ","كبياض يجيء بعد سواد",80,"د",1,0],["ما سر بالنفع قوماً","في الغرب إلا الوفاق",81,"ق",1,0],["ما سَعيد إلا الَّذي عاشَ عمراً","مَع جيرانه حَليف الولاء",82,"ا",2,0],["ما ساءَ هذا الناس من عَليِّ","وحاد بالناصرِ والوليِّ",83,"ي",1,0],["ما سُكوتُ السَّماءِ إلاَّ وُجومٌ","ما نشيدُ الصَّباحِ غيرُ نحيبِ",84,"ب",1,0],["مَا سودَ الأَيَّامَ وَهْيَ بَهِيجَةٌ","بِبَيَاضِها كالعَيْشِ بَيْنَ مَحَابِرِ",85,"ر",1,0],["مَا سَنَى شُعلَةٍ إِلى الشَّمْسِ تُهْدَى","هَلْ لِرَمْزٍ أَدَاءُ مَا لاَ يُؤَدَّى",86,"د",2,1],["مَا سمِعْنَا نُطْقاً بِهِ يَزْدَهِي المِنْ","بَرُ عجْباً وَتطْرَبُ الأَعْوادُ",87,"د",1,0],["مَا سَمُومٌ نفَخَتْهَا سَقَرٌ","نَتْسِفُ الدَّوْحَ وَتُذْوِي العُشْبَ صَقَرا",88,"ر",2,0],["مَاسَتِ الباسِقاتُ في ضِفَّةِ الوا","دِي وأَرْخَتْ شُعورَها للرِّياح",89,"ح",1,0],["ما ساد بالحسب العريق، وإنما","نزع السيادةَ بعد طول جهاد",90,"د",1,0],["ما سال خلفَ سريره دمعٌ، ولا","خفَّ السُّعاةُ إلى السرير وفودا",91,"د",2,0],["ما ساهمت في الحرب إلا أنها","بالصمت عن هول الحروب تترجم",92,"م",1,0],["ماسَتْ غصونُكُمو من تِيهها بكمو","بين الرياض، ولولا التِّيهُ لم تَمسِ",93,"س",1,0],["ما سحَّ فوقك غيثٌ،