{"poems":[[60,"عرفت ومن يعتدل يعرف","https://www.aldiwan.net/poem30961.html","المتقارب"],[77,"أرياك أم ردع من المسك صائك","https://www.aldiwan.net/poem69053.html","الطويل"],[207,"أيجزع كعب لأشياعه","https://www.aldiwan.net/poem68169.html","المتقارب"],[466,"أحببته غمر الرداء والشيم","https://www.aldiwan.net/poem16104.html","الرجز"],[484,"سرى بك في الهوى الموفى بعهده","https://www.aldiwan.net/poem37035.html","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59425","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52029","البسيط"],[3003,"","https://poetry.dctabudhabi.ae/diwan/poem/126536","الوافر"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199027","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103037","الوافر"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4852,"مهيرة","https://www.poetsgate.com/ViewPoem.aspx?id=214385",""],[4852,"الحلم كالبحر","https://www.poetsgate.com/ViewPoem.aspx?id=214643",""]],"verses":[["فَدَسّ الرَسولُ رَسولاً لَهُ","بِأَبيَضَ ذي ظبَّةً مُرهَفِ",0,"ف",1,0],["فَدُسْ بهمُ تلك الوُكونَ فإنّني","أرى رَخَماً والبَيضَ بَيضٌ تَرائك",1,"ك",1,0],["فَدُسناهُمُ ثَمَّ حَتّى اِنثَنوا","سِوى زاهِقِ النَفسِ أَو مُحرِجِ",2,"ج",1,0],["فدسْتُهُ مثل وَغاهُ في البُهَمْ","يُلْحقُ أحياءَ الكُفاةِ بالرِّمَمْ",3,"م",1,0],["فدُس قلب المحب ولا تبالي","فقد أرجعت صاحبه لرشده",4,"ه",1,0],["فدس بسط إكرامي بنعلك وارتقب","شهود جلال دون ستر ممانع",5,"ع",1,0],["فَدُستَهُم أيُّهَا المَولَى بِحَامِيةٍ","تَشوِي الصَّلَّى وَعَلى الأصلابِ تَنصَلبُ",6,"ب",1,0],["فدست على الاثير وما حواه","وكدت ياخمصي أطا الثريا",7,"ي",2,0],["فدس من سارره جنح الغبش","بأسمر أذلق كالصل نهش",8,"ش",1,0],["فدس بالأخمصين رقاب قوم","تصدت للعلى من غير زاد",9,"د",1,0],["فَدَسَّ مَحضَ الخُسرِ في الرِّبحِ لَهَا","وَأَدرَجَ الشَرَّ لَها فيما شَرَى",10,"ا",1,0],["فدسستُ رأسي بالوسائدِ والرؤى","أهذي .. \"وربي ما سوايَ تولّهْ\"",11,"ل",2,0],["فدُسْ دروبًا منَ الإفناءِ قَدْرَ قِواكَ","اقصدْ مرامَكَ .. لا تسمع لمن خابا",12,"ب",2,0]]}