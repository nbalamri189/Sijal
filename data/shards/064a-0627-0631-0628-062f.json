{"poems":[[31,"يا عامر ابن عمير أنت مدرهنا","https://www.aldiwan.net/poem6207.html","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[108,"شيخ القضاة","https://www.poetsgate.com/ViewPoem.aspx?id=179683",""],[108,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[108,"حي البيان","https://www.poetsgate.com/ViewPoem.aspx?id=179367",""],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50000","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203477","السريع"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3552,"","https://poetry.dctabudhabi.ae/diwan/poem/27130","البسيط"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[5281,"نداء المهج","https://www.poetsgate.com/ViewPoem.aspx?id=200084",""],[5334,"إني رأيتُ جريراً يوم فارقنا","https://www.poetsgate.com/ViewPoem.aspx?id=96976",""],[5376,"الشعر منبرنا والحق والقلمُ","https://www.poetsgate.com/ViewPoem.aspx?id=188405",""],[5431,"يارب دينك بالغلاة تشوّها...","https://www.poetsgate.com/ViewPoem.aspx?id=212717",""],[5956,"ما أحسن الأخلاق","https://www.poetsgate.com/ViewPoem.aspx?id=194558",""],[6101,"زمرة الشيطان / حسن الأفندي","https://www.poetsgate.com/ViewPoem.aspx?id=120281",""]],"verses":[["يا رُبَّ داعٍ دَعا وَالمَوتُ يَكرُبُهُ","حَتّى تَناوَلَهُ مِن عامِرٍ سَبَبُ",0,"ب",1,0],["يا رُب ديوانِ تأنّق ربه","في طبعه وافتن في عنوانه",1,"ن",2,0],["يا رُبَّ دستورٍ نظمتَ بنودَه","نظمَ الجمان، وكنتَ كبشَ فدائه",2,"ا",3,0],["يا رُبَّ دَرْسٍ واحدٍ أربَى عَلَي","تَسْبِيح أَيَّامٍ، وذِكْر لَيالِي",3,"ل",2,0],["يا رُبَّ داعِية يبوِّئُ نَفْسَهُ","عَرْشَ القريض، وغَيْرُه أولى به",4,"ب",2,0],["ياربّ دَسكرة وافيتها سحراً","بكوكب أَهتديها أَو بعَيّوقِ",5,"ق",1,0],["يا رب دار بردُها قارسٌ","كأن فيها آبَ آذارُ",6,"ر",1,1],["يا رب دمر لاهل البغى اجمعهم","واقطع لدابرهم واهدم لركنهم",7,"م",1,0],["يا رَبَّ دَوارَ أَنقِذ أَهلَهُ عَجَلاً","وَاِنقُض مَرائِرَهُ مِن بَعدِ إِبرامِ",8,"م",1,1],["يا رَبِّ دَعْوَةَ راجٍ مِنْكَ مُلْتَمِسٍ","أَسِيرِ جُرْمٍ بِبَحْرِ الذَنْبِ مُنْغَمِسٍ",9,"س",1,0],["يا ربّ؛ دعوتنا في العيد صادقة","هيّﺀْ لأوطاننا من همّها فرجا...",10,"ج",2,0],["يا ربَّ داعٍ دعا في السحن أطلقه","والخطو من قيده في الخطو مقتصرُ",11,"ر",1,0],["يارب دينك بين الناس ممتحن","عزز لدينك فالثوار قد قدموا",12,"م",3,0],["يارب دينك بالغلاة تشوّها","حاشا لقدرك أنْ نُساق تكرّها",13,"ه",2,1],["يا رب دولته رعت جيرانها","ليست تريد أذىً لها وضحايا",14,"ا",3,0],["يا ربُ دمعُ العين أصبح حيلتي","أنت القدير ترُدُّ مكرَ جبان",15,"ن",1,0]]}