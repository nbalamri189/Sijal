{"poems":[[57,"أمنك للصب عند الوصل تذكار","https://www.aldiwan.net/poem26370.html","البسيط"],[59,"كن ساكنا في ذا الزمان بسيره","https://www.aldiwan.net/poem24685.html","الكامل"],[44,"بان الشباب كبين الهالك المودي","https://www.aldiwan.net/poem50335.html","البسيط"],[63,"أخلت أن جنابا منك يجتنب","https://www.aldiwan.net/poem51814.html","البسيط"],[59,"كن ساكناً في ذا الزمان بسيره","https://www.poetsgate.com/ViewPoem.aspx?id=3410",""],[458,"مقبل الراحة النكراء مزدهيا","https://www.aldiwan.net/poem61609.html","البسيط"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/124037","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63722","البسيط"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137946",""],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87421","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216756","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135953","الرجز"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105256","الكامل"],[5092,"القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=190571",""],[5431,"فالصمتُ تعرفه الأجداثُ والكفنُ","https://www.poetsgate.com/ViewPoem.aspx?id=190025",""],[5956,"سندرا أمُّ الجميع","https://www.poetsgate.com/ViewPoem.aspx?id=193161",""],[5956,"يَدُ بنيَّ مربوطةٌ كعقولنا","https://www.poetsgate.com/ViewPoem.aspx?id=193399",""],[5956,"إني أنصّب نفسي مثل والدِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=193718",""],[6003,"خفقات متيم","https://www.poetsgate.com/ViewPoem.aspx?id=188896",""],[6088,"اقباس","https://www.poetsgate.com/ViewPoem.aspx?id=207586",""]],"verses":[["إِنّي أُطِيلُ وَإِن لَم أَرجُ طَلعَتَها","وَقِفي وَإِنّي إِلى الأَبوابِ نَظّارُ",0,"ر",1,0],["إِنّي اِطَّلَعتُ فَلَم أَجِد لي صاحِباً","أَصحَبُهُ في الدَهرِ وَلا في غَيرِهِ",1,"ر",2,0],["إِنّي أُطالِبُهُ في الناسِ أَنشُدُهُ","يا حَبَّذا مِن مُضَلٍّ غَيرَ مَوجودِ",2,"د",1,0],["أنَّى اطمأَنَّ وحصباءُ العَجاجِ عِدىً","من دونِه وثَراها السُّمرُ والقُضُبُ",3,"ب",1,0],["إني اطلعت فلم أجد لي صاحباً","أصحبه في دهري ولا في غيره",4,"ر",2,0],["إنِّي أُطأطئُ راسي عانياً خَجلاً","أني ذكرت رزايا كنتَ تَمنعها",5,"ع",3,0],["أنّى أطيعك والقلب الجموع إذا","طاوعت أمرك في السلوان يعصيني",6,"ن",2,0],["إِنِّي أَطَعْتُكَ فيما لم أُطِعْ أحداً","فيه ولكنْ أَباه من له الأمر",7,"ر",1,0],["اني أُطلُّ عليكَ يا لبنان من","جوّ التصوُّر ناظراً وسميعا",8,"ع",2,0],["إني أطالب محبوبي بما انفَطَرت","عليهِ نَفسي من الإِغرام وَالشَغفِ",9,"ف",1,1],["إني أطعتك في رعاية وجهه","يا ويح من يعصي ومن يرعاه",10,"ا",2,0],["إنيَ أطلبُ إلهي يوم ذا","أن يستُرَنْ عيبيَ عن ذاك وذا",11,"ذ",2,1],["إني اطيل لك العتاب فهل ترى","يوماً فديتك سامعاً لعتابي",12,"ب",2,0],["إني أُطَبّبُ وجهَ الصمتِ في جسدي","حتى أقابلهُ حِضْنًا نما جَهْرا",13,"ر",2,0],["إني أطهرُ روحي في منابعهم","وينزف الشعر نزفا مسّه الحزَنُ",14,"ن",1,0],["إني أطلت عليك شعري وانتهى","باللفظ حالياً لكنْ جارياً معَ نبضنا",15,"ن",2,0],["إني أطبِّبُ بالمحبة أسرتي","مهما أذُبْ عطفاً أظلّ مُهابا",16,"ب",2,0],["إني أطهر نفسي من دناءتها","وأعرف العزم لا يأتي من الورَمِ",17,"م",1,0],["إني أطير على أعتاب قافيتي","فقد أراها ضحى في منتهى الدرج",18,"ج",1,0],["إنّي أطلّ على الخمسين بعد غد","أو بعد بعد غد قد أقرع الجرسا",19,"س",2,0]]}