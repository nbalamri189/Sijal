{"poems":[[53,"مكر الزمان علينا غير مأمون","https://www.aldiwan.net/poem66416.html","البسيط"],[30,"إذ نحن نخبر بالحواجب بيننا","https://www.aldiwan.net/poem5544.html","الكامل"],[107,"أيكف شكوك أن يكون أماما","https://www.aldiwan.net/poem43395.html","الكامل"],[107,"أيكف شأوك أن يكون أماما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54863&r=&rc=33",""],[201,"حي الأساتذة الكرام تحية","https://www.aldiwan.net/poem39949.html","الكامل"],[201,"كفكف بربك دمعك الهتانا","https://www.aldiwan.net/poem39950.html","الكامل"],[396,"يا من له الحول والقوه","https://www.aldiwan.net/poem54466.html","عموديه"],[3596,"","https://poetry.dctabudhabi.ae/diwan/poem/98190","الرمل"]],"verses":[["نعصِي الإله ونَعصِي الناصحين لنا","ونستجيبُ لمقبوح ومَلعون",0,"ن",1,0],["نَعصي إِذا كَسَرَ الطِعانُ رِماحَنا","في المُعلَمينَ بِكُلِّ أَبيَضَ مِخذَمِ",1,"م",1,0],["نَعصي المُلوكَ إِذا عَنَوا عَن أَمرِهِ","وَنُهينُ في مَرضاتِهِ الحُكّاما",2,"م",2,0],["نعصي الملوك إذا عتوا عن أمره","ونهين في مرضاته الحكاما",3,"م",2,0],["نعصي أوامرَ كلّ فردٍ مُصلحٍ","والدينُ ينهانا عن العِصيان",4,"ن",1,0],["نعصى أوامِرَ كلّ فردٍ مُصلحٍ","والدينُ عن عِصيانهِ ينهانا",5,"ن",2,0],["نعصي فتستر ولا تظهر","سوى الجميل مدى الأزمان",6,"ن",1,0],["نعص من لام على دين الهوى","هذه سنة أيام الصبا",7,"ب",2,0]]}