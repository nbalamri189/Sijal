{"poems":[[66,"قد تصبرت وهل يصبر","https://www.aldiwan.net/poem67655.html","مجزوء الرمل"],[53,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[50,"ومؤاتي الطرف عف اللسان","https://www.aldiwan.net/poem65277.html","المديد"],[66,"قد تصبّرتُ وهل يصبر","https://www.poetsgate.com/ViewPoem.aspx?id=8520",""],[422,"زيد لوما فزاد في الحب وجدا","https://www.aldiwan.net/poem54124.html","الخفيف"],[498,"ومدام كأنها في حشا الدنن","https://www.aldiwan.net/poem67426.html","الخفيف"],[505,"تركونا أي قوم تركوا","https://www.aldiwan.net/poem37930.html","الرمل"],[505,"أسعفيني يا نياقي","https://www.aldiwan.net/poem37940.html","مجزوء الرمل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70774","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120073","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93863","البسيط"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115582","الرمل"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126268","الخفيف"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87406","البسيط"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46020","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91877","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85136","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131247",""],[3989,"","https://poetry.dctabudhabi.ae/diwan/poem/147364","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86353","الرمل"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105110","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94325","البسيط"],[778,"مازج بروحك روح الراح تحييها","https://www.poetsgate.com/ViewPoem.aspx?id=89235",""],[5198,"نجمة الصبح","https://www.poetsgate.com/ViewPoem.aspx?id=135527",""],[6300,"في رحاب الذات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82837&r=&rc=8",""],[6315,"البَيدَاءُ وَ الجَنِينُ المُرتَقَب ... تَحِيَّتَانِ للأُنثَى !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87577&r=&rc=2",""]],"verses":[["مازجَت روحُكَ روحي","في دُنُوّي وَبِعادي",0,"د",2,0],["ما زجرنا وقد صرفنا إليه","أوجُهَ العِيسِ بارحاً ذا نعيبِ",1,"ب",1,0],["مازِجٍ لي مِن رَجاءٍ بِيَأسٍ","نازِحٍ بِالفِعلِ وَالقَولِ دانِ",2,"ن",1,0],["مازجَتْ روحُك روحي","في دنّوٍ وبعادي",3,"د",2,0],["مازج الحبَّ مرَّة فأراه","أنَّ هزل الغرام يصبح جدَّا",4,"د",2,0],["مازَجَت جَوهَرَ الزُجاجِ فَجاءَت","كَشُعاعٍ مُمازِجٍ لِهَواءِ",5,"ا",2,0],["مَازَجَتهُمْ أَنفُسٌ من نوعِهِمْ","صُحِّحَ النَّوعُ لها المُشْتَبِكُ",6,"ك",1,0],["مازِجاً روحاً برُوحٍ","ليسَ يلوي لافْتِرَاقِ",7,"ق",1,0],["ما زجتْ بردَه عذوبةُ طعم","دونها طعمُ سُكّر الأقلام",8,"م",1,0],["مازجا منه رضابا","يسكر الراح براح",9,"ح",1,0],["ما زجه تلق مزاجا طبع رقته","يأبى مزاج غليظ غبر ممتزج",10,"ج",1,0],["مازجَ الصبح الدجى فامتزجا","وتنشّا منهُما ضوءٌ أغَر",11,"ر",1,0],["مازج القلب حبهم","بل وفى قالبى انتشر",12,"ر",1,0],["ما زجَّجت حاجباً كلّا ولا كَحلت","عيناً ولا بيَّضَت وجهاً ولا جيدا",13,"د",2,0],["مازجَ اللّطف حياءٌ","يَمنَعُ الخَدُّ شَقيقَه",14,"ق",2,0],["مازجتُ دَهري إمتزاجَ مجرّبٍ","فَأَنا الزَمان فخذ إِليك عجائبه",15,"ب",2,0],["مازج الكاس من لماه بريق","حبذا مزجها بحالي الرضاب",16,"ب",1,0],["مازجته من قلبها قطرات","فبدا بين لؤلؤ مرجان",17,"ن",1,0],["مازجا ً أول الحنين بأقصاه","وشهد الذكرى بما هو أحلى",18,"ل",2,0],["مازجاً بالجد مني اللعبا","عل أن أجفانه لم تنعس",19,"س",1,0],["مازجاً صرف كأسه بلماه","خالطا جده بهزل المزاح",20,"ح",1,0],["مازجتَ أهليكَ بالأعمال منعكساً","ركبان أضراركم في ذا الورى ساروا",21,"ر",3,0],["مازج بروحك روح الراح تحييها","فالراح كالروح تجري في مجاريها",22,"ي",3,1],["مازجة دمّي بلون الخضاب","كيف هذا بهذا يمزجي ؟!",23,"ج",2,0],["مازجْتُ جُرحِي بجُرحي فاستعادَ فمي","جُرْحًا يُنغِّم في أعماقيَ الكُرَبَا",24,"ب",2,0],["مَازَجْتَ حَتىَّ صَهِيلَ الخَيلِ فَاتَّكَأَتْ","عَلَيهِ شَيْخُوخَةُ الأَنْغَامِ إِعْجَابا",25,"ب",2,0]]}