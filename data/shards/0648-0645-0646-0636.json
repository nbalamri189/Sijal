{"poems":[[53,"مقيم من الهم لا يقلع","https://www.aldiwan.net/poem29974.html","المتقارب"],[88,"لعمرك ما كل انكسار له جبر","https://www.aldiwan.net/poem45069.html","الطويل"],[72,"على مثلها فلتهم أعيننا العبرى","https://www.aldiwan.net/poem18716.html","الطويل"],[51,"لج الفؤاد فليس يلذعه","https://www.aldiwan.net/poem65413.html","أحذ الكامل"],[51,"تلون أخلاق الفتى من ملاله","https://www.aldiwan.net/poem65972.html","الطويل"],[43,"يذكرني فاتكا حلمه","https://www.aldiwan.net/poem10574.html","المتقارب"],[2,"قف بالديار التي لم يعفها القدم","https://www.aldiwan.net/poem25057.html","البسيط"],[58,"أقيك بنفسي أيها المصطفى الذي","https://www.aldiwan.net/poem30919.html","الطويل"],[46,"حياة عناء وموت عنا","https://www.aldiwan.net/poem22049.html","المتقارب"],[106,"كفكف دموعك","https://www.poetsgate.com/ViewPoem.aspx?id=179663",""],[51,"لجَّ الفؤادُ فليس يلذعه","https://www.poetsgate.com/ViewPoem.aspx?id=29595",""],[126,"ثقيل لو أن الأرض تعقل صاحبى","https://www.aldiwan.net/poem50588.html","الطويل"],[167,"أفي كل دار لي عدو أصاوله","https://www.aldiwan.net/poem1645.html",""],[206,"أعتقت من أفناء كوز وهاجر","https://www.aldiwan.net/poem2025.html","الطويل"],[296,"رأى البرق في جنح الدجى يتألق","https://www.aldiwan.net/poem36295.html","عموديه"],[302,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[303,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[323,"سؤالك يا هذا سؤال معاند","https://www.aldiwan.net/poem52139.html","الطويل"],[540,"ألا لا أرى شيئا ألذ من الوعد","https://www.aldiwan.net/poem34019.html","الطويل"],[549,"فما ماء مزن بات جفن سحابة","https://www.aldiwan.net/poem47897.html","الطويل"],[549,"أمنك الشوق أرقني فهاجا","https://www.aldiwan.net/poem47908.html","الوافر"],[565,"له شغل عن سؤال الطلل","https://www.aldiwan.net/poem69529.html","المتقارب"],[571,"حذار حذار من ركون إلى الزمن","https://www.aldiwan.net/poem3640.html","الطويل"]],"verses":[["وَمَن ضاقَتِ الأَرضُ عَن هَمِّهِ","حَرٍ أَن يَضيقَ بِهِ مَضجَعُ",0,"ع",1,0],["ومن ضحكات الشعر دمعة عاشق","بها قد شكا للوصل ما فعل الهجر",1,"ر",1,0],["ومن ضامر الكشحين يسبق في غدٍ","إلى غايةٍ من أجلها تحمد الضّمرا",2,"ر",2,0],["ومنضَّد رقّت مراشفه","علا المدام به مشعشعه",3,"ع",2,0],["ومن ضنَّ أن أُعطىَ سِواه كمن رأى","جمالَ أخيه كافياً من جمالهِ",4,"ل",2,0],["وَمَن ضاقَتِ الأَرضُ عَن نَفسِهِ","حَرىً أَن يَضيقَ بِها جِسمُهُ",5,"م",2,0],["وَمِن ضَريبَتِهِ التَقوى وَيَعصِمُهُ","مِن سَيِّءِ العَثَراتِ اللَهُ وَالرَحِمُ",6,"م",1,0],["وَمَن ضَمَّني مُذ كُنتُ طِفلاً وَيافِعاً","وَأَنعَشَني بِالعِلِّ مِنهُ وَبِالنَهلِ",7,"ل",1,0],["وَمَن ضَمَّهُ جَدَثٌ لَم يُبَل","عَلى ما أَفادَ وَلا ما اِقتَنى",8,"ن",2,0],["ومن ضاق ذرعًا بدنياهُ، ضاقت","عليه، وإن هي كانت براحا",9,"ح",2,0],["ومنضَّدٍ رفَّتُ مَراشِفُه","علا المُدام به مُشعشعُهُ",10,"ع",2,0],["ومن ضاقتِ الدنيا على جلسائِه","بأخلاقه السوءَى وصارُوا به مَرضَى",11,"ض",2,0],["وَمِن ضَعفِ رَأي المَرءِ إِكرامُ ناهِقٍ","وَقَد ماتَ هزلاً في الأَواخِيِّ صاهِلُه",12,"ل",2,0],["وَمَن ضَيَّعَ السَيفَ اِتِّكالاً عَلى العَصى","شَكى وَقعَ حَدِّ السَيفِ مِمّن يُنازِلُه",12,"ل",2,0],["وَمَنضُورَةُ الحَسناءُ كُنتُ اصطَفَيتُها","فَأَعتقتُها لَمّا أَتانِي حَبِيبُها",13,"ه",2,0],["وَمَنْ ضاقَ ذرعاً بالقريبِ فذرعُه","وَحيلتُه عَمَّنْ سواه لأَضيق",14,"ق",1,0],["ومن ضيع التقوى وأهمل أمرها","تغشته في العقبى فنون الندامة",15,"ه",1,0],["وَمِن ضمّرٍ كمتٍ خلوقيّة الحلى","كأنَّ العُقارَ الوردَ قَد علّها غطّا",16,"ط",2,0],["ومن ضل عن حق فلا تقفونه","وزن ما عليه الناس بالمعدلية",17,"ه",1,0],["ومن ضِحكَةٍ في الملتقى ثم سَكتَةٍ","وكِلتاهما عِندي ألذُّ من الشَّهدِ",18,"د",1,0],["ومَنْ ضَمّهُ جَمْعٌ وَبينَ بِلادهمْ","إِذا اِفتَرقوا سَهْبٌ عريضٌ مطوِّحُ",19,"ح",1,0],["ومَنْ ضربَ القليبَ ببطنِ سَجْلٍ","ولم يشدُدْ إلى وَذَمٍ عِناجا",20,"ج",2,0],["وَمَنْ ضَرَبَ النَّاسَ بِالمُرْهَفَاتِ","عَلَى الدِّيْنِ ضَرْبَ غِرَابِ الإِبِلْ",21,"ل",1,0],["وَمَن ضاقَت الدُنيا بِهِ وَبِجَيشِهِ","طَوَت شَخصَهُ في قَيدِ شِبرٍ مِنَ الكَفَن",22,"ن",1,0]]}