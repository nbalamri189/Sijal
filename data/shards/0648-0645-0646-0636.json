{"poems":[[55,"مقيم من الهم لا يقلع","https://www.aldiwan.net/poem29974.html","المتقارب"],[90,"لعمرك ما كل انكسار له جبر","https://www.aldiwan.net/poem45069.html","الطويل"],[74,"على مثلها فلتهم أعيننا العبرى","https://www.aldiwan.net/poem18716.html","الطويل"],[53,"لج الفؤاد فليس يلذعه","https://www.aldiwan.net/poem65413.html","أحذ الكامل"],[53,"تلون أخلاق الفتى من ملاله","https://www.aldiwan.net/poem65972.html","الطويل"],[45,"يذكرني فاتكا حلمه","https://www.aldiwan.net/poem10574.html","المتقارب"],[2,"قف بالديار التي لم يعفها القدم","https://www.aldiwan.net/poem25057.html","البسيط"],[60,"أقيك بنفسي أيها المصطفى الذي","https://www.aldiwan.net/poem30919.html","الطويل"],[48,"حياة عناء وموت عنا","https://www.aldiwan.net/poem22049.html","المتقارب"],[108,"كفكف دموعك","https://www.poetsgate.com/ViewPoem.aspx?id=179663",""],[53,"لجَّ الفؤادُ فليس يلذعه","https://www.poetsgate.com/ViewPoem.aspx?id=29595",""],[132,"ثقيل لو أن الأرض تعقل صاحبى","https://www.aldiwan.net/poem50588.html","الطويل"],[173,"أفي كل دار لي عدو أصاوله","https://www.aldiwan.net/poem1645.html",""],[212,"أعتقت من أفناء كوز وهاجر","https://www.aldiwan.net/poem2025.html","الطويل"],[303,"رأى البرق في جنح الدجى يتألق","https://www.aldiwan.net/poem36295.html","عموديه"],[309,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[310,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[330,"سؤالك يا هذا سؤال معاند","https://www.aldiwan.net/poem52139.html","الطويل"],[547,"ألا لا أرى شيئا ألذ من الوعد","https://www.aldiwan.net/poem34019.html","الطويل"],[556,"فما ماء مزن بات جفن سحابة","https://www.aldiwan.net/poem47897.html","الطويل"],[556,"أمنك الشوق أرقني فهاجا","https://www.aldiwan.net/poem47908.html","الوافر"],[572,"له شغل عن سؤال الطلل","https://www.aldiwan.net/poem69529.html","المتقارب"],[578,"حذار حذار من ركون إلى الزمن","https://www.aldiwan.net/poem3640.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122746","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122618","الوافر"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137608",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48834","الطويل"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123364","البسيط"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129540","المتقارب"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59751","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96613","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202085","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25345","الرجز"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122089","الطويل"],[1660,"","https://poetry.dctabudhabi.ae/diwan/poem/72162","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26408","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124727","الطويل"],[1918,"","https://poetry.dctabudhabi.ae/diwan/poem/99058","الهزج"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27267","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109417","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87762","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87334","الطويل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100921","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75929","البسيط"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116500","الطويل"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84473","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89212","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62871","الوافر"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126995","الوافر"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45871","الطويل"],[3727,"","https://poetry.dctabudhabi.ae/diwan/poem/124072","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114434","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111510","الرجز"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139394",""],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/117143","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83592","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72448","الطويل"],[4805,"هجينيه 1","https://www.poetsgate.com/ViewPoem.aspx?id=176593",""],[4578,"تجلَّت فيها شمس النهار على رُمحٍ","https://www.poetsgate.com/ViewPoem.aspx?id=49377",""],[4859,"عيون الود!","https://www.poetsgate.com/ViewPoem.aspx?id=204323",""],[4927,"شيخ الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=4577",""],[4929,"الى الله (تضرع)","https://www.poetsgate.com/ViewPoem.aspx?id=211538",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5482,"ومنضد فِيهِ الرِّيَاح سواكن","https://www.poetsgate.com/ViewPoem.aspx?id=189031",""],[5561,"عروبتنا","https://www.poetsgate.com/ViewPoem.aspx?id=213353",""],[5704,"من ثغره لاح السنا ٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=197402",""],[5956,"يا نجم","https://www.poetsgate.com/ViewPoem.aspx?id=183342",""],[5309,"أأنا شقيق ان تركت شقيقي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573934",""],[6164,"الثمانون؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66038&r=&rc=48",""],[572,"لهُ شُغُلٌ عنْ سؤالِ الطّلَلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9447&r=&rc=304",""]],"verses":[["وَمَن ضاقَتِ الأَرضُ عَن هَمِّهِ","حَرٍ أَن يَضيقَ بِهِ مَضجَعُ",0,"ع",1,0],["ومن ضحكات الشعر دمعة عاشق","بها قد شكا للوصل ما فعل الهجر",1,"ر",1,0],["ومن ضامر الكشحين يسبق في غدٍ","إلى غايةٍ من أجلها تحمد الضّمرا",2,"ر",2,0],["ومنضَّد رقّت مراشفه","علا المدام به مشعشعه",3,"ع",2,0],["ومن ضنَّ أن أُعطىَ سِواه كمن رأى","جمالَ أخيه كافياً من جمالهِ",4,"ل",2,0],["وَمَن ضاقَتِ الأَرضُ عَن نَفسِهِ","حَرىً أَن يَضيقَ بِها جِسمُهُ",5,"م",2,0],["وَمِن ضَريبَتِهِ التَقوى وَيَعصِمُهُ","مِن سَيِّءِ العَثَراتِ اللَهُ وَالرَحِمُ",6,"م",1,0],["وَمَن ضَمَّني مُذ كُنتُ طِفلاً وَيافِعاً","وَأَنعَشَني بِالعِلِّ مِنهُ وَبِالنَهلِ",7,"ل",1,0],["وَمَن ضَمَّهُ جَدَثٌ لَم يُبَل","عَلى ما أَفادَ وَلا ما اِقتَنى",8,"ن",2,0],["ومن ضاق ذرعًا بدنياهُ، ضاقت","عليه، وإن هي كانت براحا",9,"ح",2,0],["ومنضَّدٍ رفَّتُ مَراشِفُه","علا المُدام به مُشعشعُهُ",10,"ع",2,0],["ومن ضاقتِ الدنيا على جلسائِه","بأخلاقه السوءَى وصارُوا به مَرضَى",11,"ض",2,0],["وَمِن ضَعفِ رَأي المَرءِ إِكرامُ ناهِقٍ","وَقَد ماتَ هزلاً في الأَواخِيِّ صاهِلُه",12,"ل",2,0],["وَمَن ضَيَّعَ السَيفَ اِتِّكالاً عَلى العَصى","شَكى وَقعَ حَدِّ السَيفِ مِمّن يُنازِلُه",12,"ل",2,0],["وَمَنضُورَةُ الحَسناءُ كُنتُ اصطَفَيتُها","فَأَعتقتُها لَمّا أَتانِي حَبِيبُها",13,"ه",2,0],["وَمَنْ ضاقَ ذرعاً بالقريبِ فذرعُه","وَحيلتُه عَمَّنْ سواه لأَضيق",14,"ق",1,0],["ومن ضيع التقوى وأهمل أمرها","تغشته في العقبى فنون الندامة",15,"ه",1,0],["وَمِن ضمّرٍ كمتٍ خلوقيّة الحلى","كأنَّ العُقارَ الوردَ قَد علّها غطّا",16,"ط",2,0],["ومن ضل عن حق فلا تقفونه","وزن ما عليه الناس بالمعدلية",17,"ه",1,0],["ومن ضِحكَةٍ في الملتقى ثم سَكتَةٍ","وكِلتاهما عِندي ألذُّ من الشَّهدِ",18,"د",1,0],["ومَنْ ضَمّهُ جَمْعٌ وَبينَ بِلادهمْ","إِذا اِفتَرقوا سَهْبٌ عريضٌ مطوِّحُ",19,"ح",1,0],["ومَنْ ضربَ القليبَ ببطنِ سَجْلٍ","ولم يشدُدْ إلى وَذَمٍ عِناجا",20,"ج",2,0],["وَمَنْ ضَرَبَ النَّاسَ بِالمُرْهَفَاتِ","عَلَى الدِّيْنِ ضَرْبَ غِرَابِ الإِبِلْ",21,"ل",1,0],["وَمَن ضاقَت الدُنيا بِهِ وَبِجَيشِهِ","طَوَت شَخصَهُ في قَيدِ شِبرٍ مِنَ الكَفَن",22,"ن",1,0],["وَمِن ضَعفِ حَظّي أَنَّني مُتَأَخِّرٌ","فَيا بَردَها لَو أنَّني مُتَقَدِّمُ",23,"م",1,0],["ومن ضَرب الحِجابَ فلستُ آسى","لِرؤيتِه ومَن خَلَع العِذارا",24,"ر",2,0],["ومن ضغط ذاك البخار عقيب ار","تفاع تسير المراقي انحدارا",25,"ر",2,0],["ومن ضمن العقبى له من زمانه","تساوى قريبٌ عنده وبعيد",26,"د",1,0],["ومن ضعيفين صَبْرِي حين أذكره","وودّه ويراه الناسُ طَوْعَ يدي",27,"د",2,0],["ومن ضن بالمال خوف الخطوب","أعان الخطوب على نفسه",28,"س",2,0],["ومنضيه منا يوسفيٌ لفخره","من العقد ما راق العيون اتساقه",29,"ق",2,0],["وَمَن ضاقَ عَن تكييفِ عظمةِ شأنهِ","مشارقها حيثُ اِنتَهت والمغاربُ",30,"ب",1,0],["ومن ضمَّت الدنيا ومن وطيءَ الثَّرى","وأشرف مَن أجرى العتاقَ المذاكيا",31,"ي",2,0],["ومن ضمَّت الدنيا ومن وطئَ الثَّرى","وأشرف مَن أجرى العتاقَ المذاكيا",31,"ي",2,0],["وَمِنْ ضَوَاحِي وَاحِفَيْنِ بُرَقا","إِلَى مِعَا الخَلْصَاءِ حِينَ ابْرَنْشَقا",32,"ق",2,0],["وَمُنْضِي المَطَايَا صَادِعاً كُلَّ مَهْمَهٍ","بِهِ لِلْفُحُولِ الهَائِجَاتِ مَرَاغِ",33,"غ",1,0],["وَمَنْ ضَنَّ بالتَسْلِيمِ يَوْمَ فِرَاقه","عَلَيَّ ودَمْعُ العَيْنِ تَجْري بَوادِرُهْ",34,"ر",2,0],["وَمَن ضَعُفَت أَعضاؤُهُ اِشتَدَّ رَأيُهُ","وَمَن قَوَّمَتهُ الحادِثاتُ تَقَوَّما",35,"م",2,0],["ومن ضعف هذا الضرب إن كان داخلاً","مع السدس ثمنٌ يقسم المال أجمعُ",36,"ع",1,0],["ومن ضرّب في حبِّ","عليٍّ وأبي بكر",37,"ر",1,0],["ومن ضيائي إلى ظلامي","فمن هداي إلى ضلالي",38,"ل",2,0],["ومن ضلَّ في تيه المعاش لفقره","هدته إلى مغنى غناه المراشد",39,"د",1,0],["وَمَن ضَرَبوا فَوقَ السِماك قِبابهم","لِيعشو إِلى نيرانهم كُل مُجتدي",40,"د",2,0],["وَمَن ضَمَّ أهلَ الشَّرقِ تَجرِيبُهُ وَفَى","فَبَا حُسنَهَا هَاتِيكَ بَينَ التَّجَارِبِ",41,"ب",1,0],["ومنضنضٍ مجَّ الزُّعافَ لسانُه","غَضَباً وصرَّف جأشَهُ ضرغام",42,"م",1,0],["وَمِن ضِياءٍ وَجهُهُ مُشرِقٌ","مِن بَدأةِ الأَمرِ إِلى الآخِرِ",43,"ر",1,0],["ومن ضرب ذات النار زاد اسودادها","فصارت به الآفاق ذات جلايب",44,"ب",1,0],["ومن ضيا ناظري حقا أَعز عَلي","مَن شرَّف الناس تَعميما وخص قُري",45,"ي",1,0],["وَمن ضيائك نور النيرين أَتى","ومن علومِك علم اللوح والقَلَم",46,"م",1,0],["ومن ضمنه خط شريفٌ مؤيد","بعمر وإقبال يرى الحظ أجناسا",47,"س",2,0],["ومنْ ضَرْبِ الاعز أَبي شُجاعٍ","فتى باهى به التاجُ السِّوارَا",48,"ر",2,0],["ومن ضاقت رحاب الأرض منه","بعظم فخاره شرفا وعزا",49,"ز",2,0],["وَمِن ضَمِيرِ الرَّفع ما يَستِترُ","كَافعَل أُوَافِق نَغتَبِط إِذ تَشكُرُ",50,"ر",1,0],["ومِن ضَمِيرِ الحاضِرِ الظَّاهِرَ لاَ","تُبدِ لهُ إِلاَّ مَا إحَاطَة جَلاَ",50,"ل",2,0],["وَمَن ضيع الأَيّام في غَير صالح","وَلَم يُحسن الأَعمال فَهُوَ مضيع",51,"ع",1,0],["ومن ضراغم باقي العزّ من مضر","أوغُرّ قيلةَ أهل البأس والصفد",52,"د",1,0],["ومن ضمِّ القوامِ اللَّدنِ أزرى","بِغَضِّ أراكَةٍ وبغصِّ بانِ",53,"ن",1,0],["ومن ضحايا الغنم الذكور","خمسين عند هيكل البخور",54,"ر",1,0],["ومن ضاجعاتٍ بأفقِ المغيب","يراقبها كارتقابِ الرصد",55,"د",1,0],["ومن ضيوف بيته الحرام","صيرنا وزاد في الإنعام",56,"م",1,0],["وَمن ضَلَّ عَن سبل الهدى نابَهُ العمى","فَمن ذا الَّذي يَهديهِ أَو يَرفَع الغشا",57,"ش",2,0],["ومن ضيمها كادت تبيح طمرَّتي","من الضيم ما أخفيته تحت اطماري",58,"ر",2,0],["ومن ضفة النيل ليا دجله","جمع الطنايا امكفيني",59,"ن",2,0],["ومن ضاق ذرعاً دون ما رام سعيهُ","يُفرّج عنه الغم مرأه بالفسحِ",60,"ح",1,0],["ومن ضياءِ عيون الودِّ لي قبسٌ","ينيرُ عتمة أحزاني ويرقِيها!",61,"ه",2,0],["وَمِنْ ضُيُوْفِكَ رَنْتِيْسِيُّ أُمَّتِنَاْ **** عَبْدٌ عَزِيْزٌ بَنَىْ لِلْمَجْدِ رَفْرَاْفَاْ (15)","إِنِّيْ رَأَيْتُ نُجُوْمَ الْحَقِّ هَاْوِيَةً *** شَوْقاً إلَيْكُمْ، وَبَدْرَ الْمَجْدِ طَوَّاْفَاْ",62,"ف",2,0],["ومَن ضاقتِ الدنيا عليهِ ولم يَعُدْ","إلى اللهِ فالإيمانُ منهُ بَراءُ",63,"ا",2,0],["ومن ضل في بيد الضلالة هائماً","ولم يرعوِ إذ قال بألغى واختبل",64,"ل",1,0],["ومن ضل عن منهاجهم فهو غالطٌ","ومبتدع لا يدفع الحق باطله",65,"ل",2,0],["ومنضد فِيهِ الرِّيَاح سواكن","فَإِذا تحرّك آذَنت بهبوب",66,"ب",1,1],["ومِن ضعفنا أنّا نُقاتلُ بعضَنا","وبُلدانُنا للحربِ ساحتُها المثلى",67,"ا",1,0],["ومنضّدٌ بيد العناية رائع","كالدر أَضْحَى من صفاه عقيقا",68,"ق",2,0],["ومن ضحَّى بِمُنْيتِهِ","لكيلا تغْضَبَ الأمُّ؟",69,"م",1,0],["وَمِنض السِّياسَةِ أَن يُضَحِّي رَبُّها","بشوِدادِ أَيِّ أَخٍ وَأَيِّ صَديقِ",70,"ق",1,0],["ومِن ضَمِيرٍ لم أُطِعْ نُصْحَهُ","كأَنَّما يَطْلُبني المُسْتَحِيلْ!",71,"ل",1,0],["ومن ضرَبَ النّاسَ بالمرهفاتِ","على الدِّينِ ضَرْبَ عِرابِ الإبِلْ",72,"ل",1,0]]}