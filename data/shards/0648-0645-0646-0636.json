{"poems":[[53,"مقيم من الهم لا يقلع","https://www.aldiwan.net/poem29974.html","المتقارب"],[88,"لعمرك ما كل انكسار له جبر","https://www.aldiwan.net/poem45069.html","الطويل"],[72,"على مثلها فلتهم أعيننا العبرى","https://www.aldiwan.net/poem18716.html","الطويل"],[51,"لج الفؤاد فليس يلذعه","https://www.aldiwan.net/poem65413.html","أحذ الكامل"],[51,"تلون أخلاق الفتى من ملاله","https://www.aldiwan.net/poem65972.html","الطويل"],[43,"يذكرني فاتكا حلمه","https://www.aldiwan.net/poem10574.html","المتقارب"],[2,"قف بالديار التي لم يعفها القدم","https://www.aldiwan.net/poem25057.html","البسيط"],[58,"أقيك بنفسي أيها المصطفى الذي","https://www.aldiwan.net/poem30919.html","الطويل"],[46,"حياة عناء وموت عنا","https://www.aldiwan.net/poem22049.html","المتقارب"],[106,"كفكف دموعك","https://www.poetsgate.com/ViewPoem.aspx?id=179663",""],[51,"لجَّ الفؤادُ فليس يلذعه","https://www.poetsgate.com/ViewPoem.aspx?id=29595",""]],"verses":[["وَمَن ضاقَتِ الأَرضُ عَن هَمِّهِ","حَرٍ أَن يَضيقَ بِهِ مَضجَعُ",0,"ع",1,0],["ومن ضحكات الشعر دمعة عاشق","بها قد شكا للوصل ما فعل الهجر",1,"ر",1,0],["ومن ضامر الكشحين يسبق في غدٍ","إلى غايةٍ من أجلها تحمد الضّمرا",2,"ر",2,0],["ومنضَّد رقّت مراشفه","علا المدام به مشعشعه",3,"ع",2,0],["ومن ضنَّ أن أُعطىَ سِواه كمن رأى","جمالَ أخيه كافياً من جمالهِ",4,"ل",2,0],["وَمَن ضاقَتِ الأَرضُ عَن نَفسِهِ","حَرىً أَن يَضيقَ بِها جِسمُهُ",5,"م",2,0],["وَمِن ضَريبَتِهِ التَقوى وَيَعصِمُهُ","مِن سَيِّءِ العَثَراتِ اللَهُ وَالرَحِمُ",6,"م",1,0],["وَمَن ضَمَّني مُذ كُنتُ طِفلاً وَيافِعاً","وَأَنعَشَني بِالعِلِّ مِنهُ وَبِالنَهلِ",7,"ل",1,0],["وَمَن ضَمَّهُ جَدَثٌ لَم يُبَل","عَلى ما أَفادَ وَلا ما اِقتَنى",8,"ن",2,0],["ومن ضاق ذرعًا بدنياهُ، ضاقت","عليه، وإن هي كانت براحا",9,"ح",2,0],["ومنضَّدٍ رفَّتُ مَراشِفُه","علا المُدام به مُشعشعُهُ",10,"ع",2,0]]}