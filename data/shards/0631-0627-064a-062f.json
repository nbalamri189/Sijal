{"poems":[[53,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[242,"أبناء فاس من يفارقهم","https://www.aldiwan.net/poem19524.html","السريع"],[254,"تعناك نصب من أميمة منصب","https://www.aldiwan.net/poem2132.html","الطويل"],[310,"رائد سوف تراه","https://www.aldiwan.net/poem56515.html","مجزوء الرمل"],[333,"لا أنا خالد ولا أمنياتي","https://www.aldiwan.net/poem54952.html","الخفيف"],[438,"جفى مقلة الصب الكئيب هجوعها","https://www.aldiwan.net/poem12661.html","الطويل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104589","الخفيف"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106703","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205022","الوافر"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112317","الرمل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129328","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117929","الرمل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44912","الخفيف"],[4239,"","https://poetry.dctabudhabi.ae/diwan/poem/102201","الرجز"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81934","المتقارب"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67638","الخفيف"]],"verses":[["رأى داءَ مجد المرء فضل ثرائه","كما داءُ جسم المرء فضلُ المطاعمِ",0,"م",1,0],["رَائِدُهُمْ كَيْدٌ وَصَاحِبُهُمْ","خَبٌّ وَمَحْضُ الْمَكْرِ سَائِقُهُمْ",1,"م",1,0],["رَأى دُرَّةً بَيضاءَ يَحفِلُ لَونَها","سُخامٌ كَغِربانِ البَريرِ مُقَصَّبُ",2,"ب",1,0],["رائدٌ سوفَ تَراه","مَثلاً في الناسِ سائِر",3,"ر",1,1],["رائد الموكب الذي فجر الشع","ر ينابيع بالهوى دافقات",4,"ت",1,0],["رأى دَمَنا يشكو معالِمَها","شكَتْ كبِدٌ قد أوهنَتْها صُدوعُها",5,"ع",3,0],["رائداتُ العيونِ من يقفهنَّه","يجدِ الغيَّ تابعاً رُشدَهنَّه",6,"ن",2,1],["رأى دُونها بَحرَ الرَّدَى فأجازَهُ","بِهِ سَابِحٌ لكِن بسَاحَتِه الحُضرُ",7,"ر",1,0],["رأى دمه فصب عليه دمعا","وصاح وصوته نوح وندب",8,"ب",1,0],["رائداً إِلاّ إِذا عَزّ حماها","إنّني أرجو إِلَيهَا عَودَةً",9,"ه",1,0],["رأى درة بيضاء في آل مالك","تضيء لغواص البحار ركوب",10,"ب",1,0],["رائد الأعين عن إدراكها","قاصر لولا اللهيب المستعر",11,"ر",1,0],["رائدو ضَلةٍ وَأَهلو شَقاق","وَعَبيدٌ لِلأَصفرِ البَراقِ",12,"ق",1,0],["رائده في ذلك التدين","فذلكم من الطبيب يحسن",13,"ن",1,0],["رأى دمه عرضة للوجود","فأهرقه خيفة يعدم",14,"م",1,0],["رائداتُ الهوى سلبنَ فؤادي","فتبدّلت قَرْحةً باغتباط",15,"ط",1,1]]}