ور","https://www.poetsgate.com/ViewPoem.aspx?id=179206",""],[90,"يافا الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179202",""],[90,"سبيل الجَماهير","https://www.poetsgate.com/ViewPoem.aspx?id=178923",""],[90,"شباب يذوي !","https://www.poetsgate.com/ViewPoem.aspx?id=179111",""],[45,"أبا غانم فيما احشامك عندنا","https://www.poetsgate.com/ViewPoem.aspx?id=31408",""],[45,"يُفَنِّدونَ وَهُمْ أدْنَى إلى الفَنَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=31627",""],[45,"ألَمّتْ، وَهَلْ إلمامُها لكَ نَافِعُ","https://www.poetsgate.com/ViewPoem.aspx?id=31221",""],[99,"اكتبي لي","https://www.poetsgate.com/ViewPoem.aspx?id=36388",""],[51,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[86,"سمَا الخطيبانِ في المعالِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13044&r=&rc=0",""],[105,"ألا لا أرى في مصر إلا دعاويا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54862&r=&rc=32",""],[31,"قُلْ للَّذِي يَهْوَى تَفَرُّقَ بَيْنِنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19010&r=&rc=273",""],[20,"أتعرِف رسم الدار من أم معبد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69764&r=&rc=5",""],[53,"جَزاءُ أمِيرِ المُؤمِنِينَ ثَنَائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9803&r=&rc=0",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""],[96,"موت الشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66379&r=&rc=55",""],[96,"فلسطين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=5761&r=&rc=0",""],[10,"لهفي عَلَى صخرٍ فانّي اَرَى لهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10483&r=&rc=8",""]],"verses":[["فَلَستُ أَرى إِلّا عَدُوّاً مُكاشِفاً","وَلَستُ أَرى إِلّا صَديقاً مُداجِيا",0,"ي",2,0],["فَلَستَ أَوَّلَ مَن راقَت لَهُ حُلَلٌ","وَلَستَ أَوَّلَ مَن راحَت لَهُ نَعَمُ",1,"م",1,0],["فَلَستُ اِبنَ أُمِّ الخَيلِ إِن لَم أَمِل بِها","عَوابِسَ في دارِ العَدوِّ أُبيلُها",2,"ل",3,0],["فَلَستُ بِالخامِلِ مِن غارِبي","عَلى سَنامِ النَقِبِ الأَظلَعِ",3,"ع",1,0],["فَلَسَطوَةُ الضَرغامِ أَجمَلُ بِالفَتى","مِن أَن يُرى عالٍ عَليهِ السيدُ",4,"د",1,0],["فَلَستُ اِبنَ أُمِّ الخَيلِ إِن لَم تَعُد بِها","عَوابِسَ تَأبى الضَيمَ مِثلَ إِبائي",5,"ا",2,0],["فَلَستُ بحاصِنٍ إِن لَم أُزِرها","عَلى نَهَلٍ شَبا الأَسَلِ الطِّوالِ",6,"ل",1,0],["فَلَسْتُ ابْنَ أُمِّ المَجدِ إِنْ أُغْمدِ الظُّبا","وَغَيْري بِأَذْيالِ العُلا يَتَمَسَّكُ",7,"ك",1,0],["فَلَسْتُ أَدْري وَذَيْلُ اللَّيْلِ يَسْتُرَنا","أَتِلْكَ في حُسْنِها أَبْهى أَمِ القَمرُ",8,"ر",1,0],["فَلَسْتُ ابْنَ مَنْ سَادَ الأَنَامَ وَقادَهُمْ","لَئِنْ لَمْ أُرَوِّ الرُّمْحَ مِنْ ثُغَرِ العِدَا",9,"د",2,0],["فَلَسْتُ لِحاصِنٍ إِنْ لَمْ أَقُدْها","عَوابِسَ تَحْتَ أَغْلِمَةٍ كَجِنِّ",10,"ن",1,0],["فَلَسْتُ إِذا النَّوائِبُ أَجْهَضَتْنِي","بِواهٍ في الخُطوبِ وَلا مَكيثِ",11,"ث",1,0],["فلَسْنا نَرى إلا كَريماً يَهزُّهُ","حُداءٌ سَرى عنهُ رِداءَ مُهَلْهَلا",12,"ل",2,0],["فلَسْتُ أدري أمِنْ دَمْعٍ أُرَقْرِقُهُ","أم مِنْ مَباسِمها ما في تَراقِيها",13,"ي",3,0],["فلَسْتُ منَ الهَوانِ ولَيسَ منّي","فألْبَسَهُ وأدَّرِعَ الخُمولا",14,"ل",2,0],["فلَستُ أدري وقد أتْبَعْتُهُنَّ ضُحىً","طَرْفي ولَيسَ على قلبي بمأمونِ",15,"ن",1,0],["فَلَستُ ذاكَ بِحَمدِ اللَهِ تَمنَعُني","مِنهُ ظَلومُ وَحَظٌّ عاقَهُ الزَمَنُ",16,"ن",1,0],["فَلَستُ بِمُبتاعٍ وِصالاً بِوَصلِها","وَلَستُ بِمُفشٍ سِرَّها حينَ أَغضَبُ",17,"ب",1,0],["فلَسْتُ منَ اللّطْفِ الخَفيّ بيائِسٍ","فكمْ منْ بُكاءٍ كانَ عنْهُ سُرورُ",18,"ر",1,0],["فَلَستُ بِجازيكَ المَلامَةَ إِنَني","أَرى العَفوَ أَدنى لِلسَّداد وَأَوسَعا",19,"ع",2,0],["فَلَسنا لِباغي المُهمَلاتِ بِقِرفَةٍ","إِذا ما طَها بِاللَيلِ مُنتَشِراتُها",20,"ت",3,0],["فَلَستُ بِمُبصِرٍ شَيئاً يَراهُ","وَليسَ بِسامِعٍ مِنّي حِواري",21,"ي",1,0],["فَلَسنا مِنهُمُ وَالشَرقُ عانى","إِذا لَم نَكفِهِ عَنَتَ الزَمانِ",22,"ن",1,0],["فَلَستُ أَدري عَلى اِختِباري","مَن مِنهُما جَلَّ أَن يُحاكى",23,"ك",2,0],["فَلَستُ مِمَّن سَمَت بِالشِعرِ هِمَّتُهُم","إِلى المُلوكِ وَلا ذاكَ الفَتى العَرَبي",24,"ب",2,0],["فَلَستُ بِناسيها وَلَستُ بِتارِكٍ","إِذا أَعرَضَ الأُدمُ الجَوازي سُؤالَها",25,"ل",3,0],["فَلَستُ بِناسيهِ وَإِن حيلَ دونَهُ","وَجالَ بِأَحوازِ الصَحاصِحِ مورُها",26,"ر",3,0],["فَلَستَ بِزائِلٍ تَزدادُ شَوقاً","إِلى أَسماءَ ما سَمَرَ السَميرُ",27,"ر",1,0],["فَلَستُ طِوالَ الدَّهرِ ما عِشتُ ناسيًا","عظامًا وَلا هَامًا لَهُ قَد أَرَمتِ",28,"ت",1,0],["فَلَستُ أَرَزّا بَعدَهُ بِرَزِيَّةٍ","فَأَذكُرَهُ إِلّا سَلَت وَتَجَلَّتِ",29,"ت",1,0],["فِلَسْطِينُ المُصَابَةُ ذُدْتِ عَنْهَا","مِنَ الإِبْهَامِ وَالكَيْدِ الخَفِيِّ",30,"ي",1,0],["فَلِساناً تَنْضُو بِهِ نَدْوَةُ النُّوَّا","بِ عَضْباً فِي وَجْهِ كُلِّ غَشُومِ",31,"م",1,0],["فَلَستَ تَلقاهُ شاكِراً لِيَدٍ","قَد كَدَّها المَطلُ آخرَ الأَبَدِ",32,"د",1,0],["فلست وقد تجدّد لي غرام","أبالي لوم ألسنة رثاث",33,"ث",1,0],["فلسنا وإن عضّت بنا اليوم نابُها","نقرّ على ذلّ وننقاد عن ذُعر",34,"ر",1,0],["فلست أبالي بعد أن جَدَّ بَينهُم","زجرت كلاباً أم قَحَمْت سباعا",35,"ع",2,0],["فلسنا من صروف الدهر نخشى","عوادي ذات سلب وابتزاز",36,"ز",1,0],["فَلَستَ مُفارِقاً قَرَنَيَّ حَتّى","يَطولَ تَصَعُّدي بِكَ وَاِنحِداري",37,"ر",2,0],["فَلَستُ بِناسٍ ما تَغَنَّت حَمامَةٌ","وَلا ما ثَوى بَينَ الجَناحَينِ زَفزَفُ",38,"ف",1,0],["فَلَستَ بِوافٍ بِالزُبَيرِ وَرَحلِهِ","وَلا أَنتَ بِالسيدانِ بِالحَقِّ تُنصِفُ",38,"ف",1,0],["فَلَستُ بِرُكنٍ مِن أَبانٍ وَصاحَةٍ","وَلا الخالِداتِ مِن سُواجٍ وَغُرَّبِ",39,"ب",1,0],["فَلَستَ بِلاقٍ ناشِئً مِن شَبابِنا","وَإِن كانَ أَندى مِن سِوانا وَأَحوَلا",40,"ل",2,0],["فَلَستُ لِحاصِنٍ إِن لَم تَزُركُم","خِلالَ الدارِ مُشعَلَةٌ طَحونُ",41,"ن",1,0],["فَلَستَ إِلى الذَوائِبِ مِن قُصَيٍّ","وَلا في عِزِّ زُهرَةَ إِذ تُسامي",42,"م",2,0],["فَلَستَ بِخَيرٍ مِن أَبيكَ وَخالِهِ","وَلَستَ بِخَيرٍ مِن مُعاظَلَةِ الكَلبِ",43,"ب",1,0],["فلستُ أكرهُ شيئاً أنتَ صانعهُ","مهما صنعتَ فمشكورٌ ومحمود",44,"د",1,0],["فلست أدري وقد طال الزمان به","على الزَّكاة أحلتم أم على الحشر",45,"ر",1,0],["فلستُ الدهرَ هاجِيَهُ حياتي","ولكنِّي سأهجو مَنْ هجاهُ",46,"ا",2,0],["فلستُ مسمِّياً بُشراك نَعْياً","وإِن أوعدتَ نفسي بالذَّهابِ",47,"ب",1,0],["فلستَ تنفكُّ محتجّاً لفاحشةٍ","شنعاءَ تركبُ منها شرَّ مرتكبِ",48,"ب",1,0],["فلستَ