ps://www.aldiwan.net/poem12010.html","الطويل"],[514,"ونزور سيدنا وسيد غيرنا","https://www.aldiwan.net/poem48690.html","الكامل"],[536,"يا من تكفل لمن دعاه","https://www.aldiwan.net/poem47447.html","عموديه"],[536,"حبيبة بحبها الحسن أمر","https://www.aldiwan.net/poem48126.html","عموديه"],[549,"قد مضى شهر الصيام","https://www.aldiwan.net/poem47208.html","مجزوء الرمل"],[549,"هل ليالي بالمنقى رجوع","https://www.aldiwan.net/poem47718.html","الخفيف"],[551,"قل لمن تاه إذ بنا عز جهلا","https://www.aldiwan.net/poem68326.html","الخفيف"],[556,"هما الضدان في الأشياء آلا","https://www.aldiwan.net/poem33576.html","الوافر"],[556,"قضى الأمر وجف القلم","https://www.aldiwan.net/poem34195.html","الرمل"],[556,"في الكون للحق أمثال بها نطقا","https://www.aldiwan.net/poem34300.html","البسيط"],[556,"خذوا علمكم بالله لا تتأخروا","https://www.aldiwan.net/poem34489.html","الطويل"],[573,"من فر منك فما يلام","https://www.aldiwan.net/poem3009.html","مجزوء الكامل"]],"verses":[["وَنِزاعاً لا وُرودَ لَهُ","يَعجُمُ الحَوذانَ وَالنَفَلا",0,"ل",2,0],["وَنَزَعتُ وَجداً كانَ يَشمَخُ كُلَّما","أَغرى المَلامُ بِهِ وَلَجَّ العُذَّلُ",1,"ل",1,0],["وَنِزاعٌ يَهفو إِلَيهِ بِلُبّي","هَفَواتِ المُصَرصِرِ الغِطريفِ",2,"ف",1,0],["وَنِزاعٌ إِلى العُلى يَفطِمُ العي","سَ عَنِ الوِردِ بَينَ ماءٍ وَعُشبِ",3,"ب",1,0],["ونَزَلْتُ أفتَرشُ الثَّرى مُتَلوِّياً","فيهِ تلوِّيَ حيَّةٍ رَقْشاءِ",4,"ا",2,0],["وَنِزَاعِهَا المُحْيِي المُمِيتِ مَعاً","بَيْنَ الصَّفَاءِ النَّزْرِ وَالأَلَمِ",5,"م",1,0],["وَنَزَعْنَا عَنِ الْغَوَايَةِ فِي الْغَا","يَةِ مِنْ ظَرْفِهَا إِلَى التَّحْلِيمِ",6,"م",1,0],["ونُزَحّي إلى القبور نذوراً","فضحايا مسوقةٌ وحُمول",7,"ل",1,0],["وَنَزيعُنا قَد سادَ حَيِّي وائِلٍ","مُعطي الجَزيلِ مُساوِرُ بنُ رِئابِ",8,"ب",1,0],["وَنَزَعنَ مِن داُوّدَ أَحسَنَ صُنعِهِ","وَلَقَد يَكونُ بِقُوَّةٍ وَنَعيمِ",9,"م",1,0],["ونزور مسلمة المهذ","ب بالمؤبدة السوائرْ",10,"ر",1,1],["وَنَزَلتُ مِن بَلَدِ الجَزيرَةِ مَنزِلاً","خِلواً مِنَ الخُلَطاءِ وَالنُدَماءِ",11,"ا",2,0],["ونزَّهت فكري في بدائعِ حسنهِ","وفي عقلِ عذَّالي على أنها تغري",12,"ر",2,0],["ونزلت عن ظهر المطية لاثماً","وجه الثرى فرحاً بنثر الأدمع",13,"ع",1,0],["ونَزْرُ نوالك عند الذي","يجود به سائر الناس غَمرُ",14,"ر",1,0],["وَنُزهَتي أَنتَ فَلِم","حَرَّمتَ عَيني نَظَرَك",15,"ك",1,0],["ونزقه ونسوسه","ونحبه ونقربه",16,"ب",2,0],["وَنَزَلَت توّاً تُغيثُ الكَلبا","وَنَقَرَتهُ نَقرَةً فَهَبّا",17,"ب",2,0],["وَنَزَلَ البَصيرُ ذا اِكتِئابِ","يَشكو إِلى الفيلِ مِنَ المُصابِ",18,"ب",1,0],["وَنَزيلَ المُتَوَّجي","نَ النَديمَ المُقَرَّبا",19,"ب",2,0],["ونزلتُ عن أحوى جَمومٍ سابحٍ","وحملتُ بَزِّي فوقَ أشهبَ رازحِ",20,"ح",1,0],["ونَزَلنا بكلِّ مُجتَدِبِ المن","زِلِ نَرْعى لديه رَبعاً جَديبا",21,"ب",2,0],["ونزعها السهم من قلبي كموقعه","فيه وكل أليم المس موجِعُهُ",22,"ع",2,0],["ونزولَ هواكَ بمنزلةٍ","كَتَبَتْ زمناً ومحتْ زمنا",23,"ن",2,0],["ونزعتَ أثوابَ الشبابِ جديدةً","لهفي عليها عنْ جمالِكَ تُنزعُ",24,"ع",1,0],["ونزَّهْتُ نفسي منْ زحامِ الورى على","ركيٍّ بكيٍّ لا يبضُّ شحيحُها",25,"ح",3,0],["وَنَزَلتُ مِن خِصبٍ بِأَمرَعَ مَنزِلٍ","وَحَلَلتُ مِن أَمنٍ بِرَأسِ يَلَملَمِ",26,"م",1,0],["ونَزَلتَ من غُرَفِ الجِنان بناضرٍ","بَهِجِ القطينِ مُنَعَّم الجيرانِ",27,"ن",1,0],["ونزدري المالَ إلا أن تفيض به","دقَّاتُ قلبٍ بنجوى الحبِّ رنَّانِ",28,"ن",1,0],["ونَزعَتُ الأُوراقَ عنها تِباعاً","أتحرَّى شكِّي بها ويقيني",29,"ي",1,0],["وَنَزلتَ عَن عِرضِ الذَلي","لِ بِمَنزِلٍ أَشِبِ المَعاقِل",30,"ل",1,0],["وَنَزَّلَت إِحدى الكُبَر","وَقيلَ صَمّاءُ الغِيَر",31,"ر",1,0],["ونزلتُ أستذري الظلالَ فعِفنني","حتى الغصون غدونَ غير غصونِ",32,"ن",1,0],["ونزلنا عِند شطٍّ من نُضارِ","وانتحينا خلوةً بعد زحامِ",33,"م",1,0],["ونزوعاً إلى السفي","نِ تهيأنَ للسَّفَرْ",34,"ر",1,0],["ونزل النصر من السماء","مؤزرا مجلّيَ الغمّاء",35,"ا",2,0],["ونزه البيت عن الاوثان","والله عن ند له أو ثان",35,"ن",1,0],["ونزعة الناس إلى أوطانها","كنزعة الإبل إلى أعطانها",36,"ه",2,0],["وَنَزَعْتُ عَنْ نَزَقِ الشَّبِيبَةِ وَالصِّبَا","بَعْدَ الْمَشِيبِ وَلِلشَّبَابِ نِزَاقُ",37,"ق",1,0],["ونزائعاً مثلَ السِّراحِ نَما بها","علَفُ الشَّعيرِ وجِزَّةُ المقضابِ",38,"ب",1,0],["ونزهتكِ البديعةُ ما أحيلى","وما أبهَى اتَساقاً وانسجاما",39,"م",2,0],["ونزاهة سِيقَتْ لها الدنيا فما","ظفِرتْ بغير تنكُّرٍ وعِيافِ",40,"ف",1,0],["ونزول الماجدِ الحُرِّ به","من قديم سُنَّةٌ مُتَّبَعه",41,"ع",2,0],["ونزلتُ منه على الطبيعة منزلاً","الفيتُني فيه على جَمر الغَضا",42,"ض",2,0],["ونزورُه صبحاً فنلثِمُهُ","ونَضُمُّهُ ونَشَمُّهُ ألفا",43,"ف",2,0],["وَنَزه مِن دِمائَهُم سُيوفاً","بِهامات المُلوك لَها غُمود",44,"د",1,0],["ونزلت في وادي الهوى متفيئاً","للموت ظلّاً ينسخ الآجلا",45,"ل",2,0],["ونزهة موت من قدمات مندرجا","في عشرةٍ فاذكروا لا تنسوا المثلا",46,"ل",2,0],["ونزحنا الدموع سَحاًّ وبلاً","وأقمنا الضلوعَ وجدا وحُزنا",47,"ن",2,0],["ونزلت من أعلى لأسفل روعة","يا وحشتاه لمنزلي المعمور",48,"ر",1,0],["ونزعتها شيئاً فشيئاً منهم","بالرأي لا حرب ولا استعدادُ",49,"د",1,0],["ونزلتَ في قَلبي ولا عجبٌ","فالقلبُ بعضُ منازِل القَمَرِ",50,"ر",1,0],["وَنَزَلتُ حَيثُ المَكرُماتُ وَقُمتُ في","حَيثُ اِبتَنى المَجدَ المُؤَثَّلَ وَالعُلى",51,"ل",2,0],["ونَزلتُمُ مني وَإنْ لم تُنصِفوا","بمَنازلِ الأرواحِ في الأجساد",52,"د",1,0],["وَنزّهِ اللَّه عن شبهٍ وعن جهةٍ","بِالغيبِ آمن وَصُنه في تغيّبهِ",53,"ب",2,0],["وَنِزالٍ في يوم سلمٍ وقتلِ","وَفَدَوه بكلّ نفسٍ وأهلِ",54,"ل",1,0],["وَنَزا مِن عَرينه تَشَظّى","حممٌ مِن لَظاه في الزمهريرِ",55,"ر",1,0],["ونُزِّل فِيه بالتفضِي","لِ والتعظِيم قرآن",56,"ن",1,0],["ونزّهتُه دهراً فلمّا هززتَني","هززتَ حساماً ليس ينبو له حَدّ",57,"د",1,0],["ونَزهْتُ طَرْفِي في محاِسِن وجنَةٍ","تُريكَ كمالَ البدْرِ في ناعِمِ القُضْبِ",58,"ب",1,0],["ونزّه رب العرش عن والد وعن","قرين ومولود وثانٍ وثالث",59,"ث",1,0],["وَنَزَعتُ مِن خِدري إِلَيكَ عَقيلَةً","كانَت يَدايَ بِها تَضَنُّ وَتَبخَلُ",60,"ل",1,0],["وَنَزِّهْنَا عَنْ أَغْرَاضِ الْعِبَادِ","وَسَدِّدْنَا إِلَى طُرْقِ السَّدَادِ",61,"د",1,0],["وَنزلن من كنفي سهام بساحمة ال","قمر المنير سنا سما الايمان",62,"ن",1,0],["وَنزلت من حرم الحجاز بما جد","من آل غالب قاهر غلاب",63,"ب",1,0],["ونزّه السعي عن رياءٍ","فلا جهادٌ مع الغلول",64,"ل",1,0],["وَنَزلنا عَن مَعاريجِ الصّبا","مذ نَزَلْتُم ذلكَ المُنْعَرَجا",65,"ج",2,0],["ونزَّهت شعري عن هجاءٍ ومدحةٍ","وَلَولا الهوى ما كنت أطري الغوانيا",66,"ي",2,0],["ونزه الصدر من غش ومن حسد","وجانب الكبريا مسكين والعجب",67,"ب",1,0],["ونزيل مرباط إمام جامع","أصل لأشياخ الطريق مفرع",68,"ع",1,0],["ونزعت من أهل الجريد غواية","كانت بهم أبداً تجد وتهزل",69,"ل",1,0],["وَنِزَاعُ الجِيرانِ ذا البابُ بَابي","وَطَرِيقي وَذا الجِدارُ جِدَاري",70,"ي",1,0],["وَنُزْهَةُ الفُسَّاقِ في بَيتهِ ذا","والماءُ والخُضْرَةُ والوَجْهُ الحَسَنْ",71,"ن",1,0],["وَنَزَّهتُ عَن كَونِ المَكانِ كَيانَها","وَأَوصافَها عَن رُؤيَةِ الحَدَثِيَّةِ",72,"ه",1,0],["وَنزه الطَرف في أَغصان دوحَتها","وَاِنسَب لِبَهجَتِها ما شِئت مِن عَظم",73,"م",1,0],["ونزلتُ من أقصى مدَى نَظَرِي","ليدِ المطيّةِ لاثِماً شُكرا",74,"ر",2,0],["ونزهوها عن أقوال الخنا والدناه","وكل مستقذر أو رائحه مشتناه",75,"ا",2,0],["ونزَّهني في روضةٍ من خدودِه","وأسكَرني من ريقهِ بمُدامِ",76,"م",1,0],["ونزال فرسان الهياج وكلهم","فوق لهول تقحمي ومقامي",77,"ي",1,0],["ونزِّه الألحاظ ما بين الربى","في ذلك الغض النزيه الخصب",78,"ب",1,0],["ونُزِّلَ المَنُّ عليهم مع السَّ","لْوَى كما اختاروا من القصدِ",79,"د",1,0],["ونزعتَ ثوبَ توعّكٍ لا ينثَني","ولبسْتَ خلعةَ صحةٍ لن تُخْلَعا",80,"ع",2,0],["وَنَزْعَزعَت لمصابها وَتَنَكَّدَتْ","أَسَفاً بلادُ الْهِنْدِ والسِّندانِ",81,"ن",1,0],["وَنَزَتْ بِهِنَّ عن الآرائِكِ رَوْعَةٌ","مَهَدَتْ لَهُنَّ حُزُونَ كُلِّ يَبابِ",82,"ب",1,0],["ونزهت عرض الشعر عن شكر ناقصٍ","وأكرمته عن هجو من لا يكرم",83,"م",1,0],["ونزاوعاً باتت تسا","ورني ومالي من مجيب",84,"ب",1,0],["ونزلتَ في مضر وقومُك غيرهُم","بعد الممات بأشرف الأقوامِ",85,"م",1,0],["ونزت بنيَّاتُ الفؤاد لصوته","نزوَ الفصائِل في زفير المرجَلِ",86,"ل",1,0],["ونزلتَ حيث تقرُّ عينُك لا كما","كانت عيون الحزن حولك تهمِلُ",87,"ل",1,0],["ونزلتَ حيث تُحَطُّ أملاكُ العلا","شوقاً إليك وتُرفَعُ الأوزارُ",88,"ر",1,0],["ونزعٌ بأطماعٍ ضعافٍ تمدُّها","أمانيُّ لم يَقبَلْ يميناً مُعيرُها",89,"ر",3,0],["ونزلتُ في غُرفِ العلا متظلّلاً","بالعزّ تحت رواقها المضروبِ",90,"ب",1,0],["ونزحن بالدهناء عن جَدَد السُّرى","فوطئن في يربوعها المتقصِّعِ",91,"ع",1,0],["ونزهته عن جاهل بمكانه","وما حاجة النكس الجبان إلى العضب",92,"ب",1,0],["ونزَّة عن ذلّ المطامع همّتي","فمالي في شيء وأن جلّ مطمع",93,"ع",1,0],["وَنَزَّهتُ عَقلِيَ في رَوضَةٍ","عَلى زَهرِ أَلفاظِكَ الزاهِرِ",94,"ر",1,0],["وَنَزَعتُ لا في السُكرِ خُنتُ تَصَوُّني","بِخَناً وَلا في الصَحوِ شِنتُ تَجمَلى",95,"ل",2,0],["وَنَزَّهتُ عَن غَيرِ الدَنانيرِ قَدرَها","فَما زِلتُ مِنها أَشرَبُ التَبرَ بِالتبرِ",96,"ر",1,0],["وَنَزَّه عَن غَيرِ الصَفاءِ اِجتِماعَنا","فَكُنتُ وَإِيّاهُ كَقَلبَينِ في صَدرِ",96,"ر",1,0],["ونزَعْتُ عن كلِّ الوُجودِ عَلائِقي","وطرَحْتُ رُمحي مُقْلِعاً وسِناني",97,"ي",1,0],["وَنَزَلنا بِوارِداتٍ إِلَيهِم","فَتَوَلَّوا وَلَم يُطيقوا النُزولا",98,"ل",2,0],["ونزري عليها جاهدين بألسن","تخالفها بالاعتقاد قلوب",99,"ب",1,0],["وَنزور سَيِّدنا وَسَيِّد غَيرِنا","لَيتَ التَشكّي كانَ بِالعواد",100,"د",1,1],["ونَزلَت مني هُناكَ أدمُعُ","ينقطعُ الغيثُ ولا تَنقَطِعُ",101,"ع",1,0],["ونُزهةُ الأبصارِ والأسماعِ","مَن كَلَّ في أوصافِها يراعي",102,"ي",1,0],["ونُزوحٍ عن حذارٍ","وبلوغٍ لمرامِ",103,"م",1,0],["ونزاعٌ ما إنْ يُخاف وإن أك","ثَرَ عذّالَه إليه النُّزوعُ",104,"ع",1,0],["وَنِزاراً فَفاخِروا هُم تَفَضَّلوا","وَدَعوا مَن لَهُ عَبيدُ نِزارُ",105,"ر",1,0],["ونزه نفسه عن كل شيء","بليس كمثله شيءٌ تعالى",106,"ل",2,0],["ونزلنا عُرْبَ وادي سلمٍ","واحتوانا ضالُهم والسلَم",107,"م",1,0],["ونزهوه وقولوا عنه خالقنا","ما إن له غيبة فاليوم يوم لقا",108,"ق",2,0],["ونزهه عن محسوس حسك دائماً","ومعقول عقل الكل فالله أكبر",109,"ر",1,0],["ونزيلُ راحتِك النَّدى","وحليفُ دوليتِك الدَّوَامُ",110,"م",1,0]]}