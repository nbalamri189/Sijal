","https://www.poetsgate.com/ViewPoem.aspx?id=111425",""],[5616,"نطيحة","https://www.poetsgate.com/ViewPoem.aspx?id=203339",""],[5688,"وهكذا تآخينا","https://www.poetsgate.com/ViewPoem.aspx?id=200931",""],[5690,"للعدل والإصلاح أنت كفيلُ","https://www.poetsgate.com/ViewPoem.aspx?id=172177",""],[5703,"ستبقى أميراً","https://www.poetsgate.com/ViewPoem.aspx?id=214518",""],[5725,"عربسان","https://www.poetsgate.com/ViewPoem.aspx?id=207284",""],[5759,"مقيمة","https://www.poetsgate.com/ViewPoem.aspx?id=212849",""],[5776,"عامُ الأبابيلِ اليمانية...","https://www.poetsgate.com/ViewPoem.aspx?id=203647",""],[402,"رب البيان وسيدا لقلم","https://www.poetsgate.com/ViewPoem.aspx?id=36326",""],[5842,"ندعوك يا خير من مُدَّت إليه يَدُ \\ محمد حسام الدين","https://www.poetsgate.com/ViewPoem.aspx?id=127639",""],[5893,"شهر النصر","https://www.poetsgate.com/ViewPoem.aspx?id=142378",""],[5897,"منصة العرفان","https://www.poetsgate.com/ViewPoem.aspx?id=157484",""],[5956,"بالي عليكم دائماً مشغولُ","https://www.poetsgate.com/ViewPoem.aspx?id=203724",""],[5956,"لَمْ أشبع منك ولن أشبعْ","https://www.poetsgate.com/ViewPoem.aspx?id=206807",""],[5969,"سِفرُ الخلاصْ","https://www.poetsgate.com/ViewPoem.aspx?id=198863",""],[5974,"غربة","https://www.poetsgate.com/ViewPoem.aspx?id=208112",""],[5997,"لا تخشي","https://www.poetsgate.com/ViewPoem.aspx?id=214204",""],[6003,"أحبك","https://www.poetsgate.com/ViewPoem.aspx?id=188923",""],[6093,"القصيدة الزبيدية في مدح خير البرية","https://www.poetsgate.com/ViewPoem.aspx?id=195006",""],[6096,"من دون وداع","https://www.poetsgate.com/ViewPoem.aspx?id=177528",""],[6102,"فوائد الحقد","https://www.poetsgate.com/ViewPoem.aspx?id=182744",""],[6114,"ما الحسنُ إلا بطَرْفٍ أحرزَ الدَّعَجا","https://www.poetsgate.com/ViewPoem.aspx?id=120391",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6213,"أفي السلم نحيا!!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76302&r=&rc=50",""],[433,"نومة الراعي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87053&r=&rc=6",""],[6338,"أضاء لها فجر النهى فنهاها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52540&r=&rc=2",""]],"verses":[["وَنِزاعاً لا وُرودَ لَهُ","يَعجُمُ الحَوذانَ وَالنَفَلا",0,"ل",2,0],["وَنَزَعتُ وَجداً كانَ يَشمَخُ كُلَّما","أَغرى المَلامُ بِهِ وَلَجَّ العُذَّلُ",1,"ل",1,0],["وَنِزاعٌ يَهفو إِلَيهِ بِلُبّي","هَفَواتِ المُصَرصِرِ الغِطريفِ",2,"ف",1,0],["وَنِزاعٌ إِلى العُلى يَفطِمُ العي","سَ عَنِ الوِردِ بَينَ ماءٍ وَعُشبِ",3,"ب",1,0],["ونَزَلْتُ أفتَرشُ الثَّرى مُتَلوِّياً","فيهِ تلوِّيَ حيَّةٍ رَقْشاءِ",4,"ا",2,0],["وَنِزَاعِهَا المُحْيِي المُمِيتِ مَعاً","بَيْنَ الصَّفَاءِ النَّزْرِ وَالأَلَمِ",5,"م",1,0],["وَنَزَعْنَا عَنِ الْغَوَايَةِ فِي الْغَا","يَةِ مِنْ ظَرْفِهَا إِلَى التَّحْلِيمِ",6,"م",1,0],["ونُزَحّي إلى القبور نذوراً","فضحايا مسوقةٌ وحُمول",7,"ل",1,0],["وَنَزيعُنا قَد سادَ حَيِّي وائِلٍ","مُعطي الجَزيلِ مُساوِرُ بنُ رِئابِ",8,"ب",1,0],["وَنَزَعنَ مِن داُوّدَ أَحسَنَ صُنعِهِ","وَلَقَد يَكونُ بِقُوَّةٍ وَنَعيمِ",9,"م",1,0],["ونزور مسلمة المهذ","ب بالمؤبدة السوائرْ",10,"ر",1,1],["وَنَزَلتُ مِن بَلَدِ الجَزيرَةِ مَنزِلاً","خِلواً مِنَ الخُلَطاءِ وَالنُدَماءِ",11,"ا",2,0],["ونزَّهت فكري في بدائعِ حسنهِ","وفي عقلِ عذَّالي على أنها تغري",12,"ر",2,0],["ونزلت عن ظهر المطية لاثماً","وجه الثرى فرحاً بنثر الأدمع",13,"ع",1,0],["ونَزْرُ نوالك عند الذي","يجود به سائر الناس غَمرُ",14,"ر",1,0],["وَنُزهَتي أَنتَ فَلِم","حَرَّمتَ عَيني نَظَرَك",15,"ك",1,0],["ونزقه ونسوسه","ونحبه ونقربه",16,"ب",2,0],["وَنَزَلَت توّاً تُغيثُ الكَلبا","وَنَقَرَتهُ نَقرَةً فَهَبّا",17,"ب",2,0],["وَنَزَلَ البَصيرُ ذا اِكتِئابِ","يَشكو إِلى الفيلِ مِنَ المُصابِ",18,"ب",1,0],["وَنَزيلَ المُتَوَّجي","نَ النَديمَ المُقَرَّبا",19,"ب",2,0],["ونزلتُ عن أحوى جَمومٍ سابحٍ","وحملتُ بَزِّي فوقَ أشهبَ رازحِ",20,"ح",1,0],["ونَزَلنا بكلِّ مُجتَدِبِ المن","زِلِ نَرْعى لديه رَبعاً جَديبا",21,"ب",2,0],["ونزعها السهم من قلبي كموقعه","فيه وكل أليم المس موجِعُهُ",22,"ع",2,0],["ونزولَ هواكَ بمنزلةٍ","كَتَبَتْ زمناً ومحتْ زمنا",23,"ن",2,0],["ونزعتَ أثوابَ الشبابِ جديدةً","لهفي عليها عنْ جمالِكَ تُنزعُ",24,"ع",1,0],["ونزَّهْتُ نفسي منْ زحامِ الورى على","ركيٍّ بكيٍّ لا يبضُّ شحيحُها",25,"ح",3,0],["وَنَزَلتُ مِن خِصبٍ بِأَمرَعَ مَنزِلٍ","وَحَلَلتُ مِن أَمنٍ بِرَأسِ يَلَملَمِ",26,"م",1,0],["ونَزَلتَ من غُرَفِ الجِنان بناضرٍ","بَهِجِ القطينِ مُنَعَّم الجيرانِ",27,"ن",1,0],["ونزدري المالَ إلا أن تفيض به","دقَّاتُ قلبٍ بنجوى الحبِّ رنَّانِ",28,"ن",1,0],["ونَزعَتُ الأُوراقَ عنها تِباعاً","أتحرَّى شكِّي بها ويقيني",29,"ن",2,0],["وَنَزلتَ عَن عِرضِ الذَلي","لِ بِمَنزِلٍ أَشِبِ المَعاقِل",30,"ل",1,0],["وَنَزَّلَت إِحدى الكُبَر","وَقيلَ صَمّاءُ الغِيَر",31,"ر",1,0],["ونزلتُ أستذري الظلالَ فعِفنني","حتى الغصون غدونَ غير غصونِ",32,"ن",1,0],["ونزلنا عِند شطٍّ من نُضارِ","وانتحينا خلوةً بعد زحامِ",33,"م",1,0],["ونزوعاً إلى السفي","نِ تهيأنَ للسَّفَرْ",34,"ر",1,0],["ونزل النصر من السماء","مؤزرا مجلّيَ الغمّاء",35,"ا",2,0],["ونزه البيت عن الاوثان","والله عن ند له أو ثان",35,"ن",1,0],["ونزعة الناس إلى أوطانها","كنزعة الإبل إلى أعطانها",36,"ه",2,0],["وَنَزَعْتُ عَنْ نَزَقِ الشَّبِيبَةِ وَالصِّبَا","بَعْدَ الْمَشِيبِ وَلِلشَّبَابِ نِزَاقُ",37,"ق",1,0],["ونزائعاً مثلَ السِّراحِ نَما بها","علَفُ الشَّعيرِ وجِزَّةُ المقضابِ",38,"ب",1,0],["ونزهتكِ البديعةُ ما أحيلى","وما أبهَى اتَساقاً وانسجاما",39,"م",2,0],["ونزاهة سِيقَتْ لها الدنيا فما","ظفِرتْ بغير تنكُّرٍ وعِيافِ",40,"ف",1,0],["ونزول الماجدِ الحُرِّ به","من قديم سُنَّةٌ مُتَّبَعه",41,"ع",2,0],["ونزهو كأنا ملكنا الوجود º","وكان لنا قبل أن يوجدا",42,"د",2,0],["ونزلتُ منه على الطبيعة منزلاً","الفيتُني فيه على جَمر الغَضا",43,"ض",2,0],["ونزورُه صبحاً فنلثِمُهُ","ونَضُمُّهُ ونَشَمُّهُ ألفا",44,"ف",2,0],["وَنَزه مِن دِمائَهُم سُيوفاً","بِهامات المُلوك لَها غُمود",45,"د",1,0],["ونزلت في وادي الهوى متفيئاً","للموت ظلّاً ينسخ الآجلا",46,"ل",2,0],["ونزهة موت من قدمات مندرجا","في عشرةٍ فاذكروا لا تنسوا المثلا",47,"ل",2,0],["ونزحنا الدموع سَحاًّ وبلاً","وأقمنا الضلوعَ وجدا وحُزنا",48,"ن",2,0],["ونزلت من أعلى لأسفل روعة","يا وحشتاه لمنزلي المعمور",49,"ر",1,0],["ونزعتها شيئاً فشيئاً منهم","بالرأي لا حرب ولا استعدادُ",50,"د",1,0],["ونزلتَ في قَلبي ولا عجبٌ","فالقلبُ بعضُ منازِل القَمَرِ",51,"ر",1,0],["وَنَزَلتُ حَيثُ المَكرُماتُ وَقُمتُ في","حَيثُ اِبتَنى المَجدَ المُؤَثَّلَ وَالعُلى",52,"ل",2,0],["ونَزلتُمُ مني وَإنْ لم تُنصِفوا","بمَنازلِ الأرواحِ في الأجساد",53,"د",1,0],["وَنزّهِ اللَّه عن شبهٍ وعن جهةٍ","بِالغيبِ آمن وَصُنه في تغيّبهِ",54,"ب",2,0],["وَنِزالٍ في يوم سلمٍ وقتلِ","وَفَدَوه بكلّ نفسٍ وأهلِ",55,"ل",1,0],["وَنَزا مِن عَرينه تَشَظّى","حممٌ مِن لَظاه في الزمهريرِ",56,"ر",1,0],["ونُزِّل فِيه بالتفضِي","لِ والتعظِيم قرآن",57,"ن",1,0],["ونزّهتُه دهراً فلمّا هززتَني","هززتَ حساماً ليس ينبو له حَدّ",58,"د",1,0],["ونَزهْتُ طَرْفِي في محاِسِن وجنَةٍ","تُريكَ كمالَ البدْرِ في ناعِمِ القُضْبِ",59,"ب",1,0],["ونزّه رب العرش عن والد وعن","قرين ومولود وثانٍ وثالث",60,"ث",1,0],["وَنَزَعتُ مِن خِدري إِلَيكَ عَقيلَةً","كانَت يَدايَ بِها تَضَنُّ وَتَبخَلُ",61,"ل",1,0],["وَنَزِّهْنَا عَنْ أَغْرَاضِ الْعِبَادِ","وَسَدِّدْنَا إِلَى طُرْقِ السَّدَادِ",62,"د",1,0],["وَنزلن من كنفي سهام بساحمة ال","قمر المنير سنا سما الايمان",63,"ن",1,0],["وَنزلت من حرم الحجاز بما جد","من آل غالب قاهر غلاب",64,"ب",1,0],["ونزّه السعي عن رياءٍ","فلا جهادٌ مع الغلول",65,"ل",1,0],["وَنَزلنا عَن مَعاريجِ الصّبا","مذ نَزَلْتُم ذلكَ المُنْعَرَجا",66,"ج",2,0],["ونزَّهت شعري عن هجاءٍ ومدحةٍ","وَلَولا الهوى ما كنت أطري الغوانيا",67,"ي",2,0],["ونزه الصدر من غش ومن حسد","وجانب الكبريا مسكين والعجب",68,"ب",1,0],["ونزيل مرباط إمام جامع","أصل لأشياخ الطريق مفرع",69,"ع",1,0],["ونزعت من أهل الجريد غواية","كانت بهم أبداً تجد وتهزل",70,"ل",1,0],["وَنِزَاعُ الجِيرانِ ذا البابُ بَابي","وَطَرِيقي وَذا الجِدارُ جِدَاري",71,"ر",2,0],["وَنُزْهَةُ الفُسَّاقِ في بَيتهِ ذا","والماءُ والخُضْرَةُ والوَجْهُ الحَسَنْ",72,"ن",1,0],["وَنَزَّهتُ عَن كَونِ المَكانِ كَيانَها","وَأَوصافَها عَن رُؤيَةِ الحَدَثِيَّةِ",73,"ه",1,0],["وَنزه الطَرف في أَغصان دوحَتها","وَاِنسَب لِبَهجَتِها ما شِئت مِن عَظم",74,"م",1,0],["ونزلتُ من أقصى مدَى نَظَرِي","ليدِ المطيّةِ لاثِماً شُكرا",75,"ر",2,0],["ونزهوها عن أقوال الخنا والدناه","وكل مستقذر أو رائحه مشتناه",76,"ا",2,0],["ونزَّهني في روضةٍ من خدودِه","وأسكَرني من ريقهِ بمُدامِ",77,"م",1,0],["ونزال فرسان الهياج وكلهم","فوق لهول تقحمي ومقامي",78,"م",2,0],["ونزِّه الألحاظ ما بين الربى","في ذلك الغض النزيه الخصب",79,"ب",1,0],["ونُزِّلَ المَنُّ عليهم مع السَّ","لْوَى كما اختاروا من القصدِ",80,"د",1,0],["ونزعتَ ثوبَ توعّكٍ لا ينثَني","ولبسْتَ خلعةَ صحةٍ لن تُخْلَعا",81,"ع",2,0],["وَنَزْعَزعَت لمصابها وَتَنَكَّدَتْ","أَسَفاً بلادُ الْهِنْدِ والسِّندانِ",82,"ن",1,0],["وَنَزَتْ بِهِنَّ عن الآرائِكِ رَوْعَةٌ","مَهَدَتْ لَهُنَّ حُزُونَ كُلِّ يَبابِ",83,"ب",1,0],["ونزهت عرض الشعر عن شكر ناقصٍ","وأكرمته عن هجو من لا يكرم",84,"م",1,0],["ونزاوعاً باتت تسا","ورني ومالي من مجيب",85,"ب",1,0],["ونزلتَ في مضر وقومُك غيرهُم","بعد الممات بأشرف الأقوامِ",86,"م",1,0],["ونزت بنيَّاتُ الفؤاد لصوته","نزوَ الفصائِل في زفير المرجَلِ",87,"ل",1,0],["ونزلتَ حيث تقرُّ عينُك لا كما","كانت عيون الحزن حولك تهمِلُ",88,"ل",1,0],["ونزلتَ حيث تُحَطُّ أملاكُ العلا","شوقاً إليك وتُرفَعُ الأوزارُ",89,"ر",1,0],["ونزعٌ بأطماعٍ ضعافٍ تمدُّها","أمانيُّ لم يَقبَلْ يميناً مُعيرُها",90,"ر",3,0],["ونزلتُ في غُرفِ العلا متظلّلاً","بالعزّ تحت رواقها المضروبِ",91,"ب",1,0],["ونزحن بالدهناء عن جَدَد السُّرى","فوطئن في يربوعها المتقصِّعِ",92,"ع",1,0],["ونزهته عن جاهل بمكانه","وما حاجة النكس الجبان إلى العضب",93,"ب",1,0],["ونزَّة عن ذلّ المطامع همّتي","فمالي في شيء وأن جلّ مطمع",94,"ع",1,0],["وَنَزَّهتُ عَقلِيَ في رَوضَةٍ","عَلى زَهرِ أَلفاظِكَ الزاهِرِ",95,"ر",1,0],["وَنَزَعتُ لا في السُكرِ خُنتُ تَصَوُّني","بِخَناً وَلا في الصَحوِ شِنتُ تَجمَلى",96,"ل",2,0],["وَنَزَّهتُ عَن غَيرِ الدَنانيرِ قَدرَها","فَما زِلتُ مِنها أَشرَبُ التَبرَ بِالتبرِ",97,"ر",1,0],["وَنَزَّه عَن غَيرِ الصَفاءِ اِجتِماعَنا","فَكُنتُ وَإِيّاهُ كَقَلبَينِ في صَدرِ",97,"ر",1,0],["ونزَعْتُ عن كلِّ الوُجودِ عَلائِقي","وطرَحْتُ رُمحي مُقْلِعاً وسِناني",98,"ن",2,0],["وَنَزَلنا بِوارِداتٍ إِلَيهِم","فَتَوَلَّوا وَلَم يُطيقوا النُزولا",99,"ل",2,0],["ونزري عليها جاهدين بألسن","تخالفها بالاعتقاد قلوب",100,"ب",1,0],["وَنزور سَيِّدنا و