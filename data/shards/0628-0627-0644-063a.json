x?id=198636",""],[5461,"إرفعي سهم المنايا","https://www.poetsgate.com/ViewPoem.aspx?id=1305",""],[5629,"البارحه","https://www.poetsgate.com/ViewPoem.aspx?id=184615",""],[5642,"جهرة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=125040",""],[5725,"بغداد يا خوف الفؤاد وأمنه","https://www.poetsgate.com/ViewPoem.aspx?id=214502",""],[4623,"ماذا يضرك لو تركت ملامي ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146686",""],[4623,"لا تلوموني إني أطلت المقالا ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146608",""],[5859,"رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=29416",""],[5939,"تحذير شديد اللهجة لحبيبتي المتمردة","https://www.poetsgate.com/ViewPoem.aspx?id=178582",""],[6070,"الذنوب العارية","https://www.poetsgate.com/ViewPoem.aspx?id=188432",""],[4442,"مآذن النجف اهتزت أعاليها","https://www.poetsgate.com/ViewPoem.aspx?id=171229",""],[6093,"بَالغتُ في طلبِ المُحالِ","https://www.poetsgate.com/ViewPoem.aspx?id=202678",""],[6127,"سلامٌ على جرحك","https://www.poetsgate.com/ViewPoem.aspx?id=199923",""],[6127,"النذير","https://www.poetsgate.com/ViewPoem.aspx?id=215049",""],[6142,"بالغريين وبين الذكوات","https://www.poetsgate.com/ViewPoem.aspx?id=155734",""],[463,"قد قنعنا أن نرقبَ الأحلاما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60324&r=&rc=380",""],[463,"لمنَ الطلولُ تراقصتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60065&r=&rc=121",""]],"verses":[["بِالغَمرِ قَد غَيَّرَها","صَوبُ الغَمامِ مُدجِنا",0,"ن",2,0],["بالِغٍ جُهدَهُ وَمَن بَلَغَ الجُه","دَ وَإِن لَم يُصِب فَما ضَلَّ قَصدا",1,"د",2,0],["بَالَغَتَ فِي طَلَبِ الحُطَامِ إِلَى مَدىً","مُغْنِي الوُلاةَ وَلِلعُرُوشِ مُحَطَّمِ",2,"م",1,0],["بَالِغاً أَحْسَنَ الأمَانِيِّ مَوْفُورَ","السَّعَادَاتِ بَيْنَ صَحْبٍ وَآلِ",3,"ل",1,0],["بِالغُراباتِ فَزَرّافاتِها","فَبِخِنزيرٍ فَأَطرافِ حُبَل",4,"ل",1,0],["بالغتَ في شجني وفي تعذيبي","ومعَ الأذى أفديكَ من محبوب",5,"ب",1,1],["بالغاتٍ إلى المقصّر عنها","نائلاتٍ بعيدَ كلّ منالِ",6,"ل",1,0],["بِالغَواني تُطيعُهُ","وَالغَواني لَها اِحتِكام",7,"م",1,0],["بِالغَواني فَدَيتَهُنَّ فَأَسمى ال","شِعرِ وَالفَنِّ في الحَياةِ الغَواني",8,"ن",2,0],["بالغوا في الجمود حتى كأن","القوم ناس لم يشعروا بالحياة",9,"ه",1,0],["بالَغَ فِرعَونُ في","كَرمَتِها مَن كَرَم",10,"م",1,0],["بِالغَرشِ أَو بِالغَورِ مِن رَهطِهِ","أُرومُ مَجدٍ سانَدَتها الفُروع",11,"ع",1,0],["بِالغَدرِ آناً وِبِالإِغراءِ آوِنَةً","وَبِالنَمائِمِ تُؤذينا أَفاعيها",12,"ي",3,0],["بالغَوْرِ تَخْبو تارَةً ويَشُبُّها","تحتَ الدُّجُنّةِ مَنْدَلٌ وكِباء",13,"ا",2,0],["بِالغَتِّ أَو يَنزِلُ عِندَ حُكمِهِ","يَركَبُ أَطرافَ الصَوى بِخَطمِهِ",14,"م",2,0],["بِالغارِ مِن هَضبَي عَمايَةَ نازِلٌ","ما زالَ توقَدُ نارُهُ بِالغارِ",15,"ر",1,1],["بَالِغاً فِي كُلِّ نَفْسٍ رُتْبَةً","قَصَّرَتْ عَنْ شَأْوِهَا أَسْمَى الرُّتَبْ",16,"ب",1,0],["بَالغْتَ فِي حُبِّ الْفَقِيرِ مَبَرَّةً","بِأَخِي الشَّقَاءِ رَقيقِ الاسْتِبْدَادِ",17,"د",1,0],["بالغ ما بلَغْتَ في وصفك الجيشَيْن","اذ يقدحانِ زندَ الملاحِم",18,"م",1,0],["بالِغاتٍ أَقصى الدُنا تُنزِلُ المَش","روفَ أَعلى مَنازِلِ الأَشرافِ",19,"ف",1,0],["بالِغاً في خَطيرِهِ وَأَخيهِ","ذي المَعالي صَفِيِّهِ المَأمولا",20,"ل",2,0],["بالِغاتٌ مِن كُلِّ باغٍ وَطاغٍ","فَوقَ ما يَبلُغُ الخَميسُ اللُهامُ",21,"م",1,0],["بالَغَ في هجوك واغتيابي","سَمَّاك إنساناً بلا استيجابِ",22,"ب",1,0],["بالغير من قاسه لعمري","اخطا وما البحر كالجداول",23,"ل",1,0],["بالَغَ الواصِفونَ فيها وَقالوا","طِفلَةُ السِنِّ ذاتُ مالٍ وَحُسنِ",24,"ن",1,0],["بالِغاً في أَخيكَ ما نالَهُ مو","سى وَقَد شَدَّ إِزرَهُ هارونُ",25,"ن",1,0],["بالِغاً في غُصونِ دَوحَتِكَ الغَن","ناءِ أَقصى ما تَنتَهي الآمالُ",26,"ل",1,0],["بَالَغْتَ فِي عَدْلِنَا لَوْ كَانَ يَنْفَعُنَا","لَكِنَّهُ بِالضَّنَى وَالْوَجْدُ يُغْرِينَا",27,"ن",2,0],["بالغوث الفرد الجامع مَن","قد شاد لأركان الوُلَج",28,"ج",1,0],["بَالغَ العبدُ في النّيابةِ والتَّحْ","ريضِ وهو المفَوَّهُ المقبولُ",29,"ل",1,0],["بِالغَورِ أهلُكِ يابُثَينَ وأهلُنا","بالأبْرَقَينِ فأينَ أينَ المُلْتقى",30,"ق",2,1],["بالغ في كلِّ يوم مَرَّ بي","من أبي عيسى نوالاً من مُنيل",31,"ل",1,0],["بالغا منتهى السعادة كي ينس","يه فردوسه وتلك الربوعا",32,"ع",2,0],["بالِغاً مَبْلَغاً من الشَرَفِ الأس","نى يردّ العيون حَسْرى كِلالا",33,"ل",2,0],["بالغا فوق ما تروم من العز","زِ إذا فات طالبا ما راما",34,"م",2,0],["بالغَور ما شاء المطايا والمطرْ","بَقلٌ ثخينٌ ونميرٌ منهمِرْ",35,"ر",1,1],["بالغوطتين جبالُها","وببطن وجرةَ دارُها",36,"ر",3,0],["بالغور دارٌ وبنجدٍ هوىً","يا لهف من غار لمن أنجدا",37,"د",2,0],["بالِغٌ ما دونَهُ اِستِحقاقُهُ","وَيَدٌ عَمّا اِستَحَقَّت قَصَرَت",38,"ت",1,0],["بالغاً ما أردتُهُ من زيادا","تٍ عليهِ ما كنّ لي في حسابِ",39,"ب",1,0],["بِالغَمرِ مِن زَينَبَ أَطلالُ","مَرَّت بِها بَعدَكَ أَحوالُ",40,"ل",1,1],["بِالغليِ أَحمَوهُ وَأَخبَوهُ التِيَر","وَبِالسُرَيحيّاتِ يَخطَفنَ القَصَر",41,"ر",1,0],["بالَغتُ مُلتزِماً ما ليسَ يَلزَمُني","حتى دُعيتُ إمامَ العِشق في الأُمَمِ",42,"م",1,0],["بالغُصن بالبدر بشمس الضُّحى","بالرِّيم بالدُّري بالدُّره",43,"ر",2,0],["بالغير أنت كثير ما له عدد","وأنت لا غير لا فصلٌ ولا جُمل",44,"ل",1,0],["بالغيظ أرصدَ قفلاً","بهِ الدراريُّ تؤسَر",45,"ر",1,0],["بالغ بما شئت فيه بالمديح وقل","الله أكبر قلبي نال ما طلبا",46,"ب",2,0],["بالغتَ في مَدحه لَما وَقَفتَ عَلى","رِثاء حبر إِلى الحور الحِسان صَبا",47,"ب",2,0],["بِالغَيظ مُت كَمداً فَقَد نَزَل القَضا","وَالسَعي ضلّ وَخابَ كُل رَجاء",48,"ا",2,0],["بالغائصين على الفضائل بحرَها","والفائزين بدُرِّها إذ غاصوا",49,"ص",3,0],["بالغت في الهجر حتى خلت من جزع","أن ليس للهجر عمر الدهر من أمد",50,"د",1,0],["بالِغْ بِذِكراهُ في حُسنِ الثّناءِ فَإِنْ","أَكثَرتَ ذِكراهُ لَم تُنسَب إِلى السَّرفِ",51,"ف",1,0],["بالغت في شتمي وفي ذمي","وما خشيت الشاعر الامي",52,"ي",1,1],["بالغيد تبذل ما يصان","وبالجآزر والنواعس",53,"س",1,0],["بالَغَ لكنْ ساءَني","رسولُه ما بَلَّغَا",54,"غ",2,0],["بالغت في كتم الهوى ولعله","يبدو إذا زادت لواعج لوعته",55,"ه",1,1],["بالغة مناها","في المال والسلطان",56,"ن",1,0],["بالغت في وصف الحبيب توسلا","لوصاله اذ صد عنك صدودا",57,"د",2,0],["بالِغ في تَبليغِها وَنَفسه","أَتعَبَها في حِفظِها وَأَجهَدا",58,"د",2,0],["بالغت في عذلي وفي تأنيبي","في الراح حين وعظتني بمشيب",59,"ب",1,1],["بالغتَ يا موتُ في كيدي وفي كدري","ماذا تريد وليلي قد غدا سحري",60,"ر",2,0],["بالغت في الغسل له حسب ما","أدركت من جهدكَ في القدرِ",61,"ر",1,0],["بالغتَ في الجودِ حتى خِلْتُه دِيَماً","تَصُبُّهُ أجودُ الأنوا السماكانِ",62,"ن",1,0],["بالغالي اللي ما نبا فيه تبديل","وعليه ما نختار غالي أو مقصود",63,"د",1,0],["بِالغُنجِ وَالسِحرِ القَتولِ مُكَحَّلٍ","بِالتَيهِ وَالحُسنِ البَديعِ مُقَلَّدِ",64,"د",1,0],["بالِغاتٍ حَيثُ لا","تَبلُغُ أَيدي اللامِسات",65,"ت",1,0],["بِالغَلس انسلَّت إِلى حَبيبها","تَخطو وَعَيناها إِلى رَقيبها",66,"ب",3,1],["بالغات لدون أَدنى ذراها","شرف الكاظمين لما كَساها",67,"ه",2,0],["بَالَغْتَ بالإِعْراضِ في إتْلافي","وَوَصلْتَ بَيْنَ قَطِيعَةٍ وَتَجافي",68,"ف",2,1],["بالغت في عذلي وفي تأنيبي","وفي الراح حين وعظتني بمشيبي",69,"ب",2,1],["بالغت بالعرفان شأواً باذخاً","ينحط نسر دونه وفرقد",70,"د",1,0],["بالغر من اخلاقه وبشعره","سارت بقاصية البلاد رواته",71,"ت",2,0],["بالغت في الهجو والتنديد حيث شمل","ت الدين منا ودنيانا وأخرانا",72,"ن",2,0],["بالغُوا فى مقسَّمات التهاويلِ","تمادَوا فى شامخاتِ المغانى",73,"ن",2,0],["بالغنا والغواني وبالكاس المدار","في البكر والأصائل والأغلاس",74,"س",1,0],["بالغيب أخبر عن مقالة ربه","واستخرج السحر الذي في الطلعة",75,"ه",1,0],["بالغبوق منهمكٍ","بالصبوح محتفل",76,"ل",1,0],["بالغُ في هجرهِ قلالاً","فقلتُ باللّه لا تبالغ",77,"غ",1,0],["بالغوا في طمسها نشرا وطيبا","وابتغوا من قتلها حلا وعقدا",78,"د",2,0],["بالغصن شبهته قواماً","والحق ان القوم الطف",79,"ف",1,0],["بالغت فِي طلبي وصا","لَكَ لو تواتيني السعادهْ",80,"د",2,0],["بالغَ في المقال والنصيحه","وجاءَهُم بالحُجَجِ الصريحه",81,"ه",1,0],["بالَغَ في والقتالِ الكفاحِ","وجاد بالنفسِ على الصفاح",82,"ح",1,0],["بالغانماتِ من النُفو","سِ نَفائساً لَم تغنمِ",83,"م",1,0],["بالغتُ في حسن القاءِ الكلام لكي","أعودَ مستحسناً من طرفك الرّاني",84,"ن",2,0],["بالغيث قد أشرعوا إيمانهم فهَمَت","فضلاً وكم اسرعوا في غَوثِ منعدمِ",85,"م",1,0],["بالغنج يكسر جفنيه على حور","لِلّه در الصبا لو صان باطلَه",86,"ه",1,0],["بالغصن شبّههُ من ليس يعرفهُ","وانما هو للرائين بستان",87,"ن",1,0],["بِالغَيمِ من قبلِ شروق الشمسِ","فلم نَجِد لحرِّهَا مِن مَسِّ",88,"س",1,0],["بالغافر المقدِّمِ المؤخِّرِ","للأرض والعباد غِث بالمطرِ",89,"ر",1,0],["بالغافر التوّابِ والوكيلِ","والمومنِ الكافي أقم سبيلي",90,"ي",1,0],["بالغت في السّخط فاصفح صفح","مقتدر ان الملوك اذا ما استرحموا ارحموا",91,"م",3,0],["بِالغَنجِ تَسلُبُ ذا الوِقارُ وُقارَهُ","وَدَلالَها يَقضي بِنَقضِ مَراسي",92,"س",2,0],["بالغريين لها لا مدينا","منزل سامٍ رفيع الدرج",93,"ج",1,0],["بالغور حيث الغور منزل جيرة","نزلوا هناك أباطحاً وأجارعا",94,"ع",2,0],["بالغريب إن ظهر صوتك وغنيت بالدان","اقصد الله في إسلامك وقابله بإيمان",95,"ن",1,1],["بالغريب اعلم أهل الغور وأهل النجود","قل لمن حل في حاجر ومن في زرود",96,"د",1,1],["بالغنا قد سما فرعي ولو ما تغنيت","ختمها استغفر الله يالله إن كنت زليت",97,"ت",1,0],["بالغ فيه الجوع حتى إنه","إذا رأى القتّ بكى وانتحبا",98,"ب",2,0],["بالغت في اللثم وقبلته","في الخد تقبيلاً يفك الزرد",99,"د",1,0],["بالغْتَ في عتبي أَفهل من أوْبَةٍ","وعدَلْتَ عن وُدّي فهل من عطفةِ",100,"ه",1,0],["بالغت في استخراجه فوجدته","لا رأي إلا رأي أهل الموصل",101,"ل",1,0],["بالغتَ يا راجي سُلوِّي عنهمُ","في النُّصحِ جهدَكَ لو دعوتَ سَميعا",102,"ع",2,0],["بالغت في إخجالي","بفضلك المتوالي",103,"ل",2,1],["بالغدر والغدر وخيم المصرع","وزارة رداؤها لم ينزع",104,"ع",1,0],["بالغدرِ أمرَ المسلمينَ تلاقفوا","واسترهبوا سيراً على الأشلاء",105,"ا",2,0],["بالغضا نحن وهم حلوا العقيق","أين من وادي الغضا بطن العقيق",106,"ق",1,0],["بالغمّ عينايَ بحرٌ والفؤاد دمٌ","والدهرُ ليلٌ طواني بالأسى برمُ",107,"م",1,0],["بالغتَ في شرح المعاني علّها","في الغيب تبدو واحة بك تحفلُ",108,"ل",1,0],["بالغَت فيني تباريح الهوَى","وأستبدّت بي المواجيع الظنون",109,"ن",1,0],["بالغصب ولا الطيب كل التدابير..","لو يِتلقِاني أبيِة وجده !",110,"د",2,0],["بَالغٌ قَلْبَ الحَبِيبِ المُرتجَى","وَصْلُهُ أو عَائدٌ بِالمَطْمع",111,"ع",1,0],["بالغت في ذم الفراق فذقته","ألماً يقضّ مواجعاً بعتابهِ",112,"ب",2,0],["بالغت في الإرشاد فيهم داعيا","بالحق للإيمان والإسلام",113,"م",1,0],["بالغوا في آذاه وهو يقول اغفر","لقومي ولا تزدهم وبالا",114,"ل",2,0],["بالغت جداً في انتقاء حروفها","فكأنها تهويمةٌ صوفية",115,"ي",2,0],["بالغيظِ تَأكلُ نَفسَها وتَزيدُ في عشقي الضحايا!","والحزنُ يَكسرُ قلبَها ودموعُ عينيها خَزايا",116,"ا",3,0],["بالغتَ في ترفِ الحياةِ وغيها","وركبتَ أنواعَ الذنوبِ العاريهْ",117,"ي",2,0],["بالغامضات إذا اعتاصمت لها ولع","يصبي يراعك أو يحلو دياجيها",118,"ي",3,0],["بَالغتُ في طلبِ المُحالِ بعرْفِنا","والمستحيلُ لديكَ ربِّ مُمكنُ",119,"ن",1,1],["بالغْتَ في النّصْحِ يا ديناً أحاطَ بِهِ","جيشُ الطّغامِ عسى يُثنيهمُ سببا",120,"ب",2,0],["بالغتمو بالبغي حتى خِلْتُها","نُذُرَ السماءِ بمَهْلِها تتسامى",121,"م",2,0],["بالغريين وبين الذكوات","لي خشف علم الخشف التفاتي",122,"ت",2,1],["بالغا فوق ما تروم من الع","زِّ إذا فات طالبا ما راما",123,"م",2,0],["بالغوطتين جبالها","وببطن وجوة َ دارها",124,"ر",3,0]]}