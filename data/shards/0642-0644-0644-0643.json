{"poems":[[53,"يا طاهريين لا طهور لكم","https://www.aldiwan.net/poem61869.html","المنسرح"],[53,"قل لكس الأسنان أنت سميات","https://www.aldiwan.net/poem64553.html","الخفيف"],[53,"نحن ميامين على أننا","https://www.aldiwan.net/poem66089.html","السريع"],[53,"نحن ميامينُ على أنّنا","https://www.poetsgate.com/ViewPoem.aspx?id=30430",""],[240,"قل لكريم الدين يا","https://www.aldiwan.net/poem31646.html","مجزوء الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122637","الخفيف"]],"verses":[["قل لكتابٍ إذا مررتَ بها","ليتك لم تولدي ولم تلدي",0,"د",2,0],["قل لكُسِّ الأسنانِ أنتِ سَمِيَّا","تُ حبيبي وهل حبيب ككُسِّ",1,"س",1,1],["قلّ لك المُلْكُ لو أنهُ","مَجْموعةٌ فيه الأقاليمُ",2,"م",1,0],["قلّ لك المُلْكُ ولو أنهُ","مَجْموعة ٌ فيه الأقاليمُ",3,"م",1,0],["قُل لِكَريمِ الدينِ يا","نَجمَ العُلى وَخِدنَها",4,"ن",3,1],["قُل لِكَزِّ البَنانَ إنَّ المعالي","شَهواتٌ مَحفُوفَةٌ بالمكاره",5,"ر",2,0]]}