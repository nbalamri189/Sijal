{"poems":[[79,"إن كنت تنكر ما تجن ضلوعي","https://www.aldiwan.net/poem35994.html","الكامل"],[53,"أيا ابن المعلى كن معلى ولا تكن","https://www.aldiwan.net/poem65791.html","الطويل"],[53,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[45,"أعلى الممالك ما يبنى على الأسل","https://www.aldiwan.net/poem9925.html","البسيط"],[47,"يابن مر قول مرتدع","https://www.aldiwan.net/poem65128.html","المديد"],[33,"أقل الملام يا عتيق فإنني","https://www.aldiwan.net/poem41820.html","الطويل"],[54,"أردت الشرب في القمر","https://www.aldiwan.net/poem27001.html","مجزوء الوافر"],[69,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[77,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[50,"وقيت بي الردى زدني قيودا","https://www.aldiwan.net/poem62602.html","الوافر"],[79,"إن كنت تنكر ما تكن ضلوعي","https://www.poetsgate.com/ViewPoem.aspx?id=34176",""],[33,"أقلَّ الملامَ، يا عتيقُ، فإنني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19049&r=&rc=312",""],[240,"سقاها الحيا من أربع وطلول","https://www.aldiwan.net/poem31789.html","الطويل"],[287,"رويدك كم تجني وكم تتدلل","https://www.aldiwan.net/poem32666.html","الطويل"],[354,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[362,"أنوماً وقد بان الخليط تذوق","https://www.aldiwan.net/poem4159.html","الطويل"],[369,"رمين القلوب بأشواقها","https://www.aldiwan.net/poem60835.html","المتقارب"],[385,"الله أكبر جاء النصر والظفر","https://www.aldiwan.net/poem48765.html","البسيط"],[443,"أحقا صددت وخنت الودادا","https://www.aldiwan.net/poem2615.html","المتقارب"],[482,"دم أريق بأسياف الهوى هدر","https://www.aldiwan.net/poem15236.html","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77616","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77626","البسيط"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129529","المتقارب"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61132","الطويل"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117610","السريع"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93093","الرجز"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44823","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49595","الطويل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103523","الكامل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145030","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85248","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114404","المجتث"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33362","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139641",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5953,"إحدى العجائب خلقة الإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=93862",""]],"verses":[["ووَكَلْتُ عَيْنِي بالفَراقِدِ والسُّهَى","أبْكيكَ عنْدَ غُروبِها وطُلوعِ",0,"ع",1,0],["ووكّلْ يديك السمْحتين بحاجتي","وهَبْ لي يوماً من شهورِ سنيكا",1,"ك",2,0],["ووكدُك طرد زَوْرك بالعطايا","كذلك يطردُ الزَوْر الكرامُ",2,"م",1,0],["وَوَكَّلَ الظَنَّ بِالأَسرارِ فَاِنكَشَفَت","لَهُ ضَمائِرُ أَهلِ السَهلِ وَالجَبَلِ",3,"ل",1,0],["وَوَكَلناكُم إِلى نَفرٍ","ذَهَبوا بِالعِلمِ وَالوَرَعِ",4,"ع",1,0],["وَوَكَّلتَ أَفراسَ الصِبا بِطِلابِها","زَماناً فَقَد هانَت عَلَيكَ المَلاوِمُ",5,"م",1,0],["وَوَكَّلَ بي تَلامِذَةً","فَأَسقوني إِلى السَحَرِ",6,"ر",1,0],["وَوَكَلْتَ أَمْرَكَ لِلإلهِ وَيا لَها","ثِقَةً بَنَصْرِ مَنِ اتَّخَذْتَ وَكِيلا",7,"ل",2,0],["ووكَّلْتَهُ بالجيشِ والأمْرِ كلِّهِ","فوكَّلت بالغِيلِ الهِزَبرَ الغضَنفرا",8,"ر",2,0],["وَوَكِّل بي وَبِالأَبوابِ دوني","مِنَ الرُقَباءِ شَيطاناً مَريدا",9,"د",2,0],["ووكلت عيني بالفراقد والسهى","أبكيت عند غروبها وطلوع",10,"ع",1,0],["وَوَكَّلْتَ أَفْرَاسَ الصِّبَى بِطِلابها","زَماناً، فَقَدْ هَانَت عَلَيْكَ المَلاوِمُ",11,"م",1,0],["وَوَكَّلَ طَرفي بِالسُهادِ تَنَظُّري","قَضاءَ مَلِيٍّ بِالدُيونِ مَطولِ",12,"ل",1,0],["وَوَكَّلتَني بِاللَيلِ أَرعى نُجومَهُ","وَأَنتَ بِطولِ الصَدِّ عَنّي مُوَكَّلُ",13,"ل",1,0],["وَوَكزَهُ المِصرِيَّ وَالخَوفَ الَّذي","أَظهَرَ عَنهُ موتَهُ حالَةَ فَر",14,"ر",1,0],["وَوَكّلَ بالأيام من فَضلِ سَيبِهِ","نَدىً لِفُتوقِ النّائباتِ رَتُوقُ",15,"ق",1,0],["وَوكَّلْتَ كفّاً بها سَمْحةً","بأذْهابها وبأوراقها",16,"ق",3,0],["وَوكل اللَه بِالحَجاج متكلاً","عَلَيهِ لا الخَوف يَثنيهِ وَلا الحَذَرُ",17,"ر",1,0],["ووكّلتَ قلبي بنار الجوى","وألزمت طرفي عليك السهادا",18,"د",2,0],["ووكلوني برعي الفرقدينِ وقد","نامتْ عيونُ تحامَي أهلَها السَّهَرُ",19,"ر",1,0],["وَوكز الصورة وَكزاً بِيَدِه","فَاِشتَعَلَت نار الغَضى في جَسَدِه",20,"ه",1,0],["وَوَكَزَ الحِصانَ بِالمهماز","فَفهم القَصدَ للاجتياز",21,"ز",1,0],["ووكلت طرفي برعي النجوم","من بعد أن كنت أرعى البدورا",22,"ر",2,0],["وَوكل طَرفي بالسهاد فَلَيسَ لي","مَنام وَلَكني رَقيب عَلى النجم",23,"م",1,0],["ووكلِ العِزَّ الذي وجههُ","على نجاحِ الأمرِ أقوى دليلُ",24,"ل",1,0],["ووكلت بينهم","قوائم النجائب",25,"ب",1,0],["وَوَكرِي الَّذِي مِنهُ دَرَجتُ فَلَيتَنِي","فُجِعتُ بِرِيشِ العَزمِ كَي أَلزَمَ الوَكرَا",26,"ر",2,0],["وَوكَّلَ عيْنَيهِ بإتلافِ مُهْجَتي","سَيَعْلَمُ إن لم يَسْتَجِرْ بي من الغُرْم",27,"م",1,0],["ووكلته بهمومه وغمومه","دهراً فلم يسر الكرى بجفونه",28,"ن",2,0],["ووكل بالديوان أكفأ نخبة","بتبصرة أعطى بها القوس من برى",29,"ر",2,0],["ووكذاك ما بالوا بتهديد أتى","من صاحب الحرم الشريف الحيدر",30,"ر",1,0],["ووكفُ دمعِ جُفُوني","يُنبتُ أرضاً كلاما",31,"م",2,0],["ووَكلهُ بأسقامٍ وحُزنٍ","غليلٌ ساكنٌ بينَ الضلوعِ",32,"ع",1,0],["ووكفها عمَّ جميع الثرى","فعبَّ في جيب الربى والوهاد",33,"د",1,0],["ووكل من أملاكه من يبلغ","الصلاة عليه كان مبلغها عزما",34,"م",2,0],["ووكيله الأذنان عند سماعه","ودليله في سعيه العينان",35,"ن",1,0]]}