جربت هذا الخلق حتى","https://www.poetsgate.com/ViewPoem.aspx?id=121090",""],[5338,"معارضة قصيدة بات سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=187941",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"على الحبر بحر العلم الحقائق","https://www.poetsgate.com/ViewPoem.aspx?id=128858",""],[592,"أقول لعمري ما لهذا حقيقةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=128718",""],[5397,"أفق من رقدة الآمال جفن","https://www.poetsgate.com/ViewPoem.aspx?id=157927",""],[5398,"شباب المجد","https://www.poetsgate.com/ViewPoem.aspx?id=37156",""],[5414,"لحن الوفاء …","https://www.poetsgate.com/ViewPoem.aspx?id=180859",""],[5431,"حيدرة ...دعوة للمحبة","https://www.poetsgate.com/ViewPoem.aspx?id=204619",""],[5528,"لمن خلفهم عزم وشعلة نبراس","https://www.poetsgate.com/ViewPoem.aspx?id=201025",""],[5561,"صراع الذات","https://www.poetsgate.com/ViewPoem.aspx?id=194666",""],[5582,"هوَ الدَّهْرُ فِينا جائِدٌ غَيْرُ جائِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186912",""],[5725,"وماعجبي بوجهك من صفاء","https://www.poetsgate.com/ViewPoem.aspx?id=185402",""],[5829,"سقيم يعتلي وجع السقيم","https://www.poetsgate.com/ViewPoem.aspx?id=175026",""],[5829,"دواعش","https://www.poetsgate.com/ViewPoem.aspx?id=215122",""],[5906,"فمعفر الليث","https://www.poetsgate.com/ViewPoem.aspx?id=188221",""],[5923,"من مذكرات مراقب امتحان","https://www.poetsgate.com/ViewPoem.aspx?id=149684",""],[5943,"إلى اليمن السعيد","https://www.poetsgate.com/ViewPoem.aspx?id=34361",""],[5956,"طيف الحبيبة الميّتة","https://www.poetsgate.com/ViewPoem.aspx?id=182160",""],[5956,"وُعُود الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=192695",""],[5960,"أنا حاكمٌ عربيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=31108",""],[6069,"بعزمك أيها الملك العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=105705",""],[6070,"بيريزُ مَاتَ وطارتِ الغربانُ","https://www.poetsgate.com/ViewPoem.aspx?id=188857",""],[6102,"قبلة الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=184634",""],[6127,"سلوا البصرة الفيحاء","https://www.poetsgate.com/ViewPoem.aspx?id=190881",""],[6130,"في اللادروب ...","https://www.poetsgate.com/ViewPoem.aspx?id=199047",""],[6164,"بطرت .. فزلت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66039&r=&rc=49",""],[6225,"ملجأ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81041&r=&rc=278",""],[406,"أين بغداد عنا ؟!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=925&r=&rc=55",""]],"verses":[["فَسَيّانِ فيها مِن وَقارٍ وَمَن عُلىً","عِظامُكُمُ وَالراسِياتُ اللَوابِثُ",0,"ث",1,0],["فَسَيْبُكَ مَأْمولٌ وَجارُكَ آمِنٌ","وَمَشْتَى رِكابي في جَنابِكَ قائِظُ",1,"ظ",1,0],["فَسِيَّانِ مَنْ لاحَ القَتيرُ بِفَوْدِهِ","وطِفْلٌ يُناغي وَدْعَتَيْهِ ويَمْرُثُ",2,"ث",1,0],["فَسيري إليهِ واهْجُري أجْرَعَ الحِمى","يَرِفُّ عليْكِ العِزُّ لا الأثْلُ والخَمْطُ",3,"ط",1,0],["فَسَيُنبيكِ أَنَّ في حَدِّ سَيفي","مَلَكَ المَوتِ حاضِرٌ لا يَغيبُ",4,"ب",1,0],["فَسَيْفُكَ لِلْفَتْحٍ الْمُبِينِ مُصَاحِبٌ","وَعَزْمُكَ وَالنَّصْرُ الْمُؤزَّرُ إِلْفَانِ",5,"ن",1,0],["فَسيروا بُراءَ في تَفَرُّقِ مالِكٍ","بِنُصحٍ وَأَرحامٍ يَئِطُّ قَريبُها",6,"ب",3,0],["فَسيرا فَقَد طالَ الوُقوفُ وَمَلَّهُ","قلَاَئِصُ أَمثالُ الحَنِيَّاتِ ضُمَّرُ",7,"ر",1,0],["فسيفُك سيفُ الله مهما سَلَلْتَهُ","يُقيم حُدودَ الله قائمُ حَدِّهِ",8,"د",2,0],["فسيُل المصائب غطّى الزُبى","وغيم النوائب قد طّبقا",9,"ق",2,0],["فسيّدهم في عيشه مثل خادم","وخادمهم في ذُلّةِ مثل سيّد",10,"د",1,0],["فسيح مجال الصدر بالبرِّ للورى","فيا لك من بحرٍ ويا لك من برّ",11,"ر",1,0],["فَسيروا إِلى أَهلِ الحِجازِ فَإِنَّنا","نَفَيناكُم عَن مَنبِتِ القَمحِ وَالتَمرِ",12,"ر",1,0],["فَسَيَأتي زَمَنٌ غَيرُ بَعيد","تَتَهادى بَينَكُم فيهِ أَياه",13,"ه",1,0],["فَسيري وَاِشرَبي بِبَناتِ قَينٍ","وَما لَكِ بِالسَماوَةِ مِن مَعادِ",14,"د",1,1],["فَسَئِمْتُ الحياةَ إلاَّ غِراراً","تتلاشى بهِ أَناشيدُ يَأْسي",15,"س",2,0],["فسيان ليلي والنهار كلاهما","عليه ظلام من همومي مخيم",16,"م",1,0],["فَسَيفُها سَيفُها في كُلِّ مُعتَرَكٍ","وَعَدلُها طَوَّقَ الإِسلامَ بِالنِعَمِ",17,"م",1,0],["فَسِيّانِ عِندي رِحلَتي عَنكَ طائِعاً","وَأَنتَ مُقيمٌ وَاِنتِقالي إِلى قَبري",18,"ر",2,0],["فَسَيفُ بَني عَبسٍ وَقَد ضَرَبوا بِهِ","نَبا بِيَدَي وَرقاءَ عَن رَأسِ خالِدِ",19,"د",1,0],["فَسيرا فَلا شَيخَينِ أَحمَقُ مِنكُما","فَلَم تَرقَعا يا اِبنَي أُمامَةَ مَرقَعا",20,"ع",2,1],["فَسيري فَأُمّي أَرضَ قَومِكِ إِنَّني","أَرى حُقبَةً خَوقاءَ جَمّاً فُثوقُها",21,"ق",3,1],["فسِيرا تَلْقَيا بَحراً","منَ اللَّذَّاتِ مُلتَطما",22,"م",2,0],["فَسَيلُ جَحافلٍ يُفني الأعادي","وسيلُ مَواهبٍ يُغني السُّؤَالا",23,"ل",2,0],["فسَيْرُ الذي يرجوه سَيْرُ مُقيَّدٍ","وسيرُ الذي يَخشى غوائلَه وَثْبُ",24,"ب",1,0],["فسيَّرَ منه وَشْياً ليسَ يَبْلى","وأطلعَ منه شَمْساً لا تَغيبُ",25,"ب",1,0],["فَسَيلُ عَطاياهُ لِلمُجتَدي","وَنورُ مُحَيّاهُ لِلمُجتَلي",26,"ل",2,0],["فسيوفُ القيون أقْطَعُ منها","بين أهل الهوى سيوفُ الجفونِ",27,"ن",1,0],["فَسَيَشكُرُ الإِسلامُ ما أَولَيتَهُ","وَاللَهُ عَنهُ بِالوَفاءِ ضَمينُ",28,"ن",1,0],["فَسِيّانِ عِندي صادَفوا لي مَطعَماً","أُعابُ بِهِ أَو صادَفوا لي مَقتَلا",29,"ل",2,0],["فَسيحوا بِأَطرافِ الفَضاءِ وَأَرتِعوا","قَنا خالِدٍ مِن غَيرِ دَربٍ لَكُم دَربُ",30,"ب",1,0],["فَسِيَّانِ الْجَهُولُ إِذَا تَنَاهَتْ","بِهِ الأَيَّامُ وَالْفَطِنُ الْعَقُولُ",31,"ل",1,0],["فسئِمناها حياةً مُرَّةً","ومللناهُ وُجوداً كالعَدمْ",32,"م",1,0],["فَسيروا عَلى نورِ الهِلالِ يَحوطُكُم","مِنَ اللَهِ جُندٌ ما يُغالِبُهُ جُندُ",33,"د",1,0],["فَسَيُغْنِيني الإلهِ عنهمِ بِجَدْوَى","خيْرِ مَولىً لَنا وخيرِ نَصِيرِ",34,"ر",1,0],["فسينقضي طَلَبٌ ويُفقَدُ طالبٌ","وتَقِلُّ آمالٌ ويُعْدَمُ آملُ",35,"ل",1,0],["فَسَيَّلَها بِرِفقٍ مِن بِزالٍ","فَسالَ إِلَيهِ عَيّوقُ الظَلامِ",36,"م",1,0],["فَسَيَّلَ بِالبِزالِ لَها شِهاباً","أَضاءَ لَهُ الفُراتُ إِلى عُمانِ",37,"ن",1,0],["فسيف له غمد من الدم قانئ","وطرف له مما يثير جلال",38,"ل",1,0],["فَسِيحُ مَجَالِ الْفِكْرِ ثَبْتٌ يَقِينُهُ","بَعِيدُ مَنَاطِ الْهَمِّ حُرُّ التَّصَرُّفِ",39,"ف",1,0],["فَسِيحُ مَجَالِ الْعَينِ أَمَّا غَدِيرُهُ","فَطَامٍ وَأَمَّا غُصْنُهُ فَرَشِيقُ",40,"ق",1,0],["فَسِيرُوا إِنَّنا نَقْفُو خُطَاكُمْ","وَأَمْرُ الْحَقِّ يَعْلُو كلَّ أَمْرِ",41,"ر",1,0],["فسيروا بحمدِ اللّه للحقِّ عُصْبةً","وإنْ أسرعتْ دُهْمُ الليالي فأسرعوا",42,"ع",3,0],["فسيروا على نهجه مؤمنينَ","تَرُّوا من المجدِ ما أدبَرا",43,"ر",2,0],["فسَيركعُ التاريخُ فوقَك كلُّه","وسيركَعُ الوَطنُ الذي بك يُمنَع",44,"ع",1,0],["فسيق الى سلانيك احتباسا","له كي يستريح بها مصونا",45,"ا",1,0],["فسيّان من يبغى عُلاك وطالبٌ","ليبلغَ أسبابَ السمواتِ سُلَّما",46,"م",2,0],["فَسَيِّر بي حَديثَ المَجدِ إِنّي","لِما أَثَّلتَ مِن شَرَفٍ مُشيدُ",47,"د",1,0],["فَسيروا بِمَدحِ الهاشميِّ وَحَدِّثوا","ثَنائي عَلَيهِ إِن ذَهَبتُ مُوَرَّثُ",48,"ث",1,0],["فسيوف ربك قد كفتكَ وكم كفى","ربُّ السماء المؤمنين قتالا",49,"ل",2,0],["فسيروا مثل سير الناس رفقاً","فأحسن سيرة الركب الوصاخ",50,"خ",1,0],["فَسِيحُ ظِلال المُلكِ أَضحى فِناؤُهُ","مَلاذاً لِأَحرارِ النُفوسِ وَمَنجَعا",51,"ع",2,0],["فسيحَ مَجالِ العِزّ يَصْحب عُمْرَه","بقاءٌ على مرِّ الزمان جديد",52,"د",1,0],["فَسَيَلحَقَنَّ بِمَن تَقد","دَمَ النَوائِبِ مَن تَأَخَّر",53,"ر",1,0],["فسيُجلى ليل الخطب ويب","دو فجرُ الفتحِ المنبلج",54,"ج",1,0],["فَسيروا في البِلادِ وَوَدِّعونا","بِقَحطِ الغَيثِ وَالكَلَإِ الوَخيمِ",55,"م",1,0],["فسيري جزاكِ اللهُ خيراً لأنني","خلعتُكِ من أُذني وعَيني وأضلعي",56,"ع",2,0],["فسيلي غديراً وافتَحي القلبَ زَهرةً","ورقِّي نسيماً في الغصونِ مُهينما",57,"م",2,0],["فسيّانَ عندي البؤسُ والنعُم إن تكن","حياةُ الفتى هذي فإني لأزهَد",58,"د",1,0],["فَسَيفُهُ صاعِقَةٌ بِكَفِّهِ","لَم تَنجُ مِنهُ السابِغاتُ وَالشِكَك",59,"ك",1,0],["فسيدرون إذا ما اشتركوا","من زئير الأسد الأمر الجلل",60,"ل",1,0],["فَسيان حالاً موتهُ وحياتهُ","إِذ ما الحياةُ سِوى حياة نفوسِ",61,"س",1,0],["فَسِيروا إلى أفناء أبيضَ ماجدٍ","له من بُيوتِ المجدِ غُرّةُ وَسْطها",62,"ط",3,0],["فِسِيرِي إلى أكنافِ أبيضَ ماجِدٍ","مَغانيهِ روْضٌ للعُفاةِ مَجود",63,"د",1,0],["فَسَيَمحو هَذه الأَ","ثار دَمعي وَالغَرام",64,"م",1,0],["فسيل فضله علينا ساح","سقى جميع العرب في آن",65,"ن",1,0],["فسيئات الهوى بالوصل قد محيت","والذنب يغفر بالآتي من القرب",66,"ب",1,0],["فسِيَّانِ رامٍ قاصِدٌ بالمعابِلِ","وآخرَ زارٍ قاصِدٌ بالمعابِ لي",67,"ل",2,0],["فسيحٌ شجا صدري بِهِ متضايِقُ"