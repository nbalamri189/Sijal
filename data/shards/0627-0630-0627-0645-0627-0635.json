{"poems":[[55,"دوام الهوى في ضمان الشباب","https://www.aldiwan.net/poem30745.html","المتقارب"],[65,"ألا بأبي كعب خليلا وصاحبا","https://www.aldiwan.net/poem46163.html","الطويل"],[87,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[47,"إذا ما صديقي رابني سوء فعله","https://www.aldiwan.net/poem65214.html","الطويل"],[63,"يريك قوامها الغصن الرطيب","https://www.aldiwan.net/poem51809.html","الوافر"],[51,"أيا للمنايا ويحها ما أجدها","https://www.aldiwan.net/poem62063.html","الطويل"],[54,"أعاذل قد أبحت اللهو مالي","https://www.aldiwan.net/poem26727.html","الوافر"],[48,"أفوق البدر يوضع لي مهاد","https://www.aldiwan.net/poem23638.html","الوافر"],[11,"","https://poetry.dctabudhabi.ae/diwan/poem/10369","الطويل"],[135,"غشيت برابغ طللاً محيلا","https://www.aldiwan.net/poem23993.html","الوافر"],[146,"تزاورن عن أذرعات يمينا","https://www.aldiwan.net/poem58450.html","المتقارب"],[164,"أتسأل عن دم لك فيه حلا","https://www.aldiwan.net/poem58930.html","الوافر"],[190,"نزعت إلى الغواية والفتون","https://www.aldiwan.net/poem43231.html","الوافر"],[409,"إلى الله أشكو من زمان محارب","https://www.aldiwan.net/poem34143.html","الطويل"],[411,"علامة شكر المرء إعلان حمده","https://www.aldiwan.net/poem49554.html","الطويل"],[447,"إذا ظفرت نفسي إليك تقاصد","https://www.aldiwan.net/poem14303.html","الطويل"],[505,"إذا ما صغت في المحبوب نظما","https://www.aldiwan.net/poem37728.html","الوافر"],[580,"أرى كل شيء في البسيطة قد نما","https://www.aldiwan.net/poem3021.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122710","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130197","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70684","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145804","المتقارب"],[968,"","https://poetry.dctabudhabi.ae/diwan/poem/44795","المتقارب"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108644","الوافر"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67229","الهزج"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200201","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74298","الوافر"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132777","الوافر"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145048","الوافر"],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28878","الوافر"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/206244","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117900","الوافر"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36736","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133247","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77060","الوافر"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107296","الطويل"],[4042,"","https://poetry.dctabudhabi.ae/diwan/poem/69254","الطويل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117247","الطويل"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67569","الطويل"],[4673,"","https://poetry.dctabudhabi.ae/diwan/poem/104489","الطويل"],[4755,"إِذا ما صَحَا المَجنُونُ","https://www.poetsgate.com/ViewPoem.aspx?id=183649",""],[182,"وجع بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=72813",""],[4955,"إذا ما صار للجهال ظل","https://www.poetsgate.com/ViewPoem.aspx?id=206181",""],[4119,"أما وخيال زار ممن أحبه","https://www.poetsgate.com/ViewPoem.aspx?id=16065",""],[5277,"وما مثلُ العراق","https://www.poetsgate.com/ViewPoem.aspx?id=191713",""],[5277,"حيّا على الفلاح","https://www.poetsgate.com/ViewPoem.aspx?id=201283",""],[5411,"ضفاف الروح..","https://www.poetsgate.com/ViewPoem.aspx?id=191907",""],[5582,"ثَنَتْ لِوَداعِي جِيدَها غُدْوَةً يُسْرَا","https://www.poetsgate.com/ViewPoem.aspx?id=187150",""],[5690,"أيا اللّه ما أحلى وأجودْ","https://www.poetsgate.com/ViewPoem.aspx?id=172151",""],[4051,"إِذا ما صَمَّ فَلَم يُناجى","https://www.poetsgate.com/ViewPoem.aspx?id=79530",""],[6084,"وذي تقوى يروم علا وفخرا","https://www.poetsgate.com/ViewPoem.aspx?id=170839",""],[6093,"إِذَا مَا صَدَّ عنِّيْ دُوْنَ ذَنْبٍ","https://www.poetsgate.com/ViewPoem.aspx?id=198216",""]],"verses":[["إِذا ما صَدَدتَ دَعاني الهَوى","فَمِلتُ إِلى خُدُعاتِ العِتابِ",0,"ب",1,0],["إذا ما صَباحٌ فُرَّ عَنْهُمْ شَميطُهُ","وهَدَّ الدُّجى من رُكْنِها المُتَفَسِّخِ",1,"خ",1,0],["إِذا ما صَدَعتَ الحادِثاتِ بِحَدِّهِ","تَكَشَّفَ داجي الخَطبِ وَاِنجابَ غَيهَبُ",2,"ب",1,0],["إِذا ما صَديقي رابَني سوءُ فِعلِهِ","وَلَم يَكُ عَمّا رابَني بِمُفيقِ",3,"ق",1,1],["إذا ما صافحَ الأسماعَ يوماً","تبسَّمَتِ الضَّمائرُ والقلوبُ",4,"ب",1,0],["إِذا ما صَدَقتَ النَفسَ أَكثَرتَ ذَمَّها","وَأَكثَرتَ شَكواها وَأَقلَلتَ حَمدَها",5,"د",3,0],["إِذا ما صُرَّعَت مِنّا نَديماً","تَوَسَّدَ بِاليَمينِ وَبِالشِمالِ",6,"ل",1,0],["إذا ما صِدْتُها قالت رِجالٌ","ألمْ تكُنِ الكواكبُ لا تُصادُ",7,"د",1,0],["إِذا ما صَنَعتِ الزادِ فَاِلتَمِسي لَهُ","أَكيلاً فَإِنّي لَستُ آكِلَهُ وَحدي",8,"د",2,0],["إِذا ما صاحَ حَشرَجَ في سَحيلٍ","وَإِرنانٍ فَأَتبَعَهُ سَحيلا",9,"ل",2,0],["إذا ما صُبغَن بَورِس الهجي","ر حمرا تَجلَّيَن بالليل جُونا",10,"ن",2,0],["إِذا ما صام صارمه انتظاه","على الأعدا فيقطر حيثُ صلا",11,"ل",2,0],["إذا ما صب في قدح عقارا","يزيل الهم عن قلب الحزين",12,"ن",1,0],["إذا ما صفت يوماً تكدر صفوها","شهوراً وأعواماً بهذي الشوائب",13,"ب",1,0],["إذا ما صَديقي نالَ خَيراً فخانَني","فَما الذَّنبُ عندي لِلّذي خانِ أو فَجَرْ",14,"ر",1,0],["إذا ما صفا الإخلاص فالحب واحد","وإن كانت الأيام من غير واحد",15,"د",1,0],["إذا ما صِغْتُ في المَحْبوبِ نَظْماً","يُساعِدُني على النَّسَقِ الرَّوِيُّ",16,"ي",1,1],["إِذا ما صلاحُ الدينِ سَار بجَيْشِه","فليس الحِمَى إِنْ أَمَّه الجيشُ بالحِمَى",17,"م",2,0],["إذا ما صَحَوا مِن سكرةٍ دُرنَ بَينَهُم","مِنَ المَوتِ أقداحٌ وَإن نَهَلُوا عَلُّوا",18,"ل",3,0],["إذا ما صبت نفسي لمبدا صبوها","وعاد لها عوناً صنيع عدوها",19,"ه",2,0],["إذا ما صبحت الهندواني فارضه","وإلا فذر عبئ المكارم وارقد",20,"د",1,0],["إذا ما صدورُ الكافرينَ تكبَّرتُ","عليه أذلتْها صدورٌ وأرؤسُ",21,"س",1,0],["إذا مَا صَعَدتَ اصْعَدَنْ وَاثِقا","إذا مَا التفتَ التفِتْ وابْصقِ",22,"ق",1,0],["إِذا ما صَهَرنا قُيودَ العَبيدِ","بِنارٍ مِنَ القُوَّةِ القاهِرَهْ",23,"ر",2,0],["إذا ما صار بينهما","وبين الكاس مخمورا",24,"ر",2,0],["إذا ما صدَّ لم أدر","شَدا القمري أم ناحا",25,"ح",2,0],["إذا ما صديقٌ خان عهد وداده","فقد مات والتأبين فيه يليق",26,"ق",1,1],["إِذا ما صوت الحادي","مِن الأَجفان سحينا",27,"ن",2,0],["إذا ما صاح دين الله هبوا","رأيت الأرض راجفة رباها",28,"ا",3,0],["إذا ما صوت الناعي بأرض","تراه بسفك عبرته مجيبا",29,"ب",2,0],["إِذا ما صِحْنَ قُلتُ أُحِسُّ صُبحاً","وَقَدْ غادَرنَ لي لَيْلاً ثَقيلا",30,"ل",2,0],["إذا ما صح لي ديني وعرضي","فلست لما تولى ذا اهتمام",31,"م",1,0],["إذا ما صبحت قوماً فيتم","لصبيتهم وللغيد الحداد",32,"د",1,0],["إِذا ما صَحِبتَ المَرءَ فَاِصحَب مُهَذَّباً","كَريمَ السَجايا لِلفَضائل مُنتَمي",33,"م",2,0],["إذا ما صرت في لحدي وحيدا","ولم يقبل لدى الملكين عذري",34,"ر",2,0],["إِذا ما صادَمَ الأَقران يَوماً","لِوى بَأسَنَة الأَسل الطِوال",35,"ل",1,0],["إِذا مَا صَفَت وَقتاً يَسيراً تكدَّرَت","وُقُوتاً وإِن أَعطَت فبِالقُربِ تَرجِعُ",36,"ع",1,0],["إِذا ما صَرَفتُ الكعبَ صاحَت كَأَنَّها","صَريفُ خَطاطيفٍ بدَلوينِ تَمتَحُ",37,"ح",1,0],["إذا ما صفَت أوراد شربك في الهوى","وغيّب واشيها وواصلك الإلف",38,"ف",1,0],["إذا ما صديق لي تأوه واشتكى","عدمت سروري ما اشتكى ورقادي",39,"ي",1,1],["إذا ما صفاك الدهر عيشا مروقا","أصابك سهم الدهر سهما مفوقا",40,"ق",2,1],["إِذا ما صَحَا المَجنُونُ.. أَو نَامَ باكِرَا","فَمَعنَاهُ أَنَّ النَّومَ ما زالَ مَاكِرَا",41,"ر",2,1],["اذا ما صاح صوت الحق في وادٍ","تناسينا وتهنا في بوادينا",42,"ن",2,0],["إذا ما صارَ للجهَّالِ ظِلٌّ","فشمسُ العلمِ تنذرُ بالمغيبِ",43,"ب",1,1],["إذا ما صبا المحب إلى الصبا","ذكرت نسيما بالثغور مهبه",44,"ب",2,0],["إذا ما صاحتْ الدنيا ثبوراً","تجدهُ السيفَ يفري مَن أهمّا",45,"م",2,0],["إذا ما صاحَ (حيّا) قالَ قلبي","نعمْ واللهِ..قد وجبَ الفلاحُ",46,"ح",1,0],["إذا ما صغْتهُ شِعْرًا","سَأُنْعِشُ بالنَّدَى زَهْرَهْ",47,"ر",2,0],["إِذا ما صَمَتْنا أَلْسُناً وَتَرامَقَتْ","نَواظِرُنا أَضْحَى بِها سِرُّنا جَهْرَا",48,"ر",2,0],["إذا ما صيغ للعشاق تاج","تراني فوقهُ الدرّ المنضد",49,"د",1,0],["إِذا ما صَمَّ فَلَم يُناجى","وَأَودى سَمعُهُ إِلّا نِدايا",50,"ا",3,1],["اذا ما صاد قنبرة تثنى","كنشوان تدار له العقار",51,"ر",1,0],["إِذَا مَا صَدَّ عنِّيْ دُوْنَ ذَنْبٍ","تَلَفَّتَتِ الضُّلُوعُ إِلى الضُّلُوْعِ",52,"ع",1,1]]}