{"poems":[[93,"لا تسل أين الهوى والكوثر","https://www.aldiwan.net/poem8828.html","عموديه"],[82,"أشهاب في دجى الليل ثقب","https://www.aldiwan.net/poem31545.html","الرمل"],[48,"ضحك الدهر في محياك مكر","https://www.aldiwan.net/poem22593.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55037","الخفيف"],[203,"كان لي قلب فيا عجبي","https://www.aldiwan.net/poem45139.html","المديد"],[310,"العدل عهد خلافة الإنسان","https://www.aldiwan.net/poem56394.html","الكامل"],[396,"أيها العبد إن شئت الأمان","https://www.aldiwan.net/poem54475.html","عموديه"],[396,"الزم البيت لا تخرج من البيت تندم","https://www.aldiwan.net/poem54507.html","عموديه"],[469,"عق دمعي من بعد أهل العقيق","https://www.aldiwan.net/poem3605.html","عموديه"],[473,"لك عندي دستيجة مختومه","https://www.aldiwan.net/poem59675.html","الخفيف"],[520,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[469,"","https://poetry.dctabudhabi.ae/diwan/poem/205247","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64411","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124724","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124739","الكامل"],[2126,"","https://poetry.dctabudhabi.ae/diwan/poem/100549","الطويل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205434","الخفيف"],[3334,"","https://poetry.dctabudhabi.ae/diwan/poem/31454",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109938","الكامل"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199021","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72969","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72465","الرجز"],[4727,"ماذا أقول ولا جديد يُقالُ","https://www.poetsgate.com/ViewPoem.aspx?id=208820",""],[5431,"الحدْس.....","https://www.poetsgate.com/ViewPoem.aspx?id=198676",""],[5764,"حيرة الجاني","https://www.poetsgate.com/ViewPoem.aspx?id=174653",""],[402,"في معاليك قام عذر القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=36007",""],[5956,"الساقطون همْ ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181858",""]],"verses":[["وَالحَديثُ الصَفوُ ما يَنشُرُهُ","وَالحَديثُ السوءُ ما يَختَصِرُ",0,"ر",1,0],["والحديدُ الصلبُ لولا بأسُهُ","لم يخَفْ في الطعنِ من لين القصب",1,"ب",1,0],["وَالحَديثُ المَسموعُ يوزَنُ بِالعَق","لِ فَيُضوى إِلَيهِ عُرفٌ وَنُكرُ",2,"ر",1,0],["وَالحَدِيثُ الرَّشِيقُ يُعْطِي النَّدَامَى","شَهْوَةَ النَّفْسِ مِنْ خِلاَلِ السلاَفِ",3,"ف",1,0],["والحديد الصلب تحسبه","صورة عمياء من صوره",4,"ر",2,0],["وَالحدّ عَن نهكِ المحارمِ حاجز","في خرقهِ تَسهيلهُ للجاني",5,"ن",2,0],["والحديث أن أشرار الأنام","من تغذوا بألوان الطعام",6,"م",1,0],["والحديث إن تكن بالله واليوم الأعظم","تؤمن اصمت والأخير قل فافهم افهم",7,"م",1,0],["والحديثُ الحديثُ يفعل بال","صبّ المعنَّى فعلَ الشَّراب العتيق",8,"ق",1,0],["وَالحَديثُ الَّذي أَخُصُّكَ مِنهُ","بِدواءِ يَشفى النُفوسَ السَقيمه",9,"م",2,0],["والحدق النجل لها أوامر","يمضين حكم القسر في القساور",10,"ر",1,0],["والحديثُ الحديثُ يفعل بالصب","ب المعنَّى فعلَ الشَّراب العتيق",11,"ق",1,0],["والحد بالحاء الذي قد أهملا","لا غير والإضمار معه اعملا",12,"ل",2,0],["والحد والرسم والأشكال والصور","والحل والعقد والابرام والغير",13,"ر",1,0],["والحدبا والعقربان مع ال","فار ويبني عن الجرور الظلالا",14,"ل",2,0],["والحد فيه على النشاوى إن هم","لم يعقلوا ما نسةُ الآباء",15,"ا",2,0],["وألحدت بدراً في التراب ولم أكن","أرى قبل هذا اليوم أن يلحد البدر",16,"ر",1,0],["والحداء الرخيم في المهمه القف","ر عزاء للعيس في الوخدان",17,"ن",1,0],["والحد في القطع منصوص به وعلى","الإمام أن ينفذ الحكم الذي نزلا",18,"ل",2,0],["والحِد بلحدِ نَدامةٍ مَيتَ الخَطا","من قبلِ أَن تنحازَ للأَلحادِ",19,"د",1,0],["والحد قول موجز مطبوع","مخصص يدرى به الموضوع",20,"ع",1,0],["والحدث أدلى دلوه في جبها","فامتلأ الدلو إلى عقد الكوب",21,"ب",1,0],["والحدس أدلى دلوه في جبها","فامتلأ الدلو إلى عقد الكرب",22,"ب",1,0],["والحَدُّ يَسْقُطُ بالجَهالَةِ عندنا","لكِنَّهُ لا يُعْذرُ الجُهّال ُ",23,"ل",1,0],["والحدس أقوى مايكون بشاعرٍ","فهو اليراع ووحيه المتدفقُ",24,"ق",1,0],["والحدود اللي فصلتني عن جنابه","علمتني من الوفاء ماهو كفاني",25,"ن",2,0],["والحديث الرشيق يعطي الندامى شهوة النفس من خلال السلاف","وسخاء المتلاف يؤمن إيمانا صحيحا بالرازق المخلاف",26,"ف",1,0],["‏ ‏والحدّ محتوم عليهم وحدِهِمْ","‏ ‏ آذَوْا عذارى في تمامِ الطيبةِ",27,"ه",1,0]]}