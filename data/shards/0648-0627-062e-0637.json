{"poems":[[55,"يا من رأى البرق على الأنعم","https://www.aldiwan.net/poem29815.html","السريع"],[55,"بغير شفيع نال عفو المقادر","https://www.aldiwan.net/poem30465.html","الطويل"],[74,"عوض بكأسك ما أتلفت من نشب","https://www.aldiwan.net/poem18227.html","البسيط"],[53,"دع الأجمال مرتحله","https://www.aldiwan.net/poem65935.html","مجزوء الوافر"],[64,"على أثلات الواديين سلام","https://www.aldiwan.net/poem52296.html","الطويل"],[47,"أبالمنحنى أم بالعقيق أم الجرف","https://www.aldiwan.net/poem65157.html","الكامل"],[76,"وأخطل لو تعاطى سبق برق","https://www.aldiwan.net/poem12881.html","الوافر"],[83,"أسيف الوزارة بوركت من","https://www.aldiwan.net/poem61329.html","المتقارب"],[13,"وبالشعب إذ سدت بجيلة فجه","https://www.aldiwan.net/poem2213.html","الطويل"],[77,"أما والمذاكي يلكن الشكم","https://www.aldiwan.net/poem69039.html","المتقارب"],[50,"خليلي هذا موقف من متيم","https://www.aldiwan.net/poem65258.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/141831","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54243","الرمل"],[102,"في طريق الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=50125",""],[13,"وَبِالشِّعْبِ إذْ سَدَّتْ بَجِيلَةُ فَجَّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=180797",""],[230,"يا لواء الحسن أحزاب الهوى","https://www.aldiwan.net/poem55176.html","الرمل"],[370,"فاتنا بدر وأحد","https://www.aldiwan.net/poem44375.html","مجزوء الرمل"],[445,"بحكم العدل من قاضي السماء","https://www.aldiwan.net/poem34836.html","الوافر"],[466,"أسر بالبرق لا حرصا على الديم","https://www.aldiwan.net/poem16089.html","البسيط"],[484,"كل يترجم عن إحساسه لكمو","https://www.aldiwan.net/poem37057.html","البسيط"],[520,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[556,"صبرت ومثلك لا يجزع","https://www.aldiwan.net/poem47722.html","المتقارب"],[556,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[556,"عشقت العلا لا أبتغي بدلا لها","https://www.aldiwan.net/poem48087.html","الطويل"],[580,"أيا شمسي منك أشرق بهجة","https://www.aldiwan.net/poem2994.html","الطويل"],[591,"أأطلب يا محمد أن يؤولا","https://www.aldiwan.net/poem17660.html","الوافر"],[672,"","https://poetry.dctabudhabi.ae/diwan/poem/102040","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95507","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79820","الرمل"],[1600,"","https://poetry.dctabudhabi.ae/diwan/poem/146085","الوافر"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26425","السريع"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53113","المتقارب"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53170","الطويل"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28062","الطويل"],[2346,"","https://poetry.dctabudhabi.ae/diwan/poem/18007","الوافر"],[2612,"","https://poetry.dctabudhabi.ae/diwan/poem/31524","الطويل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145046","الطويل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123914","الرمل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48435","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45824","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91577","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117901","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77016","الرجز"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125818","الطويل"],[4162,"","https://poetry.dctabudhabi.ae/diwan/poem/67785","البسيط"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113822","البسيط"],[4657,"","https://poetry.dctabudhabi.ae/diwan/poem/140146",""],[4699,"مشرقة","https://www.poetsgate.com/ViewPoem.aspx?id=193395",""],[4727,"كورونا السياسي","https://www.poetsgate.com/ViewPoem.aspx?id=210810",""],[4856,"عنيد","https://www.poetsgate.com/ViewPoem.aspx?id=36737",""],[4858,"أطلق جناحك","https://www.poetsgate.com/ViewPoem.aspx?id=138073",""],[4927,"قصيدة لعيني عُروة وعَفْراء","https://www.poetsgate.com/ViewPoem.aspx?id=29954",""],[5009,"إليك يابن الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=68819",""],[5057,"لستُ أخفيكِ","https://www.poetsgate.com/ViewPoem.aspx?id=197241",""],[5122,"لا تجرح المجروح","https://www.poetsgate.com/ViewPoem.aspx?id=17972",""],[5126,"تحياتي إليك مع السماح","https://www.poetsgate.com/ViewPoem.aspx?id=206091",""],[5183,"بين الهيمنة والهينمة","https://www.poetsgate.com/ViewPoem.aspx?id=180155",""],[5277,"سرُّ المصون","https://www.poetsgate.com/ViewPoem.aspx?id=191106",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5431,"بكل اختلاجات القلوب لعالم ...","https://www.poetsgate.com/ViewPoem.aspx?id=191588",""],[5459,"جمر البسوس","https://www.poetsgate.com/ViewPoem.aspx?id=198707",""],[5703,"ليلة شوق","https://www.poetsgate.com/ViewPoem.aspx?id=206151",""],[5736,"تشرين","https://www.poetsgate.com/ViewPoem.aspx?id=203886",""],[5837,"مسمّى مزامل","https://www.poetsgate.com/ViewPoem.aspx?id=177547",""],[5881,"لهب الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=183864",""],[5926,"تراتيل الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=214036",""],[5956,"تخاصمني الحبيبة نايُ أيضاً","https://www.poetsgate.com/ViewPoem.aspx?id=194077",""],[5993,"غدر قلبي وحلل حرامه","https://www.poetsgate.com/ViewPoem.aspx?id=186642",""],[520,"إذا قدرت على العلياء بالغلب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577434",""],[5126,"تحياتي إليك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87788&r=&rc=3",""]],"verses":[["وَاِخطُب عَلى سَيفِكَ بِكرَ العُلى","فَقَد تَمَلَّأتَ مِنَ الأَيِّمِ",0,"م",1,0],["وَأَخطَأَ سَهمَ القِطرِ مَقتَلَ مَحلِهِ","فَزَمَّ قَسِيَّ العادِياتِ الهَوامِرِ",1,"ر",1,0],["واخطبْ إلى الشربِ أمَّ الدهر إن نسبت","أختَ المسرَّةِ واللهو ابنةَ العنب",2,"ب",1,0],["وأخطَلُ دَهْرِه شعراً","بغير سَجيَّةٍ خَطِلَهْ",3,"ل",2,0],["وأخطُ سوادَ الليل وهو جَحافلٌ","وأرعَ نجومَ الأفقِ وهي سِهامُ",4,"م",1,0],["وَأَخطَرَني لِلشاتِمينَ وَلَم أَكُن","لِأُشتَمَ إِلّا بِالتَكَذُّبِ وَالقَرفِ",5,"ف",1,0],["وَأَخطَلَ لَو تَعاطى سَبقَ بَرقٍ","لَطارَ مِنَ الفِجاءِ بِهِ جَناحُ",6,"ح",1,1],["وَأخطِرُ ذِكرَكَ فِي خَاطِرِي","فَأوقِنُ بِالفَرَجِ العَاجِلِ",7,"ل",1,0],["وَأَخطَأَهُم قَتلي وَرَفَّعتُ صاحِبي","عَلى اللَيلِ لَم تُؤخَذ عَلَيهِ المَخاتِلُ",8,"ل",1,0],["وأخطَأكَ الشّبْهُ إنْ قِيلَ ذا","أُجاجٌ وهذا فُراتٌ شَبِم",9,"م",1,0],["وَأَخطَرتُمُ دونَ النَبِيِّ نُفوسُكُم","بِضَربٍ يُزيلُ الهامَ عَن كُلِّ مَجثِمِ",10,"م",1,0],["وأخطأت في إنفاذ رقعتك التي","هي المجد لي منها أخير وأول",11,"ل",1,0],["واخطرِي بينَ الندامَى يحلفوا","أنك الغصن ازدهاراً واستواءْ",12,"ا",2,0],["واخطري يا صديقتي في طريق ال","فجر كالفجر ، كالعروس الأنيقه",13,"ق",2,0],["وَأخْطَأَهُمْ قَتْلِي وَرَفَّعْتُ صَاحِبِي","عَلَى اللَّيْلِ لَمْ تُؤْخَذْ عَلَيَّ الْمَخَاتِلُ",14,"ل",1,0],["وَأخْطَأَ غُنْمَ الْحَيِّ مُرَّةُ بَعْدَ مَا","حَوَتْهُ إلَيْهِ كَفُّهُ وَالأنَامِلُ",14,"ل",1,0],["واخطِري بين النَدامى يَحلِفوا","أنَّ روضاً راح في النادي وجاء",15,"ا",2,0],["واخطُبوا الحُورَ إِلى اللَه","بقتال القادسيَّه",16,"ي",2,0],["وأَخْطَأَ سَيْرُهُمْ أُفْقَ ابْنِ يَحْيى","لِيُخْطِئَ عِلْمُهُمْ بِالكِيمياءِ",17,"ا",2,0],["وأخطبُ الودَّ قبل الرِّفد ما رضيت","به العُلى واطمأنت أنفسُ الهممِ",18,"م",1,0],["واخطر لنا تحت قوس النصر منثلجا","صدرا وقل قدحي بالبشر منقعم",19,"م",1,0],["واخطب بألسنة الأغماد ا عجزت","عن نيله ألسن الأشعار والخطب",20,"ب",1,0],["وأخطأَ مَن قال إنّ النّسا","ءَ أَهلونَ لِلفقد أَو موضعُ",21,"ع",1,0],["وَأَخطَرَني مِن بعد أَنْ كانَ لي حِمىً","وَأَفردني مِن بعد أَنْ كانَ صاحِبي",22,"ب",2,0],["وَأَخطأتُ لمّا أن جَعلتكَ صاحِبي","وَذو الحَزمِ يُخطِي مرّةً ويصيبُ",23,"ب",1,0],["وأَخْطَبُ من قُسٍّ وأَفْصَحُ منطِقاً","سكوتٌ لذاك الحِجْلِ أَو ذَلِكَ القَلْبِ",24,"ب",1,0],["وأَخطِب غَير شَمسكَ أَن تُجَلَّى","وأَسأَل غَيْرَ مائِكَ أَنْ يَسِيلا",25,"ل",2,0],["واخطب فمحفلك البلاد وأهلها","مصغ لأخطب قائل فعال",26,"ل",1,0],["واخطُر يَزدوادى النماء خصوبة","ويردِّد النيلُ الثناء جميلا",27,"ل",2,0],["واخطبوا طعناً بها عن ألسُنٍ","طالما أنشأت الموتَ ارتجالا",28,"ل",2,0],["وأخطر ما يريب إذا دهتني","غوامضه إلى ما لا يريب",29,"ب",1,0],["وَأَخطَبُ الناسِ عَلى مِنبَرٍ","يَختالُ في وَطأَتِهِ المِنبَرُ",30,"ر",1,0],["وأخطر تِيهاً ولي خاطر","يناجي المنى بعظيم الخطرْ",31,"ر",1,0],["وأخطر ما بين السماطين منشداً","مدائح تستجلى لديك وتستحلى",32,"ل",2,0],["وَأَخطَبَ في فَنواءَ يَنتِفُ ريشَهُ","وَطَيرٍ جَرَت يَومَ العَقيقِ حَوائِمِ",33,"م",1,0],["وَأَخطَبَها إِذا اِجتَمعوا لِأَمرٍ","وَأَقصَدها وَأَوفاها عُهودا",34,"د",2,0],["وَأَخطَأَ عَبداً لِيلَةَ الجِزعِ عَدوَتي","وَإِيّاهُمُ لَولا وُقوها تَحَرَّتِ",35,"ت",1,0],["وأخطأك الموت الزؤام يقوده","إليك امرؤ أملى له الغي ما أملى",36,"ل",2,0],["واخطبي فيه بأنواع الغنا","واخرسي كل مغن وخطيب",37,"ب",1,0],["وأخطُبُ للآدابِ غُرَّ عقائِلِ","تفوقُ حُلاها بُحْتُريّاً وطائِيّا",38,"ي",2,0],["وَاِخطر بِها كَالغُصن يَحمل زَهرة","كَالتاج يُشرق فَوق هامة قَيصَر",39,"ر",1,0],["وَاخطر لدينا مثلَ أَغصانِ النَقا","أَو غَنِّنا كَالبُلبلِ الصيّاح",40,"ح",1,0],["واخطب عذارى المجد في آفاقها","واشهد مواسمها على ميعادها",41,"د",3,0],["وَأَخطَرُ السِرَّ بِواديكا","بُرهانُ سُلطانِكَ عَنّي جَلا",42,"ا",1,0],["وأخطر من أعدائنا بُغض بعضِنا","لبعض وطلابُ اللهى والرواتب",43,"ب",1,0],["وَأخْطَأتَنِي الْمَنَايَا لاَ تُطَالِعُني","حَتَّى كَبِرْتُ وَلَمْ يَتْرُكْنَ لِي نَشَبَا",44,"ب",2,0],["واخطب كريمة آباء غطارفة","فالعرق دساس يردى نسل كل على",45,"ل",2,0],["واخطب جميع ممالك الدنيا تنل","منها القبول فأنت أعظم وال",46,"ل",1,0],["وأخطرُ منه إلهاماً وسِحراً","بريقٌ مشرقٌ في مُقلتيكِ",47,"ك",1,0],["وَأخطَرُ كُورُونا على الشّعبِ إذْغدا","يُرِيدُ خلاصَ الأرضِ من كلِّ طاغِية",48,"ي",2,1],["وأَخطو كطيرِ الحمامِ الذبيحْ","وأَمضي بروحي وأَغدو شهيدا",49,"د",2,0],["واخطب لجُمعة ثورَةٍ وهّاجةٍ","وادعُ الإلهَ لنُصرة الثّوار",50,"ر",1,0],["وَأَخُطُّ فِيْ سِفْرِ الْغَرَاْمِ مَكَاْرِمًا","أَعْيَاْ لَعَمْرُكَ نَصُّهَا الشُّرَاْحَاْ",51,"ح",2,0],["وأخطر الغزو غزو لا يُريق دما","إلا التسلل للأفكار مُخْتَرطا",52,"ط",2,0],["واخطُري لي لجبرِ بالي فإنّي","لستُ مِن مَن يُطيلُ في الصّبرِ بالا",53,"ل",2,0],["وأخطئ الطريق وحر نارك وطأ فيه","الله كتب له في جحيمك مداجا",54,"ج",2,0],["وأخطو والحياة خطاً ولكن","وددت لو أنني طلق الجماح",55,"ح",1,0],["واخطط له يا ماجد المجد الذي","سيراك فيه غداً بدار بقائه",56,"ا",3,0],["وأخطبه لروحي في ذهولٍ","وأعطيه المحبة فيه مهرا",57,"ر",2,0],["واخطب إذا ما شئت جارتها وط","لق من نكحت وأنت في روقان",58,"ن",1,0],["وأخطرُ مافي العمر تيهٌ مضللٌ","غرورٌ من الشيطان فجٌ وآثمُ",59,"م",1,0],["وأخطرُ ما يُؤذي الديارَ رُعاتها","إذا ما استحلّ النهبَ والهدمَ حارسُ",60,"س",1,0],["وأُخْطئُ باسمكَ في كلِّ حينٍ","كأنّكَ في كلِّ مَنْ قَد أرى",61,"ر",2,0],["وَأخطلٌ مذ أَتى بالحَرفِ يَصفَعُني","بشهقَةٍ أَضرَمتْ في الصدرِ نيرانا:",62,"ن",2,0],["واخطيت يوم احسنت معك التعامل","ولاجاك غير الطيب مع صايب الشور",63,"ر",1,0],["وأخطو نحوها فأحس ناراً","وريح صبابةٍ طارت بعالي",64,"ل",2,0],["‏وأخط في قلبي تراتيل الهوى","بنمير دمعي ليته القلب ارتوى",65,"و",2,1],["وأُخطىء في تعابيري وشعري","وإن عوقبتُ أستجْدي اللئاما",66,"م",2,0],["واخطا علي بدون عذر وعذرته","وكم مرةٍ تجرح ضميري اسهامه",67,"م",2,0],["وأخطب بألسنة الإغماد ما عجزت","عن نيله ألسن الأشعار والخطب",68,"ب",1,0],["وأخطو والحياة خطاً ولكنّي","وددت لو أنني طلق الجماح",69,"ح",1,0]]}