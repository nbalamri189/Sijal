{"poems":[[90,"لعمرك ما كل انكسار له جبر","https://www.aldiwan.net/poem45069.html","الطويل"],[93,"شوق يروح مع الزمان ويغتدي","https://www.aldiwan.net/poem8800.html","عموديه"],[94,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[80,"أيها الفائق أهل ال","https://www.aldiwan.net/poem14164.html","مجزوء الرمل"],[30,"أرى شعراء الناس غيري كأنهم","https://www.aldiwan.net/poem5321.html","الطويل"],[104,"جزت بالحي في العشي فهبت","https://www.aldiwan.net/poem33098.html","الخفيف"],[52,"يا طلل الحي بذات الصمد","https://www.aldiwan.net/poem63943.html","الرجز"],[52,"يا صاح دعني فإنني نصب","https://www.aldiwan.net/poem64857.html","المنسرح"],[48,"أغنى الأنام تقي في ذرى جبل","https://www.aldiwan.net/poem22250.html","البسيط"],[48,"إذا وقت السعادة زال عني","https://www.aldiwan.net/poem23525.html","الوافر"],[48,"يا ساهر البرق أيقظ راقد السمر","https://www.aldiwan.net/poem23634.html","البسيط"],[48,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[93,"شوق يروح مع الزّمان ويغتدي","https://www.poetsgate.com/ViewPoem.aspx?id=53481",""],[119,"بالله ياحبا اضا","https://www.aldiwan.net/poem40892.html","عموديه"],[132,"من لصب دموعه ليس ترفا","https://www.aldiwan.net/poem50563.html","الخفيف"],[201,"طرقتني فجر يوم المولد","https://www.aldiwan.net/poem39890.html","الرمل"],[275,"سأتبع ظل الموت بين الكتائب","https://www.aldiwan.net/poem35630.html","الطويل"],[290,"فغدت رياض العلم مزهرة فيا","https://www.aldiwan.net/poem39340.html","الكامل"],[302,"للريح في وجنات الورد تخميش","https://www.aldiwan.net/poem33233.html","البسيط"],[333,"خمس وعشرون عاما","https://www.aldiwan.net/poem54956.html","المجتث"],[376,"نجا المعري من العار","https://www.aldiwan.net/poem57368.html","السريع"],[408,"لا نال منك فؤادي ما يرجيه","https://www.aldiwan.net/poem46474.html","البسيط"],[408,"كنانة عز فوقت للعدى نصلا","https://www.aldiwan.net/poem46921.html","الطويل"],[447,"عجبا لراج فوز ناج سابق","https://www.aldiwan.net/poem14317.html","الكامل"],[447,"هو الرزء حتى خص ريش القوادم","https://www.aldiwan.net/poem14478.html","الطويل"],[463,"خفف بذات البان من أثقالها","https://www.aldiwan.net/poem55951.html","الرجز"],[463,"دمعي وإن كان دما سائلا","https://www.aldiwan.net/poem56004.html","السريع"],[463,"لكِ الغرام وللواشي بكِ التعب","https://www.aldiwan.net/poem56274.html","البسيط"],[498,"ورجاء سيف الدولة الشرف الذي","https://www.aldiwan.net/poem67287.html","عموديه"],[520,"هي الصدمة الأولى فمن بان صبره","https://www.aldiwan.net/poem12130.html","الطويل"],[520,"لما أدار مدامة الأحداق","https://www.aldiwan.net/poem12187.html","الكامل"],[572,"عراني الزمان بأحداثه","https://www.aldiwan.net/poem69758.html","المتقارب"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103078","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54046","الكامل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130146","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59419","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64985","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136368","الخفيف"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117562","المتقارب"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87818","الكامل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76659","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48197","الخفيف"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26207","الوافر"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100894","الرمل"],[3015,"","https://poetry.dctabudhabi.ae/diwan/poem/199445","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133985","الخفيف"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133973","الخفيف"],[3187,"","https://poetry.dctabudhabi.ae/diwan/poem/138774",""],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62868","الخفيف"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48313","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138563",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92070","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91091","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83521","البسيط"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139259","الخفيف"],[4755,"الغُوْلُ, والعَنْقاءُ, والتِّنِّينُ","https://www.poetsgate.com/ViewPoem.aspx?id=184098",""],[4853,"فديت إماماً صيغ من عزة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=181769",""],[4869,"الصدفه","https://www.poetsgate.com/ViewPoem.aspx?id=151582",""],[4896,"هذه الموجة من هذا الخضم","https://www.poetsgate.com/ViewPoem.aspx?id=180862",""],[4966,"الأصلُ والفرعُ","https://www.poetsgate.com/ViewPoem.aspx?id=196675",""],[5302,"سأمضي","https://www.poetsgate.com/ViewPoem.aspx?id=200676",""],[5573,"عبرتك فعل البليد ومكسبه وإفلاسه","https://www.poetsgate.com/ViewPoem.aspx?id=206490",""],[5574,"تائية أبي ريما","https://www.poetsgate.com/ViewPoem.aspx?id=206045",""],[5839,"مذ لاح المنام","https://www.poetsgate.com/ViewPoem.aspx?id=62049",""],[5842,"على ضفافِ القلق \\ محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=126129",""],[5888,"رؤيا وواقع مرير","https://www.poetsgate.com/ViewPoem.aspx?id=214508",""],[5956,"النقود الطائرة","https://www.poetsgate.com/ViewPoem.aspx?id=184581",""],[6144,"باريس خلاص","https://www.poetsgate.com/ViewPoem.aspx?id=21847",""],[6213,"الناس أسرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76273&r=&rc=30",""],[6249,"حبٌّ مختَلَق !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85657&r=&rc=0",""],[572,"عَراني الزّمَانُ بأحداثِهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9201&r=&rc=58",""]],"verses":[["وافق المعاني في التصور واسع","يتيه إذا ما طار في جوّه الفكر",0,"ر",1,0],["وَأَفَقتُ إِذا قَطَعَ الكَلامَ مُكَلِّمي","فَنَظَرتُني فَإِذا أَنا لَم أَصعَدِ",1,"د",1,0],["وأَفَقْنا فقلتُ كالحالمِ المس","حورِ قولي تَكَلَّمي خَبِّريني",2,"ن",2,0],["وافَقَ العَنبَرُ مِن لَف","ظِكَ مِن ذهنيَ مِجمَرْ",3,"ر",1,0],["وَأَفقَأُ صادَ الناظِرينِ وَتَلتَقي","إِلَيَّ هِجانُ المُحصَناتِ الطَرائِفِ",4,"ف",1,0],["وافقت نظرتي نداءَ غلامٍ","ناصري يا رمان من كَفْر كنَّا",5,"ن",2,0],["وافَقَ حَظّاً مَن سَعى بِجَدِّ","قُل لِلزُبَيرِ السائِلي عَن وُلدي",6,"د",2,0],["وافَقَ ظُلمي حُلواً فَأَعجَبَهُ","وَالظُلمُ حُلوٌ كَأَنَّهُ جَرَبُ",7,"ب",1,0],["وَأَفقَرُ الناسِ في دُنياهُمُ مَلِكٌ","يُضحي إِلى اللَجَبِ الجَرّارِ مُحتاجا",8,"ج",2,0],["وَأَفقَرَني إِلى مَن لَيسَ مِثلي","كَما اِفتَقَرَ السِنانُ إِلى المِسَنِّ",9,"ن",1,0],["وافَقْتَهُمْ في اختلافٍ من زَمانكمُ","والبَدرُ في الوهْنِ مثلُ البدرِ في السّحرِ",10,"ر",1,0],["وافَقَ اسْمُ ابنِ أحْمدَ اسْمَ رَسُو","لِ اللهِ لمّا تَوافَقَ الغَرَضَانِ",11,"ن",1,0],["وأفقت ، إذ قطع الكلام مكلّمي","فنظرتني فإذا أنا لم أصعد",12,"د",1,0],["وافقت فينا الخائني","ن وطرف بغيك قد طرف",13,"ف",1,0],["وافقُوا بالصبِّ المتيم فالر","فقُ لمن آلف الكآبةَ أَبقَى",14,"ق",2,0],["وأفقنا فإذا بالشيخ قادم","وكلانا مطمئن النفس ناعم",15,"م",1,0],["وأفقدُ صحبي واحداً بعد واحدٍ","وأبكي عليهم في بلادِ الأجانب",16,"ب",1,0],["وافقه أصول مقاله وافصح بما","يلقيه من لغة بنطق صائب",17,"ب",1,0],["وأفقُنا بلألي الغَيثِ متَّشِحٌ","وَقُطرنا بمياهِ القَطر مَرشوشُ",18,"ش",1,0],["وأفقد العقل إمّا","حستها أحلاما",19,"م",2,0],["وافَقَني أمسِ عَلى أنَّه","يقولُ بالجنَّة والنارِ",20,"ر",1,0],["وأُفق نَظْمٍ تذيبُ الصّخر رقّتُهُ","أَطْلَعتُ فيه نجوماً مِنْ معانيهِ",21,"ي",2,0],["وأفق فخارٍ أطلعَ البدرَ زاهراً","يُنير فَيمْلاَ نورُهُ الحزنَ والسَّهلا",22,"ل",2,0],["وافقت أهل الخير في أقوالهم","وعلى الفعال فأنت غير موافق",23,"ق",1,0],["وافقأ عين المجد حتى تغورت","وأعمى قلوب الواجبات اللوازم",24,"م",1,0],["وافقَ من أشخاصها طولُ السُّرى","وخالف الأوطارُ من أحوالها",25,"ل",3,0],["وافقه في الجود عُذَّالُه","من جَمعَ العاشقَ والعاذلا",26,"ل",2,0],["وأفقرتك العطايا والثناءُ غنىً","وأنصبتك العلا والراحةُ النَّصَبُ",27,"ب",1,0],["وأفقت حين بلغت ورد نواله","عن ورد ممتنع النوال بخيله",28,"ل",2,0],["وأفقر أهل الأرض من باذل الغنى","إذا قنط المحتاج واشتد فقره",29,"ر",2,0],["وافقته مذ كان وهو مخالفي","فأعجب لطول خلافه ووفاقي",30,"ق",2,0],["وافقتها زمن الشباب فأقسمت","لا كان رفق العيش بعض رفاقي",30,"ق",2,0],["وَأَفْقَدَيِنْهِ على ضِنَّةٍ","به للزَّمانِ غريمٌ مُلِحْ",31,"ح",1,0],["وافقه رسوم هياكل قد سطرت","تنبيك عن سر الخطاب المبهم",32,"م",1,0],["وأفق وقم لصلاته في وقتها","إن الصلاة وسيلةٌ هي ما هي",33,"ا",3,0],["وافقتد الاخلاص في حب آله","إذا قلت للرحمن اياك نعبد",34,"د",1,0],["وأفق على الأصحاب أسبع حلة","رقم النعيم أديمها بتمتع",35,"ع",1,0],["وأَفقِدُ روحَ الأُنْسِ طَوْراً فأَنطوي","على زَفَراتٍ تُقلِقُ الإِنْسُ والجِنَّا",36,"ن",2,0],["وافق الطبع ذوقه فانبسطنا","بجمال من حسن ذلك باهي",37,"ي",1,0],["وأُفقِ بدت فيه أعجوبةٌ","تبينُ حكمةَ خلاقِها",38,"ه",2,1],["وَافِق أخَا الوِفَاقِ فِي وِفَاقِهِ","وَدَارِ مَن نَافَقَ فِي نِفَاقِهِ",39,"ه",1,0],["وَأَفَقتُ مَذعوراً عَلى قَلبٍ غَدا","إِن يَدعُهُ داعي الرَذيلَةِ يَنفرِ",40,"ر",1,0],["وأفق من الأنف الذي تعتده","عزا فقد يدع العزيز ذليلا",41,"ل",2,0],["وافَقُونِي في مذهبِ الحبِّ واللَهْ","وِ ولكنْ في عصرِ شرخِ الشبابِ",42,"ب",1,0],["وَأَفقَدُ ما طَلَبتُ فَلَم أَجِدهُ","رَفيقٌ في صَحابَتِهِ رَفيقُ",43,"ق",1,0],["وافقاتٍ صمتها أبلغُ من","نطقها لو يملك الصخرُ الكلاما",44,"م",2,0],["وأفقدنيها الريق أماً حفيةً","إذا هي ضفت ألفت بين رفدين",45,"ن",1,1],["وافق الكنه في الحقائق مهما","قارن الصدق وعده ووعيده",46,"د",2,0],["وافقته الأفكار من وزراء","نجحوا بالتوفيق والتأييد",47,"د",1,0],["وأفِق من سكرةِ الغي ولا","تحسبَنَّ الجدَّ من قولي مِزاحا",48,"ح",2,0],["وافقَ السَّائراتِ والقمرُ الزا","هرُ يَنمي والشمسُ في الأَصعادِ",49,"د",1,0],["وأُفْقاً إلى الذّكْرِ الحكيمِ ومَطْلِعاً","ومَرْمىً إلى الوَحْي الكريمِ ومَهْبِطا",50,"ط",2,0],["وافقيداً ما رقت عين الندى","بعده حزناً عليه وافتجاعا",51,"ع",2,0],["وافْقَهْ هِيُولَى وجودٍ كم تَناوبها","من صورةٍ لا يكاد الدهر يبقيها",52,"ي",3,0],["وَافقَهْ فإِنك سَوف تَلقى رِفدَه","إِن حشرجت وَتذلل الأَنف الحمى",53,"م",2,0],["وافَقتَ آيَ كِتاب اللَهِ في حكم","بِما اِرتَأيتَ فَكانَت نحو بِضع عَشَر",54,"ر",1,0],["وافق الناس إن أردت السلامه","إن روح الوفاق روح كرامه",55,"م",2,1],["وأَفَقْتَ مُرتَجفًا.. وكُلُّ تَحَاوُرٍ","وَهْمٌ, وكُلُّ حَقيقةٍ تَخمِينُ",56,"ن",1,0],["وأَفَقْتَ.. لا (أَيلُولُ) قُربَكَ وَاقِفٌ","يَشدُو, ولا بجوارِهِ (تشرينُ)",56,"ن",1,0],["وأفقه في تدريسه من محمد","وأجود من كعب وأخطب من قس",57,"س",1,0],["وافقّر احسآسي وآتيك واشحذك","واعطيك مايرفع لقلبك بيآرق",58,"ق",1,0],["وأفقنا في سنى الصبح على","طرب العيد وتجسيد الحلم",59,"م",1,0],["وأفْقى ما به سحب","فلا برق ولا لمعُ",60,"ع",1,0],["وأفقده الطموح وظل عبئا","ثقيلا لا ينال ولا ينيل",61,"ل",1,0],["وافق المفهوم واسقى بالمنيّه كاسه","والكبود الي تعصر السم سم اسقاها",62,"ا",3,0],["١٧- وأَفَقْتُ من حُلْمي ولكنْ لم يزلْ","خمْرٌ يسيلُ بفِيَّ من قَطْراتِها",63,"ت",3,0],["وأفقتُ من غيبوبتي متقهقراً","وتفتّقتْ عن غفوتي الأبوابُ",64,"ب",1,0],["وأفقتُ في صحوي أُرَدِّدُ قَولَهَا","واحسرتاه...، فَحِسُّنا يتبلّدُ",65,"د",1,0],["وأفقتُ من نومي وأذكرُ أنني","ردّدتُ من خوفي دعائي صادحة",66,"ح",2,0],["وافقَ الطفلُ بقلب ليس يألو","طاعةً ، يرجو دموعَ الأمّ تنفَدْ",67,"د",1,0],["وافقت عظمته وجبروته لا يفوتها لحظة ولا تفوته","الإمبراطور في تابوته نايم هنا تحت ثراها",68,"ا",3,0],["وافقتهم ودليل الشعر يسبقني","وليس للبوح أسرار وأسوار",69,"ر",1,0],["وأفقتُ الآنَ .. والقلبُ دَرى","أنَّ حُبِّي لكِ .. حُبٌّ مُختلَقْ !",70,"ق",1,0],["وأفقَدَنِيهِ على ضِنّة ٍ","بهِ للزمانِ غريمٌ مَلِحْ",71,"ح",1,0]]}