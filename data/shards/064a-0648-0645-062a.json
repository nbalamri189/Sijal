",""],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[5147,"روح النفس فهي ضيف بمغناك","https://www.poetsgate.com/ViewPoem.aspx?id=166733",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5225,"مرحبا يا مطول الغيبه","https://www.poetsgate.com/ViewPoem.aspx?id=27616",""],[5333,"لبستْ صَفيةُ بنتُ ابنتِنا","https://www.poetsgate.com/ViewPoem.aspx?id=9488",""],[5414,"صرخة من وراء الأسوار","https://www.poetsgate.com/ViewPoem.aspx?id=12936",""],[5463,"طاري الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=33841",""],[5491,"صلى عليك","https://www.poetsgate.com/ViewPoem.aspx?id=215281",""],[5544,"قصيدة النصر","https://www.poetsgate.com/ViewPoem.aspx?id=213575",""],[5770,"صحبة النشء","https://www.poetsgate.com/ViewPoem.aspx?id=178679",""],[402,"خرجت هند ذات يوم وفوز","https://www.poetsgate.com/ViewPoem.aspx?id=35450",""],[5841,"اموت انا بالقاف لا منك نطقتي به","https://www.poetsgate.com/ViewPoem.aspx?id=37038",""],[5848,"أغرق","https://www.poetsgate.com/ViewPoem.aspx?id=53458",""],[5848,"دمعة حزين","https://www.poetsgate.com/ViewPoem.aspx?id=53371",""],[6038,"الاقصى","https://www.poetsgate.com/ViewPoem.aspx?id=27219",""],[6115,"ياوجودي وجد من ضيع احذي","https://www.poetsgate.com/ViewPoem.aspx?id=180519",""],[6115,"يالله يالمعبود يارب الارباب","https://www.poetsgate.com/ViewPoem.aspx?id=181732",""]],"verses":[["يومٌ تعطَّلت الأفلاكُ فيه ولم","تَزَلْ إلى يومِنا أجرامُهُ شُرَدا",0,"د",2,0],["يَومٌ تَزِلُّ بِهِ القُلوبُ مِنَ الرَدى","جَزَعاً وَأَحرى أَن تَزِلَّ الأَرجُلُ",1,"ل",1,0],["يَومٌ تُجَدِّدُهُ السُنونَ وَقَد","دَرَجَت عَلَيهِ الأَعصُرُ الأُوَلُ",2,"ل",1,0],["يَومٌ تَوَدُّ السُمرُ أَنَّ صُدورَها","لِتَعُدَّ ما كَسَبَت يَداكَ خَناصِرُ",3,"ر",1,0],["يَومَ تَسَدّى الحَكَمَ بنَ مَروان","وَالمُطعِمونَ في لَيالي الشَفّان",4,"ن",1,0],["يَومَ تَمشي عَلى جِبالٍ مِنَ الأَش","لاءِ تَمشي في أَبحُرٍ مِن دِماءِ",5,"ا",2,0],["يَومٌ تُباعُ بِهِ النُفوسُ رَخيصَةً","يَومٌ يُقَصِّرُ هَولَهُ الأَعمارا",6,"ر",2,0],["يَومَ تَرَكنَ لِإِبراهيمَ عافِيَةً","مِنَ النُسورِ وُقوعاً وَاليَعاقيبِ",7,"ب",1,0],["يَومٌ تَوَلّى وَيَومٌ نَحنُ نَأمَلُهُ","لَعَلَّهُ أَجلَبُ اليَومَينِ لِلحَينِ",8,"ن",1,0],["يَومٌ تَبَسَّمَ فيهِ الدِّينُ وَاِنهَمَلَت","عَلَى الضَّلالِ عُيونُ الشِّركِ بِالسَّجَمِ",9,"م",1,0],["يَومٌ تَبَيَّنَ فيهِ الجِدُّ وَاِتَّضَحَت","جَلِيَّةُ الأَمرِ بَعدَ الجَهدِ وَالسَّأَمِ",9,"م",1,0],["يَومٌ تمرَّدَ فاسْتعصتْ فَواجعُه","على الدَّهَاقِين واسْتَشرتْ رزاياهُ",10,"ا",2,0],["يومَ تمشي الوئيدَ تحملُ للزّب","باء موتاً معبَّأً ونَكالا",11,"ل",2,0],["يَومٌ تَضاحَكَ نورُهُ الوَضّاءُ","لِلدَهرِ مِنهُ حُلَّةٌ سيَراءُ",12,"ا",2,1],["يَوْمٌ تَضِلُّ به العُقُولُ فَتَشْخَصُ ال","أَبْصَارُ خَوْفاً عندهُ وَذُهولا",13,"ل",2,0],["يَوْمٌ تَفَرَّسَ فيه الفُرْسُ أنَّهمُ","قد أُنْذِرُوا بِحُلولِ البُؤْسِ والنَقَمِ",14,"م",1,0],["يوْمٌ تجلّى اللّهُ من مَلَكُوتِهِ","فرآكَ في المرأى الجليلِ جَليلا",15,"ل",2,0],["يَومَ تَعصينَ عَزمَتي في أُمورٍ","لَو تَمَنَّيتِ مِثلَها ما عُصيتِ",16,"ت",1,0],["يَومَ تُبدي البيضُ عَن أَسوقِها","وَتَلُفُّ الخَيلُ أَعراجَ النَعَم",17,"م",1,0],["يومٌ تولّى أو ظلامٌ سجا","كلاهما بالقرب منك انتصار",18,"ر",1,0],["يومٌ تطلَّعَتِ المنى لصاحبه","وتحدّثتْ عنهُ بكلِّ لسانِ",19,"ن",1,0],["يَوْمٌ تَجِفُّ لِذِكْرِهِ أَنْهَارُهَا","خَوْفاً وَيَجْرِي قَلْبُ كُلِّ جَمَادِ",20,"د",1,0],["يَومَ تِلكَ الثِّمارُ أَنفَسَ شَيءٍ","عِندَهُم وَالأميرُ فِيهِم أَفَندِي",21,"د",2,0],["يَوْمَ تُصْلَى مَمَالِكُ الأَرضِ حَرْباً","وَيُغَطَّى وَجْهُ الثَّرَى بِجِسَادِ",22,"د",1,0],["يَوْمٌ تَمنّاه الزَّمانُ وطَالَما","مَدَّتْ إليه رُءُوسَها الأَعْصَار",23,"ر",1,0],["يومٌ تَحلّى بِحُسْن الوَعْدِ أوّلُه","كما تَلأْلأَ بالإنْجازِ آخِرُه",24,"ر",2,0],["يوم تجلَّى به الفاروقُ مُؤْتَلِقاً","كالبَدْر يجتذب الأبصارَ باهرُه",24,"ر",2,0],["يوم تفرَّد في الزمان بمجده","كتفرُّد الفاروق بين لِداته",25,"ت",2,0],["يوم تلاقيه المدارس والمنى","سكرى كما لاقى الحبيبة مغرمُ",26,"م",1,0],["يوم تلقّنه المدارس نشأها","درسا يعلّمه الحياة ويلهمُ",26,"م",1,0],["يومٌ تَطَلَّعَتِ المُنى لصباحِه","وتحدَّثَتْ عنهُ بكلِّ لسانِ!",27,"ن",1,0],["يومٌ تضلُّ به العقولُ فتشخًصُ ال","ذَا صُورَة ٍ ضَلوا بها وهَيُولَى",28,"ل",2,0],["يوم تمشي على جبال من الألاء","تمشي في لأبحر من دماء",29,"ا",2,0],["يوم تمشي الوئيد تحمل للزباء","موتا معبأ ونكالا",30,"ل",2,0],["يوم تمنتهُ مصرَ قبلَ سوّغها اللّ","ه المنى وغدتْ موصولة السببِ",31,"ب",1,0],["يومٌ تألَّف من عيدَينِ عيد تقىً","وعيد مُلكٍ فذا فضلٌ وتفضيلُ",32,"ل",1,0],["يومٌ تُصاغ به التيجانُ من زَهَرٍ","لابن الملوكِ وللجيش الأكاليلُ",32,"ل",1,0],["يوم تبلى سرائر المرء لا يخ","فى على الله عمدها والخطاء",33,"ا",2,0],["يوم تطوى السماء والحاكم العد","ل وتأبى الشفاعة الشفعاء",33,"ا",2,0],["يوم تضحي وللنياق حنين","في رباها وللجياد صهيل",34,"ل",1,0],["يَوْمَ تَنْقَضُّ كُلُّ ذَاتُِ رَضَيعٍٍ","عَنْ رَضِيعٍمِنْ كَثْرَةِ الْحَسَرَاتِ",35,"ت",1,0],["يومَ تُجْزى النُّفوسُ إِمَّا بِفِرْدَوْ","سِ الْعُلاَ أَوْ بِلَفْحَةِ الدَّرَكاتِ",35,"ت",1,0],["يوم تكامل فيه السعد وانتشرت","فيه المسرة بالأفواه والقلم",36,"م",1,0],["يوم تنورت الاقطار وانتظمت","فيه العساكر نظما غير منثلم",36,"م",1,0],["يَومَ تَفَرَّسَ فيهِ الفُرسُ لَهُمُ","قَد أَنذَروا بِحُلولِ الوَيلِ وَالنَقَمِ",37,"م",1,0],["يَومٌ تبسَّم عَنهُ الدَهرُ وَاِجتَمَع","لَهُ السُعود وَأَغضَت دونَهُ الغِيَرُ",38,"ر",1,0],["يومٌ تكونُ به لَدَيَّ","يتمّ لي فيهِ سروري",39,"ر",2,0],["يوم تعرى البيض من أغمادها","وبه يكسي الفريقين القتاما",40,"م",2,0],["يومٌ تأَرَّجَ جَنْبَ الرْيحِ من طَرَبٍ","بِنَشْرِهِ وتَغَنَّى الطيرُ في الغُصُنِ",41,"ن",1,0],["يوم تدين له الأيام إذ خرسَت","عن فخرِها وهو طول الدهر يفتخرُ",42,"ر",1,0],["يَومَ تُبدي البيضُ عَن لَمعِ البُرى","وَلِأَهلِ الدارِ فيها صَعصَعَه",43,"ع",2,0],["يوم تعثرت الخواطر هيبة","منه بذيل مدائح ومحامد",44,"د",1,0],["يومٌ تجلي حبُّنا فيه لِخَي","رِ مُتَوَّجٍ في العالَمِ الإسلامي",45,"م",2,0],["يومٌ تجلَّى حُبُّنا فيه لِخَي","رِ مُتَوَّجٍ سارت به الأقدامُ",46,"م",1,0],["يومٌ تَساوى الشَّعبُ في إخلاَصِه","لِعُلاَكَ فيه كَبيرُه وصَغيرُ",47,"ر",1,0],["يومٌ تطيح به المعاذرُ وال","أقوالُ ترجُم وسْطَهُ العَمَلا",48,"ل",2,0],["يومٌ تطيح به الذّنوبُ كما","دفع الغُثاءَ العارضُ الهَطِلُ",49,"ل",1,0],["يوم ترى الفخر لا وجُود لهُ","إِلا لهُم عزّهم بذلتهم",50,"م",1,0],["يوم تَنزه عن أيام عادتناَ","وعن أصيل فما تُلفِيه غير ضُحى",51,"ح",2,0],["يومٌ تزَعزَعَ رُكنُ المَكرُماتِ بهِ","واكمَدَّتِ الشمسُ من حُزنٍ على القَمرِ",52,"ر",1,0],["يَوْمٌ تَكَاثَفَ غَيْمُهُ فَكَأَنَّهُ","دُونَ السَّماءِ دُخانُ غَيْمٍ أَخْضَرِ",53,"ر",1,1],["يَومَ تُبدي البيضُ عَن أَسأُقِها","وَتَلُفُّ الخَيلُ أَعراجَ النَعَم",54,"م",1,1],["يَومَ تَلاقى الجَمعانِ وَالتَظَّت ال","هَيجاءُ حَتّى كَأَنَّها سَقَرُ",55,"ر",1,0],["يَومَ تَلاقى الجَمعانِ وَاِنتَصَبَ ال","ميزانُ رَهنَ اِنحِرافِهِ الظَفَرُ",55,"ر",1,0],["يومٌ تفتَّت قلبي فيهِ واشتَعلَت","فيهِ الهمومُ اشتعال النار والشَرَرِ",56,"ر",1,0],["يوم تطرق فتنة لَولاه لَم","تنتج رَزايا كربلاء عقيم",57,"م",1,0],["يوم تآبه في الزمان فكان بال","سلطان مفتخراً على أبنائه",58,"ا",3,0],["يوم تاهتْ به السيوفُ مِصاعاً","وتباهت به الرماح فراشاً",59,"ش",2,0],["يوم تحرّ المشارق","أرقب متى بيجون",60,"ن",1,0],["يوم تزويج والد السبطين","كنت أبهى من الجنان رياضاً",61,"ض",2,0],["يوم تولوا بمثل بدر دجى","يخجل بدر السماء تمثالُه",62,"ل",2,0],["يوم تمور السموات مورا","ثم تسير الراسيات سيرا",63,"ر",2,0],["يوم تكون الارض كالفراش","ثم يكون الناس كالفراش",63,"ش",1,0],["يوم تدنو الشمس من رؤوسهم","كإصبع فلا تسل عن بوسهم",63,"م",1,0],["يوم تعد المطايا","للملتقى والنزالِ",64,"ل",1,0],["يَومٌ تَضَمَّنَ كُلُّ يَومٍ قَبْلَهُ","مَجْداً وكلُّ الصِّيدِ في جَوْفِ الفَرَا",65,"ر",2,0],["يوم تأتي فروق تلق ليوثاً","أكبرتها وراءك الآجام",66,"م",1,0],["يوم تبدو من القلوب الخفايا","يوم أشكوك للذي سوَّاك",67,"ك",1,0],["يومٌ تَبَسَّمَ عنه الدَّهرُ واجتَمَعَت","له السُّعودُ أغضتُ دونه الغِر",68,"ر",1,0],["يوم تدعين ألف لبيك منا","سوف تمشي الخيام بالأوتاد",69,"د",1,0],["يوم تلقى جوارح الحسن تبدى","كم أبادت فعالها من قبيلِ",70,"ل",1,0],["يوم تجهّم للبلا","د كيوم عاد أو ثمود",71,"د",1,0],["يومٌ تَمَخَّضتِ العنايةُ فيه عن","سبب الوُجود وصَفوة الديانِ",72,"ن",1,0],["يَومَ تَراءَت كَأَنَّها أُصُلاً","مُزنَةُ بَحرٍ يَخفى تَبَسُّمُها",73,"م",3,0],["يوم تجهَّم وجه الموت فيه وقد","لاقى ابن فاطمةٍ جذلانَ مبتهجا",74,"ج",2,0],["يوم تأتي الملوك وَهيَ حيارى","بل سكارى من هيبة الجبار",75,"ر",1,0],["يوم تعنو الوجوه لِلَّه ذلا","وَصغاراً يا وَيحها من صغار",75,"ر",1,0],["يوم ترمي بكم إلى الموت آجا","لٌ تساقونها رعيلاً وإجلا",76,"ل",2,0],["يوم ترمي الجمار طوراً وتُ","وري جمرات الهوى بمن يهواها",77,"ا",3,0],["يوم تنجاب ظلمة الشرك عنها","وترى الكون نيّراً بضياها",77,"ا",3,0],["يوم تهوى الأفلاكُ من كلِّ بُرجٍ","آفلاتٍ ويجمعُ النيرانِ",78,"ن",1,0],["يوم تجرى الأجساد للحشر حيرى","بين لُجّ وقسطَل من دخانِ",78,"ن",1,0],["يوم تجري الأجسادُ للحَشرِ حَيرَى","وَيُنادِى القضاءُ آنَ الوَفاء",79,"ا",2,0],["يوم تلقى اليهود في كل واد","قد تولوا بذلة وهوان",80,"ن",1,0],["يوم تبلى النفوس وَاللَه يَقضي","وَتَكون السما كَثيبا مهيلا",81,"ل",2,0],["يوم تكاثف غيمه فكأنه","دون السماء دخان عود أخضر",82,"ر",1,1],["يوم تنقبت الدنيا بغاشية","من المصاب لفقد العالم النوري",83,"ر",2,0],["يوم تحلّى الدهر فيه بزينة","غرّاء حلّت كل قُطْرٍ عاطل",84,"ل",1,0],["يوم تزاحمت الملائكة العلا","فيه فعزّت عن عليٍّ أحمدا",85,"د",2,0],["يومَ تُجزى كلُّ نفسٍ سعيها","ولنا أيضاً هناكم وهنا",86,"ن",2,0],["يَوم تَأتي بِالخطا مُعترفا","فَلَكَ الأ من وَلو فَوقَ شَفا",87,"ف",2,0],["يوم تسقيني وأسقيها على","نغمة الحب ولحن الوتر",88,"ر",1,0],["يوم تسامت به أفراح مدرسة ال","علياء وازداد في الأحزان شانيه",89,"ي",2,0],["يوم تجلى به بدر الفخار فلا","يأتي لغيرك يا دمياط ثانية",89,"ي",2,0],["يوم تولى به هذا العزيز على","أريكة الملك محبوبا ومتبعا",90,"ع",2,0],["يوم تبيض وجوه","إذ وجوه مكفره",91,"ر",2,0],["يومٌ تجلى فيه اللهُ فأشرَقَتْ","أَنَوارُ مَمْلَكةٍ تُريكَ جَلالَها",92,"ل",3,0],["يوم تفرس فيه الفرس انهم","دالَت سيادتهم للعُرب في الخيم",93,"م",1,0],["يوم تقضى لي الحلول لديكم","ذاك عندي عيد الهنا والنوالِ",94,"ل",1,0],["يَوم تفرس فيهِ الفرس أَنهم","باؤوا بكل وبال في ديارهم",95,"م",1,0],["يوم ترى الرسل الكرام به جثت","وتحيرت والانس والأملاكا",96,"ك",2,0],["يَومٌ تقطَّعتِ القُلوبُ بِهِ كَما","أَدمى المحاجرَ دمعُها المتواصِلُ",97,"ل",1,0],["يوم تزويجِ والدِ السِّبْطَيْنِ","كنت أقوى من النجومِ انقِضاضاً",98,"ض",2,0],["يومٌ تَضَمَّخ بالفَخارِ أَديمُه","ف