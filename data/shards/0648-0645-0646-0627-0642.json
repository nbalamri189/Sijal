{"poems":[[55,"شوق يعرض لا إلى الآرام","https://www.aldiwan.net/poem29772.html","الكامل"],[55,"بعض الملام فقد غضضت طماحي","https://www.aldiwan.net/poem30652.html","الكامل"],[65,"طرقت فنم على الصباح شروق","https://www.aldiwan.net/poem46208.html","الكامل"],[65,"الورد يبسم والركائب حوم","https://www.aldiwan.net/poem46212.html","الكامل"],[79,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[88,"لا والأسى وتلهب الأحشاء","https://www.aldiwan.net/poem10498.html","الكامل"],[5,"ألا هبي بصحنك فاصبحين","https://www.aldiwan.net/poem311.html","الوافر"],[85,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[23,"ألا أبلغ المستمعين لوقعة","https://www.aldiwan.net/poem21239.html","الطويل"],[74,"سهرت عليك لواحظ الرقباء","https://www.aldiwan.net/poem18175.html","الكامل"],[74,"شب الحشا قول الكواعب شابا","https://www.aldiwan.net/poem18236.html","الكامل"],[74,"قاسي الجوانح لين الأعطاف","https://www.aldiwan.net/poem19257.html","الكامل"],[31,"ألم تعرض فتسأل آل لهو","https://www.aldiwan.net/poem6055.html","الوافر"],[139,"بالبشر والتوفيق هل أمين","https://www.aldiwan.net/poem48882.html","الكامل"],[146,"قد بان عذرك والخليط مودع","https://www.aldiwan.net/poem58436.html","الكامل"],[147,"فت الورى فعلام ذا الإجهاد","https://www.aldiwan.net/poem11754.html","الكامل"],[147,"يا للرجال لنظرة سفكت دما","https://www.aldiwan.net/poem11808.html","الكامل"],[147,"دم بالصيام مهنأ ما داما","https://www.aldiwan.net/poem11821.html","الكامل"],[173,"يا ساهر الطرف من خوف ومن وجل","https://www.aldiwan.net/poem1652.html",""],[186,"ما مر ذكرك خاطرا في خاطري","https://www.aldiwan.net/poem67068.html","الكامل"],[186,"طاب الثناء بمدح عبد القادر","https://www.aldiwan.net/poem67070.html","الكامل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[240,"أهلا بطلعة زائر","https://www.aldiwan.net/poem31608.html","مجزوء الكامل"],[240,"لك يا شهاب الدين أخ","https://www.aldiwan.net/poem31753.html","مجزوء الكامل"],[240,"يا صاحبي لمن هذه","https://www.aldiwan.net/poem32116.html","المجتث"],[266,"أكذا النفوس إذا عشقن الأنفسا","https://www.aldiwan.net/poem38255.html","الكامل"],[285,"أدنى اشتياقي أن أبيت عليلا","https://www.aldiwan.net/poem60594.html","الكامل"],[286,"بالسعد طالعك المهل","https://www.aldiwan.net/poem1380.html",""],[302,"سفرت أميمة ليلة النفر","https://www.aldiwan.net/poem33277.html","أحذ الكامل"],[325,"يا أيها الشهم الجليل ومن له","https://www.aldiwan.net/poem67169.html","الكامل"],[369,"في الجيرة الغادين بدر","https://www.aldiwan.net/poem60895.html","مجزوء الكامل"],[376,"أبقى الرسيم من الركاب رسوما","https://www.aldiwan.net/poem57136.html","الكامل"],[376,"أما على كرم ابنة الكرام","https://www.aldiwan.net/poem57158.html","أحذ الكامل"],[376,"إن كان أطلق دمعه المحبوسا","https://www.aldiwan.net/poem57367.html","الكامل"],[408,"من علم اللفظ سحر الناظر الساجي","https://www.aldiwan.net/poem46731.html","البسيط"],[411,"الحر في التحقيق معتق ذاته","https://www.aldiwan.net/poem50036.html","الكامل"],[422,"قلب يذوب عليك وجدا","https://www.aldiwan.net/poem54142.html","مجزوء الكامل"],[422,"هاج القرام وهيجا بلبالي","https://www.aldiwan.net/poem54163.html","الكامل"],[438,"هل يا حداة النجب","https://www.aldiwan.net/poem12478.html","مجزوء الرجز"],[438,"قسما بسؤددك القديم","https://www.aldiwan.net/poem12531.html","مجزوء الكامل"],[445,"أقدمت دون معالم الإسلام","https://www.aldiwan.net/poem34781.html","الكامل"],[445,"شهدت لك الأبطال يوم كفاحها","https://www.aldiwan.net/poem34817.html","الكامل"],[445,"نور الوفاء بأرضنا لك ساطع","https://www.aldiwan.net/poem34838.html","الكامل"],[447,"عجبا لراج فوز ناج سابق","https://www.aldiwan.net/poem14317.html","الكامل"],[567,"هل للذي في حشاه حزن يعقوب","https://www.aldiwan.net/poem52873.html","البسيط"],[591,"يا دهر قد سمح الحبيب بقربه","https://www.aldiwan.net/poem17449.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138293",""],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126873","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87117","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86867","الكامل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34410","الكامل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137758",""],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56372","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55941","الكامل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130632","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64789","الكامل"],[1281,"","https://poetry.dctabudhabi.ae/diwan/poem/77442","الكامل"],[1353,"","https://poetry.dctabudhabi.ae/diwan/poem/124301","الكامل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93095","الكامل"],[1910,"","https://poetry.dctabudhabi.ae/diwan/poem/116535","الكامل"],[1918,"","https://poetry.dctabudhabi.ae/diwan/poem/99058","الهزج"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118363","الكامل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100450","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110315","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53198","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53158","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53119","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53224","الوافر"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67192","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106910","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137181",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137097",""],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137070",""],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87326","الرجز"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137376",""],[2684,"","https://poetry.dctabudhabi.ae/diwan/poem/131462",""],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130822",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100208","الكامل"],[3386,"","https://poetry.dctabudhabi.ae/diwan/poem/124616","البسيط"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66501","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86542","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59507","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77125","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125799","البسيط"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199123","الرجز"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104902","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141677","الكامل"],[4679,"إيفاء مدحك منتهى ما نطلب","https://www.poetsgate.com/ViewPoem.aspx?id=142727",""],[4767,"سيول الأربعين","https://www.poetsgate.com/ViewPoem.aspx?id=200682",""],[4778,"الربان","https://www.poetsgate.com/ViewPoem.aspx?id=200402",""],[4929,"المال لا يصنع المجد","https://www.poetsgate.com/ViewPoem.aspx?id=199719",""],[5237,"أنوار سيدنا النبي المرسل","https://www.poetsgate.com/ViewPoem.aspx?id=113114",""],[5290,"أعد الحديث فليس بالمملول","https://www.poetsgate.com/ViewPoem.aspx?id=113132",""],[5397,"أطربتني نغمات لحن المنشد","https://www.poetsgate.com/ViewPoem.aspx?id=157934",""],[5409,"ذكراك وهي لها في الدهر تجديد","https://www.poetsgate.com/ViewPoem.aspx?id=155263",""],[5691,"بيت الغرابيب","https://www.poetsgate.com/ViewPoem.aspx?id=206248",""],[5758,"لعِيْنَيْ غَزَّة","https://www.poetsgate.com/ViewPoem.aspx?id=200916",""],[5943,"أعيذك بالإله من المعاصي","https://www.poetsgate.com/ViewPoem.aspx?id=36494",""]],"verses":[["وَمَناقِبٍ تَبقى وَيَفنى أَهلُها","إِذ كُلُّ عَيشٍ فُرصَةٌ لِحِمامِ",0,"م",1,0],["وَمَناقِبٍ بيضِ الوُجوهِ مُضيئَةٍ","أَبَداً تُكاثِرُ أَلسُنَ المُدّاحِ",1,"ح",1,0],["ومَناقِبٌ يَزْدادُ طولاً عِندَها","باعٌ بتَصْريفِ القَناةِ لَبيقُ",2,"ق",1,0],["ومَناقِبٍ لا تُرتَقَى هَضَباتُها","نَطَقَ الفَصيحُ بفَضْلِها والأعْجَمُ",3,"م",1,0],["وَمَنِ اقْتَضَى بالسَّعْدِ دَيْنَ زَمَانِهِ","والسَّيْفِ لَمْ يَبْعُدْ عَلَيْهِ مُؤَمَّلُ",4,"ل",1,0],["وَمَناقِبٌ لَولا المَهابَةُ وَالتُقى","قُلنا مَناقِبُ صاحِبِ الإِسراءِ",5,"ا",2,0],["وَمِنّا قَبلَهُ الساعي كُلَيبٌ","فَأَيُّ المَجدِ إِلّا قَد وَلينا",6,"ن",2,0],["ومناقب المولى الإمام محمدٍ","قد أشرقت أمْ هنَّ زُهرُ درَاري",7,"ر",2,0],["وَمِنّا قَتيلُ الشِعبِ أَوسُ اِبنِ ثابِتٍ","شَهيداً وَأَسنى الذِكرِ مِنهُ المَشاهِدُ",8,"د",1,0],["ومناقباً تمشي المدائحُ خلفها","لوفورِ سؤدَدِها على استحياء",9,"ا",2,0],["ومناقب البيتِ الذي من أفقه","بدت الكواكب سنَّة وكتابا",10,"ب",2,0],["ومناقب قد يمَّمت أمد العلا","فقفت سوابقها الحسان قواف",11,"ف",1,0],["وَمِنّا قَد نَمَتكَ عُروقُ صِدقٍ","إِذا الجَحَراتُ أَعوَينَ الكِلابا",12,"ب",2,0],["ومن أقتفتهِ عناية من بدئهِ","فبلوغه درجَ الكمال يقينُ",13,"ن",1,0],["ومناقبٌ يقضىِ لها متعنِّتٌ","في حكمه ويجيزها متتبِّعُ",14,"ع",1,0],["وَمَناقِباً مِن دونِها وَبِمِثلِها","تَكبو المُلوكُ وَتُكبَتُ الحُسّادُ",15,"د",1,0],["وَمَناقِبٌ أَعيا الأَعادِيَ كَتمُها","وَالشَمسُ أَظهَرُ أَن تُسَرَّ وَتُكتَما",16,"م",2,0],["وَمَناقِباً لَو لَم يُوَعَّر نَهجُها","لاقَيتَ لِلساعينَ فيهِ زِحاما",17,"م",2,0],["وَمَن أَقامَ بِها قامَت قِيامَتُهُ","وَعايَنَ النارَ مِن خَلفٍ وَمِن قُبُلِ",18,"ل",1,0],["وَمناقِبٌ تَتلو مَدائِحِها عَلى","أَكبادِ أَهلِ الغيِّ سَورةَ فاطِرِ",19,"ر",1,0],["وَمَناقِبٌ وُصِفت فَساقطُ عِقدِها","دُرَراً تَناوَلَها يَراعُ الشاعرِ",20,"ر",1,0],["وَمِن أَقبحِ الأشياءِ حسناء غداةٌ","كأنَّ بِعَينيها إِذا نَظرت سحرا",21,"ر",2,0],["وَمَناقِبٌ شَهِدَت لِبا","نيها بِفَضلِ بِنائِها",22,"ا",3,0],["وَمَناقِبٌ مِثلُ النُجو","مِ عُلاً وَفي عَدَدِ النُجومِ",23,"م",1,0],["وَمَن أُقارِعُ دَهري","بِجِدِّهِ وَأُكافِح",24,"ح",1,0],["ومناقب الفضلاء ليس بمدرك","من حظها الأوفى الغبي الأبخسا",25,"س",2,0],["وَمَناقِباً لا يَأْتَلِينَ طَوالِعاً","أَبَداً إِذا هَوَتِ النّجُومُ أُفُولا",26,"ل",2,0],["ومناقب قدراق من","هن المفصّل والجمل",27,"ل",1,0],["وَمناقبٍ لَو شئتُ أَحصُرها","لحصِرتُ قبل الهَمِّ بالحَصرِ",28,"ر",1,0],["وَمَنِ اِقتَدى في المَكرُماتِ بِحاتِمِ","وَلَعَلَّهُ فيها إِذا صَحَّت يَليكِ",29,"ك",1,0],["ومناقبٌ مشهورةٌ","ما إن يُحيطُ بهِنَّ حَصر",30,"ر",1,0],["ومناقبٍ أجريتُ شِعري بينها","ليُكمِّل التَّوزِيعَ والتَّقسِيما",31,"م",2,0],["ومناقِبٌ بَلَغَت سِعايَتُها","أَقصى بِحارِ النَّثرِ والنَّظمِ",32,"م",1,0],["ومَناقبٌ أشرَقنَ ما بينَ الوَرى","ونُشِرنَ حتى خِلتهُنَّ شموسا",33,"س",2,0],["ومن أقامَ قضيبَ البانِ مُنتصباً","على كثيبٍ من الأردافِ رجراج",34,"ج",1,0],["ومَنِ اقتَنى ما ليسَ يُمكنُ غصبُهُ","مِنهُ وثَمَّرَ جاهداً حَسَناتِه",35,"ت",2,0],["ومناقب مأثورة","نظمت بجيد الدهر عقدا",36,"د",2,0],["ومناقب كست القوافي بردة","في الحسن ترفل أيّما إرفال",37,"ل",1,0],["ومن أقلُّ خادمٍ","يخدُمُه كثعلب",38,"ب",1,0],["ومناقبٍ تُغني سما","ءَ المَكرُماتِ عنِ النجومِ",39,"م",1,0],["ومناقبٍ لولا دُنُوُّكَ للنَّدى","لأرَتْكَ فِي جَوِّ السماءِ السَّامي",40,"م",2,0],["ومَناقِبٌ أَرْبَتْ عَلَى خُطَبائِها","ومآثِرٌ زادَتْ عَلَى مُدَّاحِها",41,"ح",3,0],["ومناقِبٌ ومناصبٌ وضرائبٌ","وصوائِبٌ وثواقبٌ ولَوَامِعُ",42,"ع",1,0],["ومناقش لدواهش شهدت على","أفعالها منها عدول لقايق",43,"ق",1,0],["ومن أَقامَ على ألفاظِهِ حَرَساً","مِثلَ السكَائِمِ للجُرْدِ السَّراحِيبِ",44,"ب",1,0],["وَمَناقِبٌ عُلْويَّةٌ لمّا بَدتْ","فَرِحَ الظَلَامُ وظَنَّها مِنْ شُهْبِهِ",45,"ب",2,0],["ومن اقتفى أثر الألى الفوا السمو","م فانه سلك الطريق الاوعرا",46,"ر",2,0],["وَمناقب جلّت وإنّي قاصر","عَن عدّها إذ إنّها لنجومُ",47,"م",1,0],["وَمَن اِقتَدى في نصحه لإمامه","بِهداه فَهوَ المستقيم الغانم",48,"م",1,0],["وَمَناقبٍ غُرٍّ تَعذَّر حَصرُها","لَما غَدَت تَنمو بِغَير فُتور",49,"ر",1,0],["وَمناقبُ العبّاس لَم تُجمَع سِوى","لِحَفيده ملك الوَرى العبّاسِ",50,"س",1,0],["ومن أقعدته الصروف عن البي","ن عنها رأى ذاك رأيا رشيدا",51,"د",2,0],["ومناقبٌ فاقت بها ومحامدٌ","ومآثرٌ يزهو بها وخلالُ",52,"ل",1,0],["ومناقبٌ حسنى ولطف شمايلِ","تثنى وخلق في الورى محمودُ",53,"د",1,0],["ومناقبا أبدي لجهدي باذلا","فيقل ما أبدي ويكثر ما بطن",54,"ن",1,0],["ومناقبٌ تُبنى وسَعْيٌ يُرْتَضَى","ومَكارِمٌ تُحيَا وبُدْنٌ تُنْحَرُ",55,"ر",1,0],["وَمناقِبٌ يَزداد طُولاً عِندَها","باعٌ بِتَصريف الأُمور لبيقُ",56,"ق",1,0],["ومناقب العلماء والكرماء وال","صلحاء أرباب القلوب الخشّع",57,"ع",1,0],["ومناقباً لا تستطيع","إلى الحساب لها حسابا",58,"ب",2,0],["ومناقبٌ ودَّت مَصابيحُ الدُّجى","حَسَداً لها لو لُقِّبَت بمناقبِ",59,"ب",1,0],["ومنّا قافة الرزق","وأهل الفال والزجر",60,"ر",1,0],["ومنا قيِّم الدين ال","مطيع الشائع الذكر",60,"ر",1,0],["ومناقب الكرماء والعلماء وال","صلحاء أرباب القلوب الخشع",61,"ع",1,0],["ومناقب عمر الزمان منيرةً","تبيض منهن الليالي السود",62,"د",1,0],["ومن اقتفاه فالعلى","تلقاه حاسرة البراقع",63,"ع",1,0],["ومناقب بهرت بدائع وصفها","بعظيم ما فيها من الإعظام",64,"م",1,0],["ومناقب لو أنها لكواكب","منع الظلام ضياؤه أن يغسقا",65,"ق",2,0],["ومناقب بأبي سعيد أيدت","فأبان فضل الأول المتأخر",66,"ر",1,0],["ومن أقدامهم في كل حرب","لأعناق الأعادي كم وطينا",67,"ن",2,0],["ومَناقبٍ مثلُ النُجومِ الشُهب لا","تُحصى ومَن ذا للنجومِ يُعدِّد",68,"د",1,0],["ومناقبِ الخلق الكريم كأنها","زهر الربيع يفوح في الآصال",69,"ل",1,0],["ومناقبي في الدهر ضائع عرفها","كالمسك تحمله اكف نسيم",70,"م",1,0],["ومناقب مثل النجوم سوائر","جوابة الافاق والاقطار",71,"ر",1,0],["ومناقب كتب الخلود لها به","هيهات يدرك مجدها الهرمان",72,"ن",1,0],["ومَن أقامَ الفرضَ في أرض الهرا","لمَغرِبِ الإكليلِ من غير مِرَا",73,"ر",2,0],["ومن اقتدى بأبيه في","تلك المعالي أنصفا",74,"ف",2,0],["ومن اقبل عليك يا رب تائب","فبدّل خوفه الراجح بأمنه",75,"ن",2,0],["ومن اقتنى ما ليس يمكن غصبه","متجملاً بابائه وأناته",76,"ت",2,0],["ومناقب لا يستطاع عدادها","هي والنجوم النيرات سواء",77,"ا",2,0],["ومن أقام ولم يبرح منازله","لم يطو في الأرض من سهل ولا حزن",78,"ن",1,0],["ومن اقتباسك من لظىً","قد ضمّنتها مهجتي",79,"ت",2,0],["ومناقب كانت كقط","ع الروض في يوم مطير",80,"ر",1,0],["ومناقبي عدد النجوم وهمَّتي","يعلوَ مصامَ الفرقدين مصامُها",81,"م",3,0],["وَمَن أَقامَكَ أَهلا لِلضِّيافَةِ قُم","بِشُكرِهِ وَاِستَزِد إِنعامَ مُقتَدِر",82,"ر",1,0],["ومن أقام منار الهدي معتليا","من بعدما كان بالتخريف منهدماً",83,"م",2,0],["ومن أقل فلها بحسبه","يقاس هذا بحساب تحسبه",84,"ه",1,0],["ومناقب لو أنها تليت","للناس فصلها الورى سورا",85,"ر",2,0],["ومناقب محمودة وشمائل","مرضية ومحامد ومآثر",86,"ر",1,0],["ومناقب لك في الملا اشتهرت وقد","صارت بها الأمثال دوماً تضرب",87,"ب",1,0],["ومَن اقتفى أثر الضيا","وجدَ الذي هو مُهنىء",88,"ا",1,0],["ومَنْ أقصى طموحه كان جدي","فلن يلحق بركب الحاذقينا",89,"ن",2,0],["ومناقبٌ يَفْنَى ويبقى ذكرُهَا","كالمزنِ بعدِ مماتِه مِهْطالا",90,"ل",2,0],["ومن اقتدى بهداهم من أمثل","ورث الهداية والتقى عن أمثل",91,"ل",1,0],["ومن اقتدى بالصدق في أنحائه","قادته عزمته بغير دليل",92,"ل",1,0],["ومناقب عن نيلها يكبو من","أوهام مجرى كل مهر أجرد",93,"د",1,0],["ومن أقام إلى إعلاء أمته","صرحاً له بدوام الدهر تخليد",94,"د",1,0],["ومَنِ اقْتَناهمْ في حظيرَتِهِ","للذَّبْحِ في حفَلاتِ(هِبْ هوبِ) !",95,"ب",1,0],["ومن أقصى إلى أقصى ،ربيعٌ","يغازِلُ كلّ بيتٍ بالمنايا",96,"ا",3,0],["ومن أقوالِ سوءٍ سوفَ تبقى","سوادًا في صحائفِ راحلينا",97,"ن",2,0]]}