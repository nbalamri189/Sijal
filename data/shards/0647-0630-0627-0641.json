{"poems":[[95,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[95,"نهاية الفخر لي في هذا الكلم","https://www.aldiwan.net/poem11309.html","البسيط"],[53,"عيني جودا على حبيبكما","https://www.aldiwan.net/poem66028.html","المنسرح"],[80,"أهلا بكم صحبتكم نحوي الديم","https://www.aldiwan.net/poem14185.html","البسيط"],[87,"يا ليلة سميتها ليلتي","https://www.aldiwan.net/poem7800.html","السريع"],[87,"يا راكب الريح حي النيل والهرما","https://www.aldiwan.net/poem63746.html","البسيط"],[58,"غاد المدام بحث الكأس والطاس","https://www.aldiwan.net/poem58571.html","الطويل"],[68,"خطب لسان الحال فيه أبكم","https://www.aldiwan.net/poem41549.html","الكامل"],[104,"حلفت ألا تكلميني","https://www.aldiwan.net/poem33068.html","المنسرح"],[50,"ما لي بدار خلت من أهلها شغل","https://www.aldiwan.net/poem64514.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39640","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19289","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55048","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55197","الكامل"],[108,"بطل الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179585",""],[102,"يوم العلم","https://www.poetsgate.com/ViewPoem.aspx?id=50183",""],[98,"موكب الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=17479",""],[92,"يا شعب","https://www.poetsgate.com/ViewPoem.aspx?id=178937",""],[53,"عينيّ جودا على حبيبكما","https://www.poetsgate.com/ViewPoem.aspx?id=30369",""],[159,"يا من تجنب دمعي منه حين وشى","https://www.aldiwan.net/poem55649.html","البسيط"],[164,"أهلا بطرس من إمام مدته","https://www.aldiwan.net/poem59120.html","الرجز"],[208,"انظر إلي بصفح منك عن زللي","https://www.aldiwan.net/poem53198.html","البسيط"],[227,"أولا تراهم يرتدون","https://www.aldiwan.net/poem41595.html","مجزوء الكامل"],[227,"ما حيلة المفئود في حساده","https://www.aldiwan.net/poem41924.html","الكامل"],[279,"ما للهوى إلا الرصافة مأرب","https://www.aldiwan.net/poem25635.html","الكامل"],[307,"عجبت إذ زارت على خفية","https://www.aldiwan.net/poem58180.html","السريع"],[307,"لا أنس لما قال لي مستفهما","https://www.aldiwan.net/poem58210.html","الطويل"],[407,"زارت فكان لها الفؤاد مقيلا","https://www.aldiwan.net/poem33489.html","الكامل"],[467,"هذا فتى الزقزوق يرأف بالزرزور","https://www.aldiwan.net/poem3246.html","عموديه"],[480,"ليبجح الدهر لما ردني جزعا","https://www.aldiwan.net/poem15210.html","البسيط"],[480,"أما الشباب فشيء عز مطلبه","https://www.aldiwan.net/poem15274.html","البسيط"],[482,"يا مفخر البيت الحسي","https://www.aldiwan.net/poem37045.html","مجزوء الكامل"],[482,"سكن الهوى في القلب حيث أجله","https://www.aldiwan.net/poem37061.html","الكامل"],[482,"لله يا ثغر زانك الشنب","https://www.aldiwan.net/poem37063.html","المنسرح"],[485,"فاء الفقير فكاكه من أسره","https://www.aldiwan.net/poem24418.html","عموديه"],[501,"هذا فؤادي أحصدته الأسهم","https://www.aldiwan.net/poem3705.html","الكامل"],[527,"هذا الحبيب وصفوة الجبار","https://www.aldiwan.net/poem13289.html","الكامل"],[532,"هذا العقيق فقف على أبوابه","https://www.aldiwan.net/poem37529.html","الكامل"],[561,"وجه تعدد في المرائي","https://www.aldiwan.net/poem35086.html","مجزوء الكامل"],[565,"هذا فرنسيس ابن جسطر قد مضى","https://www.aldiwan.net/poem52572.html","الكامل"],[565,"هذا فؤاد الدولة السامي الذي","https://www.aldiwan.net/poem52579.html","الكامل"],[565,"نعم الهدية يهتدي الساري بها","https://www.aldiwan.net/poem52727.html","الكامل"],[565,"قد مد خط عذاره فأجاده","https://www.aldiwan.net/poem52837.html","الكامل"],[565,"نادى منادي البين حي على السرى","https://www.aldiwan.net/poem52892.html","الكامل"],[565,"ألحمد لله الذي خلق الورى","https://www.aldiwan.net/poem52937.html","الكامل"],[578,"إن الحبيب ملالاً","https://www.aldiwan.net/poem2871.html","المجتث"]],"verses":[["هَذَا فَتَى النَّبِيلِ ذُو التَّاجَيْنِ مِنْ قِدَمٍ","هَذَا فَتَى مِصْرَ رَاعَمِسيسٌ الثَّانِي",0,"ن",2,0],["هَذَا فَتَى الدَّهْرِ زَانَ النُّبْلُ طَلْعَتَهُ","وَإِنْ يَكُنْ بِجَمَالٍ غَيرَ مُتَّسِمِ",1,"م",1,0],["هذا فؤادي والرُّزء رزؤكما","تبكي له عين مستثيبِكما",2,"م",2,0],["هَذا فُؤاديَ قَد طارَ السُرورُ بِهِ","إِن كُنتَ تَنقُلكَ الوَخّادَةُ الرُسُمُ",3,"م",1,0],["هذا فتى يُبكى على موته","وهذه في أوّل النشأة",4,"ه",1,0],["هَذا فَضاءٌ تُلِمُّ الريحُ خاشِعَةً","بِهِ وَيَمشي عَلَيهِ الدَهرُ مُحتَشِما",5,"م",2,0],["هذا فَعَالي بِطُرَّاقِ الهُمُومِ إذا","غَدا يُخالِطُها فِكْرِي وَوَسْواسِي",6,"س",2,0],["هَذا فَعالُ اللَهِ ثُمَّ نَبِيِّهِ","وَالصَحبُ وَالشُعَراءُ فَيما نَظَّموا",7,"م",3,0],["هَذا فُؤادي لَديك وَهن","ذهلت عَنهُ فيما أَظن",8,"ن",1,0],["هَذا فَصِفهُ وَقُل في وَصفِهِ سَدَداً","مُدَّت لِواصِفِهِ في عُمرِهِ الطِوَلُ",9,"ل",1,0],["هذا فتىً نظم الشبابَ وصاغَهُ","وحياً تحدّرَ من أرقِّ مشاعرِ",10,"ر",1,0],["هَذا فَتىً يُبكى عَلى مِثلِهِ","وَهَذِهِ في أَوَّلِ النَشأَةِ",11,"ه",1,0],["هَذَا فَقِيدُ مَليكِهِ وَبِلاَدِهِ","وَشَهِيدُ إِخْلاَصِ الوَفِيِّ الصادِقِ",12,"ق",1,0],["هَذَا فَتَى الفِتْيَانِ غَيْرُ مُدَافَعٍ","وَالقُدْوَةُ المُثْلَى بِغَيْرِ جِدالِ",13,"ل",1,0],["هذا فتىً حرٌّ، يواجهُ خَصْمَهُ","لم يَرْم خَصْمًا من وراء قَذَالِهِ",14,"ل",2,0],["هذا فلان في حشاهُ بلبل","يشدو وهذا فيه يزأر ضيغمُ",15,"م",1,0],["هذا فتى نظم الشّباب وصاغه","وحيا تحد{ من أرقّ مشاعر",16,"ر",1,0],["هذا فؤادي للخطوب دريئة","وأنا المعرض فيكم فاستهدفوا",17,"ف",3,0],["هذا فؤادي والرُّزء رزءكما","تبكي له عين مستثيبكما",18,"م",2,0],["هذا فُؤاديَ طَوْعاً لَوْ هَمَمْتَ بِهِ","يَمْشي إِلَيْكَ إِذا اسْتَمْشَيْتَهُ لَمَشى",19,"ش",2,0],["هذا فتى لم يملك العبد الذي","اعتقه الا ببضع امته",20,"ت",2,0],["هذا فؤاديَ لم يملِكه قبلكمُ","خلقٌ وحقِّ أمير المؤمنين علي",21,"ل",2,0],["هذا فَتىً كانَت تَموَّ","جُ بِالجَواذِبِ وُجنَتاه",22,"ا",2,0],["هذا فُؤادي تُستَباحُ دِماؤُهُ","مُستَقطراتٍ من جِراحِ ودادِهِ",23,"د",2,0],["هَذا فُؤادي قَد تَصَدّع بعدهُم","من يَرْأبُ القَلبَ الصديع ويشعبُ",24,"ب",1,0],["هذا فضولٌ من نسيم الصبا","وهو الذي ينقل رياها",25,"ه",2,0],["هذا فؤادك مذ سكنت ضميره","هل حل فيه سواي قلت ولا حلا",26,"ل",2,0],["هذا فساد كلام شارح مسلم","وله فساد خلته مقبولا",27,"ل",2,0],["هذا فتى الزقزوق يرأف بال","زرزور لا للوعظ والزجر",28,"ر",1,1],["هذا فؤادُ أراني فضلَ قسوَتِه","لا كنتُ أن لم اُعِدْهُ للنوى مِزَعا",29,"ع",2,0],["هذا فؤادٌ أُراني أنَّني رجلٌ","في الحبَّ أتبعُ ما يختارُ مَذْهَبُه",30,"ب",2,0],["هذا فقيد بلادنا ال","خضرا ولا من ناكر",31,"ر",1,0],["هذا فؤادي ليس ينفك اضطرا","مه بيد أني بالدموع أبله",32,"ل",2,0],["هذا فؤادي اشتكى له وبكى","ما حيلتي والفؤاد منجذب",33,"ب",1,0],["هذا فقير القوم وهو مناهم","إن أبصروه فلا تمل عن جسره",34,"ر",2,0],["هَذا فُؤادي أَحصدته الأَسهم","مَن ذا يَرى تِلكَ الجُفون وَيَسلَمُ",35,"م",1,1],["هَذا فَريد أَلقاب هَذا أَحمَد ال","مُختار هَذا جامع الأَسرار",36,"ر",1,0],["هَذَا فُتُوحُ الشُّؤْمِ وهي شَوَاهِدٌ","أنَّ الْمُرادَ لَهُ نُصُوصُ كتابِهِ",37,"ب",2,0],["هذا فكيف عقولنا","لا تضمحل من الهناء",38,"ا",2,0],["هذا فَرَنْسيسُ ابنُ جَسْطَرَ قد مَضَى","في التِسعِ والعشرينَ مِن عُمْرٍ سَلَفْ",39,"ف",1,1],["هذا فؤادُ الدَّولةِ السَّامي الذي","رُدِفَت مراتبُ مَجدهِ بمراتبِ",40,"ب",1,1],["هذا فؤادُ المُلكِ صَدْرُ رِجالهِ","والصَّدرُ أهلٌ للفؤادِ فما اعتدَى",41,"د",2,0],["هذا فُؤادُ المُلكِ أدرَكَ قُطرَنا","بالشَّامِ يُصلحُ بالرَّشادِ فَسادَهُ",42,"د",2,0],["هذا فِراقُ الدَّهرِ لا نُحصِي لهُ","عَدَدَ السِنينَ ولا نَعُدُّ الأشُهرا",43,"ر",2,0],["هذا فِراقٌُ تَعلَمُونَ زَمانَهُ","أفتعلَمُونَ مَتى يكونُ المُلتَقَى",44,"ا",1,0],["هذا فكم قلت فيه","أَما ترى ما ترامى",45,"م",2,0]]}