08877",""],[402,"أرأيت في أثر الغمام الوادق","https://www.poetsgate.com/ViewPoem.aspx?id=36225",""],[402,"يا صورة شبهت صخرا بإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=36833",""],[5823,"مصارحة","https://www.poetsgate.com/ViewPoem.aspx?id=59644",""],[5853,"رؤى الحب","https://www.poetsgate.com/ViewPoem.aspx?id=175649",""],[5853,"يا....أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=175691",""],[5910,"يا خُلَّةَ النَّفسِ","https://www.poetsgate.com/ViewPoem.aspx?id=206319",""],[5933,"قال النبي مقالةً","https://www.poetsgate.com/ViewPoem.aspx?id=40707",""],[5943,"أيُّ الفريقينِ أغلى ياضيا عيني","https://www.poetsgate.com/ViewPoem.aspx?id=34685",""],[5943,"تشطير لقصيدة فات الأوان","https://www.poetsgate.com/ViewPoem.aspx?id=138274",""],[5956,"مَن حقق الأحلام إلا فارسٌ؟","https://www.poetsgate.com/ViewPoem.aspx?id=193206",""],[5975,"نسائم الحبّ..","https://www.poetsgate.com/ViewPoem.aspx?id=53282",""],[5977,"الوطن الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=213087",""],[6097,"نَارانِ","https://www.poetsgate.com/ViewPoem.aspx?id=190672",""],[6213,"شجون عاتية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85497&r=&rc=100",""],[6227,"عَذِّبْ كما تهوى !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87073&r=&rc=16",""]],"verses":[["هَذَا فَتَى النَّبِيلِ ذُو التَّاجَيْنِ مِنْ قِدَمٍ","هَذَا فَتَى مِصْرَ رَاعَمِسيسٌ الثَّانِي",0,"ن",2,0],["هَذَا فَتَى الدَّهْرِ زَانَ النُّبْلُ طَلْعَتَهُ","وَإِنْ يَكُنْ بِجَمَالٍ غَيرَ مُتَّسِمِ",1,"م",1,0],["هذا فؤادي والرُّزء رزؤكما","تبكي له عين مستثيبِكما",2,"م",2,0],["هَذا فُؤاديَ قَد طارَ السُرورُ بِهِ","إِن كُنتَ تَنقُلكَ الوَخّادَةُ الرُسُمُ",3,"م",1,0],["هذا فتى يُبكى على موته","وهذه في أوّل النشأة",4,"ه",1,0],["هَذا فَضاءٌ تُلِمُّ الريحُ خاشِعَةً","بِهِ وَيَمشي عَلَيهِ الدَهرُ مُحتَشِما",5,"م",2,0],["هذا فَعَالي بِطُرَّاقِ الهُمُومِ إذا","غَدا يُخالِطُها فِكْرِي وَوَسْواسِي",6,"س",2,0],["هَذا فَعالُ اللَهِ ثُمَّ نَبِيِّهِ","وَالصَحبُ وَالشُعَراءُ فَيما نَظَّموا",7,"م",3,0],["هَذا فُؤادي لَديك وَهن","ذهلت عَنهُ فيما أَظن",8,"ن",1,0],["هَذا فَصِفهُ وَقُل في وَصفِهِ سَدَداً","مُدَّت لِواصِفِهِ في عُمرِهِ الطِوَلُ",9,"ل",1,0],["هذا فتىً نظم الشبابَ وصاغَهُ","وحياً تحدّرَ من أرقِّ مشاعرِ",10,"ر",1,0],["هَذا فَتىً يُبكى عَلى مِثلِهِ","وَهَذِهِ في أَوَّلِ النَشأَةِ",11,"ه",1,0],["هَذَا فَقِيدُ مَليكِهِ وَبِلاَدِهِ","وَشَهِيدُ إِخْلاَصِ الوَفِيِّ الصادِقِ",12,"ق",1,0],["هَذَا فَتَى الفِتْيَانِ غَيْرُ مُدَافَعٍ","وَالقُدْوَةُ المُثْلَى بِغَيْرِ جِدالِ",13,"ل",1,0],["هذا فتىً حرٌّ، يواجهُ خَصْمَهُ","لم يَرْم خَصْمًا من وراء قَذَالِهِ",14,"ل",2,0],["هذا فلان في حشاهُ بلبل","يشدو وهذا فيه يزأر ضيغمُ",15,"م",1,0],["هذا فتى نظم الشّباب وصاغه","وحيا تحد{ من أرقّ مشاعر",16,"ر",1,0],["هذا فؤادي للخطوب دريئة","وأنا المعرض فيكم فاستهدفوا",17,"ف",3,0],["هذا فؤادي والرُّزء رزءكما","تبكي له عين مستثيبكما",18,"م",2,0],["هذا فُؤاديَ طَوْعاً لَوْ هَمَمْتَ بِهِ","يَمْشي إِلَيْكَ إِذا اسْتَمْشَيْتَهُ لَمَشى",19,"ش",2,0],["هذا فتى لم يملك العبد الذي","اعتقه الا ببضع امته",20,"ت",2,0],["هذا فؤاديَ لم يملِكه قبلكمُ","خلقٌ وحقِّ أمير المؤمنين علي",21,"ل",2,0],["هذا فَتىً كانَت تَموَّ","جُ بِالجَواذِبِ وُجنَتاه",22,"ا",2,0],["هذا فُؤادي تُستَباحُ دِماؤُهُ","مُستَقطراتٍ من جِراحِ ودادِهِ",23,"د",2,0],["هَذا فُؤادي قَد تَصَدّع بعدهُم","من يَرْأبُ القَلبَ الصديع ويشعبُ",24,"ب",1,0],["هذا فضولٌ من نسيم الصبا","وهو الذي ينقل رياها",25,"ه",2,0],["هذا فؤادك مذ سكنت ضميره","هل حل فيه سواي قلت ولا حلا",26,"ل",2,0],["هذا فساد كلام شارح مسلم","وله فساد خلته مقبولا",27,"ل",2,0],["هذا فتى الزقزوق يرأف بال","زرزور لا للوعظ والزجر",28,"ر",1,1],["هذا فؤادُ أراني فضلَ قسوَتِه","لا كنتُ أن لم اُعِدْهُ للنوى مِزَعا",29,"ع",2,0],["هذا فؤادٌ أُراني أنَّني رجلٌ","في الحبَّ أتبعُ ما يختارُ مَذْهَبُه",30,"ب",2,0],["هذا فقيد بلادنا ال","خضرا ولا من ناكر",31,"ر",1,0],["هذا فؤادي ليس ينفك اضطرا","مه بيد أني بالدموع أبله",32,"ل",2,0],["هذا فؤادي اشتكى له وبكى","ما حيلتي والفؤاد منجذب",33,"ب",1,0],["هذا فقير القوم وهو مناهم","إن أبصروه فلا تمل عن جسره",34,"ر",2,0],["هَذا فُؤادي أَحصدته الأَسهم","مَن ذا يَرى تِلكَ الجُفون وَيَسلَمُ",35,"م",1,1],["هَذا فَريد أَلقاب هَذا أَحمَد ال","مُختار هَذا جامع الأَسرار",36,"ر",1,0],["هَذَا فُتُوحُ الشُّؤْمِ وهي شَوَاهِدٌ","أنَّ الْمُرادَ لَهُ نُصُوصُ كتابِهِ",37,"ب",2,0],["هذا فكيف عقولنا","لا تضمحل من الهناء",38,"ا",2,0],["هذا فَرَنْسيسُ ابنُ جَسْطَرَ قد مَضَى","في التِسعِ والعشرينَ مِن عُمْرٍ سَلَفْ",39,"ف",1,1],["هذا فؤادُ الدَّولةِ السَّامي الذي","رُدِفَت مراتبُ مَجدهِ بمراتبِ",40,"ب",1,1],["هذا فؤادُ المُلكِ صَدْرُ رِجالهِ","والصَّدرُ أهلٌ للفؤادِ فما اعتدَى",41,"د",2,0],["هذا فُؤادُ المُلكِ أدرَكَ قُطرَنا","بالشَّامِ يُصلحُ بالرَّشادِ فَسادَهُ",42,"د",2,0],["هذا فِراقُ الدَّهرِ لا نُحصِي لهُ","عَدَدَ السِنينَ ولا نَعُدُّ الأشُهرا",43,"ر",2,0],["هذا فِراقٌُ تَعلَمُونَ زَمانَهُ","أفتعلَمُونَ مَتى يكونُ المُلتَقَى",44,"ا",1,0],["هذا فكم قلت فيه","أَما ترى ما ترامى",45,"م",2,0],["هذا فعالهما وذاك نداهما","أرأيت فردا مثل ذلك يفعل",46,"ل",1,0],["هذا فلا تستعجلوا ببلادكم","سترون كيف يكون الاستفتاح",47,"ح",1,0],["هذا فتىً من بني الدهَّانِ حينَ مضى","أَجرَى لهم بحرَ دمعٍ بالدمآءِ جرى",48,"ر",2,1],["هذا فؤادي والسرور يهزه","من فرحة بكما ومن سراء",49,"ا",2,0],["هَذا فراقك قَد عَرفنا حالهُ","فَمَتى يكونُ لنا وجود لِقائكا",50,"ك",2,0],["هذا فؤادي لم يملكه غيركم","إلا الوصي أمير المؤمنين علي",51,"ل",2,0],["هذا فتى أضحى من الأبطال","وزاد في الفضل على الرجال",52,"ل",1,0],["هذا فؤادي إليكم قد بعثتُ به","ليقضيَ اللهُ أمراً كان مفعولا",53,"ل",2,0],["هذا فقير بائس معدمٌ","يعيش في دنياه مما دنى",54,"ن",2,0],["هذا فؤادي في يديك تذيبه","غادرته غرض السهام تصيبه",55,"ب",2,1],["هذا فؤاد من حديد بارد","أبداً وذاك السحر مغناطيس",56,"س",1,0],["هذا فراقٌ ولكن لا مآب له","على الحياة ووردٌ ماله صدر",57,"ر",1,0],["هذا فؤاد النيل يخفق من","خطب على البطحاء يشتد",58,"د",1,0],["هَذا فُؤادي يا حُسَينُ مُمُزَّقٌ","دامٍ وَذا جَفني القَريحُ الهامي",59,"م",2,0],["هذا فؤادي بِعتُهُ لَكِ راضياً","وصلاً حكمتِ عليهِ أم هجرانا",60,"ن",2,0],["هذا فتىً منا وتلك عروسه","من امةٍ فاق الكرام كرامها",61,"م",3,1],["هذا فتىً يرثي لحالي الضعيف","وليس عند اللَه أمر عسير",62,"ر",1,0],["هذا فقيدكِ يا حياةُ فودعي","بوداعهِ تلك الليالي الزاهيه",63,"ي",2,0],["هذا فكم من عُلاً به كَلِفَت","بفضح من رامها تكلفها",64,"ف",3,0],["هذا فراش وذا سقف يظلله","والأمر بينهما يجري على قدر",65,"ر",1,0],["هذا فإني شافعٌ","فيكَ إن الله شفع",66,"ع",1,0],["هَذا فُؤادي بِنارِ الشَوقِ مُحتَرِقٌ","فَلَيتَ شِعرِيَ ماذا تَحرِقُ النارُ",67,"ر",1,0],["هذا فؤادي في يديك على شفا","أن تُنعمِي بِخَلاصَه فيراك",68,"ك",1,0],["هذا فؤادي فامتلك أمرَهُ","واظلمهُ .. إن أحببت .. أو فاعدِل",69,"ل",1,0],["هذا فتى العلياء عيسى","المستلين شموسها",70,"س",3,0],["هذا فؤَادي رهنٌ في يديكِ الى","أَنى اعود أضخا شوقٍ وَتَبريحِ",71,"ح",1,1],["هَذا فُؤادِيَ كَالبَرْقِ الخَفُوقِ أَسىً","وَهذِهِ أَدْمعِي كَالعَارِضِ الهَتِنِ",72,"ن",1,0],["هَذا فكيْفَ بمَن أنالَ ودادَهُ","مَحْضاً ومدّ خُلوصَهُ أفْياءَ",73,"ا",2,0],["هذا فتى الدردنيل اسأل به الدول ال","كبرى فحاشا بأن تنسى ولم تجب",74,"ب",1,0],["هذا فقيد ديار عباس وسل","عنه يراعا باقيا ومحاكما",75,"م",2,0],["هَذا فُؤادي طالَ ما روّعته","وَتَرى العُيون وَطالما أَسهرتها",76,"ت",3,0],["هذا فِراقٌ قد أجَمْ","مَ فهل يكون لنا تَلاقِ؟",77,"ق",1,0],["هذا فتى الدنيا سليمان الذي","شغل الورى بجماله وجلاله",78,"ل",2,0],["هذا فخاري نسبتي ودمي","ولزفس ذلك قيم الأمم",79,"م",1,0],["هذا فريد الدر وافى به","فريد أهل النظم في كل آن",80,"ن",1,1],["هذا فؤادي مرجل يغلي على","نار لها مني الضلوع اثافي",81,"ف",2,0],["هذا فوأدي عندكم مستعذب","هون العذاب على هوان هواه",82,"ا",2,0],["هذا فوادٌ ومثى روح سلطنةٍ","لكنَّ أرواح الباب النُهى نهبا",83,"ب",2,0],["هَذا فُؤادي فَاِنظُري تاموره","تَبدو لِعَينك دونَهُ الآثار",84,"ر",1,0],["هذا فؤادي ظاعنٌ في إثرهم","يَعدو وجسمي قاطنٌ لم يرحَل",85,"ل",1,0],["هذا فُؤادك وهو بينَ ظعُونهم","يشكو الصبَابة عندَ من لا يرحم",86,"م",1,0],["هذا فديتك شهر صومك راحل","وكأنه برق أضاء فأومضا",87,"ض",2,0],["هذا فؤادي قطّعتهُ يد النوى","فغدَت ضلوعي للصبابة معهدا",88,"د",2,0],["هَذا فَريدٌ وَهَذي عَبقَرِيَّته","تُجلى رَوائِعُها في قِصَّةٍ عَجَبِ",89,"ب",1,0],["هَذا فَريدُ العَصرِ","وَغُرَّةٌ في مِصرِ",90,"ر",1,0],["هذا فكل مصيبة","فببعض ذنب قد مضى",91,"ض",2,0],["هذا فعالُ الفِراقِ فاستبنِ","واشكُ إلى اللَهِ حادثَ الزمنِ",92,"ن",1,1],["هذا فصيح العصر ليس لفضله","من منكر الامراء عدم الحجا",93,"ج",2,0],["هذا فرات سائغ يروى الصدى","بين الرواة ثناؤه هو مورد",94,"د",1,0],["هذا فقيد اليومِ أَصبح يومُه","كالأمسِ يدركه الخيالُ توهُّما",95,"م",2,0],["هذا فؤادي وأبْتغي فحْصَه","فأين َ طبّي وأينَ مختصّة ؟",96,"ص",2,1],["هذا فؤادي فازرعيه فربما","تنمو على جنباته الأزهار",97,"ر",1,0],["هذا فؤادي في يديك منيحة","لا تتركيه فريسة السرّاق",98,"ق",1,0],["هذا فعل لو السُبل ما تهيّت","وذاك ان تهيّت كلها ما فعل شيّ",99,"ي",1,0],["هذا فُؤَادي قَد رَميتُ بِذارَهُ","وَ حَرثتُ قَلبي بالهَوى فَلْتَسْقِني",100,"ن",2,0],["هذا فتىً غمرَ الغرامُ فؤادَهُ","وبه تَنعَّمَ بالهناء المُطْبِق ِ!",101,"ق",1,0],["هذا فصيح باللسان مطهر","منه الجنان وقلبه ذو رأفة",102,"ه",1,0],["هذا فؤادي في يديك معلق","ان تهجريهِ انما تؤذيهِ",103,"ي",2,0],["هذا فراقٌ بيننا فإذا مررتَ","على رفاتي فاتركنْ لي قُبلة..",104,"ل",2,0],["هذا فؤادي وادعٌ لمحبه","لكنه صعبٌ على الذؤبان..",105,"ن",1,0],["هذا ... فكيفَ بِمَنْ يُفارِقُ روحَهُ","ويواجهُ الدُّنيا بنفسٍ خائِرَهْ",106,"ر",2,0],["هَذَاْ فُؤَآدِيْ ضُمَّهُ فَلَقَدْ شَقَىْ","وَشَقَتْ بِهِ كَلُّ الْحَيَاْةِِ مَفَاْرِقَاْ",107,"ق",2,0],["هذا فؤادي كفاهُ اليومَ وخزةَ منْ","تعلَّمتْ فيهِ فنَّ الرسمِ والنحتِ",108,"ت",1,0],["هذا فؤادي وقد أكملتُ فرحتَهُ","غنى الهوى طرباً ما عادَ يحتارُ",109,"ر",1,0],["هذا فؤادُ فداك منه فؤادهُ","العشق فيه قليله فيضان",110,"ن",1,0],["هذا فؤادي بات فيكِ مقيداً","في قضبةً ما بعدها إكسارُ",111,"ر",1,0],["هذا فُراقٌ بَيْنَنا يا خاسرا","حبي وقلبي ...قد خسرتهما معا",112,"ع",2,0],["هذا فؤادي بدرُهُ بشغافِهِ","متجحفلٌ تحدو به الشعراءُ",113,"ا",2,0],["هذا فؤادي يستجيرُ بربّهِ","واللهَ أسألُ.. إن غوى أن يغفِرا",114,"ر",2,0],["هذا فؤادي فاحفظيهِ هنا","إياكِ مِن فاتورةِ المُزَقِ",115,"ق",1,0],["هذا فُراقٌ بَيْنَنا لا رَجْعَة","فَالغَدْرُ مِنْ طَبْعِ الذِّئاب تَفَرَّعا",116,"ع",2,0],["هذا فؤادي راكعٌ يحنو عليه","حبا يعمّده وجوداً ينطلقْ",117,"ق",1,0],["هذا فؤادي لكم للنحرِ أضحية","علّ الفؤاد إذا مااغتيل يرتاحُ",118,"ح",1,0],["هذا فراقٌ وخير الحب أطوله","لكن روضته للسلم تهواه",119,"ا",2,0],["هذا فؤاديَ الهامٌ ومغتسلٌ","فاغسل به الجرح لاتأبه بمن غرقا",120,"ق",2,0],["هذا فؤادي قد أضاء بنوره","وقبست من شيخ الزمان مشاعله",121,"ل",2,0],["هذا فمستقبلُ الأوطانِ مكتبةٌ","إِنْ قِيلَ إِقْرَأْ فَإِقْرَأْ منْ رسائلهِ",122,"ل",2,0],["هذا فؤادٌ بعدَهمْ خافقٌ","ومقلةٌ للبينِ لم تَهجَعِ",123,"ع",1,0],["هذا فؤادي كله ألم فهل","من بلسم في قلبك المتحجر",124,"ر",1,0],["هذا فراقٌ قدْ يطولُ فحاولي","أنْ تفهمي انَّ اللقاء َبعيدُ",125,"د",1,0],["هذا فراقٌ بيننا .. يا لوعتي","والوصل وهم ليس منه طائلُ",126,"ل",1,0],["هذا فراق فيه نندب حظنا","والنهر يبكي والضفاف مسافره",127,"ر",2,0],["هذا فراق كاد يسحقُ مهجتي","هل لي بوصل قبل يوم الآخره",128,"ر",2,0],["هذا فؤاد العصر بل هذا عما","د الدهر بل مراد جيادهِ",129,"د",2,0],["هذا فُؤادي قد أتاكَ مُسافراً","إذْ فرَّ منْ بينِ الضلوعِ وطارا",130,"ر",2,0],["هذا فؤادي قد تعذّب بالجوى","ما عدت أبغي بالهوى إحراقي",131,"ق",2,0],["هذا فقيد ملكيه وبلاده","وشهيد إخلاص الوفي الصادق",132,"ق",1,0],["هذا فتى النيل ذو التاجين من قدم","هذا فتى مصر راعمسيس الثاني",133,"ن",2,0],["هذا فؤادي غارق بهمومه","مستسلم لجراحه مُتَمزِّقُ",134,"ق",1,0],["هذا فؤادي صبا..في حبِ موطنه","خذني إليهِ سلاماً بردهُ ودفا",135,"ف",2,0],["هذا فؤادي الآن أنزعه","فبدونك الوجدان ما سكنا",136,"ن",2,0],["هذا فؤادي فشُقِّيه لكي تَجِدِي","به غرامَكِ للآهات يحشدُها",137,"د",3,0],["هذا فليس رضاعهُ","بعد الفصالِ لمن سغب",138,"ب",1,0],["هذا فؤادي بنار الحزن مكتويًا","من فرقةٍ أحرقت أمطارُها جفني",139,"ن",2,0],["هذا فراقٌ بيننا .. كم قبْلَنا","(وبعهدنا مَنْ بالغرام ِتفوَّقوا",140,"ق",3,0],["هذا فراس دائماً مستبسلٌ","هو حصننا في اليسْرِ والأزماتِ",141,"ت",1,0],["هذا فؤادي والهوى متعسّفٌ","وأنا هناكَ بمقلتيكِ أنبْتُ",142,"ت",1,0],["هذا فؤادي والفؤاد متيّمٌ","في حب ذاك الشامخِ الوطنِ العَلَمْ",143,"م",1,1],["هذا فراقُ أمانٍ.. لا انتِظارَ غدًا","قَد يُطلقُ الدَّهرُ مِن أَسرَارِهِ أَسرَى",144,"ر",2,0],["هذا فؤادي والغيوم سوابح","ترتاح عبر حقولها وتلين",145,"ن",1,0],["هذا فؤادي نُصب عينك كي ترى","صِدقي بحبّك أيها المتقلّب",146,"ب",1,0]]