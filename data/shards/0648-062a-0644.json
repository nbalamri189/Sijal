84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[95,"طلل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=240&r=&rc=3",""],[85,"جعلتُ حُلاها وتمثالها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9586&r=&rc=76",""],[90,"لعبة التجارب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66767&r=&rc=175",""],[96,"طارق بن زياد في طريقه إلى الأندلس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66419&r=&rc=95",""],[92,"راعها منهُ صَمتُه ووجُومُه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14597&r=&rc=42",""]],"verses":[["وَتِلكَ البَنانُ المورِقاتُ مِنَ النَدى","نَواضِبُ ماءٍ أَو بَواقٍ كَما هِيا",0,"ي",2,0],["وَتَلاحُقُ الفُضَلاءِ أَعظَمُ شاهِدٍ","إِنَّ الحِمامَ بِغَيرِ عِلقٍ مولَعُ",1,"ع",1,0],["وَتَلَفَّعتُ رَيطَةً مِن بَياضٍ","أَنا راضٍ مِنها بِما ليسَ يُرضى",2,"ض",2,0],["وَتَلَقَّت بيَ الظَلامَ رَديفَ ال","نَجمِ بَينَ الإِتِهامِ وَالإِنجادِ",3,"د",1,0],["وَتَلقى الوَغى وَاليَومُ يَنضُرُ بيضَهُ","عَلى البيضِ في مَجرىً مِنَ الجَدِّ وَالجِدِّ",4,"د",1,0],["وَتَلَفَّتَت عَيني فَمُذ خَفِيَت","عَنها الطُلولُ تَلَفَّتَ القَلبُ",5,"ب",1,0],["وَتَلقَونَها كَقِداحِ السَر","راءِ قوداً تَجُرُّ العَوالي وَقَب",6,"ب",1,0],["وَتَلتَذُّ رَشفَ الماءِ رَنقاً كَأَنَّهُ","مَعَ العِزِّ ثَغرٌ بارِدُ الظَلمِ أَشنَبُ",7,"ب",1,0],["وَتِلكَ بُيوتٌ بَناها الإِلَهُ","عَلى عُمُدٍ في نِزارٍ طِوالِ",8,"ل",1,0],["وَتَلصِقُ صِحَّةً بِالدَّاءِ مِنها","إِذا اِعتَنَقَتْ كَلاكِلُها ثَراها",9,"ا",3,0],["وَتِلكَ حُروبٌ مَن يَغِب عَن غِمارِها","لِيَسلَمَ يَقرَعْ بَعدَها سِنَّ نادِمِ",10,"م",1,0],["وَتَلطِمُ خَدَّ الأَرضِ مِنهُ حَوافِرٌ","تُعانِقُ مِنهُنَّ الجَلامِدُ جَلمَدا",11,"د",2,0],["وَتِلْكَ دارٌ وَرِثْناها مُعاوِيَةً","لكِنَّ كُوفَنَ أَلْقانا بِها الزَّمَنُ",12,"ن",1,0],["وتلْمَعُ في أعْلى مُحيّاهُ غُرّةٌ","هيَ الصُّبْحُ شَقَّ اللّيلَ غِبَّ اعْتِكارِهِ",13,"ر",2,0],["وتَلْطِمُهُ أيْدي العَذارى بخُمْرِها","إذا انتَظَرَ السّاري مَشَنَّ غِوارِهِ",13,"ر",2,0],["وتِلْكَ البَنيّةُ مُذْ أُسِّسَتْ","أبَتْ غَيرَ عَبدِ مَنافٍ قَطينا",14,"ن",2,0],["وتِلْكَ رِكابي إنْ غَرِضْنَ ببَلدَةٍ","بَكَرْنَ ولمْ تَشعُرْ بسَيْري بُزاتُها",15,"ت",3,0],["وتَلْمَعُ منْ أخفافِهنَّ على الثَّرى","نَظائِرُ مِرآةٍ يُضَرِّجُها الدَّمُ",16,"م",1,0],["وتُلْزِمُهُ أنْ يَكتُمَ السِّرَّ بَعدَما","أُطِيعَ له الواشي فسِرُّ الهَوى جَهْرُ",17,"ر",1,0],["وتلكَ مَساعِيهِمْ فلَو شِئْتُ حَدّثَتْ","بما استُودِعَتْ منها شُهورٌ وأحوالُ",18,"ل",1,0],["وتلك الدِّيار الغائصات إلى اللِّحى","بأطلالها، هل تبتغي أيَّ مُبتغى؟",19,"غ",2,0],["وَتَلمَعُ فيها البيضُ مِن كُلِّ جانِبٍ","كَلَمعِ بُروقٍ في ظَلامِ الغَياهِبِ",20,"ب",1,0],["وَتِلكَ عِظامٌ بالِياتٌ وَأَضلُعٌ","عَلى جِلدِها جَيشُ الصُدودِ مُخَيِّمُ",21,"م",1,0],["وتَلْخيصُ ما دَنْدَنْتَ بالقَوْلِ حوْلَهُ","إذا قُمْتَ بالبَاقي فمازِلْتَ باقِيا",22,"ي",2,0],["وتلوّمْتَ بأكْنافِ سَلا","ترْفَعُ الدّوْحَ قَليلاً وتضَعْ",23,"ع",1,0],["وتلطّفْ فإنّما هيَ نجْوى","بثّها الشّوْقُ بيْنَ موْلًى وعَبْدِ",24,"د",1,0],["وتَلْقَى قِباباً دونَها كلُّ ضامِرٍ","منَ الأعْوجِيّاتِ السّلاهِبِ أشْوَسِ",25,"س",1,0],["وَتَلقاكَ المَلامَةُ كُلَّ وَجهٍ","سَلَكتَ وَيَنتَحي حالَيكَ ذَمُّ",26,"م",1,0],["وَتَلَتهُ غُضفٌ طَوارِدُ كَالنَح","لِ مَغاريثُ هَمُّهُنَّ اللُحاقُ",27,"ق",1,0],["وَتُلقى حَصانٌ تَخدُمُ اِبنَةَ عَمِّها","كَما كانَ يُلقى الناصِفاتُ الخَوادِمُ",28,"م",1,0],["وَتُلقى الأَكارِعَ في بارِدٍ","شَهِيٍّ مَذاقَتُهُ تَحتَسينا",29,"ن",2,0],["وتلكَ قُوّةُ نفسٍ لو أراد بها","شُمَّ الجِبالِ لمَا قَرّت رَواسيها",30,"ي",3,0],["وَتَلَونا آياتِ شَوقي وَصَبري","فَرَأَينا ما يَبهَرَ الأَفهاما",31,"م",2,0],["وَتَلَطَّفتَ لِصَبٍّ","حَينُهُ فيكَ يَحينُ",32,"ن",1,0],["وَتَلَقَّ مِن سِمَتَيكَ صِدقَ تَفاؤُلي","فَهُما المُؤَيَّدُ بِالإِلَهِ الظافِرُ",33,"ر",1,0],["وَتَلَقَّيْتُ مِنْكَ أَزْهَدَ شَيءٍ","فَإِذَا الكَهْلُ مِنْ سُرورٍ صَبِيْ",34,"ي",1,0],["وتلك علياء لقد شدتها","مدعومةً بالأنجم الزهر",35,"ر",1,0],["وَتِلْكَ يَا سَيِّدَتِي أَمِينَهْ","مَأْثَرَةٌ جدِيدَةٌ ثَمِينَهْ",36,"ن",2,0],["وَتَلْتَقِي كُلَّ ابْتِسَامٍ كَمَا","تَلْقَى الشُّعَاعَ الدُّرَّة الزَّاهِرَهْ",37,"ر",2,0],["وَتَلَفَّتَ المَاضِي إِلَيْكَ مُحَيِّياً","أَمَلاَ بِهِ المَجْدَانِ يَلْتَقِيَانِ",38,"ن",1,0],["وَتَلَقَّ مِنْهُ يَداً تُجِيدُ خِيَارَهَا","وَتُكَافيءُ الإِحْسَانَ بِالإِحْسَانِ",38,"ن",1,0],["وَتَلا الثَّغْرُ تِلْوَهَا فَعَدَا","شَأْوَهَا بَهْجَةً وَإِتْقَانَا",39,"ن",2,0],["وَتِلْكَ رُوحٌ لَمْ تُشِبْ صَفْوَهَا","شَوَائِبٌ تُمْحَى بِغُفْرَانِ",40,"ن",1,0],["وَتَلَقَّتْ أَنْبَاءهُ مِصْرُ وهْناً","فَهي وَلْهَى وَمَا لَهَا سُلْوَانُ",41,"ن",1,0],["وَتَلْقَى مِنْ طَرِيفِ الوَشْيِ فِيهَا","أفَانِينَ الأزَاهِرِ وَالوُشُومِ",42,"م",1,0],["وتَلبَسُ مِن بَزِّ العِرَاقِ مَناصِفاً","وأَبرادَ عَصبٍ من مُهَلهَلَةِ الجَنَد",43,"د",1,0],["وتلبَسُ فِيكَ النَّيِّراتُ ظلامَهَا","حداداً ويذكي النجمُ جفُن مُسهْدِ",44,"د",1,0],["وتلك صبغته أعدى بنيه بها","إذا تراخى مجال العمر وانفسَحَا",45,"ح",2,0],["وتلقى الوجوه البيض حمراً خدودها","وتلقى العيون السود والأعين الزرقا",46,"ق",2,0],["وتلهب منه في الفضاء شرارة","فتُبصرها في الرافدين عيون",47,"ن",1,0],["وتلك لعمري قرحة قد نكأتها","بما قلته فاهتاج بالشرق بلبال",48,"ل",1,0],["وَتَلقى جُنَيداً يَحمِلُ الخَيلَ مُعلِماً","عَلى عارِضٍ مِثلُ الجِبالِ كَتائِبُه",49,"ب",2,0],["وَتَلقى في الوَلاءِ عَلَيكَ سَعداً","ثِقالَ الوَطءِ ضالِعَةَ الخُصومِ",50,"م",1,0],["وتلَّه للجبين منعفراً","منه مناط الوتين منقضِبُ",51,"ب",1,1],["وتلقي عليه عند كل عظيمة","شراشر من حَيّي نِزار والبُبُ",52,"ب",1,1],["وَتُلقى لَدى أَبياتِنا حينَ نُجتَدى","مَجالِسُ فيها كُلُّ كَهلٍ مُعَمَّمِ",53,"م",1,0],["وَتَلقاهُ عَلى ما كانَ فيهِ","مِنَ الهَفَواتِ أَو نوكِ الفُؤادِ",54,"د",1,0],["وتلذُّ لي البرحاء أعلم أنه","يرضيكِ ما ألقى من البرحاء",55,"ا",2,0],["وتلقى بضائعَ القصدِ والحم","د فجئنا إلى حماهِ تجارا",56,"ر",2,0],["وتلذّ أمراضي عليك وليتني","أدري أحسنك ساخطٌ أم راضي",57,"ي",1,0],["وتلثم حتى مبسم الغيث في الثرى","بدور لآثار الركائب مطلعا",58,"ع",2,0],["وتلوت قاف معوّذاً من قافها","خوفاً عليه من النواظر أشفق",59,"ق",1,0],["وتلهيه في الهيجاء رنَّة قوسهِ","إذا وترٌ ألهى امرأً برنينه",60,"ن",2,0],["وتلقفت إفك الغواة يراعةٌ","ألقت عصاها في الأمورِ يمين",61,"ن",1,0],["وتلقّ بالإقبالِ كلّ نظيمةٍ","عَلِقَتْ بحبلٍ من ولاكَ متين",62,"ن",1,0],["وتلاقينا غريبين هنا","لم تكن أنتَ ولا كنتُ أنا",63,"ن",2,1],["وتُلاقيك شيعةٌ فيظلّو","ن على ظهر آلةٍ حَدْباءِ",64,"ا",2,0],["وتُلَقَّى الصوابَ فيما سوى ذا","ك إذا جار جائرُ الآراءِ",64,"ا",2,0],["وتلتها عجائبٌ فتغَنّتْ","مُشبهاتِ اسمها صُيابا ولاءَ",65,"ا",2,0],["وتلك دعوةُ إجلالٍ وتَكرِمةٍ","ودِدتُ أنِّيَ معتاضٌ بها لَقَبا",66,"ب",2,0],["وتَلقَّ إنعامَ الإله بشكرهِ","فأخو الجحودِ مُنَغَّصٌ مسلوبُ",67,"ب",1,0],["وتلك قضايا الله جلَّ ثناؤه","وليست قضايا الله بالهفواتِ",68,"ت",1,0],["وتُلَقِّي الطريدَ يَعْروكَ إيوا","ءك إياه والعِدا تَطْريدَك",69,"ك",1,0],["وتلقى أخا الفرع البهيم مظفَّراً","إذا شاء أضْنى ذاتَ دلٍّ وأحْرضا",70,"ض",2,0],["وتُلاقي مع الكتابة فيهم","كُلّ خوَّاض غمرةٍ وخَّاض",71,"ض",1,0],["وتلاهُ أبو محمدٍ المح","مودُ فينا دون الثَّرى الفضَّاض",71,"ض",1,0],["وتلقى وجوه الأولياء وحسبُهم","بوجهك ذاك الطلق في يومك الطلق",72,"ق",1,0],["وتلونت لي وأخلفني نَو","ؤك إلا تملُّقاً ببروق",73,"ق",1,0],["وتلك نفوسٌ لو عُرِضن على الردى","فِداءً رأى ألا تفي بقبالكا",74,"ك",2,0],["وتلَوْك في سَنن الرشا","د فشمَّروا ثم اشمعلُّوا",75,"ل",3,0],["وتلك أعزُّ لي منْ كل رمحٍ","وصَمصام إذا دُعِيتْ نَزالِ",76,"ل",1,0],["وتلته على الوحَى واثقاتٍ","من صبيبِ الدماءِ بالأنعالِ",77,"ل",1,0],["وتلك أوَّلُ بشرى إنَّ دولتَكُمْ","غيثُ يَريع عليه الحبُّ والنسمُ",78,"م",1,0],["وتَلْبَسُ الحليَ مجعولاً لها عُوَذاً","لا زينةً بل بها عن ذاك غُنيان",79,"ن",1,0],["وَتَلمَحُ بَعدَ الجَهدِ عَن لَيلَةِ السُرى","بِغائِرَةٍ تَأوي إِلى حاجِبٍ ضَمرِ",80,"ر",1,0],["وَتُلبِسُنا في اللَيلِ آفاقُهُ سَناً","وَتَنشُرُنا في الفَجرِ أَنسامُهُ نَدّا",81,"د",2,0],["وَتِلكَ العِصِيُّ لِتِلكَ الرُؤوسِ","وَتِلكَ الحِرابُ لِتِلكَ البُطون",82,"ن",1,0],["وَتِلكَ السُجونُ لِمَن شُدتُموها","إِذا لَم تَزُجّوهُمُ في السُجون",82,"ن",1,0],["وَتَلَذُّ بِالأَرواحِ تَعبَقُ بِالشَذى","وَتَهُزُّكَ الأَنغامُ مِن شاديهِ",83,"ي",2,0],["وَتِلكَ أَعظَمُ حاجاتي إِلَيكَ فَإِن","تَنجَح فَما خابَ فيكَ القَصدُ وَالأَمَلُ",84,"ل",1,0],["وَتِلاوَةٌ يَجلو الدُجى أَنوارُها","قَد زانَها التَرتيبُ وَالتَرتيلُ",85,"ل",1,0],["وَتِلكَ قالوا ضَرطَةٌ","عِندَ النُحاةِ مُضمَرَه",86,"ر",2,0],["وَتَلَقّى بِقَبولٍ","حَسَنٍ فيكَ دُعائي",87,"ا",2,0],["وَتَلقى جارَنا يُثني عَلَينا","إِذا ما حانَ يَومٌ أَن يَبينا",88,"ن",2,0],["وتلاها ببَسْمَةٍ رَشَفَتْها","منهُ سَكْرانَةُ الشَّبابِ رؤومُهْ",89,"م",2,0],["وتلهو بها الرِّيحُ في كلِّ وادٍ","ويدفنها السَّيلُ أَنَّى عَبَرْ",90,"ر",1,0],["وتَلاشَتْ في سُكُونِ الإكْتِئَابْ","كَصَدَى الغِرِّيدْ",91,"د",1,0],["وتلكَ هيَ الدُّنيا رِوايةُ ساحرٍ","عَظيمٍ غَريبِ الفَنِّ مُبْدِعِ آياتِ",92,"ت",1,0],["وَتَلقى نَعيماً يُنسِّي الشَقا","وَتَجني سَراحاً يُنسِّي الإِسارا",93,"ر",2,0],["وتلك امنية تغري الشكوك بها","كوردة ذات حسن بين اشواك",94,"ك",1,0],["وتلمَّس الدنيا الكعاب فلم تجد","يده لياليها ولا أيامها",95,"م",3,0],["وتلتفت القلوب إليك شوقا","فتهديها لموضعها الصدور",96,"ر",1,0],["وتلحظ عيدك الأسنى بعين","تفاجى بالهوى تلك العيونا",97,"ن",2,0],["وَتَلَقَّ أَعيادَ الزَمانِ مُنيرَةً","فَهَناؤُهُ ما كانَ فيهِ هَناكا",98,"ك",2,0],["وَتَلاهُما باقي السِباعِ وَكُلهُم","خَرّوا لِهَيبَتِهِ إِلى الأَذقانِ",99,"ن",1,0],["وَتَلمَحُ بَينَ بُيوتِ القَصيد","حِجالَ العَروسِ وَأَحجالَها",100,"ل",3,0],["وَتِلكَ الأَواعي بِأَيمانِهِم","حَقائِبُ فيها الغَدُ المُختَبي",101,"ب",2,0],["وَتَلَفَّتَت في اليَمِّ كُلُّ سَفينَةٍ","وَاِنثالَ بِالوادي الجُموعُ وَحَدَّقوا",102,"ق",3,0],["وَتِلكَ جَزائِرٌ أَم نَيِّراتُ","وَكَيفَ طُلوعُها وَالوَقتُ ظُهرُ",103,"ر",1,0],["وَتَلَقّى الهِلالَ مِنكَ جَبينٌ","فيهِ حُسنٌ وَبِالعُفاةِ غَرامُ",104,"م",1,0],["وَتَلاكَ طُرغودُ كَما قَد كُنتُما","جَنباً لِجَنبٍ وَالعُبابُ ضِرامُ",105,"م",1,0],["وَتُلفيهُمُ حِيالَ المالِ صُمّاً","إِذا داعي الزَكاةِ بِهِم أَهابا",106,"ب",2,0],["وَتَلمَحُ مِن وَضاءَةِ صَفحَتَيهِ","مُحَيّا مِصرَ رائِعَةً كَعابا",107,"ب",2,0],["وَتِلكَ صُموتٌ وَذا ناطِقٌ","إِذا حَرَّكوهُ فَسا أَو هَذى",108,"ا",1,0],["وَتُلقي وَما تَدري البَنانُ سِلاحَها","لِكَثرَةِ إيماءٍ إِلَيهِ إِذا يَبدو",109,"د",2,0],["وَتَلقى نَواصيها المَنايا مُشيحَةً","وُرودَ قَطاً صُمٍّ تَشايَحنَ في وِردِ",110,"د",1,0],["وَتَلثَمُهُ حَتّى أَصارَ مِدادُهُ","مَحاجِرَ عَينَيها وَأَنيابَها سُحما",111,"م",2,0],["وَتَلَفَّت إِلى القَبائِلِ فَانظُر","أُمَّهاتٍ يُنسَبنَ أَم آباءَ",112,"ا",2,0],["وَتَلالي وَجهٍ إِذا لاحَ لِلطا","لِبِ أَمسى مَبلوغَةً أَرابُه",113,"ب",2,0],["وَتَلتَذُّ مِن طَيِّباتِ الطَعا","مِ وَتَشرَبُ مِن جَيِّدِ المَشرِبِ",114,"ب",1,0],["وَتِلادُ الإِخوانِ تُخلِقُهُ البِذ","لَةُ مالَم تُغِبَّهُ بِالطَريفِ",115,"ف",1,0],["وَتِلكَ سَحاباتٌ مَرَرنَ وَقَد تَرى","تَفاوُتَ ما بَينَ الرَذاذِ إِلى الهَطلِ",116,"ل",1,0],["وَتَلقى اِبنَ الوَليدِ وَإِن أُنيخَت","إِلى مُغلَولَبٍ بِنَداهُ غَمرِ",117,"ر",1,0],["وتَلفَحَه ريحُ الأراقمِ إِنَّها","سَمومٌ على أعدائِها وسِمامُ",118,"م",1,0],["وتَلحَقُ بالأرضِ أطرافُها","إذا هي دارَتْ على خَصرِه",119,"ر",2,0],["وتُلاقي الجسومَ في خِلَعٍ من","ه رِقَاقٍ على الجُسومِ مِلاحِ",120,"ح",1,0],["وتلتقي بالبيضِ فرسانُه","فضاربٌ منهم ومضروبُ",121,"ب",1,0],["وتَلقاه مبتسماً واضحاً إذا","ما الحوادثُ أبدَتْ قُطوبا",122,"ب",2,0],["وَتُلوي بِرَيّانِ العَسيبِ تُمِرُّهُ","عَلى فَرجِ مَحرومِ الشَرابِ مُجَدَّدِ",123,"د",1,0],["وَتَلتَمِسُ الصَلاحَ بِغَيرِ حِلمٍ","وَإِنَّ الصالِحينَ لَهُم حُلومُ",124,"م",1,0],["وَتَلا مَرحَباً فُؤادي لِلُقيا","كَ فَنابَت عَيناكَ عَن ذي الفِقارِ",125,"ر",1,0],["وَتِلكَ لَعَمري كَالنُجومِ زَواهِرٌ","تُقِرُّ بِها الحُسّادُ رَغماً عَلى غَبنِ",126,"ن",1,0],["وتلك الكرومُ الدانياتُ لقاطفٍ","بياضُ الأماني من عناقيدِهَا الربدِ",127,"د",1,0],["وتَلفَّتُّ فلا أنت ولا","جنةُ الخلد ولا أطيافُ سَعدِ",128,"د",1,0],["وتلفَّتُّ على آثارِهَا","أسألُ الليَّل ومَن لي بالجواب",129,"ب",1,0],["وتلاشت واختفت أجسادنا","واعتنقنا في الدُّجى روحاً بروح",130,"ح",1,0],["وتلقَّاني رشاشٌ كالبكا","وهديرٌ مثل موصول النحيب",131,"ب",1,0],["وتلفَّتَت هندٌ لمو","ضعه تغالب وَجدهَا",132,"ه",2,0],["وتلك قوافل الأيام تترى","تمر علي سرباً بعد سرب",133,"ب",1,0],["وتلاقينا لقاء الغرباء","ومضى كل إلى غايته",134,"ه",1,0],["وتلقطُ الرمحَ من أرضِ الوَغى بيدٍ","والطِّرْفُ يجري كلمح البرق في الحَزَنِ",135,"ن",1,0],["وتلك شقيقةُ روحِ الفتى","إذا وُجِدَتْ فالأسَى يُعْدَمُ",136,"م",1,0],["وتلحظُ بالسحرِ منه الجفونُ","ويلفظُ بالدّرّ منه الفمُ",136,"م",1,0],["وتلك بحورٌ من عطاياه أُنشِئَتْ","لها سُفُنُ الآمال لا للجداوِلِ",137,"ل",1,0],["وَتَلوكُ من فَقْدِ القَضيمِ شَكائِماً","تُنْهَى بها أفْواهُهُنَّ وَتُؤمَرُ",138,"ر",1,0],["وتَلقى المنايا وهيَ في عَرَض المُنى","وكم أجَلٍ للطير في مَلْقَطِ الحَبِّ",139,"ب",1,0],["وَتَلبَسُ أَخلاقاً كِراماً كَأَنَّها","عَلى العِرضِ مِن فَرطِ الحَصانَةِ أَدرُعُ",140,"ع",1,0],["وَتَلويحَ أَجسامٍ تَصَدَّعُ تَحتَها","قُلوبٌ رِياحُ الشَوقِ فيها سَمائِمُ",141,"م",1,0],["وَتِلادٌ وَلَم أَرِثهُ وَكَنزٌ","لَيسَ مِن عَسجَدٍ وَلا أَوراقِ",142,"ق",1,0],["وتلاه ويْلاه حبُّ غمامٍ","فحسبناهُ لؤلؤاً منثورا",143,"ر",2,0],["وَتَلَدُّدي شَهراً أُريدُ لِقائَها","حَذِرَ العَدُوِّ بِساحَةِ الأَحبابِ",144,"ب",1,0],["وَتَلدَغُني تارَةً حَيَّةٌ","هُناكَ يُساوِرُها رِدفُهُ",145,"ف",2,0],["وَتَلافَ مِن بَحرِ الشُكاةِ","أَخاً يَمُدُّ يَدَ الغَريقِ",146,"ق",1,0],["وَتَلَدَّدَت نَحوَ الحِمى بي نَظرَةٌ","عُذرِيَّةٌ ثَنَتِ العِنانَ إِلى الحِمى",147,"م",2,0],["وتِلكَ سَبِيلُهم لا عَيْبَ فيها","وإن زَهقتْ نُفوسُ اللّائمينا",148,"ن",2,0],["وتلك النّارُ تُلقِي الناسَ فيها","بأرضِ التُّركِ أيدي المُضرِمينا",148,"ن",2,0],["وتَلْبَسُ من دَمِ الأبطالِ مِرطاً","تَفيضُ له نُفوسُ اللّابسينا",148,"ن",2,0],["وتلك شرائعُ الإسلامِ عادت","تجبُّ شرائعَ المُسْتَعمرينا",148,"ن",2,0],["وَتِلكَ وُفودُها جاءَتكَ تبدي","من الشوق المبرِّح ما تواري",149,"ر",2,0],["وتِلكَ كفُّ أخيهِ فَوْقَ مَفْرقِهِ","كأنّها من جَنيِّ الزّهرِ تَقْتَطِفُ",150,"ف",1,0],["وتَلَوا آيَة الوداعِ فَخَرُّوا","خِيفَة البَينش سُجَّدا وبَكِيَّا",151,"ي",2,0],["وتُلقى بيننا الحجب","فأحيا لا ألاقيك",152,"ك",1,0],["وتُلقْينَ السُّؤالَ علي","يَ في أْمرٍ تَعدَّاك",153,"ك",1,0],["وَتَلمس الزَهر الحييَّ فَاطرَقت","أَجفانه شَأن المُحب المُذعن",154,"ن",1,0],["وَتَلمَحُ مِن مَخايلِهِ بُروقاً","مواصَلَةَ الوَميضِ إِلى بُروقِ",155,"ق",1,0],["وَتِلكَ لَئِن عُنيتَ بِها رَداحٌ","مِنَ النِسوانِ مَنطِقُها رَخيمُ",156,"م",1,0],["وَتِلكَ عُقبى الغَيِّ وَالضَلالِ","وَالكُفرِ بِالرَحمَنِ ذي الجَلالِ",157,"ل",1,0],["وَتَلقانا الذِئابُ إِذا غَدَونا","فَتَفري الجَونَ وَثباً وَاِلتِفاتا",158,"ت",2,0],["وَتَلقَطُ يُمناها إِذا ضَرَبَت بِهِ","وَتَنثُرُ يُسراها عَلى العودِ عُنّابا",159,"ب",2,0],["وتلك بنو مروانَ نعلاً ذليلةً","لواطِىءِ أقدامٍ وأنتَ لها شِسْع",160,"ع",1,0],["وتلَقّتِ الرُّكْبانَ سَمْعي بالذي","سَمِعَ الزّمانَ أقلَّه فتعجّبَا",161,"ب",2,0],["وَتَلَذَّذَت أَجفانُهُ","بِقُعودِهِ وَقِيامِهِ",162,"م",2,0],["وَتَلومانِني وَقَد","نَزَلَ المَوتُ أَسوَدا",163,"د",2,0],["وَتَلافَيتِني بِذَلِكِ عَنهُن","نَ وَأُنسٍ يُصَبُّ لِلحُبِّ صَبّا",164,"ب",2,0],["وَتِلكَ لَعَمري شيمَةٌ أَوَّليَّةٌ","تَوارَثَها شيثُ الحَمامِ وَنوحُها",165,"ح",3,0],["وَتِلكَ لَعَمرُ اللَهِ أَصعَبُ خُطَّةٍ","كَأَنَّ حُدوري في التُرابِ صُعودُ",166,"د",1,0],["وَتُلهِمُ النَحلَ جَمعَ الأَريِ جاهِدَةً","حَتّى إِذا جَمَّ قالَت لِلعَديمِ شُرِ",167,"ر",1,0],["وَتَلافَ الَّذي مَضى","قَبلَ أَن يَنزِلَ التَلَف",168,"ف",1,0],["وَتُلقى لَدَيكَ المُنقِضاتُ نَواصِعاً","يُقالُ غَريباتُ البِحارِ التَوائِمُ",169,"م",1,0],["وَتِلكَ غَمائِمُ الدُنيا اللَواتي","يُسَفِّهنَ الحَليمَ إِذا وَمَضنَه",170,"ن",2,0],["وَتِلكَ دارٌ غَيرَ مَأمونَةٍ","أَولِعَ ضاريها بِخَزّانِها",171,"ن",3,0],["وَتِلكَ الوَحشُ ما جادوا عَلَيها","بِعُشبٍ غِبَّ نَدٍّ عَشَّبوهُ",172,"ب",3,0],["وَتِلكَ أَوصافُ مَن لَيسَت جِبِلَّتُهُ","جِبِلَّةَ الإِنسِ بَل كُلٌّ يُنافيهِ",173,"ف",3,0],["وتُلقى عنهُمُ لكَمالِ حَوْلٍ","كثِيراتِ الخُرُوقِ مِنَ السِّمامِ",174,"م",1,0],["وَتُلبِسُ قَوماً بِالمُشَقَّرِ وَالصَفا","شَآبيبَ مَوتٍ تَستَهِلُّ وَلا تُغضي",175,"ض",2,0],["وَتَلْقى العَاشِقينَ لَهُمْ جُسومٌ","بَراها الشَّوقُ لو نُفِخُوا لطاروا",176,"ر",3,0],["وتَلافي إن كان فه ائتلافي","بكَ عَجّلْ به جُعِلْتُ فِداكا",177,"ك",2,0],["وتلَطّفْ واجْرِ ذكري عندهم","علّهُم أن ينظُرُوا عطفاً إلي",178,"ي",1,0],["وتَلاَفِيكِ كُبُرْئي دونَهُ","سَلْوَتي عنكِ وحظّي منكِ عَي",178,"ي",1,0],["وتلكَ جِيادُهم والمُرهفاتُ","فَدَعْ دينَ الغُواةِ وقُلْ سَلامُ",179,"م",1,0],["وَتَلَفَّتَت مِصرٌ لِتَنظُرَ ما جَنَت","بَرلينُ مِن حَدَثٍ عَميمِ المَأتَمِ",180,"م",1,0],["وتلاقى فوق الجحيم الفريقا","ن وهذا نارٌ وهذا نور",181,"ر",1,0],["وتلك أَيامي الأولى الَّتي اختلفت","مما أُقاسيه عن أَيامي الأخر",182,"ر",1,0],["وَتلك سليمى وَهي تومي لدلبرٍ","فخذها ورح يا موت إنك تقهر",183,"ر",1,0],["وَتلتدم البيض الحسان من الأسى","فترفضُّ في اللبات منها عقودها",184,"د",3,0],["وتلطمنا كف الإهانة منهم","فنلثمها من خشية ونقبل",185,"ل",1,0],["وتلهف وتأسف تبديهما","بحرارة من صدري الأعماق",186,"ق",1,0],["وتلك أحلام الهوى والسنين","يحملها التَّيار فوق النَّهَر",187,"ر",1,0],["وتلَقَّ من حكمِ الزمانِ وعدلِهِ","ما شاءَ من نقدٍ ومن إطراءِ",188,"ا",2,0],["وتلاقت عيونُنا فتدانتْ لي","وجُنَّ الحنانُ في شفتينا",189,"ن",2,0],["وتَلفُّتِ المتكبر الصَّلِفِ","عن ذِلَّةِ المقهور في الحربِ",190,"ب",1,0],["وتلحظُهم من وراءِ الحياةِ","بنفسٍ معذبةٍ والهه",191,"ه",2,0],["وتلاشى الصوتُ لا رجعَ صدىً","لا ولا ثمَّ مُجيبٌ لنداها",192,"ا",3,0],["وتَلفَّتتْ لكِ روحُهُ فتمثّلتْ","وجهَ البطولة في أرق ملامحِ",193,"ح",1,0],["وتلكَ قطوفُ النِّيل دانيةَ الجَنَى","أَم أن قطوفاً للرياضِ دواني",194,"ي",1,0],["وتلْكَ أمانيهِ على عَتباتهم","مطرَّحةٌ في ذِلَّةٍ وهوانِ",194,"ن",1,0],["وتلك أطماعهم في كلِّ ناحية","السيفُ منهن فوق الخلق قوَّامُ",195,"م",1,0],["وتلفتوا فإذا الخضمُّ سحابةٌ","حمراءُ مُطبِقةٌ على الأرجاءِ",196,"ا",2,0],["وتلفتوا لما بدا شَبَحُ","فنانةٌ دَلَفَتْ من البابِ",197,"ب",1,0],["وتلكَ أَضاةٌ صانَها المَرْءُ تُبَّع","وداودُ قَيْنُ السّابِغاتِ أذالَها",198,"ل",3,0],["وَتَلقاهُ مِن فِرطِ الصَبابَةِ جاهِلاً","يُغَيِّرُ أَعلى رَأسِهِ بِصَبيبِ",199,"ب",1,0],["وتلق منه جوهرا أو صائغا","وتسق في الفضة عذبا سائغا",200,"غ",2,0],["وَتِلكَ في مِصرَ عَلى حالِها","وَذاكَ رَهنُ المَوتِ وَالغُربَةِ",201,"ه",1,0],["وتلْمَحُ مِن جَوزائِها في غُرُوبِها","تَساقُطَ عَرْشٍ واهِن الدَّعْمِ مائِلِ",202,"ل",1,0],["وتَلاشَتْ في خِضَمِّ","الزَّمنِ الطَّاغي قواهْ",203,"ا",2,0],["وَتِلْكَ مِصْرُ الَّتِي أَفْنَى الْجِلادُ بِهَا","لَفِيفَ أَسْلافِكُمْ فِي الأَعْصُرِ الأُوَلِ",204,"ل",1,0],["وتُلَذ القِينَة السَّمْعَ","بِشَدْوٍ مَا أُحيلى",205,"ل",2,0],["وَتِلْكَ الشَّمَائِلُ لَمْ يُؤْتَهُنَّ","قَبْلَكَ إِلاَّ أَجلُّ سَلَفْ",206,"ف",1,0],["وَتَلْمَحُ العَيْنُ حُلَى نَفْسِهَا","أَزهَى وَأَبْهَى مِنْ حُلَى التِّبْرِ",207,"ر",1,0],["وَتَلْبَثُ كلُّ بَاسِقَةٍ","بِفيْيءِ ظِلهَا قَصْرَا",208,"ر",2,0],["وَتَلاَقَتْ وُجُوهُ رَبٍّ وَمَرْبُو","بٍ وَتالِي رُقىً وَصَالِي بَخورِ",209,"ر",1,0],["وَتَلَقَّ فِي دَارِ الخِلاَفَةِ مُشْرِفاً","مَا شِئْتَ مِنْ شَرَفٍ وَمِنْ إِكْبَارِ",210,"ر",1,0],["وَتُلْقِمُ المَصْنَعَ فِي قُرْبِهَا","نُفَايَةَ الطَّيِّبِ مِمَّا يُصَادْ",211,"د",1,0],["وَتَلقَها فِي نِعْمَةٍ","نُعْماً يَجِيءٌ بِلا عَدَدْ",212,"د",1,0],["وَتَلِجُّ فِي حَصْدِ الشَّبَابِ وَمَا بِهَا","رِفْقٌ بِمُحْتَلِمٍ وَلاَ بِمُرَاهِقِ",213,"ق",1,0],["وتِلْكَ الأُمِّ أَمْسَتْ لاَ","تُطِيقُ مِنَ الأَسَى نَهْضَا",214,"ض",2,0],["وَتلاَقِي أُولِي الإِمَارَاتِ عَقْلاً","وَنِجَاراً وَثَرْوةً فِي احْتِشَادِ",215,"د",1,0],["وَتَلَقَّ الْعَرُوسَ يُوفِدُهَا الْخِدْ","رُ إِلى الْقَصْرِ أَيَّمَا إِيفَادِ",215,"د",1,0],["وَتَلَقَّتْهُ الحَنَايَا هَابِطاً","مَهْبِطَ اليَقْظَةِ مِنْهَا وَالرَّجَاءْ",216,"ا",2,0],["وَتِلْكَ الْعُيونُ النَّاطِقَاتُ لِحَاظُهَا","بِأَجْلَى بَيَاناً مِنْ مَقَالَةِ قَائِلِ",217,"ل",1,0],["وتَلقَّيَا فِي بَعْلَبَكَّ مَحَبَّةً","وَكرَامَةً مِنْ أُمَّةٍ أَبْرَارِ",218,"ر",1,0],["وَتَلَقَّ النُّعْمَى بوَجْهٍ مُنيرٍ","فِيه سِيمَا تِلْكَ المَعَانِي الْجِيَاد",219,"د",1,0],["وَتَلاَ سَابِقيهِ بَاقٍ عَزِيزٌ","مِنْ رِفَاقٍ لِمُصْطَفَى وَفَرِيدِ",220,"د",1,0],["وتلاشى في شهور الحمل","قيصر الروس ولم يحلم بما",221,"م",2,0],["وتلوح آثار النعيم بخدها","كالفجر قبل تكامل الإشراق",222,"ق",1,0],["وتلهّى حيناً بسَقسقَةِ الماء","فكانت لشدوهِ أوتارا",223,"ر",2,0],["وتلاقت شفتانا في الضباب","كذب الواشي وخاب",224,"ب",1,0],["وتلفتت فيها الدمىو تساءلت","عن باقة في صحنها تتضوّع",225,"ع",1,0],["وتلفتت منها الدمى","بين افتراق واقترانْ",226,"ن",1,0],["وتلوح إحداهن ذاهلةً","مروّعة الجنان",226,"ن",1,0],["وتلملم الأحلام من صدر الدّجا","سردا كأشباح الدجا السوداء",227,"ا",2,0],["وتلملمت تحت الظلام كأنّها","شيخ ينوء بأثقل الأعباء",227,"ا",2,0],["وتلمَحُ الأفْقَ هل بالأفْقِ من نبأٍ","وهل من الدهر إنجازٌ لموعودِ",228,"د",1,0],["وتلاقَى مجدٌ بناه بنو الني","لِ ب