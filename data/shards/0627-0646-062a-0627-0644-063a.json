{"poems":[[74,"قاسي الجوانح لين الأعطاف","https://www.aldiwan.net/poem19257.html","الكامل"],[74,"أوجز مديحك فالمقام عظيم","https://www.aldiwan.net/poem19667.html","الكامل"],[93,"كم تشتكي وتقول إنك معدم","https://www.aldiwan.net/poem62676.html","عموديه"],[87,"قصر الأعزة ما أعز حماكا","https://www.aldiwan.net/poem7925.html","الكامل"],[45,"ذكر الصبى ومراتع الآرام","https://www.aldiwan.net/poem10528.html","الكامل"],[52,"يا صاح بين حاجتي","https://www.aldiwan.net/poem63885.html","مجزوء الكامل"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/50069","البسيط"],[87,"قصرَ الأعزة ِ، ما أعزَّ حماكا‍!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9733&r=&rc=223",""],[132,"أنت الحبيب المرتضى ولك الهنا","https://www.aldiwan.net/poem50490.html","الكامل"],[132,"حي المعاليم والرسوما","https://www.aldiwan.net/poem50515.html","مجزوء الكامل"],[132,"هنيت بالنصر موعودا لك الظفر","https://www.aldiwan.net/poem50605.html","البسيط"],[164,"قطع الزمان يمينه بيمينه","https://www.aldiwan.net/poem58715.html","الطويل"],[164,"أرخا أثيث الدجى الجاني على الفلق","https://www.aldiwan.net/poem59000.html","البسيط"],[189,"بجلال قدرك تفخر الأزمان","https://www.aldiwan.net/poem14677.html","الكامل"],[189,"لا أظلم البين حالي كالذي كانا","https://www.aldiwan.net/poem14679.html","البسيط"],[192,"اصعد بعزمك إن المجد متصل","https://www.aldiwan.net/poem35678.html","الكامل"],[240,"أهلا بطلعة زائر","https://www.aldiwan.net/poem31608.html","مجزوء الكامل"],[240,"الدست من لألاء وجهك مشرق","https://www.aldiwan.net/poem31812.html","الكامل"],[264,"يا من يغيث الورى من بعد ما قنطوا","https://www.aldiwan.net/poem35529.html","البسيط"],[309,"ما في الوجود ولا في الكون من أحد","https://www.aldiwan.net/poem16764.html","البسيط"],[309,"يا ظبي عيد ما في الحسن لك ثاني","https://www.aldiwan.net/poem16834.html","البسيط"],[447,"سعدي ونحسي بأحكام القضا سبقا","https://www.aldiwan.net/poem14290.html","البسيط"],[447,"لولا مخافة بيع قائد الغبن","https://www.aldiwan.net/poem14431.html","البسيط"],[473,"يا من للقياه نقش من بشاشته","https://www.aldiwan.net/poem59839.html","البسيط"],[567,"إن لم لك يكن في نقد الرجال يد","https://www.aldiwan.net/poem52863.html","البسيط"],[567,"أسفا لمن قد مات قبل مماته","https://www.aldiwan.net/poem52864.html","الكامل"],[580,"سافر فوجه العيد سافر","https://www.aldiwan.net/poem3070.html","مجزوء الكامل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110432","الكامل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34427","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64075","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56258","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136184","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84482","البسيط"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18482","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48962","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77972","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108683","الكامل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132275","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69410","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69343","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77261","الكامل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67196","البسيط"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106899","الكامل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126233","الكامل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104684","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65102","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87376","الكامل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86296","المجتث"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46025","البسيط"],[3768,"","https://poetry.dctabudhabi.ae/diwan/poem/130420","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/136045","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102934","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123512","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133072","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133149","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133162","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133090","الكامل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35445","الكامل"],[4691,"منك الأنوثة تقطر","https://www.poetsgate.com/ViewPoem.aspx?id=61787",""],[4760,".. مد يمناك..","https://www.poetsgate.com/ViewPoem.aspx?id=32020",""],[4765,"فرعون الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=215674",""],[4978,"أحمد الدقاسمة","https://www.poetsgate.com/ViewPoem.aspx?id=188844",""],[5111,"مَعَارِيجُ الرُّؤَى","https://www.poetsgate.com/ViewPoem.aspx?id=212631",""],[5136,"شكري لما أوليت من بري","https://www.poetsgate.com/ViewPoem.aspx?id=121589",""],[5198,"المسافة","https://www.poetsgate.com/ViewPoem.aspx?id=145107",""],[5277,"أغنية الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=185432",""],[5277,"بغداد ..مفتاحُ القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=191008",""],[5277,"وقفةٌ على الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=191198",""],[5277,"للهِ درُّ غزالي","https://www.poetsgate.com/ViewPoem.aspx?id=193453",""],[5277,"سيدةُ العواصم","https://www.poetsgate.com/ViewPoem.aspx?id=198365",""],[5363,"اللهُ يا أللهُ اللهُ","https://www.poetsgate.com/ViewPoem.aspx?id=199946",""],[5365,"أشواق","https://www.poetsgate.com/ViewPoem.aspx?id=191264",""],[5431,"علّ القلوب من السماحة تلبسُ","https://www.poetsgate.com/ViewPoem.aspx?id=191469",""],[5431,"والحب لا يتقسمُ ...","https://www.poetsgate.com/ViewPoem.aspx?id=198932",""],[5442,"يامن إليه بعزه اتشفع","https://www.poetsgate.com/ViewPoem.aspx?id=114749",""],[5459,"ماذا ادّخرتَ..؟","https://www.poetsgate.com/ViewPoem.aspx?id=208843",""],[5605,"رحلة عابر","https://www.poetsgate.com/ViewPoem.aspx?id=159458",""]],"verses":[["أنت الغياث إذا الغمائم أخلفت","وعد الثرى بالدّرّ في الأخلاف",0,"ف",1,0],["أنت الغياث إذا الصحائف نشرت","وبدا جنا الجنَّات والزَّقوم",1,"م",1,0],["أَنتَ الغَنِيُّ إِذا ظَفِرتَ بِصاحِبٍ","مِنهُم وَعِندَكَ لِلعَواطِفِ مَنجَمُ",2,"م",1,0],["أَنتَ الغَنِيُّ عَنِ الثَناءِ فَإِن تُرِد","ما يُطرِبُ المَلِكَ الأَديبَ فَهاكا",3,"ك",2,0],["أَنتَ الغَريبَةُ في زَمانٍ أَهلُهُ","وُلِدَت مَكارِمُهُم لِغَيرِ تَمامِ",4,"م",1,0],["أَنتَ الغِنى لَولا مِطا","لُكَ وَالمِطالُ مِنَ الكِيادِ",5,"د",1,0],["أنت الغَمامُ الذي تُخشى صواعقُه","إذا تَنمَّرَ أو تُرجى مواهبُه",6,"ب",2,0],["أنتَ الغنيُّ عن الثناِ، فإن تردْ","ما يُطربُ الملكَ الأَديبَ فهاكا",7,"ك",2,0],["أنتَ الغنىُّ ولَنْ ترَى مُتَواضِعاً","وأنا الفقرُ وليسَ لِي عنكم غِنَى",8,"ن",2,0],["أنْتَ الغريمُ على الغرا","مِ وأنتَ قد صرتَ المُليما",9,"م",2,0],["أنت الغنىُّ عن الأملاك كُلهمُ","وكل حَيٍّ إليك الدهرَ يفتَقرُ",10,"ر",1,0],["أنت الغني بحلمه وبعلمه","بالدهر في حركاته وسكونه",11,"ن",2,0],["أنت الغنى وما بالكل عنك غني","فارحم مواليك وأنقذهم من الغرق",12,"ق",1,0],["أنتَ الغريبُ الفضلِ معْ ما أنه","لولاك لم يَتعرَّفِ العِرفان",13,"ن",1,0],["أنت الغمامُ وروضى زاهر فإذا","أَغبَّه فكنْ باب سَعْدِي عند مولانا",14,"ن",2,0],["أنْتَ الغَضوبُ إذا ما مُهْجَةٌ ظُلِمَت","أنت الثَّباتُ إذا ما زاغَتِ المُقَلُ",15,"ل",1,0],["أَنتَ الغِياثُ لِأُمَّةٍ","فَرَّجتَ مِن غَمائِها",16,"ا",3,0],["أَنتَ الغَمامُ الجونُ فيهِ صَواعِقٌ","تُردي العَدُوَّ وَفيهِ غَيثٌ مُغدِقُ",17,"ق",1,0],["أنت الغياث وأنت المستغاث به","ارحم عبيداً أكفّ الفقر قد بسطوا",18,"ط",3,0],["أَنتَ الغَني عَنِ الأَمثالِ وَالشَرَكا","أَنتَ المُقَدَّسُ عَن زَوجٍ وَعَن وَلَدِ",19,"د",1,0],["أَنتَ الغِياثُ لِمَن ضاقَت مَذاهِبَهُ","وَمَن أَلَمَّ بِهِ خَطبٌ مِنَ الكَنَدِ",19,"د",1,0],["أنت الغياث لنا في كل نائبة","بعد الإله وطه خير عدنان",20,"ن",1,0],["أنت الغني ومحتاج إليك أنا","على الضعيف ببسط أمر تقا",21,"ق",2,0],["أَنت الغني ومنك الفقر يطلبني","أَنا الفقير وباللَه العظيم غني",22,"ن",2,0],["أَنتَ الغَمامَ الَّذي يَمضي بِوابِلِهِ","يَهُزُّ عَطفَيهِ بَينَ النَورِ وَالوَرَقِ",23,"ق",1,0],["أنتَ الغريبُ ومَنْ لي أن يكُونَ لنا","غرائبٌ في أساليبَ الرِّثا جُدُدُ",24,"د",1,0],["أنتَ الغريبُ كما نَرَاكَ وهكذا","شَمْلُ الغريبِ يكونُ قُرْبَ شتاتِه",25,"ت",2,0],["انت الغفورلكلِّ ها","فٍ والمُقيلُ لِكُلِّ عَاثِر",26,"ر",1,0],["أنتِ الغريبةُ في الجمَال وهكَذَا","في أَرض مصر غريبةٌ تحت الثرَى",27,"ر",2,0],["أَنتَ الغرورُ الَّذي بالدّين غَرَّ فَتىً","لَولاهُ ما كنت في دُنياه تَنتشِبُ",28,"ب",1,0],["أنتَ الغزالُ غزالُ الإنسِ زيَّنهُ","دلٌّ وتَرَّفه شكلٌ وفنَّقه",29,"ق",2,0],["أنت الغنى والمنى والفوز أجمعه","والعون والغوث والانجادُ والمددُ",30,"د",1,0],["أنت الغياث لمن ضاقت مذاهبه","وخير من يرتجي في العسر والير",31,"ر",1,0],["أَنتَ الغِنَي وَكُلُّ الناسِ سائِلَة","وَهَل سوى باعِث الأَرزاقِ مَسئولُ",32,"ل",1,0],["أَنتَ الغُرورَ إِذا خُبِرتَ وَرُبَّما","كانَ الغرورُ لِمن رَجاهُ شافِيا",33,"ي",2,0],["أَنتَ الغزالةُ في الضحى","والنارُ شُقتْ من سَناك",34,"ك",1,0],["أَنتَ الغَريب بأَرضنا إِذ لَم يكن","أَحَداً كمثلك طيب الأَعراق",35,"ق",1,0],["أنت الغزالة في الدجى","يكفيك أنك نادر",36,"ر",1,0],["أنت الغياث أغث أنت الغياث أغث","وفرج الكرب إني ضاقت أحوالي",37,"ل",2,0],["أَنتَ الغَمامُ وَما لِي بِالغَمامِ يَدٌ","أَعُدُّهُ وَهوَ جَمُّ الوَبلِ مُنحَدِرُ",38,"ر",1,0],["أَنتَ الغَمامُ الَّذي يَهمي بِلا ضَجَرٍ","أَنتَ الجَوادُ الَّذي يُعطي بِلا بُخُلِ",39,"ل",1,0],["أَنتِ الغَريبَةُ الحِسانِ وَطالِبٌ","طَلَبَ الهَوى مِن ناظِرَيكِ فَأخفَقا",40,"ق",2,0],["أنتَ الغَياثُ ونِعم المُستغاثُ لنا","غَداةً تلتفُّ منّا الساقُ بالسّاق",41,"ق",1,0],["أنت الغنيُّ وقد حويت جواهراً","فاقت كنوز الدر والمرجان",42,"ن",1,0],["أنت الغَفُورُ لكّلِ عبدٍ جَائياً","ندماُ على ذلاته مُتّباكِياً",43,"ي",2,0],["أنت الغني عن العباد جميعهم","أوجدتهم ومددتهم بغناء",44,"ا",2,0],["أنت الغياثُ للهب المستغيث بك","إذ أخلف الغيثُ أو ليلُ الخطوب دجى",45,"ج",2,0],["انتَ الغصين نشا ولكن ما نَما","كيما يُعَدَّ بجملة الاغصانِ",46,"ن",1,0],["اِنتَ الغَفورُ إِلى مَن","خاضَ المَعاصي شَقِيّا",47,"ي",2,0],["أَنتَ الغَنِيُّ وَلكِن غَيرُ مُغتَفَرٍ","لمحرِزِ الدُرِّ كُفرانٌ بِمُنعمِهِ",48,"م",2,0],["أنت ألغزت في اسم ذات رقاع","لم تجاهد وكم غدت في رباط",49,"ط",1,0],["أنت الغفورُ فاغفرنْ ذُنوبنا","إنا عبيدٌ فاعفونْ يا ربَّنا",50,"ن",2,0],["أنت الغياث إذا النفوس تحشرجت","بمصعد من كربها ومصوب",51,"ب",1,0],["أنت الغياث اذا ما بالعيان رأوا","طرف المخاوف فيهم ناظرا يقظا",52,"ظ",2,0],["أنت الغفور مجيب السائلين فجد","يا مالك الملك وهاب العطيات",53,"ت",1,0],["أنت الغياث لنا في كل نائبة","يا رب غثنا وأصبحنا ونادينا",54,"ن",2,0],["أنت الغياث فلا ملجا سواك لنا","يسر لنا الأمر أعط النفس مأمولها",55,"ه",2,0],["أنت الغياث الملتجا مولانا","ثم الصلاة على النبي ذا الأكمل",56,"ل",1,0],["أَنتَ الغَنيُّ عَنِ العَبيدِ جَميعِهِم","وَأَنا لِفَضلِكَ أَفقَرُ الفُقَراءِ",57,"ا",2,0],["أنت الغناء ورجعه","أنت الظما والكوثرُ",58,"ر",1,0],["إنت الغلا كله وأنا كلي أهواك","أنسى جميع الخلق ولا انت أغليك",59,"ك",1,0],["أنتَ الغثاءُ ، ونحنُ الماءُ يسْحَقُهُ","مثلَ الجُفَاءِ ، ويَسْقي الأرضَ والزَّرْعَا",60,"ع",2,0],["أنت ألغيت حدودا خطها","بيننا سيكيسُ، قد جاء فريّا",61,"ي",2,0],["أنْتِ الْغِيَابُ يَشْجُو وَجْدَهُ مَضَضًا","مِلْءَ الْمَدَى بِفَمِيْ يَذْكُو فَيَخْتَنِقُ",62,"ق",1,0],["أنت الغمام الجون لو هطلت","وطف الغمام بخالص التبر",63,"ر",1,0],["انت الغلا شكله ولونه ومعتاه","انت البشاشة والشعر والتعاليل",64,"ل",1,0],["أنت الغرامُ وفيك الحسن يشتملُ","وأنت خيمةُ أهلي حيث تنتقل",65,"ل",1,1],["أنت الغرام على الصوبين أحمله","لكن دجلة من احبابه وشلُ",66,"ل",1,0],["أنت الغرامُ وفيك الحسنُ مشتملُ","وأنت خيمةُ أهلي حيثُ تنتقلُ",67,"ل",1,0],["أنتِ الغزالُ شروداً عن منازلهِ","لله درُّ غزالي حيثما شردا",68,"د",2,0],["أنت الغرامُ وفيك الحسن يشتعل","وأنت خيمةُ أهلي حيث تنتقل",69,"ل",1,1],["أنتَ الغنيُّ ولا تضيرُكَ فِعْلتي","وأنا الفقيرُ إليكَ يا أللهُ",70,"ل",2,0],["أنت الغديرُ الّذي إن جِئْتُهُ ظَمِئَاً","منهُ الفُؤادُ تَلَظّى كلّما وَردا",71,"د",2,0],["أنت الغمام ومهجتي بك ترتوي","مازلت أعطش من ضبابك ألبسُ",72,"س",1,0],["أنت الغرام حقيقةً","حيثُ الحياة توهّمُ",73,"م",1,0],["أنت الغني وكل من في الكون من","مثر فقير نحو فضلك مدفع",74,"ع",1,0],["أنتَ الغريقُ المطمئنُّ..","لحتفهِ ألقى حباله ..",75,"ل",2,0],["أنت الغني فقيرًا.. لو أراد بكم","رب السمواتِ لا يَبْقِيْ ولا يَذَرُ",76,"ر",1,0]]}