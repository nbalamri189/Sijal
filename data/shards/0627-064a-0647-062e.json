{"poems":[[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141933","الكامل"],[92,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122787","البسيط"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121149","الكامل"],[4625,"","https://poetry.dctabudhabi.ae/diwan/poem/124117","الكامل"],[6031,"جَذَّ الردَى سَبَبَ الإسلامِ فَانْجذَمَا","https://www.poetsgate.com/ViewPoem.aspx?id=46278",""]],"verses":[["إيه خيال الماني طيب الكرى","أيتاح لي رجعي مع الورّادِ",0,"د",1,0],["ايه خصمَ الملوك حتى يُقيموا","لك أمثولةَ النظيرِ المُزاحِم",1,"م",1,0],["إيهٍ خَلائفَ مُوسَى إنَّ مَورِدَها","حِليُ بنِ يَعقُوبَ لا مِصرٌ وَلا عَدَنُ",2,"ن",1,0],["إيه خليف المكرما","تِ وموئل الأدب الشهير",3,"ر",1,0],["ايه خليلي إن رأيت وإن ترى","والأمر في كل الورى معلوم",4,"م",1,0],["إيهٍ خَليليَّ قُومَا واسْعِدَا دَنِفاً","أصَابَ أَحْشاهُ رَامي الحُزْنِ حِينَ رمَى",5,"م",2,0]]}