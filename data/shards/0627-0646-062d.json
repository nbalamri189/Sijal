aldiwan.net/poem22434.html","البسيط"],[46,"منازل المجد من سكانها دثر","https://www.aldiwan.net/poem22540.html","البسيط"],[46,"وفر هذا الفتى مديد بسيط","https://www.aldiwan.net/poem23155.html","الخفيف"],[46,"غير مجد في ملتي واعتقادي","https://www.aldiwan.net/poem23625.html","الخفيف"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85593","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85826","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85598","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85528","البسيط"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20249","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42511","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42707","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54831","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54559","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55169","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54641","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54194","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54196","الكامل"],[106,"حفل المولد","https://www.poetsgate.com/ViewPoem.aspx?id=179555",""],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[106,"الوحدة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=179293",""],[90,"كذب الخائفون","https://www.poetsgate.com/ViewPoem.aspx?id=179012",""],[45,"لله عَهْدُ سَوِيقَةٍ ما أنْضَرَا،","https://www.poetsgate.com/ViewPoem.aspx?id=31338",""],[45,"يا حُسنَ مُبدي الخَيلِ في بكورِها","https://www.poetsgate.com/ViewPoem.aspx?id=31191",""],[101,"لاَ الدَّمعُ غاضَ وَلا فُؤادُكَ سَالى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62411&r=&rc=3",""],[87,"وَمَسْرَحٍ لِسِوَامِ الْعَيْنِ لَيْسَ لَهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23938&r=&rc=200",""],[87,"في قائمِ السيفِ إنْ عزَّ الرضا حكمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23848&r=&rc=110",""]],"verses":[["إِن حُرِمتَ الرِزقَ الَّذي نالَ مِنهُ","فَدَواءُ العَيِيِّ داءُ الحَصيفِ",0,"ف",1,0],["إِن حافَ لي دَهرٌ عَلَيكَ فَطالَما","مالَ الزَمانُ عَلَيَّ فيكَ وَحافا",1,"ف",2,0],["أَنحَلَهُ الخَوفُ وَخَوفُ الفَتى","سَيفٌ عَلى مَفرِقِهِ مُنتَضى",2,"ض",2,0],["إِن حَلَّ بيداً فَالخَلاءُ مَحافِلٌ","أَو قادَ خَيلاً فَالسُروجُ مَنابِرُ",3,"ر",1,0],["أَنحَلَني فيها طِلابُ العُلى","وَذاكَ فَخري عِندَ أَندادي",4,"ي",1,0],["إِن حَنَّتِ النيبُ شَوقاً وَهيَ واقِفَةٌ","فَإِنَّ عَزمِيَ مُشتاقٌ إِلى النيبِ",5,"ب",1,0],["إنْ حارَبوا أرْضى السّيوفَ سُخْطُهُمْ","أو سالَموا شَدّوا على الحِلْمِ الحُبا",6,"ا",1,0],["أَنحَلَ جِسمي وَبَرى أَعظُمي","لَذعُ حَراراتِ فِراقِ الحَبيب",7,"ب",1,0],["أَنْحَى عَلَى وَفْرِي وَرَوَّعَ مَأْمَنِي","ظُلْماً وَحَمَّلَنِي الَّذِي لاَ يُحْمَلُ",8,"ل",1,0],["أَنْحَى عَلَى الأَبِ وَالشَّقِيقِ فَغُيِّبَا","عَنِّي فَحَالِي بَعْدَهُمْ لاَ تَسْأَلِ",9,"ل",1,0],["أَنحى عَلى الأَدَبِ الشَرقِيِّ مُفتَرِياً","عَلَيهِ ما شاءَ مِن زورٍ وَبُهتانِ",10,"ن",1,0],["أَنحى عَلى سَردِ النَعالِ فَخلتُهُ","بَدراً يَصوغُ مِنَ الأَهِلَّةِ أَنجُما",11,"م",2,0],["أَنَ حَيرانٌ وَلِلأَمرِ","وُضوحٌ وَاِلتِباسُ",12,"س",1,0],["أَنَحنَ القُرونَ فَغَلَّلنَها","كَعَقلِ العَسيفِ غَرابيبَ ميلا",13,"ل",2,0],["إن حارت الشهبُ ليلاً في مقَّلده","فصبح غُرَّته بالنور يَهديها",14,"ي",3,0],["أن حياة المرء ما عاش ترى","أحوالها مختلفات في الرؤى",15,"ا",1,0],["انحت حتى رثى العدو لحالي","واعتراني من العويل بحاح",16,"ح",1,0],["أنحمل منك اليوم عبء تحكُّم","وندفع فيه الأجر منّا وننقد",17,"د",1,0],["إن حبّ الحياة أوهم أن ال","موت نوم تحت الثرى لا يطول",18,"ل",1,0],["إِن حَرَّموكَ لَتَحرُمَنَّ عَلى العِدى","أَو حَلَّلوكَ لَتُؤكَلَنَّ حَلالا",19,"ل",2,0],["إِنَّ حُبَّ الصِبا وَإِن طالَ لايَق","دَحُ فيهِ عَلى الدُهورِ دُثورُ",20,"ر",1,0],["إنْ حدّثت بك حالتي عن واصلٍ","فلقد تحدّث مهجتي عن جابر",21,"ر",1,0],["أنح جناب الوزير منتصراً","فإنه جابرٌ لما كسرا",22,"ر",2,1],["إن حرمت القليل من مالِ بيرو","ت على فاقتي فليسَ كثيرا",23,"ر",2,1],["إن حدَّثتهم بأخبار الأسى فما","قد أخرجت ليَ منهم أيّ أثقال",24,"ل",1,0],["أنحى بني العلياء في حالاتهم","فالقدر يرفع والأوامر تجزم",25,"م",1,0],["إن حكت عيناك لي جسداً","فلقد حاكت على السقم",26,"م",1,0],["أنْحتْ على حظِّي بمِبْرَاتِهَا","شكراً لأني كنتُ أرهَفْتُهَا",27,"ت",3,0],["إن حُرِّمَتْ فَبِحقِّهَا من حُرَّةٍ","ما كانَ مثْلُ حريمها بمباحِ",28,"ح",1,0],["إن حرمانَك مَنْ لم","تحرمِ العافينَ قبلَهْ",29,"ل",2,0],["أَنحى إِلَيهِنَّ عَيناً غَيرَ غافِلَةٍ","وَطَعنَ مُحتَقِرِ الأَقرانِ كَرّارِ",30,"ر",1,0],["إِن حَنى الدَهرُ قامَتي","وَمَحا الشَيبُ أَسوَدي",31,"ي",1,0],["إِن حازَ بَعضُ الناسِ سَهماً في العُلى","فَلَهُم ضُروبٌ لا تُعَدُّ وَأَسهُمُ",32,"م",1,0],["إِنَّ حَيّاً يَهابُ أَن يَلمُسَ النورَ","كَمَيتٍ في ظُلمَةِ الأَكفانِ",33,"ن",1,0],["إِن حَدَثوكَ عَنِ النَعيمِ فَأَطنَبوا","فَاِشتَقتُهُ لا تَنسَ أَنَّكَ فيهِ",34,"ي",2,0],["إِنَّ حالاً أَنتَ مِنها","في قِيامٍ وَقُعودِ",35,"د",1,0],["أنحنُ أعداءُ مصرٍ فالبقاء لكم","إذا مضى عهدُنا في مِصرَ أو ذهبا",36,"ب",2,0],["إِن حالَ ما بَينَنا رَيحانُنا الناظِر","فَناظرُ القَلبِ حَقا نَحوَكُم ناظِرْ",37,"ر",1,0],["أنحى على الحق المبين يهيته","ناس خلوا من شيمة الانصاف",38,"ف",1,0],["أنحن فوق ارضنا","ام في السماء الزاهره",39,"ر",2,0],["انحى عليه يدوسه","ولقد اناخ بكلكل",40,"ل",1,0],["ان حرية الشعو","ب لمن اكبر النعم",41,"م",1,0],["إن حل في أرض فإنّ","الجور عنها زائل",42,"ل",1,0],["اِنحِسارُ الشِفاهِ عَن سِنِّ جَذلا","نَ وَراءَ الكَرى إِلى سِنِّ نادِم",43,"م",1,0],["إِن حَدَّثوا نَطَقوا بِخُرسِ كَتائِبٍ","أَو خوطِبوا سَمِعوا بِصُمِّ رِماحِ",44,"ح",1,0],["أَنْحَلَ الوَجْدُ جِسْمَهُ والحنينُ","وبَراهُ الهَوَى فما يَسْتَبِينُ",45,"ن",1,1],["إِن حَلَّ فارَقَتِ الخَزائِنُ مالَهُ","أَو سارَ فارَقَتِ الجُسومُ الروسا",46,"س",2,0],["إِن حَلَّ في فُرسٍ فَفيها رَبُّها","كِسرى تَذِلُّ لَهُ الرِقابُ وَتَخضَعُ",47,"ع",1,0],["أنحَى الكُسوفُ على الهِلالِ المجتلى","وأجرَّ شِقشقة الخطيب المِصْقَعِ",48,"ع",1,0],["أنحَى على ضَعْفِي بقوَّتِهِ","وسطَا على عَجْزِي بقدرتِهِ",49,"ت",2,0],["أنحَتْ عليَّ بلومها ولقد دَرَتْ","أنِّي على عَجْمِ الزمانِ صليبُ",50,"ب",1,0],["أَنحَيتَ كَي تُنفِقَها زارِياً","عَلى عَلِيِّ بنِ أَبي طالِبِ",51,"ب",1,0],["إِن حُصِّلَ الناسُ في فِعالِهِمِ","كُنتَ الَّذي أَصطَفي وَأَنتَخِبُ",52,"ب",1,0],["إِن حَزَّ طَبَّةَ غَيرَ مُخطِئِ مَفصِلٍ","أَو قالَ أَنجَحَ أَو تَدَفَّقَ أَغزَرا",53,"ر",2,0],["إِن حاذَروا النَبوَةَ مِن نُفورِها","أَهوَوا بِأَيدِهِم إِلى نُحورِها",54,"ر",3,0],["إِنَّ حَقّي رَغبُ النَوالِ وَحَقُّ ال","ناسِ أَن أَسلُكَ القَريضَ سَبيلَه",55,"ل",2,0],["إِنَّ حُبَّ الصُلعانِ يُبدي مِنَ المَر","ءِ لِأَهلِ التَكشيفِ أَمراً فَظيعا",56,"ع",2,0],["إن حبي للأرض حبٌ بصيرٌ","وهواهم عواطفٌ عمياء",57,"ا",2,0],["إن حلَّ فهو من الجلالةِ مَحفِلٌ","أو سار فهو من الشَّهامةِ جَحفَلُ",58,"ل",1,0],["أنحى على الشرك حتى ذل جانبه","وانهد غاربه الأعلى وكاهله",59,"ل",2,0],["إن حَلَّ حلَّ به السُّرو","ر مُخيِّماً أو سارَ سارا",60,"ر",2,0],["إن حَلَّ أوطنَ في صُدورِ رُواتِه","أو سارَ شَرَّقَ في البلادِ وغرَّبا",61,"ب",2,0],["إِن حَلَّ حَلَّ النَهبُ في أَركانِهِ","أَو سارَ سارَ الخُلفُ في الأَعداءِ",62,"ا",2,0],["إِن حَلَّ أَرضَ أُناسٍ شَدَّ أَزرَهُمُ","بِما أَتاحَ لَهُم مِن حَطِّ وِزرِهِمِ",63,"م",1,0],["إِن حاوَلَ الضَيفُ أَن يُلِمَّ بِهِ","أَعطاهُ مِن قَبلِ نُطقِهِ القَطنَه",64,"ن",2,0],["إِنَّ حَمّامَكَ قَد ضَ","مَت حَميماً وَحِماما",65,"م",2,1],["أَنحَلتِني بِالصُدودِ مِنكِ فَلَو","تَرَصَّدَتني المَنونُ لَم تَرَني",66,"ي",1,0],["إِنَّ حَواسي الخَمسَ مُذ غِبتُمُ","إِلَيكُمُ في غايَةِ الشَوقِ",67,"ق",1,0],["إِن حُكِّموا عَدَلوا أَو أُمِّلوا بَذَلوا","أَو حورِبوا قَتَلوا أَو غولِبوا غَلَبوا",68,"ب",3,0],["إن حبي إليكَ بالصفحِ سَبَّا","قٌ وقلبي إلَيكَ مهما أُصيبَا",69,"ب",2,0],["إن حان لحنُ الختام","صار النشيد دعاء",70,"ا",2,1],["إنَّ حُسْنَ الثناءِ بعدك يَبْقَى","لك بالذكرِ منه عيشٌ مُكَرَّرْ",71,"ر",1,0],["أَنحَفتَ جِسمَكَ حَتّى لَو هَمَمتُ بِأَن","أَلهو بِصَفعِكَ يَوماً لَم تَجِدكَ يَدي",72,"ي",1,0],["إِنَّ حُزني عَلَيكَ لَيسَ عَلَيكا","بَل عَلى مُهجَةٍ تَسيلُ لَدَيكا",73,"ك",2,1],["إِن حَنَّ نَجدٌ وَأَهلوهُ إِلَيكَ فَقَد","مَرَرتَ فيهِ مُرورَ العارِضِ الهَطِلِ",74,"ل",1,0],["إِنَّ حُوَيّاً حاجَتي فَاِقضِها","وَرُدَّ جَأشَ المُشفِقِ الجازِعِ",75,"ع",1,0],["إِن حَنَّ هَذا غَراماً أَو دَعا طَرَباً","بِاسمِ الهَديلِ أَجابَت تِلكَ بِالنَّغَمِ",76,"م",1,0],["إِنْ حَدَّثُوا مَلأُوا الأَسْمَاعَ مِنْ أَدَبٍ","هُمْ أَهْلُهُ وَإِذَا مَا أَنْصَتُوا فَقِهُوا",77,"ه",3,0],["إِنْ حَارَبُوا مَعْشَرَاً فِي جَحْفَلٍ غَلَبُوا","أَوْ خَاصَمُوا فِئَةً فِي مَحْفِلٍ خصمُوا",78,"م",3,0],["إنَّ حزناً في ساعةِ العزلِ أضعا","فُ سرورٍ في حالةِ التقليدِ",79,"د",1,0],["أنحلَتْني حبيبتي","أنحلَ اللهُ خصرَها",80,"ه",2,1],["إِنَّ حُبّي آلَ لَيلى قاتِلي","ظَهَرَ الحُبُّ بِجِسمي وَبَطَن",81,"ن",1,0],["أنحن قتلنا الرئيسَ الجليلَ","غداةَ هوى نجمُه الآفلُ",82,"ل",1,0],["أَنحنُ بنو القومِ الأُلىَ زَلزلوا الدُّنَى","وثَلّوا العُروشَ الشُّمَّ أم نحن نكذبُ",83,"ب",1,0],["أَنحى عَلى المُلكِ الشَريدِ بِنَكبَةٍ","تَرَكت مَغاني مُلكِهِ أَطلالا",84,"ل",2,0],["أَنَحنُ الجاهِلونَ كَما زَعَمتُم","مَعاذَ اللَهُ مِن جَهلٍ وَحُمقِ",85,"ق",1,0],["أَنَحنُ الخائِنونَ كَما اِدَّعَيتُم","بِأَيَّةِ شيمَةٍ وَبِأَيِّ خُلقِ",85,"ق",1,0],["إِنَّ حِلمي إِذا تَغَيَّبَ عَنّي","فَاِعلَمي أَنَّني كَبيراً رُزيتُ",86,"ت",1,0],["إِن حارَبَ الدَهرُ قَلبي","فَقَد أَعيَنَ بِنَصرِ",87,"ر",1,1],["إنّ حَلْقَ الذَّقْنِ خيرٌ لِلفَتَى","يا بَنِي الأَعْمَامِ مِنْ أنْ تُنتَفا",88,"ف",2,0],["أنحَى لهمْ خَطّيَّةُ فتَهافَتَتْ","مُهَجاتُهُمْ تَستَنُّ من مَسنونه",89,"ن",2,0],["أَنحَلَني الحُبُّ فَأَص","بَحتُ شَبيهَ القَصَبَه",90,"ب",2,0],["إِنَّ حَياةَ الكَلبِ في وَفاتِها","حَتّى تَرى القِدرَ عَلى ميقاتِها",91,"ت",3,0],["أَنحَلَت جِسمَهُ الحَوادِثُ حَتّى","كادَ عَن أَعيُنِ الحَوادِثِ يَخفى",92,"ف",2,0],["إِنَّ حَمّادَ عَجرَدٍ","إِن رَأى غَفلَةً هَجَم",93,"م",1,0],["إِنَّ حُبّى بِحُبِّها","تَرَكَتني مُسَهَّدا",94,"د",2,0],["إِنَّ حُبّى سَحَرَتني","بِالأَماني وَالعِداتِ",95,"ت",1,0],["إِن حَرَّقوهُ فَما يَخشَونَ مِن ضَبُعٍ","تَسري إِليهِ وَلا خَفيٍّ وَتَطريحِ",96,"ح",1,0],["أَنُحتُ جَهلاً وَقَد ناحَت مُطَوَّقَةٌ","مِنَ الحَمامِ عَلى خَضراءَ مَقلودَه",97,"د",2,1],["أَنَحنُ أَفضَلُ أَم أَشياءُ جامِدَةٌ","أَضحَت سَواءً لَدَيها العَينُ وَالأَثَرُ",98,"ر",1,0],["إِن حَباكَ القَديرُ كَالنيلِ تِبراً","فَليُغِضهُ العَطاءُ وَالتَنويلُ",99,"ل",1,0],["إنّ حُزْناً في ساعةِ المَوْتِ أضْعَا","فُ سُرُورٍ في ساعَةِ الميلادِ",100,"د",1,0],["أنحَلَتْ جسمي نُحُولاً خَصْرُها","منه حالٍ فهْوَ أبْهَى حُلّتيَ",101,"ي",1,0],["إن حبي لمن أفارق فيها","يَتَجلى في دَمعيَ المهراق",102,"ق",1,0],["إن حيي العلم في أناس","من ذاته هذه",103,"ه",1,0],["أَنحى يسب وَلَم يستَحي من أَدَبي","ولا من الشيب في فوديّ يشتعل",104,"ل",1,0],["أنحى على الشعر ناس يبتغون له","نقداً فأعوزهم علم وعرفانُ",105,"ن",1,1],["إِنَّ حَقَّ الضَريرِ عِندَ ذَوي الأَب","صارِ حَقٌّ مُستَوجِبُ التَقديسِ",106,"س",1,0],["إن حاد في الكرب الكماة لم يحد","قد علمت ذاك حنينٌ وأحد",107,"د",1,0],["إِنْ حَلَّ أَرْضاً حَمَى بِالسَّيْفِ جَانِبَهَا","وإِنْ وَعَى نَبْأَةً مِنْ صارِخٍ رَكِبَا",108,"ب",2,0],["أَنْحَى فَأَقْصَدَهُ الزَّمَانُ بِسَهْمِهِ","إِنَّ الزَّمَانَ لَنَابِلٌ مِيفَاقُ",109,"ق",1,0],["إِنْ حَاضَرَتْ فِي مَجْمَعٍ أَوْ نَاظَرَتْ","فَالْحُسْنُ فِي الأَسْمَاعِ وَالأَبْصارِ",110,"ر",1,0],["أَنَحِيبُ إِنْ تُبْلِغْهُمُ","عُذْرِي فَقَدْ أُمِنَ الْعِتَابُ",111,"ب",1,0],["إِنْ حَدَّثَتْ أَرْوَتْ ظِمَاءَ النُّهَى","مِنْ مَنْهَلٍ يَا طِيبَهُ مَنْهَلا",112,"ل",2,0],["إِنْ حُزتِ أَعْلَى وِسَامٍ لِلْكَمَالِ فَفِي","كُلِّ القُلُوبِ لَكِ العُلْيَا مِنَ الرُّتَبِ",113,"ب",1,0],["إنَّ حُبَّ الفَارُوقِ وَهْوَ وَحِيدٌ","في مَكانٍ منَ القلوب وَحِيدِ",114,"د",1,0],["إن حَدَّثوكَ فَبِالْعُيون لِيَتَّقوا","رَصَدَ العيون وشِرَّةَ المُعْتال",115,"ل",1,0],["إن حاد قومي حدتُ أو","رُزقوا الهداية، أهتد",116,"د",1,0],["إنَّ حولَ الأُردُنِّ أرضًا تنادي:","أنا إرثٌ للعُرب، لا لليهود",117,"د",1,0],["إن حول الأردُنِّ حقًّا سليبًا","إن نسيناه، فهْوَ لا ينسانا",118,"ن",2,0],["إن حفِظتمْ على الصُّدور وساماً","فمن الشعب قد أضعتم وساما",119,"م",2,0],["إنْ حَزّ طَبّقَ غَيرَ مخطىءِ مَفصِلِ،","أوْ قَالَ أنجَحَ، أوْ تَدفّقَ أغزَرَا",120,"ر",2,0],["إنْ حَاذَرُوا النَّبْوَةَ مِنْ نُفُورِها،","أهْوَوْا بِأيْدِيهِمْ إلى نُحُورِهَا",121,"ر",3,0],["إنْ حَدَّثوكَ فَبِالْعيون لِيَتَّقوا","رَصَدَ العيون وشِرَّة َ المُغْتال",122,"ل",1,0],["إنْ حدثوا ملئوا الأسماعَ منْ أدبٍ","هُمْ أَهْلُهُ وإِذَا مَا أَنْصَتُوا فَقِهُوا",123,"ه",3,0],["إِنْ حَارَبُوا مَعْشَراً فِي جَحْفَلٍ غَلَبُوا","أوْ خاصموا فءة ً في محفلِ خصموا",124,"م",3,0]]}