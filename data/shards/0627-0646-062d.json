"],[461,"دمعي وإن كان دما سائلا","https://www.aldiwan.net/poem56004.html","السريع"],[464,"جانبا لومي وخافا لددي","https://www.aldiwan.net/poem16116.html","الرمل"],[467,"أعيا وقد عاينتم الآية العظمى","https://www.aldiwan.net/poem3135.html","عموديه"],[467,"ليست قدوداً ولكن هذه أسل","https://www.aldiwan.net/poem3144.html","عموديه"],[467,"في لأذني عن كل لاح صمم","https://www.aldiwan.net/poem3159.html","عموديه"],[467,"أهلك والليل منضيا جملك","https://www.aldiwan.net/poem3286.html","عموديه"],[467,"لولا صدودك يا أمامه","https://www.aldiwan.net/poem3491.html","عموديه"],[467,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[471,"أنحلني بصده","https://www.aldiwan.net/poem60183.html","مجزوء الرجز"],[471,"لا أنس أيامي ولا أطرابي","https://www.aldiwan.net/poem60426.html","الكامل"],[482,"سكن الهوى في القلب حيث أجله","https://www.aldiwan.net/poem37061.html","الكامل"],[518,"إن حارت الأفكار كيف تقول","https://www.aldiwan.net/poem12199.html","الكامل"],[540,"لما رأينا خيلا محجلة","https://www.aldiwan.net/poem69399.html","المنسرح"],[541,"دمت للفن ودام الفن لك","https://www.aldiwan.net/poem47968.html","عموديه"],[543,"قوم لهم شرف الدنيا وسؤددها","https://www.aldiwan.net/poem56629.html","البسيط"],[554,"كأن معقري مهج كرام","https://www.aldiwan.net/poem47728.html","الوافر"],[554,"قدني إليك فقد أمنت شماسي","https://www.aldiwan.net/poem47745.html","الكامل"],[554,"لو لم يعاجله النوى لتحيرا","https://www.aldiwan.net/poem47806.html","الكامل"],[554,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[561,"إنني جمع وفرق","https://www.aldiwan.net/poem34329.html","مجزوء الرمل"],[561,"إني أنا المكتوب في الطرس","https://www.aldiwan.net/poem34445.html","السريع"],[561,"قد قال من قال من جهل وإغواء","https://www.aldiwan.net/poem35078.html","البسيط"],[565,"وقفت مدحي فلا يطمع به أحد","https://www.aldiwan.net/poem52857.html","البسيط"],[565,"أجمل الله في فؤادك صبرا","https://www.aldiwan.net/poem52990.html","الخفيف"],[578,"ليس لي منه سوى لا","https://www.aldiwan.net/poem3032.html","مجزوء الرمل"],[578,"إن أكن أشجعا فأنت الرشيد","https://www.aldiwan.net/poem3083.html","الخفيف"],[578,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"],[589,"أضحى له في اكتئابه سبب","https://www.aldiwan.net/poem17411.html","المنسرح"],[667,"","https://poetry.dctabudhabi.ae/diwan/poem/122186","الرجز"],[777,"","https://poetry.dctabudhabi.ae/diwan/poem/28805","المديد"],[793,"","https://poetry.dctabudhabi.ae/diwan/poem/29555","الكامل"],[812,"","https://poetry.dctabudhabi.ae/diwan/poem/31483","الكامل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/202278","البسيط"],[1081,"","https://poetry.dctabudhabi.ae/diwan/poem/2574","البسيط"],[1104,"","https://poetry.dctabudhabi.ae/diwan/poem/20876","الكامل"]],"verses":[["إِن حُرِمتَ الرِزقَ الَّذي نالَ مِنهُ","فَدَواءُ العَيِيِّ داءُ الحَصيفِ",0,"ف",1,0],["إِن حافَ لي دَهرٌ عَلَيكَ فَطالَما","مالَ الزَمانُ عَلَيَّ فيكَ وَحافا",1,"ف",2,0],["أَنحَلَهُ الخَوفُ وَخَوفُ الفَتى","سَيفٌ عَلى مَفرِقِهِ مُنتَضى",2,"ض",2,0],["إِن حَلَّ بيداً فَالخَلاءُ مَحافِلٌ","أَو قادَ خَيلاً فَالسُروجُ مَنابِرُ",3,"ر",1,0],["أَنحَلَني فيها طِلابُ العُلى","وَذاكَ فَخري عِندَ أَندادي",4,"د",2,0],["إِن حَنَّتِ النيبُ شَوقاً وَهيَ واقِفَةٌ","فَإِنَّ عَزمِيَ مُشتاقٌ إِلى النيبِ",5,"ب",1,0],["إنْ حارَبوا أرْضى السّيوفَ سُخْطُهُمْ","أو سالَموا شَدّوا على الحِلْمِ الحُبا",6,"ا",1,0],["أَنحَلَ جِسمي وَبَرى أَعظُمي","لَذعُ حَراراتِ فِراقِ الحَبيب",7,"ب",1,0],["أَنْحَى عَلَى وَفْرِي وَرَوَّعَ مَأْمَنِي","ظُلْماً وَحَمَّلَنِي الَّذِي لاَ يُحْمَلُ",8,"ل",1,0],["أَنْحَى عَلَى الأَبِ وَالشَّقِيقِ فَغُيِّبَا","عَنِّي فَحَالِي بَعْدَهُمْ لاَ تَسْأَلِ",9,"ل",1,0],["أَنحى عَلى الأَدَبِ الشَرقِيِّ مُفتَرِياً","عَلَيهِ ما شاءَ مِن زورٍ وَبُهتانِ",10,"ن",1,0],["أَنحى عَلى سَردِ النَعالِ فَخلتُهُ","بَدراً يَصوغُ مِنَ الأَهِلَّةِ أَنجُما",11,"م",2,0],["أَنَ حَيرانٌ وَلِلأَمرِ","وُضوحٌ وَاِلتِباسُ",12,"س",1,0],["أَنَحنَ القُرونَ فَغَلَّلنَها","كَعَقلِ العَسيفِ غَرابيبَ ميلا",13,"ل",2,0],["إن حارت الشهبُ ليلاً في مقَّلده","فصبح غُرَّته بالنور يَهديها",14,"ي",3,0],["أن حياة المرء ما عاش ترى","أحوالها مختلفات في الرؤى",15,"ا",1,0],["انحت حتى رثى العدو لحالي","واعتراني من العويل بحاح",16,"ح",1,0],["أنحمل منك اليوم عبء تحكُّم","وندفع فيه الأجر منّا وننقد",17,"د",1,0],["إن حبّ الحياة أوهم أن ال","موت نوم تحت الثرى لا يطول",18,"ل",1,0],["إِن حَرَّموكَ لَتَحرُمَنَّ عَلى العِدى","أَو حَلَّلوكَ لَتُؤكَلَنَّ حَلالا",19,"ل",2,0],["إِنَّ حُبَّ الصِبا وَإِن طالَ لايَق","دَحُ فيهِ عَلى الدُهورِ دُثورُ",20,"ر",1,0],["إنْ حدّثت بك حالتي عن واصلٍ","فلقد تحدّث مهجتي عن جابر",21,"ر",1,0],["أنح جناب الوزير منتصراً","فإنه جابرٌ لما كسرا",22,"ر",2,1],["إن حرمت القليل من مالِ بيرو","ت على فاقتي فليسَ كثيرا",23,"ر",2,1],["إن حدَّثتهم بأخبار الأسى فما","قد أخرجت ليَ منهم أيّ أثقال",24,"ل",1,0],["أنحى بني العلياء في حالاتهم","فالقدر يرفع والأوامر تجزم",25,"م",1,0],["إن حكت عيناك لي جسداً","فلقد حاكت على السقم",26,"م",1,0],["أنْحتْ على حظِّي بمِبْرَاتِهَا","شكراً لأني كنتُ أرهَفْتُهَا",27,"ت",3,0],["إن حُرِّمَتْ فَبِحقِّهَا من حُرَّةٍ","ما كانَ مثْلُ حريمها بمباحِ",28,"ح",1,0],["إن حرمانَك مَنْ لم","تحرمِ العافينَ قبلَهْ",29,"ل",2,0],["أَنحى إِلَيهِنَّ عَيناً غَيرَ غافِلَةٍ","وَطَعنَ مُحتَقِرِ الأَقرانِ كَرّارِ",30,"ر",1,0],["إِن حَنى الدَهرُ قامَتي","وَمَحا الشَيبُ أَسوَدي",31,"د",2,0],["إِن حازَ بَعضُ الناسِ سَهماً في العُلى","فَلَهُم ضُروبٌ لا تُعَدُّ وَأَسهُمُ",32,"م",1,0],["إِنَّ حَيّاً يَهابُ أَن يَلمُسَ النورَ","كَمَيتٍ في ظُلمَةِ الأَكفانِ",33,"ن",1,0],["إِن حَدَثوكَ عَنِ النَعيمِ فَأَطنَبوا","فَاِشتَقتُهُ لا تَنسَ أَنَّكَ فيهِ",34,"ي",2,0],["إِنَّ حالاً أَنتَ مِنها","في قِيامٍ وَقُعودِ",35,"د",1,0],["أنحنُ أعداءُ مصرٍ فالبقاء لكم","إذا مضى عهدُنا في مِصرَ أو ذهبا",36,"ب",2,0],["إِن حالَ ما بَينَنا رَيحانُنا الناظِر","فَناظرُ القَلبِ حَقا نَحوَكُم ناظِرْ",37,"ر",1,0],["أنحى على الحق المبين يهيته","ناس خلوا من شيمة الانصاف",38,"ف",1,0],["أنحن فوق ارضنا","ام في السماء الزاهره",39,"ر",2,0],["انحى عليه يدوسه","ولقد اناخ بكلكل",40,"ل",1,0],["ان حرية الشعو","ب لمن اكبر النعم",41,"م",1,0],["إن حل في أرض فإنّ","الجور عنها زائل",42,"ل",1,0],["اِنحِسارُ الشِفاهِ عَن سِنِّ جَذلا","نَ وَراءَ الكَرى إِلى سِنِّ نادِم",43,"م",1,0],["إِن حَدَّثوا نَطَقوا بِخُرسِ كَتائِبٍ","أَو خوطِبوا سَمِعوا بِصُمِّ رِماحِ",44,"ح",1,0],["أَنْحَلَ الوَجْدُ جِسْمَهُ والحنينُ","وبَراهُ الهَوَى فما يَسْتَبِينُ",45,"ن",1,1],["إِن حَلَّ فارَقَتِ الخَزائِنُ مالَهُ","أَو سارَ فارَقَتِ الجُسومُ الروسا",46,"س",2,0],["إِن حَلَّ في فُرسٍ فَفيها رَبُّها","كِسرى تَذِلُّ لَهُ الرِقابُ وَتَخضَعُ",47,"ع",1,0],["أنحَى الكُسوفُ على الهِلالِ المجتلى","وأجرَّ شِقشقة الخطيب المِصْقَعِ",48,"ع",1,0],["أنحَى على ضَعْفِي بقوَّتِهِ","وسطَا على عَجْزِي بقدرتِهِ",49,"ت",2,0],["أنحَتْ عليَّ بلومها ولقد دَرَتْ","أنِّي على عَجْمِ الزمانِ صليبُ",50,"ب",1,0],["أَنحَيتَ كَي تُنفِقَها زارِياً","عَلى عَلِيِّ بنِ أَبي طالِبِ",51,"ب",1,0],["إِن حُصِّلَ الناسُ في فِعالِهِمِ","كُنتَ الَّذي أَصطَفي وَأَنتَخِبُ",52,"ب",1,0],["إِن حَزَّ طَبَّةَ غَيرَ مُخطِئِ مَفصِلٍ","أَو قالَ أَنجَحَ أَو تَدَفَّقَ أَغزَرا",53,"ر",2,0],["إِن حاذَروا النَبوَةَ مِن نُفورِها","أَهوَوا بِأَيدِهِم إِلى نُحورِها",54,"ر",3,0],["إِنَّ حَقّي رَغبُ النَوالِ وَحَقُّ ال","ناسِ أَن أَسلُكَ القَريضَ سَبيلَه",55,"ل",2,0],["إِنَّ حُبَّ الصُلعانِ يُبدي مِنَ المَر","ءِ لِأَهلِ التَكشيفِ أَمراً فَظيعا",56,"ع",2,0],["إن حبي للأرض حبٌ بصيرٌ","وهواهم عواطفٌ عمياء",57,"ا",2,0],["إن حلَّ فهو من الجلالةِ مَحفِلٌ","أو سار فهو من الشَّهامةِ جَحفَلُ",58,"ل",1,0],["أنحى على الشرك حتى ذل جانبه","وانهد غاربه الأعلى وكاهله",59,"ل",2,0],["إن حَلَّ حلَّ به السُّرو","ر مُخيِّماً أو سارَ سارا",60,"ر",2,0],["إن حَلَّ أوطنَ في صُدورِ رُواتِه","أو سارَ شَرَّقَ في البلادِ وغرَّبا",61,"ب",2,0],["إِن حَلَّ حَلَّ النَهبُ في أَركانِهِ","أَو سارَ سارَ الخُلفُ في الأَعداءِ",62,"ا",2,0],["إِن حَلَّ أَرضَ أُناسٍ شَدَّ أَزرَهُمُ","بِما أَتاحَ لَهُم مِن حَطِّ وِزرِهِمِ",63,"م",1,0],["إِن حاوَلَ الضَيفُ أَن يُلِمَّ بِهِ","أَعطاهُ مِن قَبلِ نُطقِهِ القَطنَه",64,"ن",2,0],["إِنَّ حَمّامَكَ قَد ضَ","مَت حَميماً وَحِماما",65,"م",2,1],["أَنحَلتِني بِالصُدودِ مِنكِ فَلَو","تَرَصَّدَتني المَنونُ لَم تَرَني",66,"ن",2,0],["إِنَّ حَواسي الخَمسَ مُذ غِبتُمُ","إِلَيكُمُ في غايَةِ الشَوقِ",67,"ق",1,0],["إِن حُكِّموا عَدَلوا أَو أُمِّلوا بَذَلوا","أَو حورِبوا قَتَلوا أَو غولِبوا غَلَبوا",68,"ب",3,0],["إن حبي إليكَ بالصفحِ سَبَّا","قٌ وقلبي إلَيكَ مهما أُصيبَا",69,"ب",2,0],["إن حان لحنُ الختام","صار النشيد دعاء",70,"ا",2,1],["إنَّ حُسْنَ الثناءِ بعدك يَبْقَى","لك بالذكرِ منه عيشٌ مُكَرَّرْ",71,"ر",1,0],["أَنحَفتَ جِسمَكَ حَتّى لَو هَمَمتُ بِأَن","أَلهو بِصَفعِكَ يَوماً لَم تَجِدكَ يَدي",72,"د",2,0],["إِنَّ حُزني عَلَيكَ لَيسَ عَلَيكا","بَل عَلى مُهجَةٍ تَسيلُ لَدَيكا",73,"ك",2,1],["إِن حَنَّ نَجدٌ وَأَهلوهُ إِلَيكَ فَقَد","مَرَرتَ فيهِ مُرورَ العارِضِ الهَطِلِ",74,"ل",1,0],["إِنَّ حُوَيّاً حاجَتي فَاِقضِها","وَرُدَّ جَأشَ المُشفِقِ الجازِعِ",75,"ع",1,0],["إِن حَنَّ هَذا غَراماً أَو دَعا طَرَباً","بِاسمِ الهَديلِ أَجابَت تِلكَ بِالنَّغَمِ",76,"م",1,0],["إِنْ حَدَّثُوا مَلأُوا الأَسْمَاعَ مِنْ أَدَبٍ","هُمْ أَهْلُهُ وَإِذَا مَا أَنْصَتُوا فَقِهُوا",77,"ه",3,0],["إِنْ حَارَبُوا مَعْشَرَاً فِي جَحْفَلٍ غَلَبُوا","أَوْ خَاصَمُوا فِئَةً فِي مَحْفِلٍ خصمُوا",78,"م",3,0],["إنَّ حزناً في ساعةِ العزلِ أضعا","فُ سرورٍ في حالةِ التقليدِ",79,"د",1,0],["أنحلَتْني حبيبتي","أنحلَ اللهُ خصرَها",80,"ه",2,1],["إِنَّ حُبّي آلَ لَيلى قاتِلي","ظَهَرَ الحُبُّ بِجِسمي وَبَطَن",81,"ن",1,0],["أنحن قتلنا الرئيسَ الجليلَ","غداةَ هوى نجمُه الآفلُ",82,"ل",1,0],["أَنحنُ بنو القومِ الأُلىَ زَلزلوا الدُّنَى","وثَلّوا العُروشَ الشُّمَّ أم نحن نكذبُ",83,"ب",1,0],["أَنحى عَلى المُلكِ الشَريدِ بِنَكبَةٍ","تَرَكت مَغاني مُلكِهِ أَطلالا",84,"ل",2,0],["أَنَحنُ الجاهِلونَ كَما زَعَمتُم","مَعاذَ اللَهُ مِن جَهلٍ وَحُمقِ",85,"ق",1,0],["أَنَحنُ الخائِنونَ كَما اِدَّعَيتُم","بِأَيَّةِ شيمَةٍ وَبِأَيِّ خُلقِ",85,"ق",1,0],["إِنَّ حِلمي إِذا تَغَيَّبَ عَنّي","فَاِعلَمي أَنَّني كَبيراً رُزيتُ",86,"ت",1,0],["إِن حارَبَ الدَهرُ قَلبي","فَقَد أَعيَنَ بِنَصرِ",87,"ر",1,1],["إنّ حَلْقَ الذَّقْنِ خيرٌ لِلفَتَى","يا بَنِي الأَعْمَامِ مِنْ أنْ تُنتَفا",88,"ف",2,0],["أنحَى لهمْ خَطّيَّةُ فتَهافَتَتْ","مُهَجاتُهُمْ تَستَنُّ من مَسنونه",89,"ن",2,0],["أَنحَلَني الحُبُّ فَأَص","بَحتُ شَبيهَ القَصَبَه",90,"ب",2,0],["إِنَّ حَياةَ الكَلبِ في وَفاتِها","حَتّى تَرى القِدرَ عَلى ميقاتِها",91,"ت",3,0],["أَنحَلَت جِسمَهُ الحَوادِثُ حَتّى","كادَ عَن أَعيُنِ الحَوادِثِ يَخفى",92,"ف",2,0],["إِنَّ حَمّادَ عَجرَدٍ","إِن رَأى غَفلَةً هَجَم",93,"م",1,0],["إِنَّ حُبّى بِحُبِّها","تَرَكَتني مُسَهَّدا",94,"د",2,0],["إِنَّ حُبّى سَحَرَتني","بِالأَماني وَالعِداتِ",95,"ت",1,0],["إِن حَرَّقوهُ فَما يَخشَونَ مِن ضَبُعٍ","تَسري إِليهِ وَلا خَفيٍّ وَتَطريحِ",96,"ح",1,0],["أَنُحتُ جَهلاً وَقَد ناحَت مُطَوَّقَةٌ","مِنَ الحَمامِ عَلى خَضراءَ مَقلودَه",97,"د",2,1],["أَنَحنُ أَفضَلُ أَم أَشياءُ جامِدَةٌ","أَضحَت سَواءً لَدَيها العَينُ وَالأَثَرُ",98,"ر",1,0],["إِن حَباكَ القَديرُ كَالنيلِ تِبراً","فَليُغِضهُ العَطاءُ وَالتَنويلُ",99,"ل",1,0],["إنّ حُزْناً في ساعةِ المَوْتِ أضْعَا","فُ سُرُورٍ في ساعَةِ الميلادِ",100,"د",1,0],["أنحَلَتْ جسمي نُحُولاً خَصْرُها","منه حالٍ فهْوَ أبْهَى حُلّتيَ",101,"ي",1,0],["إن حبي لمن أفارق فيها","يَتَجلى في دَمعيَ المهراق",102,"ق",1,0],["إن حيي العلم في أناس","من ذاته هذه",103,"ه",1,0],["أَنحى يسب وَلَم يستَحي من أَدَبي","ولا من الشيب في فوديّ يشتعل",104,"ل",1,0],["أنحى على الشعر ناس يبتغون له","نقداً فأعوزهم علم وعرفانُ",105,"ن",1,1],["إِنَّ حَقَّ الضَريرِ عِندَ ذَوي الأَب","صارِ حَقٌّ مُستَوجِبُ التَقديسِ",106,"س",1,0],["إن حاد في الكرب الكماة لم يحد","قد علمت ذاك حنينٌ وأحد",107,"د",1,0],["أنحى على الشّام أريافا وحاضرة","فلم يدع سبدا فيها ولا لبدا",108,"د",2,0],["إِنْ حَلَّ أَرْضاً حَمَى بِالسَّيْفِ جَانِبَهَا","وإِنْ وَعَى نَبْأَةً مِنْ صارِخٍ رَكِبَا",109,"ب",2,0],["أَنْحَى فَأَقْصَدَهُ الزَّمَانُ بِسَهْمِهِ","إِنَّ الزَّمَانَ لَنَابِلٌ مِيفَاقُ",110,"ق",1,0],["إِنْ حَاضَرَتْ فِي مَجْمَعٍ أَوْ نَاظَرَتْ","فَالْحُسْنُ فِي الأَسْمَاعِ وَالأَبْصارِ",111,"ر",1,0],["أَنَحِيبُ إِنْ تُبْلِغْهُمُ","عُذْرِي فَقَدْ أُمِنَ الْعِتَابُ",112,"ب",1,0],["إِنْ حَدَّثَتْ أَرْوَتْ ظِمَاءَ النُّهَى","مِنْ مَنْهَلٍ يَا طِيبَهُ مَنْهَلا",113,"ل",2,0],["إِنْ حُزتِ أَعْلَى وِسَامٍ لِلْكَمَالِ فَفِي","كُلِّ القُلُوبِ لَكِ العُلْيَا مِنَ الرُّتَبِ",114,"ب",1,0],["إنَّ حُبَّ الفَارُوقِ وَهْوَ وَحِيدٌ","في مَكانٍ منَ القلوب وَحِيدِ",115,"د",1,0],["إن حَدَّثوكَ فَبِالْعُيون لِيَتَّقوا","رَصَدَ العيون وشِرَّةَ المُعْتال",116,"ل",1,0],["إن حاد قومي حدتُ أو","رُزقوا الهداية، أهتد",117,"د",1,0],["إنَّ حولَ الأُردُنِّ أرضًا تنادي:","أنا إرثٌ للعُرب، لا لليهود",118,"د",1,0],["إن حول الأردُنِّ حقًّا سليبًا","إن نسيناه، فهْوَ لا ينسانا",119,"ن",2,0],["إن حفِظتمْ على الصُّدور وساماً","فمن الشعب قد أضعتم وساما",120,"م",2,0],["إنْ حَزّ طَبّقَ غَيرَ مخطىءِ مَفصِلِ،","أوْ قَالَ أنجَحَ، أوْ تَدفّقَ أغزَرَا",121,"ر",2,0],["إنْ حَاذَرُوا النَّبْوَةَ مِنْ نُفُورِها،","أهْوَوْا بِأيْدِيهِمْ إلى نُحُورِهَا",122,"ر",3,0],["إنّ حلمي حلم النّجوم وما","زوّق في الحلم نورها الوسنان",123,"ن",1,0],["إنْ حَدَّثوكَ فَبِالْعيون لِيَتَّقوا","رَصَدَ العيون وشِرَّة َ المُغْتال",124,"ل",1,0],["إن حضنت استقلالها وهو في","المهد فما اختار غير نعماك مهدا",125,"د",2,0],["إنْ حدثوا ملئوا الأسماعَ منْ أدبٍ","هُمْ أَهْلُهُ وإِذَا مَا أَنْصَتُوا فَقِهُوا",126,"ه",3,0],["إِنْ حَارَبُوا مَعْشَراً فِي جَحْفَلٍ غَلَبُوا","أوْ خاصموا فءة ً في محفلِ خصموا",127,"م",3,0],["أنحى الزمانُ على الأعداء واجتهدت","في قَطعِ خضرائِهِم أحداثُهُ السوُدُ",128,"د",1,0],["أنحى عليه بالصوارم والقنا","حتى إذا لم يبق غيرُ ذمائِهِ",129,"ا",3,0],["إن حبل الردى مشاع وعنه","قفز الهبر وابن شداد عاد",130,"د",1,0],["إنْ حلَّ حلَّ النهبُ في أموالهِ","أو سارَ حلَّ القتلُ في الأجْسَامِ",131,"م",1,0],["إن حلَّ في أرض جرَى","ربَّا روائحها نسيما",132,"م",2,0],["إن حدّثُوا صَدَقُوا أو كلّموا رَفَقُوا","أو شُوفِهُوا نطقوا أو حُوكِموا عَدَلُوا",133,"ل",3,0],["إن حَرَّ الأكبادِ والقلب والأ","حشاءِ من جَمْر خَدِّها الوقَّادِ",134,"د",1,0],["إِن حَلَّ دَاءُ دوي بِالجُسُومِ شفى اس","تِبصارُهُ كَلَّ دَاءٍ بِالجُسُومِ دوي",135,"ي",1,0],["إِن حُبَيِّكَ يا أُسَيمَا عَلَى الصَّد","دِ وإِن كُنتِ لَم تَصُدِّى دَلالا",136,"ل",2,0],["أنحى الزمان على الأغزاز واجتهدت","في قطعِ دابرِهِم أحداثُهُ السُّودُ",137,"د",1,0],["أنحيطُ في النادي بمنبرهِ دجىً","والصبحُ نحملهُ على الأعوادِ",1