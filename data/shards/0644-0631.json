diwan.net/poem3501.html","عموديه"],[477,"بعث الحبيب بصورة","https://www.aldiwan.net/poem36967.html","مجزوء الكامل"],[502,"يحرك وجدي قدك المتمايل","https://www.aldiwan.net/poem38405.html","الطويل"],[503,"أقلّوا","https://www.aldiwan.net/poem61087.html","الطويل"],[504,"أفقيهنا المستن ديناً والذي","https://www.aldiwan.net/poem2441.html","الكامل"],[513,"قل للمنية شوى","https://www.aldiwan.net/poem12003.html","مجزوء الكامل"],[513,"لكل مقام في علاك مقال","https://www.aldiwan.net/poem12200.html","الطويل"],[536,"يا حسرتي يا حسرتي","https://www.aldiwan.net/poem48262.html","عموديه"],[536,"إن يكن غيري تابا","https://www.aldiwan.net/poem48275.html","عموديه"],[538,"لرعت بصفراء السحالة حرة","https://www.aldiwan.net/poem56715.html","الطويل"],[556,"يا أهل أسفل سافلين","https://www.aldiwan.net/poem33729.html","مجزوء الكامل"],[556,"قضى الأمر وجف القلم","https://www.aldiwan.net/poem34195.html","الرمل"],[556,"ألا إنما المخلوق يعرف بالعقل","https://www.aldiwan.net/poem34212.html","الخفيف"],[556,"لربي في السما جود","https://www.aldiwan.net/poem34571.html","الهزج"],[560,"لرزق الله دار مع أخيه","https://www.aldiwan.net/poem52661.html","الوافر"],[561,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"أمجلس لهوي ليس لي منك مجلس","https://www.aldiwan.net/poem3058.html","الطويل"],[584,"أتراك بالهجران حين فتكت في","https://www.aldiwan.net/poem17606.html","الكامل"]],"verses":[["لِرَبِّها نَباهَةٌ","في الناسِ وَهوَ خامِلُ",0,"ل",1,0],["لِرَأيٍ لَعَمري غَيرِ دانٍ مِنَ النُهى","وَلا واسِطٍ في الحَزمِ قَبلا وَلا بَعدا",1,"د",2,0],["لَرَمى إِلَيَّ أَشَفَّ جَوهَرَةٍ","وَسَقى بِأَعذَبِ مائِهِ بَلَدي",2,"د",2,0],["لَرَأَت عَيناكَ مِنهُم مَنظَراً","لِلحَشى شَجواً وَلِلعَينِ قَذى",3,"ا",1,0],["لِرَسُول اللهِ وَفّيْ","تَ بِجِدٍّ وَانْتِهَاضِ",4,"ض",1,0],["لَرِيعَ لَهَا الأَحْرَاسُ مِنِّي بِطَارِقٍ","مَفَارِقُهُ شُمْطٌ وَأَسْيُافُهُ شُمْطُ",5,"ط",1,0],["لَرَفَعْتَ ظِلَّ الأَمْنِِ خَفَّاقاً فَقَدْ","كَادَتْ تَسِيرُ مَعَ الذِّئَابِ الشَّاءُ",6,"ا",2,0],["لِرُزئِكِ تَنهَلُّ الدُموعُ فَمِثلُهُ","إِذا حَلَّ وَدَّ القَلبُ لو كانَ مَدمَعا",7,"ع",2,0],["لَرَثَى لَكَ الْجَانِي عَلَيْكَ لَوَانَّهُ","لشلبَحْرِ قَلْبٌ ذُو شُعُورٍ رَاحِمُ",8,"م",1,0],["لراعت بها للحرب أهوال موقفٍ","تُشيبُ بمبيضّ النصول العواليا",9,"ي",2,0],["لرتّبت منها في السماء قصيدة","لكم واتخذت البدر في رأسها طُغرى",10,"ر",2,0],["لَرَأَيتَهُ حَرّانَ يَذكُرُها","يَجتازُ رُؤيَتَها عَلى الذِكرِ",11,"ر",1,0],["لركبهم المصريّ قلبي هدية","على أن دمعي بالمسرّة ينبع",12,"ع",1,0],["لرسوم الحمى عليهِ حقوق","مدمعٌ فائضٌ وقلبٌ خفوق",13,"ق",1,1],["لرقاب جزرك والعدى حدّ المُدا","ورقابنا من جودِك الأطواق",14,"ق",1,0],["لرفقتي من جياد الخيل أكملها","ولي جواد ولكن ناقص الدَّال",15,"ل",1,0],["لراحة إسماعيل أصدق موعداً","وساحته الفتحاء أمنع مقفلا",16,"ل",2,0],["لِرجاله منه اثنتانِ تتابعتْ","بهما له وتسايرت أمداحُه",17,"ح",2,0],["لَرَائقُ الرائقِ أندى على","قلبيَ من هند ومن دعدِ",18,"د",1,0],["لروّيةٍ منه نتي","جتها نَقيذ أو عَقيرُ",19,"ر",1,0],["لرأت عيناك طعناً","يترامى بالشرار",20,"ر",1,0],["لرؤيتُهُ عندي أجل منَ الذي","يَحُلُّ به من مُلكه ويسيرُ",21,"ر",1,0],["لَربَّت يومٍ قد جَلاهُنَّ لي ضُحىً","وللأرض من وشي الربيع ملابسُ",22,"س",1,0],["لرأت عيناك منه عجباً","مُنسِياً كل عجيب مطَّرَف",23,"ف",1,0],["لردِّك المصر إلى أمنه","رُدَّت إلى مصرك أُبَّاقه",24,"ق",2,0],["لراحتيك إذا وافى صباحَهما","جِدٌّ وأنت تراه من هُوَيناكا",25,"ك",2,0],["لرأينا مُسْتَيْقظين أموراً","حسبُنا أن تكونَ رُؤيا منام",26,"م",1,0],["لَرِّر لِسَمعي ذِكرَها","وَدَعِ الحَديثَ بِها يَطولُ",27,"ل",1,0],["لَرَدىً يُخافُ تُزيلُهُ","وَظَلومِ مَظلَمَةٍ تُزيحُه",28,"ح",2,0],["لرزءك لا شمس النهار جميلة","ولا الليل بسام النجوم لشاهد",29,"د",1,0],["لَرَأَيتَ جيلاً غَيرَ جي","لِكَ بِالجَبابِرِ لا يَدين",30,"ن",1,0],["لَرَدَّدتُ العِتابَ عَلَيكَ حَتّى","سَئِمتُ وَآخِرُ الوُدِّ العِتابُ",31,"ب",1,1],["لَرَهزَةٌ مِن غَوِيٍّ في مَضارِطِها","أَشهى إِلى قَلبِها مِن أَلفِ دينارِ",32,"ر",1,0],["لَرُدَّت بَهجَةُ الدُنيا إِلَيها","وَعادَ كَعَهدِهِ حُسنُ الزَمانِ",33,"ن",1,0],["لرأيتَ منه والحسامُ بكفه","بحراً يريق دمَ الكماة بجدول",34,"ل",1,0],["لَرَأَيناهُما بِمَرٍّ حَثيثٍ","يَطوِيانِ الأَعمارَ وَالآثارا",35,"ر",2,0],["لَرَأَيتَ أَنفَسَ مَن يَليكَ أَكُفُّهُ","بِنَواكَ أَحسَنُ ما يَكونُ صَنيعُهُ",36,"ع",2,0],["لَرُبَّ لَيلِ عَجاجٍ كانَ أَنجُمَهُ","شُهبُ الصَفاحِ وَأَطرافُ القَنا الذُبُلِ",37,"ل",1,0],["لِرَبِّكَ صَلِّ بِذا","العيدِ وَاِنحَر",38,"ر",1,0],["لَرَأَيتَ بَكّاءً يَهونُ عَلى الهَوى","وَتَهونُ تَخلِيَةُ الدُموعِ عَلَيهِ",39,"ي",2,0],["لَرَأَيتَ حَتفَ مَوارِدٍ","لَيسَت لَهُنَّ مَصادِرُ",40,"ر",1,0],["لَرَدَدتُ تُحفَتَهُ عَلَيهِ وَإِن عَلَت","عَن ذاكَ وَاِستَهدَيتُ بَعضَ خِصالِهِ",41,"ل",2,0],["لَرُدَّت عَلى أَعقابِها أَريحِيَّةٌ","مِنَ الشَوقِ واديها مِنَ الهَمِّ مُترَعُ",42,"ع",1,0],["لَرَأَيتَ في ما قَد رَأَيتَ وَقَد بَدا","ناراً تَكونُ إِذا جَرى إِعصارا",43,"ر",2,0],["لِربِّك حُكمُه والأمرُ شُورى","وتلك حكومةُ المُتحفِّظينا",44,"ن",2,0],["لِرَبِّكَ صلِّ يا عبّادُ فردا","وَزِدْ آلاءَهُ شُكراً وحمدا",45,"د",2,0],["لِربِّ النّاسِ داعٍ لا يخيبُ","ودينُ الحقِّ يعرفهُ اللّبيبُ",46,"ب",1,0],["لَرُدّوا إلى الآياتِ مُعجِزةً فلو","لمستَ الحصى فيهم بكفّيكَ سَبّحا",47,"ح",2,0],["لَرَأَيتَ ما اِستَقبَحتَهُ","مِن أَمرِنا وَهُوَ الجَميلُ",48,"ل",1,0],["لَرَنا لِبَهجَتِها وَحُسنِ حَديثِها","وَلَخالَهُ رُشداً وَإِن لَم يَرشُدِ",49,"د",1,0],["لرأيتم في ثورةِ النفسِ منه","مُحنقاً من قساورِ الغيل مُغْضَبْ",50,"ب",1,0],["لرمَحت فينا بِالسماكِ ضُحىً","وأبَحتَ لبدكَ صَهوة الرّدفِ",51,"ف",1,0],["لِرَجُلِ اللهِ وَمَا","أَصْلَحَهُ مِنْ رَجُلِ",52,"ل",1,0],["لَرَأَتْ أُمَّتُهُ مِن بِرِّهِ","عِظَماً فِي الْبَذْلِ مَفْقُودَ النَّظِيرِ",53,"ر",1,0],["لِرِخَاءِ أُمَّتِهِ وَعِزَّةِ جَيْشِهَا","لَمْ يَدَّخِرْ سَبَباً مِنَ الأَسْبَابِ",54,"ب",1,0],["لِرَبِّكَ عِنْدَكَ فِي كُلِّ يَوْمٍ","يدٌ يَا مَلِيكِي تَلِيهَا يَدُ",55,"د",1,0],["لرَقَّت حواشيها وفُضَّ حديدُها","ولانَت كما لانَت لداودَ في اليد",56,"د",1,0],["لَرَأَيْتَ الطَّوْدَ الأَشَمَّ الَّذِي كَا","نَ مَنِيعَ الذرَا كَثِيباً مَهِيلاَ",57,"ل",2,0],["لرفعتَ بندَ الأمنِ خفّاقاً","فقد كادت تسيرُ مع الذّئاب الشّاءُ",58,"ا",2,0],["لرضائها يبدي الحرام محللاً","ويدك معروفاً ويبني منكرا",59,"ر",2,0],["لَراجونَ أن تَصحُو سماءٌ مغيمة","وينزاحَ عن أرض الفراتين قسطل",60,"ل",1,0],["لَربَّت يومٍ جَلاَهُنّ لي ضُحى ً","وللأرض من وشي الربيع ملابس",61,"س",1,0],["لَرحت شَوقاً إِلَيكَ مُنَدرِجاً","في طَيِها وَالنَسيم يَحملها",62,"ل",3,0],["لربي مني الشكر شيخي ومرشدي","امام الرجال الغوث قطب رحى المجد",63,"د",1,1],["لرحب نداك قد الجأت ظهري","ومالي بين قومي من ظهير",64,"ر",1,0],["لركوب بحر والركوب لطنجة","وبها صحار نلتها متوهما",65,"م",2,0],["لَرُبَّ فَتَاةٍ فَعمَةِ الرِّدفِ لَدنَةٍ","تَمِيسُ كَغُصنِ ألبَانِ بَينَ غَوَانِ",66,"ن",1,0],["لَرَدَدتَني بِغَرائِبِ الجَدوى إِلى","مَن كانَ أَقصى سُؤلِهِ أَن أَرجِعا",67,"ع",2,0],["لَرَأى بِناظِرِ حَزمِهِ لَمّا رَأى","أَلّا سِلاحَ لَدَيكَ كَالإِذعانِ",68,"ن",1,0],["لرزيةٍ عظمت فحسبك ما يرى","بالكون منها قد تروع واضطرب",69,"ب",1,0],["لربكَ منك ميعادٌ بنصرِ","به لك عندَهُ بالنصرِ وعدُ",70,"د",1,0],["لِرَأيِ اِبنِ إِدريس اِبنِ عَمِّ مُحَمَّدٍ","ضِياءٌ إِذا ما أَظلَمَ الخَطبُ ساطِعُ",71,"ع",1,0],["لِرقصِ برغوثِها القَفَّازِ في سَلَبي","بَدءاَ وَعوداً وزمرِ البقِّ في أُذُني",72,"ي",1,0],["لرجلهِ عِندي يدٌ إذ خَطَت","نَحوي فداها كل رجل ويد",73,"د",1,1],["لَرَثى لِأَهلِ النارِ كَيفَ يَراهُمُ","وَهُمُ لَهُم فيها مِنَ القُرَناءِ",74,"ا",2,0],["لرامةَ والرملِ من عالجٍ","وزمزمَ والسفِح من لَعْلَع",75,"ع",1,0],["لرأوا ما استكثروا من","ملكهم غير كثير",76,"ر",1,0],["لربّهِ إن جنحُ ليلٍ أظلَما","محمّدٌ هوَ الأغرّ القائدُ",77,"د",1,0],["لَرَثَيتُ أَصحابي الَّذينَ تَتابَعوا","وَدَعَوتُ أَخرَسَ لا يُجيبُ دُعائي",78,"ا",2,0],["لرقته قطر النباتي ينتمي","لما جاء فيه من ضروب وامثال",79,"ل",1,0],["لرسم اصطباري هواه محا","وأمسى له في فؤادي محل",80,"ل",1,0],["لرُبَّ حَيٍّ غَدا في قَومِهِ حَجَرا","وَرُبَّ مَيتٍ غَدا حَيّاً بِهِ الحَجَرُ",81,"ر",1,0],["لَرَجَّتْك حتى العُصْم في فُتَنِ الرُّبا","وخافتك حتى الأَنْجُم السَّبْعة الشُّهُب",82,"ب",1,0],["لروحاً يهز الصب حتى كأنه","يطير اشتياقاً والجناح مهيض",83,"ض",1,0],["لريحانة القلب الّذي غرسه الحشا","بروضة سرّي منه فا