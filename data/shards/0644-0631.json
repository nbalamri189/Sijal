{"poems":[[53,"أين الغزال الماطل","https://www.aldiwan.net/poem29906.html","مجزوء الرجز"],[53,"تزود من الماء النقاخ فلن ترى","https://www.aldiwan.net/poem30517.html","الطويل"],[53,"هب للديار بقية الجلد","https://www.aldiwan.net/poem30519.html","الكامل"],[53,"كربلا لا زلت كربا وبلا","https://www.aldiwan.net/poem30772.html","الرمل"],[77,"أأزاهير رياض","https://www.aldiwan.net/poem36001.html","مجزوء الرمل"],[77,"تخطت وفود الليل بان به الوخط","https://www.aldiwan.net/poem36395.html","الطويل"],[77,"وسواس حليك أم هم الرقباء","https://www.aldiwan.net/poem36791.html","الكامل"],[73,"ألا هل درى الداعي المثوب إذ دعا","https://www.aldiwan.net/poem11947.html","الطويل"],[93,"لو كان مما ربك عاصم","https://www.aldiwan.net/poem11333.html","الكامل"],[83,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[88,"هو النصر معقود برايتنا الحمرا","https://www.aldiwan.net/poem44470.html","الطويل"],[23,"إن النضيرة ربة الخدر","https://www.aldiwan.net/poem21240.html","الكامل"],[72,"على اليمن والنعمى قدوم أحبة","https://www.aldiwan.net/poem19177.html","الطويل"],[72,"لرسوم الحمى عليه حقوق","https://www.aldiwan.net/poem19353.html","الخفيف"],[72,"تشبيب مدحك مطرب لكنه","https://www.aldiwan.net/poem19357.html","الكامل"],[72,"في ثغرها الحلو أو في جيدها الحالي","https://www.aldiwan.net/poem19473.html","البسيط"],[72,"أمنزل ذات الخال حييت منزلا","https://www.aldiwan.net/poem20541.html","الطويل"],[51,"الحب ريحان المحب وراحه","https://www.aldiwan.net/poem9398.html","الكامل"],[51,"يا رب عبد مالك سيدا","https://www.aldiwan.net/poem61854.html","الكامل"],[51,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[51,"زعموا أنك يا خالد","https://www.aldiwan.net/poem63017.html","مجزوء الرمل"],[51,"جزى الله عني قبح وجهي سعادة","https://www.aldiwan.net/poem64029.html","الطويل"],[51,"ألم تسأل اليوم الظباء الكوانس","https://www.aldiwan.net/poem64666.html","الطويل"],[51,"أنا غيران ولا زوجة لي","https://www.aldiwan.net/poem65445.html","الرمل"],[51,"مستعبد هيهات إعتاقه","https://www.aldiwan.net/poem65706.html","السريع"],[51,"قل للأمير أدام الله نعماكا","https://www.aldiwan.net/poem65761.html","البسيط"],[51,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[70,"بالله قل لي يا رسول","https://www.aldiwan.net/poem42762.html","مجزوء الكامل"],[70,"أضنى الفؤاد فمن يريحه","https://www.aldiwan.net/poem42980.html","مجزوء الكامل"],[89,"لقد كان سعد خير قوم مجاهد","https://www.aldiwan.net/poem44614.html","الطويل"],[85,"درجت على الكنز القرون","https://www.aldiwan.net/poem63694.html","مجزوء الكامل"],[45,"لرددت العتاب عليك حتى","https://www.aldiwan.net/poem10670.html","الوافر"],[45,"اسمع هديت أبا يحيى مقال أخ","https://www.aldiwan.net/poem64548.html","البسيط"],[45,"رويدك إن شأنك غير شاني","https://www.aldiwan.net/poem66787.html","الوافر"],[61,"لو كنت شاهده وقد غشي الوغى","https://www.aldiwan.net/poem51893.html","الكامل"],[49,"إن للدهر فاعلمن عثارا","https://www.aldiwan.net/poem62079.html","المتقارب"],[49,"عند البلى هجر الضجيع ضجيعه","https://www.aldiwan.net/poem62169.html","الكامل"],[66,"لم أدر أن نبال الغنج والكحل","https://www.aldiwan.net/poem38479.html","البسيط"],[66,"زمان الربيع","https://www.aldiwan.net/poem40962.html","المتقارب"],[44,"لو كنت عندي أمس وهو معانقي","https://www.aldiwan.net/poem30077.html","الكامل"],[44,"وافى الحبيب الزائر","https://www.aldiwan.net/poem30250.html","مجزوء الكامل"],[44,"أما أبو بشر فقد أضحى الورى","https://www.aldiwan.net/poem30382.html","الكامل"],[44,"أما إنه لولا الخليط المودع","https://www.aldiwan.net/poem30466.html","الطويل"],[74,"ماذا عليك وقد نأيت ديارا","https://www.aldiwan.net/poem12958.html","الكامل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"إلى القوم الألى جمعوا الجموعا","https://www.aldiwan.net/poem44203.html","الوافر"],[105,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[75,"أنظلم أن شمنا بوارق لمحا","https://www.aldiwan.net/poem69094.html","الطويل"],[48,"إن التي أبصرتها","https://www.aldiwan.net/poem64970.html","مجزوء الكامل"],[7,"أمن آل مية رائح أو مغتد","https://www.aldiwan.net/poem2002.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39562","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30512","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55144","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54901","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54633","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54726","المتقارب"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116957","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54202","الخفيف"],[77,"وسواسُ حليكِ أم هم الرقباءُ","https://www.poetsgate.com/ViewPoem.aspx?id=3296",""],[103,"قف في ربوع المجد وابك الأزهرا","https://www.poetsgate.com/ViewPoem.aspx?id=1337",""],[90,"الحزبان المتآخيان","https://www.poetsgate.com/ViewPoem.aspx?id=179105",""],[51,"ألم تُسأل اليوم الظباءُ الكوانسُ","https://www.poetsgate.com/ViewPoem.aspx?id=29406",""]],"verses":[["لِرَبِّها نَباهَةٌ","في الناسِ وَهوَ خامِلُ",0,"ل",1,0],["لِرَأيٍ لَعَمري غَيرِ دانٍ مِنَ النُهى","وَلا واسِطٍ في الحَزمِ قَبلا وَلا بَعدا",1,"د",2,0],["لَرَمى إِلَيَّ أَشَفَّ جَوهَرَةٍ","وَسَقى بِأَعذَبِ مائِهِ بَلَدي",2,"د",2,0],["لَرَأَت عَيناكَ مِنهُم مَنظَراً","لِلحَشى شَجواً وَلِلعَينِ قَذى",3,"ا",1,0],["لِرَسُول اللهِ وَفّيْ","تَ بِجِدٍّ وَانْتِهَاضِ",4,"ض",1,0],["لَرِيعَ لَهَا الأَحْرَاسُ مِنِّي بِطَارِقٍ","مَفَارِقُهُ شُمْطٌ وَأَسْيُافُهُ شُمْطُ",5,"ط",1,0],["لَرَفَعْتَ ظِلَّ الأَمْنِِ خَفَّاقاً فَقَدْ","كَادَتْ تَسِيرُ مَعَ الذِّئَابِ الشَّاءُ",6,"ا",2,0],["لِرُزئِكِ تَنهَلُّ الدُموعُ فَمِثلُهُ","إِذا حَلَّ وَدَّ القَلبُ لو كانَ مَدمَعا",7,"ع",2,0],["لَرَثَى لَكَ الْجَانِي عَلَيْكَ لَوَانَّهُ","لشلبَحْرِ قَلْبٌ ذُو شُعُورٍ رَاحِمُ",8,"م",1,0],["لراعت بها للحرب أهوال موقفٍ","تُشيبُ بمبيضّ النصول العواليا",9,"ي",2,0],["لرتّبت منها في السماء قصيدة","لكم واتخذت البدر في رأسها طُغرى",10,"ر",2,0],["لَرَأَيتَهُ حَرّانَ يَذكُرُها","يَجتازُ رُؤيَتَها عَلى الذِكرِ",11,"ر",1,0],["لركبهم المصريّ قلبي هدية","على أن دمعي بالمسرّة ينبع",12,"ع",1,0],["لرسوم الحمى عليهِ حقوق","مدمعٌ فائضٌ وقلبٌ خفوق",13,"ق",1,1],["لرقاب جزرك والعدى حدّ المُدا","ورقابنا من جودِك الأطواق",14,"ق",1,0],["لرفقتي من جياد الخيل أكملها","ولي جواد ولكن ناقص الدَّال",15,"ل",1,0],["لراحة إسماعيل أصدق موعداً","وساحته الفتحاء أمنع مقفلا",16,"ل",2,0],["لِرجاله منه اثنتانِ تتابعتْ","بهما له وتسايرت أمداحُه",17,"ح",2,0],["لَرَائقُ الرائقِ أندى على","قلبيَ من هند ومن دعدِ",18,"د",1,0],["لروّيةٍ منه نتي","جتها نَقيذ أو عَقيرُ",19,"ر",1,0],["لرأت عيناك طعناً","يترامى بالشرار",20,"ر",1,0],["لرؤيتُهُ عندي أجل منَ الذي","يَحُلُّ به من مُلكه ويسيرُ",21,"ر",1,0],["لَربَّت يومٍ قد جَلاهُنَّ لي ضُحىً","وللأرض من وشي الربيع ملابسُ",22,"س",1,0],["لرأت عيناك منه عجباً","مُنسِياً كل عجيب مطَّرَف",23,"ف",1,0],["لردِّك المصر إلى أمنه","رُدَّت إلى مصرك أُبَّاقه",24,"ق",2,0],["لراحتيك إذا وافى صباحَهما","جِدٌّ وأنت تراه من هُوَيناكا",25,"ك",2,0],["لرأينا مُسْتَيْقظين أموراً","حسبُنا أن تكونَ رُؤيا منام",26,"م",1,0],["لَرِّر لِسَمعي ذِكرَها","وَدَعِ الحَديثَ بِها يَطولُ",27,"ل",1,0],["لَرَدىً يُخافُ تُزيلُهُ","وَظَلومِ مَظلَمَةٍ تُزيحُه",28,"ح",2,0],["لرزءك لا شمس النهار جميلة","ولا الليل بسام النجوم لشاهد",29,"د",1,0],["لَرَأَيتَ جيلاً غَيرَ جي","لِكَ بِالجَبابِرِ لا يَدين",30,"ن",1,0],["لَرَدَّدتُ العِتابَ عَلَيكَ حَتّى","سَئِمتُ وَآخِرُ الوُدِّ العِتابُ",31,"ب",1,1],["لَرَهزَةٌ مِن غَوِيٍّ في مَضارِطِها","أَشهى إِلى قَلبِها مِن أَلفِ دينارِ",32,"ر",1,0],["لَرُدَّت بَهجَةُ الدُنيا إِلَيها","وَعادَ كَعَهدِهِ حُسنُ الزَمانِ",33,"ن",1,0],["لرأيتَ منه والحسامُ بكفه","بحراً يريق دمَ الكماة بجدول",34,"ل",1,0],["لَرَأَيناهُما بِمَرٍّ حَثيثٍ","يَطوِيانِ الأَعمارَ وَالآثارا",35,"ر",2,0],["لَرَأَيتَ أَنفَسَ مَن يَليكَ أَكُفُّهُ","بِنَواكَ أَحسَنُ ما يَكونُ صَنيعُهُ",36,"ع",2,0],["لَرُبَّ لَيلِ عَجاجٍ كانَ أَنجُمَهُ","شُهبُ الصَفاحِ وَأَطرافُ القَنا الذُبُلِ",37,"ل",1,0],["لِرَبِّكَ صَلِّ بِذا","العيدِ وَاِنحَر",38,"ر",1,0],["لَرَأَيتَ بَكّاءً يَهونُ عَلى الهَوى","وَتَهونُ تَخلِيَةُ الدُموعِ عَلَيهِ",39,"ي",2,0],["لَرَأَيتَ حَتفَ مَوارِدٍ","لَيسَت لَهُنَّ مَصادِرُ",40,"ر",1,0],["لَرَدَدتُ تُحفَتَهُ عَلَيهِ وَإِن عَلَت","عَن ذاكَ وَاِستَهدَيتُ بَعضَ خِصالِهِ",41,"ل",2,0],["لَرُدَّت عَلى أَعقابِها أَريحِيَّةٌ","مِنَ الشَوقِ واديها مِنَ الهَمِّ مُترَعُ",42,"ع",1,0],["لَرَأَيتَ في ما قَد رَأَيتَ وَقَد بَدا","ناراً تَكونُ إِذا جَرى إِعصارا",43,"ر",2,0],["لِربِّك حُكمُه والأمرُ شُورى","وتلك حكومةُ المُتحفِّظينا",44,"ن",2,0],["لِرَبِّكَ صلِّ يا عبّادُ فردا","وَزِدْ آلاءَهُ شُكراً وحمدا",45,"د",2,0],["لِربِّ النّاسِ داعٍ لا يخيبُ","ودينُ الحقِّ يعرفهُ اللّبيبُ",46,"ب",1,0],["لَرُدّوا إلى الآياتِ مُعجِزةً فلو","لمستَ الحصى فيهم بكفّيكَ سَبّحا",47,"ح",2,0],["لَرَأَيتَ ما اِستَقبَحتَهُ","مِن أَمرِنا وَهُوَ الجَميلُ",48,"ل",1,0],["لَرَنا لِبَهجَتِها وَحُسنِ حَديثِها","وَلَخالَهُ رُشداً وَإِن لَم يَرشُدِ",49,"د",1,0],["لرأيتم في ثورةِ النفسِ منه","مُحنقاً من قساورِ الغيل مُغْضَبْ",50,"ب",1,0],["لرمَحت فينا بِالسماكِ ضُحىً","وأبَحتَ لبدكَ صَهوة الرّدفِ",51,"ف",1,0],["لِرَجُلِ اللهِ وَمَا","أَصْلَحَهُ مِنْ رَجُلِ",52,"ل",1,0],["لَرَأَتْ أُمَّتُهُ مِن بِرِّهِ","عِظَماً فِي الْبَذْلِ مَفْقُودَ النَّظِيرِ",53,"ر",1,0],["لِرِخَاءِ أُمَّتِهِ وَعِزَّةِ جَيْشِهَا","لَمْ يَدَّخِرْ سَبَباً مِنَ الأَسْبَابِ",54,"ب",1,0],["لِرَبِّكَ عِنْدَكَ فِي كُلِّ يَوْمٍ","يدٌ يَا مَلِيكِي تَلِيهَا يَدُ",55,"د",1,0],["لرَقَّت حواشيها وفُضَّ حديدُها","ولانَت كما لانَت لداودَ في اليد",56,"د",1,0],["لَرَأَيْتَ الطَّوْدَ الأَشَمَّ الَّذِي كَا","نَ مَنِيعَ الذرَا كَثِيباً مَهِيلاَ",57,"ل",2,0],["لرفعتَ بندَ الأمنِ خفّاقاً","فقد كادت تسيرُ مع الذّئاب الشّاءُ",58,"ا",2,0],["لرضائها يبدي الحرام محللاً","ويدك معروفاً ويبني منكرا",59,"ر",2,0],["لَراجونَ أن تَصحُو سماءٌ مغيمة","وينزاحَ عن أرض الفراتين قسطل",60,"ل",1,0],["لَربَّت يومٍ جَلاَهُنّ لي ضُحى ً","وللأرض من وشي الربيع ملابس",61,"س",1,0]]}