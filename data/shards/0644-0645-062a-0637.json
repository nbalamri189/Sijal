{"poems":[[65,"من أغفل الحزم أدمى كفه ندما","https://www.aldiwan.net/poem46181.html","البسيط"],[57,"تعس المستقل خمس ليال","https://www.aldiwan.net/poem26206.html","الخفيف"],[75,"ما جال بعدك لحظي في سنا القمر","https://www.aldiwan.net/poem11928.html","البسيط"],[49,"لولا العجوز بمنبج ما خفت","https://www.aldiwan.net/poem24810.html","مجزوء الكامل"],[23,"منع النوم بالعشاء الهموم","https://www.aldiwan.net/poem21237.html","الخفيف"],[47,"وقضيب كأنه نفحة المسك","https://www.aldiwan.net/poem64559.html","الخفيف"],[68,"يا قرير العيون رق لعين","https://www.aldiwan.net/poem38445.html","الخفيف"],[46,"السيف أصدق أنباء من الكتب","https://www.aldiwan.net/poem30591.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85549","الخفيف"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/142366","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39616","الرمل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21075","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54542","الخفيف"],[108,"فجر السلام","https://www.poetsgate.com/ViewPoem.aspx?id=179416",""],[98,"عام جديد","https://www.poetsgate.com/ViewPoem.aspx?id=17900",""],[92,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[20,"لم تطلع من خدرها تبتغي خب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=502558",""],[159,"رب ليل مازلت ألثم فيه","https://www.aldiwan.net/poem55724.html","الخفيف"],[201,"هات يا ساق هات بنت النخيل","https://www.aldiwan.net/poem39944.html","الخفيف"],[287,"انثنى يثني على نعمى النعامى","https://www.aldiwan.net/poem32632.html","الرمل"],[308,"يا جامعا في دمشق","https://www.aldiwan.net/poem57785.html","المجتث"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[376,"دنا فزاد اشتعال الشوق بالبلل","https://www.aldiwan.net/poem57208.html","البسيط"],[406,"أيها الغائب","https://www.aldiwan.net/poem6734.html","عموديه"],[422,"جسد أشبه شيء بالخيال","https://www.aldiwan.net/poem53953.html","الطويل"],[445,"فكأن من حاني السحائب جودها","https://www.aldiwan.net/poem34842.html","الكامل"],[469,"عاد مني الخيال طيف الخيال","https://www.aldiwan.net/poem3497.html","عموديه"],[556,"هل شافع لي إلى نعم وسيلتها","https://www.aldiwan.net/poem47879.html","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38771","الرمل"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119247","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64739","البسيط"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122874","الرمل"],[2176,"","https://poetry.dctabudhabi.ae/diwan/poem/69494","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93651","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126949","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138625",""],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199047","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36246","الدوبيت"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62106","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83140","الخفيف"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58033","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58086","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33447","السريع"],[4679,"ذو الحزم يسمو والمهيمن ينصر","https://www.poetsgate.com/ViewPoem.aspx?id=142728",""],[4767,"حسن الخاتمة","https://www.poetsgate.com/ViewPoem.aspx?id=178993",""],[5159,"يا أَبا مُوسَى وَعَبْدَ","https://www.poetsgate.com/ViewPoem.aspx?id=201454",""],[5431,"حرّة تتربع ...","https://www.poetsgate.com/ViewPoem.aspx?id=210279",""],[5628,"الكأس والدموع","https://www.poetsgate.com/ViewPoem.aspx?id=178704",""],[5691,"الكوكب الأحمر... الوطن القادم...!","https://www.poetsgate.com/ViewPoem.aspx?id=206733",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[6102,"جُناح","https://www.poetsgate.com/ViewPoem.aspx?id=183610",""]],"verses":[["لمْ تَطْلُعِ الشّمسُ إلا استُقْبِلَتْ بِعَمىً","ولا بَدا النّجْمُ إلا اسْتَشْعَرَ الصّمَما",0,"م",2,0],["لَم تَطُل غايَةُ المَسيرِ عَلَيهِ","إِنَّما طولُها عَلى العُشّاقِ",1,"ق",1,0],["لَم تَطوِ بُردَ شَبابي كَبرَةٌ وَأَرى","بَرقَ المَشيبِ اِعتَلى في عارِضِ الشَعَرِ",2,"ر",1,0],["لَم تَطَّرِق نُوَبُ الحَوا","دِثِ أَرضَ هاتيكَ التَقِيَّه",3,"ي",2,0],["لَم تُطِق حَملَهُ العَواتِقُ مِنهُم","إِنَّما يَحمِلُ اللِواءَ النُجومُ",4,"م",1,0],["لَم تُطِق وَصفَهُ العُقولُ فَأَضحى","رَهنَ خَطرٍ يَدورُ في كُلِّ فِكرِ",5,"ر",1,0],["لم تطلق من بعدك الغمض إلا","لترى منك نضرة وسرورا",6,"ر",2,0],["لَم تَطلُعِ الشَمسُ فيهِ يَومَ ذاكَ عَلى","بانٍ بِأَهلٍ وَلَم تَغرُب عَلى عَزَبِ",7,"ب",1,0],["لم تطأطئ إلى الشهادة رأساً","فهي منها لها عليها دَليل",8,"ل",1,0],["لم تطل دولة هذا الظلم الا لتدالا","عثرة يا شعب كانت أحرام أن تقالا",9,"ل",2,0],["لم تُطِقْها حجَراً أو خشباً","ويُطاق اليوم أصنامُ الأنامِ",10,"م",1,0],["لَم تَطَلَّع مِن خِدرِها تَبتَغي خَب","باً ولا سَاءَ دَلُّها في العِنَاقِ",11,"ق",1,1],["لَمْ تُطِيقِي بَعْدَ الأَلِيفِ الْبَقَاءَ","وَكَرِهْتِ الْحَيَاةَ أَمْسَتْ شَقَاءَ",12,"ا",2,1],["لم تطفئ الحربَ الضروسَ نصوصُها","بل زادت الحربَ الضَّرُوسَ شُبوبا",13,"ب",2,0],["لم تطلقها حجرا أو خشبا","ويطاق اليوم أصنام الأنام !!",14,"م",1,0],["لم تُطِق أنةٍ فماتت – وقد يدفع -","موتاً عن ثاكلٍ أن تئنّا",15,"ن",2,0],["لَم تَطَلَّع مِن خِدرِها تَبتَغي خَبّ","اً ولا سَاءَ دَلُّها في العِنَاقِ",16,"ق",1,1],["لَمْ تُطِقْ دَفْعَها عَنِ الوَجْدِ حَتَّى","قَطَّعَتْها لِلْبَيْنِ مِنْ أَصْلِ زَنْدِ",17,"د",1,0],["لم تَطِب لي دُنيا الشقاءِ فوا","لهفي وشَوقي للعالمِ المجهول",18,"ل",1,0],["لَم تَطِب وَرداً وَلا وِرداً وَلا","نَورُها راقَ وَلا رَقَّت مُداما",19,"م",2,0],["لم تطرب الناس طرا","إلا لأنك معبد",20,"د",1,0],["لَم تُطبع الدّنيا على شكلِ الوفا","فَعلامَ في قلبِ الحقائق يطمعُ",21,"ع",1,0],["لِم تطردِ السَّرحَ عَنهُم ثمَّ تَطردُهُم","حتَّى كأنَّكَ راعي الخَيل والإبِلِ",22,"ل",1,0],["لم تطل أوقاتنا منذ التقينا","غير أنا قد زحمناها وصالا !",23,"ل",2,0],["لم تَطِشْ دهياءُ ما وقَّرها","من حُلومٍ راسياتٍ كالجبال",24,"ل",1,0],["لم تطَّلِعْ زُهْرُ النجومِ سوارِياً","إِلّا رَأَتْهُ فِي السَّنَاءِ أَمامَها",25,"م",3,0],["لم تطل مدَّة السقام من البل","بال حتى ظفرت بالإبلال",26,"ل",1,0],["لَم تطعمِ الحبَّ فَاِرتابَتْ لطاعِمهِ","ولم تَجِدْ بِي فلم أوقنْ بما أجدُ",27,"د",1,0],["لَم تَطُل وَاللَّهِ مِنهُ عشرُ ما","حازَهُ أَو عشرُ عشر الخُمسِ",28,"س",1,0],["لم تطعم الماء الزلال ولم تذق","طعم الطعام ولا ترى السيراء",29,"ا",2,0],["لم تَطْلعِ الشَّمسُ قيدَ الرُّمحِ ضاحيةً","حتى غدا إِرثُكَ الممنوعُ مردودا",30,"د",2,0],["لم تطق ألسننا من","وصفه عشر عشير",31,"ر",1,0],["لَم تَطرُقاني وَبي حَراكٌ","إِلى حَلالٍ وَلا حَرامِ",32,"م",1,0],["لَم تَطمع العَرب الغزاة بِهم وَهَل","لِعَدوهم دُون المَنية مِن مَهل",33,"ل",1,0],["لم تطف ادمعها نار الفؤاد ولا","تجفف النار ما من دمعها خرجا",34,"ج",2,0],["لم تطق حمله الملائك والر","سل فكل بحمله لا يقوم",35,"م",1,0],["لم تطغهم ايامهم وفعالهم","لكنها جاءت على ما شاؤوا",36,"ا",1,0],["لَم تَطوِ حَديثَ خُلَّتي عَنّيَ بَل","عَطَّرتَ بطيب نشره أَثوابي",37,"ي",1,0],["لم تطوك الأيام عني إنما","نقلتك من عيني إلى أضلاعي",38,"ع",2,0],["لَم تُطِع فيهِ عاذِلاً وَإِذا ما","صدقَ الحُبُّ لَم يُطع فيهِ عَذلا",39,"ل",2,0],["لم تَطَّبِيهمْ خريداتٌ تميسُ على","بُرْدِ الشباب بهنَّ المسكُ قد ظهرا",40,"ر",2,0],["لم تطيِّبْهُ زخاريفٌ مزخرفَةٌ","هوَ العفيفُ إذا خانَ الزمانُ وَفَى",41,"ف",2,0],["لم تطبِ الدنيا ولكنَّما","طابت بمن تهواهُ دُنياكا",42,"ك",2,0],["لم تطلبوا غير الحقوق وملكنا","عبد الحميد لها النصير الأكبرُ",43,"ر",1,0],["لَم تطلبَنْ من زوجِها","ردَّ الْمهاجمِ لائمَة",44,"م",2,0],["لَمْ تَطِبْ نَفْسِي أُسَمِّي","كَ قَتِيلاً يا قَتِيلُ",45,"ل",1,0],["لم تُطأطئْ شموخها مثل حورٍ","تخبر الطير أنّها لا تُروّعْ",46,"ع",1,0],["لمْ تُطِقْ روحي إبعاد الجوى(1)","الجوى ينسلُّ مِنْ كلّ منيع ِ",47,"ع",1,0],["لم تطَأها مذْ أبْدِعَتْ قدَمٌ","ترْسي عليها الحروبَ والأطْماعا!",48,"ع",2,0],["لم تطَلْهُ سيوفُ قيصرَ أو كسرى","ولمْ يُكْبِهِ جَوادٌ حَرونُ",49,"ن",1,0],["لَمْ تَطِبْ لَيلَكَاتُ عِشقِيَ سُكنَى","بَعدَما هَاجَتْ فِي الحُقُولِ الرِّياحُ",50,"ح",1,0]]}