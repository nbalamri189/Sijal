{"poems":[[85,"سلام على الدنيا جميعا وما فيها","https://www.aldiwan.net/poem54233.html","الطويل"],[74,"نعتوك حقا بالإمام لما حوت","https://www.aldiwan.net/poem19222.html","الكامل"],[47,"نعتبت دهرا فلما رجع","https://www.aldiwan.net/poem11043.html","المتقارب"],[47,"نعتد أنحسنا بعزك أسعدا","https://www.aldiwan.net/poem62770.html","الكامل"],[47,"يا عارضا متلفعا ببروده","https://www.aldiwan.net/poem63492.html","الخفيف"],[47,"شغلان من عذل ومن تفنيد","https://www.aldiwan.net/poem63493.html","الكامل"],[30,"ألا سلت الله ابن سلتى كما نعى","https://www.aldiwan.net/poem5280.html","الطويل"],[51,"نعت نفسها الدنيا إلينا فأسمعت","https://www.aldiwan.net/poem10839.html","الطويل"],[51,"نعت الدنيا إلينا نفسها","https://www.aldiwan.net/poem62131.html","الرمل"],[46,"أبو علي وسمي منتجعه","https://www.aldiwan.net/poem30461.html","المنسرح"],[33,"أبهجر يودع الأجوار أم","https://www.aldiwan.net/poem42534.html","الخفيف"],[33,"إني وأول ما كلفت بحبها","https://www.aldiwan.net/poem42628.html","الكامل"],[107,"أيكف شكوك أن يكون أماما","https://www.aldiwan.net/poem43395.html","الكامل"],[77,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[50,"أحسن من موقف على طللِ","https://www.aldiwan.net/poem66591.html","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54710","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43768","الوافر"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43694","الرمل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43806","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43755","الوافر"],[234,"نعت بالبين غربان","https://www.aldiwan.net/poem50762.html","مجزوء الوافر"],[371,"تذكرت من بيني ومن بين أدم","https://www.aldiwan.net/poem17823.html","الطويل"],[405,"نعت نفسك الدنيا إلينا وأسرعت","https://www.aldiwan.net/poem4512.html","الطويل"],[447,"حرائق حزن في فؤادي تجدد","https://www.aldiwan.net/poem14448.html","الطويل"],[505,"أيها المستحلف الليل أفق","https://www.aldiwan.net/poem38032.html","الرمل"],[519,"إلى الله نشكو فادحات النوائب","https://www.aldiwan.net/poem20840.html","الطويل"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2506","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64369","الطويل"],[863,"","https://poetry.dctabudhabi.ae/diwan/poem/116085","البسيط"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145888","البسيط"],[1477,"","https://poetry.dctabudhabi.ae/diwan/poem/134232","الطويل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95566","الطويل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95543","الطويل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95568","الطويل"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102061","البسيط"],[2027,"","https://poetry.dctabudhabi.ae/diwan/poem/101856","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27699","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201329","الوافر"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132620","الخفيف"],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145544","الطويل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140027","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67979","الرمل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123927","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110057","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110110","الكامل"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199026","الرجز"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131199",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114417","الطويل"],[4091,"","https://poetry.dctabudhabi.ae/diwan/poem/141838","الكامل"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103259","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73099","الوافر"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136489",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72396","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72426","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72350","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120266","الوافر"],[4717,"الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=199575",""],[4767,"الأمل المقبور","https://www.poetsgate.com/ViewPoem.aspx?id=91606",""],[4929,"تزاحم الأرزاء","https://www.poetsgate.com/ViewPoem.aspx?id=199296",""],[5183,"الحزن العميق","https://www.poetsgate.com/ViewPoem.aspx?id=180262",""],[5187,"وجيه في التسعين","https://www.poetsgate.com/ViewPoem.aspx?id=29067",""],[5225,"بو خليفه لي يشجعنا","https://www.poetsgate.com/ViewPoem.aspx?id=27618",""],[5397,"عز الحمى فثوى بالأمن خائفه","https://www.poetsgate.com/ViewPoem.aspx?id=157940",""],[5533,"رَغْمَ الجِراح","https://www.poetsgate.com/ViewPoem.aspx?id=184051",""],[5952,"تباريني حروف الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=197111",""],[501,"خذني بعينيك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65823&r=&rc=3",""]],"verses":[["نَعَتْ مَلِكَ الأملاك والكاملَ الذي","يكفّ عوادي الحادثات ويكفيها",0,"ي",3,0],["نعتوك حقًّا بالإمام لما حوت","علياك من نسكٍ وعلم بارع",1,"ع",1,1],["نَعَتَّبتُ دَهراً فَلَمّا رَجَع","تُ إِلى حاصِلِ الطَمَعِ الكاذِبِ",2,"ب",1,1],["نَعتَدُّ أَنحُسَنا بِعِزِّكَ أَسعُدا","وَنُسَرُّ فيكَ بِما يُساءُ لَهُ العِدى",3,"د",2,1],["نَعتَدُّهُ ذُخرَ العُلا وَعَتادَها","وَنَراهُ مِن كَرَمِ الزَمانِ وَجودِهِ",4,"د",2,0],["نَعتَدُّ عِزَّكَ عِزَّ دينِ مُحَمَّدٍ","وَنَرى بَقاءَكَ مِن بَقاءِ الجودِ",5,"د",1,0],["نَعَت خَيرَ شُبّانِ الرِجالِ وَخَيرَهُم","بِهِ الشَيبُ مِن أَكنافِهِ قَد تَلَفَّعا",6,"ع",2,0],["نَعَت نَفسَها الدُنيا إِلَينا فَأَسمَعَت","وَنادَت أَلا جَدَّ الرَحيلُ وَوَدَّعَت",7,"ت",1,1],["نَعَتِ الدُنيا إِلَينا نَفسَها","وَأَرَتنا عِبَراً لَم نَنسَها",8,"س",3,1],["نَعَتُّ سَيفاً أَغفَلتُ قائِمَهُ","وَظَبيَ قُفٍّ سَهَوتُ عَن تَلَعِه",9,"ع",2,0],["نَعَتوها فَأَحسَنوا النَعتَ حَتّى","كِدتُ مِن حُسنِ نَعتِها أُستَطارُ",10,"ر",1,0],["نُعِتَ النِساءُ فَقُلتُ لَستُ بِمُبصِرٍ","شَبهاً لَها أَبَداً وَلا بِمُقَرِّبِ",11,"ب",1,0],["نَعتَدُّ شَكوى الحادِثاتِ مَسَبَّةً","وَنَرى الضَراعَةَ لِلمُلوكِ حَراما",12,"م",2,0],["نَعْتَدُّ أيْسَرَ ما ملكتَ رِقابَنَا","وأقَلَّ ما نَرجو بكَ المَأمولا",13,"ل",2,0],["نعتُ رغيفٍ كأنّهُ قمرٌ","لم يكُ خبّازهُ على وجَل",14,"ل",1,0],["نَعْتَاضُ مِنْ نَزَوَاتِ سَابِقِهِ","بِنَعِيمِ عَهْدٍ رَاشِدٍ هَادِي",15,"د",2,0],["نَعَتكَ اليَومَ أَبكار المَعالي","وَلَولا المَوتُ فزنَ بِكَ اِفتِضاضا",16,"ض",2,0],["نَعَتِ العَلياءُ زُهراً","نَجُبوا ثَمَّ فَسادوا",17,"د",3,1],["نَعَتكَ مَعي زَهرُ الشُموسِ ثَواكِلاً","وَفي وردها طَلُّ المَدامِعِ وَالخمشُ",18,"ش",1,0],["نَعَت نَفسي أَحبَّتها","أَهِلَّتَها وَأغصُنها",19,"ن",3,0],["نَعَتْ بالبينِ غِرْبانُ","فأحبابُكَ أَظْعانُ",20,"ن",1,1],["نَعَت نَفسِيَ الدُنيا إِلَيَّ بِشَيبَةِ","لَقَد أَسرَجَت يا عَينُ في لَيلَةٍ ظَلما",21,"م",2,0],["نَعت نفسكَ الدنيا إِلينا وَأَسرعت","وَنادَت أَلا جدّ الرحيل وَودّعت",22,"ت",1,1],["نعته نعاة الحي والليل أكهل","فحاذرت أنعي فيه والصبح أمرد",23,"د",1,0],["نعَتوهُ بالأَمينِ المُرْتَضى","وتَعامَوْا عن عُلاهُ حَسَدَا",24,"د",2,0],["نعَتْهُ السّما والأرضُ حتّى بكَتْ له","جُفونُ الغَوادي بالدّموعِ السّواكِبِ",25,"ب",1,0],["نَعَتِ السَحائِبُ وَالغَمامُ بِأَسرِها","جَسَداً بِمَسكَنَ عارِيَ الأَوصالِ",26,"ل",1,1],["نعتك إلى العشاق يا شبل لحية","إذا ما رآها عاشقٌ ظل ينشدُ",27,"د",1,0],["نَعَت إلَينَا الرَّئيسَ الجِهبِذيَّ وَقَد","قَالَت تَعَزَّوا فَمَا حَىٌّ بِمُترَّكَ",28,"ك",1,0],["نعتُ أيامَنا عَتاً لِمِحنتِنا","وليسَ نسألهَا عطفاً ولا لِيْنا",29,"ن",2,0],["نعت لي أهليها فهلت مدامعي","وقل ولو أسبلت نفسي أدمعا",30,"ع",2,0],["نعته بهوت وهو أس فخارها","إِنى سائر البلدان آلمها الفقدُ",31,"د",1,0],["نَعَتهُ المنايا للملا فتفزّعت","من القوم أكبادٌ تضن به فرَدا",32,"د",2,0],["نعتها المعالى للعراقة والخدرِ","وأبَّنَهَا الإِحسان فى ساحة البرِّ",33,"ر",1,1],["نعت حوى كل معني حارَ واصفه","وأبيض الوجه محمر مورده",34,"ه",1,0],["نعته أعجز منا الألسنا","فغدت مخرسة لم تنطق",35,"ق",1,0],["نعتُ المهيمنِ بالإطلاق تقييدُ","وكلُّ ما قيل فيه فهو تحديدُ",36,"د",1,1],["نعتّقه فنسكر من شذاه","ونبلغ منه عربدة التصابي",37,"ب",2,0],["نعت الكهرباء جوهر فضل","كان للآملين كنزاً وذخرا",38,"ر",2,0],["نعتها النواعي من زمان مؤنب","وكان معد يستريث المؤنبا",39,"ب",2,0],["نعتْهم نواعيهم هناكَ فأصبحوا","حصيداً كما تغضي على الجفن بالجفن",40,"ن",1,0],["نَعتِب الدهرَ وَمَا الدهرُ أسا","أهلَ ودي مَا لهذا الدهر جُنْحُ",41,"ح",1,0],["نعت مضر الحمراء فيك فخارها","واثكلت بالعليا قريش الأباطح",42,"ح",1,0],["نَعَتِ الرُبوعُ مع الطُلولِ لفَقدِهِ","والدَمعُ طَلَّ دَماً بذيَّاكَ الطَلَل",43,"ل",1,0],["نعتٌ لمنعوتٍ ومقصودٍ وفي","إِعرابِهِ بَدَلٌ وعطفُ بَيانِ",44,"ن",1,0],["نعت إليه نفسه جاريته","يوماً وكانت أعجبته بزته",45,"ه",1,0],["نعتك لهذا الناس مصر وإنما","نعت علم الفضل الذي كان راسيا",46,"ي",2,0],["نعتك كما تنعى السموات بدرها","إذا ما رأته ليلة التم هاويا",46,"ي",2,0],["نعت شاعر الوحي الذي عطلت له","واصبح فيها مهبط الوحي خاليا",46,"ي",2,0],["نعت أدبا في الأرض أسرى من الضيا","إذا صدع الصبح المبين الدياجيا",46,"ي",2,0],["نعت شعر جيل واضح النهج رائقا","تنضد في سمط البيان لآليا",46,"ي",2,0],["نعتهُ السماواتُ العُلى والثرى ولم","يَزَل يومُهُ يُبدي إلى يومنا حُزنا",47,"ن",2,0],["نعت بها الغربان حتى فُصّلت","بين الأحبة فالبكا موصول",48,"ل",1,0],["نعتوه من بسط اليدين مبذراً","وكأن من غُلت يداه رشيدُ",49,"د",1,0],["نَعت بمُحمَّدِ فيهِ نُعاةٌ","لَدَيها يَشكُرُ الصَّممَ السَّميعُ",50,"ع",1,0],["نَعتك المزايا الغُر يا بهجةَ الدِهر","وراحت لك العلياء تلطمُ بالعشر",51,"ر",1,1],["نعت بني الهاشمي وردي","منه صفا مشربي ووردي",52,"ي",1,1],["نعت حوى فرائدا من درر","عقد موالاتي بها تنظما",53,"م",2,0],["نعته بالزبور جاء وبالفر","قان بل بالتورة والانجيل",54,"ل",1,0],["نعت دنياي طيب العيش عندي","وقد نظرت مشيبي هاش هيشا",55,"ش",2,1],["نعتِ البلادُ إلى الفضائلِ ربَها","حامي الحمى والقمَّةَ الشمَّاءَ",56,"ا",2,0],["نعتك لي يا أخي في الله (قافلة)","قالت وفيها نبا الأحزان منشور",57,"ر",1,1],["نعتوك باليمنِ السعيدِ فهل تُرَى","للنعتِ في الزمنِ البئيسِ لزومُ",58,"م",1,0],["نعت إلينا فقيد العلم والعمل ال","بناء من عز والطاقات تذليل",59,"ل",1,0],["نعت إلينا التنوخى الذي كرمت","أعراقه فهي للعليا أكاليل",59,"ل",1,0],["نعت إلى العلم عز الدين فانبجست","عن جفنه الجون أرختها الغرابيل",59,"ل",1,0],["نعت فقيد الوفا والصدق من شهدت","له الدفاتر والأقلام تسجيل",59,"ل",1,0],["نعتوكَ في دنيا الغرورِ مولّهاً","والشعرُ جاءَ عن الخيالِ يعبّرُ",60,"ر",1,0],["نعترف باللّى بتسبقنا","وان سبقناها تقاضينا",61,"ن",2,0],["نعتك من حي عدنان مواكبه","ومن حمى رهط قحطان طوائفه",62,"ف",2,0],["(نُعَتِّقُ النَغَمَاتِ البيضَ نَرْشُفُهَا)","فِي كلِّ مَلْحَمَةٍ نَرْقَى ونَنْتَصرُ",63,"ر",1,0],["نُعَتِّقُ حرفَنا للمدحِ دهرا","فيرجعُ سائلاً ...ماذا أقولُ؟",64,"ل",1,0],["نُعَتِّقُ النغَمَاتِ البيضَ نَرشُفُها","يومَ الأمَاسِي ، فلا خَمرٌ ولا سَهَرُ",65,"ر",1,0]]}