{"poems":[[53,"لقلبي بغوري البلاد لبانة","https://www.aldiwan.net/poem30112.html","الطويل"],[57,"لقلع ضرس وضرب حبس","https://www.aldiwan.net/poem24680.html","مجزوء البسيط"],[77,"لو لم تكن في فصول العام حاضرة","https://www.aldiwan.net/poem35979.html","البسيط"],[0,"تطاول ليلك بالأثمد","https://www.aldiwan.net/poem81.html","المتقارب"],[93,"يا دار أهلك بالسلامة عادوا","https://www.aldiwan.net/poem9833.html","الكامل"],[12,"ولا تقبروني إن دفني محرم","https://www.aldiwan.net/poem1212.html",""],[92,"كرهت القصور وقطانها","https://www.aldiwan.net/poem38931.html","المتقارب"],[78,"لقلبي لبعدك عني عليل","https://www.aldiwan.net/poem14027.html","المتقارب"],[28,"عجبت لحادينا المقحم سيره","https://www.aldiwan.net/poem5310.html","الطويل"],[28,"لو جمعوا من الخلان ألفا","https://www.aldiwan.net/poem5634.html","الوافر"],[49,"لعمرك ما الدنيا بدار بقاء","https://www.aldiwan.net/poem10314.html","الطويل"],[49,"أتبكي لهذا الموت أم أنت عارف","https://www.aldiwan.net/poem62180.html","الطويل"],[49,"سكر الشباب جنون","https://www.aldiwan.net/poem63129.html","المجتث"],[49,"إني أرقت وذكر الموت أرقني","https://www.aldiwan.net/poem63163.html","البسيط"],[97,"دعوت فلبينا ودارك كعبة","https://www.aldiwan.net/poem24932.html","الطويل"],[87,"تصابيت بعد الحلم واعتادني زهوي","https://www.aldiwan.net/poem8193.html","الطويل"],[69,"لو كان يرضى بحكمي","https://www.aldiwan.net/poem28947.html","المجتث"],[69,"مدحت أنطاكية","https://www.aldiwan.net/poem29298.html","مجزوء الرجز"],[31,"أحب لحب عبلة كل صهر","https://www.aldiwan.net/poem42213.html","الطويل"],[33,"ألا أيها القوم الذين وشوا بنا","https://www.aldiwan.net/poem25911.html","الطويل"],[39,"أتشتم أزد القريتين وطيئا","https://www.aldiwan.net/poem53743.html","الطويل"],[40,"أقول غداة استقل الجمي","https://www.aldiwan.net/poem42301.html","المتقارب"],[46,"لو كنت رائد قوم ظاعنين إلى","https://www.aldiwan.net/poem22126.html","البسيط"],[32,"","https://poetry.dctabudhabi.ae/diwan/poem/8239","الطويل"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1943","المتقارب"],[90,"عتاب مع النفس ..","https://www.poetsgate.com/ViewPoem.aspx?id=179099",""],[122,"ليالي سلمى ترتقي لي وتراقيا","https://www.aldiwan.net/poem23827.html","الطويل"],[125,"عفا الصفا وانتفى من كوخ ندماني","https://www.aldiwan.net/poem23777.html","البسيط"],[156,"باح بما قد كتما","https://www.aldiwan.net/poem55554.html","مجزوء الرجز"],[165,"لن تستطيع لأمر الله تعقيبا","https://www.aldiwan.net/poem67835.html","البسيط"],[165,"لك العهد عهد الله ألا يزال لي","https://www.aldiwan.net/poem67855.html","الطويل"],[187,"سبحان من خلق العميان من نكد","https://www.aldiwan.net/poem43972.html","البسيط"],[190,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[190,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[211,"لغرتها البيضاء طرفك لو رأى","https://www.aldiwan.net/poem13425.html","الطويل"],[212,"غنى المغنون من حولى فما سمعت","https://www.aldiwan.net/poem46768.html","البسيط"],[271,"سلام عليك صباح مساء","https://www.aldiwan.net/poem35189.html","المتقارب"],[271,"أرى حبي شرارا مستطيرا","https://www.aldiwan.net/poem35589.html","الوافر"],[276,"أشد بالقوافي ذكر علوة أو عليا","https://www.aldiwan.net/poem25451.html","الطويل"],[350,"لقلبي عن مطاوعة اللواحي","https://www.aldiwan.net/poem15728.html","الوافر"],[354,"ومحتجب أطال جفاي هجرا","https://www.aldiwan.net/poem39745.html","الوافر"],[365,"سترن المحاسن إلا العيونا","https://www.aldiwan.net/poem60632.html","المتقارب"],[372,"لقلع ضرس ومضغ كلس","https://www.aldiwan.net/poem56921.html","مخلع البسيط"],[401,"رجوتك يا حبيب","https://www.aldiwan.net/poem6720.html","عموديه"],[407,"فؤادي الفداء لها من قبب","https://www.aldiwan.net/poem50210.html","المتقارب"],[417,"أبا مصطفى إنا ذكرناك بيننا","https://www.aldiwan.net/poem53893.html","الطويل"],[459,"آنس برقا بالشريف لامعا","https://www.aldiwan.net/poem56123.html","الرجز"],[465,"ليست قدوداً ولكن هذه أسل","https://www.aldiwan.net/poem3144.html","عموديه"],[516,"ترى عند نجم الدين علم بما عندي","https://www.aldiwan.net/poem12071.html","الطويل"],[517,"أقول لركب قافلين رأيتهم","https://www.aldiwan.net/poem48741.html","الطويل"],[552,"لقل غناء العتب والمجرم الدهر","https://www.aldiwan.net/poem47826.html","الطويل"]],"verses":[["لِقَلبي بِغَورَيَّ البِلادِ لُبانَةٌ","وَإِن كُنتُ مَسدوداً عَلَيَّ المَطالِعُ",0,"ع",1,1],["لِقَلعُ ضِرسٍ وَضَربُ حَبسِ","وَنَزعُ نَفسٍ وَرَدُّ أَمسِ",1,"س",1,1],["لقُلْتُ ورْدٌ منَ الأيْدي لَها شجَرٌ","ومن أنامِلِهنّ الخَمْسُ أقْماعُ",2,"ع",1,0],["لَقُلتُ مِنَ القَولِ ما لا يَز","لُ يُؤثِرُ عَنّي يَدَ المُسنِدِ",3,"د",1,0],["لقلوبها أرب وحيدٌ شاملٌ","ومآرب الناس العداد عداد",4,"د",1,0],["لَقُلتُ لها قَد كانَ ذَلِكَ مَرَّةً","ولَستُ على ما قَد عَهدتُ بِقادِرِ",5,"ر",1,0],["لقَلْبِ الفقيرِ الحطيم الكسيرِ","ودَمْعِ الأَيامَى السَّفيحِ الذَّريفْ",6,"ف",1,0],["لَقَلبي لِبُعدك عَنّي عَليلُ","فَشَوقي صَحيحٌ وَجِسمي عَليلُ",7,"ل",1,1],["لَقُلتُ اِرجِعَنها إِنَّ لي مِن وَرائِها","خَذولَي صِوارٍ بَينَ قُفٍّ وَأَجرَعا",8,"ع",2,0],["لَقُلتُ لَهُم إِذاً لَغَبَنتُموني","وَكَيفَ أَبيعُ مَن شَرِطَ الضَمانا",9,"ن",2,0],["لَقَلَّ امرُؤٌ تَلقاهُ لِلَّهِ شاكِراً","وَقَلَّ امرُؤٌ يَرضى لَهُ بِقَضاءِ",10,"ا",2,0],["لَقَلَّ الغِنى عَن صاحِبِ اللَحدِ وَالثَرى","بِما ذَرَفَت فيهِ العُيونُ الذَوارِفُ",11,"ف",1,0],["لَقَلَّ عَنكَ غَناءً","دَمعٌ عَلَيكَ هَتونُ",12,"ن",1,0],["لَقَلَّما يَتَخَطّاكَ اِختِلافُهُما","حَتّى يُفَرِّقَ بَينَ الروحِ وَالبَدَنِ",13,"ن",1,0],["لقلّبته ظهراً لبطن محيرا","به تحسبن الوجه من عبط قفا",14,"ف",2,0],["لَقُلْتُ وَقَالُوا فَاعْتَلَوْتُ وَخَفَّضُوا","وَلَيْسَ أَخُو صِدْقٍ كَمَنْ جَاءَ بِاللَّغْوِ",15,"و",1,0],["لقلتُ للسودِ سودوا","وقلتُ للبيضِ بيضوا",16,"ض",3,0],["لقلْتُ مِنْ مدنِ لظى","لكنني أجلُّها",17,"ل",3,0],["لَقُلتُ إِذا التَقَينا قَبِّليني","وَلَو كُنّا عَلى ظَهرِ الطَريقِ",18,"ق",1,0],["لَقُلتُ ذَروني ساعَةً وَكَلامَها","عَلى غَفلَةِ الواشينَ ثُمَّ اِقطَعوا عُمري",19,"ر",2,0],["لَقُلتَ أَلا يا لَيتَ سَعداً وَمالِكاً","قَذىً بِاِستِ شَيطانٍ أَصَمَّ رَجيمِ",20,"م",1,0],["لِقَلبٍ بِهِ قَرحَةٌ مِنهُمُ","أَلا إِنَّهُم رُبَّما أَقرَحُوا",21,"ح",3,0],["لَقُلتَ تِلكَ بِلادٌ نَبتُها سَقَمٌ","وَماؤُها العَذبُ سُمٌّ لِلفَتى ذابا",22,"ب",2,0],["لَقُلتُ ذَروني ساعَةً وَبُثَينَةً","عَلى غَفلَةِ الواشينَ ثُمَّ اِقطَعوا عُمري",23,"ر",2,0],["لَقُلتُ مِنَ القَولِ ما لا يَزا","لُ يُؤثِرُ عَنّي يَدَ المُسنِدِ",24,"د",1,0],["لقَلَّلَ من خَطوةِ جاهداً","كمشْيَةِ مُثْقلةٍ مُقرب!",25,"ب",1,0],["لَقُلْتُ فلا لا لا نعم وحقيقتي","شريعة من أحمى بوحيٍ حمائيا",26,"ي",2,0],["لقلت يا ساق هلا والوفاء كما","ترى تنكر هلا جدت بالثاني",27,"ن",2,0],["لَقُلْتُ أَنْ أَلْثِمَهُ","نَحْراً وَخَدّاً وَفَمَا",28,"م",2,0],["لِقَلبِهِ ناظِرا تَقوى سَما بِهِما","فَأَيقَظَ الفِكرَ تَرغيباً وَتَرهيبا",29,"ب",2,0],["لِقَلبِيَ مِن ذِكراكِ في كُلِّ خَطرَةٍ","تَلَهُّبُ شَوقٍ إِن عَدا لِيَ قاتِلُ",30,"ل",1,0],["لقلت إنهم أولاد طاغية","من الخوارج أو نفاثه العقد",31,"د",1,0],["لَقُلنا لكم حقّاً وإن كان باطلاً","وَلَم نرَ مِن هذا على ديننا ضرّا",32,"ر",2,0],["لِقليلٍ ممّا منحتَ قضاءٌ","هو منّي وللكثير اِقتضاءُ",33,"ا",2,0],["لقلت فتات المسك في حق مرمر","ألم ترها من غير شك محققه",34,"ه",1,0],["لقلت آها وآها واستعنت دما","هو المحجّب من أسرار وجداني",35,"ن",2,0],["لقلبي وعينيَّ منكِ هُدَى","ورَسمُكِ منهُ لجرحي إساء",36,"ا",2,0],["لقلتُ لها أَعدّي واستَعدّي","فإنّ الأمرَ أقحَمُهُ خطيرا",37,"ر",2,0],["لقَلْبِيَ أوْحَى بالتَّصَابِي تَقَلُّبٌ","مِنَ الغُصْنِ مُخْضلاً ثَنَتْهُ الصَّبا ثَنْيَا",38,"ي",2,0],["لِقَلبي عَن مُطاوَعَةِ اللَواحي","عَلى وَلَهي إِذا نَصَحوا نُشوزُ",39,"ز",1,1],["لَقلت معذّبي بِاللَه زِدني","أَلا يا قاتِلي بِيَد التَجَنّي",40,"ي",1,0],["لقَلْبي بَلابلُ تأْوي القُدودَ","حَكتْها بلابلُ تأْوي الغُصونا",41,"ن",2,0],["لقلعُ ضرسٍ ومَضغُ كِلسِ","وردُّ أمسٍ ويومُ نَحسِ",42,"س",1,1],["لِقَلْبَيْنَا منَ الإحساسِ دِفْءٌ","أرى جبلَ الجليدِ بهِ يَذُوبُ",43,"ب",1,0],["لِقَلبي في كُلِّ أُكرومَةٍ","شُجونٌ وَفي كُلِّ مَجدٍ شُعَب",44,"ب",1,0],["لقُلْتَ اغنموها ساعةَ الأُنس واسلموا","على غفلات الدَّهر من نوب الدَّهر",45,"ر",1,0],["لقلتُ شُدُّوا الأُزْر عن نسائكم","وحرِّموا من بعده المراضعا",46,"ع",2,0],["لقلبها مذهبٌ في الصمت يلزمهُ","وللوشاح خلافٌ كلهُ جدلَ",47,"ل",1,0],["لقلت سقى الرحمن أيام جودكم","فقد بعدت عني وطال بها عهدي",48,"د",2,0],["لَقُلنا لَهُ شِبه وَلكِن تَعذَّرت","سَواكَ عَلى المُستَشفِعين المَطالِب",49,"ب",1,0],["لَقَلَّ غَناءُ العتبِ والمجرمُ الدَهرُ","وضلّتْ أمانٍ لا يُبَلَّغُها العُمرُ",50,"ر",1,1]]}