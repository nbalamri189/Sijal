om/ViewPoem.aspx?id=191812",""],[592,"فليس بنظم مستقم ولم يكن","https://www.poetsgate.com/ViewPoem.aspx?id=128801",""],[5376,"بأيِّ الذنبِ ذاك الطفلُ يُقْتلْ","https://www.poetsgate.com/ViewPoem.aspx?id=196896",""],[5431,"لهذا القلب قد أودعتُ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=185436",""],[5431,"لروحك قد زرعتُ الكون عشقا ..","https://www.poetsgate.com/ViewPoem.aspx?id=191109",""],[5431,"أي صبرٍ على الطُوى رمضانُ","https://www.poetsgate.com/ViewPoem.aspx?id=198195",""],[5431,"لأنك خبزي الأسمر ...","https://www.poetsgate.com/ViewPoem.aspx?id=198413",""],[5582,"هوَ الدَّهْرُ فِينا جائِدٌ غَيْرُ جائِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186912",""],[243,"ليلة القدر","https://www.poetsgate.com/ViewPoem.aspx?id=20959",""],[5937,"قانون جذبها","https://www.poetsgate.com/ViewPoem.aspx?id=211881",""],[6031,"لقَلَّدْتَنِيها مِنَّةً لَيسَ تُجْحَدُ","https://www.poetsgate.com/ViewPoem.aspx?id=46341",""],[6093,"مثل ثيابي","https://www.poetsgate.com/ViewPoem.aspx?id=206924",""],[6152,"متاهات نبض","https://www.poetsgate.com/ViewPoem.aspx?id=204730",""],[6239,"النشيد العالي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75976&r=&rc=27",""]],"verses":[["لِقَلبي بِغَورَيَّ البِلادِ لُبانَةٌ","وَإِن كُنتُ مَسدوداً عَلَيَّ المَطالِعُ",0,"ع",1,1],["لِقَلعُ ضِرسٍ وَضَربُ حَبسِ","وَنَزعُ نَفسٍ وَرَدُّ أَمسِ",1,"س",1,1],["لقُلْتُ ورْدٌ منَ الأيْدي لَها شجَرٌ","ومن أنامِلِهنّ الخَمْسُ أقْماعُ",2,"ع",1,0],["لَقُلتُ مِنَ القَولِ ما لا يَز","لُ يُؤثِرُ عَنّي يَدَ المُسنِدِ",3,"د",1,0],["لقلوبها أرب وحيدٌ شاملٌ","ومآرب الناس العداد عداد",4,"د",1,0],["لَقُلتُ لها قَد كانَ ذَلِكَ مَرَّةً","ولَستُ على ما قَد عَهدتُ بِقادِرِ",5,"ر",1,0],["لقَلْبِ الفقيرِ الحطيم الكسيرِ","ودَمْعِ الأَيامَى السَّفيحِ الذَّريفْ",6,"ف",1,0],["لَقَلبي لِبُعدك عَنّي عَليلُ","فَشَوقي صَحيحٌ وَجِسمي عَليلُ",7,"ل",1,1],["لَقُلتُ اِرجِعَنها إِنَّ لي مِن وَرائِها","خَذولَي صِوارٍ بَينَ قُفٍّ وَأَجرَعا",8,"ع",2,0],["لَقُلتُ لَهُم إِذاً لَغَبَنتُموني","وَكَيفَ أَبيعُ مَن شَرِطَ الضَمانا",9,"ن",2,0],["لَقَلَّ امرُؤٌ تَلقاهُ لِلَّهِ شاكِراً","وَقَلَّ امرُؤٌ يَرضى لَهُ بِقَضاءِ",10,"ا",2,0],["لَقَلَّ الغِنى عَن صاحِبِ اللَحدِ وَالثَرى","بِما ذَرَفَت فيهِ العُيونُ الذَوارِفُ",11,"ف",1,0],["لَقَلَّ عَنكَ غَناءً","دَمعٌ عَلَيكَ هَتونُ",12,"ن",1,0],["لَقَلَّما يَتَخَطّاكَ اِختِلافُهُما","حَتّى يُفَرِّقَ بَينَ الروحِ وَالبَدَنِ",13,"ن",1,0],["لقلّبته ظهراً لبطن محيرا","به تحسبن الوجه من عبط قفا",14,"ف",2,0],["لَقُلْتُ وَقَالُوا فَاعْتَلَوْتُ وَخَفَّضُوا","وَلَيْسَ أَخُو صِدْقٍ كَمَنْ جَاءَ بِاللَّغْوِ",15,"و",1,0],["لقلتُ للسودِ سودوا","وقلتُ للبيضِ بيضوا",16,"ض",3,0],["لقلْتُ مِنْ مدنِ لظى","لكنني أجلُّها",17,"ل",3,0],["لَقُلتُ إِذا التَقَينا قَبِّليني","وَلَو كُنّا عَلى ظَهرِ الطَريقِ",18,"ق",1,0],["لَقُلتُ ذَروني ساعَةً وَكَلامَها","عَلى غَفلَةِ الواشينَ ثُمَّ اِقطَعوا عُمري",19,"ر",2,0],["لَقُلتَ أَلا يا لَيتَ سَعداً وَمالِكاً","قَذىً بِاِستِ شَيطانٍ أَصَمَّ رَجيمِ",20,"م",1,0],["لِقَلبٍ بِهِ قَرحَةٌ مِنهُمُ","أَلا إِنَّهُم رُبَّما أَقرَحُوا",21,"ح",3,0],["لَقُلتَ تِلكَ بِلادٌ نَبتُها سَقَمٌ","وَماؤُها العَذبُ سُمٌّ لِلفَتى ذابا",22,"ب",2,0],["لَقُلتُ ذَروني ساعَةً وَبُثَينَةً","عَلى غَفلَةِ الواشينَ ثُمَّ اِقطَعوا عُمري",23,"ر",2,0],["لَقُلتُ مِنَ القَولِ ما لا يَزا","لُ يُؤثِرُ عَنّي يَدَ المُسنِدِ",24,"د",1,0],["لقَلَّلَ من خَطوةِ جاهداً","كمشْيَةِ مُثْقلةٍ مُقرب!",25,"ب",1,0],["لَقُلْتُ فلا لا لا نعم وحقيقتي","شريعة من أحمى بوحيٍ حمائيا",26,"ي",2,0],["لقلت يا ساق هلا والوفاء كما","ترى تنكر هلا جدت بالثاني",27,"ن",2,0],["لَقُلْتُ أَنْ أَلْثِمَهُ","نَحْراً وَخَدّاً وَفَمَا",28,"م",2,0],["لِقَلبِهِ ناظِرا تَقوى سَما بِهِما","فَأَيقَظَ الفِكرَ تَرغيباً وَتَرهيبا",29,"ب",2,0],["لِقَلبِيَ مِن ذِكراكِ في كُلِّ خَطرَةٍ","تَلَهُّبُ شَوقٍ إِن عَدا لِيَ قاتِلُ",30,"ل",1,0],["لقلت إنهم أولاد طاغية","من الخوارج أو نفاثه العقد",31,"د",1,0],["لَقُلنا لكم حقّاً وإن كان باطلاً","وَلَم نرَ مِن هذا على ديننا ضرّا",32,"ر",2,0],["لِقليلٍ ممّا منحتَ قضاءٌ","هو منّي وللكثير اِقتضاءُ",33,"ا",2,0],["لقلت فتات المسك في حق مرمر","ألم ترها من غير شك محققه",34,"ه",1,0],["لقلت آها وآها واستعنت دما","هو المحجّب من أسرار وجداني",35,"ن",2,0],["لقلبي وعينيَّ منكِ هُدَى","ورَسمُكِ منهُ لجرحي إساء",36,"ا",2,0],["لقلتُ لها أَعدّي واستَعدّي","فإنّ الأمرَ أقحَمُهُ خطيرا",37,"ر",2,0],["لقَلْبِيَ أوْحَى بالتَّصَابِي تَقَلُّبٌ","مِنَ الغُصْنِ مُخْضلاً ثَنَتْهُ الصَّبا ثَنْيَا",38,"ي",2,0],["لِقَلبي عَن مُطاوَعَةِ اللَواحي","عَلى وَلَهي إِذا نَصَحوا نُشوزُ",39,"ز",1,1],["لَقلت معذّبي بِاللَه زِدني","أَلا يا قاتِلي بِيَد التَجَنّي",40,"ي",1,0],["لقَلْبي بَلابلُ تأْوي القُدودَ","حَكتْها بلابلُ تأْوي الغُصونا",41,"ن",2,0],["لقلعُ ضرسٍ ومَضغُ كِلسِ","وردُّ أمسٍ ويومُ نَحسِ",42,"س",1,1],["لِقَلْبَيْنَا منَ الإحساسِ دِفْءٌ","أرى جبلَ الجليدِ بهِ يَذُوبُ",43,"ب",1,0],["لِقَلبي في كُلِّ أُكرومَةٍ","شُجونٌ وَفي كُلِّ مَجدٍ شُعَب",44,"ب",1,0],["لقُلْتَ اغنموها ساعةَ الأُنس واسلموا","على غفلات الدَّهر من نوب الدَّهر",45,"ر",1,0],["لقلتُ شُدُّوا الأُزْر عن نسائكم","وحرِّموا من بعده المراضعا",46,"ع",2,0],["لقلبها مذهبٌ في الصمت يلزمهُ","وللوشاح خلافٌ كلهُ جدلَ",47,"ل",1,0],["لقلت سقى الرحمن أيام جودكم","فقد بعدت عني وطال بها عهدي",48,"د",2,0],["لَقُلنا لَهُ شِبه وَلكِن تَعذَّرت","سَواكَ عَلى المُستَشفِعين المَطالِب",49,"ب",1,0],["لَقَلَّ غَناءُ العتبِ والمجرمُ الدَهرُ","وضلّتْ أمانٍ لا يُبَلَّغُها العُمرُ",50,"ر",1,1],["لِقَلبي ما تَهمي العُيونَ وَتَأرَقُ","وَلِلعَينِ ما يُبلى الفُؤادُ وَيُرهِقُ",51,"ق",1,1],["لقلت للقلب خفف","من زفرة ووميض",52,"ض",1,0],["لقلبيَ أولى أن يذوبَ تفطراً","وعيني بِقاني الدمع تهمي وتذرف",53,"ف",1,0],["لِقَلْبي أنِينٌ لاَ يَزَالُ مِنَ الْجَوى","وَجَفْني قَرِيحٌ قَدْ أَضَرَّ بِهِ النَّوى",54,"ن",3,1],["لَقُلْتُ يَوْماً أوْ بَعْضَ يَوْمٍ","أوْ زَوْرَةَ الطَّيْفِ فِي المَنَامِ",55,"م",1,0],["لَقُلتَ جِلفٌ مِن بَني دارِمٍ","حَنَّ إِلى الشِّيحِ بِيَبرينِ",56,"ن",1,0],["لَقَلَّ ما أَبقى عَلى ما أَرى","يوشِكُ أَن يَنعانِيَ الناعي",57,"ع",2,0],["لقلت للسح من أيدي الوزير إذا","حللت بناحلة الأطلال لا ترم",58,"م",1,0],["لقلتُ قولَ أخى وَجدٍ محبَّتُهُ","طبعٌ وما طبعُ مخلوقٍ بمُنتقِلِ",59,"ل",1,0],["لقلتُ ثيا سُؤلى وكُلَّ المنى","خُذها ولا تهجُر ولا تغضَبِ",60,"ب",1,0],["لقلوبُها امتحنَ الإلهُ بموقفٍ","مَحضتهُ فيه صَبرها وبلاءها",61,"ا",3,0],["لقلت عساها أن تعيش وأنها","ستنشر من جرا عيون تزورها",62,"ر",3,0],["لقلت هو الفريد بكل مجد","لنا في جوده أبدا طماح",63,"ح",1,0],["لَقُلتُ لِلراحِلِ اِرحَل","إِذا بَدا لَكَ أَو دَع",64,"ع",1,0],["لَقُلتُ لِدَهري إِنَّهُ هُوَ غُزوَتي","وَإِنّي وَإِن أَرغَبتَني غَيرُ فاعِلِ",65,"ل",1,0],["لقل إذا للطعن من آل طالب","رجال تعد الموت أبهج زادها",66,"د",3,0],["لقلبي أنت في الأسواق ساب","ونحوك ذاك بالأشواق سابق",67,"ق",1,0],["لَقُلْتُ فيك مَقالا لو أَبوح به","كي يسمعوه لقالوا عابِد الصَّنَمِ",68,"م",1,0],["لَقَلبٌ بِنُورِ الله دَوماً مُقَيَّمُ","سَلاَ قَلبُهُ الأَغيارَ مِن كُلِّ وِجهَةٍ",69,"ه",1,0],["لقلبي من أوامرهِ","لأخواني معا جندي",70,"د",2,0],["لقلت للنفس خلّ الصبر وانفطري","فالعيش بعد الموالي مر مجناه",71,"ا",2,0],["لقلوبٍ دنت إليه اشتياقا","فكساها مهابةً وجمالا",72,"ل",2,0],["لقلوبٍ قد تولَّتْ","عن زخارفِ الجِنانِ",73,"ن",1,0],["لقلت بلا خوفٍ من الناس أنه","جرابٌ إذا فتشتَ فيه عظام",74,"م",1,0],["لَقُلنا لَها بَيني بِلَيلٍ حَميدَةً","كَذاكَ بلا ذَمٍّ تُؤَدّى الوَدائِعُ",75,"ع",1,0],["لقلت قفوا ان المقام ممنع","ولم يدرك الكنه العظيم ويلحق",76,"ق",1,0],["لقلت له فيما ألِمّ برمْسِهِ","هَلَ أنتَ غداً معي فمصاحبي",77,"ب",2,0],["لِقَلبي دُيون ما قَضيت حُقوقها","مَتّى يا ظِباء الواد تَقضينني دَيني",78,"ن",2,0],["لِقَلبي في مَعناهُ سِرّاً تفكر","وَللعينِ في مرآهُ جَهراً تلمحُ",79,"ح",1,0],["لقلت أما تدري بأن ضرورتي","أباحت لي المحظور في ذلك المدح",80,"ح",1,0],["لقلت مشهدهم أهوى ولو تلفت","روحي أسى وجوى يا ليت ذلك لي",81,"ل",2,0],["لقلت له ولم أكثر ملاما","عجلت فكنت أظلم من زياد",82,"د",1,0],["لِقلُوب فِيْ ليهوب نيران","واهل الهوى الحب ابتلوا به",83,"ب",2,0],["لقلَّ غَناءُ القولِ إنّكَ حالِمٌ","إذا أنتَ لم تَعدِلْ بقلبكَ مَعْدِلا",84,"ل",2,0],["لقل له أن تحبس العيس ساعةً","عليك فتبكيك الرسوم الطوامس",85,"س",1,0],["لقَلْبيَ في أيْدي الغرامِ تقَلُّبُ","يُذادُ عنِ العُتْبى وإنْ كان يُعْتَبُ",86,"ب",1,0],["لِقَلبي فَمن رَوع البِعادِ يُريحهُ","مَليحٌ غَرامي فيهِ طالَت شُروحُه",87,"ه",1,0],["لقلبي نشوة لم تأتي حتى","تبل القهوة السودا أوامي",88,"ي",1,1],["لقلتَ أَلا يا قومُ رِقُّوا لنائحٍ","فقيدِ حبيبٍ قد أضرَّ بهِ الفَقدُ",89,"د",1,0],["لقلتُ لا جادها صوبُ الحيا أبداً","إلا بناقعِ سُمٍّ أو عبيطِ دمِ|",90,"م",1,0],["لقلت والربَّ أرجو","قال الإله القديم",91,"م",1,0],["لقلبي نوِّرَنْ ونوِّرْ جسمي","وعلِّمَنّي ونوِّرْ علمي",92,"ي",1,0],["لِقَلبِ العُداةِ بِثَبتِ القَدَم","دَعا قَومَهُ حَنِقاً وَهَجَم",93,"م",1,0],["لقلت يا موماو هل عندكم","لي صبغة أو فلفل من شعر",94,"ر",1,0],["لِقَلبي اِن سَلاكَ صَلى بِنار","بِها تَكوى حَشاشاتي بِناني",95,"ن",2,0],["لَقُلتُ أَنا هُم دائِماً وَهُمُ أَنا","فهذا اعِتقادي فِيكمُ وكَلامي",96,"م",2,0],["لقلبي وعيني يوم زمت بك النجب","لهيبٌ وسحبٌ يا لخدود لها سحب",97,"ب",1,1],["لقلبي سرور عند ذكري لزنبل","ويرتاح مني كل عضوٍ ومفصل",98,"ل",1,1],["لقلبٍ عاشَ في الصبواتِ","ممزوجا ومغموسا",99,"س",2,0],["لقلبي في مهاوي الحب أهوى","غزالٌ لمحاسن منهُ أهوى",100,"و",2,1],["لقلبٍ في الهوى هاوٍ","عليه الآيُ كم تُليتْ",101,"ت",1,0],["لَقُلْتُ وَحْدِيْ أُعَانِي ، آهِ وَا كَبِدِيْ","وَيَا لَبُؤْسِي وَذِي الْآمَالُ تَرْتَعِدُ",102,"د",1,0],["لقليل بأن نسيل على مص","رعه أنفسٌ كما الغيث سالا",103,"ل",2,0],["لقلت من الأملاك لكن يردني","اذا جئت مغناه تبدي لي البشر",104,"ر",1,0],["لقلبك المنتشي طعمٌ وقبلته","طافت على شفتي كل الأحايين",105,"ن",1,0],["لقلة أهل الحكم بالحكم عندما","تجيء الخطوب المعضلات من الزلل",106,"ل",1,0],["لقلبٍ قد تلهَّفَ بعدَ عشْقٍ","تناءى الخطو منه ما تأمَّلْ",107,"ل",1,0],["لقلبٍ ما ترصَّع بالنقاء","به نبعٌ يفيضُ بلا انتهاءِ",108,"ا",2,1],["لقلبك قد جُعلتُ مع القوافي","أسيلُ على خوابي الحرف شوقا",109,"ق",2,0],["لقلوبٍ تسارعت في هطولٍ","مثل غيمٍ يسوقه الإيمانُ",110,"ن",1,0],["لقلبي خير من أغوى","لروحي خير من أسكر",111,"ر",1,0],["لَقُلْنا لَعَلَّ الجِنَّ قَدْ صَعِدَتْ بِهِمْ","وَأَلْقَتْهُمُ فِي رأْسِهِ المُتَصاعِدِ",112,"د",1,0],["لقلت واضعية الاسلام في بلد","بالأمس أعلى منار الحق ثم خبا",113,"ب",2,0],["لقلبيَ منها أن يُضاءَ بنظرةٍ","لها منه أن تجني الضياء بحطْبِهِ",114,"ب",2,0],["لقَلَّدْتَنِيها مِنَّةً لَيسَ تُجْحَدُ","وأَسْدَيتَها عن