با البلاد الذي تسمو البلاد به","https://www.aldiwan.net/poem61352.html","البسيط"],[461,"دع بين جِلدي والعظام مكانا","https://www.aldiwan.net/poem55851.html","الكامل"],[461,"ذكر العيش بالحمى فبكى له","https://www.aldiwan.net/poem55940.html","الخفيف"],[461,"در لها خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[461,"الليل بعد اليأس أطمع ناظري","https://www.aldiwan.net/poem56175.html","الكامل"],[461,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[461,"يا قلب من أين على فترة","https://www.aldiwan.net/poem56272.html","السريع"],[464,"هبني كتمت لواعج البرحاء","https://www.aldiwan.net/poem15279.html","الكامل"],[464,"ما غاب باهر مجد عم شارقه","https://www.aldiwan.net/poem16144.html","البسيط"],[480,"برق تألق من تهامه","https://www.aldiwan.net/poem15205.html","مجزوء الكامل"],[480,"آليت لا حلت ولا حلتم","https://www.aldiwan.net/poem15270.html","السريع"],[482,"ظلموك يا جدي ولست ظلوما","https://www.aldiwan.net/poem37194.html","الكامل"],[503,"رعى الزمان فرأى العجائبا","https://www.aldiwan.net/poem37663.html","الرجز"],[503,"ما انبلج الصباح في طالعه","https://www.aldiwan.net/poem37820.html","الرجز"],[518,"لو اطلعت على سري وإضماري","https://www.aldiwan.net/poem12126.html","البسيط"],[543,"ياذا المنوه تدعوني لتسمعني","https://www.aldiwan.net/poem56644.html","البسيط"],[547,"المتنبي .. كون في ملامح كائن","https://www.aldiwan.net/poem67242.html","عموديه"],[554,"صارمت بعدك أشجاني فلا تلم","https://www.aldiwan.net/poem47218.html","البسيط"],[554,"ما الحب إلا موئل المتعلل","https://www.aldiwan.net/poem47295.html","الكامل"],[556,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[561,"من كان بالله أنسه","https://www.aldiwan.net/poem34433.html","المجتث"],[561,"إني أنا جسم فنفس فروح","https://www.aldiwan.net/poem34668.html","السريع"],[562,"يا حاضرا في فؤادي","https://www.aldiwan.net/poem69368.html","المجتث"],[565,"نحن النصارى آل عيسى المنتمي","https://www.aldiwan.net/poem52748.html","الكامل"],[565,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[566,"أحداج تلك الجمال","https://www.aldiwan.net/poem13601.html","المجتث"],[578,"الصبر بعدك لا يكون","https://www.aldiwan.net/poem2774.html","مجزوء الكامل"],[578,"هيهات ما حالي كحالك","https://www.aldiwan.net/poem3043.html","مجزوء الرمل"]],"verses":[["ما غَرَّني يَومَ اللِقاءِ وَلا","خَدَعَ اِرتِياحَ هَوايَ رَيَّقُهُ",0,"ق",2,0],["ما غاضَ دَمعِيَ إِلّا بَعدَما اِنحَدَرَت","غُروبُهُ بَينَ مُنهَلٍّ وَمُنهَمِعِ",1,"ع",1,0],["ما غابَ مِنّا غائِبٌ فَآبا","وَرُبَّ حَيٍّ دَعَموا القِبابا",2,"ب",2,0],["مَا غَيْرتْ مِنْكَ الْخُطُوبُ سَجِيَّةً","مَجْبُولَةً وَالَطَّبْعُ لاَ يُتَنَقَّلُ",3,"ل",1,0],["ما غَضّ منّي أنْ أخْلَفْتَ موْعودي","ورَوْضُ خدِّكَ أضْحى ذاوِيَ العودِ",4,"د",1,1],["ما غَرّدَتْ وَرْقاءُ فوقَ أراكَةٍ","تَبْكي الهَديلَ وما صَباحٌ لاحا",5,"ح",2,0],["ما غاظَهُم غَيرَ ما سَيَّرتُ مِن مِدَحٍ","في صائِكِ المِسكِ مِن أَنفاسِها فَنَعُ",6,"ع",1,0],["ما غبت عنا كيف غيبة من لنا","في كل مكرمةٍ بها استشهاد",7,"د",1,0],["ما غابَ عَنها سُرورُ مُلكٍ","عادَ إِلى بَلدَةٍ سِواها",8,"ا",3,0],["ماغَضَّ مِنّي حادِثٌ","وَالقَرمُ قَرمٌ حَيثُ حَلّا",9,"ل",2,0],["ما غابَ عنَّا سرَى شخص لوالدِه","وعلمهُ والتُّقى والجود لم يغب",10,"ب",1,0],["ما غرَّهم منا ونحن الأُلى","لم يُرَ في سلطانهم خاربُ",11,"ب",1,0],["ما غَلِيلٌ لم يَسْقِهِ بمساعي","ه وجَدْوَى يديْهِ بالمَبْرودِ",12,"د",1,0],["ما غَدٌ يا مَن يُصَوِّرُهُ","لِيَ شَيئاً رائِعاً عَجِبا",13,"ب",2,0],["ما غابَ ماءٌ غابَ تَحتَ الثَرى","فَأَطلَعَ النَبت وَأَحيا المَوات",14,"ت",1,0],["ما غابَ عَنّا وَكَأَنّي بِهِ","يَفصِلُهُ عَن صَحبِهِ أَلفُ عام",15,"م",1,0],["ما غالَ نَومي حُبُّ مَعسولِ اللِمى","مَمنوعِهِ لَكِن هَوى الأَوطانِ",16,"ن",1,0],["ما غَيَّرَ البُعدُ سِوى جِسمِهِ","وَلَم يُغَيِّر صَفوَ أَخلاقِهِ",17,"ق",2,0],["ما غشني وأضلني","إلا نصائح نجدلي",18,"ل",2,0],["ما غَربت شَمسُ نَهار الباس","حَتّى بَدَت شَمسُ بَني العَباسِ",19,"س",1,0],["ما غَمَّضَت عَينٌ لِفَقدِ خَيالِهِ","وَالقَلبُ فيهِ بَلابِلُ الوَسواسِ",20,"س",1,0],["ما غَرَّكُم مِنهُ وَقَد جَرَّبتُمُ","سَطَواتِهِ في سالِفِ الأَعوامِ",21,"م",1,0],["ما غابَ عَنهُم غَيرُ نُزعَةِ أَشيَبٍ","مَكسُوَّةٍ صَدَأً وَشَيبَةَ أَنزَعِ",22,"ع",1,0],["ما غاضَ دَمعي عِندَ نازِلَةٍ","إِلّا جَعَلتَكَ لِلبُكا سَبَبا",23,"ب",2,1],["ما غَبَنَ المَغبونَ مِثلُ عَقلِهِ","مَن لَكَ يَوماً بِأَخيكَ كُلِّهِ",24,"ل",2,0],["ما غابَ عَنكُم مِنَ الإِقدامِ أَكرَمُهُ","في الرَوعِ إِذ غابَتِ الأَنصارُ وَالشِيَعُ",25,"ع",1,0],["ما غَصَّ بِالدَمعَةِ إِلّا هَفا","فَاِنظُر تَجِد ثُمَّ السِوارَ الوِشاح",26,"ح",1,0],["ما غرّهم بابن محمودٍ أما علموا","أنّ الرئيس لمجدِ النّيلِ عُنوانُ",27,"ن",1,0],["ما غرّكم بقضاءِ اللهِ يُرسله","على يَدَيْ بطلٍ أعظم به بطلا",28,"ل",2,0],["ما غرَّهم إذ أطاعوا أمرَ جاهِلهم","بواحدٍ غالبِ السُّلطانِ قهَّارِ",29,"ر",1,0],["ما غَرَّ مَن تَسري عَقارِبُهُ","مِن أُسدِ غيلٍ تَرقُبُ الفُرَصا",30,"ص",2,1],["ما غَرَّكُم مِنها تَقادُمُ عَهدِها","في الدَنِّ غَيرَ حُشاشَةٍ صَفراءِ",31,"ا",2,0],["ما غَضَبي مِن شَتمِ أَحبابي","أَعظَمُ مِن شَتمِهِمُ ما بي",32,"ب",2,1],["ما غِبتَ عَنها بِأَرضٍ لا تَحَلُّ بِها","إِلّا دَعاكَ إِلَيها القَلبُ وَالكَبِدُ",33,"د",1,0],["ما غابَ اِسحاقُ البَرايا عَنهُمُ","فَاِسأَل بَني يَعقوبَ عَن اِسحاقا",34,"ق",2,1],["ما غالب الطبع امرؤ","إلا وطبعه غلب",35,"ب",1,0],["ما غادر الموجُ بهِ قائما","يوم احتوى الأعلامَ طوفانُ نوحْ",36,"ح",1,0],["ما غابَ عَنها مَرَّةً","حَتّى تَغَيَّبَ في التُراب",37,"ب",1,0],["ما غادرا بلداً إلا إلى بلد","والحر يلهب من خدي مسافره",38,"ر",2,0],["ما غاضَ بَعدَكَ ثُكلي","إِلّا بَكَيتُ فَزِدتُه",39,"ت",2,0],["ما غنائي بالذكر يبقى جميلاً","حين أمسى تحت الصفائح رَهْنَا",40,"ن",2,0],["ما غَلَبْتَ النفُوسَ بِالْعَزْمِ لَكِنْ","هَكَذَا يغْلِبُ الْكَثِيرُ الْقَلِيلاَ",41,"ل",2,0],["ما غبتَ عن بصر البلاد وسمعها","يومًا، ولا بعدت ركابُك ميلا",42,"ل",2,0],["ما غاض من عيني رأيت عديله","من طرف داجية وطرف نهار",43,"ر",1,0],["ما غض مني أن أخلفت موعود","وروض خدك أضحى ذاوي العود",44,"د",1,1],["ما غردت وأرقاء فوق أراكة","تبكي الهديل وما صباح لاحا",45,"ح",2,0],["ما غمَّضتْ عَيْنٌ لِفقدِ خَيَالهِ","والقلبُ فِيهِ بَلاَبِلُ الوسوَسِ",46,"س",1,0],["ما غرَّهم منا ونحن الأُولى","لم يُرَ في سلطانهم خاربُ",47,"ب",1,0],["ما غن أشدتُ بذكرها، لكنهُ","غُلِبَ العَزَاءُ، وَبُحْتُ بِکلكِتْمَانِ",48,"ن",1,0],["ما غبت عنه لحظةى","وهكذا دين الهوى",49,"و",2,0],["ما غبت عن قلبي وان غبت عن","عيني وهذا القلب والعين لك",50,"ك",1,0],["ما غاب شخصك لحظة عن خاطري","يا من تربع في منصة بالي",51,"ل",2,0],["ما غبت عن عيني وذكرك لم يزل","وردي اردده مع الانفاس",52,"س",1,0],["ما غاب بدر في السماء بغيهب","الا ذكرت مطالع الغياب",53,"ب",1,0],["ما غبتمو عن ناظري طرفة","كذا قضى الباري ولا مهربا",54,"ب",2,0],["ما غبت عنه وغبت فيه عن السوى","قسماً بأسرار الرسول وآله",55,"ل",2,0],["ما غر قفصَةَ إلا أنها اجترمت","فلم يكن عندَ أهلِ الحُلمِ تَثريبُ",56,"ب",1,0],["ما غردتْ ورْقاءُ أو هبت صَباً","بين الغصون وما هَمَى مُسْحَنْفِرُ",57,"ر",1,0],["ما غرَّهُمُ بهزبرِ وغىً","حلقُ الماذيِّ لهُ لِبَدُ",58,"د",1,0],["ما غَيظُ مَن يَبغي مَحَلَّكَ ضِلَّةً","إِلّا كَغَيظِ ضَرائِرِ الحَسناءِ",59,"ا",2,0],["ما غَضَّ مِنهُ طُلوعُها مِن قَبلِهِ","إِذ كانَ أَبهى في العُيونِ وَأَرفَعا",60,"ع",2,0],["ما غَضَّ فيهِم وَالقُلوبُ قَريبَةُ ال","أَهواءِ أَن يَتَباعَدوا أَرحاما",61,"م",2,0],["ما غارت الرحمت إِلا هكذا","أما على أهل البصائر ما اختفى",62,"ف",2,0],["ما غِبتَ عَن قَلبي فَدَيتُكَ لَحظَةً","وَكَفى بِقَلبِكَ لي بِذاك شَهيدا",63,"د",2,1],["ما غاب في ملحده يّتٌ","في الوقت إلا جاء مولود",64,"د",1,0],["ما غَبطنا الملوكَ لكن غَبطنا","كُم على نيل أحسن الحالاتِ",65,"ت",1,0],["ما غبتَ عنّي لحظةً","إلا تمثَّل لي مثالُكْ",66,"ك",1,0],["ما غاب إلا هامَ قلبي نحوه","شوقاً وكدتُ من الوساوس أُحشرُ",67,"ر",1,0],["ما غاب عنّيَ بل غاب السرورُ به","فصرت أبكي فقيداً غير مفتَقَدِ",68,"د",1,0],["ما غنت الورقا على عودها","بكل معنى في الهنا آهل",69,"ل",1,0],["ما غردت ورق وما","مالت بهن القضب",70,"ب",1,0],["ما غردت ورقاء في ابكة","ومالت الاغصان بالزهر",71,"ر",1,0],["ما غردت ورق الرياض وما غدت","لكليم وجد بالغرام تناجي",72,"ج",2,0],["ما غردت ورق على ايكة","وجادت الافياء بالظل",73,"ل",1,0],["ما غنت الورقا على عود وما","أغنت بمعربها عن التلحين",74,"ن",1,0],["ما غاية الحسن من محب","الحسنُ من أجله شريدُ",75,"د",1,0],["ما غاية العيش من دنيا أعيش بها","بخافق حائر الأحلام ظمآن",76,"ن",1,0],["ما غزتني كتائب البَثّ حتى","جعلوا موعد التلاقي بغزّهْ",77,"ز",2,0],["ما غاله يوماً ولا أعياه","ما رَمَقتْ في الجوّ مُقْلتَاه",78,"ا",2,0],["ما غابَ في التُربِ وَلَكِن كَوكَبٌ","رَقى إِلى جَوِّ السَماءِ وَصَعِد",79,"د",1,0],["ما غرني فيه الاكثر مقتحمي","ضنكا واني على العلات صبار",80,"ر",1,0],["ما غردت وَرق الحَمام وَما اِنثَنَت","عذب البشام ضحى بروح الارنب",81,"ب",1,0],["ما غردت ورق الحَمائم في الحمى","وَسَرى عَلى عَذب العَذيب نَسيم",82,"م",1,0],["ما غُرّةُ العِيد أَجْتَلِيها","يَوْمُ رضاك الأغَرُّ عِيدِي",83,"د",2,0],["ما غَنَّتِ الوُرقُ سُحَيراً وَما","زَقَت دُيوكٌ آذَنَت بِالأَذان",84,"ن",1,0],["ما غِناءُ الحَمامِ في عَذَباتِ ال","بانِ إِلا الحِمامُ لِلعُشّاقِ",85,"ق",1,0],["ما غُلَّ في الحَربِ وَلَكِن غَلَّ أَي","دي عُصَبِ الكُفرِ إِلى أَعناقِها",86,"ق",3,0],["ما غادَةٌ راكِبَةُ النَّسرِ وَقَد","بَدَت لِأَبصارِ الوَرى نُقوشُها",87,"ش",3,1],["ما غَنَّتِ الوُرقُ في الأَغصانِ صادِحَةً","تَهُزُّهُنَّ صَبا نَجدٍ بِتَحريشِ",88,"ش",1,0],["ما غَرَّدَت وَرقاءُ في أَيكَةٍ","فَجاوَبَتها أُختُها في النَواح",89,"ح",1,0],["ما غدا ناصرها النا","صر كبرق في رعود",90,"د",1,0],["ما غاب صنوك والرياسة بعده","لفريد اذ خدم الكمال مجانا",91,"ن",2,0],["ما غنَّت الورقُ في رياضٍ","وأَطربَ السجعُ والهَديلُ",92,"ل",1,0],["ما غرَّدت وَرقاءُ في رَوضَةٍ","وَما زهت أَغصانُها الميَّسُ",93,"س",1,0],["ما غرَّدَت في الرَوضِ أَيكيَّةٌ","وَزَمزَمَ الحادي بِوادي زَرود",94,"د",1,0],["ما غَرَّدت في الروض أَيكيَّةٌ","وَما زهت أَغصانُها الميَّدُ",95,"د",1,0],["ما غابت الشمسُ حتى أشرقَ القمرُ","محمد فارتضاه اللَه والبشرُ",96,"ر",1,1],["ما غَرّدت ورقُ الحمى سحراً وَما","حنّت لِسجع الصَبّ في تَغريدهِ",97,"د",2,0],["ما غَرَّدَت في ورقٍ وُرقُ الحِمى","فَأعرَبَت عَن طيب ذكراهم ثَنا",98,"ا",1,0],["ما غَرّبت شَمسٌ وَما لَيلٌ دَجا","ما لاحَ نجمٌ أَو سَنا صُبح أَضا",98,"ا",1,0],["ما غابَ عن غابِه يوماً لصَيْدِ عُلاً","وناب عن نابِه سَيفٌ يُعَرّيه",99,"ي",2,0],["ما غَضَّ أَعيُنَها زُهْرُ النّجومِ متَى","رأَيْنَ شَيْبَ صباحٍ للدُّجَى وَخَطا",100,"ط",2