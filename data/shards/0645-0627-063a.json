{"poems":[[53,"لو صح أن البين يعشقه","https://www.aldiwan.net/poem29955.html","السريع"],[53,"صبرت عنك فلم ألفظك من شبع","https://www.aldiwan.net/poem30133.html","البسيط"],[53,"لا لوم للدهر ولا عتابا","https://www.aldiwan.net/poem30736.html","الرجز"],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[77,"ما غض مني أن أخلفت موعودي","https://www.aldiwan.net/poem36582.html","البسيط"],[77,"خذها فقد وضح الصباح ولاحا","https://www.aldiwan.net/poem36645.html","الكامل"],[73,"هل النداء الذي أعلنت مستمع","https://www.aldiwan.net/poem11935.html","البسيط"],[93,"يا دار أهلك بالسلامة عادوا","https://www.aldiwan.net/poem9833.html","الكامل"],[54,"بغداد دار الملوك","https://www.aldiwan.net/poem27452.html","مجزوء البسيط"],[47,"قف في رسوم المستجا","https://www.aldiwan.net/poem25172.html","مجزوء الكامل"],[72,"نعاه للفضل والعلياء والنسب","https://www.aldiwan.net/poem18241.html","البسيط"],[51,"نجاك يا ابن الحاجب الحاجب","https://www.aldiwan.net/poem8294.html","السريع"],[51,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[91,"رضيت نفسي بقسمتها","https://www.aldiwan.net/poem8760.html","عموديه"],[91,"يا ميتا فيه جمال الحياة","https://www.aldiwan.net/poem8784.html","عموديه"],[91,"ما وعظ الإنسان مثل الحمام","https://www.aldiwan.net/poem62748.html","عموديه"],[91,"لو أستطيع كتبت بالنيران","https://www.aldiwan.net/poem62773.html","عموديه"],[70,"يقبل الأرض وينهي إلى","https://www.aldiwan.net/poem42785.html","السريع"],[85,"أسخطت جدى الشاذلي","https://www.aldiwan.net/poem7288.html","مجزوء الكامل"],[85,"الأمر آل أحسن المآل","https://www.aldiwan.net/poem7912.html","الرجز"],[45,"سهر أصابك بعد طول نعاس","https://www.aldiwan.net/poem64605.html","الكامل"],[45,"أترى الزمان يعيد لي أيامي","https://www.aldiwan.net/poem65674.html","الكامل"],[45,"بين الشقيقة فاللوى فالأجرع","https://www.aldiwan.net/poem64692.html","الكامل"],[58,"ما غاض دمعي عند نازلة","https://www.aldiwan.net/poem31191.html","أحذ الكامل"],[44,"وعاذل عذلته في عذله","https://www.aldiwan.net/poem29687.html","الرجز"],[44,"أي القلوب عليكم ليس ينصدع","https://www.aldiwan.net/poem30310.html","البسيط"],[74,"بشرى كما أسفر وجه الصباح","https://www.aldiwan.net/poem12886.html","السريع"],[105,"قل للألى رقدوا والعدل يقظان","https://www.aldiwan.net/poem42055.html","البسيط"],[105,"ردوا بني قينقاع الأمر إذ نزلا","https://www.aldiwan.net/poem44215.html","البسيط"],[105,"هي الأواصر أدناها الدم الجاري","https://www.aldiwan.net/poem44225.html","البسيط"],[52,"ما غر من تسري عقاربه","https://www.aldiwan.net/poem26889.html","الكامل"],[52,"داو الهموم بقهوة صفراء","https://www.aldiwan.net/poem27329.html","الكامل"],[48,"ما غضبي من شتم أحبابي","https://www.aldiwan.net/poem10797.html","السريع"],[50,"أقوى وعطل من فراطة الثمد","https://www.aldiwan.net/poem63936.html","البسيط"],[46,"ما غاب اسحاق البرايا عنهم","https://www.aldiwan.net/poem23044.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85835","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20248","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141960","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43667","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54302","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54308","الخفيف"],[106,"مبايعة الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179496",""],[77,"ما غض مني أن أخلفت موعود","https://www.poetsgate.com/ViewPoem.aspx?id=33900",""],[77,"خذها فقد وضح الصباح ولاحا","https://www.poetsgate.com/ViewPoem.aspx?id=33805",""],[45,"سَهَرٌ أَصَابَك بَعْدَ طُولِ نُعَاسِ","https://www.poetsgate.com/ViewPoem.aspx?id=31226",""],[51,"نجَّاكَ يا ابن الحاجِبِ الحاجبُ","https://www.poetsgate.com/ViewPoem.aspx?id=27045",""],[31,"ألمم بجورٍ في الصفاحِ حسانِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19099&r=&rc=361",""]],"verses":[["ما غَرَّني يَومَ اللِقاءِ وَلا","خَدَعَ اِرتِياحَ هَوايَ رَيَّقُهُ",0,"ق",2,0],["ما غاضَ دَمعِيَ إِلّا بَعدَما اِنحَدَرَت","غُروبُهُ بَينَ مُنهَلٍّ وَمُنهَمِعِ",1,"ع",1,0],["ما غابَ مِنّا غائِبٌ فَآبا","وَرُبَّ حَيٍّ دَعَموا القِبابا",2,"ب",2,0],["مَا غَيْرتْ مِنْكَ الْخُطُوبُ سَجِيَّةً","مَجْبُولَةً وَالَطَّبْعُ لاَ يُتَنَقَّلُ",3,"ل",1,0],["ما غَضّ منّي أنْ أخْلَفْتَ موْعودي","ورَوْضُ خدِّكَ أضْحى ذاوِيَ العودِ",4,"د",1,1],["ما غَرّدَتْ وَرْقاءُ فوقَ أراكَةٍ","تَبْكي الهَديلَ وما صَباحٌ لاحا",5,"ح",2,0],["ما غاظَهُم غَيرَ ما سَيَّرتُ مِن مِدَحٍ","في صائِكِ المِسكِ مِن أَنفاسِها فَنَعُ",6,"ع",1,0],["ما غبت عنا كيف غيبة من لنا","في كل مكرمةٍ بها استشهاد",7,"د",1,0],["ما غابَ عَنها سُرورُ مُلكٍ","عادَ إِلى بَلدَةٍ سِواها",8,"ا",3,0],["ماغَضَّ مِنّي حادِثٌ","وَالقَرمُ قَرمٌ حَيثُ حَلّا",9,"ل",2,0],["ما غابَ عنَّا سرَى شخص لوالدِه","وعلمهُ والتُّقى والجود لم يغب",10,"ب",1,0],["ما غرَّهم منا ونحن الأُلى","لم يُرَ في سلطانهم خاربُ",11,"ب",1,0],["ما غَلِيلٌ لم يَسْقِهِ بمساعي","ه وجَدْوَى يديْهِ بالمَبْرودِ",12,"د",1,0],["ما غَدٌ يا مَن يُصَوِّرُهُ","لِيَ شَيئاً رائِعاً عَجِبا",13,"ب",2,0],["ما غابَ ماءٌ غابَ تَحتَ الثَرى","فَأَطلَعَ النَبت وَأَحيا المَوات",14,"ت",1,0],["ما غابَ عَنّا وَكَأَنّي بِهِ","يَفصِلُهُ عَن صَحبِهِ أَلفُ عام",15,"م",1,0],["ما غالَ نَومي حُبُّ مَعسولِ اللِمى","مَمنوعِهِ لَكِن هَوى الأَوطانِ",16,"ن",1,0],["ما غَيَّرَ البُعدُ سِوى جِسمِهِ","وَلَم يُغَيِّر صَفوَ أَخلاقِهِ",17,"ق",2,0],["ما غشني وأضلني","إلا نصائح نجدلي",18,"ي",1,0],["ما غَربت شَمسُ نَهار الباس","حَتّى بَدَت شَمسُ بَني العَباسِ",19,"س",1,0],["ما غَمَّضَت عَينٌ لِفَقدِ خَيالِهِ","وَالقَلبُ فيهِ بَلابِلُ الوَسواسِ",20,"س",1,0],["ما غَرَّكُم مِنهُ وَقَد جَرَّبتُمُ","سَطَواتِهِ في سالِفِ الأَعوامِ",21,"م",1,0],["ما غابَ عَنهُم غَيرُ نُزعَةِ أَشيَبٍ","مَكسُوَّةٍ صَدَأً وَشَيبَةَ أَنزَعِ",22,"ع",1,0],["ما غاضَ دَمعي عِندَ نازِلَةٍ","إِلّا جَعَلتَكَ لِلبُكا سَبَبا",23,"ب",2,1],["ما غَبَنَ المَغبونَ مِثلُ عَقلِهِ","مَن لَكَ يَوماً بِأَخيكَ كُلِّهِ",24,"ل",2,0],["ما غابَ عَنكُم مِنَ الإِقدامِ أَكرَمُهُ","في الرَوعِ إِذ غابَتِ الأَنصارُ وَالشِيَعُ",25,"ع",1,0],["ما غَصَّ بِالدَمعَةِ إِلّا هَفا","فَاِنظُر تَجِد ثُمَّ السِوارَ الوِشاح",26,"ح",1,0],["ما غرّهم بابن محمودٍ أما علموا","أنّ الرئيس لمجدِ النّيلِ عُنوانُ",27,"ن",1,0],["ما غرّكم بقضاءِ اللهِ يُرسله","على يَدَيْ بطلٍ أعظم به بطلا",28,"ل",2,0],["ما غرَّهم إذ أطاعوا أمرَ جاهِلهم","بواحدٍ غالبِ السُّلطانِ قهَّارِ",29,"ر",1,0],["ما غَرَّ مَن تَسري عَقارِبُهُ","مِن أُسدِ غيلٍ تَرقُبُ الفُرَصا",30,"ص",2,1],["ما غَرَّكُم مِنها تَقادُمُ عَهدِها","في الدَنِّ غَيرَ حُشاشَةٍ صَفراءِ",31,"ا",2,0],["ما غَضَبي مِن شَتمِ أَحبابي","أَعظَمُ مِن شَتمِهِمُ ما بي",32,"ي",1,1],["ما غِبتَ عَنها بِأَرضٍ لا تَحَلُّ بِها","إِلّا دَعاكَ إِلَيها القَلبُ وَالكَبِدُ",33,"د",1,0],["ما غابَ اِسحاقُ البَرايا عَنهُمُ","فَاِسأَل بَني يَعقوبَ عَن اِسحاقا",34,"ق",2,1],["ما غالب الطبع امرؤ","إلا وطبعه غلب",35,"ب",1,0],["ما غادر الموجُ بهِ قائما","يوم احتوى الأعلامَ طوفانُ نوحْ",36,"ح",1,0],["ما غابَ عَنها مَرَّةً","حَتّى تَغَيَّبَ في التُراب",37,"ب",1,0],["ما غادرا بلداً إلا إلى بلد","والحر يلهب من خدي مسافره",38,"ر",2,0],["ما غاضَ بَعدَكَ ثُكلي","إِلّا بَكَيتُ فَزِدتُه",39,"ت",2,0],["ما غنائي بالذكر يبقى جميلاً","حين أمسى تحت الصفائح رَهْنَا",40,"ن",2,0],["ما غَلَبْتَ النفُوسَ بِالْعَزْمِ لَكِنْ","هَكَذَا يغْلِبُ الْكَثِيرُ الْقَلِيلاَ",41,"ل",2,0],["ما غبتَ عن بصر البلاد وسمعها","يومًا، ولا بعدت ركابُك ميلا",42,"ل",2,0],["ما غض مني أن أخلفت موعود","وروض خدك أضحى ذاوي العود",43,"د",1,1],["ما غردت وأرقاء فوق أراكة","تبكي الهديل وما صباح لاحا",44,"ح",2,0],["ما غمَّضتْ عَيْنٌ لِفقدِ خَيَالهِ","والقلبُ فِيهِ بَلاَبِلُ الوسوَسِ",45,"س",1,0],["ما غرَّهم منا ونحن الأُولى","لم يُرَ في سلطانهم خاربُ",46,"ب",1,0],["ما غن أشدتُ بذكرها، لكنهُ","غُلِبَ العَزَاءُ، وَبُحْتُ بِکلكِتْمَانِ",47,"ن",1,0]]}