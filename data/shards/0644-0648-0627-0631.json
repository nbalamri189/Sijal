{"poems":[[56,"يا أبا سعد قوصره","https://www.aldiwan.net/poem29374.html","مجزوء الخفيف"],[90,"طرب الشعر أن يكون نسيبا","https://www.aldiwan.net/poem44453.html","الخفيف"],[90,"تيقظ فما أنت بالخالد","https://www.aldiwan.net/poem44977.html","المتقارب"],[90,"أدهق الدهر بالمنية كاسه","https://www.aldiwan.net/poem45051.html","الخفيف"],[74,"إن طيفا عن حال شجواي أملى","https://www.aldiwan.net/poem20543.html","الخفيف"],[53,"رب عرض منزه عن قبيح","https://www.aldiwan.net/poem8143.html","الخفيف"],[53,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[72,"هو حظي قد عرفته","https://www.aldiwan.net/poem42989.html","مجزوء الرمل"],[40,"ألم يسأل الركب الديار العوافيا","https://www.aldiwan.net/poem7821.html","الطويل"],[91,"إن تأييد نهضة العلم مجد","https://www.aldiwan.net/poem44933.html","الكامل"],[64,"وموقف من وراء الرمل آنسني","https://www.aldiwan.net/poem52373.html","البسيط"],[63,"وجد الحب لي فؤادا علوقا","https://www.aldiwan.net/poem51502.html","الخفيف"],[107,"سيري الهوينى دومة الجندل","https://www.aldiwan.net/poem44201.html","السريع"],[107,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[50,"كسر الحب نشاطي","https://www.aldiwan.net/poem64369.html","مجزوء الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43824","المديد"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[90,"طرب الشعر أن يكون نسيبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19532&r=&rc=35",""],[113,"إنما الناس نحن في كل دار","https://www.aldiwan.net/poem16321.html","الخفيف"],[119,"أبا البتول الخافقين أغث","https://www.aldiwan.net/poem42158.html","الوافر"],[186,"مقل في دجى العرور نيام","https://www.aldiwan.net/poem67032.html","الخفيف"],[189,"كن من الدنيا على وجل","https://www.aldiwan.net/poem14629.html","المديد"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[237,"قال ثوب الشجاع وهو جميل","https://www.aldiwan.net/poem14893.html","الخفيف"],[266,"محلك من متن السماكين ارفع","https://www.aldiwan.net/poem38242.html","البسيط"],[289,"أنا في حال تعالى الله له","https://www.aldiwan.net/poem44318.html","مجزوء الرمل"],[308,"لا قبلنا في ذا المصاب عزاء","https://www.aldiwan.net/poem58419.html","الخفيف"],[333,"فوق هذي الربا أقمت وحيدا","https://www.aldiwan.net/poem54989.html","الخفيف"],[354,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[358,"من لصب صبا المعاهد أشجاه","https://www.aldiwan.net/poem40001.html","الخفيف"],[369,"شاق الحمام إليك لما ناحا","https://www.aldiwan.net/poem60965.html","الكامل"],[408,"كن كما شئت إن حبك فني","https://www.aldiwan.net/poem46717.html","الخفيف"],[411,"لو ارتاح الزمان إلى عتابي","https://www.aldiwan.net/poem50072.html","الوافر"],[422,"هذه الدار وهاتيك المغاني","https://www.aldiwan.net/poem54073.html","الرمل"],[443,"أنخ أيها الحادي المطي وسلّم","https://www.aldiwan.net/poem2559.html","الطويل"],[463,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[519,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[591,"هات قل لي كم الجفا والدلال","https://www.aldiwan.net/poem17650.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122540","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63925","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38771","الرمل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202073","الخفيف"],[1367,"","https://poetry.dctabudhabi.ae/diwan/poem/205473","الطويل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11863","الخفيف"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101897","الرجز"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101902","الرجز"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201721","الخفيف"],[2132,"","https://poetry.dctabudhabi.ae/diwan/poem/145551","الرمل"],[2179,"","https://poetry.dctabudhabi.ae/diwan/poem/178154",""],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27909","الرمل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109469","الرمل"],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123474","الرجز"],[2467,"","https://poetry.dctabudhabi.ae/diwan/poem/111754","الخفيف"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84533","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93923","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93980","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93933","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204984","الخفيف"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87378","الخفيف"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/47021","الكامل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86291","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205681","الخفيف"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76439","الرمل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107484","الخفيف"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199123","الرجز"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36632","الدوبيت"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73091","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52126","الخفيف"],[4929,"مانبا السيف بل الكف أبى","https://www.poetsgate.com/ViewPoem.aspx?id=204993",""],[3591,"ألم تزالوا على الحسن الذي سلفا","https://www.poetsgate.com/ViewPoem.aspx?id=149466",""],[5183,"بين القبر والمنبر","https://www.poetsgate.com/ViewPoem.aspx?id=180164",""],[5277,"نميرُ الحب","https://www.poetsgate.com/ViewPoem.aspx?id=191162",""],[5559,"الانتصار/زهير شيخ تراب","https://www.poetsgate.com/ViewPoem.aspx?id=152691",""],[5864,"يا أبي","https://www.poetsgate.com/ViewPoem.aspx?id=190488",""],[6192,"هل أتاكم حديث الخيول ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63746&r=&rc=12",""],[2220,"إنَّ سري هوَ روحُ كلِّ شيء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11915&r=&rc=784",""]],"verses":[["لَو اراهُ مُجَبِّياً","خِلتَهُ عَقدَ قَنطَرَه",0,"ر",2,0],["لو أردات رميَ الغيوب وأغضت","لأصابت خفيّها المحجوبا",1,"ب",2,0],["لو أرسل اللّه جبريلاً لساحتهم","لما أتى غير مصحوب بكنّاس",2,"س",1,0],["لو أردنا إفاضة في هجاها","لكتبنا لكم به كرّاسه",3,"س",2,0],["لو أرادت شهب النجوم علاه","ما عزَا الفيلسوف للشهبِ عقلا",4,"ل",2,0],["لو أراد الأديبُ أن يهجُوَ البد","رَ رماهُ بالخُطَّةِ الشَّنعاءِ",5,"ا",2,0],["لوْ أرُوضُ الشيْطانَ أَذْعَنَ كالكَلْ","بِ أو العَودِ عضَّهُ الكُلُّوبُ",6,"ب",1,0],["لَو أَرادَ البُعدَ عَنّي","نورُ عَينَي ماتَبِعتُهُ",7,"ت",2,0],["لِوارِدِ ماءٍ مِن فَلاةٍ بَعيدَةٍ","تَذَكَّرَ أَينَ الشِربُ إِن كانَ صافِيا",8,"ي",2,0],["لو أردنا إحصاءها ما اقتدرنا","وكذاك النجوم ليست تُعد",9,"د",1,0],["لَو ارتشى الليلُ من صَبٍّ فدامَ لهُ","لكان يبذُلُ فيه روحَهُ الراشي",10,"ش",2,0],["لو أراقَت دمي صُروفُ اللَّيالي","لم تَجدْني لماء وَجْهي مُريقا",11,"ق",2,0],["لو ارتضى دينَ الهدى صانه","وزانه بالخُلُقِ الأمثل",12,"ل",1,0],["لو أردتَ النُّضارَ لم تَحملِ الأح","جارَ تُوهي القُوى وتَحنِي الظُّهورا",13,"ر",2,0],["لو أُرِيدُوا في حال سَبْتٍ بخيرٍ","كان سَبْتَاً لديهمُ الأَربِعاءُ",14,"ا",2,0],["لَو أَرَدتَ الوَصلَ لَم تَج","لِب مِنَ الفَخرِ شُروطا",15,"ط",2,0],["لَوْ أَرَادَ القِسْط لَم يَكْفُؤْ لَهُ","أَو تَصَدَّى لِلوَغى لَمْ يَحْمِ ثغْرَا",16,"ر",2,0],["لَو أَرادَ اللَهُ بي رشداً","لَكَفاني لَمسي الكَفَلا",17,"ل",2,0],["لو ارعوت مع الغرام نهية","لم يعبث الحب بأحلام النهى",18,"ا",1,0],["لو أرادت رمي الغيوب وأغضت","لاصابت خفيها المحجوبا",19,"ب",2,0],["لَو أَرَدنا غَير الجِياد رَكِبنا","حَيثُ سِرنا عَلى الأُسود الضَواري",20,"ر",2,0],["لو أرشقهم بسهام القهر أنهم","متى رميتهم يا مصطفى قتلوا",21,"ل",3,0],["لَو أَرادَ الفَتى قَضاءَ أَماني","هِ لَضاقَت مِن دونِها الأَيَّامُ",22,"م",1,0],["لو أَراك العقلُ أَيْسَرَه","كدتَ أَنْ تفنى من الخجل",23,"ل",1,0],["لَو أَرادوا لَواصَلوني وَلَكِن","أَحسَنوا في قَطيعَتي ما أَساؤوا",24,"ا",1,0],["لَو أَرادَ القديرُ كانَ بلحظٍ","كلّ هَذا ولم يكن إسراءُ",24,"ا",2,0],["لَو أرادَ النبيّ سالت دماءٌ","مِن قريشٍ كأنّها دأماءُ",24,"ا",2,0],["لَو أرادَ اِشتفى كما شاء لكن","ما له في سِوى هُداها اِشتفاءُ",24,"ا",2,0],["لو أَراد الغِنى لأنبتتِ الأر","ضُ نُضاراً وأمطرته السماءُ",24,"ا",2,0],["لَو أَرادَ الزَمانُ يَعظِمُ قَدري","لَم يَدَعني عَلى الزِبالَةِ مُلقى",25,"ق",2,0],["لو أرى محياها حياءً ذو النهى","يحقق وجه الأمر وهو مبرقع",26,"ع",1,0],["لَو أَرى في الناسِ حُرّاً","لَم تَكُن في ذا المِثالِ",27,"ل",1,0],["لو أرادت عِرسُ المكارم بعلاً","عدِمتْ بعدَ فقدهِ الأكفاءَ",28,"ا",2,0],["لو أراد الذي له الأمر أن نَس","عد ما خان والدَينا الصواب",29,"ب",1,0],["لَو اِرتَضى الغَمامِ لَم يَبِت","مِن بَعدِ حَيِّ الإِنسِ في القَفرِ الوَعِر",30,"ر",1,0],["لَو أَرَدنا نعدُّ حُسن مَزاياه","كان تَصويرنا المحال محالا",31,"ل",2,0],["لو أرى المُهَّنى في البسيطةِ أمْةٌ","وُلِّيتُها فَتهادَتِ الأفراحا",32,"ح",2,0],["لو أرادَ الفؤادُ عَنكَ سلوّاً","قلْتُ سِرْعَنْ جوانحي لَسْتَ منِّي",33,"ن",2,0],["لوِ ارْتاحَ الزَّمانُ إلى عِتابي","وأنصَفَ سائليهِ في الجَوابِ",34,"ب",1,1],["لو أرى لي سفراً قطّعته","إرَباً بالأنْيُق النجب الهجان",35,"ن",1,0],["لوارث هدي المصطفى وخلاله","وخير البرايا من محلّ ومحرم",36,"م",1,0],["لو أراني الدهر ما أخَّر لي","لتعلّقتُ بأيّامي الأُولْ",37,"ل",1,0],["لو أريَحيّتُه تهزُّ لدى النّدى","جَذْعاً لأوشَكَ باللآلئ يَطلُعُ",38,"ع",1,0],["لَوْ أَردْتَ الوِصَالَ مَا صَدَّكَ ال","واشِي ولا رَدّ عَزْمَكَ العُذَّالُ",39,"ل",1,0],["لَو أرادَ النُّجومَ بالسُّوءِ أصبَح","ن ومِنها المطعُونُ والمضرُوب",40,"ب",1,0],["لَوارِدٌ منْ أبي العبَّاس بحرَ ندىً","يُشَرِّدُ الريُّ عن روَّادِه العطشا",41,"ش",2,0],["لَو أَرادَ الشّمسَ إِذ تظَّاهرُ","صادَها وَاللَّه مِن كبدِ الفَلَك",42,"ك",1,0],["لو أرادُوا حَقيقَةَ الدِّين كانوا","تَبَعاً للذي أقامَ الرَّسُولُ",43,"ل",1,0],["لو أراد الاله أجلاك عنا","فانجلت غمرة العدو الدخيل",44,"ل",1,0],["لَو أَرادَ الرَقيبُ يَنظُرُ جِسمي","ما رَآهُ مِنَ النُحولِ رَقيبُ",45,"ب",1,0],["لو أرضعت واحدة شخصين","لغيرها من لبني فحلين",46,"ن",1,0],["لو أرضعت إخوتها الحليله","وإن يكن من لبن البعوله",47,"ه",1,0],["لو أراد المقدار مما دهاها","برّها وهي لم ترد ما براها",48,"ا",3,0],["لو أردنا الإلكتريك فعلنا","وكذاك البخار والكهرباء",49,"ا",1,0],["لو أراد الله خيراً","وصلاحاً لمحبه",50,"ب",2,0],["لو أرادوا عفافنا","ستروا وجهه الحسن",51,"ن",1,0],["لو أراد الأمر أن يخرجه","لم يكن يمكن هذا من يدي",52,"ي",1,0],["لو أرى مثلَ الذي أعشقهُ","كنتُ عنهُ بالسوى مشتغلا",53,"ل",2,0],["لو أرشَدوا أمّتَهم في سَيرها","ومهَّدوا لها الهضابَ والرُّبا",54,"ا",1,0],["لو أرادوا صلاحنا","ستروا وجهك الحسن",55,"ن",1,0],["لَو أَرى في الزَمان خلداً لشخص","لجعلت الفرار من افعالي",56,"ل",2,0],["لو أراد الوزان وزن نداه","لتبدى رجحانه وارجحنا",57,"ن",2,0],["لو أردنا تنزيهه عن خناهم","لوجدنا في ذاته تلويثا",58,"ث",2,0],["لو أردت المطال وافى ملحا","أو أردت الوصال عني تلهى",59,"ه",2,0],["لو أراد الأنام رمز فداء","كنت رمزا مخلدا للفداء",60,"ا",2,0],["لو أردنا امراً ولم يُرد الدَهرُ","اردنا للمَستحيل وقوعا",61,"ع",2,0],["لو ارعوى من يشمخُ","تكبّراً ويبذخُ",62,"خ",1,1],["لَو اِرادَ اللَهُ كانوا كُلُّهُم","اُمَّةً ما بَينَهُم فَرقاً جَعَل",63,"ل",1,0],["لو أرادت لكان عند مناها","كلُّ صدرٍ، وكلُّ نهدٍ شهيِّ",64,"ي",1,0],["لو أَردتن المَعالي لارتفع","قدم الاسلام عن فلك النجوم",65,"م",1,0],["لو أردتم لما ارتكبتُ المَعاصي","لو أردتم لكنتُ خِدنَ سلامِ",66,"م",1,0],["لوارثين\"ابن غنى\" جملته","سوى مئين اثنين قسم لأخته",67,"ه",1,0],["لَو أُرهِفَتِ البيضُ لِحَزِّ الهامِ","أَو سُوِّدَت الوجوهُ في الأَقوامِ",68,"م",1,1],["لَو أَرَدنا تَحديدَها لَوَجدنا","ه كإِيجادِ مِثلكُم مُستَحيلا",69,"ل",2,0],["لو أراد الإلهُ عنها بديلاً","لم نَقُلْ يوماً ذرّ قرنُ الغزالَه",70,"ل",2,0],["لو أريدَ الحسمُ فعلاً لانتهى","أمرها في البدءِ والشرُّ خَبَا",71,"ب",2,0],["لو أريدَ الحسمُ فيها لانتفى","لفرِيقَيْها التباري سَبَبَا",71,"ب",2,0],["لو أرتجيكم بباريس لما فدحت","بلوى فراقي ولا دمع الأسى وكفا",72,"ف",2,0],["لو ارتقيت سماء العرش ممتدحاً","إياك كنت كأني قط لم أقم",73,"م",1,0],["لو أراكم كلّ همّي ينجلي","طابتْ الروحُ وقلبي دنْدَنا",74,"ن",2,0],["لو أُرغموا رفضوا أو زلزلوا صمدوا","أو أُجهدوا نهضوا أو أُحصروا نفروا",75,"ر",3,0],["لو أردفوا هرعوا من فوق سابعة","هذي ملائكة القهار أم بشر",75,"ر",1,0],["لَو أُُريدَ الخُلُودُ للنَّاسِ نَالَت","صِفَةَ الخُلدِ صَفوةُ الأنبياءِ",76,"ا",2,0],["لوْ أَرَادُوا خُدُورَكُمْ دَخَلُوهَا","دُونَمَا حَاجَةٍ لإِذْنِ دُخُولِ",77,"ل",1,0],["لوْ أرادَ الأمرَ أنْ يخرجهُ","لمْ يكنْ هذا منْ يدي",78,"ي",1,0]]}