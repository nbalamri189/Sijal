{"poems":[[26,"أمن المنون وريبها تتوجع","https://www.aldiwan.net/poem24106.html","الكامل"],[91,"هذي الوغى مشبوبة النيران","https://www.aldiwan.net/poem62764.html","عموديه"],[62,"قل لمن يطلب الحجر","https://www.aldiwan.net/poem52140.html","مجزوء الخفيف"],[45,"شرخ الشباب أخو الصبا وأليفه","https://www.aldiwan.net/poem65161.html","الخفيف"],[28,"أحل هريم يوم بابل بالقنا","https://www.aldiwan.net/poem4960.html","الطويل"],[44,"لا تعجلن عليك بعد نهار","https://www.aldiwan.net/poem30045.html","الكامل"],[105,"نظم المجد لأبطال الحمى","https://www.aldiwan.net/poem42072.html","الرمل"],[105,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[105,"يا بني الحارث بن كعب سلام","https://www.aldiwan.net/poem44004.html","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39569","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39552","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39559","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[45,"شَرْخُ الشّبابِ أخو الصّبَا، وأليفُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=32840",""],[28,"أحل هريم يوم بابل بالقنا","https://www.poetsgate.com/ViewPoem.aspx?id=21518",""]],"verses":[["صَخِبُ الشَوارِبِ لا يَزالُ كَأَنَّهُ","عَبدٌ لِآلِ أَبي رَبيعَةَ مُسبَعُ",0,"ع",1,0],["صَخّابَةً تَذَرُ الحُصونَ بَلاقِعاً","وَتَدُكُّها دَكّاً إِلى الأَركانِ",1,"ن",1,0],["صخرة العلم هذه","وهو كنّ لمن خبر",2,"ر",1,0],["صَخِبُ العَشِيِّ إِذا تَأَلَّقَ بَرقُهُ","ذَعَرَ الأَجادِلَ في السَماءِ حَفيفُهُ",3,"ف",2,0],["صُخورُ الشَظا مِن فَرعِ ذي الشَريِ فَاِنتَمَت","فَطالَت عَلى رَغمِ العِدا فَاِشمَخَرَّتِ",4,"ت",1,0],["صَخرٌ يُفيتُكَ مِسمَعَيكَ كِلَيهِما","حَتّى تَرى أَنَّ الأَذانَ سِرارُ",5,"ر",1,0],["صخرةٌ صمّاءُ تحمِي صخرةً","علّمتها كيف تشفي الصَّمَما",6,"م",2,0],["صَخَبُ التّنازُعِ في الممالكِ مُؤذِنٌ","أُممَ الزّمانِ بضجّةِ الإعوالِ",7,"ل",1,0],["صَخْرَةٌ ما تَطيرُ أو تَتفرَّى","إن تَفرَّى الحصَى وَطَارَ الرَغامُ",8,"م",1,0],["صخرةَ العهد ويكِ هأنذا عد","تُ فماذا لديكِ عن أضيافكْ",9,"ك",1,0],["صخرةٌ لا تَجلُّ في الكائناتِ","غَشِيَتها جلالةُ الآبداتِ",10,"ت",1,1],["صخرةَ الملتقى أتيتكِ بعد ال","أيْنِ أشكو من الحياة أذاتي",10,"ي",1,0],["صخرةً كانت الملاذَ لقلبين","حبيبين في الشباب النضيرِ",11,"ر",1,0],["صَخْرُها أَوْحَى إليها عَزْمَةً","من بَني رَضْوَى وثَهْلاَن بَنَاهَا",12,"ا",3,0],["صخور السد بعدك ناطقاتٌ:","بأنْ لا شَيءَ في الدنيا محال",13,"ل",1,0],["صَخِبُ العِشِّي، إذا تَهامة ُبْرُقُهُ","ذَعَرَ الأجَادِلَ في السّماءِ حَفيفُهُ",14,"ف",2,0],["صُخورُ الشظا من فرْع ذي الشَّرْي فانتمتْ","فطالَتْ على رَغْمِ العِدى فاشمَخرّتِ",15,"ت",1,0]]}