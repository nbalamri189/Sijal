,""],[4890,"إلى سيزيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72664&r=&rc=154",""]],"verses":[["صَخِبُ الشَوارِبِ لا يَزالُ كَأَنَّهُ","عَبدٌ لِآلِ أَبي رَبيعَةَ مُسبَعُ",0,"ع",1,0],["صَخّابَةً تَذَرُ الحُصونَ بَلاقِعاً","وَتَدُكُّها دَكّاً إِلى الأَركانِ",1,"ن",1,0],["صخرة العلم هذه","وهو كنّ لمن خبر",2,"ر",1,0],["صَخِبُ العَشِيِّ إِذا تَأَلَّقَ بَرقُهُ","ذَعَرَ الأَجادِلَ في السَماءِ حَفيفُهُ",3,"ف",2,0],["صُخورُ الشَظا مِن فَرعِ ذي الشَريِ فَاِنتَمَت","فَطالَت عَلى رَغمِ العِدا فَاِشمَخَرَّتِ",4,"ت",1,0],["صَخرٌ يُفيتُكَ مِسمَعَيكَ كِلَيهِما","حَتّى تَرى أَنَّ الأَذانَ سِرارُ",5,"ر",1,0],["صخرةٌ صمّاءُ تحمِي صخرةً","علّمتها كيف تشفي الصَّمَما",6,"م",2,0],["صَخَبُ التّنازُعِ في الممالكِ مُؤذِنٌ","أُممَ الزّمانِ بضجّةِ الإعوالِ",7,"ل",1,0],["صَخْرَةٌ ما تَطيرُ أو تَتفرَّى","إن تَفرَّى الحصَى وَطَارَ الرَغامُ",8,"م",1,0],["صخرةَ العهد ويكِ هأنذا عد","تُ فماذا لديكِ عن أضيافكْ",9,"ك",1,0],["صخرةٌ لا تَجلُّ في الكائناتِ","غَشِيَتها جلالةُ الآبداتِ",10,"ت",1,1],["صخرةَ الملتقى أتيتكِ بعد ال","أيْنِ أشكو من الحياة أذاتي",10,"ت",2,0],["صخرةً كانت الملاذَ لقلبين","حبيبين في الشباب النضيرِ",11,"ر",1,0],["صَخْرُها أَوْحَى إليها عَزْمَةً","من بَني رَضْوَى وثَهْلاَن بَنَاهَا",12,"ا",3,0],["صخور السد بعدك ناطقاتٌ:","بأنْ لا شَيءَ في الدنيا محال",13,"ل",1,0],["صَخِبُ العِشِّي، إذا تَهامة ُبْرُقُهُ","ذَعَرَ الأجَادِلَ في السّماءِ حَفيفُهُ",14,"ف",2,0],["صِخِبٌ كأنَّ دُعاءَ عَبدِ مَنافَة ٍ","في رَأْسِهِ عَقِبَ الصَّبَاحِ الجَافِلِ",15,"ل",1,0],["صُخورُ الشظا من فرْع ذي الشَّرْي فانتمتْ","فطالَتْ على رَغْمِ العِدى فاشمَخرّتِ",16,"ت",1,0],["صَخِبِ الرَواعِدِ مُستَطيرِ","البَرقِ لَمّاعٍ خَطوفِ",17,"ف",1,0],["صَخِبُ الشَوارِبِ كالِئاً أَشبالَهُ","شَرِساً تَكادُ الأَرضُ مِنهُ تَزَلزَلُ",18,"ل",1,0],["صخرةَ الإيمان صارت","وعَرَفتَ الصخرَ ماكن",19,"ن",1,0],["صَخِبُ الرُّعودِ تَهيجُ في جَنباتِهِ","للعاصفاتِ جَراجِرٌ وخُوارُ",20,"ر",1,0],["صخوب التناجي يرهب الموت بأسه","إذا قُرعت خرصانُه بالمناصلِ",21,"ل",1,0],["صخوبٌ ولكن نطقه من حفيظةٍ","صَوارمُ من قبل الوغى ولهاذِمُ",22,"م",1,0],["صخبٌ لو أنَّ الرعد يجلبُ عنده","ما نَمَّ صاعقُ من الضّوضاءِ",23,"ا",2,0],["صَخْبِ الرُّعودِ له زماجرُ أخجلتْ","باللّيلِ زَمْجَرَةَ الهِزَبْرِ المُحنَقِ",24,"ق",1,0],["صَخْبِ الرّعودِ كأنّما أجراسُهُ","صُبحاً وإمساءً زئيرُ عنابِسِ",25,"س",1,0],["صَخِبِ الرّعودِ كأنّ جَرْسَ غمامِهِ","جَزْلاً أُعِينَ بسائر الأجراسِ",26,"س",1,0],["صَخْبُ الترنّمِ حالِكُ ال","قطرينِ مَملوءُ الوعاء",27,"ا",2,0],["صخر بني فهرٍ به زعيم","لا يخلف الظن ولا يخيم",28,"م",1,0],["صَخرَةٌ من تَرَؤُّسٍ وَصَفاةٌ","مِن أَناةٍ وَقِمَّةٌ مِن ثَبيرِ",29,"ر",1,0],["صَخرٌ عَلى السِّيف يَا وَليَّ المَطرَدِ","مِنَ الشَّمَالِ حُطَّ فِيهِ وَآرقُدِ",30,"د",1,0],["صَخرٌ كَفُؤادِ مَن هَوينا شَغَفاً","فَيهِ فَلَقَد أَودى بِهِ لي صَبرِي",31,"ر",2,0],["صَخِبُ الشَوارِبِ وَالوَتينِ كَأَنَّهُ","مِمّا يُغَرِّدُ مَوهِناً بِخِناقِ",32,"ق",1,0],["صخرة الوادِ أنت خير أنيس","لي إن فاتني مع الصحب أنس",33,"س",1,1],["صَخِبُ الرعودِ وإنما هي ألسنٌ","فأمرُّهنَّ اللوذعيُّ المسهب",34,"ب",1,0],["صُخورُها مَنحوتَة مُرَبَّعَة","عَظيمَة السُمكِ بِطولِ وُسعَة",35,"ه",1,0],["صُخورٌ مَضَت وَقَد رَجَعَت لَنا","فَلا مَرحَباً بِالقادِمينَ وَلا أَهلا",36,"ل",2,0],["صخرة والحب فيها جذوة","فهو مهما تقدحيه جلمد",37,"د",1,0],["صخور له لانت كذا انقاد غيث سحب","مجز بضافى ظله كشف القعطا",38,"ط",2,0],["صَخَبُ القِيامةِ لا يَنامُ برأسِهِ","ولَظَى الجَحِيمِ شَرارةٌ في فِيهِ",39,"ف",3,0],["صخرت وقتي لك ومالي لك يساق","وكفي بما يرضيك ماهي بخيله",40,"ل",2,0],["صخب الحوادث صرت فيه مناوئا","لتُدَق في خبر الصباح مطارقُ",41,"ق",1,0],["صَخْرَةٌ أَنْتَ فَجَّرَتْكَ الأحَاسِي","سُ صُمُوتًا فَجَاسَ فِيكَ السُّكُونُ",42,"ن",1,0],["صخب الأيام ينادينا","يغزو بالصبر نواصينا",43,"ن",2,1],["صخرة الجهل ورّثتنا الحُطاما","تركتنا بليلنا نتعامى",44,"م",2,1],["صخرٌ من البازلتِ في الجولانِ","متماسكٌ مذْ ثورةِ البركانِ",45,"ن",1,1],["صخرته على اللي يلهجه ثم ينهجه","مصيب النصيب اولى لمن هو يخاطبه",46,"ب",2,0],["صخرةٍ بالقدس تنخى الفاتحين","هلت العبرات منها جاريات",47,"ت",1,0],["صخرة المعراج تنخى الطيبين","وين جيش الزحف قاسين القناة",47,"ه",1,0],["صخبٌ رؤاه .. يلوّنُ الطرقاتِ","بالجريِ الشقيّ ... فتقتفيهِ متاعبُ",48,"ب",1,0],["صخر الجبل إصنوف","أما التراب ما هو شي",49,"ي",1,0],["صَخَبٌ, ضَجِيجٌ ما, مَخاضُ حَضارَةٍ","وَصَخِيخُ أُخرَى تَحتَها تَتَهَدَّمُ",50,"م",1,0],["صخرتَه الصمّاءْ.","أقسمتُ أن أظلّ مع سيزيفْ",51,"ف",1,0]]}