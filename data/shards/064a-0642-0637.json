لدّجّالِ أعورَ","https://www.poetsgate.com/ViewPoem.aspx?id=201727",""],[4885,"أما لمحب عندهن وداد","https://www.poetsgate.com/ViewPoem.aspx?id=215718",""],[4929,"كفارة الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=204449",""],[4988,"شانت ضنونك","https://www.poetsgate.com/ViewPoem.aspx?id=186974",""],[5174,"رَفيفٌ إِلى مِشكاةِ الضَّادِ","https://www.poetsgate.com/ViewPoem.aspx?id=185374",""],[5277,"السلوان","https://www.poetsgate.com/ViewPoem.aspx?id=185264",""],[5431,"سأترك مهجتي في اليم طوعا...","https://www.poetsgate.com/ViewPoem.aspx?id=191602",""],[5431,"سأخزن في قلبي هواك وأعذرُ","https://www.poetsgate.com/ViewPoem.aspx?id=196777",""],[5431,"ما كان لله أن ينسى أحبته ....","https://www.poetsgate.com/ViewPoem.aspx?id=200831",""],[5526,"مالك لوى","https://www.poetsgate.com/ViewPoem.aspx?id=199668",""],[5732,"يقول من عدا على رأس عالي","https://www.poetsgate.com/ViewPoem.aspx?id=34388",""],[402,"وقفت على القبر الذي أنت نازله","https://www.poetsgate.com/ViewPoem.aspx?id=36823",""],[6152,"أمتي","https://www.poetsgate.com/ViewPoem.aspx?id=203274",""],[6171,"ثورة الأيام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84674&r=&rc=4",""],[6175,"يقولون لو يهوى لسالت دموعه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72835&r=&rc=60",""],[6218,"كلاّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65905&r=&rc=58",""],[6234,"الربيع الفاتن في نجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6538&r=&rc=5",""],[6259,"حُييتما من دمنتي طللينِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59406&r=&rc=54",""],[422,"بوادي الغضا للمالكية أرْبُعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22255&r=&rc=11",""]],"verses":[["يَقطَعنَ أَعراضَ العَقيقِ فَمُشئِمٌ","يَحدو رَكائِبَهُ الغَرامُ وَمُعرِقُ",0,"ق",1,0],["يُقَطِّعونَ حُبى الأَيّامِ عَن طَبَعٍ","وَتَحتَبي بِالمَعالي وَالمَحاميدِ",1,"د",1,0],["يقطف الأحلام والذكرى كما","يقطف العنقود كفّ العاصر",2,"ر",1,0],["يُقَطِّعُ قَلبي حُسنُ خالٍ بِخَدِّها","إِذا سَفَرَت عَنهُ وَيَنفُثُ بِالسِحرِ",3,"ر",1,0],["يُقَطِّعُ سَيرَ الناعِجاتِ ذَميلُها","نَجاءً إِذا اِختَبَّ النَجاءُ المُعَوَّلُ",4,"ل",1,0],["يَقطَعُ اليَومَ طاوِياً وَلَدَيهِ","دونَ ريحِ القُتارِ ريحُ الخُزامى",5,"م",2,0],["يَقطَعُ البيدَ وَالفَيافي وَحيداً","لَم تُضَعضِعهُ وَحشَةُ الإِظلامِ",6,"م",1,0],["يُقَطِّرُ فَوْقَ الغَمْرِ سَائِلَ دَمْعِهِ","وَلا يُدْرِكُ الشيء الَّذِي هُو سَائِلُهْ",7,"ل",2,0],["يُقَطِّعُ بِالْقُنُوطِ نِيَاطَ قَلْبِي","وَيُلْقِي الرَّيْبَ فِي عَقْلِي وَدِينِي",8,"ن",2,0],["يَقطَعُ الحُزنَ والمَهَامِة والبِي","دَ وَمِن دُونِه ثَمانُ لَيَالي",9,"ل",2,0],["يُقَطِّعُ مَوضوعَ الحَديثِ اِبتِسامُها","تَقَطُّعَ ماءِ المُزنِ في نُزَفِ الخَمرِ",10,"ر",1,0],["يُقَطِّعنَ أَجوازَ الفَلاةِ بِفِتيَةٍ","لَهُم فَوقَ أَنضاءِ السُرى قِمَمُ السَفرِ",10,"ر",1,0],["يُقَطِّعنَ للإِبساسِ شاعاً كَأَنَّهُ","جَدايا عَلى الأَنساءِ مِنها بَصائِرُ",11,"ر",1,0],["يُقَطِّعُ بِالمَعابِلِ حالِبَيها","وَقَد بَلَّت مَشيمَتُها الثِيابا",12,"ب",2,0],["يُقَطِّعُ بِالجَريِ أَنفاسَهُم","بِثَنيِ العِنانِ وَلَم يُجهَدِ",13,"د",1,0],["يقطعه الراحل عن","دنياه وهو مغمض",14,"ض",1,0],["يقطر الفضل والمرؤة منه","ويميل الوفاء حيث يميل",15,"ل",1,0],["يُقَطِّعُ قلبي حُسْنُ خالٍ بخَدِّها","إذا سَفَرَتْ عنه تَنَغّمَ بالسِحْرِ",16,"ر",1,0],["يُقَطِّعُ هِندِيَّ الصَفيحِ مُساوِراً","سِوارَ اِمرِئٍ في الحَربِ غَيرِ لَئيمِ",17,"م",1,0],["يَقطَعنَ كُلَّ مَدىً بَعيدٍ غَولُهُ","خَبَبَ السِباعِ يُقَدنَ بِالأَرسانِ",18,"ن",1,0],["يَقطَعنَ أَميالَ أَجوازِ الفَلاةِ كَما","يَغشى النَواتي غِمارَ اللُجِّ بِالسُفُنِ",19,"ن",1,0],["يُقَطّبُ الموتُ خوفاً من لقائِهِمُ","ويضحكُ الثغرُ منهمْ عن سَنَا ثُغَرِ",20,"ر",1,0],["يُقطِرُ أَقلامَهُ مِن دَمٍ","وَيَعلَمُ بِالظَنِّ ما لَم يَكُن",21,"ن",1,0],["يَقطُرُ مِسكاً عَلى غَلائِلِهِ","شُعرُ نَقا بِالعَبيرِ قَد وَكَفا",22,"ف",2,0],["يُقَطِّعُ في كَأسِها","رُؤوسَ مَداري ذَهَب",23,"ب",1,0],["يَقطَعُ كَالمُستَطرِدِ المَذعورِ","في اليَومِ أَيّاماً مِنَ المَسيرِ",24,"ر",1,0],["يَقطَعُ الدَهرَ ما يُغَيَّبُ عَنهُ","مِن هَواكُم بِعَبرَةٍ وَنَحيبِ",25,"ب",1,0],["يُقَطِّعُ مِن أَهلِ القَرابَةِ وُدَّهُ","فَلَيسَ لَهُ إِلّا هَواكِ نَسيبُ",26,"ب",1,0],["يُقَطَّعُهُنَّ بِتَقرِيبِهِ","وَيَأوي إِلى حُضُرٍ مُلهِبِ",27,"ب",1,0],["يَقْطَعْنَ عَرْضَ الأَرْضِ غَيْرَ لوَاغِبٍ","وكَأَنَّ مُحْزِنَهَا لهُنَّ صَحَارِي",28,"ر",2,0],["يقطع الدهرَ وحدَهُ","ذاهلاً تائه القدمْ",29,"م",1,0],["يقطع الدوَّ بارداتِ الليالي","ويجوبُ الحزونَ ملتهباتِ",30,"ت",1,0],["يقطع غفلاً ويجوب بائرا","إن المغيث من أتاك طائرا",31,"ر",2,0],["يُقطعُ منهُ الوَتَدُ المُوسَّطُ","وكُلُّ شيءٍ بعدهُ لا يَسقُطُ",32,"ط",1,0],["يُقَطِّعُ أَنْفَاسَ الرِّياحِ إِذَا سَرَى","وَيَسْبِقُ شَأْوَ النَّيِّرَيْنِ قَصِيدُهُ",33,"د",2,0],["يقطِّعُ أوشاجاً علينا عزيزةً","ويبترُ جبّاراً كريمَ الوصائل",34,"ل",1,0],["يقطعُ الأرض وهاداً وربىً","ويشق الجوَّ متناً وعنانا",35,"ن",2,0],["يقطع الليلَ مَسيرًا، فإذا","وشَت الشمسُ به، ألقى عصاه",36,"ا",2,0],["يقطع التيه، إلى التيه، بلا","شوق أسفارٍ، ولا وعد انثناءِ",37,"ا",2,0],["يقطف الحسن على أوراقه","من شفاه عذبة الملمس لعس",38,"س",1,0],["يُقَطِّعُ هِنْدِيَّ الصَّفيحِ، مُساوراً","سِوَارَ امْرِىءٍ في الحَرْبِ غَيرِ لَئِيمِ",39,"م",1,0],["يقطع الحبل علوا","وعلى ذلك يحلف",40,"ف",1,0],["يقطع بالهموم سبيل فكر","عليل فيك أمرضه الغرام",41,"م",1,0],["يقطع العمر بالغناء فتعطوا","مصغياتٍ سوانح الغزلان",42,"ن",1,0],["يَقْطَعُ البِيدَ، وَالنَّجُودَ سَعِيدًا","بِخُطًى كَالأَصِيلِ، حُمْرٍ دَوَامِ",43,"م",1,0],["يقطعون الحياة غُراً بأحلام","كهولٍ تغذو جنونَ الشَّباب",44,"ب",1,0],["يَقْطَعُ العَضْبُ إِنْ نَبا عَنْ قَليلٍ","وَيعودُ الْهِلالُ بَعْدَ الغِيابِ",45,"ب",1,0],["يقطب تأديبا وفي قلبه الرضى","ويبسم إمهالاً بقلب مغاضب",46,"ب",1,0],["يَقطرُ الدَمعُ في المَحاجِرِ ماءً","فَإِذا اِنهَلَّ صارَ في الخَدِّ نَبلا",47,"ل",2,0],["يَقطَعُ ما كَرَّرَها الراوي بِها","مَفازَةَ الساري وَليلَ السامِرِ",48,"ر",1,0],["يَقطُرُ ماءُ البِشرِ مِن وَجهِهِ","لا خَيرَ في وَجهٍ بِلا بِشرِ",49,"ر",1,0],["يقطع الركب والفيافي سحيرا","وبه هودج الحسان يزان",50,"ن",1,0],["يَقطعانِ المدارَ بعدَ غروبٍ","وَعَنِ القطبِ يأبيانِ اِنفِكاكا",51,"ك",2,0],["يَقطَعُ اللَيلَ آهَةً وَاِنتِحاباً","وَاِبتِهالاً لِلَّهِ أَيَّ اِبتِهالِ",52,"ل",1,0],["يَقطَعُ كَفَّ القاذِفِ المُفتَري","وَيجلِدُ اللِصَّ الثَمانينا",53,"ن",2,1],["يُقَطِّعُ عُمرَ اللَيلِ عُمرُ سُجودِهِ","فَلِلَهِ مِحرابٌ حَوى مِنهُ مِحرَبا",54,"ب",2,0],["يقطعُها جودُ بنيهِ ولا","تقطعُها الكَوماءُ ذاتُ البرَه",55,"ر",2,0],["يَقطَع اللَيل بِحُزن","وَبُكاء وَنَحيب",56,"ب",1,0],["يُقطِّبُ إنْ سمّيتَ قُطباً ومِحوَراً","ويقطُرُ خَلاًّ حين يلفظُ بالقَطْرِ",57,"ر",1,0],["يقطنَ بِالأَحداجِ بطن مقضب","قَلَتِ الرُبا وَمَشارِق الجَبَلَينِ",58,"ن",1,0],["يقطِّع آناء النَهارِ عَلى الطَوى","صِياماً وآناء الظَلام تَضَرُّعا",59,"ع",2,0],["يقطّع فيها مهجة الصب شوقاً","وما الشَّوق إلاَّ مهجة تتقطَّع",60,"ع",1,0],["يقطعُ السامعُ الزمانَ اغتِباقاً","تحت أفياءِ دوحِها واصطباحا",61,"ح",2,0],["يقطعون الفلاة وخدا وإعنا","قاً ولا يسمعون إلا الحداء",62,"ا",2,0],["يٌقطَعُ في طَرفِهِ فيُجْزَي","سُوءاً وما القطْعُ في يديْهِ",63,"ي",2,0],["يقطَعُ ما بيني وبين أرَبِي","على دنوِّ الدار هذا البِينا",64,"ن",2,0],["يقطّر ظهرُها الأبطا","لَ بين العيّ واللَّكنِ",65,"ن",1,0],["يقُطر ماءُ بِيضِها وسمرها","علامةً أنًّ غداً تقطُر دَمْ",66,"م",1,0],["يَقطع عني مطرح العينين لا","أسومهُ مشقَّة المسافر",67,"ر",1,0],["يقطعُ التيهَ والجمالُ دليل","بين عينيه والظلامُ خفيرُ",68,"ر",1,0],["يَقْطَعُ الخَطْبَ إذا يَنْبُ","وعنِ الضَّرْبِ الكَهامُ",69,"م",1,0],["يَقطَعُ لِلأَحدَثِ القَديمِ فَلا","تَبقَى لَهُ خُلَّةٌ وَلا خُلُقُ",70,"ق",1,0],["يقطعنَ أعراضَها غُلْبَ الرقابِ الى","مرمًى يُعيدُ عِتاقَ العيسِ أشباحا",71,"ح",2,0],["يقطعنَ كلَّ بعيدِ الدوَّ مُنْخَرَقٍ","على وَجاها إذا ما رجَّعَ الشادي",72,"د",2,0],["يقطعن بالقول غوراً","من البلاد ونجدا",73,"د",2,0],["يَقطَعن أجوازَ الفَلا كمعابِلٍ","يمرُقن عن جَفْنِ القِسيِّ مُروقا",74,"ق",2,0],["يَقطع الحَزْن وَيطوِي","في الدّياجيرِ السُّهوبا",75,"ب",2,0],["يَقطَعنَ عَرضَ الأَرضِ بِالتَمَحُّلِ","جَوزَ الفَلا مِن أَرمُلٍ وَأرمُلِ",76,"ل",1,0],["يُقَطَّفُ هَذا بالبَنانِ وَإِنَّما","يُقَطَّفُ ذاكَ الوردُ بالشَّفَياتِ",77,"ت",1,0],["يُقطِفُ الوَردُ بالنَّواظِر مِن خَدَّ","يهِ بَين احمِرارِه واصفراره",78,"ر",2,0],["يقطع الليل بحزن والتياح","ومن العينين يذري الدررا",79,"ر",2,0],["يَقطَعُنا بُغضاً عَنِ الطَريقِ","وَعَن قَضاءِ الحَقِّ لِلصَّديقِ",80,"ق",1,0],["يُقْطَفُ الياسمينُ من جسمها الرط","بِ وَيُجْنَى من خدِّها الجلَّنار",81,"ر",1,0],["يَقطع اليوم غَراماً","ويوالي اليل سهدا",82,"د",2,0],["يقطعن القُلوب عَلَيك مَهما","ذَكَرتك وَالدموع لَها اِنهمار",83,"ر",1,0],["يقطع البيع بوخد ورسيم","عج إذا ما شمت برق الغور لاح",84,"ح",1,0],["يقطع قلبي بالصدود تجنياً","ويزعم أني مذنب وهو مذنب",85,"ب",1,1],["يقطعون الفلا ينجب عتاق","وجياد شوازب تتغالى",86,"ل",2,0],["يقطع الليل والنهار دؤوبا","يسلك المسلك الحميد السويّا",87,"ي",2,0],["يقطع الليل والنهار تقيا","إنما الحر يستبيه اليقينُ",88,"ن",1,0],["يقطع الصّبُّ عامَه مستهاما","ساهداً بالعشىّ والأبكارِ",89,"ر",1,0],["يقطعون الحياة حربا على الجه","ل وفي الجهل شقوة وعناءُ",90,"ا",2,0],["يقطع من أوتار قلب ملوع","ويرشف كأس الحب من كف ناهد",91,"د",1,0],["يقطع اطواد الحجارة حده","ولا يقطع الزبد المذاب له حد",92,"د",1,0],["يقطع الليل بتقديسه","يزهو به المحراب والمجلس",93,"س",1,0],["يَقطعُ كَفَّ القَاذفِ المفتري","ويَجلدُ اللَّصَ ثمانينا",94,"ن",2,1],["يقطع دواجاً له سابغَا","وريقةٌ من ورق التوثِ",95,"ث",1,1],["يَقطِفُ مِن","مايَقتَطِفُ",96,"ف",1,0],["يقطعُ الليلَ بالتسبيح بين يدي","مولاه دَامعةٌ في الليلِ عيناه",97,"ا",2,0],["يقطع اسراسَ القياد جدبا","إذا اشرأبّت مَرحاً وشغبا",98,"ب",2,0],["يُقَطِّرُ أَردانَ الأَصيلِ أَريجُها","وَتوحي مَجاليها إِلى الشَمسِ تَغرُبُ",99,"ب",1,0],["يُقَطِّرُها الدَنُّ الحَلالُ كَأَنَّما","تَتابُعُها عِقدٌ مِنَ الدُرِّ يُنظَمُ",100,"م",1,0],["يُقَطِّعُ بالشدِّ إِحضارَها","لَدى الحُضرِ عِندَ احتِضارِ اللَّهَب",101,"ب",1,0],["يقطع أبحرَه الطاميات","فواقيع لا يهتدين سبيلا",102,"ل",2,0],["يقطعُ قلبي الداء والداءُ قاتلٌ","إذا ثار أصلى واستبدَّ وحطَّما",103,"م",2,0],["يَقطر سمّ المَوت مِن وَعيده","وَيَستَهل ديمة إِذا وَعد",104,"د",1,0],["يَقطَع اللَيل في عَلائق وَصل","فَسُجود طوراً وَطوراً رُكوعا",105,"ع",2,0],["يَقطَعُ الصَّخرَ وَيَفري","هِ كَما تَفري المَساحي",106,"ح",2,0],["يقطعُها العشرون والثمانِ","لكلِّ نجمٍ نَوءُ في الزمانِ",107,"ن",1,0],["يُقَطِّع آناء النهار بنوحِه","