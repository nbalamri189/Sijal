لمناقب والعلى","https://www.aldiwan.net/poem16354.html","الطويل"],[464,"ليهن الورى برء العلى والفضائل","https://www.aldiwan.net/poem3265.html","عموديه"],[464,"متى لمتني في الغوزال الأغنِ","https://www.aldiwan.net/poem3326.html","عموديه"],[465,"يا صاحب العيدين","https://www.aldiwan.net/poem36542.html","عموديه"],[491,"أيا أحمد ابن مليك الزمان","https://www.aldiwan.net/poem26668.html","المتقارب"],[495,"دعا فأجابه القدح","https://www.aldiwan.net/poem9811.html","مجزوء الوافر"],[495,"ليهنك عهد لا يضاع وإن نأت","https://www.aldiwan.net/poem10235.html","الطويل"],[498,"أطاعتك الذوابل والشفار","https://www.aldiwan.net/poem3696.html","الوافر"],[514,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[514,"يلوح فتستدعي الفراش وتبسم","https://www.aldiwan.net/poem20798.html","الطويل"],[514,"هلم بنا إلى أرض الحجون","https://www.aldiwan.net/poem20805.html","الوافر"],[514,"خطبت المجد بالأسل العوالي","https://www.aldiwan.net/poem20820.html","الوافر"],[514,"أفي طي الصبا نشر التصابي","https://www.aldiwan.net/poem20824.html","الوافر"],[514,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[514,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[515,"وفى لك حد الجد والسيف غادر","https://www.aldiwan.net/poem12105.html","الطويل"],[515,"من كان لا يعشق الأجياد والحدقا","https://www.aldiwan.net/poem12182.html","البسيط"],[515,"لكل مقام في علاك مقال","https://www.aldiwan.net/poem12200.html","الطويل"],[515,"عنان الليالي في يديك مسلم","https://www.aldiwan.net/poem12275.html","الطويل"],[529,"لي همة لا تشتكي إن نالها","https://www.aldiwan.net/poem37116.html","الكامل"],[529,"ليهنكم دار المسرة إنها","https://www.aldiwan.net/poem37313.html","الطويل"],[538,"ألا إنه يوم به الدهر يشهد","https://www.aldiwan.net/poem48238.html","عموديه"],[551,"عجبت لقلبي كيف يصبو ويكلف","https://www.aldiwan.net/poem47405.html","البسيط"],[558,"غصن بان فوقه البدر بدا","https://www.aldiwan.net/poem34653.html","الرمل"],[564,"أعيدوا لنا التاريخ احيوا لنا الذكرى","https://www.aldiwan.net/poem854.html",""],[575,"عسى أن يسر السائرين إياب","https://www.aldiwan.net/poem3102.html","الطويل"],[586,"جيش الملاحة مقرون به الظفر","https://www.aldiwan.net/poem17513.html","البسيط"],[587,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"]],"verses":[["لي هِمَّةٌ أَقطَعنَها قِصَدَ القَنا","في قَصدِ يَومَي مَعرَكٍ وَرِهانِ",0,"ن",1,0],["لِيَهُن مَن لَم يَفتَتِن","إِنّا لَقينا الفِتَنا",1,"ن",2,0],["لِيَهنِكَ أَنَّ النَفسَ تَمنَحُكَ الهَوى","جَميعاً وَأَنَّ القَلبَ عِندَكَ كُلَّه",2,"ل",2,0],["لِيُهوِنِ المَرءُ بِأَيّامِهِ","إِنَّ مُقامَ المَرءِ فيها قَليل",3,"ل",1,0],["لِيَهنِكَ مَولودٌ يُوَلَّدُ فَخرَهُ","أَبٌ بِشرُهُ لِلسائِلينَ ذَرائِعُ",4,"ع",1,0],["لِيَهنِكَ ما تُجَدِّدُهُ اللَيالي","وَحَسبُكَ مِن فِراقٍ وَاِجتِماعِ",5,"ع",1,0],["لِيَهنِكَ يا اِبنَ الأَكرَمينَ اِبنُ حُرَّةٍ","تَمَزَّقَ عَنهُ النَحسُ عَن غُرَّةِ السَعدِ",6,"د",1,0],["لِيَهنِ اللَيالي وَالمَعالِيَ أَنَّها","إِثابَةُ بُرءٍ عَدَّها المَجدُ مَولِدا",7,"د",2,0],["لِيَهنِكِ أَنّي لا أَزالُ عَلى أَسى","وَأَنّيَ لا أَلقاكِ إِلّا عَلى عَتبِ",8,"ب",1,0],["لِيَهنِئَكُمُ أَن قَد أَرَحتُم قُلوبَكُم","وَأَن قَد قَذَفتُم بِالصَبابَةِ في سَحري",9,"ي",1,0],["ليَهنِكِ العيدُ وَإِن كُنتُ مِن","أَجلِكِ لا يَهنِأُني العيدُ",10,"د",1,1],["ليَهْنِكَ منْصورُ اللّواءِ مؤيَّدٌ","بِحارُ النّدى منْ جودِ كفَّيْهِ تغْرِفُ",11,"ف",1,0],["ليهْنِكَ شَمْسَ الدّينِ ما حُزْتَ منْ عُلَى","خَواتِمُها موْصولَةٌ بالفَوائِحِ",12,"ح",1,0],["لِيَهدَأ عُمانُ فَغَوّاصُهُ","أُصيبَ وَأَمسى رَهينَ الحُفَر",13,"ر",1,0],["لِيَهنِ الهُدى إِنجاحُ سَعيِكَ في العِدا","وَأَن راحَ صُنعُ اللَهِ نَحوَكَ وَاِغتَدى",14,"د",2,1],["لِيَهنِكَ أَنَّكَ أَزكى المُلوكِ","بِفَيءٍ وَأَشرَفُهُم سودَدا",15,"د",2,0],["لِيَهنِئ تُراثي تَغلِبَ اِبنَةَ وائِلٍ","إِذا نَزَلوا بَينَ العُذَيبِ وَخَفّانِ",16,"ن",1,1],["ليهنئكم هذا القران فإنه","سرورٌ بما نلقى وبشرى بما بعد",17,"د",1,0],["لَيَهْنِئْكَ فِي تَأْيِيدِ أَصْدَقِ نَهْضَةٍ","لِرَفْعِ مَقَامِ الشَّرْقِ تَقْدِيرِ لُبْنَانِ",18,"ن",1,0],["لِيَهنِكَ دَولَةٌ حَدَثَت","فَأَحدَثَ عِزُّها نَشَبا",19,"ب",2,1],["لِيَهنِ أَبا بَكرٍ سَعادَةُ جَدِّهِ","بِصُحبَتِهِ مَن يُسعِدِ اللَهُ يَسعَدِ",20,"د",1,0],["ليهنك يا عينَ الزمان وأهله","ويهني الورى عامٌ بسعدِك آيب",21,"ب",1,1],["ليهنكَ وِدّ الناصرِ الملك إنهُ","دليلٌ على وصل الهنا المتودّد",22,"د",1,0],["ليهنك العيد يا عيداً ويا سنداً","للعالمين رَوَوا في الحمد إسنادي",23,"ي",1,0],["ليهن بني أيوب أن محمداً","بنى لهمُ في كل صالحةٍ ذكرا",24,"ر",2,0],["ليهنك ما تجنيه من جنةٍ غدا","بإبطال ما تجنى الجناياتُ من وزر",25,"ر",1,0],["ليهنك ما عمّرته من معالمٍ","سيثني على عمارهنّ أبو ذَرّ",25,"ر",1,0],["ليهن من باتَ مسروراً بهجعته","إني عليهِ قريحُ الطرف ساهره",26,"ر",2,0],["ليهنك الفضل في دنيا وآخرة","والذكر والأجر من جاريهما جارِي",27,"ي",1,0],["ليهن حما الشهباء قاضٍ حوت به","كمالاً على تفضيله اتفق النص",28,"ص",1,1],["ليهنك العام تلقى","ألف السعادة ألفه",29,"ف",2,0],["ليهن بدر الحسن في حلة","تعذيب قلبي وهو في حل",30,"ل",1,1],["ليهن بنو الآمال أنك قادم","لك السعد والإقبال عبدٌ وخادم",31,"م",1,1],["لِيَهنِ فتىً أطراك أنْ نال سُؤْلَهُ","لديك وأنْ لم يحتقِب وِزْرَ كاذبِ",32,"ب",1,0],["لِيَهْنِ الضِّياعَ وكُتَّابَها","وعُمّالَها ثم أربابَها",33,"ب",3,1],["ليهنِئْهمُ سيدٌ أيِّدٌ","صحيحُ الرَّويَّة في الكارثِ",34,"ث",1,0],["ليَهْنَأ الملكَ أن أصلحتَ فاسده","وأن حرست من الإفساد ما صلحا",35,"ح",2,0],["ليهنكِ أنْ قد مرّ من صدر دولة","شهورٌ توالتْ بعدهن شهورُ",36,"ر",1,1],["لِيهنئ رجالاً لا تزال تجودهم","سحائبُ من كلتا يديك مواطر",37,"ر",1,0],["ليهْنك لبس المِهرجان وإن غدا","تُهنِّئه الدنيا بأنك لابسُهْ",38,"س",2,1],["لي هِمة لم يكن ليرويها","إلا من البحرِ بعضُ أحواضه",39,"ض",2,0],["ليهنِك حقٌّ ردَّه اللَه منعِماً","عليك به لا بل على الناس أجمعا",40,"ع",2,1],["ليهنك أنك مستقبِلٌ","دوام المزيد بلا قاطعِ",41,"ع",1,0],["ليهنيكُمُ أن ليس يوجد منكمُ","لبوس ثياب المجد لكن خلوعها",42,"ع",3,0],["ليهنَكَ أن أفطرتَ لا متطلعاً","إلى الفطر كي تغشى من اللهو مَحْرما",43,"م",2,1],["لِيَهنَء شَريكاً وَطبُهُ وَلِقاحُهُ","وَذو العُسِّ بَعدَ النَومَةِ المُتَبَرِّدُ",44,"د",1,0],["لِيَهنِئكَ ما أَعطاكَ رَبُّكَ إِنَّها","مَواقِفُ هُنَّ الغُرُّ في مَوقِفِ الحَشرِ",45,"ر",1,0],["لَيُهنِني إِن طلعتَ بَدراً","لأعيُنِ الخَلقِِ مُستَتِمّا",46,"م",2,0],["لِيُهَنيء أَهلَ مالِقَةَ اِنتِصاري","وَإِعزازي لَهُم بَعدَ الهَوانِ",47,"ن",1,0],["لي هِمَّةٌ فوق هامِ النَّجْمِ أخمَصُها","وإن تطامنَ تحتَ العُدم مَفْرِقُها",48,"ق",3,1],["لِيَهْنِكَ أنْ أعديتَنِي الشوقَ بعدَما","تماثَلَ من داءِ الصَّبَابَةِ مُوجَعُ",49,"ع",1,0],["لِيَهنِكَ في اِبنِكَ العَبّاسِ هَديٌ","تَبَيَّنَ مِن رَشيدِ الأَمرِ هادِ",50,"د",1,0],["لِيَهنِكَ أَن قالوا سَريَّةُ مُفلِحِن","أَبانَ طَلى العاصينَ وَقعُ جَلادِها",51,"د",3,0],["لِيَهنَأ أَخِلّايَ الَّذينَ أَوَدُّهُم","ذَخائِرُ ما في الصَدرِ مِن صادِقِ الوِدِّ",52,"د",1,0],["لِيَهنَأ بَني يَزدادَ أَنَّ أَكُفَّهُم","خَلائِفُ أَنواءِ السَحابِ الرَواجِسِ",53,"س",1,0],["لِيَهنِ اِبنَهُ خَيرَ البَنينَ مُحَمَّداً","قُدومُ أَبٍ عالي المَحَلِّ جَليلِهِ",54,"ل",2,0],["لِيَهنِكَ أَن أَمسى بِدارِ خَزايَةٍ","وَأَن باتَ مَشغولاً وَخَوفُكَ شاغِلُه",55,"ل",2,0],["لِيَهنِ المُسلِمينَ بِكُلِّ ثَغرٍ","سَلامَةُ رَأيِكَ الثَبتِ الأَصيلِ",56,"ل",1,0],["لِيَهْنِ الأميرَ التَّغلبيَّ قُدومُه","وفَتحٌ تَوالتْ بالسُّعودِ طوالِعُه",57,"ع",2,0],["ليَهْنِكَ أنَّ الرومَ ذَلَّ عزيزُها","فصارتْ مواليها بِعزِّكَ أعبُدا",58,"د",2,0],["لِيَهنِكَ أَنَّ لي وَلَداً وَعَبداً","سَواءٌ في المَقالِ وَفي المَقامِ",59,"م",1,1],["لِيَهنِكَ إِنَّ الدَمعَ بَعدَكَ مُطلَقٌ","لَفَرطِ الأَسى وَالقَلبَ بِالهَمِّ في سِجنِ",60,"ن",1,0],["لِيَهنِكَ مُلكٌ لا يَزالُ مُخَيِّماً","لَدَيكَ وَذِكرٌ في الأَنامِ شَريدُ",61,"د",1,0],["لِيَهنِكَ أَنّي في القِراعِ وَفي القِرى","وَفي البَحثِ حَظّي الصَدرُ وَالصَدرُ وَالصَدرُ",62,"ر",1,1],["ليهنك عودةُ عيدٍ مَشَى","إليك على جَمْرَةِ الشوْق عاما",63,"م",2,0],["ليهنئ بني الإسلام أنْ أبْتَ سالما","وغادَرْتَ أنْفَ الكفرِ بالذلّ راغما",64,"م",2,0],["لِيَهنَكَ فتحٌ أولغ السيف فيهمُ","ولاح بِوَجه الدين من ذِكره بِشرُ",65,"ر",1,0],["لِيَهْنِ الرعايا منك عَدلُ سياسَةٍ","ودفعُ خطوبٍ لليالي بها غدرُ",66,"ر",1,0],["لِيَهنَكَ أنَّ مُمتَنِعَ الأماني","لِكَفِّكَ في تَناوُلِها اختِيارُ",67,"ر",1,0],["لي هوىً آوي إليه مرحاً","غَيرَ أَنِّي بِالنهى عَنهُ حَيود",68,"د",1,0],["لِيَهنِكَ يا سَليلُ فَقَد هَنَتني","بِما عوفيتَ عافِيَةٌ هَنِيَّه",69,"ن",3,1],["لِيَهنِ اِمرَأً أَثنى عَلَيكَ بِأَنَّهُ","يَقولُ وَإِن أَربى فَلا يَتَقَوَّلُ",70,"ل",1,0],["لِيَهنِئ تَنوخاً أَنَّهُم خَيرُ أُسرَةٍ","إِذا أُحصِيَت أولى البُيوتِ وَعُدَّتِ",71,"ت",1,0],["ليهنكِ بلبالي عليكِ ورقتي","إليكِ كما قلبي لديكِ على البعدِ",72,"د",1,0],["ليهنكَ أنَّكَ عينُ الزمانِ","فليتَ على عينِهِ الواقيَهْ",73,"ي",2,0],["لَيَهنَكَ وافِدُ أُنسٍ سَرى","فَسَرّى وَفَصلُ سُرورٍ طَرَق",74,"ق",1,1],["لِيَهْنِكِ أُمَّ كُلثومٍ مُقامٌ","كريمٌ عِندَ مَرْجُوٍّ مُثيبِ",75,"ب",1,0],["لِيَهنِكَ عِيدٌ في لِقَائِكَ عَاشِقٌ","وَلَيسَ لِصَبّ هَامَ في المضجدِ عَاذِلُ",76,"ل",1,0],["لِيَهْنَكَ الفَتْحُ لا أنّي سمِعتُ بهِ","ولا على اللّهِ فيما شاءَ أشْتَرِط",77,"ط",1,0],["لِيَهنِ وُلاةَ اللَهوِ أَنَّكَ هالِكٌ","فَأَنتَ بِما يَجري عَلَيكَ حَقيقُ",78,"ق",1,0],["لِيَهنِئ بَني ذُبيانَ أَنَّ بِلادَهُم","خَلَت لَهُمُ مِن كُلِّ مَولى وَتابِعُ",79,"ع",1,1],["لَيَهنَأ لَكُم أَن قَد نَفَيتُم بُيوتَنا","مُنَدّى عُبَيدانَ المُحَلِّإِ باقِرَه",80,"ر",2,0],["لِيَهْنِكَ في المكارِم والمعَالي","كَمَالٌ عَلّمَ القَمَرَ الكَمالا",81,"ل",2,0],["ليَهْنَ رَكْبٌ سَرَوا ليلاً وأنتَ بهم","بسَيرِهم في صباحٍ منكَ مُنْبَلِجِ",82,"ج",1,0],["ليَهْنِكَ المَجْدُ الذي بيْتُه","فوْقَ سَراة النجْم لا يُهدَمُ",83,"م",1,0],["ليه تشتهي النوم عيون","وعيون سواهي هواجع",84,"ع",1,0],["ليه يا حبيبي نسيتني","وغاب جمالك وطيفه",85,"ه",1,0],["لِيَهْنَ الْهَوَى إِنِّي خَضَعْتُ لِحُكْمِهِ","وَإِنْ كَانَ لِي فِي غَيْرِهِ النَّهْيُ وَالأَمْرُ",86,"ر",1,0],["لِيَهْنَ بِهِ مَنْ باتَ جَذْلانَ نَاعِماً","أَخَا نَشَوَاتٍ ما عَلَيْهِ حَقُودُ",87,"د",1,0],["لِيَهْنِئْهمُ اللًّهْوُ لا عَيْبَ فِي","هِ يَشُوبُ لصَفَاءَ وَلا مَأْثَمُ",88,"م",1,0],["لِيَهْنِيءِ الأَمْلاَكَ فِي خُلْدِهِمْ","مَنْ بِنَوَاهُ أَوْحَشَ الإِنْسَا",89,"س",2,0],["لِيَهْنِئْكَ أَنْ فَازَتْ بِلاَدُك بِالمُنى","وَقِسْطُكَ فِي إِنْجاحِها لَيْسَ يُنْكَرُ",90,"ر",1,0],["لِيَهْنِئْكَ الْقِرَانُ بِذَاتِ نُبْلٍ","مِنَ الْغِيد الصِّبَاحِ وَذَاتِ طُهْرِ",91,"ر",1,0],["لِيَهْنئكُمَا هَذَا القرانُ فَإِنَّهُ","سُرُورٌ بمَا نَلْقى وَبُشْرَى بمَا بَعْدُ",92,"د",1,0],["لِيَهنَ دِمشقَ اليَومَ صِحَّتُكَ الَّتي","بِها فَرِحَت وَالمُدُنُ كَالناسِ تَفرَحُ",93,"ح",1,0],["لِيَهنِكَ أَن أَحمَدتَ عاقِبَةَ الفَصدِ","فَلِلَّهِ مِنّا أَجمَلُ الشُكرِ وَالحَمدِ",94,"د",1,1],["لِيَهنكَ يا اِبني أَنَّ شُربَكَ بارِدٌ","وَشُربي إن لَم يَعفُ رَبّي آنِ",95,"ن",1,0],["ليَهنَكَ يا عَبد الغَنيّ اِبني الرِضا","مَحَلٌّ بِطوبى طابَ فيهِ حُلولُ",96,"ل",1,0],["ليهنِكَ: أنَّك ما متَّ إلا","وغرسُ يمينِكَ داني الثَّمر",97,"ر",1,0],["لَيهْنك، يا أبولُّوا، الانتصارُ","بربك: كيف طرْت بهم وطَاروا؟",98,"ر",3,1],["ليهنيك منصور اللواء مؤيد","بحار الندى من جود كفيه تغرف",99,"ف",1,0],["ليهنك شمس الدين ما حزت من علا","خواتمها موصولة بالفواتح",100,"ح",1,0],["ليهنِ بَنِي كعبٍ مقامُ فتاتهمْ","ومقعدها للمؤمنينَ بمرصدِ",101,"د",1,0],["ليهنئْ لكم أن قد نفيتمْ بيوتنا","، مندى عبيدانَ المحلئِ باقرهْ",102,"ر",2,0],["لِيَهْنِكَ الخلدُ في الأخرى وجنتُه","يا خير منقلبٍ في خير منقَلب",103,"ب",1,0],["؟ليه؟ وأنا اللّي أمجّدبك حروف","أأأأختل وصفك على بعدك ختل",104,"ل",1,0],["ليه أرتجي عطفك وليه أشتكيله","والهات في قاموس عشرتك هيهات",105,"ت",1,0],["لِيَهْنىءْ بَنِي يزداد أنّ أكُفّهُمْ","خَلائِفُ أنْوَاءِ السّحابِ الرّوَاجِسِ",106,"س",1,0],["ليهنئ أخلاي الذين أودهم","ذخائر ما في الصدر من صادق الود",107,"د",1,0],["ليَهْنِ الملكَ أن أصلحتَ فاسده","وأن حرست من الإفساد ما صلحا",108,"ح",2,0],["لِيهنىء رجالاً لا تزال تجودهم","سحائب من كلتا يديك مواطر",109,"ر",1,0],["ليَهنىء شريكاً وطبُه ولِقاحُه","وذوو العس بعد نومة المتبرد",110,"د",1,0],["لِيهن ذا العيد حَظ مِنهُ حينَ غَدَت","عُلاهُ ثُمَ حُلاهُ مِن أَياديكا",111,"ك",2,0],["ليهن ترابٌ صم حسنك أنه","سيرويه منه عارضٌ متصبب",112,"ب",1,0],["لِيَهنئ بَني عَبدِ مَنافٍ عُقوقُها","وَخِذلانُها وَتَركُنا في المَعاقِلِ",113,"ل",1,0],["ليهنِك آلاءٌ ضمِنتَ وفاءَها","من الجود حتى بات ناعمَ بالِ",114,"ل",1,0],["لِيَهنِكَ عيدٌ إِذا ما حَضَرتَ","زَماناً سِوى وَقتِهِ لَم يَغِب",115,"ب",1,0],["لِيَهنِكَ ما أَنالَتكَ الجُدودُ","وَأَنَّ الدَهرَ يَفعَلُ ما تُريدُ",116,"د",1,1],["لِيَهنِكَ ما أَصفَتكَ أَلسِنَةُ الوَرى","مِنَ الشُكرِ عَفواً وَالقُلوبُ مِنَ الوُدِّ",117,"د",1,0],["لِيَهنِكَ ذا العيدُ الشَريفُ وَلا تَزَل","لَهُ ما أَقامَ النَيِّرانِ مُشَرِّفا",118,"ف",2,0],["لِيَهنِ العُلى فَرعٌ غَدَوتَ لَهُ أَصلا","وَغَرسٌ نَمَتهُ تُربَةٌ تُنبِتُ الفَضلا",119,"ل",2,1],["لِيَهنِكَ عيدٌ أَنتَ عِصمَهُ أَهلِهِ","فَلا خابَ مِنكُم مَن دَعا وَتَبَهَّلا",120,"ل",2,0],["لِيَهنِكَ ما شادَت لَكَ الهِمَمُ العُلا","وَهُنّيتَ مَجداً لَم يَجِد عَنكَ مَعدِلا",121,"ل",2,1],["ليهننا بك عيد أنت شاهده","عيد النفوس إذا نالت أمانيها",122,"ي",3,0],["لِي هَوىً فِيكَ مَصُونُ","لَيْسَ لِي فيهِ مُعِينُ",123,"ن",1,1],["ليهنك عيداً ودانا بقربهِ","نهنيه لكنْ عنه مِلناً مع الحبِّ",124,"ب",1,0],["ليهنك الملك رب العرش عاقده","دون الورى لك والسعد الذي كملا",125,"ل",2,0],["لِيَهنَكُما أَن لَم تُراعا بِفُرقَةٍ","وَما دَبَّ في تَشتيتِ شَملِكُما الدَهرُ",126,"ر",1,0],["لِيَهنِكَ عِيدٌ أَنتَ أَحلى شَمائِلاً","وَأَحسَنُ مِنهُ إِن تَنَكَّرَ حادِثُ",127,"ث",1,0],["ليَهنِكَ ما مَنَحتُكَ مِن ثَناءٍ","بِهِ لا غَيرِهِ يَجِبُ القِيامُ",128,"م",1,0],["لِيَهنِكِ إِمسَاكِى بِكَفِّى عَلَى الحَشَا","وَرَقراقُ عَينِى خَشيَةً مِن زِيالِكِ",129,"ك",1,0],["لِيَهنِك إِمساكى بِكَفِّى عَلَى الحَشا","وإِذرَاء عَينى دَمعَها فِى زِيالِكِ",130,"ك",1,0],["لِيهنِكَ أَيُّها المَولَى وِسامٌ","حَصَلَت بِهِ عَلى الشَرفِ المَجيدِ",131,"د",1,1],["ليهنِكَ ما وافاكَ مِن فَيضِ نعمةٍ","أَتَتكَ فَحَلَّت مِنكَ خَير مَكانِ",132,"ن",1,1],["لِيهنئكمُ إِن طاعَكُم بَعدَنا الكَرى","فَمُذ بَينكُم لَم نوطئ الجَنبَ مَرقَدا",133,"د",2,0],["لي همّةٌ تهجر المرعى الدَّنىَّ على خِصْبٍ","وتأتي العُلَى لو لاح أَجْدَبه",134,"ب",2,0],["ليَهْنِكَ عيدٌ جاء شوقاً لنظرةٍ","إليك له من أَجْلِها سنةٌ يَغْدو",135,"د",2,0],["ليَهْن العيد أنْ وافاك فيه","وملكُك زاهرُ الأَكْناف بَض",136,"ض",1,0],["ليَهْنِ فؤادي أنه قد سَلاكمُ","وآمَن من خوف القَطيعةِ والصَّدَّ",137,"د",1,0],["ليَهْنِك شهرُ الصوم وهْو مُبشِّر","بسعدٍ بدتْ منه إليك الطَّلائع",138,"ع",1,0],["لي همّة وبصيرة وقريحة","فبغير جدّ ما تراني أصنع",139,"ع",1,0],["لي همّة قد شأت كيوان في قرن","ولي يد عند بذل الجود تنتفض",140,"ض",1,0],["ليهنكَ اليومَ أني ممسكٌ كبدي","وإنها قطعٌ تجري هنا وهنا",141,"ن",2,0],["ليهنَ أمير المؤمنين جلوسه","على العرش وليهنَ البرايا سرورها",142,"ر",3,0],["ليهنك شكل مولود سعيد","بديع الوصف زاد على السماع",143,"ع",1,1],["ليهنئك نصر الله والفتح بعده","فما مثل هذا الفتح في العصر يسمع",144,"ع",1,0],["ليهنك نصر الله والفتح بعده","ففي ذا لنا البشرى وفي ذلك البشر",145,"ر",1,0],["ليهنك العود نحو الأهل والوطن","يا فرحة الأهل بل يا فرحة السكن",146,"ن",1,1],["لِيَهنَ عيدٌ بك أَضحت له","فَضائِلٌ جلَّت عن العَدّ",147,"د",1,0],["لِيهِنك يا مِلءَ عينِ الزّمان","دوامُ السّرورِ ونيلُ الأماني",148,"ي",1,1],["لِيهن مِصَر العُلا وما جَمَعتْ","بِه من المكُرماتِ والزَّينِ",149,"ن",1,0],["ليهنِك يا بدرَ أفقِ العُلا","وِلادةُ شمسك للأنجم",150,"م",1,0],["لِيَهْنك أنّ الصومَ فرضٌ مؤكَّدٌ","من الله مفروضٌ على كلّ مسلمِ",151,"م",1,1],["لِيهنِ الإمامةَ ما نِلته","فقد تَمم الله آمالها",152,"ل",3,0],["ليهنَ سعودَ العيد أَنّ نجومها","ببرجِك ما زالت على السعد تلتقِي",153,"ق",2,0],["لِيهنك أني لم أجِد لك عائباً","سوى حاسدٍ والحاسدون كثير",154,"ر",1,1],["لَيهْنِ المعالي أنني أنا رَبُّها","وأني متى ما رمت صعباً تيسّرا",154,"ر",2,0],["لِيَهْنِ المُلْكَ مالِكُه الجديدُ","ووارِثُه وإن رَغِمَ الحَسودُ",155,"د",1,1],["لِيَهْنِك أنّ الله فوقك مالك","ودونك كلّ المالِكين عبيد",156,"د",1,0],["لِيَهْنك نُوْروزٌ تَباشَرتِ العلا","بسعدك فيه واضمحلّت بك النُّوَب",157,"ب",1,0],["لَيهْنِك أنّ الفضَل أجمعَ كلَّه","إليك أبا المنصور وَحْدَك يُنْسَب",158,"ب",1,0],["لِيَهنِكَ مِنّي هَوىً لازِمٌ","يُمَزِّقُ صَبري وَيُمسي جَديدا",159,"د",2,0],["لِيَهنِ نِظامَ الدينِ سابِغُ نِعمَةٍ","رَآهُ أَميرُ المُؤمِنينَ لَها أَهلا",160,"ل",2,0],["لِيَهنِكِ أَنِّي في حَبالِكِ عاني","وَأَنَّكِ مِنّي في أَعَزِّ مَكانِ",161,"ن",1,1],["لِيَهنِكِ أَنَّ عَيني ما تَنامُ","وَأَنِّي فيكِ صَبٌّ مُستَهامُ",162,"م",1,1],["لِيَهنِكُمُ يا قالَةَ الشِعرِ أَنَّكُم","نَزَلتُم عَلى عَذبِ المَوارِدِ سَلسالِ",163,"ل",1,0],["لِيَهنَ مَعاليكَ يا اِبنَ الكِرامِ"