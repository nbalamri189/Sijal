ِي بِكَ يَهْنِينا","سلاماً وإِسلاماً وأَمناً وتأْمِينا",236,"ن",2,1],["ليهنَ عينك طُهْرٌ","يفضي لأحسن حال",237,"ل",1,0],["ليَهنِ الوزارةَ أن زُوّجتْك","على طول ما لبِثتْ تُعضَلُ",238,"ل",1,0],["ليهن التُّقى والدين كونك سالماً","فلا دينَ إلا حيث أنت مجاهد",239,"د",1,1],["ليهْنك عيدٌ أنت عيدٌ لأهلهِ","سرورٌ لمهمومٍ ووُجْدٌ لمُمْلقِ",240,"ق",1,0],["ليهْنَ عليَّ الخيرِ أني جزيتهُ","بنُعْمى يديه الصَّالحاتِ البَواقيا",241,"ي",2,0],["ليَهْن الرَّعايا والمناقبَ والعُلى","سرورُكم ما أنبت العُشْبَ ماطِرُ",242,"ر",1,1],["ليهن الورى برء العلى والفضائل","هناء الثرى بالمدجنات الهواطل",243,"ل",1,1],["ليهنَ بك الفطر بعد الصيام","فإنك تسني فعالاً وتسني",244,"ي",1,0],["لِيَهودِ كلِّ الأرض ِ، أو لِكلابِها","لا تَستَحي منكم ، ولا تَتَورَّعُ",245,"ع",1,0],["ليهن أباك المليك الذي","جرى في المكارم شوطاً بعيدا",246,"د",2,0],["ليهنك إن سعيك في","مساعي المجد متضح",247,"ح",1,0],["ليهنك عهد لا يضاع وإن نأت","نواك وسر لا يذاع فيسمعُ",248,"ع",1,1],["لِيهنئ أَرضَ أَندلس بدور","مِن السَرّاء لَيسَ لَها سِرارُ",249,"ر",1,0],["لِيَهْنِكَ نصرٌ عزُّهُ يخذُلُ العِدا","وفتحٌ يحلُّ المُغلَقاتِ من الأمرِ",250,"ر",1,0],["ليَهنكَ صومُ الشهرِ وُفّيتَ أجرَهُ","وبالعزِّ عُقباهُ لك اللَّهُ يختمُ",251,"م",1,0],["ليَهنكَ سيّدي عيدٌ شريفٌ","حكاكَ فجلَّ عن شِبهِ القَرينِ",252,"ن",1,0],["ليهنِكَ سيّدي فتحٌ قريبٌ","بَعيدُ الصّيتِ مرتَفعُ المَنالِ",253,"ل",1,0],["ليَهنِكَ سيّدي عيدٌ شريفٌ","يبشّر عن صيامِكَ بالثّوابِ",254,"ب",1,0],["ليهْنِك بعد صومك عيدُ فطْرٍ","يُريكَ بقلبِ حاسدِك اِنفِطارا",255,"ر",2,0],["ليَهنِك عيدُ الفِطرِ يا بهجةَ الورى","ومُلكٌ قديمٌ عاد وهو جَديدُ",256,"د",1,0],["ليهنك فتح أنجبت لك أمه","وأم العلى بالنصر والفتح عاقر",257,"ر",1,0],["ليهنك العام قد دلت بشائره","على بقائك ألفاً بعده نسقا",258,"ق",2,0],["ليهنك صوم ترتجى بركاته","وتوزن أعمال به وتكال",259,"ل",1,0],["ليهنك أن الذل والعز أصبحا","وقد قسما فيمن تهين وتكرم",260,"م",1,0],["لِي هِمَّةٌ لا تَشْتَكِي إنْ نالها","ضُرٌّ إلَى أَحَدٍ سِوَى الرَّحْمَنِ",261,"ن",1,1],["لِيَهْنِكُمُ دارُ الْمَسَرَّةِ إنّها","أَجَلُّ بِناءٍ شَيَّدَتْهُ الْخَلائِفُ",262,"ف",1,1],["لِيَهنِكَ يا مولاي جحجٌّ وعُمرةٌ","وزورةُ قبرِ المصطفى والتعبُّدُ",263,"د",1,0],["ليُهْنِكَ أنّ اللَّهَ فَوَّقَك العِدا","وقد طالعوا فيك الرّجاء وأشرفوا",264,"ف",3,0],["لي هوى بالشعب من كاظمة","ساكن هذا الحشى والكبدا",265,"د",2,0],["ليهنك نظر الله والتب للعدا","فقد خسروا الأولى ولن يربحوا أخرى",266,"ر",2,0],["ليَهْنِكَ عيدٌ إِنْ أَتى كنتَ عيدَه","وإِن غاب أَضْحى مِنك عَنْه مَنابُ",267,"ب",1,0],["لِي هِمَّةٌ في العُلى لا طالَ لي عُمْرٌ","إنْ كانَ في سَاعِدي عَنْ نَيْلِها قِصَرُ",268,"ر",1,0],["ليهنك يا شمس البلاد وبدرها","بلوغ المنى من كل باغ وغاشم",269,"م",1,0]]}