ش الملاحة مقرون به الظفر","https://www.aldiwan.net/poem17513.html","البسيط"],[585,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"]],"verses":[["لي هِمَّةٌ أَقطَعنَها قِصَدَ القَنا","في قَصدِ يَومَي مَعرَكٍ وَرِهانِ",0,"ن",1,0],["لِيَهُن مَن لَم يَفتَتِن","إِنّا لَقينا الفِتَنا",1,"ن",2,0],["لِيَهنِكَ أَنَّ النَفسَ تَمنَحُكَ الهَوى","جَميعاً وَأَنَّ القَلبَ عِندَكَ كُلَّه",2,"ل",2,0],["لِيُهوِنِ المَرءُ بِأَيّامِهِ","إِنَّ مُقامَ المَرءِ فيها قَليل",3,"ل",1,0],["لِيَهنِكَ مَولودٌ يُوَلَّدُ فَخرَهُ","أَبٌ بِشرُهُ لِلسائِلينَ ذَرائِعُ",4,"ع",1,0],["لِيَهنِكَ ما تُجَدِّدُهُ اللَيالي","وَحَسبُكَ مِن فِراقٍ وَاِجتِماعِ",5,"ع",1,0],["لِيَهنِكَ يا اِبنَ الأَكرَمينَ اِبنُ حُرَّةٍ","تَمَزَّقَ عَنهُ النَحسُ عَن غُرَّةِ السَعدِ",6,"د",1,0],["لِيَهنِ اللَيالي وَالمَعالِيَ أَنَّها","إِثابَةُ بُرءٍ عَدَّها المَجدُ مَولِدا",7,"د",2,0],["لِيَهنِكِ أَنّي لا أَزالُ عَلى أَسى","وَأَنّيَ لا أَلقاكِ إِلّا عَلى عَتبِ",8,"ب",1,0],["لِيَهنِئَكُمُ أَن قَد أَرَحتُم قُلوبَكُم","وَأَن قَد قَذَفتُم بِالصَبابَةِ في سَحري",9,"ي",1,0],["ليَهنِكِ العيدُ وَإِن كُنتُ مِن","أَجلِكِ لا يَهنِأُني العيدُ",10,"د",1,1],["ليَهْنِكَ منْصورُ اللّواءِ مؤيَّدٌ","بِحارُ النّدى منْ جودِ كفَّيْهِ تغْرِفُ",11,"ف",1,0],["ليهْنِكَ شَمْسَ الدّينِ ما حُزْتَ منْ عُلَى","خَواتِمُها موْصولَةٌ بالفَوائِحِ",12,"ح",1,0],["لِيَهدَأ عُمانُ فَغَوّاصُهُ","أُصيبَ وَأَمسى رَهينَ الحُفَر",13,"ر",1,0],["لِيَهنِ الهُدى إِنجاحُ سَعيِكَ في العِدا","وَأَن راحَ صُنعُ اللَهِ نَحوَكَ وَاِغتَدى",14,"د",2,1],["لِيَهنِكَ أَنَّكَ أَزكى المُلوكِ","بِفَيءٍ وَأَشرَفُهُم سودَدا",15,"د",2,0],["لِيَهنِئ تُراثي تَغلِبَ اِبنَةَ وائِلٍ","إِذا نَزَلوا بَينَ العُذَيبِ وَخَفّانِ",16,"ن",1,1],["ليهنئكم هذا القران فإنه","سرورٌ بما نلقى وبشرى بما بعد",17,"د",1,0],["لَيَهْنِئْكَ فِي تَأْيِيدِ أَصْدَقِ نَهْضَةٍ","لِرَفْعِ مَقَامِ الشَّرْقِ تَقْدِيرِ لُبْنَانِ",18,"ن",1,0],["لِيَهنِكَ دَولَةٌ حَدَثَت","فَأَحدَثَ عِزُّها نَشَبا",19,"ب",2,1],["لِيَهنِ أَبا بَكرٍ سَعادَةُ جَدِّهِ","بِصُحبَتِهِ مَن يُسعِدِ اللَهُ يَسعَدِ",20,"د",1,0],["ليهنك يا عينَ الزمان وأهله","ويهني الورى عامٌ بسعدِك آيب",21,"ب",1,1],["ليهنكَ وِدّ الناصرِ الملك إنهُ","دليلٌ على وصل الهنا المتودّد",22,"د",1,0],["ليهنك العيد يا عيداً ويا سنداً","للعالمين رَوَوا في الحمد إسنادي",23,"ي",1,0],["ليهن بني أيوب أن محمداً","بنى لهمُ في كل صالحةٍ ذكرا",24,"ر",2,0],["ليهنك ما تجنيه من جنةٍ غدا","بإبطال ما تجنى الجناياتُ من وزر",25,"ر",1,0],["ليهنك ما عمّرته من معالمٍ","سيثني على عمارهنّ أبو ذَرّ",25,"ر",1,0],["ليهن من باتَ مسروراً بهجعته","إني عليهِ قريحُ الطرف ساهره",26,"ر",2,0],["ليهنك الفضل في دنيا وآخرة","والذكر والأجر من جاريهما جارِي",27,"ي",1,0],["ليهن حما الشهباء قاضٍ حوت به","كمالاً على تفضيله اتفق النص",28,"ص",1,1],["ليهنك العام تلقى","ألف السعادة ألفه",29,"ف",2,0],["ليهن بدر الحسن في حلة","تعذيب قلبي وهو في حل",30,"ل",1,1],["ليهن بنو الآمال أنك قادم","لك السعد والإقبال عبدٌ وخادم",31,"م",1,1],["لِيَهنِ فتىً أطراك أنْ نال سُؤْلَهُ","لديك وأنْ لم يحتقِب وِزْرَ كاذبِ",32,"ب",1,0],["لِيَهْنِ الضِّياعَ وكُتَّابَها","وعُمّالَها ثم أربابَها",33,"ب",3,1],["ليهنِئْهمُ سيدٌ أيِّدٌ","صحيحُ الرَّويَّة في الكارثِ",34,"ث",1,0],["ليَهْنَأ الملكَ أن أصلحتَ فاسده","وأن حرست من الإفساد ما صلحا",35,"ح",2,0],["ليهنكِ أنْ قد مرّ من صدر دولة","شهورٌ توالتْ بعدهن شهورُ",36,"ر",1,1],["لِيهنئ رجالاً لا تزال تجودهم","سحائبُ من كلتا يديك مواطر",37,"ر",1,0],["ليهْنك لبس المِهرجان وإن غدا","تُهنِّئه الدنيا بأنك لابسُهْ",38,"س",2,1],["لي هِمة لم يكن ليرويها","إلا من البحرِ بعضُ أحواضه",39,"ض",2,0],["ليهنِك حقٌّ ردَّه اللَه منعِماً","عليك به لا بل على الناس أجمعا",40,"ع",2,1],["ليهنك أنك مستقبِلٌ","دوام المزيد بلا قاطعِ",41,"ع",1,0],["ليهنيكُمُ أن ليس يوجد منكمُ","لبوس ثياب المجد لكن خلوعها",42,"ع",3,0],["ليهنَكَ أن أفطرتَ لا متطلعاً","إلى الفطر كي تغشى من اللهو مَحْرما",43,"م",2,1],["لِيَهنَء شَريكاً وَطبُهُ وَلِقاحُهُ","وَذو العُسِّ بَعدَ النَومَةِ المُتَبَرِّدُ",44,"د",1,0],["لِيَهنِئكَ ما أَعطاكَ رَبُّكَ إِنَّها","مَواقِفُ هُنَّ الغُرُّ في مَوقِفِ الحَشرِ",45,"ر",1,0],["لَيُهنِني إِن طلعتَ بَدراً","لأعيُنِ الخَلقِِ مُستَتِمّا",46,"م",2,0],["لِيُهَنيء أَهلَ مالِقَةَ اِنتِصاري","وَإِعزازي لَهُم بَعدَ الهَوانِ",47,"ن",1,0],["لي هِمَّةٌ فوق هامِ النَّجْمِ أخمَصُها","وإن تطامنَ تحتَ العُدم مَفْرِقُها",48,"ق",3,1],["لِيَهْنِكَ أنْ أعديتَنِي الشوقَ بعدَما","تماثَلَ من داءِ الصَّبَابَةِ مُوجَعُ",49,"ع",1,0],["لِيَهنِكَ في اِبنِكَ العَبّاسِ هَديٌ","تَبَيَّنَ مِن رَشيدِ الأَمرِ هادِ",50,"د",1,0],["لِيَهنِكَ أَن قالوا سَريَّةُ مُفلِحِن","أَبانَ طَلى العاصينَ وَقعُ جَلادِها",51,"د",3,0],["لِيَهنَأ أَخِلّايَ الَّذينَ أَوَدُّهُم","ذَخائِرُ ما في الصَدرِ مِن صادِقِ الوِدِّ",52,"د",1,0],["لِيَهنَأ بَني يَزدادَ أَنَّ أَكُفَّهُم","خَلائِفُ أَنواءِ السَحابِ الرَواجِسِ",53,"س",1,0],["لِيَهنِ اِبنَهُ خَيرَ البَنينَ مُحَمَّداً","قُدومُ أَبٍ عالي المَحَلِّ جَليلِهِ",54,"ل",2,0],["لِيَهنِكَ أَن أَمسى بِدارِ خَزايَةٍ","وَأَن باتَ مَشغولاً وَخَوفُكَ شاغِلُه",55,"ل",2,0],["لِيَهنِ المُسلِمينَ بِكُلِّ ثَغرٍ","سَلامَةُ رَأيِكَ الثَبتِ الأَصيلِ",56,"ل",1,0],["لِيَهْنِ الأميرَ التَّغلبيَّ قُدومُه","وفَتحٌ تَوالتْ بالسُّعودِ طوالِعُه",57,"ع",2,0],["ليَهْنِكَ أنَّ الرومَ ذَلَّ عزيزُها","فصارتْ مواليها بِعزِّكَ أعبُدا",58,"د",2,0],["لِيَهنِكَ أَنَّ لي وَلَداً وَعَبداً","سَواءٌ في المَقالِ وَفي المَقامِ",59,"م",1,1],["لِيَهنِكَ إِنَّ الدَمعَ بَعدَكَ مُطلَقٌ","لَفَرطِ الأَسى وَالقَلبَ بِالهَمِّ في سِجنِ",60,"ن",1,0],["لِيَهنِكَ مُلكٌ لا يَزالُ مُخَيِّماً","لَدَيكَ وَذِكرٌ في الأَنامِ شَريدُ",61,"د",1,0],["لِيَهنِكَ أَنّي في القِراعِ وَفي القِرى","وَفي البَحثِ حَظّي الصَدرُ وَالصَدرُ وَالصَدرُ",62,"ر",1,1],["ليهنك عودةُ عيدٍ مَشَى","إليك على جَمْرَةِ الشوْق عاما",63,"م",2,0],["ليهنئ بني الإسلام أنْ أبْتَ سالما","وغادَرْتَ أنْفَ الكفرِ بالذلّ راغما",64,"م",2,0],["لِيَهنَكَ فتحٌ أولغ السيف فيهمُ","ولاح بِوَجه الدين من ذِكره بِشرُ",65,"ر",1,0],["لِيَهْنِ الرعايا منك عَدلُ سياسَةٍ","ودفعُ خطوبٍ لليالي بها غدرُ",66,"ر",1,0],["لِيَهنَكَ أنَّ مُمتَنِعَ الأماني","لِكَفِّكَ في تَناوُلِها اختِيارُ",67,"ر",1,0],["لي هوىً آوي إليه مرحاً","غَيرَ أَنِّي بِالنهى عَنهُ حَيود",68,"د",1,0],["لِيَهنِكَ يا سَليلُ فَقَد هَنَتني","بِما عوفيتَ عافِيَةٌ هَنِيَّه",69,"ن",3,1],["لِيَهنِ اِمرَأً أَثنى عَلَيكَ بِأَنَّهُ","يَقولُ وَإِن أَربى فَلا يَتَقَوَّلُ",70,"ل",1,0],["لِيَهنِئ تَنوخاً أَنَّهُم خَيرُ أُسرَةٍ","إِذا أُحصِيَت أولى البُيوتِ وَعُدَّتِ",71,"ت",1,0],["ليهنكِ بلبالي عليكِ ورقتي","إليكِ كما قلبي لديكِ على البعدِ",72,"د",1,0],["ليهنكَ أنَّكَ عينُ الزمانِ","فليتَ على عينِهِ الواقيَهْ",73,"ي",2,0],["لَيَهنَكَ وافِدُ أُنسٍ سَرى","فَسَرّى وَفَصلُ سُرورٍ طَرَق",74,"ق",1,1],["لِيَهْنِكِ أُمَّ كُلثومٍ مُقامٌ","كريمٌ عِندَ مَرْجُوٍّ مُثيبِ",75,"ب",1,0],["لِيَهنِكَ عِيدٌ في لِقَائِكَ عَاشِقٌ","وَلَيسَ لِصَبّ هَامَ في المضجدِ عَاذِلُ",76,"ل",1,0],["لِيَهْنَكَ الفَتْحُ لا أنّي سمِعتُ بهِ","ولا على اللّهِ فيما شاءَ أشْتَرِط",77,"ط",1,0],["لِيَهنِ وُلاةَ اللَهوِ أَنَّكَ هالِكٌ","فَأَنتَ بِما يَجري عَلَيكَ حَقيقُ",78,"ق",1,0],["لِيَهنِئ بَني ذُبيانَ أَنَّ بِلادَهُم","خَلَت لَهُمُ مِن كُلِّ مَولى وَتابِعُ",79,"ع",1,1],["لَيَهنَأ لَكُم أَن قَد نَفَيتُم بُيوتَنا","مُنَدّى عُبَيدانَ المُحَلِّإِ باقِرَه",80,"ر",2,0],["لِيَهْنِكَ في المكارِم والمعَالي","كَمَالٌ عَلّمَ القَمَرَ الكَمالا",81,"ل",2,0],["ليَهْنَ رَكْبٌ سَرَوا ليلاً وأنتَ بهم","بسَيرِهم في صباحٍ منكَ مُنْبَلِجِ",82,"ج",1,0],["ليَهْنِكَ المَجْدُ الذي بيْتُه","فوْقَ سَراة النجْم لا يُهدَمُ",83,"م",1,0],["ليه تشتهي النوم عيون","وعيون سواهي هواجع",84,"ع",1,0],["ليه يا حبيبي نسيتني","وغاب جمالك وطيفه",85,"ه",1,0],["لِيَهْنَ الْهَوَى إِنِّي خَضَعْتُ لِحُكْمِهِ","وَإِنْ كَانَ لِي فِي غَيْرِهِ النَّهْيُ وَالأَمْرُ",86,"ر",1,0],["لِيَهْنَ بِهِ مَنْ باتَ جَذْلانَ نَاعِماً","أَخَا نَشَوَاتٍ ما عَلَيْهِ حَقُودُ",87,"د",1,0],["لِيَهْنِئْهمُ اللًّهْوُ لا عَيْبَ فِي","هِ يَشُوبُ لصَفَاءَ وَلا مَأْثَمُ",88,"م",1,0],["لِيَهْنِيءِ الأَمْلاَكَ فِي خُلْدِهِمْ","مَنْ بِنَوَاهُ أَوْحَشَ الإِنْسَا",89,"س",2,0],["لِيَهْنِئْكَ أَنْ فَازَتْ بِلاَدُك بِالمُنى","وَقِسْطُكَ فِي إِنْجاحِها لَيْسَ يُنْكَرُ",90,"ر",1,0],["لِيَهْنِئْكَ الْقِرَانُ بِذَاتِ نُبْلٍ","مِنَ الْغِيد الصِّبَاحِ وَذَاتِ طُهْرِ",91,"ر",1,0],["لِيَهْنئكُمَا هَذَا القرانُ فَإِنَّهُ","سُرُورٌ بمَا نَلْقى وَبُشْرَى بمَا بَعْدُ",92,"د",1,0],["لِيَهنَ دِمشقَ اليَومَ صِحَّتُكَ الَّتي","بِها فَرِحَت وَالمُدُنُ كَالناسِ تَفرَحُ",93,"ح",1,0],["لِيَهنِكَ أَن أَحمَدتَ عاقِبَةَ الفَصدِ","فَلِلَّهِ مِنّا أَجمَلُ الشُكرِ وَالحَمدِ",94,"د",1,1],["لِيَهنكَ يا اِبني أَنَّ شُربَكَ بارِدٌ","وَشُربي إن لَم يَعفُ رَبّي آنِ",95,"ن",1,0],["ليَهنَكَ يا عَبد الغَنيّ اِبني الرِضا","مَحَلٌّ بِطوبى طابَ فيهِ حُلولُ",96,"ل",1,0],["ليهنِكَ: أنَّك ما متَّ إلا","وغرسُ يمينِكَ داني الثَّمر",97,"ر",1,0],["لَيهْنك، يا أبولُّوا، الانتصارُ","بربك: كيف طرْت بهم وطَاروا؟",98,"ر",3,1],["ليهنيك منصور اللواء مؤيد","بحار الندى من جود كفيه تغرف",99,"ف",1,0],["ليهنك شمس الدين ما حزت من علا","خواتمها موصولة بالفواتح",100,"ح",1,0],["ليهنِ بَنِي كعبٍ مقامُ فتاتهمْ","ومقعدها للمؤمنينَ بمرصدِ",101,"د",1,0],["ليهنئْ لكم أن قد نفيتمْ بيوتنا","، مندى عبيدانَ المحلئِ باقرهْ",102,"ر",2,0],["لِيَهْنِكَ الخلدُ في الأخرى وجنتُه","يا خير منقلبٍ في خير منقَلب",103,"ب",1,0],["لِيَهْنىءْ بَنِي يزداد أنّ أكُفّهُمْ","خَلائِفُ أنْوَاءِ السّحابِ الرّوَاجِسِ",104,"س",1,0],["ليهنئ أخلاي الذين أودهم","ذخائر ما في الصدر من صادق الود",105,"د",1,0],["ليَهْنِ الملكَ أن أصلحتَ فاسده","وأن حرست من الإفساد ما صلحا",106,"ح",2,0],["لِيهنىء رجالاً لا تزال تجودهم","سحائب من كلتا يديك مواطر",107,"ر",1,0],["ليَهنىء شريكاً وطبُه ولِقاحُه","وذوو العس بعد نومة المتبرد",108,"د",1,0],["لِيهن ذا العيد حَظ مِنهُ حينَ غَدَت","عُلاهُ ثُمَ حُلاهُ مِن أَياديكا",109,"ك",2,0],["ليهن ترابٌ صم حسنك أنه","سيرويه منه عارضٌ متصبب",110,"ب",1,0],["لِيَهنئ بَني عَبدِ مَنافٍ عُقوقُها","وَخِذلانُها وَتَركُنا في المَعاقِلِ",111,"ل",1,0],["ليهنِك آلاءٌ ضمِنتَ وفاءَها","من الجود حتى بات ناعمَ بالِ",112,"ل",1,0],["لِيَهنِكَ عيدٌ إِذا ما حَضَرتَ","زَماناً سِوى وَقتِهِ لَم يَغِب",113,"ب",1,0],["لِيَهنِكَ ما أَنالَتكَ الجُدودُ","وَأَنَّ الدَهرَ يَفعَلُ ما تُريدُ",114,"د",1,1],["لِيَهنِكَ ما أَصفَتكَ أَلسِنَةُ الوَرى","مِنَ الشُكرِ عَفواً وَالقُلوبُ مِنَ الوُدِّ",115,"د",1,0],["لِيَهنِكَ ذا العيدُ الشَريفُ وَلا تَزَل","لَهُ ما أَقامَ النَيِّرانِ مُشَرِّفا",116,"ف",2,0],["لِيَهنِ العُلى فَرعٌ غَدَوتَ لَهُ أَصلا","وَغَرسٌ نَمَتهُ تُربَةٌ تُنبِتُ الفَضلا",117,"ل",2,1],["لِيَهنِكَ عيدٌ أَنتَ عِصمَهُ أَهلِهِ","فَلا خابَ مِنكُم مَن دَعا وَتَبَهَّلا",118,"ل",2,0],["لِيَهنِكَ ما شادَت لَكَ الهِمَمُ العُلا","وَهُنّيتَ مَجداً لَم يَجِد عَنكَ مَعدِلا",119,"ل",2,1],["ليهننا بك عيد أنت شاهده","عيد النفوس إذا نالت أمانيها",120,"ي",3,0],["لِي هَوىً فِيكَ مَصُونُ","لَيْسَ لِي فيهِ مُعِينُ",121,"ن",1,1],["ليهنك عيداً ودانا بقربهِ","نهنيه لكنْ عنه مِلناً مع الحبِّ",122,"ب",1,0],["ليهنك الملك رب العرش عاقده","دون الورى لك والسعد الذي كملا",123,"ل",2,0],["لِيَهنَكُما أَن لَم تُراعا بِفُرقَةٍ","وَما دَبَّ في تَشتيتِ شَملِكُما الدَهرُ",124,"ر",1,0],["لِيَهنِكَ عِيدٌ أَنتَ أَحلى شَمائِلاً","وَأَحسَنُ مِنهُ إِن تَنَكَّرَ حادِثُ",125,"ث",1,0],["ليَهنِكَ ما مَنَحتُكَ مِن ثَناءٍ","بِهِ لا غَيرِهِ يَجِبُ القِيامُ",126,"م",1,0],["لِيَهنِكِ إِمسَاكِى بِكَفِّى عَلَى الحَشَا","وَرَقراقُ عَينِى خَشيَةً مِن زِيالِكِ",127,"ك",1,0],["لِيَهنِك إِمساكى بِكَفِّى عَلَى الحَشا","وإِذرَاء عَينى دَمعَها فِى زِيالِكِ",128,"ك",1,0],["لِيهنِكَ أَيُّها المَولَى وِسامٌ","حَصَلَت بِهِ عَلى الشَرفِ المَجيدِ",129,"د",1,1],["ليهنِكَ ما وافاكَ مِن فَيضِ نعمةٍ","أَتَتكَ فَحَلَّت مِنكَ خَير مَكانِ",130,"ن",1,1],["لِيهنئكمُ إِن طاعَكُم بَعدَنا الكَرى","فَمُذ بَينكُم لَم نوطئ الجَنبَ مَرقَدا",131,"د",2,0],["لي همّةٌ تهجر المرعى الدَّنىَّ على خِصْبٍ","وتأتي العُلَى لو لاح أَجْدَبه",132,"ب",2,0],["ليَهْنِكَ عيدٌ جاء شوقاً لنظرةٍ","إليك له من أَجْلِها سنةٌ يَغْدو",133,"د",2,0],["ليَهْن العيد أنْ وافاك فيه","وملكُك زاهرُ الأَكْناف بَض",134,"ض",1,0],["ليَهْنِ فؤادي أنه قد سَلاكمُ","وآمَن من خوف القَطيعةِ والصَّدَّ",135,"د",1,0],["ليَهْنِك شهرُ الصوم وهْو مُبشِّر","بسعدٍ بدتْ منه إليك الطَّلائع",136,"ع",1,0],["لي همّة وبصيرة وقريحة","فبغير جدّ ما تراني أصنع",137,"ع",1,0],["لي همّة قد شأت كيوان في قرن","ولي يد عند بذل الجود تنتفض",138,"ض",1,0],["ليهنكَ اليومَ أني ممسكٌ كبدي","وإنها قطعٌ تجري هنا وهنا",139,"ن",2,0],["ليهنَ أمير المؤمنين جلوسه","على العرش وليهنَ البرايا سرورها",140,"ر",3,0],["ليهنك شكل مولود سعيد","بديع الوصف زاد على السماع",141,"ع",1,1],["ليهنئك نصر الله والفتح بعده","فما مثل هذا الفتح في العصر يسمع",142,"ع",1,0],["ليهنك نصر الله والفتح بعده","ففي ذا لنا البشرى وفي ذلك البشر",143,"ر",1,0],["ليهنك العود نحو الأهل والوطن","يا فرحة الأهل بل يا فرحة السكن",144,"ن",1,1],["لِيَهنَ عيدٌ بك أَضحت له","فَضائِلٌ جلَّت عن العَدّ",145,"د",1,0],["لِيهِنك يا مِلءَ عينِ الزّمان","دوامُ السّرورِ ونيلُ الأماني",146,"ي",1,1],["لِيهن مِصَر العُلا وما جَمَعتْ","بِه من المكُرماتِ والزَّينِ",147,"ن",1,0],["ليهنِك يا بدرَ أفقِ العُلا","وِلادةُ شمسك للأنجم",148,"م",1,0],["لِيَهْنك أنّ الصومَ فرضٌ مؤكَّدٌ","من الله مفروضٌ على كلّ مسلمِ",149,"م",1,1],["لِيهنِ الإمامةَ ما نِلته","فقد تَمم الله آمالها",150,"ل",3,0],["ليهنَ سعودَ العيد أَنّ نجومها","ببرجِك ما زالت على السعد تلتقِي",151,"ق",2,0],["لِيهنك أني لم أجِد لك عائباً","سوى حاسدٍ والحاسدون كثير",152,"ر",1,1],["لَيهْنِ المعالي أنني أنا رَبُّها","وأني متى ما رمت صعباً تيسّرا",152,"ر",2,0],["لِيَهْنِ المُلْكَ مالِكُه الجديدُ","ووارِثُه وإن رَغِمَ الحَسودُ",153,"د",1,1],["لِيَهْنِك أنّ الله فوقك مالك","ودونك كلّ المالِكين عبيد",154,"د",1,0],["لِيَهْنك نُوْروزٌ تَباشَرتِ العلا","بسعدك فيه واضمحلّت بك النُّوَب",155,"ب",1,0],["لَيهْنِك أنّ الفضَل أجمعَ كلَّه","إليك أبا المنصور وَحْدَك يُنْسَب",156,"ب",1,0],["لِيَهنِكَ مِنّي هَوىً لازِمٌ","يُمَزِّقُ صَبري وَيُمسي جَديدا",157,"د",2,0],["لِيَهنِ نِظامَ الدينِ سابِغُ نِعمَةٍ","رَآهُ أَميرُ المُؤمِنينَ لَها أَهلا",158,"ل",2,0],["لِيَهنِكِ أَنِّي في حَبالِكِ عاني","وَأَنَّكِ مِنّي في أَعَزِّ مَكانِ",159,"ن",1,1],["لِيَهنِكِ أَنَّ عَيني ما تَنامُ","وَأَنِّي فيكِ صَبٌّ مُستَهامُ",160,"م",1,1],["لِيَهنِكُمُ يا قالَةَ الشِعرِ أَنَّكُم","نَزَلتُم عَلى عَذبِ المَوارِدِ سَلسالِ",161,"ل",1,0],["لِيَهنَ مَعاليكَ يا اِبنَ الكِرامِ","مَدحٌ إِذا نَفِدَ المالُ باقي",162,"ي",1,0],["لِيَهنَ أَبا العَبّاسِ لِلَّهِ نِعمَةٌ","تُراوِحُهُ مَوصولَةً وَتُباكِرُه",163,"ر",2,0],["لِيَهنِ الدَينَ وَالدُنيا جَميعاً","وَأَهلَ الأَرضِ مِن ماشٍ وَراكِب",164,"ب",1,0],["ليهنكَ يا بيلُ الجلالُ وعزةٌ","يكادُ لها القلبُ الكسيرُ يطيرُ",165,"ر",1,1],["ليهنِكَ يَومٌ لا يَرى الدَهرَ مِثلُه","أَجَلُّ وَأَوفى في سُرورٍ وَأَفضَلُ",166,"ل",1,0],["ليهن بك العلياء يا بن عليها","بروج شموس أو مدار بدور",167,"ر",1,0],["ليهنئكِ يا أمّاه نومُكِ في الضُّحى","ترينَ حقولاً أنضرت وأكاما",168,"م",2,0],["ليهنئكِ إنَّ الموتَ يُبقيكِ حرةً","ويطرحُ هذا الجسمَ للحَشرات",169,"ت",1,0],["لِيَهْنئ الدّينَ والدُّنيا إِمامُ هُدىً","ميلادُهُ للنّدى والبَأسُ ميلادُ",170,"د",1,0],["لِيَهْنِ الْمُلْكَ أَنَّكَ بِتَّ مِنُْ","بِمَنْزِلَةِ الْخَدِينِ مِنَ الْخَدِينِ",171,"ن",1,0],["لِيَهنِ سُكانَ نَجدٍ أَنَّ مَسكَنَهُم","قَلبي وَإِن نَزَحَت ما بَينَنا الدارُ",172,"ر",1,0],["لِيَهنِها أَن ظَفِرَت لا صَفِرَت","عَنهُ بِجَدٍّ نازِحٍ عَنهُ اللَّعِب",173,"ب",1,0],["ليَهنكَ مجدٌ يا ابنَ أَحمدَ لم تَزَل","فواضلُه مشهورةً وفضائلُه",174,"ل",2,0],["ليهنك أَنْ هبّوا معيدين مجدَهمْ","فقرَّ بهمْ عيناً بلغتَ الأمانيا",175,"ي",2,0],["ليهنك أنَّ أهلَ الأرضِ إلبٌ","عَلى أن يدركوا لذويك ثأرا",176,"ر",2,0],["ليهنَ (تموز) من فازوا به فلقدْ","كان الشقاء لنا فيه بمرصاد",177,"د",1,0],["لِيَهنِكُمُ أَنّا نَزَلنا بِبَلدَةٍ","كِلا مَلَوَيها مُبئِسٌ غَيرُ مُنعِمِ",178,"م",1,0],["لِيهناك ما قَد شادَ نجلاكَ من علىً","وَما أتلدا من مفخرٍ أنت جذمهُ",179,"م",2,0],["لِيهنيك أنّي قد حسوتُ مراره","ولا زال منه بي مساورة الرعبِ",180,"ب",1,0],["لِيَهْنِكَ لِلطَّيْرِ إنْقَضَاضٌ إلى الثَّرَى","وَلِلخَيلِ مَرْقًى في الهَوَاءِ وَمِصْعَدُ",181,"د",1,0],["لِيَهنك عيد النَحر فاِنحر بِهِ العِدا","وَضحّ ضَحاياها تَنلك أُجورها",182,"ر",3,0],["لِيهنك ذا النجل السَعيد وَإِنَّما","لَنا البشر فيهِ حَيث يَشملنا الودُّ",183,"د",1,0],["ليهن ورق الحِمى في الأَيك تَغريد","فَحَبَّذا مِن أَماليها الأَناشيدُ",184,"د",1,1],["لِيَهْنِكَ ما تَجدَّد من جَلالٍ","بما أَولاك سُلطانُ البَرايا",185,"ا",3,0],["ليَهْنكَ أَنْ سكنْتَ القلبَ منّي","وقَبلَك لم يكُنْ قلبي بساكن",186,"ن",1,0],["لِيَهْنِكَ أنّ خُوزِستانَ أَلْقَى","إلى يَدِكَ العِنانَ على المَيامن",186,"ن",1,0],["لي هوىً يُبْلي ولي دمعٌ يَشي","أىُّ أسراريَ تَخْفَى بينَ ذَيْن",187,"ن",1,0],["ليَهْنِكَ أنّ مُغيثَ الأنامِ","غدا لك بالوُدِّ غَيْثاً هَتونا",188,"ن",2,0],["ليَهْنِكَ مَوْقفٌ أظهرتَ فيه","لدينِ اللهِ إعزازَ المكان",189,"ن",1,0],["لِيَهْنِكُما أنّي الغداةَ إليكما","على عِزِّ أَنصاري جَعلْتُ ركوني",190,"ي",1,0],["ليَهْنِكِ يا ابنةَ الأقوامِ أَنّي","بحُبّكِ لو جَزيْتِ الصَّبَّ هائم",191,"م",1,0],["لِيَهْنِ الرّجالَ الأغنياءَ مُقامُهمْ","وإنَّ عناءَ المُقْتِرينَ طويل",192,"ل",1,0],["لِيَهْنِ الورَى أن قد وُقيتَ مِنَ الرَّدى","وأنْ قد رمَى الدَّهرُ العِدا في المَقاتل",193,"ل",1,0],["لِيَهْنِكَ ولْيَهْنِ الخليقةَ كُلَّها","تَجدُّدُ بُشرَى في الوجوه لها بِشر",194,"ر",1,0],["ليهْنِك يا أعلى بني الدّهرِ منصباً","تَوقُّلُ جَدّ في ذرا المجدِ صاعد",195,"د",1,0],["لِيَهنَ مِصرَ الرَخا وَالأَمنَ في قَرَنٍ","فَما بِها شَغَبٌ يُخشى وَلا سَغَبُ",196,"ب",1,0],["لِيَهنِكَ شِبلٌ جاءَ مِن أَسَدٍ وَردِ","سَيُهدَى إِلى طُرقِ المَكارِمِ وَالمَجدِ",197,"د",1,1],["لِيَهنِ الَّذي تَسري إِلَيكَ رِكابُهُ","يُسايِرُ في الوَجهِ العَبوسِ بِها بِشرُ",198,"ر",1,1],["لِيَهنِكَ فَضلٌ لا يُنالُ لَهُ كُنهُ","كَأَنَّ العُلا مَعنىً وَقيلَ لَهُ كُنهُ",199,"ن",2,0],["لِيَهنِ العُلا أَنَّ الهُمومَ كَتائِبٌ","وَأَنِّيَ أَلقاها وَحيداً وَأَهزِمُ",200,"م",1,0],["لَيَهنِكَ مِن بَعدِ الرَدى باقي الثَنا","وَإِن كُنتَ مِن تَحتِ الثَرى بالِيَ البُردِ",201,"د",1,0],["ليَهنكَ اليومُ الذي لم تَكُن","تَتركُهُ الأيَّامُ يَهنِينِي",202,"ي",1,0],["ليهنِكَ ماضٍ ومُستَقبلٌ","وآخرُ بينَهما يحضُرُ",203,"ر",1,0],["لِيَهْن عمادَ الدّين منهُ مُسوّدٌ","به جمعَ اللهُ السِّيادة والنّبلا",204,"ل",2,0],["ليَهْنِ قَوماً إلى أبوابه وَفدُوا","فإنها كعبةُ المعْروفِ والحَرَمُ",205,"م",1,0],["ليهنك إذ زُفَّتْ إليك عروس","من الغيد في ثوب العفاف تميس",206,"س",1,1],["ليهن كلاك مَداها القَصيّ","وَمجد يُؤَثَّل عَنها سَنىِّ",207,"ن",2,1],["ليهنك عيد قَد أَطَلَّت سعوده","وَشهر صيام وَدَّعتك أَواخِرُهُ",208,"ر",2,0],["ليهنَ مروطَ الخُسُروانيِّ إِنَّهُ","يُباشِرُ مِنها بِالحَرير حَريرُها",209,"ر",3,0],["لي هِمّة كَضِياء الصبح مشرقة","في حِندِسٍ وَجِناني لَيسَ بِالنَخبِ",210,"ب",1,0],["لِيَهنِكُمُ المُلكُ الَّذي أَصبَحَت بِكُم","أَسِرَّتُهُ مُختالَةً وَالمَنابِرُ",211,"ر",1,0],["ليَهنِكُم العَقْدُ المبارَك إنَّهُ","على خير كُفْوٍ للكريم وأقرانِ",212,"ن",1,1],["ليهْنِكُمُ من الأَنصار قاضٍ","لدين الله في الدُّنيا نصير",213,"ر",1,0],["ليهن العراقين الهناء فقد سرى","إليها المحض والنائل الجزل",214,"ل",1,0],["ليهنك حكم الله يمضي غراره","مضاء حسام أرْهَفَتْه الصياقل",215,"ل",1,0],["ليهْنِك سيِّدي عيدٌ سعيدٌ","عليك له مدى الأَعوام عَوْد",216,"د",1,0],["ليهنِك رُتْبَةٌ تعلو وتسمو","ونيشانٌ نُؤرِّخه افتخارا",217,"ر",2,0],["ليهنك العيد إذا وافاك مبتهجاً","بطلعةٍ منك زانَتْ بهجة العيد",218,"د",1,0],["ليهنك اليوم أبناءٌ لهم نسب","أضحى على جبهة الأيام مسطورا",219,"ر",2,0],["لِيَهْنِك يا نحير أهلِ زمانِهِ","ويا كاملاً عنه غدا الطرف قاصرا",220,"ر",2,1],["ليهنك النصر والفتح المبين وما","بلغت من جانب السلطان من أرب",221,"ب",1,0],["لِيَهْنِك ما بَلَغْتَ من الأماني","فَلَمْ تَبْرَح بأيَّام التَّهاني",222,"ن",2,1],["ليهنك أنت يا بغداد منه","بطلعة حسن مرجوٍ مهاب",223,"ب",1,0],["لِيَهْنِكُمُ زواجٌ في هناءِ","به انشرحت لأقوامٍ صدورُ",224,"ر",1,1],["لِيَهْنِكَ النَّصْرُ يا غَرَامُ فَكَمْ","لِوَاءِ قَلْبٍ عَلَيْكَ خَفَّاقِ",225,"ق",1,0],["ليَهْنِ يدَ الخَطْبِ التي طرّقَتْ لنا","إليك سبيلاً أنها عندنا يَدُ",226,"د",1,0],["ليَهْنِ المُلكَ أن أمسى مَصوناً","عشيةَ راحَ عزُّهُمُ مُصابا",227,"ب",2,0],["ليَهْنِكَ أنّه فتحٌ مُبيرٌ","منيرٌ في مطالعِه مُبينُ",228,"ن",1,0],["ليهنِكُمُ العيدُ السعيدُ وإن غَدا","بفضلكُمُ يزهو جلالاً ويزدانُ",229,"ن",1,0],["ليَهْنكَ بل ليَهْنِ الناسَ عيدٌ","رأوا فيه جبينَك والهِلالا",230,"ل",2,0],["ليهنأ بك شهر الصوم حقاً","كلما وافى فمنك التهنئات",231,"ت",1,0],["لِيَهْنِكَ الفِطْرُ والأَعيادُ تتبعُهُ","فِي عِزِّ مُلْكِكَ مَا فِي صفوِهِ كَدَرُ",232,"ر",1,0],["لِيَهْنِكَ أَنَّ العيدَ وافاكَ قادِماً","بأوشَكِ بادٍ للسرورِ وعائِدِ",233,"د",1,0],["ليَهْنِ لَكَ العيدُ الَّذِي بِكَ يَهْنِينا","سلاماً وإِسلاماً وأَمناً وتأْمِينا",234,"ن",2,1],["ليهنَ عينك طُهْرٌ","يفضي لأحسن حال",235,"ل",1,0],["ليَهنِ الوزارةَ أن زُوّجتْك","على طول ما لبِثتْ تُعضَلُ",236,"ل",1,0],["ليهن التُّقى والدين كونك سالماً","فلا دينَ إلا حيث أنت مجاهد",237,"د",1,1],["ليهْنك عيدٌ أنت عيدٌ لأهلهِ","سرورٌ لمهمومٍ ووُجْدٌ لمُمْلقِ",238,"ق",1,0],["ليهْنَ عليَّ الخيرِ أني جزيتهُ","بنُعْمى يديه الصَّالحاتِ البَواقيا",239,"ي",2,0],["ليَهْن الرَّعايا والمناقبَ والعُلى","سرورُكم ما أنبت العُشْبَ ماطِرُ",240,"ر",1,1],["ليهن الورى برء العلى والفضائل","هناء الثرى بالمدجنات الهواطل",241,"ل",1,1],["ليهنَ بك الفطر بعد الصيام","فإنك تسني فعالاً وتسني",242,"ي",1,0],["لِيَهودِ كلِّ الأرض ِ، أو لِكلابِها","لا تَستَحي منكم ، ولا تَتَورَّعُ",243,"ع",1,0],["ليهن أباك المليك الذي","جرى في المكارم شوطاً بعيدا",244,"د",2,0],["ليهنك إن سعيك في","مساعي المجد متضح",245,"ح",1,0],["ليهنك عهد لا يضاع وإن نأت","نواك وسر لا يذاع فيسمعُ",246,"ع",1,1],["لِيهنئ أَرضَ أَندلس بدور","مِن السَرّاء لَيسَ لَها سِرارُ",247,"ر",1,0],["لِيَهْنِكَ نصرٌ عزُّهُ يخذُلُ العِدا","وفتحٌ يحلُّ المُغلَقاتِ من الأمرِ",248,"ر",1,0],["ليَهنكَ صومُ الشهرِ وُفّيتَ أجرَهُ","وبالعزِّ عُقباهُ لك اللَّهُ يختمُ",249,"م",1,0],["ليَهنكَ سيّدي عيدٌ شريفٌ","حكاكَ فجلَّ عن شِبهِ القَرينِ",250,"ن",1,0],["ليهنِكَ سيّدي فتحٌ قريبٌ","بَعيدُ الصّيتِ مرتَفعُ المَنالِ",251,"ل",1,0],["ليَهنِكَ سيّدي عيدٌ شريفٌ","يبشّر عن صيامِكَ بالثّوابِ",252,"ب",1,0],["ليهْنِك بعد صومك عيدُ فطْرٍ","يُريكَ بقلبِ حاسدِك اِنفِطارا",253,"ر",2,0],["ليَهنِك عيدُ الفِطرِ يا بهجةَ الورى","ومُلكٌ قديمٌ عاد وهو جَديدُ",254,"د",1,0],["ليهنك فتح أنجبت لك أمه","وأم العلى بالنصر والفتح عاقر",255,"ر",1,0],["ليهنك العام قد دلت بشائره","على بقائك ألفاً بعده نسقا",256,"ق",2,0],["ليهنك صوم ترتجى بركاته","وتوزن أعمال به وتكال",257,"ل",1,0],["ليهنك أن الذل والعز أصبحا","وقد قسما فيمن تهين وتكرم",258,"م",1,0],["لِي هِمَّةٌ لا تَشْتَكِي إنْ نالها","ضُرٌّ إلَى أَحَدٍ سِوَى الرَّحْمَنِ",259,"ن",1,1],["لِيَهْنِكُمُ دارُ الْمَسَرَّةِ إنّها","أَجَلُّ بِناءٍ شَيَّدَتْهُ الْخَلائِفُ",260,"ف",1,1],["لِيَهنِكَ يا مولاي جحجٌّ وعُمرةٌ","وزورةُ قبرِ المصطفى والتعبُّدُ",261,"د",1,0],["ليُهْنِكَ أنّ اللَّهَ فَوَّقَك العِدا","وقد طالعوا فيك الرّجاء وأشرفوا",262,"ف",3,0],["لي هوى بالشعب من كاظمة","ساكن هذا الحشى والكبدا",263,"د",2,0],["ليهنك نظر الله والتب للعدا","فقد خسروا الأولى ولن ي