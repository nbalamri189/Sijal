 سكنْتَ القلبَ منّي","وقَبلَك لم يكُنْ قلبي بساكن",188,"ن",1,0],["لِيَهْنِكَ أنّ خُوزِستانَ أَلْقَى","إلى يَدِكَ العِنانَ على المَيامن",188,"ن",1,0],["لي هوىً يُبْلي ولي دمعٌ يَشي","أىُّ أسراريَ تَخْفَى بينَ ذَيْن",189,"ن",1,0],["ليَهْنِكَ أنّ مُغيثَ الأنامِ","غدا لك بالوُدِّ غَيْثاً هَتونا",190,"ن",2,0],["ليَهْنِكَ مَوْقفٌ أظهرتَ فيه","لدينِ اللهِ إعزازَ المكان",191,"ن",1,0],["لِيَهْنِكُما أنّي الغداةَ إليكما","على عِزِّ أَنصاري جَعلْتُ ركوني",192,"ي",1,0],["ليَهْنِكِ يا ابنةَ الأقوامِ أَنّي","بحُبّكِ لو جَزيْتِ الصَّبَّ هائم",193,"م",1,0],["لِيَهْنِ الرّجالَ الأغنياءَ مُقامُهمْ","وإنَّ عناءَ المُقْتِرينَ طويل",194,"ل",1,0],["لِيَهْنِ الورَى أن قد وُقيتَ مِنَ الرَّدى","وأنْ قد رمَى الدَّهرُ العِدا في المَقاتل",195,"ل",1,0],["لِيَهْنِكَ ولْيَهْنِ الخليقةَ كُلَّها","تَجدُّدُ بُشرَى في الوجوه لها بِشر",196,"ر",1,0],["ليهْنِك يا أعلى بني الدّهرِ منصباً","تَوقُّلُ جَدّ في ذرا المجدِ صاعد",197,"د",1,0],["لِيَهنَ مِصرَ الرَخا وَالأَمنَ في قَرَنٍ","فَما بِها شَغَبٌ يُخشى وَلا سَغَبُ",198,"ب",1,0],["لِيَهنِكَ شِبلٌ جاءَ مِن أَسَدٍ وَردِ","سَيُهدَى إِلى طُرقِ المَكارِمِ وَالمَجدِ",199,"د",1,1],["لِيَهنِ الَّذي تَسري إِلَيكَ رِكابُهُ","يُسايِرُ في الوَجهِ العَبوسِ بِها بِشرُ",200,"ر",1,1],["لِيَهنِكَ فَضلٌ لا يُنالُ لَهُ كُنهُ","كَأَنَّ العُلا مَعنىً وَقيلَ لَهُ كُنهُ",201,"ن",2,0],["لِيَهنِ العُلا أَنَّ الهُمومَ كَتائِبٌ","وَأَنِّيَ أَلقاها وَحيداً وَأَهزِمُ",202,"م",1,0],["لَيَهنِكَ مِن بَعدِ الرَدى باقي الثَنا","وَإِن كُنتَ مِن تَحتِ الثَرى بالِيَ البُردِ",203,"د",1,0],["ليَهنكَ اليومُ الذي لم تَكُن","تَتركُهُ الأيَّامُ يَهنِينِي",204,"ي",1,0],["ليهنِكَ ماضٍ ومُستَقبلٌ","وآخرُ بينَهما يحضُرُ",205,"ر",1,0],["لِيَهْن عمادَ الدّين منهُ مُسوّدٌ","به جمعَ اللهُ السِّيادة والنّبلا",206,"ل",2,0],["ليَهْنِ قَوماً إلى أبوابه وَفدُوا","فإنها كعبةُ المعْروفِ والحَرَمُ",207,"م",1,0],["ليهنك إذ زُفَّتْ إليك عروس","من الغيد في ثوب العفاف تميس",208,"س",1,1],["ليهن كلاك مَداها القَصيّ","وَمجد يُؤَثَّل عَنها سَنىِّ",209,"ن",2,1],["ليهنك عيد قَد أَطَلَّت سعوده","وَشهر صيام وَدَّعتك أَواخِرُ