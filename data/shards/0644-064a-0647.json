m/ViewPoem.aspx?id=34179",""],[77,"أمن جانب الغربي نفحة بارح","https://www.poetsgate.com/ViewPoem.aspx?id=33654",""],[23,"جزى اللهُ ربُّ الناسِ، خيرَ جزائهِ","https://www.poetsgate.com/ViewPoem.aspx?id=11420",""],[7,"ألا أبلغا ذبيانَ عني رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=17566",""],[90,"ليت الذي بك في وقع النوائب بي !","https://www.poetsgate.com/ViewPoem.aspx?id=179093",""],[45,"يَشُوقُكَ تَوخِيدُ الجِمَالِ القَنَاعِسِ","https://www.poetsgate.com/ViewPoem.aspx?id=31217",""],[45,"تصدت لنا دعد وصدت على عمد","https://www.poetsgate.com/ViewPoem.aspx?id=31307",""],[51,"أما الزمانُ إلى سلمى فقد جَنَحا","https://www.poetsgate.com/ViewPoem.aspx?id=27419",""],[51,"أبا حسن طال المِطال ولم يكن","https://www.poetsgate.com/ViewPoem.aspx?id=29177",""],[14,"جزى اللَّهُ خيراً، كلما ذُكِرَ اسمهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17398&r=&rc=9",""]],"verses":[["لي هِمَّةٌ أَقطَعنَها قِصَدَ القَنا","في قَصدِ يَومَي مَعرَكٍ وَرِهانِ",0,"ن",1,0],["لِيَهُن مَن لَم يَفتَتِن","إِنّا لَقينا الفِتَنا",1,"ن",2,0],["لِيَهنِكَ أَنَّ النَفسَ تَمنَحُكَ الهَوى","جَميعاً وَأَنَّ القَلبَ عِندَكَ كُلَّه",2,"ل",2,0],["لِيُهوِنِ المَرءُ بِأَيّامِهِ","إِنَّ مُقامَ المَرءِ فيها قَليل",3,"ل",1,0],["لِيَهنِكَ مَولودٌ يُوَلَّدُ فَخرَهُ","أَبٌ بِشرُهُ لِلسائِلينَ ذَرائِعُ",4,"ع",1,0],["لِيَهنِكَ ما تُجَدِّدُهُ اللَيالي","وَحَسبُكَ مِن فِراقٍ وَاِجتِماعِ",5,"ع",1,0],["لِيَهنِكَ يا اِبنَ الأَكرَمينَ اِبنُ حُرَّةٍ","تَمَزَّقَ عَنهُ النَحسُ عَن غُرَّةِ السَعدِ",6,"د",1,0],["لِيَهنِ اللَيالي وَالمَعالِيَ أَنَّها","إِثابَةُ بُرءٍ عَدَّها المَجدُ مَولِدا",7,"د",2,0],["لِيَهنِكِ أَنّي لا أَزالُ عَلى أَسى","وَأَنّيَ لا أَلقاكِ إِلّا عَلى عَتبِ",8,"ب",1,0],["لِيَهنِئَكُمُ أَن قَد أَرَحتُم قُلوبَكُم","وَأَن قَد قَذَفتُم بِالصَبابَةِ في سَحري",9,"ي",1,0],["ليَهنِكِ العيدُ وَإِن كُنتُ مِن","أَجلِكِ لا يَهنِأُني العيدُ",10,"د",1,1],["ليَهْنِكَ منْصورُ اللّواءِ مؤيَّدٌ","بِحارُ النّدى منْ جودِ كفَّيْهِ تغْرِفُ",11,"ف",1,0],["ليهْنِكَ شَمْسَ الدّينِ ما حُزْتَ منْ عُلَى","خَواتِمُها موْصولَةٌ بالفَوائِحِ",12,"ح",1,0],["لِيَهدَأ عُمانُ فَغَوّاصُهُ","أُصيبَ وَأَمسى رَهينَ الحُفَر",13,"ر",1,0],["لِيَهنِ الهُدى إِنجاحُ سَعيِكَ في العِدا","وَأَن راحَ صُنعُ اللَهِ نَحوَكَ وَاِغتَدى",14,"د",2,1],["لِيَهنِكَ أَنَّكَ أَزكى المُلوكِ","بِفَيءٍ وَأَشرَفُهُم سودَدا",15,"د",2,0],["لِيَهنِئ تُراثي تَغلِبَ اِبنَةَ وائِلٍ","إِذا نَزَلوا بَينَ العُذَيبِ وَخَفّانِ",16,"ن",1,1],["ليهنئكم هذا القران فإنه","سرورٌ بما نلقى وبشرى بما بعد",17,"د",1,0],["لَيَهْنِئْكَ فِي تَأْيِيدِ أَصْدَقِ نَهْضَةٍ","لِرَفْعِ مَقَامِ الشَّرْقِ تَقْدِيرِ لُبْنَانِ",18,"ن",1,0],["لِيَهنِكَ دَولَةٌ حَدَثَت","فَأَحدَثَ عِزُّها نَشَبا",19,"ب",2,1],["لِيَهنِ أَبا بَكرٍ سَعادَةُ جَدِّهِ","بِصُحبَتِهِ مَن يُسعِدِ اللَهُ يَسعَدِ",20,"د",1,0],["ليهنك يا عينَ الزمان وأهله","ويهني الورى عامٌ بسعدِك آيب",21,"ب",1,1],["ليهنكَ وِدّ الناصرِ الملك إنهُ","دليلٌ على وصل الهنا المتودّد",22,"د",1,0],["ليهنك العيد يا عيداً ويا سنداً","للعالمين رَوَوا في الحمد إسنادي",23,"ي",1,0],["ليهن بني أيوب أن محمداً","بنى لهمُ في كل صالحةٍ ذكرا",24,"ر",2,0],["ليهنك ما تجنيه من جنةٍ غدا","بإبطال ما تجنى الجناياتُ من وزر",25,"ر",1,0],["ليهنك ما عمّرته من معالمٍ","سيثني على عمارهنّ أبو ذَرّ",25,"ر",1,0],["ليهن من باتَ مسروراً بهجعته","إني عليهِ قريحُ الطرف ساهره",26,"ر",2,0],["ليهنك الفضل في دنيا وآخرة","والذكر والأجر من جاريهما جارِي",27,"ي",1,0],["ليهن حما الشهباء قاضٍ حوت به","كمالاً على تفضيله اتفق النص",28,"ص",1,1],["ليهنك العام تلقى","ألف السعادة ألفه",29,"ف",2,0],["ليهن بدر الحسن في حلة","تعذيب قلبي وهو في حل",30,"ل",1,1],["ليهن بنو الآمال أنك قادم","لك السعد والإقبال عبدٌ وخادم",31,"م",1,1],["لِيَهنِ فتىً أطراك أنْ نال سُؤْلَهُ","لديك وأنْ لم يحتقِب وِزْرَ كاذبِ",32,"ب",1,0],["لِيَهْنِ الضِّياعَ وكُتَّابَها","وعُمّالَها ثم أربابَها",33,"ب",3,1],["ليهنِئْهمُ سيدٌ أيِّدٌ","صحيحُ الرَّويَّة في الكارثِ",34,"ث",1,0],["ليَهْنَأ الملكَ أن أصلحتَ فاسده","وأن حرست من الإفساد ما صلحا",35,"ح",2,0],["ليهنكِ أنْ قد مرّ من صدر دولة","شهورٌ توالتْ بعدهن شهورُ",36,"ر",1,1],["لِيهنئ رجالاً لا تزال تجودهم","سحائبُ من كلتا يديك مواطر",37,"ر",1,0],["ليهْنك لبس المِهرجان وإن غدا","تُهنِّئه الدنيا بأنك لابسُهْ",38,"س",2,1],["لي هِمة لم يكن ليرويها","إلا من البحرِ بعضُ أحواضه",39,"ض",2,0],["ليهنِك حقٌّ ردَّه اللَه منعِماً","عليك به لا بل على الناس أجمعا",40,"ع",2,1],["ليهنك أنك مستقبِلٌ","دوام المزيد بلا قاطعِ",41,"ع",1,0],["ليهنيكُمُ أن ليس يوجد منكمُ","لبوس ثياب المجد لكن خلوعها",42,"ع",3,0],["ليهنَكَ أن أفطرتَ لا متطلعاً","إلى الفطر كي تغشى من اللهو مَحْرما",43,"م",2,1],["لِيَهنَء شَريكاً وَطبُهُ وَلِقاحُهُ","وَذو العُسِّ بَعدَ النَومَةِ المُتَبَرِّدُ",44,"د",1,0],["لِيَهنِئكَ ما أَعطاكَ رَبُّكَ إِنَّها","مَواقِفُ هُنَّ الغُرُّ في مَوقِفِ الحَشرِ",45,"ر",1,0],["لَيُهنِني إِن طلعتَ بَدراً","لأعيُنِ الخَلقِِ مُستَتِمّا",46,"م",2,0],["لِيُهَنيء أَهلَ مالِقَةَ اِنتِصاري","وَإِعزازي لَهُم بَعدَ الهَوانِ",47,"ن",1,0],["لي هِمَّةٌ فوق هامِ النَّجْمِ أخمَصُها","وإن تطامنَ تحتَ العُدم مَفْرِقُها",48,"ق",3,1],["لِيَهْنِكَ أنْ أعديتَنِي الشوقَ بعدَما","تماثَلَ من داءِ الصَّبَابَةِ مُوجَعُ",49,"ع",1,0],["لِيَهنِكَ في اِبنِكَ العَبّاسِ هَديٌ","تَبَيَّنَ مِن رَشيدِ الأَمرِ هادِ",50,"د",1,0],["لِيَهنِكَ أَن قالوا سَريَّةُ مُفلِحِن","أَبانَ طَلى العاصينَ وَقعُ جَلادِها",51,"د",3,0],["لِيَهنَأ أَخِلّايَ الَّذينَ أَوَدُّهُم","ذَخائِرُ ما في الصَدرِ مِن صادِقِ الوِدِّ",52,"د",1,0],["لِيَهنَأ بَني يَزدادَ أَنَّ أَكُفَّهُم","خَلائِفُ أَنواءِ السَحابِ الرَواجِسِ",53,"س",1,0],["لِيَهنِ اِبنَهُ خَيرَ البَنينَ مُحَمَّداً","قُدومُ أَبٍ عالي المَحَلِّ جَليلِهِ",54,"ل",2,0],["لِيَهنِكَ أَن أَمسى بِدارِ خَزايَةٍ","وَأَن باتَ مَشغولاً وَخَوفُكَ شاغِلُه",55,"ل",2,0],["لِيَهنِ المُسلِمينَ بِكُلِّ ثَغرٍ","سَلامَةُ رَأيِكَ الثَبتِ الأَصيلِ",56,"ل",1,0],["لِيَهْنِ الأميرَ التَّغلبيَّ قُدومُه","وفَتحٌ تَوالتْ بالسُّعودِ طوالِعُه",57,"ع",2,0],["ليَهْنِكَ أنَّ الرومَ ذَلَّ عزيزُها","فصارتْ مواليها بِعزِّكَ أعبُدا",58,"د",2,0],["لِيَهنِكَ أَنَّ لي وَلَداً وَعَبداً","سَواءٌ في المَقالِ وَفي المَقامِ",59,"م",1,1],["لِيَهنِكَ إِنَّ الدَمعَ بَعدَكَ مُطلَقٌ","لَفَرطِ الأَسى وَالقَلبَ بِالهَمِّ في سِجنِ",60,"ن",1,0],["لِيَهنِكَ مُلكٌ لا يَزالُ مُخَيِّماً","لَدَيكَ وَذِكرٌ في الأَنامِ شَريدُ",61,"د",1,0],["لِيَهنِكَ أَنّي في القِراعِ وَفي القِرى","وَفي البَحثِ حَظّي الصَدرُ وَالصَدرُ وَالصَدرُ",62,"ر",1,1],["ليهنك عودةُ عيدٍ مَشَى","إليك على جَمْرَةِ الشوْق عاما",63,"م",2,0],["ليهنئ بني الإسلام أنْ أبْتَ سالما","وغادَرْتَ أنْفَ الكفرِ بالذلّ راغما",64,"م",2,0],["لِيَهنَكَ فتحٌ أولغ السيف فيهمُ","ولاح بِوَجه الدين من ذِكره بِشرُ",65,"ر",1,0],["لِيَهْنِ الرعايا منك عَدلُ سياسَةٍ","ودفعُ خطوبٍ لليالي بها غدرُ",66,"ر",1,0],["لِيَهنَكَ أنَّ مُمتَنِعَ الأماني","لِكَفِّكَ في تَناوُلِها اختِيارُ",67,"ر",1,0],["لي هوىً آوي إليه مرحاً","غَيرَ أَنِّي بِالنهى عَنهُ حَيود",68,"د",1,0],["لِيَهنِكَ يا سَليلُ فَقَد هَنَتني","بِما عوفيتَ عافِيَةٌ هَنِيَّه",69,"ن",3,1],["لِيَهنِ اِمرَأً أَثنى عَلَيكَ بِأَنَّهُ","يَقولُ وَإِن أَربى فَلا يَتَقَوَّلُ",70,"ل",1,0],["لِيَهنِئ تَنوخاً أَنَّهُم خَيرُ أُسرَةٍ","إِذا أُحصِيَت أولى البُيوتِ وَعُدَّتِ",71,"ت",1,0],["ليهنكِ بلبالي عليكِ ورقتي","إليكِ كما قلبي لديكِ على البعدِ",72,"د",1,0],["ليهنكَ أنَّكَ عينُ الزمانِ","فليتَ على عينِهِ الواقيَهْ",73,"ي",2,0],["لَيَهنَكَ وافِدُ أُنسٍ سَرى","فَسَرّى وَفَصلُ سُرورٍ طَرَق",74,"ق",1,1],["لِيَهْنِكِ أُمَّ كُلثومٍ مُقامٌ","كريمٌ عِندَ مَرْجُوٍّ مُثيبِ",75,"ب",1,0],["لِيَهنِكَ عِيدٌ في لِقَائِكَ عَاشِقٌ","وَلَيسَ لِصَبّ هَامَ في المضجدِ عَاذِلُ",76,"ل",1,0],["لِيَهْنَكَ الفَتْحُ لا أنّي سمِعتُ بهِ","ولا على اللّهِ فيما شاءَ أشْتَرِط",77,"ط",1,0],["لِيَهنِ وُلاةَ اللَهوِ أَنَّكَ هالِكٌ","فَأَنتَ بِما يَجري عَلَيكَ حَقيقُ",78,"ق",1,0],["لِيَهنِئ بَني ذُبيانَ أَنَّ بِلادَهُم","خَلَت لَهُمُ مِن كُلِّ مَولى وَتابِعُ",79,"ع",1,1],["لَيَهنَأ لَكُم أَن قَد نَفَيتُم بُيوتَنا","مُنَدّى عُبَيدانَ المُحَلِّإِ باقِرَه",80,"ر",2,0],["لِيَهْنِكَ في المكارِم والمعَالي","كَمَالٌ عَلّمَ القَمَرَ الكَمالا",81,"ل",2,0],["ليَهْنَ رَكْبٌ سَرَوا ليلاً وأنتَ بهم","بسَيرِهم في صباحٍ منكَ مُنْبَلِجِ",82,"ج",1,0],["ليَهْنِكَ المَجْدُ الذي بيْتُه","فوْقَ سَراة النجْم لا يُهدَمُ",83,"م",1,0],["ليه تشتهي النوم عيون","وعيون سواهي هواجع",84,"ع",1,0],["ليه يا حبيبي نسيتني","وغاب جمالك وطيفه",85,"ه",1,0],["لِيَهْنَ الْهَوَى إِنِّي خَضَعْتُ لِحُكْمِهِ","وَإِنْ كَانَ لِي فِي غَيْرِهِ النَّهْيُ وَالأَمْرُ",86,"ر",1,0],["لِيَهْنَ بِهِ مَنْ باتَ جَذْلانَ نَاعِماً","أَخَا نَشَوَاتٍ ما عَلَيْهِ حَقُودُ",87,"د",1,0],["لِيَهْنِئْهمُ اللًّهْوُ لا عَيْبَ فِي","هِ يَشُوبُ لصَفَاءَ وَلا مَأْثَمُ",88,"م",1,0],["لِيَهْنِيءِ الأَمْلاَكَ فِي خُلْدِهِمْ","مَنْ بِنَوَاهُ أَوْحَشَ الإِنْسَا",89,"س",2,0],["لِيَهْنِئْكَ أَنْ فَازَتْ بِلاَدُك بِالمُنى","وَقِسْطُكَ فِي إِنْجاحِها لَيْسَ يُنْكَرُ",90,"ر",1,0],["لِيَهْنِئْكَ الْقِرَانُ بِذَاتِ نُبْلٍ","مِنَ الْغِيد الصِّبَاحِ وَذَاتِ طُهْرِ",91,"ر",1,0],["لِيَهْنئكُمَا هَذَا القرانُ فَإِنَّهُ","سُرُورٌ بمَا نَلْقى وَبُشْرَى بمَا بَعْدُ",92,"د",1,0],["لِيَهنَ دِمشقَ اليَومَ صِحَّتُكَ الَّتي","بِها فَرِحَت وَالمُدُنُ كَالناسِ تَفرَحُ",93,"ح",1,0],["لِيَهنِكَ أَن أَحمَدتَ عاقِبَةَ الفَصدِ","فَلِلَّهِ مِنّا أَجمَلُ الشُكرِ وَالحَمدِ",94,"د",1,1],["لِيَهنكَ يا اِبني أَنَّ شُربَكَ بارِدٌ","وَشُربي إن لَم يَعفُ رَبّي آنِ",95,"ن",1,0],["ليَهنَكَ يا عَبد الغَنيّ اِبني الرِضا","مَحَلٌّ بِطوبى طابَ فيهِ حُلولُ",96,"ل",1,0],["ليهنِكَ: أنَّك ما متَّ إلا","وغرسُ يمينِكَ داني الثَّمر",97,"ر",1,0],["لَيهْنك، يا أبولُّوا، الانتصارُ","بربك: كيف طرْت بهم وطَاروا؟",98,"ر",3,1],["ليهنيك منصور اللواء مؤيد","بحار الندى من جود كفيه تغرف",99,"ف",1,0],["ليهنك شمس الدين ما حزت من علا","خواتمها موصولة بالفواتح",100,"ح",1,0],["ليهنِ بَنِي كعبٍ مقامُ فتاتهمْ","ومقعدها للمؤمنينَ بمرصدِ",101,"د",1,0],["ليهنئْ لكم أن قد نفيتمْ بيوتنا","، مندى عبيدانَ المحلئِ باقرهْ",102,"ر",2,0],["لِيَهْنِكَ الخلدُ في الأخرى وجنتُه","يا خير منقلبٍ في خير منقَلب",103,"ب",1,0],["لِيَهْنىءْ بَنِي يزداد أنّ أكُفّهُمْ","خَلائِفُ أنْوَاءِ السّحابِ الرّوَاجِسِ",104,"س",1,0],["ليهنئ أخلاي الذين أودهم","ذخائر ما في الصدر من صادق الود",105,"د",1,0],["ليَهْنِ الملكَ أن أصلحتَ فاسده","وأن حرست من الإفساد ما صلحا",106,"ح",2,0],["لِيهنىء رجالاً لا تزال تجودهم","سحائب من كلتا يديك مواطر",107,"ر",1,0],["ليَهنىء شريكاً وطبُه ولِقاحُه","وذوو العس بعد نومة المتبرد",108,"د",1,0]]}