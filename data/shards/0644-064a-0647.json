 في الأَيك تَغريد","فَحَبَّذا مِن أَماليها الأَناشيدُ",187,"د",1,1],["لِيَهْنِكَ ما تَجدَّد من جَلالٍ","بما أَولاك سُلطانُ البَرايا",188,"ا",3,0],["ليَهْنكَ أَنْ سكنْتَ القلبَ منّي","وقَبلَك لم يكُنْ قلبي بساكن",189,"ن",1,0],["لِيَهْنِكَ أنّ خُوزِستانَ أَلْقَى","إلى يَدِكَ العِنانَ على المَيامن",189,"ن",1,0],["لي هوىً يُبْلي ولي دمعٌ يَشي","أىُّ أسراريَ تَخْفَى بينَ ذَيْن",190,"ن",1,0],["ليَهْنِكَ أنّ مُغيثَ الأنامِ","غدا لك بالوُدِّ غَيْثاً هَتونا",191,"ن",2,0],["ليَهْنِكَ مَوْقفٌ أظهرتَ فيه","لدينِ اللهِ إعزازَ المكان",192,"ن",1,0],["لِيَهْنِكُما أنّي الغداةَ إليكما","على عِزِّ أَنصاري جَعلْتُ ركوني",193,"ن",2,0],["ليَهْنِكِ يا ابنةَ الأقوامِ أَنّي","بحُبّكِ لو جَزيْتِ الصَّبَّ هائم",194,"م",1,0],["لِيَهْنِ الرّجالَ الأغنياءَ مُقامُهمْ","وإنَّ عناءَ المُقْتِرينَ طويل",195,"ل",1,0],["لِيَهْنِ الورَى أن قد وُقيتَ مِنَ الرَّدى","وأنْ قد رمَى الدَّهرُ العِدا في المَقاتل",196,"ل",1,0],["لِيَهْنِكَ ولْيَهْنِ الخليقةَ كُلَّها","تَجدُّدُ بُشرَى في الوجوه لها بِشر",197,"ر",1,0],["ليهْنِك يا أعلى بني الدّهرِ منصباً","تَوقُّلُ جَدّ في ذرا المجدِ صاعد",198,"د",1,0],["لِيَهنَ مِصرَ الرَخا وَالأَمنَ في قَرَنٍ","فَما بِها شَغَبٌ يُخشى وَلا سَغَبُ",199,"ب",1,0],["لِيَهنِكَ شِبلٌ جاءَ مِن أَسَدٍ وَردِ","سَيُهدَى إِلى طُرقِ المَكارِمِ وَالمَجدِ",200,"د",1,1],["لِيَهنِ الَّذي تَسري إِلَيكَ رِكابُهُ","يُسايِرُ في الوَجهِ العَبوسِ بِها بِشرُ",201,"ر",1,1],["لِيَهنِكَ فَضلٌ لا يُنالُ لَهُ كُنهُ","كَأَنَّ العُلا مَعنىً وَقيلَ لَهُ كُنهُ",202,"ن",2,0],["لِيَهنِ العُلا أَنَّ الهُمومَ كَتائِبٌ","وَأَنِّيَ أَلقاها وَحيداً وَأَهزِمُ",203,"م",1,0],["لَيَهنِكَ مِن بَعدِ الرَدى باقي الثَنا","وَإِن كُنتَ مِن تَحتِ الثَرى بالِيَ البُردِ",204,"د",1,0],["ليَهنكَ اليومُ الذي لم تَكُن","تَتركُهُ الأيَّامُ يَهنِينِي",205,"ي",1,0],["ليهنِكَ ماضٍ ومُستَقبلٌ","وآخرُ بينَهما يحضُرُ",206,"ر",1,0],["لِيَهْن عمادَ الدّين منهُ مُسوّدٌ","به جمعَ اللهُ السِّيادة والنّبلا",207,"ل",2,0],["ليَهْنِ قَوماً إلى أبوابه وَفدُوا","فإنها كعبةُ المعْروفِ والحَرَمُ",208,"م",1,0],["ليهنك إذ زُفَّتْ إليك عروس","من الغيد في ثوب العفاف تميس",209,"س",1,1],["ليهن كلاك مَداها القَصيّ","وَمجد يُؤَثَّل عَنها سَنىِّ",210,"ن",2,1],["ليهنك عيد قَد أَطَلَّت سعوده","وَشهر صيام وَدَّعتك أَواخِرُهُ",211,"ر",2,0],["ليهنَ مروطَ الخُسُروانيِّ إِنَّهُ","يُباشِرُ مِنها بِالحَرير حَريرُها",212,"ر",3,0],["لي هِمّة كَضِياء الصبح مشرقة","في حِندِسٍ وَجِناني لَيسَ بِالنَخبِ",213,"ب",1,0],["لِيَهنِكُمُ المُلكُ الَّذي أَصبَحَت بِكُم","أَسِرَّتُهُ مُختالَةً وَالمَنابِرُ",214,"ر",1,0],["ليَهنِكُم العَقْدُ المبارَك إنَّهُ","على خير كُفْوٍ للكريم وأقرانِ",215,"ن",1,1],["ليهْنِكُمُ من الأَنصار قاضٍ","لدين الله في الدُّنيا نصير",216,"ر",1,0],["ليهن العراقين الهناء فقد سرى","إليها المحض والنائل الجزل",217,"ل",1,0],["ليهنك حكم الله يمضي غراره","مضاء حسام أرْهَفَتْه الصياقل",218,"ل",1,0],["ليهْنِك سيِّدي عيدٌ سعيدٌ","عليك له مدى الأَعوام عَوْد",219,"د",1,0],["ليهنِك رُتْبَةٌ تعلو وتسمو","ونيشانٌ نُؤرِّخه افتخارا",220,"ر",2,0],["ليهنك العيد إذا وافاك مبتهجاً","بطلعةٍ منك زانَتْ بهجة العيد",221,"د",1,0],["ليهنك اليوم أبناءٌ لهم نسب","أضحى على جبهة الأيام مسطورا",222,"ر",2,0],["لِيَهْنِك يا نحير أهلِ زمانِهِ","ويا كاملاً عنه غدا الطرف قاصرا",223,"ر",2,1],["ليهنك النصر والفتح المبين وما","بلغت من جانب السلطان من أرب",224,"ب",1,0],["لِيَهْنِك ما بَلَغْتَ من الأماني","فَلَمْ تَبْرَح بأيَّام التَّهاني",225,"ن",2,1],["ليهنك أنت يا بغداد منه","بطلعة حسن مرجوٍ مهاب",226,"ب",1,0],["لِيَهْنِكُمُ زواجٌ في هناءِ","به انشرحت لأقوامٍ صدورُ",227,"ر",1,1],["لِيَهْنِكَ النَّصْرُ يا غَرَامُ فَكَمْ","لِوَاءِ قَلْبٍ عَلَيْكَ خَفَّاقِ",228,"ق",1,0],["ليَهْنِ يدَ الخَطْبِ التي طرّقَتْ لنا","إليك سبيلاً أنها عندنا يَدُ",229,"د",1,0],["ليَهْنِ المُلكَ أن أمسى مَصوناً","عشيةَ راحَ عزُّهُمُ مُصابا",230,"ب",2,0],["ليَهْنِكَ أنّه فتحٌ مُبيرٌ","منيرٌ في مطالعِه مُبينُ",231,"ن",1,0],["ليهنِكُمُ العيدُ السعيدُ وإن غَدا","بفضلكُمُ يزهو جلالاً ويزدانُ",232,"ن",1,0],["ليَهْنكَ بل ليَهْنِ الناسَ عيدٌ","رأوا فيه جبينَك والهِلالا",233,"ل",2,0],["ليهنأ بك شهر الصوم حقاً","كلما وافى فمنك التهنئات",234,"ت",1,0],["لِيَهْنِكَ الفِطْرُ والأَعيادُ تتبعُهُ","فِي عِزِّ مُلْكِكَ مَا فِي صفوِهِ كَدَرُ",235,"ر",1,0],["لِيَهْنِكَ أَنَّ العيدَ وافاكَ قادِماً","بأوشَكِ بادٍ للسرورِ وعائِدِ",236,"د",1,0],["ليَهْنِ لَكَ العيدُ الَّذِي بِكَ يَهْنِينا","سلاماً وإِسلاماً وأَمناً وتأْمِينا",237,"ن",2,1],["ليهنَ عينك طُهْرٌ","يفضي لأحسن حال",238,"ل",1,0],["ليَهنِ الوزارةَ أن زُوّجتْك","على طول ما لبِثتْ تُعضَلُ",239,"ل",1,0],["ليهن التُّقى والدين كونك سالماً","فلا دينَ إلا حيث أنت مجاهد",240,"د",1,1],["ليهْنك عيدٌ أنت عيدٌ لأهلهِ","سرورٌ لمهمومٍ ووُجْدٌ لمُمْلقِ",241,"ق",1,0],["ليهْنَ عليَّ الخيرِ أني جزيتهُ","بنُعْمى يديه الصَّالحاتِ البَواقيا",242,"ي",2,0],["ليَهْن الرَّعايا والمناقبَ والعُلى","سرورُكم ما أنبت العُشْبَ ماطِرُ",243,"ر",1,1],["ليهن الورى برء العلى والفضائل","هناء الثرى بالمدجنات الهواطل",244,"ل",1,1],["ليهنَ بك الفطر بعد الصيام","فإنك تسني فعالاً وتسني",245,"ن",2,0],["لِيَهودِ كلِّ الأرض ِ، أو لِكلابِها","لا تَستَحي منكم ، ولا تَتَورَّعُ",246,"ع",1,0],["ليهن أباك المليك الذي","جرى في المكارم شوطاً بعيدا",247,"د",2,0],["ليهنك إن سعيك في","مساعي المجد متضح",248,"ح",1,0],["ليهنك عهد لا يضاع وإن نأت","نواك وسر لا يذاع فيسمعُ",249,"ع",1,1],["لِيهنئ أَرضَ أَندلس بدور","مِن السَرّاء لَيسَ لَها سِرارُ",250,"ر",1,0],["لِيَهْنِكَ نصرٌ عزُّهُ يخذُلُ العِدا","وفتحٌ يحلُّ المُغلَقاتِ من الأمرِ",251,"ر",1,0],["ليَهنكَ صومُ الشهرِ وُفّيتَ أجرَهُ","وبالعزِّ عُقباهُ لك اللَّهُ يختمُ",252,"م",1,0],["ليَهنكَ سيّدي عيدٌ شريفٌ","حكاكَ فجلَّ عن شِبهِ القَرينِ",253,"ن",1,0],["ليهنِكَ سيّدي فتحٌ قريبٌ","بَعيدُ الصّيتِ مرتَفعُ المَنالِ",254,"ل",1,0],["ليَهنِكَ سيّدي عيدٌ شريفٌ","يبشّر عن صيامِكَ بالثّوابِ",255,"ب",1,0],["ليهْنِك بعد صومك عيدُ فطْرٍ","يُريكَ بقلبِ حاسدِك اِنفِطارا",256,"ر",2,0],["ليَهنِك عيدُ الفِطرِ يا بهجةَ الورى","ومُلكٌ قديمٌ عاد وهو جَديدُ",257,"د",1,0],["ليهنك فتح أنجبت لك أمه","وأم العلى بالنصر والفتح عاقر",258,"ر",1,0],["ليهنك العام قد دلت بشائره","على بقائك ألفاً بعده نسقا",259,"ق",2,0],["ليهنك صوم ترتجى بركاته","وتوزن أعمال به وتكال",260,"ل",1,0],["ليهنك أن الذل والعز أصبحا","وقد قسما فيمن تهين وتكرم",261,"م",1,0],["لِي هِمَّةٌ لا تَشْتَكِي إنْ نالها","ضُرٌّ إلَى أَحَدٍ سِوَى الرَّحْمَنِ",262,"ن",1,1],["لِيَهْنِكُمُ دارُ الْمَسَرَّةِ إنّها","أَجَلُّ بِناءٍ شَيَّدَتْهُ الْخَلائِفُ",263,"ف",1,1],["لِيَهنِكَ يا مولاي جحجٌّ وعُمرةٌ","وزورةُ قبرِ المصطفى والتعبُّدُ",264,"د",1,0],["ليُهْنِكَ أنّ اللَّهَ فَوَّقَك العِدا","وقد طالعوا فيك الرّجاء وأشرفوا",265,"ف",3,0],["لي هوى بالشعب من كاظمة","ساكن هذا الحشى والكبدا",266,"د",2,0],["ليهنك نظر الله والتب للعدا","فقد خسروا الأولى ولن يربحوا أخرى",267,"ر",2,0],["ليَهْنِكَ عيدٌ إِنْ أَتى كنتَ عيدَه","وإِن غاب أَضْحى مِنك عَنْه مَنابُ",268,"ب",1,0],["لِي هِمَّةٌ في العُلى لا طالَ لي عُمْرٌ","إنْ كانَ في سَاعِدي عَنْ نَيْلِها قِصَرُ",269,"ر",1,0],["ليهنك يا شمس البلاد وبدرها","بلوغ المنى من كل باغ وغاشم",270,"م",1,0]]}