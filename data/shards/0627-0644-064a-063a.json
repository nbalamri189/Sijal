{"poems":[[53,"لغام المطايا من رضابك أعذب","https://www.aldiwan.net/poem30757.html","الطويل"],[93,"يراد من الشباب اليوم جهد","https://www.aldiwan.net/poem11293.html","الوافر"],[45,"بعمرك تدري أي شأني أعجب","https://www.aldiwan.net/poem10663.html","الوافر"],[75,"رأيت بعيني فوق ما كنت أسمع","https://www.aldiwan.net/poem69065.html","الطويل"],[45,"بعُمرِكَ تَدرِي أيَّ شَانَيَّ أعْجَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=31571",""],[113,"شيخي أمام الاولياء النجبا","https://www.aldiwan.net/poem41227.html","عموديه"],[117,"قلائد فتح كان يذخرها الدهر","https://www.aldiwan.net/poem4345.html","الطويل"],[130,"ألا أيها الأخوان أهل التأدب","https://www.aldiwan.net/poem54879.html","الطويل"],[269,"لا عين العين فعل البيض والاسل","https://www.aldiwan.net/poem52059.html","البسيط"],[273,"تحلت بعلياك الليالي العواطل","https://www.aldiwan.net/poem25540.html","الطويل"],[399,"إلى غيركم قلبي المتيم لا يصبو","https://www.aldiwan.net/poem46662.html","الطويل"],[436,"سلام وهنيت فيك السلامه","https://www.aldiwan.net/poem34883.html","المتقارب"],[456,"يزور عن حسناء زورة خائف","https://www.aldiwan.net/poem56115.html","الطويل"],[459,"أقول للركب قد حاكت أزمتها","https://www.aldiwan.net/poem15935.html","البسيط"],[556,"خيطان خيط أبيض وهو الوجود","https://www.aldiwan.net/poem34578.html","الرجز"],[573,"سرى طيفه لا بل سرى بي سرابه","https://www.aldiwan.net/poem3103.html","الطويل"]],"verses":[["إِلى غايَةٍ تَجري الأَنامُ لِنَحوِها","فَماشٍ بَطيءٌ مَشيُهُ وَمُقَرِّبُ",0,"ب",1,0],["إِلَى غَايَاتِهِ يَمْضِي بِعَزْمٍ","وَلَيْسَ بِفَائِزٍ إِلاَّ العَزْومُ",1,"م",1,0],["إِلى غُمُرٍ في مالِهِ تَستَخِفُّهُ","صِغارُ الحُقوقِ وَهوَ عَودٌ مُجَرَّبُ",2,"ب",1,0],["إلى غايَةٍ ما بعدَهَا لكَ غايَةٌ","وهل خلفَ أفلاكِ السموات مطلع",3,"ع",1,0],["إلى غَمَرٍ في مَالِهِ، تَسْتَخِفُّهُ","صِغَارُ الخُطوبِ، وَهوَ عَوْدٌ مجَرَّبُ",4,"ب",1,0],["الى غريب الغرباء ننتمي","دهرا وفي الاعتاب منه نرتمي",5,"ي",1,0],["إلى غزواتٍ من قريبٍ تتابعت","ففي كُلِّ قُطرِ من سحائِبها قطرُ",6,"ر",1,0],["إلى غيرِ هذا مِن فُنُونٍ تَشَعَّبَت","بكل طريقٍ مُحدَثٍ مُتَشَعِّبِ",7,"ب",1,0],["اليغنمي الَّذي تاه الوجود به","عَلى أَواخر اهل الخير والاول",8,"ل",1,0],["إلَى غَضِّ آدابٍ لَو الرَّوضُ نالَها","لَكانَ مُحالاً أنْ يُرَى وهْوَ ماحِلُ",9,"ل",1,0],["إلى غيرِكمْ قلبي المتّيم لا يَصْبُو","ومِنْ أجلكم زندُ الهوى فيه لا يخبو",10,"و",1,1],["إِلَى غزْوَةٍ مَا عدا أَن أطاع","بِهَا رَبَّهُ ثُمَّ أَرْضى إِمَامَهْ",11,"م",2,0],["إلى غايةٍ من مدحه إن بلغتها","هزأتُ بأذيال الرياح العواصفِ",12,"ف",1,0],["إِلى غَزيرِ النُّهى ملآنَ من كرَمٍ","حازَ العُلى بين اِنجادٍ وارْفادِ",13,"د",1,0],["إلى غروب نوره عنا وعن","جميع ما نراه من بيض وسود",14,"د",1,0],["إِلى غائِب إِنْ جَاءَني عنه سائلٌ","فسائِلُ دَمْع المُقْلَتين جَوابُه",15,"ب",2,0]]}