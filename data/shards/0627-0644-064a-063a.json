{"poems":[[55,"لغام المطايا من رضابك أعذب","https://www.aldiwan.net/poem30757.html","الطويل"],[95,"يراد من الشباب اليوم جهد","https://www.aldiwan.net/poem11293.html","الوافر"],[47,"بعمرك تدري أي شأني أعجب","https://www.aldiwan.net/poem10663.html","الوافر"],[77,"رأيت بعيني فوق ما كنت أسمع","https://www.aldiwan.net/poem69065.html","الطويل"],[47,"بعُمرِكَ تَدرِي أيَّ شَانَيَّ أعْجَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=31571",""],[119,"شيخي أمام الاولياء النجبا","https://www.aldiwan.net/poem41227.html","عموديه"],[123,"قلائد فتح كان يذخرها الدهر","https://www.aldiwan.net/poem4345.html","الطويل"],[136,"ألا أيها الأخوان أهل التأدب","https://www.aldiwan.net/poem54879.html","الطويل"],[276,"لا عين العين فعل البيض والاسل","https://www.aldiwan.net/poem52059.html","البسيط"],[280,"تحلت بعلياك الليالي العواطل","https://www.aldiwan.net/poem25540.html","الطويل"],[408,"إلى غيركم قلبي المتيم لا يصبو","https://www.aldiwan.net/poem46662.html","الطويل"],[445,"سلام وهنيت فيك السلامه","https://www.aldiwan.net/poem34883.html","المتقارب"],[463,"يزور عن حسناء زورة خائف","https://www.aldiwan.net/poem56115.html","الطويل"],[466,"أقول للركب قد حاكت أزمتها","https://www.aldiwan.net/poem15935.html","البسيط"],[563,"خيطان خيط أبيض وهو الوجود","https://www.aldiwan.net/poem34578.html","الرجز"],[580,"سرى طيفه لا بل سرى بي سرابه","https://www.aldiwan.net/poem3103.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138198",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48631","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48905","المتقارب"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118129","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100994","الطويل"],[1955,"","https://poetry.dctabudhabi.ae/diwan/poem/45405","الوافر"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48225","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28028","البسيط"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111244","الطويل"],[2607,"","https://poetry.dctabudhabi.ae/diwan/poem/34902","الهزج"],[2653,"","https://poetry.dctabudhabi.ae/diwan/poem/45340","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204691","الطويل"],[3005,"","https://poetry.dctabudhabi.ae/diwan/poem/34710","الرجز"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112310","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45760","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129420","الطويل"],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21418","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86452","الطويل"],[4044,"","https://poetry.dctabudhabi.ae/diwan/poem/105884","الطويل"],[4172,"","https://poetry.dctabudhabi.ae/diwan/poem/147785","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90919","الكامل"],[4759,"تسائلني عنها","https://www.poetsgate.com/ViewPoem.aspx?id=207054",""],[4850,"إليك","https://www.poetsgate.com/ViewPoem.aspx?id=33323",""],[5064,"اللغة العاشرة","https://www.poetsgate.com/ViewPoem.aspx?id=199086",""],[5083,"طيَّاتُ العَبير","https://www.poetsgate.com/ViewPoem.aspx?id=53771",""],[5145,"نوافح مسكٍ فتقت أم نوافج","https://www.poetsgate.com/ViewPoem.aspx?id=108237",""],[592,"رسائل أخوان الصفا والتودد","https://www.poetsgate.com/ViewPoem.aspx?id=128837",""],[592,"أقول نعم هذا هو الحق والهدى","https://www.poetsgate.com/ViewPoem.aspx?id=128810",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"سفاسط أملاها الغبي وسطرا","https://www.poetsgate.com/ViewPoem.aspx?id=128722",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5652,"وتبقى لك العزوه عدود وعشاير","https://www.poetsgate.com/ViewPoem.aspx?id=190144",""],[5660,"أَرى في عُيوني وُجوهاً كَثيرَه","https://www.poetsgate.com/ViewPoem.aspx?id=23973",""],[5969,"مؤامرة","https://www.poetsgate.com/ViewPoem.aspx?id=205051",""],[6024,"مية","https://www.poetsgate.com/ViewPoem.aspx?id=186352",""],[6312,"للمائسِ المدْهوش","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82953&r=&rc=3",""]],"verses":[["إِلى غايَةٍ تَجري الأَنامُ لِنَحوِها","فَماشٍ بَطيءٌ مَشيُهُ وَمُقَرِّبُ",0,"ب",1,0],["إِلَى غَايَاتِهِ يَمْضِي بِعَزْمٍ","وَلَيْسَ بِفَائِزٍ إِلاَّ العَزْومُ",1,"م",1,0],["إِلى غُمُرٍ في مالِهِ تَستَخِفُّهُ","صِغارُ الحُقوقِ وَهوَ عَودٌ مُجَرَّبُ",2,"ب",1,0],["إلى غايَةٍ ما بعدَهَا لكَ غايَةٌ","وهل خلفَ أفلاكِ السموات مطلع",3,"ع",1,0],["إلى غَمَرٍ في مَالِهِ، تَسْتَخِفُّهُ","صِغَارُ الخُطوبِ، وَهوَ عَوْدٌ مجَرَّبُ",4,"ب",1,0],["الى غريب الغرباء ننتمي","دهرا وفي الاعتاب منه نرتمي",5,"ي",1,0],["إلى غزواتٍ من قريبٍ تتابعت","ففي كُلِّ قُطرِ من سحائِبها قطرُ",6,"ر",1,0],["إلى غيرِ هذا مِن فُنُونٍ تَشَعَّبَت","بكل طريقٍ مُحدَثٍ مُتَشَعِّبِ",7,"ب",1,0],["اليغنمي الَّذي تاه الوجود به","عَلى أَواخر اهل الخير والاول",8,"ل",1,0],["إلَى غَضِّ آدابٍ لَو الرَّوضُ نالَها","لَكانَ مُحالاً أنْ يُرَى وهْوَ ماحِلُ",9,"ل",1,0],["إلى غيرِكمْ قلبي المتّيم لا يَصْبُو","ومِنْ أجلكم زندُ الهوى فيه لا يخبو",10,"و",1,1],["إِلَى غزْوَةٍ مَا عدا أَن أطاع","بِهَا رَبَّهُ ثُمَّ أَرْضى إِمَامَهْ",11,"م",2,0],["إلى غايةٍ من مدحه إن بلغتها","هزأتُ بأذيال الرياح العواصفِ",12,"ف",1,0],["إِلى غَزيرِ النُّهى ملآنَ من كرَمٍ","حازَ العُلى بين اِنجادٍ وارْفادِ",13,"د",1,0],["إلى غروب نوره عنا وعن","جميع ما نراه من بيض وسود",14,"د",1,0],["إِلى غائِب إِنْ جَاءَني عنه سائلٌ","فسائِلُ دَمْع المُقْلَتين جَوابُه",15,"ب",2,0],["إلى غواني العلاقد حن من صغر","ومال للمجد طفلا في الملا وصبا",16,"ب",2,0],["إلى غير جمع الرزق لم يتفرَّقا","وفي غير حمد اللّه لم يتجمعا",17,"ع",2,0],["إلى غاية سرت من غاية","وإنّيَ خلفك في غايتيكا",18,"ك",2,0],["إلى غرضي الاقصى يسدد سهمه","وعهدي به لم يبق في القوس منزعا",19,"ع",2,0],["إلى غرضٍ حالت يدُ الدهر دونه","فمطلبه صعبٌ ومسلَكه وَعر",20,"ر",1,0],["إِلى غورَينِ حَيثُ حَوى أَذَب","وَصَكَّ بِالسُيوفِ وَبِالحِراب",21,"ب",1,0],["إلى غَوْثِ الأراملِ واليتامى","ومن يَجْلُو برؤيتهِ الهموما",22,"م",2,0],["إلى غنىّ مليّ لا افتقارَ له","إلى الأمورِ التي إليه تستند",23,"د",1,0],["إلى غيها إني بيوسف مقتد","يد تكتي فيها ودافعت في يد",24,"د",1,0],["إِلى غيطانِهِ الفيحِ","إِلى بِركَتِهِ الغَنّا",25,"ن",2,0],["إِلى غُصنٍ مِنَ البانِ","بِهِ قَلبِيَ قَد جُنّا",25,"ن",2,0],["إِلى غَيرِ الأَنامِ يُحتَبَلُ الفَتى","وَإِن كانَ شَهماً في العَشيرَةِ أَروَعا",26,"ع",2,1],["الى غربة في الزي والذوق والهوى","الى غربة في الخلق والدين والكفر",27,"ر",1,0],["إِلى غَزالٍ مِن بَني النَصارى","عِذارُ خَدَّيهِ سَبى العَذارى",28,"ر",2,0],["إِلى غابة السرو احملوني صِيانَةً","وفي قلبها قبري احفروه لمنعتي",29,"ي",1,0],["إِلى غَير مَنان بِما مَنَّ مِن نَدى","يَديه وَلَم يبدِ اِعتِذاراً لِمجتد",30,"د",1,0],["الى غير اكفاء يزف عرائسا","ويرضيه حين العقد مهر مؤجل",31,"ل",1,0],["إِلى غَير هَيجا صَبَّحَت غَيرَ أَنَّهُ","دَجا فَوقَهُ لَيلُ التِمامِ فأطرَقا",32,"ق",2,0],["إلى غرضٍ على أمدٍ","يقام لهن محدود",33,"د",1,0],["إلى غير هذا من حفاظ ونائل","فيأمن لاجيه وينعش راجيه",34,"ي",2,0],["الى غير هذا من منافع جربت","وقال بها في السالبين إمام",35,"م",1,0],["إلى غرز قبّاء الحشا في وظيفها","طماحٌ وفي الهادي الأشم جنوح",36,"ح",1,0],["إلى غضيض الطرف أغبد مذرمى","قلبي بأسهم طرقه الوسنان",37,"ن",1,0],["إلي غير ما أبدو تلفتها الهوى","على غير ماتدريه (أن الهوى حق",38,"ق",1,0],["إلى غادة من بلاد الجمال","يعانقها الطيب أنى تسير",39,"ر",1,0],["إِلَى غَيْرِ مَا رَجْعَةٍ سَائِرٌ","إِلَى حَيثُ لا فِكْرَةً حَائِرَةْ",40,"ر",2,0],["إلى غُرَرٍ على أَبراجِ دوحٍ","تَراخَتْ دونهَا هِمَمُ النُّسورِ",41,"ر",1,0],["إلى غرّة الدنيا وإن كان قد جنى","علي هموماً مالها اليوم فارج",42,"ج",1,0],["إلى غير ذا من كل أنواعها التي","بها الله مختص فوحده تسعد",43,"د",1,0],["إلى غير ذا من كل أفعاله التي","أقر ولم يجحد بها كل ملحد",43,"د",1,0],["إلى غير ذا من كل أوصافه التي","بها نطق القرآن والكل محكم",44,"م",1,0],["إلى غير هذا من مفاسده التي","يئول بها الآتي إلى معضل جلل",45,"ل",1,0],["إلى غير هذا من تفاصيل ما أتى","به العلماء في كل ذلك من علل",45,"ل",1,0],["إلى غيرها من ترهات كلامه","وأوضاعه لما قلاها فأكثرا",46,"ر",2,0],["إلى غير ذا من كل ما ليس يرتجى","ونطليه إلا من الواحد الفرد",47,"د",1,0],["إلى غير ذا من ترهات كلامه","وأوضاعه اللاتي تجل عن العد",47,"د",1,0],["إلى غير ذا من كل أفعال ربنا","تعالى عن الأمثال والجعل للند",47,"د",1,0],["إلى غير ذا من كل أنواعه التي","بها الله مختص تعالى عن الند",47,"د",1,0],["إلى غير ذا مما يطول فقلدوا","لهذا وهذا لا تعدوه مأثما",48,"م",2,0],["إلى غير ذا من كل أنواعها التي","بها الله مختص وكان معظما",48,"م",2,0],["الي غدى حظه به اليوم تآثير","عليه من كسب الجميله خساير",49,"ر",1,0],["إِلى غَيرِ عِشقٍ بِغَيرِ اتِّفاقٍ","فَتُمسي قُلوبُ هَوانا كَسيرَه",50,"ر",2,0],["إلى غربة الإنسان ترحل مُرغماً","ووجهُكَ مذعورٌ وحزنُكَ قاتلُ",51,"ل",1,0],["إلى غير وجهك لم ألتفت","ومن غير طرفك لم أتق",52,"ق",1,0],["إلى غيرِ ألحانِ الوِدادِ دَفعْتَني","جَهومٌ وما صَمْتُ الجَهومِ اشتِياقُ",53,"ق",1,0]]}