{"poems":[[55,"تعيف الطير فأنبأنه","https://www.aldiwan.net/poem29951.html","السريع"],[88,"شيخان قد خبرا الوجود وأدركا","https://www.aldiwan.net/poem68877.html","الكامل"],[95,"أول ما تلهى به البطون","https://www.aldiwan.net/poem11071.html","الرجز"],[32,"يعقد سحر البابليين طرفها","https://www.aldiwan.net/poem29478.html","الطويل"],[53,"صد عن الأطلال لما استيأسا","https://www.aldiwan.net/poem64645.html","الرجز"],[53,"يعقوب ويل أبيك أية هوة","https://www.aldiwan.net/poem66056.html","الكامل"],[87,"يا ناشر العلم بهذي البلاد","https://www.aldiwan.net/poem63771.html","السريع"],[22,"شكت العنتريس نصي وإدلا","https://www.aldiwan.net/poem21677.html","الخفيف"],[77,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[50,"ما لي وللعاذلات","https://www.aldiwan.net/poem62464.html","المجتث"],[52,"طال المقام على تنجز حاجة","https://www.aldiwan.net/poem64868.html","الكامل"],[15,"ليس رسم على الدفين ببالي","https://www.aldiwan.net/poem45253.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85506","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55147","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54835","السريع"],[53,"أقسمتُ والحنثُ له آثامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30408",""],[131,"يا هند يا أخت بني الصارد","https://www.aldiwan.net/poem24274.html","السريع"],[170,"يعقوب عمي وغير بدع","https://www.aldiwan.net/poem46871.html","مخلع البسيط"],[190,"خف الناس واحذرهم فأكثر من ترى","https://www.aldiwan.net/poem44147.html","الطويل"],[325,"يعقوب مزراحي الهمام","https://www.aldiwan.net/poem67124.html","مجزوء الرجز"],[331,"يعقوب ينظر في الأمو","https://www.aldiwan.net/poem44236.html","مجزوء الكامل"],[371,"فبغا يقوم على أربع","https://www.aldiwan.net/poem17378.html","المتقارب"],[382,"قلب يذوب إلى الأطلال والحلل","https://www.aldiwan.net/poem59287.html","البسيط"],[382,"شمس تسير مشارقا ومغاربا","https://www.aldiwan.net/poem66953.html","الكامل"],[385,"أصبا الأصيل تحملي","https://www.aldiwan.net/poem49234.html","مجزوء الكامل"],[409,"ما طرق الطرف سوى سهده","https://www.aldiwan.net/poem33971.html","السريع"],[409,"مرحبا يا مرحبا يا مرحبا بنسيم","https://www.aldiwan.net/poem34146.html","الرمل"],[463,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[466,"تعاظم حزني والرزية أعظم","https://www.aldiwan.net/poem15905.html","الطويل"],[473,"يا نجم قد لاحت نجوم القطر","https://www.aldiwan.net/poem60136.html","الرجز"],[505,"دمعي كسيل تنمنم","https://www.aldiwan.net/poem37779.html","المجتث"],[566,"يا رَبِّ إِذ شَدَدَتني عِقالاً","https://www.aldiwan.net/poem27837.html","الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122530","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122540","الخفيف"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88600","الرجز"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/77451","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96659","الوافر"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61019","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56162","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64931","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125482","الرمل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69414","الطويل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105067","السريع"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110612","الرمل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106905","الرمل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60828","البسيط"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82963","الرجز"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140069",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201493","الوافر"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36775","الرجز"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70008","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70089","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125905","الكامل"],[4126,"","https://poetry.dctabudhabi.ae/diwan/poem/126328","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95024","البسيط"],[4378,"","https://poetry.dctabudhabi.ae/diwan/poem/99845","البسيط"],[4858,"آسادٌ في الأسر","https://www.poetsgate.com/ViewPoem.aspx?id=137593",""],[4929,"مَيَلانُ الموازين. (من بحر المنسرح)","https://www.poetsgate.com/ViewPoem.aspx?id=207997",""],[5111,"تُفَّاحَةُ المنْتَهَى","https://www.poetsgate.com/ViewPoem.aspx?id=212059",""],[5186,"هذي رواية يوسف الصديق يا","https://www.poetsgate.com/ViewPoem.aspx?id=156461",""],[5408,"أوجاع يوسفية","https://www.poetsgate.com/ViewPoem.aspx?id=190737",""],[5408,"لو مرة حاولت","https://www.poetsgate.com/ViewPoem.aspx?id=190757",""],[5543,"يعقوب يظهر دائماً في لفظه","https://www.poetsgate.com/ViewPoem.aspx?id=181705",""],[5582,"أَبَدْرٌ لاحَ مِنْ خَلْفِ السِّتارِ","https://www.poetsgate.com/ViewPoem.aspx?id=63512",""],[5968,"سميت بالله من ياني الخبر جدام","https://www.poetsgate.com/ViewPoem.aspx?id=175413",""],[463,"على مثلها كان العلاءُ يحومُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60303&r=&rc=359",""],[572,"لستُ على عذلِكَ صَبَّارا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9316&r=&rc=173",""]],"verses":[["يَعقُدُ أولاهُ بِأُخراتِهِ","لِفافَ بِنتِ الرَقَمِ الخَنفَقيق",0,"ق",1,0],["يَعقوبُ إِنَّكَ قَد كَبِرتَ وَلَم تَزَل","في العِلمِ لا تَزدادُ غَيرَ تَصابي",1,"ب",2,0],["يعقبه في نسق منضود","عيش السرايا مذهب الخدود",2,"د",1,0],["يُعَقِّدُ سِحرَ البابِلِيّينَ طَرفُها","مِراراً وَيَسقينا السُلافَ مِنَ الخَمرِ",3,"ر",1,1],["يعقوبُ لاقيتَ هِزَبراً مِفْرَسا","يزيدُه عضّ الحروب حَمَسا",4,"س",2,0],["يعقوبُ ويلَ أبيك أيَّةُ هُوةٍ","دلّاك في لهواتِها الإقدامُ",5,"م",1,1],["يَعقوبُ مِن ذِئبٍ بَكى مُشفِقاً","فَكَيفَ أَنيابُ الحَديدِ الحِداد",6,"د",1,0],["يَعقِرونَ العِشارَ لِلطارِقِ التَو","وِ لَدى كُلِّ جَحرَةٍ مِمحالِ",7,"ل",1,0],["يَعْقِلنَ ذا العُقّال عن غاياتِهِ","وتقولُ أن لنْ يَخطُرَ الأخطار",8,"ر",1,0],["يَعقُبنَ طَوراً سُروراً","وَتارَةً حَسَراتِ",9,"ت",1,0],["يَعقوبُ قَد وَرَدَ العُفاةُ عَشِيَّةً","مُتَعَرِّضينَ لِسَيبِكَ المُنتابِ",10,"ب",1,0],["يَعقِرُ الظَبيَ وَالظَليمَ وَيَلوي","بِلَبونِ المِعزابَةِ المِعزالِ",11,"ل",1,0],["يعقد العزم أن يطير مع الطي","رِ ولكن جناحه مشكول",12,"ل",1,0],["يَعْقُوبُ فِي إِحْيَاءِ مَجْدِ بِلادِهِ","وَبَقَاءِ تَالِدِهَا مِنَ الأَبْدَالِ",13,"ل",1,0],["يَعْقِدُ نُورُ الْعِلمِ إِكْلِيلَهُ","عَلَى جَبِينِ الْخُلُقِ الطَّاهِرْ",14,"ر",1,0],["يعقب إنجاماً لها إنْجامُ","من كل أرض برقُها يُشام",15,"م",1,0],["يُعقَدُ في الجيدِ عَلَيهِ الرُقى","مِن خيفَةِ الأَنفُسِ وَالحاسِدِ",16,"د",1,0],["يعقوبُ عَمِّي وغيرُ بدِعٍ","لو عمَّ قَلبي ولاءُ عمِّي",17,"ي",1,1],["يعقّك في ما تشتهيه وينثني","يطالب بالطاعات في غير واجب",18,"ب",1,0],["يَعقوبَ مِزراحي الهُمامُ","رَبّي لَهُ يُبارِكُ",19,"ك",1,1],["يَعقوبُ يَنظُرُ في الأُمو","رِ وَأَنتَ تَنظُرُ ناحِيَه",20,"ه",1,1],["يَعُقُّ الحِجارَةِ دَفعاً بِها","فَيُقسِمُ أَن لَيسَ بِاِبنِ الفِراشِ",21,"ش",1,0],["يعقوب ألغزه بالليث مُحتشماً","يا حبذا أسدٌ كنّاه بالشِبِلِ",22,"ل",1,0],["يعقوب زَبْدِي ذاق من هيرودُسٍ","بالسيف في صهيونَ موتاً قاضبا",23,"ب",2,0],["يعقوب حَلْفا مات فوق صليبه","ما كان في بُشراه يوماً كاذبا",23,"ب",2,0],["يَعقوب حُزن لَم يَجد","صَبراً لَهُ عَن يُوسف",24,"ف",1,0],["يعقد منها كل معنى كما","يحل ما أشكل من عقده",25,"د",2,0],["يعقد الطير على راياته","إن عدى للحرب منه عصبا",26,"ب",2,0],["يعُقُّونها بالضغط وهي عليهمُ","عَطُوفٌ بدَرّات الرَّضاع رؤومُ",27,"م",1,0],["يَعُقُّ خليل الصدق ما دامَ باطلاً","ويلْطفُ بالقتل المُحِقِّ ويرْأمُ",28,"م",1,0],["يَعقِدُ بِالماءِ خُمارَ الخَمرِ","فَيَومُنا يَومٌ جَميلُ الأَمرِ",29,"ر",1,0],["يعقوبُ قلبي حَزينٌ","وكاتِمُ الثَّوبِ أَقدَمْ",30,"م",1,0],["يُعقِبُني مِن جَنَّةٍ تَظلالا","وَعِنباً يُساقِطُ الأَهدالا",31,"ل",2,0],["يعقرُ العاقِرَ الكفاءَ ولا تس","لَم منهُ الدِّعَثرُ والعُشراءُ",32,"ا",2,0],["يعقرُ الصِّيدَ أو تخِرُّ على الاذ","قانِ والبَركِ أو تَحِنُّ الجُنُوبُ",33,"ب",1,0],["يعقده بالعي منك فيصل","أَضحى فنيق كلم هداره",34,"ر",2,0],["يَعقوبٌ الملكُ الهمام المُجتبى","الماجد الأَوفى الرَحيم الأَرأفا",35,"ف",2,0],["يعقِّبُ حاتماً كرماً ويعلو","عَلى قيس بن قاسم بالوقارِ",36,"ر",1,0],["يَعقوب يا شَرف الخِلافة لَم أُرد","إِلا التيمن وَالتبرك باسمكا",37,"ك",2,0],["يعقوب يلعن في فرنسيس الذي","قد ساءَ في مسعاه وارتكب الغلطْ",38,"ط",1,1],["يُعَقِّبُ المدْحَ آلافاً مُؤَلَّفَةً","كالفاءِ جاءَتْ لتَعْقيبٍ بِلا مُهْلَهْ",39,"ل",2,0],["يَعقُبُ التبذيرَ فقرٌ","بئسَ حالُ النادِمين",40,"ن",1,0],["يُعَقِّبُهُ الجَدُّ السَعِيدُ وَرُبَّما","يَكُونُ لِجَدِّ المَرءِ بِالسَعدِ تَعقِيبُ",41,"ب",1,0],["يعقل ان مرّ نسيم الصبا","فيها فيمشي مشي حيران",42,"ن",1,0],["يعقب السعي فلم يرتدع","بالصفا قد راق لي عيش صفا",43,"ف",2,0],["يُعقد الكمُّ فيسقيه الندى","ويغذيه الترابُ الحاضنُ",44,"ن",1,0],["يعقوبُ أصلُ عماه فقدُ يُوسِفه","وليس يوسفُ في يعقوبِ يُتَّهَمُ",45,"م",1,0],["يعقُبُ ما قيل وهل","ينجى من اللَّهِ الحِيَل",46,"ل",1,0],["يَعقبهُ الأَمين في الأُمور","لا زالَ في العِزّ وَفي السُرورِ",47,"ر",1,0],["يعقد عن عيني كراهاً كما","يعقد ذاك الخصر بالبند",48,"د",1,0],["يعقفها فتذعر منه خوفا","كهرٍّ قد تحفّز للكفاح",49,"ح",1,0],["يَعقبُها بَوائِقٌ","فيها دَواعي الوَصَبِ",50,"ب",1,0],["يَعقوب في مَجدِهِ يَدعو بِساحتها","إِني شَهيدٌ وَنخلُ النَصر لي شَهدا",51,"د",2,0],["يَعقوبُ اسمرَ جَدَّ في إِنشائِها","مَن حازَ في كهنوتِهِ الإِكراما",52,"م",2,1],["يعقوب حزن بالنوى على شفا","فعد وعد وعدا ولا تعدى",53,"د",2,0],["يعقوبُ بالاقدام خيرُ مُمَهِّدٍ","لسعادةٍ ستعمُّ بالإحساءِ",54,"ا",2,1],["يعقوبُ أَشواق اليكم مهجتي","وأنا بدينِ الحبِّ ابراهيمًُ",55,"م",1,0],["يعقوب تابِتَ لمّا ناءَ مرتحلاً","قد عمَّ قلبَ الحجى بُؤسٌ وأحزانُ",56,"ن",1,1],["يعقوب ليس بمتبولٍ ولا كلفٍ","ويح الوشاة فإن الداء أضناني",57,"ن",2,0],["يعقوبُ فاض حنينُه وأنينهُ","واحزن يسكن في حشاهُ ويغلبُ",58,"ب",1,0],["(يعقوبُهُ) لمْ يزلْ ل (يُوْسُفِهِ)","في روحِهِ ضَوعُ ريحِهِ العَطِرِ",59,"ر",1,0],["يعقوبُ هل ستعودُ العيرُ ثانية ً..؟","قحط ٌوعصفٌ من المأكولِ يُفنيني",60,"ن",2,0],["يعقوب ناس حزنه لو مثل البؤس","الذي بك والديار يحيق",61,"ق",1,0],["يعقوبُ عادَ وعينُهُ ما أبْصرَتْ","إلا الضبابَ فمَنْ لعيني يكْشفُ",62,"ف",1,0],["يعقوبُ شِعْري لمْ يزلْ مُتأمِّلاً","عَبقَ القميصِ إذا أتيْتَ سَيَنظرُكْ",63,"ك",1,0],["يعقوب يظهر دائماً في لفظه","عسلاً لديه يطمه يعسوبه",64,"ب",2,1],["يُعَقِّبُ حاتِماً كَرَماً وَيَعْلُو","عَلَى قَيْسِ بنِ عاصِمِ فِي الوَقارِ",65,"ر",1,0],["يعقوب يبكي من فرق الولد يوم شام","انا بكايه دينن مبيوع بقلط",66,"ط",1,0],["يعقُّونها بالضغط وهي عليهمُ","عطوفٌ بدرّات الرَّضاع رءومُ",67,"م",1,0],["يعقدُ ما بينَ كَثيبِ النّقا","وبينَ غُصْنِ البَانِ زُنَّارا",68,"ر",2,0]]}