{"poems":[[53,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[63,"وغادة تشهد الحسان لها","https://www.aldiwan.net/poem45708.html","المنسرح"],[63,"لواعج الحب أخفيها وأبديها","https://www.aldiwan.net/poem46166.html","البسيط"],[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[77,"إن تورعت أصبحت حوزة","https://www.aldiwan.net/poem36427.html","الخفيف"],[47,"قف في رسوم المستجا","https://www.aldiwan.net/poem25172.html","مجزوء الكامل"],[51,"لا أقذع السلطان في أيامه","https://www.aldiwan.net/poem8328.html","الكامل"],[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[51,"قرأت في وجهك عنوانا","https://www.aldiwan.net/poem66470.html","المنسرح"],[92,"يا قلب كم فيك من دنا محجبة","https://www.aldiwan.net/poem38914.html","البسيط"],[85,"يا حماة الطفل خير المحسنين","https://www.aldiwan.net/poem7137.html","الرمل"],[85,"بات المعنى والدجى يبتلى","https://www.aldiwan.net/poem7887.html","السريع"],[85,"ابتغوا ناصية الشمس مكانا","https://www.aldiwan.net/poem62947.html","الرمل"],[85,"مملكة مدبره","https://www.aldiwan.net/poem63766.html","مجزوء الرجز"],[49,"الحد لله اللطيف بنا","https://www.aldiwan.net/poem63139.html","الكامل"],[44,"سلم على الربع من سلمى بذي سلم","https://www.aldiwan.net/poem30364.html","البسيط"],[44,"يوم الفراق لقد خلقت طويلا","https://www.aldiwan.net/poem30378.html","الكامل"],[15,"لمن الدار أقفرت بالجناب","https://www.aldiwan.net/poem45282.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85591","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39567","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42579","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43818","الرمل"],[106,"ثغر لا يتبسم","https://www.poetsgate.com/ViewPoem.aspx?id=179422",""],[106,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""],[90,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[109,"ذات القرنفل والصبا عربيل","https://www.aldiwan.net/poem16310.html","الكامل"],[128,"يا زروة قد أورثت","https://www.aldiwan.net/poem50516.html","مخلع الكامل"],[132,"ربع أسماء إذ هي الأنس آلا","https://www.aldiwan.net/poem54778.html","الطويل"],[132,"رسم ربع بجانب الينبوع","https://www.aldiwan.net/poem54803.html","الخفيف"],[142,"لأى مرمى تزجر الأيانقا","https://www.aldiwan.net/poem58416.html","الرجز"],[143,"ما الحسان فما لهن عهود","https://www.aldiwan.net/poem11745.html","الكامل"],[155,"وليلة في عدد الشباب","https://www.aldiwan.net/poem55795.html","الرجز"],[182,"يا أربع الخيف يسقي الماء واديها","https://www.aldiwan.net/poem67024.html","البسيط"],[186,"وإذا أخذت عفا القلوب","https://www.aldiwan.net/poem43513.html","مجزوء الكامل"],[191,"شيم الصوارم أن تقرب ما نأى","https://www.aldiwan.net/poem1316.html",""],[195,"أتعرف الدار أم لا تعرف الطللا","https://www.aldiwan.net/poem54422.html","البسيط"],[210,"بقوامه والطلعة الغراء","https://www.aldiwan.net/poem13313.html","الكامل"],[235,"حان إسفار الصباح","https://www.aldiwan.net/poem32120.html","مجزوء الرمل"],[259,"الحمد للإله هادي الناسك","https://www.aldiwan.net/poem35806.html","الرجز"],[275,"عبر البحر يؤم الأبحرا","https://www.aldiwan.net/poem25568.html","الرمل"],[337,"بانت سعاد فنوم العين مملول","https://www.aldiwan.net/poem45422.html","البسيط"],[364,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[391,"الحمدلله حمدا موافيا بالنوال","https://www.aldiwan.net/poem54549.html","عموديه"],[391,"وصلاة الله ربي والسلام","https://www.aldiwan.net/poem54627.html","عموديه"],[403,"قلب المتيم كل يذوده","https://www.aldiwan.net/poem33973.html","مجزوء الكامل"],[432,"هل يا حداة النجب","https://www.aldiwan.net/poem12478.html","مجزوء الرجز"],[432,"احكم على الثقلين الإنس والجان","https://www.aldiwan.net/poem12753.html","البسيط"],[439,"إن تفخر الدنيا فأنت فخارها","https://www.aldiwan.net/poem34810.html","الكامل"],[452,"ما اسم من الأزهار تركيبه","https://www.aldiwan.net/poem13949.html","السريع"],[458,"من مبلغ عني وإن تعذرت","https://www.aldiwan.net/poem55897.html","الرجز"],[458,"ألا فتى يسأل قلبي ماله","https://www.aldiwan.net/poem55905.html","الرجز"],[458,"در لها خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[461,"عجب الرجال لفارس","https://www.aldiwan.net/poem16099.html","مجزوء الكامل"],[464,"عداك وجدي فعد عن عذلي","https://www.aldiwan.net/poem3178.html","عموديه"],[464,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[464,"سقيت دمشق وجارتا جيرونها","https://www.aldiwan.net/poem3549.html","عموديه"],[468,"يا من يطوف بكعبة","https://www.aldiwan.net/poem60284.html","مجزوء الكامل"],[477,"ذنبي إلى البيض ذنب غير مغتفر","https://www.aldiwan.net/poem15246.html","البسيط"],[495,"كم حسرات لي وكم وجد","https://www.aldiwan.net/poem9818.html","السريع"],[515,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[529,"قلب تقلب في فنون","https://www.aldiwan.net/poem37273.html","مجزوء الكامل"],[551,"ما الحب إلا موئل المتعلل","https://www.aldiwan.net/poem47295.html","الكامل"],[553,"أيا سرور وأنت يا حزن","https://www.aldiwan.net/poem68412.html","المنسرح"],[561,"الحمد لله الذي استقلت","https://www.aldiwan.net/poem27845.html","الرجز"],[567,"عجبت من قناعتي وقعودي","https://www.aldiwan.net/poem69730.html","الكامل"],[575,"يا ليلة الوصل بل يا ليلة العمر","https://www.aldiwan.net/poem3063.html","البسيط"],[575,"صدوا فإنساني إليهم صدى","https://www.aldiwan.net/poem3087.html","السريع"],[586,"طرف تعرض بعدكم لهجوع","https://www.aldiwan.net/poem17592.html","الكامل"]],"verses":[["أَوطانُ غَيرِكِ لِلضِيافَةِ طَلقَةٌ","وَسِواكِ في اللأواءِ رَحبُ المَنزِلِ",0,"ل",1,0],["أَو طاشَتِ الغانياتُ مِن أَشَرٍ","يُقيمُها فالوقارُ يُقعِدُها",1,"د",3,0],["أُوطَأْتُهُمْ عقِبي إذ فُقْتُهُمْ حَسَباً","بِراحَةٍ يرتَدي بالنُّجْحِ عافيها",2,"ي",3,0],["أوْطانُ أوْطارٍ تعوّضَ أفقُها","منْ روْنَقِ البِشْر البَهيّ عَبوسا",3,"س",2,0],["أوْ طَرَدْتُ العُفاةَ خِفتُ من","اللهِ إذا ما سُئِلْتُ عنْ أوْزارِ",4,"ر",1,0],["أوطِنتُها زَمَنَ الصِبا","وَجَعَلتُ مَنبِجَ لي مَحِلّا",5,"ل",2,0],["أو طالباً قوتاً حماهُ قادرٌ","ظلماً حقوقَ طَعامِهِ وشرابِهِ",6,"ب",2,0],["أو طارقاً في حريم النوم يطرقُنا","أو بارقاً لعزاء القلب خطّافا",7,"ف",2,0],["أو طمَّ بحر الصين في طرفةٍ","أو كَسْحَ أَرونْدَ وثهلانا",8,"ن",2,0],["أَو طائراً ساحراً مَيْتاً قَد انْفجرتْ","في مُقْلَتَيْهِ جِراحٌ جمَّةٌ وَدَمُ",9,"م",1,0],["أو طويلِ الصمت أعمى في الصبا","بين برديه المعرىُّ المبين",10,"ن",1,0],["أو طلت سيفا في جيوش الضحى","ما كنت للأعداء ما أنت لي",11,"ي",1,0],["أَو طَبيباً آيِباً مِن طيبَةٍ","لَم تَزَل تَندى يَداهُ زَعفَرانا",12,"ن",2,0],["أَو طافَ بِالماءِ عَلى","جُدرانِهِ المُجَدَّرَه",13,"ر",2,0],["أَوطَنتُ داراً لا بَقاءَ لَها","تَعِدُ الغُرورَ وَتُنبِتُ الدَرَنا",14,"ن",2,0],["أَوطَأتُموهُ عَلى جَمرِ العُقوقِ وَلَو","لَم يُحرَجِ اللَيثُ لَم يَبرَح مِنَ الأَجَمِ",15,"م",1,0],["أَوطَأتَ أَرضَ البُخلِ فيها غارَةً","تَرَكَت حُزونَ الحادِثاتِ سُهولا",16,"ل",2,0],["أَوطَنَتها عُفرُ الظِباءِ وَكانَت","قَبلُ أَوطانَ بُدَّنٍ أَترابِ",17,"ب",1,0],["أوطاننا هي عز","ومصدر للحياة",18,"ه",1,0],["أو طريداً وراءَ بحرٍ تحامى","أن يرى مصرَ في الحديد سجينه",19,"ن",2,0],["أَوْ طَائِرٍ فِي وَكْرِهِ جاثِمٍ","يَشُوقُ إِنْ هَيْنَمَ أَوْ غَرَّدَا",20,"د",2,0],["أَوْطَأَتْهُ عَلْيَاءهَا فَعَنَتْ بِالطَّوْ","عِ لِلحَاكِمِ النَّزِيهِ الهَامُ",21,"م",1,0],["أَوطَأَت مَروانَ مِن بَع","دِ بِساطِ المُلكِ مَروا",22,"و",2,0],["أو طيف مصباح بدا وكأنه","يخشى من الغارات؛ فهو ملثم",23,"م",1,0],["أوطانُنا مِلْكٌ لنا","فيها نعيشُ كما نُريد",24,"د",1,0],["اوطأت أقدامَها \" عارمَة \"","حسَكَ الجور ، وشاءَته انتِعالا",25,"ل",2,0],["أَوطنتها قَبل المَشيب وَلِلصِبا","خَلع عَليَّ وَلِلبَها إِكليلُ",26,"ل",1,0],["أو طَعْم شَهْد نثرُه","كالمِسْك مَفْضُوض الخِتَامِ",27,"م",1,0],["أَو طِوَالُ النَّخِيلِ عَالَينَ قِنوَا","ناً مِنَ البُسرِ إِذ رَوِينَ زُلالا",28,"ل",2,0],["أو طِبَاقٍ أو لَفِّ نَشرٍ أو إرصَا","دٍ بَدِيعِ التَّلمِب والتَّنوِيعِ",29,"ع",1,0],["أو طَرَدٍ جمَّعَ من أَداتِهِ ال","فهودَ والكلابَ والسَّواذقا",30,"ق",2,0],["أَوطَنتَ فيها الأَمنَ بَعدَ نُزوحِهِ","وَنَفَيتَ عَنها الخوفَ فَهوَ طَريدُ",31,"د",1,0],["أَوْ طرفِ السَّيفِ من القِرَابِ","طويتُها بالنشرِ للعِتابِ",32,"ب",1,0],["أَوطارُ نَفسٍ لَها تَصبو المُنى طَرَباً","وَالنَفسُ تَستامُها لَهواً أَمانيها",33,"ي",3,0],["أوطنت نفسك من عدوك","أو صديقك في أمانك",34,"ك",1,0],["أوطأتَ أرضَ المُشركين كتائباً","كادت تميدُ الأرضُ من وَطآتها",35,"ت",3,0],["أَو طائِراً مِن عِتاقِ الطَيرِ مَسكَنُهُ","مَصاعِبُ الأَرضِ وَالأَشراف مُذ عَقَلا",36,"ل",2,0],["او طي على جمر الغضا قلبي ولم","يشعر بان اقوى على الايطاء",37,"ا",2,0],["أَوطَأَت فارِسَها صَه","وَةَ لَهوٍ وَمِزاحِ",38,"ح",1,0],["أو طاف بالبيت العتيق طائفُ","أو أنست بأهلها المواقفُ",39,"ف",1,0],["أَوْطَنَ التوْحيدُ منهُ مَشْعَراً","وتَبنَّى الهَدْيُ مِنْهُم مَعْشَرا",40,"ر",2,0],["أَو طَيُّ ماتِحَةٍ في جِرمِها حَشَفٌ","وَمُنثَنىً مِن شَوِيِّ الجِلدِ مَملولُ",41,"ل",1,0],["أوْطأته عُليا فزارةَ من قَب","لِ حَصى الأرض مفرِقَ الجوزاء",42,"ا",2,0],["أوطنه باجتهاد صح واطلب حلال","ساتر لعورتك طاهر والتوجه قبال",43,"ل",1,0],["أو طلع نجم ولاح أو بدا طيب وفاح","أو سجع طير وناح",44,"ح",1,0],["أو طيفه إن زاره","فالطيف قد يجدي وروده",45,"د",2,0],["أو طلعةَ الشيخ الإما","م ذي الحِجى والحسب",46,"ب",1,0],["أوطأتَ خليلَك أبكارَ الحُصونِ على","أن الحصونَ عَذارى ذاتُ إحصانِ",47,"ن",1,0],["أَوطَأْتَ أَرضَ المشركينَ كتائِباً","فِيهَا وَشيكُ فَنائها ودَمَارُها",48,"ر",3,0],["أو طلبَ الإِنسان فيه السُرى","تجدْهُ حقاً بينَ حوتينْ",49,"ن",1,0],["أو طلبتْ في الجوّ بك غايةً","جعلتَها تحت ثرى أقدامِها",50,"م",3,0],["أو طالع السؤددَ من ثنيّةٍ","لعمِّه أبصر منها خالَه",51,"ل",2,0],["أو طُرحَ الشعر فماتَ فجأةً","بقين ما طال وما طاب البقا",52,"ق",2,0],["أوْطانُهُ لِشَقائِهِ","بالوادِ ضارِيَةٌ سِباعُهْ",53,"ع",2,0],["أوطأني مِثَلهُ وجاوز بي","بين نيوب المخارم العُصلُ",54,"ل",1,0],["أوطانُ أوطاري الذي أنا عاذلٌ","في غيرها ومعذّلٌ في غيدها",55,"د",3,0],["أوطانُ أوطاني ودين ُصبابتي","ألاَّ أحولَ صبابةً عن دينها",56,"ن",3,0],["أَو طافَ طوفانٌ بِنا","مِن عُسرَةٍ فَنَداكَ نوحُ",57,"ح",1,0],["أوطانَ لهوي وكم قضَّيتُ مِن وَطَرٍ","فيهنَّ بالغيدِ والأوطانُ بالوطرِ",58,"ر",1,0],["أوطأني ظهر النوى عنهمُ","إني ما نمت من الصد",59,"د",1,0],["أوطنته دار الوزارة ريثما","بنيت لنقلته الكريمة دار",60,"ر",1,0],["أَوْطانِهِ كالتُّرْبِ نَفْعَا","وَاسْأَلْ بهذا كُلّ عاقِلْ",61,"ل",1,0],["أوْطأته قُلَلَ العُداة وإنّها","قُلَلٌ مؤهّلَةٌ لوقعِ الأرجلِ",62,"ل",1,0],["أَوطَنَ يا سِحرُ حُبُّكُم كَبِدي","فَلَيسَ لِلحُبِّ غَيرَها وَطَنُ",63,"ن",1,0],["أَو طُلِبَت بِالجَهدِ ما قَد أَلَّتِ","أَو الحَياةُ فَالحَياةُ مُنيَتي",64,"ت",2,0],["أو طَلَبْنَا بِكَ الرِّيَاسَةَ والجا","هَ عُضِدْنا بالعِزِّ والتأبِيْدِ",65,"د",1,0],["أَو طالَ قدراً فلا قَدَرٌ لمقتدرٍ","أَو قال فخراً فلا فخرٌ لمفتخرِ",66,"ر",1,0],["أَو طَمِعَ الكافِرُ في مِثْلها","في الحشر لم يَكْفُر ولَمْ يَجْحَدِ",67,"د",1,0],["أَوْطَانُهُ لَيْسَتْ بِأَوْطَانٍ إِذَا","غِبْتُمْ وَلَيْسَ رُبُوعُهُ بِرُبُوعِ",68,"ع",1,0]]}