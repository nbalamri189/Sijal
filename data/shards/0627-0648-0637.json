{"poems":[[53,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[63,"وغادة تشهد الحسان لها","https://www.aldiwan.net/poem45708.html","المنسرح"],[63,"لواعج الحب أخفيها وأبديها","https://www.aldiwan.net/poem46166.html","البسيط"],[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[77,"إن تورعت أصبحت حوزة","https://www.aldiwan.net/poem36427.html","الخفيف"],[47,"قف في رسوم المستجا","https://www.aldiwan.net/poem25172.html","مجزوء الكامل"],[51,"لا أقذع السلطان في أيامه","https://www.aldiwan.net/poem8328.html","الكامل"],[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[51,"قرأت في وجهك عنوانا","https://www.aldiwan.net/poem66470.html","المنسرح"],[92,"يا قلب كم فيك من دنا محجبة","https://www.aldiwan.net/poem38914.html","البسيط"],[85,"يا حماة الطفل خير المحسنين","https://www.aldiwan.net/poem7137.html","الرمل"],[85,"بات المعنى والدجى يبتلى","https://www.aldiwan.net/poem7887.html","السريع"],[85,"ابتغوا ناصية الشمس مكانا","https://www.aldiwan.net/poem62947.html","الرمل"],[85,"مملكة مدبره","https://www.aldiwan.net/poem63766.html","مجزوء الرجز"],[49,"الحد لله اللطيف بنا","https://www.aldiwan.net/poem63139.html","الكامل"],[44,"سلم على الربع من سلمى بذي سلم","https://www.aldiwan.net/poem30364.html","البسيط"],[44,"يوم الفراق لقد خلقت طويلا","https://www.aldiwan.net/poem30378.html","الكامل"],[15,"لمن الدار أقفرت بالجناب","https://www.aldiwan.net/poem45282.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85591","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39567","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42579","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43818","الرمل"],[106,"ثغر لا يتبسم","https://www.poetsgate.com/ViewPoem.aspx?id=179422",""],[106,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""],[90,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""]],"verses":[["أَوطانُ غَيرِكِ لِلضِيافَةِ طَلقَةٌ","وَسِواكِ في اللأواءِ رَحبُ المَنزِلِ",0,"ل",1,0],["أَو طاشَتِ الغانياتُ مِن أَشَرٍ","يُقيمُها فالوقارُ يُقعِدُها",1,"د",3,0],["أُوطَأْتُهُمْ عقِبي إذ فُقْتُهُمْ حَسَباً","بِراحَةٍ يرتَدي بالنُّجْحِ عافيها",2,"ي",3,0],["أوْطانُ أوْطارٍ تعوّضَ أفقُها","منْ روْنَقِ البِشْر البَهيّ عَبوسا",3,"س",2,0],["أوْ طَرَدْتُ العُفاةَ خِفتُ من","اللهِ إذا ما سُئِلْتُ عنْ أوْزارِ",4,"ر",1,0],["أوطِنتُها زَمَنَ الصِبا","وَجَعَلتُ مَنبِجَ لي مَحِلّا",5,"ل",2,0],["أو طالباً قوتاً حماهُ قادرٌ","ظلماً حقوقَ طَعامِهِ وشرابِهِ",6,"ب",2,0],["أو طارقاً في حريم النوم يطرقُنا","أو بارقاً لعزاء القلب خطّافا",7,"ف",2,0],["أو طمَّ بحر الصين في طرفةٍ","أو كَسْحَ أَرونْدَ وثهلانا",8,"ن",2,0],["أَو طائراً ساحراً مَيْتاً قَد انْفجرتْ","في مُقْلَتَيْهِ جِراحٌ جمَّةٌ وَدَمُ",9,"م",1,0],["أو طويلِ الصمت أعمى في الصبا","بين برديه المعرىُّ المبين",10,"ن",1,0],["أو طلت سيفا في جيوش الضحى","ما كنت للأعداء ما أنت لي",11,"ي",1,0],["أَو طَبيباً آيِباً مِن طيبَةٍ","لَم تَزَل تَندى يَداهُ زَعفَرانا",12,"ن",2,0],["أَو طافَ بِالماءِ عَلى","جُدرانِهِ المُجَدَّرَه",13,"ر",2,0],["أَوطَنتُ داراً لا بَقاءَ لَها","تَعِدُ الغُرورَ وَتُنبِتُ الدَرَنا",14,"ن",2,0],["أَوطَأتُموهُ عَلى جَمرِ العُقوقِ وَلَو","لَم يُحرَجِ اللَيثُ لَم يَبرَح مِنَ الأَجَمِ",15,"م",1,0],["أَوطَأتَ أَرضَ البُخلِ فيها غارَةً","تَرَكَت حُزونَ الحادِثاتِ سُهولا",16,"ل",2,0],["أَوطَنَتها عُفرُ الظِباءِ وَكانَت","قَبلُ أَوطانَ بُدَّنٍ أَترابِ",17,"ب",1,0],["أوطاننا هي عز","ومصدر للحياة",18,"ه",1,0],["أو طريداً وراءَ بحرٍ تحامى","أن يرى مصرَ في الحديد سجينه",19,"ن",2,0],["أَوْ طَائِرٍ فِي وَكْرِهِ جاثِمٍ","يَشُوقُ إِنْ هَيْنَمَ أَوْ غَرَّدَا",20,"د",2,0],["أَوْطَأَتْهُ عَلْيَاءهَا فَعَنَتْ بِالطَّوْ","عِ لِلحَاكِمِ النَّزِيهِ الهَامُ",21,"م",1,0],["أَوطَأَت مَروانَ مِن بَع","دِ بِساطِ المُلكِ مَروا",22,"و",2,0],["أو طيف مصباح بدا وكأنه","يخشى من الغارات؛ فهو ملثم",23,"م",1,0],["أوطانُنا مِلْكٌ لنا","فيها نعيشُ كما نُريد",24,"د",1,0],["اوطأت أقدامَها \" عارمَة \"","حسَكَ الجور ، وشاءَته انتِعالا",25,"ل",2,0]]}