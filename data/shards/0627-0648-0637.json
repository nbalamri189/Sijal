بالنُّجْحِ عافيها",2,"ي",3,0],["أوْطانُ أوْطارٍ تعوّضَ أفقُها","منْ روْنَقِ البِشْر البَهيّ عَبوسا",3,"س",2,0],["أوْ طَرَدْتُ العُفاةَ خِفتُ من","اللهِ إذا ما سُئِلْتُ عنْ أوْزارِ",4,"ر",1,0],["أوطِنتُها زَمَنَ الصِبا","وَجَعَلتُ مَنبِجَ لي مَحِلّا",5,"ل",2,0],["أو طالباً قوتاً حماهُ قادرٌ","ظلماً حقوقَ طَعامِهِ وشرابِهِ",6,"ب",2,0],["أو طارقاً في حريم النوم يطرقُنا","أو بارقاً لعزاء القلب خطّافا",7,"ف",2,0],["أو طمَّ بحر الصين في طرفةٍ","أو كَسْحَ أَرونْدَ وثهلانا",8,"ن",2,0],["أَو طائراً ساحراً مَيْتاً قَد انْفجرتْ","في مُقْلَتَيْهِ جِراحٌ جمَّةٌ وَدَمُ",9,"م",1,0],["أو طويلِ الصمت أعمى في الصبا","بين برديه المعرىُّ المبين",10,"ن",1,0],["أو طلت سيفا في جيوش الضحى","ما كنت للأعداء ما أنت لي",11,"ل",2,0],["أَو طَبيباً آيِباً مِن طيبَةٍ","لَم تَزَل تَندى يَداهُ زَعفَرانا",12,"ن",2,0],["أَو طافَ بِالماءِ عَلى","جُدرانِهِ المُجَدَّرَه",13,"ر",2,0],["أَوطَنتُ داراً لا بَقاءَ لَها","تَعِدُ الغُرورَ وَتُنبِتُ الدَرَنا",14,"ن",2,0],["أَوطَأتُموهُ عَلى جَمرِ العُقوقِ وَلَو","لَم يُحرَجِ اللَيثُ لَم يَبرَح مِنَ الأَجَمِ",15,"م",1,0],["أَوطَأتَ أَرضَ البُخلِ فيها غارَةً","تَرَكَت حُزونَ الحادِثاتِ سُهولا",16,"ل",2,0],["أَوطَنَتها عُفرُ الظِباءِ وَكانَت","قَبلُ أَوطانَ بُدَّنٍ أَترابِ",17,"ب",1,0],["أوطاننا هي عز","ومصدر للحياة",18,"ه",1,0],["أو طريداً وراءَ بحرٍ تحامى","أن يرى مصرَ في الحديد سجينه",19,"ن",2,0],["أَوْ طَائِرٍ فِي وَكْرِهِ جاثِمٍ","يَشُوقُ إِنْ هَيْنَمَ أَوْ غَرَّدَا",20,"د",2,0],["أَوْطَأَتْهُ عَلْيَاءهَا فَعَنَتْ بِالطَّوْ","عِ لِلحَاكِمِ النَّزِيهِ الهَامُ",21,"م",1,0],["أَوطَأَت مَروانَ مِن بَع","دِ بِساطِ المُلكِ مَروا",22,"و",2,0],["أو طيف مصباح بدا وكأنه","يخشى من الغارات؛ فهو ملثم",23,"م",1,0],["أوطانُنا مِلْكٌ لنا","فيها نعيشُ كما نُريد",24,"د",1,0],["اوطأت أقدامَها \" عارمَة \"","حسَكَ الجور ، وشاءَته انتِعالا",25,"ل",2,0],["أَوطنتها قَبل المَشيب وَلِلصِبا","خَلع عَليَّ وَلِلبَها إِكليلُ",26,"ل",1,0],["أو طَعْم شَهْد نثرُه","كالمِسْك مَفْضُوض الخِتَامِ",27,"م",1,0],["أَو طِوَالُ النَّخِيلِ عَالَينَ قِنوَا","ناً مِنَ البُسرِ إِذ رَوِينَ زُلالا",28,"ل",2,0],["أو طِبَاقٍ أو لَفِّ نَشرٍ أو إرصَا","دٍ بَدِيعِ التَّلمِب والتَّنوِيعِ",29,"ع",1,0],["أو طَرَدٍ جمَّعَ من أَداتِهِ ال","فهودَ والكلابَ والسَّواذقا",30,"ق",2,0],["أَوطَنتَ فيها الأَمنَ بَعدَ نُزوحِهِ","وَنَفَيتَ عَنها الخوفَ فَهوَ طَريدُ",31,"د",1,0],["أَوْ طرفِ السَّيفِ من القِرَابِ","طويتُها بالنشرِ للعِتابِ",32,"ب",1,0],["أَوطارُ نَفسٍ لَها تَصبو المُنى طَرَباً","وَالنَفسُ تَستامُها لَهواً أَمانيها",33,"ي",3,0],["أوطنت نفسك من عدوك","أو صديقك في أمانك",34,"ك",1,0],["أوطأتَ أرضَ المُشركين كتائباً","كادت تميدُ الأرضُ من وَطآتها",35,"ت",3,0],["أَو طائِراً مِن عِتاقِ الطَيرِ مَسكَنُهُ","مَصاعِبُ الأَرضِ وَالأَشراف مُذ عَقَلا",36,"ل",2,0],["او طي على جمر الغضا قلبي ولم","يشعر بان اقوى على الايطاء",37,"ا",2,0],["أَوطَأَت فارِسَها صَه","وَةَ لَهوٍ وَمِزاحِ",38,"ح",1,0],["أو طاف بالبيت العتيق طائفُ","أو أنست بأهلها المواقفُ",39,"ف",1,0],["أَوْطَنَ التوْحيدُ منهُ مَشْعَراً","وتَبنَّى الهَدْيُ مِنْهُم مَعْشَرا",40,"ر",2,0],["أَو طَيُّ ماتِحَةٍ في جِرمِها حَشَفٌ","وَمُنثَنىً مِن شَوِيِّ الجِلدِ مَملولُ",41,"ل",1,0],["أوْطأته عُليا فزارةَ من قَب","لِ حَصى الأرض مفرِقَ الجوزاء",42,"ا",2,0],["أوطنه باجتهاد صح واطلب حلال","ساتر لعورتك طاهر والتوجه قبال",43,"ل",1,0],["أو طلع نجم ولاح أو بدا طيب وفاح","أو سجع طير وناح",44,"ح",1,0],["أو طيفه إن زاره","فالطيف قد يجدي وروده",45,"د",2,0],["أو طلعةَ الشيخ الإما","م ذي الحِجى والحسب",46,"ب",1,0],["أوطأتَ خليلَك أبكارَ الحُصونِ على","أن الحصونَ عَذارى ذاتُ إحصانِ",47,"ن",1,0],["أَوطَأْتَ أَرضَ المشركينَ كتائِباً","فِيهَا وَشيكُ فَنائها ودَمَارُها",48,"ر",3,0],["أو طلبَ الإِنسان فيه السُرى","تجدْهُ حقاً بينَ حوتينْ",49,"ن",1,0],["أو طلبتْ في الجوّ بك غايةً","جعلتَها تحت ثرى أقدامِها",50,"م",3,0],["أو طالع السؤددَ من ثنيّةٍ","لعمِّه أبصر منها خالَه",51,"ل",2,0],["أو طُرحَ الشعر فماتَ فجأةً","بقين ما طال وما طاب البقا",52,"ق",2,0],["أوْطانُهُ لِشَقائِهِ","بالوادِ ضارِيَةٌ سِباعُهْ",53,"ع",2,0],["أوطأني مِثَلهُ وجاوز بي","بين نيوب المخارم العُصلُ",54,"ل",1,0],["أوطانُ أوطاري الذي أنا عاذلٌ","في غيرها ومعذّلٌ في غيدها",55,"د",3,0],["أوطانُ أوطاني ودين ُصبابتي","ألاَّ أحولَ صبابةً عن دينها",56,"ن",3,0],["أَو طافَ طوفانٌ بِنا","مِن عُسرَةٍ فَنَداكَ نوحُ",57,"ح",1,0],["أوطانَ لهوي وكم قضَّيتُ مِن وَطَرٍ","فيهنَّ بالغيدِ والأوطانُ بالوطرِ",58,"ر",1,0],["أوطأني ظهر النوى عنهمُ","إني ما نمت من الصد",59,"د",1,0],["أوطنته دار الوزارة ريثما","بنيت لنقلته الكريمة دار",60,"ر",1,0],["أَوْطانِهِ كالتُّرْبِ نَفْعَا","وَاسْأَلْ بهذا كُلّ عاقِلْ",61,"ل",1,0],["أوْطأته قُلَلَ العُداة وإنّها","قُلَلٌ مؤهّلَةٌ لوقعِ الأرجلِ",62,"ل",1,0],["أَوطَنَ يا سِحرُ حُبُّكُم كَبِدي","فَلَيسَ لِلحُبِّ غَيرَها وَطَنُ",63,"ن",1,0],["أَو طُلِبَت بِالجَهدِ ما قَد أَلَّتِ","أَو الحَياةُ فَالحَياةُ مُنيَتي",64,"ت",2,0],["أو طَلَبْنَا بِكَ الرِّيَاسَةَ والجا","هَ عُضِدْنا بالعِزِّ والتأبِيْدِ",65,"د",1,0],["أَو طالَ قدراً فلا قَدَرٌ لمقتدرٍ","أَو قال فخراً فلا فخرٌ لمفتخرِ",66,"ر",1,0],["أَو طَمِعَ الكافِرُ في مِثْلها","في الحشر لم يَكْفُر ولَمْ يَجْحَدِ",67,"د",1,0],["أَوْطَانُهُ لَيْسَتْ بِأَوْطَانٍ إِذَا","غِبْتُمْ وَلَيْسَ رُبُوعُهُ بِرُبُوعِ",68,"ع",1,0],["أَو طانُنا في الأَرضِ خالِصَةً لَنا","نَحنُ الطُيورُ وَهَذِهِ الأَوكارُ",69,"ر",1,0],["أَو طابَ مَدح في علاك بِدَولة","تَوفيقها يُحيي رُسوم معالم",70,"م",1,0],["أَو طابَ مني في الثَناء عَليك ما","يَتلوه بالترتيل كُل مَجيد",71,"د",1,0],["أَوطف الأَهدابِ مَكسور الجُفونْ","أَحوَر الطّرفِ كَحيل المُقلِ",72,"ل",1,0],["أوطانكمُ إخوانكم وبلادكم","عودوا وعهدَكم القديم فجددوا",73,"د",3,0],["أوطان أوطاري وسوق ربحي","وقِبلتي وليلتي وصُبحي",74,"ح",2,0],["أَوطَنُوا الأحساءَ فارتاحَت بِهِم","وَاكتَسى الدَّهرُ بِهِم زيناً وَحُسنا",75,"ن",2,0],["أوطعنة ترمى النجيع بصعدةٍ","مسمومة من يابس المرّان",76,"ن",1,0],["أو طيب ما أثني به","من رائق المدح المنسق",77,"ق",1,0],["أو طاف مشروق بكعبة وتغنّى","يا صاحب التاج والمقلد والخال",78,"ل",1,0],["أو طاولوا طالوا العلا بعزائم","لم يلوها طمع لبرق مطمع",79,"ع",1,0],["أَوطِئ جُيوشَكَ أَرضَ أَندَلُسٍ فَقَد","نَذَرَت تُطيعُكَ كَي يُوَفّى نَذرُها",80,"ر",3,0],["أَوطَأتها هام الكماة فَلَم تَضع","إِلا عَلى خَد طَريح مُبتَكى",81,"ك",2,0],["أَوْطَفَ يَهْدِي مُسْبِ