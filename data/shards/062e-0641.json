ولَيْلَةٍ رَائِقَةِ الْبَهَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=31937",""],[45,"أما الفلاح فقد غدت أسبابه","https://www.poetsgate.com/ViewPoem.aspx?id=31335",""],[45,"إنّ الظّبَاءَ، غَداةَ سَفحِ مُحَجَّرِ","https://www.poetsgate.com/ViewPoem.aspx?id=31190",""],[51,"إبليس إن كنتَ من المُنْظرينْ","https://www.poetsgate.com/ViewPoem.aspx?id=30752",""],[3,"لأَيِّ حَبيبٍ يَحْسُنُ الرَّأْيُ والوُدُّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10678&r=&rc=32",""],[96,"إلى البحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66354&r=&rc=30",""]],"verses":[["خَفيري في الظَلامِ أَقَبُّ نَهدٌ","يُساعِدُني عَلى ذَمِّ الزَمانِ",0,"ن",1,0],["خَف شَرَّها آمَنَ ما كُنتَ لَها","إِنَّ الضَنينَ لَمَكانٌ لِلظِنَن",1,"ن",1,0],["خَفيفٌ عَلى ظَهرِ الجَوادِ تَسَرُّعي","ثَقيلٌ عَلى هامِ الرِجالِ قِيامي",2,"ي",1,0],["خُفِّضَت نَزوَةُ الشَبابِ وَحالَ ال","هَمُّ بَينَ الحَشا وَبَينَ الغَرامِ",3,"م",1,0],["خَفيفُ الحاذِ يَشغَلُهُ سُراهُ","زَماناً أَن يُفَكِّرَ في الهُزالِ",4,"ل",1,0],["خَفَقَت يَمانِيَةٌ عَلى أَرجائِها","وَطَغَت عَلَيها زَعزَعٌ وَخَريقُ",5,"ق",1,0],["خَفيفٌ عَلى ظَهرِ النَجيبِ تَهُزُّهُ","عُروضٌ عَلى أَعطافِهِ وَقُطوعُ",6,"ع",1,0],["خَفَّ عَن عاتِقي الرَجاءُ وَكَم با","تَ بِمَنِّ الرِجالِ وَهوَ وَقيصُ",7,"ص",1,0],["خَفِّض عَليكَ فِلِلأَحزانِ آوِنَةٌ","وَما المُقيمُ عَلى حُزنٍ بِمَعذورِ",8,"ر",1,0],["خَفى بَرقُهُ ثُمَّ اِستَطارَ كَأَنَّهُ","يُشَقَّقُ هُدّابَ المُلاءِ المُعَمَّدِ",9,"د",1,0],["خَفيتَ خَفاءَ البَدرِ يُزجى ظُهورُهُ","وما غابَ بَدرُ اللَيلِ إِلّا لِيُشهَدا",10,"د",2,0],["خَفيفٌ عَلى إِثرِ الطَريدَةِ في الفَل","إِذا هاجَتِ الرَمضاءُ وَاِختَلَفَ الطَردُ",11,"د",1,0],["خَفِراتٌ كَرائِمٌ يَتَهادَي","نَ رُوَيداً كَأَنَّهُنَّ الغُصونُ",12,"ن",1,0],["خَفَضتُ لِمَن يَلوذُ بِكُم جَناحي","وَتَلقَوني كَأَنَكُمُ غِضابُ",13,"ب",1,0],["خَفَفْتَ إِلَيْهَا وَالْجُفُونُ ثَقِيلَةٌ","كَمَا خَفَّ شَتْنُ الْكَفِّ مِنْ أَسْدِ خَفَّانِ",14,"ن",1,0],["خَفوقٌ إذا الشّوْقُ استَجاشَ كَثيبَةَ","تَجوسُ دِيارَ الصّبْرِ كانَ لها بَنْدا",15,"د",2,0],["خَفْ منْ غِذاءٍ غَيْرِ مُعْتَدِلِ القُوى","واحْذَرْ طَعاماً يُفْسِدُ الأمْشاجا",16,"ج",2,0],["خَفيفُ الغَيثِ تُعجِبُ مَن رَآهُ","مَخيلَتُهُ وَلَم تَقطُر بِلالا",17,"ل",2,0],["خِفتَ فينا مَقامَ رَبِّكَ حَيّاً","فَتَنَظَّر بِجَنَّتَيهِ الثَوابا",18,"ب",2,0],["خَفِّضوا جَيشَكُم وَناموا هَنيئا","وَاِبتَغوا صَيدَكُم وَجوبوا البِلادا",19,"د",2,0],["خَفَقَت قُلوبُ المُسلِمينَ وَأَشفَقَت","دارُ الخِلافَةِ وَالمَليكُ الأَعظَمُ",20,"م",1,0],["خِفتُ الرَقيبَ عَلَيهِ وَالوُشاةَ بِهِ","فَقَد جَعَلتُ اِسمَهُ في القَلبِ مُستَتِرا",21,"ر",2,0],["خَفَضتَ جَناحَ الذُلِّ في العِزِّ رَحمَةً","لَها وَعَزيزٌ أَن تَذِلَّ وَتَخضَعا",22,"ع",2,0],["خَفاهُنَّ مِن أَنفاقِهِنَّ كَأَنَّم","خَفاهُنَّ وَدقٌ مِن عَشِيٍّ مُجَلَّبِ",23,"ب",1,0],["خَفِيٌّ تَعَشّى في البِحارِ وَدونَهُ","مِنَ اللُجِّ خُضرٌ مُظلِماتٌ وَسُدَّفُ",24,"ف",1,0],["خَفضَ الْجَنَاحَ لَهَا العِدَى","وَعَلاَ الْوُلاَةُ بِهَا جَنَابَا",25,"ب",2,0],["خَفَقَتْ رَايَةُ الهِلاَلِ عَلَيْهِ","رَايَةُ الصِّدْقِ في كِفَاحِ الخُطُوبِ",26,"ب",1,0],["خَفَقَتْ لِطَلْعَةِ وَجْهِكَ الأَعْلامُ","وَمَشَتْ تُحِيطُ بِرَكْبِكَ الأَعْلامُ",27,"م",1,1],["خَفِيٍّ الجِبا لا يَهتَدي في فَلاتِهِ","مِنَ القَومِ إِلّا الهِبرِزِيُّ المُغامِسُ",28,"س",1,0],["خفا الكوكب الوقاد قد كان نورُهُ","يُجلِّي من الدُّهمْ الخطوب دياجيها",29,"ي",3,0],["خفقت به أعلامُك الحمرُ التي","بخفوقها النصر العزيز موكّلُ",30,"ل",1,0],["خَفَيت ولكن كم وكم","ظهرت لها في الكون آية",31,"ا",3,0],["خفّ من غاص في الغرور كما في","لجّة الماء حفّ ثقل الجماد",32,"د",1,0],["خَفَّ القَطينُ فَقَلبي اليَومَ مَتبولُ","بِالأَعزَلَينَ وَشاقَتني العَطابيلُ",33,"ل",1,1],["خَفَضتُ لَهُم مِنّي جَنَاحَي مَوَدَّةٍ","إلى كَنَفٍ عِطفَاهُ أهلٌ وَمَرحَبُ",34,"ب",1,0],["خَفِّض عَلَيكَ وَلا تَبِت قَلِقَ الحَشا","مِمّا يَكونُ وَعَلَّهُ وَعَساهُ",35,"ه",1,1],["خفت فلو لم تدرْها كفُّ حاملها","دارت بلا حاملٍ في مجلس الطرب",36,"ب",1,0],["خفيفة عن عبدكم خدمة","فإنما تثقيله راتب",37,"ب",1,0],["خفّ النجا بك يا بنيّ إلى السرى","فسبقتني وثقلتُ بالأوزار",38,"ر",1,0],["خفَّ خصر الحبيب ثمَّ ابْتلاني","بعذولٍ يزيدني تعنيفا",39,"ف",2,1],["خفض قلاك وعلَّلني بوعدِ لقا","وخلّ عمري يقضي في تقاضيه",40,"ي",2,0],["خفافيشُ أعشاها نهارٌ بضوئه","ولاءَمَها قِطْعٌ من الليل غَيهبُ",41,"ب",1,0],["خَفَضْت فيهمْ جناح مَرحمةٍ","قد قَلَّ جدّاً عديد خُفّاضه",42,"ض",2,0],["خَفّض عليك ولا تَخْدعْكَ غانيةٌ","فيها لجأشك بالتعليل تخفيضُ",43,"ض",1,0],["خفاضة للرأس لكنها","لرجلها والردف رفّاعه",44,"ع",2,0],["خِفْت متى واصلتْ إملالنا","فخفْ إذا هاجرْتَ أن نَسْلو",45,"و",1,0],["خفيفاً ذفيفاً قالص الذيل قاعداً","لإعداد ما يُرضي النزيلَ وقائما",46,"م",2,0],["خَفَّتْ خُطاهُ إلى الوَغَى","والحلمُ أرجحُ مِنْ يسوم",47,"م",1,0],["خفّفَ اللَّهُ ثِقله عنك ثقلاً","مع أجرٍ عليه لا ممنون",48,"ن",1,0],["خَفَّتْ أعاليه والتفت أسافِلُهُ","كأَنَّما صاغَ نِصْفَيْهِ لُبانانِ",49,"ن",1,0],["خفَّت مَناهضهُ فخفَّ إلى العلا","ورسا بحلم كالجبالِ رزين",50,"ن",1,0],["خَفَّ القَطينُ فَراحوا مِنكَ أَو بَكَروا","وَأَزعَجَتهُم نَوىً في صَرفِها غِيَرُ",51,"ر",1,1],["خَفى الفَأرَ مِن أَنفاقِهِ فَكَأَنَّما","تَخَلَّلَهُ شُؤبوبُ غَيثٍ مُنقِّبِ",52,"ب",1,0],["خَفَضوا جَناحَهُم وَتَحتَ بُرودِهِم","هِمَمُ المُلوك وَصَولَةُ المُرّادِ",53,"د",1,0],["خِفتَ الأَقاويلَ بي قَد نامَ قائِلُها","هَلّا خَشيتَ اِنتِقامي وَهوَ قَد سَهَرا",54,"ر",2,0],["خَفِ التُركِيَّ يَحلِفُ بِالمَثاني","وَخَفهُ كُلَّما صَلّى وَصاما",55,"م",2,0],["خِفهُ قَديراً وَخَفهُ لا اِقتِدارَ لَهُ","فَالظُلمُ وَالغَدرُ إِمّا عَزَّ أَو هانا",56,"ن",2,0],["خَفيفَةَ أَعجازِ المَطِيِّ ثَقيلَةً","عَلى قِرنِها نَزّالَةً بِالمَواسِمِ",57,"م",1,0],["خَفَقَ القلبَ للحياة ورفَّ الزَّه","رُ في حقلِ عمريَ المجرودِ",58,"د",1,0],["خفت عليك زيارة","والموت أثقل من يزور",59,"ر",1,0],["خفيفة بيد الألطاف تنقلها","إلى شواطئ من تبر وأقطار",60,"ر",1,0],["خِفّت لِداعيهم وَلَبّت الطَلَب","وَاِعتَصَمَ المَأمونُ فِيها فَغَلَب",61,"ب",1,0],["خَفَّت عَلَيهِم يَومَ ذَلِكَ مَورِداً","وَأَضَلَّهُم قَدَرٌ فَضَّلوا المَصدَرا",62,"ر",2,0],["خَفَضنا مِن عُلُوِّ الحَقِّ حَتّى","تَوَهَّمنا السِيادَةَ أَن نُسادا",63,"د",2,0],["خَفَضوا في يَومِ سَعدٍ هامَهُم","وَبِسَعدٍ رَفَعوا أَمسِ الجِباها",64,"ا",3,0],["خَفَّت لَهُ العَبَراتُ وَهيَ أَبِيَّةٌ","في حادِثاتِ الدَهرِ غَيرُ خِفافِ",65,"ف",1,0],["خَفَضتُ لِعِزَّةِ المَوتِ اليَراعا","وَجَدَّ جَلالُ مَنطِقِهِ فَراعا",66,"ع",2,1],["خَفِيَت عَنِ القاضي وَفاتَ نَصيبُها","مِن رِفقِ جُندٍ قادَةً نُبَلاءَ",67,"ا",2,0],["خَفَقَت لِرُؤيَتِكَ الضُلو","عُ وَزُلزِلَ القَلبُ العَميد",68,"د",1,0],["خَفَتِ الأَذانُ فَما عَلَيكِ مُوَحِّدٌ","يَسعى وَلا الجُمَعُ الحِسانُ تُقامُ",69,"م",1,0],["خَفَضوا الرُؤوسَ وَوَتَّروا","بِالذُلِّ أَقواسَ الظُهور",70,"ر",1,0],["خَفِيَ الأَساسُ عَنِ العُيونِ تَواضُعاً","مِن بَعدِ ما رَفَعَ البِناءَ مَشيدا",71,"د",2,0],["خِفافاً إِلى الداعي سِراعاً كَأَنَّما","مِنَ الحَربِ داعٍ لِلصَلاةِ مُثَوِّبُ",72,"ب",1,0],["خَفِ اللَهَ وَاِستُر ذا الجَمالَ بِبُرقُعٍ","فَإِن لُحتَ ذابَت في الخُدورِ العَواتِقُ",73,"ق",1,0],["خِفتُ إِن صِرتُ في يَمينِكَ أَن تَأ","خُذَني في هِباتِكَ الأَقوامُ",74,"م",1,0],["خَفَّ الزَمانُ عَلى أَطرافِ أَنمُلِهِ","حَتّى تُوُهِّمنَ لِلأَزمانِ أَزمانا",75,"ن",2,0],["خفقُ الطبولِ وزمرةُ النّدمانِ","وهتوفُ أطيارٍ وعزفُ قِيانِ",76,"ن",1,1],["خفيُّ مَدَبِّ الكَيْدِ يكتُمُ سُخْطَهُ","رضَاهُ ويُسقي السمَّ في مَجَّةِ النَّحْلِ",77,"ل",1,0],["خفيُّ مدَبِّ الكيدِ لا يستشفُّهُ","لبيبٌ ولا يُفْضِي اليه مخادِعُ",78,"ع",1,0],["خفِيُّ مدَبِّ الكيدِ مدْرَجُ خطوِهِ","إِلى المجدِ عُريان الطريقةِ مهيعُ",79,"ع",1,0],["خَفِيُّ مَدَبِّ الكيدِ تَثني أَناتُهُ","تَسَرُّعَ جَهلِ الطائِشِ المُتَوَثَّبِ",80,"ب",1,0],["خَفَّت مَواقِعُ وَطئِهِ فَلَوَ اِنَّهُ","يَجري بِرَملَةِ عالِجٍ لَم يُرهِجِ",81,"ج",1,0],["خَفَّت إِلى السُؤدُدِ المَجفُوِّ نَهضَتُهُ","وَلَو يُوازِنُ رَضوى حِلمُهُ رَجَحا",82,"ح",2,0],["خَفَقَت عَلَيكَ ذُؤابَتَهُ مُشَرِّفاً","بِالعِزِّ مِن مُتَطَوِّلٍ مَحمودِ",83,"د",1,0],["خَفَتَ الغُبارُ وَقَد عَلَوتَ تُريدُهُ","وَسَرى الغَمامُ بِوابِلٍ مُثعَنجِرِ",84,"ر",1,0],["خَفِّض عَلَيكَ مِنَ الهُمومِ فَإِنَّما","يَحظى بِراحَةِ دَهرِهِ مَن خَفَّضا",85,"ض",2,0],["خَفِّض أَسىً عَمّا شَآكَ طِلابُهُ","ماكُلُّ شائِمِ بارِقٍ يُسقاهُ",86,"ا",2,0],["خَفَضنَ إِذا رَأَينَكَ كُلَّ ذَيلٍ","وَوارَينَ الخَلاخِلَ وَالسِوارا",87,"ر",2,0],["خَفيفَةُ أَفواهِ الرُواةِ ث