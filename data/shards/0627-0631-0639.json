{"poems":[[53,"يا من رأى البرق على الأنعم","https://www.aldiwan.net/poem29815.html","السريع"],[53,"لو كان يرتدع القضاء بمردع","https://www.aldiwan.net/poem30148.html","الكامل"],[53,"يا قلب جدد كمدا","https://www.aldiwan.net/poem30611.html","مجزوء الرجز"],[53,"ما يصنع السير بالجرد السراحيب","https://www.aldiwan.net/poem30762.html","البسيط"],[100,"أبو تمام وعروبة اليوم","https://www.aldiwan.net/poem23694.html","عموديه"],[55,"أرعى المودة بالزيارة","https://www.aldiwan.net/poem26108.html","مجزوء الكامل"],[55,"بأنس الحبيب يطيب السمر","https://www.aldiwan.net/poem26323.html","المتقارب"],[77,"لم يبق لي جود الولاية حاجة","https://www.aldiwan.net/poem36355.html","الكامل"],[77,"أو لست من لاك الكلام وصاغه","https://www.aldiwan.net/poem36517.html","الكامل"],[24,"بكرت علي بسحرة تلحاني","https://www.aldiwan.net/poem21887.html","الكامل"],[24,"أرعى الأمانة لا أخون أمانتي","https://www.aldiwan.net/poem21891.html","الكامل"],[10,"يا عين فيضي بدمع منك مغزار","https://www.aldiwan.net/poem20941.html","عموديه"],[93,"صدقت في عتبكم أو يصدق الشمم","https://www.aldiwan.net/poem11361.html","البسيط"],[27,"لولا الحياء لعادني استعبار","https://www.aldiwan.net/poem5740.html","الكامل"],[72,"الله جارك إن دمعي جاري","https://www.aldiwan.net/poem18715.html","الكامل"],[72,"يا طالب الجود لا تتعب أمانيكا","https://www.aldiwan.net/poem19443.html","البسيط"],[51,"يا عجبا من خالد في صبره وجلده","https://www.aldiwan.net/poem9997.html","مجزوء الرجز"],[51,"للناس عيد ولي عيدان في العيد","https://www.aldiwan.net/poem10864.html","البسيط"],[51,"رقاب أهل الحلوم معتبده","https://www.aldiwan.net/poem61895.html","المنسرح"],[51,"مالي أسل من القراب وأغمد","https://www.aldiwan.net/poem61901.html","الكامل"],[51,"قاتله الله فما","https://www.aldiwan.net/poem61931.html","مجزوء الرجز"],[51,"إن تطل لحية عليك وتعرض","https://www.aldiwan.net/poem62843.html","الخفيف"],[91,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[91,"ما للهموم الطارقات ومالي","https://www.aldiwan.net/poem62625.html","عموديه"],[62,"كم ليلة ساهرت زهر نجومها","https://www.aldiwan.net/poem52496.html","الكامل"],[45,"ياراكبا سنن الطريق اللاحب","https://www.aldiwan.net/poem11431.html","الكامل"],[45,"لو تراني والندامى","https://www.aldiwan.net/poem63526.html","مجزوء الرمل"],[74,"بشرى كما أسفر وجه الصباح","https://www.aldiwan.net/poem12886.html","السريع"],[40,"تحمل اليوم أم لم تبرح الأنس","https://www.aldiwan.net/poem42284.html","البسيط"],[50,"تعجبت جارتي مني وقد رقدت","https://www.aldiwan.net/poem63950.html","البسيط"],[50,"أنى دعاه الشوق فارتاحا","https://www.aldiwan.net/poem63965.html","السريع"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30500","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42694","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[91,"بالاسكندرية","https://www.poetsgate.com/ViewPoem.aspx?id=53217",""],[28,"حرف الياء لعمري لقد نبهت يا هند ميتا","https://www.poetsgate.com/ViewPoem.aspx?id=17969",""],[132,"ما بال هذا المدمع الذارف","https://www.aldiwan.net/poem54792.html","السريع"],[195,"أطربت أم رفعت لعينك غدوة","https://www.aldiwan.net/poem54404.html","الكامل"],[199,"سهرت والليل أمسى للورى سكنا","https://www.aldiwan.net/poem45626.html","البسيط"],[211,"منظر رائع الجمال رهيب","https://www.aldiwan.net/poem46588.html","الخفيف"],[231,"زار وهنا ونحن بالزوراء","https://www.aldiwan.net/poem44600.html","الخفيف"],[260,"فدى لبني عدي ركض ساقي","https://www.aldiwan.net/poem1102.html",""],[280,"شرفا لمجدك بانيا ومقوضا","https://www.aldiwan.net/poem60712.html","الكامل"],[282,"ألاح أن لاح بريق يمان","https://www.aldiwan.net/poem32388.html","السريع"],[282,"فيك عذولي عذرا","https://www.aldiwan.net/poem32763.html","مجزوء الرجز"],[282,"يا صاح أيقظ راقد العود","https://www.aldiwan.net/poem32809.html","السريع"],[297,"هاتا أعيدا لي حديثي القديم","https://www.aldiwan.net/poem33164.html","السريع"],[304,"يا هاجري كم ذا تكون مهاجري","https://www.aldiwan.net/poem16862.html","الكامل"],[342,"يا ظبية البان ما رددت ذكراك","https://www.aldiwan.net/poem55313.html","البسيط"],[353,"شمسان في فلك الجمال تقارنا","https://www.aldiwan.net/poem40234.html","الكامل"],[377,"حزت الرئاسة في الآفاق قاطبة","https://www.aldiwan.net/poem59301.html","البسيط"],[393,"قد ظل يجرح صدري","https://www.aldiwan.net/poem53660.html","المجتث"],[416,"يمينا برب النجم والنجم إذ يسري","https://www.aldiwan.net/poem54085.html","الطويل"],[437,"لك ذروة المجد الذي لا يرتقى","https://www.aldiwan.net/poem2535.html","الكامل"],[437,"يا حادياً هلا وقفت قليلا","https://www.aldiwan.net/poem2575.html","الكامل"],[437,"بما بجفنيك من غنجٍ ومن كحلِ","https://www.aldiwan.net/poem2610.html","البسيط"],[441,"المرء لا زال في دنياه كالعرض","https://www.aldiwan.net/poem14456.html","البسيط"],[458,"سل بسلع شجنا كان وكنا","https://www.aldiwan.net/poem55822.html","الرمل"],[477,"هل بعد بينك من جوى لمودع","https://www.aldiwan.net/poem15216.html","الكامل"],[551,"يا يوم أي شجى بمثلك ذاقه","https://www.aldiwan.net/poem47153.html","الكامل"],[551,"ما لي تطيح الدهر أخياري","https://www.aldiwan.net/poem47788.html","البسيط"],[551,"زعازع ثم نكب","https://www.aldiwan.net/poem48102.html","الطويل"],[561,"ورأس أعداء شديد أضمه","https://www.aldiwan.net/poem27859.html","الرجز"]],"verses":[["أَرعَنُ قَد كَدَّرَ ماءَ الحَيا","في مُزنِهِ بِالرَهَجِ الأَقتَمِ",0,"م",1,0],["أَرعى الَّذينَ جَنَوا لَهُ وَرَقَ الغِنى","دوني وَأَعلَكَني شَكيمَةَ مَطمَعي",1,"ع",2,0],["أَرعى الحُمولَ ناظِراً","وَأُلزِمُ القَلبَ يَدا",2,"د",2,0],["أَرعَيتَنا الكَلَأَ المَمطورَ نَنشُطُهُ","نَشطَ الخَمائِلِ بَعدَ المَربِعِ الموبي",3,"ب",2,0],["أرعيت كل جديب لحم راحلة","كانت رعته وماء الروض ينسكب",4,"ب",1,0],["أَرعى المَوَدَّةَ بِالزِيا","رَةِ وَالتَعَهُّدِ بِالسَلامِ",5,"م",1,1],["إِرعَ المُنى واصِلاً وَإِن هَجَرا","فَاِجزَع فَشَرُّ العُشّاقِ مَن صَبَرا",6,"ر",2,0],["أَرْعَيْتَهَا هَمَلاً فَلَمْ يَطْرُقْ لَهَا","بِمَنِيعِ سُورِكَ طَارِقُ الإِهْمَالِ",7,"ل",1,0],["أرْعاكَ أمْر عِبادِهِ فرَعَيْتَهُمْ","في حالي الإعْلانِ والإسْرارِ",8,"ر",1,0],["أَرعى الأَمانَةَ لا أَخونُ وَلا أُرى","أَبَداً أَدَمِّنُ عَرصَةَ الخَوّانِ",9,"ن",1,0],["أَرعى الأَمانَةَ لا أَخونُ أَمانَتي","إِنَّ الخَؤونَ عَلى الطَريقِ الأَنكَبِ",10,"ب",1,1],["ارعى النُّجومَ وما كلّفتُ رعيتها","وتارَة ً أتَغَشّى فضْلَ أطْمارِي",11,"ر",2,0],["أَرْعِدْ حَدِيدُ وَأَبْرِقْ فِي كَتائِبِنَا","وَاغْلُظْ وَرِقَّ كَمَا يَبْغِيكَ بطْشُهُمُ",12,"م",1,0],["أَرعى النُجومَ وَقَد مَضَت غَورِيَّةً","عُصَبُ النُجومِ كَأَنَّهُنَّ صِوارُ",13,"ر",1,0],["أرعى الدّجى وكأنَّ ذيل ظلامه","متشبثٌ بالنجم في مسمار",14,"ر",1,0],["أرعى النجوم لعلي أن أراك بها","لا بالثراء وقبل أن أراعيكا",15,"ك",2,0],["أرْعدَ أوْ تَحْسَبهُ","ذا جِنَّةٍ منْ رَعَدِهْ",16,"د",2,0],["أرْعى النُّجومَ وأنَّى لي بِرِعْيَتِهَا","وطَرَفُ عيْني في أسْرٍ وتَقْيِيدِ",17,"د",1,0],["أُرْعدْتُ إرعادها مجبِّيةً","إن لم أكثِّر من ابنها رِعَدَهْ",18,"د",2,0],["أرعوا زروعكمُ عيونَ تَعهُّدٍ","منكم فمثلُ زروعكم تُتَعَهَّدُ",19,"د",1,0],["أُرْعِدَ أو حَسِبْتَه","ذا جِنَّة من رَعَدِهْ",20,"د",2,0],["أرعِ فيها الموسى فإنك منها","شَهِد الله في أثامٍ كبيرِ",21,"ر",1,0],["أَرعى البُدور وَلَيسَ لي","مِن حاجَةٍ عِندَ البُدورِ",22,"ر",1,0],["أَرعى الثَواقِبَ في الظَلامِ كَأَنَّها","زَهرُ الحَدائِقِ أَو نَثيرُ لَآلي",23,"ل",2,0],["أرعى السماءَ ونجْمُها متلبِّدٌ","حيرانُ قد سُدَّتْ عليه مذاهبُ",24,"ب",1,0],["أَرعى الأَمانَةَ لِلمُضيعِ وَأَبتَغي","حُسنَ الأَمانَةِ مِن مُوَلٍّ ذاهِبِ",25,"ب",1,0],["أَرَعَيتَ العَهدَ مِنّي","مِثلَما أَرعاكَ عَهدي",26,"د",2,0],["أَرعَدَ في تُدميرَ زَجراً لَها","فَما لِعَنزَينِ هُناكَ اِنتِطاح",27,"ح",1,0],["أَرعى النُجُومَ وَطُولُ اللَيلِ مُعتَكِرٌ","حَتذى بَدا الفَجرُ جِلباباً لَهُ الغَلَسُ",28,"س",1,0],["أَرعى مِنَ العَهدِ وَالميثاقِ حَقَّهُما","لا يُصلِحُ الحُرَّ إِلّا حِفظُ ما وَعَدا",29,"د",2,0],["أَرعى بِها النَجمَ وَما رَغبَتي","نَجماً بِطَرفِ العَينِ لَمّاحا",30,"ح",2,0],["أَرْعى على بَقَرِ الأَنِيسِ بجَوِّها","وأُحكِّمُ الصَّبَواتِ في غِزْلانِهَا",31,"ن",3,0],["أَرْعَى الْكَوَاكِبَ فِي السَّمَاءِ كَأَنَّ لِي","عِنْدَ النُّجُومِ رَهِينَةً لَمْ تُدْفَعِ",32,"ع",1,0],["أَرْعَى اتِّضَاعَ أَخِي فَأُوجِزُ وَالَّذِي","يُرْضِي تَوَاضُعَهُ يَسُوءُ إِخائِي",33,"ا",2,0],["أرعى الشواقب في الظّلام كأنها","زهر الحدائق أو نثير لآلي",34,"ل",2,0],["أرعى الله بالإسْلامِ والنّصْرِ جاعِلاً","على كَعبِ مَن ناوَاكَ كَعْبَكَ عَالِيَا",35,"ي",2,0],["اَرعَفتُم في رَقِّكُم مِزبَراً","بِشِعرِ طِرفٍ مِنكُمُ رَاعِفِ",36,"ف",1,0],["أَرعى النُجومَ إِذا تَغَيَّبَ كَوكَبٌ","أَبصَرتُ أُخرى كَالسِرادِ تَحولُ",37,"ل",1,0],["أرعى كواكِبها حتى إذا أفلتْ","ألقيتُ للطيرِ في تحنانها الأذنا",38,"ن",2,0],["أرعد تصرخ الطبيعة فيها","صرخات المتيّم المفجوع",39,"ع",1,0],["ارعدت دونه الفرائض إج","لالا حبيب الرحمن رب السماء",40,"ا",2,0],["أَرُعيانَ الشَوِيِّ وَجَدتُمونا","أَمَ اَصحابَ الكَريهَةِ وَالنِطاحِ",41,"ح",1,0],["أَرْعَيْتَ هذا الْمُلْكَ أَشْرَفَ هِمَّةٍ","تَأْبى لِطَرْفِكَ طَرْفَةً أَنْ يُغْمِضا",42,"ض",2,0],["اِرعَ كَلامي مُسمِعاً يا أَبا","مُحَمَّد الحافِظ يا اِبنَ الهِجان",43,"ن",1,0],["إِرعَ ذِمامي وَاتَّئِب","ما حَسَنٌ أَن تَغدُرا",44,"ر",2,0],["أرعِف خَياشيمَ أَباريقِنا","مِن دَمِ أَوداجِ العَناقيدِ",45,"د",1,0],["أَرعى له العهدَ وكم لَيلةٍ","حلَّيتُ من ذكراه كأسَ النَديم",46,"م",1,0],["أرعى النجوم بناظر أو ناظراً","ومسائلاً عن عابر من عابر",47,"ر",1,0],["أرعى النجوم وقلبي طائر غرد","يشدو أغاني هواه حول مغناك",48,"ك",1,0],["أَرعاهما فذّاً وَطَوراً توأماً","فَكَأنَّما أَرعى بِعَيني أَحولِ",49,"ل",1,0],["ارعَ خرافي خرافي أمتي أممي","ارعَ نعاجي مُ الأسيادُ إلاكا",50,"ك",2,0],["أَرعيتُ زُهر نجومٍ","رَحمنَ سَقمي وَضُرّي",51,"ر",2,0],["أرعْتَ أُولي الأَلباب منها بحكمةٍ","بروح أرسطاليس منها على ذعر",52,"ر",1,0],["أرعبتني روض الكرامة بعدما","قد صرت لي حدبا وبرا مشفقا",53,"ق",2,0],["أرعيتنا روض العلوم كأنّما","ردّ الإله لنا القرون الأولى",54,"ل",2,0],["أرعى رياض الندى من فيض أنعمهم","وأسرح الطرف بين الخيل والخول",55,"ل",1,0],["أرعى الفضلي وما حصّلتُ من أدبٍ","ومن علوم ولا أرعى مع الهمَلِ",55,"ل",1,0],["أرعى النجوم لرزء منك مشتمل","على مصائب وجد فيك معترض",56,"ض",1,0],["أَرْعنِي سَمعك تَسمَعْ فِقَرا","لو طَلبن العُصْمَ بالإذن أَذِنّا",57,"ن",2,0],["أرعى حقوقَ أحبَّتي باذالةِ المد","معِ المَصُونِ على تُرابِ المربعٍ",58,"ع",1,0],["أرْعى جميمَ الحقِّ في أوطانهمْ","رَعْيَ الهشيمِ سوائِمَ العُدوانِ",59,"ن",1,0],["أرعى نجومَ الدّجى أنّى مسالكُها","ولا نديمَ سوى بثّي وأفكاري",60,"ي",1,0],["أَرعى الأمانيَ عُمري","مَرعىْ لَعمرُك جَدْبُ",61,"ب",1,0],["أَرعَنَ جَرّارٍ تَحِفُّ أَجَمُه","إِذا عَلا قُفّاً تَشَظّى أَكَمُه",62,"م",2,0]]}