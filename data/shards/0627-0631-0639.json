{"poems":[[53,"يا من رأى البرق على الأنعم","https://www.aldiwan.net/poem29815.html","السريع"],[53,"لو كان يرتدع القضاء بمردع","https://www.aldiwan.net/poem30148.html","الكامل"],[53,"يا قلب جدد كمدا","https://www.aldiwan.net/poem30611.html","مجزوء الرجز"],[53,"ما يصنع السير بالجرد السراحيب","https://www.aldiwan.net/poem30762.html","البسيط"],[100,"أبو تمام وعروبة اليوم","https://www.aldiwan.net/poem23694.html","عموديه"],[55,"أرعى المودة بالزيارة","https://www.aldiwan.net/poem26108.html","مجزوء الكامل"],[55,"بأنس الحبيب يطيب السمر","https://www.aldiwan.net/poem26323.html","المتقارب"],[77,"لم يبق لي جود الولاية حاجة","https://www.aldiwan.net/poem36355.html","الكامل"],[77,"أو لست من لاك الكلام وصاغه","https://www.aldiwan.net/poem36517.html","الكامل"],[24,"بكرت علي بسحرة تلحاني","https://www.aldiwan.net/poem21887.html","الكامل"],[24,"أرعى الأمانة لا أخون أمانتي","https://www.aldiwan.net/poem21891.html","الكامل"],[10,"يا عين فيضي بدمع منك مغزار","https://www.aldiwan.net/poem20941.html","عموديه"],[93,"صدقت في عتبكم أو يصدق الشمم","https://www.aldiwan.net/poem11361.html","البسيط"],[27,"لولا الحياء لعادني استعبار","https://www.aldiwan.net/poem5740.html","الكامل"],[72,"الله جارك إن دمعي جاري","https://www.aldiwan.net/poem18715.html","الكامل"],[72,"يا طالب الجود لا تتعب أمانيكا","https://www.aldiwan.net/poem19443.html","البسيط"],[51,"يا عجبا من خالد في صبره وجلده","https://www.aldiwan.net/poem9997.html","مجزوء الرجز"],[51,"للناس عيد ولي عيدان في العيد","https://www.aldiwan.net/poem10864.html","البسيط"],[51,"رقاب أهل الحلوم معتبده","https://www.aldiwan.net/poem61895.html","المنسرح"],[51,"مالي أسل من القراب وأغمد","https://www.aldiwan.net/poem61901.html","الكامل"],[51,"قاتله الله فما","https://www.aldiwan.net/poem61931.html","مجزوء الرجز"],[51,"إن تطل لحية عليك وتعرض","https://www.aldiwan.net/poem62843.html","الخفيف"],[91,"من سحر طرفك من مجيري","https://www.aldiwan.net/poem8845.html","عموديه"],[91,"ما للهموم الطارقات ومالي","https://www.aldiwan.net/poem62625.html","عموديه"],[62,"كم ليلة ساهرت زهر نجومها","https://www.aldiwan.net/poem52496.html","الكامل"],[45,"ياراكبا سنن الطريق اللاحب","https://www.aldiwan.net/poem11431.html","الكامل"],[45,"لو تراني والندامى","https://www.aldiwan.net/poem63526.html","مجزوء الرمل"],[74,"بشرى كما أسفر وجه الصباح","https://www.aldiwan.net/poem12886.html","السريع"],[40,"تحمل اليوم أم لم تبرح الأنس","https://www.aldiwan.net/poem42284.html","البسيط"],[50,"تعجبت جارتي مني وقد رقدت","https://www.aldiwan.net/poem63950.html","البسيط"],[50,"أنى دعاه الشوق فارتاحا","https://www.aldiwan.net/poem63965.html","السريع"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30500","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42694","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[91,"بالاسكندرية","https://www.poetsgate.com/ViewPoem.aspx?id=53217",""],[28,"حرف الياء لعمري لقد نبهت يا هند ميتا","https://www.poetsgate.com/ViewPoem.aspx?id=17969",""]],"verses":[["أَرعَنُ قَد كَدَّرَ ماءَ الحَيا","في مُزنِهِ بِالرَهَجِ الأَقتَمِ",0,"م",1,0],["أَرعى الَّذينَ جَنَوا لَهُ وَرَقَ الغِنى","دوني وَأَعلَكَني شَكيمَةَ مَطمَعي",1,"ع",2,0],["أَرعى الحُمولَ ناظِراً","وَأُلزِمُ القَلبَ يَدا",2,"د",2,0],["أَرعَيتَنا الكَلَأَ المَمطورَ نَنشُطُهُ","نَشطَ الخَمائِلِ بَعدَ المَربِعِ الموبي",3,"ب",2,0],["أرعيت كل جديب لحم راحلة","كانت رعته وماء الروض ينسكب",4,"ب",1,0],["أَرعى المَوَدَّةَ بِالزِيا","رَةِ وَالتَعَهُّدِ بِالسَلامِ",5,"م",1,1],["إِرعَ المُنى واصِلاً وَإِن هَجَرا","فَاِجزَع فَشَرُّ العُشّاقِ مَن صَبَرا",6,"ر",2,0],["أَرْعَيْتَهَا هَمَلاً فَلَمْ يَطْرُقْ لَهَا","بِمَنِيعِ سُورِكَ طَارِقُ الإِهْمَالِ",7,"ل",1,0],["أرْعاكَ أمْر عِبادِهِ فرَعَيْتَهُمْ","في حالي الإعْلانِ والإسْرارِ",8,"ر",1,0],["أَرعى الأَمانَةَ لا أَخونُ وَلا أُرى","أَبَداً أَدَمِّنُ عَرصَةَ الخَوّانِ",9,"ن",1,0],["أَرعى الأَمانَةَ لا أَخونُ أَمانَتي","إِنَّ الخَؤونَ عَلى الطَريقِ الأَنكَبِ",10,"ب",1,1],["ارعى النُّجومَ وما كلّفتُ رعيتها","وتارَة ً أتَغَشّى فضْلَ أطْمارِي",11,"ر",2,0],["أَرْعِدْ حَدِيدُ وَأَبْرِقْ فِي كَتائِبِنَا","وَاغْلُظْ وَرِقَّ كَمَا يَبْغِيكَ بطْشُهُمُ",12,"م",1,0],["أَرعى النُجومَ وَقَد مَضَت غَورِيَّةً","عُصَبُ النُجومِ كَأَنَّهُنَّ صِوارُ",13,"ر",1,0],["أرعى الدّجى وكأنَّ ذيل ظلامه","متشبثٌ بالنجم في مسمار",14,"ر",1,0],["أرعى النجوم لعلي أن أراك بها","لا بالثراء وقبل أن أراعيكا",15,"ك",2,0],["أرْعدَ أوْ تَحْسَبهُ","ذا جِنَّةٍ منْ رَعَدِهْ",16,"د",2,0],["أرْعى النُّجومَ وأنَّى لي بِرِعْيَتِهَا","وطَرَفُ عيْني في أسْرٍ وتَقْيِيدِ",17,"د",1,0],["أُرْعدْتُ إرعادها مجبِّيةً","إن لم أكثِّر من ابنها رِعَدَهْ",18,"د",2,0],["أرعوا زروعكمُ عيونَ تَعهُّدٍ","منكم فمثلُ زروعكم تُتَعَهَّدُ",19,"د",1,0],["أُرْعِدَ أو حَسِبْتَه","ذا جِنَّة من رَعَدِهْ",20,"د",2,0],["أرعِ فيها الموسى فإنك منها","شَهِد الله في أثامٍ كبيرِ",21,"ر",1,0],["أَرعى البُدور وَلَيسَ لي","مِن حاجَةٍ عِندَ البُدورِ",22,"ر",1,0],["أَرعى الثَواقِبَ في الظَلامِ كَأَنَّها","زَهرُ الحَدائِقِ أَو نَثيرُ لَآلي",23,"ل",2,0],["أرعى السماءَ ونجْمُها متلبِّدٌ","حيرانُ قد سُدَّتْ عليه مذاهبُ",24,"ب",1,0],["أَرعى الأَمانَةَ لِلمُضيعِ وَأَبتَغي","حُسنَ الأَمانَةِ مِن مُوَلٍّ ذاهِبِ",25,"ب",1,0],["أَرَعَيتَ العَهدَ مِنّي","مِثلَما أَرعاكَ عَهدي",26,"د",2,0],["أَرعَدَ في تُدميرَ زَجراً لَها","فَما لِعَنزَينِ هُناكَ اِنتِطاح",27,"ح",1,0],["أَرعى النُجُومَ وَطُولُ اللَيلِ مُعتَكِرٌ","حَتذى بَدا الفَجرُ جِلباباً لَهُ الغَلَسُ",28,"س",1,0],["أَرعى مِنَ العَهدِ وَالميثاقِ حَقَّهُما","لا يُصلِحُ الحُرَّ إِلّا حِفظُ ما وَعَدا",29,"د",2,0],["أَرعى بِها النَجمَ وَما رَغبَتي","نَجماً بِطَرفِ العَينِ لَمّاحا",30,"ح",2,0],["أَرْعى على بَقَرِ الأَنِيسِ بجَوِّها","وأُحكِّمُ الصَّبَواتِ في غِزْلانِهَا",31,"ن",3,0],["أَرْعَى الْكَوَاكِبَ فِي السَّمَاءِ كَأَنَّ لِي","عِنْدَ النُّجُومِ رَهِينَةً لَمْ تُدْفَعِ",32,"ع",1,0],["أَرْعَى اتِّضَاعَ أَخِي فَأُوجِزُ وَالَّذِي","يُرْضِي تَوَاضُعَهُ يَسُوءُ إِخائِي",33,"ا",2,0],["أرعى الشواقب في الظّلام كأنها","زهر الحدائق أو نثير لآلي",34,"ل",2,0],["أرعى الله بالإسْلامِ والنّصْرِ جاعِلاً","على كَعبِ مَن ناوَاكَ كَعْبَكَ عَالِيَا",35,"ي",2,0]]}