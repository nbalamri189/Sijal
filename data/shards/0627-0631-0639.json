 ساهر","https://www.poetsgate.com/ViewPoem.aspx?id=173268",""],[5451,"لكم مزماركم ولي مزماري","https://www.poetsgate.com/ViewPoem.aspx?id=155932",""],[5533,"ما زَلتُ أنتَظِرُ الخَبَر","https://www.poetsgate.com/ViewPoem.aspx?id=176657",""],[5606,"يامرحبا ترحيبة دايم الدوم","https://www.poetsgate.com/ViewPoem.aspx?id=195279",""],[5628,"نذاء الروح","https://www.poetsgate.com/ViewPoem.aspx?id=178463",""],[5725,"لاالقوم قومي","https://www.poetsgate.com/ViewPoem.aspx?id=177420",""],[5725,"يا نخلة البصرة","https://www.poetsgate.com/ViewPoem.aspx?id=210802",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5739,"زوايا الحبر ..!","https://www.poetsgate.com/ViewPoem.aspx?id=126878",""],[5739,"فرحة بخيل ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131229",""],[5741,"بي أحوى وقد حوى","https://www.poetsgate.com/ViewPoem.aspx?id=187453",""],[5804,"التحدّي","https://www.poetsgate.com/ViewPoem.aspx?id=190658",""],[5848,"فاعل وفعله خيالي","https://www.poetsgate.com/ViewPoem.aspx?id=48822",""],[5906,"مَرَّ بي","https://www.poetsgate.com/ViewPoem.aspx?id=188228",""],[1920,"نفق الخلاص","https://www.poetsgate.com/ViewPoem.aspx?id=194536",""],[5956,"ما دامت الغابات تغذو همَّتي","https://www.poetsgate.com/ViewPoem.aspx?id=183340",""],[5970,"قالوا اصطبر قلت إن الصبر قد نفذا","https://www.poetsgate.com/ViewPoem.aspx?id=130634",""],[5997,"ثَغْرُ الحَنَيْن","https://www.poetsgate.com/ViewPoem.aspx?id=214535",""],[6023,"أرعشني الدَّهر أيَّ رعشِ","https://www.poetsgate.com/ViewPoem.aspx?id=123889",""],[6056,"صديق اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=156695",""],[6089,"الظلام الضالعُ","https://www.poetsgate.com/ViewPoem.aspx?id=213035",""],[6102,"خرف أنا","https://www.poetsgate.com/ViewPoem.aspx?id=183985",""],[4222,"بين أمر حلاوة العيش الشهي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52919&r=&rc=211",""]],"verses":[["أَرعَنُ قَد كَدَّرَ ماءَ الحَيا","في مُزنِهِ بِالرَهَجِ الأَقتَمِ",0,"م",1,0],["أَرعى الَّذينَ جَنَوا لَهُ وَرَقَ الغِنى","دوني وَأَعلَكَني شَكيمَةَ مَطمَعي",1,"ع",2,0],["أَرعى الحُمولَ ناظِراً","وَأُلزِمُ القَلبَ يَدا",2,"د",2,0],["أَرعَيتَنا الكَلَأَ المَمطورَ نَنشُطُهُ","نَشطَ الخَمائِلِ بَعدَ المَربِعِ الموبي",3,"ب",2,0],["أرعيت كل جديب لحم راحلة","كانت رعته وماء الروض ينسكب",4,"ب",1,0],["أَرعى المَوَدَّةَ بِالزِيا","رَةِ وَالتَعَهُّدِ بِالسَلامِ",5,"م",1,1],["إِرعَ المُنى واصِلاً وَإِن هَجَرا","فَاِجزَع فَشَرُّ العُشّاقِ مَن صَبَرا",6,"ر",2,0],["أَرْعَيْتَهَا هَمَلاً فَلَمْ يَطْرُقْ لَهَا","بِمَنِيعِ سُورِكَ طَارِقُ الإِهْمَالِ",7,"ل",1,0],["أرْعاكَ أمْر عِبادِهِ فرَعَيْتَهُمْ","في حالي الإعْلانِ والإسْرارِ",8,"ر",1,0],["أَرعى الأَمانَةَ لا أَخونُ وَلا أُرى","أَبَداً أَدَمِّنُ عَرصَةَ الخَوّانِ",9,"ن",1,0],["أَرعى الأَمانَةَ لا أَخونُ أَمانَتي","إِنَّ الخَؤونَ عَلى الطَريقِ الأَنكَبِ",10,"ب",1,1],["ارعى النُّجومَ وما كلّفتُ رعيتها","وتارَة ً أتَغَشّى فضْلَ أطْمارِي",11,"ر",2,0],["أَرْعِدْ حَدِيدُ وَأَبْرِقْ فِي كَتائِبِنَا","وَاغْلُظْ وَرِقَّ كَمَا يَبْغِيكَ بطْشُهُمُ",12,"م",1,0],["أَرعى النُجومَ وَقَد مَضَت غَورِيَّةً","عُصَبُ النُجومِ كَأَنَّهُنَّ صِوارُ",13,"ر",1,0],["أرعى الدّجى وكأنَّ ذيل ظلامه","متشبثٌ بالنجم في مسمار",14,"ر",1,0],["أرعى النجوم لعلي أن أراك بها","لا بالثراء وقبل أن أراعيكا",15,"ك",2,0],["أرْعدَ أوْ تَحْسَبهُ","ذا جِنَّةٍ منْ رَعَدِهْ",16,"د",2,0],["أرْعى النُّجومَ وأنَّى لي بِرِعْيَتِهَا","وطَرَفُ عيْني في أسْرٍ وتَقْيِيدِ",17,"د",1,0],["أُرْعدْتُ إرعادها مجبِّيةً","إن لم أكثِّر من ابنها رِعَدَهْ",18,"د",2,0],["أرعوا زروعكمُ عيونَ تَعهُّدٍ","منكم فمثلُ زروعكم تُتَعَهَّدُ",19,"د",1,0],["أُرْعِدَ أو حَسِبْتَه","ذا جِنَّة من رَعَدِهْ",20,"د",2,0],["أرعِ فيها الموسى فإنك منها","شَهِد الله في أثامٍ كبيرِ",21,"ر",1,0],["أَرعى البُدور وَلَيسَ لي","مِن حاجَةٍ عِندَ البُدورِ",22,"ر",1,0],["أَرعى الثَواقِبَ في الظَلامِ كَأَنَّها","زَهرُ الحَدائِقِ أَو نَثيرُ لَآلي",23,"ل",2,0],["أرعى السماءَ ونجْمُها متلبِّدٌ","حيرانُ قد سُدَّتْ عليه مذاهبُ",24,"ب",1,0],["أَرعى الأَمانَةَ لِلمُضيعِ وَأَبتَغي","حُسنَ الأَمانَةِ مِن مُوَلٍّ ذاهِبِ",25,"ب",1,0],["أَرَعَيتَ العَهدَ مِنّي","مِثلَما أَرعاكَ عَهدي",26,"د",2,0],["أَرعَدَ في تُدميرَ زَجراً لَها","فَما لِعَنزَينِ هُناكَ اِنتِطاح",27,"ح",1,0],["أَرعى النُجُومَ وَطُولُ اللَيلِ مُعتَكِرٌ","حَتذى بَدا الفَجرُ جِلباباً لَهُ الغَلَسُ",28,"س",1,0],["أَرعى مِنَ العَهدِ وَالميثاقِ حَقَّهُما","لا يُصلِحُ الحُرَّ إِلّا حِفظُ ما وَعَدا",29,"د",2,0],["أَرعى بِها النَجمَ وَما رَغبَتي","نَجماً بِطَرفِ العَينِ لَمّاحا",30,"ح",2,0],["أَرْعى على بَقَرِ الأَنِيسِ بجَوِّها","وأُحكِّمُ الصَّبَواتِ في غِزْلانِهَا",31,"ن",3,0],["أَرْعَى الْكَوَاكِبَ فِي السَّمَاءِ كَأَنَّ لِي","عِنْدَ النُّجُومِ رَهِينَةً لَمْ تُدْفَعِ",32,"ع",1,0],["أَرْعَى اتِّضَاعَ أَخِي فَأُوجِزُ وَالَّذِي","يُرْضِي تَوَاضُعَهُ يَسُوءُ إِخائِي",33,"ا",2,0],["أرعى الشواقب في الظّلام كأنها","زهر الحدائق أو نثير لآلي",34,"ل",2,0],["أرعى الله بالإسْلامِ والنّصْرِ جاعِلاً","على كَعبِ مَن ناوَاكَ كَعْبَكَ عَالِيَا",35,"ي",2,0],["اَرعَفتُم في رَقِّكُم مِزبَراً","بِشِعرِ طِرفٍ مِنكُمُ رَاعِفِ",36,"ف",1,0],["أَرعى النُجومَ إِذا تَغَيَّبَ كَوكَبٌ","أَبصَرتُ أُخرى كَالسِرادِ تَحولُ",37,"ل",1,0],["أرعى كواكِبها حتى إذا أفلتْ","ألقيتُ للطيرِ في تحنانها الأذنا",38,"ن",2,0],["أرعد تصرخ الطبيعة فيها","صرخات المتيّم المفجوع",39,"ع",1,0],["ارعدت دونه الفرائض إج","لالا حبيب الرحمن رب السماء",40,"ا",2,0],["أَرُعيانَ الشَوِيِّ وَجَدتُمونا","أَمَ اَصحابَ الكَريهَةِ وَالنِطاحِ",41,"ح",1,0],["أَرْعَيْتَ هذا الْمُلْكَ أَشْرَفَ هِمَّةٍ","تَأْبى لِطَرْفِكَ طَرْفَةً أَنْ يُغْمِضا",42,"ض",2,0],["اِرعَ كَلامي مُسمِعاً يا أَبا","مُحَمَّد الحافِظ يا اِبنَ الهِجان",43,"ن",1,0],["إِرعَ ذِمامي وَاتَّئِب","ما حَسَنٌ أَن تَغدُرا",44,"ر",2,0],["أرعِف خَياشيمَ أَباريقِنا","مِن دَمِ أَوداجِ العَناقيدِ",45,"د",1,0],["أَرعى له العهدَ وكم لَيلةٍ","حلَّيتُ من ذكراه كأسَ النَديم",46,"م",1,0],["أرعى النجوم بناظر أو ناظراً","ومسائلاً عن عابر من عابر",47,"ر",1,0],["أرعى النجوم وقلبي طائر غرد","يشدو أغاني هواه حول مغناك",48,"ك",1,0],["أَرعاهما فذّاً وَطَوراً توأماً","فَكَأنَّما أَرعى بِعَيني أَحولِ",49,"ل",1,0],["ارعَ خرافي خرافي أمتي أممي","ارعَ نعاجي مُ الأسيادُ إلاكا",50,"ك",2,0],["أ