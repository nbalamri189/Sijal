poem/103039","الكامل"],[3916,"","https://poetry.dctabudhabi.ae/diwan/poem/122213","المنسرح"],[3950,"","https://poetry.dctabudhabi.ae/diwan/poem/146097","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36434","الدوبيت"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119601","الكامل"],[4085,"","https://poetry.dctabudhabi.ae/diwan/poem/105142","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123506","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123494","السلسلة"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123488","الكامل"],[4155,"","https://poetry.dctabudhabi.ae/diwan/poem/178113","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90757","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90868","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90832","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45128","البسيط"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45019","الكامل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135100","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120525","الكامل"],[5129,"مقام الفعل","https://www.poetsgate.com/ViewPoem.aspx?id=120509",""],[5237,"هذي رياح اليمن هب نسيمها","https://www.poetsgate.com/ViewPoem.aspx?id=113116",""],[5596,"بين السبحية والحمراء","https://www.poetsgate.com/ViewPoem.aspx?id=206360",""],[5739,"عطر ٍ نهمني","https://www.poetsgate.com/ViewPoem.aspx?id=126414",""],[5783,"دفاع عن شرف القبيلة","https://www.poetsgate.com/ViewPoem.aspx?id=36934",""],[5567,"لدمشق آيات الهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82079&r=&rc=132",""],[572,"قُمْ فاعقُرِ الهمّ بالعُقَارِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9320&r=&rc=177",""]],"verses":[["مِنْ كَفِّ سَاحِرَةِ الألْحَاظِ فَاتِنَةٍ","حَسْنَاء تَخْتَالُ بَيْنَ الْحَلْيِ وَالْحُلَلِ",0,"ل",1,0],["منْ كَفِّ فاتِنَةِ اللِّحاظِ غَريرةٍ","سَكْرى الجُفونِ وما سُقينَ الرّاحا",1,"ح",2,0],["مِنْ كَفِّ سَاجِيِةِ الْجُفُونِ كَأَنَّمَا","هَبَّتْ وَفِي الأَجْفَانِ بَعْضُ سِنَاتِهَا",2,"ت",3,0],["مِن كَفِّ مَصقولِ العَوارِضِ آنِسٍ","يَرنو بِمُقلَةِ جُؤذُرٍ مُرتاعِ",3,"ع",1,0],["من كفّ شفاف الضياء تخاله","لصفاء جوهرهِ تجسَّدَ نورا",4,"ر",2,0],["من كفِّ أغيد يحسوها مقهقهةَ","كما تأوَّد غصنٌ تحت ورقاء",5,"ا",2,0],["من كفِّ أغيدَ تروي عن شمائله","عن خدِّه المشتهَى عن ثغرِهِ الشنب",6,"ب",1,0],["من كف وضاحِ الجبين إذا","لَحظَ الترابَ اهتزَّ بالعشب",7,"ب",1,0],["من كف مهضومِ الحشا","مثل المهاةِ الحادِره",8,"ر",2,0],["من كفِّ لدن القوام مشتمل","بفرعِه كالقضيب ميَّاس",9,"س",1,0],["مُنْكَفِتُ الشرِّ كلَّ مُنكفَتٍ","مُنْبَعِثُ الخير كل منبعَثِ",10,"ث",1,0],["مِن كَفِّ رَيّانِ الشَبابِ مُنَعَّمٍ","يَسبي العُقولَ بِطَرفِهِ الوَسنانِ",11,"ن",1,0],["مِن كَفِّ ذي هَيَفٍ يُضاعِفُ خُلقُه","سُكرَ المُدامِ بِشَدوِهِ وَنَشيدِهِ",12,"د",2,0],["من كفِّ مطرِّفَةٍ عَنَماً","كالبدر بَدا والرئمِ رنا",13,"ن",2,0],["مِن كَفِّ ظَبيٍ مَليحٍ","ساجي الجُفوني غَريرِ",14,"ر",1,0],["مِن كَفِّ ذاتِ حِرٍ في زِيِّ ذي ذَكَرٍ","لَها مُحِبّانِ لوطِيٌّ وَزَنّاءُ",15,"ا",2,0],["مِن كَفِّ ذي غَنَجٍ حُلوٌ شَمائِلُهُ","كَأَنَّهُ عِندَ رَأيِ العَينِ عَذراءُ",16,"ا",2,0],["مِن كَفِّ ساقِيَةٍ ناهيكَ ساقِيَةً","في حُسنِ قَدٍّ وَفي ظُرفٍ وَفي أَدَبِ",17,"ب",1,0],["مِن كَفِّ ساقِيَةٍ يَستَلُّ ناظِرُها","لِدِقَّةِ الفَهمِ ما أَوحى بِهِ الواحي",18,"ح",2,0],["مِن كَفِّ قِبطِيَّةٍ مُزَنَّرَةٍ","نَجعَلُها لِلصَبوحِ مِفتاحا",19,"ح",2,0],["مِن كَفِّ مُختَصِرِ الزُنّارِ مُعتَدِلٍ","كَغُصنِ بانٍ تَثَنّى غَيرِ ذي أَوَدِ",20,"د",1,0],["مِن كَفِّ ظَبيٍ ناعِمٍ","غَنِجٍ بِمُقلَتِهِ حَوَر",21,"ر",1,0],["مِن كَفِّ ذي غَنَجٍ كَأَنَّ جَبينَهُ","قَمَرٌ وَسائِرُ وَجهِهِ دينارُ",22,"ر",1,0],["مِن كَفِّ ساقِيَةٍ مُقَرطَقَةٍ","ناهيكَ مِن حُسنٍ وَمِن ظُرفِ",23,"ف",1,0],["مِن كَفِّ ظَبيٍ أَغَنَّ ذي غَنَجٍ","أُكمِلَ مِن قَرنِهِ إِلى القَدَمِ",24,"م",1,0],["مِن كَفِّ ظَبيٍ أَغَنَّ ذي غَنَجٍ","أُبدِعَ فيهِ طَرائِفُ الحُسَنِ",25,"ن",1,0],["مِن كَفِّ ظَبيٍ مُقَرطَقٍ غَنِجٍ","يَعشَقُهُ مَن عَلَيهِ يَعذُلُني",26,"ن",2,0],["من كفيل الكشف عن موضوعهم","هل له مستودع او مستقر",27,"ر",1,0],["مِن كف غانية إذا ما أسفرت","أخفت بطلعتها إيَاةُ ذُكاءِ",28,"ا",2,0],["من كفِّ أغيدَ ما لكفّيْ ربِّهِ","إذ يشتريه وصفقةُ المغْبونِ",29,"ن",1,0],["مِن كَفِّ خَرعبَةٍ حُوٍّ مَراشِفُها","بِيضٍ سَوالِفُها سُودٍ مَآقيها",30,"ي",3,0],["من كفاه من مساعيه","رغيف يكتفيه",31,"ي",2,1],["من كفِ حوراءَ غلاميةٍ","مفعمةِ الحجلينِ خودٍ رجاجْ",32,"ج",1,0],["من كَفُّه بحرُ عَطا زاخِرٌ","منه جَميعُ السُحبِ تَستَجدي",33,"د",2,0],["من كَفّ مَخْطوف الحَشا أهَيفٍ","يَرْفُل في ثوب الملاحات",34,"ت",1,0],["منْ كَف هَيفاء المَعاطِف كلما","أدْمَت فمَ الإبْريقِ أدْمى خدهَا",35,"ه",2,0],["مِن كَفِّ مَهضومِ الحَشا","وَالكَشحِ مِقلاقِ الوِشاحِ",36,"ح",1,0],["مِن كَفِّ مَشهوقِ القَوامِ","مُخطَفِ الوِشاحِ",37,"ح",1,0],["مَن كفُّهُ مملوءةٌ ذهباً","سيروع قلبَكِ قلبُهُ الخالي",38,"ل",2,0],["مِن كَفِّ مُرتَجَّةِ الأَطرافِ لَيِّنَةِ ال","أَعطافِ بِاللَحظِ تُصبيني وَتَسبيني",39,"ن",2,0],["مِن كَفِّ ريمِ الرومِ فَهوَ إِذا رَنا","فَكَأَنَّهُ صَيدَ الأُسودِ يَرومُ",40,"م",1,0],["مِن كَفِّ أَحوى غَريرٍ","حُلوِ المَراشِفِ أَلعَس",41,"س",1,0],["مِن كَفِّ أَحوَرَ شادِنٍ عَذبِ اللَمى","وَخَريدَةٍ مَلأى الإِزارِ رَداحِ",42,"ح",1,0],["من كَفّ أَحوَرَ تُركِيّ لَواحِظُهُ","أَمضى مِنَ السُمرِ وَالمُبيَضَّةِ القُضُبِ",43,"ب",1,0],["مِن كَفّ أَسمَرَ بابِلِيٍّ قَدُّهُ","يَهتَزُّ مِثلَ الصَعدَةِ السَمراءِ",44,"ا",2,0],["من كفِّ أَغيدَ في خلخاله حَرَجٌ","إِذا تَثَنّى وفي أَجراسِهِ قَلقُ",45,"ق",1,0],["مِن كَفِّ أَغيدَ ما لِلبَدر طلعتُه","ولا لِشَمسِ الضُحى منه مَلامحُهُ",46,"ح",2,0],["مِن كَفّ شادٍ شادنٍ سلبَ النُهى","بِجَماله وَهَوى المَها فَضّاحُ",47,"ح",1,0],["مَنْ كَفُّه إذا اعتَفاه سائلٌ","أَسمَحُ من قَطْرِ الغمامِ الأَوطَف",48,"ف",1,0],["من كَفِّ خِرْقٍ للعطاء مُفرِّقٍ","بالمكرماتِ وللعلاء جَموع",49,"ع",1,0],["من كفِّ ساقِيَةٍ بعقدِ وشاحِها","عَقدت فؤادَ مُتيَّمٍ وَلهانِ",50,"ن",1,0],["من كفره والنفاق","والموت ماله ثبات",51,"ت",1,0],["مَن كفخرِ الأئمّة العلَمُ العا","لم مَن بحرُ رفدِه مورودُ",52,"د",1,0],["من كفِّ وطفاءِ الجفونِ كأنّما","تسعى بنارٍ أُضْرِمَتْ في الماءِ",53,"ا",2,0],["من كفّ أغيد ممشوق القوام غدت","نحكيه خدّا وريقا طيبا وفما",54,"م",2,0],["منك في الشام رحلة عاقني عن","ه من الحظِّ مخلف الأسباب",55,"ب",1,0],["من كفك الدهر في جدب ومُعترك","لا يُمسكان نوالٌ هاطلٌ ودَمُ",56,"م",1,0],["من كفِّ مأمول الرغائبِ شأنهُ","غَفْرُ العظيمة واحتمالُ المَغْرَمِ",57,"م",1,0],["من كفه بحر وشعلة قابس","صمصامه لله كيف تألفا",58,"ف",2,0],["من كفّ أهيفَ كالقضيبِ يهز","زهُ تيهُ الشبيبةِ أو مهاةٍ مغزل",59,"ل",1,0],["من كفّ كفَّ المحل عن","عرينه عزماً وشلّ",60,"ل",1,0],["مَن كفّ أيدِيَ أقوامٍ به عبثوا","وردّهنّ بما يكرهن من شَلَلِ",61,"ل",1,0],["مِن كَفِّ أَحوَرَ ذي دَلالٍ شادِنٍ","يَسبي العُقولَ بِقَدِّهِ المَمشوقِ",62,"ق",1,0],["مِن كَفِّهِ إِصدارُ النَ","عيمِ وَالإيرادُ",63,"د",1,0],["منك فيه يسيل كوثر روح","فتراه السكران من رشفاتك",64,"ك",1,0],["من كفوف الهزبر وال","ناب ما واقعي نجا",65,"ج",2,0],["مِنْ كَفِّ مَيَّاسِ القَوَامِ كَأَنَّهُ","رَيْحَانَةٌ رَيَّانَةٌ لَمْ تَذْبُلِ",66,"ل",1,0],["مِنْ كَفِّ أَغْيَدَ فِي رُنُوِّ","وَفِي احْوَرَارٍ وَفِي نِفَارِ",67,"ر",1,0],["مِن كَفّ أغيَدَ في خدَّيهِ مَفسَدَةٌ","مِن حُمرَةِ الورد أو مِن خُضَرةِ الآس",68,"س",1,0],["مِنْ كَفِّ بارِعَةِ الجَمال بَديعةٍ","تُربي عَلى الأوْطار والأطْوارِ",69,"ر",1,0],["مِنْ كَفِّ ظَبْيٍ كأنَّه قَمَرٌ","يدورُ مِنْ كأْسِها بِمِقْباسِ",70,"س",1,0],["مِن كَفِّ ظَبيٍ مِن بَني النَصارى","أَلبابُنا في حُسنَهِ حَيارى",71,"ر",2,0],["من كفِّ مصبوغ الأنامل لم تزل","ألحاظُه بدم القلوب مصبَّغه",72,"غ",2,0],["مَنْ كَفُّهُ تُزري السّحابَ بِجودِها","وَتَفيضُ فَيضَ البَحرِ في إِحسانِها",73,"ن",3,0],["من كفِّ أهيفَ جادَ لي","بالكَسرِ مِن طرفٍ كحيل",74,"ل",1,0],["من كف منخزل الأعطاف معتدل","حلو الشمائل مخلوقث من الملح",75,"ح",1,0],["من كف معتدل يجو","ر على المحبِّ إذا قضى",76,"ض",2,0],["من كفى الألف بالصواع وأرقى","بيسير الحليب جماء مهولا",77,"ل",2,0],["من كفاه الإله شر قريش","ليلة الدار حيث سنوا النصولا",77,"ل",2,0],["من كفى الألف بالصواع وأروى","ظمأ الجيش بالحليب اليسير",78,"ر",1,0],["مِنْ كَفْ مَعْسُولِ المَرَاشِفِ رِيقُهُ","أشْهَى إلَيَّ مِنَ الْمُدَامِ وَأعْذَبُ",79,"ب",1,0],["من كفى الألف بالصواع وأروى","بقليل الحليب سار وغادي",80,"د",2,0],["من كفاه الإله غورث لما","رام إطفاء نوره الوقاد",80,"د",1,0],["من كفى بالصواع ألفا وروّى","بيسير جيوشه استكثارا",81,"ر",2,0],["من كفاه الإله غورث لما","سل للفتك فوقه البتارا",81,"ر",2,0],["من كفى العين إذ شفاها برد","بعد قلع فأعجز النظارا",81,"ر",2,0],["مِن كَف ذي لعس شَهي ريقه","صافي الأَديم مؤدب وَمهذب",82,"ب",1,0],["من كف فكه وفك كفه","فذاك باب الذم عنه كفه",83,"ه",1,0],["مِنْ كَفِّ أَزْهَرَ وَضَّاحِ الجبينِ لَهُ","جودٌ إذا غالَبَتْهُ فاقةٌ غَلَبا",84,"ب",2,0],["من كفه تروي العفاة غليلها","وبزنده توري العلوم زنادها",85,"د",3,0],["من كف معشوق الدلا","ل ذي رضابٍ مسكرِ",86,"ر",1,0],["من كفِّ هيفاءِ القَوام كأنّما","عُصِرَت سلافُ الخَمرِ من وجَنَاتِها",87,"ت",3,0],["من كفه الفياض سحب رعدها","زمازم الصمصام في هام العدا",88,"ا",1,0],["من كفَ أغيَذ قد تضرَّخ كَفّه","من لونها أو خَدّه المُتَورد.",89,"د",1,0],["من كفِّ ريمٍ مَليحِ الدَّلِّ ريقَتُهُ","بعدَ الهُجوعِ كمسكٍ أوكتُفّاحِ",90,"ح",1,0],["من كفِّ ناعمَة البنان كأَنَّما","مَزَجت لنا بموَدّةٍ أَقداحَها",91,"ح",3,0],["من كفّه نبع الماء الزلال فعمّ","الجيش طهرا وريّا ليس فيه خفا",92,"ف",2,0],["مِن كَفِّ أَبلَجَ كَالصَباحِ مُهَفهَفٍ","فَضَحَ الغُصونَ رَشاقَةً وَتَأَوُّدا",93,"د",2,0],["من كف أغيد ما رقى إلا غدا","قلبي يطاوع ساحراً كذابا",94,"ب",2,0],["من كف غانية تركيةٍ تركت","ألحاظها العرَب العرباء أعجاما",95,"م",2,0],["من كفه كفت وكفت وكفت","نداً علا ونائلاً مهما تشرلا",96,"ر",3,0],["من كفّه وزكفت ماء جرى وكفت","به جيوشاً وذاك الماء كالديم",97,"م",1,0],["مَن كفّه سبّحت فيها الحصى وجرت","منها عيون زلال دونها الديم",98,"م",1,0],["من كفِّ ساقٍ إذا ما جاءنا فسقى","دعا إلى حُبّه أهواءَ مَن فَسقا",99,"ق",2,0],["من كفّ أهيف خوطيّ المعاطف أو","هيفاء عن غيرها يثني تثنيها",100,"ي",3,0],["من كفه الجود قد ناداه مقتبساً","افنق ولا تخشى من ذي العرش اقلالا",101,"ل",2,0],["من كف أحور طرف فاتر غنج","مهفهف مايس الأعطاف والقد",102,"د",1,0],["من كف اهيف بادى الغنج مبتسم","حلو الشمائل ظبي بين الوطف",103,"ف",1,0],["من كف عذراء لقد زينت","بالحسن لبس الشنف والقرطق",104,"ق",1,0],["من كف فياض اليدين يمينه","يمن ويسراه ندى ويسار",105,"