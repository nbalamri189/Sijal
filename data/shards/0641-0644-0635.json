{"poems":[[95,"ألشرق طال سباته الروحاني","https://www.aldiwan.net/poem11226.html","الكامل"],[85,"يا من تمد له الملوك أكفها","https://www.aldiwan.net/poem54343.html","الكامل"],[53,"يا ضارب المثل المزخرف مطريا","https://www.aldiwan.net/poem62844.html","الكامل"],[287,"تبنى الممالك بالوشيج الأسمر","https://www.aldiwan.net/poem32790.html","الكامل"],[942,"","https://poetry.dctabudhabi.ae/diwan/poem/123694","الخفيف"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71036","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53174","الخفيف"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145062","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69907","البسيط"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123866","الخفيف"],[5413,"الحب","https://www.poetsgate.com/ViewPoem.aspx?id=208710",""]],"verses":[["فَلِصُنْعِكَ المَشْكُورِ أَكْرِمُ مَوْقِعٍ","مِنْ كُلِّ قَلْبٍ فِي بَنِي عَدْنَانِ",0,"ن",1,0],["فلصاحب الصفراء فخر خالد","يَحظَى به من صاحب الحمراء",1,"ا",2,0],["فلصدرِهِ من ذاك شرُّ بِطانة","ولقلبه من ذاك شر سُعارِ",2,"ر",1,0],["فَلِصَخرَةِ البَيتِ المُقَدَّسِ كُفؤُها","الحَجَرُ المُفَضَّلُ عِندَ أَفضَلِ مَعشَرِ",3,"ر",1,0],["فلصدر الشريف منا زفير","ولقلب التقيّ فينا وجيب",4,"ب",1,0],["فلِصُورِتي منها لها في ذاتها","عَقْلٌ ومعقولٌ يُعَدُّ وعاقِلُ",5,"ل",1,0],["فلصبري حلم عن العذل إذ","يدعى إليه وللدموع جهاله",6,"ل",2,0],["فلصالح الأعمال جدوا واعملوا","إن الخلود لصالح الآثار",7,"ر",1,0],["فَلصحةِ الأَبدانِ كنزاً قَد حَوى","عَمَلاً وَعلماً جمَّلتهُ مَناقِبُ",8,"ب",1,0],["فل صبح البياض ليل صباءي","وأشبّ المشيب في الفود ناره",9,"ر",2,0],["فلصوته الأزليِّ في أعماقنا","أثرٌ يُجنِّبُنا الحروب قليلا",10,"ل",2,0]]}