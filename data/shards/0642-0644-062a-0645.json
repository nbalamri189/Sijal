m/81234","الخفيف"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133156","البسيط"],[4501,"","https://poetry.dctabudhabi.ae/diwan/poem/100705","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72623","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72504","الرمل"],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101937","الرجز"],[4755,"مَرَّ قِربِي.. كَأَنّهُ كانَ حُلْمَا","https://www.poetsgate.com/ViewPoem.aspx?id=197774",""],[4767,"حديث القلب","https://www.poetsgate.com/ViewPoem.aspx?id=181101",""],[4797,"يالعقاب","https://www.poetsgate.com/ViewPoem.aspx?id=51280",""],[4830,"كأسُ الصِّبا","https://www.poetsgate.com/ViewPoem.aspx?id=201652",""],[4862,"من ربى الطائف جاءت كالندى","https://www.poetsgate.com/ViewPoem.aspx?id=118842",""],[4987,"قبل اسافر","https://www.poetsgate.com/ViewPoem.aspx?id=49555",""],[5145,"آه للمكرمات والآداب","https://www.poetsgate.com/ViewPoem.aspx?id=108242",""],[5183,"مُلْغِزَه رق680م","https://www.poetsgate.com/ViewPoem.aspx?id=186402",""],[2365,"سلم على قبر الحسين وقل له","https://www.poetsgate.com/ViewPoem.aspx?id=200650",""],[5409,"ساعة التوديع قالت","https://www.poetsgate.com/ViewPoem.aspx?id=155519",""],[5411,"سَبَّحَ الشِّعْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=190638",""],[5411,"ما مَضى قدْ مَضى","https://www.poetsgate.com/ViewPoem.aspx?id=191214",""],[5525,"وسيم الناس","https://www.poetsgate.com/ViewPoem.aspx?id=7253",""],[5561,"نجمة الليل","https://www.poetsgate.com/ViewPoem.aspx?id=193221",""],[5596,"طبع الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=205611",""],[5606,"قلت للدنيا عسى بكره تزين","https://www.poetsgate.com/ViewPoem.aspx?id=198734",""],[5628,"وداعاً أيتها البسمة","https://www.poetsgate.com/ViewPoem.aspx?id=178491",""],[5672,"سيان!!!","https://www.poetsgate.com/ViewPoem.aspx?id=206402",""],[5691,"روابي","https://www.poetsgate.com/ViewPoem.aspx?id=206590",""],[5691,"شحرور القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=206593",""],[5736,"وجع الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=208185",""],[5756,"السفينة","https://www.poetsgate.com/ViewPoem.aspx?id=5180",""],[5783,"إنما \"هند\"إسم كل جميل","https://www.poetsgate.com/ViewPoem.aspx?id=53716",""],[5790,"زار والصبح قد تبسم والجو","https://www.poetsgate.com/ViewPoem.aspx?id=111988",""],[5906,"مَرَّ بي","https://www.poetsgate.com/ViewPoem.aspx?id=188228",""],[192,"مصر","https://www.poetsgate.com/ViewPoem.aspx?id=16376",""],[6038,"نون 2003","https://www.poetsgate.com/ViewPoem.aspx?id=25700",""],[6056,"كفيّ ، طوّ قت معصمه","https://www.poetsgate.com/ViewPoem.aspx?id=130137",""],[6084,"يا فقيدا أصبح الدين به","https://www.poetsgate.com/ViewPoem.aspx?id=170849",""],[6102,"يَفعَلُ البُعدُ ..","https://www.poetsgate.com/ViewPoem.aspx?id=185335",""],[6113,"نوال","https://www.poetsgate.com/ViewPoem.aspx?id=12877",""],[2588,"شاخصة ( صديقٌ يعض)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65621&r=&rc=53",""],[5190,"حكايتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78304&r=&rc=17",""],[572,"ضَحِكَتْ من مشيبة ٍ ضَحِكَتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9423&r=&rc=280",""]],"verses":[["قُلتُ ما أَمنُ مَن عَلى الرَأسِ مِنهُ","صارِمُ الجَدِّ في يَدِ الأَيّامِ",0,"م",1,0],["قلتُ مهْلاً لا تُروَّعُ إنّما","هيَ منْ دمْعٍ لَلالِئٌ أخَرْ",1,"ر",1,0],["قُلتُمْ وَصَدَّقَ مَا قُلتُمْ تَحَمُّلُكُمْ","أَذَى يَرُدُّ فِرِنْدَ الصَّبْرِ مَثْلُومَا",2,"م",2,0],["قلت ماه غير غرّا","منّها تشرق الأنوار",3,"ر",1,0],["قُلتُم بِبُرقَةِ رَحرَحانَ لِمَعبَدٍ","لا تَدعُنا وَتَرَبَّصِ المِقدارا",4,"ر",2,0],["قُلتُمُ بَدِّل فَقَد بَدَّلَكُم","سَنَةً حَرّى وَحَرباً كَاللَهَب",5,"ب",1,0],["قلت من النيك ما رأى بصري","خيراً ولكن رأيت منقارا",6,"ر",2,0],["قلت ما هذا السواد المنتحى","قال حرف جاء في الحسن لمعنى",7,"ن",2,0],["قلت من أنت يا غزال فقالت","أنا من لطف صنعة الخلاق",8,"ق",1,0],["قلتُ ميلي إلى القرودِ بصُغْرٍ","ليس لفْقُ النِّكالِ غيرَ النكالِ",9,"ل",1,0],["قلتُ مهلاً ستلتقي الشمس والبد","رُ فكَمْ يُطْلِعانِ من سَعْدين",10,"ن",1,0],["قلت من أنت أيها الشرهُ النذ","لُ شهودي عليه آثار رُدنه",11,"ن",2,0],["قُلتُ مَهلاً إِذا ضَلَلت وَعُذراً","رُبَّما أَخطَأَ الحَكيم وَضَلّا",12,"ل",2,0],["قُلتُم فُلانٌ قَد سَلا","ما كانَ ذاكَ وَلا يَكونُ",13,"ن",1,0],["قُلتُ مَتى ذاكَ وَأَنّى لَهُ","وَكَيفَ يَنسى لَذَّةَ الكاسِ",14,"س",1,0],["قُلتُ مَتى تَرحَمُني","قالَ وَلا طولَ الأَبَدْ",15,"د",1,1],["قلت ما هكذا المواثيق قالت","ليس للغانيات من ميثاق",16,"ق",1,0],["قُلتُ ما واديهِ قالَ الشَجوُ واد","لَيسَ فيهِ مِن حِجازٍ أَو عِراق",17,"ق",1,0],["قُلتُ ما هَكَذا المَواثيقُ قالَت","لَيسَ لِلغانِياتِ مِن مِثاقِ",18,"ق",1,0],["قُلتُ مُروءاتُ أَهلِ الأَرضِ كُلِّهِمُ","إِلّا الأَقَلُّ فَلَيسَ العَشرُ مِن عَشَرَه",19,"ر",2,0],["قل تمهل واصطبر","سَكِّن خفوقَكَ واستقر",20,"ر",1,1],["قلتُ ما الليلُ إذْ سجا قالَ شعري","قلتُ والفجرُ قالَ ضوءُ جبيني",21,"ن",2,0],["قلتُ ما المرسلاتُ قالَ لحاظي","قالَ ما الذارياتُ قلتُ جفوني",21,"ن",2,0],["قلتُ مكاني عامرٌ والذي","بدَّلْتَهُ مَرْبَعُهُ قَدْ خلا",22,"ل",2,0],["قُلتُ مَن أَنتُمُ فَصَدَّت وَقالَت","أَمُبِدٌّ سُؤالَكَ العالَمينا",23,"ن",2,0],["قُلتُ مَن هَذا فَقالَت بَعضُ مَن","فَتَنَ اللَهُ بِكُم فيمَن فَتَن",24,"ن",1,0],["قُلتُ مَهما تَجِدي بي فَإِنّي","أُظهِرُ الوُدَّ لَكُم فَوقَ ذاكا",25,"ك",2,0],["قُلتُ ما بالُنا جُفينا وَكُنّا","قَبلَ ذاكَ الأَسماعَ وَالأَبصارا",26,"ر",2,0],["قُلتُ ما جَشَّمتِنا مِن حُبِّكُم","يا اِبنَةَ الخَيرَينِ أَدهى وَأَمَر",27,"ر",1,0],["قُلتُ مَن هَذا فَقالَت هَكَذا","أَنا مَن جَشَّمتَهُ طولَ السَهَر",28,"ر",1,0],["قُلتُ مَن أَنتِ فَقالَت أَنا مَن","شَفَّهُ الوَجدُ وَأَبلاهُ الكَمَد",29,"د",1,0],["قُلتُ ما حُبُّها عَلَيَّ بِعارٍ","إِن مُحِبٌّ يَوماً مِنَ الدَهرِ باحا",30,"ح",2,0],["قُلتُ مَهلاً عَفواً جَميلاً فَقالَت","لا وَعَيشي وَلَو رَأَيتُكَ مِتّا",31,"ت",2,0],["قلتم قَضَى حاجاتِهِ وخَلاَ لنا","فَبَدَارِ إنّا معشرٌ لا نُغلبُ",32,"ب",1,0],["قلتُم الحربُ وقتلاها وما","هِي بالأمرِ الأحبِّ الأخلق",33,"ق",1,0],["قلتم رُويداً فإنّا لا يُصابُ لنا","كُفؤٌ إذا ما التقى الجمعانِ فاقتتلا",34,"ل",2,0],["قُلت مَسا الخَير هَل لملتجئ","لديك نَعمى هَيهات يَكفرها",35,"ر",3,0],["قُلت مِن هُنّ وَقَولي","كانَ جَهلاً وَجُنونا",36,"ن",2,0],["قلتُ مِنْها ودُرْتُ أنظرُ حوْلي","نظراتِ الملهوفِ يُسرى ويُمنى",37,"ن",2,0],["قُلتُ مَهلاً فَقَد عَلِمتِ إِبائِي","مِنكِ هَذا وَقَد عَلِمت جَوابي",38,"ب",2,0],["قلتُ ما تَكْرَهِينَ منه فقالت","أَيُّ بُخْلٍ فيه وأَيّ قَتَارَهْ",39,"ر",2,0],["قُلْتُ مَهْلاً فما بِمِلحِ السَّقَنْقُو","رِ أُدَاوِي وَلا بِلَحْمِ الذُّرورِ",40,"ر",1,0],["قلتم فأُصمِتَ ناطِقٌ وصَمَتُّمُ","فبلغتمُ الإطنابا والإسهابا",41,"ب",2,0],["قُلتُمُ ذا الفَتكُ حَقّاً","لَيسَ ما نَحنُ عَلَيهِ",42,"ي",2,0],["قُلتُم لَنا خالِقٌ حَكيمٌ","قُلنا صَدَقتُم كَذا نَقولُ",43,"ل",1,1],["قُلْتُ مَتَى نَلْتَقي يَا سَيِّدي","قالَ غَداً نَلْتَقي عِنْدَ الصِّراطْ",44,"ط",1,0],["قلت مارست الشعر أرعى به الحق","قَ وقد لا يفوتني التصويرُ",45,"ر",1,0],["قلت مهلاً يا أيها الملك المُل","حِف مهلاً فإن هذا كثير",45,"ر",1,0],["قلت ما قلت ثم إنك لا تد","ري أحقٌّ ما قلته أم زور",45,"ر",1,0],["قلت من مات لا يصعِّر خداً","ليس بالموتى يخلق التصعير",45,"ر",1,0],["قلت ما لي بكل ذلك علمٌ","فبجحدي عقلي عليَّ يشير",45,"ر",1,0],["قلت ماذا يُبكي الجميلةَ قالت","أنا لا يبكيني اللظى والسعير",45,"ر",1,0],["قلتُ ماذا جنيتِ في الأرض حتى","كان حتماً عليك هذا المصير",45,"ر",1,0],["قلت ما شأنكم فقالوا دهانا","من وراء الهجاء ضرٌّ كثير",45,"ر",1,0],["قلت ماذا بكم فقالوا لقينا","من جزاءٍ ما لا يطيق ثبير",45,"ر",1,0],["قلتُ من أنتَ فلبَّاني مجيبا","نحن يا صاحِ غريبانِ هنا",46,"ن",2,0],["قلتُ ما أثْقَلَ الهَوَى","قَالَ ما للهَوى زِنَهْ",47,"ه",1,0],["قلت من يبدأ قالوا فابتدىء","أنت فالكلُّ لما تُلْقي ظِماء",48,"ا",2,0],["قلت من يعرِفُ علماً وحِجاً","وذَكاءً وسماحاً في رِداء",48,"ا",2,0],["قلت مهلا لا تروع إنما","هي من دمعي لآلىء غرر",49,"ر",1,0],["قلتم نؤيّد منعة استقلالها","لكنكم أيّدتم استبعادها",50,"د",3,0],["قلت : ما أوجب ذا الحزنَ وما","نسبةُ الوصلِ من الدمعِ المُذال",51,"ل",1,0],["قلتم نواصل قاطعتم بلا سبب","لا خير في القول ان ينقض بافعال",52,"ل",1,0],["قُلتُ مَن يَعرِفُ سَلمى","قالَ ها ثُمَّ تَعَلّى",53,"ل",2,0],["قُلْتُ مَاذَا مِنْ بَعْدِ خَوْضِ الرَّزَايَا","قَالَ: مَا تَشْتَهِي مِنَ الإِكْرَامِ",54,"م",1,0],