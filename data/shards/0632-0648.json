 إماما في الدين والمذهب الحق","https://www.aldiwan.net/poem54104.html","الخفيف"],[429,"هذا اللوى لا حط منه لواء","https://www.aldiwan.net/poem12549.html","الكامل"],[456,"أيقظني للبرقِ وهو نائم","https://www.aldiwan.net/poem55863.html","الرجز"],[456,"حماها أن تشل وأن تراعا","https://www.aldiwan.net/poem56121.html","الوافر"],[456,"كم النوى قد جزع الصابر","https://www.aldiwan.net/poem56172.html","السريع"],[456,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[456,"قل للزمان صلحا","https://www.aldiwan.net/poem56249.html","مجزوء الرجز"],[459,"جرد سيوفك للجلاد وأشهر","https://www.aldiwan.net/poem15128.html","الكامل"],[459,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"],[459,"تنبو الظبى والقنا حينا وآونة","https://www.aldiwan.net/poem16097.html","البسيط"],[459,"أرج النسيم فقلت نشر خميلة","https://www.aldiwan.net/poem16338.html","الكامل"],[462,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[462,"أمجادلي فيمن رويت صفاته","https://www.aldiwan.net/poem3161.html","عموديه"],[462,"لهفي على غصن النقا المتمايل","https://www.aldiwan.net/poem3200.html","عموديه"],[462,"نعم لقرى ضيف الحشى والأضالعِ","https://www.aldiwan.net/poem3285.html","عموديه"],[462,"نسيم الصبا حدث بمن سكن الأثلا","https://www.aldiwan.net/poem3429.html","عموديه"],[462,"تحدث البرق عن سعدي فما كذبا","https://www.aldiwan.net/poem3430.html","عموديه"],[462,"عاد مني الخيال طيف الخيال","https://www.aldiwan.net/poem3497.html","عموديه"],[468,"خمس دسسن إلي في لطف","https://www.aldiwan.net/poem4694.html","أحذ الكامل"],[477,"زوجي حسينة خففي لأوائي","https://www.aldiwan.net/poem37596.html","الكامل"],[498,"أهلا بليلى قد جلت هلالها","https://www.aldiwan.net/poem37710.html","الرجز"],[498,"لي في سماء الحمى الشرقي أقمار","https://www.aldiwan.net/poem38015.html","البسيط"],[512,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[549,"بأبي زائرا أتاني جنحا","https://www.aldiwan.net/poem47172.html","الخفيف"],[549,"ضن عني بالنزر إذ أنا يقظا","https://www.aldiwan.net/poem47194.html","الخفيف"],[549,"يا قاتلي إن كنت ترضي","https://www.aldiwan.net/poem47267.html","مجزوء الكامل"],[549,"شطت عليك لبانة الصدر","https://www.aldiwan.net/poem47783.html","أحذ الكامل"],[549,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[549,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[549,"أي فتى ووري في الترب","https://www.aldiwan.net/poem48059.html","السريع"],[560,"زوروا حمى بيعة كالنجم طالعة","https://www.aldiwan.net/poem52652.html","البسيط"]],"verses":[["زَوَّدتِني إِذ جِئتُكُم زائِراً","مِن حُبِّكُم قاصِمَةَ الظَهرِ",0,"ر",1,0],["زوّدْتَهُ برضاكَ عنْدَ وَداعِهِ","والهوْلُ قد ماجَتْ لديْكَ بِحارُهُ",1,"ر",2,0],["زَوْجُ سليمٍ إِلَيْهِ آبَت","وَفِيَّة طَلْقَةَ المُحَيَّا",2,"ي",2,1],["زَوْجٌ يَعِي لِلَّتِي تُشَاطِرُهُ","حَيَاتَهُ بِالعُهُودِ وَالذِّمَمِ",3,"م",1,0],["زَوْجُهُ البِرَّةُ الَّتِي أَوْفَتِ العَ","هْدِ بِصُدْقِ الهَوَى وَرَعْيِ الذِّمَامِ",4,"م",1,0],["زَوْجَانِ بُورِكَ فِيهِمَا وَعَلَيْهِمَا","كَفُؤَانِ فَلْيَسْعِدْهُمَا الإِكْلِيلُ",5,"ل",1,0],["زواهر في أفق العلاء تطلعتْ","يشابِهُ بعضٌ بعضَها ويُشاكلُ",6,"ل",1,0],["زوروا يَزيدَ فَإِنَّ اللَهَ فَضَّلَهُ","وَاِستَبشِروا بِمَريعِ النَبتِ مَحبورِ",7,"ر",1,0],["زَورٌ أَلَمَّ بِنا يَمشي عَلى وَجَلٍ","في الخَصرِ مِنهُ وَفي الكَشحَينِ تَهضيمُ",8,"م",1,0],["زورٌ عفيفٌ على عينِ الشجيِّ مشى","فيا لَهُ صالحاً يمشي على الماء",9,"ا",2,0],["زوجتنا حماة نعمى يديه","فغدى كلنا يحبّ حماته",10,"ت",2,0],["زوائرَ في كلِّ ما جُمعةٍ","قُبوراً أقمنَ بدار البِلى",11,"ا",1,0],["زَوْلٌ يقسِّمُ أمراً واحداً شُعَباً","وقادرٌ أن يَضمَّ الأمرَ ذا الشُّعَبِ",12,"ب",1,0],["زوالُ أصول الناسِ قبل فروعهم","وتلك وهذي غيرُ ذات ثباتِ",13,"ت",1,0],["زوَّجَهُ الدهرُ على سِنِّه","زمرُدةً صادقة الوعدِ",14,"د",1,0],["زُوِّج شيخ لنا عجوزاً","تُزهَى بطست لها وتَوْرِ",15,"ر",1,1],["زُوِّجتَ نُعمى لم تكن كفأها","فصانها الله بتطليق",16,"ق",1,0],["زَوجَةُ أَشمَطَ مَرهوبٍ بَوادِرُهُ","قَد كانَ في رَأسِهِ التَخويصُ وَالنَزَعُ",17,"ع",1,0],["زوروا ثَراه وَاِستَمِدّوا قُوَّةً","مِنهُ فَكَم أَحيا الهَوى التَذكارُ",18,"ر",1,0],["زَوى نَفسَهُ كَي لا يَرى الناسُ ضُرَّهُ","فَيَشمَتَ قالٍ أَو يُسَرَّ عَذولُ",19,"ل",1,0],["زَوِّدي الراحِلَ ماتَ وَجداً","بِالَّذي زَوّدَ الغَريقُ السَفينَه",20,"ن",2,0],["زَورَةٌ أَوجَبَها لي","مِنهُ وُدٌّ وَذِمامُ",21,"م",1,0],["زَورٌ مُغِبٌّ وَمَسؤولٌ أَخو ثِقَةٍ","وَسائِرٌ مِن ثَناءِ الصَدرِ مُنشورُ",22,"ر",1,0],["زوروا بُثَينَةَ فَالحَبيبُ مَزورُ","إِنَّ الزِيارَةَ لِلمُحِبِّ يَسيرُ",23,"ر",1,1],["زوديني قبلة مِن","كِ فقد حان الذهاب",24,"ب",1,0],["زوبعة والليل محلولك","وقد نأى الفلك عن الساحل",25,"ل",1,0],["زوالك بما لا تهنأ محضروه","يكون لعز مملكة زوالا",26,"ل",2,0],["زَورَقٌ في الدَمعِ يَطفو أَبَداً","عَرَفَ الضَفَّةَ إِلّا ما تَلاها",27,"ا",3,0],["زَوِّدينا مِن حُسنِ وَجهَكِ ما دا","مَ فَحُسنُ الوُجوهِ حالٌ تَحولُ",28,"ل",1,0],["زَوْرَةٌ ما شفَتْ غليلاً ولكنْ","علَّمتْ جمرةَ الفُؤادِ وقُودَا",29,"د",2,0],["زَوَّجْتُها ليقِلَّ عَتْبُ وُشاتِها","ويكونَ عندي صَفْوُهَا ومِزَاجُها",30,"ه",2,1],["زوَّدْتَنِي كُتُباً بموعِدها","قَرُبَ الغِنى وتمهَّدَ الرُّتَبُ",31,"ب",1,0],["زَورَةٌ سَكَّنَت غَليلاً وَقَد ها","جَت غَليلاً مِن هائِمِ مَشعوفِ",32,"ف",1,0],["زَوَت وَزيرَ السوءِ عَن مُلكِهِ","إِلى المَكانِ المُستَشَقِّ السَحيق",33,"ق",1,0],["زَواهِرُ نورٍ ما يَجِفُّ جَنِيُّها","وَأَنجُمُ لَيلٍ ما يُخافُ أُفولُها",34,"ل",3,0],["زَوّارُ أَرضِ الخالِعينَ إِذا غَزا","رَتَعَت وَراءَ رِماحِهِ الأَقلامُ",35,"م",1,0],["زَورَةٌ قُيِّضَت لِإيوانِ كِسرى","لَم يُرِدها كِسرى وَلا إيوانُه",36,"ن",2,0],["زَوَّرَ الشِّعْرَ والشَّبابَ فأَضْحى","خَلَقَ الوَجْهِ مُظْلِمَ الأَخْلاقِ",37,"ق",1,0],["زَوّالَةٌ ذاتُ إِبدالٍ بِصاحِبِها","تَرضى بِطارِفِها مِن تالِدٍ بَدَلا",38,"ل",2,0],["زَوَّجَ الماءَ ظالِماً بِعَجوزٍ","لَو أَطاقَت مَشَت عَلى عُكّازِ",39,"ز",1,0],["زَوَّجوني فَقُلتُ قولوا وَعُدّوا","لِأَسُدَّ الطَريقَ لِلمُجتازِ",39,"ز",1,0],["زَوَّجَ الماءَ بِاِبنَةِ العُنقودِ","فَاِنجَلَت في قَلائِدٍ وَعُقودِ",40,"د",1,1],["زَوَّجتَ أَبكارَ العِدى بِنُفوسِهِم","وَجَعَلتَ أَطرافَ الرِماحِ شُهودا",41,"د",2,0],["زورةٌ في معارجِ النور تلقى ال","وَحي فيها والشعرَ كالإسراءِ",42,"ا",2,0],["زوجه والبنون هُم","مجده والرجاء هُم",43,"م",1,0],["زُوّدوا كل ضربةٍ منه كالأخدو","دِ تُرْدي وطعنةٍ كالطويِّ",44,"ي",1,0],["زَوَّجتُ أَمري بِالسُعودِ فَأَصبَحَت","مِنهُ النُحوسُ النُكدُ وَهيَ طَوالِقُ",45,"ق",1,0],["زوجةُ مجدِ الدينِ والداها","في أَخذ عرضِ المجدِ أشبهاها",46,"ه",2,1],["زواحفاً نرتمي آناً وآونةً","مصعِّدين بأجواءٍ شواهينا",47,"ن",2,0],["زَوَيتِ العُرفَ وَالنائِ","لَ عَمداً غَيرَ ذي رُحمِ",48,"م",1,0],["زَوراً لَعَمري شَفَّ قَلبي ذِكرُهُ","سَكَنَ الغَديرَ فَلَيسَ مِن شَعبي",49,"ي",1,0],["زُورٌ يُردِّدُهُ الغَويُّ وباطلٌ","يشدو به من لا يعي ويُنادي",50,"ي",1,0],["زولوا فَقَد ضاقَتِ الدُنيا بِأَجمَعِها","عَمّا تَسوقونَ مِن تِلكَ المَعاذيرِ",51,"ر",1,0],["زولي فَما كُنتِ إِلّا غَمرَةً كُشِفَت","عَنِ النُفوسِ وَإِلّا مَأتَماً حُجُبا",52,"ب",2,0],["زولي إِلى مُغرِقٍ في البُعدِ مُنقَطِعٍ","لا يَستَطيعُ لَهُ مُستَعتبٌ طلبا",52,"ب",2,0],["زُولُوا بأنفسِكم فَتِلْكَ حُتوفُها","غَضْبَى إليها بالسُّيوفِ تُشِيرُ",53,"ر",1,0],["زوَّدت قومك خزياً لم يَدَعْ أحداً","إلا قلاك وأمسى صَدرهُ يَغِرُ",54,"ر",1,0],["زُولي مُعطِّلةَ العقولِ فمنَ قَضى","أنّ البصائرَ والعقولَ تُعطَّلُ",55,"ل",1,0],["زَوِّدينا نائِلاً أَو عِدينا","قَد صَدَقناكَ فَلا تَكذِبينا",56,"ن",2,1],["زَوَّجتُها الماءَ كَي تَذِلَّ لَهُ","فَاِمتَعَضَت حينَ مَسَّها الذَكَرُ",57,"ر",1,0],["زَورُ مُلوكٍ عَلَيهِ أُبَّهَةٌ","تَعرِفُ مِن شِعرِهِ وَمِن خُطَبِه",58,"ب",2,0],["زَوَّدوهُ طيباً لِيَلحَقَ بِالنا","سِ وَحَسبُ الدَفينِ بِالتُربِ طيبا",59,"ب",2,0],["زَوائِرُ بِالعَشيِّ وَمِزرُ شُربٍ","يُكَثِّرُ مَرزَياتِكَ وَالزَواري",60,"ي",1,0],["زَوجَةُ إِبراهيمَ سارَت إِلى","مَقامِ إِبراهيمَ في نَذرِها",61,"ر",3,0],["زَواكِ اللَهُ عَن جَنَفٍ وَظُلمٍ","فَشُكراً إِنَّ أَنعُمَهُ زَواكِ",62,"ك",1,0],["زَوانِيَ خَوفُ المَقامِ الذَمي","مِ عَن أَن أَكونَ خَليلَ الزَواني",63,"ن",2,0],["زولي فَإِن رُمتِ البَقاءَ لِحاجَةٍ","تَبغينَ بَعدُ قَضاءَها فَتَلَثَّمي",64,"م",2,0],["زوجان ما أَسمى مقا","مَهما العَفيفة وَالعَفيف",65,"ف",1,0],["زوجان كل منهما","لحليله قد كان ندا",66,"د",2,0],["زوَّجوها من غير ما هي ترضى","من غلام غمر أخي سيئات",67,"ت",1,0],["زوبعة شَديدة","تأَتي وَراء زوبع",68,"ع",1,0],["زواها الدهرُ لم تسعَدْ","من الإشراقِ باللمحِ",69,"ح",1,0],["زوَتهُ عنها السنون السبعُ واختلفتْ","عليه من بعدها نُعْمَى وبأساءُ",70,"ا",2,0],["زُوَّارُهَا مِلْءُ الزَّمَانِ وَلَمْ يَكَدْ","فِيْ رَحْبِها يَتَرَاحَمُ الزُوَّارُ",71,"ر",1,0],["زوجي يحارب في التخوم وطفلتي","فوق الفراش تزيد في إرهاقي",72,"ق",2,0],["زَواني عَمى عَينَيَّ عَن آفَةِ الهَوى","لَعَلَّ عُيونَ الناظِرينَ زَواني",73,"ن",2,0],["زَواكَ دَهري فَفَلَّ رُكني","وَفَلَّ صمصامَتي الصُراطا",74,"ط",2,1],["زواملُ لم يوِّقْهُنّ ليلٌ","ولم يُثْقِلْ كواهلَهُنّ حِمْل",75,"ل",1,0],["زورقٌ شق في الهواء طريقًا","فكأن الهواء صار عبابا",76,"ب",2,0],["زوجتي سوفَ تستفيقُ من النومَ","صَباحاً فما تَرانيَ وَهْنا",77,"ن",2,0],["زوجتي ما اقترفتُ إثماً ولكنْ","كيفما شاءتِ النواميسُ كُنّا",77,"ن",2,0],["زوجتي أوسِعي النزاهةَ ما اسطعتِ","سِباباً وأوسعى الحقَ لَعْنا",77,"ن",2,0],["زوى الشعبُ عنه خيرَه ورفاهَه","فلو سِيمَ فَلْساً بالبلاد لباعا",78,"ع",2,0],["زَوْرَةٌ سَكّنَتْ غَليلاً، وَقَدْ ها","جَتْ غَليلاً مِنْ هَائِمٍ مَشْغُوفِ",79,"ف",1,0],["زُوّجت نُعمى لم تكن كفؤها","فصانها اللَّه بتطليق",80,"ق",1,0],["زورا بثينة ، فالحبيبُ مزورٌ،","إنّ الزيارة َ، للمحبِّ، يسيرُ",81,"ر",1,1],["زواملُ لم يُعِّوقْهُنّ ليلٌ","ولم يُثْقِلْ كواهلَهُنّ حِمْل",82,"ل",1,0],["زولي فإن رمت البقاء لحاجة ٍ","تبغين بعد قضاءها قتلثمي",83,"م",2,0],["زوج المخزيات لديه حتى","تباع اليه بالثمن الربيح",84,"ح",1,0],["زوج البتول ومحبوب الرسول ومص","باح القبول وحصن الا من في الوجل",85,"ل",1,0],["زوابع الهجر ان تجرى على جبل","لا شك من لب قعر الارض تنسفه",86,"ف",2,0],["زوى العزم عن ليلى وسلمى وزينب","وراح على صدق الى الله هاربا",87,"ب",2,0],["زوديني منه بطرفةِ عينٍ","إن قلبي في سكرة وخُفُوقِ",88,"ق",1,0],["زواهرُ أمثال الأهلّةِ وُضَّحُ","حِسان التَّثنِّى دونها الأنجمُ الزُّهْرُ",89,"ر",1,0],["زوروا الذي لجميلكمْ","قبل الزيارة يعترفْ",90,"ف",1,1],["زوَّج اللهوُ يابنةِ العنقودِ","خاطباً بالبسيط أو بالنشيدِ",9