{"poems":[[55,"أما ذعرت بنا بقر الخدور","https://www.aldiwan.net/poem30468.html","الوافر"],[88,"قد غفونا وانتبهنا فإذا","https://www.aldiwan.net/poem10358.html","الرمل"],[88,"رباك والدك الكريم على التقى","https://www.aldiwan.net/poem68935.html","الكامل"],[39,"لقينا بها ثلبا ضريرا كأنه","https://www.aldiwan.net/poem6425.html","الطويل"],[23,"أولئك قومي فإن تسألي","https://www.aldiwan.net/poem21241.html","المتقارب"],[74,"بطيفك يا بدر والطارق","https://www.aldiwan.net/poem19351.html","المتقارب"],[93,"روحي التي بالأمس كانت ترتع","https://www.aldiwan.net/poem8723.html","عموديه"],[72,"ضمنتها حمدا وشكرا","https://www.aldiwan.net/poem42887.html","مجزوء الكامل"],[94,"أتفنى ابتسامات تلك الجفون","https://www.aldiwan.net/poem38959.html","المتقارب"],[13,"لما رأيت بني نفاثة أقبلوا","https://www.aldiwan.net/poem2191.html","الكامل"],[52,"لقد زادني ما تعلمين صبابة","https://www.aldiwan.net/poem64860.html","الطويل"],[111,"أبلغ إليك رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=536",""],[112,"ماني نبي","https://www.poetsgate.com/ViewPoem.aspx?id=36760",""],[112,"غني بربي","https://www.poetsgate.com/ViewPoem.aspx?id=8379",""],[154,"اعد ذكر خير الخلق فالعود أحمد","https://www.aldiwan.net/poem68577.html","الطويل"],[170,"أنت الذي أوليتني مننا","https://www.aldiwan.net/poem46905.html","أحذ الكامل"],[203,"نفرت والظباء ذات نفار","https://www.aldiwan.net/poem45535.html","الخفيف"],[234,"دعا دمعهن فراق فجادا","https://www.aldiwan.net/poem51168.html","المتقارب"],[242,"أكلنا يوم لمطتنا المريه","https://www.aldiwan.net/poem19753.html","الوافر"],[368,"فنشناهم بأرماح طوال","https://www.aldiwan.net/poem1741.html","الوافر"],[369,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[409,"لا والغرام وما تجن الأضلع","https://www.aldiwan.net/poem33683.html","الكامل"],[458,"يا ابن الخصاصة حين تحسب عزة","https://www.aldiwan.net/poem61389.html","الكامل"],[482,"ما الدمع بعد نوى الأحبة عار","https://www.aldiwan.net/poem15339.html","الكامل"],[511,"ويوم تضوع الشمس حليا بحسنه","https://www.aldiwan.net/poem2471.html","الطويل"],[520,"لك أن تقول إذا أردت وتفعلا","https://www.aldiwan.net/poem12207.html","الكامل"],[543,"أتينا على البشا التهامي على شوق","https://www.aldiwan.net/poem47543.html","عموديه"],[556,"من عذيري من سقام","https://www.aldiwan.net/poem48076.html","مجزوء الرمل"],[592,"على الدين فليبكي ذوو العلم والهدى","https://www.aldiwan.net/poem11555.html","عموديه"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107260","المتقارب"],[721,"","https://poetry.dctabudhabi.ae/diwan/poem/146933","السريع"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87009","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77627","الرجز"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138184",""],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56131","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55983","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56032","الكامل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78029","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79809","المتقارب"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48910","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48961","الوافر"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102069","الوافر"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141294","الكامل"],[2027,"","https://poetry.dctabudhabi.ae/diwan/poem/101856","الرمل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102113","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93620","الكامل"],[2610,"","https://poetry.dctabudhabi.ae/diwan/poem/22593","الخفيف"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107172","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133968","الرجز"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133965","الرجز"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68018","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68005","البسيط"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131989","الوافر"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123545","الرجز"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85265","الطويل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128917","المتقارب"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76462","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111447","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77141","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86356","الرمل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94580","البسيط"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33070","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133086","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139704",""],[4984,"من رواق جميل بثينة","https://www.poetsgate.com/ViewPoem.aspx?id=175550",""],[5111,"عَشْتَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=212606",""],[5121,"خميلتي","https://www.poetsgate.com/ViewPoem.aspx?id=33597",""],[5285,"هي الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=203541",""],[592,"ألا فذراني من جهول وغاشم","https://www.poetsgate.com/ViewPoem.aspx?id=128817",""],[592,"تلألأ نور الحق في الخلق وانتشر","https://www.poetsgate.com/ViewPoem.aspx?id=128721",""],[5693,"فمشكاتي ومصباحي .","https://www.poetsgate.com/ViewPoem.aspx?id=34850",""],[5725,"امنية","https://www.poetsgate.com/ViewPoem.aspx?id=191275",""],[4623,"كتمت الهوى لكن نحولي به باحا ومن (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146769",""],[5776,"انتحارُ عرّافة","https://www.poetsgate.com/ViewPoem.aspx?id=199330",""],[5910,"ماذا يقولُ الشِّعرُ","https://www.poetsgate.com/ViewPoem.aspx?id=206521",""],[5956,"من أركان الإيمان","https://www.poetsgate.com/ViewPoem.aspx?id=192592",""],[6265,"المهاجرة اليمنية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84177&r=&rc=0",""]],"verses":[["فَنَشرَبَ آجِنَ الغُدرانِ فيها","إِذا ما الذُلُّ حامَ عَلى النَميرِ",0,"ر",1,0],["فَنَشَدنا العَيشَ حُرّاً طَلَقاً","تَحتَ ظِلِّ اللَهِ لا ظِلِّ الأُمَم",1,"م",1,0],["فَنَشَأتَ بَينَ رِعايَةٍ وَعِنايَةٍ","وَدَرَجتَ بَينَ مَحامِدٍ وَمَفاخِرِ",2,"ر",1,0],["فنشنا له من ذي المزاود حصة","وللزاد آسار تلقى وتوهبُ",3,"ب",1,0],["فَنَشهَدُ أَنَّكَ عَبدُ المَليكِ","أُرسِلتَ نوراً بِدينٍ قِيَم",4,"م",1,0],["فنشكو فعال الزمان الغلام","لسيده الفاتق الراتق",5,"ق",1,0],["فَنَشَرتُ أَجنِحَتي وَحُمتُ عَلَيكِ","مُتَوَهِّماً أَنّي وَجَدتُ صَباحي",6,"ي",1,0],["فَنَشَرَتها حِبراً عَلَيَّ","نَشَرتَ لِيَ في الناسِ ذِكرا",7,"ر",2,0],["فَنَشْرَبَ مِنْ كلِّ نبعٍ شراباً","ومنهُ الرَّفيعُ ومنه الزَّهيدْ",8,"د",1,0],["فَنَشيتُ ريحَ المَوتِ مِن تِلقائِهِم","وَكَرِهتُ كُلَّ مُهَنَّدٍ قَضّابِ",9,"ب",1,0],["فَنَشفي فُؤادَينا مِنَ الشَوقِ وَالهَوى","فَإِنَّ الَّذي يَشفي المُحِبَّ حَبيبُ",10,"ب",1,0],["فنشبت في حلقي شجا","فغصصت بالماء القراح",11,"ح",1,0],["فن شفتني متعب هجوسي في رسم راس الضبي","ماهو علاشان أكسب أعجابات .. ريمان .. وهيا",12,"ي",2,0],["فن شفت أبن علوش يبكي فراقه؟","ترى أنحدارات الجبل من علوّه",13,"و",2,0],["فَنَشَقُهُ مِسكاً وَنَطعَمُهُ أَريا","وَلِلَّهِ مِنهُ عَطفُهُ وَسماحُهُ",14,"ه",1,0],["فنشرتُ مدحَكَ حسبَ مقدرتي","وعَلَكْتُ شُكركَ ملءَ أشْداقي",15,"ق",2,0],["فنشرنَ الكؤوسَ وانبعثَ الله","ووقامتْ قيامةُ الأوتارِ",16,"ر",1,0],["فنشَّرن ما قد طوتْ خُمْرُهنّ","لِيَلْبَسْن شعرَ النَّواصي حِدادا",17,"د",2,0],["فَنَشْكُرُ رَبَّنَا شُكْراً سَنِيّاً","يُسَنِّي الزَّيْدَ دَأْباً فِي الْعَطِيَّهْ",18,"ي",2,0],["فَنُشناهُم بِأَرماحٍ طِوالٍ","مُثقَّفَةٍ بِها نَفري النُحورا",19,"ر",2,1],["فنَشأتُم عليه طَبْعاً ولا يُشْ","بِهُ طَبْعاً تَكلُّفُ الأشياء",20,"ا",2,0],["فنش صدور كتابه تنظر بها","عقد المعاني بالبديع يرصع",21,"ع",1,0],["فنشأت كالراعي الشفيق على الورى","تستلهم الآلام والأكدارا",22,"ر",2,0],["فنشيدُها طربُ الحُداةِ وذكرُها","للَّيلِ يقطعُهُ بها السُّمارُ",23,"ر",1,0],["فَنَشربُها في وِردِهش وَهيَ عِندَنَا","ألذُّ مِنَ العَيشِ الهَنِيِّ وَأعذَبُ",24,"ب",1,0],["فنشأت يا شبل المظفر مثله","متخمطاً عبل السواعد أفتلا",25,"ل",2,0],["فنَشكُرُ منك الجُودَ والفضلَ والنَّدَى","ونُثِني ثَناءً في مَسِيره كالبَرقِ",26,"ق",1,0],["فَنَشِبْنا فيهم كُرْ","هاً وَما نَهوى النُّشوبا",27,"ب",2,0],["فنشكو إلى الله القلوب التي قست","وران عليها كسب تلك المآثم",28,"م",1,0],["فنَشرَبُ خَمراً عَلى رَوضِها","ونُنزِلُ دَهراً علَينَا تَعالى",29,"ل",2,0],["فنشرها في وقت نشرى لها","أذكى على الأنف من ندكا",30,"ك",2,0],["فَنشرت أَعلام الأَمان عَلى الوَرى","في تُونس الغَرّا وَخافَ الخاتل",31,"ل",1,0],["فَنَشَب السَهم وَقَلبه فَرى","وَلَم يَكُن يَنفَعُه ما وَفَّرا",32,"ر",2,0],["فنشقت الخلد من أنفاسها","ورشفت الحسن صرفا من لماها",33,"ا",3,0],["فنشدت فيه بيت شعرٍ منذراً","في قبحه للعال ثم الدونِ",34,"ن",1,0],["فنشدت فيه بيت شعرٍ نظمه","أبهى من الدر النفيس وابهرُ",35,"ر",1,0],["فنشدت لما رح طالع سعده","وبه قد ابتسم الزمان العابسُ",36,"س",1,0],["فَنش قَميصي لكي أَن تَذهَبَ الوَجَلا","فَهمَّ أَن يَقبض النهدين ما مَهلا",37,"ا",1,0],["فنشكو إليهم ولا يَعطفون","كشكوى العقيرةِ للعاقرِ",38,"ر",1,0],["فنشا ذلك اليتيم عصاميّاً","وأَعطى له النبوغُ السّرا",39,"ر",2,0],["فنشا على حبّ النُّهى فكأّنَّهُ","ورث المكارمَ طارفاً وتليدا",40,"د",2,0],["فنشهد منه خيرات","وينف الهم أحزانا",41,"ن",2,0],["فنشأت تحضنك الشّهامة والوفا","تأبى النّميمة عارفاً عقباها",42,"ا",3,0],["فنشأ شهما فطنا","وعلى هام الثريا يرتقي",43,"ي",1,0],["فنشُل منه في الأحيان","مدى الأوقات إخوانا",44,"ن",2,0],["فَنشم نَشر المسك حينَ نَشمها","وَنَزور دار الخُلد حينَ نَزورها",45,"ر",3,0],["فَنَشَرنا حَديثَنا","عِندَكُم كُلَّ مُنتَشَر",46,"ر",1,0],["فَنَشكُرُ بعدَ اللَّهِ قَرماً مُتَوَّجاً","أَيادِيه بادٍ كلَّ يَومٍ جَديدُها",47,"د",3,0],["فنشكر الله على انعامه","فضلاً بما نلناه من الهامه",48,"ه",1,0],["فنشكر المولى على ذي المنحه","كما لا هلينا كمال المدحه",49,"ه",1,0],["فنشربُ شاهيناً وألفُ ذبابة","تطنُّ عَلَيْهِ أَوْ وعشرون وُقَّع",50,"ع",1,0],["فنشأةُ السكونِ تطوير وتَوْطئة","كذاك من سَبَد قَدْ كَانَ أَوْ لَبَد",51,"د",1,0],["فنشط كل ذي أدب وعلم","فروض العلم قد أمسى يبابا",52,"ب",2,0],["فنَشْرهُ مِن الثَّناءِ نَفْحةٌ","يُثْنِى على المُزْنِ بها نُوَّارُهُ",53,"ه",1,0],["فنشكو إلى اللَه الزمان الذي استوى","لدى أهله قس الكلام وباقله",54,"ل",2,0],["فنشطتني تارة للهوى","وصيرتني تارة في خمول",55,"ل",1,0],["فَنشكو صَنيعا اتينا به","وَتغري عَلى الفتك اخلاقها",56,"ه",2,0],["فَنشَاطُهُ وثَبَاتُهُ ما أَغنَيا","أَن عادَ مُنثِينياً بِغَيرِ تَهادي",57,"د",2,0],["فَنَشكُرُ مَولىً أَبدَلَ الكَدَّ راحَة","وَبِالخَوفُ أَمناً شامِلَ الريعِ وَالوَهدِ",58,"د",1,0],["فنشا أغيد غضاً مترفا","بأبي من ناشئ ذي قرطق",59,"ق",1,0],["فِنٌّ شريفٌ عفيفٌ منصفٌ ورِعٌ","رحوم خلق وفي التدقيق باصرهُ",60,"ر",2,0],["فَنَشا بِغارِ مُظلِمٍ أَرجاؤُهُ","لا الريحُ تُصرِدُهُ ولا بَردُ الشِتا",61,"ا",1,0],["فنشكر الله رب العرش خالقنا","الجامع الشمل من قبل انقضا العمر",62,"ر",1,0],["فنشرت الأسى كنشر علاهم","وعلى وجدهم طويت الضلوعا",63,"ع",2,0],["فنشيدنا نغم تتابع وقعه","فكأن حاديه الحزين حياليا",64,"ل",3,0],["فَنَشِيْدِيْ ضَاقَ ذِرْعًا بِحُرُوفِيْ","بَيْنَ ظَنٍّ وَاغْتِرابٍ وَارْتِحَالِ",65,"ل",1,0],["فنشيدُها مَلَكُ الحنان ِبدارنا","عَبقُ النّقاء ِيهيمُ صَوْبَ محطتي",66,"ت",2,0],["فنشربُ من عيونِ الحُلمِ","خمرتَنا بلا وَسَنِ",67,"ن",1,0],["فنشهدكم بل نشهد الله أننا","بهذا ندين لله بين العوالم",68,"م",1,0],["فنشهد أن الله جلى بذاته","على عرشه من فوق سبع قد استقر",69,"ر",1,0],["فنشربها بذائقة","وتنفحنا بإفصاح",70,"ح",1,0],["فنشرت في كل القلوب اغانيا","والموجعات رواسيا لا تستريح",71,"ح",1,0],["فنشرب منك الراح بالراح جهرة","فراحك كل الهم عنا بها راحا",72,"ح",2,0],["فنشربُ من مواقدِنا رماداً","عسى عرّافةٌ نفثتْ..... خُرافهْ",73,"ف",2,0],["فنشرتِ شرع اللهِ بعد نبيِّهِ","وأبوكِ تحت لوائه مضَّاءُ",74,"ا",2,0],["فنشهد لا إلهاً غير ربي","وأنّ رسول عالَمِنا محمّدْ",75,"د",1,0],["فنشأنا كما تشاءُ الليالي","وكبرنا والعمرُ مازال طفلا !",76,"ل",2,0]]}