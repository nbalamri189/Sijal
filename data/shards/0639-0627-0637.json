","https://poetry.dctabudhabi.ae/diwan/poem/78309","الكامل"],[4091,"","https://poetry.dctabudhabi.ae/diwan/poem/141837","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127322","الرمل"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105118","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90741","الخفيف"],[4210,"","https://poetry.dctabudhabi.ae/diwan/poem/111196","الخفيف"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45131","الرمل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81722","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83135","المديد"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77689","الرمل"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105192","الرمل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76729","الكامل"],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/199652","الرجز"],[4748,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=6662",""],[4764,"عاطل عن الإحساس","https://www.poetsgate.com/ViewPoem.aspx?id=32324",""],[5042,"ليذهبوا في ملامي أية ذهبوا","https://www.poetsgate.com/ViewPoem.aspx?id=211626",""],[5136,"يا بروحي المدلل البتاه","https://www.poetsgate.com/ViewPoem.aspx?id=121772",""],[5136,"صافحت ريح الصبا روض الخزامى","https://www.poetsgate.com/ViewPoem.aspx?id=121655",""],[5324,"أنا لا أسميه شيا","https://www.poetsgate.com/ViewPoem.aspx?id=207173",""],[5362,"زارني عند غفلة الرقباء","https://www.poetsgate.com/ViewPoem.aspx?id=170368",""],[6031,"عَاطِنيها قبلَ ابتِسَامِ الصَّبَاحِ","https://www.poetsgate.com/ViewPoem.aspx?id=46257",""]],"verses":[["عاطِياتٍ بَل عاطِلاتٍ وَما أَغ","نى الدُمى عَن قَلائِدٍ وَشُنوفِ",0,"ف",1,0],["عاطَيتُهُم مِن عُلالاتِ الكَرَى نُطَفاً","وَالسَيرُ يَرجُمُ جُلموداً بِجُلمودِ",1,"د",1,0],["عَاطَيْتُهُ رَاحاً مِنَ الأَدَبِ الَّذِي","مُزجَتْ سُلاَفَتُهُ بِصِرْفِ بَيَانِ",2,"ن",1,0],["عاطَيتُهُ صَهباءَ كَلَّلَ كَأسَها","حَبَبُ المِزاجِ بِلُؤلُؤٍ ما فُصِّلا",3,"ل",2,0],["عَاطِلٍ يَحْلَى مَتَى","تُلْقِي عَلَيْهِ نَظَرَ",4,"ر",1,0],["عاطيتني عنها الحديث كأنما","عاطيتني عنها كؤوسَ عُقارِ",5,"ر",1,0],["عاطيتني عنه الحديثَ كأنّما","عاطيتَني منه ابنهَ الجريالِ",6,"ل",1,0],["عاطرات الشميم تحسب فيه","نَّ شذاً من ثنا ابن شادٍ مُعارا",7,"ر",2,0],["عاطَيتُها في الكَأَسِ مِثلَ رُضابِها","تَسري إِلى قَلبِ الجَبانِ فَيَشجُعُ",8,"ع",1,1],["عاطِلاتٍ بَل حالِياتِ يُرَدِّد","نَ الشَجى في قَلائِدٍ وَعُقودِ",9,"د",1,0],["عاطَيتُها غَضَّةَ الأَطرافِ مُرهَفَةً","شَرِبتُ مِن يَدِها خَمراً وَمِن فيها",10,"ي",3,0],["عاطِنيها مَمزوجَةً بِالنَباتِ","مِن فَمِ الكيسِ لا مِنَ الكاساتِ",11,"ت",1,1],["عاطَيتُهُ وَحِجابُ اللَيلِ مُنخَرِقٌ","راحاً تُخَرِّقُ مِن لَألائِها الحُجُبا",12,"ب",2,0],["عاطى بِها الصَهباءَ أَحوى أَحوَرٌ","سَحّابُ أَذيالِ السُرى سَحّارُ",13,"ر",1,0],["عاطَيتُ ذِكرَ أَبي الحُسَينِ بِها السُرى","رَيحانَةً يَشَتَمُّها مِعطارا",14,"ر",2,0],["عاطِ أَخِلّاءَكَ المُداما","وَاِستَسقِ لِلأَيكَةِ الغَماما",15,"م",2,1],["عاطَيتُهُ شَمساً لَها في خَدِّهِ","شَفَقٌ أَعارَ الوَردَ حُسنَ لِباسِهِ",16,"س",2,0],["عاطِفَةً جيدها موسّدة","ذِراعَها وَالدُموع تَغمرها",17,"ر",3,0],["عاطيتُهُ كأساً كأنَّ شُعَاعَهَا","شمسُ النهارِ يُضيئهُ إشراقُهَا",18,"ق",3,1],["عاطِنيها كَما وَصَفتَ خَليلي","مَن يَدَي شادِنٍ رَخيمِ الكَلامِ",19,"م",1,0],["عاطِني كَأسَ سَلوَةٍ","عَن أَذانِ المُؤَذِّنِ",20,"ن",1,0],["عاطَيتُهُ وَضِياءُ الصُبحِ مُتَّصِلٌ","بِظُلمَةِ اللَيلِ أَو قَد كانَ يُضويها",21,"ي",3,0],["عاطَيتُها صاحِباً صَبّاً بِها كَلِفاً","حَرباً لِعايِفِها سِلماً لِحاسيها",22,"ي",3,0],["عاطِني كأساً زُلالا","ودع العذبَ الحلالا",23,"ل",2,1],["عاطفيُّ القصيدِ يعبثُ بالأل","بابِ أسلوبهُ الرشيقُ ويلعبْ",24,"ب",1,0],["عاطرُ البابِ معتمُ الرحباتِ","مثل خدّيكِ لونه المرجان",25,"ن",1,0],["عَاطِلَ الثَّوْبِ مِنْ كَوَاكِبِه الزُّهْ","رِ وَمِنْ سَيْفِهِ الطَّوِيلِ النِّجَادِ",26,"د",1,0],["عاطفٌ، عادلٌ، عزيزٌ، وعزمي","عِصْمَةٌ، عاصمٌ، عِمَادٌ، علاءُ",27,"ا",2,0],["عاطفاتٌ حُوَّمٌ عاجت على","أبْحُرِ الشعر فردتها ظماء",28,"ا",2,0],["عاطلاتٍ نساؤهم ونساء \" الشيخ \"","حُلِّينَ لؤلؤاً ونُضارا",29,"ر",2,0],["عاطى نباتُ الأرض ماءَ السما","مالا تُعاطيه كؤوسُ الرحيقْ",30,"ق",1,1],["عاطيتهافي الكأس مثل رضابها","تسري إلى القلب الجبان فيشجع",31,"ع",1,1],["عاطيته صهباءَ كللَّ كأسها","حببُ المزاح بلؤلؤٍ ما فصّلا",32,"ل",2,0],["عاطَيتُهُ بِنت الدَنان وَقَد شَدا","قَمَريُّ رَوض اللَهو فَوقَ غُصونِهِ",33,"ن",2,0],["عاطلًا يَلْوي بِلا شُغلٍ ولم","يَتَمَنَّ غَيرَ حُلْمِ السَّكَنِ",34,"ن",1,0],["عاطيتهم صهباءَ داريَّةً","قالوا واين الصابُ والعلقمُ",35,"م",1,0],["عَاطِلاتٍ حَلَّيْتُها بِسَجَايا","هُ الَّتي ذِكْرُها بِلا اسْتِغْفارِ",36,"ر",1,0],["عاطنيها ذوب تبر","واجلها في ثوب خمر",37,"ر",1,1],["عاطِنيها صِرفا ولا تُطفىء النّو","ر الذي زان حُسنَها بِالماء",38,"ا",2,0],["عاطيتُهم كأساتها مذ فَرَّقَت","كفُّ الصباح دُجُنَّةَ الإظلام",39,"م",1,0],["عاطِلَةٌ كَأَنَّها","ذِراعُ خودٍ عَيطَلِ",40,"ل",1,0],["عاطَيتُهُ كَرُضابِهِ مَشمولَةً","طافَت عَليَّ بِمِثلِها لَحَظاتُهُ",41,"ت",2,0],["عَاطِنَا خَمْرَةَ الْغِنَى مِنْكَ حَتَّى","لاَ نَخَافَ الإِعْسَارَ وَالتَّفْلِيسَا",42,"س",2,0],["عَاطِرٌ نَشْرُهُ كَنَشْرِ ثَرَاكُمْ","مَا حَوَى الْمَجْدُ قَبْرَكُمْ عِرِّيسَا",42,"س",2,0],["عاطنيه وغب بشربك سكراً","ثمّ خذه يا ذا الصبابة عنّي",43,"ن",2,0],["عاطرات النشر","ما هب قبول بقبول",44,"ل",1,0],["عاطَيْتُهُمْ كَأْسَ السُّرى فِي لَيْلَةٍ","أَمِنَ الظَّلامُ بِفَجْرِها أَنْ يُشْرِقا",45,"ق",2,0],["عاطَيْتَنِيها وَالمِزْاجُ يَرُوضُها","وَكَأَنَّها فِي الْكَأْسِ طِرْفٌ يَجْمَحُ",46,"ح",1,0],["عاطِنيها عَلى ثُغورِ أَقاحٍ","ضاحِكاتٍ وَنَرجِسِ الأَحداقِ",47,"ق",1,0],["عاطَيتُهُ كَأساً نِظامُ حَبابِها","شَملُ الهُمومِ بِهِ حَليفُ تَبَدُّدِ",48,"د",1,0],["عاطيتني السحرَ أم صرفاً من الراحِ؟","للسحرِ عيناك أم للسكرِ يا صاح",49,"ح",1,1],["عاطِنيها كَأسا فَكاسا اِلى أَن","يَضرِبَ الفَجر هامَة الظُلَماء",50,"ا",2,0],["عاطَيْتُه الصَّهْباءَ أخطُبُ نَوْمَه","والصّحْوُ يَحجُبُ حُسْنَه بِدَلاله",51,"ل",2,0],["عاطِفَ فَضْلِ الذَّيل ذي الإرخاء","ومُبدِياًعن وجْنةٍ حمراء",52,"ا",2,0],["عاطني يا نَديم كَأس الأَماني","عَلَّ هَمي بِذَلِكَ الكاس يَجلى",53,"ل",2,0],["عاطنيها يا نديمي قهوةً","تَخْضِبُ الأَقداح بالصّبغ المُعَنْدَم",54,"م",1,0],["عاطَيْتُهُ ممَّا يَمُجُّ لُعابُهُ","صَهْباء تكْشِفُ عن صميمِ فؤاده",55,"د",2,0],["عاطيته مشمولة كريقه","لو جليت في جنح ليل لانجلى",56,"ا",1,0],["عاطني الكاس يا مليك فؤادي","واسقنيها من كفك العندميّ",57,"ي",1,0],["عاطَيْتُهُمْ غَيْرَ بنتِ الكَرْمِ من سَمَرٍ","على تعاطيهِ رحنا نذكر الكَرَما",58,"م",2,0],["عاطل اللّبّة لولا غَيَدٌ","نقلَ الحسنُ إليه المُقَلا",59,"ل",2,0],["عاطَيْتُه والصباحُ منبلجٌ","مُدامةً من سُلافةِ العنبِ",60,"ب",1,0],["عاطيتُ فيه الشمسَ تحت نُجومِها","بدراً تبلّجَ في قضيبٍ مائدِ",61,"د",1,0],["عاطيتُهُ راحاً الى الشمسِ انتمَتْ","بزُجاجةٍ تُنْمى لضوءِ نَهارِ",62,"ر",1,0],["عاطيتُها خمرة حمراء صدافية","تخال في كاسها جمرا من اللهب",63,"ب",1,0],["عاطيتها اللهو والفودان داجبة","والعيش أغيد غض غير معصار",64,"ر",1,0],["عاطتهم بيد الحوادث خمرةً","ما فاق من قطبت له جربالها",65,"ل",3,0],["عاطيته كأس المدامة غانياً","برضابه المعسول عن صبائها",66,"ا",3,0],["عاطيتنا اللطف في أقداح تطرية","فاحمر من خجل وجه ابنة العنب",67,"ب",1,0],["عاطني يا تونسي في نخبها","كأس صفو وبرياها اسقني",68,"ي",1,1],["عاطِنيها كَالجَلنارِ إِذا ما","كُلِّلَت مِن حَبابِه بِالأَقاحِ",69,"ح",1,0],["عاطيتَ لكنْ لا بكأسِ مُنادمٍ","فَسكِرتَ لكِنْ لا بخَمرةِ شاربِ",70,"ب",1,0],["عاطلاً حتى لقد عا","د من اللَّثم مُحلَّى",71,"ل",2,0],["عاطَتُها صَرفَ الهَوى وَعَفافَنا","طولَ التَلازُمِ لَم يُشِب مِن مَوضِعِ",72,"ع",1,0],["عاطيتُهُ الكَأس الرِويَّةِ موهِناً","فَأَضاءَ جُنحُ اللَيلِ مِن أَنوارِهِ",73,"ر",2,0],["عاطِنيها وَلا تَخف كيدَ واشٍ","مانَ في قَوله وَخانَ وَأَسرَف",74,"ف",1,0],["عاطنيها فَالدَهر بَعدَ عِناد","سالمتنا صُروفه وَتلطَّف",74,"ف",1,0],["عاطَيْتُها راحاً كأنَّ حَبابَها","تَحْتَ الدُّجا في الكأْسِ عِقْدُ دَراري",75,"ر",2,0],["عاطِلةٌ قَدْ غَنِيَتْ عَنْ حُلىً","بِما بِمَرْآها مِنَ الحُسنِ",76,"ن",1,0],["عاطني صِرفها بصرفٍ برُودٍ","خَصِرٍ من رُضابكَ البَرديِّ",77,"ي",1,0],["عاطنيها في بهجة الكأسِ تُجلى","بينَ عودٍ شادٍ وعودٍ شديِّ",77,"ي",1,0],["عاطنيها كأنّها وَهجُ الشّم","سِ تبدّت مِن بُرجِها الحَمليِّ",77,"ي",1,0],["عاطوا كؤوس هراهمُ ثم انثنوا","وبكل ج