{"poems":[[53,"لعمرك ما جر ذيل الفخار","https://www.aldiwan.net/poem29861.html","المتقارب"],[63,"أقول لسعدى وهي تذري دموعها","https://www.aldiwan.net/poem45873.html","الطويل"],[77,"خليلي إن اشتقتني مرة","https://www.aldiwan.net/poem36500.html","المتقارب"],[9,"ألا يا قتل قد خلق الجديد","https://www.aldiwan.net/poem21929.html","الوافر"],[0,"قفا نبك من ذكرى حبيب ومنزِل","https://www.aldiwan.net/poem50.html","الطويل"],[10,"أبى طول ليلي لا أهجع","https://www.aldiwan.net/poem21108.html","المتقارب"],[30,"أتعرف أطلالا بوهبين والحضر","https://www.aldiwan.net/poem29583.html","الطويل"],[47,"أقلي فأيام المحب قلائل","https://www.aldiwan.net/poem25203.html","الطويل"],[47,"دعوتك للجفن القريح المسهد","https://www.aldiwan.net/poem25322.html","الطويل"],[72,"أما وتلفت الرشاء الغرير","https://www.aldiwan.net/poem18712.html","الوافر"],[91,"يا نبأ سر به مسمعي","https://www.aldiwan.net/poem9060.html","عموديه"],[85,"حبرت مقالة جمعت فأوعت","https://www.aldiwan.net/poem7266.html","الوافر"],[85,"قفي يا أخت يوشع خبرينا","https://www.aldiwan.net/poem63733.html","الوافر"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[62,"على أثلات الواديين سلام","https://www.aldiwan.net/poem52296.html","الطويل"],[62,"لك الخير قد عودتني منك عادة","https://www.aldiwan.net/poem52320.html","الطويل"],[66,"كتبت فما علمت أنور نجم","https://www.aldiwan.net/poem40640.html","الوافر"],[80,"يد الدهر جارحة آسيه","https://www.aldiwan.net/poem31251.html","المتقارب"],[80,"أجمل على بخل الغواني وإجمال","https://www.aldiwan.net/poem31339.html","الطويل"],[31,"تقول ابنة البكرين يوم لقيننا","https://www.aldiwan.net/poem42497.html","الطويل"],[33,"ألا يا ليل إن ملكت فينا","https://www.aldiwan.net/poem25939.html","الوافر"],[105,"ألا رددوا الأنباء عن فوز ماهر","https://www.aldiwan.net/poem42126.html","الطويل"],[105,"حماة الوغى أين السلام الموطد","https://www.aldiwan.net/poem43104.html","الطويل"],[75,"انظر إليه وفي التحريك تسكين","https://www.aldiwan.net/poem69027.html","البسيط"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67286","الوافر"],[90,"هجرت الديار","https://www.poetsgate.com/ViewPoem.aspx?id=178969",""],[105,"حماة الوغى أين السلام الموطد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54957&r=&rc=127",""]],"verses":[["فَمِثلُكَ مَن لا يَني وَبلَهُ","إِذا اِستَمطَرَ البَلَدُ الماحِلُ",0,"ل",1,0],["فَمِثْلي إِذا ما هَمَّ لَمْ يَثْنِ عَزْمَهُ","بُكاءُ الغَوانِي وَالدُّموعُ السَّوافِكُ",1,"ك",1,0],["فمِثْلُكَ مَنْ يعْثُرُ الخِلُّ يوْماً","فيُغْضي لهُ ويُقيلُ العِثارا",2,"ر",2,0],["فَمِثلِكِ قَد لَهَوتُ بِها وَأَرضٍ","مَهامِهَ لا يَقودُ بِها المُجيدُ",3,"د",1,0],["فَمِثلُكِ حُبلى قَد طَرَقتُ وَمُرضِعٍ","فَأَلهَيتُها عَن ذي تَمائِمَ مُحوِلِ",4,"ل",1,0],["فَمِثلُ حَبيبِيَ أَبكى العُيونَ","وَأَوجَعَ مَن كانَ لا يوجَعُ",5,"ع",1,0],["فَمِثلُ بِلالٍ سُوِّسَ الأَمرَ فَاِستَوَت","مَهابَتُهُ الكُبرى وَجَلّى عَنِ الثَغرِ",6,"ر",1,0],["فَمِثلِيَ مَن نالَ المَعالي بِنَفسِهِ","وَرُبَّتَما غالَتهُ عَنها الغَوائِلُ",7,"ل",1,0],["فَمِثلُكَ مَن يُدعى لِكُلِّ عَظيمَةٍ","وَمِثلِيَ مَن يُفدى بِكُلِّ مُسَوَّدِ",8,"د",1,0],["فمثلك من أغاث حليف بيتٍ","فأحيى بعضَ سكانِ القبور",9,"ر",1,0],["فَمَثَّلوا الجَهلَ وَأَضرارِهِ","حَتّى يُعادي جَهلَهُ الجاهِلُ",10,"ل",1,0],["فمثِّل غير هذا الدور واعلم","بأن اللورد قد قطع الجراية",11,"ا",3,0],["فَمِثلُكِ مَن رَوى الأَخبارَ طُرّاً","وَمَن نَسَبَ القَبائِلَ أَجمَعينا",12,"ن",2,0],["فَمِثلَ بِناءِ التُركِ لَم يَبنِ مُشرِقٌ","وَمِثلَ بِناءِ التُركِ لَم يَبنِ مَغرِبُ",13,"ب",1,0],["فمثُلكَ لم تغلِبْ عوائدُ سخطهِ","رضاهُ ولم يبعُدْ لديه مَرامُ",14,"م",1,0],["فمثليَ لا يرضَى مُقَاماً بذلةٍ","وصبراً على جاهٍ لديكَ مُدَالِ",15,"ل",1,0],["فَمِثلُكَ مَن تَرَفَّقَ بِالمَوالي","وَغَضَّ عَنِ المُقَصِّرِ جَفنَ حِلمِ",16,"م",1,0],["فمثّلتُ في خلدي شخْصَهُ","وَقَرّبْتُ تربته القاصيه",17,"ي",2,0],["فَمَثِّلْ لِعَينَيكَ الكرى فَعَسى الكرى","يزورُكَ فيه من حَبيبِكِ تِمثالُ",18,"ل",1,0],["فَمِثلُ الَّذي عايَنتُ شَيَّبَ لِمَّتي","وَمِثلُ الَّذي أُخفي مِنَ الحُزنِ نَكَّرا",19,"ر",2,0],["فَمِثلُ تَأَيُّمٍ مِنهُ نِكاحٌ","وَمِثلُ تَمَوُّلٍ مِنهُ اِفتِقارُ",20,"ر",1,0],["فمثلي يرى الإقدامَ للمرءِ سُؤدُداً","ومِثلُك يأبى حقَّه غيرَ وافرِ",21,"ر",1,0],["فَمِثلُ الَّذي أَبلَيتِ لَم يَروِ مُبرِقٌ","وَمِثل الَّذي أَبلَيتِ لَم يَروِ مُبرِدُ",22,"د",1,0],["فمِثْلُ رَقّادَةٍ في كفّهِ وَسَطٌ","ونحنُ مَقْدونُسٌ فيه وطَرخُون",23,"ن",1,0],["فَمِثْلُ مُسَهَّبٍ وبني أبيهِ","بجنبِ الرَّدْهِ من كنفيْ سَواءِ",24,"ا",2,0],["فمثلك يُنهِضُ قطرَ العراق","ويَجْمَعُ أشتات أحراره",25,"ر",2,0],["فمثل الذي أبليت لم يرو مبرقٌ","ومثل الذي أبليت لم يرو مبرداً",26,"د",2,0]]}