َتُهُ الكُبرى وَجَلّى عَنِ الثَغرِ",6,"ر",1,0],["فَمِثلِيَ مَن نالَ المَعالي بِنَفسِهِ","وَرُبَّتَما غالَتهُ عَنها الغَوائِلُ",7,"ل",1,0],["فَمِثلُكَ مَن يُدعى لِكُلِّ عَظيمَةٍ","وَمِثلِيَ مَن يُفدى بِكُلِّ مُسَوَّدِ",8,"د",1,0],["فمثلك من أغاث حليف بيتٍ","فأحيى بعضَ سكانِ القبور",9,"ر",1,0],["فَمَثَّلوا الجَهلَ وَأَضرارِهِ","حَتّى يُعادي جَهلَهُ الجاهِلُ",10,"ل",1,0],["فمثِّل غير هذا الدور واعلم","بأن اللورد قد قطع الجراية",11,"ا",3,0],["فَمِثلُكِ مَن رَوى الأَخبارَ طُرّاً","وَمَن نَسَبَ القَبائِلَ أَجمَعينا",12,"ن",2,0],["فَمِثلَ بِناءِ التُركِ لَم يَبنِ مُشرِقٌ","وَمِثلَ بِناءِ التُركِ لَم يَبنِ مَغرِبُ",13,"ب",1,0],["فمثُلكَ لم تغلِبْ عوائدُ سخطهِ","رضاهُ ولم يبعُدْ لديه مَرامُ",14,"م",1,0],["فمثليَ لا يرضَى مُقَاماً بذلةٍ","وصبراً على جاهٍ لديكَ مُدَالِ",15,"ل",1,0],["فَمِثلُكَ مَن تَرَفَّقَ بِالمَوالي","وَغَضَّ عَنِ المُقَصِّرِ جَفنَ حِلمِ",16,"م",1,0],["فمثّلتُ في خلدي شخْصَهُ","وَقَرّبْتُ تربته القاصيه",17,"ي",2,0],["فَمَثِّلْ لِعَينَيكَ الكرى فَعَسى الكرى","يزورُكَ فيه من حَبيبِكِ تِمثالُ",18,"ل",1,0],["فَمِثلُ الَّذي عايَنتُ شَيَّبَ لِمَّتي","وَمِثلُ الَّذي أُخفي مِنَ الحُزنِ نَكَّرا",19,"ر",2,0],["فَمِثلُ تَأَيُّمٍ مِنهُ نِكاحٌ","وَمِثلُ تَمَوُّلٍ مِنهُ اِفتِقارُ",20,"ر",1,0],["فمثلي يرى الإقدامَ للمرءِ سُؤدُداً","ومِثلُك يأبى حقَّه غيرَ وافرِ",21,"ر",1,0],["فَمِثلُ الَّذي أَبلَيتِ لَم يَروِ مُبرِقٌ","وَمِثل الَّذي أَبلَيتِ لَم يَروِ مُبرِدُ",22,"د",1,0],["فمِثْلُ رَقّادَةٍ في كفّهِ وَسَطٌ","ونحنُ مَقْدونُسٌ فيه وطَرخُون",23,"ن",1,0],["فَمِثْلُ مُسَهَّبٍ وبني أبيهِ","بجنبِ الرَّدْهِ من كنفيْ سَواءِ",24,"ا",2,0],["فمثلك يُنهِضُ قطرَ العراق","ويَجْمَعُ أشتات أحراره",25,"ر",2,0],["فمثل الذي أبليت لم يرو مبرقٌ","ومثل الذي أبليت لم يرو مبرداً",26,"د",2,0],["فمثال ذي الدنيا سراب القيعتي","فحسابه ماءٌ يعيي المغشِما",27,"م",2,0],["فمثلك من تمرد","كلما ساموه إِذعانا",28,"ن",2,0],["فمثله حاشاه أن يقصرا","بحقنا إِن حقنا تذكرا",29,"ر",2,0],["فمثلك ليس يخفى عنه أني","لأحمد ابن إسمعيل عبد",30,"د",1,0],["فَمِثلي مَن يُقيمُ صَغى الأَعادي","وَيُستَعدى عَلى نُوَبِ الزَمانِ",31,"ن",1,0],["فَمثلُ الرِفاعي القطب يختار ذمّهُ","وَشيخُ منارِ السوء يمنحهُ شُكرا",32,"ر",2,0],["فمثّلي خدهُ فإني","رأيتُ ما فيكَ ماءَ وردِ",33,"د",1,0],["فَمِثلُكَ أَدّى نُصرَةَ القَومِ عَنوَةً","وَمِثلُكَ أَعيا ذا السِلاحِ المُجَرَّبا",34,"ب",2,0],["فمثلوا كيفما شئتم به فلقد","حلا له في بديع الحسن تمثيل",35,"ل",1,0],["فمثلك من يبدي الجميل تكرّماً","ويستر بالحسنى وجوهَ القبائح",36,"ح",1,0],["فمثلك من يرجى ويخشى ولا أرى","مثالك براً يحسن القتل والبسرا",37,"ر",2,0],["فمِثلُكَ خضتُ بحاراً وجبتُ","قفاراً وشبتُ لِفرطِ اهتمام",38,"م",1,0],["فمثلك ريّا الوجَنتينِ حييّةٌ","أُسامِرُها تحتَ الظَّلامِ المنَجَّم",39,"م",1,0],["فمثلُكَ من يكونُ لفخرِ قومٍ","اذا افتخروا بشهمٍ لوذعي",40,"ي",1,0],["فَمِثْلُكَ لَيْسَ عَلَى حادِثٍ","أَلَمَّ فَنَكَّبَهُ مِنْ مَلامِ",41,"م",1,0],["فَمِثْلُكَ أُنْسِ الدَّوْلَةِ انْتاشَ هَالِكاً","أَخَيِذَ مُلِمَّاتٍ أَسِيرَ زَمَانِ",42,"ن",1,0],["فَمِثلُكَ أَلوى بِالفُؤادِ وَزَارَ بال","عِدادِ وَأَصحا في الحَياةِ وَأَسكَرا",43,"ر",2,1],["فَمِثلُكَ مَن يُتحِفُ السائِلين","وَمِثلِيَ بِالعِلمِ مَن يُتحَفُ",44,"ف",1,0],["فمِثلُك يا عادِمَ المِثْل مَن","إذا قال للهِ قولاً جَزَم",45,"م",1,0],["فمِثالُ كَفِّكَ لا يُقا","بَلُ ثَمَّ إلاّ بامتِثال",46,"ل",1,0],["فمِثْلُك مَن لو يَشْتري مَدْحَ مادحٍ","بأبياتِ مالٍ عَدَّها ثَمَناً بَخْسا",47,"س",2,0],["فَمُثْنٍ على آثارِك السَيفُ والنَّدى","ووَقْفٌ على أَفعالِكَ الحمدُ والشُكر",48,"ر",1,0],["فَمثلكَ مَذخور لَها وَمُؤمل","وَمثلكَ لِلأَحرار فيهِ مُساعِدُ",49,"د",1,0],["فَمثلك كُل ذي كَرَم وَمَجد","لَهُ خَل وَكُلُ الأَرض دار",50,"ر",1,0],["فمثلكَ ما سمعنا في البرايا","ولا قَد كان قَطَّ ولا يكونُ",51,"ن",1,0],["فمثل سعيك فليُحمدْ لكسْبِ عُلىً","ومثل مُلْكك بعد الله فَلْيكُن",52,"ن",1,0],["فمثلك عين ما رأت في زهادة","وفي عمل بر أجلك عن ند",53,"د",1,0],["فمثلك يفدى بالأنام جميعهم","بكل مسود منهم ومُسَوَّد",54,"د",1,0],["فمثلك فيهم لا يكون ولم يكن","طويل نجاد السَّيف رَحْبَ المقلد",54,"د",1,0],["فمثلك في المكارم لا يجارى","ومثلك في الأَكارم لا يضاهى",55,"ا",3,0],["فمثلُك زَنْدُ همّتِهِ طويلٌ","هُناك وزند عزمَتِه وريُّ",56,"ي",1,0],["فمثلي من محبيه","على الاخلاص والغضب",57,"ب",1,0],["فمثلك من يستامُ درَّ شنوفها","بكفِّ اعتزام كلَّما أطلعت شنفا",58,"ف",2,0],["فمثَّلها لا عِطْفُها متشمِّسٌ","ولا مسُّها تحت الكرى متصعِّبُ",59,"ب",1,0],["فمثَّله التصوّرُ لي بقلبٍ","يَرَى بالظنّ من خَلَلِ الغيوبِ",60,"ب",1,0],["فمثلك مغدور السماح بحبّها","وغيريَ معضول الطماعة منصوح",61,"ح",1,0],["فمثلان في التشبيه رمحٌ وقامةٌ","وسيّان في قلبي سنان ووسنان",62,"ن",1,0],["فمثلك والنظير لكم عزيز","تحولت السجن إلى كنوز",63,"ز",1,0],["فَمثلُكَ من يُضافُ لكُلِّ فَضلٍ","ومِثلي مُعْدَمٌ بِحماكَ ضَيْفُ",64,"ف",1,0],["فمثلَ نهايةٍ حتمٍ أُساقُ","إليها دون علمٍ ما كرهتُ",65,"ت",1,0],["فمُثخَنٌ يحملُ شَهّاقةً","تَحكي لِراءٍ فُغْرَةَ الأعْلَمِ",66,"م",1,0],["فمثالا ضرب الله لكم","وهو من أنفسكم قد بهرا",67,"ر",2,0],["فمِثْلُ ذَاكَ تَسْتَدْلِلْ عَلَيْهِ","بِلَيْلِ الشّعْرِ يَجْعَلُهُ نَهَارَا",68,"ر",2,0],["فمثلك قلما نلقي هماما","حوى من باهر الشيم الأغرا",69,"ر",2,0],["فَمِثلَكَ لا يَعنو لا ثِقالَ نَكبَةٍ","عَلى أَن حَزَمَ الرَأى إِذا ذاكَ كاهِلُهُ",70,"ل",2,0],["فَمِثلُ فَضلِكَ بَحراً لَيسَ يَحصُرُهُ","لِسانٌ مِثلي في ذا العَيِّ وَالحَصَرِ",71,"ر",1,0],["فَمِثلُكَ يُخدَعُ عَن مالِه","وَيُؤخَذُ أوَراقُه بالوَرَق",72,"ق",1,0],["فمثلُ ذا من إلهِ الخلقِ في سَخَطٍ","وفي البريَّة ممقوتاً بِما اكتَسَبا",73,"ب",2,0],["فمثلي ما عليه في نظامٍ","نميتُ به إليكم من جناحِ",74,"ح",1,0],["فمثل يوم القضاء الرهيب","وما كان ذلك في هاجس",75,"س",1,0],["فمثل بذا حب رب الفداء","وما قد حبانا أجل اعتناء",76,"ا",2,1],["فمثلكما أرضى الإلهَ تعزِّياً","وصبراً على البلوى وأسْخَطَ إِبليسا",77,"س",2,0],["فم ثَمَّ وكم ثَمَّ","منَ الوَضْعِ على الوضع",78,"ع",1,0],["فمثلك من يسبي العقول وإن قست","ومثلي من يضحي به مغرماً مغرى",79,"ر",2,0],["فمثلي من يجني ومثلك من عفا","ومثلي من يرجو ومثلك من ينعم",80,"م",1,0],["فمثلي كمثل الغراب","يضل عن طريقه الصواب",81,"ب",1,0],["فمثل عبدك من يحظى ومثلك من","يعفو ومثلك يا مولاي من صفحا",82,"ح",2,0],["فمثلي من يخض بحر المنايا","ويغزو هكذا ويعود غالبْ",83,"ب",1,0],["فمثل خليلي ليس يوجد في الورى","حزومٌ بمحكم صبره ايربُ"