{"poems":[[53,"لعمرك ما جر ذيل الفخار","https://www.aldiwan.net/poem29861.html","المتقارب"],[63,"أقول لسعدى وهي تذري دموعها","https://www.aldiwan.net/poem45873.html","الطويل"],[77,"خليلي إن اشتقتني مرة","https://www.aldiwan.net/poem36500.html","المتقارب"],[9,"ألا يا قتل قد خلق الجديد","https://www.aldiwan.net/poem21929.html","الوافر"],[0,"قفا نبك من ذكرى حبيب ومنزِل","https://www.aldiwan.net/poem50.html","الطويل"],[10,"أبى طول ليلي لا أهجع","https://www.aldiwan.net/poem21108.html","المتقارب"],[30,"أتعرف أطلالا بوهبين والحضر","https://www.aldiwan.net/poem29583.html","الطويل"],[47,"أقلي فأيام المحب قلائل","https://www.aldiwan.net/poem25203.html","الطويل"],[47,"دعوتك للجفن القريح المسهد","https://www.aldiwan.net/poem25322.html","الطويل"],[72,"أما وتلفت الرشاء الغرير","https://www.aldiwan.net/poem18712.html","الوافر"],[91,"يا نبأ سر به مسمعي","https://www.aldiwan.net/poem9060.html","عموديه"],[85,"حبرت مقالة جمعت فأوعت","https://www.aldiwan.net/poem7266.html","الوافر"],[85,"قفي يا أخت يوشع خبرينا","https://www.aldiwan.net/poem63733.html","الوافر"],[85,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[62,"على أثلات الواديين سلام","https://www.aldiwan.net/poem52296.html","الطويل"],[62,"لك الخير قد عودتني منك عادة","https://www.aldiwan.net/poem52320.html","الطويل"],[66,"كتبت فما علمت أنور نجم","https://www.aldiwan.net/poem40640.html","الوافر"],[80,"يد الدهر جارحة آسيه","https://www.aldiwan.net/poem31251.html","المتقارب"],[80,"أجمل على بخل الغواني وإجمال","https://www.aldiwan.net/poem31339.html","الطويل"],[31,"تقول ابنة البكرين يوم لقيننا","https://www.aldiwan.net/poem42497.html","الطويل"],[33,"ألا يا ليل إن ملكت فينا","https://www.aldiwan.net/poem25939.html","الوافر"],[105,"ألا رددوا الأنباء عن فوز ماهر","https://www.aldiwan.net/poem42126.html","الطويل"],[105,"حماة الوغى أين السلام الموطد","https://www.aldiwan.net/poem43104.html","الطويل"],[75,"انظر إليه وفي التحريك تسكين","https://www.aldiwan.net/poem69027.html","البسيط"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67286","الوافر"],[90,"هجرت الديار","https://www.poetsgate.com/ViewPoem.aspx?id=178969",""],[105,"حماة الوغى أين السلام الموطد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54957&r=&rc=127",""],[121,"جف الكرى عكس الدموع معاً دما","https://www.aldiwan.net/poem23824.html","الكامل"],[124,"وهمت فليس ما سمي","https://www.aldiwan.net/poem23710.html","الهزج"],[124,"دراك يا شيخ فان حيدرا","https://www.aldiwan.net/poem23762.html","الرجز"],[160,"ولعت به كبدر التم يبدو","https://www.aldiwan.net/poem58989.html","الطويل"],[169,"على م وفي م ظلماً تلحياني","https://www.aldiwan.net/poem1688.html",""],[189,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[199,"يا كاس ماذا أريد بعدي","https://www.aldiwan.net/poem45178.html","مخلع البسيط"],[207,"أتاني من الأنباء أن ابن مالك","https://www.aldiwan.net/poem27979.html","الطويل"],[210,"رأى العقيق فأجرى دمعه لولو","https://www.aldiwan.net/poem13306.html","البسيط"],[259,"خذا حيث أمت عاديات السوانح","https://www.aldiwan.net/poem35736.html","الطويل"],[261,"أألزم قلبي فيك حبك والصبرا","https://www.aldiwan.net/poem38279.html","الطويل"],[270,"أصاحب لا تعذليه سلام","https://www.aldiwan.net/poem35591.html","المتقارب"],[270,"أحن إلى طيب الغدائر والفم","https://www.aldiwan.net/poem35634.html","الطويل"],[270,"رأيت الشرق ملكا للنبي","https://www.aldiwan.net/poem35655.html","الوافر"],[280,"بكيتك للبين قبل الحمام","https://www.aldiwan.net/poem60765.html","المتقارب"],[280,"لك الخير قد أنحى علي زماني","https://www.aldiwan.net/poem60787.html","الطويل"],[300,"فمثلك ألوى بالفؤاد وزار بالعداد","https://www.aldiwan.net/poem45486.html","الطويل"],[338,"أفدني فعلمك مستظرف","https://www.aldiwan.net/poem68732.html","المتقارب"],[364,"بغرة وجهك منا القسم","https://www.aldiwan.net/poem60658.html","المتقارب"],[364,"هبني أقصر بالخطا","https://www.aldiwan.net/poem60794.html","مجزوء الكامل"],[364,"طلعت طلوع البدر يا ملك الورى","https://www.aldiwan.net/poem60865.html","الطويل"],[364,"نصرت على الأعداء فليهنك النصر","https://www.aldiwan.net/poem60900.html","الطويل"],[380,"أكابد من برح النوى ما أكابد","https://www.aldiwan.net/poem48773.html","الطويل"],[380,"أعند الحر للأيام ثار","https://www.aldiwan.net/poem48783.html","الوافر"],[402,"أتدري من تخرمت المنون","https://www.aldiwan.net/poem46438.html","الوافر"],[402,"عزمت باليمن تحمي حوزة اليمن","https://www.aldiwan.net/poem46916.html","البسيط"],[403,"دع اللوم إن سالت دموعي على خدي","https://www.aldiwan.net/poem33938.html","الطويل"],[403,"إلى كم أداري عاذلي ومفندي","https://www.aldiwan.net/poem33969.html","الطويل"],[416,"أنيخاها فقد بلغت مناها","https://www.aldiwan.net/poem54083.html","الوافر"],[432,"تولى سقي دارهم الولي","https://www.aldiwan.net/poem12770.html","الوافر"],[441,"أطاوي السبسب القهب","https://www.aldiwan.net/poem14421.html","مجزوء الوافر"],[452,"لك الطائر الميمون فاسرج به طرفا","https://www.aldiwan.net/poem13844.html","الطويل"],[458,"قضى دين سعدى طيفها المتأوب","https://www.aldiwan.net/poem56292.html","الطويل"],[458,"أخي في الود أخي النسيبِ","https://www.aldiwan.net/poem56304.html","الوافر"],[464,"عيون المهى قلبي بنبلك مجروح","https://www.aldiwan.net/poem3149.html","عموديه"],[464,"خلا منك طرفي والحشا لك أوطان","https://www.aldiwan.net/poem3542.html","عموديه"],[479,"صديقك أيها الممدوح جوزي","https://www.aldiwan.net/poem37584.html","الوافر"],[500,"سمحت أبا سليمان التدلي","https://www.aldiwan.net/poem37951.html","الوافر"],[505,"الغيْب","https://www.aldiwan.net/poem27791.html","الوافر"],[551,"يا دار دار الصوم القوم","https://www.aldiwan.net/poem47200.html","السريع"],[558,"عندنا سر عجيب خطرا","https://www.aldiwan.net/poem34522.html","الرمل"],[567,"ألم تر أن تكرار الليالي","https://www.aldiwan.net/poem69692.html","الوافر"]],"verses":[["فَمِثلُكَ مَن لا يَني وَبلَهُ","إِذا اِستَمطَرَ البَلَدُ الماحِلُ",0,"ل",1,0],["فَمِثْلي إِذا ما هَمَّ لَمْ يَثْنِ عَزْمَهُ","بُكاءُ الغَوانِي وَالدُّموعُ السَّوافِكُ",1,"ك",1,0],["فمِثْلُكَ مَنْ يعْثُرُ الخِلُّ يوْماً","فيُغْضي لهُ ويُقيلُ العِثارا",2,"ر",2,0],["فَمِثلِكِ قَد لَهَوتُ بِها وَأَرضٍ","مَهامِهَ لا يَقودُ بِها المُجيدُ",3,"د",1,0],["فَمِثلُكِ حُبلى قَد طَرَقتُ وَمُرضِعٍ","فَأَلهَيتُها عَن ذي تَمائِمَ مُحوِلِ",4,"ل",1,0],["فَمِثلُ حَبيبِيَ أَبكى العُيونَ","وَأَوجَعَ مَن كانَ لا يوجَعُ",5,"ع",1,0],["فَمِثلُ بِلالٍ سُوِّسَ الأَمرَ فَاِستَوَت","مَهابَتُهُ الكُبرى وَجَلّى عَنِ الثَغرِ",6,"ر",1,0],["فَمِثلِيَ مَن نالَ المَعالي بِنَفسِهِ","وَرُبَّتَما غالَتهُ عَنها الغَوائِلُ",7,"ل",1,0],["فَمِثلُكَ مَن يُدعى لِكُلِّ عَظيمَةٍ","وَمِثلِيَ مَن يُفدى بِكُلِّ مُسَوَّدِ",8,"د",1,0],["فمثلك من أغاث حليف بيتٍ","فأحيى بعضَ سكانِ القبور",9,"ر",1,0],["فَمَثَّلوا الجَهلَ وَأَضرارِهِ","حَتّى يُعادي جَهلَهُ الجاهِلُ",10,"ل",1,0],["فمثِّل غير هذا الدور واعلم","بأن اللورد قد قطع الجراية",11,"ا",3,0],["فَمِثلُكِ مَن رَوى الأَخبارَ طُرّاً","وَمَن نَسَبَ القَبائِلَ أَجمَعينا",12,"ن",2,0],["فَمِثلَ بِناءِ التُركِ لَم يَبنِ مُشرِقٌ","وَمِثلَ بِناءِ التُركِ لَم يَبنِ مَغرِبُ",13,"ب",1,0],["فمثُلكَ لم تغلِبْ عوائدُ سخطهِ","رضاهُ ولم يبعُدْ لديه مَرامُ",14,"م",1,0],["فمثليَ لا يرضَى مُقَاماً بذلةٍ","وصبراً على جاهٍ لديكَ مُدَالِ",15,"ل",1,0],["فَمِثلُكَ مَن تَرَفَّقَ بِالمَوالي","وَغَضَّ عَنِ المُقَصِّرِ جَفنَ حِلمِ",16,"م",1,0],["فمثّلتُ في خلدي شخْصَهُ","وَقَرّبْتُ تربته القاصيه",17,"ي",2,0],["فَمَثِّلْ لِعَينَيكَ الكرى فَعَسى الكرى","يزورُكَ فيه من حَبيبِكِ تِمثالُ",18,"ل",1,0],["فَمِثلُ الَّذي عايَنتُ شَيَّبَ لِمَّتي","وَمِثلُ الَّذي أُخفي مِنَ الحُزنِ نَكَّرا",19,"ر",2,0],["فَمِثلُ تَأَيُّمٍ مِنهُ نِكاحٌ","وَمِثلُ تَمَوُّلٍ مِنهُ اِفتِقارُ",20,"ر",1,0],["فمثلي يرى الإقدامَ للمرءِ سُؤدُداً","ومِثلُك يأبى حقَّه غيرَ وافرِ",21,"ر",1,0],["فَمِثلُ الَّذي أَبلَيتِ لَم يَروِ مُبرِقٌ","وَمِثل الَّذي أَبلَيتِ لَم يَروِ مُبرِدُ",22,"د",1,0],["فمِثْلُ رَقّادَةٍ في كفّهِ وَسَطٌ","ونحنُ مَقْدونُسٌ فيه وطَرخُون",23,"ن",1,0],["فَمِثْلُ مُسَهَّبٍ وبني أبيهِ","بجنبِ الرَّدْهِ من كنفيْ سَواءِ",24,"ا",2,0],["فمثلك يُنهِضُ قطرَ العراق","ويَجْمَعُ أشتات أحراره",25,"ر",2,0],["فمثل الذي أبليت لم يرو مبرقٌ","ومثل الذي أبليت لم يرو مبرداً",26,"د",2,0],["فمثال ذي الدنيا سراب القيعتي","فحسابه ماءٌ يعيي المغشِما",27,"م",2,0],["فمثلك من تمرد","كلما ساموه إِذعانا",28,"ن",2,0],["فمثله حاشاه أن يقصرا","بحقنا إِن حقنا تذكرا",29,"ر",2,0],["فمثلك ليس يخفى عنه أني","لأحمد ابن إسمعيل عبد",30,"د",1,0],["فَمِثلي مَن يُقيمُ صَغى الأَعادي","وَيُستَعدى عَلى نُوَبِ الزَمانِ",31,"ن",1,0],["فَمثلُ الرِفاعي القطب يختار ذمّهُ","وَشيخُ منارِ السوء يمنحهُ شُكرا",32,"ر",2,0],["فمثّلي خدهُ فإني","رأيتُ ما فيكَ ماءَ وردِ",33,"د",1,0],["فَمِثلُكَ أَدّى نُصرَةَ القَومِ عَنوَةً","وَمِثلُكَ أَعيا ذا السِلاحِ المُجَرَّبا",34,"ب",2,0],["فمثلوا كيفما شئتم به فلقد","حلا له في بديع الحسن تمثيل",35,"ل",1,0],["فمثلك من يبدي الجميل تكرّماً","ويستر بالحسنى وجوهَ القبائح",36,"ح",1,0],["فمثلك من يرجى ويخشى ولا أرى","مثالك براً يحسن القتل والبسرا",37,"ر",2,0],["فمِثلُكَ خضتُ بحاراً وجبتُ","قفاراً وشبتُ لِفرطِ اهتمام",38,"م",1,0],["فمثلك ريّا الوجَنتينِ حييّةٌ","أُسامِرُها تحتَ الظَّلامِ المنَجَّم",39,"م",1,0],["فمثلُكَ من يكونُ لفخرِ قومٍ","اذا افتخروا بشهمٍ لوذعي",40,"ي",1,0],["فَمِثْلُكَ لَيْسَ عَلَى حادِثٍ","أَلَمَّ فَنَكَّبَهُ مِنْ مَلامِ",41,"م",1,0],["فَمِثْلُكَ أُنْسِ الدَّوْلَةِ انْتاشَ هَالِكاً","أَخَيِذَ مُلِمَّاتٍ أَسِيرَ زَمَانِ",42,"ن",1,0],["فَمِثلُكَ أَلوى بِالفُؤادِ وَزَارَ بال","عِدادِ وَأَصحا في الحَياةِ وَأَسكَرا",43,"ر",2,1],["فَمِثلُكَ مَن يُتحِفُ السائِلين","وَمِثلِيَ بِالعِلمِ مَن يُتحَفُ",44,"ف",1,0],["فمِثلُك يا عادِمَ المِثْل مَن","إذا قال للهِ قولاً جَزَم",45,"م",1,0],["فمِثالُ كَفِّكَ لا يُقا","بَلُ ثَمَّ إلاّ بامتِثال",46,"ل",1,0],["فمِثْلُك مَن لو يَشْتري مَدْحَ مادحٍ","بأبياتِ مالٍ عَدَّها ثَمَناً بَخْسا",47,"س",2,0],["فَمُثْنٍ على آثارِك السَيفُ والنَّدى","ووَقْفٌ على أَفعالِكَ الحمدُ والشُكر",48,"ر",1,0],["فَمثلكَ مَذخور لَها وَمُؤمل","وَمثلكَ لِلأَحرار فيهِ مُساعِدُ",49,"د",1,0],["فَمثلك كُل ذي كَرَم وَمَجد","لَهُ خَل وَكُلُ الأَرض دار",50,"ر",1,0],["فمثلكَ ما سمعنا في البرايا","ولا قَد كان قَطَّ ولا يكونُ",51,"ن",1,0],["فمثل سعيك فليُحمدْ لكسْبِ عُلىً","ومثل مُلْكك بعد الله فَلْيكُن",52,"ن",1,0],["فمثلك عين ما رأت في زهادة","وفي عمل بر أجلك عن ند",53,"د",1,0],["فمثلك يفدى بالأنام جميعهم","بكل مسود منهم ومُسَوَّد",54,"د",1,0],["فمثلك فيهم لا يكون ولم يكن","طويل نجاد السَّيف رَحْبَ المقلد",54,"د",1,0],["فمثلك في المكارم لا يجارى","ومثلك في الأَكارم لا يضاهى",55,"ا",3,0],["فمثلُك زَنْدُ همّتِهِ طويلٌ","هُناك وزند عزمَتِه وريُّ",56,"ي",1,0],["فمثلي من محبيه","على الاخلاص والغضب",57,"ب",1,0],["فمثلك من يستامُ درَّ شنوفها","بكفِّ اعتزام كلَّما أطلعت شنفا",58,"ف",2,0],["فمثَّلها لا عِطْفُها متشمِّسٌ","ولا مسُّها تحت الكرى متصعِّبُ",59,"ب",1,0],["فمثَّله التصوّرُ لي بقلبٍ","يَرَى بالظنّ من خَلَلِ الغيوبِ",60,"ب",1,0],["فمثلك مغدور السماح بحبّها","وغيريَ معضول الطماعة منصوح",61,"ح",1,0],["فمثلان في التشبيه رمحٌ وقامةٌ","وسيّان في قلبي سنان ووسنان",62,"ن",1,0],["فمثلك والنظير لكم عزيز","تحولت السجن إلى كنوز",63,"ز",1,0],["فَمثلُكَ من يُضافُ لكُلِّ فَضلٍ","ومِثلي مُعْدَمٌ بِحماكَ ضَيْفُ",64,"ف",1,0],["فمثلَ نهايةٍ حتمٍ أُساقُ","إليها دون علمٍ ما كرهتُ",65,"ت",1,0],["فمُثخَنٌ يحملُ شَهّاقةً","تَحكي لِراءٍ فُغْرَةَ الأعْلَمِ",66,"م",1,0],["فمثالا ضرب الله لكم","وهو من أنفسكم قد بهرا",67,"ر",2,0],["فمِثْلُ ذَاكَ تَسْتَدْلِلْ عَلَيْهِ","بِلَيْلِ الشّعْرِ يَجْعَلُهُ نَهَارَا",68,"ر",2,0]]}