0393",""],[5038,"دعي قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=189377",""],[5038,"لا تملأ الكأس","https://www.poetsgate.com/ViewPoem.aspx?id=197221",""],[5121,"لُبْنَان","https://www.poetsgate.com/ViewPoem.aspx?id=215298",""],[5183,"تحية الاخاء","https://www.poetsgate.com/ViewPoem.aspx?id=180205",""],[5187,"وطن بلا ربيع","https://www.poetsgate.com/ViewPoem.aspx?id=29066",""],[1043,"الممثل","https://www.poetsgate.com/ViewPoem.aspx?id=92991",""],[5333,"أمرت فلم أسمع دعوتُ فلم تجب","https://www.poetsgate.com/ViewPoem.aspx?id=8965",""],[592,"أهاجك أم أشجاك رسم المعاهد","https://www.poetsgate.com/ViewPoem.aspx?id=128839",""],[5397,"أهل بسط كف تحجب الشمس والبدرا","https://www.poetsgate.com/ViewPoem.aspx?id=157931",""],[5474,"قلادة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=181669",""],[5688,"عاقبة الحبّ الحرام","https://www.poetsgate.com/ViewPoem.aspx?id=204076",""],[5690,"صدقتم لحظهُ لحظ الغزالِ","https://www.poetsgate.com/ViewPoem.aspx?id=172173",""],[5690,"هذا الصباح بدا أم ذا محياكِ","https://www.poetsgate.com/ViewPoem.aspx?id=172170",""],[5690,"إذا الصارم البتار عزت مضاربه","https://www.poetsgate.com/ViewPoem.aspx?id=172139",""],[5691,"فِراقان ...!","https://www.poetsgate.com/ViewPoem.aspx?id=208655",""],[5720,"يا رب","https://www.poetsgate.com/ViewPoem.aspx?id=214737",""],[5759,"سجى الليل","https://www.poetsgate.com/ViewPoem.aspx?id=213405",""],[1275,"تَعَلَّم إِن تَشا عِزّا","https://www.poetsgate.com/ViewPoem.aspx?id=104956",""],[5845,"عسى منْ خفي اللطفِ سبحانهُ لطفُ","https://www.poetsgate.com/ViewPoem.aspx?id=15452",""],[5854,"أهزّك الوجد لما بانت الرُسُم ((بالتوحيد نتحد))","https://www.poetsgate.com/ViewPoem.aspx?id=192157",""],[5916,"الى ليلى ...","https://www.poetsgate.com/ViewPoem.aspx?id=190587",""],[5956,"فتش عن العفيفة","https://www.poetsgate.com/ViewPoem.aspx?id=184330",""],[5957,"ضوء قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=11304",""],[6096,"رافض النعمة","https://www.poetsgate.com/ViewPoem.aspx?id=177722",""],[6142,"هي القلاص المراسيم المراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=155707",""],[422,"إذا نَبَتِ الدّيارُ بِحرِّ قومٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22246&r=&rc=2",""],[6318,"الجمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66160&r=&rc=10",""]],"verses":[["فَكَم باسِطينَ إِلى وَصلِنا","أَكُفَّهُمُ لَم يَنالوا نَصيبا",0,"ب",2,0],["فكَمْ بَيْنَ مَحْفُوظِ الْكَمَالِ مِنَ الرَّدَى","وَمُتَّصِفٍ بِالنَّقْصِ بَعْدَ كَمَالِهِ",1,"ل",2,0],["فَكَمْ بَيْنَ مَنْ هَدَّ الْبِنَاءَ وَأسَّسَا","وَلَيْسَ سَوَاءً أَحْسَنَ الدَّهْرُ أَمْ أُسَا",2,"س",2,0],["فَكَم بَوَّأتَني ساحاتِ نُعمى","عِذابِ الوِردِ وارِفَةِ الظِلالِ",3,"ل",1,0],["فكم بيت شعر قد عمرتُ بذكره","فبات به حادي السُّرى يترنَّمُ",4,"م",1,0],["فكم بتُّ أطوي الليل في طلب العُلا","كأني إلى نجْمِ السماء سفيرُ",5,"ر",1,0],["فكم بتّ في نهرة المجرّة في الدجى","من الشعر اجري منشآت سفينه",6,"ن",2,0],["فكم بعثُوا في الشرق حرباً ذميمة","تمثّل في أهوالها ساعة البعث",7,"ث",1,0],["فَكم برزت بحَيّهم الغواني","حواسر غير ما متريّبات",8,"ت",1,0],["فكم بنيت بيوتاً من ولاً وثناً","درست فيها ودامت غير أدراس",9,"س",1,0],["فكم بركاتٍ أذعنت بنزولها","لدعوته إذْ أمْعَنَتْ في صُعودها",10,"د",3,0],["فكم برنس لم يألُ خنقاً لحلقِه","وتحبيسه في مُظلمات المحابس",11,"س",1,0],["فكم بسطوا من لسان امرئ","فأسرف في الطول حتى ذُرِع",12,"ع",1,0],["فَكَم بينَنا مِن حُرمَةٍ وَمَوَدَّةٍ","وَكَم بَينَنا مِن مَوثِقٍ وَذِمامِ",13,"م",1,0],["فَكَم بَلقَعٍ مِن دونِهِ سَوفَ تَقتَري","إِلى طَيِّهِ العَنسُ العَلَنداةُ بَلقَعا",14,"ع",2,0],["فكم بَعُدَ الرقيبُ فأسعفَتْني","صروفُ الدهرِ إذ بَعُدَ الرقيبُ",15,"ب",1,0],["فَكَم بِهِ مِن زَهَرٍ ناضِرٍ","في الحُسنِ أَضحى نُزهَةَ الناظِرِ",16,"ر",1,0],["فَكَم بَلَغَت بي هِمَّتي بُعدَ غايَةٍ","يَعِزُّ عَلى الشَعرى العَبورِ بُلوغُها",17,"غ",3,0],["فَكَم بِكرِ مَعنىً حَوى طِرسُها","وَإِن كانَ في جِسمِ لَفظٍ عَوانِ",18,"ن",1,0],["فَكَم بِهِم أَشرَقَت أَستارُ داجِيَةٍ","وَكَم بِهِم خَمَدَت أَنفاسُ مُختَصِمِ",19,"م",1,0],["فَكَمْ بَطَلٍ خَضَبْتُ الأَرْضَ مِنْهُ","بِأَحْمَرَ مِنْ دَمِ التَّأْمُورِ قَانِي",20,"ن",2,0],["فَكَمْ بِهَا صُوَر كَادَتْ تُخَاطِبُنَا","جَهْراً بِغَيْرِ لِسَانٍ نَاطِقٍ وَفَمِ",21,"م",1,0],["فَكَمْ بَيْنَ مَفْقُودٍ يُعاشُ بِغَيْرِهِ","وَآخَرَ يُزْرِي بِالْهَوَى وَالْوَسَائِلِ",22,"ل",1,0],["فكمْ بابِ قصرٍ تبوأته","فأفهامُنا منهُ كالجابيَهْ",23,"ي",2,0],["فَكَم بَكَرَت تَسقي الأَمَرَّ حَليلَها","مِنَ الغارِ إِذ تَسقي الخَليلَ رُضابَها",24,"ب",3,0],["فكم بها وحولها من أغلفِ","تَهمي عليه الدمعَ عينُ الأَسْقفِ",25,"ف",1,0],["فَكمْ بِساحَتِهمْ مِنْ شِلْوِ مُطَّرَحٍ","كأنَّهُ فَوْقَ ظَهْرِ الأَرْضِ إجَّارُ",26,"ر",1,0],["فَكَمْ بِهَا رَسَخَتْ أَرْكَانُ مَمْلَكَةٍ","وَكَمْ بِهَا خَمَدَتْ أَنْفَاسُ مَغْرُورِ",27,"ر",1,0],["فَكَمْ بَطَلٍ فَلَّ الزَّمَانُ شَبَاتَهُ","وَكَمْ سَيِّدٍ دَارتْ عَلَيْهِ الدَّوائِرُ",28,"ر",1,0],["فَكَمْ بَيْنَ آصَالٍ أَدَرْنَا كُؤُوسَهَا","وَبَيْنَ لَيَالٍ مِنْ كَواكِبِها نُمْرِ",29,"ر",1,0],["فكَمْ بِكَ مِنْ صَرْحٍ بِآخَرَ مُمْسِكٍ","وَكَمْ بِكَ مِنْ قَصْرٍ مُضَافٍ إِلى قَصْرِ",30,"ر",1,0],["فَكَم بَينَنا إِن لَقيتُ العِدا","وَإِذ لَقي اللَه وَالمَلأَكا",31,"ك",2,0],["فكم بصدر القَبْر من ضَجْعةٍ","أحنى من الدهر ومن نُكْرِهِ",32,"ر",2,0],["فكم بعثوا عَلَى ظَمأٍ غَماماً","لئيمَ البرقِ قد حَجب الغماما",33,"م",2,0],["فكم بالطُّور من شاكٍ","إلى الرحمن ما يَلقى",34,"ق",2,0],["فكم بسطوا من لسان امرىء","ٍ فأسرف في الطُّول حتى ذُرع",35,"ع",1,0],["فكم بدت نغمات منك مطربة","هُزت بها طرباً حتى الجلاميد",36,"د",1,0],["فكَم بينَ آصالٍ أدَرنا كئوسَها","وَبَيْنَ لَيَالٍ مِنْ كَوَاكِبِها نُمْرِ",37,"ر",1,0],["فكم بنا شوق لاهل الحمى","وهم اولو العطف على العبد",38,"د",1,0],["فَكًَم بَعَثَت أكُفَّهم غُيُوثاً","ِإلَى أرضِ العَدُوِّ لَهَا إِتِّجَاهُ",39,"ا",2,0],["فكم ببيوتك الحسنى معان","حسانٌ لا يلم بها معانِ",40,"ن",1,0],["فَكَم بَلَدٍ مَلَكتَ بِهِ بِلاداً","وَكَم حِصنٍ فَتَحتَ بِهِ حُصونا",41,"ن",2,0],["فَكَم باطِلٍ أَضحى بِهِ وَهوَ زاهِقُ","وَإِن لَجَّ مُرتابٌ وَشَكَّ مُنافِقُ",42,"ق",1,0],["فكم بالثنا قلدت جيد جوده","لساني عقود لا تسامُ يمينُها",43,"ن",3,0],["فكم بك عن غيري وعني من غنا","وكم لي آمال إليك من الفقر",44,"ر",1,0],["فكم به بشرت من قبلنا رسل","وكم به آمنت من قبلنا أمم",45,"م",1,0],["فكَم بهِ لمَسَت روحي العزاءَ وقد","أودَعَتهُ سرّ آلامي وأشجاني",46,"ن",2,0],["فكم باك هناك من البرايا","يسيل الدّمع بين الطائفينا",47,"ن",2,0],["فكم بتلك المغاني","من كلّ زوج بَهيج",48,"ج",1,0],["فكم بتّ فيها أعاني العنا","بطيّ الرمال وقطع الجبال",49,"ل",1,0],["فكم بالنوى صابَ النوى بتّ أحتسي","وزمّلني دهري من البعد في مُرط",50,"ط",1,0],["فكم بسمةٍ فيهِ وكم فيهِ نظرةٍ","أرى بهما ما فيهِ للعُودِ إيراق",51,"ق",1,0],["فكم بعد سكري من رضابٍ وخمرةٍ","أرتني سبيلَ الطّيباتِ مُمهَّدا",52,"د",2,0],["فكم باقةٍ منهُ جَنَيتُ لِصدرِها","وكانت كغُصنٍ مُزهرٍ في يَدي انهصر",53,"ر",1,0],["فكم بسمةٍ تبدو سريعاً وتمّحي","وكم دمعةٍ تكوي الفؤادَ كجمرة",54,"ه",1,0],["فَكَم بسطت كف لسوء تريدني","فَقالَ لَها الكافى ألاغلب الكف",55,"ف",1,0],["فَكَم بِها مِن شادِنٍ تَحسُدُهُ","لِحُسنِهِ البُدورُ في اتِّساقِها",56,"ق",3,0],["فكم بفؤادي من غليل ومن اسا","ومن حسرات متعبات غوالب",57,"ب",1,0],["فكم بَهَر النّاسَ من مُعْجزٍ","بضَرْبَيْنِ من بُؤْسهِ والنّعيم",58,"م",1,0],["فكم بغَى حاسدٌ لاقَى صفاءَكما","إلقاءهُ كدَراً فيه فما قَدَرا",59,"ر",2,0],["فَكَم بَرَدَت بِماءِ السَيفِ غُلَّتَها","وَالسَيفُ ماءٌ لِنيرانِ الحَزازاتِ",60,"ت",1,0],["فكم بين مجبولٍ على الطهر طبعُه","وكم بين مجبورٍ ثَناه التطبع",61,"ع",1,0],["فكم بين عزهاةٍ وبين مغازلٍ","إذا الظرف ينبينا بمظروفه الرشح",62,"ح",1,0],["فكم بها مِن أغيدٍ مُهَفْهَفٍ","تَخْجَل من أَلْحاظِه بيضُ الظُّبىَ",63,"ا",1,0],["فكم به لاقيت من فاضل","إلى معاليه العلى تنسب",64,"ب",1,0],["فكم بها من أغيد","عن العيون حجبا",65,"ب",2,0],["فكم بدأوا بمكرمةٍ وثنَّوا","وكم نحروا العدى نحر الأضاحي",66,"ح",2,0],["فَكَم بِقُلابَ مِن أَوصالِ خِرقٍ","أَخى ثِقَةٍ وَجُمجُمَةٍ فَليقِ",67,"ق",1,0],["فكَمْ باتَ هَذَا الملكُ منّي مُعرِّساً","بِفَتّاَنَةٍ بكْرٍ وبتُّ عَلَى الثُّكْلِ",68,"ل",1,0],["فكم بات مسروراً بأول رقدة","وكأس المنايا آخر الليل يغبق",69,"ق",1,0],["فكم بالهدى أهدى قلوباً عمية","وكم بالدوا صما أطب وعميانا",70,"ن",2,0],["فكم بصرته حلية اشرفيَّةً","فدام على الإخلاصِ منها قِيامُه",71,"م",2,0],["فكم بها واكبدي فيمن 