/diwan/poem/88584","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111462","المتقارب"],[4085,"","https://poetry.dctabudhabi.ae/diwan/poem/105155","السريع"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93305","الرجز"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93312","البسيط"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28619","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76745","الكامل"],[4830,"عيناكِ","https://www.poetsgate.com/ViewPoem.aspx?id=211902",""],[4858,"موكب النور","https://www.poetsgate.com/ViewPoem.aspx?id=29798",""],[4929,"الى الذين يطلبون من صنعاء أن تنتفض","https://www.poetsgate.com/ViewPoem.aspx?id=199409",""],[4929,"نهاية الجزء الثناني من مسلسل متاهة شعب يبحث عن الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=199491",""],[4984,"فيا سائلا لا تلمني *","https://www.poetsgate.com/ViewPoem.aspx?id=175582",""],[4119,"ما استأنف القلب من أشواقه أربا","https://www.poetsgate.com/ViewPoem.aspx?id=16079",""],[3591,"أحبُّ دياراً لا أزور لها مغنى","https://www.poetsgate.com/ViewPoem.aspx?id=149411",""],[5136,"شوقي إلى دست الخلافة شيق","https://www.poetsgate.com/ViewPoem.aspx?id=121631",""],[5145,"خليليّ إن لم تسعدا فدعاني","https://www.poetsgate.com/ViewPoem.aspx?id=108058",""],[5183,"وادي الخيال","https://www.poetsgate.com/ViewPoem.aspx?id=180171",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5187,"وطن بلا ربيع","https://www.poetsgate.com/ViewPoem.aspx?id=29066",""],[5280,"داء الحب","https://www.poetsgate.com/ViewPoem.aspx?id=189825",""],[5281,"غُربة","https://www.poetsgate.com/ViewPoem.aspx?id=199496",""],[5314,"عودة الذات","https://www.poetsgate.com/ViewPoem.aspx?id=214821",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5397,"عز الحمى فثوى بالأمن خائفه","https://www.poetsgate.com/ViewPoem.aspx?id=157940",""],[5431,"نبيل","https://www.poetsgate.com/ViewPoem.aspx?id=197967",""],[5444,"موكب العز","https://www.poetsgate.com/ViewPoem.aspx?id=205068",""],[5497,"ألفة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=211698",""],[5518,"لا تعذلاه فما ذو الحب معذول","https://www.poetsgate.com/ViewPoem.aspx?id=187364",""],[5693,"فمشكاتي ومصباحي .","https://www.poetsgate.com/ViewPoem.aspx?id=34850",""],[5701,"يا صاحب السيف الذي","https://www.poetsgate.com/ViewPoem.aspx?id=164598",""],[5776,"هيبة حضور","https://www.poetsgate.com/ViewPoem.aspx?id=199371",""],[5943,"القاتلُ المجنونُ","https://www.poetsgate.com/ViewPoem.aspx?id=61843",""],[5977,"عزة نفس","https://www.poetsgate.com/ViewPoem.aspx?id=212748",""],[6093,"حبيبتي كالمُنسرح","https://www.poetsgate.com/ViewPoem.aspx?id=176618",""],[6117,"أَوْرَاقُ مُسَافِرْ","https://www.poetsgate.com/ViewPoem.aspx?id=182787",""]],"verses":[["فَمَوتُ الفَتى خَيرٌ لَهُ مِن حَياتِهِ","بِدارِ هَوانٍ بَينَ واشٍ وَحاسِدِ",0,"د",1,0],["فَمَوْلاَكَ يَامَوْلاَيَ قِبْلَةُ وِجْهَتِي","وَعُهْدَةُ أَسْرَارِي وَحُجَّةُ إِعْلاَنِي",1,"ن",2,0],["فَموتوا كِراماً بِأَسيافِكُم","وَلِلمَوتِ يَجشَمُهُ مَن جَشِم",2,"م",1,0],["فَمَوْتُ بَرِيءٍ حَيْثَمَا بَاتَ جَدُّهُ","أَثِيمَاً بِأَمْوَالِ الْعِبَادِ مُنَعَّمَا",3,"م",2,0],["فمولايَ قد أهدى العميدَ عقيلةً","يُكلِّلُها من لفظها اللؤلُؤُ الرطبُ",4,"ب",1,0],["فموضوع جودك إن لم تنا","ج الأبهاء لهات الضميرا",5,"ر",2,0],["فَمُؤَجَّلٌ يَلقى الرَدى في أَهلِهِ","وَمُعَجَّلٌ يَلقى الرَدى في نَفسِهِ",6,"ه",1,0],["فموتوا أيها الحسادُ موتوا","بداءٍ لا يموتُ ولا ينامُ",7,"م",1,0],["فَمَوتي في الوَغى أَرَبي لِأَنّي","رَأَيتُ العَيشَ في أَرَبِ النُفوسِ",8,"س",1,0],["فمَورِدُها عَذْبُ المياهِ نَمِيرُها","ومَرْبَعُها سَهْلُ الرِّياضِ مَريعُها",9,"ع",3,0],["فَمَوتُ الفَتى خَيرٌ لَهُ مِن قِيامِهِ","بِدارِ هَوانٍ بَينَ واشٍ وَحاسِدِ",10,"د",1,0],["فَمَواهِبُ السُلطانِ قَد كَسَتِ الوَرى","نِعَماً وَتَدعوهُ القَساوِرُ سالِبا",11,"ب",2,0],["فمؤتلقٌ على أفقٍ بعيدٍ","ومنعكسٌ على فضِّيِّ ماء",12,"ا",2,0],["فموفقُ الحركاتِ لا يرجو ولا","يخشى سوى ذي العزَّةِ القهارِ",13,"ر",1,0],["فموسَى لَحظُه يُحيى الرُّفات","حَكَى عِيسَى بإِحيَاءِ الرَّميمِ",14,"م",1,0],["فَمَوَاهِبُ الرَّحْمنِ بين مُصَوَّبٍ","منها لِراجِي رحمَةٍ ومُصَعَّدِ",15,"د",1,0],["فَمَوتٌ لِيَ مَذخورٌ","وَمَوتٌ بِيَ مَفعولُ",16,"ل",1,0],["فموتي في الوغى عيشي لأني","رأيت العيش في أرب النفوس",17,"س",1,0],["فَموَّجْنَهُ ثُمَّ ضَاحَكْنَهُ","وَجَارَيْنَهُ فِي دِعَابٍ لَطِيفْ",18,"ف",1,0],["فمواكب الحانات بعض هوادجي","وهوادج الخمار بعض ظعوني",19,"ن",2,0],["فَمُوجِبُهُ أن التِّنَاوةَ دُجيَةٌ","تَرِينُ عَلَى نُورِ الحِجَا لَم تَكَشَّفِ",20,"ف",1,0],["فَمَوتُ الحُرِّ خَيرٌ مِن حَياةٍ","يُقاسي عِندَها ذُلَّ الهَوانِ",21,"ن",1,0],["فمودّة مذمومة","ما بين لوطيّ وزان",22,"ن",1,0],["فمؤمَّل العافين أنت وأنت ذخ","ر الأولياء وكنز بيت المالِ",23,"ل",1,0],["فموسى وعيسى بشرا بقدومه","وكان ولا موسى وعيسى ومريم",24,"م",1,0],["فَمَوْتُ أَبِي يَا رَبِّ أحْرَقَ فَجْعُهَا","فُؤَادِي وَأَبْدَى مَا أُكِنُّ مِنَ الْوَجْدِ",25,"د",1,1],["فموسى كيفَ شقَّ البحرَ حتى","أجازَ بقومهِ والمنُّ قوت",26,"ت",1,0],["فموسى لو تَجَرّعَها ثلاثاً","على عيٍّ لخفَّ لسانُ مُوسى",27,"س",2,0],["فَمَولايَ أَولاني بِصورَةِ شَخصِهِ","وَناهيكَ مِن فَضلٍ بِهِ العَبدُ يَسعَد",28,"د",1,0],["فَمَوعودُ المُنى مِنهُ لِغَيري","بِحالِ الوَقتِ لي قَد صارَ نَقدا",29,"د",2,0],["فَمُؤمِنُهُم بي مُؤمِنٌ وَمُصَدِّقٌ","وَمُسلِمُهُم فيما قَضَيتُ مُسَلِّمُ",30,"م",1,0],["فَموسى كلَّمَ المَولى وَأَضحى","رَسولاً بَعدَ لَسع النار فاهُ",31,"ه",1,0],["فَموسى بَعد ما لَسَعَتهُ نارٌ","بِفيهِ كانَ لِلمَولى كَليما",32,"م",2,0],["فمُؤْذِنٌ بصلاحِ النّاسِ قد عَلِموا","إذا همُ أَصبحوا ممّن يُراعيه",33,"ي",2,0],["فمولده إن كان قد حَطَّ قدرَهم","فلا شك أن الرسْلَ فيهم زلازل",34,"ل",1,0],["فمولده بالبطن يأتي إلى الشقا","ومولدُه بالقبر للدين والأجر",35,"ر",1,0],["فَموت الفَتى في العِزِّ مثل حَياتِهِ","وَعيشته في الذُلِّ مِثلَ حِمامِهِ",36,"م",2,0],["فموضع الصيد يكون وادي","كما روى أيمة الصيادِ",37,"د",1,0],["فموارِدِ التّيسينِ من أَمواجِها","فمياهِ عَنْدِ يَد الرِّحابِ المَنْبِتِ",38,"ت",1,0],["فموارِدُ النصرِ العزيزِ لَهَا مَدىً","وعوائِدُ الفَتْحِ المُبِينِ لَهَا أَمَمْ",39,"م",1,0],["فمواقِفِ الحجَّاجِ من عَرَفاتِها","فالمَنْحَرِ المشهودِ من شِعْبَيْ مِنى",40,"ن",2,0],["فموت أهل الأرض طرا ومن","فيها جميعاً موتة العالم",41,"م",1,0],["فموتك ثلمة لا جبر فيها","ودون سدادها المخلوق يعيا",42,"ي",2,0],["فموت الرعول بأوتادها","كموتة عكرشة بالدجي",43,"ي",1,0],["فموكبها بعد السكينة نافرٌ","ومركبها صعبٌ وكان ممهَّدا",44,"د",2,0],["فَمَواضي عَزْمِهِ مِنْ زَعْزعٍ","ورواسي حِلْمِهِ منْ أُحُدِ",45,"د",1,0],["فموقفهُ السّماحة والجدا","كموقفه في حومة الضربْ والطعن",46,"ن",1,0],["فمَوْتُنا حَياتُنا","وغايَةُ العَجْزِ الصِّبا",47,"ب",2,0],["فَمُوجِباتُ الْحُبِّ مِنّي غَدَتْ","تَمْنَعُ من إيجابِها السَّلْبا",48,"ب",2,0],["فمؤمن هو ناج دون معرفة","إيمانه النور كالبرق الذي برقا",49,"ق",2,0],["فَمَوتُ المَرءِ خَيرٌ مِن حَياةٍ","يُهانُ بِطولِها فَيَموتُ حَيّا",50,"ي",2,0],["فَموسى وَهارونَ كَأحمَدَ وَالرِضا","عَلِيٍّ فَهَل مِن ثالِثٍ نالَ ذا الفَضلا",51,"ل",2,0],["فَمُوالِيه لا يَخِيبُ مُنَاه","ومُعاديه لاَ يُقَالُ عِثَارُه",52,"ر",2,0],["فَمُوالي نَداهُ يَحْظَى ويَرْضَى","وَمُعَادِي عُلاَه يَخْسا ويَخْسَرَ",53,"ر",1,0],["فموعده وناظره وجسمي","سقيم في سقيم في سقيم",54,"م",1,0],["فَموت شَرّ البَرايا فيهِ مَوعِظة","لِكُلِّ مَن قَد بَغى وَاللَهَ قَد أَغضبْ",55,"ب",1,0],["فموتك يا أخي والبعث حق","وأنت الدهر للأمرين ناس",56,"س",1,0],["فموضوعة طوراً تشع بقبره","ومطبوعة حلياً بوجه السما طورا",57,"ر",2,0],["فمولود ربك صانع بر","بحق بدا لا بلغو الشفاه",58,"ه",1,0],["فَمُوالٍ يُغشى عليه إذا أص","غى لها منافقٌ يَتَغاشى",59,"ش",2,0],["فَمَوتُ أُهَيْلِ العِلمِ أَعلى مُصيبَةٍ","نَعَم مَوتُ خَيرِ الخَلقِ أَعلى وَأَكبرُ",60,"ر",1,0],["فموسى يشق له قَبرُه","ولَمَّا أتَى حَشرهُ والنُشُورُ",61,"ر",1,0],["فمولاه أرقى سيِّدٍ فاق سامياً","ولاة الورى طراً وكل الأعاظمِ",62,"م",1,0],["فموجب الصداقة المُساعده","وَمُقتَضى المَودة المعاضده",63,"ه",1,0],["فموجبه أنِّي باليوم زائر","أريد نجاة الدين من كل زائر",64,"ر",1,0],["فموعدهم يوم الخميس وكم بدت","لتدبير أهل السبت فيهم مصارع",65,"ع",1,0],["فموتي حياتي وانقطاعي تواصلي","ومحوي ثباتي واجتماعي تشتتي",66,"ي",1,0],["فَموتوا كِراماً أَو أَميتوا عدوّكم","وَدبّوا لنارِ الحربِ بالحطبِ الجزلِ",67,"ل",1,0],["فمؤنسي بعد المَنام الشجا","وَمَلبَسي بين الأَنام الضنى",68,"ن",2,0],["فموقف هذا دون هذا وفوق ذا","لذا موقف عن ذاك ألسنهم تجري",69,"ر",2,0],["فموتنا هزوجهُ","وبعثُنا خروجهُ",70,"ه",1,0],["فمولوه أمّ دين البرايا","أي شرك عدته في دنياها",71,"ا",3,0],["فمؤيَّدُ السلطان زُر ودع الورى","وعمانَ يَمِّم واهجُرِ الآفاقا",72,"ق",2,0],["فمولى الموالي للزيارة قد دعا","أنقعد عنها والمزور هو الله",73,"ه",1,0],["فمولد الطفل عيدٌ","يسر سهلا ونجدا",74,"د",2,0],["فَمَوعِدُنا بَعدَ الطَوافِ بِزَمزَمٍ","لَدى القُبَّةِ الوُسطى لَدى الصَخَراتِ",75,"ت",1,0],["فموحد ومشرك ومعطِّل","ومشبِّه ومنزِّه يتغالى",76,"ل",2,0],["فمواقفُ الرُّهبانِ في","أطمارِ خائفةٍ وخائفْ",77,"ف",1,0],["فم ولكن كوثري ريقه","حصباؤه الأقاح لا الزبرجد",78,"د",1,0],["فموتوا جميعاً يا حسود بغيظكم","فلا ترتقي عالي المراتب بالكسب",79,"ب",1,0],["فمؤيس النفس عن أهوائها يقظ","ومطمع النفس فيها غير منتبه",80,"ب",2,0],["فَمَولده السَعيد لَكُم تَبدى","وَهَذا النُور مِن أَقوى دَليل",81,"ل",1,0],["فمُوسى بِقَذفِ اليَمِّ تَمَّ عُلُوُّهُ","تَرَقَّى إِلى أَعلَى الذُّرا وَهوَ مُكرَمُ",82,"م",1,0],["فموثق في جبال الوهد مُنجَدلٌ","وموثق في جبالِ القَدِّ مَكبولُ",83,"ل",1,0],["فَموشِكَةٌ أَرضُنا أَن تَعودَ","خِلافَ الأَنيسِ وُحوشاً يَبابا",84,"ب",2,0],["فمولاك مولى كريم حليم","إذا شاء تاب على كل عاصي",85,"ص",2,0],["فمواسم الأيام تأتي مرة","وبك الليالي كلهن مواسم",86,"م",1,0],["فموحي قريضي لا كموحي قريضكم","واحساس روحي لا ترون له مثلا",87,"ل",2,0],["فَمَوعِدُكَ الشَطُّ الَّذي بَينَ أَهلِنا","وَأَهلِكَ حَتّى تَسمَعُ الديكَ يَهتِفُ",88,"ف",1,0],["فمولد خير الخلق اعظم موسم","باقباله الخيرات دامت لقابل",89,"ل",1,0],["فموته ستره إذ لا محيص له","عن الممات فكم يبقى لنقصان",90,"ن",1,0],["فموخوز بسن من قناة","ومضروب بحد من ضريب",91,"ب",1,0],["فمؤرخي قال المعا","ون مصطفى شرمي أفندي",92,"د",2,0],["فَمَولايَ عُذراً ان مَدحي لَقاصِرٌ","وَمَهما اقصَر في مَديحِكَ لي عُذر",93,"ر",1,0],["فَموردُ الأنس وَالتَصافي","صافي بِوَعدِهِ",94,"ه",1,0],["فموت جهيز عاجل لا شوى له","أحب إلينا من مقالتهم حكم",95,"م",1,0],["فموسى تراهُ شاكياً جُرمَ شعبهِ","ولا جَرَمٌ في ان 