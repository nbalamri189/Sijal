{"poems":[[57,"تغرب عن الأوطان في طلب العلا","https://www.aldiwan.net/poem24704.html","الطويل"],[77,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[9,"أتهجر غانية أم تلم","https://www.aldiwan.net/poem21984.html","المتقارب"],[93,"سوى الحب لا تشفي الفؤاد المكلما","https://www.aldiwan.net/poem11364.html","الطويل"],[83,"ظلالكم تندو وموردكم عذب","https://www.aldiwan.net/poem54337.html","الطويل"],[37,"ولم يتجهم لك النائبات","https://www.aldiwan.net/poem7070.html","المتقارب"],[47,"المرء رهن مصائب لاتنقضي","https://www.aldiwan.net/poem25244.html","الكامل"],[51,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[43,"ألذ من المدام الخندريس","https://www.aldiwan.net/poem9612.html","الوافر"],[61,"أتكتم أسرار الهوى أم تذيعها","https://www.aldiwan.net/poem51571.html","الطويل"],[58,"تغرب عن الأوطان في طلب العلى","https://www.aldiwan.net/poem31102.html","الطويل"],[66,"أسلبن من فوق النهود ذوائبا","https://www.aldiwan.net/poem41382.html","الكامل"],[97,"أحب أجل أحب كأن نبعا","https://www.aldiwan.net/poem24913.html","الوافر"],[69,"ما للزمان عن المروءة عار","https://www.aldiwan.net/poem28776.html","الكامل"],[81,"تبسم عن لما در نظيم","https://www.aldiwan.net/poem61310.html","البسيط"],[67,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[48,"أيا من حمل الذررة","https://www.aldiwan.net/poem65013.html","الهزج"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140833",""],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55025","المتقارب"],[124,"خل السجاير وادن لي غليوني","https://www.aldiwan.net/poem23756.html","الكامل"],[132,"الكني إلى المعني بالنحو واللغى","https://www.aldiwan.net/poem54671.html","الطويل"],[169,"على م وفي م ظلماً تلحياني","https://www.aldiwan.net/poem1688.html",""],[186,"إن المودة في ثلاثة","https://www.aldiwan.net/poem43241.html","مجزوء الكامل"],[204,"إقبالهن بشارة الإقبال","https://www.aldiwan.net/poem53188.html","الكامل"],[210,"فؤاد بذكر العامرية مغرم","https://www.aldiwan.net/poem13295.html","الطويل"],[237,"فموت أبي يا رب أحرق فجعها","https://www.aldiwan.net/poem18158.html","الطويل"],[270,"أجبني أيها الكون الصموت","https://www.aldiwan.net/poem35178.html","الوافر"],[270,"نراودها عجوزا دردبيسا","https://www.aldiwan.net/poem35298.html","الوافر"],[320,"كفاني رب الناس أعين حسدي","https://www.aldiwan.net/poem67136.html","الطويل"],[349,"وسحار الجفون يريك نارا","https://www.aldiwan.net/poem15638.html","الوافر"],[349,"أثمة أرباب الصبابة يمموا","https://www.aldiwan.net/poem15884.html","الطويل"],[353,"أرى محن الزمان مقدمات","https://www.aldiwan.net/poem39598.html","الكامل"],[353,"عواقب محنة الإنسان خير","https://www.aldiwan.net/poem39793.html","الوافر"],[364,"نثار مثلي إذا ما جاء يهديه","https://www.aldiwan.net/poem60589.html","البسيط"],[377,"لقد نزل المولى العلي وهو رافل","https://www.aldiwan.net/poem59289.html","الطويل"],[377,"أيا أغنياء الروح صونوا كنوزَكم","https://www.aldiwan.net/poem59426.html","الطويل"],[406,"أخذن زمام الدمع خوف انسجامه","https://www.aldiwan.net/poem50120.html","الطويل"],[429,"الحمد لله الذي قد حللا","https://www.aldiwan.net/poem40815.html","الرجز"],[432,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[439,"النصر حزبك في الضلالة فاحتكم","https://www.aldiwan.net/poem34807.html","الكامل"],[439,"عيد ووعد صادق لك بالمنى","https://www.aldiwan.net/poem34852.html","الكامل"],[441,"آها لها من غصة النادم","https://www.aldiwan.net/poem14479.html","السريع"],[441,"كوى قلبي الأسى والحزن كيا","https://www.aldiwan.net/poem14492.html","الوافر"],[441,"عزاء فما كل حي بحي","https://www.aldiwan.net/poem14493.html","المتقارب"],[458,"إذا صاح وفد السحب بالريح أوحدا","https://www.aldiwan.net/poem56243.html","الطويل"],[461,"جانبا لومي وخافا لددي","https://www.aldiwan.net/poem16116.html","الرمل"],[464,"أما وابتسام البرق في عابس الدجن","https://www.aldiwan.net/poem3514.html","عموديه"],[500,"تنفست ريح الصبا","https://www.aldiwan.net/poem38073.html","مجزوء الرجز"],[529,"اطلع علينا مثل شمس الضحى","https://www.aldiwan.net/poem37510.html","السريع"],[558,"في الكون للحق أمثال بها نطقا","https://www.aldiwan.net/poem34300.html","البسيط"],[563,"أرق ماء الحياة لأجل جلى","https://www.aldiwan.net/poem13616.html","الوافر"],[573,"لقد طهر الرحمان آل محمد","https://www.aldiwan.net/poem3643.html","الطويل"],[575,"ليل وصل منيرة أقماره","https://www.aldiwan.net/poem3059.html","الخفيف"],[575,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"]],"verses":[["فَمَوتُ الفَتى خَيرٌ لَهُ مِن حَياتِهِ","بِدارِ هَوانٍ بَينَ واشٍ وَحاسِدِ",0,"د",1,0],["فَمَوْلاَكَ يَامَوْلاَيَ قِبْلَةُ وِجْهَتِي","وَعُهْدَةُ أَسْرَارِي وَحُجَّةُ إِعْلاَنِي",1,"ي",1,0],["فَموتوا كِراماً بِأَسيافِكُم","وَلِلمَوتِ يَجشَمُهُ مَن جَشِم",2,"م",1,0],["فَمَوْتُ بَرِيءٍ حَيْثَمَا بَاتَ جَدُّهُ","أَثِيمَاً بِأَمْوَالِ الْعِبَادِ مُنَعَّمَا",3,"م",2,0],["فمولايَ قد أهدى العميدَ عقيلةً","يُكلِّلُها من لفظها اللؤلُؤُ الرطبُ",4,"ب",1,0],["فموضوع جودك إن لم تنا","ج الأبهاء لهات الضميرا",5,"ر",2,0],["فَمُؤَجَّلٌ يَلقى الرَدى في أَهلِهِ","وَمُعَجَّلٌ يَلقى الرَدى في نَفسِهِ",6,"ه",1,0],["فموتوا أيها الحسادُ موتوا","بداءٍ لا يموتُ ولا ينامُ",7,"م",1,0],["فَمَوتي في الوَغى أَرَبي لِأَنّي","رَأَيتُ العَيشَ في أَرَبِ النُفوسِ",8,"س",1,0],["فمَورِدُها عَذْبُ المياهِ نَمِيرُها","ومَرْبَعُها سَهْلُ الرِّياضِ مَريعُها",9,"ع",3,0],["فَمَوتُ الفَتى خَيرٌ لَهُ مِن قِيامِهِ","بِدارِ هَوانٍ بَينَ واشٍ وَحاسِدِ",10,"د",1,0],["فَمَواهِبُ السُلطانِ قَد كَسَتِ الوَرى","نِعَماً وَتَدعوهُ القَساوِرُ سالِبا",11,"ب",2,0],["فمؤتلقٌ على أفقٍ بعيدٍ","ومنعكسٌ على فضِّيِّ ماء",12,"ا",2,0],["فموفقُ الحركاتِ لا يرجو ولا","يخشى سوى ذي العزَّةِ القهارِ",13,"ر",1,0],["فموسَى لَحظُه يُحيى الرُّفات","حَكَى عِيسَى بإِحيَاءِ الرَّميمِ",14,"م",1,0],["فَمَوَاهِبُ الرَّحْمنِ بين مُصَوَّبٍ","منها لِراجِي رحمَةٍ ومُصَعَّدِ",15,"د",1,0],["فَمَوتٌ لِيَ مَذخورٌ","وَمَوتٌ بِيَ مَفعولُ",16,"ل",1,0],["فموتي في الوغى عيشي لأني","رأيت العيش في أرب النفوس",17,"س",1,0],["فَموَّجْنَهُ ثُمَّ ضَاحَكْنَهُ","وَجَارَيْنَهُ فِي دِعَابٍ لَطِيفْ",18,"ف",1,0],["فمواكب الحانات بعض هوادجي","وهوادج الخمار بعض ظعوني",19,"ي",1,0],["فَمُوجِبُهُ أن التِّنَاوةَ دُجيَةٌ","تَرِينُ عَلَى نُورِ الحِجَا لَم تَكَشَّفِ",20,"ف",1,0],["فَمَوتُ الحُرِّ خَيرٌ مِن حَياةٍ","يُقاسي عِندَها ذُلَّ الهَوانِ",21,"ن",1,0],["فمودّة مذمومة","ما بين لوطيّ وزان",22,"ن",1,0],["فمؤمَّل العافين أنت وأنت ذخ","ر الأولياء وكنز بيت المالِ",23,"ل",1,0],["فموسى وعيسى بشرا بقدومه","وكان ولا موسى وعيسى ومريم",24,"م",1,0],["فَمَوْتُ أَبِي يَا رَبِّ أحْرَقَ فَجْعُهَا","فُؤَادِي وَأَبْدَى مَا أُكِنُّ مِنَ الْوَجْدِ",25,"د",1,1],["فموسى كيفَ شقَّ البحرَ حتى","أجازَ بقومهِ والمنُّ قوت",26,"ت",1,0],["فموسى لو تَجَرّعَها ثلاثاً","على عيٍّ لخفَّ لسانُ مُوسى",27,"س",2,0],["فَمَولايَ أَولاني بِصورَةِ شَخصِهِ","وَناهيكَ مِن فَضلٍ بِهِ العَبدُ يَسعَد",28,"د",1,0],["فَمَوعودُ المُنى مِنهُ لِغَيري","بِحالِ الوَقتِ لي قَد صارَ نَقدا",29,"د",2,0],["فَمُؤمِنُهُم بي مُؤمِنٌ وَمُصَدِّقٌ","وَمُسلِمُهُم فيما قَضَيتُ مُسَلِّمُ",30,"م",1,0],["فَموسى كلَّمَ المَولى وَأَضحى","رَسولاً بَعدَ لَسع النار فاهُ",31,"ه",1,0],["فَموسى بَعد ما لَسَعَتهُ نارٌ","بِفيهِ كانَ لِلمَولى كَليما",32,"م",2,0],["فمُؤْذِنٌ بصلاحِ النّاسِ قد عَلِموا","إذا همُ أَصبحوا ممّن يُراعيه",33,"ي",2,0],["فمولده إن كان قد حَطَّ قدرَهم","فلا شك أن الرسْلَ فيهم زلازل",34,"ل",1,0],["فمولده بالبطن يأتي إلى الشقا","ومولدُه بالقبر للدين والأجر",35,"ر",1,0],["فَموت الفَتى في العِزِّ مثل حَياتِهِ","وَعيشته في الذُلِّ مِثلَ حِمامِهِ",36,"م",2,0],["فموضع الصيد يكون وادي","كما روى أيمة الصيادِ",37,"د",1,0],["فموارِدِ التّيسينِ من أَمواجِها","فمياهِ عَنْدِ يَد الرِّحابِ المَنْبِتِ",38,"ت",1,0],["فموارِدُ النصرِ العزيزِ لَهَا مَدىً","وعوائِدُ الفَتْحِ المُبِينِ لَهَا أَمَمْ",39,"م",1,0],["فمواقِفِ الحجَّاجِ من عَرَفاتِها","فالمَنْحَرِ المشهودِ من شِعْبَيْ مِنى",40,"ن",2,0],["فموت أهل الأرض طرا ومن","فيها جميعاً موتة العالم",41,"م",1,0],["فموتك ثلمة لا جبر فيها","ودون سدادها المخلوق يعيا",42,"ي",2,0],["فموت الرعول بأوتادها","كموتة عكرشة بالدجي",43,"ي",1,0],["فموكبها بعد السكينة نافرٌ","ومركبها صعبٌ وكان ممهَّدا",44,"د",2,0],["فَمَواضي عَزْمِهِ مِنْ زَعْزعٍ","ورواسي حِلْمِهِ منْ أُحُدِ",45,"د",1,0],["فموقفهُ السّماحة والجدا","كموقفه في حومة الضربْ والطعن",46,"ن",1,0],["فمَوْتُنا حَياتُنا","وغايَةُ العَجْزِ الصِّبا",47,"ب",2,0],["فَمُوجِباتُ الْحُبِّ مِنّي غَدَتْ","تَمْنَعُ من إيجابِها السَّلْبا",48,"ب",2,0],["فمؤمن هو ناج دون معرفة","إيمانه النور كالبرق الذي برقا",49,"ق",2,0],["فَمَوتُ المَرءِ خَيرٌ مِن حَياةٍ","يُهانُ بِطولِها فَيَموتُ حَيّا",50,"ي",2,0],["فَموسى وَهارونَ كَأحمَدَ وَالرِضا","عَلِيٍّ فَهَل مِن ثالِثٍ نالَ ذا الفَضلا",51,"ل",2,0],["فَمُوالِيه لا يَخِيبُ مُنَاه","ومُعاديه لاَ يُقَالُ عِثَارُه",52,"ر",2,0],["فَمُوالي نَداهُ يَحْظَى ويَرْضَى","وَمُعَادِي عُلاَه يَخْسا ويَخْسَرَ",53,"ر",1,0]]}