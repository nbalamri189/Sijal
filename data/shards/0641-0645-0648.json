{"poems":[[57,"تغرب عن الأوطان في طلب العلا","https://www.aldiwan.net/poem24704.html","الطويل"],[77,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[9,"أتهجر غانية أم تلم","https://www.aldiwan.net/poem21984.html","المتقارب"],[93,"سوى الحب لا تشفي الفؤاد المكلما","https://www.aldiwan.net/poem11364.html","الطويل"],[83,"ظلالكم تندو وموردكم عذب","https://www.aldiwan.net/poem54337.html","الطويل"],[37,"ولم يتجهم لك النائبات","https://www.aldiwan.net/poem7070.html","المتقارب"],[47,"المرء رهن مصائب لاتنقضي","https://www.aldiwan.net/poem25244.html","الكامل"],[51,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[43,"ألذ من المدام الخندريس","https://www.aldiwan.net/poem9612.html","الوافر"],[61,"أتكتم أسرار الهوى أم تذيعها","https://www.aldiwan.net/poem51571.html","الطويل"],[58,"تغرب عن الأوطان في طلب العلى","https://www.aldiwan.net/poem31102.html","الطويل"],[66,"أسلبن من فوق النهود ذوائبا","https://www.aldiwan.net/poem41382.html","الكامل"],[97,"أحب أجل أحب كأن نبعا","https://www.aldiwan.net/poem24913.html","الوافر"],[69,"ما للزمان عن المروءة عار","https://www.aldiwan.net/poem28776.html","الكامل"],[81,"تبسم عن لما در نظيم","https://www.aldiwan.net/poem61310.html","البسيط"],[67,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[48,"أيا من حمل الذررة","https://www.aldiwan.net/poem65013.html","الهزج"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140833",""],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55025","المتقارب"]],"verses":[["فَمَوتُ الفَتى خَيرٌ لَهُ مِن حَياتِهِ","بِدارِ هَوانٍ بَينَ واشٍ وَحاسِدِ",0,"د",1,0],["فَمَوْلاَكَ يَامَوْلاَيَ قِبْلَةُ وِجْهَتِي","وَعُهْدَةُ أَسْرَارِي وَحُجَّةُ إِعْلاَنِي",1,"ي",1,0],["فَموتوا كِراماً بِأَسيافِكُم","وَلِلمَوتِ يَجشَمُهُ مَن جَشِم",2,"م",1,0],["فَمَوْتُ بَرِيءٍ حَيْثَمَا بَاتَ جَدُّهُ","أَثِيمَاً بِأَمْوَالِ الْعِبَادِ مُنَعَّمَا",3,"م",2,0],["فمولايَ قد أهدى العميدَ عقيلةً","يُكلِّلُها من لفظها اللؤلُؤُ الرطبُ",4,"ب",1,0],["فموضوع جودك إن لم تنا","ج الأبهاء لهات الضميرا",5,"ر",2,0],["فَمُؤَجَّلٌ يَلقى الرَدى في أَهلِهِ","وَمُعَجَّلٌ يَلقى الرَدى في نَفسِهِ",6,"ه",1,0],["فموتوا أيها الحسادُ موتوا","بداءٍ لا يموتُ ولا ينامُ",7,"م",1,0],["فَمَوتي في الوَغى أَرَبي لِأَنّي","رَأَيتُ العَيشَ في أَرَبِ النُفوسِ",8,"س",1,0],["فمَورِدُها عَذْبُ المياهِ نَمِيرُها","ومَرْبَعُها سَهْلُ الرِّياضِ مَريعُها",9,"ع",3,0],["فَمَوتُ الفَتى خَيرٌ لَهُ مِن قِيامِهِ","بِدارِ هَوانٍ بَينَ واشٍ وَحاسِدِ",10,"د",1,0],["فَمَواهِبُ السُلطانِ قَد كَسَتِ الوَرى","نِعَماً وَتَدعوهُ القَساوِرُ سالِبا",11,"ب",2,0],["فمؤتلقٌ على أفقٍ بعيدٍ","ومنعكسٌ على فضِّيِّ ماء",12,"ا",2,0],["فموفقُ الحركاتِ لا يرجو ولا","يخشى سوى ذي العزَّةِ القهارِ",13,"ر",1,0],["فموسَى لَحظُه يُحيى الرُّفات","حَكَى عِيسَى بإِحيَاءِ الرَّميمِ",14,"م",1,0],["فَمَوَاهِبُ الرَّحْمنِ بين مُصَوَّبٍ","منها لِراجِي رحمَةٍ ومُصَعَّدِ",15,"د",1,0],["فَمَوتٌ لِيَ مَذخورٌ","وَمَوتٌ بِيَ مَفعولُ",16,"ل",1,0],["فموتي في الوغى عيشي لأني","رأيت العيش في أرب النفوس",17,"س",1,0],["فَموَّجْنَهُ ثُمَّ ضَاحَكْنَهُ","وَجَارَيْنَهُ فِي دِعَابٍ لَطِيفْ",18,"ف",1,0]]}