{"poems":[[55,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[79,"باتت نجوم الأفق دون علاكا","https://www.aldiwan.net/poem36385.html","الكامل"],[93,"مهبط الوحي مطلع الأنبياء","https://www.aldiwan.net/poem8724.html","عموديه"],[94,"قضيت أدوار الحياة مفكرا","https://www.aldiwan.net/poem38916.html","الكامل"],[64,"على أثلات الواديين سلام","https://www.aldiwan.net/poem52296.html","الطويل"],[47,"خير يوميك في الهوى واقتباله","https://www.aldiwan.net/poem65606.html","الخفيف"],[101,"من مفكرة عاشق دمشقي","https://www.aldiwan.net/poem5856.html","عموديه"],[107,"سيري الهوينى دومة الجندل","https://www.aldiwan.net/poem44201.html","السريع"],[54,"طار نومي وعاود القلب عيد","https://www.aldiwan.net/poem27135.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54892","الرمل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/24207","السريع"],[79,"باتت نجوم الأفق دون علاكا","https://www.poetsgate.com/ViewPoem.aspx?id=34151",""],[94,"قضَّيتُ أدْوارَ الحياة ِ، مُفَكِّراً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14594&r=&rc=39",""],[215,"لولا الغرام بكم لعشت طويلا","https://www.aldiwan.net/poem46322.html","الكامل"],[234,"جرحي بعينيك ليس يندمل","https://www.aldiwan.net/poem50867.html","المنسرح"],[240,"حان إسفار الصباح","https://www.aldiwan.net/poem32120.html","مجزوء الرمل"],[310,"كذبتك نفس غالبت بك كاذبا","https://www.aldiwan.net/poem56598.html","الكامل"],[369,"بكر العواذل أن رأين خصاصتي","https://www.aldiwan.net/poem60953.html","الكامل"],[408,"وافاك يصحبه الإسعاد والظفر","https://www.aldiwan.net/poem46940.html","البسيط"],[430,"نعم الورى بسوابغ النعماء","https://www.aldiwan.net/poem26461.html","الكامل"],[438,"حي وجها من الرياض وسيما","https://www.aldiwan.net/poem12376.html","الخفيف"],[543,"يا ظبية مازلت أتبع ظلها","https://www.aldiwan.net/poem47911.html","عموديه"],[556,"قدني إليك فقد أمنت شماسي","https://www.aldiwan.net/poem47745.html","الكامل"],[556,"لم يبق لي بعد المشيب تصابي","https://www.aldiwan.net/poem48055.html","الكامل"],[996,"","https://poetry.dctabudhabi.ae/diwan/poem/82245","الخفيف"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203781",""],[1280,"","https://poetry.dctabudhabi.ae/diwan/poem/198326","الخفيف"],[1367,"","https://poetry.dctabudhabi.ae/diwan/poem/205473","الطويل"],[1689,"","https://poetry.dctabudhabi.ae/diwan/poem/36163","الرجز"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49585","السريع"],[1762,"","https://poetry.dctabudhabi.ae/diwan/poem/89628","السريع"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87825","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123097","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53110","المديد"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2309,"","https://poetry.dctabudhabi.ae/diwan/poem/140201",""],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109821","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138653",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45858","البسيط"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129414","الخفيف"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40138","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125837","الرمل"],[4108,"","https://poetry.dctabudhabi.ae/diwan/poem/206282","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81270","الخفيف"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103268","الرمل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66161","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72436","الرجز"],[4579,"","https://poetry.dctabudhabi.ae/diwan/poem/205459","الخفيف"],[4631,"","https://poetry.dctabudhabi.ae/diwan/poem/198575","الخفيف"],[4750,"ياسيدي خالد الفيصل","https://www.poetsgate.com/ViewPoem.aspx?id=180430",""],[4968,"تغريدة الكروان","https://www.poetsgate.com/ViewPoem.aspx?id=208101",""],[3271,"دمعة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=104119",""],[5102,"وصية نصر الله للصاروخ رعد","https://www.poetsgate.com/ViewPoem.aspx?id=13183",""],[5131,"سنضحي ما دعت أوطاننا","https://www.poetsgate.com/ViewPoem.aspx?id=42209",""],[5542,"أيها العالم","https://www.poetsgate.com/ViewPoem.aspx?id=10056",""],[4444,"شردت يا هذا شرود البعير","https://www.poetsgate.com/ViewPoem.aspx?id=85447",""],[5674,"أنت الآمره","https://www.poetsgate.com/ViewPoem.aspx?id=203943",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5794,"كنز لا يفنى ..","https://www.poetsgate.com/ViewPoem.aspx?id=80285",""],[5829,"دنيا غرور","https://www.poetsgate.com/ViewPoem.aspx?id=178227",""],[5829,"قلبي لعزة","https://www.poetsgate.com/ViewPoem.aspx?id=213635",""],[5851,"مملكة سبأ المزيفة","https://www.poetsgate.com/ViewPoem.aspx?id=152879",""],[6097,"فرّ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=190668",""],[6331,"خبِّريني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82020&r=&rc=1",""]],"verses":[["شَرَدَت بِنا ذُلُلُ الرِكابِ كَأَنَّما","يَذرَعنَ بُردَةَ كُلِّ قاعٍ مُمحِلِ",0,"ل",1,0],["شَرَدَتْ قَوَافِيهَا وَأضْحَتْ نُزَّعا","عَنِّي فَرَاوَضَهَا اللِّسَانُ وَلاَكَا",1,"ك",2,0],["شَرَّدَت أَهلَكِ النَوائِبُ في الأَر","ضِ وَكانوا كَأَنجُمِ الجَوزاءِ",2,"ا",2,0],["شُرِّدْتُ عن وَطَني الجميل أَنا الشَّقِ","يُّ فَعِشْتُ مَشْطورَ الفؤادِ يتيما",3,"م",2,0],["شُرِّدْتُ للدُّنيا وكُلٌّ تائهٌ","فيها يُرَوِّعُ راحلاً ومقيما",3,"م",2,0],["شردتُ عليه غيرَ جاحِد نعمةٍ","أكَلَّفُ خسفاً بعدَهُ وأُسَامُ",4,"م",1,0],["شَرَّدَ النَومَ عَن جُفونِكَ ضِنُّ","مِن حَبيبٍ بِزَورَةٍ مِن خيالِه",5,"ل",2,0],["شردت فوق رصيف الدمع باحثةً","عن الحنان، ولكن ما وجدت أبا..",6,"ب",2,0],["شرَّدَهم مَذكورُ من دارهِمِ","لا كنتِ من دارٍ ومن منزلِ",7,"ل",1,0],["شَرَّدَتهُم كَفُّ الحَوادِثِ وَالأَي","يامُ مِن بَعدِ جَمعِهِم تَشريدُ",8,"د",1,0],["شرِّدُوا أَخْيَارَهَا بَحْراً وَبَرا","وَاقْتُلوا أَحْرَارهَا حُرّاً فَحُرَّا",9,"ر",2,1],["شرد عن عينيك حلو الكرى","وشاب دنياك بترنيق",10,"ق",1,0],["شردت معانيها وأصبحت ترعا","عني فراوضها اللسان ولاكا",11,"ك",2,0],["شُرِّدْتُ عنن وَطَنِي السَّماويِّ الذي","ما كانَ يوْماً واجمَا، مغمومَا",12,"م",2,0],["شُرِّدْتُ عَنْ وطني الجميل.. أنا الشَّقِ","شقيّ، فعشت مشطورَ الفؤاد، يتيمَا..",12,"م",2,0],["شردت نومي واستبحت مدامعي","لما عزمت عن الديار رحيلا",13,"ل",2,0],["شَرَّدْتُمُ جَعْفَراً وشِيعَتَهُ","بغيرِ ذَنْبٍ جَنَوْا ولاَ افْتَعلوا",14,"ل",3,0],["شُرَّداً تَركَبُ في مَد","حِكَ أَعناقَ الرِياحِ",15,"ح",1,0],["شرّد بنفسك حيث شئت فإنّما","في ثلبها لا زلت ويلك دائبا",16,"ب",2,0],["شَردَتْ جُموعُ المارِقينَ مهابةً","وأوَى إلى الأوطانِ كلُّ شَريد",17,"د",1,0],["شرّدْتَهُمْ في الفَلاَ حَتَّى لو اعترضَتْ","لهم جهنّمُ في نيرانها عَبَروا",18,"ر",3,0],["شَرَدَ الأَعادِي خَوْفُهُ فَكَأَنَّهُمْ","خَرِقُ النَّعامِ بِقَفْرَةٍ بَيْدَاءِ",19,"ا",2,0],["شَرَّدَ الظُّلْمَ والظَّلامَ فقالتْ","خَيْلُهُ في مَغَارِها والظَّليما",20,"م",2,0],["شَرَدَت ومَا كَانَ الشُّرودُ جَفاوةً","لكنهُ مِن شِيمَةِ الغِزلانِ",21,"ن",1,0],["شرّدتَ عنّى كَرْبَهَا من غُمَّةٍ","وعدلتَ لِي الإيحاشَ بالإيناسِ",22,"س",1,0],["شَرّدتهمْ فخيامُهم منبوذةٌ","مِن غير إعمادٍ ولا إطنابِ",23,"ب",1,0],["شرّدَت بِاِدِّكارِها النَّوم عَنّي","وَأُطيرَ العَزاءُ منّي فطارا",24,"ر",2,0],["شرَّدَ الأحرار عن آجامها","وأعزّ العبد فيها والجبانا",25,"ن",2,0],["شرد الجور عدلكم فسرحنا","بينكم بين روضة وسرور",26,"ر",1,0],["شرد النوم عن جفوني وأذكى","بين جنبي نار وجد جزيل",27,"ل",1,0],["شَرّد نومي دنِفا","يرقّ عَلى الغور نَفا",28,"ف",2,1],["شَرَّدَ عن جَفْنِي لذيذَ الكَرَى","ظبيٌ شرودٌ شارِدُ الوَصْل",29,"ل",1,0],["شَرَّدَها زَرِّ بِلَحييهِ من","أَعرافِها والشَعَرِ المُنسَلِ",30,"ل",1,0],["شَرَّدوهُ في الأَرضِ مِن خَوفِهِم مِن","هُ وَجَدَّت جُنودُهُم في اِقتِفائِه",31,"ا",3,0],["شر دهر أيام أحكم فيها","أمره في البلاد واستولاها",32,"ا",3,0],["شرّد النوم غزالاً شردا","أوجد الوجد بقلبي أبدا",33,"د",2,1],["شردت نومي به همم","أسلمت قلبي إلى فكره",34,"ر",2,0],["شَرِّد بِهِم مَن خَلفَهُم واكسِرهُمُ","بَل نَادِ فِي نَادِيهُمُ بأذَانِ",35,"ن",1,0],["شردوها عن التعلم حتى التعلم حتى","ليس تدري الفتاة إلا الشرادا",36,"د",2,0],["شرد كمالك في البلا وانما","رجعت اليك محامدا وودادا",37,"د",2,0],["شردت عترة طه فاغتدت","خيفةً تختار كالوحش القفارا",38,"ر",2,0],["شرد برحلك عَني حَيث شئت وَلا","تَكثر عَليَّ وَدَع عَنكَ الأَباطيلا",39,"ل",2,0],["شرد البغي في كتائب وعظ","هي تجري برغم خيل عتاق",40,"ق",1,0],["شَرَّدْتَهُم مِن خَلفِهِم مُستَنجِداً","ما ظاهَرَ الكُفَّار مَن لَم يَكفُرِ",41,"ر",1,0],["شردوا الأحياءَ منهم","وبهم غَصَّ الطريق",42,"ق",1,0],["شرَّدْتَهُمْ حتى لقد قَاسَوْا على","تلك العِقَابِ أَليمَ كلِّ عِقَابِ",43,"ب",1,1],["شَردت عَنهُم القُلوب إِلى حَي","ث يَرفّ الهَوى نَقياً وَثيقا",44,"ق",2,0],["شردوا الأحقاد عن أوساطهم","أحبطوا بالحزم كيد المفسدين",45,"ن",1,0],["شَرَّدَ النَّوْمَ عَنْ جُفُوني هَواها","مُذْ دَعاني داعي الهَوَى ودَعاها",46,"ا",3,1],["شردت لكن ليس عن فكرة","خيالها يعجز عن ضبطك",47,"ك",1,0],["شردوني عن امتداحي علياً","ورأوا ذاك في داءً دويا",48,"ي",2,1],["شرّد النوم عن جفونك وانظر","حكمةً توقظ النفوس النياما",49,"م",2,1],["شرّد إبكار النشيد أجفل من الصيدي","ومن القنانيص قدها مستذيراتي",50,"ت",2,0],["شردت ظباءُ متيمٍ خفّاقةً","ألقت بها الشهقات في الهذيان",51,"ن",1,0],["شرّدَ اللّيلُ نوْحَنا في حَواشيْ","هِ وَقلْبُ الدجَى سَريرةُ كافِرْ",52,"ر",1,0],["شرّدهمُ أوجِعهمُ أحبِطهمُ","واجعلهمُ يبكون من إذلالِ",53,"ل",1,0],["شرَّد الأبناء واحتلَّ الحمى","أظهر الحقد فلا يثنيه رشدُ",54,"د",1,0],["شرّدوهم إنَّ في تربتهمْ","بطلاً ينمو وعزماً يستجدُّ",54,"د",1,0],["شرَّدتها الحربُ في ليلٍ بهيمٍ","ما لها في زحمة الأحداث قوتُ",55,"ت",1,0],["شردت يا هذا شرود البعير","وطالت الغيبة عند الأمير",56,"ر",1,1],["شرّدتِ حرفي واستبحتِ قصيدتي","وجعلتِ أشعاري بحبكِ حائره",57,"ر",2,0],["شردوهن عقب ماهن في نعيم","ياحمات اديارهن مستضعفات",58,"ت",1,0],["شردونا واقبضوا .. فينا العموله","سا ومونا الارض في مترين خام",59,"م",1,0],["شردتني في أمانيها خطوبي","يا لهذا الكون يسعى في شقائي",60,"ا",3,0],["شردتُهم وغدتْ أنباءُ غزوتنا","تسري على عجلٍ كالريح تنتقلُ",61,"ل",1,0],["شردت في بيدكم حلمي وأحصنتي","أماتها الجوع والتغريب والظمأُ",62,"ا",1,1],["شَرَّدَتْنِي عَذّبَتْنِي","عَلَّمَتْنِي مَا الضَّجَرْ",63,"ر",1,0],["شرَّدتني فيكِ أغنيةٌ","صاغها من لحنهِ المطرُ",64,"ر",1,0],["شردتْ في الأفْقِ أمنيةٌ","والأماني عظمُها نَخِرُ",64,"ر",1,0]]}