{"poems":[[79,"دعا عزماتي والمطية والوخدا","https://www.aldiwan.net/poem36533.html","الطويل"],[47,"عهدي بربعك مأنوسا ملاعبه","https://www.aldiwan.net/poem10906.html","البسيط"],[30,"ضيع أمري الأقعسان فأصبحا","https://www.aldiwan.net/poem1261.html",""],[82,"ألا كم تسمع الزمن العتابا","https://www.aldiwan.net/poem31566.html","الوافر"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9965","الوافر"],[30,"ضيع أمري الأقعسان فأصبحا","https://www.poetsgate.com/ViewPoem.aspx?id=21297",""],[610,"","https://poetry.dctabudhabi.ae/diwan/poem/26692","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122698","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38137","الطويل"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123399","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62593","الطويل"],[1181,"","https://poetry.dctabudhabi.ae/diwan/poem/204061","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108776","الخفيف"],[2467,"","https://poetry.dctabudhabi.ae/diwan/poem/111681","الوافر"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100853","البسيط"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97912","المتقارب"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138466",""],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76493","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83172","الخفيف"],[4816,"المعذره","https://www.poetsgate.com/ViewPoem.aspx?id=12851",""],[4888,"في ظلِّ مكتبتي","https://www.poetsgate.com/ViewPoem.aspx?id=207731",""],[5183,"مُلْغِزَه رق73م","https://www.poetsgate.com/ViewPoem.aspx?id=186395",""],[6093,"جنجفير","https://www.poetsgate.com/ViewPoem.aspx?id=205322",""]],"verses":[["ولوْ أخذَ المِقْدارُ منْكَ مُرادَهُ","وشافَه منْك القُرْبَ لاسْتَوْجَبَ الرّدّا",0,"د",2,0],["وَلَو أَخَفتُ لَئيمَ القَومِ جَنَّبَني","أَذاتَهُ وَصَديقُ الكَلبِ ضارِبُهُ",1,"ب",2,0],["وَلَو أَخَذا أَسبابَ أَمري لَأَلجَآ","إِلى أَشَبِ العِصيانِ أَزوَرَ جانِبُه",2,"ب",2,0],["ولو أخذَ الزّمان بكفّ حرّ","لكان بطبعِهِ أمْراً عُجابا",3,"ب",2,0],["وَلَو أَخلَفتُ وَعدي فيكِ قالَت","بَنو الأَنذالِ إِنّي عَنكِ سالي",4,"ل",2,0],["وَلَوْ أخَذَا أسْبابَ أمْرِي لألْجآ","إلى أشِبِ العِيصانِ أزْوَرَ جانِبُهْ",5,"ب",2,0],["وَلَو أُخاصِمُ أَفعى نابُها لِثقٌ","أَو الأَساوِدَ مِن صُمِّ الأَهاضيبِ",6,"ب",1,0],["وَلَو أُخاصِمُ ذِئباً في أَكيلَتِهِ","لَجاءَني كَلُّهُم يَسعى مَعَ الذيبِ",6,"ب",1,0],["وَلَو اختَبَرتَ حَقيقَ أمري والذي","أُخفيهِ كنتُ بِما مَلَكتَ حَقيقا",7,"ق",2,0],["وَلَو أَخَّرَتْني مِن زماني وُشاتُهُ","فَلي خِدمَةٌ تُقضى بِسبقِ تَقدُّمي",8,"م",2,0],["ولو أُخِّرَ الشيخُ المعريُّ ما ابْتنى","لمن جِيرَةٌ سِيموا النَّوالَ فلم يُنْطوا",9,"ط",3,0],["ولو أخلصُوا حق التوكل صادفوا","بلا سبب رزقاً من الله ممتدّا",10,"د",2,0],["ولو اختبرت مواقفي لوجدتني","في الخدمتين معاً من الأنجاب",11,"ب",1,0],["ولو اختار أن يقول مقالاً","صادقاً قال سيل جودك أغدق",12,"ق",1,0],["ولو اُخرِجتُ من سُقمي لنادى","لهيبُ الشوق بي يرجوه ردّا",13,"د",2,0],["ولو اخذنا لحقن الرقش من دمكم","لكان مصلكم يؤذي الثعابينا",14,"ن",2,0],["ولو أخلص النصح ما لمته","فلا وجه للنصح للعائب",15,"ب",1,0],["ولو اختاروا المعافاة لما","نالها ضر ونالت ما تشاه",16,"ا",2,0],["وَلَو اختَفَت اصواته فكان في","مراه شَخصا اسمعت اصواته",17,"ت",2,0],["وَلَو اِختارَ غَيرَهُ لَمَشَت في","إِثرِهِ مِن مَواكِبِ العِزِّ جُندُ",18,"د",1,0],["ولو اخبي لوعتي الشوق نار","والبلا خيط الامل يا معسره",19,"ر",2,0],["ولو أخّرْتُ خُطْواتي","لَضَجَّ القَلْبُ يَصْطَخِبُ",20,"ب",1,0],["ولو أخذنا يد الثاني بأولها","فرابع فهو فعل شر مكتسب",21,"ب",1,0],["ولو أخلصت ودك كنت عندي","بمنزلة الأمير لدى الوزير",22,"ر",1,0]]}