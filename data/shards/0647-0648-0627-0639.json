{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54722","الكامل"],[113,"أترى أين حل أم أين أمسى","https://www.aldiwan.net/poem16243.html","الخفيف"],[151,"سرح سوادك والطروس سماء","https://www.aldiwan.net/poem47634.html","الكامل"],[422,"جد في وجده بكم فعلاما","https://www.aldiwan.net/poem53970.html","الخفيف"],[469,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[580,"ليل وصل منيرة أقماره","https://www.aldiwan.net/poem3059.html","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65142","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100807","الخفيف"],[5491,"رفيقة الدموع","https://www.poetsgate.com/ViewPoem.aspx?id=197550",""]],"verses":[["هُوَ أَعْجَبُ الخطبَاءِ مَقْدَرَةً عَلَى","أَخْذِ النَّدِيِّ بِمَا نَبَا عَنْهُ النَّدِيِّ",0,"د",2,0],["هَوَ أَعَني مُحَمَد النَدب مَن فا","ق أَياساً وَفي الفَصاحة قَسا",1,"س",2,0],["هو أعلم العلماء واحد عصره","هو طود سرّ هدى له إهداء",2,"ا",2,0],["ه وأعلاهُمُ لديه مقاما","فتمَسَّكْ بهم ولذْ بحماهم",3,"ا",3,0],["هو أعلى شأني وأثبت فضلي","حيث شأنيَّ في جحودٍ ودفع",4,"ع",1,0],["هُو أَعْلَى الوَرَى مَكاناً وقدْراً","قَدْ عَلا مَنْ عُلا الدَّرَارِي ديارُه",5,"ر",2,0],["هُو أعقلُ العلماء إلا أنّه","بين الأفاضل أعلمُ العقلاء",6,"ا",2,0],["هو أعلى من ان يقال مليك","ان عددناه والملوك فأول",7,"ل",1,0],["هو إعصارٌ شديدٌ وأنا","بعض زهرٍ يرشفُ النحلُ رحيقَه",8,"ق",2,0]]}