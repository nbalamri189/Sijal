{"poems":[[104,"هادئ القلب مطبق الأجفان","https://www.aldiwan.net/poem33126.html","الخفيف"],[22,"إن الخليط أجدوا البين فانفرقوا","https://www.aldiwan.net/poem22068.html","البسيط"],[8,"تذكرت والذكرى تهيج للفتى","https://www.aldiwan.net/poem21786.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[112,"راكب اللي كنه السيل النحاوي","https://www.poetsgate.com/ViewPoem.aspx?id=8391",""],[369,"زد علوا في كل يوم ورفعه","https://www.aldiwan.net/poem60844.html","الخفيف"],[466,"خليفة الله مالي كلما بسطت","https://www.aldiwan.net/poem15280.html","البسيط"],[511,"من كبرت عن قدره خطة","https://www.aldiwan.net/poem2431.html","السريع"],[1144,"","https://poetry.dctabudhabi.ae/diwan/poem/199146","الرمل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1399,"","https://poetry.dctabudhabi.ae/diwan/poem/143713","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79846","الرمل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133230","الخفيف"],[4718,"لاعسعس الليل","https://www.poetsgate.com/ViewPoem.aspx?id=137249",""],[4785,"وقفة على الشاطئ","https://www.poetsgate.com/ViewPoem.aspx?id=12037",""],[5198,"غيمة نرجسية","https://www.poetsgate.com/ViewPoem.aspx?id=135531",""],[5652,"يمه حنيني بالمعاني يناجيك","https://www.poetsgate.com/ViewPoem.aspx?id=192042",""],[5956,"يا أبا ثابت أرجوك قل لسميةَ الحسناءا","https://www.poetsgate.com/ViewPoem.aspx?id=205164",""]],"verses":[["مِن كَبير يَزهو بِأَبهى رياش","وَصَغير مصوّر مِن حَنان",0,"ن",1,0],["مُنَكِّبينَ أُفاقاً عَن أَيامِنِهِم","وَعَن شَمائِلِهِم ذو الغِينَةِ القَرِقُ",1,"ق",1,0],["مُنَكِّبَ رَوقَيهِ الكِناسَ كَأَنَّهُ","مُغَشًّى غَمىً إِلاَّ إِذا ما تَنَشَّرا",2,"ر",2,0],["مِن كَبير ومن صَغير وكل","منهما حول القطب ذو تعداء",3,"ا",2,0],["من كبر شخصك....؟ تصيغرة الحكاوي","وصار مدح الناس. في عيني. شتيمه",4,"م",2,0],["مَنكِبُ الأرضِ من نِثارِ الغَوادي","يَكتسي الرَّوضَ دَفعةً بعدَ دَفْعه",5,"ع",2,0],["مُنكِّب العيش خفضاً من تهامُمه","ونازلٍ بشعافِ المجدِ مِحْلالِ",6,"ل",1,0],["من كبُّرت عن قدره خُطةٌ","داخَلَهُ من أَجلها الكبرُ",7,"ر",1,1],["من كباب وضلوع قد زكت","أكلها ينفي عن القلب العلل",8,"ل",1,0],["منكبا او منسطحا أو منتصب","أو ملقى أو مقوسا كما يجب",9,"ب",1,0],["مُنَكِّباً دَرءَ الأَعادِي قَارِعاً","مُدافِعاً ريبَ المَنونِ ضالِعاً",10,"ع",2,0],["منكبٌ كافرٌ وأشراطُ سوءٍ","وعريفٌ جزاؤه حرُّ جمرِ",11,"ر",1,0],["منكَ بدر المجد قَد ألهاه عن","رشأٍ زرَّ على البدر الجيوبا",12,"ب",2,0],["منك بعد الإله ارجو شفائي","فاسقنى من يديك كاس الشفاء",13,"ا",2,0],["من كٌبر ونًات صدري سكر إسموعي","والعبره اللي بحلقي ماقدر أجرعها",14,"ع",3,0],["مَنْكِبٌ حَكَّ مَنْكِباً وجَبينٌ","شَجَّ رَأْساً، عَلامَ هذا الزِّحامُ",15,"م",1,0],["من كبرها كنّها مقلع طميّة","تقْل نيزك طب من فوق وحفرها",16,"ر",3,0],["من كبر حظي يوم انا اقول لبيك","نادي ..؟واجيلك ناصيٍ ل المماتي",17,"ت",2,0],["مِن كُبريات القوم من أصل العُلا","من منبع الإسلام هذا جاءا",18,"ا",3,0]]}