tsgate.com/ViewPoem.aspx?id=33759",""],[6019,"يا أقسى من ليلٍ أسودْ","https://www.poetsgate.com/ViewPoem.aspx?id=202307",""],[6093,"قَدْ نَامَ عَذُولي لَيْتَهُ قَدْ سَهِرا ( دوبيت)","https://www.poetsgate.com/ViewPoem.aspx?id=181641",""],[6097,"عَكّارُنا","https://www.poetsgate.com/ViewPoem.aspx?id=190700",""],[6124,"وحدنا كنا","https://www.poetsgate.com/ViewPoem.aspx?id=174665",""],[6124,"مرجان","https://www.poetsgate.com/ViewPoem.aspx?id=174897",""],[6124,"يا بهي الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=174963",""],[6125,"كَئيبٌ يَملأُ الليلَ اسوِدَادَا","https://www.poetsgate.com/ViewPoem.aspx?id=211073",""],[6218,"آن للصبر يغضب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65868&r=&rc=22",""],[6222,"أطلق يدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1933&r=&rc=4",""],[5190,"الشعر والمشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78334&r=&rc=47",""]],"verses":[["كئيب كأن الدهر لم يلق غيره","عدوّاً فآلى لن يهادنه حربا",0,"ب",2,0],["كي ينقذ الوطن الذي","صرف الومان له بنابه",1,"ب",2,0],["كي يذكروا من مأْرِبٍ معهداً","إنْ غرِقت في سيلها مأرِبُ",2,"ب",1,0],["كي يروم القضاء قَسْراً وأولى","أن يُرام القضاء بالتخييس",3,"س",1,0],["كي يعبدَ اللَه في الفلاة ولا","يشهدَ فيه مشاهد الجُمع",4,"ع",1,0],["كي يستريحوا فيزدادوا براحتِهم","فضلَ اضطلاعِ بما تُسدي يميناكا",5,"ك",2,0],["كَئيباً يَرُدُّ اللَهفَتَينِ لِأُمِّهِ","وَقَد مَسَّهُ مِنّا وَمِنهُنَّ ناطِحُ",6,"ح",1,0],["كَئيبٌ وَحِيدٌ بآلامِهِ","وأَحْلامِهِ شَدْوُهُ الانْتِحابْ",7,"ب",1,0],["كي يُروا الأعداء من أفعالهم","أى لكم بشمال ويمين",8,"ن",1,0],["كَي يَستَريحَ الفَرخُ في الأَثناءِ","فَلا يَمَلُّ ثِقَلَ الهَواءِ",9,"ا",2,0],["كَئيباً تَوَقّاني العَواذِلُ في الهَوى","كَما يَتَوَقّى رَيِّضَ الخَيلِ حازِمُه",10,"م",2,0],["كيْ يموتَ الحسودُ عند رواحي","كاسباً لا بصفقة المغبونِ",11,"ن",1,0],["كَئيبٍ واكِفِ العَينَي","نِ بِالحَسَراتِ مُنفَرِدِ",12,"د",1,0],["كَي يَجِدُوا ذَنباً لَنا","وَكُلَّ أَرضٍ ضَرَبُوا",13,"ب",3,0],["كي يَنْزِعوا من بين فكَّيهِ لهم","حقًّا صُراحًا حان يوم قضائه",14,"ا",3,0],["كي يعلموا أن الكنانةَ أمةٌ","طابت فروعًا في الورى وأصُولا",15,"ل",2,0],["كي يشِبُّوا على حميد السجايا","وعلى عزَّة النفوس المصونة",16,"ن",2,0],["كي يعلمَ الملوان أنَّ","بمصر شَعْبًا لا يَبيد",17,"د",1,0],["كئيب بطيء الخطا مؤلم","يسير إلى حيث لا يعلم",18,"م",1,1],["كئيب يخوّفه ظلمه","فيرتاع من ظلّه الأروع",19,"ع",1,0],["كَيْ يردعَ القومَ من عصيان خالِقهم","ليعملَ الصالحاتِ العربُ والعجمُ",20,"م",1,0],["كي يقولوا فُلانةٌ ذاتَ جُودٍ","والغَوَاني يُحبِبْنَ قولَ الرُّبَاءِ",21,"ا",2,0],["كَي يَسمَعوا مِن وَقعِ ما قُلِّدتَ ما","يُنسيهُمُ الأَهزاجَ وَالأَرمالا",22,"ل",2,0],["كئيبٌ غُروبي وكُلّي غُروبُ","وليلي لطيمٌ وحُزني جنوبُ",23,"ب",1,1],["كي يستفيدَ ثلاثا منك وهْي له","إلى تَصرُّم حولٍ أشرف الزّادِ",24,"د",1,0],["كي يستفِزّاك أو لِتقطَع ما","بينك من لحُمةٍ وما بيني",25,"ن",2,0],["كئيبٌ فوقه غُصُنٌ","وَغُصنٌ فوقه قَمَرُ",26,"ر",1,0],["كَي يروا خاشعين داعين لل","هِ بحالِ الإرغاب والإرهابِ",27,"ب",1,0],["كَئيباً بِمَن أَهوى وَعَقلي ذاهِبُ","غَدا عاذري في الحُبّ مَن كانَ عاذِلاً",28,"ا",1,0],["كي يَخْدُمَ المولَى المُعين لو ارتضَى","بالنسْخِ في ديوانِ الاستيفاء",29,"ا",2,0],["كَئيب لا يَسرُّ وَلا","بِحال القُرب وَالأُنس",30,"س",1,0],["كئيبٌ من جفونك في سقام","فَعالِجهُ وإلاّ فهو هالك",31,"ك",1,0],["كي يرى في كل من يحْ","سُدُه عيباً وشَيْنا",32,"ن",2,0],["كي يرى صحة ما قد هذر","ذلك الوغد الحسود الدميم",33,"م",1,0],["كي يجلبوهم فذهب","ما للهلال الأحمر",34,"ر",1,0],["كئيبٌ قَصيرُ الباعِ لا نورَ عندَهُ","على ظُلمَةٍ بَحْتاءَ سَرْبَلَهُ ظُلْمُ",35,"م",1,0],["كيْ يحيلَ ابناءَها كالعبيدِ","لا يميزونَ الغَيّ من الرشادِ",36,"د",1,0],["كئيب الضّمير وإن كنت بالت","تجلّد مبتسمَ الظّاهرِ",37,"ر",1,0],["كي يثبتوا بموضع الصلاة","إلى انقضا الخطبة فيما يأتي",38,"ي",1,0],["كئيباً يوفي بعدك الحزن حقه","فلا الدمعُ خوَّانٌ ولا الهمُّ خوَّارُ",39,"ر",1,0],["كي يلثموا يدك الكريمة أمطرت","بركاتها من غير ما استمطار",40,"ر",1,0],["كي يصلحوا شعبا عريقا في العلى","تاريخه هو زينة الأسفار",40,"ر",1,0],["كَي يرفَعوا العلم الّذي في ظلّه","تُحمى الثغورُ وتحفظ الأوطانُ",41,"ن",1,0],["كَي يُشرِقَ نوراً عَلى جَوانِبِ جِسمي","مِن وَجهِكَ بَدرٌ مِن البَشاشَةِ ريّان",42,"ن",1,0],["كي يظلَّ العَرينُ بيتاً طهُوراً","مِن أسُودِ الشَّرى تسيلُ الدماءُ",43,"ا",2,0],["كئيب أمَني النفس بالقرب في الهوى","ومن لي بوصل منك أو بتقرب",44,"ب",1,0],["كَئِيبٍ وَمِنْ فَرْطِ الضَّنى قَدْ تَشَوَّشَا","تَوَلَّى زَمَاني فِي صُدُودٍ وَفي مَلَلْ",45,"ل",1,0],["كَئِيبٌ مُعَنَّى لاَ يَرِقُّ أَنِينُهُ","إلى نَحْوِ مَنْ يَهْوَاهُ زَادَ حَنِينُهُ",46,"ه",1,0],["كَئِيباً مُعَنَّى ظَلَّ يَبْكِي تَأَسُّفَا","عَلىَ صَفْوِ عَيْشٍ قَدْ تَكَدَّرَ بِالضَّنْكِ",47,"ك",1,0],["كئيب حزين نازح الدار شفه","سقام كما شاء الغرام مذيب",48,"ب",1,0],["كئيب إذا ما أضرم الوجد ناره","جرى الدمع من عينيه في خده دما",49,"م",2,0],["كئيب ما النسيم سرى عليلاً","لهُ إلّا اِنثنى دَنِفاً عليلا",50,"ل",2,1],["كئيب ليس يردعهُ ملامٌ","وَإِن نصح الملوّم في الملامِ",51,"م",1,0],["كئيبٌ نأى عنهُ الرقادُ لهجركم","فَناظرهُ لَم يَكتحل برقادهِ",52,"د",2,0],["كئيب دعاهُ الحبُّ حتّى أجابهُ","سريعاً وفي أتباعه لم يلاجهِ",53,"ج",2,0],["كئيباً لليلات الغميم متيَّماً","معنًّى بأيام الحجون مولَّعا",54,"ع",2,0],["كَئيباً إِذا الجَوزاءُ أَمسَت كَأَنَّها","صُوارٌ بِوَعساءِ الصَريمَةِ أُيَّدُ",55,"د",1,0],["كي يقطف المدنف تفاحة","مرصودة سبحان من صانها",56,"ن",3,0],["كي يلمع السيفان في وقتٍ معا","مليكٌ يسير المجد تحت لوائهِ",57,"ه",1,0],["كَئيب قلب بهيت لب","فَقيد عبد وَحيد رب",58,"ب",1,1],["كي يَرَى زحمةَ الشِّفاه على لَثم","بنانٍ يشفي الصّدَى صَفَّاحِ",59,"ح",1,0],["كَي يَشهَدوا أَنَّ الفَضائِلَ قُسِّمَت","بِالفَضلِ بَينَ مُقَدَّمٍ وَمُؤَخَّرِ",60,"ر",1,0],["كَي يَشهَدُونَ وَيَعرُوجُونَ إِلَيهِ بِال","أعمَالِ سُبحَانَ العَظِيمِ الشَّانِ",61,"ن",1,0],["كَي يُبرِزَ المعقُولَ فِي صُورٍ مِنَ ال","مَحسُوسِ مَقبُولاً لِذِي الأذهَانِ",61,"ن",1,0],["كَي يَحصُلَ الإِعلاَمُ بِالمَقصُودِ مِن","إيرَادِهِ وَيَصِير فِي الأذهَانِ",61,"ن",1,0],["كئيب دمعه كالغيث يهمي","إذا أبدى له البرق ابتسامه",62,"م",2,0],["كي يجتني من حسنك الزاهي ويسكره","طلا حبيك كالصهباء",63,"ا",1,0],["كي يعود المجد مجد المسلمين","ونرى الإسلام في أبهى الحلل",64,"ل",1,0],["كي ينجّيني من خطبٍ خطير","جاءَني من نسل قنطورا اللئيم",65,"م",1,0],["كئيبة النفس حيرى","لم أدر أين ذهابي",66,"ي",1,0],["كَئيباً يُمَنّي نَفسَهُ بِلِقائِهِ","عَلى نَأيِهِ وَاللَهُ بِالحُزنِ يَشهَدُ",67,"د",1,0],["كى يَستَفِيدَ مِن هُدَى الدَّلِيلِ","مَعرِفَةَ المُصَوِّرِ الجَلِيلِ",68,"ل",1,0],["كَى يُبلِغُونَا أمرَهُ وَنَهيَه","فَمَن أجابَهُم غَداذَا نُهيَه",68,"ه",1,0],["كَي يَقول البَدرُ فَوزا","نَسير المشكاة لاح",69,"ح",1,0],["كَي يَجِدوا مِثلَ ما وَجَدتُ فَقَد","أَصبَحتُ نِضواً وَمَسَّني الوَجَعُ",70,"ع",1,0],["كئيب حزين واكف الدمع هامله","تخوّنه من آجل البين عاجله",71,"ل",2,1],["كي يداني يثربا شوقا إلى","من على فرقته الركن حزين",72,"ن",1,0],["كئيبٌ بهِ حالانِ في الحزن والبكا","أجيجٌ مقيمٌ والدموعُ بحورُ",73,"ر",1,0],["كئيبٌ إن ترحَّلَ عنه جيشٌ","من البلوى أناخ به جيوشُ",74,"ش",1,0],["كي يحصل السول بالمجمع ويصفو الوداد","وصل ربي وسلم عد مزن الرهاد",75,"د",1,0],["كئيبُ الفؤادِ طويلُ الدنَف","قليلُ العزاء كثيرُ الأسَف",76,"ف",1,1],["كئيبٌ مُكمَدٌ دَنِفٌ","بمن ما مسَّه كَمَدُ",77,"د",1,0],["كئيب نحيل واجد متشوف","غريب عليل فاقد متشوق",78,"ق",1,0],["كي يسرّ الصديق بالعفو عنّي","مثل ما سر بالنكير الأعادي",79,"د",2,0],["كي يناغى ظلّاً لكم يا هويفي","فاتناً يستميله ُ كي يمنحْ",80,"ح",1,0],["كي ينظروا حالنا والشمس مشرقة","وأمة العرب تهوى السير في الظُلم",81,"م",1,0],["كي يهتدي من ضَلَّ في","دربِ الهوَى مُتعثرا",82,"ر",2,0],["كي يستنيرَ بنوركم","حتى يُرَى مُتبصِّرا",82,"ر",2,0],["كي يرتوي منه الذي","لا ترتوي أحشاؤه",83,"ا",3,0],["كي يزولَ البلاء والضر عنه","بعد أمرٍ جرى عليه مَخوف",84,"ف",1,0],["كئيبٌ تراه يظهرُ الصبر جهده","على أن دمع العين بالشوق ناطق",85,"ق",1,0],["كئيبٌ بالنهار حليف حزنٍ","أخو ليلٍ اذا ذهب النهار",86,"ر",1,0],["كي يُراحَ الفؤادُ من طولِ شوقٍ","قد سَقاه الهوى بكأسِ الحِمامِ",87,"م",1,0],["كَيْ يَطْرَبُ السَّاْدَةُ الثُّوَّاْرُ فِيْ زَمَنٍ","أَمْسَىْ لِيُصْبِحَ فِيْ أَحْضَاْنِ ثُوَّاْرِ",88,"ر",1,0],["كَيْ يَحْفَظَ اللهُ عَفْرَاْءَ الَّتِيْ سَلَبَتْ","عَقْلِيْº فَنَاْجَيْتُ أَطْيَاْراً عَلَى الشَّجَرِ",89,"ر",1,0],["كَيْ يُصْلِحَ التَّذْكَاْرُ ما قَدْ شَوَّهَتْ","بَعْضُ اللَّيَاْلِيْ خِلْسَةًº وَسِفَاْحَاْ",90,"ح",2,0],["كي ينجب الروض من بعد استقالته","وردا وقافية مستعرضا درره",91,"ر",2,0],["كي يذكر الخلان أمجاده","فصورة الذات حديث جللْ",92,"ل",1,0],["كي يُثبِتوا مِقدَارَ أُمّتِهِمْ","في كُلِّ قانونٍ ودستورِ",93,"ر",1,0],["كي يحشد كل معارفه","للدفع إذا أعْيَى أهلَهْ",94,"ل",2,0],["كيْ يُقرَّ العينَ نصرٌ","أوْ أنَا أقضي شهيدْ",95,"د",1,0],["كي يسطلون وليلهم سمرٌ","حلَّ الصباحُ وقد غدوا حطبا",96,"ب",2,0],["كئيبةٌ آهكِ الصمَّاءُ سيدتي","بالرغم من أنّها للمشتكي راحهْ",97,"ح",2,0],["كي يفيء الصباح يختال بشرا","في الروابي وينجز الميعادا",98,"د",2,0],["كي يَسقِيَ ابراهيمُ نخلَةَ أرضِهِ","ويُعانِقَ الأقصى الشّريفُ خليلَه",99,"ل",2,0],["كي يحسبوا أنفاسهنَّ بلحظةٍ","فلهمْ مكوثٌ دائمٌ وجلوسُ",100,"س",1,0],["كي يجعلوا زمن الأحجار مزرعةً","فيها الورود تباهي ساحة الدارِ",101,"ر",1,0],["كي يدخل الفأران في","قفص الردى ذي الجلجلةْ",102,"ل",2,0],["كي ينبتَ الزهرُ في أضلاعها أمما","وينسج النور من أصلابها مُهجا",103,"ج",2,0],["كي يستلذّ بقبلةٍ","شبقيّةٍ متدافعة",104,"ع",2,0],["كئيب وأصلته شجون شوق","جفا بوصالها طوعاً منامه",105,"م",2,0],["كئيب غدا ثوب السقام موسعاً","عليه وثوب الاصطبار مضيفا",106,"ف",2,0],["كي يقرأ في الباب الموصود","تناقضَ كاذبِ أعذارك..",107,"ك",1,0],["كيْ ينبتَ الثابوتُ بعدَ بكائِهمْ","قمحًا فَتزْرعَه السِّنونَ المقفرَةْ",108,"ر",2,0],["كَئِيبٌ نَأَى عَنْهُ الحَبِيبُ وَلَمْ يَصِلْ","لَهُ مِنْهُ إِلاَّ طَيْفُهُ وَلِمامُهُ",109,"م",2,0],["كَئِيبٌ نَأَى عَنْهُ أَحْبابُهُ","وَبُتَّتْ مِنَ الوَصْلِ أَسْبابُهُ",110,"ب",2,1],["كَئِيبٌ دَعاهُ الحُبُّ حَتَّى أَجابَهُ","سَرِيعاً وَفِي إِتْباعِهِ لَمْ يُداجِهِ",111,"ج",2,0],["كَئِيبٌ نأَى عَنْهُ الرُّقادُ بِهَجْرِكُم","فَناظِرُهُ لَمْ يَكْتَحِلْ بِرُقادِهِ",112,"د",2,0],["كَي يُلاقي في عُمرِهِ بَعضَ سَلوَى","بَعدَ نَبْذٍ ، كَنَبذِ جُربِ الخُيُولِ",113,"ل",1,0],["كَيْ يَسُودَ الدِّينُ وَالنُّورُ الدُّجَى","وَيُفَكَّ الأَسْرُ عَنْ عَانٍ مُضَامِ",114,"م",1,0],["كي يعلم الشعراءُ أي أميرةٍ","هي أنتِ.. في ظلِّ القصيدةِ خافية",115,"ي",2,0],["كَيْ يُؤْمِنوا باللّهِ ربّاً واحِداً","ويُسَبِّحوهُ 