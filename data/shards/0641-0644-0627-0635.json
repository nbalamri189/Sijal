{"poems":[[53,"يقولون نم في هدنة الدهر آمنا","https://www.aldiwan.net/poem30405.html","الطويل"],[53,"عذيري من العشرين يغمزن صعدتي","https://www.aldiwan.net/poem30678.html","الطويل"],[77,"أشارت غداة البين من خلل السجف","https://www.aldiwan.net/poem35976.html","الطويل"],[86,"نعاك النعاة وحم القدر","https://www.aldiwan.net/poem10471.html","المتقارب"],[71,"لو لم يخالط يوم بينك أدمعي","https://www.aldiwan.net/poem4029.html","الكامل"],[30,"لمية أطلال بحزوى دوائر","https://www.aldiwan.net/poem29586.html","الطويل"],[27,"ألا حي المنازل بالجناب","https://www.aldiwan.net/poem5664.html","الوافر"],[27,"أقلي اللوم عاذل والعتابا","https://www.aldiwan.net/poem5686.html","الوافر"],[51,"يا من قسا لما شكوت","https://www.aldiwan.net/poem66509.html","مجزوء الكامل"],[70,"بحق الله متع","https://www.aldiwan.net/poem42959.html","الهزج"],[89,"لقد كان سعد خير قوم مجاهد","https://www.aldiwan.net/poem44614.html","الطويل"],[62,"أصالة الرأي صانتني ( لامية العجم )","https://www.aldiwan.net/poem52315.html","البسيط"],[62,"هو الشوق حتى ما تقر المضاجع","https://www.aldiwan.net/poem52357.html","الطويل"],[28,"لئن صبر الحجاج ما من مصيبة","https://www.aldiwan.net/poem5279.html","الطويل"],[61,"محلك مثل الغاب ليس يرام","https://www.aldiwan.net/poem51457.html","الطويل"],[87,"خلعت في حب غزلان الحمى رسني","https://www.aldiwan.net/poem8236.html","البسيط"],[69,"علام أردت تهجرني علاما","https://www.aldiwan.net/poem28897.html","الوافر"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[81,"مضى الوصل إلا منية تبعث الأسى","https://www.aldiwan.net/poem61446.html","البسيط"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[50,"صحا القلب عن سلمى وشاب المعذر","https://www.aldiwan.net/poem63808.html","الطويل"],[46,"رب متى أرحل عن هذه ال","https://www.aldiwan.net/poem23429.html","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42815","البسيط"],[116,"يأيها المتمني ما عداه أفق","https://www.aldiwan.net/poem2360.html","البسيط"],[155,"سلكان للدمع محلول ومعقود","https://www.aldiwan.net/poem55734.html","البسيط"],[160,"يشاركك المغتاب في حسناته","https://www.aldiwan.net/poem59137.html","الطويل"],[189,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[189,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[198,"غداة النوى زمت لبين ركائب","https://www.aldiwan.net/poem51981.html","الطويل"],[204,"وافى مرابعه الغزال الأحور","https://www.aldiwan.net/poem53309.html","الكامل"],[235,"عصر الشباب تصرمت أوقاته","https://www.aldiwan.net/poem32134.html","الكامل"],[270,"أفيقي فردي بسمة وسلاما","https://www.aldiwan.net/poem35622.html","الطويل"],[275,"تناضل عن دين الهدى وتدافع","https://www.aldiwan.net/poem25485.html","الطويل"],[298,"ذر العين تقض اليوم بعضض ديونها","https://www.aldiwan.net/poem36325.html","عموديه"],[353,"لو كان يوفي في الهوى بوعوده","https://www.aldiwan.net/poem40393.html","الكامل"],[364,"أرغمت آنف حاسديك بسفرة","https://www.aldiwan.net/poem60682.html","الكامل"],[364,"ذكر المعسكر صاحبي ذكرا","https://www.aldiwan.net/poem60913.html","أحذ الكامل"],[409,"يا حاضرا بفؤاد ناء غائب","https://www.aldiwan.net/poem32591.html","الكامل"],[416,"أما والعين تبكيها طلول","https://www.aldiwan.net/poem53867.html","الوافر"],[437,"فؤاد عصاه صبره وهو طالبه","https://www.aldiwan.net/poem2577.html","الطويل"],[439,"بقاء الخلائق رهن الفناء","https://www.aldiwan.net/poem34882.html","المتقارب"],[458,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[464,"عيون المهى قلبي بنبلك مجروح","https://www.aldiwan.net/poem3149.html","عموديه"],[464,"لقد غاض بحر العلم بعد أخي العلم","https://www.aldiwan.net/poem3167.html","عموديه"]],"verses":[["فَلا صُلحَ حَتّى لا يَكونَ لِواجِدٍ","ثَراءٌ وَلا يَبقى عَلى وافِرٍ وَفرُ",0,"ر",1,0],["فَلا صُلحَ حَتّى تَسمَعوا مِن أَزيزِها","صَواعِقَ إِمّا صَكَّتِ الأُذنَ صُكَّتِ",1,"ت",1,0],["فَلا صاغَ معْنىً يُسْتَضاءُ لنورِه","جَناني ولا خطّتْ بَناني في حرْفِ",2,"ف",1,0],["فَلا صَدَّ تَخشاهُ بَعدَ الوِصالِ","وَلا ضَعفَ تَشكوهُ بَعدَ الأَشَر",3,"ر",1,0],["فَلَأَصبِرَنَّ عَلى الزَمانِ وُجَورِهِ","صَبرَ اِمريءٍ مُتَجَمِّلٍ لَم يَخضَعِ",4,"ع",1,0],["فلَا صَبرَ إِن تَستَعبرِ العَينُ إِنَّني","عَلى ذاكَ إِلا جَولَةَ الدَمعِ صابِرُ",5,"ر",1,0],["فَلا صَفوٌ جَوازُكَ عِندَ سَعدٍ","وَلا عَفُّ الخَليقَةِ في الرِبابِ",6,"ب",1,0],["فَلا صَلّى الإِلَهُ عَلى نُمَيرٍ","وَلا سُقِيَت قُبورُهُمُ السَحابا",7,"ب",2,0],["فلأَصبرنَّ وأكظِمَنْ","نَ وإن لظى غيظي كواني",8,"ن",2,0],["فَلا صُبِّحتَ بِالخَيرِ","وَلا مُسّيتَ بِالسَعدِ",9,"د",1,0],["فلا صبر ما لم ينقض الدهر حكمه","وما لم يكن سعد إليهم بعائد",10,"د",1,0],["فلا صديقَ إليه مشتكَى حزَنِي","ولا أنيسَ إليه منتَهى جذلي",11,"ل",2,0],["فلا صدرهُ في أزمةِ الخَطْبِ ضَيِّقٌ","ولا عُرْفُهُ من طالبِ الفضل شاسعُ",12,"ع",1,0],["فَلا صَبرَ إِلّا دونَ صَبرٍ عَلى الَّذي","رُزِئتَ عَلى يَومٍ مِنَ البَأسِ أَشنَعا",13,"ع",2,0],["فلا صُلحَ حتى تُستطارَ سِواعِدٌ","وتَسقُطَ أيدٍ في اللِّقاءِ وهَامُ",14,"م",1,0],["فَلا صَدِيقَ عَلَى وُدٍّ بِمُتَّفِقٍ","وَلا خَلِيلَ عَلَى سِرٍّ بِمُؤْتَمَنِ",15,"ن",1,0],["فلا صدقْتَ في قولٍ كذوباً","ولا استأمنْتَ مَنْ أكلَ الحراما",16,"م",2,0],["فلا صَيحاتُ فنزيلوس تُجدِي","ولا كِرزونُ يطمع أن يُبينا",17,"ن",2,0],["فَلا صَرَّدَ اللَهُ الشَرابَ الَّذي سَقى","وَلا خَلَعَ اللَهُ الرِداءَ الَّذي كَسا",18,"س",2,0],["فلا صَفَدٌ منكُمْ إذا لم يكُنْ غِنىً","ولا مِنّةٌ طَوْلٌ إذا لم تُتَمَّمَ",19,"م",1,0],["فَلا صَبرَ إِنّي مُقرَنٌ بِاِبنِ حُرَّةٍ","غَداً فَاِعرِفاني وَالرَدى حينَ أَضجَرُ",20,"ر",1,0],["فَلا صَديقٌ يَتَرَجّى يَدي","وَلا عَدُوٌّ يَتَخَشّى اِنتِقام",21,"م",1,0],["فَلا صَدِيقَ يُرَاعِي غَيْبَ صَاحِبِهِ","وَلا رَفِيقَ عَلَى الأَسْرَارِ يُؤْتَمَنُ",22,"ن",1,0],["فلا صَنيعةَ إِلّا وهي ضائعةٌ","فيه وليس على وَهن بمُصطَبر",23,"ر",1,0],["فَلا صَفا كَدَرُ الدُّنْيا لِمُصْفِيَةٍ","ما جاهَدَتْ فيكِ أنْفاسي المَجاهيدُ",24,"د",1,0],["فلا صالح يجزى به بعد موته","ولا حسن يثني به في حياته",25,"ت",2,0],["فَلا صامَ لا صلّى ولا حجّ لا حبى","فَقيراً وإِن أَودى به فقرهُ برّا",26,"ر",2,0],["فَلا صامَ لا صلّى ولا حجّ لا له","زَكاةٌ ولا أعمالُ برٍّ بها برّا",27,"ر",2,0],["فلا صبحَ إلا من محيَّا خريدةٍ","ولا ليلَ إلا فوقَ صُبحٍ ذوائب",28,"ب",1,0],["فلأصبِرَنْ ولأكتمنَّ صبابتي","فعسى أفوز بما أُحبَّ وأظفرُ",29,"ر",1,0],["فَلَأَصرِ فَنَّ الشِعرَ إِلّا عَن فَتىً","كَالسَيفِ تَلمَعُ بِالضُحى جَفَناتُهُ",30,"ت",2,0],["فلا صبر لي يا أُمّ عنكِ فإن يَكُن","لكِ الصّبرُ عنّي قد رضيتُ تماما",31,"م",2,0],["فَلا صامِتٌ إِلا بِشُكْرِكَ نَاطِقٌ","وَلا خالِعٌ إِلا لأَمْرِكَ خَانِعُ",32,"ع",1,0],["فلا صبر أو ينسى الفؤادُ غرامَها","وهيهاتَ لا يرضى الفؤادُ بدونها",33,"ن",3,0],["فَلأَصبرنَّ عَلى هَواه وَلَو بِهِ","صَرفت صُروف الوَجد قَلبَ عَميدهِ",34,"د",2,0],["فلأصفحَنَّ عنِ الزّمانِ وما جنَى","إذْ عاد عَودةَ نادمٍ مُتنَصِّل",35,"ل",1,0],["فلأَصفحَنّ عنِ الّذين قَضَوْا","عُرْفاً أتَى الأقوامُ أم نُكْرا",36,"ر",2,0],["فَلأَصبِرَنَّ عليكَ لا من سَلْوةٍ","صبرَ الكليمِ على أداةِ السّابِرِ",37,"ر",1,0],["فلا صبرٌ على نأيٍ مقيمٌ","ولا دَمعٌ على سرٍّ أمين",38,"ن",1,0],["فلا صبر إنّ الصبر محّت رسومهُ","ولا مهل قد غصّ بالماء شاربه",39,"ب",2,0],["فلا صدرَ إِلّا حريقٌ بنارٍ","ولا جَفنَ إِلّا غَريقٌ بماءِ",40,"ا",2,0],["فَلأُصفينَّك كلَّ سائرةٍ","في الريح سائلةٍ مع الوبلِ",41,"ل",1,0],["فلا صدرَ إلاَّ بالأسى متضرمٌ","ولا جفن إلاّ بالمدامع مقروح",42,"ح",1,0],["فلا صبر من بعد الفضائل والعلى","وصفو النهى والعلم والأدب الجم",43,"م",1,0]]}