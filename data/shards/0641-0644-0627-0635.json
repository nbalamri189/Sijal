{"poems":[[55,"يقولون نم في هدنة الدهر آمنا","https://www.aldiwan.net/poem30405.html","الطويل"],[55,"عذيري من العشرين يغمزن صعدتي","https://www.aldiwan.net/poem30678.html","الطويل"],[79,"أشارت غداة البين من خلل السجف","https://www.aldiwan.net/poem35976.html","الطويل"],[88,"نعاك النعاة وحم القدر","https://www.aldiwan.net/poem10471.html","المتقارب"],[73,"لو لم يخالط يوم بينك أدمعي","https://www.aldiwan.net/poem4029.html","الكامل"],[32,"لمية أطلال بحزوى دوائر","https://www.aldiwan.net/poem29586.html","الطويل"],[29,"ألا حي المنازل بالجناب","https://www.aldiwan.net/poem5664.html","الوافر"],[29,"أقلي اللوم عاذل والعتابا","https://www.aldiwan.net/poem5686.html","الوافر"],[53,"يا من قسا لما شكوت","https://www.aldiwan.net/poem66509.html","مجزوء الكامل"],[72,"بحق الله متع","https://www.aldiwan.net/poem42959.html","الهزج"],[91,"لقد كان سعد خير قوم مجاهد","https://www.aldiwan.net/poem44614.html","الطويل"],[64,"أصالة الرأي صانتني ( لامية العجم )","https://www.aldiwan.net/poem52315.html","البسيط"],[64,"هو الشوق حتى ما تقر المضاجع","https://www.aldiwan.net/poem52357.html","الطويل"],[30,"لئن صبر الحجاج ما من مصيبة","https://www.aldiwan.net/poem5279.html","الطويل"],[63,"محلك مثل الغاب ليس يرام","https://www.aldiwan.net/poem51457.html","الطويل"],[89,"خلعت في حب غزلان الحمى رسني","https://www.aldiwan.net/poem8236.html","البسيط"],[71,"علام أردت تهجرني علاما","https://www.aldiwan.net/poem28897.html","الوافر"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[83,"مضى الوصل إلا منية تبعث الأسى","https://www.aldiwan.net/poem61446.html","البسيط"],[77,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[52,"صحا القلب عن سلمى وشاب المعذر","https://www.aldiwan.net/poem63808.html","الطويل"],[48,"رب متى أرحل عن هذه ال","https://www.aldiwan.net/poem23429.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42815","البسيط"],[120,"يأيها المتمني ما عداه أفق","https://www.aldiwan.net/poem2360.html","البسيط"],[159,"سلكان للدمع محلول ومعقود","https://www.aldiwan.net/poem55734.html","البسيط"],[164,"يشاركك المغتاب في حسناته","https://www.aldiwan.net/poem59137.html","الطويل"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[202,"غداة النوى زمت لبين ركائب","https://www.aldiwan.net/poem51981.html","الطويل"],[208,"وافى مرابعه الغزال الأحور","https://www.aldiwan.net/poem53309.html","الكامل"],[240,"عصر الشباب تصرمت أوقاته","https://www.aldiwan.net/poem32134.html","الكامل"],[275,"أفيقي فردي بسمة وسلاما","https://www.aldiwan.net/poem35622.html","الطويل"],[280,"تناضل عن دين الهدى وتدافع","https://www.aldiwan.net/poem25485.html","الطويل"],[303,"ذر العين تقض اليوم بعضض ديونها","https://www.aldiwan.net/poem36325.html","عموديه"],[358,"لو كان يوفي في الهوى بوعوده","https://www.aldiwan.net/poem40393.html","الكامل"],[369,"أرغمت آنف حاسديك بسفرة","https://www.aldiwan.net/poem60682.html","الكامل"],[369,"ذكر المعسكر صاحبي ذكرا","https://www.aldiwan.net/poem60913.html","أحذ الكامل"],[415,"يا حاضرا بفؤاد ناء غائب","https://www.aldiwan.net/poem32591.html","الكامل"],[422,"أما والعين تبكيها طلول","https://www.aldiwan.net/poem53867.html","الوافر"],[443,"فؤاد عصاه صبره وهو طالبه","https://www.aldiwan.net/poem2577.html","الطويل"],[445,"بقاء الخلائق رهن الفناء","https://www.aldiwan.net/poem34882.html","المتقارب"],[463,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[469,"عيون المهى قلبي بنبلك مجروح","https://www.aldiwan.net/poem3149.html","عموديه"],[469,"لقد غاض بحر العلم بعد أخي العلم","https://www.aldiwan.net/poem3167.html","عموديه"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83315","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38927","الطويل"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18501","الطويل"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/77448","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70992","الوافر"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136261","الوافر"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109273","البسيط"],[1510,"","https://poetry.dctabudhabi.ae/diwan/poem/147562",""],[1610,"","https://poetry.dctabudhabi.ae/diwan/poem/115030","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49606","الوافر"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132275","البسيط"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11204","الطويل"],[1892,"","https://poetry.dctabudhabi.ae/diwan/poem/96244","الكامل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76614","الطويل"],[2173,"","https://poetry.dctabudhabi.ae/diwan/poem/142750","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53204","الوافر"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32590","الكامل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121181","الطويل"],[2502,"","https://poetry.dctabudhabi.ae/diwan/poem/35000","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94320","الرجز"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58354","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202768","المجتث"],[3109,"","https://poetry.dctabudhabi.ae/diwan/poem/102848","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132746","المتقارب"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123924","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48313","الطويل"],[533,"","https://poetry.dctabudhabi.ae/diwan/poem/111569","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109996","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86527","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101370","الطويل"],[4181,"","https://poetry.dctabudhabi.ae/diwan/poem/60","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102754","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90803","الكامل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135068","البسيط"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147275","الوافر"],[4759,"تسائلني عنها","https://www.poetsgate.com/ViewPoem.aspx?id=207054",""],[4914,"بمن أتداوى والدوا معك وسدوا","https://www.poetsgate.com/ViewPoem.aspx?id=170940",""],[5002,"جائحةُ العصرِ.....","https://www.poetsgate.com/ViewPoem.aspx?id=211792",""],[5065,"مكاشفة الغموض","https://www.poetsgate.com/ViewPoem.aspx?id=205181",""],[5112,"سجدتي كمامتي","https://www.poetsgate.com/ViewPoem.aspx?id=211145",""],[5121,"صُورَةُ الذِّكْرَى","https://www.poetsgate.com/ViewPoem.aspx?id=213487",""],[5136,"شمس الهدى وسراج الظلم","https://www.poetsgate.com/ViewPoem.aspx?id=121670",""],[5376,"عجباً من الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=188267",""],[5431,"شاعر بدون مشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=183016",""],[5431,"صفاقة ...","https://www.poetsgate.com/ViewPoem.aspx?id=213693",""],[5563,"غيداء لعوب","https://www.poetsgate.com/ViewPoem.aspx?id=211741",""],[470,"سلاماً يا أعزَّ النّاس","https://www.poetsgate.com/ViewPoem.aspx?id=178033",""],[5616,"مزاج","https://www.poetsgate.com/ViewPoem.aspx?id=203198",""],[5616,"أبا الطيب عذراً","https://www.poetsgate.com/ViewPoem.aspx?id=203454",""],[5616,"انا","https://www.poetsgate.com/ViewPoem.aspx?id=207396",""],[5736,"ملاك","https://www.poetsgate.com/ViewPoem.aspx?id=203875",""],[5855,"قربت لي أملاً فأصبح حسرة","https://www.poetsgate.com/ViewPoem.aspx?id=186651",""],[5916,"الى ليلى ...","https://www.poetsgate.com/ViewPoem.aspx?id=190587",""],[5943,"ألا انتبهتا","https://www.poetsgate.com/ViewPoem.aspx?id=56465",""],[5953,"أيصحو فؤادي والفراق عظيم","https://www.poetsgate.com/ViewPoem.aspx?id=93865",""],[6102,"سَهِيرُ الأَحزان !!","https://www.poetsgate.com/ViewPoem.aspx?id=184416",""],[6124,"أراك","https://www.poetsgate.com/ViewPoem.aspx?id=102714",""]],"verses":[["فَلا صُلحَ حَتّى لا يَكونَ لِواجِدٍ","ثَراءٌ وَلا يَبقى عَلى وافِرٍ وَفرُ",0,"ر",1,0],["فَلا صُلحَ حَتّى تَسمَعوا مِن أَزيزِها","صَواعِقَ إِمّا صَكَّتِ الأُذنَ صُكَّتِ",1,"ت",1,0],["فَلا صاغَ معْنىً يُسْتَضاءُ لنورِه","جَناني ولا خطّتْ بَناني في حرْفِ",2,"ف",1,0],["فَلا صَدَّ تَخشاهُ بَعدَ الوِصالِ","وَلا ضَعفَ تَشكوهُ بَعدَ الأَشَر",3,"ر",1,0],["فَلَأَصبِرَنَّ عَلى الزَمانِ وُجَورِهِ","صَبرَ اِمريءٍ مُتَجَمِّلٍ لَم يَخضَعِ",4,"ع",1,0],["فلَا صَبرَ إِن تَستَعبرِ العَينُ إِنَّني","عَلى ذاكَ إِلا جَولَةَ الدَمعِ صابِرُ",5,"ر",1,0],["فَلا صَفوٌ جَوازُكَ عِندَ سَعدٍ","وَلا عَفُّ الخَليقَةِ في الرِبابِ",6,"ب",1,0],["فَلا صَلّى الإِلَهُ عَلى نُمَيرٍ","وَلا سُقِيَت قُبورُهُمُ السَحابا",7,"ب",2,0],["فلأَصبرنَّ وأكظِمَنْ","نَ وإن لظى غيظي كواني",8,"ن",2,0],["فَلا صُبِّحتَ بِالخَيرِ","وَلا مُسّيتَ بِالسَعدِ",9,"د",1,0],["فلا صبر ما لم ينقض الدهر حكمه","وما لم يكن سعد إليهم بعائد",10,"د",1,0],["فلا صديقَ إليه مشتكَى حزَنِي","ولا أنيسَ إليه منتَهى جذلي",11,"ل",2,0],["فلا صدرهُ في أزمةِ الخَطْبِ ضَيِّقٌ","ولا عُرْفُهُ من طالبِ الفضل شاسعُ",12,"ع",1,0],["فَلا صَبرَ إِلّا دونَ صَبرٍ عَلى الَّذي","رُزِئتَ عَلى يَومٍ مِنَ البَأسِ أَشنَعا",13,"ع",2,0],["فلا صُلحَ حتى تُستطارَ سِواعِدٌ","وتَسقُطَ أيدٍ في اللِّقاءِ وهَامُ",14,"م",1,0],["فَلا صَدِيقَ عَلَى وُدٍّ بِمُتَّفِقٍ","وَلا خَلِيلَ عَلَى سِرٍّ بِمُؤْتَمَنِ",15,"ن",1,0],["فلا صدقْتَ في قولٍ كذوباً","ولا استأمنْتَ مَنْ أكلَ الحراما",16,"م",2,0],["فلا صَيحاتُ فنزيلوس تُجدِي","ولا كِرزونُ يطمع أن يُبينا",17,"ن",2,0],["فَلا صَرَّدَ اللَهُ الشَرابَ الَّذي سَقى","وَلا خَلَعَ اللَهُ الرِداءَ الَّذي كَسا",18,"س",2,0],["فلا صَفَدٌ منكُمْ إذا لم يكُنْ غِنىً","ولا مِنّةٌ طَوْلٌ إذا لم تُتَمَّمَ",19,"م",1,0],["فَلا صَبرَ إِنّي مُقرَنٌ بِاِبنِ حُرَّةٍ","غَداً فَاِعرِفاني وَالرَدى حينَ أَضجَرُ",20,"ر",1,0],["فَلا صَديقٌ يَتَرَجّى يَدي","وَلا عَدُوٌّ يَتَخَشّى اِنتِقام",21,"م",1,0],["فَلا صَدِيقَ يُرَاعِي غَيْبَ صَاحِبِهِ","وَلا رَفِيقَ عَلَى الأَسْرَارِ يُؤْتَمَنُ",22,"ن",1,0],["فلا صَنيعةَ إِلّا وهي ضائعةٌ","فيه وليس على وَهن بمُصطَبر",23,"ر",1,0],["فَلا صَفا كَدَرُ الدُّنْيا لِمُصْفِيَةٍ","ما جاهَدَتْ فيكِ أنْفاسي المَجاهيدُ",24,"د",1,0],["فلا صالح يجزى به بعد موته","ولا حسن يثني به في حياته",25,"ت",2,0],["فَلا صامَ لا صلّى ولا حجّ لا حبى","فَقيراً وإِن أَودى به فقرهُ برّا",26,"ر",2,0],["فَلا صامَ لا صلّى ولا حجّ لا له","زَكاةٌ ولا أعمالُ برٍّ بها برّا",27,"ر",2,0],["فلا صبحَ إلا من محيَّا خريدةٍ","ولا ليلَ إلا فوقَ صُبحٍ ذوائب",28,"ب",1,0],["فلأصبِرَنْ ولأكتمنَّ صبابتي","فعسى أفوز بما أُحبَّ وأظفرُ",29,"ر",1,0],["فَلَأَصرِ فَنَّ الشِعرَ إِلّا عَن فَتىً","كَالسَيفِ تَلمَعُ بِالضُحى جَفَناتُهُ",30,"ت",2,0],["فلا صبر لي يا أُمّ عنكِ فإن يَكُن","لكِ الصّبرُ عنّي قد رضيتُ تماما",31,"م",2,0],["فَلا صامِتٌ إِلا بِشُكْرِكَ نَاطِقٌ","وَلا خالِعٌ إِلا لأَمْرِكَ خَانِعُ",32,"ع",1,0],["فلا صبر أو ينسى الفؤادُ غرامَها","وهيهاتَ لا يرضى الفؤادُ بدونها",33,"ن",3,0],["فَلأَصبرنَّ عَلى هَواه وَلَو بِهِ","صَرفت صُروف الوَجد قَلبَ عَميدهِ",34,"د",2,0],["فلأصفحَنَّ عنِ الزّمانِ وما جنَى","إذْ عاد عَودةَ نادمٍ مُتنَصِّل",35,"ل",1,0],["فلأَصفحَنّ عنِ الّذين قَضَوْا","عُرْفاً أتَى الأقوامُ أم نُكْرا",36,"ر",2,0],["فَلأَصبِرَنَّ عليكَ لا من سَلْوةٍ","صبرَ الكليمِ على أداةِ السّابِرِ",37,"ر",1,0],["فلا صبرٌ على نأيٍ مقيمٌ","ولا دَمعٌ على سرٍّ أمين",38,"ن",1,0],["فلا صبر إنّ الصبر محّت رسومهُ","ولا مهل قد غصّ بالماء شاربه",39,"ب",2,0],["فلا صدرَ إِلّا حريقٌ بنارٍ","ولا جَفنَ إِلّا غَريقٌ بماءِ",40,"ا",2,0],["فَلأُصفينَّك كلَّ سائرةٍ","في الريح سائلةٍ مع الوبلِ",41,"ل",1,0],["فلا صدرَ إلاَّ بالأسى متضرمٌ","ولا جفن إلاّ بالمدامع مقروح",42,"ح",1,0],["فلا صبر من بعد الفضائل والعلى","وصفو النهى والعلم والأدب الجم",43,"م",1,0],["فَلا صَدَفَت فِتيانُنا عَن وُلوجِهِ","لَيَغدو بِهِم رَثُّ البِلادِ مُرَمَّما",44,"م",2,0],["فَلا صَبرَ لي عَنها حُضوراً وَغَيبَةً","وَيا وَيحَ قَلبي إِنّ صَبريَ تالِفُ",45,"ف",1,0],["فَلا صِدقَ في قَولٍ وَلا صَبرَ عِندَهُم","وَلَكِنَّ فَخراً فيهِمُ وَتَزَيُّدا",46,"د",2,0],["فَلا صُلح حَتّى نرويَ السَيفَ وَالقَنا","وَتَأخُذ عَبدُ الواد مِنكُم بِثارِها",47,"ه",2,1],["فلا صلحت لأنفسهم نفوسٌ","ولا حُمِدت لهم فيها صفاتُ",48,"ت",1,0],["فلا صمتت ولا نطقت لسان","بعلم في الورى الا حقيقه",49,"ق",2,0],["فلا صديق لدى الجلّى يلاذ به","ولا كريم إذا خان الزمان وفى",50,"ف",2,0],["فلأصبرن كصبر تختجه","متمسكاً بمحلل العقد",51,"د",1,0],["فلا صُلحَ حتى تَنحِطَ الخيلُ بالقنا","وتثأرَ مِن نِسوَان كلب نسائيا",52,"ي",2,0],["فلا صَفِرَتْ يداكَ منَ المعالي","فإني منكَ مملوءُ اليدين",53,"ن",1,0],["فلا صلالة تحدو في غياهبها","ولا حنادس ضليل وضلال",54,"ل",1,0],["فَلا صَرمُهُ يَبدو وَفي اليَأسِ راحَةٌ","وَلا وَصلُهُ يَصفو لَنا فَنُكارِمُه",55,"م",2,0],["فلا صفحن عما آتاه","من الذنوب السبق",56,"ق",1,0],["فلا صح لي دين ولا بر مذهب","ولا كرمت نفسي ولا طاب مولد",57,"د",1,0],["فلأصبِرَنَّ على أليم سِهامِه","وسهامه وإن استمرَّ بلاؤه",58,"ا",3,0],["فلا صدع الخلافة فقد طفل","غدا الإسلام مختل النظام",59,"م",1,0],["فَلأَصْبِرَنّ وما رأيتُ دويً","للِهمِّ غيرِ عزيمة الصبر",60,"ر",1,0],["فلا صامت غير المسور حيثما","تغازل اختيها وغير المخلخل",61,"ل",1,0],["فَلا صُلحَ ما دامَت مَنابِرُ أَرضِنا","يَقومُ عَلَيها مِن ثَقيفَ خَطيبِ",62,"ب",1,0],["فلا صلاح واجب عليه","سبحانه عما عزوا إليه",63,"ه",1,0],["فلأصبِرَنَّ على الزَّمانِ وإنّني","لأخو الشّقاءِ صبرتُ أو لنْ أصبِرا",64,"ر",2,0],["فلا صديقٌ تماماً","ولا عدوٌّ تماما",65,"م",2,0],["فلأصبرن على جفاه فربما","فاز المتيم بالوصال يصبره",66,"ر",2,0],["فلا صلح ما بيننا أو يفز","اقوى الفريقين عزما ودينا",67,"ن",2,0],["فلا صبر حتى ترجع البيض منهم","تفيض دما فيض الجواري الطوامث",68,"ث",1,0],["فلا صارِمٌ إلا إلى النّصْر مُنتَضىً","ولا صاهِلٌ إلا إلى العزِّ مُمْتَطا",69,"ط",2,0],["فلا صحبت كفي كعوب مثقف","ولا خاض في غمر المهالك يعبوب",70,"ب",1,0],["فلأصبِرَنَّ على البِلى بعزيمةٍ","تَلِجُ المَخاوِفَ وَهيَ لا تتخوَّفُ",71,"ف",1,0],["فلا صلح إلا أن نصون ذمارنا","وإلا تقلدنا الغضاضة ما عشنا",72,"ن",2,0],["فلا صاهل إلا تشكى رباطه","ولا صارم إلا وغص به الغمد",73,"د",1,0],["فَلا صُلحَ حَتّى تُقدَعَ الخَيلُ بِالقَنا","وَتُضرَبَ بِالبيضِ الخِفافِ الجَماجِمُ",74,"م",1,0],["فلا صقر يخشى ولا هامة ترى","ولا طيرة تلقى ولا تختشوا عدوى",75,"و",2,0],["فلا صبرن عليك صبر مهذب","حر الشمائل والكريم صبور",76,"ر",1,0],["فلا صديق يرجى يوم حادثة","ولا أخا ثقة ينفعك في جلل",77,"ل",1,0],["فلا صوت يعبر عن غيابي","ولا قمر تعاتبه ظنوني",78,"ن",2,0],["فلا صرختي الكبرى لميلاد دهشتي","ولا رعشات القلب حركه الخفق",79,"ق",1,0],["فلا صبر إلا أن أرى فيه لاحقا","موسد أقوام لأحمد وسدوا",80,"د",3,0],["فلا صَمَدَ العملاقُ أوظلَّ شامِخاً","ولايدهُ تَعلّو وتَنْبُشُُ الخَبائِثُُ",81,"ث",1,0],["فلا صبرَ في الدنيا ولكن عقيدتي","إلى أن يَشَاءَ اللهُ مَوتِي سَتَصبرُ",82,"ر",1,0],["فَلَا صَوْتَ غَيْرَ اِلْتِهَابِ الْوَبَاء","تَصَدَّرَ فِي مَشْهَدِ السَّاحَةِ",83,"ه",1,0],["فَلَاَ صَبَاحُ الْخَيْرَاتِ هَلَّ بِنَا","وَلَا مَسَاءُ الأَحْبَابِ قَدْ أَثْرَى",84,"ر",2,0],["فلا صدق الله أقواله","بأعدائك المرجفين الألم",85,"م",1,0],["فلا صَدَقَ الأقوامَ يوماً مكاذبُ","ولا الوعدُ يؤتى في يمينِه حانثُ",86,"ث",1,0],["فلا صورٌ ولا نزفٌ لوجدي","ولاحتى نظمتُ البحر عندي",87,"د",2,0],["فلا صدقٌ على إبرام عقدٍ","ولا يُعنى بتقديس الصداقةْ",88,"ق",2,0],["فلا صدَّ يُفْنِي غرامِي بها","أصونُ الغرامَ بقلبٍ رَغُوْبْ",89,"ب",1,0],["فلا صُنّا مَواجعَنا","ولا نِمْنا ليالينا",90,"ن",2,0],["فلا صخبٌ هناك ولا نفاقٌ","ولا بشرٌ كأكياس الشعير!",91,"ر",1,0],["فلا صرخة في الليل توقظ موتهم","ولا في عناد الصخر تجدي الشتائم",92,"م",1,0],["فلا صوتي سمعت به. نشازا","ولا قلمي رأيت به هزالا",93,"ل",2,0],["فَلا صَوتي أعادَ إليَّ روحي","وَلا صَمتي أَزالَ الحُزنَ مِنّي",94,"ن",2,0],["فلأصبرنّ على شقائي في الهوى","فلربّما عاد الشقّي سعيدا",95,"د",2,0],["فلا صَابَتْ لَنَا لَيْلَى قَرِيْبَاً","ولا طَابَتْ لَنَا حُبَّاً قَرِيْنَا",96,"ن",2,0],["فلا صلَّيتَ فرضًا ترجو فيه","من الرحمنِ عفوا حيثُ خُنتَا",97,"ت",2,0],["فلا صاحب يرعى ولا ذو قرابة","شفيق ولا خل علي يدوم",98,"م",1,0],["فَلا صُمُودِيَ أَجدانِي إِذِ امتَنَعَتْ","وَ لا دُمُوعِيَ فِيما الحُزنُ يَختَمِرُ",99,"ر",1,0],["فلا صبرٌ سقاني بلْ رماني","على جمرٍ شواني وانتفاني",100,"ن",2,0]]}