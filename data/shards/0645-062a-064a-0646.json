,"https://www.poetsgate.com/ViewPoem.aspx?id=144173",""],[5364,"بلاد الشام تنخاكم","https://www.poetsgate.com/ViewPoem.aspx?id=177160",""],[5369,"ستشرق شمس","https://www.poetsgate.com/ViewPoem.aspx?id=177450",""],[5431,"ألا يانارُ بردا فلتكوني","https://www.poetsgate.com/ViewPoem.aspx?id=185983",""],[5431,"وقفة عزّ...","https://www.poetsgate.com/ViewPoem.aspx?id=207555",""],[5431,"القبة العليا ...","https://www.poetsgate.com/ViewPoem.aspx?id=210728",""],[5444,"عصامي العلا","https://www.poetsgate.com/ViewPoem.aspx?id=205517",""],[5625,"رسولُ السّلام ..","https://www.poetsgate.com/ViewPoem.aspx?id=182961",""],[5732,"دايم يباريني","https://www.poetsgate.com/ViewPoem.aspx?id=177907",""],[5732,"يا معذبي بالحب","https://www.poetsgate.com/ViewPoem.aspx?id=177938",""],[5873,"أنبل الأقوام","https://www.poetsgate.com/ViewPoem.aspx?id=215303",""],[5895,"تعود الطيور لأعشاشها","https://www.poetsgate.com/ViewPoem.aspx?id=215807",""],[6024,"مية","https://www.poetsgate.com/ViewPoem.aspx?id=186352",""],[6069,"متى نجعت في لوعتي وبلابلي","https://www.poetsgate.com/ViewPoem.aspx?id=105701",""],[6346,"بركان المشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83389&r=&rc=5",""]],"verses":[["مَتّيني فَهَل لَكِ أَن تَرُدّي","حَياتي مِن مَقالِكِ بِالغُرورِ",0,"ر",1,1],["مَتِينُ الشَّوَى فِي رَأْسِهِ سَمْهَرِيَّةٌ","مُقَصِّرَةٌ عَنْهُنَّ مَا يُنْبِتُ الْخَطُّ",1,"ط",1,0],["مَتى نَراهُ وَقَد باتَت خَزائِنُهُ","كَنزاً مِنَ العِلمِ لا كَنزاً مِنَ الذَهَبِ",2,"ب",1,0],["مَتى نَنقُل إِلى قَومٍ رَحان","يَكونوا في اللِقاءِ لَها طَحينا",3,"ن",2,0],["مَتى نَعقِد قَرينَتَنا بِحَبلٍ","تَجُزُّ الحَبلَ أَو تَقُصُّ القَرينا",3,"ن",2,0],["متين على الأركان وهي ثلاثة","بأمثالها تحيي أبوتها الولد",4,"د",1,0],["متى نرجو لغُمتّنا انكسَافاً","وقد أمسى الشقاق لنا مَطافا",5,"ف",2,1],["متى نَنزِل بِعَقوَةِ أَهل عزٍّ","نَطَأهُم وَطأَةَ المُتَثَاقِلِينا",6,"ن",2,0],["متى ناقشت ذا شكرٍ حساباً","فيدْخُلني من العجز احتشامُ",7,"م",1,0],["مَتى نَفتَرِش يَوماً عُلَيماً بِغارَةٍ","يَكونوا كَعَوصٍ أَو أَذَلَّ وَأَضرَعا",8,"ع",2,0],["مَتى نَعتَرِض جَدوى أَبي الجَيشِ نَعتَرِف","مَواهِبَ يُلحِقنَ المُقِلَّ بِمَن أَثرى",9,"ر",2,0],["مَتى نَرضى وَدَجّالُ النَصارى","يُقَوِمُ ما يَراهُ بِفَردِ عَينِ",10,"ن",1,0],["متى نلتَها كانت لأنفسنا منَى","تلفت تجد مصراً بأجمعها هنا",11,"ن",2,1],["متى نَتَلَقّى منكِ إنجازَ مَوْعِدٍ","وفِعلُكِ ذو بُخلٍ وقَولُكِ مِفضالُ",12,"ل",1,0],["مَتى نَشَأَت ريحٌ لِقَدرِكِ بَاِبعَثي","لِجارَتِكِ الدُنيا قَليلاً وَلا تُملي",13,"ل",2,1],["متى نُصْبحْ وقد فُتْنا الأعَادي","نُقِمْ حتى تقُولَ الشّمسُ رُوحا",14,"ح",2,0],["مَتى نَنقُل إِلى قَومٍ رَحانا","يَكونوا في اللِقاءِ لَها طَحينا",15,"ن",2,0],["متى نُثِلَتْ مِن عَيْبِةٍ يومَ سَبْرَةٍ","وقد غِيمَ أُفْقٌ أرْسَلَتْ جاريَ الآل",16,"ل",1,0],["متى نزل السماك فحل مهداً","تغذيه بدرتها الثديّ",17,"ي",1,1],["مَتِينُ الحَصَاةِ طَوِيلُ الأَنَا","ةِ إِذَا سَئِمَ الجِدُّ لا يَسْأَمُ",18,"م",1,0],["متى نَفَى وطنُ الأحرار مهتضمًا","يريد للوطن المحتل تحريرًا؟",19,"ر",2,0],["متى نتعزى منك أو يقلع البكا","ورمسك في وسط القلوب مخيم",20,"م",1,0],["متى نعقد قرينتنا بجبلٍ","تجذ الحبل أو تقص القرينا",21,"ن",2,0],["مَتَى نَعْقِد قَرِيْنَتَنَا بِحَبْلٍ","تَجُذَّ الحَبْلَ أَوْ تَقْصِ القَرِيْنَا",22,"ن",2,0],["متى ندبناك في امر الم بنا","فالشر مبتعد والخير مقترب",23,"ب",1,0],["متى نلتقي بعد الفراقِ؟ تَساءَلَتْ","ومَنْ ذا يُعِيدُ الحُبَّ مِن بَعْدِ ما نُعِي؟",24,"ع",2,0],["متينٌ قويُّ العزيمة لا يجاري","إلى كرم الفِعال ولا يردُّ",25,"د",1,0],["متينٌ قويُّ العزيمة أَلمعيٌّ","يكادُ بفكرهِ يحكي الغيوبا",26,"ب",2,0],["متين القوى أرسى من الطود حلمه","أذاهب ريح الطيش لا يتزعزع",27,"ع",1,0],["متى نجوت الدهر من شرّهم","لم تنج من قال ومن قيل",28,"ل",1,0],["متى نحو دار الضرب يأتي لسبكه","ويقتص من ذا الخارج الناقد العدل",29,"ل",1,0],["مَتى نَلتَقي في غير نَومٍ وَيَشتَكي","مَشوقٌ وَيَشكي مِن جَوى البين شائِقُ",30,"ق",1,0],["مَتى نَنتَسِب تَلقَوا أَبانا أَباكُمُ","وَلَن تَجِدونا لِلفَواحِشِ أَقرَبا",31,"ب",2,0],["مَتى نَشتَفي مِن بَعدِكُم بِدُنُوِّكُم","وَتَجمَعُنا دارُ التَداني وَإِيّاكُم",32,"م",1,0],["متى نقضي على الباغي","وتقضي النفس أوطارا",33,"ر",2,0],["متى نَعودُ إلى العاداتِ ثانيةً","قُلْ لي أذلكَ في وُسْعِ الزّمانِ تُرى",34,"ر",2,0],["مَتى نَظمتُ بِبَيتٍ في مَديحِكُمُ","فَالريحُ تَرفَعُهُ وَالشَمسُ تَرويهِ",35,"ي",2,0],["متى نفرت جيرانها من فنائها","وأقْفَرَ ذاك المنحنى من ظبائها",36,"ه",2,0],["متينُ قُوَى العزيمةِ أَلمعيٌّ","إذا ما ارتابَ بالفكرِ الأريبُ",37,"ب",1,0],["متى نفحوا المريد صفا وصوفي","وليس عن الوصول له وقوف",38,"ف",1,0],["متى نازَلَ الفَحْلَ الشُّجاعَ رأَيتَهُ","بهامَتِهِ من راحَةِ البَطَلِ الفَحْلِ",39,"ل",1,0],["مَتينِ الجأشِ قافِ ذوي التَّجَلِّي","كَريمِ الخُلْقِ ذي الطَّبْعِ الألوفِ",40,"ف",1,0],["مَتينِ شَهامَةٍ وكبيرِ قلبٍ","وقد منعَ العُيونَ عن الرُّقادِ",41,"د",1,0],["متى نبهت عزمته لخطب","فقد نبهت حية بطن وادي",42,"د",2,0],["مَتَى نرجو الثَباتَ مِنَ الزَّمانِ","وشَطراهُ كأَفراسِ الرِهانِ",43,"ن",1,1],["متى نأسر وَنؤسر في اناس","وَيوجع كلما عقد الحبال",44,"ل",1,0],["متى نشَّأَتْ مِنه سحائِب كُفِّه","فلا وعْدُه برْقٌ ولا منُّه رعْدُ",45,"د",1,0],["مَتى نالَها فَلتَندُب الأَرض حَسرة","عَلى العَدل وَلتبك السَماء تلددا",46,"د",2,0],["مَتى نراهُ طالبا","بثارهِ في نفرِ",47,"ر",1,0],["مَتى نَرى مهديّنا","سليل ساقي الكوثرِ",47,"ر",1,0],["مَتى نراهُ حاملاً","حَملة ليث قسورِ",47,"ر",1,0],["مَتَى نَزَلَت عَلَيهِ فَلا وَراءٌ","يَكُونُ لَهُ سِواهُ وَلا أَمامُ",48,"م",1,0],["متى نازَلَ الأقرانَ أيقنتَ أنها","حواصلُ أمّاتِ الفِراخ قُبورُها",49,"ر",3,0],["متى نالك الفضل العظيم بنائل","وزالت شكوك الشرك عن كل عاقل",50,"ل",1,0],["متى نراك منيراً","لظلمة الليل سائق",51,"ق",1,0],["متى نزلوا ثاوين في الحيف من منى","بدت للهوى بالمأزمين مخايل",52,"ل",1,0],["متى نلتقِي يَاعِرَاقَ القيامات","قدْ صارَ حلْماً لَنَا ملْتَقانَا",53,"ن",2,0],["متى نرد ماء بغداد ركائبنا","فابشر فأنت من الزلفي بميعاد",54,"د",1,0],["مَتَى نَلْقَكُمْ عَاماً يَكُنْ عَامَ عِلَّةٍ","وَيُنْظَرْ بِنَا عَامٌ مِنَ الدْهرِ مُقْبِلُ",55,"ل",1,1],["متى نعت الوشاة حجول ليلى","فكل حمامةٍ منها صهيل",56,"ل",1,0],["مَتِينٌ فَمَتِّنْ ضَعْفَ حَوْلِي وَقُوَّتِي","أَغِثْ يَا وَليُّ مَنْ دَعَاكَ تَبَتُّلاَ",57,"ل",2,0],["متى نظمت مديحاً في مفاخره","تضوعت عنبراً ورداً قوافيها",58,"ي",3,0],["متى نهلت قواديم وصدّت","أنت أخرى مرشقة صواد",59,"د",1,0],["متى نقدر (ع) فرقاكم","بدا جُوْر الغرام يزِيْد",60,"د",1,1],["متى نبصر النصر الألهي مشرقاً","بانواره تكسى الربى وتجلل",61,"ل",1,0],["متين حبل الدين مأمون إذا","ما علق الغدر بكل أنكد",62,"د",1,0],["مَتى نَحيا وَنَسعَدُ في حَياةٍ","إِذا أَعيادُنا كانَت فُجورا",63,"ر",2,0],["متين الحجا يدعو إلى الرشد بالهدى","وقد جاءنا تشبيه بالنبوة",64,"ه",1,0],["متى نُيمِّمُ النّجاحَ ويعو","دُ غربُنا لِزهوه كما مضى",65,"ا",1,0],["متَى نَرنو الى طلَبِ المعالِي","الى الآجالِ بل لِشيبِ الغُرابِ",66,"ب",1,0],["متى نُلاقيكَ يا ابنَ العسكري على","كتائبِ أنبياها من عساكرها",67,"ر",3,0],["مَتى نَرى بيضك مَشحوذة","كَالماء صافي لَونَها وَهِيَ نار",68,"ر",1,0],["مَتّى نَرى خَيلك مَوسومة","بِالنَصر تَعدو فَتُثير الغبار",68,"ر",1,0],["مَتى نَرى الأَعلام مَنشورة","عَلى كماة لم تَسَعها القفار",68,"ر",1,0],["مَتى نَرى غلب بَني غالب","يَدعون للحَرب البدار البدار",68,"ر",1,0],["مَتّى نُبصر الجَيش اللُهام لَوامِعاً","صَوارمه تَحتَ العجاج سَواطِعا",69,"ع",2,0],["متى نلتقي بالقوم أو تلتقي بنا","صبيحة يوم والقنا متمائس",70,"س",1,0],["متى نطرح الهيجا اللجوج عجاجها","على جثث القتلى ويروى المداعس",70,"س",1,0],["مَتى نَحدو الرَواسِمَ نَحوَ نَجدٍ","إِلى مَن سادَ أُمَّتَهُ وفاقا",71,"ق",2,0],["متى نحظى بذي حكم قدير","يزيل الصخر عن طرق المرور",72,"ر",1,0],["متى نشروا في الحشر صحف حياتهم","عرضت لهم في محشري ذلك السطرا",73,"ر",2,0],["مَتى نَلتَقي لَيلاً وَتبرا جراحنا","وَنفتح عَن تلكَ الحُدود كمامها",74,"م",3,0],["متين التقى عف الضمير عن الخنا","دقيق حواشي الطرف والحسِ والفهم",75,"م",1,0],["متى نغزوكُمُ نَرْجِعْ بنهْبٍ","ونَشْفِ الصدرَ من دَاءِ العليلِ",76,"ل",1,0],["متى نشرَ الوسمي بردةَ منعجٍ","وهل زالَ من وادي الأراكِ قَضيبُ",77,"ب",1,0],["متى نظرت أو التفتت بجيد","سبيت بها بلحظ والنفات",78,"ت",1,0],["متى نرى الجحفل الجرار قد ملأ","الفلا وانت عميد الجحفل اللجب",79,"ب",1,0],["متى نظر الادنون قامة شخصها","وما برحت خدراً حمته أولوا النسك",80,"ك",1,0],["متى نزلوا في قرية أو مدينة","ففيها الندى والعلم والحلم نزال",81,"ل",1,0],["متى نرى النادي الميمون عاوده","ضياؤه وتحامت أهله الغير",82,"ر",1,0],["متى نتلها خلنا الكماة تصادمت","وحدب المواضي يعتقن القنا الملدا",83,"د",2,0],["متينُ قوِّ حفظَنا عن كل ما","يرومُ ضرَّ الخلق أو من يُعلما",84,"م",2,0],["متى نبلغ الغايات سعياً بأرجل","تعامت خطاها عن مقاومة الرسف",85,"ف",1,0],["متى نهته النُّهى حنّت عَلاقته","إِن الكريم بأَيام الصِّبى عَلِقُ",86,"ق",1,0],["متى نظرت في العوالي الرؤوس","أسالت مع الدمع قلباً مذابا",87,"ب",2,0],["متى نار الجوى تخبو وداعي","شجوني يا كرام لكم وداعي",88,"ع",2,1],["مَتينُ القَوافي يُدرك الفهمُ لَفظَها","وَلَو لَم تَكُن في آخِرِ البَيتِ تُذكَرُ",89,"ر",1,0],["متى نظر الغوى له صلاحا","سرت عنه الغواية والفساد",90,"د",1,0],["متى نشرت لها شرعا لتطوعى","بحارا خلتها برزت حصونا",91,"ن",2,0],["متى نعرْبدُ كالرَّعْد الجَّسور فماً","ونجمع الشَّمل والرَّايات والنَّسَبَا",92,"ب",2,0],["متى نطير معا في جو فرحتنا","متى سأشمم ُ من أنفاسكم أرجا ؟",93,"ج",2,0],["متى نعود إلى الديان خالقنا","ليفتح الله ما انسدت من الحجب",94,"ب",1,0],["متى نراها بثوبِ العزِ كاسيةً؟","إنَّا مللنا حياةً سادها الجبنا",95,"ن",2,0],["متى نُنهي علاقتَنا بخصمٍ","تَرَبُّصُهُ بنا أمسى شعارا ...؟!",96,"ر",2,0],["متى نُنهيْ عداوتَنا لبعضٍ","ونَحْسِمُ أمرَ وِحْدَتِنا خِيارا.؟!",96,"ر",2,0],["متى نهته النهى حنت علاقته","إن الكريم بأيام الصبا علق",97,"ق",1,0],["متى نفثَ الْجوى في الْوجْدِ شعْراً","سيزْهو ورْدُ خدّيهِ ويُنْمي",98,"م",2,0],["متي نصحصح ياجماعة ونسير في صحة ونور","ونتبع الواقع ونعمل في جهود متضافرة",99,"ر",2,0],["متى نَكَسْتَ بسيفِ الظُلمِ ألويتي","وصرتَ تشطبُ فرحي من عناويني ؟",100,"ن",2,0],["39 – متى نضمُّ .. نلمُّ الشملَ متحدا ً ؟!","فأمتي لم تزلْ أشلاؤها مِزقا",101,"ق",2,0],["متى نصحو يعودُ الحبُّ فينا","وتشملنا الحضارة والفخامه",102,"م",2,0],["متى نعودُ أيا بغداد حيْث لنا","تحت الثرى أسدٌ يُعليك أيوانا",103,"ن",2,0],["متى نصحو ؟ وسيف الغدرِ يسرقُنا؟","متى نرسو ..وبحرُ الموت يعلونا",104,"ن",2,0],["متى نلتقي والهجرُ طالَ زمانُهُ","وحلَّ بقربي شامتٌ وعذو لُ",105,"ل",1,0],["متى نصرُ ربي متى يا إلهي","ظهور التقاةِ على الظالمينْ",106,"ن",1,0],["متى نصحا