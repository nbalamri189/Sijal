{"poems":[[53,"يا ابن المسيب عشت في نعم","https://www.aldiwan.net/poem8151.html","الكامل"],[50,"يا سالب الأذهان","https://www.aldiwan.net/poem66123.html","المجتث"],[230,"خلي صدودك وهجرك","https://www.aldiwan.net/poem55081.html","عموديه"],[629,"","https://poetry.dctabudhabi.ae/diwan/poem/100589","الكامل"],[747,"","https://poetry.dctabudhabi.ae/diwan/poem/143281","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77284","البسيط"],[5358,"متى تعود لنا","https://www.poetsgate.com/ViewPoem.aspx?id=21899",""],[5725,"يا نخلة البصرة","https://www.poetsgate.com/ViewPoem.aspx?id=210802",""]],"verses":[["يا نرجِسَ الدنيا أقمْ أبداً","للإقتراحِ ودائمِ النُّخَبِ",0,"ب",1,0],["يا نَرجِساً وَخُزامى","في زُمرَةِ الرَيحانِ",1,"ن",1,0],["يا نرجس الروض مالك","سلّطت لحظك عليّ",2,"ي",1,0],["يا نرجس الروض الأنيق","ويا مدبجة الورود",3,"د",1,0],["يا نَرجساً لم تعْدُ قامَتُه","سهمَ الزُّمرُّد حينَ ينتسبُ",4,"ب",1,1],["يا نَرجِسُ انظُر لِعَينَيها إِذا نَظَرَت","يا ياسَمينُ لَقَد مَرَّت بِك اِنتَشِق",5,"ق",1,0],["يا نرجِساً في الصحارى رغْمَ رِقّتِهِ","جَرّ الأنوفَ وطافتْ حولَهُ المُقَلُ",6,"ل",1,0],["يا نرجساً بالهمّ سهّدني","ملّكتني في خلسةٍ عطرهْ",7,"ر",2,0]]}