{"poems":[[53,"أيا ثقفي أراك الذي","https://www.aldiwan.net/poem11456.html","المتقارب"],[94,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[147,"ظلامة من أعدك لليالي","https://www.aldiwan.net/poem11796.html","الوافر"],[382,"إليك أضرع في مدحٍ خصصتِ به","https://www.aldiwan.net/poem59155.html","البسيط"],[438,"الحيا من غيوثك البارقات","https://www.aldiwan.net/poem12317.html","الخفيف"],[458,"سيدي الفارس المجلى أتأذن","https://www.aldiwan.net/poem61737.html","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38188","الرمل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202074","المتقارب"],[3145,"","https://poetry.dctabudhabi.ae/diwan/poem/128321","الوافر"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108337",""],[5431,"قصيدة لثورة 26_سبتمبر النبيلة","https://www.poetsgate.com/ViewPoem.aspx?id=191307",""],[5431,"ثورة 26 من سبتمبر..","https://www.poetsgate.com/ViewPoem.aspx?id=191551",""]],"verses":[["أيا ثقفيُّ أراك الذي","سيُلحقُ أُخرى ثمودٍ ثمودا",0,"د",2,1],["أَيُّ إثْمٍ مقدَّسٍ قَدْ لبسنا","بُرْدَهُ في مسائنا الميمونِ",1,"ن",1,0],["أَيا ثِقَةَ الثِقاتِ أَصِخ فُواقاً","لِتَسمَعَ ما يَشُقُّ عَلى المَعالي",2,"ل",2,0],["أي آثمين اَقبِلُوا بالذل واحتضنوا","إقدام مريم ثم امضوا على رائي",3,"ي",1,0],["أَيُّ أَثْرٍ في مَتْنِ أَيَّ حُسامِ","وسنانٍ في صَدْرِ أَيِّ قناةِ",4,"ه",1,0],["أي إثمٍ فكراً وصخراً","مثلُ قتلِ الصديق ثم افتخاري",5,"ي",1,0],["أَيَّ إِثمٍ يَجتَني لَو سَلَّما","أَيَّ عارٍ بِكَلامي يكتسي",6,"ي",1,0],["أيَا ثَانِي الَمرتَضى في الفَخَار","وَمَنَ هُوَ خَاتم سَبْعٍ مَثانِي",7,"ن",2,0],["أيا ثارات من قتلته سعدى","دمي لا تطلبوه لها حلال",8,"ل",1,0],["أي اثم رأوا بهم كي يدانا","كلهم عن جريرة جل شانا",9,"ن",2,1],["أيا ثورة العشاق يا خير منبع","به فاضت الآمال إني مبايع",10,"ع",1,0],["أيا ثورة الأحرار فكّي وثاقيا","وهدّي بنا الأصنام يكفي تماديا",11,"ي",2,1]]}