{"poems":[[52,"أمن وقوف على شام بأحماد","https://www.aldiwan.net/poem63935.html","البسيط"],[243,"لن نفترق","https://www.aldiwan.net/poem24809.html","عموديه"],[287,"أما كفاني طرف منك نبال","https://www.aldiwan.net/poem32665.html","البسيط"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53904","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64797","السريع"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119599","الكامل"],[5121,"مُنَاجَاةٌ وِجْدَانِيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=33502",""],[5725,"خمرية كالليلة القمراء","https://www.poetsgate.com/ViewPoem.aspx?id=197048",""],[6102,"شاخ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=184417",""]],"verses":[["حَتّى ضَرَبنا عَلى المَهدِيِّ قُبَّتَهُ","فُسطاطَ مُلكٍ بِأَطنابٍ وَأَوتادِ",0,"د",1,0],["حتى ضجرت به وأسأمه","طول الثواء وآده التعب",1,"ب",1,0],["حَتّى ضَمَمتَ إِلَيهِ شامَةً بَرَزَت","لي يمنَةً فَلَها بِالبالِ بَلبالُ",2,"ل",1,0],["حتّى ضعفتُ ورقّ جسمي بينهم","وتغيّرتْ عن حالِها أعْضائِي",3,"ا",2,0],["حتى ضَفَتْ مِنْكَ على ماجدٍ","بِلُبْسِ أَبرادِ العُلا مُغْرَى",4,"ر",2,0],["حتى ضعفت فلا فتىً أقوى به","لخصامه فيعاضدي أو ينجدي",5,"د",2,0],["حَتَّى ضُلُوعِي قَدْ بَدْتْ مَلْوِيَّةً","مِنْ ضَنْكِ أَثْقَالٍ جَثَتْنِي نَادِمَا",6,"م",2,0],["حتى ضممتك بالضلوع حكاية","غجرية يا شذرة الصحراءِ",7,"ا",2,0],["حَتَّى ضُلُوعِيَ - إِذْ لَبِسْتَ عِظَامَها","ثَوبًا - تَوَدُّ - كَرَاهَةً - أَنْ تَخْلَعَكْ !",8,"ك",1,0]]}