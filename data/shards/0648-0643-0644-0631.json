{"poems":[[55,"أيا جبلي نجد أبينا سقيتما","https://www.aldiwan.net/poem29656.html","الطويل"],[65,"أتيحت لداء في الفؤاد عضال","https://www.aldiwan.net/poem46130.html","الطويل"],[65,"سل الركب يا ذواد عن آل جساس","https://www.aldiwan.net/poem46149.html","الطويل"],[3,"طربت وهاجتك الظباء السوارح","https://www.aldiwan.net/poem91.html",""],[95,"علمتنا بالمثال والقلم","https://www.aldiwan.net/poem11355.html","المنسرح"],[53,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[93,"أعد حديثك عندي أيها الرجل","https://www.aldiwan.net/poem9053.html","عموديه"],[40,"أحار بن عبد للدموع البوادر","https://www.aldiwan.net/poem7719.html","الطويل"],[30,"وأطلس عسال وما كان صاحبا","https://www.aldiwan.net/poem5628.html","الطويل"],[63,"بودي لو ملكت ثني قيادي","https://www.aldiwan.net/poem51727.html","الطويل"],[51,"لعمرك ما الدنيا بدار بقاء","https://www.aldiwan.net/poem10314.html","الطويل"],[50,"عوجا صدور النجائب البزل","https://www.aldiwan.net/poem65038.html","المنسرح"],[48,"خوى دن شرب فاستحابوا إلى التقى","https://www.aldiwan.net/poem22453.html","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62244","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54772","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54248","البسيط"],[128,"من رأس بيروت حتى ثغر لرناكا","https://www.aldiwan.net/poem23796.html","البسيط"],[133,"شربت كأسي أمام نفسي","https://www.aldiwan.net/poem67449.html","مخلع البسيط"],[138,"ألا أبلغا عني لؤيا رسالة","https://www.aldiwan.net/poem21029.html","الطويل"],[146,"أى لبيب بك لم يخدع","https://www.aldiwan.net/poem58407.html","السريع"],[193,"ألا حبذا بين النخيل نزول","https://www.aldiwan.net/poem35151.html","الطويل"],[199,"عما يا ابنتي قيس صباحا ومظلما","https://www.aldiwan.net/poem54406.html","الطويل"],[234,"إليك مدت رقابها العرب","https://www.aldiwan.net/poem51240.html","المنسرح"],[240,"أيطمع أن يساجلك السحاب","https://www.aldiwan.net/poem32176.html","الوافر"],[266,"إلام اصطباري لا يرى غير خائب","https://www.aldiwan.net/poem38372.html","الطويل"],[286,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[310,"دليل اصطفاء الله للعبد علمه","https://www.aldiwan.net/poem56414.html","الطويل"],[382,"إلام إلام ظلما يا حسود","https://www.aldiwan.net/poem59453.html","البسيط"],[392,"ألا يا لهمدانٍ فجدوا وشمروا","https://www.aldiwan.net/poem548.html",""],[409,"لولا الرجا ما انتهضت إرادة","https://www.aldiwan.net/poem34171.html","الرجز"],[447,"دعاها كيفما صنعت دعاها","https://www.aldiwan.net/poem14432.html","السريع"],[463,"في كل دار عدو لي أقاذعه","https://www.aldiwan.net/poem56117.html","البسيط"],[591,"يمينا بطيب شباب الزمان","https://www.aldiwan.net/poem17808.html","المتقارب"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77575","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77571","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77584","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62586","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119923","المنسرح"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119896","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1052,"","https://poetry.dctabudhabi.ae/diwan/poem/130872","المتقارب"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126118","الرجز"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112889","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46676",""],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50023","المتقارب"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49559","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71071","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27527","المتقارب"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27442","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27164","المتقارب"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132362","الوافر"],[2619,"","https://poetry.dctabudhabi.ae/diwan/poem/26590","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87318","الرجز"],[2683,"","https://poetry.dctabudhabi.ae/diwan/poem/132505","الرجز"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132707","الوافر"],[3162,"","https://poetry.dctabudhabi.ae/diwan/poem/142906","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89006","البسيط"],[3489,"","https://poetry.dctabudhabi.ae/diwan/poem/131366","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62826","الوافر"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36733","الرجز"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85244","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114240","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111460","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101360","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123499","البسيط"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102747","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54453","البسيط"],[4303,"","https://poetry.dctabudhabi.ae/diwan/poem/110655","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83617","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83177","البسيط"],[4767,"موسم الأمطار","https://www.poetsgate.com/ViewPoem.aspx?id=180857",""],[4984,"ذكرى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=178841",""],[5105,"وقد أُزارُ وللزوارِ حكمهمُ","https://www.poetsgate.com/ViewPoem.aspx?id=135343",""],[5199,"ياْدمى ربك الى يقدر وينجزاء","https://www.poetsgate.com/ViewPoem.aspx?id=146096",""],[5337,"كم قد تؤمل نفس نيل منيتها","https://www.poetsgate.com/ViewPoem.aspx?id=171247",""],[5370,"أمومتي","https://www.poetsgate.com/ViewPoem.aspx?id=85528",""],[5525,"الأربعين","https://www.poetsgate.com/ViewPoem.aspx?id=828",""],[194,"ما بالُ عَينٍ شَوقُها استَبكاها","https://www.poetsgate.com/ViewPoem.aspx?id=51514",""],[5725,"ولولاك","https://www.poetsgate.com/ViewPoem.aspx?id=201775",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[6070,"نَصَبْتَ شباكَ قَلْبِكَ في هواها","https://www.poetsgate.com/ViewPoem.aspx?id=188981",""],[6070,"صُرُوفُ الدَّهْرِ دائرةٌ تدورُ","https://www.poetsgate.com/ViewPoem.aspx?id=189069",""]],"verses":[["وَكُلُّ رَعودِ الشَفرَتَينِ كَأَنَّهُ","سَنى البَرقِ إِمّا جَدَّ في اللَمَعانِ",0,"ن",1,0],["وكُلِّ رَميضِ الشّفْرَتَيْنِ مُهَنّدٍ","كأنّ بغَرْبَيْهِ مَدَبَّ نِمالِ",1,"ل",1,0],["وكُلُّ رُدَيْنيٍّ كأنّ سِنانَهُ","يَعُطُّ رِداءَ الليْلِ عنهُمْ بنِبْراسِ",2,"س",1,0],["وَكُلَّ رُدَينِيٍّ كَأَنَّ سِنانَهُ","شِهابٌ بَدا في ظُلمَةِ اللَيلُ واضِحُ",3,"ح",1,0],["وَكُلُّ رَنانَةٍ مُجَلْجِلَةٍ","جَمَعْتَ فِيهَا رَوائِعَ الحِكَمِ",4,"م",1,0],["وكلُّ رزء فإنَّه جَلَلٌ","إذا المبقَّى لأهله كثَرهْ",5,"ر",2,0],["وَكُلِّ راعِفَةٍ بِالمَوتِ هادِرَةٍ","كَأَنَّها الشاعِرُ المَطبوعُ يَرتَجِلُ",6,"ل",1,0],["وَكُلُّ رُدَينِيٍّ إِذا هُزَّ أَرقَلَت","أَنابيبُهُ بَينَ الكُعوبِ الحَوادِرِ",7,"ر",1,0],["وَكُلُّ رَفيقَي كُلِّ رَحلٍ وَإِن هُما","تَعاطى القَنا قَوماهُما أَخَوانِ",8,"ن",1,0],["وكلِّ رُدَينيٍّ أصمَّ كأنَّما","تُروِّعُ منه الرَّوعَ حيةُ وَادِي",9,"د",2,0],["وَكُلٌّ رَماهُ واصِلٌ بِصَريمَةٍ","وَكُلٌّ رَماهُ مُلطِفٌ بِجَفاءِ",10,"ا",2,0],["وَكُلُّ رَبعٍ يَخِفُّ ساكِنُهُ","عَمّا قَليلٍ لا بُدَّ أَن يَمحَل",11,"ل",1,0],["وَكُلُّ رَوادٍ لا تُصابُ أَبيَّةٌ","مَتّى نوزِعَت في مَنطِقٍ لِرِوادِ",12,"د",1,0],["وكُلَّ رَبَاعٍ أَوْ سَدِيسٍ مُسَدَّمٍ","يَمُدُّ بِذِفْرَى حُرَّةٍ وجِرَانِ",13,"ن",1,0],["وَكُلُّ رَوْضٍ ذَوَتْ فِيه نَضَارَتُهُ","وَنَاحَ بَعْدَ غِنَاءٍ طَيْرُهُ الْغَرِدُ",14,"د",1,0],["وكلُّ روضٍ يُرَجِّي لو سعتْ قَدَمٌ","به ليُهْدِي من الأزهارِ أذْكَاها",15,"ا",3,0],["وكل رعبوبة خمصانة نصبت","لمثله في طريق الحب أشراكا",16,"ك",2,0],["وكلُّ ريحٍ لها سُكونٌ","إلّا الأسى هاجَه المَلال",17,"ل",1,0],["وَكُلِّ رُدَينِيٍّ ظِماءٍ كُعوبُهُ","وَعَضبٍ كَإيماضِ الغَمامَةِ مِقصَلِ",18,"ل",1,0],["وكلّ ريحٍ أزعجت تُربهم","فإنها الزفرةُ من أضلعى",19,"ع",2,0],["وَكلُّ رسولٍ خصّ قوماً وإنّه","ببعثتِه للعالمين شمولُ",20,"ل",1,0],["وَكُلُّ رُدَينِيٍّ تَخالُ سِنانَهُ","شِهاباً بَدا في ظُلمَةِ اللَيلِ مُعلَما",21,"م",2,0],["وكلُّ رَجْراجةٍ عزائمُه","دِلاَصُها والرِّماح والقُضُب",22,"ب",1,0],["وَكُلُّ رَزيَّةٍ مادام عِندي","أَبو نَصرٍ يَهونُ بِها المُصابُ",23,"ب",1,0],["وكل رديني الكعوب مثقف","درأت به صدر الكمي المحارب",24,"ب",1,0],["وكل روعٍ فأمنٌ حين تنسبه","لروعِ من لسؤال الله قد وُقفا",25,"ف",2,0],["وَكلُّ رئيسٍ أَمكَنته فضائلٌ","فَأعوَدها نفعاً عَلى الخلقِ همُّهُ",26,"م",2,0],["وكلٌّ رأيُه فيه فسادٌ","وكلٌّ عقله فيه سُمود",27,"د",1,0],["وَكُلِّ رُدَينِيٍّ أَصَمَّ عَنَطنَطٍ","يَلوحُ كنَجمٍ في المَجَرَّةِ زاهِرِ",28,"ر",1,0],["وكل رجوى في الذي يطلبه","لا ترتجى من غير خَلاَّقِ الورى",29,"ا",1,0],["وكل رحال داركم أَراها","عظيم التيه من كبر ضناها",30,"ا",3,0],["وكلّ رزقٍ ترى الأقدارَ ضيّقةً","به فعندك مسناةٌ وسائعُهُ",31,"ع",2,0],["وكُلّ رَشاً فاتِر المُقْلَتَيْنِ","تَكوَّنَ بَدْراً عَلَى غُصْنِ بانِ",32,"ن",1,0],["وَكُل رَأسٍ خَرَجت مِن طاقه","فَلَم تَجِد نَفسي عَلَيها طاقَه",33,"ه",1,0],["وَكُلٌّ رَأَى في جسمِهِ حُسنَ خَلقه","وَشاهد كُل العَيب في جسم غَيرِه",34,"ر",2,0],["وَكُل راهِبٍ قَبيح الرُؤيَه","فَذاكَ جلمودٌ بخيل اللحيَه",35,"ه",1,0],["وكلّ رشّاشةٍ إن أُنْزِلَت بهم","قالوا رشاش وللسحب انقشاعاتُ",36,"ت",1,0],["وكل رمح لدنٍ للهذمة","في كل صدر ورد وإصدار",37,"ر",1,0],["وكل رجاف الأعالي حكى","لون سليمي ووام الرباب",38,"ب",1,0],["وكل رسول آية انقرضت به","وآيات طه باقيات تعظم",39,"م",1,0],["وكل رفيع بها ضائع","وكل وضيع بها محترم",40,"م",1,0],["وكل رائح وكل غاد","لعرض الارزال والأوغاد",41,"د",1,0],["وكل رفيع للحبيب موقر","وكل عظيم القريتين حقير",42,"ر",1,0],["وكلّ رِدفٍ وافِرٍ وارِمٍ","يحمله بالظلم خَصرٌ دقيق",43,"ق",1,0],["وَكلُّ رَبعٍ فِيهِ سِمعٌ يَخمَعُ","وَيَنئِمُ البُومُ بِهِ والضُّوَعُ",44,"ع",1,0],["وكلُّ رَهينٌ بما قد جناهُ","وكل امرئٍ ضامنٌ ماتولّى",45,"ل",2,0],["وكلُّ رقيقِ الشفرتين متى يَخُضْ","إلى المجدِ بَحْرَ الموتِ وهو شَفير",46,"ر",1,0],["وكلُّ رُدَيْنِيٍّ أَصمَّ كأَنه","رشاءٌ أَغارَتْهُ الأَكُفُّ المَواتِحُ",47,"ح",1,0],["وكلُّ رياضٍ له ذابلٌ","إذا ما ذوى غصنه أورقا",48,"ق",2,0],["وكلُّ رأي خيراً ولم يك خارجاً","عن الحكمِ بالميزانِ نقصاً ورُجحانا",49,"ن",2,0],["وَكُلُّ رِياضٍ بِها زاهِرٌ","وَكُلُّ شَرابٍ بها رائِقُ",50,"ق",1,0],["وكل رقيقةٍ منهنَ قامت","بها منهُ دقائقِ كالتلالِ",51,"ل",1,0],["وَكُلِّ رَدينِيٍّ أَصَم كُعوبُهُ","يَنوءُ بِنَصلٍ كَالعَقيقَةِ زاهِرِ",52,"ر",1,0],["وكلُّ رُبَّانٍ جرى من مامي","في القُطبِ يلقى الجُزرَ بالإقدامِ",53,"م",1,0],["وكل روض في مثال الجنّه","واقٍ لإخوان الصفا كالجُنّه",54,"ه",1,0],["وكل رزية جلل إذا ما","بقيت لنا بسعد واقتبال",55,"ل",1,0],["وكلُّ رقيٍّ للأنام أساسه","علومٌ وأخلاق وفنٌّ مهذبُ",56,"ب",1,0],["وكل رتبة عز أنت رونقها","وفوق كل معاليك الرقيّات",57,"ت",1,0],["وكل راكب نضو قد تخوفه","وراجل جاء يمشي حافيا وقعا",58,"ع",2,0],["وكلُّ رقيقِ الشفرتينِ كأنّهُ","وقد أخلقته الحادثاتُ جَديدُ",59,"د",1,0],["وَكُلُّ رُودٍ أُلبِسَت","بُردَ الشَبابِ المُعلَمِ",60,"م",1,0],["وكل روح رسول الموت يقبضها","بإذن مولاه إذ تستكمل العمرا",61,"ر",2,0],["وَكَلُّ رَسُولٍ قَبلَ بِعثَتِهِ أتَى","فَمَا كانَ إِلاَّ نَائِباً يَحفَظُ الأمرَا",62,"ر",2,0],["وَكُلٌّ رَمى بِالزُّجِّ يُحكِمُ رَشقَهُ","فَبالعُنقِ مِزراقٌ وبالفَخذِ آخِرُ",63,"ر",1,1],["وكل ركب حباه المصطفى منناً","حداً بتهذيب رجع البشر أنيقه",64,"ق",2,0],["وكل ربح بلاه نام","فذاك سخر بدا وخسر",65,"ر",1,0],["وكل رديني ضياء سنانه","كنجم ظلام الغيم عنه مكشف",66,"ف",1,0],["وكلُّ رأي منهم كراءٍ","وأرضُ مصر كلام واصلْ",67,"ل",1,0],["وكل رزء على قدر المصاب به","فسل عن البحر إن غيضت زواخره",68,"ر",2,0],["وَكُلّ رجائي أَن أَعودَ لطيبَةٍ","أجاور فيها من أرجّي لقاءَهُ",69,"ا",3,0],["وَكُلُّ رزءٍ وَإِن جَلَّ المُصابُ بِهِ","إِلّا مُصابَكَ بِالإِخوانِ مُحتَمَلُ",70,"ل",1,0],["وكل ركن فيه قد تجمعت","نفاية البيوت بالأقذار",71,"ر",1,0],["وكل رجاء في مديحك ماثل","تسامى به حبا عبيد وأحرار",72,"ر",1,0],["وكلُّ ربعٍ وإن حلَّ الجميعُ به","قَفْرٌ إذا لم تكنْ فيه ابنة العنب",73,"ب",1,0],["وكل رجلً بميقافه لاجاء يبرزاء","بمعطاه الاله وطبعه ومنبعه",74,"ع",2,0],["وكل رجس خبيث قد ثماه الى","شر الخلايق والأنساب شر أب",75,"ب",1,0],["وكلٍ رحل يحمل بقايا غرامه","وراحت حياته يوم راحت حياتي",76,"ت",2,0],["وكل ريحٍ تدفع شراع العمر","ينقطع به حبل ويميل العمود",77,"د",1,0],["وَكُلُّ رَجَافٍ إِذا سَقاها","بِدِيَمٍ مَع رَهِمٍ وَلاها",78,"ا",3,0],["وكل رشيق القد صقل مهنّدٍ","اذا جردوه الغمد يشبهها خصرا",79,"ر",2,0],["وكل رسول مذ رآه رقى به","لأوج معاني الذات عن تبعيتي",80,"ت",2,0],["وكلٌ راغبٌ في وصلِ ليلى","وليلى حسنها في الأرضِ بَدرُ",81,"ر",1,0],["وكلٌ راحلٌ وبلا رجوعٍ","إلى لحدٍ تعانقهُ القبورُ",82,"ر",1,0]]}