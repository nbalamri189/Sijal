{"poems":[[55,"يا دين قلبك من","https://www.aldiwan.net/poem30734.html","المجتث"],[51,"يا نفس ما هو إلا صبر أيام","https://www.aldiwan.net/poem63107.html","البسيط"],[51,"سكر الشباب جنون","https://www.aldiwan.net/poem63129.html","المجتث"],[69,"انظر بحقك في أمر الدواوين","https://www.aldiwan.net/poem18116.html","البسيط"],[48,"ما أقبح المين قلتم لم يشب أحد","https://www.aldiwan.net/poem23380.html","البسيط"],[48,"حاشيت غيري ونفسي ما أحاشيها","https://www.aldiwan.net/poem23572.html","البسيط"],[189,"أخلآى بالثغر دام الفراق","https://www.aldiwan.net/poem14614.html","المتقارب"],[190,"رويدا أيا إسحاق واسمع فإنني","https://www.aldiwan.net/poem44118.html","الطويل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[202,"دعا بإقامة الشوق الرحيل","https://www.aldiwan.net/poem51908.html","الوافر"],[203,"طريدة بؤس مل من بؤسها الصبر","https://www.aldiwan.net/poem45157.html","الطويل"],[227,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[284,"وللزنبور والبازي جميعاً","https://www.aldiwan.net/poem2627.html","الوافر"],[325,"قل للمعالي ترطب مسمعي طربا","https://www.aldiwan.net/poem67218.html","البسيط"],[412,"أمن خيال هداه الشوق والحلم","https://www.aldiwan.net/poem50109.html","البسيط"],[505,"قد أبصر الزمان علوى وغفا","https://www.aldiwan.net/poem37959.html","الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138202",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138215",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138441",""],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59315","الوافر"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26680","الوافر"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124727","الطويل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137945",""],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27603","الوافر"],[2258,"","https://poetry.dctabudhabi.ae/diwan/poem/198783","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91800","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114064","الرجز"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102748","الطويل"],[4927,"عُبُوْرُ السِّنِيْن","https://www.poetsgate.com/ViewPoem.aspx?id=29648",""],[5186,"تألق عيد النحر كالعقد في النحر","https://www.poetsgate.com/ViewPoem.aspx?id=156439",""],[5246,"إليك جواباً موضحا مسلكَ الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=187077",""],[482,"ما لم تزوروا فالمامُ الكرى زورُ","https://www.poetsgate.com/ViewPoem.aspx?id=111256",""],[5691,"هراوة أمريكا","https://www.poetsgate.com/ViewPoem.aspx?id=206339",""],[5785,"ذكرتك وقد فاض دمع الغمام","https://www.poetsgate.com/ViewPoem.aspx?id=131563",""],[5943,"بإيمانٍ فلاحُ المسلمينا","https://www.poetsgate.com/ViewPoem.aspx?id=37270",""],[5970,"تقود كل فتى في الدهر آمال","https://www.poetsgate.com/ViewPoem.aspx?id=130601",""]],"verses":[["وَلِلزَفيرِ هَبابٌ","بَينَ الضُلوعِ وَهَبُّ",0,"ب",1,0],["وَلِلزَمانِ وَعيدٌ في تَصَرُّفِهِ","إِنَّ الزَمانَ لَذو نَقضٍ وَإِبرامِ",1,"م",1,0],["وَلِلزَمانِ تَثَنٍّ","كَما تَثَنّى الغُصونُ",2,"ن",1,0],["وَلِلزُّيُوتِ وَإيقَادِ الْكَنَائِسِ كَمْ","وَلِلدَّقِيقِ المُهَيَّا لِلْقَرابِينِ",3,"ن",1,0],["وَلِلزَمانِ مَغارٌ في نُفوسِهُمُ","يَكفيكَ أَن تَضَعَ الهِندِيَّ بِالقِمَمِ",4,"م",1,0],["وَلِلزَمانِ عَلى أَبنائِهِ أَبَداً","حُكومَةٌ لا يَرُدُّ الحُكمَ راشيها",5,"ي",3,0],["وللزور في حال تشنيعه","مَبادٍ عواقبُها الاِمِّحَاق",6,"ق",1,0],["وللزاد حقّ لا يراعيه عاجز","ولكن يراعي حقه الكيس الندب",7,"ب",1,0],["وَللزوجِ ما تَأتي بهِ من خليلها","من الولدِ مَنسوبٌ وإن زَنَيا جهرا",8,"ر",2,0],["وللزفراتِ إثرَ العيسِ زجرٌ","تُحَثُّ به الظعائنُ والحمول",9,"ل",1,0],["وللزهر منها نغمة الحسن عاطراً","وفيها ذبول مثلما ذبل الزهرُ",10,"ر",1,0],["وللزمان والمكان مفعل","بالفتح من مضارع كيجهل",11,"ل",1,0],["وللزنبور والبازي جميعاً","لدى الطيران أجنحة وخفق",12,"ق",1,1],["وَلِلزَمانِ عِناياتٌ وَإِن نُدِرَت","حَبلى اللَيالي بِها كَم أولِدَت عَجَبا",13,"ب",2,0],["وَلِلزَّمانِ الَّذي أَخنى عَلى جَلدي","كن كَيفَ شِئتَ فَلي جَدٌّ وَمُعتَصِمُ",14,"م",1,0],["وللزَّمانِ يا هُذَيْمُ عُصبَةٌ","مِحوَرُها للفانِياتِ انْصرفَا",15,"ف",2,0],["وللزكي فعال لست أحصرها","هي الخلوة فكم صدع لنا رأبا",16,"ب",2,0],["وللزوجين وفقهما اغتباط","يجل عن النعوت أو الصفات",17,"ت",1,0],["وللزيتون اشجار عليها","عقود زمرد كانت حليه",18,"ي",2,0],["وَلِلزَّفَرَاتِ فِي الكبدِ الْتِهَابٌ","وَلِلْعَبَرَاتِ في الخد انسكَابُ",19,"ب",1,0],["وللزاهي الكمالُ سناً وحسناً","كما وسٍعَ الجلالةَ والكمالا",20,"ل",2,0],["وللزوج نصفٌ وهو إن كان عندهم","لها ولدٌ يوماً إلى الربع يربعُ",21,"ع",1,0],["وللزمهرير المنيخ على ال","أضالع وخزٌ كوخز الابر",22,"ر",1,0],["وللزهراء ميلُ هوى وحب","فويلٌ للشجيِّ من الخليِّ",23,"ي",1,0],["وللزعامة أهوال المكوس وما","حاز الزعامة إلا كل همّام",24,"م",1,0],["وَللزمان انقلابٌ في تصرّفِه","كما تُشاهدُ وَالتَحويلُ مشهود",25,"د",1,0],["وَلِلزَّمَخشَرِي هُنَا قَولٌ يُعَاب","وَلَيسَ يَخطُرُ بِذِهنِ مَن أصَاب",26,"ب",1,0],["وللزهر في وسط السماء وسامة","كزهر تبدى في خلال الحدائق",27,"ق",1,0],["وَ لِلزَّمَاْنِ عَلَىْ أَعْمَاْرِنَاْ أَثَرٌ","وَفِي السِّنِيْنِ عَلاْمَاْتٌ عَلَى الأَجَلِ",28,"ل",1,0],["وللزهر أرواح الشذا من ربيعه","وللزهر من آلائه نورها الدري",29,"ر",2,0],["وللزوج نصف إن تمُتْ زوجُه ولم","تخلفْ لها نسلا بفرض تحددا",30,"د",2,0],["وللزمانِ بأهليهِ ولو كَرِهوا","وبالدَّيارِ تصاريفٌ وتغييرُ",31,"ر",1,0],["وللزَّمانِ رجالٌ ما جَرى أبَداً","ترْعى الأمانَةَ أسْلافاً وأخْلافا",32,"ف",2,0],["وللزهر بين الرياض ابتسام","وتفتير كالأجفان",33,"ن",1,0],["وللزوجات يبقى الفكرَ نصحًا","ويصَحبُ أمَّهُ وأباهُ لينا",34,"ن",2,0],["وللزمان وكل عاشقون له","طول التجني وللأيام إذلال",35,"ل",1,0]]}