{"poems":[[90,"لو أسكر الإنسان باطل أمره","https://www.aldiwan.net/poem45061.html","الطويل"],[93,"قل للحمائم في ضفاف الوادي","https://www.aldiwan.net/poem8798.html","عموديه"],[93,"لو كان لي غير قلبي عند مرآك","https://www.aldiwan.net/poem9048.html","عموديه"],[91,"في الفن معنى حسنه لا يعرف","https://www.aldiwan.net/poem44754.html","الكامل"],[87,"قم سابق الساعة واسبق وعدها","https://www.aldiwan.net/poem62977.html","الرجز"],[87,"يا ناشر العلم بهذي البلاد","https://www.aldiwan.net/poem63771.html","السريع"],[30,"لولا جرير لم تكوني قبيلة","https://www.aldiwan.net/poem5021.html","الطويل"],[46,"لا أنت أنت ولا الديار ديار","https://www.aldiwan.net/poem30516.html","الكامل"],[71,"أخجلتني بتواتر الإحسان","https://www.aldiwan.net/poem28696.html","الكامل"],[107,"تلك العروبة جرحها يجري دما","https://www.aldiwan.net/poem42060.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42815","البسيط"],[108,"المادة","https://www.poetsgate.com/ViewPoem.aspx?id=179426",""],[215,"غنى المغنون من حولى فما سمعت","https://www.aldiwan.net/poem46768.html","البسيط"],[236,"لمن المطايا في رباها تنفخ","https://www.aldiwan.net/poem44593.html","الكامل"],[237,"لمن اللحاظ مريضة الأجفان","https://www.aldiwan.net/poem14748.html","الكامل"],[240,"لو أنصفت ذات النصيف","https://www.aldiwan.net/poem31817.html","مجزوء الكامل"],[257,"سيف بجفنك مغمد مسلول","https://www.aldiwan.net/poem1421.html",""],[280,"طلت نجيعي أطلاء وأطلال","https://www.aldiwan.net/poem25537.html","البسيط"],[287,"لا والمطايا يعتسفن البيدا","https://www.aldiwan.net/poem32795.html","الكامل"],[308,"ذو قامة من لينها","https://www.aldiwan.net/poem57897.html","مجزوء الكامل"],[376,"أما على كرم ابنة الكرام","https://www.aldiwan.net/poem57158.html","أحذ الكامل"],[398,"يا وصل مالك لا تعاود","https://www.aldiwan.net/poem53658.html","مجزوء الكامل"],[422,"عفت المنازل رقة ونحولا","https://www.aldiwan.net/poem54062.html","الكامل"],[422,"عاد الفؤاد من الجوى ما عادا","https://www.aldiwan.net/poem54072.html","الكامل"],[463,"خفف بذات البان من أثقالها","https://www.aldiwan.net/poem55951.html","الرجز"],[519,"هذا الحمى فانزل على جرعائه","https://www.aldiwan.net/poem20799.html","الكامل"],[520,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[520,"لولا جفون ومقل","https://www.aldiwan.net/poem12209.html","مجزوء الكامل"],[534,"أقول بعد الحمد","https://www.aldiwan.net/poem37446.html","مجزوء الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48676","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48674","الكامل"],[1303,"","https://poetry.dctabudhabi.ae/diwan/poem/199260","البسيط"],[1715,"","https://poetry.dctabudhabi.ae/diwan/poem/17519","المجتث"],[1845,"","https://poetry.dctabudhabi.ae/diwan/poem/132181","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53225","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93530","الكامل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102548","الكامل"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79706","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102932","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54502","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81722","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83131","الكامل"],[4532,"","https://poetry.dctabudhabi.ae/diwan/poem/45309","الرجز"],[4542,"","https://poetry.dctabudhabi.ae/diwan/poem/76556","البسيط"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52170","الكامل"],[3271,"عارية ستانلي باي","https://www.poetsgate.com/ViewPoem.aspx?id=102703",""],[5216,"ذكرى فتح مِصْر","https://www.poetsgate.com/ViewPoem.aspx?id=186887",""],[5271,"على ضفافكِ أَستطيبُ عَذابي","https://www.poetsgate.com/ViewPoem.aspx?id=60537",""],[333,"بنت السراب","https://www.poetsgate.com/ViewPoem.aspx?id=105873",""],[5517,"أشجار وراء السياج","https://www.poetsgate.com/ViewPoem.aspx?id=199054",""],[4222,"أهدى النسيم لنا ريا الرياحين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52910&r=&rc=202",""]],"verses":[["لولا جمود في الشرائع مهلك","لتغيّرت بتغّير الأزمان",0,"ن",1,0],["لَولا جَبابِرَةُ القَرائِحِ لَم يَسِر","في الأَرضِ ذِكرُ جَبابِرِ القُوّادِ",1,"د",1,0],["لَولا جَناحاكِ لَم تَسلَم طَريدَتُهُم","قَد نَجَيّاكِ وَلَكِن أَينَ مَنجاكِ",2,"ك",1,0],["لولا جمال حواره وجلاله","كانت حياة الفن شيئا يسخف",3,"ف",1,0],["لَولا جُهودٌ لا نُريدُ جَحدَها","وَحُرمَةٌ مِن قُربِكَ اِستَمَدَّها",4,"د",3,0],["لَولا جُلّى زَيتونِيَ النَضرِ ما","أَقسَمَ بِالزَيتونِ رَبُّ العِباد",5,"د",1,0],["لَولا جَريرٌ لَم تَكوني قَبيلَةً","بَجيلٌ وَلَكِن جَدَّهُ بِكِ أَصعَدا",6,"د",2,1],["لَولا جِلادُ أَبي سَعيدٍ لَم يَزَل","لِلثَغرِ صَدرٌ ما عَلَيهِ صِدارُ",7,"ر",1,0],["لولا جمالُ الدينِ لم أُذكرْ ولو","أني أكونُ الشافعيَّ الثاني",8,"ن",2,0],["لولا جَهالَتُها وباطلُ أهلِها","لأَضاءَ من أقطارِها ما أظلما",9,"م",2,0],["لَوْلا جَرِيرَةُ عَيْنِي مَا سَمَحْتُ بِهَا","لِلدَّمْعِ تَسْفَحُهُ الأَطْلالُ وَالدِّمَنُ",10,"ن",1,0],["لولا جمالُ الحور، ما لامَسَتْ","أرضَ المصَّلى جبهةُ الساجد",11,"د",1,0],["لولا جمالك تصبيني فواتنُه","ما فقت في الشعر والتغريد أقراني",12,"ن",2,0],["لولا جنودك قابلوها حجرة","فكأنهم صبراً جبالٌ رسخ",13,"خ",1,0],["لَولا جَهالَةُ عاذِلي ما لا مَني","وَهوَ الخَلِيُّ مِنَ الهَوى وَلَحاني",14,"ن",2,0],["لَولا جَلالُ الدينِ يُع","دينا عَلى الزَمَنِ العَسوفِ",15,"ف",1,0],["لَولا جُدودُكَ وَالمَنايا شُرَّعٌ","حالَت قَناً دونَ المُنى وَنُصولُ",16,"ل",1,0],["لَوْلا جِبِلَّتُكَ العُلْيَا عَشيرَتُهَا","لَكانَ لِلشِّعرِ إِكْدَاءٌ وإِجْبَالُ",17,"ل",1,0],["لَولا جِفانُكَ في الفَلاءِ لأَصبَحَ ال","مَوجودُ في أَيّامِهِ مَفقودا",18,"د",2,0],["لولا جوارح طرفه","غنى الحمام بها وغرد",19,"د",1,0],["لَولا جوارُ الناسِ في يَدِه","جرتِ الخُطوبُ بِها عَلى الرَّسمِ",20,"م",1,0],["لَولا جَرائِرُ ذلِكَ ال","جَمَلِ الَّذي قَد قيلَ مارِد",21,"د",1,0],["لولا جميلُ أبي جميل ما رأت","عيناي وجه الصَّبر فيه جميلا",22,"ل",2,0],["لولا جميل أبي الثناء وإنَّه","يولي الجميل ويكرم الوفّادا",23,"د",2,0],["لولا جنونُ الحبّ وخبالُهُ","لم نرضَ منها بسُرى خيالها",24,"ل",3,0],["لولا جُمودُ الدُرِّ بين شِفاهِهم","ما ذابَ في طَرْفي عقيقُ بُكائِهِ",25,"ا",3,0],["لولا جميل بلائه لتفجرت","خلج البلا وتداعت الأقطار",26,"ر",1,0],["لولا جفون ومقل","محكولة من الكحل",27,"ل",1,1],["لَوْلاَ جَرَى التَّعْويلُ","مَا كانَ لِي ذَا الْقَوْلُ",28,"ل",1,0],["لولا جراحات النفوس تثيرها","لم نأمن التخدير والتنويما",29,"م",2,0],["لولا جهادك راحلاً متنقِّلاً","لشكت إليك تنقُّلاً ورحيلا",30,"ل",2,0],["لولا جَوارِحُ ألْحاظٍ له صدَحتْ","وُرْقُ الحممِ على مَيَّادِ قامتِهِ",31,"ه",1,0],["لَولا جِوارٍ حَسّانٌ","حورُ المَدامِعِ أَربَع",32,"ع",1,0],["لولا جمالك لم يكن","في بيته صيّرت سجنه",33,"ن",2,0],["لولا جلالك عن مثل يقاس به","من الورى كائناً في الدهر من كانا",34,"ن",2,0],["لَولا جَميل العَفو مِنهُ لَدَمروا","زمر الضَلالة شَيبها وَشَبابها",35,"ب",3,0],["لولا جنانك ثابتاً ومثبتا","ومصمما لم يرعوى لمشاور",36,"ر",1,0],["لولا جمالك ما عرفت محبة","عمري ولم أشغف بنيل وصال",37,"ل",1,0],["لولا جداك لاضحى الناس كلهم","شبيه قفر بلا ماء ولا عشب",38,"ب",1,0],["لولا جسارَةُ قلبي ما ثبتُّ على ال","عُبُورِ من طَرَبٍ في جِسرِ جسرين",39,"ن",1,0],["لولا جميل الصفحِ عنهمْ أصبحوا","خبراً هناك لمنجدٍ ولمتهم",40,"م",1,0],["لَولا جُهودُ الغَربِ حُجِّبَ علمُها","وَتَشابَه المَسئولُ فيهِ بِسائِلِ",41,"ل",1,0],["لَولا جَريرٌ هَلَكَت بِجيلِهِ","نِعمَ الفَتى وَبَئِسَتِ القَبيلَة",42,"ه",1,1],["لَولا جُفُونُكَ لَم يَدرِ الوَرى أَبَداً","كَيفَ اِنتضاءُ المَرامي يَومَ صِفّين",43,"ن",1,0],["لولا جلالُ مشيِبهِ في عَرشِهِ","لمَثلتُ يزهوني لديه شبابي",44,"ب",2,0],["لولا جلال الفن في بهرةٍ","للحسن أصلتني بنيرانِهِ",45,"ن",2,0],["لولا جمالٌ يَفتِنُ الشُّعراءَ","أهديتُ مصرِ قصيدةً عصماءَ",46,"ا",2,1],["لولا جمالكِ ما كتبتُ قَصائدي","وَبَقيتُ مهموماً بغيرِ صَوابِ",47,"ب",1,0],["لولا جفاؤك قلتُ من شغفي","لمْ يُبدع الخلاّق إلاّكِ",48,"ك",1,0],["لولا جديدٌ يستفزُّ حروفها","ويثيرُ منها أعْزلاً أو شاكيا",49,"ي",2,0],["لولا جسارة قلبي ما ثبت على العبور","من طرب من جسر جسرين",50,"ن",1,0]]}