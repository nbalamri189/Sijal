{"poems":[[53,"هذي الرماح عصي الضال والسلم","https://www.aldiwan.net/poem29765.html","البسيط"],[364,"مقامك مجد والمسير معال","https://www.aldiwan.net/poem60670.html","الطويل"],[403,"مولاي قد أحسنتم","https://www.aldiwan.net/poem33347.html","مجزوء الرجز"],[403,"عذرا إلى مولاي عذرا","https://www.aldiwan.net/poem33927.html","مجزوء الكامل"],[441,"عوجوا رقاب اليعملات الذلل","https://www.aldiwan.net/poem14338.html","الكامل"],[513,"سقى الله رمل القاع في النخلات","https://www.aldiwan.net/poem67774.html","الطويل"]],"verses":[["لَقَصدِنا تَتَمَطّى كُلَّ راقِصَةٍ","هَوجاءَ تَخبِطُ هامَ الصَخرِ وَالرَجَمِ",0,"م",1,0],["لِقَصْدي أبا سَعْدٍ تَفاءلْتُ راحلاً","فأصبحَ مَرْآه يُصدِّقُ فالي",1,"ل",2,0],["لقصد روح النفس","من طول كد الدرس",2,"س",1,0],["لقصصت من مكنون أخبا","ري لكم نظماً ونثرا",3,"ر",2,0],["لقصيه السامي لعبد منافه","ولهاشم عمرو العلا السامي العلي",4,"ل",2,0],["لقصرٍ على وادي زبالة مشرفٍ","أكفكف في أكنافه عبراتي",5,"ت",2,0]]}