{"poems":[[55,"هذي الرماح عصي الضال والسلم","https://www.aldiwan.net/poem29765.html","البسيط"],[369,"مقامك مجد والمسير معال","https://www.aldiwan.net/poem60670.html","الطويل"],[409,"مولاي قد أحسنتم","https://www.aldiwan.net/poem33347.html","مجزوء الرجز"],[409,"عذرا إلى مولاي عذرا","https://www.aldiwan.net/poem33927.html","مجزوء الكامل"],[447,"عوجوا رقاب اليعملات الذلل","https://www.aldiwan.net/poem14338.html","الكامل"],[518,"سقى الله رمل القاع في النخلات","https://www.aldiwan.net/poem67774.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87181","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87061","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86826","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86618","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87092","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48659","الكامل"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202130","الرجز"],[2654,"","https://poetry.dctabudhabi.ae/diwan/poem/105068","الكامل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116519","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59501","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94636","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136759",""],[6031,"هِيَ الدارُ تَستسقيكَ مَدْمَعَكَ الجاري","https://www.poetsgate.com/ViewPoem.aspx?id=46266",""]],"verses":[["لَقَصدِنا تَتَمَطّى كُلَّ راقِصَةٍ","هَوجاءَ تَخبِطُ هامَ الصَخرِ وَالرَجَمِ",0,"م",1,0],["لِقَصْدي أبا سَعْدٍ تَفاءلْتُ راحلاً","فأصبحَ مَرْآه يُصدِّقُ فالي",1,"ل",2,0],["لقصد روح النفس","من طول كد الدرس",2,"س",1,0],["لقصصت من مكنون أخبا","ري لكم نظماً ونثرا",3,"ر",2,0],["لقصيه السامي لعبد منافه","ولهاشم عمرو العلا السامي العلي",4,"ل",2,0],["لقصرٍ على وادي زبالة مشرفٍ","أكفكف في أكنافه عبراتي",5,"ت",2,0],["لقصرت مِنهُ عَن إِحصاء أَيسَره","رماحُ أَقلامه في أَلف دِيوان",6,"ن",1,0],["لقصرت عَن إِحصا مَناقبه الَّتي","بأيسرها يَزدان رَب المَراحم",7,"م",1,0],["لَقصرت عَن إِحصاء أَدنى مَناقب","لَهُ اِشتُقَّ مِنها وَهوَ في مَهده النَصر",8,"ر",1,0],["لقصرت عَن إحصاء مَعشار عشر ما","بِهِ تَتَحلّى مِن علاه مَناقب",9,"ب",1,0],["لقصرت عَن إحصاء بَعض مَناقب","بِها اشتهرت في الخافقين تراجم",10,"م",1,0],["لقصر في بلاد الصين سامٍ","رجاك الروس أم لبناء رمس",11,"س",1,0],["لِقَصرٍ في مدّةِ الإِرساء","مِن ظُهر يَومِنا إلى المَساءِ",12,"ا",2,0],["لقصة واحدة أو دونها","بموجبات العقل يوردونها",13,"ه",2,0],["لقصدته ولئمت ترب ضريحه","وقطعت بيدا مثلها لا تقطع",14,"ع",1,0],["لقصد ارتواء لا لنقص ولم يزل","له ذو افتقار مد فانى لدى فقر",15,"ر",1,0],["لقصدتها قصدَ الكمّ","يِ الباسلِ الشَّرسِ القَرومِ",16,"م",1,0],["لقصر قيصرَ قد أقبلت معتذراً","إذ عفوهُ لقصور الحب ساترهُ",17,"ر",2,1],["لقصور باعي عن عداد صِفاته","وهي النُجوم وعدها أعياني",18,"ن",2,0],["لَقصَّرْتُ عن إدراكِ ما يستحقُّهُ","عُلاَهُ فَإقْلالي سَوَاءٌ وإكثاري",19,"ر",2,0]]}