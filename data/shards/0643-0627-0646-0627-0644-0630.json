{"poems":[[65,"نظرت وللأدم النوافخ في البرى","https://www.aldiwan.net/poem45783.html","الطويل"],[29,"أواصل أنت أم العمرو أم تدع","https://www.aldiwan.net/poem5802.html","البسيط"],[23,"رأيت سوادا من بعيد فراعني","https://www.aldiwan.net/poem21318.html","الطويل"],[53,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[91,"صبوا على الاسماع نارا","https://www.aldiwan.net/poem44849.html","مجزوء الكامل"],[91,"وما الارض والانسان يجثم فوقها","https://www.aldiwan.net/poem44858.html","الطويل"],[91,"في الصدر حتى كدت تردى","https://www.aldiwan.net/poem44868.html","مجزوء الكامل"],[47,"نسعى وأيسر هذا السعي يكفينا","https://www.aldiwan.net/poem66668.html","البسيط"],[18,"كنا نغار على العواتق أن ترى","https://www.aldiwan.net/poem23924.html","الكامل"],[107,"سأتبع يوم السبت ما عشت لعنة","https://www.aldiwan.net/poem42139.html","الطويل"],[50,"أمربعنا بالشط لا لعب البلى","https://www.aldiwan.net/poem62578.html","الطويل"],[52,"نأتك على طول التجاور زينب","https://www.aldiwan.net/poem64821.html","الطويل"],[52,"أجارتنا ما بالهوان خفاء","https://www.aldiwan.net/poem64883.html","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/1314","البسيط"],[72,"","https://poetry.dctabudhabi.ae/diwan/poem/5577","الطويل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/23638","الطويل"],[92,"عتاب مع النفس ..","https://www.poetsgate.com/ViewPoem.aspx?id=179099",""],[18,"كُنَّا نَغَارُ عَلَى الْعَوَاتِقِ أَنْ تَرَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26470&r=&rc=36",""],[156,"الشوكة","https://www.aldiwan.net/poem17104.html","عموديه"],[190,"عظ النفس أن تصبو إلى شهواتها","https://www.aldiwan.net/poem44109.html","الطويل"],[228,"بكت وهي صرعى من هموم تحيقها","https://www.aldiwan.net/poem41892.html","الطويل"],[280,"أمولاي حق العبد تقرير عذره","https://www.aldiwan.net/poem25424.html","الطويل"],[280,"ما العيد بعدك بالأماني عائد","https://www.aldiwan.net/poem25592.html","الكامل"],[303,"أرأيت كيف ذرى الدموع وناحا","https://www.aldiwan.net/poem36810.html","عموديه"],[333,"تعاليت لا مولى سواك خلقتني","https://www.aldiwan.net/poem54954.html","الطويل"],[356,"وأعرافه الشم التي لاح دونها","https://www.aldiwan.net/poem68981.html","الطويل"],[369,"أرقت وصحبي بنجد هجود","https://www.aldiwan.net/poem60951.html","المتقارب"],[376,"أيترك سر بعد سري لكاتم","https://www.aldiwan.net/poem57133.html","الطويل"],[463,"من العار لولا أن طيفك يطرق","https://www.aldiwan.net/poem56098.html","الطويل"],[500,"سماء الدجى ما هذه الحدق النجل","https://www.aldiwan.net/poem10259.html","الطويل"],[556,"أقلا فشأنكما غير شاني","https://www.aldiwan.net/poem47155.html","المتقارب"],[556,"أمن أجل من سارت بهن الأباعر","https://www.aldiwan.net/poem47825.html","الطويل"],[572,"تريك مرور الليالي العبر","https://www.aldiwan.net/poem69673.html","المتقارب"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[581,"خليلي إما مت يوما وزحزحت","https://www.aldiwan.net/poem1781.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83289","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122658","الطويل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96990","الطويل"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104015","الطويل"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104021","الطويل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39091","المتقارب"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48733","الكامل"],[996,"","https://poetry.dctabudhabi.ae/diwan/poem/82242","الكامل"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17629","الطويل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138077",""],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117531","الطويل"],[1409,"","https://poetry.dctabudhabi.ae/diwan/poem/130253","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122074","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80013","الطويل"],[1583,"","https://poetry.dctabudhabi.ae/diwan/poem/142508","المتقارب"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108762","الطويل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128070","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49579","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77224","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106839","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93564","الطويل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45619","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87790","الكامل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87756","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137143",""],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93436","الطويل"],[2796,"","https://poetry.dctabudhabi.ae/diwan/poem/200309","الطويل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112287","الطويل"],[3469,"","https://poetry.dctabudhabi.ae/diwan/poem/11","المتقارب"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48444","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108212","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108374",""],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118743","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91368","الطويل"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99233","الطويل"],[3896,"","https://poetry.dctabudhabi.ae/diwan/poem/45542","الطويل"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21544","الهزج"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81707","الطويل"],[4478,"","https://poetry.dctabudhabi.ae/diwan/poem/18809","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76758","الطويل"],[4717,"هبي كل عشقٍ في سواك قليلا","https://www.poetsgate.com/ViewPoem.aspx?id=199573",""],[4984,"وَمَنْ لَيْسَ رِزْقِي","https://www.poetsgate.com/ViewPoem.aspx?id=201625",""],[4119,"كأن الذي آلى على بسط كفه","https://www.poetsgate.com/ViewPoem.aspx?id=16215",""],[585,"دعوت وقد أسمعت يا خير قائل","https://www.poetsgate.com/ViewPoem.aspx?id=161902",""],[2365,"كان الذي خفت أن يكونا","https://www.poetsgate.com/ViewPoem.aspx?id=200665",""],[5353,"وطن مستباح","https://www.poetsgate.com/ViewPoem.aspx?id=212462",""],[5431,"تسلل ضوئي...","https://www.poetsgate.com/ViewPoem.aspx?id=202580",""],[5493,"طريق التمني","https://www.poetsgate.com/ViewPoem.aspx?id=201199",""],[5616,"يا قدس","https://www.poetsgate.com/ViewPoem.aspx?id=205249",""],[6068,"ل بُونَةَ فِي قَلْبِي غَرَامٌ مُطَابِق -26-","https://www.poetsgate.com/ViewPoem.aspx?id=175807",""],[6211,"أبكي...إنا قتلناه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78230&r=&rc=1",""],[6229,"مي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65188&r=&rc=14",""],[572,"تُرِيكَ مُرورُ الليالي العِبَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9276&r=&rc=133",""]],"verses":[["كَأَنَّ الَّذي استُودِعتُهُ مِنهُ لؤلؤٌ","يَلوحُ عَلى اَيدي التِّجارِ ثَمينُ",0,"ن",1,0],["كانَ الَّذينَ هَجَوني مِن ضَلالَتِهِم","مِثلَ الفِراشِ وَحَرِّ النارِ إِذ يَقَعُ",1,"ع",1,0],["كَأَنَّ الَّذي يَنزو بِهِ فَوقَ بَطنِها","ذِراعُ قَلوصٍ مِن نِتاجِ اِبنِ عَزهَلِ",2,"ل",1,0],["كان الذي قد كُنت توقنُ أنه","سيكون فاجزعْ واقِناً لا واهنا",3,"ن",2,0],["كان الذي كنتم ظننتم","انه ريح خسارا",4,"ر",2,0],["كأن الذي من فعله جاء نادما","الى نفسه من نفسه يتظلم",5,"م",1,0],["كان الذي قد كنت تأ","مل عونه خصما الدا",6,"د",2,0],["كانَ الَّذي مَنَعَ الإِخوانَ إِن سُئِلوا","تَركَ المَلامِ عَلى الإِغرامِ ماعونا",7,"ن",2,0],["كانَ الذَحيرَةَ لِلزَّمانِ فَقَد أَتى","فَقدانُهُ وَأَخَلَّ رُكنَ مَكاني",8,"ن",2,0],["كأنّ الذي يشدو بمكروهِ ذكرهِا","وذكرِ الأُلى غشّوا بها الشّعب نائحُ",9,"ح",1,0],["كَأَنَّ الَّذي تُبديهِ عِندَ نِكاحِها","وَما قَبلَهُ مِنها عُيونُ جَرادِ",10,"د",1,0],["كأَنَّ الَّذي غالَ الرَحيلُ رُقادَها","بِما عَضَبَت مِن قُربِنا النَفسَ تَعضَبُ",11,"ب",1,0],["كَأَنَّ الَذي يَأتيكَ مِن راحَتَيهِما","عَروسٌ عَلَيها الدُرُّ وَالنُفَساءُ",12,"ا",2,0],["كانَ الَّذي لَيسَ في مَعجومِهِ خَوَرٌ","لِلعاجِمينَ وَلا في هَديِهِ خَلَلُ",13,"ل",1,0],["كانَ الَّذي يُتَّقى رَيبُ الزَمانِ بِهِ","إِذا الزَمانُ بَدَت أَنيابُهُ العُصُلُ",13,"ل",1,0],["كَأَنَّ الَّذي فيهِ مِنَ الحُسنِ وَالضِيا","تَداخَلَهُ زَهوٌ بِهِ فَهوَ يَمرَحُ",14,"ح",1,0],["كأنّ الذي يغشى جنابك نازلٌ","على روضةٍ مَوْليَّةٍ وغدير",15,"ر",1,0],["كأنَّ الذي جاء بالمَخْبثاتِ","غيرُ الذي جاء بالطَّيب!",16,"ب",1,0],["كَانَ الذَّخِيرَة َ لِلزَّمَانِ فَقَد أَتَى","فقدانهُ وَ أخلَّ ركنَ مكاني",17,"ن",2,0],["كَأَنَّ الَّذِي بَيْنَ جَنْبَيَّ مِنْ","يَقِينٍ وَنُورٍ، رَدًى أَوْ أَشَدُّ",18,"د",1,0],["كأن الذي قد كان لم يكن كائنا","إذا النفس فاظت من جميع جهاتها",19,"ت",3,0],["كَأَنَّ الَّذي أَخنى عَلَيها بِجورِه","إِلى هوَّةِ الإِعدامِ جاءَ يَسوقُها",20,"ق",3,0],["كَأَنَّ الذِي تُهْدِيهِ مِنْ تَمْرِها اغْتَذَى","بِرِيقَةِ مَوْمُوقٍ وَرِقَّةِ وامِقِ",21,"ق",1,0],["كانَ الذي مازِلْتُ أحْذرُ كَوْنَهُ","فإِذا أُسَاءُ بِهِ يُسَرّ الحاسِد",22,"د",1,0],["كان الذي ناب البلادَ وَأهلها","قدر تطيش له الحلوم متاحا",23,"ح",2,0],["كأنّ الذاهبين بنو فناءٍ","ونحن بعديَهم أبناءُ خلد",24,"د",1,0],["كأن الذي يخفي الحديثَ بنجوها","على أخفضِ الأصواتِ يشدو على وتر",25,"ر",1,0],["كأنَّ الذي خلَعتْه النٌّحو","رُ من لُؤْلُؤٍ لَبِستْه الخُدود",26,"د",1,0],["كأنَّ الذي يَلقاهُ مِنه عُفاتُهُ","لإفراطِه في جُودِه حُلمُ حالِمِ",27,"م",1,0],["كأن الذي سدَّى وألحمَ روضةٌ","تَفَتَّحُ من حوك الربيع وتُشرِقُ",28,"ق",1,0],["كأن الذي تنفى الحوافر في الثرى","خطوطٌ مساميرُ النعال لها شكل",29,"ل",1,0],["كأنَّ الّذي فَوقها راكبٌ","قَرَا يَذْبُلٍ أوْ سَراتَيْ أبانِ",30,"ن",1,0],["كأنّ الّذي يُثنِي بهنّ وما وفى","بمَبْلَغِهِنّ كافرٌ وهْوَ شاكرُ",31,"ر",1,0],["كأنّ الذي دبَّجْتَ تُسْتَرُ","وطَرّزَتِ السوسُ فيه نُشِرْ",32,"ر",1,0],["كان الذي أتاهما للشاهد","أفضل ممن قد أتى بواحد",33,"د",1,0],["كَأَنَّ الَّذي غَيَّبتَ لَم يَلهُ ساعَةً","مِنَ الدَهرِ وَالدُنيا لَها وَرَقٌ نَضرُ",34,"ر",1,0],["كَأَنَّ الَّذي فيهِ مِنَ العَقلِ قَد أَتى","لِنَزدادَ فيهِ حَسرَةً وَتَأَلُّما",35,"م",2,0],["كأنَّ الذي يَلقَى المَنيَّةَ حاسِراً","مِنَ القَومِ يَلقَى الحَربَ وهوَ مُدَرَّعُ",36,"ع",1,0],["كأن الذي يعطيه باقٍ بكفه","وأن الذي يبقى وإن قل ذاهب",37,"ب",1,0],["كأنّ الذي يحتالُ في ردِّ روحها","مُناج لها أو صاحبٌ يَستشيرها",38,"ر",3,0],["كأنّ الذي زانَ البياض نحورَها","يُعذَّبها هجراً ويقطعها كبرا",39,"ر",2,0],["كأنَّ الَّذي سالَ مِنْ رَأْسِها","عَلى جِسْمِها مِنْ دِماءِ الطِّعانْ",40,"ن",1,0],["كان الذي رضيت به من دهرها","واللّه مرضيها بما سيكون",41,"ن",1,0],["كانَ الَّذي يَدرا العَدو بِدَفعِهِ","فَيَرُدُّ نَخوَةَ ذي المِراحِ الأَصيَدِ",42,"د",1,0],["كَأَنَّ الَّذي يَبكي عَلى قَبرِ مَعقِلٍ","وَلَم يَرَهُ يَبكي عَلى قَبرِ حاتِمِ",43,"م",1,0],["كأن الذي أبصرت ذكرى يبيدها","مرورٌ لأيام النوى وكرور",44,"ر",1,0],["كأن الذي يرنو إليها بطرفهِ","يرى نفسهُ فوقَ السما وهو في الأرضِ",45,"ض",1,0],["كأنّ الذُّرى من ثافِلٍ قُلّعتْ بِهِ","عشَّيةَ لما زالَ عَنْهم فودذَعَا",46,"ع",2,0],["كَأَنَّ الَّذِي غَنَّتْ بِهِ وَهْوُ نَاعِمٌ","مِنَ الوُرْقِ أَعْدَتْهُ بِفَادِحِ أَحْزَانِ",47,"ن",1,0],["كأنَّ الذي بالأفق نعشُك سائراً","وطرفي السهى والحاملون بنو نعش",48,"ش",1,0],["كأَنَّ الذرى موطئي","وجفن السنى مضجعي.",49,"ع",2,0],["كأن الذي استلقى على الخد سارق","غدا برياحين العذار مكتفا",50,"ف",2,0],["كأن الذي في جانب الجيد بلبلٌ","على شرف من خالص الطلع أشرفا",50,"ف",2,0],["كان الذ خيرة والمسا","لك والطراز وعمدة الحذاق",51,"ق",1,0],["كأنَّ الذي أَخْطَتْهُ منهُ بجانبٍ","ولكنْ على أنْ لا يلذَّ ولا يحلو",52,"ل",2,0],["كانَ الَّذي قَتَلَت عُيونُكِ ناسِكاً","مُتَعَبِّداً فَاِستَغفِري وَأَنيبي",53,"ب",2,0],["كان الذي يأسو الجراح إذا","نغلت وأفسدها الدم الكَدِر",54,"ر",1,0],["كَأن الَّذي يطريك بِالمَدح وَالهَنا","يَهني أَمير المؤمنين وَيَمدح",55,"ح",1,0],["كَأَنَّ الَّذي بقى لَنا مِنهُ أفقه","فَضيض سِوارٍ أَو قَراضة دينار",56,"ر",1,0],["كانَ الذَريعة لامريءٍ","أَمسي وَلَيسَ لَهُ ذَريعه",57,"ع",2,0],["كَأَنَّ الَّذي قَد قسمَّ الحسن خَصَّه","بِأَوفر قَسط دُون حَصرٍ وَتَعيين",58,"ن",1,0],["كان الذي يهتز فيه يومه","طرباً ويختال افتخاراً امسه",59,"س",2,0],["كَأَنَّ الَّذي يُسقي الثَّرى صِرفُ قَهوَةٍ","تنمُّ عَلَيهِ بِالضَّمير المكتَّمِ",60,"م",1,0],["كأن الذي يلقى الحمام يفوته","ولم ينج منها من يعلل بنائل",61,"ل",1,0],["كأنَّ الذي قد كَوّنَ الأرضَ خصّهُم","عَلَيهَا بِأيّامٍ مُحَجَّلَةٍ غُر