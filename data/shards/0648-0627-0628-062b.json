{"poems":[[79,"الصبر إلا في هواك حميد","https://www.aldiwan.net/poem36607.html","الكامل"],[74,"ما لي إلى السلوان عنك سبيل","https://www.aldiwan.net/poem19478.html","الكامل"],[94,"عذبة أنت كالطفولة كالأح","https://www.aldiwan.net/poem38954.html","الخفيف"],[47,"حلفت لها بالله يوم التفرق","https://www.aldiwan.net/poem65186.html","الطويل"],[47,"سقى ربعها سح السحاب وهاطله","https://www.aldiwan.net/poem65565.html","الطويل"],[63,"فرقت بين جفونه ورقاده","https://www.aldiwan.net/poem51712.html","الكامل"],[52,"وأبثثت عمرا بعض ما في جوانحي","https://www.aldiwan.net/poem62347.html","الطويل"],[102,"من أغني","https://www.poetsgate.com/ViewPoem.aspx?id=50152",""],[96,"نغمات عودي","https://www.poetsgate.com/ViewPoem.aspx?id=15651",""],[151,"خليلي وافت منكم ذات خلخال","https://www.aldiwan.net/poem47679.html","الطويل"],[236,"إن بان من تهوى وأنت مثبط","https://www.aldiwan.net/poem44584.html","الكامل"],[310,"يا سيدي إني عزمت إيابا","https://www.aldiwan.net/poem56610.html","الكامل"],[409,"هل في الرفاق متيم مثلي","https://www.aldiwan.net/poem33609.html","الكامل"],[534,"مكحولة الحدقات وطفا","https://www.aldiwan.net/poem37321.html","مجزوء الكامل"],[591,"أتراك بالهجران حين فتكت في","https://www.aldiwan.net/poem17606.html","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56404","الكامل"],[1229,"","https://poetry.dctabudhabi.ae/diwan/poem/198459","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112859","المتدارك"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48943","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71083","الكامل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71059","الكامل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104820","الكامل"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143009","الكامل"],[2279,"","https://poetry.dctabudhabi.ae/diwan/poem/142663","الكامل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112512","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72520","الرمل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139735",""],[4908,"أذن الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=207412",""],[5031,"وقست على قلبي الحزين مخاطر","https://www.poetsgate.com/ViewPoem.aspx?id=147658",""],[5137,"مدمنها","https://www.poetsgate.com/ViewPoem.aspx?id=101146",""],[5376,"سكنت فؤادي في الضلوع وأودعت","https://www.poetsgate.com/ViewPoem.aspx?id=197588",""],[6102,"خَيال ..","https://www.poetsgate.com/ViewPoem.aspx?id=183991",""],[2575,"روضة الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=10282",""]],"verses":[["وأبُثُّ سِرّاً في فؤادِيَ دونَهُ","للكَتْمِ بابٌ مُرْتَجٌ مَسْدودُ",0,"د",1,0],["وأبثُّ جرح جوارح بيد الأسى","لكنَّ تجريح الأسى تعديل",1,"ل",1,0],["وأَبثُّ الوُجُودَ أَنغامَ قلبٍ","بُلْبُليٍّ مُكَبَّلٍ بالحديدِ",2,"د",1,0],["وَأَبثَثتُها شَكوى أَبانَت عَنِ الجَوى","وَدَمعاً مَتى يَشهَد بِبَثٍّ يُصَدَّقِ",3,"ق",1,0],["وَأَبثَثتُهُ شَأني وَجَنَّبتُ مُعرِضاً","لِيَفعَلَ صَوبُ المُزنِ ماهُوَ فاعِلُه",4,"ل",2,0],["وأبثُّ في ثِنْيَيْ حَشاه صَبابةً","باتَت لها الأشجانُ بينَ وِسادِه",5,"د",2,0],["وَأَبثَثتُ عَمراً بَعضَ ما في جَوانِحي","وَجَرَّعتُهُ مِن مُرِّ ما أَتَجَرَّعُ",6,"ع",1,1],["وأبثّ الشعر آلام الهوى","وأنادي اللّيل والصمت يجيب",7,"ب",1,0],["وأبثّه شكوى الهوى فإخاله","يبكي عليّ متيّما مهجورا",8,"ر",2,0],["وأبثثتها وجدي وما بين أضلعي","من البعد والأشواق والدمع كالخال",9,"ل",1,0],["وأبثّ بعض المعجرات فنظمها","درٌّ ثمين بالمسامع يلقط",10,"ط",1,0],["وأبثّ شكرك ملءَ فيّ مقارناً","أرجى الدعاء لأن يَكونَ مُجابا",11,"ب",2,0],["وأبث ما عندي وآمن مِنْ","تسديده لقوارع العذل",12,"ل",1,0],["وأَبُثُّهُ شَجْرِي فَلَمْ","أَكْتُمْهُ ممّا نَابَ حَرْفا",13,"ف",2,0],["وَأَبثُّ وَجْدِي في الهَوَى بِتَوصُّلٍ","وَتَوسُّلٍ وَتَطفُّلٍ وَتَلَطُّفِ",14,"ف",1,0],["وأبث المديح ثم بقلب","ولسان تطابقا إقرارا",15,"ر",2,0],["وأبثّ وجداً واشتياقاً عند ال","سنة الفصاحة والبلاغة كلتِ",16,"ت",1,0],["وأَبُثُهُمْ ما قَدْ أَثاروا مِنْ جَوىً","بِفِرَاقِهِمْ واسْتَقْطَرُوا مِنْ أَدْمُعِ",17,"ع",1,0],["وابثت شكواك وكي فطنا","نال الآداب بلا عوج",18,"ج",1,0],["وأبثُّ وجدي للنسيم إذا سرى","فلعلّه في جوّ مصرٍ يَعْبِق",19,"ق",1,0],["وأبُثُّ الفسادَ فيهم وكيدي","يُلبِسُ الرشدَ طلسَمَ النسيانِ",20,"ن",1,0],["وأَبثَّهم شوقي إليهم دائِماً","وتَحَرُّقي لِفراقهم وتَمَلْمُلي",21,"ل",2,0],["وأَبثَّهم شوقي لفَقْدِ لِقائِهم","وتَمَلْمُلي كَتَمَلْمُلِ المحمومِ",22,"م",1,0],["وابثُت صَبَابَةَ مَن بِدِينِ وِدَادِهِم","دَانَ وآلَى حَلَفَةً لَن يُخلِفَا",23,"ف",2,0],["وأبث في شعري وفي أدبي","ولهي عليك فأسمع الصمّا",24,"م",2,0],["وأبث وجدي ما استطع","ت وطول همي واشتياقي",25,"ق",2,0],["وأبثّها لهفى لرؤيتها","وتحّرقى أن أبلغ العدما",26,"م",2,0],["وأبث الشكر مرطوب اللسان","تاكه عاجز كرداز شكرم زبان",27,"ن",1,0],["وأبثُّها الشكوى عقيب وصالها","شكوى الجريح إلى القسىِّ سهامَها",28,"م",3,0],["وأبثُّ لوعاتي نشيداً رائعاً","أمحو بهِ صمتَ الشّجون المطبقا",29,"ق",2,0],["وَأبُثُّ أشْوَاقِيْ، أطيرُ فرَاشَةً","منْ حَوْلِهَا تلكَ الزُّهُورُ نَواضِرُ",30,"ر",1,0],["وَأَبُثُ مَشَاعِرَهَا جَهْرَاً","وَعَلَى الْأوْرَاقِ أُدَوِّنُهَا",31,"ن",3,0],["وأبثها عبق الزهور محبة","فالحب أوقد جمرة الأشواق",32,"ق",1,0],["وَأَبُثُّ لِلطَّيفِ الذِي يَغتالُنِي","حُزنًا تَذُوبُ عَلَى يَدَيهِ الحالُ",33,"ل",1,0],["وأبث للنجم المسهد لوعتي","يا ليتني-بعد النوى- ألقاك",34,"ك",1,0]]}