{"poems":[[4,"طافت أسيماء بالرحال فقد","https://www.aldiwan.net/poem21147.html","المنسرح"],[53,"خدن أبي المستهل خبرني","https://www.aldiwan.net/poem8690.html","المنسرح"],[53,"شهدت بعض المخانيث","https://www.aldiwan.net/poem65476.html","المجتث"],[93,"رأيت غلاما مليح الرواء","https://www.aldiwan.net/poem8783.html","عموديه"],[93,"صبرا على هجرها إن كان يرضيها","https://www.aldiwan.net/poem62813.html","عموديه"],[91,"ومدع بحياة البحر معرفة","https://www.aldiwan.net/poem44722.html","البسيط"],[30,"سألنا منافا في حمالة دارم","https://www.aldiwan.net/poem5410.html","الطويل"],[82,"يقولون لي لا تجيد الهجاء","https://www.aldiwan.net/poem31517.html","المتقارب"],[33,"أرقت ولم آرق لسقم أصابني","https://www.aldiwan.net/poem41851.html","الطويل"],[50,"وخمار أنخت إليه رحلي","https://www.aldiwan.net/poem62483.html","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43870","الوافر"],[190,"جئت أصلي فلم أصلي","https://www.aldiwan.net/poem43359.html","مخلع البسيط"],[190,"سألت عن العمى قوما ظرافا","https://www.aldiwan.net/poem43644.html","الوافر"],[275,"نراودها عجوزا دردبيسا","https://www.aldiwan.net/poem35298.html","الوافر"],[308,"يقول عذولي ما لدمعك أخضرا","https://www.aldiwan.net/poem58137.html","الطويل"],[353,"وقالوا تعرقب في وعده","https://www.aldiwan.net/poem20423.html","المتقارب"],[369,"أتلك رياض أم خدود نواعم","https://www.aldiwan.net/poem60665.html","الطويل"],[466,"وقال رواة الحي لا بل غواته","https://www.aldiwan.net/poem16056.html","الطويل"],[466,"طربت وما دارت علي زجاجة","https://www.aldiwan.net/poem16110.html","الطويل"],[466,"تنادوا فقالوا يا لها من عجيبة","https://www.aldiwan.net/poem16416.html","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38768","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38863","البسيط"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109189","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128722","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53197","الرجز"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130762","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205051","الوافر"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87443","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91603","المتقارب"],[3837,"","https://poetry.dctabudhabi.ae/diwan/poem/114690","الطويل"],[4243,"","https://poetry.dctabudhabi.ae/diwan/poem/122437","الوافر"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28672","الوافر"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113834","البسيط"],[4607,"","https://poetry.dctabudhabi.ae/diwan/poem/132200","المنسرح"],[4691,"\" أمّ الحَمَام \"","https://www.poetsgate.com/ViewPoem.aspx?id=158307",""],[5206,"حجر الفلاسفة","https://www.poetsgate.com/ViewPoem.aspx?id=187417",""],[5302,"قرب الخليل","https://www.poetsgate.com/ViewPoem.aspx?id=200554",""],[5884,"أغالب فيه الشوق والشوق غالبي","https://www.poetsgate.com/ViewPoem.aspx?id=124749",""],[6102,"قبلة الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=184634",""]],"verses":[["فَقُلتُ صابَ الأَعراضَ رَيَّقُهُ","يَسقي بِلاداً قَد أَمحَلَت حِقَبا",0,"ب",2,0],["فقلتُ صِفْها فقال أوسع من","طوقِ الرَّحَى رِخوةٌ كَسَبَّتِهِ",1,"ت",2,0],["فقلت صحِّف مخيفاً","فأنف عمرو مجيف",2,"ف",1,0],["فَقُلتُ صَغيرٌ يُحِبُّ الفَضاء","وَيَكرَهُ ما لَيسَ مِن فِطرَتِه",3,"ه",1,0],["فَقُلتُ صَبراً عَلى كَيدِ الزَمانِ لَنا","فَكُلُّ حافِرِ بِئرٍ واقِعٌ فيها",4,"ي",3,0],["فقلت صف لي كيف الحوت ممتحناً","فقال لي الحوت ذو قرنين كالجمل",5,"ل",1,0],["فَقُلتُ صَدَقتُم يا مَنافَ بنَ فائِشٍ","وَفي فائِشٍ أَنتُم أَدَقُّ وَأَسفَلُ",6,"ل",1,0],["فقلتُ صفاتي فقالوا حسانٌ","فقلتُ نسيبي فقالوا مليح",7,"ح",1,0],["فَقُلتُ صِلي مَن قَد أَسَرتِ فُؤادَهُ","وَعادَ لَهُ فيكِ النَصوحُ عَذولا",8,"ل",2,0],["فَقُلتُ صَدَقتَ يا خَمّارُ هَذا","شَرابٌ قَد يَطولُ إِلَيهِ حاجي",9,"ج",2,0],["فقلت صدقت لم أنكرت منّي","وأنت عفيفةٌ بنت العفافِ",10,"ف",1,0],["فقلت صلني فقال يرجو","مثلك ايضا وصال مثلي",11,"ل",2,0],["فقلت صدقت ذا في الفرد منهم","فقال كذبت هذا في الجماعه",12,"ع",2,0],["فقلتُ صنعتَ معجزةَ ابنِ نونٍ","ففي الدَّيجورِ أطلعتَ الشُّموسا",13,"س",2,0],["فقلت صفا دمعي وقابل صدغه","فأبصرت فيه لون آس عذاره",14,"ه",1,0],["فَقلتُ صَدَقْتُمْ وما مِنْتُمُ","فَما زِلْتُ أَعْرِفُهُ حَائِطَا",15,"ط",2,0],["فقُلتُ صَفِيُّ الدِّينِ سَبّبَ هذِهِ","فلا يَلُمِ السُّحْبَ الغَواديَ لائِم",16,"م",1,0],["فقلتُ صَهٍ جلَّ الودادُ قديمهُ","وحادثهُ عن مُستزيدٍ وعاتبِ",17,"ب",1,0],["فقلتُ صَهٍ إنَّ السرورَ بماجِدٍ","يُقِرُّ له بالفضلِ بادٍ وحاضِرُ",18,"ر",1,0],["فقلْتُ صَهٍ لا أقْتَضي صَبَبَ الحَيا","بجُرْدٍ لأنِّي بالنَّدى أيُّ واثِقِ",19,"ق",1,0],["فَقُلتُ صِلني فَإِنّ الهَجرَ أَتلَفَني","وَهَل لِهَجرك يا مَولايَ مِن سَبَبِ",20,"ب",1,0],["فَقُلت صِلني فَفي قَلبي لَظى اِستَعَرت","وَالدَّمعُ مِن مُقلَتي يَهمي وَيَنسَكِبُ",21,"ب",1,0],["فقلت صدقتم بالذي تنسبونه","إليه وخير القول ما بان صدقه",22,"ق",2,0],["فقلت صدقتم وحييت ذكرا","لعمري أنهن وأنهنه",23,"ن",2,0],["فقلت صاب الغيث والطود رسا","وصاب ليث الغاب والبدر ابتسم",24,"م",1,0],["فقلت صبٌّ بوادي النيل أذهَلَهُ","يوم الفراق ومنه الحيل مهدود",25,"د",1,0],["فقلت صدقت حر من ضمير","ومن ذوق وعقل أو قياس",26,"س",1,0],["فقلتُ صدقتَ بلسمُ فيك يَشفي","وَلَيسَ بِبَلسمٍ ما قلتَ بَل سَم",27,"م",1,0],["فَقُلت صدقتَ وَلا غرو ذا","فَإِنّ النَسيمَ زَكيّ النَفس",28,"س",1,0],["فقلت صدقتم أيها الناس اننى","كذاك ولكن فى حر ام زمانى",29,"ن",2,0],["فقلت صدقتما قد هد ركني","وفارقني الذي بهم أصولُ",30,"ل",1,0],["فَقُلتُ صَدَّقَتني وَعَذَلَت قَلبي","وَلَم أحمِل عَلى عَيني عِتابي",31,"ب",2,0],["فقلت صبرا إلى أن جاء فيصلها","وقد أزيلت به تلك الدجنات",32,"ت",1,0],["فقلت صف لي سبا وساكنها","فعند هذا تنفس الصعدا",33,"د",2,0],["فقلتُ : صدَقْتَ فأمُّ الحمامِ","إرتْريّة ٌ مظهرا ً مخبرا",34,"ر",2,0],["فَقُلتُ صَدَقتِ والتَّعرِيفُ إسْمًا","فَكُنتُ لَك كَمَا كُنتِ سَمِيَّا",35,"ي",2,0],["فَقُلتِ صَدَقتَ بَعلِي هَاكَ مَا قَدْ","زَرَى فِي خُلوَةِ رُطَبًا جَنِيَّا",35,"ي",2,0],["فقلت صبري ليس يجدي وما","يغني عن المجنون صبر ضئيل",36,"ل",1,0],["فقلت صحبت السيد البطل الذي","نمته ملوك من كرام المناصب",37,"ب",1,0],["فَقُلتُ : ( صِلِيني ) , ثُمَّ قَبَّلتُ نَحرَها","بِثَغرِيَ , لَمَّا جَنَّنَ التَّوقَ لَاؤُها",38,"ا",3,0]]}