{"poems":[[65,"أماط والليل أثيث الجناح","https://www.aldiwan.net/poem46168.html","السريع"],[47,"أريتك الآن ألمع البروق","https://www.aldiwan.net/poem65178.html","السريع"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85591","المجتث"],[147,"هل العدل إلا دون ما أنت مظهر","https://www.aldiwan.net/poem11762.html","الطويل"],[290,"نصول اذا حان الدفاع ولا نرى","https://www.aldiwan.net/poem39402.html","الطويل"],[520,"سأجمل نفسي عنك فعل مخفف","https://www.aldiwan.net/poem12297.html","الطويل"],[543,"يا لذة الحلم في إغفاءة الوسن","https://www.aldiwan.net/poem47600.html","عموديه"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64487","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122023","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60982","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91073","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216469","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101376","الطويل"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116075","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120432","المجتث"],[4755,"عِندِي قَصِيدَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=183677",""],[4755,"أَلَا ما أَمَرَّ الصَّمتَ","https://www.poetsgate.com/ViewPoem.aspx?id=205537",""],[4935,"فخار الملوك بأعوانها","https://www.poetsgate.com/ViewPoem.aspx?id=129303",""]],"verses":[["وما أضاءَ البَرْقُ منْ ثَغْرِهِ","إلا تَجَلّى حَبَبٌ فوقَ راحْ",0,"ح",1,0],["وَما أَضَعتَ الحَقَّ في أَجنَبٍ","فَكَيفَ تَنسى واجِباً في الشَقيق",1,"ق",1,0],["وما أَضر بقوم","في الشرق إلا الشقاق",2,"ق",1,0],["وَما أَضعَفَت عَشرُ الثَمانينَ مُنَّتي","كَما تُضعِفُ الضِرغامَ وَهوَ غَضَنفَر",3,"ر",1,0],["وما اضطرب القوقاز ما حن هرسك","وما اشتد غيظاً بوسني ولم يجد",4,"د",1,0],["وما أضيع المعروف إلا صنيعة","يؤرخها شكري وفضل بياني",5,"ن",2,0],["وما أضَرَّ بِقَلبي غيرُ فُرقَةِ مَن","فِراقُهُ كَفِراقِ الرُّوحِ لِلبَدَنِ",6,"ن",1,0],["وما اضطر من ألقى مقاليد ضره","إلى الصمد المعطي بلا قيد علة",7,"ه",1,0],["وَمَا أَضْحَكَتْ غَيْرَ الظُّبَا مِنْ مَبَاسِمٍ","وَلاَ وَرَّدَتْ غَيْرَ الصَّوَارِمِ مِنْ خَدِّ",8,"د",1,0],["وما أضرب الأمثال من أجل زلة","إليك ولا ذنبٍ عظيم فعلته",9,"ت",2,1],["وَما أَضلَّ عُقولاً لَيسَ يَنفعُها","رشد الرشيد وَيُغويها غرورُ غبي",10,"ب",2,0],["وما أضيع الآمال آمال من رأوا","مطالعه في مشرق النور عاليةْ",11,"ي",2,0],["وما اضطربت في نطقها أو تلكنت","فصاحتها إلا إذا اضطربت طقسا",12,"س",2,0],["وما اضطربت رِماحُ الخطِّ إِلاَّ","مخافَةَ أن يُحطِّمَها مُبينَا",13,"ن",2,0],["وما اضطررت للفظ","والحمد للّه معجم",14,"م",1,0],["وما أَضْيَعَ الأَشعَارَ واللَّيلُ شاعِرٌ","وما أَوْحَشَ الدُّنيَا إِذا النَّاسُ أَظلَمُوا",15,"م",3,0],["وما أَضْيَعَ الأَشعَارَ واللَّيلُ جاهِلٌ","وما أَوْحَشَ الدُّنيَا إِذا النَّاسُ أَظلَمُوا",16,"م",3,0],["وما أضعف الله من دولة","(تسود بقوة برهانها)",17,"ن",3,0]]}