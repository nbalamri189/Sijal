{"poems":[[63,"أماط والليل أثيث الجناح","https://www.aldiwan.net/poem46168.html","السريع"],[45,"أريتك الآن ألمع البروق","https://www.aldiwan.net/poem65178.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85591","المجتث"],[143,"هل العدل إلا دون ما أنت مظهر","https://www.aldiwan.net/poem11762.html","الطويل"],[285,"نصول اذا حان الدفاع ولا نرى","https://www.aldiwan.net/poem39402.html","الطويل"],[515,"سأجمل نفسي عنك فعل مخفف","https://www.aldiwan.net/poem12297.html","الطويل"],[538,"يا لذة الحلم في إغفاءة الوسن","https://www.aldiwan.net/poem47600.html","عموديه"]],"verses":[["وما أضاءَ البَرْقُ منْ ثَغْرِهِ","إلا تَجَلّى حَبَبٌ فوقَ راحْ",0,"ح",1,0],["وَما أَضَعتَ الحَقَّ في أَجنَبٍ","فَكَيفَ تَنسى واجِباً في الشَقيق",1,"ق",1,0],["وما أَضر بقوم","في الشرق إلا الشقاق",2,"ق",1,0],["وَما أَضعَفَت عَشرُ الثَمانينَ مُنَّتي","كَما تُضعِفُ الضِرغامَ وَهوَ غَضَنفَر",3,"ر",1,0],["وما اضطرب القوقاز ما حن هرسك","وما اشتد غيظاً بوسني ولم يجد",4,"د",1,0],["وما أضيع المعروف إلا صنيعة","يؤرخها شكري وفضل بياني",5,"ي",1,0],["وما أضَرَّ بِقَلبي غيرُ فُرقَةِ مَن","فِراقُهُ كَفِراقِ الرُّوحِ لِلبَدَنِ",6,"ن",1,0]]}