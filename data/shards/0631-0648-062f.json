{"poems":[[53,"أسألت رسم الدارِ أم لم تسأل","https://www.aldiwan.net/poem65978.html","الكامل"],[58,"أفديكما من حاملي قدحين","https://www.aldiwan.net/poem58488.html","الكامل"],[47,"ناهيك من حرق أبيت أقاسي","https://www.aldiwan.net/poem64589.html","الطويل"],[46,"لو صحح الدمع لي أو ناصح الكمد","https://www.aldiwan.net/poem30314.html","البسيط"],[46,"ها إن هذا موقف الجازع","https://www.aldiwan.net/poem30459.html","السريع"],[46,"أقشيب ربعهم أراك دريسا","https://www.aldiwan.net/poem30481.html","الكامل"],[113,"خفض عليك فما الفؤاد بسالي","https://www.aldiwan.net/poem16260.html","الكامل"],[305,"عوجوا فحيوا أيها السفر","https://www.aldiwan.net/poem45485.html","أحذ الكامل"],[327,"أضحت أميمة لا ينال زمامها","https://www.aldiwan.net/poem56344.html","الكامل"],[473,"غدت إلى ديره ومأواها","https://www.aldiwan.net/poem59533.html","المنسرح"],[473,"تاهت بوجه أزهر","https://www.aldiwan.net/poem60008.html","مجزوء الكامل"],[572,"أطلق عقال الروح بالراح","https://www.aldiwan.net/poem69760.html","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122766","الكامل"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123398","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119863","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64867","الكامل"],[1362,"","https://poetry.dctabudhabi.ae/diwan/poem/113646","الكامل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115889","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100958","البسيط"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131595",""],[1938,"","https://poetry.dctabudhabi.ae/diwan/poem/111203","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48256","الخفيف"],[2234,"","https://poetry.dctabudhabi.ae/diwan/poem/111077","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100381","الخفيف"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100183","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89119","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129491","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91181","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36772","البسيط"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36717","البسيط"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36718","البسيط"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36716","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102932","البسيط"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/107047","البسيط"],[5102,"فتح الأندلس","https://www.poetsgate.com/ViewPoem.aspx?id=12868",""],[5973,"رودي-مرثية","https://www.poetsgate.com/ViewPoem.aspx?id=13241",""]],"verses":[["رودُ الشبيبةِ لا أُعاصي لذةً","تدعو هواي ولا أدينُ لعُذَّلي",0,"ل",2,0],["رُودٌ مُنَعَّمَةٌ ومَهْضومُ الحَشَا","للنّاظِرِينَ مُنىً وقُرَّةُ عَيْنِ",1,"ن",1,0],["رودوا بِأَفنِيَةِ الظِرابِ وَنَكِّبوا","عَن ذَلِكَ الجَبَلِ الأَشَمِّ الراسي",2,"س",2,0],["رودُ الشَبابِ كَنَصلِ السَيفِ لا جَعَدٌ","في راحَتَيهِ وَلا في عودِهِ أَوَدُ",3,"د",1,0],["رودٌ إِذا جَرَّدتَ في حُسنِها","فِكرَكَ دَلَّتكَ عَلى الصانِعِ",4,"ع",1,0],["رودٌ أَصابَتها النَوى في خُرَّدٍ","كانَت بُدورَ دُجُنَّةٍ وَشُموسا",5,"س",2,0],["رود سَقاها الحُسن ماء شَبيبة","وَكَسا مَعاطفها برود دَلال",6,"ل",1,0],["رُؤدُ الشَبابِ كَأَنَّني غُصنٌ","بِحَرامِ مَكَةَ ناعِمٌ نَضرُ",7,"ر",1,0],["رُودٌ إِذا قامَت تَداعى رَملَةٌ","يَنهالُ مِن أَعلى الكَثيبِ هَيامُها",8,"م",3,0],["رودٌ لَها وَجنَةٌ مُوَرَّدَةٌ","لَو مَرَّ وَهمٌ بِها لَأَدماها",9,"ا",3,0],["رودٌ كَأَنَّ بَنانَها","قَصَبُ العَقيقِ الأَحمَرِ",10,"ر",1,0],["رودُ القَوَامِ خريدةٌ","أعطافُها طَوْعُ الرِّياحِ",11,"ح",1,0],["رُودٌ يَضُمُّ المِسكُ صُورَتَها","تَحتَ الغُلالَةِ أَيَّما ضَمِّ",12,"م",1,0],["رَوْدٌ تَرودُ حِمى قَلْبِي وتشربُ من","دَمْعِي وتسكن من صدري إلى حَرم",13,"م",1,0],["رؤد الصبا عمداً أطعت صبابتي","في حبها وعصيت فيها اللوّما",14,"م",2,0],["رُؤْدٌ مُبَرْقَعةُ الملاثِمِ جَفْنُها","يَسْطو بكُلِّ مُلَثَّمٍ ومُبَرْقَعِ",15,"ع",1,0],["رودٌ يرنحها الغرام فتنثني","سكرى كخوط نقاً تأود مورقِ",16,"ق",1,0],["رودُ الشباب عزيزةٌ","نفسى الفداءُ لكلِّ رُودِ",17,"د",1,0],["رُؤدٌ بنا فتكت ألحاظها فَدما","ءُ العاشقين على وجناتها سَلَب",18,"ب",1,0],["رود فالترويد طبع الجيد","ما الغلظه يا سيد للساده",19,"ه",1,0],["رود على عرش النمارق خدرت","دون الحجاب بصعدة سمراء",20,"ا",2,0],["رَوْدَةٌ إِن نضَتْ شُفُوفاً من الرَّي","طِ تراءتْ كالجوهرِ الشفَّافِ",21,"ف",1,0],["رودي ملاعب رامة فبها","سرت المهاة الخرد الرود",22,"د",1,0],["رودة رخصة يعطفها اللين","انعطافا كما عطفت الجديلا",23,"ل",2,0],["رود لها جيد المهاة","ومقلة الظبي الغرير",24,"ر",1,0],["رودس للدرويش قالت أرخوا","فالنيران تقابلا في بحري",25,"ر",2,0],["رود إذا أسفرن في حلل الدجى","لبس الدجى حللا من الانوار",26,"ر",1,0],["رودٌ جَرى ماء الشَباب عَلى رُبى","وَجناتها يا حَبَذا مِن ماء",27,"ا",2,0],["رُود رداحٍ غَرثى وِشاح","وَالطَرفُ مِنها سَلِمتَ فاتِر",28,"ر",1,0],["رُودٌ كَسَتها يَدُ الأَيّام ثَوبَ صبا","وَصَيّرتها اللَيالي فِتنةَ البَشَرِ",29,"ر",1,0],["رُودٌ تُخَطِّرُ في بُردَي صِباً وَهَوىً","وَتَنثَني التِيهَ مِن سُكر الصِبا مَرَحا",30,"ح",2,0],["رُودٌ سَقاها الحُسنُ ماءَ شَبيبةٍ","فَغَدَت كَزَهرِ الرَوضِ غاداه الوَلي",31,"ل",2,0],["رود سلا اليوم عن أهوائها جلدي","في مدح بدر حدى من أشرف النسب",32,"ب",1,0],["رود ينم بمسراها إذا طرقت","من نشرها وجلا المسك والزجل",33,"ل",1,0],["رودريكو أيقن أن كثرة جيشهِ","لا بد قاهرةٌ لكل من قهرْ",34,"ر",1,0],["رودي اناديك ..أين انت ?وهي","هات تلبي رودي مناديها",35,"ي",3,0],["رودي عروس السماء قد وصلت","يتيه اشبينهابها.. تيها",35,"ي",3,0]]}