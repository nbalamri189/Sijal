{"poems":[[9,"ألا قل لتياك ما بالها","https://www.aldiwan.net/poem21973.html","المتقارب"],[68,"وكامل العارض قبلته","https://www.aldiwan.net/poem38458.html","السريع"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141961","الطويل"],[358,"للجد صورة هزل حليها الأدب","https://www.aldiwan.net/poem40569.html","البسيط"],[572,"وليلة فيها قصر","https://www.aldiwan.net/poem69645.html","مجزوء الرجز"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137632",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37932","السريع"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62450","السريع"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132308","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137302",""],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130039","الطويل"],[3550,"","https://poetry.dctabudhabi.ae/diwan/poem/206258",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216787","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95067","الطويل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135084","الرجز"],[5690,"أنى أعداد أوصافاً عرفت بها","https://www.poetsgate.com/ViewPoem.aspx?id=172179",""]],"verses":[["وَكامِلَةِ الرِجلِ وَالدارِعينَ","سَريعٍ إِلى القَومِ إيغالُها",0,"ل",3,0],["وكامل العارض قبلته","فصدني وازور عن قبلتي",1,"ي",1,1],["وكأمّه فتحت ذراعيها","ليهنأ بالمنام",2,"م",1,0],["وَكامِلاً هبه حَظّاً كامِلاً فيهِ","لَقَد تَكامل مِن أَفراحِنا الطَلَبُ",3,"ب",1,0],["وَكَامِنَاتٌ تُنْتَظَرْ","شَتٍّى النَّبَاتِ كَالْحِبَرْ",4,"ر",1,0],["وكاميل قال البخار تمدد","لما من حرارته يتوقد",5,"د",1,1],["وَكامِلٍ عَن مَدحِهِ قَد نَهى","مَنْ لَيسَ مِن عَذبِ المَديحِ اِرتَوى",6,"و",2,1],["وكامل في الحسن لا يغيب","والبدر فيه كلف يعيب",7,"ب",1,0],["وكامل الدنيا عزيز ولا","تخلو القرى من منقص منقبِ",8,"ب",1,0],["وَكَأمرِهِ الأعمَى بِنَقطِ مَصَاحِفٍ","أو شَكلِهَا حَذَراً مِنَ الألحَانِ",9,"ن",1,0],["وكامِلُ عشقي في الخُصُورِ يَزيدُهُ","تَرَنُّحُ بانٍ في حِقافِ الحقائبِ",10,"ب",1,0],["وكأمه وهي التي آلاؤها","لم تحصها الاقلام والارقام",11,"م",1,0],["وكامل لن يُنسى وإن طال عهدهُ","فما كان إلّا شعلةً تتوقّدُ",12,"د",1,0],["وكاملا رد كل نفس","همت عن الجسم بالبعاد",13,"د",1,0],["وكامنة بين النفوس بداهة","وما علمت في مهدها ما التكلم",14,"م",1,0],["وكامل وجهٍ جاءَ خط سرارهِ","بسرّ الصفا يُتلى بصفو السريرةِ",15,"ه",1,0],["وكامل في حسنه","شوقي اليه وافر",16,"ر",1,1],["وكامل صفةً لم تتفق علماً","إلاك يا كامل الأوصاف والشئمِ",17,"م",1,0]]}