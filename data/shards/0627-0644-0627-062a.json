www.aldiwan.net/poem22425.html","الطويل"],[46,"كأنما الأرض شاع فيها","https://www.aldiwan.net/poem22554.html","مجزوء البسيط"],[46,"دنياك دارشرور لا سرور بها","https://www.aldiwan.net/poem22794.html","البسيط"],[46,"إنا معاشر هذا الخلق في سفه","https://www.aldiwan.net/poem22978.html","البسيط"],[46,"ألا يا جون ماوفقت","https://www.aldiwan.net/poem23109.html","الهزج"],[46,"أواني هم فألقى أواني","https://www.aldiwan.net/poem23545.html","المتقارب"],[46,"أكرم بياضك عن خطر يسوده","https://www.aldiwan.net/poem23590.html","البسيط"],[19,"إذا ناقة شدت برحل ونمرقٍ","https://www.aldiwan.net/poem359.html",""],[19,"فإن يأتكم مني هجاء فإنما","https://www.aldiwan.net/poem364.html",""],[15,"أمن منزل عاف ومن رسم أطلال","https://www.aldiwan.net/poem45252.html","الطويل"],[76,"أرقت وقلبي عنك ليس يفيق","https://www.aldiwan.net/poem39255.html","الطويل"],[76,"هو الفتح منظوما على إثره الفتح","https://www.aldiwan.net/poem39462.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85585","البسيط"],[5,"","https://poetry.dctabudhabi.ae/diwan/poem/6827","الوافر"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16635","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21005","الوافر"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20982","الوافر"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67347","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142022","الهزج"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12466","الهزج"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43892","البسيط"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/117017","البسيط"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23638","الطويل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10257","الوافر"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/142074","البسيط"],[45,"بين الشقيقة فاللوى فالأجرع","https://www.poetsgate.com/ViewPoem.aspx?id=2816",""],[46,"ألا تتّقُونَ اللَّهَ رَهطَ مسلِّمٍ!","https://www.poetsgate.com/ViewPoem.aspx?id=18112",""],[38,"صَدَقَتْ مُعَيَّة َ نَفْسُهُ فَتَرَحَّلاَ","https://www.poetsgate.com/ViewPoem.aspx?id=21224",""],[44,"ألاَ تَرَى ما أصدَقَ الأنواءَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15643&r=&rc=3",""],[18,"أَعَينَيَّ جودا بِالدُموعِ السَوافِحُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69557&r=&rc=44",""],[23,"إن تمسِ دارُ ابنِ أروى منه خالية ً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=12801&r=&rc=5",""]],"verses":[["أَلا تَعجَبونَ لِذي سوءَةٍ","تَحَكُّكَ في عِرضِهِ الأَجرَبُ",0,"ب",1,0],["ألا ترى يا »أبا تمام« بارقنا","(إن السماء ترجى حين تحتجب)",1,"ب",1,0],["أَلا تَعجَبونَ لِفَوزِ المُني","تَميلُ وَتُصغي إِلى الكاشِحينا",2,"ن",2,0],["أَلا تَرحَمينَ فَتىً مُغرَماً","بِحُبِّكِ يَسقي الدُموعَ التُرابا",3,"ب",2,0],["أَلا تَعجَبونَ كَما أَعجَبُ","حَبيبٌ يُسيءُ وَلا يُعتِبُ",4,"ب",1,1],["أَلا تِلكَ لُبنى قَد تَراخى مَزارُها","وَلِلبَينِ غَمٌّ ما يَزالُ يُنازِعُ",5,"ع",1,0],["أَلا تِلكَ عِرسي أُمُّ سَكنٍ تَنَكَّرَت","خَلائِقُها لي والخُطوبُ تَقَلَّبُ",6,"ب",1,1],["أَلا تَقنى حَياءَكَ أَو تَناهى","بُكاءَكَ مِثلَ ما يَبكي الوَليدُ",7,"د",1,0],["أَلا تُغني كِنانَةُ عَن أَخيه","زُهَيرٍ في المُلِمّاتِ الكِبارِ",8,"ر",1,0],["أَلا تَتَّقينَ اللَهَ في حُبِّ عاشِقٍ","لَهُ كَبِدٌ حَرّى عَلَيكِ تَصَدَّعُ",9,"ع",1,0],["أَلا تِلكَ عَزَّةُ قَد أَصبَحَت","تُقَلِّبُ لِلهَجرِ طَرفاً غَضيضا",10,"ض",2,1],["أَلا تَبكِيانِ الجَريءَ الجَميلَ","أَلا تَبكِيانِ الفَتى السَيِّدا",11,"د",2,0],["أَلا تَرَى الهَامَ خَاشِعَاتٍ","حِيَالَهُ وَالعُلَى جُثِيَّا",12,"ي",2,0],["ألاَ تِلكَ الحوادثُ غِبتُ عَنها","بأَرضِ الشَّامِ كَالفَردِ الغَريقِ",13,"ق",1,0],["إِلاَّ تَرَسُّخُ عِلبا دُونَهُ رَهَبٌ","مِن عِرمِضٍ فَأَبَاءٍ فَهيَ مُنتَقَعُ",14,"ع",1,0],["ألا تنظرون الغرب كيف تسابقت","به الصحف في طرق العلا والمحامد",15,"د",1,0],["أَلا تَجزينَني وَهُمومُ نَفسي","بِذِكرِكِ قَد أُطيلُ لَها اِكتِئابا",16,"ب",2,0],["أَلا تَذكُرُ الأَزمانَ إِذ تَتبَعُ الصِبا","وَإِذ أَنتَ صَبٌّ وَالهَوى بِكَ جامِحُ",17,"ح",1,0],["أَلا تَزجُرينَ القائِلينَ لِيَ الخَنا","كَما أَنا مَعنِيٌّ وَراءَكِ مُنفِحُ",18,"ح",1,0],["أَلا تَرى العَينَ يَومَ البَينِ إِذ ذَرَفَت","هاجَت عَلَيكَ ذَوي ضِغنٍ وَأَحقادِ",19,"د",1,0],["أَلا تَذكُرونَ الرِحمَ أَو تُقرِضونَني","لَكُم خُلُقاً مِن واسِعِ الخُلقِ ماجِدِ",20,"د",1,0],["أَلا تَسأَلانِ الجَوَّ جَوَّ مُتالِعٍ","أَما بَرِحَت بَعدي يَجودَةُ وَالقَصرُ",21,"ر",1,0],["أَلا تَعرِفونَ النافِشينَ لِحاهُمُ","إِذا بَطِنوا وَالفاخِرينَ بِلا فَخرِ",22,"ر",1,0],["أَلا تَصحو وَتُقصِرُ عَن صِباكا","وَهاذا الشَيبُ أَصبَحَ قَد عَلاكا",23,"ك",2,1],["أَلا تَجزينَ وُدّي في لَيالٍ","وَأَيّامٍ وَصَلتُ بِهِ طِوالا",24,"ل",2,0],["إِلّا تَكُن لَكَ بِالدَيرَينِ باكِيَةٌ","فَرُبَّ باكِيَةٍ بِالرَملِ مِعوالِ",25,"ل",1,0],["أَلا تَسأَلونَ المُردَفاتِ عَشِيَّةً","مَعَ القَومِ لا يَخبَأنَ ساقاً لِمُجتَلي",26,"ل",2,0],["أَلا تَبتَغي حِلماً فَتَنهى عَنِ الجَهلِ","وَتَصرِمُ جُملاً راحَةً لَكَ مِن جُملِ",27,"ل",1,0],["أَلا تَسأَلونَ الناسَ مَن يُنهِلُ القَنا","وَمَن يَمنَعُ الثَغرَ المَخوفَ تَلاتِلُه",28,"ل",2,0],["أَلا تَسأَلانِ المَرءَ ماذا يُحاوِلُ","أَنَحبٌ فَيُقضى أَم ضَلالٌ وَباطِلُ",29,"ل",1,1],["إِلّا تُنيبوا لِأَمرِ اللَهِ تَعتَرفوا","كَتائِباً عُصَباً مِن خَلفِها عُصَبُ",30,"ب",1,0],["أَلا تَرَونَ بِأَنّي قَد ظُلِمتُ إِذا","كانَ الزِبَعرى لِنَعلي ثابِتٍ خَطَرا",31,"ر",2,0],["ألا تلكُمُ النُّعْمَى التي ليس شكرُها","سوى مِنَنٍ أضحت لكم تُتَقَلَّدُ",32,"د",1,0],["ألاَ تلْكُمُ النفْسُ التي تَمَّ فضْلُها","فما نَستَزِيدُ اللّه غيْرَ خُلُودها",33,"د",3,0],["ألا ترجُف الدنيا وتهوِي جبالُها","وتخبو مصابيحُ السماء إلى الحشر",34,"ر",1,0],["ألا تَعِسَ الدهرُ المُفرِّق بيننا","وإن كان كلٌّ عاثراً بعِثاره",35,"ر",2,0],["ألا تلكم الغيد العطابيل أصبحت","إلى غيركم أرشاقها وتلوعها",36,"ع",3,0],["ألا تلك آساد الشرى وبروزها","فدتها خنازير القرى وقُبوعها",36,"ع",3,0],["إِلّا تَكُن ظُعُناً تُبنى هَوادِجُها","فَإِنَّهُنَّ حِسانُ الزِيِّ أَجلاحُ",37,"ح",1,0],["أَلا تَنهى بَنو عِجلٍ جَريراً","كَما لا يَنتَهي عَنّا هِلالُ",38,"ل",1,1],["أَلا تُؤمِنونَ بِقَولِ الكِتابِ","فَوَيلٌ لَكُم إِنَّكُم كافِرون",39,"ن",1,0],["إِلّا تَجاوُبَهُنَّ حَولَ سَوادِهِ","بِحَناجِرٍ نُحٍّ وَصَوتٍ أَهدَلا",40,"ل",2,0],["أَلا تَتَّقينَ اللَهَ فيمَن قَتَلتِهِ","فَأَمسى إِلَيكُم خاشِعاً يَتَضَرَّعُ",41,"ع",1,0],["أَلا تَتَّقينَ اللَهَ في قَتلِ عاشِقٍ","لَهُ كَبِدٌ حَرّى عَلَيكِ تَقَطَّعُ",41,"ع",1,0],["إِلّا تكفّوا عن عِنادي أجْنِهَا","شعواءَ ينعَرُ من جوانِبها الدَمُ",42,"م",1,0],["إِلّا تكنْ بالتاجِ مُعْتَجِراً","فعُلاكَ أوفَى منه في حَدْسِي",43,"ي",1,0],["إِلّا تَكُن مَلِكاً تُثنى تَحِيَّتُهُ","فَإِنَّكَ اِبنُ مُلوكٍ سادَةٍ نُجُبِ",44,"ب",1,0],["أَلا تَعجَبونَ كَما أَعجَبُ","حَبيبي يُسيءُ وَلا يُعتِبُ",45,"ب",1,1],["إِلّا تَنَلهُ العَوالي وَهوَ مُنجَذِبٌ","فَقَد كَوَت صَلَوَيهِ كَيَّ إِنضاجِ",46,"ج",1,0],["أَلا تَرَيانِ الرَبعَ راجَعَ أُنسَهُ","وَعادَت إِلى العَهدِ القَديمِ مَعاهِدُه",47,"د",2,0],["إِلّا تَكُنهُ عَلى حَقيقَتِهِ يَغِب","عَمرٌو وَيَشهَد عاصِمُ بنُ الأَسقَعِ",48,"ع",1,0],["أَلا تَرى الناسَ ما سَكَّنتَهُم سَكَنوا","وَإِن غَضِبتَ أَزالَ الإِمَّةَ الغَضَبُ",49,"ب",1,0],["أَلا تَذكِرونَ الرِحمَ أَو تُقرِضونَني","لَكُم خُلُقاً مِن واسِعِ الحِلمِ ماجِدِ",50,"د",1,0],["أَلا تَرى لَهُمُ في مُلكِهِم عَلَماً","وَلا تَرى عَلَماً إِلّا لَهُ سَنَدُ",51,"د",1,0],["أَلا تَسأَلونَ الناسَ عَنّا وَعَنَّكُم","إِذا عُظِّمَت عِندَ الأُمورِ الصَنائِعُ",52,"ع",1,0],["أَلا تَشكُرونَ اللَهَ إِذ فَكَّ عَنكُمُ","أَداهِمَ بِالمَهدِيِّ صُمّاً ثِقالُها",53,"ل",3,0],["أَلا تَدَّعي إِن كانَ قَومُكَ لَم تَجِد","كَريماً لَهُم إِلّا لَئيماً أَوائِلُه",54,"ل",2,0],["أَلا تَفتَري إِذ لَم تَجِد لَكَ مَفخَراً","أَلا رُبَّما يَجري مَعَ الحَقِّ باطِلُه",55,"ل",2,1],["أَلا تَرى القَومَ مِمّا في صُدورِهِمُ","كَأَنَّ أَوجُهَهُم تُطلى بِتَنّومِ",56,"م",1,0],["أَلا تَبكي بَنو سَعدٍ فَتاها","لِأَيّامِ السَماحَةِ وَالطِعانِ",57,"ن",1,0],["ألا تراني ببحر الحب غارقة","والموج يمضغ آمالي ويرميها",58,"ي",3,0],["أَلا تَرَونَ أَقَلَّ اللَهُ خَيرَكُمُ","أَنَّا غَضِبنا لِعُثمانَ بنَ مَظعونِ",59,"ن",1,0],["أَلا تَسأَلُ اللَهَ مِن فَضلِهِ","فَإِنَّ عَطاياهُ لا تَنفَدُ",60,"د",1,0],["أَلا تَأتي القُبورَ صَباحَ يَومٍ","فَتَسمَعَ ما تُخَبِّرُكَ القُبورُ",61,"ر",1,0],["ألا ترى في كل هذا الجلال","غير نذيرٍ طالعٍ بالفناء",62,"ا",2,0],["أَلا تَرى ما أَصدَقَ الأَنواءَ","قَد أَفنَتِ الحَجرَةَ وَاللَأواءَ",63,"ا",2,1],["أَلا تَرى كَيفَ يُبلينا الجَديدانِ","وَكَيفَ نَلعَبُ في سِرٍّ وَإِعلانِ",64,"ن",1,1],["إِلّا تَكُن صَدَرَت عَن مَنظَرٍ حَسَنٍ","حَربٌ فَقَد صَدَرَت عَن مَسمَعٍ حَسَنِ",65,"ن",1,0],["إِلّا تَكُن أَرواحُها لَكَ سُخِّرَت","فَالعَزمُ طَوعُ يَدَيكَ وَالإِجذامُ",66,"م",1,0],["إِلّا تَكُن حُصِرَت فَقَد أَضحى لَها","مِن خَوفِ قارِعَةِ الحِصارِ حِصارُ",67,"ر",1,0],["إِلّا تَنَل مَنويلَ أَطرافُ القَنا","أَو تُثنَ عَنهُ البيضُ وَهيَ حِرارُ",67,"ر",1,0],["إِلّا تَفِرَّ فَقَد أَقَمتَ وَقَد رَأَت","عَيناكَ قِدرَ الحَربِ كَيفَ تُفارُ",67,"ر",1,0],["ألا تتعطفينَ وأنتِ غصنٌ","ألا تتلفتينَ وأنتِ ظَبْيُ",68,"ي",1,0],["ألا تنظرونَ إلينا فمذْ","نظرتمْ بنا ما نظرتُمْ إلينا",69,"ن",2,0],["أَلا تَجزي عُثَيمَةُ وُدَّ صَبٍّ","بِذِكرِكِ لا يَنامُ وَلا يُنيمُ",70,"م",1,1],["أَلا تَراني مُخامِراً سَقَماً","كَحَّلَ عَيني بِمَأقِها السَهَدا",71,"د",2,0],["إِلّا تَكاليفَ الشَقاءِ بِمَن","لَم تُمسِ مِنّا دارُهُ صَدَدا",72,"د",2,0],["أَلا تِلكَ لَيلى قَد أَلَمَّ لِمامُها","وَكَيفَ مَعَ القَومِ الأَعادي كَلامُها",73,"م",3,1],["ألاَ تقومُ بدار المُلكِ جمهرةٌ","تحمي البناءَ وترعى الأمرَ والشَّانا",74,"ن",2,0],["أَلا تَخافونَ رَبّاً لا يَخافُ لَكُم","بَأساً إِذا اِنطَلَقَت أَقدارُهُ تَثِبُ",75,"ب",1,0],["أَلا تَرى النحلة مَهما حَلا","زهر الرُبى لَم تَنس مَأواها",76,"ا",3,0],["أَلا تِلكُما عِرسي مَنيعَةُ ضُمِّنَت","مِنَ اللَهِ إِثماً مُستَسِرّاً وَعالِنا",77,"ن",2,1],["أَلا تَسأَلونَ اللَهَ بُرءَ مُتَيَّمٍ","تَمَكَّنَ مِنهُ السَقمُ في اللَحمِ وَالدَمِ",78,"م",1,1],["أَلا تَسلو فَتَقصُرَ عَن هَواكا","أَلا وَمَشيبُ رَأسِكَ خانَ ذاكا",79,"ك",2,1],["أَلا تَرى بَهجَةَ الأَيّامِ قَد رَجِعَت","وَالناسَ في مَلِكٍ وَالدينِ قَد جُمِعا",80,"ع",2,0],["أَلا تَرَيانِ البَرقِ ما هُوَ صانِعُ","بِدَمعَةِ صَبٍّ شَفَّهُ النَأيُ وَالشَحطُ",81,"ط",1,1],["أَلا تَرى يا صاحِ ما حَلَّ بي","مِن ظالِمٍ في حُكمِهِ مُعتَدِ",82,"د",1,1],["إلاّ تَبَيَّنْتَ سِيما الغَدْرِ بَيّنَةً","عليه والكفرِ للنَّعْماء والغِيَل",83,"ل",1,0],["ألا تَخِرُّ لهُ الأيّامُ ساجِدَةً","إذْ نالَ مَكرُمَةً أعيَتْ فلم تُنَل",83,"ل",1,0],["ألا تِلكمُ الأرضُ العريضةُ أصحبتْ","وما لبني العبّاس في عرضِها فِتر",84,"ر",1,0],["أَلا تَرى ما أُعطِيَ الأَمينُ","أُعطِيَ ما لَم تَرَهُ العُيونُ",85,"ن",1,1],["إِلّا تَثاقُلَ عاشِقٍ أَو قُربَهُ","بِالحُبِّ لَيسَ لَهُ عَليكِ نُذورُ",86,"ر",1,0],["إِلّا تَغَوُّلَ أَمثالٍ تَكُن مَثَلاً","لِكُلِّ مُستَمِعٍ مِنكُم وَنَظّارِ",87,"ر",1,0],["أَلا تَجزينَني بِالشَوقِ شَوقاً","هَداكِ إِلى الجَزاءِ بِذاكَ هادِ",88,"د",1,0],["أَلا تَحَرَّجتِ مِمّا قَد رُميتِ بِهِ","وَسَطَ النِساءِ لِمَن أَفنى وَقَد رَقَدا",89,"د",2,0],["إِلّا تَكُن قَمَرَ السَماءِ فَإِنَّها","مِثلُ المَريعَةِ تُعجِبُ الرُوّادا",90,"د",2,0],["أَلا تَراكِ بِنا مُتَيَّمَةً","فَأَجابَ دَعوَةَ عاشِقٍ رَبّي",91,"ب",2,0],["أَلا تَرزُقُني مِنكَ","سُلُوَّ القَلبِ أَو قُربا",92,"ب",2,0],["أَلا تَتَّقينَ اللَهَ في قَتلِ عاشِقٍ","لَهُ حينَ يُمسي زَفرَةٌ وَنَحيبُ",93,"ب",1,0],["أَلا تَفرَقُ الأَحياءُ مِمّا بَدا لَها","وَقَد عَمَّها بِالفَجرِ أَزرَقُ مُغرَبُ",94,"ب",1,0],["أَلا تَتَّفقونَ اللَهَ رَهطَ مُسَلِّمٍ","فَقَد جُرتُمُ في طاعَةِ الشَهَواتِ",95,"ت",1,1],["أُلاتُ الظَلمِ جِئنَ بِشَرِّ ظُلمٍ","وَقَد واجَهنَنا مُتَظَلِّماتِ",96,"ت",1,0],["أَلا تَرحَمُ الأَشياخَ لَمّا تَأَوَّدوا","يَقولونَ قَد كُنّا الغَرانِقَةَ المُردا",97,"د",2,1],["أَلا تَرى أَنَّ أُمَّ دَفرٍ","كَأَنَّها آلُها السَخورُ",98,"ر",1,0],["أَلا تَرى هَرَمَي مِصرٍ وَإِن شَمَخا","كِلاهُما بِيَقينٍ سَوفَ يَندَرِسُ",99,"س",1,0],["أَلا تَرى جَمعَ ما لا عَقلَ يُسنِدُهُ","جَمعَ المُؤَنَّثِ فيهِ التاءُ وَالأَلِفُ",100,"ف",1,0],["أَلا تَنهَضُ لِلحَربِ","وَتَدعو لِلوَغى شُوسَك",101,"ك",1,0],["أَلا تَسمَعُ الآنَ صَوتَيهِما","بِكُلِّ اِمرِئٍ فيهِما يَحدُوانِ",102,"ن",1,0],["أَلا تَفَكَّرتَ قَبلَ النَسلِ في زَمَنٍ","بِهِ حَلَلتَ فَتَدري أَينَ تُلقيهِ",103,"ق",3,0],["أَلا تَقبَلُ المَعروفَ مِنّا تَعاوَرَت","مَنولَةُ أَسيافاً عَلَيكَ ظِلالُها",104,"ل",3,0],["أَلا تَتَّقونَ اللَهَ إِذ تَعلِفونَها","رَضيخَ النَوى وَالعُضِّ حَولاً مُجَرَّما",105,"م",2,0],["أَلا تَقِفانِ اليَومَ قَبلَ تَفَرُّقٍ","وَنَأيٍ بَعيدٍ وَاِختِلافٍ وَأَشغالِ",106,"ل",1,0],["ألا تَشكرونَ اللَّهَ إذْ قامَ فيكمُ","إمامُ هُدىً في المكرُماتِ عريقُ",107,"ق",1,0],["ألا تَعِستْ تلكَ الوجوهُ وقُبِّحتْ","فما خُلقا إلّا لها التَّعسُ والقُبحُ",108,"ح",1,0],["إلا تجدد فيها مثله وطر","قد كنت أَقدر أَن أَسعى على قدمي",109,"ي",1,0],["أَلا تُغني كِنانَةُ عَن أَخيها","زُهَيرٍ في المُلِمّاتِ الكِبارِ",110,"ر",1,0],["ألا تسْمَعُ التسْليمَ حين أكُرّهُ","وقد خابَ ظَنّي لستَ منّي بمَسْمَع",111,"ع",1,0],["الا تِلك الغنيمة لا إفال","ترجيها مسومة ونِيب",112,"ب",1,0],["أَلاَ تِلكَ الثَّعالبُ قد تَوالَت","عَلَّي وحالفَت عُرجاً ضِباعا",113,"ع",2,0],["ألاّ تُوَلُوا مَا تَغُوَّرَ رَاكِبٌ","أَخْزَى المَنُونَ مُوَالِياً إِخوانَا",114,"ن",2,0],["ألا تبقي على شيء","فمن يحيا بلا أكل",115,"ل",1,0],["أَلا تَفتَحُ لي فَوزٌ","مِنَ الرَحمَةِ أَبوابا",116,"ب",2,1],["إِلّا تَكُن فِي رُباهَا روضةٌ أُنُفٌ","فإِنَّما أوجهُ الأحباب روْضَاتُ",117,"ت",1,0],["ألا ترى كلّ من ترجو وتأمَلهُ","من البرِيَّةِ مسكينُ بن مسكين",118,"ن",1,0],["ألا تِلكُمُ الدار التي حل أهلها","بناءٍ عن الخطب المخوف شَطير",119,"ر",1,0],["أَلا تَقِفُ الدُموعَ عَلى حُسَينٍ","وَذِكرى مَصرَعِ الحَبرِ التَقِيِّ",120,"ي",1,0],["الا تزال بخير دار فاطمة","فالنهد مستنفر والكحل صبّاح",121,"ح",1,0],["إلاّ تَكُنهُ على حِقيقَتِهِ يَغِبْ","عَمروٌ، وَيشهَدْ عاصِمُ بنُ الأسفَعِ",122,"ع",1,0],["ألا تتّقُونَ اللَّهَ رَهطَ مسلِّمٍ!","فقد جُرتمُ في طاعةِ الشّهواتِ",123,"ت",1,1],["إِلاَّ تَجَاوَبَهُنَّ حَوْلَ سَوَادِهِ","بحناجرٍ نحٍّ وشدقٍ أهدلا",124,"ل",2,0],["ألاَ تَرَى ما أصدَقَ الأنواءَ","قَدْ أفنَتِ الحَجْرَة واللَّلأوَاءَ؟",125,"ا",2,1],["أَلا تَبكِيانِ المُرتَجى عِندَ مَشهَدٍ","يُثيرُ مَعَ الفُرسانِ نَقعَ الأَباطِحِ",126,"ح",1,0],["إلا تنيبوا لأمرِ اللهِ تعترفوا","بغارة ٍ عصبٍ منْ خلفها عصبُ",127,"ب",1,0]]}