html","الكامل"],[420,"باكر نداماك بكأس العقار","https://www.aldiwan.net/poem53938.html","السريع"],[420,"ورد السرور وطاف بحانها","https://www.aldiwan.net/poem54038.html","الكامل"],[420,"يا ليلة في آخر الشهر","https://www.aldiwan.net/poem54175.html","أحذ الكامل"],[445,"دعاها كيفما صنعت دعاها","https://www.aldiwan.net/poem14432.html","السريع"],[456,"ألا تعود سؤال رن في أذني","https://www.aldiwan.net/poem61599.html","البسيط"],[461,"إذا رفعت من شراف الخدور","https://www.aldiwan.net/poem56193.html","المتقارب"],[471,"لما أتى النيل لنا من لجه","https://www.aldiwan.net/poem60328.html","الرجز"],[473,"يا بيت عاتكة الذي أتعزل","https://www.aldiwan.net/poem4779.html","الكامل"],[474,"ألا يا لقوم للجديد المصرم","https://www.aldiwan.net/poem753.html",""],[480,"أهدت الي شذا العرار الفائح","https://www.aldiwan.net/poem15194.html","الكامل"],[482,"من للثكالى وللجرحى وأيتام","https://www.aldiwan.net/poem37205.html","البسيط"],[486,"ألا ترين وقد قطعتني قطعاً","https://www.aldiwan.net/poem2069.html","البسيط"],[498,"يقولون لي لا تحب الوصي","https://www.aldiwan.net/poem9767.html","المتقارب"],[503,"تثبت ولا تغضب إذا راح كاذب","https://www.aldiwan.net/poem37559.html","الطويل"],[508,"الراحل","https://www.aldiwan.net/poem61092.html","الطويل"],[516,"ما لي ألفت وجها غير ملتفت","https://www.aldiwan.net/poem67717.html","البسيط"],[516,"ألا تكن في الهوى أرويت من ظماء","https://www.aldiwan.net/poem67749.html","البسيط"],[519,"ألا تسأل الخيمات من بطن أرثد","https://www.aldiwan.net/poem48610.html","الطويل"],[543,"يا من يعين على ضيف ألم بنا","https://www.aldiwan.net/poem56641.html","البسيط"],[543,"يا أثل لا غيرا أعطى ولا قودا","https://www.aldiwan.net/poem56658.html","البسيط"],[561,"مقام بني الصديق ذروة فرقد","https://www.aldiwan.net/poem34602.html","الطويل"],[694,"","https://poetry.dctabudhabi.ae/diwan/poem/31375","البسيط"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/28059","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/31366","الطويل"],[856,"","https://poetry.dctabudhabi.ae/diwan/poem/18051","الطويل"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/12036","البسيط"],[955,"","https://poetry.dctabudhabi.ae/diwan/poem/200317","الطويل"],[964,"","https://poetry.dctabudhabi.ae/diwan/poem/97808","الطويل"],[1044,"","https://poetry.dctabudhabi.ae/diwan/poem/27104","البسيط"],[1062,"","https://poetry.dctabudhabi.ae/diwan/poem/21423","الرجز"],[1062,"","https://poetry.dctabudhabi.ae/diwan/poem/21416","الرجز"],[1112,"","https://poetry.dctabudhabi.ae/diwan/poem/28240","الوافر"],[1166,"","https://poetry.dctabudhabi.ae/diwan/poem/83110","الطويل"]],"verses":[["أَلا تَعجَبونَ لِذي سوءَةٍ","تَحَكُّكَ في عِرضِهِ الأَجرَبُ",0,"ب",1,0],["ألا ترى يا »أبا تمام« بارقنا","(إن السماء ترجى حين تحتجب)",1,"ب",1,0],["أَلا تَعجَبونَ لِفَوزِ المُني","تَميلُ وَتُصغي إِلى الكاشِحينا",2,"ن",2,0],["أَلا تَرحَمينَ فَتىً مُغرَماً","بِحُبِّكِ يَسقي الدُموعَ التُرابا",3,"ب",2,0],["أَلا تَعجَبونَ كَما أَعجَبُ","حَبيبٌ يُسيءُ وَلا يُعتِبُ",4,"ب",1,1],["أَلا تِلكَ لُبنى قَد تَراخى مَزارُها","وَلِلبَينِ غَمٌّ ما يَزالُ يُنازِعُ",5,"ع",1,0],["أَلا تِلكَ عِرسي أُمُّ سَكنٍ تَنَكَّرَت","خَلائِقُها لي والخُطوبُ تَقَلَّبُ",6,"ب",1,1],["أَلا تَقنى حَياءَكَ أَو تَناهى","بُكاءَكَ مِثلَ ما يَبكي الوَليدُ",7,"د",1,0],["أَلا تُغني كِنانَةُ عَن أَخيه","زُهَيرٍ في المُلِمّاتِ الكِبارِ",8,"ر",1,0],["أَلا تَتَّقينَ اللَهَ في حُبِّ عاشِقٍ","لَهُ كَبِدٌ حَرّى عَلَيكِ تَصَدَّعُ",9,"ع",1,0],["أَلا تِلكَ عَزَّةُ قَد أَصبَحَت","تُقَلِّبُ لِلهَجرِ طَرفاً غَضيضا",10,"ض",2,1],["أَلا تَبكِيانِ الجَريءَ الجَميلَ","أَلا تَبكِيانِ الفَتى السَيِّدا",11,"د",2,0],["أَلا تَرَى الهَامَ خَاشِعَاتٍ","حِيَالَهُ وَالعُلَى جُثِيَّا",12,"ي",2,0],["ألاَ تِلكَ الحوادثُ غِبتُ عَنها","بأَرضِ الشَّامِ كَالفَردِ الغَريقِ",13,"ق",1,0],["إِلاَّ تَرَسُّخُ عِلبا دُونَهُ رَهَبٌ","مِن عِرمِضٍ فَأَبَاءٍ فَهيَ مُنتَقَعُ",14,"ع",1,0],["ألا تنظرون الغرب كيف تسابقت","به الصحف في طرق العلا والمحامد",15,"د",1,0],["أَلا تَجزينَني وَهُمومُ نَفسي","بِذِكرِكِ قَد أُطيلُ لَها اِكتِئابا",16,"ب",2,0],["أَلا تَذكُرُ الأَزمانَ إِذ تَتبَعُ الصِبا","وَإِذ أَنتَ صَبٌّ وَالهَوى بِكَ جامِحُ",17,"ح",1,0],["أَلا تَزجُرينَ القائِلينَ لِيَ الخَنا","كَما أَنا مَعنِيٌّ وَراءَكِ مُنفِحُ",18,"ح",1,0],["أَلا تَرى العَينَ يَومَ البَينِ إِذ ذَرَفَت","هاجَت عَلَيكَ ذَوي ضِغنٍ وَأَحقادِ",19,"د",1,0],["أَلا تَذكُرونَ الرِحمَ أَو تُقرِضونَني","لَكُم خُلُقاً مِن واسِعِ الخُلقِ ماجِدِ",20,"د",1,0],["أَلا تَسأَلانِ الجَوَّ جَوَّ مُتالِعٍ","أَما بَرِحَت بَعدي يَجودَةُ وَالقَصرُ",21,"ر",1,0],["أَلا تَعرِفونَ النافِشينَ لِحاهُمُ","إِذا بَطِنوا وَالفاخِرينَ بِلا فَخرِ",22,"ر",1,0],["أَلا تَصحو وَتُقصِرُ عَن صِباكا","وَهاذا الشَيبُ أَصبَحَ قَد عَلاكا",23,"ك",2,1],["أَلا تَجزينَ وُدّي في لَيالٍ","وَأَيّامٍ وَصَلتُ بِهِ طِوالا",24,"ل",2,0],["إِلّا تَكُن لَكَ بِالدَيرَينِ باكِيَةٌ","فَرُبَّ باكِيَةٍ بِالرَملِ مِعوالِ",25,"ل",1,0],["أَلا تَسأَلونَ المُردَفاتِ عَشِيَّةً","مَعَ القَومِ لا يَخبَأنَ ساقاً لِمُجتَلي",26,"ل",2,0],["أَلا تَبتَغي حِلماً فَتَنهى عَنِ الجَهلِ","وَتَصرِمُ جُملاً راحَةً لَكَ مِن جُملِ",27,"ل",1,0],["أَلا تَسأَلونَ الناسَ مَن يُنهِلُ القَنا","وَمَن يَمنَعُ الثَغرَ المَخوفَ تَلاتِلُه",28,"ل",2,0],["أَلا تَسأَلانِ المَرءَ ماذا يُحاوِلُ","أَنَحبٌ فَيُقضى أَم ضَلالٌ وَباطِلُ",29,"ل",1,1],["إِلّا تُنيبوا لِأَمرِ اللَهِ تَعتَرفوا","كَتائِباً عُصَباً مِن خَلفِها عُصَبُ",30,"ب",1,0],["أَلا تَرَونَ بِأَنّي قَد ظُلِمتُ إِذا","كانَ الزِبَعرى لِنَعلي ثابِتٍ خَطَرا",31,"ر",2,0],["ألا تلكُمُ النُّعْمَى التي ليس شكرُها","سوى مِنَنٍ أضحت لكم تُتَقَلَّدُ",32,"د",1,0],["ألاَ تلْكُمُ النفْسُ التي تَمَّ فضْلُها","فما نَستَزِيدُ اللّه غيْرَ خُلُودها",33,"د",3,0],["ألا ترجُف الدنيا وتهوِي جبالُها","وتخبو مصابيحُ السماء إلى الحشر",34,"ر",1,0],["ألا تَعِسَ الدهرُ المُفرِّق بيننا","وإن كان كلٌّ عاثراً بعِثاره",35,"ر",2,0],["ألا تلكم الغيد العطابيل أصبحت","إلى غيركم أرشاقها وتلوعها",36,"ع",3,0],["ألا تلك آساد الشرى وبروزها","فدتها خنازير القرى وقُبوعها",36,"ع",3,0],["إِلّا تَكُن ظُعُناً تُبنى هَوادِجُها","فَإِنَّهُنَّ حِسانُ الزِيِّ أَجلاحُ",37,"ح",1,0],["أَلا تَنهى بَنو عِجلٍ جَريراً","كَما لا يَنتَهي عَنّا هِلالُ",38,"ل",1,1],["أَلا تُؤمِنونَ بِقَولِ الكِتابِ","فَوَيلٌ لَكُم إِنَّكُم كافِرون",39,"ن",1,0],["إِلّا تَجاوُبَهُنَّ حَولَ سَوادِهِ","بِحَناجِرٍ نُحٍّ وَصَوتٍ أَهدَلا",40,"ل",2,0],["أَلا تَتَّقينَ اللَهَ فيمَن قَتَلتِهِ","فَأَمسى إِلَيكُم خاشِعاً يَتَضَرَّعُ",41,"ع",1,0],["أَلا تَتَّقينَ اللَهَ في قَتلِ عاشِقٍ","لَهُ كَبِدٌ حَرّى عَلَيكِ تَقَطَّعُ",41,"ع",1,0],["إِلّا تكفّوا عن عِنادي أجْنِهَا","شعواءَ ينعَرُ من جوانِبها الدَمُ",42,"م",1,0],["إِلّا تكنْ بالتاجِ مُعْتَجِراً","فعُلاكَ أوفَى منه في حَدْسِي",43,"س",2,0],["إِلّا تَكُن مَلِكاً تُثنى تَحِيَّتُهُ","فَإِنَّكَ اِبنُ مُلوكٍ سادَةٍ نُجُبِ",44,"ب",1,0],["أَلا تَعجَبونَ كَما أَعجَبُ","حَبيبي يُسيءُ وَلا يُعتِبُ",45,"ب",1,1],["إِلّا تَنَلهُ العَوالي وَهوَ مُنجَذِبٌ","فَقَد كَوَت صَلَوَيهِ كَيَّ إِنضاجِ",46,"ج",1,0],["أَلا تَرَيانِ الرَبعَ راجَعَ أُنسَهُ","وَعادَت إِلى العَهدِ القَديمِ مَعاهِدُه",47,"د",2,0],["إِلّا تَكُنهُ عَلى حَقيقَتِهِ يَغِب","عَمرٌو وَيَشهَد عاصِمُ بنُ الأَسقَعِ",48,"ع",1,0],["أَلا تَرى الناسَ ما سَكَّنتَهُم سَكَنوا","وَإِن غَضِبتَ أَزالَ الإِمَّةَ الغَضَبُ",49,"ب",1,0],["أَلا تَذكِرونَ الرِحمَ أَو تُقرِضونَني","لَكُم خُلُقاً مِن واسِعِ الحِلمِ ماجِدِ",50,"د",1,0],["أَلا تَرى لَهُمُ في مُلكِهِم عَلَماً","وَلا تَرى عَلَماً إِلّا لَهُ سَنَدُ",51,"د",1,0],["أَلا تَسأَلونَ الناسَ عَنّا وَعَنَّكُم","إِذا عُظِّمَت عِندَ الأُمورِ الصَنائِعُ",52,"ع",1,0],["أَلا تَشكُرونَ اللَهَ إِذ فَكَّ عَنكُمُ","أَداهِمَ بِالمَهدِيِّ صُمّاً ثِقالُها",53,"ل",3,0],["أَلا تَدَّعي إِن كانَ قَومُكَ لَم تَجِد","كَريماً لَهُم إِلّا لَئيماً أَوائِلُه",54,"ل",2,0],["أَلا تَفتَري إِذ لَم تَجِد لَكَ مَفخَراً","أَلا رُبَّما يَجري مَعَ الحَقِّ باطِلُه",55,"ل",2,1],["أَلا تَرى القَومَ مِمّا في صُدورِهِمُ","كَأَنَّ أَوجُهَهُم تُطلى بِتَنّومِ",56,"م",1,0],["أَلا تَبكي بَنو سَعدٍ فَتاها","لِأَيّامِ السَماحَةِ وَالطِعانِ",57,"ن",1,0],["ألا تراني ببحر الحب غارقة","والموج يمضغ آمالي ويرميها",58,"ي",3,0],["أَلا تَرَونَ أَقَلَّ اللَهُ خَيرَكُمُ","أَنَّا غَضِبنا لِعُثمانَ بنَ مَظعونِ",59,"ن",1,0],["أَلا تَسأَلُ اللَهَ مِن فَضلِهِ","فَإِنَّ عَطاياهُ لا تَنفَدُ",60,"د",1,0],["أَلا تَأتي القُبورَ صَباحَ يَومٍ","فَتَسمَعَ ما تُخَبِّرُكَ القُبورُ",61,"ر",1,0],["ألا ترى في كل هذا الجلال","غير نذيرٍ طالعٍ بالفناء",62,"ا",2,0],["أَلا تَبكِيانِ المُرتَجى عِندَ مَشهَدٍ","يُثيرُ مَعَ الفُرسانِ نَقعَ الأَباطِحِ",63,"ح",1,0],["أَلا تَرى ما أَصدَقَ الأَنواءَ","قَد أَفنَتِ الحَجرَةَ وَاللَأواءَ",64,"ا",2,1],["أَلا تَرى كَيفَ يُبلينا الجَديدانِ","وَكَيفَ نَلعَبُ في سِرٍّ وَإِعلانِ",65,"ن",1,1],["إِلّا تَكُن صَدَرَت عَن مَنظَرٍ حَسَنٍ","حَربٌ فَقَد صَدَرَت عَن مَسمَعٍ حَسَنِ",66,"ن",1,0],["إِلّا تَكُن أَرواحُها لَكَ سُخِّرَت","فَالعَزمُ طَوعُ يَدَيكَ وَالإِجذامُ",67,"م",1,0],["إِلّا تَكُن حُصِرَت فَقَد أَضحى لَها","مِن خَوفِ قارِعَةِ الحِصارِ حِصارُ",68,"ر",1,0],["إِلّا تَنَل مَنويلَ أَطرافُ القَنا","أَو تُثنَ عَنهُ البيضُ وَهيَ حِرارُ",68,"ر",1,0],["إِلّا تَفِرَّ فَقَد أَقَمتَ وَقَد رَأَت","عَيناكَ قِدرَ الحَربِ كَيفَ تُفارُ",68,"ر",1,0],["ألا تتعطفينَ وأنتِ غصنٌ","ألا تتلفتينَ وأنتِ ظَبْيُ",69,"ي",1,0],["ألا تنظرونَ إلينا فمذْ","نظرتمْ بنا ما نظرتُمْ إلينا",70,"ن",2,0],["أَلا تَجزي عُثَيمَةُ وُدَّ صَبٍّ","بِذِكرِكِ لا يَنامُ وَلا يُنيمُ",71,"م",1,1],["أَلا تَراني مُخامِراً سَقَماً","كَحَّلَ عَيني بِمَأقِها السَهَدا",72,"د",2,0],["إِلّا تَكاليفَ الشَقاءِ بِمَن","لَم تُمسِ مِنّا دارُهُ صَدَدا",73,"د",2,0],["أَلا تِلكَ لَيلى قَد أَلَمَّ لِمامُها","وَكَيفَ مَعَ القَومِ الأَعادي كَلامُها",74,"م",3,1],["ألاَ تقومُ بدار المُلكِ جمهرةٌ","تحمي البناءَ وترعى الأمرَ والشَّانا",75,"ن",2,0],["أَلا تَخافونَ رَبّاً لا يَخافُ لَكُم","بَأساً إِذا اِنطَلَقَت أَقدارُهُ تَثِبُ",76,"ب",1,0],["أَلا تَرى النحلة مَهما حَلا","زهر الرُبى لَم تَنس مَأواها",77,"ا",3,0],["أَلا تِلكُما عِرسي مَنيعَةُ ضُمِّنَت","مِنَ اللَهِ إِثماً مُستَسِرّاً وَعالِنا",78,"ن",2,1],["أَلا تَسأَلونَ اللَهَ بُرءَ مُتَيَّمٍ","تَمَكَّنَ مِنهُ السَقمُ في اللَحمِ وَالدَمِ",79,"م",1,1],["أَلا تَسلو فَتَقصُرَ عَن هَواكا","أَلا وَمَشيبُ رَأسِكَ خانَ ذاكا",80,"ك",2,1],["أَلا تَرى بَهجَةَ الأَيّامِ قَد رَجِعَت","وَالناسَ في مَلِكٍ وَالدينِ قَد جُمِعا",81,"ع",2,0],["أَلا تَرَيانِ البَرقِ ما هُوَ صانِعُ","بِدَمعَةِ صَبٍّ شَفَّهُ النَأيُ وَالشَحطُ",82,"ط",1,1],["أَلا تَرى يا صاحِ ما حَلَّ بي","مِن ظالِمٍ في حُكمِهِ مُعتَدِ",83,"د",1,1],["إلاّ تَبَيَّنْتَ سِيما الغَدْرِ بَيّنَةً","عليه والكفرِ للنَّعْماء والغِيَل",84,"ل",1,0],["ألا تَخِرُّ لهُ الأيّامُ ساجِدَةً","إذْ نالَ مَكرُمَةً أعيَتْ فلم تُنَل",84,"ل",1,0],["ألا تِلكمُ الأرضُ العريضةُ أصحبتْ","وما لبني العبّاس في عرضِها فِتر",85,"ر",1,0],["أَلا تَرى ما أُعطِيَ الأَمينُ","أُعطِيَ ما لَم تَرَهُ العُيونُ",86,"ن",1,1],["إِلّا تَثاقُلَ عاشِقٍ أَو قُربَهُ","بِالحُبِّ لَيسَ لَهُ عَليكِ نُذورُ",87,"ر",1,0],["إِلّا تَغَوُّلَ أَمثالٍ تَكُن مَثَلاً","لِكُلِّ مُستَمِعٍ مِنكُم وَنَظّارِ",88,"ر",1,0],["أَلا تَجزينَني بِالشَوقِ شَوقاً","هَداكِ إِلى الجَزاءِ بِذاكَ هادِ",89,"د",1,0],["أَلا تَحَرَّجتِ مِمّا قَد رُميتِ بِهِ","وَسَطَ النِساءِ لِمَن أَفنى وَقَد رَقَدا",90,"د",2,0],["إِلّا تَكُن قَمَرَ السَماءِ فَإِنَّها","مِثلُ المَريعَةِ تُعجِبُ الرُوّادا",91,"د",2,0],["أَلا تَراكِ بِنا مُتَيَّمَةً","فَأَجابَ دَعوَةَ عاشِقٍ رَبّي",92,"ب",2,0],["أَلا تَرزُقُني مِنكَ","سُلُوَّ القَلبِ أَو قُربا",93,"ب",2,0],["أَلا تَتَّقينَ اللَهَ في قَتلِ عاشِقٍ","لَهُ حينَ يُمسي زَفرَةٌ وَنَحيبُ",94,"ب",1,0],["أَلا تَفرَقُ الأَحياءُ مِمّا بَدا لَها","وَقَد عَمَّها بِالفَجرِ أَزرَقُ مُغرَبُ",95,"ب",1,0],["أَلا تَتَّفقونَ اللَهَ رَهطَ مُسَلِّمٍ","فَقَد جُرتُمُ في طاعَةِ الشَهَواتِ",96,"ت",1,1],["أُلاتُ الظَلمِ جِئنَ بِشَرِّ ظُلمٍ","وَقَد واجَهنَنا مُتَظَلِّماتِ",97,"ت",1,0],["أَلا تَرحَمُ الأَشياخَ لَمّا تَأَوَّدوا","يَقولونَ قَد كُنّا الغَرانِقَةَ المُردا",98,"د",2,1],["أَلا تَرى أَنَّ أُمَّ دَفرٍ","كَأَنَّها آلُها السَخورُ",99,"ر",1,0],["أَلا تَرى هَرَمَي مِصرٍ وَإِن شَمَخا","كِلاهُما بِيَقينٍ سَوفَ يَندَرِسُ",100,"س",1,0],["أَلا تَرى جَمعَ ما لا عَقلَ يُسنِدُهُ","جَمعَ المُؤَنَّثِ فيهِ التاءُ وَالأَلِفُ",101,"ف",1,0],["أَلا تَنهَضُ لِلحَربِ","وَتَدعو لِلوَغى شُوسَك",102,"ك",1,0],["أَلا تَسمَعُ الآنَ صَوتَيهِما","بِكُلِّ اِمرِئٍ فيهِما يَحدُوانِ",103,"ن",1,0],["أَلا تَفَكَّرتَ قَبلَ النَسلِ في زَمَنٍ","بِهِ حَلَلتَ فَتَدري أَينَ تُلقيهِ",104,"ق",3,0],["أَلا تَقبَلُ المَعروفَ مِنّا تَعاوَرَت","مَنولَةُ أَسيافاً عَلَيكَ ظِلالُها",105,"ل",3,0],["أَلا تَتَّقونَ اللَهَ إِذ تَعلِفونَها","رَضيخَ النَوى وَالعُضِّ حَولاً مُجَرَّما",106,"م",2,0],["أَلا تَقِفانِ اليَومَ قَبلَ تَفَرُّقٍ","وَنَأيٍ بَعيدٍ وَاِختِلافٍ وَأَشغالِ",107,"ل",1,0],["ألا تَشكرونَ اللَّهَ إذْ قامَ فيكمُ","إمامُ هُدىً في المكرُماتِ عريقُ",108,"ق",1,0],["ألا تَعِستْ تلكَ الوجوهُ وقُبِّحتْ","فما خُلقا إلّا لها التَّعسُ والقُبحُ",109,"ح",1,0],["إلا تجدد فيها مثله وطر","قد كنت أَقدر أَن أَسعى على قدمي",110,"ي",1,0],["أَلا تُغني كِنانَةُ عَن أَخيها","زُهَيرٍ في المُلِمّاتِ الكِبارِ",111,"ر",1,0],["ألا تسْمَعُ التسْليمَ حين أكُرّهُ","وقد خابَ ظَنّي لستَ منّي بمَسْمَع",112,"ع",1,0],["الا تِلك الغنيمة لا إفال","ترجيها مسومة ونِيب",113,"ب",1,0],["أَلاَ تِلكَ الثَّعالبُ قد تَوالَت","عَلَّي وحالفَت عُرجاً ضِباعا",114,"ع",2,0],["ألاّ تُوَلُوا مَا تَغُوَّرَ رَاكِبٌ","أَخْزَى المَنُونَ مُوَالِياً إِخوانَا",115,"ن",2,0],["ألا تبقي على شيء","فمن يحيا بلا أكل",116,"ل",1,0],["أَلا تَفتَحُ لي فَوزٌ","مِنَ الرَحمَةِ أَبوابا",117,"ب",2,1],["إِلّا تَكُن فِي رُباهَا روضةٌ أُنُفٌ","فإِنَّما أوجهُ الأحباب روْضَاتُ",118,"ت",1,0],["ألا ترى كلّ من ترجو وتأمَلهُ","من البرِيَّةِ مسكينُ بن مسكين",119,"ن",1,0],["ألا تِلكُمُ الدار التي حل أهلها","بناءٍ عن الخطب المخوف شَطير",120,"ر",1,0],["أَلا تَقِفُ الدُموعَ عَلى حُسَينٍ","وَذِكرى مَصرَعِ الحَبرِ التَقِيِّ",121,"ي",1,0],["الا تزال بخير دار فاطمة","فالنهد مستنفر والكحل صبّاح",122,"ح",1,0],["ألا تكون لها قطبا تدور به","هل أنت عن قطبها المعهود غفلان",123,"ن",1,0],["ألا ترى ، أن اختلاجاته","أمامها شهق الحريق الأكول؟",124,"ل",1,0],["إلاّ تَكُنهُ على حِقيقَتِهِ يَغِبْ","عَمروٌ، وَيشهَدْ عاصِمُ بنُ الأسفَعِ",125,"ع",1,0],["ألا تتّقُونَ اللَّهَ رَهطَ مسلِّمٍ!","فقد جُرتمُ في طاعةِ الشّهواتِ",126,"ت",1,1],["إِلاَّ تَجَاوَبَهُنَّ حَوْلَ سَوَادِهِ","بحناجرٍ نحٍّ وشدقٍ أهدلا",127,"ل",2,0],["ألا تقولينَ .. ما أخبارُها سُفُني؟","أنا المسافرُ في عينيكِ دونَ هُدى",128,"د",2,0],["ألا ترعوي والنوح في كل منزل","ومن عشت فيهم فاقد وفقيد",129,"د",1,0],["ألا ترعوي والدوراقوت وأهلها","لهم شققت فوق اللحود لحود",129,"د",1,0],["ألا تلبس الأكوان فيه حدادها","كما نكست للدين فيه بنود",129,"د",1,0],["ألاَ تَرَى ما أصدَقَ الأنواءَ","قَدْ أفنَتِ الحَجْرَة واللَّلأوَاءَ؟",130,"ا",2,1],["إلا تنيبوا لأمرِ اللهِ تعترفوا","بغارة ٍ عصبٍ منْ خلفها عصبُ",131,"ب",1,0],["ألا ترى اليم تطغى فيه موجته","تقطع القلب من هم وبأساء",132,"ا",2,0],["إلّا تكن هذه الأشعار خالدةً","فلن يدوم لهذا الحسن ريعان",133,"ن",1,0],["إلّا تجبك نفوسٌ لا تعي أبداً","فقد أجابك قلب السامع الواعي",134,"ع",2,0],["أَلا تِلكَ عِرسي إذا أمعَرت","أَساءَت مَلامَتَنا والإِمارا",135,"ر",2,1],["ألا تَرى البرقَ نارَ رَكبٍ","تقدَّمونا على الطريقِ",136,"ق",1,0],["أَلا تَجزينَ مَن تَيَّمتِ عُمراً","وَمَن لَو تَطلُبينَ لَقَد أَتاكِ",137,"ك",1,0],["ألا تدعوا الدُّعاء بطول عمر","لسيدنا أمير المؤمنينا",138,"ن",2,0],["أَلا تِلكمو لَيثٌ وَعَمرو بن عامِرٍ","حَليفانِ راضوا أَمرَهم فتحلَّفوا",139,"ف",3,0],["أَلا تَكونَ لَهُ غولاً فَتُهلِكُهُ","كَأَنَّما كانَ زاداً غُصَّ فَاِبتُلِعا",140,"ع",2,0],["الا تَرَيْنَ الطيرَ في راحةٍ","من يومِ أمسى بالهوى معلنا",141,"ن",2,0],["ألا ترى الزهرَ في رباهُ","كأنهُ قلبي السليمُ",142,"م",1,1],["الا ترى الجنةَ فيما رووا","مطلوبةٌ من تحتِ أقدامها",143,"ه",2,0],["أَلا تُوفِي كَما أَوفى شَبيبٌ","فَحَلَّ لَهُ الوِلايَةُ وَالشُمولُ",144,"ل",1,0],["أَلا تبصرُ الأَغصانَ بلَّلها القطرُ","فَمالَت سَكارى لا رَحيقَ وَلا خَمرُ",145,"ر",1,1],["إِلّا تَلَألَأَ نورُهُ فَعَلاهُما","فَهُما لَهُ بِالفَضلِ مُعتَرِفانِ",146,"ن",1,0],["أَلا تَنسى الكَفورَ وَكُلَّ شَيءٍ","مِنَ الأَخلاقِ تَنتَجِعُ الرِجالُ",147,"ل",1,0],["أَلا تَفدي رُغاءَ البَكرِ أَوساً","بِسَوطٍ مِن هِجائي يا بُجَيرُ",148,"ر",1,1],["أَلا تَقبَلونَ النَصفَ مِنّا وَأَنتُمُ","بَنو عَمِّنا لا بَلَّ هامَكُمُ القَطرُ",149,"ر",1,0],["ألا تَرى الطيرَ أصنافاً وأضعفُها","صَيدٌ لأقدَرِها والفوزُ للبازي",150,"ز",2,0],["ألا تراهُ مِنَ الزَّرقاءِ طالعَنا","وفوقَنا نورُهُ والطِّيبُ والفرَح",151,"ح",1,0],["ألا تذكُرينَ ضياءَ القمرْ","يُريني على شَفَتيكِ الدُّرَرْ",152,"ر",1,1],["ألا تُعيدُ لقلبي لذةً هَرَبت","ومن ليالي الهوَى حينا تمتِّعه",153,"ع",2,0],["ألا تِلْكَ أعْنَاقُ البِلادِ بِأسْرِها","خَواضِع لَمَّا دَوَّخَ السَّهْلَ والحَزْنا",154,"ن",2,0],["أَلا تَرَونَ وُجُوهَ الْعَيْشِ مُقْبِلَةً","تُزْهى وَصَدْرَ الأَمانِي وَهْوَ مُنْشَرِحُ",155,"ح",1,0],["أَلا تَتَّقونَ اللَهَ يا آلَ عامِرٍ","وَهَل يَتَّقي اللَهَ الأَبَلُّ المُصَمِّمُ",156,"م",1,0],["أَلا تَرى لِلعرب","تقول عند العَجَبِ",157,"ب",1,0],["أَلا تَرى أُمَّةَ الأُمِّيِّ وارِدَةً","كَأَنَّها مِن نَواحي البَحرِ تَغتَرِفُ",158,"ف",1,0],["أَلا تِلكَ اِبنَةُ الأَمَوِيِّ قالَت","أَراكَ اليَومَ جِسمُكَ كَالرَجيعِ",159,"ع",1,0],["أَلا تَرى كُلَّ مَن تَرجو وَتَأملُه","مِنَ البَرِيَّةِ مسكينَ اِبنَ مِسكينِ",160,"ن",1,0],["ألا تذكرين ليالي الهوى","حبيبة قلبي سنى خاطري",161,"ر",2,0],["الا ترين شحوبي","وصفرتي وانفعالي",162,"ل",2,0],["الا ترين اضطرابي","وحيرتي وضلالي",162,"ل",2,0],["الا ترين حنيني","وذلتي وسؤالي",162,"ل",2,0],["إلاّ تكُنْ مُسكةٌ للمالِ مُقنعةٌ","فالعقلُ والصّبرُ عندي منهما مُسَك",163,"ك",1,0],["ألا تَعجبُ من سَورا","نَ إن تُعجَبَ سَورانُ",164,"ن",1,0],["إلا تكن نلت الوزارة ناشئاً","فلقد نشأت مدبر الوزراءِ",165,"ا",2,0],["ألا تكافوا الشرَّ شرّاً مثلَه","بل أكرموا الأعدا وجودوا وارفُقوا",166,"ق",3,0],["ألا تَرُدَّ أخاً لعفوك طالباً","بسؤاله وإليك فيه يضرع",167,"ع",1,0],["أَلا تِلكَ العَمودُ تَصُدُّ عَنّا","كَأَنّا في الرَخيمَةِ مِن جَديسِ",168,"س",1,1],["ألاَ تعجَبنْ لِعَمْروٍ وقَدْ","رمَى بالدُّعابةِ خَيرَ البَشَرْ",169,"ر",1,1],["ألا ترى الآنَ حالي كيفَ قد حلِتَتْ","بهِمْ ألم ترَ حالي عندَ تَرْحالي",170,"ل",2,0],["أَلا تروعك نَبوَة من عَزمِهِ","حَتّى تَقَلَّدَ ظالِماً آثامي",171,"م",2,0],["ألا ترى كلّ امرئٍ منهم","لنائل يرجى ونقعٍ مثار",172,"ر",1,0],["إلاَّ تَنَلْ قومٌ عُلاك فإنَّهم","طالوا وما بلغوا رفيع مكانها",173,"ن",3,0],["إلاَّ تداركني برحمته","إنِّي إذاً وأبي لفي خسر",174,"ر",1,0],["أَلا توبوا إِلى الرحمن توبا","نصوحا واسلكوا النهج النفاها",175,"ا",3,0],["ألا تعودُ سؤال رنَّ في أُذني","ولا يزالُ فهل لم يعرفوا شجني",176,"ن",2,1],["ألا تُسعداني بعينيْكما","وما كنتُ قبل الهوى أستعيرُ",177,"ر",1,0],["إِلّا تَلالا نَجمِهِ في بُرجِهِ","فَذُقتُ وَقتاً طابَ لي مِن نَفجِهِ",178,"ج",2,0],["إِلا تَذَكُّرَ ما مَضى وَصَبابَةً","مُنِيَت لِقَلبِ مُتَممٍ لا يذهَلُ",179,"ل",1,0],["أَلا تَستَحي مِنّا مُلوكٌ وَتَتَّقي","مَحارِمَنا لا يَبْوُءُ الدَمُّ بِالدَمِ",180,"م",1,0],["اِلاّ تذكَّرْتُ العقيقَ وبانَه","وحنينَ تغريدِ الحمامِ النائحِ",181,"ح",1,0],["الاتحاد كمثل الغيث هاطله","مذ جاد من نقط بالعارض الهامي",182,"م",2,0],["الاتحاد ولولاه لما برزت","في العالم الحيوي أشخاص أجرام",182,"م",1,0],["أَلا تَرَينَ وَقَد قَطَّعتِني قِطَعاً","ماذا مِنَ الفَوتِ بَينَ البُخلِ وَالجودِ",183,"د",1,1],["ألا تنظرون لرشد معي","ألا تَهتدون إلى اللّه بي",184,"ب",2,0],["ألا تلك حكماً سنَّة الله فانبسط","كذلك شأن الرسل والمصطفى كانا",185,"ن",2,0],["ألا تبطيءُ السيرَ قليلاً فنأنسَ","بما ظلّ من عطرِ هوىً ما سلوناهُ",186,"ن",3,0],["ألا تكن تلفت نفسي عليك فقد","أصبحت واللَه مشتاقاً إلى التلف",187,"ف",1,0],["ألا تكن في الهوى أرويت من ظماءٍ","ولا فككت من الأغلال مأسورا",188,"ر",2,1],["ألا تَسأل الخَيمات مِن بَطنِ أَرثَد","إِلى النَّخلِ من وَدّان ما فَعَلت نَعم",189,"م",1,1],["أَلا تَكونُ كَإِسماعيلَ إِنَّ لَهُ","رَأَياً أَصيلاً وَفِعلاً غَيرَ مَمنونِ",190,"ن",1,0],["إِلّا تُريحي عَلَينا الحَقَّ طائِعَةً","دونَ القضاةِ فَقاضِينا إِلى حَكَمِ",191,"م",1,0],["ألا تلكم السادات يا قوم تلكمُ","وفضلهم البادي فلا تنتقصهم",192,"م",1,0],["أَلا تَرى أَنَّما الدُنيا مَعَلِّلَةٌ","أَصحابَها ثُمَّ تَسري عِنهُمُ سَلَبا",193,"ب",2,0],["أَلا تَأمُرانِ الرَكبَ أَن يَدلِجُوا بِنا","أَبى النَومُ أَنّا كُلّنا يَتَصَبَّبُ",194,"ب",1,0],["أَلا تِلكُما عِرسي تَصُدُّ بِوَجهِها","وَتَزعُمُ في جاراتِها أَنَّ مَن ظَلَم",195,"م",1,1],["أَلا تِلكَ أَخلاقُ الفَتى قَد أَتَيتُها","فَلا تَسأَلوني وَاِسأَلوا كُلَّ مُبتَلي",196,"ل",2,0],["أَلا تَخافونَ قَوماً لا أَبا لَكُمُ","أَمسَوا إِلَيكُم كَأَمثالِ الدَبا سُرُعا",197,"ع",2,0],["ألا تستحي منا ملوك وتتقي","محارمنا لا يبأء الدم بالدم",198,"م",1,1],["أَلا تَفهَمينَ الخبرَ أَن لست لاقياً","أَخي إِذا أتى من دون أَكفانهِ القبرُ",199,"ر",1,0],["أَلا تَرَى مَأرِباً ما كانَ أَحصَنَهُ","وَما حَوالَيهِ مِن سورٍ وَبُنيانِ",200,"ن",1,1],["أَلا تَرَينَ الدَمعَ مِنّي ساجِما","حِذارَ دارٍ مِنكِ أَن تُلائِما",201,"م",2,0],["أَلا تَرَينَ الأَعيُنَ الذَوارِفا","حِذارَ دارٍ مِنكِ أَن تُساعِفا",202,"ف",2,0],["أَلا تَسَلينَ عَن شِبلَيَّ ماذا","أَصابَهُما إِذا اِهتَرَشَ الأُسودُ",203,"د",1,0],["أَلا تبكِيانِ المُرتَجى عِندَ مَشهَدٍ","يَثورُ مَع الفُرسانِ نَقعُ الأَباطِحِ",204,"ح",1,0]]}