{"poems":[[107,"رحمة يا أبا بصير ونعمى","https://www.aldiwan.net/poem44063.html","الرمل"],[54,"يا نفس صبرا صبرا","https://www.aldiwan.net/poem26977.html","المجتث"],[438,"تعود الطرد بها والطراد","https://www.aldiwan.net/poem12591.html","السريع"],[580,"قالوا قضيب البان قد بانا","https://www.aldiwan.net/poem2840.html","السريع"],[591,"لا تعتقدوا عذاره الفتان","https://www.aldiwan.net/poem17802.html","الدوبيت"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63959","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63802","المنسرح"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96610","البسيط"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58288","الخفيف"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111057","الخفيف"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36481","الدوبيت"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73386","الدوبيت"],[5431,"أيّتها النار","https://www.poetsgate.com/ViewPoem.aspx?id=207669",""],[5582,"أَهْدَى لَكَ الشَّوْقَ وَالتِّذْكارَ وَالوَصَبا","https://www.poetsgate.com/ViewPoem.aspx?id=63462",""],[5970,"متع النفس بما تهوى فما","https://www.poetsgate.com/ViewPoem.aspx?id=130585",""],[6178,"قبلة ماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85528&r=&rc=4",""],[6288,"رسالة تعزية إلى علي بن الجهم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76417&r=&rc=3",""]],"verses":[["ذَا خُنَيْسٌ وذا كتابُ ابنِ عَوْفٍ","فَالْزَمِ الصَّبْرَ أصبحَ الأمرُ حَتما",0,"م",2,0],["ذا خُلُقٍ كَريمٍ","لَم يُبقِ فيهِم عَقرا",1,"ر",2,0],["ذا خبرٌ شاعَ وقد عايَنوا","إذ حضروا ما زادَ عنه وزادْ",2,"د",1,0],["ذا خُلُق الدنيا فكم قَطعَتْ","قرائباً منَّا وأَقْرَانا",3,"ن",2,0],["ذَا خَالِقُهُ قَدْ خَطَّ فِي وَجْنَتِه","لاماً كُتِبَتْ بِالقَلَمِ الرَّيْحاني",4,"ي",1,0],["ذا خزامى ذا خُرَّمٌ ذاك خير","يٌّ قضى لي بِخَيْرِهِ خيرُ قاض",5,"ض",1,0],["ذا خضرُ الصَّعْتَرِيِّ مُنْصَرِفٌ","عنه وهذا الحَماحِمُ الأحمر",6,"ر",1,0],["ذا خيرُ من شيّد العليا وأَسبقُ من","حازَ وَأَسمحُ مَن أَعطى ومَن وَهَبا",7,"ب",2,0],["ذا خمارٍ من قَهوة العشق صَباً","ثَملاً من صَبَابة وَغرام",8,"م",1,0],["ذا خليلي أعددته للرزايا","وبه أدرك الأماني جساما",9,"م",2,0],["ذا خَدّيَ في النضارِ من صَفحَتِهِ","لَو شئتَ قرأت سورَة الإِخلاصِ",10,"ص",1,0],["ذَا خَطُّ عِذارِ خَدِّكَ الَمنسوخُ","الحُسنُ بِهِ جَميعُهُ مَنسوخُ",11,"خ",1,1],["ذا خنجر الغرب ..ذا دمي نَهَرٌ","لكنّ موتي المنشود لن يقعا !!",12,"ع",2,0],["ذا خَيْرُ مَنْ شَيَّدَ العَليا وَأَسْبَقُ مَنْ","جارَى وَأَسْمَحُ مَنْ أَعْطَى وَمَنْ وَهَبا",13,"ب",2,0],["ذا خيال باطل قد قادهم","نحوه فيما أرى طول الجشع",14,"ع",1,0],["ذا خدها المشبوب من جمر الهوى","نبت الدماء اللون بالأضواء",15,"ا",2,0],["ذا خبر يا شاعري من حزنه انتحب","أنشره– واخجلي – من حلبة الأدب",16,"ب",1,0]]}