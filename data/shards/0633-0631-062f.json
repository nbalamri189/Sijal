{"poems":[[53,"لأبي بكر كلام واحد لا يتعدى","https://www.aldiwan.net/poem11466.html","مجزوء الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[170,"وفى السحاب لمغناه وإن خانا","https://www.aldiwan.net/poem46863.html","البسيط"],[280,"مرقوم الخد مورده","https://www.aldiwan.net/poem25586.html","المتدارك"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83302","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60831","الكامل"],[2583,"","https://poetry.dctabudhabi.ae/diwan/poem/128105","الكامل"],[164,"","https://poetry.dctabudhabi.ae/diwan/poem/127644","الطويل"],[5277,"دفّةُ الأفلاك","https://www.poetsgate.com/ViewPoem.aspx?id=185841",""],[5533,"ذَهَبَ الذينَ أُحِبُّهمْ","https://www.poetsgate.com/ViewPoem.aspx?id=176668",""]],"verses":[["سرد الكافاتِ والمي","ماتِ والدالات سردا",0,"د",2,0],["سرداقٌ ينفذ حكم ربّه","من منبع النيل الى مصبّه",1,"ه",1,0],["سرٌّ دفينٌ نبشْناهُ فلم نَرَهُ","سبحانَ علاّمِ هذا الغيبِ سُبحانا",2,"ن",2,0],["سردَ التقريظَ لِسيرَتِه","صَومٌ لا يَفْتَأ يَسْرُدُهُ",3,"د",2,0],["سَرَدَت لَهُ هَذا الحَديدَ فَلَم تَزَل","تَمُدُّ بِقُضبانٍ لَهُ وَقواضِبِ",4,"ب",1,0],["سردةُ المنتهى وقد كان منها","قاب قوسينِ سارعت لاحتضانِ",5,"ن",1,0],["سَردُ النُّصُوصِ فإنَّهَا قَد نَوَّعَت","طُرقَ الأدِلَّةِ فِي أتَمِّ بَيَانِ",6,"ن",1,0],["سَرْدَقْتَها خَنْدَقتها مَنَّعْتَها","والله ما يعدُو عليهَا العَادي",7,"د",2,0],["سرد المدائح للرسول وآله","درع الكرام على الدوام وكم حمى",8,"م",2,0],["سردت قلوباً ساءها بعدك النوى","ونال الأسى منها وراك منَالا",9,"ل",2,0],["سردتُ القريضَ المرَّ والطعمُ علقم","وشعري ككأسِ السمِّ في موتِه يشدو",10,"د",2,0],["سَرْدُ الحديثِ يَلُمُّنا بتَدفُّقٍ","فمَتى يَعُودُ لِقاؤُنا يَتَدفَّقُ",11,"ق",1,0]]}