{"poems":[[51,"يا أيها المتسمن","https://www.aldiwan.net/poem63142.html","مجزوء الكامل"],[82,"ودجنة كالنقس صب على الثرى","https://www.aldiwan.net/poem31573.html","الكامل"],[46,"أما الرسوم فقد أذكرن ما سلفا","https://www.aldiwan.net/poem30404.html","البسيط"],[211,"لأسماء رسم أصبح اليوم دارسا","https://www.aldiwan.net/poem27943.html","الطويل"],[235,"وكنا إذا ما لزمنا الوقار","https://www.aldiwan.net/poem4057.html","المتقارب"],[308,"أهواه مشتغلا بعلم الوقت ذا","https://www.aldiwan.net/poem58036.html","الكامل"],[412,"ولى ولم يقض من أحبابه وطرا","https://www.aldiwan.net/poem50171.html","البسيط"],[443,"يا حادياً هلا وقفت قليلا","https://www.aldiwan.net/poem2575.html","الكامل"],[463,"أما وهواها عذرة وتنصلا","https://www.aldiwan.net/poem55919.html","الطويل"],[520,"في مثل مدحك شرح القول مختصر","https://www.aldiwan.net/poem12117.html","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62666","الكامل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61108","المتدارك"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75862","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108058","الكامل"],[4308,"","https://poetry.dctabudhabi.ae/diwan/poem/34763","المنسرح"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104514","الكامل"],[4446,"","https://poetry.dctabudhabi.ae/diwan/poem/139103","الكامل"],[5590,"يا من قصدتُ إليه التمس الغنى","https://www.poetsgate.com/ViewPoem.aspx?id=105301",""],[5638,"كاميليا والخائنون","https://www.poetsgate.com/ViewPoem.aspx?id=198249",""],[5704,"لاح الحياء","https://www.poetsgate.com/ViewPoem.aspx?id=195151",""],[520,"في مثل مدحك شرح القول مختصر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577521",""]],"verses":[["فَكَأَنَّ شَخصَكَ لَم يَكُن","في الناسِ ساعَةَ تُدفَنُ",0,"ن",1,0],["فكأنّ شمساً في تألّقِ مائِهِ","مَجّتْ عليه مَعَ الشّعاعِ رُضَابا",1,"ب",2,0],["فَكانَ شَخصُكَ في أَغفالِها عَلَماً","وَكانَ رَأيُكَ في ظَلمائِها سَدَفا",2,"ف",2,0],["فَكانَ شُهودي مَعبَدٌ وَمُخارِقٌ","وَبِشرٌ وَما اِستَشهَدتُ إِلّا الأَكايِسا",3,"س",2,0],["فَكانَ شَفِيعًا لها عنْدَنا","وكانتْ شَفِيعا لنا عِنْدهُ",4,"د",2,0],["فكأن شمس جبينه لما استوت","جاء العذارُ بظلها المنكوس",5,"س",1,0],["فَكانَ شِعريَ سلكاً في فَضائِلِهِ","نطمتُهُنَّ وَكانَت فَوقه دُرَرا",6,"ر",2,0],["فكأنّ شمان كالدموع تفرّقاً","إذ راح جسمي كالخيال ضئيلا",7,"ل",2,0],["فكان شقيّاً خاب عندك سعيُه","وفزتُ وكنتَ المنعمَ المتفضِّلا",8,"ل",2,0],["فكان شمساً وكنت الفجر تقدمها","والفجر في الجو قبل الشمس ينتشر",9,"ر",1,0],["فكأنَّ شعرك غُرّةٌ","سفرت بجبهة ذا الزمنْ",10,"ن",1,0],["فَكَأن شؤونك تضرمه","وَكَأَن الدَّمع لَهُ حصب",11,"ب",1,0],["فَكانَ شهابُ الدينِ يُعليهِ رُتبةً","يَصير بِها مَلكاً عَلى جِنسِهِ العُربِ",12,"ب",1,0],["فكأن شهوته ستار حيائه","يمشي وليس بهمه ما يخجل",13,"ل",1,0],["فَكانَ شَيءٌ هَيهاتَ أَذكُرُهُ","إِنّي ضَنينٌ بِسِرِّها بَخِلُ",14,"ل",1,0],["فكأن شخصك قائد","وكأنها انتظمت عساكر",15,"ر",1,0],["فكأن شهب النجم قد غرقت به","فطغت على أمواجه أعرافها",16,"ف",3,0],["فكأن شهب النجم قد غرقت فيه","فطغت على أمواه أغراقها",17,"ه",2,0],["فَكَانَ شَرِيفًا قِيلَ دَوْمًا لأَزْهَرٍ","فَصَارَ كَرَأْسٍ لِلدِّيَاثَةِ وَالْفَمِ",18,"م",1,0],["فكأن شمس الفجر ألقت نورها","لتعمَّ كل الكون بالبركات",19,"ت",1,0],["فكان شما وكنت الفجر يقدمها","والفجر في الجو قبل الشمس ينتشر",20,"ر",1,0]]}