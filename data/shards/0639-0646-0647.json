m/ViewPoem.aspx?id=176955",""],[4736,"ظلمات","https://www.poetsgate.com/ViewPoem.aspx?id=176156",""],[4767,"بهدلة","https://www.poetsgate.com/ViewPoem.aspx?id=212767",""],[4767,"جرح لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=215436",""],[4791,"حبك نسيته","https://www.poetsgate.com/ViewPoem.aspx?id=28402",""],[4791,"لو تعذر","https://www.poetsgate.com/ViewPoem.aspx?id=28409",""],[4843,"مسبّحٌ من لهُ في الخلقِ آياتُ","https://www.poetsgate.com/ViewPoem.aspx?id=142689",""],[4902,"ياصغير مايكبرني لقب","https://www.poetsgate.com/ViewPoem.aspx?id=22586",""],[4927,"طيب عيد العراق","https://www.poetsgate.com/ViewPoem.aspx?id=12982",""],[4978,"تشعير","https://www.poetsgate.com/ViewPoem.aspx?id=177534",""],[4987,"نهار الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=49578",""],[4988,"طير الافكار","https://www.poetsgate.com/ViewPoem.aspx?id=204790",""],[5277,"حكايتها","https://www.poetsgate.com/ViewPoem.aspx?id=188038",""],[5573,"لاهبت الريح بقلوب الهواويه","https://www.poetsgate.com/ViewPoem.aspx?id=200306",""],[5573,"فاز بالخير بادي يوم يقري سلام","https://www.poetsgate.com/ViewPoem.aspx?id=202543",""],[5628,"حديث مع البحر","https://www.poetsgate.com/ViewPoem.aspx?id=178548",""],[5648,"يبقا سلام الله لو الجرح ماطاب","https://www.poetsgate.com/ViewPoem.aspx?id=155217",""],[5691,"نِعلين تقاوم الجدار","https://www.poetsgate.com/ViewPoem.aspx?id=206393",""],[5732,"بالهرج يعطونك","https://www.poetsgate.com/ViewPoem.aspx?id=177914",""],[5732,"الجادل اللي","https://www.poetsgate.com/ViewPoem.aspx?id=177913",""],[5732,"الله من هم بالأعماق مخفيه","https://www.poetsgate.com/ViewPoem.aspx?id=177821",""],[5786,"يا بارقاً لاحَ من أكتاف كوفانِ","https://www.poetsgate.com/ViewPoem.aspx?id=50655",""],[5786,"إن كنتَ لي صاحباً قِف لي بهبود","https://www.poetsgate.com/ViewPoem.aspx?id=50651",""],[2765,"برح الخفا ما الحق فيه خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=136825",""],[5953,"إحدى العجائب خلقة الإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=93862",""],[5956,"البلدة السعيدة","https://www.poetsgate.com/ViewPoem.aspx?id=185792",""],[5956,"يا من أخذت من اسمكم معناهُ","https://www.poetsgate.com/ViewPoem.aspx?id=194377",""],[5969,"مِنْ لَظى التعياءِ شِعري","https://www.poetsgate.com/ViewPoem.aspx?id=199332",""],[6124,"سينية العشق","https://www.poetsgate.com/ViewPoem.aspx?id=128751",""],[5355,"لم أنسه أبدا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87129&r=&rc=24",""],[2220,"ليس يدري الغير ما طعم الهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11900&r=&rc=769",""]],"verses":[["عَنهُم نَبَشنا زَماناً","في مُظلِماتِ الدُروسِ",0,"س",1,0],["عَنهُ إلى غَيرِهِ وَلَو رَفَعَ ال","نَّاسُ إليَّ العيونَ وارتَقَبُوا",1,"ب",3,0],["عنه تمضي ولو تعدّته أضحت","من كليلٍ مُفَلَّلٍ وخَشيبِ",2,"ب",1,0],["عنْه ولا يغفُل عني قلمُهْ","ولا تزالُ ثِقتي تَسْتعصمُهْ",3,"م",2,0],["عنها الحديثُ إذا هُمْ حاوَلوا سَمَراً","والرّزْقُ منها إذا حَلّوا أماريتا",4,"ت",2,0],["عَنهم أَخَذْنَا أُصولَ الدين جملتنا","والحقَّ قالوا وَما في قولهمن خَطَلُ",5,"ل",1,0],["عَن هَيبَةٍ لَكَ لَم تُؤمَن بَوائِقُها","لَو أَنَّها في الزُلالِ العَذبِ ما شُرِبا",6,"ب",2,0],["عَن هَيبَةٍ لَكَ لَو قَبلَ الرَسولِ أَتَت","فُؤادَ مَكَّةَ لَم يُعبَد بِها صَنَمُ",7,"م",1,0],["عَن هَيبَةٍ سَكَنَت أَحشاءَهُم فَقَضَت","أَن يَقفِلَ الجَيشُ عَنهُم وَهوَ عِندَهُمُ",8,"م",1,0],["عَن هَيبَةٍ ضَمَّنتَها إِذ لَم تَزَل","لِلعِزِّ أَوفى ضامِنٍ بِضَمانِ",9,"ن",1,0],["عَنها طَردتُم وَلَمّا يَثنِكُم رَهَبٌ","بَني الطَّريدِ وَلا اِستَوهاكُمُ رُعبُ",10,"ب",1,0],["عنهُ نابوا في قومِهم فرسول","لكثيرٍ وقومُ بعضٍ قليلُ",11,"ل",1,0],["عنها الغصون حديث الميل ترفعه","إلى القوام وعنه صح ما نقلت",12,"ت",1,0],["عنه غصن البان حدثنا","خلف يرويه عن خلف",13,"ف",1,0],["عن هلالٍ كصَوْلجَانِ نُضارِ","في سماءٍ كأنها جامُ ذَبْلِ",14,"ل",1,0],["عَنهُ وَجدي وَما بِهِ","عِلَّةٌ ما صَرَفتُهُ",15,"ت",2,0],["عنه التصور موضوعاً ومرتفعاً","عن غاية الذكر معقوداً ومحلولا",16,"ل",2,0],["عنه ومما أمر به حتم لا مساواه","أو شيء أراده كمثل أحكام بيعه شراه",17,"ا",2,0],["عنه ولكن ليس يأخذ مقلتي","نومٌ ولا سِنَةٌ بغير قياس",18,"س",1,0],["عنه المكارم في الوجود تنوعت","أجناسها والجنس قد يتنوّع",19,"ع",1,0],["عن هذه الدنيا وما صنعت بها","عما لها وزرت به جهالها",20,"ل",3,0],["عنهنَّ صُنْ نفسا فأكرمُ عاشقٍ","من عزَّ مقتربا وأسمح نائيا",21,"ي",2,0],["عنَّ هواكِ فأذلَّ جَلَدي","والحبُّ ما رقَّ له الجَلْدُ وذَلّْ",22,"ل",1,0],["عنه إليكَ بهِ فان ضلالَه","في الوجدِ لو حاقَقْتَ نفسَكَ رُشْدُه",23,"د",2,0],["عن هَواكُمْ أخَذَ القَلبُ البِلى","وأَداةُ الجَرِّ فيكُمْ هي عَنْ",24,"ن",1,0],["عنها ثِقاتُ بني المَهديّ قد نقَلوا","لنا روايات صِدقٍ فاِعتَقَدْناها",25,"ا",3,0],["عنهمْ تُلُقِّيَتِ العظاتُ وَمنهمُ","فُهِمَ الهُدى وَتعُلِّم التأْويلُ",26,"ل",1,0],["عنه به الأفكار مشغولة","تحصيلها دل على فوته",27,"ت",2,0],["عنه الرضى توفيقْ","من أفضل الذكرِ",28,"ر",1,0],["عنه الرضى منطوقْ","للسادة الأحبابْ",28,"ب",1,0],["عن هدى السنة مالوا","نفذوا عنه نفاذا",29,"ذ",2,0],["عنه البرية قد لهت","وتفرقت أيدي سبا",30,"ب",2,0],["عَن هَيجِ إِبراهيمَ يَومَ المَرحَلِ","وَجَعلِ نَفسي مَعَهُ وَمِقوَلي",31,"ل",2,0],["عَنهُ غَدا وَاللَونُ نُوّارِيُّ","كَأَنَّهُ مُتَوَّجٌ رُومِيُّ",32,"ي",1,0],["عنها ومن كذب بالفرائض","في قولكم طرا بلا معارض",33,"ض",1,0],["عنها الرسول في محل العاصي","أو في محلات ذوي الإخلاص",33,"ص",1,0],["عنه وصار ذاك في الإعلان","أشهر في الناس من الأذان",33,"ن",1,0],["عنه الذين أنكروا الحكومة","وخاصموا أصحابه خصومة",33,"ه",1,0],["عنه الخوارج الذين انصرفوا","في ذاك ثم أنهم تخلفوا",33,"ف",3,0],["عنهم من النكث وسوء السيرة","ما يكتفي به ذوو البصيرة",33,"ه",1,0],["عنه لأنه من الصحابة","فكرهوا لذلك اغتيابه",33,"ه",1,0],["عنهم فكان القوم بين قائل","وقائم مكثر وخاذل",33,"ل",1,0],["عنه الذي قالوه يسألونه","ما قال في دعائه يرونه",33,"ه",1,0],["عنه وقالوا قد رأينا آية","تشهد فينا لك بالولاة",33,"ه",1,0],["عنه لما خامرهم من هيبة","ومن جمال وجهه وشيمة",33,"ه",1,0],["عنه لقوله على المعارضة","أكثرهم فقال أنتم رافضة",33,"ه",1,0],["عنهم أنابوا في أداء تحية","نحو الرفاعي قطبهم داوودا",34,"د",2,0],["عنهم سلوا الأقوام تنبئكم بما","صنعوه من حسن لها وحميد",35,"د",1,0],["عَنهُ سَلني في كُل أَمرٍ فاني","لِسَجاياه في الدَفاتر كاتب",36,"ب",1,0],["عنه وعن أحيحة افتراري","وغالبٌ أطفأ نارَ العار",37,"ر",1,0],["عَنها نَأَيت فَوا شَوقي وَيا لَهَفي","إِلى الدّيارِ ويا بُعدي عَنِ الأمَلِ",38,"ل",1,0],["عَنهُ الحَديث سَماعُهُ قَد يَنبَغي","وَالفِقهُ وَالتوحيدُ وَالتفسيرُ",39,"ر",1,0],["عنهم الإحسان ناءِ","والمخازى ليس تبرح",40,"ح",1,0],["عنها سروا فأصبحت","وهي يباب همد",41,"د",1,0],["عنها الصحاح رواها الجوهري فلا","ترتب فتلك الصحاح الجوهريات",42,"ت",1,0],["عَنْهُ يَرْوِي النَّدَى أبو هَرَم","لابن زَيْدِ السؤَال",43,"ل",1,0],["عَنْ هَرَوِيٍّ مِنْ هَرَاة اخْلَوْلَقَا","وَبَطَّنَتْهُ تَحْتَ ما تَشَبْرَقا",44,"ق",2,0],["عنه الاعارب في الثنا والحمد كم","قد أعربت الترك يفصح قايلا",45,"ل",2,0],["عنه التواريخ تروي","براعةً وشمولا",46,"ل",2,0],["عنه الجمادات اضحت وهي مفصحة","وقد اتى مدحه في معظم السور",47,"ر",1,0],["عنه لا تيأس لاجل ذنو","ب وكن في الفضل ذا عشم",48,"م",1,0],["عَنهُم وَهُم أَعداؤُهُ بِالطبع","وَكُلهُم يقصده بِالسبع",49,"ع",1,0],["عَنها وَلَو كانَ بِضيقِ مَأزِلِ","أَو كانَ دَفعَ الفيلِ لَم تَحَلحَلِ",50,"ل",1,0],["عَن هامَةٍ كَالقَمَرِ الوَبّاصِ","وَلا بِذاكَ الأَحمَرِ الفِراصِ",51,"ص",1,0],["عَنْهِن دِوَتْ كالحرّ لي صار مهدود","للصيد أو ريم نِظَر زول صَيّاد",52,"د",1,0],["عنها إليك فإنَّها","تدع القلوبَ وراءها",53,"ا",3,0],["عنها ينصاعُ الفكرُ عياً","والطرف كليلاً يرتدُّ",54,"د",1,0],["عنه عن غير حاصل مستلذ","لا وحقَّ الإله جلَّ جلالا",55,"ل",2,0],["عنه فلا يأمن من مكره","غير ظلوم نفسه غاشم",56,"م",1,0],["عنه بتأليفه في ذلكم خبرٌ","قد طال فيه كلامُ الناسِ ما قصرا",57,"ر",2,0],["عنه إلى غيره فترمي","إليه أنوارَها الرجوم",58,"م",1,0],["عنه وجها لم يزل وجهته","يطلب الوجه بها وأودى اللوى",59,"و",2,0],["عنها وجولوا في ميادينها","فإنها الميدانُ والملعب",60,"ب",1,0],["عنه بأنا قد عجزنا وانقضتْ","آياته وأنابه الكبريت",61,"ت",1,0],["عنه العبارة في الألفاظ قاصرةٌ","يدريه من رتَّل القرآن ترتيلا",62,"ل",2,0],["عنه واعلم قطعاً أنه ملك","وإنني نائبٌ عنه فيكرمني",63,"ن",2,0],["عنها وعن حللِ الديباج فاعتبروا","فيما أتاكم به ذو المنطقِِ الحسنِ",63,"ن",1,0],["عنها تولدتِ الجسومُ بأسرها","وتعاقبَ الإصباحُ والإمساء",64,"ا",2,0],["عنهُ إذا ما حكى للبحر واصفه","تعجبا من عطايا كفه جمدا",65,"د",2,0],["عنهُ أحاديث المودة والوفا","تُروى كما يروى العطا عن حاتم",66,"م",1,0],["عنها سلو مصر وتلك الخطه","فإنهم أدرى بهذي النقطه",67,"ه",1,0],["عنه سلوا من قال في تاريخه","والفضل معلوم لدى أصحابه",68,"ب",2,0],["عنها بأحسن بشرى يا مؤرخ قل","حازت من اللَه في دار البقا نعما",69,"م",2,0],["عنها الصبا تسأل زهر الربى","من أين هذا النفس الطيب",70,"ب",1,0],["عَنهُ فِرّي تَسلَمي مِن نارِهِ","وَالمَسِيهِ تُصعَقي أَو تُقتَلي",71,"ل",2,0],["عن هزار الايك لما نغما","وَعَلى الندمان يا حلو الدَلال",72,"ل",1,0],["عنه صحت في الندى أخباره","حيث أمسى في الندى بحراً طما",73,"م",2,0],["عنه وأحنو عليه أمّا","أُلبسه النور مُسبطِرّا",74,"ا",1,0],["عنها وضيَّع عزه الرب","يا ليلُ كيف ظلامك انصرما",75,"م",2,0],["عنه اذود بمرقمي وبمقولي","هجمات كل معاندٍ وخصيم",76,"م",1,0],["عنه لقد دافعت بالعزم الذي","نظر الحسام مضاءه فتعلما",77,"م",2,0],["عنها فتنظر نورها","وبهاءها وجمالها",78,"ل",3,0],["عنهه اصطباري ما أنا بمطيعه","مثل السلو ولا أنا بمطيقه",79,"ق",2,0],["عَن هُبَيرٍ وَاِبنِهِ جَع","دَةَ فَاِحتَلَّ التِّلاعا",80,"ع",2,0],["عنها أخذتُ الذي تراهُ","يعذُبُ في شعرِيَ الرقيقِ",81,"ق",1,0],["عَنهَا بِقَدرِ أربَعَه أزوامِ","بريحِ طَيِّبِ أيَا هُمَامي",82,"ي",1,0],["عنه خذ كل ذرة","ملئت منه كأس خمر",83,"ر",1,0],["عنهن لا ينقضي شرخ الشباب ولا","طعم اللذاذة في السراء والجذل",84,"ل",1,0],["عنه فصحى اللغات تروي حديثا","طاب نشر فصح معتل نقله",85,"ل",2,0],["عنه حدث بما تشاء كمالاً","فكلام الكمال فيه مسلم",86,"م",1,0],["عنها جميع السّعد فر","فيها جميع النحس قّر",87,"ر",1,0],["عَنها الحِجاب كَما بالصدق عنك أُخِذ","ومنذ أوحى بما أُوحي إليك وَمُذ",88,"ذ",1,0],["عنها على مريخ نحسٍ أغير","مبغوض ذات من بني عجلان",89,"ن",1,0],["عنه تروى واليه","في الندى الأخبار تسند",90,"د",1,0],["عنها نأت تلك الكرامُ فما بها","إلا أرامل أو يتامى هاشمي",91,"م",2,0],["عنه فقل أَول من أَول من","أَمس ولا تَعُدَّ ذاك فاستبِن",92,"ن",1,0],["عَنهُ أَلقى سِلاحَهُ وبِهِم جا","لَ مُطاعَ الإِيعازِ والسُّلطانِ",93,"ن",1,0],["عنه جراثيم الذباب الوبيل","تلك التي تنهش لحم القتيل",94,"ل",1,0],["عَنهُم بِأَن يَرويهِ ثُمَّ يَنقُلُهُ","وَكُل وَرد عَنهُم فَاِستَعمِلهُ",95,"ه",1,0],["عَنهُ وَأَمّا الفاضِل الجَبوري","المُتقَن الحِبر بِلا نَكير",95,"ر",1,0],["عَن هَوانٍ وَذلةٍ وَضلالٍ","وَسُقوطٍ في ساقطِ الآدابِ",96,"ب",1,0],["عنه سل قاصدا أذى سلّ سيفا","صدّ عنه برعدة واهتزاز",97,"ز",1,0],["عنهم سل ليوث حرب رموهم","في مهاوى مذلة وتهازى",97,"ز",2,0],["عنهما القرطاس سل حين البرا","عات توحيها براعات القصب",98,"ب",1,0],["عنهم بنوهم معربون لأنهم","أخبار صدق والجدود المهتدا",99,"د",2,0],["عنه سلو الجنات من وجناتكم","أواه من نيرانها أواه",100,"ا",2,0],["عنه سل الأسحار فاستغفاره","فيها لذياك الأمام سحور",101,"ر",1,0],["عَنها اِرتَحَلنا بِالمُنى","وَأَقامَتِ الأَزهارُ",102,"ر",1,0],["عَنهُ أَعرَضنا كَأَنّا في كَرىً","مِثلَ أَهلِ الكَهفِ أَو أَهلِ الرَقيم",103,"م",1,0],["عنه سروا وفارقوا جباله","ونزلوا بمنزل الغزاله",104,"ه",1,0],["عن هدي أسلافكم قولاً إلى عمل","عن المعارف والأخلاق والأدب",105,"ب",1,0],["عَنْها العِنانَ وَما أَلْوَى لَها وَأَوَى","وَكَمْ طَوَى كَشْحَهُ عَن لَذَّةٍ وَطَوَى",106,"ط",3,0],["عنه وفي بحر الهدى يعوموا","ذا شأن ذي التكليف فافهم إيضاح",107,"ح",1,0],["عنها فحاروا في الجوا","بِ وما شَفَوا قَرَمَ السُّؤال",108,"ل",1,0],["عنه سل السعد كيف اعطى","تهذيبه للكلام فاها",109,"ا",3,0],["عنه للملك سلوةٌ بسليل ال","حَسن المرتقى لأعلى ارتفاع",110,"ع",1,0],["عنه حنا في أمانٍ وهو ما من أمان","عن تفاصيل المواضيع تكفي كلمتين",111,"ن",1,0],["عَنْهَا تَنَزَّهَ كُلُّ عَبْدٍ مُشْرِكٍ","عَبَدَ الصَّلِيبَ وَلاَذَ بِالجَوْزَاءِ",112,"ا",2,0],["عنها فؤادي الدهرَ لم ينشغل","كم فيه قد كان لها منزلة",113,"ل",2,0],["عنها نبَتْ وإذا استقامتْ كلنا","بالاختلافِ عقيدةً أشلاء",114,"ا",2,0],["عن هجرك وفرقاك قلبي نهيته","لاشك ماطاع المولَّع كلامي",115,"م",2,0],["عنه قلبي منه محجوبٍ سماه","بالغيوم اللِّي مناشيها سرى",116,"ر",2,0],["عنهُ أسألنًّ فرنسا قل وكلّ بلا","دٍِ قبلُ حلّت لهُ فيها ركاباتُ",117,"ت",1,0],["عن هلك ابراي لله وأحتسب","الرجال اللي مجاراهم عسير",118,"ر",1,0],["عَنْهُ الأَبِيُّ بنُ الأَبِيِّ مُدَاْفِعٌ","وَالْفَتْحُ، وَالنَّصْرُ الْمُؤَزَّ