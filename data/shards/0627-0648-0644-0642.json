{"poems":[[73,"ما سر سكان الحمى بمذاع","https://www.aldiwan.net/poem4025.html","الكامل"],[50,"هل مخطئ حتفه عفر بشاهقة","https://www.aldiwan.net/poem64454.html","البسيط"],[141,"عللاني واسقياني","https://www.aldiwan.net/poem67933.html","مجزوء الرمل"],[240,"سرب مها أم دمى محاريب","https://www.aldiwan.net/poem32184.html","المنسرح"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87087","الخفيف"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126229","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135310","المديد"]],"verses":[["أَو لَقُوَّةٍ شَغواءَ حَقَّقَ طَرفُها","مِن رَأسِ مرقَبَةٍ طَلاً في قاعِ",0,"ع",1,0],["أَو لَقوَةٍ أُمِّ اِنهيمَينِ في لُجُفٍ","شَبيهَتَيها شَفا خَطمٍ وَآماقا",1,"ق",2,0],["أَو لَقَد غودِرَ فيها","حينَ صُبَّت في الدِنانِ",2,"ن",1,0],["أَو لُقِّنَت مُستَفيدَةً كَرَمَ ال","أَخلاقِ مِن يوسُفَ اِبنِ أَيّوبِ",3,"ب",1,0],["أَو لقطع الطَريق براً وَبَحراً","أَو لغدر الرَفيق عِندَ الطَعام",4,"م",1,0],["أوّلُ قُرآنٍ كلامٌ أزَلِىّ","بِسمِ ألم إلى الناس مَدا",5,"د",2,0],["أولٌ قدّم أوالي","رتبتي يا متعالي",6,"ل",2,1]]}