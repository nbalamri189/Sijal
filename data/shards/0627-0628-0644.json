an/poem/43661","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43778","المنسرح"],[106,"ظلال الثورة مصر وسوريا","https://www.poetsgate.com/ViewPoem.aspx?id=179583",""],[22,"ولقد رأيتُكِ في النساءِ فسُؤْتِني","https://www.poetsgate.com/ViewPoem.aspx?id=19721",""],[50,"آبَ لَيْلِي لَيْتَ لَيْلِي لَمْ يَؤُبْ","https://www.poetsgate.com/ViewPoem.aspx?id=17927",""],[45,"لله عَهْدُ سَوِيقَةٍ ما أنْضَرَا،","https://www.poetsgate.com/ViewPoem.aspx?id=31338",""],[45,"ذاكَ وَادي الأرَاكِ فاحبِسْ قليلا","https://www.poetsgate.com/ViewPoem.aspx?id=32098",""],[28,"أبلغ أبا داود أني ابن عمه","https://www.poetsgate.com/ViewPoem.aspx?id=19996",""],[38,"مَا بَالُ دَفِّكَ بالْفِرَاشِ مَذِيلاَ","https://www.poetsgate.com/ViewPoem.aspx?id=21222",""],[51,"خبا نَحْسٌ وأعقب منه سعْد","https://www.poetsgate.com/ViewPoem.aspx?id=28470",""],[32,"أبلغ بثينة أني لست ناسيها","https://www.poetsgate.com/ViewPoem.aspx?id=125",""],[39,"أبلغْ أبَا نفرٍ حديثاً، وقلْ لهُ:","https://www.poetsgate.com/ViewPoem.aspx?id=4240",""],[31,"أَبْلِغْ سُلَيْمى بِأَنَّ البَيْنَ قَدْ أَفِدا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18825&r=&rc=88",""],[20,"طال الليل علينا واِعتكر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69774&r=&rc=15",""],[20,"أَبلِغ خليلي عند هند فلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=70013&r=&rc=35",""],[18,"جَارَتْ بَنُو بَكْرٍ وَلَمْ يَعْدِلُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26453&r=&rc=19",""]],"verses":[["أَبلِغ أَميرَ المُؤمِنينَ رِسالَةً","رَوعاءَ نافِرَةً عَنِ الأَقرانِ",0,"ن",1,0],["أَبلِغ عَلى النَأيِ قَومي إِن حَلَلتَ هِمِ","أَنّي عَميدٌ بِما يَلقونَ أَسوانُ",1,"ن",1,0],["أَبلى أَزِمَّتَها بُعدُ المَدى وَغَدَت","مِنَ الوَجى بَينَ مَعقولٍ وَمَرسونِ",2,"ن",1,0],["أَبلِغ قُوَيماً كَثُروا قِلَّةً","بَعدَ مُضِيِّ السَلَفِ الراحِلِ",3,"ل",1,0],["أَبلِغ فَتى حَمدٍ مُذَكَّرَةً","تَنقَدُّ مِنها البيضُ وَالزَغَفُ",4,"ف",1,0],["أَبلِغ ظِباءَ الحَيِّ أَنَّ فُؤادَهُ","قَطَعَ العَلاقَةَ وَاِرعَوى لِلزاجِرِ",5,"ر",1,0],["أَبلَجُ إِن صاحَتِ المَطِيُّ بِهِ","فَدى التَنائي بِعَيشَةِ الرَغَدِ",6,"د",1,0],["أَبلِغا عَنّي الحُسَينَ أَلوكاً","إِنَّ ذا الطَودَ بَعدَ عَهدِكَ ساخا",7,"خ",2,1],["أبلغَنْ صَحْبي بِها مَمْحوضَةً","ناظَرَ المِسْكَ شَذاها فانْقَطَعْ",8,"ع",1,0],["أَبلِغ حُصَيناً إِذا جِئتَهُ","جَواباً وَمَوعِظَةً لَكَ فيها",9,"ي",3,1],["أَبلِغ أَبا الجارودِ عَنّي رِسالَةً","أَفي كُلِّ قَولٍ قُلتُهُ أَنتَ آخِذُ",10,"ذ",1,1],["أَبلِغ أَبا الجارودِ عَنّي رِسالَةً","يَروحُ بِها الماشي لِقاءَكَ أَو يَغدو",11,"و",1,1],["أَبلِغ بَني قَيسٍ إِذا لاقَيتَهُم","وَالحَيَّ ذُهلاً هَل بِكُم تَعيِيرُ",12,"ر",1,1],["أَبلِغ يَزيدَ بَني شَيبانَ مَألُكَةً","أَبا ثُبيتٍ أَما تَنفَكُّ تَأتَكِلُ",13,"ل",1,0],["أَبلَيتَ فيها بَلاءَ المُخلِصينَ لَها","وَكانَ سَهمُكَ أَنّى رِشتَ فَتّاكا",14,"ك",2,0],["أَبَلَغتَ تَسبيحَ المَلا","ئِكِ أَو دَنَوتَ مِنَ السِرار",15,"ر",1,0],["أَبلى الشَقاءُ جَديدَهُ","وَتَقَلَّمَت مِنهُ الأَظافِر",16,"ر",1,0],["أَبلِغ رِسالَتِيَ الصَفِيَّ وَقُل لَهُ","كَيفَ اِستَحالَ صَفاؤُهُ وَتَكَدَّرا",17,"ر",2,1],["أَبلِغهُمُ عَنّي السَلامَ وَقُل لَهُم","أَحبابَنا هذا الصُدودُ إِلى مَتى",18,"ت",2,0],["أَبلِغ سُبَيعاً إِن عَرَضتَ رِسالَةً","أَنّي كَهَمِّكَ إِن عَشَوتَ أَمامي",19,"م",2,0],["أَبٌ لَكَ راضَ المُلكَ حَتّى أَذَلَّهُ","وَحَتّى اِطمَأَنَّت بِالرِجالِ الزَلازِلُ",20,"ل",1,0],["ابلغْ سليماً وعوفاً انْ لقيتهمُ","عمِيمَة ً من نِداءٍ غيرِ إسرارِ",21,"ر",1,0],["أَبلِغ مَوالِيَهُ فَقَد رُزِئوا","مَولىً يَريشُهُمُ وَلا يَشري",22,"ي",1,0],["أَبْلِغْ وَدِيعَتَنَا إِلَى أَحْبابِنَا","وَاحْمِلْ تَحِيَّتَنَا إِلَى الأَوْطَانِ",23,"ن",1,0],["أُبلِغتُ عنكِ تَبَدّلاً","وأَتَى بِذَلِكِ مُؤتَمَن",24,"ن",1,0],["أبلغ بني وطني عنّي مُغَلغَلةً","في طيّها كلم في طيّها ضَرَم",25,"م",1,0],["أَبلِغ خَليفَتَنا إِن كُنتَ لاقِيَهُ","أَنّي لَدى البابِ كَالمَصفودِ في قَرَنِ",26,"ن",1,0],["أَبلى بِبُرجَمَةَ المَخوفِ بِها الرَدى","أَيّامَ مُحتَسِبِ البَلاءِ مُجاهِدِ",27,"د",1,0],["أَبلى مُعاوِيَةُ البَلاءَ وَلَم يَزَل","مَيمونَ مَنقَبَةٍ تَراهُ مُسَدَّدا",28,"د",2,0],["أَبلِغ بَني وَقبانَ أَنَّ نِساؤُهُم","خورٌ بَناتُ مُوَقَّعٍ خَوّارِ",29,"ر",1,0],["أَبلِغ أَبا هُرمُزٍ عَنّي مُغَلغَلَةً","وَاِبنَي حُدَيَّةَ صُعروراً وَفِرناسِ",30,"س",1,1],["أَبلِغ رِياحاً مُردَها وَكُهولَها","عَنّي وَعَمِّم فيهِمُ وَتَخَصَّصِ",31,"ص",1,1],["أَبلِغ بَني وَقبانَ أَنَّ حُلومَهُم","خَفَّت فَما يَزِنونَ حَبَّةَ خَردَلِ",32,"ل",1,0],["أَبلِغ هَدِيَّتِيَ الفَرَزدَقَ إِنَّها","ثِقَلٌ يُزادُ عَلى حَسيرٍ مُثقَلِ",32,"ل",1,0],["أَبلَيتُمُ خَوَراً وَفَكَّ عُناتَكُم","عاري الأَشاجِعِ مِن بَني هَمّامِ",33,"م",1,0],["أَبلِغِ الحارِثَ بنِ عَمروٍ بِأَنّي","حافِظُ الوُدِّ مُرصِدٌ لِلصَوابِ",34,"ب",1,1],["أَبلِغ بَني لَأمٍ بِأَنَّ خُيولَهُم","عَقرى وَأَنَّ مِجادَهُم لَم يَمجُدِ",35,"د",1,1],["أَبلِغ بَني ثُعَلٍ بِأَنّي لَم أَكُن","أَبَداً لِأَفعَلَها طِوالَ المُسنَدِ",35,"د",1,0],["أَبلِغ بَني ثُعَلٍ عَنّي مُغَلغَلَةً","جَهدَ الرِسالَةِ لا مَحكاً وَلا بُطُلا",36,"ل",2,0],["أبلغ يزيد وإسماعيل مألكة","ومنذراً وأباه شرَّ إِستارِ",37,"ر",1,1],["أَبلِغ بَني حَمدانَ في بُلدانِها","كُهولَها وَالغُرَّ مِن شُبّانِها",38,"ن",3,1],["أَبلِغ لَدَيكَ بَني العَبّاسِ مَألُكَةٌ","لا تَدَّعوا مُلكَها مُلّاكُها العَجَمُ",39,"م",1,0],["أَبلِغهُ عَنّي ما أَقو","لُ فَأَنتَ مَن لايُتَّهَم",40,"م",1,0],["أَبلِغ عُبَيداً بِأَنَّ الفَخرَ مَنقَصَةٌ","في الصالِحينَ فَلا يَذهَب بِكَ الجَذَلُ",41,"ل",1,1],["أَبلِغ هَوازِنَ أَعلاها وَأَسفَلَها","أَن لَستُ هاجِيَها إِلّا بِما فيها",42,"ي",3,1],["أَبلِغ بَني عَمرٍ بِأَنَّ أَخاهُمُ","شَراهُ اِمرُؤٌ قَد كانَ لِلغَدرِ لازِما",43,"م",2,1],["أَبلِغ مُعاوِيَةَ اِبنَ حَربٍ مَألُكاً","وَلِكُلِّ أَمرٍ يُستَرادُ قَرارُ",44,"ر",1,1],["أَبلِغ بَني بَكرٍ إِذا ما جِئتَهُم","ذَمّاً فَبِئسَ مَواضِعُ الإِصهارِ",45,"ر",1,0],["أَبلِغ رَبيعَةَ وَاِبنَ أُمِّهِ نَوفَلاً","أَني مُصيبُ العُظمِ إِن لَم أَصفَحِ",46,"ح",1,1],["أَبلِغ بَني عامِرٍ عَنّي مُغَلغَلَةً","وَقَد تَجيءُ مَعَ الرُكبانِ أَخبارُ",47,"ر",1,1],["أَبلِغ بَني بَكرٍ وَخَصَّ فَوارِساً","لُحِفوا المَلامَةَ دونَ كُلِّ لِحافِ",48,"ف",1,0],["أبلج ما ردَّ إليها الحيا","إلاَّ بشمِّ الآس في رده",49,"د",2,0],["أبلى له السقمُ لمَّا طالَ بعدكم","جسماً أبى العهدُ أن يبلي سرائره",50,"ر",2,0],["أبْلغ أبا سهلٍ فتى العَجَم الذي","أضحتْ تَمنَّى كونَهُ منها العَرَبْ",51,"ب",1,1],["أبلغْ فتى آل بشرٍ بل مؤمَّلهُمْ","رسالةً ليس في أمثالها عارُ",52,"ر",1,1],["أبْلِها في طاعة اللَّ","ه وجدِّد ألف دار",53,"ر",1,0],["أبلغا خالداً بأنك لا الشت","م ولا الكَلْمُ في أديمِك عَبْط",54,"ط",1,0],["أبلج يجلو بضوء غرته","ونور تقواه حالك السُّدَف",55,"ف",1,0],["أبْلِها خُلَّةً برغمِ عدوٍّ","جعلَ اللَّهُ خدَّهُ لك نعلا",56,"ل",2,0],["أبلجِ الوجهِ كالهلالِ بلِ البد","رِ بل الشمس بل فقيدِ المثالِ",57,"ل",1,0],["إبليس إن كنتَ من المُنْظرينْ","وكُنتَ لا تهلكُ في الهالكينْ",58,"ن",1,1],["أبلغْ أباكَ إذا هلكتَ وقلْ لهُ","يا مُقْصِيَ القوم الكرامِ إذا دنَوا",59,"ن",3,1],["أَبلِغ أَبا الدَردامِ إِن لاقَيتَهُ","بِالرَقَّةِ البَيضاءِ أَو حَرّانِ",60,"ن",1,1],["أَبلِغ أَميرَ المُؤمِنينَ رِسالَةً","جَزاءَ بِنُعمى قَبلَها وَوَسيلِ",61,"ل",1,1],["أَبلِغ عِكَبّاً وَأَشياعَها","بَني عامِرٍ أَنَّني ظالِعُ",62,"ع",1,1],["أَبلى بَلاءَ كَريمٍ لَن يَزالَ لَهُ","مِنهُ بِعاقِبَةٍ مَجدٌ وَمُفتَخَرُ",63,"ر",1,0],["أَبلِغ بَني عَوفٍ بِأَنَّ جَنابَهُم","عَلى كُلِّ آلاءِ الزَمانِ مَريعُ",64,"ع",1,1],["أَبلِغ بَني نَهشَلٍ عَنّي مُغَلغَلَةً","أَنَّ الحِمى بَعدَهُم وَالثَغرَ قَد ضاعا",65,"ع",2,0],["إِبليسُ يا شَيخَ الزَبانِيَةِ الأُلى","كانوا الأَخداني مِنَ الأَخدانِ",66,"ن",1,0],["أَبلَيتُها وَبَقَيتُ إِلّا أَنَّني","لِلشَوقِ كادَ غِيابُكُم يَبليني",67,"ي",1,0],["أَبلِغ لَدَيكَ عامِراً إِن لَقيتَها","فَقَد بَلَغَت دارُ الحِفاظِ قَرارَها",68,"ر",3,1],["أَبلِغ أَميرَ المُؤمِنينَ رِسالَةً","شَكوى إِلَيكَ مُطِلَّةً وَعَويلا",69,"ل",2,0],["ابليس ما اشركتني في صفقة","الا قضيت على بالافلاس",70,"س",1,0],["ابليس انت ولي كل ذوي الهوى","ابليس انك في الولاية قاس",70,"س",1,0],["ابلغ بما ادلى به من حجة","لما تكلم دامياً ذاك الفم",71,"م",1,0],["أَبلى ظُبى الدَهرِ وَفَلَّ حَدَّها","وَأَخلَقَ العُصورَ وَاِستَجَدَّها",72,"د",3,0],["أَبلَيتِ في نَزعِ السِها","مِ بَلاءَ دَهرِكِ في الرِمايَه",73,"ا",3,0],["أُبلَغُ فيها وَهيَ عَدلٌ وَرَحمَةٌ","وَيَترُكُها النُسّاكُ في الخَلَواتِ",74,"ت",1,0],["أَبلَت مَوَدَّتَها اللَيالي بَعدَنا","وَمَشى عَلَيها الدَهرُ وَهوَ مُقَيَّدُ",75,"د",1,0],["أَبلَجَ لَو عاذَتِ الحَمامُ بِهِ","ما خَشِيَت رامِياً وَلا صائِد",76,"د",1,0],["أَبلَغُ ما يُطلَبُ النَجاحُ بِهِ ال","طَبعُ وَعِندَ التَعَمُّقِ الزَلَلُ",77,"ل",1,0],["أَبلى الهَوى أَسَفاً يَومَ النَوى بَدَني","وَفَرَّقَ الهَجرُ بَينَ الجَفنِ وَالوَسَنِ",78,"ن",1,1],["أَبلى الأَجِلَّةَ مُهري عِندَ غَيرِكُمُ","وَبُدِّلَ العُذرُ بِالفُسطاطِ وَالرَسَنُ",79,"ن",1,0],["أَبلِغ أَبا الفَضلِ تُبلِغ خَيرَ أَصحابِه","في فَضلِ أَخلاقِهِ المُثلى وَآدابِه",80,"ب",2,1],["أَبلِغ أَميرَكَ وَهوَ غايَةُ كُلِّ ذي","أَمَلٍ وَمَورِدُ كُلِّ عافٍ قارِبِ",81,"ب",1,0],["أَبلِغ أَبا صالِحٍ إِمّا مَرَرتَ بِهِ","رِسالَةً مِن قَتيلِ الماءِ وَالراحِ",82,"ح",1,1],["أَبلِغ لَدَيكَ عُبَيدَ اللَهِ مَألِكَةً","وَما بِدارِ عُبَيدِ اللَهِ مِن بُعُدِ",83,"د",1,1],["أَبلِغ أَبا العَبّاسِ حَيثُ أَحَلَّ مَن","حَلَبٍ مَكانَ الغَيثِ فينا الماطِرِ",84,"ر",1,0],["أَبلى صَديقَيكَ الصَديقُ إِذا اِهتَدى","لِتَغَيُّرِ الأَيّامِ فيكَ تَغَيَّرا",85,"ر",2,0],["أَبلِغ أَبا الحَسَنِ الَّذي لَبِسَ النَدى","لِلخابِطينَ فَكانَ خَيرَ لِباسِ",86,"س",1,0],["أَبلَتِ الريحُ وَالرَوائِحُ وَالأَيّا","مُ مِنهُ مَعالِماً أَو طُلولا",87,"ل",2,0],["أَبلِغ أَبا حَسَنٍ بِآيَةِ جودِهِ","عِندي وَنِعمَتِهِ الَّتي لا تُجهَلُ",88,"ل",1,1],["أَبلِغ أَبا إِسحاقَ تُبلِغُ لاغِباً","في المَكرُماتِ مُعَذَّلاً وَمُلَوَّما",89,"م",2,0],["أَبلِغ أَبا حَسَنٍ وَكُنتُ أَعُدُّهُ","مِن بَينِهِم قَمَناً مِنَ الإِحسانِ",90,"ن",1,1],["أَبلِغ ذُفافِيَّنا رِسالَةَ مُش","تاقٍ أَسرَّ الشَكوى وَأَعلَنَها",91,"ن",3,1],["أَبلَغَتنا مُحَمَّداً فَحَمِدنا","حُسنَ ذاكَ المَرئِيِّ وَالمَسموعِ",92,"ع",1,0],["أَبلِغ بَني بَكرٍ إِذا ما لَقيتَهُم","وَمَن فيهُمُ مِن مُلزَقٍ أَو مُعَلهَجِ",93,"ج",1,1],["أَبلِغ أَميرَ المُؤمِنينَ رِسالَةً","فَعَجِّل هَداكَ اللَهُ نَزعَكَ خالِدا",94,"د",2,1],["أَبلِغ زِياداً إِذا لاقَيتَ جيفَتَهُ","أَنَّ الحَمامَةَ قَد طارَت مِنَ الحَرَمِ",95,"م",1,1],["أَبلِغ أَبا دَوُودَ أَنّي اِبنُ عَمِّهِ","وَأَنَّ البَعيثِ مِن بَني عَمِّ سالِمِ",96,"م",1,1],["أَبلِغ مُعاوِيَةَ الَّذي بِيَمينِهِ","أَمرُ العِراقِ وَأَمرُ كُلَّ شَآمِ",97,"م",1,1],["أَبلِغ لَدَيكَ بَني الصَيداءَ كُلَّهُمُ","أَنَّ يَساراً أَتانا غَيرَ مَغلولِ",98,"ل",1,1],["أَبلِغ بَني نَوفَلٍ عَنّي فَقَد بَلَغوا","مِنّي الحَفيظَةَ لَمّا جاءَني الخَبَرُ",99,"ر",1,1],["أَبلِغِ الجامِعَ أَن لَو قَد أَتى","يَومُهُ لَم يُغنِ عَنهُ ما جَمَع",100,"ع",1,0],["أَبلَغَ الدَهرُ في مَواعِظِهِ بَل","زادَ فيهِنَّ لي عَلى الإِبلاغِ",101,"غ",1,0],["أَبلِغ سَلِمتَ أَبا الوَليدِ سَلامي","عَنّي أَميرَ المُؤمِنينَ إِمامي",102,"ي",1,1],["أَبلَغَكُم أَنّي جَحَدتُ حُبِّكُم","أَصابَ في اللَفظِ وَأَخطا المَعنى",103,"ن",2,0],["أَبلَجُ غَضُّ الشَبابِ مُقتَبِلُ ال","عُمرِ وَلَكِنَّ مَجدَهُ هَرِمُ",104,"م",1,0],["أَبلَجُ لا يَخسَرُ مَن أَمَّهُ","يَوماً وَلا يَخسَرُ ميزانُه",105,"ن",2,0],["أَبلى الظَلامَ وَماذا لَو يَجودُ بِهِ","عَلى جُفونٍ لِطيبِ الغُمضِ لَم تَذُقِ",106,"ق",1,0],["أَبلَيتَ فيهِ الدينَ يُمنَ نَقيبَةٍ","تَرَكَت إِمامَ الكُفرِ وَهوَ أَميمُ",107,"م",1,0],["أُبلِيتُ مِنهُ مَوَدَّةً عَبدِيَّةً","راشَت نِبالي كُلَّها بِنِبالِهِ",108,"ل",2,0],["أَبلَيتَ هَذا المَجدَ أَبعَدَ غايَةٍ","فيهِ وَأَكرَمَ شيمَةٍ وَنِحاسِ",109,"س",1,0],["أَبَلِّهِم ريقاً وَكَفّاً لِسائِلٍ","وَأَنضَرِهِم وَعداً إِذا صَوَّحَ الوَعدُ",110,"د",1,0],["أَبلِغ مُحَمَّداً المُلقي كَلاكِلَهُ","بِأَرضٍ خُشَّ أَمامَ القَومِ قَد لُبِجا",111,"ج",2,0],["أَبلَى عَلِيٌّ بِهِ خَيرَ البَلاءِ بِما","حَباهُ ذُو العَرشِ مِن بَأسٍ وَمِن هِمَمِ",112,"م",1,0],["أبلغَ اللهُ تعالى روحَها","من سلامي نشْرَ مسْكٍ أذفرا",113,"ر",2,0],["إبلُ السحائبِ هِيَّجٌ في جوِّها","وغمامُها كالقوسِ طارَ نديفُهُ",114,"ه",1,0],["أَبلِغ سُلَيمى بِأَنَّ البَينَ قَد أَفِدا","وَاِنبِئ سُلَيمى بِأَنّا رائِحونَ غَدا",115,"د",2,1],["أَبلى عِظامَكَ بَعدَ اللَحمِ ذِكرُكَها","كَما يُنَحِّتُ قِدحَ الشَوحَطِ الباري",116,"ي",1,0],["أَبلِغ ضُيوفَكَ حينَ يَشهَدُ جَمعُهُم","كَرَمَ الشُعوبِ يَزينُ شَعبَ النيلِ",117,"ل",1,1],["أَبِلالُ أَذِّنْ للصّلاةِ فإنّها","أسنى وأشرفُ ما يُحبُّ المسلم",118,"م",1,0],["أبِلحْيَةِ المختارِ تُمسك إنّها","لَتُصانُ في حَرَمِ الجلالِ وَتُعصَم",118,"م",1,0],["إِبِلي سِيري وأُمِّي يثرباً","واطلبي ليثَ الوغَى في غابِهِ",119,"ه",1,0],["إبليسُ أعلن صاغراً إفلاَسه","لمَّا تحقَّق عنده إغراؤها",120,"ا",3,0],["أَبلِغ أَبا سُفيانَ وَالنَفسُ تَنطَوي","عَلى عُقَدٍ بَينَ الحَشا وَالجَوانِحِ",121,"ح",1,1],["أَبلِغ سَراةَ بَني سَعدٍ مُغَلغَلَةً","جَهدَ الرِسالَةِ لا أَلتاً وَلا كَذِبا",122,"ب",2,0],["أَبلِغ بَني عَبسٍ بِأَنَّ نِجارَهُم","لُؤمٌ وَأَنَّ أَباهُمُ كَالهِجرِسِ",123,"س",1,0],["أَبلى الهَوى وَالوَجدُ سِلكَ دُموعِهِ","فَإِذا نَجِيُّ الفِكرِ حَرَّكَهُ وَهى",124,"ه",2,0],["أَبُلُّ مِنْ طَيْبَةٍ بالدَّمْعِ طِيبَ ثَرىً","لَغُلَّتِي وغَلِيلِي منه تُبْلِيلُ",125,"ل",1,0],["أبلِغْ أميرَ المؤمنينَ على النّوَى","قَوْلاً يُريهِ نَصيحتي ومكاني",126,"ن",2,0],["أبِلغْ ربيعةَ عن ذي الحيِّ من يمَنٍ","أنّا نُؤلِّفُ شَمْلاً ليس يَفترِقُ",127,"ق",1,1],["أُبلَيتُ صَبراً لَم يُبلِهِ أَحَدٌ","وَاِقتَسَمَتني مَآرِبٌ شُعَبُ",128,"ب",1,0],["أَبلِغ هُديتَ إِلى الإِمامِ رِسالَةً","عَنّي بِأَنّي بَعدَها أَستَعتِبُ",129,"ب",1,0],["إِبِلٌ تُركَبُ حَتّى","قامَ لِلإِصباحِ داعِ",130,"ع",1,0],["أَبلِغ هَواكَ مِنَ الغِنا","وَالكَأسِ وَاِغنَ عَنِ الزَمانِ",131,"ن",1,0],["إِبليسُ خَيرٌ مِن أَبيكُم آدَمٍ","فَتَنَبَّهوا يا مَعشَرَ الفُجّارِ",132,"ر",1,1],["إِبليسُ مِن نارٍ وَآدَمُ طينَةٌ","وَالأَرضُ لا تَسمو سُمُوَّ النارِ",132,"ر",1,0],["أَبلَيتِ وُدّي وَأَجَدَدنا مَوَدَّتَكُم","شَتّانَ بالٍ وَمَن يَزدادُ إِجدادا",133,"د",2,0],["أَبلِغ سُراةَ بَني الحُصَينِ بِأَنَّني","قَلَّدتُهُم مِدَحي وكُنتُ وَدودا",134,"د",2,0],["أَبلَيتِ جِسمي فَنَفسي غَيرُ آمِنَةٍ","أَن يُدرِكَ الروحَ ما قَد خامَرَ الجَسَدا",135,"د",2,0],["آبَ لَيلي لَيتَ لَيلي لَم يَأُب","إِنَّما اللَيلُ عَناءٌ لِلوَصِب",136,"ب",1,1],["آبَ لَيلي بَعدَ السُلُوِّ بِعَتبِ","مِن حَبيبٍ أَصابَ عَيني بِسَكبِ",137,"ب",1,1],["أَبلِغ بَني ذُبيانَ أَن لا أَخا لَهُم","بِعَبسٍ إِذا حَلّوا الدِماخَ فَأَظلَما",138,"م",2,1],["أَبلَستُ مِن وَساوِسِ حَليٍّ خِلتُهُ","إِبليسَ وَسوسَ في صُدورِ الناسِ",139,"س",1,0],["أبلّ به الدّجى مِن كلّ سُقْمٍ","وكوْكَبُهُ مريضٌ ما يُعادُ",140,"د",1,0],["أَبلِغ قَتادَةَ غَيرَ سائِلِهِ","مِنهُ الثَوابَ وَعاجِلَ الشَكمِ",141,"م",1,0],["أَبلِغ جُذاماً وَلَخماً إِن عَرَضتَ بِهِم","وَالقَومُ يَنفَعُهُم عِلمٌ إِذا عَلِموا",142,"م",3,1],["أَبلِغ أَبا كَرِبٍ عَنّي وَأُسرَتَهُ","قَولاً سَيَذهَبُ غَوراً بَعدَ إِنجادِ",143,"د",1,0],["أَبلِغ خَلِيلَي الَّذي تَجَهَّمَني","ما أَنا عَن غِيّهِ بِمنُصَرِمِ",144,"م",1,0],["أَبلِغ قُشَيرا وَالحَرِيشَ فَما","ذا رَدَّ في أَيدِكُمُ شَتمي",145,"م",2,0],["أَبلِغْ معاويةَ المُصغي لقولهِما","أني كفرتُ بما قالا وما فَعلا",146,"ل",2,0],["ابلُ الرجال بكل أرض أوَّلاً","ثم انتخب منهم على اِستحقاق",147,"ق",1,1],["أَبلى بإخفاق","أَمنى بإنفاض",148,"ض",1,0],["أبلغ إلى صبري التحية والهوى","عنا وحي جبينه الوضاحا",149,"ح",2,0],["إبِلاً ما أخَذْتَ بالنَّثْرَةِ الحَصْ","داءِ يا خُسْرَ بائِعٍ مَحْرُوبِ",150,"ب",1,1],["أُبِلُّ من الأمراضِ والعِلمُ واقعٌ","بعِلّةِ يوْمٍ جانَبَتْ كلَّ إبلال",151,"ل",1,0],["أبْلى وِدادي لكمْ زَمانٌ","ألْيَنُ أحْداثِهِ حَديد",152,"د",1,0],["أبْلَجُ مِن بعض قِرَى ضَيْفِه ال","أمْنُ إذا لم يأمَنِ المُحْرِمُ",153,"م",1,0],["أَبلِغِ الِفتيانَ مَألُكَةً","نُصحَةً مِنِّي وأَخبارا",154,"ر",2,0],["أَبلغِ النُّعمانَ عنِّي مَألُكاً","قَولَ مَن خافَ أظطِناناً فاعتَذَر",155,"ر",1,0],["أَبلِغ خَليلي عَبدَ هِندٍ فَلاَ","زِلتَ قَريباً مِن سَوادِ الخُصُوص",156,"ص",1,1],["أَبلِغَا عامِراً وأَبلِغ أَخَاهُ","أَنَّني مُوثَقٌ شَديدٌ وثَاقِي",157,"ق",2,0],["أَبلغ أَبَا قابُوسَ إذ جَلَّزَ ال","نَّزعَ وَلم يُؤخَذ لِخَطِّي يَسَر",158,"ر",1,1],["أَبلِغِ النُّعمانَ عَنِّي مَالُكاً","أَنَّهُ قَد طالَ حبَسي وانتظاري",159,"ي",1,0],["أَبلِغ أُبَيّاً عَلَى نَأيِهِ","وهَل يَنفَعُ الَمرءَ ما قَد عَلِم",160,"م",1,1],["أَبْلَتْنِيَ الحَسَراتُ حَتَّى لَمْ يَكَدْ","جِسْمِي يَلُوحُ لأَعْيُنِ الْعُوَّادِ",161,"د",1,0],["أَبْلَغْتَهُ أَجَلاً وَلَكِنْ كَمْ بِهِ","لِمَكَارِمِ الأَخْلاَقِ مِنْ آجَالِ",162,"ل",1,0],["أَبِلاَ مُبَالاَةٍ ولاَ أَسَفٍ","وَبِلاَ مُجَافَاةٍ وَلاَ صَدِّ",163,"د",1,0],["أَبْلَغَتْ حَافِظاً مِنَ الحَظِّ أَوْجاً","زَادَ مِنْهُ العَلْيَاءَ كًلَّ مَزَادِ",164,"د",1,0],["أَبْلَيْتَ وَالصَّالِحِينَ فِي ك","لِّ مَوْقِفٍ أَحْسَنَ البَلاَءِ",165,"ا",2,0],["أَبْلَغُ النَّاطِقَاتِ بِالضَّادِ عَبَّتْ","بَعْدَ أَنْ أَدَّتِ البَلاغَ المُبِينَا",166,"ن",2,0],["أَبْلِغْ بِمَا أَفْرَغْتَ فِي تِمْثَالِ","مِنْ مَأْرَب غَالٍ وَمَعْنّى عَالِ",167,"ل",1,1],["أَبْلَيْتَهَا وَشَبَابُها خَلَقٌ","فَأَلْبَسْ شبَاباً خَالِداً نَضْرَا",168,"ر",2,0],["أَبْلغ السَّابقينَ أَزْكَى التَّحيا","ت منَ اللاَّحقينَ في ميعَاد",169,"د",1,0],["أَبْلَى بَلاَءَ الأَبْسَلِينَ فَلَمْ يَقَعْ","إِلاَّ عَلَى شَجَبٍ هُنَالِكَ شَاجِبِ",170,"ب",1,0],["أبلغْ قُضاعة في القِرطاس أنًهمُ","لولا خلائفُ دين الله ما عًتِقُوا",171,"ق",3,1],["أَبْلِغْ قُرَيشاً وخَيْرُ القولِ أصْدَقُهُ","والصّدْقُ عندَ ذَوي الألْبَابِ مَقْبُولُ",172,"ل",1,1],["اَبْلِغْ أُبيّاً أنَّهُ فَالَ رَأْيُهُ","وَحَانَ غَدَاةَ الشّعْبِ والحَيْنُ واقعُ",173,"ع",1,1],["أبلغُ الشعرِ دمعةٌ تتلَظّى","فوق خدّ لا صفحةٌ في كتابِ",174,"ب",1,0],["أبْلِغْ أحبَّتَنا الباكينَ من جِهتِي","أنِّي حَمْتِني أُسُودٌ حِمْيَرِيَّاتُ",175,"ت",1,1],["أَبلغُ الوَعظِ أَن تَرى اليَومَ عَيني","خَلِقاً مَن رَأَتهُ أَمس قَشيبا",176,"ب",2,0],["أَبلغ في القَولِ حُجَّةً وَحجىً","وَهوَ اِبنُ تِسعٍ فَكَيفَ لَو بَلَغا",177,"غ",2,0],["أبْلَى صلاحُ الدين فيه بجحفلٍ","يجدُ الشَّهادَةَ بالمجاهدِ ألْيَقَا",178,"ق",2,0],["أبلغ بني جحشٍ بأنّ نجارهم","لؤمٌ وأنّ أباهمُ كالهجرس",179,"س",1,0],["آبَ لَيْلِي لَيْتَ لَيْلِي لَمْ يَؤُبْ","إنما الليل عناء للوصب",180,"ب",1,1],["أبلى صَديقَكَ الصّديقُ، إذا اهتَدَى","لتَغَيّرِ الأيّامِ فيكَ، تَغَيّرا",181,"ر",2,0],["أبْلَتِ الرّيحُ وَالرّوَائحُ وَالأيّا","مُ مِنْهُ مَعَالِماً وَطُلُولا",182,"ل",2,0],["أبْلِغْ أبَا داودَ أني ابنُ عَمِّهِ،","وَأنّ البَعِيثَ مِنْ بَني عَمّ سَالِمِ",183,"م",1,1],["أبلغْ أميرَ المؤمنينَ رسالة","ً شَكْوَى إلَيْكَ مُظِلَّة ً وَعَوِيلاَ",184,"ل",2,0],["أبٌ لرعية السلطان بَرٌّ معاشُ","الناس في كنفَيْه رغدُ",185,"د",1,0],["أبلغ بثينة أني لست ناسيها","ما عشت حتى تجيب النّفس داعيها",186,"ه",2,1],["أبلغْ أبَا نفرٍ حديثاً، وقلْ لهُ",": يأنِّي لمْ أسمَعْ بهِ قولَ كاشحِ",187,"ح",1,1],["أَبْلِغْ سُلَيْمى بِأَنَّ البَيْنَ قَدْ أَفِدا","وأنْبِىء ْ سُلَيْمَى بِأَنَّا رَائِحونَ غَدا",188,"د",2,1],["أَبلِغِ النُعمانَ عَنّي مَألَكاً","فَولَ مَن قَد خافَ ظَنّاً فَاِعتَذَر",189,"ر",1,0],["أَبلِغ خَليلي عِندَ هِندٍ فَلا","زِلتَ قَرباً مِن سَوادِ الخُصوص",190,"ص",1,1],["أبلغْ بني شيبانَ عنا فقدْ","أَضْرَمْتُمُ نِيْرَانَ حَرْبٍ عَقُوقْ",191,"ق",1,0]]}