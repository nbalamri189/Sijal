{"poems":[[95,"نادي الشبيبة بين أندية الحمى","https://www.aldiwan.net/poem11473.html","الكامل"],[80,"قبر الغريب سقاك الرائح الغادي","https://www.aldiwan.net/poem14236.html","البسيط"],[30,"صيداء شأمية حرف كمشترف","https://www.aldiwan.net/poem5496.html","البسيط"],[46,"يا ربع لو ربعوا على ابن هموم","https://www.aldiwan.net/poem30351.html","الكامل"],[7,"بالدر والياقوت زين نحرها","https://www.aldiwan.net/poem1950.html","الكامل"],[70,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[92,"المجلس المفجوع","https://www.poetsgate.com/ViewPoem.aspx?id=179038",""],[164,"سود العيون أم المواضي البيض","https://www.aldiwan.net/poem58917.html","الكامل"],[201,"حي الأساتذة الكرام تحية","https://www.aldiwan.net/poem39949.html","الكامل"],[275,"صافح من العرب الأمجاد أحبابا","https://www.aldiwan.net/poem35654.html","البسيط"],[447,"دع الخمول وخل المقت والكبلا","https://www.aldiwan.net/poem14430.html","البسيط"],[495,"ذهب الذين عهدتُ أمس برأيهم","https://www.aldiwan.net/poem660.html",""],[556,"عرج على الدارسة القفر","https://www.aldiwan.net/poem47777.html","الرجز"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53951","السريع"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130165","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62499","الرمل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126145","الرجز"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26521","الرجز"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102133","المنسرح"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87321","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87326","الرجز"],[3437,"","https://poetry.dctabudhabi.ae/diwan/poem/102028","البسيط"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61261","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135868","الرجز"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40122","الرجز"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119667","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54388","الرجز"],[4767,"إباء الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=179960",""],[4772,"الصرخة","https://www.poetsgate.com/ViewPoem.aspx?id=190713",""],[5002,"القصيدة الباكية","https://www.poetsgate.com/ViewPoem.aspx?id=204939",""],[5038,"الحدباء تناديني","https://www.poetsgate.com/ViewPoem.aspx?id=195227",""],[5055,"وين العرب","https://www.poetsgate.com/ViewPoem.aspx?id=104395",""],[585,"أين القصائد أفوافاً توشيها","https://www.poetsgate.com/ViewPoem.aspx?id=161879",""],[5075,"قلبي على أمتي","https://www.poetsgate.com/ViewPoem.aspx?id=196818",""],[5198,"في نصرة رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=135209",""],[5206,"أرض الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=187396",""],[5397,"بكيت شجواً على الأطلال والدمن","https://www.poetsgate.com/ViewPoem.aspx?id=157909",""],[5461,"بنت الكحيلة","https://www.poetsgate.com/ViewPoem.aspx?id=5038",""],[5561,"الجمرُ صبرُ النار","https://www.poetsgate.com/ViewPoem.aspx?id=195029",""],[5612,"رَبّاه","https://www.poetsgate.com/ViewPoem.aspx?id=204400",""],[5894,"بدت مبرقعة في حسنها العربي","https://www.poetsgate.com/ViewPoem.aspx?id=131411",""],[5956,"خريف حبك","https://www.poetsgate.com/ViewPoem.aspx?id=182012",""]],"verses":[["بِالدِّينِ وَالتَّقْوَى تُرَاضُ نُفُوسُهُمْ","وَخَلاَئِقٍ مَحْمُودَةٍ وَخِصَالِ",0,"ل",1,0],["بالدَهر في نِقَم بِالبَحر في نِعَمٍ","بِالبَدرِ في ظُلمٍ بِالصَدرِ في النادي",1,"د",2,0],["بِالدَحلِ كُلَّ ظَلامٍ لا تَزالُ لَهُ","حَشرَجَةٌ أَو سَحيلٌ بَعدَ تَدويمِ",2,"م",1,0],["بِالداذَوَيهِ وَخَيزَجٍ وَذَواتِها","عَهدٌ لِسَيفِكَ لَم يَكُن بِذَميمِ",3,"م",1,0],["بِالدُرِّ وَالياقوتِ زَيَّنَ نَحرَها","وَمُفَصَّلٍ مِن لُؤلُؤٍ وَزَبَرجَدِ",4,"د",1,1],["بالدُّنَى لا تْطمَعَنْ في مَصْرِفي","عنُهَما فضلاً بما في مِصرَفي",5,"ي",1,0],["بالدِّعَايَاتِ وَالسِّعَايَاتِ حَاموا","حَوْلَهَا لِلسِّوَامِ أَوْ لِلرِّوَادِ",6,"د",1,0],["بالدمع يَسألُ عن غيابك سائلٌ","في المجلسَين وبالدموعِ يُجاب",7,"ب",1,0],["بالدين والدنيا كفلت فلم ينل","جفنيك عن حقيهما تغميضُ",8,"ض",1,0],["بالدينِ قد نالَ الجودُ مناهمُ","وغدوا وربي بهجةَ الأزمان",9,"ن",1,0],["بالدينِ والشرعِ ثم النطقِ ما برحوا","بعد الخلافةِ أسياداً وأربابا",10,"ب",2,0],["بالدار دار وبالجيران لي بدل","وبالكلا ومراعيه وجدت كلا",11,"ل",2,0],["بِالدارِعينَ كَأَنَّها عُصَبُ القَطا ال","أَسرابِ تَمعَجُ في العَجاجِ وَتَمزَع",12,"ع",1,0],["بالدّار ظلماً غيرُ سكّانها","وقد قرى من لم يكن يَقْرِي",13,"ر",2,0],["بالدِّمْنَةِ الغَرَّاءِ مِنْ بَسْطَةٍ","أدْوَاحُ أعْنابٍ تَرْوقُ العُيُونْ",14,"ن",1,1],["بالدير يوما ويوماً بالامام وبال","شاروق يوماً ويوماً عين صفراء",15,"ا",2,0],["بالدما أغرا دموعي","بُلبُلٌ في الدوح غرَّدْ",16,"د",1,0],["بالدرهم المضروب والدينار","حاجاتكم تقضى كحرق النار",17,"ر",1,0],["بِالدينِ وَالدُنيا وَبِالتَنزيلِ","خَليفَةٌ كَجَعفَرَ المَأمولِ",18,"ل",1,0],["بالدنيا والجنان","احوزُ للمواهِب",19,"ب",1,0],["بالدَّاسِجَينِ الشَّكِّ والجامورِ","لِيَشحَطَ الداسجُ بالتَّمريرِ",20,"ر",1,0],["بالدِّيَرِ المَعلُومةِ المحكومَه","على مَسَافَاتٍ لها مَقسُومَه",21,"ه",1,0],["بالدين معتصم بالصدق ملتزم","بالعدل متسم بالحق محتكم",22,"م",1,0],["بِالدين وَالدُنيا وَفي أَهليهما","نَقصٌ وَأَنتَ لِنقصهنّ مكمِّلُ",23,"ل",1,0],["بالدالِ والذال وراءٍ وبزا","اغفرْ لنا وغِثْ لنا وعزِّزا",24,"ز",2,0],["بِالدّينِ وَالدّنيا الَّذي يَشكو وَهَل","يَهتَزُّ فَرعٌ لَم يُقِمْهُ ساقُ",25,"ق",1,0],["بالدين والدنيا تفوز وفوده","غيث يمدّ الناس من بحرين",26,"ن",1,0],["بالدِّين والملكِ له قيامهُ","وللملوكِ عنها قعودُها",27,"د",3,0],["بالدين تلبسه عباءةَ عابدٍ","وهي التي لذوي النهى تستحقر",28,"ر",1,0],["بالدينِ فاستتروا والكفرُ دينكمُ","إبليسُ يخلع في أبوابكمْ سِترَهْ",29,"ر",2,0],["بالدَّمعِ ناحتْ قلوبٌ للهوى قَنَتَتْْ","والدَّمع لوْ سالَ إلّا الحزنَ يَصْنعُه",30,"ع",2,0],["بِالدِّينِ كَمْ تاجَروا وَالعَصْرُ شاهِدُهُ","ما أَهْمَلوا الرِّجَسَ مِنْ فِعْلِ الْمَلاعِينِ",31,"ن",1,0],["بالدين الله عزكم","وانتم تجاهلتوا وعود",32,"د",1,0],["بالدمع تطفئ منها بعض غلتها","وبالصبابة أحياناً تداويها",33,"ي",3,0],["بِالدِّينِ يَهْزَأُ أَوْغَادٌ وَيَتْبَعُهُمْ","مَا كُنْتَ تَحْسَبُهُمْ لِلدِّينِ حَامِينَا",34,"ن",2,0],["بالدين دونك والقلم والسيوفي","نصد الانذال العلوج الخنازير",35,"ر",1,0],["بِالدُّرِّ واليَاقُوتِ فُصِّلَ شَعْرُهَا","ومَكَلَلٌّ بِزَبَرجَدٍ ومُرَصَّعُ",36,"ع",1,0],["بالدين شكت فشكت من كنانتها","سبعين سهماً لجسم السبط في الكفن",37,"ن",1,0],["بالدين تفخر عزوتي","والرمح والسيف الصقيل",38,"ل",1,0],["بالدين يهدم ديننا ليردَّنا","كي نعبدَ النيران والأحجارا",39,"ر",2,0],["بالدَّمْعِ جاءكَ يا إلهي راجِياً","والرُّوحُ تضْرَعُ والجَوارِحُ تسْجُدُ",40,"د",1,0],["بالدمع جادت عيوني حينما هجرت","كما تجود يد المصري ذي الرتب",41,"ب",1,0],["بالدمع والقمع أُقُصي سحنةً قمراً","عزَّت على القلب يومَ الحُبُّ أمَّلهُ",42,"ل",2,0]]}