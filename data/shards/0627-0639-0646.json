s://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[485,"أدر المدامة يا نديم إلى الصباح","https://www.aldiwan.net/poem24333.html","عموديه"],[503,"من خلف مسدل ستر الغيب لاح لنا","https://www.aldiwan.net/poem38084.html","البسيط"],[517,"لله منزلها على الروحاء","https://www.aldiwan.net/poem20827.html","الكامل"],[518,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"],[518,"سأبكي على ابني مدتي وحياتي","https://www.aldiwan.net/poem12039.html","الطويل"],[518,"إذا لم يكن بين القلوب صدود","https://www.aldiwan.net/poem12062.html","الطويل"],[518,"أيا أذن الأيام إن قلت فاسمعي","https://www.aldiwan.net/poem12176.html","الطويل"],[518,"أمعتسف المهامه والموامي","https://www.aldiwan.net/poem12250.html","الوافر"],[532,"أعن ذكرها يسلو الفؤاد المبلبل","https://www.aldiwan.net/poem37271.html","الطويل"],[532,"أعني به الحسن بن يحيى من غدا","https://www.aldiwan.net/poem37385.html","الكامل"],[532,"لله في خلقه ما شاء من نظر","https://www.aldiwan.net/poem37425.html","البسيط"],[543,"أعن تغنت على ساق مطوقة","https://www.aldiwan.net/poem56845.html","الطويل"],[554,"ألا غاد دمع العين إن كنت غاديا","https://www.aldiwan.net/poem47140.html","الطويل"],[554,"أمن أجل من سارت بهن الأباعر","https://www.aldiwan.net/poem47825.html","الطويل"],[554,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[561,"إن الحروف إشارات المداد فلا","https://www.aldiwan.net/poem33579.html","البسيط"],[561,"خذها إليك لها هدى وبيان","https://www.aldiwan.net/poem33803.html","الكامل"],[561,"عدم يحيط به الوجود وإنما","https://www.aldiwan.net/poem34075.html","الكامل"],[561,"قلب المحقق واجد بل فاقد","https://www.aldiwan.net/poem34597.html","الكامل"],[565,"في ظل سلطاننا عبد العزيز بنى","https://www.aldiwan.net/poem52535.html","الطويل"],[565,"لم يبق شكرك في فؤادي موضعا","https://www.aldiwan.net/poem52760.html","الكامل"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[579,"أطردتني حذر الهجاء ولا","https://www.aldiwan.net/poem1778.html","أحذ الكامل"],[589,"تداركه قبل البين فاليوم عهده","https://www.aldiwan.net/poem17487.html","الطويل"],[590,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"],[590,"دع للعبرات تنسجم انسجاما","https://www.aldiwan.net/poem11522.html","عموديه"],[652,"","https://poetry.dctabudhabi.ae/diwan/poem/216903","الطويل"],[745,"","https://poetry.dctabudhabi.ae/diwan/poem/67404","السريع"],[752,"","https://poetry.dctabudhabi.ae/diwan/poem/205800","الكامل"],[858,"","https://poetry.dctabudhabi.ae/diwan/poem/95985","الرجز"],[1006,"","https://poetry.dctabudhabi.ae/diwan/poem/202182","الطويل"],[1137,"","https://poetry.dctabudhabi.ae/diwan/poem/18205","المتقارب"]],"verses":[["أَعِنَّةُ الفُرسانِ أَعرافُها","عَجلى عَنِ المُسرَجِ وَالمُلجَمِ",0,"م",1,0],["أَعِنِ المَقادِرَ لا تَكُن هَبّابَةً","وَتَأَزَّرِ اليَومَ العَصَبصَبَ وَاِرتَدِ",1,"د",1,0],["أَعَنتُم عَلى حَربي المَقاديرَ عَنوَةً","وَرِشتُم إِلى قَلبي سِهامَ الحَوادِثِ",2,"ث",1,0],["أَعِنّي عَلى دَهرٍ رَماني بِصَرفِهِ","وَرَدَّ عِناني وَهوَ في الغُلَواءِ",3,"ا",2,0],["أعِنّي على دهْرٍ تَكادُ خُطوبُهُ","تُبَلِّغُ مَنْ يَضْرَى بِنا ما تَوَقَّعا",4,"ع",2,0],["أَعني الَّتي مَن أَراه اللَهُ صورَتَها","نالَ الخُلودَ فَلَم يَهرَم وَلَم يَشِبِ",5,"ب",1,0],["أَعِندَكَ عُلمُ الغَيبِ أَم لَستَ مُخبِري","عَنِ الحَيِّ إِلّا بِالَّذي قَد بَدا لِيا",6,"ي",2,0],["أعِنْدَكَ عبْدَ اللهِ عِلْمٌ بأنّني","رَمى الصّبْرُ منّي للأسى بقِيادِهِ",7,"د",2,0],["أَعِنّي عَلى بَرقٍ أَراهُ وَميضِ","يُضيءُ حَبِيّاً في شَماريخَ بيضِ",8,"ض",1,1],["أَعِنّي عَلى التَهمامِ وَالذِكَراتِ","يَبِتنَ عَلى ذي الهَمِّ مُعتَكِراتِ",9,"ت",1,0],["أَعِندكُم نَبَأ مِن أَهلِ أَندَلُسٍ","فَقَد سَرى بِحَدِيثِ القَومِ رُكبَانُ",10,"ن",1,0],["أعني الذينَ إلَيْهِمْ كانَ منزلُهُ","هل تَعرِفونَ ذمامَ الضّيفِ والجارِ؟",11,"ر",1,0],["أَعني الَّذي نَصَرَ النَبِيَّ مُحَمَّداً","قَبلَ البَرِيَّةِ ناشِئاً وَوَليدا",12,"د",2,0],["أَعني الَّذي كَشَفَ الكُروبَ وَلَم يَكُن","في الحَربِ عِندَ لِقائِها رِعديدا",12,"د",2,0],["أَعني المُوَحِّدَ قَبلَ كُلِّ مُوَحِّدٍ","لا عابِداً وَثَناً وَلا جُلمودا",12,"د",2,0],["أَعِنِّي عَلى بَيضَاءَ تَنكَلُّ عَن بَرَد","وتَمشِي عَلى هَونٍ كَمِشيَةِ ذِي الحَرَد",13,"د",1,1],["أَعَن تَرَسَّمتَ مِن خَرقاءَ مَنزِلَةً","ماءُ الصَبابَةِ مِن عَينَيكَ مَسجومُ",14,"م",1,1],["أَعنَقُ مُقوَرُّ السَراةِ أَوعَرُ","ماشَينَهُ وَالقَصدُ عَنهُ أَزوَرُ",15,"ر",1,0],["أعندك أن العلم والحلم والحجى","وزهرَ الحلى قد أُدرجت طيَّ مَلْحَدِ",16,"د",1,0],["أعنّي على ما لو تحقَّق كونُه","لما كان لي بل للأناسِيّ مُسعدا",17,"د",2,0],["أَعناقَ عاطِيَةِ الغُصونِ جَوازِئٍ","يَبحَثنَ بِالأَدَمى عُروقَ الحُلَّبِ",18,"ب",1,0],["أَعَنّاباً تُجاوِرُ حينَ أَجنَت","نَخيلُ أَجاً وَأَعنُزَهُ الرُبابا",19,"ب",2,0],["أَعِندَكَ لي عُتبى فَأَحمِلَ مامَضى","وَأَبني رُواقَ الوُدِّ إِذ أَنتَ هادِمُه",20,"م",2,0],["أَعني الرَسولَ فَإِنَّ اللَهَ فَضَّلَهُ","عَلى البَرِيَّةِ بِالتَقوى وَبِالجودِ",21,"د",1,0],["أَعني النَبِيَّ أَخا التَكَرُّمِ وَالعُلى","وَأَبَرَّ مَن يولي عَلى الأَقسامِ",22,"م",1,0],["أعني العلاء الذي لم يجرِ في أمدٍ","إلَّا وفات إلى القصوى ولم يُفَتِ",23,"ت",1,0],["أعني المُسَمَّى باسم أصدقِ واعِدٍ","وَعْداً ذَبيحَ الله خَيْرَ ذبيحِ",24,"ح",1,0],["أعِنْدِي مُنقضُّ الصواعق منكما","وعند ذوِي الكفر الحيا والثرى الجعدُ",25,"د",1,0],["أعني سليمانَ الذي","في رَمسهِ قمرٌ وشِيرُ",26,"ر",1,0],["أعني أبا النجم فتى أحمدٍ","إمام أهل البدو والحضرهْ",27,"ر",2,0],["أعنِي أبا عبد الإله ولا تقلْ","أعنتُ فأعياني القضاء المقدر",28,"ر",1,0],["أعني عبيد الله خير فتى","بالحق ما في ذاك من لبَس",29,"س",1,0],["أعني أبا الصقر إنه ملك","في منصب للعيون مشتَرف",30,"ف",1,0],["أعِنَّتُها الشسوعُ فإن عراها","حِفاءُ الكدِّ أنعلها طراقا",31,"ق",2,0],["أعني عبيد اللَّه خيرَ عبيده","إلا أئمتنا العظامَ جراثما",32,"م",2,0],["أعنْ مثل ذاك الحرِّ تَستَلْفتينني","إلى كُلِّ عبد الخيمِ وغدِ الشكائمِ",33,"م",1,0],["أعْنيكَ يا من سِواه تلحَقُ التهمُ","يا واحد الفهم إذْ للواهم الوهَمُ",34,"م",1,1],["أَعِنّي أَميرَ المُؤمِنينَ بِنائِلٍ","وَحُسنِ عَطاءٍ لَيسَ بِالرَيِّثِ النَزرِ",35,"ر",1,0],["أَعِندَكَ إِن غِبتَ عَن ناظِري","مَشَيتُ مِنَ الصُبحِ في حِندِسِ",36,"س",1,0],["أَعَندَ اللَهِ لِلبَرقِ اليَماني","يُضيءُ حَبِيَّ ذي سَقطَينِ داني",37,"ي",1,1],["أَعنِّي عَلى نَفسي بِتَزويد أَسهلي","بَلى وَقُل فَلا شَيء عَلَيك حَرامُ",38,"م",1,0],["أَعِن ظُعُنِ الحَيِّ الأُلى كُنتَ تَسأَلُ","بِلَيلٍ فَرَدّوا عيرَهُم وَتَحَمَّلوا",39,"ل",3,0],["أَعَن إِذني تَهُبُّ الريحُ رَهواً","وَيَسري كُلَّما شِئتُ الغَمامُ",40,"م",1,1],["أعني الأمير الذي لهيبته","يخفق قلب الرضيع في خِرَقِهْ",41,"ق",2,0],["أَعَنتَ عَلى عَبدِ العَزيزِ وَرَهطِهِ","وَشيعَتِهِ مِن أَعجَمِيٍّ وَمُفصِحِ",42,"ح",1,0],["أَعِنّا عَلى يَومَ نُشَيِّعُ لَهوَنا","إِلى لَيلَةٍ فيها لَهُ أَجَلٌ مُردِ",43,"د",1,0],["أَعِن عَلى كَرَمٍ أَخنى عَلى نَشَبي","وَهِمَّةٍ أَخلَقَت أَثوابِيَ الجُدُدا",44,"د",2,0],["أَعني اِبنَ مَن فَقَأَت في الرِحمِ مُقلَتَها","فَياشِلٌ لِأُناسٍ غَيرِ أَحرارِ",45,"ر",1,0],["أَعِناقُ اللِقاءِ أَثلَمُ في الأَح","شاءِ وَالقَلبِ أَم عِناقُ الوَداعِ",46,"ع",1,0],["أَعَن واجِبٍ أَلا يُسامِحَ جانِبٌ","مِنَ العَيشِ إِلّا جانِبٌ يَتَمَنَّعُ",47,"ع",1,0],["أَعَن دُوَلٍ في العُصبَتَينِ تَعاقَبَت","فَما نَقَّلُ الحالاتِ نَقلَ التَداوُلِ",48,"ل",1,0],["أَعِنّي عَلى عَينٍ قَليلٍ هُجودُها","عَصَت وَعَلى قَلبٍ كَثيرٍ بَلابِلُه",49,"ل",2,0],["أَعَن سَفَهٍ يَومَ الأُبَيرَقِ أَم حِلمِ","وُقوفٌ بِرَبعٍ أَو بُكاءٌ عَلى رَسمِ",50,"م",1,1],["أَعِن جِوارِ أَبي إِسحاقَ تَطمَعُ أَن","تُزيلَ رَحلِيَ يا بُهلَ بنَ بُهلانا",51,"ن",2,1],["أَعِنّي أَبانَ بنَ الوَليدِ بِدَفقَةٍ","مِنَ النيلِ أَو كَفَّيكَ يَجري عُبابُها",52,"ب",3,0],["إعناقُ عبدِ الله في طُرُقِ العُلى","والنَّحلُ تُعْنِقُ فَضلَه في الباطلِ",53,"ل",1,0],["أَعَنِ الأَهِلَّةِ في الدَّياجِرِ","سفَرَت لنا والبَينُ سَافِرْ",54,"ر",1,1],["أَعَنْ وَسَنٍ تَرْنو إليَّ عيونُها","أَمِنْ سَكَرِ مالَتْ عليَّ قُدودُها",55,"د",3,0],["أَعَن كُلِّ أَخدانٍ وَإِلفٍ وَلَذَّةٍ","سَلَوتَ وَما تَسلو عَنِ اِبنَةِ مُدلِجِ",56,"ج",1,1],["أَعني عَلِيّاً وَاِبنُ عَمِّ مُحَمَّدٍ","مَن نالَهُ الشَرَفُ الرَفيعُ الأَنسَبُ",57,"ب",1,0],["أَعِنِ الخائِفَ وَارحَم صَوتَهُ","رافِعاً نَحوَكَ يَدعوكَ يَدا",58,"د",2,0],["أَعَنكُم نَفى الرِجسَ أَم عَنهُمُ","لِطُهرِ النُفوسِ وَأَلبابِها",59,"ب",3,0],["أعَنْ أرضكمْ يغنيكمُ أرضُ غيركم","وكم خالةٍ جَدّاءَ لم تُغْنِ عن أمِّ",60,"م",1,0],["أعِناقُ البُهَمِ استَحسَنتَهُ","وهو بَرْدٌ أم عِتاقُ الجُرُدِ",61,"د",1,0],["أَعِندَكَ الشَمسُ قَد راقَت مَحاسِنُها","وَأَنتَ مُشتَغِلُ الأَحشاءِ بِالقَمَرِ",62,"ر",1,0],["أَعِنّي أُفَرِّق شَملَ دَمعي فَإِنَّني","أَرى الشَملَ مِنهُم لَيسَ بِالمُتَقارِبِ",63,"ب",1,0],["أعناقُ عذّالي مدققةٌ","ومفاصلُ الرقباءِ مدفونَهْ",64,"ه",1,0],["أَعِندَكَ عِلمُ الغَيبِ أَم أَنتَ مُخبِري","عَنِ الحَيِّ إِلّا بِالَّذي قَد بَدا لِيا",65,"ي",2,0],["أعندك أنا لم ندع بعدك الوجدا","وأنا ظننا الصبر يجدي فما أجدى",66,"د",2,1],["أَعن حقِّ مصرَ ودستورِها","ننامُ وقد نشط الواغل",67,"ل",1,0],["أعن خطبِ الخلافةِ تسألينا","أجيبي يا فَروقُ فتىً حزينا",68,"ن",2,1],["أَعَن أَمرِ الوُشاةِ قَتَلتَ نَفساً","تَساقَطُ حَسرَةً وَدَماً مُراقا",69,"ق",2,0],["أعِنِّي بروحٍ منكَ يا ربِّ واهدِني","سَبيلَكَ إنْ أضللتَ في النّاسِ شاعرا",70,"ر",2,0],["أعندك أن السّحرَ للّهِ غالبٌ","تأمَّلْ لبيدٌ أيَّ مهوىً تُشارِفُ",71,"ف",1,0],["أَعني أَبا العَبّاسِ خَيرَ الخَلقِ","لِلمَلكِ قَولُ عالِمٍ بِالحَقِّ",72,"ق",1,0],["أَعني غُلاماً لِسَعيدِ الأَعوَرا","قَد كانَ في الحُروبِ مَوتاً أَحمَرا",72,"ر",2,0],["أَعِنّي بِالوِصالِ فَدَتكَ نَفسي","فَقَد بَلَغَ الهَوى بي مُنتَهاهُ",73,"ه",1,0],["أعْنِي أَبا الحَسَنِ الإِمامَ المُجْتَبَى","مِنْ هَاشِمٍ والشَّاذِليَّ المَوْلِدِ",74,"د",1,0],["أعِنّي على الليل ليلِ التّمامِ","ودعني لشاني إذا ما انقضَى",75,"ا",1,0],["أَعِندي تَطلُبُ النَيكَ","وَنَيكُ الرَجُلِ النُكرُ",76,"ر",1,0],["أَعَن ذَنبٍ وَلا وَاللَهِ","ما أَحدَثتُ مِن ذَنبِ",77,"ب",1,0],["أَعِن باكِياً لَجَّ في حِزنِهِ","وَسَل ضاحِكَ القَومِ مِمَّ اِبتَهَج",78,"ج",1,0],["أَعَن واقِدٍ خَبَّرَتني وَاِبنُ جَمرَةٍ","وَآلِ شَهابِ خامِدٌ كُلُّ واقِدِ",79,"د",1,1],["أَعني بِذالِكَ أَنَّهُ لي مُؤمِنٌ","مِن كُلِّ رُزءٍ في حَياتي أَثَرا",80,"ر",2,0],["أَعَن عُفرٍ تُلِمُّ بِسِربِ عُفرِ","وَتَغفِرُ في الشَكاةِ لِأُمِّ غُفرِ",81,"ر",1,1],["أَعِن بِجَميلٍ إِذا ما حَضَرتَ","وَعِد بِالسُكوتِ إِذا لَم تُعِن",82,"ن",1,0],["أعَن وَخْدِ القِلاصِ كشَفْتِ حالا","ومن عِند الظّلام طَلَبتِ مالا",83,"ل",2,1],["أعندها مثلُ فتنتي","أم انني أفْترِي عليها",84,"ه",2,0],["أعند الطبيعةِ هذا الدلالُ","وفي دِفئِها مثلُ هذا الحنانْ",85,"ن",1,0],["أعندي وقد مارسْتُ كلَّ خَفِيّةٍ","يُصَدّقُ واشٍ أو يُخَيّبُ سائِل",86,"ل",1,0],["أعندَ هُمُ علْمُ السّلُوّ لِسائلٍ","به الرّكْبَ لم يَعْرِفْ أماكنَه قَطّ",87,"ط",1,0],["أَعِنِّي عَلَى قَوْلٍ حَكِيمٍ تَصُوغُ لِي","مَعَانِيَهُ دُرّاً وَمَبْنَاهُ عَسْجَدَا",88,"د",2,0],["أَعْنِي مَقَالَةَ كَاشِحٍ","فِي قَدْرِكَ الْعَالِي يُرِيبُ",89,"ب",1,0],["أَعَنْ سَبْقِ إِحْسَاسٍ بِمَا كَانَ مُضْمِراً","زَمَانُكَ آثَرْتَ النَّوَى حِين تُؤْثِرُ",90,"ر",1,0],["أعن الإِغريِض أم البَرَدِ","ضَحِكَ المتعجّبُ مِنْ جَلَدِي",91,"ي",1,1],["أَعنت نَفسي ذي عَنتٍ","لِضَجيعٍ حَلَّ لي وَحَلا",92,"ل",2,0],["أَعَن عَبد الغنيّ غِنىً وَفيهِ","تَناهَت غمَّةُ المَجدِ الطَموحُ",93,"ح",1,0],["أعني الخليلي امام المسلمين ومن","دهى الكوائن من منعاه ما دهما",94,"م",2,0],["اعند رجال الاستقامة انهم","أصيبوا بقطب المسلمين وأيتموا",95,"م",3,0],["أعنِّي وطهِّرني وخلِّص حقيقتي","إليك وأيِّد نورَ سرِّي ومعناء",96,"ا",2,0],["أعِنْدكُمُ عِلْمٌ بما يَفْعَلُ الهَوى","إذا اسْتَنَّ دَمْعُ العيْنِ فوقَ مَصَبِّه",97,"ب",2,0],["أَعِندِي لِعينيكَ يا مَوطني","سِوى الحَرفِ أُعطِيهِ سَكبًا وغَرفْ!",98,"ف",1,0],["أعندَ نسائنا منهمْ عهودٌ","بأنَّهُمُ يجيدونَ الدِّفاعا",99,"ع",2,0],["أعندك علم أنني من معاشر","أبوهم جنى واختار أدنى المسالك",100,"ك",1,0],["أعَنْ دُوَلٍ في العُصْبَتَينِ تَعَاقَبَتْ،","فَمَا نَقَلَ الحلاتِ نَقْلَ التّداوُلِ",101,"ل",1,0],["أعني بذلكَ أنّهُ لي مؤمِنٌ","مِنْ كلّ رُزْءٍ، في حَياتي أثرا",102,"ر",2,0],["أعني ابن بنت بائع الزِّرْنيخ","تلك التي تعْرفُ بالتَّكْمِيخ",103,"خ",1,0],["أَعنِّي عَلى نَفسي بِتَزويد أَسهلي","بَلى وَقول لا شَي عَلَي حَرامُ",104,"م",1,0],["أعناقَ عاطية ِ العصونِ جوازئٍ","يبحنَ بالأدمى عروقٌ الحلب",105,"ب",1,0],["أَعني بِهِ مَولايَ عَبد اللَهِ مِن","أَوصافَهُ تُغني عَن التعَريف",106,"ف",1,0],["أَعِني بِهِ المَولى الأَجلّ أَبا البقا","مِن ظَنِهِ في الدَهر مثل يَقينِهِ",107,"ن",2,0],["أَعني بِهذا مالَهُ مِن مَنزِلَه","وَعَكسُه جَوابُه كالمسأَله",108,"ه",1,0],["اعن كبر تعمدت انقطاعي","ولذ لديك هذا الانفصال",109,"ل",1,0],["أعني به الوالِي الممجد أحمدَ","العاتي علَى من ديُنه عصيانُه",110,"ن",2,0],["أعنى الإمام اليعربيّ","الحوّلَ الملكَ القويمَا",111,"م",2,0],["أعني بذلك راشداً نسلَ الفتَى","خَلَف بن راشدٍ العقيدِ السَّامِى",112,"م",2,0],["أَعْنِي به الفَطِنَ اللبيبَ المرتضَى","وأخَا الرضىّ أهل النجَارِ السَّابقِ",113,"ق",1,0],["أعنى أبا العربِ الهما","مَ ابنَ الهُمامِ الغالبِ",114,"ب",1,0],["أَعَنِ الرَشادِ تَلَوُّمٌ وَتَأَخُّرٌ","وَإِلى الفَسادِ تَقَدُّمٌ وَتَسَرُّعُ",115,"ع",1,0],["أُعَنِّفُ فيها صَبوَةً قَطُّ ما اِرعَوَت","وَأَسأَلُ عَنها مَعلَماً ما تَكَلَّما",116,"م",2,0],["أَعَنتَ السَيفَ مُنصَلِتاً بِرَأيٍ","إِذا أَشهَدتَهُ الحَربَ الزَبونا",117,"ن",2,0],["أعني الألى صرح الحفاظ ذكرهم","باسمهم تاركا من خلفهم بانا",118,"ن",2,0],["أَعِنِّي عَلَى تَأْدِيبِ دَمْعِي فَإِنَّهُ","يَتُوبُ إِذا ما كُنْتَ أَنْتَ مُعِينِي",119,"ن",2,0],["أعنه على ما أنت ترضاه وارضه","عن الخلق وارض عنه وزد في ما",120,"م",2,0],["أعنّي لا تضيعني لمن لا","يبالي أَن يحل فناهُ عارُ",121,"ر",1,0],["أعندك علمٌ أم أقولُ فأطربُ","وأشرح حالي باختصار فأطنبُ",122,"ب",1,1],["أعنْ حبها أسلو ويوم لقيتها","على الشِّعبِ قالت قد أضرَّبَك الهجرُ",123,"ر",1,0],["أعن مللٍ خيالكُ لا يطيف","وكنت أظنُّ هجرك لا يحيفُ",124,"ف",1,1],["أعني جهولاً غره شيطانه","بوميض برق وهو برقٌ خلبُ",125,"ب",1,0],["أعني الرسول المنتقى السامي ابن من","ملكوا الملوك ودوخوا البلدانا",126,"ن",2,0],["أعنت فيه كما قال النبي ومن","يسئل فذاك إلى ما ناله وكلا",127,"ل",2,0],["أَعَنِ الشَمسِ عِشاءً","كُشِفَت تِلكَ السُجوفُ",128,"ف",1,1],["أَعني الأَميرَ أَبا عَلِيٍّ ذا العُلى","مُردي العِدى وَمُقَطِّرِ الأَقرانِ",129,"ن",1,0],["أَعِندَ العَبِّ فِي عَذبِ بَرُودٍ","أُحَلأُ قَبلَ رَيِّي عَن وُرُودٍ",130,"د",1,1],["أَعِنِّى عَلَى بَرقٍ أُرِيكَ وَمِيضَهُ","تُضِىء دُجُنَّاتِ الظَّلامِ لَوامِعُه",131,"ع",2,1],["أَعناقكُم لَهُمُ رقٌّ وَما لَكُمُ","بَينَ الدُّمى وَالطُّلا وَالنردُ مُنتَهبُ",132,"ب",1,0],["أعني فلسطيناً وكيف أمين","نُها وجنودُه وبقيّةُ السكّانِ",133