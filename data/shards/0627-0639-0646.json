","https://www.aldiwan.net/poem38084.html","البسيط"],[514,"لله منزلها على الروحاء","https://www.aldiwan.net/poem20827.html","الكامل"],[515,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"],[515,"سأبكي على ابني مدتي وحياتي","https://www.aldiwan.net/poem12039.html","الطويل"],[515,"إذا لم يكن بين القلوب صدود","https://www.aldiwan.net/poem12062.html","الطويل"],[515,"أيا أذن الأيام إن قلت فاسمعي","https://www.aldiwan.net/poem12176.html","الطويل"],[515,"أمعتسف المهامه والموامي","https://www.aldiwan.net/poem12250.html","الوافر"],[529,"أعن ذكرها يسلو الفؤاد المبلبل","https://www.aldiwan.net/poem37271.html","الطويل"],[529,"أعني به الحسن بن يحيى من غدا","https://www.aldiwan.net/poem37385.html","الكامل"],[529,"لله في خلقه ما شاء من نظر","https://www.aldiwan.net/poem37425.html","البسيط"],[540,"أعن تغنت على ساق مطوقة","https://www.aldiwan.net/poem56845.html","الطويل"],[551,"ألا غاد دمع العين إن كنت غاديا","https://www.aldiwan.net/poem47140.html","الطويل"],[551,"أمن أجل من سارت بهن الأباعر","https://www.aldiwan.net/poem47825.html","الطويل"],[551,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[558,"إن الحروف إشارات المداد فلا","https://www.aldiwan.net/poem33579.html","البسيط"],[558,"خذها إليك لها هدى وبيان","https://www.aldiwan.net/poem33803.html","الكامل"],[558,"عدم يحيط به الوجود وإنما","https://www.aldiwan.net/poem34075.html","الكامل"],[558,"قلب المحقق واجد بل فاقد","https://www.aldiwan.net/poem34597.html","الكامل"],[562,"في ظل سلطاننا عبد العزيز بنى","https://www.aldiwan.net/poem52535.html","الطويل"],[562,"لم يبق شكرك في فؤادي موضعا","https://www.aldiwan.net/poem52760.html","الكامل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"أطردتني حذر الهجاء ولا","https://www.aldiwan.net/poem1778.html","أحذ الكامل"],[586,"تداركه قبل البين فاليوم عهده","https://www.aldiwan.net/poem17487.html","الطويل"],[587,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"],[587,"دع للعبرات تنسجم انسجاما","https://www.aldiwan.net/poem11522.html","عموديه"]],"verses":[["أَعِنَّةُ الفُرسانِ أَعرافُها","عَجلى عَنِ المُسرَجِ وَالمُلجَمِ",0,"م",1,0],["أَعِنِ المَقادِرَ لا تَكُن هَبّابَةً","وَتَأَزَّرِ اليَومَ العَصَبصَبَ وَاِرتَدِ",1,"د",1,0],["أَعَنتُم عَلى حَربي المَقاديرَ عَنوَةً","وَرِشتُم إِلى قَلبي سِهامَ الحَوادِثِ",2,"ث",1,0],["أَعِنّي عَلى دَهرٍ رَماني بِصَرفِهِ","وَرَدَّ عِناني وَهوَ في الغُلَواءِ",3,"ا",2,0],["أعِنّي على دهْرٍ تَكادُ خُطوبُهُ","تُبَلِّغُ مَنْ يَضْرَى بِنا ما تَوَقَّعا",4,"ع",2,0],["أَعني الَّتي مَن أَراه اللَهُ صورَتَها","نالَ الخُلودَ فَلَم يَهرَم وَلَم يَشِبِ",5,"ب",1,0],["أَعِندَكَ عُلمُ الغَيبِ أَم لَستَ مُخبِري","عَنِ الحَيِّ إِلّا بِالَّذي قَد بَدا لِيا",6,"ي",2,0],["أعِنْدَكَ عبْدَ اللهِ عِلْمٌ بأنّني","رَمى الصّبْرُ منّي للأسى بقِيادِهِ",7,"د",2,0],["أَعِنّي عَلى بَرقٍ أَراهُ وَميضِ","يُضيءُ حَبِيّاً في شَماريخَ بيضِ",8,"ض",1,1],["أَعِنّي عَلى التَهمامِ وَالذِكَراتِ","يَبِتنَ عَلى ذي الهَمِّ مُعتَكِراتِ",9,"ت",1,0],["أَعِندكُم نَبَأ مِن أَهلِ أَندَلُسٍ","فَقَد سَرى بِحَدِيثِ القَومِ رُكبَانُ",10,"ن",1,0],["أعني الذينَ إلَيْهِمْ كانَ منزلُهُ","هل تَعرِفونَ ذمامَ الضّيفِ والجارِ؟",11,"ر",1,0],["أَعني الَّذي نَصَرَ النَبِيَّ مُحَمَّداً","قَبلَ البَرِيَّةِ ناشِئاً وَوَليدا",12,"د",2,0],["أَعني الَّذي كَشَفَ الكُروبَ وَلَم يَكُن","في الحَربِ عِندَ لِقائِها رِعديدا",12,"د",2,0],["أَعني المُوَحِّدَ قَبلَ كُلِّ مُوَحِّدٍ","لا عابِداً وَثَناً وَلا جُلمودا",12,"د",2,0],["أَعِنِّي عَلى بَيضَاءَ تَنكَلُّ عَن بَرَد","وتَمشِي عَلى هَونٍ كَمِشيَةِ ذِي الحَرَد",13,"د",1,1],["أَعَن تَرَسَّمتَ مِن خَرقاءَ مَنزِلَةً","ماءُ الصَبابَةِ مِن عَينَيكَ مَسجومُ",14,"م",1,1],["أَعنَقُ مُقوَرُّ السَراةِ أَوعَرُ","ماشَينَهُ وَالقَصدُ عَنهُ أَزوَرُ",15,"ر",1,0],["أعندك أن العلم والحلم والحجى","وزهرَ الحلى قد أُدرجت طيَّ مَلْحَدِ",16,"د",1,0],["أعنّي على ما لو تحقَّق كونُه","لما كان لي بل للأناسِيّ مُسعدا",17,"د",2,0],["أَعناقَ عاطِيَةِ الغُصونِ جَوازِئٍ","يَبحَثنَ بِالأَدَمى عُروقَ الحُلَّبِ",18,"ب",1,0],["أَعَنّاباً تُجاوِرُ حينَ أَجنَت","نَخيلُ أَجاً وَأَعنُزَهُ الرُبابا",19,"ب",2,0],["أَعِندَكَ لي عُتبى فَأَحمِلَ مامَضى","وَأَبني رُواقَ الوُدِّ إِذ أَنتَ هادِمُه",20,"م",2,0],["أَعني الرَسولَ فَإِنَّ اللَهَ فَضَّلَهُ","عَلى البَرِيَّةِ بِالتَقوى وَبِالجودِ",21,"د",1,0],["أَعني النَبِيَّ أَخا التَكَرُّمِ وَالعُلى","وَأَبَرَّ مَن يولي عَلى الأَقسامِ",22,"م",1,0],["أعني العلاء الذي لم يجرِ في أمدٍ","إلَّا وفات إلى القصوى ولم يُفَتِ",23,"ت",1,0],["أعني المُسَمَّى باسم أصدقِ واعِدٍ","وَعْداً ذَبيحَ الله خَيْرَ ذبيحِ",24,"ح",1,0],["أعِنْدِي مُنقضُّ الصواعق منكما","وعند ذوِي الكفر الحيا والثرى الجعدُ",25,"د",1,0],["أعني سليمانَ الذي","في رَمسهِ قمرٌ وشِيرُ",26,"ر",1,0],["أعني أبا النجم فتى أحمدٍ","إمام أهل البدو والحضرهْ",27,"ر",2,0],["أعنِي أبا عبد الإله ولا تقلْ","أعنتُ فأعياني القضاء المقدر",28,"ر",1,0],["أعني عبيد الله خير فتى","بالحق ما في ذاك من لبَس",29,"س",1,0],["أعني أبا الصقر إنه ملك","في منصب للعيون مشتَرف",30,"ف",1,0],["أعِنَّتُها الشسوعُ فإن عراها","حِفاءُ الكدِّ أنعلها طراقا",31,"ق",2,0],["أعني عبيد اللَّه خيرَ عبيده","إلا أئمتنا العظامَ جراثما",32,"م",2,0],["أعنْ مثل ذاك الحرِّ تَستَلْفتينني","إلى كُلِّ عبد الخيمِ وغدِ الشكائمِ",33,"م",1,0],["أعْنيكَ يا من سِواه تلحَقُ التهمُ","يا واحد الفهم إذْ للواهم الوهَمُ",34,"م",1,1],["أَعِنّي أَميرَ المُؤمِنينَ بِنائِلٍ","وَحُسنِ عَطاءٍ لَيسَ بِالرَيِّثِ النَزرِ",35,"ر",1,0],["أَعِندَكَ إِن غِبتَ عَن ناظِري","مَشَيتُ مِنَ الصُبحِ في حِندِسِ",36,"س",1,0],["أَعَندَ اللَهِ لِلبَرقِ اليَماني","يُضيءُ حَبِيَّ ذي سَقطَينِ داني",37,"ي",1,1],["أَعنِّي عَلى نَفسي بِتَزويد أَسهلي","بَلى وَقُل فَلا شَيء عَلَيك حَرامُ",38,"م",1,0],["أَعِن ظُعُنِ الحَيِّ الأُلى كُنتَ تَسأَلُ","بِلَيلٍ فَرَدّوا عيرَهُم وَتَحَمَّلوا",39,"ل",3,0],["أَعَن إِذني تَهُبُّ الريحُ رَهواً","وَيَسري كُلَّما شِئتُ الغَمامُ",40,"م",1,1],["أعني الأمير الذي لهيبته","يخفق قلب الرضيع في خِرَقِهْ",41,"ق",2,0],["أَعَنتَ عَلى عَبدِ العَزيزِ وَرَهطِهِ","وَشيعَتِهِ مِن أَعجَمِيٍّ وَمُفصِحِ",42,"ح",1,0],["أَعِنّا عَلى يَومَ نُشَيِّعُ لَهوَنا","إِلى لَيلَةٍ فيها لَهُ أَجَلٌ مُردِ",43,"د",1,0],["أَعِن عَلى كَرَمٍ أَخنى عَلى نَشَبي","وَهِمَّةٍ أَخلَقَت أَثوابِيَ الجُدُدا",44,"د",2,0],["أَعني اِبنَ مَن فَقَأَت في الرِحمِ مُقلَتَها","فَياشِلٌ لِأُناسٍ غَيرِ أَحرارِ",45,"ر",1,0],["أَعِناقُ اللِقاءِ أَثلَمُ في الأَح","شاءِ وَالقَلبِ أَم عِناقُ الوَداعِ",46,"ع",1,0],["أَعَن واجِبٍ أَلا يُسامِحَ جانِبٌ","مِنَ العَيشِ إِلّا جانِبٌ يَتَمَنَّعُ",47,"ع",1,0],["أَعَن دُوَلٍ في العُصبَتَينِ تَعاقَبَت","فَما نَقَّلُ الحالاتِ نَقلَ التَداوُلِ",48,"ل",1,0],["أَعِنّي عَلى عَينٍ قَليلٍ هُجودُها","عَصَت وَعَلى قَلبٍ كَثيرٍ بَلابِلُه",49,"ل",2,0],["أَعَن سَفَهٍ يَومَ الأُبَيرَقِ أَم حِلمِ","وُقوفٌ بِرَبعٍ أَو بُكاءٌ عَلى رَسمِ",50,"م",1,1],["أَعِن جِوارِ أَبي إِسحاقَ تَطمَعُ أَن","تُزيلَ رَحلِيَ يا بُهلَ بنَ بُهلانا",51,"ن",2,1],["أَعِنّي أَبانَ بنَ الوَليدِ بِدَفقَةٍ","مِنَ النيلِ أَو كَفَّيكَ يَجري عُبابُها",52,"ب",3,0],["إعناقُ عبدِ الله في طُرُقِ العُلى","والنَّحلُ تُعْنِقُ فَضلَه في الباطلِ",53,"ل",1,0],["أَعَنِ الأَهِلَّةِ في الدَّياجِرِ","سفَرَت لنا والبَينُ سَافِرْ",54,"ر",1,1],["أَعَنْ وَسَنٍ تَرْنو إليَّ عيونُها","أَمِنْ سَكَرِ مالَتْ عليَّ قُدودُها",55,"د",3,0],["أَعَن كُلِّ أَخدانٍ وَإِلفٍ وَلَذَّةٍ","سَلَوتَ وَما تَسلو عَنِ اِبنَةِ مُدلِجِ",56,"ج",1,1],["أَعني عَلِيّاً وَاِبنُ عَمِّ مُحَمَّدٍ","مَن نالَهُ الشَرَفُ الرَفيعُ الأَنسَبُ",57,"ب",1,0],["أَعِنِ الخائِفَ وَارحَم صَوتَهُ","رافِعاً نَحوَكَ يَدعوكَ يَدا",58,"د",2,0],["أَعَنكُم نَفى الرِجسَ أَم عَنهُمُ","لِطُهرِ النُفوسِ وَأَلبابِها",59,"ب",3,0],["أعَنْ أرضكمْ يغنيكمُ أرضُ غيركم","وكم خالةٍ جَدّاءَ لم تُغْنِ عن أمِّ",60,"م",1,0],["أعِناقُ البُهَمِ استَحسَنتَهُ","وهو بَرْدٌ أم عِتاقُ الجُرُدِ",61,"د",1,0],["أَعِندَكَ الشَمسُ قَد راقَت مَحاسِنُها","وَأَنتَ مُشتَغِلُ الأَحشاءِ بِالقَمَرِ",62,"ر",1,0],["أَعِنّي أُفَرِّق شَملَ دَمعي فَإِنَّني","أَرى الشَملَ مِنهُم لَيسَ بِالمُتَقارِبِ",63,"ب",1,0],["أعناقُ عذّالي مدققةٌ","ومفاصلُ الرقباءِ مدفونَهْ",64,"ه",1,0],["أَعِندَكَ عِلمُ الغَيبِ أَم أَنتَ مُخبِري","عَنِ الحَيِّ إِلّا بِالَّذي قَد بَدا لِيا",65,"ي",2,0],["أعندك أنا لم ندع بعدك الوجدا","وأنا ظننا الصبر يجدي فما أجدى",66,"د",2,1],["أَعن حقِّ مصرَ ودستورِها","ننامُ وقد نشط الواغل",67,"ل",1,0],["أعن خطبِ الخلافةِ تسألينا","أجيبي يا فَروقُ فتىً حزينا",68,"ن",2,1],["أَعَن أَمرِ الوُشاةِ قَتَلتَ نَفساً","تَساقَطُ حَسرَةً وَدَماً مُراقا",69,"ق",2,0],["أعِنِّي بروحٍ منكَ يا ربِّ واهدِني","سَبيلَكَ إنْ أضللتَ في النّاسِ شاعرا",70,"ر",2,0],["أعندك أن السّحرَ للّهِ غالبٌ","تأمَّلْ لبيدٌ أيَّ مهوىً تُشارِفُ",71,"ف",1,0],["أَعني أَبا العَبّاسِ خَيرَ الخَلقِ","لِلمَلكِ قَولُ عالِمٍ بِالحَقِّ",72,"ق",1,0],["أَعني غُلاماً لِسَعيدِ الأَعوَرا","قَد كانَ في الحُروبِ مَوتاً أَحمَرا",72,"ر",2,0],["أَعِنّي بِالوِصالِ فَدَتكَ نَفسي","فَقَد بَلَغَ الهَوى بي مُنتَهاهُ",73,"ه",1,0],["أعْنِي أَبا الحَسَنِ الإِمامَ المُجْتَبَى","مِنْ هَاشِمٍ والشَّاذِليَّ المَوْلِدِ",74,"د",1,0],["أعِنّي على الليل ليلِ التّمامِ","ودعني لشاني إذا ما انقضَى",75,"ا",1,0],["أَعِندي تَطلُبُ النَيكَ","وَنَيكُ الرَجُلِ النُكرُ",76,"ر",1,0],["أَعَن ذَنبٍ وَلا وَاللَهِ","ما أَحدَثتُ مِن ذَنبِ",77,"ب",1,0],["أَعِن باكِياً لَجَّ في حِزنِهِ","وَسَل ضاحِكَ القَومِ مِمَّ اِبتَهَج",78,"ج",1,0],["أَعَن واقِدٍ خَبَّرَتني وَاِبنُ جَمرَةٍ","وَآلِ شَهابِ خامِدٌ كُلُّ واقِدِ",79,"د",1,1],["أَعني بِذالِكَ أَنَّهُ لي مُؤمِنٌ","مِن كُلِّ رُزءٍ في حَياتي أَثَرا",80,"ر",2,0],["أَعَن عُفرٍ تُلِمُّ بِسِربِ عُفرِ","وَتَغفِرُ في الشَكاةِ لِأُمِّ غُفرِ",81,"ر",1,1],["أَعِن بِجَميلٍ إِذا ما حَضَرتَ","وَعِد بِالسُكوتِ إِذا لَم تُعِن",82,"ن",1,0],["أعَن وَخْدِ القِلاصِ كشَفْتِ حالا","ومن عِند الظّلام طَلَبتِ مالا",83,"ل",2,1],["أعندها مثلُ فتنتي","أم انني أفْترِي عليها",84,"ه",2,0],["أعند الطبيعةِ هذا الدلالُ","وفي دِفئِها مثلُ هذا الحنانْ",85,"ن",1,0],["أعندي وقد مارسْتُ كلَّ خَفِيّةٍ","يُصَدّقُ واشٍ أو يُخَيّبُ سائِل",86,"ل",1,0],["أعندَ هُمُ علْمُ السّلُوّ لِسائلٍ","به الرّكْبَ لم يَعْرِفْ أماكنَه قَطّ",87,"ط",1,0],["أَعِنِّي عَلَى قَوْلٍ حَكِيمٍ تَصُوغُ لِي","مَعَانِيَهُ دُرّاً وَمَبْنَاهُ عَسْجَدَا",88,"د",2,0],["أَعْنِي مَقَالَةَ كَاشِحٍ","فِي قَدْرِكَ الْعَالِي يُرِيبُ",89,"ب",1,0],["أَعَنْ سَبْقِ إِحْسَاسٍ بِمَا كَانَ مُضْمِراً","زَمَانُكَ آثَرْت