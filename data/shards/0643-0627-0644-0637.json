""],[4784,"حياك مياس المعاطف","https://www.poetsgate.com/ViewPoem.aspx?id=170932",""],[4927,"لَسْت وَحْدَك","https://www.poetsgate.com/ViewPoem.aspx?id=29839",""],[4959,"النَّصِيحَةُ فِي الصِّغَر","https://www.poetsgate.com/ViewPoem.aspx?id=214848",""],[5000,"عيني وعينك","https://www.poetsgate.com/ViewPoem.aspx?id=6071",""],[5057,"جريمتي حرفي","https://www.poetsgate.com/ViewPoem.aspx?id=197246",""],[5081,"للدعابة","https://www.poetsgate.com/ViewPoem.aspx?id=188099",""],[5174,"حُلَُوا مبانيها","https://www.poetsgate.com/ViewPoem.aspx?id=186100",""],[5277,"اطمئنان القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=197718",""],[307,"صراخ الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=213646",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""],[5376,"الشهد بالزهر ما ان نلت أحلاه","https://www.poetsgate.com/ViewPoem.aspx?id=188553",""],[5376,"للدمعِ في صرفِ الزمانِ شؤونُ","https://www.poetsgate.com/ViewPoem.aspx?id=202170",""],[5376,"جعلَ الالهُ لكلِّ داءٍ بلسما","https://www.poetsgate.com/ViewPoem.aspx?id=214070",""],[5409,"صوني جمالك بالحياء","https://www.poetsgate.com/ViewPoem.aspx?id=155249",""],[5425,"الرِهانْ","https://www.poetsgate.com/ViewPoem.aspx?id=207506",""],[5425,"تَقاسِيمٌ عَلى وَتَر","https://www.poetsgate.com/ViewPoem.aspx?id=207510",""],[5436,"ضاقت بي الدنيا وما فيها/صباح الحكيم","https://www.poetsgate.com/ViewPoem.aspx?id=128788",""],[5561,"انتظار","https://www.poetsgate.com/ViewPoem.aspx?id=197276",""],[5574,"علمُ النبض","https://www.poetsgate.com/ViewPoem.aspx?id=206016",""],[1117,"جد يا نسيم","https://www.poetsgate.com/ViewPoem.aspx?id=19418",""],[5605,"ملحمة المسيلة","https://www.poetsgate.com/ViewPoem.aspx?id=160024",""],[5628,"في ذكرى شهيد الإنسانية الإمام الحسين عليه السلام","https://www.poetsgate.com/ViewPoem.aspx?id=178499",""],[5628,"حب وحيرة","https://www.poetsgate.com/ViewPoem.aspx?id=178514",""],[5725,"والذ من جرح المعنى الجارح","https://www.poetsgate.com/ViewPoem.aspx?id=202597",""],[5847,"جمرة الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=1296",""],[5957,"شكراً لقلبكَ","https://www.poetsgate.com/ViewPoem.aspx?id=60788",""],[5977,"حاجة نفس","https://www.poetsgate.com/ViewPoem.aspx?id=213132",""],[6093,"همٌّ يُبايتني وغمٌّ يسهدُ ( الكامل )","https://www.poetsgate.com/ViewPoem.aspx?id=176381",""],[5724,"أم الربيعين ابسمي وتهللي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55135&r=&rc=2",""]],"verses":[["كَالطَّيفِ وَافَقَ ذَا هوىً فَلَها بهِ","حَتَّى إِذَا ذَهَبَ الرُّقَادُ أَضَلَّهُ",0,"ل",2,0],["كالطَّوْدِ لا يَنْطِحُ لكنه","يُوهِي رُؤوساً شَأنُها النطحُ",1,"ح",1,0],["كَالطَيرِ أَسرابا وَلَكِن إِن عَدَت","تَنَتِ الرِياح وَتَسبَقُ الأَطيارا",2,"ر",2,0],["كالطفل من ثدي أمه رضع ال","لبان حتى نما وحبا",3,"ب",2,0],["كالطَّوْدِ لا تَثْنيهِ عن مُتمنِّعٍ","حتى يَدُقَّ رقابَه برقابِه",4,"ب",2,0],["كالطيرِ لو كانت تطيرُ لأسرعت","ظمآنةً نحو الحياة بفيكِ",5,"ك",1,0],["كالطير من غصنٍ إلى غصنِ","وثابة وثب الفؤاد لها",6,"ه",2,0],["كالطفلِ يُمنَحُ ثم يُمْ","نَعُ ثم يضْحَكُ ثم يبكي",7,"ك",2,0],["كَالطَعنَةِ النَجلاءِ مِن يَدِ ثائِرٍ","بِأَخيهِ أَو كَالضَربَةِ الأُخدودِ",8,"د",1,0],["كَالطَودِ لَكِن فيهِ هِزَّةُ عاطِفٍ","كَاللَيثِ لَكِن فيهِ شيمَةُ مُشفِقِ",9,"ق",1,0],["كَالطَلِّ لَكِن يُرَدّى النورَ لابِسُهُ","وَالظِلِّ لا يَقبَلُ الأَنوارَ مَوقِعُهُ",10,"ع",2,0],["كَالطَودِ يُعدي حِلمَهُ سُفَهائُهُ","لا يَنطِقونَ سِوى الجَوابَ وَيَبتَدي",11,"د",2,0],["كالطَّرْف يُقْلِقُهُ المراح صبابةً","بالجَرْي وهْوَ مُقَيَّدٌ مَشْكُولُ",12,"ل",1,0],["كَالطَّيْرِ إِسْفَاقاً وَكَال","حَيَّاتِ زَحْفاً فِي الأَكَمْ",13,"م",1,0],["كَالطِّيبِ فِي قَارُورَةٍ مَصْدُوعَةٍ","أَلْفَى سَبِيلاً لِلْعُلَى فَتَضَوَّعَا",14,"ع",2,0],["كَالطَّلَلِ الْبَاقِي عَلَى إِقْوَائِهِ","لا عَامِراً يُلْفَى وَلا منْهَدَّا",15,"د",2,0],["كَالطَّيْرِ في قَفَصِ الْحَدِيدِ مُوَثَّقاً","قد أَوْهَن الأَسْلاَكَ من خَفَقاتهِ",16,"ت",2,0],["كالطِّيب في الأحقاقِ، يَنفَ","حُ ريُحه رغمَ احتجابه",17,"ب",2,0],["كالطائر المجروح ، في","عش ، بأيدي الريح واجف",18,"ف",1,0],["كالطيفِ جئتَ بلا خُطى","وبلا صدى ، وبلا إشارة",19,"ر",2,0],["كالطّير أسرابا ولكن إن عدت","تنت الرّياح وتسبق الأطيار",20,"ر",1,0],["كالطَّرْف يُقْلِقُهُ صبابةً","بالجَرْي وهْوَ مُقَيَّدٌ مَشْكُولُ",21,"ل",1,0],["كالطير أسكر لحنها صيّادها","فمشى إليها بالردى واصطادها",22,"د",3,0],["كالطيّف يحيا بلا شوق ، ولا حلم","ولا انتظار رجاء ، ضنّ أو سمحا",23,"ح",2,0],["كالطفل يصرخ في الظلام لعله","ينسى مخاوفه إذا لم تطرد",24,"د",1,0],["كَالطَيرِ تَحمِلُ آساداً تُظَلِّلُها","طَيرٌ مَوارِدها قاني الدَمِ السَرِبِ",25,"ب",1,0],["كَالطَودِ تَنقُلُهُ قَوائِمُ سابِحٍ","فَإِذا عَدا صارَت قَوادِمَ أَجدَلا",26,"ل",2,0],["كالطود ليس يجل جلوه حلمه","ريح الخطوب ولا يحول بعهده",27,"د",2,0],["كالطفل أشجاهُ الفطامُ فطرفُهُ","أبداً تراه بالدموع بليلا",28,"ل",2,0],["كالطرف والإكليل أمسى منزلا","منها منال الطرف والإكليل",29,"ل",1,0],["كالطّود إلا عِندَ نَغْمة مادِحٍ","فَهُناك يَجْمعُ لِلأناة مُزَاحا",30,"ح",2,0],["كالطَّوْد في عَصْف الرياح وقَصْفها","لا رَهْوَها يَخْشى ولا هْوجاءها",31,"ا",3,0],["كالطيف يستقري مضاجعه","أو كالحسام يسل من غمد",32,"د",1,0],["كالطير من ألم","في ذبحه يثب",33,"ب",1,0],["كالطّيفِ حَظُّ العين فيهِ وافرٌ","لكنّه لاحَظَّ فيه لليَد",34,"د",1,0],["كالطّفل يَخدَع نَفْسَه عن رَشْفهِ","للثَدْيِ يُنقَعْ وَدْعُه المَمْروث",35,"ث",1,0],["كالطود أتلعَ هادياً ورديفَه","حتى إذا اشتدّ انطوى فانهالا",36,"ل",2,0],["كالطبل يقرع باب مخدعها على","قصف الرعود وللرياح صفيرل",37,"ر",2,0],["كالطَّوْدِ ما هزَّهُ الإدلالُ في زمنٍ","وللفُحُولِ مع الإدْلالِ إِرْغاءُ",38,"ا",2,0],["كالطود في عظم كالبدر في شرفٍ","كالليث في هيبة كالغيث في كرمِ",39,"م",1,0],["كالطفل تنشأ بالخلائق جملة","وتعود نسخاً فيه تغليظات",40,"ت",1,0],["كَالطِفلِ عارَضَ شَيخاً","عَن تِبرِهِ بِالطُفالِ",41,"ل",1,0],["كَالطِّفْلِ إِلاَّ أَنَّهُ","مِنْ عَرْعَرٍ لاَ مِنْ بَشَرْ",42,"ر",1,0],["كالطير لما نادأتها هِجمةٌ","للصُقرِ فرّت في الجهاتِ هروبا",43,"ب",2,0],["كالطيف لا يصل الجفون لسهدها","ويهب فيها ساعة الإغفاء",44,"ا",2,0],["كالطير راقته الريا","ض فأعلن الشوق الكمين",45,"ن",1,0],["كَالطَّير فَاجَأهَا البَاري وَأَذهلَهَا","فَحَاكَت البَرقَ وانقَضَّت عَن الحبُكُ",46,"ك",1,0],["كَالطَحنِ أَو أَذرَت ذَرىً لَم يُطحَنِ","دَوافِناً مِن فَرغِ كُلِّ مَدفَنِ",47,"ن",1,0],["كالطيف أو كهلال أول ليلة","في الشهر تطلع ساعة وتغيب",48,"ب",1,0],["كالطفلِ في حجرِها تُرقِّصُهُ","تَشبرُهُ تارةً وتَذرعُهُ",49,"ع",2,0],["كَالطَّيْرِ إِذْ تَغْدُو خِمَاصاً ثُمَّ مِنْ","بَعْدِ الغُدُوِّ تَرُوحُ غَيْرَ خِماصِ",50,"ص",1,0],["كالطودِ حلماً أو تهزُّ","كَ للثناءِ الأريحيَّه",51,"ي",2,0],["كالطَّرفِ والقلبِ فيما بين ذاك وذا","مسرى الضمير وتبعيدٌ كتقريب",52,"ب",1,0],["كالطير تخفق في مراقبه","من تحتها نجديةٌ جرد",53,"د",1,0],["كالطيف يختلس الظلام إذا سرى","لمحاً وطرف النجم عنه كليل",54,"ل",1,0],["كالطرف يستجلي الوجوهُ ووجههُ","منهُ قريبٌ وهو عنهُ مغيَّبُ",55,"ب",1,0],["كالطَّيرِ في شَرَكٍ يَسمُو إلى دَرَكٍ","حَتّى تخلَّصَ من سُقمٍ ومِن دَرَن",56,"ن",1,0],["كالطود حلماً والحسام عزةً","والبدر وجهاً والغوادي كرما",57,"م",2,0],["كالطير يسترزق من","حبوب أهل الحَرَب",58,"ب",1,0],["كالطائر المجروح ضم جناحه","طول الحياة على حداد سهام",59,"م",1,0],["كالطفل عضَّ عقوقاً ثدي والدةٍ","شتان شتان بين البرّ والعاق",60,"ق",1,0],["كالطفل يذهب مصبحا","وعلى أبيه يسلم",61,"م",1,0],["كالطفل مبتهجاً في حضن والده","فإن لي نسباً في الشعر للبحر",62,"ر",1,0],["كالطيب يبدُو قبل مس العطر","أيها الحاضرونَ صلوا عليه",63,"ه",1,0],["كالطير فَرَّ حَذَراً","لَو لم بِفَرَّ لم يُصَد",64,"د",1,0],["كالطَفلِ يُضرَب من ابيهِ وامهِ","واليهما ابداً يكون رجوعهُ",65,"ه",1,0],["كالطبري والثعلبي ومكي","أئمة التفسير دون شك",66,"ك",1,0],["كالطار ومثل الطنبور أو منقلة","ما أقبح أعمى مولَّع باللعب",67,"ب",1,0],["كالطبل تسمع صوته","أنَّى تثاءب أو جعر",68,"ر",1,0],["كالطل فوق الزهر أو حبب الطلا","أو فضة نثرت بها حصباء",69,"ا",2,0],["كالطعنة الفوهاء إلاَّ أنّها","تدمي قناة الطاعن المتعمّد",70,"د",1,0],["كالطود قد رسخت مودة قلبه","ليست كحقف الرملة المنهال",71,"ل",1,0],["كالطَّوْدِ حِلماً والسّماكِ رتُبةً","والسَّيف عزماً إن له القرنَ انتصى",72,"ا",1,0],["كالطّود طَيَّار العِنان وقعُهُ","في ركضهِ وقعُ الصَّفا على الصَّفا",72,"ا",1,0],["كالطيبِ يذهَبُ حجمُهُ","ويظلُّ منه النشرُ عاطر",73,"ر",1,0],["كالطفل يفزع للحياة فيرتمي","وتلين حتى للضعيف قناته",74,"ت",2,0],["كالطَّود طاد لا يزول لدى اللقا","في خاطر إذ ذاك قطعة جلمد",75,"د",1,0],["كالطفل لا تلقاه يلقى مكتباً","إلا بإرنان ودمع يقطر",76,"ر",1,0],["كالطير في الأقفاص قص جناحه","مقراض دهر خائن لم يعتب",77,"ب",1,0],["كالطَّلا مقلةً وجيداً فمن لي","لوَ ترشَّفتُ من لمَاها طِلاءَ",78,"ا",2,0],["كالطود يصفعُ وجهَ الريح منتصباً","كبراً وما زحزحَ الباغي له قَدما",79,"م",2,0],["كالطود راس في مكافح","ة الكوارث والعواصف",80,"ف",1,0],["كَالطِّفْلِ خَلْفَ الْبَاْبِ أَجْلِسُ دَاْئِماً","وَعَلَى النَّوَاْفِذِ تُسْدَلُ الأَسْتَاْرُ",81,"ر",1,0],["كَالطِيِّ نِ تَشْكِيلُهُ سَهْلٌ إِلى الصُّوَرِ","وَلَيْسَ سَهْلاً إِذَا مَا صَارَ كَالْحَجَرِ",82,"ر",1,0],["كالطفلِ ضيّعَ في ازدحامٍ أمَّهُ","ثمَّ التقاها والجفونُ سِجالُ !",83,"ل",1,0],["كالطِّفلِ إذْ يحتاجُ للعَطْفِ","نِصفي يُسافِرُ حامِلاً نِصْفيْ",84,"ف",2,1],["كَالطَّيْرُ تَسْبَحُ فِي فَضَاءٍ أَحْرُفِي","بَيْنَ الْغَمَامِ فَكَانَتِ الْقِنْدِيلَا 🌤️",85,"ل",2,0],["كالطفل يفرح بالألعاب تشغله","ويجحد الأم بعد الأنس يقليها",86,"ي",3,0],["كالطير يرزقه الرحمن غلّتهُ","من حائمات صقور الجو يحميهِ",87,"ي",2,0],["كالطفلِ أغفو إذا ناموا على بدني","وأنشق الليلَ من أنفاسهم نسمُ",88,"م",1,0],["كالطالبين من الأموات منفعة","والسائلين من الأموات غفرانا",89,"ن",2,0],["كالطير يهفو غلى اغصانه مرحا","والحب عامره والغصن أنداه",90,"ا",2,0],["كالطير في قفص البغاة لعينها","في كل وادٍ أفرعٌ وغصونُ",91,"ن",1,0],["كالطيرِ أنتم رغمَ آلامِ الدنا","جادَ السماء ترنما وتبسما",92,"م",2,0],["كالطير ضيقت الخنا","ق عليه فازداد اضطرابا",93,"ب",2,0],["كَالطِفْلِ ، قَبْلَ الثَغْرِ ، قَلْبُهُ ضَاحِكٌ","أَفْدِيْهِ وَجْهَكِ ضَاحِكَاً وَمُنَوَّرَا",94,"ر",2,0],["كالطِفُلِ (تارا) بِحِضنِ الروحِ لاهِيَةٌ","كالشِعرِ (تارا) ، تُسَلِّيني مِنَ الضَجَرِ",95,"ر",1,0],["كالطير أشدو فيكمُ، نغمي","وأداعب الأحزان أجليها",96,"ي",3,0],["كالطيفِ يحيا بلا وجودٍ","لغاتُه الصمتُ والعهودُ",97,"د",1,0],["٥- ‏كالطّفلِ يحيى حكايا الحبِّ في لَعِبٍ","‏إذْ يمضُغُ الحبَّ حينًا ثمّ يرميهِ",98,"ي",2,0],["كالطّيرِ يسبحُ في فسيح ِسمائهِ","وكأنّ ما في كونِنا إلاّنا",99,"ن",2,0],["كالطير يشدو على الأغصان نغمته","فيبدع اللحن في شدو يغنيها",100,"ي",3,0],["كالطودِ باقٍ لمْ تنلْ","مِنْ شأنهِ كفُّ الخطوبِ",101,"ب",1,0],["كالطقْس حُبّك لا صحْوٌ ولا مطر ٌ","أصبحْتُ أهربُ منهُ صرتُ أخشاه ُ",102,"ا",2,0],["كالطفل يلهو بالقلوب مدلّلاً","وانا على قلبي الهموم تناوحُ",103,"ح",1,0],["كالطيروهو حبيس","يشدو بلحن سقيم",104,"م",1,0],["كالطفل يغدو قلبه","ويهامس القلب العليل",105,"ل",1,0],["كالطفل نفسي إنها تواقةٌ","تسعى حثيثاً نحو ما يرضيها",106,"ي",3,0],["28. كالطَّيرِ يسبحُ في الجنانِ وقصرهُ","دُرُالخيامِ وقد كساها العَسْجَدُ",107,"د",1,0],["كالطود تهزأ بالرياح شعافة","فتحول بين جنوبها والشمأل",108,"ل",1,0]]}