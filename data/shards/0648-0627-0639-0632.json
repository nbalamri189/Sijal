تحدي","https://www.poetsgate.com/ViewPoem.aspx?id=162457",""],[5861,"وطن أنا","https://www.poetsgate.com/ViewPoem.aspx?id=188050",""],[5912,"ذكرى الأمس","https://www.poetsgate.com/ViewPoem.aspx?id=202553",""],[5956,"الحب للجميع","https://www.poetsgate.com/ViewPoem.aspx?id=192191",""],[5956,"مهما اجتمعنا لا نطيق تباعداً","https://www.poetsgate.com/ViewPoem.aspx?id=193941",""],[5956,"يا من تُسَمِّي أجملَ الأسماءِ","https://www.poetsgate.com/ViewPoem.aspx?id=205262",""],[6003,"كفكف دموعك !!!","https://www.poetsgate.com/ViewPoem.aspx?id=188924",""],[6031,"حَتَّامَ أمطلُ سيِّدي شكرَ اليدِ","https://www.poetsgate.com/ViewPoem.aspx?id=46263",""],[6033,"نفرتُ إلى ربّي","https://www.poetsgate.com/ViewPoem.aspx?id=215800",""],[6056,"نايف الطاروق","https://www.poetsgate.com/ViewPoem.aspx?id=130315",""],[6068,"في أي فلب أسكن -14-","https://www.poetsgate.com/ViewPoem.aspx?id=175866",""],[6093,"همٌّ يُبايتني وغمٌّ يسهدُ ( الكامل )","https://www.poetsgate.com/ViewPoem.aspx?id=176381",""],[6124,"طَلْعُ نيلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=109746",""],[6183,"وعيت السرور يوماً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79835&r=&rc=25",""],[6202,"هوى وشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86757&r=&rc=58",""],[6213,"عانقيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76276&r=&rc=33",""],[119,"ضارعت زفرة الذنوب بكائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55607&r=&rc=4",""]],"verses":[["وَأَعزَلَ ناءٍ عَنِ المَكرُمات","يَرى المَوتَ مِن دونِ لُقيانِيَه",0,"ي",2,0],["وَأَعزِلُ مِن دونِ الَّتي لا أَنالُها","نَوازِعَ نَفسي أَو تَذِلَّ صِعابُها",1,"ب",3,0],["وأعَزَّ الرّشْدُ بهِ فِرَقاً","وأذَلَّ الغَيُّ بهِ فِرَقا",2,"ق",2,0],["وَأَعِزَّةٌ بَيْنَ الرِّجَالِ أَفَاضِلٌ","هُمْ نُخْبَةٌ فِي الشَّيْبِ وَالشُّبَّانِ",3,"ن",1,0],["وَأعَزَّبْ ذِكْرَاهُ مَيْتاً بِمَا لَمْ","يُرْوَ عَنْ أيِّمٍ وَلاَ عنْ خَدِينِ",4,"ن",1,0],["وَأَعَزَّتْ بِكَ البِلادَ وَإِنْ لَمْ","تَقْضِ أَقْصَى مَا رُمْتَهُ مِنْ مَرَامِ",5,"م",1,0],["وأعزَّ من ولاّه أمر عباده","فحباهُمُ إحسانَه الموصولا",6,"ل",2,0],["وأعِزّوا المُلك الذي نبتغيه","بجنود مبثوثة في الحدود",7,"د",1,0],["وأعزّ الأعمار عمر قصير","تحت ظلّ من السيوف مديد",7,"د",1,0],["وأعْزِز وليَّك إن القبي","حَ كلَّ القبيح وليٌّ يذُلُّ",8,"ل",1,0],["وَاِعزَم مَتى شِئتَ فَالأَوقاتُ واحِدَةٌ","لا الرَيثُ يَدفَعُ مَقدوراً وَلا العَجَلُ",9,"ل",1,0],["واِعزِزْ عَلَينا أَن تُصيبَكَ وِحشَةٌ","وَأنسُك ما تدريه فيكَ مِنَ الحُبِّ",10,"ب",1,0],["وأعززتَ اليتيمَ فتاهَ عُجباً","وراح يُنافسُ المتكبّرينا",11,"ن",2,0],["وأعَزُّ مفْقُودٍ شبابٌ عائِدٌ","من بعدِ ما ولّى وإلْفٌ واصلُ",12,"ل",1,0],["وَأَعَزُّ مَا تَقْضِي لِنَفْسِكَ حَاصِلٌ","لَكَ إِنْ تُؤَدِّ الحَقَّ بالمِعْيارِ",13,"ر",1,0],["وَأَعَزِّ جِدٍّ شَادَ مَمْلَكةٌ","سَامَى بِهَا العُلْيَا مِنَ الشُّهُبِ",14,"ب",1,0],["وأَعَزُّ النَّاسِ فِيهَا نَسَباً","مَنْ لَه مِنْ نَفْسِهِ أَزْكَى نَسَبْ",15,"ب",1,0],["وأعزَّ أزْرَقَ في القناةِ كَأَنَّهُ","في طُخْيةِ الظَّلْماءِ ضَوْءُ شِهابِ",16,"ب",1,0],["وَأَعِزُّ ثُمَّ أَذِلُّ ذِلَّةَ عاشِقٍ","وَالحُبُّ فيهِ تَعَزُّزٌ وَتَذَلُّلُ",17,"ل",1,0],["وأعزُّ ما حوت العرو","قُ: دمُ الشباب الأبرياء",18,"ا",2,0],["وأعزُّ ما مَلَكَ الحِمَى من ثَوْرَةٍ","ومُحَارِبُو الفَوْضَى والاسْتِغَلالِ",19,"ل",1,0],["وأعزُّ ما تبغي الحلائلُ مِنهمُ","أنْ تُسترَ العَوراتُ بالأطمار",20,"ر",1,0],["وأعزّ من عبد الإله بغضبة","لحمى أميّة بالشام مباحا",21,"ح",2,0],["وأعز الإله فيه حمى الدي","ن ليعلو علاه في الأقطار",22,"ر",1,0],["وأعز من هرعت له","للرشد أعيان الوفود",23,"د",1,0],["وأعز ما ملكت يدان","وما يعز المالكين",24,"ن",1,0],["واعزف على أَوتار عود","جميل أَلحان الغرام",25,"م",1,0],["وأعزُّ الورى وأرفعُهم عيصاً","وأزكاهُمُ حمىً وجدودَا",26,"د",2,0],["وأَعزَّ الدينَ والحمى بك طرّاً","وأَذلَّ الأعداءَ والحُسَّادَا",27,"د",2,0],["وأعزّ الناس في الدنيا امرؤ","للورى ماءَ المحيا ما أراقْ",28,"ق",1,0],["وَأَعَزُّ حَيٍّ في رَبيعَةَ حَيُّهُ","كُلٌّ يُقِرُّ لَهُ بِذاكَ وَيَشهَدُ",29,"د",1,0],["وَأَعَزُّ جاراً مِن فَتى بَكرٍ وَقَد","نَزَلَت بِساحَتِهِ عَقيلَةُ مِنقَرِ",30,"ر",1,0],["وَأَعزُّ الأنامِ أنتَ لدى اللَ","هِ تَعالى وهو السميع البصيرُ",31,"ر",1,0],["وأعزز فؤاداً لو أردت جعلته","أعزّ من الشغواء في رأس شاهقِ",32,"ق",1,0],["وَأَعْزِزْ عَلَيْنَا أَنْ يُعَزَّ الْعَزِيزُ مَا","يَبُزُّ عُيُوناً لِلْعُلاَ لَذَّةَ الْغَمْضِ",33,"ض",1,0],["واعزف على الوتر الريان لحن هوى","قلبي ورتل بدير الشعر ألحاني",34,"ن",2,0],["واعزِمْ وإن أعرضَ أهوالٌ ففي","مُضطَربِ الأرضِ لقومٍ مُضطَرب",35,"ب",1,0],["وأعزُّ الناس عندي","صرتُ أشقاهمُ عنده",36,"د",2,0],["وأعزُّ من مليونِ بُرْجٍ شاخِصٍ","أبراجُ همَّةِ عالمٍ وإمامِ",37,"م",1,0],["وأعزّهُم جاراً وأمْ","نَعهُم حِمىً وأجلَّ آلاَ",38,"ل",2,0],["واعزِم عَلى سُلوانِهِم عَزْمةً","تَثْنِيكَ بعد الرِّقِّ حُرّاً طليقْ",39,"ق",1,0],["وأعز لو قبل الردى فيك الفدا","بنفوسنا نفديك والأَبناء",40,"ا",2,0],["وأعز لو يجدي البكا لبكاك من","تحت السما يا ابن الكرام جميعا",41,"ع",2,0],["وأعزّوها بأخرى وصَفتْ","روضَ وعساءَ جرى الماءُ خِلالَهْ",42,"ل",2,0],["وأعزلُ ما مدَّ السلاحَ بَنانُه","تَلاوذُ من فتْكاته البيضُ والسمرُ",43,"ر",1,0],["وأعزَّني وأَقامَ لي في بابِهِ","مجداً وباللُّطْفِ الخَفي حَيَّاني",44,"ن",2,0],["وأَعزَّهُ بمحبَّةٍ مَنْصوصَةٍ","وأَشارَ لي اجْعَلْهُ خَليلاً صاحِبَا",45,"ب",2,0],["واعزم وصمم فقد طالت وقد سمجت","قضية لفظتها ألسن الأمم",46,"م",1,0],["وَأعزّاؤنا إِذا لَم يَفوتو","نا صغاراً فاتوا وماتوا كبارا",47,"ر",2,0],["وأعزّ ملكا قد كلاه بعينه","حتى يظلّ الدهر ليس يبيد",48,"د",1,0],["واعزم على السالين أَلا يصحبوا","يومَ النَّوى في العاشِقينَ نَديما",49,"م",2,0],["وَأَعَزَّ سُلطانَ الهَوى حَتّى غَدَت","أَسمى مُلوكُ الأَرضِ مِن عَبدانِهِ",50,"ن",2,0],["وأعززتَ دينَ الله إذ ذلَّ جِزبه","بطاغيَةٍ حزبُ الضَّلالِ لَهُ حِزب",51,"ب",1,0],["وأعزَّ حجةَ تاجِ مصرَ وعرشها","بالمعطيات البرَّ والمعطينا",52,"ن",2,0],["وأعزُّ الأشراف نفساً وأهدى","وأشدُّ العباد بطشاً وقهرا",53,"ر",2,0],["واعزِمْ على قتلِ من عاداكَ مجتهداً","بمرهفَاتٍ وآلاتٍ وأبطالِ",54,"ل",1,0],["واعزم عزيمةَ عضْب","ماضى الغِرارْين باترْ",55,"ر",1,0],["واعزم على جوب الفلا","عزماً كماضية السيوف",56,"ف",1,0],["وأعز جار منهم","وإلى استباق المجد أجرى",57,"ر",2,0],["وأعزه وأجله","وأحله أزكى بلد",58,"د",1,0],["وأعز عائشة وبرأها من ال","إفك الذي في حقها لم يقبل",59,"ل",1,0],["وَأعزّ نفساً من عصا","م ومِن إياس ومرشدِ",60,"د",1,0],["وأعزّ جيرانا وأغزر نائلا","والمحل يعرف بالسعار محالا",61,"ل",2,0],["وأعزّه حتى كأنّ بني الورى","طراً تقاد لديه كالمستعبدَهْ",62,"د",2,0],["واعْزِفْ عَنِ الطَّمَعِ الكَذو","بِ ولا يكنْ لكَ فيهِ رُخْصَهْ",63,"ص",2,0],["وأَعَزَّ أَيّاماً لَها ولَيالِياً","فَتَشَبَّهَتْ بِعَبيدِهِ وإِمائهِ",64,"ا",3,0],["وأعزز بمن ألبسته العز راقياً","بذلته للّه أعظم رتبة",65,"ه",1,0],["وَأَعَزَ شَرع اللَهِ فيكَ وَأَنَّهُ","لَعَلى هُدىً مِن رَبِهِ وَرَشاد",66,"د",1,0],["وأعزّوا بيوتَهم وبَنوها","في المعالي من فَوق سَبع طباقِ",67,"ق",1,0],["وإعزازِ جارٍ وإطلاق عانٍ","واعطاءِراجٍ وإِلجاء شاكي",68,"ك",2,0],["وَأَعَزَّ مَنْ رَكِبَ الخُيُولَ وَقَادَهَا","مُعْتَاضَةً بِالنَّقْعِ عَنْ إِحْلاَسِ",69,"س",1,0],["وَأَعَزَّ دِينَ الحَقِّ مِنْهُ خَلِيفَةٌ","هُوَ مَنْ عَلِمْتَ ابْنُ الخَلِيفَةِ يُوسُفِ",70,"ف",1,0],["واعزّ من لبيَّ الكميُّ وأسرعا","قد كان في هذا الزمان لملكنا",71,"ن",2,0],["وأعزهم جاراً وأمنعهم حمىً","وأشبهم ناراً وأرفعهم ذرى",72,"ر",2,0],["وأُعز شرع نبيه","مذ شاد للاسلام ركنه",73,"ن",2,0],["وأعزَّ الإسلامَ رغم أُنُوفٍ","خَيَّمَ الكُفرُ حَولَها والعَداء",74,"ا",2,0],["وأعِزَّةٍ قد كنتُ دِنتُ بحبّهم","ولذاك سائرهم بحبّي دانوا",75,"ن",3,0],["وأعزّةٌ عَزَّيتُ بعد فراقهم","باليأس قلبي أن يكون لقاءُ",76,"ا",2,1],["وأعز من عزت به رتب العلا","وحما حماها واستقام لنصرها",77,"ر",3,0],["وأعزَّ مَنْ خفقتْ عليه رايةٌ","تَحكي إِذا خفقت فُؤادَ مُدَلَّهِ",78,"ه",1,0],["وأعزُّها يومٌ علينا","من مفاخره ديون",79,"ن",1,0],["وأعَزُّ وارثِ مُلْكِ إسماعيلَ مِنْ","بطل شذا عزماته معطار",80,"ر",1,0],["وأعزَّ دينَ الله فهو بشكره","في أَيْكِها تترنّمُ الأطيارُ",80,"ر",1,0],["وأعزّهم بعزيز نصرته التي","رُعْبُ القلوب أَمَامَهَا سَتّارُ",80,"ر",1,0],["وأعزهم بالحق وانصرهم به","نصرا عزيزا أنت ذو السلطان",81,"ن",1,0],["وَاعزبوا أَيُّها الثَعالِبُ عَنّا","مِصرُ أَدرى بِكُلِّ باغٍ كَنودِ",82,"د",1,0],["وَاِعزِق القطنَ لَها إِذ سوقُهُ","أَصبَحَت أرجوحَةً لِلمغزَلِ",83,"ل",1,0],["وَأَعزِز عَلَيَّ بِما سَرَّني","مِنَ الإِقتِدارِ عَلى أَمرِهِ",84,"ر",2,0],["واعزم كما عزم المأمون إذ نشزت","أرض العراق فزال البؤس والضرر",85,"ر",1,0],["وأعزُّ مُنية كلّ ذي سِرٍّ وذي","شرفٍ ومجدٍ لَثِمٌ أخْمصُ رجلهِ",86,"ل",2,0],["واعزم ولو كان يوم محومر","واقطب عميل إن دعيت جاب",87,"ب",1,0],["وأعز كل العالمين وأكرما","وأبر شخص في الوجود وأرحما",88,"م",2,0],["وأعزلكم تسع على جاهِ أربعٍ","فعجّل بهذي المشرقات التي تسري",89,"ر",2,0],["وَأعزِمَ عَن ما يَقصُرُ الطيرُ دونَهُ","وَأركَبَ فيَّاضاً مِنَ الموجِ زَاخِر",90,"ر",1,0],["واعز بالشرف الرفيع مكانه","واتاه تاج الفضل منه مكللا",91,"ل",2,0],["وأعز رب الناس كلهم بيضا فلا فرقت أو سودا","لا قفرة إلا وتخصبها إلا ويعطي العطر لاعودا",92,"د",2,0],["وأعز مولانا العظيم مناره","ومقامه العالي الذي سامى العلا",93,"ل",2,0],["واعزل لهم عند انقضاء البرد","مراوحاً من بعد ماء الورد",94,"د",1,0],["وَأَعَزّوا جَوانِبَ الدينِ حَتّى","ذَلَّ مَن لا يَدينُ بِالإِسلامِ",95,"م",1,0],["وأعززتَ الجماعةَ بانتسابٍ","وليسَ العِزُّ في كسبِ الحُطامِ",96,"م",1,0],["وأعز فاكهة لهم","أكل القرلَّة والكبر",97,"ر",1,0],["وأعز شيء في الوجود يلوح لي","هذا المحيّا حجة المفتون",98,"ن",1,0],["واعزمْ عزيمةَ فاتكٍ لم ينهَه","عن همهِ التصعيدُ والتصويبُ",99,"ب",1,0],["وَأَعزُّ عمرٍ ما اقتنيتَ بِهِ العلا","بمُفوَّقٍ وَمُقوَّمٍ ومُجرَّد",100,"د",1,0],["وأعز من يبكىَ شبابٌ صاعدٌ","يهوي على غرر إلى القيعان",101,"ن",1,0],["واعزم سؤالك أن تكون مدى الحيا","ة وبعد مغموراً بلطف شامل",102,"ل",1,0],["وأعَزٌّ الخَلقِ طُرّا عائِذ","برئيسِ الرؤساء اعتَصَما",103,"م",2,0],["وأعزوك فاعتززت وامسى","مقتنيك الإنسان وهو مهان",104,"ن",1,0],["واعزم إذا حاولت أم","را يفرجُ الهمّ الدخيلا",105,"ل",2,0],["وأعزم عزماً فيأبى عليّ","امضاءَه رأيي الثاقبُ",106,"ب",1,0],["وَأَعزِز عَلَيها أَن تَكونَ إِشارَتي","إِلَيها بِطُهر لا يُجابُ مُشيرُها",107,"ر",3,0],["وَأَعَزَّ رُتبَتَكَ الشَريفَةَ فَوقَ ما","وَاللَهِ تَفهَمُ جلَّةُ النُبَلاءِ",108,"ا",2,0],["وأعزف لامسا أوتار قلبي","فيطرب خافقي لتخيلاتي",109,"ت",2,0],["واعز شيء قد حوى اسم خليفة","برقاده لعباده متبرع",110,"ع",1,0],["وَأَعَزُّ مِن سُقيا الحَيا مَن لَم يَبِت","في 