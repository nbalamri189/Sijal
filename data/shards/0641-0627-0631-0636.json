7,"وِداد","https://www.poetsgate.com/ViewPoem.aspx?id=197454",""],[5413,"هي قصتي!","https://www.poetsgate.com/ViewPoem.aspx?id=200673",""],[5431,"دمشق الروح...","https://www.poetsgate.com/ViewPoem.aspx?id=197674",""],[5512,"لذَّةُ القطاف","https://www.poetsgate.com/ViewPoem.aspx?id=206540",""],[5533,"نكرانُ الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=176273",""],[5626,"سمائي مثل عشبي","https://www.poetsgate.com/ViewPoem.aspx?id=189719",""],[5720,"الشفيعُﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=199937",""],[5786,"يميناً بها إن كنت للصبّ مُسعِدا","https://www.poetsgate.com/ViewPoem.aspx?id=50660",""],[5922,"صراخ فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=185119",""],[5952,"مَوْسِقِ ال آهَ","https://www.poetsgate.com/ViewPoem.aspx?id=213572",""],[5956,"الأشواقُ الجنونية","https://www.poetsgate.com/ViewPoem.aspx?id=192466",""],[5956,"الضيف الثقيل حالوش","https://www.poetsgate.com/ViewPoem.aspx?id=193420",""],[5957,"عراقية النبض تهدي السلام","https://www.poetsgate.com/ViewPoem.aspx?id=177054",""],[5970,"خذ من الدنيا الذي أعطت ولا","https://www.poetsgate.com/ViewPoem.aspx?id=130593",""],[161,"بين الأرض والسماء حياة","https://www.poetsgate.com/ViewPoem.aspx?id=202596",""],[6048,"تحية لقلب عمان من مهرجان جرش","https://www.poetsgate.com/ViewPoem.aspx?id=197754",""],[6068,"ألف ألف تحية -08-","https://www.poetsgate.com/ViewPoem.aspx?id=175860",""],[240,"قُلْ لأَبِي کلنَّقْصِ وَکلْمَخَازِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26478&r=&rc=3",""]],"verses":[["فَأَرضوهُ أَن أَعطوهُ مِنّي ظُلامَةً","وَما كُنتُ قُلّاً قَبلَ ذَلِكَ أَزيَبا",0,"ب",2,0],["فَأَرضَيتُما الدَيّانَ وَالدينَ كُلَّهُ","لَقَد رَضِيَ الدَيّانُ وَالدينُ عَنكُما",1,"م",2,0],["فَاِرضَ مِن سِرّي عَلانِيَتي","أَنِفَت مِن رَفضِها شِيَمي",2,"م",2,0],["فارضَوْا بحكم الدهر","مهما كان فيه تحكُّم",3,"م",1,0],["فارضَ الَّذي أَنا مُهديهِ إِلَيهِ لَهُ","من مُرْمِضِ القَذع وارضَ النار للحطَبِ",4,"ب",1,0],["فارْضَ بالشيب إن من أعظم الخس","ران بَيْعَ انبلاجه بارْبدادِهْ",5,"د",2,0],["فارض مني بذا اليمينِ وإن كا","ن يميناً عليك فيها شناعه",6,"ع",2,0],["فارضَ بما فيه ففيه الغنى","وما سوى ذلك لا ترضه",7,"ض",2,0],["فأرض أصبحت ماء وأمسى","هواء ذلك الماء الأجاجُ",8,"ج",1,0],["فَأَرضٌ أَصابَت حَظَّها مِن سَمائِهِ","وَأَرضٌ تَأَيّى الشُربَ أَو تَرقُبُ العَدوى",9,"و",2,0],["فَاِرضوا بِما جاءَ عَفواً وَلا","تُلقوا بِأَيديكُم إِلى التَهلُكَه",10,"ه",1,0],["فَارْضَ مِنِّي بِمَا تَيَسَّرَ مِنْهَا","رُبَّ ثَمْدٍ فِيهِ غِنىً عَنْ جِمَامِ",11,"م",1,0],["فَأَرضُكَ كُلُّ مَكرُمَةٍ بَناها","بَنو تَيمٍ وَأَنتَ لَها سَماءُ",12,"ا",2,0],["فَارضي بِهَذا نَفسي الفِداءُ لَكُم","مِن كُلِّ أَمرٍ يُقَرِّبُ الأَجَلا",13,"ل",2,0],["فَارْضَهُ أفْصَحَ امرئٍ نطقَ الضَّا","دَ فقامتْ تَغَارُ منها الظاءُ",14,"ا",2,0],["فارْضَهُ جُهْدَ مُحِبٍّ مُقلٍّ","صَانَه حُبُّكَ مِنْ أَنْ يُعابا",15,"ب",2,0],["فَاِرضَ عَنّي بِحَياتي","يا حَياتي وَأَميري",16,"ر",2,0],["فَاِرضَ بِحَظِّ السُكونِ مِن تافِهِ ال","مَجدِ فَلَيسَ السُكونُ كَالحَرَكِ",17,"ك",1,0],["فَاِرضَ بِنَصفٍ وَأَزِح في القَصدِ","النَصفُ يَكفيكَ مِنَ التَعَدّي",18,"د",2,0],["فَاِرضَي بِأَشباهِ ما عَمِلتِ بِنا","لِكُلِّ نَفسٍ مِن كَفِّها حَلَبُ",19,"ب",1,0],["فَاِرضَ بِالقِسمَةِ مِن قَسّامِها","يُعدِمُ المَرءُ وَيَغدو ذا ثَرا",20,"ا",1,0],["فأَرضَكَ أَرضَكَ إن تَأتِنا","نَنَم لَيلَةً لَيسَ فيها حُلُم",21,"م",1,0],["فارض المقادير في ضر وعافية","فليس يثبت الا بالرضا قدم",22,"م",1,0],["فأرْضٌ أصَابَتْ حَظَّها مِنْ سَمائِهِ،","وأرْضٌ تأيّا الشُّرْبَ أوْ تَرْقبُ العدوَى",23,"و",2,0],["فارضَ مني بذاك اليمين وإن","كان يميناً عليك فيها شَناعه",24,"ع",2,0],["فارضوا بأسقيِة الزلال قرىً لكم","ودعوا الجِفانَ فإنها كجفونى",25,"ن",2,0],["فأرضُ رُعاءِ البَهْمِ إلا تُقِرَّه","يُعقَّرْ بنابٍ لا يُبِلُّ عقيرُها",26,"ر",3,0],["فارضٌ تليها أكرم الأرض بقعةً","وساكن أرض زرتها أسعد الناسِ",27,"س",1,0],["فارضوا بذلك منه واستوصوا به","خيرا وقولوا أنه قد أعذرا",28,"ر",2,0],["فَاِرضُوا عَدُوَّكُم ما اِستَطَعتُمُ وَخُذُوا","في قَلفِ لَوحٍ وَفي تَعبيرِ فِنطاسِ",29,"س",1,0],["فاِرضَ عنّي وكُن شَفيعي إليهِ","كلّ صَعبٍ إذا رضيت يهونُ",30,"ن",1,0],["فَاِرضَ عنّي باللَّه واِسمح وقُل لي","قَد قَبِلناك أيّها الخطّاءُ",31,"ا",2,0],["فارضٌ بنت عنها فهي قفر","وارض قد حللت بها سماء",32,"ا",2,0],["فارض بالمستطاع من طلب الرز","ق ففيما كفى اللبيب غناء",33,"ا",2,0],["فَاِرضَ بِقِلِّ الثَناءِ مِنّي فَما","تَجودُ كَفٌّ إِلّا بِما تَجِدُ",34,"د",1,0],["فَاِرضَ بِهِ قانِعاً فَنَفسي","قَد قَنِعَت مِنكَ بِالجَفاءِ",35,"ا",2,0],["فأرضاهم القوم الميامين في رضى","بضربة من للحق يرضى ويغضب",36,"ب",1,0],["فارض عني خصومي واقض يا أَملي","ديني فان حقوق الخلق أَثقال",37,"ل",1,0],["فَأَرضُها مِثلُ السَماءِ بَهجَةً","وَزَهرُها كَالزَهرِ في إِشراقِها",38,"ق",3,0],["فأَرضٌ زَهَتْ","بالشموسِ الوضاء",39,"ا",2,0],["فارضخ إذا لعنتك مص","ر فمصرُ لا ترضى المهانه",40,"ه",1,0],["فارضَ التفَكُّرَ في عُلاك لحاسدٍ","فالفكرُ فيها يُفسِدُ الكَيموسا",41,"س",2,0],["فارضَى بحزنٍ ترتجيه بتوبةٍ","تظفرْ بطيب النفس منه بلا مرا",42,"ر",2,0],["فارضَ الجحيمَ معذَّباً بلَظائها","ويكونُ حالك في العذاب بِذاذا",43,"ذ",2,0],["فأرضٌ لا تُرِي عُشباً سباخٌ","وغيثٌ لا يروّيها هُمود",44,"د",1,0],["فأرضُ اللَهِ واسعةٌ فضاءٌ","وفي أكنافِها دارٌ بدارِ",45,"ر",1,0],["فارْضَ بما قد قضى وأمضى","فبعدَ جَزرِ الخُطوب مَدُّ",46,"د",1,0],["فأَرضَيْتَ رَبَّكَ فِي ابْنِ السَّبيلِ","وَفِي العائِلِينَ من المسلمينا",47,"ن",2,0],["فأَرْضَعَتْهُ ثُدِيَّ الحربِ فِي كِلَلٍ","من القنا فَوْقَ مَهدٍ من شبا قِصَدِهْ",48,"د",2,0],["فارضَ خُلْقي أو فسلْ خصمِيَ بي","ربَّما لم ترضَ عن قوليَ سَلْني",49,"ن",2,0],["فأرضاك منّي الصدقُ لما علمتَه","ببيّنةٍ لم استعِرْها تقَوُّلا",50,"ل",2,0],["فارض فمِن قلبها خُفوقي","أُعدَى ومن طرفِها أصوبُ",51,"ب",1,0],["فأرْضُهُ لمُناويهِ وآملِهِ","جيَّاشةٌ من نَوالٍ فائِضٍ ودَمِ",52,"م",1,0],["فأرضى اللّه والعقلا جميعا","فليس عليه أن غضب اللئيم",53,"م",1,0],["فأرضته بعدَ الجِماحِ بها","حتّى تسهّلَ خُلقُه الوَعْرُ",54,"ر",1,0],["فأرضَيتُ شعرِي نَابذا لك إِنه","إذا ذُكِرَ السُّقَّاطُ في الشعر يَسقُطُ",55,"ط",1,0],["فأرضيتَ ربًّا قد دعَاكَ لبَيتِهِ","وجَدُّكَ إذ وافيتَه زائراً سُرَّا",56,"ر",2,0],["فارضوا بقلب شيقْ","فيه إليه ميلْ",57,"ل",1,0],["فارضوا فعنه النوقْ","ترضى وتمشي سيلْ",57,"ل",