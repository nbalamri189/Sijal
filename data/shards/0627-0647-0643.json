{"poems":[[74,"آه كم قد شقيت من جرب الجس","https://www.aldiwan.net/poem19424.html","الخفيف"],[53,"قد كنت أبكي لأصحاب الهوى زمنا","https://www.aldiwan.net/poem66493.html","البسيط"],[94,"قدس الله ذكره من صباح","https://www.aldiwan.net/poem38922.html","الخفيف"],[99,"أنا وحدي في البيد حيران هائم","https://www.aldiwan.net/poem24927.html","الخفيف"],[99,"يا حبيبي غيمة في خاطري","https://www.aldiwan.net/poem24929.html","الرمل"],[104,"افدي بروحي غيد اشبيليه","https://www.aldiwan.net/poem33027.html","السريع"],[48,"قد أهبط الرودة الزهراء عارية","https://www.aldiwan.net/poem22458.html","البسيط"],[78,"ظالمتي في الهوى لا تظلمي","https://www.aldiwan.net/poem38980.html","مجزوء البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85479","الرجز"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43818","الرمل"],[102,"لست أهواك","https://www.poetsgate.com/ViewPoem.aspx?id=50150",""],[119,"لي قلب على المحبة قد شب","https://www.aldiwan.net/poem40874.html","عموديه"],[128,"أهكذا حتى ولا مرحبا","https://www.aldiwan.net/poem23708.html","السريع"],[136,"عوجا العناجيج حتى تسالا الطللا","https://www.aldiwan.net/poem54775.html","البسيط"],[139,"أهكذا تفعل الألحاظ والمقل","https://www.aldiwan.net/poem49002.html","البسيط"],[203,"بي الهوى إن كنت لم تعرفي","https://www.aldiwan.net/poem45180.html","السريع"],[203,"أنا البريء ولم تبرح تعذبني","https://www.aldiwan.net/poem45240.html","البسيط"],[228,"أشكو إلى قلبك يا سيدي","https://www.aldiwan.net/poem41616.html","السريع"],[275,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[302,"أهكذا دوحة العلياء تنقصف","https://www.aldiwan.net/poem32965.html","البسيط"],[369,"أهكذا يسري القمر","https://www.aldiwan.net/poem60902.html","مجزوء الرجز"],[376,"سلو أبا الجيش جيش المكرمات ومن","https://www.aldiwan.net/poem57033.html","البسيط"],[408,"هات عن أهل الحمى ما فعلوا","https://www.aldiwan.net/poem46738.html","الرمل"],[415,"أهكذا أنا باقي العمر مغترب","https://www.aldiwan.net/poem32362.html","البسيط"],[422,"بارق الشام إلى الكرخ سرى","https://www.aldiwan.net/poem54164.html","الرمل"],[463,"بكرت هيما تحل الربطا","https://www.aldiwan.net/poem56142.html","الرمل"],[482,"با أدمعي في رسمها الجاري","https://www.aldiwan.net/poem15193.html","الرجز"],[482,"حن فأجرى للنوى دموعا","https://www.aldiwan.net/poem15204.html","السريع"],[482,"قد خان أهل الهوى قل لي بمن أثق","https://www.aldiwan.net/poem15254.html","البسيط"],[510,"البديل","https://www.aldiwan.net/poem56766.html","مخلع البسيط"],[563,"يا من تكلم فينا بالذي فيه","https://www.aldiwan.net/poem33664.html","البسيط"],[591,"جار فهيهات يرى عدله","https://www.aldiwan.net/poem17655.html","السريع"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126697","السريع"],[894,"","https://poetry.dctabudhabi.ae/diwan/poem/199380","البسيط"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107186","البسيط"],[1416,"","https://poetry.dctabudhabi.ae/diwan/poem/199193","الكامل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115993","البسيط"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203660",""],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89559","البسيط"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88707","السريع"],[2431,"","https://poetry.dctabudhabi.ae/diwan/poem/139813",""],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93647","البسيط"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205837","السريع"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79698","الخفيف"],[3167,"","https://poetry.dctabudhabi.ae/diwan/poem/136895","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68030","البسيط"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112292","الرمل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112297","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91388","البسيط"],[3708,"","https://poetry.dctabudhabi.ae/diwan/poem/123840","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117927","السريع"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117948","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85012","المديد"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111465","المتقارب"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199077","البسيط"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93312","البسيط"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102737","البسيط"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45042","البسيط"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81243","السريع"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81248","السريع"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83663","الخفيف"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35082","البسيط"],[4625,"","https://poetry.dctabudhabi.ae/diwan/poem/124119","الرجز"],[4691,"حالة العشاق","https://www.poetsgate.com/ViewPoem.aspx?id=177008",""],[4757,"جوانحي لسواكم قطّ مَا جنحت","https://www.poetsgate.com/ViewPoem.aspx?id=189294",""],[4759,"من يهدني عرشها؟","https://www.poetsgate.com/ViewPoem.aspx?id=204019",""],[4764,"جرح عادي","https://www.poetsgate.com/ViewPoem.aspx?id=37075",""],[4767,"الأخوة الضائعة","https://www.poetsgate.com/ViewPoem.aspx?id=180928",""],[4862,"من ربى الطائف جاءت كالندى","https://www.poetsgate.com/ViewPoem.aspx?id=118842",""],[5076,"قلمي يحاورني","https://www.poetsgate.com/ViewPoem.aspx?id=179336",""],[3591,"يا وجوه الجمال في أرض باري","https://www.poetsgate.com/ViewPoem.aspx?id=149479",""],[5183,"المستميت على الأوطان","https://www.poetsgate.com/ViewPoem.aspx?id=180173",""],[5305,"الاستسعاد بمدح سيد الأسياد","https://www.poetsgate.com/ViewPoem.aspx?id=187378",""],[5455,"القلوب الطيبه","https://www.poetsgate.com/ViewPoem.aspx?id=34404",""],[470,"شكرا دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=64693",""],[5631,"هْلْ أحبَبْتُ طِفلًاقَرَوِيًّا..؟","https://www.poetsgate.com/ViewPoem.aspx?id=210490",""],[5674,"دموعي فوق أهدابي ملح","https://www.poetsgate.com/ViewPoem.aspx?id=189088",""],[5703,"قل كل شيءٍ","https://www.poetsgate.com/ViewPoem.aspx?id=208793",""],[5720,"الوَعد","https://www.poetsgate.com/ViewPoem.aspx?id=207828",""],[5739,"فرحة بخيل ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131229",""],[5763,"انتحار الحلم","https://www.poetsgate.com/ViewPoem.aspx?id=27076",""],[4615,"يا عمروُ أينَ عُمَيْرٌ من كُدَى يَمَنٍ","https://www.poetsgate.com/ViewPoem.aspx?id=17825",""],[5874,"سَلوَى","https://www.poetsgate.com/ViewPoem.aspx?id=202033",""],[5956,"كل يوم نحن في حب جديد","https://www.poetsgate.com/ViewPoem.aspx?id=182078",""],[5956,"أنا وشقيقي والحمامة","https://www.poetsgate.com/ViewPoem.aspx?id=184560",""],[6102,"هبط الليل","https://www.poetsgate.com/ViewPoem.aspx?id=185296",""],[6170,"دمعة إلى آخره","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86033&r=&rc=4",""]],"verses":[["آه كم قد شقيت من جرَب الجس","م وكم ذا حالي به مفروق",0,"ق",1,1],["أهكذا يجدُ العشاقُ كلهمُ","يا رحمتي للمحبين المساكين",1,"ن",1,0],["آهِ كم يُسْعِدُ الجمالُ ويُشْقي","مِنْ قلوبٍ شِعْرِيَّةٍ وعقولِ",2,"ل",1,0],["آهِ كم ليلةٍ أراجعُ أيا","مِي أعُدُّ العُلَى وأُحصِي العظائم",3,"م",1,0],["آهِ كم أغدو صغيراً حاجتي","لك كالطفل إلى رحمة أم",4,"م",1,0],["آه كم من وتر نام على","صدر عود نومَ غاف مطمئن",4,"ن",1,0],["أهكذا كانت هناك الحياة","متْرَفَةَ الأّيَّام ملءَ الضلوع",5,"ع",1,0],["أهكذا الفتنةُ في الغانيات","ونشوةُ الوْصلِ وحَرُّ الولوع",5,"ع",1,0],["أَهَكَذا كانَ أَهلُ الأَرضِ قَبلَكُمُ","أَم غَيَّروا بِسَجايا مِنهُمُ فُسُدِ",6,"د",1,0],["أَهكذا باطلاً عاقَبتنِي","لا يَرحمُ اللَّهُ مَن لم يَرحمِ",7,"م",1,0],["أَهَكَذا أَشقى","في كُلِّ أَيامي",8,"ي",1,0],["آه كَم أصبح مِن عَب","دِ الغَنِيِّ الحُلوِ خِلوا",9,"و",2,0],["آه كم عشت في هواك وكم","مرّغت فيه فتوّتي والإباء",10,"ا",2,0],["آه كم تفعل الصبابة بالصب","زهموا ان من تشاغل بالحب",11,"ب",1,0],["أهكذا حتى ولا مرحبا","للّه أشكو قلبك القلبا",12,"ب",2,1],["أهكذا حتى ولا نظرة","أُلمح فيها ومض شوق خبا",12,"ب",2,0],["أهكذا حتى ولا لفتة","أنسم منها عرفك الطيبا",12,"ب",2,0],["أهَكَذَا تَفعَلُ الشُّمُّ الكِرَامُ إِذَا","وَافي الوُفُودُ الكِرَامُ السَّادَةَ الفُضُلا",13,"ل",2,0],["أهكذا تفعل الألحاظ والمقلُ","وتفتك البِيض أو هل تطعن الأسَل",14,"ل",1,1],["أهكذا كلّ لحاظِ الدُّمى","وكلُّ قدٍّ للدمى أهيفُ",15,"ف",1,0],["أهكذا ظبيةُ الوادي التي ذكروا","أمِ الظباءُ في وادٍ وهي في وادي",16,"د",2,0],["أَهكَذا كنتَ وَكانَ الهَوى","في عَهدِ سُلطانِ الصبا الأَيِّدِ",17,"د",1,0],["أهكذا كانت الحمراءُ موحشةً","إذ كنتَ ترمقُ أفواجَ المغنينا",18,"ن",2,0],["أَهَكَذا دَوحةُ العَلياء تَنقصِفُ","وَهَكَذا الشَمسُ في الآفاقِ تنكسِفُ",19,"ف",1,1],["أهكذا يَسْري القَمَرْ","واللّيلُ مُسوَدُّ الطُّرَرْ",20,"ر",1,1],["أهكذا الدهرُ لا ينفكُّ نائِلُهُ","حتَّى يُقيمَ لقَيسٍ حاتِمَ اليَمَنِ",21,"ن",1,0],["آه كم أُتْبعُ زَفْرات الهوى","زَفَراتٍ بعدَها تَتّصِلُ",22,"ل",1,0],["أهكَذا أنَا بَاقِي العمرِ مُغترِبٌ","نَاءٍ عن الأهلِ والأوطانِ والسّكَنِ",23,"ن",1,1],["آه كم ليلة طالتْ وقد","ذكروا نجداً وهمٍّ قصرا",24,"ر",2,0],["آهِ كم فيكنّ لي من نظرةٍ","قتلتْ عمداً وكانت غلطا",25,"ط",2,0],["أهكذا كلُّ محبًّ اِذا","فارقَ أمسى غيرَ صبّارِ",26,"ر",1,0],["أهكذا أضحتْ مواثيق الهوى","مضاعةً لاتَعدِمُ المُضيعا",27,"ع",2,0],["أهكذا مثلَ ما ألقاه مِن شَجَنٍ","قد كانَ مَنْ وَلِعوا بالحبَّ أو عشقوا",28,"ق",3,0],["أهكذا كنتِ يومَ كنتِ؟","ويْلاهُ ما يَفعلُ الغروبُ!",29,"ب",1,0],["أهكذا ملة الإسلام تأمركم","أم قد سلكتم عن الإسلام في تيه",30,"ي",2,0],["أَهَكَذا بِاللَّهِ أَخْلاقُهُ","في الحُبِّ أَمْ عَلَّمَهُ أَهْلُهُ",31,"ل",2,0],["أهكذا الآداب والعلم لا","ينالُها إلّا عريق النسبِ",32,"ب",1,0],["أهكذا كل من قد ملَّ يعتذرُ","ويعقب المدح ذمٌّ منه مُبتكرُ",33,"ر",1,1],["أَهَكَذا تَنقضِي الأَيّامُ عاطِلَةً","مِن حَليِ وَصلِكُمُ يا مُنتَهَى الأَرَبِ",34,"ب",1,0],["إه كان ما فاضت فقلت ألزمتها","صلة الشهاد وسمتها هجر الكرى",35,"ر",2,0],["أهكذا تذهبُ الليالى","ولا كتابٌ ولا رسول",36,"ل",1,0],["\"أهكذا الشرع\" في المعنّى \"ال","عذري\" والحكم بالظنون",37,"ن",1,0],["أَهكَذا البَدرُ تُخفي نورَهُ الحَفرُ","وَيُفقَدُ العِلمُ لا عَينٌ وَلا أَثَرُ",38,"ر",1,1],["أهكذا تسلك بين الورى","ما بين تفريط وإفراط",39,"ط",1,0],["اهكذا الحزم وَتاللَه ما","جئت من الحزم بقيراط",39,"ط",1,0],["أهكذا كان تحرير الشعوب وما","قد أمل الناس من سلم وعمران",40,"ن",1,0],["أَهكَذا بَرَكات الأَرض تَرتَفع","وَطائر اليمن مِن أَوكاره يَقَع",41,"ع",1,1],["أَهكَذا سابِغات المَجد نَسلبها","أَهكَذا بيضة الإِسلام تَنصدع",41,"ع",1,0],["أَهكَذا الشَرع تَذري العاصِفات بِهِ","أَهَكَذا شَجرات العرف تَقتلع",41,"ع",1,0],["أَهكَذا للعلا تَجتز ناصية","أَهكَذا مارن الإِيمان يَجتَدع",41,"ع",1,0],["أهكذا تمضي الليالي بنا","والشهر ينسلّ من الشهر",42,"ر",1,0],["آه كم يظلم الفتاة أناس","يتناسون حقها المبذولا",43,"ل",2,0],["أهكذا حرمة الصديق قد هتكت","أليس في قبر خير المسلمين خبي",44,"ب",2,0],["أهكذا عمر الفاروق قد هتكوا","محله إن ذا من أعجب العجب",44,"ب",1,0],["أهكذا صحبةُ الأشرافِ يَا زمني","يكون من قربِهم للمرءِ خسران",45,"ن",1,0],["آه كم في هذه الدّنيَا جَهُول","لَو تُناديهِ لَنَادَيتَ الجَماد",46,"د",1,0],["آهِ كَم من زَفرَةٍ أرسَلتُهَا","مِثل بَرقٍ ضَحِكت بينَ الغيوم",47,"م",1,0],["أَهكذا تَرتَضي صَبَّ الدُموعِ عَلى","رَسمِ الرُبوع بَعيدٌ ذاك لَولاكِ",48,"ك",1,0],["أهكذا الفضة البيضاء قد نبتت","غصن وزهر بها في الخد عقيان",49,"ن",1,0],["أهكذا يصنع من يدعي","شهامة النفس لدى فخره",50,"ر",2,0],["أهكذا ليت شعري كل ذي كرم","يصبيه تذكاره المأوى ويقلقه",51,"ق",2,0],["آهٌ كادَ البُعدُ يُتلِفُني","حالَتي مِن أَعظَمِ العِبَرِ",52,"ر",1,0],["أَهَكطُورُ مَن زَفسَ بالعَقلِ حاكى","أَلا ما استَمَعتَ مُطِيعاً أَخاكا",53,"ك",2,0],["أهكذا أنا والأيام في شغب","والعيش أرمضه حينا على برض",54,"ض",1,0],["أهكذا لم يكن في الناس ذو شَجَن","إِلاّ صَبا كلّما هبَّتْ عليه صَبا",55,"ب",2,0],["أهكذا الحب يضنى القلب بالفكر","والجسم بالقسم والأجفان بالسهر",56,"ر",1,0],["أَهَكَذا الشعبُ أَم قَصرُ الخوَرنق أَم","غُمدانُ أَم ما بَنو مَروانَ قَد رَصَفوا",57,"ف",3,0],["أَهكَذا تنضب أَيامه","وَأَنتَ ما تَبرح ضافي الجَلال",58,"ل",1,0],["أَهَكَذا عَوفيت يا فاتر","يَملأ دُنياكَ الهَوى الآسر",59,"ر",1,1],["أَهَكَذا أَنتَ حريب الهَوى","ملء يَديك الوتر الخائر",59,"ر",1,0],["آه كم ذا أهيم في كلّ وادٍ","وَالأَسى بي مبرّحٌ بِدوامِ",60,"م",1,0],["أَهكَذا تَنقَضي نَفسي لَدَيكَ ظَماً","اللَهَ في رَمَقٍ مِن جارِكِ الجُنُبِ",61,"ب",1,0],["أهكذا يكون حال الخل","ومثلكم يبت حبل الوصل",62,"ل",1,0],["أهكذا حالة العشاق إن عشقوا","يحاولونَ وصولا والمدى لهبُ",63,"ب",1,0],["أهكذا كل صب بَاعَ مهجته","فِي حبكم غير برح الشوق مَا ربحت",64,"ت",1,0],["أهكذا هو؟ قالت وهي عالمة","عن كيف تقرؤني فيما تحاكيني",65,"ن",2,0],["آه كثر اللي هدرته في غيابه من غرام","والهواجس تحتويني بين غفوات ووعي",66,"ع",2,0],["أهكذا يكون بعد الذي","رأيتَ منا يا أخَيَّ الوفا",67,"ف",2,0],["آهِ كم بات فؤادي عاشقا","ذابَ وجداً ثم غنّى مجهدا",68,"د",2,0],["آهِ كمْ أججتَ جذواتِ الورى","وسحبتَ العزَّ من فوقِ القممْ",69,"م",1,0],["آه كم يا وجوه من حسراتٍ","لك منا وزفرةٍ وأنين",70,"ن",1,0],["أهكذا الدهر إن تحفظ إخاءك في","أخ تنمر أو في صاحب وثبا",71,"ب",2,0],["اهكذا يا رسول الله تطعننا","ايدى الجناة وعزم الشرق مكبول ؟",72,"ل",1,0],["اهكذا يا رسول الله يجرقنا","موج العدى ودم الاسلام مطلول ؟",72,"ل",1,0],["اهكذا يارسول الله عاملنا","(صهيون) من غره للحق تحويل ؟",72,"ل",1,0],["آه كان الشعر راح ورحتي انتي وش بقى","مابقى لي غير اجر الصوت وأسري يادلال",73,"ل",1,0],["أهَكذا.. بينَ خَفْقَيْ ظُلمَةٍ وَسَنىً","تَلوحُ طفلا ً..فَشَيخا ً.. ثمَّ تَنسَحِقُ",74,"ق",1,0],["آهِ.. كم ضيَّعتُ عمرًا.. ليتَ أنِّي","عِشتُه.. طفلًا.. صبِيًّا.. وفتِيًّا",75,"ي",2,0],["آه ... كم عانيتُ أوجاعا وفقدا","ليس يجدي بعد ذاك الفقد مدح ُ",76,"ح",1,0],["أهكَذا ... يا أمير القَلبِ تَترُكُني","في الظَّنِّ أضْربُ أخْماسي بأسْداسي",77,"س",2,0],["أهٰكذا بعد ما أعطاكَ مُهْجَتهُ","يكونُ ردُّكَ بعدَ الوعدِ مُختَزَلا ؟!",78,"ل",2,0],["آه ...! كم ود ٍ نحرته له فدي.","كيف يرضى من مشاعرنا قتيل.؟",79,"ل",1,0],["أهكذا يستحيل العشق أوسمةً","مملوءةً بطيوب تشعلُ الزمنا",80,"ن",2,0],["أهكذا يارفيقَ الدربِ..... أشرعتي","حيرى تغازل في مينائها السفنا؟",80,"ن",2,0],["أهكذا ينقضي نفسي لديك ظماً","اللهَ في رمقٍ من جاركِ الجنبِ",81,"ب",1,0],["أَهَكَذَا أَنْتَهِي بَيْتًا لِشَاعِرِهِ","وَقِصَّةً فِي أَمَاسِيِّ الْهَوَى تُرْوَى",82,"و",2,0],["آهِ كلُّ العمر يفنى","‏ ‏ وهو يبقى لي يميلْ",83,"ل",1,1],["آه كم خِفْنا سلاماً وأَمِنَّا","لحروب حقَّقَتْ هدرَ السَّلامةْ",84,"م",2,0],["آهِ , كَمْ بَاتَ - يَا أُمَيمَةُ - فَرْقٌ","بَينَنَا , بَلْ مَا بَينَنَا شَتَّانا",85,"ن",2,0],["آه ِكم أخجلُ منها حينما","تمنحُ المعنى ولا يمنحُها",86,"ح",3,0]]}