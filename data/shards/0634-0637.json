{"poems":[[41,"طرق الخيال فمرحبا ألفا","https://www.aldiwan.net/poem42368.html","أحذ الكامل"],[88,"خاض الدجى وظلام الليل مختلط","https://www.aldiwan.net/poem44831.html","البسيط"],[89,"خمسة طاروا من عيون الشباب","https://www.aldiwan.net/poem44625.html","الخفيف"],[85,"في ذي الجفون مصارع الأكباد","https://www.aldiwan.net/poem6821.html","الكامل"],[62,"يا قاسي القلب لم يترك صنيعك من","https://www.aldiwan.net/poem52407.html","البسيط"],[45,"شط من ساكن الغوير مزاره","https://www.aldiwan.net/poem63580.html","الخفيف"],[45,"شرط الإنصاف لو قيل اشترت","https://www.aldiwan.net/poem64647.html","الرمل"],[2,"شطت أميمة بعدما صقبت","https://www.aldiwan.net/poem25042.html","الكامل"],[2,"قف بالديار التي لم يعفها القدم","https://www.aldiwan.net/poem25057.html","البسيط"],[31,"إعتادني بعد سلوة حزني","https://www.aldiwan.net/poem41290.html","المنسرح"],[31,"ألما بذات الخال فاستطلعا لنا","https://www.aldiwan.net/poem41818.html","الطويل"],[74,"وعاذر قد كان لي عاذلا","https://www.aldiwan.net/poem13215.html","السريع"],[74,"وحلة من طراز النظم رائعة","https://www.aldiwan.net/poem13227.html","البسيط"],[50,"شط بسلمى عاجل البين","https://www.aldiwan.net/poem24574.html","السريع"],[50,"راحت سليمى تدعوك بالعند","https://www.aldiwan.net/poem63952.html","المنسرح"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20989","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54626","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142005","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43721","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54229","الكامل"],[113,"شطر من الموت الفرا","https://www.aldiwan.net/poem41477.html","مجزوء الكامل"],[155,"نَعْيُ حَيٍّ","https://www.aldiwan.net/poem23653.html","الخفيف"],[176,"الطريد","https://www.aldiwan.net/poem50688.html","الكامل"],[193,"شطت بجارتك النوى فتحمل","https://www.aldiwan.net/poem54423.html","الكامل"],[195,"لا الروض روض ولا الصهباء صهباء","https://www.aldiwan.net/poem39803.html","البسيط"],[195,"صديان يغلي في حشاه المرجل","https://www.aldiwan.net/poem39876.html","الكامل"],[283,"الحكم حكمك والرضاء رضاكا","https://www.aldiwan.net/poem39343.html","الكامل"],[298,"شط المزار بجدوى وانتهى الأمل","https://www.aldiwan.net/poem45468.html","البسيط"],[362,"البحر أجمع لو غدا أنقاسي","https://www.aldiwan.net/poem60869.html","الكامل"],[406,"هذا كتاب فتى أحلته النوى","https://www.aldiwan.net/poem32249.html","الكامل"],[406,"أعلمت ما فعلت به أجفانه","https://www.aldiwan.net/poem32364.html","الكامل"],[406,"يا ناق شطت دارهم فحني","https://www.aldiwan.net/poem32367.html","الرجز"],[426,"أرج الصبابة من ثنائك عارف","https://www.aldiwan.net/poem40081.html","الكامل"],[450,"يا روضة الود التي لم تزل","https://www.aldiwan.net/poem13787.html","السريع"],[456,"ما ناشر ذو مخاليب","https://www.aldiwan.net/poem56163.html","المجتث"],[512,"شط العرب إن طفح جوده ومده طما","https://www.aldiwan.net/poem20930.html","المواليا"],[538,"شطت وفي النفس مما لست ناسيه","https://www.aldiwan.net/poem56895.html","البسيط"],[549,"أيها اللائم الذي لا يمل اللوم","https://www.aldiwan.net/poem47139.html","الخفيف"],[549,"شطت عليك لبانة الصدر","https://www.aldiwan.net/poem47783.html","أحذ الكامل"],[560,"شوقي إليك كما علمت طويل","https://www.aldiwan.net/poem52957.html","الكامل"],[565,"شطت لليلى باللوى","https://www.aldiwan.net/poem69615.html","مجزوء الرجز"]],"verses":[["شَطَّت فَشَفَّ القَلبَ ذِكرُكَها","وَدَنَت فَمَا بَذَلَت لَنا عُرفَا",0,"ف",2,0],["شَطّوا بأقوالهم حتى لقد غضِبوا","إذ قلتُ يا قوم في أقوالكم شَطَط",1,"ط",1,0],["شطت الدار بالاحبة عنا","وعسى من ناى بهم ان يعيدا",2,"د",2,0],["شطت بنا فلك الأمور فكن لنا","في بحر حيرتنا المنار الهادى",3,"د",2,0],["شَطَّ المزارُ فلا كُتْبٌ ولا خَبَرٌ","ما ضرَّ لو كنتَ تُهْدِي الكُتْب والخَبَرا",4,"ر",2,0],["شَطَّ مِن ساكِنِ الغُوَيرِ مَزارُه","وَطَوَتهُ البِلادُ فَاللَهُ جارُه",5,"ر",2,1],["شَطَطٌ أَعوَجُ ما كَلَّفتَني","وَمِنَ الجَورِ تَكاليفُ الشَطَط",6,"ط",1,0],["شَطَّت أُمَيمَةُ بَعدَما صَقِبَت","وَنَأَت وَما فَنِيَ الجِنابُ فَيَذهَبُ",7,"ب",1,1],["شَطَّت بِهِم قَرقَرى بِركٌ بِأَيمُنِهِم","وَالعالِياتُ وَعَن أَيسارِهِم خِيَمُ",8,"م",1,0],["شَطَّت دِيارُ الحَبيبِ فَاِغتَرَبَت","هَيهاتَ شَعبُ الحَبيبِ مِن وَطَني",9,"ن",2,0],["شَطونٌ بِأَهواءٍ نَرى أَنَّ قُربَنا","وَقُربَكُمُ إِن يَشهَدِ الناسُ مَوسِما",10,"م",2,0],["شَطَّ وَلي مِن شَغَفٍ فِكرَةٌ","أَراهُ في مِرآتِها ماثِلا",11,"ل",2,0],["شَطَّت بِهِ الدارُ فَاِستَرعى تَحَيَّتَهُ","نَسيمَ عاطِرَةِ الأَذيالِ مِكسالِ",12,"ل",1,0],["شَطَّ بِسَلمى عاجِلُ البَينِ","وَجاوَرَت أُسدَ بَني القَينِ",13,"ن",1,1],["شَطَّ عَلَيَّ الهَوى يُكَلِّفُني","لُقيانَ سُعدى وَلَيسَ بِالصَدَدِ",14,"د",1,0],["شَطَّ وَصلُ الَّذي تُرِيدينَ مِنيِّ","وصَغيرُ الأُمورِ يَجني الكَبيرا",15,"ر",2,0],["شُطِرَ الْعَقِيقُ فَفَائِضٌ فِي جَانِبٍ","مَجْرَى الْحَيَاةِ وَغَائِضٌ فِي جَانِبِ",16,"ب",1,0],["شطران قلبيَ شطرٌ للمقيمِ بهِد","على الوفاء وشطرٌ للذي نزَحا",17,"ح",2,0],["شِطنا عَلَيهِ وَكُنّا","عَلى القَنا لا نَشيطُ",18,"ط",1,0],["شَطَّتْ مَنَازِلُنَا وَمَا","احْتَاجَ الْفْؤَادَ إِلَى بَرِيدِ",19,"د",1,0],["شطر من الموت الفرا","ق فآه من ألم الفراق",20,"ق",1,1],["شطُّ بَحْرِي عَلَى سَوَاحِلِ دَهْرِي","في انبِسَاطٍ على بساطِي يُقلَّمْ",21,"م",1,0],["شَطّت بهِ نارُ النّوى لمّا نَوى","أنْ يَنْتوي لَوْ مَرّة شَطْرَ المُنى",22,"ن",2,0],["شَطّت بجارَتِكَ النَوى فَتَحَمَّلِ","وَنَأَتكَ بَعدَ مَوَدَّةٍ وَتَدَلُّلِ",23,"ل",1,1],["شطّ المزارُ فلا طيفٌ ولا أملٌ","أينَ الأخلّاء لا عاش الأخلّاء",24,"ا",2,0],["شطّت وعانقت الرؤى أطيافها","وعليه في وادي الكرى تتنزّل",25,"ل",1,0],["شطر الطريق قطعت قاصدكم وقد","عادت بي الاقدار من مولاكا",26,"ك",2,0],["شَطَّ المَزارُ بِجَدوى وَاِنتَهى الأَمَلُ","فَلا خَيالٌ وَلا عَهدٌ وَلا طَلَلُ",27,"ل",1,1],["شَطَطُ الأماني كنتُ أَحسَبُ أنّه","مَعنىً تُخَصُّ به طِباعُ النّاس",28,"س",1,0],["شَطَّتْ به عمّن يُحبُّ دِيارُهُ","وتفرّقتْ أيدِي سَبَا إِخوانُهُ",29,"ن",2,0],["شطًّتْ دِيارُك عنهُمُ وهفَا بِكَ الشْ","شَوقُ المبرِّحُ والتَظَتْ نِيرانُهُ",30,"ن",2,0],["شَطّوا وشطّتْ بيَ دَارِي عنهُمُ","وهُمْ إلى قَلبيَ أدنَى مِنّي",31,"ن",2,0],["شطت ركائبنا وشط مزاره","فالقلب وادٍ والدموع ذوارفُ",32,"ف",1,0],["شطّتْ به العيسُ لنيل المنى","وكم له في القلب من ذاكر",33,"ر",1,0],["شطرين يمشي بشطرٍ","وشطره فوق مُهرِهْ",34,"ر",2,0],["شطّ العرب إن طفح جودهُ ومدّه طما","على السويّةِ وفي الاثنين ريّ الظما",35,"م",2,1],["شَطَّت وَفي النَفسِ مِمّا لَستُ ناسِيَهُ","هَمٌّ بَعيدٌ وَحاجاتٌ أَطانيبُ",36,"ب",1,1],["شطّ عنّي لمّا اِرعَوَيتُ وقد كا","ن مقيماً أيّامَ كنتُ غَوِيّا",37,"ي",2,0],["شَطّتْ عليك لُبانةُ الصّدرِ","وحُرِمتَها من حيثُ لا تدري",38,"ي",1,1],["شَطرُ الفُؤادِ حبيبُهُ فإذا نأي","نُهِكَ الفُؤادُ فطُلَّ منه قتيلُ",39,"ل",1,0],["شَطَّتْ لِلَيْلَى بِالَّلوَى","دَارٌ وَكَانَتْ لاَ تَشُطْ",40,"ط",1,1]]}