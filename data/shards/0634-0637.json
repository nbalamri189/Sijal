tsgate.com/ViewPoem.aspx?id=121597",""],[5206,"حياة الأرواح","https://www.poetsgate.com/ViewPoem.aspx?id=187335",""],[5219,"اهات حرف","https://www.poetsgate.com/ViewPoem.aspx?id=194919",""],[5225,"عنيد تفكير","https://www.poetsgate.com/ViewPoem.aspx?id=36890",""],[5246,"سل ما تريد فقد نريك جوابا","https://www.poetsgate.com/ViewPoem.aspx?id=187074",""],[5277,"طَوارقٌ وطُرّاقٌ","https://www.poetsgate.com/ViewPoem.aspx?id=202386",""],[5277,"زينبُ القلب","https://www.poetsgate.com/ViewPoem.aspx?id=210873",""],[5277,"حوارُ الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=213696",""],[5296,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=155187",""],[5409,"هي الحياة لزامٌ عندها الألم","https://www.poetsgate.com/ViewPoem.aspx?id=155308",""],[5411,"لا تَسْتَهِنْ بِعَواطِفي","https://www.poetsgate.com/ViewPoem.aspx?id=186124",""],[5461,"حدني وقتي","https://www.poetsgate.com/ViewPoem.aspx?id=5061",""],[5497,"أتطيقُ عيشا","https://www.poetsgate.com/ViewPoem.aspx?id=206603",""],[5533,"شَطَّ المزار","https://www.poetsgate.com/ViewPoem.aspx?id=177762",""],[470,"بيضُ وجوهُ بني عمي كما الغُررُ","https://www.poetsgate.com/ViewPoem.aspx?id=18590",""],[5650,"عَائِشَة... وَحْيُ الْقَصِيد!","https://www.poetsgate.com/ViewPoem.aspx?id=131223",""],[5652,"ماعدت مثل اول مع الناس طايب","https://www.poetsgate.com/ViewPoem.aspx?id=208681",""],[5736,"شطران","https://www.poetsgate.com/ViewPoem.aspx?id=203836",""],[5739,"الغبي ..!","https://www.poetsgate.com/ViewPoem.aspx?id=155468",""],[5751,"جاءتكَ شاعرةً","https://www.poetsgate.com/ViewPoem.aspx?id=215008",""],[5910,"لِلَّيلِ في أعيُني","https://www.poetsgate.com/ViewPoem.aspx?id=206317",""],[5956,"تعريف بإسرائيل المعتدية","https://www.poetsgate.com/ViewPoem.aspx?id=194415",""],[6147,"جنوني ... بلا مدى.","https://www.poetsgate.com/ViewPoem.aspx?id=151491",""],[6149,"سبحان من صاغه وكون","https://www.poetsgate.com/ViewPoem.aspx?id=169628",""],[6152,"ميلاد قلب","https://www.poetsgate.com/ViewPoem.aspx?id=203021",""],[5377,"من أحرار اليمن إلى أحرار العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79560&r=&rc=16",""],[6291,"المجدُ والتاريخ ُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87684&r=&rc=18",""],[5126,"الطائر الغريب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87826&r=&rc=41",""]],"verses":[["شَطَّت فَشَفَّ القَلبَ ذِكرُكَها","وَدَنَت فَمَا بَذَلَت لَنا عُرفَا",0,"ف",2,0],["شَطّوا بأقوالهم حتى لقد غضِبوا","إذ قلتُ يا قوم في أقوالكم شَطَط",1,"ط",1,0],["شطت الدار بالاحبة عنا","وعسى من ناى بهم ان يعيدا",2,"د",2,0],["شطت بنا فلك الأمور فكن لنا","في بحر حيرتنا المنار الهادى",3,"د",2,0],["شَطَّ المزارُ فلا كُتْبٌ ولا خَبَرٌ","ما ضرَّ لو كنتَ تُهْدِي الكُتْب والخَبَرا",4,"ر",2,0],["شَطَّ مِن ساكِنِ الغُوَيرِ مَزارُه","وَطَوَتهُ البِلادُ فَاللَهُ جارُه",5,"ر",2,1],["شَطَطٌ أَعوَجُ ما كَلَّفتَني","وَمِنَ الجَورِ تَكاليفُ الشَطَط",6,"ط",1,0],["شَطَّت أُمَيمَةُ بَعدَما صَقِبَت","وَنَأَت وَما فَنِيَ الجِنابُ فَيَذهَبُ",7,"ب",1,1],["شَطَّت بِهِم قَرقَرى بِركٌ بِأَيمُنِهِم","وَالعالِياتُ وَعَن أَيسارِهِم خِيَمُ",8,"م",1,0],["شَطَّت دِيارُ الحَبيبِ فَاِغتَرَبَت","هَيهاتَ شَعبُ الحَبيبِ مِن وَطَني",9,"ن",2,0],["شَطونٌ بِأَهواءٍ نَرى أَنَّ قُربَنا","وَقُربَكُمُ إِن يَشهَدِ الناسُ مَوسِما",10,"م",2,0],["شَطَّ وَلي مِن شَغَفٍ فِكرَةٌ","أَراهُ في مِرآتِها ماثِلا",11,"ل",2,0],["شَطَّت بِهِ الدارُ فَاِستَرعى تَحَيَّتَهُ","نَسيمَ عاطِرَةِ الأَذيالِ مِكسالِ",12,"ل",1,0],["شَطَّ بِسَلمى عاجِلُ البَينِ","وَجاوَرَت أُسدَ بَني القَينِ",13,"ن",1,1],["شَطَّ عَلَيَّ الهَوى يُكَلِّفُني","لُقيانَ سُعدى وَلَيسَ بِالصَدَدِ",14,"د",1,0],["شَطَّتْ وزَادَتْ نَوَاهُمْ بَعْدَمَا اقْتَرَبَتْ","حِيناً وكُلُّ نَوىً يَوْماً لِمِقْدَار",15,"ر",1,0],["شَطتْ نَوَى مَنْ يَحُلُّ السِّرَّ فَالشَّرَفَا","مِمَنْ يَقِيظُ عَلَى نَعْوَانَ أَوْ عُصُفَا",16,"ف",2,1],["شَطَّ وَصلُ الَّذي تُرِيدينَ مِنيِّ","وصَغيرُ الأُمورِ يَجني الكَبيرا",17,"ر",2,0],["شُطِرَ الْعَقِيقُ فَفَائِضٌ فِي جَانِبٍ","مَجْرَى الْحَيَاةِ وَغَائِضٌ فِي جَانِبِ",18,"ب",1,0],["شطران قلبيَ شطرٌ للمقيمِ بهِد","على الوفاء وشطرٌ للذي نزَحا",19,"ح",2,0],["شِطنا عَلَيهِ وَكُنّا","عَلى القَنا لا نَشيطُ",20,"ط",1,0],["شَطَّتْ مَنَازِلُنَا وَمَا","احْتَاجَ الْفْؤَادَ إِلَى بَرِيدِ",21,"د",1,0],["شط المزار مع الحياة وويلتا","بعد الممات متى يكون مزاري",22,"ر",2,0],["شطر من الموت الفرا","ق فآه من ألم الفراق",23,"ق",1,1],["شطُّ بَحْرِي عَلَى سَوَاحِلِ دَهْرِي","في انبِسَاطٍ على بساطِي يُقلَّمْ",24,"م",1,0],["شَطّت بهِ نارُ النّوى لمّا نَوى","أنْ يَنْتوي لَوْ مَرّة شَطْرَ المُنى",25,"ن",2,0],["شَطّت بجارَتِكَ النَوى فَتَحَمَّلِ","وَنَأَتكَ بَعدَ مَوَدَّةٍ وَتَدَلُّلِ",26,"ل",1,1],["شطّ المزارُ فلا طيفٌ ولا أملٌ","أينَ الأخلّاء لا عاش الأخلّاء",27,"ا",2,0],["شطّت وعانقت الرؤى أطيافها","وعليه في وادي الكرى تتنزّل",28,"ل",1,0],["شطر الطريق قطعت قاصدكم وقد","عادت بي الاقدار من مولاكا",29,"ك",2,0],["شَطَّ المَزارُ بِجَدوى وَاِنتَهى الأَمَلُ","فَلا خَيالٌ وَلا عَهدٌ وَلا طَلَلُ",30,"ل",1,1],["شَطَطُ الأماني كنتُ أَحسَبُ أنّه","مَعنىً تُخَصُّ به طِباعُ النّاس",31,"س",1,0],["شَطَّتْ به عمّن يُحبُّ دِيارُهُ","وتفرّقتْ أيدِي سَبَا إِخوانُهُ",32,"ن",2,0],["شطًّتْ دِيارُك عنهُمُ وهفَا بِكَ الشْ","شَوقُ المبرِّحُ والتَظَتْ نِيرانُهُ",33,"ن",2,0],["شَطّوا وشطّتْ بيَ دَارِي عنهُمُ","وهُمْ إلى قَلبيَ أدنَى مِنّي",34,"ن",2,0],["شطت ركائبنا وشط مزاره","فالقلب وادٍ والدموع ذوارفُ",35,"ف",1,0],["شطّتْ به العيسُ لنيل المنى","وكم له في القلب من ذاكر",36,"ر",1,0],["شطرين يمشي بشطرٍ","وشطره فوق مُهرِهْ",37,"ر",2,0],["شطّ العرب إن طفح جودهُ ومدّه طما","على السويّةِ وفي الاثنين ريّ الظما",38,"م",2,1],["شَطَّت وَفي النَفسِ مِمّا لَستُ ناسِيَهُ","هَمٌّ بَعيدٌ وَحاجاتٌ أَطانيبُ",39,"ب",1,1],["شطّ عنّي لمّا اِرعَوَيتُ وقد كا","ن مقيماً أيّامَ كنتُ غَوِيّا",40,"ي",2,0],["شَطّتْ عليك لُبانةُ الصّدرِ","وحُرِمتَها من حيثُ لا تدري",41,"ر",2,1],["شَطرُ الفُؤادِ حبيبُهُ فإذا نأي","نُهِكَ الفُؤادُ فطُلَّ منه قتيلُ",42,"ل",1,0],["شَطَّتْ لِلَيْلَى بِالَّلوَى","دَارٌ وَكَانَتْ لاَ تَشُطْ",43,"ط",1,1],["شَطَّت رُقَيَّةُ عَن بِلا","دِكَ فَالهَوى مُتَشاعِبُ",44,"ب",1,1],["شَطَّ المَزارُ وَحالَ دُونَ لِقائِهِ","أُسدٌ حَمَتنِي أَن أَدُورَ بِدارِهِ",45,"ر",2,0],["شَطَّت نَوى مَن دارُهُ بِالإيوان","إيوانِ كِسرى ذي القُرى وَالرَيحان",46,"ن",1,1],["شطّي هناك تثلمت أسواره","ورجاي أن يبقى بناؤك أصلبا",47,"ب",2,0],["شطوط انهارها بالحب تملا","وتسقيها الروايح بالرواحِ",48,"ح",1,0],["شط المزار فهل للقرب ميعاد","وهل على حوض وادي الجزع",49,"ع",1,1],["شطراً محاسنها التي اشتهرت","إما شكا شطر بكى شطر",50,"ر",1,0],["شطلجة لا تنفك عنها خضارم","كذلك لا تنفك عنك خضارم",51,"م",1,0],["شَطرنجنا لمثل هَذا وَضعا","أَول فَن في العُلوم اِخترعا",52,"ع",2,0],["شطرهم الإسقاط في بحر الجرز","وفي السريع نصف بيت قد برز",53,"ز",1,0],["شطر ثوى بين أوليه عذبني","وهاج لي شجنا من قبله اكتتما",54,"م",2,0],["شطرته لك عاجلا","فكأنما انشق القمر",55,"ر",1,0],["شط المزارُ فقطِّعوا صِلةَ النّوى","فالعودُ أحمدُ للدّيار وأَرفق",56,"ق",1,0],["شَطَحْتُ بِهَا شَرْقَاً وَغَرْبَاً وَقِبْلَةً","وَبَرَّاً وبحراً مِنْ نَفَائِسِ خَمْرَتِي",57,"ي",1,0],["شطّ المزار بهم عن عقر دارهم","وقلّمت لهم الأيام أظفارا",58,"ر",2,0],["شطت ولم تثب الرباب","ولعل للكلف النواب",59,"ب",1,1],["شطت به الدار والأوطان نازحة","بالأهل والدهر ذو صرف وتلوين",60,"ن",1,0],["شط اصطباري يوم","شط مزارها وتجلدي",61,"د",2,0],["شَطون البِيدِ غامِضَةٍ صُواهُ","رَمَيتُ بِهِ السَجَوجاةَ الدِفاقا",62,"ق",2,0],["شَطَّ المَزارُ أَعلَنَ في هَواكَ بِسِرِّهِ","فَالبينُ أَحوَجَهُ إِلى إِعلانِهِ",63,"ه",1,0],["شط النوى بأحبتي فجفوني","فتواصلت بالمرسلات جفوني",64,"ن",2,1],["شَطَّت بَجَمرَةَ دارٌ بَعدَ إلمامِ","نَأَي وَطول بِعادٍ بَينَ أَقوامِ",65,"م",1,1],["شط به من ريم لا وطاني","حال ما تتتتيبر اكسوره",66,"ر",2,0],["شطّ بي واضناني الهايس","منك وادعى النّفس مضروره",67,"ر",2,0],["شطران يومك للندى بعض","والمكرمات وللردى بعض",68,"ض",1,0],["شَطت نَواها وَحانَت غُربَةٌ قَذَفٌ","وَذِكرُ ما قَد مَضى بالمَرءِ تَفنيدُ",69,"د",1,0],["شَطَنَت هَكَذا شَوارِدُ بِالمِص","رِ وَعَنّي لَم يُلهِهِ التَّربيصُ",70,"ص",1,0],["شطر الحياة مضى والنفس ناقصة","فكن مكملها في شطرها الباقي",71,"ق",2,0],["شَطَّت نَواهم بِشَمس في هَوادجهم","لَولا تلألؤها في لَيلهنَّ عَشُوا",72,"ش",3,1],["شطب بطيخك وقت الصبا","طوعاً كما أخبرت تشطيبا",73,"ب",2,1],["شط المزار وَبيننا حالَ العدا","يا بغيتي ومحلّ ودي الأقدم",74,"م",1,0],["شَطّ بْحِشا لِفْواد مِنْ شَطّ","وعَنْكُمْ سِلينا فِيْ هوى ناسْ",75,"س",1,1],["شَططَ عَذلُكَ مِثلي","لَم يُرِد ذَاكَ رَشيدُ",76,"د",1,0],["شطّ المَزَارُ بهذا","وذاكَ منّي قريبُ",77,"ب",1,0],["شَطَّ المزارُ وَمَن تهواهمُ ارتحلوا","فَاقصِر فَما في التلاقي بَعدَ ذا أَملُ",78,"ل",1,1],["شطر نفسي دفنت والشطر باق","يتمنى ومن مناه الفناء",79,"ا",2,0],["شطت فعيني بعد فرقتها","لم تستطع أجفانها الغمضا",80,"ض",2,0],["شطَّت برايةَ عنا طيَّةٌ قِدَدٌ","زَوراء توهي قوى المهرية الأجُدِ",81,"د",1,0],["شَطرتَ قَلبِي بِمَا أولَيتَهُ سَقَمَا","حَيَّرتَهُ فَلَهَا عَن شَانِهِ وَلَهَا",82,"ل",3,0],["شطَّ المزارُ وبالعقيق أحبتي","وجرت عليهم بالعقيق جُفوني",83,"ن",2,1],["شطحت في مهمه العشاق منتشيا","والعاشق المرتوى بالسكر شطاح",84,"ح",1,0],["شَطراً أَبَرْت وَمِثلَهُ أَنْظَرتَهُ","وَقعَ الخُطوبِ تَكرُّها أَيّامُها",85,"م",3,0],["شططت فتلك أض","غاثٌ بها قلب يحدثني",86,"ي",1,0],["شَطَطتَ أََأَترِيذٌ وأَوَّلُ مُنكِرٍ","لِقَولَكَ ذَا لا تَحنَقَنَّ أَرانِيا",87,"ي",2,0],["شَطَّ المَزارُ عَلى المتيَّم انَّما","قَلب الأَحبة مغنطيسٌ جاذِبُ",88,"ب",1,0],["شطر القبول وشرطه وبه","الأعمال يوم الحشر تقتبل",89,"ل",1,0],["شَطبَةٍ رَخصَةِ الأَنامِلِ هَيفا","ءَ تَثَنّى في مَشيِها خَطّارَه",90,"ر",2,0],["شططا قلت بل تبسم عما","حبرته يمين رب النباله",91,"ل",2,0],["شطاراً وأقطاراً بفيحاءِ شرقنا","دياراً وامصاراً بغربٍ وغربةِ",92,"ه",1,0],["شطَّت بِهِ عَنِّي نَوىً لمغرِّبِ","يُهديِ التَّحيةَ في رحالِ مُشرِّقِ",93,"ق",1,0],["شَّطرتُ أبياتَك بل شاطرتُك","الوجدَ بريمٍ للوصال قَد أبى",94,"ب",2,0],["شَطّت بها غُربةٌ زوراءُ نازحةٌ","فطارت النفسُ من وجدٍ بها قطعا",95,"ع",2,0],["شطت نواه عن الأليف وساقه","لقرًى يمانيةٍ حمام كتاب",96,"ب",1,0],["شط المزار واصبح الأخوان بال","شهباء ذاك وذا بغرب بلاد",97,"د",1,0],["شَطْرُه مالكٌ ومقلوبُ باقِي","هِ يُصيب الإنسانَ في الأحْيانِ",98,"ن",1,0],["شطّ مسراكم فشطّ اغترابُ","أفهلا بعد البعاد اقترابُ",99,"ب",1,1],["شَطَرَتْنا الأيام شرقاَ وغرباً","فانقسمنا في الأرض حَدّاً فحدّا",100,"د",2,0],["شطا بلا بحر تضج رماله","فنبذته قلبا ي