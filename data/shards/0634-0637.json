{"poems":[[41,"طرق الخيال فمرحبا ألفا","https://www.aldiwan.net/poem42368.html","أحذ الكامل"],[88,"خاض الدجى وظلام الليل مختلط","https://www.aldiwan.net/poem44831.html","البسيط"],[89,"خمسة طاروا من عيون الشباب","https://www.aldiwan.net/poem44625.html","الخفيف"],[85,"في ذي الجفون مصارع الأكباد","https://www.aldiwan.net/poem6821.html","الكامل"],[62,"يا قاسي القلب لم يترك صنيعك من","https://www.aldiwan.net/poem52407.html","البسيط"],[45,"شط من ساكن الغوير مزاره","https://www.aldiwan.net/poem63580.html","الخفيف"],[45,"شرط الإنصاف لو قيل اشترت","https://www.aldiwan.net/poem64647.html","الرمل"],[2,"شطت أميمة بعدما صقبت","https://www.aldiwan.net/poem25042.html","الكامل"],[2,"قف بالديار التي لم يعفها القدم","https://www.aldiwan.net/poem25057.html","البسيط"],[31,"إعتادني بعد سلوة حزني","https://www.aldiwan.net/poem41290.html","المنسرح"],[31,"ألما بذات الخال فاستطلعا لنا","https://www.aldiwan.net/poem41818.html","الطويل"],[74,"وعاذر قد كان لي عاذلا","https://www.aldiwan.net/poem13215.html","السريع"],[74,"وحلة من طراز النظم رائعة","https://www.aldiwan.net/poem13227.html","البسيط"],[50,"شط بسلمى عاجل البين","https://www.aldiwan.net/poem24574.html","السريع"],[50,"راحت سليمى تدعوك بالعند","https://www.aldiwan.net/poem63952.html","المنسرح"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20989","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54626","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142005","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43721","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54229","الكامل"]],"verses":[["شَطَّت فَشَفَّ القَلبَ ذِكرُكَها","وَدَنَت فَمَا بَذَلَت لَنا عُرفَا",0,"ف",2,0],["شَطّوا بأقوالهم حتى لقد غضِبوا","إذ قلتُ يا قوم في أقوالكم شَطَط",1,"ط",1,0],["شطت الدار بالاحبة عنا","وعسى من ناى بهم ان يعيدا",2,"د",2,0],["شطت بنا فلك الأمور فكن لنا","في بحر حيرتنا المنار الهادى",3,"د",2,0],["شَطَّ المزارُ فلا كُتْبٌ ولا خَبَرٌ","ما ضرَّ لو كنتَ تُهْدِي الكُتْب والخَبَرا",4,"ر",2,0],["شَطَّ مِن ساكِنِ الغُوَيرِ مَزارُه","وَطَوَتهُ البِلادُ فَاللَهُ جارُه",5,"ر",2,1],["شَطَطٌ أَعوَجُ ما كَلَّفتَني","وَمِنَ الجَورِ تَكاليفُ الشَطَط",6,"ط",1,0],["شَطَّت أُمَيمَةُ بَعدَما صَقِبَت","وَنَأَت وَما فَنِيَ الجِنابُ فَيَذهَبُ",7,"ب",1,1],["شَطَّت بِهِم قَرقَرى بِركٌ بِأَيمُنِهِم","وَالعالِياتُ وَعَن أَيسارِهِم خِيَمُ",8,"م",1,0],["شَطَّت دِيارُ الحَبيبِ فَاِغتَرَبَت","هَيهاتَ شَعبُ الحَبيبِ مِن وَطَني",9,"ن",2,0],["شَطونٌ بِأَهواءٍ نَرى أَنَّ قُربَنا","وَقُربَكُمُ إِن يَشهَدِ الناسُ مَوسِما",10,"م",2,0],["شَطَّ وَلي مِن شَغَفٍ فِكرَةٌ","أَراهُ في مِرآتِها ماثِلا",11,"ل",2,0],["شَطَّت بِهِ الدارُ فَاِستَرعى تَحَيَّتَهُ","نَسيمَ عاطِرَةِ الأَذيالِ مِكسالِ",12,"ل",1,0],["شَطَّ بِسَلمى عاجِلُ البَينِ","وَجاوَرَت أُسدَ بَني القَينِ",13,"ن",1,1],["شَطَّ عَلَيَّ الهَوى يُكَلِّفُني","لُقيانَ سُعدى وَلَيسَ بِالصَدَدِ",14,"د",1,0],["شَطَّ وَصلُ الَّذي تُرِيدينَ مِنيِّ","وصَغيرُ الأُمورِ يَجني الكَبيرا",15,"ر",2,0],["شُطِرَ الْعَقِيقُ فَفَائِضٌ فِي جَانِبٍ","مَجْرَى الْحَيَاةِ وَغَائِضٌ فِي جَانِبِ",16,"ب",1,0],["شطران قلبيَ شطرٌ للمقيمِ بهِد","على الوفاء وشطرٌ للذي نزَحا",17,"ح",2,0],["شِطنا عَلَيهِ وَكُنّا","عَلى القَنا لا نَشيطُ",18,"ط",1,0],["شَطَّتْ مَنَازِلُنَا وَمَا","احْتَاجَ الْفْؤَادَ إِلَى بَرِيدِ",19,"د",1,0]]}