{"poems":[[53,"ما لمن حسنه الله وأعلى درجاته","https://www.aldiwan.net/poem8696.html","مجزوء الرمل"],[53,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[87,"حبذا الساحة والظل الظليل","https://www.aldiwan.net/poem7103.html","الرمل"],[30,"ليبك على الحجاج من كان باكيا","https://www.aldiwan.net/poem5316.html","الطويل"],[89,"حي مغنى الهوى بوادي الشآم","https://www.aldiwan.net/poem8286.html","الخفيف"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[132,"بموتِ المرتضى الواكي الرضى","https://www.aldiwan.net/poem50216.html","الوافر"],[136,"لا تلوماه في الهوى أو لوما","https://www.aldiwan.net/poem54746.html","الخفيف"],[185,"ألا يا سلم عوجى تخبرينا","https://www.aldiwan.net/poem58837.html","الوافر"],[193,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[267,"ألا لا تلمني إن فررت فإنني","https://www.aldiwan.net/poem68191.html","الطويل"],[354,"دار سلمى سقاك دمعي الهامي","https://www.aldiwan.net/poem15885.html","الخفيف"],[370,"إنني بالنبي موقنة نفسي","https://www.aldiwan.net/poem44475.html","الخفيف"],[422,"يمينا برب النجم والنجم إذ يسري","https://www.aldiwan.net/poem54085.html","الطويل"],[458,"في الشتاء العويل والأشجان","https://www.aldiwan.net/poem61727.html","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48804","الرمل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48858","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62531","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55886","الرمل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82267","الرمل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93094","الطويل"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44828","الخفيف"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177823","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53055","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106903","البسيط"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130748","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130753","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74178","الرمل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103873","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138454",""],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66486","الوافر"],[3663,"","https://poetry.dctabudhabi.ae/diwan/poem/111142","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44726","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123524","الطويل"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105129","الخفيف"],[4764,"المسأله","https://www.poetsgate.com/ViewPoem.aspx?id=34653",""],[5043,"وعد العرس الآتي","https://www.poetsgate.com/ViewPoem.aspx?id=203387",""],[5112,"طارق","https://www.poetsgate.com/ViewPoem.aspx?id=212407",""],[5302,"لا تسألي","https://www.poetsgate.com/ViewPoem.aspx?id=200600",""],[5688,"لكِ الرحمن يا قدسي","https://www.poetsgate.com/ViewPoem.aspx?id=214216",""]],"verses":[["وائْتَنِفْ مُؤْتَنفَ العي","ش وباكر غدواتِهْ",0,"ت",2,0],["وأيَّتما بلوى جناهَا لنفسه","وأيَّتما نُعمى وعافيةٍ غُمِطْ",1,"ط",1,0],["وأئتنفنا في ذَراها دولة","ركنها السؤدد والمجد الأثيل",2,"ل",1,0],["وَأَيتامُ سَوداءِ الذِراعَينِ لَم يَدَع","لَها الدَهرُ مالاً بِالسِنينَ الجَوالِفِ",3,"ف",1,0],["وَائْتِلافُ النُّفُوسِ أَصْدَقُ عَهْدَاً","مِنْ لِقَاءٍ لَمْ يَقْتَرِنْ بِدَوَامِ",4,"م",1,0],["وائْتِ بالمَسْتَطاع مِنْ عَمَل البر","ر فقدْ يُسْقِطُ الثِّمارَ الإِتاءُ",5,"ا",2,0],["وأيتمت الأدانى والأقاصِى","جميعاً من وضيعٍ أو عَلِىّ",6,"ا",1,0],["وائتِلاَقَ البُرُوقِ لَيلاً ولَيلَ العَاشِقِ","الدَّاجِى الطَّوِيلِ البَهِيمَا",7,"م",2,0],["وأَيتَمنَا رَبِيعَةَ مِن أَبيهِ","وَبِالشَّدّاخِ بَكَينَا العُيُونَا",8,"ن",2,0],["وَاِئتلفَت أسماءُ خيرِ من سما","لَم أتصرّف بِسوى القليلِ",9,"ل",1,0],["وَأيتمُ أَولاداً وأُرمِلُ نِسوَةً","فَكَيفَ على هذا تَرَونَ التَّقَدُّما",10,"م",2,0],["وَاِئتِمامُ العُشّاقِ بابَهُم فَر","ضٌ عَلى كُلِّ ذي جَوى وَغَرامِ",11,"م",1,0],["وائتلفنا به وكنّا عدوّاً","وَرَجَعنا به معاً إِخوانا",12,"ن",2,0],["وآيتك الآيات جئتَ بما انطَوَتْ","عليها من الأَسرار في السر والجهر",13,"ر",1,0],["وائتلاقُ الحلِّى غَطَّينَ قَزماً","شررق للنفوسِ لا طَيلسانث",14,"ن",2,0],["وائتمناهم على العه","د فلم نلق أمينا",15,"ن",2,0],["وائتلفتم وبعضُ خصمكمُ أق","وى لبعض أذىً وأعظم غِلّا",16,"ل",2,0],["وائتِ الشبيكة في مسراك مبتهجاً","بما تراه بها من صيغة الدِّيم",17,"م",1,0],["وايتلافي دام لي منتظما","في سنا أقمار ذاك المجلسِ",18,"س",1,0],["وائتلفوا على مثل فاعل","في أخوين وافر وكامل",19,"ل",1,0],["وَاِئتِمامي بِالقَمارِي","يِ قُرَيشٍ في الصَّلاةِ",20,"ه",1,0],["وآيته الكبرى وفرقانه الذي","على حفظه حث الأنام ورغبا",21,"ب",2,0],["وَائتِلافٌ عَهِدتُه مِن كرامٍ","سَارَ صرفُ النَّوَى بهِ أيّ سَيرِ",22,"ر",1,0],["وآيته في الغار إذ أجلب العدى","عليه ليروده وكادوا له كيدا",23,"د",2,0],["وأيْتَمْتَ أبناء الرجال وطالما","دعاهم فأغناهم عن الأمِّ والأبِ",24,"ب",1,0],["وآيتان من الأنوار أنزلتا","عليك والنور فوق الصدر قد جمدا",25,"د",2,0],["وأيتها الارواح في عالم العلا","الا ارتعدي مقتا فقد نفد الصبر",26,"ر",1,0],["وآيتها في الحب أن عذابها","على القلب عذب في الجمال المشفع",27,"ع",1,0],["وَائت بِالقَهوة راحاً قرقفاً","خَندَريساً أَدرَكت ساماً وَحاما",28,"م",2,0],["وأيتها الدار الحبيبة لا يرم","ربوعك جون المرن يهمي بها القطرا",29,"ر",2,0],["وأئت ابنا هاشم القوم الألى","ذكرهم في الناس بالمعروف سارا",30,"ر",2,0],["وَآيَتُكَ الحسام وآيُ موسى","عصاه فكم هززت وكم توكّا",31,"ك",2,0],["وأيتامه مثل الثريا تجمعت","رؤوسهم شعث وابدانهم غبر",32,"ر",1,0],["وآيتهم ما اللَهُ مكرمهُم بهِ","إذا سلكوا سبلَ الهُدى وهو أعلمُ",33,"م",1,0],["وَأَيتامَهُم في وَحشةِ البَيتِ جوعٌ","وَأَنفاسَهُم حَرى وَأَدمُعَهُم غُزرُ",34,"ر",1,0],["وآيته الكبرى كتاب مفصل","أحاط بكتب الانبيا وحواها",35,"ا",3,0],["وائتلاف البرق العراقي وهناً","قاد شوقاً به زمام العتاق",36,"ق",1,0],["وايتقلب في منامه جرح وراه العذاب","ما هنا بالنوم لحظه كل لحظة يقتله",37,"ل",2,0],["وآيٌ تجلّى على بقعةٍ","من الأرض وعداً فصارت سماءْ",38,"ا",2,0],["وَأَيْتُهَا السَّيِّدَاتُ:الْعَفَافُ","الْمُرُوءةُ ذُخْرًا وَنَخْوَاتِ مَالْ",39,"ل",1,0],["وائتمري بالأمر ولتنتهي","بالنهي واحتليه في المركب",40,"ب",1,0],["وأيتامٍ على جوع","وظمأى ما بهم مَكْسِي",41,"س",2,0]]}