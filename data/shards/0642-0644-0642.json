{"poems":[[53,"تأبى الليالي أن تديما","https://www.aldiwan.net/poem29749.html","مجزوء الكامل"],[53,"هي سلوة ذهبت بكل غرام","https://www.aldiwan.net/poem29797.html","الكامل"],[53,"قلق العدو وقد حظيت برتبة","https://www.aldiwan.net/poem29894.html","الكامل"],[53,"لو صح أن البين يعشقه","https://www.aldiwan.net/poem29955.html","السريع"],[100,"وحدة الشاعر","https://www.aldiwan.net/poem24839.html","عموديه"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[51,"يا ناعي ابن رسول الله في البشر","https://www.aldiwan.net/poem64080.html","البسيط"],[43,"أمن ازديارك في الدجى الرقباء","https://www.aldiwan.net/poem9445.html","الكامل"],[28,"إن التي نظرت إليك بفادر","https://www.aldiwan.net/poem5215.html","الكامل"],[28,"شعثا شوازب قد طوى أقرابها","https://www.aldiwan.net/poem5483.html","الكامل"],[61,"أمن العيون تروم فقد عنائه","https://www.aldiwan.net/poem51836.html","الكامل"],[49,"عجبا عجبت لغفلة الإنسان","https://www.aldiwan.net/poem63130.html","الكامل"],[66,"دبت عقارب صدغه في خده","https://www.aldiwan.net/poem41362.html","الكامل"],[44,"قلبت أمري في بدء وفي عقب","https://www.aldiwan.net/poem30054.html","البسيط"],[102,"هو ذا البحر مزبدا يتعالى","https://www.aldiwan.net/poem33132.html","الخفيف"],[52,"ذم الزمان لدمنة","https://www.aldiwan.net/poem26825.html","مجزوء الكامل"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[46,"أدنى الفوارس من يغير لمغنم","https://www.aldiwan.net/poem23639.html","الكامل"],[100,"في الشاطىء الثاني","https://www.poetsgate.com/ViewPoem.aspx?id=50418",""],[100,"قالت الضحيّة","https://www.poetsgate.com/ViewPoem.aspx?id=50170",""],[100,"حوار جارين","https://www.poetsgate.com/ViewPoem.aspx?id=50201",""],[51,"يا ناعيَ ابن رسول الله من البشرِ","https://www.poetsgate.com/ViewPoem.aspx?id=29230",""],[61,"أَمِنَ العيونِ ترومُ فَقْدَ عَنائِه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59468&r=&rc=1",""],[142,"قلقل ركابك في الفلا","https://www.aldiwan.net/poem58370.html","مجزوء الكامل"],[142,"قد بان عذرك والخليط مودع","https://www.aldiwan.net/poem58436.html","الكامل"],[164,"قالوا صحوت فقلت تأبى لوعة","https://www.aldiwan.net/poem67857.html","الكامل"],[195,"ما هاج شوقك من مغاني دمنة","https://www.aldiwan.net/poem54420.html","الكامل"],[197,"أشجى الرفاق تأوهي وتوجعي","https://www.aldiwan.net/poem39946.html","الكامل"],[235,"طاف يسعى بها على الجلاس","https://www.aldiwan.net/poem31916.html","الخفيف"],[242,"سل وجهه البدري عدل كماله","https://www.aldiwan.net/poem1331.html",""],[285,"بشرى السلامة أشرقت","https://www.aldiwan.net/poem39378.html","مجزوء الكامل"],[298,"ما له في عظم الشأن قري","https://www.aldiwan.net/poem36860.html","عموديه"],[304,"الشك والوهم رأس الشر والحذر","https://www.aldiwan.net/poem16792.html","البسيط"],[328,"قبل أن يبصر الظلام الضياء","https://www.aldiwan.net/poem54981.html","الخفيف"],[364,"أنا والرجاء وأنت والكرم","https://www.aldiwan.net/poem60667.html","أحذ الكامل"],[364,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[380,"واحر غلة قلبي الوقاد","https://www.aldiwan.net/poem48838.html","الكامل"],[380,"ناء بمصر وبالشآم حبيبه","https://www.aldiwan.net/poem49206.html","الكامل"],[402,"حتام أكتم ما الدموع تبيح","https://www.aldiwan.net/poem46754.html","الكامل"],[409,"حتام أرغب في مودة زاهد","https://www.aldiwan.net/poem32603.html","الكامل"],[416,"عاد الفؤاد من الجوى ما عادا","https://www.aldiwan.net/poem54072.html","الكامل"],[439,"طلعت نجوم السعد من آفاقها","https://www.aldiwan.net/poem34800.html","الكامل"],[439,"اليوم نادتك السيادة هيت لك","https://www.aldiwan.net/poem34848.html","الكامل"],[439,"عيد ووعد صادق لك بالمنى","https://www.aldiwan.net/poem34852.html","الكامل"],[458,"قم غير معتذرٍ ولا متثاقلِ","https://www.aldiwan.net/poem55926.html","الكامل"],[458,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[458,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[464,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[464,"نشوات طرفك والقوام الأهيف","https://www.aldiwan.net/poem3147.html","عموديه"],[477,"أعرفت من داء الصبابة شافيا","https://www.aldiwan.net/poem15185.html","الكامل"],[479,"نادتك يا أختها الخضرا فلسطين","https://www.aldiwan.net/poem36961.html","البسيط"],[493,"سقت العهاد خليط ذاك المعهد","https://www.aldiwan.net/poem67392.html","الكامل"],[500,"هب النسيم فسار بالأسرار","https://www.aldiwan.net/poem38018.html","الكامل"],[515,"داويت ما نفع العليل دوائي","https://www.aldiwan.net/poem12002.html","الكامل"],[551,"ما الحب إلا موئل المتعلل","https://www.aldiwan.net/poem47295.html","الكامل"],[551,"لو لم يعاجله النوى لتحيرا","https://www.aldiwan.net/poem47806.html","الكامل"],[567,"يا من لأجفان قريحه","https://www.aldiwan.net/poem69759.html","مجزوء الرجز"],[575,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"],[586,"قلق يحن إلى الأجيرع قلبه","https://www.aldiwan.net/poem17977.html","الكامل"]],"verses":[["قَلِقٌ عَلى الأَنماطِ حَ","تّى يُدرِكَ الثارَ المُنيما",0,"م",2,0],["قَلقَلتَ مِن أَعطافِهِ فَكَأَنَّما","فَجَّرتَ يُنبوعاً عَلى الأَقدامِ",1,"م",1,0],["قَلِقَ العَدوُّ وَقَد حَظيتُ بِرُتبَةٍ","تَعلو عَنِ النُظَراءِ وَالأَمثالِ",2,"ل",1,1],["قَلقَلتَ بِالأَجفافِ تُربَتَهُ","وَالقَيظُ عَن أَمَمٍ يُحَرِّقُهُ",3,"ق",2,0],["قلق الصمت كرؤيا مومس","هجعت بين ذراعي فاجر",4,"ر",1,0],["قَلِقَت رِحالَتُها وَأَسبَلَ نَحرُها","وَاِبتَلَّ مِن زَبَدِ الحَميمِ حِزامُها",5,"م",3,0],["قلقلت جبارهم عن لين مضجعه","رعباً ووكلته بالخوف والحذر",6,"ر",1,0],["قَلَقُ المَليحَةِ وَهيَ مِسكٌ هَتكُها","وَمَسيرُها في اللَيلِ وَهيَ ذُكاءُ",7,"ا",2,0],["قَلِقَت إِذا اِضطَرَبَت بِها أَنساعُها","قَلَقَ المَحالَةِ فَوقَ مَتنِ المِحوَرِ",8,"ر",1,0],["قَلِقاً قَلائِدُها تُقادُ إِلى العِدى","رُجُعَ الغَذِيِّ كَثيرَةَ الأَنفالِ",9,"ل",1,0],["قَلِقٌ يُفنِّيه الحديدُ فينثني","جَذْلانَ مثلوجَ الحشا بفَنائِه",10,"ا",3,0],["قَلِقاً يُجَهِّزُني إِلى دارِ البِلى","مُتَحَرِّياً لِكَرامَتي بِهَواني",11,"ي",1,0],["قَلِقُ المِراحِ فَإِن تَلاطَمَ خَطوُهُ","ظَنَّ المُطارِدُ أَنَّهُ في مَهدِهِ",12,"د",2,0],["قُل قَولَةً فَيصَلاً تَمضي حُكومَتُها","في المَنعِ إِن عَنَّ لي مَنعٌ أَوِ الصَفَدِ",13,"د",1,0],["قلق يَرقب الصَباح فَلَما إن","تجلّى شَد الرِحال وَقالا",14,"ل",2,0],["قَلِقَت لِساكِنِها وَحَم","لِ إِنائِهِم حَتّى اِنكَفا",15,"ف",2,0],["قَلِقٌ إلى يوم الهِياجِ مُغامرٌ","دَمُ كلِّ قَيْلٍ في ظُباهُ جُبار",16,"ر",1,0],["قلِقَ السّماكُ لرَكْضِهِ ولربّما","نَفَضَ الغُبارَ على جبِينِ المِرْزَمِ",17,"م",1,0],["قلقي حنين العمر عفرتني","في البحث عن تربيتك ألحاني",18,"ن",2,0],["قلقا تجرح الفراغ خطاه","وهو يصغي إلى خطاه الحسيره",19,"ر",2,0],["قلق بعضه يحاذر بعضا","ويداه تخشى اليمين اليسارا",20,"ر",2,0],["قلقلت جبارهم عن لعين مضجعه","رعباً ووكلته بالخوف والحذر",21,"ر",1,0],["قَلِقٌيُفنِّيه الحديدُفينثني","جَزْلانَ مثلوجَ الحشا بفَنائِه",22,"ا",3,0],["قلقلْ ركابكَ في الفلا","ودع الغوانىَ للقصورِ",23,"ر",1,1],["قلِقُ اللواحظ أو تقرَّ بزائرٍ","كالمضرحىِّ لصيده يتوقَّعُ",24,"ع",1,0],["قَلِقَت مَدامِعُهُ فَبُحنَ بِسِرِّهِ","مَن ذا يُقارِنُهُ الهَوى لا يَقلَقُ",25,"ق",1,0],["قَلِقَت وَعارَضَها حِصانُ نَحائِصٍ","صَحِلُ الصَهيلِ وَأَدبَرَت وَتَلاها",26,"ا",3,0],["قلقٍ آذابَ الهمُّ حبَّةَ قَلبهِ","فتَرَقرَقَت في مقلَةٍ لم تهجَعِ",27,"ع",1,0],["قَلَقي مِن وِشاحِهِ وَبِقَلبي","ما بَخَلخالِهِ مِنَ الوَسواسِ",28,"س",1,0],["قلقُ المضاجع لو لقيت أقل ما","يلقى لما استحسنت سيئ حالهِ",29,"ل",2,0],["قل قبح الله السعا","ة على الافاضل لا تذر",30,"ر",1,0],["قلقُ الأَحشاءِ كالعاشقِ إِنْ","ثار في أَحشائِه وجدٌ دفين",31,"ن",1,0],["قل قدر اللَه ما شاء الإله فعل","إذا غلبت كما قد صح في الخبر",32,"ر",1,0],["قلقٌ كالحياة تقتله الأغلال","وهو المُقَيّد العداء",33,"ا",2,0],["قلْ قَوْلةً للهِ فاصلةً","والدّاءُ َتحسِمُه فيَنْحَسم",34,"م",1,0],["قَلقاً أُسرِعُ التّحوُّلَ في الآ","فاقِ والارتماءَ في الأرجاء",35,"ا",2,0],["قَلَقاً سَحابتها كَأَنَّ مَدامِعي","حشيت بجمر أَو بِشَوك قِتاد",36,"د",1,0],["قَلق الفُؤاد وَصَبهُ وَطروبَهُ","وَمشوقَهُ وَسَليبهُ وَلَسيبهُ",37,"ب",2,0],["قَلقَ الفؤاد كأنّما هبَت لَهُ","طرفٌ إلى نَيل الفخار طموحُ",38,"ح",1,0],["قَلقِ الوِساد كأنّ تحتَ مِهادِه","أُسداً ومَضجَعَهُ نيُوبُ أَساوِدِ",39,"د",1,0],["قَلْقَلْتُ عن أرضِ العراق ركائبي","وسَكنْتُ غيرك يا بلاد بلادا",40,"د",2,0],["قَلِقَتْ إِلَيْهِ البيضُ فِي أَغْمادِها","وثَنَتْ إِلَيْهِ الخيلُ من أَعناقِها",41,"ق",3,0],["قلِقاً تناهى فِي البلادِ فِرارُهُ","ونَهى ضميرَ النفسِ أَنْ يَتَمَثَّلَكْ",42,"ك",1,0],["قَلِقَتْ بِهِ أَوْطانُهُ من ظاعِنٍ","لَمْ يُلْفِ فِي عدنانَ عنكمْ مَظْعَنا",43,"ن",2,0],["قَلقِ الوسادِ يسوم بيعةَ غابن","من صبره ويرومُ نُصرةَ خاذلِ",44,"ل",1,0],["قَلِقُ العزيمةِ إن حَمَى","صِغَرَ النفوسِ قرارُها",45,"ر",3,0],["قَلِقاً يَنفِي الكرى عن وجههِ","عِلمُه أنَّ المعالي في الهبوبِ",46,"ب",1,0],["قلقاً لذاتك الراحل الماضي","ودهشتُه لذاك النازل الموعود",47,"د",1,0],["قلقَ العدى النُّكول وإنما","قلقُ العدى لسكون قول المرجف",48,"ف",1,0],["قَلِقَ الوِسادِ وقد تعرَّضتِ النوى","حيرانَ تسأَلُ أرسُماً ومغانيا",49,"ي",2,0],["قل قولنا الفصل للمستقبل انتظروا","ما بيننا يومها تقضي الموازين",50,"ن",1,0],["قَلِقٌ كَأَنَّ الجَوَّ ضاقَ بِهِ فَما","يَنفَكُّ بَينَ تَوَثُّبٍ وَتَهَدُّدِ",51,"د",1,0],["قَلقٌ كَئيبٌ مُسْتَهامٌ والِهٌ","رَشَّ البِقاعَ بِدَمعهِ المِدْرارِ",52,"ر",1,0],["قلقاً أبيت على فراشي ساهراً","فكأنني ملقى على الرمضاء",53,"ا",2,0],["قَلِقُ البصيرةِ إنْ سَرَتْ أفكارُه","ظفرتْ بما خَلْفِ القضاءِ المُسدَلِ",54,"ل",1,0],["قَلِقَتْ بهمْ أحقادهمْ فَمُرجّعٌ","نَفَساً ومانعُ أنّةٍ أن تجهرا",55,"ر",2,0],["قَلِقاً أُكابِدُ حُرْقَةً","في طيِّ أحشاءٍ جَريْحَهْ",56,"ح",2,0],["قَلَّ قدرِي عن العِتابِ ولكن","أَنا أُنْهِي تَظَلُّمي لا عتبي",57,"ي",1,0],["قَلقٌ يَحنُّ إلى الأُجيْرعِ قَلْبهُ","وَتشُوقهُ مِنْ حُبّه هَضبَاتُهُ",58,"ت",2,1]]}