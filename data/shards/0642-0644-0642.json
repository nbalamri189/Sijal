",""],[5805,"خربشْ","https://www.poetsgate.com/ViewPoem.aspx?id=12459",""],[5956,"أنا روحٌ حُرَّة","https://www.poetsgate.com/ViewPoem.aspx?id=183917",""],[5956,"فلسطينيٌّ يشكر جهاد زوجته","https://www.poetsgate.com/ViewPoem.aspx?id=200548",""],[5956,"اشبح أيا أرتين في كبدِ الفضا","https://www.poetsgate.com/ViewPoem.aspx?id=205427",""],[5956,"قلِقُ على الوطن العظيمة سيرتُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=206671",""],[5957,"ولماذا الساعة لا تعمل؟","https://www.poetsgate.com/ViewPoem.aspx?id=181672",""],[5979,"قلق الضمير بظبيةٍ وهنانةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=181355",""],[6031,"هَتَفَتْ بِدَمْعِ العَينِ وَهْي سَجُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=46292",""],[6068,"قلق يلازمني... -02-","https://www.poetsgate.com/ViewPoem.aspx?id=175844",""],[6093,"قلقٌ تجذَّرَ في الفؤادِ وفي الحشا","https://www.poetsgate.com/ViewPoem.aspx?id=176519",""],[6093,"وجه فكري","https://www.poetsgate.com/ViewPoem.aspx?id=180535",""],[199,"ما هاجَ شوقكَ من مغاني دمنة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=20777",""],[6312,"البؤرُ المتحركةُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82949&r=&rc=4",""]],"verses":[["قَلِقٌ عَلى الأَنماطِ حَ","تّى يُدرِكَ الثارَ المُنيما",0,"م",2,0],["قَلقَلتَ مِن أَعطافِهِ فَكَأَنَّما","فَجَّرتَ يُنبوعاً عَلى الأَقدامِ",1,"م",1,0],["قَلِقَ العَدوُّ وَقَد حَظيتُ بِرُتبَةٍ","تَعلو عَنِ النُظَراءِ وَالأَمثالِ",2,"ل",1,1],["قَلقَلتَ بِالأَجفافِ تُربَتَهُ","وَالقَيظُ عَن أَمَمٍ يُحَرِّقُهُ",3,"ق",2,0],["قلق الصمت كرؤيا مومس","هجعت بين ذراعي فاجر",4,"ر",1,0],["قَلِقَت رِحالَتُها وَأَسبَلَ نَحرُها","وَاِبتَلَّ مِن زَبَدِ الحَميمِ حِزامُها",5,"م",3,0],["قلقلت جبارهم عن لين مضجعه","رعباً ووكلته بالخوف والحذر",6,"ر",1,0],["قَلَقُ المَليحَةِ وَهيَ مِسكٌ هَتكُها","وَمَسيرُها في اللَيلِ وَهيَ ذُكاءُ",7,"ا",2,0],["قَلِقَت إِذا اِضطَرَبَت بِها أَنساعُها","قَلَقَ المَحالَةِ فَوقَ مَتنِ المِحوَرِ",8,"ر",1,0],["قَلِقاً قَلائِدُها تُقادُ إِلى العِدى","رُجُعَ الغَذِيِّ كَثيرَةَ الأَنفالِ",9,"ل",1,0],["قَلِقٌ يُفنِّيه الحديدُ فينثني","جَذْلانَ مثلوجَ الحشا بفَنائِه",10,"ا",3,0],["قَلِقاً يُجَهِّزُني إِلى دارِ البِلى","مُتَحَرِّياً لِكَرامَتي بِهَواني",11,"ن",2,0],["قَلِقُ المِراحِ فَإِن تَلاطَمَ خَطوُهُ","ظَنَّ المُطارِدُ أَنَّهُ في مَهدِهِ",12,"د",2,0],["قُل قَولَةً فَيصَلاً تَمضي حُكومَتُها","في المَنعِ إِن عَنَّ لي مَنعٌ أَوِ الصَفَدِ",13,"د",1,0],["قلق يَرقب الصَباح فَلَما إن","تجلّى شَد الرِحال وَقالا",14,"ل",2,0],["قَلِقَت لِساكِنِها وَحَم","لِ إِنائِهِم حَتّى اِنكَفا",15,"ف",2,0],["قَلِقٌ إلى يوم الهِياجِ مُغامرٌ","دَمُ كلِّ قَيْلٍ في ظُباهُ جُبار",16,"ر",1,0],["قلِقَ السّماكُ لرَكْضِهِ ولربّما","نَفَضَ الغُبارَ على جبِينِ المِرْزَمِ",17,"م",1,0],["قلقي حنين العمر عفرتني","في البحث عن تربيتك ألحاني",18,"ن",2,0],["قلقا تجرح الفراغ خطاه","وهو يصغي إلى خطاه الحسيره",19,"ر",2,0],["قلق بعضه يحاذر بعضا","ويداه تخشى اليمين اليسارا",20,"ر",2,0],["قلقلت جبارهم عن لعين مضجعه","رعباً ووكلته بالخوف والحذر",21,"ر",1,0],["قَلِقٌيُفنِّيه الحديدُفينثني","جَزْلانَ مثلوجَ الحشا بفَنائِه",22,"ا",3,0],["قلقلْ ركابكَ في الفلا","ودع الغوانىَ للقصورِ",23,"ر",1,1],["قلِقُ اللواحظ أو تقرَّ بزائرٍ","كالمضرحىِّ لصيده يتوقَّعُ",24,"ع",1,0],["قَلِقَت مَدامِعُهُ فَبُحنَ بِسِرِّهِ","مَن ذا يُقارِنُهُ الهَوى لا يَقلَقُ",25,"ق",1,0],["قَلِقَت وَعارَضَها حِصانُ نَحائِصٍ","صَحِلُ الصَهيلِ وَأَدبَرَت وَتَلاها",26,"ا",3,0],["قلقٍ آذابَ الهمُّ حبَّةَ قَلبهِ","فتَرَقرَقَت في مقلَةٍ لم تهجَعِ",27,"ع",1,0],["قَلَقي مِن وِشاحِهِ وَبِقَلبي","ما بَخَلخالِهِ مِنَ الوَسواسِ",28,"س",1,0],["قلقُ المضاجع لو لقيت أقل ما","يلقى لما استحسنت سيئ حالهِ",29,"ل",2,0],["قل قبح الله السعا","ة على الافاضل لا تذر",30,"ر",1,0],["قلقُ الأَحشاءِ كالعاشقِ إِنْ","ثار في أَحشائِه وجدٌ دفين",31,"ن",1,0],["قل قدر اللَه ما شاء الإله فعل","إذا غلبت كما قد صح في الخبر",32,"ر",1,0],["قلقٌ كالحياة تقتله الأغلال","وهو المُقَيّد العداء",33,"ا",2,0],["قلْ قَوْلةً للهِ فاصلةً","والدّاءُ َتحسِمُه فيَنْحَسم",34,"م",1,0],["قَلقاً أُسرِعُ التّحوُّلَ في الآ","فاقِ والارتماءَ في الأرجاء",35,"ا",2,0],["قَلَقاً سَحابتها كَأَنَّ مَدامِعي","حشيت بجمر أَو بِشَوك قِتاد",36,"د",1,0],["قَلق الفُؤاد وَصَبهُ وَطروبَهُ","وَمشوقَهُ وَسَليبهُ وَلَسيبهُ",37,"ب",2,0],["قَلقَ الفؤاد كأنّما هبَت لَهُ","طرفٌ إلى نَيل الفخار طموحُ",38,"ح",1,0],["قَلقِ الوِساد كأنّ تحتَ مِهادِه","أُسداً ومَضجَعَهُ نيُوبُ أَساوِدِ",39,"د",1,0],["قَلْقَلْتُ عن أرضِ العراق ركائبي","وسَكنْتُ غيرك يا بلاد بلادا",40,"د",2,0],["قَلِقَتْ إِلَيْهِ البيضُ فِي أَغْمادِها","وثَنَتْ إِلَيْهِ الخيلُ من أَعناقِها",41,"ق",3,0],["قلِقاً تناهى فِي البلادِ فِرارُهُ","ونَهى ضميرَ النفسِ أَنْ يَتَمَثَّلَكْ",42,"ك",1,0],["قَلِقَتْ بِهِ أَوْطانُهُ من ظاعِنٍ","لَمْ يُلْفِ فِي عدنانَ عنكمْ مَظْعَنا",43,"ن",2,0],["قَلقِ الوسادِ يسوم بيعةَ غابن","من صبره ويرومُ نُصرةَ خاذلِ",44,"ل",1,0],["قَلِقُ العزيمةِ إن حَمَى","صِغَرَ النفوسِ قرارُها",45,"ر",3,0],["قَلِقاً يَنفِي الكرى عن وجههِ","عِلمُه أنَّ المعالي في الهبوبِ",46,"ب",1,0],["قلقاً لذاتك الراحل الماضي","ودهشتُه لذاك النازل الموعود",47,"د",1,0],["قلقَ العدى النُّكول وإنما","قلقُ العدى لسكون قول المرجف",48,"ف",1,0],["قَلِقَ الوِسادِ وقد تعرَّضتِ النوى","حيرانَ تسأَلُ أرسُماً ومغانيا",49,"ي",2,0],["قل قولنا الفصل للمستقبل انتظروا","ما بيننا يومها تقضي الموازين",50,"ن",1,0],["قَلِقٌ كَأَنَّ الجَوَّ ضاقَ بِهِ فَما","يَنفَكُّ بَينَ تَوَثُّبٍ وَتَهَدُّدِ",51,"د",1,0],["قَلقٌ كَئيبٌ مُسْتَهامٌ والِهٌ","رَشَّ البِقاعَ بِدَمعهِ المِدْرارِ",52,"ر",1,0],["قلقاً أبيت على فراشي ساهراً","فكأنني ملقى على الرمضاء",53,"ا",2,0],["قَلِقُ البصيرةِ إنْ سَرَتْ أفكارُه","ظفرتْ بما خَلْفِ القضاءِ المُسدَلِ",54,"ل",1,0],["قَلِقَتْ بهمْ أحقادهمْ فَمُرجّعٌ","نَفَساً ومانعُ أنّةٍ أن تجهرا",55,"ر",2,0],["قَلِقاً أُكابِدُ حُرْقَةً","في طيِّ أحشاءٍ جَريْحَهْ",56,"ح",2,0],["قَلَّ قدرِي عن العِتابِ ولكن","أَنا أُنْهِي تَظَلُّمي لا عتبي",57,"ب",2,0],["قَلقٌ يَحنُّ إلى الأُجيْرعِ قَلْبهُ","وَتشُوقهُ مِنْ حُبّه هَضبَاتُهُ",58,"ت",2,1],["قَلِقاً كَأنَّ الرّيحَ تَعصِفُ عَصفَها","بِكَ في رَحالَتِهِ وفي أنساعِه",59,"ع",2,0],["قَلِقُ الفِرندِ مُشطّبٌ فكانّما","يَعلو ويَهبط في شَباهُ مَنهَلُ",60,"ل",1,1],["قلق الهند عون مصر وأهلي","ها على ما لسلمها اشترطوه",61,"و",2,0],["قَلَّ قدرُ الدنيا لديك فما تنف","كُّ بين الإِنفاق والإتلاف",62,"ف",1,0],["قَلِقُ النفسِ للنَّدى حينَ نفسُ ال","مؤثرِ البخلَ صَخْرَةٌ مرتزَّه",63,"ز",2,0],["قلقته باللوى مُطفلةٌ","ملكتْ رِقّى ووالت سَهري",64,"ر",2,0],["قَلِقٍ فِي القَيْدِ مَا بَرِحَا","يَعْشَقُ الطَّيْرَ الذِي نَزَحَا",65,"ا",1,0],["قلق الوساد يشوقه","من ريم رامة ما يشوقُ",66,"ق",1,0],["قلق كأن فؤاده","لك يا معذبه وشاحُ",67,"ح",1,0],["قلقت وقد جد الفراق لبعدكم","كأني على جمر الغضا بعدكم واطي",68,"ط",2,0],["قَلِقاً كأوراق الخري","ف بكف ريح سافية",69,"ي",2,0],["قِلْقِلَهُ الضاحِي وَحَتَّ البَرْوَقا","وَمَجَّتِ الشَمْسُ عَلَيْهِ رَوْنَقا",70,"ق",2,0],["قلق الفؤاد يبيت معظم ليله","مترقباً يرعى النجوم الزاهرة",71,"ه",1,0],["قلقا فانك بالعزاء جدير","وعلى النوائب منذ كنت صبور",72,"ر",1,0],["قل قالت الخنساء فسخا ثالث","مماثل والقول فيه حادث",73,"ث",1,0],["قَلِقَ الجَسرَةُ وَالرَح","لُ عَلَيها وَالضُفورُ",74,"ر",1,0],["قلق المناطق مائج الأرداف مي","ياس القوام كأنه مخمور",75,"ر",1,0],["قلقٌ يخاف على الحمى غيراً","قعدت به وتعثرت الجد",76,"د",1,0],["قَلقتُ فَهَل في الثّريا قَلَق","أَم البَدر من ذا الدُّجى في أَرَق",77,"ق",1,1],["قلقت فلما أنْ سمعتُ معلمي","تسمَّى بما للخلقِ عدتُ إلى الحقِّ",78,"ق",1,0],["قَلقِل الصَخرَةَ مِن مَقلَعِها","صَخرَةِ الظُلمِ صِفاة الخَجَلِ",79,"ل",1,0],["قَلِقاً يَحفِزُهُ حَزمٌ وَجِدٌّ وَاِشتِمارُ","غَيرَ ما وانٍ إِذا ما قَرَّ بِالساري قَرارُ",80,"ر",1,0],["قلقاً أَمسى وَمِنهُ","أَنتَ أَقلقت الوِسادا",81,"د",2,0],["قَلقاً تَقلِّبني الهُموم بمضجعي","وَيَغور فكري في الزَمان وَيُتهم",82,"م",1,0],["قلق الوشاح يخفّ منه مطاوعا","خصر تجاذبه روادف رجح",83,"ح",1,0],["قَلِقَت إِذا اِنحَدَرَ الطَريقُ لَها","قَلَقَ المُحالَةِ ضَمَّها الدَعمُ",84,"م",1,0],["قَلقَلتِ مِن وَجدٍ بِكُم كَبِدي","وَصَدَعتِ صَدعاً غَيرَ مُلتَئِمِ",85,"م",1,0],["قَلِقُ العِنان كأَنَّ فوق تَليله","نَمْلٌ، وبين سَمِيعَتَيْهِ صفير",86,"ر",1,0],["قلقت من أنباء حرب لها","قد بت في ليلة وسواس",87,"س",1,0],["قَلِقَ الأَجفانِ تَحسِبُهُ","عاقِداً حِقداً عَلى وَغَرِه",88,"ر",2,0],["قلق في الحشا ووجد فجوفى","قبس الحب فيه أو رى 