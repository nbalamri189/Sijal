{"poems":[[55,"سيدي أنت ليس كلل","https://www.aldiwan.net/poem29953.html","مجزوء الخفيف"],[9,"يوم قفت حمولهم فتولوا","https://www.aldiwan.net/poem21960.html","الخفيف"],[31,"حلت سليمى بدوغان وشط بها","https://www.aldiwan.net/poem6186.html","البسيط"],[82,"حركات إلى السكون تؤول","https://www.aldiwan.net/poem31320.html","الخفيف"],[33,"يا ثريا الفؤاد ردي السلاما","https://www.aldiwan.net/poem41340.html","الخفيف"],[33,"طال ليلي فما أحس رقادي","https://www.aldiwan.net/poem42582.html","الخفيف"],[33,"منع النوم ذكره","https://www.aldiwan.net/poem42652.html","مجزوء الخفيف"],[52,"يا لقوم للزائر المنتاب","https://www.aldiwan.net/poem64812.html","الكامل"],[52,"طال في هند عتابي","https://www.aldiwan.net/poem64825.html","مجزوء الرمل"],[52,"حييا صاحبي أم العلاء","https://www.aldiwan.net/poem64891.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39678","الرمل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21068","الرمل"],[33,"يا ثُرَيَّا الفُؤادِ رُدّي السِّلاَمَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19065&r=&rc=328",""],[168,"إنما فازت قداح المنايا","https://www.aldiwan.net/poem67815.html","المديد"],[201,"لي طرف لم يدر ما الإغفاء","https://www.aldiwan.net/poem39813.html","الخفيف"],[438,"يوم قضى لك بالحبور","https://www.aldiwan.net/poem12395.html","مجزوء الكامل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66694","الخفيف"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/97046","الخفيف"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105472","الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133824","الخفيف"],[1185,"","https://poetry.dctabudhabi.ae/diwan/poem/75730","الرمل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101026","الخفيف"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101049","البسيط"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201722",""],[2277,"","https://poetry.dctabudhabi.ae/diwan/poem/101848","الرمل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110651","الخفيف"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121176","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94298","الخفيف"],[2983,"","https://poetry.dctabudhabi.ae/diwan/poem/133933","الرمل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89161","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62923","الرمل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109928","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102981","الخفيف"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66092","الرمل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139540",""],[4755,"هُنَّ ظَهرِي، وسَائِطِي، والسِّيَاطُ","https://www.poetsgate.com/ViewPoem.aspx?id=202603",""],[4764,"تعشقين اثنين","https://www.poetsgate.com/ViewPoem.aspx?id=27727",""],[4791,"صك المحبه","https://www.poetsgate.com/ViewPoem.aspx?id=35901",""],[4797,"الناموس","https://www.poetsgate.com/ViewPoem.aspx?id=178129",""],[5434,"الشاور غشاني","https://www.poetsgate.com/ViewPoem.aspx?id=37612",""],[5720,"بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=199926",""],[5756,"السفينة","https://www.poetsgate.com/ViewPoem.aspx?id=5180",""],[6056,"معاذير العتاب","https://www.poetsgate.com/ViewPoem.aspx?id=130352",""]],"verses":[["يَومَ قَودِ الجِيادِ خَ","طّارَةً في السَمالِقِ",0,"ق",1,0],["يَومَ قَفَّت حُمولُهُم فَتَوَلَّوا","قَطَّعوا مَعهَدَ الخَليطِ فَشاقوا",1,"ق",3,1],["يَومَ قُضاعَةُ مَجدوعٌ مَعاطِسُها","وَهوَ أَشَمُّ تَرى في رَأسِهِ صَيَدا",2,"د",2,0],["يومَ قامتْ بفقْدهِ نائحاتٌ","في لَبُوسٍ من حُزْنِهِنّ يَهُولُ",3,"ل",1,0],["يَومَ قالَت وَدَمعُها يَغسِلُ الكُح","لَ أَرَدتَ الغَداةَ مِنّا اِنصِراما",4,"م",2,0],["يَومَ قالَت لِتِربِها سائِليهِ","أَيُريدُ الرَواحُ أَم هُوَ غادي",5,"د",2,0],["يَومَ قالَت لِنِسوَةٍ","مِن لُؤَيِّ بنِ غالِبِ",6,"ب",1,0],["يَومَ قامَت مُختالَةً في حِقابٍ","لَيتَني كُنتُ بَعضَ تِلكَ الحِقابِ",7,"ب",1,0],["يَومَ قامَت تَتَهادى","بَينَ إِتبٍ وَسِخابِ",8,"ب",1,0],["يَومَ قالَت تَحذَرُ العَي","نَ عَلى ذاتِ الحِجابِ",8,"ب",1,0],["يَومَ قالَت إِذا رَأَيتُكَ في النَو","مِ خَيالاً أَصَبتَ عَيني بِداءِ",9,"ا",2,0],["يوم قالوا جلّلَ القيد يدا","حطمَت بالأمس أصفاد العبيد",10,"د",1,0],["يَومَ قَلَّت عِيرُهُم من عِيرِنَا","واحتمالُ الَحيِّ في الصُّبحِ فَلَق",11,"ق",1,1],["يَوْمَ قَالَتْ، وَدَمْعُها يَغْسِلُ الكُحْ","لَ: أَرَدْتَ الغَدَاة َ مِنَّا کنْصِرَاما",12,"م",2,0],["يَومَ قالَت لِلرَدى اِستَقصِ حَظّي","يَومَ لَم تَصطَفِ إِلّا الشَريفا",13,"ف",2,0],["يوم قمنا وأدبرت فتعالت","من فؤادي التنهدات وآلت",14,"ت",1,0],["يومٌ قضى لك بالحُبورِ","ودوام عَيِشٍ في سرورِ",15,"ر",1,1],["يوم قامَ النبيُّ في ظلّ دَوْحٍ","والورى في وديقةٍ صَيخودِ",16,"د",1,0],["يوم قد أحسن الوصال حسين","لي من بعد سوءٍ صد طويل",17,"ل",1,0],["يوم قضى وادي المكارم إنه","يوم على أهل الفخار عظيم",18,"م",1,0],["يوم قاد النضال يزجي الدواهي","نفر خُلصّ من الأكفاء",19,"ا",2,0],["يَومَ قامَت عَلى مَنابِر أَفنا","ن أَجادَ الهزاز فن الخطابه",20,"ب",2,0],["يوم قاموا في نضرة الحق بسلاً","بقلوب على المكاره بسل",21,"ل",1,0],["يوم قضى الحق لا يوم جرى سفها","بالأنعمين ولا يوم بذي حسم",22,"م",1,0],["يوم قاما ليخمدا غولة السي","ف التي كل كائن قد وعاها",23,"ا",3,0],["يوم قامت نوادب الدين تدعو","هل مغيث ولا يجاب دعاها",23,"ا",3,0],["يوم قاما ليطمسا بيضة الدي","ن ويأبى الإله إلاَّ انجلاها",23,"ا",3,0],["يوم قال المسيح من أنصاري","وهو يدعو للرشدِ والإيمانِ",24,"ن",1,0],["يوم قدَّ الحسام آلهة","صنعتها الأكف من خشب",25,"ب",1,0],["يوم قد وافى سعيد","بالهدى مستمسكا",26,"ك",2,0],["يوم قد فل من بني الوحي عضب","كم به فل للمواضي شباها",27,"ا",3,0],["يوم قتل الحسين كيف استقرت","هذه الأرض بل وسبع الطباق",28,"ق",1,0],["يوم قال الناعون أرخ بليل","قدس الرب روحه تقديسا",29,"س",2,0],["يوم قالوا مات سعد ضعضعوا","أرسخ الاعلام والأوتاد هدا",30,"د",2,0],["يوم قالوا القطوع غرّقت القط","ن من الكيد كاد عقلي يطيرْ",31,"ر",1,0],["يومُ قابوسَ يغنّي حِجْلُهُ","طَرِبَ الساقين والدَّمعُ عُقَارُ",32,"ر",1,0],["يومٌ قَدِ اصطَحَمَت بهِ ثُوَبُ العَلا","يَحبُونَ تهليلاً يسوعَ السيِّدا",33,"د",2,0],["يوم قامت به قيامة طعن","نقرت بالأسنة الناقورا",34,"ر",2,0],["يومَ قُدْنا العَوالي الدُّوَلا","ساالُوا عنا بُطُونَ الكُتُبِ",35,"ب",1,0],["يوم قد جدَّل الفوارس حتى","نكصت خيلها على الأعقاب",36,"ب",1,0],["يَومَ قامَت قِيَامَتِي قُلتُ: إِنّي","بين نَارَينِ واقِفٌ يا صِراطُ",37,"ط",1,0],["يوم قلبي في هواهم / ابتلى","ما بقى مني / سوى بعض الصدوع",38,"ع",1,0],["يوم قالوا الليل سراة أبد ما يصير","جا زماني على يا نور عيني ماريد",39,"د",1,1],["يوم قام الشوط كنه جول صيد","مثل ادامي عاثي ً فيها سباع",40,"ع",1,0],["يوم قال له الخوي عاشت يمينه","شد رجله للكمك واحد وثاني",41,"ن",2,0],["يوم قيلتْ ؛ تبددتْ ظلماتٌ","وابتدا الخيرُ في بقاعِ البلادِ",42,"د",1,0],["يوم قلبي ماعصاك ولاقدرتي تذبحينة","ليه خنتي فيه وأنتي معه من نفس الديانه",43,"ن",2,0],["يوم قلبي للمشاعر إستجاب","أشعلت ذكراه في صدري حريقة",44,"ق",2,1]]}