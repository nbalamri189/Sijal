{"poems":[[90,"سعروها في البحر حربا ضروسا","https://www.aldiwan.net/poem44472.html","الخفيف"],[90,"هكذا يدرك في الدنيا الكمال","https://www.aldiwan.net/poem45045.html","الرمل"],[29,"تغطي نمير بالعمائم لؤمها","https://www.aldiwan.net/poem6006.html","الطويل"],[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[102,"مسافرة بلا مهمة","https://www.poetsgate.com/ViewPoem.aspx?id=50437",""],[445,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66985","المتقارب"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59426","الوافر"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203792","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64955","الهزج"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35703","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48963","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108481","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53076","الرمل"],[2346,"","https://poetry.dctabudhabi.ae/diwan/poem/18007","الوافر"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104671","الرمل"],[3508,"","https://poetry.dctabudhabi.ae/diwan/poem/20555","الطويل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128914","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94473","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94377","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66194","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139540",""],[3271,"ثورة الإسلام في بدر","https://www.poetsgate.com/ViewPoem.aspx?id=103535",""],[5596,"نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=205465",""],[5939,"أشرعة","https://www.poetsgate.com/ViewPoem.aspx?id=195321",""],[6147,"غضبة شعبي","https://www.poetsgate.com/ViewPoem.aspx?id=151695",""]],"verses":[["فانتضَوْها عزائماً ماضيات","طأطأ الروس دونهنّ الرءوسا",0,"س",2,0],["فانتضى الهمّة كي ينقذها","كانتضاء السيف ما فيه كلال",1,"ل",1,0],["فَإِن تَضرِبونا بِالسِياطِ فَإِنَّنا","ضَرَبناكُمُ بِالمُرهَفاتِ الصَوارِمِ",2,"م",1,0],["فَاِنتَضَلنا وَاِبنُ سَلمى قاعِدٌ","كَعَتيقِ الطَيرِ يُغضي وَيُجَل",3,"ل",1,0],["فانتضت في يد (السقيفة) (سعدا)","أكبر القوم للأمور الكبيره",4,"ر",2,0],["فإِنْ تضايَقَتِ الدُّنيا بمُغتَربٍ","فَمُنذِرٌ بعدُ رَحْبُ الصدرِ واسِعُهُ",5,"ع",2,0],["فأنتِ ضميرٌ ليس يُعْرَفُ كُنْهُهُ","فَلِمْ صَيَّرُوا في المَعْرِفَاتِ الضَّمائرَا",6,"ر",2,0],["فأنت ضياء إنساني وقلبي","وأنت عماد روحي واعتمادي",7,"د",2,0],["فانتضى السيف كلُّ حر ودوَّت","بزئير الآسادِ سمرُ الوهاد",8,"د",1,0],["فإِنَ تَضْنَ بِها تُهْدَ","لكَ الرَّاحةُ مَزْمومَهْ",9,"م",2,0],["فَإِن تَضَعِ الأَيّامُ لي مِن مُتونِها","فَقَد حَمَلَتني فَوقَ كاهِلها الصَعبِ",10,"ب",1,0],["فانتضيتُ اليراع من غِمد فكري","لأَصوغَ النجومَ في أَبياتي",11,"ت",2,0],["فانتضى ذو الفقار فيها فخلت","الشمس مذ أشرقت فزال دجاها",12,"ا",3,0],["فانتضى سيفه على ذات غدر","لم تكفر ذنوبها بالندامه",13,"م",2,0],["فانتض العزم الذي تخطبه","رغبة في العدل أبكار البلاد",14,"د",1,0],["فَإِن تَضنُن عَلَيكَ بِما لَدَيها","وَتَقلِب وَصلَ نائِلِها جَديدا",15,"د",2,0],["فَاِنتَضاهُ اللَهُ سَيفاً مُصلَتاً","لَم يَدَع لِلكُفرِ جَفناً وَسِنا",16,"ن",2,0],["فإِن تضحَكي مِنّي فَيارُبَّ لَيلَةٍ","تَرَكتُكِ فيها كالقَباءِ المُفَرَّجِ",17,"ج",1,1],["فانتضى حينذاك صارم عزم","أرهفته صياقل الالهام",18,"م",1,0],["فأنت ضيا الأبصار في كل دجيةٍ","وأنت سرور القلب يا كل غصَّةِ",19,"ه",1,0],["فأنتِ ضياءُ الكون أنتِ ذكا الهدى","وفي ظلمة الأهوال صرتِ لنا البدرا",20,"ر",2,0],["فانْ تَضْحَكِ اليوْمَ اغْترارا بما تَرَى","نَدِمْتَ سَتَلْقَى بَعْدَ ذلِكَ ما يُبْكي",21,"ي",1,0],["فانتضى ابن النبى للنصر قوماً","قد أجابوا لنصره في الجواب",22,"ب",1,0],["فانتضوا عزمةً لو انَّ هضاباً","جاولتها لأصبحت كالجوابي",22,"ب",2,0],["فانتضى قاضباً من العزم فيه","لاصول الإشراكِ أيُّ اقتضاب",22,"ب",1,0],["فانتضى سيفه وهبّ على الغا","رة بالسّرمدِ القويّ مؤزّر",23,"ر",1,0],["فانتضت نفسها كلامع برقٍ","زلزل القلب فاستحال ركاما",24,"م",2,0],["فانتضَى حلمَه ومَضَى","آخذًا نجمتينِ مَعَهْ",25,"ع",2,0],["فأنت ضِرامٌ لِفوْهات نار","جعلْتَ الطغاة عليها الحطبْ",26,"ب",1,0]]}