{"poems":[[85,"زار الخيال بأيمن الزوراء","https://www.aldiwan.net/poem54344.html","الطويل"],[87,"الله أعلم والقبور","https://www.aldiwan.net/poem7107.html","مجزوء الكامل"],[47,"وأمر من عللي تخلى ناظري","https://www.aldiwan.net/poem66681.html","الكامل"],[107,"من هيبة يغضي القريض ويطرق","https://www.aldiwan.net/poem42076.html","الكامل"],[107,"الله أكبر باسم الله أهديها","https://www.aldiwan.net/poem43131.html","البسيط"],[107,"هذا إمام الدين في أعلامه","https://www.aldiwan.net/poem44206.html","الكامل"],[69,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39630","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[79,"لمن طلل نائي المزار بعيده","https://www.poetsgate.com/ViewPoem.aspx?id=33818",""],[98,"يوم الملتقي","https://www.poetsgate.com/ViewPoem.aspx?id=17501",""],[192,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[192,"وصل السراة وأنت ماكث","https://www.aldiwan.net/poem35170.html","مجزوء الكامل"],[238,"وخيال سرى إلي فأدنا","https://www.aldiwan.net/poem31738.html","الخفيف"],[274,"قف بذات السفح من اضم","https://www.aldiwan.net/poem52088.html","المديد"],[307,"ما للفؤاد يفيض بالأكدار","https://www.aldiwan.net/poem16809.html","الكامل"],[307,"يا سائلي عن عبرتي ومدامي","https://www.aldiwan.net/poem16845.html","الخفيف"],[308,"برق به أفق الرجاء أنارا","https://www.aldiwan.net/poem56540.html","الكامل"],[367,"ألم صبحا وجمر الحلي قد بردا","https://www.aldiwan.net/poem60940.html","البسيط"],[383,"قصر بحمد الله مقصور","https://www.aldiwan.net/poem48752.html","أحذ الكامل"],[406,"شكرا لربي دائما","https://www.aldiwan.net/poem33982.html","مجزوء الكامل"],[444,"خل الكئيب بدائه في ذاته","https://www.aldiwan.net/poem14341.html","الكامل"],[448,"لهوى الحجاز بأفق قلبي مبدأ","https://www.aldiwan.net/poem23812.html","الكامل"],[481,"هب لي بيانك في ممدوحك الهادي","https://www.aldiwan.net/poem36957.html","البسيط"],[502,"ليل المحب إذا تطاول بالسهر","https://www.aldiwan.net/poem38019.html","الكامل"],[540,"لله إخوان بقلبي ذهبوا","https://www.aldiwan.net/poem47541.html","عموديه"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/31473","الكامل"]],"verses":[["المصطفى والمرتضى والمجتبى","والمنتقى من عنصرِ العلياءِ",0,"ا",2,0],["المصميات من القوا","صد في كِنانته كثير",1,"ر",1,0],["المُصطَفى لِلمُؤمِنينِ خَليفَةً","وَالمُرتَضى لِحِياطَةِ الإيمانِ",2,"ن",1,0],["المُصلِحُ الأعلى أتمَّ نِظامَها","فانْظُرْ أَينقُضُهُ الغبيُّ الأَخرقُ",3,"ق",1,0],["المُصحَفُ السَيفُ وَالآياتُ أَدرُعُها","وَالقائِدُ الروحُ وَالمُختارُ حاميها",4,"ي",3,0],["المُصلحونَ على الزّمانِ سُيُوفُهُ","وجنودُه في حربِهِ وسلامهِ",5,"م",2,0],["المُصْدِرِي البِيضَ حُمْراً بعدَ ما وَرَدَتْ","مِنَ العِدا كُلَّ مُسْوَدٍّ مِنَ اللِّمَمِ",6,"م",1,0],["المصطفى وحواريُّوهُ إنْ ذُكِرُوا","فالشرقُ مَنبهةٌ والغربُ أصداءُ",7,"ا",2,0],["المُصلِحونَ أَصابِعٌ جُمِعَت يَداً","هِيَ أَنتَ بَل أَنتَ اليَدُ البَيضاءُ",8,"ا",2,0],["المصلى والجنود روائح","تغص بها أغواره ونجوده",9,"د",2,0],["المصطفى وحواريّوه إن ذكروا","فالشّرق منهبة ، والغرب أصداء",10,"ا",2,0],["المُصطفى والصفوة الحبيبُ","القانتُ الأوّاه والمنيبُ",11,"ب",1,0],["المُصطفى مِن آل سا","مٍ مِن بَني حامٍ ويافِث",12,"ث",1,0],["المُصيبونَ في دُجى الخَطبِ وَالمُع","طونَ في الجَدبِ وَالسَحابُ ضَنينُ",13,"ن",1,0],["المصفى منصب الشرق","ذو الوفا أَعلى الوَرى شرفا",14,"ف",2,0],["المصطفى هادي الأنام إلى الهدى","زين الوجود وخيرة الأخيار",15,"ر",1,0],["المصطفى الهادي إليك محمد","والآل والأصحاب ثم التابع",16,"ع",1,0],["المُصطفى في كلّ عصرٍ من غدا","سَلمانُ آلِ مشيرنا إكبارا",17,"ر",2,0],["أَلَمّ صُبحاً وجَمْرُ الحَلْيِ قد بَرَدا","وقد بَدا يَخْطِفُ الأبصارَ مُتّقِدا",18,"د",2,1],["المُصطَفى مِن ذِكرِهِ أَبَداً","لِلملك وَالمَلَكوت تَعطيرُ",19,"ر",1,0],["المصطفى خير الأنا","م وآله العالمين جدَّا",20,"د",2,0],["المصطفى الهادي النبي أجل من","وطئ الحصى يمشي على خدماته",21,"ت",2,0],["المصدر الأصل الذي قامت علي","ه الكائناتُ فكان منه المنشأ",22,"ا",1,0],["المصطفى من بدت في مثل ليلتنا","أنوار طلعته تنبي بإسعاد",23,"د",1,0],["المُصْطَفى من لُبِّ عُنْصُرِ هاشمٍ","من جاءَ بالقرآنِ مُنْتَظمَ السُّوَرْ",24,"ر",1,0],["ألمُصطفَى الهادي الذي مِن نُورِه","قد أشرَقت في الكَون شمسُ الأُفُقِ",25,"ق",1,0],["المُصرِمينَ مِنَ التِلا","دِ اللامِحينَ إِلى الأَقارِب",26,"ب",1,0]]}