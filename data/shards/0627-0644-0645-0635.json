494","الرجز"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121150","الكامل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104678","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201519","البسيط"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84473","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74235","البسيط"],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/138016",""],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/138004",""],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132730","السريع"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26117","البسيط"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45805","البسيط"],[3830,"","https://poetry.dctabudhabi.ae/diwan/poem/122293","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133226","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133256","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123496","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90920","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133088","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139658",""],[4764,"المسأله","https://www.poetsgate.com/ViewPoem.aspx?id=34653",""],[3859,"رنت بلابلُ في ودٍ من السلم","https://www.poetsgate.com/ViewPoem.aspx?id=124438",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5237,"أنوار سيدنا النبي المرسل","https://www.poetsgate.com/ViewPoem.aspx?id=113114",""],[5264,"لما واحد","https://www.poetsgate.com/ViewPoem.aspx?id=180139",""],[5277,"لا حدَّ للحبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=200206",""],[5277,"صَلُّوا عَلَيْهِ وَسَلِّمُوا تَسْلِيمًا","https://www.poetsgate.com/ViewPoem.aspx?id=200675",""],[5338,"سقيت ربعك غيث المدمع الهطل","https://www.poetsgate.com/ViewPoem.aspx?id=187697",""],[5353,"محمد (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=212456",""],[5596,"الهجرة النبوية","https://www.poetsgate.com/ViewPoem.aspx?id=205615",""],[5652,"أجر التصدق ؟","https://www.poetsgate.com/ViewPoem.aspx?id=177801",""],[5720,"المصطفىٰﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=198853",""],[5720,"الشَّافِع الْمَحْمُوْدﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=204407",""],[402,"لمصر سيوف في حديث جهادها","https://www.poetsgate.com/ViewPoem.aspx?id=35447",""],[5956,"مِزاحٌ مع ابنتي آنَ النحيلة","https://www.poetsgate.com/ViewPoem.aspx?id=203443",""],[5956,"حفيداي الطفلان أحمد وعابد","https://www.poetsgate.com/ViewPoem.aspx?id=206260",""],[6144,"أعوذ بالله","https://www.poetsgate.com/ViewPoem.aspx?id=21838",""],[6318,"القدس في خطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66164&r=&rc=14",""]],"verses":[["المصطفى والمرتضى والمجتبى","والمنتقى من عنصرِ العلياءِ",0,"ا",2,0],["المصميات من القوا","صد في كِنانته كثير",1,"ر",1,0],["المُصطَفى لِلمُؤمِنينِ خَليفَةً","وَالمُرتَضى لِحِياطَةِ الإيمانِ",2,"ن",1,0],["المُصلِحُ الأعلى أتمَّ نِظامَها","فانْظُرْ أَينقُضُهُ الغبيُّ الأَخرقُ",3,"ق",1,0],["المُصحَفُ السَيفُ وَالآياتُ أَدرُعُها","وَالقائِدُ الروحُ وَالمُختارُ حاميها",4,"ي",3,0],["المُصلحونَ على الزّمانِ سُيُوفُهُ","وجنودُه في حربِهِ وسلامهِ",5,"م",2,0],["المُصْدِرِي البِيضَ حُمْراً بعدَ ما وَرَدَتْ","مِنَ العِدا كُلَّ مُسْوَدٍّ مِنَ اللِّمَمِ",6,"م",1,0],["المصطفى وحواريُّوهُ إنْ ذُكِرُوا","فالشرقُ مَنبهةٌ والغربُ أصداءُ",7,"ا",2,0],["المُصلِحونَ أَصابِعٌ جُمِعَت يَداً","هِيَ أَنتَ بَل أَنتَ اليَدُ البَيضاءُ",8,"ا",2,0],["المصلى والجنود روائح","تغص بها أغواره ونجوده",9,"د",2,0],["المصطفى وحواريّوه إن ذكروا","فالشّرق منهبة ، والغرب أصداء",10,"ا",2,0],["المُصطفى والصفوة الحبيبُ","القانتُ الأوّاه والمنيبُ",11,"ب",1,0],["المُصطفى مِن آل سا","مٍ مِن بَني حامٍ ويافِث",12,"ث",1,0],["المُصيبونَ في دُجى الخَطبِ وَالمُع","طونَ في الجَدبِ وَالسَحابُ ضَنينُ",13,"ن",1,0],["المصفى منصب الشرق","ذو الوفا أَعلى الوَرى شرفا",14,"ف",2,0],["المصطفى هادي الأنام إلى الهدى","زين الوجود وخيرة الأخيار",15,"ر",1,0],["المصطفى الهادي إليك محمد","والآل والأصحاب ثم التابع",16,"ع",1,0],["المُصطفى في كلّ عصرٍ من غدا","سَلمانُ آلِ مشيرنا إكبارا",17,"ر",2,0],["أَلَمّ صُبحاً وجَمْرُ الحَلْيِ قد بَرَدا","وقد بَدا يَخْطِفُ الأبصارَ مُتّقِدا",18,"د",2,1],["المُصطَفى مِن ذِكرِهِ أَبَداً","لِلملك وَالمَلَكوت تَعطيرُ",19,"ر",1,0],["المصطفى خير الأنا","م وآله العالمين جدَّا",20,"د",2,0],["المصطفى الهادي النبي أجل من","وطئ الحصى يمشي على خدماته",21,"ت",2,0],["المصدر الأصل الذي قامت علي","ه الكائناتُ فكان منه المنشأ",22,"ا",1,0],["المصطفى من بدت في مثل ليلتنا","أنوار طلعته تنبي بإسعاد",23,"د",1,0],["المُصْطَفى من لُبِّ عُنْصُرِ هاشمٍ","من جاءَ بالقرآنِ مُنْتَظمَ السُّوَرْ",24,"ر",1,0],["ألمُصطفَى الهادي الذي مِن نُورِه","قد أشرَقت في الكَون شمسُ الأُفُقِ",25,"ق",1,0],["المصطفى المطهر الأمين مصرح","ومعرض بالقول حيث يقول",26,"ل",1,0],["المُصطَفى مِن آلِ سا","مٍ مَع بَني حامٍ وَيافِث",27,"ث",1,0],["المُصطَفى المرتَقي الأَفلاكِ معجزةً","وَكانَ في الحَربِ بالأملاكِ مرتَدَفا",28,"ف",2,0],["ألمصر أم للمشرقين كليهما","هذا الصباح الأبلج المصقول",29,"ل",1,0],["المصدر العافين قبل ورودهم","غرقى كأن براحتيه سيول",30,"ل",1,0],["المِصْقَعُ التوُّ الخَطيب المُعتَلي","حِذْقاً عَلى قِسِّ البَيانِ وَيعربِ",31,"ب",1,0],["المُصطَفى البرِّ الرّحيمْ","وَخَير رَاكِبي النّجيبْ",32,"ب",1,0],["المصطفى والمرتضى وفاطم","والمجتبي والسبط ظامي كربلا",33,"ل",2,0],["المُصطَفى مُحمَّد مَن أَرسَلَه","رَبّ الأَنامِ رَحمَةً مُسَلسَله",34,"ه",1,0],["المصطلون الحرب إن هي اضرمت","ودعت إلي إليّ يا من يصطلي",35,"ل",2,0],["المُصرِمينَ مِنَ التِلا","دِ اللامِحينَ إِلى الأَقارِب",36,"ب",1,0],["المصفى من العيوب بلا سبق","لعيب ولا اقتران فساد",37,"د",1,0],["المصطفى خاتم الرسل الكرام وكل الآل","والصحب والداعي إلى السنن",38,"ن",1,0],["المصطفى بحر الصفا نهج الوفا","مولى الكرام ممد كل منبه",39,"ب",2,0],["المُصطَفى أَحمَد المُختار مِن مُضَر","لَه مِن اللَهِ تَعظيم وَتَبجيلُ",40,"ل",1,0],["المصطفى الهادي البشير الطاهر ال","طهر الشفيع الصادق المأمون",41,"ن",1,0],["المصطفى وَالمُرتَضى","وابناه وَالزهرا البتول",42,"ل",1,0],["المُصطَفى مِن نَسلِ آدَمَ وَالوَرى","في ظُلمَةِ العُدمِ القَديمِ الشاءِ",43,"ا",2,0],["المصطفى واسع الخلائق","فضلاً وجوداً لهم عميم",44,"م",1,0],["المصمتات دمالجا وخلاخلا","ولكل قلب مفصح وسوار",45,"ر",1,0],["المُصلِحونَ وَلَيسَ فيهِم مُصلِحٌ","الطاهِرونَ وَأَيُّهُم لَم يَفجُرِ",46,"ر",1,0],["المصطفى وبفاطم","وبنيكما طهروا وطابوا",47,"ب",3,0],["المصطفى المُجتبى الهادي بدعوته","أشفق وأكفى وأوفى الناس بالذّمم",48,"م",1,0],["أَلمُصطفى مِن بَنى مُضَرِ","كاشِفُ الأَحزَانِ وَالضَّرَرِ",49,"ر",1,0],["المُصطَفى مِن أَرومٍ طابَ عُنصُرُها","مُحَمَّدِ الطاهِرِ بنِ الطاهِرِ النَسَبِ",50,"ب",1,0],["المصطفى على الورى والمحتبى","بالحب والقرب الرضى محمدا",51,"د",2,0],["المصطفون ثلاثةٌ مذكورةٌ","أسماؤهم منهم إمامٌ ظالم",52,"م",1,0],["المصطفى المختار من لولاه","ما كون الاله من سواه",53,"ه",1,0],["المصطفى قد قال وهو الصادق","المصدوق من فخرت به عدنان",54,"ن",1,0],["المُصطَفى المُنتَقى الهادي النَبِيِّ بِهِ","ذاكَ الحَبيبُ الرَؤوفُ المستَعانُ بِهِ",55,"ه",1,0],["المصلحون هم الأرواح سارية","في الكون ليس به لولاهمُ رَمقُ",56,"ق",1,1],["المصدري البيض حمراً بعدما وردت","حوض الرقاب مشوقات لشرب دم",57,"م",1,0],["المُصطَفى المجتَبى مِن كُل مُنتخب","وَمَن نَمته إِلى العَلياء أطهار",58,"ر",1,0],["المصطفى المبعوث رحمه شامله للعاملين","أسألك به عجل قضى حاجات كل الزائرين",59,"ن",1,0],["المصطفى درة الأكوان","والآل ما غرد القمري",60,"ر",2,0],["المصطفى الهادي وابناؤه","مصابح الرشد بحور الكرم",61,"م",1,0],["المُصدري الأَمرَ قَد أَعيَت مَصادِرُهُ","وَالمَطعَمي الشَحمَ حَتّى يُرسَلَ المَطَرُ",62,"ر",1,0],["المصطفى المبجل الصديقي","الخلوتيّ عمدة الطريق",63,"ق",1,0],["المَصدَرُ اسمُ مَا سِوَى الزَّمَانِ مِن","مَدلُولَىِ الفِعلِ كأَمنٍ مِن أمِن",64,"ن",1,0],["أَلمُصطَفى صَفوة الرَحمن مِن لسنا","أَنواره اِنشَقَ بَدر التم في الظُلم",65,"م",1,0],["المصطفى المشهور خير اللَه من","بالحق ارخناه قاضي الشام",66,"م",1,0],["المصطفى الهادي البشير محمد","من أنجبته سادة نجباء",67,"ا",2,0],["المصطفى المجتبى المحمود سيرته","من كان خادمه بالوحى جبريل",68,"ل",1,0],["المصطفى المقتفى يوم المعاد اذا","سعت سراعا له الافواج لوّاذا",69,"ذ"