{"poems":[[85,"بشرى كما وضح الزمان وأجمل","https://www.aldiwan.net/poem54256.html","الكامل"],[74,"أصبحت لم أخش للزمان أذى","https://www.aldiwan.net/poem19174.html","المنسرح"],[74,"بانت سعاد حقيقة","https://www.aldiwan.net/poem19689.html","مجزوء الكامل"],[53,"مستقبل خائفه الصفح مستقبل آمنه المنح","https://www.aldiwan.net/poem9400.html","السريع"],[93,"ليت الذي خلق العيون السودا","https://www.aldiwan.net/poem8816.html","عموديه"],[87,"يا قلب أحمد","https://www.aldiwan.net/poem7883.html","مجزوء الكامل"],[87,"انظر إلى الأقمار كيف تزول","https://www.aldiwan.net/poem62837.html","الكامل"],[47,"أحاجيك هل للحب كالدار تجمع","https://www.aldiwan.net/poem64680.html","الطويل"],[47,"قولوا لسرجس يا ابن القحبة الشبقه","https://www.aldiwan.net/poem65212.html","الخفيف"],[47,"كفي الملامة أو دومي على العذل","https://www.aldiwan.net/poem65639.html","البسيط"],[47,"لاتجزين أبا عبيدة صالحا","https://www.aldiwan.net/poem66810.html","الكامل"],[63,"هذي المعارف منهم فتعرفا","https://www.aldiwan.net/poem51553.html","الكامل"],[107,"حي الكنانة وانظر كيف تدكر","https://www.aldiwan.net/poem43044.html","البسيط"],[69,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[50,"دم المكارم بالفسطاط مسفوح","https://www.aldiwan.net/poem62539.html","البسيط"],[48,"يا نفس آه لمتجر متنزر","https://www.aldiwan.net/poem22699.html","الكامل"],[48,"لا يغبطن ماش فوارس شزب","https://www.aldiwan.net/poem23253.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85432","الكامل"],[47,"لا تَجْزِيَنْ أبَا عُبَيدَةَ صَالحاً","https://www.poetsgate.com/ViewPoem.aspx?id=31822",""],[173,"ما أنصف الطلل العافي بماوانا","https://www.aldiwan.net/poem1685.html",""],[189,"لقيت في الحب ما لاقاه من هممى","https://www.aldiwan.net/poem14659.html","البسيط"],[193,"هواي طيبة لا بيضاء عطبول","https://www.aldiwan.net/poem35275.html","البسيط"],[240,"غاداك من بحر الرواعد مسبل","https://www.aldiwan.net/poem31795.html","الكامل"],[240,"لو لان قلبك في الهوى","https://www.aldiwan.net/poem32147.html","الكامل"],[287,"وهو الذي لم يزل تهمي أنامله","https://www.aldiwan.net/poem32887.html","البسيط"],[409,"كم ذا التلعب يا غزال الأجرع","https://www.aldiwan.net/poem33672.html","الكامل"],[409,"عساه يرضى المغضب","https://www.aldiwan.net/poem34160.html","مجزوء الرجز"],[443,"يا حادياً هلا وقفت قليلا","https://www.aldiwan.net/poem2575.html","الكامل"],[469,"قف بالمنازل أو كناس ظبائها","https://www.aldiwan.net/poem3275.html","عموديه"],[473,"ودعت غزلان المقاصر","https://www.aldiwan.net/poem60040.html","مجزوء الكامل"],[484,"بعث الحبيب بصورة","https://www.aldiwan.net/poem36967.html","مجزوء الكامل"],[520,"هل تعلمان طريقة لم تطرق","https://www.aldiwan.net/poem12186.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122659","الطويل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34410","الكامل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34430","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120017","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119893","المنسرح"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119894","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46522","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49967","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49919","الكامل"],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124018","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79850","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127955","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100996","البسيط"],[1901,"","https://poetry.dctabudhabi.ae/diwan/poem/216574","البسيط"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110318","البسيط"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110345","الكامل"],[2164,"","https://poetry.dctabudhabi.ae/diwan/poem/101863","الرجز"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28560","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106836","الكامل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129847","السريع"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100889","البسيط"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137395",""],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75929","البسيط"],[3115,"","https://poetry.dctabudhabi.ae/diwan/poem/216341",""],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130101","المجتث"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130038","الكامل"],[3232,"","https://poetry.dctabudhabi.ae/diwan/poem/100431","الكامل"],[3318,"","https://poetry.dctabudhabi.ae/diwan/poem/138744",""],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62874","المنسرح"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48326","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48456","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48457","الكامل"],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104840","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103015","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66144","الكامل"],[4984,"من رواق جميل بثينة","https://www.poetsgate.com/ViewPoem.aspx?id=175550",""],[5277,"عبق وشوق","https://www.poetsgate.com/ViewPoem.aspx?id=184923",""],[5409,"بلغت يا أيها النحات منزلة","https://www.poetsgate.com/ViewPoem.aspx?id=155284",""],[5442,"مادون رامة من معرس","https://www.poetsgate.com/ViewPoem.aspx?id=114778",""],[5520,"رأى ببابِ القصر جنيةً","https://www.poetsgate.com/ViewPoem.aspx?id=96129",""],[5542,"يا قدس","https://www.poetsgate.com/ViewPoem.aspx?id=10200",""],[5674,"الرمش بحر هادر","https://www.poetsgate.com/ViewPoem.aspx?id=185728",""],[5684,"عيد","https://www.poetsgate.com/ViewPoem.aspx?id=188300",""],[5956,"لولا اللقاءُ والخيالُ","https://www.poetsgate.com/ViewPoem.aspx?id=182089",""],[5956,"اشتاقتِ الأرواحُ للأرواحِ","https://www.poetsgate.com/ViewPoem.aspx?id=182127",""],[5956,"أسفي لقد مات القريب النضْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=194076",""],[240,"لَوْ لاَنَ قَلْبُكَ فِي کلْهَوَى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26488&r=&rc=13",""]],"verses":[["لولا نَداك لها لما نفع الندى","ولجفَّ من وِرد الصنائع منهلُ",0,"ل",1,0],["لولا نداك العميم يشملنا","ما كان بيني وبينهم جامع",1,"ع",1,0],["لولا ندى قاضي القضا","ة لواثق القصد انْفصم",2,"م",1,0],["لولا نداه هلكتْ أُمَّةٌ","لكنْ لها مِنْ رُوحِهِ نَفحُ",3,"ح",1,0],["لَولا نَواعِسُها وَلَولا سِحرُها","ما وَدَّ مالِكُ قَلبِهِ لَو صيدا",4,"د",2,0],["لولا نوى ابن محمد","ما راعني إلا جفاك",5,"ك",1,0],["لَولا نُفوسٌ زُلنَ في سُبُلِ العُلا","لَم يَهدِ فيها السالِكينَ دَليلُ",6,"ل",1,0],["لَولا نَوالٌ مِنكَ قَيَّدَ عَزمَتي","لَكانَ بِأَبروجِردَ خِرقٌ سَمَيدَعُ",7,"ع",1,0],["لَولا نُحوسٌ تَوَلَّت عَنكَ مُعرِضَةٌ","تُريدُ غَيرَكَ بِالآفاتِ مُختَرِقَه",8,"ق",2,0],["لَولا نَداهُ وَلَولا سَيفُ نِقمَتِهِ","دارَت رَحى الدينِ وَالدُنيا عَلى ثَكَلِ",9,"ل",1,0],["لَولا نَصيبي مِن إِخائِكَ رِنَّهُ","عَلقٌ غَدَوتُ بِهِ الغَداةَ ضَنينا",10,"ن",2,0],["لولا نَوالُ يَدِ الغَضَنْفَرِ أصبحَتْ","عَرَصاتُ هذا المجدِ قاعاً صَفْصَفا",11,"ف",2,0],["لو لاَنَ للغاصبِ العادي لأَوْرثكم","ذُلَّ الحياةِ فلا عزٌّ ولا خَطرُ",12,"ر",1,0],["لَوْلا نبيُّ الهدَى ما كانَ فِي فَلَكٍ","عَلَى الشياطينِ للأَملاكِ تَوْكِيلُ",13,"ل",1,0],["لَولا نَدى اِبنِ جُوَيٍّ أَحمَدٍ نَطَقَت","مِنّي المَفاصِلُ فيكُم وَالجَواريحُ",14,"ح",1,0],["لَولا نَفاسَتُهُ لَسُهِّلَ نَهجُهُ","كَأَذى الضَعيفِ عَلى اللَئيمِ المَكسِرِ",15,"ر",1,0],["لَولا نَوافِرُ في القَديمِ تَناسَلَت","ما أَنضَجَ الظَبِيّاتِ غَليُ مَراجِلِ",16,"ل",1,0],["لَولا نجوم اللَيل ضل","لَ سَبيله في اللَيل ساري",17,"ر",2,0],["لَوّلا نَصِيبي مِنْ إخائِكَ أنّهُ","عِلْقٌ غَدَوْتُ بهِ الغَداةَ ضَنينَا",18,"ن",2,0],["لَولا نُزولهُمُ في جَوِّها لَرَأَت","رَبِيعَةٌ هَرَباً كَيشاً وَمَكرانا",19,"ن",2,0],["لولا نتائجُ ما تقِضى العقولُ به","على النفوسِ لكانَ الناسُ كالنَّعَم",20,"م",1,0],["لولا نجومُ هدىً من شمسكَ اِقتبسوا","أنوارَهم عمّت الدنيا الأضاليلُ",21,"ل",1,0],["لَولا نُصولُ ذَوائِبي لَم تَلقَني","مِن غَيرِ جُرمٍ في الهَوى أَتَنَصَّلُ",22,"ل",1,0],["لَو لانَ قَلبُكَ في الهَوى","لَرَثَيتَ لي مِن لَوعَةِ الحُبِّ",23,"ب",1,1],["لَولا نَدى الأَشرَفِ المَيمونِ طائِرُهُ","في دَهرِنا لَم يَرُق عَيشٌ وَلَم يَطِبِ",24,"ب",1,0],["لولا نظام للصفي صفا به","عيشي وأشرق منه نوراً مربعي",25,"ع",2,0],["لولا نحولي في الهوى","لكان فيها العطب",26,"ب",1,0],["لولا نوالك في البرية صرّحت","زهر الأماني واكتسين ذبولا",27,"ل",2,0],["لولا نداه لما وثقت لنفسه","بسلامة من نار فرط ذكائها",28,"ا",3,0],["لَولا نَوى لَم أَجنِها","حَجَرَت عَلى الدَمعِ المَحاجِر",29,"ر",1,0],["لولا نظيرتها التي","نقشت على هذا الفؤاد",30,"د",1,0],["لولا ندى ماء السماحة ما غدا","ماء الفصاحة مهرقاً في مهرق",31,"ق",1,0],["لولا نَسيمُ الرّيحِ ما فَضَحَ البُكا","غَرامي ولا نمَّت عَلَيّ المَدامِع",32,"ع",1,0],["لَولا نظامُ الملك في تَدبيرهِ","لَم يَستَقِم في المُلك حال الناسِ",33,"س",1,0],["لَولا نَداه خَشينا نارَ فكرته","لكنّه بنداه مطفئُ الشررِ",34,"ر",1,0],["لولا ندى كفيه ما سكنت","روح المكارم والعلى جسدا",35,"د",2,0],["لولا نداك انطوى القريض وما","كان له بعد طيه ناشرُ",36,"ر",1,0],["لولا نداك الغمر بت مبدلا","بالأهل أهلا والبلاد بلادا",37,"د",2,0],["لَولا نَفاذ القَدر المَحتوم","ما بت بِالحَبس رَفيق البوم",38,"م",1,0],["لو لا نوالُ بني نبهان يشملنا","لم ندرِ ايَّ نباتٍ يُنبت المَطَرُ",39,"ر",1,0],["لولا ندى يعْربٍ فتَى العَرَب","لما حمدنا إصابَة الأدبِ",40,"ب",1,0],["لولا نوى آل دعدٍ ما بكيت ولا","أودى بي الهمّ بعد الهمّ والسهدُ",41,"د",1,0],["لولا نظارة ولده","لحلفت عزَّ عن النظيرِ",42,"ر",1,0],["لولاندا هذا العزيز وبره","لرحلت عن وطنى العزيز وناسى",43,"س",2,0],["لَولا نفس عليها للعُلا ذِمم","لم يُنسها المجد تغريبٌ ولا سَفَر",44,"ر",1,0],["لولا نواعِسُ أجفانِ الملاحِ لما","سمعتَ يوماً بأنَّ النومَ سلطانُ",45,"ن",1,0],["لولا نوائبها ما هان جانبنا","ولا جرت دمعةٌ من عين قحطاني",46,"ن",2,0],["لولا نبوغك ما بكيت صباكا","أنت المصاب بذا ونحن بذاكا",47,"ك",2,1],["لولا نداك لاغتدى","على الهلاك مشرفا",48,"ف",2,0],["لَولا نَصيرُ المُلكِ طالَ ثَواؤُهُ","فيها وَلَيسَ لأَسرِهِ إِطلاقُ",49,"ق",1,0],["لولا نضارتُها ولولا طهرُها","لرأيتِ كلَّ الناس عنها ينزح",50,"ح",1,0],["لولا ندى يحيى وتدبيرهُ","ما برحت تغبرّ منها النواح",51,"ح",1,0],["لولا نخافُ على ذكراك بعدَ غدٍ","إن قيل هذا لَعمرِى صنع جبار",52,"ر",1,0],["لولا نداه ولولا جود راحته","لم يعرف الناس فيما بينهم نعما",53,"م",2,0],["لَولا نَدى إِحسانِكم في الوَرى","كُنتُ كَعَظمٍ هامِدٍ ناخِرِ",54,"ر",1,0],["لوّل انا خابره للبدو مدهال","واليوم ما تْمِرّ به يا غير خبّيبه",55,"ب",2,0],["لو لان في بيع مصر","لكانَ خير جوادِ",56,"د",1,0],["لولا نوالكِ ما تهافَت جمعُهم","يتلقّطونَ الخيرَ في واديكِ",57,"ك",1,0],["لولا نوى الرشأ الذيب سكن الحشى","يا صاح ما هاج العيون الذرفن",58,"ن",1,0],["لولا نواحك ما اهتدى لك مدرك","كلا ولم تحسب من الأحياء",59,"ا",2,0],["لولا ندى حاتِمٍ وَسُؤدَدُهُ","ما فَخَرَتْ طيٌّ على أَحَدِ",60,"د",1,0],["لولا نَوالُكَ أيُّها المَلِكُ الرّضَى","وحُلا خِلالِكَ لم يُجِدْ إنْشادَها",61,"د",3,0],["لوْلا نَداكَ وما أوْلَيْتَ من نِعَمٍ","ما راقَ منهُ فُراداهُ وتوْأمُهُ",62,"م",2,0],["لوْلا نوالُك ما أجادَ لسانُهُ","إنشادَها أو فِكْرُهُ إنشاءَها",63,"ا",3,0],["لولا نبال قسي من حواجبها","قطفت باللحظ منها وردة الخجل",64,"ل",1,0],["لولا نداك تعطلت ملل الندى","إنالزمان سدى بغير إمام",65,"م",1,0],["لَوْلا نَزَعْنا لِلْهُدَى ثَوْبَ الهَوَى","لانْجابَ عن عُبُدِ الضَّلالَةِ عارُها",66,"ر",3,0],["لولا نحيب في سياق لحونه","ما كان يفنى مجده بزواليا",67,"ل",3,0],["لولا نسيمُ الهوى ما شمّني بشرٌ","إلا كما تشتهيه الروحُ تعتنقُهْ",68,"ق",2,0],["لولا نبوغك بين الناس ما عكفوا","على عبادة أشباح نسانيس",69,"س",1,0],["لولا نداه لما أتا","ه بذنبه مثلي مدنس",70,"س",1,0],["لولا نهودٌ بان في صدرها","قلت فتى يوعدُ بالشر",71,"ر",1,0],["لولا نَسائمُ من عطاءِ أحبَّةٍ","رسموا الوفاءَ ببذلهم وأعانوا",72,"ن",3,0],["لولا نحرت من الغرام وريده","لغدا فؤادي .. دائم الخفقان",73,"ن",1,0],["لولا نبيي وقرآني كما سلفي","لهنتَ يا عيد حتى توقد السرج",74,"ج",1,0],["لولا نمارس بالأحلام حاجتنا","كنا ملأنا الفضا والأرض طغيانا",75,"ن",2,0],["لولا نخفف شيئاً من لظى دمنا","عبر الخيال لثار الكون بركانا",75,"ن",2,0],["لولا نقاؤكَ لم تكن لي مخلصاً","‏ ‏ للحدّ هذا جائداً بسماحِ",76,"ح",1,0],["لولا نعاني ألف تقصير لما","عِشتَ البسيطَ وما لديك القصرُ",77,"ر",1,0],["لَوْ لاَنَ قَلْبُكَ فِي کلْهَوَى","لَرَثَيْتَ لِي مِنْ لَوْعَة ِ کلْحُبِّ",78,"ب",1,1]]}