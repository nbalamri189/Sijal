{"poems":[[53,"سلا ظاهر الأنفاس عن باطن الوجد","https://www.aldiwan.net/poem30601.html","الطويل"],[3,"سلا القلب عما كان يهوى","https://www.aldiwan.net/poem128.html",""],[88,"عهد الصبا سقيا لأيام الصبا","https://www.aldiwan.net/poem44447.html","الرجز"],[27,"ألا حي ربع المنزل المتقادم","https://www.aldiwan.net/poem4453.html","الطويل"],[27,"أجد اليوم جيرتك ارتحالا","https://www.aldiwan.net/poem5947.html","الوافر"],[51,"تركنا لكم دنياكم وتخاضعت","https://www.aldiwan.net/poem61913.html","الطويل"],[32,"لقد ذرفت عيني وطال سفوحها","https://www.aldiwan.net/poem27787.html","الطويل"],[85,"هنيئا أمير المؤمنين فإنما","https://www.aldiwan.net/poem63777.html","الطويل"],[58,"ليبك على الاسلام من كان باكيا","https://www.aldiwan.net/poem30873.html","الطويل"],[22,"لقد ذهبت خيرات قوم يسودهم","https://www.aldiwan.net/poem21679.html","الطويل"],[48,"رأيت نسا هذا الزمان خبائي","https://www.aldiwan.net/poem66241.html","الطويل"],[50,"ألا يا نفس المسك الذي","https://www.aldiwan.net/poem63800.html","الهزج"],[50,"يا خاتم الملك يا سمعي ويا بصري","https://www.aldiwan.net/poem63811.html","البسيط"],[50,"لقد ذكرتني ليلة القدر مجلسا","https://www.aldiwan.net/poem63947.html","الطويل"],[50,"يا طيب عبدة ويلي منك يا طيبي","https://www.aldiwan.net/poem64854.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85589","المتقارب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42577","الطويل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116980","المتقارب"],[51,"تركْنا لكُمْ دنياكُمُ وتخاضَعَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=28466",""],[125,"لقد ذهب الصبا ومضى","https://www.aldiwan.net/poem23797.html","مجزوء الوافر"],[144,"لقد أدنت لك البلد السحيقا","https://www.aldiwan.net/poem11785.html","الوافر"],[161,"قوامك مثل معتدل القناة","https://www.aldiwan.net/poem59052.html","الوافر"],[186,"أما والذي قد قدر البعد بيننا","https://www.aldiwan.net/poem14505.html","الطويل"],[205,"أخي لا تؤاخذني وإن كان لي","https://www.aldiwan.net/poem53356.html","الطويل"],[271,"لقد ذهبت تلك الأماني الخوادع","https://www.aldiwan.net/poem35239.html","الطويل"],[271,"إذا غاب جسمي في الثرى رافقي ظلي","https://www.aldiwan.net/poem35631.html","الطويل"],[271,"دعيني أمت حرا يخلده الذكر","https://www.aldiwan.net/poem35633.html","الطويل"],[271,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[298,"لقد ذهبت أنفس العاشقين","https://www.aldiwan.net/poem33313.html","المتقارب"],[306,"أما والذي قد قدر البعد بيننا","https://www.aldiwan.net/poem56563.html","الطويل"],[321,"ولا تشك من خطب ألم إلى فتى","https://www.aldiwan.net/poem61798.html","الطويل"],[365,"أقلا عند طيتي المقالا","https://www.aldiwan.net/poem60808.html","الوافر"],[401,"عندما يكون العتاب دليلاً على الحب","https://www.aldiwan.net/poem6750.html","عموديه"],[433,"أشاقك برق بالدجنة لائح","https://www.aldiwan.net/poem12585.html","الطويل"],[462,"أسر بالبرق لا حرصا على الديم","https://www.aldiwan.net/poem16089.html","البسيط"],[465,"بقبرك فلتسحب ذيول السحائب","https://www.aldiwan.net/poem3210.html","عموديه"],[465,"شهيدا غرامي ادمعي وسجومها","https://www.aldiwan.net/poem3217.html","عموديه"],[465,"مضى صاحب الصدر الذي حازه الصدر","https://www.aldiwan.net/poem3394.html","عموديه"],[501,"عليك سلام الله أفرطت يا مي","https://www.aldiwan.net/poem37725.html","الطويل"],[514,"ألا تكن في الهوى أرويت من ظماء","https://www.aldiwan.net/poem67749.html","البسيط"],[576,"لقد ذهبت نفسي وقد صفرت يدي","https://www.aldiwan.net/poem2970.html","الطويل"],[588,"على دارس الأطلال بالمتحلب","https://www.aldiwan.net/poem11503.html","عموديه"]],"verses":[["لَقَد ذَهَبَ العَيشُ الرَقيقُ بِذاهِبٍ","هُوَ الغارِبُ المُجزولُ مِن ذُروَةِ المَجدِ",0,"د",1,0],["لَقَد ذَلَّ مَن أَمسى عَلى رَبعِ مَنزِلٍ","يَنوحُ عَلى رَسمِ الدِيارِ وَيَندُبُ",1,"ب",1,0],["لقد ذوى غصن حياتي بعده","وكان ريّان التصابي والمنى",2,"ا",1,0],["لَقَد ذُقتَ مِنّي طَعمَ حَربٍ مَريرَةٍ","وَما أَنتَ إِن جارَيتَ قَيساً بِسالِمِ",3,"م",1,0],["لَقَد ذَرَفَت دُموعُكَ يَومَ رَدّوا","لِبَينِ الحَيِّ فَاِحتَمَلوا الجِمالا",4,"ل",2,0],["لقد ذُدْتُمونا من مشارِبَ جَمَّةٍ","وغَرَّقْتُمُ في غمرها كلَّ جاحدِ",5,"د",1,0],["لَقَد ذَرَفَت عَيني وَطالَ سُفوحُها","وَأَصبَحَ مِن نَفسي سَقيماً صَحيحُها",6,"ح",3,1],["لَقَد ذَهَبَت راياتُهُم غَيرَ رايَةٍ","لَها النَصرُ وَسمٌ وَالفُتوحُ شِياتُ",7,"ت",1,0],["لَقَد ذَهَبَ الاِسلامُ إِلّا بَقيّةً","قَليلٌ مِنَ الناسِ الَّذي هُوَ لازِمُه",8,"ه",1,0],["لَقَد ذَهَبَت خَيراتُ قَومٍ يَسودُهُم","قُدامَةُ خُصيا قَنبَلِيٍّ مُهَمَّلِ",9,"ل",1,1],["لقد ذلّ يا ابنَ المائر القُصبِ امرؤٌ","تكونُ له في العالمين غياثا",10,"ث",2,0],["لَقَد ذَكَّرَني وَجهُ","كَ وَجهَ القَمَرِ الأَزهَر",11,"ر",1,0],["لَقَد ذَكَرتُ وَما حُبّى بِذاكِرَةٍ","ما كانَ مِنّي وَمِنها مَوهِنَ البَصَرِ",12,"ر",1,0],["لَقَد ذَكَّرَتني لَيلَةُ القَدرِ مَجلِساً","لِثِنتَينِ مِن شِعبٍ عَلى غَيرِ مَوعِدِ",13,"د",1,1],["لقَد ذَكَرتُكِ وَالفَوقانُ يَأخُذُني","وَما نَسيتُكِ بَينَ الكَأسِ وَالكوبِ",14,"ب",1,0],["لَقَد ذكر الغرب أيامه","فَهَل نسي الشرق عهداً قداما",15,"م",2,0],["لَقَدْ ذَلَّ مَنْ يَبْغِي مِنَ النَّاسِ نَاصِراً","وَقَد خَابَ مَنْ يَجْنِي مِنَ الأَرْقَمِ الشَّهْدَا",16,"د",2,0],["لقَد ذَهَبَ الأنسُ والمانعونَ","ومن كان يسكَنُ في ظلّه",17,"ه",1,1],["لقد ذُدْتُمونا من مشارِبَ جَمَّة ٍ","وغَرَّفْتُمُ في غمرها كلَّ جاحدِ",18,"د",1,0],["لقد ذهب الصبا ومضى","بتذكاراته الحلوة",19,"و",2,1],["لَقَد ذَكَروا عَلى جَرَشٍ طِعاناً","بِلوبِيَةٍ بَلَوكَ بِهِ خَليقا",20,"ق",2,0],["لقد ذكرتني عهد التصابي","وأياما بلعلع ماضيات",21,"ت",1,0],["لقد ذاب قلبي في دُموعي عليكمُ","على أنه في النائبات حَديد",22,"د",1,0],["لقد ذُبتُ إذ أبدى إليَّ مضاحكاً","كما ذاب شيطانٌ تقض له شهبُ",23,"ب",1,0],["لقد ذهبت تلكَ الأماني الخوادعُ","وما هي يوماً للضَّعيفِ خواضعُ",24,"ع",1,1],["لقد ذبلت أزهارُ وردٍ نقلتِها","من الورقِ النامي الى شَعرك الجثل",25,"ل",1,0],["لقد ذبلت أغصانُنا في رَبيعها","ولكنْ أُرَجِّي أن يُعاودَها النضر",26,"ر",1,0],["لقد ذهبت بطلاً دماءٌ عزيزةٌ","بتهريقها ذو البطلِ أصبح أبطرا",27,"ر",2,0],["لَقَد ذَهبَت أَنفسُ العاشقين","عَلى نار وَجنَتِه حَسراتِ",28,"ت",1,1],["لَقَد ذابَ قَلبي في اِشتياقي إِليكمُ","وَجادَت بهِ عينٌ عليَّ جمودُ",29,"د",1,0],["لَقَد ذَهَبَ الناسُ الكِرامُ فَلا اِمرِؤٌ","يواسيكَ وَيُسَلّيكَ أَو يَتَرَجَّعُ",30,"ع",1,0],["لقد ذَمَّ الزَّمانَ إلى هَواهُ","أخو ذِمَمٍ عقَدْتَ له حِبالا",31,"ل",2,0],["لقد ذبل الزرع في روضتي","ولولا جفاؤك لم يذبل",32,"ل",1,0],["لقد ذكرَتْنا عهد ظَمياءَ باللِّوى","حمائمُ أيك في ذراهُ صوادِحُ",33,"ح",1,0],["لقد ذخرتَ وليّاً غيرَ مُنْتقلٍ","إذا أحبَّ وفَضْلاً غيرَ مُكتَتَم",34,"م",1,0],["لقد ذقت طعم الثكل فيك فهونت","مصائبنا يا ابن الملوك المصاعب",35,"ب",1,0],["لقد ذل إلا عند مثلك مثلها","وعز على ملك سواك قدومها",36,"م",3,0],["لقد ذاب ماء الدمع بعد جموده","وما ذاب ماء في اساً قبله جمر",37,"ر",1,0],["لقد ذابَ فيكِ العاشِقونَ تَوَلُّهاً","فما لهُمُ يا مَيُّ إن وَقَفوا فَيُّ",38,"ي",1,0],["لقد ذللت على محض الهوى لك لا","لأجل ما كان مرجوّاً ومدخورا",39,"ر",2,0],["لقد ذَهبتْ نَفْسي وقد صَفِرت يَدي","بنَاقِضَةِ الميثاقِ ناكثةِ العَهْدِ",40,"د",1,1],["لقد ذكرت عهد المحب فأقبلت","وقد آمنت عين الرقيب المؤنب",41,"ب",1,0]]}