i.ae/diwan/poem/91061","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92170","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91771","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91439","الطويل"],[3750,"","https://poetry.dctabudhabi.ae/diwan/poem/126515","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135346","الطويل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75680","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125916","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94736","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83671","الطويل"],[4461,"","https://poetry.dctabudhabi.ae/diwan/poem/116089","الوافر"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33525","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139728",""],[4636,"","https://poetry.dctabudhabi.ae/diwan/poem/203891","الطويل"],[4755,"لِإِيْلَافِ قَلبي","https://www.poetsgate.com/ViewPoem.aspx?id=183517",""],[4755,"أَنا ضائِعِي في كُلِّ يَومٍ.. وخابِئِي","https://www.poetsgate.com/ViewPoem.aspx?id=184088",""],[4968,"محمد","https://www.poetsgate.com/ViewPoem.aspx?id=208077",""],[5092,"سؤال","https://www.poetsgate.com/ViewPoem.aspx?id=190569",""],[5213,"أشاقك أن ترى الربع المحيلا","https://www.poetsgate.com/ViewPoem.aspx?id=170514",""],[5213,"ألا للّه خطبك ما أجلا","https://www.poetsgate.com/ViewPoem.aspx?id=170531",""],[5277,"خاتمةُ المراثي","https://www.poetsgate.com/ViewPoem.aspx?id=199869",""],[5320,"شهيد العروبة","https://www.poetsgate.com/ViewPoem.aspx?id=43102",""],[5376,"علا القدسَ في أرجائها الحقُّ والعدلُ","https://www.poetsgate.com/ViewPoem.aspx?id=188562",""],[5431,"أنا المذبوح والشعر الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=186338",""],[5431,"تمرّد في شرع الهوى وهو حاكمُ","https://www.poetsgate.com/ViewPoem.aspx?id=190013",""],[5431,"لروحك قد زرعتُ الكون عشقا ..","https://www.poetsgate.com/ViewPoem.aspx?id=191109",""],[5431,"وصلّت مع الضحكة التاسعة","https://www.poetsgate.com/ViewPoem.aspx?id=197802",""],[243,"العش المهجور","https://www.poetsgate.com/ViewPoem.aspx?id=50479",""],[5689,"أظل خيالي أم ضرام جهنم","https://www.poetsgate.com/ViewPoem.aspx?id=143403",""],[5759,"تعالي","https://www.poetsgate.com/ViewPoem.aspx?id=213914",""],[5780,"الإخلاص","https://www.poetsgate.com/ViewPoem.aspx?id=187626",""],[5861,"سراب الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=188086",""],[6093,"عَلى أَطْلالِ بَعْضِيَ قَامَ بَعْضِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=191508",""],[6218,"زمن أم عمرو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65904&r=&rc=57",""]],"verses":[["لَقَد ذَهَبَ العَيشُ الرَقيقُ بِذاهِبٍ","هُوَ الغارِبُ المُجزولُ مِن ذُروَةِ المَجدِ",0,"د",1,0],["لَقَد ذَلَّ مَن أَمسى عَلى رَبعِ مَنزِلٍ","يَنوحُ عَلى رَسمِ الدِيارِ وَيَندُبُ",1,"ب",1,0],["لقد ذوى غصن حياتي بعده","وكان ريّان التصابي والمنى",2,"ا",1,0],["لَقَد ذُقتَ مِنّي طَعمَ حَربٍ مَريرَةٍ","وَما أَنتَ إِن جارَيتَ قَيساً بِسالِمِ",3,"م",1,0],["لَقَد ذَرَفَت دُموعُكَ يَومَ رَدّوا","لِبَينِ الحَيِّ فَاِحتَمَلوا الجِمالا",4,"ل",2,0],["لقد ذُدْتُمونا من مشارِبَ جَمَّةٍ","وغَرَّقْتُمُ في غمرها كلَّ جاحدِ",5,"د",1,0],["لَقَد ذَرَفَت عَيني وَطالَ سُفوحُها","وَأَصبَحَ مِن نَفسي سَقيماً صَحيحُها",6,"ح",3,1],["لَقَد ذَهَبَت راياتُهُم غَيرَ رايَةٍ","لَها النَصرُ وَسمٌ وَالفُتوحُ شِياتُ",7,"ت",1,0],["لَقَد ذَهَبَ الاِسلامُ إِلّا بَقيّةً","قَليلٌ مِنَ الناسِ الَّذي هُوَ لازِمُه",8,"ه",1,0],["لَقَد ذَهَبَت خَيراتُ قَومٍ يَسودُهُم","قُدامَةُ خُصيا قَنبَلِيٍّ مُهَمَّلِ",9,"ل",1,1],["لقد ذلّ يا ابنَ المائر القُصبِ امرؤٌ","تكونُ له في العالمين غياثا",10,"ث",2,0],["لَقَد ذَكَّرَني وَجهُ","كَ وَجهَ القَمَرِ الأَزهَر",11,"ر",1,0],["لَقَد ذَكَرتُ وَما حُبّى بِذاكِرَةٍ","ما كانَ مِنّي وَمِنها مَوهِنَ البَصَرِ",12,"ر",1,0],["لَقَد ذَكَّرَتني لَيلَةُ القَدرِ مَجلِساً","لِثِنتَينِ مِن شِعبٍ عَلى غَيرِ مَوعِدِ",13,"د",1,1],["لقَد ذَكَرتُكِ وَالفَوقانُ يَأخُذُني","وَما نَسيتُكِ بَينَ الكَأسِ وَالكوبِ",14,"ب",1,0],["لَقَد ذكر الغرب أيامه","فَهَل نسي الشرق عهداً قداما",15,"م",2,0],["لَقَدْ ذَلَّ مَنْ يَبْغِي مِنَ النَّاسِ نَاصِراً","وَقَد خَابَ مَنْ يَجْنِي مِنَ الأَرْقَمِ الشَّهْدَا",16,"د",2,0],["لقَد ذَهَبَ الأنسُ والمانعونَ","ومن كان يسكَنُ في ظلّه",17,"ه",1,1],["لقد ذُدْتُمونا من مشارِبَ جَمَّة ٍ","وغَرَّفْتُمُ في غمرها كلَّ جاحدِ",18,"د",1,0],["لقد ذهب الصبا ومضى","بتذكاراته الحلوة",19,"و",2,1],["لَقَد ذَكَروا عَلى جَرَشٍ طِعاناً","بِلوبِيَةٍ بَلَوكَ بِهِ خَليقا",20,"ق",2,0],["لقد ذكرتني عهد التصابي","وأياما بلعلع ماضيات",21,"ت",1,0],["لقد ذاب قلبي في دُموعي عليكمُ","على أنه في النائبات حَديد",22,"د",1,0],["لقد ذُبتُ إذ أبدى إليَّ مضاحكاً","كما ذاب شيطانٌ تقض له شهبُ",23,"ب",1,0],["لقد ذهبت تلكَ الأماني الخوادعُ","وما هي يوماً للضَّعيفِ خواضعُ",24,"ع",1,1],["لقد ذبلت أزهارُ وردٍ نقلتِها","من الورقِ النامي الى شَعرك الجثل",25,"ل",1,0],["لقد ذبلت أغصانُنا في رَبيعها","ولكنْ أُرَجِّي أن يُعاودَها النضر",26,"ر",1,0],["لقد ذهبت بطلاً دماءٌ عزيزةٌ","بتهريقها ذو البطلِ أصبح أبطرا",27,"ر",2,0],["لَقَد ذَهبَت أَنفسُ العاشقين","عَلى نار وَجنَتِه حَسراتِ",28,"ت",1,1],["لَقَد ذابَ قَلبي في اِشتياقي إِليكمُ","وَجادَت بهِ عينٌ عليَّ جمودُ",29,"د",1,0],["لَقَد ذَهَبَ الناسُ الكِرامُ فَلا اِمرِؤٌ","يواسيكَ وَيُسَلّيكَ أَو يَتَرَجَّعُ",30,"ع",1,0],["لقد ذَمَّ الزَّمانَ إلى هَواهُ","أخو ذِمَمٍ عقَدْتَ له حِبالا",31,"ل",2,0],["لقد ذبل الزرع في روضتي","ولولا جفاؤك لم يذبل",32,"ل",1,0],["لقد ذكرَتْنا عهد ظَمياءَ باللِّوى","حمائمُ أيك في ذراهُ صوادِحُ",33,"ح",1,0],["لقد ذخرتَ وليّاً غيرَ مُنْتقلٍ","إذا أحبَّ وفَضْلاً غيرَ مُكتَتَم",34,"م",1,0],["لقد ذقت طعم الثكل فيك فهونت","مصائبنا يا ابن الملوك المصاعب",35,"ب",1,0],["لقد ذل إلا عند مثلك مثلها","وعز على ملك سواك قدومها",36,"م",3,0],["لقد ذاب ماء الدمع بعد جموده","وما ذاب ماء في اساً قبله جمر",37,"ر",1,0],["لقد ذابَ فيكِ العاشِقونَ تَوَلُّهاً","فما لهُمُ يا مَيُّ إن وَقَفوا فَيُّ",38,"ي",1,0],["لقد ذللت على محض الهوى لك لا","لأجل ما كان مرجوّاً ومدخورا",39,"ر",2,0],["لقد ذَهبتْ نَفْسي وقد صَفِرت يَدي","بنَاقِضَةِ الميثاقِ ناكثةِ العَهْدِ",40,"د",1,1],["لقد ذكرت عهد المحب فأقبلت","وقد آمنت عين الرقيب المؤنب",41,"ب",1,0],["لقد ذَبَّ عن آل النبي بسَيفهِ","واصلًَحَ مِن حالاتهم كلَّ فاسد",42,"د",1,0],["لقد ذَرَفت لكَ الأجفانُ دمعاً","كما ذابت لفرقتكَ الكبودُ",43,"د",1,0],["لقد ذهبت كناس الكرخ عنا","فيا نفسي عليها الدهر نوحي",44,"ح",2,0],["لقد ذدتما عنا الطغاة فأدبروا","ودافعتما الخطب الرهيب فأحجما",45,"م",2,0],["لقد ذُعِروا في حيثُ للطيرِ مأمنٌ","وفي حيثُ لا تَخْشَى الوحوشُ من الذُّعْر",46,"ر",1,0],["لَقَد ذابَ جِسمي بِنارِ الغَرام","بِحبّك شَمس البها وَالجَمال",47,"ل",1,1],["لَقَد ذاقَ قَلبي في الهَوى طَعمَ حُبّها","فَقَد ذاقَ مَنّاً لَيسَ تُشبِهُه الحَلوى",48,"ل",3,1],["لَقَد ذَهَبَ الحَبيبُ وَغابَ عنّي","فَعَنّي الشّمس غابَت بِالضّياءِ",49,"ا",2,1],["لَقَدْ ذَابَ جِسْمِي مِنْ نُحُولي بِصَدِّهِمْ","ضِرَامُ لَهِبٍ فِي الْفُؤَادِ لِبُعْدِهِمْ",50,"م",1,0],["لَقَدْ ذُكِرَتْ لِلأوّلِينَ فَضَائِلٌ","وَلَكِنّ هَذَا الفَضْلَ لَمْ يَجْرِ في ذِكْرِ",51,"ر",1,0],["لقد ذكر العقيقَ فهام وَجْداً","ولولا الوجدُ ما ذَكَر العقيقا",52,"ق",2,1],["لقد ذاع في مونس من حمده","كما ذاع في الهند من حمده",53,"د",2,0],["لقد ذكرتني سالف العهد بالحمى","حمائم أيك في ذراه سواجع",54,"ع",1,0],["لَقَد ذابَ قَلبِي مِن فِراقِ خَريدَةٍ","وَهامَ فُؤادِي والفِراقُ يُذِيبُ",55,"ب",1,0],["لَقَد ذَكَّرَتني الدارمِيّة دورُها","وَإِن شَحَطَت عَنها وَبانَ دُثورُها",56,"ر",3,1],["لَقَدْ ذَبَحوا الحُسَيْنَ ابْنَ البَتولِ","وقالوا نَحْنُ أشْياعُ الرَسولِ",57,"ل",1,1],["لقد ذابت الاحشاء حزنا وحسرة","وكل حشا قد مسه الحزن ذائب",58,"ب",1,0],["لقد ذَكَرَ الحُبشَانُ مِن وَقعِهَا بِهِم","وقِيعَةَ يَومِ الفِيلِ لَو ينفَعُ الذَّكرُ",59,"ر",1,0],["لقد ذقت الهوى طعمي","ن من حلوٍّ ومن مرِّ",60,"ر",1,0],["لقد ذاب حب القلب من فرط وجده","وقد كل عن تحديقه رايق الطرف",61,"ف",1,0],["لقد ذنوبي كنت عنه مخلفا","فعندي ذنوبي قيدهن ثقيل",62,"ل",1,0],["لَقَد ذَهَبَ العِتابُ فَلا عِتاب","وَقَد ذَهَبَ الوَلاءُ فَلا وَلاءُ",63,"ا",2,0],["لقد ذهبت أيام غازي بن يوسف","فما العذر في بقياكِ يا نفس فاذهبي",64,"ب",2,0],["لقد ذهبت في حسنِ ذاتي طوائف","ذهاب خبير بالأمور بصير",65,"ر",1,0],["لَقَد ذاقَ مِنّا عامِرٌ يَومَ لَعلَعٍ","حُساما إِذا ما هُزَّ بِالكَفِّ صَمَّما",66,"م",2,0],["لَقَد ذاقَ حَسّانُ الَّذي هُوَ أَهلُهُ","وَحَمنَةُ إِذ قالوا هَجيراً وَمِسطَحُ",67,"ح",1,1],["لَقَد ذَبلت زَهرة الياسمين","وَكَم ذاعَ فينا شَذاها وَفاح",68,"ح",1,0],["لَقَد ذَكرتكَ وَالبحرُ الخِضمُّ طغت","أَمواجُه وَالوَرى مِنهُ عَلى سَفَرِ",69,"ر",1,1],["لقد ذرأت عنها وتلك سجية","لأخلاقها والريم دائبة الذعر",70,"ر",1,0],["لقد ذل دينار المعارف عندهم","وعز بايديهم من المال درهم",71,"م",1,0],["لقد ذب الذباب فليس يعلو","رسول الله محمودا محمد",72,"د",1,1],["لَقَد ذَعَرنا قَديما في نِسائِكُمُ","فَلَم تَغاروا وَلَم تُستَنكَرِ الذُعَرُ",73,"ر",1,0],["لقد ذممت زمانا كله إحن","وقد هجوت اناسا كلهم جيف",74,"ف",1,0],["لقد ذلقت في وصف مجدك ألسن","وعجت به الركبان في كل مشهد",75,"د",1,0],["لقد ذَرَّ في أُفقِ المشارقِ كوكبٌ","تَجَلَّت بهِ الجُلَّى وجُنحُ المظالمِ",76,"م",1,0],["لقد ذيل النعمان في الروض إذ جرى","له في اسمه ذكر لدى النعي في العشب",77,"ب",1,0],["لَقَد ذَل عَبد لَم تَعزِّز جَنابَه","وَقَد عَمّه الخذلان إن لَم يَكُن خَصّا",78,"ص",2,0],["لقد ذل من لم تملك التبرَ كفُّه","ولو أن جبريل الأمين ظهيرُهُ",79,"ه",1,1],["لَقد ذلّ من لَم يَرضَه قسمُ رَبِّه","وَقَد ضَل من أَمسى رَهينَ حجاب",80,"ب",1,0],["لَقد ذلَّ حزمي في الهَوى بَعد عزِّه","فَكَم من عزيز قاده الحبُّ هيِّنا",81,"ن",2,0],["لقد ذاد منه الروح عن فتن هنا","شهود جمال القدس في حضرة ثمَّا",82,"م",2,0],["لقد ذكّرتني ذي المَهَاة بشبهها","أوانس بيض في القلوب رواتعُ",83,"ع",1,1],["لَقَد ذهبت لنيل المجد في طرق","ترد سالكها مستوحشاً عطبا",84,"ب",2,0],["لقد ذقتُ مُرَّ العيشِ من بَعْدِ حُلْوِهِ","وقاربتُ حدًّ الأربعينَ من العمر",85,"ر",1,0],["لقد ذبت مثل الشمع في حب لادنِ","وجسمي كساه الهجرُ ألوان رادنٍ",86,"ن",1,1],["لَقَد ذَكَّراني فَتح مكّة عنوةً","وَموكب خير الخَلق بَينَ الكَتائِبِ",87,"ب",1,0],["لقد ذَهَبَ النَّوَى بِجَمِيلِ صَبرِى","وَأَودَعَ فى حُشَاشَتِىَ الوَلُوعا",88,"ع",2,1],["لقد ذابَ كلي بالصَّبابةِ والضَّنى","وأدنفني شوقٌ إلى الحسنِ الكُلّي",89,"ل",2,0],["لقد ذكر العقيق فهام وجداً","بذات الخال والخدِّ الأسيل",90,"ل",1,0],["لقد ذلُّ من يحمي الفرزدقُ عرضهُ","كما ذلتِ الأخنافُ تحتَ المناسمِ",91,"م",1,0],["لَقَد ذاقَ قَلبي الهَوَى والنَّوَى","بكَأسٍ تَسَاوَى بإِجحَافِهِ",92,"ف",2,0],["لَقد ذُقتُ ما يَكفِي مِن الصَّبرِ بَعدَها","ولاقَيتُ ما لاقَتْهُ مِن غَيرِ دارِئِ",93,"ا",1,0],["لقد ذاعَ صيتُكَ في كلِّ حَدبٍ","وفرّقتَ بين الهُدى والحَرام",94,"م",1,0],["لقد ذبُلَتْ غصونُ البوحِ فينا","أينمو في جبالِ الصمتِ قولي ؟",95,"ل",2,0],["لقد ذهب الهوى بالقلب مني","وأبقى بعده الداء الدخيلا",96,"ل",2,0],["لقد ذهب الذي قد كان يرجى","لكل ملمة نكباء جلا",97,"ل",2,0],["لقدْ ذبحوا بيومِ الطفِّ جيداً","مُقبِّلُهُ الرسولُ...فمنْ تجرَّا؟",98,"ر",2,0],["لقد ذهل الأولى عرفوك شهما","مثالا للتقى ورعا تقيا",99,"ي",2,0],["لقد ذهبتْ أرياحكم بمطيِّةٍ","اتتكم خيولٌ صافناتٌ بها الصهلُ",100,"ل",1,0],["لقد ذقتُ الحلاوة فيك عشقا","أنا المذبوح والشعر الشهيد",101,"د",1,0],["لقد ذُبّحتْ غيظا هداهد صرحه","فطارت من الرعب الكبير الحمائم",102,"م",1,0],["لقد ذاق الغرام كسرب نحل","فصيره شفاء عمّ أفقا",103,"ق",2,0],["لقد ذاق مني كروم الشفاه","وهبتُ وكلي له جائعة",104,"ع",2,0],["لقد ذهب الذي سلاه عنها","فعاد إلى التشوق والحنين",105,"ن",1,0],["لقد ذاب فلبي والعظام وما أرى","خيالي سوى ظل مخيم",106,"م",1,0],["لقد ذقتُ منكِ الموتَ قبلَ مجيئهِ","مِرارًا وكأساً منهُ تُملى فأشربُ",107,"ب",1,0],["لقد ذخر الذكرَ الجميلَ وغيرُه","له تاركٌ فانظرْ لمن بقي الذخر",108,"ر",1,0],["لقد ذقتُ صبراً في البعادِ وقربِهِ","فجرحي عصيٌّ ما براهُ طبيبُ؟",109,"ب",1,0],["لَقَدْ ذَهَبَ الشَّبَابُ بِلَا إِيَابِ","وَ إِنَّ بَقِيَّتِيْ لإلى ذَهَابِ",110,"ب",1,1],["\"لقد ذهب الزمان بأم عمروٍ\"","وسوف يعود إن عاد الضميرُ",111,"ر",1,0]]}