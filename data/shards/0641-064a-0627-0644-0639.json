","https://www.poetsgate.com/ViewPoem.aspx?id=197286",""],[5376,"وهو النبيُّ ودينُه متمدِّدُ","https://www.poetsgate.com/ViewPoem.aspx?id=197290",""],[5431,"العالم السفلي","https://www.poetsgate.com/ViewPoem.aspx?id=186579",""],[5431,"لاأنبسُ...","https://www.poetsgate.com/ViewPoem.aspx?id=190718",""],[5431,"أن يظلّوا كشعلة مستنيره...","https://www.poetsgate.com/ViewPoem.aspx?id=198462",""],[5672,"ملل الباكيات","https://www.poetsgate.com/ViewPoem.aspx?id=206428",""],[5736,"لا قانون .. لا منطق","https://www.poetsgate.com/ViewPoem.aspx?id=208194",""],[5759,"نشيدُ الغُربة","https://www.poetsgate.com/ViewPoem.aspx?id=214175",""],[5888,"للراقصين بالعتمة","https://www.poetsgate.com/ViewPoem.aspx?id=214505",""],[5923,"في العيد","https://www.poetsgate.com/ViewPoem.aspx?id=146240",""],[5939,"أسيرتي","https://www.poetsgate.com/ViewPoem.aspx?id=129125",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[5969,"يا صاحِبَ الحُسْنِ","https://www.poetsgate.com/ViewPoem.aspx?id=203979",""],[5973,"سترحل كالأشجار صدام َ واقفاً","https://www.poetsgate.com/ViewPoem.aspx?id=13278",""],[5989,"خلي فؤادي ...","https://www.poetsgate.com/ViewPoem.aspx?id=181564",""],[6019,"في محراب الرجاء..!!","https://www.poetsgate.com/ViewPoem.aspx?id=53850",""],[6066,"حَفْلُ تَخَرُّجِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=12666",""],[6128,"عزيزي","https://www.poetsgate.com/ViewPoem.aspx?id=212860",""],[6164,"الثمانون؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66038&r=&rc=48",""],[6225,"خرابُ لبنان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80984&r=&rc=253",""],[463,"هبَّتْ ومنها الخلابُ والخدعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60118&r=&rc=174",""],[6248,"قميص لأوراق بيضاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86025&r=&rc=2",""],[2220,"إني نذرتُ وما في النذرِ من حرجٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11256&r=&rc=130",""],[2220,"ما ثَم أشباهٌ ولا أمثال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11652&r=&rc=526",""]],"verses":[["فيا لعنة الجبار حطي عليهمُ","ولا تذري منهم ذماراً ولا حِما",0,"م",2,0],["في العَينِ عالٍ وَهوَ في ال","قَلبِ مُذالٌ سافِلُ",1,"ل",1,0],["في العالَمِ العُلوِيِّ وَال","سُفلِيِّ أَحكامٌ تُدار",2,"ر",1,0],["في آلِ عَبّادٍ حَطَطتُ فَأَعصَمَت","هِمَمي بِحَيثُ أَنافَتِ الأَطوادُ",3,"د",1,0],["فِي العِلْمِ وَالأَدَبِ العَالِي يَكَادُ إِذَا","سَاقَ الأَحَادِيثَ يَسْقِيكَ ابنَةَ العِنَبِ",4,"ب",1,0],["فِي العِدْوَةِ العُلْيَا جَلَسْتِ مَلِيكَةً","بِالعِزِّ وَالإِجْلالِ تَأْبَى الذَّامَا",5,"م",2,0],["فَيَا لَعِقَابِ الفَرْعِ وَالأَصْلُ قَدْ جَنَى","لِيَغْدُوَ أَنْكَى مَا يَكُونُ وَأَصْرَمَا",6,"م",2,0],["في العلم والنسبة ما مثله","في ردّه الفرع إلى الأصل",7,"ل",1,0],["في العالَمِ الفاني مَصي","رُ العالَمينَ إِلى ذَهابِ",8,"ب",1,0],["في العُلا مِن مُلوكِ غَسّانَ وَالصي","دِ الصَناديدِ مِن مُلوكِ الرومِ",9,"م",1,0],["فَيا لِعِبادِ اللَهِ كَيفَ تَخَيَّلَت","لَنا باطِلاً لَمّا جَلا اللَيلَ نائِرُه",10,"ر",2,0],["في العَدَدِ المُعلَنكِسِ الأَعَدِّ","راحَ بِحَدٍّ وَغَدا بِحَدِّ",11,"د",1,0],["في العُدمِ كُنّا وَحُكمُ اللَهِ أَوجَدَنا","ثُمَّ اِتَّفَقنا عَلى ثانٍ مِنَ العَدَمِ",12,"م",1,0],["في العين دمع كالجما","ن وفي الفؤاد لهيب نار",13,"ر",1,0],["في العلم تَخفيف لما","يَعرو الحياة من النوائب",14,"ب",1,0],["في العلم توسيع لأب","واب التجارة وَالمكاسب",14,"ب",1,0],["في العلم إصلاح المفا","سد وَالعَقائد وَالمذاهب",14,"ب",1,0],["في العراق ما نكبت","أمة كَما نكبوا",15,"ب",3,0],["فَيَا لَعَظِيمِ الجَاهِ لَمْ يَكُ مُغْنياً","لَدَى المَوْتِ مِنْهُ تَالِدٌ وَأَثِيلُ",16,"ل",1,0],["فِي العَالَمِ العَرَبِيِّ أَيَّةُ هِزقٍ","لأُفُولِ ذَاك الكَوْكبِ المُتوَارِي",17,"ر",2,0],["فِي الْعَيْنِ دَمْعٌ تُبِيحُ المَ","سَرَّةُ الْيَوْمَ ذَرْفَهْ",18,"ف",2,0],["فِي الْعُبَابِ الْعرِيضِ مِنْهَا خُفُوقٌ","مَوْجُهُ آخِرَ المَدَى يَسْتَطِيلُ",19,"ل",1,0],["في العصيب المدلهمْ","مصغٍ لشاكٍ لم ينمْ",20,"م",1,1],["في العالمين انجلت شمسا مناقبه","فالحوت يعرفها في الافق والحوت",21,"ت",1,0],["في آل عثمان الملوك بأنهم","خصوا بإرث الأرض وهو شهير",22,"ر",1,0],["في آل عثمان الأعاظم أنهم","أهل الحجى وعدوهم مكسور",22,"ر",1,0],["فيا لعباد الله ما تم ذو حجا","له بعض تمييز بقلب وناظر",23,"ر",1,0],["فيا لعيشٍ لفيض الروح رَعرَعَةٌ","وللنسيم مع الأشجار تطفيلُ",24,"ل",1,0],["في العِزِّ مَصحوباً تَرَونَ مُؤَرِّخاً","وَبي الأُنسِ مَحفوفاً بِخَيرٍ وَإِحسانِ",25,"ن",1,0],["في العزِّ يُظلِّك شامِخُه","والعَيشِ يَخُصُّك أرْغَده",26,"د",2,0],["في العَينِ غَيبٌ بَعدُ أَعرِفُهُ","إِنَّ العُيونَ طَليعَةُ القَلبِ",27,"ب",1,0],["في العَينِ إِنسانٌ فَإِن خِلتَها","وُدّاً فَما في العَينِ إِنسانُ",28,"ن",1,0],["في العرب تعرب لم تزل آياتها","وحروفها بالعجم طرا تعجم",29,"م",1,0],["في العسر واليسر يمنعون فإن","أعطَوا تمنّيت أنهم منعوا",30,"ع",3,0],["في العَزْمِ عاصفَةُ الهُبوبِ","وفي تأنِّيهِ يَسومُ",31,"م",1,0],["في العدل والإِحْسانِ مُمْتثلاً لما","يتْلوهُ منْ نصِّ الكتابِ المُنْزَل",32,"ل",1,0],["في العذارى أخلع عذارا","واغتنم وصل البدور",33,"ر",1,1],["في آل عثمان بات المجد مندرسا","يبكي لأعظم ماساة وينتحب",34,"ب",1,0],["في العَصْرِ منَّا سادَةٌ أحوالُهُمْ","بسُمُوِّها يتمثَّلُ المُتَمَثِّلُ",35,"ل",1,0],["في العالم العُلوي عُقولٌ رُتّبتْ","وهمُ لها في الأرض كالأمثالِ",36,"ل",1,0],["في العشق معنى لطيف ليس يعرفه","من البرية إلا كل من عشقا",37,"ق",2,0],["في العُلا قَدراً وجَاها","ومَزَايا وتَنَاهى",38,"ه",2,0],["في العناءِ الطّويل كيف وقعتُم","لاعَدِمْتم هذا العناءَ المُعَنِّي",39,"ن",2,1],["فيا لعيونٍ جائراتٍ عن الهدى","ويا لقلوبٍ ضِغنُها مُتَضَعِّفُ",40,"ف",1,0],["في العَرشِ مَحْفِلُكِ المؤرَّخُ طاهِرٌ","نادَى قد اجتَمَعتْ ببُطرسَ مَريمُ",41,"م",1,0],["في العلم والبحث كم عانى وكابدٍ بل","كم جال في سائر الأقطار مغتربا",42,"ب",2,0],["في العَيش زاهِدَة وَالخلق قاطِبَة","بِها صدوف عَن الدُنيا وَإِغضاء",43,"ا",2,0],["في العِلمِ باقِرُهُ في البَأسِ عامِرُهُ","في الجُودِ حاتِمُهُ في الحِلمِ أَكثَمُهُ",44,"م",2,0],["في العلم بالذات فرد واحد أحد","وفي الصفات كثير عده الوهم",45,"م",1,0],["في العين ماء وفي القلب لهيب لظى","وقد تخوفت في الحالين من تلفي",46,"ي",1,1],["في آل عثمان لشعبك أسوة","ضمنت له استقلال مصر وشيكا",47,"ك",2,0],["في العِقدِ واسِطَةٌ في الدَّهرِ جَوهَرةٌ","عَن قَدرِها عاجِزٌ تَقديرُ تَثمينِ",48,"ن",1,0],["في العَفوِ أَكرَم ماجدٍ","بِالصَّفحِ أَسنى ذي اِبتِسام",49,"م",1,0],["فيا لعوقي وكتبي","وكحلي الأصبهاني",50,"ن",2,0],["في العطايا والمزايا","كلَّ يوم يتصعَّدْ",51,"د",1,0],["فِي العَيْنِ مَهْوَى ذِي حِدابٍ أَخْوَقا","إِذَا المَهَارَى اجْتَبْنَهُ تَخَرَّقا",52,"ق",2,0],["في العمر ما شْفت شرواها","في عيون الخرّد الغيدِ",53,"د",1,0],["في العدلِ أنّك راقدٌ","عنّي وأنّي فيك ساهِرْ",54,"ر",1,0],["في العطر من هوانا","كأنّه دخان",55,"ن",1,0],["في العرف ليس للنجاة في الجمل","حرفيّة وغيرهها فيه العمل",56,"ل",1,0],["في العقد كالوسطى وفي الارسال","كمفرد الوضع وفي الاسبال",57,"ل",1,0],["في العود ما يقرن المسك الذكي به","طيباً وفيه لقىً ملقىً مع الحطب",58,"ب",1,0],["في العام لاَ تَحنُو عَلَى","أولادِهَا فِيه الرَّوَائِم",59,"م",1,0],["في العلماء الراشدين بعده","كفايةٌ لمن تحرَّى رشدا",60,"د",2,0],["فِي العِلْمِ أُسْتَاذٌ إِذَا صُرِفَتْ لَهُ","هِمَمُ الْمُلُوكِ وَيَا لَهُ أَسْتَاذَا",61,"ذ",2,0],["في العسرِ واليسرِ فيه لَم يخِب أملٌ","ولا تُغيّر من أخلاقه الغِير",62,"ر",1,0],["في العدل ليس له عديل في الورى","علم فليس يفيده التعريف",63,"ف",1,0],["في العالَمينَ أَقاوِيلٌ تُقالُ وَلا","تُقالُ في الصالِحِيِّينَ الأَقاوِيلُ",64,"ل",1,0],["في العيش مثل الموت عمرك هكذا","عمرٌ يزيد على التألق طولا",65,"ل",2,0],["في العراق الأبي قلب كما ته","وى كبير وساعد مفتول",66,"ل",1,0],["في آل عمران قدماً شاعَ مبعثه","رجالهم والنساءُ استوضحُوا خبرَه",67,"ر",2,0],["في العِزّ والسَّعْدِ ببارئ النَّسَمْ","وعاش مسروراً بِحُكْمٍ وحِكَمْ",68,"م",1,0],["في العقل والإيمان ثبتُ عينه","متناقصاً ولذاك لا يغتال",69,"ل",1,0],["في آلِ عمرانَ جاء النصُّ يطلبني","بما لديه من التخويفِ والخدر",70,"ر",1,0],["في العلمِ بالله لا بالغير انّ لنا","نفساً قد اعتادتِ التنزيه في الفرج",71,"ج",1,0],["في العقل لا في نصوصِ الشرعِ فالتزموا","قولَ المشرِّعِ إذ كان الهدى فيه",72,"ف",3,0],["في آل عمرانَ إن نظرتم","بيتٌ وفي توبة وثني",73,"ن",2,0],["فِي العينِ ثمَّ الذِّهنِ ثُمَّ اللَّفظِ ثُ","مَّ الرَّسمِ حِينَ تَخُطُّهُ بِبَنَانِ",74,"ن",1,0],["في العمر هذا يزين","يِرَيْعْ للشايبْ صِباه",75,"ا",2,0],["في ((العَيْنِ)) جامِعَةٌ تَشَامخَ صَرْحُهَا","فيهَا العلومُ بأحْدَثِ الأفكارِ",76,"ر",1,0],["في ((العينِ)) جامعةٌ يُضاءُ بِعِلْمِها","حشدٌ مِن الطّلاّبِ والعُلماءِ",77,"ا",2,0],["فَيا لعين شرقت جفونها","بمدمع جار عليه ساجم",78,"م",1,0],["في العام زرنا خِدركُم يا زَينبُ","فجفيتنا فَلنا عليك المعتبُ",79,"ب",1,1],["في العالم الحسيّ غا","ية علمها ونقولها",80,"ل",3,0],["في العَامِ مَرَّتِين أو ثَلاثِ","إن كَانَ قَصدُكَ آنجَزِيجَا يَاتي",81,"ي",1,0],["في العلم أو فيصل في الحكم لم تجد","لما نعاه ضحى ناعيه قلت له",82,"ه",1,0],["في العلم والجسم لا تخفى زيادته","فهل أعادت لنا الأيامُ طالوتا",83,"ت",2,0],["فيا لعواصف عصفت فهبَّت","بلابلها ولم تخطر ببالي",84,"ل",2,0],["فيا لعقيمة لقحت فالقت","بصالح توأما عند الولادِ",85,"د",1,0],["في العزم ألقى ان مرضت شفائي","وبه السلامة إن خشيت فنائي",86,"ي",1,1],["في العيد تؤلمني تهاني العيد","يدعى سعيداً فيه غيرُ سعيد",87,"د",1,1],["فِي العُيونِ المَرِيضَةِ الجَفْنِ سُقْمِي","يا لِقَوْمِي وَعِنْدَهُنَّ شِفَائِي",88,"ي",1,0],["في العلم والحديث والتفسير","وفي الفرايض وفي التحرير",89,"ر",1,0],["في العيد قشر الفول يطعمها","ويخص أهل البيت باللب",90,"ب",1,1],["في العقل والعرفان والإتقانِ","وصفوة في السر والإعلانِ",91,"ن",1,0],["فيالعيد سعيد نشره عبق","بطيب ذكراك لا بالند والعود",92,"د",1,0],["في العيد يمن للبرية شامل","لكن بيوم واحد معهود",93,"د",1,0],["في العمر لم نستطع يوماً فراقكم","فكيف عنكم بعادي الموت ننفصل",94,"ل",1,0],["فيا لعن الله النفاق وأهله","وقبّحهم دون الخلائق من أهل",95,"ل",1,0],["في العقل والدين بلا مثيل","وهكذا الأكثر في التحصيل",96,"ل",1,0],["فِي الْعِلْمِ وَالحِلْم بِكُمْ يُقْتَدى","إِذْا دَجَا الْخَطْبُ وَضَلَّ الرَّشادْ",97,"د",1,0],["في العود أخبرها بالفضل ميسرة","وأن متجرها بالربح موصول",98,"ل",1,0],["فيا لعليم شط عنا ونازح","بنات المعالي الغر ثكلى نوادبه",99,"ب",2,0],["في العِشقِ أَفيضوا فَعَلى أَعيننا","مَوضوعُ أَحاديثِكُمُ مَحمولُ",100,"ل",1,0],["في العَينِ جَمالُ وجنتيها باقِ","لا يَغسله الدَمعُ من الآماقِ",101,"ق",1,1],["في العِشقِ أَرى سَوادَ وَجهي فَخراً","دَع أَكتَسِبِ النور بِهِ ك