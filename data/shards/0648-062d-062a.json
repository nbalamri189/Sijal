ps://www.aldiwan.net/poem4739.html","الطويل"],[478,"عشية عجنا بالمطي الرواسم","https://www.aldiwan.net/poem15247.html","الطويل"],[478,"هوى بين أحناء الضلوع دفين","https://www.aldiwan.net/poem15260.html","الطويل"],[480,"يا علوة ما كان ظني أن أجزى","https://www.aldiwan.net/poem37875.html","الطويل"],[502,"أجدك لم تعرف أثافي دمنة","https://www.aldiwan.net/poem2247.html","الطويل"],[517,"حلفت بمن حجت قريش لبيته","https://www.aldiwan.net/poem48704.html","الطويل"],[538,"أنى تسدت نحونا أم يوسف","https://www.aldiwan.net/poem69412.html","الطويل"],[552,"متى أنا ناج من سهام الغوائل","https://www.aldiwan.net/poem47258.html","الطويل"],[552,"عجبت لقلبي كيف يصبو ويكلف","https://www.aldiwan.net/poem47405.html","البسيط"],[554,"أديري على الراح ساقية الخمر","https://www.aldiwan.net/poem68421.html","الطويل"],[568,"شدت فجلت أسماعنا بمخفف","https://www.aldiwan.net/poem69770.html","الطويل"],[574,"أدار البلى أما عمرت بمعشري","https://www.aldiwan.net/poem3648.html","الطويل"]],"verses":[["وَحَتّى تَروها كَالسَعالى إِلَيكُمُ","تَفَلَّتُ مِن أَرسانِها وَالأَجِلَّةِ",0,"ه",1,0],["وَحَتّى بَدَت مِنها المَلالَةُ وَالقِلى","وَعَهدي بِفَوزٍ لا تَمَلُّ وَلا تَقلي",1,"ل",2,0],["وَحَتّى دَعاني الناسُ أَحمَقَ مائِقاً","وَقالوا مُطيعٌ لِلضِلالِ تَبوعُ",2,"ع",1,0],["وَحَتَّى مَتَى شُغْلٌ بِمَا شَاءَهُ الْهوَى","وَكَيْفَ بِعَزْمٍ بَعْدَ مَا خُذِلَ الْعَزْمُ",3,"م",1,0],["وَحَتّى يَبيتَ القَومُ في الصَفِّ لَيلَةً","يَقولونَ نَوَّر صُبحُ وَاللَيلُ عاتِمُ",4,"م",1,0],["وَحَتّى رَأَيتَ الشَخصَ يَزدادُ مِثلُهُ","إِلَيهِ وَحَتّى نِصفُ رَأسِيَ واضِحُ",5,"ح",1,0],["وَحَتّى صَيَّرَتني الشَمسُ عَبداً","صَبيغاً بَعدَ ما دَبَغَت إِهابي",6,"ب",2,0],["وَحَتّى قَلَّمَ الإِملاقُ ظُفري","وَحَتّى حَطَّمَ المِقدارُ نابي",6,"ب",2,0],["وَحَتّى تَرى الجَونُ الَّذي كانَ بادِن","عَلَيهِ عَوافٍ مِن نُسورٍ وَعِقبانِ",7,"ن",1,0],["وَحَتّى أَجازَت بَطنَ ضاسٍ وَدونَها","رِعانٌ فَهَضبا ذي النُجَيلِ فَيَنبُعُ",8,"ع",1,0],["وَحَّتى كَأنّي مِن جَوَى الحُبِّ مِنكُمُ","سَليبُ بِصَحراءِ البُرَيحِ غَريبُ",9,"ب",1,0],["وحتام نطوي العمر والليل دامسٌ","ونحتمل الأجحاف والضيم الظلما",10,"م",2,0],["وَحَتّى اِستَبانَ الجَأبُ بَعدَ اِمتِنائِها","مَنَ الصَيفِ ما اللّاتي لَقِحنَ وَحولُها",11,"ل",3,0],["وَحَتّى كَسَت مَثنى الخِشاشِ لُغامُها","إِلى حَيثُ يَثني الخَدَّ مِنها جَديلُها",12,"ل",3,0],["وَحَتّى اِعَتَرى البُهمَى مِنَ الصَيفِ نافِضٌ","كَما نَفَضَت خَيلٌ نواصِيَها شُقرُ",13,"ر",1,0],["وَحَتّى أَتى يَومٌ يَكادُ مِنَ اللَظى","بِهِ التَومُ في أَفحوصِهِ يَتَصَيَحُ",14,"ح",1,0],["وَحَتّى كَأَنَّ الواضِحَ الأَسفَعَ القَرا","مِنَ الوَحشِ مَولى رَسمِها وَنَسيبُها",15,"ب",3,0],["وَحَتّى رَأَينَ القِنعَ مِن فاقِئِ السَفى","قَدِ اِنتَسَجَت قُريانُهُ وَمَذانِبُه",16,"ب",2,0],["وَحَتّى سَرَت بَعَد الكَرى في لَوِيِّهِ","أَساريعُ مَعروفٍ وَصَرَّت جَنادِبُه",16,"ب",2,0],["وحتى دعاني الحزم أن خَلِّ عنهم","فإن صريح الرأي أن لا تُداريا",17,"ي",2,0],["وحتى كأن القوم شُدَّتْ رقابهم","بحبل خِناق مُحكَم الفتل مُحصَد",18,"د",1,0],["وَحَتّى تَذوقوا كَأسَ مَن كانَ قَبلَكُم","وَيَزرِقَ مِنكُم في الحِبالِ قَرينُ",19,"ن",1,0],["وَحَتّى تَضُمَّ الحَربُ مَعكُم عُطارِداً","وَيَبرَأَ تَخليجٌ بِهِ وَجُنونُ",19,"ن",1,0],["وَحَتّى تَرَكتُ العائِداتِ يَعُدنَهُ","يُنادينَ لا تَبعَد وَقُلتُ لَهُ اِبعُدِ",20,"د",1,0],["وَحَتّى حَسِبتُ اللَيلَ وَالصُبحَ إِذ بَد","حِصانَينِ سَيّالَينِ جَوناً وَأَشقَرا",21,"ر",2,0],["وحَتَّ منه شَعراً","أسْوَدَ كالعناقِدِ",22,"د",1,0],["وحتى غدا يُثني به كلُّ كاشح","بقولٍ ويتلو قولَهُ بزفير",23,"ر",1,0],["وحتى نقدِّم ما لا تَشُك","كُ في أنني معهُ لا أضلُّ",24,"ل",1,0],["وَحَتّى يَؤوبَ القارِظانِ كِلاهُما","وَيُنشَرَ في القَتلى كُلَيبٌ لِوائِلِ",25,"ل",1,0],["وَحَتّى مَواليكَ السَحائِبُ أَقبَلَت","فَوافاكَ مِنها بِالهَناءِ مَطيرُها",26,"ر",3,0],["وَحَتّى تَكادي تَمسَحينَ مَدامِعي","وَيَعبَقُ في ثَوبَيَّ مِن ريحِكِ النَدُّ",27,"د",1,0],["وحتى تناصَى العُشْبُ فيه وأُرسختْ","عُروقُ الندى واستمجدتْ عَذَب الأثلِ",28,"ل",1,0],["وَحَتّى تُصيبَ المُرهَفاتُ بِساطِحٍ","شِفاءَ النُفوسِ مِن طُلىً وَشُؤونِ",29,"ن",1,0],["وَحَتّى تُحَشَّ النارُ ما بَينَ أَرزَنٍ","وَأَرضِ جُواخٍ مِن قُرىً وَحُصونِ",29,"ن",1,0],["وَحَتّى يَنالُ السَيفُ موسى فَيَختَلي","جُزازَةَ عِلجٍ بِالتُخومِ سَمينِ",29,"ن",1,0],["وَحَتّى عَلَوهُم بِالسُيوفِ كَأَنَّها","مَصابيحُ تَعلو مَرَّةً وَتَصَبَّبُ",30,"ب",1,0],["وَحَتّى قَتَلنا الجَهلَ عَنها وَغودِرَت","إِذا ما أُنيخَت وَالمَدامِعُ ذُرَّفُ",31,"ف",1,0],["وَحَتّى مَشى الحادي البَطيءُ يَسوقُها","لَها بَخَصٍ دامٍ وَدَأيٌ مُجَلَّفُ",31,"ف",1,0],["وَحَتّى بَعَثناها وَما في يَدٍ لَها","إِذا حُلَّ عَنها رُمَّةٌ وَهيَ رُسَّفُ",31,"ف",1,0],["وَحَتّى رَأَوا مَن يَعبُدُ النارَ آمِناً","لَهُ جارُهُ وَالبَيتَ قَد خافَ داخِلُه",32,"ل",2,0],["وَحَتّى الخَناثى مِن قُشَيرٍ تَسُبُّني","وَجَعدَةُ أَشباهُ الإِماءِ الخَوادِمِ",33,"م",1,0],["وَحَتّى سَعى في سورِ كُلِّ مَدينَةٍ","مُنادٍ يُنادي فَوقَها بِأَذانِ",34,"ن",1,0],["وَحَتْفِيَ كامنٌ في مُقْلتَيه","كُمونَ الموتِ في حَدِّ الحُسامِ",35,"م",1,0],["وحتى تَرودَ الشرقَ ذاتُ هَمَائِمٍ","يُصرِّفُها ساري الهُمومِ هُمامُ",36,"م",1,0],["وَحَتّى يُنادي زَبرَقان بنُ أَظلَمٍ","وَنادى كِلاعاً وَالكَريبَ وَأَنعَما",37,"م",2,0],["وَحَتّى تَراهُ قَصيرَ الخُطى","بَطيءَ النُهوضِ كَليلَ النَظَر",38,"ر",1,0],["وحتى اغتدَى زَنْدي شحاحاً بقادحٍ","وأضحى جناحي في النّهوض ذُبابا",39,"ب",2,0],["وَحَتّى لَوَ أَنَّ الخُلدَ يُعرَضُ إِن مَشَت","إِلى البابِ رِجلي ما نَقَلتُ لَها إِربا",40,"ب",2,0],["وَحَتّى مَتى أَرعى الكَواكِبَ ساهِراً","فَمِن طالِعٍ أُخرى اللَيالي وَغارِبِ",41,"ب",1,0],["وَحَتّى مَتى أَلقى الرَزايا مُمِضَّةً","كَما كَرَعَت بَينَ الضُلوعِ حِرابُ",42,"ب",1,0],["وَحَتّى دَعاني الناسُ أَحمَقَ مائِقاً","وَقالوا تَبوعٌ لِلضَلالِ مُطيعُ",43,"ع",1,0],["وَحَتّى حَمَلنَ الحورَ مِن كُلِّ جانِبٍ","وَخاضَت سُدولَ الرَقمِ مِنها الأَكارِعُ",44,"ع",1,0],["وَحَتَّى النُّجُومُ الزُّهرُ تَجرِي بِأمرِهِ","وَحَتَّى لِسَانُ الدَّهرِ عَنهُ يُجَادِلُ",45,"ل",1,0],["وَحَتمٌ مُضاءُ ظُبى ذي الفَقارِ","فَكَيفَ إِذا وافَقَ المُنصُلا",46,"ل",2,0],["وَحَتّى أَذاعَت بِالجَوالِقِ وَاِنبَرَت","بِواناتِها عيطُ القِيانِ المَواهِنِ",47,"ن",1,0],["وَحَتّى نَفَعَت بِلا نَعمَةٍ","لَهُم وَبِلا أَنفُسٍ ناصِحَه",48,"ح",2,0],["وَحَتّى صَبَّحتَ عَلى غِرَّةٍ","مَعَ الصُبحِ بِالصَليمِ الجائِحَه",48,"ح",2,0],["وَحَتّى اِستَقادَت قَيسُ عَيلانَ عَنوَةً","وَصامَت تَميمٌ لِلسُيوفِ وَصَلَّتِ",49,"ت",1,0],["وَحَتّى رَماكَ الشَيبُ في الرَأسِ عانِساً","وَخَيرُكَ مَبسوطٌ وَزادُكَ حاضِرُ",50,"ر",1,0],["وَحَتّى بَدَت أُخرى النُجوم وَباشَرَت","خُدُودَ الرِجالِ لِلرُقادِ الوَسائِدُ",51,"د",1,0],["وَحَتّى تَشَكّى الساقِيانِ وَهَدَّمَت","مِنَ الحَوضِ أَركاناً بَطيئاً جُبورُها",52,"ر",3,0],["وَحَتّى لَو يَكونُ فَتى أُناسٍ","بَكى مِن عَذلِ عاذِلَةٍ بَكيتُ",53,"ت",1,0],["وحتى رأَى ما خَلْفَهُ وَهو مُقْبِلٌ","بِقَلْبٍ تساوَى عندهُ النَّومُ والسُّهْدُ",54,"د",1,0],["وحتى أرى الجَوزاءَ تنثُر عِقدَهَا","وتَسقُطُ من كفّ الثريّا الخواتم",55,"م",1,0],["وَحَتّى تَغَنّى لاهِياً مُتَطَرِّباً","غِناءَ عَميدِ القَلبِ نَشوَنَ ناحِلِ",56,"ل",1,0],["وَحَتّى تَضُمَّ الساحِلَينَ كِلَيهِما","سَبِيّاً كَشاءِ العيدِ أَصبَحَ مُنتَدّا",57,"د",2,0],["وَحَتفٌ مِثلُ حَتفِ أَبي ذُؤَيبٍ","وَنكزٌ مِثلُ نَكزِ أَبي خِراشِ",58,"ش",1,0],["وَحَتّى إِذا حَضَرَ الحِمامُ تَبَيَّنوا","أَنَّ الَّذي فَعَلوهُ جَهلٌ كُلُّهُ",59,"ل",2,0],["وحتى يَزولَ الحَوْلُ عنهمْ ومِثْلُه","ويَذْهَبَ عامٌ بعْد ذاكَ وعامُ",60,"م",1,0],["وحتّى تَولّتْ دُنشوايُ بِنابِهِ","يُداسُ ويُذرى من بنيها بأقدامِ",61,"م",1,0],["وحتَّامَ نشكو سواد الحظوظ","ومن أفقنا كلُّ فجرٍ تلالا",62,"ل",2,0],["وَحَتّى تَرى الجَونُ الَّذي كانَ بادِناً","عَلَيهِ عَوافٍ مِن نُسورٍ وَعِقبانِ",63,"ن",1,0],["وَحَتّى حَسِبتُ اللَيلَ وَالصُبحَ إِذ بَدا","حِصانَينِ سَيّالَينِ جَوناً وَأَشقَرا",64,"ر",2,0],["وحتى في أراضيها","تقاسي غربة المنفى",65,"ف",2,0],["وحتى بين يديها رأسَهُ","كانحناء الساجد المقترب",66,"ب",1,0],["وحتى الجوُّ جوُّك ليس فيه","لنا إلاَّ صقيعٌ، أو أُوَار؟",67,"ر",1,0],["وَحَتَّى مَتَى لاَ نَلْتَقِي لِحَدِيثِنَا","وَمَكْنُونِ حُبٍّ في الْحَشَا قَدْ تَشَعَّبَا",68,"ب",2,0],["وحتى حسِبتُ اللّيلَ والصّبحَ، إذا بدا","حصانين سيالين جوذاً وأشقرا",69,"ر",2,0],["وحتى رأى ذُلَّ الفِرارِ غنيمةً","وحتى رأى الداءَ الذي يشتكي طِبَّا",70,"ب",2,0],["وحتى انبرى فاجتَثّ دوحةَ أحمدٍ","مفرِّعةَ الاغصان وارفةَ الذرى",71,"ر",2,0],["وحتَّى استبدَّتْ بالسَّوادِ زعانِفٌ","إلى نَفْعِها تستاقُهُ كالبهائم",72,"م",1,0],["وحتمٌ على الخفرِ الآنسات","والوحش حشرجةُ المْحْتَضَر",73,"ر",1,0],["وحتى في السكوتِ يُرادُ حزمٌ","وحتى في السلام يُراد حذقُ",74,"ق",1,0],["وحتى عليه يضمّه ودموعه","تنهلّ مثل العارض الهطّال",75,"ل",1,0],["وحتّى كأن لم يطوه عنّي الرّدى","فهل بعث الأموات أم ردّه السحر",76,"ر",1,0],["وحتّى كأنّ الرّمل لم يروه دم","كريم المصفّى لا أجاج ولا نزر",76,"ر",1,0],["وَحَتى رَأوْا مَنْ يَعْبُدُ النّارَ آمِناً","لِ جارُهُ، والبيتَ قَد خافَ داخِلُهْ",77,"ل",2,0],["وَحَتى الحَنَاثَى مِنْ قُشَيرٍ تَسُبّني،","وَجَعْدَةُ أشْبَاهُ الإماءِ الخَوَادِمِ",78,"م",1,0],["وحتى نقدِّم مالا تَشُكُّ","في أنني معهُ لاأضلُّ",79,"ل",1,0],["وحتّى يريح الذّنب من حمل وزره","حنان بغفران الذّنوب زعيم",80,"م",1,0],["وَحَتّى تَتبَع الغِربانُ مِنها","ندوبَ الرَحلِ لا تُعدي سَناما",81,"م",2,0],["وحتى تَترُكَ الأشعَارَ قَسراً","وتُلفي مُهَاجِراً بِخَنًى وسُكرِ",82,"ر",1,0],["وَحَتّى رَأَوا أَحبارَ كُلِّ مَدينَةٍ","سُجوداً لَهُ مِن عُصبَةٍ وَفُرادِ",83,"د",1,0],["وَحَتّى يُرى ذا الضِغنِ يَركَبُ ردعَهُ","مِنَ الطَعنِ فِعلَ الأَنكَبِ المُتَحامِلِ",84,"ل",1,0],["وحتامَ تمسي في سعادٍ متيماً","وتصبح مشغولاً بليلى وفي هندِ",85,"د",1,0],["وحتى متى أرعى النجوم مسامراً","لها ودموع العين ثمّ تفور",86,"ر",1,0],["وحتى أراها لا ارى مسلما بها","ذليلا عليه كافر طال واستعلا",87,"ل",2,0],["وَحتّامَ الخُلودُ إِلى مَكانٍ","عَلى مَضَضٍ بِهِ أَبَداً أُداري",88,"ر",2,0],["وَحَتّى مَلَكتُم مُلكَهُ وَاِقتَصَرتُمُ","مَقاصِيرَهُ اللّاتي بَناها فَأَحكَما",89,"م",2,0],["وَحَتّى رَأَيتُ القَومَ حَولَ سَريرِهِ","حُفاةً يَنادونَ العَويلَ بِإِعلانِ",90,"ن",1,0],["وحتى كأنّ البحر من تلك جامد","وحتى كأن البر من ذاك مائع",91,"ع",1,0],["وحتّامَ لا أصغي لعذلٍ وذِكْرُكُمْ","يَلَذُّ بسَمْعِي حينَ ما ذُكِرَ العَذْلُ",92,"ل",1,0],["وحتى إذا احترّ الوَداع وأَحرقتْ","أكبادَنا بلهيبها الأشجانُ",93,"ن",1,0],["وحتّام أنهى النفس عن شهواتها","وتضمن لي أن لا تعود فلا تفي",94,"ف",2,0],["وَحَتّى تَرى فِهِ النَجابَةَ يافِعاً","عَلى أَنَّهُ في المَهدِ قَد نالَهُ طِفلا",95,"ل",2,0],["وحتام هذا الحلم والبغي ظاهر","وفيم التراخي والعدى تتصلب",96,"ب",1,0],["وَحَتّى يَرَوا قَوماً تَضِبُّ لِثاتُهُم","يَهُزّونَ أَرماحاً وَجَيشاً عَرَمرَما",97,"م",2,0],["وحتى يغض الطرف عنه خليله","وبعرق عن اقواله من يشاكل",98,"ل",1,0],["وحتام لا تسلو حشاً واراك لا","تخاف الردى والحزم ان تتخوفا",99,"ف",2,0],["وَحَتْمٌ عَلَيَّ الحَمْدُ لِلْجُودِ وَالنَّدَى","فَمَازَالَ يَغْذُونِي الرِّضَى بِهِمَا غَذْوَا",100,"و",2,0],["وَحَتّامَ أَسْتَشْفِي مِنَ النّاسِ مَنْ بِهِ","سَقامِي وَأسْتَرْوِي مِنَ الدَّمْعِ ما يُظْمِي",101,"م",2,0],["وَحَتّامَ ذِمّةُ هذِي الْجُسُو","مِ لا يَرْهَبُ الْمَوْتُ إِخْفارَها",102,"ر",3,0],["وحتف على أهل الضلال وحجة","تقوم على أهل الشقاق بشقوة",103,"ه",1,0],["وَحتّى خيالُ الطيفِ بالوصلِ باخلٌ","عليَّ وحتّى في الرياحين نمّامُ",104,"م",1,0],["وَحَتّى سَمِعنا خَشفَ بَيضاءَ جَعدَةٍ","عَلى قَدَمَي مُستَهدِفٍ مُتَقاصِرِ",105,"ر",1,0],["وَحَتّى تَناهى الحالِبانِ وَخَفَّفا","مِنَ القَبضِ عَن خُثمٍ رِحابِ المَناخِرِ",105,"ر",1,0],["وَحتّامَ أجمل غَرس وَدّي","وَهُم شَرٌّ عَلَيهِ مِن الجَرادِ",106,"د",1,0],["وحتّى كحَلْتَ بشَزْرِ الطِّعانِ","عُيوناً نظَرْنَ إلى المُلْكِ شَزرا",107,"ر",2,0],["وحتى نرى فيما نرى قد تقشعت","غيوم غموم واضمحل ضباب",108,"ب",1,0],["وحتى أطعت الهوى والشجيُّ","يعاصي الملام لطوع الهوى",109,"ا",1,0],["وحتى غصون البان مالت ترنحا","وغنت عليها كل صادحة مثنى",110,"ن",2,0],["وحتْمٌ على البدر السرارُ وبُعدُه","بُزوغٌ على عاداتِه ونُزوعُ",111,"ع",1,0],["وحَتَّامَ النوى تهوي برحلي","وَقَدْ عَقَدَتْ بذمَّتِهِ ذِمامِي",112,"م",2,0],["وحتَّى مَتى أُعْطِي الزمانَ مقادَتِي","وَقَدْ قَبَضَتْ كَفّي عَلَى قائِمِ النَّصلِ",113,"ل",1,0],["وحتى متى هذا الشتات كأنن","أبونا صليب والجدود يهود",114,"د",1,0],["وَحَتّى قيلَ قَوَّضَ آلُ بِشرٍ","وَجاءَهُم بِبَينِهُمُ البَريدُ",115,"د",1,0],["وحتى تُرَى واحداً باقياً","كما كنتَ في دهرنا أوحدا",116,"د",2,0],["وحتى بعدَ أملسَ لم تَعَلَّقْ","له بذيول طِيبِ الوصلِ راحُ",117,"ح",1,0],["وحتى سُلُّ والغبراءُ يبسٌ","وشيمَ وكالبحار دمٌ ممار",118,"ر",1,0],["وحتام أشكو الحب والحب ظالم","إلى سلوة أعيا فؤادي حليمها",119,"م",3,0],["وحتَّام أخفي الحبّ والسقمُ بائح","وأبكي وشيبي ضاحكاً يتبسَّم",120,"م",1,0],["وَحَتّى أُبِيدَ الجَمعُ مِنهُ فَأَصبَحوا","كَبَعضِ الأُلى كانَت تُصيبُ القَوارِعُ",121,"ع",1,0],["وَحَتَّى استُبيحَ الجَمعُ مِنهُم فَأَصبَحوا","لِبَعضِ الأُلَى كانَت تُصيبُ القَوارِعُ",122,"ع",1,0],["وحتامَ لا يَفني بليلى ولوعُه","كأنَّ عليه الوجدُ ضربةُ لازمِ",123,"م",1,0],["وحتامَ أشكو الهجرَ منكمْ شكايةً","تُعَلَّمُ صدرَ الصخرِ كيف يلينُ",124,"ن",1,0],["وحتامَ أصحو قطُّ من سَكْرِ حُبِّكُم","ويُوكز قلبي رمحُ قامتِكم وَكْزا",125,"ز",2,0],["وَحَتّى تَرى الحَوَّ الطِوالَ مُتونُها","عَلى ضَوءِ نارٍ أَو مَعَ الصُبحِ تُسرَجُ",126,"ج",1,0],["وَحَتّى تَرى النَجدَ البَسيلَ كَأَنَّما","يُصَرِّجُهُ بِالزَعفَرانِ مُضَرِّجُ",126,"ج",1,0],["وَحَتّى تَرى اللِّيسَ الكُماةُ كَأَنَّما","تَصَلَّوا ذَكاً يَلوي القُلوبَ فَيُهرِجُ",126,"ج",1,0],["وَحَتّى هَواديها دقاق وَشكوها","صَريف وَباقي النِقى مِنها شَرائِد",127,"د",1,0],["وَحَتّى دَنَت ذاتِ المِراحِ فَاِذعنت","إِلَيكَ وَكلَّ الراسِماتُ الحَوافِد",127,"د",1,0],["وحتى رأيتُ مُهرَتي مُزوَئِرّةً","لدى الفيلِ يَدمَى نَحرُها والشواكلُ",128,"ل",1,0],["وحتّى متى تبري النّوائبُ صَعْدَتي","وتقرع بابي طارقاتُ النّوازلِ",129,"ل",1,0],["وحتّى يقولَ النّاسُ أسرف مُفضِلاً","عليهمْ كما قالوا أساؤوا فأسرفوا",130,"ف",3,0],["وَحَتّى عَلاها المَوجُ في جَنَباتِها","بِأَردِيَةٍ مِن نَسجِ طُحلُبِهِ خُضرِ",131,"ر",1,0],["وحَتّى حَسِبْتُ البابِلِيّينَ أَلْقَيَا","على لَفْظِها السّحْرَ الذي مِنْهُ تَنْفِثُهْ",132,"ث",2,0],["وَحَتمٌ عَليها أَن تَصوبَ فَما هَمَت","عَلى مُمحِلٍ إِلّا أَصبَحَ مُهرَعا",133,"ع",2,0]]}