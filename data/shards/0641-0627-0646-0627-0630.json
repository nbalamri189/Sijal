{"poems":[[520,"عسى منجد الأظعان يوماً يغيرها","https://www.aldiwan.net/poem12160.html","الطويل"],[563,"أشكر الله خالقي في البريه","https://www.aldiwan.net/poem33560.html","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108715","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27175","الرمل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112298","الرمل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86576","الوافر"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33308","المتقارب"],[4778,"غرامك سلوتي","https://www.poetsgate.com/ViewPoem.aspx?id=188170",""],[520,"عسى منجد الأظعان يوما يغيرها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577553",""]],"verses":[["فإن أذنت في ذا فعلت وإن أبت","سلا وجه نفسي واستمر مريرها",0,"ر",3,0],["فأنا ذاك فعله وهو ربي","فاعل والأمور عندي جليه",1,"ي",2,0],["فإن أذعنت ليلى بأني قتيلها","وقالت سيحيى باللقا عجّلوا البشرى",2,"ر",2,0],["فَأَنا ذو المَوتَتَينِ مِنهُما","هكَذا القُرآنُ قَد جاءَ بِها",3,"ه",2,0],["فأنا ذاك الّذي مَا برحَا","دامِعَ العَين كَثيرَ الأرَقِ",4,"ق",1,0],["فإن أذبح يخط دمي","قصائده على طوقي",5,"ق",2,0],["فإن أذهبَ القلبَ وجدٌ بهِ","فجسمُكَ لا شك في أثرِه",6,"ر",2,0],["فإن أذنبت يا محبوب يوما","فلا تأسى بمتبولٍ رجاكا",7,"ك",2,0],["فإن أذنت في ذاك أفعل وإن أبت","سلا وجد نفسي واستمر مريرها",8,"ر",3,0]]}