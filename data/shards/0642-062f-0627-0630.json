{"poems":[[55,"راحل أنت والليالي نزول","https://www.aldiwan.net/poem29892.html","الخفيف"],[88,"ضعت بين النهى وبين الخيال","https://www.aldiwan.net/poem10945.html","الخفيف"],[85,"يا خير من ورث السماح عن الألى","https://www.aldiwan.net/poem54238.html","الكامل"],[90,"حياكم الله أيها العرب","https://www.aldiwan.net/poem44469.html","المنسرح"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[63,"ومخطف الخصر برده حبر","https://www.aldiwan.net/poem51617.html","المنسرح"],[33,"يا خليلي هاجني الذكر","https://www.aldiwan.net/poem42511.html","المديد"],[52,"قد أذهب الداء حسادي بكثرتهم","https://www.aldiwan.net/poem24522.html","البسيط"],[52,"عامت سليمى ومسها سغب","https://www.aldiwan.net/poem64838.html","المنسرح"],[48,"قد أذكرت هذي السنون من الأذى","https://www.aldiwan.net/poem22584.html","الكامل"],[48,"قد آذنتنا بأمر فادح أذن","https://www.aldiwan.net/poem23517.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39669","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[98,"راكبة الدراجة","https://www.poetsgate.com/ViewPoem.aspx?id=15719",""],[124,"بعض بغضائكم أولى البغضاء","https://www.aldiwan.net/poem49357.html","الخفيف"],[136,"كثر الملام ولم أك لأواري","https://www.aldiwan.net/poem54647.html","الكامل"],[186,"ما مر ذكرك خاطرا في خاطري","https://www.aldiwan.net/poem67068.html","الكامل"],[275,"أنت المقيل المرتجى يا هتلر","https://www.aldiwan.net/poem35585.html","الكامل"],[280,"بشرى بإسفار صباح النجاح","https://www.aldiwan.net/poem25599.html","السريع"],[327,"ذرفت عيني دموعا","https://www.aldiwan.net/poem56351.html","مجزوء الرمل"],[369,"لو شاء طيفك بعد الله أحياني","https://www.aldiwan.net/poem60625.html","البسيط"],[409,"الحمامة إن أثارت بالهديل","https://www.aldiwan.net/poem32903.html","الرمل"],[422,"أي نار بها الجوانح تصلى","https://www.aldiwan.net/poem54098.html","الخفيف"],[484,"ما كان قولك في لوزان مقبولا","https://www.aldiwan.net/poem36949.html","البسيط"],[484,"يا سفر سيفر وإن خطوك بالذهب","https://www.aldiwan.net/poem37206.html","البسيط"],[484,"أناخ في قلب ليلى هاجس الشجن","https://www.aldiwan.net/poem37572.html","البسيط"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80231","الرمل"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101993","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64972","البسيط"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56662","الخفيف"],[1282,"","https://poetry.dctabudhabi.ae/diwan/poem/105279","الرجز"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122050","الرمل"],[1996,"","https://poetry.dctabudhabi.ae/diwan/poem/82848","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27814","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77303","الخفيف"],[2277,"","https://poetry.dctabudhabi.ae/diwan/poem/101844","الخفيف"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126231","المتدارك"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122488","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87420","البسيط"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99337","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108383",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45778","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36724","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77088","البسيط"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199063","البسيط"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199048","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86371","البسيط"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36643","الدوبيت"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133186","الرجز"],[4884,"(أَفَأَمِنُوا مَكْرَ اللَّهِ ...)","https://www.poetsgate.com/ViewPoem.aspx?id=201762",""],[5552,"صوت من المخيم","https://www.poetsgate.com/ViewPoem.aspx?id=18416",""],[5795,"نصرت دولة المهى التركيه","https://www.poetsgate.com/ViewPoem.aspx?id=167910",""],[5957,"يا شجي الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=53772",""],[6143,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=34307",""]],"verses":[["قَد أَذاعَ الغَليلُ قَلبي وَلَكِن","غَيرَ بَدعٍ إِنِ اِستَطَبَّ العَليلُ",0,"ل",1,0],["قَد أَذالوكَ بَينَ أُنسٍ وَكَأسٍ","وَغَرامٍ بِظَبيَةٍ أَو غَزالِ",1,"ل",1,0],["قد أذكرت دار النعيم عبيدَهُ","وتضمنت من فضله رضوانا",2,"ن",2,0],["قد أذبل الجوع ورد وجنتها","فاصفرّ وامتصّ ماءه اللَغَب",3,"ب",1,0],["قد أُذيلت لهم لحىً كالجوالي","قِ تليها عنافِقٌ كالمخالي",4,"ل",2,0],["قَد أَذَلَّ الرِجالَ فَهيَ عَبيدٌ","وَنُفوسَ الرِجالِ فَهيَ إِماءُ",5,"ا",2,0],["قد أُذهِبَتْ في الجبينِ غُرُّتُهُ","إذ فُضِّضَتْ في جِبَاهها الغُرَرُ",6,"ر",1,0],["قَد إِذا خُبِّرتُ أَنَّهُمُ","قَدَّموا الأَثقالَ فَاِبتَكَروا",7,"ر",3,0],["قَد أَذهَبَ الداءُ حُسّادي بِكَثرَتِهِم","وَلَو فَنوا عَزَّ دائي مَن يُداويني",8,"ن",2,1],["قَد أَذعَرُ الجِنَّ في مَسارِحِها","قَلبي مُضيءٌ وَمِقوَلي ذَرِبُ",9,"ب",1,0],["قَد أَذكَرَت هَذي السُنونَ مِنَ الأَذى","لا أَنَّ ناسِيَها لَهُ أَذكارُ",10,"ر",1,1],["قَد آذَنَتنا بِأَمرٍ فادِحٍ أُذُنٌ","وَإِنَّما قيلَ آذانٌ لِإيذانِ",11,"ن",1,1],["قد أذهل الخطبُ شعري عن شوارده","وأُنسِيَتْ كلماتي شدْوَ أوزاني",12,"ن",2,0],["قد آذن الليلُ بانقضاءِ","وأنتِ موصولةُ السهرْ",13,"ر",1,0],["قد أذن الفخذين بافتضاح","ونمّ عن خميلة التّفّاح",14,"ح",1,0],["قد أذقناك حين أصفيتنا الود","وفاءً أعذب به من وفاء",15,"ا",2,0],["قد اذكرتني إذ بدت وتبسمت","روضا تفتق نَورُه وَدَرارِى",16,"ر",2,0],["قَد أَذهَلتْ لبِّي الخَطوبُ بَوقعِها","عَنهُ وَكانَ عَلى ذُهولي ذاكِري",17,"ر",2,0],["قد أذنبوا نحو الأنامِ وربِّهم","ونفوسِهم فذنُوبُهم لا تُغفر",18,"ر",1,0],["قَدْ آذَنَ المَنُّ بِحَوْزِ المُنى","وَأَعْلَنَ الكَدْحُ بِفَوْزِ القِداح",19,"ح",1,0],["قَد أَذاعَت بِرُسومٍ","لا تَبِينُ لِبَصيرِ",20,"ر",1,0],["قد أذهلَ الشَّيبُ لمّا جَلَّ نازلةً","عنّا فتاةَ بني ذُهْلٍ بْنِ شَيْبان",21,"ن",1,0],["قد أذابت مهجتي نار الخدود","فهي في الأحشا توقد",22,"د",1,0],["قد أذلَّ الغرامُ كلَّ عزيز","والهوى يترك الأَعزّ الأَذلاّ",23,"ل",2,0],["قد أذكرتني قوافيها بمعتصم","تحدو به نحوها الشهباء تعجيلا",24,"ل",2,0],["قد أذعرتها ليوث الترك فانتشرت","منها شعاعا ولج الروم في اللجب",25,"ب",1,0],["قد أذكرته بسلماه أميمتها","مذ عاجلتها يد السقام بالظعن",26,"ن",1,0],["قَد أَذابَتها حَقيقات الأَسى","فَاِترُكوها مِن عِبارات المَجازِ",27,"ز",1,0],["قد إذا رنحّت أعطافه مرحا","يكاد ينقد لولا أنه خضل",28,"ل",1,0],["قد آذَنَ العيدُ لي بالنُّجحِ حينَ دَنَا","فاسْمحْ بإِذْنٍ إِلى سُؤْلٍ يُؤدِّبني",29,"ن",2,0],["قد أذاب البعاد جسمي حتى","فني الجسم ثم أبقى النحولا",30,"ل",2,0],["قد أذن المجد إلى شمس الضحى","ان تلك أبراج العلى فازدحفي",31,"ف",2,0],["قَدْ أَذَابَ العَيْنَ لَمَّا","زَادَ شَوْقِي لِلسَّبِيكَهْ",32,"ه",1,0],["قَد أَذابَت حَياته لَوعة البَح","ثِ فَنابَ الضُّلوعَ داء النحولِ",33,"ل",1,0],["قد أذنَ الرحمن فيه بحجه","فاتوه رُكباناً به ورجالا",34,"ل",2,0],["قَد أَذَلّوا عِبادَكَ الضُعَفاءُ","وَاِرتَدَوا ثَوبَ مَجدِك الكِبرِياء",35,"ا",2,0],["قد أذاب الفراق مني جسما","لو تأملته صنعت جميلا",36,"ل",2,0],["قد آذَنَ لَيلُكَ بالبَلَجِ","فالصُبحُ بنصرى مُنبَلجُ",37,"ج",1,0],["قد أذِن اللهُ أن تُبنَى البُيُوتَ لَه","وأن تُعمَّرَ فِي الأسحارِ والأصُلِ",38,"ل",1,0],["قد اذنبت مقلتي ذنباً بنظرتها","فعُوقبَت بقروح الدمعِ والسهرِ",39,"ر",1,0],["قد أذعنت أرض العد","ووجاء بالنصر البشير",40,"ر",1,0],["قد أذتني نفسي فما حال واشٍ","أو نفورٌ للوصل إلا حياها",41,"ا",3,1],["قَد أَذهَب الرَجس المُهيمن عَنكُم","كَرَماً وَطَهر بَيتَكُم تَطهيرا",42,"ر",2,0],["قَد أَذكَرتُ مِن عُهودِ الصَبِّ ما سَلَفا","فَكادَ يُقضى عَلى تِذكارِهِ أَسَفا",43,"ف",2,1],["قَد أَذعَنَت لي حَدائِق العِراقِ بِهِ","وَفَضل أَهلِ الحِجاز الطَيِّبين حلي",44,"ل",2,0],["قد آذن الله من عاداهم حربا","لم ينج من خصمه في الحرب قهار",45,"ر",1,0],["قد أذكراني فضل آباء لهم","فجزاء شكران الجميل ثناء",46,"ا",2,0],["قد أذنب الدهر ذنباً جاء معتذراً","منه إليك يرجى منك غفرانا",47,"ن",2,0],["قَد أَذهَبَ ماءَ وَجهي القَومُ هُنا","أَنّى هربي وَشيكَتِ الأَقدامُ",48,"م",1,0],["قد أذهبوا الأعمال في غرورٍ","غاياتهم دعوى وفرط قسوه",49,"و",2,0],["قد أَذْهَلَتْ أَفْعالُهُ شَيْطَانَهُ","إذْ صار قُدْوَتَهُ ومَتْبُوْعَ الدُّهَاهْ",50,"ا",2,0],["قد أذهلَ الهَوْلَ أننا لا نراه","بل نرى فيه ما استحق الزرايهْ",51,"ا",3,0],["قد أذلتك نسوة يتبرج","ن دلالاً تبرُّج الجاهليه",52,"ي",2,0],["قد أذاب الحزن قلبي عندما","أحرقت نار الأسى أوراقنا",53,"ن",2,0],["قد أذاني طوق موت","للبراري أرسليني",54,"ن",2,0]]}