{"poems":[[55,"أرى نفسي تتوق إلى النجوم","https://www.aldiwan.net/poem29756.html","الوافر"],[37,"شجا أظعان غاضرة الغوادي","https://www.aldiwan.net/poem39157.html","الوافر"],[90,"أرى الشعر أحياناً بجيش بخاطري","https://www.aldiwan.net/poem44455.html","الخفيف"],[29,"أتنسى يوم حومل والدخول","https://www.aldiwan.net/poem5965.html","الوافر"],[53,"أرى العصفور يعبث بالفخاخ","https://www.aldiwan.net/poem9440.html","الوافر"],[53,"فيم اجتهادي في محاولة الغنى","https://www.aldiwan.net/poem64039.html","الطويل"],[53,"أبا بكر لك المثل المعلى","https://www.aldiwan.net/poem65904.html","الوافر"],[53,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[91,"وددت لو أني كنت في مصر محشورا","https://www.aldiwan.net/poem44924.html","الطويل"],[30,"ألا من مبلغ عني زيادا","https://www.aldiwan.net/poem5007.html","الوافر"],[63,"قل للأمير الذي علا فغدا","https://www.aldiwan.net/poem51744.html","المنسرح"],[2,"صحا القلب عن سلمى وقد كاد لا يسلو","https://www.aldiwan.net/poem25064.html","الطويل"],[18,"أليلتنا بذي حسم أنيري","https://www.aldiwan.net/poem23949.html","الوافر"],[35,"أجدك يا حمامات بطوق","https://www.aldiwan.net/poem25763.html","الوافر"],[22,"ألا أبلغ بني عوف بن كعب","https://www.aldiwan.net/poem21645.html","الوافر"],[77,"سقتني بما مجت شفاه الأراقم","https://www.aldiwan.net/poem69041.html","الطويل"],[50,"يزيد ماذا دهاكا","https://www.aldiwan.net/poem64487.html","المجتث"],[48,"فقدت في أيامك العلماء","https://www.aldiwan.net/poem22013.html","الخفيف"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[107,"","https://poetry.dctabudhabi.ae/diwan/poem/49149","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85480","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9902","الوافر"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20983","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54663","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54572","البسيط"],[92,"احمد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179129",""],[53,"أرى العصفُورَ يعبثُ بالفِخَاخ","https://www.poetsgate.com/ViewPoem.aspx?id=27434",""],[1,"لِخَولة َ أطْلالٌ بِبُرقَة ِ ثَهمَدِ، ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13176&r=&rc=0",""],[35,"أجَدَّكِ يَا حَمَاماتٍ بطَوْقٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14156&r=&rc=90",""],[130,"لعمر أبيك يا عباس إني","https://www.aldiwan.net/poem24209.html","الوافر"],[135,"ألما بي على الربع القديم","https://www.aldiwan.net/poem54742.html","الوافر"],[135,"أشاقتك ورق اللوى هتفا","https://www.aldiwan.net/poem54796.html","المتقارب"],[147,"نعم إن أنت ترحمني نجحت","https://www.aldiwan.net/poem4456.html","الوافر"],[163,"بشراك بشراك هبت نسمة الفلق","https://www.aldiwan.net/poem59101.html","البسيط"],[163,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[188,"أرى الناس قد أغروا ببغى وغيبة","https://www.aldiwan.net/poem14801.html","الطويل"],[202,"مكانك يا بدر وإن كنت واشيا","https://www.aldiwan.net/poem45229.html","الطويل"],[202,"غرامك لا يبقى على نفس إنسان","https://www.aldiwan.net/poem45617.html","الطويل"],[238,"أيا مولاي مجد الدين يا من","https://www.aldiwan.net/poem32192.html","الوافر"],[240,"ذوي ودي ويا من عنفوني","https://www.aldiwan.net/poem19282.html","الوافر"],[252,"وإني لراج منك يا أوس نعمة","https://www.aldiwan.net/poem2125.html","الطويل"],[262,"بحمد الله يبدأ كل شاكر","https://www.aldiwan.net/poem35945.html","الوافر"],[274,"خل الغرام لصب دمعه دمه","https://www.aldiwan.net/poem52119.html","البسيط"],[308,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[323,"ما تم أمر بلا سبق إلى قدر","https://www.aldiwan.net/poem61657.html","البسيط"],[346,"تأهب مثل أهبة ذي كفاح","https://www.aldiwan.net/poem24178.html","الوافر"],[369,"وإني إذا استغربت يوما من الأسى","https://www.aldiwan.net/poem17756.html","الطويل"],[380,"رأيت الله حل بكل قلب","https://www.aldiwan.net/poem59367.html","الوافر"],[383,"أيا من يدعي شجو الطروب","https://www.aldiwan.net/poem48820.html","الوافر"],[396,"حب علي شرف","https://www.aldiwan.net/poem53669.html","مجزوء الرجز"],[406,"أجاب الدمع من قبل اللسان","https://www.aldiwan.net/poem33393.html","الوافر"],[408,"إذا قيض الله أمرا دنت","https://www.aldiwan.net/poem49855.html","المتقارب"],[419,"لقد عجب الحسان الغيد لما","https://www.aldiwan.net/poem53981.html","الوافر"],[419,"رآها قد أضر بها الكلال","https://www.aldiwan.net/poem54006.html","الوافر"],[419,"تبارك من براك ابن المبارك","https://www.aldiwan.net/poem54012.html","الوافر"],[419,"وميض البرق هيج منك وجدا","https://www.aldiwan.net/poem54190.html","الوافر"],[435,"أي نجم من أي شمس وبدر","https://www.aldiwan.net/poem12370.html","الخفيف"],[460,"تموق الليالي فيكم ثم تعقِل","https://www.aldiwan.net/poem55908.html","الطويل"],[463,"وأنيقة أنف يضوع طيبها","https://www.aldiwan.net/poem15169.html","الكامل"],[463,"كأن عقارا خندريسا تضوعت","https://www.aldiwan.net/poem16114.html","الطويل"],[507,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[553,"لقل غناء العتب والمجرم الدهر","https://www.aldiwan.net/poem47826.html","الطويل"],[555,"طلائع شيب سير أسرعها رسل","https://www.aldiwan.net/poem68424.html","الطويل"],[563,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"]],"verses":[["وَأَنّي قَد أَبيتُ مُقامُ رَحلي","بِوادي الرَمثِ أَو جَبَلِ الغَميمِ",0,"م",1,0],["وَإِنّي قائِلٌ إِن لَم أَزُرهُ","سَقَت دِيَمُ السَواري والغَوادي",1,"د",2,0],["وإنّيَ قد مارسته بفطانة","يلوح سناها غرّةً في جبينه",2,"ن",2,0],["وَإِنّي قَد رَمَيتُكَ مِن تَميمٍ","بِعِبءٍ لا تَقومُ لَهُ ثَقيلِ",3,"ل",1,0],["وإني قائل فيه مقالاً","يُغِصُّ الحلقَ بالماء النُّقَاخِ",4,"خ",1,0],["وإن يقض لي اللَّهُ الرجوعَ فإنهُ","عليَّ لَهُ ألا أفارقكم نذر",5,"ر",1,0],["وإني قائلٌ لك قولَ لاهٍ","نبيلٍ شأنُه شأنٌ نبيلُ",6,"ل",1,0],["وأني قد بعلتُ به فأضحى","كأن مغانمي منه غرامُ",7,"م",1,0],["وإني قد ألقيت شعري ساحراً","فألفيت جمهور المصيخين مسحورا",8,"ر",2,0],["وَأَنّي قَد فَرَرتُ إِلَيهِ مِنكُم","إِلى ذي المَجدِ وَالحَسَبِ التَليدِ",9,"د",1,0],["وأن يقولَ العذولُ مُبتهجاً","أفاقَ من نَشوةِ النَّدى فصَحا",10,"ح",2,0],["وَإِن يُقتَلوا فَيُشتَفى بِدِمائِهِم","وَكانوا قَديماً مِن مَناياهُمُ القَتلُ",11,"ل",1,0],["وَأَنّي قَد تَرَكتُ بِوارِدَاتٍ","بُجَيراً في دَمٍ مِثلِ العَبيرِ",12,"ر",1,0],["وَأَنّي قَد بَراني الحُبُّ حَتّى","ضَنِنتُ وَما أَراكِ تَغَيَّرينا",13,"ن",2,0],["وَإِنّي قَد عَلِقتُ بِحَبلِ قَومٍ","أَعانَهُمُ عَلى الحَسَبِ الثَراءُ",14,"ا",2,0],["وإنّيَ قد حُمِّلْتُ منهم نَصائحاً","كرائمَ تُهْدى عن نفوسٍ كرائم",15,"م",1,0],["وَإِن يَقَدِّر إِلَهُ ال","عِبادِ أَن لا أَراكا",16,"ك",2,0],["وَأَنيقُ الرَبيعِ يُدرِكُهُ القَي","ظُ وَفيهِ البَيضاءُ وَالسَحماءُ",17,"م",3,0],["وَإِن يَقذِفوا بِالقَذعِ عِرضَكَ أَسقِهِم","بِكَأسِ حِياضِ المَوتِ قَبلَ التَهَدُّدِ",18,"د",1,0],["وأنْ يُقِرَّهم على الولايَهْ","على دُرورِ الخَرْجِ والجِبايَهْ",19,"ه",1,0],["وَإنّي قد أَبَيْتُ فلم أُعِنْهُم","عَلَيكَ وما تَرَكْتُكَ عن تَقِيَّهْ",20,"ي",2,0],["وإني قَد أَدعوك يوماً بِباطِلٍ","أَديباً ولكنَّ المروءة ترفض",21,"ض",1,0],["وَإِنّي قَد شَرِبتُ دَمَ الأَعادي","بِأَقحافِ الرُؤوسِ وَما رَويتُ",22,"ت",1,0],["وإنِّي قد وَكَلتُ اليومَ أَمري","الى رَبٍّ قريبٍ مُستجيبِ",23,"ب",1,0],["وَإِنْ يَقْنِ لاَ يَقْنِ الْحُطَامَ وَغَيْرُهُ","تَعُزُّ عَلَيْهِ فِدْيَةٌ وَزَكَاةُ",24,"ه",1,0],["وَأَنْ يُقَلَّدَ وَزِيرُ الْحُكْمِ مَنْصِبَهُ","فَلاَ كَذَاكَ وَزِيرُ الْعِلْمِ وَالأَدَبِ",25,"ب",1,0],["وأن يقطعَ الموتُ ذاك النشيدَ","وأن يأكلَ الدودُ ذاكَ الوتَر",26,"ر",1,0],["وإني قائل فيه مقالاً","يُغِضُّ الحلقَ بالماء النُّقَاخِ",27,"خ",1,0],["وإن يَقذِفوا بالقَذع عِرْضَك أسقِهمْ","بشرْبِ حياض الموت قبل التهدُّد",28,"د",1,0],["وأني قد براني الحب حتى","ضنيت وما أراك تغيرينا",29,"ن",2,0],["وإني قد تُعاتِبُني سُلَيْمٌ","على جَرِّ الذُّيول إلى الفسادِ",30,"د",1,0],["وإني قَد بَلَوتُ قُدمُوهُم في","مَآزِقَ هِىَّ أمنَعُ لِلقُدُومِ",31,"م",1,0],["وإني قَد جِئتُهُ لَيلَةً","وَعايَنتُ مِن أمرِهِ مَا اختفي",32,"ف",2,0],["وإني قد رأيتك مع ذنوبي","تمن على حتى قد طمعت",33,"ت",1,0],["وان يقل قائل هم أصل نشأته","في الملك قلت له فالحكم للخلق",34,"ق",1,0],["وأن يقيم عليكم في الكتاب لنا","أدلة منه تجزي كل مؤتسب",35,"ب",1,0],["وإِن يَقْنع المسكينُ قالوا لعلةٍ","وذلة نفس قد حوتْها الرذائل",36,"ل",1,0],["وإني قسمتُ الروعَ شطرينِ واحدٍ","بجسمي وشطرٍ عندها لا يرانيا",37,"ي",2,0],["وإن يقرأ العذالُ ما أنا كاتمٌ","فقد خطَّ في خديَّ بالدمعِ سطرانِ",38,"ن",1,0],["وَأَنّي قَد غَنيتُ عَنِ الطَعامِ ال","لَذي هُوَ مِن ضَروراتِ البَقاءِ",39,"ا",2,0],["وَأَنِّي قَدْ جَفَانِي مَنْ سَبَانِي","فَنَادَى الْوَجْدُ حَيَّ عَلَى الأَنِينِ",40,"ن",1,0],["وَإِنّي قَد أَهجَرتُ بِالقَولِ ظالِماً","وَإِنّي مِنهُ يا اِبنَ سُعدى لَتائِبُ",41,"ب",1,0],["وإن يقلب عليك القلب يوماً","تصدّى عالماً لك بالمضارر",42,"ر",1,0],["وإن يقصدك بالضرّاء يوماً","فلم يقدر لأنّ الله حاضر",42,"ر",1,0],["وان يقم لاستراق السمع مسترق","فَعنده صادر الارجاء يرجمه",43,"م",2,0],["وَأن يقرّبهُ تحبيرُ مدحهمُ","إِلى رِضاكَ وَإن أقصاه مجترمُ",44,"م",1,0],["وَإِن يَقُع صاحِبُ المَعروفِ كانَ لَهُ","مِن صُنعِهِ مُتكافي الغَيبِ مُستَتَرِ",45,"ر",1,0],["وَإِنّي قَد جَنَيتُ عَلَيكَ حَرباً","تُغِصُّ الشَيخَ بِالماءِ القَراحِ",46,"ح",1,0],["وَإِنّي قَد اِستَأثَرتُ بِالعَيشِ ما صَفا","وَإِنّي قَد اِستَمتَعتُ بِالدَهرِ ما صَلَح",47,"ح",1,0],["وإني قد نظرت إلى خبيثٍ","كشيطانين في جسمٍ مُغاش",48,"ش",1,0],["وَإِن يَقضِ الفُراق عَلَيَّ ظُلماً","فَكَم قَتَل التَفَرّق مِن غَريب",49,"ب",1,0],["وَاِن يَقولوا رافِضي","يٌ مُسرِفٌ أَو عَنَّفوا",50,"ف",3,0],["وأني قد لقيت بها عصاماً","وسعد الدين وابن الزملكان",51,"ن",1,0],["وإن يقضِ بالعُسرِ في مطلَبٍ","فَمنْ لكَ يَوماً بإسعافِهِ",52,"ه",1,0],["وإنِّي قد مَدَدْتُ اليوم باعاً","أنال بها الَّذي فوق الدراري",53,"ر",2,0],["وإنِّي قد رأيت علاك منهم","مرامٌ قد يرامُ ولا ينال",54,"ل",1,0],["وإنِّي قد ترقَّبت الغوادي","ووابلها ترقَّبت ازديارك",55,"ك",1,0],["وإنِّي قد عَرَفتُ الناس طرًّا","ولم أعرف له في الناسِ نِدَّا",56,"د",2,0],["وأَنيقٍ من المحامِدِ نَمَّتْ","بأَحاديثِهِ رِياحُ الشُّكرِ",57,"ر",1,0],["وأنيَ قد حَرّمتُ نفسي عليهمُ","ورِقِّيَ مِلكٌ في يديك محلَّلُ",58,"ل",1,0],["وأنيقةٍ أنُفٍ يُضَوِّعُ طِيبها","جُنْح الدُّجى عمدُ التراب وجعدهُ",59,"د",2,1],["وأن يقتُل الجاني بغير اغْتِفارهِ","ولو أمكَنتْهُ فُرْصةٌ ومَقاتِلُ",60,"ل",1,0],["وأنّي قد شهدت النا","رَ تُغوي الطينَ عِصْيانا",61,"ن",2,0],["وأنّي قلتُ شعراً يوْ","م غلَّ النسرُ ثعْبانا",61,"ن",2,0],["وأنّي قد شهدتُ النا","سَ في الزينةِ ألْوانا",61,"ن",2,0],["وأنّي قد شهدتُ الصل","بَ إذ هلكَ الذي خانا",61,"ن",2,0],["وأنّي قد ورثت الخض","رَ والفضلَ ولقمانا",61,"ن",2,0],["وَإِنّي قَليلُ الرّيثِ فيما يُريبنِي","لذاك رِكابِي ليس يحظى بها مصرُ",62,"ر",1,0],["وَأَنّي قَصِيُّ الرِحمِ مَجدي لِغَيرِهِ","فَعابَ وَما آلى وَمِن دونِهِ سَدلُ",63,"ل",1,0],["وَإِن يَقُل لا جُعلَ عِندي يُعكَلِ","مِنها ثِنىً عَلى ثِنىً مُعَقَّلِ",64,"ل",1,0]]}