{"poems":[[55,"لو رأيت الغرام يبلغ عذرا","https://www.aldiwan.net/poem30442.html","الخفيف"],[79,"روع بالي وهاج بلبالي","https://www.aldiwan.net/poem36366.html","المنسرح"],[95,"روعتني ذكرى الخسارة لما","https://www.aldiwan.net/poem11229.html","الخفيف"],[53,"لقد رأينا عجبا من العجب","https://www.aldiwan.net/poem8315.html","الرجز"],[53,"إن تطل لحية عليك وتعرض","https://www.aldiwan.net/poem62843.html","الخفيف"],[93,"بت أرعى في الظلام الأنجما","https://www.aldiwan.net/poem8872.html","عموديه"],[87,"روعوه فتولى مغضبا","https://www.aldiwan.net/poem7519.html","الرمل"],[87,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[87,"قم سليمان بساط الريح قاما","https://www.aldiwan.net/poem63696.html","الرمل"],[87,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[64,"سعدت بطول بقائك الحقب","https://www.aldiwan.net/poem52479.html","أحذ الكامل"],[47,"شد ما أغرمت ظلوم بهجري","https://www.aldiwan.net/poem63602.html","الطويل"],[47,"لبيت فيك الشوق حين دعاني","https://www.aldiwan.net/poem66690.html","الكامل"],[68,"رو عظامي بسلا","https://www.aldiwan.net/poem38502.html","مجزوء الرجز"],[99,"قلت للبحرِ إذ وقفت مساء","https://www.aldiwan.net/poem24399.html","الخفيف"],[99,"أحسد الشيب على رأسك","https://www.aldiwan.net/poem24404.html","مجزوء الرمل"],[107,"يا دمنهور ارقبيه موكبا","https://www.aldiwan.net/poem42063.html","الرمل"],[107,"يا بريد الدهر يمشي خفية","https://www.aldiwan.net/poem43137.html","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39563","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42564","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55099","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55059","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54695","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55418","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43800","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54249","السريع"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[92,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[96,"مصرع الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=12923",""],[96,"أين أين الرعيل من أهل بدر","https://www.poetsgate.com/ViewPoem.aspx?id=13787",""],[96,"من كسعد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66301&r=&rc=19",""],[113,"من لوجدي وحيرتي وافتقاري","https://www.aldiwan.net/poem16692.html","الخفيف"],[137,"أعليت دين الواحد القهار","https://www.aldiwan.net/poem4234.html","الكامل"],[139,"ريب المنون وصرف الدهر أعياني","https://www.aldiwan.net/poem49155.html","البسيط"],[147,"قسما بسؤددك الذي لا يدعى","https://www.aldiwan.net/poem11776.html","الكامل"],[147,"لي بامتداحك عن ذكر الهوى شغل","https://www.aldiwan.net/poem11803.html","البسيط"],[226,"أرخصت يوم فراقك الدمعا","https://www.aldiwan.net/poem55275.html","أحذ الكامل"],[240,"بأبي وجه هلال","https://www.aldiwan.net/poem31976.html","مجزوء الرمل"],[246,"أودى بي الحزن واغتال الجوى جلدي","https://www.aldiwan.net/poem45759.html","البسيط"],[333,"هدم الليل ما بناه النهار","https://www.aldiwan.net/poem55005.html","الخفيف"],[556,"ما أرادت إلا الجفاء ظلوم","https://www.aldiwan.net/poem47245.html","الخفيف"],[991,"","https://poetry.dctabudhabi.ae/diwan/poem/198332","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119900","الخفيف"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25329","الرجز"],[1317,"","https://poetry.dctabudhabi.ae/diwan/poem/146951","الخفيف"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46642",""],[1456,"","https://poetry.dctabudhabi.ae/diwan/poem/143625","البسيط"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95550","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95495","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95556","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95544","الخفيف"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141287","الخفيف"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126644","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125481","المواليا"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53158","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65940","الرجز"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122494","الخفيف"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145069","الخفيف"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129491","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86503","الكامل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107530","الكامل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101358","الرجز"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52137","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52154","المقتضب"],[4929,"تطريز (ذكريات)","https://www.poetsgate.com/ViewPoem.aspx?id=202406",""],[4978,"تحية لأستاذتي عبير التميمي","https://www.poetsgate.com/ViewPoem.aspx?id=189769",""],[5010,"دموع","https://www.poetsgate.com/ViewPoem.aspx?id=190760",""],[5074,"شوق واعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=153919",""],[5074,"ضيعتي في اللَّيل","https://www.poetsgate.com/ViewPoem.aspx?id=153951",""],[5111,"جَمَرُ الكَلامِ","https://www.poetsgate.com/ViewPoem.aspx?id=212329",""],[5121,"مَسَاءُ الشُّعُورِ","https://www.poetsgate.com/ViewPoem.aspx?id=56463",""],[5121,"الكَأْسُ","https://www.poetsgate.com/ViewPoem.aspx?id=215480",""],[5131,"شرف الأحرار","https://www.poetsgate.com/ViewPoem.aspx?id=55359",""],[5186,"روعة الشعر من لحاظ الزهور","https://www.poetsgate.com/ViewPoem.aspx?id=156484",""],[5279,"رَوَّعْتَ قَلْبِي","https://www.poetsgate.com/ViewPoem.aspx?id=183667",""],[5302,"ليل ونهار","https://www.poetsgate.com/ViewPoem.aspx?id=200550",""],[5409,"هيئوا العدة وامشوا قدما","https://www.poetsgate.com/ViewPoem.aspx?id=155314",""],[5484,"روع الكون وادلهم السماء","https://www.poetsgate.com/ViewPoem.aspx?id=206305",""],[5552,"صوت من المخيم","https://www.poetsgate.com/ViewPoem.aspx?id=18416",""],[2599,"فى وداع شوقى","https://www.poetsgate.com/ViewPoem.aspx?id=14004",""],[5725,"روّع القلب","https://www.poetsgate.com/ViewPoem.aspx?id=185781",""],[402,"روعتني ذكرى الخسارة لما","https://www.poetsgate.com/ViewPoem.aspx?id=36447",""],[402,"يا ليلة فاجأت سرب الغيد","https://www.poetsgate.com/ViewPoem.aspx?id=35343",""],[5956,"إشعاع الإنسانية في الإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=204680",""],[6229,"دمية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65180&r=&rc=1",""],[6256,"مداعبة صديق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65926&r=&rc=14",""]],"verses":[["رَوعَةٌ إِن جَزِعتُ مِنها فَعُذرٌ","لِجَزوعٍ وَإِن صَبَرتُ فَأَحرى",0,"ر",2,0],["رَوَّعَ بَالِي وَهَاجَ بَلْبَالِي","وَسَامَنِي الثَّكْلَ بَعْدَ إقْبَالِ",1,"ل",1,1],["رَوَّعَتْنِي ذِكْرَى الخَسَارَةِ لَمَّا","نَبَّأُونِي بِهَا فَبُتُّ حَزِينَا",2,"ن",2,1],["روَّعَ طفلاً لم يكن ترويعُهُ","من المُداراة ولا أخذِ الأُهَبْ",3,"ب",1,0],["روعة تستخفُّه لم يُرَعْها","من رأى وجهَ مُنكَر ونَكيرِ",4,"ر",1,0],["رَوَّعَتني بِالنَوى بَعدَ اللِقاء","وَكَذا الدُنيا دُنُو وَاِفتِراق",5,"ق",1,0],["روّعوه فتولى مغضبا","أعلمتم كيف ترتاع الظَّبا",6,"ب",2,1],["رَوعَةُ النادي إِذا جَدَّت فَإِن","مَزَحَت لَم يُذهِبِ المَزحُ بَهاها",7,"ا",3,0],["رَوَّعَت قَلبي خُطوبٌ رَوَّعَت","سامِرَ الأَحياءِ فيها وَالنِياما",8,"م",2,0],["رَوعَةٌ في الضُحى مَلاعِبُ جِنٍّ","حينَ يَغشى الدُجى حِماها وَيُغسي",9,"س",2,0],["رَوعاءُ لم يثبُتْ لها بَدَنٌ","إلا يروح وهمُّها الهَرَبُ",10,"ب",1,0],["رَوعَةٌ مِن وَقارِهِ ظَنَّها الجا","هِلُ إِذ فاجَأَتهُ رَوعَةُ كِبرِ",11,"ر",1,0],["رَوَّعتُمُ جاراتِهِ فَبَعَثتُمُ","مِنهُ حَمِيَّةَ آنِفٍ غَيرانِ",12,"ن",1,0],["رَوِّ عِظامي بِسُلا","فِ العِنَبِ المُوَرَّقِ",13,"ق",1,1],["روعتني ضآلةُ الناسِ فيه","فبكيتُ الحياةَ والأحياءَ",14,"ا",2,0],["روعة الحقِّ لقد نك","كست الصاري احترامَا",15,"م",2,0],["رَوَّعُوهُ وأقاموا حَوله","ضَجّةً تُؤْذي النُّفوسَ الطّاهرهْ",16,"ر",2,0],["رَوَّعَ الغَبراءَ قَومٌ أَكلوا","مِن بَني حَوّاءَ ما لا يُؤكَلُ",17,"ل",1,0],["رُوِّعَ الطيرُ يوم غاب عن الأي","كِ وسالت جراحها الملتامَه",18,"م",2,0],["رَوْعَاءُ تَفْزَعُ مِنْ عَصَافِيرِ الضُّحَى","تَرَفاً وَتَجْزَعُ مِنْ صِيَاحِ الْهُدْهُدِ",19,"د",1,0],["رَوَّعَكَ الشِّعْرُ بِأَوْهَامِهِ","وَالأَمْنُ كُلُّ الأَمْنِ مَا رَوَّعَكْ",20,"ك",1,1],["رُوَّعَتْ بِالفِرَاقِ بَعْدَ الفِرَاقِ","وَبِهَا مَا بِهَا مِنَ الأشْواقِ",21,"ق",1,1],["رُوِّعْنَ حِينَ قَدِمْتُ ثُمَّ أَنِسْنَ لِي","وَرَضِينَ بِي فِي المَحْفِلِ المَعْقُودِ",22,"د",1,0],["رَوَّعَ الشَّرْقَ مَنْ نَعَى خَيْرَ رَبَّا","تِ النُّهَى فِيهِ وَالصِّفَاتِ الْعُيُونِ",23,"ن",1,0],["رَوعي المَروعُ هَل يَكونُ جَزاؤهُ","بِاِبنِ المقدّسِ روحهُ التَقديسُ",24,"س",1,0],["رَوَّعَني واللَّيْلُ في زِيِّهِ","مِنْ مُرْجِفاتِ الْخطْبِ ما رَوَّعا",25,"ع",2,0],["روعاء ترمي مقلتيها حذرا","بين عزيف وعواء وصدى",26,"ا",1,0],["روعةُ الحرب قد خلَعتَ عليها","روعةً من نسيجك المتلاحِم",27,"م",1,0],["روّعوا الأمّهات في حلّك الليل","وراعوا صغراها في المهود",28,"د",1,0],["روّعت سربنا المنايا وأمّ","المجد في الغوطتين أمّ ثكول",29,"ل",1,0],["روعة الشمس في الغروب ولا أعشق","للشمس عنفوانا ورأدا",30,"د",2,0],["رَوعة بكرة وَاخرى مَساءً","وَهُموم تَجيءُ وَسَط النَهار",31,"ر",1,0],["روَّعت كل مروعٍ وحفظت كُل","لَ مضيعٍ وحميت كل ذمارِ",32,"ر",1,0],["روَعت قلبي وكم فرّقت مجتهداً","بيني وبين أخِلائي وأخداني",33,"ن",2,0],["رَوَّعتَ عاصِيَهُ فَأَصبَحَ طائِعاً","وَقَدَعتَ جامِحَهُ فَأَصحَبَ طَيِّعا",34,"ع",2,0],["رَوَّعتَهُ في مَقاماتٍ قَهَرتَ بِها","حَتّى اِعتَراهُ عَلى إِقدامِهِ فَشَلُ",35,"ل",1,0],["روع ادكار البعد ينشره","حب أثار بمهجتي نقعا",36,"ع",2,0],["رَوَّعَت أَحداثُها مِن","هُ فَتىً ما ريعَ جارُه",37,"ر",2,0],["روعتِ مني جريئاً غيرَ ذي فَرَقٍ","واقتدتِ مني عزيزاً غيرَ مُضطهد",38,"د",1,0],["روّعَت هذه التهاويلُ حسّي","فاستوى عندها رجائي ويأسي",39,"ي",1,0],["روّعتْ بالفراقِ قلباً إذا رِي","ع بِذكر الفراق كاد يهيمُ",40,"م",1,0],["روعته من بعد دهر راعني","وسقيته ما كان قبل سقاني",41,"ن",2,0],["روعت كتبه الكتائب فانصا","ع هزيما خميسها والوعيلُ",42,"ل",1,0],["رَوْعاً مِن الجِنِّ وَلا أَنِيسا","أُسْقِيَ نَضّاخَ الصَبَا بَجِيسا",43,"س",2,0],["روعة بالفراق قبل الفراق","شرقت بالدموع منها المآقي",44,"ق",2,1],["رُوعُ الزمانِ أبداً","من وقعِهِ مُرَوَّعُ",45,"ع",1,0],["روعت يا دهر قلبي بالبعاد وكم","قد بات قلبي ولا شيء يروعه",46,"ع",2,0],["روعة الموت تسبيح العصيَّا","وجلال المنون يسبى الكميَّا",47,"ي",2,1],["رُوّعَ الكونِ من جلالٍ عظيم","لم يكن قبلُ عهدُه في الديارِ",48,"ر",1,0],["روعت أرجاء البلا","د ورعت أشتات الفلاه",49,"ا",2,0],["روعة في الحياة تستلب الل","ب وفي الخلد بهجة ورواءُ",50,"ا",2,0],["روّع النّاس بالنّعيّ وصاحوا","يا لها نكبةً يعمّ بلاها",51,"ا",3,0],["روعت أغصان هاتيك الرياض وما","تركت زيتونه تجنى ولا توتا",52,"ت",2,0],["روع يا سَقَام","واقسُ يا سِهَام",53,"م",1,0],["روعت بالغرب الفرنج بوقفة","دوخت ذاك اليوم منها المشرقا",54,"ق",2,0],["روعانة استارها مهتوكة","بعد الحيا والحجب في الخانات",55,"ت",1,0],["روَّعَ المَغربَينِ حِينَ نَعَاهُ","روَّعَ النَّيلَ وَيحَهُ والشَّآمَا",56,"م",2,0],["رَوَّعَ القُدسِ والمدينَةَ والزَّو","رَاءَ والمسجِدَ الشَّرِيفَ الحَرَامَا",56,"م",2,0],["روعتني ببينها","لا رعى الله بينها",57,"ن",3,0],["روعن كل متيم ما راعه","ضرب الحسام وطعنة الخطار",58,"ر",1,0],["روعت أحشاء الزما","ن فراح ينكل عن لقاك",59,"ك",1,0],["روعتما بعدَ السرورِ قلوبنا","اللَه في فرحٍ تحوَّل مأتما",60,"م",2,0],["روعني ببعده فهل كفى","ما ذقته في البعد أم لم يكفه",61,"ف",2,0],["روّعته فوراً تحيةُ إبليس","ولمّا رآه زاد البلاءُ",62,"ا",2,0],["رَوَّع البلادَ ففي","كلّ زَفرةٍ ضرَمُ",63,"م",1,0],["روعة الأمس عهدها ليس ينسى","بالهوى والطبيعة. الخلَّابهْ",64,"ب",2,0],["روعة الفنّ هنا شاهدةٌ","أنّ من أبدعَ من خطّت قديرْ",65,"ر",1,0],["رَوَّعْتُمَا بِالدَّمْعِ مِرْآتِي الَّتِيْ","صَرَخَتْ بِحُرْقَةِ وَالِهٍ : مَنْ أَنتُمَا؟!",66,"م",2,0],["رَوْعَةٌ هَذِهِ الرُّبُوْعُ جَمَالٌ","وظِلالٌ وأَيْكَةٌ وَ خَمِيْلُ",67,"ل",1,0],["رَوْعَةُ اللَّيْلِ نَسْمَةٌ وَ حَفِيْفُ","وَ كُؤُوْسٌ وعَاشِقٌ وَ أَلِيْفُ",68,"ف",1,1],["رَوْعٌ تَرَاءَى فِيْ رُؤَى الكَاسِ انْتَهَى","فَأذَاقَنِي سُمًّا لَظَاهُ وَعَلْقَمَا",69,"م",2,0],["رَوْعَةُ الأَفْنَانِ الْتُغَلِّفُ فَنِّي","دَالِيَاتٌ تَلْتَفُّ فِيِهَا الْخُمُورُ",70,"ر",1,0],["رَوْع