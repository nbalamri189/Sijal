/ViewPoem.aspx?id=124960",""],[466,"لقد علمت زوراء دجلة أنني","https://www.poetsgate.com/ViewPoem.aspx?id=38054",""],[5751,"مممم فيسبوكية","https://www.poetsgate.com/ViewPoem.aspx?id=215027",""],[5784,"قسم","https://www.poetsgate.com/ViewPoem.aspx?id=194605",""],[5785,"يا من يغير البدر جنح الأسحار","https://www.poetsgate.com/ViewPoem.aspx?id=131577",""],[5975,"وداعاً","https://www.poetsgate.com/ViewPoem.aspx?id=52976",""],[6031,"سَلاَمٌ إذَا استَعْبَقْتَ رَيَّاهُ أُجلِيَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=46402",""],[6068,"يودّ القلب لقياكم فلمّا -07-","https://www.poetsgate.com/ViewPoem.aspx?id=175887",""],[6082,"نبض اخير","https://www.poetsgate.com/ViewPoem.aspx?id=59137",""],[186,"نسيمات نجد هل تحملت من نجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55747&r=&rc=10",""],[6225,"شكوى وأمل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78024&r=&rc=109",""],[6259,"سقى دمعي الأحبَّة َ حيث ساروا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59414&r=&rc=62",""],[422,"وميضُ البرق هيَّج منك وجدا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22245&r=&rc=1",""],[557,"أحزان مصر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67203&r=&rc=65",""],[572,"جاءَتْ بعودٍ مثلِهَا نافرٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9384&r=&rc=241",""]],"verses":[["يُؤَدّي أُشَيعَثَ جَمَّ الهُمومِ","حَراماً يُزاوِلُ أَرضاً حَراما",0,"م",2,0],["يَوَدُّ لَو أَصبَحَ شِسعاً لَها","نِجادُ عُنقِ المَلِكِ الأَعظَمِ",1,"م",1,0],["يَوَدّونَ أَن لَو كانَ بَينَ قُلوبِهِم","مَعَ الحِقدِ حَتّى لا تَراهُ المَجامِعُ",2,"ع",1,0],["يوَدُّها الدوْحُ في أغْصانِهِ زهَراً","غضّاً وتحْسِدُها دارينُ في العبَقِ",3,"ق",1,0],["يَوَدّونَ لَو يَثني الوَعيدُ زَماعَنا","وَهَيهاتَ ريحُ الشَوقِ مِن ذاكَ أَعصَفُ",4,"ف",1,0],["يَوَدُّ بِأَن يُمسي سَقيماً لَعَلَّها","إِذا سَمِعَت عَنهُ بِشَكوى تُراسِلُه",5,"ل",2,0],["يود بهاء الصبح لو أنه لها","محياً وغر الزهر لو أنها عقد",6,"د",1,0],["يُؤَدُّونَ مُفْترضاً لِلعُلَى","بِتَكْرِيمِ ذَاكَ العَمِيدِ الكَرِيمِ",7,"م",1,0],["يَوَد الَّذِي أَلْقَى إِلَيْهِ بِسَمْعِهِ","لَوِ الكَوْنُ نَادٍ وَالشهُودُ الْعَوَالِمُ",8,"م",1,0],["يَوَدّونَ أَن لُيُبصِروني سَفاهَةً","وَلَو غِبتُ عَن أَمرٍ تَرَكتُهُمُ سُدى",9,"د",2,0],["يودّ العدى لو بلغوا ما بلغته","وكانَ لهم من عمرك العشر لا الشطر",10,"ر",1,0],["يُودي بحالٍ فحالٍ من شبيبته","تسرُّبَ الماء من مستأنَفِ الكُتَبِ",11,"ب",1,0],["يودُّ الذي لاَقوْهُ أن سلاحه","هنالك خَلْخَالٌ عليه ودُمْلُجُ",12,"ج",1,0],["يودّ الزمانُ المنقضي عنه أنه","عليه لِزامٌ آخرَ الدهر سرمدُ",13,"د",1,0],["يودُّ زمانٌ ينقضي عنْه أنه","عليه إلى أن ينْفَدَ الدهرُ سرمَدُ",14,"د",1,0],["يودُّ الفتى طولَ تعميرهِ","ولا مُتناهيَ إلا قصيرُ",15,"ر",1,1],["يودُّ الورى لو يشترون شهورهم","بأحوال أعوامٍ سواهُم دكائك",16,"ك",1,0],["يودُّ الصبُّ لو أمستْ","بسالفَتَيْه منتعِلَهْ",17,"ل",2,0],["يَوَدّونَ لَو يَفدونَني بِنُفوسِهِم","وَمَثنى الأَواقي وَالقِيانِ النَواهِدِ",18,"د",1,0],["يَوَدُّ الفَتى أَنَّهُ هارِبٌ","وَيَمنَعُهُ الخَوفُ أَن يَهرُبا",19,"ب",2,0],["يَوَدُّ الطامِعونَ بِأَرضِ مِصرٍ","لَو أَنَّهُم بِها أَبَداً أَقاموا",20,"م",3,0],["يَوَدُّ الناسُ لَو هَلَكوا جَميعاً","لِيَحجِبَهُم عَنِ الدُنيا اللُحودُ",21,"د",1,0],["يَوَدُّ الفتى لوْ خاضَ عاصِفَةَ الرَّدَى","وصَدَّ الخميسَ المَجْرَ والأَسَدَ الوَرْدا",22,"د",2,1],["يودّ الناس لو يدور","ن ما أنتَ كيمورا",23,"ر",2,1],["يودّ الليل لو ندنو كلانا","ويدخر النهار لنا التهاني",24,"ن",2,0],["يودّ من الأرواح ما لا تودّه","ويفتك فيها مسرفا وهي جنده",25,"د",2,1],["يُوَدِّعونَ عَلى بُعدٍ دِيارَهُمُ","وَيَنشِدونَ بُنَيّاتٍ وَصِبيانا",26,"ن",2,0],["يَوَدُّ سِباعُ الوحش والطيرِ أنّه","يُفَدَّى بأنيابٍ لها ومخالبِ",27,"ب",1,0],["يُؤَدّونَ التَحِيَّةَ مِن بَعيدٍ","إِلى قَمَرٍ مِنَ الإيوانِ بادِ",28,"د",1,0],["يَوَدُّ رِجالٌ أَنَّني كُنتُ بَعضَ مَن","طَوَتهُ المَنايا لا أَروحُ وَلا أَغدو",29,"د",2,0],["يَوَدُّ الرَدى لَكَ كانَ الرَدى","بِهِ وَوَقَيناكَ فَقدَ الفَقيدِ",30,"د",1,0],["يُؤَدّي إِلى بُعدِ المَدى سَبقَ بالِغٍ","إِذا اِستَشرَفوا مِنهُ دُنُوَّ مُشارِفِ",31,"ف",1,0],["يَوَدُّ العِدى لَو كُنتَ سالِكُ سُبلِهِم","وَأَينَ بِناءُ المُعلِياتِ مِنَ الهَدمِ",32,"م",1,0],["يَوَدُّ في أَهلِ وَدّانَ الدُنُوَّ وَهَل","يُدني هَوىً وُدُّهُ في أَهلِ وَدّانا",33,"ن",2,0],["يُؤَدّى بِها عَنهُم خَراجٌ وَإِنَّهُم","لِجُروَةَ كانوا جُنَّحاً لِلضَرائِبِ",34,"ب",1,0],["يَوَدَّ لَكَ الأَدنَونَ لَو مُتَّ قَبلَها","يَرَونَ بِها شَرّاً عَلَيكَ مِنَ القَتلِ",35,"ل",1,0],["يُؤَدّي إِلَيهِ الخَرجَ مَن كانَ مُشرِكاً","وَيَرضى بِهِ مَن كانَ لِلَّهِ مُسلِما",36,"م",2,0],["يَوَدُّكَ فيه مَنْ تَقضي عليه","لشافي الحُكمِ أو كافي الصَّوابِ",37,"ب",1,0],["يَوَدُّ يُمسي عِرضُهُ مُطلَقاً","وَمالُهُ المَوفورُ في حَبسِ",38,"س",1,0],["يَوَدُّ باغي النَدى لَو نالَ بُلغَتَهُ","حَتّى إِذا حَلَّ في أَفنائِهِ اِقتَرَحا",39,"ح",2,0],["يَوَدُّ وِداداً أَنَّ أَعضاءَ جِسمِهِ","إِذا أُنشِدَت شَوقاً إِلَيها مَسامِعُ",40,"ع",1,0],["يَوَدُّ رِجالٌ أَنَّني كُنتُ مُفحَماً","وَلَولا خِصامي لَم يَوَدّوا الَّذي وَدّوا",41,"د",3,0],["يَوَدُّ الْفَتَى فِي كُلِّ يَوْمٍ لُبَانَةً","فَإِنْ نَالَهَا أَنْحَى لأُخْرَى وَصَمَّمَا",42,"م",2,0],["يُوَدِّعُ بَعضُنا بَعضا","وَكُلٌّ بِالهَوى صَرَحا",43,"ح",2,0],["يَودُّ لوِ اسْتَقلَّ بكلِّ شَعبٍ","على الغبراءِ يَجعلهُ طعاما",44,"م",2,0],["يَودُّ رجالٌ غرَّهم باطلُ المُنَى","لو اتّبعوا الرأيَ الذي كان أحزما",45,"م",2,0],["يُؤدُّونَها من خِيفَةِ القتلِ جِزْيَةً","على الهُونِ ممّا يرزقُ الحَبُّ والتَّمْرُ",46,"ر",1,0],["يودي الرَدى بِمُسالِمٍ وَمُحارِبٍ","يُقوي الكِناسُ وَتُقفِرُ الآجامُ",47,"م",1,0],["يُؤَدّى إِلَيهِ أَنَّ كُلَّ ثَنِيَّةٍ","تَيَمَّمَها تَرمي إِلَيهِ بِقاتِلِ",48,"ل",1,0],["يودَعنَ أَمثالَ السُرَر","ثُمَّ يَطِرنَ كَالشَرَر",49,"ر",1,0],["يَوَدّونَ لوْ صِيغتْ لهم من حِفاظهمْ","وإقدامهم تلكَ السّيوفُ الصّوارِمُ",50,"م",1,0],["يَوَدُّ هِرقَلُ الرّوم ذو التاج أنّه","يَنالُ الذي نالتْه من شرفِ القدر",51,"ر",1,0],["يَوَدُّ عليٌّ لو يَرى فيهِ ما تَرَى","لِيعلَمَ آيَ النَّصْلِ والصارم الهَبر",51,"ر",1,0],["يُؤَدِّبُكَ الدَهرُ بِالحادِثاتِ","إِذا كانَ شَيخاكَ ما أَدَّبا",52,"ب",2,1],["يَوَدُّ الفَتى أَنَّ الحَياةَ بَسيطَةٌ","وَأَنَّ شَقاءَ العَيشَ لَيسَ يَبيدُ",53,"د",1,1],["يَوَدُّ ثَباتاً عَلى ظَهرِهِ","وَتَدعو الخُطوبُ أَلّا تَنزِلُ",54,"ل",1,0],["يَوَدُّ أَنَّ دُجاهُ فارُ خابِيَةٍ","وَأَنَّ كُلَّ غَمامٍ بِالعُقارِ هَتَل",55,"ل",1,0],["يَوُدّانِ إِكراماً لَوِ اِنتَعَلَ السُهى","وَإِنّ حَذِيا السَلّاءَ وَاِنتَعَلاهُ",56,"ل",3,0],["يُؤَدّي إِلى مَن فَوقَهُ رِزقَ رَبِّهِ","أَميناً وَيُعطي الصَونَ مُحتَجِبيهِ",57,"ب",3,0],["يُوَدُّ الفَتى لَو عاشَ آخِرَ دَهرِهِ","سَليماً مُؤَتّى لا أُميتَ وَلا رُزي",58,"ز",2,0],["يَوَدّ التّبْرُ لو أمْسَى حَديداً","إذا حُذِيَ الحَديدُ له نِعالا",59,"ل",2,0],["يَوَدّ أنّ ظَلامَ اللّيْلِ دامَ له","وزِيدَ فيهِ سَوَادُ القَلْبِ والبَصَرِ",60,"ر",1,0],["يودُّ وِداداً كلَّ عضوٍ ومفصلٍ","لمبصرها لو أنَّه كان أبصرا",61,"ر",2,0],["يودُّونَ أنَّ الصبحَ ليلٌ عليهمُ","ونحن نودُّ الليلَ لو أَنَّه صُبْحُ",62,"ح",1,0],["يودي بما يَلقاه من","غث هنالك أَو سَقيم",63,"م",1,0],["يودي الفَتى من حيث يسلم غيره","ما لِلسَلامة منهج مطروق",64,"ق",1,0],["يود من سيم خسفاً","لَو اِستَطاع اِنتقاما",65,"م",2,0],["يود العلى والحق أَنَّك كلما","تقابل أعداء السلامة تظهر",66,"ر",1,0],["يَوَدُّ الفَتى مَنْهَلاً خالِياً","وسَعْدُ المَنِيَّةِ في كُلِّ وادِ",67,"د",1,0],["يَوَدُّ الْفَتَى أَلَّا يَزَالَ بِنِعْمَةٍ","وَلَيْسَ لَهُ مِنْ صَوْلَةِ الدَّهْرِ مَخْلَصُ",68,"ص",1,0],["يَوَدُّ الْفَتَى أَنْ يَجْمَعَ الأَرْضَ كُلَّهَا","إِلَيْهِ وَلَمَّا يَدْرِ مَا اللهُ صَانِعُ",69,"ع",1,0],["يَوَدُّ الْفَتَى ما لا يَكُونُ طَمَاعَةً","وَلَمْ يَدْرِ أَنَّ الدَّهْرَ بِالنَّاسِ قُلَّبُ",70,"ب",1,0],["يُودِي الْفَصِيْحُ مِنَ اللُّغَا","تِ إِذَا غَفَا عَنْهُ الرَّقِيبُ",71,"ب",1,0],["يوَدُّ قومٌ ذوو عِزٌّ لو أنهُم","همُ الخنازيرُ كي ينجوا أو الضبعُ",72,"ع",1,0],["يَوَدُّ لَوَ أنّ الغِيدَ ضَمَّتْ شُعورَها","إِلى شَعْرِهِ الدَّاجِي فطَالتْ غَدَائِرُه",73,"ر",2,0],["يودّ لو ما بين فخذيه","إحدى يديه ، خاتما أو سوار",74,"ر",1,0],["يودّ لو كفّاه ، أشهى صدى","لمعزف ، لو مقلتاه (هزار)",74,"ر",1,0],["يود أن يهوى فيخبو الهوى","ويشتهي ينسى فلا يقوى",75,"و",2,0],["يَوَدُّ من \" التِّيهِ !\" لو أنَّه","يَشُدُّ بها \" جَرَساً ! \" إنْ مشى",76,"ا",1,0],["يودونَ أنْ لا يبصروني ، سفاهة ً","، وَلَوْ غِبتُ عن أمرٍ ت