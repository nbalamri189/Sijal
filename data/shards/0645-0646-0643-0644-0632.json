{"poems":[[91,"من كل زهر قد جمعت قليلا","https://www.aldiwan.net/poem44606.html","الكامل"],[87,"أهل القدود التي صالت عواليها","https://www.aldiwan.net/poem62992.html","البسيط"],[47,"ليت الخليط الذي قد بان لم يبن","https://www.aldiwan.net/poem66670.html","البسيط"],[46,"رقت حواشي الدهر فهي تمرمر","https://www.aldiwan.net/poem30510.html","الكامل"],[113,"أميرنا لا برحت في رتب","https://www.aldiwan.net/poem16298.html","المنسرح"],[309,"يا رحمة الله زوري","https://www.aldiwan.net/poem16858.html","المجتث"],[422,"يا منزل السادة الأشراف قد نزلت","https://www.aldiwan.net/poem53819.html","البسيط"],[438,"أقبل بوجهك إني عنك منصرف","https://www.aldiwan.net/poem12318.html","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64576","الرجز"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130773","الكامل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100196","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108043","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109950","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216781","الرجز"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/90021","السريع"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202343","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90822","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73094","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35108","البسيط"],[5190,"الشراع","https://www.poetsgate.com/ViewPoem.aspx?id=119535",""],[5751,"قُبْلةٌ بَينَ عَينَيكْ","https://www.poetsgate.com/ViewPoem.aspx?id=214767",""]],"verses":[["من كل زهر قد جمعت قليلا","وجعلت منه لقبره إكليلا",0,"ل",2,1],["مِن كُلِّ زَهراءَ في إِشراقِها ضَحِكَت","لَبّاتُها عَن شَبيهِ الدُرِّ مِن فيها",1,"ي",3,0],["مِن كُلِّ زَهراءَ كَالنُوّارِ مُشرِقَةٍ","أَبقى عَلى الزَمَنِ الباقي مِنَ الزَمَنِ",2,"ن",1,0],["مِن كُلِّ زائِرَةٍ تَرَقرَقُ بِالنَدى","فَكَأَنَّها عَينٌ عَلَيهِ تَحَدَّرُ",3,"ر",1,0],["مِن كُلِ زُمر إِذا بَعَثت بِهِ","قامَ بِهِ في العِداة مُعتَرك",4,"ك",1,0],["من كل زوج ونوع","من رائق وكثير",5,"ر",1,0],["من كلِّ زَوج بهيج أنبتت ورَبَت","لتنعش الروح في رَوح وريحان",6,"ن",1,0],["مِنْ كُلِّ زاهرةِ الأَرجاءِ لو بَصَرَتْ","بها الغوادِي لقالَتْ رَوْضَةٌ أُنُفُ",7,"ف",1,0],["من كل زلة وكل فرطه","إن يكن استغفار ربي حطه",8,"ه",1,0],["من كل زاهية الاهاب مليحةٍ","ترمي بها في اللوثة الخُيلاء",9,"ا",2,0],["من كل زاكية حصان الذيل ما","ألفت سوى التخدير والتحصين",10,"ن",1,0],["من كل زفرة المعيٍّ صعدت","تسوى ردىً في موت آخر قاحما",11,"م",2,0],["من كل زاكي النبعتينِ مكمَّلٍ","طبعاً بفضل اللَه قبلاً يولدُ",12,"د",1,0],["من كل زهر ناضر الرواء","والزهر لا ينضر في الشتاء",13,"ا",2,0],["من كل زهراء خلوقية","تجمع بين النهد والسُرّه",14,"ه",1,0],["من كل زهراء لا تفنى على هرم","تزري بشعر زهير في الفتى هرم",15,"م",1,0],["من كل زاهي المحيا في أسرته","نور الصباحة وضاح الجبين سري",16,"ر",2,0],["من كلِّ زائدةِ الجَمالِ وَوَجهُهَا","لِضيائهِ الشَّمسُ الُمنيرةُ تَسجُدُ",17,"د",1,0],["مِن كُلِّ زَهراءَ لَم تُرفَع ذُؤابَتُها","لَيلاً لِسارٍ وَلَم تُشبَب لِمَقرورِ",18,"ر",1,0],["\\\" مِنْ كُلِّ زَوْجَيْنِ \\\" قَالَ اْحمِلْ ، وسَيَّرَهَا","فِي اليَمَّ بَيْنَ اْستِغَاثَاتٍ وأَفرَاحِ",19,"ح",1,0],["مِنْ كُلِّ زَوْجينِ ، العَداءُ يَنوشُهُ ،","ويُقيمُ في عَيْنَيهِ صُبْحٌ أعْزَلُ !!",20,"ل",1,0]]}