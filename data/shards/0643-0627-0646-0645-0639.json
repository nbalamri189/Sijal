{"poems":[[55,"أين الغزال الماطل","https://www.aldiwan.net/poem29906.html","مجزوء الرجز"],[74,"تصرمت الأيام دون وصالك","https://www.aldiwan.net/poem19437.html","الطويل"],[47,"عاود القلب بثه وخباله","https://www.aldiwan.net/poem65603.html","الخفيف"],[51,"تولت جدة الدنيا","https://www.aldiwan.net/poem65374.html","الهزج"],[35,"ألا إن ليلى العامرية أصبحت","https://www.aldiwan.net/poem25840.html","الطويل"],[77,"أليلتنا إذ أرسلت واردا وحفا","https://www.aldiwan.net/poem69061.html","الطويل"],[50,"ألم تربع على الطلل الطماس","https://www.aldiwan.net/poem64337.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42684","السريع"],[119,"لقد طال للركب المجد تلفتي","https://www.aldiwan.net/poem41193.html","عموديه"],[234,"نظرت إلى النيل في مده","https://www.aldiwan.net/poem50972.html","المتقارب"],[302,"سرت نفحة من حيهم بسلام","https://www.aldiwan.net/poem33168.html","الطويل"],[302,"أحباي أما الود مني فراسخ","https://www.aldiwan.net/poem33295.html","الطويل"],[369,"كأنك بالأحباب قد جددوا العهدا","https://www.aldiwan.net/poem60961.html","الطويل"],[384,"كأن معكف الصورين منها","https://www.aldiwan.net/poem4592.html","الوافر"],[463,"سقى دارها بالرقمتين وحياها","https://www.aldiwan.net/poem55818.html","الطويل"],[463,"أما لنجوم ليلك بالمصلى","https://www.aldiwan.net/poem56087.html","الوافر"],[469,"معاليك أعلى أن يحيط بها الوصف","https://www.aldiwan.net/poem3294.html","عموديه"],[556,"كأن معقري مهج كرام","https://www.aldiwan.net/poem47728.html","الوافر"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129518","الطويل"],[1056,"","https://poetry.dctabudhabi.ae/diwan/poem/178042","الوافر"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42463","الطويل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137952",""],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109441","البسيط"],[2365,"","https://poetry.dctabudhabi.ae/diwan/poem/34716","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93569","الرجز"],[2583,"","https://poetry.dctabudhabi.ae/diwan/poem/128097","الرمل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112625","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89069","السريع"],[3665,"","https://poetry.dctabudhabi.ae/diwan/poem/34712","الخفيف"],[4604,"","https://poetry.dctabudhabi.ae/diwan/poem/113018","الرمل"],[4915,"اهجريني","https://www.poetsgate.com/ViewPoem.aspx?id=211398",""],[5213,"تضوع من شذا اسلمبول مسك","https://www.poetsgate.com/ViewPoem.aspx?id=170474",""],[5246,"عتاب الأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=187064",""],[6002,"هلا عجبت وكيف ينقضي العجب","https://www.poetsgate.com/ViewPoem.aspx?id=210295",""]],"verses":[["كَأَنَّ مَعروضَ القَنا","يَنقُلُهُ الصَواهِلُ",0,"ل",1,0],["كأنَّ معانيها كواعب تنجلي","على حبكِ الإدراج فوق آرائك",1,"ك",1,0],["كانَ مَعروفُهُ المُقَدَّمُ قَولاً","فَقَفا القَولَ مِن قَريبِ فَعالُه",2,"ل",2,0],["كأن معالم الخيرا","ت قد سُدّت لها الطُرقُ",3,"ق",1,0],["كَأَنَّ مَعَ الرَكبِ الَّذينَ اِغتَدوا بِها","غَمامَةُ صَيفٍ زَعزَعَتها شَمالُها",4,"ل",3,0],["كأنّ مُعلَّى قُطبِها فارسٌ لَهُ","لِواءانِ مركوزانِ قد كرِه الزحفا",5,"ف",2,0],["كَأَنَّ مَعاقِدَ الأَوضاحِ مِنها","بِجيدِ أَغَنَّ نُوِّمَ في الكِناسِ",6,"س",1,0],["كَانَ مَعِي ثُمَّ دَعَاهُ الْهَوَى","فَمَرَّ بِالْحَيِّ وَلم يَرْجَعِ",7,"ع",1,0],["كأن معاني ذكرهم في مسامعي","الى الذوق تدلي سكرة بعد سكرة",8,"ه",1,0],["كأن معاطفَ أمواجِه","معاطفُ جاريةٍ ترقصُ",9,"ص",1,0],["كأَنَّ معانيها بحالِكِ نِقسها","بدورُ تَمام في بهيم ظَلامِ",10,"م",1,0],["كأَنَّ مُعلّى القُطب فارسُ حومة","علا قِرنَه في مُلتَقى الكرِّ شامخُ",11,"خ",1,0],["كأنّ مَعاجَ العيسِ من بطنِ وَجْرةٍ","وقد طَفِقتْ تَصطادُ غِزلانُه الأُسدا",12,"د",2,0],["كأن معكف الصورين منها","اذا حسرت كروم أو جبال",13,"ل",1,1],["كأنّ مُعَنِّيها لمجدٍ أراحها","ومفقِرَها في طاعةِ الجودِ أغناها",14,"ا",3,0],["كأنَّ معالم الأحبابِ فيه","سطورُ ملهوجٍ والدارُ رِقُّ",15,"ق",1,0],["كأنَّ معانيهِ فوارسُ بهمةِ","تلاقي عداهُ والحروفُ لها زعف",16,"ف",1,0],["كأنّ مُعَقِّرِي مُهَجٍ كرامٍ","هنالك يعقِرون بها العِباطا",17,"ط",2,1],["كأن معانيها خلال سطورها","خرائد تجلى تحت شعر مجعد",18,"د",1,0],["كأن معتقاً من أذرعات","بماء سحابة خصرٍ فضيض",19,"ض",1,0],["كأنَّ معانيهِ النجومُ وقد بدا","لهُ في سماءِ القلب مِن لُطفها سِبْحُ",20,"ح",1,0],["كان معبودَ الاقدمين ولا ينف","فكُّ معشوق اهل هذا الاوانِ",21,"ن",1,0],["كأن معناه روضٌ حامل ثمرا","بالذوق يعرف والإدراك أطيبه",22,"ب",2,0],["كَأَنَّ مَعاوِلَ الحَ","دّادِ توعيها مَناقِرُها",23,"ر",3,0],["كانَ معيناً نحتسي بارده","فَبعده لا تبرد الجَوانح",24,"ح",1,1],["كان معشوقاً فأمسى عاشقاً","حكم الحب عليه وله",25,"ه",1,0],["كانَ مَعَ الصفوَةِ من شيعتِهِ","وأهلهِ والغُرُ من أسرَتِه",26,"ه",1,0],["كأن معنى اللفظ من خطه","نور الدراري في ظلام المداد",27,"د",1,0],["كانَ مَع ذا عَدلَ الشَهادَةِ مَقب","ولاً إِذا عَزَّ شاهِداً تَعديلُ",28,"ل",1,0],["كانَ معشوقاً فأمسى عاشِقاً","فقضى الحبُّ عليهِ ولَهُ",29,"ه",1,0],["كانَ معنىً فكانَ حُلماً جميلاً","باتَ شؤماً مُذ باتَ معناهُ شكلا",30,"ل",2,0],["كأن معناه إذا يزهو برق","من المحمود والهادي اعيرا",31,"ر",2,0],["كأن - معاذ الله - فسقاً رأى بنا","فعاقبنا هجراً وما كان عادته",32,"ت",2,0],["كأن معمورها صحراء ما عثرت","عليه إلا يد الأمطار تنسكب",33,"ب",1,0]]}