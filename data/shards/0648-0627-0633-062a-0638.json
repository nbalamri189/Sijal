{"poems":[[280,"إن إمام الحق لا يسأم أن","https://www.aldiwan.net/poem25583.html","الرجز"],[443,"هي بشرى الإسلام والأيام","https://www.aldiwan.net/poem2569.html","الخفيف"],[510,"إلهٌ من نباح","https://www.aldiwan.net/poem42459.html","مخلع البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87217","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48674","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49572","الخفيف"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105428","البسيط"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20379","الخفيف"],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123474","الرجز"],[5206,"حب الله","https://www.poetsgate.com/ViewPoem.aspx?id=187390",""],[5464,"حكاية في ليل بهيّ","https://www.poetsgate.com/ViewPoem.aspx?id=27916",""],[4442,"أنت والسجن صارم وقراب","https://www.poetsgate.com/ViewPoem.aspx?id=171198",""]],"verses":[["واستَظهرَ الدينُ الحَنيفُ والدنَى","بمنْ ظَهيراهُ المَضاءُ والهُدى",0,"د",2,0],["واستظلّت من بعد بعدكم الح","دباء من وحشة بذيل القتام",1,"م",1,0],["واستُظْهِرتْ قصّةُ انتصاري","وزانَ منهاجَهُم كِفاحي",2,"ح",2,0],["وَاِستَظلوا بظله فَاطمأنوا","وَتَوالى سُرورُهم بِعَطاه",3,"ا",2,0],["واستظهروا بالزاخرين ليقطعا","بين الضمائر والهوى ويحولا",4,"ل",2,0],["واستظلَّت من بِرِّه في ظلالٍ","لم يَعِبْها مُنَافقٌ بِنِفَاقِ",5,"ق",1,0],["واستظموه متى يهمز مطمه","على كتائبهم فرت مذاعيرا",6,"ر",2,0],["وَاِستَظَلَّ العُصفورُ كُرهاً مِعَ الضَب","ب وَأَوفى في عودِهِ الحِرباءُ",7,"ا",2,0],["واستظهرت بِبدَعٍ فسوَّدت","تاريخَها مهما حكاهُ مَن حكى",8,"ا",1,0],["واستَظهِرِ اللهَ عَونًا في الرَّحِيلِ عَلى","قَطْعِ الصِّرَاطِ بِلُجبٍ مِنكَ مُعتَدِلِ",9,"ل",1,0],["واسْتَظْرفَتْ آها ً يُخالِط ُجَمْرَها","ماءٌ وهَمْسا ً كادَ أنْ يتَهَدَّجا",10,"ج",2,0],["واستظلت بفيئكم زعماء","واقتفتكم في سيرها الأحزاب",11,"ب",1,0]]}