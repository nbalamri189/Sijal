8,"","https://poetry.dctabudhabi.ae/diwan/poem/141933","الكامل"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12782","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43793","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/204512",""],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10234","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54243","الرمل"],[104,"لك الحمد","https://www.poetsgate.com/ViewPoem.aspx?id=37376",""],[106,"مبايعة الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179496",""],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[103,"قف في ربوع المجد وابك الأزهرا","https://www.poetsgate.com/ViewPoem.aspx?id=1337",""],[23,"بطيبة رسم للرسول","https://www.poetsgate.com/ViewPoem.aspx?id=11422",""],[43,"أقل فعالي بله أكثره مجد","https://www.poetsgate.com/ViewPoem.aspx?id=179",""],[27,"وأَقبَّ كالسِّرحان تم له","https://www.poetsgate.com/ViewPoem.aspx?id=180957",""],[90,"المآسي في حياة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=179158",""],[90,"بشرى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179106",""],[90,"الأحاديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=179020",""],[90,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[45,"لِمَا وَصَلَتْ أسماءُ مِنْ حَبلِنَا شكرُ","https://www.poetsgate.com/ViewPoem.aspx?id=31345",""],[45,"يَهُونُ عَلَيْهَا أنْ أبِيتَ مُتَيَّما","https://www.poetsgate.com/ViewPoem.aspx?id=31883",""],[47,"ألزمني ذنباً بلا ذنبِ","https://www.poetsgate.com/ViewPoem.aspx?id=14734",""],[51,"لعمري لقد غاب الرضا فتطاولتْ","https://www.poetsgate.com/ViewPoem.aspx?id=30457",""],[85,"عظيمُ الناسِ من يبكي العظاما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9653&r=&rc=143",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""],[3,"قفْ بالديار وصحْ إلى بيداها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10775&r=&rc=129",""]],"verses":[["وَأَكتُمُ أَنفاسي إِذا ما ذَكَرتُهُ","وَما كُلُ ما تُخفيهِ يا قَلبُ خافِيا",0,"ي",2,0],["وَأَكثَرُ مَن تَلقاهُ كَالسَيفِ مُرهَفاً","عَلَيكَ وَإِن جَرَّبتَهُ كانَ نابِيا",0,"ي",2,0],["وَأَكرَمُ مَأمولٍ وَأَشرَفُ ماجِدٍ","جَوادٌ مَتى يُندَب إِلى الجودِ يُقدِمِ",1,"م",1,0],["وَأَكبَرُ آمالي مِنَ الدَهرِ أَنَّني","أَكونُ خَلِيّاً لا سُروراً وَلا هَمّا",2,"م",2,0],["وَأَكتُمُ الصُبحَ عَنها وَهيَ غافِلَةٌ","حَتّى تَكَلَّمَ عُصفورٌ عَلى عَلَمِ",3,"م",1,0],["وَأَكثَرُ ما يُلقى بِهِ غِبَّ نَومِهِ","سِقاطُ اللَآلي أَو فُصومُ الخَلاخِلِ",4,"ل",1,0],["وَأَكبَرُ هَمّي أَن أُلاقِيَ فاضِلاً","أُصادِفُ مِنهُ لِلغَليلِ بَلالا",5,"ل",2,0],["وَأَكثَرُ مَن شاوَرتَهُ غَيرُ حازِمٍ","وَأَكثَرُ مَن صاحَبتَ غَيرُ المُوافِقِ",6,"ق",1,0],["وَأَكثَرُ ما تَلقى بِهِ العَينُ أَو تَرى","إِفاضَةُ مَخلوقٍ إِلى قُربِ خالِقِ",6,"ق",1,0],["وَأَكبَرُ ظَنّي أَن أَرى مِنكَ عارِضاً","يُؤَمِّمُها في مِثلِ تِلكَ البَوارِقِ",6,"ق",1,0],["وَأَكُفٍّ مُنفِقاتٍ","في النَدى الغَمرِ عَريقَه",7,"ق",2,0],["وَأُكذِبُ بِالتَصَوُّنِ مُدَّعيهِم","وَأُلجِمُ قائِليهِم بِالعَفافِ",8,"ف",1,0],["وَأَكظِمُ زَفرَةً لَو باتَ يَلقى","بِها أَطواقَها نَفَسي مُحينا",9,"ن",2,0],["وَأُكرِمُ مِن جيرانِهِ كُلَّ طارِئٍ","يَوَدُّ وَداداً أَنَّهُ مِن دَمي يُسقَى",10,"ق",2,0],["وَأَكرَمُ أَخلاقٍ يُدِلُّ بِها الفَتى","عَفافُ مَشوقٍ حينَ يَخلو بِشائِقِ",11,"ق",1,0],["وَأُكرِمُ مَن يأبى العُلا أَن أُجِلُّهُ","وَأَهجُرُ مَن كانَ الخَليلَ المُصافِيا",12,"ي",2,0],["وأكْرَمَ مَثْواها وأمْجَدَها القِرَى","بَنو خَلَفٍ حتى حَطَطْتُ رِحالي",13,"ي",1,0],["وأكْتُمُ ما لو شاع أغرى بيَ العِدا","فبالجِزْعِ أحلامٌ خَفيفٌ حَصاتُها",14,"ت",3,0],["واكْفُفْ شَبا العَينِ الطّموحِ فَدونَ ما","تَسْمو إليهِ بلَحْظِها أقْذاءُ",15,"ا",2,0],["وَأُكرِهُهُ عَلى الأَبطالِ حَتّى","يُرى كَالأُرجُوانِيِّ المَجوبِ",16,"ب",1,0],["وَأَكُرُّ فيهِم في لَهيبِ شُعاعِه","وَأَكونُ أَوَّلَ واقِدٍ بِصَلاها",17,"ا",3,0],["وَأَكونُ أَوَّلَ ضارِبٍ بِمُهَنَّدٍ","يَفري الجَماجِمَ لا يُريدُ سِواها",17,"ا",3,0],["وَأَكونُ أَوَّلَ فارِسٍ يَغشى الوَغى","فَأَقودُ أَوَّلَ فارِسٍ يَغشاها",17,"ا",3,0],["وَأَكتُمُ جُهدي ما أُجِنُّ مِن الهَوى","فَتَنشُرُ ما أُخفي الدُموعُ الهَوامِلُ",18,"ل",1,0],["وَأَكتُمُ سِرَّها ما عِشتُ حَتّى","أَموتَ وَلا أَخونُ وَلا أَحولُ",19,"ل",1,0],["وَأَكثِرُ فيهِمُ ضَحِكي لِيَخفى","فَسِنّي ضاحِكٌ وَالقَلبُ باكِ",20,"ك",1,0],["وَأَكبَرُ حَظّي مِنكِ أَنّي إِذا جَرَت","لِيَ الريحُ مِن تِلقائِكُم أِتَنَشَّقُ",21,"ق",1,0],["واكَبِدي قَد تَقَطَّعَت كَبِدي","مِن كَمَدٍ عادَني عَلى كَمَدِ",22,"د",1,1],["وَأَكتُمُ أَسرارَ الهَوى فَأُميتُها","إِذا باحَ مَزّاحٌ بِهُنَّ بَروقُ",23,"ق",1,0],["وَأَكرَهُ مَن تِجارَتُهُ المَعاصي","وَلَو كُنّا سَواءً في البِضاعَه",24,"ه",1,0],["وَأَكلُ ضَبٍّ وَصَيدُ دُبٍّ","وَصَرفُ حَبٍّ بِأَرضِ خَرسِ",25,"س",1,0],["وَأَكثِر مِنَ الإِخوانِ ما اِسطَعتَ إِنَهُمُ","بُطونٌ إِذا اِستَنجَدتَهُم وَظُهورُ",26,"ر",1,1],["وَاكفِ المُهمَّةَ مَن لَوَ انَّكَ مَرَّةً","نَزَلَت إِلَيكَ مُهِمَّةٌ لَكَفاكَها",27,"ك",3,0],["وَأَكرَمَهُ الأَكفاءُ في كُلِّ مَعشَرٍ","كِرامٍ فَإِن كَذَّبتَني فَاِسأَلِ الأُمَم",28,"م",1,0],["وَاِكتَسى غُصنُكَ مِن أَوراقِهِ","تَحتَ شَمسِ العِزِّ وَالجاهِ الخَصيبِ",29,"ب",1,0],["وَأَكبَرُ ظَنّي أَنَّ يَومَ جَلائِهِم","وَيَومَ نُشورِ الخَلقِ مُقتَرِنانِ",30,"ن",1,0],["وَأُكرَمُ حَتّى كَأَنّي نَبَغَتُ","وَقُمتُ لِمِصرَ بِما قَد وَجَب",31,"ب",1,0],["واكِسُ مَتنَ القِرطاسِ ديباجَ لَفظٍ","يَبهَرُ الفِكرَ مِن نَظيمٍ وَنَثرِ",32,"ر",1,0],["وَأَكتُمُ نَفسي بَعضَ سِرّي تَكَرُّماً","إِذا ما أَضاعَ السِرَّ في الناسِ حامِلُه",33,"ل",2,0],["وَاكْتَسَحَ الآمَالَ مَنْثُورَةً","كَالوَرَقِ السَّاقِطِ عَنْ وَرْدِهِ",34,"د",2,0],["وَأَكَادُ لاَ أُوفِي لَكُمْ شُكْرَانَهَا","لَوْ صُغْتُ آيَاتٍ مِنَ الشُّكْرَانِ",35,"ن",1,0],["وَأَكَادُ لا أُوفِي لَكُمْ شكْرَانَهَا","لَوَصَفْتُ آيَاتٍ مِن الشُّكْرَانِ",36,"ن",1,0],["وَأَكرَهتُ الهِجاءَ عَلى لَئيمٍ","فَلَمّا ذاقَهُ لِلُّؤمِ عافَه",37,"ه",1,1],["وَأَكتُمُ السِرَّ في صَدرِي وَأَخزِنُهُ","حَتّى يكون لذاك القول مُطَّلَعُ",38,"ع",1,0],["وَاِكتَهَلَ النَبتُ بِها وَاِستَأسَدا","وَلَو نَأى ساكِنُها فَأَبعَدا",39,"د",2,0],["وأكرمْ بآيات تحدَّيتَنا بها","ولا مثلُ آياتٍ لمُحْكَمٍ فُرقانِ",40,"ن",1,0],["وأكثر المال حمداً ما يعان به","من عضّهم من نيوب الدهر اقلال",41,"ل",1,0],["وأكبر ما أشكو من القوم أنّهم","يعُدّون تشديد الحجاب من الشرع",42,"ع",1,0],["وأكبر مظلوم هو العلم عندهم","فقد يدّعيه أجهل الجهلاء",43,"ا",2,0],["وأكبر حامل بيد اعتزام","لحُب بلاده عَلَم التَفادي",44,"ي",1,0],["وأكبر ما يدعو القلوبَ إلى الأسى","بكاءُ يتيم جائع حول أيِّم",45,"م",1,0],["وأكره منه أن يكون مُقلِّداً","فيُحشَرَ في الدنيا اسيراً مع الأسرى",46,"ر",2,0],["وَأَكثَرَ ما كانَت رَبيعَةُ أَنَّها","خِباءانِ شَتّى لا أَنيسٌ وَلا قَفرُ",47,"ر",1,0],["وَأَكرَمُ مِن أَبي الخُلُجيِّ رَهطاً","أَغَصَّتهُ أَعَزِّتُنا بِريقِ",48,"ق",1,0],["وَأَكثَرُ زادِهِنَّ وَهُنَّ سُفعٌ","حُطامُ الجِلدِ وَالعَصَبُ المَليلُ",49,"ل",1,0],["وَاِكذِبِ النَفسَ إِذا حَدَّثتَها","إِنَّ صِدقَ النَفسِ يُزري بِالأَمَل",50,"ل",1,0],["وأكثر مأتى المرء من مطمأنه","وأكثر أسباب الرجال كذوبها",51,"ب",3,0],["وَأَكُفُّ عَن سُبُلِ الضَلا","لِ وَأَكتَسي ثَوبَ الوَقارِ",52,"ر",1,0],["وَأَكرَهُ إِعلامَ الوُشاةِ بِهَجرِهِ","فَأَعتِبُهُ سِرّاً وَأَشكُرُهُ جَهرا",53,"ر",2,0],["وَأَكثَرتُ لِلغاراتِ بَيني وَبَينَهُم","بَناتِ البُكَيرِيّاتِ حَولَ المَزاوِدِ",54,"د",1,0],["وَأَكتُمُ الوَجدَ وَقَد أَصبَحَت","عَيناهُ عَينَينِ عَلى القَلبِ",55,"ب",1,0],["وَأَكثَرَ أَن تَلقى إِذا ما أَتَيتَهُم","لَهُم سَيِّداً ضَخمَ الدَسيعَةِ جَحفَلا",56,"ل",2,0],["وَأَكثَرَ حَتّى دَرَّ حَبلُ وَريدِهِ","وَقَصَّرَ عَنهُ في المَقالَةِ وازِعُه",57,"ع",2,0],["وَإِكرامُنا أَضيافُنا وَوَفاؤُنا","بِما كانَ مِن إِلٍّ عَلَينا وَمَوثِقِ",58,"ق",1,0],["وَأَكرَمتُ النِساءَ وَقُلتُ رَهطي","وَهَذا حينَ أَنطِقُ أَو أُبينُ",59,"ن",1,0],["وَأَكرَمَنا اللَهُ الَّذي لَيسَ غَيرَهُ","إِلَهٌ بِرَيّامٍ مَضَت ما لَها شَكلُ",60,"ل",1,0],["وَاِكدَه لِنَفسِكَ لا تُكَلِّف غَيرَها","فَبِدَينِها تُجزى وَعَنها تَدفَعُ",61,"ع",1,0],["وَأَكرَمَ صيتاً في البُيوتِ إِذا اِنتَمى","وَأَكرَمَ جَدّاً أَبطَحيّاً يُسَوَّدُ",62,"د",1,0],["واكتب على بيتِ سكناه العزيز بهِ","عزًّا يدومُ وإقبالاً لصاحبه",63,"ه",1,0],["وأكشف الحجبَ عنها وهي صافيةٌ","لم يبقَ في دنها إلاَّ صُبابات",64,"ت",1,0],["وأكرم به من صائمٍ متخشِّعٍ","تولى فأمسى في الجنان له فطر",65,"ر",1,0],["وأكادُ آكلُ خدّه متجوِّعاً","ممَّا شربت رضابه متعطّشا",66,"ش",2,0],["وأكرم في الأنساب والفضل جمة","وأشرف في الدنيا وفي الدين موضعا",67,"ع",2,0],["وأكاد أصدّق ثم يطمعني بهِ","بشر يغير الدّرّ في الأصداف",68,"ف",1,0],["واكْتم السرّ عن معائب فاهت","فسروري في سرِّها المكتوم",69,"م",1,0],["وأكَّد طول النأي والعسر حيرتي","بتسع شهورٍ قد خلت كلّها حزنا",70,"ن",2,0],["وآكِلُ أطعمةِ الأدنيا","ء رهنٌ بأن يستخفُّوا بِهِ",71,"ب",2,0],["وأكتُمُه وجدي وأُجملُ صبوتي","وأخضع كي يرضى وإن كان مذنبا",72,"ب",2,0],["وأكلاء معروفٍ حُمِيتُ مريعَها","وقد عاد منها السهل والحَزنُ مسْرحا",73,"ح",2,0],["واكْتُبْ إليَّ كأنَّ شِعْرَكَ تُحْفَةٌ","قدْ كُوفِئَتْ أَوْ أَنَّه ذَنْبٌ صُفِحْ",74,"ح",1,0],["واكبدا قد ضَنيتُ فما","أقدِرُ ضعْفاً أقول واكبدي",75,"ي",1,0],["واكتست ثوبَ بياضٍ","ليلُهُ مثلُ النهار",76,"ر",1,0],["وأكثرُ ما يغنّيه فتاهُ","حسينٌ حينَ يخلو بالسرير",77,"ر",1,0],["وأكره للسمحِ اليدين اعتلالَهُ","على صاحبٍ قد عدّه من عيالهِ",78,"ل",2,0],["واكتب على عرضكَ المُلقَّى","قواصد النبل ربِّ سلِّمْ",79,"م",1,0],["وأكرمْ بخصْمٍ باع الطَّوْلِ حقَّه","وآثر حقَّ المجْدِ وهْو مُخاصمُ",80,"م",1,0],["واكسُ شعري من النشيدِ نشيداً","كالغناء المُشذَّراتِ لُحُونه",81,"ن",2,0],["وَأَكرَمَها مَواطِنَ حينَ تُبلى","ضَرائِبُها وَتَختَضِبُ النُحورُ",82,"ر",1,0],["وَأَكمَلَها عَقلاً لَدى كُلِّ مَوطِنٍ","إِذا وُزِنَت فيما يُشَكُّ عُقولُها",83,"ل",3,0],["وَاِكسُ بَني زَيدِ بنِ عَمروٍ نُقَبا","لَيسَت مِنَ البَزِّ وَلَكِن جَرَبا",84,"ب",2,0],["وَأَكثَرَ خَوفي أَن تَظُنّي بَني الوَرى","سَواءً وَهُم مِثلُ النَباتِ ضُروبُ",85,"ب",1,0],["وَأُكفى ما عَلِمتُ بِفَضلِ عِلمٍ","وَأَسأَلُ ذا البَيانِ إِذا عَميتُ",86,"ت",1,0],["وَأَكونُ كَلباً مِثلَهُ","إِن لَم أُصَدِّق ظَنَّهُ",87,"ن",2,0],["وَأَكثَرَ الناسُ فيهِ لَوماً","وَقَلَّ في الحُبِّ فيهِ قِسمي",88,"ي",1,0],["وَأَكرَمُ مِن عَيني عَلَيَّ وَإِنَّها","لَتُظهِرُ سِرّي لِلعِدى وَتُذيعُهُ",89,"ع",2,0],["وَأَكونُ والِيَ سِرِّهِ فَأَصونُهُ","حَتّى يَحينَ عَلَيَّ وَقتُ أَدائِهِ",90,"ا",3,0],["وأكلْنا التُّرابَ حتَّى مَلِلْنا","وشَربْنا الدُّموعَ حتَّى رَوِينا",91,"ن",2,0],["وأكبر ما في نفس سعد أمانة","إلى النيل منها لم يصل كيد كائد",92,"د",1,0],["واكبر خصم للعروبة ولدها","فيا اسفي في كل يوم على العرب",93,"ب",1,0],["واكثر اخبار الجرائد ظلمة","ولكنما الشورى لنا ترسل النورا",94,"ر",2,0],["وأكثرُ بخسا للفضيلة موقع","يجادل أهل العلم فيه جَهول",95,"ل",1,0],["وأكمل معدود أنفاسه","وكانت تردّد فيهِ وتجهد",96,"د",1,0],["وأكثر من في الأرض يعصون ربهم","أولئك في الأخرى عذابهم الهون",97,"ن",1,0],["وَأَكرَمُ مِن غَمامٍ عِندَ مَحلٍ","فَتىً يُحيِ بِمِدحَتِهِ الكِراما",98,"م",2,0],["وَأَكَنَّتِ الفَنَّ الجَميلَ خَميلَةٌ","رَمَتِ الظِلالَ وَمَدَّتِ الأَفياءَ",99,"ا",2,0],["وَأَكثَرُهُم لَها وَقَفاتِ صِدقٍ","إِباءً في الحَوادِثِ أَو زِماعا",100,"ع",2,0],["وَاِكفِ جَفنَيَّ دافِقاً لَيسَ يَرقا","وَاِكفِ جَنبَيَّ خافِقاً لَيسَ يَهدا",101,"د",2,0],["وَأَكرَهُ مِن ذُبابِ السَيفِ طَعماً","وَأَمضى في الأُمورِ مِنَ القَضاءِ",102,"ا",2,0],["وَأَكرَمَ الناسِ لا مُستَثنِياً أَحَداً","مِنَ الكِرامِ سِوى آبائِكَ النُجُبِ",103,"ب",1,0],["وَأَكرَمُهُم كَلبٌ وَأَبصَرُهُم عَمٍ","وَأَسهَدُهُم فَهدٌ وَأَشجَعُهُم قِردُ",104,"د",1,0],["وَأَكبِرُ نَفسي عَن جَزاءٍ بِغيبَةٍ","وَكُلُّ اِغتِيابٍ جُهدُ مَن مالُهُ جُهدُ",104,"د",1,0],["وَأَكبَرَ مِنهُ هِمَّةً بَعَثَت بِهِ","إِلَيكَ العِدى وَاِستَنظَرَتهُ الجَحافِلُ",105,"ل",1,0],["وَأَكبَرُ تيهي أَنَّني بِكَ واثِقٌ","وَأَكثَرُ مالي أَنَّني لَكَ آمِلُ",105,"ل",1,0],["وَأَكثَرُ مِن بَعدِ الأَيادي أَيادِياً","مِنَ القَطرِ بَعدَ القَطرِ وَالوَبلُ مُثجِمُ",106,"م",1,0],["وَأَكثَرَ في مَجالِسِهِ اِستِماعاً","فُلانٌ دَقَّ رُمحاً في فُلانِ",107,"ن",1,0],["وأكفُرُ يا كافورُ حين تلوحُ لي","ففارَقتُ مُذ فارقتُكَ الشركَ والكُفرا",108,"ر",2,0],["واكشف غطاءك حين يبرد ما","في جوفه وتجنّبِ الحرقا",109,"ق",2,0],["وأكثرُ الناس من يُشقَى بصحبتِه","ومصطَلِي النارِ لا يخلو من الشَّررِ",110,"ر",1,0],["وأكبرُ عيبٍ في الليالي حُؤولُها","سريعاً وإن كانت كثيراً عيوبُها",111,"ب",3,0],["وأكُرُّ حيثُ السيفُ فوقَ جماجمي","والموتُ حدُّ سِنانِه مذروبُ",112,"ب",1,0],["وَأَكثَرتُ مِن شَكوى هَواها وَإِنَّما","أَمارَةُ بَرحِ الحُبِّ أَن تَكثُرَ الشَكوى",113,"و",2,0],["وَأَكرَهُ أَن أَتَمادى عَلى","سَبيلِ اِغتِرارٍ فَأَلقى شُعوبا",114,"ب",2,0],["وَأَكسَفَ اللَهُ بالَ الكاشِحينَ عَلى","وَعدٍ وَأَبطَلَ ما قالوا وَما كَذَبوا",115,"ب",3,0],["وَأَكلَكَ مِن قوتِ أَهلِ الحُبوسِ","وَلُبسَكَ مِن سَلَبِ الكَعبَه",116,"ب",2,0],["وَأَكذَبُ مِن مُسَيلَمَةَ بنِ صَعبٍ","وَأَفضَحُ في العَشيرَةِ مِن سَجاحِ",117,"ح",1,0],["وَأَكثَرُ ما لِسائِلِهِم لَدَيهِم","إِذا ما جاءَ قَولُهُمُ تَعودُ",118,"د",1,0],["وَأَكرِم بِغَرسٍ هَؤُلاءِ أُصولُهُ","وَأَعظِم بِبَيتٍ هَؤُلاءِ قَواعِدُه",119,"د",2,0],["وَأَكرَمُ ذُخري حُسنُ رَأيِكَ إِنَّهُ","طَريفي الَّذي آوي إِلَيهِ وَتالِدي",120,"د",2,0],["وَأُكبَرُ أَن أُشَبَّهَ جودَ فَتحٍ","بِصَوبِ غَمامَةٍ أَو سَيلِ وادِ",121,"د",1,0],["وَأَكثَرُهُم يَهوى الإِضافَةَ كَي يُرى","لَهُ في الَّذي يَأتيهِ مِن طَبَعٍ عُذرُ",122,"ر",1,0],["وَأُكرومَةٍ جَلّى أَبو الصَقرِ طامِحاً","إِلَيها كَما جَلّى طَريدَتَهُ الصَقرُ",122,"ر",1,0],["وَأَكثَرتُ غِشيانَ المَقابِرِ زائِراً","عَلِيَّ بنِ يَحيى جارَ أَهلِ المَقابِرِ",123,"ر",1,1],["وَاِكتَنى بِاِسمِكَ الرَشيدُ لِعِلمٍ","بِكَ ماضٍ وَجَدُّكَ المَنصورُ",124,"ر",1,0],["وَأَكسَبتَني شُغلاً عَنِ الوَصلِ شاغِلاً","تُعاتِبُني فيهِ وَتَعتَدُّهُ هَجرا",125,"ر",2,0],["وَاِكتَسَت وَجنَتاهُ وَرداً جَنِيّاً","وَاِكتَسى جِسمُهُ غَلائِلَ خَمرِ",126,"ر",1,0],["وَأَكثَرُ مايُهدي خَفِيّاً مُسَتَّراً","كَثيرُ التَجَنّي وَالتَعَتُّبِ مُسرِفُ",127,"ف",1,0],["وَأَكثَرتَ زادي مِن بُدورٍ تَتابَعَت","بِجودِكَ فيهِنَّ اللُجَينُ المُطَرَّقُ",128,"ق",1,0],["وَأَكثَرُ فِتيانِ الزَمانِ أَراذِلٌ","مَوازينُهُم في السَروِ غَيرُ ثِقالِ",129,"ل",1,0],["وَأَكسَبَني سُخطَ اِمرِئٍ بِتُّ مَوهِناً","أَرى سُخطَهُ لَيلاً مَعَ اللَيلِ مُظلِما",130,"م",2,0],["وَأَكبَرُ ظَنّي أَنَّكَ المَرءُ لَم تَكُن","تُحَلِّلُ بِالظَنِّ الذِمامَ المُحَرَّما",130,"م",2,0],["وَأَكَلتَ ما ذَخَرَت لِنَفسِكَ دونَها","وَالجَدبُ فيهِ تَفاضَلُ الأَبرارُ",131,"ر",1,0],["وَأَكوي خَياشيمَ الصُداعِ وَأَبتَغي","مَجامِعَ داءِ الرَأسِ مِن حَيثُ يَنقَعُ",132,"ع",1,0],["وأُكبِرُ أن يُبكى على صاحبٍ دَماً","إلى أن بكَت عيني لِفُرقتِه دَما",133,"م",2,0],["وأكثرُ ما أقولُ سقَى ابنَ فَهْدٍ","حياً كَنَداه مُنْحَلَّ النِّطاقِ",134,"ق",1,0],["وَأَكَلتُ أَجساداً مُنَعَّمَةً","كانَ النَعيمُ يَهُزُّها نَضِرَه",135,"ر",2,0],["واكُثرَ أَكثَرِ مَن تَرى","وَأَقَلُهُم أَهلُ الوَفاءِ",136,"ا",2,0],["وَأَكثَرتُ تَذكاري لِحَزوى وَرامَةٍ","وَما رامَةٌ لَولا هَواكَ وَما حَزوى",137,"و",2,0],["وَأَكسَبَني قَومي وَأَعيانُ مَعشَري","حِفاظَ المَعالي وَاِبتِذالَ الرَغائِبِ",138,"ب",1,0],["وَاكتسى في ثرىً تغيّبَ فيه","صدأً ذلكَ الجبينُ الصقيلُ",139,"ل",1,0],["وأكثر ما تَرْوي السيوفُ الَّتي نضا","بها من عقولِ الناس فتحَ المعاقِلِ",140,"ل",1,0],["واكتَسَتْ زُرقَةُ السَّماءِ سَحاباً","مُسمِعاً رعدُهُ هديرَ الفنيقِ",141,"ق",1,0],["وأكلف منْسَرُهُ ذو شغا","كعطفةِ رأس السنان الذّليق",142,"ق",1,1],["وأَكبَرُ يَأوي مِن ذُؤابَةِ يَعرُبٍ","إِلى ذَروَةِ البَيتِ الرّفيعِ القَواعِدِ",143,"د",1,0],["واكَبِدي يوشِكُ الرَقيبُ بِأَن","يَمنَعُني أَن أَقولَ واكَبِدي",144,"د",2,0],["وَأَكثَرُ حالاتِ اِبنِ آدَمَ خِلقَةٌ","يَضِلُّ إِذا فَكَّرتَ في كُنهِها الفِكرُ",145,"ر",1,0],["وَاِكتَسَت ضُمَّرُ الجِيادِ المَذاكي","مِن لِباسِ الهَيجا دَماً وَحَميما",146,"م",2,0],["وَأَكونُ عِندَ ظُنونِ طُلّابِ النَدى","وَأَذُبُّ عَن شَرَفي بِما مَلَكَت يَدي",147,"د",2,0],["وَأَكْثَرُ الْخَلْقِ مَطْبُوعٌ عَلَى ظِنَنٍ","تَقْضِي عَلَيْهِ بِلَبْسِ الْحَقِّ أَحْيَانَا",148,"ن",2,0],["واكتمِ الأمرينِ فقراً وغنىً","واكسبِ الفلسَ وحاسبْ مَنْ بَطَلْ",149,"ل",1,0],["واكحلْ جفونَكَ مِنْ ثراها وابتهجْ","بسنا نبيٍّ ما أعزَّ وأبهجا",150,"ج",2,0],["واكتسابُ الغنى بنظمٍ ونثرٍ","فيه نقصٌ للفاضلِ المشهورِ",151,"ر",1,0],["وَأُكرِمُها مِن أَن تَرى بَعضَ شِدَّةٍ","وَتُبدي مَواعيدَ المُنى وَالتَعَلُّلا",152,"ل",2,0],["وَأُكَذِّب كاشِحاً إِن أَتاني","وَتُصَدِّق كاشِحاً إِن أَتاكا",153,"ك",2,0],["وَاِكتَنَنّا بُردَينِ مِن جَيِّدِ العَص","بِ مَعاً بَينَ مِطرَفٍ وَشِعارِ",154,"ر",1,0],["وَأَكتُمُ ما أُسَمّيها وَتَبدو","شَواكِلُهُ لِذي اللُبِّ الأَريبِ",155,"ب",1,0],["وَأَكَبَّ يَشرَبُها وَتَشرَبُ ذِهنَهُ","فَرَأَيتُ مِنهُ شارِباً مَشروبا",156,"ب",2,0],["وَاِكتَفِ بِاللَمحَةِ مِن فَهمِهِ","إِنَّ المَبادي أَبَداً نَزرَه",157,"ر",2,0],["وَأُكبِرُ شَأناً أَن أَرى الصُبحَ أَبيَضاً","بِعَينٍ تَرى رَبعَ الشَبيبَةِ بَلقَعا",158,"ع",2,0],["وَأَكبَبتُ أَبكي بَينَ وَجدٍ أَظَلَّني","حَديثٍ وَعَهدٍ لِلشَبيبَةِ مَخلَقِ",159,"ق",1,0],["وَأَكرَهتُ صَدرَ القَنا وَالظُبى","فَهَذا تَثَنّى وَذاكَ اِنثَلَم",160,"م",1,0],["وَأَكرَمَ آثاراً مِنَ المُزنِ غادِياً","وَأَشهَرَ أَوضاحاً مِنَ البَدرِ سارِيا",161,"ي",2,0],["وَأَكبَرتُ خَطباً أَن أَرى الصَبرَ بالِياً","وَراءَ ظَلامِ اللَيلِ وَالنَجمَ ثاوِيا",162,"ي",2,0],["وَأَكثَرُ شَيءٍ نِلتُهُ مِن نَوالِها","أَمانيُّ لَم تَعلَق كَبَرقَةِ بارِقِ",163,"ق",1,0],["وأكثرُ النّاسِ في أَحلامِه شططاً","من كان يَطمعُ أن تُستَعْبد الأُممُ",164,"م",1,0],["وأكثرَ في المجالِ الضّنكِ صبرا","وقيل له صدقتَ فأنت أحرى",165,"ر",2,0],["وَأَكثَرُ مِن حُزنِ الجَزوعِ خُطوبُهُ","وَأَكبَرُ مِن حَزمِ اللَبيبِ غَوائِلُه",166,"ل",2,0],["وأكاد أبعث سيبويه من البلى","وذويه من أهل القرون الأُولى",167,"ل",2,0],["وَأُكبِبَتِ الحَوافِرُ وَاِحزَأَلَّت","دَوائِرُ قَلَّصَت بَعدَ الجَفافِ",168,"ف",1,0],["وَأَكرَمتُ نَفسي اليَومَ مِن سوءِ طُعمَةٍ","وَيَقنى الحَياءَ المَرءُ وَالرُمحُ شاجِرُه",169,"ر",2,0],["وَأَكثَرَ الفُصولَ وَالأَوصافا","فَقُلتُ قَد جَنَّبتُكَ الخِلافا",170,"ف",2,0],["وَاِكتَسِب مِن شَكلِهِ حَبَباً","بَينَ مَنثورٍ وَمُنتَظِمِ",171,"م",1,0],["وَأَكُفُّ دَمعَ العَينِ مِن حَذَرٍ","وَالدَمعُ يَسبُقُني وَأَلحَقُهُ",172,"ق",2,0],["وَاِكتَسَت مِن فِضَّةٍ زَرَداً","خِلتُها مِن تَحتِهِ ذَهَبا",173,"ب",2,0],["وَأَكَّدَتْ زُهْدَهُ فيها ضرُورَتُهُ","إنَّ الضَّرُورَة لا تَعْدُو على العِصَمِ",174,"م",1,0],["وأكثر من ألبانها من يخصها","اذا جاءها عاف من الناس مقتر",175,"ر",1,0],["وأكذَبَني طَرْفي فخَفّضْتُ كَلْكَلاً","وأطْرَقْتُ إطراقَ الشجاع ولم أرِم",176,"م",1,0],["واكتستْ أعظُمُ كسرَى لحمَها","وسعى لُقمانُ أو طار لُبَد",177,"د",1,0],["وأكدى عليهم زاخرُ اليمّ مَعبراً","وضاقَ عليهم جانبُ الأرضِ مسرَحا",178,"ح",2,0],["وأكثرُ آمالِها فيكما","وفي القلب منها كجمر الغضا",179,"ا",1,0],["وَأَكُفُّ قَومٍ لَيسَ يُن","بِطُ مائَها إِلّا المَساحي",180,"ح",2,0],["وَاِكتَسَتِ الأَرضُ مِن زَخارِفِها","وَشيَ نَباتٍ تَخالُهُ حُلَلا",181,"ل",2,0],["واكشفي للمجونِ كلّ قناع","إنّ طيبَ المجونِ بالآثامِ",182,"م",1,0],["وَأكرَمُ الناسِ مَن تَأتي مَواهِبُهُ","مِن غَيرِ وَعدٍ وَفيهِ الخَيرُ موجودُ",183,"د",1,0],["وَأَكبَرَت بَدرَةً شَرَيتُ بِها","عِرضي مِنَ الذَمِّ وَالشِرا حَسَبُ",184,"ب",1,0],["وَأَكثَروا الدَعوى بِلا حُجَّةٍ","كُلٌّ إِلى حَيِّزِهِ يَجذبُ",185,"ب",1,0],["وَأَكثَرُ ماشَكاهُ مِنَ الرَزايا","عَواريٌّ لِضَيعَتِهِ عَواري",186,"ي",1,0],["وَأَكثَرَ قَولاً وَالصَوابُ لِمِثلِهِ","عَلى فَضلِهِ أَن لا يُحَسُّ لَهُ جَرَسُ",187,"س",1,0],["وَأَكثَرُ النَسلِ يَشقى الوالِدانِ بِهِ","فَلَيتَهُ كانَ عَن آبائِهِ دُفِعا",188,"ع",2,0],["وَأَكثَرُ الإِنسِ مِثلُ الذِئبِ تَصحَبُهُ","إِذا تَبَيَّنَ مِنكَ الضَعفُ أَطعَمَه",189,"ع",3,0],["وَأَكرَمَني عَلى عَيبي رِجالٌ","كَما رُوِيَ القَريضُ عَلى الزِحافِ",190,"ف",1,0],["وَآكِلُ القَوتِ لَم يُعدَم لَهُ عَنَتاً","وَشارِبُ الماءِ لَم يَأمَن بِهِ شَرَقا",191,"ق",2,0],["وَأَكرِموا الطِفلَ عَن نُكرٍ يُقالُ لَهُ","فَإِن يَعِش يُدعَ كَهلاً بَعدَ أَعوامِ",192,"م",1,0],["وأُكْبِرُ أنْ يُرَثّيها لِساني","بلَفْظٍ سالِكٍ طُرُقَ الطّعامِ",193,"م",1,0],["وَأُكرِمُ والِدي وَأَصونُ عِرضي","وَأَكرَهُ أَن أُعَدَّ مِنَ الحِراصِ",194,"ص",1,0],["وَأَكثَرَ مِنّا نَاكِحاً لِغَرِيبَةٍ","أُصيِبَت سِباءً أَو أَرادَت تَخَيُّرا",195,"ر",2,0],["وَأَكثَرَ غُولاً أُستُها مِثلُ رَأسِها","يُرَى مِن نِصاءِ الناسِ أَصهَبَ أَزعَرا",195,"ر",2,0],["واكتفلتْ بكُلِّ بَنْبلوني","وأَطلقت أَسرى بني ذي النُّونِ",196,"ن",1,0],["وا كَبدا قدْ تَقَطَّعَتْ كَبِدي","وحَرَّقَتْهَا لواعِجُ الْكَمَدِ",197,"د",1,1],["وأكبر سلوتي أني","بعد الموت لا أحيا",198,"ي",2,0],["وأكثر ما أوصى به لم يكن","وأكثر ما قد شاء قد كانا",199,"ن",2,0],["وأَكبر منه أَن أُفارق بغتة","عَلى شغفي لَيلى لليلَى أَنا الفدى",200,"د",2,0],["وأَكثر مني شقوة في زمانه","صديق سقته الموت مراً يد العدى",200,"د",2,0],["وأَكثر إحسانا من الطير شاعر","إذا قال راعَى في صناعته الفنا",201,"ن",2,0],["وأكرموا العلماء المصلحين لما","أَبدوه بالصدق من رأَيٍ وَتلقين",202,"ن",1,0],["وأَكبر أَنصار البلاد رجالها","وأَحسن أَخلاق الرجال هو الصدق",203,"ق",1,0],["وأكثر ما تلقى أبا المسك بذلةً","إذا لم يصن إلاّ الحديد ثياب",204,"ب",1,0],["وأكثر تيهي أنّني بك واثقٌ","وأكثر مالي أنّني لك آمل",205,"ل",1,0],["وَأَكثَرُ ما تَلقى أَبا المِسكِ بِذلَةً","إِذا لَم تَصُن إِلّا الحَديدَ ثِيابُ",206,"ب",1,0],["وأكرمَ قوماً فيكِ كانوا أذِلَّةً","فحرَّرهم من بعد رِقٍّ وإِذلالِ",207,"ل",1,0],["وَاِكفُلوا الأَيتامَ فيهِ وَاِعلَموا","أَنَّ كُلَّ الصَيدِ في جَوفِ الفَرا",208,"ر",2,0],["وَأَكلَتانِ إِذا ما شِئتَ مُرتَفِقاً","بِالسَيرِ مِن نَغِلِ الدَفَّينِ مَدهونِ",209,"ن",1,0],["وَأَكني بِأَسماءٍ سواكِ وَأَتَّقي","زِيارَتَكُم وَالحُبّ لا يَتَغَيَّرُ",210,"ر",1,0],["وأكَلْتَ صَمْغَ الطّلْحِ في","بَيْدَاءَ تَرْفَعُ آلَها",211,"ل",3,0],["وَأَكرَمَ مِن تَيمٍ أَباً قَد رَمَيتُهُ","بِبايِنَةِ العَظمَينِ غائِرَةِ السَبرِ",212,"ر",1,0],["وَأَكُرُّ فيهِم في لَهيبِ شُعاعِها","وَأَكونُ أَوَّلَ واقِدٍ بِصَلاها",213,"ا",3,0],["واكسِبِ النَّفسَ في البَراءَةِ عُذراً","وجَوازاً يُيَسِّرُ التَّعسيرا",214,"ر",2,0],["وَا كَبِدِي يَا عَلِيُّ بَعْدَكَ لَوْ","كَانَتْ تَبُلُّ الْغَلِيلَ وَا كَبِدِي",215,"ي",1,0],["وَأَكْبَرَ ذَاكَ الحَزْمَ وَالعَزْمَ فِي فَتًى","تَخَطَّى حِجَاهُ سِنَّهُ بِمَرَاحِلِ",216,"ل",1,0],["وَأُكْبِرُ خَطْبَ ذَاكَ الشَّيْيخِ","فِي الرُّكْنِ الَّذي رُضَّا",217,"ض",2,0],["وأَكْرَمُهُمْ فِي بَذْلِهِمْ شهَدَاؤُهُمْ","علَى اللّهِ أَيُّ البَذْلِ أَزْكَى وَأَطْهَرُ",218,"ر",1,0],["وَأَكَّدَ البَيْعَةَ إِيمَانُهُمْ","بِأَنَّهُ العُدَّةُ وَالذُّخْرُ",219,"ر",1,0],["وَأكْبِرُ حَوْلَهُ فِي كُلِّ فنٍ","لَفِيفاً مِنْ أَسَاتِذَةٍ فُحُولِ",220,"ل",1,0],["وَاكْشِفْ لَهُمْ نَفْسَكَ السَّنِيَّةَ عَنْ","منَارَةٍ فِي الْغَيَاهِبِ الْكَدْرِ",221,"ر",1,0],["واكتسى مفرقُ الجهادِ جمالاً","بالأكاليل من ذؤابة هاشم",222,"م",1,0],["وأكليل من زنود وأجياد","كما هجت جدولا رقراقا",223,"ق",2,0],["وأكاد مّا حل في بدني","أخفى فتجهلُ موضعي نفسي",224,"ي",1,0],["وأكاد أمتشق الغصون تشفيا","لتهامس الأوراق في الأعواد",225,"د",1,0],["وا كُربَتا مِن حَرِّ هَذا الهَوى","كَأَنَّما في الجَوفِ مِنهُ حَريق",226,"ق",1,0],["وَاِكتَتِبي ثُكلَهُ بِدَمعي","في وَجناتي مَكانَ رقِّ",227,"ق",1,0],["وأكف \"شيفا\" سنّتانْ","على حواشيها اللدانْ",228,"ن",1,0],["وَأَكتُمُ حُبّيكُم مَخافَةَ كاشِحٍ","عَنيدٍ لِأَهلِ الحَقِّ غَيرِ مُواتِ",229,"ت",1,0],["واكشفي حُجْبَ النوى ينتعشوا","بقبول من سجاياك رُخاء",230,"ا",2,0],["وأكتم في الأضلاع ما لو نشرته","تعجّبتِ الأوجاع مني.. ومن سرّي",231,"ر",2,0],["واكبح جماحَ الطامعين، وقل لهم:","لا تطمعوا في أخت عرزائيلا",232,"ل",2,0],["وأكبَرُ مَنْ ترى يَعْرُوه داءُ","فتلحقُه المَذَلَّةُ والصَّغَار",233,"ر",1,0],["واكتب رثاءَكَ فيهِ نفثةُ موجَعٍ","واجعل مدادَكَ دمعَك المتحدرا",234,"ر",2,0],["وأكرمَ حياً فِي البيوتِ، إذا انتمى","وأكرمَ جداً أبطحياً يسودُ",235,"د",1,0],["وأكبر نفسي عن جزاء بغيبة","وكل اغتياب جهد من لا له جهد",236,"د",1,0],["واكتنَّ دون قبيحه خُطَّافه","ونأت سَمامته على الصَّقْر",237,"ر",1,0],["واكبرتُ أني لا ازالُ دريئة","يجرب فيها المُغرضون المراميا",238,"ي",2,0],["وأكفٍ شَتَّى تدبّرُ شتّى","لُعبَةٍ من وراءِ شَتَّى سُجوف",239,"ف",1,0],["واكتَسَتْ بالحسنِ هاماتُ الرُبى","كيفَما شاءَ لها الغيثُ الهَتون",240,"ن",1,0],["واكتُبوها صفحةً إن ذُكِرت","كنتُمُ الأمثال فيها والمِثالا",241,"ل",2,0],["وأكثَرُهُمْ يَهوَى الإضَاقَةَ كَيْ يَرَى","لَهُ، في الذي يأتيهِ مِنْ طَبَعٍ، عُذْرُ",242,"ر",1,0],["وأكْسَبْنَني سُخطَ امرِىءٍ بتُّ مَوْهِناً","أرَى سُخطَهُ لَيلاً معَ اللّيلِ مُظلِمَا",243,"م",2,0],["وَأكْتُمُ الوَجْدَ، وَقَدْ أصْبَحَتْ","عينايَ عينينِ على القلبِ",244,"ب",1,0],["وأكرمْ بخصْم باع بالطَّوْلِ حقَّه","وآثر حقَّ المجْدِ وهوْ مُخاصم",245,"م",1,0],["وأَكرَمُ من غمامٍ عندَ مَحْلٍ","فتى ً يُحيي بمدحتِهِ الكراما",246,"م",2,0],["وَأَكُونُ بَعْدَ هُنَيْهَةٍ مُتَأَرْجِحَاً","في الْحَبْلِ مَشْدُوداً إِلى العِيدانِ",247,"ن",1,0],["وأكرُّ فيهم في لهيب شعاعها","وأكون أوَّل وافدٍ يصلاها",248,"ا",3,0]]}