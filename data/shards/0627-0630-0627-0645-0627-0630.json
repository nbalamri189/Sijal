{"poems":[[65,"ويوم طوينا أبرديه بروضة","https://www.aldiwan.net/poem45917.html","الطويل"],[65,"ألا من لنفس لا تزال مشيحة","https://www.aldiwan.net/poem46142.html","الطويل"],[65,"خضاب على فودي للدهر ما نضا","https://www.aldiwan.net/poem46185.html","الطويل"],[57,"سرى طيف فوز آخر الليل بالطف","https://www.aldiwan.net/poem26241.html","الطويل"],[79,"يمينا بنور الفجر يوما إذا بدا","https://www.aldiwan.net/poem35834.html","الطويل"],[73,"إذا ما ذم فعل النوق يوماً","https://www.aldiwan.net/poem3746.html","الوافر"],[75,"هو الدهر فاصبر للذي أحدث الدهر","https://www.aldiwan.net/poem11945.html","الطويل"],[90,"مضى عبد وهاب الهبات لربه","https://www.aldiwan.net/poem45046.html","الطويل"],[74,"فدى لك مسلوب الرقاد شريده","https://www.aldiwan.net/poem18554.html","الطويل"],[45,"مرتك ابن إبراهيم صافية الخمر","https://www.aldiwan.net/poem9576.html","الطويل"],[47,"لنا أبدا بث نعانيه من أروى","https://www.aldiwan.net/poem10213.html","الطويل"],[99,"نقلت حياتي والحياة بنا تجري","https://www.aldiwan.net/poem24902.html","الطويل"],[50,"ألا يا شهر كم تبقى","https://www.aldiwan.net/poem64464.html","الهزج"],[52,"ألا يا صنم الأززد","https://www.aldiwan.net/poem64851.html","الهزج"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39592","الهزج"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42610","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54911","الطويل"],[108,"شبح الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=179421",""],[89,"تَأَوَّبَ طَيْفٌ مِنْ «سَمِيرَة َ» زَائرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23926&r=&rc=188",""],[119,"لكل مقام في مقال الهوى سر","https://www.aldiwan.net/poem41118.html","عموديه"],[276,"ذروني أبكي بعد جيرة ثهمد","https://www.aldiwan.net/poem52052.html","الطويل"],[303,"ألا كل مجد عرضة للتهدم","https://www.aldiwan.net/poem36812.html","عموديه"],[309,"ونبي الحمى من جانب الغور أبرقا","https://www.aldiwan.net/poem16872.html","الطويل"],[409,"رجعت عن النظم الذي قلت في النجدي","https://www.aldiwan.net/poem33948.html","الطويل"],[411,"إذا ما ذل إنسان بدار","https://www.aldiwan.net/poem49408.html","الوافر"],[422,"أينكر معروفنا المنكر","https://www.aldiwan.net/poem54039.html","المتقارب"],[443,"أجل قد تمادى الأمر وانصرم العمر","https://www.aldiwan.net/poem2542.html","الطويل"],[469,"سقى دمع العين لا دموع الغمائم","https://www.aldiwan.net/poem3271.html","عموديه"],[505,"إذا ما ذكرنا حيدرا في مهمة","https://www.aldiwan.net/poem37641.html","الطويل"],[520,"هل القلب إلا مضغة تتقلب","https://www.aldiwan.net/poem12016.html","الطويل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104564","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67818","الطويل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107198","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61238","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49969","الطويل"],[1491,"","https://poetry.dctabudhabi.ae/diwan/poem/107310","الطويل"],[1768,"","https://poetry.dctabudhabi.ae/diwan/poem/101840","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27910","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27781","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27791","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28615","المتقارب"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67268","الطويل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67213","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60874","الطويل"],[2546,"","https://poetry.dctabudhabi.ae/diwan/poem/33937","المتقارب"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100913","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100229","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204971","المتقارب"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123879","الخفيف"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112302","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74048","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45910","الطويل"],[3663,"","https://poetry.dctabudhabi.ae/diwan/poem/111142","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117995","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85032","الوافر"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17759","الوافر"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/107042","المتقارب"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123487","البسيط"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102734","الطويل"],[4267,"","https://poetry.dctabudhabi.ae/diwan/poem/120187","الطويل"],[4393,"","https://poetry.dctabudhabi.ae/diwan/poem/124789","الطويل"],[4579,"","https://poetry.dctabudhabi.ae/diwan/poem/205455","المتقارب"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139701",""],[4709,"عازفٌ سومري","https://www.poetsgate.com/ViewPoem.aspx?id=214834",""],[4709,"قصير هو العمر","https://www.poetsgate.com/ViewPoem.aspx?id=214867",""],[5219,"أشجان عربي","https://www.poetsgate.com/ViewPoem.aspx?id=194935",""],[5688,"هذا زادي إذا لم تعرفوه","https://www.poetsgate.com/ViewPoem.aspx?id=200679",""],[5776,"انتحارُ عرّافة","https://www.poetsgate.com/ViewPoem.aspx?id=199330",""],[5809,"ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=205284",""],[5989,"بالشعر .. ؛ لا أكثر","https://www.poetsgate.com/ViewPoem.aspx?id=181549",""],[6031,"نَبَتْ بي أرضُكُمْ فَرحلْتُ عَنهَا","https://www.poetsgate.com/ViewPoem.aspx?id=46408",""],[6328,"وقفة ندم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82140&r=&rc=15",""]],"verses":[["إِذا ما ذَكَرْنا طِيبَهُ بَعْدَ بُرْهَةٍ","مِنَ الدَّهْرِ عاوَدْناهُ وَالعَوْدُ أَحْمَدُ",0,"د",1,0],["إذا ما ذَكَرْنا أوَّلِينا تَولَّعَتْ","بنا مَيْعَةٌ يُطْغي الفَتى غُلَواؤُها",1,"ا",3,0],["إذا ما ذَوى غُصْنُ الشّبابِ ولم تَسُدْ","وشِبْتَ فلا تَطْلُبْ إِلى العِزِّ مَنهَضا",2,"ض",2,0],["إِذا ما ذَكَرتُ الهَجرَ لِلقَلبِ لَم يَزَل","يُعَذِّبُني بِالسَيرِ طَوراً وَبِالوَقفِ",3,"ف",1,0],["إذا ما ذكَرْنا مَنْ يَهيمُ بغادَةٍ","ذُكِرْتَ فنَسْتَثْنيكَ منّا بِما سِوى",4,"و",2,0],["إِذا ما ذُمَّ فِعلُ النوقِ يَوماً","فَإِنّي شاكِرٌ فِعلَ النِياقِ",5,"ق",1,1],["إِذا ما ذُكِرتُم وَاِستُشِفَّت خِلالُكُم","تَضَوَّعَتِ الأَخبارُ وَاِستَمجَدَ الخُبرُ",6,"ر",1,0],["إذا ما ذكرناه تفوح خلاله","فننشق من تذكاره أطيب النشر",7,"ر",1,0],["إذا ما ذكا في فحمةِ الليلِ بارقٌ","تبينَ في الأحشاءِ أين وَقوده",8,"د",2,0],["إِذا ما ذَكَرنا جودَهُ كانَ حاضِراً","نَأى أَو دَنا يَسعى عَلى قَدَمِ الخِضرِ",9,"ر",1,0],["إِذا ما ذَكَرناهُ حُبِسنا فَلَم نُفِض","لَهُ في نَظيرٍ في الرِجالِ وَلا شَروى",10,"و",2,0],["إذا ما ذكرتِ العمر يوماً تذكري","هوى وزماناً لا يتاحان في العمر",11,"ر",1,0],["إِذا ما ذُكِرَ الحَمدُ","لِشَوّالٍ ذَمَمناكا",12,"ك",2,0],["إِذا ما ذَكَرَتكَ العَي","نُ لَم تَملِك لَها غَربا",13,"ب",2,0],["إذا ما ذابتِ الأندا","ءُ فوقَ الورَقِ النَّضْرِ",14,"ر",1,0],["إِذَا ما ذُبَابُ السَّيفِ لَمْ يَكُ مَاضِياً","فَحِلْيَتُهُ وَصْمٌ لَدَى الْحَرْبِ ظَاهِرُ",15,"ر",1,0],["إِذَا ما ذَكَرْنَا كُلَّ أَرْوعِ نَابِهٍ","مِنَ النُّخْبَةِ المُثْلى وَمُقْتَحِمٍ جَسْرِ",16,"ر",1,0],["إذا ما ذكرناها اقشعرَّت جلودُنا","إذْ الناسُ كالأنعام قوتهم العشب",17,"ب",1,0],["إذا ما ذُبابُ السَّيفِ لم يكُ ماضِياً","فحيلتهُ وصمٌ لَدى الحربِ ظاهِرُ",18,"ر",1,0],["اذا ما ذكرنا كم تحن قلوبنا","غراما بأنات يحن لها الصخر",19,"ر",1,0],["اذا ما ذكرنا الاكرمين فانه","هو الكوثر الفياض وَالعارض الندي",20,"د",2,0],["إذا ما ذكرنا نكثَهمْ بمقودِهمْ","وَجدنا بشدقينا مرارةَ علقم",21,"م",1,0],["إذا ما ذكرت الكون فيهم وبينهم","يكاد لفرط الوجد أن يتمزقا",22,"ق",2,0],["إذا ما ذكرت الذنب خفت جهنماً","فقال الرجا بل غير هذا ترى عندي",23,"د",2,0],["إذا ما ذَلَّ إنسانٌ بدارِ","فمُرهُ بالرحيلِ على بِدارِ",24,"ر",1,1],["إذا ما ذكرنا فغير الجميل","وغير المحامد لا تذكر",25,"ر",1,0],["إذا ما ذكرت العيش فيها فلن يرى","لماء جفون لا يفض بها عذر",26,"ر",1,0],["إذا ما ذكرناه لمحل تهللت","لذكراه أفواه البروق والبواسم",27,"م",1,0],["إذا ما ذكرنا حيدراً في مهمَّةٍ","تحدَّرَ فيه الكربُ كالسيل من علي",28,"ي",1,1],["إذا ما ذكرنا وقعة من حروبه","فيما يذكر الحيان بكر وتغلب",29,"ب",1,0],["اذا ما ذكت فيه ذُكاءٌ لهيبها","رأيتَ أجيجَ النارِ في لهبيّهِ",30,"ي",2,0],["إذَا مَا ذَكَرْتُ الجِذْعَ وَالْبَانَ وَاللِّوى","يَهيمُ غَرامِي بِالصَّبَابَةِ والْجَوى",31,"ج",3,0],["إِذا ما ذَكَرنا أَحمَدَ بنَ مُحَمَّدٍ","لِخَطبٍ أَلَمَّ انجابَ دَيجُورُهُ عَنّا",32,"ن",2,0],["إِذا ما ذكرت المَوت فاضت مَدامِعي","عَلى كُل ما فَرطت فيض السَّحائِب",33,"ب",1,1],["إذا ما ذكرنا يعرباً بين قومه","فليس لحيّ غيرهم في الورى فخرُ",34,"ر",1,0],["إذا ما ذكرتُ الوصلَ بَيني وبينَهُ","علَت زفراتٌ بي لهُنَّ صعودُ",35,"د",1,0],["إذا ما ذاقها صب يجدها","مدام الوصل للصب المعنى",36,"ن",2,0],["إذا ما ذكرتُ الله بالذكر نفسه","فما هو مذكورٌ ولا أنا ذاكرُ",37,"ر",1,1],["إذا ما ذكرت الله في السرِّو الجهرِ","ليذكرني ربي بما كان من ذكري",38,"ر",2,1],["إذا ما ذكرت الله في غسق الدجى","دُجى الجسمِ لو عند الصباحِ إذا بدا",39,"د",2,1],["إِذا ما ذَكَرناهُ خِلنا المَطِيَّ","عَرَفنَ مَكارِمَهُ وَالعُلا",40,"ا",1,0],["إذا ما ذكرناكُم أعودُ بذكركم","على البُعد نشواناً كمن شرب الخمرا",41,"ر",2,0],["إذا ما ذكرناها سكرنا بذكرها","كأنَّ احتساءَ الخمر كان هو الذكر",42,"ر",1,0],["إذا مَا ذكرتُ البانَ والرملَ والغَضَا","تنهدت لوأجْدىَ الحزينَ التنَّهد",43,"د",1,0],["إِذا ما ذَكَرتُ الهَوى وَالمُنى","تَحَدَّرَ مِن جَفنِها أَربُعُ",44,"ع",1,0],["إذا ما ذُكرنَا بين قومٍ تساءَلوا","أَأُحرقَ مسكٌ أم توزَّع طيب",45,"ب",1,0],["إذا ما ذكرت الشعب من سفح بابل","رمت بي خرقاء اليدين شعوب",46,"ب",1,0],["إذا ما ذكرت ضغوطا لأهلي","تعجبت كيف خروجي سليما",47,"م",2,1],["إذا ما ذوو الشحناء أموك خيبوا","وعاد عليهم بعد ذاك وبالها",48,"ل",3,0],["إذا ما ذوَى دوحُ القريضِ سَقَيتُهُ","لُعَابَ يَرَاعٍ تاهَ في مدحِهم عُجبَا",49,"ا",1,0],["إِذا ما ذكرنا عهد يَلدز مثّلت","خطوب لآمال الكِرام سواحِقُ",50,"ق",1,0],["إِذا ما ذكرت اللَه فَاِزددت نعمة","شَكَرت لَهُ فازددتَ فَضلاً وَأَنعما",51,"م",2,1],["إذا ما ذراع مد منهم لشانئ","يود له مخباً ولو أنه شبر",52,"ر",1,0],["إذا ما ذكرنا المصطفى أو وصيّه","وفاطم والسبطين أعلا الورى شانا",53,"ن",2,0],["إِذا ما ذَكَرَها أَبدى شُجوني","تَراني قائِلاً وَبي التِهابُ",54,"ب",1,0],["إِذا ما ذُقتَهُ عَسَلٌ مُصَفّى","جَنَتهُ النَحلُ في عَلَمٍ شَناحِ",55,"ح",1,0],["إذا ما ذكرتك في الماجدين","تضوع ذكرك فيهم عبيرا",56,"ر",2,0],["اذا ما ذكرنا جوده أقلع الحيا","حياء وجفت من بحار مدالث",57,"ث",1,0],["إذا ما ذرعنا شقة الأرض في السرى","بأذرعها بانت قباب بواذخ",58,"خ",1,0],["إذا ما ذكرت الشرق طرت له شوقاً","وشوقي لمن بالشرق أذكرني الشرقا",59,"ق",2,1],["إذَا مَا ذَكَرنَا عَهدَ أُنسٍ فَإِنَّمَا","يُبَادِرُنَا دَمعٌ مِنَ العَينِ مُنهَلُّ",60,"ل",1,0],["إذا ما ذكرنهم لم تنم","لحر الهموم ولم تجلس",61,"س",1,0],["إذا ما ذكرتُ صريعَ الطفوف","غدا يصرع الرزءُ قلباً جزوعا",62,"ع",2,0],["إذا ما ذكرنا سحرَ قافيةٍ سما","قصيدي سموا وارتقى كلَّ مجمعِ",63,"ع",1,0],["إذا ما ذكرتُكِ أزدادُ عزما","كأنكِ صرحي كأنكِ خلدي",64,"د",2,0],["إذا ما ذكرت بلادي فعيني","همى الدمع منها كماء المطر",65,"ر",1,0],["إِذَا مَا ذِلَّةً أَلْبَسْتُمُونِي","صَغَارًا بَيْنَ بَغْثَاءِ العِبَادِ",66,"د",1,0],["«إذًا ماذا تجهّلني؟؟» تماماً","وأروي فيكِ فصلاً منْ سخافهْ",67,"ف",2,0],["اذا ماذُبتِ بالذكرى فَصيحي","وقولي اشتَقْتُ بالعربي الفصيحِ",68,"ح",1,1],["إذا ما ذاقها المشتاق","من خمر الهوى يسكر",69,"ر",1,0],["إذَا ما ذُلَّ العَزيزُ بأرْضِ قَوْمٍ","وطَالَ علَى العَزِيزِ بِهَا الذَّليلُ",70,"ل",1,0],["إذا ما ذنوبي كانتِ اليومَ جدولاً","فعفوُ إلهِ الكونِ نهرٌ وأبحُرُ",71,"ر",1,0]]}