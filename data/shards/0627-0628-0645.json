{"poems":[[55,"ردوا الغليل لقلبي المشغوف","https://www.aldiwan.net/poem29970.html","الكامل"],[75,"راحت فصح بها السقيم","https://www.aldiwan.net/poem11915.html","مجزوء الكامل"],[68,"أبت الوصال مخافة الرقباء","https://www.aldiwan.net/poem38501.html","الكامل"],[46,"ليت الظباء أبا العميثل خبرت","https://www.aldiwan.net/poem30345.html","الكامل"],[199,"لمن الدار كعنوان الكتاب","https://www.aldiwan.net/poem54425.html","الرمل"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[443,"يا هلالا في فلك","https://www.aldiwan.net/poem2494.html","مجزوء الرمل"],[567,"سلام على من لا نمر بباله","https://www.aldiwan.net/poem52813.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86852","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48748","الكامل"],[226,"","https://poetry.dctabudhabi.ae/diwan/poem/121457","الرمل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35761","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108851","الكامل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141345","الكامل"],[1838,"","https://poetry.dctabudhabi.ae/diwan/poem/104120","الخفيف"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28491","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200072","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117904","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131056",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139714",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139534",""],[4806,"حبيبي وحياتي","https://www.poetsgate.com/ViewPoem.aspx?id=188630",""],[5186,"\"أيهذا \"\"الدبور\"\" أين الحمار","https://www.poetsgate.com/ViewPoem.aspx?id=156553",""],[5186,"طاب يا نشء في نهاك الثناء","https://www.poetsgate.com/ViewPoem.aspx?id=156455",""],[5377,"تحية الخروج من العزلة","https://www.poetsgate.com/ViewPoem.aspx?id=61892",""],[192,"تعبت","https://www.poetsgate.com/ViewPoem.aspx?id=16345",""],[5929,"وتكاد تمطرنا السماء...","https://www.poetsgate.com/ViewPoem.aspx?id=202655",""],[5956,"إلى خادمي الله أحفادي الأكارم وأمهاتهم","https://www.poetsgate.com/ViewPoem.aspx?id=193148",""]],"verses":[["أَبِمَعشَري وَهُمُ الأُلى عاداتُهُم","في الرَوعِ ضَربُ طُلىً وَخَرقُ صُفوفِ",0,"ف",1,0],["أَبِمَجدِكَ العَمَمِ الَّذي","نَسَقَ الحَديثَ مَعَ القَديم",1,"م",1,0],["أَبِمارِدَينَ تَخافُ خَطفَةَ مارِدٍ","وَشِهابُها في القَلعَةِ الشَهباءِ",2,"ا",2,0],["أَبِما يُجامِعُهُ لَدَيهِ مِنَ الغِنى","أَم ما يُفارِقُهُ مِنَ الإِعدامِ",3,"م",1,0],["أَبِماءِ السِرِّ يَسقيهِنَّ أَم","يَرِدُ الجِيَّ إِلى وَجهِ الإِيابِ",4,"ب",1,0],["أَبِمَسمعيهِ صمامُ وقرٍ أم على","بَصرِ الفؤادِ غشاوةٌ لا ترفعُ",5,"ع",1,0],["أبّما منزلةٍ","في الورى قد أنزلك",6,"ك",1,0],["أبٌ ماجدٌ وابنٌ كريمٌ كخاتَمٍ","أتى نقشُهُ في طبعِهِ بمثالِه",7,"ل",2,0],["أَبمثل هذا يا مهين عَلى الوَرى","في هذِهِ الدُنيا الدَنيئة تَفخر",8,"ر",1,0],["أبمهرجان تحتفي ال","ظمأى وتحتفل الغريقه",9,"ق",2,0],["أبمثلي يتمشي حسداً","بنميم مارقٌ للرؤساء",10,"ا",2,0],["أَبٌ مُشفِقٌ بَرٌّ وَأُمٌّ حَفِيَّةٌ","سَطَت بِهِما الأَيّامُ سَطوَة أَروَعا",11,"ع",2,0],["أبمثل ذا نرضى وللشمس الرضى","من عاهل الدنيا وجبار السما",12,"م",2,0],["أبمصر بات كلاهما أم فرّقا","هذا إلى العليا وذاك إلى الشّقا",13,"ق",2,0],["أبمدح يروق أو بهجاء","تكتسي من نداه ثوب عيوبي",14,"ي",1,0],["أبِمِثلِ ذَا الهَذَيَانِ قَد عُزِلَت نُصُو","صُ الوَحيِ عَن عِلمٍ وَعَن إيقَانِ",15,"ن",1,0],["أَبِمِثلِ هَذا يَخصِبُ البُستانُ أَو","يَزدادُ حُسنَ الدَّارِ في السَّهلِيَّةِ",16,"ه",1,0],["ابمهرجان الكون لغوٌ فارغٌ","ماذا يقال بوصفكم إن تُنعتوا",17,"ت",3,0],["أبمسمع منكم ومرأى يا بني","بدر تضام الأم من أولادها",18,"د",3,0],["أبمقلتي أبكيك أم بفؤادي","يا موئلي دون الورى وعمادي",19,"د",2,1],["آبَ من كعبة الإلهِ ووافى","لحمىً شيد للمعالي مطافا",20,"ف",2,1],["آب من كعبة الإلهِ همامٌ","هزَّ في أوبه العلى أعطافا",20,"ف",2,0],["آب من حجِّه وقد زار قوماً","تنقذ المرءَ من أشدِّ العذاب",21,"ب",1,0],["ابمشيتك دريت ابوراك اشيصير","زغير وچبير وشباب او وِلد",22,"د",1,0],["أبمصر الذي بنا من شجون","أكبرتها وأمرها الأمصار؟",23,"ر",1,0],["أبمرعى براثن ونيوب","تكلأ العيس أو تحاط الشاء؟",24,"ا",2,0],["آب من عهده البعيد إلى مصر",".. يلاقي في رحبها إخوانه",25,"ن",2,0],["أبملا العمر \"بالتوبة\" و\"نوح\" و\"هود\" و\"الأحزاب\"","متى كانت سنيني عمر انا عمري في ركعاتي",26,"ت",2,0],["أبمثل هذا المسخ ترقى أمّة","مهزوزة تخطو خطى السكران؟ !",27,"ن",1,0],["أبٌ مثلُ خالدٍ بن الوليد..","ولم تنجبِ الأرضُ مثلَ أبيكمْ",28,"م",1,0]]}