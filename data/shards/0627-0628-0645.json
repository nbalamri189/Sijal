{"poems":[[53,"ردوا الغليل لقلبي المشغوف","https://www.aldiwan.net/poem29970.html","الكامل"],[73,"راحت فصح بها السقيم","https://www.aldiwan.net/poem11915.html","مجزوء الكامل"],[66,"أبت الوصال مخافة الرقباء","https://www.aldiwan.net/poem38501.html","الكامل"],[44,"ليت الظباء أبا العميثل خبرت","https://www.aldiwan.net/poem30345.html","الكامل"],[193,"لمن الدار كعنوان الكتاب","https://www.aldiwan.net/poem54425.html","الرمل"],[303,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[434,"يا هلالا في فلك","https://www.aldiwan.net/poem2494.html","مجزوء الرمل"],[560,"سلام على من لا نمر بباله","https://www.aldiwan.net/poem52813.html","الطويل"]],"verses":[["أَبِمَعشَري وَهُمُ الأُلى عاداتُهُم","في الرَوعِ ضَربُ طُلىً وَخَرقُ صُفوفِ",0,"ف",1,0],["أَبِمَجدِكَ العَمَمِ الَّذي","نَسَقَ الحَديثَ مَعَ القَديم",1,"م",1,0],["أَبِمارِدَينَ تَخافُ خَطفَةَ مارِدٍ","وَشِهابُها في القَلعَةِ الشَهباءِ",2,"ا",2,0],["أَبِما يُجامِعُهُ لَدَيهِ مِنَ الغِنى","أَم ما يُفارِقُهُ مِنَ الإِعدامِ",3,"م",1,0],["أَبِماءِ السِرِّ يَسقيهِنَّ أَم","يَرِدُ الجِيَّ إِلى وَجهِ الإِيابِ",4,"ب",1,0],["أَبِمَسمعيهِ صمامُ وقرٍ أم على","بَصرِ الفؤادِ غشاوةٌ لا ترفعُ",5,"ع",1,0],["أبّما منزلةٍ","في الورى قد أنزلك",6,"ك",1,0],["أبٌ ماجدٌ وابنٌ كريمٌ كخاتَمٍ","أتى نقشُهُ في طبعِهِ بمثالِه",7,"ل",2,0]]}