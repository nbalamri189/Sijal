{"poems":[[79,"أبدى لداعي الفوز وجه منيب","https://www.aldiwan.net/poem36767.html","الكامل"],[95,"باعوا المخلد بالحطام الفاني","https://www.aldiwan.net/poem11248.html","الكامل"],[29,"ودع أمامة حان منك رحيل","https://www.aldiwan.net/poem5975.html","الكامل"],[93,"أيهذا الشاكي وما بك داء","https://www.aldiwan.net/poem62667.html","عموديه"],[91,"لهفي على شيخ العروبة احمد","https://www.aldiwan.net/poem44636.html","الكامل"],[91,"في النفس منك جميع ما احسسته","https://www.aldiwan.net/poem44732.html","الكامل"],[63,"جاءت هديتك التي","https://www.aldiwan.net/poem51794.html","مجزوء الكامل"],[52,"من أبي هشام يا رجال قصيدة","https://www.aldiwan.net/poem64740.html","الكامل"],[113,"لو كنت أطمع بالمنام توهما","https://www.aldiwan.net/poem16185.html","الكامل"],[119,"ما للقلوب من العيون امان","https://www.aldiwan.net/poem40440.html","عموديه"],[124,"ذهب الوفاء فما أحس وفاء","https://www.aldiwan.net/poem49353.html","الكامل"],[132,"ما حاجتي في ذم أهل زماني","https://www.aldiwan.net/poem50497.html","الكامل"],[227,"قمر تجلى في سماء كماله","https://www.aldiwan.net/poem55413.html","الكامل"],[240,"لو بات من يلحي عليك مسهدا","https://www.aldiwan.net/poem32100.html","الكامل"],[275,"قد أبهجتك بنورها وصباها","https://www.aldiwan.net/poem35687.html","الكامل"],[302,"تفديك لو قبل المنون فداها","https://www.aldiwan.net/poem33083.html","الكامل"],[369,"للطيف بحر بكاي ينفرق","https://www.aldiwan.net/poem60833.html","أحذ الكامل"],[369,"كلما اشتقت يا خليلي نجدا","https://www.aldiwan.net/poem60932.html","الخفيف"],[382,"بيني وبين المبدعين مرامي","https://www.aldiwan.net/poem59267.html","الكامل"],[398,"مالي أرى قوما اذا سمعوا","https://www.aldiwan.net/poem53663.html","أحذ الكامل"],[415,"انظر منازل آل منقذ إنها","https://www.aldiwan.net/poem31689.html","عموديه"],[415,"مالي وللجبل الأغر وإنما","https://www.aldiwan.net/poem32371.html","الكامل"],[463,"ليتها إذ منعت ماعونها","https://www.aldiwan.net/poem55830.html","الرمل"],[463,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[466,"طرب الزمان وأنجمت أشجانه","https://www.aldiwan.net/poem15145.html","الكامل"],[470,"يا صاحب العيدين","https://www.aldiwan.net/poem36542.html","عموديه"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48678","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37999","الكامل"],[996,"","https://poetry.dctabudhabi.ae/diwan/poem/82242","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72289","الكامل"],[1247,"","https://poetry.dctabudhabi.ae/diwan/poem/178057",""],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52047","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27786","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2489,"","https://poetry.dctabudhabi.ae/diwan/poem/111227","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205804","الكامل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205434","الخفيف"],[2859,"","https://poetry.dctabudhabi.ae/diwan/poem/144322","الكامل"],[2888,"","https://poetry.dctabudhabi.ae/diwan/poem/46730","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132652","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205553",""],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119459","الخفيف"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119617","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136672",""],[4767,"سفن النجاة","https://www.poetsgate.com/ViewPoem.aspx?id=179635",""],[5111,"تَقَاسِيمُ الصَّمْتِ","https://www.poetsgate.com/ViewPoem.aspx?id=212043",""],[5183,"قالتا","https://www.poetsgate.com/ViewPoem.aspx?id=186486",""],[5183,"الشيء المعقد","https://www.poetsgate.com/ViewPoem.aspx?id=180177",""],[5338,"قالوا: تعزل قلت: هذي كربلا","https://www.poetsgate.com/ViewPoem.aspx?id=190099",""],[5376,"بانتْ بليلى امةٌ وديارُ","https://www.poetsgate.com/ViewPoem.aspx?id=197712",""],[5451,"لكم مزماركم ولي مزماري","https://www.poetsgate.com/ViewPoem.aspx?id=155932",""],[6075,"بسمة الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=200329",""],[2220,"كبرْ إلهكَ فالإله كبيرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11382&r=&rc=256",""]],"verses":[["فَإِذَا ذُكِرْتَ كَأَنَّ هَبَّاتِ الصَّبَا","فَضَّتْ بِمَدْرَجِهَا لَطِيمَةَ طِيبِ",0,"ب",1,0],["فَإذَا ذُكِرْتَ وَأَنْتَ عُنْوَانُ الْفِدَى","فَاسْمُ الرِّفَاقِ تَتِمَّةُ الْعُنْوَانِ",1,"ن",1,0],["فَإِذا ذَكَرتَ مِنَ الهُذَيلِ وَقَد شَتا","فينا الهُذَيلُ وَفي شَواهُ كُبولُ",2,"ل",1,0],["فَاِذا ذَهَّبَ الأَصيلُ الرَوابي","وَقَفَت فَوقَها تُناجي الأَصيلا",3,"ل",2,0],["فاذا ذكرت بها فانت مخلد","واذا نسيت فانت غير مخلد",4,"د",1,0],["فاذا ذهبت فكل شيء ذاهب","واذا بقيت فكل شيء باق",5,"ق",1,0],["فإذا ذَكَتْ نيرانُها","ليلاً وجَدَّت في التهاب",6,"ب",1,0],["فَإِذا ذَكَرتُكِ يا عُبَيدَ تَقَطَّعَت","نَفسي عَلَيكِ وَعادَني حَسَراتُ",7,"ت",1,0],["فَإِذا ذَكرت ليَ الحَبيب يَكادُ مِن","طَربي يَقبل مَسمَعي مِنكَ الفَما",8,"م",2,0],["فاذا ذكرت فكل عيني مسمع","واذا برزت فقالبي انسان",9,"ن",1,0],["فإذا ذكرت ليالياً سلفت لنا","حن الفؤاد ونفس الصعداء",10,"ا",2,0],["فإذا ذممتهمُ غدوت شريكَهم","حقّاً لأنا كلنا سيّانِ",11,"ن",1,0],["فإذا ذكرت المجد فهو أساسه","ورضيعه في المهد قبل فصاله",12,"ل",2,0],["فَإِذا ذُكِرتَ لَدى المُلوكِ بِمَحفَلٍ","خَضَعَت رِقابُهُم لِعِزِّكَ سُجَّدا",13,"د",2,0],["فإذا ذكرتُ ضياءَها ونسيمها","وأريجَها وزلالَها ونَداها",14,"ا",3,0],["فإذا ذكرتُ فناءَ دُنيانا الَّتي","لا لفظها يَبقى ولا مَعناها",15,"ا",3,0],["فإذا ذهبْتَ مُسارِقاً نظَراً","أَعياكَ من سَرَقٍ بها السَّرق",16,"ق",1,0],["فإذا ذُمَّتِ العهودُ فإنِّا","ما ذمَمْنا منهم ولا منكَ عَهدا",17,"د",2,0],["فإذا ذكرتَ مديح مريم بعدما","نادتك صف لي عزتي ومقامي",18,"م",2,0],["فَاِذا ذكرتُ لهُم فَضائِلَهُ","قالوا شَتَمتَ بها أَبا بكرِ",19,"ر",1,0],["فإذا ذكرتهم عرتني حسرة","تمري سحائب دمعي المتبادر",20,"ر",1,0],["فإذا ذكرتُ النّازِلِينَ بِسَهْلهِ","وبهم وإن شَطّت نَوَايَ أهِيمُ",21,"م",1,0],["فإذا ذاك فذرِّيَّتُكُمْ","تأخذ النُّهْجَ التي تحذونَها",22,"ن",3,0],["فإذا ذراهم بُزْلُها","مرحولة وبِكارُها",23,"ر",3,0],["فإذا ذكاءُ اليوم أضمر ضوءها","نقْعُ الطراد كثيفةٌ أدْجانهُ",24,"ن",2,0],["فَإذا ذ َكَرتُكُما مَعا ً فَكأنَّما","قِمَمُ المَكارِم ِ كُلِّها تَتَجَمَّعُ",25,"ع",1,0],["فإذا ذكرنا نعمةً لهم فما","ننسى أغاليطاً لهم وهناتِ",26,"ت",1,0],["فَإِذا ذكرت عَلى العدوّ كَأَنَّهُ","في كَفِّهِ سَمَكٌ هُوَ الرعّادُ",27,"د",1,0],["فَإِذا ذَهَبتُ إِلى العَزاءِ أَرومُهُ","لأُري المُكاشِحَ بِالعَزاءِ تَجَلُّدي",28,"د",2,0],["فإذا ذكرت عدَّيهم أو تيهم","للغيظ ملت على يدَّي معضعضا",29,"ض",2,0],["فإذا ذكرتك سامحتك به","مني الجفون ففاض وانسكبا",30,"ب",2,0],["فَإذا ذَاكَ أضدادُ الأشِعَّةِ جُمِعَتْ","ومنْ قَبلِ هّذا الحِينِ ما اجتَمَعَ الضِدُّ",31,"د",1,0],["فإذا ذكرت الله وحِّد ذاته","فمقامها التوحيد ولها التكثير",32,"ر",1,0],["فَإِذَا ذَكَرتَ النَّاصِحينَ لِرَبِّهِم","وَكَتَابِهِ وَرَسُولِهِ بِلِسَانِ",33,"ن",1,0],["فإذا ذقتها تحققت فيها","ان ماء الحياة في الظلمات",34,"ت",1,0],["فإذا ذويت مع الزمان وأقفرت","نفسى وأقوَتْ من شذاك ربوعي",35,"ع",2,0],["فإذا ذلك النمير وقد جف","ف وغاضت صبابة الغدران",36,"ن",1,0],["فإذا ذكرتك خلت أني شارب","ثمل سقاه من المدامة ساق",37,"ق",1,0],["فَإِذا ذَهَبتَ إِلى الثَناءِ فَقِفه مِن","بَينِ الأَنامِ عَلى عُلاهُ وَاِحبِسِ",38,"س",1,0],["فإذا ذكرت ليالياً سلفت","بالجزع هاج غرامي الجزع",39,"ع",1,0],["فإذا ذهبت موليًا","فاذهب فكم لك من خلفْ",40,"ف",1,0],["فإذا ذيق أسبلت قطرة منه","سيولا من أعين وأنوف",41,"ف",1,0],["فإذا ذُكِرَت لهم وعَقلُهُم","راسٍ وهي فكأنَّ بهم خَبلُ",42,"ل",1,0],["فاذا ذكرتُ أباكم بينَ الورى","نسيت لعُظم ابيكم آباءها",43,"ا",3,0],["فإذا ذكرت له فضائل حيدرٍ","ستراه يذكر غيره أو يضحك",44,"ك",1,0],["فِإِذَا ذَلِكَ الْكَلامُ ُزلالٌ","قَدْ حَلَا مِنْ أَهْوْائِهَا أنْسَامَا",45,"م",2,0],["فإذا ذو مِرَّةَ خلفهما","ماشياً تحسبه نجماً هوى",46,"و",2,0],["فإذا ذو المال أودى","لم يدع ذكراً يخلد",47,"د",1,0],["فَإِذَا ذَكَرْتُ مَنَازِلًا أَبْكِي شَجًا","لِدِيَارِ أَحْمَدَ حِينَ طَافَ بِهَا البِلَىٰ",48,"ل",2,0],[".فإذا ذُكرْتَ فبالخلائقِ ِبسْطةٌ","تحيا لذكْرِك ليلةٌ ونهارُ",49,"ر",1,0],["فإذا ذكرْتُ جمالَها وظلالَها","جاشَ الأنينُ فمدمعي مِدْرارُ",50,"ر",1,0],["فَإِذَا ذِكْرَاكِ نَهْرٌ مِنْ سَنَا","تَوقِظُ الْفَجْرَ وَتُصْغِي لِلسَّحَر",51,"ر",1,0],["فإذا ذكرتَ اللهَ وحدْ ذاتَهُ","فمقامها التوحيد لا التكثير",52,"ر",1,0]]}