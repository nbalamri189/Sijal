{"poems":[[65,"أكوكب ما أرى يا سعد أم نار","https://www.aldiwan.net/poem45803.html","البسيط"],[32,"وقفت على ربع لمية ناقتي","https://www.aldiwan.net/poem29613.html","الطويل"],[53,"وماء جلت عن حر صفحته القذى","https://www.aldiwan.net/poem62882.html","الخفيف"],[53,"ألا نسيا نفسي حديث البلابلِ","https://www.aldiwan.net/poem65958.html","الطويل"],[53,"اسلم على الأيام","https://www.aldiwan.net/poem66009.html","المجتث"],[30,"ومن حين قحطاني سجستان أصبحوا","https://www.aldiwan.net/poem5106.html","الطويل"],[30,"رأيت سماء الله والأرض ألقتا","https://www.aldiwan.net/poem5612.html","الطويل"],[46,"قفوا جددوا من عهدكم بالمعاهد","https://www.aldiwan.net/poem30543.html","الطويل"],[46,"لقد أخذت من دار ماوية الحقب","https://www.aldiwan.net/poem30580.html","الطويل"],[107,"توالت وفود الله تختار دينه","https://www.aldiwan.net/poem44000.html","الطويل"],[77,"ألا أيها الوادي المقدس بالندى","https://www.aldiwan.net/poem69025.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42573","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142039","الوافر"],[154,"أجد مدح خير الخلق ذاتا وجودة","https://www.aldiwan.net/poem68582.html","الطويل"],[186,"ليهنك أيها المولى وسام","https://www.aldiwan.net/poem61057.html","الوافر"],[214,"تنفست الأيام وابتسم الدهر","https://www.aldiwan.net/poem13558.html","الطويل"],[273,"عن العرب الصيد الألى أحرزوا العلى","https://www.aldiwan.net/poem69132.html","الطويل"],[287,"لقد كنت من وشك الفراق أليح","https://www.aldiwan.net/poem32832.html","الطويل"],[325,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[327,"أتصرم أم تواصلك النجود","https://www.aldiwan.net/poem56354.html","الوافر"],[369,"بغرة وجهك منا القسم","https://www.aldiwan.net/poem60658.html","المتقارب"],[382,"قد أومضت حكمة الإنجيل عن رسل","https://www.aldiwan.net/poem59236.html","البسيط"],[443,"لهيب جوى قد أضمرته ضلوعه","https://www.aldiwan.net/poem2540.html","الطويل"],[447,"قفوا أيها الركبان نودعكم منا","https://www.aldiwan.net/poem14339.html","الطويل"],[454,"العبور","https://www.aldiwan.net/poem1007.html",""],[466,"اذا كنت جارا للفرات وهاطل","https://www.aldiwan.net/poem15587.html","الطويل"],[469,"سقيت حياً جفني يا بانة الحمى","https://www.aldiwan.net/poem3501.html","عموديه"],[564,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"],[567,"شكا من أذهب البلوى وزالت","https://www.aldiwan.net/poem52835.html","الوافر"],[578,"له قلم تنقاد بيض الظبا له","https://www.aldiwan.net/poem3642.html","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37756","الوافر"],[894,"","https://poetry.dctabudhabi.ae/diwan/poem/120172","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59126","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202077","المتقارب"],[1165,"","https://poetry.dctabudhabi.ae/diwan/poem/101342","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56013","الوافر"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136112","الطويل"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/20026","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64417","الطويل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123031","الوافر"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199634","المسحوب"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84895","الوافر"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65124","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132699","الطويل"],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145544","الطويل"],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145537","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67971","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62831","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62823","المتقارب"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48328","الدوبيت"],[3540,"","https://poetry.dctabudhabi.ae/diwan/poem/100522","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108345",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91199","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114050","الخفيف"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133264","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77131","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77027","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119621","الوافر"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123524","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83362","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72943","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139597",""],[4927,"جَلِيْدُ الْحُبّ","https://www.poetsgate.com/ViewPoem.aspx?id=29843",""],[5277,"نوار المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=185913",""],[5431,"ياريح ....","https://www.poetsgate.com/ViewPoem.aspx?id=202363",""],[5653,"دوين الكثيب الفرد قضب وكثبانُ","https://www.poetsgate.com/ViewPoem.aspx?id=26452",""],[5949,"أحن إلى روض التصابي وأرتاح","https://www.poetsgate.com/ViewPoem.aspx?id=181657",""],[454,"العبور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82649&r=&rc=13",""]],"verses":[["بِهِ عَذارى تَبُزُّ اللَيلَ ظُلمَتَهُ","بِأَوجُهٍ هيَ في الظَّلماءِ أَقمارُ",0,"ر",1,0],["بِهِ عَرَصاتُ الحَيِّ قَوَّبنَ مَتنَهُ","وَجَّردَ أثباجَ الجَراثيمِ حاطِبُه",1,"ب",2,0],["به عَبَق مما تَسحَّب فوقه","نسيمُ الصّبا تجري على النوْر والزهر",2,"ر",1,0],["به عبَقٌ كالمسك مما تسحَّبت","عليه الصَّبا تَفْلى خُزامى الخمائلِ",3,"ل",1,0],["به عززتُ وأصبح","تُ نافذَ الأحكامِ",4,"م",1,0],["بِهِ عَمَرَ اللَهُ المَساجِدَ وَاِنتَهى","عَنِ الناسِ شَيطانُ النِفاقِ فَأَقصَرا",5,"ر",2,0],["بِهِ عَمَدُ الدينِ اِستَقَلَّت وَأَثبَتَت","عَلى كُلِّ ذي طَودَينِ لِلدينِ قائِمِ",6,"م",1,0],["بِهِ عِلَّةٌ لِلبَينِ صَمّاءُ لَم تُصِخ","لِبُرءٍ وَلَم توجِب عِيادَةَ عائِدِ",7,"د",1,0],["بِهِ عَلِمَت صُهبُ الأَعاجِمِ أَنَّهُ","بِهِ أَعرَبَت عَن ذاتِ أَنفُسِها العُربُ",8,"ب",1,0],["به عَرَفَ القومُ السّبيلَ إلى الهُدَى","فلا مَسْلَكُ وعرٌ ولا مَرْكَبٌ صَعْبُ",9,"ب",1,0],["به عرفت تلك الأعاريبُ قهرَها","فلا مارق يُخشَى عليه مَروق",10,"ق",1,0],["بِهِ عِلَّةٌ إِنْ لَمْ تُصِبْهَا سَلامَةٌ","مِنَ اللهِ كَادَتْ نَفْس حَامِلِهَا تُرْدِي",11,"د",2,0],["به عبق الجهاد كأنّ روضاً","تدفق من جوانبه وصاكا",12,"ك",2,0],["بِهِ عَرفاتٌ وَالحَطيمُ وَزَمزَمُ","مِنَ اللَهِ أَرجو نَظمَ شَملي بِشَملِهِ",13,"ه",1,0],["بِهِ عِقدُ المُلوكِ إَلَيكَ وافى","يَزينُ مِن عَلائكَ أَيّ جيدِ",14,"د",1,0],["به عاد نثر الشمل منتظما وقد","تطابق في اوصافه النظم والنثر",15,"ر",1,0],["بِهِ عَجَّ في أَمصارِها كُلِّ مِنبَرٍ","وَطَنَّت بِهِ الخافِقينَ المَدارِسُ",16,"س",1,0],["بِهِ عاشَ مَوتى الفَقرِ حَتّى كَأَنَّما","أَتى الناسَ مِن بَعدِ المَسيحِ مَسيحُ",17,"ح",1,0],["بِهِ عَلا الدينَ وَالأَقصى إِلَيهِ دَنا","وَالإِنسُ وَالجِنُّ عَمَّتهُم هِدايَتُهُ",18,"ت",2,0],["بِهِ عِتقٌ لِسامَةَ بَعدَ رِقٍّ","إِذا اِبطَت عَن فِكاكِهِمُ الوُفودُ",19,"د",1,0],["به عَلِقتْ شَرَرٌ لوَّحتْ","هُ من نارِ خَدٍّ له تَضْطَرِم",20,"م",1,0],["به عقلنا كلامَ اللَه فانعقلت","عقولُنا بعقالٍ يَعقلُ الجِنّا",21,"ن",2,0],["به عاد ممحوا الشريعة واغتدى","به الدين مردوداً إليه مضيعه",22,"ع",2,0],["به عبرت أفواهنا عن قلوبنا","وقام به إخلاصنا نئباً عنا",23,"ن",2,0],["به عرف الناس السماحة والفد","وحسن الثنا من فيضه يتبجس",24,"س",1,0],["به عن مقام العار لفتَةُ مُبْغضٍ","وفيه إِلى العلياء عطفُ مُتَيَّمِ",25,"م",1,0],["به عرفتْ أنَّ البعولَ حصانةٌ","فلا رجعتْ يوماً من الدهر أيما",26,"م",2,0],["به عمر بن الفارِض النَّاظم الذي","تجرَّد للأسْفار قد سَهَّل الحزْنا",27,"ن",2,0],["بهِ عاشَتْ بقايا آلِ عيسى","كذاك العَيشُ يَحصُلُ بالفُؤادِ",28,"د",1,0],["بِهِ عَرَفَ الأَقوامُ ما هُوَ كائِنٌ","وَما هُوَ جارٍ في نُفوسِ العَوالِمِ",29,"م",1,0],["به عنه سرا لا ينال تحكما","وفي مجمع البحرين جاء معلما",30,"م",2,0],["بِهِ عمرُ النّدى أَضحى طَويلاً","وَعُمرُ البخلِ قَد أَمسى قَصيرا",31,"ر",2,0],["به عيل الوفاء فلا وفلاء","به فقد الذمام فلا ذمام",32,"م",1,0],["بِهِ عَزَّ فِي العَلْيَا مَرَاتِبُ سُؤْدَدٍ","فَلاَ غَرْوَ إنْ عَزَّتْ بِوَطْأتِهِ البُسْطُ",33,"ط",1,0],["به عَزَّ لا شَكَّ ذُو عِزة","وأمْسى أخُو الذُّلِّ عنه ذَليلا",34,"ل",2,0],["به عثر الدهر الخؤون فلم يقل","وكم عثرة للدهر كان يقيلها",35,"ل",3,0],["به علماءُ هذا العصر كم قد","تباهت في تفضّله الشهيرِ",36,"ر",1,0],["به عرفوا الحق الصريح فادركوا","من العلم سر الحكم في الفرض والندب",37,"ب",1,0],["بِهِ عَلِمَ الإِعطاءُ كُلُّ مُبَخَّلٍ","وَأَقدَمَ يَومَ الرَوعِ كُلُّ جَبانِ",38,"ن",1,0],["به عرجوا مستبصرين المعارجا","فجذبهم في السير للخير والجا",39,"ج",2,0],["به عند الفراق لكل سهم","يكون بزورها يعلى الرنينا",40,"ن",2,0],["به علّقت آمالي وأرجو","يقيناً في مآلي أن يقيني",41,"ن",2,0],["به علة ما فداها كي وطبوب","عليك يانور الوطن والمراحي",42,"ح",2,0],["بِهِ عَبد المَجيد زَها","وَحاكى ليلة القَدر",43,"ر",1,0],["به عاد نهجُ البرّ والبحر آمنا","ودانت جميعُ المفسدين لهُ غرزا",44,"ز",2,0],["به عز دين الله إذ قام دونه","يجرد مسنونين عزماً ومنصلا",45,"ل",2,0],["به عال فرض الحج من كان مسلما","إذا كان في إسلامه متحوبا",46,"ب",2,0],["به عد منها آخرا قبل أول","ورتب منها واحدا بعد تاسع",47,"ع",1,0],["بِهِ عمِرت أرضُ المكارم وارتوتْ","بأَنوائه وارتدَّ للجود ذاهبه",48,"ب",2,0],["به عرفَتْ بصائرُ كلِّ أمرٍ","وقوعَ الحزْمِ منها والصّوابِ",49,"ب",1,0],["بهِ عَرَفَتْ ثاقباتُ النّجوم","عورةَ تدبيرها المضطرِبْ",50,"ب",1,0],["بهِ عبْدُهُ قد بلغَ الآمالا","فالجاه يُفيدُ لحْظُهُ والمالا",51,"ل",2,0],["به عقد الشرع المبين لواءه","وقاد إليه الأمر في العقد والحل",52,"ل",1,0],["به عظمت تلك الزعامة انما","بمنصبه السامي الذرى ما تعظما",53,"م",2,0],["بِهِ عن حمى اللاجي يدافع عزمُه","فصينَ به راجٍ وضيعَ مجاول",54,"ل",1,0],["به عملٌ لأهلِ طيبةَ ملحقٌ","ذرى الخلفاءِ الراشدين وهم هُمُ",55,"م",1,0],["بِهِ عِطرُ النِّسرِينِ والوَردِ يَعلَق","بِشَذّى خُلقِهِ النَّسِيمُ تَخَلَّق",56,"ق",1,0],["به عرفوا سبيل الحق لكن","أرادوا الكيد واتبعوا الخصاما",57,"م",2,0],["بِهِ عَن الزَيغِ يُصان المُعتَقَد","وَيَبلُغَ المَرءُ بِهِ كَنهَ الرُشد",58,"د",1,0],["بِهِ عرف الانصافِ بَينَ ذَوي الصَفا","فَآخى وَما أَكدى وَعاشَرَ فَاِهتَدى",59,"د",2,0],["به عقد الكرام سما","وزان بنظمه السلك",60,"ك",1,0],["به عين أنسى حيث أمسى ولم يكن","لنفسى برمسى من يزيل قلاها",61,"ا",3,0],["به عزَّ دين اللَهِ وَاِعتَزَّ أَهلُه","وَأُطلِقَ سَيفٌ كانَ للحقّ مغمَدا",62,"د",2,0],["به عن سؤالِ الفارسيّ مجاوبا","بتركيةِ غرّا حكتها الفراقدُ",63,"د",1,0],["به عاد ثغر المجد والجود باسما","وعطر المعالي منه قد عاد نافحا",64,"ح",2,0],["بِهِ عَفْرَاْءُ تَحْمِيْهَا الْبَوَاْدِيْ","وَتَرْقُصُ حَوْلَ هَوْدَجِهَا الْوُرُوْدُ",65,"د",1,0],["به عبقُ يفوحُ من الأماسي","كحرفِ الحبِّ من بوحِ الأمالي",66,"ل",2,0],["به عطشٌ إلى نبضات قلب","وبسمته تطيب بها الجروحُ",67,"ح",1,0],["به کعتَدَلَتْ أزمانُها وهواؤها","فكانون أيلول وتموز نيسانُ",68,"ن",1,0],["به عجمة في اللفظ تغرى بوصله","وإن كان منه بالقطيعة إفصاح",69,"ح",1,0],["به عرف الناس السماحة والفدا","وحسن الثنا من فيضه يتبجس",70,"س",1,0]]}