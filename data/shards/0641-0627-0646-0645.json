poem34181.html","السريع"],[559,"الناس موصوفون بالأفعال","https://www.aldiwan.net/poem34198.html","الرجز"],[559,"هذه أثوابهم والحلل","https://www.aldiwan.net/poem34247.html","الرمل"],[559,"انظر إلى الكون وهو في عدم","https://www.aldiwan.net/poem34287.html","المنسرح"],[559,"يا عابدا ربا بتصويره","https://www.aldiwan.net/poem34459.html","السريع"],[563,"عنوان كل مديح راسخ القدم","https://www.aldiwan.net/poem52884.html","البسيط"]],"verses":[["فَإِنَّ مُقاساةَ اللِّئامِ على الفَّتى","بَلاءٌ وَلَمْ يَرْعفْ بِأَمْثالِها الدَّهْرُ",0,"ر",1,0],["فأنْمَيتَ الذي غَرَسوهُ قَبْلاً","كما يتَعاهَدُ الرّوْضَ العِهادُ",1,"د",1,0],["فَإِنَّ مَذاقَهُ مُرٌّ","وَمَشَرَبُ صَفوِهِ الكَدَرُ",2,"ر",1,0],["فَإِن مُتُّ بِالشَوقِ الَّذي بي إِلَيكُمُ","فَتِلكَ لَعَمري حَسرَةُ الحَسَراتِ",3,"ت",1,0],["فَإِن مُتَّ ضَرّاً فَلا تَسألَن","أَخا الجَهلِ مِن مالِهِ خَردَلَه",4,"ل",2,0],["فَإِنَّ مقادِرَ الرَحمَنِ تَجري","بِأَرزاقِ الرِجالِ مِنَ السَماءِ",5,"ا",2,0],["فَإِنَّ مُعاوِيَةَ الأَكرَمينَ","عِظامُ القِبابِ طِوالُ الأُمَم",6,"م",1,0],["فَإِنَّ مِنْ مُعْجِزِهِ كُلَّ مَا","نُكْبِرُهُ في الشَّرْقِ وَالغَرْبِ",7,"ب",1,0],["فَإِنَّ مَنْ صَانَ أَسَاساً وَهَي","صَانَ حِمىً مِنْ سَييِّءِ الغِبِّ",7,"ب",1,0],["فإن مكاناً في القلوب حللته","ليزهى على ملكٍ تؤيده جند",8,"د",1,0],["فَإنَّمَا هَوَ مَا لاَ","نَوَدُّهُ أَنْ يَكُونَا",9,"ن",2,0],["فَإِنَّ مَا كَانَ يَبْغِيهِ لأُمَّتِهِ","أَسْمَى أَمَانِي حُرٍّ غَيْرِ مُتَّهَمِ",10,"م",1,0],["فَاِنمِ القُتودَ عَلى عَيرانَةٍ أَجُدٍ","مَهريَّةٍ مَخَطَتها غِرسَها العيدُ",11,"د",1,0],["فإن ملأت كف النسيم بمثلها","دراهمَ نَوْرٍ ظلَّ عنها مُكافيا",12,"ي",2,0],["فإنما أطول الأعمار أجمعها","للمَكْرُمات من الأبكار والعُون",13,"ن",1,0],["فإن مشارب العُدوان منها","كلا الحزبين يرتشف ارتشافا",14,"ف",2,0],["فإنما النفس ما لم تَنْءَ عن طمع","فريسة بين ناب الذل والظُفُر",15,"ر",1,0],["فإنما لمعات الخير كامنة","بين الشرور كمُون النار في الحجر",15,"ر",1,0],["فإن مودّعاً بعد ارتثات","حياة لا تناط بها الوصوم",16,"م",1,0],["فإنّ منايانا سهام عوائر","وكيف اثئار في السهام العوائر",17,"ر",1,0],["فَإِنَّ مُجاشِعاً فَتَعَرَّفوهُم","بَنو جَوخى وَخَجخَجَ وَالقِذامِ",18,"م",1,0],["فَإِن مُتَّ بَعدَ اليَومِ عابَكَ مَهلَكي","مَعابَ النِزارِيِّنَ مَهلَكَ مَعبَدِ",19,"د",1,0],["فَإِنَّ مَنعَكُما مِن بَعدِ بَذلِكُما","إِيّايَ مِثلُ الَّذي قَد غُرَّ بِالآلِ",20,"ل",1,0],["فإن ملأوا كمَّ المقيم مكارماً","فقد ملأوا حجر المقام ثوابا",21,"ب",2,0],["فإن ملأ الإحسان كمّ مجاور","فقد ملأ الحجر المحامد والدعا",22,"ع",2,0],["فإنما أنا ليثٌ","عادٍ وأنت كُليبُ",23,"ب",1,0],["فإنَّما أنا في لَبْسٍ وذَبْذَبَةٍ","وخَوْف جانٍ بمُرِّ النَّقْم مَرْصُودِ",24,"د",1,0],["فإنما من عندهم نظمهُ","ومن لدنه الدُرُّ والجوهر",25,"ر",1,0],["فإنما تدعى إذا ضيعة","لأن من يملكها الأضيَعُ",26,"ع",1,0],["فإن ملَّكتُه نفسي","فمحقوقٌ بتمليكِ",27,"ك",1,0],["فأنمتَ ليلَ الخائفين مكحّلاً","فيه السهادَ وللدُّثور تزمُّلُ",28,"ل",1,0],["فإن ما تفعلهُ","بحضرتي يُحشمُهُ",29,"م",2,0],["فَإِنَّ مِنَ القَولِ الَّتي لا شَوى لَها","إِذا زَلَّ عَن ظَهرِ اللِسانِ اِنفِلاتُها",30,"ت",3,0],["فَإِن مَرَّ بِنا الفَجرُ وَما أَوقَظَنا الفَجرُ","فَما يوقِظُنا عِلمٌ وَلا يوقِظُنا مالُ",31,"ل",1,0],["فَإِن مُتُّ في ذا الحُبِّ لَستُ بِأَوَّلٍ","فَقَبلِيَ ماتَ العاشِقونَ كَثيرُ",32,"ر",1,0],["فإنَّما هوَ طيفٌ","يَسعَى بوَادي الظِّلالِ",33,"ل",1,0],["فإنّما الموت ضَرْبُ من حبائِلِهِ","لا يُفلتُ الخلقُ مَا عاشوا فما النَّظرُ",34,"ر",1,0],["فانما الذين قد","تعلموا تنعموا",35,"م",3,0],["فإنما الليلة اضطجاعي","يكون يا أم في التراب",36,"ب",1,0],["فإنما كل خطبٍ","دون المنية سهل",37,"ل",1,0],["فإن من أوعز أن يؤمنوا","هو الذي قدر أن يكفروا",38,"ر",3,0],["فإن مررت على الدنيا فمرَّ فتى","ولا تمرنّ مثل الأكثرين هبا",39,"ب",2,0],["فَإِنَّما نَحنُ بَني الدَهاءِ","نَعمَلُ في الشِدَّةِ لِلرَخاءِ",40,"ا",2,0],["فَإِن مَشَت فَخاطِري","يَسبِقُها كَالمُمسِكِ",41,"ك",1,0],["فَإنْ ماتَ لَمْ يُحزنْ صَديقاً مَمَاتُهُ","وإنْ عاشَ لَمْ يَضْرُرْ عَدُوّاً بَقَاؤُه",42,"ه",1,1],["فَإِنَّ مِثلَكَ باهَيتُ الكِرامَ بِهِ","وَرَدَّ سُخطاً عَلى الأَيّامِ رِضوانا",43,"ن",2,0],["فَإِنَّما المَلكُ رَبُّ مَملَكَةٍ","قَد فَغَمَ الخافِقَينَ سَرَيّاها",44,"ا",3,0],["فإنما سطوةُ السلطانِ ليس لها","عارٌ وإن نِيْلَ عِرضٌ أو أُرِيقَ دَمُ",45,"م",1,0],["فَإِن مِتُّ كانَ المَوتُ مِن كَرَمِ الهَوى","وَلَيسَ الهَوى إِن لَم أَمُت بِكَريمِ",46,"م",1,0],["فَإِنَّ مُنى النَفسِ الَّتي أَقبَلَت بِها","وَحِلَّ نُذوري إِن بَلَغتُ المُوَقَّرا",47,"ر",2,0],["فَإِن مَن بِها مَن يُنكِرَ الضَيمَ مِنهُمُ","فَيَغضَبَ مِنها كَهلُها وَغُلامُها",48,"م",3,0],["فإنِّما الحمدُ منّا والثَّوابُ غداً","لكاظمِ الغَيْظِ والعافي عن الناسِ",49,"س",1,0],["فَإِنَّما المَرءُ مِن زُجاجٍ","إِن لَم تَرَفَّق بِهِ تَكَسَّر",50,"ر",1,0],["فَإِنَّ مُنى الدُنيا غُرورٌ لِأَهلِها","أَبى اللَهُ أَن يَبقى عَلَيهِ نَعيمُ",51,"م",1,0],["فَإِن مَنَعَ الأَشِحَّةُ ما لَديهِم","فَإِنّا سَوفَ نَمنَحُ ما لَدَينا",52,"ن",2,0],["فَإِنَّ مَن أَنفَذَ الرَحمَنُ دَعوَتَهُ","وَأَنتَ ذاكَ لَدَيهِ الجارُ لَم يُضَمِ",53,"م",1,0],["فإن مُلِئَت عروقٌ من دماء","فإنَّا قد ملأناهَا حنينَا",54,"ن",2,0],["فإن مُزِجت وجدتَ لها انقياداً","كما تنقادُ بالخُدَعِ النّوَارُ",55,"ر",1,0],["فَإِن مِتُّ مِن وَجدٍ بِهِ وَصَبابَةٍ","فَكَم مِن مُحِبٍّ ماتَ قَبلي بِدائِهِ",56,"ا",3,0],["فَإِنَّ موسى وَصَلّى عَلى روحِهِ الرَبُّ","صَلاةً كَثيرَةَ القُدُسِ",57,"س",1,0],["فَأَنَمْنَاهُ فَوْقَ مَهْدٍ وَثِيرٍ","بُرْهَةً كَيْ يُفِيقَ ثُمَّ انْصَرَفنَا",58,"ن",2,0],["فإنْ متُّ استرحتُ من الأعادي","وإنْ عشتُ اشتفتْ أذني وعيني",59,"ي",1,0],["فَإِن مُتُّ فَاِنعيني إِلى المَجدِ وَالتُقى","وَلا تَسكُبي دَمعاً إِذا قامَ نائِحُ",60,"ح",1,0],["فإنَّ مِنْ جُودِكَ الدنيا وضَرَّتَها","وَمِنْ عُلُومِكَ عِلمَ اللَّوْحِ والقَلَمِ",61,"م",1,0],["فإن ماتَ فانبشهُ من قبرهِ","وأكفانهُ جُعداً فانزِع",62,"ع",1,0],["فَإِنَّما تِلكَ أَخبارٌ مُلَفَّقَةٌ","لِخُدعَةِ الغافِلِ الحَشويِّ حوشيتا",63,"ت",2,0],["فَإِنَّ مِن أَقبَحِ الأَشياءِ يَفعَلُهُ","شاكي المَجاعَةِ يَوماً أَن يُريقَ دَما",64,"م",2,0],["فَإِن ماتَ أَو غاداهُ قَتلٌ فَما هُما","أَماتاهُ في حُكمي وَلا قَتَلاهُ",65,"ل",3,0],["فَإِن مُتُّ فَاِنعيني بِما أَنا أَهلُهُ","وَشُقّي عَلَيَّ الجَيبَ يا اِبنَةَ مَعبَدِ",66,"د",1,0],["فإن مُزِجتْ تخالُ الشَّمس فيها","مطُبَّقةً على قَمرِ السُّ