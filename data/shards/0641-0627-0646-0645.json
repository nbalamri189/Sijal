طلب","https://www.aldiwan.net/poem10000.html","البسيط"],[51,"نعال كنباية والعنبر","https://www.aldiwan.net/poem62886.html","الطويل"],[51,"إن كنت صفعانا ولي ضيعة","https://www.aldiwan.net/poem65385.html","السريع"],[51,"ألا يا قاتل الديك","https://www.aldiwan.net/poem65825.html","الهزج"],[51,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[51,"أحب أن تشتمني","https://www.aldiwan.net/poem66053.html","مجزوء الرجز"],[26,"وأبلغ لديك معقل بن خويلد","https://www.aldiwan.net/poem24078.html","الطويل"],[91,"تعالي نتعاطاها كلون التبر أو أسطع","https://www.aldiwan.net/poem8982.html","عموديه"],[70,"وعاذلة باتت تلوم على الهوى","https://www.aldiwan.net/poem42924.html","الطويل"],[92,"شعري نفاثة صدري","https://www.aldiwan.net/poem38939.html","المجتث"],[92,"يا ليل ما تصنع النفس التي سكنت","https://www.aldiwan.net/poem38942.html","الكامل"],[89,"تعلموا تعلموا","https://www.aldiwan.net/poem44642.html","مجزوء الرجز"],[89,"قد جاء يا أم وقت فوتي","https://www.aldiwan.net/poem44940.html","مخلع البسيط"],[89,"فيك المدائح تحلو","https://www.aldiwan.net/poem44969.html","المجتث"],[89,"ليس على الكفار في أمرهم","https://www.aldiwan.net/poem45114.html","السريع"],[85,"فيم ابتسامك للدنيا وغايتها","https://www.aldiwan.net/poem7530.html","البسيط"],[85,"أبو الحصين جال في السفينه","https://www.aldiwan.net/poem8021.html","الرجز"],[85,"أمينتي في عامها","https://www.aldiwan.net/poem8068.html","مجزوء الرجز"],[56,"فإن مات لم يحزن صديقا مماته","https://www.aldiwan.net/poem58661.html","الطويل"],[43,"قد علم البين منا البين أجفانا","https://www.aldiwan.net/poem10588.html","البسيط"],[43,"أوه بديل من قولتي واها","https://www.aldiwan.net/poem10603.html","المنسرح"],[62,"يا شامتا لزمان قد تنكر لي","https://www.aldiwan.net/poem52292.html","البسيط"],[45,"إِذا شئت فاندبني إِلى الراحِ وانعني","https://www.aldiwan.net/poem66634.html","الطويل"],[28,"تروم على نعمان في الفجر ناقتي","https://www.aldiwan.net/poem5225.html","الطويل"],[28,"بكت عين محزون فطال انسجامها","https://www.aldiwan.net/poem5557.html","الطويل"],[61,"إذا غضبت فلا تعجل بسيئة","https://www.aldiwan.net/poem51589.html","البسيط"],[49,"الله أعلى يدا وأكبر","https://www.aldiwan.net/poem62107.html","مجزوء البسيط"],[49,"أيا رب يا ذا العرش أنت رحيم","https://www.aldiwan.net/poem63109.html","الطويل"],[49,"أرى قوما وجوههم حسان","https://www.aldiwan.net/poem65332.html","الوافر"],[66,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[97,"قسوت فلم نجد ظلا يقينا","https://www.aldiwan.net/poem24406.html","الوافر"],[80,"نعيمك أن تزف لك العقار","https://www.aldiwan.net/poem31437.html","الوافر"],[44,"سقى الله من أهوى على بعد نأيه","https://www.aldiwan.net/poem30293.html","الطويل"],[44,"قالت وعي النساء كالخرس","https://www.aldiwan.net/poem30489.html","المنسرح"],[87,"لاعب السكر قده فتثنى","https://www.aldiwan.net/poem8230.html","الخفيف"],[69,"ولست أخاف طاعونا كغيري","https://www.aldiwan.net/poem28406.html","الوافر"],[52,"لقد صاح بالبين الحمام النوائح","https://www.aldiwan.net/poem27141.html","الطويل"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[48,"على دمنة الدار لا تربع","https://www.aldiwan.net/poem66620.html","المتقارب"],[46,"إن شئت ترزق الدنيا ونعمتها","https://www.aldiwan.net/poem22172.html","البسيط"],[46,"لو كان يدري أويس ماجنت يده","https://www.aldiwan.net/poem23343.html","البسيط"],[46,"لعمري الخير الذخر في كل شدة","https://www.aldiwan.net/poem23557.html","الطويل"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[76,"موردة إذا دارت ثلاثا","https://www.aldiwan.net/poem38869.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85591","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85587","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85367","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85600","البسيط"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141033",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16620","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16638","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42637","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67354","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[1,"","https://poetry.dctabudhabi.ae/diwan/poem/199405","الطويل"],[90,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179090",""],[90,"النجوى","https://www.poetsgate.com/ViewPoem.aspx?id=178987",""],[1,"لِخَوْلَةَ أَطْلالٌ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=10033",""],[47,"دَعَوْتُكَ للجَفْنِ القَرِيحِ المُسَهّدِ","https://www.poetsgate.com/ViewPoem.aspx?id=14767",""],[28,"بكت عين محزون فطال انسجامها","https://www.poetsgate.com/ViewPoem.aspx?id=20996",""],[1,"لِخَولة َ أطْلالٌ بِبُرقَة ِ ثَهمَدِ، ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13176&r=&rc=0",""],[22,"ولما كنتُ جَارَهُمُ حَبَوْنِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18438&r=&rc=10",""]],"verses":[["فَإِنَّ مُقاساةَ اللِّئامِ على الفَّتى","بَلاءٌ وَلَمْ يَرْعفْ بِأَمْثالِها الدَّهْرُ",0,"ر",1,0],["فأنْمَيتَ الذي غَرَسوهُ قَبْلاً","كما يتَعاهَدُ الرّوْضَ العِهادُ",1,"د",1,0],["فَإِنَّ مَذاقَهُ مُرٌّ","وَمَشَرَبُ صَفوِهِ الكَدَرُ",2,"ر",1,0],["فَإِن مُتُّ بِالشَوقِ الَّذي بي إِلَيكُمُ","فَتِلكَ لَعَمري حَسرَةُ الحَسَراتِ",3,"ت",1,0],["فَإِن مُتَّ ضَرّاً فَلا تَسألَن","أَخا الجَهلِ مِن مالِهِ خَردَلَه",4,"ل",2,0],["فَإِنَّ مقادِرَ الرَحمَنِ تَجري","بِأَرزاقِ الرِجالِ مِنَ السَماءِ",5,"ا",2,0],["فَإِنَّ مُعاوِيَةَ الأَكرَمينَ","عِظامُ القِبابِ طِوالُ الأُمَم",6,"م",1,0],["فَإِنَّ مِنْ مُعْجِزِهِ كُلَّ مَا","نُكْبِرُهُ في الشَّرْقِ وَالغَرْبِ",7,"ب",1,0],["فَإِنَّ مَنْ صَانَ أَسَاساً وَهَي","صَانَ حِمىً مِنْ سَييِّءِ الغِبِّ",7,"ب",1,0],["فإن مكاناً في القلوب حللته","ليزهى على ملكٍ تؤيده جند",8,"د",1,0],["فَإنَّمَا هَوَ مَا لاَ","نَوَدُّهُ أَنْ يَكُونَا",9,"ن",2,0],["فَإِنَّ مَا كَانَ يَبْغِيهِ لأُمَّتِهِ","أَسْمَى أَمَانِي حُرٍّ غَيْرِ مُتَّهَمِ",10,"م",1,0],["فَاِنمِ القُتودَ عَلى عَيرانَةٍ أَجُدٍ","مَهريَّةٍ مَخَطَتها غِرسَها العيدُ",11,"د",1,0],["فإن ملأت كف النسيم بمثلها","دراهمَ نَوْرٍ ظلَّ عنها مُكافيا",12,"ي",2,0],["فإنما أطول الأعمار أجمعها","للمَكْرُمات من الأبكار والعُون",13,"ن",1,0],["فإن مشارب العُدوان منها","كلا الحزبين يرتشف ارتشافا",14,"ف",2,0],["فإنما النفس ما لم تَنْءَ عن طمع","فريسة بين ناب الذل والظُفُر",15,"ر",1,0],["فإنما لمعات الخير كامنة","بين الشرور كمُون النار في الحجر",15,"ر",1,0],["فإن مودّعاً بعد ارتثات","حياة لا تناط بها الوصوم",16,"م",1,0],["فإنّ منايانا سهام عوائر","وكيف اثئار في السهام العوائر",17,"ر",1,0],["فَإِنَّ مُجاشِعاً فَتَعَرَّفوهُم","بَنو جَوخى وَخَجخَجَ وَالقِذامِ",18,"م",1,0],["فَإِن مُتَّ بَعدَ اليَومِ عابَكَ مَهلَكي","مَعابَ النِزارِيِّنَ مَهلَكَ مَعبَدِ",19,"د",1,0],["فَإِنَّ مَنعَكُما مِن بَعدِ بَذلِكُما","إِيّايَ مِثلُ الَّذي قَد غُرَّ بِالآلِ",20,"ل",1,0],["فإن ملأوا كمَّ المقيم مكارماً","فقد ملأوا حجر المقام ثوابا",21,"ب",2,0],["فإن ملأ الإحسان كمّ مجاور","فقد ملأ الحجر المحامد والدعا",22,"ع",2,0],["فإنما أنا ليثٌ","عادٍ وأنت كُليبُ",23,"ب",1,0],["فإنَّما أنا في لَبْسٍ وذَبْذَبَةٍ","وخَوْف جانٍ بمُرِّ النَّقْم مَرْصُودِ",24,"د",1,0],["فإنما من عندهم نظمهُ","ومن لدنه الدُرُّ والجوهر",25,"ر",1,0],["فإنما تدعى إذا ضيعة","لأن من يملكها الأضيَعُ",26,"ع",1,0],["فإن ملَّكتُه نفسي","فمحقوقٌ بتمليكِ",27,"ك",1,0],["فأنمتَ ليلَ الخائفين مكحّلاً","فيه السهادَ وللدُّثور تزمُّلُ",28,"ل",1,0],["فإن ما تفعلهُ","بحضرتي يُحشمُهُ",29,"م",2,0],["فَإِنَّ مِنَ القَولِ الَّتي لا شَوى لَها","إِذا زَلَّ عَن ظَهرِ اللِسانِ اِنفِلاتُها",30,"ت",3,0],["فَإِن مَرَّ بِنا الفَجرُ وَما أَوقَظَنا الفَجرُ","فَما يوقِظُنا عِلمٌ وَلا يوقِظُنا مالُ",31,"ل",1,0],["فَإِن مُتُّ في ذا الحُبِّ لَستُ بِأَوَّلٍ","فَقَبلِيَ ماتَ العاشِقونَ كَثيرُ",32,"ر",1,0],["فإنَّما هوَ طيفٌ","يَسعَى بوَادي الظِّلالِ",33,"ل",1,0],["فإنّما الموت ضَرْبُ من حبائِلِهِ","لا يُفلتُ الخلقُ مَا عاشوا فما النَّظرُ",34,"ر",1,0],["فانما الذين قد","تعلموا تنعموا",35,"م",3,0],["فإنما الليلة اضطجاعي","يكون يا أم في التراب",36,"ب",1,0],["فإنما كل خطبٍ","دون المنية سهل",37,"ل",1,0],["فإن من أوعز أن يؤمنوا","هو الذي قدر أن يكفروا",38,"ر",3,0],["فإن مررت على الدنيا فمرَّ فتى","ولا تمرنّ مثل الأكثرين هبا",39,"ب",2,0],["فَإِنَّما نَحنُ بَني الدَهاءِ","نَعمَلُ في الشِدَّةِ لِلرَخاءِ",40,"ا",2,0],["فَإِن مَشَت فَخاطِري","يَسبِقُها كَالمُمسِكِ",41,"ك",1,0],["فَإنْ ماتَ لَمْ يُحزنْ صَديقاً مَمَاتُهُ","وإنْ عاشَ لَمْ يَضْرُرْ عَدُوّاً بَقَاؤُه",42,"ه",1,1],["فَإِنَّ مِثلَكَ باهَيتُ الكِرامَ بِهِ","وَرَدَّ سُخطاً عَلى الأَيّامِ رِضوانا",43,"ن",2,0],["فَإِنَّما المَلكُ رَبُّ مَملَكَةٍ","قَد فَغَمَ الخافِقَينَ سَرَيّاها",44,"ا",3,0],["فإنما سطوةُ السلطانِ ليس لها","عارٌ وإن نِيْلَ عِرضٌ أو أُرِيقَ دَمُ",45,"م",1,0],["فَإِن مِتُّ كانَ المَوتُ مِن كَرَمِ الهَوى","وَلَيسَ الهَوى إِن لَم أَمُت بِكَريمِ",46,"م",1,0],["فَإِنَّ مُنى النَفسِ الَّتي أَقبَلَت بِها","وَحِلَّ نُذوري إِن بَلَغتُ المُوَقَّرا",47,"ر",2,0],["فَإِن مَن بِها مَن يُنكِرَ الضَيمَ مِنهُمُ","فَيَغضَبَ مِنها كَهلُها وَغُلامُها",48,"م",3,0],["فإنِّما الحمدُ منّا والثَّوابُ غداً","لكاظمِ الغَيْظِ والعافي عن الناسِ",49,"س",1,0],["فَإِنَّما المَرءُ مِن زُجاجٍ","إِن لَم تَرَفَّق بِهِ تَكَسَّر",50,"ر",1,0],["فَإِنَّ مُنى الدُنيا غُرورٌ لِأَهلِها","أَبى اللَهُ أَن يَبقى عَلَيهِ نَعيمُ",51,"م",1,0],["فَإِن مَنَعَ الأَشِحَّةُ ما لَديهِم","فَإِنّا سَوفَ نَمنَحُ ما لَدَينا",52,"ن",2,0],["فَإِنَّ مَن أَنفَذَ الرَحمَنُ دَعوَتَهُ","وَأَنتَ ذاكَ لَدَيهِ الجارُ لَم يُضَمِ",53,"م",1,0],["فإن مُلِئَت عروقٌ من دماء","فإنَّا قد ملأناهَا حنينَا",54,"ن",2,0],["فإن مُزِجت وجدتَ لها انقياداً","كما تنقادُ بالخُدَعِ النّوَارُ",55,"ر",1,0],["فَإِن مِتُّ مِن وَجدٍ بِهِ وَصَبابَةٍ","فَكَم مِن مُحِبٍّ ماتَ قَبلي بِدائِهِ",56,"ا",3,0],["فَإِنَّ موسى وَصَلّى عَلى روحِهِ الرَبُّ","صَلاةً كَثيرَةَ القُدُسِ",57,"س",1,0],["فَأَنَمْنَاهُ فَوْقَ مَهْدٍ وَثِيرٍ","بُرْهَةً كَيْ يُفِيقَ ثُمَّ انْصَرَفنَا",58,"ن",2,0],["فإنْ متُّ استرحتُ من الأعادي","وإنْ عش