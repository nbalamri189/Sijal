{"poems":[[53,"من الركب ما بين النقا والأناعم","https://www.aldiwan.net/poem29748.html","الطويل"],[77,"قد كان يسكر شربه","https://www.aldiwan.net/poem35861.html","مجزوء الكامل"],[77,"أثار سراها والديار نوازح","https://www.aldiwan.net/poem36644.html","الطويل"],[77,"هي أسعد ما دونهن حجاب","https://www.aldiwan.net/poem36780.html","الطويل"],[86,"نثروا عليك نوادي الأزهار","https://www.aldiwan.net/poem10492.html","الكامل"],[83,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[92,"يا ربة الشعر والأحلام غنيني","https://www.aldiwan.net/poem38900.html","الكامل"],[92,"يا موت قد مزقت صدري","https://www.aldiwan.net/poem38940.html","مجزوء الكامل"],[62,"ياقلب ما لك والهوى من بعد ما","https://www.aldiwan.net/poem52334.html","الكامل"],[45,"هبيه لمنهل الدموع السواكب","https://www.aldiwan.net/poem10894.html","الطويل"],[45,"تظن شجوني لم تعتلج","https://www.aldiwan.net/poem62675.html","المتقارب"],[61,"نطقت بفضل أبي شجاع آية","https://www.aldiwan.net/poem51458.html","الكامل"],[66,"أصم الله أسمعنا الملاما","https://www.aldiwan.net/poem39927.html","الوافر"],[66,"جن الظلام فمذ بدا مبتسما","https://www.aldiwan.net/poem40643.html","الكامل"],[74,"الليل إلا حيث كنت طويل","https://www.aldiwan.net/poem13223.html","الكامل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"الكتب تترى والكتائب تدلف","https://www.aldiwan.net/poem43999.html","الكامل"],[105,"وفد نجران إن أردت الرشادا","https://www.aldiwan.net/poem44017.html","الوافر"],[102,"مرحبا بالثقافة الغربيه","https://www.aldiwan.net/poem33122.html","الخفيف"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[75,"أنظلم أن شمنا بوارق لمحا","https://www.aldiwan.net/poem69094.html","الطويل"],[46,"تدري الحمامة حين تهتف بالضحى","https://www.aldiwan.net/poem23177.html","الكامل"],[46,"تهاون بالظنون وما حدسنه","https://www.aldiwan.net/poem23486.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39641","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55524","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54781","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54858","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54194","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54196","الكامل"],[106,"عصبة الأمم","https://www.poetsgate.com/ViewPoem.aspx?id=179423",""],[45,"هَبيهِ لمُنْهَلّ الدّموعِ السّوَاكِبِ","https://www.poetsgate.com/ViewPoem.aspx?id=31699",""]],"verses":[["وَهَدَّدَ بي الأَعداءُ في المَهدِ لَم يَحِن","نُهوضي وَلَم أَقطَع عُقودَ تَمائِمي",0,"م",2,0],["وهديّةُ الموْلَى تَحُطْ","طُ لفَضْلِها رأسي لَدَيْهِ",1,"ي",2,0],["وهُدَّ لَها إيوانُ كِسْرى مَهابَةً","وأُخْمِدَ منْ نِيرانِ فارِسَ لافِحُ",2,"ح",1,0],["وهدت إليه أسنّة وأسرّة","وَمَوَاكِبٌ وَكَتَائِبٌ وَكِتَابُ",3,"ب",1,0],["وَهَدَمتَ سوراً قَد أَجادَ بِناءَهُ","فِرعَونُ ذو الأَوتادِ وَالأَنهارِ",4,"ر",1,0],["وهدْيُك مهما ضلّتِ الشّهبُ قصدها","تولَّتْهُ في جنح الدُّجُنَّةِ هاديا",5,"ي",2,0],["وهداهُ من وجههِ ضوءُ بدرٍ","نورُه الدهرَ غيرَ ذي اضمحلالِ",6,"ل",1,0],["وهدَّ مِنْ خَلَدِي نَوْحٌ تُرَجِّعُهُ","بَلْوَى الحَيَاةِ وأَحزانُ المَسَاكينِ",7,"ن",1,0],["وهَدَمْتَ صرحاً لا أَلوذُ","بغيرِهِ وهَتَكْتَ سِتْرِي",8,"ي",1,0],["وهَدا خفوقُ البرق والقلبُ الذي","تُطوى عليه جوانحي خفَّاقُ",9,"ق",1,0],["وَهَدَّةِ يَومٍ لِاِبنِ يوسُفَ أَسمَعَت","مِنَ الرومِ ما بَينَ الصَفا وَالأَخاشِبِ",10,"ب",1,0],["وَهَدَّمتَ بَيعَةَ ماسَرجِسٍ","وَأَطفَأتَ نيرانَها وَالسُرُج",11,"ج",1,0],["وَهُدِيتَ منه لنعمةٍ مَكنونةٍ","فأَثَرْتَها مِن تُربةٍ وجَنادِل",12,"ل",1,0],["وَهَدَّ جَنانَ أَثبَتِنا جَناناً","إِذا عَزَمَت أَحِبَّتُنا اِرتِحالا",13,"ل",2,0],["وَهَدَت مُحِبّاً ظَلَّ في لَيلِ الجَفا","لَمّا هَدا وَاِمتَدَّتِ الآناءُ",14,"ا",2,0],["وَهَدَدتَ هَضبَةَ عِزِّهِ فَكَأَنَّها","نَسفاً كَثيبٌ بِالعَراءِ مَهيلُ",15,"ل",1,0],["وهدَّ ببأسِه أُممَاً شِداداً","نُهِيبُ بها وتأبَى أن تلينا",16,"ن",2,0],["وهَديَّةٌ سَاءتْ وسَاءَ حَدِيثُها","فالزّورُ من أسمائِها والزُّخْرُفُ",17,"ف",1,0],["وهداياكَ من مُسُوحٍ وبُسُطٍ","زِيدَ فيها الفنُّ البديعُ وزادا",18,"د",2,0],["وَهُدى جائِرٍ وَسَلوى حَزين","مِن ضَمير حَيّ وَأَصدَق نيه",19,"ي",2,0],["وَهُدِمَت قَلعَتُهُ الحَصينَه","وَأُخِذَت نِعمَتُهُ الثَمينَه",20,"ه",1,0],["وهدّمْتَ ما شادَ العِنادُ وقد رَسَتْ","أواخِيهِ في تلك الهَزاهزِ رُجَّحا",21,"ح",2,0],["وَهَدى لَها قَدرٌ أُتيحَ بِسُدفَةٍ","صَقراً فَفَجَّعَ بِالهَديلِ هِدالَها",22,"ل",3,0],["وَهَدَّ جِبالَها أَقيالُ فِهرٍ","فَتِلكَ رُبوعُها آياً طُمِسنَه",23,"ن",2,0],["وهَدى قبيلاً أو أضلَّ جماعةً","لسبيلِ غيٍّ أو سبيلِ رشادِ",24,"د",1,0],["وَهَدْيُهُ لَمْ يَفُتْهُ","فِي كُلِّ فَنٍّ وَحِرْفَهْ",25,"ف",2,0],["وَهُدَى فَخْرُ نُسْوَةِ الشَّرْقِ مَنْ","أَهْدَى سَبِيلاً إِلى الكَمَالِ وَأَرْشَدْ",26,"د",1,0],["وَهَدَاكَ دُونَهُمُ السَّبِيلُ إلى الَّذي","لَمْ يَبْصُرُوهُ نُورَ فِكْرٍ ثَاقِبِ",27,"ب",1,0],["وَهَدَتْهُ مَعْرِفة مُحَقَّقَةٌ","بِالنَّاسِ فِي تَصْرِيفِهِ الفِكْرَا",28,"ر",2,0],["وهُدَىً في الخيرِ يُرَغِّبُه","وتُقىً في المُلك يزهّدهُ",29,"د",2,0],["وهَدَاهُمْ إلى الحياةِ فَسَارُوا","في حِمىً من لِوَائِهِ المَعْقُودِ",30,"د",1,0],["وَهَدَى الشَّبَابَ إلَى الْحَياةِ فأَدْرَكُوا","مَعْنَى الْحيَاةِ وَعِزَّ الاسْتِقْلالِ",31,"ل",1,0],["وهدَّدت «طوكيو» بالانقسام؟","فآثَرُوا الصمت على الكلام؟",32,"م",1,0],["وِهَدّةِ يَوْمٍ لابنِ يُوسُفَ أسمَعَتْ","منَ الرّومِ ما بَينَ الصّفا فالأخاشِبِ",33,"ب",1,0]]}