8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[6163,"وطئت أقدامنا سطح القمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80802&r=&rc=2",""],[6171,"بيت شعري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86322&r=&rc=0",""],[5393,"فجر من دماء الشهداء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84967&r=&rc=18",""],[6072,"أرَقٌ وغَرَق !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82190&r=&rc=22",""],[6245,"حالات مطرية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87629&r=&rc=0",""],[6251,"الهديل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76469&r=&rc=9",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""],[5126,"فلسطين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87828&r=&rc=43",""],[147,"لِلَّهِ قَدْرُكَ مَا أَجَلَّ وَأَشْرَفا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27438&r=&rc=5",""]],"verses":[["وَهَدَّدَ بي الأَعداءُ في المَهدِ لَم يَحِن","نُهوضي وَلَم أَقطَع عُقودَ تَمائِمي",0,"م",2,0],["وهدوء الكوخ يستفسرني","هل أغنّي للفراغ السادر ؟",1,"ر",1,0],["وهديّةُ الموْلَى تَحُطْ","طُ لفَضْلِها رأسي لَدَيْهِ",2,"ي",2,0],["وهُدَّ لَها إيوانُ كِسْرى مَهابَةً","وأُخْمِدَ منْ نِيرانِ فارِسَ لافِحُ",3,"ح",1,0],["وهدت إليه أسنّة وأسرّة","وَمَوَاكِبٌ وَكَتَائِبٌ وَكِتَابُ",4,"ب",1,0],["وَهَدَمتَ سوراً قَد أَجادَ بِناءَهُ","فِرعَونُ ذو الأَوتادِ وَالأَنهارِ",5,"ر",1,0],["وهدْيُك مهما ضلّتِ الشّهبُ قصدها","تولَّتْهُ في جنح الدُّجُنَّةِ هاديا",6,"ي",2,0],["وهداهُ من وجههِ ضوءُ بدرٍ","نورُه الدهرَ غيرَ ذي اضمحلالِ",7,"ل",1,0],["وهدَّ مِنْ خَلَدِي نَوْحٌ تُرَجِّعُهُ","بَلْوَى الحَيَاةِ وأَحزانُ المَسَاكينِ",8,"ن",1,0],["وهَدَمْتَ صرحاً لا أَلوذُ","بغيرِهِ وهَتَكْتَ سِتْرِي",9,"ر",2,0],["وهَدا خفوقُ البرق والقلبُ الذي","تُطوى عليه جوانحي خفَّاقُ",10,"ق",1,0],["وَهَدَّةِ يَومٍ لِاِبنِ يوسُفَ أَسمَعَت","مِنَ الرومِ ما بَينَ الصَفا وَالأَخاشِبِ",11,"ب",1,0],["وَهَدَّمتَ بَيعَةَ ماسَرجِسٍ","وَأَطفَأتَ نيرانَها وَالسُرُج",12,"ج",1,0],["وَهُدِيتَ منه لنعمةٍ مَكنونةٍ","فأَثَرْتَها مِن تُربةٍ وجَنادِل",13,"ل",1,0],["وَهَدَّ جَنانَ أَثبَتِنا جَناناً","إِذا عَزَمَت أَحِبَّتُنا اِرتِحالا",14,"ل",2,0],["وَهَدَت مُحِبّاً ظَلَّ في لَيلِ الجَفا","لَمّا هَدا وَاِمتَدَّتِ الآناءُ",15,"ا",2,0],["وَهَدَدتَ هَضبَةَ عِزِّهِ فَكَأَنَّها","نَسفاً كَثيبٌ بِالعَراءِ مَهيلُ",16,"ل",1,0],["وهدَّ ببأسِه أُممَاً شِداداً","نُهِيبُ بها وتأبَى أن تلينا",17,"ن",2,0],["وهَديَّةٌ سَاءتْ وسَاءَ حَدِيثُها","فالزّورُ من أسمائِها والزُّخْرُفُ",18,"ف",1,0],["وهداياكَ من مُسُوحٍ وبُسُطٍ","زِيدَ فيها الفنُّ البديعُ وزادا",19,"د",2,0],["وَهُدى جائِرٍ وَسَلوى حَزين","مِن ضَمير حَيّ وَأَصدَق نيه",20,"ي",2,0],["وَهُدِمَت قَلعَتُهُ الحَصينَه","وَأُخِذَت نِعمَتُهُ الثَمينَه",21,"ه",1,0],["وهدّمْتَ ما شادَ العِنادُ وقد رَسَتْ","أواخِيهِ في تلك الهَزاهزِ رُجَّحا",22,"ح",2,0],["وَهَدى لَها قَدرٌ أُتيحَ بِسُدفَةٍ","صَقراً فَفَجَّعَ بِالهَديلِ هِدالَها",23,"ل",3,0],["وَهَدَّ جِبالَها أَقيالُ فِهرٍ","فَتِلكَ رُبوعُها آياً طُمِسنَه",24,"ن",2,0],["وهَدى قبيلاً أو أضلَّ جماعةً","لسبيلِ غيٍّ أو سبيلِ رشادِ",25,"د",1,0],["وَهَدْيُهُ لَمْ يَفُتْهُ","فِي كُلِّ فَنٍّ وَحِرْفَهْ",26,"ف",2,0],["وَهُدَى فَخْرُ نُسْوَةِ الشَّرْقِ مَنْ","أَهْدَى سَبِيلاً إِلى الكَمَالِ وَأَرْشَدْ",27,"د",1,0],["وَهَدَاكَ دُونَهُمُ السَّبِيلُ إلى الَّذي","لَمْ يَبْصُرُوهُ نُورَ فِكْرٍ ثَاقِبِ",28,"ب",1,0],["وَهَدَتْهُ مَعْرِفة مُحَقَّقَةٌ","بِالنَّاسِ فِي تَصْرِيفِهِ الفِكْرَا",29,"ر",2,0],["وهُدَىً في الخيرِ يُرَغِّبُه","وتُقىً في المُلك يزهّدهُ",30,"د",2,0],["وهَدَاهُمْ إلى الحياةِ فَسَارُوا","في حِمىً من لِوَائِهِ المَعْقُودِ",31,"د",1,0],["وَهَدَى الشَّبَابَ إلَى الْحَياةِ فأَدْرَكُوا","مَعْنَى الْحيَاةِ وَعِزَّ الاسْتِقْلالِ",32,"ل",1,0],["وهدَّدت «طوكيو» بالانقسام؟","فآثَرُوا الصمت على الكلام؟",33,"م",1,0],["وهدى الله حظ والحظوظ مقاسم","إلى مقتضى العلم القديم تحور",34,"ر",1,0],["وهدهدت \" مكّة \" الوسنى أناملها","وهزّت الفجر إيذانا بإسفار",35,"ر",1,0],["وِهَدّةِ يَوْمٍ لابنِ يُوسُفَ أسمَعَتْ","منَ الرّومِ ما بَينَ الصّفا فالأخاشِبِ",36,"ب",1,0],["وهدأت برغمي وانصرفت","ولبسنا الصمت على الأشجان",37,"ن",1,0],["وَهَديت الكُهول مِن كُلِ قُطر","لِلمَعالي وَأَنتَ أَصغَرُ سِنّا",38,"ن",2,0],["وَهدَّمني تَشَوقكُم وَلمَّا","لَثِمَت شِفَاهَ أحرُفِكُم بَناني",39,"ن",2,0],["وهَدَّدَ في كُلَيِّمِه وأنَّى","يَخَافُ سَنَا الشُّمَيسِ سَنَا سُهَيلِ",40,"ل",1,0],["وهد ما كان مبنياً على جُرُفٍ","هارٍ ولم يبن من تقوى على دعم",41,"م",1,0],["وَهَدَتهُمُ النَكَباتُ مِن بَعدِ العَمى","يا طالَما جَرَّ الصَلاحَ فَسادُ",42,"د",1,0],["وَهَدَيتَني كَرَماً إِلى سُبُلِ الغِنى","فَلَأُهدِيَنَّ لَكَ الثَناءَ مُفَوَّفا",43,"ف",2,0],["وَهُدىً أَحيا القُلوبَ سَداهُما","فَلا مُدرِكٌ في الخَصلَتَينِ مَداهُما",44,"م",2,0],["وهَديلُ أغْنِيتي تَلا سَهَري","ورويُّ شِعْري في الهَوى وَلَعَا",45,"ع",2,0],["وَهَديتَهُ كَلِماً لَقَد يَمَّنتُها","بِمَقامِ مِحرابٍ لَدَيهِ مُقَدَّسِ",46,"س",1,0],["وَهَدَتهم غيرَ قلبٍ أغلفا","وَالعَمى في القلب لا في الأعينِ",47,"ن",1,0],["وَهدى سِواهم فتيةً تركوا الفتن","روحي فِداهم ما أبرَّ وأكرما",48,"م",2,0],["وَهدّمهُ مِن أصلهِ فَتهدّما","عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما",49,"م",2,0],["وَهَدى كلَّ واحدٍ بألوك","قال خلّوا الجحيم هذا النعيمُ",50,"م",1,0],["وهدَيتني بعد الضلا","لِ إلى الصراطِ المستقيم",51,"م",1,0],["وهدمتَ من بِيَعٍ لهم وكنائسٍ","وكسرتَ من صُلُبٍ ومن أوثان",52,"ن",1,0],["وهدت لقياك روحي","لينابيع الصفاء",53,"ا",2,0],["وهدير القلب أرواحٌ فتيّه","صادحاتٌ بتغاريد شجيّه",54,"ه",1,0],["وَهَدَّ حُكمُك ركنَ الظالِمينَ وَقَد","عَدَلتَ حَتّى أَحبَّ الحَقَّ مَحقوقُ",55,"ق",1,0],["وهداهم إلى صراط سوى","مورث زينة القلوب الفظاظ",56,"ظ",1,0],["وهدانا بعد العمي فانتعشنا","بالنبي المبجل المنعوش",57,"ش",1,0],["وَهُدَّ يَا رَبِّ مَا ابْتَنَاهُ","مِنْ كَعْبَةِ الْجُورِ وَالْفُجُورِ",58,"ر",1,0],["وَهَدَمْتُ مَا شَيَّدْتُ أَيَّامَ الصِّبَا","فِي مَطْمَحِ الآثَامِ أَوْ أَطْلاَلِهَا",59,"ل",3,0],["وَهُدَاكَ جَلَّ هُدَاكَ يَلْزَمُ كُلًّ مَنْ","لَزِمَ الضَّلاَلَ مَحِيصُهُ وَحُيُوصُهُ",60,"ص",2,0],["وهدونا فوق الجياد يرى","وان قلق الوضين",61,"ن",1,0],["وهدي الحاكم بالح","ق كشؤبوب النشاص",62,"ص",1,0],["وَهداه بالوحي الشَريف مفصلا","سورا وَذكرا من لدنه حَكيما",63,"م",2,0],["وَهدم رسم الكفر بالسَيف عنوة","واودع ذا البين داعية الصلح",64,"ح",1,0],["وَهَداني للصَبرِ من ليس يَدري","وَضلالٌ عن مثل حسنكَ صَبري",65,"ي",1,0],["وهديتني نهجَ البيانِ بآية","منه لقد سفرتْ ولم تتبرقع",66,"ع",1,0],["وهدى ضالاً وأَرشد غاوٍ","تائهاً في مفاوز من ضلال",67,"ل",1,0],["وهدمت صرحا للشباب مشيّدا","لتقيم للمجد العظيم سماكا",68,"ك",2,0],["وهداه الحكيم ينبوعه الوح","ي وأخلاقه الفساح الرحاب",69,"ب",1,0],["وَهَداني ضِياء وَجهِكَ لما","تهت في غَبهب الشُعور المَضله",70,"ل",2,0],["وهَدِيُّ مَدْحي ما لَهُ","إلاّ الولاءَ المَحْضَ مَهر",71,"ر",1,0],["وهد عزم اللَمَّه","وغلهم باللِمَّه",72,"ه",1,0],["وهدمت عمداً كل قاعدة","عمرت لأهل العقل والنقل",73,"ل",1,0],["وهداةً إلى سواء السبيل","خيرُ من حَلَّ بقعةً ووطاها",74,"ه",2,0],["وهَدى الله به النَّاس إلى","طُرُق الحقّ وأبدى فيه أمرا",75,"ر",2,0],["وهدية التمليك قد","وافت بنص هاديه",76,"ي",2,0],["وهَدَّ ذُرَى النِّفاقِ فلَيْسَ يَبْنِي","ولا اليربوعُ منه نافِقَاءَ",77,"ا",2,0],["وهُدىً مُبِينٌ لم يُخَلِّ أَخا","جَهْلٍ ولَوْ أَضْحَى أَبا جَهْل",78,"ل",1,0],["وهدىً أحسبُ النجومَ استعارتْ","هُ لإرشادِها رهينَ ضَلالِهْ",79,"ل",2,0],["وَهَدَّمَ بُنْيانَ صَبْري بِهِ","فما أَحَدٌ هَدَّ ما هَدَّما",80,"م",2,0],["وهدِيٍ هَداها سبيلَ العَفَافِ","ورأَيٍ أَراها هُدى كلِّ رَاءِ",81,"ا",2,0],["وهَدْيٌ تهادى إِلَيْهِ العُيونُ","ويُزْهى لَهُ زَمْزَمٌ والحَطِيمُ",82,"م",1,0],["وهَدَّ هَوَاءَ الجَوِّ نَحْوَ بِنائِها","هُوِيَّ سِلامٍ حانَ مَنْ لا تُسَالِمُهْ",83,"م",2,0],["وهُدَاكَ أَشْرَقَ لي ولَيْلِيَ مُظْلِمٌ","وسَناكَ أَبْرَقَ لي وَزَنْدِيَ كابِ",84,"ب",1,0],["وهُدىً لِمَنْ صَلَّى وضَحّى واتَّقى","وزَكَا فَكُنْتَ لَهُ أَجَلَّ ثوابِ",84,"ب",1,0],["وهدم الأَرض من رأس إِلى قدم","وعم لا خص قحطانا ولا مضرا",85,"ر",2,0],["وهدم بيت السؤدد العز والعلا","وحكم المنايا هادم أي هادم",86,"م",1,0],["وهديتم إلى الرشاد أناسا","كاد يغويهم العدو الجهول",87,"ل",1,0],["وهدتْك آراءٌ مظفَّرةٌ","فتحتْ عليك مَغالق السُّبْلِ",88,"ل",1,0],["وهدّمت مذبح مَرْسَرْجِسٍ","وأطفأتُ قنديلَه المشتعِلْ",89,"ل",1,0],["وهدّمَ في اللّه أصنامَهم","بمرآى عيونٍ عليها عُكوفِ",90,"ف",1,0],["وهدمْنا بِيَعَ الغَيْر ولم","نتَّخذْ في الدِّينِ يوماً صَنَمَا",91,"م",2,0],["وهدْمُ مصانعِ التاريخ مرُّ","ولكنّ الفتوحاتِ أمرُّ",92,"ر",1,0],["وهُدبٍ تسقّى نبلُه سُمَّ كُحلِها","فذبّ بشوكِ النّحلِ عن شَهْدةِ الثّغرِ",93,"ر",1,0],["وهدمت منه خلق الدهر أربعة","العلم والحلم والمعروف والكرم",94,"م",1,0],["وَهَدْيُ الصّحْبِ أَفْضَلُ كُلِّ هَدْيٍ","وَأَشْرَفُهُ وإنْ جَحَدَ الجَحُودُ",95,"د",1,0],["وهدوءِ طبعٍ في رزانةِ حكمةٍ","فلهُ وقارُ الكهلِ مُنذُ صِباهُ",96,"ه",1,0],["وهدّدني في كلّ يومٍ وليلةٍ","سَنا وَمْضِهِ بالقارعاتِ الحواطمِ",97,"م",1,0],["وهداني في سُرى اللّي","لِ وقد جُرتُ السّبيلا",98,"ل",2,0],["وهديناكُمُ إلى طُرُقِ الحق","قِ فكنتمْ عنّا غفولاً حَيارى",99,"ر",2,0],["وَهَدّمها مَنْ كان شاد بناءَها","وجرّدَها مَن كان أحكمَ غِمْدَها",100,"د",3,0],["وهدم البيت معلوم فعجل","بكشفك عنك هذا البيت واهي",101,"ي",1,0],["وهدانا إليه برق التجلي","في دياجي إمكاننا بالبريق",102,"ق",1,0],["وهدى الله ظاهرٌ ليس يخفى","عند من آمنوا به يا رشيد",103,"د",1,0],["وَهَدَرَ الجِدُّ مِنَ الناسِ الهَدَر","وَلاحَتِ الحَربُ الوُجوهَ وَالسُرَر",104,"ر",1,0],["وَهَدبق أَهدَبُ غَيفانِيُّ","يَذودُ عَنهُ جِنثُها الجِنثيُّ",105,"ي",1,0],["وهداية بك نهتدي فجميع من","يقفو خطاك إلى الفلاح يسر",106,"ر",1,0],["وَهَدَّدوا المَسجِدَ الحَرامِ وَكَم","دَعا مَلَبٍ فيهِ وَمُعتَمِرُ",107,"ر",1,0],["وَهَديتَهُم سُبُلَ الهُداةِ وَسُستَهُم","بِرياضَةِ الأقوى وَبِرِّ الأضعَفِ",108,"ف",1,0],["وهدتيهم سبل الهدى","بعد التخبط في الوعور",109,"ر",1,0],["وَهَديت الَّذين ضَلّوا بِنَص","في الأَحاديث وَارد مَذكور",110,"ر",1,0],["وَهداه مِن الضلال برأي","ما يُباريه في السَداد مباري",111,"ر",2,0],["وهدى قلبه السّبيل فإمّا","صابراً شاكراً وإمّا كفورا",112,"ر",2,0],["وهدت مبانيه ودكت سفاهةً","فساءت بما تبدي من الهد والدك",113,"ك",1,0],["وَهَدباء تَرمي نِبالاً بِغَمزٍ","أَصابَ فُؤادي فَصادَفَ نارا",114,"ر",2,0],["وهداه ضياءُ نورِ محيَّا","ك ومَحْياه في الدُّنا محياك",115,"ك",1,0],["وهداه مناهجَ الرشدِ حتى","سار في الناس سيرة الأنبياءِ",116,"ا",2,0],["وهدى وجاء بحكمةٍ قد أعجزتْ","مَنْ أحكمَ المنثور والمنظوما",117,"م",2,0],["وهدَّت صروفُ الدهر شامخَ عزَّتي","وقلَّت حماتي عند ذاك وأنصاري",118,"ر",2,0],["وهديةً ضمنت لمن","أمَّ الحمى أن لا يخيب",119,"ب",1,0],["وهدَّم ذاك الحصن صرماً لكيدهم","كذلكم بالماء قد يُخْمَد الضَرَمْ",120,"م",1,0],["وهدى صحابته","ومنه أمدهم أزكى مدد",121,"د",1,0],["وهدت قوى صبري بتشديد صبوتي","وصارت كما قد قبل تبني وتهدم",122,"م",1,0],["وهد له إيوان كسرى مسرة","وأخمد من نار المجوس التضرم",122,"م",1,0],["وهداهم وقال يوفون بالنذ","ر فمن مثلهم يوفي النذورا",123,"ر",2,0],["وَهُدَيبَةَ العُذرِىِّ زَيَّن شِعرَهُ","مَا قَالَ فِى سِجن وقَيدٍ مُثقِلِ",124,"ل",1,0],["وهديت يا نار القرى","وأنرت معتكر الدوامس",125,"س",1,0],["وهديه والذي اقتضاه لنا","منهاجه من جميل سنته",126,"ت",2,0],["وهد من الدين أركانه","وجذ من العدل أغراسه",127,"س",2,0],["وهَّدَ في عِصيانِهِ كلَّ راغبٍ","ورغَّبَ في إِحسانِهِ كلَّ زاهِدِ",128,"د",1,0],["وهداهم سبيله فاحتذوها","يا لك الله من سبيل الهداة",129,"ه",1,0],["وهدى وصار على جميل مكارم","وشريف حال بالعناية مسعد",130,"د",1,0],["وهدى اهدى الجدا وغدا","غدوة للحاذق الفهم",131,"م",1,0],["وهدى إلى نظم اضاء بنظم نز","ر من سنا الآيات والاوصاف",132,"ف",1,0],["وهدم ما أشاعت","عصائب الشيطان",133,"ن",1,0],["وهدّدت أو لالتماس أو دعا","وعاطف ووصل هل ولو معا",134,"ع",2,0],["وهديَّةُ المولى تحطُّ","لفضلها رأسي لديه",135,"ي",2,0],["وهدايةٍ وتقاية وكِفايةٍ","وغناية ورعاية ووفاءِ",136,"ا",2,0],["وهداهم من الضلال فكانوا","أمة شرفت بأكرم هاد",137,"د",1,0],["وهدت منه والزفرات جسماً","ضعيفاً عن تحملّه الثيابا",138,"ب",2,0],["وهدمت آمالا كبا","را لا ينوء بها سواه",139,"ا",2,0],["وَهَدَّتِ الرُكنَ الَّذي كانَ بِال","أَمسِ عِماداً غَيرَ مَعمودِ",140,"د",1,0],["وهدت قالة القريض نجومٌ","طلعت في سماءِ طرسكَ زُهرا",141,"ر",2,0],["وهدتني بوجهِها وهو بدرٌ","تحت ليلٍ أظلَّني وهو شعر",142,"ر",1,0],["وهَدَت بي الرحالَ عَنسٌ زفوفٌ","سهوَةُ المشيِ لاقِحٌ عن حيالِ",143,"ل",1,0],["وَهَديتَنا سبلاً بهن سبقتنا","حييت من هادٍ ومن سبّاق",144,"ق",1,0],["وَهَديٌ لَو اِستَشفى المُعَنّى بِرَوحِهِ","لَما كانَ بِالوَجدِ المُبَرِّحِ صالِيا",145,"ي",2,0],["وهدى الشيب والشباب صراطاً","مستقيماً والخير في المستقيم",146,"م",1,0],["وهديتنا سهل العلوم قواصداً","فالغور نجد والحزون سهول",147,"ل",1,0],["وهُدّت لذاك الارض حتى كأنها","بكته الجبال الصمُّ وانصدع الفجرُ",148,"ر",1,0],["وهدَّ به هُضباً رَوَاسِيَ شُمَّخاً","تكَادُ بها الدُّنيَا تمِيدُ بأركانِ",149,"ن",1,0],["وهدد بالردى إن لم يقوض","فخاف فأعمل الركض الشديدا",150,"د",2,0],["وهدت مصيبتك العالمين","فلم نلق غلا شجياً ثكولا",151,"ل",2,0],["وَهَدى أَبا ظبيانَ صِدقُ حَديثِهِ","فَلِظَابِهِ شَرفٌ بِهِ وَتَقَدُّمُ",152,"م",1,0],["وهدانا به الإله فجلى","ظلم الظلم فهي ذات انجياب",153,"ب",1,0],["وهدايةً وعنايةً وكفايةً","ووقايةً من صولة الأشرار",154,"ر",1,0],["وَهَديتُمونَا للَّذِي لَم يَهتَدُوا","أبَداً بهِ وَاشِدَّةً الحِرمَانِ",155,"ن",1,0],["وَهَداكَ لِلفِردَوسِ تَحسو","الصَفوَ مِن تَسنيمِهِ",156,"م",2,0],["وهداة إن جنّ للغي ليل","فبهم تبصر الأنام هداها",157,"ا",3,0],["وهُدَّت خيامُ المصيف فلا","ظلالَ بأكنافها يطمع",158,"ع",1,0],["وهدّدني أهلوك فيك وإنّني","لتَصغُر عندي في لِقاك الكبائرُ",159,"ر",1,0],["وهدايةُ الله العَمى مِن ناظري","وهُدَى الورى وكفى به من هاد",160,"د",1,0],["وهَدّدَوُني فتجنّبتُها","تجنّبَ العَطشان للمنهل",161,"ل",1,0],["وهددوها فأتتني لها","رسالةٌ نفسي فِدى المُرْسِل",161,"ل",1,0],["وَهدَّم هادم اللذات مِنهُ","بِشاهقة العُلى حُصناً مَنيعا",162,"ع",2,0],["وَهدَّمك القَضا ركناً رَكينا","وَقَلصك الرَدى ظلا ظَليلا",163,"ل",2,0],["وَهدانا الطَريق في خَير رشد","حَيث لَولاه ما اِهتَدَينا الطَريقا",164,"ق",2,0],["وهدى الامير إلى مناهج قصده","ومع الدلاء على المياه حبائل",165,"ل",1,0],["وَهَدَّمنا صَوامِعَ شَيَّدَتها","لَها حَبَبٌ مَخالِطُها نَجيلُ",166,"ل",1,0],["وَهَديلَ الوُرق عَلى غُصُنٍ","وَضَجيجَ النَهر المنساب",167,"ب",1,0],["وهدّ ببعثه ركن الأعادي","وشدّد عزمه وأشاد ركنه",168,"ن",2,0],["وهدانا شذى من الدير دارته","كأسهُ قبل حثِّ كأس العقارِ",169,"ر",1,0],["وَهُدّاءٌ أَجَبنَ لَنا بَريداً","عَلى سَرَعٍ فَبَهَّلنَ الهَجينا",170,"ن",2,0],["وهديت إرشاداً إلى نفحاتهم","وفتحت كنز 