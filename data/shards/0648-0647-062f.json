,[197,"حب تغلغل في الصميم","https://www.aldiwan.net/poem39893.html","مجزوء الكامل"],[198,"الجيش يملي نصره الملوان","https://www.aldiwan.net/poem51881.html","الكامل"],[211,"ما الذي أنكرت مني","https://www.aldiwan.net/poem46347.html","مجزوء الرمل"],[211,"بعد أعوام طوال وطوال","https://www.aldiwan.net/poem46781.html","الرمل"],[225,"إن هيم الشعراء الثغر والريق","https://www.aldiwan.net/poem55236.html","البسيط"],[231,"عدتي للحياة والموت والحشر","https://www.aldiwan.net/poem44583.html","الخفيف"],[231,"قم فبادر قبيل رفع النعوش","https://www.aldiwan.net/poem44587.html","الخفيف"],[237,"لقيت يا رب من غمور","https://www.aldiwan.net/poem18813.html","مجزوء البسيط"],[237,"كم ذا تقرطسني بسمر نبالها","https://www.aldiwan.net/poem18851.html","الكامل"],[237,"أما رضاك عمومه وخصوصه","https://www.aldiwan.net/poem19297.html","الكامل"],[261,"إنا لتقتلنا العيون","https://www.aldiwan.net/poem38164.html","مجزوء الكامل"],[261,"هل هوى تلك العراص","https://www.aldiwan.net/poem38247.html","مجزوء الرمل"],[271,"أعلمت من ركب البراق عتيما","https://www.aldiwan.net/poem52097.html","الكامل"],[271,"كلام بلا نحو طعام بلا ملح","https://www.aldiwan.net/poem52102.html","الطويل"],[297,"بك في ملة الغرام اقتديت","https://www.aldiwan.net/poem33080.html","الخفيف"],[298,"ذهب الهوى بشغاف قلب الموجع","https://www.aldiwan.net/poem36280.html","عموديه"],[304,"حي ظبي الرمال والأطلال","https://www.aldiwan.net/poem16833.html","الخفيف"],[328,"طال الطريق فمن يقول لسادر","https://www.aldiwan.net/poem54951.html","الكامل"],[328,"كل حب مصيره اللذهاب","https://www.aldiwan.net/poem54963.html","الخفيف"],[361,"يا مليحا قد أبدع الله شكله","https://www.aldiwan.net/poem68073.html","الخفيف"],[364,"في الجيرة الغادين بدر","https://www.aldiwan.net/poem60895.html","مجزوء الكامل"],[377,"يا صاح إسمع مذ سمت","https://www.aldiwan.net/poem66909.html","مجزوء الرجز"],[403,"هل في الرفاق متيم مثلي","https://www.aldiwan.net/poem33609.html","الكامل"],[416,"ما قضينا حقا لرسم محيل","https://www.aldiwan.net/poem53816.html","الخفيف"],[416,"ما لها تطوي فيافي الأرض سيرا","https://www.aldiwan.net/poem53994.html","الرمل"],[429,"ورق التهاني الوافيه","https://www.aldiwan.net/poem41000.html","مجزوء الكامل"],[432,"سعود سنيكما كملت سناء","https://www.aldiwan.net/poem12355.html","الوافر"],[432,"أبدى الفرند نجابة النصل","https://www.aldiwan.net/poem12430.html","أحذ الكامل"],[432,"يا جمال الخلافة المحرز المجد","https://www.aldiwan.net/poem12706.html","الخفيف"],[434,"رمى حر قلبي بأجفانه","https://www.aldiwan.net/poem25700.html","المتقارب"],[439,"وأهد بها في الفلا والسرى","https://www.aldiwan.net/poem34834.html","المتقارب"],[439,"نجوم الصبا أين تلك النجوم","https://www.aldiwan.net/poem34849.html","المتقارب"],[439,"تتبين شمل الدين أنك ناظمه","https://www.aldiwan.net/poem34869.html","الطويل"],[439,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[441,"هذا هو الرزء الجن والبشرا","https://www.aldiwan.net/poem14454.html","البسيط"],[441,"هو الرزء حتى خص ريش القوادم","https://www.aldiwan.net/poem14478.html","الطويل"],[443,"كل حمد لما صنعتم قليل","https://www.aldiwan.net/poem56020.html","عموديه"],[458,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[458,"إذا عارض نحو أرض عدل","https://www.aldiwan.net/poem56076.html","المتقارب"],[458,"مشين لنا بين ميل وهيف","https://www.aldiwan.net/poem56114.html","المتقارب"],[500,"طرق السر من البرهان ما","https://www.aldiwan.net/poem37802.html","الرمل"],[505,"المفر","https://www.aldiwan.net/poem27797.html","الوافر"],[514,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[515,"ثغر الزمان بنجم الدين مبتسم","https://www.aldiwan.net/poem12263.html","البسيط"],[529,"إلى الدرعية الغراء تسري","https://www.aldiwan.net/poem37443.html","الوافر"],[538,"بإيابك الميمون أشرق نور","https://www.aldiwan.net/poem47426.html","عموديه"],[551,"هل الشيب إلا غصة في الحيازم","https://www.aldiwan.net/poem47203.html","الطويل"],[551,"جلب البرق لقلبي","https://www.aldiwan.net/poem47298.html","مجزوء الرمل"],[551,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[551,"ألا هل أتاها كيف حزني بعدها","https://www.aldiwan.net/poem47860.html","الطويل"],[558,"عليك بروحك السر الإلهي","https://www.aldiwan.net/poem33652.html","الوافر"],[558,"كل شيء لنا على التحقيق","https://www.aldiwan.net/poem34318.html","الخفيف"],[558,"إنما الدين كله تقليد","https://www.aldiwan.net/poem34595.html","الخفيف"],[561,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[561,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"]],"verses":[["وَهَدَّدَ بي الأَعداءُ في المَهدِ لَم يَحِن","نُهوضي وَلَم أَقطَع عُقودَ تَمائِمي",0,"م",2,0],["وهدوء الكوخ يستفسرني","هل أغنّي للفراغ السادر ؟",1,"ر",1,0],["وهديّةُ الموْلَى تَحُطْ","طُ لفَضْلِها رأسي لَدَيْهِ",2,"ي",2,0],["وهُدَّ لَها إيوانُ كِسْرى مَهابَةً","وأُخْمِدَ منْ نِيرانِ فارِسَ لافِحُ",3,"ح",1,0],["وهدت إليه أسنّة وأسرّة","وَمَوَاكِبٌ وَكَتَائِبٌ وَكِتَابُ",4,"ب",1,0],["وَهَدَمتَ سوراً قَد أَجادَ بِناءَهُ","فِرعَونُ ذو الأَوتادِ وَالأَنهارِ",5,"ر",1,0],["وهدْيُك مهما ضلّتِ الشّهبُ قصدها","تولَّتْهُ في جنح الدُّجُنَّةِ هاديا",6,"ي",2,0],["وهداهُ من وجههِ ضوءُ بدرٍ","نورُه الدهرَ غيرَ ذي اضمحلالِ",7,"ل",1,0],["وهدَّ مِنْ خَلَدِي نَوْحٌ تُرَجِّعُهُ","بَلْوَى الحَيَاةِ وأَحزانُ المَسَاكينِ",8,"ن",1,0],["وهَدَمْتَ صرحاً لا أَلوذُ","بغيرِهِ وهَتَكْتَ سِتْرِي",9,"ي",1,0],["وهَدا خفوقُ البرق والقلبُ الذي","تُطوى عليه جوانحي خفَّاقُ",10,"ق",1,0],["وَهَدَّةِ يَومٍ لِاِبنِ يوسُفَ أَسمَعَت","مِنَ الرومِ ما بَينَ الصَفا وَالأَخاشِبِ",11,"ب",1,0],["وَهَدَّمتَ بَيعَةَ ماسَرجِسٍ","وَأَطفَأتَ نيرانَها وَالسُرُج",12,"ج",1,0],["وَهُدِيتَ منه لنعمةٍ مَكنونةٍ","فأَثَرْتَها مِن تُربةٍ وجَنادِل",13,"ل",1,0],["وَهَدَّ جَنانَ أَثبَتِنا جَناناً","إِذا عَزَمَت أَحِبَّتُنا اِرتِحالا",14,"ل",2,0],["وَهَدَت مُحِبّاً ظَلَّ في لَيلِ الجَفا","لَمّا هَدا وَاِمتَدَّتِ الآناءُ",15,"ا",2,0],["وَهَدَدتَ هَضبَةَ عِزِّهِ فَكَأَنَّها","نَسفاً كَثيبٌ بِالعَراءِ مَهيلُ",16,"ل",1,0],["وهدَّ ببأسِه أُممَاً شِداداً","نُهِيبُ بها وتأبَى أن تلينا",17,"ن",2,0],["وهَديَّةٌ سَاءتْ وسَاءَ حَدِيثُها","فالزّورُ من أسمائِها والزُّخْرُفُ",18,"ف",1,0],["وهداياكَ من مُسُوحٍ وبُسُطٍ","زِيدَ فيها الفنُّ البديعُ وزادا",19,"د",2,0],["وَهُدى جائِرٍ وَسَلوى حَزين","مِن ضَمير حَيّ وَأَصدَق نيه",20,"ي",2,0],["وَهُدِمَت قَلعَتُهُ الحَصينَه","وَأُخِذَت نِعمَتُهُ الثَمينَه",21,"ه",1,0],["وهدّمْتَ ما شادَ العِنادُ وقد رَسَتْ","أواخِيهِ في تلك الهَزاهزِ رُجَّحا",22,"ح",2,0],["وَهَدى لَها قَدرٌ أُتيحَ بِسُدفَةٍ","صَقراً فَفَجَّعَ بِالهَديلِ هِدالَها",23,"ل",3,0],["وَهَدَّ جِبالَها أَقيالُ فِهرٍ","فَتِلكَ رُبوعُها آياً طُمِسنَه",24,"ن",2,0],["وهَدى قبيلاً أو أضلَّ جماعةً","لسبيلِ غيٍّ أو سبيلِ رشادِ",25,"د",1,0],["وَهَدْيُهُ لَمْ يَفُتْهُ","فِي كُلِّ فَنٍّ وَحِرْفَهْ",26,"ف",2,0],["وَهُدَى فَخْرُ نُسْوَةِ الشَّرْقِ مَنْ","أَهْدَى سَبِيلاً إِلى الكَمَالِ وَأَرْشَدْ",27,"د",1,0],["وَهَدَاكَ دُونَهُمُ السَّبِيلُ إلى الَّذي","لَمْ يَبْصُرُوهُ نُورَ فِكْرٍ ثَاقِبِ",28,"ب",1,0],["وَهَدَتْهُ مَعْرِفة مُحَقَّقَةٌ","بِالنَّاسِ فِي تَصْرِيفِهِ الفِكْرَا",29,"ر",2,0],["وهُدَىً في الخيرِ يُرَغِّبُه","وتُقىً في المُلك يزهّدهُ",30,"د",2,0],["وهَدَاهُمْ إلى الحياةِ فَسَارُوا","في حِمىً من لِوَائِهِ المَعْقُودِ",31,"د",1,0],["وَهَدَى الشَّبَابَ إلَى الْحَياةِ فأَدْرَكُوا","مَعْنَى الْحيَاةِ وَعِزَّ الاسْتِقْلالِ",32,"ل",1,0],["وهدَّدت «طوكيو» بالانقسام؟","فآثَرُوا الصمت على الكلام؟",33,"م",1,0],["وهدهدت \" مكّة \" الوسنى أناملها","وهزّت الفجر إيذانا بإسفار",34,"ر",1,0],["وِهَدّةِ يَوْمٍ لابنِ يُوسُفَ أسمَعَتْ","منَ الرّومِ ما بَينَ الصّفا فالأخاشِبِ",35,"ب",1,0],["وهدأت برغمي وانصرفت","ولبسنا الصمت على الأشجان",36,"ن",1,0],["وَهَديت الكُهول مِن كُلِ قُطر","لِلمَعالي وَأَنتَ أَصغَرُ سِنّا",37,"ن",2,0],["وَهدَّمني تَشَوقكُم وَلمَّا","لَثِمَت شِفَاهَ أحرُفِكُم بَناني",38,"ن",2,0],["وهَدَّدَ في كُلَيِّمِه وأنَّى","يَخَافُ سَنَا الشُّمَيسِ سَنَا سُهَيلِ",39,"ل",1,0],["وهد ما كان مبنياً على جُرُفٍ","هارٍ ولم يبن من تقوى على دعم",40,"م",1,0],["وَهَدَتهُمُ النَكَباتُ مِن بَعدِ العَمى","يا طالَما جَرَّ الصَلاحَ فَسادُ",41,"د",1,0],["وَهَدَيتَني كَرَماً إِلى سُبُلِ الغِنى","فَلَأُهدِيَنَّ لَكَ الثَناءَ مُفَوَّفا",42,"ف",2,0],["وَهُدىً أَحيا القُلوبَ سَداهُما","فَلا مُدرِكٌ في الخَصلَتَينِ مَداهُما",43,"م",2,0],["وهَديلُ أغْنِيتي تَلا سَهَري","ورويُّ شِعْري في الهَوى وَلَعَا",44,"ع",2,0],["وَهَديتَهُ كَلِماً لَقَد يَمَّنتُها","بِمَقامِ مِحرابٍ لَدَيهِ مُقَدَّسِ",45,"س",1,0],["وَهَدَتهم غيرَ قلبٍ أغلفا","وَالعَمى في القلب لا في الأعينِ",46,"ن",1,0],["وَهدى سِواهم فتيةً تركوا الفتن","روحي فِداهم ما أبرَّ وأكرما",47,"م",2,0],["وَهدّمهُ مِن أصلهِ فَتهدّما","عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما",48,"م",2,0],["وَهَدى كلَّ واحدٍ بألوك","قال خلّوا الجحيم هذا النعيمُ",49,"م",1,0],["وهدَيتني بعد الضلا","لِ إلى الصراطِ المستقيم",50,"م",1,0],["وهدمتَ من بِيَعٍ لهم وكنائسٍ","وكسرتَ من صُلُبٍ ومن أوثان",51,"ن",1,0],["وهدت لقياك روحي","لينابيع الصفاء",52,"ا",2,0],["وهدير القلب أرواحٌ فتيّه","صادحاتٌ بتغاريد شجيّه",53,"ه",1,0],["وَهَدَّ حُكمُك ركنَ الظالِمينَ وَقَد","عَدَلتَ حَتّى أَحبَّ الحَقَّ مَحقوقُ",54,"ق",1,0],["وهداهم إلى صراط سوى","مورث زينة القلوب الفظاظ",55,"ظ",1,0],["وهدانا بعد العمي فانتعشنا","بالنبي المبجل المنعوش",56,"ش",1,0],["وَهُدَّ يَا رَبِّ مَا ابْتَنَاهُ","مِنْ كَعْبَةِ الْجُورِ وَالْفُجُورِ",57,"ر",1,0],["وَهَدَمْتُ مَا شَيَّدْتُ أَيَّامَ الصِّبَا","فِي مَطْمَحِ الآثَامِ أَوْ أَطْلاَلِهَا",58,"ل",3,0],["وَهُدَاكَ جَلَّ هُدَاكَ يَلْزَمُ كُلًّ مَنْ","لَزِمَ الضَّلاَلَ مَحِيصُهُ وَحُيُوصُهُ",59,"ص",2,0],["وهدونا فوق الجياد يرى","وان قلق الوضين",60,"ن",1,0],["وهدي الحاكم بالح","ق كشؤبوب النشاص",61,"ص",1,0],["وَهداه بالوحي الشَريف مفصلا","سورا وَذكرا من لدنه حَكيما",62,"م",2,0],["وَهدم رسم الكفر بالسَيف عنوة","واودع ذا البين داعية الصلح",63,"ح",1,0],["وَهَداني للصَبرِ من ليس يَدري","وَضلالٌ عن مثل حسنكَ صَبري",64,"ي",1,0],["وهديتني نهجَ البيانِ بآية","منه لقد سفرتْ ولم تتبرقع",65,"ع",1,0],["وهدى ضالاً وأَرشد غاوٍ","تائهاً في مفاوز من ضلال",66,"ل",1,0],["وهدمت صرحا للشباب مشيّدا","لتقيم للمجد العظيم سماكا",67,"ك",2,0],["وهداه الحكيم ينبوعه الوح","ي وأخلاقه الفساح الرحاب",68,"ب",1,0],["وَهَداني ضِياء وَجهِكَ لما","تهت في غَبهب الشُعور المَضله",69,"ل",2,0],["وهَدِيُّ مَدْحي ما لَهُ","إلاّ الولاءَ المَحْضَ مَهر",70,"ر",1,0],["وهد عزم اللَمَّه","وغلهم باللِمَّه",71,"ه",1,0],["وهدمت عمداً كل قاعدة","عمرت لأهل العقل والنقل",72,"ل",1,0],["وهداةً إلى سواء السبيل","خيرُ من حَلَّ بقعةً ووطاها",73,"ه",2,0],["وهَدى الله به النَّاس إلى","طُرُق الحقّ وأبدى فيه أمرا",74,"ر",2,0],["وهدية التمليك قد","وافت بنص هاديه",75,"ي",2,0],["وهَدَّ ذُرَى النِّفاقِ فلَيْسَ يَبْنِي","ولا اليربوعُ منه نافِقَاءَ",76,"ا",2,0],["وهُدىً مُبِينٌ لم يُخَلِّ أَخا","جَهْلٍ ولَوْ أَضْحَى أَبا جَهْل",77,"ل",1,0],["وهدىً أحسبُ النجومَ استعارتْ","هُ لإرشادِها رهينَ ضَلالِهْ",78,"ل",2,0],["وَهَدَّمَ بُنْيانَ صَبْري بِهِ","فما أَحَدٌ هَدَّ ما هَدَّما",79,"م",2,0],["وهدِيٍ هَداها سبيلَ العَفَافِ","ورأَيٍ أَراها هُدى كلِّ رَاءِ",80,"ا",2,0],["وهَدْيٌ تهادى إِلَيْهِ العُيونُ","ويُزْهى لَهُ زَمْزَمٌ والحَطِيمُ",81,"م",1,0],["وهَدَّ هَوَاءَ الجَوِّ نَحْوَ بِنائِها","هُوِيَّ سِلامٍ حانَ مَنْ لا تُسَالِمُهْ",82,"م",2,0],["وهُدَاكَ أَشْرَقَ لي ولَيْلِيَ مُظْلِمٌ","وسَناكَ أَبْرَقَ لي وَزَنْدِيَ كابِ",83,"ب",1,0],["وهُدىً لِمَنْ صَلَّى وضَحّى واتَّقى","وزَكَا فَكُنْتَ لَهُ أَجَلَّ ثوابِ",83,"ب",1,0],["وهدم الأَرض من رأس إِلى قدم","وعم لا خص قحطانا ولا مضرا",84,"ر",2,0],["وهدم بيت السؤدد العز والعلا","وحكم المنايا هادم أي هادم",85,"م",1,0],["وهديتم إلى الرشاد أناسا","كاد يغويهم العدو الجهول",86,"ل",1,0],["وهدتْك آراءٌ مظفَّرةٌ","فتحتْ عليك مَغالق السُّبْلِ",87,"ل",1,0],["وهدّمت مذبح مَرْسَرْجِسٍ","وأطفأتُ قنديلَه المشتعِلْ",88,"ل",1,0],["وهدّمَ في اللّه أصنامَهم","بمرآى عيونٍ عليها عُكوفِ",89,"ف",1,0],["وهدمْنا بِيَعَ الغَيْر ولم","نتَّخذْ في الدِّينِ يوماً صَنَمَا",90,"م",2,0],["وهدْمُ مصانعِ التاريخ مرُّ","ولكنّ الفتوحاتِ أمرُّ",91,"ر",1,0],["وهُدبٍ تسقّى نبلُه سُمَّ كُحلِها","فذبّ بشوكِ النّحلِ عن شَهْدةِ الثّغرِ",92,"ر",1,0],["وهدمت منه خلق الدهر أربعة","العلم والحلم والمعروف والكرم",93,"م",1,0],["وَهَدْيُ الصّحْبِ أَفْضَلُ كُلِّ هَدْيٍ","وَأَشْرَفُهُ وإنْ جَحَدَ الجَحُودُ",94,"د",1,0],["وهدوءِ طبعٍ في رزانةِ حكمةٍ","فلهُ وقارُ الكهلِ مُنذُ صِباهُ",95,"ه",1,0],["وهدّدني في كلّ يومٍ وليلةٍ","سَنا وَمْضِهِ بالقارعاتِ الحواطمِ",96,"م",1,0],["وهداني في سُرى اللّي","لِ وقد جُرتُ السّبيلا",97,"ل",2,0],["وهديناكُمُ إلى طُرُقِ الحق","قِ فكنتمْ عنّا غفولاً حَيارى",98,"ر",2,0],["وَهَدّمها مَنْ كان شاد بناءَها","وجرّدَها مَن كان أحكمَ غِمْدَها",99,"د",3,0],["وهدم البيت معلوم فعجل","بكشفك عنك هذا البيت واهي",100,"ي",1,0],["وهدانا إليه برق التجلي","في دياجي إمكاننا بالبريق",101,"ق",1,0],["وهدى الله ظاهرٌ ليس يخفى","عند من آمنوا به يا رشيد",102,"د",1,0],["وَهَدَرَ الجِدُّ مِنَ الناسِ الهَدَر","وَلاحَتِ الحَربُ الوُجوهَ وَالسُرَر",103,"ر",1,0],["وَهَدبق أَهدَبُ غَيفانِيُّ","يَذودُ عَنهُ جِنثُها الجِنثيُّ",104,"ي",1,0]]}