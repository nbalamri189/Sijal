بان","ببيوت عز ٍ للشعالين تبنا",256,"ن",2,0],["وهد بمطار الجوف والربع حيوك","وترتاح من عقب السفر عن نواياك",257,"ك",1,0],["وَهَدْيُكَ للنَّجْدَيْنِ وَجْهَانِ أَزْهَرَا","بِرُوحٍ تَرَاءَتْ للنُّفُوسِ سِمَاتُهَا",258,"ت",3,0],["وهد فقدك يا طود العلوم قوى","ليث الشرى أسد من أرغم اليهما",259,"م",2,0],["وهد من شاهقات الدين ركن هدىً","ما كان جانبه السامي بمنهدم",260,"م",1,0],["وَهَدَمتُ ما شَيَّدتُ أَيّامَ الصِبا","في مطَمَعِ الآثامِ أَو أَصلالِها",261,"ل",3,0],["وَهدتها صيانة المُتحلل","وَأَحاديث إن وعد رَسول اللَ",262,"ل",1,0],["وهدير الآلة الصخّاب قد","عانق الآفاق في شتّى الصور",263,"ر",1,0],["وهدوءٌ ماثلٌ لا ينتهي","وعراكٌ ومواويلٌ وسكرة",264,"ر",2,0],["وهدَّني حزني وأعياني البكاءْ","كم من قلوب مُزقت من أجل صبح الأنبياءْ",265,"ا",2,0],["وهَدْهَدَتْ رئتي من لهفةٍ سُحُباً","فهل رأيتِ عُلُوَّاً رهنَ أعماقِ ؟",266,"ق",1,0],["وَ هَدِيلُ عَانِسَةٍ يَنَامُ بِقُرْبِهَا","أَلْفُ انْتِظَارٍ.. صَبْرُهَا كَذَّابُ",267,"ب",1,0],["وهَدِيْلُ الحَمَامِ والضَّوءُ والأنْدَاءُ","والزَّهْرُ والفَرَاشَاتُ صَحْبِي",268,"ب",2,0],["وهَدَتْ طيورَ البرِّ تروي حرَّها","طابَ الهوى عندي وطابِ المشرَبُ",269,"ب",1,0],["وهدّم بنْياناً أقامت دعامه","فإنّ بناءَ الظلم أرسى بناءَها",270,"ا",3,0],["وَهَدَيْتَنِي كَرَماً إِلى سُبُلِ الْغِنى","فلأهدينَّ لكَ الثَّناءَ مفوَّقا",271,"ق",2,0]]}