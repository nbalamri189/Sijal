{"poems":[[53,"من الركب ما بين النقا والأناعم","https://www.aldiwan.net/poem29748.html","الطويل"],[77,"قد كان يسكر شربه","https://www.aldiwan.net/poem35861.html","مجزوء الكامل"],[77,"أثار سراها والديار نوازح","https://www.aldiwan.net/poem36644.html","الطويل"],[77,"هي أسعد ما دونهن حجاب","https://www.aldiwan.net/poem36780.html","الطويل"],[86,"نثروا عليك نوادي الأزهار","https://www.aldiwan.net/poem10492.html","الكامل"],[83,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[92,"يا ربة الشعر والأحلام غنيني","https://www.aldiwan.net/poem38900.html","الكامل"],[92,"يا موت قد مزقت صدري","https://www.aldiwan.net/poem38940.html","مجزوء الكامل"],[62,"ياقلب ما لك والهوى من بعد ما","https://www.aldiwan.net/poem52334.html","الكامل"],[45,"هبيه لمنهل الدموع السواكب","https://www.aldiwan.net/poem10894.html","الطويل"],[45,"تظن شجوني لم تعتلج","https://www.aldiwan.net/poem62675.html","المتقارب"],[61,"نطقت بفضل أبي شجاع آية","https://www.aldiwan.net/poem51458.html","الكامل"],[66,"أصم الله أسمعنا الملاما","https://www.aldiwan.net/poem39927.html","الوافر"],[66,"جن الظلام فمذ بدا مبتسما","https://www.aldiwan.net/poem40643.html","الكامل"],[74,"الليل إلا حيث كنت طويل","https://www.aldiwan.net/poem13223.html","الكامل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"الكتب تترى والكتائب تدلف","https://www.aldiwan.net/poem43999.html","الكامل"],[105,"وفد نجران إن أردت الرشادا","https://www.aldiwan.net/poem44017.html","الوافر"],[102,"مرحبا بالثقافة الغربيه","https://www.aldiwan.net/poem33122.html","الخفيف"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[75,"أنظلم أن شمنا بوارق لمحا","https://www.aldiwan.net/poem69094.html","الطويل"],[46,"تدري الحمامة حين تهتف بالضحى","https://www.aldiwan.net/poem23177.html","الكامل"],[46,"تهاون بالظنون وما حدسنه","https://www.aldiwan.net/poem23486.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39641","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55524","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54781","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54858","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54194","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54196","الكامل"],[106,"عصبة الأمم","https://www.poetsgate.com/ViewPoem.aspx?id=179423",""],[45,"هَبيهِ لمُنْهَلّ الدّموعِ السّوَاكِبِ","https://www.poetsgate.com/ViewPoem.aspx?id=31699",""],[107,"سائق الظعن بالحدوج تأنى","https://www.aldiwan.net/poem16294.html","الخفيف"],[130,"كتاب فيه خطك فيه حظى","https://www.aldiwan.net/poem54708.html","الوافر"],[130,"أثار غريمى وشجا عقيلى","https://www.aldiwan.net/poem54762.html","الطويل"],[131,"أهدي إليك ثناء العرب والعجم","https://www.aldiwan.net/poem4217.html","البسيط"],[141,"فت الورى فعلام ذا الإجهاد","https://www.aldiwan.net/poem11754.html","الكامل"],[141,"لله قدرك ما أجل وأشرفا","https://www.aldiwan.net/poem11781.html","الكامل"],[148,"اعد ذكر خير الخلق فالعود أحمد","https://www.aldiwan.net/poem68577.html","الطويل"],[176,"سرّ الهوى","https://www.aldiwan.net/poem50711.html","أحذ الكامل"],[180,"رقص الهزار على الغصون الميس","https://www.aldiwan.net/poem67056.html","الكامل"],[187,"لست أنسى زمنا قد سلفا","https://www.aldiwan.net/poem35098.html","الرمل"],[187,"أقبل على مدح النبي مفخما","https://www.aldiwan.net/poem35104.html","الكامل"],[187,"رأى مدح خير الخلق صعبا فأحجما","https://www.aldiwan.net/poem35105.html","الرمل"],[187,"سيد الرسل قدره معلوم","https://www.aldiwan.net/poem35108.html","الخفيف"],[195,"حب تغلغل في الصميم","https://www.aldiwan.net/poem39893.html","مجزوء الكامل"],[196,"الجيش يملي نصره الملوان","https://www.aldiwan.net/poem51881.html","الكامل"],[209,"ما الذي أنكرت مني","https://www.aldiwan.net/poem46347.html","مجزوء الرمل"],[209,"بعد أعوام طوال وطوال","https://www.aldiwan.net/poem46781.html","الرمل"],[223,"إن هيم الشعراء الثغر والريق","https://www.aldiwan.net/poem55236.html","البسيط"],[229,"عدتي للحياة والموت والحشر","https://www.aldiwan.net/poem44583.html","الخفيف"],[229,"قم فبادر قبيل رفع النعوش","https://www.aldiwan.net/poem44587.html","الخفيف"],[235,"لقيت يا رب من غمور","https://www.aldiwan.net/poem18813.html","مجزوء البسيط"],[235,"كم ذا تقرطسني بسمر نبالها","https://www.aldiwan.net/poem18851.html","الكامل"],[235,"أما رضاك عمومه وخصوصه","https://www.aldiwan.net/poem19297.html","الكامل"],[259,"إنا لتقتلنا العيون","https://www.aldiwan.net/poem38164.html","مجزوء الكامل"],[259,"هل هوى تلك العراص","https://www.aldiwan.net/poem38247.html","مجزوء الرمل"],[269,"أعلمت من ركب البراق عتيما","https://www.aldiwan.net/poem52097.html","الكامل"],[269,"كلام بلا نحو طعام بلا ملح","https://www.aldiwan.net/poem52102.html","الطويل"],[295,"بك في ملة الغرام اقتديت","https://www.aldiwan.net/poem33080.html","الخفيف"],[296,"ذهب الهوى بشغاف قلب الموجع","https://www.aldiwan.net/poem36280.html","عموديه"],[302,"حي ظبي الرمال والأطلال","https://www.aldiwan.net/poem16833.html","الخفيف"],[326,"طال الطريق فمن يقول لسادر","https://www.aldiwan.net/poem54951.html","الكامل"],[326,"كل حب مصيره اللذهاب","https://www.aldiwan.net/poem54963.html","الخفيف"],[359,"يا مليحا قد أبدع الله شكله","https://www.aldiwan.net/poem68073.html","الخفيف"],[362,"في الجيرة الغادين بدر","https://www.aldiwan.net/poem60895.html","مجزوء الكامل"],[374,"يا صاح إسمع مذ سمت","https://www.aldiwan.net/poem66909.html","مجزوء الرجز"],[400,"هل في الرفاق متيم مثلي","https://www.aldiwan.net/poem33609.html","الكامل"],[413,"ما قضينا حقا لرسم محيل","https://www.aldiwan.net/poem53816.html","الخفيف"],[413,"ما لها تطوي فيافي الأرض سيرا","https://www.aldiwan.net/poem53994.html","الرمل"],[426,"ورق التهاني الوافيه","https://www.aldiwan.net/poem41000.html","مجزوء الكامل"],[429,"سعود سنيكما كملت سناء","https://www.aldiwan.net/poem12355.html","الوافر"],[429,"أبدى الفرند نجابة النصل","https://www.aldiwan.net/poem12430.html","أحذ الكامل"],[429,"يا جمال الخلافة المحرز المجد","https://www.aldiwan.net/poem12706.html","الخفيف"],[431,"رمى حر قلبي بأجفانه","https://www.aldiwan.net/poem25700.html","المتقارب"],[436,"وأهد بها في الفلا والسرى","https://www.aldiwan.net/poem34834.html","المتقارب"],[436,"نجوم الصبا أين تلك النجوم","https://www.aldiwan.net/poem34849.html","المتقارب"],[436,"تتبين شمل الدين أنك ناظمه","https://www.aldiwan.net/poem34869.html","الطويل"],[436,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[438,"هذا هو الرزء الجن والبشرا","https://www.aldiwan.net/poem14454.html","البسيط"],[438,"هو الرزء حتى خص ريش القوادم","https://www.aldiwan.net/poem14478.html","الطويل"],[441,"كل حمد لما صنعتم قليل","https://www.aldiwan.net/poem56020.html","عموديه"],[456,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[456,"إذا عارض نحو أرض عدل","https://www.aldiwan.net/poem56076.html","المتقارب"],[456,"مشين لنا بين ميل وهيف","https://www.aldiwan.net/poem56114.html","المتقارب"],[498,"طرق السر من البرهان ما","https://www.aldiwan.net/poem37802.html","الرمل"],[503,"المفر","https://www.aldiwan.net/poem27797.html","الوافر"],[512,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[513,"ثغر الزمان بنجم الدين مبتسم","https://www.aldiwan.net/poem12263.html","البسيط"],[527,"إلى الدرعية الغراء تسري","https://www.aldiwan.net/poem37443.html","الوافر"],[536,"بإيابك الميمون أشرق نور","https://www.aldiwan.net/poem47426.html","عموديه"],[549,"هل الشيب إلا غصة في الحيازم","https://www.aldiwan.net/poem47203.html","الطويل"],[549,"جلب البرق لقلبي","https://www.aldiwan.net/poem47298.html","مجزوء الرمل"],[549,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[549,"ألا هل أتاها كيف حزني بعدها","https://www.aldiwan.net/poem47860.html","الطويل"],[556,"عليك بروحك السر الإلهي","https://www.aldiwan.net/poem33652.html","الوافر"],[556,"كل شيء لنا على التحقيق","https://www.aldiwan.net/poem34318.html","الخفيف"],[556,"إنما الدين كله تقليد","https://www.aldiwan.net/poem34595.html","الخفيف"],[559,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[559,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"]],"verses":[["وَهَدَّدَ بي الأَعداءُ في المَهدِ لَم يَحِن","نُهوضي وَلَم أَقطَع عُقودَ تَمائِمي",0,"م",2,0],["وهديّةُ الموْلَى تَحُطْ","طُ لفَضْلِها رأسي لَدَيْهِ",1,"ي",2,0],["وهُدَّ لَها إيوانُ كِسْرى مَهابَةً","وأُخْمِدَ منْ نِيرانِ فارِسَ لافِحُ",2,"ح",1,0],["وهدت إليه أسنّة وأسرّة","وَمَوَاكِبٌ وَكَتَائِبٌ وَكِتَابُ",3,"ب",1,0],["وَهَدَمتَ سوراً قَد أَجادَ بِناءَهُ","فِرعَونُ ذو الأَوتادِ وَالأَنهارِ",4,"ر",1,0],["وهدْيُك مهما ضلّتِ الشّهبُ قصدها","تولَّتْهُ في جنح الدُّجُنَّةِ هاديا",5,"ي",2,0],["وهداهُ من وجههِ ضوءُ بدرٍ","نورُه الدهرَ غيرَ ذي اضمحلالِ",6,"ل",1,0],["وهدَّ مِنْ خَلَدِي نَوْحٌ تُرَجِّعُهُ","بَلْوَى الحَيَاةِ وأَحزانُ المَسَاكينِ",7,"ن",1,0],["وهَدَمْتَ صرحاً لا أَلوذُ","بغيرِهِ وهَتَكْتَ سِتْرِي",8,"ي",1,0],["وهَدا خفوقُ البرق والقلبُ الذي","تُطوى عليه جوانحي خفَّاقُ",9,"ق",1,0],["وَهَدَّةِ يَومٍ لِاِبنِ يوسُفَ أَسمَعَت","مِنَ الرومِ ما بَينَ الصَفا وَالأَخاشِبِ",10,"ب",1,0],["وَهَدَّمتَ بَيعَةَ ماسَرجِسٍ","وَأَطفَأتَ نيرانَها وَالسُرُج",11,"ج",1,0],["وَهُدِيتَ منه لنعمةٍ مَكنونةٍ","فأَثَرْتَها مِن تُربةٍ وجَنادِل",12,"ل",1,0],["وَهَدَّ جَنانَ أَثبَتِنا جَناناً","إِذا عَزَمَت أَحِبَّتُنا اِرتِحالا",13,"ل",2,0],["وَهَدَت مُحِبّاً ظَلَّ في لَيلِ الجَفا","لَمّا هَدا وَاِمتَدَّتِ الآناءُ",14,"ا",2,0],["وَهَدَدتَ هَضبَةَ عِزِّهِ فَكَأَنَّها","نَسفاً كَثيبٌ بِالعَراءِ مَهيلُ",15,"ل",1,0],["وهدَّ ببأسِه أُممَاً شِداداً","نُهِيبُ بها وتأبَى أن تلينا",16,"ن",2,0],["وهَديَّةٌ سَاءتْ وسَاءَ حَدِيثُها","فالزّورُ من أسمائِها والزُّخْرُفُ",17,"ف",1,0],["وهداياكَ من مُسُوحٍ وبُسُطٍ","زِيدَ فيها الفنُّ البديعُ وزادا",18,"د",2,0],["وَهُدى جائِرٍ وَسَلوى حَزين","مِن ضَمير حَيّ وَأَصدَق نيه",19,"ي",2,0],["وَهُدِمَت قَلعَتُهُ الحَصينَه","وَأُخِذَت نِعمَتُهُ الثَمينَه",20,"ه",1,0],["وهدّمْتَ ما شادَ العِنادُ وقد رَسَتْ","أواخِيهِ في تلك الهَزاهزِ رُجَّحا",21,"ح",2,0],["وَهَدى لَها قَدرٌ أُتيحَ بِسُدفَةٍ","صَقراً فَفَجَّعَ بِالهَديلِ هِدالَها",22,"ل",3,0],["وَهَدَّ جِبالَها أَقيالُ فِهرٍ","فَتِلكَ رُبوعُها آياً طُمِسنَه",23,"ن",2,0],["وهَدى قبيلاً أو أضلَّ جماعةً","لسبيلِ غيٍّ أو سبيلِ رشادِ",24,"د",1,0],["وَهَدْيُهُ لَمْ يَفُتْهُ","فِي كُلِّ فَنٍّ وَحِرْفَهْ",25,"ف",2,0],["وَهُدَى فَخْرُ نُسْوَةِ الشَّرْقِ مَنْ","أَهْدَى سَبِيلاً إِلى الكَمَالِ وَأَرْشَدْ",26,"د",1,0],["وَهَدَاكَ دُونَهُمُ السَّبِيلُ إلى الَّذي","لَمْ يَبْصُرُوهُ نُورَ فِكْرٍ ثَاقِبِ",27,"ب",1,0],["وَهَدَتْهُ مَعْرِفة مُحَقَّقَةٌ","بِالنَّاسِ فِي تَصْرِيفِهِ الفِكْرَا",28,"ر",2,0],["وهُدَىً في الخيرِ يُرَغِّبُه","وتُقىً في المُلك يزهّدهُ",29,"د",2,0],["وهَدَاهُمْ إلى الحياةِ فَسَارُوا","في حِمىً من لِوَائِهِ المَعْقُودِ",30,"د",1,0],["وَهَدَى الشَّبَابَ إلَى الْحَياةِ فأَدْرَكُوا","مَعْنَى الْحيَاةِ وَعِزَّ الاسْتِقْلالِ",31,"ل",1,0],["وهدَّدت «طوكيو» بالانقسام؟","فآثَرُوا الصمت على الكلام؟",32,"م",1,0],["وِهَدّةِ يَوْمٍ لابنِ يُوسُفَ أسمَعَتْ","منَ الرّومِ ما بَينَ الصّفا فالأخاشِبِ",33,"ب",1,0],["وَهَديت الكُهول مِن كُلِ قُطر","لِلمَعالي وَأَنتَ أَصغَرُ سِنّا",34,"ن",2,0],["وَهدَّمني تَشَوقكُم وَلمَّا","لَثِمَت شِفَاهَ أحرُفِكُم بَناني",35,"ن",2,0],["وهَدَّدَ في كُلَيِّمِه وأنَّى","يَخَافُ سَنَا الشُّمَيسِ سَنَا سُهَيلِ",36,"ل",1,0],["وهد ما كان مبنياً على جُرُفٍ","هارٍ ولم يبن من تقوى على دعم",37,"م",1,0],["وَهَدَتهُمُ النَكَباتُ مِن بَعدِ العَمى","يا طالَما جَرَّ الصَلاحَ فَسادُ",38,"د",1,0],["وَهَدَيتَني كَرَماً إِلى سُبُلِ الغِنى","فَلَأُهدِيَنَّ لَكَ الثَناءَ مُفَوَّفا",39,"ف",2,0],["وَهُدىً أَحيا القُلوبَ سَداهُما","فَلا مُدرِكٌ في الخَصلَتَينِ مَداهُما",40,"م",2,0],["وهَديلُ أغْنِيتي تَلا سَهَري","ورويُّ شِعْري في الهَوى وَلَعَا",41,"ع",2,0],["وَهَديتَهُ كَلِماً لَقَد يَمَّنتُها","بِمَقامِ مِحرابٍ لَدَيهِ مُقَدَّسِ",42,"س",1,0],["وَهَدَتهم غيرَ قلبٍ أغلفا","وَالعَمى في القلب لا في الأعينِ",43,"ن",1,0],["وَهدى سِواهم فتيةً تركوا الفتن","روحي فِداهم ما أبرَّ وأكرما",44,"م",2,0],["وَهدّمهُ مِن أصلهِ فَتهدّما","عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما",45,"م",2,0],["وَهَدى كلَّ واحدٍ بألوك","قال خلّوا الجحيم هذا النعيمُ",46,"م",1,0],["وهدَيتني بعد الضلا","لِ إلى الصراطِ المستقيم",47,"م",1,0],["وهدمتَ من بِيَعٍ لهم وكنائسٍ","وكسرتَ من صُلُبٍ ومن أوثان",48,"ن",1,0],["وهدت لقياك روحي","لينابيع الصفاء",49,"ا",2,0],["وهدير القلب أرواحٌ فتيّه","صادحاتٌ بتغاريد شجيّه",50,"ه",1,0],["وَهَدَّ حُكمُك ركنَ الظالِمينَ وَقَد","عَدَلتَ حَتّى أَحبَّ الحَقَّ مَحقوقُ",51,"ق",1,0],["وهداهم إلى صراط سوى","مورث زينة القلوب الفظاظ",52,"ظ",1,0],["وهدانا بعد العمي فانتعشنا","بالنبي المبجل المنعوش",53,"ش",1,0],["وَهُدَّ يَا رَبِّ مَا ابْتَنَاهُ","مِنْ كَعْبَةِ الْجُورِ وَالْفُجُورِ",54,"ر",1,0],["وَهَدَمْتُ مَا شَيَّدْتُ أَيَّامَ الصِّبَا","فِي مَطْمَحِ الآثَامِ أَوْ أَطْلاَلِهَا",55,"ل",3,0],["وَهُدَاكَ جَلَّ هُدَاكَ يَلْزَمُ كُلًّ مَنْ","لَزِمَ الضَّلاَلَ مَحِيصُهُ وَحُيُوصُهُ",56,"ص",2,0],["وهدونا فوق الجياد يرى","وان قلق الوضين",57,"ن",1,0],["وهدي الحاكم بالح","ق كشؤبوب النشاص",58,"ص",1,0],["وَهداه بالوحي الشَريف مفصلا","سورا وَذكرا من لدنه حَكيما",59,"م",2,0],["وَهدم رسم الكفر بالسَيف عنوة","واودع ذا البين داعية الصلح",60,"ح",1,0],["وَهَداني للصَبرِ من ليس يَدري","وَضلالٌ عن مثل حسنكَ صَبري",61,"ي",1,0],["وهديتني نهجَ البيانِ بآية","منه لقد سفرتْ ولم تتبرقع",62,"ع",1,0],["وهدى ضالاً وأَرشد غاوٍ","تائهاً في مفاوز من ضلال",63,"ل",1,0],["وهدمت صرحا للشباب مشيّدا","لتقيم للمجد العظيم سماكا",64,"ك",2,0],["وهداه الحكيم ينبوعه الوح","ي وأخلاقه الفساح الرحاب",65,"ب",1,0],["وَهَداني ضِياء وَجهِكَ لما","تهت في غَبهب الشُعور المَضله",66,"ل",2,0],["وهَدِيُّ مَدْحي ما لَهُ","إلاّ الولاءَ المَحْضَ مَهر",67,"ر",1,0],["وهد عزم اللَمَّه","وغلهم باللِمَّه",68,"ه",1,0],["وهدمت عمداً كل قاعدة","عمرت لأهل العقل والنقل",69,"ل",1,0],["وهداةً إلى سواء السبيل","خيرُ من حَلَّ بقعةً ووطاها",70,"ه",2,0],["وهَدى الله به النَّاس إلى","طُرُق الحقّ وأبدى فيه أمرا",71,"ر",2,0],["وهدية التمليك قد","وافت بنص هاديه",72,"ي",2,0],["وهَدَّ ذُرَى النِّفاقِ فلَيْسَ يَبْنِي","ولا اليربوعُ منه نافِقَاءَ",73,"ا",2,0],["وهُدىً مُبِينٌ لم يُخَلِّ أَخا","جَهْلٍ ولَوْ أَضْحَى أَبا جَهْل",74,"ل",1,0],["وهدىً أحسبُ النجومَ استعارتْ","هُ لإرشادِها رهينَ ضَلالِهْ",75,"ل",2,0],["وَهَدَّمَ بُنْيانَ صَبْري بِهِ","فما أَحَدٌ هَدَّ ما هَدَّما",76,"م",2,0],["وهدِيٍ هَداها سبيلَ العَفَافِ","ورأَيٍ أَراها هُدى كلِّ رَاءِ",77,"ا",2,0],["وهَدْيٌ تهادى إِلَيْهِ العُيونُ","ويُزْهى لَهُ زَمْزَمٌ والحَطِيمُ",78,"م",1,0],["وهَدَّ هَوَاءَ الجَوِّ نَحْوَ بِنائِها","هُوِيَّ سِلامٍ حانَ مَنْ لا تُسَالِمُهْ",79,"م",2,0],["وهُدَاكَ أَشْرَقَ لي ولَيْلِيَ مُظْلِمٌ","وسَناكَ أَبْرَقَ لي وَزَنْدِيَ كابِ",80,"ب",1,0],["وهُدىً لِمَنْ صَلَّى وضَحّى واتَّقى","وزَكَا فَكُنْتَ لَهُ أَجَلَّ ثوابِ",80,"ب",1,0],["وهدم الأَرض من رأس إِلى قدم","وعم لا خص قحطانا ولا مضرا",81,"ر",2,0],["وهدم بيت السؤدد العز والعلا","وحكم المنايا هادم أي هادم",82,"م",1,0],["وهديتم إلى الرشاد أناسا","كاد يغويهم العدو الجهول",83,"ل",1,0],["وهدتْك آراءٌ مظفَّرةٌ","فتحتْ عليك مَغالق السُّبْلِ",84,"ل",1,0],["وهدّمت مذبح مَرْسَرْجِسٍ","وأطفأتُ قنديلَه المشتعِلْ",85,"ل",1,0],["وهدّمَ في اللّه أصنامَهم","بمرآى عيونٍ عليها عُكوفِ",86,"ف",1,0],["وهدمْنا بِيَعَ الغَيْر ولم","نتَّخذْ في الدِّينِ يوماً صَنَمَا",87,"م",2,0],["وهدْمُ مصانعِ التاريخ مرُّ","ولكنّ الفتوحاتِ أمرُّ",88,"ر",1,0],["وهُدبٍ تسقّى نبلُه سُمَّ كُحلِها","فذبّ بشوكِ النّحلِ عن شَهْدةِ الثّغرِ",89,"ر",1,0],["وهدمت منه خلق الدهر أربعة","العلم والحلم والمعروف والكرم",90,"م",1,0],["وَهَدْيُ الصّحْبِ أَفْضَلُ كُلِّ هَدْيٍ","وَأَشْرَفُهُ وإنْ جَحَدَ الجَحُودُ",91,"د",1,0],["وهدوءِ طبعٍ في رزانةِ حكمةٍ","فلهُ وقارُ الكهلِ مُنذُ صِباهُ",92,"ه",1,0],["وهدّدني في كلّ يومٍ وليلةٍ","سَنا وَمْضِهِ بالقارعاتِ الحواطمِ",93,"م",1,0],["وهداني في سُرى اللّي","لِ وقد جُرتُ السّبيلا",94,"ل",2,0],["وهديناكُمُ إلى طُرُقِ الحق","قِ فكنتمْ عنّا غفولاً حَيارى",95,"ر",2,0],["وَهَدّمها مَنْ كان شاد بناءَها","وجرّدَها مَن كان أحكمَ غِمْدَها",96,"د",3,0],["وهدم البيت معلوم فعجل","بكشفك عنك هذا البيت واهي",97,"ي",1,0],["وهدانا إليه برق التجلي","في دياجي إمكاننا بالبريق",98,"ق",1,0],["وهدى الله ظاهرٌ ليس يخفى","عند من آمنوا به يا رشيد",99,"د",1,0],["وَهَدَرَ الجِدُّ مِنَ الناسِ الهَدَر","وَلاحَتِ الحَربُ الوُجوهَ وَالسُرَر",100,"ر",1,0],["وَهَدبق أَهدَبُ غَيفانِيُّ","يَذودُ عَنهُ جِنثُها الجِنثيُّ",101,"ي",1,0]]}