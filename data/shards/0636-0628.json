{"poems":[[55,"في كل يوم لأحبة مطرح","https://www.aldiwan.net/poem30650.html","الكامل"],[10,"ألا يا عين فانهمري بغدر","https://www.aldiwan.net/poem21078.html","الوافر"],[40,"أفي أثر الأظعان عينك تلمح","https://www.aldiwan.net/poem7695.html","الطويل"],[30,"رأيتُ نوار قد جعلت تجنى","https://www.aldiwan.net/poem1289.html",""],[68,"ضحكت ثغور حدائق الأرض","https://www.aldiwan.net/poem38487.html","الكامل"],[46,"تصدت وحبل البين مستحصد شزر","https://www.aldiwan.net/poem29676.html","الطويل"],[22,"حمدت إلهي أنني لم أجدكما","https://www.aldiwan.net/poem21678.html","الطويل"],[52,"وردت همومك يوم صاعد","https://www.aldiwan.net/poem63918.html","مجزوء الكامل"],[48,"ضمكم جنس وأزرى بكم","https://www.aldiwan.net/poem23547.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[30,"رأيت نوار قد جعلت تجنى","https://www.poetsgate.com/ViewPoem.aspx?id=21726",""],[135,"ثلاث ليال حين جاز ينير","https://www.aldiwan.net/poem54674.html","الطويل"],[153,"بطيبة للعافين أكرم سيد","https://www.aldiwan.net/poem68590.html","الطويل"],[189,"أقمت بجنبلا عشرين يوما","https://www.aldiwan.net/poem43643.html","الوافر"],[288,"في جيشها الجرار من","https://www.aldiwan.net/poem39399.html","مجزوء الكامل"],[288,"الروض باكرها الغمام وهزها","https://www.aldiwan.net/poem39425.html","الكامل"],[445,"منا فوارس قاتلوا عن سبيهم","https://www.aldiwan.net/poem1757.html","الكامل"],[497,"كم حسرات لي وكم وجد","https://www.aldiwan.net/poem9818.html","السريع"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/28058","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/28062","الطويل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/21480","الطويل"],[1085,"","https://poetry.dctabudhabi.ae/diwan/poem/97640","الكامل"]],"verses":[["ضَبٌّ يُداهِنُني وَيُشكِلُ غَيبُهُ","مِمّا يُرَغّي قَولَهُ وَيُصَرَّحُ",0,"ح",1,0],["ضُبارِمَةٍ تَوَسَّدَ ساعِدَيهِ","عَلى طُرقِ الغُزاةِ وَكُلِّ بَحرِ",1,"ر",1,0],["ضُبارِمَةٌ شُدقٌ كَأَنَّ عُيونَها","بَقايا جِفارٍ مِن هَراميتَ نُزَّحُ",2,"ح",1,0],["ضَبَرتُ مِنَ المِئينَ وَجَرَّبَتني","مَعَدٌّ أُحرِزَ القُحامَ لِرِغابا",3,"ب",2,0],["ضَبعٌ لِدينِ اللَهِ مُنذُ عَلا ال","إِسلامُ آمِنَةٌ مِنَ الخَفضِ",4,"ض",1,0],["ضُبِطَت أُمورُ المُسلِمينَ بِهِ","ضَبطاً بِهِ أَمِنَت مِنَ النَقضِ",4,"ض",1,0],["ضَبيبِيَّةٌ ما إِن تُحَدِّثُ أَنفُساً","بِما خَلفَها ما دامَ قُدّامَها وِترُ",5,"ر",1,0],["ضُبَيبانِ جَحلِيّانِ في آمِنِ الكُدى","إِذا ما أَحَسّا حارِشَ اللَيلِ ذَنَّبا",6,"ب",2,0],["ضَبَطَ الخِلافَةَ واحِداً","لِلَّهِ دَرُّكَ أَيَّ واحِد",7,"د",1,0],["ضَبَطتُمُ المالَ وَلَكِنَّ ما","يَجمَحُ بِالإِنسانِ لا تَضبُطون",8,"ن",1,0],["ضَبُعٌ تَعْوِي وَذِئْبٌ ضَابِحٌ","وَصَدىً يَزْقُو مَهِيجاً مُزْبَئِرَّا",9,"ر",2,0],["ضَبَرْتُ مِنَ المِئينَ وَجَرّبَتْني","مَعَدٌّ أُحْرِزُ القُحَمَ الرِّغَابَا",10,"ب",2,0],["ضَبَطتُ بِتصحِيحٍ مَنَازَلَ لَم يَكُن","بِضَابِطِها مَن هُو بِالضَّبطِ أجدَرُ",11,"ر",1,0],["ضَبثِهِ وَقَدلكثَ العُزّى فَماتَت لِلكثِهِ","فَهُم وَهُما صَرعى لأَفكَلِ مَغثِهِ",12,"ه",1,0],["ضباعٌ ملكوا بلدا مريا","وهم في الشرّ أمثالُ السباع",13,"ع",1,0],["ضباطها في ساحة الا","طال لا تبدي ضجر",14,"ر",1,0],["ضبط الامور وصان سبل نجاحها","في طوعه كل العباد تجاروا",15,"ر",3,0],["ضبعا هراش يعقران استيهم","فرأتهما أخرى فقالت تعقر",16,"ر",1,0],["ضبعَيْ يد الفضل وسبعي وغا ال","علم وربعي كرم العهد",17,"د",1,0],["ضُبارِمَةٌ لَيثٌ مُدِلٌ مُؤارِبٌ","لَهُ في عَرينِ الغابِ عِرسٌ وَأَشبُلُ",18,"ل",1,0],["ضِبِرٍّ مضِرٍّ بِالنَواجي إِذا اِشتَكى","عَجا شِدقَهُ عَن فاطِرِ النابِ ناجِمِ",19,"م",1,0],["ضُباراً مَريَط الحاجِبَينِ إِذا خدى","عَلى الأُكم وَلاها حِذاء عَثَمثَما",20,"م",2,0],["ضبعا هراش يعقران استيهما","فرأتهما أخرى فقالت تعقر",21,"ر",1,0]]}