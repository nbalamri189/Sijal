{"poems":[[53,"في كل يوم لأحبة مطرح","https://www.aldiwan.net/poem30650.html","الكامل"],[10,"ألا يا عين فانهمري بغدر","https://www.aldiwan.net/poem21078.html","الوافر"],[38,"أفي أثر الأظعان عينك تلمح","https://www.aldiwan.net/poem7695.html","الطويل"],[28,"رأيتُ نوار قد جعلت تجنى","https://www.aldiwan.net/poem1289.html",""],[66,"ضحكت ثغور حدائق الأرض","https://www.aldiwan.net/poem38487.html","الكامل"],[44,"تصدت وحبل البين مستحصد شزر","https://www.aldiwan.net/poem29676.html","الطويل"],[22,"حمدت إلهي أنني لم أجدكما","https://www.aldiwan.net/poem21678.html","الطويل"],[50,"وردت همومك يوم صاعد","https://www.aldiwan.net/poem63918.html","مجزوء الكامل"],[46,"ضمكم جنس وأزرى بكم","https://www.aldiwan.net/poem23547.html","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[28,"رأيت نوار قد جعلت تجنى","https://www.poetsgate.com/ViewPoem.aspx?id=21726",""]],"verses":[["ضَبٌّ يُداهِنُني وَيُشكِلُ غَيبُهُ","مِمّا يُرَغّي قَولَهُ وَيُصَرَّحُ",0,"ح",1,0],["ضُبارِمَةٍ تَوَسَّدَ ساعِدَيهِ","عَلى طُرقِ الغُزاةِ وَكُلِّ بَحرِ",1,"ر",1,0],["ضُبارِمَةٌ شُدقٌ كَأَنَّ عُيونَها","بَقايا جِفارٍ مِن هَراميتَ نُزَّحُ",2,"ح",1,0],["ضَبَرتُ مِنَ المِئينَ وَجَرَّبَتني","مَعَدٌّ أُحرِزَ القُحامَ لِرِغابا",3,"ب",2,0],["ضَبعٌ لِدينِ اللَهِ مُنذُ عَلا ال","إِسلامُ آمِنَةٌ مِنَ الخَفضِ",4,"ض",1,0],["ضُبِطَت أُمورُ المُسلِمينَ بِهِ","ضَبطاً بِهِ أَمِنَت مِنَ النَقضِ",4,"ض",1,0],["ضَبيبِيَّةٌ ما إِن تُحَدِّثُ أَنفُساً","بِما خَلفَها ما دامَ قُدّامَها وِترُ",5,"ر",1,0],["ضُبَيبانِ جَحلِيّانِ في آمِنِ الكُدى","إِذا ما أَحَسّا حارِشَ اللَيلِ ذَنَّبا",6,"ب",2,0],["ضَبَطَ الخِلافَةَ واحِداً","لِلَّهِ دَرُّكَ أَيَّ واحِد",7,"د",1,0],["ضَبَطتُمُ المالَ وَلَكِنَّ ما","يَجمَحُ بِالإِنسانِ لا تَضبُطون",8,"ن",1,0],["ضَبُعٌ تَعْوِي وَذِئْبٌ ضَابِحٌ","وَصَدىً يَزْقُو مَهِيجاً مُزْبَئِرَّا",9,"ر",2,0],["ضَبَرْتُ مِنَ المِئينَ وَجَرّبَتْني","مَعَدٌّ أُحْرِزُ القُحَمَ الرِّغَابَا",10,"ب",2,0]]}