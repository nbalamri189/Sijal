rses":[["ضَبٌّ يُداهِنُني وَيُشكِلُ غَيبُهُ","مِمّا يُرَغّي قَولَهُ وَيُصَرَّحُ",0,"ح",1,0],["ضُبارِمَةٍ تَوَسَّدَ ساعِدَيهِ","عَلى طُرقِ الغُزاةِ وَكُلِّ بَحرِ",1,"ر",1,0],["ضُبارِمَةٌ شُدقٌ كَأَنَّ عُيونَها","بَقايا جِفارٍ مِن هَراميتَ نُزَّحُ",2,"ح",1,0],["ضَبَرتُ مِنَ المِئينَ وَجَرَّبَتني","مَعَدٌّ أُحرِزَ القُحامَ لِرِغابا",3,"ب",2,0],["ضَبعٌ لِدينِ اللَهِ مُنذُ عَلا ال","إِسلامُ آمِنَةٌ مِنَ الخَفضِ",4,"ض",1,0],["ضُبِطَت أُمورُ المُسلِمينَ بِهِ","ضَبطاً بِهِ أَمِنَت مِنَ النَقضِ",4,"ض",1,0],["ضَبيبِيَّةٌ ما إِن تُحَدِّثُ أَنفُساً","بِما خَلفَها ما دامَ قُدّامَها وِترُ",5,"ر",1,0],["ضُبَيبانِ جَحلِيّانِ في آمِنِ الكُدى","إِذا ما أَحَسّا حارِشَ اللَيلِ ذَنَّبا",6,"ب",2,0],["ضَبَطَ الخِلافَةَ واحِداً","لِلَّهِ دَرُّكَ أَيَّ واحِد",7,"د",1,0],["ضَبَطتُمُ المالَ وَلَكِنَّ ما","يَجمَحُ بِالإِنسانِ لا تَضبُطون",8,"ن",1,0],["ضَبُعٌ تَعْوِي وَذِئْبٌ ضَابِحٌ","وَصَدىً يَزْقُو مَهِيجاً مُزْبَئِرَّا",9,"ر",2,0],["ضَبَرْتُ مِنَ المِئينَ وَجَرّبَتْني","مَعَدٌّ أُحْرِزُ القُحَمَ الرِّغَابَا",10,"ب",2,0],["ضَبَطتُ بِتصحِيحٍ مَنَازَلَ لَم يَكُن","بِضَابِطِها مَن هُو بِالضَّبطِ أجدَرُ",11,"ر",1,0],["ضَبثِهِ وَقَدلكثَ العُزّى فَماتَت لِلكثِهِ","فَهُم وَهُما صَرعى لأَفكَلِ مَغثِهِ",12,"ه",1,0],["ضباعٌ ملكوا بلدا مريا","وهم في الشرّ أمثالُ السباع",13,"ع",1,0],["ضباطها في ساحة الا","طال لا تبدي ضجر",14,"ر",1,0],["ضبط الامور وصان سبل نجاحها","في طوعه كل العباد تجاروا",15,"ر",3,0],["ضبعا هراش يعقران استيهم","فرأتهما أخرى فقالت تعقر",16,"ر",1,0],["ضبعَيْ يد الفضل وسبعي وغا ال","علم وربعي كرم العهد",17,"د",1,0],["ضبطن بفيف من بسيطة بعدما","ترجل من شمس النهار متوع",18,"ع",1,1],["ضَبَّةٌ أُسرتي همُ التاركي البا","غيُ رُضاضاً لا بل رُضاضَ الرضاض",19,"ض",1,0],["ضَبِّيَّةٌ غضِبَتْ للحقِّ وامتعضتْ","له لدنْ غضِبَ الضبيُّ وامتعضا",20,"ض",2,0],["ضُبارِمٌ صار للآسادِ مُفْتَرِساً","بصارِمٍ باترِ الَلاماتِ والجُنَن",21,"ن",1,0],["ضبطت مقاييس النَّغَم","وبذاك تَمَّ لي الأرب",22,"ب",1,0],["ضبعٌ كشر عن أنيابه","وذباب يملأ الأرض طنين",23,"ن",1,0],["ضُبارِمَةٌ لَيثٌ مُدِلٌ مُؤارِبٌ","لَهُ في عَرينِ الغابِ عِرسٌ وَأَشبُلُ",24,"ل",1,0],["ضِبِرٍّ مضِرٍّ بِالنَواجي إِذا اِشتَكى","عَجا شِدقَهُ عَن فاطِرِ النابِ ناجِمِ",25,"م",1,0],["ضُباراً مَريَط الحاجِبَينِ إِذا خدى","عَلى الأُكم وَلاها حِذاء عَثَمثَما",26,"م",2,0],["ضَبٌّ كَسرِى بِجَبرِ ضَبّةِ رَبّى","إذ كَلامِى من لَفظشهِ مَفرُوضُ",27,"ض",1,0],["ضَبعُ عَفرِى مُستَبدَلٌ بِغًزال","حَشوُهُ مَلاؤهُ إلهُدى والفُيُوضُ",27,"ض",1,0],["ضبّ الرَبيع بها سرادِق عزمه","وَجياده تأبى عَلى الرواض",28,"ض",1,0],["ضبطت أُمور المؤمنين بعزمه","وَبعدله تلقى الجَميع رواض",28,"ض",1,0],["ضب ضعيف ضائع ضجكة","ضايقه ضر ضنين ضليل",29,"ل",1,0],["ضُبَّاطكم غرٌ كرامْ","ولهم لدى الهيجا غَرام",30,"م",1,0],["ضبحت بمعركة القتال وغادرت","جفن الزمان عن الأعادي مغمضا",31,"ض",2,0],["ضبط المدائن والقرى بسياسة","وفراسة في من أناب وفوضا",31,"ض",2,0],["ضبط الممالك ساسها بفراسةٍ","راءٍ بها ما عن سواه تغيّبا",32,"ب",2,0],["ضبابٌ وغزلانٌ محييةٌ لَهُ","وحيتهُ أشجارٌ له ركضت ركضا",33,"ض",2,0],["ضبعا هراش يعقران استيهما","فرأتهما أخرى فقالت تعقر",34,"ر",1,0],["ضَباباً لَم يُبددهُ الشَمالي","إِذا اتفق وَالمداوي",35,"ي",1,0],["ضبط الجزيرة عندما","نزلت بعقوبتها العساكر",36,"ر",1,0],["ضبا الهند أم أجفانُ ظبيٍ من التُرك","تركنَ دمي والدمع بالسَفح والسفك",37,"ك",1,1],["ضَبَطَتْ صَولَجانَ عَرْشٍ مجيدٍ","مِنهُ كَفٌّ لِصَونِ شَعبٍ مَجيدِ",38,"د",1,0],["ضبط الأمور ثِقافهُ فأعادها","في شد أسنان على أسنان",39,"ن",1,0],["ضَبَطَ الجميعُ صُعُودَهُم","بِسقوطِكَ المُتلاحِقِ",40,"ق",1,0],["ضبط الجيش في الحروب من النهب","وما كانوا عودّوا الحرمانا",41,"ن",2,0],["ضِبَاْعُ جِبَاْلِهَاْ صَاْرَتْ أُسُوْداً","وَأَيَّدَ بَطْشَهَاْ فُرْسُ الْمَنَاْرِ",42,"ر",1,0],["ضبابٌ سادَ أيامي","وعشقكِ فيَّ وضّاحُ",43,"ح",1,0],["ضَبِيْسٌ عَلَى المَفروضِ في الزُّهدِ رَابِضٌ","ضَرِيسٌ على التَدْريسِ للسِّرِّ مَوْضِعُ",44,"ع",1,0],["ضبابٌ والدروبُ بهِ استطالتْ","ودمعُ الصبحِ من وجلٍ تجارى",45,"ر",2,0],["ضبابٌ لست أفهمه يضيعني","ويتركني بشكي حائراً أمسي",46,"س",2,0],["ضبابية الإيحاء صعبٌ ولوجه","بغير انكشافات الخيال المواتيةْ",47,"ي",2,0],["ضبرم صميدع شانه اليوم فالقاف","نجل الفطاحل من دهر دوس لخفوف",48,"ف",1,0],["ضبابٌ ، وأمطارٌ ، وحُسنٌ تناثرتْ","مفاتنُهُ .. تسبي القلوبَ الضواميا",49,"ي",2,0],["ضَبَحَ اصطِبارِي, وَاحتَرَقتُ عَلَى","مَا أَجَّ مِن نارِ الهَوَى وَعَلا",50,"ل",2,1],["ضباع الجحور استذيبت تالي الأيام","وبعض الذياب يخاف من ضرطة النعجه",51,"ج",2,1],["ضبغ تعوي وذئب ضابح","وصدى يزقو مهيجا مزبئرا",52,"ر",2,0]]}