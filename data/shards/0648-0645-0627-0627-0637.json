{"poems":[[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[159,"لو مر لي نفس بالنار أحرقها","https://www.aldiwan.net/poem55710.html","البسيط"],[203,"سهرت والليل أمسى للورى سكنا","https://www.aldiwan.net/poem45626.html","البسيط"],[285,"ايا ما أحسن المنثور","https://www.aldiwan.net/poem60573.html","الرجز"],[318,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[422,"أهاج الجوى برقا أغار وأنجدا","https://www.aldiwan.net/poem54165.html","الطويل"],[438,"بعينيه شكري لا بكأس عقاره","https://www.aldiwan.net/poem12787.html","الطويل"],[463,"انظر معي فهي نظرة أمم","https://www.aldiwan.net/poem55899.html","المنسرح"],[463,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[466,"وكيف يرضى بدون من تكون له","https://www.aldiwan.net/poem15681.html","البسيط"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/121056","الطويل"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131322","الرجز"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99090","الوافر"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65945","الطويل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102382","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77133","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54370","المجتث"],[5397,"سالمت دهرا لا يريك التهانيا","https://www.poetsgate.com/ViewPoem.aspx?id=157960",""],[5431,"حرائق أنفاسي","https://www.poetsgate.com/ViewPoem.aspx?id=194534",""],[5997,"جمر في ذاكرة الرماد","https://www.poetsgate.com/ViewPoem.aspx?id=214424",""],[6056,"قديمة نديمة","https://www.poetsgate.com/ViewPoem.aspx?id=130512",""]],"verses":[["وما أطال الدين من بنيان","للعلم في الدنيا وللبيان",0,"ن",1,0],["وما أُطيقُ لما أَلقاهُ مِنْ كَمَدٍ","أَقُولُ واكَبِدي مِنْ شِدَّةِ الكَمَدِ",1,"د",1,0],["وما أطافَ بقلبي في الهوى أملٌ","إلا بعثتَ عليهِ الهمَّ والحزنا",2,"ن",2,0],["وَما أَطْيَبَهُ نَشراً","وَما أَشْرَقَهُ نُورا",3,"ر",2,0],["وما أطرب الأرواح منا لدى الفنا","سوى نغمات أدركتها قديمة",4,"ه",1,0],["وما أطولَ الليلَ الذي لم تصل به","كأنْ جعلت ليل المتيَّم سرمدا",5,"د",2,0],["وما أطلقت بالسّحْر غزلانُ بابلٍ","لواحظَها إلا انثنى في إسارِه",6,"ر",2,0],["وما أطال الصِّبا وأعرضَ من","عيشٍ كأن اختلاسَه حُلُمُ",7,"م",1,0],["وما أطمَعَتْني أوجهٌ بابتسامها","فيُؤْيِسَني ممّا لديها قُطوبُها",8,"ب",3,0],["وما اُطيق لما أوْليْتَ مَحْمَدَةٍ","وكيق ينهض مَن محمولُه جبلُ",9,"ل",1,0],["وما اطلع الزهر الربيع وانما","رأى الدمع أجياد الغصون فحلاها",10,"ا",3,0],["وما أَطَلْتُ واصِفاً في شَرْحِهَا","بل قلتُ واخْتَصَرْتُ حالَ مَدْحِها",11,"ه",2,0],["وما أطت إلى البيت المطايا","وما طلعت على الأرض النجوم",12,"م",1,0],["وما أطعما للّه منها فهي به","توفي وما في ذاك حق لذي حصد",13,"د",1,0],["وما أطلقَ الأعباءَ حتى تضوَّعتْ","بها سِكَكٌ ممّا لديهِ ودُورُ",14,"ر",1,0],["وَما أَطلَعتُ نُصوحاً في الهَوى وَأَرى","أَنَّ النَصيحَ عَذول فيهِ غَيرَ وَلي",15,"ل",2,0],["وما أَطعتُ غرامي","حتى عصيتُ اللّواحي",16,"ح",2,0],["وما أطلقت من ربقة الأسر شيخها","وفكته من قيد المضلين عانيا",17,"ي",2,0],["وماأطيب المحبوب خمرا ومشربا","وما أطيب اللذات مضغا بأضراس",18,"س",1,0],["وما أطعنا صروفًا بالمدى سلكتْ","بنا دروباً طويلاتٍ وأسفارا",19,"ر",2,0],["ومااطيع أنا فيك الحكي والنميمة","ولا استمع لأهل الوشايه من الناس",20,"س",1,0]]}