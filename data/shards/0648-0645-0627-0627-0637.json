{"poems":[[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[155,"لو مر لي نفس بالنار أحرقها","https://www.aldiwan.net/poem55710.html","البسيط"],[199,"سهرت والليل أمسى للورى سكنا","https://www.aldiwan.net/poem45626.html","البسيط"],[280,"ايا ما أحسن المنثور","https://www.aldiwan.net/poem60573.html","الرجز"],[313,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[416,"أهاج الجوى برقا أغار وأنجدا","https://www.aldiwan.net/poem54165.html","الطويل"],[432,"بعينيه شكري لا بكأس عقاره","https://www.aldiwan.net/poem12787.html","الطويل"],[458,"انظر معي فهي نظرة أمم","https://www.aldiwan.net/poem55899.html","المنسرح"],[458,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[461,"وكيف يرضى بدون من تكون له","https://www.aldiwan.net/poem15681.html","البسيط"]],"verses":[["وما أطال الدين من بنيان","للعلم في الدنيا وللبيان",0,"ن",1,0],["وما أُطيقُ لما أَلقاهُ مِنْ كَمَدٍ","أَقُولُ واكَبِدي مِنْ شِدَّةِ الكَمَدِ",1,"د",1,0],["وما أطافَ بقلبي في الهوى أملٌ","إلا بعثتَ عليهِ الهمَّ والحزنا",2,"ن",2,0],["وَما أَطْيَبَهُ نَشراً","وَما أَشْرَقَهُ نُورا",3,"ر",2,0],["وما أطرب الأرواح منا لدى الفنا","سوى نغمات أدركتها قديمة",4,"ه",1,0],["وما أطولَ الليلَ الذي لم تصل به","كأنْ جعلت ليل المتيَّم سرمدا",5,"د",2,0],["وما أطلقت بالسّحْر غزلانُ بابلٍ","لواحظَها إلا انثنى في إسارِه",6,"ر",2,0],["وما أطال الصِّبا وأعرضَ من","عيشٍ كأن اختلاسَه حُلُمُ",7,"م",1,0],["وما أطمَعَتْني أوجهٌ بابتسامها","فيُؤْيِسَني ممّا لديها قُطوبُها",8,"ب",3,0],["وما اُطيق لما أوْليْتَ مَحْمَدَةٍ","وكيق ينهض مَن محمولُه جبلُ",9,"ل",1,0]]}