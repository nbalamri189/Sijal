{"poems":[[53,"رضيت من الأحباب دون الذي يرضي","https://www.aldiwan.net/poem30167.html","الطويل"],[63,"أبا خالد كم تدعي لي مودة","https://www.aldiwan.net/poem45859.html","الطويل"],[63,"بعيشكما يا صاحبي دعانيا","https://www.aldiwan.net/poem46218.html","الكامل"],[3,"ألا يا دار عبلة بالطوي","https://www.aldiwan.net/poem119.html",""],[77,"بحيث القباب البيض والأسل السمر","https://www.aldiwan.net/poem36489.html","الطويل"],[77,"دعاك بأقصى المغربين غريب","https://www.aldiwan.net/poem36715.html","الطويل"],[83,"لك الله من فذ الجلالة أوحد","https://www.aldiwan.net/poem54297.html","الطويل"],[92,"أزنبقة السفح ما لي أراك","https://www.aldiwan.net/poem38887.html","المتقارب"],[43,"أهلا بدار سباك أغيدها","https://www.aldiwan.net/poem9531.html","المنسرح"],[62,"نصيحكما فيما يقول مريب","https://www.aldiwan.net/poem52505.html","الطويل"],[28,"لنا دون من تحت السماء عليهم","https://www.aldiwan.net/poem5091.html","الطويل"],[61,"وزنجية عرفت بالإباق","https://www.aldiwan.net/poem51528.html","المتقارب"],[66,"مدحتك مدح بشار بن برد","https://www.aldiwan.net/poem38603.html","الكامل"],[80,"نعيمك أن تزف لك العقار","https://www.aldiwan.net/poem31437.html","الوافر"],[87,"لعزة هذي اللاهيات النواعم","https://www.aldiwan.net/poem8339.html","الطويل"],[105,"الله أكبر باسم الله أهديها","https://www.aldiwan.net/poem43131.html","البسيط"],[52,"سأرحل عنكم لا جوادا بعبرة","https://www.aldiwan.net/poem26976.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39627","السريع"],[126,"إذا اضطربت سمر اليراع بكفه","https://www.aldiwan.net/poem4069.html","الطويل"],[144,"أما ومساع لا نحيط لها عدا","https://www.aldiwan.net/poem11755.html","الطويل"],[187,"ألام على رفقي بمن لا أحبه","https://www.aldiwan.net/poem44140.html","الطويل"],[271,"هجرت الأهل والصحبا","https://www.aldiwan.net/poem35399.html","الهزج"],[276,"وصفراء في لون المحب وحاله","https://www.aldiwan.net/poem25606.html","الطويل"],[381,"لقد علمت يقينا بعدما رحلوا","https://www.aldiwan.net/poem49251.html","البسيط"],[417,"إذا اضطرم البرق اليماني في الدجى","https://www.aldiwan.net/poem53836.html","الطويل"],[417,"ألما على لومي وجدا مجددا","https://www.aldiwan.net/poem54134.html","الطويل"],[459,"لنا من ليلنا بلِوى الصريمِ","https://www.aldiwan.net/poem55891.html","الوافر"],[459,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[462,"خذوا من ذمامي عدة للعواقب","https://www.aldiwan.net/poem15082.html","الطويل"],[462,"عفا ضارج من آل ليلى فعاقل","https://www.aldiwan.net/poem15298.html","الطويل"],[465,"نعم هذه آثارهم والمنازل","https://www.aldiwan.net/poem3164.html","عموديه"],[552,"أيا ظبية في ربى جاسم","https://www.aldiwan.net/poem47219.html","المتقارب"],[568,"هلما بكانوننا جاحما","https://www.aldiwan.net/poem69766.html","المتقارب"]],"verses":[["إِذا اِضطَرَمَت ما بَينَ جَنبيَّ غَضبَةٌ","وَكادَ فَمي يُمضي مِنَ القَولِ ما يُمضي",0,"ض",2,0],["إِذَا اضْطَرَمَتْ في القَلْبِ نارُ عَداوَةٍ","لَمحْتُ بِعَيْنَيْ مُصْطَلِيها وَمِيضَها",1,"ه",2,0],["إذا اضطَربوا فَوقَ الرِّحالِ حَسِبتَهُمْ","وقد لفظَ الفَجرَ الظّلامُ أفاعِيا",2,"ي",2,0],["إِذا اِضطَرَبوا سَمِعتَ الصَوتَ فيهِم","خَفيّاً غَيرَ صَوتِ المَشرَفِيِّ",3,"ي",1,0],["إذا اضْطَبَنوا أقْواسَهُمْ وتمَنْطَقوا","فتُبْصِرُ جيْشَ التُّرْكِ جاشَتْ بهِ مِصْرُ",4,"ر",1,0],["إِذَا اضطَربَ الْخَطِّيُّ فَوْقَ غَديِرهَا","يَرُوقُكَ مِنْهَا لُجَّةٌ وَقَضِيبُ",5,"ب",1,0],["إذا أضمرت من بأسها الحرب جاحماً","تأجَّجَ منه العَضْبُ في لجة البحرِ",6,"ر",1,0],["إِذا أَضْجَرَتْكِ أغاني الظَّلامِ","فَقَدْ عَذَّبَتْني أَغانِي الوُجومْ",7,"م",1,0],["إِذا أَضَلَّ الهُمامُ مُهجَتَهُ","يَوماً فَأَطرافُهُنَّ تَنشُدُها",8,"د",3,0],["إِذا أضمروا كيداً تدلَّى عليهم","عليمٌ بأسرارِ الغُيوب لَبيبُ",9,"ب",1,0],["إِذا أَضحَتِ الآفاقُ مِن كُلِّ جانِبٍ","عَلَيها قَتامُ المَحلِ بادٍ بُسورُها",10,"ر",3,0],["إذا اضطربَ الماءُ من حَولِها","رَأيْتَ الجبالَ بها في تَلاَقي",11,"ق",2,0],["إِذا اِضطُرَّ الشَريفُ إِلى كَنيفٍ","فَلَيسَ عَلَيهِ إِذ يَأتيهِ عارُ",12,"ر",1,0],["إذا أضحى شعارُ الأُسدِ شَعْراً","فمن زَرَدِ الدروع لهم شِعارُ",13,"ر",1,0],["إِذَا اضْطَرَبَتْ تَحْتَ الظَّلامِ تَخَالُهَا","دُمُوعَ الْعَذَارَى فِي حِدَادِ الْمَآتِمِ",14,"م",1,0],["إِذا أَضاعَ بَنو الأَوطانِ حُرمَتَها","فَمَن يُغالي بِها أَم مَن يُراعيها",15,"ي",3,0],["إِذا اِضطَرَبَت تَحتَ الرِياحِ رَأَيتَها","كَأَحشاءِ مَنحوتِ الفُؤادِ مِنَ الذُعرِ",16,"ر",1,0],["إذا أضعناهُ فوارحمتاه","لنا وبؤسَى لليدِ الجاحدهْ",17,"ه",1,0],["إذا اضطَرَبَت سُمرُ اليَراعِ بِكَفِّهِ","تَرَى دُرَراً تَنحَطُّ مِن فَمِ أَرقَمِ",18,"م",1,1],["إِذا أَضمَرَ الأَملاكُ حِقداً لِمَن جَنى","كَفاكُم وَحِيُّ البَطشِ أَن تُضمِرُا حِقدا",19,"د",2,0],["إذا اضرموا للحرب نارا طفأتها","بألفاظ خدّاع يلين له الصعب",20,"ب",1,0],["إذا أضنَى الجوى جسمي","رَجائي يُنضِرُ القَلبا",21,"ب",2,0],["إذا اضْطرَمتْ نيرانُها انهَلّ دمْعها","فلا فَرْقَ إلا أنّها تَحْمَد الشّجا",22,"ج",2,0],["إِذا أَضاءَت لَهُم نار الضُلوع مشوا","وَإِن خبت بِدُموعي مرة نَزَلوا",23,"ل",3,0],["إذا اضطرم البرقُ اليمانيُّ في الدجى","تَضَرَّمَ مرتاعُ الفُؤاد حَزينُهُ",24,"ن",2,1],["إذا أضْرَمَتْ أعداؤه نارَ باطلٍ","أثار عليها الحقَّ يوماً فأخمدا",25,"د",2,0],["إذا اضطرّوا وأجدب وادياهم","إلى استمطار وابلك العميمِ",26,"م",1,0],["إذا أضبَّتْ على شيء أناملُه","حفظاً فأضيعُ عانيه الدنانيرُ",27,"ر",1,0],["إذا أضمرتم ليلةٌ أظهرتهمُ","صبيحتُها بين المُنى والمآربِ",28,"ب",1,0],["إذا اضمر الركب الدجى أظهرتهم","شموس ضُحىً أفلاكهن المحاملُ",29,"ل",1,0],["إذا أضرمت نار الظبى في أكفهم","فما عسلان السمر إلاَّ أفاكل",30,"ل",1,0],["إِذا اِضطرَب الشوق في قلبهِ","تمايلَ كالغُصُنِ النّاعمِ",31,"م",1,0],["إذا اضْطَرَبَتْ قُلْتُ ريحانَةً","تَرَنّحُ من رِيحِهَا السَّجْسَجِ",32,"ج",1,0]]}