{"poems":[[55,"رضيت من الأحباب دون الذي يرضي","https://www.aldiwan.net/poem30167.html","الطويل"],[65,"أبا خالد كم تدعي لي مودة","https://www.aldiwan.net/poem45859.html","الطويل"],[65,"بعيشكما يا صاحبي دعانيا","https://www.aldiwan.net/poem46218.html","الكامل"],[3,"ألا يا دار عبلة بالطوي","https://www.aldiwan.net/poem119.html",""],[79,"بحيث القباب البيض والأسل السمر","https://www.aldiwan.net/poem36489.html","الطويل"],[79,"دعاك بأقصى المغربين غريب","https://www.aldiwan.net/poem36715.html","الطويل"],[85,"لك الله من فذ الجلالة أوحد","https://www.aldiwan.net/poem54297.html","الطويل"],[94,"أزنبقة السفح ما لي أراك","https://www.aldiwan.net/poem38887.html","المتقارب"],[45,"أهلا بدار سباك أغيدها","https://www.aldiwan.net/poem9531.html","المنسرح"],[64,"نصيحكما فيما يقول مريب","https://www.aldiwan.net/poem52505.html","الطويل"],[30,"لنا دون من تحت السماء عليهم","https://www.aldiwan.net/poem5091.html","الطويل"],[63,"وزنجية عرفت بالإباق","https://www.aldiwan.net/poem51528.html","المتقارب"],[68,"مدحتك مدح بشار بن برد","https://www.aldiwan.net/poem38603.html","الكامل"],[82,"نعيمك أن تزف لك العقار","https://www.aldiwan.net/poem31437.html","الوافر"],[89,"لعزة هذي اللاهيات النواعم","https://www.aldiwan.net/poem8339.html","الطويل"],[107,"الله أكبر باسم الله أهديها","https://www.aldiwan.net/poem43131.html","البسيط"],[54,"سأرحل عنكم لا جوادا بعبرة","https://www.aldiwan.net/poem26976.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39627","السريع"],[129,"إذا اضطربت سمر اليراع بكفه","https://www.aldiwan.net/poem4069.html","الطويل"],[147,"أما ومساع لا نحيط لها عدا","https://www.aldiwan.net/poem11755.html","الطويل"],[190,"ألام على رفقي بمن لا أحبه","https://www.aldiwan.net/poem44140.html","الطويل"],[275,"هجرت الأهل والصحبا","https://www.aldiwan.net/poem35399.html","الهزج"],[280,"وصفراء في لون المحب وحاله","https://www.aldiwan.net/poem25606.html","الطويل"],[385,"لقد علمت يقينا بعدما رحلوا","https://www.aldiwan.net/poem49251.html","البسيط"],[422,"إذا اضطرم البرق اليماني في الدجى","https://www.aldiwan.net/poem53836.html","الطويل"],[422,"ألما على لومي وجدا مجددا","https://www.aldiwan.net/poem54134.html","الطويل"],[463,"لنا من ليلنا بلِوى الصريمِ","https://www.aldiwan.net/poem55891.html","الوافر"],[463,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[466,"خذوا من ذمامي عدة للعواقب","https://www.aldiwan.net/poem15082.html","الطويل"],[466,"عفا ضارج من آل ليلى فعاقل","https://www.aldiwan.net/poem15298.html","الطويل"],[469,"نعم هذه آثارهم والمنازل","https://www.aldiwan.net/poem3164.html","عموديه"],[556,"أيا ظبية في ربى جاسم","https://www.aldiwan.net/poem47219.html","المتقارب"],[572,"هلما بكانوننا جاحما","https://www.aldiwan.net/poem69766.html","المتقارب"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96579","الطويل"],[1267,"","https://poetry.dctabudhabi.ae/diwan/poem/144503","المتقارب"],[1345,"","https://poetry.dctabudhabi.ae/diwan/poem/145372","المتقارب"],[1358,"","https://poetry.dctabudhabi.ae/diwan/poem/143805","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101017","الكامل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21465","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87797","الوافر"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93401","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100415","الوافر"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100424","المتقارب"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58372","الوافر"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17759","الوافر"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86367","الطويل"],[4690,"أمْنيات أسيرة","https://www.poetsgate.com/ViewPoem.aspx?id=120284",""],[4755,"بَدَا كما يَبدو السَّرابُ النَّشُوزْ","https://www.poetsgate.com/ViewPoem.aspx?id=201637",""],[5105,"إلام اتباعي للأماني الكواذبِ","https://www.poetsgate.com/ViewPoem.aspx?id=135342",""],[5212,"زعيمُ الحوزةِ الكُبرى","https://www.poetsgate.com/ViewPoem.aspx?id=212056",""],[5410,"العشق الخالد","https://www.poetsgate.com/ViewPoem.aspx?id=141977",""],[5431,"القصيدة الكونية ..وثقبُ الكون سبّاقُ ...","https://www.poetsgate.com/ViewPoem.aspx?id=199015",""],[2546,"أقولُ والرَّكبُ قد مالتْ عمائمهمْ","https://www.poetsgate.com/ViewPoem.aspx?id=17532",""],[5783,"زوجتي الحبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=61545",""],[5939,"رسالة إلى أنثى","https://www.poetsgate.com/ViewPoem.aspx?id=178589",""],[572,"أذَابَتْ قلبَهُ الزّفرهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9323&r=&rc=180",""]],"verses":[["إِذا اِضطَرَمَت ما بَينَ جَنبيَّ غَضبَةٌ","وَكادَ فَمي يُمضي مِنَ القَولِ ما يُمضي",0,"ض",2,0],["إِذَا اضْطَرَمَتْ في القَلْبِ نارُ عَداوَةٍ","لَمحْتُ بِعَيْنَيْ مُصْطَلِيها وَمِيضَها",1,"ه",2,0],["إذا اضطَربوا فَوقَ الرِّحالِ حَسِبتَهُمْ","وقد لفظَ الفَجرَ الظّلامُ أفاعِيا",2,"ي",2,0],["إِذا اِضطَرَبوا سَمِعتَ الصَوتَ فيهِم","خَفيّاً غَيرَ صَوتِ المَشرَفِيِّ",3,"ي",1,0],["إذا اضْطَبَنوا أقْواسَهُمْ وتمَنْطَقوا","فتُبْصِرُ جيْشَ التُّرْكِ جاشَتْ بهِ مِصْرُ",4,"ر",1,0],["إِذَا اضطَربَ الْخَطِّيُّ فَوْقَ غَديِرهَا","يَرُوقُكَ مِنْهَا لُجَّةٌ وَقَضِيبُ",5,"ب",1,0],["إذا أضمرت من بأسها الحرب جاحماً","تأجَّجَ منه العَضْبُ في لجة البحرِ",6,"ر",1,0],["إِذا أَضْجَرَتْكِ أغاني الظَّلامِ","فَقَدْ عَذَّبَتْني أَغانِي الوُجومْ",7,"م",1,0],["إِذا أَضَلَّ الهُمامُ مُهجَتَهُ","يَوماً فَأَطرافُهُنَّ تَنشُدُها",8,"د",3,0],["إِذا أضمروا كيداً تدلَّى عليهم","عليمٌ بأسرارِ الغُيوب لَبيبُ",9,"ب",1,0],["إِذا أَضحَتِ الآفاقُ مِن كُلِّ جانِبٍ","عَلَيها قَتامُ المَحلِ بادٍ بُسورُها",10,"ر",3,0],["إذا اضطربَ الماءُ من حَولِها","رَأيْتَ الجبالَ بها في تَلاَقي",11,"ق",2,0],["إِذا اِضطُرَّ الشَريفُ إِلى كَنيفٍ","فَلَيسَ عَلَيهِ إِذ يَأتيهِ عارُ",12,"ر",1,0],["إذا أضحى شعارُ الأُسدِ شَعْراً","فمن زَرَدِ الدروع لهم شِعارُ",13,"ر",1,0],["إِذَا اضْطَرَبَتْ تَحْتَ الظَّلامِ تَخَالُهَا","دُمُوعَ الْعَذَارَى فِي حِدَادِ الْمَآتِمِ",14,"م",1,0],["إِذا أَضاعَ بَنو الأَوطانِ حُرمَتَها","فَمَن يُغالي بِها أَم مَن يُراعيها",15,"ي",3,0],["إِذا اِضطَرَبَت تَحتَ الرِياحِ رَأَيتَها","كَأَحشاءِ مَنحوتِ الفُؤادِ مِنَ الذُعرِ",16,"ر",1,0],["إذا أضعناهُ فوارحمتاه","لنا وبؤسَى لليدِ الجاحدهْ",17,"ه",1,0],["إذا اضطَرَبَت سُمرُ اليَراعِ بِكَفِّهِ","تَرَى دُرَراً تَنحَطُّ مِن فَمِ أَرقَمِ",18,"م",1,1],["إِذا أَضمَرَ الأَملاكُ حِقداً لِمَن جَنى","كَفاكُم وَحِيُّ البَطشِ أَن تُضمِرُا حِقدا",19,"د",2,0],["إذا اضرموا للحرب نارا طفأتها","بألفاظ خدّاع يلين له الصعب",20,"ب",1,0],["إذا أضنَى الجوى جسمي","رَجائي يُنضِرُ القَلبا",21,"ب",2,0],["إذا اضْطرَمتْ نيرانُها انهَلّ دمْعها","فلا فَرْقَ إلا أنّها تَحْمَد الشّجا",22,"ج",2,0],["إِذا أَضاءَت لَهُم نار الضُلوع مشوا","وَإِن خبت بِدُموعي مرة نَزَلوا",23,"ل",3,0],["إذا اضطرم البرقُ اليمانيُّ في الدجى","تَضَرَّمَ مرتاعُ الفُؤاد حَزينُهُ",24,"ن",2,1],["إذا أضْرَمَتْ أعداؤه نارَ باطلٍ","أثار عليها الحقَّ يوماً فأخمدا",25,"د",2,0],["إذا اضطرّوا وأجدب وادياهم","إلى استمطار وابلك العميمِ",26,"م",1,0],["إذا أضبَّتْ على شيء أناملُه","حفظاً فأضيعُ عانيه الدنانيرُ",27,"ر",1,0],["إذا أضمرتم ليلةٌ أظهرتهمُ","صبيحتُها بين المُنى والمآربِ",28,"ب",1,0],["إذا اضمر الركب الدجى أظهرتهم","شموس ضُحىً أفلاكهن المحاملُ",29,"ل",1,0],["إذا أضرمت نار الظبى في أكفهم","فما عسلان السمر إلاَّ أفاكل",30,"ل",1,0],["إِذا اِضطرَب الشوق في قلبهِ","تمايلَ كالغُصُنِ النّاعمِ",31,"م",1,0],["إذا اضْطَرَبَتْ قُلْتُ ريحانَةً","تَرَنّحُ من رِيحِهَا السَّجْسَجِ",32,"ج",1,0],["إِذا اَضمرت لم يقلق النِسعُ واحتبى","به جوزُ حدباءَ الحصيرين عَيهَلِ",33,"ل",1,0],["إذا اضطربت الماء من حولها","رأيت الحبال بها في تلاق",34,"ق",1,0],["إذا اضطرم النَّارُ في جانبٍ","تقطَّر من جانبٍ آخر",35,"ر",1,0],["إذا اضطجعت أتاني الشعر يقدح لي","من ناره وأتاني الليل بالفحم",36,"م",1,0],["إذا أضرمت أو شب منها أوارها","لم تصل غير مروعين ضعاف",37,"ف",1,0],["إِذا اضطَمَّ ميتاءُ الطَّريقِ عَليهِما","مَضَت قُدماً مَوجَ الجِبال زَهوقُ",38,"ق",1,0],["إِذا أَضواؤُه سَطعت ظَلاماً","تُنير لَكَ المَسالك وَالمَخارق",39,"ق",1,0],["إِذا اِضطَرَبَت فَوقَ الأَكُفِّ حَسبتَها","لِغيبتها عَن صَيدِها في مُعَلَّقِ",40,"ق",1,0],["اذا اضطربت ضمائرنا رجعنا","الى القربى نكلفها السكونا",41,"ن",2,0],["اذا اضطربت روعة في الحشا","ربطت لها بعض احشائيه",42,"ي",2,0],["إذا أضطَجَعَتْ تغنّتْ من سعالٍ","وأُبصِرُها على صور السّعالي",43,"ل",2,0],["إِذا اِضطَرَبَ الحِزامُ عَلى حَشاها","مِنَ الأَعمالِ مُضطَرَبَ الوِشاحِ",44,"ح",1,0],["إذا اضطرم البرق اللموع بذي الغضا","ذكرت بذاك الشعب ماضي عهودها",45,"د",3,0],["إذا أضْحَكَتْ فَهْي تُخْفي البُكا","ولا يَلْبَثُ القَلْبُ أنْ يُجْلَدا",46,"د",2,0],["إذا أَضَاعَ الحَقَّ أَصحابُهُ","أُجِيزَ لِلسُّرَّاقِ ما لا يَجوز",47,"ز",1,0],["إذا اضطرمتْ نارُ الجِلادِ ببيضهم","غدا ساقطاً فيها فراش الحواجب",48,"ب",1,0],["إِذا أُضْجِرتَ أَنْ شُيِّعتَ في لَيْلٍ","فَقَد شُيِّعْ أَبو الشُّهَدا بِلا غُسُلِ",49,"ل",1,0],["إذا أضاءَ صلاحُ الأمرِ صحوتها","أُطاحَ بالذنْبِ لا يُبقي له أثرا",50,"ر",2,0],["إذا اضطربت فكون الذعر أعرفه","إذا ومضتَ فمن عينيك اشراقُ !!",51,"ق",1,0],["إذا أضاءت من البستانِ حاوية","ً بألف صَوْتٍ بديعٍ غَيْرِ مَلبوسِ",52,"س",1,0],["إذا أضمكِ مشتاقاً يبعثرني","خصرٌ رقيقٌ..كأني ممسكٌ سحْبا",53,"ب",2,0],["إذا أضنَتْكِ نارُ الوَجْدِ مِثلي","فناديني بلا كِبْرٍ: \"تَعالَ\"",54,"ل",1,0],["إِذا أَضْمَرْتَ في الحبّ","وفاءً أَضمرَ الغدرَهْ",55,"ر",2,0]]}