em.aspx?id=11409",""],[13,"وَلَقَدْ سَرَيْتُ عَلَى الظَّلاَم بِمغْشَمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=180800",""],[67,"وَالغَرْسُ في البَدُوِ المُشار لِفضلِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=14563",""],[90,"دمعَة على صديق","https://www.poetsgate.com/ViewPoem.aspx?id=179103",""],[90,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[0,"ألا انعم صباحاً أيها الربع وانطقِ","https://www.poetsgate.com/ViewPoem.aspx?id=4799",""],[45,"أجد الوجد جمرة في ضميري","https://www.poetsgate.com/ViewPoem.aspx?id=31275",""],[45,"أنبل بوهب أنبل بضرطته","https://www.poetsgate.com/ViewPoem.aspx?id=31203",""],[45,"سَهَرٌ أَصَابَك بَعْدَ طُولِ نُعَاسِ","https://www.poetsgate.com/ViewPoem.aspx?id=31226",""],[51,"أتصَاب إلى ذوي إسعادِهْ","https://www.poetsgate.com/ViewPoem.aspx?id=27791",""],[51,"شابَ رأسي ولات حينَ مَشيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=26854",""],[2,"صَحا القَلبُ عن سلمى وأقصرَ باطِلُهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19479&r=&rc=5",""],[31,"نُعْمُ الفُؤَادِ مَزارُها مَحْظُورُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18866&r=&rc=129",""],[31,"هَيَّجَ القَلْبَ مَغَانٍ وَصِيَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18881&r=&rc=144",""],[31,"آذَنَتْ هِنْدٌ بِبَيْنٍ مُبْتَكِرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18880&r=&rc=143",""],[31,"هل يتكلمُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19061&r=&rc=324",""]],"verses":[["فاتَني مِنكَ اِنتِصارٌ بِيَميني","فَتَلافَيتُ اِنتِصاراً بِمَقالي",0,"ي",1,0],["فاتَ يَدَيكَ قابُها","وَالقُلَلُ الأَطاوِلُ",1,"ل",1,0],["فَأَتَتكَ تَلتَهِمُ الهَواجِرَ طُلَّحاً","وَالظِلُّ بَينَ خِفافِها وَالجَروَلِ",2,"ل",1,0],["فاتَكَ البَرقُ فَمَن يَر","جو وَقَد فاتَ لُحوقَه",3,"ق",2,0],["فاتَني أَن أَرى الدِيارَ بِطَرفي","فَلَعَلّي أَرى الدِيارَ بِسَمعي",4,"ي",1,0],["فاتَ بِها كُلَّ جَوادٍ وَطِمِرّ","سَبقاً إِلى غايَةِ كُلِّ مُفتَخِر",5,"ر",1,0],["فَأَتَتكَ لَو كَلَّفتَ ما كَلَّفتَها","نُوَبَ الزَمانِ أَتَتكَ وَهيَ زَوافِرُ",6,"ر",1,0],["فاتَكَ السِربُ وَما زُو","وِدتَ غَيرَ الحَسَراتِ",7,"ت",1,0],["فَأَتَتْ ريماً هَضيماً كَشحُهُ","ثَمِلَ العَينَينِ مَوهونَ الخُطا",8,"ا",1,0],["فأتَتْ مُعاوِيَّ الفَخارِ وألْصَقَتْ","طَرَفَ الجِرانِ بمَبْرَكٍ مألوفِ",9,"ف",1,0],["فات مجدي إنّما","في ذمّة الأيّام مجدي",10,"ي",1,0],["فَاِترُكوا البَغيَّ وَالتَعَدي وَإِما","تَتَعاشوا فَفي التَعاشي الدَاءُ",11,"ا",2,0],["فَاِترُكِ الوَجدَ وَالهَوى لِمُحِبٍّ","قَلبُهُ قَد أَذابَهُ التَعذيبُ",12,"ب",1,0],["فَأَتَيتُها وَالشَمسُ في كَبَدِ السَم","وَالقَومُ بَينَ مُقَدِّمٍ وَمُؤَخِّرِ",13,"ر",1,0],["فَاِتبَع مَكارِمَهُ وَلا تُذري بِهِ","إِن كُنتَ مِمَّن عَقلُهُ قَد أُكمِلا",14,"ل",2,0],["فآتَاهُ لَمَّا أَنْ أَجَابَ دُعَاءَهُ","مِنَ الْعِزِّ مَا لَمْ يُؤتَ يَوْماً لإِنْسَانِ",15,"ن",1,0],["فاِترُك مُحاوَرةَ السَفيهِ فَإِنَّها","نَدمٌ وَغِبٌّ بَعدَ ذاكَ وَخيمُ",16,"م",1,0],["فَاِترُكوا اللَهوَ في الحَياةِ وَجِدّوا","إِنَّ في اِسمِ الرَئيسِ أَيمَنَ فالِ",17,"ل",1,0],["فَاِتَّقوا غَضبَةَ العَواصِفِ إِنّي","قَد رَأَيتُ المَصيرَ أَمسى وَخيما",18,"م",2,0],["فَاِتَّقوها بِجُنَّةٍ مِن وِئامٍ","غَيرِ رَثِّ العُرا وَسَعيٍ وَكَدِّ",19,"د",1,0],["فَاِتَّقوا الطَودَ مَكيناً راسِياً","وَاِتَّقوا الطَودَ إِذا ما الطَودُ عاما",20,"م",2,0],["فَاِتَّقوا الأَرضَ وَالسَماءَ سَواءً","وَاِتَّقوا النارَ في الثَرى وَالفَضاءِ",21,"ا",2,0],["فَأَتى يُبرِدُ الغَليلَ بِقَطرٍ","مِن نَدى سَيِّدٍ يُواسي الغَريبا",22,"ب",2,0],["فأْتِ البيوتَ من الأبوابِ يا عُمَرٌ","فقد يُزَنُّ من الحِيطانِ آتيها",23,"ي",3,0],["فَأَتى بِما لَم يَأتِهِ مُتَقَدِّمٌ","أَو تَطمَعُ الأَذهانُ في إِتيانِهِ",24,"ن",2,0],["فَأَتَيتُ صِفرَ الكَفِّ لَم أَملِك سِوى","أَمَلي بِصَفحِكَ عَن قُصورِ كَلامي",25,"ي",1,0],["فَأَتاحَ القَضاءُ لي رَهطَ سوءٍ","كَذِئابٍ قَد أَخفَقَت أَو نُمورِ",26,"ر",1,0],["فَأَتبَعتُهُم طَرفي وَقَد حالَ دونَهُم","غَوارِبُ رَملٍ ذي أَلاءٍ وَشَبرَقِ",27,"ق",1,0],["فَأَتبَعتُهُم عَينَيَّ حَتّى تَلاحَمَت","عَلَيها قِنانٌ مِن خَفَينَنَ جونُ",28,"ن",1,0],["فَأَتَت بِهِ أَسَلَ الأَسِنَّةِ ضامِرٌ","مِثلُ العُقابِ غَدَت مِنَ الوَكرِ",29,"ر",1,0],["فأتت لهم أمٌّ وأنت أميرٌ","أجل لك الدنيا وأجوادها فدى",30,"د",2,0],["فَأَتْقِنُوا مِثْلَهَا الفِعَالَ يَعُدْ","لِمِصْرَ سُلْطَانُهَا وَسُؤْدُدُهَا",31,"د",3,0],["فَأَتاهُ سَهمٌ مِن يَدٍ مَشؤومَةٍ","مِن قَوسِ مَلعونٍ خَبيثِ المَولِدِ",32,"د",1,0],["فاتحتني منها بخمس ولائدٍ","لتُعيذها من كل عين تلفَعُ",33,"ع",1,0],["فاتحتني شَرَّفتني","برقعة مرفّعَهْ",34,"ع",2,0],["فأتى يؤمم منك هدْياً صالحاً","كي يستمدْ النور بعد سرارِ",35,"ر",1,0],["فأتت كما شاءت وشاء نجيبها","تُذكي الحجى وتُنعِّم الأرواحَا",36,"ح",2,0],["فاتّقوا اليوم صَولةً من يراع","واقفٍ في مواقف التنديد",37,"د",1,0],["فأْتُوا من الأعمال ما هو صالح","للناس فيه مصالح وفوائد",38,"د",1,0],["فأتبَعَه مني شهاب تسامح","يَشُق ظلام الجهل بالحلم ثاقبه",39,"ب",2,0],["فَأَتاهُمُ سَبعونَ أَلفَ مُدَجَّجٍ","مُتَلَبِّسينَ يَلامِقاً وَحَديدا",40,"د",2,0],["فاتت بما هي أهله","والعِي من شلل المحاضِر",41,"ر",1,0],["فَاِترُك مُجامَلَةَ اللَئي","مِ فَإِنَّ فيها العَجزَ كُلَّه",42,"ه",1,0],["فاتِراتٍ قَواتِلٍ فاتِناتٍ","فاتِكاتٍ سِهامُها في القُلوبِ",43,"ب",1,0],["فَأُتينا بِسابِحٍ يَعبوبٍ","لَم يُذَلَّل بِمِعلَفٍ وَرِباطِ",44,"ط",1,0],["فَأتوا بُيوتَ الناسِ مِن أَدبارِها","حَتّى تَظَلَّ وَكُلُّهُنَّ مَجوبُ",45,"ب",1,0],["فأتى إليَّ الرزقُ يسعى منشداً","كسّ أختِ رزقٍ لا يدقُّ البابا",46,"ب",2,0],["فاتحٌ في الكرى فماً سكَّرِياً","يا لهُ من مسكّرٍ مفتوحِ",47,"ح",1,0],["فأتتك من صنف الجمال بديعة","والنظم مثل بنيه ذو إنصاف",48,"ف",1,0],["فاتك اللحظ وهو حلوٌ مع الف","تك فيا حبَّذا الحسام المحلَّى",49,"ل",2,0],["فأتى شرُّهم على كلِّ بُقيا","لا لَقوا من مُلمَّةٍ إبقاءَ",50,"ا",2,0],["فات هذا فلن تراه يد الدَه","ر فَأنْعِمْ في إثْره بالبكاءِ",51,"ا",2,0],["فاتركَنْهُ لا يهتدى لمبيتٍ","بنُباحٍ ولا بطولِ عُواءِ",51,"ا",2,0],["فاتَّخذْهُ على الشباب حداداً","وابكِ فيه بعَبْرة ونَحيبِ",52,"ب",1,0],["فاتقِ اللّه أيُّها الحاكمُ العا","دلُ فيمن يُضحي ويمسي نخيبا",53,"ب",2,0],["فأتَنِفْ توبةً وراجعْ فعالاً","ترتضيهِ الأسلافُ للأعقابِ",54,"ب",1,0],["فاترك نعيباً شُؤمُهُ راجعٌ","عليك يحدوك إلى مَعْطَبِ",55,"ب",1,0],["فاتَّقِ اللَّه أنْ تَلُزَّ بفقري","ح