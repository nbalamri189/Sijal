فر"],[456,"أدرك ما شاء غلام فطنا","https://www.aldiwan.net/poem55840.html","الرجز"],[456,"ردوا لها أيامها بالغميم","https://www.aldiwan.net/poem55888.html","السريع"],[456,"من موصل بالسؤال والقسم","https://www.aldiwan.net/poem55894.html","المنسرح"],[459,"خذوا من ذمامي عدة للعواقب","https://www.aldiwan.net/poem15082.html","الطويل"],[459,"أسر بالبرق لا حرصا على الديم","https://www.aldiwan.net/poem16089.html","البسيط"],[461,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[462,"شف قلبي دلاله","https://www.aldiwan.net/poem3358.html","عموديه"],[466,"لك عندي مينا من الهليون","https://www.aldiwan.net/poem59607.html","الخفيف"],[466,"جمالي وزيني إذا ما حضر","https://www.aldiwan.net/poem59983.html","المتقارب"],[475,"حي عني منحني الوادي وأثله","https://www.aldiwan.net/poem15200.html","الخفيف"],[475,"أطل الوقوف على رسوم الدار","https://www.aldiwan.net/poem15238.html","الطويل"],[498,"رفعت بسري كل أمري لسيدي","https://www.aldiwan.net/poem38020.html","الطويل"],[513,"الحمد لله الذي","https://www.aldiwan.net/poem12285.html","مجزوء الرجز"],[516,"عربي أنا","https://www.aldiwan.net/poem13728.html","عموديه"],[549,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[549,"قد هويناه ناقضا للعهود","https://www.aldiwan.net/poem47853.html","الخفيف"],[556,"بأسماء رب العالمين ابتدائيا","https://www.aldiwan.net/poem33573.html","الطويل"],[556,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"],[556,"دللناك يا من أنت ذمي ديننا","https://www.aldiwan.net/poem34710.html","الطويل"],[560,"نار وما ادراك ناري ما هيا","https://www.aldiwan.net/poem52980.html","الكامل"],[560,"أي ذنب ترى وأية زله","https://www.aldiwan.net/poem52985.html","الخفيف"],[584,"أبدا بذكرك تنقضي أوقاتي","https://www.aldiwan.net/poem17455.html","الكامل"]],"verses":[["ورضْتَ أمراً أطافَ العاجِزونَ بهِ","وكادَ يَلوي بشَمْلِ المُلْكِ تَبديدُ",0,"د",1,0],["وَرَضيتُ بَعدَ تَنَكُّبي طُرُقَ الهَوى","أَن قيلَ صاحِبُ رايَةِ العُشّاقِ",1,"ق",1,0],["وَرَضيتُ مِنكِ بِدونِ ما","يَرضى المُحِبُّ مِنَ الحَبيبِ",2,"ب",1,0],["ورضَوْا بالصّبْرِ فما وهَنوا","جزَعاً في الدّينِ ولا قَلَقا",3,"ق",2,0],["ورُضْتَ صِعابَ الدّهْرِ وهْيَ شَوامِسٌ","فذلّلْتَها منْ غيرِ جُهْدٍ ولا عُنفِ",4,"ف",1,0],["ورضاكَ طاعَتُهُ وبرُّكَ دأبُهُ","ودُعاؤهُ لعُلاكَ واستِغْفارُهُ",5,"ر",2,0],["ورِضْوانُ أعْظَمُ شَيْءٍ يَدُلُّ","على أنّ دارَكَ دارُ الخُلودْ",6,"د",1,0],["وَرَضيتُ عَنها بِالرِضا لَمَّا أَتَت","مِن دون عُسرَةِ ضِغنِها بِيَسارِ",7,"ر",1,0],["وَرَضنا مُلوكَ الأَرضِ بِالبيضِ وَالقَنا","فَذَلَّ لَنا مِن كُلِّ قطرٍ صِعابُهُ",8,"ب",2,0],["ورِضَاهَا السِّلْمُ اَشْبَهُ مَا","كَانَ فِي عُقْبَاهُ بِالحَرْبِ",9,"ب",1,0],["وَرُضَّعٍ وَجَدُوا الأَثْدَاءَ لاذِعَةً","كَالجَمْرِ فَانْفَطَمُوا وَاسْتَنْكَرُوا الحَلَمَا",10,"م",2,0],["ورضاك عنه خيرُ ما ألبسته","فلقد أشاد بجاهه وببرْه",11,"ر",2,0],["ورضاك عنه غايةٌ ما بعدها","إلا رضى الله الذي ابتدع البشرْ",12,"ر",1,0],["ورُض بهم كل صعب إنهم فئةٌ","تبغى الصدور ولا ترضى بأعجاز",13,"ز",1,0],["ورضاب حماه رمح التثنِّي","فهوينا العسَّال والمعسولا",14,"ل",2,0],["ورضاهم هناك بالنِّصف والرُّب","ع وأَدْنى رضاكَ في الإِرباءِ",15,"ا",2,0],["وَرَضِيَتْهُ منظراً وَملْمَسا","رَدَّتْه في أرْحَامها مُكَوَّسا",16,"س",2,0],["وَرِضا اللَهِ نَرتَجيهِ وَلَكِن","لا يُؤَدّي إِلَيهِ إِلّا الكَمالُ",17,"ل",1,0],["وَرُضابٍ يوعَدُ كَوثَرُهُ","مَقتولُ العِشقِ وَمُشهَدُهُ",18,"د",2,0],["ورِضا الحسودِ زوالُ نعمتِكَ التي","أُوتِيتَها من طَارفٍ أو تالدِ",19,"د",1,0],["وَرَضينا بِحُكمِ غَيثِكَ فيها","أَنَّهُ صائِبٌ وَأَنتَ مُصيبُ",20,"ب",1,0],["وَرَضيتُ مِن عَودِ البَخيلِ وَبَدئِهِ","بِاليَأسِ لَو نَفَعَ الرِضا بِالياسِ",21,"س",1,0],["ورضىً عن الإنجيلِ يُظْهِرُ فيهما","غَضبَاً على الفُرقانِ والأحزابِ",22,"ب",1,0],["وَرَضيتَ مِنها في الَّذي","تَأتي بِأَقبَحِ فِعلِها",23,"ل",3,0],["وَرَضيتُ مِنهُ بِالسَلا","مِ فَصِرتُ أَرضى بِالسَلامَه",24,"م",2,0],["ورضاكِ أنتِ وقايتي","فإذا غضبتِ فمَنَ يقيني",25,"ي",1,0],["ورَضينا بسكونٍ وسلام","وانتهينا لفراغٍ كالعَدَم",26,"م",1,0],["ورضابُ الماءِ بفيكِ جَرَى","في جوهره عَرَضُ الصَّرَدِ",27,"د",1,0],["وَرُضابُ المِسكِ مِن أَثوابِهِ","مَرمَرَ الماءَ عَلَيهِ فَنَضَر",28,"ر",1,0],["وَرَضِيْتُ مِلَّتَهُ لنفسي إنَّه","لعلى طريقٍ للسدادِ مُعَبَّدِ",29,"د",1,0],["وَرَضو الَّذي كَرِهوا لِأَوَّلِ مَرَّةٍ","وَرَأى سَبيلَ طَريقِهِ المُتَهَدِّدُ",30,"د",1,0],["ورَضُوا لهُ غَضَبَ الإِلهِ فلا عَدا","غَضَبُ الإلهِ عَدُوَّهُ الضِّلِّيلا",31,"ل",2,0],["ورَضُوا لِمُوسى أنْ يقولَ فواحِشاً","خَتَمَتْ وَصِيَّتُهُ لهنَّ فصُولا",31,"ل",2,0],["وَرُضابٍ بِتُّ أَرشُفُهُ","يَنقَعُ الظَمآنَ مِن خَصَرِه",32,"ر",2,0],["وَرَضيتُ القَليلَ مِنهُنَّ إِنّي","مِن قَليلٍ لَواثِقٌ بِكَثيرِ",33,"ر",1,0],["وَرُضابِ ذي أَشَرٍ أَغَرَّ كَأَنَّما","غُبِقَت مَشارِبُهُ مِنَ التُفّاحِ",34,"ح",1,0],["وَرَضيتُ مِن طولِ العَناءِ بِيَأسِهِ","وَاليَأسُ أَيسَرُ مِن عِداتِ الكاذِبِ",35,"ب",1,1],["وَرَضيتَ مِن طولِ الرَجاءِ بِيَأسِهِ","وَاليَأسُ أَمثَلُ مِن عِداتِ الكاذِبِ",36,"ب",1,0],["وَرُضتُ صِعابَ آمالي فَكانَت","خُيولاً في مَراتِعِها شَمَسنَه",37,"ن",2,0],["ورُضَابٍ كأنَّه ما يَمُجُّ النْ","نَحلُ طِيباً وما يَسُحُّ الحَبِيُّ",38,"ي",1,1],["ورضيع آداب أقلتَ عثارهُ","فإذا رمى الأعداء كان البادي",39,"د",2,0],["ورضِينا حُكْمَ الزَّمانِ وما كانَ","احتكامُ الزمانِ بالمَرْضي",40,"ي",1,0],["وَرَضِيتُ، مِنْ عَوْدِ البَخِيلِ وَبَدْئِهِ،","باليَأسِ، لَوْ نَفَعَ الرّضَى باليَاسِ",41,"س",1,0],["وَرضة أُنس باتَ فيها اِبن أَيكة","يُغرد وَالناي الرَخيم يَشنف",42,"ف",1,1],["ورضيت الطعن فيه","إن بعض الظن إثم",43,"م",1,0],["ورضىٌّ رضا الإله رضاه","وتقيٌّ أَعمالُه مرضاتُه",44,"ت",2,0],["وَرُضنَا بِهَا صَعبَ القَوَافي فأَصبَحَت","لَنَا ذُلَلاً فِيهَا ضَوىً ولَهَا قُوَى",45,"و",2,0],["ورُضُّتِ عُودَكِ حَتَّى إِن حَكاكِ غِناً","يَخشَاكِ إِن مَالَ عَمَّا قُلتِ مَائِلُهُ",46,"ل",2,0],["ورُض بها النفسَ إذا","أجلت طرِف الطرفِ",47,"ف",1,0],["ورضيتُ بالمُهدِى إلىّ نسيمَهم","إن المحب بما تيسَّر يَقنَعُ",48,"ع",1,0],["ورضعتُ ثدىَ نداك من دون الهوى","ثقةً بأنّ رصيعَه لا يُفطَمُ",49,"م",1,0],["ورضا الإله هو المنى ويكون من","بعدي انتفاع الخلق ثمّ طويلا",50,"ل",2,0],["وَرَضَّت فُؤادَ الشِرك أَسحَقَ رَضَّةٍ","كَواكِبُ أَفلاكٍ سَبائِكُ فِضَّةٍ",51,"ه",1,0],["ورضى وفقد رضاك ليس بهينٍ","عندي فيحسنُ منيَّ التفويضُ",52,"ض",1,0],["ورضيت أن يحبى عليّ","لوقت منصرفي لفافي",53,"ي",1,0],["ورضاب الشيوخ في نكهات ال","عجز طعم الصحناة في مآبير",54,"ر",1,0],["وَرضيعٍ وسادَ وهو فطيمُ","فَعليه الصلاة والتسليمُ",55,"م",1,0],["وَرضيا دُنيا بهِ وَدينا","وَأَحرَزا كلَّ صنوف السعدِ",56,"د",1,0],["ورُضْتَ بحزمٍ كلَّ شيء فلم تَدَع","من الناس مخلوقاً يُرَى وَهْو حازم",57,"م",1,0],["وَرِضابُهُ الخَمرُ العَذيبُ وَخَدُّهُ الن","نَضر الحِمى وَعِذارِهِ العَلمانِ",58,"ن",1,0],["وَرَضيتُ حَرّاناً لَها داراً وَكَم","حامَت فَما وَصَلَت إِلَيها المَوصِلُ",59,"ل",1,0],["وَرَضْوْى وَسَلْمَى فِي الْوَقَارِ وَشُمَّخٌ","بِنَجْدٍ وَأَطْوَادُ السَّرَاةِ وَثَهْلاَنُ",60,"ن",1,0],["وَرُضْتُ أَفْرَاسَ تَحْسِينِي وَإِبْدَاعِي","بَيْنَ حَدَائِقِ أَشْعَارِي وَأَسْجَاعِي",61,"ي",1,0],["وَرُضْتُ فِيهَا غَرَامِي","يَقُودُهُ طِرْفُ طَرْفِي",62,"ف",2,0],["وَرَضِّ رَسُولَ اللهِ عَنَّا فَإِنَّهُ","عَلَيْهِ صَلاَةُ اللهِ أَرْأَفُ مِنْ يُبْقِي",63,"ي",1,0],["ورُضَابه خمرٌ حَوتهُ جفُونُه","فلأجل ذا يُحمى بها ويُصانُ",64,"ن",1,0],["ورضوا بأدنى مطلب فأجلهم","يرجو الغنى من راحة النباش",65,"ش",1,0],["ورضاء الشيخ في الوا","قع أولى بالصواب",66,"ب",1,0],["وَرضيعُ الكأْسِ يستعب","رُ من خوفِ الفطام",67,"م",1,0],["ورضاب فيك فإنما هو قهوة","تحلو لقلبي ساعة التمزيز",68,"ز",1,0],["ورضاك رحمتي التي أعتدها","تحيي منى نفسي وتذهب بوسي",69,"س",2,0],["ورضيت بالأمل القصي","وعشت بالأوهام وحدي",70,"ي",1,0],["ورضيع الكرى يفيق من النشوة","والطير ساكر بالنشيد",71,"د",1,0],["ورضيتني عبدا لحس","نك واحتقنت دمائيه",72,"ي",2,0],["ورضينا وسخطنا","وأمرنا ونهينا",73,"ن",2,0],["وَرُضابُ الثَّغْرِ لَمْ أَظفَرْ بهِ","هَنّأَ اللَّهُ أَراكاً وَبَشامَا",74,"م",2,0],["ورَضِينا بقسْمَةِ اللهِ إذ كا","نَ مُحالاً أَن يُجْمَعَ الفَضْلان",75,"ن",1,0],["ورَضِيتُ عن بَحْرٍ أُجاوِرُه","إن كانَ لا رِيٌّ ولا شَرَق",76,"ق",1,0],["ورَضِيتُ إذ سَلِمتْ عليك مَحاسنٌ","مَفدِيّةٌ بمدامعي وأضالعي",77,"ع",2,0],["ورَضيتَ بالنَّفس النَّفي","سَةِ شُكرَها مُتَعرِّضا",78,"ض",2,0],["وَرَضِيَ عَن الأَصحاب قاطِبَة","إِذ كُلَهُم بِالفَضل مَشهورُ",79,"ر",1,0],["وَرَضيتِ مِن أَحراز كُل فَضيلة","وَحَقيقة بِمحصل مَوهوم",80,"م",1,0],["وَرضاب مَعسول عَطرٌ","مِن شَم سلافتهُ سُكرا",81,"ر",2,0],["وَرضت بِها أَخلاقُهُ وَهِيَ صَعبَةٌ","فَلانَت وَأَهوى مِن قُطوب إِلى بَشَر",82,"ر",1,0],["ورضا النفوس بما يقدر ربُّه","شرفٌ تنالُ بنيلِهِ الإحسانا",83,"ن",2,0],["ورضِّ على أصحاب أحمد متبعاً","لتابعه أهل الحديث وراويه",84,"ي",2,0],["ورضِّ على الأصحاب أصحاب أحمد","وكن لهم في كل حين معظما",85,"م",2,0],["ورضِّ عن من بذلوا","نفوسهم للأنفس",86,"س",1,0],["ورَضِّ على الأصحاب أصحاب أحمد","أولي الجد في نصر الشريعة والحد",87,"د",1,0],["وَرُضتَ الحَوادِثَ ذا حِنكَةٍ","فَصَيَّرَت ما اِعوَجَّ مِنها سَوي",88,"ي",1,0],["ورضعنا من أفاويق الطلا","وكرهنا بعد عامين الفطاما",89,"م",2,0],["ورضوانها اليوم النجيب مشيرها","يحافظها مولىً عليها هو الخالُ",90,"ل",1,0],["ورضيع هواك في وله","وبعادك أورثه سقما",91,"م",2,0],["ورضيت عن زمني بحسن صنيعه","وغفرت عظم إساءة الأيّام",92,"م",1,0],["ورِضَاكَ رَدَّ لِيَ الرِّضا فِي أَوْجُهٍ","من خُزْرِ أَيَّامٍ عَلَيَّ غِضابِ",93,"ب",1,0],["ورَضُوا لباسَ الجُودِ يَنْهَكُ مِنهُمُ","بِالبُؤْسِ أَبشارَ النَّعِيمِ الأَرْغَدِ",94,"د",1,0],["ورضعتُ من أزهاره وسكرتُ من","أسماره وشربتُ من أضوائه",95,"ا",3,0],["ورضتُ صِعابَها لجما وخزما","مطيعَ الرأس فيها والعَصِيَّا",96,"ي",2,0],["ورُضتُ الآبيات العوصَ حتى","سهُلن لكلّ جعدِ السمع حزنِ",97,"ن",1,0],["ورُضْتُ لجاجَه فإذا حَرونٌ","متى أمنعْه طوعا يقتسرْني",97,"ي",1,0],["ورضتُ نفسي للنوى فأسمحتْ","أن تهجرَ الأهلَ لكم والوطنا",98,"ن",2,0],["ورضتُ صَرفَ الدهر أولان لي","فلم أُبَلْ يجمحُ بي أو يقومْ",99,"م",1,0],["ورضتُمُ أظهُرَ الليالي المقا","ديمِ وطُلتُم سوالفَ الأُمَمِ",100,"م",1,0],["ورضْتُ بأَخلاقِ المشيب شبيبةً","مُعاصيةً لا تسكتينُ لجاذبِ",101,"ب",1,0],["ورُضْت والكزَّة العوجاء عاطفةٌ","على مُثَقِّفِها حدْباءَ لم تَقُمِ",102,"م",1,0],["ورضوان وريحان مدام","وروح حول ربتهم حفوف",103,"ف",1,0],["ورضاهُ وسلوتي","عنهُ ما لا أنالهُ",104,"ل",2,0],["وَرَضيعٌ إشذا أَتَيتَ أَتانا","مِنهُ طَبّاخَنا بِرَطبٍ سَمينِ",105,"ن",1,0],["وَرَضَّعَتِ السُحبُ ما صيغَ مِن","لُجَينِ الأَقاحي بِدُرِّ المَطَر