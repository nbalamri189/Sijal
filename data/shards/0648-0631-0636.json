{"poems":[[63,"رنت إلي وظل النقع ممدود","https://www.aldiwan.net/poem46194.html","البسيط"],[55,"تعس الغراب لقد جرى بفراق","https://www.aldiwan.net/poem26210.html","الكامل"],[55,"ولقد دفنت هواكم","https://www.aldiwan.net/poem26485.html","مجزوء الكامل"],[77,"قسما بالليل وما وسقا","https://www.aldiwan.net/poem35922.html","المتدارك"],[77,"أشارت غداة البين من خلل السجف","https://www.aldiwan.net/poem35976.html","الطويل"],[77,"إن بان منزله وشطت داره","https://www.aldiwan.net/poem36406.html","الكامل"],[77,"يمينا بيانع ورد الخدود","https://www.aldiwan.net/poem36617.html","المتقارب"],[24,"من سره كرم الحياة فلا يزل","https://www.aldiwan.net/poem21866.html","الكامل"],[71,"عسى البارق الشامي يهمي سحابه","https://www.aldiwan.net/poem4026.html","الطويل"],[93,"في رضى المربوب والرب","https://www.aldiwan.net/poem9791.html","عموديه"],[93,"وارحمتاه لقوم فارقوا النعما","https://www.aldiwan.net/poem11304.html","البسيط"],[83,"يا بدر تم في سماء خلافة","https://www.aldiwan.net/poem54283.html","الكامل"],[83,"نفسي الفداء لشادن مهما خطر","https://www.aldiwan.net/poem54307.html","الكامل"],[88,"قل للحكومات في البلقان هل علقت","https://www.aldiwan.net/poem44467.html","البسيط"],[72,"بعثت طيفها إلينا رسولا","https://www.aldiwan.net/poem20542.html","الخفيف"],[51,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[51,"صد عن الأطلال لما استيأسا","https://www.aldiwan.net/poem64645.html","الرجز"],[85,"كان فيما مضى من الدهر بيت","https://www.aldiwan.net/poem8034.html","الخفيف"],[85,"مضناك جفاه مرقده","https://www.aldiwan.net/poem63667.html","المتدارك"],[62,"جامل عدوك ما استطعت فإنه","https://www.aldiwan.net/poem52450.html","الكامل"],[45,"أريحيات صبوة ومشيب","https://www.aldiwan.net/poem62638.html","الخفيف"],[45,"ناهيك من حرق أبيت أقاسي","https://www.aldiwan.net/poem64589.html","الطويل"],[61,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[49,"دار وعورة سهلها","https://www.aldiwan.net/poem63094.html","مجزوء الكامل"],[66,"لله أشكو صاحبا","https://www.aldiwan.net/poem38776.html","مجزوء الكامل"],[97,"هل أنت سامعة أنيني","https://www.aldiwan.net/poem24746.html","مجزوء الكامل"],[97,"هذه الكعبة كنا طائفيها","https://www.aldiwan.net/poem24799.html","الرمل"],[80,"صادتك مهاة لم تصد","https://www.aldiwan.net/poem31480.html","المتدارك"],[31,"هيج القلب مغان وصير","https://www.aldiwan.net/poem42520.html","الرمل"],[105,"بشراك أم حبيبة بمحمد","https://www.aldiwan.net/poem44057.html","الكامل"],[39,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[48,"أيها المنتاب عن عفره","https://www.aldiwan.net/poem63366.html","المديد"],[50,"بكرا صاحبي قبل الهجير","https://www.aldiwan.net/poem63820.html","الخفيف"],[50,"ومعذل هجر اللئام حديثه","https://www.aldiwan.net/poem63976.html","الكامل"],[50,"ورضيت من طول العناء بيأسه","https://www.aldiwan.net/poem64782.html","الكامل"],[50,"خفض على عقب الزمان العاقب","https://www.aldiwan.net/poem64865.html","الكامل"],[46,"تهاون بالظنون وما حدسنه","https://www.aldiwan.net/poem23486.html","الوافر"],[76,"ورضاب كأنه ما يمج الن","https://www.aldiwan.net/poem38849.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141986","الكامل"],[90,"يا فراتي","https://www.poetsgate.com/ViewPoem.aspx?id=178986",""],[45,"نَاهِيكَ مِنْ حُرَقٍ أبِيتُ أُقاسِي","https://www.poetsgate.com/ViewPoem.aspx?id=31155",""]],"verses":[["ورضْتَ أمراً أطافَ العاجِزونَ بهِ","وكادَ يَلوي بشَمْلِ المُلْكِ تَبديدُ",0,"د",1,0],["وَرَضيتُ بَعدَ تَنَكُّبي طُرُقَ الهَوى","أَن قيلَ صاحِبُ رايَةِ العُشّاقِ",1,"ق",1,0],["وَرَضيتُ مِنكِ بِدونِ ما","يَرضى المُحِبُّ مِنَ الحَبيبِ",2,"ب",1,0],["ورضَوْا بالصّبْرِ فما وهَنوا","جزَعاً في الدّينِ ولا قَلَقا",3,"ق",2,0],["ورُضْتَ صِعابَ الدّهْرِ وهْيَ شَوامِسٌ","فذلّلْتَها منْ غيرِ جُهْدٍ ولا عُنفِ",4,"ف",1,0],["ورضاكَ طاعَتُهُ وبرُّكَ دأبُهُ","ودُعاؤهُ لعُلاكَ واستِغْفارُهُ",5,"ر",2,0],["ورِضْوانُ أعْظَمُ شَيْءٍ يَدُلُّ","على أنّ دارَكَ دارُ الخُلودْ",6,"د",1,0],["وَرَضيتُ عَنها بِالرِضا لَمَّا أَتَت","مِن دون عُسرَةِ ضِغنِها بِيَسارِ",7,"ر",1,0],["وَرَضنا مُلوكَ الأَرضِ بِالبيضِ وَالقَنا","فَذَلَّ لَنا مِن كُلِّ قطرٍ صِعابُهُ",8,"ب",2,0],["ورِضَاهَا السِّلْمُ اَشْبَهُ مَا","كَانَ فِي عُقْبَاهُ بِالحَرْبِ",9,"ب",1,0],["وَرُضَّعٍ وَجَدُوا الأَثْدَاءَ لاذِعَةً","كَالجَمْرِ فَانْفَطَمُوا وَاسْتَنْكَرُوا الحَلَمَا",10,"م",2,0],["ورضاك عنه خيرُ ما ألبسته","فلقد أشاد بجاهه وببرْه",11,"ر",2,0],["ورضاك عنه غايةٌ ما بعدها","إلا رضى الله الذي ابتدع البشرْ",12,"ر",1,0],["ورُض بهم كل صعب إنهم فئةٌ","تبغى الصدور ولا ترضى بأعجاز",13,"ز",1,0],["ورضاب حماه رمح التثنِّي","فهوينا العسَّال والمعسولا",14,"ل",2,0],["ورضاهم هناك بالنِّصف والرُّب","ع وأَدْنى رضاكَ في الإِرباءِ",15,"ا",2,0],["وَرَضِيَتْهُ منظراً وَملْمَسا","رَدَّتْه في أرْحَامها مُكَوَّسا",16,"س",2,0],["وَرِضا اللَهِ نَرتَجيهِ وَلَكِن","لا يُؤَدّي إِلَيهِ إِلّا الكَمالُ",17,"ل",1,0],["وَرُضابٍ يوعَدُ كَوثَرُهُ","مَقتولُ العِشقِ وَمُشهَدُهُ",18,"د",2,0],["ورِضا الحسودِ زوالُ نعمتِكَ التي","أُوتِيتَها من طَارفٍ أو تالدِ",19,"د",1,0],["وَرَضينا بِحُكمِ غَيثِكَ فيها","أَنَّهُ صائِبٌ وَأَنتَ مُصيبُ",20,"ب",1,0],["وَرَضيتُ مِن عَودِ البَخيلِ وَبَدئِهِ","بِاليَأسِ لَو نَفَعَ الرِضا بِالياسِ",21,"س",1,0],["ورضىً عن الإنجيلِ يُظْهِرُ فيهما","غَضبَاً على الفُرقانِ والأحزابِ",22,"ب",1,0],["وَرَضيتَ مِنها في الَّذي","تَأتي بِأَقبَحِ فِعلِها",23,"ل",3,0],["وَرَضيتُ مِنهُ بِالسَلا","مِ فَصِرتُ أَرضى بِالسَلامَه",24,"م",2,0],["ورضاكِ أنتِ وقايتي","فإذا غضبتِ فمَنَ يقيني",25,"ي",1,0],["ورَضينا بسكونٍ وسلام","وانتهينا لفراغٍ كالعَدَم",26,"م",1,0],["ورضابُ الماءِ بفيكِ جَرَى","في جوهره عَرَضُ الصَّرَدِ",27,"د",1,0],["وَرُضابُ المِسكِ مِن أَثوابِهِ","مَرمَرَ الماءَ عَلَيهِ فَنَضَر",28,"ر",1,0],["وَرَضِيْتُ مِلَّتَهُ لنفسي إنَّه","لعلى طريقٍ للسدادِ مُعَبَّدِ",29,"د",1,0],["وَرَضو الَّذي كَرِهوا لِأَوَّلِ مَرَّةٍ","وَرَأى سَبيلَ طَريقِهِ المُتَهَدِّدُ",30,"د",1,0],["ورَضُوا لهُ غَضَبَ الإِلهِ فلا عَدا","غَضَبُ الإلهِ عَدُوَّهُ الضِّلِّيلا",31,"ل",2,0],["ورَضُوا لِمُوسى أنْ يقولَ فواحِشاً","خَتَمَتْ وَصِيَّتُهُ لهنَّ فصُولا",31,"ل",2,0],["وَرُضابٍ بِتُّ أَرشُفُهُ","يَنقَعُ الظَمآنَ مِن خَصَرِه",32,"ر",2,0],["وَرَضيتُ القَليلَ مِنهُنَّ إِنّي","مِن قَليلٍ لَواثِقٌ بِكَثيرِ",33,"ر",1,0],["وَرُضابِ ذي أَشَرٍ أَغَرَّ كَأَنَّما","غُبِقَت مَشارِبُهُ مِنَ التُفّاحِ",34,"ح",1,0],["وَرَضيتُ مِن طولِ العَناءِ بِيَأسِهِ","وَاليَأسُ أَيسَرُ مِن عِداتِ الكاذِبِ",35,"ب",1,1],["وَرَضيتَ مِن طولِ الرَجاءِ بِيَأسِهِ","وَاليَأسُ أَمثَلُ مِن عِداتِ الكاذِبِ",36,"ب",1,0],["وَرُضتُ صِعابَ آمالي فَكانَت","خُيولاً في مَراتِعِها شَمَسنَه",37,"ن",2,0],["ورُضَابٍ كأنَّه ما يَمُجُّ النْ","نَحلُ طِيباً وما يَسُحُّ الحَبِيُّ",38,"ي",1,1],["ورضيع آداب أقلتَ عثارهُ","فإذا رمى الأعداء كان البادي",39,"د",2,0],["ورضِينا حُكْمَ الزَّمانِ وما كانَ","احتكامُ الزمانِ بالمَرْضي",40,"ي",1,0],["وَرَضِيتُ، مِنْ عَوْدِ البَخِيلِ وَبَدْئِهِ،","باليَأسِ، لَوْ نَفَعَ الرّضَى باليَاسِ",41,"س",1,0]]}