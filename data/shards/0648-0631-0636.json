هُ (جيش العراق)","https://www.poetsgate.com/ViewPoem.aspx?id=198923",""],[5440,"سيدي ما عنك لي عوض","https://www.poetsgate.com/ViewPoem.aspx?id=106649",""],[5616,"سيف على لغتي","https://www.poetsgate.com/ViewPoem.aspx?id=205036",""],[5635,"تقول بنيتي أبتي تقنع","https://www.poetsgate.com/ViewPoem.aspx?id=181571",""],[5691,"الحليب الأسود","https://www.poetsgate.com/ViewPoem.aspx?id=205883",""],[5704,"رئم الفلا ...","https://www.poetsgate.com/ViewPoem.aspx?id=195153",""],[5725,"خنساء القدس","https://www.poetsgate.com/ViewPoem.aspx?id=178192",""],[5829,"ان يرحمك","https://www.poetsgate.com/ViewPoem.aspx?id=215070",""],[5830,"يا ظبية تختال ما بين الربى","https://www.poetsgate.com/ViewPoem.aspx?id=200690",""],[5943,"آه وآه ثم آه ثالثة","https://www.poetsgate.com/ViewPoem.aspx?id=34593",""],[5974,"خمرُ شفاهها","https://www.poetsgate.com/ViewPoem.aspx?id=200326",""],[6102,"موعد","https://www.poetsgate.com/ViewPoem.aspx?id=185070",""],[6102,"ميرا","https://www.poetsgate.com/ViewPoem.aspx?id=185071",""],[6106,"تحية للمستشارة : د . نهى الصادق الزيني","https://www.poetsgate.com/ViewPoem.aspx?id=6309",""],[6124,"طيب العناق","https://www.poetsgate.com/ViewPoem.aspx?id=194528",""],[4432,"ادكارا بعد ما ولى الشباب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=564221",""],[6206,".....ولقدْ تلقَّيتُ الصَّباح بمثلِه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27270&r=&rc=11",""],[6209,"فطوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82548&r=&rc=17",""],[6225,"محاسبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80910&r=&rc=179",""],[523,"طبق الأصل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1723&r=&rc=86",""],[6322,"احتِرَاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82626&r=&rc=7",""]],"verses":[["ورضْتَ أمراً أطافَ العاجِزونَ بهِ","وكادَ يَلوي بشَمْلِ المُلْكِ تَبديدُ",0,"د",1,0],["وَرَضيتُ بَعدَ تَنَكُّبي طُرُقَ الهَوى","أَن قيلَ صاحِبُ رايَةِ العُشّاقِ",1,"ق",1,0],["وَرَضيتُ مِنكِ بِدونِ ما","يَرضى المُحِبُّ مِنَ الحَبيبِ",2,"ب",1,0],["ورضَوْا بالصّبْرِ فما وهَنوا","جزَعاً في الدّينِ ولا قَلَقا",3,"ق",2,0],["ورُضْتَ صِعابَ الدّهْرِ وهْيَ شَوامِسٌ","فذلّلْتَها منْ غيرِ جُهْدٍ ولا عُنفِ",4,"ف",1,0],["ورضاكَ طاعَتُهُ وبرُّكَ دأبُهُ","ودُعاؤهُ لعُلاكَ واستِغْفارُهُ",5,"ر",2,0],["ورِضْوانُ أعْظَمُ شَيْءٍ يَدُلُّ","على أنّ دارَكَ دارُ الخُلودْ",6,"د",1,0],["وَرَضيتُ عَنها بِالرِضا لَمَّا أَتَت","مِن دون عُسرَةِ ضِغنِها بِيَسارِ",7,"ر",1,0],["وَرَضنا مُلوكَ الأَرضِ بِالبيضِ وَالقَنا","فَذَلَّ لَنا مِن كُلِّ قطرٍ صِعابُهُ",8,"ب",2,0],["ورِضَاهَا السِّلْمُ اَشْبَهُ مَا","كَانَ فِي عُقْبَاهُ بِالحَرْبِ",9,"ب",1,0],["وَرُضَّعٍ وَجَدُوا الأَثْدَاءَ لاذِعَةً","كَالجَمْرِ فَانْفَطَمُوا وَاسْتَنْكَرُوا الحَلَمَا",10,"م",2,0],["ورضاك عنه خيرُ ما ألبسته","فلقد أشاد بجاهه وببرْه",11,"ر",2,0],["ورضاك عنه غايةٌ ما بعدها","إلا رضى الله الذي ابتدع البشرْ",12,"ر",1,0],["ورُض بهم كل صعب إنهم فئةٌ","تبغى الصدور ولا ترضى بأعجاز",13,"ز",1,0],["ورضاب حماه رمح التثنِّي","فهوينا العسَّال والمعسولا",14,"ل",2,0],["ورضاهم هناك بالنِّصف والرُّب","ع وأَدْنى رضاكَ في الإِرباءِ",15,"ا",2,0],["وَرَضِيَتْهُ منظراً وَملْمَسا","رَدَّتْه في أرْحَامها مُكَوَّسا",16,"س",2,0],["وَرِضا اللَهِ نَرتَجيهِ وَلَكِن","لا يُؤَدّي إِلَيهِ إِلّا الكَمالُ",17,"ل",1,0],["وَرُضابٍ يوعَدُ كَوثَرُهُ","مَقتولُ العِشقِ وَمُشهَدُهُ",18,"د",2,0],["ورِضا الحسودِ زوالُ نعمتِكَ التي","أُوتِيتَها من طَارفٍ أو تالدِ",19,"د",1,0],["وَرَضينا بِحُكمِ غَيثِكَ فيها","أَنَّهُ صائِبٌ وَأَنتَ مُصيبُ",20,"ب",1,0],["وَرَضيتُ مِن عَودِ البَخيلِ وَبَدئِهِ","بِاليَأسِ لَو نَفَعَ الرِضا بِالياسِ",21,"س",1,0],["ورضىً عن الإنجيلِ يُظْهِرُ فيهما","غَضبَاً على الفُرقانِ والأحزابِ",22,"ب",1,0],["وَرَضيتَ مِنها في الَّذي","تَأتي بِأَقبَحِ فِعلِها",23,"ل",3,0],["وَرَضيتُ مِنهُ بِالسَلا","مِ فَصِرتُ أَرضى بِالسَلامَه",24,"م",2,0],["ورضاكِ أنتِ وقايتي","فإذا غضبتِ فمَنَ يقيني",25,"ن",2,0],["ورَضينا بسكونٍ وسلام","وانتهينا لفراغٍ كالعَدَم",26,"م",1,0],["ورضابُ الماءِ بفيكِ جَرَى","في جوهره عَرَضُ الصَّرَدِ",27,"د",1,0],["وَرُضابُ المِسكِ مِن أَثوابِهِ","مَرمَرَ الماءَ عَلَيهِ فَنَضَر",28,"ر",1,0],["وَرَضِيْتُ مِلَّتَهُ لنفسي إنَّه","لعلى طريقٍ للسدادِ مُعَبَّدِ",29,"د",1,0],["وَرَضو الَّذي كَرِهوا لِأَوَّلِ مَرَّةٍ","وَرَأى سَبيلَ طَريقِهِ المُتَهَدِّدُ",30,"د",1,0],["ورَضُوا لهُ غَضَبَ الإِلهِ فلا عَدا","غَضَبُ الإلهِ عَدُوَّهُ الضِّلِّيلا",31,"ل",2,0],["ورَضُوا لِمُوسى أنْ يقولَ فواحِشاً","خَتَمَتْ وَصِيَّتُهُ لهنَّ فصُولا",31,"ل",2,0],["وَرُضابٍ بِتُّ أَرشُفُهُ","يَنقَعُ الظَمآنَ مِن خَصَرِه",32,"ر",2,0],["وَرَضيتُ القَليلَ مِنهُنَّ إِنّي","مِن قَليلٍ لَواثِقٌ بِكَثيرِ",33,"ر",1,0],["وَرُضابِ ذي أَشَرٍ أَغَرَّ كَأَنَّما","غُبِقَت مَشارِبُهُ مِنَ التُفّاحِ",34,"ح",1,0],["وَرَضيتُ مِن طولِ العَناءِ بِيَأسِهِ","وَاليَأسُ أَيسَرُ مِن عِداتِ الكاذِبِ",35,"ب",1,1],["وَرَضيتَ مِن طولِ الرَجاءِ بِيَأسِهِ","وَاليَأسُ أَمثَلُ مِن عِداتِ الكاذِبِ",36,"ب",1,0],["وَرُضتُ صِعابَ آمالي فَكانَت","خُيولاً في مَراتِعِها شَمَسنَه",37,"ن",2,0],["ورُضَابٍ كأنَّه ما يَمُجُّ النْ","نَحلُ طِيباً وما يَسُحُّ الحَبِيُّ",38,"ي",1,1],["ورضيع آداب أقلتَ عثارهُ","فإذا رمى الأعداء كان البادي",39,"د",2,0],["ورضائي عنهم بغير حدود","ولقد ينفع البنينَ الرضاءُ",40,"ا",2,0],["ورضوا لأعباء الخلافة كفأها","سبط النجاد موفق الأنظار",41,"ر",1,0],["ورضِينا حُكْمَ الزَّمانِ وما كانَ","احتكامُ الزمانِ بالمَرْضي",42,"ي",1,0],["وَرَضِيتُ، مِنْ عَوْدِ البَخِيلِ وَبَدْئِهِ،","باليَأسِ، لَوْ نَفَعَ الرّضَى باليَاسِ",43,"س",1,0],["وَرضة أُنس باتَ فيها اِبن أَيكة","يُغرد وَالناي الرَخيم يَشنف",44,"ف",1,1],["ورضيت الطعن فيه","إن بعض الظن إثم",45,"م",1,0],["ورضىٌّ رضا الإله رضاه","وتقيٌّ أَعمالُه مرضاتُه",46,"ت",2,0],["وَرُضنَا بِهَا صَعبَ القَوَافي فأَصبَحَت","لَنَا ذُلَلاً فِيهَا ضَوىً ولَهَا قُوَى",47,"و",2,0],["ورُضُّتِ عُودَكِ حَتَّى إِن حَكاكِ غِناً","يَخشَاكِ إِن مَالَ عَمَّا قُلتِ مَائِلُهُ",48,"ل",2,0],["ورُض بها النفسَ إذا","أجلت طرِف الطرفِ",49,"ف",1,0],["ورضيتُ بالمُهدِى إلىّ نسيمَهم","إن المحب بما تيسَّر يَقنَعُ",50,"ع",1,0],["ورضعتُ ثدىَ نداك من دون الهوى","ثقةً بأنّ رصيعَه لا يُفطَمُ",51,"م",1,0],["ورضا الإله هو المنى ويكون من","بعدي انتفاع الخلق ثمّ طويلا",52,"ل",2,0],["وَرَضَّت فُؤادَ الشِرك أَسحَقَ رَضَّةٍ","كَواكِبُ أَفلاكٍ سَبائِكُ فِضَّةٍ",53,"ه",1,0],["ورضى وفقد رضاك ليس بهينٍ","عندي فيحسنُ منيَّ التفويضُ",54,"ض",1,0],["ورضيت أن يحبى عليّ","لوقت منصرفي لفافي",55,"ف",2,0],["ورضاب الشيوخ في نكهات ال","عجز طعم الصحناة في مآبير",56,"ر",1,0],["وَرضيعٍ وسادَ وهو فطيمُ","فَعليه الصلاة والتسليمُ",57,"م",1,0],["وَرضيا دُنيا بهِ وَدينا","وَأَحرَزا كلَّ صنوف السعدِ",58,"د",1,0],["ورُضْتَ بحزمٍ كلَّ شيء فلم تَدَع","من الناس مخلوقاً يُرَى وَهْو حازم",59,"م",1,0],["وَرِضابُهُ الخَمرُ العَذيبُ وَخَدُّهُ الن","نَضر الحِمى وَعِذارِهِ العَلمانِ",60,"ن",1,0],["وَرَضيتُ حَرّاناً لَها داراً وَكَم","حامَت فَما وَصَلَت إِلَيها المَوصِلُ",61,"ل",1,0],["وَرَضْوْى وَسَلْمَى فِي الْوَقَارِ وَشُمَّخٌ","بِنَجْدٍ وَأَطْوَادُ السَّرَاةِ وَثَهْلاَنُ",62,"ن",1,0],["وَرُضْتُ أَفْرَاسَ تَحْسِينِي وَإِبْدَاعِي","بَيْنَ حَدَائِقِ أَشْعَارِي وَأَسْجَاعِي",63,"ع",2,0],["وَرُضْتُ فِيهَا غَرَامِي","يَقُودُهُ طِرْفُ طَرْفِي",64,"ف",2,0],["وَرَضِّ رَسُولَ اللهِ عَنَّا فَإِنَّهُ","عَلَيْهِ صَلاَةُ اللهِ أَرْأَفُ مِنْ يُبْقِي",65,"ق",2,0],["ورُضَابه خمرٌ حَوتهُ جفُونُه","فلأجل ذا يُحمى بها ويُصانُ",66,"ن",1,0],["ورضوا بأدنى مطلب فأجلهم","يرجو الغنى من راحة النباش",67,"ش",1,0],["ورضاء الشيخ في الوا","قع أولى بالصواب",68,"ب",1,0],["وَرضيعُ الكأْسِ يستعب","رُ من خوفِ الفطام",69,"م",1,0],["ورضاب فيك فإنما هو قهوة","تحلو لقلبي ساعة التمزيز",70,"ز",1,0],["ورضاك رحمتي التي أعتدها","تحيي منى نفسي وتذهب بوسي",71,"س",2,0],["ورضيت بالأمل القصي","وعشت بالأوهام وحدي",72,"د",2,0],["ورضيع الكرى يفيق من النشوة","والطير ساكر بالنشيد",73,"د",1,0],["ورضيتني عبدا لحس","نك واحتقنت دمائيه",74,"ي",2,0],["ورضينا وسخطنا","وأمرنا ونهينا",75,"ن",2,0],["وَرُضابُ الثَّغْرِ لَمْ أَظفَرْ بهِ","هَنّأَ اللَّهُ أَراكاً وَبَشامَا",76,"م",2,0],["ورَضِينا بقسْمَةِ اللهِ إذ كا","نَ مُحالاً أَن يُجْمَعَ الفَضْلان",77,"ن",1,0],["ورَضِيتُ عن بَحْرٍ أُجاوِرُه","إن كانَ لا رِيٌّ ولا شَرَق",78,"ق",1,0],["ورَضِيتُ إذ سَلِمتْ عليك مَحاسنٌ","مَفدِيّةٌ بمدامعي وأضالعي",79,"ع",2,0],["ورَضيتَ بالنَّفس النَّفي","سَةِ شُكرَها مُتَعرِّضا",80,"ض",2,0],["وَرَضِيَ عَن الأَصحاب قاطِبَة","إِذ كُلَهُم بِالفَضل مَشهورُ",81,"ر",1,0],["وَرَضيتِ مِن أَحراز كُل فَضيلة","وَحَقيقة بِمحصل مَوهوم",82,"م",1,0],["وَرضاب مَعسول عَطرٌ","مِن شَم سلافتهُ سُكرا",83,"ر",2,0],["وَرضت بِها أَخلاقُهُ وَهِيَ صَعبَةٌ","فَلانَت وَأَهوى مِن قُطوب إِلى بَشَر",84,"ر",1,0],["ورضا النفوس بما يقدر ربُّه","شرفٌ تنالُ بنيلِهِ الإحسانا",85,"ن",2,0],["ورضِّ على أصحاب أحمد متبعاً","لتابعه أهل الحديث وراويه",86,"ي",2,0],["ورضِّ على الأصحاب أصحاب أحمد","وكن لهم في كل حين معظما",87,"م",2,0],["ورضِّ عن من بذلوا","نفوسهم للأنفس",88,"س",1,0],["ورَضِّ على الأصحاب أصحاب أحمد","أولي الجد في نصر الشريعة والحد",89,"د",1,0],["وَرُضتَ الحَوادِثَ ذا حِنكَةٍ","فَصَيَّرَت ما اِعوَجَّ مِنها سَوي",90,"ي",1,0],["ورضعنا من أفاويق الطلا","وكرهنا بعد عامين الفطاما",91,"م",2,0],["ورضوانها اليوم النجيب مشيرها","يحافظها مولىً عليها هو الخالُ",92,"ل",1,0],["ورضيع هواك في وله","وبعادك أورثه سقما",93,"م",2,0],["ورضيت عن زمني بحسن صنيعه","وغفرت عظم إساءة الأيّام",94,"م",1,0],["ورِضَاكَ رَدَّ لِيَ الرِّضا فِي أَوْجُهٍ","من خُزْرِ أَيَّامٍ عَلَيَّ غِضابِ",95,"ب",1,0],["ورَضُوا لباسَ الجُودِ يَنْهَكُ مِنهُمُ","بِالبُؤْسِ أَبشارَ النَّعِيمِ الأَرْغَدِ",96,"د",1,0],["ورضعتُ من أزهاره وسكرتُ من","أسماره وشربتُ من أضوائه",97,"ا",3,0],["ورضتُ صِعابَها لجما وخزما","مطيعَ الرأس فيها والعَصِيَّا",98,"ي",2,0],["ورُضتُ الآبيات العوصَ حتى","سهُلن لكلّ جعدِ السمع حزنِ",99,"ن",1,0],["ورُضْتُ لجاجَه فإذا حَرونٌ","متى أمنعْه طوعا يقتسرْني",99,"ن",2,0],["ورضتُ نفسي للنوى فأسمحتْ","أن تهجرَ الأهلَ لكم والوطنا",100,"ن",2,0],["ورضتُ صَرفَ الدهر أولان لي","فلم أُبَلْ يجمحُ بي أو يقومْ",101,"م",1,0],["ورضتُمُ أظهُرَ الليالي المقا","ديمِ وطُلتُم سوالفَ الأُمَمِ",102,"م",1,0],["ورضْتُ بأَخلاقِ المشيب شبيبةً","مُعاصيةً لا تسكتينُ لجاذبِ",103,"ب",1,0],["ورُضْت والكزَّة العوجاء عاطفةٌ","على مُثَقِّفِها حدْباءَ لم تَقُمِ",104,"م",1,0],["ورضوان وريحان مدام","وروح حول ربتهم حفوف",105,"ف",1,0],["ورضاهُ وسلوتي","عنهُ ما لا أنالهُ",106,"ل",2,0],["وَرَضيعٌ إشذا أَتَيتَ أَتانا","مِنهُ طَ