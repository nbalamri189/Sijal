{"poems":[[55,"وسمتك حالية الربيع المرهم","https://www.aldiwan.net/poem29817.html","الكامل"],[3,"ألا من مبلغ أهل الجحود","https://www.aldiwan.net/poem142.html",""],[73,"حبيب نأى وهو القريب المصاقب","https://www.aldiwan.net/poem4021.html","الطويل"],[42,"خليلي عوجا نحي نباعا","https://www.aldiwan.net/poem42311.html","المتقارب"],[92,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[466,"سعد الزمان وكل موسم غبطة","https://www.aldiwan.net/poem15367.html","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59819","الوافر"],[997,"","https://poetry.dctabudhabi.ae/diwan/poem/132406","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16819","الطويل"],[5431,"وعاد معي إلى خلق جديد....","https://www.poetsgate.com/ViewPoem.aspx?id=190829",""]],"verses":[["بِمُمَهَّلٍ في الغابِرينَ مُؤَخَّرٍ","وَمُحَفَّزٍ في السابِقينَ مُقَدَّمِ",0,"م",1,0],["بِمَملَكَةٍ عَلَيها تاجُ عِزٍّ","وَقَومٍ مِن بَني عَبسٍ شُهودِ",1,"د",1,0],["بِمَمغوطَةِ الأَنساعِ قَودٍ كَأَنَّها","عَلى الرَملِ مِن إِثرِ الأَفاعي مَساحِبُ",2,"ب",1,0],["بِمَمشايَ أَن كاشِحٌ رانئٌ","فَلَمّا بَلَغتُ كَشَفتُ القِناعا",3,"ع",2,0],["بمُمَلِّكينَ الأجنبيَّ نفوسَهُمْ","ومُصَعِّدينَ على الجُموعِ مَناكبا",4,"ب",2,0],["بممدَّحٍ لا يُستزادُ بمدحهِ","صَفْوِ الخلائقِ سالمٍ من عائِبِ",5,"ب",1,0],["بممشوق القوام إذا تثنى","أراك الغصن في حسن انعطاف",6,"ف",1,0],["بمملكةِ الإسلامِ لَم أَرَ مِثلَهَا","ولا النَّاسُ طُرَّاً من جميعِ المَمَالِكِ",7,"ك",1,0],["بِمَمتَثِلٍ فِعلَ السَحابِ إِذا غَدا","يُصَفِّقُ فيها رَعدُها وَيُغَرِّدُ",8,"د",1,0],["بممحاة طوى سفْرا كئيبا","من الأخطاء تمشي في خطاه",9,"ا",2,0]]}