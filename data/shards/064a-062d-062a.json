//www.poetsgate.com/ViewPoem.aspx?id=202103",""],[5401,"دايم السيف","https://www.poetsgate.com/ViewPoem.aspx?id=179866",""],[5431,"ليتني دوما معه!","https://www.poetsgate.com/ViewPoem.aspx?id=195413",""],[5431,"الحدْس.....","https://www.poetsgate.com/ViewPoem.aspx?id=198676",""],[5431,"الكون أنت وبانعكاسك أشرقا","https://www.poetsgate.com/ViewPoem.aspx?id=200562",""],[5431,"الحمد لله من قلبِ به سكنا","https://www.poetsgate.com/ViewPoem.aspx?id=201907",""],[5434,"الشاور غشاني","https://www.poetsgate.com/ViewPoem.aspx?id=37612",""],[5691,"حمار الحطاب","https://www.poetsgate.com/ViewPoem.aspx?id=205825",""],[5691,"سفارة فوق الدماء","https://www.poetsgate.com/ViewPoem.aspx?id=206030",""],[5722,"الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=12682",""],[5776,"وجوه الأقفية المعطوبة","https://www.poetsgate.com/ViewPoem.aspx?id=199326",""],[5853,"سطو الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=178346",""],[5897,"رفقاً بالشاعر العربي","https://www.poetsgate.com/ViewPoem.aspx?id=156129",""],[5943,"أماهُ فارثيه( اليتيم)","https://www.poetsgate.com/ViewPoem.aspx?id=50979",""],[5956,"هل مستطيعْ","https://www.poetsgate.com/ViewPoem.aspx?id=182097",""],[5956,"يحترق العاشق من أجلي","https://www.poetsgate.com/ViewPoem.aspx?id=182588",""],[5956,"الكون حاجاتٌ لبعضٍ","https://www.poetsgate.com/ViewPoem.aspx?id=184183",""],[5956,"هل يعرف التاريخ مثل فتايا؟","https://www.poetsgate.com/ViewPoem.aspx?id=193202",""],[5956,"ألمٌ ألمَّ به","https://www.poetsgate.com/ViewPoem.aspx?id=194579",""],[5956,"صاحبة التَّرحابِ المُرَكَّز","https://www.poetsgate.com/ViewPoem.aspx?id=205344",""],[6078,"سلافة عشق","https://www.poetsgate.com/ViewPoem.aspx?id=202777",""],[6093,"أحراش","https://www.poetsgate.com/ViewPoem.aspx?id=197693",""],[6093,"يسْتَسْهِلُ الشِّعرَ","https://www.poetsgate.com/ViewPoem.aspx?id=197939",""],[5309,"هذا هواك فودعي عهد الهوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573549",""],[5355,"مشيا على الجراح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87210&r=&rc=35",""],[5080,"من يصطفي جسد الرّحيل مواظبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88142&r=&rc=12",""],[6268,"إضاءة في خيمة الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82915&r=&rc=1",""],[4890,"الغزو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74048&r=&rc=254",""],[5064,"لَمْ يبقَ للحُبِّ العظِيمِ مكَانُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87536&r=&rc=31",""]],"verses":[["يَحتملْ أوْقَهُ وينهضْ بِرضْوى","وشَرَوْرَى ويَذْبُلٍ ونَضادِهْ",0,"د",2,0],["يحتاطُ للخلفاءِ في سُلطانهم","من كان في أمر استِه مُحتاطا",1,"ط",2,0],["يحتالُ قومٌ لرفدِ الرافدين لهم","لكنّ رَفدَكَ مُحتالٌ ليَ الحيلا",2,"ل",2,0],["يَحتَضِرونَ سِجالاً مِن فَواضِلِهِ","وَالخَيرُ مُحتَضَرُ الأَبوابِ مُنتَهَبُ",3,"ب",1,0],["يُحَتُّ يَبيسُ الماءِ عَن حَجَباتِها","وَيَشكونَ آثارَ السِياطِ خَوابِطا",4,"ط",2,0],["يَحتَقِرُ البيضَ وَاللِدانَ إِذا","سَنَّ عَلَيهِ الدِلاصَ أَو نَثَلَه",5,"ل",2,0],["يَحتَوي نَشرَهُم وَقَد مَلَأوا الأَر","ضَ نُجودُ العاقولِ أَو أَغوارُه",6,"ر",2,0],["يَحتَمي وَردُهُ بِنَبلِ لِحاظٍ","قَوسُها خَطُّ حاجِبٍ مَحنِيِّ",7,"ي",1,0],["يحتبي في الدستِ منه أَسدٌ","وهلالٌ وسحابٌ وَعَلَم",8,"م",1,0],["يَحتَلُّ في سَعدِ بنِ ضَبَّةَ في ذُرا","عادِيَّةٍ قَد كَلَّلَتها الأَنجُمُ",9,"م",1,0],["يَحتَلِبُ الدَهرَ أَفاويقَهُ","وَيَخلِطُ الحُلوَ مَعَ الحازِرِ",10,"ر",1,0],["يحتاجُ مَنْ يطلبُ طولَ البقا","بأن يرى هذا وأشباهَهْ",11,"ه",1,1],["يَحْتَثُّهُ راكبٌ ضاقَتْ مذاهبُهُ","بادي التشحُّبِ في عُثْنُونِه شَمَط",12,"ط",1,0],["يَحتَوي وَصلَكِ قَلبي غادِياً","وَتَراكِ العَينُ فيها رَمَدا",13,"د",2,0],["يحتقر البيض واللدان إذا","شن عليه الدلاص أو نثله",14,"ل",2,0],["يحتمل منكم بهم محتملي","قوتلوا من بشر أفضلهم",15,"م",1,0],["يحتسي من رماد عينيه لمحي","يرتدي ظلّ ركبتيه التفاتي",16,"ت",2,0],["يحتوي كلّ معبر ، يتلوى","في عيون الكوى ، رؤى جدّ خرسا",17,"س",2,0],["يحتلها السمار والغا","زي ونصف الرأسمالي",18,"ل",2,0],["يحتازُها والجوعُ ينهَشُ لحمَها !","باسم \" الرغيف \" معرَّةٌ وصِدام",19,"م",1,0],["يحتلّها السمسار ، والغازي ، ونصف الرأسمالي","والسّائح المشبوه ، والدّاعي ، وأصناف الجوالي",20,"ل",2,0],["يَحْتَجُّ لِي كُلَّ يَوْمٍ","عَلَى العَواذِلِ فِيهِ",21,"ي",2,0],["يحتاجنا قالوا كما نحتاجه","ويرى لنا فضلا عليه كما نرى",22,"ر",2,0],["يَحْتَظِي مِنْهُ الْعَدِيمُ بِعُدْمٍ","حِينَ يَبْدُو بِوُجُودٍ بِجُودِ",23,"د",1,0],["يحتثَّها الفكر طوراً والسَّماح فلا","يزال مؤتلق منها ومندفق",24,"ق",1,0],["يَحتارُ فيهِ فكرُ مختارهِ","إِذ لا يَرى منهُ سوى الفاخرِ",25,"ر",1,0],["يَحتاج عتقاً ذاك من آثامه","حقّاً وهذا يعتق المستأسرا",26,"ر",2,0],["يحتال في فرصٍ مني ليهلكني","وإن رآني حذوراً قال أنت أبي",27,"ب",2,0],["يحتربانِ أبدا على مدىً","ثمّ يكونُ الأخبثُ المنهزِما",28,"م",2,0],["يحتشم البحرُ من يديه","والبدرُ من وجهه الجميلِ",29,"ل",1,0],["يحتثُّها شوقاً لك النيروزُ أو","يأتي فيُطلِعَها عليك العيدُ",30,"د",1,0],["يَحتشِمُ النّيروزُ من إطلاله","والمهرجانُ يقتضيكَ بعدُ",31,"د",1,0],["يحتلُّ منه دستهُ وطرفهُ","طودٌ وبحرٌ زاجرٌ وضيغم",32,"م",1,0],["يَحتَشِمُ القَطرُ مِن مُقَبَّلِها","وَيَخجَلُ الرَوضُ مِن ثَناياها",33,"ا",3,0],["يحتاطُ منكَ الرَّأيُ فيكَ ولم تكنْ","تفقَهْ فكيف تصَرَّفُ الآراءُ",34,"ا",2,0],["يحتالُ في عُذرِ الصديقِ صديقُهُ","أَيَعافُ مِنهُ قَبُولَ عُذرٍ وارِدِ",35,"د",1,0],["يحتالُ في التَّرْكِ لذَنبٍ فإنْ","كانَ ففي معذِرَةِ المُذنِبِ",36,"ب",1,0],["يَحتاجُ لَيثٌ لَإِخراجِ مَخالِبِهِ","في ذا السُؤالِ إِلى الجَوابِ مُفتَقِرا",37,"ر",2,0],["يَحتسيها في مَدح أَسنى وَزير","فازَ في عَصرِهِ بِشُكر وَحمد",38,"د",1,0],["يَحتَضِرُ البَأسَ وَما يَبتَغي","سِوى إِسارِ البَطَلِ الماجِدِ",39,"د",1,0],["يحتاج أن يُشَدَّ بالرباطِ","وإن يذاق الضَرْبَ بالسِيَّاطِ",40,"ط",1,0],["يحتوى المجد والسماحة والأَخ","لاقَ والأَفضَلَين دُنيا وديناَ",41,"ن",2,0],["يَحتَقِرُ النائِلَ الجَسيمَ وَيَس","تَصغِرُ قَدرَ العَظيمِ مِن عِظَمِه",42,"م",2,0],["يَحتَقِرُ المَوتَ وَيَغشى الوَغى","بِجُؤجُؤٍ ثَبتٍ وَوَجهٍ وَقاح",43,"ح",1,0],["يحتسيها عند ريعان الصبا","ويخليها اذا ما اضطربا",44,"ب",2,0],["يحتاج من لبس المشهر معلناً","وعلا جواداً واستسل مهندا",45,"د",2,0],["يَحتَجُّ بِاللَّفظِ المرَكَّبِ عَارِفٌ","مَضمُونَهُ بِسِيَاقِهِ لِبَيَانِ