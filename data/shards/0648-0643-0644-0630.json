oem/85204","البسيط"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85244","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59440","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135602","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135839","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135940","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135256","السريع"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95355","الرجز"],[4239,"","https://poetry.dctabudhabi.ae/diwan/poem/102201","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83645","البسيط"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/178104","البسيط"],[4722,"وأن نفخة اسرافيل ثانية","https://www.poetsgate.com/ViewPoem.aspx?id=26474",""],[585,"هو الصوت دوّى من فلسطين عالياً","https://www.poetsgate.com/ViewPoem.aspx?id=161906",""],[585,"صوتٌ تجاوب بين الهمس والعلن","https://www.poetsgate.com/ViewPoem.aspx?id=161884",""],[5096,"مرَّتْ على قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=207870",""],[3591,"عارٌ على الغيد أن تزهو وتفتخرا","https://www.poetsgate.com/ViewPoem.aspx?id=149462",""],[5156,"ذو العقل يسخو بعيش ساعته","https://www.poetsgate.com/ViewPoem.aspx?id=99133",""],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""],[5543,"يا صاحبي كسدت أسواق أشواقي","https://www.poetsgate.com/ViewPoem.aspx?id=181706",""],[5790,"ما معدن الدر والياقوت غير فمك","https://www.poetsgate.com/ViewPoem.aspx?id=111899",""],[4442,"الدر في التاج غير الدر السدف","https://www.poetsgate.com/ViewPoem.aspx?id=171197",""],[186,"تنبهوا واستفيقوا أيها العرب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55739&r=&rc=2",""],[6317,"لبنان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86082&r=&rc=2",""]],"verses":[["وكُلُّ ذي جِدّةٍ يَبْلى إذا لعِبَتْ","بهِ اللّيالى وسارَتْ دونَه الحُجَجُ",0,"ج",1,0],["وَكُلَّ ذَمولٍ كَالفَنيقِ وَقَينَةٍ","تَجُرُّ إِلى الحانوتِ بُرداً مُسَهَّما",1,"م",2,0],["وكلُّ ذلك لم يَشفعَ لدى عُمَرٍ","في هفوةٍ لأبي سُفيانَ يأْتيها",2,"ي",3,0],["وَكُلُّ ذَخيرَةٍ لا بُدَّ يَومًا","وَلَو بَقيت تَصيرُ إِلى النَفادِ",3,"د",1,0],["وَكُلُّ ذَمولٍ كَالفَنيقِ شِمِلَّةٍ","وَكُلُّ سَريعٍ آخِرِ اللَيلِ آزِحِ",4,"ح",1,0],["وكل ذي منصبٍ تعتز أمته","بسيفه العضب أو بالرأي واللسن",5,"ن",1,0],["وَكُلُّ ذِي مِرَّةٍ يَمْضِي بِرَايَتِهِ","إِلَى الْجِهَادِ كَمَا اعْتَادَتْ وَيَغْتَنِمُ",6,"م",1,0],["وكلّ ذاك خفيفٌ إن نشطتَ له","يا منْ يخفُّ عليه كل ذي ثقلِ",7,"ل",1,0],["وَكُلُّ ذي سَكرَةٍ فَأَعمى","حَتّى إِذا ما أَفاقَ أَبصَر",8,"ر",1,0],["وَكُلُّ ذي أَجَلٍ يَوماً سَيَبلُغُهُ","وَكُلُّ ذي عَمَلٍ يَوماً سَيَلقاهُ",9,"ا",2,0],["وَكُلُّ ذي صَمَمٍ في كَفِّ ذي هِمَمٍ","وَكُلُّ ذي مَيَسٍ في كَفِّ ذي مَيَزِ",10,"ز",1,0],["وكلُّ ذلكَ يا مالكي","بطعنِهِ في الشافعي",11,"ي",1,0],["وَكلُّ ذِي تِرَةٍ تَغْلِي مَراجلُهُ","غَدَا يُقادُ ذَليلاً وهْوَ مَغْلُولُ",12,"ل",1,0],["وَكُلُّ ذلِكَ مَصْرُوفٌ وَمَصرِفُهُمْ","لِلشِّيخِ يُوسُفَ أبي هَبْصِ بنِ لَطْمِينِ",13,"ن",1,0],["وَكُلُّ ذلِكَ مَضْرُوبٌ بِحَقِّكَ في","أنْفاسِ خَلْقِكَ إنْ قَلُّوا وَإنْ كَثُرُوا",14,"ر",3,0],["وَكُلُّ ذا ذَنبُ طَرفي","طُمِستَ يا طَرفُ طَمسا",15,"س",2,0],["وَكُلُّ ذَخيَرةٍ لا بُدَّ يَوماً","وَإِن بَقِيَتُ تَصيرُ إِلى نَفادِ",16,"د",1,0],["وكُلُّ ذُؤابَةٍ في رأسِ خَوْدٍ","تَمنّى أنْ تَكونَ له شِكالا",17,"ل",2,0],["وَكُلُّ ذي إِبِلٍ مَوروثٌ","وَكُلُّ ذي سَلَبٍ مَسلوبُ",18,"ب",1,0],["وَكُلُّ ذي غَيبَةٍ يَؤوبُ","وَغائِبُ المَوتِ لا يَؤوبُ",18,"ب",1,0],["وكل ذلك منهم","إذا تأملت جهل",19,"ل",1,0],["وكل ذرة نور أو مقام هدى","فمن مشارق نور المصطفى طلعا",20,"ع",2,0],["وكل ذلك والقرآن يأمره","قل رب زدني علما فوق ما جمعا",20,"ع",2,0],["وكلّ ذنب سوى الطغيان ننزله","على جوانحنا حبّا وغفرانا",21,"ن",2,0],["وكل ذي حال وقلب بما","افرغت فيه من نداك اكتفي",22,"ف",2,0],["وكل ذهني حتى ما يحركه","شيءٌ وأعيا لساني وهو سحبان",23,"ن",1,0],["وَكُلُّ ذي خَطَرٍ في الناسِ مُحتَقَرٌ","عِندي إِذا لَم يَكُن لِي عِندَهُ خَطَرُ",24,"ر",1,0],["وَكُلُّ ذا لَيسَ يُشفى غَيظَ ذي حَنَقٍ","وَكَيفَ يَشفي غَليلَ الحائِمِ الآلُ",25,"ل",1,0],["وَكُلُّ ذِي غُصَّةٍ بِالماءِ يَدفَعُها","فَكَيفَ يَصنَعُ مَن بِالماءِ غَصّانا",26,"ن",2,0],["وَكُلُ ذي خَنثٍ في الفَحشِ مُنغَمِسٍ","يَزدادُ بِالحَكِّ في وَجَعائهِ الجَرَبُ",27,"ب",1,0],["وَكُلُّ ذِمرٍ مِن غِلمَةِ التُركِ في ال","سِلمِ مَهاةٌ وَفي الوَغى أُسُدُ",28,"د",1,0],["وَكُلِّ ذِي أَشْرَاطْ","مِنْ سَالِفِ الأَفْرَاطْ",29,"ط",1,0],["وكُلُّ ذي رَحمٍ أَوليتُه صلةً","شكت إِلى رَبِّها من قطعِه الرَحِمُ",30,"م",1,0],["وَكُلُّ ذي وَجهٍ جَمي","لٍ فيهِ عِندي مُجمَلُ",31,"ل",1,0],["وكل ذي حب","لهم لوجه الله",32,"ه",1,0],["وكل ذاهب لها","خطواته حسنات",33,"ت",1,0],["وُكلُّ ذي شَرَفٍ لولا خَصائصُهُ","مِنَ الفضائلِ ساوى رأسُهُ قَدَمَهْ",34,"م",2,0],["وكل ذي همةٍ بالصيد منشغفٌ","والليث ذو رغبة في نشبة الظفرِ",35,"ر",1,0],["وكلُّ ذِي صِناعَهْ","طَوَّلَ فيها باعَهْ",36,"ه",1,0],["وكل ذا من قسوة عنده","وحسد في نفسه قائم",37,"م",1,0],["وكل ذا ذوق له مفصل","لا أن هذا عنده تخيل",38,"ل",1,0],["وكل ذلك غير الحق قد وصلوا","إليه بالعقل لا بالشرع مستندا",39,"د",2,0],["وكل ذا دل على حيرة","من طارف الأمر ومن تالد",40,"د",1,0],["وَكُلُّ ذي أَدَبٍ يَبغي الكَمالَ فَمِن","عَبدِ الحَميدِ يَرومُ الأُذُنَ مُلتَمِسا",41,"س",2,0],["وَكُلُّ ذُنوبِ العالَمينَ مَصيرُها","إِلى العَفوِ إِلّا الشِركُ مُمتَنِعُ الصَفحِ",42,"ح",1,0],["وَكُلُّ ذِراعٍ عِندَنا مِن تُرابِها","كَخالِصَةِ الأَعلاقِ عِندَ ضَنينِها",43,"ن",3,0],["وكل ذي فطنةٍ وكيسٍ","يجلد في بيته عميره",44,"ر",2,0],["وَكُل ذا في رِمَّةٍ مِن جَحش","أَو في خَروفٍ مُقعدٍ لا يَمشي",45,"ي",1,0],["وَكُلُّ ذا أَثمانه نصفان","وَمَن يَزد نصفيه نُعطي الثاني",46,"ي",1,0],["وَكُل ذا جَرى وَصاحبُ الكسا","ما زالَ في أَموره مُحتَرِسا",47,"س",2,0],["وَكُلُّ ذا وَالسَبع لَيسَ يَنهر","عَلى خُروج الصَوت لَيسَ يقدر",48,"ر",1,0],["وَكُلُ ذاكَ وَالغُلام يَصرخ","وَيَستَغيث وَالرِياح تَنفخ",49,"خ",1,0],["وَكُلُّ ذا وَلَم يَفُه مَولانا","بَل تَرك الدار وَما تَوانى",50,"ن",2,0],["وَكُلُّ ذا مِن أَجل ملءِ المَعده","لِلّهِ ما أَقبحها من مُقعَده",51,"ه",1,0],["وَكُلُّ ذاكَ غالِباً لا يُمدح","لِأَنَّهُ تَكَبُّرٌ مُستقبحُ",52,"ح",1,0],["وَكُلُ ذا أَحسَن مِن نَطِّ الخَلا","وَرُبَّما نَطٌّ