//www.aldiwan.net/poem69337.html","الخفيف"],[562,"ما دام هذا اليوم يخلفه الغد","https://www.aldiwan.net/poem52845.html","الكامل"],[562,"أسفا على أسف وليس بمنكر","https://www.aldiwan.net/poem52942.html","الكامل"],[567,"أي أب رزيته","https://www.aldiwan.net/poem69562.html","مجزوء الرجز"],[575,"خانت جفوني لما لم تفض بدمي","https://www.aldiwan.net/poem2780.html","البسيط"]],"verses":[["خَلَّفتَني زَرعاً فَطُلتُ وَإِنَّما","ذاكَ الغِرارُ نُمِي إِلى الصَمصامِ",0,"م",1,0],["خِلفَةً وَطفاءَ يَمريها الرَدى","مَطَرَ الطَعنِ رَذاذاً وَرُهاما",1,"م",2,0],["خَلفْتَهمُ في المَكْرُماتِ وفي العُلا","كما تَخْلُفُ السُّمْرَ المُهَنَّدَةُ البُتْرُ",2,"ر",1,0],["خلّفتني أذكر الصفو كما","يذكر الشيخ خيالات الشباب",3,"ب",1,0],["خَلَّفْتَ أُمَّةَ أَحْمَدٍ لِمُحَمَدٍ","فَقَضَتْ بِسَعْدِ الأُمَّةِ الأَحْكَامُ",4,"م",1,0],["خلَفْتَ إبْراهيمَ خيْرَ خليفَةٍ","للمُسْلِمينَ قدِ اسْتَقرّ قَرارُهُ",5,"ر",2,0],["خلَفْتَ الأبَ المرْضيَّ خيْرَ خِلافَةٍ","وقُمْتَ بأمْرِ اللهِ مُمْتَثِلَ الأمْرِ",6,"ر",1,0],["خلّفوني منْ بَعْدِهِمْ ناكِسَ الطّرْ","فِ ثَقيلَ الخُطى مَهيضاً جَناحي",7,"ح",2,0],["خَلَّفاني بَينَ الرِفاقِ وَحيداً","مُستَكيناً وَأَمعَنا في الغِيابِ",8,"ب",1,0],["خَلَّفتَها كَالمَشقِ يَحذو حَذوَها","راجى الوُصولِ وَمُقتَفي الآثارِ",9,"ر",1,0],["خَلفتُ لَها آباءَها وَوَكلتُها","إِلى ناصِحٍ طَبٍّ خَبيرٍ بِسِرِّها",10,"ر",3,0],["خَلَّفْتَ فِيهَا مُصْطَفَاكَ فَكُلَّمَا","شَهِدَتْ مَواقِفُهُ خَطَرْتَ بِبَالِهَا",11,"ل",3,0],["خَلَّفْتِ بِالفَضْلِ الَّذِي أَسْدَيتِهِ","ذِكْرَى مُرَدَّدَةٍ بِكُلِّ جَنَانِ",12,"ن",1,0],["خَلَفتَموهُ عَلى الأَبناءِ حينَ مَضى","خِلافَةَ الذِئبِ في أَبقارِ ذي بَقَرِ",13,"ر",1,0],["خَلَفتَ أَبا موسى وَشَرَّفتَ ما بَنى","أَبو بُردَةَ الفَيّاضَ مَن شَرَفِ الذِكرِ",14,"ر",1,0],["خلفت من الشرور فكنت شرّاً","تعذّر منه فاعل كلّ شرّ",15,"ر",1,0],["خَلَفَ السِنانُ بِهِ مَواقِعَ لَثمِها","بِئسَ الخِلافَةُ لِلمُحِبِّ البائِسِ",16,"س",1,0],["خلّفتمُ للمكرمات ممدّحاً","أعدى على رتب الزمان وانفذا",17,"ذ",2,0],["خلفت بالقلب بيتاً منك معمورا","لقد هجرت وقلبي ليس مهجورا",18,"ر",2,1],["خَلَفوني خلافةَ الذئب في الشا","ء وكانوا في جهل حقِّيَ شاءَ",19,"ا",2,0],["خلَّفتُ أهلي في ذراك وإنه","للاجئين لمَلْجأ ومَصَادُ",20,"د",1,0],["خلفَه كل حثيث ال","رَكض في نقعٍ مُثار",21,"ر",1,0],["خلفت عليكم أمهُ وتكفّلتْ","بكُمُ وعِدّةُ عشرها لم تُكْملِ",22,"ل",1,0],["خلفتَ وابنُ وزير الصدق حاتمكم","جوداً فأَصبح منشوراً من الكفن",23,"ن",1,0],["خلَفَتْ كفك الربيعَ فجادت","بنداها حتى التقى الثَّريان",24,"ن",1,0],["خَلَّفَ العِبءَ علَيَّ وَوَلّى","أَنَا بِالعِبءِ له مُستَقِلُّ",25,"ل",1,0],["خَلَفَ البَهاءَ عَلى القَريضِ وَكَأسِهِ","فَسَقى بِعَذبِ نَسيبِهِ العُشّاقا",26,"ق",2,0],["خَلَّفتَ في الدُنيا بَياناً خالِداً","وَتَرَكتَ أَجيالاً مِنَ الأَبناءِ",27,"ا",2,0],["خَلَّفتُ فيها القَطا ما بَينَ ذي زَغَبٍ","وَذي تَمائِمَ لَم يَنهَض وَلَم يَطِرِ",28,"ر",1,0],["خَلَّفتُ لُبنانَ جَنّاتِ النَعيمِ وَما","نُبِّئتُ أَنَّ طَريقَ الخُلدِ لُبنانُ",29,"ن",1,0],["خُلَفاءُ الرُسلِ في الأَرضِ هُمو","يَبعَثُ اللَهُ بِهِم عاماً فَعاما",30,"م",2,0],["خَلَفَت صِفاتُكَ في العُيونِ كَلامَهُ","كَالخَطِّ يَملَءُ مِسمَعَي مَن أَبصَرا",31,"ر",2,0],["خَلَفَ السحابَ ندى أكُفِّهِمُ","وسناهُمُ أغنُى عن الشمسُ",32,"س",1,0],["خَلَفَ الجِدَّةَ البِلى في مَغاني","ها كَما يَخلُفُ الشَبابَ المَشيبُ",33,"ب",1,0],["خَلفَكَ الثائِرُ المُصَمِّمِ بِالسَي","فِ وَرِجلاكَ فَوقَ شَوكِ القَتادِ",34,"د",1,0],["خَلَّفَت دارَها بِحُزوى وَباتَت","بَينَ سِحري شَروى الضَجيعِ وَنَحري",35,"ي",1,0],["خَلَّفتَها وَإِنصَرَفتَ وَهيَ عَلى ال","مَنصَفِ بَينَ الإِملاكِ وَالعُرسِ",36,"س",1,0],["خَلَّفَ الفَوتَ لِلجِيادِ وَأَلقى","في مَدى المَجدِ غُرَّةً وَحُجولا",37,"ل",2,0],["خَلَفَتكُمُ الأَنواءُ في أَوطانِكُم","فَسَقَت صَوادي أَربُعٍ وَطُلولِ",38,"ل",1,0],["خُلِّفتُ بَعدَهُمُ أُلاحِظُ نِيَّةً","قَذَفاً وَأَنشُدُ دارِساً مُتَرَسِّما",39,"م",2,0],["خَلَفَت يَدَيكَ يَضاهُ فِيَّ وَإِنَّما","هُوَ وَبلُهُ وَرَذاذُهُ وَرِهامُهُ",40,"م",2,0],["خُلَفاءَ قَد تَرَكوا فَرائِضَهُم","فينا وَسُنَّةَ طَيِّبي الذِكرِ",41,"ر",1,0],["خُلِّفَ شَهْرَيْنِ على الخِلْفَيْنِ","ثم رَعَى بعدَهُما شَهْرَيْنِ",42,"ن",1,0],["خَلَفَت مَدامعُنا النَّدى في ربَ