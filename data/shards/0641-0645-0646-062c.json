{"poems":[[63,"حسب الأمير سماح وطد الحسبا","https://www.aldiwan.net/poem51801.html","البسيط"],[68,"توق من الناس فحش الكلام","https://www.aldiwan.net/poem38584.html","المتقارب"],[46,"أيا ويل الشجي من الخلي","https://www.aldiwan.net/poem30326.html","الوافر"],[71,"تذكرت بالبرق إذ يلمع","https://www.aldiwan.net/poem28985.html","المتقارب"],[76,"سرى يرتمي ركضا به كل موجة","https://www.aldiwan.net/poem12927.html","الطويل"],[77,"هل تملك الدار رجع سائلها","https://www.aldiwan.net/poem69023.html","البسيط"],[77,"بلى هذه تيماء والأبلق الفرد","https://www.aldiwan.net/poem69089.html","الطويل"],[48,"كم سبحت أربع جوار","https://www.aldiwan.net/poem22555.html","مجزوء البسيط"],[107,"","https://poetry.dctabudhabi.ae/diwan/poem/49143","الطويل"],[147,"حمى النوم أجفان صب وصب","https://www.aldiwan.net/poem11724.html","المتقارب"],[147,"ليهنك ما أنالتك الجدود","https://www.aldiwan.net/poem11748.html","الوافر"],[147,"ظن الأراك لدى واديه أظعانا","https://www.aldiwan.net/poem11832.html","عموديه"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[193,"مقام أجل الرسل أعلى وأعظم","https://www.aldiwan.net/poem35106.html","الطويل"],[215,"غنى المغنون من حولى فما سمعت","https://www.aldiwan.net/poem46768.html","البسيط"],[228,"عذيرك من مستلهمين تصدروا","https://www.aldiwan.net/poem39687.html","الطويل"],[228,"يا حب عذب","https://www.aldiwan.net/poem39733.html","مخلع البسيط"],[353,"وسائل عن قصيدة عبقت","https://www.aldiwan.net/poem20435.html","المنسرح"],[369,"طربت لإلمام الخيال المعاود","https://www.aldiwan.net/poem60962.html","الطويل"],[369,"رأينا عجيبا والزمان عجيب","https://www.aldiwan.net/poem61001.html","الطويل"],[382,"علاك الفضل في طي الجمال","https://www.aldiwan.net/poem59291.html","الوافر"],[412,"علا بك نجم الدين فاشتد ناصره","https://www.aldiwan.net/poem50168.html","الطويل"],[422,"بحيث انعطف البان","https://www.aldiwan.net/poem54026.html","الهزج"],[422,"متى يشفى بك الصب العميد","https://www.aldiwan.net/poem54140.html","الوافر"],[422,"بوادي الغضا للمالكية أربع","https://www.aldiwan.net/poem54180.html","الطويل"],[445,"وأهد بها في الفلا والسرى","https://www.aldiwan.net/poem34834.html","المتقارب"],[449,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[463,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[463,"سوى رسني قاده الباطل","https://www.aldiwan.net/poem55975.html","المتقارب"],[463,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[463,"لكِ الغرام وللواشي بكِ التعب","https://www.aldiwan.net/poem56274.html","البسيط"],[500,"دعا فأجابه القدح","https://www.aldiwan.net/poem9811.html","مجزوء الوافر"],[505,"ولما توسطنا البطاح عشية","https://www.aldiwan.net/poem37797.html","الطويل"],[543,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[572,"متى تنشط للأكل","https://www.aldiwan.net/poem69479.html","الهزج"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54049","البسيط"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66978","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63780","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38418","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59776","الطويل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105463","المتقارب"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59149","الطويل"],[1230,"","https://poetry.dctabudhabi.ae/diwan/poem/123609","الطويل"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124364",""],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113798","الطويل"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113815","الطويل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104953","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124774","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76055","الطويل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109784","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74171","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74047","الهزج"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92070","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133267","الوافر"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133228","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111518","الرجز"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44639","المتقارب"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120324","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139595",""],[4767,"إلى المنسوب","https://www.poetsgate.com/ViewPoem.aspx?id=179875",""],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4831,"الرّبيع","https://www.poetsgate.com/ViewPoem.aspx?id=208034",""],[4858,"أبكي المروءة","https://www.poetsgate.com/ViewPoem.aspx?id=33887",""],[4927,"جواز السفر","https://www.poetsgate.com/ViewPoem.aspx?id=80800",""],[4943,"القطرة الغيثية والوسيلة الالهية","https://www.poetsgate.com/ViewPoem.aspx?id=125974",""],[4984,"في عيدها ..","https://www.poetsgate.com/ViewPoem.aspx?id=196952",""],[5302,"ولي وطن","https://www.poetsgate.com/ViewPoem.aspx?id=200125",""],[592,"أقول نعم هذا هو الحق والهدى","https://www.poetsgate.com/ViewPoem.aspx?id=128810",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5628,"زهور ذابلة","https://www.poetsgate.com/ViewPoem.aspx?id=178513",""],[6084,"أبي حسبي أني أعيش بذلة","https://www.poetsgate.com/ViewPoem.aspx?id=170866",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""],[6164,"حب وعرفان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66047&r=&rc=56",""],[5464,"بغداد والخمسون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=491&r=&rc=5",""],[6259,"علا بك نجمُ الدين فاشتدَّ ناصره","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59378&r=&rc=26",""]],"verses":[["فَمِنْ جِنانٍ تُريكَ النَّوْرَ مُبتَسِماً","في غير إبَّانِه والماءَ مُنسَكِبا",0,"ب",2,0],["فَمَن جَرَّبَ الذَمَّ في عِرضِهِ","كَمَن جَرَّبَ السُمَّ في نَفسِهِ",1,"ه",1,0],["فَمِن جودٍ تَدَفَّقَ سَيلُهُ لي","عَلى مَطَرٍ وَمِن جودٍ أَتِيِّ",2,"ي",1,0],["فَمِنْ جهةِ الطبعِ لي مطمحٌ","وَمِنْ جهةِ الشرعِ لا مطمعُ",3,"ع",1,0],["فَمِن جَوعَةٍ تُغريهِ بي فَهوَ مُدَّنٍ","وَمِن رَوعَةٍ تُثنيهِ عَنّي فَيَقصُرُ",4,"ر",1,0],["فمن جياد أحفوا سنابكها","حتى تمشت على مراكلها",5,"ل",3,0],["فمن جَمْرَةٍ قد أُطفئَتْ مَخْلديّةٍ","وأُخرى لها بالزّابِ مذ زمَنٍ وَقْد",6,"د",1,0],["فَمِن جَنوبٍ وَمِن شَمالٍ","وَمِن صَباً أُختُها الدَبورُ",7,"ر",1,0],["فمن جاءنا يبغي مَغانِمَ خَيبرٍ","فليس له فيها نَصيبٌ ولا سَهمُ",8,"م",1,0],["فَمَن جامِلٍ مَرَّ صَوبَ الجَميلِ","وَمِن ذَهَبٍ في العَطايا ذَهَب",9,"ب",1,0],["فَمِن جَيشٍ يَعُدُّ العَودَ فَتحاً","وَمِن جَيشٍ يَمُرُّ فَلا يَعودُ",10,"د",1,0],["فَمِن جُدودِهِمُ الأَملاكُ في حَلَبٍ","وَمِن جُدودِهِمُ أَملاكُ بَغدانا",11,"ن",2,0],["فمِن جهةٍ يُدعى الإمامَ ويقتدي","بِأعمالِ أهلِ الكُفرِ مِن جهة أُخرى",12,"ر",2,0],["فمَن جَحدوه لن يَنالوا أمانهُ","وَجاحدهُ مهما اِتّقى فهو مجرمُ",13,"م",1,0],["فمن جمالك وهو الدرُّ في نسق","كالشعر ينظم أنغاماً بأوزان",14,"ن",1,0],["فَمِن جَبَلٍ وَعرٍ إِلى صَخرِ شاطيءٍ","وَمَن حَمَلَ الآمالَ لا يَتَكَسَّرُ",15,"ر",1,0],["فَمن جُروحي","هذا النَغَم",16,"م",1,0],["فَمَنْ جَلاهَا على الأَمِيرِ بأَل","حَانٍ تَلاها الحَمامُ إذْ هَتَفا",17,"ف",2,0],["فَمن جَعل الدّنيا بمُلكِك جَنّةً","حقيقٌ بأن يعطيكَ عيشةَ خالد",18,"د",1,0],["فمِن جانبٍ أَضحتْ تُصَبُّ مُدامةٌ","ومن جانبٍ أَضحَتْ تُشَبُّ حروب",19,"ب",1,0],["فمن جزءٍ كثيفٍ في كثيفٍ","حووا جزء الملائك في الكمال",20,"ل",1,0],["فمن جاء مِن طييٍّ شكرناك دونَه","لاعطائك الطَولُ الَّذي هوَ ناشِرُهُ",21,"ر",2,0],["فمن جفنيك صمصام","ومن قدّك مرّان",22,"ن",1,0],["فمن جودٍ تَصوبُ به الغوادي","ومن بأسٍ يلين له الحديد",23,"د",1,0],["فمن جوده إنِّي رُبِيتُ بجوده","وزير له الإِحسان والجود أجمعُ",24,"ع",1,0],["فَمُنْجِدَةٌ فِي مَجالِ النِّجادِ","وغائِرَةٌ فِي غُرور الرِّداءِ",25,"ا",2,0],["فمن جدع ومن شتر","ومن شرم إذا اشوى",26,"ا",1,0],["فمِن جَداكم عندي ونعمتِكم","أنِّي تعلمتُ أشكرُ النِّعما",27,"م",2,0],["فمن جاهلٍ بيَ أو عارفٍ","بخيل فياليته جاهلُ",28,"ل",1,0],["فمن جانبٍ بلدٌ جُرحُه","بعدلك أُلحمَ لمّا رُعي",29,"ع",2,0],["فمن جباهكُمُ نَورُ الربيع لنا","ومن أكفِّكمُ الأنواءُ تنسكبُ",30,"ب",1,0],["فمن جاراه منقطع","ومن باراه مفتضح",31,"ح",1,0],["فمن جَعَلَ الأَكوانَ هَمًّا فإنَّنا","جَعَلْناهُمُو في كلِّ آوِنَةٍ هَمَّا",32,"م",2,0],["فمن جُثتِ القتلى أسَرتَهم كَما","أدَرتَ عليهم من كؤوسِ الرَّدَى خَمرا",33,"ر",2,0],["فَمِنْ جَدْيٍ شَوَيْنَاهُ","وَعَصَّبْنَا مَصَارِيْنَهْ",34,"ن",2,0],["فمن جمال يروق مرأى","ومن كمالٍ على حصاةِ",35,"ه",1,0],["فَمِنْ جُوْدِهِ ما في الغَمَامةِ من حَياً","ومِنْ نُوْرِهِ ما في الغَزَالَةِ مِنْ وَقْدِ",36,"د",1,0],["فمن جوهرٍ تُسْقَاهُ من كفِّ جوهرٍ","ومن جوهرٍ تُسْقَاهُ من كفِّ جوهره",37,"ر",2,0],["فَمِن جبلٍ أَعلو لِوادٍ نَزَلتهُ","وَلَكِن بِطَرحِ النّفسِ أَحذِفُها حَذفا",38,"ف",2,0],["فمن جعل الصبر الجميل عزيمة","فحقَّ عليه نقضه ذلك العزما",39,"م",2,0],["فمن جعفر زاخر فضله","يمد بمعروفه الأبحرا",40,"ر",2,0],["فَمِنْ جُودِكُمْ يَا آلَ مُزْهِرَ أزهَرتْ","أفَانِينُ فَرْعِ الآمِلِ المُتَجَشِّمِ",41,"م",1,0],["فمن جاء من ماء الشبال بشربةٍ","فإن له من ماء لينة أربعاً",42,"ع",2,0],["فمن جاور العطار طاب بطيبه","ومن جاور الحَدَّاد نال السوائدا",43,"د",2,0],["فَمَن جاءَ مُشتاقاً إليهِ أخا وَجدِ","وَخَلفَ ما خلّى من الأهلِ والوُجدِ",44,"د",1,1],["فمَن جاء هذا البيتَ يُرجى قبولُهُ","ومن خاف مكروهاً ففيه أمانُهُ",45,"ن",2,0],["فمن جاء مغتالاً فأنت تميته","ومن جاء ممتاراً فأنت تميره",46,"ر",2,0],["فمن جحد الأركان أو حرمة الزنا","وخمر وحل الماء والخبز يجحد",47,"د",1,0],["فَمِن جودِهِ في كُلِّ جِيدٍ قَلائِدٌ","بِها يَزدَهي حُسناً عَلى مَن يُطاوِلُه",48,"ل",2,0],["فمن جاهل بالفضل او متجاهل","وذو الفضل فيما بين هذين يحرم",49,"م",1,0],["فَمِن جُنودك حزب الشرق في أَرق","وَالأَرض تَرجف مِن زَهو وَمِن فَرق",50,"ق",1,0],["فمن جمرة ذاك الخد","د كلّ مدامةٍ تُعصر",51,"ر",1,0],["فمن جهالةِ ذي الآمال صحبتُهُ","جونَ الليالي التي يغتال ساجيها",52,"ي",3,0],["فمن جدواك عمتنا مزايا","ومنك الفضل في الكون استبانا",53,"ن",2,0],["فمن جدواك يرجى كل خير","ومن نعماك قد فاض العطاء",54,"ا",2,0],["فمن جناح الطائر السهم برز","ثم لدى مريون في الترب ارتكز",55,"ز",1,0],["فَمِن جَحَد اللَه كُفراً وَعَمداً","إِذا ما رآك يوحِّدُهُ",56,"د",2,0],["فمن جاء في هذه الثلاث مخالفا","فان هو الا في طباع بهيم",57,"م",1,0],["فمن جده إرثٌ لديه صفاته","وأسماه والبرهان في ذاك واضح",58,"ح",1,0],["فمن جاؤوا وروداً حول بأسٍ","تراهم في غد يأساً صدورا",59,"ر",2,0],["فمن جملة الأملاك والرسل اجتلي","لطائف لم تودع صحائف رهبان",60,"ن",1,0],["فمِنْ جبيني أكاليلٌ بِها دُرَرٌ","وفي عُيُوني بريقُ الفَجْرِ والشَفَقِ",61,"ق",1,0],["فمن جَناها إخاءٌ لا يزعزعُه","هُوجُ الوساوسِ إن هبّت سواقيها",62,"ي",3,0],["13-فَمَنْ جَعَلَ - السَّفِيْرَ اللِّصَّ - جُعْلاً","وَجَاْعَلَ رَهْطَهُº نَاْلَ الْجَوَاْزَاْ",63,"ز",2,0],["فمن جاء بالحسنى ويسرته لها","تضاعف له منك المثوبة والفضل",64,"ل",1,0],["فمن \"جَمِيلَة بُوحَيْرِيد\" خُذْ مثلا","يغنيك من دون تفصيل بإجمال",65,"ل",1,0],["فمن جاء في سلم وهبناه فوق ما","يؤمله جان ويطلبه عان",66,"ن",1,0],["فمن جحد الأوصاف لله ربنا","ونزهه عن كونه يتكلم",67,"م",1,0],["فمن جملة السكان فيها روافض","وتحمونهم هذا من القدح والخلل",68,"ل",1,0],["فمن جعل المعصوم كالناس إنما","يزار لكي يدعى له ثم بالقصد",69,"د",1,0],["فمن جاء نحو المصطفى زائراً له","وكان يرى هذا فليس على رشد",69,"د",1,0],["فمن جعل الروضَ يشكو الجفافَ","ومَنْ أحرقّ الزًهْرَ.. مَنْ أذْبلهْ",70,"ل",2,0],["فمن جدة في الناس جدي وخاله","كخالي على هام السماك مخيم",71,"م",1,0],["فمن جهل عيني في غيني قل أيني","وإني ولا أيني والبينونه لا فلا",72,"ل",2,0],["فمن جَدّه عبد العزيز.. وفَيْصلٍ","أبيه تَبَدَّى المجد مُمْتَنِعاً فَخَلا!",73,"ل",2,0],["فمن جوع إلى وجع","ومن ضيْم إلى ظلم",74,"م",1,0],["فمن جاد من طيّ شكرناك دونهُ","لإعطائك الطول الذي هو ناشره",75,"ر",2,0]]}