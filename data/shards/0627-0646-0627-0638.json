{"poems":[[75,"أنا ظرف للهو كل ظريف","https://www.aldiwan.net/poem11989.html","الخفيف"],[95,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[87,"عش للخلافة ترضاها وترضيها","https://www.aldiwan.net/poem7528.html","البسيط"],[99,"نداؤك يا فؤاد كفى نداء","https://www.aldiwan.net/poem25073.html","الوافر"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62237","البسيط"],[139,"من لي إذا ما استقل الركب أو سارا","https://www.aldiwan.net/poem48842.html","البسيط"],[190,"حظي من النوم بعد الهجعة الأرق","https://www.aldiwan.net/poem43553.html","البسيط"],[215,"تلقيت من روح الجمال رسالة","https://www.aldiwan.net/poem46317.html","الطويل"],[240,"يا صاحبي لمن هذه","https://www.aldiwan.net/poem32116.html","المجتث"],[285,"لو كنت شاهد عبرتي يوم النقا","https://www.aldiwan.net/poem60695.html","الكامل"],[285,"ويوم أخذنا به فرصة","https://www.aldiwan.net/poem60709.html","المتقارب"],[333,"أنا سر الجنون قبل الجنون","https://www.aldiwan.net/poem54934.html","الخفيف"],[371,"إن أظلمت للنفس فيها ليلة","https://www.aldiwan.net/poem17941.html","الكامل"],[412,"الليل حيث حللن فيه نهار","https://www.aldiwan.net/poem50176.html","الكامل"],[447,"أريحي الوجا يا ناق ما بعد ذا وجا","https://www.aldiwan.net/poem14299.html","الطويل"],[463,"ما كنت لولا طمعي في الخيال","https://www.aldiwan.net/poem55936.html","السريع"],[520,"أصبت في خير أعضائي وأعضادي","https://www.aldiwan.net/poem12069.html","البسيط"],[520,"رمى بنا الثغر كما ترمى الثغر","https://www.aldiwan.net/poem12162.html","الرجز"],[534,"ما لبسك الديباج والتاج مع","https://www.aldiwan.net/poem37420.html","السريع"],[556,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[563,"من مات يعلم أنك الحق المبين","https://www.aldiwan.net/poem33797.html","الكامل"],[580,"تلاقى تلاقي سورة ليس تعلم","https://www.aldiwan.net/poem2857.html","الطويل"],[580,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"],[591,"أضحى له في اكتئابه سبب","https://www.aldiwan.net/poem17411.html","المنسرح"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120024","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119972","المنسرح"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120081","السريع"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120030","السريع"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64969","المتقارب"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112919","الطويل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111854","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118336","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53169","الرجز"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28608","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60858","الكامل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106994","الخفيف"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146373","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100809","المجتث"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89014","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126974","الرجز"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108029","البسيط"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118759","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117917","السريع"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36218","الدوبيت"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54454","المنسرح"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54438","المنسرح"],[4748,"وداع","https://www.poetsgate.com/ViewPoem.aspx?id=4193",""],[4748,"يا نور عيني","https://www.poetsgate.com/ViewPoem.aspx?id=6657",""],[4755,"دَعِي مَن على عَينيكِ قبلِي تَلَصَّصُوا","https://www.poetsgate.com/ViewPoem.aspx?id=184218",""],[4777,"صمت السنين","https://www.poetsgate.com/ViewPoem.aspx?id=135384",""],[4791,"عند اللقا","https://www.poetsgate.com/ViewPoem.aspx?id=37118",""],[4791,"اهل الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=34896",""],[4877,"باين عليك","https://www.poetsgate.com/ViewPoem.aspx?id=30102",""],[5055,"حشد روس الفحول","https://www.poetsgate.com/ViewPoem.aspx?id=101193",""],[5121,"حنين ودموع","https://www.poetsgate.com/ViewPoem.aspx?id=33628",""],[5128,"لَبَّيكْ","https://www.poetsgate.com/ViewPoem.aspx?id=214000",""],[5187,"حواء وتجربتي","https://www.poetsgate.com/ViewPoem.aspx?id=29256",""],[5376,"إنِّي جَزِعْتُ وما لنا الا هو","https://www.poetsgate.com/ViewPoem.aspx?id=188286",""],[5431,"قطوف عشقٍ دانيه!!...","https://www.poetsgate.com/ViewPoem.aspx?id=200580",""],[5493,"إلى أخ الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=197467",""],[5628,"لحن الانتظار","https://www.poetsgate.com/ViewPoem.aspx?id=178524",""],[5652,"كيان الروح","https://www.poetsgate.com/ViewPoem.aspx?id=192065",""],[5693,"أنا العاصي أنا العاصي","https://www.poetsgate.com/ViewPoem.aspx?id=37317",""],[5701,"أنا ظل نفسي في الحيا","https://www.poetsgate.com/ViewPoem.aspx?id=164633",""],[6031,"يا قبرُ إنَّكَ لو عَلِمْتَ بِمَنْ ثَوَى","https://www.poetsgate.com/ViewPoem.aspx?id=46284",""],[6035,"كم كان أَعْدَل لو أَزْرَى بنا الحَجرُ .. !","https://www.poetsgate.com/ViewPoem.aspx?id=177617",""],[161,"لكل سؤال جواب وحل","https://www.poetsgate.com/ViewPoem.aspx?id=169334",""],[6131,"يَا صَاعدًا للنورِ متَّكئَ النَّدَى","https://www.poetsgate.com/ViewPoem.aspx?id=189339",""]],"verses":[["أَنا ظَرفٌ لِلَهوِ كُلِّ ظَريفِ","أَنا مُستَودَعٌ لِعِلقٍ شَريفِ",0,"ف",1,1],["أَنَاظِرٌ أَنْتَ لَمَّا هَمَّ كيْفَ خَطَا","مِنَ الصَّفَا غَيْرَ مُعْتَاقٍ وَلا عَانِ",1,"ن",1,0],["إن أظمت الحرب كانوا البيد ظامئة","أو أعرت الحرب كانوا هم عواليها",2,"ي",3,0],["أنا ظمآن لم يلمع سراب","على الصحراء إلا خلتُ ماءَ",3,"ا",2,0],["أَنِاظِرُ الوَصْلُ أَمْ غادٍ فَمَصْرُومُ","أَمْ كُلُّ دَيْنِكَ مِنْ دَهْمَاءَ مَغْرُومُ",4,"م",1,1],["إن أظهر الجمع ما بي من جوايَ فقد","أضمرتُه في سوادِ القلبِ إضمارا",5,"ر",2,0],["إن أظهروا النسك في تلبيس ظاهرهم","فالثوب يطوى وفي أثنائه حرق",6,"ق",1,0],["أناظرهُ روحا لروح كأنني","أراك ومن لألاء وجهك أنهَل",7,"ل",1,0],["إِن أَظلَمَ الخَطبُ","فَالشُهبُ أَنتُمُ وَالمَصابِح",8,"ح",1,0],["إِنْ أَظْلَمَتْ كُنْتَ الضَّحاءَ الْمُجْتَلى","أَوْ أَجْدَبَتْ كُنْتَ الرَّبِيعَ الْمُغْدِقا",9,"ق",2,0],["إِنْ أَظْلَمَتْ تِلْكَ السَّماءُ فَقَدْ خَلا","مِنْ بَدْرِها الأَبْهى مكانُ الْمَطْلَعِ",10,"ع",1,0],["أنا ظل الهوى القديم ومعنا","ه ومجلى جماله المكنون",11,"ن",1,0],["إِن أَظلَمَت لِلنَفسِ فيها لَيلَةٌ","قَمَرُ المَعاني عِندَنا سِمسارُها",12,"ه",2,1],["إِن أَظلمت قطع الرِياض أَضالَها","نُوّارِها فَكَأَنَّها الأَنوارُ",13,"ر",1,0],["أناظر دب النمل والنمل أسود","بليل كعين الظبي أسود قد دجا",14,"ج",2,0],["إن أظلم الدهر فعزْماتُه","تَوَقُّدٌ في أفقه واشتعالْ",15,"ل",1,0],["إن أظلم الجو في عيني فقد فجعت","بكوكب في سماء المجد أوقد",16,"د",1,0],["إن أظلمت أيامنا بفقده","ففي الدجى يعرف مقدار القمر",17,"ر",1,0],["إنْ أظْلَمَ الإشْكالُ قابَلْتَهُ","بالضَّوْءِ تَغْدُو عِنْدَ ذَا مُبْصِرا",18,"ر",2,0],["أَنا ظامٍ وليس أَنقع أَن أُب","صِرَ عَيني في الخلقِ إلّا الشّرارا",19,"ر",2,0],["أنا ظلمة ظهرت بنور محمد","ومحمد نور بنورك مستبينْ",20,"ن",1,0],["أَناظِرُه في الهجر كيف استَجازَه","فيذكرُ بعضَ الحُسْنِ لي فأُسَلِّم",21,"م",1,0],["إِنْ أَظْلَمَ الخَطْبُ المُلِمُّ","فرأْيُه مثلُ الشِّهابِ",22,"ب",1,0],["إِنْ أَظْلَمَ الدَّهْرُ ضَاءَ حُسْنُهُم","وَإِنْ أُمِرَّت أَيَّامُنَا عَذُبُوا",23,"ب",3,0],["إن أظلمت شيم اللئام فوجهه","طلق يضيء وثغره بسامُ",24,"م",1,0],["إن أظلم الخطب كشفته","شموس آرائك المضيه",25,"ي",2,0],["إن أظلم الخطب وأكدى الحيا","فأنت بدر وغمم مطير",26,"ر",1,0],["إن أظلم الخطب وأكدى الحيا","فأنت بدر وغمام مطير",27,"ر",1,0],["أَناظِمَ كلِّ شَرودٍ بِها","يَهونُ الْحَرونُ ويُنْهي الْحرَنْ",28,"ن",1,0],["أنا ظالم نفسي وقد صرت في عنا","فقل أنت يا مدثر احرى والدنا",29,"ن",2,0],["ان اظهرت ايدي الخطوب عيوبهُ","يوماً فيخفي ما يلوحُ الدرهمُ",30,"م",1,0],["ان اظهروا ما بهم ليمو او ان كتموا","لا قوا بما كابدوا تصديع اكباد",31,"د",1,0],["إن أظلم الدهر أضا","أو جمد الغيث هطل",32,"ل",1,0],["إِن أَظهَرَت لِعُلاكَ أَنطاكِيَّةٌ","حُزناً فَقَد ضَحِكَت عَلى قُطّانِها",33,"ن",3,0],["إنْ أظلمت فستنجلي","وكمِثل مَا حَمَلتْ تضع",34,"ع",1,0],["أنا ظامي الحشى فماذا عليك","لو ترشفت ما على لثتيك",35,"ك",1,1],["أَنا ظالمي إِن عِفتُ سَطْوة ظالمي","بل لائمي إِن خفتُ جَفْوَةَ لائمي",36,"م",2,1],["ان أظلمت كنت شمسا","أو أجدبت كنت وبلا",37,"ل",2,0],["إن أظلمت في الحكم مشكلة","أنارها بشمس فكرته",38,"ت",2,0],["ان أظلم الكون أسا فقد هوى","من أفق الاسلام بدر السعد",39,"د",1,0],["إن أظلم الشرق في ذا اليوم لا عجب","فكل أقماره ذا اليوم قد أفلوا",40,"ل",3,0],["إن اظمأته ذنوبه","من خوف ديّان يدينه",41,"ن",2,0],["إن أظهرت بالقول حمداً فلا","تحمد في السر ولا تشكر",42,"ر",1,0],["إِن أَظهَرَ ما بِقَلبِهِ مِن داءِ","صَبٌّ مَلكته سورَةُ الصَهباءِ",43,"ا",2,1],["إن أَظلمتْ خطَة أضاءَ لنا","أَو ظَلَم الخطبُ جائراً عَدلا",44,"ل",2,0],["إن أظلمتْ سُدْفَةٌ أَنَرْتَ لها","أَبهى ليالي البدورِ مُسدفُها",45,"ف",3,0],["اناظر في الخلايق واستخيلك","تبادلني التحيّه والصفاحي",46,"ح",2,0],["أناظرك في الخيال قربي ولكن بعيد","شوقي تعدى احتمالي وصبري وصل أخره",47,"ر",2,0],["أنا ظامئٌ مُذْ غِبْتِ عني, ولَم يَزَل","على جَمرَةٍ وَصْلِي وصَدِّي يُحَصحِصُ",48,"ص",1,0],["اناظر احدود السماء في يديني","واشلع وادور للنجوم ابسماتي",49,"ت",2,0],["أناظر ورودٍ عليها كسر في","ورمشٍ بغمضه عين يطوي إشراعه",50,"ع",2,0],["اناظر العين وادري بك","غايب وتنشد عن الغيّاب",51,"ب",1,0],["انا ظلالك ما دام الله معافيني","الله عطاك الغلا المعبود سبحانه",52,"ن",2,0],["أناظر في سواري أللي متى قام الشعر أعراس","ويشرق في فضاء نوره وراحة عنوة التجشيم",53,"م",1,0],["أناظرُ أينَ شمسي ؟ أين يومي ؟","وأينَ سفور عَينيَّ الرّحيبِ ؟",54,"ب",1,0],["أنا ظامئٌ صحراءُ قلبيَ ضحلةٌ","فلتَسقِني من حُسنِكِ الثجاجِ",55,"ج",1,0],["إنْ أظهرتْ بالحُبِّ عِفتها","لا تَنْخدعْ بِظواهرِ الصُّورِ",56,"ر",1,0],["إنَّا ظلمْنا النفسَ يا ربَّ السما","فتبخترَ الشيطانُ عند علاهُ",57,"ا",2,0],["أنا ظلّك المقتول فيك تولّها!!","من قال : كلّ العاشقين سواسيه!!؟",58,"ي",2,0],["إن أظلمت دنياكَ رغم ضيائها","فاحمِل بعينك نورَهُ كي تُبصرَا",59,"ر",2,0],["أنا ظمآنُ فهلْ مِنْ رشْفةٍ","أمْ هوى كأسُ الهوى فانكسرا",60,"ر",2,0],["أناظر بك .. سما فكري مخيله دايمٍ براااااق","مطر / روحي على برقك يخيل الغيم وأمزانه",61,"ن",2,0],["أنا ظل لأوهامي","ودمع العين كرّاسي",62,"س",2,0],["أنا ظل نفسي في الحيا","ة فأي شيء خلف ظلي",63,"ل",2,1],["إن أظلمتْ سُدُفُ المقابرِ فاستنرْ","منْ بينِها فلقد حَوَيْتَ نَهَارَا",64,"ر",2,0],["إنّا ظَنناكِ منْ أقسى خلائِقه","لقد وَهِمْنا ، وسُقنا الظنّ يَعتذرُ",65,"ر",1,0],["08-أُنَاظِرُ زَادَ الرَّجَاءِ عَسَى","مَدِيدًا يُنَاهِضُ كَسْرَ الْكَسَلْ",66,"ل",1,0],["إنْ أظهرَ المُشْتَهَى منِّي صبابَتَهُ","أطبَقْتُ صدريْ على الأنسامِ لمْ أزلِ",67,"ل",1,0]]}