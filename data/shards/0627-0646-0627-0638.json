{"poems":[[73,"أنا ظرف للهو كل ظريف","https://www.aldiwan.net/poem11989.html","الخفيف"],[93,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[85,"عش للخلافة ترضاها وترضيها","https://www.aldiwan.net/poem7528.html","البسيط"],[97,"نداؤك يا فؤاد كفى نداء","https://www.aldiwan.net/poem25073.html","الوافر"],[133,"من لي إذا ما استقل الركب أو سارا","https://www.aldiwan.net/poem48842.html","البسيط"],[184,"حظي من النوم بعد الهجعة الأرق","https://www.aldiwan.net/poem43553.html","البسيط"],[209,"تلقيت من روح الجمال رسالة","https://www.aldiwan.net/poem46317.html","الطويل"],[233,"يا صاحبي لمن هذه","https://www.aldiwan.net/poem32116.html","المجتث"],[278,"لو كنت شاهد عبرتي يوم النقا","https://www.aldiwan.net/poem60695.html","الكامل"],[278,"ويوم أخذنا به فرصة","https://www.aldiwan.net/poem60709.html","المتقارب"],[326,"أنا سر الجنون قبل الجنون","https://www.aldiwan.net/poem54934.html","الخفيف"],[364,"إن أظلمت للنفس فيها ليلة","https://www.aldiwan.net/poem17941.html","الكامل"],[403,"الليل حيث حللن فيه نهار","https://www.aldiwan.net/poem50176.html","الكامل"],[438,"أريحي الوجا يا ناق ما بعد ذا وجا","https://www.aldiwan.net/poem14299.html","الطويل"],[456,"ما كنت لولا طمعي في الخيال","https://www.aldiwan.net/poem55936.html","السريع"],[513,"أصبت في خير أعضائي وأعضادي","https://www.aldiwan.net/poem12069.html","البسيط"],[513,"رمى بنا الثغر كما ترمى الثغر","https://www.aldiwan.net/poem12162.html","الرجز"],[527,"ما لبسك الديباج والتاج مع","https://www.aldiwan.net/poem37420.html","السريع"],[549,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[556,"من مات يعلم أنك الحق المبين","https://www.aldiwan.net/poem33797.html","الكامل"],[573,"تلاقى تلاقي سورة ليس تعلم","https://www.aldiwan.net/poem2857.html","الطويل"],[573,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"],[584,"أضحى له في اكتئابه سبب","https://www.aldiwan.net/poem17411.html","المنسرح"]],"verses":[["أَنا ظَرفٌ لِلَهوِ كُلِّ ظَريفِ","أَنا مُستَودَعٌ لِعِلقٍ شَريفِ",0,"ف",1,1],["أَنَاظِرٌ أَنْتَ لَمَّا هَمَّ كيْفَ خَطَا","مِنَ الصَّفَا غَيْرَ مُعْتَاقٍ وَلا عَانِ",1,"ن",1,0],["إن أظمت الحرب كانوا البيد ظامئة","أو أعرت الحرب كانوا هم عواليها",2,"ي",3,0],["أنا ظمآن لم يلمع سراب","على الصحراء إلا خلتُ ماءَ",3,"ا",2,0],["إن أظهر الجمع ما بي من جوايَ فقد","أضمرتُه في سوادِ القلبِ إضمارا",4,"ر",2,0],["إن أظهروا النسك في تلبيس ظاهرهم","فالثوب يطوى وفي أثنائه حرق",5,"ق",1,0],["أناظرهُ روحا لروح كأنني","أراك ومن لألاء وجهك أنهَل",6,"ل",1,0],["إِن أَظلَمَ الخَطبُ","فَالشُهبُ أَنتُمُ وَالمَصابِح",7,"ح",1,0],["إِنْ أَظْلَمَتْ كُنْتَ الضَّحاءَ الْمُجْتَلى","أَوْ أَجْدَبَتْ كُنْتَ الرَّبِيعَ الْمُغْدِقا",8,"ق",2,0],["إِنْ أَظْلَمَتْ تِلْكَ السَّماءُ فَقَدْ خَلا","مِنْ بَدْرِها الأَبْهى مكانُ الْمَطْلَعِ",9,"ع",1,0],["أنا ظل الهوى القديم ومعنا","ه ومجلى جماله المكنون",10,"ن",1,0],["إِن أَظلَمَت لِلنَفسِ فيها لَيلَةٌ","قَمَرُ المَعاني عِندَنا سِمسارُها",11,"ه",2,1],["إِن أَظلمت قطع الرِياض أَضالَها","نُوّارِها فَكَأَنَّها الأَنوارُ",12,"ر",1,0],["أناظر دب النمل والنمل أسود","بليل كعين الظبي أسود قد دجا",13,"ج",2,0],["إن أظلم الدهر فعزْماتُه","تَوَقُّدٌ في أفقه واشتعالْ",14,"ل",1,0],["إن أظلم الجو في عيني فقد فجعت","بكوكب في سماء المجد أوقد",15,"د",1,0],["إن أظلمت أيامنا بفقده","ففي الدجى يعرف مقدار القمر",16,"ر",1,0],["إنْ أظْلَمَ الإشْكالُ قابَلْتَهُ","بالضَّوْءِ تَغْدُو عِنْدَ ذَا مُبْصِرا",17,"ر",2,0],["أَنا ظامٍ وليس أَنقع أَن أُب","صِرَ عَيني في الخلقِ إلّا الشّرارا",18,"ر",2,0],["أنا ظلمة ظهرت بنور محمد","ومحمد نور بنورك مستبينْ",19,"ن",1,0],["أَناظِرُه في الهجر كيف استَجازَه","فيذكرُ بعضَ الحُسْنِ لي فأُسَلِّم",20,"م",1,0],["إِنْ أَظْلَمَ الخَطْبُ المُلِمُّ","فرأْيُه مثلُ الشِّهابِ",21,"ب",1,0],["إِنْ أَظْلَمَ الدَّهْرُ ضَاءَ حُسْنُهُم","وَإِنْ أُمِرَّت أَيَّامُنَا عَذُبُوا",22,"ب",3,0]]}