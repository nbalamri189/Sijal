{"poems":[[55,"يا أبا الفضل هيجتك الرسوم","https://www.aldiwan.net/poem26139.html","الخفيف"],[73,"خنت عهدي ولم أخن","https://www.aldiwan.net/poem11969.html","مجزوء الخفيف"],[30,"ألم تسأل اليوم الرسوم الدوارس","https://www.aldiwan.net/poem29577.html","الطويل"],[27,"خنازير ناموا عن المكرمات","https://www.aldiwan.net/poem4452.html","المتقارب"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[72,"إن طيفا عن حال شجواي أملى","https://www.aldiwan.net/poem20543.html","الخفيف"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[51,"أرضى بصورته وصد فأغضبا","https://www.aldiwan.net/poem8652.html","الكامل"],[51,"صبحة النوروز في الأحد","https://www.aldiwan.net/poem61831.html","المديد"],[51,"يا تناه والتناهي انقطاع","https://www.aldiwan.net/poem65423.html","المديد"],[29,"لقد جارى أبو ليلى بقحم","https://www.aldiwan.net/poem6166.html","الوافر"],[78,"درا بعثت مفصلا بجمان","https://www.aldiwan.net/poem14038.html","الكامل"],[78,"كذبت مناكم صرحوا أو جمجموا","https://www.aldiwan.net/poem14191.html","الكامل"],[56,"لك نفس مواتيه","https://www.aldiwan.net/poem58481.html","مجزوء الخفيف"],[56,"قل لمن كان وجهه كضياء","https://www.aldiwan.net/poem58576.html","الخفيف"],[56,"في خده خال كأن","https://www.aldiwan.net/poem58605.html","مجزوء الكامل"],[43,"باد هواك صبرت أم لم تصبرا","https://www.aldiwan.net/poem9608.html","الكامل"],[45,"قد مررنا بزحول يوم دجن","https://www.aldiwan.net/poem66675.html","الخفيف"],[28,"ستبلغ عني غدوة الريح أنها","https://www.aldiwan.net/poem5558.html","الطويل"],[61,"صفر مدار تضمها شرف","https://www.aldiwan.net/poem51636.html","المنسرح"],[66,"عاطنيها ممزوجة بالنبات","https://www.aldiwan.net/poem38643.html","الخفيف"],[66,"دق شوال في قفا رمضان","https://www.aldiwan.net/poem39193.html","الخفيف"],[80,"أشهاب في دجى الليل ثقب","https://www.aldiwan.net/poem31545.html","الرمل"],[105,"داء أهل الشرق ضعف الهمم","https://www.aldiwan.net/poem43409.html","الرمل"],[52,"أيا من مات من شوق","https://www.aldiwan.net/poem26802.html","الهزج"],[52,"من معيني على السهر","https://www.aldiwan.net/poem27000.html","مجزوء الخفيف"],[48,"وعقار كأنما نتعاطى","https://www.aldiwan.net/poem62484.html","الخفيف"],[48,"بادر الكأس نهارا","https://www.aldiwan.net/poem63275.html","مجزوء الرمل"],[48,"إذا ما كنت عند قيان موسى","https://www.aldiwan.net/poem63385.html","الوافر"],[48,"نبه نديمك قد نعس","https://www.aldiwan.net/poem64328.html","مجزوء الكامل"],[48,"قل لذي الوجه الرقيق","https://www.aldiwan.net/poem64430.html","مجزوء الرمل"],[48,"خلق الشباب وشرتي لم تخلق","https://www.aldiwan.net/poem64445.html","الكامل"],[8,"خليلي عوجا ساعة وتهجرا","https://www.aldiwan.net/poem21785.html","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43748","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43838","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43712","الخفيف"],[100,"حزبية.. ومخبرون","https://www.poetsgate.com/ViewPoem.aspx?id=183586",""],[45,"قَدْ مَرَرْنَا بِزَحْوَلٍ يَوْمَ دَجْنٍ","https://www.poetsgate.com/ViewPoem.aspx?id=31872",""],[78,"كَذبَتْ مُناكُم، صَرّحوا أَو جَمْجِموا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86640&r=&rc=135",""]],"verses":[["خَندَقَت حَولَ قَلبِهِ بِالصَبابا","تِ فَما حَولَهُ حِمىً مَكلومُ",0,"م",1,0],["خُنتَ عَهدي وَلَم أَخُن","بِعتَ وُدّي بِلا ثَمَن",1,"ن",1,1],["خَناطيلُ يَستَقرينَ كُلَّ قَرارَةٍ","مَرَبٍّ نَفَت عَنها الغُثاءَ الرَوائِسُ",2,"س",1,0],["خَنازيرَ ناموا عَنِ المَكرُماتِ","فَنَبَّهَهُم قَدَرٌ لَم يَنَمِ",3,"م",1,1],["خَنساءُ ضَيَّعَتِ الفَريرَ فَلَم يَرِم","عُرضَ الشَقائِقِ طَوفُها وَبُغامُها",4,"م",3,0],["خنت عهدي ولست أوَّل خلٍّ","خانَ بعد الولاء والودّ خلاَّ",5,"ل",2,0],["خنَّثْتَ أَرْجَلَ مَنْ مَشى","ونسيتَ خُنْثَكَ يا تُرابهْ",6,"ب",2,0],["خَنْدَريس إذا تراخت مَداها","لبست جِدّةً على الأحقابِ",7,"ب",1,0],["خَنِث الدلال إذا تَبهنَس أوثَقَتْ","حركاتُه وإذ تكلَّم أطربا",8,"ب",2,0],["خنْدريس عُتِّقت فغدت","من بنات الكرم والأبدِ",9,"د",1,0],["خنه ما أعطاك معطي العطايا","مثلما خان السحاب انقشاع",10,"ع",1,0],["خَنافِسُ أَدلَجَت لِمَبيتِ سوءٍ","وَرِثنَ فِراشَ زانِيَةٍ وَزاني",11,"ن",2,0],["خَنِثٍ يَسقيني المُدام بطُرفه","وَبِكَفِّهِ وَمَتى أَشأ غَنّاني",12,"ن",2,0],["خُنتُم وَرُمتُم أن أَخون وَرُبَّما","حاوَلتُمُ أَن يُستَخَفَّ يَلَملَمُ",13,"م",1,0],["خُنْتِ سِرِّي ولَمْ أَخُنْ","كِ فَمُوتي عَلانِيَهْ",14,"ن",3,0],["خُنْتَني في المَغِيبِ والخَوْنُ نُكْرٌ","وذَمِيمٌ في سَالفاتِ الدُّهُورِ",15,"ر",1,0],["خَنِثٌ كأنَّ اللّهَ أَلْ","بَسَهُ قُشُورَ الدُّرِّ جِلْدَا",16,"د",2,0],["خَنثى الفُحولَ مِنَ الكُماةِ بِصَبغِهِ","ما يَلبَسونَ مِنَ الحَديدِ مُعَصفَرا",17,"ر",2,0],["خُنفَساءٌ أَعمَت مِنَ القُبحِ عَيني","وَأَصَمَّت بِسَيِّئِ القَولِ أُذني",18,"ي",1,0],["خَناذيذَ يَنميها لَأَعوَجَ مُشرِفٌ","عَلى الخَيلِ حَطّامٌ فُؤوسَ الشَكائِمِ",19,"م",1,0],["خَناجرٌ من حَناجرٍ نُزِعَتْ","فهي على الماءِ من دمٍ حُمْرُ",20,"ر",1,0],["خَندَريساً دِنانُها حُقَقُ العا","جِ وَراحاً كُؤوسُها راحاتي",21,"ي",1,0],["خَندَريساً تَكادُ تَفعَلُ بِالعَق","لِ فِعلَ النُعاسِ بِالأَجفانِ",22,"ن",1,0],["خندريسٌ عُتّقَتْ في أجوَفٍ","من دم العُنقودٍ مملوءٍ نُخَبْ",23,"ب",1,0],["خُنتُمُ العَهدَ فَبِتُّم نُوَّماً","ضَلَّ سَعيُ الخائِنينَ النُوَّمِ",24,"م",1,0],["خَنَقتَ الكَبشَ حَتّى كا","دَ لا يَبقى لَهُ خَلَقُ",25,"ق",1,0],["خَنجَرِيُّ اليَمينِ إِن","سِمتَهُ قُبلَةً نَفَر",26,"ر",1,0],["خَندَريسٌ كَأَنَّها كُلُّ طيبٍ","زَوَّجوها وَلَيسَ تَهوى الزَواجا",27,"ج",2,0],["خَندَريساً تَنفَحُ المِس","كَ وَتَحكي الجُلَّنارا",28,"ر",2,0],["خَنافِسُ خَلفَ عيدانٍ قُعودٌ","يُطَوِّلُ قُربَها اليَومَ القَصيرا",29,"ر",2,0],["خَنِثُ الجُفونِ كَأَنَّهُ","ظَبيُ الرِياضِ إِذا نَعِس",30,"س",1,0],["خَندَريسٌ عَطِرُ النَك","هَةِ كَالمِسكِ السَحيقِ",31,"ق",1,0],["خَنساءُ تَرعى جَوذَراً بِخَميلَةٍ","وَبِها إِلَيهِ صَبابَةٌ كَالأَولَقِ",32,"ق",1,0],["خَنُوفٍ مَرُوحٍ تُعجِلُ الوُرقَ بَعدَما","تُعَرِّسُ تَشكُو آهةً وتذمُّرا",33,"ر",2,0],["خُنتُ إِذا لَم أبادِ في كُلِّ بادٍ","كُلَّ حِلٍّ مِنَ العَزاءِ حَرامُ",34,"م",1,0],["خُنتُكَ إِن عُدتَ لِاِدِّكاري","لَيالي الكَرخِ أَو أضاخِ",35,"خ",1,0],["خُنتُ مَولايَ وَلَم أَنصَح لَهُ","لَو سَعى العَبدُ بِنُصحٍ لَعَتَق",36,"ق",1,0],["خُنتَني في اِبني الَّذي هُوَ بَعضي","بَل وَفى اللَهُ فَاِبتَلى وَسَيَجزي",37,"ي",1,0],["خنقوا خط هاتفي مِن حشاهُ","وتقصّوا زفيره وشهيقي",38,"ق",2,0],["خُنْفَسَاءٌ أَعْمَتْ مِنَ الْفُبْحِ عَيْنِي","وأَصَمَّتْ بِسَيِّىءِ الْقَوْلِ أُذْنِي",39,"ن",2,0],["خُنتُم وَرُمتُم أن أَخُون وَإنّما","حاوَلتُمُ أَن يُستَخَفَّ يَلَملَمُ",40,"م",1,0]]}