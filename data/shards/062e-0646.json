{"poems":[[55,"يا أبا الفضل هيجتك الرسوم","https://www.aldiwan.net/poem26139.html","الخفيف"],[73,"خنت عهدي ولم أخن","https://www.aldiwan.net/poem11969.html","مجزوء الخفيف"],[30,"ألم تسأل اليوم الرسوم الدوارس","https://www.aldiwan.net/poem29577.html","الطويل"],[27,"خنازير ناموا عن المكرمات","https://www.aldiwan.net/poem4452.html","المتقارب"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[72,"إن طيفا عن حال شجواي أملى","https://www.aldiwan.net/poem20543.html","الخفيف"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[51,"أرضى بصورته وصد فأغضبا","https://www.aldiwan.net/poem8652.html","الكامل"],[51,"صبحة النوروز في الأحد","https://www.aldiwan.net/poem61831.html","المديد"],[51,"يا تناه والتناهي انقطاع","https://www.aldiwan.net/poem65423.html","المديد"],[29,"لقد جارى أبو ليلى بقحم","https://www.aldiwan.net/poem6166.html","الوافر"],[78,"درا بعثت مفصلا بجمان","https://www.aldiwan.net/poem14038.html","الكامل"],[78,"كذبت مناكم صرحوا أو جمجموا","https://www.aldiwan.net/poem14191.html","الكامل"],[56,"لك نفس مواتيه","https://www.aldiwan.net/poem58481.html","مجزوء الخفيف"],[56,"قل لمن كان وجهه كضياء","https://www.aldiwan.net/poem58576.html","الخفيف"],[56,"في خده خال كأن","https://www.aldiwan.net/poem58605.html","مجزوء الكامل"],[43,"باد هواك صبرت أم لم تصبرا","https://www.aldiwan.net/poem9608.html","الكامل"],[45,"قد مررنا بزحول يوم دجن","https://www.aldiwan.net/poem66675.html","الخفيف"],[28,"ستبلغ عني غدوة الريح أنها","https://www.aldiwan.net/poem5558.html","الطويل"],[61,"صفر مدار تضمها شرف","https://www.aldiwan.net/poem51636.html","المنسرح"],[66,"عاطنيها ممزوجة بالنبات","https://www.aldiwan.net/poem38643.html","الخفيف"],[66,"دق شوال في قفا رمضان","https://www.aldiwan.net/poem39193.html","الخفيف"],[80,"أشهاب في دجى الليل ثقب","https://www.aldiwan.net/poem31545.html","الرمل"],[105,"داء أهل الشرق ضعف الهمم","https://www.aldiwan.net/poem43409.html","الرمل"],[52,"أيا من مات من شوق","https://www.aldiwan.net/poem26802.html","الهزج"],[52,"من معيني على السهر","https://www.aldiwan.net/poem27000.html","مجزوء الخفيف"],[48,"وعقار كأنما نتعاطى","https://www.aldiwan.net/poem62484.html","الخفيف"],[48,"بادر الكأس نهارا","https://www.aldiwan.net/poem63275.html","مجزوء الرمل"],[48,"إذا ما كنت عند قيان موسى","https://www.aldiwan.net/poem63385.html","الوافر"],[48,"نبه نديمك قد نعس","https://www.aldiwan.net/poem64328.html","مجزوء الكامل"],[48,"قل لذي الوجه الرقيق","https://www.aldiwan.net/poem64430.html","مجزوء الرمل"],[48,"خلق الشباب وشرتي لم تخلق","https://www.aldiwan.net/poem64445.html","الكامل"],[8,"خليلي عوجا ساعة وتهجرا","https://www.aldiwan.net/poem21785.html","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43748","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43838","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43712","الخفيف"],[100,"حزبية.. ومخبرون","https://www.poetsgate.com/ViewPoem.aspx?id=183586",""],[45,"قَدْ مَرَرْنَا بِزَحْوَلٍ يَوْمَ دَجْنٍ","https://www.poetsgate.com/ViewPoem.aspx?id=31872",""],[78,"كَذبَتْ مُناكُم، صَرّحوا أَو جَمْجِموا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86640&r=&rc=135",""],[130,"عجبت لأسرة الحسن الدينا","https://www.aldiwan.net/poem54720.html","الوافر"],[141,"عوضونا من السهاد الرقادا","https://www.aldiwan.net/poem11742.html","الخفيف"],[141,"شرف الملوك عدت معاليك المدى","https://www.aldiwan.net/poem11752.html","الكامل"],[148,"خنازير ناموا عن المكرمات","https://www.aldiwan.net/poem68609.html","المتقارب"],[162,"خامرت قلبه هموم تلظت","https://www.aldiwan.net/poem67871.html","الخفيف"],[167,"بع واسطاً بالنأي والهجر","https://www.aldiwan.net/poem1629.html",""],[183,"والله لو صح عندي أن هجركم","https://www.aldiwan.net/poem14644.html","البسيط"],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[190,"اصبح قلبي بربخا للهوى","https://www.aldiwan.net/poem27467.html","السريع"],[202,"سيدي لم خدعتني بالتمني","https://www.aldiwan.net/poem53167.html","الخفيف"],[252,"ليت شعري","https://www.aldiwan.net/poem24963.html","مجزوء الرمل"],[267,"غضب الأحمق إذ مازحته","https://www.aldiwan.net/poem26459.html","الرمل"],[326,"فوق هذي الربا أقمت وحيدا","https://www.aldiwan.net/poem54989.html","الخفيف"],[343,"فقمت إلى بلهاء ذات علالة","https://www.aldiwan.net/poem4474.html","الكامل"],[351,"يا سرورا على القلوب تجلى","https://www.aldiwan.net/poem39588.html","الخفيف"],[359,"يا نديمي قسم بي الى الصهباء","https://www.aldiwan.net/poem68143.html","الخفيف"],[374,"يا نسيما نراه يروي الغليلا","https://www.aldiwan.net/poem59174.html","الخفيف"],[374,"قلب يقلبه النوى","https://www.aldiwan.net/poem59383.html","مجزوء الكامل"],[377,"لبيك داعية الغرام","https://www.aldiwan.net/poem49199.html","مجزوء الكامل"],[377,"مزجت دموع جفونه بدماء","https://www.aldiwan.net/poem49210.html","الكامل"],[397,"وهج الحب","https://www.aldiwan.net/poem6703.html","عموديه"],[413,"ما لها مفرية بيدا فبيدا","https://www.aldiwan.net/poem53936.html","الرمل"],[429,"ها قد علمت صحيح ودي","https://www.aldiwan.net/poem12510.html","مجزوء الكامل"],[441,"نقل الطرف في ربوع الأمان","https://www.aldiwan.net/poem55974.html","عموديه"],[450,"أورى الهوى بحشاي زندا","https://www.aldiwan.net/poem13712.html","مجزوء الكامل"],[450,"صح واني نسيمنا باعتلاله","https://www.aldiwan.net/poem13878.html","الخفيف"],[451,"منبري عالمي وليس بأرض","https://www.aldiwan.net/poem61277.html","الخفيف"],[456,"خنساء همي وذكرها أنسي","https://www.aldiwan.net/poem56154.html","المنسرح"],[462,"كأنما الطلع إذا لاح","https://www.aldiwan.net/poem3346.html","عموديه"],[512,"حتام أسألها الدنو فتنزح","https://www.aldiwan.net/poem20804.html","الكامل"]],"verses":[["خَندَقَت حَولَ قَلبِهِ بِالصَبابا","تِ فَما حَولَهُ حِمىً مَكلومُ",0,"م",1,0],["خُنتَ عَهدي وَلَم أَخُن","بِعتَ وُدّي بِلا ثَمَن",1,"ن",1,1],["خَناطيلُ يَستَقرينَ كُلَّ قَرارَةٍ","مَرَبٍّ نَفَت عَنها الغُثاءَ الرَوائِسُ",2,"س",1,0],["خَنازيرَ ناموا عَنِ المَكرُماتِ","فَنَبَّهَهُم قَدَرٌ لَم يَنَمِ",3,"م",1,1],["خَنساءُ ضَيَّعَتِ الفَريرَ فَلَم يَرِم","عُرضَ الشَقائِقِ طَوفُها وَبُغامُها",4,"م",3,0],["خنت عهدي ولست أوَّل خلٍّ","خانَ بعد الولاء والودّ خلاَّ",5,"ل",2,0],["خنَّثْتَ أَرْجَلَ مَنْ مَشى","ونسيتَ خُنْثَكَ يا تُرابهْ",6,"ب",2,0],["خَنْدَريس إذا تراخت مَداها","لبست جِدّةً على الأحقابِ",7,"ب",1,0],["خَنِث الدلال إذا تَبهنَس أوثَقَتْ","حركاتُه وإذ تكلَّم أطربا",8,"ب",2,0],["خنْدريس عُتِّقت فغدت","من بنات الكرم والأبدِ",9,"د",1,0],["خنه ما أعطاك معطي العطايا","مثلما خان السحاب انقشاع",10,"ع",1,0],["خَنافِسُ أَدلَجَت لِمَبيتِ سوءٍ","وَرِثنَ فِراشَ زانِيَةٍ وَزاني",11,"ن",2,0],["خَنِثٍ يَسقيني المُدام بطُرفه","وَبِكَفِّهِ وَمَتى أَشأ غَنّاني",12,"ن",2,0],["خُنتُم وَرُمتُم أن أَخون وَرُبَّما","حاوَلتُمُ أَن يُستَخَفَّ يَلَملَمُ",13,"م",1,0],["خُنْتِ سِرِّي ولَمْ أَخُنْ","كِ فَمُوتي عَلانِيَهْ",14,"ن",3,0],["خُنْتَني في المَغِيبِ والخَوْنُ نُكْرٌ","وذَمِيمٌ في سَالفاتِ الدُّهُورِ",15,"ر",1,0],["خَنِثٌ كأنَّ اللّهَ أَلْ","بَسَهُ قُشُورَ الدُّرِّ جِلْدَا",16,"د",2,0],["خَنثى الفُحولَ مِنَ الكُماةِ بِصَبغِهِ","ما يَلبَسونَ مِنَ الحَديدِ مُعَصفَرا",17,"ر",2,0],["خُنفَساءٌ أَعمَت مِنَ القُبحِ عَيني","وَأَصَمَّت بِسَيِّئِ القَولِ أُذني",18,"ي",1,0],["خَناذيذَ يَنميها لَأَعوَجَ مُشرِفٌ","عَلى الخَيلِ حَطّامٌ فُؤوسَ الشَكائِمِ",19,"م",1,0],["خَناجرٌ من حَناجرٍ نُزِعَتْ","فهي على الماءِ من دمٍ حُمْرُ",20,"ر",1,0],["خَندَريساً دِنانُها حُقَقُ العا","جِ وَراحاً كُؤوسُها راحاتي",21,"ي",1,0],["خَندَريساً تَكادُ تَفعَلُ بِالعَق","لِ فِعلَ النُعاسِ بِالأَجفانِ",22,"ن",1,0],["خندريسٌ عُتّقَتْ في أجوَفٍ","من دم العُنقودٍ مملوءٍ نُخَبْ",23,"ب",1,0],["خُنتُمُ العَهدَ فَبِتُّم نُوَّماً","ضَلَّ سَعيُ الخائِنينَ النُوَّمِ",24,"م",1,0],["خَنَقتَ الكَبشَ حَتّى كا","دَ لا يَبقى لَهُ خَلَقُ",25,"ق",1,0],["خَنجَرِيُّ اليَمينِ إِن","سِمتَهُ قُبلَةً نَفَر",26,"ر",1,0],["خَندَريسٌ كَأَنَّها كُلُّ طيبٍ","زَوَّجوها وَلَيسَ تَهوى الزَواجا",27,"ج",2,0],["خَندَريساً تَنفَحُ المِس","كَ وَتَحكي الجُلَّنارا",28,"ر",2,0],["خَنافِسُ خَلفَ عيدانٍ قُعودٌ","يُطَوِّلُ قُربَها اليَومَ القَصيرا",29,"ر",2,0],["خَنِثُ الجُفونِ كَأَنَّهُ","ظَبيُ الرِياضِ إِذا نَعِس",30,"س",1,0],["خَندَريسٌ عَطِرُ النَك","هَةِ كَالمِسكِ السَحيقِ",31,"ق",1,0],["خَنساءُ تَرعى جَوذَراً بِخَميلَةٍ","وَبِها إِلَيهِ صَبابَةٌ كَالأَولَقِ",32,"ق",1,0],["خَنُوفٍ مَرُوحٍ تُعجِلُ الوُرقَ بَعدَما","تُعَرِّسُ تَشكُو آهةً وتذمُّرا",33,"ر",2,0],["خُنتُ إِذا لَم أبادِ في كُلِّ بادٍ","كُلَّ حِلٍّ مِنَ العَزاءِ حَرامُ",34,"م",1,0],["خُنتُكَ إِن عُدتَ لِاِدِّكاري","لَيالي الكَرخِ أَو أضاخِ",35,"خ",1,0],["خُنتُ مَولايَ وَلَم أَنصَح لَهُ","لَو سَعى العَبدُ بِنُصحٍ لَعَتَق",36,"ق",1,0],["خُنتَني في اِبني الَّذي هُوَ بَعضي","بَل وَفى اللَهُ فَاِبتَلى وَسَيَجزي",37,"ي",1,0],["خنقوا خط هاتفي مِن حشاهُ","وتقصّوا زفيره وشهيقي",38,"ق",2,0],["خُنْفَسَاءٌ أَعْمَتْ مِنَ الْفُبْحِ عَيْنِي","وأَصَمَّتْ بِسَيِّىءِ الْقَوْلِ أُذْنِي",39,"ن",2,0],["خُنتُم وَرُمتُم أن أَخُون وَإنّما","حاوَلتُمُ أَن يُستَخَفَّ يَلَملَمُ",40,"م",1,0],["خُنُوا عَهد جَارِكُمُ وكُونُوا","لَهُ في كُلِّ خِصبٍ مُحرِمينَا",41,"ن",2,0],["خَنَعوا وَاِنتَخى وَعَزَّ وَذَلّوا","وَهَوَوا وَاِعتَلى وَضَنّوا وَجادا",42,"د",2,0],["خَنَعوا فَما اِمتَنَعوا فَكَيفَ بِهِم إِذا","زُرتَ الخَليجَ بِكُلِّ أَسمَرَ أَملَدا",43,"د",2,0],["خَنازيرُ ناموا عَنِ المَكرُماتِ","فَأَنبَهَهُم قَدَرٌ لَم يَنَم",44,"م",1,1],["خُنتَ مَن لَو دَعَوتَهُ وَهوَ مَيتٌ","ظَلَّ يُصغي مُسارِعاً وَيُصيخُ",45,"خ",1,0],["خُنتَ الخَليفَةَ في رَعِيَّتِهِ","وَعَصَيتَهُ في السِرِّ وَالجَهرِ",46,"ر",1,0],["خُنتم فلم يبقَ لي في وصلكم طمعٌ","يُرْجَى وهذا فؤادي في ابتداء العمل",47,"ل",1,0],["خَندَقوا حولَهم وكم معجزاتٍ","شاهَدوها فكانَ فيها عزاءُ",48,"ا",2,0],["خَنافِسُ الهِجرانِ أَثكَلنَني","يَومَ تَوَلّى معرَضا صَبري",49,"ر",2,0],["خنتَ عهدي وقد تبدَّلتَ بعدي","يا حبيبي ما كان ذلك ظنّي",50,"ن",2,0],["خُنتَ يا من كنتَ فجري","لم يعدْ لي بعدُ فجرا!",51,"ر",2,0],["خُنفُساوانِ وَبِنتا جُعَلٍ","وَالَّتي تَفتَرُّ عَنها وَزَغَه",52,"غ",2,0],["خَنَق الطين والظلام حِجانا","فعمينا وما هدانا هوانا",53,"ن",2,0],["خَناجِرَ شُدقاً بَينَ حَمضٍ وَخُلَّةٍ","مَجاليحُ في المَشتى ثِقالَ الكَراكِر",54,"ر",1,0],["خندريساً تروي بِطيب شَذاها","خَبَراً صحَّ عَن رُضابِك نَقلا",55,"ل",2,0],["خنث أَذعج كَحيل جَميل","يَتثنى بِقامَة صعداء",56,"ا",2,0],["خنتُ ما قد وعدتُه بكلامي","بفعالي فكنت فيه دخيلا",57,"ل",2,0],["خَنَست له أفكاره","والصلُّ مؤذٍ وهو خانس",58,"س",1,0],["خنت الشرئل مَطمع","متمنع صَعب المَرام",59,"م",1,0],["خنث المَفاصل مطمع متمنع","مُتناسب الحَركات وَالأَعضاءِ",60,"ا",2,0],["خندق واحدٌ كبيرٌ، وقفن","فيه، نرجو الخلاصَ ممَّآ ابتُلينا",61,"ن",2,0],["خُنْتُمُ عَهْدَ الهُدى ما بيننا","وَرَعَيْنا لكمُ فيها عهودا",62,"د",2,0],["خُنتَ الإخاءَ فشِمْتَ عضْ","بَ الهَجْو شيمةَ كلِّ وغْدِ",63,"د",1,0],["خندققوا القصر بالحديقة والما","ء لديهم يجري بكل مكان",64,"ن",1,0],["خَنِثُ المعاطف قد حكا","ه الغصن أعطافاً وقدا",65,"د",2,0],["خَنِثُ الملتوى رخيمُ المباني","جال ماءُ النعيمِ في أوصاله",66,"ل",2,0],["خنقتني أو حاولت ثم باهت","بأذاتي تلك النفوس الصغار",67,"ر",1,0],["خنساءُ همّي وذكُرها أنسي","إذا أمانيَّ حدَّثتْ نفسي",68,"ي",1,1],["خناجرٌ فوق أعا","ليها بقايا الكلف",69,"ف",1,0],["خُنتُ التُّقى وقطعتُ أرحامَ العُلا","إن لمْ أَعُقْ في حبِّها مَنْ ينصَحُ",70,"ح",1,0]]}