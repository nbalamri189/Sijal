لٍّ","خانَ بعد الولاء والودّ خلاَّ",5,"ل",2,0],["خنَّثْتَ أَرْجَلَ مَنْ مَشى","ونسيتَ خُنْثَكَ يا تُرابهْ",6,"ب",2,0],["خَنْدَريس إذا تراخت مَداها","لبست جِدّةً على الأحقابِ",7,"ب",1,0],["خَنِث الدلال إذا تَبهنَس أوثَقَتْ","حركاتُه وإذ تكلَّم أطربا",8,"ب",2,0],["خنْدريس عُتِّقت فغدت","من بنات الكرم والأبدِ",9,"د",1,0],["خنه ما أعطاك معطي العطايا","مثلما خان السحاب انقشاع",10,"ع",1,0],["خَنافِسُ أَدلَجَت لِمَبيتِ سوءٍ","وَرِثنَ فِراشَ زانِيَةٍ وَزاني",11,"ن",2,0],["خَنِثٍ يَسقيني المُدام بطُرفه","وَبِكَفِّهِ وَمَتى أَشأ غَنّاني",12,"ن",2,0],["خُنتُم وَرُمتُم أن أَخون وَرُبَّما","حاوَلتُمُ أَن يُستَخَفَّ يَلَملَمُ",13,"م",1,0],["خُنْتِ سِرِّي ولَمْ أَخُنْ","كِ فَمُوتي عَلانِيَهْ",14,"ن",3,0],["خُنْتَني في المَغِيبِ والخَوْنُ نُكْرٌ","وذَمِيمٌ في سَالفاتِ الدُّهُورِ",15,"ر",1,0],["خَنِثٌ كأنَّ اللّهَ أَلْ","بَسَهُ قُشُورَ الدُّرِّ جِلْدَا",16,"د",2,0],["خَنثى الفُحولَ مِنَ الكُماةِ بِصَبغِهِ","ما يَلبَسونَ مِنَ الحَديدِ مُعَصفَرا",17,"ر",2,0],["خُنفَساءٌ أَعمَت مِنَ القُبحِ عَيني","وَأَصَمَّت بِسَيِّئِ القَولِ أُذني",18,"ن",2,0],["خَناذيذَ يَنميها لَأَعوَجَ مُشرِفٌ","عَلى الخَيلِ حَطّامٌ فُؤوسَ الشَكائِمِ",19,"م",1,0],["خَناجرٌ من حَناجرٍ نُزِعَتْ","فهي على الماءِ من دمٍ حُمْرُ",20,"ر",1,0],["خَندَريساً دِنانُها حُقَقُ العا","جِ وَراحاً كُؤوسُها راحاتي",21,"ت",2,0],["خَندَريساً تَكادُ تَفعَلُ بِالعَق","لِ فِعلَ النُعاسِ بِالأَجفانِ",22,"ن",1,0],["خندريسٌ عُتّقَتْ في أجوَفٍ","من دم العُنقودٍ مملوءٍ نُخَبْ",23,"ب",1,0],["خُنتُمُ العَهدَ فَبِتُّم نُوَّماً","ضَلَّ سَعيُ الخائِنينَ النُوَّمِ",24,"م",1,0],["خَنَقتَ الكَبشَ حَتّى كا","دَ لا يَبقى لَهُ خَلَقُ",25,"ق",1,0],["خَنجَرِيُّ اليَمينِ إِن","سِمتَهُ قُبلَةً نَفَر",26,"ر",1,0],["خَندَريسٌ كَأَنَّها كُلُّ طيبٍ","زَوَّجوها وَلَيسَ تَهوى الزَواجا",27,"ج",2,0],["خَندَريساً تَنفَحُ المِس","كَ وَتَحكي الجُلَّنارا",28,"ر",2,0],["خَنافِسُ خَلفَ عيدانٍ قُعودٌ","يُطَوِّلُ قُربَها اليَومَ القَصيرا",29,"ر",2,0],["خَنِثُ الجُفونِ كَأَنَّهُ","ظَبيُ الرِياضِ إِذا نَعِس",30,"س",1,0],["خَندَريسٌ عَطِرُ النَك","هَةِ كَالمِسكِ السَحيقِ",31,"ق",1,0],["خَنساءُ تَرعى جَوذَراً بِخَميلَةٍ","وَبِها إِلَيهِ صَبابَةٌ كَالأَولَقِ",32,"ق",1,0],["خَنُوفٍ مَرُوحٍ تُعجِلُ الوُرقَ بَعدَما","تُعَرِّسُ تَشكُو آهةً وتذمُّرا",33,"ر",2,0],["خُنتُ إِذا لَم أبادِ في كُلِّ بادٍ","كُلَّ حِلٍّ مِنَ العَزاءِ حَرامُ",34,"م",1,0],["خُنتُكَ إِن عُدتَ لِاِدِّكاري","لَيالي الكَرخِ أَو أضاخِ",35,"خ",1,0],["خُنتُ مَولايَ وَلَم أَنصَح لَهُ","لَو سَعى العَبدُ بِنُصحٍ لَعَتَق",36,"ق",1,0],["خُنتَني في اِبني الَّذي هُوَ بَعضي","بَل وَفى اللَهُ فَاِبتَلى وَسَيَجزي",37,"ز",2,0],["خنقوا خط هاتفي مِن حشاهُ","وتقصّوا زفيره وشهيقي",38,"ق",2,0],["خُنْفَسَاءٌ أَعْمَتْ مِنَ الْفُبْحِ عَيْنِي","وأَصَمَّتْ بِسَيِّىءِ الْقَوْلِ أُذْنِي",39,"ن",2,0],["خُنتُم وَرُمتُم أن أَخُون وَإنّما","حاوَلتُمُ أَن يُستَخَفَّ يَلَملَمُ",40,"م",1,0],["خُنُوا عَهد جَارِكُمُ وكُونُوا","لَهُ في كُلِّ خِصبٍ مُحرِمينَا",41,"ن",2,0],["خَنَعوا وَاِنتَخى وَعَزَّ وَذَلّوا","وَهَوَوا وَاِعتَلى وَضَنّوا وَجادا",42,"د",2,0],["خَنَعوا فَما اِمتَنَعوا فَكَيفَ بِهِم إِذا","زُرتَ الخَليجَ بِكُلِّ أَسمَرَ أَملَدا",43,"د",2,0],["خَنازيرُ ناموا عَنِ المَكرُماتِ","فَأَنبَهَهُم قَدَرٌ لَم يَنَم",44,"م",1,1],["خُنتَ مَن لَو دَعَوتَهُ وَهوَ مَيتٌ","ظَلَّ يُصغي مُسارِعاً وَيُصيخُ",45,"خ",1,0],["خُنتَ الخَليفَةَ في رَعِيَّتِهِ","وَعَصَيتَهُ في السِرِّ وَالجَهرِ",46,"ر",1,0],["خُنتم فلم يبقَ لي في وصلكم طمعٌ","يُرْجَى وهذا فؤادي في ابتداء العمل",47,"ل",1,0],["خَندَقوا حولَهم وكم معجزاتٍ","شاهَدوها فكانَ فيها عزاءُ",48,"ا",2,0],["خَنافِسُ الهِجرانِ أَثكَلنَني","يَومَ تَوَلّى معرَضا صَبري",49,"ر",2,0],["خنتَ عهدي وقد تبدَّلتَ بعدي","يا حبيبي ما كان ذلك ظنّي",50,"ن",2,0],["خُنتَ يا من كنتَ فجري","لم يعدْ لي بعدُ فجرا!",51,"ر",2,0],["خُنفُساوانِ وَبِنتا جُعَلٍ","وَالَّتي تَفتَرُّ عَنها وَزَغَه",52,"غ",2,0],["خَنَق الطين والظلام حِجانا","فعمينا وما هدانا هوانا",53,"ن",2,0],["خَناجِرَ شُدقاً بَينَ حَمضٍ وَخُلَّةٍ","مَجاليحُ في المَشتى ثِقالَ الكَراكِر",54,"ر",1,0],["خندريساً تروي بِطيب شَذاها","خَبَراً صحَّ عَن رُضابِك نَقلا",55,"ل",2,0],["خنث أَذعج كَحيل جَميل","يَتثنى بِقامَة صعداء",56,"ا",2,0],["خنتُ ما قد وعدتُه بكلامي","بفعالي فكنت فيه دخيلا",57,"ل",2,0],["خَنَست له أفكاره","والصلُّ مؤذٍ وهو خانس",58,"س",1,0],["خنت الشرئل مَطمع","متمنع صَعب المَرام",59,"م",1,0],["خنث المَفاصل مطمع متمنع","مُتناسب الحَركات وَالأَعضاءِ",60,"ا",2,0],["خندق واحدٌ كبيرٌ، وقفن","فيه، نرجو الخلاصَ ممَّآ ابتُلينا",61,"ن",2,0],["خُنْتُمُ عَهْدَ الهُدى ما بيننا","وَرَعَيْنا لكمُ فيها عهودا",62,"د",2,0],["خُنتَ الإخاءَ فشِمْتَ عضْ","بَ الهَجْو شيمةَ كلِّ وغْدِ",63,"د",1,0],["خندققوا القصر بالحديقة والما","ء لديهم يجري بكل مكان",64,"ن",1,0],["خَنِثُ المعاطف قد حكا","ه الغصن أعطافاً وقدا",65,"د",2,0],["خَنِثُ الملتوى رخيمُ المباني","جال ماءُ النعيمِ في أوصاله",66,"ل",2,0],["خنقتني أو حاولت ثم باهت","بأذاتي تلك النفوس الصغار",67,"ر",1,0],["خنساءُ همّي وذكُرها أنسي","إذا أمانيَّ حدَّثتْ نفسي",68,"س",2,1],["خناجرٌ فوق أعا","ليها بقايا الكلف",69,"ف",1,0],["خُنتُ التُّقى وقطعتُ أرحامَ العُلا","إن لمْ أَعُقْ في حبِّها مَنْ ينصَحُ",70,"ح",1,0],["خَنذيذُ هَذا الدَهرِ واحِدٌ أَهلُهُ","مِقدامٌ حَلَبَتهُ الأَغَرُّ الأَبتَعُ",71,"ع",1,0],["خنسآءُ العصرِ فريدتهُ","بل وردةُ أَزهُرِهِ النُّضُرِ",72,"ر",1,0],["خُنْ عَهْدَها مثلَ ما خَانَتْكَ مُنْتَصِفاً","وامْنَحْ هَوَاها بنسيانٍ وسُلْوَانِ",73,"ن",1,1],["خنَّقَهُ الهجوُ فلو راحَ أنْ","يُسيِغَ بَرْدُ الماءِ ما سَوَّغَه",74,"غ",2,0],["خُنصرُ عُمري لَم يَزَل عاطِلاً","فَحَلِّه رَبِّ بِحُسنِ الخِتام",75,"م",1,0],["خند ريسا لها من المزج تاج","وعليها من الحباب وشاحُ",76,"ح",1,0],["خنث المشية في أعطافه","مرح التيه وفي الطرف حور",77,"ر",1,0],["خنث الشمائل ليس يصحو طرفه","وعلام يصحو والرضاب شمولُ",78,"ل",1,0],["خنث الدلال بشعره وبثغره","يوم الوداع أضلني وهداني",79,"ن",2,0],["خنت العهود وما وفيت بذمة","فهل العهود مضت على أن تسفكي",80,"ك",2,0],["خنتَ المودَّةَ إن تركت الشربَ يو","مَ الدَّجْنِ من كأسٍ وريقِ أليفِ",81,"ف",1,0],["خَناثَى يأكلونَ التمرَ لَيسُوا","بزوجاتٍ يَلِدنَ ولا رِجالِ",82,"ل",1,0],["خِنزيرَةٌ بَظراءُ مُن","تنهُ البُداهَةِ وَالعُلالَه",83,"ل",2,0],["خَندَريساً كَأَنَّها في دُجى اللَيلِ","بِأَيدي السُقاةِ شَمسُ النَهارِ",84,"ر",1,0],["خندر