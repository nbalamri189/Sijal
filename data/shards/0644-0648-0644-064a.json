{"poems":[[55,"أمبلغي ما أطلب الغزل","https://www.aldiwan.net/poem29910.html","الكامل"],[102,"عودة القائد","https://www.poetsgate.com/ViewPoem.aspx?id=50093",""],[112,"ذهاب بلا اياب","https://www.poetsgate.com/ViewPoem.aspx?id=35293",""],[369,"وعدت باستراقة للقاء","https://www.aldiwan.net/poem61018.html","الخفيف"],[2126,"","https://poetry.dctabudhabi.ae/diwan/poem/100545","الرمل"],[2570,"","https://poetry.dctabudhabi.ae/diwan/poem/122837","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62949","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54490","الكامل"],[4987,"نسيتي","https://www.poetsgate.com/ViewPoem.aspx?id=49567",""],[5956,"آخيتُ شهماً طاهر الأثوابِ","https://www.poetsgate.com/ViewPoem.aspx?id=193358",""],[5956,"انتبه يا جدّي","https://www.poetsgate.com/ViewPoem.aspx?id=193954",""],[5956,"أطفالي","https://www.poetsgate.com/ViewPoem.aspx?id=194840",""]],"verses":[["لِوَليَّكَ الدُنيا مُزَخرَفَةٌ","وَلِأُمِّ مَن عادَيتَهُ الهَبَلُ",0,"ل",1,0],["لوليّ \" عهد الملك \" بنّاء الحمى","حلم البطولة والطموح العبقري",1,"ر",2,0],["لو لي دعوه وحيده... ودعوه تستجاب","قلت:ياربي ليا مر...خالفه الهبوب",2,"ب",1,0],["لِوليّ الدينِ المُقدَّمِ سَبْقٌ","إنْ تبَارَتْ خيْلُ العُلا في الجِراء",3,"ا",2,0],["لولي البيت حقاً ولدا","لا عزيز لا ولا ابن مريم",4,"م",1,0],["لوليه في بره","تحكي حلاوة عدله",5,"ه",1,0],["لَوْ لي على الأيام ناصرْ","فيما تجرُّ من الجَرائرْ",6,"ر",1,1],["لوليهِ من فَيْضِ نائله","فَيْضُ الوليِّ ونائلُ الوسمي",7,"م",2,0],["لولي مثل قلبك تمنيت فرقاك","واكيد قبلك بالجفا صرت بادي",8,"د",2,0],["لو ليس في الكذّاب سوءٌ ما التجا","للكِذْب مؤتزراً بألف نقابِ",9,"ب",1,0],["لو ليس شهماً عظيماً ما انجذبتُ له","قد حرَّر الشعب والأوطان من قيدِ",10,"د",1,0],["لو ليس لي شغلٌ، ولا دَرْسٌ لهم","كنّا على كل الوجود نجوبُ",11,"ب",1,0]]}