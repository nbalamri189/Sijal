{"poems":[[55,"رأيت المنى نهزة الثائر","https://www.aldiwan.net/poem30474.html","المتقارب"],[32,"أمنزلتي مي سلام عليكما","https://www.aldiwan.net/poem29573.html","الطويل"],[53,"ألم تسأل اليوم الظباء الكوانس","https://www.aldiwan.net/poem64666.html","الطويل"],[53,"أنا غيران ولا زوجة لي","https://www.aldiwan.net/poem65445.html","الرمل"],[63,"للخالديين جمال منظر","https://www.aldiwan.net/poem51665.html","الرجز"],[76,"بشرى كما أسفر وجه الصباح","https://www.aldiwan.net/poem12886.html","السريع"],[41,"قفا فاسألا الدمنة الماصحه","https://www.aldiwan.net/poem53809.html","المتقارب"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62226","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[92,"الملك حسين","https://www.poetsgate.com/ViewPoem.aspx?id=179040",""],[164,"حلفت يقظان مروج العنان","https://www.aldiwan.net/poem58767.html","السريع"],[170,"يذكرني الحمى عهد الوصال","https://www.aldiwan.net/poem46897.html","الوافر"],[214,"يا أهيل الحمى وعرب الفريق","https://www.aldiwan.net/poem13300.html","الخفيف"],[240,"حث كؤوس الراح","https://www.aldiwan.net/poem32118.html","مجزوء الرجز"],[276,"طيف الخيال من النيابتين سرى","https://www.aldiwan.net/poem52115.html","البسيط"],[287,"صيدت ضراغم حاجر بمحاجر","https://www.aldiwan.net/poem32744.html","الكامل"],[302,"لقد آن أن تثني أبي زمامها","https://www.aldiwan.net/poem33176.html","الطويل"],[463,"سقى أيام رامة بل سقاها","https://www.aldiwan.net/poem55819.html","الوافر"],[463,"أمن خفوق البرق ترزِمينا","https://www.aldiwan.net/poem55828.html","الرجز"],[466,"بني عمنا كفوا العضيهة أنها","https://www.aldiwan.net/poem15099.html","الطويل"],[469,"وجدي كوجدك بالظباء الغيد","https://www.aldiwan.net/poem3208.html","عموديه"],[469,"أما الديار فتلك عين ظبائها","https://www.aldiwan.net/poem3213.html","عموديه"],[505,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138266",""],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101043","الوافر"],[2817,"","https://poetry.dctabudhabi.ae/diwan/poem/203410","الرجز"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109822","الخفيف"],[3265,"","https://poetry.dctabudhabi.ae/diwan/poem/89515","الرجز"],[3400,"","https://poetry.dctabudhabi.ae/diwan/poem/130612","الرجز"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59482","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40081","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72487","البسيط"],[5969,"رَبيعُ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=198726",""]],"verses":[["يُسَفِّهُ في الرَوعِ فِعلَ القَنا","وَيَرضى عَنِ المِقضَبِ الباتِرِ",0,"ر",1,0],["يَسُفنَ الخُزامى بَينَ مَيثاءَ سَهلَةٍ","وَبَينَ بِراقٍ وَاِجَهَتها الأَجارِعُ",1,"ع",1,0],["يَسُفن الخُزامى بين أكناف عازبٍ","غذته الغواذي وهو بالماء راغسُ",2,"س",1,0],["يسفل الناس ويعلو معشرٌ","قارفوا الأقراف من كل طرف",3,"ف",1,0],["يُسفِرُ عن ضِدِّ الصَّباحِ المُسْفِرِ","وذاتِ وَجْهٍ كَصَفا المُشقَّرِ",4,"ر",1,0],["يُسفِرُ عَن بيضِ وُجوهِ الظُبى","بَأساً وَيَرنو عَن عُيونِ الرِماح",5,"ح",1,0],["يَسَفُّ خُراطَةَ مَكرِ الجَنا","بِ حَتّى تُرى نَفسُهُ قافِحَه",6,"ح",2,0],["يَسُفْنَ بَوِّي عَلَى شَحْطِ المَزَارِ كَمَا","سَافَ الأَوَابِي قَرِيعُ الشَّوْلِ إِذْ عَرَفَا",7,"ف",2,0],["يُسِفُّ إلى حيث لا ينتهي","ويسمو إلى قمةٍ لا تُرَامْ",8,"م",1,0],["يسفُّون بالأخلاقِ إذ يُطلقونها","على كلِّ ما يَزري بحُرٍ مخلَّق",9,"ق",1,0],["يسفر وجه النصر عن إذا الس","يف بذيل القسطل الجحفلان",10,"ن",1,0],["يُسفُّ بهِ تواضُعُه فتَدْنو","مَقاطِعُهُ على بعدِ المنَالِ",11,"ل",1,0],["يسفح الدمع في الخدود عقيقا","حبذا السفح مؤذنا بالعقيق",12,"ق",1,0],["يُسفِرُ عَن مالٍ مُباحٍ","أَو دَمٍ مُطاحِ",13,"ح",1,0],["يس فيه وَطس امتداح علا","وَالطور وَالنور وَالفُرقان وَالشعرا",14,"ر",2,0],["يَسفِرنَ عَن صُوَرِ الدُّمى أَعشَت بِبَه","جاتِ الشُموسِ ضُحىً لِحاظَ الناظِرِ",15,"ر",1,0],["يُسفِّهني فيها وشاةٌ ولوَّمٌ","ومن سَفهٍ إِفراطها في ملامِها",16,"م",3,0],["يُسِفُّ يطامِع الخَرقاءَ حتى","تبوِّعَه لتمسحَه يدَاها",17,"ا",3,0],["يَسفِرن عن حرائرٍ مجلوَّةٍ","ما وَصَفَت في عِتقها هَجينا",18,"ن",2,0],["يسفُّ فيغدو للجبال مُعمما","ويدنو فيغدو للهضاب مُؤزِّرا",19,"ر",2,0],["يسفرن سودَ نواظرٍ وغدائرٍ","ويلحنَ بيضَ ترائبٍ وخدود",20,"د",1,0],["يسفرن فالأقمار في هالاتها","ويسمن فالأغصان في أنقائها",21,"ا",3,0],["يسِفُّهُ الحقُّ سفًّا ثمَّ يُرجعُهُ","فرْقاً وفي الأمرِ تجريدٌ وإِكساءُ",22,"ا",2,0],["يسفرن عن بيض الوجوه وقد علت","فوق الصدور العاريات نهود",23,"د",1,0],["يسف على الثرى طوراً وطورا","تراه على الذرى شق الغماما",24,"م",2,0],["يسفرن عن مثل الشموس أوجهاً","ويختلبن القانت المهذبا",25,"ب",2,0],["يسفك الحبر مكرهاً وهو لو كا","ن طليقاً لكان يسبك تبرا",26,"ر",2,0],["يسفر عن عين الطَلا","وجنة تحكي الطِلا",27,"ل",2,0],["يسفر عن بهجة وجه مشرقٍ","كأنما بدر السما تضمنا",28,"ن",2,0],["يُسّفدُها دعساً بإبرة روْقهِ","كماشكَّ في سَفودِ شَرْبِ خرادلهْ",29,"ل",2,0],["يَسْفِرْنَ عن سُحُبٍ سوافرَ عن سناً","مثلَ الأَهِلَّةِ في فروعِ صِعادِ",30,"د",1,0],["يسفر عن وجه مستنير","لم يخش من بدره سرارا",31,"ر",2,0],["يُسَفْسِطُني مَنْ كانَ يَدري جَسارَتي","يُمَنْطِقُني مَنْ كانَ يَهذي وَيُغرَمُ",32,"م",1,0]]}