wPoem.aspx?id=5368",""],[5776,"سديمُ المستحيلات","https://www.poetsgate.com/ViewPoem.aspx?id=199343",""],[5906,"هيهات","https://www.poetsgate.com/ViewPoem.aspx?id=188315",""],[5906,"آمال نافقة","https://www.poetsgate.com/ViewPoem.aspx?id=188823",""],[6075,"بسمة الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=200329",""],[6093,"حادٍ وليس له بعير","https://www.poetsgate.com/ViewPoem.aspx?id=176447",""],[6130,"مستحيلة ...","https://www.poetsgate.com/ViewPoem.aspx?id=199046",""],[6131,"الكونُ المُسَافرُ للفَراغْ","https://www.poetsgate.com/ViewPoem.aspx?id=189269",""],[6131,"نَوابضُ الضَّادْ","https://www.poetsgate.com/ViewPoem.aspx?id=189282",""],[6213,"لوحة حب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76258&r=&rc=15",""],[2638,"المُتْرَار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87860&r=&rc=17",""],[5190,"لا تسألي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85040&r=&rc=115",""]],"verses":[["داعِمُ المُلكِ يَومَ مالَ وَلاقى","مَوَجاناً مِنَ الخُطوبِ وَرَجفا",0,"ف",2,0],["داعِياً لي بِالخُلودِ وَلَو","طَلَبوا مِنهُ دَمي وَهَبَه",1,"ب",2,0],["دَاعِينَ للهِ بِأَنْ","يَشْفِيَهُ وَيُرْجِعَهْ",2,"ع",2,0],["دَاعِي المَبَرَّةِ وَالوَفَاءِ دَعَا","فَأَجَابَتِ العَزَمَاتُ وَالفِطَنُ",3,"ن",1,0],["دَاعِي الْوَلاَءِ إذَا دَعَانِي","سَمْعاً لَهُ فِي كُلِّ آنِ",4,"ن",1,1],["دَاعِينَ تَحْيَا مِصْرْ فَصَرْعَى","تُكَابِدُونَ المَوْتَ الزُّؤَامَا",5,"م",2,0],["دَاعِيَةٍ توقِظُ النِّيَامَ فَقَدْ","طَالَ الكَرَى وَالحلُومُ فِي حُلُمِ",6,"م",1,0],["داعٍ لجود يدٍ بيضاء ما برحتْ","تقضي على كلِّ صفراءٍ وبيضاء",7,"ا",2,0],["داعي المقاصد في علم وفي كرم","إلى لقاءِ مليّ الفضلِ مقصود",8,"د",1,0],["داعٍ إِلى حَقٍّ أَهابَ بِخاشِعٍ","لَبِسَ النَذيرَ عَلى هُدىً وَعَفافِ",9,"ف",1,0],["داعَبَني بِالمَطلِ مُستَأنِياً","وَعَدَّهُ مِن فِعلِهِ ظَرفا",10,"ف",2,0],["داعٍ إِذا ما قامَ يَوماً خَاطِباً","فَالهامُ تَركَعُ وَالجَماجِمُ تَسجُدُ",11,"د",1,0],["داعٍ دَعا بِلِسانِ هادٍ مُرشِدِ","فَأَجابَ عَزمٌ هاجِدٌ في مَرقَدِ",12,"د",1,1],["داعي الجِهادِ دَمٌ بِجِسمِكَ جائِلٌ","وَسِلاحُهُ نَفَسٌ يَجيءُ وَيَرجِعُ",13,"ع",1,0],["داعٍ بِأَمرِ اللَّهِ أَسمَعَ صَوتُهُ ال","ثقلينِ حتى ظُنَّ إسْرافِيلا",14,"ل",2,0],["داعبتهُ ضاحكاً فغلّظَ لي","تغليظَ مولىً يسطو على خَوله",15,"ل",2,0],["دَاعٍ دَعَاهُ إِلَى الجِهَاد فَأَزْمَعَا","سَفَراً وَجَادَ بِنَفْسهِ مُتَطوِّعَا",16,"ع",2,1],["دَاعٍ إلى العَهْدِ الْجَدِيدِ دَعَاكِ","فَاسْتَأْنِفِي فِي الخَافِقَيْنِ عُلاَكِ",17,"ك",1,1],["دَاعِياً لِلسُّرُورِ وَالتَّهْنِئَاتِ","وَتَوَالِي النُّجُومِ تَرْمُقُ آنَا",18,"ن",2,0],["داعِبِ الشرقَ باسماً وسعيدا","وائتلِقْ يا صباحُ للناسِ عِيدا",19,"د",2,1],["داعٍ بأمر اللهِ أسمعَ صوتهُ الثَّق","قْلَينِ حتى ظُنَّ إسْرَافِيلا",20,"ل",2,0],["داعياً أنتظل رفاقة الثغر","على الدهر ذات حسنٍ جديد",21,"د",1,0],["داعٍ لملكك بالدوا","م وحظهأن يستزيده",22,"د",2,0],["داعبي بالحلم قلبي","فالأماني منك حسبي",23,"ب",2,1],["داع إلى اللَه بالقول السديد وبال","فعل الحميد على علم وبرهان",24,"ن",1,0],["داعى الهدى والفوز والصلاح","إمام أهل الحق والفلاح",25,"ح",1,0],["داع مِن الحَقّ بِالحَقّ المُبين دَعا","حَتّى اِستردّ مِن الأَسرار ما ودعا",26,"ع",2,1],["داعياً لي مهنئاً بصبي","إن هذا الدعا من إنعامك",27,"ك",1,0],["داعي التشوفِ ناداهم وأقلقهُم","فكيفَ يهنو ونارُ الشوقِ تشتعلُ",28,"ل",1,0],["داعِي أَمير المؤمني","نَ يَهُزُّ منه غِرارَ صارم",29,"م",1,0],["داعٍ إِلَى دعوةِ الإِسلامِ ينصُرُها","فأَيُّ مُعتمدٍ من شَأْوِ مُعتمدِهْ",30,"د",2,0],["داعَبتَني بِيَدَيكَ تَجذِبني بِها","فَإِذا اِنجَذَبتُ تَرَكتَني مُتَعَثِّرا",31,"ر",2,0],["داعياً للهدى بإخلاص قلب","وكلام فصل وصدر رحيب",32,"ب",1,0],["داعي المنيَّةِ في البريَّةِ قد دعا","لِيُنبِّه الغرقانَ في سِنَة الكَرَى",33,"ا",1,1],["دَاعِي المَنَايَا خَاطِبٌ كُفْوَهُ","كَخِطْبَةِ المْعُتَامِ لِلْعِرْسِ",34,"س",1,0],["داعٍ مِنَ الرُّشدِ أَمسَى هاتِفاً بِهِمُ","إِلى بِساطٍ مِن اللذَّاتِ مَنشُورِ",35,"ر",1,0],["داعِرُ قَوْمٍ فَضَّحَتْهُ نُمُمُهْ","وَحائِن أَوْقَعَهُ تَهَكُّمُهْ",36,"م",2,0],["داعٍ لك في حسن ختامِ","وسعودٍ دام إلى الابدِ",37,"د",1,0],["داعٍ له حتى إلى يوم اللقا","بالارتقا في السر والاجهار",38,"ر",1,0],["داعيات الهوى تخفّ علينا","وخلاف الهوى علينا ثقيل",39,"ل",1,1],["داع إلى الله هاد للانام إلى","سلوك منهج اسلام وايمان",40,"ن",1,0],["داعي دعا من فؤاد","ملان لك بالوداد",41,"د",1,0],["داعي إلى المولى بخير دعاية","وبصيرة ومطهر الانسان",42,"ن",1,0],["داعي الهَوى قَد صاح","بِالسن الأَوتار",43,"ر",1,1],["دَاعَبتهم إذ أسفرت في كؤوس","ثم غابت لِلُطفها الموسومِ",44,"م",1,0],["داعيا للواحد الأحد","الصمد المخصوص بالعظم",45,"م",1,0],["داع سرت أَسرار سر دعائه","ما بينَ جابرسا وَبين الصين",46,"ن",1,0],["داعٍ من العليا دعا","يدعو بنيها مسمعا",47,"ع",2,1],["داع أهاب من العلا","حيران يهتف معولا",47,"ل",2,0],["داع يقول هلموا الأكل حان ومن","عنه تواني لعمري باء في خسر",48,"ر",1,0],["داع له في كل آ","نٍ بالصواب وبالسداد",49,"د",1,0],["داع به رفع المحدّ","ب في الوجوب بلا عماد",49,"د",1,0],["داع به رست الأرا","ضي للبرية كالمهاد",49,"د",1,0],["داع لذي الجبروت دع","وى أعربت صفو الوداد",49,"د",1,0],["داع له صفو الولا","ء على الحواضر والبوادي",49,"د",2,0],["داع له أمر اللوا","والحوض في يوم المعاد",49,"د",1,0],["داع غدت بولاه أه","ل ولاه سامية العماد",49,"د",1,0],["داع كشفت به العنا","وعلقت كفاً بالمراد",49,"د",1,0],["داع به سعد الموا","لي بل أبير به المعادي",49,"د",2,0],["داعٍ ولاه بنشأت","يَّ ولو أبت كل العباد",49,"د",1,0],["داعي الله وا ضَلال أناسٍ","لم تكن أن تجيب لما دعاها",50,"ا",3,0],["داعٍ يحثُّ على المكارم","والمغانم خيرُ داعِ",51,"ع",1,0],["داعى دعاة هداة سيف إمامه","دون الملوك بنصره عمرانه",52,"ن",2,0],["داع إلى أقصى التأمل مثلما","جعل التفاؤل للحياة دليلا",53,"ل",2,0],["داعي النَّوى لم أنْسَ دهراً رُضْتُهُ","بكواعبٍ في روضِ ذاكَ المعهدِ",54,"د",1,0],["داعي المنية لا يصد بجحفل","فهو العظيم له يذل الجحفل",55,"ل",1,0],["داعيا للقريض غير مجيد","دعوة طاب عود من لباها",56,"ا",3,0],["داعين تعلن ما في النفس ألسنهم","بدعوة الخير والتأمين تاليها",57,"ي",3,0],["داعبتها الهوبها وسيمة ال","وجه بهاء عذبة المقبل",58,"ل",1,0],["داعبتها وما على","أهل الهوى من حرج",59,"ج",1,0],["داعيكم في المكرمات يجاب","واليكم القفر القواء تجاب",60,"ب",1,1],["داعيين الورى إلى حج بيت","بنياه مشيد الأركان",61,"ن",1,0],["داعي الحب ولو فر","رقنا صرف الزمان",62,"ن",1,0],["داعيك هذا مجتني الأنوار","لو شئت أمسى مجتلي الأنوار",63,"ر",1,1],["داعيا بالفعال والقول دأبا","للهدى والتقى بأحسن نيه",64,"ي",2,0],["داعي الهوى أَولَع العشاقَ فاِنتَبَهوا","لسُكر طاساتها السَكرى سواقيها",65,"ي",3,0],["داعٍ بنصرٍ بِهِ الفتحُ القَريبُ زَها","واصبح الفضل نحجاً حاليَ العطَلِ",66,"ل",1,0],["داع إلى الحق والمقبول حيث دعا","أفديه معتقداً في الناس أفديه",67,"ي",2,0],["داعيك قد نال المرام بهمةٍ","لك بيضت منها الليالي السود",68,"د",1,0],["داعي جنابك ساعدته عناية","إن السعيد محبه المسعود",68,"د",1,0],["داعي الاله دعاهم للوغى فاتوا","سعياً على الراس لا مشياً على القدم",69,"م",1,0],["داعيك نصر اللَّه ذو الهيام","وذو الجفون القرّح الدوامي",70,"ي",1,1],["داعي الصَبابة قَد دَعى","وَأَجاب رُوحي وَالبَدَن",71,"ن",1,0],["داعيًا للحياة لم يألُ نضحاً","من مزاميرها ولم يألُ نفحا",72,"ح",2,0],["داع بحي على الفلاح إلى الغنا","وهو المجير من الزمان وكيده",73,"د",2,0],["داعي الصَبُوح دَعا إِلى الصَهباءِ","وَالوَقتُ راقَ بِقاعة الوَعساءِ",74,"ا",2,1],["داعِ القُلوب بخلقِهِ لصبابةٍ","وبخلقِهِ داعٍ إلى السلوانِ",75,"ن",1,0],["داعي الصلاة بجنبه","داعي صلاة الوفد أذن",76,"ن",1,0],["داعي النغمات حلقة الشوق طرق","وهنا فأجابته شجون وحرق",77,"ق",1,1],["داعٍ دَعاكَ مِنَ المُنونِ سَمِعتَهُ","فَأَجَبتَهُ تَسعى إِلَيهِ وَتُسرِعُ",78,"ع",1,0],["داع كثير رماد القدر ان وضعت","كناية بطنها والظهر بالدسم",79,"م",1,0],["داع مجاب في حماة دعاؤه","بك سائر مثلا من الأمثال",80,"ل",1,0],["داع أشار مع البشائر أرخوا","ه هذا جمال قدوم أبرك قادم",81,"م",1,0],["داعي الصفا بعلاه اضحى داعيا","ابشر بعزة نيل مجد آصفي",82,"ف",2,0],["داعٍ لَكُم بِسَعادَةٍ أَبَديَّةٍ","وَإِعانَةٍ وَمَبَرّة وَسُرورِ",83,"ر",1,0],["داعٍ لدعوته وكاتم سره","والسرُّ موضوع على الكتمان",84,"ن",1,0],["داعي الدعاة ومهدي الناهجين إلى","سبل الرشاد بلا شكٍ ولا كذب",85,"ب",1,0],["داعِي الشَّيب إِن دَعا","قُلتُ لَبَّيكَ داعِيا",86,"ي",2,0],["داعيكم المحب ابراهيمُ","الحلبي نسبتُه الحكيمُ",87,"م",1,0],["داعيا لي مثل ما أدعو له في كل حين","بدعاء من رياء هو مأثور مجرد",88,"د",1,0],["داعبتها النود صبحٍ وغازلها السحاب","يوم تلبس رجلها طاهر التربة حذا",89,"ذ",2,0],["داعياً أن يرى مُنى القلب حتى","حل والقلب خافق في يديها",90,"ي",3,0],["داعبتُها عبَبْتُ مِن أعْطافِها","لَثَمْتُ عَرْفَ الوردِ أو لا أذكرُ",91,"ر",1,0],["دَاْعِبْ أَنَاْمِلَهَاْº وَ قَبِّلْ ثَغْرَهَاْ","وَاطْلُبْ إِلَيْهَاْ قِسْمَةَ الأَرْزَاْقِ",92,"ق",1,0],["داعب الوجدان حلم المنتهى","وطريق العز حيكت من وحول",93,"ل",1,0],["داعب الأهدابَ حُلْمٌ وانْثَنى","في الكَرى والراحُ دارتْ بينَنا",94,"ن",2,1],["داعبته الشقراء في ليلها الرا","قص بين الألحان والأوتار",95,"ر",1,0],["داعيا ربه بتعجيل ان يشقى","لديه بقتله اشقاها",96,"ا",3,0],["دا عيالى مش لاقيه الهدمه - وحق الجزمه","وبلاش أقول ومفيش لازمه - الدور أسرار",97,"ر",1,0],["داعبتِ أوتار العواطف في الحشا","فتألقت روح الشعور الذاكي",98,"ك",2,0],["داعشُ والماءُ معا","فوق احتمال الجبلِ",99,"ل",1,0],["داعبي أحلام قلبي","ثم لومي أو أجيبي",100,"ب",2,0],["داعي الأنام إلى الهدى وقلوبهم","إذ ذاك بالاشراك خلق حجاب",101,"ب",1,0],["دَاعَبَ الطَّيفُ مُهجَتِي","واعتَنَقنا فمٌ لِفَمْ",102,"م",1,0],["١- داعٍ على شاطئ الأشواقِ مبتهِلُ","وفي الطّوامي هناك الوصلُ يكتحِلُ",103,"ل",1,1],["داعَبَتْ شَعْرَها النَّسائِمُ فانْثالَ","نُضاراً مُذَوَّباً شَلّالا",104,"ل",2,0],["داعي سلام كالحمام ورحمة","ورسول حب صادق ووداد",105,"د",1,0],["داع وشاهد وحجة وتب","يان ونور وهدى فاغتنم",106,"م",1,0],["داعين ربنا بالركوع وبالسجود","مشغلين اقلوبنا بالوعيد وبالوعد",107,"د",1,0],["داعبتها ...ماذا إذا خاصمتها","اجعلْ صداها قبّتينِ منْ العللْ",108,"ل",1,0],["داعبتُ أَنصافَ اللَّيالي مِثلَما","دَهماؤُها بِضَراوةٍ تَهوانيْ",109,"ن",2,0],["داعَبَتْنا فيهِ أَيامٌ مَضَتْ","وارتَأينا الصَمتَ نِدَاً لِلجَدَلْ",110,"ل",1,0],["دَاعَبَتْ جَفْنَ الْأَمَانِي عَلَّهَا","تَسْكُبُ النُّورَ عَلَى كَفِّ الْقَدَرْ",111,"ر",1,0],["داعٍ لتطبيعِ الضميرْ","حَادٍ وليس لَهُ بَعيرْ",112,"ر",1,1],["داعبْتُ في مهجةِ القيثارِ عاطفةً","فأصبحتْ موجةُ الشطّينِ مُنشدَتي",113,"ت",2,0],["داعَبْتُ مَرآتيَ السَّوداءَ معتَرفًا","بَاحتْ بقُبحٍ فَمَا ابيضَّتْ وَ مَا بُحْتُ",114,"ت",1,0],["داعبْ صَدَى النَّايِ هَمسًا حينَ تعشقُهُ","فَكمْ منَ اللَّحنِ لمْ نُدركْ لَهُ غرَضَا",115,"ض",2,0],["داعبتُ سرَّكِ في السهاد فمهجتي","سهرانة تدنو لطيفك، تحلم",116,"م",1,0],["داعبت مِغزلها العاري الذي","طالما حاك لذي عُريٍ كساءا",117,"ا",3,0],["داعَبتُهُ بِيَدِ المَشُوقِ ، فَصَدَّهَا","ثُمَّ استَكَانَ لِسِحرِها ، فَتَنَهَّدا",118,"د",2,0]]}