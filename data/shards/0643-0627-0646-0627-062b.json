{"poems":[[55,"أقول لها بين الغديرين والنقا","https://www.aldiwan.net/poem29961.html","الطويل"],[107,"هي الدراري فأين المطمح العالي","https://www.aldiwan.net/poem43059.html","البسيط"],[54,"يا قلب قد جد بين الحي فانطلقوا","https://www.aldiwan.net/poem26817.html","البسيط"],[78,"خليفة الله وابن عم رسو","https://www.aldiwan.net/poem39006.html","المنسرح"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42734","البسيط"],[146,"ماذا يعيب رجال الحى في النادي","https://www.aldiwan.net/poem58426.html","البسيط"],[463,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145969","البسيط"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75742","الطويل"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20385","البسيط"]],"verses":[["كَأَنَّ أُثَيوابي عَلى ذِئبِ رَدهَةٍ","دَنا اللَيلُ فَاِستَنشى رِياحَ التَنائِفِ",0,"ف",1,0],["كَأَنَّ آثارَها في كُلِّ صالِحَةٍ","تَدميرُ صاعِقَةٍ أَو خَسفُ زِلزالِ",1,"ل",1,0],["كَأَنَّ آثارَ وَحشيَّ الظِباءِ بِها","دِرعٌ تُخَلِّفُهُ أَظلافُهُ نَسَقُ",2,"ق",1,0],["كأنَّ أثوابَهُ مُلبَّسةٌ","أثوابَ غضِّ الزمانِ مُقتبلِهْ",3,"ل",2,0],["كان إثمي أني إذا سألوني","لم أقل ما يقوله الجمهورُ",4,"ر",1,0],["كَأَنَّ آثَارَهَا فِي كُلِّ نَاحِيَةٍ","رَيْطٌ مُنَشَّرَةٌ فِي الأَرْضِ أَوْ حُلَلُ",5,"ل",1,0],["كأنَّ آثارَ ما داست حوافرُها","دراهمٌ بَدَدٌ في كفِّ نقَّادِ",6,"د",1,0],["كأنّ إِثريْنا إذا ما أصبحا","على الثرى مسحبُ رمح أو مَسدْ",7,"د",1,0],["كأنَّ أثوابَنا في كُلِّ مُضطَرَمٍ","مُهَدَّلاتٌ على أضلاعِ مُضطرِمِ",8,"م",1,0],["كأن أَثافيها حَمائم لِلنَوى","لَها بلسان الحال عمن نأى نوح",9,"ح",1,0],["كَأَنَّ أَثوابَ نَقّاد قُدِرنَ لَهُ","يَعلو بِخَملَتِها كَهباءَ هَدّابا",10,"ب",2,0]]}