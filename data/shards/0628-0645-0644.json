{"poems":[[9,"أترحل من ليلى ولما تزود","https://www.aldiwan.net/poem21924.html","الطويل"],[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[93,"ما لقلبي يلج من الخفقان","https://www.aldiwan.net/poem62761.html","عموديه"],[40,"ألا يا اسلمي حييت أخت بني بكر","https://www.aldiwan.net/poem7715.html","الطويل"],[91,"قد جاء يا أم وقت فوتي","https://www.aldiwan.net/poem44940.html","مخلع البسيط"],[47,"معاد من الأيام تعذيبنا بها","https://www.aldiwan.net/poem10908.html","الطويل"],[2,"غشيت ديارا بالنقيع فثهمد","https://www.aldiwan.net/poem25047.html","الطويل"],[46,"أي مرعى عين ووادي نسيب","https://www.aldiwan.net/poem30586.html","الخفيف"],[83,"تجلى شهاب للسعادة آفل","https://www.aldiwan.net/poem61333.html","الطويل"],[78,"وروضة عقدت أيدي الربيع بها","https://www.aldiwan.net/poem39468.html","البسيط"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67319","الطويل"],[168,"بملتفتيه للمشيب طوالع","https://www.aldiwan.net/poem67832.html","الطويل"],[186,"على يوسف الفياض فاضت مسرة","https://www.aldiwan.net/poem67009.html","الطويل"],[222,"نأتك سليمى دارها لا تزورها","https://www.aldiwan.net/poem401.html",""],[275,"بملك الروم غانية عروبا","https://www.aldiwan.net/poem35031.html","الوافر"],[330,"سؤالك يا هذا سؤال معاند","https://www.aldiwan.net/poem52139.html","الطويل"],[369,"بملتقى لحظنا البرق الذي ومضا","https://www.aldiwan.net/poem60862.html","البسيط"],[382,"ما أحسن الروض في الروابي","https://www.aldiwan.net/poem66927.html","مخلع البسيط"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101500","الرمل"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146223","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38335","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38985","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64586","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64540","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49935","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66266","المتقارب"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11191","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124725","البسيط"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109280","البسيط"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177838","السريع"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/157824","السريع"],[2468,"","https://poetry.dctabudhabi.ae/diwan/poem/117814","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94128","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58436","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201888","الكامل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103480","الرجز"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65110","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132562","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112692","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89125","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62949","الكامل"],[3508,"","https://poetry.dctabudhabi.ae/diwan/poem/20543","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86250","الطويل"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199152","السريع"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91186","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117918","الكامل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66568","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135737","الرجز"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54348","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54485","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94342","الوافر"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73099","الوافر"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127929","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72929","الرجز"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113825","الوافر"],[4712,"رويتك في صحيحي","https://www.poetsgate.com/ViewPoem.aspx?id=202613",""],[5213,"أشاقك أن ترى الربع المحيلا","https://www.poetsgate.com/ViewPoem.aspx?id=170514",""],[5302,"الراحلة التائهة","https://www.poetsgate.com/ViewPoem.aspx?id=201739",""],[5616,"أنا العراق","https://www.poetsgate.com/ViewPoem.aspx?id=207994",""],[5739,"مصنع عبير..!","https://www.poetsgate.com/ViewPoem.aspx?id=135076",""],[5956,"شاعر الأديان","https://www.poetsgate.com/ViewPoem.aspx?id=192499",""],[5956,"أحببتُكم مِمّا سمِعتُه عنكم","https://www.poetsgate.com/ViewPoem.aspx?id=207929",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[4222,"يوم النوى ليس من عمري بمحسوب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52726&r=&rc=18",""]],"verses":[["بِمَلمومَةٍ لا يَنفُضُ الطَرفُ عَرضَها","وَخَيلٍ وَأَرماحٍ وَجُندٍ مُؤَيَّدِ",0,"د",1,0],["بِمِلءِ تِهَامَة وبِملءِ نَجد","كَأسدِ الغَابِ حَولَ الأَندَرِينَا",1,"ن",2,0],["بِمُلك تَركُضُ المُرَادَاءُ فِيهِ","مِنَ الجِنِّ العُتَاةِ مُسَخَّرِينَا",1,"ن",2,0],["بِمُلوكِ البَيانِ بِالأَدَبِ ال","رائِعِ بِالمُنشِدينَ بِالأَلحانِ",2,"ن",1,0],["بِمَلحَمَةٍ لا يَستَقِلُّ غُرابُها","دَفيفاً وَيُمسي الذِئبُ فيها مَعَ النِسرِ",3,"ر",1,0],["بملك خدا يُظن وردا","وأعينا هنَّ للغزال",4,"ل",1,0],["بِمَلمومَةٍ تَحتَ العَجاجِ مُضيئَةٍ","تَحوزُ الأَعادي خَطفَةٌ مِن عُقابِها",5,"ب",3,0],["بِمُلتَئِماتٍ كَالخَذاريفِ قوبِلَت","إِلى جَوشَنٍ خاظي الطَريقَةِ مُسنَدِ",6,"د",1,0],["بِمُلِّثٍ عَلى الفِراقِ مُرِبٍّ","وَلِشَأوِ الهَوى البَعيدِ طَلوبِ",7,"ب",1,0],["بِمُلكِ أبِي عُثمَانَ أًنشِرَ غَابِرٌ","وَشُيِّدَ مُنهَدٌ وَجُدّدَ مَاثِلُ",8,"ل",1,0],["بِمُلْقَحٍ مِنْ سَوارِيها وَمُلْحَقَةٍ","ونَاتِجٍ مِنْ غَوادِيها ومَنتُوجِ",9,"ج",1,0],["بمَلْمُومَةٍ فيها السَّنَوَّرُ والقَنَا","إذا ضَرَبُوا أَقْدَامَها لا تورّعُ",10,"ع",1,0],["بِمُلتَفَتَيهِ لِلمَشيبِ طَوالِعُ","ذَوائِدُ عَن وِردِ التَصابي رَوادِعُ",11,"ع",1,1],["بِمَلقاهُ أَرَّخَتِ المَلائكُ أَنشَدَت","عَلى وَجهِ ميخائيلَ طِيب سَلامِ",12,"م",1,0],["بِملمومَةٍ شَهباءَ لَو نَطحوا بها","عَمايةَ أَو دَمخاً لَزالَت صخورُها",13,"ر",3,0],["بملكِ الرُّومِ غانيةً عروبا","وملكِ الفرسِ غازيةً غلوبا",14,"ب",2,1],["بملة إبراهيم ذاك إمامنا","ودين رسول اللَه خير البرية",15,"ه",1,0],["بمُلتقَى لَحظِنا البرقُ الّذي وَمضا","اِستوقَفَ الطَّرفَ في آثارِه ومَضى",16,"ض",2,1],["بملكك الآن كل ملكٍ","بغير عدٍّ ولا حساب",17,"ب",1,0],["بملاكٍ مالكٍ رو","حي وقلبي وصوابي",18,"ب",2,0],["بملاحفٍ مصقولةٍ قد وصِّلتْ","ومآزرٍ عقَّدْنها بمآزرِ",19,"ر",1,0],["بِمَلافظٍ فيها المَنافعُ لِلوَرى","فَفَوائِدٌ وَمَواعِظٌ وَنَصايحُ",20,"ح",1,0],["بِمِلَّتهِ الغرّا الّتي قَد نَصرتها","إِلَهي بِسيفِ الحقِّ سلّ مِنَ الغمدِ",21,"د",1,0],["بملك لا إله إلا اللّه","وملك أسمائك عجل المدد",22,"د",1,0],["بملكك ربي هذه النفس زكها","وقدس مساعيها بنور وحكمة",23,"ه",1,0],["بمُلَوّناتِ الزّهْر والنُّوّار مِن","نَيْلوفر وشقائقِ وبنفسجِ",24,"ج",1,0],["بملمومة حار فيها الفضاء","وطاش بها البطل الأنزع",25,"ع",1,0],["بِمَلمومَةٍ كَالطَودِ شَهباءَ فَيلَقِ","رَداحٍ يُصِمُّ السّامِعينَ صَليلُها",26,"ه",2,0],["بملك أخرى فإن الحنث يدركه","ولو يهوديةً كانت من الغرل",27,"ل",1,0],["بملء مقلتي العبرى على وطني","أبكي فما لي على ما نابه جلد",28,"د",1,0],["بملتقى الركنين قلبى لقاكم","كم لى ومن أهوى بها ملتقى",29,"ق",2,1],["بملتقى الركنين قلبي لقى","كم لي ومن أهوى بها ملتقى",30,"ق",2,1],["بمَلمومةٍ شهباءَ يبرقُ خالُها","ترى الشمسَ فيها حينَ ذَرَّت تَوقدُ",31,"د",1,0],["بمليك ذي شوكة أصغى","قد أنام الأنام في ظل أقساط",32,"ط",1,0],["بمُلَثَمٍ وَمُكَمّمٍ وَمُعَمّمٍ","ومخرَّصٍ وَمُوَشّحِ وَمُوَزَّرِ",33,"ر",1,0],["بمليكة الحسن الفريد تدّلهت","نفسي وهامت في فريد مكارمي",34,"م",2,1],["بمُلُسٍ نوافذٍ خوارِقِ","غَير حُيوداتٍ ولا مَوارِقِ",35,"ق",1,0],["بملكك ضاء الأفقُ حتّى توهّمت","أهو الشّرق أنّ الشّمس لاحت من الغرب",36,"ب",1,0],["بملتقطات من بيان وحكمة","يحلى بها نادي الحجى ويوشح",37,"ح",1,0],["بملمة طرقت فأنست","كل طارقة ملمه",38,"م",2,0],["بملك أبو الهاميِّ حامي رحابه","وفضل أبو اِبراهيم يبقى له الذكر",39,"ر",1,0],["بململمٍ صَخِبِ الجَنَا","نِ من الصَّاهلِ والهَوادرْ",40,"ر",1,0],["بِمَلموَمَةٍ كاللَيلِ رَعناءَ فَخمَةٍ","وَرَقراقَةٍ يُعشى العُيونَ حَديدُها",41,"د",3,0],["بِمِلءِ الصَفا لا زِلتَ كَالبَدرِ راقِياً","وَدُمتَ بِعيد الفَخرِ في السَعدِ فائِقا",42,"ق",2,0],["بملء الأفواه ينادون يا","أهل الوفا يا صاحب النوبة",43,"ه",1,0],["بملك أَبي العباس يا مصر فَاِزدَهي","وَتيهي فَما يَخشى اقتحامَ المكائد",44,"د",1,0],["بملاحم سال النجيع بها فلم","تعقد سنابكها عليها عثيرا",45,"ر",2,0],["بِمُلْكِكَ أَيَّامُ الزَّمانِ تَطِيبُ","وجودُكَ لِلرَّاِجي نَداكَ قَرِيبُ",46,"ب",1,1],["بملكٍ ومالكٍ مليكِ","بك فملِّكني بالتمليك",47,"ك",1,0],["بملك مصر ونصرُ المؤمنين غداً","تحظى النُّفوسُ بتأْنيس وتطيبِ",48,"ب",1,0],["بملكِ مصرٍ أُهنِّي مالكَ الأُمَمِ","فاسعدْ وأَبشرْ بنصرِ اللّهِ عن أَمَمِ",49,"م",1,1],["بملّاقي تطريةِ اللُغاةِ","وَقَد آلوا بعهدي للمماتِ",50,"ت",1,0],["بِملكٍ لَم يَكُن في الَمجدِ شَفعاً","ولَيسَ إِليهِ في كَرمٍ شفيعُ",51,"ع",1,0],["بملاحةٍ وظرافةٍ","وبحسن وضع مع صنائع",52,"ع",1,0],["بملك ديوان الشهاب الموسوي","هُنيتَ مولانا الشريف البرسوي",53,"ي",1,1],["بملتزم ببيت اللَه ادعو","بجمع الشمل أو ليقاً طويلا",54,"ل",2,0],["بِملْءِ الكَوْنِ: قَلْبي ضَاقَ ذَرْعًا","وَقَلْبُكِ جنَّةُ الكَوْنِ الفَسِيحِ",55,"ح",1,0],["بملتحفات أجنحة الفيافي","يوزعن الفلا ميلا فميلا",56,"ل",2,0],["بملابس تغري وصدر ناهض","ما احتاج كي يعلو إلى شداد",57,"د",1,0],["بملء فمي اقول أنا العراق","فيزجرني التملق والنفاق",58,"ق",1,1],["بملى عيوني منك لو دمعها ساح.","ذكرى وداعٍ شبْ دمع الجفوني.",59,"ن",2,0],["بملاحمٍ شعريةٍ لا تنتهي","ما دام قلبي من سناه يُزوَّدُ",60,"د",1,0],["بملائكٍ ليسوا من الأفلامِ","أو من بني التزييفِ والإيهامِ",61,"م",1,0],["بملكك الباقي بقدر العظمه","بالقسط حكماً بعلو الكلمه",62,"ه",1,0],["بملك مصر ونصر المؤمنين غدا","تحظى النفوس بتأنيس وتطييب",63,"ب",1,0]]}