tml","البسيط"],[46,"قد علموا أن سيخطف الشبح","https://www.aldiwan.net/poem22289.html","المنسرح"],[46,"لم أرض رأي ولاة قوم لقبوا","https://www.aldiwan.net/poem22632.html","الكامل"],[46,"إن عجوزا حبست برهة","https://www.aldiwan.net/poem23152.html","السريع"],[46,"قد بكرت لا يعوقها سبل","https://www.aldiwan.net/poem23272.html","المنسرح"],[46,"عيشتي سلتي ورمسي غمدي","https://www.aldiwan.net/poem23542.html","الخفيف"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85373","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85942","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85598","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85550","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85547","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85359","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85352","الكامل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20250","الرمل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147475","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147476","الرجز"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16661","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202546","الرمل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23960","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54246","الرمل"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50449","الرجز"],[95,"حسبي","https://www.poetsgate.com/ViewPoem.aspx?id=722",""],[106,"صدى الجمهورية","https://www.poetsgate.com/ViewPoem.aspx?id=179586",""],[106,"في ذكرى الكواكبي","https://www.poetsgate.com/ViewPoem.aspx?id=179601",""],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[77,"باتت نجوم الأفق دون علاكا","https://www.poetsgate.com/ViewPoem.aspx?id=34151",""],[45,"أجدر وأخلق أن ترن عوائدي","https://www.poetsgate.com/ViewPoem.aspx?id=31311",""],[91,"1916","https://www.poetsgate.com/ViewPoem.aspx?id=53214",""],[91,"تأملات","https://www.poetsgate.com/ViewPoem.aspx?id=53220",""],[51,"يا ابنَ الوزير َينْلا مُواربة","https://www.poetsgate.com/ViewPoem.aspx?id=29170",""],[51,"قدم الإمامُ يسير تحت لوائه","https://www.poetsgate.com/ViewPoem.aspx?id=26054",""],[95,"حسبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=746&r=&rc=24",""],[88,"ناح الحمام وغرّد الشحرور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19535&r=&rc=38",""],[88,"رقت بوصف جمالك الاقوال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19568&r=&rc=71",""]],"verses":[["كَم قَلَّدوني النِعَمَ الجِساما","سَوابِغاً تَرفَعُ لي الأَعلاما",0,"م",2,0],["كَم قُلَّةٍ مُمتَنِعٍ طَودُها","إِلّا عَلى ذي الجُدَدِ الأَعصَمِ",1,"م",1,0],["كَم قَد أَرَدتُ عَلى التَبَدُّلِ خاطِري","فَأَبى وَزاغَ عَنِ البَديلِ وَعافا",2,"ف",2,0],["كَم قَد نَصَبتُ لَكَ الحَبائِلَ طامِعاً","فَنَجَوتَ بَعدَ تَعَرُّضٍ لِوُقوعِ",3,"ع",1,0],["كَم قابِسٍ عادَ بِغَيرِ نارِ","لا بُدَّ لِلمُسرِعِ مِن عِثارِ",4,"ر",1,1],["كَم قُلتُ مِنهُ لِلعِدى","حَذارِ إِن أَغنى الحَذَر",5,"ر",1,0],["كَم قَطَعَ الأَقرانَ وَالأَسبابا","وَفَرَّقَ الجيرانَ وَالأَحبابا",6,"ب",2,0],["كمْ قُلْتُ للمُتَمَرّسينَ بشأْوِهِ","أرْميهِمُ بقَوارِعِ التّفْنيدِ",7,"د",1,0],["كَمْ قَعْقَعَتْ لانْتِجاعِ الغَيثِ مِنْ عَمَدٍ","أرْسَتْ لَهنَّ جَواري الحَيِّ أوْتادا",8,"د",2,0],["كَم قَد حَفِظتَ ذِمامَ القَومِ مِن وَلَهٍ","يَعتادُني لَبَناتِ الدَلِّ وَالخَفَرِ",9,"ر",1,0],["كَمْ قَاصِدٍ أَنْضَى إِلَيْكَ مَطِيَّهُ","مُسَتَوسِّداً كُوراً لَهَا وَوِرَاكَا",10,"ك",2,0],["كَم قَد مَضى شِعرِيَ في مِثلِهِ","فَسارَ لي مِن مَنطِقٍ سائِرِ",11,"ر",1,0],["كَم قَد تَرَكنَ مُجَدَّلاً","مِن بَينِ مُنقَصِفٍ وَجافِل",12,"ل",1,0],["كَم قَد أَنارَ لَها بِحالِكَةِ الحَشا","سُبُلاً تَضِلُّ سُلوكَها الأَوهامُ",13,"م",1,0],["كَمُقامِرٍ أَدّى الزَكاةَ مُرائِياً","لِلنّاسِ لا يَرجو مَثوبَتَها غَدا",14,"د",2,0],["كَم قُمتُ في مَجلِسِ الساداتِ أُنشِدُهُ","فَلَم يَكُن لِحَسودٍ في عُلاهُ مرا",15,"ر",2,0],["كَم قَد جَنى وَلَقيتُهُ مُتَعَذِّراً","فَكَأَنَّني كُنتُ المُسيءَ المُذنِبا",16,"ب",2,0],["كَم قَد شَكَرتُكَ غِبَّ ذِكرِكَ فَاِنتَشى","مُتَذَكِّرٌ مِنّي وَغَرَّدَ شاكِرُ",17,"ر",1,0],["كَم قاعِدٍ يَحظى فَتُعجِبُ حالُهُ","مِن جاهِدٍ يَصِلُ الدَؤُوبَ فَيُحرَمِ",18,"م",1,0],["كَم قَد وَطِئتُ عَلى أَحشاءِ مُتعِبَةٍ","لِلنَفسِ كانَت طَريقَ اللَينِ وَالدَعَةِ",19,"ه",1,0],["كم قاعدٍ في البيد بعد قعوده","قعدت به الآمال دون لحاقِ",20,"ق",1,0],["كم قد أضاءت بوجه البحر مشرقة","ورصّعت من رءوس الهضب تيجانا",21,"ن",2,0],["كم قد سفرت ففي القلوب تولّه","لما رأوك وفي العقول خبال",22,"ل",1,0],["كم قد يجور على جفونك سقمها","كسراً وتجهد خصرك الأكفال",22,"ل",1,0],["كم قد لثمت بها المراشف آخذاً","بهضيم خصر جال تحت وشاح",23,"ح",1,0],["كم قد لبست بها الضحا من روضة","فيها علتني نضرة وسرور",24,"ر",1,1],["كم قد تصادمت العقول بشأنها","وسعت لتكشف سرّها المجهولا",25,"ل",2,0],["كم قد أقمت على الأيام من شرف","لنا وأنبَتَ من نبع العلاء غُصُنا",26,"ن",2,0],["كم قام للعرب في أرجائها عَلَم","تهفو ذؤابته بالعلم والأدب",27,"ب",1,0],["كم قد أذاقتني الأيام من حُرَق","من فوقها أسف من تحتها ألم",28,"م",1,0],["كم قلت والليل جَثْل الشعر فاحمه","شعراً به كاد فرع الليل ينمعط",29,"ط",1,0],["كم قد نَحت لهم في اللوم قافية","من الحفيظة بالتقريع تحتدم",30,"م",1,0],["كم قد غدَوْت على الأيام منتدباً","قوماً أضعت بهم شعري وآمالي",31,"ل",2,0],["كم قد سقاها السَيل من أنهارها","ضُرّاً وهنّ منافع وحياة",32,"ه",1,0],["كم قد أقامت للعلوم مدارساً","يَعيا ذوو الإحصاء عن حسُبانها",33,"ن",3,0],["كم قد رمى الغيب الخفي فؤاده","بذكائه فأصاب كشف ستوره",34,"ر",2,0],["كَم قَد جَبَرتَ وَنِلتَني بِكَرامَةٍ","وَذَبَبتَ عَنّي مِن عَدُوٍّ جاهِدِ",35,"د",1,0],["كَم قَد رَأَيتُ وَلَيسَ شَيءٌ باقِياً","مِن زائِرٍ طَرِفِ الهَوى وَمَزورِ",36,"ر",1,0],["كَم قَد دَعَوتُكَ مِن دَعوى مُخَلِّلَةٍ","لَمّا رَأَيتُ زَمانَ الناسِ في دُبُرِ",37,"ر",1,0],["كَم قَد تَتابَعَ مِنكُمُ مِن أَنعُمٍ","وَالمَحلُ يَذهَبُ أَن تَعودَ الأَمرُعُ",38,"ع",1,0],["كَم قَد نَزَلتُ بِكُم ضَيفاً فَتَلحَفُني","فَضلَ اللِحافِ وَنِعمَ الفَضلُ يُلتَحَفُ",39,"ف",1,0],["كَم قَد أُثيرَ عَلَيكُمُ مِن خِزيَةٍ","لَيسَ الفَرَزدَقُ بَعدَها بِفَرَزدَقِ",40,"ق",1,0],["كَم قَد قَطَعنَ إِلَيكَ مِن مُتَماحِلٍ","جَدبِ المُعَرَّجِ ما بِهِ تَعليلُ",41,"ل",1,0],["كَم قَد قَطَعتُ إِلَيكَ مِن دَيمومَةٍ","يَهماءَ غُفلٍ لَيلُها كَالأَيهَمِ",42,"م",1,0],["كَم قَد أَفاءَ فَوارِسي مِن رائِسٍ","عَرِكٍ وَمِن مَلِكٍ وَطِئنَ هُمامِ",43,"م",1,0],["كَم قَد قَطَعتُ إِلَيكَ مِن دَيمومَةٍ","قَفرٍ وَغولِ صَحاصِحٍ وَحُزومِ",44,"م",1,0],["كم قال قائلكم لعا","لك عند عثرته لعاثر",45,"ر",1,0],["كَم قَتَلنا مِن كَريمٍ سَيِّدٍ","ماجِدِ الجَدَّينِ مِقدامٍ بَطَل",46,"ل",1,0],["كم قصدْنا محمداً فحمدنا","شادويّ الفخار والتهذيب",47,"ب",1,0],["كم قد رجوتُ وفي حسابٍ مثلهم","فلقيته لكن بغيرِ حساب",48,"ب",1,0],["كم قابلته لكي تحكيه نرجسة","فصح أن عيون النرجس انفتحت",49,"ت",1,0],["كم قصدنا له مشاهد فضل","فحصلنا على النجا والنجاح",50,"ح",1,0],["كم قد رأينا من معاني فضله","جدوى يديه في معانٍ زائده",51,"ه",1,0],["كم قلت باللثم وبرد اللمى","إيه برغم العاذل الحاسد",52,"د",1,1],["كم قاصدٍ جاء في جهرٍ وآخر في","سرٍّ وللكلّ إنعامٌ وتشريف",53,"ف",1,0],["كم قريب دعا به وبعيد","وهو هامٍ يد الندى هطَّاله",54,"ل",2,0],["كم قائلٍ إذ رآني","مفكراً في ملمّه",55,"م",2,1],["كم قضى فرض قاصدٍ لحماه","ثمَّ والى فأتبع الفرض نفلا",56,"ل",2,0],["كم قائل إذ رآني","أسعَى لأندَى البرِيَّه",57,"ه",1,1],["كَم قائِلٍ لِي ذُقتُ البَينَ قُلتُ لَهُ","الذَنبُ وَاللَهِ ذَنبي لَستُ أَدفَعُهُ",58,"ع",2,0],["كم قد تخلَّف عنهما من سابقٍ","غيرِ الوزير مُبَرِّزِ الوزَراءِ",59,"ر",3,0],["كم قد وردتُ سَماحَه","فسُقيتُ منه بلا استقاءِ",60,"ق",3,0],["كم قال ضيفي وقد بعثت به","هيهات يوم الحساب منقلبُهْ",61,"ب",2,0],["كم قائلٍ لك إذ مَسّتك قارعتي","دع السكونَ فهذا حينُ مضطَربِ",62,"ب",1,0],["كمْ قدْ هَتَفْتُ وما أريدُ سِوَاكُمُ","بَرحَ الخفاءُ ولو عَدَلْتُمْ ما بَرحْ",63,"ح",1,0],["كم قد صَبَرتُ ونَالَ غيري نَيْلَهُ","وفَسَحْتُ في عذْرٍ وإن لم يَنْفَسِحْ",63,"ح",1,0],["كم قد نعمنا بضمِّ مُتَّشحٍ","وما اعتدينا بهَتْك مؤتزرِ",64,"ر",1,0],["كم قد شربت الرضاب في قُبَل","كانت ولكن شربت بالغُمرِ",64,"ر",1,0],["كم قد سموتم بأيديكم إلى شرفٍ","لم يسمُ قطّ له قوم بأبصار",65,"ر",1,0],["كم قائل حين قيل إن أبا","إسحاق غادٍ غد