{"poems":[[95,"أي رزء دهاك يا سمعان","https://www.aldiwan.net/poem11258.html","الخفيف"],[71,"في الزهر جاء الصيام فاعترضت","https://www.aldiwan.net/poem28608.html","المنسرح"],[190,"في الزمن الفاسد لا تختلط","https://www.aldiwan.net/poem43808.html","السريع"],[385,"ماذا يهيجك من صباك الأقدم","https://www.aldiwan.net/poem48758.html","الكامل"],[484,"فلتحى تونس وليعش","https://www.aldiwan.net/poem37624.html","مجزوء الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25344","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126187","الكامل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122081","الكامل"],[1543,"","https://poetry.dctabudhabi.ae/diwan/poem/216296",""],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108838","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27524","الرجز"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77305","الرمل"],[4325,"","https://poetry.dctabudhabi.ae/diwan/poem/29456","الكامل"],[4956,"من الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=1393",""],[4984,"صدى الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=175802",""]],"verses":[["فِي الزَّمَانِ القَرِيبِ وَاحَرَّ قَلْباً","أَيْنَ أَمْسَى فِي الغَيْبِ ذَاكَ الزَّمَانُ",0,"ن",1,0],["في الزهرِ جاءَ الصيامُ فاعترضَتْ","حبيبتي قلتُ لا أدنِّسُهُ",1,"ه",1,1],["في الزمن الفاسد لا تختلط","فيه بخلق ودع الفخرا",2,"ر",2,1],["في الزُهد أَحمَد وَالنَباهة مالك","وَأَبو حَنيفة وَالأَغَرّ الهاشِمي",3,"م",2,0],["في الزاهرات نثيرها","في المنشئات نظيمها",4,"م",3,0],["فِي الزَرْبِ لَوْ يَمْضَعُ شَرياً ما بَصَقْ","لَمَّا تَسَوَّى فِي ضَئِيلِ المُنْدَمَقْ",5,"ق",1,0],["في الزهد والعلم الشريف وفي التقى","ولكل طاغ من غوايته هدى",6,"د",2,0],["فِي الزُّهْدِ وَالعِلْمِ الإِلهِي اقْتَدَى","بِالشَّيْخِ بَرْهِيمَ الرِّضَى الخَوَّاصِ",7,"ص",1,0],["في الزمايم دون من يدّه","صاحبي اللي مَرّث اتلافِ",8,"ف",1,0],["في الزمان الذي صفا","من قريض ومن حكم",9,"م",1,0],["في الزمن الفردِ الذي أثبته","لطالب البرهان بالفكر السديد",10,"د",1,0],["في الزِراعاتِ الَّتي كانَت بِها","خُلدُ عَنخٍ طاقَةٌ لَم تَذبُلِ",11,"ل",1,0],["في الزاهِقاتِ وَفي الحُمُولِ وَفي التي","أَبقَت سَناماً كالغَري المُجسَدِ",12,"د",1,0],["فيا لزمان مضى خلسة","أما لك من عودة ترتجى ؟",13,"ا",1,0],["فيا لزمان كيف حلت بأهله","مصائب عمت منذ وقت وآنيا",14,"ن",3,0]]}