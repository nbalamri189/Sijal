{"poems":[[63,"وغادة تشهد الحسان لها","https://www.aldiwan.net/poem45708.html","المنسرح"],[63,"أماط والليل أثيث الجناح","https://www.aldiwan.net/poem46168.html","السريع"],[10,"يا عين إبكي فارسا","https://www.aldiwan.net/poem21103.html","مجزوء الكامل"],[70,"نحن كضربتين في معركة","https://www.aldiwan.net/poem42409.html","المنسرح"],[38,"عجبت من السارين والريح قرة","https://www.aldiwan.net/poem7684.html","الطويل"],[85,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[61,"وطيب النشر عبق","https://www.aldiwan.net/poem51526.html","مجزوء الرجز"],[66,"خلع لربيع على غصون البان","https://www.aldiwan.net/poem41381.html","الكامل"],[66,"فيروزج الصبح أم يا قوتة الشفق","https://www.aldiwan.net/poem41544.html","البسيط"],[80,"متى ينال لديكم ما يؤمله","https://www.aldiwan.net/poem31341.html","البسيط"],[69,"دمشق قل ما شئت في حسنها","https://www.aldiwan.net/poem28677.html","السريع"],[69,"يا سائلي عن الكلام المنتظم","https://www.aldiwan.net/poem28850.html","الرجز"],[39,"لا تسكنن إلى سكون إنما","https://www.aldiwan.net/poem53742.html","الكامل"],[48,"قام الأمين بأمر الله في البشر","https://www.aldiwan.net/poem63359.html","الطويل"],[46,"أكتم حديثك عن أخيك ولا تكن","https://www.aldiwan.net/poem22483.html","الكامل"],[46,"إذا أمنت على مال أخا ثقة","https://www.aldiwan.net/poem23392.html","البسيط"],[46,"يا قوت ما أنت ياقوت ولا ذهب","https://www.aldiwan.net/poem23479.html","البسيط"],[15,"أقفر من مية الدوافع من","https://www.aldiwan.net/poem45255.html","المنسرح"],[76,"بالمنذر بن محمد","https://www.aldiwan.net/poem39286.html","مجزوء الكامل"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/65998","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42700","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54576","السريع"],[46,"أكتمْ حديثَكَ عن أخيك، ولا تكنْ","https://www.poetsgate.com/ViewPoem.aspx?id=18585",""],[87,"بَكرَ النَدى ، وترفعَ السدَفُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24033&r=&rc=295",""],[113,"تعذيب قلبي في هواك حلالي","https://www.aldiwan.net/poem40601.html","عموديه"],[125,"طرقت أسيماء الرحال ودوننا","https://www.aldiwan.net/poem24275.html","الكامل"],[148,"لاح وقد فاح بهار النهار","https://www.aldiwan.net/poem68475.html","السريع"],[158,"بشراك بشراك هبت نسمة الفلق","https://www.aldiwan.net/poem59101.html","البسيط"],[164,"يا من طلعت طلوع الشمس من فلك","https://www.aldiwan.net/poem46901.html","البسيط"],[183,"احفظ ولا تنس فإن لم تكن","https://www.aldiwan.net/poem14105.html","السريع"],[195,"إعزف على العود يا معبودي الثاني","https://www.aldiwan.net/poem39888.html","البسيط"],[196,"يا شمس خدر مالها مغرب","https://www.aldiwan.net/poem51986.html","السريع"],[230,"في وجهه لذوي التصابي روضة","https://www.aldiwan.net/poem14879.html","الكامل"],[233,"نار جوى في الضلوع تتقد","https://www.aldiwan.net/poem32028.html","المنسرح"],[235,"يا أخا اللب يا بديع القيل","https://www.aldiwan.net/poem18869.html","الخفيف"],[269,"ضحك تبروق الابرقين تبسما","https://www.aldiwan.net/poem52106.html","الكامل"],[280,"لا والمطايا ذللا في البرى","https://www.aldiwan.net/poem32765.html","السريع"],[295,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[295,"وافى خيالك بعد طول نفار","https://www.aldiwan.net/poem33268.html","الكامل"],[301,"انهض إلى الربوة مستمتعا","https://www.aldiwan.net/poem57827.html","السريع"],[303,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[311,"ما بال نفس تطيل شكواها","https://www.aldiwan.net/poem59508.html","المنسرح"],[362,"بكر العواذل أن رأين خصاصتي","https://www.aldiwan.net/poem60953.html","الكامل"],[362,"من حسن عهد للخليط المنجد","https://www.aldiwan.net/poem60960.html","الكامل"],[374,"يا راهبا يبغي السلوك على وجل","https://www.aldiwan.net/poem59288.html","الكامل"],[374,"دنت العناصر من علائك","https://www.aldiwan.net/poem59306.html","مجزوء الكامل"],[413,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[438,"حتى متى أنا حي بين أموات","https://www.aldiwan.net/poem14438.html","البسيط"],[451,"هدر تلكمو الدماء الزكيه","https://www.aldiwan.net/poem61604.html","الخفيف"],[459,"الله جارك من أخي شرف","https://www.aldiwan.net/poem15448.html","أحذ الكامل"],[459,"نيطت حمائل سيفه","https://www.aldiwan.net/poem16105.html","مجزوء الكامل"],[462,"وصل السقام فصد عن لوامه","https://www.aldiwan.net/poem3475.html","عموديه"],[462,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"],[466,"غاد الصبوح مع الصباح المسفر","https://www.aldiwan.net/poem60083.html","الكامل"],[466,"يا أيها الرشأ الذي","https://www.aldiwan.net/poem60235.html","مجزوء الكامل"],[466,"اخلع على العين حلة الطرب","https://www.aldiwan.net/poem60451.html","المنسرح"],[498,"يا آخذا بيد الضعيف إذا وهت","https://www.aldiwan.net/poem37560.html","الكامل"],[556,"من مات يعلم أنك الحق المبين","https://www.aldiwan.net/poem33797.html","الكامل"],[573,"إن كنت ترغب أن ترانا فالقنا","https://www.aldiwan.net/poem3003.html","الكامل"],[573,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"]],"verses":[["فالطَّرفُ مُذ غِبتُ عَنكَ يُسهِرُهُ","ذِكرى لَيالٍ قَد كانَ يَرقُدُها",0,"د",3,0],["فالطَّرْفُ إن مرَّضَهُ نَرْجِسٌ","والخَدُّ وَرْدٌ والثّغورُ الأقاحْ",1,"ح",1,0],["فَالطَيرُ بَينَ مُراوِدٍ","يَدنو وَآخَرَ مُنتَهِس",2,"س",1,0],["فَاِلطُف بِها وَاِغتَفِر لَها كَرَماً","إِنَّكَ خَلّاقُها وَمَولاها",3,"ا",3,0],["فَأَلطَفتُ عَيني هَل أَرى مِن سَمينَةٍ","وَوَطَّنتُ نَفسي لِلغَرامَةِ وَالقِرى",4,"ا",1,0],["فَاِلطُف لِأَجلِ رَسولِ العالَمينَ بِنا","وَلا تَزِد قَومَهُ خَسفاً وَلا تُسِمِ",5,"م",1,0],["فالطَّيرُ من حُرٍّ دُجىً","مَلكَةٌ ومُستَرقْ",6,"ق",1,0],["فَالطَيرُ تَلجَأُ بِالحُصونِ لِأَنَّها","بِنَداهُ لَم تَأمَن مِنَ الطَوفانِ",7,"ن",1,0],["فَالطَيرُ في طَرَبٍ وَالسُحبُ في حَربٍ","وَالماءُ في هَرَبٍ وَالغُصنُ في قَلَقِ",8,"ق",1,0],["فالطبّ يُسْقِمُهُ والماءُ يُعطشُهُ","والقربُ يبعدُهُ والصّوْنُ يَبذُلُهُ",9,"ل",2,0],["فالطيرُ قد غنَّى على عودِهِ","في الروضِ بينَ الدفِّ والجنك",10,"ك",1,0],["فالطرفُ سيفٌ قتْلَنا تضمَّنا","فهْوَ كما لو كانَ فعلاً بيِّنا",11,"ن",2,0],["فَالطَيرُ لَولا أَنَّها جَوّالَةٌ","لَم تُلفِ في أَوكارِهِنَّ المَطعَما",12,"م",2,0],["فَالطَيرُ تُخبِرُنا وَالطَيرُ صادِقَةٌ","عَن طيبِ عَيشٍ وَعَن طولٍ مِنَ العُمُرِ",13,"ر",1,0],["فَالطَيرُ سَودَدُها الرَفيعُ وَعُزُّها","قُسِما عالى خُطَبائِها وَالصَيَّدِ",14,"د",1,0],["فَالطَبعُ في كُلِّ جيلٍ طَبعُ مَلأَمَةٍ","وَلَيسَ في الطَبعِ مَجبولٌ عَلى الكَرَمِ",15,"م",1,0],["فَالطَبعُ يَكسِرُ بَيتاً أَو يُقَوِّمُهُ","بِأَهوَنِ السَعيِ تَحريكاً وَتسكينا",16,"ن",2,0],["فَالطَلبُ فَالحَدُّ مِن تَبالَةَ لا","عَهدَ لَهُ بِالأَنيسِ ما فَعَلوا",17,"ل",3,0],["فالطيرُ فِيها ساكِنٌ","والوحْشُ فِيها قد أنسْ",18,"س",1,0],["فالطَّير قدْ أغفتْ وأَسْكَتَ","صوتَها اللَّيلُ الهَيُوبْ",19,"ب",1,0],["فَالطَّلُّ مُنْتَشِرٌ وَمُنْتَظِمٌ","وَالْغُصْنُ مُفْتَرِقٌ وَمُؤْتَلِفُ",20,"ف",1,0],["فالطَائِرُ الْغِرِّيدُ فِي رَوْضِهَا","أَسْكَتهُ حَيْنَا تَنَاهِي الطَّرَبْ",21,"ب",1,0],["فالطيرُ سؤدَدُها الرفيعُ، وعزُّها","، قُسِما على خُطبائها والصُّيّد",22,"د",1,0],["فالطَّلُ مُنتثِرٌ ، ومُنتظِمٌ","وَالْغُصْنُ مُفْتَرِقٌ، وَمُؤْتَلِفُ",23,"ف",1,0],["فالطف بأمري يا كريم فإنني","في باب جودك قد انخت رحالي",24,"ل",2,0],["فَالطَودُ فَالمَلَكاتُ أَصبَحَ دونَها","فَفِراعُ قُدسَ فَعُمقُها فَحُسوبُ",25,"ب",1,0],["فالطلُّ في مفرقه بهجة","تاج وفي المعصم منه سوار",26,"ر",1,0],["فالطير تشدو لتصفيق الغدير لها","والدوح يرقص رقص التايه الملق",27,"ق",1,0],["فالطبعُ صائغُ حَلْيٍ من سبائكهِ","وأنتَ ناقدُ تبرٍ منهُ مُنْسبكِ",28,"ك",1,0],["فالطالبُ الأَبْلهُ مَعْ ما به","أفضلُ من ذي فِطْنٍة م طَلَب",29,"ب",1,0],["فالطرف جفّ وسال الروح من شجنٍ","دمعا وفاضت به ويلاهُ عينان",30,"ن",1,0],["فالطرسُ مذ أُلبسَ منها حُلىً","تحسُدُهُ العذراءُ والشُّيبُ",31,"ب",1,0],["فَالطَرفُ نَرجِسُهُ جُعِلتُ لَهُ الفِدا","وَالخَدُّ وَردٌ وَالعذارُ بِنَفسَجُ",32,"ج",1,0],["فَالطِرفُ وَالعَضبُ وَالمُفاضَةُ وَال","عَذراءُ مِنها وَالجَسرَةُ الأَجُدُ",33,"د",1,0],["فَالطِّبَاعُ لاَ تَجْتَوِيهِ وَإِنْ كَا","نَ عَرِيقاً فِي الْحَظْرِ بِالتَّأْصِيلِ",34,"ل",1,0],["فالطف به واعطف عليه وكن له","حصنا من الخطب النظيم وَملزما",35,"م",2,0],["فَالطرفُ لَيثٌ وَهوَ صَقر وَفي ال","رُمحِ عُقابٌ عانَقَت أَسمَرا",36,"ر",2,0],["فالطعن بالكلام","عند أُولي الأَحلامِ",37,"م",1,0],["فالطَرفُ من إِشراقِه متردِّدٌ","ما بين بدرِ دجىً وَشَمسِ نَهارِ",38,"ر",1,0],["فالطير قد غنى على عوده","في الروض بين الجنك والدف",39,"ف",1,0],["فَالطيّباتُ اليومَ مُذهبةٌ غداً","عمّن بِها لِرعونةٍ يستمتعُ",40,"ع",1,0],["فألطف بها واغتفر خطيئتها","أنك خلاقها ومولاها",41,"ا",3,0],["فالطَّرْفُ منه يَجولُ لاستِحسانهِ","ويحَارُ في التّصويبِ والتّصْعيد",42,"د",1,0],["فالطّودُ يَهزأُ بالعواصف كلمّا","لَعِبتْ بخُوطِ البانةِ المُتأود",43,"د",1,0],["فالطاعة الكبرى كبيرٌ قدرها","أسنى الذبائح عند مولاك الأجل",44,"ل",1,0],["فالطف به أنت الرجا","ء وليس ييأس من رجائك",45,"ك",1,0],["فألطف آثار الحبيب طلولها","وأنفسُ أطرار السيوف نصولها",46,"ه",2,0],["فالطاء والضاد والراءات قد سلبت","مني فرعياً لطاءاتي وراءاتي",47,"ي",1,0],["فالطموهُم برتبةٍ ووسامٍ","إنَّ ألقابهم معانٍ دنيَّه",48,"ي",2,0],["فالطِّرْسُ والبيداءُ مِلْؤهُما","خيْلٌ تكُرُّ وأسْطُرٌ تَجفُ",49,"ف",1,0],["فالطِّرْسُ كالهَيْجاءِ يُعْ","رِبُ عن أسيرٍ أو صَريعِ",50,"ع",1,0],["فالطرف بين صباحهِ وسهاده","ما بات بين جفونه ومنامهِ",51,"م",2,0],["فالطريفُ الحديثُ مستندٌ منهُ","إلى تلكمُ الأصولِ التلد",52,"د",1,0],["فَالطَلُّ مِن فَوقِ الشَفيقِ كَلُؤلُؤٍ","رَطبٍ عَلى رَطبِ العَقيقِ الأَحمَرِ",53,"ر",1,0],["فَالطَلُّ كافورٌ عَلى","مِسكِ الثَرى وَالغَيمُ نَدُّ",54,"د",1,0],["فَالطَلُّ فَوقَ البِهارِ مُنتَثِرٌ","كَأَنَّهُ فِضَّةٌ عَلى ذَهَبِ",55,"ب",1,0],["فالطف به واجبر بفضلك كسره","فبك استنار بغيبه إيمانه",56,"ن",2,0],["فالطف بنا وامنن علينا بالذي","نرجوه منك ولا تدعْنا حائرينْ",57,"ن",1,0],["فالطِّرسُ ساحةُ فِضَّةٍ وسطُوره","مِسْكٌ تُفرِّعُه اليراعةُ أَغْصُنا",58,"ن",2,0],["فالطَّيفُ معنىً عند عش","قِي ليس بالمفْهومِ",59,"م",1,0]]}