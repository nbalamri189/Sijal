w.poetsgate.com/ViewPoem.aspx?id=29850",""],[5111,"خَيْمَةُ الشِّعْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=212612",""],[5145,"في كفه من بنات الماء طائفة","https://www.poetsgate.com/ViewPoem.aspx?id=108112",""],[5183,"صفو الحب","https://www.poetsgate.com/ViewPoem.aspx?id=186608",""],[5302,"محنة مسلمي الروهينغا","https://www.poetsgate.com/ViewPoem.aspx?id=201898",""],[5320,"صيحة الثأر","https://www.poetsgate.com/ViewPoem.aspx?id=40397",""],[5363,"ربّاهُ آمالي بجودك لائذهْ","https://www.poetsgate.com/ViewPoem.aspx?id=199944",""],[5431,"إنّ الإباء لنا من مائه بردى ....","https://www.poetsgate.com/ViewPoem.aspx?id=197082",""],[5431,"قلق الوجود...جلجامش التيه!","https://www.poetsgate.com/ViewPoem.aspx?id=201040",""],[5695,"براءة ووفاء..","https://www.poetsgate.com/ViewPoem.aspx?id=212553",""],[5718,"السعادة","https://www.poetsgate.com/ViewPoem.aspx?id=214026",""],[5747,"لا تقصر الفنجال","https://www.poetsgate.com/ViewPoem.aspx?id=61659",""],[5790,"قسما بقدك وهو لدن ذابلُ","https://www.poetsgate.com/ViewPoem.aspx?id=112103",""],[5845,"الحبُّ مسألة ٌبغيرِ جوابِ","https://www.poetsgate.com/ViewPoem.aspx?id=16702",""],[5853,"مرثية في خالي/ منصور مجلي يرحمه الله","https://www.poetsgate.com/ViewPoem.aspx?id=175733",""],[6052,"حلية التقى","https://www.poetsgate.com/ViewPoem.aspx?id=34891",""],[6082,"الطفل","https://www.poetsgate.com/ViewPoem.aspx?id=58947",""],[5377,"من أحرار اليمن إلى أحرار العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79560&r=&rc=16",""],[243,"صحيفة الأحرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68182&r=&rc=174",""],[6225,"أنِين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81027&r=&rc=264",""],[5001,"وهتفت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80716&r=&rc=6",""]],"verses":[["فالطَّرفُ مُذ غِبتُ عَنكَ يُسهِرُهُ","ذِكرى لَيالٍ قَد كانَ يَرقُدُها",0,"د",3,0],["فالطَّرْفُ إن مرَّضَهُ نَرْجِسٌ","والخَدُّ وَرْدٌ والثّغورُ الأقاحْ",1,"ح",1,0],["فَالطَيرُ بَينَ مُراوِدٍ","يَدنو وَآخَرَ مُنتَهِس",2,"س",1,0],["فَاِلطُف بِها وَاِغتَفِر لَها كَرَماً","إِنَّكَ خَلّاقُها وَمَولاها",3,"ا",3,0],["فَأَلطَفتُ عَيني هَل أَرى مِن سَمينَةٍ","وَوَطَّنتُ نَفسي لِلغَرامَةِ وَالقِرى",4,"ا",1,0],["فَاِلطُف لِأَجلِ رَسولِ العالَمينَ بِنا","وَلا تَزِد قَومَهُ خَسفاً وَلا تُسِمِ",5,"م",1,0],["فالطَّيرُ من حُرٍّ دُجىً","مَلكَةٌ ومُستَرقْ",6,"ق",1,0],["فَالطَيرُ تَلجَأُ بِالحُصونِ لِأَنَّها","بِنَداهُ لَم تَأمَن مِنَ الطَوفانِ",7,"ن",1,0],["فَالطَيرُ في طَرَبٍ وَالسُحبُ في حَربٍ","وَالماءُ في هَرَبٍ وَالغُصنُ في قَلَقِ",8,"ق",1,0],["فالطبّ يُسْقِمُهُ والماءُ يُعطشُهُ","والقربُ يبعدُهُ والصّوْنُ يَبذُلُهُ",9,"ل",2,0],["فالطيرُ قد غنَّى على عودِهِ","في الروضِ بينَ الدفِّ والجنك",10,"ك",1,0],["فالطرفُ سيفٌ قتْلَنا تضمَّنا","فهْوَ كما لو كانَ فعلاً بيِّنا",11,"ن",2,0],["فَالطَيرُ لَولا أَنَّها جَوّالَةٌ","لَم تُلفِ في أَوكارِهِنَّ المَطعَما",12,"م",2,0],["فَالطَيرُ تُخبِرُنا وَالطَيرُ صادِقَةٌ","عَن طيبِ عَيشٍ وَعَن طولٍ مِنَ العُمُرِ",13,"ر",1,0],["فَالطَيرُ سَودَدُها الرَفيعُ وَعُزُّها","قُسِما عالى خُطَبائِها وَالصَيَّدِ",14,"د",1,0],["فَالطَبعُ في كُلِّ جيلٍ طَبعُ مَلأَمَةٍ","وَلَيسَ في الطَبعِ مَجبولٌ عَلى الكَرَمِ",15,"م",1,0],["فَالطَبعُ يَكسِرُ بَيتاً أَو يُقَوِّمُهُ","بِأَهوَنِ السَعيِ تَحريكاً وَتسكينا",16,"ن",2,0],["فَالطَلبُ فَالحَدُّ مِن تَبالَةَ لا","عَهدَ لَهُ بِالأَنيسِ ما فَعَلوا",17,"ل",3,0],["فالطيرُ فِيها ساكِنٌ","والوحْشُ فِيها قد أنسْ",18,"س",1,0],["فالطَّير قدْ أغفتْ وأَسْكَتَ","صوتَها اللَّيلُ الهَيُوبْ",19,"ب",1,0],["فَالطَّلُّ مُنْتَشِرٌ وَمُنْتَظِمٌ","وَالْغُصْنُ مُفْتَرِقٌ وَمُؤْتَلِفُ",20,"ف",1,0],["فالطَائِرُ الْغِرِّيدُ فِي رَوْضِهَا","أَسْكَتهُ حَيْنَا تَنَاهِي الطَّرَبْ",21,"ب",1,0],["فالطيرُ سؤدَدُها الرفيعُ، وعزُّها","، قُسِما على خُطبائها والصُّيّد",22,"د",1,0],["فالطَّلُ مُنتثِرٌ ، ومُنتظِمٌ","وَالْغُصْنُ مُفْتَرِقٌ، وَمُؤْتَلِفُ",23,"ف",1,0],["فالطف بأمري يا كريم فإنني","في باب جودك قد انخت رحالي",24,"ل",2,0],["فَالطَودُ فَالمَلَكاتُ أَصبَحَ دونَها","فَفِراعُ قُدسَ فَعُمقُها فَحُسوبُ",25,"ب",1,0],["فالطلُّ في مفرقه بهجة","تاج وفي المعصم منه سوار",26,"ر",1,0],["فالطير تشدو لتصفيق الغدير لها","والدوح يرقص رقص التايه الملق",27,"ق",1,0],["فالطبعُ صائغُ حَلْيٍ من سبائكهِ","وأنتَ ناقدُ تبرٍ منهُ مُنْسبكِ",28,"ك",1,0],["فالطالبُ الأَبْلهُ مَعْ ما به","أفضلُ من ذي فِطْنٍة م طَلَب",29,"ب",1,0],["فالطرف جفّ وسال الروح من شجنٍ","دمعا وفاضت به ويلاهُ عينان",30,"ن",1,0],["فالطرسُ مذ أُلبسَ منها حُلىً","تحسُدُهُ العذراءُ والشُّيبُ",31,"ب",1,0],["فَالطَرفُ نَرجِسُهُ جُعِلتُ لَهُ الفِدا","وَالخَدُّ وَردٌ وَالعذارُ بِنَفسَجُ",32,"ج",1,0],["فَالطِرفُ وَالعَضبُ وَالمُفاضَةُ وَال","عَذراءُ مِنها وَالجَسرَةُ الأَجُدُ",33,"د",1,0],["فَالطِّبَاعُ لاَ تَجْتَوِيهِ وَإِنْ كَا","نَ عَرِيقاً فِي الْحَظْرِ بِالتَّأْصِيلِ",34,"ل",1,0],["فالطف به واعطف عليه وكن له","حصنا من الخطب النظيم وَملزما",35,"م",2,0],["فَالطرفُ لَيثٌ وَهوَ صَقر وَفي ال","رُمحِ عُقابٌ عانَقَت أَسمَرا",36,"ر",2,0],["فالطعن بالكلام","عند أُولي الأَحلامِ",37,"م",1,0],["فالطَرفُ من إِشراقِه متردِّدٌ","ما بين بدرِ دجىً وَشَمسِ نَهارِ",38,"ر",1,0],["فالطير قد غنى على عوده","في الروض بين الجنك والدف",39,"ف",1,0],["فَالطيّباتُ اليومَ مُذهبةٌ غداً","عمّن بِها لِرعونةٍ يستمتعُ",40,"ع",1,0],["فألطف بها واغتفر خطيئتها","أنك خلاقها ومولاها",41,"ا",3,0],["فالطَّرْفُ منه يَجولُ لاستِحسانهِ","ويحَارُ في التّصويبِ والتّصْعيد",42,"د",1,0],["فالطّودُ يَهزأُ بالعواصف كلمّا","لَعِبتْ بخُوطِ البانةِ المُتأود",43,"د",1,0],["فالطاعة الكبرى كبيرٌ قدرها","أسنى الذبائح عند مولاك الأجل",44,"ل",1,0],["فالطف به أنت الرجا","ء وليس ييأس من رجائك",45,"ك",1,0],["فألطف آثار الحبيب طلولها","وأنفسُ أطرار السيوف نصولها",46,"ه",2,0],["فالطاء والضاد والراءات قد سلبت","مني فرعياً لطاءاتي وراءاتي",47,"ت",2,0],["فالطموهُم برتبةٍ ووسامٍ","إنَّ ألقابهم معانٍ دنيَّه",48,"ي",2,0],["فالطِّرْسُ والبيداءُ مِلْؤهُما","خيْلٌ تكُرُّ وأسْطُرٌ تَجفُ",49,"ف",1,0],["فالطِّرْسُ كالهَيْجاءِ يُعْ","رِبُ عن أسيرٍ أو صَريعِ",50,"ع",1,0],["فالطرف بين صباحهِ وسهاده","ما بات بين جفونه ومنامهِ",51,"م",2,0],["فالطريفُ الحديثُ مستندٌ منهُ","إلى تلكمُ الأصولِ التلد",52,"د",1,0],["فَالطَلُّ مِن فَوقِ الشَفيقِ كَلُؤلُؤٍ","رَطبٍ عَلى رَطبِ العَقيقِ 