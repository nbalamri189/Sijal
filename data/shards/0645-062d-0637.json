{"poems":[[34,"زوروا بثينة فالحبيب مزور","https://www.aldiwan.net/poem27803.html","الكامل"],[33,"أأقام أمس خليطنا أم سارا","https://www.aldiwan.net/poem42537.html","الكامل"],[7,"أمن آل مية رائح أو مغتد","https://www.aldiwan.net/poem2002.html","الكامل"],[215,"محطة الرمل جننتني","https://www.aldiwan.net/poem46262.html","مخلع البسيط"],[244,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[266,"أمنيك يا قلبي وعز وصول","https://www.aldiwan.net/poem38211.html","الطويل"],[333,"أراقت عليها معاني الفناء","https://www.aldiwan.net/poem54979.html","المتقارب"],[466,"لله در غمام سح صيبه","https://www.aldiwan.net/poem15914.html","البسيط"],[567,"سرى جنح ليل والعيون هواجع","https://www.aldiwan.net/poem52871.html","الطويل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96977","الطويل"],[713,"","https://poetry.dctabudhabi.ae/diwan/poem/104863","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63818","الوافر"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/167817","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77206","المجتث"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132314","الطويل"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84922","السريع"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109819","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204720","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74179","الطويل"],[3277,"","https://poetry.dctabudhabi.ae/diwan/poem/125989","المتقارب"],[3386,"","https://poetry.dctabudhabi.ae/diwan/poem/124618","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48437","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66427","المتقارب"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114555","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123524","الطويل"],[4578,"عقودُ ودادي نظمها ليس يفسخ","https://www.poetsgate.com/ViewPoem.aspx?id=49389",""],[5005,"على حافة الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=208150",""],[5277,"لا فرق عندي","https://www.poetsgate.com/ViewPoem.aspx?id=190717",""],[5277,"قلبٌ على الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=200768",""],[5277,"غصنٌ منفرد..","https://www.poetsgate.com/ViewPoem.aspx?id=205100",""],[5411,"خلف الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=195063",""],[5564,"ياللْه يا كافي الأمور الشدايد","https://www.poetsgate.com/ViewPoem.aspx?id=186845",""],[5605,"مرثية حنان الآغا","https://www.poetsgate.com/ViewPoem.aspx?id=159625",""],[5956,"يُغَرّد لي الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=194624",""],[6320,"جَوَى الأَشْجَان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84337&r=&rc=34",""]],"verses":[["مَحطوطَةُ المَتنَينِ مُضمَرَةُ الحَشا","رَيّا الرَوادِفِ خَلقُها مَمكورُ",0,"ر",1,0],["مَحطوطَةَ المَتنَينِ أُكمِلَ خَلقُها","مِثلَ السَبيكَةِ بَضَّةً مِعطارا",1,"ر",2,0],["مَحطوطَةُ المَتنَينِ غَيرُ مُفاضَةٍ","رَيّا الرَوادِفِ بَضَّةُ المُتَجَرَّدِ",2,"د",1,0],["محطة الرمل جننتني","وصيرتني بلا صواب",3,"ب",1,1],["محط المنى للمسلمين جميعهم","وحامي الحمى تحنو عليه وتحدب",4,"ب",1,0],["محط رحال الوفد اما رحابه","فساح واما ظله فظليل",5,"ل",1,0],["محطّمةٌ كأماني الجياع","مغلّفةٌ بتراب العدم",6,"م",1,0],["محطِّمُ السمر يوم الروع في مُقلٍ","ومُغْمِدُ الهند وانياتِ في القِمِ",7,"م",1,0],["مَحَطُّ رِحالِ العلمِ في كُلِّ حِقبةٍ","هيَ الأُمُّ والأقطارُ منها رواضعُ",8,"ع",1,0],["محطمةً أرماحها في صدورها","ومغمدة بالهام منها نصالها",9,"ل",3,0],["محط رجال المجتدين من الهدى","إليه إذا زمو لديه إذا حطوا",10,"ط",3,0],["محطَّ رحالِ سَفْرٍ بعد سَفْرٍ","يزيدُ ولا يبيدُ على الدُّهور",11,"ر",1,0],["محط صبابات، ومنشأ صبوة","ومنزع أشواق إلى حضرة القدس",12,"س",1,0],["مَحَطَّةُ الرَملِ هَذي","أَم ذَلِكَ المِعراجُ",13,"ج",1,1],["مَحَطَّ رحالِ الكائِناتِ وقُطبَهَا","ورايةَ أعلامِ المَلا والسِّيادَةِ",14,"ه",1,0],["مَحطة في قَوص مَمقوتة","وَكَم حَوَت مِن ظالم فاجر",15,"ر",1,1],["محطة هي قلب والخطوط بدت","مثل الشرايين فيها والقطار دما",16,"م",2,0],["محطم الجسم روحي فيه سالمة","لذا إذا قلت شعرا جاء جبّارا",17,"ر",2,1],["محط حال الوافِدين وَكَهفهم","إِذا جارَ فيهم جائر الدَهر وَاِعتَدى",18,"د",2,0],["محطّ رحال رجال العلوم","وأهل الفنون وأهل السلوك",19,"ك",1,0],["محطّ رحال العلم والسر والتقى","ومجرى ينابيع الهدى في القبائل",20,"ل",1,0],["محطٌّ لأوْزارِ العُفاةِ ومرْحَلٌ","وقصْدٌ لطُلابِ الرّضى ومُيمَّمُ",21,"م",1,0],["محطّ الرّحال وليث النّزال","وغيث النّوال وكلّ المنى",22,"ن",2,0],["محطِّ بديعٍ مُفردٍ ذي أناملٍ","بكتها الدواةُ واليراعَةُ والنقسُ",23,"س",1,0],["محط رحال المجد والفخر والعلا","عماد علوم الكون قطب رحاها",24,"ا",3,0],["محط رحال المعدمين وقصدهم","فنجبُ الرجا في باب علياه نوّخُ",25,"خ",1,0],["محطَّتي صُورٌ من ذكرياتِ هوًى","يَمضي القطارُ فلا يبقى لها أثرُ",26,"ر",1,0],["محطَّمةٌ تلكَ السدودُ فجرجري","قلاعاً أُحِطْنَ السيفَ بعدَ التعصُّمِ",27,"م",1,0],["محطّاتُ الفؤادِ لها انتظارُ","فوا لهفي إذا طالَ انتظارُ",28,"ر",1,0],["محطّاتُ العبورِ على طريقي","صخورٌ ليس تؤمنُ بالقناطرْ",29,"ر",1,0],["محطَّمٌ فيَّ هذا القلبُ مُنْذُ هَوى","وَالشِّعْرُ آلَ عَنِ الأَوْجاعِ مُنْتَدبا",30,"ب",2,0],["محطْ الاصابيع الثّلاث العدايد","هطفى الزناد وطيحته من غواها",31,"ا",3,0],["مَحَطَتُنَا بفانيةٍ عبور","وَدُنْيَانَا يُشَاكِسُهَا امتحانُ",32,"ن",1,0],["محطمُ قيد يأسي مرتقٍ بي","لأعلى معنويات النجومِ",33,"م",1,0],["مُحَطَّمَ النَّفْسِ فِي غِلٍّ يَنُوحُ بِهِ","قَهْرِي وَقَدْ مَزَّقَتْ أَسْيَافِيَ الإِرَبُ",34,"ب",1,0]]}