{"poems":[[95,"تمضي وأنت مضنة الأوطان","https://www.aldiwan.net/poem11245.html","الكامل"],[53,"لا تلح من تفتنه قينه","https://www.aldiwan.net/poem66452.html","السريع"],[80,"العين بعدك تقذي","https://www.aldiwan.net/poem14169.html","المجتث"],[89,"أخذ الكرى بمعاقد الأجفان","https://www.aldiwan.net/poem8239.html","الكامل"],[22,"يا دار هند عفت إلا أثافيها","https://www.aldiwan.net/poem22028.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85834","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54981","الكامل"],[108,"رثاء طيارين!","https://www.poetsgate.com/ViewPoem.aspx?id=179490",""],[215,"يا نجوم الفنون والدهر ليل","https://www.aldiwan.net/poem46602.html","الخفيف"],[369,"أشبه دهري أبناؤه فهم","https://www.aldiwan.net/poem60655.html","المنسرح"],[369,"خفض عليك وإن أطلت تأملا","https://www.aldiwan.net/poem60805.html","الكامل"],[411,"نحن في النزهة والمتعة","https://www.aldiwan.net/poem49915.html","مجزوء الرمل"],[411,"لا انس إلا في مجالس تلتقي","https://www.aldiwan.net/poem50123.html","الكامل"],[422,"شام برقا راعه مبتسما","https://www.aldiwan.net/poem53999.html","الرمل"],[463,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[556,"أمن أجل أن أعفاك دهرك تطمع","https://www.aldiwan.net/poem47720.html","الطويل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71083","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48270","البسيط"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96025","الكامل"],[2173,"","https://poetry.dctabudhabi.ae/diwan/poem/142784","السريع"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110614","الرمل"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101688","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203481","الوافر"],[3625,"","https://poetry.dctabudhabi.ae/diwan/poem/204075","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109972","الرمل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66577","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120293","المقتضب"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139580",""],[5145,"وصل الكتاب وكان أكرم واصلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=108243",""],[5943,"ومحمد روحي فداهُ","https://www.poetsgate.com/ViewPoem.aspx?id=11707",""]],"verses":[["فَلْيُجْمِلِ اللهُ العَلِيُّ ثَوَابَهُ","وَيُقِرَّهُ فِي خَالِدَاتِ جِنَانِ",0,"ن",1,0],["فليجتهدْ من شاء في عيبها","فما يساوي قوله تِبنَهْ",1,"ن",2,0],["فَليَجلُ شخصُكَ عَنها","ما بِالمَغِيب جَناهُ",2,"ه",1,0],["فَلْيَجْرِ بَعْدُ كَمَا أَرَادَ بِنَفْسِهِ","إِنّ الشَّقِيَّ مَطِيَّةُ الشَّيْطَانِ",3,"ن",1,0],["فَليَجزِهِ اللَهُ خَيراً مِن أَخي ثِقَةٍ","وَليَهدِهِ بِهُدى الخَيراتِ هاديها",4,"ي",3,0],["فليجيئوا ما قد ارادوه أني","لم أقل يوم قلت إلا صوابا",5,"ب",2,0],["فَلْيَجْعَلِ الْبَرَكَاتِ فِي تَارِيخِها","رَبِّي بِظُلِّ شَفِيعِهَا كِيرَلُّسِ",6,"س",1,0],["فَلْيَجتنِبْها من يحبُّ","العيش أو يخشى الفناء",7,"ا",2,0],["فليجيدوا كما أجيد ليسموا","إن أطاقوا الذي يطيق وتيني",8,"ن",2,0],["فلْيُجتَهدْ لا يكُنْ لماضيهِ مُسْ","تقبَلُه ناقصاً كما عَلِموا",9,"م",3,0],["فلْيَجْهلَنَّ على اللّيالي آنِفاً","فَتْكي وغايةُ عالمٍ أن يَجْهَلا",10,"ل",2,0],["فلْيجِئْنا الشَّيخُ مَولا","نا أدامَ اللهُ عِزَّهْ",11,"ز",2,0],["فلْيَجْتَنِبْني كلُّ نَذلٍ جاهِل","ولْيَصْطنِعْني سادتي العُلماءُ",12,"ا",2,0],["فَلْيَجِئْني الدهرُ فيما يشتهي","أنا لا أشكو لداءٍ ألما",13,"م",2,0],["فليجزينَّك عنهمُ ما لم يزل","يبلو القلوب ليجتبي وليبتلي",14,"ل",2,0],["فلِي جَزَعٌ باقٍ عليه وإن عفا الت","تَجمّل ما في أضلُعي والتّصنُّعُ",15,"ع",1,0],["فل يجبهم فاستحلوا قتله","فاحتج في ذلك من قام له",16,"ه",1,0],["فليجمعوا أَطْرافَهم ويُشَمِّروا","للحَرْب تشميراً خِلافَ الأَوَّلِ",17,"ل",1,0],["فليجتل البشر بالعرشِ الجديدِ فتىً","نورُ الإمامةِ لا يَرْتَابُ سيماهُ",18,"ا",2,0],["فليجلبن ما شاء من اجناده","الغربات والتفريق والاعسار",19,"ر",1,0],["فلْيجزَعِ النّاسُ عليه فقد","أسلمهمْ لِلُّجَّةِ السَّيفُ",20,"ف",1,0],["فليجرده إذا الدهر انتضى","صارم الفتك حساما منتضى",21,"ض",2,0],["فلي جسد بال وقلب كأنما","تقلبه الاشواق والوجد في الجمر",22,"ر",1,0],["فلي جسم تكون من هباء","وكوِّن من حديد السيف قلبي",23,"ب",2,0],["فليجزين صنيعها بفوارس","تقتات منهم أعيناً وقلوبا",24,"ب",2,0],["فليجيبونا إذا ما سُئِلوا","ما أفادَ الناسَ موتُ المنتَظَر",25,"ر",1,0],["فَلْيَجُدْ مْنَ يَشَا وَيَبْخَلْ بِمَا شَا","ءَ حَرامٌ عَلَيْهِ ذَمِّي وَشُكْرِي",26,"ر",2,0],["فليجم والا را","ح حائرا كما حرت",27,"ت",1,0],["فلى جمُّ آمالٍ اليك مآلها","وحاجة نفس بين صدرى اختلاجها",28,"ج",3,0],["فليجتهد هيمان في تحصيله","لاشيء أحسن من قضاءٍ عاجل",29,"ل",1,0],["فليجنحوا للسَّوءِ فهو مصيرُهم","ومصيرُ كلِّ ملفِّقٍ بحرامِ",30,"م",1,0]]}