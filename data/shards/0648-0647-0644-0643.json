َوْا بِخِذْلَانِ",126,"ن",1,0],["وهل كان من حظ الأديب سوى الأذى","إذا هو لم يشدد له الأزر منصف",127,"ف",1,0],["وهل كحماك من ركنٍ منيعٍ","وهل كعلاك من مجد مشيد",128,"د",1,0],["وهل كان قبل اليوم شيء فخفتكم","وحاذرت منكم يا ذوي اللؤم والعمى",129,"م",2,0],["وهل كان منهم من يوم لبقعةٍ","يصلى بها حاشا ذوي المجد والزهد",130,"د",1,0],["وهل كان الذي وضعوه أهدى","من الصحب الكرام ذوي الكمال",131,"ل",1,0],["وهل كان تشنيعاً وإرجاف مرجف","خئتم وخبتم عصبة أورثوا لعما",132,"م",2,0],["وهل كان هذا القول منا سفاهةً","ثكلتك دع عنك الذي أنت جاهله",133,"ل",2,0],["وهَلَكْنا كيف نصبو نظرةً","إذ تَرَكْنا الجفنَ يدنو أرْمدا",134,"د",2,0],["وهل كان قبلك من علمت","صعود المشانق أبرارها",135,"ر",3,0],["وهل كان أنكيدو سوى تيه غيمة","ليمطرَ في معناك قمحا ويسعفه!!",136,"ف",2,0],["وهل كان شمس الدين إلا معابرا","لآلائه الكبرى تؤمُّ تلهفه !!",136,"ف",2,0],["وهل كانَ مثلي يحملُ الحبَّ قلبُه","وكان تقيّا يعبدُ اللهَ إكبارا ؟",137,"ر",2,0],["وهلْ كذبَ الحلاَّجُ حينَ بِسُكرهِ","حكى أنَّ إبراهيمَ هُوْ شرعُنا السَّمْحُ",138,"ح",1,0],["وهل كان أهل الشعر إلا كصبية","تزيد الحمى أنسا وتسلي العشائرا",139,"ر",2,0],["وَهَل كُلَّما رَفَّ حَرْفٌ هُنَا","تَنَبَّهَ حَرْفُ النَّوى يَنْدُبُ",140,"ب",1,0],["وهل كفّ الزمان بما ابتلاني","إذا ما الوهن ينبت في القفار",141,"ر",1,0],["وهل كنت إلا آتحاشى نظرة الشامت","وأحاول بقد ما أقدر أنصف إلهامي",142,"م",2,0],["وهل كبدي الحري سيفثأ حرها","وما أبلت الأيام منها يجدد",143,"د",1,0],["وهل كحب الم دين به","دان على الدهر البنون الكرام",144,"م",1,0],["وهَل كان الجهادُ بِقَتلِ نَفسٍ","مُؤَمَّنَةٍ ، ولم تَخُنِ الذِّماما ؟",145,"م",2,0],["وَهَلْ كَانَ حَيًّا أَوِ المَوتُ مَنْ","تَوَلَّى حَيَاةَ ضَلَالَاتِهِ",146,"ت",2,0]]}