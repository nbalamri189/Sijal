ل","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5376,"يا رسولَ اللهِ ما طيرٌ شدا","https://www.poetsgate.com/ViewPoem.aspx?id=193785",""],[5409,"ذكرت الجنان وأنهارها","https://www.poetsgate.com/ViewPoem.aspx?id=155274",""],[5431,"ارفق بقلبه .....","https://www.poetsgate.com/ViewPoem.aspx?id=210357",""],[5561,"إطلالة على الماضي والحاضر","https://www.poetsgate.com/ViewPoem.aspx?id=197572",""],[5663,"فلينبت القمح","https://www.poetsgate.com/ViewPoem.aspx?id=200907",""],[5689,"أراك على مر الجديدين خاسرا","https://www.poetsgate.com/ViewPoem.aspx?id=143410",""],[5746,"زمّار الحيّ","https://www.poetsgate.com/ViewPoem.aspx?id=207098",""],[5896,"القمران","https://www.poetsgate.com/ViewPoem.aspx?id=190063",""],[5950,"أغاني الراحلين ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128337",""],[5970,"لنا أمل في أن يذيل لنا الغد","https://www.poetsgate.com/ViewPoem.aspx?id=130638",""],[402,"ما كان ريب قبل ريب الحمام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54039&r=&rc=891",""],[5190,"بلادي لم تزل للنور نبعاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85060&r=&rc=135",""],[6344,"سؤالٌ خارج حدود النُّبوءة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87961&r=&rc=1",""]],"verses":[["وَهَل كانَ ذاكَ البُعدُ إِلّا تَنَزُّهاً","عَلى المُضمِرِ البَغضاءِ وَالحاسِدِ الوَغدِ",0,"د",1,0],["وَهَل كَبِدٌ حَرّى لِبَينَكِ تُنقَعُ","وَهَل لِلَياليكِ الحَميدَةِ مَرجِعُ",1,"ع",1,0],["وَهَلْ كَانَ غَيْرُ العِلْمِ وَهْوَ وَلِيدُهَا","مُعِيداً إِلَيْهَا فِي اللُّغَاتِ مكَانها",2,"ن",3,0],["وَهَلْ كَحُبِّ الأُمِّ دَيْنٌ بِهِ","دَانَ عَلَى الدَّهْرِ الْبَنُونَ الْكِرَامْ",3,"م",1,0],["وَهَل كانَ الفَرَزدَقُ غَيرَ قِردٍ","أَصابَتهُ الصَواعِقُ فَاِستَدارا",4,"ر",2,0],["وَهَل كُنتُ إِلّا السَيفَ خالَطَهُ الصَدا","فَكُنتَ لَهُ ياذا المَواهِبِ صَيقَلا",5,"ل",2,0],["وَهَلَكَ الفيلُ الرَفيعُ الشانِ","فَأَمسَتِ الأُمَّةُ في أَمانِ",6,"ن",1,0],["وهل كلمي لغير أخي حفاظٍ","يحلُّ من المكارمِ في السَّنامِ",7,"م",1,0],["وهُلْكُ الفتى أن لا يُساءَ بسطوهِ","عدوٌ ولا يرجُو جَداهُ حبيبُ",8,"ب",1,0],["وَهَل كانَ إِلّا ثَعلَباً راضَ نَفسَهُ","بِمَوجٍ تَسامى كَالجِبالِ مَجاوِلُه",9,"ل",2,0],["وَهَل كُنتُمُ إِلّا عَبيداً نَفَيتُمُ","مُقَلَّدَةً أَعناقُها بِالخَواتِمِ",10,"م",1,0],["وَهَل كانَ فيما قَد مَضى مِن شَبيبَتي","لَهُ رُخصَةٌ عِندي فَيَرجو ذَكائِيا",11,"ي",2,0],["وهل كان الهوى إلا انتظاراً","شتائي فيك ينتظر الربيعا",12,"ع",2,0],["وَهَل كانَ لي في القُربِ عِندَكِ راحَةٌ","وَوَصلُكِ سَهمُ البَينِ في الشَرقِ وَالغَربِ",13,"ب",1,0],["وَهَل كُنتُ إِلّا مُذنِباً يَومَ أَنتَحي","سِواكَ بِآمالٍ فَأَقبَلتُ تائِبا",14,"ب",2,0],["وهل كنت الا كالخليّ من الهوى","أصابَ حمامَ الأيكِ وهو يُغرّدُ",15,"د",1,0],["وَهَل كانَ فانٍ راجِعاً مِن فَنائِهِ","فَيَنقَلِبَ الماضي وَمَن ماتَ مِن غُبَر",16,"ر",1,0],["وَهَل كبر الجثمان ينفع ربه","إذا كانَ فيه العقل غير كَبير",17,"ر",1,0],["وهَلْ كُنْتُ في العُشَّاقِ أَوَّل عاشِقٍ","هَوتْ بحِجاهُ أَعْيُنٌ وخُدُودُ",18,"د",1,0],["وَهَلْ كانَ شَعْبٌ سَيِّداً فِي دِيَارِهِ","إِذَا لَمْ يَكُنْ بِالقَوْلِ وَالفِعْلِ سَيِّدَا",19,"د",2,0],["وَهَل كانَ إِلّا فَخرَ فهر بنِ مالِكٍ","رأى حَذوهُم في صيصَةِ المَجدِ فَاِحتَذى",20,"ذ",2,0],["وهل كفؤادٍ في البريَّةِ مالكٌ","وهل كلُبَابِ المجد فيه لُبَاب",21,"ب",1,0],["وهل كنت ترجو خلودَ أخيكَ","ولوْ أنه كان روحًا أمينا؟",22,"ن",2,0],["وهل كنتُ إلا نائياً إذْ دَعَوْتُمُ","منادى عبيدانَ المحلاَّءِ باقرهْ",23,"ر",2,0],["وهل كنتَ إلا الباردَ العذبَ إنَّما","به يشتفي الظمآن من غلّة الصدر",24,"ر",1,0],["وَهَلْ كَانَ صَوْناً لاسْمِهَا أَنْ يُغَيَّرَا","عَلَى أَنهَا كَانَتْ مِثَالاً مُصَوَّرَاً",25,"ر",2,0],["وَهَل كُنتُ إِلّا البارِدَ العَذبَ إِنَّما","بِهِ يَشتَفي الضَمآنُ مِن غُلَّةِ الصَّدرِ",26,"ر",1,0],["وهل كنز النضار الطهر طه","وورث بعده رهطا وآلا",27,"ل",2,0],["وهل كإبن إسمعيل الملك الذي","أنامله بالرزق كانت مفاتح",28,"ح",1,0],["وَهَل كانَ عَبدُ اللَهِ والِدَ مَعشَرٍ","سِوانا فَيُستَصفى وَتَمشي وَسائِلُه",29,"ل",2,0],["وهَل كَفكَفَت عَيناىَ في الدّارِ عَبرةً","فُرَادَى كَنَظمِ البُّؤلُؤِ المُتَهَالِكِ",30,"ك",1,0],["وَهَل كانَ أو هل قَد يكون أخو حجىً","إِذا خيّروهُ اِختار عَن درّةٍ بعرا",31,"ر",2,0],["وهل كان التمدنُ في بنيهِ","سوى ما يفعلونَ من الفظيعِ",32,"ع",1,0],["وهل كلساني إن مدحتُكَ مبدعٌ","وهل كبياني ساحراً حين أنسبُ",33,"ب",1,0],["وهل كنتَ إلا ابن الذي فاضَ برُهُ","عليها كما انهلَّ الغمام وأعذبُ",33,"ب",1,0],["وهل كان لي قلبٌ أراجع عهده","وأزعم يوما أنه كان يخفق",34,"ق",1,0],["وهل كنت أهواكم وأدخل داركم","أشبّب فيها بالجمال وأعشق",34,"ق",1,0],["وهل كنت في ليل وأنوار وجهه","تراع بها الشمس السطوع فتأفل",35,"ل",1,0],["وهل كانت حياة الناس إلا","قلائد صاغها ربّ الرباب",36,"ب",1,0],["وهل كلُّ ما يُلهَى به فيكِ مِنْ غِنىً","ومن دولةٍ إلاّ كأضغاث أحلام",37,"م",1,0],["وهل كنتَ إلاّ للجلالةِ مَرْكباً","مُنَى أنفَسِ القَومِ امْتطاءُ قَراكا",38,"ك",2,0],["وهَلْ كانتِ الأَصحاب أدْنَى قرابةً","وأقربَ رِحْماً لَو عَقلتُم أم الأهلُ",39,"ل",1,0],["وهل كعهدي على الأفنان صادحة","ورق الرياض بتغريد وألحان",40,"ن",1,0],["وهل كيمين الدين طودٌ إذا انتدى","رزينٌ وصرفُ الدهر يغلي ويجلب",41,"ب",1,0],["وهل كأياديهِ بكل مكانةٍ","نواطقُ لم يسمع لهنَّ كلامُ",42,"م",1,0],["وَهَل كَبُرتَ بِهِم..أم هُم كَعَهدِهِمو","كَبيرُهُم بَينَهُم عُريانُ مُستَلَبُ؟!",43,"ب",1,0],["وَهَل كُنتُ إِلّا مُعمَداً قانِطَ الهَوى","أَسَرَّ فَلَمّا قادَهُ الشَوقُ أَعلَنا",44,"ن",2,0],["وَهل كنتَ إِلّا فَقعَ قاعٍ بقَرقَرٍ","وَساقِطَةً بَينَ القَبائلِ مُسلما",45,"م",2,0],["وهل كذوائِبِ الفتيانِ منها","عليهِ تطاولَتْ ظُلَمُ اِمْتِحانِ",46,"ن",1,0],["وَهَل كَرِعتْ مِن ذلك الحيّ كرعةً","فَقَد طالما شرّدت عنّي به كَرْبا",47,"ب",2,0],["وهل كَعدِيٍّ في مَشارِفِ تُبَّعٍ","وهل لكُلَيبٍ في الحِجازِ عديلُ",48,"ل",1,0],["وَهَل كانَ أَبقى بُختَنصَّرَ بَختُهُ","وَأَنصارُهُ لَمّا تَحَدّاهُ واجِبُه",49,"ب",2,0],["وَهَل كُلُّ شَأَنٍ مُبتَغيهِ وَسائِلُهُ","يَصِحُّ بِهِ فيما يَرومُ وَسائِلُهُ",50,"ل",2,0],["وهل كان من قلدتهم في شؤونهم","بنو الغرب عصر الظلمة المتنائي",51,"ا",2,0],["وهل كان أهل الشرق أيام مجدهم","قديما وقد فازوا بكل علاء",51,"ا",2,0],["وهل كرمت تكريمك الفخم فاتحاً","بلادُك أو أعطت مقامك غازيا",52,"ي",2,0],["وهل كان ما مكنت إلا ممهداً","لما أنت ناويه وما أنت قاصد",53,"د",1,0],["وهل كان حزماً أن تقوم حكومة","فيأخذها الطعن المجرح والشتم",54,"م",1,0],["وَهَل كانَ في البلدانِ بَدرٌ كَأَسعَدٍ","وَلَم تَحوِ مِن بَدرٍ كَبدريَ بائِنِ",55,"ن",1,0],["وَهَلكت مِن جوعها وَماتَت","وَتَرَكت صِغارَها وَفاتَت",56,"ت",1,0],["وَهَلَكا مِن سوء فعل الهرّه","لِأَنَّها ذات أَذىً وَشِرَّه",57,"ه",1,0],["وَهَلكت مِن عِندِه الكُبوش","وَأَكَلَت نِعاجَهُ الوحوش",58,"ش",1,0],["وهلْ كمثلِكِ أرضٌ أوْ سَمَاكِ سَمَاً","يا خيمةً ظلّلتْ هاماتِ أهليهَا",59,"ي",3,0],["وهل كان ذو ودٍ كتوماً لسره","ولكنه لولم يكن ما ذق الود",60,"د",1,0],["وهل كان منا في جنابك غفلةٌ","قصورٌ من الإِكرام في حالة الوفدِ",61,"د",1,0],["وهل كاشف للسَّوء غيرُ دعائه","إذا السوء يوما ظل للذيل ساحبا",62,"ب",2,0],["وهل كنت الا ساحراً وابن ساحر","وذا نسب في الساحرين هجان",63,"ن",1,0],["وهل كان لي في الحي من جانب الحمى","مشاهد ذوق صانها القلب عن نقل",64,"ل",1,0],["وهل كان هذا العشق الامن الهدى","بلا ريب في هذا ومن غير ما نكر",65,"ر",1,0],["وهل كان في دهر تَقَدَّمَ مِثلُهُ","كريمٌ يُرَجَّى للنّدىَ ويؤمَّلُ",66,"ل",1,0],["وهل كان حولك شعبٌ أمينٌ","يفدّيك بالرّوح عند العثور",67,"ر",1,0],["وهل كان يحسن في فضله ال","أعم يقارض جهالها",68,"ل",3,0],["وهل كيف لا يشجي السماوات رزء من","بخدمته أملاكها تتشرف",69,"ف",1,0],["وَهَل كانَت ضُبَيعَةُ غَيرَ عَبدٍ","ضَمَمناهُ إِلى نَسَبٍ شَطيرِ",70,"ر",1,0],["وهل كان كالسادات من آل أفلحٍ","لمن قام قَبْلي ناصِراً سالِفَ الدَّهْرِ",71,"ر",1,0],["وَهُلكُ الفَتى أَن لا يراحَ إِلى النَدى","وَأَن لا يَرى شَيئاً عَجيباً فَيَعجَبا",72,"ب",2,0],["وهل كاني صحك زهر الربى","إذا لم يباكره فيها المطر",73,"ر",1,0],["وهل كان في الصّدر القديم صنيعُكُم","وقد سمِعَت آذانكم من بها لَهَجْ",74,"ج",1,0],["وهل كان مثل الشيخ أحمدَ ناشر","على طول أيّام له وليالي",75,"ل",2,0],["وَهَل كُنتُ إِلّا الحُسامَ اِنتَضاهُ","مِن غِمدِهِ أَيِّدٌ وَاِستَثارا",76,"ر",2,0],["وَهَل كانَ لَولا الوَفدُ في مِصرَ جُنَّةٌ","تَقيها سِهاماً سَدَّدَتها يَدُ الجاني",77,