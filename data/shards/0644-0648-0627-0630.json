{"poems":[[74,"لو آذتني عذالي بحربهم","https://www.aldiwan.net/poem20307.html","البسيط"],[91,"فيك المدائح تحلو","https://www.aldiwan.net/poem44969.html","المجتث"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36441","الدوبيت"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94792","الكامل"],[4236,"","https://poetry.dctabudhabi.ae/diwan/poem/76595","الخفيف"],[4679,"ذو الحزم يسمو والمهيمن ينصر","https://www.poetsgate.com/ViewPoem.aspx?id=142728",""],[4767,"استنهاض القلم","https://www.poetsgate.com/ViewPoem.aspx?id=201142",""],[5136,"قمت ليل الوداع إلا قليلا","https://www.poetsgate.com/ViewPoem.aspx?id=121943",""],[5781,"شفاهٌ عُرْضَةٌ للدفء","https://www.poetsgate.com/ViewPoem.aspx?id=202841",""]],"verses":[["لو آذتنيَ عذَّالي بحربهمُ","إذ في التكاريش أصبحت هيمانا",0,"ن",2,1],["لو أذعن الخصم قبلا","لكان للخصم عقل",1,"ل",1,0],["لَو أَذنَبوا وَأَخطَأوا وَتابوا","ثُمَّ إِلى مَولاهُم أَنابوا",2,"ب",3,0],["لَو آذن بِالوَداع وَالبينُ دَنا","أَشبَعتُ وَلا أَكاد منه النَظَرا",3,"ر",2,0],["لو أذرفت مُقلي النجيعَ تدفّقاً","وأفيضَ دهراً وهو خالٌ ممطرُ",4,"ر",1,0],["لَو أَذابَ الفُؤادَ مِن","حَرِّ نِيرانِ صَدِّهِ",5,"د",2,0],["لوَّاذةٍ شرفاً بوارف ظله","عن ورد طاعة حكمه لا تصدر",6,"ر",1,0],["لو أذعنوا صانوا النفوسَ فكم","قد سال ممَّا حرَّفوه دم",7,"م",1,0],["لو أذلت اللسان استمعت ما","يشجي نفوساً وما يحير عقولا",8,"ل",2,0],["لَوْ أَذَّنَ الحُسْنُ قامَتْ لِلصَلاةِ لَهُ","أَيْقونَةُ الصُّبْحِ مَنْ لِلَّيْلِ نَجْواهُ",9,"ا",2,0]]}