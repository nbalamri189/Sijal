ctabudhabi.ae/diwan/poem/102744","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94635","الكامل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135120","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72787","الكامل"],[4767,"إباء الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=179960",""],[5277,"رسالةٌ إلى روحي","https://www.poetsgate.com/ViewPoem.aspx?id=194241",""],[5346,"فيا عجيبا من الدنيا وعادتها","https://www.poetsgate.com/ViewPoem.aspx?id=127132",""],[5431,"سبحان ربي","https://www.poetsgate.com/ViewPoem.aspx?id=213834",""],[5493,"قد أفاق الصبح","https://www.poetsgate.com/ViewPoem.aspx?id=197564",""],[5528,"قراءة لعيون بيضاء","https://www.poetsgate.com/ViewPoem.aspx?id=201137",""],[5628,"شر المصائب","https://www.poetsgate.com/ViewPoem.aspx?id=178705",""],[5725,"يا ليل شعري","https://www.poetsgate.com/ViewPoem.aspx?id=214904",""],[5829,"يا هدأة الليل","https://www.poetsgate.com/ViewPoem.aspx?id=151390",""],[5956,"الثلاثي المثالي","https://www.poetsgate.com/ViewPoem.aspx?id=193163",""],[5956,"ذكرى وفاة زهرة الشمعة","https://www.poetsgate.com/ViewPoem.aspx?id=215786",""],[6148,"نبي الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=202058",""],[6331,"الصَّبر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82022&r=&rc=3",""]],"verses":[["قَد أَفاقوا وَالظُبى مِن","هامِهِم غَيرُ مُفيقَه",0,"ق",2,0],["قَدْ أَفْسدتُ أَقْوَالَ كُهَانِهِ","فِكَرتَهُ اليوم محسبهِ",1,"ب",2,0],["قد أفاض نعم عميما","بش يمجّد ويوحّد",2,"د",1,0],["قَد أَفعَمَت وادِيَي نَجرانَ مُعلَمَةً","بِالدارِعينَ وَبِالخَيلِ الكَراديسِ",3,"س",1,0],["قد أفقرتني غيداء واصلة","فدمع عينيّ غير مقطوع",4,"ع",1,1],["قد أفسدت فاقته ذهنه","فهو معافى مثل محموم",5,"م",1,0],["قد أَفدتُنَّني مع الخُبْر بالصّا","حِبِ أنْ ربَّ كاسفٍ مُستضاءِ",6,"ا",2,0],["قد أُفضِيَ الطيزُ إلى فقْحَةٍ","مفتوقة بالطعن مضروجَهْ",7,"ج",2,0],["قَدْ أَفاقَ العالم الحيُّ","وغَنَّى للحياهْ",8,"ه",1,0],["قد افترى عاذلي كلاما","يشهد في كذبه أناس",9,"س",1,0],["قَد أَفرَغَت فيكِ الطَبيعَةُ سِحرَها","مَن ذا الَّذي مِن سِحرِها يَرقيكِ",10,"ك",1,0],["قَد أَفرَدوهُ بِما يَختارُ مِن حَسَنٍ","فَما لَهُ فيهِمُ نِدٌّ يُساجِلُهُ",11,"ل",2,0],["قَد أَفرَشَتنا مِنَ الرَوضِ الأَنيقِ بِها","بُسطاً وَمَدَّ عَلَينا دَوحُها طُنُبا",12,"ب",2,0],["قَد أَفقَرَتهُ وَفي تَجَنُّبِها غِنىً","وَمِنَ المَليكِ غِناهُ وَالإِفقارُ",13,"ر",1,0],["قد افترّ ثغر الروض يبسم للحيا","إذا ما بكى وَالأقحوان هُوَ الثغر",14,"ر",1,0],["قد أَفلح المتروي في عزيمته","وَكل قصد إذا زالَ الضلال هدى",15,"د",2,0],["قد أفرط القوم إفراطاً أضر بهم","وقبل ذلك كانوا أُمة وسطا",16,"ط",2,0],["قد أفسَدت أقوالُ كهانهِ","فكرتَهُ اليومَ وحسَّابه",17,"ب",2,0],["قَد اِفنى أَنامِلَهُ أَزمُهُ","فَأَمسى يَعَضُّ عَلَيَّ الوَظيفا",18,"ف",2,0],["قد افصحت عن عبرة شهقت لها","نفس النهى موثوقة الاحزان",19,"ن",1,0],["قد افر المولى باحمد عيني","فاستفيضي يا عين منه ضياكي",20,"ك",2,0],["قد افترى عاذلي ظلماً على بلا","حق وأكثر بالبهتان والتهم",21,"م",1,1],["قد أفعل الشيء لا أبغي به أملا","ولا أبالي الورى ماذا يقولونا",22,"ن",2,1],["قَدْ أَفْلَحَتْ سَوَاعِدٌ","لِجَنْيِ رِبْحِ بَكَّرَتْ",23,"ت",1,0],["قَد أَفرَغَ البَدرُ المُنيرُ ضِياءُه","في خَيمَةِ الزَهر الَّتي تَأويكِ",24,"ك",1,0],["قَدِ افْتَقَرْتُ يَا إِلَهَنَا الْغَنِي","وَآبَ بِالْحِرْمَانِ عَبْدُكَ الدَّنِي",25,"ي",1,1],["قد افترعوا العلياء بكراً وباكروا","إليها المساعي فاستحب بكورها",26,"ر",3,0],["قَد أفاءَ بهِمُ ظِلُّ المُنى","وَصَفا مِنْ شرْبِها ما كَدَرا",27,"ر",2,0],["قَد أَفادَ الأَحكام حكمة فكر","واضع الحَزم مَوضع التَرديدِ",28,"د",1,0],["قَد أَفلَحَ الجودُ فَلا قَطرَةٌ","مِنهُ وَهَذا البُخلُ طوفانُ",29,"ن",1,0],["قَد أَفصَحوا نَصّاً بِمَولِدِهم","وَالفَرعُ قَد يُنبي عن النَجرِ",30,"ر",1,0],["قد أفسدُوا عَيشِي عَلَيَّ وعيشَهُم","فأنا الشَقِيُّ بِهم وبي أيضاً شَقُوا",31,"ق",3,0],["قد أفلح الناس باديها وحاضرها","من آمرٍ بالذي تهوى ومؤتمر",32,"ر",1,0],["قد أفعموه وأباحوا وِردَه","مخلَّداً عَذْباً فمن شاء وَرَدْ",33,"د",1,0],["قَد أَفلَحَ العَبدُ الَّذي مالَهُ","بِاللَهوِ عَن سَيِّدِهِ شُغلُ",34,"ل",1,1],["قدْ أفلتَ الشِّعرُ من يديكَ","والشِّعرُ بطبْعهِ قَلُوبُ",35,"ب",1,0],["قَد أَفرغوا الكيدَ لَو أَملى القضاءُ لهم","وَاِستَيقَظوا غيرَ أنّ الحينَ لم ينمِ",36,"م",1,0],["قد أفاق الواجدون وملّوا","والّذي يهواكُمُ ما أفاقا",37,"ق",2,0],["قد أفادته طاعة الله هذا","بكمال اقتدا وحسن اتِّباع",38,"ع",1,0],["قد افتَخرتْ بهِ بيروتُ لمَّا","ثوَى فيها لهُ جسدٌ كريمُ",39,"م",1,0],["قد أَفَدتَ العِدَا كَمَا قَدْ أَفاد ال","جودُ فِينا فَهْو المُغِيثُ المفِيدُ",40,"د",1,0],["قد أفادَ الدَّوا دَوانا وَقَد فَ","كَّ بِه مِن أبي ذؤيبٍ ذويبُ",41,"ب",1,0],["قد أفلح القانت في جنح الدجى","يتلو الكتاب العربيّ النيّرا",42,"ر",2,1],["قد أَفزعَتْ حولتُكَ الحُولَ يا","مَن لم تزل حَولتُهُ مُفزِعه",43,"ع",2,0],["قد أفحم البلغاء بالحجج الَّتي","برهانها يغشى على الأسحارِ",44,"ر",1,0],["قَدْ أفْرَضَتْ قَتْلَ الْمُتَيَّمِ عنْدَمَا","أضْحَى مُهَنَّدُ لحظهَا مَسْنُونَا",45,"ن",2,0],["قَد اِفتَخَرت فيكَ المُلوك مَقَرّةً","بِفَضلِكَ وَأَنجَرَّت إِلَيكَ القَبائِلُ",46,"ل",1,0],["قد أفاق العشاق من سكرة الح","ب جميعاً فما لنا من أفقنا",47,"ن",2,0],["قد أفصحت أخلاقه عن همةٍ","بعدت على قربٍ من الميلاد",48,"د",1,0],["قد أفلح الدهر به والمؤمنو","ن وفلاحا لكون في يمن الهدى",49,"ا",1,0],["قد افتقروا والمال بينهم نما","وما لكنوز التبر شأن لمن فهم",50,"م",1,0],["قد أفعمت قلبي النوائب جمة","فلذاك ضاق بها على فسحاته",51,"ت",2,0],["قد افتنَ العشاق باهي حسنه","فالحسن فيه جوهرٌ لا يعدم",52,"م",1,0],["قَد أَفرَدَ اللَهُ بِذاكَ سورَهْ","مَعروفَةً بِيوسِفٍ مَشهورَهْ",53,"ه",1,0],["قد أفاق الدهر من غفوته","وجرى يتبع خطو الناهضين",54,"ن",1,0],["قَد أَفصَحَ الضَّبُّ تَصديقاً لِبعثَتِهِ","إِفصاحَ قُسٍّ وَسَمعُ القَومِ لَم يَهِمِ",55,"م",1,0],["قد أفلح الناسُ بالنورِ الذي غمرُوا","من نُورِ فُرقانه لما جلا غُرَرَه",56,"ر",2,0],["قد أفصح الشان فيما قد أتاك به","فإنه بينَ موصولٍ ومفصول",57,"ل",1,1],["قد أفلح من زكَّى حقيقةَ نفسِه","وقد خاب من دساها في عالمِ الرتقِ",58,"ق",1,0],["قد أفلح المؤمنون الصادقون بما","رأوه في صدقهم من كل معلومِ",59,"م",1,1],["قَد أفسَدَا هَذَا الوُجُودَ وَخَبَّطَا ال","أذهَانَ والآراءَ كُلَّ زَمَانِ",60,"ن",1,0],["قَد أُفرِدَت بِمُصَنَّفٍ لإِمَامِ هَ","ذَا الشَّأنُ بَحرِ العَالَمِ الح