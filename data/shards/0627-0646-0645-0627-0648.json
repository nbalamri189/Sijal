{"poems":[[87,"غال في قيمة أبن بطرس غالى","https://www.aldiwan.net/poem7128.html","الخفيف"],[87,"غال في قيمة ابن بطرس غالي","https://www.aldiwan.net/poem63750.html","الخفيف"],[369,"من رأي قبل ثناياك مداما","https://www.aldiwan.net/poem60646.html","الرمل"],[415,"قل لمن لم يرع عهدي","https://www.aldiwan.net/poem32598.html","مجزوء الرمل"],[563,"إنما وحدة الوجود فنون","https://www.aldiwan.net/poem33762.html","الخفيف"],[563,"إنما وحدة الوجود لدينا","https://www.aldiwan.net/poem34218.html","الخفيف"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83303","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87274","الرمل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109107","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204920","الخفيف"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99218","الرمل"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102004","الرمل"]],"verses":[["إنما واصف بناء من الأخ","لاق في دولة المشارق عال",0,"ل",1,0],["إِنَّما واصِفٌ بِناءٌ مِنَ الأَخ","لاقِ في دَولَةِ المَشارِقِ عالي",1,"ل",2,0],["إنّما وُدِّي وقد جَرّبْتَه","عُروةٌ وُثْقَى فلا تَخْشَ انْفِصاما",2,"م",2,0],["إنّما وَصلُكَ مبذو","لٌ لِخلٍّ مُستَجَدِّ",3,"د",1,0],["إنما وحدة الوجود فنونُ","وهو قول الإله كن فيكونُ",4,"ن",1,1],["إنما وحدة الوجود لدينا","وحدة الحق فافهموا ما نقولُ",5,"ل",1,1],["إِنَّما وَصَفَهَ عَلى فاتِحِ الأَفكا","رِ في الذَروَةِ الَّتي لا تُرامِ",6,"م",1,0],["أَن مأواهم جَهنَّمْ","حَيث فيهم قَد تَحكَّمْ",7,"م",1,0],["إنما والدتي قد جرمت","إنما عاشقها قد أثما",8,"م",2,0],["إن مأوى جسمي كجسمي صغير","وليَ الروح ملء هذا الفضاء",9,"ا",2,0],["إنَّما ودَّعَ قلبي جَلَدِي","يوم ودَّعْتُ سُلَيمى والرَّبابا",10,"ب",2,0],["إنما وجدي وتهيامي بكم","وبكم الهج في كل ندي",11,"د",2,0]]}