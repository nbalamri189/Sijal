{"poems":[[53,"نغالب ثم تغلبنا الليالي","https://www.aldiwan.net/poem29886.html","الوافر"],[53,"يا دار ما طربت إليك النوق","https://www.aldiwan.net/poem29956.html","الكامل"],[86,"يحييك من أرض الكنانة شاعر","https://www.aldiwan.net/poem68927.html","الطويل"],[71,"ولا تقل ساحل الإفرنج أملكه","https://www.aldiwan.net/poem3978.html","البسيط"],[93,"ألطائر العالي مراده","https://www.aldiwan.net/poem11144.html","السريع"],[93,"مريم يا غرس خير كرم","https://www.aldiwan.net/poem11311.html","مخلع البسيط"],[51,"قل للأمير أدام الله دولته","https://www.aldiwan.net/poem8700.html","البسيط"],[51,"أبو علي ابن أبي قره","https://www.aldiwan.net/poem62911.html","السريع"],[92,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[92,"أيها الحب أنت سر بلائي","https://www.aldiwan.net/poem38975.html","الخفيف"],[85,"الله أعلم والقبور","https://www.aldiwan.net/poem7107.html","مجزوء الكامل"],[87,"طهر لسانك ما استطعت","https://www.aldiwan.net/poem8354.html","الكامل"],[105,"توالت وفود الله تختار دينه","https://www.aldiwan.net/poem44000.html","الطويل"],[46,"إذا حضرت عندي الجماعة أوحشت","https://www.aldiwan.net/poem22820.html","الطويل"],[46,"قال المنجم والطبيب كلاهما","https://www.aldiwan.net/poem23355.html","الكامل"],[46,"باهى رجال وفي جهل يباهونا","https://www.aldiwan.net/poem23477.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39581","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43843","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54288","الكامل"],[106,"أسماؤهم رتب","https://www.poetsgate.com/ViewPoem.aspx?id=179697",""],[106,"فقيدُ الإسلام!","https://www.poetsgate.com/ViewPoem.aspx?id=179686",""],[106,"موظف بلا مأوى","https://www.poetsgate.com/ViewPoem.aspx?id=179766",""],[106,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""]],"verses":[["طَهُرنَ نَباهَةً وَبَرَرنَ طَولاً","وَهُنَّ وَراءَ مَعدودِ الحِجالِ",0,"ل",1,0],["طَهَّرتُ قَلبي مُذ عَلِمتُ بِأَنَّهُ","لِسُرى مَدائِحِهِ العِظامِ طَريقُ",1,"ق",1,0],["طَهورٌ إِذا ما دُنِّسَت كَفُّ كاتِبٍ","وَثَوبٌ إِذا ما قَرَّ في الطِرسِ مِرقَمُ",2,"م",1,0],["طَهِّر بِسَيفِكَ بَيتَ اللَهِ مِن دَنَسٍ","وَما أَحاطَ بِهِ مِن خِسَّةٍ وَخَنا",3,"ن",2,0],["طهرت من الأوضار شيمته","ولم يدنس بجاده",4,"د",2,0],["طهْرٌ تَمَامٌ عَقْلٌ","لُطْف تَمَامُ ظَرْفٌ تَمَامُ",5,"م",1,0],["طهِّر ثيابك ممن لا يؤهِّلُهُ","عند العُطاس ذوو التقوى لتشميتِ",6,"ت",1,0],["طهِّر ثيابك ممن لا ثيابَ له","من ذنبه غيرُ أطمارٍ مَهاريتِ",6,"ت",1,0],["طهَّرني الله كتطهيره","ليلة زُفّت من دم العُذرهْ",7,"ر",2,0],["طهِّري يا شقيقَةَ الرُّوحِ ثَغري","بلهيبِ الحَيَاةِ بلْ قَبِّليني",8,"ن",2,0],["طَهِّرْ كُلُومَكَ بالدُّمُوع","وخَلِّها وسَبِيلَهَا",9,"ه",2,0],["طهر زيان به الحجا","ب ولا يشان به السفور",10,"ر",1,0],["طَهِّرْ لِسَانَكَ مَا اسْتَطَعْتَ وَلا تَكُنْ","خِبّاً يُقَرِّبُ لِلنُّفُوسِ ضَلالَهَا",11,"ه",2,1],["طَهارَى عليهم من سَنا الحقِّ بَهجةٌ","لها وَهَجٌ باقٍ على الدّهرِ لا يَخْبُو",12,"ب",2,0],["طَهارَةُ مِثلي في التَباعُدِ عَنكُمُ","وَقُربُكُمُ يَجني هُمومي وَأَدناسي",13,"ي",1,0],["طَهَّرتُ ثَوبي لِلصَلاةِ وَقَبلَهُ","طُهرٌ فَأَينَ الطُهرُ مِن جَسَدَيكُما",14,"م",2,0],["طَهَت لَكَ الشَمسُ ما يُغني أَخا دَعَةٍ","عَن أَن يَكونَ لَهُ في الأَرضِ طاهونا",15,"ن",2,0],["طُهْرٌ عَصَمْتَ به الشبابَ وإنما","شِيمُ الملوكِ به أحقُّ وأخلقُ",16,"ق",1,0],["طَهَّرَهُ وَالكَبيرُ رِجسٌ","يُدَنِّسُ العرضَ وَالرِياطا",17,"ط",2,0],["طه وَياسين عَوِّذاني","فَإِنَّ قَلبي عَلَيهِ شاطا",17,"ط",2,0],["طَهَّرْته ةمن كلِّ مَا تأبى النُّهَى","ويَعَافُهُ سَمْعُ الحِسَانِ الْخُودِ",18,"د",1,0],["طَهُرتْ مِنَ الصَّلَفِ الذّمِيمِ","وَعُنْفُوَانِ الْمُسْتَبِدِّ",19,"د",1,0],["طَهَ. ولاسمِكَ من حرفَيْه أُغنيةٌ","تُوحي بكلِّ معاني المجد والحَسَب",20,"ب",1,0],["طَهُرتَ فأعرى طهرُكَ المحضُ معشرًا","وولَّدَ في بعض النفوس التمرُّدا",21,"د",2,0],["طه، فديتك من أغرَّ، همام","طلْقِ المحيا، مشرقٍ، بسَّامِ!",22,"م",1,1],["طَهَّرْتِ أرجاء الحمى","من كلِّ جبَّارٍ عَنِيد",23,"د",1,0]]}