{"poems":[[53,"نغالب ثم تغلبنا الليالي","https://www.aldiwan.net/poem29886.html","الوافر"],[53,"يا دار ما طربت إليك النوق","https://www.aldiwan.net/poem29956.html","الكامل"],[86,"يحييك من أرض الكنانة شاعر","https://www.aldiwan.net/poem68927.html","الطويل"],[71,"ولا تقل ساحل الإفرنج أملكه","https://www.aldiwan.net/poem3978.html","البسيط"],[93,"ألطائر العالي مراده","https://www.aldiwan.net/poem11144.html","السريع"],[93,"مريم يا غرس خير كرم","https://www.aldiwan.net/poem11311.html","مخلع البسيط"],[51,"قل للأمير أدام الله دولته","https://www.aldiwan.net/poem8700.html","البسيط"],[51,"أبو علي ابن أبي قره","https://www.aldiwan.net/poem62911.html","السريع"],[92,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[92,"أيها الحب أنت سر بلائي","https://www.aldiwan.net/poem38975.html","الخفيف"],[85,"الله أعلم والقبور","https://www.aldiwan.net/poem7107.html","مجزوء الكامل"],[87,"طهر لسانك ما استطعت","https://www.aldiwan.net/poem8354.html","الكامل"],[105,"توالت وفود الله تختار دينه","https://www.aldiwan.net/poem44000.html","الطويل"],[46,"إذا حضرت عندي الجماعة أوحشت","https://www.aldiwan.net/poem22820.html","الطويل"],[46,"قال المنجم والطبيب كلاهما","https://www.aldiwan.net/poem23355.html","الكامل"],[46,"باهى رجال وفي جهل يباهونا","https://www.aldiwan.net/poem23477.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39581","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43843","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54288","الكامل"],[106,"أسماؤهم رتب","https://www.poetsgate.com/ViewPoem.aspx?id=179697",""],[106,"فقيدُ الإسلام!","https://www.poetsgate.com/ViewPoem.aspx?id=179686",""],[106,"موظف بلا مأوى","https://www.poetsgate.com/ViewPoem.aspx?id=179766",""],[106,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""],[113,"لك بين سفار الحمى اسماء","https://www.aldiwan.net/poem41467.html","عموديه"],[113,"ما أحسن الصدق في حب الغزال وما","https://www.aldiwan.net/poem41674.html","البسيط"],[113,"لكل أمر تسول بابن عدنان","https://www.aldiwan.net/poem42169.html","البسيط"],[113,"عج بالركائب ساحة الجرعاء","https://www.aldiwan.net/poem42181.html","الكامل"],[113,"الحمد لله الذي قد أنعما","https://www.aldiwan.net/poem42187.html","الرجز"],[126,"أرى الدنيا وزخرفها غرورا","https://www.aldiwan.net/poem50617.html","الطويل"],[140,"إحدى الكواعب من بنى نصر","https://www.aldiwan.net/poem58404.html","أحذ الكامل"],[148,"الخمر متلفة لدينك فاحذر","https://www.aldiwan.net/poem68531.html","الكامل"],[180,"رقص الهزار على الغصون الميس","https://www.aldiwan.net/poem67056.html","الكامل"],[187,"برئت من عقيدة الأشرار","https://www.aldiwan.net/poem35101.html","الرجز"],[187,"أموا المدينة حيث جل المغنم","https://www.aldiwan.net/poem35107.html","الكامل"],[208,"رأى العقيق فأجرى دمعه لولو","https://www.aldiwan.net/poem13306.html","البسيط"],[209,"فجعت بألطف العلماء روحا","https://www.aldiwan.net/poem46629.html","الوافر"],[233,"يالك من يوم له حرمة","https://www.aldiwan.net/poem31601.html","الطويل"],[249,"قف شامخاً","https://www.aldiwan.net/poem27798.html","عموديه"],[257,"أسعفي يا ذات ربي بالمنى","https://www.aldiwan.net/poem35956.html","الرمل"],[268,"إن الجمال به عزاء الأنفس","https://www.aldiwan.net/poem35666.html","الكامل"],[273,"أدرك بخيلك خيل الله أندلسا","https://www.aldiwan.net/poem25469.html","البسيط"],[295,"أربة الخدر ذات الريط والخمر","https://www.aldiwan.net/poem33274.html","البسيط"],[303,"برق به أفق الرجاء أنارا","https://www.aldiwan.net/poem56540.html","الكامل"],[303,"وطأت ما وطئت ريب الليالي","https://www.aldiwan.net/poem56579.html","الخفيف"],[326,"يا نديمي هات الأباريق هات","https://www.aldiwan.net/poem55034.html","الخفيف"],[326,"طار يطوى مجاهل الأفق والنار","https://www.aldiwan.net/poem55059.html","الخفيف"],[359,"ينهى محبك انه مشتاق","https://www.aldiwan.net/poem68082.html","الكامل"],[359,"ان من يحفظ المودة أحرى","https://www.aldiwan.net/poem68108.html","الخفيف"],[362,"البحر أجمع لو غدا أنقاسي","https://www.aldiwan.net/poem60869.html","الكامل"],[369,"رب شيء تراه يحسن في عي","https://www.aldiwan.net/poem57027.html","البسيط"],[374,"سهر صالح ينير العقولا","https://www.aldiwan.net/poem59171.html","الخفيف"],[374,"طهارة نفس لا تفيد وتنفع","https://www.aldiwan.net/poem59338.html","الطويل"],[374,"طهارة مريم العذراء كانت","https://www.aldiwan.net/poem59393.html","الوافر"],[374,"إن من صار راهبا","https://www.aldiwan.net/poem59423.html","مجزوء الخفيف"],[388,"محسن أحسن عسى ربك يجازيك بإحسان","https://www.aldiwan.net/poem54462.html","عموديه"],[399,"كم ذا يذوب أسى وكم يتجلد","https://www.aldiwan.net/poem46938.html","الكامل"],[400,"العلم في قول لا إله إلا الله","https://www.aldiwan.net/poem33366.html","البسيط"],[413,"من لصب متيم مستهام","https://www.aldiwan.net/poem53989.html","الخفيف"],[413,"طهر فؤادك بالراحات تطهيرا","https://www.aldiwan.net/poem54094.html","البسيط"],[413,"أترى في الوجود مثلك عالم","https://www.aldiwan.net/poem54119.html","الخفيف"],[413,"هنيت هنيت بالإقدام والظفر","https://www.aldiwan.net/poem54155.html","الوافر"],[456,"سل بالغوير السائق المغلسا","https://www.aldiwan.net/poem56152.html","الرجز"],[456,"أَستنجِد الصبر فيكم وهو مغلوب","https://www.aldiwan.net/poem56300.html","البسيط"],[498,"ته غراما فللغرام رجال","https://www.aldiwan.net/poem37808.html","الخفيف"],[498,"عوجا إلى الوادي المقدس بالسرى","https://www.aldiwan.net/poem37817.html","الكامل"],[498,"روح القلب تارة بالمباح","https://www.aldiwan.net/poem38040.html","الخفيف"],[504,"طهر بماء التقى جنابك","https://www.aldiwan.net/poem2461.html","مخلع البسيط"],[512,"أمن البروج تعد أكناف الحمى","https://www.aldiwan.net/poem20815.html","الكامل"],[513,"نطقت عنك ألسن الأغماد","https://www.aldiwan.net/poem12094.html","الخفيف"],[522,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[542,"بايعت ذكراك","https://www.aldiwan.net/poem67252.html","عموديه"],[556,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[556,"طوبى لمن كشفت بصيرته الغطا","https://www.aldiwan.net/poem33544.html","الكامل"],[556,"أنت الذي طول عمري الهم تكفيني","https://www.aldiwan.net/poem33806.html","البسيط"],[556,"ما الشدة إلا للفرج","https://www.aldiwan.net/poem34692.html","المتدارك"],[557,"قد كساني لباس سقم وذله","https://www.aldiwan.net/poem69349.html","الخفيف"],[561,"مصادر خمس قد أتت بفعول","https://www.aldiwan.net/poem13618.html","الطويل"],[565,"بكاء وقل غناء البكاء","https://www.aldiwan.net/poem69825.html","الطويل"]],"verses":[["طَهُرنَ نَباهَةً وَبَرَرنَ طَولاً","وَهُنَّ وَراءَ مَعدودِ الحِجالِ",0,"ل",1,0],["طَهَّرتُ قَلبي مُذ عَلِمتُ بِأَنَّهُ","لِسُرى مَدائِحِهِ العِظامِ طَريقُ",1,"ق",1,0],["طَهورٌ إِذا ما دُنِّسَت كَفُّ كاتِبٍ","وَثَوبٌ إِذا ما قَرَّ في الطِرسِ مِرقَمُ",2,"م",1,0],["طَهِّر بِسَيفِكَ بَيتَ اللَهِ مِن دَنَسٍ","وَما أَحاطَ بِهِ مِن خِسَّةٍ وَخَنا",3,"ن",2,0],["طهرت من الأوضار شيمته","ولم يدنس بجاده",4,"د",2,0],["طهْرٌ تَمَامٌ عَقْلٌ","لُطْف تَمَامُ ظَرْفٌ تَمَامُ",5,"م",1,0],["طهِّر ثيابك ممن لا يؤهِّلُهُ","عند العُطاس ذوو التقوى لتشميتِ",6,"ت",1,0],["طهِّر ثيابك ممن لا ثيابَ له","من ذنبه غيرُ أطمارٍ مَهاريتِ",6,"ت",1,0],["طهَّرني الله كتطهيره","ليلة زُفّت من دم العُذرهْ",7,"ر",2,0],["طهِّري يا شقيقَةَ الرُّوحِ ثَغري","بلهيبِ الحَيَاةِ بلْ قَبِّليني",8,"ن",2,0],["طَهِّرْ كُلُومَكَ بالدُّمُوع","وخَلِّها وسَبِيلَهَا",9,"ه",2,0],["طهر زيان به الحجا","ب ولا يشان به السفور",10,"ر",1,0],["طَهِّرْ لِسَانَكَ مَا اسْتَطَعْتَ وَلا تَكُنْ","خِبّاً يُقَرِّبُ لِلنُّفُوسِ ضَلالَهَا",11,"ه",2,1],["طَهارَى عليهم من سَنا الحقِّ بَهجةٌ","لها وَهَجٌ باقٍ على الدّهرِ لا يَخْبُو",12,"ب",2,0],["طَهارَةُ مِثلي في التَباعُدِ عَنكُمُ","وَقُربُكُمُ يَجني هُمومي وَأَدناسي",13,"ي",1,0],["طَهَّرتُ ثَوبي لِلصَلاةِ وَقَبلَهُ","طُهرٌ فَأَينَ الطُهرُ مِن جَسَدَيكُما",14,"م",2,0],["طَهَت لَكَ الشَمسُ ما يُغني أَخا دَعَةٍ","عَن أَن يَكونَ لَهُ في الأَرضِ طاهونا",15,"ن",2,0],["طُهْرٌ عَصَمْتَ به الشبابَ وإنما","شِيمُ الملوكِ به أحقُّ وأخلقُ",16,"ق",1,0],["طَهَّرَهُ وَالكَبيرُ رِجسٌ","يُدَنِّسُ العرضَ وَالرِياطا",17,"ط",2,0],["طه وَياسين عَوِّذاني","فَإِنَّ قَلبي عَلَيهِ شاطا",17,"ط",2,0],["طَهَّرْته ةمن كلِّ مَا تأبى النُّهَى","ويَعَافُهُ سَمْعُ الحِسَانِ الْخُودِ",18,"د",1,0],["طَهُرتْ مِنَ الصَّلَفِ الذّمِيمِ","وَعُنْفُوَانِ الْمُسْتَبِدِّ",19,"د",1,0],["طَهَ. ولاسمِكَ من حرفَيْه أُغنيةٌ","تُوحي بكلِّ معاني المجد والحَسَب",20,"ب",1,0],["طَهُرتَ فأعرى طهرُكَ المحضُ معشرًا","وولَّدَ في بعض النفوس التمرُّدا",21,"د",2,0],["طه، فديتك من أغرَّ، همام","طلْقِ المحيا، مشرقٍ، بسَّامِ!",22,"م",1,1],["طَهَّرْتِ أرجاء الحمى","من كلِّ جبَّارٍ عَنِيد",23,"د",1,0],["طه حبيب الله سيد خلقه","سبب الوجود القبضة البيضاء",24,"ا",2,0],["طهارة القلب من رؤياي تمنعه","وعزة الصدق من رؤياه تمنعني",25,"ي",1,0],["طه بتعريف عليا شانه نزلت","وجاء بالكوثر التبتير للشاني",26,"ي",1,0],["طه سراج المرسلين وقبضة الن","نور القديم وأكرم الهيجاء",27,"ا",2,0],["طهر لنا بفلك السريره","ونور الأبصار والبصيره",28,"ه",1,0],["طَهوراً عابداً ثقةً كريمَا","سليمَ القلب مُتَّقِياً صَبُورَا",29,"ر",2,0],["طُهرت من الأحقادِ نيَته","والقلبُ مغسول من الغِمرِ",30,"ر",1,0],["طهّر فؤادك من نجاسة إثمها","أًَو لاَ فأعدد للعذاب الأكبر",31,"ر",1,0],["طهُرتْ وَبرَّتْ مِنهُ نَفسٌ حُرّةٌ","بِشَوائبِ الأَيّامِ لَم تَتَدَنَّسِ",32,"س",1,0],["طهَ لَنا وَسيلةٌ للباري","نَبغي بهِ النصرَ على الكفّارِ",33,"ر",1,0],["طهَ لهُ قد كان أوّل باني","فلهُ على التقوى أساسٌ محكمُ",34,"م",1,0],["طه ويس كهف الانبياء ومن","عليه قد انزلت حم تنزيل",35,"ل",1,0],["طه أمتّ أجبني كيف لا عجبٌ","إن السيوف إلى أجفان أغماد",36,"د",1,0],["طه أجبني أجب هل مت هل ذهبت","تلك الخصال إلى آباد آباد",36,"د",1,0],["طَهِّر بِلادَ العَدلِ مِن جَورِهِ","وَنَزِّهِ الإِسلامَ مِن كُفرِهِ",37,"ر",2,0],["طهر به ماء المحيط منظّفا","خطراً على ماء المحيط وبيلا",38,"ل",2,0],["طهّريني في بحار الغيب من","كلّ عيبٍ مؤذنٍ في حجبنا",39,"ن",2,0],["طهرُ الهوى والحسنُ صانتهُ لنا","بيّاعةُ الزَّهر التي لم تُلمسِ",40,"س",1,0],["طَهِّرْ بِلادَك مِنْهُم إِنَّهُم نَجَسٌ","وَلا طَهَارَةَ ما لَم تَغْسِل النَّجَسا",41,"س",2,0],["طُهر المآزِرِ مذ نيطَت تمائمُهم","نالوا من المَجد ما نالوا من الظفرِ",42,"ر",1,0],["طَهروا به مِن لمّة الشيطانِ في","بضعٍ كَما طابوا ثنىً ونجارا",43,"ر",2,0],["طَهّرَ اللّه مَوضعِ المسّ منها","مِن معافاتِه بماءٍ برودِ",44,"د",1,0],["طهرنا ديننا وللناس أديان","وبعض الأديان من شهوات",45,"ت",1,0],["طهريني من رجس دنياي بالنا","ر تلظى في روحك الغلاب",46,"ب",1,0],["طه البَشير الطاهِر الطهر الَّذي","هو لِلقُلوبِ وَسَقمِها تِرياق",47,"ق",1,0],["طهر اللَه أَصغريك وَلا زِل","ت لطلابك الا ماجد ذخرا",48,"ر",2,0],["طَهِّرْ بسَيفِك ظاهِرَ الأرضِ التي","نَجِسَتُ بوَطْءِ أولئك الأرجاس",49,"س",1,0],["طَهِّرْهُ غسْلاً منهمُ بدِمائهمْ","يَطْهُرْ مِنَ الأنجاسِ بالأنْجاس",49,"س",1,0],["طُهِّرَ السُّوقُ مِنه والمسجدُ الجا","معُ أولى بأن يُطَهَّرَ مِنهُ",50,"ن",2,0],["طهِّرِ العقل بالسهاد فتدري","فضلَ ما قد أَخذتَ فيه سبيلا",51,"ل",2,0],["طهارة نفسٍ لا تفيد وتنفعُ","إذا كان جسم النفس بالإثم يَمنعُ",52,"ع",1,1],["طهارة جسمٍ فاقت النفس رفعةً","وتلك من الأملاك أرقى وأرفع",52,"ع",1,0],["طهارة مريم العذراء كانت","لدقة عقلها رسماً وسورهْ",53,"ه",1,1],["طهره أعجلٌ ومن","جاء بالطهر يُشكَر",54,"ر",1,0],["طهر القلب من كل المعايب وعصيان","واحفظ القول من زوروافك وبهتان",55,"ن",1,0],["طَهِّرْ مِنَ التُركِ الطَّغام بقاعَها","فَلَطَالَ مَا عاثوا هُناك",56,"ك",1,0],["طهره لساناً إذا لغوت بها","بقولنا لا إله إلا اللّه",57,"ل",2,0],["طهَّر الله ذاتكم واصطفاكم","حجَّة للإسلام في الإِسلام",58,"م",1,0],["طَهِّر فؤادك بالرَّاحات تطهيرا","ودمْ على نَهْبِكَ اللَّذَّات مَسرورا",59,"ر",2,1],["طهْر الله ذاتهم واصطفاهم","قبل ما يُنتَجون من صلب آدم",60,"م",1,0],["طهّرتها من فساد كانَ يكنفها","ولم تدع باغياً فيها ولم تذر",61,"ر",1,0],["طهَّرها تدبيرُه فلم يدع","إزاءَها من العباد نجِسا",62,"س",2,0],["طَهِّرْ خِلالَك من خِل تعابُ به","وأسلم وحيداً فما في الناس مصحوبُ",63,"ب",1,0],["طهِّرِ القلبَ إنْ أَردْتَ هَواهُمْ","رُبَّ قولٍ ترُدُّهُ الأَفعَالُ",64,"ل",1,0],["طَهَ الحَقائقِ حكمُ يس العَمى","طس نَصِّ كِتابِهِ المُتَنَزِّلِ",65,"ل",1,0],["طهِّرِ القلبَ من غُبارِ البَرايا","واطلُبِ الفَتْح من يدِ الفتَّاحِ",66,"ح",1,0],["طهِّر بِمَاءِ التُّقى جَنابَك","واصحَب عَلى حَالِهِ زَمَانَك",67,"ك",1,1],["طهّرْتُهُ بالخَتْن وهو مطهَّرٌ","قبل الخِتانِ تشرُّعاً وتكرّما",68,"م",2,0],["طهر الله صدره حين أعلى","قدره عن ضغائن الأحقاد",69,"د",1,0],["طَهَ المُنادى بِأَلقابِ العُلا شَرَفاً","وَغَيرُهُ بِالأَسامي ضِمنَ كُتبِهِمِ",70,"م",1,0],["طَه الَّذي إِن أَخف ذَنبي وَلُذتُ بِهِ","آمنت خَوفي وَنجاني مِن النقمِ",70,"م",1,0],["(طهَ).. ومَنْ غيرُ (طهَ) حين تندبُهُ","سفينةُ الخلقِ لا يُخشَى لها الغَرَقُ؟!",71,"ق",1,0],["طه النبي ابن عبد الله ابن أبي ال","بطحاء ذا القرشي الهاشمي الحرمي",72,"م",2,0],["طهر له بيتاً ليسكنه وما","هو غير قلبك ظالماً أو مقسطا",73,"ط",2,0],["طه الرسول تكونت من نوره","كل البرية ثم لو ترك الغطا",73,"ط",2,0],["طه النبي الذي أرسلته كرماً","فينا لكشف وإيضاح وتبيين",74,"ن",1,0],["طه المختار وشيعته","والصحب ذوي الحظ الفرج",75,"ج",1,0],["طَهّرْ العين بالمدَامِع سَكْبَا","من شُهود السّوى يزل كلَّ علهْ",76,"ل",2,0],["طَهورٌ وَقودٌ مَع وَلوعٍ وَزِد لَها","وَضوءٌ وَخَتمُ الكُلِّ لَفظُ قَبولِ",77,"ل",1,0],["طَهُرْتُمْ فكُنْتُم مَدِيْحَ المَدِيْحِ","وكانَ سِوَاكُمْ هِجاءَ الهِجَاءِ",78,"ا",2,0]]}