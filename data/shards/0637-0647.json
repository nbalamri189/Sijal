اهب","https://www.poetsgate.com/ViewPoem.aspx?id=194570",""],[5431,"كي لا تُداس وتُكسرا","https://www.poetsgate.com/ViewPoem.aspx?id=196669",""],[5431,"فراسة...","https://www.poetsgate.com/ViewPoem.aspx?id=198451",""],[5444,"يمن المحن","https://www.poetsgate.com/ViewPoem.aspx?id=185390",""],[5444,"صلوات على أعتاب بيت المقدس","https://www.poetsgate.com/ViewPoem.aspx?id=205077",""],[5587,"- جَدُّ الحُسَينِ","https://www.poetsgate.com/ViewPoem.aspx?id=196781",""],[4623,"أتسرك الدنيا وعمرك ذاهب ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146604",""],[5758,"تَرَاتِيلُ الشَّمْس","https://www.poetsgate.com/ViewPoem.aspx?id=200496",""],[5776,"البُردةُ اليمانيةُ الثالثة","https://www.poetsgate.com/ViewPoem.aspx?id=199545",""],[5785,"باهي المحيَّا شمس نصف النهار","https://www.poetsgate.com/ViewPoem.aspx?id=131580",""],[5794,"غرور الشعر ..","https://www.poetsgate.com/ViewPoem.aspx?id=122796",""],[5842,"رسالة .. إلى الجيش العربي السوري","https://www.poetsgate.com/ViewPoem.aspx?id=67970",""],[5887,"شعبي المغوار","https://www.poetsgate.com/ViewPoem.aspx?id=35364",""],[514,"إِلَّا إِلَيكَ تَسَابَقنَا إِلَى الغَرَقِ","https://www.poetsgate.com/ViewPoem.aspx?id=155918",""],[1920,"فائز","https://www.poetsgate.com/ViewPoem.aspx?id=215797",""],[5956,"أوطان الحب","https://www.poetsgate.com/ViewPoem.aspx?id=192320",""],[5956,"أرجوك يا ربي أكون جوار طه","https://www.poetsgate.com/ViewPoem.aspx?id=192703",""],[5956,"الذكرى الخالدة لوحدة الجمهورية العربية المتحدة","https://www.poetsgate.com/ViewPoem.aspx?id=193991",""],[6019,"إِلَّا إِلَيكَ تَسَابَقنَا إِلَى الغَرَقِ","https://www.poetsgate.com/ViewPoem.aspx?id=155966",""],[6056,"جرح السنين","https://www.poetsgate.com/ViewPoem.aspx?id=130356",""],[6066,"إِلَى مَنْ كَانَ جُرْمُهُمْ أَنْ صَلًّوا صَلاةَ ال","https://www.poetsgate.com/ViewPoem.aspx?id=12668",""],[6070,"طَهِّرْ فؤادكَ ياصديقي لا تكنْ","https://www.poetsgate.com/ViewPoem.aspx?id=190004",""],[6093,"رمضانُ أقبل ( البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176206",""],[6106,"سيدتنا الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=6302",""],[6142,"مذ صلصل الله من طين خليقته","https://www.poetsgate.com/ViewPoem.aspx?id=155709",""],[6152,"هاشميون","https://www.poetsgate.com/ViewPoem.aspx?id=203020",""],[5377,"من أحرار اليمن إلى أحرار العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79560&r=&rc=16",""],[6054,"تنقبت بالنور والنور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55249&r=&rc=4",""],[402,"مريم يا غرس خير كرم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54054&r=&rc=906",""],[6318,"الفجر الدامي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66161&r=&rc=11",""],[6348,"أنثى وطريق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87164&r=&rc=0",""],[6355,"شرف الحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66576&r=&rc=36",""]],"verses":[["طَهُرنَ نَباهَةً وَبَرَرنَ طَولاً","وَهُنَّ وَراءَ مَعدودِ الحِجالِ",0,"ل",1,0],["طَهَّرتُ قَلبي مُذ عَلِمتُ بِأَنَّهُ","لِسُرى مَدائِحِهِ العِظامِ طَريقُ",1,"ق",1,0],["طَهورٌ إِذا ما دُنِّسَت كَفُّ كاتِبٍ","وَثَوبٌ إِذا ما قَرَّ في الطِرسِ مِرقَمُ",2,"م",1,0],["طَهِّر بِسَيفِكَ بَيتَ اللَهِ مِن دَنَسٍ","وَما أَحاطَ بِهِ مِن خِسَّةٍ وَخَنا",3,"ن",2,0],["طهرت من الأوضار شيمته","ولم يدنس بجاده",4,"د",2,0],["طهْرٌ تَمَامٌ عَقْلٌ","لُطْف تَمَامُ ظَرْفٌ تَمَامُ",5,"م",1,0],["طهِّر ثيابك ممن لا يؤهِّلُهُ","عند العُطاس ذوو التقوى لتشميتِ",6,"ت",1,0],["طهِّر ثيابك ممن لا ثيابَ له","من ذنبه غيرُ أطمارٍ مَهاريتِ",6,"ت",1,0],["طهَّرني الله كتطهيره","ليلة زُفّت من دم العُذرهْ",7,"ر",2,0],["طهِّري يا شقيقَةَ الرُّوحِ ثَغري","بلهيبِ الحَيَاةِ بلْ قَبِّليني",8,"ن",2,0],["طَهِّرْ كُلُومَكَ بالدُّمُوع","وخَلِّها وسَبِيلَهَا",9,"ه",2,0],["طهر زيان به الحجا","ب ولا يشان به السفور",10,"ر",1,0],["طَهِّرْ لِسَانَكَ مَا اسْتَطَعْتَ وَلا تَكُنْ","خِبّاً يُقَرِّبُ لِلنُّفُوسِ ضَلالَهَا",11,"ه",2,1],["طَهارَى عليهم من سَنا الحقِّ بَهجةٌ","لها وَهَجٌ باقٍ على الدّهرِ لا يَخْبُو",12,"ب",2,0],["طَهارَةُ مِثلي في التَباعُدِ عَنكُمُ","وَقُربُكُمُ يَجني هُمومي وَأَدناسي",13,"س",2,0],["طَهَّرتُ ثَوبي لِلصَلاةِ وَقَبلَهُ","طُهرٌ فَأَينَ الطُهرُ مِن جَسَدَيكُما",14,"م",2,0],["طَهَت لَكَ الشَمسُ ما يُغني أَخا دَعَةٍ","عَن أَن يَكونَ لَهُ في الأَرضِ طاهونا",15,"ن",2,0],["طُهْرٌ عَصَمْتَ به الشبابَ وإنما","شِيمُ الملوكِ به أحقُّ وأخلقُ",16,"ق",1,0],["طَهَّرَهُ وَالكَبيرُ رِجسٌ","يُدَنِّسُ العرضَ وَالرِياطا",17,"ط",2,0],["طه وَياسين عَوِّذاني","فَإِنَّ قَلبي عَلَيهِ شاطا",17,"ط",2,0],["طَهَّرْته ةمن كلِّ مَا تأبى النُّهَى","ويَعَافُهُ سَمْعُ الحِسَانِ الْخُودِ",18,"د",1,0],["طَهُرتْ مِنَ الصَّلَفِ الذّمِيمِ","وَعُنْفُوَانِ الْمُسْتَبِدِّ",19,"د",1,0],["طَهَ. ولاسمِكَ من حرفَيْه أُغنيةٌ","تُوحي بكلِّ معاني المجد والحَسَب",20,"ب",1,0],["طَهُرتَ فأعرى طهرُكَ المحضُ معشرًا","وولَّدَ في بعض النفوس التمرُّدا",21,"د",2,0],["طه، فديتك من أغرَّ، همام","طلْقِ المحيا، مشرقٍ، بسَّامِ!",22,"م",1,1],["طَهَّرْتِ أرجاء الحمى","من كلِّ جبَّارٍ عَنِيد",23,"د",1,0],["طهر ثيابك واغسل راحتيك فها","تيك المطامع أوساخ وأدران",24,"ن",1,0],["\" طه \" إذا ثار إنشادي فإنّ أبي","\" حسّان \" أخباره في الشعر أخباري",25,"ر",2,0],["\" طه \" إليك صلاة الشعرر ترفعها","روحي وتعزفها أوتار قيثار",25,"ر",1,0],["طهّرت آثامي البريئة في لظى","قبل كأحلام النّعيم عذاب",26,"ب",1,0],["طهر سريرتك التي آفاتها","سوء وصبغتها النقائض والقذر",27,"ر",1,0],["\" طه \" إليك صلاة الشعر ترفعها","روحي وتعزفها أوتار قيثار",28,"ر",1,0],["طه حبيب الله سيد خلقه","سبب الوجود القبضة البيضاء",29,"ا",2,0],["طهارة القلب من رؤياي تمنعه","وعزة الصدق من رؤياه تمنعني",30,"ي",1,0],["طه بتعريف عليا شانه نزلت","وجاء بالكوثر التبتير للشاني",31,"ن",2,0],["طه سراج المرسلين وقبضة الن","نور القديم وأكرم الهيجاء",32,"ا",2,0],["طهر لنا بفلك السريره","ونور الأبصار والبصيره",33,"ه",1,0],["طَهوراً عابداً ثقةً كريمَا","سليمَ القلب مُتَّقِياً صَبُورَا",34,"ر",2,0],["طُهرت من الأحقادِ نيَته","والقلبُ مغسول من الغِمرِ",35,"ر",1,0],["طهّر فؤادك من نجاسة إثمها","أًَو لاَ فأعدد للعذاب الأكبر",36,"ر",1,0],["طهُرتْ وَبرَّتْ مِنهُ نَفسٌ حُرّةٌ","بِشَوائبِ الأَيّامِ لَم تَتَدَنَّسِ",37,"س",1,0],["طهَ لَنا وَسيلةٌ للباري","نَبغي بهِ النصرَ على الكفّارِ",38,"ر",1,0],["طهَ لهُ قد كان أوّل باني","فلهُ على التقوى أساسٌ محكمُ",39,"م",1,0],["طه ويس كهف الانبياء ومن","عليه قد انزلت حم تنزيل",40,"ل",1,0],["طه أمتّ أجبني كيف لا عجبٌ","إن السيوف إلى أجفان أغماد",41,"د",1,0],["طه أجبني أجب هل مت هل ذهبت","تلك الخصال إلى آباد آباد",41,"د",1,0],["طَهِّر بِلادَ العَدلِ مِن جَورِهِ","وَنَزِّهِ الإِسلامَ مِن كُفرِهِ",42,"ر",2,0],["طهر به ماء المحيط منظّفا","خطراً على ماء المحيط وبيلا",43,"ل",2,0],["طهّريني في بحار الغيب من","كلّ عيبٍ مؤذنٍ في حجبنا",44,"ن",2,0],["طهرُ الهوى والحسنُ صانتهُ لنا","بيّاعةُ الزَّهر التي لم تُلمسِ",45,"س",1,0],["طَهِّرْ بِلادَك مِنْهُم إِنَّهُم نَجَسٌ","وَلا طَهَارَةَ ما لَم تَغْسِل النَّجَسا",46,"س",2,0],["طُهر المآزِرِ مذ نيطَت تمائمُهم","نالوا من المَجد ما نالوا من الظفرِ",47,"ر",1,0],["طَهروا به مِن لمّة الشيطانِ في","بضعٍ كَما طابوا ثنىً ونجارا",48,"ر",2,0],["طَهّرَ اللّه مَوضعِ المسّ منها","مِن معافاتِه بماءٍ برودِ",49,"د",1,0],["طهرنا ديننا وللناس أديان","وبعض الأديان من شهوات",50,"ت",1,0],["طهريني من رجس دنياي بالنا","ر تلظى في روحك الغلاب",51,"ب",1,0],["طه البَشير الطاهِر الطهر الَّذي","هو لِلقُلوبِ وَسَقمِها تِرياق",52,"ق",1,0],["طهر اللَه أَصغريك وَلا زِل","ت لطلابك الا ماجد ذخرا",53,"ر",2,0],["طَهِّرْ بسَيفِك ظاهِرَ الأرضِ التي","نَجِسَتُ بوَطْءِ أولئك الأرجاس",54,"س",1,0],["طَهِّرْهُ غسْلاً منهمُ بدِمائهمْ","يَطْهُرْ مِنَ الأنجاسِ بالأنْجاس",54,"س",1,0],["طُهِّرَ السُّوقُ مِنه والمسجدُ الجا","معُ أولى بأن يُطَهَّرَ مِنهُ",55,"ن",2,0],["طهِّرِ العقل بالسهاد فتدري","فضلَ ما قد أَخذتَ فيه سبيلا",56,"ل",2,0],["طهارة نفسٍ لا تفيد وتنفعُ","إذا كان جسم النفس بالإثم يَمنعُ",57,"ع",1,1],["طهارة جسمٍ فاقت النفس رفعةً","وتلك من الأملاك أرقى وأرفع",57,"ع",1,0],["طهارة مريم العذراء كانت","لدقة عقلها رسماً وسورهْ",58,"ه",1,1],["طهره أعجلٌ ومن","جاء بالطهر يُشكَر",59,"ر",1,0],["طهر القلب من كل المعايب وعصيان","واحفظ القول من زوروافك وبهتان",60,"ن",1,0],["طَهِّرْ مِنَ التُركِ الطَّغام بقاعَها","فَلَطَالَ مَا عاثوا هُناك",61,"ك",1,0],["طهره لساناً إذا لغوت بها","بقولنا لا إله إلا اللّه",62,"ل",2,0],["طهَّر الله ذاتكم واصطفاكم","حجَّة للإسلام في الإِسلام",63,"م",1,0],["طَهِّر فؤادك بالرَّاحات تطهيرا","ودمْ على نَهْبِكَ اللَّذَّات مَسرورا",64,"ر",2,1],["طهْر الله ذاتهم واصطفاهم","قبل ما يُنتَجون من صلب آدم",65,"م",1,0],["طهّرتها من فساد كانَ يكنفها","ولم تدع باغياً فيها ولم تذر",66,"ر",1,0],["طهَّرها تدبيرُه فلم يدع","إزاءَها من العباد نجِسا",67,"س",2,0],["طَهِّرْ خِلالَك من خِل تعابُ به","وأسلم وحيداً فما في الناس مصحوبُ",68,"ب",1,0],["طَهورٍ مُتَوَّجةٍ بالجلال","مُخَضَّبَةٍ بالدَّمِ العَندَمِ",69,"م",1,0],["طهِّرِ القلبَ إنْ أَردْتَ هَواهُمْ","رُبَّ قولٍ ترُدُّهُ الأَفعَالُ",70,"ل",1,0],["طَهَ الحَقائقِ حكمُ يس العَمى","طس نَصِّ كِتابِهِ المُتَنَزِّلِ",71,"ل",1,0],["طهِّرِ القلبَ من غُبارِ البَرايا","واطلُبِ الفَتْح من يدِ الفتَّاحِ",72,"ح",1,0],["طهِّر بِمَاءِ التُّقى جَنابَك","واصحَب عَلى حَالِهِ زَمَانَك",73,"ك",1,1],["طهّرْتُهُ بالخَتْن وهو مطهَّرٌ","قبل الخِتانِ تشرُّعاً وتكرّما",74,"م",2,0],["طهر الله صدره حين أعلى","قدره عن ضغائن الأحقاد",75,"د",1,0],["طَهَ المُنادى بِأَلقابِ العُلا شَرَفاً","وَغَيرُهُ بِالأَسامي ضِمنَ كُتبِهِمِ",76,"م",1,0],["طَه الَّذي إِن أَخف ذَنبي وَلُذتُ بِهِ","آمنت خَوفي وَنجاني مِن النقمِ",76,"م",1,0],["(طهَ).. ومَنْ غيرُ (طهَ) حين تندبُهُ","سفينةُ الخلقِ لا يُخشَى لها الغَرَقُ؟!",77,"ق",1,0],["طه النبي ابن عبد الله ابن أبي ال","بطحاء ذا القرشي الهاشمي الحرمي",78,"م",2,0],["طهر له بيتاً ليسكنه وما","هو غير قلبك ظالماً أو مقسطا",79,"ط",2,0],["طه الرسول تكونت من نوره","كل البرية ثم لو ترك الغطا",79,"ط",2,0],["طه النبي الذي أرسلته كرماً","فينا لكشف وإيضاح وتبيين",80,"ن",1,0],["طه المختار وشيعته","والصحب ذوي الحظ الفرج",81,"ج",1,0],["طَهّرْ العين بالمدَامِع سَكْبَا","من شُهود السّوى يزل كلَّ علهْ",82,"ل",2,0],["طَهورٌ وَقودٌ مَع وَلوعٍ وَزِد لَها","وَضوءٌ وَخَتمُ الكُلِّ لَفظُ قَبولِ",83,"ل",1,0],["طَهُرْتُمْ فكُنْتُم مَدِيْحَ المَدِيْحِ","وكانَ سِوَاكُمْ هِجاءَ الهِجَاءِ",84,"ا",2,0],["طهروا عنصراً وطابوا فروعاً","وأمدوا على الورى أفياءا",85,"ا",3,0],["طَهَ الَّذي بِوجوده شَرف الألى","نالوا العُلى وَافخر بِهِ إِن تفخرِ",86,"ر",1,0],["طهرت له شم وعفَّت نظرة","فكأنه في بردتيه محرمُ",87,"م",1,0],["طه القمر الزاهر المنير جمالا","من عززة الحسن أن يقاس بأمثال",88,"ل",1,0],["طهَ الذي أبدى الهدى لَمَّا مَحَا","ليلَ الضَلاَلَةِ بِاليَدِ البَيْضَاءِ",89,"ا",2,0],["طه الرسول المصطفى","روح المعالي والجسد",90,"د",1,0],["طه العليم بأسرار الكتاب وما","خطت أنامله لاما ولا ألف",91,"ف",1,0],["طه الذي بِالعَضْبِ أفْنَى العِدَى","لمّا التقى الجَمْعَانِ يومَ الكفَاحْ",92,"ح",1,0],["طه الشفيع المجتبى خير الورى","كنز المعالي سيد الرؤاس",93,"س",1,0],["طَهَ بنِ عَبْدِ اللَّهِ مَنْ","حَازَ الشَّفَاعَةَ فِي غَدِ",94,"د",1,0],["طه أبو القاسم المختار من شرفت","به البسيطة والسبع السموات",95,"ت",1,0],["طهر تكون من طهر وشمس هدى","كالشمس لكنها جلت عن الحجب",96,"ب",1,0],["طه البشير المهتدي أحمد ال","ناصع الخالص نعتا وذات",97,"ت",1,0],["طه المفدى من سكن","خير البلاد وقطنه",98,"ه",1,0],["طَهارة الأَخلاق","مِن كَرَم الأَعراق",99,"ق",1,0],["طهر سريرتك التي آفاتها","سوء وصبغتها النقائص والقذر",100,"ر",1,0],["طَهِّرِ المصرَ مِنهُ يا أَيُّها المَو","لى المُسَمّى بِالعَدلِ وَالإِحسانِ",101,"ن",1,0],["طَهَرَ اللَهُ مِن الشُرك بِكُم","بَيتَ مال الحَجِ وَاِنكَف الملح",102,"ح",1,0],["طَهر اللَهُ فيهِ حمصاً كَما قَد","طَهَرت طيبة مِن الأَرجاس",103,"س",1,0],["طه ياسين الأمين أتى","حمده في نون والقلم",104,"م",1,0],["طه الأمين أتى بالدين آيته ال","سبع المثاني وعنه أحجم الفيل",105,"ل",1,0],["طهَّرها الرحمنُ عِلماً بها","وبالتُقى والنُسكِ زكَّاها",106,"ا",3,0],["طه أبو القاسم المبعوث من مضر","إلى البرية من عرب ومن عجم",107,"م",1,0],["طَهارَةُ نَفسٍ رُعتُها بِغَوايَتي","فَوَلَّت عَلى حكم البِغاء من الذُعر",108,"ر",1,0],["طَهِّريها بِنارِ حُبِّكِ مِمّا","نَشَرَت فَوقَها غُيومُ الخَطِيَّه",109,"ي",2,0],["طَهِّروا هَذِهِ السُجونَ وَشيدوا","لِأَخي الفُحشِ مَعقِلاً مِن حَيائِه",110,"ا",3,0],["طه أخوه وبقربه له","يدوس هامات المعادي فرطا",111,"ط",2,0],["طهروا النفسَ باجتناب المعاصي","واستزيدوا هدياً من القرآنِ",112,"ن",1,0],["طهَّرَ الأرضَ والذي دَبَّ فيها","وأمدَّ الحياةَ بالريعانِ",112,"ن",1,0],["طهروها من الرذيلة حتى","تنقذوها من ثور