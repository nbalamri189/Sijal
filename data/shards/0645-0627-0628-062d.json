{"poems":[[53,"ما بحريث نال ابنه الكرما","https://www.aldiwan.net/poem66351.html","المنسرح"],[443,"أشفيت حر جوى ودمعك يهمل","https://www.aldiwan.net/poem2502.html","الكامل"],[469,"رفقاً بها يا سائق الأظعان","https://www.aldiwan.net/poem3197.html","عموديه"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87113","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86972","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64044","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56296","السريع"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77976","البسيط"],[1600,"","https://poetry.dctabudhabi.ae/diwan/poem/146089","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93928","الكامل"],[4056,"","https://poetry.dctabudhabi.ae/diwan/poem/143577","السريع"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66167","الكامل"],[5277,"ختام الخواتيم","https://www.poetsgate.com/ViewPoem.aspx?id=187287",""],[5277,"الأميرة","https://www.poetsgate.com/ViewPoem.aspx?id=191241",""],[173,"َما بَحرُ الهُمومِ بِهِ فَمادا","https://www.poetsgate.com/ViewPoem.aspx?id=40404",""]],"verses":[["ما بحريثٍ نال ابنُه الكرما","لكن بما قد أباحنا الحُرما",0,"م",2,1],["ما بحت لولا الدمع يظهر بعض ما","أخفيته لو أن ذلك يجمل",1,"ل",1,0],["ما بحتُ بالشّكوى إليه وإنّما","نسختْ دموعي آيةَ الكتمان",2,"ن",1,0],["ما بِحُسن الإِخلاص أَنشد مَجدي","مدحةً فيهِ ذاتَ درٍّ نظيم",3,"م",1,0],["ما بحسن الثَنا عَلَيهِ تَباهى","كُل عقد مِن اللآلي تَألَّف",4,"ف",1,0],["ما بحرُ بقراطَ إلا غَرفةٌ بيدٍ","من بحركَ الصَّخِبِ التيار يُغتَرف",5,"ف",1,0],["ما بحت في عمري بأمري ولا","جيتُ لأبواب الرجا أطرقُ",6,"ق",1,0],["ما بحر دجلة وَالنيل أَستقي بهما","مع الفرات يساوي رمل تبرين",7,"ن",1,0],["ما بحت عنه سوى قذىً والعين لا","تصفو من الأقذاء ما لم تضرح",8,"ح",1,0],["ما بحت يوماً في غرامي باسمه","كان التواصل منه أو كان الجفا",9,"ف",2,0],["ما بُحتُ بالحُبِّ ولكنّني","وما بجَفْنيكَ منَ السِّحر",10,"ر",1,0],["مابحق لولا الشقاوة حقت","بهمو حين عاندوا من خفاء",11,"ا",2,0],["ما بُحْتُ بالسرِّ المَصُونِ فأَمْرُنا","حَتَّى القِيامَةِ لَيْسَ بالمَهْتُوكِ",12,"ك",1,0],["ما بحتُ باسْمِكِ بلْ عمَّيتُ تكنيةً","وقدْ جعلتكِ في الوجدانِ وجدانا",13,"ن",2,0],["ما بحتُ يوماً بالَّتي عانقتُها","كتعانقِ الغيماتِ وسطَ سماءِ",14,"ا",2,0],["َما بَحرُ الهُمومِ بِهِ فَمادا","وَعَوَّضَهُ مِنَ الغمضِ السُهادا",15,"د",2,1]]}