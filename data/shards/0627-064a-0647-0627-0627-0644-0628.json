"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125910","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86429","الخفيف"],[4201,"","https://poetry.dctabudhabi.ae/diwan/poem/143826","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81234","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73142","المديد"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62136","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52171","الرمل"],[4693,"يا حياة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=29927",""],[4755,"قد وَهَبناكَ فَوقَ ما تَستَطِيعُ","https://www.poetsgate.com/ViewPoem.aspx?id=184812",""],[4578,"أطلع الريحان في روضِ الشقيق","https://www.poetsgate.com/ViewPoem.aspx?id=49490",""],[1901,"أرهقْتنا الأيامُ بسطاً وقبضاً","https://www.poetsgate.com/ViewPoem.aspx?id=160385",""],[5111,"رَحَمَاتٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212311",""],[5277,"رسائل عشق إلى بغداد..9","https://www.poetsgate.com/ViewPoem.aspx?id=191534",""],[5376,"علي الأذربيجاني ونينو الجورجية","https://www.poetsgate.com/ViewPoem.aspx?id=202463",""],[5409,"يا رواق المجلس الحا","https://www.poetsgate.com/ViewPoem.aspx?id=155291",""],[5725,"قمر بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=177977",""],[5956,"أُعاتب البحر","https://www.poetsgate.com/ViewPoem.aspx?id=183227",""],[5956,"أيها الباخلُ","https://www.poetsgate.com/ViewPoem.aspx?id=192943",""],[6102,"فواتير","https://www.poetsgate.com/ViewPoem.aspx?id=184556",""],[6212,"طائفية أو فيفية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1624&r=&rc=5",""],[6237,"أحمد أمين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77883&r=&rc=25",""]],"verses":[["أَيُّها البَدرُ الَّذي","يَملَأُ عَينَي مَن تَأَمَّل",0,"ل",1,1],["أَيُّها البَحرُ الَّذي مَهما تَفِض","بِالنَدى يُمناهُ فَالبَحرُ وَشَل",1,"ل",1,0],["أيَّهَا البَالِغُ الثُّرَيَّا مَقَامَاً","هَلْ تَرَى فَوْقَ مَا بَلَغْتَ مَرَامَا",2,"م",2,1],["أيُّها البحر الذي عن","ه روى الناس العجائب",3,"ب",1,1],["أيها البحر نائلاً وعلوماً","وبأهلِ الرَّجاءِ يا أيها البرّ",4,"ر",1,1],["أيها الباحثُ الذي","عن مخازيه يبحثُ",5,"ث",1,0],["أيها البيهقي أحسنت في شع","رك إحسان ذي طباع وحذقِ",6,"ق",1,1],["أيُّها البحرُ طال بي","ظمئي في سواحلكْ",7,"ك",1,0],["أيُّها البدرُ لا تزل في كمالِ ال","أمرِ بدراً وفي النَّماءِ هِلالا",8,"ل",2,0],["أَيُّها البَحرُ أَتَدري كَم مَضَت أَلفٌ عَلَيكا","وَهَلِ الشاطِئُ يَدري أَنَّهُ جاثٍ لَدَيكا",9,"ك",2,0],["ايها البدر الذي","في قريضي اصفك",10,"ك",1,1],["أيها البحر ألق في مصر أملا","حك حتى ترابها يتسبخ",11,"خ",1,1],["أَيُّها الباهِرُ العُقولَ فَما تُد","رَكُ وَصفاً أَتعَبتَ فِكري فَمَهلا",12,"ل",2,0],["أيها البرقُ إن وَجَدْتَ غَماماً","فَاسْق نجداً به ومَن حَلَّ نَجدا",13,"د",2,0],["أَيُّها الباني قُصوراً طِوالاً","أَينَ تَبغي هَل تُريدُ السَحابا",14,"ب",2,0],["أَيُّها الباني لِهَدمِ اللَيالي","إِبنِ ما شِئتَ سَتَلقى خَرابا",14,"ب",2,0],["أَيُّها البَرقُ بِت بِأَعلى البِراقِ","وَاِغدُ فيها بِوابِلٍ غَيداقِ",15,"ق",1,1],["أيها الباخلُ فيما قد مَلَكْ","أنتَ للمالِ وليسَ المالُ لكْ",16,"ك",1,1],["أَيُّها الباكِرُ المُريدُ فِراقي","بَعدَ ما هِجتَ بِالحَديثِ اِشتِياقي",17,"ق",2,1],["أَيُّها البارِقُ الَّذي لَيسَ يُجدي","قَد عَرَفناكَ فَاِلتَمِس مَن تَغُرُّ",18,"ر",1,0],["أيُها البَينُ أَقِلْني مرةً","فإذا عُدْتُ فقد حلَّ دمي",19,"م",2,0],["أَيُّها البَدرُ الذي ضَنْ","نَ عَلينا بِالطُّلوعِ",20,"ع",1,1],["أيها البحر كيف تنجو من الليْ","لِ وأين المنجي بتلك الرحابِ",21,"ب",1,0],["أيُّها البحر سفيني ما عَراها","رنَّحتها نبأةٌ رقَّ صداها",22,"ه",2,0],["أَيُّها البَحرُ لا يَغُرَّنكَ حَولٌ","وَاِتِّساعٌ وَأَنتَ خَلقٌ كَبيرُ",23,"ر",1,0],["ايها الباعث من أمته","أمةً تمخُرُ في المجدِ وتُرسي",24,"س",2,0],["أيها البلبل المغرد في الليل","على كل أخضر مياد",25,"د",1,1],["أيها البرقُ، ما حملتَ إلى مص","رَ سلامًا من الحبيبِ البعيد",26,"د",1,0],["أيها البحرُ، قد حمَلتَ رفاتًا","هُو أغلَى من درِّك المنضود",26,"د",1,0],["أيها البائس المعذب، رحما","ك! دع الخلق، واسأل الخلاقا",27,"ق",2,0],["أيّها البحر ! بعض تيهك واذكر","نسبا بيننا قديم العهود",28,"د",1,0],["أيّها البحر ! أنت مهما افترقنا","ملك آبائنا وملك الجدود",28,"د",1,0],["أيها البدر كنت تطلع قبلي","أيها البدر سوف تطلع بعدي",29,"ي",1,0],["أيها البرق في السحاب تألق","أنت سيف مجرد ذو فرند",29,"د",1,0],["أيها الباكي على أوطانه","لا يرد الروح للميت نوح",30,"ح",1,0],["أَيُّها البَدْرُ الَّذي يَحْ","سُدُهُ بَدْرُ التَّمامِ",31,"م",1,0],["أيها البحر سلام وسلام","أيها البحر غناء وغناء",32,"ا",2,0],["أيها البحر غرامٌ وغرام","أيها البحر لقاءٌ ولقاء",32,"ا",2,0],["أيّها البحر قد وردنا ظماءً","لالتقاط الجواهر اللؤلؤيّه",33,"ي",2,0],["أَيُّها البَدر لَو تقاسى وَلوعى","وَغَرامي رحمت مِمّا أقاسي",34,"س",2,0],["أيُّها البَدرُ الّذي يجلو الدُّجا","إنُّ رُوحي في هَواكُمْ تحتَرِقْ",35,"ق",1,1],["أيُّها البدرُ الَّذي زادَ سَناً","زادك الله سَناءً وكمالا",36,"ل",2,0],["أيها البدر ليت ضوك باد","لتيقنت أن ذاك الشادي",37,"ي",1,0],["أيها الباشا التهامي المقتفي","سبلَ الخير وخيرَ السبلِ",38,"ل",1,0],["أَيُّها الباكي عَلى ما فاتَهُ","أَقصِرَن عَنكَ فَبَعضُ القَولِ عارُ",39,"ر",1,0],["أيها البرق اللموعُ","لك من نجدٍ طلوعُ",40,"ع",1,1],["أيُّها البدر فاِجل عنّا الدياجي","وتحلّى بالغرّة الغرّاءِ",41,"ا",2,0],["أيها البوش لا توحوا فهذي","شيمةُ الدهر والحظوظُ تدور",42,"ر",1,0],["أيها البدر الذي تيمني","منه وجه يشبه البدر وخد",43,"د",1,0],["أَيّها البدرُ يَهتَويكَ اِفتِناناً","إِذ سَباهُ جَمالُكَ الفتّانُ",44,"ن",1,0],["أَيُّها البدرُ لا اِعتَراهُ زَوالٌ","وَتَناءَى بِسَعدِهِ عَن سرارِ",45,"ر",1,0],["أيها الباخلُ الذي جمع الما","لَ اغْتراراً أقصِرْ فإنك هالكْ",46,"ك",1,1],["أيها الباز الأشهب الغوث إني","في الملمات طائر بجناحك",47,"ك",1,1],["أيُّها البارق مهلاً","جبلاً جئتَ وسهلا",48,"ل",2,1],["أيها البائع الجليل أَجل أن","ت عليم بهذه الأحوالِ",49,"ل",1,1],["ايها البضعة يا خير النسا","كيف تلهين وأولادك طير",50,"ر",1,0],["أيها البحر ترفَّق بالدُّمى","وسيجزيك الجزا الخيرَ دعاي",51,"ا",2,0],["أيها البائع الرغائب بالحم","د وحاوي محاسن الأخلاق",52,"ق",1,0],["أيها البارع الذي","كلل الحكم بالحِكَم",53,"م",1,0],["أيها البلبلُ هيا غنِّ لي","إنَّ خيرَ العيشِ ساعاتُ الهَنَا",54,"ن",2,1],["أيُّها البلبلُ غرِّد","فوقَ ميَّاسِ الغُصُون",55,"ن",1,1],["ا