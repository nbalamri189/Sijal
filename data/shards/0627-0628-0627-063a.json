{"poems":[[55,"يا ناشد النعماء يقفو إثرها","https://www.aldiwan.net/poem30480.html","الرجز"],[55,"ألا من عذيري في رجال تواعدوا","https://www.aldiwan.net/poem30644.html","الطويل"],[90,"أبو غازي قضى فاقيم غازي","https://www.aldiwan.net/poem45037.html","الوافر"],[31,"غدا ابنا وائل ليعاتباني","https://www.aldiwan.net/poem6060.html","الوافر"],[47,"أبا غانم فيم احتشامك عندنا","https://www.aldiwan.net/poem11428.html","الطويل"],[47,"تقضى الصبا إلا تلوم راحل","https://www.aldiwan.net/poem65618.html","الطويل"],[47,"أقصر حميد لا عزاء لمغرم","https://www.aldiwan.net/poem65656.html","الطويل"],[51,"أبا غانم أما ذراك فواسع","https://www.aldiwan.net/poem64313.html","الطويل"],[48,"أيا شجر العرا أوسعت ريا","https://www.aldiwan.net/poem22995.html","الوافر"],[47,"أبا غانم فيما احشامك عندنا","https://www.poetsgate.com/ViewPoem.aspx?id=31408",""],[47,"أقَصْرَ حُمَيدٍ! لا عَزَاءَ لمَغْرَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=31730",""],[242,"أبا غالب ضري لجسمي غالب","https://www.aldiwan.net/poem18055.html","الطويل"],[347,"أبا غازي ابا الفضل","https://www.aldiwan.net/poem55349.html","مجزوء الوافر"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145800","المتقارب"],[1389,"","https://poetry.dctabudhabi.ae/diwan/poem/102238","الطويل"],[2274,"","https://poetry.dctabudhabi.ae/diwan/poem/144754","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129455","الطويل"],[4119,"لكم من فؤادي ما اباحكم الوجد","https://www.poetsgate.com/ViewPoem.aspx?id=16112",""],[5213,"ألا للّه خطبك ما أجلا","https://www.poetsgate.com/ViewPoem.aspx?id=170531",""]],"verses":[["أَباغِثَ الطَيرِ تَراءَت صَقرَها","فَحلُ وَغىً يُنسي الفُحولَ هَدرَها",0,"ر",3,0],["أَباغَثُ أَضَرَّتها السَفاهَةُ فَاِغتَدَت","تَخَطَّفُ هَذا القَولَ خَطفَ الجَوارِحِ",1,"ح",1,0],["أبا غازي فقدنا منك قرماً","يناجز دوننا يوم النجاز",2,"ز",1,0],["أَبا غَسّانَ إِنَّكَ لَم تُهِنّي","وَلَكِن قَد أَهَنتَ بَني شِهابِ",3,"ب",1,0],["أَبا غانِمٍ فيمَ اِحتِشامُكَ عِندَنا","وَكِتمانُكَ الداءَ الَّذي أَنتَ صاحِبُه",4,"ب",2,1],["أَبا غانِمٍ لا تَبرَحَن غُنمَ آمِلٍ","تَأَمَّلَ نُجحاً أَو مُعَوَّلَ عائِلِ",5,"ل",1,0],["أَبا غانِمٍ أَردى بَنيكَ اِعتِقادُهُم","بِأَنَّ الرَدى في الحَربِ أَكرَمُ مَغنَمِ",6,"م",1,0],["أَبا غانِمٍ أَما ذَراكَ فَواسِعٌ","وَقَبرُكَ مَعمورُ الجَوانِبِ مُحكَمُ",7,"م",1,1],["أَباغي حَظِّهِ بِقَناً وَخَيلٍ","كَباغيهِ بِمُنوالٍ وَحَفِّ",8,"ف",1,0],["أبا غانم فيما احشامك عندنا","وكتمانك الداء الذي أنت صاحبه",9,"ب",2,1],["أبَا غانِمٍ أرْدَى بَنيكَ اعتِقادُهُم","ْ بأنّ الرّدَى، في الحرْبِ، أكبرُ مَغنمِ",10,"م",1,0],["أَبَا غَالِبٍ ضُرِّي لجِسْميَ غَالِبُ","فَفِي عَصَبِي نَابٌ لَهُ وَمخَالِبُ",11,"ب",1,1],["أبا غازي ابا الفضلِ","كريم الفرع والاصلِ",12,"ل",1,1],["ابا غازي وساعات","مضت كالسهم والنصل",12,"ل",1,0],["أباغِتها مرَّة ًلاسِعاً","بها عظمَها قدْر ما تلسَعُ",13,"ع",1,0],["أباغ يرى أُخراه مَن يزدهيه من","زخاريف دنياه الدنيه يساغُ",14,"غ",1,0],["أبا غالِب سلطانَ مكةَ أحمد ب","ن غالِبَ راعيها الحفى الدايل الدالي",15,"ل",2,0],["أبا غائب تالله ما من صنيعة","يهز غصون المكرمات نسيمها",16,"ه",2,1],["أبا غانم إن السماحة منهل","بكفيك منها كل شارقة ورد",17,"د",1,0],["أباغي الجود جد السير كيما","ينال مناه إن بلغ المحلا",18,"ل",2,0]]}