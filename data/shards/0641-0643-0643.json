{"poems":[[10,"ياعين جودي بدمع منك مسكوب","https://www.aldiwan.net/poem20950.html","البسيط"],[11,"فككت عدياَ كلها من إسارها","https://www.aldiwan.net/poem249.html",""],[119,"فككت بجاه خير الخلق عقدا","https://www.aldiwan.net/poem42153.html","الوافر"],[199,"عما يا ابنتي قيس صباحا ومظلما","https://www.aldiwan.net/poem54406.html","الطويل"],[253,"تداركني أوس بن سعدى بنعمة","https://www.aldiwan.net/poem2112.html","الطويل"],[302,"رأى البرق في جنح الدجى يتألق","https://www.aldiwan.net/poem36295.html","عموديه"],[445,"كتابك يا علي زار غبا","https://www.aldiwan.net/poem14295.html","الوافر"],[461,"ألم أتحدث والحديث شجون","https://www.aldiwan.net/poem55857.html","الطويل"],[461,"أيا سكر الزمان متى تفيق","https://www.aldiwan.net/poem56099.html","الوافر"],[532,"محب جفاني مرة ثم زارني","https://www.aldiwan.net/poem37351.html","الطويل"],[824,"","https://poetry.dctabudhabi.ae/diwan/poem/97732","المتقارب"],[874,"","https://poetry.dctabudhabi.ae/diwan/poem/17710","الطويل"]],"verses":[["فَكَكتَهُ وَمَقالٍ قُلتَهُ حَسَنٍ","بَعدَ المَقالَةِ لَم يُؤبَن بِتَكذيبِ",0,"ب",1,0],["فَكَكتَ عَدِيّاً كُلَّها مِن إِسارِها","فَأَفضِل وَشَفِّعني بِقَيسِ اِبنِ جَحدَرِ",1,"ر",1,1],["فككت بجاه خير الخلق عقداً","به قد أذهل الباغون فكري",2,"ر",2,1],["فَكَكنا بَني بَكرٍ وَقَد شَدَّ دونَهُم","أَبو كَربٍ غُلّاً وَأَزهُمَ مُحكَما",3,"م",2,0],["فَكَكتَ أَسيراً ثُمَّ أَفضَلتَ نِعمَةً","فَسُلِّمَ مَبرِيُّ العِظامِ مَهيضُ",4,"ض",1,0],["فككتَ يداً مغلولةً فقطعتها","حنانيك إنَّ الغلَّ أرجى وَأَرفق",5,"ق",1,0],["فككت ختامه فشذى عبيراً","ولامح جوهراً وانساع ضربا",6,"ب",2,0],["فككتَ وقد راجعته عُنْقَه وفي","حبالهمُ شكوى لهم وأنين",7,"ن",1,0],["فككتَ توحشي وأسرتَ ودّي","فهاأنا ناشطٌ بك بل ربيقُ",8,"ق",1,0],["فكَْ كانَ هذا العُمْرُ إنْ كُنْتَ حاسِباً","أَديباً لَبيباً عالِماً مُتَيَقّضا",9,"ض",2,0],["فَككتَ أُسارى بَني جعفرٍ","وَكِندة إِذ نلت أَقوالها",10,"ل",3,0],["فَكَكنا حَديدَ الغِلِّ عَنهُم فَسُرِّحوا","جَميعاً وَأَحظى الناسِ بَالخَيرِ فاعِلُه",11,"ل",2,0]]}