{"poems":[[79,"تألق نجديا فأذكرني نجدا","https://www.aldiwan.net/poem36536.html","الطويل"],[87,"يا مصر سماؤك جوهرة","https://www.aldiwan.net/poem7882.html","المتدارك"],[45,"كم قتيل كما قتلت شهيد","https://www.aldiwan.net/poem9532.html","الخفيف"],[47,"هويناك من لوم على حب تكتما","https://www.aldiwan.net/poem65682.html","الطويل"],[111,"تلك البوارق حاديهن مرنان","https://www.poetsgate.com/ViewPoem.aspx?id=100",""],[119,"لسراج الأنبيا حامي النزيل","https://www.aldiwan.net/poem41965.html","الرمل"],[199,"ما هاج شوقك من مغاني دمنة","https://www.aldiwan.net/poem54420.html","الكامل"],[228,"أولا تراهم يرتدون","https://www.aldiwan.net/poem41595.html","مجزوء الكامل"],[280,"ألما بأشلاء العلى والمكارم","https://www.aldiwan.net/poem25526.html","الطويل"],[302,"أمير المؤمنين فدتك نفسي","https://www.aldiwan.net/poem33023.html","الوافر"],[309,"إن كان هذا الذي أكابده","https://www.aldiwan.net/poem16752.html","المنسرح"],[323,"ولو أعطاني الدهر اختياري","https://www.aldiwan.net/poem62621.html","الوافر"],[369,"سهام نواظر تصمي الرمايا","https://www.aldiwan.net/poem60572.html","الوافر"],[415,"نظام الدين لا سقيا لخطب","https://www.aldiwan.net/poem32267.html","الوافر"],[438,"لسري في صدوركم مكان","https://www.aldiwan.net/poem12618.html","الوافر"],[457,"ما الروض نديان الثرى متعطرا","https://www.aldiwan.net/poem13759.html","الكامل"],[482,"لمن دمن بالرقمتين وأطلال","https://www.aldiwan.net/poem15250.html","الطويل"],[509,"أحببت رب ملاحة لجماله","https://www.aldiwan.net/poem38412.html","الكامل"],[567,"بين ضرب الطلى وطعن الصدور","https://www.aldiwan.net/poem52977.html","الخفيف"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130153","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26403","الوافر"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118436","الطويل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96039","الوافر"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109366","الطويل"],[2406,"","https://poetry.dctabudhabi.ae/diwan/poem/100121","الطويل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122447","البسيط"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109821","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100737","الطويل"],[3238,"","https://poetry.dctabudhabi.ae/diwan/poem/144392","المنسرح"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139973","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110058","البسيط"],[3749,"","https://poetry.dctabudhabi.ae/diwan/poem/33126","الطويل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[5055,"صفوف الظل","https://www.poetsgate.com/ViewPoem.aspx?id=101655",""],[5092,"قبلةٌ ومن أوّل السطر","https://www.poetsgate.com/ViewPoem.aspx?id=163043",""],[5145,"رقدت ودهرك لا يرقد","https://www.poetsgate.com/ViewPoem.aspx?id=108069",""],[5213,"لهوّن بعد اليوم ما يفعل الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=170487",""],[5829,"لو تعلمين","https://www.poetsgate.com/ViewPoem.aspx?id=160313",""]],"verses":[["لَسُرْعانَ ما كانتْ مَناسِفَ للصِّبا","فقدْ ضحِكَتْ زَهْراً وقد خجِلَتْ وَرْدا",0,"د",2,0],["لسريرك بين أسرّته","أعلى التاريخ وأمجده",1,"د",2,0],["لِسَرِيٍّ لِباسُهُ خَشِنُ القُط","نِ وَمَروِيُّ مَروَ لِبسُ القُرودِ",2,"د",1,0],["لَسَرعانَ ما تاقَت إِلَيكِ جَوانِحي","وَما وَلِهَت نَفسي إِلَيكِ تَنَدُّما",3,"م",2,0],["لسرها واختصاص الله قائمها","بالنصر والفتح برهان وبرهان",4,"ن",1,0],["لسراج الأنبيا حامي النزيل","زكريا صاحب العزم الحصور",5,"ر",1,1],["لِسَرارَةٍ حَفَشَ الرَبيقُ غُثاءَها","حَوّاءَ يَزدَرِعُ الغُمَيرَ ثَراها",6,"ا",3,0],["لِسَريرِها خَلجاته وَل","مرشَفيها مرشفاه",7,"ا",2,0],["لَسُرْعانَ مَا قَوَّضْتَ رَحْلَكَ ظاعِناً","وَسِرْتَ عَلى غَيْرِ النَّواجِي الرَّواسِمِ",8,"م",1,0],["لسرٍّ ما دَعاك أَبا ترابٍ","مُحمَّدٌ النَبيُّ المُستطابُ",9,"ب",1,0],["لسر قوم لحمله صلحوا","كم من خبر نصيبه الخبر",10,"ر",1,0],["لسرت على جفوني","لدى مغناك من عمري البقية",11,"ه",1,0],["لسِرْتُ إذَنْ على بَصَري إليكمْ","وما ألِمَ المَسيرَ ولا تَعايا",12,"ا",3,0],["لسرّتْنِي الأمانِي أو لسرّتْ","جَوَى قلبي لبُعدك واُلْتِيَاعي",13,"ع",2,0],["لسريَ في صدوركُمُ مكانٌ","خلافَ مكانِ سرِّكُمُ بصَدْري",14,"ر",2,1],["لسَراة عصر من خَيار بني العُلا","تأبى مآثر فضلهم أن تُحصَرا",15,"ر",2,0],["لِسرِّي ونارِ الشوقِ ما هبتِ الصَّبا","على الدهرِ اِشعالُ يزيدُ واِشغالُ",16,"ل",1,0],["لسرور آيات المحبه وجهه","عيدٌ وحاجبه مثال هلاله",17,"ل",2,0],["لِسَريرِ العُلَى رِجالٌ وإلا","ضاقَ بالجالِسِينَ مَتْنُ السريرِ",18,"ر",1,0],["لسرنا ولو أن الأسود كوامن","لها بيننا في الطرق من درق سد",19,"د",1,0],["لَسَرَّكِ أَن يَكونَ اللَيلُ شَهراً","وَأَلهاكِ السُهادُ عَنِ المَنامِ",20,"م",1,0],["لسرعتها لا تدرك العين كنهها","وعنها لايدي اللامسين تجنب",21,"ب",1,0],["لسرت لو رأته كيف ينحو","مضيق الكرب بالقلب الرحيب",22,"ب",1,0],["لسر علاه في سما الكون مظهرٌ","به السائرات السبع صارت ثمانيا",23,"ي",2,0],["لسرعان ما مرت أويقات قربهم","وهل لسرور في الزمان دوام",24,"م",1,0],["لَسِرتُ لِلخَالِ لاَ أَلوِي عَلَى أَرَمٍ","سَعياً عَلَى الجَوِّ لاَ سَعياً عَلَى التُّربِ",25,"ب",1,0],["لسرى خيالك لو اصاب رقادا","ولدام حبك لو ادام فؤادا",26,"د",2,1],["لسرعان ما حنت جوانح مغرم","يساوره جيش الهوى ويغاوره",27,"ر",2,0],["لسرت والليل هودجي وذباب ال","سيف في نحره إلى بابه",28,"ه",1,0],["لسرَّ الثريا أنها قدمُ ولمْ","يسر الثريا أنها أبداً قرط",29,"ط",1,0],["لسر لُغزيَ طِرسٌ باءَ مبدأُهُ","وسارَ بالقلبِ فاصفِ القلبَ تفتهمِ",30,"م",1,0],["لِسُرعَةِ فَتحِ القُدسِ سِرٌّ مَغيبُ","وَفي صَرعَةِ الإِفرِنجِ مُعتَبِرٌ بَدا",31,"د",2,0],["لِسِرّي في بَحرِ الصبابَةِ يونُسُ","تَلَقَّمَهُ حوتُ الهَوى وَهو خاشِعُ",32,"ع",1,0],["لَسْرج عتيق مسّنَفٍ أصقعٍ صرْب","جواد أقنَف لو سَعفْ لي طماعة",33,"ع",2,0],["لَسِرُّكَ يا بْنَ حرفيَ في فؤادي","فصمتكَ مثل بوحكَ , كاتمانِ",34,"ن",1,0],["لسرعان ما زاره مسعداً","أأوحشه أنه مفرد",35,"د",1,0],["لسرعان ما قد قصتها يد الردى","فخيبت الآمال وانقلب الفكر",36,"ر",1,0],["لسرعان ما قد فللته يد القضا","فلا مانع عنها به يدفع الضر",36,"ر",1,0],["لسرت بك الاحلام كل هنيهة","ولذاق منك القلب ما لا يتقى",37,"ق",2,0]]}