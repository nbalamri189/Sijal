5452",""],[5988,"يا بعيداً مزارهُ","https://www.poetsgate.com/ViewPoem.aspx?id=99711",""],[6031,"لَعِبتْ بعطفيهِ الشمولُ فَمَادَا","https://www.poetsgate.com/ViewPoem.aspx?id=46254",""],[6068,"نازلتها بالحب حتى هزمتها -08-","https://www.poetsgate.com/ViewPoem.aspx?id=175883",""],[6142,"ما نشا في السما ولا ساح في الأر","https://www.poetsgate.com/ViewPoem.aspx?id=155697",""],[6152,"حورية الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=203287",""],[6167,"فرار الضياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85536&r=&rc=19",""],[6259,"لو جادهنَّ غداة رمنَ رواحا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59361&r=&rc=9",""]],"verses":[["نازَعتُهُ ثَديَ الرَضاعِ","وَما يَلَذُّ لَنا الشَرابُ",0,"ب",1,0],["نَازِحٌ زَارَ مِنْ تَبَالَةَ نَجْداً","أَيْنَ مَا بَيْنَهُ وَبَيْنَ تَبَالَهْ",1,"ل",2,0],["نازَعتُهُم قُضُبَ الرَيحانِ مُتَّكِئاً","وَقَهوَةً مُزَّةٌ راوُوقُها خَضِلُ",2,"ل",1,0],["نازَعتُ أَولاها الكَتي","بَةِ معجِماً طِرفاً طِمِرّا",3,"ر",2,0],["نازَعتُهُ كَأسَ الصَبوحِ وَلَم","أَجهَل مُجِدَّةَ عِذرَةِ الرَجُلِ",4,"ل",1,0],["نازَلتَ أَبطالاً لَها ذادَةً","حَتّى ثَنَوا عَن حُرُماتِ الذِمار",5,"ر",1,0],["نازعوا النحل في جناها فحَالَتْ","حاصبات القَليس دون القليس",6,"س",1,0],["نازَعتُهُ طَيِّبَ الراحِ الشَمولِ وَقَد","صاحَ الدَجاجُ وَحانَت وَقعَةُ الساري",7,"ر",2,0],["نازِحَ الدارِ أَقصَرَ اليَومَ بَينٌ","وَاِنتَهَت مِحنَةٌ وَكَفَّت عَوادي",8,"د",2,0],["نازِلاتٌ في سَيرِها صاعِداتٌ","كَالهَوادي يَهُزُّهُنَّ الحُداءُ",9,"ا",2,0],["نازَعتُهُ قُلَصَ الرِكابِ وَرَكبُها","خَوفَ الهَلاكِ حُداهُمُ التَسبيحُ",10,"ح",1,0],["نازِلاً في بَني المُهَلَّبِ وَالفِت","نَةُ تَسطو عَلى سَوامِ المُسيمِ",11,"م",1,0],["نازِحُ الدارِ قَريبُ ال","ذِكرِ في كُلِّ مَكانِ",12,"ن",1,0],["نازَلتَ فيهِ مُفَنَّداً في دينِهِ","لا بَأسِهِ فَرَآكَ غَيرَ مُفَنَّدِ",13,"د",1,0],["نَازَعَتْكَ الْيَهُودُ وَاخْتَلَفَتْ فِي","كَ النَّصَارَى فَأَنْتَ لا شَكَّ بَغْلُ",14,"ل",1,0],["نازِحِ الدارِ عَن دِيا","رِكِ وَالقَلبُ شائِقي",15,"ق",2,0],["نازِحُ الوَصلِ لَيسَ يَرحَمُ آما","لِيَ مِن طولِ هَجرِهِ وَاِعتِلالِه",16,"ل",2,0],["نازَعْتُمُ حَقّ الوصيّ ودونَهُ","حَرَمٌ وحِجْرٌ مانِعٌ وحَجون",17,"ن",1,0],["نازلٌ كُرْسيَّ أرضٍ هابَهُ","مَلِكُ الخابلِ فيها إذْ مَرُد",18,"د",1,0],["نازَلتُ عُصمَ الوَحشِ عَنّا مِن كَثَب","مِن كُلِّ أَحوى اللَونِ مُبيَضِّ الذَنَب",19,"ب",1,0],["نازَعتُهُ صَهباءَ كَرخِيَّةً","قَد حُلِبَت مِن كَرمِ حَرّاثِ",20,"ث",1,0],["نازَعتُهُ الكَأسَ ما أُفَتِّرُهُ","كَأسَ مِدامٍ تَرى لَها شَرَرا",21,"ر",2,0],["نازَعتُها فِتيَةً غُرّاً غَطارِفَةً","لَيسوا إِذا اِمتُحِنوا يَوماً بِأَنكاسِ",22,"س",1,0],["نازَعتُهُ القَهوَةَ في فِتيَةٍ","كُلُّهُمُ زَينٌ لِجُلّاسِهِ",23,"س",2,0],["نازَعتُهُم قَهوَةً صَفراءَ صافِيَةً","بِشادِنٍ خَنِثٍ كَالغُصنِ مَيّاسِ",24,"س",1,0],["نازَعتُها واضِحَ الخَدَّينِ مُعتَدِلاً","يَحكي بِبَهجَتِهِ لِلناسِ بَلقيسا",25,"س",2,0],["نازَعتُها الكَأسَ فيهِ فُضلَتُها","فَفُزتُ بِالكَأسِ بَعدَ إِمراسِ",26,"س",1,0],["نازَعَها سادَةٌ غَطارِفَةٌ","كَأَنَّهُم مِن شَقيقَةٍ شُقِقوا",27,"ق",3,0],["نازَعتُهُ في الزُجاجِ مِثلَ دَمِ ال","شادِنِ تَنفي طَوارِقَ الحَزَنِ",28,"ن",1,0],["نازِلاتٍ مِنَ السَراةِ فَكَرخا","يا إِلى الشَطِّ ذي القُصورِ الدَواني",29,"ن",2,0],["نازعتهُ مشمولةً","كالبرقِ في خطفتهِ",30,"ت",2,0],["نازعتهُ الكأسَ في رفق أحدّثهُ","وفي زيّ قاض ونشج الشيخ إبليس",31,"س",1,0],["نازعتُهُ من قهوةٍ مشمولةٍ","ما افتضّها بالماءِ غير نزار",32,"ر",1,0],["نازَعتُهُ الرَيحانَ في نَفَسِ الضُحى","وَسَماعَ عامِلَةِ اليَدَينِ رَداحِ",33,"ح",1,0],["نَازَعْتَ أَلْبَابَهَا لُبِّي بِمُخْتَزَنٍ","مِنَ الأَحَادِيثِ حَتَّى ازْدَدْنَ لي لِينَا",34,"ن",2,0],["نازعَتْها غرامهُ","وهُو الخصمُ والحكَمْ",35,"م",1,0],["نَازَعْتُهُمْ طَرَفَ الْحَدِيثِ وَقَدْ","جَرَتِ الْكُؤُوسُ بِنَا فَمَا اخْتَلَفُوا",36,"ف",3,0],["نَازِحاً مُلْهَبَ الْفُؤَادِ اسْتَكَنَّتْ","بَيْنَ جَنْبَيْهِ عِلَّةُ المَفؤُودِ",37,"د",1,0],["نازل أقرانَ بني الثَّواكل","ومن عظيم الفِتنِ الهوائل",38,"ل",1,0],["نازعاً للصغير من عضد ال","أم وللأم من بنان الصغير",39,"ر",1,0],["نازعت فيّ المجد عن خطاء ولم","تسلك طريق السادة الامجاد",40,"د",1,0],["نازعتني الملك واستولت عليك يدي","ورائد الموت قبل البيض والأسل",41,"ل",1,0],["نازَعتُها أَروعَ لا تَسطو عَلى","نَديمِهِ شِرَّتهُ إِذا اِنتَشى",42,"ا",1,0],["نازعَتْني ذِكْرياتٌ قدْ رَمَتْ","ني سَوادا في أتونِ الحِمَمِ",43,"م",1,0],["نازلَتْ صَبريَ الخطوبُ فَوَلّت","عاثِراتٍ بِاليَأسِ بَعد مُناها",44,"ا",3,0],["نازوك قد مل من عقوبته","فيما مضى من قديم أزمانه",45,"ن",2,0],["نازعتُها فزوَت مواهبها","عنّي فلم أصبر على الفزع",46,"ع",1,0],["نازعتُ إخواني بعذر عاقني","دوني من العَذب الزلالِ رحيقا",47,"ق",2,0],["نازح عندي ابقى مذ نأى","مدمعا من بعده ما نزحا",48,"ح",2,0],["نازِلٌ مِن نَهرِ عيسى","بَينَ دولابٍ وَراطِ",49,"ط",1,0],["نازعْتَه الشَّبْهَ في خَلْقٍ وفي خُلُقٍ","حتّى لَما زِدْتَنا لو كنتَ إيّاه",50,"ا",2,0],["نازِلٌ منه عند مَولىً كريمٍ","عن مَعاني عَبيدِه فَحّاص",51,"ص",1,0],["نازِلاً وسْطَهم وإن كنتُ منهم","عند قَصْدِ التّقريبِ والإدناء",52,"ا",2,0],["نازلتُ كَبشَهُمُ ولم","أرَ من نِزالِ الكبش بُدَّا",53,"د",2,0],["نازعتها الخير وهي يَجذبني","إلى حضيض البوارِ كاهلُها",54,"ل",3,0],["نازَعتُهُ فيكَ القَوافي فانتَشى","فَكَأَنَّما نازَعته الأَقداحا",55,"ح",2,0],["نازَعتِ عِندَ الرَميِ مُقلَةَ جُؤذُرٍ","تُصمي القُلوبَ وَما تُغِبُّ نِزالا",56,"ل",2,0],["نازَلْتُهُ بِسَنَا أَبي الْحَسَنِ الَّذِي","مَلأَ المَلاَ فَتَرَكْتُهُ مَقْهُورا",57,"ر",2,0],["نازَعْتَنِي في الذي عَلِمْتَ به","فَاترُكْ حديثَ النساءِ يا رَجُلُ",58,"ل",1,0],["نازعتم الحق وهم","بالحق للدين والايمان قد طبعوا",59,"ع",3,0],["نازعتنا أعطافه نشوة الرا","ح وخدّاه عندمِي جريالِهْ",60,"ل",2,0],["نازِحٌ عن كُلِّ عارٍ موبِقٍ","سالمٌ من كُلِّ كِبْرٍ وبَخَلْ",61,"ل",1,0],["نازلْتُ همِّي وهو فارسُ بُهْمةٍ","فَهَزَمْتُهُ بتَتامِشِ بن قَماجِ",62,"ج",1,1],["نازِحٌ عن موْطِنِ العارِ لهُ","مَوْطنُ العَلْياءِ والمَجْدِ أمَمْ",63,"م",1,0],["نازلتها بالأبلجين جبيتهِ","وسلافِ كأس يمينه المتشعشع",64,"ع",1,0],["نازحٌ لولا تجنّيهِ دنا","هاجرٌ لولا تعدّيهِ وصل",65,"ل",1,0],["نازَعتُها عَنَمَ الصَبا إِنَّ الصَبا","قَد كانَ مِنّي لِلكَواعِبِ عيدا",66,"د",2,0],["نازَعتُها النَجمَ الَّذي زارَني","وَالجَوُّ لَم يَبقَ لَهُ نَجمُ",67,"م",1,0],["نازعتم آل رزيك على شرف","لو لم 