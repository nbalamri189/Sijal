tml","الخفيف"],[45,"حاجة ذا الحيران أن ترشده","https://www.aldiwan.net/poem63481.html","البسيط"],[45,"محل على القاطول أخلق داثره","https://www.aldiwan.net/poem63630.html","الطويل"],[45,"أراني متى أبغ الصبابة أقدر","https://www.aldiwan.net/poem63635.html","الطويل"],[45,"تبيت له من شوقه ونزاعه","https://www.aldiwan.net/poem64716.html","الطويل"],[28,"رعت ناقتي من أم أعين رعية","https://www.aldiwan.net/poem5118.html","البسيط"],[28,"ما إن أبو بشر ولا أبواهما","https://www.aldiwan.net/poem5442.html","الكامل"],[61,"غضبان ينساني وأذكره","https://www.aldiwan.net/poem51669.html","أحذ الكامل"],[61,"أناشد دهري أن يعود كما بدا","https://www.aldiwan.net/poem51709.html","الطويل"],[66,"شكوت إليك الجوى","https://www.aldiwan.net/poem39645.html","مجزوء المتقارب"],[80,"ولابس نقب الأعراض جوهره","https://www.aldiwan.net/poem31556.html","البسيط"],[44,"نفس يحتثه نفس","https://www.aldiwan.net/poem30230.html","المديد"],[44,"قرب الحيا وانهل ذاك البارق","https://www.aldiwan.net/poem30393.html","الكامل"],[44,"السيف أصدق أنباء من الكتب","https://www.aldiwan.net/poem30591.html","البسيط"],[69,"ومغن إن شداكم منشدا","https://www.aldiwan.net/poem28103.html","الرمل"],[74,"ومغرد هزج الغناء مطرب","https://www.aldiwan.net/poem12932.html","الكامل"],[74,"ومغار ركبت أدهم معطا","https://www.aldiwan.net/poem13212.html","المديد"],[33,"أحجاج بيت الله في أي هودج","https://www.aldiwan.net/poem25989.html","الطويل"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[40,"يقول خليلي والمطي خواضع","https://www.aldiwan.net/poem42310.html","الطويل"],[17,"إن امرأً أمن الحوادث جاهل","https://www.aldiwan.net/poem1197.html",""],[52,"أي رسم لآل هند ودار","https://www.aldiwan.net/poem27050.html","الخفيف"],[52,"عندنا سيدي نديم وريحا","https://www.aldiwan.net/poem27230.html","الخفيف"],[48,"دع لباكيها الديارا","https://www.aldiwan.net/poem63264.html","مجزوء الرمل"],[7,"أتاركة تدللها قطام","https://www.aldiwan.net/poem1967.html","الوافر"],[46,"لا بد للروح أن تنأى عن الجسد","https://www.aldiwan.net/poem22455.html","البسيط"],[46,"تخيل من بني الدنيا غدا عجبا","https://www.aldiwan.net/poem22548.html","البسيط"],[46,"بالغار من هضبي عماية نازل","https://www.aldiwan.net/poem22710.html","الكامل"],[46,"إذا مدحوا آدميا مدح","https://www.aldiwan.net/poem23438.html","المتقارب"],[76,"ومغبر السماء إذا تجلى","https://www.aldiwan.net/poem38875.html","الوافر"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140952",""],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42541","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54656","الخفيف"],[106,"الوحدة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=179293",""],[90,"ليلة معها","https://www.poetsgate.com/ViewPoem.aspx?id=179141",""],[45,"تَبيتُ لَهُ، مِنْ شَوْقِهِ وَنِزَاعِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=32194",""],[45,"مَحَلٌّ على القَاطُولِ أخْلَقَ داثِرُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31192",""],[99,"يابيتها في اخر الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=24743",""],[51,"للناس فيما يكْلَفُونَ مغارمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=30502",""]],"verses":[["وَمَغاويرِ الحَفيظا","تِ وَفُرسانِ الحَقيقَه",0,"ق",2,0],["وَمُغيثُ الأَنامِ وَاِبنَ مُغيثِ ال","خَلقِ طَودٌ رَسا وَطَودٌ تَعَفّى",1,"ف",2,0],["وَمَغانٍ أَنبَتَ الحُسنُ بِها","هَيَفاً تَرعاهُ عَيني وَغَيَد",2,"د",1,0],["وَمُغَطّي الذَنبِ بِالعَف","وِ وَكَشّافَ الكُروبِ",3,"ب",1,0],["وَمُغيرَةٍ شَعواءَ ذاتِ أَشِلَّةٍ","فيها الفَوارِسُ حاسِرٌ وَمُقَنَّعُ",4,"ع",1,0],["وَمُغَنٍّ كُلَّما قيلَ لَهُ","أَسمَعِ الشَربَ فَغَنّى فَصَدَح",5,"ح",1,0],["وَمَغنىً إِزاءَ الجَعفَرِيَّةِ أَقبَلا","لَنِعمَ مَرادُ النَفسِ رَوضاً وَجَدوَلا",6,"ل",2,0],["وَمُغَالِبِي حُبَّ الحَيَاةِ لِتَدْرُكُوا","ذَاكَ المُرَامِ وَهَلْ سمَاهُ مُرَامُ",7,"م",1,0],["وَمُغَنٍّ إِن تَغَنّى","أَورَثَ النَدمانَ هَمّا",8,"م",2,1],["وَمُغبَرَّةِ الأَفيافِ مَسحولَةِ الحَصى","دَياميمُها مَبنوقَةٌ بِالصَفاصِفِ",9,"ف",1,0],["وَمَغفى فَتىً حَلَّت لَهُ فَوقَ رَحلِهِ","ثَمانِيَةً جُرداً صَلاةُ المُسافِرِ",10,"ر",1,0],["وَمَغَايِيرَ عِندَهُنَّ مَغَاوِي","رَ مَسَاعِيرَ لَيلَة الإِلجَامِ",11,"م",1,0],["وَمُغضٍ لِلمَهابَةِ عَن جَوابي","وَإِنَّ لِسانَهُ العَضبُ الصَقيلُ",12,"ل",1,1],["ومغترب عن قومه ودياره","أساعده والله يعطي ويمنع",13,"ع",1,0],["ومُغنٍّ بِبَرْده ونَداهُ","تَخمدُ النارُ حين يَفتح فاهُ",14,"ا",2,1],["ومغارمُ الشعراءِ في أشعارهم","إنفاقُ أعمارٍ وهجرُ منام",15,"م",1,0],["ومغفَّل عن كل عثرةِ عاثرٍ","دأبَ الغبيِّ وإنَّه لعليم",16,"م",1,0],["وَمُغَنَ زيرُه أَط","رَبُ مَسموعٍ وَبَمُّه",17,"م",2,0],["وَمُغَنٍّ هُوَ فيما","يَحسَبُ الناسُ أَميرُ",18,"ر",1,0],["وَمُغتَصَبٍ مِن رَهطِ ضِبعانَ يَشتَكي","إِلى القَومِ أَعضادَ المَطِيِّ الرَواسِمِ",19,"م",1,0],["ومغنّ وعازف","وهَزار وبلبل",20,"ل",1,0],["وَمَغانٍ عَلى اللَيالي وِضاءٌ","لَم تَجِد لِلعَشِيِّ تَكرارَ مَسِّ",21,"س",1,0],["وَمُغضٍ كانَ لا يُغدي لِخِطبٍ","وَبالٍ كانَ يُفكِرُ في الهُزالِ",22,"ل",1,0],["وَمُغيرٌ عَلى الأَصابِعِ بِاللَم","سِ لَها في أَسافِلِ الأَقداحِ",23,"ح",1,0],["وَمَغاضُ المَشيبِ يَغدو فَيَستَخ","لِقُ مِن عَيشِنا الَّذي نَستَجِدُّهُ",24,"د",2,0],["وَمُغرَمٌ بِالمَنعِ أُغرِمتُ بِال","إِعراضِ عَن أَبوابِهِ الموصَدَه",25,"د",2,0],["وَمُغتَصِبٌ لِلقَتلِ لَم يُخشَ رَهطُهُ","وَلَم يُحتَشَم أَسبابُهُ وَأَواصِرُه",26,"ر",2,0],["وَمُغتالُ طولِ اللَيلِ حَتّى يُقيمُنا","عَلى ساطِعٍ مِن طُرَّةِ الفَجرِ أَحمَرِ",27,"ر",1,0],["وَمُغتَرِبِ المَثوى وَسَرحِيَ سارِبٌ","بِأَودِيَةِ الساجورِ أَو بِتِلاعِهِ",28,"ع",2,0],["وَمَغبوقَةٍ دونَ العِيالِ كَأَنَّها","جَرادٌ إِذا أَجلى مَعَ الفَزَعِ الفَجرُ",29,"ر",1,0],["وَمُغَلِّثينَ مِنَ النُعاسِ كَأَنَّما","شَرِبوا عَتيقَ سِنينَ فَوقَ الأَرحُلِ",30,"ل",1,0],["ومَغيمُ يومِ السُّخطِ مُظلِمُه","ومُضئُ ليلِ البِشْرِ مُقْمِرُه",31,"ر",2,0],["ومغموسةٌ في الشَّرْيِ والأَرْيِ هذه","ليَرْدَى بها باغٍ وتلكَ لتُرتدَى",32,"د",2,0],["وَمُغرِقَتي بِالدُموع","وَقَد أَحرَقَت أَضلُعي",33,"ي",1,0],["ومغربٍ طعنته غيرَ نابيةٍ","أسنَّةٌ هي إن حققتها شهبُ",34,"ب",1,0],["وَمَغانٍ لِلكَرى دُثُرٌ","عُطُلٌ مِن عَهدِهِ دُرُسُ",35,"س",1,0],["وَمَغارِبُ الإِخفاقِ أَضحَت بِالَّذي","أَولى مِنَ الإِنجاحِ وَهيَ مَشارِقُ",36,"ق",1,0],["وَمُغضَبٍ رَجَعَت بيضُ السُيوفِ بِهِ","حَيَّ الرِضا مِن رَداهُم مَيِّتَ الغَضَبِ",37,"ب",1,0],["ومغنٍّ إنْ شداكُم منشدا","أعذبَ الغيَّ وأغوى العذبا",38,"ب",2,1],["وَمُغَرِّدٍ هَزِجِ الغِناءِ مُطَرِّبٍ","يُلقى بِهِ لَيلُ التَمامِ فَيَقصُرُ",39,"ر",1,1],["وَمَغارٍ رَكِبتُ أَدهَمَ مِعطا","لاً إِلَيهِ وَظَهَرَ أَشهَبَ حالي",40,"ي",1,1],["وَمُغتَرِبٍ بِالمَرجِ يَبكي بِشَجوِهِ","وَقَد غابَ عَنهُ المُسعِدونَ عَلى الحُبِّ",41,"ب",1,0],["ومُغَمِّضٍ أَشِبٍّ مَخو","فِ رَدى الأَعالي وَالأَسافِل",42,"ل",1,0],["وَمَغنى حَبيبٍ أَقصَدَ القَلبَ ذِكرُهُ","فَفي القَلبِ مِنهُ قُرحَةٌ لَم تَلأمِ",43,"م",1,0],["وَمُغيرَةٍ شَعواءَ يُخشى دَرؤُها","يَوماً رَدَدتُ سِلاحَها بِسِلاحي",44,"ح",2,0],["وَمَغانٍ كانَت بِها العَينُ مَلأى","مِن غُصونٍ تَهتَزُّ في أَقمارِ",45,"ر",1,0],["وَمُغَنٍّ يَقولُ ما تَعجِزُ الأَل","فاظُ عَنهُ حُلوُ الحَديثِ أَديبُ",46,"ب",1,0],["وَمُغَنٍّ كُلَّما شِئ","تُ تَغَنّى وَأَشارا",47,"ر",2,0],["وَمَغزاهُ قَبائِلَ غائِظاتٍ","عَلى الذِهيَوطِ في لَجِبٍ لَهامِ",48,"م",1,0],["وَمُغرَمٌ بِالمَخازي طّالِبٌ صَلَةً","مُغَرّى بِتَنفيقِ أَشعارٍ لَهُ كُسُدِ",49,"د",1,0],["وَمُغتَدٍ بِحِبالِ الصَيدِ يَنصِبُها","كَيما يَفيءُ لَهُ مِن ذاكَ مَيسورُ",50,"ر",1,0],["وَمَغارُ هَذا الدَهرُ تَقطَعُ خَيلُهُ","أَسبابُ حَبلٍ لِلحَياةِ مُغارِ",51,"ر",1,0],["وَمَغفِرَةُ اللَهِ مَرجُوَّةٌ","إِذا حُبِسَت أَعظُمي في الرِمَم",52,"م",1,0],["ومُغبرِّ السماءِ إذا تَجلَّى","يغادرُ أرضَه كالأرجوانِ",53,"ن",1,1],["ومغضٍ كان لا يغضي لخطبٍ","وبالٍ كان يفكر في الهزال",54,"ل",1,0],["ومُغَنٍّ إِذَا شَدَا خِلْتَ أَنَّ الْ","أَرْضَ ظَلَّتْ تَدُورُ بِالْفَلَواتِ",55,"ت",1,0],["وَمَغَازِي مَا قَرَّبَتْهُ مِنَ السُّبْ","لِ وَمَا بَعَّدَتْ مِنَ الغَايَاتِ",56,"ت",1,0],["ومَغَانِ حَنَّتْ إلى الأهل أرضًا","وسماءً، واستشرفَت جدرانا",57,"ن",2,0],["ومُغَفَّلٌ من راح يُقنِعُه","منك الحديثُ الحلوُ والسمر",58,"ر",1,0],["وَمُغترِبَ المَثْوَى، وَسرْجيَ سارِبٌ","بأوْدِيَةِ السّاجُورِ، أوْ بِتِلاعِهِ",59,"ع",2,0],["وَمُغْتَصَبٍ للقَتلِ لَمْ يُخْشَ رَهْطُهُ،","وَلمْ تُحتَشَمْ أسْبَابُهُ وَأوَاصِرُهْ",60,"ر",2,0],["ومغالق الشباك مشرعة","بأبى أنا الشباك صيفيا",61,"ي",2,0],["ومغارمُ الشعراءِ في أشعارهم","إنفاقُ أغمارٍ وهجرُ منام",62,"م",1,0]]}