3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29330","الرمل"],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143849","الكامل"],[4023,"","https://poetry.dctabudhabi.ae/diwan/poem/146892","الكامل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101378","الكامل"],[4030,"","https://poetry.dctabudhabi.ae/diwan/poem/20882","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119708","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4164,"","https://poetry.dctabudhabi.ae/diwan/poem/203840","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90741","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90814","الخفيف"],[4268,"","https://poetry.dctabudhabi.ae/diwan/poem/144267","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81722","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81727","الرمل"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121272","الطويل"],[4473,"","https://poetry.dctabudhabi.ae/diwan/poem/130599","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72505","الوافر"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104874","البسيط"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35143","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139519",""],[4679,"مرحباً بالكرام أهل الحمَّية","https://www.poetsgate.com/ViewPoem.aspx?id=142757",""],[4867,"موعد غير منتظر","https://www.poetsgate.com/ViewPoem.aspx?id=25023",""],[4888,"في ظل وطن","https://www.poetsgate.com/ViewPoem.aspx?id=207742",""],[4119,"أوطن القلب من هواكم فريق","https://www.poetsgate.com/ViewPoem.aspx?id=16192",""],[5183,"المصاب المؤلم","https://www.poetsgate.com/ViewPoem.aspx?id=180255",""],[5277,"وقفاتٌ إيمانية","https://www.poetsgate.com/ViewPoem.aspx?id=211297",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5388,"إيه مكة","https://www.poetsgate.com/ViewPoem.aspx?id=206912",""],[5409,"يا من جنت يده عليه شقاءه","https://www.poetsgate.com/ViewPoem.aspx?id=155259",""],[5431,"مفاعل نووي عاطل","https://www.poetsgate.com/ViewPoem.aspx?id=205535",""],[482,"شكايةُ الصبَّ إلى الأربُعِ","https://www.poetsgate.com/ViewPoem.aspx?id=111423",""],[5691,"بيت الغرابيب","https://www.poetsgate.com/ViewPoem.aspx?id=206248",""],[5691,"لسان حال الرئيس","https://www.poetsgate.com/ViewPoem.aspx?id=207076",""],[1513,"أَتَصبِرُ يا قَلبُ أَم تَجزَع","https://www.poetsgate.com/ViewPoem.aspx?id=92498",""],[5725,"على اي جمر","https://www.poetsgate.com/ViewPoem.aspx?id=210930",""],[6068,"لو تسألوني عن هوى كبدي -12-","https://www.poetsgate.com/ViewPoem.aspx?id=175855",""],[6069,"ومغرمٍ بالبدال قلت له","https://www.poetsgate.com/ViewPoem.aspx?id=105703",""],[6074,"صرت من حبس دنا مطلقا","https://www.poetsgate.com/ViewPoem.aspx?id=200375",""],[463,"بين النقا فثنية ِ الحجرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60058&r=&rc=114",""],[463,"رعتْ منْ تبالة َ جعداً خفيفاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60146&r=&rc=202",""],[3984,"المطر والفولاذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64425&r=&rc=31",""],[572,"ما تَرَى في الصبوحِ أيّدَكَ اللّه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9212&r=&rc=69",""]],"verses":[["وَمَغاويرِ الحَفيظا","تِ وَفُرسانِ الحَقيقَه",0,"ق",2,0],["وَمُغيثُ الأَنامِ وَاِبنَ مُغيثِ ال","خَلقِ طَودٌ رَسا وَطَودٌ تَعَفّى",1,"ف",2,0],["وَمَغانٍ أَنبَتَ الحُسنُ بِها","هَيَفاً تَرعاهُ عَيني وَغَيَد",2,"د",1,0],["وَمُغَطّي الذَنبِ بِالعَف","وِ وَكَشّافَ الكُروبِ",3,"ب",1,0],["وَمُغيرَةٍ شَعواءَ ذاتِ أَشِلَّةٍ","فيها الفَوارِسُ حاسِرٌ وَمُقَنَّعُ",4,"ع",1,0],["وَمُغَنٍّ كُلَّما قيلَ لَهُ","أَسمَعِ الشَربَ فَغَنّى فَصَدَح",5,"ح",1,0],["وَمَغنىً إِزاءَ الجَعفَرِيَّةِ أَقبَلا","لَنِعمَ مَرادُ النَفسِ رَوضاً وَجَدوَلا",6,"ل",2,0],["وَمُغَالِبِي حُبَّ الحَيَاةِ لِتَدْرُكُوا","ذَاكَ المُرَامِ وَهَلْ سمَاهُ مُرَامُ",7,"م",1,0],["وَمُغَنٍّ إِن تَغَنّى","أَورَثَ النَدمانَ هَمّا",8,"م",2,1],["وَمُغبَرَّةِ الأَفيافِ مَسحولَةِ الحَصى","دَياميمُها مَبنوقَةٌ بِالصَفاصِفِ",9,"ف",1,0],["وَمَغفى فَتىً حَلَّت لَهُ فَوقَ رَحلِهِ","ثَمانِيَةً جُرداً صَلاةُ المُسافِرِ",10,"ر",1,0],["وَمَغَايِيرَ عِندَهُنَّ مَغَاوِي","رَ مَسَاعِيرَ لَيلَة الإِلجَامِ",11,"م",1,0],["وَمُغضٍ لِلمَهابَةِ عَن جَوابي","وَإِنَّ لِسانَهُ العَضبُ الصَقيلُ",12,"ل",1,1],["ومغترب عن قومه ودياره","أساعده والله يعطي ويمنع",13,"ع",1,0],["ومُغنٍّ بِبَرْده ونَداهُ","تَخمدُ النارُ حين يَفتح فاهُ",14,"ا",2,1],["ومغارمُ الشعراءِ في أشعارهم","إنفاقُ أعمارٍ وهجرُ منام",15,"م",1,0],["ومغفَّل عن كل عثرةِ عاثرٍ","دأبَ الغبيِّ وإنَّه لعليم",16,"م",1,0],["وَمُغَنَ زيرُه أَط","رَبُ مَسموعٍ وَبَمُّه",17,"م",2,0],["وَمُغَنٍّ هُوَ فيما","يَحسَبُ الناسُ أَميرُ",18,"ر",1,0],["وَمُغتَصَبٍ مِن رَهطِ ضِبعانَ يَشتَكي","إِلى القَومِ أَعضادَ المَطِيِّ الرَواسِمِ",19,"م",1,0],["ومغنّ وعازف","وهَزار وبلبل",20,"ل",1,0],["وَمَغانٍ عَلى اللَيالي وِضاءٌ","لَم تَجِد لِلعَشِيِّ تَكرارَ مَسِّ",21,"س",1,0],["وَمُغضٍ كانَ لا يُغدي لِخِطبٍ","وَبالٍ كانَ يُفكِرُ في الهُزالِ",22,"ل",1,0],["وَمُغيرٌ عَلى الأَصابِعِ بِاللَم","سِ لَها في أَسافِلِ الأَقداحِ",23,"ح",1,0],["وَمَغاضُ المَشيبِ يَغدو فَيَستَخ","لِقُ مِن عَيشِنا الَّذي نَستَجِدُّهُ",24,"د",2,0],["وَمُغرَمٌ بِالمَنعِ أُغرِمتُ بِال","إِعراضِ عَن أَبوابِهِ الموصَدَه",25,"د",2,0],["وَمُغتَصِبٌ لِلقَتلِ لَم يُخشَ رَهطُهُ","وَلَم يُحتَشَم أَسبابُهُ وَأَواصِرُه",26,"ر",2,0],["وَمُغتالُ طولِ اللَيلِ حَتّى يُقيمُنا","عَلى ساطِعٍ مِن طُرَّةِ الفَجرِ أَحمَرِ",27,"ر",1,0],["وَمُغتَرِبِ المَثوى وَسَرحِيَ سارِبٌ","بِأَودِيَةِ الساجورِ أَو بِتِلاعِهِ",28,"ع",2,0],["وَمَغبوقَةٍ دونَ العِيالِ كَأَنَّها","جَرادٌ إِذا أَجلى مَعَ الفَزَعِ الفَجرُ",29,"ر",1,0],["وَمُغَلِّثينَ مِنَ النُعاسِ كَأَنَّما","شَرِبوا عَتيقَ سِنينَ فَوقَ الأَرحُلِ",30,"ل",1,0],["ومَغيمُ يومِ السُّخطِ مُظلِمُه","ومُضئُ ليلِ البِشْرِ مُقْمِرُه",31,"ر",2,0],["ومغموسةٌ في الشَّرْيِ والأَرْيِ هذه","ليَرْدَى بها باغٍ وتلكَ لتُرتدَى",32,"د",2,0],["وَمُغرِقَتي بِالدُموع","وَقَد أَحرَقَت أَضلُعي",33,"ي",1,0],["ومغربٍ طعنته غيرَ نابيةٍ","أسنَّةٌ هي إن حققتها شهبُ",34,"ب",1,0],["وَمَغانٍ لِلكَرى دُثُرٌ","عُطُلٌ مِن عَهدِهِ دُرُسُ",35,"س",1,0],["وَمَغارِبُ الإِخفاقِ أَضحَت بِالَّذي","أَولى مِنَ الإِنجاحِ وَهيَ مَشارِقُ",36,"ق",1,0],["وَمُغضَبٍ رَجَعَت بيضُ السُيوفِ بِهِ","حَيَّ الرِضا مِن رَداهُم مَيِّتَ الغَضَبِ",37,"ب",1,0],["ومغنٍّ إنْ شداكُم منشدا","أعذبَ الغيَّ وأغوى العذبا",38,"ب",2,1],["وَمُغَرِّدٍ هَزِجِ الغِناءِ مُطَرِّبٍ","يُلقى بِهِ لَيلُ التَمامِ فَيَقصُرُ",39,"ر",1,1],["وَمَغارٍ رَكِبتُ أَدهَمَ مِعطا","لاً إِلَيهِ وَظَهَرَ أَشهَبَ حالي",40,"ل",2,1],["وَمُغتَرِبٍ بِالمَرجِ يَبكي بِشَجوِهِ","وَقَد غابَ عَنهُ المُسعِدونَ عَلى الحُبِّ",41,"ب",1,0],["ومُغَمِّضٍ أَشِبٍّ مَخو","فِ رَدى الأَعالي وَالأَسافِل",42,"ل",1,0],["وَمَغنى حَبيبٍ أَقصَدَ القَلبَ ذِكرُهُ","فَفي القَلبِ مِنهُ قُرحَةٌ لَم تَلأمِ",43,"م",1,0],["وَمُغيرَةٍ شَعواءَ يُخشى دَرؤُها","يَوماً رَدَدتُ سِلاحَها بِسِلاحي",44,"ح",2,0],["وَمَغانٍ كانَت بِها العَينُ مَلأى","مِن غُصونٍ تَهتَزُّ في أَقمارِ",45,"ر",1,0],["وَمُغَنٍّ يَقولُ ما تَعجِزُ الأَل","فاظُ عَنهُ حُلوُ الحَديثِ أَديبُ",46,"ب",1,0],["وَمُغَنٍّ كُلَّما شِئ","تُ تَغَنّى وَأَشارا",47,"ر",2,0],["وَمَغزاهُ قَبائِلَ غائِظاتٍ","عَلى الذِهيَوطِ في لَجِبٍ لَهامِ",48,"م",1,0],["وَمُغرَمٌ بِالمَخازي طّالِبٌ صَلَةً","مُغَرّى بِتَنفيقِ أَشعارٍ لَهُ كُسُدِ",49,"د",1,0],["وَمُغتَدٍ بِحِبالِ الصَيدِ يَنصِبُها","كَيما يَفيءُ لَهُ مِن ذاكَ مَيسورُ",50,"ر",1,0],["وَمَغارُ هَذا الدَهرُ تَقطَعُ خَيلُهُ","أَسبابُ حَبلٍ لِلحَياةِ مُغارِ",51,"ر",1,0],["وَمَغفِرَةُ اللَهِ مَرجُوَّةٌ","إِذا حُبِسَت أَعظُمي في الرِمَم",52,"م",1,0],["ومُغبرِّ السماءِ إذا تَجلَّى","يغادرُ أرضَه كالأرجوانِ",53,"ن",1,1],["ومغضٍ كان لا يغضي لخطبٍ","وبالٍ كان يفكر في الهزال",54,"ل",1,0],["ومُغَنٍّ إِذَا شَدَا خِلْتَ أَنَّ الْ","أَرْضَ ظَلَّتْ تَدُورُ بِالْفَلَواتِ",55,"ت",1,0],["وَمَغَازِي مَا قَرَّبَتْهُ مِنَ السُّبْ","لِ وَمَا بَعَّدَتْ مِنَ الغَايَاتِ",56,"ت",1,0],["ومَغَانِ حَنَّتْ إلى الأهل أرضًا","وسماءً، واستشرفَت جدرانا",57,"ن",2,0],["ومُغَفَّلٌ من راح يُقنِعُه","منك الحديثُ الحلوُ والسمر",58,"ر",1,0],["وَمُغترِبَ المَثْوَى، وَسرْجيَ سارِبٌ","بأوْدِيَةِ السّاجُورِ، أوْ بِتِلاعِهِ",59,"ع",2,0],["وَمُغْتَصَبٍ للقَتلِ لَمْ يُخْشَ رَهْطُهُ،","وَلمْ تُحتَشَمْ أسْبَابُهُ وَأوَاصِرُهْ",60,"ر",2,0],["ومغالق الشباك مشرعة","بأبى أنا الشباك صيفيا",61,"ي",2,0],["ومغارمُ الشعراءِ في أشعارهم","إنفاقُ أغمارٍ وهجرُ منام",62,"م",1,0],["ومغيب بحطامه","ومذهب بالفقر حاضر",63,"ر",1,0],["ومغشم بُهْمةٌ شهمٌ وقد حذقا","حَزْوراً علم ما الأقحاح قد حذقوا",64,"ق",3,0],["ومَغَنَاطِيسَ طِيَّاتٍ تَنَاءَت","ومِدرَهَ حَادِثٍ جَلَلٍ عَظِيمِ",65,"م",1,0],["وَمَغَاني التَّامِ تَيَّمنَ قَلبي","وحَمَينَ الجُفُونَ زَورَ الهُجُوعِ",66,"ع",1,0],["وَمَغرورٌ رَأى الإِقدامَ يُردي","فَعاوَدَ يَستَميلُ وَيَستَقيلُ",67,"ل",1,0],["ومغفرة الرحمن فيها معدَّة","لمن بات يدعو ذا الجلال ويسأل",68,"ل",1,0],["ومغارم أكلت على ملاكه","ثمراته وأتت على الموجود",69,"د",1,0],["ومغن شيخ أشيب","وجده من يذكر",70,"ر",1,0],["ومغتصب قلبي بألحاظ طرفه","سمحت له بالقلب فاسترجح العقلا",71,"ل",2,1],["ومغاضب متذكر","حيا وتحت ضريحه",72,"ح",2,0],["ومغني القوم يشدو","ويحيينا ببشر",73,"ر",1,0],["ومغن سمعته في الفنغرا","ف تصورت ما له من صفات",74,"ت",1,0],["وَمُغالِبُ العَقَباتِ حَتماً غالبٌ","إِلّا إذا اطَّرَحَ الثَبات وَأَقصَرا",75,"ر",2,0],["ومُغْبَرّ تَشابَهُ من","ه أعلامٌ وقِيعانُ",76,"ن",1,0],["وَمُغَرِّدٍ بِالبانِ لَو عَرَفَ الهَوى","لَم يُمس في غَذَبِ الغُصونِ مُغَرِّدا",77,"د",2,0],["ومَغناه للراجي مجَنّاً وجُنَّةً","فها نحن فيها لا نجوع ولا نَعرَا",78,"ر",2,0],["ومغن يحيط بالحال علماً","فهو يأتي ولا يقول بحذر",79,"ر",1,0],["ومُغازلاً فَتَيَاتها في فِتْية","ما منهمُ إلا أغَرُّ مُهَذّبُ",80,"ب",1,0],["وَمُغيرَةٍ سَومَ الجَرادِ وَزَعتُها","قَبلَ الصَباحِ بِشَيِّئانٍ ضامِرِ",81,"ر",1,0],["وَمغانٍ تَحلو فَتَحلو مَعانٍ","لِلمَعنى بِهِنَّ بَعدَ الفِراقِ",82,"ق",1,0],["ومغان تشرفت واستنارت","وأضاءت من نور ماحي الظلام",83,"م",1,0],["ومغربي كصباحي","ومثل يومي أمسي",84,"س",2,0],["وَمَغرَبِ الشَمسِ وَمِشرِقِ القَمَر","وَكَوكَبِ الصُبحِ إِذا اللَيلُ دَبَر",85,"ر",1,1],["وَمُغيبي بي عَنكَ عَينُ اِحتِجابي","عَن وُجودي وَفيكَ عَينُ اِطِّلاعي",86,"ي",1,0],["ومَغْشيُّ الرِّواقِ لعُظْمِ قَدْرٍ","يَغَصُّ ذُراهُ بالخيلِ الصّوافن",87,"ن",1,0],["وَمُغَرِّدَينِ تَجاوَبا في مَجلِسٍ","مَنَعوهُما لِأَذاهُما الأَقوامُ",88,"م",1,1],["ومُغِيرَةٍ نَسْجَ الجَنُوبِ شَهِدْتُها","تَمْضِي سَوابِقُها عَلَي غُلَوائِها",89,"ا",3,0],["ومَغموسَةٍ في مِثلِ لَونِ لُعابِها","يَضُمُّ حَشاها صامِتاً مُتَكلِّما",90,"م",2,0],["ومغرد باللوم طال غِناؤه","وحِداؤه بملامَتي ونَشيدُهُ",91,"د",2,0],["وَمُغرد وَالبَرق يوري زِندَهُ","ناراً لَها عَوج الضُلوع حَريق",92,"ق",1,0],["وَمُغَرّد فيهِ اِشتياق مُتيم","يَشدو بِأَشجى مَنطق وَغِناءِ",93,"ا",2,0],["ومغفرة ورحمة ورضوان","فندخل الجنة ولا نرى النار",94,"ر",1,0],["ومغفرة منه ولطفاً ورحمة","إذا ما نزلت القبر منفرداً وحدي",95,"د",2,0],["وَمغلغلات في سويداواتها","مِن حيث لا تَتَغلغل الأَفكارُ",96,"ر",1,0],["ومغفورٌ لها إن أسعَفَتْنِي","بقربك ما لقيتُ وما أُلاقي",97,"ق",2,0],["ومُغْرِياً جَفْنَ عَيْنِي بالمنامِ لقد","أَبدَعْتَ في ذلك الإِغراءِ إِغْرَابا",98,"ب",2,0],["ومُغَنٍّ تناولَتْ يدُهُ العو","دَ فعادَتْ لنا على الاقْتِراح",99,"ح",1,0],["ومغترب شطت به غربةُ النوى","ومختبط أودت به صفقة العسر",100,"ر",1,0],["ومُغَرَّبٍ تبكي السَّماءُ لِشَجْوِهِ","مِنِّي وتَلْتَهِفُ النجومُ لِلَهْفِهِ",101,"ف",2,0],["ومغان للهو والأنس فيها","ما تحب النفوس من أغراض",102,"ض",1,0],["ومغرّدُ المُكّاءِ يندب شجوه","طرباً بكل عشيةٍ وصباح",103,"ح",1,0],["ومغريكُمُ بي أن تكفُّوا نوالَكم","بمجدِكُمُ أغراكُمُ لو علمتُمُ",104,"م",1,0],["ومغبرّة الجوّ غرثى الترا","ب لا تحلب الضرعَ إلا القُروفا",105,"ف",2,0],["ومغامرون إذا الكما","ةُ تواكلتْ أغمارُها",106,"ر",3,0],["ومغَيِّمِ المعروف يخدعني","إيماضُ واضحتيهِ بالبِشرِ",107,"ر",1,0],["ومُغْبرِّ المَطالعِ مُقْشعِرٍّ","تباعد عن أهِلَّتهِ النَّعيمُ",108,"م",1,0],["وَمُغَنٍّ لَهُ طِرازُ عِذارٍ","فَوقَ خَدٍّ لَهُ حَواشٍ رَقاقُ",109,"ق",1,0],["وَمُغَنٍّ ضَربُهُ أَو","جَعُ مِن ضَربِ السِياطِ",110,"ط",1,1],["وَمُغَنٍّ لَهُ لِسانٌ عَثورُ","كُلَّ شِعرٍ يَأتي بِهِ مَكسورُ",111,"ر",1,1],["وَمُغَنٍّ لَو اِتَخَذناهُ خِلّاً","لَاِفتَخَرنا بِذَلِكَ الإِتَّخاذِ",112,"ذ",1,0],["ومغير حجر قد جررت برجله","بعد الهدوِّ له قوائم أربعُ",113,"ع",1,1],["ومغرمٍ لمّا نأى أحبابُه","عنِ الحِمى