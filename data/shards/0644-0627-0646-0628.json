{"poems":[[102,"منزغ الشياطين","https://www.aldiwan.net/poem6546.html","عموديه"],[23,"والله ربي لا نفارق ماجدا","https://www.aldiwan.net/poem21417.html","الكامل"],[74,"يا مديد النوال دعوة راج","https://www.aldiwan.net/poem19227.html","الخفيف"],[53,"أبلغ أبا سهل فتى العجم الذي","https://www.aldiwan.net/poem8162.html","الكامل"],[26,"هل الدهر إلا ليلة ونهارها","https://www.aldiwan.net/poem24105.html","الطويل"],[93,"لا نبغيض الروس لكن لا نحبهم","https://www.aldiwan.net/poem62766.html","عموديه"],[91,"ما بنا خوف اذا الموت دنا","https://www.aldiwan.net/poem44842.html","الرمل"],[87,"سعي الفتى في عيشه عباده","https://www.aldiwan.net/poem8014.html","الرجز"],[64,"يا أيها الباحث عن سرنا","https://www.aldiwan.net/poem52141.html","السريع"],[51,"لعظيم من الأمور خلقنا","https://www.aldiwan.net/poem63105.html","الخفيف"],[107,"إيه بني مصر من صم وعميان","https://www.aldiwan.net/poem43098.html","البسيط"],[52,"لا تحمدن أبا حرب بأسرته","https://www.aldiwan.net/poem64801.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54733","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54990","الرجز"],[111,"أشعة الحق لا تخفى عن النظر","https://www.poetsgate.com/ViewPoem.aspx?id=512",""],[102,"الخضر المغمور","https://www.poetsgate.com/ViewPoem.aspx?id=50346",""],[102,"زامر القفر العامر","https://www.poetsgate.com/ViewPoem.aspx?id=50393",""],[102,"بلادي في المنفى","https://www.poetsgate.com/ViewPoem.aspx?id=50369",""],[23,"واللهِ ربي لا نفارقُ ماجداً","https://www.poetsgate.com/ViewPoem.aspx?id=11419",""],[96,"فلسفة الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=15614",""],[119,"حتى م اجري في ميادين الهوى","https://www.aldiwan.net/poem40877.html","عموديه"],[146,"عيوب لابن مالك قد كفتنى","https://www.aldiwan.net/poem58334.html","الوافر"],[154,"لكل نبي عصمة وأمانة","https://www.aldiwan.net/poem68578.html","الطويل"],[189,"عتبت ولكنني لم أع","https://www.aldiwan.net/poem14581.html","المتقارب"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[193,"فضل الله سيد الخلق قدما","https://www.aldiwan.net/poem35277.html","الخفيف"],[236,"تواضع لرب العرش علك ترفع","https://www.aldiwan.net/poem44582.html","الطويل"],[308,"يا برق بلغ رسالتي فمها","https://www.aldiwan.net/poem57839.html","المنسرح"],[354,"في شرق اسم الحب أهل الهوى","https://www.aldiwan.net/poem15748.html","السريع"],[409,"أجزتك يابن ودي ما تريد","https://www.aldiwan.net/poem33944.html","الوافر"],[435,"الحمد لله الذي قد حللا","https://www.aldiwan.net/poem40815.html","الرجز"],[449,"يا ثلج في مصبحي وفي غسقي","https://www.aldiwan.net/poem56012.html","عموديه"],[463,"هل تقبلون إنابة الدهر","https://www.aldiwan.net/poem56194.html","أحذ الكامل"],[487,"ألا ليت شعري ما تقول عظائم الد","https://www.aldiwan.net/poem24527.html","عموديه"],[545,"لا نبتغي لبن البعير وعندنا","https://www.aldiwan.net/poem56805.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138204",""],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137652",""],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145976","مجزوء الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62532","الرمل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133768","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56347","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[2226,"","https://poetry.dctabudhabi.ae/diwan/poem/200276","الطويل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104957","الرمل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124777","الطويل"],[2521,"","https://poetry.dctabudhabi.ae/diwan/poem/110666","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87330","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/138000",""],[3132,"","https://poetry.dctabudhabi.ae/diwan/poem/73668","الوافر"],[3167,"","https://poetry.dctabudhabi.ae/diwan/poem/136889","البسيط"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82826","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85268","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133062","الطويل"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77689","الرمل"],[4717,"فرجعناك إلى أمك كي (...)","https://www.poetsgate.com/ViewPoem.aspx?id=199882",""],[4755,"أنشودة المساكين","https://www.poetsgate.com/ViewPoem.aspx?id=215431",""],[4927,"قصيدة الثورة على الشبيحة","https://www.poetsgate.com/ViewPoem.aspx?id=79601",""],[4984,"رغبة","https://www.poetsgate.com/ViewPoem.aspx?id=181625",""],[5187,"ذكريات وعتاب","https://www.poetsgate.com/ViewPoem.aspx?id=29255",""],[4045,"لو كنت تأخذ مثل ما","https://www.poetsgate.com/ViewPoem.aspx?id=200272",""],[5431,"ودفء به طهرٌ جليٌ وملمسُ","https://www.poetsgate.com/ViewPoem.aspx?id=190446",""],[5431,"قد خُلقنا ملائكا في الطراز","https://www.poetsgate.com/ViewPoem.aspx?id=200154",""],[5542,"نحن أدرى","https://www.poetsgate.com/ViewPoem.aspx?id=10197",""],[5544,"موطني","https://www.poetsgate.com/ViewPoem.aspx?id=213413",""],[5691,"وجبة تحقيق","https://www.poetsgate.com/ViewPoem.aspx?id=206390",""],[5725,"سلاما للعراق","https://www.poetsgate.com/ViewPoem.aspx?id=191774",""],[3856,"وغَرِقنَا حِينَ طِرنَا؛ عِندَما","https://www.poetsgate.com/ViewPoem.aspx?id=215912",""],[5776,"رملٌ يسافرُ بالواحة","https://www.poetsgate.com/ViewPoem.aspx?id=199342",""],[5829,"جحود العرب","https://www.poetsgate.com/ViewPoem.aspx?id=187393",""],[5861,"وَرَجعْتَ!!","https://www.poetsgate.com/ViewPoem.aspx?id=192660",""],[5909,"ما عندنا ما عندكم من نارِ","https://www.poetsgate.com/ViewPoem.aspx?id=210240",""],[5956,"أنا في الصحراء أمضي","https://www.poetsgate.com/ViewPoem.aspx?id=184783",""],[5956,"أواصلُ الانجذاب إلى حياتي الجديدة بمدريد","https://www.poetsgate.com/ViewPoem.aspx?id=192079",""],[6052,"قبة الهادي","https://www.poetsgate.com/ViewPoem.aspx?id=34642",""]],"verses":[["لأن بني (قايين) أضحوا عوالم","على الارض أمست للشياطين منزغا",0,"غ",2,0],["لا نَبتَغي رَبّاً سِواهُ ناصِراً","حَتّى تُوافِيَ ضَحوَةُ الميعادِ",1,"د",1,0],["لا نبالي إن قيل شهر جمادى","كل شهر براحتيك ربيع",2,"ع",1,0],["لا نَبْتغي شيئاً سواك وإنما","طَلَبُ امرىءٍ ما بعدَ حاجتهِ كَلَبْ",3,"ب",1,0],["لَأُنبِئتِ أَنّا نَجتَدي الفَضلَ إِنَّما","نُكَلَّفُهُ مِنَ النُفوسِ خَيارُها",4,"ر",3,0],["لا نِبغيضُ الروسَ لَكِن لا نُحِبُّهُمُ","فَحَربُنا حَربُ أَقرانٍ لِأَقرانِ",5,"ن",1,1],["لا نُبغِضُ الروسَ لَكِن لا نُحِبُّهُمُ","فَحَربُنا حَربُ أَقرانٍ لِأَقرانِ",5,"ن",1,0],["لا نبالي بعد ان حم الردى","أهناك الموت وافى ام هنا",6,"ن",2,0],["لِأَنَّ بِالسَعيِ يَقومُ الكَونُ","وَاللَهُ لِلساعينَ نِعمَ العَونُ",7,"ن",1,0],["لأن به الماسُ على يبسه","وانحلَّ منه الطلق حتى جرى",8,"ر",2,0],["لا نُبالي وَلا نَراهُ غَراماً","ذا لَعَمري لَوِ اِتَّعَظنا الغَرامُ",9,"م",1,0],["لا نَبتَغي غَيرَ دُنيا الأَنبِياءِ وَلا","نَرضى سِوى اللَهِ مِن رَبٍّ لَنا ثانِ",10,"ن",1,0],["لا نَبوَتي رُشدَهُ إِلّا تَخَوُّنَهُ","غِمداً لِأَيرٍ غَوِيٍّ بِاِستِ مُنجابِ",11,"ب",1,0],["لأْنَّ بَيَاناً كَهَذَا الْبَيَانِ","جَدِيرٌ كَمَا شَاءَ أَنْ يَخْلُدَا",12,"د",2,0],["لاَ نَبْتَغِي عَلَى الهَوَى مِنْ عَوَضٍ","وَلِلْهَوَى مِنْ نَفْسهِ كُلِّ العَوَضْ",13,"ض",1,0],["لا نبخس الناس بالأهواء حقهم","ولا نبالي بقدح الخاتر الأشر",14,"ر",1,0],["لأنّ به كالنهر أشواق باذل","يعاني عناء النهر ، يجري كما جرى",15,"ر",2,0],["لأنّ بع سرّ الحقول تحسّه","يشعّ ويندى ، ولا تعي كيف أزهرا",15,"ر",2,0],["لان بقلبك صوم الحقول","تغني لتسودّ صفر الغمام",16,"م",1,0],["لأن بلادي الحبيبة","في مرتباها غريبة",17,"ب",2,1],["لا نبتغي ربّاً سواهُ ناصراً","حتّى نوافِي ضحوةَ الميعادِ",18,"د",1,0],["لا نبض ما خفقت به لكنّه","صوت الحديد غدا يصلّ صليلا",19,"ل",2,0],["لانبهن على الغرام بزفرتي","ولها ليبرد قلبي المحروق",20,"ق",1,0],["لأنَّ بها على ما قيل يَبْسا","وأنّ صديقَها رطبُ المِزاجِ",21,"ج",1,0],["لإِنبائِهِ بِالغَيبِ قَبلَ أَوانِهِ","دَلائِلُ تَشريفٍ قَدِ اتَّصَلَت نَقلا",22,"ل",2,0],["لأَنْباك قلبُك أنّ المَلام","إذا استحكمَ الحبُّ لم ينفع",23,"ع",1,0],["لا نبيٌّ ولا رسولٌ ولا جب","ريلُ يَدري العطاءَ جلّ العطاءُ",24,"ا",2,0],["لا نَبيٌّ ولا رسولٌ ولا الأم","لاكُ تَدري العطاءَ جلّ العطاءُ",25,"ا",2,0],["لأن به خير الأنام محمداً","له كل الفضائل تجمع",26,"ع",1,0],["لأن بيني وبين مبسمها","ليلةَ زارت علامةَ القبلِ",27,"ل",1,0],["لِأَنَّ بُنيانَ يَقيني عَلى أَسٍ","مِنَ التَحقيقِ مَرصوصُ",28,"ص",1,0],["لأن بناء أحكام البرايا","بها دارت وهن لها عمود",29,"د",1,0],["لان بالسير نشاط البدن","وفيهِ تحليلٌ لخلطٍ عفِن",30,"ن",1,0],["لا نبت لا ماء فهو في جمد","بل من رأى جامدا من العرق",31,"ق",1,0],["لا نبوةُ الدنيا تغيِّرني","عنكم ولا متغيِّرُ الأمرِ",32,"ر",1,0],["لإن برزخ المشهوديات به ترى","تشاهده فتق الرتقيات الهيولية",33,"ي",2,0],["لا نَبتَغي لَبَنَ البَعيرِ وَعِندَنا","ماءُ الزَبيبِ وَناطِفُ المعصارِ",34,"ر",1,1],["لا نبلغ النجم في أسمى منازله","وكيف تدرك في عليائها الشهب",35,"ب",1,0],["لأن بيان البلاء عميم","ومن كل ناحية قد سقط",36,"ط",1,0],["لا نُبالي بمَوتنا","وَهوَ خَافٍ وَمُعلنُ",37,"ن",1,0],["لا نبَالي فيحَثما","كَمُنَ الدَّاءُ نَكمُنُ",37,"ن",1,0],["لا نبالي إن بذلنا أنفساً","في رضا المولى ونؤتى المطلبا",38,"ب",2,0],["لا نبالي ان النضار بأيدينا","حرام فليشهد الفرقدان",39,"ن",1,0],["لأن بقاه غاية القصد والمُنا","فتى أرّخوه فخر كل الأكارمِ",40,"م",1,0],["لان بالخسفِ وبسطٍ يَقدَحُ","مدان في حَرفٍ وهذا يَقبُحُ",41,"ح",1,0],["لأن بوادي الظاعنين نواحل","حلايف وجد طوع حكم المحاير",42,"ر",1,0],["لا نبالي بعد أن لذنا به","أن لقينا بولاه ما لقينا",43,"ن",2,0],["لأن به تحصين ملة أحمد","وفضل عموم النفع فوق المقيد",44,"د",1,0],["لأن به الأنجيل والحكم التي","تنزل والتنزيل والأنبيا جمعا",45,"ع",2,0],["لأنَّ بالأزيَب هُنَاكَ إعتِرَاض","مَا قُلت ذَا إلاّ لِذي الأغرَاض",46,"ض",1,0],["لأنَّ بَتَّه فَوقَها جَزيره","فَازَعَلِي تُسمَى بِذَا شَهِيرَه",47,"ه",1,0],["لأن بها مصابيح الهدى من","بني علوي فكم فيهم إمامُ",48,"م",1,0],["لأَنَّ بَياضَها كَبَياضِ شَيبِي","فَمَعنَى سَجعِها قَرُبَ الحِمامُ",49,"م",1,0],["لا نبتغي غير آل الله ترأسنا","يا آل هاشم أنتم نخوة العرب",50,"ب",1,0],["لان بعد العهد يدرس الاثر","سبحان من بالموت خلقه قهر",51,"ر",1,0],["لا نَبتَغي مِنكُم سِوى","تَعليمِنا فهوَ الدَلوا",52,"ل",3,0],["لأن بها ماوىً لمن يقصد الخنا","وكم فعلوا فيها من الرقص والإثم",53,"م",1,0],["لأن بها الآرام ترعى عشوبها","فتلك مرام الراميات الدواعج",54,"ج",1,0],["لا نُبالي ما سَمِعنا","مِن فُلانٍ وَفُلانِ",55,"ن",1,0],["لا نبالي يا عجوزٌ فاسْكتي","لستُ أُعطي لعجوزٍ أذنَيْ",56,"ي",1,0],["لا نُبصِرُ الفقرَ عَيبًا.. فهو أَفقَرُ مِن","عَيبٍ، وأَضعَفُ قَلبًا لِلمَوَازِينِ",57,"ن",1,0],["لأَنَّ بِأَرْضِ الشَّاْمِ بَطْشاً وَفِتْنَةً","أَثَاْرَ لَظَاْهَاْ مَنْ أَذَلَّ الرَّوَاْبِيَاْ",58,"ي",2,0],["لا نبالى إن ضللنا وجهة","أو وجدنا الدرب في عز الحصار",59,"ر",1,0],["لا نبالي إنْ أصَبنا اليومَ عيشاً","أمْ صُروفُ الدَّهرِ أدْمَتنا امْتحانا",60,"ن",2,0],["لا نبتغي بذلا بهم","أبدا ومن أين البدل؟",61,"ل",1,0],["لأنّ بها الأكوان هامت بربها","ودارت على شوقٍ جوارٍ وكُنَّسُ",62,"س",1,0],["لانبالي بطعنة الكون إنّا","قد خُلقنا ملائكا في الطراز",63,"ز",1,0],["لا نبالي بخفافيش ظلام","بل نناديها وغيثُ الحب هاطل",64,"ل",1,0],["لا نبالي إذا لظى الحرب شبت","أقتلنا في عزَّة أم قتلنا",65,"ن",2,0],["لا نبتغي شيئاً سوى أسمائِهمْ","وكَفى ... ومِنْ هذي المتاعِبِ تسْلَمُ",66,"م",1,0],["لان بوجهك كلّ العراق","بريق من الضوء لا يدلكُ",67,"ك",1,0],["لا نُبَرِّي (رُبَّما) مِن دَمِنا","إذ عشقناهُ، وقُلنا: رُبَّما",68,"م",2,0],["لأنّ بكاءَهُ أشجى","لأنّ دموعَهُ ألبقْ",69,"ق",1,0],["لا نبتغي أفقا إلا ونبلغه.","لم يبق معترك إلا بلوناه",70,"ا",2,0],["لا نبت بعدَ اليومَ في صحرائِنا","جفّتْ رقاعي والفؤادُ تجرّدا",71,"د",2,0],["لا نبتغي إلا اليسير بساعةٍ","فيها يحيق العفو بالأوزارِ",72,"ر",1,0],["لا نباتاً لا مياهاً","في تصابيَّ إليها",73,"ي",3,0],["لأن بلادنا فيها حروب","رمتني حاملاً حِسَّ الشريد",74,"د",1,0],["لانبالي إذا مشينا فلسنا","من يرد الردى خطاه جبانا",75,"ن",2,0]]}