etsgate.com/ViewPoem.aspx?id=206304",""],[5628,"النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=178442",""],[402,"قد تلوى رفاقنا وبقينا","https://www.poetsgate.com/ViewPoem.aspx?id=36482",""],[5939,"عام جديد للحب","https://www.poetsgate.com/ViewPoem.aspx?id=195292",""],[5956,"الكافورُ الجديد","https://www.poetsgate.com/ViewPoem.aspx?id=192937",""],[5956,"يَدُ بنيَّ مربوطةٌ كعقولنا","https://www.poetsgate.com/ViewPoem.aspx?id=193399",""],[5956,"حربُ تَشرين التحريرية","https://www.poetsgate.com/ViewPoem.aspx?id=194123",""],[5956,"الداشرة صاحبةُ اليوم الأسود المتوقَّع","https://www.poetsgate.com/ViewPoem.aspx?id=204358",""],[5956,"حفيدٌ لم تُرْضهِ ضحكةُ جَدِّهِ","https://www.poetsgate.com/ViewPoem.aspx?id=206258",""],[5956,"أمُّ الحبيبِ مُحمدٍ والمصطفى","https://www.poetsgate.com/ViewPoem.aspx?id=207118",""],[5970,"هاهي الساعة الرهيبة وافت","https://www.poetsgate.com/ViewPoem.aspx?id=130673",""],[6024,"عارض الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=186345",""],[6031,"بعثَتْ طَيْفَها فَزَارَ طُرُوقَا","https://www.poetsgate.com/ViewPoem.aspx?id=46276",""],[4442,"بالأعالي فتنت لا بالأسافل","https://www.poetsgate.com/ViewPoem.aspx?id=171204",""],[6093,"أشكو إلى الله منْ هَمٍّ يُساورُني","https://www.poetsgate.com/ViewPoem.aspx?id=176150",""],[6093,"قلبٌ يَطرُقُ البَابَا","https://www.poetsgate.com/ViewPoem.aspx?id=189701",""],[6093,"حبة","https://www.poetsgate.com/ViewPoem.aspx?id=191004",""],[6147,"سوريا..لاءاتنا الحُمْر","https://www.poetsgate.com/ViewPoem.aspx?id=151697",""],[520,"بصفات مجدك يشرف التمجيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577470",""],[5377,"رثاء شعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79547&r=&rc=1",""],[170,"ومهمهٍ يتراءى آلة ُ لججاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26730&r=&rc=5",""],[463,"سألَ اللِّوى وسؤالهُ إلحافُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60147&r=&rc=203",""],[6259,"أتروم تغطية َ الهوى بجحوده","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59366&r=&rc=14",""],[2944,"شكوى العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86015&r=&rc=4",""],[572,"لم تَرَني قَطُّ بارياً قلماً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9379&r=&rc=236",""]],"verses":[["لَم تَرهَبِ الأَقدارُ عِزَّتَهُ وَلا","اِتَّقَتِ النَوائِبُ جَمعَهُ العُضّالا",0,"ل",2,0],["لَم تُرضِني تِلكَ اللَيالي عَنهُمُ","بِنَوالِهِم فَأَقولَ يَوماً عودي",1,"د",2,0],["لمْ ترْجُ إلا اللهَ جلّ جَلالُهُ","في شِدّةٍ تُكْفَى وجُرْحٍ يوسَى",2,"س",2,0],["لَم تَرَهُ جارَةٌ يَمشي بِساحَتِها","لِريبَةٍ حينَ يُخلي بَيتَهُ الجارُ",3,"ر",1,0],["لَمْ تَرْقَ حَقْبَةٍ مِصْرٌ كَمَا رَقِيَتْ","فِي عَصْرِهِ بَيْنَ أَمْصَارٍ وَبُلْدَانِ",4,"ن",1,0],["لم تروِ لي عيناه حكمة بابل","إلا أخذت حديثها مقبولا",5,"ل",2,0],["لم ترضَ همّتُك القليلَ من التقى","حتى أتت بالصالحات قبيلا",5,"ل",2,0],["لم ترض من حِصنهم أن كان ممتنِعاً","حتى يُكَبَّرُ فيها الواحدُ الصمدُ",6,"د",1,0],["لم تر إلا دموع باكيةٍ","تَقْطُرُ من مقْلةٍ على خدِّ",7,"د",1,0],["لم تروغي عن المحجة في وص","لك بل أنت شكلةٌ لم تروغي",8,"غ",2,0],["لم تَر عينا ناظرٍ شبهيهما","فاقْتسِر الحرفين من وجهيهما",9,"م",2,0],["لَم تُراعِ قَطُّ ذا صِلَةٍ","لا وَلَم تُشفِق عَلى رَحِمِ",10,"م",1,0],["لم تَرد الموارد الشهيه","لم تعرف اللذائذ الهنيه",11,"ي",2,0],["لم ترد بحر المكاسب","يا غريقا في الضلال",12,"ل",1,0],["لَم تُرَ في بابِلٍ","ما عُهِدَت في إِرَم",13,"م",1,0],["لَم تَرضَني ذَنباً لِنَجمِكِ هِمَّتي","إِنَّ البَيانَ بِنَجمِهِ يُنبيكِ",14,"ك",1,0],["لَم تَرَ مَن نادَمتُ إِلّاكا","لا لِسِوى وُدِّكَ لي ذاكا",15,"ك",2,1],["لَم تَرُع قَومَهُ السَرايا وَلَم يَغ","زُهُم غَيرُ جَحفَلٍ جَرّارِ",16,"ر",1,0],["لَم تُروِ دِجلَةُ ظَمأَةً مِنّي وَقَد","جاوَرتُها وَتَرَكتُ ذاكَ لِذاكا",17,"ك",2,0],["لم تَرْمنِي الأيامُ فيه بِنَظرَةٍ","إلا انَثَنْينَ بناظِرٍ مَطروفِ",18,"ف",1,0],["لَم تُرَنَّح أَعطافَهُ نَسمَةُ الكِب","رِ وَلا اِقتِادَهُ عِنانُ العِنادِ",19,"د",1,0],["لَم تُرَنَّح أَعطافَهُ نَشوَةُ المُل","كِ وَلا يَزدَهيهِ فَرطُ اِعتِجابِ",20,"ب",1,0],["لم تُروَ منكَ نواظري وخواطري","ورجعتُ أزكي مهجةً وشفاهَا",21,"ا",3,0],["لم تَرو منكِ نواظري وخواطري","ورجعت أذكي مهجةً وشفاهَا",22,"ا",3,0],["لَم تَرعَ لي حُرَقاً بِقَلبي قَد مَضَت","لَو لَم يَذُدها الدَمعُ عَنهُ لَاِشتَوى",23,"و",2,0],["لَم تَرمِ ذا رَحِمٍ بِبائِقَةٍ وَلا","كَلَّمتَ قَومَكَ مِن وَراءِ حِجابِ",24,"ب",1,0],["لَم تَرَ العَينُ لِلثُرَيّا شَبيهاً","بِمَسيلِ التِلاعِ لَمّا اِلتَقَينا",25,"ن",2,1],["لَم تَرضَ لي غَيرَ المَحامِدِ مَذهَباً","نَفسٌ يَجيءُ بِها العَفافُ وَيَذهَبُ",26,"ب",1,0],["لَم تَرضَ إِلّا الحَلالا","غُذيتَهُ في رِضاعِك",27,"ك",1,0],["لَم تَرَهُ الشَمسُ وَلَم","يَعتِك عَلَيهِ الطُحلَبُ",28,"ب",1,0],["لَم تَرقُدِ اللَيلَ مِن هَمٍّ أَلَّم بِها","حَتَّى اِرتَدى في الصَباح الواضِحِ الأُفُقُ",29,"ق",1,0],["لَم تَرَ عَيني مِثلَ عُروَةَ خُلَّةً","وَمَولىً إِذا ما النَعلُ زَلَّ قِبالُها",30,"ل",3,1],["لَم تُرَ قَطُّ مِثلُها مَدينَه","مَنيعَةً بِسَعدِها حَصينَه",31,"ه",1,0],["لَم تَرَ عَيني مِن قَبلِهِ قَمَراً","حَكى هِلالَ الدُجى فاراهُ",32,"ه",1,0],["لَم تَرِد ماءَ وَجهِهِ العَينُ إِلّا","شَرِقَت قَبلَ رَيَّها بِرَقيبِ",33,"ب",1,0],["لَم تَرعَ بِالسَهلِ أَنواعَ الثِمارِ وَلا","ما أَينَعَ الزَهرَ مِن قَطرٍ وَأَنداءِ",34,"ا",2,0],["لَم تَرَ عَيني مِثلَهُ مَركَباً","أَحسَنَ إِن سارَ وَإِن عَرَّجا",35,"ج",2,0],["لَم تَرَ مِثلي مُغرَماً بِالهَوى","وَمِثلَ عَبّادَةَ لَم تَقصِدِ",36,"د",1,0],["لَم تَرثِ لي مِن جَوى حُبٍّ وَقَد ضَحِكَت","عَن بارِدٍ كَوَميضِ البَرقِ لَمّاحِ",37,"ح",1,0],["لَم تَرَ مِثلي بَينَ مِثلَيهِما","هَذا بِهِ داءٌ وَهَذا كَذوب",38,"ب",1,0],["لَم تَرَ العَينُ لِعَينٍ فِتنَةً","مِثلَها بَينَ جُمادى وَرَجَب",39,"ب",1,0],["لَم تَرضَ ذاكَ الفَتاةُ عَنكَ وَلا","رَبُّكَ فيما فَعَلتَهُ راضِ",40,"ض",1,0],["لَم تُرزَقوا خَيراً وَلَم تُعدَموا","شَرّاً فَما بالُكُمُ تَغبِطون",41,"ن",1,0],["لَمْ تُرْضِهِ الدَّنْيَا بِمَا بِذَلَتْ لَهُ","مِنْ مُغْرِيَاتٍ مَنَاصِبِ وَمَرَافِقِ",42,"ق",1,0],["لَمْ تَرُومِي إِلاَّ الجَلِيلَ وَجَانَبْ","تِ الأَبَاطِيلَ وَاتَّقَيْتِ الفُتُونَا",43,"ن",2,0],["لَمْ تُرْوَ مِنْ قِدَمٍ وَلَمْ","تَقْصَصْ حَدٍِيثاً فِي كِتَابْ",44,"ب",1,0],["لَم تَرجِعِ الرُسلُ بِالبُشرى بِوَعدِكُم","حَتّى أَتاهُ رَسولٌ مِنكِ يَنعاهُ",45,"ا",2,0],["لم تَرَ العينُ له مثلاً ولا","خطرتْ أوصافُه في أذنينْ",46,"ن",1,0],["لم تَرَ النسْرَ في مَخالِبِه الزرْ","قِ ولا رُوِّعَتْ بصَيْدِ حِبال",47,"ل",1,0],["لم تر المجد في لباس أنيق","أو طلاءِ الوجوه بالألوان",48,"ن",1,0],["لم ترنّح مصباحنا أيّ ريح","دمنا الزيت في فم المصباح",49,"ح",1,0],["لم ترمِ بي قَدَمي هنا إلاّ جَرَت","من ذِكرياتِ السالفينَ دموعي",50,"ع",2,0],["لم ترع عهد فتى رعاك","على السريرة وأتمن",51,"ن",1,0],["لم ترض تعذيب الحياة فسخّرت","بعد الردى لعقابه المجهولا",52,"ل",2,0],["لَمْ تَرَى العَيْنُ لِلثُّرَيّا شَبيهاً،","بِمَسِيلِ التِّلاعِ لَمّا کلْتَقَيْنا",53,"ن",2,1],["لم ترفع الدعوى وان كبرت فتى","للحق برهان له آثار",54,"ر",1,0],["لم ترتو الأبصارُ من لألأئه","إلا وعادت نحوهُ تشكو الصدى",55,"د",2,0],["لَم تَرضَ لي حُلَلاً سَأَنزِعُها غَداً","فَشَفَعتَها بِمَلابِسٍ لَن تُنزَعا",56,"ع",2,0],["لَم تَرُض آمِليكَ في حَلبَةِ المَط","لِ وَلَم تَرضَ لِلمُنى بِالكَفافِ",57,"ف",1,0],["لم ترتضوا لبعضهم تصدراً","يوجب خطوة له وقربا",58,"ب",2,0],["لم ترض غير السيف خدنا والظبا","يا من نداه وسيفه اخوان",59,"ن",1,0],["لَم ترَ كَالمُزنِ سَواماً بُهَّلاً","تَحسَبُها مَرعِيَّةً وَهيَ سُدى",60,"ا",1,0],["لم ترضَ مني في وادي الغَضا سَببي","حتى جعلتُ إلى رُحي لها سَببا",61,"ب",2,0],["لم تَر عيني منظرا مثله","ماء تَلظَّى فوقه جَمْر",62,"ر",1,0],["لَم تَرُعه الأهوالُ في نشر دينٍ","هوَ وَحيٌ وما به أهواءُ",63,"ا",2,0],["لم ترضَ إذ جئتَنا من جنةٍ هرباً","حتى سرقتَ لنا في فيك مرجانا",64,"ن",2,0],["لَم تُرِعهُ طُيوفُ بَلواه لَو لَم","تَختَلِج في هَواهُ أَطهر ذِكرى",65,"ر",2,0],["لم ترعنا هجمة منه على","رسل الحق غشوما يحتطب",66,"ب",1,0],["لم تر عين مثل هذا المشهدِ","مستعبَدٌ يعبث بالمستعبِد",67,"د",1,0],["لَم تَرتَضِع دِرَّتَها أَو رَما","ها اللَهُ في الأَولادِ بِالثُكلِ",68,"ل",1,0],["لَم تَرضَ في الأَرضِ مَخلوقاً يَكونُ لَها","كُفُئاً تَدينُ لَهُ عَفواً وَتَأتَمِرُ",69,"ر",1,0],["لَم تَرضَ أَيّامُكَ لي لا رَأَت","يَومَ رِضىً بِالضَنكِ وَالعُسرِ",70,"ر",1,0],["لَم تَرَ عَيني وَلَم تَسمَع بِمِثلِهِمُ","حَيّاً كَحَيٍّ لَقيناهُم بِبُسيانا",71,"ن",2,1],["لم تَرضَ لي بالفراقِ حتى","تَلاه من كُتبك الصُّدُودُ",72,"د",1,0],["لَم تُرسِل الطّرف المعلّم صَيدُها","إلا استَباحَ الأصْيَد الجَحْجاحا",73,"ح",2,0],["لَم تَرْمِ إلا أقْصَدَتْ لحَظَاتُها","فَجَرى دَمُ الصّبّ المُتَيّم صائِبا",74,"ب",2,0],["لَمْ تَرْضَ أَنْ كُنْتَ الْكَفِيلَ بشَخْصِهِ","حَتّى شَفَعْتَ كَفِيلَهُ بِضَمِينِهِ",75,"ن",2,0],["لَم تَرضَ نَفسي بِهَذا","يا رَبِّ مِنكَ لِخَيرِ",76,"ر",1,0],["لم تَرضَ همَّتُهُ الكَبي","رَةُ غَيرَ شِربٍ بالكَبيرِ",77,"ر",1,0],["لَم تَرضَ لي أَنّي أَهيمُ بحُسنِها","حتّى هَجَرتُ أَحبَّةً وَحَبائِبا",78,"ب",2,0],["لم ترع حرمةَ وادٍ بتَّ تقذفُه","بكل خطبٍ يُشيب الطفلَ فدّاح",79,"ح",1,0],["لَم تَرَ في الناسِ حَشرا","اَتَمَّ مِنّا قَصَباً وَسَيُرا",80,"ر",2,0],["لَم تَرتَجف بشتائها وَبصيفها","لَكنّها اِضطربت لشدّة خَوفِها",81,"ه",2,0],["لَم تَرقَ خَدَّكَ وَهيَ ما لَدَغَت","إِلّا وَقَد أَلجَمتَها بِرُقى",82,"ق",2,0],["لَم تَرضَ إِلا بِالفرارِ كأنَّما","ريحُ الشَّمالِ علَيكَ ريحُ سمومِ",83,"م",1,0],["لم تركبي مثل إيليا النبي أبداً","مهروزةً بل ركبتِ مَتنَ أملاك",84,"ك",1,0],["لم ترتمي الوحش الى ايدي الذرع","فوردت قبل العهود المنصدع",85,"ع",1,0],["لَمْ تُرْعَ تِلكَ المكرماتُ","وذلك السَّبقُ القديمُ",86,"م",1,0],["لم ترَ عيني كاتباً مثلَهُ","لكلِّ شيءٍ شاءَ وَشَّاءَ",87,"ا",2,1],["لَم تَرضَ في قَتلي سِهام لِحاظِهِ","عَدواً فَأتبَعها رِماح نُهودِهِ",88,"د",2,0],["لم ترق عيني سوى طلعته","أنا فيها لم أزلْ أنجو من الغم",89,"م",1,0],["لم ترضَ خيبتَها كشيمةِ ربّها","فحمَتْ بما ملكَتْهُ من عِطرِ الدّمِ",90,"م",1,0],["لم ترَ عيني قبلَه","في كل فن مثلَهُ",91,"ه",1,0],["لم ترضَ أني قد حُرِمْتُ وصالَها","حتى حمَتْني في المنامِ خيالَها",92,"ل",3,1],["لم ترنو إلى الثرى","عابسا ساخط النظر",93,"ر",1,0],["لم تَرقِها خُدعتي بقولي ولا","فعليَ والسحرُ في يدي وفمي",94,"م",2,0],["لم ترتدع بعرضه","سيادةٌ ولم تَلِقْ",95,"ق",1,0],["لم تر من قبلك خِرْقاً قادها","أُسْدَ شَرىً تهفو عليهنّ الخُرُقْ",96,"ق",1,0],["لم ترمني الأيامُ فيك بعاثرٍ","هي أسهمٌ وجوارحي أهدافُ",97,"ف",1,0],["لَم تَرَهُ قَد عَينُ شارِعِهِ","يُطفِئُ فيهِ سِراجَ بَقّالِ",98,"ل",1,0],["لم