{"poems":[[53,"صبرت عنك فلم ألفظك من شبع","https://www.aldiwan.net/poem30133.html","البسيط"],[53,"أما ذعرت بنا بقر الخدور","https://www.aldiwan.net/poem30468.html","الوافر"],[53,"نبهتهم مثل عوالي الرماح","https://www.aldiwan.net/poem30651.html","السريع"],[53,"أي دموع عليك لم تصب","https://www.aldiwan.net/poem30737.html","المنسرح"],[53,"ألا لله بادرة الطلاب","https://www.aldiwan.net/poem30747.html","الوافر"],[63,"من الركب يا بن العامري أمامي","https://www.aldiwan.net/poem46178.html","الطويل"],[63,"سرى طيفها والملتقى متدان","https://www.aldiwan.net/poem46182.html","الطويل"],[55,"أيا من لا يجيب إذا كتبنا","https://www.aldiwan.net/poem26479.html","الوافر"],[73,"أما في نسيم الريح عرف معرف","https://www.aldiwan.net/poem11914.html","الطويل"],[93,"أصول الضاد طيبة الأروم","https://www.aldiwan.net/poem11416.html","الوافر"],[54,"أما في صروف الدهر أن ترجع النوى","https://www.aldiwan.net/poem27599.html","الطويل"],[51,"سليم الزمان كمنكوبه","https://www.aldiwan.net/poem8495.html","المتقارب"],[51,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[51,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[51,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[43,"ليالي بعد الظاعنين شكول","https://www.aldiwan.net/poem9967.html","الطويل"],[43,"أما في هذه الدنيا كريم","https://www.aldiwan.net/poem10573.html","الوافر"],[62,"هو الشوق حتى ما تقر المضاجع","https://www.aldiwan.net/poem52357.html","الطويل"],[45,"قد كان يعلم من طرفي بها طرفا","https://www.aldiwan.net/poem62683.html","البسيط"],[45,"لو كان يعتب هاجر في واصل","https://www.aldiwan.net/poem65544.html","الكامل"],[28,"حلفت برب الجاريات إذا جرت","https://www.aldiwan.net/poem5560.html","الطويل"],[28,"ومن عجب الأيام والدهر أن ترى","https://www.aldiwan.net/poem5610.html","الطويل"],[80,"أبى الله إلا أن يكون لك النصر","https://www.aldiwan.net/poem31432.html","الطويل"],[44,"وراءك عن شاك قليل العوائد","https://www.aldiwan.net/poem30605.html","الطويل"],[105,"لك من تحيات القلوب مواكب","https://www.aldiwan.net/poem42053.html","الكامل"],[105,"أعدوا لأعلام البيان المنابرا","https://www.aldiwan.net/poem42086.html","الطويل"],[105,"هو الخطب حتى ينكر التاج صاحبه","https://www.aldiwan.net/poem43380.html","الطويل"],[105,"أهذي ديار القوم غيرها الدهر","https://www.aldiwan.net/poem43415.html","الطويل"],[50,"أفرخ الزنج طال بك البلاء","https://www.aldiwan.net/poem64886.html","الوافر"],[46,"أعن عفر تلم بسرب عفر","https://www.aldiwan.net/poem22686.html","الوافر"],[46,"أنوار تحسب من سنا الأنوار","https://www.aldiwan.net/poem22703.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85331","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140995",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39628","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54923","الكامل"],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[45,"جُعِلتُ فِداكَ، الدّهْرُ ليسَ بمُنفَكِّ","https://www.poetsgate.com/ViewPoem.aspx?id=33093",""],[45,"قد كان يعلم من طرفي بها طرفاً","https://www.poetsgate.com/ViewPoem.aspx?id=32944",""],[45,"لَوْ كَانَ يُعْتَبُ هاجرٌ في وَاصِلِ","https://www.poetsgate.com/ViewPoem.aspx?id=32196",""],[110,"أما في جلق خل صديق","https://www.aldiwan.net/poem16517.html","الوافر"],[121,"كيف به والجفاء يبعد به","https://www.aldiwan.net/poem49347.html","المنسرح"],[129,"إما فررت من العدى","https://www.aldiwan.net/poem50633.html","الطويل"],[161,"رمتني فلا شلت يداها بأسهم","https://www.aldiwan.net/poem58914.html","الطويل"],[161,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[211,"أيا من حاز ملك الحسن طرا","https://www.aldiwan.net/poem13449.html","الوافر"],[232,"شواهد قلب الصب لا تقبل الرشا","https://www.aldiwan.net/poem44563.html","الطويل"],[232,"تواضع لرب العرش علك ترفع","https://www.aldiwan.net/poem44582.html","الطويل"],[236,"وبخيلة سمح الرقا","https://www.aldiwan.net/poem32174.html","مجزوء الكامل"],[242,"فديتك من جان تجور وتعتب","https://www.aldiwan.net/poem45750.html","الطويل"],[253,"أوجدي كذا أم هكذا كل من يهوى","https://www.aldiwan.net/poem1420.html",""],[257,"ألا يا إخوتي وذوي ودادي","https://www.aldiwan.net/poem48552.html","الوافر"],[262,"ألم بنا يختال غير ملوم","https://www.aldiwan.net/poem38190.html","الطويل"],[271,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[299,"حماة الديار","https://www.aldiwan.net/poem36297.html","عموديه"],[306,"أعيذ صفاء الود من كدر العتب","https://www.aldiwan.net/poem56604.html","الطويل"],[367,"أما فوقها إلا نجود وأنهم","https://www.aldiwan.net/poem17330.html","الطويل"],[367,"لا تضجرن مما أتيت فإنه","https://www.aldiwan.net/poem17864.html","الكامل"],[381,"أعند الحر للأيام ثار","https://www.aldiwan.net/poem48783.html","الوافر"],[404,"وأما شيوخي في العلوم فإنهم","https://www.aldiwan.net/poem33941.html","الطويل"],[406,"أما في الناس مرتاد لحمد","https://www.aldiwan.net/poem49960.html","الوافر"],[407,"نفسي الفِداء لِلحظِها من رامِ","https://www.aldiwan.net/poem50116.html","الكامل"],[410,"أما في الهوى حاكم يعدل","https://www.aldiwan.net/poem32553.html","المتقارب"],[440,"نجوم الصبا أين تلك النجوم","https://www.aldiwan.net/poem34849.html","المتقارب"],[440,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[444,"أما في الحمى ضوء لمن جنه الليل","https://www.aldiwan.net/poem55949.html","عموديه"],[462,"سل الحي عني هل أناخت خسيفة","https://www.aldiwan.net/poem15293.html","الطويل"],[480,"فتحت بنظمك المنثور بابا","https://www.aldiwan.net/poem37171.html","الوافر"],[507,"أما في الدهر معتبر","https://www.aldiwan.net/poem2430.html","مجزوء الوافر"],[530,"نداء لأهل الكشف في كل موطن","https://www.aldiwan.net/poem37148.html","الطويل"],[530,"أعد نظرا في محكم الذكر إنه","https://www.aldiwan.net/poem37227.html","الطويل"],[565,"أعيدوا لنا التاريخ احيوا لنا الذكرى","https://www.aldiwan.net/poem854.html",""],[588,"بعزك يا ذا الكبرياء والمراحم","https://www.aldiwan.net/poem11517.html","عموديه"]],"verses":[["إِمّا فَناءً عَنِ الدُنيا عَلى مَهَلٍ","أَوِ اِعتِباطاً يُغادي غُدوَةَ السَبُعِ",0,"ع",1,0],["أَما في هَذِهِ الدُنيا نَجيبٌ","يُساعِدُني عَلى حَربِ الدُهورِ",1,"ر",1,0],["إِمّا فَتىً نالَ العُلى فَاِشتَفى","أَو بَطَلٌ ذاقَ الرَدى فَاِستَراح",2,"ح",1,0],["إِمّا فَتىً ناضِرَ الصَبا كَأَخي","عِندي أَو زائِدَ المَدى كَأَبي",3,"ب",2,0],["أَما في بابِ خَيبَرَ مُعجِزاتٌ","تُصَدَّقُ أَو مُناجاةُ الحِبابِ",4,"ب",1,0],["أما في لئامِ النّاسِ مَندوحَةٌ لهُ","فحَتّامَ لا يَحْتاجُ غَيْرَ كِرامِ",5,"م",1,0],["أما فيكُما مِنْ هِزّةٍ أُمَويّةٍ","لأرْوَعَ في أسْرِ الصّبابَةِ عانِ",6,"ن",1,0],["أَما في حَقِّ حُرمَتِنا لَدَيكُم","وَحَقِّ إِخائِنا رَدُّ الجَوابِ",7,"ب",1,0],["أَما في نَسيمِ الريحِ عَرفٌ مُعَرَّفُ","لَنا هَل لِذاتِ الوَقفِ بِالجِزعِ مَوقِفُ",8,"ف",1,1],["أَمَا فِي عَصْرِنَا هَذَا فُحُولٌ","أعَادُوا رَوْعَةَ العَصْرِ العَظِيمِ",9,"م",1,0],["أمَا فِي البَرْقِ مَعْنىً غَيْرُ وَمْضٍ","بِلاَ أثَرٍ يُلَعْلِعُ فِي الغُيُومِ",9,"م",1,0],["أمَا فِي النُّورِ أَوْ فِي النَّارِ إلاَّ","ذُبَالٌ أَوْ ضِرَامٌ فِي هَشِيمِ",9,"م",1,0],["أَما في صُروفِ الدَهرِ أَن تَرجعَ النَوى","بِهِم وَيُدالَ القُربُ يَوماً مِنَ البُعدِ",10,"د",1,1],["أمَا في الزمان فتىً ماجدٌ","ينفِّسُ كربةَ مَكْرُوبِهِ",11,"ب",2,0],["أما فيهمُ راعٍ لحق نبيه","ولا خائفٌ من ربه يتحرجُ",12,"ج",1,0],["أما في ذاك عندك ما يعفّي","على ما بعد ذلك مِنْ خلالي",13,"ل",2,0],["أما في الطّوْل جمعك بين برّي","وتقريبي وقد وقعَ القبولُ",14,"ل",1,0],["أما في النّجوم السّائراتِ وغَيرِهَا","لِعَيْني عَلى ضَوْءِ الصّباحِ دَليلُ",15,"ل",1,0],["أَما في هَذِهِ الدُنيا كَريمُ","تَزولُ بِهِ عَنِ القَلبِ الهُمومُ",16,"م",1,1],["أَما في هَذِهِ الدُنيا مَكانٌ","يُسَرُّ بِأَهلِهِ الجارُ المُقيمُ",16,"م",1,0],["أما فيَّ أن أُسْتَوْدَعَ اليدَ منكمُ","فأحفظَها إنّ الأيادي ودائِعُ",17,"ع",1,0],["أَمّا فُؤادي فَعِندَ اللَهِ حِسبَتُهُ","فَقَد تَقَسَّمَهُ الغُرُّ المَباهيجُ",18,"ج",1,0],["إِمّا فَرَغتُ إِلى السُلُوِّ فَإِنَّني","مِن حُبِّكُم بِإِزاءِ شُغلٍ شاغِلِ",19,"ل",1,0],["أَما في بَني الجارودِ مِن رائِحٍ لَنا","كَما راحَ دُفّاعُ الفُراتِ المُثَلَّمُ",20,"م",1,0],["أَما فيكُمُ وَفدٌ وَلا فاتِكٌ بِهِ","فَماذا الَّذي تَرجونَ عِندَ العَظائِمِ",21,"م",1,0],["أما فتحتْ منهم بلاداً بلادُنا","بِزَعمهِمُ كُفراً على إِثرِهِ كُفرُ",22,"ر",1,0],["أَما فارَقَ الأَحبابَ قَبلي مُفارِقٌ","وَلا شَيَّعَ الأَظعانَ مِثلي بِواجِدِ",23,"د",1,0],["أمّا فلسطينُ الثكولُ فإِنَّها","تُطرِي صنيعَك والدُّموعُ سواكبُ",24,"ب",1,0],["أما في كتابِ الموتِ معنىً لباحثٍ","شَكَا خافياً منه وأنكر ظاهرا",25,"ر",2,0],["أَما في الثَلاثينَ اللَواتي تَصَرَّمَت","ذِمامٌ لِمَنكوبٍ تَوالَت نَوائِبُه",26,"ب",2,0],["أَما فيكمُ حُرٌّ إِذا قامَ داعياً","إِلى صالحٍ أَوفى فجاوَبَهُ حُرُّ",27,"ر",1,0],["أَما في كُربُحٍ وَنَوى لِقاطٍ","وَأَبعارٍ تُجَمِّعُها عَزاءُ",28,"ا",2,0],["أَما في الأَرضِ مِن رَجُلٍ لَبيبٍ","فَيَفرُقَ بَينَ إيمانٍ وَكُفرِ",29,"ر",1,0],["أَمّا فَواري المَينِ عَنكَ فَصادَفَت","سَمَعاً وَأَمّا الوَجدُ مِنكَ فَواري",30,"ر",2,0],["أما في دجاه من كواكِب لُمَّعٍ","فإن الدجى فيه الكواكِب تلمع",31,"ع",1,0],["أَما في بَني الأرض العَريضة قادرٌ","يخفف وَيلات الحَياة قَليلا",32,"ل",2,0],["أما في النّجوم السّائرات وغيرها","لعيني على ضوء الصّباح",33,"ح",1,0],["أما فيكِ بعدُ حياةٌ تُشَبُّ","أم فيكِ من جَذْوةٍ تُلْهَبُ",34,"ب",1,0],["أَمَّا فُؤَادُ فَهْوَ زَيْنُ شَبَابِهَا","وَفخَارِهَا فِي وَجْهِ كُلِّ مَفَاخِرِ",35,"ر",1,0],["أما في سطحه قد شُقَّ نهرٌ","ولا في أيْكه غنَّى هَزَار؟",36,"ر",1,0],["أمَا في نَبِيّ الله يوسفَ أُسْوَةٌ","لِمثلِكَ، محْبوساً على الظَّلمِْ وَالإفْكِ",37,"ك",1,0],["أما فؤادي فعند اله حسبته فقد","تقسمه الغر المباهيج",38,"ج",1,0],["إمّا فَزِعتُ إلى السُّلُوّ، فإنّني","مِنْ حُبّكُمْ بإزَاءِ شُغْلٍ شاغِلِ",39,"ل",1,0],["أَما في جلّقٍ خلّ صَديق","يُنبههُ الوداد فَيَستَفيق",40,"ق",1,1],["أما فتىً صادق الهوى كأخي","شكري يرد الزمان عن نوبه",41,"ب",2,0],["إمَّا فَررْتَ من العِدَى","أين الفرارُ من الردَى",42,"د",2,1],["أما في الذي أحكيه ما يبعث الشجا","ويكثر أشواق المحب المتيم",43,"م",1,0],["أما في رضى الرحمن عنكم إعاضة","لكم عن رضا زيد عليكم وعامر",44,"ر",1,0],["أما في مال ردفك من زكاة","فيدخل فيه لي هذا النصاب",45,"ب",1,0],["أما في الهوى العذري عذر لشيق","إذا لاح برق من تهامة أجهشا",46,"ش",2,0],["أما فضّها سبعين ألفاً بمجلس","فلم يبق منها درهم يتوقع",47,"ع",1,0],["إِمّا فَقيراً مُستَري","حاً أَو غَنِيّاً مُتعَبا",48,"ب",2,0],["أما في قلوبِ الناسِ للناس رحمةٌ","وتُرضِعهم أُمٌ ويجمَعُهم أَبُ",49,"ب",1,0],["أَما في بَني الدُنيا فَتىً مُتَدارِكٌ","حُشاشَةَ هَذا الفَضل مِن قبل أَن تَبلى",50,"ل",2,0],["أما فيكم فتى يرثي لصحوي","فيسقيني المشوم ولو خراه",51,"ا",2,0],["اما في الليالي عطفة تعكس النوى","فتنظمنا والشمل غير نظيم",52,"م",1,0],["أما في نفوسِ المسلمينَ حميةٌ","لتطهيرِ أحرامي وحفظِ الأمانة",53,"ه",1,0],["أَما فيه من كلِّ","عَيْنٍ سواد",54,"د",1,0],["أَما في كريم العهدِ والودّ شافعٌ","لذنبي إنّ الذنب يَمنع من ثربي",55,"ب",2,0],["أَما في جريِّ الرأيِ والعزمِ والحِجا","مِن الرفق ما يبقي على ذمّةِ الحبِّ",55,"ب",1,0],["أَما فَوقَها إِلّا نُجودٌ وَأَنَّهُم","وَما تَحتَها إِلّا تُرابٌ وَأَعظُمُ",56,"م",1,1],["أَمّا فِراقُكَ وَاللِقاءُ فَإِنَّ ذا","مِنهُ أَموتُ وذَاكَ مِنهُ أُبعَثُ",57,"ث",1,0],["أَما في ذلة الأَمجاد عَيب","عَلَيكَ وَلا بِهَون الحُرّ عار",58,"ر",1,0],["أما فيكُمُ من يستحي من إلهه","أما فيكُمُ من يرهب الخِزْيَ في غد",59,"د",1,0],["أما فيكم من راقب اللّه ساعة","وتاب فقد أفسدتم الأرض عن يد",59,"د",1,0],["أمّا في النّاسِ مُرتادٌ لِحمدٍ","وساعٍ في ثوابٍ أو لأجْرِ",60,"ر",1,1],["أَما فَضائلها عَلى أَترابِها","فَكَفضلِ حَيدَرَةٍ عَلى الحُكّامِ",61,"م",1,0],["أمَا في الهَوَى حاكِمٌ يَعدِلُ","ولا مَنْ يَكُفُّ ولاَ يَعذِلُ",62,"ل",1,1],["أَما فِي التَّخَيُّلِ منها ضِياءٌ","أَما فِي التَّنَشُّقِ منها شَمِيمُ",63,"م",1,0],["أمَا فِي حَشَاهُ مِن جوايَ مخايِلٌ","أَما فِي ذُرَاهُ من جُفُوني مَيَاسِمُ",64,"م",1,0],["أما في الحمى ضوء لمن جنه الليل","أما هضبة ترقى لمن دهم السيل",65,"ل",1,1],["أما فيكم للبث صيحة مشتك","إذا لم يكن مال لديكم ولا خيل",65,"ل",1,0],["أما في ملوك الخافقين ابنُ همَّةٍ","يكفُّ بميسورِ الكفاف عَنائي",66,"ا",2,0],["أما في الترهات لديك كفء","تجرده فمثلك لن يهابا",67,"ب",2,0],["أما في الدّهر معتَبر","ففيه الصفو والكدر",68,"ر",1,1],["أَما فِيكُمُ يا صَفْوَةَ الخَلْقِِ واحِدٌ","نَجِيٌّ بهِ يَجْزِي إلَهُ العَوالِمِ",69,"م",1,0],["أَما فِيه غُفْرانُ الذُّنوبِ جَميعِها","إذَا لَمْ يكُنْ شِرْكاً وذَاكَ هُوَ القُلُّ",70,"ل",1,0],["أما فيكم يا قوم للجمع قدرة","فما فيكموا والله من يجهل الأمرا",71,"ر",2,0],["أما في كتاب الله ما كان شافياً","وفي سنة المختار صفوة آدم",72,"م",1,0]]}