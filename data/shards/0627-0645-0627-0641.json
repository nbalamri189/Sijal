/poem/77152","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101367","الوافر"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36339","الدوبيت"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136905",""],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45149","الوافر"],[4376,"","https://poetry.dctabudhabi.ae/diwan/poem/131915","الوافر"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66108","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66107","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33489","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120498","الطويل"],[4679,"أأذنبَ في لونه الأسودُ","https://www.poetsgate.com/ViewPoem.aspx?id=142773",""],[4733,"إيلانُ عينُ العرب","https://www.poetsgate.com/ViewPoem.aspx?id=188652",""],[4762,"فراغ","https://www.poetsgate.com/ViewPoem.aspx?id=212918",""],[1901,"أما في الناس من رجلِ رشيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=160409",""],[5050,"أللمجد بالناس ينتظر السعدد","https://www.poetsgate.com/ViewPoem.aspx?id=38202",""],[5174,"أصول الضاد طيبة الأروم","https://www.poetsgate.com/ViewPoem.aspx?id=185484",""],[5183,"حد الطور","https://www.poetsgate.com/ViewPoem.aspx?id=186609",""],[5376,"يا زائرَ البيتِ لو حُمِّلت من مُقلِ","https://www.poetsgate.com/ViewPoem.aspx?id=188424",""],[5376,"أما في الدارِ أشواقٌ وشمسٌ","https://www.poetsgate.com/ViewPoem.aspx?id=188450",""],[5431,"زمانٌ لا يكفّ عن الخداع","https://www.poetsgate.com/ViewPoem.aspx?id=215980",""],[5516,"لا غفت عين","https://www.poetsgate.com/ViewPoem.aspx?id=213424",""],[5527,"قصيدة الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=180853",""],[5582,"أَلا حَيِّ مِنْ دارِ سُعْدَى مُقامَا","https://www.poetsgate.com/ViewPoem.aspx?id=63572",""],[5690,"لواؤك سيدي عبد الحميد","https://www.poetsgate.com/ViewPoem.aspx?id=172136",""],[5789,"ينابيع الغياب","https://www.poetsgate.com/ViewPoem.aspx?id=201411",""],[5829,"عوراتكم ظهرت","https://www.poetsgate.com/ViewPoem.aspx?id=195347",""],[5873,"غيث الوصل","https://www.poetsgate.com/ViewPoem.aspx?id=215780",""],[5943,"كَشَفَتْ غطاها","https://www.poetsgate.com/ViewPoem.aspx?id=34277",""],[5943,"ألا انتبهتا","https://www.poetsgate.com/ViewPoem.aspx?id=56465",""],[5956,"تخاطب حبيبها","https://www.poetsgate.com/ViewPoem.aspx?id=185180",""],[5956,"جمال السهوب وجمال الحقول","https://www.poetsgate.com/ViewPoem.aspx?id=192248",""],[6177,"رَجْعُ الغِياَب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79067&r=&rc=14",""],[6251,"مجرات النجوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76487&r=&rc=27",""],[6277,"والعلم في عمان أزياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64489&r=&rc=52",""]],"verses":[["إِمّا فَناءً عَنِ الدُنيا عَلى مَهَلٍ","أَوِ اِعتِباطاً يُغادي غُدوَةَ السَبُعِ",0,"ع",1,0],["أَما في هَذِهِ الدُنيا نَجيبٌ","يُساعِدُني عَلى حَربِ الدُهورِ",1,"ر",1,0],["إِمّا فَتىً نالَ العُلى فَاِشتَفى","أَو بَطَلٌ ذاقَ الرَدى فَاِستَراح",2,"ح",1,0],["إِمّا فَتىً ناضِرَ الصَبا كَأَخي","عِندي أَو زائِدَ المَدى كَأَبي",3,"ب",2,0],["أَما في بابِ خَيبَرَ مُعجِزاتٌ","تُصَدَّقُ أَو مُناجاةُ الحِبابِ",4,"ب",1,0],["أما في لئامِ النّاسِ مَندوحَةٌ لهُ","فحَتّامَ لا يَحْتاجُ غَيْرَ كِرامِ",5,"م",1,0],["أما فيكُما مِنْ هِزّةٍ أُمَويّةٍ","لأرْوَعَ في أسْرِ الصّبابَةِ عانِ",6,"ن",1,0],["أَما في حَقِّ حُرمَتِنا لَدَيكُم","وَحَقِّ إِخائِنا رَدُّ الجَوابِ",7,"ب",1,0],["أَما في نَسيمِ الريحِ عَرفٌ مُعَرَّفُ","لَنا هَل لِذاتِ الوَقفِ بِالجِزعِ مَوقِفُ",8,"ف",1,1],["أَمَا فِي عَصْرِنَا هَذَا فُحُولٌ","أعَادُوا رَوْعَةَ العَصْرِ العَظِيمِ",9,"م",1,0],["أمَا فِي البَرْقِ مَعْنىً غَيْرُ وَمْضٍ","بِلاَ أثَرٍ يُلَعْلِعُ فِي الغُيُومِ",9,"م",1,0],["أمَا فِي النُّورِ أَوْ فِي النَّارِ إلاَّ","ذُبَالٌ أَوْ ضِرَامٌ فِي هَشِيمِ",9,"م",1,0],["أَما في صُروفِ الدَهرِ أَن تَرجعَ النَوى","بِهِم وَيُدالَ القُربُ يَوماً مِنَ البُعدِ",10,"د",1,1],["أمَا في الزمان فتىً ماجدٌ","ينفِّسُ كربةَ مَكْرُوبِهِ",11,"ب",2,0],["أما فيهمُ راعٍ لحق نبيه","ولا خائفٌ من ربه يتحرجُ",12,"ج",1,0],["أما في ذاك عندك ما يعفّي","على ما بعد ذلك مِنْ خلالي",13,"ل",2,0],["أما في الطّوْل جمعك بين برّي","وتقريبي وقد وقعَ القبولُ",14,"ل",1,0],["أما في النّجوم السّائراتِ وغَيرِهَا","لِعَيْني عَلى ضَوْءِ الصّباحِ دَليلُ",15,"ل",1,0],["أَما في هَذِهِ الدُنيا كَريمُ","تَزولُ بِهِ عَنِ القَلبِ الهُمومُ",16,"م",1,1],["أَما في هَذِهِ الدُنيا مَكانٌ","يُسَرُّ بِأَهلِهِ الجارُ المُقيمُ",16,"م",1,0],["أما فيَّ أن أُسْتَوْدَعَ اليدَ منكمُ","فأحفظَها إنّ الأيادي ودائِعُ",17,"ع",1,0],["أَمّا فُؤادي فَعِندَ اللَهِ حِسبَتُهُ","فَقَد تَقَسَّمَهُ الغُرُّ المَباهيجُ",18,"ج",1,0],["إِمّا فَرَغتُ إِلى السُلُوِّ فَإِنَّني","مِن حُبِّكُم بِإِزاءِ شُغلٍ شاغِلِ",19,"ل",1,0],["أَما في بَني الجارودِ مِن رائِحٍ لَنا","كَما راحَ دُفّاعُ الفُراتِ المُثَلَّمُ",20,"م",1,0],["أَما فيكُمُ وَفدٌ وَلا فاتِكٌ بِهِ","فَماذا الَّذي تَرجونَ عِندَ العَظائِمِ",21,"م",1,0],["أما فتحتْ منهم بلاداً بلادُنا","بِزَعمهِمُ كُفراً على إِثرِهِ كُفرُ",22,"ر",1,0],["أَما فارَقَ الأَحبابَ قَبلي مُفارِقٌ","وَلا شَيَّعَ الأَظعانَ مِثلي بِواجِدِ",23,"د",1,0],["أمّا فلسطينُ الثكولُ فإِنَّها","تُطرِي صنيعَك والدُّموعُ سواكبُ",24,"ب",1,0],["أما في كتابِ الموتِ معنىً لباحثٍ","شَكَا خافياً منه وأنكر ظاهرا",25,"ر",2,0],["أَما في الثَلاثينَ اللَواتي تَصَرَّمَت","ذِمامٌ لِمَنكوبٍ تَوالَت نَوائِبُه",26,"ب",2,0],["أَما فيكمُ حُرٌّ إِذا قامَ داعياً","إِلى صالحٍ أَوفى فجاوَبَهُ حُرُّ",27,"ر",1,0],["أَما في كُربُحٍ وَنَوى لِقاطٍ","وَأَبعارٍ تُجَمِّعُها عَزاءُ",28,"ا",2,0],["أَما في الأَرضِ مِن رَجُلٍ لَبيبٍ","فَيَفرُقَ بَينَ إيمانٍ وَكُفرِ",29,"ر",1,0],["أَمّا فَواري المَينِ عَنكَ فَصادَفَت","سَمَعاً وَأَمّا الوَجدُ مِنكَ فَواري",30,"ر",2,0],["أما في دجاه من كواكِب لُمَّعٍ","فإن الدجى فيه الكواكِب تلمع",31,"ع",1,0],["أَما في بَني الأرض العَريضة قادرٌ","يخفف وَيلات الحَياة قَليلا",32,"ل",2,0],["أما في النّجوم السّائرات وغيرها","لعيني على ضوء الصّباح",33,"ح",1,0],["أما فيكِ بعدُ حياةٌ تُشَبُّ","أم فيكِ من جَذْوةٍ تُلْهَبُ",34,"ب",1,0],["أَمَّا فُؤَادُ فَهْوَ زَيْنُ شَبَابِهَا","وَفخَارِهَا فِي وَجْهِ كُلِّ مَفَاخِرِ",35,"ر",1,0],["أما في سطحه قد شُقَّ نهرٌ","ولا في أيْكه غنَّى هَزَار؟",36,"ر",1,0],["أما في عويل النائحات مذكر","أم النوح حولي والبكاء صفير",37,"ر",1,0],["أمَا في نَبِيّ الله يوسفَ أُسْوَةٌ","لِمثلِكَ، محْبوساً على الظَّلمِْ وَالإفْكِ",38,"ك",1,0],["أما فؤادي فعند اله حسبته فقد","تقسمه الغر المباهيج",39,"ج",1,0],["إمّا فَزِعتُ إلى السُّلُوّ، فإنّني","مِنْ حُبّكُمْ بإزَاءِ شُغْلٍ شاغِلِ",40,"ل",1,0],["أما في وصايا اللّه أنا سننتهي","وإن حياة تنتهي ستعود",41,"د",1,0],["أما في صروف الحادثات مواقف","لفكر لملقي السمع وهو شهيد",41,"د",1,0],["أَما في جلّقٍ خلّ صَديق","يُنبههُ الوداد فَيَستَفيق",42,"ق",1,1],["أما فتىً صادق الهوى كأخي","شكري يرد الزمان عن نوبه",43,"ب",2,0],["إمَّا فَررْتَ من العِدَى","أين الفرارُ من الردَى",44,"د",2,1],["أما في الذي أحكيه ما يبعث الشجا","ويكثر أشواق المحب المتيم",45,"م",1,0],["أما في رضى الرحمن عنكم إعاضة","لكم عن رضا زيد عليكم وعامر",46,"ر",1,0],["أما في مال ردفك من زكاة","فيدخل فيه لي هذا النصاب",47,"ب",1,0],["أما في الهوى العذري عذر لشيق","إذا لاح برق من تهامة أجهشا",48,"ش",2,0],["أما فضّها سبعين ألفاً بمجلس","فلم يبق منها درهم يتوقع",49,"ع",1,0],["إِمّا فَقيراً مُستَري","حاً أَو غَنِيّاً مُتعَبا",50,"ب",2,0],["أما في قلوبِ الناسِ للناس رحمةٌ","وتُرضِعهم أُمٌ ويجمَعُهم أَبُ",51,"ب",1,0],["أَما في بَني الدُنيا فَتىً مُتَدارِكٌ","حُشاشَةَ هَذا الفَضل مِن قبل أَن تَبلى",52,"ل",2,0],["أما فيكم فتى يرثي لصحوي","فيسقيني المشوم ولو خراه",53,"ا",2,0],["اما في الليالي عطفة تعكس النوى","فتنظمنا والشمل غير نظيم",54,"م",1,0],["أما في نفوسِ المسلمينَ حميةٌ","لتطهيرِ أحرامي وحفظِ الأمانة",55,"ه",1,0],["أَما فيه من كلِّ","عَيْنٍ سواد",56,"د",1,0],["أَما في كريم العهدِ والودّ شافعٌ","لذنبي إنّ الذنب يَمنع من ثربي",57,"ب",2,0],["أَما في جريِّ الرأيِ والعزمِ والحِجا","مِن الرفق ما يبقي على ذمّةِ الحبِّ",57,"ب",1,0],["أَما فَوقَها إِلّا نُجودٌ وَأَنَّهُم","وَما تَحتَها إِلّا تُرابٌ وَأَعظُمُ",58,"م",1,1],["أَمّا فِراقُكَ وَاللِقاءُ فَإِنَّ ذا","مِنهُ أَموتُ وذَاكَ مِنهُ أُبعَثُ",59,"ث",1,0],["أَما في ذلة الأَمجاد عَيب","عَلَيكَ وَلا بِهَون الحُرّ عار",60,"ر",1,0],["أما فيكُمُ من يستحي من إلهه","أما فيكُمُ من يرهب الخِزْيَ في غد",61,"د",1,0],["أما فيكم من راقب اللّه ساعة","وتاب فقد أفسدتم الأرض عن يد",61,"د",1,0],["أمّا في النّاسِ مُرتادٌ لِحمدٍ","وساعٍ في ثوابٍ أو لأجْرِ",62,"ر",1,1],["أَما فَضائلها عَلى أَترابِها","فَكَفضلِ حَيدَرَةٍ عَلى الحُكّامِ",63,"م",1,0],["أمَا في الهَوَى حاكِمٌ يَعدِلُ","ولا مَنْ يَكُفُّ ولاَ يَعذِلُ",64,"ل",1,1],["أَما فِي التَّخَيُّلِ منها ضِياءٌ","أَما فِي التَّنَشُّقِ منها شَمِيمُ",65,"م",1,0],["أمَا فِي حَشَاهُ مِن جوايَ مخايِلٌ","أَما فِي ذُرَاهُ من جُفُوني مَيَاسِمُ",66,"م",1,0],["أما في الحمى ضوء لمن جنه الليل","أما هضبة ترقى لمن دهم السيل",67,"ل",1,1],["أما فيكم للبث صيحة مشتك","إذا لم يكن مال لديكم ولا خيل",67,"ل",1,0],["أما في ملوك الخافقين ابنُ همَّةٍ","يكفُّ بميسورِ الكفاف عَنائي",68,"ا",2,0],["أما في الترهات لديك كفء","تجرده فمثلك لن يهابا",69,"ب",2,0],["أما في الدّهر معتَبر","ففيه الصفو والكدر",70,"ر",1,1],["أَما فِيكُمُ يا صَفْوَةَ الخَلْقِِ واحِدٌ","نَجِيٌّ بهِ يَجْزِي إلَهُ العَوالِمِ",71,"م",1,0],["أَما فِيه غُفْرانُ الذُّنوبِ جَميعِها","إذَا لَمْ يكُنْ شِرْكاً وذَاكَ هُوَ القُلُّ",72,"ل",1,0],["أما فيكم يا قوم للجمع قدرة","فما فيكموا والله من يجهل الأمرا",73,"ر",2,0],["أما في كتاب الله ما كان شافياً","وفي سنة المختار صفوة آدم",74,"م",1,0],["أَما فَفَظ الأَيّامَ مِنّي وَقيعَةُ","وَتَغضَبُ مِنّي مِثلَما أَنا أَغضَبُ",75,"ب",1,0],["أَما في دُجى الخَطبِ المُخَيِّمِ حاجِبٌ","لِكُلِّ مُنيرٍ أَن يُضيءَ وَيَسطَعا",76,"ع",2,0],["أما فتحَ الحصنَ المَشيدَ بناؤُّهُ","وقد كاعَ عنه قبل ذلك تُبَّعُ",77,"ع",1,0],["أما في بياض الشيب حلم لا حمق","به يتلافى من لياليه ما بقي",78,"ق",2,1],["أَما فيكُم يا أَهل مصر كَغيركم","نَصير يُرجَّى للقا وَالعَزائم",79,"م",1,0],["أَما فيهِ إِحساس إِذا كانَ فاضِلاً","أَما هُوَ مِن ماءٍ كَما الناس دافق",80,"ق",1,0],["أَما في ثَلاثٍ بَعدَ عشرينَ حِجَّةً","غَنى لغويٍّ آن أَن يترشّدا",81,"د",2,0],["أما فيهٍ منْ كُلِّ عينٍ سوادْ","ومن دمِ كُلِّ شَهيدٍ مِداد",82,"د",1,0],["أَما فيهِ قَد نالَ المُحِبّونَ رِفعَةً","أَما عَلَتِ الأَشياخ يا غمرُ بِالحبِّ",83,"ب",1,0],["أما فيكما من مُسعِدٍ لمتيم","بعيدِ التلاقي هامل الدمع هامعِ",84,"ع",1,0],[