 المرسلين","https://www.poetsgate.com/ViewPoem.aspx?id=192611",""],[5956,"المصائب الراتعة من ممارسات الأطباء الغبية المائعة","https://www.poetsgate.com/ViewPoem.aspx?id=193100",""],[5956,"لله در رؤى","https://www.poetsgate.com/ViewPoem.aspx?id=193105",""],[5956,"بإذن الله في الكنانة سأبقى","https://www.poetsgate.com/ViewPoem.aspx?id=193342",""],[5956,"إني أمين مثل والدكم","https://www.poetsgate.com/ViewPoem.aspx?id=193690",""],[5956,"إخلاصه الجم يسقي حقل موهبتي","https://www.poetsgate.com/ViewPoem.aspx?id=193723",""],[5956,"ما جاء لي من أي ضَوءٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193825",""],[6019,"بمناسبة ميلاد ابنت اختي ( مريم )","https://www.poetsgate.com/ViewPoem.aspx?id=200579",""],[6035,"متى أردتمُ رفعَ الثوب تَمْتَثِلُ !","https://www.poetsgate.com/ViewPoem.aspx?id=177094",""],[161,"ربيعَا للأمة زَعَمُوا !","https://www.poetsgate.com/ViewPoem.aspx?id=211185",""],[6070,"ليلة مع يتيم الشوارع","https://www.poetsgate.com/ViewPoem.aspx?id=188468",""],[6082,"كنّا صغارا","https://www.poetsgate.com/ViewPoem.aspx?id=61277",""],[6090,"قدمت فليهن فيك المجد والجود","https://www.poetsgate.com/ViewPoem.aspx?id=170911",""],[6127,"شاخت عروقك","https://www.poetsgate.com/ViewPoem.aspx?id=202361",""],[6127,"يا ثورة الآس","https://www.poetsgate.com/ViewPoem.aspx?id=205889",""],[6142,"سل كربلا والوغى والبيض والأسلا","https://www.poetsgate.com/ViewPoem.aspx?id=155747",""],[6145,"ياسين طِبْ نفسا","https://www.poetsgate.com/ViewPoem.aspx?id=7802",""],[6189,"نبوءة العمائم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83598&r=&rc=65",""],[6213,"شجون عاتية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85497&r=&rc=100",""],[6213,"إشراقة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79027&r=&rc=69",""],[6240,"حينما تأتينَ يا أمّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87018&r=&rc=2",""],[6253,"بيروت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6419&r=&rc=2",""],[6262,"العائد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80128&r=&rc=26",""],[6315,"البَيدَاءُ وَ الجَنِينُ المُرتَقَب ... تَحِيَّتَانِ للأُنثَى !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87577&r=&rc=2",""]],"verses":[["تَأْتِي عَلَى قَدَرٍ فَيَخْلُفُ بَعْضُهَا","بَعْضَاً كَمَا خَلَفَ السَّحَابَ سَحَابُ",0,"ب",1,0],["تَأتي الرَزايا نِظاماً مِن حَوادِثِها","إِذِ الفَوائِدُ في أَثنائِها لُمَعُ",1,"ع",1,0],["تَأَتّى لِإِلطافِ تَدريجِها","فَمِن حَرِّ شَمسٍ إِلى بَردِ ظِلّ",2,"ل",1,0],["تأتيك ريشته بشعر صامت","ولقد يفوق الشاعر المِنْطيقا",3,"ق",2,0],["تأتي علينا مشاهدات","نروح منهنّ في مراء",4,"ا",2,0],["تَأتي الغَرِيَّ بِأَيديها وَأَرجُلِها","كَأَنَّهُنَّ نَعامُ القَفرَةِ النادي",5,"د",2,0],["تأتي على أبلق ألحاظ مقلته","فهنَّ بيضٌ وفي أحشائنا سود",6,"د",1,0],["تأتي هباتك كالسيول لنا ولا","عجبٌ لسيلٍ حين يأتي من عل",7,"ل",1,0],["تأتَّتْ أكفُّ القاطفين قِطافَها","فسالت بلا عَصْرٍ ودَرَّت بلا عَصْبِ",8,"ب",1,0],["تأتَّتْ لكم فيه مُنَى السوء هَيْنَةً","وذاك لكم بالغيِّ أغرى وألهجُ",9,"ج",1,0],["تَأتّى فيهِ إسجاحاً","بلا كَدٍّ ولا كدحِ",10,"ح",1,0],["تأتيك آبدةٌ منها فآبدةٌ","تتابع الموج خلف الموج تحتفِز",11,"ز",1,0],["تأتي من الشعر في هجائك بال","وخش كما أنت وخش أوخاش",12,"ش",1,0],["تأتَّتْ معاني المدح فيه كأنما","عليها بإسعافِ القوافي شرائط",13,"ط",1,0],["تأتي الأمورَ وتتقي إتيانها","طَبَّاً بما تأتي وتترك عالما",14,"م",2,0],["تأتِى على القمرِ السَّاري حوادثه","حتى يُرى ناحلاً في شخص عُرجون",15,"ن",1,0],["تأتي الذي تأتي به متطبعاً","اما سواك فانه يتكلف",16,"ف",1,0],["تَأتي الدَلالَ سَجِيَّةً وَتَصَنُّعاً","وَأَراكَ في حالَي دَلالِكَ مُبدِعا",17,"ع",2,1],["تَأتي بِما سَبَتِ الخُيولُ كَأَنَّها","تَحتَ الحِسانِ مَرابِضُ الغِزلانِ",18,"ن",1,0],["تَأَتَّيتَهُ حَتّى تَبَيَّنَ رُشدَهُ","وَحَتّى اِكتَفى بِالكُتبِ دونَ الكَتائِبِ",19,"ب",1,0],["تَأَتَّ في رَسمِيَ الجاري بِعارِفَةٍ","كَما تَأَتَّيتَ لي في رِزقِيَ الجارِ",20,"ر",1,0],["تَأتِ مِن شَخصِ ما تُنيلُ فَما مِن","حاجَتي أَن يَطولَ جودُكَ شِعري",21,"ر",2,0],["تَأَتَّ لِمَوتورٍ بَدا لَكَ ضِغنُهُ","فَإِنَّ الحِجابَ عِندَ ذي خَطَرٍ وِترُ",22,"ر",1,0],["تَأتي قُرومُ أَبي العاصي إِذا صَرَفَت","أَنيابُها حَولَ سامٍ رَأسُهُ قَطَمِ",23,"م",1,0],["تَأتي الخُطوبُ وَأَنتَ مُنتَبِهٌ لَهَا","فَإِذا مَضَت فَكَأَنَّها أَحلامُ",24,"م",1,0],["تَأتيهِ فُرّاطُنا فَتَحكُمُ في","لُجَينِهِ تارَةً وَفي ذَهَبِه",25,"ب",2,0],["تَأْتِي الشُّهُورُ وَتَنْتَهِي سَاعَاتُهَا","لَمْعَ السَّرَابِ وَتَنْقَضِي الأَعْوَامُ",26,"م",1,0],["تَأْتِي الشُّهُورُ وَتَنْتَهِي أَيَّامُهَا","لَمْعَ السَّرَابِ وَتَنْقَضِي الأَعْوَامُ",27,"م",1,0],["تَأتي صُقورٌ مِنهُمُ مُنقَضَّةٌ","قَدَراً عَلى مُهَجِ العَدُوِّ مُتاحا",28,"ح",2,0],["تأتي فتعثرُ بالطُّبولِ وربّما","عثرت بها وبركبكَ الأبواقُ",29,"ق",1,0],["تَأتي التَجارِبُ تَستَشيرُ ذَكاءَهُ","مَهما اِستَشارَ الأَذكِياءُ مُجَرَّبا",30,"ب",2,0],["تأتيه مِنْ بيْع البلادِ","وما إليه من الخساسه",31,"ه",1,0],["تأتي السماءَ حفيّةً","فتحلّ جنَّتَها العليَّهْ",32,"ي",2,0],["تأتي له خَلفَ الخُطوبِ عزائِمٌ","تُذكَى لها خلفَ الصّباحِ مشاعل",33,"ل",1,0],["تأتي الوُفُودُ بها فلا تَكرارُهَا","نَصَبٌ ولا مقرونُهَا مملول",34,"ل",1,0],["تأتي عطاياه شتّى غيرَ واحِدَةٍ","كما تَدافَعَ موجُ البحرِ يَصْطفِق",35,"ق",1,0],["تأتي الليالي دونَها ولها","في العُقْر مجدٌ ليس يَنعقر",36,"ر",1,0],["تَأتيكَ في نافِضِ الحُمّى مَكارِمُهُ","وَإِن أَفاقَ بَدا في وَجهِهِ اللومُ",37,"م",1,0],["تَأتيكِ نازِحَةً مَناسِبُهُ","وَيَحوطُ غَيبَكُمُ وَإِن غَضِبا",38,"ب",2,0],["تَأتي المُقيمَ وَما سَعى حاجاتُهُ","عَدَدَ الحَصى وَيَخيبُ سَعيُ الخائِبِ",39,"ب",1,0],["تأتي لخفرك بعد عشر دقائق","منهم كهولٌ لا تني وَشباب",40,"ب",1,0],["تأَتي الكوارِث يتّبعن كوارثاً","فتلمُّ بالإنسان وَالحَيوان",41,"ن",1,0],["تأَتي المحافل محفوفاً بتكرمة","والعلم يرجع مطروداً إلى العقب",42,"ب",1,0],["تأَتي القطيع معجلاً","عند الظَلام ولا تريث",43,"ث",1,0],["تأَتي وَتَذهَب ثُمَّ تأ","تي بعد حينٍ لازديار",44,"ر",1,0],["تَأْتِي بِهَا فَوْقَ الْبِحَارِ سَفَائِنٌ","كَالْجِنِّ في جِدِّ الْعَوَاصِفِ تَلْعَبُ",45,"ب",1,0],["تَأَتِّى وَالعُرُوبَةُ فِي نُشُورٍ","فَجَاءَ البَاعِثَانِ عَلى وِفَاقِ",46,"ق",1,0],["تأتي السلامة والاسواء محدقة","ويهلك المرء والأسواء لم تكن",47,"ن",1,0],["تأتي المكاره أقواما لخيرتهم","من حيث علمهم أو حيث ما علموا",48,"م",3,0],["تأتي السعادة ُ إلا أَن تُسايِرَهم","لأنهم لموكِ الأرضِ ضيفان",49,"ن",1,0],["تاتي بسحر يميل الناظرين لها","ينحط هاروت عن هذا وماروت",50,"ت",1,0],["تَأتِيهِ لَيلاً فَرَادَى كَى يَنَالَ لِمَا","يَهوَى وتأتِي نَهَاراً وهيَ مُلتَئِمَه",51,"م",2,0],["تأتي جيادي في الرَّهان سوابقا","وجيادُ غيري في الرعيلِ العاشرِ",52,"ر",1,0],["تَأتَمُّ مَلكاً بِالعَواصِمِ بَحرُهُ","عَذبُ المِياهِ وَظِلُّهُ مَمدودُ",53,"د",1,0],["تَأتيكَ طائِعَةً إِذا اِستَدعَيتَها","وَلَها إِذا لَم تَدعُها تَطفيلُ",54,"ل",1,0],["تَأتِي المَنَايا إِلَى أَسْيافِهِ فِرَقاً","كَأَنَّمَا تَجْتَدِي مِنْ خَوْفِهِ سَلَمَا",55,"م",2,0],["تَأتِي قُبَيلَ لِقَاءِ اللهِ خَالِصَةً","كَمَا أَتَى رَبَّهُ مُوسىَ عَلَى قَدَرِ",56,"ر",1,0],["تَأَتيهِ أَسلابُ الأَعِزَّةِ عَنوَةً","قَسراً وَيَجمَعُ لِلحُروبِ عَتادَها",57,"د",3,0],["تأتِي صدودَك عامداً","متعرِّضاً متمرِّضا",58,"ض",2,0],["تَأتي عَلَيكَ نَسيمُ القُربِ مَهدِيَّةً","عَرَفَ الجَمالُ كَعُرفُ المَندَلِ العَطِرِ",59,"ر",1,0],["تأتي وقد ضاقت بكم أرجاؤها","وتعود لما تقفر الأرجاءُ",60,"ا",2,0],["تَأتي وَتَرجِعُ لا تَلوي عَلى عِجلِ","وَلَم تَقسِني بِدُوارِ سَتَبنيهِ",61,"ي",2,0],["تَأْتِي على النّاسِ لا تُلوي على أَحَدٍ","حتى أَتَتْنَا وَكَانَتْ دُونَنَا مُضَرُ",62,"ر",1,0],["تَأْتي طِلاعَ الفَلا من كلِّ ناجيةٍ","عَنْسٍ إذا صَعِد الحادي بها هَبطا",63,"ط",2,0],["تَأتيكَ أَيّامُها","في العِزِّ ذاتَ اطِّراد",64,"د",1,0],["تَأتي عَطاياهُ الجَميلَةُ جُملَةً","وَتَجيءُ مِن غُرِّ الثَناءِ بِمُجمَلِ",65,"ل",1,0],["تأتي بِعجزٍ ظاهرٍ عن","ها وعُذرٍ غير ظاهِر",66,"ر",1,0],["تأتي أخيراً بإبنٍ جلَّ قدرتُه","لِوَفده رُفِعَت روسٌ وأبصار",67,"ر",1,0],["تأتي القوافي طائعات له","تُعَدُّ في الجملة من وفده",68,"د",2,0],["تأتي كسَيْل المزن حيث دعوتها","وكجُودِ كفّك وافرٌ مدرارها",69,"ر",3,0],["تأتي النوائبُ عن عمدو عن عرضٍ","فيه ولكنَّ إقبال الصفا عرض",70,"ض",1,0],["تأتيك كُثْراً أُولَى كتابيَّةٍ","في الحسن والمنجباتُ أقرانُ",71,"ن",1,0],["تأتيه بالأعياد راكبةً","منها ظهورَ الشُّهب والدّهْمِ",72,"م",1,0],["تأتي وما أنصبني تطاوُلٌ","لها ولا عذَّبني انتظارُها",73,"ر",3,0],["تأتيك بشرى ما تسو","د أبداً وتسعَدُ",74,"د",1,0],["تأتيهِ منبسطاً كأَنك عاتبٌ","ويجود معتذراً كأن قد أذبنا",75,"ب",3,0],["تأتي منقَّحةَ الكلامِ شريفةً","من خاطرٍ سهلِ القيادِ شريفِ",76,"ف",1,0],["تأتي عليها المنون","ولا تريد انفصالا",77,"ل",2,0],["تأتي به فرق اليدي","ن لربها تتخضع",78,"ع",1,0],["تأتّيْتُها والنّسرُ في الأفْقِ واقعٌ","وبيضُ حَمامِ الأنجُمِ الزُهْرِ تُرجَمُ",79,"م",1,0],["تأتّيْتُها في الليلِ كالصّقْرِ كاسِراً","وقد خفَقَتْ في الجنْحِ أجنحةُ النّسْرِ",80,"ر",1,0],["تأتي إليهم عطاياه مكررة","حسن العوارف ترداد وتكرار",81,"ر",1,0],["تأتي الأمور وقد سطرتم ذكرها","فيكون بعد حديثكم حدثانها",82,"ن",3,0],["تَأتي عَلى هَفَواتِهِ عَن قُدرَةٍ","بَدَراتُ راجِحِ حِلمِكَ المُستَأسِدِ",83,"د",1,0],["تَأتى عَطاياهُ شَتّى غَيرَ واحِدَةٍ","مُؤَمِّليهِ وَإِن كانوا عَلى بَعدِ",84,"د",1,0],["تَأتي البُدورُ فَتُفنيها صَنائِعُهُ","وَما يُدَنَّسُ فيها كَفُّ مُنتَقِدِ",84,"د",1,0],["تأتي الأنام بلام في القيامة من","تُقى وهذا الذي يأتي بلامين",85,"ن",1,0],["تأتي نَفائِسُهُ إليَّ سَوابقاً","وهُوَ الذي في كلِّ فضلٍ يَسبُقُ",86,"ق",1,0],["تَأتي النَفائِسُ مِنكَ لا مَطروقَةً","مِن دُونِهِنَّ الدِّرهَمُ المَطروقُ",87,"ق",1,0],["تأْتي حَمَاةَ وتَشْتكي كَدَراً","أَوَ مَا عَلِمْتَ بِأَنَّها كَدَرُ",88,"ر",1,0],["تأْتِي ويأْتِي السرورُ يَتْبَعُها","كأَنَّهُ واقِفٌ عَلى البَابِ",89,"ب",1,0],["تأتي إِليَّ على وعدٍ نوائِبُهُ","وطالما طرَقتني لا بمِيعَاد",90,"د",1,0],["تأْتِي ملوكُ الأَرضِ أَبوابَه","لترتَوِي مِنْ عِلمه الجمِّ",91,"م",1,0],["تأتي الملوكُ لبابه زُمراً","فجمِيعُهم يردُون مَنْهَلها",92,"ل",3,0],["تأتي لَهُ فيحِلُّ مُشْكِلَها","ببيانه ويكُفُّ مُعْضِلَها",92,"ل",3,0],["تَأْتِي إِليه الملوكُ وافدةً","ومن لها لَوْلَهُ يَكُونُ ندَىَ",93,"د",2,0],["تأْتي الملوكُ إِليه تر","جُوه من ضَلاَلتِها رَشَاده",94,"د",2,0],["تَأْتِي الملوكُ إِلى أَبْوابِه زُمَراً","ويَدخُلون عَلى أَبْوابِه سُجُدَا",95,"د",2,0],["تأْتي مِنَ البَلد البعي","دِ إِلَيْه بالأَملِ الفَسيح",96,"ح",1,0],["تأْتيه خاشعةَ الوُجو","ه لَديهِ خاضِعَةَ الرِّقَابِ",97,"ب",1,0],["تَأتي سِواهُ فَتَسمو فَوق