{"poems":[[35,"لعزة أطلال أبت أن تكلما","https://www.aldiwan.net/poem39090.html","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43727","المتقارب"],[90,"ثورة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=179144",""],[268,"يا دار أزهر حولك الورد","https://www.aldiwan.net/poem35667.html","أحذ الكامل"],[556,"طرف الذي طلب التحقيق سهران","https://www.aldiwan.net/poem33823.html","البسيط"],[561,"حمدنا الله ذا العرش المجيد","https://www.aldiwan.net/poem13602.html","الوافر"]],"verses":[["وَكَظَّت سِوارَيها فَلا يَألُوانِها","لَدُن جاوَرا الكَفَّينِ أَن يَتَقَدَّما",0,"م",2,0],["وَكَظتَ عَلى الذِكرِ حَتّى يُقا","ل لِلَّهِ دَرُّكُ ما أَوكَظا",1,"ظ",2,0],["وكَظْمُ الفتى غيظاً على ما يسوؤه","من الأمر دربٌ عبَّدته الأماثل",2,"ل",1,0],["وكظلِّ مورقةِ الغصونِ غدا","ظلٌّ النعيمِ عليك يمتدُّ",3,"د",1,0],["وكظم غيظٍ وعفوٌ والخشوع كذا","رفق وصدق وما تبديه فتيان",4,"ن",1,0],["وَكَظمِ الغَيظِ وَالشَحنا وَنُصحٍ","لِأَهلِ الحَقِّ في رَأيٍ سَديدِ",5,"د",1,0]]}