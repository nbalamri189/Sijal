{"poems":[[37,"لعزة أطلال أبت أن تكلما","https://www.aldiwan.net/poem39090.html","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43727","المتقارب"],[92,"ثورة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=179144",""],[275,"يا دار أزهر حولك الورد","https://www.aldiwan.net/poem35667.html","أحذ الكامل"],[563,"طرف الذي طلب التحقيق سهران","https://www.aldiwan.net/poem33823.html","البسيط"],[568,"حمدنا الله ذا العرش المجيد","https://www.aldiwan.net/poem13602.html","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38585","الوافر"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79985","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79861","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49552","الخفيف"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87713","الكامل"],[3181,"","https://poetry.dctabudhabi.ae/diwan/poem/105093","الكامل"],[5302,"سأمضي","https://www.poetsgate.com/ViewPoem.aspx?id=200676",""],[5725,"افلت شموس","https://www.poetsgate.com/ViewPoem.aspx?id=181255",""]],"verses":[["وَكَظَّت سِوارَيها فَلا يَألُوانِها","لَدُن جاوَرا الكَفَّينِ أَن يَتَقَدَّما",0,"م",2,0],["وَكَظتَ عَلى الذِكرِ حَتّى يُقا","ل لِلَّهِ دَرُّكُ ما أَوكَظا",1,"ظ",2,0],["وكَظْمُ الفتى غيظاً على ما يسوؤه","من الأمر دربٌ عبَّدته الأماثل",2,"ل",1,0],["وكظلِّ مورقةِ الغصونِ غدا","ظلٌّ النعيمِ عليك يمتدُّ",3,"د",1,0],["وكظم غيظٍ وعفوٌ والخشوع كذا","رفق وصدق وما تبديه فتيان",4,"ن",1,0],["وَكَظمِ الغَيظِ وَالشَحنا وَنُصحٍ","لِأَهلِ الحَقِّ في رَأيٍ سَديدِ",5,"د",1,0],["وَكَظمُ الغَيظِ مَع عَفوٍ وَجودٍ","هوَ المَمدوحُ في خَيرِ الكلامِ",6,"م",1,0],["وكظيماً للحزن يطوي حشاه","جلداً فوق زفرةٍ خرساء",7,"ا",2,0],["وكظمتُ أنفاسي الغداةَ وفوقَها","كادت مجامعُ أضلعي تتفرَّقُ",8,"ق",1,0],["وكظيمٍ قد نفَّسَ الكربَ عنه","ضَحِكٌ في بُكائِهِ المُتَمادِي",9,"د",2,0],["وَكَظمت غَيظاً ملءَ حَنجَرَتي","وَالغَيظ بِكَظمِهِ الفَتى الحرُّ",10,"ر",1,0],["وكظمت غيظك لا تبث شكاية","وصبرت منطويا على الآلام",11,"م",1,0],["وكظم الغيظ بين الناس فن","وليس يجيده إلا القليل",12,"ل",1,0],["وكظّل كاسٍ لا يملّ شرابها","فاحت كانفاس الظباء عواتكا",13,"ك",2,0]]}