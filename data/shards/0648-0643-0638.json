{"poems":[[35,"لعزة أطلال أبت أن تكلما","https://www.aldiwan.net/poem39090.html","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43727","المتقارب"],[90,"ثورة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=179144",""]],"verses":[["وَكَظَّت سِوارَيها فَلا يَألُوانِها","لَدُن جاوَرا الكَفَّينِ أَن يَتَقَدَّما",0,"م",2,0],["وَكَظتَ عَلى الذِكرِ حَتّى يُقا","ل لِلَّهِ دَرُّكُ ما أَوكَظا",1,"ظ",2,0],["وكَظْمُ الفتى غيظاً على ما يسوؤه","من الأمر دربٌ عبَّدته الأماثل",2,"ل",1,0]]}