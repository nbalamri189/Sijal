,"الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108689","الكامل"],[1660,"","https://poetry.dctabudhabi.ae/diwan/poem/72170","البسيط"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127971","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127955","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100958","البسيط"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96029","البسيط"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100896","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132672","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100722","البسيط"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99374","البسيط"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52983","الكامل"],[3508,"","https://poetry.dctabudhabi.ae/diwan/poem/20536","السريع"],[3574,"","https://poetry.dctabudhabi.ae/diwan/poem/188175","الرجز"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45781","البسيط"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45747","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205922","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85045","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59515","الكامل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35600","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77068","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81683","الكامل"],[4886,"لله كم من هضبةٍ وجبلِ","https://www.poetsgate.com/ViewPoem.aspx?id=170308",""],[4984,"عيد الشجرة","https://www.poetsgate.com/ViewPoem.aspx?id=180037",""],[4119,"كم لي بأنطاكية من هوى","https://www.poetsgate.com/ViewPoem.aspx?id=16190",""],[5055,"المعلم","https://www.poetsgate.com/ViewPoem.aspx?id=102729",""],[5092,"القدسُ صوتُ الحق","https://www.poetsgate.com/ViewPoem.aspx?id=176452",""],[308,"يَا فَاضلا كرمت فِينَا سجاياه","https://www.poetsgate.com/ViewPoem.aspx?id=190382",""],[5546,"أرخ لها زمامها والأنسعا","https://www.poetsgate.com/ViewPoem.aspx?id=181006",""],[5581,"أنذار","https://www.poetsgate.com/ViewPoem.aspx?id=22501",""],[5595,"دُمْ في عُلاكَ مُعلّماً كلَّ الورى","https://www.poetsgate.com/ViewPoem.aspx?id=144653",""],[5648,"الزمان الشين","https://www.poetsgate.com/ViewPoem.aspx?id=156245",""],[5776,"البُرْدَةُ اليَمَانِيِّة","https://www.poetsgate.com/ViewPoem.aspx?id=199543",""],[6196,"موعدُ العمرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83044&r=&rc=0",""],[6259,"حُييتما من دمنتي طللينِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59406&r=&rc=54",""]],"verses":[["مِن كُلِّ بَيضاءَ لَم تَخطُر عَلى خَلَدي","مِنَ الأَيادي وَلَم تَبلُغ إِلى أَمَلي",0,"ل",2,0],["مِنْ كُلِّ بَلْهاءِ التّثَنّي إنْ مَشَتْ","حَسِبْتَها منْ كَسَلٍ نَشْوى الخُطا",1,"ا",1,0],["مِنْ كُلِّ بَيْضاءَ مَصقولٍ تَرائِبُها","مَقسومَةِ العَهْدِ بينَ الغَدْرِ والمَلَلِ",2,"ل",1,0],["مِنْ كُلِّ بَرْقٍ بِالأَهِلَّةِ مُسْرَجٍ","قَيْدِ الأَوَابِدِ بِالثُّرَيَّا مُلْجَمِ",3,"م",1,0],["منْ كلّ بدْرِ دُجىً وشمْسِ ظَهيرةٍ","وغمامٍ جودٍ لا يَني مِدْرارُهُ",4,"ر",2,0],["مِن كُلِّ بَيضاءَ مَمكورَةٍ","لَها بَشَرٌ ناصِعٌ كَاللَبَن",5,"ن",1,0],["من كل برق بالثريا ملجمٍ","بالبدر يُسرج والأهلّةِ ينعلُ",6,"ل",1,0],["من كلِّ بحرٍ قريضٍ أنت وارده","تجلو على الناس أنواعاً من الدُّرر",7,"ر",1,0],["من كل بيضاءَ يُحبُّ الفتى","أن يجعلَ الكفَّ لها مركبا",8,"ب",2,0],["من كل بيضاء ما في وصلها طمع","لطامع بل رجاء غير مقطوع",9,"ع",1,0],["مِن كُلِّ بَيضاءَ مِكسالٍ بَرَهرَهَةٍ","زانَت مَعاطِلَها بِالدُرِّ وَالذَهَبِ",10,"ب",1,0],["مِن كُلِّ بَذّاءَ في البُردَينِ يَشغَلُها","عَن مِهنَةِ الحَيِّ تَرحيلٌ وَعُلّامُ",11,"م",1,1],["من كل بادية الضلوع غليلةٍ","والماء في أحشائها ملواح",12,"ح",1,0],["مِن كُلِّ بَيضاءَ أَو سَمراءَ زُيِّنَتا","لِلعَينِ وَالحُسنُ في الآرامِ كَالعُصُمِ",13,"م",1,0],["مِن كُلِّ بانٍ بِالمَنِيَّةِ في الصِبا","لَم يَتَّخِذ عِرساً سِوى الهَيجاءِ",14,"ا",2,0],["مِن كُلِّ بَيتٍ كَآيِ اللَهِ تَسكُنُهُ","حَقيقَةٌ مِن خَيالِ الشِعرِ غَرّاءُ",15,"ا",2,0],["مِن كُلِّ بَحرٍ في الشَريعَةِ زاخِرٍ","وَيُريكَهُ الخُلُقُ العَظيمُ غَضَنفَرا",16,"ر",2,0],["مِن كُلِّ بَلقيسٍ عَلى","كُرسِيِّ عِزَّتِها الوَثير",17,"ر",1,0],["من كلِّ بيتٍ لو تَجَسَّمَ لَفظُه","لرأيتَه وَشْياً عليكَ مُفوَّفا",18,"ف",2,0],["من كلّ برقٍ له بالقَرْعِ صاعقةٌ","على الأعادي بِضْربِ القَطرِ منه رمى",19,"م",2,0],["مِن كُلّ بيضاءِ الترائبِ غادةٍ","تمشي كَغُصْنِ البانَةِ الميّادِ",20,"د",1,0],["مِن كُلِّ بَيتٍ يَكادُ المَيتُ يَفهَمُهُ","حُسناً وَيَحسُدُهُ القِرطاسُ وَالقَلَمُ",21,"م",1,0],["مِن كُلِّ بَيتٍ لَو تَدَفَّقَ طَبعُهُ","ماءً لَغَصَّ بِهِ الفَضاءُ مَسيلا",22,"ل",2,0],["مِن كُلِّ بِطريقٍ لِبِط","ريقٍ نَقِيِّ الوَجهِ واضِح",23,"ح",1,0],["مِنْ كُلِّ بَدَّاءَ في البُرْدَيْنِ يَشْغَلُهَا","عَنْ حَاجَةِ الحَيِّ عُلاَّمٌ وتَحْجِيلُ",24,"ل",1,0],["من كلِّ بيتٍ مشرِق","يُزرى بقصر اللابرنْتْ",25,"ت",1,0],["مِنْ كُلِّ بَيْتٍ إِذَا الإِنْشَادُ سَيَّرَهُ","فَلَيْسَ يَمْنَعُهُ سَهْلٌ وَلا جَبَلُ",26,"ل",1,0],["مِنْ كُلِّ بَارِعَةِ الْجَمَالِ يُرَى بِهَا","شَبَهٌ لِبَعْضِ خِلاَلِكِ الحَسْنَاءِ",27,"ا",2,0],["مِنْ كُلِّ بَيْضاءِ الطُّلَى طَفْلَةٍ","أَسْطَعَ مِنْ بَدْرِ الدجَى مَطْلَعا",28,"ع",2,0],["مِنْ كُلِّ بَيْضَاءِ الطلَى","مَهْضُومَةِ الْكَشْحيْنِ رُودِ",29,"د",1,0],["من كلِّ بيتٍ في السُّها شرفاته","تتلألأ الأضواءُ في أركانه",30,"ن",2,0],["من كلِّ بيتٍ يشُجُّ الرأسَ مُنشدُه","كأن مُنشدَه بالبيت قد حصبا",31,"ب",2,0],["من كلِّ باذلِ نفسِه، أو مالِه","للنيل، مقتنعٍ بعيشِ كَفَاف",32,"ف",1,0],["من كل بض الجسم تمنع","ها الروادفُ أن تقومَا",33,"م",2,0],["مِن كُلِّ بَهكَنَةٍ يَجُولُ وشاحُها","عَن خَصرِهَا وَالخَصرُ لَيسَ بجائلِ",34,"ل",1,0],["مَن كُلِّ بَيضاءَ لَم يَسفَع عَوارِضَها","مِنَ المَعيشَةِ تَبريحٌ وَلا أَزَفُ",35,"ف",1,0],["من كل بيت بديع معنى","مشيد بالطباق آهل",36,"ل",1,0],["من كُلّ بسّام الحَبابِ كأنّه","ثغرُ الحَبيبِ وريقهُ المُسْتَعذَبُ",37,"ب",1,0],["من كل بر تقي زاهد ورع","له إلى اللَه سير ليس بألواني",38,"ن",2,0],["من كل بر موقن","متوقر عند الغير",39,"ر",1,0],["مِن كلّ بيتٍ إن عُزي لمشيدهِ","أَضحى كبيتِ سميّه يستكبرُ",40,"ر",1,0],["مِن كُلِّ بِرٍّ عاجِلٍ وَمَعونَةٍ","وَسَدادَ عَوزٍ وَاِكتِسابٍ مَليحِ",41,"ح",1,0],["مِن كُلِّ بَيْتٍ جَعْفَرِيٍّ سَادَهُ","كالجَعفرِيِّ وَمَا بَنَى لَمْ يُنقَضِ",42,"ض",1,0],["من كلِّ بيضاءَ في حمراءَ في كِلَلٍ","كما استَجنَّ قِناعُ الشّمسِ في الشَّفَق",43,"ق",1,0],["من كلِّ باكيةٍ دماً من دُونها","يومَ الطّعان بمُقلةٍ زرقاء",44,"ا",2,0],["مِن كُلِّ بَيتٍ كَبَيتٍ أَنتَ ساكِنُهُ","كِلاهُما في المَعالي سَيِّدُ النَسَبِ",45,"ب",1,0],["من كل باغٍ في العناد برأيه ال","معوجِّ قد وافى كوحشٍ ضار",46,"ر",1,0],["مِن كُلِّ بَدرٍ يَستَسِرُّ زَمانه","وَلِكُلِّ بَدرٍ مَطلَعٌ وَسِرارُ",47,"ر",1,0],["من كلّ بسّامٍ تَسحُ","حُ يداهُ للعافِينَ سَامَهْ",48,"م",2,0],["من كلِّ بحرٍ يستفاض نواله","يا فوزَ من قد راحَ من روَّاده",49,"د",2,0],["من كلِّ بِكْرٍ ما ارتَضَيْ","تَ لها سوى عَلياهُ صِهْرا",50,"ر",2,0],["من كُلِّ بَحْرِيَّةٍ شامٍ يُشامُ بِهَا","حادِي الجَنُوبِ فلا رَيْثٌ ولا سَرَعُ",51,"ع",1,0],["من كُلِّ بكْرٍ فِي يمينِكَ حُرَّةٍ","يرفُلْنَ بَيْنَ قلائدٍ وجَلاببِ",52,"ب",1,0],["من كلِّ بيت شواظُ النار آيتهٌ","والنورُ حجتهُ طولَ الأحايينِ",53,"ن",1,0],["من كلّ بيتٍ في بيوتكُمُ","عَجُزٌ له لا تخذُلُ المتْنا",54,"ن",2,0],["من كلّ بيتٍ لو دَعَا بسحره","أمَّ النجوم طامنتْ أن تنزِلا",55,"ل",2,0],["من كلّ بيتٍ أمرُه بك نافذٌ","وعلى اشتطاطك حكمه مقبولُ",56,"ل",1,0],["من كل بزلاء وناجٍ حنَّان","وأملحتْ باناتها والكثبان",57,"ن",1,0],["من كلّ بكر ممالكٍ مشهودةٍ","يومَ الزفاف وساعة الإملاك",58,"ك",1,0],["مِن كُلِّ بَيضاءَ كِنانِيَّةٍ","أَو عاتِقٍ بَكرِيَّةٍ غَيطَموس",59,"س",1,0],["من كلِّ باغٍ حاسدٍ لا يَني","عندَك في ثَلْبِي وفي ثَلْمِي",60,"م",2,0],["من كل بيت من بيو","تات العلى علم شهير",61,"ر",1,0],["مِن كُلِّ بَسّامِ الثَنايا وَهوَ قَد","هاجَت بَلابِلُ صَدرِهِ من حِقدِهِ",62,"د",2,0],["مِن كُلِّ بَحرٍ في الفَضائِل مُهتَدٍ","بِالحَقِّ بَرٍّ بالعفاةِ أَريبِ",63,"ب",1,0],["من كل بيضاء مثل البدرِ مُطَّلعاً","هيفاءَ مثلَ قضيبِ البان منعطفا",64,"ف",2,0],["من كل بيت يحتوي","ابنة كسرى الملك",65,"ك",1,0],["من كلِّ بحرٍ من بحَارِ النَّدى","يَغْرَقُ في القطرةِ من بحره",66,"ر",2,0],["مِن كُلِّ بَحرٍ لِلمَعارِفِ قطبها","مِن كُلِّ نَجمٍ لِلطّريقَةِ مزهِرِ",67,"ر",1,0],["مِن كلِّ برٍّ في البريَّةِ صالِحٍ","مِن كلِّ قُطبٍ في الخليقَةِ مرشِدِ",68,"د",1,0],["من كل بيضاء هيفاء القوام إذا","ماست فواخجلة المران والبان",69,"ن",1,0],["من كل باهرةِ الجمال تصيدُ أل","بابَ الرجالِ بنْبل طرفٍ أكحلِ",70,"ل",1,0],["من كُلِّ بَهكَنةٍ القت اشلتَها","على هِبلٍّ كرُكنِ الطَود مُنقادِ",71,"د",1,0],["من كل باسمة بثغر لو بدا","للصبح لم تبرزه أيدي المطلع",72,"ع",1,0],["مِنْ كُلّ بَاسِمَةٍ بِثَغْرٍ قَدْ حَوَى","ضَرَبًا يُمَازِجُ شَهْدُهُ الجِرْيَالاَ",73,"ل",2,0],["من كل بيت أنيق الصوغ مؤتلق","يُزرى بحبات سِمطِ الكاعب الرود",74,"د",1,0],["من كلّ بيتٍ مثل بي","ت العنكبوت اذا بدا",75,"د",2,0],["من كلِّ باكية تجاوب مثلَها","نوحاً بقلب الدين منه أُوارُ",76,"ر",1,0],["من كل بكرٍ ياسمين جبينها","سحرٌ ونرجس لحظها سحار",77,"ر",1,0],["مِنْ كُلِّ بَيْضاءَ مِخْماصٍ لها بَشَرٌ","كَأنَّهُ بِذَكِيِّ المِسْكِ مَغْسُولُ",78,"ل",1,1],["من كل بدر فوق رمح قوامه","قلبى بلا مع برقة مخطوف",79,"ف",1,0],["من كل بيت رق جوهر لفظه","بلطيف معنى دق عن احساس",80,"س",1,0],["من كلِّ بيضاء تزهاها شمائلها","والدّل يقضي بما لا يقتضي الأدب",81,"ب",1,0],["من كل باكية اسرى وشاكية","حسرى وزاكية عبرى وتنتحب",82,"ب",1,0],["من كلِّ بكرٍ تُيِّمت بابن العلا","ومن العفافِ على سناها بُرقع",83,"ع",1,0],["من كل بدر دجى يجري به مرحاً","إلى الكفاح كميت سابق أفق",84,"ق",1,0],["من كل بارجة كالطود شاهقة","ترمى بذي ضرم بالنار متقد",85,"د",1,0],["من كل بعل حياة لا يعاقدها","إلا على أنه في الحرب مطلاق",86,"ق",1,0],["من كل باسطةِ الجناحِ كأنها","لما تَسَيَّر بالرياح غَمامُ",87,"م",1,0],["مِن كُلِ بَيضاءَ لَها كَعثَبُ","مِثلُ سَنامِ البَكرةِ المائرِ",88,"ر",1,0],["من كل بيضاء إذا ما نظرت","كانت لها البيض الرقاق خدم",89,"م",1,0],["مِن كُلِ بَيت بِهِ خود لَكُم رَفعت","طَرفاً كَحيلاً وَلَكن غَير مُنكَسر",90,"ر",1,0],["مِن كُلِ برّ أو رَؤف مِنكُم","بِالناس يَخشى بارئ النَسَمات",91,"ت",1,0],["من كل باغ له في الشر ألف يد","لو قُطَّعت كلها لم يُجْزِهِ القدرُ",92,"ر",1,0],["مِن كُلِّ بارِعَةِ الجَمالِ كَأَنَّها","شَمسٌ تَجَلَّت في سَوادِ الحَندَسِ",93,"س",1,0],["من كلِّ بارعةِ الجمال خريدةٍ","فَرعاءَ واضحةٍ الجبينٍ هجانِ",94,"ن",1,0],["مِن كُلِّ باكِيةٍ تَسيلُ دُموعها","مِن غَيرِ أَجفانٍ وَلا آماقِ",95,"ق",1,0],["مِن كُلِّ بَيتٍ يَرى بَيتِ القَصيد فَيا","لِلَّهِ ما أَبدَعتَهُ هانَكَ الفِكر",96,"ر",1,0],["مِن كُلِّ بَحرٍ لِلعُلومِ زاخِرٍ","وَكُلِّ طَودٍ لِلحُلُومِ قَد رَسَا",97,"ا",1,0],["منْ كلِّ بكرٍ حرَّةٍ ما فارَقت","إطراقَها وبكاءها وحياءها",98,"ا",3,0],["منْ كلّ بيضاء عَروبٍ طفلةٍ","بهكنةٍ، لذيذة المقبَّل!",99,"ل",1,0],["من كل بارجة تلهو الرياح بها","ربانها من هياج البحر في حذر",100,"ر",1,0],["من كل بيضاء مسيحية","ما عندها البدر بموصوف",101,"ف",1,0],["من.. كل بستانٍ.. تخير لك الشم","واختار لك أروع علومٍ ودستور",102,"ر",1,0],["من كلِّ بعدٍ في سمائكِ عالمي","ولقد صعدتُ إلى العُلا بفؤادي",103,"د",2,0],["من كل بَيت مبانيه مشيدة","كم من خبايا معَان فِي زواياه",104,"ا",2,0],["من كل بسام المحيا لم يكن","عند المعالي والعوالي ورعا",105,"ع",2,0],["من كل باب مصنع","من كل حوض ازهار",106,"ر",1,0],["مِنْ كُلِّ بارقةٍ تجلّى اسمُه","(عَمّارُ) يتلو آيَة ً وقرارا",107,"ر",2,0],["من كل بحر اقول نكسب بطوله","واما كسبنا .. فالخساير لمن هاب",108,"ب",1,0],["من كل بيتٍ في السما انزرعوا","واللهُ شاءَ حياتهم عندهْ",109,"د",2,0],["مِنْ كلِّ بارقِ خفقٍ ترتمي صورٌ","في كفِّها الأرضُ بالعُشّاقِ تعتنقُ",110,"ق",1,0],["من كلّ بيضاءَ الجبين خريدة ٍ","صفر الحشا سحّارة العينين",111,"ن",1,0]]}