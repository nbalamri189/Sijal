{"poems":[[53,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[87,"شأنك والدمع والبكاء","https://www.aldiwan.net/poem7111.html","مخلع البسيط"],[45,"الحزن يقلق والتجمل يردع","https://www.aldiwan.net/poem9724.html","الكامل"],[68,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[68,"بكيت دما لو كان سكب الدما يغني","https://www.aldiwan.net/poem40131.html","الطويل"],[48,"جر يا غراب وأفسد لن ترى أحدا","https://www.aldiwan.net/poem22669.html","البسيط"],[48,"دين وكفر وأنباء تقص وفر","https://www.aldiwan.net/poem23135.html","البسيط"],[98,"بعد مائة عام","https://www.poetsgate.com/ViewPoem.aspx?id=17898",""],[132,"هنيت بالنصر موعودا لك الظفر","https://www.aldiwan.net/poem50605.html","البسيط"],[132,"من كان عند الله غالب","https://www.aldiwan.net/poem50660.html","مجزوء الكامل"],[136,"كنا إذا مسنا من دهرنا نكد","https://www.aldiwan.net/poem54643.html","البسيط"],[203,"قولوا لهذا الرشا الهاجر","https://www.aldiwan.net/poem45589.html","السريع"],[214,"يا متهمي بالسلو مهلا","https://www.aldiwan.net/poem13319.html","مخلع البسيط"],[354,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[463,"كم النحت في جنبي والحز في متني","https://www.aldiwan.net/poem55835.html","الطويل"],[463,"أروض الوادي أم ابيض الغسق","https://www.aldiwan.net/poem56090.html","الرجز"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63973","الهزج"],[1115,"","https://poetry.dctabudhabi.ae/diwan/poem/138805",""],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124482",""],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128699","البسيط"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128706","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27210","السريع"],[190,"","https://poetry.dctabudhabi.ae/diwan/poem/98396","المنسرح"],[563,"","https://poetry.dctabudhabi.ae/diwan/poem/68318","الرجز"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140046",""],[2920,"","https://poetry.dctabudhabi.ae/diwan/poem/147226","البسيط"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112679","الرجز"],[3334,"","https://poetry.dctabudhabi.ae/diwan/poem/31454",""],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139919","البسيط"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52982","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86310","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91871","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205558","المتقارب"],[3727,"","https://poetry.dctabudhabi.ae/diwan/poem/124072","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133276","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135158","المجتث"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123499","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94349","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72438","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120517","البسيط"],[4859,"إن خصال الخير تأتلق","https://www.poetsgate.com/ViewPoem.aspx?id=210733",""],[4886,"لله كم من هضبةٍ وجبلِ","https://www.poetsgate.com/ViewPoem.aspx?id=170308",""],[5596,"وادي محرم","https://www.poetsgate.com/ViewPoem.aspx?id=206487",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6185,"صدمةٌ !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87025&r=&rc=11",""]],"verses":[["ومن اتَّقى التحيينَ فيما يتّقي","فكذاك أيضاً يتَّقي التجهيلا",0,"ل",2,0],["ومن أتانا بالشمس صبحا","ومن تولى بها مساء",1,"ا",2,0],["وَمَنِ اِتَّخَذتَ عَلى الضُيوفِ خَليفَةً","ضاعوا وَمِثلَكَ لا يَكادُ يُضَيِّعُ",2,"ع",1,0],["وَمَن أَتى ساجِداً لِلَّهِ ساعَتَهُ","وَغَيرُهُ ساجِدٌ في العُمرِ لِلصَنَمِ",3,"م",1,0],["وَمَن أَتعَبَ اللُوّامَ في بَذلِ بِرِّهِ","فَلائِمُهُ يَثني وَآمِلُهُ يُثني",4,"ن",2,0],["وَمَن أَتاهُم بِظُلمٍ فَهُوَ عِندَهُمُ","كَجالِبِ التَمرِ مُغتَرّاً إِلى هَجَرِ",5,"ر",1,0],["وَمَن أَتاهُ سِجِلُّ السَعدِ عَن قَدَرٍ","عالٍ فَلَيسَ لَهُ بِالخُلدِ تَسجيلُ",6,"ل",1,0],["ومن أتى الصحراء في دوّها","بهذه الأسوار شمّ الحصون ؟",7,"ن",1,0],["ومَن أتى الذنبَ مِنكم فهْو يغفرُه","وكلُّ ذنبٍ سِوى الإشراكِ مُغتفرُ",8,"ر",1,0],["ومَن اتَّقاه فاز فَوْ","زاً لا يخافُ من العواقبْ",9,"ب",1,0],["ومَن أتى عارضا رمح العنادِ أمَا","رأى كعوب رماح القوم تطرد",10,"د",1,0],["ومن اتقى اللهَ ولا يتقي","في مدمعي الملتطمِ الزاخرِ",11,"ر",1,0],["ومن اتى قاصدا اليه","في الحال اهلا يرى وسهلا",12,"ل",2,0],["وَمَن أَتى مِن طَورِ سيناءَ إِلى","جِبالِ ساعيرَ وَفي فارانَ قَر",13,"ر",1,0],["ومن أترك الشكوى به غير قانط","فيحمل عني عبأها غير ممتنِّ",14,"ن",1,0],["ومَن أتته كالحبال عَجَفاً","ورَجعتْ كالوَسْقِ من تحت الوَسَقْ",15,"ق",1,0],["ومن أتى بواحد يستاثر","بواحد وقد عصى في الآخر",16,"ر",1,0],["ومن أترجة من اس","فر العسجدِ مخطوطه",17,"ط",2,0],["ومن أتاه جبريل بالسطل","والمنديل فامتاز في طهارته",18,"ت",2,0],["ومن اتى بدون سَبعٍ لم يُصِب","اذ كان في المنسوب وضعُها يجب",19,"ب",1,0],["ومن أتى مجلسه دون ندا","ما للندا يصلح نحو أحمدا",20,"ا",1,0],["ومن أتانا بدين واضح فجلا","غياهب الشرك وانجابت دياجيه",21,"ي",2,0],["ومن أتى بكتاب واضح فجلا","غياهب الشرك وانجابت به الريب",22,"ب",1,0],["ومن أتى يرغب في شانه","يقعد في الدنيا بسيسائه",23,"ا",3,0],["ومن أتى جاهلا بموعظة","من قوله ضاع وعظه بيده",24,"د",2,0],["ومن أتى بها عليه في الورى","بُغِي بسوءٍ وَاِفْتِرَا وَعُودي",25,"د",2,0],["وَمن أَتى مِنهُم لِتَحت السور","لَم يَقدِر الفرار لِلعبورِ",26,"ر",1,0],["ومن أتى ليلة المعراج يقدمه","جبريل في حسن تصوير وتزيين",27,"ن",1,0],["ومن أتاك طليحاً طالباً جدةً","فإنه بالغٌ مما بغى الأربا",28,"ب",2,0],["ومَن أتاهُ عارِفاً بحقّه","من سَيئاتهِ يفز بعتقِهِ",29,"ه",1,0],["ومن أتى ليس يدري ما أراد فإن","أبدا كضرب بسيف أو رمي نبلا",30,"ل",2,0],["ومن أتى مظهرا بغياً وليس به","في باطن الأمر كن في قتله بطلا",30,"ل",2,0],["ومن أتمت صلاة الحمد فيه فلا","يكونُ في سفر قصر ولا حضرِ",31,"ر",1,0],["ومن أتى حيَّنا يُزاحمُ","فنحرهُ للنسورِ عيدُ",32,"د",1,0],["وَمن اِتى فِعل خَير لِلعِبادِ فَلَم","يَندَم عَلَيهِ وَلم تَذممه اِقرانُ",33,"ن",1,0],["وَمَن أَتاح لهول من تهاونه","يَوماً غَدا بعظيم الأَمر مفجوءا",34,"و",3,0],["ومنا تذوقون طعم الحياة","وهل طعمها غير طعم القُبَلْ",35,"ل",1,0],["ومن أتاك رديىء الكسب صار له","مما أتاكَ رديىء الكسب غير ردي",36,"د",2,0],["ومن أتاك بحسن القصد كان له","لواء عز بيمنى اليمن معقود",37,"د",1,0],["ومن أتى بوعيد","عندي فذاك عديم",38,"م",1,0],["ومن أتى وافدا حماه","حماه عن كلّ ما يضر",39,"ر",1,0],["ومن اتقى ضرر البَريَّة مؤمناً","باللَه يغنم نعمةً ووقارا",40,"ر",2,0],["ومن أترابها عرب ولكن","قد اشتهرت بطبع السيف هند",41,"د",1,0],["ومن اتاني منعاه ولم اره","فهاج حزني واضناني واضناني",42,"ن",2,0],["ومن أتى يبتغي في عالمي كدرا","فقد يموت أسى قهرا ويحترق!",43,"ق",1,0],["ومن أتى البيوتَ من أبوابها","فَهُوْ حَرِيْ بها بِحُسْنِ المدخل",44,"ل",1,0],["ومن أتته علوم الإرث جامعةً","تلقي إليه ولاءاتٍ وطاعات",45,"ت",1,0],["ومن أتى للأزمان يجبر صدعها","فأثنت عيه ألسن الملكيتي",46,"ت",2,0],["وَمَن أتَى الوغَى بِلَا وَتَرٍ","إذَا هَوَى ، بِالسَّهمِ لم يَرَمِ",47,"م",1,0],["وَمَنْ أتَانيْ يُرِيْدُ الخَيْرَ أَجْعَلُهُ","فِيْ مَنْزِلٍ يُعْجِبُ الرَّائِينَ إِنْ نَزَلَا",48,"ل",2,0]]}