"ذكرى الأباة ومطلع الشهداء","https://www.aldiwan.net/poem61257.html","الكامل"],[456,"عيدان عيد تحرر وتفاؤل","https://www.aldiwan.net/poem61377.html","الكامل"],[461,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[461,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[461,"هل تحت ليلك بالغضا من رائد","https://www.aldiwan.net/poem56217.html","الكامل"],[464,"إذا مدحت معز الدين آونة","https://www.aldiwan.net/poem15133.html","البسيط"],[464,"شهد العراق وكل راو بارع","https://www.aldiwan.net/poem15406.html","الكامل"],[464,"شموس المواضي ان بغيت الأمانيا","https://www.aldiwan.net/poem15466.html","الطويل"],[486,"قالت أمامة يوم برقة واسط","https://www.aldiwan.net/poem2076.html","الكامل"],[503,"رقرق الكأس حبيبي","https://www.aldiwan.net/poem37975.html","مجزوء الرمل"],[518,"تغدو مهابته حجاباً دونه","https://www.aldiwan.net/poem12033.html","الكامل"],[518,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[518,"دانت لأمرك طاعة الأقدار","https://www.aldiwan.net/poem12106.html","الكامل"],[541,"ما لي أرى حبس الحمراء في نكد","https://www.aldiwan.net/poem48228.html","عموديه"],[554,"يا قاتلي إن كنت ترضي","https://www.aldiwan.net/poem47267.html","مجزوء الكامل"],[554,"شطت عليك لبانة الصدر","https://www.aldiwan.net/poem47783.html","أحذ الكامل"],[561,"طاء طيب الطباع في الأقساط","https://www.aldiwan.net/poem34405.html","الخفيف"],[564,"تطاول الليل على من لم ينم","https://www.aldiwan.net/poem27846.html","الرجز"],[570,"يا من لأجفان قريحه","https://www.aldiwan.net/poem69759.html","مجزوء الرجز"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[578,"أنا غرس بيتك إن أرد","https://www.aldiwan.net/poem2761.html","مجزوء الكامل"],[578,"نظر الحبيب إلي من طرف خفى","https://www.aldiwan.net/poem3048.html","الكامل"],[578,"باتت معانقتي ولكن في الكرى","https://www.aldiwan.net/poem3062.html","الكامل"],[578,"كحل العيون بمرود من عسجد","https://www.aldiwan.net/poem3085.html","الكامل"],[652,"","https://poetry.dctabudhabi.ae/diwan/poem/216922","الكامل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/89638","الوافر"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/20919","الكامل"],[958,"","https://poetry.dctabudhabi.ae/diwan/poem/200295","الكامل"]],"verses":[["وَجَعَلتَ تَصعيبَ المُصابِ مُعَظَّماً","مِن شَأنِهِ بَدَلاً مِنَ التَسهيلِ",0,"ل",1,0],["وَجَعجَعَ لي ظَهرُ عاري الصَفا","حِ عَقيرٍ وَقالَ أَلا تَركَبُ",1,"ب",1,0],["وجَعَلْتَ مِياهَهُمُ غوْراً","وترَكْتَ صَعيدَهُمُ زلَقا",2,"ق",2,0],["وجعَلتُ مدْحَكَ للإلاهِ وسيلَتي","فشَرِبْتُ في دارِ النّعيمِ خُلودا",3,"د",2,0],["وجعَلْتُ النّهارَ طِرْسيَ كيْما","أحْمي الوُدَّ والظّلامَ مِدادي",4,"د",2,0],["وجَعَلْتُ حُبَّكَ مَذهَباً وشَريعَةً","قلَّدْتُهُ يا حَبّذا التّقْليدُ",5,"د",1,0],["وَجَعفَرَ إِنَّ جَعفَرَ خَيرَ سِبطٍ","شَهيداً في الجِنانِ مُهاجِرِيّا",6,"ي",2,0],["وَجَعَلْنَ آيَاتِ الرَّبِي","عِ لَدَيْكَ أَفْصَحَ تَرْجُمَانِ",7,"ن",1,0],["وجعلت قلبي مسجداً لتعبّدي","سرّاً وفهت له بشكري معلناً",8,"ن",2,0],["وَجِعثِنُ كانَت خَزيَةً في مُجاشِعٍ","كَما كانَ غَدرٌ بِالحَوارِيِّ مُنكَرا",9,"ر",2,0],["وَجَعَلتُ ما مَلَكَت يَدي","بُشرى المُبَشِّرِ بِالقَبولِ",10,"ل",1,0],["وجعلتُ في نَظْمَ الهجا","ءِ فِياشَ ناكتهِ سِخَابهْ",11,"ب",2,0],["وَجَعَلْتَهَا تَبَعَ الكِتَاب مُنازِلاً","في ذاكَ صاحِبَكَ السَّمِيعَ إذا نَصحْ",12,"ح",1,0],["وجعلت أقصى ما تجود به","للمستميح نواله الجُرعه",13,"ع",2,0],["وجعلت ذكر الصفع خاتمة","مسترزقاً من صافع صفعه",13,"ع",2,0],["وجعلت تحفتها مغازلة","لك أن تقول مجيبة نزعه",13,"ع",2,0],["وجعلت الصديق أولى بأن يل","غى ويرضى بخُلَّبات البروق",14,"ق",1,0],["وجَعَلناه يومَ عيدٍ عظيم","فكأنا اليهودُ أو نحكيهِمْ",15,"م",1,0],["وجُعِلْتُ مِنْ سَقَطِ الحَمي","رِ وكنْتُ من خَيْلِ الرِّهانِ",16,"ن",1,0],["وَجَعَلتُم مِنكُم عَسكَرَهُ","وَحَلَفتُم أَن تُطيعوا عَسكَرَه",17,"ر",2,0],["وَجَعَلنا بَعدَ أَن طالَ العِناق","تَتَناجى بِأَحاديثِ القُلوب",18,"ب",1,0],["وَجَعَلتُ مَذهَبَها مِنَفسِيَ مَذهَباً","وَنَسَجتُ أَخلاقي عَلى مِنوالِها",19,"ل",3,0],["وَجَعَلناهُ يَقيناً","بَعدَما قَد كانَ ظَنّا",20,"ن",2,0],["وَجَعَلتَني أَبكي عَلَي","كَ مِنَ الغُروبِ إِلى الشُروقِ",21,"ق",1,0],["وَجَعَلتُ نَقلي ذكرَ موصل زفرَتي","فَجَمَعتُ أَشتاتَ المُنى في مَجلِسي",22,"س",2,0],["وجعلت تلهج بالمنون وأنه","حق فكان الداء شر ممهد",23,"د",1,0],["وَجَعَلتُ أَستُرُ عَن سِواك ذُنوبَها","حَتّى عَبيتُ فَمُنَّ لي بِسِتارِ",24,"ر",1,0],["وَجَعَلتَ تَسأَلُني الرِثاءَ فَهاكَهُ","مِن أَدمُعي وَسَرائِري وَجِناني",25,"ن",2,0],["وَجَعَلتِ حَظّي مِنكِ حَظّي في الكَرى","وَتَرَكتِني لِلفَرقَدَينِ جَليسا",26,"س",2,0],["وجعلتَ عُنْوانَ السماحِ طلاقةً","وكذا لكلِّ صحيفةٍ عُنوانُ",27,"ن",1,0],["وَجَعَلتَ فِعلَكَ تِلوَ قَولِكَ قاصِراً","عُمرَ العَدُوِّ بِهِ وَعُمرَ المَوعِدِ",28,"د",1,0],["وَجَعَلتُهُم ضُحَكَ المَجالِسِ دَهرَهُم","وَتَنَزُّهاً لِمُفَجَّعٍ وَلِسامِدِ",29,"د",1,0],["وجع الحرف رائعٌ.. أوتشكو","للبساتين وردةٌ حمراء؟",30,"ا",2,0],["وَجَعْدُ المياهِ إذا صافَحَت","جداولَه الريحُ سَبْطُ الهواءِ",31,"ا",2,0],["وَجَعفَرٌ الَّذي يُضحي وَيُمسي","يَطيرُ مَعَ المَلائِكَةِ اِبنَ أُمّي",32,"م",2,0],["وَجَعَلتَ عِرضَكَ لِلمَطامِعِ بِذلَةً","وَكَفى بِذَلِكَ فِتنَةً وَهَلاكا",33,"ك",2,0],["وَجَعَلنا الساقي خَليلاً جَليلاً","يُحسِنُ المَزجَ أَو غَزالاً رَخيما",34,"م",2,0],["وَجَعَلتَ أَشلاءَ الكُماةِ كَأَنَّما","ذَخَرَت لِقوتِ الوَحشِ في فَلَواتِها",35,"ت",3,0],["وَجَعَلتَ رَبعَكَ لِلمُؤَمِّلِ كَعبَةً","هِيَ رِحلَةٌ لِشِتائِهِ وَلِصَيفِهِ",36,"ف",2,0],["وَجَعَلتَ هاماتِ الكُماةِ مَنابِراً","وَأَقَمتَ حَدَّ السَيفِ فيها خاطِبا",37,"ب",2,0],["وجعلتُ النسيمَ زاداً لروحي","وشربتُ الظلالَ والأضواءَ",38,"ا",2,0],["وَجَعَلنا مَعَ المُلوكِ مُلوكاً","بِجِيادٍ جُردٍ تُقِلُّ الحَديدا",39,"د",2,0],["وَجَعَلتُ دَاري في النَّوى فَمُؤانسي","وحشُ الفلا وَمَجَالسي الأكوارُ",40,"ر",1,0],["وَجَعَلتَ لي مَندوحَةً مِن بَعدِ ما","أَكدى عَلَيَّ تَصَرُّفي وَتَقَلُّبي",41,"ب",2,0],["وَجَعَلَ الخاتَمَ لِلنُبُوَّةِ","أَحمَدَ ذا الشَفاعَةِ المَرجُوَّه",42,"ه",1,0],["وَجَعَلَ الأَسرى مُكَتَّفينا","أَغراضَ نَبلٍ وَمُعَلَّقينا",42,"ن",2,0],["وَجَعَلوا في يَدِهِ حِبالاً","مِن قُنَّبٍ يُقَطِّعُ الأَوصالا",42,"ل",2,0],["وَجَعَلتُ تَقْدِيسِي قُبَيْلَ وُجُودِهِ","وَعداً عَلَيَّ كَبَعثِهِ مَفعُولا",43,"ل",2,0],["وَجَعَلتُ كُتبَهُما شِفَاءَ تَفَرُّدي","وَهُما الشِّفاءُ لِكُلِّ جُرحٍ يُوسى",44,"س",2,0],["وجعَلتُ فيّ لمالِكٍ طَمَعاً","ونَهَيْتُ عن رِضوانَ آمالي",45,"ل",2,0],["وجعل الخلد نظام الآل","ومن تلا الوسطى من اللآلى",46,"ل",2,0],["وَجعَلَ الشَّمسَ مِصراً لا خَفَاءَ بِه","بَينَ النَّهَارِ وبَينَ اللَّيلِ قَد فَصَلا",47,"ل",2,0],["وَجَعَلْتِ التَّحْصِيلَ دَأْباً وَآتَيْ","تِ جَنَاهُ فَطَابَ لِلمُجَتَبِينَا",48,"ن",2,0],["وجعلنا الزمنا","قطر في كأسنا يا حبيبي",49,"ي",1,0],["وجعلت من جفني متكأً","ومن عيني مهدك",50,"ك",1,0],["وجعلَنا اليأسَ مفتا","حاً لأبوابِ النجاح",51,"ح",1,0],["وجَعَلْنا له مِنَ الْخُلُقِ العَا","لِي سِيَاجاً مُوَثَّق اللَّبِناتِ",52,"ت",1,0],["وَجعلْتُ تَشْبِيبِي بمِصْرَ ومَجْدِهَا","وشمَائِلَ الفَارُوقِ بَيْتَ قَصِيدِي",53,"د",2,0],["وجعلنا ملاطهُ من دِمَاء","غاليات، على الحِمَى طاهرات",54,"ت",1,0],["وجعلت مدحك للإله وسيلتي","فشربت في دار النعيم خلودا",55,"د",2,0],["وجعلت النهار طرسي كيما","أحصر الود والظلام مدادي",56,"د",2,0],["وجعلتُ آخرَ ما يمرُّ بخاطري","تفكيرتي ان يُجتَوى او يُرتَضَى",57,"ض",2,0],["وجعلت مذهبها لنفسي مذهبا","ونسجت أخلاقي على منوالها",58,"ل",3,0],["وجعلنا وسيلة القرب منه","شيخنا الغوث مصدر الأسرار",59,"ر",1,0],["وجعلت صدري قبرها","وجعلت أحشائي ثراها",60,"ا",3,0],["وجعلها ذهباً مرونقاً ورقا","يحسن به ذهبٌ ويحسن الوَرِقُ",61,"ق",1,0],["وجعلت منه فتى يعيش ونغمة","ترجيعها في الخافقين حنين",62,"ن",1,0],["وجَعَلتَ الرَّبَابَ فِيهِ نَدِيماً","مَا عِهِدنَا الرَّبَابَ قَبلُ نَدِيما",63,"م",2,0],["وجَعَلتَ الروي مِيماً فإِنَّ رُم","تَ جَوَابي إجعَلَن رَوِيَّكَ مِيمَا",63,"م",2,0],["وجعلتَ رأس الحاسدي","ن بمصرَ من قدميّ أدنى",64,"ن",2,0],["وجعلت سُدةَ منزلي","من أسقف الهرمين أسنى",64,"ن",2,0],["وَجَعَلنا خَليقَةَ اللَهِ فَطرو","سَ وَالمُستَشارَ يُحَنّا",65,"ن",2,0],["وَجَعمَسَني مُستَخبِراً فَصَفَعتُهُ","فَقُمتُ بِلا أَنفٍ وَقامَ بِلا راسِ",66,"س",1,0],["وَجَعَلتَ شِقوَتَهُم بِعَفوِكَ نِعمَةً","وَأَحَلتَ مَشتاهُم بِفَضلِكَ مَربَعا",67,"ع",2,0],["وجعفر فر شبعانا مليا","وما يحكي اسمه كذب ورد",68,"د",1,0],["وجعفر لم يذنب ومذ مد كفه","وبايع لم يصبح لها منك نازعا",69,"ع",2,0],["وَجَعَلتُ أَيّامَ التَّعَاتُبِ بَينَنا","رَصَداً لِيَومِ صَرِيمةٍ فَرِّيالِ",70,"ل",1,0],["وَجَعلتُ مَوعِدَهُنَّ لَيلةَ أَسعُدٍ","مَلقَى المُحِبِّ عنِ الغَيورِ الغافلِ",71,"ل",1,0],["وجعلتَه كالشمسِ ما بينَ الورى","وفِعالُه تَقضِي بوَشْكِ أُفوله",72,"ل",2,0],["وجعلت الهموم هما بحالي","ن مقاتي وهمّ يوم الأفول",73,"ل",1,0],["وجعلت القنوع كالطوق في ال","جيد وعزّ الخلوّ كالإكليل",73,"ل",1,0],["وَجَعلتهُ بِالمؤمنين رَحيما","صلّوا عليهِ وَسلّموا تَسليما",74,"م",2,0],["وجعلتَ تقوى اللهِ شِكَّتك التي","نزلتْ قلوبُ الرُّوم رَهْنَ شكاتها",75,"ت",3,0],["وجعلتمو طرف المحب معذّبا","يبكى السوالف بكرةً وأصيلا",76,"ل",2,0],["وَجَعَلتِ غَرغَرَةَ الأَفاعي كَأسَه","لِيَذوقَ مِنها كُلَّ قَلبٍ مَصرَعَه",77,"ع",2,0],["وجعلناها مقدِّمة","تقتضي الباقي من الأملِ",78,"ل",1,0],["وَجَعَلتُها عُوَذاً لَكُم وَتَمائِماً","وَلِمَن يُعاديكُم حَصاةَ قَذافِ",79,"ف",1,0],["وجَعَلتَ طَرفي بالأسى","وَقفاً على دَمعي وسُهدي",80,"د",2,0],["وجعلتُها يوم الحساب ذَخيرتي","فاشهَد بها عند ابن عمَّكَ في غَدِ",81,"د",1,0],["وَجعلتَ للآدابِ رَبعاً آهلاً","بنَدى يَدَيكَ وَكانَ رسماً مقفِرا",82,"ر",2,0],["وَجَعَلتُ صَبري مَعقِلاً وان اِغتَدى","صَرفُ الزَمانِ بظفره وَبنابهِ",83,"ب",2,0],["وجعيساتهم خلال الزوايا","مثل ذرق الفراخ في الأعشاش",84,"ش",1,0],["وجعلت وصلك داخلا في صيدها","وإنا لوصلك يا غزالي أرغب",85,"ب",1,0],["وَجعلت عينا لا تَنام عليهم","عينا وَحَسبي ذو الجَلال تَعالى",86,"ل",2,0],["وَجعلت شق البدر معجزة لمن","في الحي من بدو هديت وَحضر",87,"ر",1,0],["وَجَعلت مَدحي فيك يا علم الهُدى","سببا وأَنتَ وَسيلة المتسبب",88,"ب",1,0],["وجعلتَها صلَةً لقولي ذاكراً","منك التي أَتت الفتى ذكرَاهُ",89,"ا",2,0],["وَجَعَلتَ شَرقَ الأَرضِ يَحسُدُ غَربَها","بِكَ فَهوَ داعٍ دَعوَة المُستَنصِرِ",90,"ر",1,0],["وجعلت صدري مدفنا لنوازعي","إذ كان غضا في الزمان أهابي",91,"ب",2,0],["وجعلنا نرحل العيش حتى","وافت الحي حي قوم كرام",92,"م",1,0],["وَجَعلتها حرماً بفضلك آمناً","وَحيالها مُتخطّف الحدثانِ",93,"ن",1,0],["وجعل لعاب العنكبوت لصيده ال","ذ