{"poems":[[93,"لا تحقر الدرهم من مسعد","https://www.aldiwan.net/poem11340.html","السريع"],[88,"من أين من أين يا ابتدائي","https://www.aldiwan.net/poem45073.html","مخلع البسيط"],[70,"تعيش أنت وتبقى","https://www.aldiwan.net/poem42788.html","المجتث"],[99,"رسالة حب صغيرة","https://www.aldiwan.net/poem6320.html","عموديه"],[46,"اللب قطب والأمور له رحى","https://www.aldiwan.net/poem22570.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55026","البسيط"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199490","الرجز"],[90,"اندونيسيا المجاهدة","https://www.poetsgate.com/ViewPoem.aspx?id=179216",""],[99,"رصاصة الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=36624",""],[200,"يا أنيسي ذر الحزين حزينا","https://www.aldiwan.net/poem45520.html","الخفيف"],[226,"يا أنجب الأنجبين مهلا","https://www.aldiwan.net/poem55124.html","مخلع البسيط"],[299,"طيف للمياء ما ينفك يبعث لي","https://www.aldiwan.net/poem36813.html","عموديه"],[450,"أبا خليفة إن الطبع غلاب","https://www.aldiwan.net/poem981.html",""],[453,"يا أنعم الله المساء وغبذا","https://www.aldiwan.net/poem13816.html","الكامل"],[453,"يا أنعم الله المساء وغبذا","https://www.aldiwan.net/poem13821.html","الكامل"],[465,"يا ناظراً عميت عني بصيرته","https://www.aldiwan.net/poem3247.html","عموديه"],[465,"كيف السكون من الدنيا إلى سكن","https://www.aldiwan.net/poem3393.html","عموديه"],[469,"يا أنظف العالم في الغسل","https://www.aldiwan.net/poem59722.html","السريع"],[563,"لاحت فقلنا كوكب الصبح بان","https://www.aldiwan.net/poem52897.html","السريع"]],"verses":[["يَا أَنْجُماً زَانَتْ سَمَاءَ الْحِمَى","بُورِكَ فِي الْفِتْيَانِ مِنْ أَنْجُمِ",0,"م",1,0],["يا أنجم النعش فاصدقيني","أمات ذو النعش بانطفاء",1,"ا",2,0],["يا أَنعَمَ الناسِ بالاً","إِلى مَتى فيكَ أَشقى",2,"ق",2,0],["يا أنت يا جاعلةً أحرفي","مما بها شرانقاً للحرير",3,"ر",1,0],["يا إِنسَ كَم يَرِدُ الحَياةَ مَعاشِرٌ","وَيَكونُ مِن تَلَفٍ لَهُم إِصدارُ",4,"ر",1,0],["يا أَنْبَهَ الخَلْقِ فِي عِلْمٍ وَفِي عَمَلٍ","وَأَنْزَهَ الخَلْقِ عَنْ زَهْوٍ وَعَنْ صَلَفِ",5,"ف",1,0],["يا أنتِ! يا كاملة الأوصاف!","تسلل الغروب لصّاً مسرعاً.. يخافْ",6,"ف",1,0],["يا \" اندونوسُ \" إن استماتَ بَنوكِ","فالحربُ أمُّكِ والكفاحُ ابوكِ",7,"ك",1,1],["يا \" اندنوسُ \" ! وفي الخلائقِ شركة","لاشيءَ غير الله دونَ شريك",7,"ك",1,0],["يأ أنانية الشفاه ، اعذريني","لا يظل الحليم دوماً حليما",8,"م",2,0],["يا أنيسي ذرِ الحزينَ حزيناً","بعضَ ما سامهُ الهوى يكفيهِ",9,"ه",1,1],["يا أَنجَبَ الأَنجَبينَ مهلاً","فَسوفَ تَستَغفِرُ المَظاهِر",10,"ر",1,1],["يا أَنَّةً عند إدبارِ النجوم حدتْ","من المدامعِ ثجَّاجاً وَهتّانا",11,"ن",2,0],["يا أنبل الناس صدقا في معاملة","إليك من نفحات الزهر أطياب",12,"ب",1,0],["يا أنعمَ اللهُ المساءَ وغِبَّذا","ينهى المحب المخلص المُتَعَطِّشُ",13,"ش",1,1],["يا أنعمَ اللّه المساءَ وغبَّذا","يهدي تحيَّته المحبُّ المخْلِصُ",14,"ص",1,1],["يا أنشب النشا شصاً في محرمة","يصطادها بشباك من مشاريح",15,"ح",1,0],["يا أنسَ ساكنةِ الأجداث جاورها","ميتاً ويا وحشةَ الأحياء والمدن",16,"ن",1,0],["يا أَنظَفَ العالَمِ في الغُسلِ","مِثلُكَ لا يَغفَلُ عَن مِثلي",17,"ل",2,1],["يا أُنسَ يومٍ قد أتَتْني ضُحىً","أشَهى من النَيرُوزِ والمِهْرَجانْ",18,"ن",1,0]]}