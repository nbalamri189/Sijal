941",""],[6131,"روحي رهينةْ","https://www.poetsgate.com/ViewPoem.aspx?id=189335",""],[6131,"يَا صَاعدًا للنورِ متَّكئَ النَّدَى","https://www.poetsgate.com/ViewPoem.aspx?id=189339",""],[6185,"شدو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87030&r=&rc=16",""],[6199,"نزيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79700&r=&rc=21",""],[6202,"روحي هنالك لا هنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86727&r=&rc=28",""],[6212,"أميرة الماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1629&r=&rc=10",""],[6072,"أرَقٌ وغَرَق !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82190&r=&rc=22",""],[6242,"أرق المساء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87553&r=&rc=1",""],[6242,"على شاطئ التِّمثال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87563&r=&rc=10",""],[6242,"كذّابة الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87565&r=&rc=12",""],[6251,"وَثائِق ُالشَّمْس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76466&r=&rc=6",""],[6300,"الحرف وإمبراطورية العزف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81630&r=&rc=7",""],[6300,"يا أنت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82856&r=&rc=27",""],[6333,"دمى فوق منضدة الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7088&r=&rc=9",""],[6335,"قراءة في قسمات وجه عربي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65401&r=&rc=3",""],[5190,"الشعر والمشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78334&r=&rc=47",""],[5190,"إشارة حمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85037&r=&rc=112",""],[5190,"طَرَقات على باب الرحيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78319&r=&rc=32",""],[6343,"تهويمات في وجهها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1971&r=&rc=1",""]],"verses":[["يَا أَنْجُماً زَانَتْ سَمَاءَ الْحِمَى","بُورِكَ فِي الْفِتْيَانِ مِنْ أَنْجُمِ",0,"م",1,0],["يا أنجم النعش فاصدقيني","أمات ذو النعش بانطفاء",1,"ا",2,0],["يا أَنعَمَ الناسِ بالاً","إِلى مَتى فيكَ أَشقى",2,"ق",2,0],["يا أنت يا جاعلةً أحرفي","مما بها شرانقاً للحرير",3,"ر",1,0],["يا إِنسَ كَم يَرِدُ الحَياةَ مَعاشِرٌ","وَيَكونُ مِن تَلَفٍ لَهُم إِصدارُ",4,"ر",1,0],["يا أَنْبَهَ الخَلْقِ فِي عِلْمٍ وَفِي عَمَلٍ","وَأَنْزَهَ الخَلْقِ عَنْ زَهْوٍ وَعَنْ صَلَفِ",5,"ف",1,0],["يا أنتِ! يا كاملة الأوصاف!","تسلل الغروب لصّاً مسرعاً.. يخافْ",6,"ف",1,0],["يا \" اندونوسُ \" إن استماتَ بَنوكِ","فالحربُ أمُّكِ والكفاحُ ابوكِ",7,"ك",1,1],["يا \" اندنوسُ \" ! وفي الخلائقِ شركة","لاشيءَ غير الله دونَ شريك",7,"ك",1,0],["يأ أنانية الشفاه ، اعذريني","لا يظل الحليم دوماً حليما",8,"م",2,0],["يا أنيسي ذرِ الحزينَ حزيناً","بعضَ ما سامهُ الهوى يكفيهِ",9,"ه",1,1],["يا أَنجَبَ الأَنجَبينَ مهلاً","فَسوفَ تَستَغفِرُ المَظاهِر",10,"ر",1,1],["يا أَنَّةً عند إدبارِ النجوم حدتْ","من المدامعِ ثجَّاجاً وَهتّانا",11,"ن",2,0],["يا أنبل الناس صدقا في معاملة","إليك من نفحات الزهر أطياب",12,"ب",1,0],["يا أنعمَ اللهُ المساءَ وغِبَّذا","ينهى المحب المخلص المُتَعَطِّشُ",13,"ش",1,1],["يا أنعمَ اللّه المساءَ وغبَّذا","يهدي تحيَّته المحبُّ المخْلِصُ",14,"ص",1,1],["يا أنشب النشا شصاً في محرمة","يصطادها بشباك من مشاريح",15,"ح",1,0],["يا أنسَ ساكنةِ الأجداث جاورها","ميتاً ويا وحشةَ الأحياء والمدن",16,"ن",1,0],["يا أَنظَفَ العالَمِ في الغُسلِ","مِثلُكَ لا يَغفَلُ عَن مِثلي",17,"ل",2,1],["يا أُنسَ يومٍ قد أتَتْني ضُحىً","أشَهى من النَيرُوزِ والمِهْرَجانْ",18,"ن",1,0],["يا أنجماً لما اطلَّ","لت من شبابيكِ السماء",19,"ا",2,0],["يا أنفُساً ذلت بإتيانهم","ويك أتأتين الأتاتينا",20,"ن",2,0],["يا أنيسي وأين منى أنيسي","لم يزده الدنو إلا نفارا",21,"ر",2,0],["يا أنيسَ الفُؤادِ بُعْداً وقُرْبا","لمْ يَذَرْ لي الفُرَاقُ عَقْلا وقلبَا",22,"ب",2,1],["يا انشر على سمعك قصص غرامي","وما لقيته من لظى هيامي",23,"ي",1,0],["يا أَنيسي انا الذي متُّ حقا","متُّ حقاً لكنما بعد موتي",24,"ي",1,0],["يا أنس بدر في الظلا","م وبرد ظل في المقيل",25,"ل",1,0],["يا انس قلبي حين يوحش منزلي","وضياء عيني لم صرمت حبالي",26,"ل",2,0],["يا أَنتَ لَفظُكَ خَمرٌ","لَها النُفوسُ مِزاجُ",27,"ج",1,0],["يا أنجب الفضلاء يا من قد جلا","عني سناه كل داج غيهب",28,"ب",1,0],["يا أنا مما اعتراني يا أنا","كلّ طالب نالكم إلا أنا",29,"ن",2,0],["يَا أَنْتَ أَنتَ رَحِيْقٌ وَهْجُهُ قَبَسٌ","فَهَلْ تَحِيقُ بِكَ البَأسَاءُ بِالخَجَلِ",30,"ل",1,0],["يا أَنفساً ثوبُ الصغارةِ ثوبُها","لم يُخفِ عارَكِ قَدرُكِ المتجسِّمُ",31,"م",1,0],["يا أنوم الناس قلباً لم يفق لعلاً","إلا إذا قام يوماً ينفخ الصور",32,"ر",1,0],["يا أنس دار الخلد عند لقائه","يا وحشة الدار التي عنها اختفى",33,"ف",2,0],["يا آنسين بصحبة من وجدهم","نُصُّوا المسامع للأنيس الواجد",34,"د",1,0],["يا أَنتِ يا دِين قَلبي في عِبادتِهِ","لَم يَرتضِ الدينَ إِلّا في حِمى دينِكْ",35,"ك",1,0],["يا انكليزُ اعملوا ما شئتم عبثا","فلن يصدِّقَكُمُ إِلا أَصَمُّ عمي",36,"م",2,0],["يا انجماً عن سماء الارز آفلة","وخلفها كبدُ العلياء في وجَب",37,"ب",1,0],["يا أَنصتَ الناسِ إِلى حكمةٍ","يقبلها مَنْ سَمْعُه قابِل",38,"ل",1,0],["يا أَنيس الحَياة يَقطر مِنكَ ال","طيب نُبلا وَتَعبق الأَخلاق",39,"ق",1,1],["يا أَنفَ عيسى جَزاكَ اللَّهُ صالِحَةً","وَزادَكَ اللَّهُ إِشراقاً وَمُتَّسَعا",40,"ع",2,1],["يا أنيسي ما بين أهلي وناسي","وخليلي من دون كل خليل",41,"ل",1,1],["يا أنت أغويت الفتى ولك امتثل","ومشى على درب الهوى حتى وصل",42,"ل",1,1],["يا أنتِ يا رعشةَ الأنوارِ في لغتي","أنت ِالضياء الذي أخفيه في رئتي",43,"ت",2,1],["يا انا يا امك بنفسك اختار","وقبل ما تختارها دور بديلي",44,"ل",2,0],["يا أنتِ يا طيف القصيدِ بروضتي","هُبّي نسيمًا من شذا مرعاكِ",45,"ك",1,0],["يا أنتِ.. حَتَّى العِطرُ بَعدَكِ إن","عانَقتُهُ _لِأَرَاكِ_ يَنطَفِئُ",46,"ا",1,0],["يا أنتُمُ.. يا جَرَادَ الجَنَّتَينِ, ويا","فِئرَانَهَا, أينَ يُخفِي عَنكُمُ عَسَلَهْ؟!",47,"ل",2,0],["يا أنتِ هل لي مِن بلادٍ سوى","عينيكِ إن صارت خيولي جُحُوش",48,"ش",1,0],["يا أنتَ يا سَكَرَاتٍ","في مُهجَتِي تَتَوَالَى",49,"ل",2,0],["يا أنتِ يا خُبزَ عَينِي, يا طَرِيقَ يَدِي","ويا رَوَائِي بِأرضٍ ماؤُهَا عَكِرُ",50,"ر",1,0],["يا أنتَ يا ظَمَأَ الكَلَامِ، ويا دَمًا","خَلفَ المَلَامِ يَمُجُّهُ حَلَّاجُهُ",51,"ج",2,0],["يا أنتِ لي أنساً الوذُ لِفَيْئِهِ","مِنْ هاجِراتٍ تستَعِرُّ وتحرُقُ",52,"ق",1,0],["يا أنتَ: يا عشقي وحلمَ أنوثتي","أهواكَ، ما نمَّ العواذلُ وادَّعوا",53,"ع",3,0],["يا أنتِ صَدَّقتُ الحديثَ وإنَّما","جَزَعي منَ الجهلِ الذي أخشى أذاه",54,"ا",2,0],["يا أنتِ يا قارورةَ البَهجاتِ ضمْ","مِيْني إلى مغناكِ عشقاً واستزيدي",55,"د",2,0],["يا أنت إني من هواك أظنني","في موطن الأحلام والتشويق",56,"ق",1,0],["يا أنتَ يا كلَّ الصباحاتِ الَّتِي","فيها عرفتُ الحبَّ والأحبابا",57,"ب",2,0],["يا أنتِ يا سِرّ المَنافي المُوجِعاتِ","وطِلْسمَ الوَجِدِ الّذي لا يُقْرَأُ",58,"ا",1,0],["يا أنتِ في بحري سفينةُ خافقي","وأنا لقلبِكِ رَائِدُ الإبْحَارِ",59,"ر",1,0],["ياأنتِ يا موج البحار ومركبي","كيف السبيلُ إذا أردتُ تودّدا",60,"د",2,0],["ياأنتَ ياسبّاحُ إنّ شواطئي","قالت هو الغوّاص حين تهجّدا",60,"د",2,0],["ياأنتَ أنتَ الأنا والرّوح واحدة","ذاتٌ تسامت لقولٍ قُدَّ من قُبُلِ",61,"ل",1,0],["يا أنت فيضاً من الألوان يغمرني","خذني إليك كما أهوى ولا تُبْقِ",62,"ق",1,0],["يا أَنْتِ هل كنتِ فعلا رهن معتقل","مشدودة في دجى ليل بأغلال",63,"ل",1,0],["يا أنتَ، إنّك في جَناني واحدٌ","ولأنتَ للروحِ المشُوقةِ توْأمُ",64,"م",1,0],["يا انتي لا غدا ذنبك كبير وصعب تبريره","أنا من وين ألاقي لك عذر وأراضي شجوني",65,"ن",2,0],["يَا أنْتِ يَا كُنْهَ الحَقِيْقَةِ فِيْ دَمِي","فِيْضِيْ عَليََّ حَدَائِقاً وَسِلالا",66,"ل",2,0],["يَا أَنْتَ يَا بُؤسًا تُجَاهِدُهُ","باللهِ هَلاَّ قُلْتَ مَنْ أَنْتَا ؟!",67,"ت",2,0],["يَا أَنْتِ يَا جَنَّتِي يَا نَبْعَ أُغْنِيَتِي","ظَمْآنُ صَبُّكِ يا سَمْرَاءُ فَاسْقِيه",68,"ي",2,0],["يَا أنْتِ يَا شَوْقِيْ أنَا يَا رَوْعَةً","تَتَنَبَّتُ فِيْ لُغَةِ الْهَوَى عِشْقًا سَمَا",69,"م",2,0],["يا أنْتِ..! يَا أزَلاً هَاجَتْ جَوَانِحُهُ","نَأيُ السِّنِينَ سَيَضْوي بَعدهُ المَدَدُ",70,"د",1,0],["يَا أنِينَ النَّايَ حنِّي","زَمِّليْنِي بَالأمَانِيْ",71,"ن",2,1],["يا أنتي ./ والبصيص اللي دمنته بغية أن تأتون","__________ سما ./ وإلا خطا ./ وإلا أحد يغتالني زوره",72,"ر",2,0],["يا أنتِ كفكفي دمعكَ وتجملي","وأعيدي ملمسكِ على اﻷغصانِ",73,"ن",1,0],["يا أنتَ سيري في اﻷنام قصيدةً","في الخلدِ باقيةً لكلِ زمانِ",73,"ن",1,0],["يا أنيسَ الروحِ مهلاً","حالتي أمستْ خَطِيْرَةْ",74,"ر",2,0],["يَا أَنتِ : يَا جِنِّيَّةً سَكَنَتْ","قَلبِي الَّذِي صَيَّرتُهُ قَصرَا",75