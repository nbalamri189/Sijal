يف"],[430,"وردية الخد بالوردي قد خطرت","https://www.aldiwan.net/poem40073.html","البسيط"],[433,"وغني الجمال يشرق خدا","https://www.aldiwan.net/poem12622.html","الخفيف"],[438,"كل يوم لي من صدودك حاله","https://www.aldiwan.net/poem2501.html","الخفيف"],[438,"هذه الدار والخيام الخيام","https://www.aldiwan.net/poem2543.html","الخفيف"],[438,"مال في الحب على ضعيفي وملا","https://www.aldiwan.net/poem2545.html","الرمل"],[438,"هي بشرى الإسلام والأيام","https://www.aldiwan.net/poem2569.html","الخفيف"],[438,"أأستجبر عليهم دمعي الجاري","https://www.aldiwan.net/poem2595.html","البسيط"],[454,"قال الصديق وديع في سوانحه","https://www.aldiwan.net/poem61240.html","البسيط"],[459,"تعجب من صبري على ألوانِها","https://www.aldiwan.net/poem55823.html","الرجز"],[459,"مالك لا تطرب يا حادي النعم","https://www.aldiwan.net/poem55901.html","الرجز"],[459,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[459,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[459,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[465,"قبح الله آب ما آب شهراً","https://www.aldiwan.net/poem3132.html","عموديه"],[465,"هذه دولة الندى والسماح","https://www.aldiwan.net/poem3162.html","عموديه"],[465,"للسعيد المجتبى فضل","https://www.aldiwan.net/poem3330.html","عموديه"],[465,"هذه حلبة الهوى والفراق","https://www.aldiwan.net/poem3481.html","عموديه"],[465,"لا والقدود الهيف حلفة وامق","https://www.aldiwan.net/poem3590.html","عموديه"],[469,"يا سائلي عن أصل ما قد رأى","https://www.aldiwan.net/poem59551.html","السريع"],[469,"يا صاح لا تصغ إلى لفظة","https://www.aldiwan.net/poem60331.html","السريع"],[480,"طال السبات فشأننا استلقاء","https://www.aldiwan.net/poem37618.html","الكامل"],[496,"لا والذي شق خمسي","https://www.aldiwan.net/poem9884.html","المجتث"],[501,"يا حداة العيس مهلا فالحمى","https://www.aldiwan.net/poem37639.html","الرمل"],[514,"لم يكفك الهجر فأهديت لي","https://www.aldiwan.net/poem67692.html","السريع"],[514,"وقائل كيف تهاجرتما","https://www.aldiwan.net/poem67720.html","السريع"],[516,"دم أبا فاتك حليف بقاء","https://www.aldiwan.net/poem12000.html","الخفيف"],[530,"لم يكون النوح ياور","https://www.aldiwan.net/poem37401.html","مجزوء الرمل"],[539,"لم يكن لي من المدام نصيب","https://www.aldiwan.net/poem47582.html","عموديه"],[539,"طال مني لذا النهار ارتقابي","https://www.aldiwan.net/poem48296.html","عموديه"],[552,"قل لقوم شنوا المعاتب منهم","https://www.aldiwan.net/poem47170.html","الخفيف"],[552,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"],[552,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[552,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[554,"قل لمن تاه إذ بنا عز جهلا","https://www.aldiwan.net/poem68326.html","الخفيف"],[559,"كل أمر ترجوه من مخلوق","https://www.aldiwan.net/poem34296.html","الخفيف"],[559,"لم يكن ذا الكون قط","https://www.aldiwan.net/poem34408.html","مجزوء الرمل"],[559,"حبي الذي بين موتي والبقا خير","https://www.aldiwan.net/poem34488.html","المواليا"],[563,"أهدى من الثمر الجني قطوفا","https://www.aldiwan.net/poem52752.html","البسيط"],[568,"شارفتنا طلائع المهرجان","https://www.aldiwan.net/poem69480.html","الخفيف"],[568,"خرجت أقبح المخارج منه","https://www.aldiwan.net/poem69532.html","الخفيف"],[568,"يا لقوم للزائر المجتاز","https://www.aldiwan.net/poem69643.html","الرجز"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[576,"يا معرضاً قد آن أن تقبلا","https://www.aldiwan.net/poem2887.html","السريع"],[576,"قال قلبي إذ قلت يا قلب أبشر","https://www.aldiwan.net/poem2986.html","الخفيف"],[587,"دمع تناثر عقده","https://www.aldiwan.net/poem17489.html","مجزوء الكامل"]],"verses":[["لَم يَكُن غَيرَ قَبسَةِ الفَرِقِ العَج","لانِ وَلّى وَنَهلَةِ الظَمآنِ",0,"ن",1,0],["لَم يَكُن غَيرَ خَطرَةِ البَرقِ ما زَو","وَدَ عَينَ المَشوقِ إِلّا وَمضا",1,"ض",2,0],["لَم يَكونوا إِلا كَرَكبٍ تَأَنّى","بُرهَةً في مُناخِهِ ثُمَّ سارا",2,"ر",2,0],["لَم يَكَد يُمتِعُها الدَهرُ بِهِ","في رُبوعِ النيلِ حَيّاً لَم يَكَد",3,"د",1,0],["لَم يَكَد يَنعَمُ الفَقيرُ بِعَيشٍ","مِن نَداهُ وَفَيضِهِ الحاتِمِيِّ",4,"ي",1,0],["لَم يَكُن مُلحِداً وَلَكِن تَصَدّى","لِشُؤونِ المُهَيمِنِ الوَهّابِ",5,"ب",1,0],["لَم يَكُن فيزوفُ أَدهى حِمَماً","مِن كُراتٍ تَنفُثُ المَوتَ الزُؤاما",6,"م",2,0],["لَم يَكسُ عارِضَهُ السَوادُ وَإِنَّما","نَفَضَت عَلَيهِ صِباغَها الأَحداقُ",7,"ق",1,0],["لَم يَكفِ صَرفَ الدَهرِ دَفنُكَ في الثَرى","حَتّى نَأَت بِكَ عَن دِمَشقَ الدارُ",8,"ر",1,0],["لَم يَكُن هَجرُ حَبيبي عَن قِلى","لا وَلا ذاكَ التَجَنّي مَلَلا",9,"ل",2,1],["لَمْ يَكُنْ فِي الشَّرْقِ وَاحَرَبَا","كَرَمٌ مِنْ ذَلِكَ الضَّرْبِ",10,"ب",1,0],["لم يكفك اليوم الرواء الذي","يألفه في حسنك المجتلي",11,"ل",2,0],["لَمْ يَكُنْ ذَلِكَ الْوَزِي","رِ الَّذِي يَحْفِزُ الذِّمَمْ",12,"م",1,0],["لِمَيٍّ كَأَنَّ القَطرَ وَالريحَ غادَرا","وُحولاً عَلى جَرعائِها بُردَ ناشِرِ",13,"ر",1,0],["لم يكفه أنه للحكم مغتصب","حتى غدا يقتل الآراء والفكرا",14,"ر",2,0],["لم يكفها أنها احتياج","حتى غدت حومة البلاء",15,"ا",2,0],["لم يكف أن شرعتْ رماح قدودِها","حتَّى عقدنا على الرِّماحِ عصائِبا",16,"ب",2,0],["لم يكف أن جلَّى الخطوب عن الورى","حتَّى جلا بعلومه ظلماتها",17,"ت",3,0],["لم يكس في حلل العلياء يوسعها","حتَّى لها عن قدود البيض في الحلل",18,"ل",1,0],["لم يكن فيهما من الفضل إلا","فاصلاتُ الألقاب والأسماءِ",19,"ا",2,0],["لم يكن خَفْضُها أحبَّ إليها","من رسيم إليه بعد خبيبِ",20,"ب",1,0],["لم يكُنْ بالكَنُودِ فيما نَثا عَنْ","كَ ولا كنْتَ في الجَدَا بكَنُودِ",21,"د",1,0],["لم يكن ما كان شيئاً يُعتمدْ","بل أموراً وافقت يوم الأحدْ",22,"د",1,1],["لم يَكِلها إلى النشيد مُجِيدٌ","صاغها من رقاده بل سُهادِهْ",23,"د",2,0],["لم يُكانفْهُ على الأمر امرؤ","إنه أوْحَدُ من قوْمٍ وحادِ",24,"د",1,0],["لم يكن إلا سروراً كلهُ","وحبوراً وحباءً للجليس",25,"س",1,0],["لم يكن من حُلَى الخَبِيثَين لكن","من حُلى كل ماجد نِقْريس",26,"س",1,0],["لم يكن آفةُ القَصيدةِ إلا","ذاك فاترك مقال ذي التلبيس",26,"س",1,0],["لم يكن صاعدٌ مكاناً لمدحٍ","لا ولا موضعاً لقوْدِ خَميس",26,"س",1,0],["لم يكن ملكُك يُرضي","مَلِكَ السبع الطباق",27,"ق",1,0],["لم يكنْ للصّفاحِ لولا عليٌّ","شوكةٌ في العدى ولا للإلالِ",28,"ل",1,0],["لم يكن مثله يُولَّى ولكن","حفظوا في الحديث حقَّ القديمِ",29,"م",1,0],["لم يكونا ليرضَيا غيرَ دين","يرتضيه الأميرُ في الأديانِ",30,"ن",1,0],["لم يكن يبتني المساكن حتى","يتقن المجدَ أيَّما إتقانِ",30,"ن",1,0],["لم يكن يَرتَضيه سمعُك للصن","عةِ حتى يسير في البلدان",30,"ن",1,0],["لم يكن مثله يرى الله مقرو","ناً به في اسمه مع الطغيان",30,"ن",1,0],["لَم يَكُن لي الَّذي أَرَدتُ فَحَسبي","أَنَّني بِالمُنى مَلَأتُ وِطابي",31,"ب",2,0],["لَم يَكُن بَل كانَ لَكِن ذَهَبا","وَاِنقَضى حَتّى كَأَن لَم يَكُنِ",32,"ن",1,0],["لَم يَكُن إِلّا كَبَرقٍ وَمَضا","وَإِذا الدُكتورُ مِن مَهدي قَريب",33,"ب",1,0],["لَم يَكُن خائِناً وَلا إِمعِيّا","عاشَ في الأَرضِ مِثلَ زَهرِ البَنفسَج",34,"ج",1,0],["لَم يَكُن كُلُّ عَبقَرِيٍّ يَتيماً","إِنَّما كانَ كَاليَتيمِ صَبِيّا",35,"ي",2,0],["لَم يَكُن مِثلي عَن مِثلِ","كَ يا مَولايَ يَسلو",36,"ل",2,0],["لَم يَكسِرِ النَومُ عَينَي عَن مَحاسِنِها","حَتّى اِنثَنَيتُ وَعَينُ النَجمِ مُنكَسِرَه",37,"ر",2,0],["لَم يَكُن يَنسى لَكَ اللَ","هُ اِبتِهالَ الفُقَراءِ",38,"ا",2,0],["لم يكن فقد شاعر النيل إلا","كارثا من جراه ريع الجميع",39,"ع",1,0],["لم يكن بالخفيف عبؤك لكن","حب مصرا مدمنك الفؤادا",40,"د",2,0],["لم يكن كل الناس ناسا بحق","رب قوم يحيون كالأنعام",41,"م",1,0],["لم يكن ما أصوبه بدموع","إنها حزن في عيوني مذاب",42,"ب",1,0],["لم يكن ما استطاع كشفا له العلم الى","يومنا سوى شذرات",43,"ت",1,0],["لم يكن في ظنى ولا ظن غيري","ان ضوء الشعرى العبور يزول",44,"ل",1,0],["لم يكن ما نظمته من رثاء","لك اصفى من دمعي الرقراق",45,"ق",1,0],["لم يكن ما قد بان يومئذ لي","غير طيف من الحقيقة خال",46,"ل",1,0],["لم يكذب الدهر فيما قال معتذرا","حتى يسفهه دحض وتفنيد",47,"د",1,0],["لم يكن لي ذنب سوى انني رم","ت بشعري لامة تحريرا",48,"ر",2,0],["لم يكن في نوائب الدهر ظني","أنها هكذا بنا تستبد",49,"د",1,0],["لم يكفك الرزء في ملكي وفي وطني","وفي شبابي وفي صفوي وأعيادي",50,"د",2,0],["لَم يَكُن في غُلُوِّهِ ضَيّقُ الصَد","رِ وَلا كانَ عاجِزاً في اِعتِدالِه",51,"ل",2,0],["لَم يَكُن طَوقاً وَلَكِن ضَرَما","ما عَلى لَبَّتِهِ مِن قَبَسِ",52,"س",1,0],["لَم يَكفِهِم شَطرُ النُبوغِ فَزُدهُمُ","إِن كُنتَ بِالشَطرَينِ غَيرَ جَوادِ",53,"د",1,0],["لَم يَكفِ أَن أَحسَنَّ حَت","تى زِدنَ حَضَّ المُحصَناتِ",54,"ت",1,0],["لَم يَكُن ذاكَ مِن عَمىً كُلُّ عَينٍ","حَجَبَ اللَيلُ ضَوءَها عَمياءُ",55,"ا",2,0],["لَم يَكُن في حِسابِهِ يَومَ رَبّى","أَن سَيَأتي ضِدَّ الجَزاءِ الجَزاءُ",55,"ا",2,0],["لم يكفني أن عِشْتُ بعدَ فِراقهِ","حتى ابتُلِيتُ من الشَّقاءِ بفَقْدِهِ",56,"د",2,0],["لَم يَكُن جَمعُهُم عَلى المَوجِ إِلّا","زَبَداً طارَ عَن قَناكَ جُفاءَ",57,"ا",2,0],["لَم يَكُن نَيلُهُ الجَزيلُ وَقَد رُمنا","هُ صَعباً فَكَيفَ يَصعُبُ بابُه",58,"ب",2,0],["لَم يَكُن سَعيُهُ هُناكَ بِمَرضِي","يٍ وَلا كانَ أَمرُهُ بِرَشيدِ",59,"د",1,0],["لَم يَكُن وَعدُهُ بَعيداً مِنَ النُج","حِ وَلا مُبطِئاً يَطولُ اِنتِظارُه",60,"ر",2,0],["لَم يَكُن وَسمُهُنَّ قَرضاً يُؤَدّي","هِ وَلا رِقُّهُنَّ عِلقاً يُعارُه",61,"ر",2,0],["لَم يَكُن دونَ ناجِزِ النُجحِ إِلّا","جاهُهُ يَلتَقي وَجودُ حَمولَه",62,"ل",2,0],["لَم يَكُن يَومُنا طَويلاً بِنَعما","نَ وَلَكِن كانَ البُكاءُ طَويلا",63,"ل",2,0],["لَم يَكفِهِ نَأيُ الأَحِبَّةِ بِاللِوى","حَتّى ثَنَيتَ عَلَيهِ لَومَ العُذَّلِ",64,"ل",1,0],["لَم يَكُن شيَمَ نَسي","مُ المِسكِ مِن أَخلاقِ حالِه",65,"ل",2,0],["لَم يَكُن بِالكَريمِ فِعلاً وَلا البا","رِعِ فَضلُ بنِ عَبدِ الكَريمِ",66,"م",1,1],["لَم يَكُن ماءُ بَحرِهِم بِأُجاجٍ","لا وَلا نَبتُ أَرضِهِم بِوَخيمِ",67,"م",1,0],["لَم يَكُن قَلبُكَ الرَقيقُ رَقيقاً","لا وَلا وَجهُكَ المَصونُ مَصونا",68,"ن",2,0],["لَم يَكسُني الدَهرُ يَوماً مِن مَسَرَّتِهِ","إِلّا جَرى مِنهُ مَكروهٌ بِتَجريدِ",69,"د",1,0],["لَم يَكفِني جَمعي لِضَعفِ يَقيني","حَتّى اِستَطَلتُ بِهِ عَلى المِسكينِ",70,"ن",1,1],["لَم يَكُن ذاكَ عَن شُعوري وَلَكِن","أَنتَ تَدري بِأَنَّني لَستُ أَدري",71,"ر",2,0],["لَم يَكُن أَوهى قوًى مِن خَصرِهِ","غَيرُ صَبري عَنهُ أَو ميثاقِهِ",72,"ق",2,0],["لَم يَكُ تَحريضي لَكُم إِساءَةً","وَلَم أَحُل في القَولِ عَن آدابِهِ",73,"ب",2,0],["لَم يَكُنْ ما ظَنَنتِ حَقّاً ولَكِن","صبغةَ الوَجْدِ صِبْغُ دمْعيَ أَحمَر",74,"ر",1,0],["لَم يُكسَ شَخصٌ فَيئَهُ حَتّى رَمى","وَقتُ الزَوالِ نَعيمَهُم بِزَوالِ",75,"ل",1,0],["لَم يَكُن مِن عِتابِنا بِسَبيلٍ","فَتَرى أَنَّ ما عَنانا عَناكا",76,"ك",2,0],["لَم يَكحَلِ السُهدُ جَفنَهُ كَلَفاً","وَلا طَوى جِسمَهُ الغَرامُ ضَنى",77,"ن",2,0],["لم يَكُنْ دُونَ أن يبيدَ مَحيصٌ","لَيْتَهُ بَاهَلَ النَّبيَّ فَبادا",78,"د",2,0],["لَم يَكُن ذاك بإختٍِيَارِي ولَكِن","كَان أمراً مُقَدَّراً مَقضِيَّا",79,"ي",2,0],["لم يكن يُسكِرُ لولا","أنه مسَّ الرُّضابْ",80,"ب",1,0],["لَم يَكُن ما رَجَوتُ حَتّى تَرحّل","تُ فَمَن ظالم وَمَن مَظلومُ",81,"م",1,0],["لَم يَكُن مِثلُكِ لَولا","سَفَهِ الرَأيِ هَوىً لي",82,"ل",2,0],["لم يكفِها ما صنعت مرّة","برأس أيرٍ جوفها تاها",83,"ه",2,0],["لَم يَكُن بَينَها وَبَينِيَ إِلاّ","كُتُبُ العاشِقينَ وَالأَحلامُ",84,"م",1,0],["لَم يَكُن لي رَبٌّ سِوى اللَهِ يا عَب","دَ فَما لي اِتَّخَذتُ وَجهَكِ رَبّا",85,"ب",2,0],["لَم يَكُن لي عُرشٌ فَيُثلَمَ عَرشي","كَم جُروحٍ جُرِحتُها ذاتِ أَرشِ",86,"ش",1,1],["لَم يَكفِهِم ريقُ كَرمٍ مِن شَرابِهِمُ","حَتّى أَضافوا إِلَيهِ مِن فَمٍ ريقا",87,"ق",2,0],["لَم يَكفِها نورُ خَدَّيها وَنورُ نَقاً","في ثَغرِها فَأَصارَت عَشرَها عَنَما",88,"م",2,1],["لم يكُنْ قَصْرُكَ المُنيفُ ليَسْتَنْ","زِلَ إلاّ أعْلى بناتِ القُصورِ",89,"ر",1,0],["لم يَكْتَنِفْني رَجاءٌ لا ولا أملٌ","إلا تَكَنَّفهُ ذُلٌّ وَإمْلاقُ",90,"ق",1,0],["لم يكن في الكتاب من خطأٍ كَل","لا ولكن قد أخطأ التفسير",91,"ر",1,0],["لم يكن فيهما يثير حناناً","جسدٌ لي دام ودمعٌ غزير",91,"ر",1,0],["لَم يكن عيشي هنا","لك إلا حلما",92,"م",2,0],["لَم يكن وضعه من الدين شيئاً","إنما قد أَتى من العادات",93,"ت",1,0],["لَم يَكُن ما جُرعتَه من دواء","كل تلك الأيام يغني فَتيلا",94,"ل",2,0],["لَم يكن مجلس الإدارة إِلّا","آلة في يديه تُمضي القرارا",95,"ر",2,0],["لَم يكن من قد حسبنا","ه أميناً بأمين",96,"ن",1,0],["لَم يكن لها وزر","لم يكن لها نشب",97,"ب",1,0],["لَم يكن لها عَلم","ثم عسكر لجب",97,"ب",1,0],["لَم يَكُن عند وَصفها حين تَبدو","لا مَديحي شَيئاً وَلا إطرائي",98,"ا",2,0],["لَم يكن يشبه عزي","فيك في العالم عز",99,"ز",1,0],["لم يكن شاعرَ القديم ولا كا","ن لآداب عصرِهِ يتعصّبْ",100,"ب",1,0],["لم يكنْ غ