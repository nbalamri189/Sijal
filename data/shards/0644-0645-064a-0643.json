ِ",122,"د",1,0],["لم يَكُنِْ منْهُ غَيْرُ وَمْضٍ منَ الأزْ","هَرِ يَبْدُو مُفَزَّعَ اللَّمَحَاتِ",123,"ت",1,0],["لم يكدِّرْ صفاءَها ثُكْل أُمٍّ","ليس فيها على عزيز بكاءُ",124,"ا",2,0],["لم يكن طه لعَمْري ساحرًا","يخرِقُ العادات يَتْلو رُقاة",125,"ا",2,0],["لم يكن غير أجير ، لا تخف","إن أغبى منك ، من سوف يؤجر",126,"ر",1,0],["لم يكد شعبه يذوق هناء","منه حتّى بكى وأبكى وناحا",127,"ح",2,0],["لم يكن ثائرا ، على أيّ حال","إنما قد يثوّر الآن جيلا",128,"ل",2,0],["لمْ يَكُنْ سَعْيُهُ هُنَاكَ بمَرْضِيٍّ،","وَلاَ كَانَ أمْرُهُ بِرَشِيدِ",129,"د",1,0],["لم يَكُنْ بالكَريمِ فِعْلاً ، ولا الْبَارِعِ","فَضْلاً ، فَضْلُ بْنُ عبد الكَريمِ",130,"م",1,1],["لم يكن كلّ عبقريّ يتيما","إنّما كان اليتيم صبيّا",131,"ي",2,0],["لم يكن موته فراقا ولكن","هذه أوبة الخيال البعيد",132,"د",1,0],["لَمْ يَكُ كَالسَّيِّدِ فِي قَوْمِهِ","بلْ ملكٌ دينَ لهُ بالحقوقْ",133,"ق",1,0],["لَم يَكفروا نَعماكَ لَكن ساقَهُم","قَدر الإِلَه لِوَرطة وَمَهالك",134,"ك",1,0],["لم يكن أصله كريما وما إن","قال للوالدين قولا كريما",135,"م",2,0],["لم يكن في إدَارَةِ الكأسِ ذَمُّ","لِفِتِىٍّ بِهم فِتِىٌّ ألَمُّوا",136,"م",3,1],["لَم يَكُن وَاقِعَ المَعَاني","والألفَاظِ بِذِى التَّكلِيفِ والتَّقطِيعِ",137,"ع",1,0],["لَم يَكُن مَن هَجَاكَ هَاجِىَ شَخصٍ","إِنَّمَا أنتَ صُورَةٌ مِن رَجِيعِ",137,"ع",1,0],["لَم يَكُن خُلَّبَ البُروقِ وَلَكِن","هَاطِلُ البَذلِ دُونَ بَرقٍ سَارِ",138,"ر",1,0],["لَم يَكُن جَاعِلاً ذِهِ الدَّارَ دَاراً","وكَذَاكَ الدَّارِى الذي هُوَ دَارِ",138,"ر",1,0],["لَم يَكُ الصَّبُ إِن أُصِيبَ بِغَيرش ال","بَينِ في شِرعةِ الصُّبَاةِ مُصَابَا",139,"ب",2,0],["لم يكنَّ في مُحمدٍّ عيبٌ إلاَّ","أنَّهُ في إطَاعةِ اللهِ شابا",139,"ب",2,0],["لم يَكُ المصباحُ يعتري كُفئاً","لاَ تَظُنُّوه من أَكفَائِى",140,"ا",2,0],["لَم يَكسُ بَعدَ البَيتِ بَيتاً غَيرَهُ","هَل في البُيوتِ أَحَقُّ مِنهُ بِذاكا",141,"ك",2,0],["لَم يَكفِها الإِسراجُ يَومَ بَعَثتَها","شَرَّ العُيونِ فَعَمَّها التَجليلُ",142,"ل",1,0],["لَم يَكفِكَ الشَرَفُ الَّذي وُرِّثتَهُ","حَتّى شَفَعتَ مَعالِياً بِمَعالي",143,"ل",2,0],["لم يكن ما لقيته مذ تناءيت","من الوجد