{"poems":[[53,"عاد الهوى بظباء مك","https://www.aldiwan.net/poem29630.html","مجزوء الكامل"],[53,"بغير شفيع نال عفو المقادر","https://www.aldiwan.net/poem30465.html","الطويل"],[53,"أثر الهوادج في عراص البيد","https://www.aldiwan.net/poem30633.html","الكامل"],[55,"دعيني أمت لم آت في الحب بدعة","https://www.aldiwan.net/poem26405.html","الطويل"],[34,"ألا يا غراب البين هل أنت مخبري","https://www.aldiwan.net/poem4895.html","الطويل"],[34,"وخبرتماني أن تيماء منزل","https://www.aldiwan.net/poem4943.html","الطويل"],[42,"لعمرك مرسوع من آل مجالد","https://www.aldiwan.net/poem50337.html","الطويل"],[42,"ألا ابلغا عني حصينا رسالة","https://www.aldiwan.net/poem50402.html","الطويل"],[42,"وأهوج ملجاج تصاممت قيله","https://www.aldiwan.net/poem50465.html","الطويل"],[24,"نفى شعر الرأس القديم حوالقه","https://www.aldiwan.net/poem21873.html","الطويل"],[86,"بنات الشعر بالنفحات جودي","https://www.aldiwan.net/poem10690.html","الوافر"],[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[86,"سيرا أيا بدري سماء العلا","https://www.aldiwan.net/poem68845.html","السريع"],[86,"وافى كتابك يزدري","https://www.aldiwan.net/poem68852.html","مجزوء الكامل"],[35,"صحا قلبه يا عز أو كاد يذهل","https://www.aldiwan.net/poem39111.html","الطويل"],[27,"أزرت ديار الحي أم لا تزورها","https://www.aldiwan.net/poem5767.html","الطويل"],[37,"فلما رأى الجوزاء أول صابح","https://www.aldiwan.net/poem7515.html","الطويل"],[47,"أشاقك الطيف ألم طارقه","https://www.aldiwan.net/poem25220.html","الرجز"],[47,"ما زال معتلج الهموم بصدره","https://www.aldiwan.net/poem25274.html","الكامل"],[23,"عرفت ديار زينب بالكثيب","https://www.aldiwan.net/poem21247.html","الوافر"],[72,"أوجز مديحك فالمقام عظيم","https://www.aldiwan.net/poem19667.html","الكامل"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[51,"مكر الزمان علينا غير مأمون","https://www.aldiwan.net/poem66416.html","البسيط"],[91,"سفرت فقلت لها أهذا كوكب","https://www.aldiwan.net/poem8740.html","عموديه"],[92,"أي ناس هذا الورى ما رأى","https://www.aldiwan.net/poem38889.html","الخفيف"],[92,"إني أرى فأرى جموعا جمة","https://www.aldiwan.net/poem38968.html","الكامل"],[92,"سأعيش رغم الداء والأعداء","https://www.aldiwan.net/poem38976.html","الكامل"],[89,"قد جاء يا أم وقت فوتي","https://www.aldiwan.net/poem44940.html","مخلع البسيط"],[85,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[62,"إذا لم يعن قول النصيح قبول","https://www.aldiwan.net/poem52321.html","الطويل"],[45,"إِذا شئت فاندبني إِلى الراحِ وانعني","https://www.aldiwan.net/poem66634.html","الطويل"],[66,"زحاف الشعر قبض ثم كف","https://www.aldiwan.net/poem38648.html","الوافر"],[66,"هويته تحت أطمار مشعثة","https://www.aldiwan.net/poem40107.html","البسيط"],[44,"تلقاه طيفي في الكرى فتجنبا","https://www.aldiwan.net/poem30281.html","الطويل"],[31,"من عاشق صب يسر الهوى","https://www.aldiwan.net/poem41320.html","السريع"],[46,"عبر الشباب لأمه العبر","https://www.aldiwan.net/poem22589.html","الكامل"],[46,"أرى الشهد يرجع مثل الصبر","https://www.aldiwan.net/poem22754.html","المتقارب"],[19,"تنكر بعدي من أميمة صائف","https://www.aldiwan.net/poem351.html",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39562","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39612","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39654","الرمل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9958","الوافر"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21117","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42521","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55127","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43692","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54249","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54193","الخفيف"],[96,"المدينة الباسلة","https://www.poetsgate.com/ViewPoem.aspx?id=17897",""],[98,"شاعر يترك الخيال كسيحا","https://www.poetsgate.com/ViewPoem.aspx?id=55333",""],[90,"دجلة في الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=179208",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"حافظ إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=179126",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[31,"من عاشقٍ صبٍّ يسرُّ الهوى ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19084&r=&rc=346",""],[96,"حافظ ابراهيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66351&r=&rc=27",""],[127,"عزّ التأسّي وفاض الدمع هتانا","https://www.aldiwan.net/poem792.html",""],[144,"هل العدل إلا دون ما أنت مظهر","https://www.aldiwan.net/poem11762.html","الطويل"],[165,"ديار الحي بالرس","https://www.aldiwan.net/poem67584.html","الهزج"],[187,"عركتني الأيام عرك الدابغ","https://www.aldiwan.net/poem43622.html","الكامل"],[194,"وباخل يبدي لنا","https://www.aldiwan.net/poem13049.html","مجزوء الرجز"],[211,"يا صاحبي نأى من كان في وطني","https://www.aldiwan.net/poem13397.html","البسيط"],[238,"ما للأحبة أسياف الجفا اخترطوا","https://www.aldiwan.net/poem18841.html","البسيط"],[306,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[306,"برق به أفق الرجاء أنارا","https://www.aldiwan.net/poem56540.html","الكامل"],[329,"بين يأسي وحيرتي ورجائي","https://www.aldiwan.net/poem54993.html","الخفيف"],[329,"يا ليل قد طلع الصباح","https://www.aldiwan.net/poem55076.html","مجزوء الكامل"],[349,"نفق الإكديش يا منتخب","https://www.aldiwan.net/poem19909.html","مجزوء الرمل"],[365,"نمت بأسرار ليل كان يخفيها","https://www.aldiwan.net/poem60595.html","البسيط"],[372,"حكم الهوى جر عليك الجرة","https://www.aldiwan.net/poem57449.html","السريع"],[395,"في أحضان الطبيعة","https://www.aldiwan.net/poem24309.html","عموديه"],[407,"أبا الفضل طال الليل أم خانني صبري","https://www.aldiwan.net/poem50177.html","الطويل"],[410,"كف عني واش وأغضى رقيب","https://www.aldiwan.net/poem32148.html","الخفيف"],[438,"إن دمعا طلعا وقلبا أسيرا","https://www.aldiwan.net/poem2527.html","الخفيف"],[440,"أضاء لها فجر النهى فنهاها","https://www.aldiwan.net/poem34917.html","الطويل"],[459,"ظن غداة الخيف أن قد سلِما","https://www.aldiwan.net/poem55900.html","الرجز"],[459,"حملت ركاب الغرب شمس شروق","https://www.aldiwan.net/poem56100.html","الكامل"],[459,"أرأيت أم حبست لحاظك عبرة","https://www.aldiwan.net/poem56150.html","الكامل"],[459,"خصيماي من ظمياء واش وشامت","https://www.aldiwan.net/poem56262.html","الطويل"],[462,"خفضا لا موت الا بأجل","https://www.aldiwan.net/poem15467.html","الرمل"],[462,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"],[484,"هجرت أمامة هجراً طويلا","https://www.aldiwan.net/poem2071.html","المتقارب"],[494,"ولقد صحبت الدهر صحبة عارف","https://www.aldiwan.net/poem67381.html","الطويل"],[552,"ألا عوجا لمجتمع السيال","https://www.aldiwan.net/poem47286.html","البسيط"],[552,"بنقا الرمث من شراف غزال","https://www.aldiwan.net/poem47338.html","الخفيف"],[552,"لغير الغواني ما تجن الأضالع","https://www.aldiwan.net/poem47726.html","الطويل"],[552,"أترى يؤوب زماننا","https://www.aldiwan.net/poem47734.html","مجزوء الكامل"],[552,"وخبرتها يوم التقينا بذي النقا","https://www.aldiwan.net/poem47857.html","الطويل"],[574,"وخبرني الناعون ما صنع الردى","https://www.aldiwan.net/poem3657.html","الطويل"],[576,"لا تسل عنه كيف أصبح حاله","https://www.aldiwan.net/poem3028.html","الخفيف"]],"verses":[["وَخَبَت عَليكَ مِنىً تَبا","ريحَ الغَرامِ وَما زَهاها",0,"ا",3,0],["وَخَبَّت عَلى بَيداءَ تَشرَقُ ماءَها","عَنِ الرَكبِ في طَيِّ العُيونِ الغَوائِرِ",1,"ر",1,0],["وَخَبَطتُ في المُتَعَرِّضينَ بِقَولَةٍ","جَدّاءَ مِن بِدَعِ الزَمانِ شَرودِ",2,"د",1,0],["وَخَبَّرتِني عَن هَجرِها فَنَعَيتِ لي","حَياتي وَكانَ الهَجرُ لِلمَوتِ مَوعِدا",3,"د",2,0],["وَخَبَّرتَ أَن قَد جَدَّ بَينٌ وَقَرَّبوا","جِمالاً لِبَينٍ مُثقَلاتٍ مِنَ الغَدرِ",4,"ر",1,0],["وَخَبَّرتُماني أَنَّ تَيماءَ مَنزِلٌ","لِلَيلى إِذا ما الصَيفُ أَلقى المَراسِيا",5,"ي",2,1],["وَخُبِّرتُهُ أَهدى جَزوراً سَمينَةً","أَتَمَّ الحِبا أَن لَو أَجَدَّ ثيابَكا",6,"ك",2,0],["وَخَبَّرَني مَن كُنتُ أَرسَلتُ إِنَّما","أَخذتَ كِتابي مُعرِضاً بِشِمالِكا",7,"ك",2,0],["وَخَبٍّ لُحومُ الناسِ أَكثَرُ زادِهِ","كَثيرِ الخَنى بَعدَ المَحالَةِ هَمّاسِ",8,"س",1,0],["وَخُبِّرنَ ما بَينَ الأَخاديدِ واللِوى","سَقَتهُ الغَوادي وَالسَواري طَوارِقُهُ",9,"ق",2,0],["وَخَبِّرهُم وَأَنتَ بنا خَبيرٌ","بِأَنَّ الذُلَّ شِنشِنَةُ العَبيدِ",10,"د",1,0],["وخَبَأَتْ دُفَّها في ثَوبِها فَرَقاً","منه ووَدَّتْ لو أنّ الأرضَ تَطويها",11,"ي",3,0],["وَخَبِّرا الغَربَ وَأَبناءَهُ","بِأَنَّنا نَحنُ الرِجالُ الأُلى",12,"ل",2,0],["وَخَبَأتَ في أَلفاظِها","مِن كُلِّ مَعنىً مُسكِرِ",13,"ر",1,0],["وَخَبَّرَها الواشونَ أَنّي صَرَمتُها","وَحَمَّلَها غَيظَاً عَلَيَّ المُحَمِّلُ",14,"ل",1,0],["وَخَبَّثَ حَوضَ الخورِ خورِ مُجاشِعٍ","رَواحُ المَخازي نَحوَها وَبُكورُها",15,"ر",3,0],["وخَبَّ السَّفا واستبطن الفحلُ والتقت","بامعزها بُقْعُ الجنادِب ترتكِلْ",16,"ل",1,0],["وَخَبُثَت عَلى الفَتى طَرائِقُه","أَعدى أَعاديهِ بِهِ يُصادِقُه",17,"ق",2,0],["وَخَبَرتُ هَذا الدَهرَ خِبرَةَ ناقِدٍ","حَتّى أَنِستُ بِخَيرِهِ وَبِشَرِّهِ",18,"ر",2,0],["وَخَبِّر بِالَّذي لا عَيبَ فيهِ","بِصِدقٍ غَيرِ إِخبارِ الكَذوبِ",19,"ب",1,0],["وخبت بهِ نيران فارس آية","يدري بها من قبل إبراهيم",20,"م",1,0],["وخَبيءُ الفؤاد يعلمه العا","قلُ قبلَ السماع بالإيماءِ",21,"ا",2,0],["وخَبَّرتنا بأنَّا مِنْ فرائسها","نواطقاً بفصيح غيرِ مَلْحون",22,"ن",1,0],["وَخَبَرتُهُنَّ فَما لِبِكرٍ حُرمَةٌ","تَرعى وَأَغدَرُ مَن رَأَيتُ الثَيِّبُ",23,"ب",1,0],["وخبيثٍ يعيشُ كالفأسِ هدَّا","ماً ليُعْلي بَيْنَ الخَرابِ بناءهْ",24,"ا",2,0],["وخبا بهمْ لَهَبُ الوجودِ فما بقوا","إلاَّ كمحترقٍ من الأخْشابِ",25,"ب",1,0],["وخبا لهيبُ الكون في قلبي الَّذي","قد عاش مِثْلَ الشُّعْلَةِ الحمراءِ",26,"ا",2,0],["وخبريه يا أم أني","لساعة الموت قد ذكرته",27,"ه",1,0],["وَخَبَت مَساجِدُ كُنَّ نوراً جامِعاً","تَمشي إِلَيهِ الأُسدُ وَالآرامُ",28,"م",1,0],["وخبَّرني تقليبيَ الناسَ بُرهةً","بأنك فردٌ والأنامُ شُكُولُ",29,"ل",1,0],["وَخَبَّرتَني أَنَّ العَزاءَ تَكَرُّم","وَهَل يَتَعَزّى عَنهُ غَيرُ لَئيمِ",30,"م",1,0],["وَخَبنٌ ثُمَّ طَيٌّ ثُمَّ عَصبٌ","وَعَقلٌ ثُمَّ إِضمارٌ وَوَقصُ",31,"ص",1,0],["وَخَبَّرَتني مَعانٍ في مَراسِمِهِ","بِهِ كَما خَبَّرَ العُنوانُ بِالصُحُفِ",32,"ف",1,0],["وَخُبِّرَ أَنّي قَد مَرَرتُ بِبابِهِ","لِأَخلِسَ مِنهُ نَظرَةً فَتَحَجَّبا",33,"ب",2,0],["وَخَبِّريني ما الَّذي عِندَكُم","بِاللَهِ في قَتلِ اِمرِئٍ مُسلِمِ",34,"م",1,0],["وَخَبَرتُهُم فَوَجَدتُ أَخبَرَهُم","مِثلَ الطَريدَةِ ما لَها خُبرُ",35,"ر",1,0],["وَخَبَّرَهُ صادِقٌ بِالحَديثِ","فَإِن شَكَّ في ذاكَ فَليَختَبِر",36,"ر",1,0],["وَخَبَّ سَفا قُريانِهِ وَتَوَقَّدَت","عَلَيهِ مِنَ الصَمّانَتَينِ الأَصالِفُ",37,"ف",1,0],["وخبا من مصابحِ الفكر نورٌ","كان أمضى من الشهاب وأثقبْ",38,"ب",1,0],["وخَبَتْ مَدافِعُهم وذاب حديدهم","والثَّلجُ يَعجبُ واللَّظى الموَّارُ",39,"ر",1,0],["وخبا المصباحُ إلَّا كأس راحِ","نورُهُ ما بين إِيماضٍ ووثبِ",40,"ب",1,0],["وَخَبِّر عَن عُبَيلَةَ أَينَ حَلَّت","وَما فَعَلَت بِها أَيدي اللَيالي",41,"ل",2,0],["وخَبَّرتِ العَصَا الأَنباءَ عَنهُ","وَلم أرَ مِثلَ فارِسِها هَجينا",42,"ن",2,0],["وَخَبِّرْهُ عَنِّي أَنَّنِي مُنْذُ بَيْنِهِ","أُكابِدُ هَوْلاً يَتْرُكُ الطِّفْلَ أَشْيَبَا",43,"ب",2,0],["وَخَبَا مِنْ جَبِينهِ نَجْمُ سَعْدٍ","طَالَمَا كَانَ ضَاحِكاً يَتَهلَّلْ",44,"ل",1,0],["وَخَبا نَجمي فَها أَنا ذا","لا سَنىً يهدي وَلا سَنَدُ",45,"د",1,0],["وَخَبَّ فِيها راكِباً رَأْسَهُ","لِلشرِّ ما خَبَّ وما أَوْضَعا",46,"ع",2,0],["وخُبّرت الأوثانُ أنَّ زمانَها","تولّى وراحَ الجهلُ والجهلاءُ",47,"ا",2,0],["وخبت مدافعهم وذاب حديدهم","والثّلج يعجب واللّظى موّار",48,"ر",1,0],["وخبا كل ساطع فى سماه","وذوى كل زاهر في جنانه",49,"ن",2,0],["وخَبَتْ فقلتُ : غفا ، وإنَّ صَدىً","في السَّمْعِ من زَفْرٍ يُصَعِّده!",50,"د",2,0],["وخبيئةٌ في الصدرِ نَفثُ دُخانها","حَرَجٌ ، وكَبْتُ أُوارها إيلام",51,"م",1,0],["وخَبَّرتنا القوافي عن أخي جَلَدٍ","صُلبِ الإرادةِ يُعْيي الدهرَ مأتاه",52,"ا",2,0],["وخبت للشقاء ناري إذا ال","برد قريس وليلتي ليلاء",53,"ا",2,0],["وَخَبِّرِيني ما کلَّذي عِنْدَكُمْ،","بِکللَّهِ، في قَتْلِ کمرِىء ٍ مُسْلِمِ؟",54,"م",1,0],["وخبا من مصباح الفكر نور","كان أمضى من الشّهاب وأثقب",55,"ب",1,0],["وخبّريهم بحال قد غدوت به","مضنًى وحيداً كئيب القلب ولهانا",56,"ن",2,0],["وَخُبرُ أَخيهِ رَدَّهُ عَنكَ سالِماً","وَباءَ بِمَحضِ الذُلِ مَن لَيسَ يَخبُرُ",57,"ر",1,0],["وَخَبِّرني عَنِ السَبت","وَسَعمِ الحُرَّةِ الخَيفَق",58,"ق",1,0],["وَخَبِّرني عَنِ الحانِ","طِ وَالوارِسِ إِذ يَبسُق",58,"ق",1,0],["وخبطتُ محترفا فضاقت حيلتي","وجلست جلسة عاجزٍ أو زائغ",59,"غ",1,0],["وَخُبزُهُ في حَرَمٍ","مِن أَكلِهِ وَكَسرِهِ",60,"ر",2,0],["وخبراه باني في مجاده","واستعطفاه بقول في مماجنة",61,"ه",1,0],["وَخَبَطُوا بِعَصَا أَشْوَاقِهِمْ كَبِدِي","مَا ضَرَّ لَوْ خَبَطُوا بِالْوَصْلِ مَنْ خَبَطُوا",62,"ط",3,0],["وَخبرٌ بِأنواعِ المَكائدِ مسندٌ","لِتجربةٍ تُنبي عَنِ الصوبِ والأخطا",63,"ط",2,0],["وَخبَرت منكرَ هزّتي طرباً ولم","أَظفر بِقولي كلّ آتٍ صارا",64,"ر",2,0],["وخبا الضوء غير إشعاعَةٍ سك","رى تحيّى المكان في استيحاء",65,"ا",2,0],["وخبا الضياء السرمدي","ي ومات كوكب حُبيه",66,"ي",2,0],["وخَبا البَرْقُ الذِي يَاطَالَما","بَاتَ في آثارِهِ يَلْتَهِبُ",67,"ب",1,0],["وخَبَّرتْ أنّها لا الحُزْنُ خامَرَها","بَلْ فَرحةُ النّفْسِ أبكاها تَناهيها",68,"ي",3,0],["وخبروني أنَّ طَيفاً سَرى","لغَيرهم عِند الذي أبصَرَه",69,"ر",2,0],["وخبت في كآبة الموت أصوا","ت الأغاني واستسلم القيثار",70,"ر",1,0],["وَخَبَّرنا عَن طيبهِ ماء وَجهِهِ","كَتَخبير ماء الظَلم عَن طيبة الثَغَرِ",71,"ر",1,0],["وخبرتُ الأيَّامَ حتى لقالَ النْ","نَاسُ هذا هو الخبيرُ الأرِيبُ",72,"ب",1,0],["وخباك بكاء عهد تولى","وغرور ذكراك ظبيا عزيرا",73,"ر",2,0],["وَخَبَّر عَنها سَحْقُ أَثْلَمَ خَاشِعٍ","كَهالةِ بدرٍ بَشَّرتْ بحياها",74,"ا",3,0],["وخَبُثَتْ سرائرٌ فلم تكن","لله في تدبيره متَّهِما",75,"م",2,0],["وخبرتُهم خُبرَ اللبيب طباعَه","فمعي على سَعةٍ عليَّ لضيقِ",76,"ق",1,0],["وخبَرتُ قوماً قبله وخبرتُهُ","فعرفتُ مولى السيفِ من عبد العصا",77,"ص",2,0],["وخبّرني السُّفَّارُ أن قد تبدَّلتْ","فقلت حديثٌ مضحِكٌ وهو كابتُ",78,"ت",1,0],["وخَبوطٍ في دُجى مُعْتمةٍ","عَجِلِ الشَّدِّ وشيكِ المُرْتحلْ",79,"ل",1,0],["وخبا وأغْفى ذو الصِّلاء ونابِحٌ","خَصَراً فأعْوَزَ موْقِدٌ وعُواءُ",80,"ا",2,0],["وَخُبِّرتُ قَومي وَلَم أَلقَهُمُ","أَجَدّوا عَلى ذي شُوَيسٍ حُلولا",81,"ل",2,0],["وَخَبَرتُهُ فَرَأَيتُ ذَنبي عِندَهُ","فَضلي وَأَعجَزَني دَواءُ عِنادَهُ",82,"د",2,0],["وخبّرها الوشاةُ بنا إليها","بما جعلته عذراً في المَلالِ",83,"ل",1,0],["وخبرناك حاملاً فأَصَبْنا","كاهلاً لا تَؤودُهُ الأثقالُ",84,"ل",1,0],["وخُبِّرتما أنّ الوفاءَ تقارضٌ","فما لي أُعاطي صفوَهُ مَن يُمانعُ",85,"ع",1,0],["وخباءُ ما أضحى وأم","سى بيننا ما قُوِّضا",86,"ض",2,0],["وخُبّرتُها يومَ اِلتَقينا بذي النَّقا","تعجّبُ من وجدي وما عرفت وجْدا",87,"د",2,1],["وَخَبَّرَني الناعونَ ما صَنَعَ الرَدى","بِأَسماءَ مِن أَفعالِهِ النَكِراتِ",88,"ت",1,1],["وخَبَا نُوره وحُلَّت عُراه","ووَهى رُكْنُه ورثَّت حِبالُه",89,"ل",2,0]]}