ا","https://www.poetsgate.com/ViewPoem.aspx?id=149403",""],[5136,"ما هز عطفي ملة الحنفاء","https://www.poetsgate.com/ViewPoem.aspx?id=121489",""],[5186,"غيد الهوى والجوى حاولن تجريبي","https://www.poetsgate.com/ViewPoem.aspx?id=156473",""],[5273,"صهيل القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=162118",""],[5324,"قلوب الصادقين .","https://www.poetsgate.com/ViewPoem.aspx?id=207665",""],[5442,"الذرك الشيب فهلا أرعويت","https://www.poetsgate.com/ViewPoem.aspx?id=114783",""],[5442,"تقدم قبل الركب دمعي ليبقا","https://www.poetsgate.com/ViewPoem.aspx?id=114760",""],[5461,"سمرت","https://www.poetsgate.com/ViewPoem.aspx?id=34730",""],[5463,"أحسب أهلي ناسبوها","https://www.poetsgate.com/ViewPoem.aspx?id=31731",""],[5528,"من مثل أحمد..؟ ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=200986",""],[5539,"المرايا","https://www.poetsgate.com/ViewPoem.aspx?id=196881",""],[5614,"شموخ المجد","https://www.poetsgate.com/ViewPoem.aspx?id=4261",""],[5691,"ربيع عشتار","https://www.poetsgate.com/ViewPoem.aspx?id=206247",""],[5776,"أطوارُ ......عنكبوت الهولوكوست","https://www.poetsgate.com/ViewPoem.aspx?id=199338",""],[5818,"وإن باعوك","https://www.poetsgate.com/ViewPoem.aspx?id=186921",""],[5923,"من مذكرات مراقب امتحان","https://www.poetsgate.com/ViewPoem.aspx?id=149684",""],[5937,"في الفُستان","https://www.poetsgate.com/ViewPoem.aspx?id=211817",""],[5973,"ذبحتك جومانا أخيرا بشرياني","https://www.poetsgate.com/ViewPoem.aspx?id=13195",""],[6010,"أستاذة النحو ,,,","https://www.poetsgate.com/ViewPoem.aspx?id=175986",""],[6093,"تَعالوا أيُّها الشُّعُّارْ ( مجزوء الوافر المذيل)","https://www.poetsgate.com/ViewPoem.aspx?id=181727",""],[6124,"ما لقلبك","https://www.poetsgate.com/ViewPoem.aspx?id=201228",""]],"verses":[["وَخَبَت عَليكَ مِنىً تَبا","ريحَ الغَرامِ وَما زَهاها",0,"ا",3,0],["وَخَبَّت عَلى بَيداءَ تَشرَقُ ماءَها","عَنِ الرَكبِ في طَيِّ العُيونِ الغَوائِرِ",1,"ر",1,0],["وَخَبَطتُ في المُتَعَرِّضينَ بِقَولَةٍ","جَدّاءَ مِن بِدَعِ الزَمانِ شَرودِ",2,"د",1,0],["وَخَبَّرتِني عَن هَجرِها فَنَعَيتِ لي","حَياتي وَكانَ الهَجرُ لِلمَوتِ مَوعِدا",3,"د",2,0],["وَخَبَّرتَ أَن قَد جَدَّ بَينٌ وَقَرَّبوا","جِمالاً لِبَينٍ مُثقَلاتٍ مِنَ الغَدرِ",4,"ر",1,0],["وَخَبَّرتُماني أَنَّ تَيماءَ مَنزِلٌ","لِلَيلى إِذا ما الصَيفُ أَلقى المَراسِيا",5,"ي",2,1],["وَخُبِّرتُهُ أَهدى جَزوراً سَمينَةً","أَتَمَّ الحِبا أَن لَو أَجَدَّ ثيابَكا",6,"ك",2,0],["وَخَبَّرَني مَن كُنتُ أَرسَلتُ إِنَّما","أَخذتَ كِتابي مُعرِضاً بِشِمالِكا",7,"ك",2,0],["وَخَبٍّ لُحومُ الناسِ أَكثَرُ زادِهِ","كَثيرِ الخَنى بَعدَ المَحالَةِ هَمّاسِ",8,"س",1,0],["وَخُبِّرنَ ما بَينَ الأَخاديدِ واللِوى","سَقَتهُ الغَوادي وَالسَواري طَوارِقُهُ",9,"ق",2,0],["وَخَبِّرهُم وَأَنتَ بنا خَبيرٌ","بِأَنَّ الذُلَّ شِنشِنَةُ العَبيدِ",10,"د",1,0],["وخَبَأَتْ دُفَّها في ثَوبِها فَرَقاً","منه ووَدَّتْ لو أنّ الأرضَ تَطويها",11,"ي",3,0],["وَخَبِّرا الغَربَ وَأَبناءَهُ","بِأَنَّنا نَحنُ الرِجالُ الأُلى",12,"ل",2,0],["وَخَبَأتَ في أَلفاظِها","مِن كُلِّ مَعنىً مُسكِرِ",13,"ر",1,0],["وَخَبَّرَها الواشونَ أَنّي صَرَمتُها","وَحَمَّلَها غَيظَاً عَلَيَّ المُحَمِّلُ",14,"ل",1,0],["وَخَبَّثَ حَوضَ الخورِ خورِ مُجاشِعٍ","رَواحُ المَخازي نَحوَها وَبُكورُها",15,"ر",3,0],["وخَبَّ السَّفا واستبطن الفحلُ والتقت","بامعزها بُقْعُ الجنادِب ترتكِلْ",16,"ل",1,0],["وَخَبُثَت عَلى الفَتى طَرائِقُه","أَعدى أَعاديهِ بِهِ يُصادِقُه",17,"ق",2,0],["وَخَبَرتُ هَذا الدَهرَ خِبرَةَ ناقِدٍ","حَتّى أَنِستُ بِخَيرِهِ وَبِشَرِّهِ",18,"ر",2,0],["وَخَبِّر بِالَّذي لا عَيبَ فيهِ","بِصِدقٍ غَيرِ إِخبارِ الكَذوبِ",19,"ب",1,0],["وخبت بهِ نيران فارس آية","يدري بها من قبل إبراهيم",20,"م",1,0],["وخَبيءُ الفؤاد يعلمه العا","قلُ قبلَ السماع بالإيماءِ",21,"ا",2,0],["وخَبَّرتنا بأنَّا مِنْ فرائسها","نواطقاً بفصيح غيرِ مَلْحون",22,"ن",1,0],["وَخَبَرتُهُنَّ فَما لِبِكرٍ حُرمَةٌ","تَرعى وَأَغدَرُ مَن رَأَيتُ الثَيِّبُ",23,"ب",1,0],["وخبيثٍ يعيشُ كالفأسِ هدَّا","ماً ليُعْلي بَيْنَ الخَرابِ بناءهْ",24,"ا",2,0],["وخبا بهمْ لَهَبُ الوجودِ فما بقوا","إلاَّ كمحترقٍ من الأخْشابِ",25,"ب",1,0],["وخبا لهيبُ الكون في قلبي الَّذي","قد عاش مِثْلَ الشُّعْلَةِ الحمراءِ",26,"ا",2,0],["وخبريه يا أم أني","لساعة الموت قد ذكرته",27,"ه",1,0],["وَخَبَت مَساجِدُ كُنَّ نوراً جامِعاً","تَمشي إِلَيهِ الأُسدُ وَالآرامُ",28,"م",1,0],["وخبَّرني تقليبيَ الناسَ بُرهةً","بأنك فردٌ والأنامُ شُكُولُ",29,"ل",1,0],["وَخَبَّرتَني أَنَّ العَزاءَ تَكَرُّم","وَهَل يَتَعَزّى عَنهُ غَيرُ لَئيمِ",30,"م",1,0],["وَخَبنٌ ثُمَّ طَيٌّ ثُمَّ عَصبٌ","وَعَقلٌ ثُمَّ إِضمارٌ وَوَقصُ",31,"ص",1,0],["وَخَبَّرَتني مَعانٍ في مَراسِمِهِ","بِهِ كَما خَبَّرَ العُنوانُ بِالصُحُفِ",32,"ف",1,0],["وَخُبِّرَ أَنّي قَد مَرَرتُ بِبابِهِ","لِأَخلِسَ مِنهُ نَظرَةً فَتَحَجَّبا",33,"ب",2,0],["وَخَبِّريني ما الَّذي عِندَكُم","بِاللَهِ في قَتلِ اِمرِئٍ مُسلِمِ",34,"م",1,0],["وَخَبَرتُهُم فَوَجَدتُ أَخبَرَهُم","مِثلَ الطَريدَةِ ما لَها خُبرُ",35,"ر",1,0],["وَخَبَّرَهُ صادِقٌ بِالحَديثِ","فَإِن شَكَّ في ذاكَ فَليَختَبِر",36,"ر",1,0],["وَخَبَّ سَفا قُريانِهِ وَتَوَقَّدَت","عَلَيهِ مِنَ الصَمّانَتَينِ الأَصالِفُ",37,"ف",1,0],["وخبا من مصابحِ الفكر نورٌ","كان أمضى من الشهاب وأثقبْ",38,"ب",1,0],["وخَبَتْ مَدافِعُهم وذاب حديدهم","والثَّلجُ يَعجبُ واللَّظى الموَّارُ",39,"ر",1,0],["وخبا المصباحُ إلَّا كأس راحِ","نورُهُ ما بين إِيماضٍ ووثبِ",40,"ب",1,0],["وَخَبِّر عَن عُبَيلَةَ أَينَ حَلَّت","وَما فَعَلَت بِها أَيدي اللَيالي",41,"ل",2,0],["وخَبَّرتِ العَصَا الأَنباءَ عَنهُ","وَلم أرَ مِثلَ فارِسِها هَجينا",42,"ن",2,0],["وَخَبِّرْهُ عَنِّي أَنَّنِي مُنْذُ بَيْنِهِ","أُكابِدُ هَوْلاً يَتْرُكُ الطِّفْلَ أَشْيَبَا",43,"ب",2,0],["وَخَبَا مِنْ جَبِينهِ نَجْمُ سَعْدٍ","طَالَمَا كَانَ ضَاحِكاً يَتَهلَّلْ",44,"ل",1,0],["وَخَبا نَجمي فَها أَنا ذا","لا سَنىً يهدي وَلا سَنَدُ",45,"د",1,0],["وَخَبَّ فِيها راكِباً رَأْسَهُ","لِلشرِّ ما خَبَّ وما أَوْضَعا",46,"ع",2,0],["وخُبّرت الأوثانُ أنَّ زمانَها","تولّى وراحَ الجهلُ والجهلاءُ",47,"ا",2,0],["وخبطك بالرأي تحت القضا","ذهول وعجرفة بارده",48,"د",2,0],["وخبت مدافعهم وذاب حديدهم","والثّلج يعجب واللّظى موّار",49,"ر",1,0],["وخبا كل ساطع فى سماه","وذوى كل زاهر في جنانه",50,"ن",2,0],["وخَبَتْ فقلتُ : غفا ، وإنَّ صَدىً","في السَّمْعِ من زَفْرٍ يُصَعِّده!",51,"د",2,0],["وخبيئةٌ ف