1,0],["كَأَنَّ عَلَيها الدَمعَ ضَربَةَ لازِبٍ","إِذا ما حَمامُ الأَيكِ في الأَيكِ غَنَّتِ",111,"ت",1,0],["كَأَنَّ عِقدَ وِشاحَيها عَلى رَشَإٍ","يَقرو مِنَ الرَوضِ رَوضِ الحَزنِ أَثمارا",112,"ر",2,0],["كَأَنَّ عَلى عِطفَيهِ مِن خِلَعِ السُرى","قَميصَ ظَلامٍ بِالصَباحِ تَرَقَّعا",113,"ع",2,0],["كَأَنَّ عَلى أَنيابِها الخَمرَ شَجَّها","بِماءِ سَحابٍ آخِرَ اللَيلِ غابِقُ",114,"ق",1,0],["كأنّ عرينَ اللّيثِ لم يُؤتِ نُصحَه","فيُقصرِ طمّاحٌ ويرتدُّ طامعُ",115,"ع",1,0],["كان عيبال من صدى الأُنس يهتز","زُ فماذا سمعت في عيبال",116,"ل",1,0],["كَأَنَّ عَلى الخُدُودِ وَهُنَّ شُعثٌ","سِجالَ الماءِ يُبعَثُ في السَواقي",117,"ق",2,0],["كَأَنَّ عُقاراً قَهوَةً مَقدِيَّةً","أَبى بَيعَها خبٌّ مِنَ التَجرِ خادِعُ",118,"ع",1,0],["كَأَنَّ عَلَيها مِن سَقيطِ قُطارِها","جُماناً وَهَت أَسلاكُهُ فَتَفَصَّلا",119,"ل",2,0],["كَأَنَّ عُروقَ الدَوحِ مِن تَحتِهِ الثَرى","قُوىً مِن حِبالٍ أُعجِلَت أَن تُفَتَّلا",119,"ل",2,0],["كَأَنَّ عُيونَ العاشِقينَ مَنوطَةٌ","بِأَرجائِها فَما يَجِفُّ لَها شَفرُ",120,"ر",1,0],["كَأَنَّ عَناقيدَ الكُرومِ وَظِلَّها","كَواكِبُ دُرٍّ في سَماءِ زَبَرجَدِ",121,"د",1,0],["كَأَنَّ عِذارَيهِ عَلى قَمَرٍ عَلى","قَضيبٍ عَلى دَعصٍ رَطيبِ الثَرى نَدي",122,"ي",1,0],["كَأَنَّ عَلى حُلّابِهِنَّ سَحائِباً","تَجودُ مِنَ الأَخلافِ سَحّاً وَتَسكابا",123,"ب",2,0],["كَأَنَّ عِذاريهِما واحِدٌ","لَجوجانِ تَشقى وَيَشقى بِها",124,"ب",3,0],["كأَنَّ عليمَنا لهمُ نبيٌّ","لدعوتِهِ الخلائقُ تستجيبُ",125,"ب",1,0],["كأن عليه من أذى القيظ كلَّةً","تُزَرّ إذا ما اشتدّ منه ودوق",126,"ق",1,0],["كأنّ عليه اليَمَّ باليَمِّ تَنْكَفي","غَوارِبُهُ واللّيْلَ بالليلِ يَرتَمي",127,"م",2,0],["كأنّ عمودَ الفجرِ خاقانُ عسكرٍ","من التركِ نادى بالنجاشيّ فاستخفى",128,"ف",2,0],["كأنَّ عليهم منك عَنقاءَ تعتلي","فليس لها من أن تَخَطَّفَهُم بُدُّ",129,"د",1,0],["كَأَنَّ عَدُوَّهُ نَعَمَ","فَإِن هُوَ قالَها قَطَبا",130,"ب",2,0],["كَأَنَّ عَينَيهِ إِذا ما أَثأَرا","فَصّانِ قُضّا مِن عَقيقٍ أَحمَرا",131,"ر",2,0],["كَأَنَّ عُبَيدَ اللَهِ لَم يَلقَ ماجِداً","وَلَم يَدرِ أَنَّ المَكرُماتِ تَكونُ",132,"ن",1,0],["كَأَنَّ عُ