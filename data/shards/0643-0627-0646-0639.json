3,0],["كَأَنَّ عُقاراً بَعدَهُم بابِلَيَّةً","تَخالُ بِها في الرَأسِ نَكباءَ زَعزَعا",4,"ع",2,0],["كَأَنَّ عِقبانَ الشُرَيفِ فَوقَها","تَعلو قِنانَ الأَرضِ أَو جِزاعَها",5,"ع",3,0],["كَأَنَّ عُفاةَ المَرءِ ذي الطَولِ مِنهُمُ","يَمُدّونَ أَوذامَ الدِلاءِ مِنَ البَحرِ",6,"ر",1,0],["كَأَنَّ عُهودَنا كانَت قُلوباً","تُربى بَينَ أَحشاءِ العِهادِ",7,"د",1,0],["كانَ عِندي أَنَّ الغُرورَ لِطَرفي","فَإِذا ذَلِكَ الغُرورُ لِقَلبي",8,"ب",2,0],["كانَ عَوني وَعُدَّتي في الرَزاي","كانَ دِرعي وَذابِلي وَالحُساما",9,"م",2,0],["كأنّ عليلَ النّرْجِسِ اهْتاجَ داؤهُ","وقدْ قعَلَتْ تبْكيهِ ساجِعةُ الوُرْقِ",10,"ق",1,0],["كَأَنَّ عَينَيهِ مِن حُسنِ اِصفِرارِهِما","فَصّانِ مِن حَجَرِ الياقوتِ قَد قُطِعا",11,"ع",2,0],["كَأَنَّ عَصيرَ الضَيحِ في سَدَيانِهِ","دَفوناً وَأَسداماً طَويلاً دُثورُها",12,"ر",3,0],["كَأَنَّ عَلى أَنسائِها عِذقَ حَصلَةٍ","تَدَلّى مِنَ الكافورِ غَيرَ مُكَمَّمِ",13,"م",1,0],["كَأَنَّ عَلَيهِ مِن قَباءٍ بِطانَةً","تَفَرَّجَ عَنها جَيبُها وَالمَناصِحُ",14,"ح",1,0],["كانَ عَبدُ الحَميدِ بِالأَمسِ فَرداً","فَغَدا اليَومَ أَلفُ عَبدِ الحَميدِ",15,"د",1,0],["كانَ عَبدُ الحَميدِ في القَصرِ أَشقى","مِنهُ في الأَسرِ وَالبَلاءِ الشَديدِ",15,"د",1,0],["كانَ عَبدُ العَزيزِ أَجمَلَ أَمراً","مِنكَ في يَومِ خَلعِهِ المَشهودِ",15,"د",1,0],["كَأَنَّ عَلَيها عَبقَرِيَّ مَطارِفٍ","مِنَ الوَشي يُسديها الحَيا وَيُنيرُها",16,"ر",3,0],["كَأَنَّ عَشِيَّ القَطرِ في شاطِئِ النَهرِ","وَقَد زَهَرَت فيهِ الأَزاهِرُ كَالزَهرِ",17,"ر",1,1],["كَأَنَّ عَلى الكَتفَينِ مِنهُ إِذا اِنتَحى","مَداكُ عَروسٍ أَو صَلايَةُ حَنظَلِ",18,"ل",1,0],["كَأَنَّ عَلى لَبّاتِها جَمرَ مُصطَلٍ","أَصابَ غَضىً جَزلاً وَكَفَّ بِأَجذالِ",19,"ل",1,0],["كَأَنَّ عُيونَ الوَحشِ حَولَ خِبائِن","وَأَرجُلِنا الجَزعَ الَّذي لَم يُثَقَّبِ",20,"ب",1,0],["كأَنَّ عَلى أَسنَانِها بَعدَ هَجعَةٍ","سَفَرجلَ أَو تُفَّاحَ في القَندِ والعَسَل",21,"ل",1,0],["كَأَنَّ عَلى أَنيابِها بَعدَ رَقدَةٍ","إِذا اِنتَبَهَت وَهناً لِمَن يَستَنيمُها",22,"م",3,0],["كَأَنَّ عَدَولِيّاً زُهاءَ حُمولَها","غَدَت تَرتَمي الدَهنا بِها وَالدَهالِكُ",23,"ك",1,0],["كَأَنَّ عَلى كَبِدي قُرحَةً","حَذارًا مِنَ البَنِ ما تَبرُدُ",24,"د",1,0],["كَأَنَّ عَيني لِذِكراهُ إِذا خَطَرَت","فَيضٌ يَسيلُ عَلى الخَدَّينِ مِدرارُ",25,"ر",1,0],["كَانَ عِيسَى فِي مَوَدَّتِهِ","وَاحِداً في البُعْدِ والْقُرْبِ",26,"ب",1,0],["كَانَ عِيسَى صَبَّ حِرْفَتِهِ","يَفْتَدِيهَا فِدْيَةَ الصَّبِّ",26,"ب",1,0],["كَانَ عُمْرٌ قَضَيْتَهُ فِي اضْطِلاعٍ","بِالمَعَالِي وَفِي مَسَاعٍ جِسَامِ",27,"م",1,0],["كَأَنَّ عَلى فيها وَما ذُقتُ طَعمَهُ","زُجاجَةَ خَمرٍ طابَ فيها مُدامُها",28,"م",3,0],["كَأَنَّ عَلى فيها تَلألُؤَ مُزنَةٍ","وَميضاً إِذا زانَ الحَديثَ اِبتِسامُها",29,"م",3,0],["كَأَنَّ عَلى أَنيابِها ماءَ مُزنَةٍ","بِصَهباءَ في إِبريقِ شَربٍ مُقَدَّمِ",30,"م",1,0],["كَأَنَّ عَلى أَلوانِها كُلَّ شَتوَةٍ","جِسادَينِ مِن صِبغَينِ وَرسٍ وَعَندَمِ",30,"م",1,0],["كَأَنَّ عُيونَهُنَّ عُيونُ عينٍ","تُرَبيها بِأَسنُمَةِ الجَميمُ",31,"م",1,0],["كَأَنَّ عَلى أَنسائِهِنَّ فَريقَةً","إِذا اِرتَعنَ مِن تَرجيعِ آدَمَ سَحبَلِ",32,"ل",1,0],["كَأَنَّ عَلى أَعطافِهِ ماءَ مُذهَبٍ","إِذا سَمَلُ السِربالِ طارَت رَعابِلُه",33,"ل",2,0],["كَأَنَّ علَيَها سحَقَ لِفقٍ تَنَوَّقتَ","بِهِ حَضرَمِيّاتُ الأَكُفِّ الحَوائِكِ",34,"ك",1,0],["كَأَنَّ عَلى أَنيَابِهِ كُلَّ سُدفَةٍ","صِياح البَوازي من صَريفِ اللَوائِكِ",34,"ك",1,0],["كَأَنَّ علَى فيها إِذا رَدَّ روحَها","إِلى الرَأسِ روحُ العاشِقِ المُتَهالِكِ",34,"ك",1,0],["كَأَنَّ عُرى المَرجانِ مِنها تَعَلَّقَت","عَلى أُمِّ خَشفٍ مِن ظِباءَ المَشاقِرِ",35,"ر",1,0],["كَأَنَّ عَمودَ الصُبحِ جيدٌ وَلَبَّةٌ","وَراءَ الدُجى مِن حُرَّةِ اللَونِ حاسِرِ",35,"ر",1,0],["كَأَنَّ عَلى أَعراسِهِ وَبِنائِهِ","وَئيدَ جِيادٍ قُرَّحٍ ضَبَرَت ضَبرا",36,"ر",2,0],["كَأَنَّ عَلَيهِما قَطعاتِ بَيتٍ","بِحَيثُ الرَقُّ مِن كَرَشِ الجُلودِ",37,"د",1,0],["كان عزيزاً يأبى الهوان فما","قرّ عليه يوماً ولا قبله",38,"ل",2,0],["كَأَنَّ عُيونَ المُجتَلينَ تَعَرَّضَت","لِشَمسٍ تَجَلّى يَومَ دَجنٍ سَحابُها",39,"ب",3,0],["كَأَنَّ عَلى مَغابِنِهِنَّ هَجراً","كُحَيلُ الليتِ أَو نَبَعانَ قارِ",40,"ر",1,0],["كَأَنَّ عَلى مَناخِرِهِنَّ قُطناً","يَطيرُ وَيَعتَمِمنَ بِهِ اِعتِماما",41,"م",2,0],["كان عيونهن مُهجَّجاتٍ","إذا راحت من الأُصُلِ الحرورُ",42,"ر",1,1],["كَأَنَّ عَلى أَلفاظِهِ وَنِظامِهِ","بَدائِعَ ماحاكَ الرَبيعُ مِنَ الزَهرِ",43,"ر",1,0],["كَأَنَّ عَينَيَّ إِذ وَلَّت حُمولُهُمُ","في الفَجرِ فَيضُ غُروبٍ ذاتِ إِتراعِ",44,"ع",1,0],["كأنَّ عذاريه خط الجمال","تميل النفوس إلى لمحه",45,"ح",2,0],["كأن عيني إذا أرفضت مدامعها","عن المؤيد أو صوب الحيا نقلت",46,"ت",1,0],["كأنَّ عماد البيت غير مقوَّضٍ","وقد قمت يا أزكى الأنام وأحزما",47,"م",2,0],["كأن عتاق الطير بين رماحه","بنودٌ تهاوى للطعان وتعتلى",48,"ل",2,0],["كأنْ عليه قلادةٌ نُظمتْ","من لؤلؤٍ لا تَشينُهُ ثقَبُهْ",49,"ب",2,0],["كأنّ عينيَّ أبصرتْكِ ضُحى","في مجلسي والوشاة في سَقرِ",50,"ر",1,0],["كأن عَجاج موكبه تجلَّى","هناك بوجهه عن قَرنِ شمس",51,"س",1,0],["كأن عيون الناظرين توسَّمتْ","بهن شموساً من وراء نشائص",52,"ص",1,0],["كان عيسى في نشره ميِّتَ الجو","دِ كعيسى مكلّم الناس طِفلا",53,"ل",2,0],["كأن على روادفها","ستور الليلِ مُنسدلَهْ",54,"ل",2,0],["كأن عفاةَ فضلك في مجالٍ","وكيف تريث عودةُ منْ يجولُ",55,"ل",1,0],["كَأَنَّ عَلَيها بالَةً لَطَمِيَّةً","لَها مِن خِلالِ الدَأيَتَينِ أَريجُ",56,"ج",1,0],["كَأَنَّ عَلى فيها عُقاراً مُدامَةً","سُلافَةَ راحٍ عَتَّقَتها تِجارُها",57,"ر",3,0],["كَأَنَّ عَطّارَةً باتَت تَطيفُ بِهِ","حَتّى تَسَربَلَ ماءَ الوَرسِ وَاِنتَعَلا",58,"ل",2,0],["كَأَنَّ عَلَيها القَسطَلانِيَّ مُخمَلاً","إِذا ما اِتَّقَت شَفّانَهُ بِالمَناكِبِ",59,"ب",1,0],["كَأَنَّ عِجانَها لَحيا جَزورٍ","تَحَسَّرَ عَنهُما وَضَرُ الجِرانِ",60,"ن",1,0],["كَأَنَّ عُيوبَ الوَحشِ حَولِ خِبائِنا","وَأَرحُلِنا الجَزعُ الَّذي لَم يُثَقَّبِ",61,"ب",1,0],["كانَ عَلى خِوانِ رَبِّ المالِ","كَأسانِ مِن خَمرٍ وَمِن زُلالِ",62,"ل",1,1],["كَأَنَّ عَلى أَعجازِها كُلَّما رَأَت","سَماوَتَهُ فَيئاً مِنَ الطَيرِ وُقَّعا",63,"ع",2,0],["كَأَنَّ عَلى أَعرافِهِ وَلِجامِهِ","سَنا ضَرَمٍ مِن عَرفَجٍ يَتَلَهَّبُ",64,"ب",1,1],["كأَنَّ عَشيَّ القَطرِ في شاطىءِ النَهرِ","وَقَد زَهَرَت فيهِ الأَزاهِرُ كالزَهرِ",65,"ر",1,1],["كأن عَلى وجه السماء الَّذي صفا","يداً بمداد النور قد كتبت سطرا",66,"ر",2,0],["كان عن ذا لقلبي غنية","