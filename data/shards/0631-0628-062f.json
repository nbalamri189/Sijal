{"poems":[[49,"صاحب لما أساء","https://www.aldiwan.net/poem25383.html","مجزوء الرمل"],[74,"رب دوح باكرته عزمتي","https://www.aldiwan.net/poem18941.html","الرمل"],[46,"طلل الجميع لقد عفوت حميدا","https://www.aldiwan.net/poem30553.html","الكامل"],[107,"رب أحببني وأحبب أسرتي","https://www.aldiwan.net/poem43384.html","الكامل"],[48,"رب درفس خلفه ذائب","https://www.aldiwan.net/poem23432.html","السريع"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/86022","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85848","الرمل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20997","الرمل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21120","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54252","الخفيف"],[108,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[119,"رب دار بالغضا طال بلاها","https://www.aldiwan.net/poem40433.html","عموديه"],[186,"عرجا في ربوعها وسلاها","https://www.aldiwan.net/poem67021.html","الخفيف"],[190,"رحل الفريق فأسرعوا الوخدا","https://www.aldiwan.net/poem43881.html","الكامل"],[199,"بانت سعاد وليس الود ينصرم","https://www.aldiwan.net/poem54418.html","البسيط"],[230,"خبروني اليوم أني في غد","https://www.aldiwan.net/poem55166.html","الرمل"],[567,"تنبهوا يا عباد الله واعتبروا","https://www.aldiwan.net/poem52799.html","البسيط"],[620,"","https://poetry.dctabudhabi.ae/diwan/poem/146476","الرمل"],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137337",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48870","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62527","الكامل"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96576","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49580","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101002","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1839,"","https://poetry.dctabudhabi.ae/diwan/poem/123640","السريع"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114750","الخفيف"],[2384,"","https://poetry.dctabudhabi.ae/diwan/poem/123655","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200405","السريع"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101608","الخفيف"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97926","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216468","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205904","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114340","المديد"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83663","الخفيف"],[4545,"","https://poetry.dctabudhabi.ae/diwan/poem/216347",""],[5213,"رب دار دخلتها غدوة اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=170555",""],[5302,"ما الذي سوف نلقى ؟","https://www.poetsgate.com/ViewPoem.aspx?id=200122",""],[5409,"أضحكتنا ورب ضحكٍ بكاء","https://www.poetsgate.com/ViewPoem.aspx?id=155244",""]],"verses":[["رُبَّ داءٍ لا أَرى مِن","هُ سِوى الصَبرِ شِفاءَ",0,"ا",2,0],["ربّ دوح باكرته عزمتي","ونديمي بعد أحبابي ادكار",1,"ر",1,1],["رُبداً وَمَأسَدَةً عَلى أَكتادِها","لِبَدٌ تَخالُ فَليلَهُنَّ لُبودا",2,"د",2,0],["رَبِّ داوِ النَفسَ مِن أَدوائِها","قَبلَ أَن تُودي وَيُودي بَدَني",3,"ن",2,0],["رَبُّ دِرَفسٍ خَلفَهُ ذائِبٌ","أَروَحُ مِن رَبِّ الدِرفِسِ العَلَم",4,"م",1,1],["رب دمع كأنه كان لما","بث شكواه شاعراً عبقريا",5,"ي",2,0],["رب داع لصلاة","ما لها قط أقاما",6,"م",2,1],["رُبَّ دَهرٍ قَد تَمَتَّعتُ بها","وقَصَرت اليَومَ في بَيتِ عِذاري",7,"ر",2,0],["رُبَّ دارٍ بأَسفَلِ الجِزعِ مِن دَو","مَةَ أَشهَى إليَّ مِن جَيرُونِ",8,"ن",1,1],["رُبَّ دُرٍ لاقَى من الصدرِ دُرَاً","وجُمانٍ في النَحْرِ لاقى جُمَانَا",9,"ن",2,0],["رب دُرٍّ في مفرق كان يومًا","قَطَرَاتٍ من الجبين مُذَابة",10,"ب",2,0],["رب دار بالغضا طال بلاها","حكت الطيف شؤونا وحكاها",11,"ا",3,1],["رُبَّ دَمعٍ أَسلَتْهُ بَعد هَجرٍ","مَزجَتْهُ بِمثلِهِ عَيناها",12,"ا",3,0],["ربداء طامسة الصوايا تأتلي","بالله خلت سرابها وردا",13,"د",2,0],["رُبداً هَوامِدَ حيطَت بِالنُؤِيِّ فَقَد","كادَ التُرابُ عَلَيها الجَونُ يَلتَئِمُ",14,"م",1,0],["رُبَّ داءٍ لا يُرجّى بُرؤُهُ","قد شَفَتهُ زَورَةٌ من مُسعدِ",15,"د",1,0],["ربٌّ دعا عبدَهُ يوماً فبادَرَهُ","وكلُّ عبدٍ إلى مَولاهُ يبتَدِرُ",16,"ر",1,0],["رب دار بالغضا طال بلاها","عكف الركب عليها فبكاها",17,"ا",3,1],["رُبَّ دمعٍ نثرتهُ كاللآلي","كان كالنار في الصدور شُبوبا",18,"ب",2,0],["ربّ دان من السعير نجا من","ه ونال البعيدَ عنه السعير",19,"ر",1,0],["رَبدانُ ما رَبدانُ أسبقُ من","برق الفضاء ومن سُرى النّكْبا",20,"ب",2,0],["رُبدَ النعام وآراماً تَريعُ بها","مثلَ الهجائن في أَوطانها هَمَلا",21,"ل",2,0],["رَبْداء تَضْحَكُ في الهيجاءِ عنْ لُمَعٍ","كما التقى الدَّمْعُ والأَجْفَانُ والكُحُل",22,"ل",1,0],["رب دهر بالحَرَّتين أقاموا","فيه للمجد كل سامٍ وراسي",23,"س",2,0],["رب دعها عليه حتى تلاقي","ك به مذ تعود بعد فناها",24,"ا",3,0],["ربدَه النعْظ ففي جلده","مثل الشرى ثار بجلد الشري",25,"ي",1,0],["ربّ دمعٍ أرَقتُه","في ظلالٍ وفي دَدِ",26,"د",1,0],["رب دبرني ولاطفني عسى","هذه الكربة عن قلبي تنش",27,"ش",1,0],["ربّ دنيّ مُشبهٍ نفسه","في لؤمه والنقص في حسّه",28,"ه",1,1],["ربّ دمع كفكفته من عيوني","سال حبراً في الطرس يخفق خفقا",29,"ق",2,0],["رب داءٍ طبه في دارهم","أو لدى الجيران لكن يجهلون",30,"ن",1,0],["رب دانٍ مجسّد لا نراه","وبعيد نراه غير مجسّد",31,"د",1,0],["رُبَّ دنيا صنعوها لعبا","جَاورتْ دنيا دواء وسقم",32,"م",1,0],["رُبَّ دَهرٍ عِشتُهُ ذَا نَوَال","فِي ظِلاَلٍ مِن أمَانٍ مُوَال",33,"ل",1,1],["رُبَّ داءٍ يصِحُّ منهُ دَواءٌ","باِعتِلال العُقول وَالأَجسامِ",34,"م",1,0],["رِبْدٍ مِنْ الْبِيْد لِهَا مَا تِحِيد","عِلِيْهَا بَرِيدْ شِجَاعٍ هِمَامْ",35,"م",1,0],["رب دار دخلتها غدوة اليوم","وما كنت بالديار عليما",36,"م",2,1],["رب درب مضيت فيه بفعل","محق الحب والتقارب محقا",37,"ق",2,0],["رب داءٍ ترى من العار شكوا","ه وشكوى يثنيك عنها الإباء",38,"ا",2,0]]}