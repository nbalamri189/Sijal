ِسانُ الضَّادِ فَخْرُ البلادِ !","https://www.poetsgate.com/ViewPoem.aspx?id=215276",""],[5771,"شُكرًا","https://www.poetsgate.com/ViewPoem.aspx?id=189157",""],[5874,"مَوْقفُ الشِّعْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=212191",""],[5894,"نعوت الهوى للصب ذل مهين","https://www.poetsgate.com/ViewPoem.aspx?id=131434",""],[5953,"الله أكبر قددنا الفتح","https://www.poetsgate.com/ViewPoem.aspx?id=93791",""],[5956,"يا إلهي","https://www.poetsgate.com/ViewPoem.aspx?id=193297",""],[5956,"سحُبٌ تفيد حياتنا","https://www.poetsgate.com/ViewPoem.aspx?id=208561",""],[6093,"شهيدٌ من القنفذة (الرمل)","https://www.poetsgate.com/ViewPoem.aspx?id=181456",""],[6093,"لك في الشعر ثبات ورسوخ","https://www.poetsgate.com/ViewPoem.aspx?id=197662",""],[6102,"هبط الليل","https://www.poetsgate.com/ViewPoem.aspx?id=185296",""],[6164,"أيها الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66015&r=&rc=25",""],[5724,"ذكرى تمر وعبرة تتكرر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55153&r=&rc=20",""],[454,"مع صادق الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82686&r=&rc=50",""]],"verses":[["وتُرْويكِ في قَيْسٍ حِياضٌ تُظِلُّها","ذَوابِلُ في أيْدي لُيوثٍ خَوادِرِ",0,"ر",1,0],["وَتُروي السِنانَ وَتُردي الكَمِيِّ","كَمِرجَلِ طَبّاخَةٍ حينَ فارا",1,"ر",2,0],["وتروق من بعدٍ بها فوّارة","في الجو يدفق ماؤها ويفور",2,"ر",1,1],["وتُرويها المشارب والمحاسي","وتذويها اللوافح والسموم",3,"م",1,0],["وَتَرَوا بَينَ يَدَيها عَبرَةً","مِن شَهيدٍ يَقطُرُ الوَردَ شَذاها",4,"ا",3,0],["وتَرَوَّحَ الجسد الغليظ بمي","قات وتمت للمزاج مدد",5,"د",1,0],["وَتَرود القفار وَهِيَ سَعير","مِن حِجازيةٍ إِلى نَجديه",6,"ي",2,0],["وُتُرْوَى لَهُمْ عَنْهُ فِعَالٌ جَمِيلَةٌ","تُضِيءُ سَمَاءَ الذِّكْرِ مِنْهَا كَوَاكِبُ",7,"ب",1,0],["وَتَرُوحُ حَولَهُمَا الْجُمُوعُ وَتَغْتَدِي","كَالمَوْجِ وَهْوَ مُدَافَعٌ يَتَتَالَى",8,"ل",2,0],["وَتَرومُ الثُرَيّا","في الغُروبِ مَراما",9,"م",2,0],["وتروّي صدر الجهاد وتمحو","عن جباه الأباة ذلّ السجود",10,"د",1,0],["وتروع قلبي للدوالي نعرة","في البين يحسبها الحزين عويلا",11,"ل",2,0],["وَتَروي الكَأس مِن شَفَتيهِ لَثماً","وَيَجني وَرد خَديهِ اللثام",12,"م",1,0],["وَتَروي الكاس مِن شَفَتيك لَثماً","وَيَجني وَرد خَديك النقاب",13,"ب",1,0],["وَتَرٌ واهٍ على ألحانِهِ","يَسكَرُ القَلب ويُفشِي ما سَتَر",14,"ر",1,0],["وَتَروقُ عَينَكَ دَوحَةٌ مِن غَربِها","فيها جَنىً يَحميهِ ظِلٌّ مُسبِعُ",15,"ع",1,0],["وتروي حديث الجود يمناه عن عطا","وهذا حديث في الورى متواتر",16,"ر",1,0],["وتروح ثارات الحسي","ن أبي بسَيْفي مُحْتَمِيّه",17,"ي",2,0],["وَتَروعُ مُرتاضاً عَلى","أَهوالِهِنَّ مُدَرَّباً",18,"ب",2,0],["وتَروقُ فيها كالبَروقِ مناصِلٌ","لا ترتَجي مِنها الجَماجِمُ حاجِبا",19,"ب",2,0],["وتروح الأرواح في صبواتها","فكأنها مدهوشة ليست تعي",20,"ع",2,0],["وَتَرونَ أَحسَنَ ما يَكونُ تَجامُلاً","وَيَنالُ كُلٌّ مِنكُم ما قَد رَجا",21,"ج",2,0],["وترويك فتحي","منك ميت الصبوات",22,"ت",1,0],["وَتُرَوّي فِكري في مَشهَدِ ال","غَيبِ مِنهُ عَنهُ أَقصى رُؤيَتَي",23,"ي",1,0],["وَتَّرُوا قَوسَ مُنىً كَاذِبَةٍ","لَم توافِق سِيَةٌ مِنهَا المَعجِسا",24,"س",2,0],["وتَرُوعُ حينَ يروقُ بَهْجَةُ وَجْهِهِ","ولقَدْ يروعُ كما يروقُ المُنْصلُ",25,"ل",1,0],["وتَرُوحُ مُغْتَبِقاً شَمُولَ شمائِلي","وتعُودُ مُصْطَبِحاً ضَرِيبَ ضَرائِبي",26,"ب",2,0],["وتروي الليالي حديثه","حديثاً به ريح الصبا تترنم",27,"م",1,0],["وتَرَون الحمدَ غُنْما يُقتنَى","بالأيادي ويراه الناسُ غَبنا",28,"ن",2,0],["وتروَّحتُ من الثقل وقد","حفيتْ جنبايَ ضغطا وزحاما",29,"م",2,0],["وتروح نحو كواعب تسطو على","العشاق بالتيهان في الأجفان",30,"ن",1,0],["وتروح جمهرة المعا","ندِ وهي حكماً ذائبه",31,"ب",2,0],["وتروع أفئدة الملوك يراعه","في كفه كالأفعوان المطرق",32,"ق",1,0],["وتروَّضَتْ جَنَباتُهُ فكأنّه","بُرْدٌ تَنشّرَ بالفَلاةِ مُسَهَّمُ",33,"م",1,0],["وتَرُوحُ لا بِعَوارِضٍ","ملطومةٍ بالشَّعْرِ خَشْنِ",34,"ن",1,0],["وتَروحُ منه مُتْبَعا","بالمالِ لا كِيسِ المديح",35,"ح",1,0],["وتروعُه آلام انسانية","فيصيح ملتمساً لها تخفيفا",36,"ف",2,0],["وتروّ فيما أنت فاعله فكم","ندم العجول على خطاه حاسرا",37,"ر",2,0],["وتروعنا عدوى الوباء فإنها","كالنار تنذر جسمنا بفناء",38,"ا",2,0],["وترود منك على الخِوان أنامل","تدع الخوان سراب فاع مقفرِ",39,"ر",1,0],["وَتروح وَتَغدو بِالفَرحِ","وَعدوّك يُمسي في التَرحِ",40,"ح",1,0],["وتروم منكم نصرها وتعده","لحصوله في حيز المضمون",41,"ن",1,0],["وَتَرُوا وما عَلِمُوا بِوِتْرٍ ضَائِعٍ","مَنْ ذا يُطَالِبُ بالتِّرَاتِ الأزْمُنَا",42,"ن",2,0],["وتروي البروق أحاديثهم","إلى كل مملكة حاكيه",43,"ي",2,0],["وتروِّج اللغة الصحيحة فيهمُ","من بعد ما عشقوا الركيك فأكسدوا",44,"د",3,0],["وتروعان كل قلب بذكرى","دولة أضعفت بني الإنسان",45,"ن",1,0],["وتروى من الدهر ما في الغيوب","كأن لها عنده مخزنا",46,"ن",2,0],["وتروقني من ماءِ حُبِّكَ شربةٌ","تُروي الصَّدى إن راقَ غيري الكوثرُ",47,"ر",1,0],["وَتَرودُ عادِيَةَ الكَتيبَةِ مُعلَماً","بِمُقَلِّصٍ طَوعِ اليَدَينِ حِصانِ",48,"ن",1,0],["وتروعهم منكم سيوفُ حماية","يجلو دُجاها يوسفٌ ومحمد",49,"د",1,0],["وتروّعوا فتورّعُوا وتقربوا","بنذورهم لله إن طال الأجلْ",50,"ل",1,0],["وَتَرُومُ تَشْهَدُ كَائِنَاتِ جَمَالِهَا","أبِغَيْرِ عَيْنٍ تشهد الأكْوَانَا",51,"ن",2,0],["وتروح الدنى يجلببها الثلج","بأكفانه وتمضي بداد",52,"د",1,0],["وتَرومُ نَقعاً باعتداءِ مَسَبَّتي","ولرُّبَّما ضَرَّ الفتى بعضُ الغِذا",53,"ذ",2,0],["وتروى أحاديث الغرام صحيحةً","وتروى بكم بعد الغليلِ صدور",54,"ر",1,0],["وتروق لي نظراتها لما تغضّ","الطرف عن تحديق عين المبصر",55,"ر",1,0],["وتروَّحت ذاتُ الأراكِ بنفحةٍ","منها فشاقَ عبيرها مرتاحها",56,"ح",3,0],["وتروحُ عائشُ بينَهُنَّ كَما","قد ذرَّ بينَ سحائِبٍ شَرقُ",57,"ق",1,0],["وَتَروحُ تُقسِمُ أَن تَصونَ عُهودَنا","فَعَلامَ خُنتَ إِذَن أَجِب أَفَلا تَعي",58,"ع",2,0],["وتروِّي وجه الثرى وطفاء","ومتى يُضْمِدُ الجروح أساها",59,"ا",1,0],["وتروّحت روحي بأهنى ساعة","سمحت بها كف الزمان الأعسر",60,"ر",1,0],["وتروا القسيَّ حواجباً وتعمَّدوا","كسرَ الجفونِ وفوّقوها أسهُما",61,"م",2,0],["وتروعه راياتك الحمر التي","تجلو لديه شقائق النعمان",62,"ن",1,0],["وَتَروقُهُ خُدَعُ المُنى فَكَأَنَّها","حَقٌّ وَكاذِبُ وَعدِها ميثاقٌ",63,"ق",1,0],["وتروحي بشذا الطريق وأملي","عقبى سراك إلى الجناب الممرع",64,"ع",1,0],["وَتَروح تَشتاق الحِسان وَفي","جَنبيك خَوف اللَه وَالرِجس",65,"س",1,0],["وترويّ الشفاهَ بالقُبَل الحمراء","نشوى من الأسى والنواحِ",66,"ح",1,0],["وتروي ذكره في كل نادٍ","بما يغنيه عن قول الخطيب",67,"ب",1,0],["وتروي حديث الفضل عنه معنعناً","صحيحا ويروي عن سواه ملفقا",68,"ق",2,0],["وتروضها كخليستين عروبة","غض المساس وحيزبون علكد",69,"د",1,0],["وتروح يا قلب الوجود مقيداً","في حبسها كيف استقام نظامها",70,"م",3,0],["وتروم أن نبقى بطيب حياتنا","وتحيل طيب حياتنا كالعلقم",71,"م",1,0],["وَتروق لي تلك الشمول مع اللقا","وَيَعود شَملٌ للمسرّة شامل",72,"ل",1,0],["وَتَرومُ نُجحَ القَصدِ في","أَمرٍ أَتَتهُ راجِيَه",73,"ي",2,0],["وتروقني خدع المنى منها وقد","بعد المدى وتمادت الأيام",74,"م",1,0],["وتروع العدى سطانا فيمشو","ن الهويني إلى الوغى ونطير",75,"ر",1,0],["وتروح يحرسها النظام وتغتدي","فتخاله وتخاله رضوانها",76,"ن",3,0],["وتروحُ دأباً في حياضِ مواهبٍ","تُسقى بكاساتٍ من العِرفانِ",77,"ن",1,0],["وَتَروحُ أَخا شجنينِ فَمِن","بادٍ لِلنّاسِ وَمُكتَمَنِ",78,"ن",1,0],["وَتَروني أَبلَيتُ في الحُبِّ وَالحُس","نِ بَلاءَ المُجاهدِ المدفوعِ",79,"ع",1,0],["وتروّى من كفه الجم مما","جمّ من اصبعيه في بصباص",80,"ص",1,0],["وتروقني فيها الغصون موايدا","والزهر في أكمامه بسام",81,"م",1,0],["وَتَرَوِّ في قانونه وَفُصُوله","تُلفيه قَد أَهدى النضارَ لِمَن قَرا",82,"ر",2,0],["وتروم أيدي الريح تسلب ما اكتسى","فتزيدُهُ حسناً بِما هيَ تنسُج",83,"ج",1,0],["وتروي ظباه كلَّ هامةِ منزلٍ","من الثغر تستقي السُّيوفَ طواسمه",84,"م",2,0],["وتَروا رعيا جميلاً","من ذويِ القدر الخطيرِ",85,"ر",1,0],["وتَرويعُنا بينَ لِصٍّ وطاغٍ","جَزاءٌ, وبَعضُ الجَزاءِ احتِقارْ",86,"ر",1,0],["وتروي أكبُدَ الولهى وعوداً","وتجفوهمْ لكي تروي اختيالَكْ",87,"ك",1,0],["وتروي ..عن لحاظكَ سِرَّ أنثى","بمن كانت قبيل الحبِّ نَسْيَا",88,"ي",2,0],["وَتَرُوْمُ ذُلَّ الْمَاْجِدَاْتِ حُثَاْلَةٌ","دَفَعَتْ بِهَاْ، وَتَبَجَّحَتْ طَهْرَاْنُ",89,"ن",1,0],["وتروح تغرق في ظلام الشعر","تصرح ليل شعرك مستبد",90,"د",1,0],["وتروح كفّ الظلم تبسط خمسها","نِقماً وتُسرفُ أيّما إسرافِ",91,"ف",1,0],["( وَتَرُوحُ ) فِي ظِلِّ الْيَقِينِ بِرِزْقِهَا","مَنْ عَلَّمَ الْأَطْيَارَ أَنْ تَتَوَكَّلَا ؟",92,"ل",2,0],["وتروح تجيب كيس لبن / ع الوش عامل ريم","يسد نفسك / إذا شربته/ وتبقي سقيم",93,"م",1,0],["وترويني على ظمأِ الليالي","دموعَ العينِ..من حزنٍ سقاها",94,"ا",3,0],["وتروحُ آهاتي ويرجعُ لي الصّدى","يا ويلتي ما مِن سبيلٍ يُنْجِدُ",95,"د",1,0],["وتروحُ آهاتي ويرجعُ بالصّدى","يا ويلتي ما مِن سبيلٍ يُنْجِدُ",96,"د",1,0],["وتروم مصداق الذي قد قاله","شيخ الوجود والعالم الربان",97,"ن",1,0],["وترومُ الروحَ قبضتُه","ويرومُ القلبُ ما سكنا",98,"ن",2,0],["وتَرُوُقني بسماتُها من رؤيتي","وكأنَّها في الروضِ من رسمي",99,"م",2,0],["وتروم بعد البؤس عيشَ منعَّمٍ","أنى لها إذ قتَّلتْ أحلامَها",100,"م",3,0],["وترون اجمهور جنّ فلا يعرف","... ليناً ولا يخاطب هوناً",101,"ن",2,0],["وتروعني في الناس حالة خاملٍ","مذ جاء للدنيا الى أن راحا",102,"ح",2,0],["وتَروي جذوعَ النخلِ أنوارَ آيةٍ","بها نَسَغُ التوحيدِ في رايةِ النصر",103,"ر",1,0],["وتروح بي يم الأطباء وتدعي","بأوجاع موهومه بضنك نشرتها",104,"ت",3,0],["وتروه عيب على الرجل نقل الكلام وقيل قال","وأكبر خطاء يلحق كلامك ساكنين المقبره",105,"ر",2,0],["وتُرْوِي الْمَرْءَ نَشْوانًا","وَتُسْكِرُهُ بِلا خَمْرِ",106,"ر",1,0],["وَترون بَيتي قَدْ تَحول كَومةً","وَأثاثهُ المَنثور أصبحَ في الذَّرى",107,"ر",2,0],["وَتَرٌ وَتَّرَتْهُ جِنٌ فَأَنَّ الْ","فَنُّ فِيه ، فَمَا أَرَقَّ أَنِينَا",108,"ن",2,0],["وتروم مماتا يوم بعد محبنا","ولم نشك بالبلوى لواش يخون",109,"ن",1,0],["وتروحت أرواح روحانية","منكم فخلصها لكم روح",110,"ح",1,0],["وتروا أن الميادين التي","خضتها أدّتْ إلى بُعد النظرْ",111,"ر",1,0],["وترَون أفئدة خَشوعاً بالوفا","لصنيعِكم.. وتبثُّ جنةَ عطرِ",112,"ر",1,0],["وتَرُوْمُ الرُّوحُ أَفَيْاءَ السَّمَا","حَيْثُ عَيْشُ الخُلدِ في رِزْقٍ حَسَنْ",113,"ن",1,0],["وتَرُوضُ الفكْرَ إن ْ مَعنَىً عَصَى","ليسَ في طبْعكَ للصَّعبِ رُضُوْخْ",114,"خ",1,0],["وَ تَرُومَانِ وَأدَ حُبِّيَ , لَكِنْ","تَرْفِقُ الآهُ , إِذْ كَسبْتِ الرِّهَانا",115,"ن",2,0],["وتَرْوِي غَليلاً كَانَ لِلْمَجْدِ ظامِئاً..","فَلاقاهُ لا يُكْدِي. ولا يَتَبَذَّلُ!",116,"ل",1,0],["وتروح نطلب من فرنسا شرعه","عمياء قد مرت عليها أعصر",117,"ر",1,0],["وتروي الليالي حديثها","حديثاً به ريح الصبا تترنم",118,"م",1,0]]}