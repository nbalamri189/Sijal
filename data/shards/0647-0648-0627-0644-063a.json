w.poetsgate.com/ViewPoem.aspx?id=194644",""],[5781,"كثيرٌ من الحب في كلمات","https://www.poetsgate.com/ViewPoem.aspx?id=202830",""],[5818,"الشعب واللص","https://www.poetsgate.com/ViewPoem.aspx?id=199688",""],[469,"شكوت هوى في مثله تسمع الشكوى","https://www.poetsgate.com/ViewPoem.aspx?id=76778",""],[186,"نسيمات نجد هل تحملت من نجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55747&r=&rc=10",""],[186,"صبراً بني الخازن القوم الكرام على","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55942&r=&rc=205",""],[6260,"يا رجال القلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68348&r=&rc=40",""]],"verses":[["هُوَ الغَمرُ الرِداءِ لِعَزمَتَيهِ","بِكُلِّ دِفاعِ نائِبَةٍ يَدانِ",0,"ن",1,0],["هُوَ الغَيثُ أَقلَعَ مُستَخلِفاً","عَلَينا وَقيعَةَ ماءٍ زُلالِ",1,"ل",1,0],["هوَ الغُرّةُ البَيضاءُ في جَبَهاتِهِمْ","وكلُّهُمُ جَوْنُ الإهابِ بَهيمُ",2,"م",1,0],["هوَ الغَيْثُ يُرْوي غُلّةَ الأرضِ مُسبِلاً","هو اللّيثُ يَحْمي ساحَةَ الغابِ مُشْبِلا",3,"ل",2,0],["هُوَ الغُصنُ لَكِن بِالهَوى فيهِ خاطِري","عَلى خَطرٍ لَمّا مَشى وَتَخَطَّرا",4,"ر",2,0],["هُوَ الغَزالُ وَلَكِنِّي عَجِبتُ لَهُ","مِنَ الغَزالَةِ إِذ زارَتهُ أَن نَفَرا",5,"ر",2,0],["هُوَ الغَيمُ مِن زُرقِ الأَسِنَّةِ بَرقُهُ","وَلِلطَبلِ رَعدٌ في نَواحيهِ يَقصِفُ",6,"ف",1,0],["هُوَ الغَاشِمُ السَّاطِي عَلَيْنَا يُبِيدُنَا","هُوَ الآثِمُ المَشَّاءُ فِينَا يُقَسِّمُ",7,"م",1,0],["هُوَ الغَوْثُ وَالغَيْثُ فِي صُورَةٍ","هُوَ البَدْرُ وَالبَحْرُ وَالضَّيْغَمُ",8,"م",1,0],["هو الغيث مهما يُمسكِ الغيث سُحبه","يُروِّ بسحب الجود من كان صاديا",9,"ي",2,0],["هو الغيث ولى بالثناء مشيعاً","وأبقاك بحراً للمواهب منعما",10,"م",2,0],["هو الغيثُ يسقي بلدةً بعد بلدةٍ","من الأرض حتى يسقيَ الأرض أجمعا",11,"ع",2,0],["هو الغرة البيضاءُ من آل مُصْعبٍ","وهم بعده التحجيل والناس أدهمُ",12,"م",1,0],["هُوَ الغَيثُ يَنهَلُّ في صَوبِهِ","سِجالاً وَيَعذُبُ في وِردِهِ",13,"د",2,0],["هُوَ الغَيثُ يُنهَلُّ في صَوبِهِ","دِراكاً وَيَعذُبُ في وِردِهِ",14,"د",2,0],["هُوَ الغَيثُ يَجري مِن عَطاءٍ وَنائِلٍ","عَلَيكَ فَخُذ مِن صَيِّبِ الغَيثِ أَو ذَرِ",15,"ر",1,0],["هُوَ الغَمامُ الذي ما فاضَ مُحتَفِلاً","إلا أصابَ نَداه العُربَ والعَجَمَا",16,"م",2,0],["هو الغَمامُ فهل يُثنَى صَواعقُه","أم هل تُسَدُّ على شُؤبوبِه السُّبُلُ",17,"ل",1,0],["هو الغيثُ تغَنى به بلدةٌ","وأخرى تَحِنُّ إليه افتقارا",18,"ر",2,0],["هو الغيثُ نال الخافقَينِ نوالُه","إلى أن تساوَى عندَه البُعْدُ والقُرْبُ",19,"ب",1,0],["هُوَ الغَيثُ لَو أَفرَطتُ في الوَصفِ عامِداً","لِأَكذِبَ في مَدحيهِ ما كُنتُ كاذِبا",20,"ب",2,0],["هو الغنمُ لم يُقْدَرْ لغير مُوفَّقٍ","له مشهدٌ في حَوْمَةِ الحربِ ميمونُ",21,"ن",1,0],["هُوَ الغَمامُ يُرى رَحماً وَصاعِقَةً","فَاِرجُ نَداهُ وَكُن مِنهُ عَلى حَذَرِ",22,"ر",1,0],["هُوَ الغَيثُ لِلمُعتَفينَ المُغيث","بِفَضلِ مَوائِدِهِ الرادِحَه",23,"ح",2,0],["هُوَ الغَيْثُ السَّكُوبَ نَدىً وعِلْماً","جَهِلْتُ وما هُوَ الغَيْثُ السَّكوبُ",24,"ب",1,0],["هو الغوث والغيث المطير وللهدى","تحاضره روحي على القرب والبعد",25,"د",1,0],["هو الغيث الذي فاضت جمالاً","حقائق سحب نائله المؤبد",26,"د",1,0],["هو الغوث الجليل أبو المعالي","أجل الصالحين علا واوحد",26,"د",1,0],["هو الغوث للأقطاب والقطب مفردا","هو الفرد في الأغواث غيباً مطلسما",27,"م",2,0],["هو الغيث في النجوى وفي الأخفى شاهدٌ","به الحق لا يخفى وبالحق جامحا",28,"ح",2,0],["هو الغوث والقطب في المسلمين","هو الفرد ليس له من قرين",29,"ن",1,0],["هو الغوث لا يُدْرَكُنْهُ فطين","وشهد الشهادة حيث يفين",29,"ن",1,0],["هُوَ الغَيثُ يُنفي عَن مَواقِعِهِ الطَوى","هُوَ الطِبُّ يَشفي إِن شَكَوتَ مِنَ الجَوى",30,"ج",3,0],["هُوَ الغَيثُ لَكن طَلُّهُ وَرَذاذهُ","يَغصُّ بِهِ قُريانُهُ وَالمدالِثُ",31,"ث",1,0],["هُوَ الغيورُ بِهِ ديرُ الغيورِ غَدا","مُشَيَّداً في البَرايا بَعدَ ما هُدِما",32,"م",2,0],["هو الغيث الا انه طاب نائلا","هو البحر الا ان مورده حلا",33,"ل",2,0],["هو الغيث الا انه طاب نائلا","هو البحر الا انه سائغ الشرب",34,"ب",1,0],["هو الغافريُّ الأريحيُّ الذي له","مواهبُ لا تُحصى على الخَلْق تُنْشَرُ",35,"ر",1,0],["هو الغيثُ إن قلَّ الحيا في زمانِنا","هو اللَّيثُ قد أردى المُضلّ مُعَفَّرا",36,"ر",2,0],["هو الغاية القُصوى إذا اشتبكَ القَنَا","وقُطْبُ رحى الهيجا إذا اتسعَ المدى",37,"د",2,0],["هُوَ الغَيثُ إِن عَمَّ جَدبٌ أَثابَ","وَاللَيثُ إِن عَنَّ خَطبٌ وَثَب",38,"ب",1,0],["هُوَ الغنيُّ وإني في هواه إلى","أمانه من عذاب الهجر مُقتَقر",39,"ر",1,0],["هُوَ الغَاوِي ولا عَجَبٌ لِفَاوٍ","وَيَتْبعُ شَاعِراً جَمَّ الفَوائِدْ",40,"د",1,0],["هُوَ الغَيث وَاللَيث المقاد لأَمرهِ","مِن الذُعر جمٌّ لا ينال غفيرُ",41,"ر",1,0],["هو الغرامُ أقامَ الحيُّ أم ظَعَنوا","إن هاجَروا قَتلوا أو واصلوا فَتَنوا",42,"ن",3,1],["هو الغيث يوم الجود واللَّيث في الوغى","فغيث نداها كفَّ ليث وغاها",43,"ا",3,0],["هو الغيث الذي أبداً إليهِ","لكلٍ من بني الأدب انتجاع",44,"ع",1,0],["هو الغَمامُ الذي ما حَلَّ في بَلَدٍ","إِلاَّ أَفاضَ دماءً منه أو دِيَمَا",45,"م",2,0],["هو الغيثُ إلا أنه كلما هَمى","تفيضُ بجَدواهُ الرُبى والأباطحُ",46,"ح",1,0],["هو الغمام المرجى صوب عارضه","والصارم المنتضى والفارس النجد",47,"د",1,0],["هو الغصن كان كميناً فهبَّ","لدى كربلاء بريحٍ عصوفِ",48,"ف",1,0],["هو الغاني ببلغته وحمْدٍ","عن النَّشب المُجمَّع والتِّلادِ",49,"د",1,0],["هو الغيثُ شحَّاح العشيَّة مُغدقٌ","تُرجَّى هواميه وتخشى صواعِقهْ",50,"ق",2,0],["هو الغيثُ يرجى سَحُّهُ ونوالُه","وذو شُطَبٍ تُخشى سُطاهُ وحدُّه",51,"د",2,0],["هو الغيث ما احببت سله تفز به","وإن كنت موموق الغنى سائغ الورد",52,"د",1,0],["هو الغاية القصوى فمن شاء فليمت","فكل مصاب دونه في المراتب",53,"ب",1,0],["هو الغوث والغياث إن قحط الورى","ينادوا أيا روح الوجود ألا قرى",54,"ر",2,0],["هو الغيث للاحباب والليث للعدى","وداداً واكراهاً يفرو ينفع",55,"ع",1,0],["هو الغصنُ الذي جَنَتِ المنايا","عليهِ بقصفهِ ظُلماً وغَدرا",56,"ر",2,0],["هُو الغيثُ لا الرَّعدُ الأجَشُّ مُقَهقِةٌ","عَليهِ ولا البَرقُ المرَفرِفُ مُومِض",57,"ض",1,0],["هو الغصن إن مالت به نشوة الصبا","سوى ان دعص الرمل ما ضمه المرط",58,"ط",1,0],["هُوَ الغَيث وَاللَيث الَّذي في يَمينه","يَسارٌ وَإِنذار لَغاد وَغادر",59,"ر",1,0],["هو الغيث الا انه إن تأججت","لظى الحرب في يوم الوغى غير مرعد",60,"د",1,0],["هو الغيث لو سح السحاب بلؤلؤ","وروض الندى لو أنبتت بالزبرجد",61,"د",1,0],["هو الغنيُّ وإنْ لم يُمْسِ ذا نَشَب","وهو النَّسيبُ وإنْ لم يُمْسِ ذا نسَبِ",62,"ب",1,0],["هو الغيثُ الذي يُرْجَى ولكنْ","يقصِّرُ عن سماحتِه الغمامُ",63,"م",1,0],["هو الغَرامُ فلا عَذْلٌ ولا عَتَبٌ","عليك، سُبحانَ مُجْرِيَها وَمُرْسِيها",64,"ي",3,0],["هُوَ الغَدُ لَوحكُمُ يا شَباب","فَخَطّوا مِنَ العَزمِ عُنوانها",65,"ن",3,0],["هو الغيث في الدهما هو الليث في الوغى","هو البدر في الظلما هو الدهر في الهممْ",66,"م",1,0],["هو الغوثُ المُرَجَّى وهو حَسْبِي","إذَا مَا الدَّهْرُ نَكَّرَ مَا تَعَرَّفْ",67,"ف",1,0],["هو الغيث بل أندى ولولاه ما جرت","دموع غيروم في محاجر نرجس",68,"س",1,0],["هو الغيث في محل هو الليث في وغى","هو الزهر في روض هو الزهر في سما",69,"م",2,0],["هو الغاية القصوى التي ليس يعدها","مطار ولو طار المعاند محوما",69,"م",2,0],["هو الغيث بل أندى من الغيث راحة","إذا لمسته للندى كفّ طامع",70,"ع",1,0],["هو الغوث فالجأ للكريم بجاهه","تجد خير جواد وأكرم شافع",70,"ع",1,0],["هو الغيث لا والله بل هو أجود","من الغيث في بذل النوال وأكرم",71,"م",1,0],["هو الغصن لا والله بل هو أميس","من الغصن عند الانثناء وأقوم",71,"م",1,0],["هو الغاية القصوى لمن هو طالب","هو الآية الكبرى لمن يتفهم",71,"م",1,0],["هو الغيث في بذل النّوال إذا طما","هو الليث في يوم النّزال إذا كرّا",72,"ر",2,0],["هو الغفار والرحمن ربي","مغيث الملتجى معطي الجزيلا",73,"ل",2,0],["هو الغوث في الضرا هو الغيث في الضنا","هو الذخر في سوء الخطوب ومسنيدي",74,"د",2,0],["هو الغمامُ الذي تُخشى صواعقُهُ","قهراً وترجُو نداه العُرْبُ والعَجَمُ",75,"م",1,0],["هُوَ الغَيْثُ مَهْمَا بَلَّ أَرْضاً فَبَرْقُهُ","حُسَامٌ بِهِ جَنْبَ المُنَاجِزِ قَدْ كَوَى",76,"و",2,0],["هُوَ الغَيثُ مِن أَيِّ الوُجوهِ اِنتَجَعتَهُ","وَجَدتَ جَناباً مُستَطاباً وَمَشرَعا",77,"ع",2,0],["هوَ الغرامُ وفيهش الصبر قد فرضا","فكن لهُ غرَضاً ان رمتهُ غرضا",78,"ض",2,1],["هو الغزالةُ في إشراق غُرّتِهِ","وابنُ الغزالةِ لحظاً زاتَهُ الحور",79,"ر",1,0],["هُوَ الغَيْثُ أو فالغيثُ منهُ سَميُّهُ","نَهَشُّ إليه الهُضْبُ وهي وُجُوم",80,"م",1,0],["هو الغِرُّ يَدري ما بِمَنزلِ غيره","وَلَيسَ بِما يَجري بِمَنزله يَدري",81,"ر",2,0],["هو الغيثُ مهما جاوز النَّفعَ ضائرٌ","وحسبُكَ منه ما يعُمُّ نَوالُهُ",82,"ل",2,0],["هو الغوث للعاني إذا عز غوثه","هو الغيث إن ظن السحاب بجدواه",83,"ا",2,0],["هو 