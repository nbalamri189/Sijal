{"poems":[[55,"بود الرذايا أنها في السوابق","https://www.aldiwan.net/poem29954.html","الطويل"],[55,"نزلنا بمستن المكارم والعلى","https://www.aldiwan.net/poem30607.html","الطويل"],[55,"لغام المطايا من رضابك أعذب","https://www.aldiwan.net/poem30757.html","الطويل"],[53,"وليس نسيم المسك ريح حنوطه","https://www.aldiwan.net/poem65487.html","الطويل"],[147,"تخلف عنه الصبر فيمن تخلفا","https://www.aldiwan.net/poem11783.html","الطويل"],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[170,"بعدت وما حكم البعاد بعادل","https://www.aldiwan.net/poem46895.html","الطويل"],[353,"فينظرني من الحمى جميعا","https://www.aldiwan.net/poem20393.html","الوافر"],[369,"رمتني بلحظ واتقتني بمعصم","https://www.aldiwan.net/poem60649.html","الطويل"],[396,"يا أرحم الراحمين يا أرحم الراحمين","https://www.aldiwan.net/poem54481.html","عموديه"],[409,"أنار تشك ألهبت طي قرطاس","https://www.aldiwan.net/poem33727.html","الطويل"],[422,"يا ناجيا نحو كل مكرمة","https://www.aldiwan.net/poem54078.html","المنسرح"],[447,"الرزق ما بين خلق الله مقسوم","https://www.aldiwan.net/poem14386.html","البسيط"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72291","الطويل"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/45000","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56018","الوافر"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31563","المنسرح"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64445","الطويل"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26674","الطويل"],[2176,"","https://poetry.dctabudhabi.ae/diwan/poem/69459","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100727","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100716","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100790","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92062","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102976","البسيط"],[5200,"أعقب أعزّك ربّ العباد","https://www.poetsgate.com/ViewPoem.aspx?id=200809",""],[5277,"\"أينَ العراقُ.. تُرى؟\"","https://www.poetsgate.com/ViewPoem.aspx?id=206804",""],[1059,"أجيرة قلبي إن تدانوا وإن شطوا","https://www.poetsgate.com/ViewPoem.aspx?id=108380",""],[5431,"إن الفؤاد لمن يهواه قد شفعا...","https://www.poetsgate.com/ViewPoem.aspx?id=190514",""],[5550,"أريد","https://www.poetsgate.com/ViewPoem.aspx?id=215569",""],[5691,"سباق الموت","https://www.poetsgate.com/ViewPoem.aspx?id=206099",""],[6300,"مصير آخر فارس عربيّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82875&r=&rc=46",""]],"verses":[["وَلَيسَ نَهارُ الشَيبِ عِندي بِمُزمِعٍ","رُجوعاً إِلى لَيلِ الشَبابِ الغُرانِقِ",0,"ق",1,0],["وَلَيسَ نَرى لِلفَضلِ وَالمَجدِ دونَنا","عَلى حالَةٍ قَصداً وَلا خَلفَنا مَغدى",1,"د",2,0],["وَلَيسَ نَسيبي أَنَّ في القَلبِ لَوعَةً","وَلَكِنَّني أَبكي زَماني وَأَندُبُ",2,"ب",1,0],["وليس نسيم المسك ريح حنوطه","ولكنه ذاك الثناء المخلفُ",3,"ف",1,1],["وَلي سَنَةٌ لَم أَدرِ ما سِنَةُ الكَرى","لِهَمٍّ أَتى ضَيفاً فَأَلفى مُضَيِّفا",4,"ف",2,0],["وليس نصير الشيخ بالسب والهجا","كمحتسب في الله قام مناصري",5,"ر",2,0],["وليسَ نظامُ الملكِ إلاّ سحابَةٌ","يشيمُ حَياها كلُّ حافٍ وناعِلِ",6,"ل",1,0],["وَلي سَنَةٌ أَكابِدُها فَتَمضي","وَتَأْتي وَهْيَ سَاخِطَةٌ عَبُوسُ",7,"س",1,0],["ولي سَنةٌ من بَعْدِ أُخرَى أَقَمتُها","أُمارسُ من أهوالها كُلَّ مُعْظَم",8,"م",1,0],["وليس نرجو سواك","فادرك إلهي دراك",9,"ك",1,0],["وليس نهاري بالنهار الذي مضى","قد التبسا من بعدكم أي إلباس",10,"س",1,0],["وليس نقلي له على طمعٍ","ولا لمالٍ يرجى ولا نشب",11,"ب",1,0],["وليس نعلم بالموت الزؤام وذو ال","جد الوضيع على الأغفال موزوم",12,"م",1,0],["وليس نسق السفن أمواجه ولا","بساحله للعيس رفع ولا حط",13,"ط",1,0],["وَلَيسَ نَسيمُ المِسكِ ما تَجِدونَه","وَلكِنَّهُ ذاكَ الثَناءِ المُخلِف",14,"ف",1,0],["ولي سنةٌ به قد راّخوها","مباركةٌ بفتح الله جدّا",15,"د",2,0],["ولَيْسَ نارُ الهُمومِ خامِدَةً","إِلا بِنورِ الكُؤوسِ مُلْتَهِبا",16,"ب",2,0],["وليس نداء عن نداء بمشغل","لسمعك حكم الفرد فيه ككثرة",17,"ه",1,0],["وليس نديمي غيرَ أبيضَ صارمٍ","وليس سميري غيرَ شخصِ كتاب",18,"ب",1,0],["وَلَيسَ نَصيرُ الحَقِّ مَن صَدَّ دونَهُ","وَنَدَّ وَلا مَن شَكَّ فيهِ وَأَلحَدا",19,"د",2,1],["وَليسَ نكيرا أن نراك غضنفراً","يصول بمصقول اذا هز صمما",20,"م",2,0],["وليس نكيراً أن يُرى لك جاحد","بآلائك الحسنى عليه يكذّب",21,"ب",1,0],["وليس نكيراً بعد موت محمد","اذا ودعت دنيا تغر ودين",22,"ن",1,0],["وَليسَ نسمع ذا إلا بِسَمعِ غَوٍ","حتى كَأن بواكينا تغنّينا",23,"ن",2,0],["وليس نعجب إلا أن يقال لنا","قد أطلعت هذه السيارة الفكر",24,"ر",1,0],["وليس نبيذ فنحيا به","حياة النبات بماء الشرى",25,"ا",1,0],["وليسَ نحسنُ ظناً والنوى دولٌ","فكيفُ نصبرُ.. لا سلوى.. ونحتملُ",26,"ل",1,0],["وليس نسق السفن أمواجه ولا","بساحله العيس رفع ولا حط",27,"ط",1,0],["وليس نرضى إلا الحب ملتجأ","وليس للقلب إلاّ ماإليه سعى",28,"ع",2,0],["وليسَ نبيلاً منْ يُنكِّدُ عَيْشَه","بقلْبٍ حَقُودٍ دائمًا في المعايب",29,"ب",1,0],["وليْسَ ندْري مَداهُ","ولا لِماذا السِّباقُ !",30,"ق",1,0],["وليس نسيمُ الحبِّ يوما يزورُنا","وليستْ قلوب الناس تجمعُ ما ارتمى",31,"م",2,0]]}