/ViewPoem.aspx?id=27831",""],[4804,"اذا ظلم الشيب رأس الفتى","https://www.poetsgate.com/ViewPoem.aspx?id=92079",""],[4927,"الْحُبُّ دَيْنٌ","https://www.poetsgate.com/ViewPoem.aspx?id=29619",""],[4978,"لا بد مني كي يكون فتيلا","https://www.poetsgate.com/ViewPoem.aspx?id=177270",""],[5064,"سيرة غير منشُورة","https://www.poetsgate.com/ViewPoem.aspx?id=199145",""],[585,"سل عن الكون من يحير جواباً","https://www.poetsgate.com/ViewPoem.aspx?id=161882",""],[5081,"يَا رَشِيقَ الْحَرْفِ","https://www.poetsgate.com/ViewPoem.aspx?id=187581",""],[5135,"هلال السعد","https://www.poetsgate.com/ViewPoem.aspx?id=204492",""],[5183,"الجلاء عن قاعدة بنزرت","https://www.poetsgate.com/ViewPoem.aspx?id=185647",""],[5277,"لحاظ الروح","https://www.poetsgate.com/ViewPoem.aspx?id=197623",""],[5397,"أترع لي في سفحه الأجرع","https://www.poetsgate.com/ViewPoem.aspx?id=157902",""],[5431,"إن الفؤاد لمن يهواه قد شفعا...","https://www.poetsgate.com/ViewPoem.aspx?id=190514",""],[5582,"نَفْسُ المُتَيَّمِ لَوْ ظَلَلْتَ تَلُومُها","https://www.poetsgate.com/ViewPoem.aspx?id=187301",""],[5602,"في موعد آخر لم نلتق","https://www.poetsgate.com/ViewPoem.aspx?id=204903",""],[5701,"تحية من شاعر شاكر","https://www.poetsgate.com/ViewPoem.aspx?id=164709",""],[402,"لحق اليوم بالرفقا أمين","https://www.poetsgate.com/ViewPoem.aspx?id=36483",""],[5790,"الله أكبر أي طرف يطمح","https://www.poetsgate.com/ViewPoem.aspx?id=111868",""],[5953,"إن يوم الغدير يوم السرور","https://www.poetsgate.com/ViewPoem.aspx?id=93784",""],[5956,"العدل نِسْبيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=184126",""],[5975,"عذّبيني","https://www.poetsgate.com/ViewPoem.aspx?id=53252",""],[5977,"أمة الاسلام","https://www.poetsgate.com/ViewPoem.aspx?id=213289",""],[6093,"ذَارِيْ الرِّيْحِ","https://www.poetsgate.com/ViewPoem.aspx?id=187943",""],[572,"وروضة ٌ مشبعة ُ الأَصباغِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9386&r=&rc=243",""]],"verses":[["فَبَلاكَ عَيبَ البَأسِ يَومَ كَريهَةٍ","وَرَآكَ طودَ الحِلمِ يَومَ مِراسِ",0,"س",1,0],["فَبَلِّغ سادَةَ الأَحياءِ أَنّا","سَلَونا بِالغِنا ضَربَ القِداحِ",1,"ح",1,0],["فَبَلائي مُذ فارَقَتني طَويلٌ","وَبَناتُ الفُؤادِ ذاتُ اِهتِزازِ",2,"ز",1,0],["فبَلَغْتُ لمّا أنْ ظفِرْتُ بقُرْبِها","أمَلاً ملأتُ بهِ يَدَيَّ وسُولا",3,"ل",2,0],["فبلّغَ الرّحْمانُ سيْ","ف النّصْرِ فيهِ ما ابْتَغى",4,"غ",2,0],["فَبَلِيَّتي الحَرُّ الأَلي","مُ وَخَطبُكَ القُرُّ الأَليمُ",5,"م",1,0],["فَبَلَغتُ مِن نُعماهُ ما لا يَنتَهي","أَملي وَلَم يَطمَح إِلَيهِ مَطمَعي",6,"ع",2,0],["فبلغاهم تحيات تنسمهم","من طيب منبتهم أرواح ريحان",7,"ن",1,0],["فَبَلَغْتَ المُنَى العَصِيَّةَ بِالعَزْ","مِ وَذُو العَزْمِ بِالنَّجَاحِ قَمِينُ",8,"ن",1,0],["فَبَلَغْنَا مَعَ الْكُهُولَةِ شَأْناً","لَمْ يَكُنْ فِي حَدْسٍ وَلا تَنْجِيمِ",9,"م",1,0],["فَبُلِّغتُها في ظلِّ أَمنٍ وَغِبطَةٍ","وَسُنّيَ لي مِمّا يعوقُ سَلامُ",10,"م",1,0],["فَبِلَحظِها نَكِرَت قَناتي راحَتي","ضَعفاً وَأَنكَرَ خاتِمايَ الخِنصِرا",11,"ر",2,0],["فبلغناها وهللنَا لها","ونزَلنَا الخُلدَ فينَاناً نَدِيَّا",12,"ي",2,0],["فَبُلّغْتَ المُنى فيه ومَرّتْ","به تلك الليالي وهي صُلْحُ",13,"ح",1,0],["فبلفظةٍ أو لحظةٍ مِنْ جاهكمْ","أسمو فأصبحُ عاليَ البنيانِ",14,"ن",1,0],["فَبَلِّغ أَميرَ المُؤمِنينَ وَقُل لَهُ","بَعَثتَ عَلَينا مَن أَراحَ وَأَرقَدا",15,"د",2,0],["فبلغ العُمْرانَ عمرو فرمى","بجمعه الروم حيال الفرَما",16,"م",2,0],["فَبلَغنا صَنعَهُ حَتَّى شَتا","ناعِمَ البالِ لَجُوجاً في السَّنَن",17,"ن",1,0],["فبليني فقد شعرت بروحي","وثبت وارتمت على شفتيّا",18,"ي",2,0],["فبلغ الرحمن سيف","النصر فيه ما ابتغا",19,"غ",2,0],["فَبکلأَمْسِ أَرْسَلْنَا بِذَلِكَ خَالِداً","إلَيْكَ وَبَيَّنَّا لَهُ الشَّأْنَ أَجْمَعَا",20,"ع",2,0],["فبلطوا البحر غيظاً من معاملتي","وبالجحيم إن اسطعتم فزجوني",21,"ن",2,0],["فَبَلَّ بَلاَلُ أجفَاني جُفُوني","ولَم أَحجُ الجُفُونَ بِهَا بَلاَلُ",22,"ل",1,0],["فَبِلِيغُهُم وإِمَامُهم وخَلِيلُهُم","بَينَ الجُمُوعِ كَأوجِهِ الأَقمَارِ",23,"ر",1,0],["فَبَلِّغ قُصَيّاً أَن سَيُنشَرُ أَمرُنا","وَبَشِّر قُصَيّاً بَعدَنا بِالتَخاذُلِ",24,"ل",1,0],["فَبَلِّغ عَلى الشَحناءِ أَفناءَ غالِب","لُؤَيّاً وَتيماً عِندَ نَصرِ الكَرائِمِ",25,"م",1,0],["فَبَلَغتَ أَمراً لَو سِواكَ يَرومُهُ","لَثَناهُ طَعنٌ دونَهُ وَضِرابُ",26,"ب",1,0],["فَبَلِّغ قُريشاً أَن خَيرَ نَدِيِّها","وَأَكرَمَ مَن يَمشي بِساقٍ عَلى قَدَم",27,"م",1,0],["فَبلبنان أَيمُ المَجدِ ثَكلى","وَهيَ تَبكي مصيبَةَ الأَبناءِ",28,"ا",2,0],["فَبَلَّغَ وَالإِلَهُ بِهِ حَفِيٌّ","رِسَالَتَهُ لِمُخْتَلِفِ الشُّؤُونِ",29,"ن",1,0],["فَبَلاَبِلِي مِنْ بَعْدِهِ مَوْقُودَةٌ","وَالشَّوْقُ لاَ يَدْرِيهِ إِلاَّ اللهُ",30,"ه",1,0],["فَبِلَحظَةٍ مِنهُ تَعودُ عُفاتُهُ","عَنهُ مُؤَمّلَةَ النَوالِ مُمَوَّلَه",31,"ل",2,0],["فَبَلَّغَهُ دَلَجٌ دائِبٌ","وَسَيرٌ إِذا صَدَحَ الجُندَبُ",32,"ب",1,0],["فبلغ أمر اللَه تبليغ صادق","امين شفيق واسع الصدر صابر",33,"ر",1,0],["فَبَلِّغهُ عَنّي يا نَسيمَ تَحِيَّةٍ","يَشوقُ لَها خَيري وَيَحسُدُها نَدُّ",34,"د",1,0],["فَبَلَّ وابِلُ دَمعي ما عَدا كَبِدي","وَمَزَّقَ السُقمُ إِلّا ثَوبَ أَحزاني",35,"ن",2,0],["فبلَغْتَ قاصيةَ المَدى وملكْتَ نا","صيةَ العُلا وحَويْتَ عاصِيةَ المُنى",36,"ن",2,0],["فبلّغَك الأيّامُ قاصيةَ المُنَى","ومَلَّكك الإقبالُ ناصيةَ البِغى",37,"غ",2,0],["فَبلَّغْ سَلاميَ بَدْرَ الخيا","مِ يَكْسِفُه نأْيُه والصُّدود",38,"د",1,0],["فبلغتُ منزل منسكي","وهناك بلوى باليه",39,"ي",2,0],["فَبَلِّغوهُم من سَلامي النامي","ما لا يَزولُ مُدَّةَ الأَيّامِ",40,"م",1,0],["فَبَلِّغوا عَنّي سَلاماً دائِبا","سَلامَ مَن يَرى الوَلاءَ واجِبا",40,"ب",2,0],["فبلام عارضه وفاتن طرفه","يسبي الأنام باخضرٍ ويماني",41,"ن",2,0],["فبلغ نسيم الصبح عني جواره","كرام الوجوه الصبح ما أنت عالمه",42,"م",2,0],["فبلغتني أقصى منتهى أملي","وأنزلتني بظلّ منه ممدودِ",43,"د",1,0],["فبلاقع الموتى عماراً أصبحت","وعمارة الأحياء بعدك بلقع",44,"ع",1,0],["فَبلَغتْ أدعو لها وَبلَّغتْ","وخانني من لم يقل آمينا",45,"ن",2,0],["فبلِّغْ وقل لا طامعا في رجوعه","إلامَ على فرط السماح تلامُ",46,"م",1,0],["فبلَّ الغليلَ ولم يُروِه","وأعطَى القليلَ ولم يمنعِ",47,"ع",1,0],["فبلِّغ ربيعةَ إن جئتَها","وسعداً وأسمعْ بني مِسْمَعِ",47,"ع",1,0],["فبَلَغْتَ بالإِخلاصِ ما عَجزتْ","عنهُ الصَّوارِمُ والقَنا السَّلَبُ",48,"ب",1,0],["فبلغهم تحيات وسلهم","دعاءاً صالحا يا ابن المقيني",49,"ن",2,0],["فبَلغتُ منكَ مَدىً،وَمِن نفسي مَدىً","الحُبُّ بَينَهُما المَسارُ الأنصَعُ",50,"ع",1,0],["فبلَّدَهُمْ وصيَّرَهُمْ حَيارى","وتاهُوا في المَهامِهِ والبِلادِ",51,"د",1,0],["فبلغتُ عندك رتبةً لا تُرتَقى","ونزلتُ منك مكانةً لا تُنزَلُ",52,"ل",1,0],["فبليتُ من نجواه لا ناجى بها","بمسهِّدٍ طولَ الدُّجى ومؤرّقِ",53,"ق",1,0],["فَبَلَغَتْ نِهَايَةَ البَلاَغِ","بَاغٍ مِنَ الحُسْنِ إِزَاءَ بَاغِ",54,"غ",1,0],["فبلغ الحجة والرسالة","فكفروا وكذبوا مقاله",55,"ه",1,0],["فبلّغ الدعاء من لديه","فجاءه مغمّضا عييه",55,"ه",1,0],["فبلغ القول إلى النبي","فقال ما قد قال في علي",55,"ي",1,0],["فبلغ الأمر إلى ابن حرب","وكان من مسيره في كرب",55,"ب",1,0],["فَبَلَّغْتُ نفسِي من غَرامِي مَرامَها","وآتيتُ قَلبي في هُوَاهُ هُدَاهُ",56,"ا",2,0],["فَبِلينِ عِطْفَيهِ وقَسْوةِ قَلْبه","حازَ الجمال مؤنَّثاً ومذكَّرا",57,"ر",2,0],["فبلاده فقدت به بطلاً إذا","خاض المعامع فاز وهو غضنفر",58,"ر",1,0],["فبلغتُ الذي بلغت","به غايةَ الأملْ",59,"ل",1,0],["فَبِلاد مصر قابَلت","ما جاء فيه باِرتياحِ",60,"ح",1,0],["فَبَلَّغَت بِلسانِ الحالِ إذ نَسَمَت","تَحيَّةٌ ما يُؤدّيها إليّ فَمُ",61,"م",1,0],["فَبِلاد الأَغراب فيها مَعاشٌ","لِلَّذي في خدامة القُطر مَعنا",62,"ن",2,0],["فبلغ وزير الملك أنّا دعاته","إلى كل ما يرضي البلاد ويرضيه",63,"ي",2,0],["فَبِلَمحَةٍ يَبدو الصّريعُ عَلى الثّرى","وَوَليمَةٍ قَد هُيِّئَت لِلمَأكَلِ",64,"ل",1,0],["فَبِلادُهُ كانَت بِلا جَبلٍ لَها","وَالآنَ قَد صارَت بِذاتِ الأجبلِ",64,"ل",1,0],["فَبَلغت أَخباره السُلطانا","فَجاءَ لِلسَطح وَما تَوانى",65,"ن",2,0],["فَبَلغ الحاكم مُذ شاعَ الخَبَر","بِأَن ذا التاجر عَنهُ قَد نَفَر",66,"ر",1,0],["فبلغك الله ما ترتضي","وأعطاك أقصى المنى والأرب",67,"ب",1,0],["فبلطفه قد ماس غص","ن البان كالنشوان مائل",68,"ل",1,0],["فبلغه عنا وإن كان منا","لديه قليلا سلاماً كثيرا",69,"ر",2,0],["فَبَلِّغْ سَلاَمَ النَّازِلِينَ بِهِ عَنَّي","وَلَمَّا اسْتَقَلُّوا ظَاعِنِينَ وَقَدْ غَدَتْ",70,"ت",1,0],["فبلغت فيه ما توصل ساحها","يا ابن الكرام ملاءة المحسودِ",71,"د",1,0],["فبلثمي والضمّ من خدّها وال","نهد أجني التفاح والرمانه",72,"ن",2,0],["فِبِلاد الشام تَهدي بِا