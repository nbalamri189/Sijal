{"poems":[[65,"ألا بأبي بلادك يا سليمى","https://www.aldiwan.net/poem46084.html","الوافر"],[73,"لما تشكى ابن عصرون إلي حمى","https://www.aldiwan.net/poem3816.html","البسيط"],[49,"ما العمر ماطالت به الدهور","https://www.aldiwan.net/poem24771.html","الرجز"],[53,"قلت لخود ضفتها مرة","https://www.aldiwan.net/poem65392.html","السريع"],[93,"أطار عني النوم صوت في الدجى","https://www.aldiwan.net/poem62627.html","عموديه"],[87,"لست بناس ليلة","https://www.aldiwan.net/poem8051.html","مجزوء الرجز"],[50,"ومعتد بالذي تحوي أنامله","https://www.aldiwan.net/poem64499.html","البسيط"],[50,"وصاحب زان كل مصطحب","https://www.aldiwan.net/poem65301.html","المنسرح"],[50,"سقيا لظبي كالرمح في عدله","https://www.aldiwan.net/poem66276.html","المنسرح"],[50,"أصبح أيري معرضا عني","https://www.aldiwan.net/poem66284.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42611","البسيط"],[53,"قلتُ لخودٍ ضفْتُها مرة ً","https://www.poetsgate.com/ViewPoem.aspx?id=29499",""],[115,"الحمد لله على ما الهما","https://www.aldiwan.net/poem2368.html","الرجز"],[190,"حصلت علقا ماجنا شاعرا","https://www.aldiwan.net/poem44093.html","السريع"],[197,"ظبي يحار البرق عن بريقه","https://www.aldiwan.net/poem13090.html","الرجز"],[208,"متيم بالصدود مستهتر","https://www.aldiwan.net/poem53307.html","المنسرح"],[234,"خوفته سلوتي فخافا","https://www.aldiwan.net/poem50936.html","مخلع البسيط"],[234,"أذكرني النرجس أجفان من","https://www.aldiwan.net/poem50987.html","السريع"],[234,"يا رب ليل بته ناعما","https://www.aldiwan.net/poem51036.html","السريع"],[303,"للشمس إذ هجعت أضغاث أحلام","https://www.aldiwan.net/poem36845.html","عموديه"],[369,"عهد هوى كنا عهدناه","https://www.aldiwan.net/poem60599.html","السريع"],[369,"لأي وميض بارقة أشيم","https://www.aldiwan.net/poem60666.html","الوافر"],[371,"يا فاضلا بهرتنا من فصاحته","https://www.aldiwan.net/poem17924.html","البسيط"],[422,"أنيخاها فقد بلغت مناها","https://www.aldiwan.net/poem54083.html","الوافر"],[463,"أين ظباء المنحنى","https://www.aldiwan.net/poem55827.html","مجزوء الرجز"],[463,"أفلح قوم إذا دعوا وثبوا","https://www.aldiwan.net/poem56299.html","المنسرح"],[473,"وليلة أيقظني معانقي","https://www.aldiwan.net/poem59521.html","الرجز"],[473,"رأيت من لست له ذاكرا","https://www.aldiwan.net/poem59783.html","السريع"],[473,"وليلة لم تك في سري","https://www.aldiwan.net/poem60007.html","السريع"],[521,"حلفت بمن حجت قريش لبيته","https://www.aldiwan.net/poem48704.html","الطويل"],[556,"يا ليلة لما نأى بدرها","https://www.aldiwan.net/poem48067.html","السريع"],[572,"جنبك الله عارض العلل","https://www.aldiwan.net/poem69535.html","المنسرح"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86622","البسيط"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96315","الرجز"],[1449,"","https://poetry.dctabudhabi.ae/diwan/poem/110682","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27607","البسيط"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88657","الرجز"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120677","البسيط"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121182","البسيط"],[2751,"","https://poetry.dctabudhabi.ae/diwan/poem/138895",""],[2957,"","https://poetry.dctabudhabi.ae/diwan/poem/198441","السريع"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103453","الرجز"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105622","الرجز"],[3382,"","https://poetry.dctabudhabi.ae/diwan/poem/144923","المنسرح"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68030","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138495",""],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66426","الطويل"],[3665,"","https://poetry.dctabudhabi.ae/diwan/poem/34711","المنسرح"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91523","البسيط"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34614","السريع"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32791","السريع"],[3852,"","https://poetry.dctabudhabi.ae/diwan/poem/124203","الوافر"],[4070,"","https://poetry.dctabudhabi.ae/diwan/poem/80131","الطويل"],[4886,"لله كم من هضبةٍ وجبلِ","https://www.poetsgate.com/ViewPoem.aspx?id=170308",""],[5183,"وَقَارُ الحَوَادِثُ","https://www.poetsgate.com/ViewPoem.aspx?id=186446",""],[5204,"وابأبى من زرتها ليلة","https://www.poetsgate.com/ViewPoem.aspx?id=200373",""],[5493,"الآن قد خانني الإلهام.","https://www.poetsgate.com/ViewPoem.aspx?id=205969",""],[5790,"يا فاضلا بهرتنا من فصاحته","https://www.poetsgate.com/ViewPoem.aspx?id=111911",""],[5793,"المثل العليا.. تنتحر!","https://www.poetsgate.com/ViewPoem.aspx?id=199055",""],[6320,"نَزِيفُ القَهْر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84335&r=&rc=32",""],[572,"جَنّبكَ الهُ عارضَ العِلَلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9438&r=&rc=295",""]],"verses":[["فَلَمْ أُزِرِ الدِّيارَ الطَّرْفَ حَتّى","نَفَضْتُ بِهِنَّ أَوْعِيَةَ الدُّموعِ",0,"ع",1,0],["فَلَم أَزَل عِندَهُ جَذلانَ في دَعَةٍ","مُمَتَّعاً مِن أَياديهِ بِأَوطارِ",1,"ر",1,0],["فَلَم أَزَل أَمسَحُهُ حَتّى اِنبَسَط","وَهَشَّ لِلصَيدِ قَليلاً وَنَشَط",2,"ط",1,0],["فَلَم أَزَل أَختِلُها وَتُختَتَل","وَإِنَّما نَختِلُها إِلى أَجَل",2,"ل",1,0],["فلم أزل أشفي حراراتِها","بمثل رأس الرجل الأصلع",3,"ع",1,0],["فَلَم أَزَل أَرسُفُ أَغلالي","وَلَم أَزَل في حِندِسِ المُحالِ",4,"ل",1,0],["فَلَم أَزَل حَتّى اِطمَأَنَّ","جَأشُها وَقَرَّتِ",5,"ت",1,0],["فَلَم أَزَل أَتَفَدّاهُ وَأَرفَعُهُ","عَن وَهدَةِ الأَرضِ وَالنَشوانُ مُحتَمِلُ",6,"ل",1,0],["فَلَم أَزَل بِالرُقى أُعَلِّلُهُ","حَتّى اِنجَلى عَنهُ عارِضُ الوَسَنِ",7,"ن",1,0],["فلم أزل بالرُقى أدرّجهُ","تدريجَ طيرٍ لطالبي زَجَلِه",8,"ل",2,0],["فلم أزل أصبر حتى إذا","مالَ على الجنبِ من الوهنِ",9,"ن",1,0],["فَلَمْ أَزَلْ بِرُقَى الأَشْعَارِ أَعْطِفُهَا","وَرُقْيَةُ الشِّعْرِ تُجْرِي الْمَاءَ فِي الْحَجَرِ",10,"ر",1,0],["فلم أزل أشفي حرارتها","بمثل رأس الرَّجل الأصلع",11,"ع",1,0],["فَلَم أًَزَل مُعتضذِراً عَن هَذا","وَلَم أَجد عَن أمرِهِ مَلاذا",12,"ذ",2,0],["فلم أزل أدفع في ذاته","من أجل ما يشعر من ذاته",13,"ت",2,0],["فَلَم أَزَل أَرشفُ مِن رَحيقِهِ","حَتّى شَفيتُ القَلبَ مِن حَريقِهِ",14,"ه",1,0],["فلم أزل بالرُّقى أُدرِّجه","حتى إذا لان حلَّ لي المئزر",15,"ر",1,0],["فلَمْ أزل ألثم التّراقي","والخصرَ والأَنْمل اللطافا",16,"ف",2,0],["فلم أزل ألثم مبيضَّه","شوقاً على طِيبِ جَنَى الأكؤسِ",17,"س",1,0],["فلم أَزْل أَشربُ من كفّها","وأَجْتَنِي الشّهَد من الثَّغْر",18,"ر",1,0],["فلم أَزلْ شاخصاً حتى طغى بصري","وزاغ ما بين إيماضٍ وإِعتام",19,"م",1,0],["فلم أزَلْ أسحَبُ ذَيْلَ الدُّجَى","على بَعيرٍ مادَ ضَبْعاه",20,"ا",2,0],["فلمّا زُرْتُ نجْمَ الدِّينِ قَصْداً","ودارَ بمَدْحِهِ كَأْسٌ رَذوم",21,"م",1,0],["فَلَم أَزَل اَجتَني لَيلى مَحاسِنِها","وَأَجتَنيها فَقُل في الزُهرِ وَالزُهَرِ",22,"ر",1,0],["فلم أزدَد بها إلاَّ اختباراً","ولم أزْدَدْ بها إلاَّ انتباها",23,"ا",3,0],["فلم أزلْ حتى سلك","تُ جيبَه والرُّدُنا",24,"ن",2,0],["فلم أزده على مسارقة ال","جفن ولحظٍ بالكره يُستلبُ",25,"ب",1,0],["فَلَم أَزَل لِكُلِّ نَجمٍ أَرصُدُ","حَتّى تَوَلّى لِلغُروبِ الفَرقضدُ",26,"د",1,0],["فَلَم أَزَل أَمسَحُ أَعطافَهُ","حَتّى إِذا اِستَفتَحَ في الضحِكِ",27,"ك",1,0],["فَلَم أَزَل أَقطِفُ زَهرَ الرِضا","مِن رَوضِها المَمطورِ بِالغُدرِ",28,"ر",1,0],["فَلَمّا زَجَرت العيس اسرت بِحاجَتي","إِلَيكَ وَذلت لِلسان القَصائِد",29,"د",1,0],["فَلَم أَزَلْ أَجعل خَدّي لهُ","تُرْباً لِرِجْلَيْهِ عَلى التُّربِ",30,"ب",1,0],["فَلَمْ أَزَلْ أَبْتغِيْهِ مُجْتَهِدَاً","فِي السَّهْلِ مِنْ أَرْضِهِ وَفِي الجَبَلِ",31,"ل",1,0],["فَلم أَزَل أَقترض حَتّى رُميت بِما","قَد كاد لولاك يُفضي بي إِلى العَطب",32,"ب",1,0],["فلم أزل أطردُه ويعكر","حتى إذا استيقنت ألا أعذرُ",33,"ر",1,0],["فلم أزل أشرب من","مدامه ولم يزل",34,"ل",1,0],["فلم أزل لوجودِ الجودِ أطلبه","فعلةُ الفقرِ فينا علة الزمنا",35,"ن",2,0],["فَلَم ازل اهصر فودا حالكا","ولم ازل ارشف ثغرا اشنبا",36,"ب",2,0],["فلم أزل أعمُر الأوقاتَ منه بما","يفوز من رَاحَ في تَحصِيلِهِ وغدا",37,"د",2,0],["فلم ازل بين تنكير ومعرفة","والقلب عن حسن ظني بات منقلبا",38,"ب",2,0],["فلم أزل أرشف خمر اللمى","وأحتسي بالثغر كأس العسل",39,"ل",1,0],["فلم أزل أبكي وأبكي بها","هيهات يغني الدمع هيهاتا",40,"ت",2,0],["فلم أزل في ليلتي","مغتبطاً بالنَظَرِ",41,"ر",1,0],["فلم أزل والنفس في عقد وحل","حتى تولى الليل والصبح أطل",42,"ل",1,0],["فلم أزل ليلتي أراجعه","لحظي وأبكي للوقت من قصره",43,"ر",2,0],["فلم أزل أَكْدح الأيامَ ملتمِساً","كَنْفاً ألوذ بِهِ إِن عوزَّ إمكان",44,"ن",1,0],["فلم أزل حائراً إذ جل مرتبة","وأختشي الله من قولي هو الله",45,"ه",1,0],["فلما زففناها وحلّت بداره","تجافى وأبدى الذمّ وانتُهِكَ السّتر",46,"ر",1,0],["فَلَم أَزَل بِالنَوى أُسَمِّنُهُ","وَالتِبنِ وَالقَتُّ وَالأَثاجيرِ",47,"ر",1,0],["فَلَم أَزَل أَرتَجي بَعد الفراق لقاً","مِن كافلٍ يَجمَع النائين لَم يَزَل",48,"ل",1,0],["فلم أزل أخدعُها ليلتي","خديعةَ الساحرِ للساحرَه",49,"ر",2,0],["فَلَم أَزَل زَلَّت بِهِ نَعلُهُ","أَلعَبُ بِالشَطرَنجِ في قَصعَتِه",50,"ه",1,0],["فلما زرته من أرض مصرٍ","مددت عليه من كفيك نيلا",51,"ل",2,0],["فلما زحَفنْا بالصفوفِ فأقبلوا","إلينا فَقُلنْا اليومَ ما حُمَّ واقعُ",52,"ع",1,0],["فلم أزلْ أنظرهم ومُقلتي","إنسانها، يغرق ثم يعتلي!",53,"ل",2,0],["فلم أزال وأنا أسعى لأَحُصَر مِن","سماتها الغر حتى كدت أنحصر",54,"ر",1,0],["فلم أزل أشرب من ريقها","مالا يدانى طيبه الخمر",55,"ر",1,0],["فَلَمْ أزلْ فِي اهْتيَاجِ الريحِ مُوقنَةً","بأنَّهُ يقصِدُ الآفاقَ مُقتَرِبَا",56,"ب",2,0],["فلم أزل أجتلى ليلي محاسنها","وأجتنيها فقل في الزهر والزهر",57,"ر",1,0],["فلما زهونا بها عِفَّةً","تردَّتْ بنا في سَحيق التَّباب",58,"ب",1,0],["فَلَمْ أَزْدَدْ سِوَى عَزْمٍ وَخَاضَتْ","حُرُوبِي مُهْجَةٌ تَرْعَى الذِّمَامَا",59,"م",2,0],["فلم أزلْ مبتغيهِ مجتهداً","في السّهلِ من أرضه وفي الجَبَلِ",60,"ل",1,0]]}