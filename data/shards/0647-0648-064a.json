tps://www.aldiwan.net/poem2835.html","المتقارب"],[573,"بحقك حدث عن هواي ولا حرج","https://www.aldiwan.net/poem2976.html","الطويل"],[573,"يا ويح نفس عشقت","https://www.aldiwan.net/poem2982.html","مجزوء الرجز"],[573,"أجل مناه قبلة من حبيبه","https://www.aldiwan.net/poem3098.html","الطويل"],[584,"هويت من ريقته قرقف","https://www.aldiwan.net/poem17443.html","السريع"]],"verses":[["هَوى بَينَ مُقتَصِّ إِثرِ الغَزا","لِ وَلّى وَمُنتَصِّ جيدِ الغَزالِ",0,"ل",1,0],["هُوَ يَأسٌ مُكَذِّبٌ","وَرَجاءٌ مُصَدِّقُ",1,"ق",1,0],["هَوىً لي أَطَعتُ بِهِ العاذِلينَ","وَما طاعَةُ العَذلِ إِلّا أَذى",2,"ذ",2,0],["هَوىً لَكُما إِنَّ الشَبابَ يُعادُ","وَإِنَّ بَياضَ العارِضينَ سَوادُ",3,"د",1,1],["هَوى قَمَرُ الأَنامِ وَكانَ أَوفى","عَلى قَمَرِ التَمامِ عُلىً وَزادا",4,"د",2,0],["هَوى بَدرُ التَمامِ وَكُلُّ بَدرٍ","سَتَقذِفُهُ إِلى الأَرضِ السَماءُ",5,"ا",2,0],["هَوىً دونَهُ مِن عامِرٍ ذو حَفيظَةٍ","يَصولُ فَتُروَى بِالنَّجيعِ نُصولُ",6,"ل",1,0],["هَوىً حالَ صَرْفُ الدّهْرِ بيني وبَيْنَهُ","أقُدُّ لهُ الأنْفاسَ وهْيَ دَوامِ",7,"م",1,0],["هَوىً أُعطيتُهُ لَمّا اِستَدارَت","رَحى الإِسلامِ لَم يَعدِل سَويّا",8,"ي",2,0],["هَوى رُكنُ الحَديثِ فَأَيُّ قُطبٍ","لِطُلّابِ الحَقيقَةِ وَالصَوابِ",9,"ب",1,0],["هَوينا فَما هُنّا كَما هانَ غَيرُنا","وَلَكِنَّنا زِدنا مَعَ الحُبِّ سُؤدُدا",10,"د",2,0],["هوى بين أيدينا وقد ودت المنى","لو أن لفضل ساعداً فهو ناشله",11,"ل",2,0],["هَوَى أَبَى دَارَ التَّنَاهِي لَهُ","دَاراً فَرَقَّاهُ إِلَى خُلْدِهِ",12,"د",2,0],["هُوَ يَوْمٌ أَغَرُّ مُبْتَسِمٌ","عَنْ وُجُوهٍ بِالبِشْرِ غُرَّانِ",13,"ن",1,1],["هَوًى وَشَائِجُهُ فِيهَا مُقَدْسَةٌ","وَقَدْ أَقَامَتْ عَلَيْهِ كُلِّ بُرْهَانِ",14,"ن",1,0],["هَوَى العَلَمُ الفَرْدُ الَّذِي كَانَ بَعْدَهُمْ","عَزَاءً لأَرْبَابِ النُّهَى وَالعَزَائِمِ",15,"م",1,0],["هَوِيْتُكَ إِكْبَاراً لِمَا رَمْزُهُ","مِنَ المَأْرَبِ العُلْوِيِّ لَوْ كَانَ يُفْهَمُ",16,"م",1,0],["هَوىً كادَتِ العَينانِ يَفرُطُ مِنهُما","لَهُ سَنَنٌ مِثلُ الجُمانِ المُنَظَّمِ",17,"م",1,0],["هَوىً لَكِ ما يَنفَكُّ يَدعوكِ ما دَعا","حَماماً بِأَجزاعِ العَقيقِ حَمامُ",18,"م",1,0],["هَوىً تَذرِفُ العَينانِ مِنهُ وإنَّما","هَوى كُلِّ نَفسٍ حَيثُ كَانَ حَبيبُها",19,"ب",3,0],["هَوى آلِف جاءَ الفِراقُ فَلَم تُجِل","جَوائِلها أَسرارُهُ وَمَعاتِبُه",20,"ب",2,0],["هوى القمر الوضاح من أفق العلا","فأظلم جوُّ النّيِّرات بساريها",21,"ي",3,0],["هو يُدعى بالمستشار ولكن","هو في الحكم آمرٌ قهّار",22,"ر",1,0],["هَوىً بِتَهامَةٍ وَهَوىً بِنَجدٍ","فَبَلَّتني التَهائِمُ وَالنُجودُ",23,"د",1,0],["هَوِيَّ غُدافٍ هَيَّجَتهُ جَنوبُهُ","حَثيثٍ إِلى أَذراءِ طَلحٍ وَتَنضُبِ",24,"ب",1,0],["هوى شارح لي حديث الغرام","فلا تسال القلب عن شرحه",25,"ح",2,0],["هوىً مطمعٌ إنسان عيني وإنما","تقطَّع أعناق الرّجال المطامع",26,"ع",1,0],["هوى كشأ الرأي الفلاني أنسباً","قنا ابن أبي الهيجاء في قلب فيلق",27,"ق",1,0],["هويت من طلعته روضة","ففاضت العين بغدران",28,"ن",1,0],["هويت من الآثار آثار عمرها","ومن بيت فضل الله عليّه",29,"ي",2,0],["هُوِيَّةٌ لَكَ في لائِيَّتي أَبَداً","كُلّي عَلى الكُلِّ تَلبيسُ بِوَجهَينِ",30,"ن",1,0],["هوىً أبادي به لا مُضمِراً لهوى","موكَىً عليه حذار الناس مَرموز",31,"ز",1,0],["هَويتُك ناشئاً قبَل التلاقي","هوىً حدثاً تكهَّلَ باكتهالي",32,"ي",1,0],["هوى كالجوى ألهاك عن كلّ لذةٍ","وعن كل مكروهٍ من الأمر نازلِ",33,"ل",1,0],["هوى هائلَ المَهْوَى يجُودُ بنفسه","تخالُ به قيداً تقوَّضَ مِنْ إضَمْ",34,"م",1,0],["هوىً غَوِيٌّ وشيطان له خُدعٌ","مُضَلِّلاتٌ وكيدٌ غيرُ مأمون",35,"ن",1,0],["هَوى أُمِّ بِشرٍ أَن تَراني بِغَبطَةٍ","وَتَهوى نُمَيرٌ غَيرَ ذاكَ وَأَكلُبُ",36,"ب",1,1],["هَوى مِثلَما يَهوي إِلى الأَرضِ كَوكَبٌ","كَذاكَ اللَيالي بِالأَنامِ تَدولُ",37,"ل",1,0],["هَوىً بِكَ في العِذامِ لَه دَبيبٌ","أَشابَكَ وَهوَ لَم يَبرَح غُلاما",38,"م",2,0],["هَوىً وَصَبابَةٌ وَقِلىً وَهَجرٌ","حَبيبي بَعضُ هَذا كانَ يُغني",39,"ن",2,0],["هَوى الكَوكَبانِ الفَتحُ ثُمَّ شَقيقُهُ","يَزيدُ فَهَل بَعدَ الكَواكِب مِن صَبرِ",40,"ر",1,0],["هَوى بِكُما المِقدارُ عَنّي وَلَم أَمُت","وَأدعى وَفيّا قَد نَكَصتُ إِلى الغَدرِ",40,"ر",1,0],["هويت والنفس لا تسلو ضغائنها","فضعت بين الهوى والحقد بالرشد",41,"د",1,0],["هوى الاجناب اعماها وضللها","سيان سافلها فيه وعاليها",42,"ي",3,0],["هو يعشق اللفظ الرقي","ق وإن جرحت به أباه",43,"ا",2,0],["هَوى عَن أَوجِ رِفعَتِهِ رِياضٌ","وَحازَتهُ القُرونُ الخالِياتُ",44,"ت",1,0],["هَوى فيكَ السَريرُ وَمَن عَلَيهِ","وَماتَ الثائِرونَ وَأَنتَ باقِ",45,"ق",1,0],["هوىً ليس يُسلي القربُ عنه ولا النَّوى","وشجوٌ قديمٌ ليس يُشبِهُهُ شجوُ",46,"و",1,0],["هوىً مثلُ سِرِّ الزَّندِ أفشاه قدحُهُ","وما كان لولا قَدْحةُ الزندِ يلمعُ",47,"ع",1,0],["هوىً ليس يُسْلِي القربُ عنه ولا النَّوَى","ولا هو في الحالينِ يصفُو ويَخْلُصُ",48,"ص",1,0],["هوىً لا يُديلُ القربُ منه ولا النَّوى","ولا هوَ عن طولِ التقادُمِ دارسُ",49,"س",1,0],["هَوىً لا جَميلٌ في بُثَينَةَ نالَهُ","بِمِثلٍ وَلا عَمرُ بنُ عَجلانَ في هِندِ",50,"د",1,0],["هَوىً أُعَفّي عَلى آثارِهِ بِهَوىً","كَمُطفِئٍ مِن لَهيبِ النارِ بِالنارِ",51,"ر",1,0],["هُوَ يَومٌ وَفيهِ مِن كُلِّ شَهرٍ","خُلُقٌ فَهُوَ جامِعٌ لِلشُهورِ",52,"ر",1,0],["هَوىً عَذُبَت مِنهُ مَوارِدُ بَدئِهِ","فَلَمّا نَمَت أَعيَت عَلَيهِ مَصادِرُه",53,"ه",1,0],["هَوىً كانَ غَضّاً بَينَنا مُتَقَدِّماً","كَما صابَ وَسمِيُّ الغَمامِ فَبَكَّرا",54,"ر",2,0],["هَوَيناكَ مِن لَومٍ عَلى حُبِّ تُكتَما","وَقَصرَكَ نَستَخبِر رُبوعاً وَأَرسُما",55,"م",2,1],["هَوىً عَلى الهونِ أُعطيهِ وَأَعهَدُني","مِن قَبلِ حُبّيكَ لا أُعطي عَلى الهونِ",56,"ن",1,0],["هَوى الخَطَفى لَمّا اِختَطَفتُ دِماغَهُ","كَما اِختَطَفَ البازي الخَشاشَ المُقارِعُ",57,"ع",1,0],["هويتها شمطاء قد جاوزت","في العد تسعين إلى تسع",58,"ع",1,0],["هَويِتُها والفِراقُ يَهواها","فحالَ بيني وبينَ لُقيَاها",59,"ا",3,1],["هوىً دَرَسَتْ أعلامُه فكأنما","تَرامَتْ به أيدي الرِّياحِ الرَّوامِسِ",60,"س",1,0],["هو يَومي من اللَّذاذَةِ يُجلي","فِعلَ يومِ الكَريهةِ المَرهوبِ",61,"ب",1,0],["هَوى النَفسِ في الدُنيا إِلى أَن تَغولَها","كَما غالَتِ الدُنيا أَباها وَجَدَّها",62,"د",3,0],["هَوىً إِلى نَحوِكُم يُجاذِبُهُ","وَهوَ الَّذي في البِلادِ أَقصاهُ",63,"ا",2,0],["هَويتُ طيبَ الثَنا فَلا بَرِحَت","تُحدى إِلى نَحوِكُم مَطاياهُ",63,"ا",2,0],["هَوَيتُهُ مُخالِفا","إِن سِمتُهُ الوَصلَ جَفا",64,"ف",2,1],["هَوَيتُهُ تَحتَ أَطمارٍ مُشَعَّثَةٍ","وَطالِبُ الدُرِّ لا يَغتَرُّ بِالصَدَفِ",65,"ف",1,1],["هَوىً يَقتادُني لِدِيارِ بَكرٍ","وَآخَرُ نَحوَ أَرضِ الجامِعَينِ",66,"ن",1,0],["هوىً كالسحر صيّرني","أرى بقريحة الشهبِ",67,"ب",1,0],["هَوىً كانَ خِلساً إِنَّ مِن أَحسَنِ الهَوى","هَوىً جُلتَ في أَفنائِهِ وَهوَ خامِلُ",68,"ل",1,0],["هَوَىً لَيْسَ فِيهِ لِلْمَلامَةِ مَسْلَكٌ","وَلا لاِمْرِئٍ نَاجَى بِهِ النَّفْسَ مَأْثَمُ",69,"م",1,0],["هَوَىً كَانَ لِي أَنْ أَلْبَسَ الْمَجْدَ مُعْلَمَا","فَلَمَّا مَلَكْتُ السَّبْقَ عِفْتُ التَّقَدُّمَا",70,"م",2,1],["هويتُها عرجاءَ أمسى بها","دمي منَ العينينِ مسفوكا",71,"ك",2,1],["هويتُ عمياءَ فيها","منافعُ للجليسِ",72,"س",1,1],["هويتُ أعرابيةً ريقُها","عذْبٌ ولي فيها عذابٌ مذابْ",73,"ب",1,1],["هويْتُ حصاداً حكَتْ قامتي","مِنْ طولِ ما يهجرُني مِنْجلهْ",74,"ه",1,1],["هويْتُ طباخاً إذا","عُوتبَ ممنْ عشقا",75,"ق",2,1],["هَويتُكِ وَاِستَحلَتكِ نَفسي فَأَقبِلي","وَلا تَجعَلي تَقريبَنا مِنكُمُ بُعدا",76,"د",2,0],["هَويتَ فَتاةً نَيلُها الخُلدُ فَاِلتَمِس","سَبيلاً إِلى ما لَستَ يَوماً بِواجِدِ",77,"د",1,0],["هَويتَ فَتاةً كَالغَزالَةِ وَجهُها","وَكَالشَمسِ يَسبي دَلُّها كُلَّ عابِدِ",77,"د",1,0],["هو يا فلسطينُ النِّضالُ وهل نجا","من حَتْفِه وَطَنٌ بغيرِ نِضالِ",78,"ل",1,0],["هَوَى الأمينُ على أشلاءِ رفقتِه","في جوفِ أشدقَ للأبطالِ فَرّاسِ",79,"س",1,0],["هَوَى الوطنُ الجريحُ وكنتَ قِدماً","تضُمُّ جوانبَ الجُرحِ الرَّغيبِ",80,"ب",1,0],["هَوَى جَبَلٌ من العُدوانِ عالٍ","وزُلزِلَ للأَذَى صَرحٌ مَشيدُ",81,"د",1,0],["هَوىَ العرشُ الذي استعصمتِ منه","بِرُكنِ الدَّهرِ واسْتعليتِ حينا",82,"ن",2,0],["هَوَى القمرانِ من فَزَعٍ وألقى","حِمَى المِرِّيخِ بالمُستضعَفينا",83,"ن",2,0],["هَوَى صَرحُ الدُّهورِ فذاب فيه","كما ذابتْ جُهودُ المُبتَنِينا",83,"ن",2,0],["هَوَى الإسلامُ بينكما صريعاً","وطاحَ بَنوهُ حولكما عِزينا",83,"ن",2,0],["هَوىً ما شَفَتْ لَيْلَى تباريحَ دائِه","ولا ساعَفَتْ أسبابُهُ والذّرائعُ",84,"ع",1,0],["هَوىً كَالدَهرِ لَيسَ لَهُ اِنقِضاءٌ","وَكَالقَدرِ المُرَوِّعِ حينَ يَجري",85,"ر",2,0],["هو يا ابن حربٍ ما عَلِمتَ وجَرَّبوا","الغِيلُ بَسْلٌ واللّيوثُ غِضَابُ",86,"ب",1,0],["هَوَى البطلُ المُغامِرُ واضمحلَّت","قُواه وخارتِ الهِم