خُفَّا","https://www.poetsgate.com/ViewPoem.aspx?id=201759",""],[5956,"معزوفة حب","https://www.poetsgate.com/ViewPoem.aspx?id=182082",""],[5956,"أشِعَّتُها تناجيني","https://www.poetsgate.com/ViewPoem.aspx?id=182678",""],[5956,"أنا وشعري","https://www.poetsgate.com/ViewPoem.aspx?id=185596",""],[5970,"ميز الأقوام في الدهر الهمم","https://www.poetsgate.com/ViewPoem.aspx?id=130661",""],[5973,"أشعل من حوليَ أقمارَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=13769",""],[6024,"عارض الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=186345",""],[6045,"أملٌ ممتنع !","https://www.poetsgate.com/ViewPoem.aspx?id=125350",""],[6045,"نبضة ألم ،، وومضة أمل","https://www.poetsgate.com/ViewPoem.aspx?id=176833",""],[6048,"في لون عينيك لاح الصبح والشفقُ","https://www.poetsgate.com/ViewPoem.aspx?id=197799",""],[6093,"تبرج صوت","https://www.poetsgate.com/ViewPoem.aspx?id=206314",""],[6102,"سُحقًا لِقَلبكِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=184412",""],[549,"الفارس والصهيل المكسر","https://www.poetsgate.com/ViewPoem.aspx?id=203001",""],[6124,"ثورة الأمعاء","https://www.poetsgate.com/ViewPoem.aspx?id=174663",""],[6124,"الفارس الذي لا يأتي","https://www.poetsgate.com/ViewPoem.aspx?id=201237",""],[6124,"أشعارنا","https://www.poetsgate.com/ViewPoem.aspx?id=201257",""],[6131,"عَينايَ زرقاءُ اليَمامةْ","https://www.poetsgate.com/ViewPoem.aspx?id=189287",""],[6162,"مَا لمْ تَقلهُ المرَايْا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69309&r=&rc=2",""],[6164,"الثمانون؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66038&r=&rc=48",""],[6187,"آخر أنفاس الحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82157&r=&rc=0",""],[6198,"مناديل الشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79294&r=&rc=68",""],[6239,"من ذاكرة الصقيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75978&r=&rc=29",""],[6257,"صعلكة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87176&r=&rc=1",""],[6262,"لغةٌ أخرى لمرايا البحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80107&r=&rc=5",""],[6266,"الحب والسور العالي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82752&r=&rc=0",""],[6328,"ليته جاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82087&r=&rc=6",""]],"verses":[["أَشعَلتَ فَحمَةَ الدَياجي فَباتَت","تَملَأُ الأَرضَ وَالسَماءَ شَرارا",0,"ر",2,0],["أشعر الخلق كان هومير هل أد","رك منه كل المنى هومير",1,"ر",1,0],["أَشَعَرْتَ وَالنَّسَمَاتُ سَاكِنَةٌ بِمَا","لِقُلُوبِهِمْ فِي الجَوِّ مِنْ خَفَقَانِ",2,"ن",1,0],["اشعل النار يا مقابل","فالكيوس من خمران أحمر",3,"ر",1,0],["أشعرتُ قلبي ُبَّهُنَّ صبابةٌ","فَرَمَيْنَني من لوعتي بجمارِ",4,"ر",1,0],["أشعَثُ ذو لِمَّةٍ تخطّأه ال","الدُهن غَنياً وَمَا له نَشَبُ",5,"ب",1,0],["أشعث ذو لمة تخطأه الده","ر غنيا وما له نشب",6,"ب",1,0],["أشعت حبِّيَ في القاصي وفي الدَّاني","وفي عذوليَ قد أطلقت فدَّاني",7,"ن",2,1],["أَشعَلتَ في كَبِدي نارَينِ واحِدَةً","بِينَ الضُلوعِ وَأُخرى بَينَ أَحشائي",8,"ا",3,0],["أشِعْرِي سَفسافٌ فَلِمْ يَجْتبونه","وإن لا تكن هاتي فَلِمْ لا أُثوَّبُ",9,"ب",1,0],["أشِعْ عنهم خزاياهم","وسمِّعْ كل تسميع",10,"ع",1,0],["أشْعرتُه من قَذعي مُرْمضاً","صار به الحائنُ طِلَّسْمِي",11,"م",2,0],["أشعرتُه خوفاً يصوِّرني له","صوراً ممثلةً بكل مكان",12,"ن",1,0],["أَشعَرِيُّ حَباهُ عيسى اِبنُ موسى","شَرَفاً باتَ لِلسِماكِ رَسيلا",13,"ل",2,0],["أُشَعشِعُه لأُطِربَ سامعيه","كما شَعشَعْتُ بالماءِ العُقارا",14,"ر",2,0],["أشعلت فيها النار تر","عى في عزيز حطامها",15,"م",3,0],["أَشعَلتُمُ الحَربَ مِلءَ الأَرضِ ظالِمَةً","فَوضى المَذاهِبِ حَمقى ما لَها سَبَبُ",16,"ب",1,0],["أَشعَرَ اللَهُ خالِقُ الأُمَمِ الشِع","رى الغُمَيصاءَ ذِلَّةً وَالعَبورا",17,"ر",2,0],["أُشعِرتَ هَمّاً فَزادَ النَومَ طارِقُهُ","كَأَنَّهُ بِسُهادٍ واصِبٍ كَحَّلَك",18,"ك",1,0],["أَشعل الدهر رأسه وأَشابَت","عدوات السنين منه القذالا",19,"ل",2,0],["أشعلتُمُوها ثورةً دمَوِيَّةً","لا تعرفونَ لنارِها إخمادَا",20,"د",2,0],["أشعةٌ ذات أمواج غدَوتَ بها","تطفو وترسب في لجيّها القاني",21,"ي",1,0],["أشِعَّةٌ من بَسماتِ المُنى","ومن رجاءٍ كالصَّباح المبينْ",22,"ن",1,0],["أشْعِريها بَديلَ كُرّتِها المِسْ","كَ إذا م