{"poems":[[63,"رغم الأراذل إذ ورثنا سؤددا","https://www.aldiwan.net/poem46082.html","الكامل"],[63,"ثنى عطفه للبارق المتأجج","https://www.aldiwan.net/poem46140.html","الطويل"],[100,"وراء الرياح","https://www.aldiwan.net/poem23704.html","عموديه"],[77,"سيدي أنت عمدتي فاحتملني","https://www.aldiwan.net/poem36788.html","الخفيف"],[77,"وسواس حليك أم هم الرقباء","https://www.aldiwan.net/poem36791.html","الكامل"],[86,"ما بال دندرة تميس تهاديا","https://www.aldiwan.net/poem68897.html","الكامل"],[0,"قفا نبك من ذكرى حبيب ومنزِل","https://www.aldiwan.net/poem50.html","الطويل"],[30,"أدارا بحزوى هجت للعين عبرة","https://www.aldiwan.net/poem29554.html","الطويل"],[30,"أمن دمنة جرت بها ذيلها الصبا","https://www.aldiwan.net/poem29607.html","الطويل"],[88,"نحن من أرضنا على منطاد","https://www.aldiwan.net/poem45072.html","الخفيف"],[27,"لقد نادى أميرك بابتكار","https://www.aldiwan.net/poem5777.html","الوافر"],[27,"يا تيم ما القارون في شدة القرى","https://www.aldiwan.net/poem5937.html","الطويل"],[27,"ألم يك لا أبا لك شتم تيم","https://www.aldiwan.net/poem6008.html","الوافر"],[72,"خلقت على مرادي واقتراحي","https://www.aldiwan.net/poem18479.html","الوافر"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[51,"إن هتك الثياب في دهرنا","https://www.aldiwan.net/poem64954.html","الخفيف"],[51,"أنا راع لما صفا منك قدما","https://www.aldiwan.net/poem65699.html","الخفيف"],[51,"أيها الحاسدي على صحبتي العسر","https://www.aldiwan.net/poem66408.html","الخفيف"],[91,"وتينة غضة الأفنان باسقة","https://www.aldiwan.net/poem8825.html","عموديه"],[70,"وعد الزيارة طرفه المتملق","https://www.aldiwan.net/poem42802.html","الكامل"],[89,"متع السمع والبصر","https://www.aldiwan.net/poem44843.html","مجزوء الخفيف"],[85,"من ظن بعدك أن يقول رثاء","https://www.aldiwan.net/poem62941.html","الكامل"],[43,"إن يكن صبر ذي الرزية فضلا","https://www.aldiwan.net/poem9978.html","الخفيف"],[45,"هويناك من لوم على حب تكتما","https://www.aldiwan.net/poem65682.html","الطويل"],[28,"تغنى جرير بن المراغة ظالماً","https://www.aldiwan.net/poem1271.html",""],[2,"لمن الديار غشيتها بالفدفد","https://www.aldiwan.net/poem25034.html","الكامل"],[49,"يا نفس قد مثلت حالى","https://www.aldiwan.net/poem65343.html","مجزوء الكامل"],[66,"نلت من ودك الجميل انتصافي","https://www.aldiwan.net/poem40336.html","الخفيف"],[74,"وتيقن أن الله أكرم جيرة","https://www.aldiwan.net/poem13224.html","الطويل"],[105,"نبئت ما صنع الذين تألفوا","https://www.aldiwan.net/poem43090.html","الكامل"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[52,"لست تنجو من كل ما حدت عنه","https://www.aldiwan.net/poem26595.html","الخفيف"],[48,"نادم العز الكراما","https://www.aldiwan.net/poem66609.html","مجزوء الرمل"],[46,"أودى فليت الحادثات كفاف","https://www.aldiwan.net/poem23630.html","الكامل"],[8,"خليلي عوجا ساعة وتهجرا","https://www.aldiwan.net/poem21785.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42508","الطويل"],[106,"هل عاد قيس؟","https://www.poetsgate.com/ViewPoem.aspx?id=179386",""],[77,"سيدي أنت عمدتي فاحتَملْني","https://www.poetsgate.com/ViewPoem.aspx?id=33312",""]],"verses":[["وَتَيَقَّنوا أَنّي إذا اشْتَجَرَ القَنا","خَشِنٌ وَعِطْفِي في السَّماحَةِ لَيِّنُ",0,"ن",1,0],["وتيهٌ عُقَيْليٌّ كأنّ دِلاصَهُ","يُزَرُّ على ذي لِبْدَتَيْنِ مُهَيّجٍ",1,"ج",1,0],["وتيه وراء ضياع الضياع","وخلف الدجى ، ووراء الرياح",2,"ح",1,0],["وَتُيُوسٍ مِنْ أَرْضِ أَنْدَلُسٍ قَدْ","قَصَدُوا عَنْ ضَرُورَةٍ وَجَلاَءِ",3,"ا",2,0],["وَتَيَقَّنُوا الغُفْرَانَ فِي زَلاَّتِهِمْ","مِمَّنْ لَدَيْهِ الْخَلْقُ وَالإنْشَاءُ",4,"ا",2,0],["وَتَيَمَّني بِقُدومِهِ وَتَرَفَّقي","عِندَ الزِحامِ فَسَلِّمي وَتَفَرَّقي",5,"ق",2,0],["وَتَيماءَ لَم يَترُك بِها جِذعَ نَخلَةٍ","وَلا أُطُماً إِلّا مَشيداً بِجَندَلِ",6,"ل",1,0],["وَتَيهاءَتُودي بَينَ أَرجائِها الصَبا","عَلَيها مِنَ الظَلماءِ جُلٌّ وَخَندَقُ",7,"ق",1,0],["وَتيهٍ خَبَطنا غَولَها فَارتَمى بِنا","أَبو البُعدِ مِن أَرجائِها المُتَطاوِحُ",8,"ح",1,0],["وتئنّ المياه لي بخرير","كأنين السقيم للعُوّاد",9,"د",1,0],["وَتَيمٌ يَفخَرونَ وَضَربُ تَيمٍ","كَضَربِ الزَيفِ بارَ عَلى التِجارِ",10,"ر",1,0],["وَتَيمٌ تُماشيها الكِلابُ إِذا غَدَوا","وَلَم تَمشِ تَيمٌ في ظِلالِ الخَوافِقِ",11,"ق",1,0],["وَتَيمٌ بِأَبوابِ الزُروبِ أَذِلَّةٌ","وَما تَهتَدي تَيمٌ لِبابِ السُرادِقِ",11,"ق",1,0],["وَتَيمٌ لا تُقيمُ بِدارِ ثَغرٍ","وَتَيمٌ لا تُحَكَّمُ في الحُكومِ",12,"م",1,0],["وتيّاه سمحت له بدمع","يرى أن السماح من الرباح",13,"ح",1,0],["وتيقَّنْ متى جنيتَ على عب","دك ضَيْماً وضَيعة وعَناءَ",14,"ا",2,0],["وتيقَّنْ أن ليس يُرْفَدُ مالاً","بل رجالاً يُضْحون آداً لآدِهْ",15,"د",2,0],["وتيقَّن أن القوافيَ أضحتْ","بالذي قد فعلتَ غيرُ رواضي",16,"ي",1,0],["وتيقَّن بأنَّني غير راءٍ","لك حقّاً حتى ترى لي حقوقا",17,"ق",2,0],["وتيقَّنْ أني مُقيمٌ على العه","دِ حَياتي وخُذْ بذاكَ ضمانا",18,"ن",2,0],["وَتينَةٍ غَضَّةِ الأَفنانِ باسِقَةٍ","قالَت لِأَترابِها وَالصَيفُ يَحتَضِرُ",19,"ر",1,1],["وَتَيَقَّنَ الأَقوامُ أَنِّيَ بَعدَها","أَبَداً إِلى رُتَبِ العُلى لا أَسبِقُ",20,"ق",1,0],["وتيقظ اذا هممت","وباشر على حذر",21,"ر",1,0],["وَتَيَتَّمَ الأَيتامُ أَوَّلَ مَرَّةٍ","وَرَمى الزَمانُ بِصَرفِهِ الفُقَراءَ",22,"ا",2,0],["وَتَيَقَّنتَ أَنَّ حَظَّكَ أَوفى","وَتَبَيَّنتَ أَنَّ جَدَّكَ أَعلى",23,"ل",2,0],["وَتَيَّمَني أَنَّ الجَوى غَيرُ مُقصِرٍ","وَأَنَّ الحِمى وَصفٌ لِمَن حَلَّ بِالحِمى",24,"م",2,0],["وَتَيمٌ مَكانَ النَجمِ لا يَستَطيعُها","إِذا زَخَرَت يَوماً إِلَيها رَبابِها",25,"ب",3,0],["وَتَيَمَّمَت عُرضَ الفَلاةِ كَأَنَّها","غَرّاءُ مِن قِطَعِ السَحابِ الأَقهَدِ",26,"د",1,0],["وَتَيَنّي أَنَّ الَّذي","بِكِ مِن عَلاماتِ المَنونِ",27,"ن",1,0],["وَتَيَقَّنتُ مُذ أَذِنتَ لِكُتبي","أَن تُوافي بِأَنَّ لي أَنتَ وافي",28,"ي",1,0],["وتَيَقَّنَ أَنَّ اللَهَ أَكرَمُ جيرَةٍ","فَأَزمَعَ عَن دارِ الحَياةِ رَحيلا",29,"ل",2,1],["وَتَيَمَّنوا بِالطَيرِ سَعداً وَاِحذَروا","لِلنَحسِ طَيراً دائِمَ التَنعابِ",30,"ب",1,0],["وَتَيَقُّنُ الخَبَرِ المُرَجْ","جَمِ ذي المُشاكَلَةِ المُشاكِل",31,"ل",1,0],["وَتَيَقَّظ إِذا اِضطُرِرتَ إِلى وَص","لِ عَدُوٍّ وَدُم عَلى الخَوفِ مِنهُ",32,"ه",1,0],["وتيقّن أنّ عفو ال","لَهِ لاقٍ ذا الأناما",33,"م",2,0],["وتيَقّنَتْ أبطالُها ممّا رأتْ","أن لا تُقَوّمها بغَمْزٍ ثِقافِ",34,"ف",1,0],["وَتِيهٍ عَلَيها نَسجُ رِيحٍ مَرِيضَةٍ","قَطَعتُ بحُرجُوجٍ مُسانَدَةِ القَرا",35,"ر",2,0],["وَتَيَّمْنَني حَتَّى إِذا ما تَرَكْنَنِي","أَخَا سَقَمٍ أَسْلَمْنَنِي لِلنَّوائِبِ",36,"ب",1,0],["وتئِنُّ من فَرْط الهُيَا","م وتشتكي طولَ السهر",37,"ر",1,0],["وتيوسٍ من أهل أندلُسٍ قد","قصدوا عن ضرورة ِ وجلاءَ",38,"ا",2,0]]}