قفرات","https://www.aldiwan.net/poem48026.html","مجزوء الكامل"],[552,"يا مليك الورى ومن عقد الله","https://www.aldiwan.net/poem48114.html","الطويل"],[559,"أشكر الله خالقي في البريه","https://www.aldiwan.net/poem33560.html","الخفيف"],[559,"ما له عندك كنه","https://www.aldiwan.net/poem33685.html","مجزوء الرمل"],[559,"كن لمن يدعي الصلاح محبا","https://www.aldiwan.net/poem34451.html","الخفيف"],[559,"أنت في بالك خاطر","https://www.aldiwan.net/poem34552.html","مجزوء الرمل"],[560,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"]],"verses":[["وَتَيَقَّنوا أَنّي إذا اشْتَجَرَ القَنا","خَشِنٌ وَعِطْفِي في السَّماحَةِ لَيِّنُ",0,"ن",1,0],["وتيهٌ عُقَيْليٌّ كأنّ دِلاصَهُ","يُزَرُّ على ذي لِبْدَتَيْنِ مُهَيّجٍ",1,"ج",1,0],["وتيه وراء ضياع الضياع","وخلف الدجى ، ووراء الرياح",2,"ح",1,0],["وَتُيُوسٍ مِنْ أَرْضِ أَنْدَلُسٍ قَدْ","قَصَدُوا عَنْ ضَرُورَةٍ وَجَلاَءِ",3,"ا",2,0],["وَتَيَقَّنُوا الغُفْرَانَ فِي زَلاَّتِهِمْ","مِمَّنْ لَدَيْهِ الْخَلْقُ وَالإنْشَاءُ",4,"ا",2,0],["وَتَيَمَّني بِقُدومِهِ وَتَرَفَّقي","عِندَ الزِحامِ فَسَلِّمي وَتَفَرَّقي",5,"ق",2,0],["وَتَيماءَ لَم يَترُك بِها جِذعَ نَخلَةٍ","وَلا أُطُماً إِلّا مَشيداً بِجَندَلِ",6,"ل",1,0],["وَتَيهاءَتُودي بَينَ أَرجائِها الصَبا","عَلَيها مِنَ الظَلماءِ جُلٌّ وَخَندَقُ",7,"ق",1,0],["وَتيهٍ خَبَطنا غَولَها فَارتَمى بِنا","أَبو البُعدِ مِن أَرجائِها المُتَطاوِحُ",8,"ح",1,0],["وتئنّ المياه لي بخرير","كأنين السقيم للعُوّاد",9,"د",1,0],["وَتَيمٌ يَفخَرونَ وَضَربُ تَيمٍ","كَضَربِ الزَيفِ بارَ عَلى التِجارِ",10,"ر",1,0],["وَتَيمٌ تُماشيها الكِلابُ إِذا غَدَوا","وَلَم تَمشِ تَيمٌ في ظِلالِ الخَوافِقِ",11,"ق",1,0],["وَتَيمٌ بِأَبوابِ الزُروبِ أَذِلَّةٌ","وَما تَهتَدي تَيمٌ لِبابِ السُرادِقِ",11,"ق",1,0],["وَتَيمٌ لا تُقيمُ بِدارِ ثَغرٍ","وَتَيمٌ لا تُحَكَّمُ في الحُكومِ",12,"م",1,0],["وتيّاه سمحت له بدمع","يرى أن السماح من الرباح",13,"ح",1,0],["وتيقَّنْ متى جنيتَ على عب","دك ضَيْماً وضَيعة وعَناءَ",14,"ا",2,0],["وتيقَّنْ أن ليس يُرْفَدُ مالاً","بل رجالاً يُضْحون آداً لآدِهْ",15,"د",2,0],["وتيقَّن أن القوافيَ أضحتْ","بالذي قد فعلتَ غيرُ رواضي",16,"ض",2,0],["وتيقَّن بأنَّني غير راءٍ","لك حقّاً حتى ترى لي حقوقا",17,"ق",2,0],["وتيقَّنْ أني مُقيمٌ على العه","دِ حَياتي وخُذْ بذاكَ ضمانا",18,"ن",2,0],["وَتينَةٍ غَضَّةِ الأَفنانِ باسِقَةٍ","قالَت لِأَترابِها وَالصَيفُ يَحتَضِرُ",19,"ر",1,1],["وَتَيَقَّنَ الأَقوامُ أَنِّيَ بَعدَها","أَبَداً إِلى رُتَبِ العُلى لا أَسبِقُ",20,"ق",1,0],["وتيقظ اذا هممت","وباشر على حذر",21,"ر",1,0],["وَتَيَتَّمَ الأَيتامُ أَوَّلَ مَرَّةٍ","وَرَمى الزَمانُ بِصَرفِهِ الفُقَراءَ",22,"ا",2,0],["وَتَيَقَّنتَ أَنَّ حَظَّكَ أَوفى","وَتَبَيَّنتَ أَنَّ جَدَّكَ أَعلى",23,"ل",2,0],["وَتَيَّمَني أَنَّ الجَوى غَيرُ مُقصِرٍ","وَأَنَّ الحِمى وَصفٌ لِمَن حَلَّ بِالحِمى",24,"م",2,0],["وَتَيمٌ مَكانَ النَجمِ لا يَستَطيعُها","إِذا زَخَرَت يَوماً إِلَيها رَبابِها",25,"ب",3,0],["وَتَيَمَّمَت عُرضَ الفَلاةِ كَأَنَّها","غَرّاءُ مِن قِطَعِ السَحابِ الأَقهَدِ",26,"د",1,0],["وَتَيَنّي أَنَّ الَّذي","بِكِ مِن عَلاماتِ المَنونِ",27,"ن",1,0],["وَتَيَقَّنتُ مُذ أَذِنتَ لِكُتبي","أَن تُوافي بِأَنَّ لي أَنتَ وافي",28,"ف",2,0],["وتَيَقَّنَ أَنَّ اللَهَ أَكرَمُ جيرَةٍ","فَأَزمَعَ عَن دارِ الحَياةِ رَحيلا",29,"ل",2,1],["وَتَيَمَّنوا بِالطَيرِ سَعداً وَاِحذَروا","لِلنَحسِ طَيراً دائِمَ التَنعابِ",30,"ب",1,0],["وَتَيَقُّنُ الخَبَرِ المُرَجْ","جَمِ ذي المُشاكَلَةِ المُشاكِل",31,"ل",1,0],["وَتَيَقَّظ إِذا اِضطُرِرتَ إِلى وَص","لِ عَدُوٍّ وَدُم عَلى الخَوفِ مِنهُ",32,"ه",1,0],["وتيقّن أنّ عفو ال","لَهِ لاقٍ ذا الأناما",33,"م",2,0],["وتيَقّنَتْ أبطالُها ممّا رأتْ","أن لا تُقَوّمها بغَمْزٍ ثِقافِ",34,"ف",1,0],["وَتِيهٍ عَلَيها نَسجُ رِيحٍ مَرِيضَةٍ","قَطَعتُ بحُرجُوجٍ مُسانَدَةِ القَرا",35,"ر",2,0],["وَتَيَّمْنَني حَتَّى إِذا ما تَرَكْنَنِي","أَخَا سَقَمٍ أَسْلَمْنَنِي لِلنَّوائِبِ",36,"ب",1,0],["وتئِنُّ من فَرْط الهُيَا","م وتشتكي طولَ السهر",37,"ر",1,0],["وتيوسٍ من أهل أندلُسٍ قد","قصدوا عن ضرورة ِ وجلاءَ",38,"ا",2,0],["وتينٍ كما قامت على حَلَماتها","نهودُ عَذارى الزّنج فَوقَ صدور",39,"ر",1,0],["وتيمن قلبي واستثرنَ مدامعى","وحق البكا إن كان لِلحِبِّ مدنيا",40,"ي",2,0],["وَتَيمٍ وَمَخزومٍ وَزهرَةٍ مِنهُمُ","وَكانوا بِنا أَولى إِذا بُغيَ النَصرُ",41,"ر",1,0],["وتيهٌ كأَنْ ليس بدرُ السماء","يُلمُّ الكسوفُ به والغُروبُ",42,"ب",1,0],["وتيقنت أن الفناء يعمّها","بيديك إن لم تنصرف بسلام",43,"م",1,0],["وَتَيَقَّني أَنَّ الشَبابَ لِنارِهِ","حَدٌّ وَيُطفِئُها المَشيبُ فَتَبرُدُ",44,"د",1,0],["وَتَيَقَّن أَنَّ المُسَيطِرَ لا يُق","صَدُ إِلّا في مَهمَهٍ أَو فَلاةِ",45,"ه",1,0],["وَتَيْسِيرُ كَسْبٍ لِلْحَلاَلِ الذِي يَفِي","بِمَا تَقْتَضِي مِنَّا الضَّرُورَةُ وَالْحَالُ",46,"ل",1,0],["وتَيقَّظ للَّهو مذ نام طَرفُ الد","دهر وارتَع في غفلة الأيامِ",47,"م",1,0],["وَتيممه سائِلا تغن جودا","دونك الزاخر العَريض الطَويلا",48,"ل",2,0],["وَتَيسير الامور عليك دونى","ففرج هم عسرى باليَسار",49,"ر",1,0],["وَتَيقّنوا أنّ الّذي غلَب الهوى","وَالنفس يغلبُ كلّ ذي سلطانِ",50,"ن",1,0],["وَتيهٍ مَرَوَراة يَحارُ بِها القَطا","إِلى فَجِّ مَخشِيِّ المَهالِكِ ذي غَمضِ",51,"ض",1,0],["وتَيسٍ عجيبِ الشَّكلِ يأكلُ بِاسْتِه","ويَبعَرُ مِن فيهِ ويَحسَبُه شِعْرا",52,"ر",2,1],["وتَيمّنَ السّلطانُ منه بصاحبٍ","نَدْبٍ يَهُمُّ بما يَرومُ فَيظْفَر",53,"ر",1,0],["وَتَيَقَّظَت لَكَ في السِياسَةِ عَزمَةٌ","تَدَعُ الحُسامَ وَجَفنُه وَسنانُ",54,"ن",1,0],["وتيّاكَ السُوَيعة لي رُجَيٌّ","بُكَيرٌ بل طُهَيرٌ في البُكَير",55,"ر",1,0],["وتيقظوا وتعلموا ثم اعملوا","لا تغفلوا لا تغفلوا لا تغفلوا",56,"ل",3,0],["وَتيهاء لَم تَطمَث بِخفٍّ وَحافِرٍ","وَلم يَدرِ فيها النَجمُ كَيفَ يَغورُ",57,"ر",1,1],["وتَيَّمها صبا نجدٍ غراماً","فما فَعَلَتْ بها سَلْعٌ ونجد",58,"د",1,0],["وتيّهتُموني في بديع جمالِكُم","ولم أدر في مجر الهوى أينَ موضعي",59,"ع",2,0],["وتيقّنَتْ رُتبَ المفاخرِ أنها","خفضت وقد رفعوه في أعوادِه",60,"د",2,0],["وتَيَمَّمُوكَ من المُصَلَّى فانثَنَوْا","ساعِينَ بَيْنَ مُكَبِّرٍ ومُهَلِّلِ",61,"ل",1,0],["وتَيَقَّنَ الإِسلامُ عَوْدَةَ رَحْمَةٍ","تُبْرِي من الأَوْصابِ والأَسْقامِ",62,"م",1,0],["وتيرة انكورية ثم برسة","ومملكة السلطان فهي تهاب",63,"ب",1,0],["وتيقَّنتُ أنّ لي ناصراً يد","فع دوني في صدرِ كلِّ مُلِمَّهْ",64,"م",2,0],["وتيقّنتْ بالثُّكلِ بيضُهمُ فلو","قدرَتْ لما سمَحَتْ لهم ببَنينِ",65,"ن",1,0],["وتيقنت رتب الوزارة أنها","كانت ممهدة له من مهده",66,"د",2,0],["وتيقني أن قد وقعت بموقف","أدنى مراتبه العلى وتحققي",67,"ق",2,0],["وتيقنت رتب الخلافة أنها","سعدت بطلعة وجهك المتهلل",68,"ل",1,0],["وتيقنوا بحميد سعيك أنهم","ولدوا معماً في المعالي مخولا",69,"ل",2,0],["وتيقنت أهل البسيطة أنه","بوجود جودك يعدم الإعدام",70,"م",1,0],["وتيقنت نوب الليالي أنني","لا أتقي الأيام في أيامه",71,"م",2,0],["وَتيقُّني أنْ ليس جِدّي نافعي","إنْ لم يكن جَدّي هنالك ناصري",72,"ر",2,0],["وَتَيقَّنوا أَنّ الحَيا","ةَ مع المذلّةِ كالمماتِ",73,"ت",1,0],["وَتَيقَّنْ أَنّ الصّيام الّذي ما","زِلتَ فيه تُجانِبُ الأَهواءا",74,"ا",3,0],["وتيقنت أنه هو لا ما","كنت أدري وزالت الغيريه",75,"ي",2,0],["وتيقظ أيها الغا","فل فِقْ أنت لدنه",76,"ن",2,0],["وتيقن أن الصلاح بحار","زاخرات والله ما شاء كاسي",77,"س",2,0],["وتيقن أن سري","حارس فيك وناظر",78,"ر",1,0],["وتِّيم الباب الهرامِس كلِّهم","وحسْبُك من سقْراط أسكَنُه الدِّنَّا",79,"ن",2,0]]}