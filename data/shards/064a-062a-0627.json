{"poems":[[79,"أبدى لداعي الفوز وجه منيب","https://www.aldiwan.net/poem36767.html","الكامل"],[4,"طرب الفؤاد وليته لم يطرب","https://www.aldiwan.net/poem21150.html","الكامل"],[53,"وذكرك في الشعر مثل السناد","https://www.aldiwan.net/poem65900.html","المتقارب"],[53,"ومعتذر من نعمة قد أفادها","https://www.aldiwan.net/poem65998.html","الطويل"],[93,"راودني النوم وما برحا حتى طأطأت له راسي","https://www.aldiwan.net/poem8971.html","عموديه"],[87,"الله أعطى عهد مصر محمدا","https://www.aldiwan.net/poem6823.html","الكامل"],[87,"خطت يداك الروضة الغناء","https://www.aldiwan.net/poem8094.html","الكامل"],[87,"جبريل أنت هدى السماء","https://www.aldiwan.net/poem63729.html","مجزوء الكامل"],[47,"لي حبيب قد لج في الهجر جدا","https://www.aldiwan.net/poem63498.html","الخفيف"],[47,"إن الأمير أبا علي أصبحت","https://www.aldiwan.net/poem65628.html","الكامل"],[47,"ما تقضى لبانة عند لبنى","https://www.aldiwan.net/poem66658.html","الخفيف"],[30,"سقى أريحاء الغيث وهي بغيضة","https://www.aldiwan.net/poem5502.html","الطويل"],[101,"غرناطة","https://www.aldiwan.net/poem6258.html","عموديه"],[107,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[54,"إن الفراق دعا الخليط فزالا","https://www.aldiwan.net/poem26731.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43727","المتقارب"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54285","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/206203","الكامل"],[47,"إِنَّ ألأَميرَ أَبا عَليٍّ أَصْبحَت","https://www.poetsgate.com/ViewPoem.aspx?id=32112",""],[47,"لي حَبيبٌ قَدْ لَجّ في الهَجْرِ جِدّا","https://www.poetsgate.com/ViewPoem.aspx?id=31601",""],[190,"شره الإنسان يقتله","https://www.aldiwan.net/poem43435.html","المديد"],[234,"أصبح الملك من أبي المنصور","https://www.aldiwan.net/poem51113.html","الخفيف"],[327,"آذن اليوم جيرتي بارتحال","https://www.aldiwan.net/poem56350.html","الخفيف"],[382,"طوبى لمن قد تاب بعد خطائهِ","https://www.aldiwan.net/poem66970.html","الكامل"],[412,"ألم بمضجعي بعد الكلال","https://www.aldiwan.net/poem50138.html","الوافر"],[428,"مرثية رجل عظيم","https://www.aldiwan.net/poem24295.html","عموديه"],[445,"عمرت بطول بقائك الأعمار","https://www.aldiwan.net/poem34878.html","الكامل"],[463,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[466,"شكرا لدهري بالضمير وبالفم","https://www.aldiwan.net/poem15142.html","الكامل"],[466,"يهب الطلاقة والنوال معا","https://www.aldiwan.net/poem16419.html","أحذ الكامل"],[473,"أيها التيس الذي ما","https://www.aldiwan.net/poem59560.html","مجزوء الرمل"],[549,"المتنبي .. كون في ملامح كائن","https://www.aldiwan.net/poem67242.html","عموديه"],[556,"ألا يا ابنة الحيين ما لي وما لك","https://www.aldiwan.net/poem47344.html","الطويل"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2447","المتقارب"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122739","الطويل"],[1409,"","https://poetry.dctabudhabi.ae/diwan/poem/130250","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49913","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79996","البسيط"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87818","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69390","الكامل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104695","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48222","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205851","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202572","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204648","الرجز"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67973","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62879","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108345",""],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86531","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86521","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111505","الرجز"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105265","المتقارب"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83154","الكامل"],[4878,"مصابك فيه ركن الدين هدا","https://www.poetsgate.com/ViewPoem.aspx?id=170951",""],[4935,"بنيت بأسعد الأوقات داراً","https://www.poetsgate.com/ViewPoem.aspx?id=129481",""],[4959,"أَهْلَاً بِكَ يَا شَهْرَ الصِّيَام","https://www.poetsgate.com/ViewPoem.aspx?id=211445",""],[5026,"بوابة تطل على الأمنيات","https://www.poetsgate.com/ViewPoem.aspx?id=210777",""],[5121,"صَبَاحُ الْهَمْسِ","https://www.poetsgate.com/ViewPoem.aspx?id=214145",""],[5145,"عهد الصبى أين ذاك المشرع الصافي","https://www.poetsgate.com/ViewPoem.aspx?id=108252",""],[5431,"محض لوطي...","https://www.poetsgate.com/ViewPoem.aspx?id=213340",""],[327,"آذَنَ اليومَ جِيرتي بارتحالِ","https://www.poetsgate.com/ViewPoem.aspx?id=3928",""],[5512,"خلف السواتر ..قمحانة","https://www.poetsgate.com/ViewPoem.aspx?id=204501",""],[5616,"حلب","https://www.poetsgate.com/ViewPoem.aspx?id=203437",""],[5628,"الكهوف","https://www.poetsgate.com/ViewPoem.aspx?id=178799",""],[5643,"أصبح الملك واهي الأرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=181292",""],[5691,"خطب مكدسة","https://www.poetsgate.com/ViewPoem.aspx?id=206132",""],[5732,"اللي هتف باسماه قلبي وناداه","https://www.poetsgate.com/ViewPoem.aspx?id=177868",""],[5851,"قبس في منتصف الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=175274",""],[5853,"هو شاعرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=175677",""],[5859,"رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=29416",""],[5923,"سَأَم الجراح","https://www.poetsgate.com/ViewPoem.aspx?id=162750",""],[5997,"حديثُ الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=214298",""],[6170,"لا تمسوهنّ بحُزن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86035&r=&rc=6",""],[6205,"تميمة لنوم حبيبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88155&r=&rc=7",""],[6213,"أرض ونجوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76296&r=&rc=44",""],[6311,"نغم المساء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63488&r=&rc=7",""],[6316,"في رثاء الشيخ بن باز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65165&r=&rc=0",""]],"verses":[["يَتَأَوَّدُ الأَسَلُ الْمُثّقَّفُ فَوْقَهَا","وَتُجِيبُ صَاهِلَةٌ رُغَاءَ نَجِيبِ",0,"ب",1,0],["يَتَأَكَّلونَ مَغالَةً وَخِيانَةً","وَيُعابُ قائِلُهُم وَإِن لَم يَشغَبِ",1,"ب",1,0],["يُتاحُ الهجاءُ لهاجي الهِجا","ء داءٌ عُضال لداءٍ عُضالِ",2,"ل",1,0],["يُتابعُ في أغراضه صوبَ نبله","إذا كان بعضُ الصوبِ فلتَةَ نابلِ",3,"ل",1,0],["يَتَأَفَّفُ مِن بُطءِ الدَهرِ","وَالدَهرُ يَسيرُ بِهِ وَثَبا",4,"ب",2,0],["يتألقان الدهر هذا بالعلى","حالٍ وهذا بالفضيلة والهدى",5,"د",2,0],["يَتَأَلَّفانِ عَلى الهُتافِ كَما اِنبَرى","وَتَرٌ يُسايِرُ في البَنانِ غِناءَ",6,"ا",2,0],["يَتَأَلَّقانِ عَلى الوَغى","رَشَداً تَبَيَّنَ مِن غِوايَه",7,"ا",3,0],["يَتَأَبّى مَنعاً وَيُنعِمُ إِسعا","فاً وَيَدنو وَصلاً وَيَبعُدُ صَدّا",8,"د",2,0],["يَتَأَمَّلُ الأَقوامُ إِذ حَدَقوا بِهِ","نِصفَينِ رَيُّهُما يَرَونَ الأَطوَلا",9,"ل",2,0],["يَتَأَنّى بُغى التَعَجُلِ وَالأَع","جَلُ في بَعضِ شَأنِهِ مَن تَأَنّى",10,"ن",2,0],["يَتامى عَلى آثارِ سودٍ كَأَنَّها","رِئالٌ دَعاها لِلمَبيتِ نَعامُها",11,"م",3,0],["يتألق القرط الطويل بجيده","مثل الشموع بليلة الميلاد..",12,"د",1,0],["يتَألّفون على الهَوى وقلوبُهم","شَتَّى يَظلُّ شَعاعُها يتزيّلُ",13,"ل",1,0],["يَتَآكَلونَ ضَغينَةً وَخِيانَةً","وَيَرَونَ لَحمَ الغافِلينَ حَلالا",14,"ل",2,0],["يتاخمُ النّجمَ في علاهُ","ويَنثني جاثياً لديها",15,"ه",2,0],["يُتاحُ لِمَن حَظِيَ الحَتفُ مِنه","وَلَيسَ بِنافِعِهِ أَن حَظا",16,"ظ",2,0],["يَتَأَبَّى السَّيْلُ الَّذِي يَصْدَعُ الأَجْبَالَ","أَنْ يَحْتَوِيهِ جَوْفُ إِنَاءِ",17,"ا",2,0],["يتألق القرط الطويل بجيدها","مثل الشموع بليلة الميلاد",18,"د",1,0],["يَتَأَمَّلُ الأَقوامُ إِذْ حَدَقوا بهِ","نِصْفَيْنِ أَيُّهُمَا يَرَوْنَ الأَطْوَلاَ",19,"ل",2,0],["يَتَأبّى مُنْعماً، ويُنْعِمُ إسْعَا","فاً، ويَدْنُو وَصْلاً