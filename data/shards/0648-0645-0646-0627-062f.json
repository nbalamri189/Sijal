{"poems":[[110,"سطا حُسناً","https://www.shoaraa.com/p13815",""],[74,"حلفت بليل الشعر منه إذا سجى","https://www.aldiwan.net/poem18453.html","الطويل"],[87,"أجل وإن طال الزمان موافي","https://www.aldiwan.net/poem62840.html","الكامل"],[47,"إن الكؤوس بها يطيب المجلس","https://www.aldiwan.net/poem64614.html","الكامل"],[77,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39592","الهزج"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42585","الكامل"],[147,"ليهنك ما أنالتك الجدود","https://www.aldiwan.net/poem11748.html","الوافر"],[147,"أرى الشرف الأعلى إليك مسلما","https://www.aldiwan.net/poem11811.html","الطويل"],[164,"الفسح يطلب منكم الكرماني","https://www.aldiwan.net/poem59188.html","الكامل"],[240,"يا من رعيت له الوداد تمسكا","https://www.aldiwan.net/poem32021.html","الكامل"],[354,"مدار الحق حق الحق","https://www.aldiwan.net/poem15740.html","الهزج"],[358,"يا سرورا على القلوب تجلى","https://www.aldiwan.net/poem39588.html","الخفيف"],[369,"أطاعك مني القلب العصي","https://www.aldiwan.net/poem60562.html","الوافر"],[543,"اسال من الأجفان عن صدره نهرا","https://www.aldiwan.net/poem48140.html","عموديه"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86768","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53871","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56163","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79978","الكامل"],[1753,"","https://poetry.dctabudhabi.ae/diwan/poem/105846","الكامل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104790","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53059","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27906","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130781",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205894","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128901","الطويل"],[3989,"","https://poetry.dctabudhabi.ae/diwan/poem/145993","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90741","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90807","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54478","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94348","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94750","الكامل"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123460","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120516","السريع"],[4755,"ولَقَد رَأَيتُ.. لَقَد رَأَيتُ مُحَالا","https://www.poetsgate.com/ViewPoem.aspx?id=184349",""],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[5338,"عرش الإمامة جنب حوض الكوثر","https://www.poetsgate.com/ViewPoem.aspx?id=190172",""],[5616,"عكاكيز","https://www.poetsgate.com/ViewPoem.aspx?id=203455",""],[5670,"يَا مَلاذِي !","https://www.poetsgate.com/ViewPoem.aspx?id=211204",""],[5873,"أحلى الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=215305",""],[6205,"أشواق الخوابي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88156&r=&rc=8",""]],"verses":[["ومن أدلى بزمزم بعد غورٍ","فأجرى السحب من يده قرابا",0,"ب",2,0],["ومن أدمعِي بالمرسلاتِ من الأسى","ومن أضلعي بالموريات من الشجى",1,"ج",2,0],["وَمُنادِمُ الأَملاكِ تَحتَ قِبابِهِم","أَمسى تُنادِمُهُ ذِئابُ فَيافي",2,"ف",2,0],["وَمُنادِمينَ كَأَنَّهُم سُرُجُ الدُجى","أَيمانُهُم بِنَوالِهِم تَتَبَجَّسُ",3,"س",1,0],["ومن أدرَعٍ قد قُنِّعَ الليلَ حالكاً","على أنّه قد سُرْبلَ الصبحَ مُسفِرا",4,"ر",2,0],["ومَن آدمُكِ المحبوبُ","أو ما صورةُ الصَّبِّ",5,"ب",1,0],["وَمُنَادِمٍ غَرِدِ الْحَدِيثِ كَأَنَّمَا","أَلْفَاظُهُ فِي السَّمْعِ نَغْمَةُ عُودِ",6,"د",1,1],["وَمِن أُدَدٍ وَعَدنانٍ عَلَيها","جُنودٌ لا تُلاقيها جُنودُ",7,"د",1,0],["وَمَن أَدرَكَ العَلياءَ وَالعَجزُ خُلقُهُ","وَقالَ كَفاني الحَظُّ أَن أَتَهَمَّما",8,"م",2,0],["ومن ادعى منهم له حبا فما","هو غير حب الهر للفيران",9,"ن",1,0],["وَمَنِ اِدَّرَعتُ الصَبرَ عَنهُ فَأَرسَلَت","عَيناهُ سَهماً في المَقاتِلِ نافِذا",10,"ذ",2,0],["وَمَن أَدرَكَ ذا السِرِّ","عَلى عَن عالَمِ الحِسِّ",11,"س",1,0],["وَمنادي الهَنا لِناديهِ نادى","مَرحَباً مَرحَباً وَأَهلاً وَسَهلا",12,"ل",2,0],["ومَن أَدْنى مَناقِبه سَناءٌ","ومَن أَدنَى مَواهبِه سَنيّ",13,"ي",1,0],["ومِن أدمُعِ الباكي الغَزِيرَةِ ما به","تُخَفَّفُ أحزانٌ قد أقلَقَتِ الصَّدرا",14,"ر",2,0],["وَمَن أَدركته الأوجيان بخفة","قَضى نَحبه في مصدر وَورود",15,"د",1,0],["ومَنِ ادّعى الحبَّ الصحيحَ فإنّه","أبداً يُرى لحبيبه زَوّارَا",16,"ر",2,0],["ومنادمات معاشر الإباء اف","كه كلما قد لذّ في الدنياءِ",17,"ا",2,0],["ومَن ادَّعى للعين ليسَ سوى","إنسانها ابنٌ تشهدُ المقلُ",18,"ل",1,0],["ومنادمٍ لم أرضَ من أشري","فندمتُ اذ اصبحتُ غيرَ شريبه",19,"ه",1,1],["ومُنادِياً أَنِّى لِحَاقُكَ وَالَّذِى","بَينى وَبَينَكَ كالسَّمَا وَثَرَاها",20,"ا",3,0],["ومن أدار يواقيت الشفاه على","كأس من الدرّ يحوي خمر ريقته",21,"ت",2,0],["ومن ادَّعى أنَّ الإله جليه","بالذكر فهو لديهم المبخوت",22,"ت",1,0],["وَمَنِ ادَّعَى شَيئاً سِوَى ذَا كَانَ دَع","وَاهُ مُكَابَرَةً عَلَى الأذهَانِ",23,"ن",1,0],["ومنادٍ لديه ينشد شعراً","يجلب البشر قال وهو طروب",24,"ب",1,0],["ومنادٍ بما يبيع وحيدٌ","خالَسَ الرفقة النيام وبكَّرْ",25,"ر",1,0],["ومن أدوات صامتات نواطق","اذا نطقت لا تمزج الجد باللعب",26,"ب",1,0],["ومن آدمٍ حتى القيامة","ليس من نداءِ ندىً إلا وأنت المناسبُ",27,"ب",1,0],["ومنادي الهنا ينادي هلموا","للوفايا ذوي الصفا والحبور",28,"ر",1,0],["ومنادي البسط ناداها وفي","وحي سلك البرق وافاها البشير",29,"ر",1,0],["ومنادي المُنى مُجاوبُهُ الاس","عافُ والسؤولُ للنّجاحِ منادمْ",30,"م",1,0],["ومن ادَّعى فيما يحلِقُ فهمهُ","بالعرف فيهِ فاتهُ العرفانُ",31,"ن",1,1],["ومن ادّعي أمراً ويجهلُ فهمهُ","دعهُ وسلم أمرهُ للمنصفِ",32,"ف",1,0],["ومُنادمٍ يمحو اللياليَ أَنسُه","حتى كأنَّ ظلامَها لم يوجَد",33,"د",1,0],["ومن اديب ماهر لفظه","لصدف الافهام كالدر",34,"ر",1,0],["ومَنِ ادَّعَى الحَقَّ الإلهيَّ الذي","مَلَأَ البلادَ تَمَرُّدًا وقِتالا",35,"ل",2,0],["ومن آدم توب من الحوب بعده","إنابة دآود وأوب سليمان",36,"ن",1,0],["وَمُنَادِيًا بِالنَّارِ وَهْيَ مُطِيعَةٌ","وَبِغَيْرِ طَاعَةِ حَيْدَرٍ لَمْ تُؤْمَرِ",37,"ر",1,0],["ومن أداروا لنا ظهراً وما أكلوا","خبز الشعير ولا خبز \"الطراميز\"",38,"ز",1,0],["ومنادي الإيمان يملأ قلبي","شغفًا يا لَطيبِ ذاك المنادي!",39,"د",2,0],["ومن إدمان عشقك لست أنوي","أيا حِبّي حياتي أن أتوبا",40,"ب",2,0],["ومن أدبِ الرسالة أن تُعاني","ليبعثك الجمالُ بها نبيّا",41,"ي",2,0]]}