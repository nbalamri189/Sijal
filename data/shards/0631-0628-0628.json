{"poems":[[55,"اسقني فاليوم نشوان","https://www.aldiwan.net/poem29667.html","المديد"],[55,"لو على قدر ما يحاول قلبي","https://www.aldiwan.net/poem30765.html","الخفيف"],[88,"أين يوم القنال يا ربة التاج","https://www.aldiwan.net/poem10696.html","الخفيف"],[74,"رب بكر في طريق جليت","https://www.aldiwan.net/poem19395.html","الرمل"],[53,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[93,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[91,"أحمد كان مثل بحر رحيب","https://www.aldiwan.net/poem44619.html","الخفيف"],[87,"روعوه فتولى مغضبا","https://www.aldiwan.net/poem7519.html","الرمل"],[87,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[51,"رب باك للموت يبكى عليه","https://www.aldiwan.net/poem63193.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85446","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85671","الرمل"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/20251","الخفيف"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43692","المديد"],[108,"شعر الماحي","https://www.poetsgate.com/ViewPoem.aspx?id=179364",""],[108,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[141,"رب بيت كأنه متن سهم","https://www.aldiwan.net/poem68030.html","الخفيف"],[214,"رب بدر بات يجلو ليلة","https://www.aldiwan.net/poem13444.html","الرمل"],[255,"أبروق يلوح منها وميض","https://www.aldiwan.net/poem14988.html","الخفيف"],[285,"كم سما لي بحسن رأيك جد","https://www.aldiwan.net/poem60696.html","البسيط"],[325,"لا تقل همت في ضياء الغزال","https://www.aldiwan.net/poem67214.html","الخفيف"],[369,"أسعداني في الحب ما تعلمان","https://www.aldiwan.net/poem60609.html","الخفيف"],[371,"وقف الطيف بجفن كالطلل","https://www.aldiwan.net/poem17080.html","الرمل"],[382,"من ذا رأى الدهر طفلا فوق منبره","https://www.aldiwan.net/poem59145.html","البسيط"],[409,"هل ينال القلب ما طلبا","https://www.aldiwan.net/poem34147.html","المديد"],[505,"كيف لا أندب الطلول غراما","https://www.aldiwan.net/poem37782.html","الخفيف"],[534,"لم يكون النوح ياور","https://www.aldiwan.net/poem37401.html","مجزوء الرمل"],[567,"أجمل الله في فؤادك صبرا","https://www.aldiwan.net/poem52990.html","الخفيف"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2415","الخفيف"],[619,"","https://poetry.dctabudhabi.ae/diwan/poem/203371","زجل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101478","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87198","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38977","الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38978","الرجز"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99971","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59198","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59127","الخفيف"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126132","الرجز"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136179","الرمل"],[1396,"","https://poetry.dctabudhabi.ae/diwan/poem/204682","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95553","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95571","الخفيف"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113991","الخفيف"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101048","الخفيف"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132304","الرجز"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87846","الخفيف"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74991","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53124","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77438","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77305","الرمل"],[2365,"","https://poetry.dctabudhabi.ae/diwan/poem/34713","الخفيف"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126199","الرجز"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132345","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93806","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93790","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93778","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94049","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93897","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58341","الرمل"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100495","الخفيف"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100501","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202996","الرجز"],[3008,"","https://poetry.dctabudhabi.ae/diwan/poem/103173","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74311","الخفيف"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123906","الخفيف"],[3550,"","https://poetry.dctabudhabi.ae/diwan/poem/206260","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110064","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114587","الرمل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133259","الرمل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/136025","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135957","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135945","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135901","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135845","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135757","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135737","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135297","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135277","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135918","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135898","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135846","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135838","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135738","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135919","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135915","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135791","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/136084","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135952","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135944","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135868","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135740","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135728","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77182","الخفيف"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35443","الكامل"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119508","الخفيف"],[1536,"ضَحِكَ الدَّهْرُ بعد طُول عُبُوسِ","https://www.poetsgate.com/ViewPoem.aspx?id=85705",""],[5136,"ريحاننا لا إله إلا الله","https://www.poetsgate.com/ViewPoem.aspx?id=121768",""],[5409,"حدثينا يا فرنسا","https://www.poetsgate.com/ViewPoem.aspx?id=155283",""]],"verses":[["رُبَّ بَدرٍ بِتُّ أَلثُمُهُ","صاحِياً وَالبَدرُ نَشوانُ",0,"ن",1,0],["رُبَّ بُؤسٍ غَدا عَلَيَّ بِنِعما","ءَ وَبُعدٍ أَفضى إِلَيَّ بِقُربِ",1,"ب",1,0],["رُبَّ بانٍ نَأى وَرُبَّ بِناءٍ","أَسلَمَتهُ إِلى غَيرِ باني",2,"ن",2,0],["رُبَّ بكرٍ في طريق جليت","ليَ بالشامِ أموراً لم ترق",3,"ق",1,1],["رُبَّ بيعٍ هناك قد أرخصُوهُ","طال ما قدْ غلا على السُّوَّام",4,"م",1,0],["رُبَّ بيتٍ هناك قد أخرجُوهُ","كان مأوى الضِّعافِ والأيتام",4,"م",1,0],["رُبَّ بُستانٍ قَضَيتُ العُمرَ أَحمي شَجَرَه","وَمَنعتُ الناسَ أَن تَقطِفَ مِنهُ زَهرَه",5,"ه",1,0],["رب بنت للشعر قد وأدوها","في ربيع الصبا على غير ذنب",6,"ب",1,0],["ربِّ بالهجرة بالداعي لها","بالذي هاجر ممن صحبا",7,"ب",2,0],["رُبَّ بانٍ لِهادِمٍ وَجَموعٍ","لِمُشِتٍّ وَمُحسِنٍ لِمُخِسِّ",8,"س",1,0],["رُبَّ باكٍ لِلمَوتِ يُبكى عَلَيهِ","قَد حَوى مالَهُ بِكِلتا يَدَيهِ",9,"ه",1,1],["ربَّ بيت سمعت فيه هتافاً","ثم إني سمعت فيه عويلا",10,"ل",2,0],["رب بيت هو إن أَح","سنت خير من قصيده",11,"ه",1,0],["رُبَّ بُؤسٍ يُخَبِّثُ النَفسَ حَتّى","يَطرَحُ المَرءَ في مَهاوي الضَلالِ",12,"ل",1,0],["رُبّ بَحْرٍ للحَرْبِ في ليلِ هَيْجا","ءَ أبَى مُقْمِراً فعُدّ ثَميرا",13,"ر",2,0],["رُبَّ بانٍ وَالحِمامُ لَهُ","في بِناءٍ رَصَّهُ رَصَدُ",14,"د",1,0],["رب بيت يُغْنِي الزمانَ، وبيت","من هشيم يَذْرُوه مرُّ الرياح",15,"ح",1,0],["ربَّ بُرجٍ قد صار منزلَ يومٍ","وعرينٍ قد بات مسكن سيد",16,"د",1,0],["رُبَّ بَيتٍ كَأَنَّهُ مَتنُ سَهمٍ","سَوفَ نَأتيهِ مِن قُرى بَيروتِ",17,"ت",1,1],["رب بدر بات يجلو ليلة","شمس راح من لماه معتصر",18,"ر",1,1],["رَبُّ بأس لنارِهِ أيُّ إضرا","مٍ وجودٍ على العُفاة يَفيضُ",19,"ض",1,0],["رُبَّ بِرٍّ فِي إِثْرِهِ مِنْكَ بِرٌّ","بَعْدَ رِفْدٍ فِي طَيِّهِ مِنْكَ رِفْدُ",20,"د",1,0],["رَبِّ بَلِّغهُ ما يُريدُ وَعَجِّل","إِنَّما البَرُّ خَيرُهُ في العَجالَه",21,"ل",2,0],["رُبَّ بَدْرٍ ملأتُ عَينيَّ منه","طالعاً غَيْرَ أَنّه ما هَداني",22,"ن",2,0],["رُبَّ بُستانِ حَديثٍ بَينَنا","فَتَّحَ العَتبُ بِهِ وَردَ الخَجَل",23,"ل",1,0],["ربٌّ بدا بين خلقٍ في ذَرا جسدٍ","من فوق منبر عفوٍ فاختفى السخط",24,"ط",1,0],["رب برق بالعقيق شرى","فجرى من مقلتي وشرى",25,"ر",2,0],["رَبِّ بلِّغْهُ من عُبَيْدِكَ دَهراً","كلَّ رَمْشٍ تحيَّةً وسَلاما",26,"م",2,0],["رَبِّ بَلّغْنِي إلَيْهِمْ","سالِماً مِمّا أحاذِرْ",27,"ر",1,0],["رُبَّ باكٍ لِضَربةٍ صادَفتَني","وَهْوَ قَد شَكَّ أَن تُفاجيهِ أُخرى",28,"ر",2,0],["رب بديع الأرض والسماء","فتابع الخائب للشقاء",29,"ا",2,0],["رُبَّ بيدٍ وَدونَها","ناضِبٌ أَو كَناضِبِ",30,"ب",1,0],["رب بقى حسنو ما أحلاه","ألا هو فيه فرد شي مر",31,"ر",1,0],["ربَّ بكرٍ على التقى قد تربَّت","بادّكار المعادِ تحيي الدجنَّه",32,"ن",2,1],["رب بالمُصطَفى نَبيك بَلِّغ","عَبدك الخاضعَ الذَليل مُناهُ",33,"ا",2,1],["رَبِّ بِسُكّانِ السّما","وَما لَديكَ عُظِّما",34,"م",2,0],["ربِّ بكلِّ الرُّسْلِ","وَالأَنبِياءِ الكلِّ",35,"ل",1,0],["رُبَّ بَذْلٍ سَقَيْتَنِي مِنْهُ كَأْساً","فَأَعِدْ مُدَارَ تِلكَ الْكُئُوسِ",36,"س",1,0],["رُبَّ بَدْر ضَمَمْتُ بَانَةَ قَدّهْ","وَغَزَال لَثَمْتُ وَرْدَةَ خَدّهْ",37,"د",2,1],["رُبَّ بَدْرٍ أضَاءَ فِي جُنْحِ","خَدّه المُذْهَبْ",38,"ب",1,0],["رب بليغ بيِّن المقال","أورده موارد العذال",39,"ل",1,0],["رب بلغنا بجاهه","في جواره خير مقعد",40,"د",1,0],["رب بابٍ أعز من بابك اليو","م عليه عساكرٌ وجنود",41,"د",1,0],["رب بيت أمضه الجود يوما","صار صرحا على رقاب العبادِ",42,"د",1,0],["رب بذل به تكّشف مجد","كان لولا السخاء جدّ دفين",43,"ن",1,0],["رَبِّ بَلِّغهُ واستَجِب يا إلهي","واكلإِ العُمرَ في غِنىً وأمانِ",44,"ن",1,0],["رب بين يرمي به غرض المج","د أخو العزم فوق أم النجوم",45,"م",1,0],["رب بهنانة هيفا أناة","تتثنّى رقراقة درماء",46,"ا",2,0],["رب بها رب به رب بهم","وقربهم بربنا من ربهم",47,"م",1,0],["رُبَّ باكٍ دُموعُهُ بَسماتٌ","صَدَّقوا ما اِفتَرى عَلَيهِ التَجَلُّد",48,"د",1,0],["رب بالمصطفى عذتك والآل أقل","عثرتي وكن لي دَليلا",49,"ل",2,0],["ربّ بيت كالبيت فيه لوفد الج","ود صبح وللتلاوات سحره",50,"ر",2,0],["رُبَّ بَيتٍ أَقامَت الخَمرُ فيهِ","أَجفَلَت عَن رُواقِهِ السَرّاءُ",51,"ا",2,0],["رَبِّ بارك في اللآلي إِنَّها","ثَروَتي في كُلِّ كَربٍ يبتَلي",52,"ل",2,0],["رُبَّ بَعلٍ زُفَّت إِلَيهِ مِنَ اللَي","لِ تَهادى فَوداً مَعَ الوَصفاءِ",53,"ا",2,0],["ربِّ بذا التأليفِ والمكتوبِ","فإغفر لهذا الكاتب المَعيُوبِ",54,"ب",1,1],["رَبِّ بسرِّكَ الذي إذا ظهر","في الشيء غاب غيرُهُ عن النَّظَر",55,"ر",1,1],["رب بلغه ما يريد وساعد","في الذي يبتغيه من آمال",56,"ل",1,0],["رب بيض بجاه جدي وجهي","يوم تحظى لديك غر الجباه",57,"ا",2,0],["رب بيضاء وحدت في التثني","قدها اللدن صعدة سمراء",58,"ا",2,0],["رب باب على علاه استدلوا","بأعاجيب صنع ما هو باني",59,"ن",2,0],["رب بكر عذارء إن زوجوها","بابن مزن تلد من الدر بضعه",60,"ع",2,0],["رُبَّ بَيضاءَ بَدَتْ في عارِضي","تَتَلألا كلآلٍ في سحاب",61,"ب",1,0],["رب بلغه ما يؤمله واف","تح له من لدنك فتحاً يسيرا",62,"ر",2,0],["رب بآدم الذي قد آنست","وحشته بنسله البيض الغرر",63,"ر",1,0],["رب بإبراهيم من قد رفع ال","بيت لمن حج إليه واعتمر",63,"ر",1,0],["رب بموسى من به من أمه","قد قرت العين ومنها العيش قر",63,"ر",1,0],["رب بنيات يمسن في الحبر","فوا