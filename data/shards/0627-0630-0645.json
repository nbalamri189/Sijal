{"poems":[[53,"عصينا فيك أحداث الليالي","https://www.aldiwan.net/poem29864.html","الوافر"],[53,"بغير شفيع نال عفو المقادر","https://www.aldiwan.net/poem30465.html","الطويل"],[53,"إلى كم الطرف بالبيداء معقود","https://www.aldiwan.net/poem30637.html","البسيط"],[53,"أثرها على ما بها من لغب","https://www.aldiwan.net/poem30743.html","المتقارب"],[77,"اذمم ذوي التطفيل مهما أتى","https://www.aldiwan.net/poem36056.html","السريع"],[86,"ورد الكنانة عبقري زمانه","https://www.aldiwan.net/poem68904.html","الكامل"],[88,"بغداد حسبك رقدة وسبات","https://www.aldiwan.net/poem45007.html","الكامل"],[51,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[51,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[51,"أبا منذر بالله إلا صدقتني","https://www.aldiwan.net/poem64004.html","الطويل"],[51,"شهر القيام وإن عظمت حرمته","https://www.aldiwan.net/poem65784.html","الوافر"],[16,"دافعت عنه بشعري","https://www.aldiwan.net/poem27692.html","الرجز"],[85,"يمينا بالطلاق وبالعتاق","https://www.aldiwan.net/poem6824.html","الوافر"],[85,"حكاية الكلب مع الحمامه","https://www.aldiwan.net/poem8012.html","الرجز"],[43,"أقل فعالي بله أكثره مجد","https://www.aldiwan.net/poem9542.html","الطويل"],[43,"فدا لك من يقصر عن مداكا","https://www.aldiwan.net/poem9756.html","الوافر"],[62,"أقول وقد غال الردى من أحبه","https://www.aldiwan.net/poem52429.html","الطويل"],[62,"أيا حادي الأظعان غرد فقد بدا","https://www.aldiwan.net/poem52444.html","الطويل"],[45,"يا أخا الأزد ما حفظت الإخاء","https://www.aldiwan.net/poem10196.html","الخفيف"],[45,"بمثل لقائها شفي الغليل","https://www.aldiwan.net/poem65600.html","الوافر"],[45,"هم ألى رائحون أم غادونا","https://www.aldiwan.net/poem66662.html","الخفيف"],[45,"أذم إليك تغليس الدجون","https://www.aldiwan.net/poem66667.html","الوافر"],[45,"يا نازحا قد نأى عن الوطن","https://www.aldiwan.net/poem66824.html","المنسرح"],[61,"لا يعرف العدل وهو معتدل","https://www.aldiwan.net/poem51483.html","السريع"],[61,"أذم إليك عادية الفراق","https://www.aldiwan.net/poem51504.html","الوافر"],[80,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[44,"ما لكثيب الحمى إلى عقده","https://www.aldiwan.net/poem30552.html","المنسرح"],[87,"وصالك لي هجر وهجرك لي وصل","https://www.aldiwan.net/poem8344.html","الطويل"],[90,"شممت تربك لا زلفى ولا ملقا","https://www.aldiwan.net/poem60156.html","عموديه"],[75,"أما والمذاكي يلكن الشكم","https://www.aldiwan.net/poem69039.html","المتقارب"],[50,"شهدت على الزيدي أن نساءه","https://www.aldiwan.net/poem62384.html","السريع"],[50,"عاد الغداة الصب عيد","https://www.aldiwan.net/poem63944.html","مجزوء الكامل"],[50,"قاس الهموم تنل بها نجحا","https://www.aldiwan.net/poem63980.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85473","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85647","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43832","البسيط"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/199046","البسيط"],[90,"أمين الريحاني","https://www.poetsgate.com/ViewPoem.aspx?id=178954",""],[45,"يا نازِحاً قَدْ نَأَى عَنِ الوَطَنِ","https://www.poetsgate.com/ViewPoem.aspx?id=31788",""],[16,"دافعتُ عَنهُ بِشِعريَ إذْ","https://www.poetsgate.com/ViewPoem.aspx?id=4909",""],[91,"حكاية حال","https://www.poetsgate.com/ViewPoem.aspx?id=53184",""],[94,"نغمات عودي","https://www.poetsgate.com/ViewPoem.aspx?id=15651",""],[51,"بكيتَ فلم تترك لعيْنِكَ مدمعاً","https://www.poetsgate.com/ViewPoem.aspx?id=29517",""],[88,"بغدادُ حسبكِ رقدة وسبات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19515&r=&rc=18",""],[109,"دار عليها وحشة وقتام","https://www.aldiwan.net/poem16508.html","الكامل"],[120,"حثا شرابهما في ظل حسان","https://www.aldiwan.net/poem49285.html","البسيط"],[120,"سل الخلصاء ما صنعوا بعهدي","https://www.aldiwan.net/poem49370.html","الوافر"],[142,"قد طال للماطل أن يقتضى","https://www.aldiwan.net/poem58443.html","السريع"],[155,"وغادة ترفل في الشباب","https://www.aldiwan.net/poem55794.html","الرجز"],[166,"بعدت وما حكم البعاد بعادل","https://www.aldiwan.net/poem46895.html","الطويل"],[185,"عتبت ولكنني لم أع","https://www.aldiwan.net/poem14581.html","المتقارب"],[185,"هل المجد إلا دون ما أنت رافع","https://www.aldiwan.net/poem14573.html","الطويل"],[186,"برمت بمن أراه وضاق صدري","https://www.aldiwan.net/poem43228.html","الوافر"],[186,"برمت بما أراه وضاق صدري","https://www.aldiwan.net/poem43869.html","الوافر"],[189,"لست أنسى زمنا قد سلفا","https://www.aldiwan.net/poem35098.html","الرمل"],[210,"أذم إلى الزمان أهيل سوء","https://www.aldiwan.net/poem13569.html","الوافر"],[235,"مرت بجمع ليلة النفر","https://www.aldiwan.net/poem31993.html","السريع"],[237,"ثغر السيادة قد تبسم","https://www.aldiwan.net/poem19070.html","الكامل"],[239,"لمقامك التعظيم والتبجيل","https://www.aldiwan.net/poem23840.html","الكامل"],[261,"لمن المهارى اليعملات القود","https://www.aldiwan.net/poem38338.html","الكامل"],[364,"إذا لم تقدرا أن تسعداني","https://www.aldiwan.net/poem60633.html","الوافر"],[364,"لها في حمى مني وراء الترائب","https://www.aldiwan.net/poem60994.html","الطويل"],[366,"لعينيه على العشاق إمره","https://www.aldiwan.net/poem17205.html","الوافر"],[377,"نفس غدت قد عصاك أسهلها","https://www.aldiwan.net/poem59283.html","المنسرح"],[393,"وحيت من فرط السرور","https://www.aldiwan.net/poem53534.html","مجزوء الكامل"],[402,"هيهات ذلك دين لا أفارقه","https://www.aldiwan.net/poem46952.html","البسيط"],[409,"نظام الدين كم فارقت خلا","https://www.aldiwan.net/poem32257.html","الوافر"],[416,"يا قبر محمود لا جازتك غادية","https://www.aldiwan.net/poem53903.html","البسيط"],[416,"عد عن من لج في قال وقيل","https://www.aldiwan.net/poem54131.html","الرمل"],[432,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[458,"طاف عليه بالرقمتينِ","https://www.aldiwan.net/poem55834.html","مخلع البسيط"],[458,"كم النحت في جنبي والحز في متني","https://www.aldiwan.net/poem55835.html","الطويل"],[458,"تمنى رجال أن تزل بي النعل","https://www.aldiwan.net/poem55997.html","الطويل"],[458,"من دل ربات العيون النجل","https://www.aldiwan.net/poem56067.html","الرجز"],[458,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[458,"أمرتكم أمري بنعمان ناصحا","https://www.aldiwan.net/poem56253.html","الطويل"],[464,"سرت بدر تم في سحاب من النقب","https://www.aldiwan.net/poem3292.html","عموديه"],[515,"سرى لك عرف في النسيم الذي سرى","https://www.aldiwan.net/poem12108.html","الطويل"],[515,"هي الصدمة الأولى فمن بان صبره","https://www.aldiwan.net/poem12130.html","الطويل"],[551,"إذا أنتم لم تشفعوا في قباحة","https://www.aldiwan.net/poem47152.html","الطويل"],[551,"إذا جئت أعلام العذيب فسلم","https://www.aldiwan.net/poem47211.html","الطويل"],[551,"أذم إليك كلما ليس يؤسى","https://www.aldiwan.net/poem48090.html","الوافر"],[558,"عدم يحيط به الوجود وإنما","https://www.aldiwan.net/poem34075.html","الكامل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"أودع منك الصدر والبدر والبحرا","https://www.aldiwan.net/poem2722.html","الطويل"],[575,"أذم شبابا لم أذق فيه لذة","https://www.aldiwan.net/poem2809.html","الطويل"],[575,"أذم زماناً حال بيني وبينه","https://www.aldiwan.net/poem3097.html","الطويل"]],"verses":[["أُذَمُّ عَلى العُلى ظُلماً لِأَنّي","أَعُلُّ بِمائِها ظَمَأَ السُؤالِ",0,"ل",1,0],["أَذَمَّ عَلى الأَيّامِ مِن كُلِّ حادِثٍ","وَحاطَ جَنابَ الدينِ مِن كُلِّ ذاعِرِ",1,"ر",1,0],["أُذَمُّ مِن أَجلِ أَشعاري فَواعَجَبا","تُذَمَّ إِن جَنَتِ الخَمرَ العَناقيدُ",2,"د",1,0],["أَذُمُّ لِوَجهي عَلى ما بِهِ","وَلا يَعدِلُ الذُلُّ عِندي النَشَب",3,"ب",1,0],["اذْممْ ذَوِي التَّطْفِيلِ مَهْمَا أَتَى","وَإِنْ تَكُنْ أَجْمَلْتَهُمْ فَاعْنِهِ",4,"ه",1,1],["إِذ مُلكُ أَندَلُسٍ عَريضٌ جاهُهُ","وَشَبابُهُ المَبكِيُّ في رَيعانِهِ",5,"ن",2,0],["إذ من ديالي والفرات ودجلة","أمست تحُلّ بأهلك الكُرُبات",6,"ت",1,0],["أذمُّ إليك العينَ إن دموعها","تَداعَى بنار الحزن حين تَوهّجُ",7,"ج",1,0],["إذ مشيكم مُذْكِري غناءَكُمُ","مَشْيَ الهوينا سواكنِ البقرِ",8,"ر",1,0],["أذمَّتْ لقائي حُرمةٌ لك نِكتُها","فلم أشفِها أمْ قلتَ ما قلتَ بالحزْر",9,"ر",1,0],["أذمُّهُ غيرَ وقتٍ فيه أحمدُهُ","منذُ العِشاءِ إليهِ أن تسقَعَ الدِّيَكَهْ",10,"ك",2,0],["إِذ مُخنَبٌ في المُخنَبينَ وَفي الن","نَهكَةِ غَيٌّ بادِئٌ وَرَشَد",11,"د",1,0],["أذم القبعات ولابسيها","وتعجبني الشوادن في الطواقي",12,"ي",1,0],["إِذ مَرَّ ما مَرَّ مِنَ الزَمانِ","ثُمَّ أَتى المالِكُ لِلبُستانِ",13,"ن",1,0],["أَذُمُّ إِلى هَذا الزَمانِ أُهَيلَهُ","فَأَعلَمُهُم فَدمٌ وَأَحزَمُهُم وَغدُ",14,"د",1,0],["أَذَمَّت مَكرُماتُ أَبي شُجاعٍ","لِعَينِيَ مِن نَوايَ عَلى أُلاكا",15,"ك",2,0],["أذُمُّ جفوني أن تضِنَّ بذُخْرِها","وأمقتُ قلبي وهو يهدأُ في صدري",16,"ر",2,0],["أذُمُّ جفُوناً ليس يقرحُهَا البُكا","وأُنكرُ قلباً لا يذوبُ من الوَجْدِ",17,"د",1,0],["إِذ مَضى مُجلِباً يُقَعقِعُ في الدَر","بِ زَئيراً أَنسى الكِلابَ العُواءَ",18,"ا",2,0],["أَذُمُّ إِلَيكَ مَن أَحمَدتُ إِن لَم","يَكُن عَدَدٌ بِحَيثُ هُمُ قَليلُ",19,"ل",1,0],["إِذ مَلَأتَ السُيوفَ مِنهُم وَمِنّا","وَغَمَستَ الرِماحَ فيهِم وَفينا",20,"ن",2,0],["أَذُمُّ إِليكَ تَغليسَ الدُجونِ","وَلَمعَ البَرقِ في زَجِلٍ هُتونِ",21,"ن",1,1],["أَذُمُّ فيكَ الهَوى وَأَحمَدُهُ","فيكَ مَزَجتُ السُرورَ بِالحَزَنِ",22,"ن",1,0],["أَذُمُّ فيها النَّوى وأحمَدُها","لِوَقْفَةٍ تَلتقي بها المُقَلُ",23,"ل",1,0],["أَذُمُّ إليكَ عاديةَ الفِراقِ","وأحمَدُ سائحَ الدَّمعِ المُراقِ",24,"ق",1,1],["أذْمارُ حربٍ في سماءِ قتامِهِمْ","شُهُبٌ طوالع في القَنَا المَيّادِ",25,"د",1,0],["إِذ مِنهُمُ مَن يَعُدُّ ساعَتَهُ الطَ","لقَ عَتاداً لَهُ عَلى أَبَدِه",26,"د",2,0],["أَذُمُّ زَمَانَاً أَنْتَ فِيهِ وَبَلْدَةً","طَلَعْتَ عَلَيْهَا إِنَّهُ زَمَنٌ وَغْلُ",27,"ل",1,0],["إذْ مسْكَةُ الرَّبَواتِ الخُضْرِ توسِعُنا","بما تَفَتَّقَ مِن أنْسامِها عَبَقا",28,"ق",2,0],["أذُمّ إليكَ اعتْوِارَ الخُطوبِ","وصرْفَ الحوادثِ فيما أذُمّ",29,"م",1,0],["إِذ ما رَأَوا مَن دَأبُهُ مِثلُ دَأبِهِم","أَطافوا بِهِ وَالغَيُّ لِلغَيِّ أَصورُ",30,"ر",1,0],["إِذ مَرَّ يَختَلِسُ النُفو","سَ وَخَلفَهُ تُزجيهِ غيدُ",31,"د",1,0],["إِذ مَدخَلي سَرَقٌ أَسارِقُهُ","لِلِقاءِ أَحوَرَ زَيَّنَ الوُشُحا",32,"ح",2,0],["اذمم بسيف ذي مضا","ء لا يُفارق عوض غمدا",33,"د",2,0],["أذمم بها من فتنة","هوجاء يمقتها اللَبيب",34,"ب",1,0],["أذمّ هذا الوقت في بُطئِهِ","آخرهُ يعثُر في بَدئِهِ",35,"ه",1,0],["أَذِمَّة الحُبِّ كُنتُ أَقضي","لَو أَنَّ نَفسي لَكَ الفِداءُ",36,"ا",2,0],["أذمهُ غيرَ وقتٍ فيه أحمدهُ","من العشاء إلى أن تسقع الديكهْ",37,"ك",2,0],["إذ مُلْكُها غض الشباب ، وروُضها","زاهي الطراز ، مفوف الأبراد",38,"د",1,0],["أَذُمُّ فِيكَ الهَوَى وأَحمْدُهُ ،","فِيكَ مَزَحْتُ السُّرُورَ بالحَزَنِ",39,"ن",1,0],["إذ مُخنَبٌ في المُخنَبينَ وفي النَّ","هكَة ِ غَيٌّ بادِئٌ ورَشَدْ",40,"د",1,0],["إذ ما تجلّى البدر في الأفق طالعا","رعاه ، إلى أن يعتريه أفول",41,"ل",1,0],["إذ ماء جلّق كالرحيق عذوبة","وظباء جلّق كالشموس سفورا",42,"ر",2,0],["إذ ما قضيتُ اليوم لم أبكِ عَهْدَه","وأخلفتُ أدنى منه ظِلاًّ وأفنعا",43,"ع",2,0],["إذ من ديالة والفرات ودجلة","أمست تحل بالهلك الكربات",44,"ت",1,0],["إِذ منشأي قَد كانَ تَحتَ سَرادق","خدّامها الصَمصام وَالقمقام",45,"م",1,0],["إذ ملعبي الناس ألهو غير محتشم","بأرجلٍ منهم طرا وأذقان",46,"ن",1,0],["أذم العيش بعدهم ومن لي","بمن يدري أذموا العيش بعدي",47,"ي",1,0],["أذمُّ أيامى على أننى","لأَحمدُ الله على ما قضى",48,"ض",2,0],["إِذ مُدَّتي تَقْصُرُ عن عتابي","فَأُذْهِبَتْ بمذهب الخطابِ",49,"ب",1,0],["أذُمُّ عليهِ الدَّهرَ إذ حلَّ بَرْكُهُ","عليَّ وحَسّاني كُؤوسَ البَلابِلِ",50,"ل",1,0],["أذُمُّ البوارحَ من بعدهم","وأدعو على الناعب الأَبْقَع",51,"ع",1,0],["أَذَمَّتْ على أقطار مصر سيوفُه","بضربٍ يقِرُّ المُتَّقِى وهْو وادع",52,"ع",1,0],["أذمّ زمانهم ظلما وجورا","وهم بالذم أولى بالمكان",53,"ن",1,0],["أذمّ زمانهم ظلما وجورا","وهم بالذم أولى في العيار",54,"ر",1,0],["إِذ منَ المَروةِ أَسعى للصفا","وَبذاتِ الخالِ وَجدي عمّني",55,"ي",1,0],["أذم إلى الزمان أهيل سوء","يرون الغي من سبل الرشاد",56,"د",1,1],["إِذ مَزَجَت لي كَأسَ بَينٍ بِهِج","رانِ فَمِن سُكرٍ إِلى سُكرٍ",57,"ر",1,0],["إِذْ مَدْحُ أَعْلاَمِ الْهُدَى","لِرُقَيِّ دِينِ اللهِ سُلَّمْ",58,"م",1,0],["إذ ما بدا جبار حائل واقفاً","وعلى يديه للدماء مسيل",59,"ل",1,0],["اذ من صفاتك مستعار حليها","والمستعار لأهله مردود",60,"د",1,0],["أذُمُّ إليه أيّامُ التّنائي","وإن لم أحظَ أيّامَ التّداني",61,"ي",1,0],["أَذمَّتْ لنا سَلمى عشّيةَ سلَّمتْ","علينا لتوديعٍ بإيماء حاجب",62,"ب",1,0],["أُذِمُّ الدَهرَ مِن ذَمّي بِمَدحي","وَذَمَّ خَليلَهُ مَن ذَمَّ دَهرَه",63,"ر",2,0],["أذمُّ موردَها وأنهله","ها قد أحارَ العقولَ جدولُها",64,"ل",3,0],["اِذ مَرَّ يَخطرُ في الحَريرِ","مُضاعِفاً لَونَ الحَريرِ",65,"ر",1,0],["إذْ مِن عطَا مِطِ بَحْر الجهلِ أنقذني","فَضلاً ووفَقني سُبحانَه وهَدى",66,"د",2,0],["أَذُمُّ إليكَ البينَ إنَّ وشِيكَه","رَمَى كلَّ عظمٍ من عِظَامي بعَارِقَ",67,"ق",1,0],["أَذمُّ دهراً لعيشٍ لَسْتُ أَحْمدُهُ","ولستُ أحمدُ عيشاً بعد محمود",68,"د",1,0],["إذ مضت وهي قصيرات المدى","فلها طال بكائي وعويلي",69,"ل",2,0],["إِذ مندلو ادبر مصغى وقصارها","وعبيتها ودهرها في القبضةِ",70,"ه",1,0],["أذَمَّ لي أن يذالَ وجهي","أغلبُ منه ذو لِبدتينِ",71,"ن",1,0],["أذمُّ إليك العيشَ بعدك إنه","بُضيعَة لا المُغني المفيدِ ولا المقني",72,"ي",1,0],["أذَمَّ ابن أيّوبٍ على ما عقدتُهُ","به من جوارٍ ذمَّةً ليس تنحلُّ",73,"ل",1,0],["أذَمَّ لي على الأماني ماجدٌ","لو عَقدَ الخلودَ لي لم يُحلَلِ",74,"ل",1,0],["أذمُّ زماني وبي حاجةٌ","إلى القول شاهدُها يحضُرُ",75,"ر",1,0],["أذمّوا على الآمال لي وتعاقدوا","على رَقْع خَلاَّتي أكفّاً نواصحا",76,"ح",2,0],["أذمُّ النوى من أجله ولو أنها","تجافت عن الكنديّ قلت لها حسبي",77,"ب",2,0],["أذم إليه خاطراً كلما جرى","إلى شكر ما أولى من الجود قصرا",78,"ر",2,0],["أذم صباح الأربعاء فإنه","تبسم عن ثغر المنية فجره",79,"ر",2,0],["أذمُّ زماني فيهمُ ومِن أجلِهم","وما الذّنبُ لو أنصفتُ ذنب زماني",80,"ي",1,0],["أَذمُّ إِليك الدّهرَ إلّا لَيالياً","طَلعت لنا فيهنّ غُرّة أدهمِ",81,"م",1,0],["أذمّ إليك كَلْماً لَيس يؤْسى","وداءً لَيسَ يَعرفهُ الطَبيبُ",82,"ب",1,1],["إذ ما سوى مولاك جاءك باطل","في النص فانٍ هالكٌ كم ذا العمى",83,"م",2,0],["إذ مثلوا الجوهر بالأشباه","منهم محمد بن عبد الله",84,"ه",1,0],["أَذمُّ مسيري عَنْك حِين حمِدتُه","إِليك ولولا أَنت لَمْ أَحْمَد المَسْرى",85,"ر",2,0],["أَذُمُّ شَباباً لم أَذُق فيه لَذَّةً","ولا نِلتُ مِنْهُ لا حَراماً ولا حِلاَّ",86,"ل",2,1],["أَذُمُّ زمَاناً حال بيني وبينَه","وعوَّضَنِي مِن سَهْلِ عَيشي بصَعْبه",87,"ب",