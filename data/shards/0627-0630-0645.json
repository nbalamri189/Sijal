oetsgate.com/ViewPoem.aspx?id=207997",""],[5030,"غزوة أحد","https://www.poetsgate.com/ViewPoem.aspx?id=215625",""],[5072,"من حق قلبكَ أن يموت","https://www.poetsgate.com/ViewPoem.aspx?id=53749",""],[5183,"من طرائف المأمون","https://www.poetsgate.com/ViewPoem.aspx?id=180285",""],[5419,"الخاتم","https://www.poetsgate.com/ViewPoem.aspx?id=31450",""],[5674,"روحي منك ترتشف","https://www.poetsgate.com/ViewPoem.aspx?id=197552",""],[5690,"اللّه يعطي والزمان يجودُ","https://www.poetsgate.com/ViewPoem.aspx?id=172143",""],[5816,"( العبيرية ) في وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=125964",""],[5829,"في مخيم الكشافة","https://www.poetsgate.com/ViewPoem.aspx?id=161989",""],[5940,"أنشأت نظمًا زاهرًا قد طابا","https://www.poetsgate.com/ViewPoem.aspx?id=124948",""],[5997,"جمر في ذاكرة الرماد","https://www.poetsgate.com/ViewPoem.aspx?id=214424",""],[6134,"بزغت شموس السعد بالشهباء","https://www.poetsgate.com/ViewPoem.aspx?id=169525",""],[463,"أمرتكمُ أمري بنعمانَ ناصحا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60004&r=&rc=60",""]],"verses":[["أُذَمُّ عَلى العُلى ظُلماً لِأَنّي","أَعُلُّ بِمائِها ظَمَأَ السُؤالِ",0,"ل",1,0],["أَذَمَّ عَلى الأَيّامِ مِن كُلِّ حادِثٍ","وَحاطَ جَنابَ الدينِ مِن كُلِّ ذاعِرِ",1,"ر",1,0],["أُذَمُّ مِن أَجلِ أَشعاري فَواعَجَبا","تُذَمَّ إِن جَنَتِ الخَمرَ العَناقيدُ",2,"د",1,0],["أَذُمُّ لِوَجهي عَلى ما بِهِ","وَلا يَعدِلُ الذُلُّ عِندي النَشَب",3,"ب",1,0],["اذْممْ ذَوِي التَّطْفِيلِ مَهْمَا أَتَى","وَإِنْ تَكُنْ أَجْمَلْتَهُمْ فَاعْنِهِ",4,"ه",1,1],["إِذ مُلكُ أَندَلُسٍ عَريضٌ جاهُهُ","وَشَبابُهُ المَبكِيُّ في رَيعانِهِ",5,"ن",2,0],["إذ من ديالي والفرات ودجلة","أمست تحُلّ بأهلك الكُرُبات",6,"ت",1,0],["أذمُّ إليك العينَ إن دموعها","تَداعَى بنار الحزن حين تَوهّجُ",7,"ج",1,0],["إذ مشيكم مُذْكِري غناءَكُمُ","مَشْيَ الهوينا سواكنِ البقرِ",8,"ر",1,0],["أذمَّتْ لقائي حُرمةٌ لك نِكتُها","فلم أشفِها أمْ قلتَ ما قلتَ بالحزْر",9,"ر",1,0],["أذمُّهُ غيرَ وقتٍ فيه أحمدُهُ","منذُ العِشاءِ إليهِ أن تسقَعَ الدِّيَكَهْ",10,"ك",2,0],["إِذ مُخنَبٌ في المُخنَبينَ وَفي الن","نَهكَةِ غَيٌّ بادِئٌ وَرَشَد",11,"د",1,0],["أذم القبعات ولابسيها","وتعجبني الشوادن في الطواقي",12,"ق",2,0],["إِذ مَرَّ ما مَرَّ مِنَ الزَمانِ","ثُمَّ أَتى المالِكُ لِلبُستانِ",13,"ن",1,0],["أَذُمُّ إِلى هَذا الزَمانِ أُهَيلَهُ","فَأَعلَمُهُم فَدمٌ وَأَحزَمُهُم وَغدُ",14,"د",1,0],["أَذَمَّت مَكرُماتُ أَبي شُجاعٍ","لِعَينِيَ مِن نَوايَ عَلى أُلاكا",15,"ك",2,0],["أذُمُّ جفوني أن تضِنَّ بذُخْرِها","وأمقتُ قلبي وهو يهدأُ في صدري",16,"ر",2,0],["أذُمُّ جفُوناً ليس يقرحُهَا البُكا","وأُنكرُ قلباً لا يذوبُ من الوَجْدِ",17,"د",1,0],["إِذ مَضى مُجلِباً يُقَعقِعُ في الدَر","بِ زَئيراً أَنسى الكِلابَ العُواءَ",18,"ا",2,0],["أَذُمُّ إِلَيكَ مَن أَحمَدتُ إِن لَم","يَكُن عَدَدٌ بِحَيثُ هُمُ قَليلُ",19,"ل",1,0],["إِذ مَلَأتَ السُيوفَ مِنهُم وَمِنّا","وَغَمَستَ الرِماحَ فيهِم وَفينا",20,"ن",2,0],["أَذُمُّ إِليكَ تَغليسَ الدُجونِ","وَلَمعَ البَرقِ في زَجِلٍ هُتونِ",21,"ن",1,1],["أَذُمُّ فيكَ الهَوى وَأَحمَدُهُ","فيكَ مَزَجتُ السُرورَ بِالحَزَنِ",22,"ن",1,0],["أَذُمُّ فيها النَّوى وأحمَدُها","لِوَقْفَةٍ تَلتقي بها المُقَلُ",23,"ل",1,0],["أَذُمُّ إليكَ عاديةَ الفِراقِ","وأحمَدُ سائحَ الدَّمعِ المُراقِ",24,"ق",1,1],["أذْمارُ حربٍ في سماءِ قتامِهِمْ","شُهُبٌ طوالع في القَنَا المَيّادِ",25,"د",1,0],["إِذ مِنهُمُ مَن يَعُدُّ ساعَتَهُ الطَ","لقَ عَتاداً لَهُ عَلى أَبَدِه",26,"د",2,0],["أَذُمُّ زَمَانَاً أَنْتَ فِيهِ وَبَلْدَةً","طَلَعْتَ عَلَيْهَا إِنَّهُ زَمَنٌ وَغْلُ",27,"ل",1,0],["إذْ مسْكَةُ الرَّبَواتِ الخُضْرِ توسِعُنا","بما تَفَتَّقَ مِن أنْسامِها عَبَقا",28,"ق",2,0],["أذُمّ إليكَ اعتْوِارَ الخُطوبِ","وصرْفَ الحوادثِ فيما أذُمّ",29,"م",1,0],["إِذ ما رَأَوا مَن دَأبُهُ مِثلُ دَأبِهِم","أَطافوا بِهِ وَالغَيُّ لِلغَيِّ أَصورُ",30,"ر",1,0],["إِذ مَرَّ يَختَلِسُ النُفو","سَ وَخَلفَهُ تُزجيهِ غيدُ",31,"د",1,0],["إِذ مَدخَلي سَرَقٌ أَسارِقُهُ","لِلِقاءِ أَحوَرَ زَيَّنَ الوُشُحا",32,"ح",2,0],["اذمم بسيف ذي مضا","ء لا يُفارق عوض غمدا",33,"د",2,0],["أذمم بها من فتنة","هوجاء يمقتها اللَبيب",34,"ب",1,0],["أذمّ هذا الوقت في بُطئِهِ","آخرهُ يعثُر في بَدئِهِ",35,"ه",1,0],["أَذِمَّة الحُبِّ كُنتُ أَقضي","لَو أَنَّ نَفسي لَكَ الفِداءُ",36,"ا",2,0],["أذمهُ غيرَ وقتٍ فيه أحمدهُ","من العشاء إلى أن تسقع الديكهْ",37,"ك",2,0],["إذ مُلْكُها غض الشباب ، وروُضها","زاهي الطراز ، مفوف الأبراد",38,"د",1,0],["أَذُمُّ فِيكَ الهَوَى وأَحمْدُهُ ،","فِيكَ مَزَحْتُ السُّرُورَ بالحَزَنِ",39,"ن",1,0],["إذ مُخنَبٌ في المُخنَبينَ وفي النَّ","هكَة ِ غَيٌّ بادِئٌ ورَشَدْ",40,"د",1,0],["إذ ما تجلّى البدر في الأفق طالعا","رعاه ، إلى أن يعتريه أفول",41,"ل",1,0],["إذ ماء جلّق كالرحيق عذوبة","وظباء جلّق كالشموس سفورا",42,"ر",2,0],["إذ ما قضيتُ اليوم لم أبكِ عَهْدَه","وأخلفتُ أدنى منه ظِلاًّ وأفنعا",43,"ع",2,0],["إذ من ديالة والفرات ودجلة","أمست تحل بالهلك الكربات",44,"ت",1,0],["إِذ منشأي قَد كانَ تَحتَ سَرادق","خدّامها الصَمصام وَالقمقام",45,"م",1,0],["إذ ملعبي الناس ألهو غير محتشم","بأرجلٍ منهم طرا وأذقان",46,"ن",1,0],["أذم العيش بعدهم ومن لي","بمن يدري أذموا العيش بعدي",47,"د",2,0],["أذمُّ أيامى على أننى","لأَحمدُ الله على ما قضى",48,"ض",2,0],["إِذ مُدَّتي تَقْصُرُ عن عتابي","فَأُذْهِبَتْ بمذهب الخطابِ",49,"ب",1,0],["أذُمُّ عليهِ الدَّهرَ إذ حلَّ بَرْكُهُ","عليَّ وحَسّاني كُؤوسَ البَلابِلِ",50,"ل",1,0],["أذُمُّ البوارحَ من بعدهم","وأدعو على الناعب الأَبْقَع",51,"ع",1,0],["أَذَمَّتْ على أقطار مصر سيوفُه","بضربٍ يقِرُّ المُتَّقِى وهْو وادع",52,"ع",1,0],["أذمّ زمانهم ظلما وجورا","وهم بالذم أولى بالمكان",53,"ن",1,0],["أذمّ زمانهم ظلما وجورا","وهم بالذم أولى في العيار",54,"ر",1,0],["إِذ منَ المَروةِ أَسعى للصفا","وَبذاتِ الخالِ وَجدي عمّني",55,"ي",1,0],["أذم إلى الزمان أهيل سوء","يرون الغي من سبل الرشاد",56,"د",1,1],["إِذ مَزَجَت لي كَأسَ بَينٍ بِهِج","رانِ فَمِن سُكرٍ إِلى سُكرٍ",57,"ر",1,0],["إِذْ مَدْحُ أَعْلاَمِ الْهُدَى","لِرُقَيِّ دِينِ اللهِ سُلَّمْ",58,"م",1,0],["إذ ما بدا جبار حائل واقفاً","وعلى يديه للدماء مسيل",59,"ل",1,0],["اذ من صفاتك مستعار حليها","والمستعار لأهله مردود",60,"د",1,0],["أذُمُّ إليه أيّامُ التّنائي","وإن لم أحظَ أيّامَ التّداني",61,"ن",2,0],["أَذمَّتْ لنا سَلمى عشّيةَ سلَّمتْ","علينا لتوديعٍ بإيماء حاجب",62,"ب",1,0],["أُذِمُّ الدَهرَ مِن ذَمّي بِمَدحي","وَذَمَّ خَليلَهُ مَن ذَمَّ دَهرَه",63,"ر",2,0],["أذمُّ موردَها وأنهله","ها قد أحارَ العقولَ جدولُها",64,"ل",3,0],["اِذ مَرَّ يَخطرُ في الحَريرِ","مُضاعِفاً لَونَ الحَريرِ",65,"ر",1,0],["إذْ مِن عطَا مِطِ بَحْر الجهلِ أنقذني","فَضلاً ووفَقني سُبحانَه وهَدى",66,"د",2,0],["أَذُمُّ إليكَ البينَ إنَّ وشِيكَه","رَمَى كلَّ عظمٍ من عِظَامي بعَارِقَ",67,"ق",1,0],["أَذمُّ دهراً لعيشٍ لَسْتُ أَحْمدُهُ","ولستُ أحمدُ عيشاً بعد محمود",68,"د",1,0],["إذ مضت وهي قصيرات المدى","فلها طال بكائي وعويلي",69,"ل",2,0],["إِذ مندلو ادبر مصغى وقصارها","وعبيتها ودهرها في القبضةِ",70,"ه",1,0],["أذَمَّ لي أن يذالَ وجهي","أغلبُ منه ذو لِبدتينِ",71,"ن",1,0],["أذمُّ إليك العيشَ بعدك إنه","بُضيعَة لا المُغني المفيدِ ولا المقني",72,"ن",2,0],["أذَمَّ ابن أيّوبٍ على ما عقدتُهُ","به من جوارٍ ذمَّةً ليس تنحلُّ",73,"ل",1,0],["أذَمَّ لي على الأماني ماجدٌ","لو عَقدَ الخلودَ لي لم يُحلَلِ",74,"ل",1,0],["أذمُّ زماني وبي حاجةٌ","إلى القول شاهدُها يحضُرُ",75,"ر",1,0],["أذمّوا على الآمال لي وتعاقدوا","على رَقْع خَلاَّتي أكفّاً نواصحا",76,"ح",2,0],["أذمُّ النوى من أجله ولو أنها","تجافت عن الكنديّ قلت لها حسبي",77,"ب",2,0],["أذم إليه خاطراً كلما جرى","إلى شكر ما أولى من الجود قصرا",78,"ر",2,0],["أذم صباح الأربعاء فإنه","تبسم عن ثغر المنية فجره",79,"ر",2,0],["أذمُّ زماني فيهمُ ومِن أجلِهم","وما الذّنبُ لو أنصفتُ ذنب زماني",80,"ن",2,0],["أَذمُّ إِليك الدّهرَ إلّا لَيالياً","طَلعت لنا فيهنّ غُرّة أدهمِ",81,"م",1,0],["أذمّ إليك كَلْماً لَيس يؤْسى","وداءً لَيسَ يَعرفهُ الطَبيبُ",82,"ب",1,1],["إذ ما سوى مولاك جاءك باطل","في النص فانٍ هالكٌ كم ذا العمى",83,"م",2,0],["إذ مثلوا الجوهر بالأشباه","منهم محمد بن عبد الله",84,"ه",1,0],["أَذمُّ مسيري عَنْك حِين حمِدتُه","إِليك ولولا أَنت لَمْ أَحْمَد المَسْرى",85,"ر",2,0],["أَذُمُّ شَباباً لم أَذُق فيه لَذَّةً","ولا نِلتُ مِنْهُ لا حَراماً ولا حِلاَّ",86,"ل",2,1],["أَذُمُّ زمَاناً حال بيني وبينَه","وعوَّضَنِي مِن سَهْلِ عَيشي بصَعْبه",87,"ب",2,1],["أذُمُّ فُؤادي مَع قُصُورِ نُزُوعِهِ","وأحمَدُه في شَوقِهِ ونِزِاعِهِ",88,"ع",2,0],["إذْ مَذْهبي مُذْ كنتُ مَنْ","لَمْ