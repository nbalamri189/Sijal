{"poems":[[53,"عصينا فيك أحداث الليالي","https://www.aldiwan.net/poem29864.html","الوافر"],[53,"بغير شفيع نال عفو المقادر","https://www.aldiwan.net/poem30465.html","الطويل"],[53,"إلى كم الطرف بالبيداء معقود","https://www.aldiwan.net/poem30637.html","البسيط"],[53,"أثرها على ما بها من لغب","https://www.aldiwan.net/poem30743.html","المتقارب"],[77,"اذمم ذوي التطفيل مهما أتى","https://www.aldiwan.net/poem36056.html","السريع"],[86,"ورد الكنانة عبقري زمانه","https://www.aldiwan.net/poem68904.html","الكامل"],[88,"بغداد حسبك رقدة وسبات","https://www.aldiwan.net/poem45007.html","الكامل"],[51,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[51,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[51,"أبا منذر بالله إلا صدقتني","https://www.aldiwan.net/poem64004.html","الطويل"],[51,"شهر القيام وإن عظمت حرمته","https://www.aldiwan.net/poem65784.html","الوافر"],[16,"دافعت عنه بشعري","https://www.aldiwan.net/poem27692.html","الرجز"],[85,"يمينا بالطلاق وبالعتاق","https://www.aldiwan.net/poem6824.html","الوافر"],[85,"حكاية الكلب مع الحمامه","https://www.aldiwan.net/poem8012.html","الرجز"],[43,"أقل فعالي بله أكثره مجد","https://www.aldiwan.net/poem9542.html","الطويل"],[43,"فدا لك من يقصر عن مداكا","https://www.aldiwan.net/poem9756.html","الوافر"],[62,"أقول وقد غال الردى من أحبه","https://www.aldiwan.net/poem52429.html","الطويل"],[62,"أيا حادي الأظعان غرد فقد بدا","https://www.aldiwan.net/poem52444.html","الطويل"],[45,"يا أخا الأزد ما حفظت الإخاء","https://www.aldiwan.net/poem10196.html","الخفيف"],[45,"بمثل لقائها شفي الغليل","https://www.aldiwan.net/poem65600.html","الوافر"],[45,"هم ألى رائحون أم غادونا","https://www.aldiwan.net/poem66662.html","الخفيف"],[45,"أذم إليك تغليس الدجون","https://www.aldiwan.net/poem66667.html","الوافر"],[45,"يا نازحا قد نأى عن الوطن","https://www.aldiwan.net/poem66824.html","المنسرح"],[61,"لا يعرف العدل وهو معتدل","https://www.aldiwan.net/poem51483.html","السريع"],[61,"أذم إليك عادية الفراق","https://www.aldiwan.net/poem51504.html","الوافر"],[80,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[44,"ما لكثيب الحمى إلى عقده","https://www.aldiwan.net/poem30552.html","المنسرح"],[87,"وصالك لي هجر وهجرك لي وصل","https://www.aldiwan.net/poem8344.html","الطويل"],[90,"شممت تربك لا زلفى ولا ملقا","https://www.aldiwan.net/poem60156.html","عموديه"],[75,"أما والمذاكي يلكن الشكم","https://www.aldiwan.net/poem69039.html","المتقارب"],[50,"شهدت على الزيدي أن نساءه","https://www.aldiwan.net/poem62384.html","السريع"],[50,"عاد الغداة الصب عيد","https://www.aldiwan.net/poem63944.html","مجزوء الكامل"],[50,"قاس الهموم تنل بها نجحا","https://www.aldiwan.net/poem63980.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85473","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85647","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43832","البسيط"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/199046","البسيط"],[90,"أمين الريحاني","https://www.poetsgate.com/ViewPoem.aspx?id=178954",""],[45,"يا نازِحاً قَدْ نَأَى عَنِ الوَطَنِ","https://www.poetsgate.com/ViewPoem.aspx?id=31788",""],[16,"دافعتُ عَنهُ بِشِعريَ إذْ","https://www.poetsgate.com/ViewPoem.aspx?id=4909",""],[91,"حكاية حال","https://www.poetsgate.com/ViewPoem.aspx?id=53184",""],[94,"نغمات عودي","https://www.poetsgate.com/ViewPoem.aspx?id=15651",""],[51,"بكيتَ فلم تترك لعيْنِكَ مدمعاً","https://www.poetsgate.com/ViewPoem.aspx?id=29517",""],[88,"بغدادُ حسبكِ رقدة وسبات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19515&r=&rc=18",""]],"verses":[["أُذَمُّ عَلى العُلى ظُلماً لِأَنّي","أَعُلُّ بِمائِها ظَمَأَ السُؤالِ",0,"ل",1,0],["أَذَمَّ عَلى الأَيّامِ مِن كُلِّ حادِثٍ","وَحاطَ جَنابَ الدينِ مِن كُلِّ ذاعِرِ",1,"ر",1,0],["أُذَمُّ مِن أَجلِ أَشعاري فَواعَجَبا","تُذَمَّ إِن جَنَتِ الخَمرَ العَناقيدُ",2,"د",1,0],["أَذُمُّ لِوَجهي عَلى ما بِهِ","وَلا يَعدِلُ الذُلُّ عِندي النَشَب",3,"ب",1,0],["اذْممْ ذَوِي التَّطْفِيلِ مَهْمَا أَتَى","وَإِنْ تَكُنْ أَجْمَلْتَهُمْ فَاعْنِهِ",4,"ه",1,1],["إِذ مُلكُ أَندَلُسٍ عَريضٌ جاهُهُ","وَشَبابُهُ المَبكِيُّ في رَيعانِهِ",5,"ن",2,0],["إذ من ديالي والفرات ودجلة","أمست تحُلّ بأهلك الكُرُبات",6,"ت",1,0],["أذمُّ إليك العينَ إن دموعها","تَداعَى بنار الحزن حين تَوهّجُ",7,"ج",1,0],["إذ مشيكم مُذْكِري غناءَكُمُ","مَشْيَ الهوينا سواكنِ البقرِ",8,"ر",1,0],["أذمَّتْ لقائي حُرمةٌ لك نِكتُها","فلم أشفِها أمْ قلتَ ما قلتَ بالحزْر",9,"ر",1,0],["أذمُّهُ غيرَ وقتٍ فيه أحمدُهُ","منذُ العِشاءِ إليهِ أن تسقَعَ الدِّيَكَهْ",10,"ك",2,0],["إِذ مُخنَبٌ في المُخنَبينَ وَفي الن","نَهكَةِ غَيٌّ بادِئٌ وَرَشَد",11,"د",1,0],["أذم القبعات ولابسيها","وتعجبني الشوادن في الطواقي",12,"ي",1,0],["إِذ مَرَّ ما مَرَّ مِنَ الزَمانِ","ثُمَّ أَتى المالِكُ لِلبُستانِ",13,"ن",1,0],["أَذُمُّ إِلى هَذا الزَمانِ أُهَيلَهُ","فَأَعلَمُهُم فَدمٌ وَأَحزَمُهُم وَغدُ",14,"د",1,0],["أَذَمَّت مَكرُماتُ أَبي شُجاعٍ","لِعَينِيَ مِن نَوايَ عَلى أُلاكا",15,"ك",2,0],["أذُمُّ جفوني أن تضِنَّ بذُخْرِها","وأمقتُ قلبي وهو يهدأُ في صدري",16,"ر",2,0],["أذُمُّ جفُوناً ليس يقرحُهَا البُكا","وأُنكرُ قلباً لا يذوبُ من الوَجْدِ",17,"د",1,0],["إِذ مَضى مُجلِباً يُقَعقِعُ في الدَر","بِ زَئيراً أَنسى الكِلابَ العُواءَ",18,"ا",2,0],["أَذُمُّ إِلَيكَ مَن أَحمَدتُ إِن لَم","يَكُن عَدَدٌ بِحَيثُ هُمُ قَليلُ",19,"ل",1,0],["إِذ مَلَأتَ السُيوفَ مِنهُم وَمِنّا","وَغَمَستَ الرِماحَ فيهِم وَفينا",20,"ن",2,0],["أَذُمُّ إِليكَ تَغليسَ الدُجونِ","وَلَمعَ البَرقِ في زَجِلٍ هُتونِ",21,"ن",1,1],["أَذُمُّ فيكَ الهَوى وَأَحمَدُهُ","فيكَ مَزَجتُ السُرورَ بِالحَزَنِ",22,"ن",1,0],["أَذُمُّ فيها النَّوى وأحمَدُها","لِوَقْفَةٍ تَلتقي بها المُقَلُ",23,"ل",1,0],["أَذُمُّ إليكَ عاديةَ الفِراقِ","وأحمَدُ سائحَ الدَّمعِ المُراقِ",24,"ق",1,1],["أذْمارُ حربٍ في سماءِ قتامِهِمْ","شُهُبٌ طوالع في القَنَا المَيّادِ",25,"د",1,0],["إِذ مِنهُمُ مَن يَعُدُّ ساعَتَهُ الطَ","لقَ عَتاداً لَهُ عَلى أَبَدِه",26,"د",2,0],["أَذُمُّ زَمَانَاً أَنْتَ فِيهِ وَبَلْدَةً","طَلَعْتَ عَلَيْهَا إِنَّهُ زَمَنٌ وَغْلُ",27,"ل",1,0],["إذْ مسْكَةُ الرَّبَواتِ الخُضْرِ توسِعُنا","بما تَفَتَّقَ مِن أنْسامِها عَبَقا",28,"ق",2,0],["أذُمّ إليكَ اعتْوِارَ الخُطوبِ","وصرْفَ الحوادثِ فيما أذُمّ",29,"م",1,0],["إِذ ما رَأَوا مَن دَأبُهُ مِثلُ دَأبِهِم","أَطافوا بِهِ وَالغَيُّ لِلغَيِّ أَصورُ",30,"ر",1,0],["إِذ مَرَّ يَختَلِسُ النُفو","سَ وَخَلفَهُ تُزجيهِ غيدُ",31,"د",1,0],["إِذ مَدخَلي سَرَقٌ أَسارِقُهُ","لِلِقاءِ أَحوَرَ زَيَّنَ الوُشُحا",32,"ح",2,0],["اذمم بسيف ذي مضا","ء لا يُفارق عوض غمدا",33,"د",2,0],["أذمم بها من فتنة","هوجاء يمقتها اللَبيب",34,"ب",1,0],["أذمّ هذا الوقت في بُطئِهِ","آخرهُ يعثُر في بَدئِهِ",35,"ه",1,0],["أَذِمَّة الحُبِّ كُنتُ أَقضي","لَو أَنَّ نَفسي لَكَ الفِداءُ",36,"ا",2,0],["أذمهُ غيرَ وقتٍ فيه أحمدهُ","من العشاء إلى أن تسقع الديكهْ",37,"ك",2,0],["إذ مُلْكُها غض الشباب ، وروُضها","زاهي الطراز ، مفوف الأبراد",38,"د",1,0],["أَذُمُّ فِيكَ الهَوَى وأَحمْدُهُ ،","فِيكَ مَزَحْتُ السُّرُورَ بالحَزَنِ",39,"ن",1,0],["إذ مُخنَبٌ في المُخنَبينَ وفي النَّ","هكَة ِ غَيٌّ بادِئٌ ورَشَدْ",40,"د",1,0],["إذ ما تجلّى البدر في الأفق طالعا","رعاه ، إلى أن يعتريه أفول",41,"ل",1,0],["إذ ماء جلّق كالرحيق عذوبة","وظباء جلّق كالشموس سفورا",42,"ر",2,0],["إذ ما قضيتُ اليوم لم أبكِ عَهْدَه","وأخلفتُ أدنى منه ظِلاًّ وأفنعا",43,"ع",2,0],["إذ من ديالة والفرات ودجلة","أمست تحل بالهلك الكربات",44,"ت",1,0]]}