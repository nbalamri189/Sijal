{"poems":[[55,"أبينتها أم ناكرتك شياتها","https://www.aldiwan.net/poem30677.html","الطويل"],[66,"متى سهرت عيني لغيرك أو بكت","https://www.aldiwan.net/poem67574.html","الطويل"],[53,"يبتُ أخو البلوى إذا الخلو غمضا","https://www.aldiwan.net/poem64946.html","الطويل"],[101,"إلى رجل","https://www.aldiwan.net/poem6618.html","عموديه"],[48,"عجبت لورقاء الجناحين شأنها","https://www.aldiwan.net/poem22529.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16663","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9916","الطويل"],[101,"إلى رجل","https://www.poetsgate.com/ViewPoem.aspx?id=565",""],[119,"علمتم بأني مغرم بكم صب","https://www.aldiwan.net/poem41234.html","عموديه"],[190,"أقول لمن أراد الحزم يوما","https://www.aldiwan.net/poem43549.html","الوافر"],[216,"إن الليالي والأيام أطراق","https://www.aldiwan.net/poem37856.html","البسيط"],[234,"متى سالم الأيام قبلي مسالم","https://www.aldiwan.net/poem50813.html","الطويل"],[237,"علمتم بأني مغرم بكم صب","https://www.aldiwan.net/poem14836.html","الطويل"],[295,"هناك بذلك العلم","https://www.aldiwan.net/poem11658.html","مجزوء الوافر"],[422,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[454,"وآلم الجرح ما أدمته أيدينا","https://www.aldiwan.net/poem998.html",""],[463,"أروم الوفاء الصعب بالمطلب السهل","https://www.aldiwan.net/poem56064.html","الطويل"],[463,"أخي في الود أخي النسيبِ","https://www.aldiwan.net/poem56304.html","الوافر"],[470,"شدوا اليك نياط القلب والعصبا","https://www.aldiwan.net/poem54193.html","عموديه"],[482,"أفي كل يوم عبرة لك تهمع","https://www.aldiwan.net/poem15272.html","الطويل"],[505,"يا منشد الغيب أذكر من نيهم به","https://www.aldiwan.net/poem37632.html","البسيط"],[520,"أما وخدود ألفن الصدودا","https://www.aldiwan.net/poem12070.html","المتقارب"],[556,"رم النجاء عن الفحشاء والهون","https://www.aldiwan.net/poem47160.html","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64124","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63812","المجتث"],[866,"","https://poetry.dctabudhabi.ae/diwan/poem/198794","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108637","الوافر"],[1993,"","https://poetry.dctabudhabi.ae/diwan/poem/199044","الطويل"],[2408,"","https://poetry.dctabudhabi.ae/diwan/poem/128800","الطويل"],[2565,"","https://poetry.dctabudhabi.ae/diwan/poem/103717","المجتث"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132163","الوافر"],[4259,"","https://poetry.dctabudhabi.ae/diwan/poem/145345","المجتث"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139243","الوافر"],[4691,"هيفاء ردّي لمن أنحلته ِ عُمُرا ً !!","https://www.poetsgate.com/ViewPoem.aspx?id=60737",""],[4691,"بدر يسكن في بدر","https://www.poetsgate.com/ViewPoem.aspx?id=94080",""],[4755,"حُداءُ الغَريب","https://www.poetsgate.com/ViewPoem.aspx?id=184578",""],[4767,"الضياع","https://www.poetsgate.com/ViewPoem.aspx?id=180021",""],[4859,"متى سأراك ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=186775",""],[4119,"حين سما لي في السلو سبيل","https://www.poetsgate.com/ViewPoem.aspx?id=16205",""],[5075,"الله مولانا","https://www.poetsgate.com/ViewPoem.aspx?id=190435",""],[5090,"طيرُ السلام","https://www.poetsgate.com/ViewPoem.aspx?id=186811",""],[5221,"إلى الحبيبة -القدس-","https://www.poetsgate.com/ViewPoem.aspx?id=188994",""],[5277,"من بعدِهم لا أبالي حيثما أقَعُ","https://www.poetsgate.com/ViewPoem.aspx?id=190825",""],[5281,"وجدان","https://www.poetsgate.com/ViewPoem.aspx?id=199753",""],[5353,"رئة من خشب","https://www.poetsgate.com/ViewPoem.aspx?id=212242",""],[5408,"عروبيٌّ صوتي","https://www.poetsgate.com/ViewPoem.aspx?id=190873",""],[5459,"مدلجون..","https://www.poetsgate.com/ViewPoem.aspx?id=191597",""],[470,"بعد فوات الأوان","https://www.poetsgate.com/ViewPoem.aspx?id=178099",""],[5609,"نزوة عشق","https://www.poetsgate.com/ViewPoem.aspx?id=215571",""],[466,"لقد علمت زوراء دجلة أنني","https://www.poetsgate.com/ViewPoem.aspx?id=38054",""],[5771,"بطاقة زائر","https://www.poetsgate.com/ViewPoem.aspx?id=189060",""],[5880,"رضاك إلهي","https://www.poetsgate.com/ViewPoem.aspx?id=208579",""],[5897,"إلى .. اليمن الذي كان سعيداً !","https://www.poetsgate.com/ViewPoem.aspx?id=176758",""],[5956,"شقاءُ شعب","https://www.poetsgate.com/ViewPoem.aspx?id=208002",""],[6003,"عيد الاستقلال","https://www.poetsgate.com/ViewPoem.aspx?id=189045",""],[6070,"إذا صلَحتْ نوايا النّاسِ حتماً","https://www.poetsgate.com/ViewPoem.aspx?id=194606",""],[6242,"التِّمثال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87561&r=&rc=8",""],[6242,"كذّابة الشوق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87565&r=&rc=12",""],[6248,"رجع الخاصرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86024&r=&rc=1",""],[6248,"تراتيل العزلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86018&r=&rc=4",""],[454,"وآلم الجرح ما أدمته أيدينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82658&r=&rc=22",""]],"verses":[["مَتى سَمِعَت صَوتَ الصَريخِ تَنَصَّتَت","قِياماً إِلى داعي الوَغى سَمَعاتُها",0,"ت",3,0],["مَتى سَهِرَت عَيني لِغَيرِكَ أَو بَكَت","فَلا أُعطِيَت ما مُنِّيَت وَتَمَنَّتِ",1,"ت",1,1],["متى سلَّ سيفاً مارقٌ سلَّ رأيَهُ","فقطّعه والسيفُ للسيف يُنتضى",2,"ض",2,0],["متى ستعرف كم أهواك يا رجل","أبيع من أجله الدنيا وما فيها",3,"ي",3,1],["مَتى سَمِعَت أُذني مَقالَةَ ناصِحٍ","أُتيحَ لَها عَن قاتِلِ النُصحِ وَقرُها",4,"ر",3,0],["متى سألَتْ بَغدادُ عنّي وأهْلُها","فإنّيَ عن أهلِ العَواصِمِ سَأآل",5,"ل",1,0],["مَتى سُلَّ في كَفّي بِيَومِ كَريهَةٍ","فَلا فَرقَ ما بَينَ المَشايِخِ وَالمُردِ",6,"د",1,0],["متى ستعرف كم أهواك يا رجلا","أبيع من أجله الدنيا وما فيها",7,"ي",3,1],["متى سهرت عيني لغير هواكم","وأرقها في غير معناكم حزب",8,"ب",1,0],["متى سار البصير لقى ضريراً","وهيهات الأسير من الطليق",9,"ق",1,0],["متى سرى لضريحٍ وهو مُنْفِرِدٌ","بَكَتْ لِفُقْدانهِ صُحْفٌ وأوْرَاقُ",10,"ق",1,0],["متى سَالَم الأيّامَ قَبْلي مُسالِمٌ","فرقَّت له حتّى أُسالَم أَيّامي",11,"م",2,1],["مَتى سَهِرَت عَيني لِغَيرِ جَمالِكُم","فَلا بَرِحَت عِندي مَدامِعُها سُكبُ",12,"ب",1,0],["متى سنعود للماضي","أباة الضيم أحرارا",13,"ر",2,0],["متى سمعت أُذناك منِّي رواعدا","تصوب عَزاليها وتهمي سيولها",14,"ه",2,0],["متى سنترك يا قومي مهاترة","متى سنثبت للدنيا تآخينا",15,"ن",2,0],["متى سنغسل عارا عالقا فين","متى نزيل الأعادي أرضينا",15,"ن",2,0],["متى سنشعلها حمراء قانية","متى سنسحق أوغادا ملاعبنا",15,"ن",2,0],["متى سَقَتِ العينُ الربوعَ فلا تزل","ربوعكُمُ من بخل جفنيَ في محلِ",16,"ل",1,0],["متى سالمتني سلِمتْ صَفاتي","على ما دسَّ قومٌ من ذنوبي",17,"ب",2,0],["متى سَيَفهَمُ هذا الخَلْقُ أنَّ لَنا","في كلِّ آهِلَةٍ مِن شِعرِنا نَسَبا",18,"ب",2,0],["متى سمعوا منّا البديعَ وعظَّموا","محاسنَهُ نظَّمتُ ما هو أبدعُ",19,"ع",1,0],["متى سمعنا معاني ذكره ابتهجت","أرواحنا وانجلت أنواره فينا",20,"ن",2,0],["متى سار موكبه كادت ال","بلاد بساكنها أن تميدا",21,"د",2,0],["متى سقاني فروّاني مواصلةً","فما أُبالي بمن في الخَلْقِ يجفوني",22,"ن",2,0],["متى سكبناها تَقُلْ","عقيقةٌ منسكبه",23,"ب",2,0],["متى سَرَرْتَ عدوّاً","فاعلمْ بأَنْ لن يَسُرّك",24,"ك",1,0],["متى ستعلّمون العُرْب درساً","ليجمع شمْل مَن نطَقوا بِضادِ",25,"د",1,0],["متى سطعت بكف قليل ماءٍ","يموج بوجهه موج السرور",26,"ر",1,0],["متى سمط الأزهار بالطيب عرفها","ترى كل طيب فائق من فدادها",27,"د",3,0],["متى سيرت فيه لكوفان زينب","وبالرغم هل طيفت بمصرع قتلاها",28,"ه",2,0],["متى سمعت ثناء","عمن غدا لك حاسد",29,"د",1,1],["متى سارت تؤمّ حماك سارت","إليه من الرحاب إلى الرحابِ",30,"ب",1,0],["متى سقيت صباحاً","ذكراك طاب صبوحي",31,"ح",2,0],["متى سلمت من النقد البرايا","وحسبك ما تشاهد في الهلال",32,"ل",1,0],["متى ستنعم عيني يا معذبتي","متى يعود فؤادي منك مبتهجا ؟",33,"ج",2,0],["متى ستخط في خصري حروفا","من الأشعار منها فاح َ زهرُ",34,"ر",1,0],["مَتَى سَتَعُودُ لِلمَكظُومِ مَن تَمْشِيْ عَلَى اسْتِحْيَاءْ ؟","مَتَى ؟ وتَلُوْحُ (مَدْيَنُ) لِي, ولكنْ دُونَ حَرْفِ اليَاءْ",35,"ا",2,0],["متى ستأتي لأرضٍ شابَ مِفرقُها","ممَّا عليها من الأرزاء والمِحَن",36,"ن",1,0],["‏متى سأراك مبتهجاً تنادي","بأن الحبَّ محبرةُ الفؤادِ",37,"د",1,1],["متى سأراك ترسمني ابتساماً","على شفتيك في ظلمِ السهادِ؟!",37,"د",1,0],["متى سمحت عين لعان بفدية","فلا فاتني من ذا الجمال جميل",38,"ل",1,0],["(مَتَى) سَيَنْتَصِرُ الإِصْلاَحُ خَالِقَنَا","وَتَنْزِلُ البُشْرَى فِي النَّاسِ قُرْآنَا",39,"ن",2,0],["متى سيرفرفُ طيرُ السلامْ ؟","مضى العامُ ثم تلى العامَ عامْ",40,"م",1,1],["متى سوف يسطعُ نورُ الضحى","لتلعنَ أرضي ليلَ الظلامْ",40,"م",1,0],["متى سترجع للأقصى سلامته","وقد تراكم في أرجائه الحفف",41,"ف",1,0],["متى سندخل في القدس التي سلبت","ويرجع التيه والعلياء والشرف",41,"ف",1,0],["متى ستصحو مِنَ التّحنانِ تُغدِقُهُ","على التي ودُّها تنتابُهُ الخُدَعُ",42,"ع",1,0],["\"متَى ستعودُ يا بَابَا؟\"","تُفَاجِئُني وتَأتيني!",43,"ن",2,1],["متَى ستعودُ \"يا بَابا؟!\"","سؤالٌ باتَ يَكوِينِي",43,"ن",2,0],["متى ستعلنُ في الأرجاءِ أن دماً","مُسربلاً كاد حدَّ الموتِ يختنقُ",44,"ق",1,0],["متى ستحتجُّ أنَّ الطَّارئينَ غدتْ","أصواتُهم ملءَ هذي الأذن ِتُخترقُ",44,"ق",1,0],["متى ستصفو ويأتي من به بَصرٌ","يقودُ هذي الخطى مَنْ فيه نعْتقدُ",45,"د",1,0],["مَتَى سَنَلْمَحُ ضَوْءَ الشَّمْسِ مُنْبَعِثًا","وَ الْهَمَّ مُرْتَحِلاً وَ الْجُرْحَ يَلْتَئِمُ..?",46,"م",1,0],["متى ستفهمُ أن تحتاط يا أعمى","حتّى العمى, أنت تدري, بعضُهُ نُعمى!",47,"م",2,1],["متى ستفهمُ أنَّ العُمَر أوجَعُهُ","أنْ صارَ أرذَلُهُ بعد الغِنى يُتما",47,"م",2,0],["متى سَتفهمُ أن تحتاطَ يا أعمى","أن تَستريبَ قليلاً قبلَما تُرمى؟",47,"م",2,0],["متى ستفهمْ أن تحتاطَ يا أعمى","أنْ لا تقولَ, وأنتَ المُبتلَى: مهما",47,"م",2,0],["متى سأكتب عن لقياك قافيتي","متى سأنظم في لقياك أبياتي",48,"ت",2,0],["متى سمته بالقول نصراً جرت به","مقاولُ أغمادٍ فصاحُ المجازر",49,"ر",1,0],["مَتَى سَتَهدَأُ ..؟ لَمْ تَبْدَأ مُعَاتَبَتِي","مَا زِلتُ أحبُو عَلَى أسفَارِ تَدوينِي",50,"ن",2,0],["متى سبَّحت في الشرق باسمكَ عُصبةٌ","تعالى صدى أخرى بأقصى المغاربِ",51,"ب",1,0],["متى ستنتفض الأنوار في دمها","تستل أنفاسها من وهدة الدُجَنِ",52,"ن",1,0],["متى سفري من الدنيا إلى العَليا بلا رُجْعى","إلى مدرائنا الجَوعى الألَى بلعوا المَلا بلعا؟",53,"ع",2,1],["متى سفري من الدنيا إلى العَليا بلا رُجْعى؟","فلست هنا أرى وطناً ولا عدلاً ولا شرعا..",53,"ع",2,0],["متى ستمضى إلى الأمجاد منتشيا","أرى عدوّك قد أودى به الأجل",54,"ل",1,0],["متى سَتُنيرُ وَجهَ الليلِ قلْ لي","وتُظْهرُ بسمَةً في قولِ مَزحِ",55,"ح",1,0],["متى ستشرق يا نجماً وتبصرني","متى ستمسح يا تمثالُ دمعاتي",56,"ت",2,0],["متى سأشعل شمعَ الحبّ في أملي","متى ستهطل فوق اليأس أمطاري",57,"ر",2,0],["متى ستدرك أن الصدق خاتمتي","وأنني لستُ من يرضي تجمّلُهُ",58,"ل",2,0],["متى سوف لن أُجنى تراتيل عزلةٍ","وأشجي النّدامى .. كلما قلتُ ردّدوا",59,"د",3,0],["متى سنغسل عارا عالقا فينا","متى نزيل الأعادي أرضينا",60,"ن",2,0]]}