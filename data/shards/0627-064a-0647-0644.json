{"poems":[[55,"أحظى الملوك من الأيام والدول","https://www.aldiwan.net/poem29908.html","البسيط"],[74,"أحنت معاطفي السنون وغيرت","https://www.aldiwan.net/poem20484.html","الكامل"],[14,"أقلي علي اللوم يا بنت منذر","https://www.aldiwan.net/poem38304.html","الطويل"],[107,"في حمى الحق ومن حول الحرم","https://www.aldiwan.net/poem42091.html","الرمل"],[106,"شهداء","https://www.aldiwan.net/poem26158.html","عموديه"],[48,"غير مجد في ملتي واعتقادي","https://www.aldiwan.net/poem23625.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54820","المتقارب"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142032","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142030","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43832","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43778","المنسرح"],[92,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[119,"هات ذكر الغزالة الخود هات","https://www.aldiwan.net/poem41681.html","الخفيف"],[171,"أمتي","https://www.aldiwan.net/poem1064.html","عموديه"],[177,"أنا أنس لقعود","https://www.aldiwan.net/poem4382.html","عموديه"],[215,"مرت الأيام والروح الحزين","https://www.aldiwan.net/poem46613.html","الرمل"],[230,"إنظمى الدر يا سمية إسكندر","https://www.aldiwan.net/poem55204.html","الخفيف"],[242,"البحر قد أبدى سنا نضرته","https://www.aldiwan.net/poem18084.html","السريع"],[261,"أتعشى بغير خبز وهذا","https://www.aldiwan.net/poem48495.html","الخفيف"],[347,"يا لقلبي من ذكريات الأماني","https://www.aldiwan.net/poem55330.html","الخفيف"],[469,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[505,"كل حال لا بد آنا يحول","https://www.aldiwan.net/poem37568.html","الخفيف"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133776","الرمل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11962","الرجز"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100965","الخفيف"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47152","الخفيف"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101742","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93578","الخفيف"],[2527,"","https://poetry.dctabudhabi.ae/diwan/poem/17683","الطويل"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101626","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72481","البسيط"],[4877,"لي قلب","https://www.poetsgate.com/ViewPoem.aspx?id=29455",""],[5183,"مأساة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=186493",""],[5409,"أتراهم من وحشةِ الأرض طاروا","https://www.poetsgate.com/ViewPoem.aspx?id=155269",""],[5436,"العى بنا الشوق يابغداد","https://www.poetsgate.com/ViewPoem.aspx?id=185987",""],[5497,"علل النفس بما يسعدها","https://www.poetsgate.com/ViewPoem.aspx?id=206747",""],[5573,"ضجيج الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=200173",""],[5691,"أسوار وحراب","https://www.poetsgate.com/ViewPoem.aspx?id=206525",""],[5725,"خمرية طيبة","https://www.poetsgate.com/ViewPoem.aspx?id=177436",""],[242,"البحر قد ابدى سنا نضرته","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563693",""],[6185,"غزو الهموم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87032&r=&rc=18",""],[6318,"مهرجان القصيد (1)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66156&r=&rc=6",""]],"verses":[["إيهٍ لَقَد أَسَرَ الدُنيا بِنَجدَتِهِ","أَبو الفَوارِسِ وَالإِقدامِ لِلبَطَلِ",0,"ل",1,0],["إيهٍ لعهدك يا زمان البان من","عطفي وآهاً يا زمان المنحنى",1,"ن",2,0],["أَيَهلِكُ مُعتَمٌّ وَزَيدٌ وَلَم أَقُم","عَلى نُدَبٍ يَوماً وَلي نَفسُ مُخطِرِ",2,"ر",1,0],["آيةٌ للبَغْيِ من أسمائها","حِكمةُ الأقدارِ أو عَدلُ القِسَمْ",3,"م",1,0],["أيه لقوم نحن متن فهي","نستمع م يقول فين لرثءُ",4,"ا",1,0],["أيه لقومُ نحنُ متن ولكن","أنفت أن تضمن لغبرءُ",4,"ا",1,0],["إيه للّهِ دَرّكُنّ فأنْتُنّ اللْ","لَوَاتي تُحْسِنّ حِفْظَ الوِدادِ",5,"د",1,0],["أَيَهْلِكُ مَنْ يُرْتَجَى بُرْؤُهُ","وَفِيكُمْ شُعُورٌ وَفِيكُمْ نَظَرْ",6,"ر",1,0],["إيه لبنان أين غرّتُكَ البيضاء","أين العربين كيف اضمحَلا",7,"ل",2,0],["إيه لبنان! والجداول تجري","فيك بردا فتنعش الظمآنا",8,"ن",2,1],["إيه لبنان! والنسيم عليلا","يتهادى فيعطف الأغصانا",8,"ن",2,0],["أَيُّ هِلالٍ أَنارَ لَيلي","كانَ السَنى فيهِ وَالسَناءُ",9,"ا",2,0],["أَيّ هِلالٍ خَبا وَقَد بَزَغا","وَأَيُّ سَيفٍ نَبا وَقَد نَبَغا",10,"غ",2,1],["إيهِ \" لُبنانُ \" ، والحديثُ شجونٌ","هل يُطيقُ البيانُ دَفعاً لما بي ؟",11,"ب",2,0],["آية للدوا وللداء جاءت","تلك حقاً من أعجب الآيات",12,"ت",1,0],["آيةٌ للعُجْبِ ما تبدعهُ","من تلاوين لها مُستنكرة",13,"ر",2,0],["آيَةً لِلنَّاسِ كَانَت","لِشَقِيٍّ أَو سَعِيدس",14,"د",2,0],["أيهلك الشاعر","أخطأت يا ميسيّه",15,"ه",1,0],["إيهِ لا كانَ سامعٌ لم يؤمِّن","إِن دَعَوتُ الإِلهَ أن يُبقيكِ",16,"ك",1,0],["أَيُّ هِلاَلٍ فِي قَضِيبِ النَّقَا","أَضَاءَهُ الدَّيْجُورُ مِنْ لَمَّتِهِ",17,"ت",2,0],["أيةٌ لم تكن لموسى بن عمرا","ن ولا غيره من الأنبياء",18,"ا",2,0],["ايه ليلى هل تذكرين الليالي","حين كنا نسير في البستان",19,"ن",1,0],["أي هلال من عامرٍ","أي غزالٍ طاب فيه الغزال",20,"ل",1,0],["آيةٌ للقهار دلَّ عليها","يا وليُّ المعقول والمنقول",21,"ل",1,0],["إيه لامارتين إنَّا أمة","كاد يرديها وفاء الخلصاء",22,"ا",2,0],["أَيُّ هِلالٍ كُسِفا","وَأَيُّ غُصنٍ قُصِفا",23,"ف",2,1],["إيهِ للَه سعيُكنّ جميلا","يا بناتِ الأنجاب والمنجِبات",24,"ت",1,0],["آيةٌ للرّسول تبقَى وكم مِنْ","آيةٍ للرّسول ذاتِ اتّصال",25,"ل",1,0],["إيه لقد أبدت الأيام سر مُنى","طالت عليه الليالي في تماديها",26,"ي",3,0],["آية لَم يَصل لَها الفكر كنها","مثل رُوح الإِنسان إِن لَم يَكنها",27,"ه",2,0],["أَيُهلِكُني شَيبانُ في كُلِّ لَيلَةٍ","لِقَلبِيَ مِن خَوفِ الفِراقِ وَجيبُ",28,"ب",1,1],["إيه لبنان كم بكيت وتبكي","بين عهدٍ مضيء وعهدٍ جديد",29,"د",1,0],["إِيه لظلٍّ اله يستظل به","ويستضاء بديجور المهمات",30,"ت",1,0],["ايه لي قلب يصبر ولي أماني كثير","ولي هقاوي بنفسي تهت بحسابها",31,"ب",3,1],["ايه لي قلب عانا منك شيٍ كثير","ولك بحقي خطايا تهت بحسابها",31,"ب",3,0],["إيه لبنان ما دهاك وقد كن","ت الزمان الذي يُخافُ دهاه",32,"ا",2,0],["آيةٌ للزمان جاءت الى النا","س فحارت بشأنها الأفكار",33,"ر",1,0],["ايه لبغداد كم مرت بداهية","كل القيامات تدنوها وتنطبق",34,"ق",1,0],["‏آيَةٌ لِلنَّاسِ فَاُنْظُرْ كَمْ تَرَى؟","‏ فِي ثَرَاهَا مِنْ كَرِيمٍ قَدْ هَلَكْ",35,"ك",1,0],["إيه..لو كفي تصافحها المنيه","مايغير بالدهر والناس فوتي",36,"ت",2,0],["إيهِ لن تُخْمِدَ المجازرُ بركا","ناً يُلاقي بطشَ الغزاة بِلابِهْ",37,"ب",2,0],["ايهٍ لزائرتي تشعُّ بنورِها","لِألائها شمسُ الضحى وضّاحُ",38,"ح",1,0],["أَيُّ هِلالٍ في قَضيبِ نَقى","أَضاءَهُ الدَيجورُ مِن لِمَّتِهِ",39,"ت",2,0],["إيْهِ لَسْنَا فِيْ هَذِهِ الأَرْضِ إِلاَّ","مِثْلَ مَنْ هَدَّهُمْ زَمَانٌ وَأَفْنَى",40,"ن",2,0],["إِيْهِ \" لَكْنُو \" فَكَمْ ضَمَمْتِ نَديًّا","مِنْ شُيُوخٍ وَمِنْ شَبابٍ نَجيْدِ",41,"د",1,0]]}