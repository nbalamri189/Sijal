{"poems":[[53,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[53,"قد عجلت لي عقوبة الخور","https://www.aldiwan.net/poem63996.html","المنسرح"],[53,"صد عن الأطلال لما استيأسا","https://www.aldiwan.net/poem64645.html","الرجز"],[53,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[46,"لطمحت في الإبراق والإرعاد","https://www.aldiwan.net/poem30535.html","الكامل"],[52,"لله سلمى حبها ناصب","https://www.aldiwan.net/poem64840.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85627","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85372","الكامل"],[53,"بدرٌ وشمس وَلَدَا كوكبا","https://www.poetsgate.com/ViewPoem.aspx?id=27044",""],[33,"زارنا زورٌ سررتُ به،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18996&r=&rc=259",""],[119,"بلذة العيش عش يا خالي البال","https://www.aldiwan.net/poem40629.html","عموديه"],[164,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[242,"حلت حلى حسن الحلى زيدان","https://www.aldiwan.net/poem19294.html","الكامل"],[302,"لا تحسبن فرند صارمه به","https://www.aldiwan.net/poem32990.html","الكامل"],[325,"هذا ضريح أخي المحامد والتقى","https://www.aldiwan.net/poem61617.html","الكامل"],[563,"صدق الكتاب لمن به يتمسك","https://www.aldiwan.net/poem34273.html","الكامل"],[563,"إني أنا بك يا ودود","https://www.aldiwan.net/poem34580.html","مجزوء الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138195",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138261",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37984","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37861","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62469","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96726","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80055","الخفيف"],[1876,"","https://poetry.dctabudhabi.ae/diwan/poem/104466","الرجز"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104790","الكامل"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42442","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27843","المجتث"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109449","الطويل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/83049","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137549",""],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100483","الكامل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134202","الكامل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112686","الرجز"],[3386,"","https://poetry.dctabudhabi.ae/diwan/poem/124616","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86294","المتدارك"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86278","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85189","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114549","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94448","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83168","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57956","الوافر"],[4884,"(أَفَأَمِنُوا مَكْرَ اللَّهِ ...)","https://www.poetsgate.com/ViewPoem.aspx?id=201762",""],[119,"بلذة العيش عش يا خالي البال","https://www.poetsgate.com/ViewPoem.aspx?id=60289",""],[592,"جاس بن جرجيس بغياً من شقارته","https://www.poetsgate.com/ViewPoem.aspx?id=128821",""],[5759,"سنظلُّ نبكي","https://www.poetsgate.com/ViewPoem.aspx?id=212934",""],[5829,"تلك الفتاة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=190585",""]],"verses":[["بل ذاك فألٌ ضامنٌ سبعةً","مثل الصقور استشرفت أرنبا",0,"ب",2,0],["بل ذاك حظي فلست أحسبُهُ","عليك شكراً يا شرّ مختبرِ",1,"ر",1,0],["بَل ذو الحِجى لا يَستحير أخْرَسا","إلا إذا اسْتَجْهله فرطُ الأسى",2,"س",2,0],["بل ذا وذاك وإن وُهبتَ لأمةٍ","تعفو فضولَكَ بكرةً وأصيلا",3,"ل",2,0],["بَل ذِكرَةٌ طَرَقَت فَلَمّا لَم أَبِت","باتَت تُفَكِّرُ في ضُروبِ رُقادي",4,"د",2,0],["بَل ذَكَّرَتني ريحُ رَيحانَةٍ","وَمُدهُنٌ جاءَ بِهِ عاقِبُ",5,"ب",1,0],["بل ذم نفسك إِنَّها هي قصرت","في الأخذ بالأسباب حتى بارا",6,"ر",2,0],["بَل ذرة عصفت بها","هوج الرياح الذاريات",7,"ت",1,0],["بل ذاك فألٌ صامنٌ سبعة ً","مثل الصقور استشرفت أرنبا",8,"ب",2,0],["بِکلَّذِي أُخْفي وأَكْتُمُهُ","من جميعِ الناسِ لم أقبل",9,"ل",1,0],["بلذة العيش عش يا خالي البال","لا ذقت غصة اشواقي وبليالي",10,"ل",2,1],["بل ذم فعلهم حتى يحذرنا","من أن نشاركهم في موجب الغضب",11,"ب",1,0],["بل ذمهم حيث صار اللعب عندهم","مثل الصلوة وعدوه من القرب",11,"ب",1,0],["بَلْ ذَاكَ عِنْدِي حَيْثُ لاَ جَزَعٌ يُرَى","أَخْنَى مِنَ الْهَذَيَانِ مِنْ نَشْوَانِ",12,"ن",1,0],["بل ذاكَ غَيلُ الماءِ أَزعجه الَّذي","كَسَر النَدى فجرى به مُتكسِّرا",13,"ر",2,0],["بَل ذا مَقامِ الجودِ وَالإِحسانِ وَال","فَضلِ العَميمِ إِلى الأَحِبَّةِ العِدى",14,"د",2,0],["بل ذاك قرآن مجيد جاء في","لوح هو المحفوظ عمن يشرك",15,"ك",1,0],["بل ذاك قرآن مجي","د وهو في لوح الورود",16,"د",1,0],["بل ذي عروس الكون أجمعه لها","أهدي أبوها النيل خير رداء",17,"ا",2,0],["بل ذي رياض للعقول تنوعت","أشكالها الغناء ليست واحدا",18,"د",2,0],["بَل ذا أَبو النّصرِ مَولى الفتحِ ناظِمها","مُبارَكُ الاِسمِ وَالأوصافِ مَيمونُ",19,"ن",1,0],["بَل ذاكَ غايَةُ المَقصودِ","ولا يزال الدهرَ في وُجودُ",20,"د",1,0],["بل ذاك أمر ساقه المولى على","من لم يخفه فصار وعظا كالمثلْ",21,"ل",1,0],["بَل ذاكَ وجهُ أميم لاحَ فخلتهُ","مِن تحتِ برقعها كبدر تمامِ",22,"م",1,0],["بل ذكاء الهُدى وأقسمُ حقًّا","بنهارٍ للفضل منك تجلَّى",23,"ل",2,0],["بل ذهب الأكف في تخميني","وما حفظت ما حوى يميني",24,"ي",1,0],["بَل ذَاكَ دِيوانٌ يُنادِى حالُهُ","قَد عَزَّ أن تَجِدُوا لَهُ أشباها",25,"ا",3,0],["بَل ذَا فَريدٌ مالَهُ كَمُمَاثِلٍ","وَعَرُوسُ خِدرٍ أُعدِمَت أكفَاها",25,"ا",3,0],["بل ذاكَ قلبي الذي شاعتْ سماحتُه","وافى يحلُّ بنودَ الوزرِ من عنقِه",26,"ه",1,0],["بل ذاك نورٌ مبينٌ","كنورِ بدرٍ وشمسِ",27,"س",1,0],["بلذة ملقاه أعيش وأنتشي","ومن فرط إدهاشي أظن العشا ظهرا",28,"ر",2,0],["بَل ذَا كَنَفي قِيَامِهِ بِالنَّفسِ أو","بالغَيرِ فِي الفِطرَاتِ وَالأذهَانِ",29,"ن",1,0],["بَل ذَاكَ يُوجَدُ دُونَ هَذَا مُفرَداً","وَالعَكسُ أيضاً ثُمَّ يَجتَمِعَانِ",29,"ن",1,0],["بل ذللت القطوف فكيف ما","شئت انتزعت بأسهل الامكان",29,"ن",1,0],["بل ذو التَّفضُّلِ والمرو","ءةِ والعفافِ هو الأَديب",30,"ب",1,0],["بل ذي سبائك عسجد قد صاغها","مولى سما أعلا علا الدرجات",31,"ت",1,0],["بل ذكره وردي نهاري كله","وتهجدي في الليلة الليلاء",32,"ا",2,0],["بل ذاك فضل الله قد أوتيته","نعم السمو لارفع الدرجات",33,"ت",1,0],["بل ذلّلَ النفسَ لعِزّ الدينِ","وما انطوى في علمه المكنون",34,"ن",1,0],["بل ذاك يقصر عن أدنى بحوركم","وزن القرى بموج جار بالسفن",35,"ن",1,0],["بَل ذاكَ بِعِلم تحرزُه","فيهِ تُغنى عَن فَخر أَب",36,"ب",1,0],["بَل ذاكَ في دُنياهُ شبه مُسافِرٍ","عَما قَليل عن حماها يَبعُدُ",37,"د",1,0],["بل ذاك مطبوع من الجدود","كما انطباع الورد في خدودي",38,"ي",1,0],["بل ذكرهُ عينُ ذكرِ اللَهِ لا تكُ في","ذِكرٍ له وله بالغافل الناسي",39,"س",2,0],["بلذيذ الهجوع ذا الحين نهنا","فأنا لم أغمض لعيني جفنا",40,"ن",2,0],["بل ذي جنان إلى الأَجنان مُنعشةٌ","وَسُرُّ كل جنانٍ قُلتُ مجناها",41,"ا",3,0],["بَل ذاكَ نَبعٌ بِالعَواطِفِ زاخِرٌ","يُزهى بِصَفحَتِه وَيُغري الوارِدا",42,"د",2,0],["بلذاتٍ تزيد بلا انقطاع","وتسليمِ الملائك بالهناء",43,"ا",2,0],["بل ذاك سُمٌّ نَاقِعٌ مُتَرَبِّصٌ","موتاً زُعَافاً في الخُطُوبِ من الرُّماهْ",44,"ا",2,0],["بلذة العيش عش يا خالي البال","لا ذقت غصة اشواقي وبلبالي",45,"ل",2,1],["بل ذا بمشيمة الطبع التي غلظت","لم يبرح الوغد في مفسوسق الوطن",46,"ن",1,0],["بل ذُلُّهُ الذلُّ الُمهيُن وليتني","أرضيتُها بالذُلِّ كيما تَقنَعُ",47,"ع",1,0],["بل ذكر أيام الأحبة سلوتي","وترقب الأطياف ذاك عزاءُ",48,"ا",2,0]]}