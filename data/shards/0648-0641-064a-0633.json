tsgate.com/ViewPoem.aspx?id=213437",""],[460,"أَمِنْ حُبِّ سُعْدَى وتَذْكارِها","https://www.poetsgate.com/ViewPoem.aspx?id=22211",""],[5038,"الارض دامية","https://www.poetsgate.com/ViewPoem.aspx?id=189937",""],[5111,"سَفَرُ الْهَزِيعِ","https://www.poetsgate.com/ViewPoem.aspx?id=212112",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5193,"صقور سلاح الجو","https://www.poetsgate.com/ViewPoem.aspx?id=213567",""],[5206,"قلوب العارفين","https://www.poetsgate.com/ViewPoem.aspx?id=148342",""],[5208,"الرجعه","https://www.poetsgate.com/ViewPoem.aspx?id=176847",""],[5277,"شظفُ المنافي","https://www.poetsgate.com/ViewPoem.aspx?id=203512",""],[592,"رسائل أخوان الصفا والتودد","https://www.poetsgate.com/ViewPoem.aspx?id=128837",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""],[592,"تبصر نور الحق من كان يبصر","https://www.poetsgate.com/ViewPoem.aspx?id=128795",""],[5351,"هنا صنعاء هنا صعدة","https://www.poetsgate.com/ViewPoem.aspx?id=202119",""],[5414,"زيارة فوق العادة للخيول العربية","https://www.poetsgate.com/ViewPoem.aspx?id=12930",""],[5436,"بغداد .. يا مجد هارون ( علي محمد السليم )","https://www.poetsgate.com/ViewPoem.aspx?id=46675",""],[5493,"أراكَ","https://www.poetsgate.com/ViewPoem.aspx?id=206413",""],[5653,"أربرب بالكثيب الفرد أم نشأ؟","https://www.poetsgate.com/ViewPoem.aspx?id=3011",""],[5674,"قيس وليلى","https://www.poetsgate.com/ViewPoem.aspx?id=189085",""],[5703,"هي الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=210885",""],[5953,"سئمت المقام بأرض الشّام","https://www.poetsgate.com/ViewPoem.aspx?id=93800",""],[6066,"حَفْلُ تَخَرُّجِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=12666",""],[6070,"أرى شيئاً يطلُّ مِنَ المَرايا","https://www.poetsgate.com/ViewPoem.aspx?id=191613",""],[6148,"في رحاب الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=201654",""],[6152,"أيوب الصديق","https://www.poetsgate.com/ViewPoem.aspx?id=204247",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""],[6285,"أغنيات على أبواب القدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86824&r=&rc=17",""],[2220,"وَزَاحَمَني عندَ استِلامي أوانِسٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19266&r=&rc=808",""],[6344,"سؤالٌ خارج حدود النُّبوءة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87961&r=&rc=1",""]],"verses":[["وَفي سَرَعانِ الريحِ لي لَو عَلِمتُما","شِفاءٌ وَلَو أَنَّ النَسيمَ عَليلُ",0,"ل",1,0],["وَفِي سَاحَتِي مَسْعىً لِطَالِبِ رَحْمَةٍ","وَمَأَمَنُ مُرْتَاعِ وَمَوْقِفُ تَائِبِ",1,"ب",1,0],["وَفي سَبَإٍ هَل كانَ عِزٌّ كَعِزِّهِم","لَهُم حَسَبٌ مَحضٌ لُبابٌ وَجَوهَرُ",2,"ر",1,0],["وفي سواكم كساد كاسدها","وفي ذراكم نفاق نافقها",3,"ق",3,0],["وَفي سوقِ الغَرامِ عَرَضتُ نَفسي","رَخيصاً لَم أَجِد مَن يَشتَريها",4,"ي",3,0],["وفي سرعانِ الخيل رائِدُ نُصْرةٍ","له موطِيٌء أينَ استرادَ عَشيبُ",5,"ب",1,0],["وَفي سَنَةٍ قَد طالَعَتكَ سُعودُها","وَقابَلَكَ النَيروزُ وَهوَ بَشيرُها",6,"ر",3,0],["وَفي سَرَعانِ الخَيلِ يُمنُ وِزارَتي","أَبِيٍّ يُحامي عَن حَريمي وَيَدفَعُ",7,"ع",1,0],["وَفي سَنَةٍ رَمَت مُتَجَبِّريهِم","عَلى قَدَرٍ بِداهِيَةٍ عَوانِ",8,"ن",1,0],["وفي سوادِ ليلِها نهارُها","كروضةٍ مختلطٍ نُوَّارُها",9,"ر",3,0],["وفي سبيل الزاد والمأكل","نملأ صدر الأرض إعوالا",10,"ل",2,0],["وَفي سَنَةٍ قَد أَنفَدَ الدَهرُ عُظمَها","فَلَم يُرجَ مِنها مُفرَجٌ دونَ قابِلِ",11,"ل",1,0],["وَفي سِلاحِ بَطَلٍ كَمِيِّ","أَشوَسَ أَبّاءٍ عَلى الأَبِيِّ",12,"ي",1,0],["وفي سكرةٍ منها ولَوْ عُمْرُ ساعةٍ","تَرَى الدَّهْرَ عبداً طائعاً ولك الحُكْم",13,"م",1,0],["وفي سبيله قضى رجال","من أن يلاقوا تستحي الآجال",14,"ل",1,0],["وَفِي سِيَرِ الغُرِّ المَيَامِين كَمْ جَلَتْ","لَنَا المثُلُ العُلْيَا مَنَائِرَ لِلهُدَى",15,"د",2,0],["وفي سَرقسطةٍ لك دارُ مُلْكٍ","زَريتَ بها على ذاتِ العِمادِ",16,"د",1,0],["وفي سَرائرِ هِمَّات الورى هِمَمٌ","عن دركها عجزت جنٌّ وأملاك",17,"ك",1,0],["وفي سدرة الاجلال تجلا بدولة","واحتاج فيها للغني والتركض",18,"ض",1,0],["وفي سدة التصريف في سدرة العلا","أخذت مقراً من مقام العلا أسمى",19,"م",2,0],["وفي سورة الإخلاص فيها فضيلة","ومنقبة مشهورة وتوسّل",20,"ل",1,0],["وَفي سُليمٍ لَنا عِزٌّ وَمُفتخَرٌ","وَمُفلِحٌ وَهُما لِلّهِ دَرُّهُما",21,"م",2,0],["وفي سلمه بحر من الجود وافرٌ","وفي حربه سم من الموت نافع",22,"ع",1,0],["وَفي سُبُلِ الحَقِّ يَأتَلِفون","وَيَعتَنِقون الحِجى وَحدَه",23,"د",2,0],["وَفي سَقامٍ ما لَهُ مِن عائِدٍ","فيكَ وَلَيلٍ ما لَهُ مِن آخِرِ",24,"ر",1,0],["وفي ساح الوغى يوم التلاقي","تفرّ كأنها زُمر الأضاحي",25,"ح",2,0],["وفي سواه لا يكون مقصدُ","كفعل قومٍ في المسير أُقعدوا",26,"د",3,0],["وَفِي سُوقِ أَربَابِ البَلاغَة وَالنُّهى","سَمِين وَغَث منتَقَى العندِي",27,"د",2,0],["وَفي سَحقِ ابن إسحاق اعْتِبار","ومَا أفْضَى إِلَيهِ مِن الثبورِ",28,"ر",1,0],["وفي سائر الأقطار من أهل ديننا","وذلك فضل من كريم وقادر",29,"ر",1,0],["وَفي سِواها حَباهُ اللَهُ مَكرُمَةً","كُلُّ التَمَتُّعِ وَاِستَصفاهُ رِضوانِ",30,"ن",1,0],["وَفي سُجودي لِمِثالِ حُسنِها","قَد غادَرَت لي في الضَميرِ مَسجِدا",31,"د",2,0],["وَفي سَحابي ماءٌ","هامَ وَثَلجٌ وَوَدقُ",32,"ق",1,0],["وَفي سَما اليمنِ مِصباح السُرور بَدا","حَتّى اِستَنار سنا إشراقه وأضا",33,"ض",2,0],["وَفي سوحه طير السُرور مغرّد","وَأَنعم بِبَيت لَيسَ فيه حَزين",34,"ن",1,0],["وفي سفح كحلان غدا قبر جدنا","وزُوَّارُه فيه تروح وتغتدي",35,"د",2,0],["وفي سُقمِهمْ إنْ هُمُ أنكرُوا","صبابَتَهُم شَرحُها المُجملُ",36,"ل",1,0],["وفي سواد القلب كنت جاعلاً","وداده حتَّى بدا لي ما بدا",37,"ا",1,0],["وفي سبيلِ السّماحِ مكرُمَةً","نَزَلْتَ منها بمُلتَقَى السُّبُلِ",38,"ل",1,0],["وَفِي سُرَّ مَنْ رَا من مَحَلِّي مَقاصِرُ","تُلاعِبُ فِيهِنَّ الظِّباءَ الجآذِرُ",39,"ر",1,1],["وفِي سِرِّ علمِ اللهِ لِي فيكَ أَنَّني","ودادُكَ لي سِرٌّ وحمدُكَ لي جَهْرُ",40,"ر",1,0],["وَفِي سبيلِكَ خاض البحرَ مقتحِماً","سُبْلَ الجهادِ إِلَى غاياتِ أَجْهَدِهِ",41,"د",2,0],["وفي سدَّةِ التصريف عزمٌ مؤَيَّدٌ","وفي سدرة السرِّ اللطيف موائدُ",42,"د",1,0],["وفي سبيل العالمين ربربٌ","آنسني من وحشة نفاره",43,"ر",2,0],["وفي سُرى الجوِّ أَصلُ نبعتهِ","أَين يظنُّونَ فرعَه باسِقْ",44,"ق",1,0],["وفي سورة الأنعام أوضح حجة","وأقطعها حقاً لكل مخاصم",45,"م",1,0],["وَفي ساحَةٍ بَينَ الحطيمِ وزمزمٍ","مَعاهدُ لذَّاتٍ مشاهدُ زينةِ",46,"ه",1,0],["وَفي سَلخِ شَعبانٍ لَدَيكَ كِفايَةٌ","عَنِ الصَّومِ والإدلاجِ في رَمَضانِ",47,"ن",1,0],["وفي سيرة الإمكان سر تمكني","تفقدتني في الفقد حتى وجدتني",48,"ي",1,0],["وفي سورة الإخلاص صورة سورتي","لقد فئت عن ظل الظلال وفيئه",48,"ه",1,0],["وفي سكرتي صحو يصحح سكرتي","إذا كان في التكوين كون تمكني",48,"ي",1,0],["وفي سرك المعجوز عنه حقيقة","تقول بقول اللَه إن خرس النطق",49,"ق",1,0],["وَفي سفري لَم أَلقَ لي مِن مؤانِسٍ","سِوى الكُتبِ أَجلو الهَمَّ مِنها بأَسفارِ",50,"ر",1,0],["وفي سَناهُ ومَسْناهُ ونائِلِهِ","للشُّهْبِ والسُّحْبِ مُسْتَحْياً ومُنْضَنَأُ",51,"ا",1,0],["وَفي سَما خَدِّهِ لاحا كَأَنَّهُما","لَمّا أَنِ اِئتَلَفا في الحسنِ قَوسُ قُزَح",52,"ح",1,0],["وَفي سَماء الكبر وَالكُفر سَما","وَقَد غَوى حَواء ثُمَ آدما",53,"م",2,0],["وفي سرورٍ وفي أمنٍ وعافيةٍ","وفي أمانٍ وعيشٍ طيبٍ رَغَد",54,"د",1,0],["وفي سفح تيماء وادٍ أغن","ينبت نوراً ويثمر حورا",55,"ر",2,0],["وَفي سَيبه لِلمُجتَدينَ عِمارَةٌ","وَفي سَيفِهِ لِلدّينِ عِزٌّ وَناصِرُ",56,"ر",1,0],["وفي ساحة البلوى أضاف جموعهم","بعامل خفض فعله ليس يحزم",57,"م",1,0],["وفي سراقة إذ ساخ الجواد به","سر لطيف به الرحمن نجاه",58,"ا",2,0],["وفي سواقة إذ ساح الجواد به","هدي لباغي نجاة وهو موصول",59,"ل",1,0],["وفي ساحة البلوى أضاف جموعهم","فعامل خفض فعله ليس يجزم",60,"م",1,0],["وفي سراقة إذ ساخ الجواد به","إظهار سلم ولولاه لما سلما",61,"م",2,0],["وفي سوى منزله ما ترى","لذى كمال أبدا من قرار",62,"ر",1,0],["وَفي سَما وَجهِهِ الهادي بِرَونَقِهِ","صُبحُ الرَجاءِ إِلى الأَفكارِ مُنبَلِجُ",63,"ج",1,0],["وفي سر معنى الذوق كم من عجيبة","يترجم عنها القلب والروح كالسر",64,"ر",1,0],["وفي ساحة التقوى فطنب وشمرن","لساقك واكثر صاح من طيب الزرع",65,"ع",1,0],["وفي سوح الحبيب على جمال","أنل قربا واحسن بالوصال",66,"ل",1,0],["وفي ساحة الميدان اثواب سندس","لها بهجة تجلوالعيون ورونق",67,"ق",1,0],["وفي سوى الماضي كماض يعملُ","وكان إن زادت فلفظ مهمل",68,"ل",1,0],["وفي سألت الله في التعليم","تقول منصوب على التعظيم",68,"م",1,0],["وفي سِنانِ عاملهِ","حَتف بكفّ حاملِهْ",69,"ه",1,0],["وفي سجننا اب