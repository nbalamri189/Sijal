{"poems":[[53,"خليلي هل لي لو ظفرت بنية","https://www.aldiwan.net/poem29881.html","الطويل"],[77,"أأبصرت مني في المصانع قبة","https://www.aldiwan.net/poem36774.html","الطويل"],[23,"كبرت كذاك المرء ما عاش يكبر","https://www.aldiwan.net/poem21567.html","الطويل"],[51,"يا نجدة الروم في بطارقها","https://www.aldiwan.net/poem65502.html","المنسرح"],[70,"كتبت إليك أشرح في كتابي","https://www.aldiwan.net/poem42414.html","الوافر"],[62,"نصيحكما فيما يقول مريب","https://www.aldiwan.net/poem52505.html","الطويل"],[45,"نصب إلى طيب العراق وحسنها","https://www.aldiwan.net/poem63591.html","الطويل"],[45,"أحاجيك هل للحب كالدار تجمع","https://www.aldiwan.net/poem64680.html","الطويل"],[45,"أمير المؤمنين لقد سكنا","https://www.aldiwan.net/poem66797.html","البسيط"],[61,"وفتية تعلو بها أخطارها","https://www.aldiwan.net/poem51622.html","الرجز"],[97,"جلست يوما حين حل المساء","https://www.aldiwan.net/poem24794.html","السريع"],[44,"غدا الملك معمور الحمى والمنازل","https://www.aldiwan.net/poem30375.html","الطويل"],[52,"يا رب جاري نهر فضي","https://www.aldiwan.net/poem26566.html","الرجز"],[68,"شربنا على ذكر الحبيب مدامة","https://www.aldiwan.net/poem1525.html",""],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202530","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54747","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43880","الوافر"],[58,"العَجْزُ عَنْ دَرَكِ الإِدْرَاكِ إدْرَاكُ","https://www.poetsgate.com/ViewPoem.aspx?id=22721",""],[116,"اطل مدة الهجر ان ما شئت وارفض","https://www.aldiwan.net/poem40918.html","عموديه"],[116,"كشفت حجاب الطمس عن حيطة الأسما","https://www.aldiwan.net/poem41777.html","الطويل"],[151,"زمان بتطهير القلوب موكل","https://www.aldiwan.net/poem68523.html","الطويل"],[170,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[211,"لعلياك في أفق الكمال مطالع","https://www.aldiwan.net/poem13464.html","الطويل"],[224,"لقد بلغت بهم الحده","https://www.aldiwan.net/poem41900.html","المتقارب"],[236,"هل أنت يا أخت القضيب الناضر","https://www.aldiwan.net/poem31983.html","الرجز"],[252,"رُبى لبنان","https://www.aldiwan.net/poem39738.html","عموديه"],[260,"نحمد مولانا الذي قد اصطفى","https://www.aldiwan.net/poem35821.html","الرجز"],[276,"ولا ودعوا يوم النوى جارة الحمى","https://www.aldiwan.net/poem25412.html","الطويل"],[276,"أعد نظرا إلى الزمن النضير","https://www.aldiwan.net/poem25566.html","الوافر"],[305,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[321,"الملك لله جل القرد والشان","https://www.aldiwan.net/poem61619.html","البسيط"],[350,"لولا سنى ربة الخدر بدا","https://www.aldiwan.net/poem15643.html","الرجز"],[350,"الحق في الخلق خلق","https://www.aldiwan.net/poem15803.html","المجتث"],[354,"زال العنا بتباشير المنى ومضى","https://www.aldiwan.net/poem40155.html","البسيط"],[362,"مكان باعلى الفرقدين مكين","https://www.aldiwan.net/poem68046.html","الطويل"],[404,"بذكرك يا رب الخلائق أبتدي","https://www.aldiwan.net/poem33942.html","الطويل"],[410,"أما في الهوى حاكم يعدل","https://www.aldiwan.net/poem32553.html","المتقارب"],[417,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[433,"يا ملكا وهو بالتقى ملك","https://www.aldiwan.net/poem12362.html","المنسرح"],[440,"وفي سر من را من محلي مقاصر","https://www.aldiwan.net/poem34758.html","الطويل"],[440,"سماء العلا منكم وأنت لها بدر","https://www.aldiwan.net/poem34843.html","الطويل"],[440,"الآن رد عنان الملك في يده","https://www.aldiwan.net/poem34858.html","البسيط"],[501,"تدوس بساط الله والقلب فاقد","https://www.aldiwan.net/poem37566.html","الطويل"],[516,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[576,"راح رسولي وجاءني عاشق","https://www.aldiwan.net/poem3045.html","المنسرح"],[588,"بعزك يا ذا الكبرياء والمراحم","https://www.aldiwan.net/poem11517.html","عموديه"]],"verses":[["وَفي سَرَعانِ الريحِ لي لَو عَلِمتُما","شِفاءٌ وَلَو أَنَّ النَسيمَ عَليلُ",0,"ل",1,0],["وَفِي سَاحَتِي مَسْعىً لِطَالِبِ رَحْمَةٍ","وَمَأَمَنُ مُرْتَاعِ وَمَوْقِفُ تَائِبِ",1,"ب",1,0],["وَفي سَبَإٍ هَل كانَ عِزٌّ كَعِزِّهِم","لَهُم حَسَبٌ مَحضٌ لُبابٌ وَجَوهَرُ",2,"ر",1,0],["وفي سواكم كساد كاسدها","وفي ذراكم نفاق نافقها",3,"ق",3,0],["وَفي سوقِ الغَرامِ عَرَضتُ نَفسي","رَخيصاً لَم أَجِد مَن يَشتَريها",4,"ي",3,0],["وفي سرعانِ الخيل رائِدُ نُصْرةٍ","له موطِيٌء أينَ استرادَ عَشيبُ",5,"ب",1,0],["وَفي سَنَةٍ قَد طالَعَتكَ سُعودُها","وَقابَلَكَ النَيروزُ وَهوَ بَشيرُها",6,"ر",3,0],["وَفي سَرَعانِ الخَيلِ يُمنُ وِزارَتي","أَبِيٍّ يُحامي عَن حَريمي وَيَدفَعُ",7,"ع",1,0],["وَفي سَنَةٍ رَمَت مُتَجَبِّريهِم","عَلى قَدَرٍ بِداهِيَةٍ عَوانِ",8,"ن",1,0],["وفي سوادِ ليلِها نهارُها","كروضةٍ مختلطٍ نُوَّارُها",9,"ر",3,0],["وفي سبيل الزاد والمأكل","نملأ صدر الأرض إعوالا",10,"ل",2,0],["وَفي سَنَةٍ قَد أَنفَدَ الدَهرُ عُظمَها","فَلَم يُرجَ مِنها مُفرَجٌ دونَ قابِلِ",11,"ل",1,0],["وَفي سِلاحِ بَطَلٍ كَمِيِّ","أَشوَسَ أَبّاءٍ عَلى الأَبِيِّ",12,"ي",1,0],["وفي سكرةٍ منها ولَوْ عُمْرُ ساعةٍ","تَرَى الدَّهْرَ عبداً طائعاً ولك الحُكْم",13,"م",1,0],["وفي سبيله قضى رجال","من أن يلاقوا تستحي الآجال",14,"ل",1,0],["وَفِي سِيَرِ الغُرِّ المَيَامِين كَمْ جَلَتْ","لَنَا المثُلُ العُلْيَا مَنَائِرَ لِلهُدَى",15,"د",2,0],["وفي سَرقسطةٍ لك دارُ مُلْكٍ","زَريتَ بها على ذاتِ العِمادِ",16,"د",1,0],["وفي سَرائرِ هِمَّات الورى هِمَمٌ","عن دركها عجزت جنٌّ وأملاك",17,"ك",1,0],["وفي سدرة الاجلال تجلا بدولة","واحتاج فيها للغني والتركض",18,"ض",1,0],["وفي سدة التصريف في سدرة العلا","أخذت مقراً من مقام العلا أسمى",19,"م",2,0],["وفي سورة الإخلاص فيها فضيلة","ومنقبة مشهورة وتوسّل",20,"ل",1,0],["وَفي سُليمٍ لَنا عِزٌّ وَمُفتخَرٌ","وَمُفلِحٌ وَهُما لِلّهِ دَرُّهُما",21,"م",2,0],["وفي سلمه بحر من الجود وافرٌ","وفي حربه سم من الموت نافع",22,"ع",1,0],["وَفي سُبُلِ الحَقِّ يَأتَلِفون","وَيَعتَنِقون الحِجى وَحدَه",23,"د",2,0],["وَفي سَقامٍ ما لَهُ مِن عائِدٍ","فيكَ وَلَيلٍ ما لَهُ مِن آخِرِ",24,"ر",1,0],["وفي ساح الوغى يوم التلاقي","تفرّ كأنها زُمر الأضاحي",25,"ح",2,0],["وفي سواه لا يكون مقصدُ","كفعل قومٍ في المسير أُقعدوا",26,"د",3,0],["وَفِي سُوقِ أَربَابِ البَلاغَة وَالنُّهى","سَمِين وَغَث منتَقَى العندِي",27,"د",2,0],["وَفي سَحقِ ابن إسحاق اعْتِبار","ومَا أفْضَى إِلَيهِ مِن الثبورِ",28,"ر",1,0],["وفي سائر الأقطار من أهل ديننا","وذلك فضل من كريم وقادر",29,"ر",1,0],["وَفي سِواها حَباهُ اللَهُ مَكرُمَةً","كُلُّ التَمَتُّعِ وَاِستَصفاهُ رِضوانِ",30,"ن",1,0],["وَفي سُجودي لِمِثالِ حُسنِها","قَد غادَرَت لي في الضَميرِ مَسجِدا",31,"د",2,0],["وَفي سَحابي ماءٌ","هامَ وَثَلجٌ وَوَدقُ",32,"ق",1,0],["وَفي سَما اليمنِ مِصباح السُرور بَدا","حَتّى اِستَنار سنا إشراقه وأضا",33,"ض",2,0],["وَفي سوحه طير السُرور مغرّد","وَأَنعم بِبَيت لَيسَ فيه حَزين",34,"ن",1,0],["وفي سفح كحلان غدا قبر جدنا","وزُوَّارُه فيه تروح وتغتدي",35,"د",2,0],["وفي سُقمِهمْ إنْ هُمُ أنكرُوا","صبابَتَهُم شَرحُها المُجملُ",36,"ل",1,0],["وفي سواد القلب كنت جاعلاً","وداده حتَّى بدا لي ما بدا",37,"ا",1,0],["وفي سبيلِ السّماحِ مكرُمَةً","نَزَلْتَ منها بمُلتَقَى السُّبُلِ",38,"ل",1,0],["وَفِي سُرَّ مَنْ رَا من مَحَلِّي مَقاصِرُ","تُلاعِبُ فِيهِنَّ الظِّباءَ الجآذِرُ",39,"ر",1,1],["وفِي سِرِّ علمِ اللهِ لِي فيكَ أَنَّني","ودادُكَ لي سِرٌّ وحمدُكَ لي جَهْرُ",40,"ر",1,0],["وَفِي سبيلِكَ خاض البحرَ مقتحِماً","سُبْلَ الجهادِ إِلَى غاياتِ أَجْهَدِهِ",41,"د",2,0],["وفي سدَّةِ التصريف عزمٌ مؤَيَّدٌ","وفي سدرة السرِّ اللطيف موائدُ",42,"د",1,0],["وفي سبيل العالمين ربربٌ","آنسني من وحشة نفاره",43,"ر",2,0],["وفي سُرى الجوِّ أَصلُ نبعتهِ","أَين يظنُّونَ فرعَه باسِقْ",44,"ق",1,0],["وفي سورة الأنعام أوضح حجة","وأقطعها حقاً لكل مخاصم",45,"م",1,0]]}