تراف","https://www.poetsgate.com/ViewPoem.aspx?id=188292",""],[5956,"إنَّ الصداقة تبدو في حقيقتها","https://www.poetsgate.com/ViewPoem.aspx?id=194173",""],[5956,"أحببتكم في الله مِن مَحْيايا","https://www.poetsgate.com/ViewPoem.aspx?id=197927",""],[6068,"لم أدر ما قد حلّ في شاني -08-","https://www.poetsgate.com/ViewPoem.aspx?id=175885",""],[199,"لمن المنازل أقفرت بغباء","https://www.poetsgate.com/ViewPoem.aspx?id=20779",""],[6125,"بل مُدني من غيم حبك إنني","https://www.poetsgate.com/ViewPoem.aspx?id=212878",""],[6127,"ظلمة واهمة","https://www.poetsgate.com/ViewPoem.aspx?id=188639",""],[6127,"صوت السماء","https://www.poetsgate.com/ViewPoem.aspx?id=215364",""],[454,"مدى كتابك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82673&r=&rc=37",""]],"verses":[["بَل مِن فِراقِ الَّتي في جَفنِها سَقَمٌ","قَد زادَني عِلَلاً مِنهُ عَلى عِلَلي",0,"ل",2,0],["بَل ما عَلَيكِ وَقَد مَحضتُ لَكِ الهَوى","في أَن أَفوزَ بِحُظوَةِ المِسواكِ",1,"ك",1,0],["بل من طوالع للسعود بعثتها","في كل موقعٍ شقوةٍ ترتاد",2,"د",1,0],["بَل مَا لِقَلبِكَ لا يَزَالُ كَأَنَّهُ","نَشوَانُ أَنهَلَهُ النَّدِيمُ وَعَلَّهُ",3,"ل",2,0],["بَل ما تَذَكَّرُ مِن نَوارَ وَقَد نَأَت","وَتَقَطَّعَت أَسبابُها وَرِمامُها",4,"م",3,0],["بلْ من الحقِّ أن تُنقِّر عنْهن","نَ وإلَّا فأنت كالبُعَداءِ",5,"ا",2,0],["بل من السِّر في ضمير مُحبٍّ","أدَّبتْهُ عقوبةُ الإفْشاءِ",5,"ا",2,0],["بل ما رضيتَ له بتركِك نصرَهُ","حتى نَعَبْتَ مع السَّفِيهِ نعيبَهُ",6,"ب",2,0],["بَلْ من يرى فضْلَ مسْكين على مَلكٍ","فلا يقولُ مقالاً غيْرَ محمودِ",7,"د",1,0],["بل ما رأى عِوَجاً فظلَّ يقيمُه","لكنْ بلاكَ أبو العلاء فأَحمدا",8,"د",2,0],["بل محقَّاً بعدل حكمك فامهد","لأخيه وزده فوق وسادِهْ",9,"د",2,0],["بل ما عهدتُك وارتيادُك بالغٌ","بك حيلةً يرتادها المرتادُ",10,"د",1,0],["بل من رحيق الجنان يقطَبُ بال","مسكِ سُلافاته بلا عَكَرِ",11,"ر",1,0],["بل من نجيع القلوب يمزج بال","عطف وصفو الوداد لا الكدرِ",11,"ر",1,0],["بل من شعاع العقول حين ترى ال","غيب بعين الذكاء والعبرِ",11,"ر",1,0],["بل مُوتغاً فيك دِيني أو تبشِّرَني","بُشْرى سمَيِّكَ كانت لابن جُرموز",12,"ز",1,0],["بل مِنَ الماءِ كلِّه فيك شوبٌ","ومن الناس كلهم لك رهطُ",13,"ط",1,0],["بل معشرٌ وعدتْهُمُ فجراتُهُمْ","بمغابطٍ فإذا هُمُ بمهابِط",14,"ط",1,0],["بل من بنات الملوك ناعمة","تنشر بالدلِّ ميِّت الشبق",15,"ق",1,0],["بل مَنْ علتْ رتبتُه ومَنْ نبل","لم يأتكُم من دُبرٍ ولا قُبل",16,"ل",1,0],["بل مَنْ علتْه دِرعُه ومن جَزُل","وما جِمالي للفراق بالذُّلل",16,"ل",1,0],["بل متى لم تكن تحبُّ وتهوى","من أماديح مادحيكَ الطوالا",17,"ل",2,0],["بل موسمٌ بل أمةٌ بل عالمٌ","بل عالمونَ وكل ذا فقليلُ",18,"ل",1,0],["بل ما عليك من المدائح أُحكِمتْ","أم هُلهلَت في وشي نفسك ترفُلُ",19,"ل",1,0],["بلْ ما أصابتني هناك شماتةٌ","لكنْ غُبِطْتُ بأنَّني لم ألطمِ",20,"م",1,0],["بلْ من ثلاثةِ أبوابٍ مُفتَّحةٍ","لِكُلِّ بابٍ نصيبٌ منه مقسومُ",21,"م",1,0],["بل منذ أُودع من أبيهِ وأمهِ","مستودعيه فكن لذلك فاطنا",22,"ن",2,0],["بِلَمعٍ كَطَرفِ العَينِ لَيسَت تُريثُهُ","وَرَكضٍ إِذا ما واكَلَ الرَكضَ ثائِبُ",23,"ب",1,0],["بَل مومِياتٌ عَلَيها","أَطالِس وَحَريرُ",24,"ر",1,0],["بَل ما تَذَكَّرُ مِن هِندٍ إِذا اِحتَجَبَت","بِاِبنَي عُوارٍ وَأَمسى دونَها بُلَعُ",25,"ع",1,0],["بَل ما يَضُرُّكِ لَو سَمَحتِ بِجَلوَةٍ","إِنَّ العَروسَ كَثيرَةُ المُتَطَلِّعِ",26,"ع",1,0],["بَل ما أَوَدُّ بِأَنَّني أَفرَقتُ مِن","وَجدي وَلا أَنّي بَرَدتُ غَليلي",27,"ل",2,0],["بَل مَتى العَقدُ مِن لِوائِكَ وَالرَق","قَةُ مَعقودَةٌ بِقِنَّسرينا",28,"ن",2,0],["بَل ما أَلومُ شَفيقاً أَن يُداخِلَهُ","وَجدٌ لِذَلِكَ وَالإِنسانِ إِنسانُ",29,"ن",1,0],["بَل ما يَسُرُّكَ مِلءَ الدارِ مِن ذَهَبٍ","وَأَنَّ ما كانَ يَومَ الدارِ لَم يَكُنِ",30,"ن",1,0],["بَل ما رَأَيتُ وَلا سَمِعتُ بِهِ","يَوماً كَيَومِ صَواحِبَ القَصرِ",31,"ر",1,1],["بَل ما رَأَيتَ ثَلاثَةً خَرَجوا","مِن مِثلِ مَخرَجِهِم عَلى الخَطرِ",32,"ر",1,0],["بل ما على السَّرْبِ إذ فاجاكَ لو عَطَفَتْ","ظِباؤُه لك أجياداً وأعطافا",33,"ف",2,0],["بل مرامي لحظةٌ أو لفظةٌ","مِنْ وليِّ اللهِ مِنْ قبلِ الأجلْ",34,"ل",1,0],["بَل ما نَسيتُ بِبَطنِ الخَيفِ مَوقِفَها","وَمَوقِفي وَكِلانا ثَمَّ ذو شَجَنِ",35,"ن",1,0],["بَل ما قَرَأتُ كِتاباً مِنكِ يَبلُغُني","إِلّا تَرَقرَقَ ماءُ العَينِ أَو دَمَعا",36,"ع",2,0],["بَل مَهمَهٌ عافي المَناهِلِ قائِمٌ","قَطَّعتُهُ بِمَواعِسٍ مَعّاجِ",37,"ج",1,0],["بل ما لهذا البرق صِلاًّ مُطْرِقاً","ولأيّ شمْلِ الشائمين أُتيحا",38,"ح",2,0],["بَل مِل إِلى الصيدِ مِن أَشاعِثِها","وَالسادَةِ الغُرِّ مِن مَهالِبِها",39,"ب",3,0],["بَل ما أَظُنُّ المُعَنّى","إِلّا اِمرَأً آخاكا",40,"ك",2,0],["بل مَن يطيلُ ادّكاري","وحرقتي وانتحاري",41,"ر",2,0],["بَل ما بُكاءُ الشَيخِ في دِمنَةٍ","وَقَد عَلاهُ الوَضَحُ الشامِلُ",42,"ل",1,0],["بل متى تيقظ الورى من كراها","فتنام السيوف في الأغماد",43,"د",1,0],["بَلْ مَا تَذَكَّرخ مِنْ كَأْسٍ شَرِبْتَ بِهَا","وقَدْ عَلاَ الرَّأْسَ مِنْكَ الشَّيْبُ والصَّلَعُ",44,"ع",1,0],["بَلْ مَا لِهَذا الْبَرْقِ مُلْتَهِبَ الحَشَا","أَسَمَتْ إِلَيْهِ شَرَارةٌ مِنْ أَضْلُعِي",45,"ع",2,0],["بل من على الشمس اذ تجري مقدرة","لمستقر لها حيث الضيا انكتما",46,"م",2,0],["بَلْ مَنْ لِعَذَّالَةٍ خَذَّالَةٍ أَشِبٍ","حَرَّقَ باللَّوْمِ جِلْدِي أيَّ تَحْرَاقِ",47,"ق",1,0],["بَلْ مَتَى العَقْدُ مِنْ لِوَائكَ والرَّقَّةُ","مَعْقُودَةٌ بِقِنَّسْرِينَا",48,"ن",2,0],["بلْ ما تَذَكَّرَ مِن كأسٍ شَربتَ بها","وقد علا الرأس منك الشيب والصلع",49,"ع",1,0],["بل ما لهذا البرق صلاًّ مطرقاً","ولأي شملِ الشمائمين أتيحا",50,"ح",2,0],["بل ما يضركِ لو سمحت بحلوة ؟","إنّ العروسَ كثيرة ُ المتطلَّع",51,"ع",1,0],["بِلَمَاهَا بَعدَ الكَرى طعم مَشجُو","جِ السَّوَارِى والشُّهدِ والصهباء",52,"ا",2,0],["بل من زعيم الرؤساء اقتنوَا","مكارمَ الأخلاق لا منهمُ",53,"م",1,0],["بل ما بها من حسان أفنان وألو","وان إذا أنصفته من دمّر",54,"ر",1,0],["بِلَمحَةٍ مِنهُ عادَت وَهيَ خاشِعَةٌ","ثَلجاً وَما ذاكَ مِن آياتِهِ عَجَبُ",55,"ب",1,0],["بل من العار بيع مثل بمثل","وربا ان يباع شعر بشعر",56,"ر",1,0],["بل منك لليل جزؤ من سنا شعر","وللصباح نصيب من اثناياك",57,"ك",1,0],["بَل مِثلَما ذَكَرت روما قَبائِحَها","في مُقلَتي مسلّينا وَهيَ تَضطَرِبُ",58,"ب",1,0],["بل ما لعينيَّ لا تبيضُّ من حزنٍ","وَأَعينُ المجدِ والعلياءِ تنطمس",59,"س",1,0],["بل ما عساك تذكري","نَ مِنْ أُمورٍ عجب",60,"ب",1,0],["بل مَنْ يبلّغ (مخزوم) التي شمخت","بآنف زانهن الكبر والشمم",61,"م",1,0],["بل مض