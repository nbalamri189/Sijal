{"poems":[[47,"قلت للائم في الحب أفق","https://www.aldiwan.net/poem65180.html","الرمل"],[107,"على ذكرها فليعرف الحق جاهله","https://www.aldiwan.net/poem41937.html","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141977","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54199","الخفيف"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100909","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132587","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132668","الرمل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132782","الخفيف"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123914","الرمل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101240","الرمل"],[4816,"المعذره","https://www.poetsgate.com/ViewPoem.aspx?id=12851",""]],"verses":[["إِن مَشى هَملَجَ أَو صاحَ إِلى","صاحِبٍ عَشَّرَ أَو ماتَ نَفَق",0,"ق",1,0],["أَنَمْشِي بِطاءً والخطوبُ تَنُوبُنا","سِراعاً وعادي الشَّرِّ ينقضُّ عاجِلُهْ",1,"ل",2,0],["إن مشت فالقلوب تحت خطاها","لا تبالي نعيمها من شقاها",2,"ه",2,0],["إن مشى يمشِ بائساً مستكيناً","كأسيرٍ يجرُّ في الرجْلِ قِدّا",3,"د",2,0],["إِن مَشَى عطَّرَ النَّدِيَّ وشبَّت","فى نواحيه شعلةٌ من ذكاء",4,"ا",2,0],["ان مشت فهي بانة أو تغنت","فهي ورقاء روضة تغريدا",5,"د",2,0],["ان مشت هزت قناة صعدة","أورنت سلت حساما مرهفا",6,"ف",2,0],["ان مشروطة الملاحة فيكم","وبأهليك قامت المدنيه",7,"ي",2,0],["إن مشى اهتز اهتزاز الأسل","بقوام فيه بدر التم لاح",8,"ح",1,0],["إن مشت فالقد يهتز بها","عبلة الأرداف والخصر نحيل",9,"ل",1,0],["ان مشيت الدرب غيرت المسار","وان نخيت العزم وراني ظهره",10,"ر",2,0]]}