خفيف"],[413,"مذ سل في العشاق سيف الناظر","https://www.aldiwan.net/poem54147.html","الكامل"],[426,"ما للمعالي تفيض الدمع مدرارا","https://www.aldiwan.net/poem38732.html","البسيط"],[426,"لحد به يافع حانت منيته","https://www.aldiwan.net/poem39833.html","البسيط"],[426,"وافى يميس فاخجل الغصن الرطب","https://www.aldiwan.net/poem39900.html","الكامل"],[429,"يا مغرما بنفيس الدر يجمعه","https://www.aldiwan.net/poem12658.html","البسيط"],[436,"قل للخلافة قد بلغت مناك","https://www.aldiwan.net/poem34895.html","الكامل"],[438,"يا من له وسط الفؤاد","https://www.aldiwan.net/poem14306.html","مجزوء الكامل"],[451,"أجل ضربت لكم في غربتي المثلا","https://www.aldiwan.net/poem61603.html","البسيط"],[456,"من مبلغ عني وإن تعذرت","https://www.aldiwan.net/poem55897.html","الرجز"],[456,"سأل اللوى وسؤاله إلحاف","https://www.aldiwan.net/poem56110.html","الكامل"],[456,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[456,"أصبت لو أحمدت أن أصيبا","https://www.aldiwan.net/poem56297.html","الرجز"],[477,"يا راكب الرتل السريع","https://www.aldiwan.net/poem37043.html","مجزوء الكامل"],[477,"صبرا لحكمك صبرا","https://www.aldiwan.net/poem37050.html","المجتث"],[498,"دمع من العين جرى كالمطر","https://www.aldiwan.net/poem37689.html","السريع"],[513,"حرقة قلبي فيك لا تخمد","https://www.aldiwan.net/poem12076.html","السريع"],[527,"قدمت خير مقدم","https://www.aldiwan.net/poem37139.html","مجزوء الرجز"],[527,"إن غضبوا جهلا لما قلته","https://www.aldiwan.net/poem37237.html","السريع"],[536,"إن غاب صفو العيش عنا برهة","https://www.aldiwan.net/poem47565.html","عموديه"],[536,"أمري إلى المولى العلي الشان","https://www.aldiwan.net/poem47924.html","عموديه"],[536,"خطب جسيم فتت الأكبادا","https://www.aldiwan.net/poem48242.html","عموديه"],[549,"أي ناع نعاه لي أي ناع","https://www.aldiwan.net/poem47700.html","الخفيف"],[556,"إن غبت عن عياني","https://www.aldiwan.net/poem33831.html","المجتث"],[556,"لبس القميص أو القبا","https://www.aldiwan.net/poem34928.html","مجزوء الكامل"],[556,"وجه تعدد في المرائي","https://www.aldiwan.net/poem35086.html","مجزوء الكامل"],[573,"صح من دهرنا وفاة الحياء","https://www.aldiwan.net/poem2790.html","الخفيف"],[573,"نسيم ربعك أفديه بأنفاسي","https://www.aldiwan.net/poem3057.html","البسيط"],[584,"تحرش الطرف بين الجد واللعب","https://www.aldiwan.net/poem17437.html","البسيط"],[584,"لما حدا بالأيمنين يسار","https://www.aldiwan.net/poem17510.html","الكامل"]],"verses":[["إِن غِبتَ عَنّا فَالقُلوبُ حَواضِرٌ","في حَيثُ أَنتَ نَوازِعُ الأَوهامِ",0,"م",1,0],["إِنَّ غَربَ الدَهرِ مَصقولُ","وَغِرارَ الجَدِّ مَسلولُ",1,"ل",1,1],["إِن غَدا مَجدوعَةً أَشرافُهُ","فَالبُنى وافِيَةٌ وَالمَجدُ عالي",2,"ي",1,0],["إِنَّ غَريمي بِدُيونِ الهَوى","أَدانَ قَلبي وَأَساءَ القَضا",3,"ض",2,0],["إنْ غرّدَ الرّاوي بِها تطَرُّباً","تلقّفَ السّامِعُ منْها ما رَوى",4,"ا",1,0],["إن غاضَ مِنْ أنوارِهِ فَوراءَهُ","أُفُقٌ تَوَشّحَ منكَ بالأقمارِ",5,"ر",1,0],["إِن غِبتِ آنَسَ طَرفَهُ بِدُموعِهِ","وَإِذا أَصابَكِ طَرفُهُ لَم يَطرِفِ",6,"ف",1,0],["إِن غِبتُ عَنهُم فَشَرُّ الناسِ يَشتُمُني","وَإِن مَرِضتُ فَخَيرُ الناسِ لَم يَعُدِ",7,"د",1,0],["إِن غِبتَ لَم أَلقَ إِنساناً يُؤَنِّسُني","وَإِن حَضَرتَ فَكُلُّ الناسِ قَد حَضَرا",8,"ر",2,0],["إِنْ غَابَتِ الشَّمْسُ اسْتَضَاءَ بِشُعْلَةٍ","عِنْدَ الخُلُودِ السِّرُّ فِي إِشْعَالِهَا",9,"ل",3,0],["إِنْ غَرَّهَا أَنَّ النَّجَاةَ مِنَ الأَذَى","عُذْرٌ لَهَا فَالعُذْرُ لَيْسَ بِقَائِمِ",10,"م",1,0],["إن غاب عبدُك عن حماك فإنه","بالقلب في تلك المشاهد قد حضرْ",11,"ر",1,0],["أنَغفِرُ أَم نُعَاقِبُ إِذ أتتنا","جنادعُ مِن قوارص يَحتَذِينَا",12,"ن",2,0],["إن غابَ حظكُمُ استعبرتُ من أسفٍ","له وإن قفلَ استبشرتُ بالقفلِ",13,"ل",1,0],["أُِن غِبتِ عَن عَيني وَجُنَّ الدُجى","سَأَلتُ عَنكِ القَمَرَ الزاهِرا",14,"ر",2,0],["إِن غِبتَ عَنّي أَو حَضَر","تَ فَيا لَها مِن حُسنَيَينِ",15,"ن",1,0],["إِن غِبتَ عَنّي أَو حَضَر","تَ فَلَست عَن عَيني تَغيبُ",16,"ب",1,1],["أن غصب الحق الصريح شديد","وسكوت الأحرار عنه أشد",17,"د",1,0],["إن غضِبَ الناس من كلامي","فما على الناس من ملامِ",18,"م",1,1],["إن غبت عنا فلا عيش يطيب لنا","ولا نسيم الصبا إن هب يسلينا",19,"ن",2,0],["إِن غَضِبَ الأَهلُ عَلَ","يَ كُلُّهُم لَم تَغضَبِ",20,"ب",1,0],["إِن غازَلَت شاطِئَيهِ في الضُحى لَبِسا","خَمائِلَ السُندُسِ المَوشِيَّةِ الغينا",21,"ن",2,0],["إِن غارَ فَهوَ مِنَ النَباهَةِ مُنجِدٌ","أَو غابَ فَهوَ مِنَ المَهابَةِ شاهِدُ",22,"د",1,0],["إِن غَلَّسَ المُدهِنونَ في خَمَرٍ","أَضحى عَلى الحَقِّ ظاهِراً جَدَدُه",23,"د",2,0],["إِن غِبتَ عَن عِياني","يا غايَةَ الأَماني",24,"ن",2,1],["إنَّ غداً هُوَّةٌ لناظرها","تكاد فيها الظنون ترتعد",25,"د",1,0],["إن غابَ في جَدَثٍ أنارَ بنورِهِ","فَبِفَقْدِ ذاك النورِ أظْلَمَ نادي",26,"د",2,0],["إِن غاضَ ماءُ المُزنِ فِضتَ وَإِن قَسَت","كَبِدُ الزَمانِ عَلَيَّ كُنتَ رَؤوفا",27,"ف",2,0],["إن غِبْتَ عن نَظرِ العُيونِ هُنيهةً","فَقلوبُنا الحرَّى عليكَ عُيونُ",28,"ن",1,0],["إِن غَضِبنا أَو رَضينا فَلَهُ","لا نُبالي تُرَّهاتِ المُرجِفينْ",29,"ن",1,0],["إن غَرَّهُ حَدُّ عزمٍ","فَسَوفَ يَعرِفُ حَدَّكْ",30,"ك",1,0],["إِن غِبتَ عَن قَومٍ فَما غابَ الَّذي","عَوَّدتَهُم مِن نائِلٍ وَتَعَطُّفِ",31,"ف",1,0],["إنْ غَضَّ مِنْ بَصَرٍ وَمِنْ صَوْتٍ فما","غَضَّ التُّقَى والفَضلُ مِنهُ كلِيلا",32,"ل",2,0],["إِن غِبتِ عَنّي فَقَلبي","يَوَدُّ أَلّا يَغيبا",33,"ب",2,0],["إِنَّ غَيري مَن قَلاها","لِرَجاءٍ أَو مَخافَه",34,"ف",2,0],["إِن غابَ لَم أَظنُن بِهِ","وَهوَ بِغَيبي يَثِقُ",35,"ق",1,0],["إِن غابَتِ الشَمسُ اِستُضيءَ بِوَجهِهِ","وَيُرى مَكانَ البَدرِ حينَ يَبينُ",36,"ن",1,0],["إِن غارَ بَيتَ أُمَّنا في لَيلِهِ","فَإِذا يَغورُ فَثائِرٌ مِغوارُ",37,"ر",1,0],["إِن غاضَ بَحرٌ مُدَّةً","فَلَطالَما غَدَرَ الغَديرُ",38,"ر",1,1],["إِن غَفَرَ اللَهُ لي فَلا أَسَفٌ","عَلى الَّذي فاتَ مِن تَنَعُّمِها",39,"م",3,0],["إِن غابَ عَنهُ الأَقرَبونَ وَلَم","يُصبَح بِرَيِّقِ مائِهِ شَجَرُه",40,"ر",2,0],["إن غابَت الشمس أبقت خلفها شفقاً","فيه لمن هي غابت عنه مدَّكر",41,"ر",1,0],["إنْ غَيّرَتْ حالَ الأنامِ","فما تُغَيّرُ حالَها",42,"ل",3,0],["إِن غَضِبَ الأَهلُ عَلَي","يَ كُلُّهُم لَم تَغضَبِ",43,"ب",1,0],["إِنْ غَابَ جِسْمِي وَالأَيَّامُ مَنْسِيَةٌ","أَبْقَيْتَ رَسْمِي ذِكْرَى بَيْنَ أَحْبَابِي",44,"ي",1,0],["إِنْ غِبْتَ وَا وَلَدَاهُ عَنْ عَيْنِي فَمَنْ","زَيْنُ الشَّبَابِ وَمَنْ ضَيَاءُ النَّادِي",45,"ي",1,0],["إِن غَسا لَيلي أَرِقتُ لَهُ","وَأَرَقتُ الدَمعُ فَاِنغَسَلا",46,"ل",2,0],["إِنْ غَاب فيها بَدْرُ ذِي الد","نْيَا فَبَدْرُ الدينِ حاضِرْ",47,"ر",1,0],["إنْ غرَّةُ كرمُ الدخيل، فطالما","ذُبحَ الفصيلُ بمدية العلاَّف",48,"ف",1,0],["إنَّ غنيمًا، والخفي","فَ: خَبَرٌ، ومُبتدا",49,"د",2,0],["إن غاب عن مِصْرٍ جَمالٌ واحدٌ","فبِمِصْرَ -يَوْمَ الرَّوْع- ألفُ جَمالِ",50,"ل",1,0],["إن غاب حدُّ سلاحهم","فيقينُهم بالله حاضر",51,"ر",1,0],["أُنغَصُّ في الزاد الذي أنا آكلٌ","وأشْرَق بالماءِ الذي أترَّشف",52,"ف",1,0],["إن غاب عنا ففي أولاده عَقِبُ","يحييك ذكراً ، وذكر المرء في العقب",53,"ب",1,0],["إن غبت عم عيني وجنّ الدّجى","سألت عنك القمر الزاهرا",54,"ر",2,0],["إن غبت قلباً بالرسول وآله","وذكرتهم في جملة الأوقات",55,"ت",1,1],["إنْ غِبْتُ عنها وعن سُكَّانِها عَزَبَتْ","روحي، وكلُّ سُؤالاتي متى أَصِلُ",56,"ل",1,0],["إِن غداً وما غد بعيد","لسوف يبدي بعض ما أُعيد",57,"د",1,0],["إن غدرا ألا تقيم بدور","كنتَ فيها مع الرباب مقيما",58,"م",2,0],["إِنَّ غَدراً أن لاَ تُعَرِّجَ في أطلا","لِهِ أو تُحَيِّىَ الأَطلالا",59,"ل",2,0],["إن غاصَ بَحرَ القَوَافي مَن يَغُوصُ بِهِ","في مَوسِمِ الشِّعر والأندَاءُ قَد شَهِدُوا",60,"د",3,0],["إن غاب مَن أهواهُ عن ناظري","فإنه عن مهجتي لا يغيبْ",61,"ب",1,1],["إِن غَرَّهُم تَغريرُ حَسّانٍ بِهِم","فَسَيَعرِفونَ الكاذِبَ الأَفّاكا",62,"ك",2,0],["إِن غَيرُكَ اِتَّخَذَ الدِلاصَ مُذَيَّلاً","فَرَقاً فَإِنَّكَ لِلدِلاصِ مُذيلُ",63,"ل",1,0],["إِن غابَ شَخصِيَ عَن هَذا المَقامَ فَقَد","صَحِبتُهُ بِالرَجاءِ المَحضِ وَالأَمَلِ",64,"ل",1,0],["إن غيرهم بالمال شحّ وما سخا","جادوا ببذل النفس دون تعلّل",65,"ل",1,0],["إن غيرهم نال اللذائذ مسرفاً","هم يبتغون قراع كتب الجحفل",65,"ل",1,0],["إن غبتم صورة عن ناظري فما","زلتم حضورا على التحقيق في خلدي",66,"ي",1,1],["إن غاض دمعُكِ فاحذرِي غرقا به","فإذا تَوالَى القَطْرُ عاد سيولا",67,"ل",2,0],["إن غبت قطع عرضي غير مكترثٍ","وإن حضرت فبكر",68,"ر",1,0],["إن غاب غاب به السرو","ر وإن دنا شيئا فعاقا",69,"ق",2,0],["إِن غِبتَ عَني سُمتَني","وَشكَ الرَدى فَكَأَن قَدِ",70,"د",1,0],["ان غصان النقا نقلت","عنه حسن اللين والهيف",71,"ف",1,0],["إن غفا فالكتاب حلم كراهُ","أو صحا فالكتاب خير خدين",72,"ن",1,0],["أنغامُ صوتك تشجيني سواجعها","فهل تكون على الأيام قرآني",73,"ي",1,0],["إِن غَفا مَرَّتِ الفَتاةُ بِرُؤيا","هُ تُنادي رَبّاً وَتَلطُمُ صَدرا",74,"ر",2,0],["إِنَّ غاراً عَلى ذراكَ لمجدٌ","خَلَّدته نَوابِغُ القُدَماءِ",75,"ا",2,0],["إن غابَ ساقى الطِلا أَو صَدَّ لا حرجٌ","هذا جَمالُكِ يُغنينا مُحَيّاه",76,"ي",3,0],["إِن غَضَّ الشَباب فَقَّهَهُ التَر","حالُ شَيخٌ في أَعيُنِ العُقَلاءِ",77,"ا",2,0],["إِن غِبتَ عَن عَيني الغَدا","ةَ فَأَنتَ في قَلبي مُقيمُ",78,"م",1,0],["إِن غَدا مُحتَلِكاً فيكِ البَلى","فَالضَنا مُحتَكِمٌ في جَسَدي",79,"ي",1,0],["إِنْ غَنَّتِ الْوُرْقُ فِيهَا","أَذْكَتْ مَجَامِرَ عَرْفِ",80,"ف",1,0],["إن غاب عن عينيّ مرأى ذاته","فأراه في الأحشاء كان مقيما",81,"م",2,0],["ان غالني بالبعد دهري عنك","فالأيام تدنى من تشاء وتبعد",82,"د",1,0],["إن غصَّ آدمُ بالتفَّاحِ مُختبئاً","إني لآكُلُ تُفَّاحاً ورُمّانا",83,"ن",2,0],["إن غَدَوتُ أمزُجُها","أبرَزَتهُ لي فِلذا",84,"ذ",2,0],["إِن غِبتُمُ عَنّي فَلَم","يَغِبِ التَأَسُّفُ وَالسَقامُ",85,"م",1,0],["إن غُيِّضَ ماءُ الجَدوَلِ حِي","فَ عَلى ما فيهِ مِنَ السَمَكِ",86,"ك",1,0],["إِن غابَتِ الشَمسُ عَنهُمُ وَهُمُ","لَم يَدخُلوا في عَشِيَّة البَلَدا",87,"د",2,1],["إنَّ غيّي في هواه رشدٌ","وَرَشادي في سلوّي عنه غَي",88,"ي",1,0],["إن غاب من أحببته عن مجلسي","ليذوب قلبي الصب من حسراته",89,"ه",1,1],["إِنَّ غِنى النَفسِ رَأسُ كُلِّ غِنىً","وَما اِفتِقاري إِلّا إِلى الصَمدِ",90,"د",1,0],["إِن غابَ بِيَ الطَرفَ عَنهُ في تَحَجُّبِهِ","فَالقَلبُ مِنّي لَهُ أَضحى الشَهيدَ بِهِ",91,"ه",1,0],["إِن غَلِطَ الكَشطُ في صَحائِفِهِ","سِنُّكَ هَذي المُدى وَذي القُرُبُ",92,"ب",1,0],["إِن غاضَ مِنهُ الدَمع فَجَّر","ماءهُ تِذكاره",93,"ر",2,0],["إن غبت عنكم فروحي في منازلكم","سبحان من صيَّرَ الرُّوحَيْنِ في جسد",94,"د",1,0],["إن غنت الورقاء في غصنها","فلحنها عن وَلَهِي معرب",95,"ب",1,0],["إن غِبْتَ عَنّا سَنةً فَهْيَ سَنَهْ","وسَنَةٌ تحضُرُ فيها وَسَنَهْ",96,"ه",1,0],["إن غالَبتْني على وَفْري نوائبهُ","فحُسنُ صَبريَ في اللأواءِ يغلِبهُ",97,"ب",2,0],["إِن غِبتُ عَن حَضرَتِهِ دُعيتُ","وَإِن حَضَرتُ بابَهُ حُيّيتُ",98,"ت",1,0],["إنَّ غِبَّ الغرام منذ امتطاها","أطلقَ الوَخدُ والذميلُ خطاها",99,"ه",2,0],["إنْ غاب من أهوى وعزّ لقاؤه","فالقلب لم يبرح بوجد حاضر",100,"ر",1,0],["إن غاب عن هذه الدنيا فإنّ لهُ","ذكراً يدوم مع الأيام معطارا",101,"ر",2,0],["إن غاب الشمس في عينٍ مؤرخةٍ","أوّه لاحمد نجمٌ غاب بالماء",102,"ا",2,0],["إن غاب عن عينيَّ تحت نقابه","فجماله عن افق قلبي لم يغب",103,"ب",1,0],["إن غابَ بدرُ سماءِ الفضلِ عن بصَري","ففي فؤاديَ أفقٌ منك مطلعُه",104,"ع",2,0],["إن غَصَّ يومُ القوط منكَ بِرُسْلِهِمْ","فَغَداً بيوم الرُّومِ والأَتراكِ",105,"ك",1,0],["إن غبت باك أنا الفصي","ح وإن حضرت فيبلس",106,"س",1,0],["إن غبتُ عنكم فلم تبرح لكم هممي","كأنني جحفلٌ ما زالَ مُقتتلاَ",107,"ل",2,0],["إن غمستْ في كرمٍ أيديَها","حَسرتَ والأكفُّ في أكمامِها",108,"م",3,0],["إن غاب أهلكِ فالجباهُ أهلّةٌ","أو غاض ماؤك فالسِّقاء نِطافُ",109,"ف",1,0],["إن غاب شخصُ مقلتيه أبصرتْ","أذْناه هل خُبِّرتَ سَمْعاً بَصَرا",110,"ر",2,0],["إن غادر الشكرُ لساناً ناكلا","وكان سيفا قبله مذروبا",111,"ب",2,0],["إن غاب نجمك بالوفا","ة فشمس ذكرك في طلوع",112,"ع",1,0],["إن غاب شخصه عني","ما غاب واللّه فكرا",113,"ر",2,0],["إن غاب تبكي العين من فقده","وتشتكي البعد اذا ما حضر",114,"ر",1,0],["إن غيبوا شخصك في ملحد","فأنت مني في الحشا ملحد",115,"د",1,0],["إنْ غِبْتَ عَنِّي ساعَةً","كانَتْ كَعامٍ أَعْوَمِ",116,"م",1,0],["إنْ غَضِبوا جَهْلاً لما قُلْتُهُ","في صَحْبِ طَهَ عَنْ فَعالِ الجَميل",117,"ل",1,1],["إن غَابَ صَفوُ العَيشِ عَنَّا بُرهَةً","لا بُدَّ صَفوُ العَيشِ يَوماً يَرجِعُ",118,"ع",1,1],["إن غاَبَ عَنِّي بُرهةً فَلِدَورَةٍ","سَيَدورُها ويُطِلُّ كالسَّجَّانِ",119,"ن",1,0],["إن غابَ شمسٌ من بني المِزوارِ تُش","رِقُ أشمُسٌ لكَ سمِّيَت أولادا",120,"د",2,0],["إنّ غدراً ثوى فلم تخلُ أضلا","عُكَ منه ما اِجتازَ في أضلاعي",121,"ي",1,0],["إن غبت عن عياني","فأنت في جناني",122,"ن",2,1],["إن غبت عنه فإنني","من نسل أصحاب النبا",123,"ب",2,0],["إن غاب عن أغيارنا","هو عندنا ملء الإناء",124,"ا",2,0],["إِنَّ غَيْظِي عَلَى الزمانِ لَجَهْلٌ","هُوَ مثلِي يُصابُ بالأَزْرَاءِ",125,"ا",2,0],["إِن غابَ قدُّك في مخضَرِّ بُرْدَتِه","غالطتُ قلبي بأَغصانٍ من الآس",126,"س",1,0],["إن غِبْتُ عَنْهُمْ تَباهوا في قصائِدهمْ","بِغَيْبِة الشمسِ تَبْدُو زِينَةُ الشهُبِ",127,"ب",1,0],["إِنْ غِبْتَ وَجْداً لَا أَذىً هذا وَلَا","تَدْري بِرقّةِ ذَا فَمَا هُوَ عَارُ",128,"ر",1,0]]}