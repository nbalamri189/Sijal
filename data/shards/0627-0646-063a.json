{"poems":[[53,"شوق يعرض لا إلى الآرام","https://www.aldiwan.net/poem29772.html","الكامل"],[53,"إن غرب الدهر مصقول","https://www.aldiwan.net/poem29838.html","المديد"],[53,"أي طود دك من أي جبال","https://www.aldiwan.net/poem29889.html","الرمل"],[53,"كيف أضاء البرق إذ أومضا","https://www.aldiwan.net/poem30175.html","السريع"],[63,"واها لأيامي بأكناف اللوى","https://www.aldiwan.net/poem46135.html","الرجز"],[63,"النائبات كثيرة الإنذار","https://www.aldiwan.net/poem46177.html","الكامل"],[55,"هذا كتاب فتى لغيبك حافظ","https://www.aldiwan.net/poem26237.html","الكامل"],[57,"إني صحبت الناس ما لهم عدد","https://www.aldiwan.net/poem24705.html","البسيط"],[73,"يا من غدوت به في الناس مشتهرا","https://www.aldiwan.net/poem11861.html","البسيط"],[93,"حي الكنانة غدوة استقلالها","https://www.aldiwan.net/poem11126.html","الكامل"],[93,"يا أمتي تنكري نصح امريء","https://www.aldiwan.net/poem11288.html","الكامل"],[83,"نفسي الفداء لشادن مهما خطر","https://www.aldiwan.net/poem54307.html","الكامل"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[51,"لا زلت تبلغ أقصى السؤل والأمل","https://www.aldiwan.net/poem65993.html","البسيط"],[91,"عيناك والسحر الذي فيهما","https://www.aldiwan.net/poem8855.html","عموديه"],[70,"يا سيدا بوداده","https://www.aldiwan.net/poem42434.html","مجزوء الكامل"],[70,"إن غبت عني أو حضر","https://www.aldiwan.net/poem43009.html","مجزوء الكامل"],[89,"إن تأييد نهضة العلم مجد","https://www.aldiwan.net/poem44933.html","الكامل"],[89,"إن غضب الناس من كلامي","https://www.aldiwan.net/poem44955.html","مخلع البسيط"],[89,"تأن في الظلم تخفيفا وتهوينا","https://www.aldiwan.net/poem44960.html","البسيط"],[85,"لي جدة ترأف بي","https://www.aldiwan.net/poem7998.html","مجزوء الرجز"],[85,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[45,"وصل تقارب منه ثم تباعد","https://www.aldiwan.net/poem63466.html","الكامل"],[45,"رنو ذاك الغزال أو غيده","https://www.aldiwan.net/poem63505.html","المنسرح"],[66,"إن غبت عن عياني","https://www.aldiwan.net/poem39666.html","مجزوء الرجز"],[97,"يا قاسي البعد كيف تبتعد","https://www.aldiwan.net/poem24916.html","المنسرح"],[80,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[44,"أطلالهم سلبت دماها الهيفا","https://www.aldiwan.net/poem30403.html","الكامل"],[105,"هتف البشير به وحان الحين","https://www.aldiwan.net/poem42044.html","الكامل"],[105,"اشهدي يا مصر أعمال البنين","https://www.aldiwan.net/poem43070.html","الرمل"],[105,"سرية أنت وحدك","https://www.aldiwan.net/poem43585.html","المجتث"],[81,"أهدت نجاتك عوذة المتخوف","https://www.aldiwan.net/poem61460.html","الطويل"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[48,"ملأت قلبي ندوبا فصرت صبا كئيبا","https://www.aldiwan.net/poem10790.html","المجتث"],[48,"اسقني واسق ذفافه","https://www.aldiwan.net/poem64391.html","مجزوء الرمل"],[48,"علقت من علقني","https://www.aldiwan.net/poem64448.html","مجزوء الرجز"],[48,"ومعقرب الصدغين في لحظاته","https://www.aldiwan.net/poem66109.html","الكامل"],[46,"أجزاء دهر ينقضين ولم يكن","https://www.aldiwan.net/poem22576.html","الكامل"],[46,"إن غاض بحر مدة","https://www.aldiwan.net/poem22591.html","مجزوء الكامل"],[46,"لو زعمت نفسي الرشاد لها","https://www.aldiwan.net/poem23419.html","المنسرح"],[1,"إني من القوم الذين إذا","https://www.aldiwan.net/poem34001.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85585","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16673",""],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19363","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54608","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54765","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43824","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54318","الكامل"],[106,"على الأعراف","https://www.poetsgate.com/ViewPoem.aspx?id=179633",""],[106,"ما تعطي غدًا؟","https://www.poetsgate.com/ViewPoem.aspx?id=179774",""],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[90,"عناد...","https://www.poetsgate.com/ViewPoem.aspx?id=179043",""],[90,"ليت الذي بك في وقع النوائب بي !","https://www.poetsgate.com/ViewPoem.aspx?id=179093",""],[91,"عيناك","https://www.poetsgate.com/ViewPoem.aspx?id=53082",""]],"verses":[["إِن غِبتَ عَنّا فَالقُلوبُ حَواضِرٌ","في حَيثُ أَنتَ نَوازِعُ الأَوهامِ",0,"م",1,0],["إِنَّ غَربَ الدَهرِ مَصقولُ","وَغِرارَ الجَدِّ مَسلولُ",1,"ل",1,1],["إِن غَدا مَجدوعَةً أَشرافُهُ","فَالبُنى وافِيَةٌ وَالمَجدُ عالي",2,"ي",1,0],["إِنَّ غَريمي بِدُيونِ الهَوى","أَدانَ قَلبي وَأَساءَ القَضا",3,"ض",2,0],["إنْ غرّدَ الرّاوي بِها تطَرُّباً","تلقّفَ السّامِعُ منْها ما رَوى",4,"ا",1,0],["إن غاضَ مِنْ أنوارِهِ فَوراءَهُ","أُفُقٌ تَوَشّحَ منكَ بالأقمارِ",5,"ر",1,0],["إِن غِبتِ آنَسَ طَرفَهُ بِدُموعِهِ","وَإِذا أَصابَكِ طَرفُهُ لَم يَطرِفِ",6,"ف",1,0],["إِن غِبتُ عَنهُم فَشَرُّ الناسِ يَشتُمُني","وَإِن مَرِضتُ فَخَيرُ الناسِ لَم يَعُدِ",7,"د",1,0],["إِن غِبتَ لَم أَلقَ إِنساناً يُؤَنِّسُني","وَإِن حَضَرتَ فَكُلُّ الناسِ قَد حَضَرا",8,"ر",2,0],["إِنْ غَابَتِ الشَّمْسُ اسْتَضَاءَ بِشُعْلَةٍ","عِنْدَ الخُلُودِ السِّرُّ فِي إِشْعَالِهَا",9,"ل",3,0],["إِنْ غَرَّهَا أَنَّ النَّجَاةَ مِنَ الأَذَى","عُذْرٌ لَهَا فَالعُذْرُ لَيْسَ بِقَائِمِ",10,"م",1,0],["إن غاب عبدُك عن حماك فإنه","بالقلب في تلك المشاهد قد حضرْ",11,"ر",1,0],["أنَغفِرُ أَم نُعَاقِبُ إِذ أتتنا","جنادعُ مِن قوارص يَحتَذِينَا",12,"ن",2,0],["إن غابَ حظكُمُ استعبرتُ من أسفٍ","له وإن قفلَ استبشرتُ بالقفلِ",13,"ل",1,0],["أُِن غِبتِ عَن عَيني وَجُنَّ الدُجى","سَأَلتُ عَنكِ القَمَرَ الزاهِرا",14,"ر",2,0],["إِن غِبتَ عَنّي أَو حَضَر","تَ فَيا لَها مِن حُسنَيَينِ",15,"ن",1,0],["إِن غِبتَ عَنّي أَو حَضَر","تَ فَلَست عَن عَيني تَغيبُ",16,"ب",1,1],["أن غصب الحق الصريح شديد","وسكوت الأحرار عنه أشد",17,"د",1,0],["إن غضِبَ الناس من كلامي","فما على الناس من ملامِ",18,"م",1,1],["إن غبت عنا فلا عيش يطيب لنا","ولا نسيم الصبا إن هب يسلينا",19,"ن",2,0],["إِن غَضِبَ الأَهلُ عَلَ","يَ كُلُّهُم لَم تَغضَبِ",20,"ب",1,0],["إِن غازَلَت شاطِئَيهِ في الضُحى لَبِسا","خَمائِلَ السُندُسِ المَوشِيَّةِ الغينا",21,"ن",2,0],["إِن غارَ فَهوَ مِنَ النَباهَةِ مُنجِدٌ","أَو غابَ فَهوَ مِنَ المَهابَةِ شاهِدُ",22,"د",1,0],["إِن غَلَّسَ المُدهِنونَ في خَمَرٍ","أَضحى عَلى الحَقِّ ظاهِراً جَدَدُه",23,"د",2,0],["إِن غِبتَ عَن عِياني","يا غايَةَ الأَماني",24,"ن",2,1],["إنَّ غداً هُوَّةٌ لناظرها","تكاد فيها الظنون ترتعد",25,"د",1,0],["إن غابَ في جَدَثٍ أنارَ بنورِهِ","فَبِفَقْدِ ذاك النورِ أظْلَمَ نادي",26,"د",2,0],["إِن غاضَ ماءُ المُزنِ فِضتَ وَإِن قَسَت","كَبِدُ الزَمانِ عَلَيَّ كُنتَ رَؤوفا",27,"ف",2,0],["إن غِبْتَ عن نَظرِ العُيونِ هُنيهةً","فَقلوبُنا الحرَّى عليكَ عُيونُ",28,"ن",1,0],["إِن غَضِبنا أَو رَضينا فَلَهُ","لا نُبالي تُرَّهاتِ المُرجِفينْ",29,"ن",1,0],["إن غَرَّهُ حَدُّ عزمٍ","فَسَوفَ يَعرِفُ حَدَّكْ",30,"ك",1,0],["إِن غِبتَ عَن قَومٍ فَما غابَ الَّذي","عَوَّدتَهُم مِن نائِلٍ وَتَعَطُّفِ",31,"ف",1,0],["إنْ غَضَّ مِنْ بَصَرٍ وَمِنْ صَوْتٍ فما","غَضَّ التُّقَى والفَضلُ مِنهُ كلِيلا",32,"ل",2,0],["إِن غِبتِ عَنّي فَقَلبي","يَوَدُّ أَلّا يَغيبا",33,"ب",2,0],["إِنَّ غَيري مَن قَلاها","لِرَجاءٍ أَو مَخافَه",34,"ف",2,0],["إِن غابَ لَم أَظنُن بِهِ","وَهوَ بِغَيبي يَثِقُ",35,"ق",1,0],["إِن غابَتِ الشَمسُ اِستُضيءَ بِوَجهِهِ","وَيُرى مَكانَ البَدرِ حينَ يَبينُ",36,"ن",1,0],["إِن غارَ بَيتَ أُمَّنا في لَيلِهِ","فَإِذا يَغورُ فَثائِرٌ مِغوارُ",37,"ر",1,0],["إِن غاضَ بَحرٌ مُدَّةً","فَلَطالَما غَدَرَ الغَديرُ",38,"ر",1,1],["إِن غَفَرَ اللَهُ لي فَلا أَسَفٌ","عَلى الَّذي فاتَ مِن تَنَعُّمِها",39,"م",3,0],["إِن غابَ عَنهُ الأَقرَبونَ وَلَم","يُصبَح بِرَيِّقِ مائِهِ شَجَرُه",40,"ر",2,0],["إن غابَت الشمس أبقت خلفها شفقاً","فيه لمن هي غابت عنه مدَّكر",41,"ر",1,0],["إنْ غَيّرَتْ حالَ الأنامِ","فما تُغَيّرُ حالَها",42,"ل",3,0],["إِن غَضِبَ الأَهلُ عَلَي","يَ كُلُّهُم لَم تَغضَبِ",43,"ب",1,0],["إِنْ غَابَ جِسْمِي وَالأَيَّامُ مَنْسِيَةٌ","أَبْقَيْتَ رَسْمِي ذِكْرَى بَيْنَ أَحْبَابِي",44,"ي",1,0],["إِنْ غِبْتَ وَا وَلَدَاهُ عَنْ عَيْنِي فَمَنْ","زَيْنُ الشَّبَابِ وَمَنْ ضَيَاءُ النَّادِي",45,"ي",1,0],["إِن غَسا لَيلي أَرِقتُ لَهُ","وَأَرَقتُ الدَمعُ فَاِنغَسَلا",46,"ل",2,0],["إِنْ غَاب فيها بَدْرُ ذِي الد","نْيَا فَبَدْرُ الدينِ حاضِرْ",47,"ر",1,0],["إنْ غرَّةُ كرمُ الدخيل، فطالما","ذُبحَ الفصيلُ بمدية العلاَّف",48,"ف",1,0],["إنَّ غنيمًا، والخفي","فَ: خَبَرٌ، ومُبتدا",49,"د",2,0],["إن غاب عن مِصْرٍ جَمالٌ واحدٌ","فبِمِصْرَ -يَوْمَ الرَّوْع- ألفُ جَمالِ",50,"ل",1,0],["إن غاب حدُّ سلاحهم","فيقينُهم بالله حاضر",51,"ر",1,0],["أُنغَصُّ في الزاد الذي أنا آكلٌ","وأشْرَق بالماءِ الذي أترَّشف",52,"ف",1,0],["إن غاب عنا ففي أولاده عَقِبُ","يحييك ذكراً ، وذكر المرء في العقب",53,"ب",1,0],["إن غبت عم عيني وجنّ الدّجى","سألت عنك القمر الزاهرا",54,"ر",2,0]]}