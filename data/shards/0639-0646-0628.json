{"poems":[[79,"عن باب والدك الرضى لا أبرح","https://www.aldiwan.net/poem36634.html","الكامل"],[47,"لولا تعنفني لقلت المنزل","https://www.aldiwan.net/poem65578.html","الكامل"],[46,"قدك اتئب أربيت في الغلواء","https://www.aldiwan.net/poem30592.html","الكامل"],[50,"قد سقتني والصبح قد فتق الليل","https://www.aldiwan.net/poem10409.html","الخفيف"],[48,"لا ذنب للدنيا فكيف نلومها","https://www.aldiwan.net/poem22844.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55163","البسيط"],[79,"عن باب والدك الرضا لا أبرح","https://www.poetsgate.com/ViewPoem.aspx?id=33552",""],[102,"أسمار القرية","https://www.poetsgate.com/ViewPoem.aspx?id=50334",""],[133,"يا صاحبي لقد غفا","https://www.aldiwan.net/poem67428.html","مجزوء الكامل"],[185,"أسألت مغنى دمنة وطلولا","https://www.aldiwan.net/poem59055.html","الكامل"],[242,"عنبر الخال وكافور الطلا","https://www.aldiwan.net/poem18791.html","الرمل"],[264,"عنبر الجود في أنوف الكرام","https://www.aldiwan.net/poem35759.html","الخفيف"],[280,"لبانة المستهام لبنى","https://www.aldiwan.net/poem25508.html","مخلع البسيط"],[287,"يا عاذلي أقصر فكم تتعب","https://www.aldiwan.net/poem32861.html","السريع"],[376,"جاءنا منك تحفة نحن منها","https://www.aldiwan.net/poem56954.html","الطويل"],[406,"فجر في دجى الأحداث","https://www.aldiwan.net/poem10239.html","عموديه"],[409,"قد قلقنا من تأخركم","https://www.aldiwan.net/poem34128.html","الرمل"],[422,"قل مثلما قد قال عبد الباقي","https://www.aldiwan.net/poem53980.html","الكامل"],[449,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[463,"لو شاء سار ليلة النعف وقف","https://www.aldiwan.net/poem56113.html","الرجز"],[473,"يا من قليب إخائه","https://www.aldiwan.net/poem60453.html","مجزوء الكامل"],[566,"أصبح مسحول يوازي شقا","https://www.aldiwan.net/poem27830.html","الرجز"],[567,"بكل ظبية وحش ظبية الأنس","https://www.aldiwan.net/poem52905.html","البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[580,"قدمت بالنصر وبالمغنم","https://www.aldiwan.net/poem3014.html","السريع"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101525","الرمل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101487","الرمل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145944","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59314","الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25339","الرجز"],[1335,"","https://poetry.dctabudhabi.ae/diwan/poem/198667","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78140","الرمل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115840","الكامل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128721",""],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49092","السريع"],[1753,"","https://poetry.dctabudhabi.ae/diwan/poem/105854","الرمل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106855","الكامل"],[2583,"","https://poetry.dctabudhabi.ae/diwan/poem/128118","الرمل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93893","الرمل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74336","الرمل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87668","الرمل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104375","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89379","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110057","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85196","الرمل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59480","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111463","الرمل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36651","الدوبيت"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21516","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94361","الرمل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136623",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72583","السريع"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76709","البسيط"],[4750,"زيارة","https://www.poetsgate.com/ViewPoem.aspx?id=180413",""],[4750,"الرفيق","https://www.poetsgate.com/ViewPoem.aspx?id=180412",""],[4755,"عَمَّ يَتَحَدَّثُون ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=184735",""],[4755,"عَن نَكبَةٍ فِي عَامِهَا الثَّالِثِ","https://www.poetsgate.com/ViewPoem.aspx?id=191999",""],[4755,"كُلُّ شَيءٍ يَجيءُ بِالبُندُقِيّةْ","https://www.poetsgate.com/ViewPoem.aspx?id=201014",""],[4767,"زورق الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=215314",""],[4980,"أجّ الجَوَى","https://www.poetsgate.com/ViewPoem.aspx?id=191488",""],[5038,"دار السلام","https://www.poetsgate.com/ViewPoem.aspx?id=195233",""],[5233,"غير ُ مُجْد ٍ يا صاحبَيَّ الجدالُ","https://www.poetsgate.com/ViewPoem.aspx?id=37043",""],[5376,"قد شتَّت الدهرُ قلباً كان ماكانا","https://www.poetsgate.com/ViewPoem.aspx?id=191852",""],[5480,"الفداء","https://www.poetsgate.com/ViewPoem.aspx?id=9889",""],[5751,"المعشوق والعاشق","https://www.poetsgate.com/ViewPoem.aspx?id=214763",""],[5952,"عاشوا","https://www.poetsgate.com/ViewPoem.aspx?id=211568",""],[6093,"لا يرقص الظل","https://www.poetsgate.com/ViewPoem.aspx?id=200082",""],[6212,"طائفية أو فيفية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1624&r=&rc=5",""],[463,"لو شاءَ سارٍ ليلة َ النَّعفِ وقفْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60144&r=&rc=200",""],[6268,"شاعر في المنفى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82919&r=&rc=5",""],[201,"يا بني العرب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65293&r=&rc=2",""]],"verses":[["عنْ بابِ والِدِكَ الرِّضى لا أبْرَحُ","يأسُو الزّمانُ لأجلِها أو يَجْرَحُ",0,"ح",1,1],["عَن بَيعَةٍ إِلّا تَكُن عَقَبِيَّةً","فَهيَ الَّتي رَضِيَ الكِتابُ المُنزَلُ",1,"ل",1,0],["عِنَبِيَّةٌ ذَهَبِيَّةٌ سَكَبَت لَها","ذَهَبَ المَعاني صاغَةُ الشُعَراءِ",2,"ا",2,0],["عَن بَنانٍ كَأَنَّهُ قُضُبُ الفِض","ضَةِ قَنّى أَطرافَها الحِنّاءُ",3,"ا",2,0],["عِنبٌ وَخَمرٌ في الإِناءِ وَشارِبٌ","فَمَنِ المَلومُ أَعاصِرٌ أَم حاسِ",4,"س",1,0],["عَنْ بَسْطَةٍ فِي السَّخَاءِ تَكْفِي","مُؤَمِّلِيهِ ذُلَّ السُّؤَالِ",5,"ل",1,0],["عن باب والدك الرضا لا أبرح","يأسوا الزمان لأجلها أو يجرح",6,"ح",1,1],["عن بنات القصور يقطرن طيبا","كرواب من الورود الفرايد",7,"د",1,0],["عن بَقايا ما انَدَثَر","أكذا عَفا الصَرح القديمُ",8,"م",1,0],["عَن باردٍ عَذبِ اللِّثاتِ رُضابُهُ","كالعَذبِ خالطَ بارداً مَعسولا",9,"ل",2,0],["عَنْبَرُ الْخَالِ وَكَافُورُ الطُّلاَ","وَشَقِيقُ الْخَدِّ فَاقَ الْجُلَّنَارْ",10,"ر",1,1],["عنبر الجود في أنوف الكرامِ","فاح في الشام عابقاً في المشامِ",11,"م",1,1],["عَنَّ بِبَدْرِ السّماءِ تِماً","إن وَجْهُها للْعُيونِ عَنَّا",12,"ن",2,0],["عَن بَرَدٍ يَبسِمُ أَو لُؤلُؤٍ","وَعَن أَقاحٍ ثَغرُهُ الأَشنَبُ",13,"ب",1,0],["عنبٌ أسودٌ كأنَّ عليهِ","حُللاً من حَنادسِ الظَّلماءِ",14,"ا",2,0],["عن بيوت الأفغان صارتْ ركاماً","أكْسَبَتْهُ الدماءُ حمرةَ طينِ؟!",15,"ن",1,0],["عنب إن ذقته عسل","وإذا أبصرت قلت ذهب",16,"ب",1,0],["عن بهجة المعشوق يسفر حسنها","ولواعج المشتاق في العشَّاق",17,"ق",1,0],["عن بريق لاح من ضوء سناه","وتمنى ايدسن لو سنحت",18,"ت",1,0],["عنّ به التيهُ فلو كلَّمه","جمالهُ أعرضَ عنه وصدَفْ",19,"ف",1,0],["عِنَبِيَّةٌ أَفعالُها","في مَعزِلٍ عَن كُلِّ عابِ",20,"ب",1,0],["عَن بِيدِ خَرقٍ وَتَغشّى خَرقا","بِمِثلِهِ نَغشى السِهابَ المُقّا",21,"ق",2,0],["عن بَلدةٍ زانَها اللهُ العليُّ بما","أفادَها من عطايا رُوحِهِ القُدُسِ",22,"س",1,0],["عن بعثهم قيل وعن أميرهم","وانصرفوا إلى خلال دورهم",23,"م",1,0],["عن بأْسِه لا يحْتَمي مَعْقِلٌ","والفقرُ إِن ينزلْ به يَحْتَمِ",24,"م",1,0],["عنبريُّ الخال عطريُّ للمى","قَدُّهُ الكافور غصنٌ أملد",25,"د",1,0],["عن بلادِ الشام أمسى راحلاً","يَدَفَعُ السُقمَ بتغييرِ الهوا",26,"ه",3,0],["عن بعضِ ظلِّكَ عن خطوٍ تراهُ وعن","أنفاسِكَ النار عن صوتٍ اليكَ صَدَى",27,"د",2,0],["عِنَبِيَّةٌ ذَهَبِيَّةٌ لَهَبِيَّةٌ","فِي الكَرْمِ في الكَاسَاتِ فِي الأحْشَاءِ",28,"ا",2,0],["عَنْبَسَ أَنْتَ أَوَّلُ الرَبِيِعِ","عَلَيَّ غَيْثاً ناضِرَ المَرِيِعِ",29,"ع",1,0],["عَنْبَسَ قَدْ سَكَّنْتَ مِنْ تَرْوِيعِي","بَعْدَ احْتِضَارِ السَهَرِ التَقْرِيعِ",29,"ع",1,0],["عنب تطلع في حشا ورق ندى","صبغت غلائل خده بالإثمد",30,"د",1,1],["عن بنته التي نوت تعجبا","فاستفهمت برفع فعله أبجا",31,"ج",2,0],["عَن باطِلٍ أو كاهِنٌ يُرَأرِئُ","أَو عَاطِسٌ أَو نَجمُ نَحسٍ مُبطِئُ",32,"ط",2,0],["عَنبَري الخال آسي العذار","خَدَهُ الوَردُ الجَني وَالياسَمين",33,"ن",1,0],["عِنَبِيَّةٌ ذَهبيَّةٌ مُزجت","فترصَّعت باللؤلؤ الرَّطبِ",34,"ب",1,0],["عن بعض معالي بديع وصف معان","قصت بكتاب حوى البيان وتبيان",35,"ن",1,0],["عن بلبلٍ حرّك تغريدُه","ذوائبَ الصّبحِ الجديِ الفتيق",36,"ق",1,0],["عنبريُّ اللونِ في الخلقةِ قد","فاق طيباً كلَّ مشموم وبذّ",37,"ذ",1,1],["عن بثِّ بعضٍ من تعتبه","العتبُ يكثر من تلهبه",38,"ه",1,0],["عنبري الخالِ مسكي اللحا","جوهري الثغرِ دريّ النثار",39,"ر",1,0],["عَن بَرِّهَا وَبَحرُهَا شِعبَان","فِيهِم مَرَاسي كُلّ رِيح كَان",40,"ن",1,0],["عنبري الخال بالخدين","خد في قلبي الشجي خدين",41,"ن",1,1],["عَن بَني عَبد مناف","وَحَوى النجدة لَكن",42,"ن",1,0],["عن بَني راشدَ قد سارَت الى","منزلِ طابَت بِهِ اكؤُسُها",43,"س",3,1],["عن بانه تختال أم عن سوسنه","وبفترة الجفنين ترنو أم سنه",44,"ن",2,1],["عن بحر روض الفضل حدِّث واروِ لي","عن ثابتٍ لشقائق النعمان",45,"ن",1,0],["عن بَذل جُودٍ واصطِناع مكارمٍ","لا يبتغي في بَذلِ معروفٍ بَدَل",46,"ل",1,0],["عنبري الخال مسكي اللمى","ثغره الضحاك والخد الحريري",47,"ر",2,0],["عنبريِ النشرِ عذبٍ طعمه","آخر الليل مُدامٍ قد عَتقْ",48,"ق",1,0],["عن بحر غيغس حيث هيلس وال","هدار هرمس قد سقى الجددا",49,"د",2,0],["عَن بَنِيهِنَّ وَإِخوَانٍ ثِقات","وَبُعُولٍ وَأَخِلاَّ فَأَمَر",50,"ر",1,0],["عَن بارِقَة الثَغرِ إِذا ما اِبتَسَما","فاضَت سُحُبُ الدَمع تُضاهي الدِيَما",51,"م",2,1],["عَن بَنانِ كأَنَّها قُضُبُ الفِض","ضَةِ حنّى أَطرافها الحِنّاءُ",52,"ا",2,0],["عنبريُّ المسك للخال صبا","مذ أتى في طيب أنفاس الملاح",53,"ح",1,0],["عن برق وادي العقيق مبتسماً","أمسى وأمست جَفناي كالديم",54,"م",1,0],["عن باب من ليس سوى بابه","بشراك بالخيبة والرد",55,"د",1,0],["عن بئر زمزم حدثني فبي ظمأ","وانّ في فيك منه الري والحَصَرا",56,"ر",2,0],["عن بنات الكون سبحان فارقها","شوفة ٍ ما هيب شك ٍ ولا ضنّا",57,"ن",2,0],["عن بنوك المال تكفيني جيوبه","كن لي في العاصمة راتب وظيفه",58,"ف",2,0],["عَن بَحثِ مَن ماتُوا عِطَاشًا إلى","أرضٍ تَزُمُّ الماءَ لِلبَاحِثِ ؟",59,"ث",1,0],["عَن بَحثِ مَن ماتُوا عِطَاشًا إلى","أَرضٍ تَصُبُّ النَّارَ لِلبَاحِثِ؟!",60,"ث",1,0],["عَن بِلادٍ طَرِيَّةٍ.. عَن غَزَالٍ","ذَاتِ خَصرٍ، وقَامَةٍ \"عَوْلَقِيَّة\"",61,"ق",3,0],["عن بعضِنا العفوُ بلا مِنَّةٍ","عمَّا ترى النفسُ لها أرحب",62,"ب",1,0],["عَن بُعدِ مُضنًى لا يُبَالِي إن مَضَى","وَالحِبُّ يَحظَى نَشوَةَ العَيشِ الهَنِي",63,"ن",2,0],["عَنْ بَهْجَةِ التّاريخِ لَسْتُ بِغافِلٍ","لكِنَّ جُرْحَ الْحُزْنِ فيهِ أَشْهَرُ",64,"ر",1,0],["عن بطولاتِ العرْبِ لا تسألاني","ربّما بالسكوتِ يُغري السؤالُ!",65,"ل",1,0],["عن بيتنا ذهبوا راحوا بمجْملهم","لم يبق فيهم لنا من كان يهوانا",66,"ن",2,0],["عن بني صهيون ذادت بالتفاني والكفاح","جاعله صدر الأمومة له يذود وما يشوح",67,"ح",1,0],["عن بركةٍ تَسبحُ في شعرِهِ","مياهُها للآنَ لا تستفيقْ",68,"ق",1,0],["عن بلاد تقتل الطير وقد","ترسم الأعلام نسراً وحماما",69,"م",2,0],["عَنْ بَعْضِ شَأْنٍ أَتَاني عَنْهُ أحفظني","وَمَا لِجَهْلِ الَّذِي عَاتَبْتُهُ رشدُ",70,"د",1,0],["عنبيّ الثغرِ لما زارني","أيقظَ الصحراءَ في الصَّبِّ فغنّى",71,"ن",2,0],["عنَّ بهِ النِّيهُ فلو كلَّمهُ","جمالهُ أعرضَ عنهُ وصدفْ",72,"ف",1,0],["عن بني \" يعربٍ \" متى عربد الجبنُ","بأسيافهم ، وماتَ التحدي",73,"د",2,0],["عن بني العربِ يوم سادوا وشادوا","مجدهم بالسيوف والسمهريّة",74,"ي",2,0]]}