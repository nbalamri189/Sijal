{"poems":[[55,"أمل من مثانيها فهذا مقيلها","https://www.aldiwan.net/poem29893.html","الطويل"],[65,"ونفحة من ربا ذي الأثل قابلني","https://www.aldiwan.net/poem45794.html","البسيط"],[65,"علاقة بفؤادي أعقبت كمدا","https://www.aldiwan.net/poem45805.html","البسيط"],[88,"ليلاي ما أنا حي","https://www.aldiwan.net/poem10682.html","المجتث"],[88,"يحييك من أرض الكنانة شاعر","https://www.aldiwan.net/poem68927.html","الطويل"],[95,"نهاية الفخر لي في هذا الكلم","https://www.aldiwan.net/poem11309.html","البسيط"],[90,"سقتنا المعالي من سلافتها صرفا","https://www.aldiwan.net/poem44835.html","الطويل"],[93,"وتينة غضة الأفنان باسقة","https://www.aldiwan.net/poem8825.html","عموديه"],[76,"وألزمته حكم الهوى فالتقى به","https://www.aldiwan.net/poem13247.html","الطويل"],[48,"أما وفؤاد بالغرام قريح","https://www.aldiwan.net/poem22295.html","الطويل"],[48,"ساء بريا من البرايا","https://www.aldiwan.net/poem23609.html","مجزوء البسيط"],[92,"عبادة الشر","https://www.poetsgate.com/ViewPoem.aspx?id=179136",""],[154,"مقامات أهل الدين عند بني الدنيا","https://www.aldiwan.net/poem68514.html","الطويل"],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[314,"ولم يطلب علو القدر فيها","https://www.aldiwan.net/poem50278.html","الوافر"],[385,"لمن طلل بالجزع قفر جوانبه","https://www.aldiwan.net/poem48837.html","الطويل"],[466,"أأهجع أم آوي إلى لين مرقد","https://www.aldiwan.net/poem15111.html","الطويل"],[556,"ما صيد قلبك إلا بابنة الكلل","https://www.aldiwan.net/poem47265.html","البسيط"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107232","الوافر"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66744","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145926","الرجز"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67843","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84506","البسيط"],[1491,"","https://poetry.dctabudhabi.ae/diwan/poem/107315","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79804","السريع"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88672","الطويل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26194","البسيط"],[2653,"","https://poetry.dctabudhabi.ae/diwan/poem/45325","الوافر"],[3162,"","https://poetry.dctabudhabi.ae/diwan/poem/142906","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87391","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89424","الوافر"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123528","الرجز"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35500","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58179","الرجز"],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5442,"تذكر بالحمي عهداً برامه","https://www.poetsgate.com/ViewPoem.aspx?id=114756",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""]],"verses":[["وَلَم يَطوِها بِالحِلمِ فَضلَ زِمامِها","فَتَعثُرَ فيهِ عَثرَةً لا يُقيلُها",0,"ل",3,0],["وَلَم يَطِب تُربُها مِن رَوضَةٍ أُنُفٍ","فَهاجَ رَيّاهُ أَطراباً وَأَشجانا",1,"ن",2,0],["وَلَم يُطِقْ ما يُعانيهِ فَغادَرَني","بَينَ النَّقا وَالمُصَلَّى عِندَها وَمَضى",2,"ض",2,0],["وَلَم يُطيقوا ثَباتاً","في أَوجُهِ الفُرسانِ",3,"ن",1,0],["وَلَم يُطلِقوا في يَومِ ذِكراهُ مِدفَعاً","وَلَم يُزهِقوا نَفساً وَلَم يَتَقَحَّموا",4,"م",3,0],["وَلَمْ يُطَالِعْ وَيَسْتَظْهِرْ رَوَائِعَهُ","مَا بَيْنَ مُنْتَثِرٍ مِنْهَا وَمُنْتَظِمِ",5,"م",1,0],["ولم يَطُلبِ الإمهال إِلاّ لأّنه","رأى عذره إِن لم يُطل سبكه زيفا",6,"ف",2,0],["وَلَم يُطِق صاحِبُ البُستانِ رُؤيَتَها","فَاِجتَثَّها فَهَوَت في النارِ تَستَعِرُ",7,"ر",1,0],["وَلَم يَطوِ شِعرٌ قَبلَهُ مِن سَريرَةٍ","وَلَكِن أَشعارَ الكِرامِ كِرامُ",8,"م",1,0],["وَلَم يَطَّرِحكِ المَرءُ عَنهُ لِعِبرَةٍ","يَراها بِمَرفوتِ العِظامِ طَريحِ",9,"ح",1,0],["وَلَم يُطِل سامِري حَديثي","بَل عِشتُ في الدَهرِ سامِرِيّا",10,"ر",3,0],["ولم يَطُلِ العهدُ حتى انجلت","كوارثُ ما هنّ بالسرمد",11,"د",1,0],["ولم يطلبوا إلا رضا الله وحدَه","ولو أسخطوا هذا الأنام بلا ثنيا",12,"ي",2,0],["وَلَم يطوِ دهرٌ حلّة من فضيلة","غَدت من صوان الشعر تنشُرها الأنبا",13,"ب",2,0],["وَلَم يَطلُب عُلُوَّ القَدرِ فيها","وَعِزَّ النَفسِ إِلّا كُلُّ طاغِ",14,"غ",1,1],["وَلَم يَطفِ لي دَمعي غَليلاً وَإِنَّما","يبرّد حَرَّ الرَمل حَوليَ ساكِبهُ",15,"ب",2,0],["ولم يُطق العجلان في قبس ضرمةٍ","حفاظاً لما يعروه من رعشةِ اليد",16,"د",1,0],["وَلَم يَطُر بِيَ لولا حبُّها غَزَلٌ","فساقني حسنُها كرهاً إلى الغَزَلِ",17,"ل",1,0],["ولَم يطِبِ الهَوى إِلا لِعفٍّ","يَصُدُّ عن المَوَارِدِ وهوَ صادِ",18,"د",1,0],["ولم يُطْعِما خَلقاً من الناسِ بِضعةً","ولا حسوةً من ذاك حتى تَضلَّعا",19,"ع",2,0],["ولمْ يَطأهُ واطِيءٌ أحداقكمْ","فوَّهَةً كانتْ لهَا اتقادْ",20,"د",1,0],["وَلَمْ يُطْفِهَا عَنَّي سِوَى بَرْدِ لُقْيَاهُ","جَلاَ ظُلَماً عَنَّا بِنُورِ صَبَاحِهِ",21,"ه",1,0],["ولم يطر طائرٌ في أُفقه أبداً","إلاّ وحلّ به نوعٌ من السَقَمِ",22,"م",1,0],["ولَم يطِب بعدَهُ العيشُ الهنيءُ لنا","كلا ولم يُغنِنا شَخصٌ به بَدَلُ",23,"ل",1,0],["ولم يطأ عرش العُلا راضياً","مَن لم يطأ شوكَ القنا مغضبا",24,"ب",2,0],["وَلَم يطق الكتمان بل صار معلنا","اتوذى لظى عبدا غدا بك مؤمنا",25,"ن",2,0],["وَلَم يَطِب قَطُّ لي مَنٌّ يَلَذُّ وَلا","سَلوى إِذا كانَ في عُقباهُما مَغَصُ",26,"ص",1,0],["وَلَم يَطرُدنَ أَبقَعَ يَومَ نَجدٍ","وَلا كَلباً طَرَدنَ وَلا غُرابا",27,"ب",2,0],["ولم يطعموا الا الذي قد طعمته","وذلك تكريم عجيب محبّبُ",28,"ب",1,0],["وَلَم يطلُب من الدنيا سوى ما","يفيد النفس من اثرٍ جليلِ",29,"ل",1,0],["ولم يطمح ولم يجفل ولا ذو","حران ولا ندوب ولا نعي",30,"ي",1,0],["ولم يطرب إلى حبلى فهيم","لدى التعليم يقهره الصبي",30,"ي",1,0],["ولم يطُلْ لَيلِي ولكنَّ الجوى","يُعِيدُ ليلَ الصيفِ من ليل الشِّتَا",31,"ا",1,0],["وَلَم يَطف نارَ الهَمّ مِثلَ زُجاجةٍ","تَشجّ حميّاها بِماء رضابِ",32,"ب",1,0],["ولم يُطلْ في كل حِينٍ درسَهْ","ولم يَكِدَّ عندَ ذاكَ نفسَهْ",33,"ه",1,0],["ولم يطق ردها عما دعته له","فجذها بائنا صعب تلافيها",34,"ي",3,0],["ولم يطربه الأذكر سلع","ورامة لاسعاد ولا أمامه",35,"م",2,0],["ولم يطلع كون على بدء أمره","بعالم أرواح وأول برزتي",36,"ت",2,0]]}