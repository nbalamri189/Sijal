{"poems":[[91,"ما الشعر الا نغم","https://www.aldiwan.net/poem44737.html","مجزوء الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39539","الرمل"],[108,"شعر الماحي","https://www.poetsgate.com/ViewPoem.aspx?id=179364",""],[108,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[193,"يا نبيا لدى الإله عظيما","https://www.aldiwan.net/poem35102.html","الخفيف"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[199,"ليت شعري هل تخبرني الديار","https://www.aldiwan.net/poem54408.html","الخفيف"],[234,"قد أغتدي والليل في دجاه","https://www.aldiwan.net/poem51274.html","الرجز"],[236,"لولا شذا من نشركم ينشق","https://www.aldiwan.net/poem44579.html","السريع"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[469,"ظبيات الحمى وبانات سلع","https://www.aldiwan.net/poem3521.html","عموديه"],[510,"رجعة الأنبياء","https://www.aldiwan.net/poem42461.html","الخفيف"],[563,"أشكر الله خالقي في البريه","https://www.aldiwan.net/poem33560.html","الخفيف"],[563,"هي قامت بنفسها لذويها","https://www.aldiwan.net/poem33637.html","الخفيف"],[563,"عم صباحا أيها الطلل","https://www.aldiwan.net/poem34224.html","المديد"],[563,"صحن صحناء واسع الأطراف","https://www.aldiwan.net/poem34340.html","الخفيف"],[563,"أنا كالحرف قائم بالمداد","https://www.aldiwan.net/poem34616.html","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87217","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38209","الرمل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71027","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62519","الخفيف"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216887","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108773","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28055","الخفيف"],[2420,"","https://poetry.dctabudhabi.ae/diwan/poem/95956","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93867","الخفيف"],[4488,"","https://poetry.dctabudhabi.ae/diwan/poem/131003","الرجز"],[3464,"الحمد مقصور عليه ذي السنا","https://www.poetsgate.com/ViewPoem.aspx?id=158703",""],[5145,"من لبرقٍ على البراق أنارا","https://www.poetsgate.com/ViewPoem.aspx?id=108062",""],[5338,"لطيبة الغراء شدوا الرحال","https://www.poetsgate.com/ViewPoem.aspx?id=187891",""],[5691,"نجوم وبشر","https://www.poetsgate.com/ViewPoem.aspx?id=206118",""]],"verses":[["وهو شعور لشعو","ر السامعيه يضرم",0,"م",1,0],["وهو شعرٌ صَورتْ ألوانُه","بهجةَ الفجرِ وأحزان الشفقْ",1,"ق",1,0],["وَهْو شعر أشهى إلى كلِّ نَفْسٍ","من جَنَي النحلِ، أو رُضَاب الملاح",2,"ح",1,0],["وَهْوَ شاكٍ من الطَّوى، لاصِقٌ بال","أرض، يَجتَرُّ حلقُه أوصَابه!",3,"ب",2,0],["وَهوَ شمسُ الهُدى وبدر الصوابِ","وَمِنَ اللَّه قَد أتاكَ نُجوما",4,"م",2,0],["وَهو شثنُ الأطرافِ ضخمُ الكرا","ديسِ لكن رجلهُ خمصاءُ",5,"ا",2,0],["وَهوَ شاحٍ كَأَنَّ لَحيَيهِ حِنوا","قَتَبٍ لاحَ مِنهُما النَجارُ",6,"ر",1,0],["وهو شديد العَدْوِ لاسْتَوطاه","ولم يَطِرْ عن جفنه كَراه",7,"ا",2,0],["وهو شفيع منقذ في غدٍ","مَن بالخطايا في لظىً موثق",8,"ق",1,0],["وهو شرٌّ لخالد قيّد العقل","وأخفى تحت المخاوف سرّا",9,"ر",2,0],["وهو شرع الهوى وحاكمُ دينِ","الحسن يدعو إلى اتّباعِ الشرع",10,"ع",1,0],["وهْوَ شِئْتَ أمْ لمْ تشأْ حقُّ أمٍّ","ذاكَ تأويلُ قولِهمْ: مَرْحومُ",11,"م",1,0],["وهو شكر الإله لا هو شكري","يتجلى الشكور رب البريه",12,"ي",2,0],["وهو شرك إذا تأملت فيه","قد خفي عنك فاطلب التنبيها",13,"ي",3,0],["وهو شأن الحق يسفر عن","نشأة بالنقص تكتمل",14,"ل",1,0],["وهو شهم مهذب يتسامى","كل وقت عن كل شيء منافي",15,"ف",2,0],["وهو شيب في لمة الشعر يبدو","عبرةً فافهموا كلام المنادي",16,"د",2,0],["وَهوَ شَمس تمدّ بِالنُور مِنها","كُلَّ نَجمٍ ظَلامُه قَد كَساه",17,"ا",2,0],["وَهوَ شَمسُ الحسنِ وهو القمرُ","مِن ذُرى السّعدِ بِأَعلى منزلِ",18,"ل",1,0],["وهْو شجاعٌ طاعنٌ وضاربُ","لدى الوغى مكافحٌ محاربُ",19,"ب",1,0],["وهو شهم مجرَّب","مثل سيف مجرَّد",20,"د",1,0],["وهو شاحٍ كفكةِّ القتبِ المجْ","لب شدّ القَرَا عليهِ الإطارُ",21,"ر",1,0],["وهو شاه الوغى الذي كل قرمٍ","غيره في سياسة الجيش بيدق",22,"ق",1,0],["وهو شرع مقرَّر مستفادٌ","جاء بالكاف نوره يتلالا",23,"ل",2,0],["وهو شديدٌ لفظُهُ وذَكرُه","مَن يشتري سيفي وهذا أَثَرُه",24,"ه",1,0],["وهو شيخ الشيوخ مولى الموالي","صفوة الصفو خيرة الأخيار",25,"ر",1,0],["وهو شديدُ البخل لكن يدعي","مع ذاك حكمة الحريص اليلمعي",26,"ي",1,0],["وهو شفيع وحبيبٌ محسنٌ","خير حسيب بهدايتي دعا",27,"ا",1,0],["وهو شمس الزمان يجلو دجاه","فمذ انحاز ضوءه ما أنارا",28,"ر",2,0],["وَهْوَ شَفيعُ الْخَلْقِ إِنْ أَخْلَقَتْ","وُجوهَنَا مِنَّا الْذُّنوبُ الثِّقَالْ",29,"ل",1,0],["وهْوَ شيْطانٌ رَجيمٌ سادِرٌ","في هَوى النَّفْسِ ويبْقى سادِرا",30,"ر",2,0]]}