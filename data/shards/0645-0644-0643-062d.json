{"poems":[[3,"يا أيها الملك الذي راحاته","https://www.aldiwan.net/poem213.html","الكامل"],[74,"قام يرنو بمقلة كحلاء","https://www.aldiwan.net/poem18165.html","الخفيف"],[53,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[53,"يا طول غلة نفسي المبلاه","https://www.aldiwan.net/poem66717.html","الكامل"],[87,"العيد هلل في ذراك وكبرا","https://www.aldiwan.net/poem6817.html","الكامل"],[47,"ردي على المشتاق بعض رقاده","https://www.aldiwan.net/poem63494.html","الكامل"],[47,"لي حبيب قد لج في الهجر جدا","https://www.aldiwan.net/poem63498.html","الخفيف"],[63,"حرق تمتري الدموع سجالا","https://www.aldiwan.net/poem51461.html","الخفيف"],[68,"دبت عقارب صدغه في خده","https://www.aldiwan.net/poem41362.html","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9983","الكامل"],[164,"رقص جياد الظبا في حلبة اللعب","https://www.aldiwan.net/poem59045.html","البسيط"],[173,"أنخ فهذي قباب العز والكرم","https://www.aldiwan.net/poem1676.html",""],[325,"أي وقت وأي هائل طقس","https://www.aldiwan.net/poem61667.html","الخفيف"],[333,"هائم الروح بالهوى والأماني","https://www.aldiwan.net/poem54990.html","الخفيف"],[358,"يا مالك الملك العزيز","https://www.aldiwan.net/poem39573.html","مجزوء الكامل"],[543,"ضنت بهذا اليوم قبل عصور","https://www.aldiwan.net/poem48154.html","عموديه"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70724","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119863","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120021","الرمل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61017","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64967","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64713","الكامل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122026","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80016","الرمل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69391","الكامل"],[2096,"","https://poetry.dctabudhabi.ae/diwan/poem/144617","المديد"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53177","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53135","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53236","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93681","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137392",""],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65118","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77136","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72776","الكامل"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116070","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139621",""],[5302,"يا خادم الحرمين","https://www.poetsgate.com/ViewPoem.aspx?id=200944",""],[5690,"دع عنك تشبيباً بوصف محاجرِ","https://www.poetsgate.com/ViewPoem.aspx?id=172161",""],[5956,"يا مؤسس العقل العروبي النَّيِّر الخيِّر","https://www.poetsgate.com/ViewPoem.aspx?id=194754",""]],"verses":[["مَلِكٌ حَوى رُتَبَ المَعالي كُلَّه","بِسُمُوِّ مَجدٍ حَلَّ في إيوانِهِ",0,"ن",2,0],["ملك حافظ المناقب تروي","راحتاه عن واصل عن عطاء",1,"ا",2,0],["مَلِكٌ حلَّ من سماءِ المعالي","فوق شمسِ الضُّحى وبدرِ الظلام",2,"م",1,0],["ملك حلا مَخْبورُه ورواؤه","فحلا على الأسماعِ والأفواه",3,"ه",1,0],["مُلك حسودك فيه ليس بعاقل","من ذا يعادى الله والمدثِّرا",4,"ر",2,0],["مَلِكٌ حَكى الخُلَفاءَ مِن آبائِهِ","وَتَقَيَّلَ العُظَماءَ مِن أَجدادِهِ",5,"د",2,0],["مَلِكٌ حَصَّنَت عَزيمَتُهُ المُل","كَ فَأَضحَت لَهُ مُعاناً وَرِدّا",6,"د",2,0],["مَلِكٌ حازَ قِمّةَ الفَخرِ لمّا","عُدَّ للفَخرِ مِن عديٍّ رِجالا",7,"ل",2,0],["مَلِكُ حَوى رُتَبَ الفَخارِ بِسَعيِهِ","وَالمُلكَ إِرثاً عَن أَبيهِ وَجَدِّهِ",8,"د",2,0],["مَلِكٌ حَوى رُتَبَ المَعالي كُلَّها","بِسُمُوِّ مَجدٍ حَلَّ في إيوانِهِ",9,"ن",2,0],["ملك حمى بيضة الإِسلام مقتديا","بمحكم النص عن آياته النجب",10,"ب",1,0],["مَلِكٌ حَمى جَنَباتِ المُلكِ مُعتَزِماً","بِالسَيفِ لا بِيَراعٍ غُطَّ في جَمَمِ",11,"م",1,0],["مُلكُ حامِلٍ لِذي الأَعباءِ","مِثلُهُ لا يَجيءُ في الأَحياءِ",12,"ا",2,0],["ملكٌ حينما يشاء له الفنّ","عزيزُ المقام والصولجان",13,"ن",1,0],["ملك حَوى كُلّ الكَمال","وَسَما بِهِ عَرش الخِلافَه",14,"ه",1,0],["مَلِكٌ حَباهُ اللهُ حُبَّ بِلاَدِه","فبِحُبِّها ودُعائِها مَمطُورُ",15,"ر",1,0],["مَلْكٌ حوَى الدينَ فأنفق دُنْ","ياه على الدين وازدادتْ له النعم",16,"م",1,0],["ملك حبانا بالتلاد وهمّنا","بالجود أَنجدَ في البلاد وأتهما",17,"م",2,0],["ملك حلو مجاني ال","عفو مرّ الانتقامِ",18,"م",1,0],["ملك حلاحل لا خلاك وَمشرب","حلو حلال وَخُضرة محلال",19,"ل",1,0],["مَلْكٌ حَمى ثَغْرَنا مِنْ بَعدِ ضَيْعَتِهِ","وأَوْجَدَ الْعدْلَ فينا بَعْدَ فِقْدانِ",20,"ن",1,0],["مَلكٍ حَماسَةُ بَأْسِهِ","مَقْرونَةٌ بِسَماحِهِ",21,"ح",2,0],["مَلِكٌ حَكَى كِسْرَى وَقَيْصَرَ إِذْ سَطَا","وَزَرَى بِهَامَانٍ وَفَاقَ قُبَاذَا",22,"ذ",2,0],["ملكٌ حيًّا وميتاً قد أبى","قدرُه إلاَّ الرواقَ الأرفعا",23,"ع",2,0],["مَلِكٌ حَباني بالجَميلِ فَواجِبٌ","أَلّا أُرى في حُبِّهِ بِمُحابِ",24,"ب",1,0],["ملك حاز العلى وأذل","ل العدى واستعبد الزمنا",25,"ن",2,0],["ملك حدثه عن يوم ندى","أو فحدث عنه في يوم نِزال",26,"ل",1,0],["ملك حمى حلب العواصم ذَبُّه","عن هضب جوشنها وعن بطياسها",27,"س",3,0],["ملك حمى اليمن الأقصى بهيبته","والأسد من حولها يخشى ضواريها",28,"ي",3,0],["مَلك حَباه اللَه رُتبة عَمه","وَبِوَجهه سَعد العُلى يَتَهلل",29,"ل",1,0],["ملك حباه الله آية نصره","واتاحه حسن العزيمه والهمم",30,"م",1,0],["ملكٌ حليمٌ عدلهُ مُتواترٌ","وإليه في الفعل الجميل يُشارُ",31,"ر",1,0],["مَلِكٌ حَليف مَكارِم لا تَنتَهي","وَرَضيعُها مِن يَومِ بِدءِ المَولِد",32,"د",1,0],["مُلكٌ حَكَى مُلك سليمانَ الَّذي","لم يَتجه لغيرهِ ولا انبغى",33,"ا",1,0],["ملك حوى الاجلالَ بال","ذات المطهرةِ المذاهِب",34,"ب",1,0],["ملكٌ حِماهُ جنَّةٌ لعُفاتِهِ","لكنّه للحاسدين جَهَنّمُ",35,"م",1,0],["ملكٌ حُفَّ في جنودٍ من الل","ه ومن جمِّ عزمه في جنود",36,"د",1,0],["ملك حوى رتب المعالى واعتلى","بسمو أمجاد وواسع جود",37,"د",1,0],["ملك حوى النسب الصحيح مسلسلاً","وحوى المعاليَ كابراً عن كابرِ",38,"ر",1,0],["ملِكٌ حريص أن يُحقق حلمه","ونرى قريباً كلَّ شرٍّ طهَّرهْ",39,"ر",2,0]]}