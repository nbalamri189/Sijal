],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5356,"همسُ اشتياقٍ","https://www.poetsgate.com/ViewPoem.aspx?id=204474",""],[5376,"صنت نفسي من رميةٍ بسهامِ","https://www.poetsgate.com/ViewPoem.aspx?id=188313",""],[5438,"تَكْوِينٌ لِذَاتِي","https://www.poetsgate.com/ViewPoem.aspx?id=202094",""],[2110,"كرعتها وحباب الكأس مشتبك","https://www.poetsgate.com/ViewPoem.aspx?id=156284",""],[5652,"طفله تناجي وردة الحلم ل التيه","https://www.poetsgate.com/ViewPoem.aspx?id=179842",""],[5725,"عشقت بعينيك","https://www.poetsgate.com/ViewPoem.aspx?id=181097",""],[5776,"فراغُ الفهارس","https://www.poetsgate.com/ViewPoem.aspx?id=199333",""],[5781,"مدنٌ فارغةٌ من وطن","https://www.poetsgate.com/ViewPoem.aspx?id=198833",""],[5943,"تشطير لقصيدة ( صوت الشغاف )","https://www.poetsgate.com/ViewPoem.aspx?id=92987",""],[5953,"لاح ضياء القمر الزاهر","https://www.poetsgate.com/ViewPoem.aspx?id=93849",""],[5956,"صورة من رضاء الأبوين","https://www.poetsgate.com/ViewPoem.aspx?id=192575",""],[5970,"شيخ بقارعة الطريق معمم","https://www.poetsgate.com/ViewPoem.aspx?id=130663",""],[6031,"لي إنْ تَحَامَاني أَخٌ وحَميمُ","https://www.poetsgate.com/ViewPoem.aspx?id=46275",""],[161,"بين الأرض والسماء حياة","https://www.poetsgate.com/ViewPoem.aspx?id=202596",""],[6127,"البشرى","https://www.poetsgate.com/ViewPoem.aspx?id=204472",""],[6237,"وحشة قلب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77896&r=&rc=38",""]],"verses":[["كَهِلالِ السَحابِ ما غابَ حَتّى","رَقَّ عَن وَجهِهِ الغَمامُ فَشَفّا",0,"ف",2,0],["كَهلُ الحِجى عَرُضَتْ مَنادِحُ رأيِهِ","والغُصْنُ مُقتَبِلُ النَّباتِ وَريقُ",1,"ق",1,0],["كهْفٌ لَجأ الإسْلامُ لهُ","فعَفا وحَمَى وكَفَى ووَقَى",2,"ق",2,0],["كهْفُ الأنامِ إذا تفاقَمَ مُعْضِلٌ","مَثَلوا بساحَةِ بَابِهِ المَفْتوحِ",3,"ح",1,0],["كَهَمِّكَ في الخَلاعَةِ وَالتَصابي","وَإِن كانوا عَلى خُلُقٍ عَظيمِ",4,"م",1,0],["كهُوفُ نُورٍ شَادَهَا سَاخِراً","شُعَاعُ تِلْكَ الشُّغْلِ الطَّاغِيَهْ",5,"ي",2,0],["كهُولة ما أوقد المحلفو","ن للحالفين وما هوَّلوا",6,"ل",3,0],["كَهَمزَةِ ضَيغَمِ يَحمي عَريناً","شَديدِ مَغارِزِ الأَضلاعِ خاظي",7,"ظ",2,0],["كهمّ الخليِّ اسودَّ فرعٌ ومَكْحلٌ","لها خِلقةً وابيضَّ ثغرٌ ومَلْغمُ",8,"م",1,0],["كهَدْمِ المُشْركينَ بيوتَ سُوءٍ","بأيديهِمْ وأيدي المؤمنينا",9,"ن",2,0],["كَهُداهِدٍ كَسَرَ الرُماةُ جَناحَهُ","يَدعو بِقارِعَةِ الطَريقِ هَديلا",10,"ل",2,0],["كَهفُ القَضِيَّةِ لا تَنامُ نُيوبُهُ","عَنها وَلا تَتَناعَسُ الأَظفارُ",11,"ر",1,0],["كَهفٌ إِذا اِستَذرى العُفاةُ بِظِلِّهِ","لَجَأوا إِلى كَنَفٍ رَحيبٍ مُخصِبِ",12,"ب",1,0],["كُهولٌ وَشُبّانٌ مَساعيرُ في الوَغى","لَهُم بِالقَنا أَيدٍ طِوالُ الأَشاجِعِ",13,"ع",1,0],["كَهَمِّكَ إِن تَجهَد تَجِدها نَجيحَةً","صَبوراً وَإِن تَستَرخِ عَنها تَزَيَّدِ",14,"د",1,0],["كَهفُ الضُيوفِ وَوَهّابُ الأُلوفِ وَجَد","داعُ الأُنوفِ وَأَمنُ الخائِفِ الشاكي",15,"ك",2,0],["كهَصورٍ في كفّه الظُّفْرُ عَضْبٌ","وغريرٍ في صدره النهدُ حقُّ",16,"ق",1,0],["كَهلُ الأَناةِ فَتى الشَذاةِ إِذا غَدا","لِلحَربِ كانَ القَشعَمَ الغِطريفا",17,"ف",2,0],["كهولٌ بنادي السلم قد عقدوا الحُبى","شبابٌ إذا ما ضَجّ في الحيّ صُرَّخ",18,"خ",1,0],["كَهِزَّةِ العَضبِ الذَكَر","ما حَسَّ مِن شَيءٍ هَبَر",19,"ر",1,0],["كُهولٌ وَشُبّانٌ عَلَيهِم مَهابَةٌ","وَفيهِم غَناءٌ لِلعَوانِ وَلِلبَكرِ",20,"ر",1,0],["كُهولٌ عَتَوا في سِنِّهِم وَكَأَنَّهُم","غُصونٌ عَلى مَيسِ الرَكائِبِ مُيَّدُ",21,"د",1,0],["كُهُولاً وَشُبَّاناً كأَنَّ وُجُوهَهُم","دَنانِيرُ مِمَّا شِيفَ في أَرضِ قَيصَرا",22,"ر",2,0],["كهِلاَلِ الشّكّ لولا أنَهُ","أنّ عَيني عَيْنَهُ لم تتأيْ",23,"ي",1,0],["كهزار قد نزا","فوق غصن خضرا",24,"ر",2,0],["كهِلالِ الحَياةِ أو كقَميصٍ","لِهلالِ الحَيّاتِ غيرِ مَجُوب",25,"ب",1,0],["كهلٍ على الأمر قويّ الكاهل","بين الحواريّ وبين العاهل",26,"ل",1,0],["كَهَوَاكَ لِلأَوْطَانِ فَلْيَكُنِ الهَوَى","لاَ مُفْتَرىً فِيهِ وَلاَ مُتَكَلَّفَا",27,"ف",2,0],["كهواءٍ بلا هباءٍ مَشوبٍ","بضياء أَرقِقْ بذاك وأصف",28,"ف",1,0],["كَهْلٌ تَصابَى وَيْحَ أَشجانِه","حَتَّامَ لا دُنْيا ولا باقِيَةْ؟",29,"ي",2,0],["كهف الخلافة كافيها وكافلها","وما عهدنا له في القرن أمثالا",30,"ل",2,0],["كَهلُ الشَبيبَةِ نَهّابُ الحَريبَةِ وَه","هاب الرَغيبَةِ هَشٌّ بِالنَدى عَجِلُ",31,"ل",1,0],["كهشيمٍ تحطّمتْ أمنياتي","هجَرتني ما نلتُ يوماً مرامي",32,"م",2,0],["كهف تسعى الشعراء له","زمرا كالنمل وتقصده",33,"د",2,0],["كهف الندى من اليه تهرع الشعرا","في العسر كالنمل احزابا وهم زمر",34,"ر",1,0],["كَهْفُ الوَرى الْحَسَنُ الذِي","دِينُ الإِلَهِ به مُؤَيَّدْ",35,"د",1,0],["كهل كَبير وأطفال وَحاشية","لا يقدرون عَلى التَحويل وَالنقل",36,"ل",1,0],["كهف المرجين كنزا السائلين اذا","غبر السنين كمت أَنواؤها المطرا",37,"ر",2,0],["كهامةٍ من لُجَيْن","في قامةٍ من زَبَرْجَدُ",38,"د",1,0],["كَهُوَ بَيانُ العَدلِ في تَكليفِهِ","فيهِ بَفَضلِ غمِرِ الكَونِ عَمَر",39,"ر",1,0],["كهف السِيادَةِ كَنز المَجدِ مَعدَن أَس","رار البَلاغَة من بِالعز قَد عرفا",40,"ف",2,0],["كَهف اِذا شاهَدت عَيناكَ طَلعَتُه","تَجَدّدت لَكَ في الحالِ المَسَرّات",41,"ت",1,0],["كَهْفُ الإمام إذا أوى منه إلى","رَأْيٍ أفاء عليه ظِلَّ سَداد",42,"د",1,0],["كَهِمَّةِ ابنِ عُبَيدِ اللَّهِ ما رَضِيت","مِن المَعالي بِما تَرضَى لَه الهِمَمُ",43,"م",1,0],["كهف اللَهيفِ وَروض مرتاد النَدى","وَغِنى الفقير وَأوبة المتغَرِّبِ",44,"ب",1,0],["كهجر الحائمات الورد لما","رأت انّ المنية بالورود",45,"د",1,0],["كهاة تريع لصوت مهيب","لغير هواها الشجي ما ظعن",46,"ن",1,0],["كهامٌ إذا كان الموالي ضريبةً","لديه ولكن في نُحورِ العِدى عضْب",47,"ب",1,0],["كهلة إن تسترت أو تعرت","شيب منها الجمال بالانقباض",48,"ض",1,0],["كهفُ الوَرى غيثُ الصّريخِ مَعاذُهُ","وكَفيلُ نجدَتِهِ وحِصْنُ أمانهِ",49,"ن",2,0],["كُهَناءُ غَيبٍ يعلمونَ فراسةً","قبلَ الوُقوعِ حقائقَ الأشياءِ",50,"ا",2,0],["كَهرَبتنِي إِذ أقبلَت تُظهِرُ البش","رَ وحيَّت بالإبتسَام بِتيتُ",51,"ت",1,0],["كَهَيقِ الدَّوِّ لولا وض","عُ أنساعِي وأقتادِي",52,"د",2,0],["كهْف حماكم له مَلاذٌ","يا حبَّذا الكَهْف والرَّقيمُ",53,"م",1,0],["كهُبوبِ الصَّبَا تَوَسَّطُ حالاً","بَيْنَ حَالَيْنِ شِدَّةً ورُكُودِ",54,"د",1,0],["كَهْلُ الحداثَةِ نَظَّارٌ بِفطْنَتِه","إِلى العَواقِبِ ريَّانٌ مِنَ الفِطَن",55,"ن",1,0],["كهف الأنام وغوثها مَن لَم يَزل","بالفضلِ والمعروف غير ضنينِ",56,"ن",1,0],["كهف كلّ الأنام في كلِّ أمرٍ","وهو طودٌ مِن أعظم الأطوادِ",57,"د",1,0],["كَهف المَعارف وَاللَطائف وَالنَدى","وَالفَضل وَالمَجد الأَثيل الفاخر",58,"ر",1,0],["كَهفُ العُفاةِ وَللقُصّادِ كَعبَتُهم","فَلِلمَقاصِدِ مَحجوجٌ وَمَقصودُ",59,"د",1,0],["كهف كفي حين تطرحها","بين أيدي القوم تبترك",60,"ك",1,0],["كُهولٌ وَمُردٌ مِن قُضاعَةَ حَولَهُ","مَساعيرُ أَبطالٌ إِذا النِكسُ عَرَّدا",61,"د",2,0],["كهف العلوم خفيِّها وجليِّها","لا زال منفرداً بحلَّ المشكلِ",62,"ل",1,0],["كهناء تيمور الهُمام","بمن بها اليوم ابتنى",63,"ن",2,0],["كهف البرية مظهر الاسلام نصّ","اب الأئمة في الصلاح الشاملِ",64,"ل",1,0],["كهف الأرامل مأوى كل ملتمس","عون اليتامى ملاذ العبد ملجاه",65,"ا",2,0],["كهف منيع ما أويت لظله","إلا أويت إلى رحيب مصرع",66,"ع",1,0],["كَهْفٌ سَمَا فِي عُلا المفاخِرْ","بِأنْعُمٍ وِرْدُهَا مُبَاحْ",67,"ح",1,0],["كهف الرجا وسط عقود الإلتجا","بحر الندى خصب الزمان الممحل",68,"ل",1,0],["كَهْفٌ تَعَالَى عَلَى العَلْيَاء مَجْلِسُهُ","فَكَاتَبَتْهُ العُلاَ بِالْمَجْلِسِ العَالِي",69,"ل",2,0],["كَهِشام فَإِنَّهُ خَلَعَ الرِب","قَةَ مِن كُلِّ حُرمَةٍ وَذِمام",70,"م",1,0],["كَهفِ الأَنامِ أَميرِ المُؤمِنينَ وَمَن","بِالأَمنِ يا مِلَّةَ التَوحيدِ أَولاكِ",71,"ك",1,0],["كَهْفُ تَمِيمٍ كُلِّها وَسَعْدِ","إِنِّي وَسَعْدِي عَدَد الأَعَدِّ",72,"د",1,0],["كهف الارامل غوث للطريدهما","م في الشدايد ملجا كل لهفان",73,"ن",1,0],["كهفي إذا جار الزمان وملجأي","وبه ولعت هناك في الاشهاد",74,"د",1,0],["كهف اليتامى فرد ارباب الندا","ومساعد الوراد بالاعطاء",75,"ا",2,0],["كهف اليتامى امام القطر من ظهرت","منه الكرامات في سهل وفي جبل",76,"ل",1,0],["كها وهو وهي فتنشأ الألف","عن فتحها والواو عن ضم ألف",77,"ف",1,0],["كهاجِر أَحْبابَهُ زائِرٍ","أَطْلالَهُم مِن بَعْدِ أَن يَرحَلوا",78,"ل",3,0],["كهف تفيأه الورى بظلاله","مسترفدين لمنحه ونواله",79,"ل",2,1],["كُهولٌ مَعقِلُ الطُّرَداءِ فيهم","وفتيانٌ غَطارفةٌ فروعُ",80,"ع",1,0],["كهول وشبّان ترى كلّ سيدٍ","عزيزٍ مطاع كالفتيق إذا احتسبى",81,"ب",2,0],["كهلان سيد قومه بن محمّد","الطَّاهر الشيم الجمييل فَعالُهُ",82,"ل",2,0],["ك