{"poems":[[53,"قل لأقنى يرمي إلى المجد طرفا","https://www.aldiwan.net/poem29971.html","الخفيف"],[63,"طرقت فنم على الصباح شروق","https://www.aldiwan.net/poem46208.html","الكامل"],[77,"قسما بالليل وما وسقا","https://www.aldiwan.net/poem35922.html","المتدارك"],[77,"هل كنت تعلم في هبوب الريح","https://www.aldiwan.net/poem36635.html","الكامل"],[86,"أثرت بنا من الشوق القديم","https://www.aldiwan.net/poem68868.html","الوافر"],[93,"ليلى اجمعي الناس إلى محفل","https://www.aldiwan.net/poem11104.html","السريع"],[37,"فقد صرت عما لها بالمشيب","https://www.aldiwan.net/poem7322.html","المتقارب"],[23,"أتاني عن أمي نثا كلام","https://www.aldiwan.net/poem21316.html","الوافر"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[51,"وصفعان يجود بمصفعيه","https://www.aldiwan.net/poem66409.html","الوافر"],[38,"ما بال دفك بالفراش مذيلا","https://www.aldiwan.net/poem7807.html","الكامل"],[85,"سكن الزمان ولانت الأقدار","https://www.aldiwan.net/poem62969.html","الكامل"],[45,"لامت ملامة مشفق متعتب","https://www.aldiwan.net/poem11495.html","الكامل"],[28,"إليك ابن سيار فتى الجود واعست","https://www.aldiwan.net/poem5297.html","الطويل"],[2,"غشيت ديارا بالنقيع فثهمد","https://www.aldiwan.net/poem25047.html","الطويل"],[66,"كفي القتال وفكي قيد أسراك","https://www.aldiwan.net/poem38480.html","البسيط"],[80,"لي قلب من جلمد الصخر أقسى","https://www.aldiwan.net/poem31374.html","الخفيف"],[44,"أطلالهم سلبت دماها الهيفا","https://www.aldiwan.net/poem30403.html","الكامل"],[75,"سرى وجناح الليل أقتم أفتخ","https://www.aldiwan.net/poem69093.html","الطويل"],[48,"وبلدة فيها زور","https://www.aldiwan.net/poem63368.html","مجزوء الرجز"],[50,"تجاللت عن فهر وعن جارتي فهر","https://www.aldiwan.net/poem63803.html","الطويل"],[46,"رميت ظباء القفر كيما تصيدها","https://www.aldiwan.net/poem22316.html","الطويل"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85523","الرمل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16691","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202538","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55024","الكامل"],[51,"وبديعٍ من البدائع يَسْبي","https://www.poetsgate.com/ViewPoem.aspx?id=29591",""],[118,"الهدى ثانية","https://www.aldiwan.net/poem24025.html","السريع"],[148,"الحمد لله تعظيما وإجلالا","https://www.aldiwan.net/poem47640.html","البسيط"],[170,"حطوا الرحال فقد أودى بها الرحل","https://www.aldiwan.net/poem1661.html",""],[179,"سرادق","https://www.aldiwan.net/poem50691.html","الخفيف"],[211,"لحظ يسبيك مقلده","https://www.aldiwan.net/poem13325.html","المتدارك"],[211,"بك المناصب في العلياء تفتخر","https://www.aldiwan.net/poem13551.html","البسيط"],[238,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[272,"لم يبق في الحي من ربع ولا طلل","https://www.aldiwan.net/poem52078.html","البسيط"],[272,"طيف الخيال من النيابتين سرى","https://www.aldiwan.net/poem52115.html","البسيط"],[276,"لله سوسن روض","https://www.aldiwan.net/poem25590.html","المجتث"],[350,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[362,"تلك الغصون امالتها الصبا هيفا","https://www.aldiwan.net/poem68086.html","البسيط"],[362,"حماك قد غردت فيه المسرات","https://www.aldiwan.net/poem68129.html","البسيط"],[365,"لمن الركائب سيرهن تهاد","https://www.aldiwan.net/poem60948.html","الكامل"],[372,"إن مس مسقمتي من طرفها سقم","https://www.aldiwan.net/poem57123.html","الكامل"],[407,"إن الحمول غداة غربة غرب","https://www.aldiwan.net/poem50208.html","الكامل"],[430,"رويدك بالهوى يا خير شادن","https://www.aldiwan.net/poem41048.html","الوافر"],[430,"حذار حذار أخي الشجن","https://www.aldiwan.net/poem41411.html","المتقارب"],[433,"وما كنت أخشى من زماني نبوة","https://www.aldiwan.net/poem12561.html","الطويل"],[444,"زرت لندن ربة المدن والشمس","https://www.aldiwan.net/poem55989.html","عموديه"],[515,"هذا العقيق وتلك شم رعانه","https://www.aldiwan.net/poem20784.html","الكامل"],[515,"لله منزلها على الروحاء","https://www.aldiwan.net/poem20827.html","الكامل"],[539,"أنا صب متيم ما حييت","https://www.aldiwan.net/poem48258.html","عموديه"],[552,"ألا يا أيها الحادي","https://www.aldiwan.net/poem47850.html","الهزج"],[560,"صب على عهدكم مقيم","https://www.aldiwan.net/poem69343.html","مخلع البسيط"],[568,"أشتهي في الغناء بحة حلق","https://www.aldiwan.net/poem69732.html","الخفيف"],[576,"قلبي يقول لطيف منك يطرقني","https://www.aldiwan.net/poem2997.html","البسيط"]],"verses":[["كَهِلالِ السَحابِ ما غابَ حَتّى","رَقَّ عَن وَجهِهِ الغَمامُ فَشَفّا",0,"ف",2,0],["كَهلُ الحِجى عَرُضَتْ مَنادِحُ رأيِهِ","والغُصْنُ مُقتَبِلُ النَّباتِ وَريقُ",1,"ق",1,0],["كهْفٌ لَجأ الإسْلامُ لهُ","فعَفا وحَمَى وكَفَى ووَقَى",2,"ق",2,0],["كهْفُ الأنامِ إذا تفاقَمَ مُعْضِلٌ","مَثَلوا بساحَةِ بَابِهِ المَفْتوحِ",3,"ح",1,0],["كَهَمِّكَ في الخَلاعَةِ وَالتَصابي","وَإِن كانوا عَلى خُلُقٍ عَظيمِ",4,"م",1,0],["كهُوفُ نُورٍ شَادَهَا سَاخِراً","شُعَاعُ تِلْكَ الشُّغْلِ الطَّاغِيَهْ",5,"ي",2,0],["كهُولة ما أوقد المحلفو","ن للحالفين وما هوَّلوا",6,"ل",3,0],["كَهَمزَةِ ضَيغَمِ يَحمي عَريناً","شَديدِ مَغارِزِ الأَضلاعِ خاظي",7,"ظ",2,0],["كهمّ الخليِّ اسودَّ فرعٌ ومَكْحلٌ","لها خِلقةً وابيضَّ ثغرٌ ومَلْغمُ",8,"م",1,0],["كهَدْمِ المُشْركينَ بيوتَ سُوءٍ","بأيديهِمْ وأيدي المؤمنينا",9,"ن",2,0],["كَهُداهِدٍ كَسَرَ الرُماةُ جَناحَهُ","يَدعو بِقارِعَةِ الطَريقِ هَديلا",10,"ل",2,0],["كَهفُ القَضِيَّةِ لا تَنامُ نُيوبُهُ","عَنها وَلا تَتَناعَسُ الأَظفارُ",11,"ر",1,0],["كَهفٌ إِذا اِستَذرى العُفاةُ بِظِلِّهِ","لَجَأوا إِلى كَنَفٍ رَحيبٍ مُخصِبِ",12,"ب",1,0],["كُهولٌ وَشُبّانٌ مَساعيرُ في الوَغى","لَهُم بِالقَنا أَيدٍ طِوالُ الأَشاجِعِ",13,"ع",1,0],["كَهَمِّكَ إِن تَجهَد تَجِدها نَجيحَةً","صَبوراً وَإِن تَستَرخِ عَنها تَزَيَّدِ",14,"د",1,0],["كَهفُ الضُيوفِ وَوَهّابُ الأُلوفِ وَجَد","داعُ الأُنوفِ وَأَمنُ الخائِفِ الشاكي",15,"ك",2,0],["كهَصورٍ في كفّه الظُّفْرُ عَضْبٌ","وغريرٍ في صدره النهدُ حقُّ",16,"ق",1,0],["كَهلُ الأَناةِ فَتى الشَذاةِ إِذا غَدا","لِلحَربِ كانَ القَشعَمَ الغِطريفا",17,"ف",2,0],["كهولٌ بنادي السلم قد عقدوا الحُبى","شبابٌ إذا ما ضَجّ في الحيّ صُرَّخ",18,"خ",1,0],["كَهِزَّةِ العَضبِ الذَكَر","ما حَسَّ مِن شَيءٍ هَبَر",19,"ر",1,0],["كُهولٌ وَشُبّانٌ عَلَيهِم مَهابَةٌ","وَفيهِم غَناءٌ لِلعَوانِ وَلِلبَكرِ",20,"ر",1,0],["كُهولٌ عَتَوا في سِنِّهِم وَكَأَنَّهُم","غُصونٌ عَلى مَيسِ الرَكائِبِ مُيَّدُ",21,"د",1,0],["كُهُولاً وَشُبَّاناً كأَنَّ وُجُوهَهُم","دَنانِيرُ مِمَّا شِيفَ في أَرضِ قَيصَرا",22,"ر",2,0],["كهِلاَلِ الشّكّ لولا أنَهُ","أنّ عَيني عَيْنَهُ لم تتأيْ",23,"ي",1,0],["كهزار قد نزا","فوق غصن خضرا",24,"ر",2,0],["كهِلالِ الحَياةِ أو كقَميصٍ","لِهلالِ الحَيّاتِ غيرِ مَجُوب",25,"ب",1,0],["كهلٍ على الأمر قويّ الكاهل","بين الحواريّ وبين العاهل",26,"ل",1,0],["كَهَوَاكَ لِلأَوْطَانِ فَلْيَكُنِ الهَوَى","لاَ مُفْتَرىً فِيهِ وَلاَ مُتَكَلَّفَا",27,"ف",2,0],["كهواءٍ بلا هباءٍ مَشوبٍ","بضياء أَرقِقْ بذاك وأصف",28,"ف",1,0],["كَهْلٌ تَصابَى وَيْحَ أَشجانِه","حَتَّامَ لا دُنْيا ولا باقِيَةْ؟",29,"ي",2,0],["كهف الخلافة كافيها وكافلها","وما عهدنا له في القرن أمثالا",30,"ل",2,0],["كَهلُ الشَبيبَةِ نَهّابُ الحَريبَةِ وَه","هاب الرَغيبَةِ هَشٌّ بِالنَدى عَجِلُ",31,"ل",1,0],["كهشيمٍ تحطّمتْ أمنياتي","هجَرتني ما نلتُ يوماً مرامي",32,"م",2,0],["كهف تسعى الشعراء له","زمرا كالنمل وتقصده",33,"د",2,0],["كهف الندى من اليه تهرع الشعرا","في العسر كالنمل احزابا وهم زمر",34,"ر",1,0],["كَهْفُ الوَرى الْحَسَنُ الذِي","دِينُ الإِلَهِ به مُؤَيَّدْ",35,"د",1,0],["كهل كَبير وأطفال وَحاشية","لا يقدرون عَلى التَحويل وَالنقل",36,"ل",1,0],["كهف المرجين كنزا السائلين اذا","غبر السنين كمت أَنواؤها المطرا",37,"ر",2,0],["كهامةٍ من لُجَيْن","في قامةٍ من زَبَرْجَدُ",38,"د",1,0],["كَهُوَ بَيانُ العَدلِ في تَكليفِهِ","فيهِ بَفَضلِ غمِرِ الكَونِ عَمَر",39,"ر",1,0],["كهف السِيادَةِ كَنز المَجدِ مَعدَن أَس","رار البَلاغَة من بِالعز قَد عرفا",40,"ف",2,0],["كَهف اِذا شاهَدت عَيناكَ طَلعَتُه","تَجَدّدت لَكَ في الحالِ المَسَرّات",41,"ت",1,0],["كَهْفُ الإمام إذا أوى منه إلى","رَأْيٍ أفاء عليه ظِلَّ سَداد",42,"د",1,0],["كَهِمَّةِ ابنِ عُبَيدِ اللَّهِ ما رَضِيت","مِن المَعالي بِما تَرضَى لَه الهِمَمُ",43,"م",1,0],["كهف اللَهيفِ وَروض مرتاد النَدى","وَغِنى الفقير وَأوبة المتغَرِّبِ",44,"ب",1,0],["كهجر الحائمات الورد لما","رأت انّ المنية بالورود",45,"د",1,0],["كهاة تريع لصوت مهيب","لغير هواها الشجي ما ظعن",46,"ن",1,0],["كهامٌ إذا كان الموالي ضريبةً","لديه ولكن في نُحورِ العِدى عضْب",47,"ب",1,0],["كهلة إن تسترت أو تعرت","شيب منها الجمال بالانقباض",48,"ض",1,0],["كهفُ الوَرى غيثُ الصّريخِ مَعاذُهُ","وكَفيلُ نجدَتِهِ وحِصْنُ أمانهِ",49,"ن",2,0],["كُهَناءُ غَيبٍ يعلمونَ فراسةً","قبلَ الوُقوعِ حقائقَ الأشياءِ",50,"ا",2,0],["كَهرَبتنِي إِذ أقبلَت تُظهِرُ البش","رَ وحيَّت بالإبتسَام بِتيتُ",51,"ت",1,0],["كَهَيقِ الدَّوِّ لولا وض","عُ أنساعِي وأقتادِي",52,"د",2,0],["كهْف حماكم له مَلاذٌ","يا حبَّذا الكَهْف والرَّقيمُ",53,"م",1,0],["كهُبوبِ الصَّبَا تَوَسَّطُ حالاً","بَيْنَ حَالَيْنِ شِدَّةً ورُكُودِ",54,"د",1,0],["كَهْلُ الحداثَةِ نَظَّارٌ بِفطْنَتِه","إِلى العَواقِبِ ريَّانٌ مِنَ الفِطَن",55,"ن",1,0]]}