px?id=192058",""],[5431,"عظُمَ الحنينُ وعنّفا ...","https://www.poetsgate.com/ViewPoem.aspx?id=198505",""],[5674,"الحديث يطول","https://www.poetsgate.com/ViewPoem.aspx?id=195391",""],[5803,"ظلال العشق","https://www.poetsgate.com/ViewPoem.aspx?id=101597",""],[5956,"يا ليتك تعطي بلدي كنزا","https://www.poetsgate.com/ViewPoem.aspx?id=208053",""],[6068,"أحببتها وأحبها وأحبها -07-","https://www.poetsgate.com/ViewPoem.aspx?id=177334",""],[6093,"أتهجأ البسمات","https://www.poetsgate.com/ViewPoem.aspx?id=194335",""],[5309,"جن الورى وطغت عليه همومه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573674",""],[6213,"المجْدُ الجَدُّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76314&r=&rc=62",""]],"verses":[["لا أَشتَكي ضُرّي مِن ال","ناسِ وَهُم مَن أَعلَمُ",0,"م",1,1],["لا أَشتَري الحَمدَ القَليلَ بَقاؤُهُ","يَوماً بِذَمِّ الدَهرِ أَجمَعَ واصِبا",1,"ب",2,0],["لا أَشتَري بَعدَ التَجَرُّبِ صاحِباً","إِلّا وَدِدتُ بِأَنَّني لَم أَشرِهِ",2,"ر",2,0],["لا أشتكِي فيكَ أشجاني وإن مكثت","ولا أكفكف أجفانِي وإن نزحت",3,"ت",1,0],["لا اشْتَكى يا أخي فؤادُك ما أض","حَى فُؤادِي يشكو إلى عُوّادِهْ",4,"د",2,0],["لا أشرب الماءَ على وجهه","ما جاد بالصَّهْباء عُنْقُودُ",5,"د",1,0],["لا أشتكي البدر على بعده","لقد أضاءت لي آفاقه",6,"ق",2,0],["لا أُشركُ الشركاءَ في حمدِ امرئٍ","منه أؤمّلُ وحْدَهُ التمويلا",7,"ل",2,0],["لا أَشتَكي الضَرَّ إِذا مَسَّني","مِنه وَلا أَطرُبُ مِن رَغدِهِ",8,"د",2,0],["لا أَشتَكي الدُنيا وَلا أَحداثَها","هَذي مَشيأَةُ ذي المَشيأَةِ فيكِ",9,"ك",1,0],["لا أَشتَكي الأَيّامَ أَظلِمُها","هِيَ ما جَرَت إِلّا عَلى رَسمي",10,"م",2,0],["لا أَشتَهي أَحَداً سِوايَ يَراكَ يا","بَدرَ السَماءِ وَيا قَضيبَ الآسِ",11,"س",1,0],["لا أَشرئِبُّ إِلى ما لَم يَفُت طَمَعاً","وَلا أَبيتُ عَلى ما فاتَ حَسرانا",12,"ن",2,0],["لا أَشرَبُها بِغَيرِ ماءٍ","فَالخَمرُ بِعَينِها حَرامُ",13,"م",1,0],["لا أَشرَبُ ما أَنا واصِفُهُ","فكأنّي بينهمُ قَعَدِي",14,"د",2,0],["لا أَشتَهي أَن تَكونَ لي سَكَناً","حَسبُكَ ما كُنتَ لي وَكُنتُ لَكا",15,"ك",2,0],["لا أَشرَبُ الماءَ إِلّا وَهوَ مُنجَرِدٌ","مِنَ القَذى وَلِغَيري الشَوبُ وَالرَنِقُ",16,"ق",1,0],["لا أَشتَهي الخِلَّ عِندَ عَيني","صَديقُ وَفري عَدُوُّ فَقري",17,"ي",1,0],["لا أَشهَدُ الدَهرَ حَتّى","تُعايِنَ العَينانِ",18,"ن",1,0],["لا أشتهي الحيضَ ولا أهلَهُ","غيركِ أشهى منكِ بالأرنبِ",19,"ب",1,0],["لا أَشتَهي السَلوَةَ إِنّي اِمرُؤٌ","زَيَّنتُ نَفسي بِهَوى مَن هَويت",20,"ت",1,0],["لا أَشتَهي بِهَواهُ جَنَّةً أُنُفاً","وَلَو تَدَلَّت لَنا تيناً وَأَعنابا",21,"ب",2,0],["لا أَشرَبُ الراحَ أَشري طيبَ نَشوَتِها","بِالعَقلِ أَفضَلِ أَنصاري وَأَعواني",22,"ن",2,0],["لا أُشرِكُ الجَديَ في دَرٍّ يَعيشُ بِهِ","وَلا أَروعُ بَناتِ الوَحشِ وَالضانِ",23,"ن",1,1],["لا أَشرَبُ الرَاحَ وَلَو","ضُمِّنَت ذَهابَ لَوعاتي وَأَحزاني",24,"ن",2,0],["لا أَشتَكي الأذى","لا أَعرِف الونى",25,"ن",2,0],["لا أَشتَكي إِنّي حُرِمتُ إِجابَةً","لَولا شعوبُ لَدَعَّ عَنهُ دُعائي",26,"ا",2,0],["لا أَشتَهي الدُنيا وَلَو أَنَّني","مُتَوَّجٌ أَملِكُ أَجوازَها",27,"ه",2,1],["لا أشتكي الدّنيا ولا أحداثها","هذي مشيئة ذي المشيئة فيك",28,"ك",1,0],["لا أشتكي وبمهجتي ظفر يمزّقها وناب","مسح الحياء على الدموع وأكرم الشكوى اقتضاب",29,"ب",1,0],["لا اشْتَكى يا أخي فؤادُك ما أض","حَى فُؤادِي يشكو إلى فؤادِهْ",30,"د",2,0],["لا أشرْئبُ إلى وسائلِ غيره","إذ كنتُ معه في السعادةِ والغِنَى",31,"ن",2,0],["لا أَشرَبُ الماءَ ما لَم يَصفُ مَورِدُهُ","وَلا أَقولُ لِمُعوَجِّ الوِصالِ صِلِ",32,"ل",1,0],["لا أشتكي الدهر لعلمي بما","يخفى على الجاهل من قدره",33,"ر",2,0],["لا أشكرَنّ مهنّئي بالعيد بل","شكري الجزيل لمن به عزّاني",34,"ن",2,0],["لا أشتكي برحَ الصدودِ","ولم أذُق ألمَ الخمار",35,"ر",1,0],["لا أَشتهي المحبوبَ فيك مشاركاً","كلاً ولا الوصلَ الذي قد أُنْهِكا",36,"ك",2,0],["لا اشتكي الحب تصميني مصائبه","ولي عن اللوم فيه إذن أطروش",37,"ش",1,1],["لا اشتكيك وام دفر اشتكى","لمجيب داعي نصرتي ومجيري",38,"ر",2,0],["لا أَشكر الدهر يَهدي ظل أَنعمه","إِليّ مالم يريني وَجهك الحسنا",39,"ن",2,0],["لا أَشرب المر موثوقاً به طمعا","وَلا أَقول عَلى ما فاتَ واندمي",40,"م",2,0],["لا أَشربُ الدّمعَ إلاّ أن تُغَنِّيَني","وُرْقٌ سواحِرُ مهما رَقَ أَسحار",41,"ر",1,0],["لا أشكرُ الطّائرَ إن شاقَني","على نوىً عن سَكَني وانتِزاح",42,"ح",1,0],["لا أَشتَكي نُوَبَ الدُنيا وَكَيفَ بِها","لَو راوَحَت بَينَها يَومَينِ كَالنُوَبِ",43,"ب",1,0],["لا أَشتَكي دَهراً تَميلُ صُروفُهُ","فَكَم الشِكايَةُ مِن قَضيبٍ مائِلِ",44,"ل",1,0],["لا أشرَبُ الماءَ أروَى كلَّ ذي ظمأٍ","قَبلي وإن كانَ يُرويهِ ويُرويني",45,"ي",1,0],["لا أَشكُر المَعروف إِلّا منك أَو","ما قَرَّبت كَفّاك بَعدَ مَرامِهِ",46,"م",2,0],["لا أَشْرَبُ الرَّاحَ إِلاَّ","ما بَيْنَ شادٍ وشادِنْ",47,"ن",1,1],["لا أشْمتَ الله به عُداتَهُ","فأصعَبُ الأشياءِ إشماتُ العدا",48,"ا",1,0],["لا أشرئبّ إلى بُلَهنِيَةٍ","من عيشةٍ وطريقها يُدلي",49,"ل",2,0],["لا أشبهُ حمأةً تحوبُ","أو جَذوةً سعيُها يخيبُ",50,"ب",1,0],["لا أشتكي ظمأ الأماني بعدما","روت سحائبه ثرى إملاقي",51,"ق",2,0],["لا أَشتَكِي منه الصُّدودَ وإن يَكُن","بِالصَّدِّ تُذكى لِلهوى نِيرَانُ",52,"ن",1,0],["لا أَشبعَ اللَّه مَن أُلْهُوا وما علموا","عن المعالِي بإرواءٍ وإشباعِ",53,"ع",1,0],["لا أَشكُر الدّهر أولى في الزّمان يداً","ثمّ اِستَردّ الّذي أولاه في السَّحَرِ",54,"ر",1,0],["لا أَشتَكي ما بي إِلَيكَ وَلَو","نَطَقَت بِهِ العَبَراتُ في خَدّي",55,"د",2,0],["لا أَشتَكي الهَجرَ وَالفِراقَ وَلا","أَكُمُّ إِلّا مَعاقِدَ الأُزُرِ",56,"ر",1,0],["لا أَشتِمُ المَرءَ الكَريمَ مَغنَما","وَلا أَرى شَتمَ البَريءِ مَغنَما",57,"م",2,0],["لا أَشْتَكِي مِنْكَ في وَجْدٍ تَخُصُّ بِهِ","قَلْبِي وَدَمْعٍ بأَجْفانِي تُرقْرِقُهُ",58,"ق",2,0],["لا أَشُمُّ الرَيحانَ إِلّا بِعَبني","كَرَماً إِنَّما تَشُمُّ الكِلابُ",59,"ب",1,0],["لا اشتَكي تَلَفَ الصَّبابَةِ والهَوَى","تَلَفي وَعيشِ أبيكَ إن لَم أتلَفِ",60,"ف",1,0],["لا أشتم الصالحين جهراً","ولا تشيّعت ما بقيت",61,"ت",1,0],["لا أشمتَ الدهر العدى بهما ولا","آذتهما الدولات بعد حروبها",62,"ب",3,0],["لا أشربُ الراحَ إِلاّ منْ يدَيْ رشأٍ","مُهفهفٍ كقضيبِ البانِ ميّاس",63,"س",1,0],["لا أشكر العين إلا أن بكت بدمٍ","أولا فيا ليتها تشكو قذاً وعما",64,"م",2,0],["لا أشكونَّ زماناً في تقلبه","فالدهر مِن قَبْلُ أفراحٌ وأحزانُ",65,"ن",1,0],["لا أشْتَكِي نَار وجْدٍ أحْرقتْ كَبدِي","وَمَدْمَعِي قد رَوَتْ عَنْ صَوْبِهِ السُّحُبُ",66,"ب",1,0],["لا أشرب الدمع إلا أن تفنيني","ورق لها في ذرا الأيك انتقالات",67,"ت",1,0],["لا اشتكى نوشةَ الأَيامِ من وَرَقى","إِلاَّ إِلى مَن أَرى أَن سوف يُشكِيها",68,"ي",3,0],["لا أشتكي لكنّني شاعر","يشدو فقد يوقظ بعض النيام",69,"م",1,0],["لا أشربُ الراحَ إلا مِن يَدي رَشأ","تَقبيلُ راحتِهِ أشهى من الرّاح",70,"ح",1,0],["لا أشتهي يا قوم إلا كارهاً","باب الأمير ولا دفاع الحاجب",71,"ب",1,1],["لا أشاجيك وقد بَرَّحْتَ بي","دُوْنَكَ اليومَ فَذَرْني والسَهَد",72,"د",1,0],["لا أشتكي سهراً طالت مسافته","اللّيل يعلم أنّي الدّهر ساهره",73,"ر",2,0],["لا اشربن ولا أكلت على الصدى","والجوع غير دمي وغير فؤادي",74,"ي",1,0],["لا أَشتَكي بُؤسَ الحَياةِ وَلا تَرى","نُوَبُ الزَمانِ لَها إلَيَّ سَبيلا",75,"ل",2,0],["لا اشتهي الموت الزؤام لينقضي","عمري الذي بالهمّ بات مشوب",76,"ب",1,0],["لا أشمت الله فيكم من يخاصمكم","ولا أراكم مدى الأيام تنكيدا",77,"د",2,0],["لا أشتكي دهري ويقظتك التي","أوتيتها بخفيِّ أمري أعلم",78,"م",1,0],["لا أشتمُ الضيفَ ولكنني","أدعو لهُ بالقُربِ من طوقِ",79,"ق",1,1],["لا أشتكي من هواك إلا","إليك لو ينفع التشكي",80,"ك",2,1],["لا اشتكي في الليل من وحشة","البقُ والبرغوث في قربي",81,"ب",2,1],["لا اشتهي الجار لي ذكيّا","أفكاره جمّة كبار",82,"ر",1,1],["لا أشتكي منه غير وجه","رؤيته عندي انتحار",82,"ر",1,0],["لا أشتكي الجور من مليك","آثر بالعدل منه قده",83,"د",2,0],["لا أشكون جرحي فللعذ","ال ألسنة حداد",84,"د",1,0],["لا أشتكي نوبَ الزمانِ ولَيتني","أبقى وبي دونَ الوَرى حِدْثانُهُ",85,"ن",2,0],["لا أشتهي غصن بان مال في بلد","كغصن بان بمصر ماس وانعطفا",86,"ف",2,0],["لا اشتكي الدهر ولو انه","أخلق جلياب شبابي القشيب",87,"ب",1,1],["لا اشتكيكَ ولا أُدنِّسُ مَنطِقي","فلِسانُ حالكَ ناطقٌ يتكلمُ",88,"م",1,0],["لا أَشتكي بَأسي لِغَير تَأمّلي","فَأَجولها فكراً بنظرة حائر",89,"ر",1,0],["لا أشتكيه فقد أمرَّ فساغ لي","مالا يسوغ وسرني ما يكمد",90,"د",1,0],["لا أشتهي ان تراني","بحالة النقص عندك",91,"ك",1,0],["لا أَشتَكي لَوعَتي اِلّا لِمَن هُوَ لي","في كُل ضيم بِالعُيونِ بَقى",92,"ق",2,0],["لا أشرب الصهباء إلا من يدي","رشأت مليح الوجه أحوى أغيد",93,"د",1,0],["لا أَشتكي إلاّ الغرام فإنّهُ","بلوى عليَّ من السّماءِ بها قُضي",94,"ض",2,0],["لا أَشتَكي هَوايَ إِلَّا","إِلَيكَ لَو يَنفَعُ التَّشَكّي",95,"ك",2,1],["لا أشتَكي محنَ الدَوا","هِي إذ تَحِلُّ بي العِظَام",96,"م",1,0],["لا أشتِكي السقمَ وإن","كسَوت جِسمي سَقما",97,"م",2,0],["لا أشتكي الدهر والأيام من حولي","أسوسها والخطوب الربد من خدمي",98,"م",2,0],["لا أشرح الحزن في ليلٍ تلمُّ بهِ","وكيف أحزنُ والأفراحُ في داري",99,"ر",2,0],["لا أَشتَهِي الآنَ لا حُزنًا ولا فَرَحًا","ولا أُرِيدُ على ما قُلتُ شُكرانا",100,"ن",2,0],["لا اشرب الراح حين تحضرني","حسبي خمر بطرفه وكفى",101,"ف",2,0],["لا أشتكي بالشعرِ غيرَ مودّةٍ","أضحتْ رماداً ذرّه الإيحاءُ",102,"ا",2,0],["لا أشتكي إلا خوارمَ صبوةٍ","تجتاحني كعواصفِ الأنواءِ",103,"ا",2,0],["لاأشتهي إلاه سيفا باترا","في مهجتي يمضي ويمتع ناظره",104,"ر",2,0],["لااشتهيك مسالما","لااشتهيه إذا انطفا",105,"ف",2,0],["لا أشتكي وجعاً وأنتَ بخافقي","عمري مضى والنائباتُ تصولُ",106,"ل",1,0],["لا أشتكيك شجوني واحتزان هوى","ولا اغترابٌ وإن أمسيتُ مُنتَقلا",107,"ل",2,0],["لا أشهد جوداً فعالاً","من جودك لكن تستولي",108,"ل",2,0],["لا أشتري بغرامها وكلامها","ما مس أحلام الهوى أو ضرني",109,"ن",2,0],["لا أشتهي منها مَعالمَ طينِها","فالحبُّ نَجْلُ النورِ لا الظلماتِ",110,"ت",1,0],["لا اَشتَكي هذا الزَّمانَ وَأهلَهُ","فَالفَضلُ مَحسودٌ بِكُلِّ مَكانِ",111,"ن",1,0],["لا أشتري جَدّاً يُحال إلى محاكمة العبيدْ","لا أشتري جَدّاً يُعلَّق بالجدار أو العمودْ",112,"د",1,0]]}