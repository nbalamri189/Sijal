[4442,"إذا جد جد المرء والدهر مطرق","https://www.poetsgate.com/ViewPoem.aspx?id=170988",""],[6082,"لماذا ؟","https://www.poetsgate.com/ViewPoem.aspx?id=58817",""],[6093,"إِنَّ السُّمَاةَ إِلى مَدِيْحِ مُحَمَّدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=186686",""],[6152,"تغافل وكن حليما","https://www.poetsgate.com/ViewPoem.aspx?id=205297",""],[6198,"ناي الهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79296&r=&rc=70",""],[5567,"إسراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81756&r=&rc=20",""]],"verses":[["فحل ما حل تعظيماً لحرمته","وسار ما سار تشييداً لما هدموا",0,"م",3,0],["فَحُلَّ عِقالَ الأَرْحَبِيِّ وَلا تُقِمْ","بِحيثُ تُناجي الذُّلَّ صاحَ بِكَ النّاعي",1,"ي",1,0],["فحَلّوا حُبا اللّيلِ البَهيمِ بأوْجُهٍ","سَنا الفَجْرِ في أرْجائِها يتهلّلُ",2,"ل",1,0],["فحِلْمُ مَنْ ساوَرَهُ عازِبٌ","ولُبُّ مَنْ عاداهُ مَسْلوبُ",3,"ب",1,0],["فحَلُمْتُ عنهُ وباتَ يَشْرَبُ غَيظَهُ","جُرَعاً ولُزَّ بمِنخَرَيهِ المَرْغَمُ",4,"م",1,0],["فَحَلَلْتَ مِنْ وَادِي الأَشَى بِقَرَارَةٍ","عَزَّ الثَّوَاءُ بِهَا وَطَابَ الْمَنْزِلُ",5,"ل",1,0],["فحُلَّتُها الحمْراءُ منْ شَفَقِ الضُّحى","نَضاها وحَلَّ المُزْنُ منْ جِيدِها عِقْدا",6,"د",2,0],["فَحَلَّ هِلالاً في ظَلامِ عَجاجَةٍ","تُلاحِظُهُ الأَقمارُ في الأُفقِ حُسَّدا",7,"د",2,0],["فَحَلَّ بِذَارُكَ فِي مَخْصَبٍ","وَبشَّرَ جِيلَكَ بِالقَادِمِ",8,"م",1,0],["فَحَلَّ عَنِ الْفَتَى ثَوْباً خَضِيباً","كَأَّنَّ ثُقُوبَهُ فِيهِ كِلاَمُ",9,"م",1,0],["فحل اليمن منذ حللت فيه","وقبلاً كان عنه ذا انحياز",10,"ز",1,0],["فحللت معتلج البطا","ح وحلَّ غيرُك بالظواهر",11,"ر",1,0],["فَحَلُّوا دَارَ مَكرُمَة وَعِزٍّ","عَنهَا أَعَادِيَ شانِئِينَا",12,"ن",2,0],["فحلفتُ أني ما كحلتُ نواظري","بمُشاكلٍ لهما ولا بضَريبِ",13,"ب",1,0],["فحلالُ الهوى نبيذٌ مُدارٌ","وحرامُ الهوى شمولٌ مُدام",14,"م",1,0],["فَحَلَمتُها وَبَنو رُفَيدَةَ دونَها","لا يَبعَدَنَّ خَيالُها المَحلومُ",15,"م",1,0],["فَحلٌ عَذومٌ إِذا بَصبَصنَ أَلحَقَهُ","شَدٌّ يُقَصِّرُ عَنهُ المِعبَلُ الحَشِرُ",16,"ر",1,0],["فَحَلَّت نَبِيّاً أَو رَمادانَ دونَها","رِعانٌ وَقيعانٌ مِنَ البيدِ سَملَقُ",17,"ق",1,0],["فُحُلَّ من مشكلها","بفضله مسائل",18,"ل",1,0],["فحلّ رمز القوم واحرص على","فهم المعاني فعليها تدور",19,"ر",1,0],["فَحلانِ لَم يَلقَ شَرُّ مِنهُما وَلَداً","مِمَّن تَرَمَّزَ بَينَ الهِندِ وَالرومِ",20,"م",1,0],["فحلَّ بنَصْلِ السيفِ لُؤلُؤَ تاجِها","وحطَّ بأطرافِ الرِّماحِ سريرَها",21,"ر",3,0],["فحلِّ أبا أحمدٍ حِليةً","مُخلَّدةً ما لَها من فَناءِ",22,"ا",2,0],["فَحَلَّ مَحَلَّةً مَن حَلَّ","ها صُرِمَت حَبائِلُهُ",23,"ل",2,0],["فَحَلَّقَ تَأَلَّقَ فَطَلَّقَ","نَومي وَراجَعتُ البُكا وَالنُواح",24,"ح",1,0],["فَحَلَّت عُقودُ الدَمعِ ما كانَ عاطِلاً","وَعَطَّلَ عَقدُ الضَمِّ ما كانَ حالِيا",25,"ي",2,0],["فحلفت لا رقدت ولا","ذاقت شهي منامها",26,"م",3,0],["فَحَلَلتُ حَيثُ الماءُ صَفحَةُ ضاحِكٍ","جَذلٍ وَحَيثُ الشَطُّ بَدءُ عِذارِ",27,"ر",1,0],["فَحَلَّ بِنا الفُقدانُ في ساعَةٍ مَعاً","فَمُتُّ وَلا تَدري وَماتَت وَلا أَدري",28,"ي",1,0],["فَحُلّوا بَطنَ عُقمَةَ وَاِتَّقونا","إِلى نَجرانَ في بَلَدٍ رَخِيِّ",29,"ي",1,0],["فحلَّ عن طوعٍ سراويلَهُ","ولم يكن قطُّ بهذا يجود",30,"د",1,0],["فحِلّةٌ قد أجابت وهي طائعةٌ","وقبلَها حِلّةٌ عاصَت ولم تُجِب",31,"ب",1,0],["فَحَلَلنا هُناكَ تِكَّةَ خَزٍّ","وَحَسَرنا قَباءهُ الديباجا",32,"ج",2,0],["فَحَلَّ بِزالُها في قَعرِ كَأسٍ","مُحَفَّرَةِ الجَوانِبِ وَالقَرارِ",33,"ر",1,0],["فَحُلتُ إِلى البِغالِ فَأَعوَزَتني","فَحُلتُ مِنَ البِغالِ إِلى الحَميرِ",34,"ر",1,0],["فَحَلَفتُ لا أُعطي العَواذِلَ طاعَةً","حَتّى يُقامَ عَلَيَّ بِالأَنواحِ",35,"ح",1,0],["فَحَلَفتُ يا زُرعَ بنِ عَمروٍ أَنَّني","مِمّا يَشُقُّ عَلى العَدوِّ ضِراري",36,"ر",2,0],["فَحَلَّ في بِركَةٍ بِأَسفَلِ ذي","رَيدٍ فَشَنَّ في ذي العِثيَرِ",37,"ر",1,0],["فحل من فرح بال","عناق زر الوشاح",38,"ح",1,0],["فَحَلَّ مَحَلاًّ مِنْهُمُ لَمْ يَفُزْ بِهِ","أَبٌ أَوْ أَخٌ حُلْوُ الشَّمَائِلِ أَوْخِل",39,"ل",1,0],["فحَلُّوا جِنَاناً وأبقُوا لَكُمْ","أُسُوداً تُحَامي عَنِ الأشْبُلِ",40,"ل",1,0],["فَحِلمٌ كَطَودٍ رَسا","وَجودٌ كَغَيثٍ أَلَث",41,"ث",1,0],["فَحَلَّتْ عُرى تيجانِها لمُؤَيِّدٍ","يَخُرُّ له ذو التَّاجِ وهو مُعَمَّمُ",42,"م",1,0],["فَحْلٌ ينال النصرَ في ميدانه","وسواه يُستولي على أسْلابه",43,"ب",2,0],["فحلارت به واحتار في الحبّ مثلها","فهل تبدأ الشكوى ؟ وهل هو باديء ؟",44,"ي",2,0],["فحلالُ الهوى نبذٌ مُدارٌ","وحرامُ الهوى شمولٌ مُدام",45,"م",1,0],["فحلّة ٌ قد أجابت وهي طائعة ٌ","وقبلها حلّة ٌ عاصت ولم تجبب",46,"ب",1,0],["فحل عظيم خطير الطور ما نظرت","عين الورى مثله في القوم انسانا",47,"ن",2,0],["فحل الرجال العريق الهاشمي فتى ال","هيجاء مجلى معني سيد الرسل",48,"ل",1,0],["فحل هزبر سيد ذو همة","علوية من اعظم الهمات",49,"ت",1,0],["فَحَلَّ عَلَيهِم بِها سَخطَة","مِنَ اللَهِ في ضَربَةِ الأَزرَقِ",50,"ق",1,0],["فَحَلَّ رُباهُ وَاِجتَلى بِعُقودِهِ","فَأَعيا الوَرى ما اِحتَلَّ مِنها وَما اِجتَلا",51,"ل",2,0],["فحلّت محلا لم يكن حل قبلها","وهيهات أن يحلل به الغير أو يجدي",52,"د",2,0],["فحَلَّل حزني فيك وهو محرّم","وحرَّم صبري عنك وهو حلال",53,"ل",1,0],["فحلومُكُم مثل الجبال رزانةً","وأكفكم عنها البحار دواني",54,"ن",2,0],["فحل زبيد الأنس من بعد وحشة","وبيت الحسين الوحش من بعد إيناسِ",55,"س",1,0],["فَحَلِّني بِلباسٍ مِنكَ يَحسُدُني","عَلى اِتّصالي بِكُم ناءٍ وَمُقتَرِبُ",56,"ب",1,0],["فَحُلّوا عُرى التِرحالِ وَاِستَعصِمُوا بِهِ","مِنَ الدَهرِ واِرمُوا صَرفَهُ بِالدَوامِكِ",57,"ك",1,0],["فحلالُهم من شُحِّهم","في كل مسألةٍ حَرام",58,"م",1,0],["فحلت عقود إذ تحلل محكه","ودارت رحى الكذّان إذ رُكِّب القطبُ",59,"ب",1,0],["فحل ما كان بها عاطلا","وخل من بالغ في العذل",60,"ل",1,0],["فحلال لكِ في الحبّ دمي","وهو يا حسناء للناس حرامْ",61,"م",1,0],["فحلّ بثور غاره وعداتُه","بكل سبيل إلى الفلاة تنوض",62,"ض",1,0],["فَحَلَّت بِدارِ الأَمنِ وَالخِصبِ تَرتَعي","رِياضَ النَدى وَالجودِ مِن مَسرَحِ المَجدِ",63,"د",1,0],["فَحِلْمُكَ قَدْ عَمَّ كُلَّ الْوَرَى","وَأَصْلَحَ مَا بَيْنَ خَاصٍ وَعَامْ",64,"م",1,0],["فَحَلَّ لَنَا التَّرَفُّهُ فَاقْتَرَحْنَا","فَطِبْنَا أَنْفُساً مِمَّا طَرِبْنَا",65,"ن",2,0],["فحلمك لولا أنك اليوم قادر","لظنوه عجزاً بالتجاوز يحجب",66,"ب",1,0],["فَحَلّوا أَرضَ نابُلسٍ وَفيها","نَواحٍ لَيسَ تَخلو مِن نَواحِ",67,"ح",1,0],["فحلت وما افتقرت","لتحليتي جناس واشتقاق",68,"ق",1,0],["فحلت بالعدل منه بعد ما","جُرع الرائي لها ميما براء",6