.aspx?id=177864",""],[4623,"لا تلوموني إني أطلت المقالا ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146608",""],[402,"جالسوني يا رفقتي للشراب","https://www.poetsgate.com/ViewPoem.aspx?id=35072",""],[5848,"ماتسمى طريقه","https://www.poetsgate.com/ViewPoem.aspx?id=51953",""],[5848,"ليلة السبت","https://www.poetsgate.com/ViewPoem.aspx?id=50605",""],[5943,"كيفَ الرُّكون إلى السلامِ","https://www.poetsgate.com/ViewPoem.aspx?id=11285",""],[6056,"نكّست الأعلام","https://www.poetsgate.com/ViewPoem.aspx?id=130325",""],[6070,"الذنوب العارية","https://www.poetsgate.com/ViewPoem.aspx?id=188432",""],[6142,"سل عنه سلعا لدن ضاق الخناق بها","https://www.poetsgate.com/ViewPoem.aspx?id=155715",""],[520,"أسفي على زمن الإمام العاضد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577490",""],[6235,"معزوفة الصدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77692&r=&rc=7",""],[2638,"ممرضتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87859&r=&rc=16",""],[6323,"لغة الشعور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82174&r=&rc=5",""]],"verses":[["جالَ الوِشاحُ عَلى قَضيبٍ زانَهُ","رُمّانُ صَدرٍ لَيسَ يُقطَفُ ناهِدُ",0,"د",1,0],["جالِساً في نَفَرٍ قَد يَئِسوا","مِن مُحيلِ القِدِّ مِن صَحبِ قُزَح",1,"ح",1,0],["جالَ عِزرائيلُ في أَنحائِها","تَحتَ ذاكَ النَقعِ يَمشي الهَيذَبى",2,"ب",2,0],["جالا فَلَم يَترُكا مَجالاً","وَاِعتَرَكا بِالنُهى عِراكا",3,"ك",2,0],["جالَ عَلى حُجرَتِهِ مدلويه","فويهِ مِن أَفعالِهِ ثُمَّ وَيه",4,"ه",1,1],["جالَ ماءُ النَعيمِ مِنهُ بِخَدٍّ","فيهِ لِلمُستَشِفِّ نورٌ وَنارُ",5,"ر",1,0],["جالَت لِتَصرَعَني فَقُلتُ لَها اِقصِري","إِنّي اِمرُؤٌ صَرعي عَلَيكِ حَرامِ",6,"م",1,0],["جَالِسُونِي يَا رُفْقَتِي لِلشَّرَابِ","وَأَعِيدُوا إِلَّي وَهْمَ الشَّبَابِ",7,"ب",1,1],["جَالَ فِي شَوْطِهِ وَصَالَ فَمَنْ لِي","بِمَجَالٍ فِي شَوْطِهِ أَوْ مَصَالِ",8,"ل",1,0],["جال الوشاح على معاطفها","التي قعدت وقام بصدرها النهدان",9,"ن",1,0],["جالسني أستضي بغرته","فحبَّذا شمعتي وجلاسي",10,"س",2,0],["جالستُما الشُّمَّ بني هاشم","والسادَةَ الصِّيدَ بني مُصعبِ",11,"ب",1,0],["جالتِ الريحُ في الزوايا بها يو","ماً كما جال في الرباط الحصانُ",12,"ن",1,0],["جالى الجنودَ كأنهم شهب الدجى","ومنيرهم من كل ليث ضار",13,"ر",1,0],["جالَ فيها قَلَماً مُستَنهِضاً","وَلِساناً كُلَّما أَعيَت حَداها",14,"ا",3,0],["جالَ فُرسانُها عَليَّ جُلوساً","لا أَقَلَّتْهُمُ ظُهورُ العِتاقِ",15,"ق",1,0],["جالَ ماءُ الحُسنِ فيها كَما قَد","جالَ في الحَسناءِ ماءُ الشَبابِ",16,"ب",1,0],["جالياً أقذاءَ عينٍ مَقَلَتْ","من محيّا حَسَنٍ بَدْرَ السعود",17,"د",1,0],["جالَت بِخَيذَرَ جَولَةَ المِقدارِ","فَأَحَلَّهُ الطُغيانُ دارَ بَوارِ",18,"ر",1,0],["جالَت بِطَرفي لِلصَبابَةِ عَبرَةٌ","كَالغَيمِ رَقَّ فَحالَ دونَ سَماءِ",19,"ا",2,0],["جالَدتُهُ مِن حاسِرٍ دارِعاً","كَفاهُ حَملُ الرَأيِ حَملَ السِلاح",20,"ح",1,0],["جالَ في أَنجُمٍ مِن الحَليِ بيضٍ","وَقَميصٍ مِنَ الصَباحِ مُذالِ",21,"ل",1,0],["جَالدتَ هندرسونَ بالرّأيِ الذي","يُعيِي الدُّهاةَ ويَغلبُ الشُّجْعَانا",22,"ن",2,0],["جالَ فيهم جولةً عاصفةً","فَهَوَوْا صَرْعَى وأمْسَوْا هُمَّدا",23,"د",2,0],["جالِساً فَوقَ مُصَلّىً","وَحَوالَيهِ عَبيدُ",24,"د",1,0],["جالَ ماءُ الشَبابِ في خَدَّيكَ","وَتَلالا البَهاءُ في عارِضَيكَ",25,"ك",1,1],["جالَستُ يَوماً أَباناً","لا دَرَّ دَرُّ أَبانِ",26,"ن",1,1],["جالِس عَدُوَّكَ تَعرِف مَن تُكاتِمُهُ","يَبدو القِلى في حَديثِ القَومِ وَالمُقَلِ",27,"ل",1,1],["جَالِياً مِنْ حِكْمَةِ الأَحْ","قابِ مَا يَهْدِي الرَّشِيدا",28,"د",2,0],["جالُوا وجُلْنا فَمَا فَاؤوا وما رَجَعوا","ونَحْنُ نَثْفُنُهُمْ لَمْ نَأْلُ في الطلبِ",29,"ب",1,0],["جال في حَوْمةِ السياسة وثَّا","باً فأذكَى حماسةَ الفِتيان",30,"ن",1,0],["جالَ في الأفْق جوْلةً ثم ولَّى","هل يعود الشادي إلى جَوْلانهْ",31,"ن",2,0],["جالت سنابِكُ خيلهم في لُجِّهِ","جَولانَها في مهمهٍ ورجام",32,"م",1,0],["جالد صروف الليالي بالتجلد واف","طن أن احوالها حل ومرتحل",33,"ل",1,0],["جالت لتصرعني فقلتُ لها اقصري","إني امرءٌ صرعي عليك حرام",34,"م",1,0],["جالاَ فلمْ يترُكَا مجالاً","واعْتَرَكَا بالنُّى عِراكَا",35,"ك",2,0],["جال الوشاح على معاكفها التي","قعدَت وقام بصدرها النهدان",36,"ن",1,0],["جالَ فيهِ الرَدى يَميلُ قِداحاً","أَحرَزَت خَصلَها وَفاتَ الخَليلُ",37,"ل",1,0],["جال طرفي بجدول","ماؤه كالسجنجل",38,"ل",1,1],["جَالَسْتُ فَخْرَ الدِّينِ وَالْ","إِرْشَادُ بَيْنَ يَدَيْهِ يُسْرَدْ",39,"د",1,0],["جالسٌ في تبظرمٍ ترك الحا","سد يقلى بعر آسته بوراني",40,"ن",2,0],["جالَ فيها فمن رَآها يؤرّخ","ماءُ زغوان جائلٌ في المدينَه",41,"ن",2,0],["جالَت بكُم في مسابِ الرقمِ خيلُكُم","وَاِستَنزَلت من مقرِّ العصمِ ما عصموا",42,"م",3,0],["جالِساً لِلنَجمِ أَرقُبُها","فَإِذا ما كَوكَبٌ طَلَعا",43,"ع",2,0],["جال فِكري بِهَجوهم","وَدَعاني فَلَم أَجل",44,"ل",1,0],["جالس العقال واعقل عنهم","حكما فاقت على غالي اللآل",45,"ل",1,0],["جالب للنور مذهب للدرن","قائد للخير موصل كل سول",46,"ل",1,0],["جالس لكل عليم","يرشدك المنجيات",47,"ت",1,0],["جالباً للتحقيق من كل فنٍ","فتنعم من ذلك المجلوب",48,"ب",1,0],["جالت بخلات القصير أسابرٌ","شهب تصول وفي مخالبها المنا",49,"ن",2,1],["جالت وقد فتكت بالصيد قانصة","من آل حجلان ركباً عدهم أفلا",50,"ل",2,0],["جالس كل ذي فضل بصمت","وآداب وأوصاف بهيّه",51,"ي",2,0],["جال بنو مرعب فيها ضحى","ما فيهم إلّا لذا يذخر",52,"ر",1,0],["جال ماء الشباب فيه كما قد","جال ماءُ الحياة في الأملود",53,"د",1,0],["جال وشاحاها معاً والقرطان","وغصَّ غصَّ الكاشحين القلبان",54,"ن",1,0],["جالَ بِهِ فَارِسٌ ظَريفٌ","تَتبِعُهُ لحظَهَا العُيُونُ",55,"ن",1,0],["جالست من وزرائه وصحبت من","أمرائه أهل الثناء الخالد",56,"د",1,0],["جالَ عَلى مِرآتِهِ لَحظُهُ","فَاِنعَكَسَ السِحرُ بِهِ عَنهُ",57,"ن",2,0],["جالدت فيه كوارثا وشدائدا","فقضيت من شجن وأنت شهيد",58,"د",1,0],["جالِدُ الثَغرِ كُلَّ قَلبٍ إِلى أَن","فَتَقتَ ريحُ ذا الجَلادِ بِعَنبَر",59,"ر",1,0],["جالَ النِّطاقُ عَلى ما تَحتَ مِئزَرِه","مِنَ ضَمَّةٍ لُفَّ مِنها السُّوقُ والسّاقُ",60,"ق",1,0],["جالِس تَقيّ القَومِ واهدِ بِهديِه","في الحَيّ مهما كنتَ في الجًلاّس",61,"س",1,0],["جال في خصرك النطاق فجالت","فيه روحي فجد بروحي عليا",62,"ي",2,0],["جال في كل جانب منه حتى","حفز الريف واستفز الصعيدا",63,"د",2,0],["جالستُ فيه أبا الحسين بمجلسٍ","خِلَعُ الربيعِ على رُباهُ تُخلَع",64,"ع",1,0],["جالِبَ الأَفراحِ قانٍ لَونُهُ","مُطفِئاً مِن لاعِجِ الوَجدِ اللهَب",65,"ب",1,0],["جال