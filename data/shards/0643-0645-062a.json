{"poems":[[53,"اسقني فاليوم نشوان","https://www.aldiwan.net/poem29667.html","المديد"],[53,"ما أقل اعتبارنا بالزمان","https://www.aldiwan.net/poem29740.html","الخفيف"],[53,"كم ذميل إليكم ووجيف","https://www.aldiwan.net/poem29963.html","الخفيف"],[100,"أمي","https://www.aldiwan.net/poem23695.html","عموديه"],[55,"إن بالشط نحو دار المعلى","https://www.aldiwan.net/poem26478.html","الخفيف"],[86,"دمعة من دموع عهد الشباب","https://www.aldiwan.net/poem10372.html","الخفيف"],[86,"من ليوم نحن فيه من لغد","https://www.aldiwan.net/poem10478.html","الرمل"],[86,"دك ما بين ضحوة وعشي","https://www.aldiwan.net/poem10480.html","الخفيف"],[86,"كم تحت أذيال الظلام متيم","https://www.aldiwan.net/poem10862.html","الكامل"],[54,"يا واقفا يبكي الطلول وينشد","https://www.aldiwan.net/poem27436.html","الكامل"],[88,"الشعر مفتقر مني لمبتكر","https://www.aldiwan.net/poem44991.html","البسيط"],[88,"أدب العلم وعلم الأدب","https://www.aldiwan.net/poem45003.html","الرمل"],[88,"قل لنجلا نجلا أبي اللمع إني","https://www.aldiwan.net/poem45060.html","الخفيف"],[72,"لغرة الأفق بياض شدخ","https://www.aldiwan.net/poem18533.html","السريع"],[72,"كم تمسكت بممدوحين في","https://www.aldiwan.net/poem19962.html","الرمل"],[72,"سيدي شكرا لنعماك التي","https://www.aldiwan.net/poem20338.html","الرمل"],[95,"أمتي هل لك بين الأمم","https://www.aldiwan.net/poem60148.html","عموديه"],[51,"قل للأمير أدام الله دولته","https://www.aldiwan.net/poem8700.html","البسيط"],[51,"قل لنجح أخطأت باب النجاح","https://www.aldiwan.net/poem9402.html","الخفيف"],[51,"لا وألحاظ العيون الساحره","https://www.aldiwan.net/poem62878.html","الطويل"],[51,"قل لنا يا سلامة بن سعيد","https://www.aldiwan.net/poem64538.html","الخفيف"],[51,"أنهضه في أوان إنهاضه","https://www.aldiwan.net/poem64941.html","المنسرح"],[51,"مذ صرت همي في النوم واليقظه","https://www.aldiwan.net/poem65036.html","المنسرح"],[51,"حبذا حشمة الصديق إذا ما","https://www.aldiwan.net/poem65492.html","البسيط"],[51,"أبق من مالك الممزق","https://www.aldiwan.net/poem65792.html","مجزوء الخفيف"],[51,"لا تعذل النفس في تعجلها","https://www.aldiwan.net/poem65884.html","المنسرح"],[51,"قلبي من الطرفِ السقيم سقيم","https://www.aldiwan.net/poem66338.html","الكامل"],[29,"تغير الرسم من سلمى بأحفار","https://www.aldiwan.net/poem6035.html","البسيط"],[91,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[91,"شوق يروح مع الزمان ويغتدي","https://www.aldiwan.net/poem8800.html","عموديه"],[91,"أنت والكأس في يدي فلمن أنت في غد","https://www.aldiwan.net/poem8801.html","عموديه"],[91,"كم تستثير بي الصبابة والهوى","https://www.aldiwan.net/poem8963.html","عموديه"],[91,"يا لوعة حار النطاسي فيك","https://www.aldiwan.net/poem9051.html","عموديه"],[91,"لمن الديار تنوح فيها الشمأل","https://www.aldiwan.net/poem9061.html","عموديه"],[91,"كم تشتكي وتقول إنك معدم","https://www.aldiwan.net/poem62676.html","عموديه"],[91,"لو أستطيع كتبت بالنيران","https://www.aldiwan.net/poem62773.html","عموديه"],[91,"كم بين طيات العصور الخاليه","https://www.aldiwan.net/poem62819.html","عموديه"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[89,"من كان في المجد المؤثل راغبا","https://www.aldiwan.net/poem44986.html","الكامل"],[85,"صرح على الوادي المبارك ضاحي","https://www.aldiwan.net/poem62982.html","الكامل"],[43,"واحر قلباه ممن قلبه شبم","https://www.aldiwan.net/poem10521.html","البسيط"],[45,"أطلب النوم كي يعود غراره","https://www.aldiwan.net/poem63577.html","الخفيف"],[45,"لك عهد لدي غير مضاع","https://www.aldiwan.net/poem64657.html","الخفيف"],[45,"تيمته صبابة وإشتياق","https://www.aldiwan.net/poem65211.html","الخفيف"],[45,"كلما شاءت الرسوم المحيله","https://www.aldiwan.net/poem65542.html","الخفيف"],[61,"وليلة من نقمات الدهر","https://www.aldiwan.net/poem51629.html","الرجز"],[49,"إنقطاع الأيام عني سريع","https://www.aldiwan.net/poem62164.html","الخفيف"],[49,"داو بالرفق جراحات الخرق","https://www.aldiwan.net/poem62186.html","السريع"],[49,"يا ساكن القبر عن قليل","https://www.aldiwan.net/poem63066.html","مجزوء البسيط"],[49,"إنما الشيب لابن آدم ناع","https://www.aldiwan.net/poem63191.html","الخفيف"],[49,"إن أسوا يوم يمر عليا","https://www.aldiwan.net/poem63200.html","البسيط"],[66,"يا مليكا قد طاب أصلا وفرعا","https://www.aldiwan.net/poem41352.html","الخفيف"],[97,"كم تجرعنا هوانا","https://www.aldiwan.net/poem24766.html","مجزوء الرمل"],[97,"داوِ ناري والتياعي","https://www.aldiwan.net/poem24791.html","مجزوء الرمل"],[97,"يا حبيبي اسقني الأماني واشرب","https://www.aldiwan.net/poem24935.html","الخفيف"],[97,"يا فؤادي رحم الله الهوى","https://www.aldiwan.net/poem25088.html","الرمل"],[80,"أي خطب عن قوسه الموت يرمي","https://www.aldiwan.net/poem31283.html","الخفيف"],[80,"كم تعجب الناس من صيد ولا شرك","https://www.aldiwan.net/poem31470.html","البسيط"],[80,"أنكرت سقم مذاب الجسد","https://www.aldiwan.net/poem31487.html","الرمل"],[90,"نامي جياع الشعب نامي","https://www.aldiwan.net/poem59037.html","عموديه"],[105,"رحمة يا أبا بصير ونعمى","https://www.aldiwan.net/poem44063.html","الرمل"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"كم تائه بولاية","https://www.aldiwan.net/poem27091.html","مجزوء الكامل"],[52,"لي في التصابي واللهو حاجات","https://www.aldiwan.net/poem27187.html","المنسرح"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[48,"وغزال في الدجى لي","https://www.aldiwan.net/poem64326.html","مجزوء الرمل"],[48,"أنعت كلبا لقن النحاس","https://www.aldiwan.net/poem64347.html","الرجز"],[50,"بكرا صاحبي قبل الهجير","https://www.aldiwan.net/poem63820.html","الخفيف"],[46,"ما راعها من قرى عم وجارمها","https://www.aldiwan.net/poem23042.html","البسيط"],[46,"كم تنصح الدنيا ولا نقبل","https://www.aldiwan.net/poem23149.html","السريع"],[46,"عميانكم قرأت على أجداثكم","https://www.aldiwan.net/poem23326.html","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39572","الرمل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20989","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141932","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54296","الخفيف"],[106,"قالوا أحيل","https://www.poetsgate.com/ViewPoem.aspx?id=179396",""],[106,"عرش الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=179473",""],[106,"مولد الهادي الأمين","https://www.poetsgate.com/ViewPoem.aspx?id=179620",""],[45,"تَيَّمَتْهُ صَبَابَةٌ واشْتِيَاقُ","https://www.poetsgate.com/ViewPoem.aspx?id=32163",""],[45,"أطلُبُ النّوْمَ كَيْ يَعودَ غِرَارُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31262",""],[32,"أبت مقلتي كتمان ما بي","https://www.poetsgate.com/ViewPoem.aspx?id=116",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[97,"خمر الرضا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63550&r=&rc=96",""]],"verses":[["كَم تَخَلَّت مِن ضَمائِرِهِم","ثُمَّ أَلبانٌ وَأَذهانُ",0,"ن",1,0],["كَم تَراني أَضَلُّ نَفساً وَأَلهو","فَكَأَنّي وَثِقتُ بِالوَخَدانِ",1,"ن",1,0],["كَم تَحَمَّلتَها بِظَهرٍ مِنَ الصَب","رِ فَخَفَّت وَالعِبءُ غَيرُ خَفيفِ",2,"ف",1,0],["كم تذكّرت يديك وهما","في يدي أو في طعامي وشرابي",3,"ي",1,0],["كم تمنّينا وكم دلّلتني","تحت صمت اللّيل والشهب الخوابي",3,"ي",1,0],["كَم تَلَفَّتُّ حينَ جاوَزتُ بَغدا","دَ وَأَذرَيتُ مِن دُموعي غُروبا",4,"ب",2,0],["كَم تَجَمَّلتَ وَالأَمانِيُّ صَرعى","وَتَماسَكتَ وَالحُظوظُ كَوابي",5,"ب",2,0],["كَم تَمَنّى وَتَمَنّى أَهلُهُ","لَو يُوارى فيهِ ذَيّاكَ الجَسَد",6,"د",1,0],["كَم تَمَنّى لَو عاشَ حَتّى يَرانا","أُمَّةً ذاتَ مَنعَةٍ وَرُقِيِّ",7,"ي",1,0],["كَم تَحتَ أَذيالِ الظَلامِ مُتَيَّمُ","دامي الفُؤادِ وَلَيلُهُ لا يَعلَمُ",8,"م",1,1],["كَم تَدَّعي حُزناً وَأَنتَ مُرَفَّهٌ","إِن كُنتَ مَحزوناً فَما لَكَ تَرقُدُ",9,"د",1,0],["كم تَشرئَبّ لها الأسماع مُصغيةً","إذا تُنُوشدن بين البدوِ والحَضَر",10,"ر",1,0],["كم ترى للمجد سيفاً مُنْتضى","كم ترى للعلم فيها من مَنار",11,"ر",1,0],["كم تصفّحت فيه من صفحات","عطّرتني بنشرها الفياح",12,"ح",1,0],["كم تعقد الآفاقُ عقدَ اللّبا","منه وكم ينثرُ نثرَ اللبخ",13,"خ",1,0],["كم تمسكت بممدوحين في","حلبٍ رفدهما لي ما عُدِم",14,"م",1,1],["كم تدللنا لمن نقصده","وبنعماك تهذَّب قدرنا",15,"ن",2,0],["كم تخطيت على أصدائه","ملعب العز ومغنى الشمم",16,"م",1,0],["كمُتَّقٍ لفحَ نارٍ يستعدُّ لها","بالجهلِ درعينِ من نفطٍ وكبريتِ",17,"ت",1,0],["كم تَمَنَّيتَ قُبْلة من حَيَاها","وهو من أيْرِ ذاكَ دَامي الجراحِ",18,"ح",1,0],["كم تلافيتَ به من فائتٍ","وتألَّفْتَ به من نافره",19,"ر",2,0],["كم تخليت بالحسان وجوهاً","خلواتِ المُباح لا المحجوز",20,"ز",1,0],["كم تقنع النفس بالكفافِ وكم","تترك خوضَ الغِنَى لخُوَّاضه",21,"ض",2,0],["كم تحفظتَ من وصية مجدٍ","لم ينفِّلكَ حفظَها تحفيظ",22,"ظ",1,0],["كم ترى لي ذخيرة عند خل","سقطت من جرابه المخروق",23,"ق",1,0],["كم ترى العينُ حسرةً","ريُّها في جداولكْ",24,"ك",1,0],["كم تحسبُ العيشَ دار عُرْجتنا","وإنما العيشُ دارُ مُنْتقلِ",25,"ل",1,0],["كم تسكتونَ عن الذي تولونَهُ","لتصغِّروه وإنَّه لجسيم",26,"م",1,0],["كُمَّت ثَلاثَةَ أَحوالٍ بِطينَتِها","حَتّى إِذا صَرَّحَت مِن بَعدِ تَهدارِ",27,"ر",1,0],["كَم تُماري أَيُّحا الناسِكُ في الحَقِّ الصَريح","لَو أَرادَ اللَهَُ أَن لا تَعشَقَ الشَيءَ المَليح",28,"ح",1,0],["كَم تَنظُرينَ إِلى الثَرى مِن حالِقٍ","ما في الثَرى لِأَخي الأَسى مِن مُسعِدِ",29,"د",1,0],["كَم تَظُنُّ الظُنونَ بي","أَيُّها الزائِغُ اِهتَدِ",30,"د",1,0],["كَم تَستَثيرُ بِيَ الصَبابَة وَالهَوى","عَنّي إِلَيكَ فَإِنَّ قَلبي مِن حَجَر",31,"ر",1,1],["كَم تَجحَدينَ دَمي وَقَد أَبصَرتِهِ","وَرداً عَلى خَدَّيكِ غَيرَ مَشوكِ",32,"ك",1,0],["كَم تَتَّقونَ الطارِئاتِ وَنَتَّقي","كَم تَحمِلونَ الكارِثاتِ وَنَحمِلُ",33,"ل",1,0],["كَم تَشتَكي وَتَقولُ إِنَّكَ مُعدِمُ","وَالأَرضُ مِلكُكَ وَالسَما وَالأَنجُمُ",34,"م",1,1],["كَم تَسأَلوني أَن أُعيدَ زَمانَهُ","يا قَومُ مَرَّ زَمانُهُ وَزَماني",35,"ن",2,0],["كَم تَعشَقُ الدُنيا وَتُنكِرُ صَدَّها","أَنَسَيتَ أَنَّ الخُلفَ طَبعُ الغانِيَه",36,"ي",2,0],["كَم تَصبِرونَ عَلى الهَوانِ كَأَنَّكُم","في غَبطَةٍ وَالذُلُّ نارٌ حامِيَه",36,"ي",2,0],["كَم تَقتَفيني نَظَراتُ الخَنا","وَيلي مِن خائِنَةِ الأَعيُنِ",37,"ن",1,0],["كم تزرعون بأرضكم ولغيركم","مما زرعتم حَبّ كل حَصيد",38,"د",1,0],["كَم تاجِ تَضحِيَةٍ وَتاجِ كَرامَةٍ","لِلعَينِ حَولَ جَبينِهِ اللَمّاحِ",39,"ح",1,0],["كَم تَطلُبونَ لَنا عَيباً فَيُعجِزُكُم","وَيَكرَهُ اللَهُ ما تَأتونَ وَالكَرَمُ",40,"م",1,0],["كَم تَلاقٍ أَراكَهُ مِن قَريبٍ","صِلَةُ الطَيفِ طارِقَن وَاِزدِيارُه",41,"ر",2,0],["كَم تَنَدَّمتُ لِلفِراقِ وَكَم أَز","مَعتُ بَيناً فَما حَمِدتُ زَماعي",42,"ي",1,0],["كَم تَشُقُّ الجُيوبُ في مَأتَمِ البَي","نِ وَتَدمى لَهُ الخُدوُ الرِقاقُ",43,"ق",1,0],["كَم تَكَرَّهتُ غِبَّ أَمرٍ فَكانَت","عادَةُ الدَهرِ فيهِ عِندي جَميلَه",44,"ل",2,0],["كُمْتٍ إذا عايَنتَها وشُقْرِ","كأنها آثارُها في الأُزرِ",45,"ر",1,0],["كَم تَعَلَّلتَ بِالمُنى وَكأَنّي","بِكَ يا ذا المُنى وَأَنتَ صَريعُ",46,"ع",1,0],["كَم تَرانا يَأَخي نَبقى عَلى","جَوَلانِ المَوتِ في هَذا الأُفُق",47,"ق",1,0],["كَم تَرَكَ الدَهرُ مِن أُناسٍ","يَدعونَ بِالوَيلِ وَالعَويلِ",48,"ل",1,0],["كَم تَرى اللَيلَ وَالنَهارَ يَدوما","نِ لِمَن مَدَّ لَهوَهُ وَصِباهُ",49,"ه",1,0],["كَم تَغُرُّ الدُنيا وَكَم يَجِدُ الإِن","سانُ فيها شَيئاً وَيُحرَمُ شَيّا",50,"ي",2,0],["كَم تَحَمَّلتَ في طِلابِكَ لِلعَل","ياءِ ثِقلاً يَسيرُهُ لا يُطاقُ",51,"ق",1,0],["كم تجرّعنا هوانا","ولقينا في هوانا",52,"ن",2,1],["كم تمنيتُ وكم من","أملٍ مرّ الخداع",53,"ع",1,0],["كم تمنيت والصدور تجافيني","وتزور والوجوه تقطب",54,"ب",1,0],["كم تمنيت صدرك البر يرتاحُ","على خفقه الطريد المعذب",54,"ب",1,0],["كم تقلبت على خنجره","لا الهوى مال ولا الجفن عفا",55,"ف",2,0],["كم تكفّلتِ من كبيرة سنِّ","وتبنّيْتِ من صغيرة يُتمِ",56,"م",1,0],["كم تعجبُ الناسُ من صَيْدٍ ولا شَرَكٍ","يَصيدُ رئمٌ به قَلبي سِوى نَظَري",57,"ر",2,1],["كَم تَغَنّى بِالمَنايا في الطلا","ظ