[458,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[458,"في الظباء الغادين أمس غزال","https://www.aldiwan.net/poem56073.html","الخفيف"],[458,"سافر بطرفك واشترف هل تعرف","https://www.aldiwan.net/poem56112.html","الكامل"],[458,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[458,"رق لبغداد القضاء والقدر","https://www.aldiwan.net/poem56181.html","الرجز"],[458,"حاشاك من عارية ترد","https://www.aldiwan.net/poem56234.html","الوافر"],[458,"من عذيري يوم شرقي الحمى","https://www.aldiwan.net/poem56251.html","الرمل"],[464,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[464,"سهر البرق من صفات المعنى","https://www.aldiwan.net/poem3428.html","عموديه"],[464,"بكت وقد أبصرتني ضاحك الشعر","https://www.aldiwan.net/poem3471.html","عموديه"],[479,"ما لسلمي يهزها الخيلاء","https://www.aldiwan.net/poem36923.html","الخفيف"],[479,"عاطني يا تونسي في نخبها","https://www.aldiwan.net/poem37603.html","الرمل"],[514,"شرف الوجه في تراب زرود","https://www.aldiwan.net/poem20806.html","الخفيف"],[514,"نظر البدر وجهها فتلاها","https://www.aldiwan.net/poem20822.html","الخفيف"],[514,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[514,"حتام يا نفس من سكر الهوى تصحين","https://www.aldiwan.net/poem20933.html","المواليا"],[515,"العلم مذ كان محتاج إلى العلم","https://www.aldiwan.net/poem12262.html","البسيط"],[520,"يا زمان العكس قلاب الأمور","https://www.aldiwan.net/poem818.html",""],[538,"أينما كنت كنت رمز الكمال","https://www.aldiwan.net/poem47986.html","عموديه"],[551,"يا آل خير عباد الله كلهم","https://www.aldiwan.net/poem47180.html","البسيط"],[551,"أيها السائل كي يعلم","https://www.aldiwan.net/poem47282.html","مجزوء الرمل"],[551,"صدت وما صدها إلا على ياس","https://www.aldiwan.net/poem47749.html","البسيط"],[562,"نادى منادي البين حي على السرى","https://www.aldiwan.net/poem52892.html","الكامل"],[575,"صح من دهرنا وفاة الحياء","https://www.aldiwan.net/poem2790.html","الخفيف"],[575,"كم لنا من خلس في الغلس","https://www.aldiwan.net/poem2928.html","الرمل"],[575,"لست أدري بأي فتح تهنا","https://www.aldiwan.net/poem3001.html","الخفيف"],[575,"عادني من هوى الأحبة عيد","https://www.aldiwan.net/poem3078.html","الخفيف"],[586,"كيف يلحى على هواك الكئيب","https://www.aldiwan.net/poem17414.html","الخفيف"],[586,"عودي إلى حسن التأتي","https://www.aldiwan.net/poem17458.html","مجزوء الكامل"],[586,"يا ذا القمر المنير في الآفاق","https://www.aldiwan.net/poem17632.html","الدوبيت"]],"verses":[["كَم تَخَلَّت مِن ضَمائِرِهِم","ثُمَّ أَلبانٌ وَأَذهانُ",0,"ن",1,0],["كَم تَراني أَضَلُّ نَفساً وَأَلهو","فَكَأَنّي وَثِقتُ بِالوَخَدانِ",1,"ن",1,0],["كَم تَحَمَّلتَها بِظَهرٍ مِنَ الصَب","رِ فَخَفَّت وَالعِبءُ غَيرُ خَفيفِ",2,"ف",1,0],["كم تذكّرت يديك وهما","في يدي أو في طعامي وشرابي",3,"ي",1,0],["كم تمنّينا وكم دلّلتني","تحت صمت اللّيل والشهب الخوابي",3,"ي",1,0],["كم تناديني فتغري لوعتي","وتولّى كالحبيب ... الماكر",4,"ر",1,0],["كَم تَلَفَّتُّ حينَ جاوَزتُ بَغدا","دَ وَأَذرَيتُ مِن دُموعي غُروبا",5,"ب",2,0],["كَم تَجَمَّلتَ وَالأَمانِيُّ صَرعى","وَتَماسَكتَ وَالحُظوظُ كَوابي",6,"ب",2,0],["كَم تَمَنّى وَتَمَنّى أَهلُهُ","لَو يُوارى فيهِ ذَيّاكَ الجَسَد",7,"د",1,0],["كَم تَمَنّى لَو عاشَ حَتّى يَرانا","أُمَّةً ذاتَ مَنعَةٍ وَرُقِيِّ",8,"ي",1,0],["كَم تَحتَ أَذيالِ الظَلامِ مُتَيَّمُ","دامي الفُؤادِ وَلَيلُهُ لا يَعلَمُ",9,"م",1,1],["كَم تَدَّعي حُزناً وَأَنتَ مُرَفَّهٌ","إِن كُنتَ مَحزوناً فَما لَكَ تَرقُدُ",10,"د",1,0],["كم تَشرئَبّ لها الأسماع مُصغيةً","إذا تُنُوشدن بين البدوِ والحَضَر",11,"ر",1,0],["كم ترى للمجد سيفاً مُنْتضى","كم ترى للعلم فيها من مَنار",12,"ر",1,0],["كم تصفّحت فيه من صفحات","عطّرتني بنشرها الفياح",13,"ح",1,0],["كم تعقد الآفاقُ عقدَ اللّبا","منه وكم ينثرُ نثرَ اللبخ",14,"خ",1,0],["كم تمسكت بممدوحين في","حلبٍ رفدهما لي ما عُدِم",15,"م",1,1],["كم تدللنا لمن نقصده","وبنعماك تهذَّب قدرنا",16,"ن",2,0],["كم تخطيت على أصدائه","ملعب العز ومغنى الشمم",17,"م",1,0],["كمُتَّقٍ لفحَ نارٍ يستعدُّ لها","بالجهلِ درعينِ من نفطٍ وكبريتِ",18,"ت",1,0],["كم تَمَنَّيتَ قُبْلة من حَيَاها","وهو من أيْرِ ذاكَ دَامي الجراحِ",19,"ح",1,0],["كم تلافيتَ به من فائتٍ","وتألَّفْتَ به من نافره",20,"ر",2,0],["كم تخليت بالحسان وجوهاً","خلواتِ المُباح لا المحجوز",21,"ز",1,0],["كم تقنع النفس بالكفافِ وكم","تترك خوضَ الغِنَى لخُوَّاضه",22,"ض",2,0],["كم تحفظتَ من وصية مجدٍ","لم ينفِّلكَ حفظَها تحفيظ",23,"ظ",1,0],["كم ترى لي ذخيرة عند خل","سقطت من جرابه المخروق",24,"ق",1,0],["كم ترى العينُ حسرةً","ريُّها في جداولكْ",25,"ك",1,0],["كم تحسبُ العيشَ دار عُرْجتنا","وإنما العيشُ دارُ مُنْتقلِ",26,"ل",1,0],["كم تسكتونَ عن الذي تولونَهُ","لتصغِّروه وإنَّه لجسيم",27,"م",1,0],["كُمَّت ثَلاثَةَ أَحوالٍ بِطينَتِها","حَتّى إِذا صَرَّحَت مِن بَعدِ تَهدارِ",28,"ر",1,0],["كَم تُماري أَيُّحا الناسِكُ في الحَقِّ الصَريح","لَو أَرادَ اللَهَُ أَن لا تَعشَقَ الشَيءَ المَليح",29,"ح",1,0],["كَم تَنظُرينَ إِلى الثَرى مِن حالِقٍ","ما في الثَرى لِأَخي الأَسى مِن مُسعِدِ",30,"د",1,0],["كَم تَظُنُّ الظُنونَ بي","أَيُّها الزائِغُ اِهتَدِ",31,"د",1,0],["كَم تَستَثيرُ بِيَ الصَبابَة وَالهَوى","عَنّي إِلَيكَ فَإِنَّ قَلبي مِن حَجَر",32,"ر",1,1],["كَم تَجحَدينَ دَمي وَقَد أَبصَرتِهِ","وَرداً عَلى خَدَّيكِ غَيرَ مَشوكِ",33,"ك",1,0],["كَم تَتَّقونَ الطارِئاتِ وَنَتَّقي","كَم تَحمِلونَ الكارِثاتِ وَنَحمِلُ",34,"ل",1,0],["كَم تَشتَكي وَتَقولُ إِنَّكَ مُعدِمُ","وَالأَرضُ مِلكُكَ وَالسَما وَالأَنجُمُ",35,"م",1,1],["كَم تَسأَلوني أَن أُعيدَ زَمانَهُ","يا قَومُ مَرَّ زَمانُهُ وَزَماني",36,"ن",2,0],["كَم تَعشَقُ الدُنيا وَتُنكِرُ صَدَّها","أَنَسَيتَ أَنَّ الخُلفَ طَبعُ الغانِيَه",37,"ي",2,0],["كَم تَصبِرونَ عَلى الهَوانِ كَأَنَّكُم","في غَبطَةٍ وَالذُلُّ نارٌ حامِيَه",37,"ي",2,0],["كَم تَقتَفيني نَظَراتُ الخَنا","وَيلي مِن خائِنَةِ الأَعيُنِ",38,"ن",1,0],["كم تزرعون بأرضكم ولغيركم","مما زرعتم حَبّ كل حَصيد",39,"د",1,0],["كَم تاجِ تَضحِيَةٍ وَتاجِ كَرامَةٍ","لِلعَينِ حَولَ جَبينِهِ اللَمّاحِ",40,"ح",1,0],["كَم تَطلُبونَ لَنا عَيباً فَيُعجِزُكُم","وَيَكرَهُ اللَهُ ما تَأتونَ وَالكَرَمُ",41,"م",1,0],["كَم تَلاقٍ أَراكَهُ مِن قَريبٍ","صِلَةُ الطَيفِ طارِقَن وَاِزدِيارُه",42,"ر",2,0],["كَم تَنَدَّمتُ لِلفِراقِ وَكَم أَز","مَعتُ بَيناً فَما حَمِدتُ زَماعي",43,"ي",1,0],["كَم تَشُقُّ الجُيوبُ في مَأتَمِ البَي","نِ وَتَدمى لَهُ الخُدوُ الرِقاقُ",44,"ق",1,0],["كَم تَكَرَّهتُ غِبَّ أَمرٍ فَكانَت","عادَةُ الدَهرِ فيهِ عِندي جَميلَه",45,"ل",2,0],["كُمْتٍ إذا عايَنتَها وشُقْرِ","كأنها آثارُها في الأُزرِ",46,"ر",1,0],["كَم تَعَلَّلتَ بِالمُنى وَكأَنّي","بِكَ يا ذا المُنى وَأَنتَ صَريعُ",47,"ع",1,0],["كَم تَرانا يَأَخي نَبقى عَلى","جَوَلانِ المَوتِ في هَذا الأُفُق",48,"ق",1,0],["كَم تَرَكَ الدَهرُ مِن أُناسٍ","يَدعونَ بِالوَيلِ وَالعَويلِ",49,"ل",1,0],["كَم تَرى اللَيلَ وَالنَهارَ يَدوما","نِ لِمَن مَدَّ لَهوَهُ وَصِباهُ",50,"ه",1,0],["كَم تَغُرُّ الدُنيا وَكَم يَجِدُ الإِن","سانُ فيها شَيئاً وَيُحرَمُ شَيّا",51,"ي",2,0],["كَم تَحَمَّلتَ في طِلابِكَ لِلعَل","ياءِ ثِقلاً يَسيرُهُ لا يُطاقُ",52,"ق",1,0],["كم تجرّعنا هوانا","ولقينا في هوانا",53,"ن",2,1],["كم تمنيتُ وكم من","أملٍ مرّ الخداع",54,"ع",1,0],["كم تمنيت والصدور تجافيني","وتزور والوجوه تقطب",55,"ب",1,0],["كم تمنيت صدرك البر يرتاحُ","على خفقه الطريد المعذب",55,"ب",1,0],["كم تقلبت على خنجره","لا الهوى مال ولا الجفن عفا",56,"ف",2,0],["كم تكفّلتِ من كبيرة سنِّ","وتبنّيْتِ من صغيرة يُتمِ",57,"م",1,0],["كم تعجبُ الناسُ من صَيْدٍ ولا شَرَكٍ","يَصيدُ رئمٌ به قَلبي سِوى نَظَري",58,"ر",2,1],["كَم تَغَنّى بِالمَنايا في الطلا","ظَبتاهُ عَن أَغاني مَعبَدِ",59,"د",1,0],["كم تصمُدِينَ على العِتَابِ","وتَسْخَرينَ من الملامِ",60,"م",1,0],["كَم تَمنّيتَ أن ترى لك حصناً","فَتَأمَّلْ حُصونَ ربِّكَ شُمَّا",61,"م",2,0],["كُمتٍ تُشَبِّهُها عِتا","قَ قَرائِنِ السِبتِ العَواطِل",62,"ل",1,0],["كَم تاجِرٍ رَوَّغَهُم بِزَورَقِه","فَأَغمَدوا سُيوفَهُم في مَفرِقِه",63,"ه",1,0],["كَم تائِهٍ بِوِلايَةٍ","وَبِعَذلِهِ يَعدو البَريد",64,"د",1,1],["كَم تَوبَةٍ قَد فَضَضتُ خاتَمَها","عَنّي وَلِلتائِبينَ رَجعاتُ",65,"ت",1,0],["كم تَنهضُونَ بعبءِ عارٍ واصِمٍ","والعارُ يأنَفُ منكُمُ والنَار",66,"ر",1,0],["كَم تَرى مِثلَكَ يا جا","هِلُ قَد مَرَّ بِراسي",67,"س",2,0],["كَم تَيسِ رَملِ لاحَ في الكِناسِ","عَفَّرَهُ بِجانِبَي أَوطاسِ",68,"س",1,0],["كَم تَلافى أَبوكَ مِن خائَفٍ جا