لوافر"],[456,"من عذيري يوم شرقي الحمى","https://www.aldiwan.net/poem56251.html","الرمل"],[462,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[462,"سهر البرق من صفات المعنى","https://www.aldiwan.net/poem3428.html","عموديه"],[462,"بكت وقد أبصرتني ضاحك الشعر","https://www.aldiwan.net/poem3471.html","عموديه"],[477,"ما لسلمي يهزها الخيلاء","https://www.aldiwan.net/poem36923.html","الخفيف"],[477,"عاطني يا تونسي في نخبها","https://www.aldiwan.net/poem37603.html","الرمل"],[512,"شرف الوجه في تراب زرود","https://www.aldiwan.net/poem20806.html","الخفيف"],[512,"نظر البدر وجهها فتلاها","https://www.aldiwan.net/poem20822.html","الخفيف"],[512,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[512,"حتام يا نفس من سكر الهوى تصحين","https://www.aldiwan.net/poem20933.html","المواليا"],[513,"العلم مذ كان محتاج إلى العلم","https://www.aldiwan.net/poem12262.html","البسيط"],[518,"يا زمان العكس قلاب الأمور","https://www.aldiwan.net/poem818.html",""],[536,"أينما كنت كنت رمز الكمال","https://www.aldiwan.net/poem47986.html","عموديه"],[549,"يا آل خير عباد الله كلهم","https://www.aldiwan.net/poem47180.html","البسيط"],[549,"أيها السائل كي يعلم","https://www.aldiwan.net/poem47282.html","مجزوء الرمل"],[549,"صدت وما صدها إلا على ياس","https://www.aldiwan.net/poem47749.html","البسيط"],[560,"نادى منادي البين حي على السرى","https://www.aldiwan.net/poem52892.html","الكامل"],[573,"صح من دهرنا وفاة الحياء","https://www.aldiwan.net/poem2790.html","الخفيف"],[573,"كم لنا من خلس في الغلس","https://www.aldiwan.net/poem2928.html","الرمل"],[573,"لست أدري بأي فتح تهنا","https://www.aldiwan.net/poem3001.html","الخفيف"],[573,"عادني من هوى الأحبة عيد","https://www.aldiwan.net/poem3078.html","الخفيف"],[584,"كيف يلحى على هواك الكئيب","https://www.aldiwan.net/poem17414.html","الخفيف"],[584,"عودي إلى حسن التأتي","https://www.aldiwan.net/poem17458.html","مجزوء الكامل"],[584,"يا ذا القمر المنير في الآفاق","https://www.aldiwan.net/poem17632.html","الدوبيت"]],"verses":[["كَم تَخَلَّت مِن ضَمائِرِهِم","ثُمَّ أَلبانٌ وَأَذهانُ",0,"ن",1,0],["كَم تَراني أَضَلُّ نَفساً وَأَلهو","فَكَأَنّي وَثِقتُ بِالوَخَدانِ",1,"ن",1,0],["كَم تَحَمَّلتَها بِظَهرٍ مِنَ الصَب","رِ فَخَفَّت وَالعِبءُ غَيرُ خَفيفِ",2,"ف",1,0],["كم تذكّرت يديك وهما","في يدي أو في طعامي وشرابي",3,"ي",1,0],["كم تمنّينا وكم دلّلتني","تحت صمت اللّيل والشهب الخوابي",3,"ي",1,0],["كَم تَلَفَّتُّ حينَ جاوَزتُ بَغدا","دَ وَأَذرَيتُ مِن دُموعي غُروبا",4,"ب",2,0],["كَم تَجَمَّلتَ وَالأَمانِيُّ صَرعى","وَتَماسَكتَ وَالحُظوظُ كَوابي",5,"ب",2,0],["كَم تَمَنّى وَتَمَنّى أَهلُهُ","لَو يُوارى فيهِ ذَيّاكَ الجَسَد",6,"د",1,0],["كَم تَمَنّى لَو عاشَ حَتّى يَرانا","أُمَّةً ذاتَ مَنعَةٍ وَرُقِيِّ",7,"ي",1,0],["كَم تَحتَ أَذيالِ الظَلامِ مُتَيَّمُ","دامي الفُؤادِ وَلَيلُهُ لا يَعلَمُ",8,"م",1,1],["كَم تَدَّعي حُزناً وَأَنتَ مُرَفَّهٌ","إِن كُنتَ مَحزوناً فَما لَكَ تَرقُدُ",9,"د",1,0],["كم تَشرئَبّ لها الأسماع مُصغيةً","إذا تُنُوشدن بين البدوِ والحَضَر",10,"ر",1,0],["كم ترى للمجد سيفاً مُنْتضى","كم ترى للعلم فيها من مَنار",11,"ر",1,0],["كم تصفّحت فيه من صفحات","عطّرتني بنشرها الفياح",12,"ح",1,0],["كم تعقد الآفاقُ عقدَ اللّبا","منه وكم ينثرُ نثرَ اللبخ",13,"خ",1,0],["كم تمسكت بممدوحين في","حلبٍ رفدهما لي ما عُدِم",14,"م",1,1],["كم تدللنا لمن نقصده","وبنعماك تهذَّب قدرنا",15,"ن",2,0],["كم تخطيت على أصدائه","ملعب العز ومغنى الشمم",16,"م",1,0],["كمُتَّقٍ لفحَ نارٍ يستعدُّ لها","بالجهلِ درعينِ من نفطٍ وكبريتِ",17,"ت",1,0],["كم تَمَنَّيتَ قُبْلة من حَيَاها","وهو من أيْرِ ذاكَ دَامي الجراحِ",18,"ح",1,0],["كم تلافيتَ به من فائتٍ","وتألَّفْتَ به من نافره",19,"ر",2,0],["كم تخليت بالحسان وجوهاً","خلواتِ المُباح لا المحجوز",20,"ز",1,0],["كم تقنع النفس بالكفافِ وكم","تترك خوضَ الغِنَى لخُوَّاضه",21,"ض",2,0],["كم تحفظتَ من وصية مجدٍ","لم ينفِّلكَ حفظَها تحفيظ",22,"ظ",1,0],["كم ترى لي ذخيرة عند خل","سقطت من جرابه المخروق",23,"ق",1,0],["كم ترى العينُ حسرةً","ريُّها في جداولكْ",24,"ك",1,0],["كم تحسبُ العيشَ دار عُرْجتنا","وإنما العيشُ دارُ مُنْتقلِ",25,"ل",1,0],["كم تسكتونَ عن الذي تولونَهُ","لتصغِّروه وإنَّه لجسيم",26,"م",1,0],["كُمَّت ثَلاثَةَ أَحوالٍ بِطينَتِها","حَتّى إِذا صَرَّحَت مِن بَعدِ تَهدارِ",27,"ر",1,0],["كَم تُماري أَيُّحا الناسِكُ في الحَقِّ الصَريح","لَو أَرادَ اللَهَُ أَن لا تَعشَقَ الشَيءَ المَليح",28,"ح",1,0],["كَم تَنظُرينَ إِلى الثَرى مِن حالِقٍ","ما في الثَرى لِأَخي الأَسى مِن مُسعِدِ",29,"د",1,0],["كَم تَظُنُّ الظُنونَ بي","أَيُّها الزائِغُ اِهتَدِ",30,"د",1,0],["كَم تَستَثيرُ بِيَ الصَبابَة وَالهَوى","عَنّي إِلَيكَ فَإِنَّ قَلبي مِن حَجَر",31,"ر",1,1],["كَم تَجحَدينَ دَمي وَقَد أَبصَرتِهِ","وَرداً عَلى خَدَّيكِ غَيرَ مَشوكِ",32,"ك",1,0],["كَم تَتَّقونَ الطارِئاتِ وَنَتَّقي","كَم تَحمِلونَ الكارِثاتِ وَنَحمِلُ",33,"ل",1,0],["كَم تَشتَكي وَتَقولُ إِنَّكَ مُعدِمُ","وَالأَرضُ مِلكُكَ وَالسَما وَالأَنجُمُ",34,"م",1,1],["كَم تَسأَلوني أَن أُعيدَ زَمانَهُ","يا قَومُ مَرَّ زَمانُهُ وَزَماني",35,"ن",2,0],["كَم تَعشَقُ الدُنيا وَتُنكِرُ صَدَّها","أَنَسَيتَ أَنَّ الخُلفَ طَبعُ الغانِيَه",36,"ي",2,0],["كَم تَصبِرونَ عَلى الهَوانِ كَأَنَّكُم","في غَبطَةٍ وَالذُلُّ نارٌ حامِيَه",36,"ي",2,0],["كَم تَقتَفيني نَظَراتُ الخَنا","وَيلي مِن خائِنَةِ الأَعيُنِ",37,"ن",1,0],["كم تزرعون بأرضكم ولغيركم","مما زرعتم حَبّ كل حَصيد",38,"د",1,0],["كَم تاجِ تَضحِيَةٍ وَتاجِ كَرامَةٍ","لِلعَينِ حَولَ جَبينِهِ اللَمّاحِ",39,"ح",1,0],["كَم تَطلُبونَ لَنا عَيباً فَيُعجِزُكُم","وَيَكرَهُ اللَهُ ما تَأتونَ وَالكَرَمُ",40,"م",1,0],["كَم تَلاقٍ أَراكَهُ مِن قَريبٍ","صِلَةُ الطَيفِ طارِقَن وَاِزدِيارُه",41,"ر",2,0],["كَم تَنَدَّمتُ لِلفِراقِ وَكَم أَز","مَعتُ بَيناً فَما حَمِدتُ زَماعي",42,"ي",1,0],["كَم تَشُقُّ الجُيوبُ في مَأتَمِ البَي","نِ وَتَدمى لَهُ الخُدوُ الرِقاقُ",43,"ق",1,0],["كَم تَكَرَّهتُ غِبَّ أَمرٍ فَكانَت","عادَةُ الدَهرِ فيهِ عِندي جَميلَه",44,"ل",2,0],["كُمْتٍ إذا عايَنتَها وشُقْرِ","كأنها آثارُها في الأُزرِ",45,"ر",1,0],["كَم تَعَلَّلتَ بِالمُنى وَكأَنّي","بِكَ يا ذا المُنى وَأَنتَ صَريعُ",46,"ع",1,0],["كَم تَرانا يَأَخي نَبقى عَلى","جَوَلانِ المَوتِ في هَذا الأُفُق",47,"ق",1,0],["كَم تَرَكَ الدَهرُ مِن أُناسٍ","يَدعونَ بِالوَيلِ وَالعَويلِ",48,"ل",1,0],["كَم تَرى ال