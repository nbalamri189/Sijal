/poem/94641","الوافر"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105512","المتقارب"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73269","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83592","الطويل"],[4461,"","https://poetry.dctabudhabi.ae/diwan/poem/116095",""],[4546,"","https://poetry.dctabudhabi.ae/diwan/poem/146538","الطويل"],[4729,"أَرَاجِعٌ لي عَيشي الفَارِطُ","https://www.poetsgate.com/ViewPoem.aspx?id=109457",""],[4755,"لِأَنَّ صَنعَاءَ لا تُضِيءُ","https://www.poetsgate.com/ViewPoem.aspx?id=198020",""],[4767,"طفل الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=88355",""],[463,"أجدك بعد أن ضمَّ الكثيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=17990",""],[4882,"اجبني فحتى الماء فجره الصخرُ_بهاء الدين الخاقاني","https://www.poetsgate.com/ViewPoem.aspx?id=7332",""],[5106,"إعتذارٌ لعمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=137303",""],[5112,"طارق","https://www.poetsgate.com/ViewPoem.aspx?id=212407",""],[5112,"فارس التعليم","https://www.poetsgate.com/ViewPoem.aspx?id=214649",""],[5616,"رزان","https://www.poetsgate.com/ViewPoem.aspx?id=203503",""],[5638,"عندما بكى وبكيته الكتاب","https://www.poetsgate.com/ViewPoem.aspx?id=198127",""],[5781,"لم يْشفِهِ الطبُّ","https://www.poetsgate.com/ViewPoem.aspx?id=210379",""],[5986,"أقدم سيدي منك اعتذارا","https://www.poetsgate.com/ViewPoem.aspx?id=162954",""],[6124,"يشاطر الهدب دمعتي","https://www.poetsgate.com/ViewPoem.aspx?id=121832",""],[520,"ترى عند نجم الدين علم بما عندي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577481",""],[463,"سلْ بالغويرِ السائقَ المغلِّسا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60106&r=&rc=162",""],[5616,"أمي ..!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1926&r=&rc=1",""],[6338,"لك الله بالنصر العزيز كفيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52538&r=&rc=0",""]],"verses":[["وَهَلْ عِنْدَكُمْ عِلْمٌ بِصَبْريَ أَنَّنِي","فَقَدتُ جَمِيلَ الصَّبْرِ أَوْجَعَ فُقْدَانِ",0,"ن",1,0],["وهل عرجت أرواح من في عطاردٍ","إلى الأرض أم هذا الكلام من الهذر",1,"ر",1,0],["وَهَل عُذرٌ وَسَيفُ الدينِ رُكني","إِذا لَم أَركَبِ الخُطَطَ العِظاما",2,"م",2,0],["وَهَل عَدَلَت يَوماً رَزِيَّةُ هالِكٍ","رَزِيَّةَ يَومٍ ماتَ فيهِ مُحَمَّدُ",3,"د",1,0],["وهل عِرسُ الفتى إلا غَبيطٌ","يميل غبيطُها لولا العديل",4,"ل",1,0],["وَهَل عالَجَ الأَحياءُ بُؤساً وَشِقوَةً","وَقَلَّ فَسادٌ بَينَهُم وَشُرورُ",5,"ر",1,0],["وهل عندكم صبرٌ جميلٌ فتعمرُوا","فُؤاداً من الصبرِ الجميلِ خرابَا",6,"ب",2,0],["وَهَل عَلِمَت أَنّي ضَنيتُ وَأَنَّها","شِفائِيَ مِن داءِ الضَنى وَسَقامي",7,"م",2,0],["وَهَل عَزَّ المَليكُ بِغَيرِ عَزمٍ","يُقيمُ بِهِ مِنَ المُلكِ العِمادا",8,"د",2,0],["وَهَل عِندَكُم عَتبي فَيَرجِعَ مُحسِنٌ","بِعَينِ الرِضا وَالعَفوِ نائِلُهُ بَسطُ",9,"ط",1,0],["وَهَل عَربَدَ مَكروبٌ","قَريحُ القَلبِ مَعمودُ",10,"د",1,0],["وَهَل عُصِمَت جِبالٌ أَو بِحارٌ","فَتَنجو ساكِناتٌ بِالرِمالِ",11,"ل",1,0],["وهل عَذَبَاتُ الرّنِد يُقْطَفُ نورها","وهل سَلَماتٌ بالحِجاز أيانع",12,"ع",1,0],["وهل عامرٌ من بَعْدِنا شِعبُ عامرٍ","وهل هوَ يوماً للمُحبّينَ جامع",12,"ع",1,0],["وهل علم الذين توعدوني","بأَني لا يخوّفني الوعيد",13,"د",1,0],["وهل عُدَّ يوماً غير ذي عبقرية","من الشعراء المستقلين في الفكر",14,"ر",1,0],["وَهَل عرصات الحي بعدُ عذيةٌ","وَهَل جنبات الحي باسقةُ النخل",15,"ل",1,0],["وَهَل على الطير يشدو","لمثله من جَناح",16,"ح",1,0],["وَهَل عليك رعاك اللَه من عتب","إذا دللت على الغدران ظمآنا",17,"ن",2,0],["وهَلْ عَاشِقٌ رُدَّ عَنْ حَاجَةٍ","كَذشي حَاجَةٍ أَمكَنَتْهُ فَنَالاَ",18,"ل",2,0],["وهَلْ عَلِمْتِ إِذَا لاَذَ الظِّبَاء وقَدْ","ظَلَّ السَّرَابُ عَلَى جِزَّانِهِ يَضَعُ",19,"ع",1,0],["وَهَلْ عَجَبٌ كَحَانُوتٍ غَدَوْنَا","نَرَاهُ مَطْلَعَ الْقَمَرِ المُنِيرِ",20,"ر",1,0],["وهل عانيتِ ما عانيتُ.. جُرحاً","تجهّمه الطبيبُ! بلا اندمال؟",21,"ل",1,0],["وهل عندي سوى عمرٍ تعاني","بقاياهُ .. بمِقصلة الصقيع؟",22,"ع",1,0],["وهل عائبُ الأرض أن حُمّلتْ","من الجن والإنس أثقالها",23,"ل",3,0],["وهل عن الخصب للمرتاد منصرفٌ","أم هل عن الأمن للمرتاد تنفيض",24,"ض",1,0],["وهل عرقه وجه السري نقيبة","تزين وهل بخس الكرام مكارم",25,"م",1,0],["وهل عنده أن الجهاد فريضة","وقد وضح الامكان والخصم خائم",25,"م",1,0],["وهل عنده أن المقدر كائن","وان وقوع الحتف بالمرء لازم",25,"م",1,0],["وهل عنده أن المعالي صعبة ال","مراقي وأهلوها السراة اللهامم",25,"م",1,0],["وهل عنده أن الحدود تعطلت","وان حقوق المسلمين عنائم",25,"م",1,0],["وهل عنده أن المناهي أكرمت","وناب أعادي الله في العرف آزم",25,"م",1,0],["وهل عنده للاستقامة نصرة","وقد هجمت للقاسطين الهواجم",25,"م",1,0],["وهل عند \"عيسى\" أن للفرض عادة","قديمة ذكر جددتها المقادم",25,"م",1,0],["وهل عَرَف الموت إذ غاله","بما أيِّ عِلْقٍ نفيس ظفِر",26,"ر",1,0],["وهلْ علمْتِ إذا لاذَ الظِّباء وقدْ","ظلَّ السَّراب على حزَّانه يضع",27,"ع",1,0],["وهل عِرضُ الفتى إلاغَبيط","يميل غِبطُها لولا العديل",28,"ل",1,0],["وهل عيبٌ على شَفَراتِ سيفي","إذا استمحنتُها في لحمِ كلبٍ",29,"ب",1,0],["وَهَل عَدِمَت أَعداؤُها مِن سُيوفِها","رُسوماً تُعَفّى أَو قُروماً تُعَفَّرُ",30,"ر",1,0],["وهل على الحسناء ذنب إذا","ما ركبت في هذه الصورة",31,"ه",1,0],["وهل على الصاحي وقد رق له","نسميها الرطب جناحِ إِن شكر",32,"ر",1,0],["وهل علي وقد أجملت في طلبي","عار إذا لم أجد في الأمر إمكانا",33,"ن",2,0],["وهل عرف الإِسلام من رد سمعه","عن السنة البيضاء يستمع اللغوى",34,"و",2,0],["وَهَل عَزَّ بِالأَعداءِ مِن قَبلِ تُبَّعٍ","مَليكٌ تَمَطّى المُلكَ كَهلاً وَأَمرَدا",35,"د",2,0],["وَهَل عَمَلٌ أَغنى عَن المالِ أَو شَفى","حَرارَةَ ظَمآنٍ تَرَيّعُ آلِ",36,"ل",1,0],["وَهَل عَن غُرَيرٍ طاعَنَت وَبِهِ اِحتَوَت","مُناها وَبِالبَحرَينِ جارَ اِحتِكامُها",37,"م",3,0],["وهل عرفت ظلماؤها في سهوبها","أحب إليها من هيامي ومن سهدى",38,"د",2,0],["وهل علمتم لماذا","تعاف نفسي الخلائق",39,"ق",1,0],["وَهَل عَلَّمتَهُم رميَ القَوافي","لِيَرموا بِاليَتيمِ وَليسَ رِفقُ",40,"ق",1,0],["وَهَل عَلِمتُم بِأَنَّ شُكري","عَبدٌ لِإِحسانِكُم رَقيقُ",41,"ق",1,0],["وَهَل عَلى مِثلِ ما أُكابِدُهُ","في الحُبِّ يَبقى لِعاشِقٍ كَبِدُ",42,"د",1,0],["وهل عادى الزّمانُ سِوى عظامٍ","بما فوقَ الثُّريَّا طامِعينا",43,"ن",2,0],["وهل عربيٌّ صادقٌ لا يزورُها","ويَبكي على آثارها البَهجات",44,"ت",1,0],["وَهل عذبات البان رنحها الصبا","فَعانقها ثم اِنثَنى وَهي تَلعَب",45,"ب",1,0],["وَهَل عُطلٌ بِمُلكٍ وَهوَ مِنكَ ال","مُتَوَّجُ وَالمُسَوَّرُ وَالمُخَتَّم",46,"م",1,0],["وَهَل عَلِمت ماذا جنته يَدُ الرَدى","لَقَد فتكت ويلُ اِمِّها أَيَّما فتكِ",47,"ك",1,0],["وَهَل عامِرٌ ربعُ الهوى بسويقَةٍ","فَعَهدي بذاكَ الربع للشَمل جامعُ",48,"ع",1,0],["وَهَل عَن مَقامات الهوى متحوَّلٌ","وَفيها شَتا أَهلُ الغَرام وَقاظوا",49,"ظ",3,0],["وَهَل عائِدٌ فيها الزَمانُ الَّذي مَضى","قَصيراً فَلي حُزنٌ عَلَيهِ يَطولُ",50,"ل",1,0],["وهل عن سديدِ الحَضْرةِ اليومَ مَعْدِلٌ","لِمُلتَمِسِ الإحسانِ منا أو العَدْل",51,"ل",1,0],["وهل عن سديدِ الدولةِ القَرمِ مَعدِلٌ","إذا شامَتِ النُجْحَ الوشيكَ المَطالِب",52,"ب",1,0],["وهل علمتم بأن اللّه سائلكم","عما قريب وللأعمال ديان",53,"ن",1,0],["وهل علمت براقة الثغر أنني","أسير النوى والصبر ليس بمنقضِ",54,"ض",1,0],["وهل علمت سحارة الجفن إنني","أسير هواها والفؤاد رهينها",55,"ن",3,0],["وهل عاينت عيناك قلبا هيامه","يحن لفقد الألف وجدا إذا وعى",56,"ع",2,0],["وهل عائقٌ عنها وكلّ سَنِيَّةٍ","إليك تَسَامى أَوْ إليكَ تَؤولُ",57,"ل",1,0],["وهل عاش نصف بعد علم علمته","وإن عاش هل عيش على عقبه يصفو",58,"ف",2,0],["وهل عاقل مرتاد للذنب مثل ما","يرود دليل الحي مذ هطل المزن",59,"ن",1,0],["وهل عِوضٌ في أن تتِمَّ تشبُّهاً","بهنَّ بدورٌ أو تميدَ غصونُ",60,"ن",1,0],["وهل عن زعيم الملك في الناس عائضٌ","إذا كشَفَتْ مخبوءةٌ عن خِدامِها",61,"م",3,0],["وهل عائدٌ بحياة القتي","ل أن يستقاد به القاتلُ",62,"ل",1,0],["وهل على ماء النخيلِ مطعنٌ","إذا وردتَ مثلِثاً أو مخمِسا",63,"س",2,0],["وهل عَدَتني شيبةٌ في الحشا","إذ مَفرِقي أَسودُ غِربيبُ",64,"ب",1,0],["وهل عنده خبرٌ إن سأل","تُ ما البانتان وما زينبُ",65,"ب",1,0],["وهل عَهدُ اللِّوى بَزرودَ يُطفي","أُوامَك إنه عهدٌ قريبُ",66,"ب",1,0],["وهل عنده أني خطيب لمجده","وأني على عليائه غير معتد",67,"د",1,0],["وهل علم يزين لنا عقولا","كدر لا يزين غير جيد",68,"د",1,0],["وهل عرفت مصرُ ما نابها","وهل شعرت بالمصاب الجلل",69,"ل",1,0],["وهل عزاء المعنى ال","مشوق إِلا الصبوح",70,"ح",1,0],["وهل علمت أنها عاودت","عصور المغولية الخاليه",71,"ي",2,0],["وهل علم الوادي بما تصنعونه","وما يثبت الجبّار منه وما يمحو",72,"ح",2,0],["وهل علم القبر الكريم بما جرى","فقد بات مهتز الجوانب سائلا",73,"ل",2,0],["وهل عَجَبٌ تَقطُّعُ قلبِ صَبٍّ","رَمَتْهُ يدُ الليالي بانقطاع",74,"ع",1,0],["وهل علمت بأني اليوم ذو كبد","حرى ودمع على الخدين مطرد",75,"د",1,0],["وهل عرَّجت هُوج المطي بسحرة","طلاحاً على الموماة والقومُ نوَّم",76,"م",1,0],["وهل عند عثمان سوى الحتف ملجأ","وإن غرَّه ربعٌ مشيد ومَعلم",76,"م",1,0],["وهل عذب الثنا في غير فرد","تعالي عن نظير أو قرين",77,"ن",1,0],["وَهَل عِندَهُ شَوقٌ كَشَوقِي وَهَل بِهِ","غَرامٌ مُجِدٌّ أَم غَرامٌ مُمَازِحُ",78,"ح",1,0],["وهل علم الناس إذ شيعوك","بأن شيعوا الجود والمفخرا",79,"ر",2,0],["وهل على الريح من ضيم إذا بعثت","للمقفر الجدب أو للروض بالمزن",80,"ن",1,0],["وَهَل عَرَّسوا في دَيرِ عَبدونَ أَم سَرَوا","يَؤُمُّ بِهِم رُهبانُهُم دَيرَ نَجرانِ",81,"ن",1,0],["وَهَل عِندَهُم مِن لَوعَةٍ وَصَبابَةٍ","كَما عِندَنا وَالحُبُّ يشقي بِهِ الحِبُّ",82,"ب",1,0],["وَهَل عَلِمت بِنتُ المَناوِلِ أَنَّني","بِأُخرى سِواها لا أهيمُ وَلا أَصبو",82,"ب",2,0],["وهل عطفة منكم افوز بها غدا","ويحصل لي كل الذي رمت من خير",83,"ر",1,0],["وهل علي ملام","ان اسكرتني زبيبه",84,"ه",1,0],["وَهَل عِندَ صَفوان بِن إِدريس أَنَّني","مُقيمٌ عَلى عَهدِ المَوّدَةِ ماكِثُ",85,"ث",1,0],["وهل عندكم حفظ لعهد مُتيّمٍ","حليفاه منكم لوعةٌ ونحيبُ",86,"ب",1,0],["وهل علموا أني سليب غزالهم","غداة بدا لي بين بانات عنان",87,"ن",1,0],["وَهَلْ عِنْدَهَا عِلْمٌ بِأَعْلاَمِ حَاجِرٍ","وَمَا هِجْنَ لِي مِنْ لاَعَجِ الشَّوْقِ وَالْوَجْدِ",88,"د",1,0],["وهل عاش أهل الإخاء بحبٍّ","فما من لئيمٍ ولا من غدور",89,"ر",1,0],["وهل عرفتني ربما بِتُّ مغرماً","تدافعه أكفالها والحوارك",90,"ك",1,0],["وهل على من سبب التغريما","وأوجب الفرقة والتحريما",91,"م",2,0],["وهل عجبوا ان قد أسا الركب عنهم","وبين الحنايا أحكموا لهم كنا",92,"ن",2,0],["وهل علمت بطحاء مكة من منى","بان خر في الآداب أعلى عمادها",93,"د",3,0],["وَهَل عُدَّ في آبائِكُم وَجُدودِكُم","خَليفَةُ عَدلٍ أَو إِمامٌ مُوَفَّقُ",94,"ق",1,0],["وهل علمت دَلَّه","على دمي مَنْ دَلَّه",95,"ل",2,0],["وهل عذبان البان صوحن بعدها","لعظم الأسى أم هن لدنَّ نواظرُ",96,"ر",1,0],["وَهَل عِندَكُم غَيرَ أَنِّي أَهيمُ","بِشَكوى الصَّبابَةِ في كُلِّ فَن",97,"ن",1,0],["وَهَل عَلِمَ البَرقُ اليَمانيُّ أَنَّنا","طَرَفنا بِهِ طَرفاً مِنَ اللَّيلِ أَكحَلا",98,"ل",2,0],["وَهَل عَلى البَطَلِ الحامي حَقيقَتَهُ عارٌ","إِذا جَبَنَ الأَعداءُ أَو غَدَروا",99,"ر",3,0],["وَهَل عَلِمَت بَنو حزنِ بنِ عَمرٍو","إِباي عَلى مُشاوَرَةِ الخُطوبِ",100,"ب",1,0],["وهل عيشنا تشكيل أحرف سطرنا","فهذا له نصب وذاك له جر",101,"ر",1,0],["وهل عندها علمٌ بضعف تحمُّليِ","عشية زُمّتْ للوداع جِمالي",102,"ل",2,0],["وهل عَسى يجمعنا رَمْلُ اللّوى","ونشتفي بالوصل بعد الصَّدِّ",103,"د",1,0],["وَهَل عشقتك الشَمس فَاصفر لَونَها","وَأَضر منها مِنك الجَوى وَالتلهف",104,"ف",1,0],["وَهَل عَهد هَذا الشَباب غَير تَفجّعٍ","بذكر شَباب قَد تَرحَّل بِالعز",105,"ز",1,0],["وهل عز دين قط إِلا بشدة","وضرب وطعن من أكف الصعالك",106,"ك",1,0],["وهل عاش منا في القديم غضنفر","على دينه إلا كميّ مدافع",107,"ع",1,0],["وهل عز دين اللّه إلا بمصدع","رؤوف عطوف يخضب السيف والمدى",108,"د",2,0],["وهل علمتم أن ذا حُفرةٍ","يَخلقُ أو يرزق أو يُمطرُ",109,"ر",1,0],["وهل عزَّتْ على نفسي حياة","أقدّمها على قِصَرِ السنين",110,"ن",1,0],["وهل عادها ما عادني من صبابة","لها بين أحناء الفؤاد حريق",111,"ق",1,0],["وهل عرفوا الحق الصراح وتابعوا","خطاه وهل باد الهوى والتعصب",112,"ب",1,0],["وَهل علِمُوا أنَّنَا بَينَ مَن غَا","صَ فِي لُجَجِ اليمِّ أَو طَائِرِ",113,"ر",1,0],["وهل عرفُوا عامِلَ الكهرباءِ","وما فِيه مِن قُوَّةِ القاهِرِ",113,"ر",1,0],["وهل عودةٌ بالفكر مني إلى الصبا","وعهدِ الهوى والغيدِ من كل هيفاء",114,"ا",2,0],["وهل عوضٌ في مهرجان يقام لي","إذا مت أو نفعٌ بتمثال أحجار",115,"ر",1,0],["وهَلْ عَلِمْتِ بيَننَا للأوَّلَهْ","شُرَبَةً مِنْ غَيْرِنا أو أُكَلَهْ",116,"ل",2,0],["وَهَل عدوك يَقضي ما تسر به","فأَنتَ تعرف كَيد الخصم وَالحَكم",117,"م",1,0],["وهل عندكم ما عند قلبي من الأسى","وهل مثل وجدي للفراق وجدتم",118,"م",1,0],["وَهَل عِندَ جِيرانِ العَقيق بِأَنّنِي","لِفُرقَتِهم ذابَ العَقيقُ بِأَجفاني",119,"ن",2,0],["وَهَل عرت وَسوسة","من بِعفافه اِحتجب",120,"ب",1,0],["وهل عاب لون النرجس الغض عائب","ولون النجوم الزاهرات على البعد",121,"د",1,0],["وَهَل عَجَبٌ أَن تُدرِكَ السَيدَ وِترَها","وَتَصبِرُ لِلحَقِّ السَراةُ الأَكارِمُ",122,"م",1,0],["وهل عرف النّاس ذو نهيةٍ","فأمسى له فيهم مأربُ",123,"ب",1,0],["وَهَل عَيشٌ ألذُّ من الطِّلا إِذ","غَدا ساقي زجاجتِه صَبيّا",124,"ي",2,0],["وهل على الحب يجازيك أم","يريك بالضحك مدى أجره",125,"ر",2,0],["وهل عرفوا للكهرباء مزية","وأن لها شأنا به افتخر العصر",126,"ر",1,0],["وهل عرفوا للراديوم منافعا","وان له قدرا غدا دونه النبر",126,"ر",1,0],["وهل عندكم للعائرين أقالة","فأسمح خلق اللَه من ينفق العفوا",127,"و",2,0],["وهل عذبات البانِ فيها موائسٌ","وزهر الرُّبى هل أبرزته كِمامُ",128,"م",1,0],["وهل على النائي لنا من زورةٍ","نستشرف الديار أو نستافها",129,"ف",3,0],["وهل عرايس ذاك النحل مرسلة","على ترائبها تلك العثاكيل",130,"ل",1,0],["وهل عرف الناس ذو نُهية","فأمسى لهم فيهم مأربُ",131,"ب",1,0],["وهل عسفت الا لعسفان سيرها","فسيان فيه صبحها ومساها",132,"ا",3,0],["وهل عقرب الصدغين في روض خدها","بشوكتها تحمى ورودا به تغطو",133,"ط",2,0],["وهل علمت أني نظمت قلائدا","فما عقدها في الجيد منها وما السمط",133,"ط",1,0],["وهل عجبٌ إذا ما الشاة خافت","إذا ما صودمت من جمع ذيبِ",134,"ب",1,0],["وهل عائداتٍ ليالي الحمى","وشمل الأحبة فيها جميع",135,"ع",1,0],["وَهَل عائِدٌ رَندُ المحصَّبِ بَعدمَا","نأَى السِّربُ عَنهم في نَسيمِ الأصائِلِ",136,"ل",1,0],["وَهل عِندَ أَيّام له غَير فِتنَةٍ","كَفِتنَة دَجّالٍ وَأُخرى فَتُختَشى",137,"ش",2,0],["وهل على من سعى يوما إلى غرض","لوم إذا منحت منه موانعه",138,"ع",2,0],["وهل عنده للعين من مطمح وهل","إليه سواه في الملمات شافع؟",139,"ع",1,0],["وهل عهودي عندكم غَضَّةٌ؟","أم أنا في ظني ذا غَالِطُ",140,"ط",1,0],["وهَل على اللَّيلِ مِن جُناحٍ","لِأَنَّ مِصباحَها رَدِيءُ!",141,"ي",2,0],["وهل عهد به (الكرار) في خي","بر أقصاهمُ عنها يعود",142,"د",1,0],["وهل عهدُ اللوى بزوردَ يطفى","أوامك إنه عهدٌ قريبُ .",143,"ب",1,0],["وهل عشت عصرا كم يحارب ربه","فاسررت ايمان الخفاء به برُ؟",144,"ر",1,0],["وَهَلْ عَقْلَاً بِأَنْ حَقَّاً مُنِحْنَاْ !","وَأَنَّاْ دُوْنَ خَلْقِ اللهِ چينا !",145,"ن",2,0],["وَهل عَاشَ غَيْرَ فُتَاتِ زَمَانٍ","يُلَقِّنُهُ غَطْرَسَاتِ النِّضَالْ؟",146,"ل",1,0],["وَ هَلْ عَزَّ الْعِبَادُ بِغَيْرِ شَرَعٍ","تَلْقَاهُ النَّبِيُّ الْهَاشِمِيُّ؟",147,"م",2,0],["وهل عجب إذا التقيا بقلبٍ","زئير لبوءةٍ والأقحوان؟",148,"ن",1,0],["وَهَلْ عَاشَ فَرْعٌ بِدُونِي وَمَا","أُلاقِي مِنَ الْقَوْمِ إِلاَّ الْجَفَاءْ",149,"ا",2,0],["وهل عشِقَتْ بالطَّوعِ عيني مفاتنا","لأذكُرَ شَهدًا فوقَ ثَغْريَ يَنْصَبُّ",150,"ب",1,0],["وهل عاداك نذل أو سفيه","فما أوسمته ذلا وعارا",151,"ر",2,0],["وَهَلْ عَلَىْ دَرْبِ بَلْدَتِيْ قَمَرٌ","أقَامَ عُمْراً بِلَيْلِ جَبْهَتِهَا",152,"ت",3,0],["وهل عنده أني خطيب لجده","وأني على عليائه غير معتد",153,"د",1,0],["وهلْ على ماءِ النَّخيلِ مطعنٌ","إذا وردتَ مثلثاً أوْ محمسا",154,"س",2,0],["وهل عجزتُ عن التعبير واأسفي","كأنني لم اصغْ للغادةِ الدُررا ! ؟",155,"ر",2,0],["وهل عائق عنها وكل سنية","إليك تسامى أو إليك تئول",156,"ل",1,0]]}