{"poems":[[53,"قل لأقنى يرمي إلى المجد طرفا","https://www.aldiwan.net/poem29971.html","الخفيف"],[53,"ما للبياض والشعر","https://www.aldiwan.net/poem30486.html","مجزوء الرجز"],[63,"سرى والنسيم الرطب بالروض يعبث","https://www.aldiwan.net/poem46206.html","الطويل"],[55,"يقولون لو ألهمت قلبك غيرها","https://www.aldiwan.net/poem26209.html","الطويل"],[77,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[9,"كانت وصاة وحاجات لنا كفف","https://www.aldiwan.net/poem21952.html","البسيط"],[73,"أما في نسيم الريح عرف معرف","https://www.aldiwan.net/poem11914.html","الطويل"],[23,"جمحت بنو جمح لشقوة جدهم","https://www.aldiwan.net/poem21522.html","الكامل"],[64,"جحودي لك تقديس","https://www.aldiwan.net/poem67635.html","الهزج"],[85,"قم إلى الأهرام واخشع واطرح","https://www.aldiwan.net/poem6826.html","الرمل"],[85,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[85,"مضناك جفاه مرقده","https://www.aldiwan.net/poem63667.html","المتدارك"],[45,"أجز من غلة الصدر العميد","https://www.aldiwan.net/poem62751.html","الوافر"],[45,"تبا للحمك أيها اللحام","https://www.aldiwan.net/poem66642.html","البسيط"],[45,"توهم ليلى وأظعانها","https://www.aldiwan.net/poem66665.html","البسيط"],[80,"للأقاحي بفيك نور ونور","https://www.aldiwan.net/poem31434.html","الخفيف"],[44,"بنفسي حبيب سوف يثكلني نفسي","https://www.aldiwan.net/poem30234.html","الطويل"],[44,"دمن ألم بها فقال سلام","https://www.aldiwan.net/poem30368.html","الكامل"],[44,"على مثلها من أربع وملاعب","https://www.aldiwan.net/poem30579.html","الطويل"],[90,"أعيذك أن يعاصيك القصيد","https://www.aldiwan.net/poem60159.html","عموديه"],[105,"ما للسحاب تدفقت أخلافه","https://www.aldiwan.net/poem43119.html","الكامل"],[105,"ما للسيوف أما تثوب فتعطف","https://www.aldiwan.net/poem44198.html","الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[67,"وافاك بالذنب العظيم المذنب","https://www.aldiwan.net/poem18038.html","الكامل"]],"verses":[["جَحَدَ الحاسِدونَ مِنها الضَرورا","تِ وَأَخفَوا دَرارِياً لَيسَ تُخفى",0,"ف",2,0],["جَحافِلاً كَالسَيلِ أَب","قى غُمَراً بَعدَ غُمَر",1,"ر",1,0],["جَحاجِحَةٌ بِيضُ الوُجوهِ أكُفُّهُمْ","سِباطٌ مَتى تُستَمطَرِ الرِّفْدَ يُقعِثوا",2,"ث",3,0],["جَحَدتُ الهَوى حَتّى إِذا كَشَفَ الهَوى","غِطاءَ جُحودي وَاِستَنارَت حَقائِقُه",3,"ق",2,0],["جَحَاجِحَةٌ غُرُّ الْوَجُوهِ كَأَنَّمَا","عَمَائِمُهُم فِيهَا مَعَاقِدُ تِيجَانِ",4,"ن",1,0],["جَحاجِحٌ وَبَنو مُلكٍ غَطارِفَةٌ","مِنَ الأَعاجِمِ في آذانِها النُطَفُ",5,"ف",1,0],["جَحيمٌ لِعاصيهِ يُشَبُّ وَقوضُهُ","وَجَنَّةُ عَدنٍ لِلمُطيعينَ تُزلَفُ",6,"ف",1,0],["جَحَدوا القُرانَ وَكَذَّبوا بِمُحَمَّدٍ","وَاللَهُ يُظهِرُ أَمرَ كُلِّ رَسولِ",7,"ل",1,0],["جُحودي لَكَ تَقديسُ","وَظَنّي فيكَ تَهويسُ",8,"س",1,1],["جحدوا السيف وردّوا حكمه","عُزَّلا إلا من الحق المبين",9,"ن",1,0],["جَحَدتُها وَكَتَمتُ السَهمَ في كَبِدي","جُرحُ الأَحِبَّةِ عِندي غَيرُ ذي أَلَمِ",10,"م",1,0],["جَحَدَت عَيناكَ زَكِيَّ دَمي","أَكَذلِكَ خَدُّكَ يَجحَدُهُ",11,"د",2,0],["جَحَدنا سُهمَةَ الحَدَثانِ فينا","لَوَ أَنَّ الحَقَّ يَبطُلُ بِالجُحودِ",12,"د",1,0],["جَحَدَت نَصيبونَ الإِخاءِ وَأَنكَرَت","مِن حَقِّنا ما يَعرِفُ الأَقوامُ",13,"م",1,0],["جَحَدنَ جَديدَ الهَوى بَعدَما","عَرَفنَ الصَبابَةَ عِرفانَها",14,"ن",3,0],["جَحفَلٌ صُبْحُهُ منَ النقعِ لَيْلٌ","يضْحَكُ الموتُ فيه وهو بَسُورُ",15,"ر",1,0],["جَحَدتُ الهَوى إِن كُنتُ مُذ جَعَلَ الهَوى","مَحاسِنَهُ شَمسي نَظَرتُ إِلى الشَمسِ",16,"س",1,0],["جَحَدَتكَ مِنهُم أَلسُنُ لَجلاجَةٌ","أَقرَرنَ أَنَّكَ في القُلوبِ إِمامُ",17,"م",1,0],["جَحافِلُ لا يَترُكنَ ذا جَبَرِيَّةٍ","سَليماً وَلا يَحرُبنَ مَن لَم يُحارِبِ",18,"ب",1,0],["جحاجيحٌ وكم عمُرت عصورٌ","بما شقيتْ جحاجيحٌ وصِيد",19,"د",1,0],["جَحَدوا الإِلَهَ وَكَذَّبوا بِوَعيدِهِ","حَتّى رَمى بِعُروشِهِم فَتَنَسَّكوا",20,"ك",3,0],["جَحَدَ الحديثَ وراح يَحلفُ ما جرى","صَدَقَ المُنَبِّئُ وافترى من يحلف",21,"ف",1,0],["جَحَدُوا المصطفى وآمن بالطا","غُوتِ قومٌ همْ عندهمْ شُرَفاءُ",22,"ا",2,0],["جَحَدُوا النبيَّ وقد أتاهم بالهُدَى","لَولا القضاءُ سألتَهُمْ ما المُوجِبُ",23,"ب",1,0]]}