173771",""],[4929,"نقل مباشر","https://www.poetsgate.com/ViewPoem.aspx?id=200157",""],[4987,"دليل المحبه","https://www.poetsgate.com/ViewPoem.aspx?id=49562",""],[585,"عبست لك الدنيا وحال ودادها","https://www.poetsgate.com/ViewPoem.aspx?id=161922",""],[5186,"جحدوا فضل بني العرب جحودا","https://www.poetsgate.com/ViewPoem.aspx?id=156479",""],[5219,"تبدى ملاكا","https://www.poetsgate.com/ViewPoem.aspx?id=194165",""],[5327,"جُحُورٌ أخْرَجَتْ بَعدَ المَخَاضِ","https://www.poetsgate.com/ViewPoem.aspx?id=140764",""],[5370,"من الصغر حبه","https://www.poetsgate.com/ViewPoem.aspx?id=87429",""],[5409,"لم ينل من علاك كل أثيم","https://www.poetsgate.com/ViewPoem.aspx?id=155489",""],[5411,"لا فرْقَ عِنْدي","https://www.poetsgate.com/ViewPoem.aspx?id=185633",""],[5411,"القَصيدةُ المحَمدية","https://www.poetsgate.com/ViewPoem.aspx?id=186387",""],[5464,"فضح الهوى سري","https://www.poetsgate.com/ViewPoem.aspx?id=698",""],[5582,"ما لِلْحَمائِمِ لا يَنْفَكُّ نائِحُها","https://www.poetsgate.com/ViewPoem.aspx?id=186834",""],[5650,"عَائِشَة... وَحْيُ الْقَصِيد!","https://www.poetsgate.com/ViewPoem.aspx?id=131223",""],[5725,"سرّ منْ رأى","https://www.poetsgate.com/ViewPoem.aspx?id=177530",""],[5853,"لو انه يدري","https://www.poetsgate.com/ViewPoem.aspx?id=175709",""],[1920,"هروب بنكهة العودة","https://www.poetsgate.com/ViewPoem.aspx?id=191401",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[5956,"العين بالعين..‏","https://www.poetsgate.com/ViewPoem.aspx?id=183739",""],[5956,"بالتجاوب لن أعابا","https://www.poetsgate.com/ViewPoem.aspx?id=192424",""],[5956,"نلملمُ أشلاءنا","https://www.poetsgate.com/ViewPoem.aspx?id=192808",""],[5956,"وُلِدْنا في سُجون العمر","https://www.poetsgate.com/ViewPoem.aspx?id=193566",""],[6035,"بغداد .. كَبْوُك أنْهَكَنا !","https://www.poetsgate.com/ViewPoem.aspx?id=175397",""],[6290,"فَأَيّامُنَا تَغْدُو جَمِيعًا نُفَمْبَرًا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85153&r=&rc=18",""],[6300,"حياتي كذبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82859&r=&rc=30",""],[5164,"أنت الطريق..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75657&r=&rc=11",""],[6327,"لامية الهمج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86571&r=&rc=6",""],[5190,"عودة بلفور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78348&r=&rc=61",""]],"verses":[["جَحَدَ الحاسِدونَ مِنها الضَرورا","تِ وَأَخفَوا دَرارِياً لَيسَ تُخفى",0,"ف",2,0],["جَحافِلاً كَالسَيلِ أَب","قى غُمَراً بَعدَ غُمَر",1,"ر",1,0],["جَحاجِحَةٌ بِيضُ الوُجوهِ أكُفُّهُمْ","سِباطٌ مَتى تُستَمطَرِ الرِّفْدَ يُقعِثوا",2,"ث",3,0],["جَحَدتُ الهَوى حَتّى إِذا كَشَفَ الهَوى","غِطاءَ جُحودي وَاِستَنارَت حَقائِقُه",3,"ق",2,0],["جَحَاجِحَةٌ غُرُّ الْوَجُوهِ كَأَنَّمَا","عَمَائِمُهُم فِيهَا مَعَاقِدُ تِيجَانِ",4,"ن",1,0],["جَحاجِحٌ وَبَنو مُلكٍ غَطارِفَةٌ","مِنَ الأَعاجِمِ في آذانِها النُطَفُ",5,"ف",1,0],["جَحيمٌ لِعاصيهِ يُشَبُّ وَقوضُهُ","وَجَنَّةُ عَدنٍ لِلمُطيعينَ تُزلَفُ",6,"ف",1,0],["جَحَدوا القُرانَ وَكَذَّبوا بِمُحَمَّدٍ","وَاللَهُ يُظهِرُ أَمرَ كُلِّ رَسولِ",7,"ل",1,0],["جُحودي لَكَ تَقديسُ","وَظَنّي فيكَ تَهويسُ",8,"س",1,1],["جحدوا السيف وردّوا حكمه","عُزَّلا إلا من الحق المبين",9,"ن",1,0],["جَحَدتُها وَكَتَمتُ السَهمَ في كَبِدي","جُرحُ الأَحِبَّةِ عِندي غَيرُ ذي أَلَمِ",10,"م",1,0],["جَحَدَت عَيناكَ زَكِيَّ دَمي","أَكَذلِكَ خَدُّكَ يَجحَدُهُ",11,"د",2,0],["جَحَدنا سُهمَةَ الحَدَثانِ فينا","لَوَ أَنَّ الحَقَّ يَبطُلُ بِالجُحودِ",12,"د",1,0],["جَحَدَت نَصيبونَ الإِخاءِ وَأَنكَرَت","مِن حَقِّنا ما يَعرِفُ الأَقوامُ",13,"م",1,0],["جَحَدنَ جَديدَ الهَوى بَعدَما","عَرَفنَ الصَبابَةَ عِرفانَها",14,"ن",3,0],["جَحفَلٌ صُبْحُهُ منَ النقعِ لَيْلٌ","يضْحَكُ الموتُ فيه وهو بَسُورُ",15,"ر",1,0],["جَحَدتُ الهَوى إِن كُنتُ مُذ جَعَلَ الهَوى","مَحاسِنَهُ شَمسي نَظَرتُ إِلى الشَمسِ",16,"س",1,0],["جَحَدَتكَ مِنهُم أَلسُنُ لَجلاجَةٌ","أَقرَرنَ أَنَّكَ في القُلوبِ إِمامُ",17,"م",1,0],["جَحافِلُ لا يَترُكنَ ذا جَبَرِيَّةٍ","سَليماً وَلا يَحرُبنَ مَن لَم يُحارِبِ",18,"ب",1,0],["جحاجيحٌ وكم عمُرت عصورٌ","بما شقيتْ جحاجيحٌ وصِيد",19,"د",1,0],["جَحَدوا الإِلَهَ وَكَذَّبوا بِوَعيدِهِ","حَتّى رَمى بِعُروشِهِم فَتَنَسَّكوا",20,"ك",3,0],["جَحَدَ الحديثَ وراح يَحلفُ ما جرى","صَدَقَ المُنَبِّئُ وافترى من يحلف",21,"ف",1,0],["جَحَدُوا المصطفى وآمن بالطا","غُوتِ قومٌ همْ عندهمْ شُرَفاءُ",22,"ا",2,0],["جَحَدُوا النبيَّ وقد أتاهم بالهُدَى","لَولا القضاءُ سألتَهُمْ ما المُوجِبُ",23,"ب",1,0],["جحدوا فضله ولا لوم عندي","إنّ فضل الرئيس ضلّ الطريقا",24,"ق",2,0],["جحيم من الأمواه يغلي عبابه","ويعوي عواء الذئب بين المخارم",25,"م",1,0],["جحشك يا هبر كعهدي به","ما زال لكن بدلوا البردعه",26,"ع",2,0],["جَحافِلٌ قَيَّضَ اللَهُ البَوارَ لَها","مَن نَكَّبَ الحَقَّ في أَحكامِهِ نُكِبا",27,"ب",2,0],["جَحَدوكَ ما أَولَيتَهُم وَمُعَرِّضٌ","لِلهَونِ مَن لَم يَحمَدِ الإِكراما",28,"م",2,0],["جَحَدتُ الهَوى حَتَّى تَبدَّت شُهودُهُ","فصَرَّحتُ بالكِتمَانِ والحَقُّ أبلَجُ",29,"ج",1,1],["جُحِد الكمالُ من الوجود فمُذْ بَدا","للناسِ فضُلك أُنْكِر الإنكار",30,"ر",1,0],["جحدتُ الهوى إذ كنتُ مذ جعل الهوى","محاسنَه شمساً نظرتُ الى الشمسِ",31,"س",1,0],["جَحد العاتي فَلَمّا","يُبقِ لي فيها كَرامَه",32,"م",2,0],["جحدتْ قتلي وقالت كيف لي","قتلُ إنسانٍ ومالي من حُسامْ",33,"م",1,1],["جَحَاجِحَةٌ غُرُّ الوجوهِ صِبَاحُهَا","ألا بِأبِي تِلْك الجَحَاجِحَةُ الغُرُّ",34,"ر",1,0],["جَحَدوا الذي سمعوا وقالوا غيرَه","ولو انَّهمْ لا يسمعون تَقَوَّلُوا",35,"ل",3,0],["جَحاجِحُ لا يُعابُ مَنِ اسْتَباحَتْ","صُدُورُ رِماحِهِمْ يَوْمَ الْهِياجِ",36,"ج",1,0],["جَحَدَت دَمي ظُلماً وَلَ","كِن ناظِراها ناظَراها",37,"ا",3,0],["جَحافِلهُ أسدٌ تزَأَّرُ في الوَغى","وَما غيلها إِلا القَنا وَالقَنابِلُ",38,"ل",1,0],["جحفلٌ يركبُ منها جحفلاً","يتعادى كجنودٍ زاحفين",39,"ن",1,0],["جَحَدوا يَدي البَيضاءَ إِذ وافى بِها الد","اعي لِأَنَّهُمُ السَوادُ الأَسوَدُ",40,"د",1,0],["جُحرٌ بِهِ عِندَ جَحرِهِ بَعَرٌ","عَرَفتُهُ تَحتَ ذَقنِهِ كَبَبُ",41,"ب",1,0],["جَحَدتُم مُوالاةَ مَولاكُمُ","ويومَ الغَديرِ بِها مُؤمِنونا",42,"ن",2,0],["جحد المعلم بغتةً","وارتد في وعيٍ ينوحه",43,"ح",2,0],["جحاجحةٌ شمُّ العرانين هُتَّفٌ","بكلّ بعيد الغور ملتهب الزّند",44,"د",1,0],["جحدت أعينُه سفك دمي","وعليه حدّه في الوجه يشهد",45,"د",1,0],["جحَدْتُ الهوي عند العواذلِ ضِنّةً","عليهمْ بمن أصبو إليهِ وأهواهُ",46,"ه",1,1],["جحدت الهوى خوف الوشاة فأعربت","دموعي بما ألقى ولم ينفع الجحد",47,"د",1,0],["جحدت عوارَفهُ وليس لمثله","مهما أُسئ سوى الوفاءِ لناسِه",48,"س",2,0],["جحدت بها وجدي ودمعيَ","والسقم المضاعف شاهداً عدل",49,"ل",1,0],["جحد الهوى ورأوه يختصمُ النَّوى","فقضى عليه والدموع شهوده",50,"د",2,0],["جحدت فضل الجدود","يا أيها المتفرنس",51,"س",1,0],["جَحفَلٌ أَورَقَ فيهِ هَبوَةٌ","وَنُجومٌ تَتَلَظّى وَشَرارُ",52,"ر",1,0],["جحدته البابٌ طمتها ضلَّةٌ","وأولوا الضلالةِ للكمالِ جواحد",53,"د",1,0],["جَحْجاحُ طائِفَةِ الرِّجالِ إمامُهُمْ","سبَّارُ غايَتِهِمْ بكلِّ مَكَانِ",54,"ن",1,0],["جَحاجِحٌ من أسودِ اللهِ طائِفَةٌ","لهُمْ بتَرْجيحِهِمْ في القَوْمِ ميزَانُ",55,"ن",1,0],["جَحاجِحُ السَّادةِ الأقطابِ غايَتُهُمْ","لها لدى بَدئِهِ في السَّيرِ إِبْداءُ",56,"ا",2,0],["جحفلٌ يقتلُ الجنينَ إذا ما","سارَ في الأرض وقعُهُ في النُحورِ",57,"ر",1,0],["جحدَتْ جُفونُكم دَمي وخُدودُكم","فيهنّ منهُ شُبهةٌ لا تُدفَعُ",58,"ع",1,0],["جَحَدوا الحبَّ وَلَكِنْ","كَتَموهُ ثمّ باحوا",59,"ح",3,0],["جَحدتُ الهَوى لَمّا سُئِلتُ عَنِ الهَوى","وَكَمْ غِرّةٍ مِن ذي شَجىً في المباعثِ",60,"ث",1,0],["جَحرِ بَحيرِ أَو أَخي بَحيرِ","إِلى أَراطٍ وَنَقاً تَيهورِ",61,"ر",1,0],["جحد الحقائق عاصيا متبوعه","ولذاك حاق به القضاء المبرم",62,"م",1,0],["جَحافِلَ في سَيفِ البِحارِ تَخالُها","مِنَ الذُعرِ وَرقاً عُكَّفاً في وَكونِها",63,"ن",3,0],["جحدت أباك نسبته","وترجو أنْ تفيد أبا",64,"ب",2,0],["جحد الفؤاد فما أفاد جحوده","وأقر دمعي بالذي أنا جاحد",65,"د",1,0],["جَحدوا ما قاله في صِنوه","يوم خُمِّ بين دَوْحٍ مُنتظِمْ",66,"م",1,0],["جحاجح هم شبول حول غابته","وحول هالته هم أنجم زهر",67,"ر",1,0],["جحدت الفُروض وَأَنكَرتَها","وَخالَفت ما سنه أَحمَد",68,"د",1,0],["جَحشَين قَد رَأَيتُ في زَماني","عَلى الأَنام يَتفاخران",69,"ن",1,0],["جُحَّ في بيتك تغْنمْ إنني","معدِم والفقر مِنْ ذل الرجالْ",70,"ل",1,1],["جَحاجِح سادَةٍ بُلجٍ مَرازِبَةٍ","جُردٍ عِتاقٍ مَساميخٍ مَطاعيمِ",71,"م",1,0],["جَحَدْتُ هَوَاهَا خِيفَةً مِنْ صُدُودِهَا","وَمَاذاَ عَسَى يُغْنِي مُتَيَّمَهَا الجَحْدُ",72,"د",1,0],["جحدت إذن موالاتي علياً","وقلت بأنني مولى زيادِ",73,"د",1,0],["جحدت ولاء مولانا علي","وقدمت الدعي على الوصِّي",74,"ي",1,1],["جَحَدتَ أَباكَ نِسبَتَهُ","وَأَرجو أَن تُفيدَ أَبا",75,"ب",2,0],["جحدوا جلال الناصريّ وانه","من انعم الله التي لا تجحد",76,"د",1,0],["جحدت قُريشٌ شَرعَهُ لِعنادِها","كُفراً واصل الكُفر محض عِناد",77,"د",1,0],["جَحَاجِحَةٌ قَادَةٌ ذَادَةٌ","حُرُوبُهُمُ لَقِحَتْ عَنْ حُبَالِ",78,"ل",1,0],["جَحيمٌ مِنَ الأَهوالِ زُجَّ بِهِ الوَرى","فَمَن لَم يَنَلهُ السَيفُ أَودى بِهِ اللَغمُ",79,"م",1,0],["جحدتم مجاري فيضها عن ضلالة","وهل يجحد النعماء إلا كفورها",80,"ر",3,0],["جَحَظَت فَنامَت عَينُ كُلِّ مُفَرِّطٍ","مُتَجَحمِظٍ بِهَواهُ لا يَتَنَدَّمُ",81,"م",1,0],["جَحاجحةٌ ما الدهرُ ما يَرتُقُونَهُ","بفاتقِ أو ما يفتقونَ براتقِ",82,"ق",1,0],["جحاجحَةٌ شمُّ الأنوفِ لجارهمْ","وإِنْ لم يكنْ إِلّاهُمُ الآلُ والرهْطُ",83,"ط",1,0],["جَحافِلُ سَهَّلنَ الرَوابي فَأَصبَحَت","سَباسِبَ مِمّا بَعثَرَتها كَتائِبُه",84,"ب",2,0],["جَحاجِحَةٌ غُرُّ الوُجوهِ تَآزَروا","بِآراءِ صِدقٍ زانَهُنَّ عُقولُ",85,"ل",1,0],["جَحافِلُ يَغشى الطَيرَ في الجَوِّ نَقعُها","وَيُزعِجنَ وَحشَ الأَرضِ مِن كُلِّ مَجثَمِ",86,"م",1,0],["جَحافِلُ يَترُكنَ الرَوابي سَباسِباً","يَسوقُ الرَعيلَ المُسبَطِرَّ رَعيلُ",87,"ل",1,0],["جَحافِلُ فيها مِن سُلالَةِ ناهِسٍ","أُسودٌ على أَعدا الشَريعَةِ حُنَّقُ",88,"ق",1,0],["جحدتك ما أمسكت من أرماقها","فسطاك يدعوها إلى أرماسها",89,"س",3,0],["جحدوا الشمس على اشراقها","ولكم يشهد ايلاف الخيام",90,"م",1,0],["جحاجح مهما يطرق الجمع ذكرهم","يذل له هام المجرة مطرقا",91,"ق",2,0],["جحيمهم أنا وهمُ جحيمي","فجنّبنا جحيم معاشرات",92,"ت",1,0],["جحدوك لمّا أن رأوك ذخيرة","إنّ الذّخائر شأنُها أن تُجحدا",93,"د",2,0],["جحدتني لامٌ جحدت هواها","من عذاريه فهي لامُ الجحود",94,"د",1,0],["جحشٌ إذا ما همَّ يعلو على","أكتافه تفزع للغاشيه",95,"ي",2,0],["جحيمٌ لم يكن فيها نعيمي","وجنات يكون بها جحيمي",96,"م",2,0],["جحدوا عقوداً قد نظمتُ جمانها","من غير برهان مع الإنكار",97,"ر",1,0],["جَحافِل العَزم منه أَجلت","قَساط