{"poems":[[53,"قل لأقنى يرمي إلى المجد طرفا","https://www.aldiwan.net/poem29971.html","الخفيف"],[53,"ما للبياض والشعر","https://www.aldiwan.net/poem30486.html","مجزوء الرجز"],[63,"سرى والنسيم الرطب بالروض يعبث","https://www.aldiwan.net/poem46206.html","الطويل"],[55,"يقولون لو ألهمت قلبك غيرها","https://www.aldiwan.net/poem26209.html","الطويل"],[77,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[9,"كانت وصاة وحاجات لنا كفف","https://www.aldiwan.net/poem21952.html","البسيط"],[73,"أما في نسيم الريح عرف معرف","https://www.aldiwan.net/poem11914.html","الطويل"],[23,"جمحت بنو جمح لشقوة جدهم","https://www.aldiwan.net/poem21522.html","الكامل"],[64,"جحودي لك تقديس","https://www.aldiwan.net/poem67635.html","الهزج"],[85,"قم إلى الأهرام واخشع واطرح","https://www.aldiwan.net/poem6826.html","الرمل"],[85,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[85,"مضناك جفاه مرقده","https://www.aldiwan.net/poem63667.html","المتدارك"],[45,"أجز من غلة الصدر العميد","https://www.aldiwan.net/poem62751.html","الوافر"],[45,"تبا للحمك أيها اللحام","https://www.aldiwan.net/poem66642.html","البسيط"],[45,"توهم ليلى وأظعانها","https://www.aldiwan.net/poem66665.html","البسيط"],[80,"للأقاحي بفيك نور ونور","https://www.aldiwan.net/poem31434.html","الخفيف"],[44,"بنفسي حبيب سوف يثكلني نفسي","https://www.aldiwan.net/poem30234.html","الطويل"],[44,"دمن ألم بها فقال سلام","https://www.aldiwan.net/poem30368.html","الكامل"],[44,"على مثلها من أربع وملاعب","https://www.aldiwan.net/poem30579.html","الطويل"],[90,"أعيذك أن يعاصيك القصيد","https://www.aldiwan.net/poem60159.html","عموديه"],[105,"ما للسحاب تدفقت أخلافه","https://www.aldiwan.net/poem43119.html","الكامل"],[105,"ما للسيوف أما تثوب فتعطف","https://www.aldiwan.net/poem44198.html","الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[67,"وافاك بالذنب العظيم المذنب","https://www.aldiwan.net/poem18038.html","الكامل"],[118,"بنات الدجى هذا الذي لم يزل له","https://www.aldiwan.net/poem49321.html","الطويل"],[122,"كوخي لقد حال إلى صومعه","https://www.aldiwan.net/poem23741.html","السريع"],[141,"بك اقتضى الدين دينا كان قد وجبا","https://www.aldiwan.net/poem11722.html","البسيط"],[141,"خير الأنام لشرهم إحكاما","https://www.aldiwan.net/poem11817.html","الكامل"],[148,"جحدت الهوى حتى تبدت شهوده","https://www.aldiwan.net/poem68572.html","الطويل"],[183,"عبقت بطيب ثنائك الأقطار","https://www.aldiwan.net/poem14538.html","الكامل"],[202,"بنفسي حبيب سوف يثكلني نفسي","https://www.aldiwan.net/poem53118.html","الطويل"],[221,"هذه الدنيا سآمه","https://www.aldiwan.net/poem41925.html","مجزوء الرمل"],[227,"جحدت قتلي وقالت كيف لي","https://www.aldiwan.net/poem50787.html","الرمل"],[273,"تهاب السيوف البيض والأسل السمر","https://www.aldiwan.net/poem25549.html","الطويل"],[277,"ما لي على السلوان عنك معول","https://www.aldiwan.net/poem2646.html","الكامل"],[278,"متى أنا طاعن قلب الفجاج","https://www.aldiwan.net/poem60722.html","الوافر"],[280,"بالله ربكما سلاها","https://www.aldiwan.net/poem32308.html","مجزوء الكامل"],[280,"لأجفانك المرضى الصحاح القواتل","https://www.aldiwan.net/poem32674.html","الطويل"],[296,"ما له في عظم الشأن قري","https://www.aldiwan.net/poem36860.html","عموديه"],[347,"لمغيب قلبي في هواكم مشهد","https://www.aldiwan.net/poem15644.html","الكامل"],[364,"برذوننا اليوم ما به عجب","https://www.aldiwan.net/poem17361.html","المنسرح"],[369,"عيون منعن الرقاد العيونا","https://www.aldiwan.net/poem57058.html","المتقارب"],[374,"من لي بقلب أستميحه","https://www.aldiwan.net/poem66886.html","مجزوء الكامل"],[413,"لمن أينق يا سعد ترقل أو تخدي","https://www.aldiwan.net/poem53991.html","الطويل"],[413,"جدد اللذة حتى نتجدد","https://www.aldiwan.net/poem54102.html","الرمل"],[429,"وجحدت الهوي عند العواذل ضنة","https://www.aldiwan.net/poem12803.html","الطويل"],[434,"لهم حب قلبي إن تدانوا وإن صدوا","https://www.aldiwan.net/poem2622.html","الطويل"],[451,"يا منطق الموتى إليك هدية","https://www.aldiwan.net/poem61701.html","الكامل"],[462,"شهرت علي صوارم العذل","https://www.aldiwan.net/poem3349.html","عموديه"],[462,"أما النسيم فما يغب وروده","https://www.aldiwan.net/poem3545.html","عموديه"],[477,"لست المبدل جنسي","https://www.aldiwan.net/poem37608.html","المجتث"],[488,"إن ترى رأسي فيه قزعٌ","https://www.aldiwan.net/poem655.html",""],[498,"كثر الصنوف وأنت أنت الواحد","https://www.aldiwan.net/poem37565.html","الكامل"],[498,"للقلب في سبك الحروف معان","https://www.aldiwan.net/poem37757.html","الكامل"],[498,"للروح من روح ريح الحب ريحان","https://www.aldiwan.net/poem37759.html","البسيط"],[498,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[512,"بزغت بالظلام شمس الديور","https://www.aldiwan.net/poem20787.html","الخفيف"],[512,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[549,"ليس في العشق جناح","https://www.aldiwan.net/poem47901.html","مجزوء الرمل"],[549,"قفا بي على تلك الطلول الرثائث","https://www.aldiwan.net/poem48019.html","الطويل"],[559,"جاري لا تستنكري عذيري","https://www.aldiwan.net/poem27842.html","الرجز"]],"verses":[["جَحَدَ الحاسِدونَ مِنها الضَرورا","تِ وَأَخفَوا دَرارِياً لَيسَ تُخفى",0,"ف",2,0],["جَحافِلاً كَالسَيلِ أَب","قى غُمَراً بَعدَ غُمَر",1,"ر",1,0],["جَحاجِحَةٌ بِيضُ الوُجوهِ أكُفُّهُمْ","سِباطٌ مَتى تُستَمطَرِ الرِّفْدَ يُقعِثوا",2,"ث",3,0],["جَحَدتُ الهَوى حَتّى إِذا كَشَفَ الهَوى","غِطاءَ جُحودي وَاِستَنارَت حَقائِقُه",3,"ق",2,0],["جَحَاجِحَةٌ غُرُّ الْوَجُوهِ كَأَنَّمَا","عَمَائِمُهُم فِيهَا مَعَاقِدُ تِيجَانِ",4,"ن",1,0],["جَحاجِحٌ وَبَنو مُلكٍ غَطارِفَةٌ","مِنَ الأَعاجِمِ في آذانِها النُطَفُ",5,"ف",1,0],["جَحيمٌ لِعاصيهِ يُشَبُّ وَقوضُهُ","وَجَنَّةُ عَدنٍ لِلمُطيعينَ تُزلَفُ",6,"ف",1,0],["جَحَدوا القُرانَ وَكَذَّبوا بِمُحَمَّدٍ","وَاللَهُ يُظهِرُ أَمرَ كُلِّ رَسولِ",7,"ل",1,0],["جُحودي لَكَ تَقديسُ","وَظَنّي فيكَ تَهويسُ",8,"س",1,1],["جحدوا السيف وردّوا حكمه","عُزَّلا إلا من الحق المبين",9,"ن",1,0],["جَحَدتُها وَكَتَمتُ السَهمَ في كَبِدي","جُرحُ الأَحِبَّةِ عِندي غَيرُ ذي أَلَمِ",10,"م",1,0],["جَحَدَت عَيناكَ زَكِيَّ دَمي","أَكَذلِكَ خَدُّكَ يَجحَدُهُ",11,"د",2,0],["جَحَدنا سُهمَةَ الحَدَثانِ فينا","لَوَ أَنَّ الحَقَّ يَبطُلُ بِالجُحودِ",12,"د",1,0],["جَحَدَت نَصيبونَ الإِخاءِ وَأَنكَرَت","مِن حَقِّنا ما يَعرِفُ الأَقوامُ",13,"م",1,0],["جَحَدنَ جَديدَ الهَوى بَعدَما","عَرَفنَ الصَبابَةَ عِرفانَها",14,"ن",3,0],["جَحفَلٌ صُبْحُهُ منَ النقعِ لَيْلٌ","يضْحَكُ الموتُ فيه وهو بَسُورُ",15,"ر",1,0],["جَحَدتُ الهَوى إِن كُنتُ مُذ جَعَلَ الهَوى","مَحاسِنَهُ شَمسي نَظَرتُ إِلى الشَمسِ",16,"س",1,0],["جَحَدَتكَ مِنهُم أَلسُنُ لَجلاجَةٌ","أَقرَرنَ أَنَّكَ في القُلوبِ إِمامُ",17,"م",1,0],["جَحافِلُ لا يَترُكنَ ذا جَبَرِيَّةٍ","سَليماً وَلا يَحرُبنَ مَن لَم يُحارِبِ",18,"ب",1,0],["جحاجيحٌ وكم عمُرت عصورٌ","بما شقيتْ جحاجيحٌ وصِيد",19,"د",1,0],["جَحَدوا الإِلَهَ وَكَذَّبوا بِوَعيدِهِ","حَتّى رَمى بِعُروشِهِم فَتَنَسَّكوا",20,"ك",3,0],["جَحَدَ الحديثَ وراح يَحلفُ ما جرى","صَدَقَ المُنَبِّئُ وافترى من يحلف",21,"ف",1,0],["جَحَدُوا المصطفى وآمن بالطا","غُوتِ قومٌ همْ عندهمْ شُرَفاءُ",22,"ا",2,0],["جَحَدُوا النبيَّ وقد أتاهم بالهُدَى","لَولا القضاءُ سألتَهُمْ ما المُوجِبُ",23,"ب",1,0],["جحيم من الأمواه يغلي عبابه","ويعوي عواء الذئب بين المخارم",24,"م",1,0],["جحشك يا هبر كعهدي به","ما زال لكن بدلوا البردعه",25,"ع",2,0],["جَحافِلٌ قَيَّضَ اللَهُ البَوارَ لَها","مَن نَكَّبَ الحَقَّ في أَحكامِهِ نُكِبا",26,"ب",2,0],["جَحَدوكَ ما أَولَيتَهُم وَمُعَرِّضٌ","لِلهَونِ مَن لَم يَحمَدِ الإِكراما",27,"م",2,0],["جَحَدتُ الهَوى حَتَّى تَبدَّت شُهودُهُ","فصَرَّحتُ بالكِتمَانِ والحَقُّ أبلَجُ",28,"ج",1,1],["جُحِد الكمالُ من الوجود فمُذْ بَدا","للناسِ فضُلك أُنْكِر الإنكار",29,"ر",1,0],["جحدتُ الهوى إذ كنتُ مذ جعل الهوى","محاسنَه شمساً نظرتُ الى الشمسِ",30,"س",1,0],["جَحد العاتي فَلَمّا","يُبقِ لي فيها كَرامَه",31,"م",2,0],["جحدتْ قتلي وقالت كيف لي","قتلُ إنسانٍ ومالي من حُسامْ",32,"م",1,1],["جَحَاجِحَةٌ غُرُّ الوجوهِ صِبَاحُهَا","ألا بِأبِي تِلْك الجَحَاجِحَةُ الغُرُّ",33,"ر",1,0],["جَحَدوا الذي سمعوا وقالوا غيرَه","ولو انَّهمْ لا يسمعون تَقَوَّلُوا",34,"ل",3,0],["جَحاجِحُ لا يُعابُ مَنِ اسْتَباحَتْ","صُدُورُ رِماحِهِمْ يَوْمَ الْهِياجِ",35,"ج",1,0],["جَحَدَت دَمي ظُلماً وَلَ","كِن ناظِراها ناظَراها",36,"ا",3,0],["جَحافِلهُ أسدٌ تزَأَّرُ في الوَغى","وَما غيلها إِلا القَنا وَالقَنابِلُ",37,"ل",1,0],["جحفلٌ يركبُ منها جحفلاً","يتعادى كجنودٍ زاحفين",38,"ن",1,0],["جَحَدوا يَدي البَيضاءَ إِذ وافى بِها الد","اعي لِأَنَّهُمُ السَوادُ الأَسوَدُ",39,"د",1,0],["جُحرٌ بِهِ عِندَ جَحرِهِ بَعَرٌ","عَرَفتُهُ تَحتَ ذَقنِهِ كَبَبُ",40,"ب",1,0],["جَحَدتُم مُوالاةَ مَولاكُمُ","ويومَ الغَديرِ بِها مُؤمِنونا",41,"ن",2,0],["جحد المعلم بغتةً","وارتد في وعيٍ ينوحه",42,"ح",2,0],["جحاجحةٌ شمُّ العرانين هُتَّفٌ","بكلّ بعيد الغور ملتهب الزّند",43,"د",1,0],["جحدت أعينُه سفك دمي","وعليه حدّه في الوجه يشهد",44,"د",1,0],["جحَدْتُ الهوي عند العواذلِ ضِنّةً","عليهمْ بمن أصبو إليهِ وأهواهُ",45,"ه",1,1],["جحدت الهوى خوف الوشاة فأعربت","دموعي بما ألقى ولم ينفع الجحد",46,"د",1,0],["جحدت عوارَفهُ وليس لمثله","مهما أُسئ سوى الوفاءِ لناسِه",47,"س",2,0],["جحدت بها وجدي ودمعيَ","والسقم المضاعف شاهداً عدل",48,"ل",1,0],["جحد الهوى ورأوه يختصمُ النَّوى","فقضى عليه والدموع شهوده",49,"د",2,0],["جحدت فضل الجدود","يا أيها المتفرنس",50,"س",1,0],["جَحفَلٌ أَورَقَ فيهِ هَبوَةٌ","وَنُجومٌ تَتَلَظّى وَشَرارُ",51,"ر",1,0],["جحدته البابٌ طمتها ضلَّةٌ","وأولوا الضلالةِ للكمالِ جواحد",52,"د",1,0],["جَحْجاحُ طائِفَةِ الرِّجالِ إمامُهُمْ","سبَّارُ غايَتِهِمْ بكلِّ مَكَانِ",53,"ن",1,0],["جَحاجِحٌ من أسودِ اللهِ طائِفَةٌ","لهُمْ بتَرْجيحِهِمْ في القَوْمِ ميزَانُ",54,"ن",1,0],["جَحاجِحُ السَّادةِ الأقطابِ غايَتُهُمْ","لها لدى بَدئِهِ في السَّيرِ إِبْداءُ",55,"ا",2,0],["جحفلٌ يقتلُ الجنينَ إذا ما","سارَ في الأرض وقعُهُ في النُحورِ",56,"ر",1,0],["جحدَتْ جُفونُكم دَمي وخُدودُكم","فيهنّ منهُ شُبهةٌ لا تُدفَعُ",57,"ع",1,0],["جَحَدوا الحبَّ وَلَكِنْ","كَتَموهُ ثمّ باحوا",58,"ح",3,0],["جَحدتُ الهَوى لَمّا سُئِلتُ عَنِ الهَوى","وَكَمْ غِرّةٍ مِن ذي شَجىً في المباعثِ",59,"ث",1,0],["جَحرِ بَحيرِ أَو أَخي بَحيرِ","إِلى أَراطٍ وَنَقاً تَيهورِ",60,"ر",1,0]]}