{"poems":[[69,"ذو يراع يروع كالسيف إما","https://www.aldiwan.net/poem18069.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[186,"عرجا في ربوعها وسلاها","https://www.aldiwan.net/poem67021.html","الخفيف"],[287,"ألاح أن لاح بريق يمان","https://www.aldiwan.net/poem32388.html","السريع"],[287,"مه لا تلم يا لائمي صبا هلك","https://www.aldiwan.net/poem32684.html","الرجز"],[302,"من لشملي لو فاز منكم بجمع","https://www.aldiwan.net/poem33226.html","الخفيف"],[371,"أي يوم علا على الأيام","https://www.aldiwan.net/poem17333.html","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91002","الرمل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136499",""],[5064,"ليلٌ حاتِميٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=199087",""],[5219,"دموع أراكان","https://www.poetsgate.com/ViewPoem.aspx?id=194365",""],[5388,"كن بخير","https://www.poetsgate.com/ViewPoem.aspx?id=206910",""],[402,"عاد عهد المدير في اعين الناس","https://www.poetsgate.com/ViewPoem.aspx?id=36831",""]],"verses":[["مَنْ لِشَيْخٍ ذِي عِلَّةٍ وعِيالٍ","ثَقَّلَتْ ظَهْرَهُ بِغَيرِ ظَهيرِ",0,"ر",1,0],["مَنْ لِشِعرِي بِأَنْ يُمَثِّلَهُ أَبْ","قَى عَلَى الدَّهْرِ مِنْ مِثَالِ يُقَامُ",1,"م",1,0],["مَن لشمسِ الضُحى بِنورِ هِلالٍ","مِن سَماءِ الشَهباءِ قَدْ حَياها",2,"ا",3,0],["مَن لِشَجٍ لَولا الأَمانِيُّ لَم","يُمسِ مِنَ المَوتِ أَسىً في أَمان",3,"ن",1,0],["مَن لِشجٍ عَلى القَتادِ جِسمُهُ","ثاوٍ وَلَو كانَ المَهادُ مِن فَنَك",4,"ك",1,0],["مَن لِشَملي لو فاز منكم بجمع","في لَيالي منىً وأَيّام جمعِ",5,"ع",1,1],["مَن لِشُمِّ المُلوكِ لَو خَدَموهُ","دَعهُمُ في جَريدَةِ الخُدّامِ",6,"م",1,0],["من لشهب الليل لو كانت له","شعلة موقودة بالقطر",7,"ر",1,0],["من لشرعِ النبي بَعدك يُمضي","حكمه في الورى ويَحمي حماه",8,"ا",2,0],["مَن لشرعِ النبي بعدكَ يَهديها","الى الرشًُد حين ضلوا وتاهوا",8,"ا",1,0],["مَنْ لِشَوْقٍ إِنْ سَارَ فِي كُلِّ أَرْضٍ","غَيْرٌ قَلْبٍ لَمْ يَسْتطِعْ تأجِيلَهْ",9,"ل",2,0],["من لشيخ لم يجد حتى يدا ؟","من لنذل لدماء قد سفح ؟",10,"ح",1,0],["من لشعر مثل وهج","يملأ الأفق فتونا ..",11,"ن",2,0],["من لشعري بأ يمثله أبقى","على الدهر من مثال يقام",12,"م",1,0]]}