ps://www.poetsgate.com/ViewPoem.aspx?id=175205",""],[5277,"حواء..ولدتني شمساً..وأولدتُها قمرين","https://www.poetsgate.com/ViewPoem.aspx?id=192760",""],[592,"ألا قل لذي جهلٍ بكل الحقائق","https://www.poetsgate.com/ViewPoem.aspx?id=128798",""],[5376,"الدهرُ أمتعنا بالرود والغيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=188404",""],[5431,"من هلوسات الحمى (2)-غرقى","https://www.poetsgate.com/ViewPoem.aspx?id=198322",""],[3294,"يا راكب الجسرة للجسر","https://www.poetsgate.com/ViewPoem.aspx?id=173269",""],[5460,"وقفنا على دار لسلمى فلم تبن","https://www.poetsgate.com/ViewPoem.aspx?id=200748",""],[5550,"يكون الفتى","https://www.poetsgate.com/ViewPoem.aspx?id=211259",""],[5550,"لقد وعدتني","https://www.poetsgate.com/ViewPoem.aspx?id=211487",""],[5582,"تَعَمَّدَنِي الخَطْبُ غَمْزاً وَقَرْعَا","https://www.poetsgate.com/ViewPoem.aspx?id=187179",""],[5616,"الناس","https://www.poetsgate.com/ViewPoem.aspx?id=203231",""],[5616,"قولي","https://www.poetsgate.com/ViewPoem.aspx?id=203440",""],[5616,"أغوار","https://www.poetsgate.com/ViewPoem.aspx?id=203464",""],[5616,"أغرِّد بالقصيدة كلَّ يومٍ","https://www.poetsgate.com/ViewPoem.aspx?id=205220",""],[5701,"تعجبت حتى كدت لا أتعجب","https://www.poetsgate.com/ViewPoem.aspx?id=164590",""],[5956,"الرسالة المحمدية","https://www.poetsgate.com/ViewPoem.aspx?id=184653",""],[5956,"تحيتك الجليلة نهرُ نيلِ","https://www.poetsgate.com/ViewPoem.aspx?id=193349",""],[5986,"أيا عترة المختار والسادة الطهر","https://www.poetsgate.com/ViewPoem.aspx?id=162956",""],[1703,"لقّد وقفت صباح اليوم مفكراً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83672&r=&rc=9",""],[2944,"حياة التشرّد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86016&r=&rc=0",""]],"verses":[["لَقَد وَقَفَ الرَكبُ مِن بابِكُم","عَلى مَطلَبٍ ماؤُهُ مُطلِبُ",0,"ب",1,0],["لَقَد وَسَّعَ اللَهُ ما ضَيَّقوا","وَقَد عَوَّضَ اللَهُ ما خَيَّبوا",0,"ب",3,0],["لَقَد وَعَدَتنا إِذ رَغِبنا رَغايباً","فَلَمّا أَصَبنَ الظَنَّ أَعطَت مَصايبا",1,"ب",2,0],["لَقَد وَدَّعَتني عَبلَةٌ يَومَ بَينِه","وَداعَ يَقينٍ أَنَّني غَيرُ راجِعِ",2,"ع",1,0],["لَقَد وَجَدنا زَبيداً غَيرَ صابِرَةٍ","يَومَ اِلتَقَينا وَخَيلُ المَوتِ تَستَبِقُ",3,"ق",1,1],["لَقَد وَلَدَت حَوّاءُ مِنكِ بَلِيَّةً","عَلَيَّ أُقاسيها وَخَبلاً مِنَ الخَبلِ",4,"ل",1,0],["لَقَد وَلّى أَلِيَّتَهُ جُؤيٌّ","مَعاشِرَ غَيرُ مَطَلولٍ أَخوها",5,"و",3,1],["لقد واصلت قوماً وخلّت وراءها","إناساً تَمَنّى الموت لولا وُعودها",6,"د",3,0],["لقد وفقت بالقلم المعلّى","كما وقفت بالسيف الجراز",7,"ز",1,0],["لَقَد وَلَدَت أُمُّ الفَرَزدَقِ فاجِراً","وَجاءَت بِوَزوازٍ قَصيرِ القَوائِمِ",8,"م",1,0],["لَقَد وَلَدَت أُمُّ الفَرَزدَقِ فاسِقاً","وَجاءَت بِوَزوازٍ قَصيرِ القَوائِمِ",9,"م",1,0],["لَقَد وَلَدَت غَسّانَ ثالِبَةُ الشَوى","عَدوسُ السُرى لا يَقبَلُ الكَرمَ جيدُها",10,"د",3,1],["لَقَد وُجِدَ اِبنُ بَرزَةَ يَومَ جارى","بَطيئاً عَن مُرافَعَةِ الخِطارِ",11,"ر",1,0],["لَقَد وَجَدوا مِنكُم حِبالاً مَتينَةً","فَذَلّوا وَلانَت لِلقِيادِ السَوالِفُ",12,"ف",1,0],["لَقَد وَجَدوا رِشائِيَ مُستَمِرّاً","وَدَلوِيَ غَيرَ واهِيَةِ الأَديمِ",13,"م",1,0],["لَقَد وَجَدَت بِالقَينِ خورُ مُجاشِعٍ","كَوَجدِ النَصارى بِالمَسيحِ اِبنِ مَريَما",14,"م",2,0],["لَقَد وَكَفَت عَيناهُ أَن ظَلَّ واقِفاً","عَلى دِمنَةٍ لَم يَبقَ إِلّا رَميمُها",15,"م",3,0],["لَقَد وَرِثَ الضَلالَةَ عَن أَبيهِ","أُبَيٌّ يَومَ فارَقَهُ الرَسولُ",16,"ل",1,1],["لقد ولدتك آباءٌ كرامٌ","من الآباء ليس لهم ضَريبُ",17,"ب",1,0],["لَقَد وَلَدَت جَذيمَةُ مِن قُرَيشٍ","فَتاها حينَ تَحزُبُها الأُمورُ",18,"ر",1,0],["لَقَد وافَتنِيَ البُشرى","وَأُنبِئتُ بِما سَرّا",19,"ر",2,1],["لَقَد وَجَدوكَ مَفتوناً فَقالوا","خَرَجتَ مِنَ الوَقارِ وَالاِحتِشامِ",20,"م",1,0],["لَقَد وَضَعَتهُ وَهّاجاً مُنيراً","كَما تَلِدُ السَماواتُ الشِهابا",21,"ب",2,0],["لَقَد وَرَدوا وِردَ القَطا شَفَراتِها","وَمَرّوا عَلَيها زَردَقاً بَعدَ زَردَقِ",22,"ق",1,0],["لَقَد وَفَّقَ اللَهُ المُوَفَّقَ لِلَّتي","تَباعَدَ عَن غَيِ المُلوكِ رَشيدُها",23,"د",3,0],["لَقَد وَجدنا لَكَ إِذ سُستَنا","سِياسَةَ الحاني عَلَينا الشَفيق",24,"ق",1,0],["لَقَد وَفَّقَ اللَهُ المُوَفَّقَ لِلَّذي","أَتاهُ وَأَعطى الشامَ ماكانَ يامُلُه",25,"ل",2,1],["لَقَد وَفَّرتَ مِن جَدواكَ حَظّي","كَما وَفَّرتُ حَظَّكَ مِن لِساني",26,"ن",2,0],["لقد وهم الفلاسف حين قالوا","لطيف الجرم يفعل بالكثيف",27,"ف",1,1],["لقد وليتمُ رجلاً","بخفْضِ الناسِ يرتفعُ",28,"ع",1,1],["لقد وَدِدْتُ وأسرابُ المنى خُدعُّ","لو تَسلمان وأنِّ الموت يطويني",29,"ن",2,0],["لَقَد وَعَظتكُم لَو فَهِمتُم عِظاتِها","خُطوبٌ تُضيءُ النَهجَ لِلمُتَفَهِّمِ",30,"م",1,0],["لقد ود هذا الشهر أن دام سرمدا","عليك دراكا يتبع العصر أعصر",31,"ر",1,0],["لَقَد وَدَّعَت حُبّي وَهامَ رَقيبي","وَأَصبَحَ وادي اللَهوِ غَيرَ عَشيبِ",32,"ب",1,1],["لَقَد وَقَعَ الكَعبِيُّ ناراً بِميسَمٍ","عَلى اِستِ أَبيكَ العَبدِ بَعدَ شَبيبِ",32,"ب",1,0],["لَقَد وَضَعَت حَوّاءُ أُمُّكَ بِكرَها","بِدارِ الرَزايا مِن عَوانٍ وَمِن بِكرِ",33,"ر",1,1],["لَقَد وَدَّ أَصحابُ الكَبائِرِ لَو رَأَوا","جَرائِرَهُم مَقذوفَةً في الجَرائِرِ",34,"ر",1,0],["لَقَد وَرَدَ الناسُ الحَياةَ أَمامَنا","فَما تَرَكوا إِلّا الأُجونَةَ وَالرَنقا",35,"ق",2,0],["لَقَد وَسَمتُك وَسماً لاَ يُغَيَّبُهُ","ثَوباكَ يَبرُقُ في الأَعناقِ أَحوالا",36,"ل",2,0],["لَقَد وَشى بي إليها","من كانَ بي يتقوَّى",37,"و",2,0],["لَقَد وجدت حياة الذل فاشية","وَالناس منقبضاً منها وَمنبسطا",38,"ط",2,0],["لقد وضعت يدي والعين باكية","على فؤاد من الأحزان مضطرب",39,"ب",1,0],["لَقَد وسعت أَرض تقل جسومنا","وأَوسع منها في جماجمنا الفكر",40,"ر",1,0],["لقد وقفوا والطبل يهتزّ صوته","فتهتزّ بالأبدان سوق وأكرُع",41,"ع",1,0],["لقد وصفت القصر لل","أبله وصفا عجيبا",42,"ا",1,0],["لقد وْفَى بدرٌ لهم أهلَّهْ","وخُنْتَهُمْ مَشيخَةً أجلهْ",43,"ه",1,0],["لَقَد وَدَّعَتني عَبلَةٌ يَومَ بَينِها","وَداعَ يَقينٍ أَنَّني غَيرُ راجِعِ",44,"ع",1,0],["لقد وَرِثَتْ أخلاقُهُ المَجْدَ والتقى","فلم تتَلْقَهُ إلاّ رشيداً ومُرْشِدا",45,"د",2,0],["لقد وأدوها مُنْذ خمسين حِجَّة","ومازال قلبي غائرَ الجُرْح داميا",46,"ي",2,0],["لقد وثبوا حياهم الله وثبة","رمى الكفر منها المخزيات القواصم",47,"م",1,0],["لقد وقَّعتْ كفُّ الطبيعةِ لحنه","وشابهه في الشعر طبعي فوَّقعا",48,"ع",2,0],["لقد وُفّقَ مَنْ كنّاكها","وأصاب الحقَّ فيها وعَدَلْ",49,"ل",1,0],["لَقَد وَفَدت لِلشام مِنهُ خَريدة","وَفي جيدِها طَوق مِن الشُكر وَالحَمد",50,"د",1,0],["لقد ولى عن الخير اختياراً","ووالى اللاتَ والعزى سفاها",51,"ا",3,0],["لقد وافتك يا بدرُ الثريا","كجنة لؤلؤ جاءت لبحرِ",52,"ر",1,0],["لَقَد وَلّا كَنا مَولىً رَؤوفٌ","فَأَكرِم بِالمُوَلّي وَالمُوَلّى",53,"ل",2,0],["لَقَد وَطَّدتَ بِالآراءِ أَمراً","لِغَيرِكَ ما اِستَقادَ وَلا اِستَقاما",54,"م",2,0],["لقد وعدت عنك البرايا ظنونهم","بخير وقد انجزت للظن موعدا",55,"د",2,0],["لقد وطى عنقَ العليا وتمَّ له","على الليالي بحمد الله ما اقتراحا",56,"ح",2,0],["لقد وافى ففضت عليه بحراً","له بالفضل والإِحسان مد",57,"د",1,0],["لَقَد وَهِمَت إِنّي عَلَيها لَغُصَّةٌ","أَكُنتُ عِراقِيَّ الهَوى أَم شَآمِيا",58,"ي",2,0],["لَقَد وافاكَ ميخائيلُ نَجلٌ","يُحاكي طَلعةَ الصُبحِ البَهِيِّ",59,"ي",1,1],["لَقَد وَرَدَ الحَبيبُ عَلى خَليلٍ","فَفاضَ بِهِ السُرورُ عَلى القُلوبِ",60,"ب",1,1],["لَقَد وَقعتَ منَ الإشراكِ في شركٍ","مِن حيثُ شئتَ خَلاصاً منه بؤت بهِ",61,"ب",2,0],["لقد وعظتنا خطوبُ الزمان","وبعضُ الخطوبِ كبعضِ الخطبْ",62,"ب",1,0],["لقد وضح العنوان عنوان داركم","أفى شارع الكرنيش يا روح تنزل",63,"ل",1,0],["لقد وهب اللَه الحياة لحاسمٍ","له في حياة المجد والحب أحوال",64,"ل",1,0],["لَقَد وَصمتها زمرَة الجَهل بِالريا","وَأَلوَت عَلى أَفعالها بِالمَثالِبِ",65,"ب",1,0],["لقد وجدوا أن الشراب مصحف","سرابا وإن الملك حلم مذهب",66,"ب",1,0],["لقد ورث الإرشاد عن خير والدٍ","روى عن أبيه ما رواه عن الجدّ",67,"د",1,0],["لقد وهبتنا فاستردت هباتها","ولم تهب الأيام إلا لتمتعا",68,"ع",2,0],["لقد ولَّيتِ مُسرعةً فعُودي","سَريعاً يا ليالي المَهرَجان",69,"ن",1,0],["لقد وطئَت وَعرَ البلادِ وسهلها","حَوافرُ تلكَ الخَيلِ وهيَ السّلاجم",70,"م",1,0],["لَقَدْ وَجَدَتْ وَجْدِي الدِّيارُ بِأَهْلِها","وَلَو لَمْ تَجِدْ وَجْدِي لَما سَقِمتْ سُقْمِي",71,"م",2,0],["لَقَد وَلّى بِلَذّاتي","وَما أَحمَدتُ مِن عُمري",72,"ر",2,0],["لَقَد وَلّى الصِبا غَضّاً","أَنيقَ الرَّوضِ وَالزَّهرِ",72,"ر",1,0],["لَقد وَسِعَ الأيّام خبراً ونجدةً","وَأَجدى مُزينيه النجابة والخبرُ",73,"ر",1,0],["لَقد وسّدت جهلاً عريضاً نفيّها","فباتَت تُمنّيها الأماني مهودها",74,"د",3,0],["