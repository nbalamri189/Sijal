],[311,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[320,"لقد واصلت سلمى في ليال","https://www.aldiwan.net/poem56357.html","الوافر"],[326,"أأبكى هوى أم فرحة أم أمانيا","https://www.aldiwan.net/poem55003.html","الطويل"],[351,"أما والهوى لولا الألى نزلوا السفحا","https://www.aldiwan.net/poem40542.html","الطويل"],[362,"أتلك رياض أم خدود نواعم","https://www.aldiwan.net/poem60665.html","الطويل"],[377,"لئن حل في دين الهوى لكم ظلمي","https://www.aldiwan.net/poem49259.html","الطويل"],[399,"بلغت ما شئت من حزني ومن كمدي","https://www.aldiwan.net/poem46749.html","البسيط"],[406,"كفى حزنا أني مقيم ببلدة","https://www.aldiwan.net/poem32270.html","الطويل"],[413,"حييت من قادم حل السرور به","https://www.aldiwan.net/poem54138.html","البسيط"],[426,"إليك العدل قد ألقى اختياره","https://www.aldiwan.net/poem39862.html","الوافر"],[426,"ألا حيي بكاسك واستنيري","https://www.aldiwan.net/poem41439.html","الوافر"],[438,"هو الرزء حتى كل قلب به جمر","https://www.aldiwan.net/poem14426.html","الطويل"],[456,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[456,"قفا نضويكما بالغمر نسأل","https://www.aldiwan.net/poem56264.html","الوافر"],[462,"عداك وجدي فعد عن عذلي","https://www.aldiwan.net/poem3178.html","عموديه"],[462,"قفا في ذمام الدمع بين الملاعب","https://www.aldiwan.net/poem3188.html","عموديه"],[462,"رسوم ديار باللوى وربوع","https://www.aldiwan.net/poem3499.html","عموديه"],[462,"لقد وافيت بابك مستغيثاً","https://www.aldiwan.net/poem3568.html","عموديه"],[475,"وفيت لمن أحبهم فخانوا","https://www.aldiwan.net/poem15198.html","الوافر"],[475,"أظنك لو علمت بفرط حبي","https://www.aldiwan.net/poem15297.html","الوافر"],[498,"لقد وعظ العذال وجدي بشأن من","https://www.aldiwan.net/poem37982.html","الطويل"],[512,"هوى الكوكب الدري من أفق المجد","https://www.aldiwan.net/poem20841.html","الطويل"],[549,"أهاجك ذكر منهم ووساوس","https://www.aldiwan.net/poem47756.html","الطويل"],[559,"لقد وجدتم مصعبا مستصعبا","https://www.aldiwan.net/poem27829.html","الرجز"],[560,"إذا رمت نظم الشعر في مدح ذي الرشد","https://www.aldiwan.net/poem52781.html","الطويل"],[560,"تناقض الرأي بين الناس والعمل","https://www.aldiwan.net/poem52856.html","البسيط"],[560,"أتدري ما بقلبك من جراح","https://www.aldiwan.net/poem52911.html","الوافر"],[573,"لو واصلتني يوما لم أمت أبداً","https://www.aldiwan.net/poem3080.html","البسيط"],[583,"سرى ما بيننا سر الغيوب","https://www.aldiwan.net/poem1565.html",""]],"verses":[["لَقَد وَقَفَ الرَكبُ مِن بابِكُم","عَلى مَطلَبٍ ماؤُهُ مُطلِبُ",0,"ب",1,0],["لَقَد وَسَّعَ اللَهُ ما ضَيَّقوا","وَقَد عَوَّضَ اللَهُ ما خَيَّبوا",0,"ب",3,0],["لَقَد وَعَدَتنا إِذ رَغِبنا رَغايباً","فَلَمّا أَصَبنَ الظَنَّ أَعطَت مَصايبا",1,"ب",2,0],["لَقَد وَدَّعَتني عَبلَةٌ يَومَ بَينِه","وَداعَ يَقينٍ أَنَّني غَيرُ راجِعِ",2,"ع",1,0],["لَقَد وَجَدنا زَبيداً غَيرَ صابِرَةٍ","يَومَ اِلتَقَينا وَخَيلُ المَوتِ تَستَبِقُ",3,"ق",1,1],["لَقَد وَلَدَت حَوّاءُ مِنكِ بَلِيَّةً","عَلَيَّ أُقاسيها وَخَبلاً مِنَ الخَبلِ",4,"ل",1,0],["لَقَد وَلّى أَلِيَّتَهُ جُؤيٌّ","مَعاشِرَ غَيرُ مَطَلولٍ أَخوها",5,"و",3,1],["لقد واصلت قوماً وخلّت وراءها","إناساً تَمَنّى الموت لولا وُعودها",6,"د",3,0],["لقد وفقت بالقلم المعلّى","كما وقفت بالسيف الجراز",7,"ز",1,0],["لَقَد وَلَدَت أُمُّ الفَرَزدَقِ فاجِراً","وَجاءَت بِوَزوازٍ قَصيرِ القَوائِمِ",8,"م",1,0],["لَقَد وَلَدَت أُمُّ الفَرَزدَقِ فاسِقاً","وَجاءَت بِوَزوازٍ قَصيرِ القَوائِمِ",9,"م",1,0],["لَقَد وَلَدَت غَسّانَ ثالِبَةُ الشَوى","عَدوسُ السُرى لا يَقبَلُ الكَرمَ جيدُها",10,"د",3,1],["لَقَد وُجِدَ اِبنُ بَرزَةَ يَومَ جارى","بَطيئاً عَن مُرافَعَةِ الخِطارِ",11,"ر",1,0],["لَقَد وَجَدوا مِنكُم حِبالاً مَتينَةً","فَذَلّوا وَلانَت لِلقِيادِ السَوالِفُ",12,"ف",1,0],["لَقَد وَجَدوا رِشائِيَ مُستَمِرّاً","وَدَلوِيَ غَيرَ واهِيَةِ الأَديمِ",13,"م",1,0],["لَقَد وَجَدَت بِالقَينِ خورُ مُجاشِعٍ","كَوَجدِ النَصارى بِالمَسيحِ اِبنِ مَريَما",14,"م",2,0],["لَقَد وَكَفَت عَيناهُ أَن ظَلَّ واقِفاً","عَلى دِمنَةٍ لَم يَبقَ إِلّا رَميمُها",15,"م",3,0],["لَقَد وَرِثَ الضَلالَةَ عَن أَبيهِ","أُبَيٌّ يَومَ فارَقَهُ الرَسولُ",16,"ل",1,1],["لقد ولدتك آباءٌ كرامٌ","من الآباء ليس لهم ضَريبُ",17,"ب",1,0],["لَقَد وَلَدَت جَذيمَةُ مِن قُرَيشٍ","فَتاها حينَ تَحزُبُها الأُمورُ",18,"ر",1,0],["لَقَد وافَتنِيَ البُشرى","وَأُنبِئتُ بِما سَرّا",19,"ر",2,1],["لَقَد وَجَدوكَ مَفتوناً فَقالوا","خَرَجتَ مِنَ الوَقارِ وَالاِحتِشامِ",20,"م",1,0],["لَقَد وَضَعَتهُ وَهّاجاً مُنيراً","كَما تَلِدُ السَماواتُ الشِهابا",21,"ب",2,0],["لَقَد وَرَدوا وِردَ القَطا شَفَراتِها","وَمَرّوا عَلَيها زَردَقاً بَعدَ زَردَقِ",22,"ق",1,0],["لَقَد وَفَّقَ اللَهُ المُوَفَّقَ لِلَّتي","تَباعَدَ عَن غَيِ المُلوكِ رَشيدُها",23,"د",3,0],["لَقَد وَجدنا لَكَ إِذ سُستَنا","سِياسَةَ الحاني عَلَينا الشَفيق",24,"ق",1,0],["لَقَد وَفَّقَ اللَهُ المُوَفَّقَ لِلَّذي","أَتاهُ وَأَعطى الشامَ ماكانَ يامُلُه",25,"ل",2,1],["لَقَد وَفَّرتَ مِن جَدواكَ حَظّي","كَما وَفَّرتُ حَظَّكَ مِن لِساني",26,"ي",1,0],["لقد وهم الفلاسف حين قالوا","لطيف الجرم يفعل بالكثيف",27,"ف",1,1],["لقد وليتمُ رجلاً","بخفْضِ الناسِ يرتفعُ",28,"ع",1,1],["لقد وَدِدْتُ وأسرابُ المنى خُدعُّ","لو تَسلمان وأنِّ الموت يطويني",29,"ن",2,0],["لَقَد وَعَظتكُم لَو فَهِمتُم عِظاتِها","خُطوبٌ تُضيءُ النَهجَ لِلمُتَفَهِّمِ",30,"م",1,0],["لقد ود هذا الشهر أن دام سرمدا","عليك دراكا يتبع العصر أعصر",31,"ر",1,0],["لَقَد وَدَّعَت حُبّي وَهامَ رَقيبي","وَأَصبَحَ وادي اللَهوِ غَيرَ عَشيبِ",32,"ب",1,1],["لَقَد وَقَعَ الكَعبِيُّ ناراً بِميسَمٍ","عَلى اِستِ أَبيكَ العَبدِ بَعدَ شَبيبِ",32,"ب",1,0],["لَقَد وَضَعَت حَوّاءُ أُمُّكَ بِكرَها","بِدارِ الرَزايا مِن عَوانٍ وَمِن بِكرِ",33,"ر",1,1],["لَقَد وَدَّ أَصحابُ الكَبائِرِ لَو رَأَوا","جَرائِرَهُم مَقذوفَةً في الجَرائِرِ",34,"ر",1,0],["لَقَد وَرَدَ الناسُ الحَياةَ أَمامَنا","فَما تَرَكوا إِلّا الأُجونَةَ وَالرَنقا",35,"ق",2,0],["لَقَد وَسَمتُك وَسماً لاَ يُغَيَّبُهُ","ثَوباكَ يَبرُقُ في الأَعناقِ أَحوالا",36,"ل",2,0],["لَقَد وَشى بي إليها","من كانَ بي يتقوَّى",37,"و",2,0],["لَقَد وجدت حياة الذل فاشية","وَالناس منقبضاً منها وَمنبسطا",38,"ط",2,0],["لقد وضعت يدي والعين باكية","على فؤاد من الأحزان مضطرب",39,"ب",1,0],["لَقَد وسعت أَرض تقل جسومنا","وأَوسع منها في جماجمنا الفكر",40,"ر",1,0],["لقد وقفوا والطبل يهتزّ صوته","فتهتزّ بالأبدان سوق وأكرُع",41,"ع",1,0],["لقد وصفت القصر لل","أبله وصفا عجيبا",42,"ا",1,0],["لقد وْفَى بدرٌ لهم أهلَّهْ","وخُنْتَهُمْ مَشيخَةً أجلهْ",43,"ه",1,0],["لَقَد وَدَّعَتني عَبلَةٌ يَومَ بَينِها","وَداعَ يَقينٍ أَنَّني غَيرُ راجِعِ",44,"ع",1,0],["لقد وَرِثَتْ أخلاقُهُ المَجْدَ والتقى","فلم تتَلْقَهُ إلاّ رشيداً ومُرْشِدا",45,"د",2,0],["لقد وأدوها مُنْذ خمسين حِجَّة","ومازال قلبي غائرَ الجُرْح داميا",46,"ي",2,0],["لقد وقَّعتْ كفُّ الطبيعةِ لحنه","وشابهه في الشعر طبعي فوَّقعا",47,"ع",2,0],["لقد وُفّقَ مَنْ كنّاكها","وأصاب الحقَّ فيها وعَدَلْ",48,"ل",1,0],["لَقَد وَفَدت لِلشام مِنهُ خَريدة","وَفي جيدِها طَوق مِن الشُكر وَالحَمد",49,"د",1,0],["لقد ولى عن الخير اختياراً","ووالى اللاتَ والعزى سفاها",50,"ا",3,0],["لقد وافتك يا بدرُ الثريا","كجنة لؤلؤ جاءت لبحرِ",51,"ر",1,0],["لَقَد وَلّا كَنا مَولىً رَؤوفٌ","فَأَكرِم بِالمُوَلّي وَالمُوَلّى",52,"ل",2,0],["لَقَد وَطَّدتَ بِالآراءِ أَمراً","لِغَيرِكَ ما اِستَقادَ وَلا اِستَقاما",53,"م",2,0],["لقد وعدت عنك البرايا ظنونهم","بخير وقد انجزت للظن موعدا",54,"د",2,0],["لقد وطى عنقَ العليا وتمَّ له","على الليالي بحمد الله ما اقتراحا",55,"ح",2,0],["لقد وافى ففضت عليه بحراً","له بالفضل والإِحسان مد",56,"د",1,0],["لَقَد وَهِمَت إِنّي عَلَيها لَغُصَّةٌ","أَكُنتُ عِراقِيَّ الهَوى أَم شَآمِيا",57,"ي",2,0],["لَقَد وافاكَ ميخائيلُ نَجلٌ","يُحاكي طَلعةَ الصُبحِ البَهِيِّ",58,"ي",1,1],["لَقَد وَرَدَ الحَبيبُ عَلى خَليلٍ","فَفاضَ بِهِ السُرورُ عَلى القُلوبِ",59,"ب",1,1],["لَقَد وَقعتَ منَ الإشراكِ في شركٍ","مِن حيثُ شئتَ خَلاصاً منه بؤت بهِ",60,"ب",2,0],["لقد وعظتنا خطوبُ الزمان","وبعضُ الخطوبِ كبعضِ الخطبْ",61,"ب",1,0],["لقد وضح العنوان عنوان داركم","أفى شارع الكرنيش يا روح تنزل",62,"ل",1,0],["لقد وهب اللَه الحياة لحاسمٍ","له في حياة المجد والحب أحوال",63,"ل",1,0],["لَقَد وَصمتها زمرَة الجَهل بِالريا","وَأَلوَت عَلى أَفعالها بِالمَثالِبِ",64,"ب",1,0],["لقد وجدوا أن الشراب مصحف","سرابا وإن الملك حلم مذهب",65,"ب",1,0],["لقد ورث الإرشاد عن خير والدٍ","روى عن أبيه ما رواه عن الجدّ",66,"د",1,0],["لقد وهبتنا فاستردت هباتها","ولم تهب الأيام إلا لتمتعا",67,"ع",2,0],["لقد ولَّيتِ مُسرعةً فعُودي","سَريعاً يا ليالي المَهرَجان",68,"ن",1,0],["لقد وطئَت وَعرَ البلادِ وسهلها","حَوافرُ تلكَ الخَيلِ وهيَ السّلاجم",69,"م",1,0],["لَقَدْ وَجَدَتْ وَجْدِي الدِّيارُ بِأَهْلِها","وَلَو لَمْ تَجِدْ وَجْدِي لَما سَقِمتْ سُقْمِي",70,"ي",1,0],["لَقَد وَلّى بِلَذّاتي","وَما أَحمَدتُ مِن عُمري",71,"ر",2,0],["لَقَد وَلّى الصِبا غَضّاً","أَنيقَ الرَّوضِ وَالزَّهرِ",71,"ر",1,0],["لَقد وَسِعَ الأيّام خبراً ونجدةً","وَأَجدى مُزينيه النجابة والخبرُ",72,"ر",1,0],["لَقد وسّدت جهلاً عريضاً نفيّها","فباتَت تُمنّيها الأماني مهودها",73,"د",3,0],["لَقَد وَفَّرتَ وِزراً مَرَّ حيناً","يَسُدُّ عَلَيكَ سُبلَ الاِنبِعاثِ",74,"ث",1,0],["لقد وقعوا مع علمهم في ظلالة","إذا اعتبرت أربت على كل ضلة",75,"ه",1,0],["لَقَد واصَلتُ سَلمى في لَيالٍ","وَأَيّامٍ وَعَيشٍ غَيرِ عَشِّ",76,"ش",1,1],["لقد وهبتني الجسم والروح والهوى","ولم أعطها إلا فتاتَ شبابيا",77,"ي",2,0],["لَقد وَقَفَت بلقيس نَظمي بِبابكم","فَهَبها قبولاً مِنكَ أَن تَدخل الصرحا",78,"ح",2,0],["لقد وَلِيَتْ يُمْناهُ وهْي غَمامةٌ","فمِنْ طَرَبٍ ما تَسْتَفيقُ الغَمائم",79,"م",1,0],["لَقَد وَسمت أَيدي النَوى الربع بِالبَلى","فَباكرهُ يا دَمعي وَراوحهُ يا وَسمي",80,"ي",1,0],["لقد وَهبَتْكُم روحي بلا ثمنٍ","وبعتُ نومي بتَسْهيدي يداً بيدِ",81,"د",1,0],["لقد ولّى زمانٌ نحنُ فيه","فُسقياً للحِمَام به ورُعيَا",82,"ي",2,0],["لقد وفى لك واسترضى المشير فما","أبقى قصوراً ولا في الباع تقصير",83,"ر",1,0],["لقد وافاك عبدك في مديحٍ","تضمن من معانيك الإشاره",84,"ر",2,0],["لقد وافاك عبد مستضيئا","شهاب النصر من وجه البشيرِ",85,"ر",1,0],["لقد وقع الكسر المهيض وما له","على دول الأَيام ما بقيت جبر",86,"ر",1,0],["لقد ولدتْ منك الذي لا أخاً له","وهل تلد العذراءُ وهي عقيمُ",87,"م",1,0],["لقد واسيتني في العيش دهراً","فما لي لم أُواسِك في المماتِ",88,"ت",1,0],["لقد وجدت الزمان معتدلاً","وكان لولاه غير معتدل",89,"ل",1,0],["لقد وسموا جيد الزمان بجودهم","وما وسمت أحسابهم بالمصائب",90,"ب",1,0],["لقد وفيت تلك الأمانة حقّها","وأودعتُ سرَّ الحب غيرَ مذيع",91,"ع",1,0],["لقد وافيتُ بابكَ مستغيثاً","فلم تصرف بسطوتك الصروف",92,"ف",1,1],["لقد وكَّلْنَ بالعبراتِ طرفاً","اِذا سكَّنتُه خَفَقَ الجَنان",93,"ن",1,0],["لقد وكَّلْتَ بالتَّسهادِ عيني","وبالبَلْبالِ لمّا بنتَ لُبَّي",94,"ب",2,0],["لقد وَعَظَ العُذَّالُ وَجدي بِشأنِ من","فَنيتُ بهِ والوجدُ ينْمي به الوَعْظُ",95,"ظ",1,1],["لقد وهَبَ الدّنيا لأكرَمِ والِدٍ","وآثرَ في طوبى القُدوم على الجَدِّ",96,"د",1,0],["لقد ولدتْ منّي النساءُ مُشيّعاً","له الرَّوْعُ مَغْنىً والحروبُ مجالسُ",97,"س",1,0],["لَقَد وَجَدتُم مُصعَباً مُستَصعَبا","حين رَمى الأحزابَ وَالمُحزِّبا",98,"ب",2,1],["لقد وَسِعتْ كلَّ القريضِ صفاتُهُ","فلا فضلةٌ عنها لجيدٍ ولا نَهْدِ",99,"د",1,0],["لَقد وَجدنا بني رَسلانَ طائفةً","مثلَ الأهلَّةِ بالتَّدريجِ تَكتَمِلُ",100,"ل",1,0],["لقد وافاكَ نصرُ اللهِ فَوْراً","يُبشِّرُ بالمسَرَّةِ والنَجاحِ",101,"ح",1,0],["لقد وعدتَ نُجومَ السَّعدِ طالِعةً","فِينَا ومِثْلُكَ مَنْ أَوْفَى بِما وَعَدا",102,"د",2,0],["لقد ولّت شَمال الشِّرْك لمّا","أَنار الدينُ من أُفقِ الجَنوب",103,"ب",1,0]]}