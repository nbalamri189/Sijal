{"poems":[[57,"أيا سيدة الناس","https://www.aldiwan.net/poem26263.html","الهزج"],[74,"صدودك يا لمياء عني ولا البعد","https://www.aldiwan.net/poem18549.html","الطويل"],[87,"رضاكم بالعلاقة لي كفيل","https://www.aldiwan.net/poem7893.html","الوافر"],[87,"مصاب بني الدنيا عظيم بأدهم","https://www.aldiwan.net/poem62830.html","الطويل"],[63,"أقول لحنان العشي المغرد","https://www.aldiwan.net/poem51699.html","الطويل"],[51,"لدوا للموت وابنوا للخراب","https://www.aldiwan.net/poem10340.html","الوافر"],[99,"أليلاى ما أبقى الهوى في من رشد","https://www.aldiwan.net/poem24350.html","الطويل"],[54,"وغرس من الأحباب غيبت في الثرى","https://www.aldiwan.net/poem26940.html","الطويل"],[48,"تجنب حانة الصهبا","https://www.aldiwan.net/poem23111.html","الهزج"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/142405","الوافر"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141999","المتقارب"],[96,"الدمية المحطّمة","https://www.poetsgate.com/ViewPoem.aspx?id=15615",""],[119,"أغث يا ختام المرسلين بإحسان","https://www.aldiwan.net/poem42161.html","الوافر"],[147,"سبقت ففز بعظيم الخطر","https://www.aldiwan.net/poem11757.html","المتقارب"],[159,"تجمشه بلحظ الطرف كفي","https://www.aldiwan.net/poem55783.html","الوافر"],[164,"شممت نسيما من وصالك لوهبا","https://www.aldiwan.net/poem58997.html","الطويل"],[202,"لمغناك سح المزن أدمع باك","https://www.aldiwan.net/poem51909.html","الطويل"],[242,"مظنة إتلاف المحب العواذل","https://www.aldiwan.net/poem18855.html","الطويل"],[246,"قدوم ولكن لا أقول سعيد","https://www.aldiwan.net/poem45771.html","الطويل"],[285,"أظن الدهر جاءك مستثيرا","https://www.aldiwan.net/poem60698.html","الوافر"],[287,"عسى الدهر أن ينتاشني ولعله","https://www.aldiwan.net/poem32650.html","الطويل"],[308,"أيا ليلة الجرعاء كم لك في الحشا","https://www.aldiwan.net/poem58201.html","الطويل"],[371,"أوجه العلا أسفر فقد أقبل البدر","https://www.aldiwan.net/poem17198.html","الطويل"],[408,"وأغيد وسنان اللحاظ قوامه","https://www.aldiwan.net/poem46743.html","الطويل"],[409,"ترفق بالمعنى يا غرام","https://www.aldiwan.net/poem33423.html","الوافر"],[409,"إلي أحاديث الصبابة تسند","https://www.aldiwan.net/poem33978.html","الطويل"],[445,"يا صفوة الأجفان من عبراتها","https://www.aldiwan.net/poem34761.html","الطويل"],[447,"أعيدي بديع النوح ويك أعيدي","https://www.aldiwan.net/poem14453.html","الطويل"],[447,"على تالد الأيام لي طارف الحزن","https://www.aldiwan.net/poem14484.html","الطويل"],[469,"لقد لج دمعي ليلة السفح بالسفح","https://www.aldiwan.net/poem3581.html","عموديه"],[500,"شماسة قلب ليس يألف طائره","https://www.aldiwan.net/poem9854.html","الطويل"],[534,"أيا بين كم كدرت صفو المشارب","https://www.aldiwan.net/poem37536.html","الطويل"],[567,"خذوا حذركم من طرفه فهو قتال","https://www.aldiwan.net/poem52839.html","الطويل"],[591,"جيش الملاحة مقرون به الظفر","https://www.aldiwan.net/poem17513.html","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86897","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63970","الهزج"],[918,"","https://poetry.dctabudhabi.ae/diwan/poem/107324","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62673","الطويل"],[1028,"","https://poetry.dctabudhabi.ae/diwan/poem/99915","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59438","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59430","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144104","الهزج"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46663",""],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132811","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128705","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80010","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101007","السريع"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125400","الطويل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100460","المتقارب"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123156","البسيط"],[2196,"","https://poetry.dctabudhabi.ae/diwan/poem/205616","الطويل"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121907","الوافر"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137447",""],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137444",""],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75909","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130077","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67971","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62854","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62770","الطويل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123942","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103873","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129436","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91479","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216834","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135508","الطويل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44905","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125833","البسيط"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117252","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120250","الوافر"],[4639,"","https://poetry.dctabudhabi.ae/diwan/poem/124659","الطويل"],[5057,"ثمار المحبّة","https://www.poetsgate.com/ViewPoem.aspx?id=208545",""],[5061,"انين الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=147428",""],[585,"أما حان خوض المأزق المتلاحم","https://www.poetsgate.com/ViewPoem.aspx?id=161924",""],[5199,"ياْدمى ربك الى يقدر وينجزاء","https://www.poetsgate.com/ViewPoem.aspx?id=146096",""],[5213,"سل السرب يوم الظعن ما فعل السرب","https://www.poetsgate.com/ViewPoem.aspx?id=170411",""],[5277,"هنالكَ... حيثُ يختبئُ النهارُ","https://www.poetsgate.com/ViewPoem.aspx?id=188252",""],[5461,"زايل الشر ردا على قصيدة الأمير (سلطان بن عبد العز","https://www.poetsgate.com/ViewPoem.aspx?id=5063",""],[5480,"العين والكاف","https://www.poetsgate.com/ViewPoem.aspx?id=31228",""],[5573,"سالفة وجد","https://www.poetsgate.com/ViewPoem.aspx?id=200346",""],[5595,"أبا السّجادِ يا كلَّ نبيٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=175953",""],[6048,"معراجُ الوجع","https://www.poetsgate.com/ViewPoem.aspx?id=197747",""],[6115,"يادار علمني وقل وين راعيك","https://www.poetsgate.com/ViewPoem.aspx?id=180499",""],[242,"مظنة اتلاف المحب العواذل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563706",""],[2638,"من بين الدموع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87872&r=&rc=29",""]],"verses":[["وَيا ديباجَةَ الحُسنِ","وَيا رامُشنَةَ الآسِ",0,"س",1,0],["ويا دمعُ فضْ وجداً بذكر خدودهم","فإنكَ ماءُ الوردِ إن ذهب الوَرْد",1,"د",1,0],["ويا دهري شكرت وكان منى","لما قد مر نسيان طويل",2,"ل",1,0],["وَيا داءُ ما أَنصَفتَ إِذ رُعتَ صَدرَهُ","وَقَد كانَ فيهِ المُلكُ إِن ريعَ يَحتَمي",3,"م",2,0],["ويا ديْرَها الشَّرقيَّ لازالَ رائحٌ","يَحُلُّ عُقودَ المُزنِ فيكَ ويَغتدي",4,"د",2,0],["وَيا دُنيايَ ما لي لا أَراني","أَسومُكِ مَنزِلاً إِلّا نَبا بي",5,"ب",2,0],["ويا دارَ من أهوىَ عليكِ تحيةٌ","على أكرمِ الذكرى على أشرفِ العهدِ",6,"د",1,0],["وَيادَهرُ هَذي فِعلَةٌ قَد فَعَلَتها","عَلى مِثلِها كانَت تَدورُ دَوائِري",7,"ر",2,0],["وَيا دَهرُ لَحاكَ اللَهُ","ما هَنَّأتَ فَرحانَك",8,"ك",1,0],["ويا دنيا أميّة لا تراعي","شبابك يغمر الرحب الفساحا",9,"ح",2,0],["ويا دهشتي حين فتَّحتُ عيني","وشاهدتُ في الصدرِ رمانتينْ",10,"ن",1,0],["ويا دمية أنشأتها ثمّ حطّمت","يداي الذي أنشأت تحطيم جبّار",11,"ر",1,0],["ويا دولة الرحمن في كل مظهر","ويا من أتى يهدي بآيات قرآن",12,"ن",1,0],["وَيا داعِيَ الجَفَلى لِلغِنى","إِذا مَن دَعا لِلطَعامِ اِنتَقَر",13,"ر",1,0],["ويا دائي أَتَرجو بعد يأسٍ","فَما الشكوى إلى غير المجيبِ",14,"ب",1,0],["ويا دمع يكفيني ويكفيك ما جرى","فما كنت إلا وابلا والمقا سحبا",15,"ب",2,0],["ويا دُرُّ ما للبيتِ أظلم كسرُه","تراكِ تيممت الترابَ تراكِ",16,"ك",1,0],["وَيَا دِيمَةَ الْوَسْمِيِّ حَيِّي ثَرَاهُمُ","وَبُثِّي لَهُمْ أَنِّي مِنَ الْبَثِّ قَاحِلُ",17,"ل",1,0],["ويا دولة العباس دمتِ عزيزةً","وظلكِ في أرجاءِ مصرَ مديدُ",18,"د",1,0],["وَيا دَهْراً أَهابَ بِنا رَداهُ","لِيُتْبِعَ أَوَّلاً مِنّا أَخِيرا",19,"ر",2,0],["وَيا دَهرِيَ اِطوِ الجورَ وَيحَكَ وَاِتَّئِب","فَهَذا صَفِيُّ الدِّينِ يَنشُرُ عَدلَهُ",20,"ل",2,0],["ويا دار كم در السحاب عليك من","لواحظ باكٍ من لواحِ ظُباك",21,"ك",1,0],["وَيا دَهرَنا أَحسِن فَإِنَّكَ مُحسِنٌ","وَمَن سادَ أَهلَ الدَهرِ كانَ هُوَ الدَهرُ",22,"ر",1,0],["ويا دمعي الجاري ونار جوانحي","قِفا حدّثا عن صبوتي وغرامي",23,"م",2,0],["ويا دمعي أرح عيني قليلاً","يواصلها إذا شاء المنام",24,"م",1,0],["ويا دَهِرِيَ الجافي أما منك عَطْفَةٌ","يفوز بها الصبُّ الغريب المشرَّدُ",25,"د",1,0],["ويا دمْعِي الهتانَ هل أنت مقلع","ويا نوم أجفاني أما لك موعد",25,"د",1,0],["ويا دَوْحَةَ العِزِّ الَّتِي قادَتِ المُنى","إِلَى باسِقِ الأَغصانِ من شَجَراتِها",26,"ت",3,0],["ويا دافنيه في الثرى إن قبره","مقر ذكاء ولا مقر لحيد",27,"د",1,0],["ويا دافنيه في الثرى إن قبره","مقر الثريا والسماكين والوزن",28,"ن",1,0],["ويا دارُ بانَ الآمراتُ على النهى","فلا خفقتْ رايات بأنكِ والطّلح",29,"ح",1,0],["ويا دمع أدركني إن الصبر خانني","بنصرك والمخذول من أنت ناصره",30,"ر",2,0],["ويا دَهْرُ كَمْ جَرَّعْتَنِي فَقْدَ صاحِبٍ","بِكأْسِ النَّوَى مِنْ بَعْدِهِ فَقَدُ صاحِبِ",31,"ب",1,0],["ويا دارَهُ بالغَرْبِ إنَّ مَزارَها","بعيدٌ ولكن دُونَهُ ليسَ أهوالُ",32,"ل",1,0],["وَيا دِيارَ الحِمَى شُطِّي أَوِ اقْتَربي","إنْ شاءَ جَادَكِ أَوْ لا جَادَكِ المَطَرُ",33,"ر",1,0],["وَيا دَوحة المَجد المؤثل وَالندى","وَيا خَير مَن وافى وَأَنعَم بِالبشر",34,"ر",1,0],["ويا درَّةَ تاجِ عيبُها","في أنها لُقْطَه",35,"ط",2,0],["وَيا دُرَّةَ الدهرِ العَديمِ نظيرُها","فَواجِدُها من مُقتَنِي الحمدِ غانِمُ",36,"م",1,0],["ويا دهر رِفْدٍ كيف بدل غيره","ويا طور مَجْدٍ كيف هدت مناكبُهْ",37,"ب",2,0],["ويا دار الأحبة خبريني","سقتك هوا مع السحب الغوادي",38,"د",2,0],["ويا دائم المعروف يا مجزل العطا","ويا مولى النعما ويا دافع النعم",39,"م",1,0],["ويا دمع والأجفان غير موانع","أما آن من صوب العهاد صبيب",40,"ب",1,0],["ويا دهرُ لقد جُرْتَ","الى النّكرِ عن العُرْفِ",41,"ف",1,1],["ويا دهرُ لقدر جرتَ","إلى النكُر عن العُرفِ",42,"ف",1,1],["ويا دهر لا تهجم بمن لا تودَّه","على ساعةٍ يصفو له ويطيبُ",43,"ب",1,0],["ويا دمية القصر الذي صار دمنة","على أن معنى الحسن فيه مصور",44,"ر",1,0],["ويا دافنيه في الثرى هل علمتُم","بأنَّكم واريتمُ في الثرى بحرا",45,"ر",2,0],["ويا ديار الحيِّ بالمُنحنى","حييت من دار ومن مربع",46,"ع",1,0],["ويا دمع فض وخداً بذكر خُدُودِها","فإنك ماءُ الوَردِ أن ذهب الوردُ",47,"د",1,0],["ويا دوح مجدٍ وعلم سما","على الفرقدين فأبدى ذبولا",48,"ل",2,0],["ويا دجاجا في الصحن ما لك لا","ترثي لمن قلبه في هجرك انصدعا",49,"ع",2,0],["ويا دهر رفقا بإمرئ لم تدع له","رجاء فقد قطّعت حبل رجائه",50,"ا",3,0],["ويا دهرا رمانى بالرزايا","لقد قرطست لو أنى أراع",51,"ع",1,0],["ويا دمع فاسكت حسرة وتاسفا","ففي أي وقت غير ذا يحمد السكب",52,"ب",1,0],["ويا دهر فافعل ما تشاء بمن تشا","ولا تخش ان طالت حتوفك ان تلحى",53,"ح",2,0],["وَيا دُرَّةَ الغَوّاصِ زِدتَ مَلاحَةً","إِلى العَين لَمّا أَشبَهتك ثُغُورُها",54,"ر",3,0],["ويا دار تعليم البنات لقد مضى","بلاؤك فاِسعي في العُلا وتقدّمي",55,"م",2,0],["ويا دهرُ هَذَا المَلْكُ فانزِل ببُوحِه","ولا زال قَهْراً فيك تَجري مَطالبه",56,"ب",2,0],["ويا دُرَراً غَسَلْنَ سَوادَ عيني","كذاكَ بِلِمَّتي صنعَ المَشِيبُ",57,"ب",1,0],["ويا دمْعُ لا تهتِكْ عليّ سَرائِري","فلو شئتُ يومَ البينِ كذّبتُ ما تُمْلي",58,"ل",2,0],["ويا دوحة الفردوس هل لي ساعة","بظلك أغدو من لظى الهجر قائلا",59,"ل",2,0],["ويا دهر بلغ ساكنيها تحيتي","ولو سكنوا المروين أو جاوزوا النهرا",60,"ر",2,0],["ويا دهرنا فيها متى أنت عائد","فنحمد منك العود أن عدت والكرا",60,"ر",2,0],["ويا دهر لا تبعد ويا عهد لا تحل","ويا دمع لا تجمد ويا سقم لا تبرا",60,"ر",2,0],["ويا درّياه دعها ان رونقها","قيل تزخرفه الراوون عن قيل",61,"ل",1,0],["وَيا دَهر دم لي فالحَبيب مواصلي","وَيا وَصل دم منا بعيش مخلَّد",62,"د",1,0],["ويا دار السلام بأي سد","يصد الطرف مربعك الرحيب",63,"ب",1,0],["ويا دافع فادفع عدانا وضرَّهمْ","وعنا شروراً فادفعنْها أدافعُ",64,"ع",1,0],["وَيا دَهرُ ما عَوَّدتُ نَفسي تَوَجُّعاً","وَلا أَنا أَشكو مِن مَريرِ النَوائبِ",65,"ب",1,0],["ويا دموعاً من التمساح يذرفها","في شاطىءِ المنش هُزْءاً طرفُ مبتسم",66,"م",1,0],["ويا دار سلمى والتباعد بيننا","متى الدهر يدنى منك صبا معذبا",67,"ب",2,0],["ويا دمعي الذي بل التراقي","يصبّ على مصابي او يصوب",68,"ب",1,0],["ويا دمت مهما غردت فوق أيكة","حمام وما دامت منى والمخيف",69,"ف",1,0],["ويا داراً رحيباً لَمْ يَضِقْ بي","وقد ضاقَتْ بِمَنْ فيها الدِّيارُ",70,"ر",1,0],["ويادمعتي يلي على الجفن ساحت","خﻻص يكفيني عظايم جروحي",71,"ح",2,0],["ويا دارس الأطلال في كل دمنةٍ","ويا ماثل الآثار بين المعالم",72,"م",1,0],["ويادمى ربك الى يقدر وينجزاء","وعالمًن مانوينابالخفاء ونصنعه",73,"ع",2,0],["ويا دارة فيها تقيلت نازلا","لأعتابها تعنو الجحاجحة الغلب",74,"ب",1,0],["ويا دربَ الحجارةِ إنَّ دربي","منَ الحجرِ الذي يُرمى يغارُ",75,"ر",1,0],["ويا دليل العقول اللي تخبط هوايم","كنه الجدي في ظلماتها نستشيره",76,"ر",2,0],["ويا دار حني على بوح ٍ به أعراف","غنى بها قلب المواليف مخطوف",77,"ف",1,0],["ويادار ميه فالسند عهدك يطوف","وياقف على اطلالك شفوقٍ ومشتاق",78,"ق",1,0],["ويادار عبله بالجوى جاوبي جوف","ابا الفوارس ذا الثنا سمح الأخلاق",78,"ق",1,0],["ويا دفْءَ المَواقد ِ حينَ نشتو","ويا صُبحاً بَدا نُوراً يقينا",79,"ن",2,0],["ويا دمشقُ سعيرُ النارِ يَأكلُها","والجوعُ والظلمُ والتشريدُ والعدمُ",80,"م",1,0],["ويادار جاوب صوتي اللى يناديك","يرجع صدى صوتي وطال انتظارك",81,"ك",1,0],["وَيا ديمَةَ الوَسمِيِّ حَيِّ ثَراهُمُ","وَبُثّي لَهُم أَنّي البَلابِلُ",82,"ل",1,0],["ويا دوحة بالأمس كانت تظلني","أهيضت فما من ظلة في فنائها",83,"ا",3,0]]}