{"poems":[[65,"نظرت وللأدم النوافخ في البرى","https://www.aldiwan.net/poem45783.html","الطويل"],[65,"سل الدهر عني أي خطب أمارس","https://www.aldiwan.net/poem46145.html","الطويل"],[3,"نأتك رقاش إلا عن لمام","https://www.aldiwan.net/poem110.html",""],[88,"منى نلتها يا لابس المجد معلما","https://www.aldiwan.net/poem68939.html","الطويل"],[37,"أأطلال دار من سعاد بيلبن","https://www.aldiwan.net/poem38818.html","الطويل"],[90,"ألا انهض وشمر أيها الشرق للحرب","https://www.aldiwan.net/poem44471.html","الطويل"],[31,"عفا واسط من آل رضوى فنبتل","https://www.aldiwan.net/poem6022.html","الطويل"],[47,"أجرني من الواشي الذي جار واعتدى","https://www.aldiwan.net/poem63484.html","الطويل"],[47,"عزمت على المنازل أن تبينا","https://www.aldiwan.net/poem66674.html","الوافر"],[30,"لعمري لقد أوفى وزاد وفاؤه","https://www.aldiwan.net/poem1239.html",""],[30,"إليك بنفسي حين بعد حشاشةٍ","https://www.aldiwan.net/poem1287.html",""],[30,"ألم يك جهلاً بعد ستين حجةً","https://www.aldiwan.net/poem1288.html",""],[30,"إن أستطع منك الدنو فإنني","https://www.aldiwan.net/poem4999.html","الطويل"],[30,"فتحت لهم حتى فككت قيودهم","https://www.aldiwan.net/poem5226.html","الطويل"],[30,"أتيناك زوارا ووفدا وشامة","https://www.aldiwan.net/poem5275.html","الطويل"],[30,"وحرف كجفن السيف أدرك نقيها","https://www.aldiwan.net/poem5326.html","الطويل"],[30,"أقول لحرف قد تخون نيها","https://www.aldiwan.net/poem5396.html","الطويل"],[30,"يسقين بالموماة زغبا نواهضا","https://www.aldiwan.net/poem5464.html","الطويل"],[68,"كفى البدر حسنا أن يقال نظيرها","https://www.aldiwan.net/poem41546.html","الطويل"],[46,"نسائلها أي المواطن حلت","https://www.aldiwan.net/poem30567.html","الطويل"],[46,"لقد أخذت من دار ماوية الحقب","https://www.aldiwan.net/poem30580.html","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9875","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55267","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54860","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54708","المجتث"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55050","الطويل"],[30,"أهاج لك الشوق القديم خباله","https://www.poetsgate.com/ViewPoem.aspx?id=2515",""],[215,"تحدثت بالهتاف أنك حاضر لإيناس","https://www.aldiwan.net/poem46315.html","الطويل"],[240,"فدتك عماد الدين نفسي وما حوت","https://www.aldiwan.net/poem31980.html","الطويل"],[292,"كلفت بليلى خدين الشباب","https://www.aldiwan.net/poem1913.html","المتقارب"],[302,"إذا ما امتطيت الفلك مقتحم البحر","https://www.aldiwan.net/poem33276.html","الطويل"],[310,"خميس اليمن توج عام خمس","https://www.aldiwan.net/poem56507.html","الوافر"],[369,"إلى خيال خيال في الظلام سرى","https://www.aldiwan.net/poem60879.html","البسيط"],[371,"ترى آيتي في الحب حقا وتعرض","https://www.aldiwan.net/poem17023.html","الطويل"],[406,"أسد الشيشان","https://www.aldiwan.net/poem6792.html","عموديه"],[409,"لك الله هذا غاية الخلق يا قلبي","https://www.aldiwan.net/poem34141.html","الطويل"],[422,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[460,"سليمى أزمعت بينا","https://www.aldiwan.net/poem26632.html","الهزج"],[463,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[463,"طوى الليل راكب أخطاره","https://www.aldiwan.net/poem56164.html","المتقارب"],[580,"مدحت السرى وهي الحقيقة بالم","https://www.aldiwan.net/poem3019.html","الطويل"],[616,"","https://poetry.dctabudhabi.ae/diwan/poem/204391","الطويل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96996","الطويل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104560","الطويل"],[893,"","https://poetry.dctabudhabi.ae/diwan/poem/138818",""],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67826","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67818","الطويل"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96394","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120058","المجتث"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61101","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112884","الطويل"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21683","المتقارب"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79981","الطويل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113964","البسيط"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118416","الوافر"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69335","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109379","الطويل"],[2430,"","https://poetry.dctabudhabi.ae/diwan/poem/143671","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87316","الرجز"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122448","الوافر"],[3169,"","https://poetry.dctabudhabi.ae/diwan/poem/143339","الطويل"],[3386,"","https://poetry.dctabudhabi.ae/diwan/poem/124618","الطويل"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99318","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88968","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45776","الطويل"],[3643,"","https://poetry.dctabudhabi.ae/diwan/poem/145183","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117900","الوافر"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34648","المتقارب"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133243","الوافر"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76453","الطويل"],[3962,"","https://poetry.dctabudhabi.ae/diwan/poem/131910","البسيط"],[4163,"","https://poetry.dctabudhabi.ae/diwan/poem/106731","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102748","الطويل"],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/117143","الرجز"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81724","الطويل"],[4657,"","https://poetry.dctabudhabi.ae/diwan/poem/140150",""],[4755,"دَعَا الشِّعرُ يا قَلبي","https://www.poetsgate.com/ViewPoem.aspx?id=183641",""],[585,"سل الفلك الدوار ما للكواكب","https://www.poetsgate.com/ViewPoem.aspx?id=161941",""],[5183,"من مُلح الرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=180281",""],[5442,"عسى وقفة بالركب يا حادي الركب","https://www.poetsgate.com/ViewPoem.aspx?id=114759",""],[5621,"صهوة","https://www.poetsgate.com/ViewPoem.aspx?id=24565",""],[5910,"بِمكةَ نورٌ قد سَرَى وضياءُ","https://www.poetsgate.com/ViewPoem.aspx?id=206977",""]],"verses":[["إِلى خَفِراتٍ مِن نُمَيرٍ كَأَنَّها","ظِباءٌ كَحيلاتُ المَدامِعِ عِينُ",0,"ن",1,0],["إِلى خِلَعٍ تَحكي رِياضاً أنيقَةً","بكَفَّيْهِ تَسْقيها الغَمامُ الرّواجِسُ",1,"س",1,0],["إِلى خَيلٍ مُسَوَّمَةٍ عَلَيه","حُماةُ الرَوعِ في رَهَجِ القَتامِ",2,"م",1,0],["إِلى خَيرِ خَلقِ اللَهِ مَن جاءَ ناطِقاً","بِآياتِهِ إِنجيلُ عيسى بنِ مَريَما",3,"م",2,0],["إِلى خَيرِ أَحياءِ البَرِيَّةِ كُلِّها","لِذي رَحِمٍ أَو خُلَّةٍ مُتَأَسِّنِ",4,"ن",1,0],["إلى خير أرض داسها شرّ معشر","بأرجلهم قُطّعن من أجرل جُرب",5,"ب",1,0],["إِلى خالِدٍ حَتّى أَنَخنَ بِخالِدٍ","فَنِعمَ الفَتى يُرجى وَنِعمَ المُؤَمَّلُ",6,"ل",1,0],["إِلى خُلَفاءِ سُنَّةٍ قَد تَنافَسوا","لِتَثقُلَ في أَعناقِهِم وَتُرَدَّدا",7,"د",2,0],["إِلى خَوفِ العِدى حَتّى يَبيتوا","عَلى ضِغنٍ وَأَمنِ الخائِفينا",8,"ن",2,0],["إِلى خَيرِ بَيتٍ فيهِ أَوفى مُجاوِرٍ","جِواراً إِلى أَطنابِهِ خَيرَ مَذهَبِ",9,"ب",1,0],["إِلى خَيرِ مَأتىً يَطلُبُ الناسُ خَيرُهُ","إِلَيهِ مِنَ الآفاقِ مُجتَمَعُ الرَكبِ",10,"ب",1,0],["إِلى خَيرِ مَن تَحتَ السَماءِ أَمانَةً","وَأَولاهُ بِالحَقِّ الَّذي لا يُكَذَّبُ",11,"ب",1,0],["إِلى خَيرِ أَهلِ الأَرضِ مَن يَستَغِث بِهِ","يَكُن مِثلَ مَن مَرَّت لَهُ طَيرُ أَسعَدُ",12,"د",1,0],["إِلى خَيرِ أَهلِ الأَرضِ أُمّاً وَخَيرِهِم","أَباً وَأَخاً إِلّا النَبِيَّ وَعُنصُرا",13,"ر",2,0],["إِلى خَيرِ مَسؤولَينِ يُرجى نَداهُما","إِذا اِختيرَ بِالأَفواهِ قَبلَ الأَصابِعِ",14,"ع",1,0],["إِلى خَيرِ جارٍ مُستَجارٍ بِحَبلِهِ","وَأَوفاهُ حَبلاً لِلطَريدِ المُشارِفِ",15,"ف",1,0],["إِلى خالِدٍ سيروا فَإِن تَنزِلوا بِهِ","جَميعاً وَقَد ضُمَّت إِلَيهِ ذَلاذِلُه",16,"ل",2,0],["إِلى خَيرِهِم فيهِم قَديماً وَحادِثاً","مَعَ الحِلمِ وَالإيمانِ وَالنائِلِ الجَزلِ",17,"ل",1,0],["إِلى خَيرِ مَبعوثٍ إِلى خَيرِ أُمَّةٍ","إِلى خَيرِ مَعبودٍ دَعاها بَشيرُها",18,"ر",3,0],["إِلى خَيرِ مَن ساسَ الرَعِيَّةَ عَدلُهُ","وَوَطَّدَ أَعلامَ الهُدى فَاِستَقَرَّتِ",19,"ت",1,0],["إِلى خالِدٍ راحَت بِنا أَرحَبِيَّةٌ","مَرافِقُها مِن عَن كَراكِرِها نُكبُ",20,"ب",1,0],["إِلى خَيلٍ مُسَوَّمَةٍ عَلَيها","حُماةُ الرَوعِ في رَهَجِ القَتامِ",21,"م",1,0],["إِلَى خُطَطٍ فِي العُلَى لَمْ تَدَعْ","مَجَالاً يُلِمُّ بِهِ اللُّوَّمُ",22,"م",1,0],["إِلى خُلُوصٍ فِي الطَّوَايَا بِهِ","مِمَّا بِأَزْهَارِ الرُّبَى سِرُّ",23,"ر",1,0],["إِلَى خَليلٍ وَلِنْدَا","أَصْفَى الْتَّهَاني تُهْدَى",24,"د",2,1],["إِلى خُلُقٍ مَهْمَا يَقُلْ فِيهِ مَادِحٌ","ثَنَاءً عَلَيْهِ قَالَتِ النَّاسُ أَخْلِقِ",25,"ق",1,0],["إلى خَيْرِ مَسْؤولَينِ يُرْجَى نَداهُما","إذا اخْتيرَ الأفْوَاهِ قَبلَ الأصَابِعِ",26,"ع",1,0],["إلى خالق الأرواح أشكو بلييى","بروح غدور في الغرام وماذقِ",27,"ق",1,0],["إِلى خَيرِ بَيتٍ مِن ذَوابَةِ فارِسٍ","وَأَكرَمِ عيصٍ في الأَنامِ وَمَعشَرِ",28,"ر",1,0],["إِلى خَيرِ مُستَمطَرٍ كَفُّهُ","وَخَيرِ المَقاوِلِ عَمّاً وَخالا",29,"ل",2,0],["إِلى خيرَة اللَه الَّذي شَهِدَ الوَرى","له أَنَّه المُختارُ في عالَمِ الذَرِّ",30,"ر",1,0],["إِلى خُلقٍ لو اِنّ البحرَ مدّ","لِمطريه سَرى فيهِ بيبسِ",31,"س",1,0],["إلى خيالٍ خَيالٌ في الظّلام سَرَى","نَظيُره في خَفاء الشَّخصِ إن نُظِرا",32,"ر",2,1],["إِلى خَيلٍ دَمعٍ في مَيادينِ حُبِّكُم","تَسابَقُ أَلفاظُ العِتابِ فَتَركُضُ",33,"ض",1,0],["إلى خطاب اُمتنا التحاي","من القمم الشواهق والسُهوب",34,"ب",1,0],["إلى خلق منه النسيم تعلمت","وأني لها حسن البشاشة للصحب",35,"ب",1,0],["إلى خندقٍ ينمى علاهم إذا دُعوا","ومن خير أقيالٍ إذا عُدَّ قيلها",36,"ه",2,0],["إَلى خَودٍ مُنَعَّمَةٍ","حَفَفنَ بِها وَفَدَّينا",37,"ن",2,0],["إلى خير مرعًى جميمٍ يُلَسُّ","وأعذبِ ماءِ حياً يُنهَلُ",38,"ل",1,0],["إلى خير من حلَّ شوقاً إليه","ركابُ المطيّ لأسيارِهِ",39,"ر",2,0],["إِلى خيرِ دينٍ عنده خَيْرُ مُرشِدٍ","وخيرِ إِمامٍ عنْدَهُ خيرُ مُؤْتَمِّ",40,"م",1,0],["إلى خيرة الأصحاب والتابع الذي","به وصلته في الكتاب الذرائع",41,"ع",1,0],["إلى خير قبر ما رأى الناس مثله","ثرى جمعت فيه المعالي فضمها",42,"م",3,0],["إلى خيرِ من أطرتهُ بالمدحِ ألسُنٌ","فصدَّقها نصُّ الكتابِ المُنزَّلِ",43,"ل",1,0],["إلى خير خلق الله أحمدها ومن","دنا فتدلى قاب قوسين أو أدني",44,"ن",2,0],["إلى خَيْرِ مَبْعُوثٍ وَأَكْرَمِ سَيِّدِ","فَقِفْ وَاسْتَمِعْ شِعْراً كَدُرِّ مُنَضَّدِ",45,"د",1,0],["إلى خَيْرٍ دَانٍ فِي الأْنَامِ وَناَءِ","نَبيٌّ شَفِيعٌ حَازَ كُلَّ الْفَضَائِلِ",46,"ل",1,0],["الى خِدَبٍّ سَبطٍ ستّيني","طَبَّ بذاتِ فرعِها فطونِ",47,"ن",1,1],["إلى خلال صفت صف","وة الزلال النمير",48,"ر",1,0],["إِلى خَير قَوم يشرعون إِذا التَقوا","رِماح عُيون ما يبل طَعينها",49,"ن",3,0],["إلى خير ممدوح من الناس بالكرم","وبالعلم والتقوى وبالغوث ادُهم",50,"م",1,1],["إِلى خَيرِ خِندِفِ في مُلكِها","لِبادٍ مِن الناسِ أَو حاضِرِ",51,"ر",1,0],["إلى خيرِ أهلِ الأرض بِرًّا ونائلاً","وأكرم مَن تثنى عليه المكارمُ",52,"م",1,0],["إلى خصورٍ لها مثلِ الجديل تَرى","إذا نَظَرتَ لها مِن بينِها عرَقا",53,"ق",2,0],["الى خيف المحصب رائحات","بكل اشم ضاحي الوجنتين",54,"ن",1,0],["إِلى خَيرِ مَن يُستَمطَرُ الخَيرُ عِندَهُ","وَيَأتَمُّ مَغناهُ رِكابٌ وَرُكبانُ",55,"ن",1,0],["إلى خير حزبٍ ينتمي وهو في الندى","ترى البحرَ جزأً من أنامله العشر",56,"ر",1,0],["إلى خيرِ إلفٍ هام قلبي بحبِّه","به تمّ وَسْواسي وهاجَتْ بَلابلي",57,"ل",2,0],["إلى خُمَيس ثمَّ مِل للأسوَدِ","واحذَر مِنَ الأَوساخِ ثَمَّ وابعُدِ",58,"د",1,0],["إِلَى خُلُقٍ وَتِلكَ هِبَاتً رَبِّي","أرَقُّ مِنَ النَّسِيمِ المُستَطَابِ",59,"ب",1,0],["إلى خير من يمشي على الأرض كلها","وأفضلها عند اعتكار الصرائر",60,"ر",1,0],["إلى خير من حط الرحال يبابه","ومن صدرت عنه صدور الرواحل",61,"ل",1,0],["الى خدود بنات الروم قد برزت","من حجبها وأدارت أعين العرب",62,"ب",1,0],["إلى خير ممدوح جدير صوابه","بمصر رشاد الجيش أي سديد",63,"د",1,0],["إِلى خَير خَلق اللَه تَنَمى أُصولَكُم","فَكُنتُم بِهِ في الناس أَكرَم عُنصُرا",64,"ر",2,0],["إلى خير خلق الله تنحو مطيتي","ودار بها الكربات تجلى وتنقض",65,"ض",1,0],["إلى خير الملوك أباً وأمّاً","وأكرمهم إذا انتسبوا وجادوا",66,"د",3,0],["إلى خازن اللَه في خلقه","سراجِ النهارِ وبدرِ الظلَم",67,"م",1,1],["إلى خير البرية من قريش","فحسبى ذاك إن دنت الديار",68,"ر",1,0],["إِلى خدمة الأَوطان قد ضيع العلا","بَنوها وَحادوا عَن كَمال وَسؤدد",69,"د",1,0],["إلى خمول إلى جبن إلي خلد","تحت المكاره وا